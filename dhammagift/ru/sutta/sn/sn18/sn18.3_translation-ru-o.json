{
  "sn18.3:0.1": "Связанные Наставления 18.3",
  "sn18.3:0.2": "Раздел Первый",
  "sn18.3:0.3": "Сутта Внимание-распознавание",
  "sn18.3:1.1": "В Саваттхи располагается.",
  "sn18.3:1.2": "“Как представляешь, Рахула,",
  "sn18.3:1.3": "зрительное внимание-распознавание надёжно или ненадёжно?”",
  "sn18.3:1.4": "“Ненадёжно, почтенный”.",
  "sn18.3:1.5": "слуховое внимание",
  "sn18.3:1.6": "обонятельное внимание",
  "sn18.3:1.7": "языковое внимание",
  "sn18.3:1.8": "телесное внимание",
  "sn18.3:1.9": "ментальное внимание надёжно или ненадёжно?”",
  "sn18.3:1.10": "“Ненадёжно, почтенный”.",
  "sn18.3:1.11": "“Так видя, Рахула, обученный последователь Благородных не находится в зрительном внимании, слуховом внимании… обонятельном внимании… языковом внимании… телесном внимании… ментальном внимании.",
  "sn18.3:1.12": "Не находящийся, он становится беспристрастным…",
  "sn18.3:1.13": "понимает.",
  "sn18.3:1.14": "Третья."
}