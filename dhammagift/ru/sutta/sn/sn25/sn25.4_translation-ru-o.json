{
  "sn25.4:0.1": "Связанные Наставления 25.4 ",
  "sn25.4:0.2": "Раздел Глаз ",
  "sn25.4:0.3": "Сутта Соприкосновение ",
  "sn25.4:1.1": "В условиях Саваттхи. ",
  "sn25.4:1.2": "“Глазо-соприкосновение, монахи, ненадёжно, изменчиво, иным-становится; ",
  "sn25.4:1.3": "ухо-соприкосновение… ",
  "sn25.4:1.4": "носо-соприкосновение… ",
  "sn25.4:1.5": "языко-соприкосновение… ",
  "sn25.4:1.6": "тело-соприкосновение… ",
  "sn25.4:1.7": "умо-соприкосновение ненадёжно, изменчиво, иным-становится. ",
  "sn25.4:1.8": "Который, монахи, в эти учения-явления верит, настраивается — тот зовётся 'веро-следующий… ",
  "sn25.4:1.9": "к-пробуждению-переправляющийся”. ",
  "sn25.4:1.10": "Четвёртая."
}