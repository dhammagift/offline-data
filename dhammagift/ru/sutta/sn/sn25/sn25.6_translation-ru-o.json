{
  "sn25.6:0.1": "Связанные Наставления 25.6 ",
  "sn25.6:0.2": "Раздел Глаза ",
  "sn25.6:0.3": "Сутта Объекто-сознавание ",
  "sn25.6:1.1": "В условиях Саваттхи. ",
  "sn25.6:1.2": "“Объекто-сознавание, монахи, ненадёжно, изменчиво, иным-становится; ",
  "sn25.6:1.3": "звуко-сознавание … ",
  "sn25.6:1.4": "запахо-сознавание … ",
  "sn25.6:1.5": "вкусо-сознавание … ",
  "sn25.6:1.6": "касания-сознавание … ",
  "sn25.6:1.7": "явления-сознавание ненадёжно, изменчиво, иным-становится. ",
  "sn25.6:1.8": "Который, монахи, в эти учения-явления верит, настраивается — тот зовётся 'веро-следующий… ",
  "sn25.6:1.9": "к-пробуждению-переправляющийся”. ",
  "sn25.6:1.10": "Шестая."
}