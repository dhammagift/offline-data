{
  "sn25.9:0.1": "Связанные Наставления 25.9 ",
  "sn25.9:0.2": "1. Глава глаза ",
  "sn25.9:0.3": "Сутта Твёрдого-дхату ",
  "sn25.9:1.1": "В условиях Саваттхи. ",
  "sn25.9:1.2": "“Твёрдого-дхату (феномен), монахи, ненадёжный-нестабильный, изменчивый, иным-становящийся; ",
  "sn25.9:1.3": "жидкости-дхату… ",
  "sn25.9:1.4": "тепла-дхату… ",
  "sn25.9:1.5": "ветра-дхату… ",
  "sn25.9:1.6": "пространства=дхату… ",
  "sn25.9:1.7": "внимания-распознавания-дхату ненадёжный-нестабильный, изменчивый, иным-становящийся. ",
  "sn25.9:1.8": "Который, монахи, в эти учения-явления верит, настраивается — тот зовётся 'веро-следующий… ",
  "sn25.9:1.9": "к-пробуждению-переправляющийся”. ",
  "sn25.9:1.10": "Девятая."
}