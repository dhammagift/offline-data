{
  "sn25.5:0.1": "Связанные Наставления 25.5 ",
  "sn25.5:0.2": "Раздел Глаз ",
  "sn25.5:0.3": "Сутта Соприкосновением-рождённое ",
  "sn25.5:1.1": "В условиях Саваттхи. ",
