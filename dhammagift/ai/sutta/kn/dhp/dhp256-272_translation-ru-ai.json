{
 "dhp256:0.1": "Малого Собрания",
 "dhp256:0.2": "Дхаммапада",
 "dhp256:0.3": "Глава Установленный-в-Дхамме",
 "dhp256:0.4": "История о судье-министре",
 "dhp256:1": "Не тем он установлен-в-Дхамме,",
 "dhp256:2": "кто благо насильственно ведёт;",
 "dhp256:3": "А который благо и не-благо,",
 "dhp256:4": "оба рассудил бы мудрец.",
 "dhp257:1": "Без-насилия Дхаммой,",
 "dhp257:2": "справедливо ведёт других;",
 "dhp257:3": "Дхаммой охраняемый, разумный,",
 "dhp257:4": "“установленный-в-Дхамме” говорится.",
 "dhp258:0": "История шестигрупповых",
 "dhp258:1": "Не тем он мудрец,",
 "dhp258:2": "насколько много говорит;",
 "dhp258:3": "Безопасный, без-враждебности, без-страха,",
 "dhp258:4": "“мудрец” говорится.",
 "dhp259:0": "История об одном-единственном-архате",
 "dhp259:1": "Не настолько он носитель-Дхаммы,",
 "dhp259:2": "насколько много говорит;",
 "dhp259:3": "А который и мало услышав,",
 "dhp259:4": "Дхамму телом видит;",
 "dhp259:5": "Он есть — носитель-Дхаммы,",
 "dhp259:6": "кто Дхамму не оставляет.",
 "dhp260:0": "История достопочтенного Лакундакабхаддии",
 "dhp260:1": "Не тем он старец,",
 "dhp260:2": "у кого седая голова;",
 "dhp260:3": "Созревший возраст у того,",
 "dhp260:4": "“пусто-старый” говорится.",
 "dhp261:1": "У которого правда и Дхамма,",
 "dhp261:2": "безвредность, сдержанность, укрощение;",
 "dhp261:3": "Он есть — извергший грязь знаток,",
 "dhp261:4": "«старцем» так называется.",
 "dhp262:0": "История о многих монахах",
 "dhp262:1": "Не из-за одной лишь речи,",
 "dhp262:2": "ни из-за цвета и красоты;",
 "dhp262:3": "Благовидным человек бывает,",
 "dhp262:4": "завистливый скупой лживый.",
 "dhp263:1": "У кого же это отсечено,",
 "dhp263:2": "с-корнем-вырвано, устранено;",
 "dhp263:3": "Он — извергший изъян разумный,",
 "dhp263:4": "«благовидным» называется.",
 "dhp264:0": "История о Хаттхаке",
 "dhp264:1": "Не из-за бритой головы шраман,",
 "dhp264:2": "не соблюдающий обетов, говорящий ложь;",
 "dhp264:3": "Исполненный желаний и корыстолюбия,",
 "dhp264:4": "шраманом каким он будет?",
 "dhp265:1": "А кто успокаивает злые [деяния],",
 "dhp265:2": "малые и большие, всецело;",
 "dhp265:3": "Ведь из-за успокоения злых [деяний]",
 "dhp265:4": "«шраманом» называется.",
 "dhp266:0": "История некоего брахмана",
 "dhp266:1": "Не поэтому он монах,",
 "dhp266:2": "сколько просит у других;",
 "dhp266:3": "Приняв чужеродное явление,",
