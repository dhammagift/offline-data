{
 "dhp383:0.1": "Малого Собрания",
 "dhp383:0.2": "Дхаммапада",
 "dhp383:0.3": "Раздел Брахмана",
 "dhp383:0.4": "История брахмана с обильной верой",
 "dhp383:1": "Пересеки поток, устремившись вперёд,",
 "dhp383:2": "желания отбрось, брахман;",
 "dhp383:3": "Составляющих исчерпание познав,",
 "dhp383:4": "не-сделанным-знающим ты, брахман.",
 "dhp384:0": "История о многих монахах",
 "dhp384:1": "Когда в двойственных явлениях",
 "dhp384:2": "превзошедшим становится брахман;",
 "dhp384:3": "Тогда все его связи",
 "dhp384:4": "к исчерпанию приходят у знающего.",
 "dhp385:0": "История Мары",
 "dhp385:1": "У кого этот-берег и тот-берег,",
 "dhp385:2": "берег-и-не-берег не различается;",
 "dhp385:3": "Без-страха, без-связи,",
 "dhp385:4": "Того называю я брахманом.",
 "dhp386:0": "История некоего брахмана",
 "dhp386:1": "Джхана-погружённого, без-пыли сидящего,",
 "dhp386:2": "сделавшего-дело, без-истечений;",
 "dhp386:3": "Высшего блага достигшего,",
 "dhp386:4": "Того называю я брахманом.",
 "dhp387:0": "История уважаемого Ананды",
 "dhp387:1": "Днём сияет солнце,",
 "dhp387:2": "ночью сияет луна;",
 "dhp387:3": "Снаряжённый кхаттий сияет,",
 "dhp387:4": "джхайин сияет брахман;",
 "dhp387:5": "И во все дни и ночи",
 "dhp387:6": "будда сияет блеском.",
 "dhp388:0": "История некоего ушедшего в бездомность брахмана",
 "dhp388:1": "Отбросивший зло — брахман,",
 "dhp388:2": "Ровным-поведением — шраманом называется;",
 "dhp388:3": "Изгоняя своё пятно,",
 "dhp388:4": "Потому «ушедшим в бездомность» называется.",
 "dhp389:0": "История уважаемого Сарипутты",
 "dhp389:1": "Не брахмана следует ударить,",
 "dhp389:2": "не на него пусть изливает брахман;",
 "dhp389:3": "Позор брахмана убивающему,",
 "dhp389:4": "оттуда мудрый которого отпускает.",
 "dhp390:1": "Не брахману это что-либо лучше,",
 "dhp390:2": "Когда сдерживание ума-представления от приятного;",
 "dhp390:3": "Откуда бы вредящий ум ни отворачивался,",
 "dhp390:4": "Оттуда оттуда успокоение именно боль.",
 "dhp391:0": "Махападжапатиготами-история",
 "dhp391:1": "У которого телом, речью,",
 "dhp391:2": "умом-представлением нет плохо-сделанного;",
 "dhp391:3": "Сдержанный в трёх местах,",
 "dhp391:4": "Того называю я брахманом.",
 "dhp392:0": "История уважаемого Сарипутты",
 "dhp392:1": "От кого явление узнал бы,",
 "dhp392:2": "Правильно-пробуждённым изложенное;",
 "dhp392:3": "Почтительно его почитал бы,",
 "dhp392:4": "как огненное-жертвоприношение брахман.",
 "dhp393:0": "Джатила-брахман-история",
 "dhp393:1": "Не спутанными-волосами, не родом,",
 "dhp393:2": "Не рождением бывает брахман;",
 "dhp393:3": "У которого правда и Дхамма,",
 "dhp393:4": "он чистый и он брахман.",
 "dhp394:0": "Кухака-брахман-история",
 "dhp394:1": "Что тебе от спутанных-волос, глупый,",
 "dhp394:2": "что тебе от шкуры-антилопы;",
 "dhp394:3": "Внутренность твоя заросшая,",
 "dhp394:4": "внешность обтираешь.",
 "dhp395:0": "История Кисаготами",
 "dhp395:1": "Носящего отбросы существо,",
 "dhp395:2": "худого, жилами-покрытого;",
 "dhp395:3": "Одного в лесу зажжённого,",
 "dhp395:4": "Того называю я брахманом.",
 "dhp396:0": "Эка-брахман-история",
 "dhp396:1": "И не называю я брахманом,",
 "dhp396:2": "Рождённого из лона, из матери возникшего;",
 "dhp396:3": "«Господин» говорящим именем он бывает,",
 "dhp396:4": "Если есть у него имущество;",
 "dhp396:5": "Без-имущего, без-поддерживания,",
 "dhp396:6": "Того называю я брахманом.",
 "dhp397:0": "История сына Уггасены Сеттхи",
 "dhp397:1": "Всякую связанность отрезав,",
 "dhp397:2": "Кто же не трепещет;",
 "dhp397:3": "Привязанность превзошедшего, разъединённого,",
 "dhp397:4": "Того называю я брахманом.",
 "dhp398:0": "История двух брахманов",
 "dhp398:1": "Отрезав путы и ремень,",
 "dhp398:2": "Привязь вместе с уздой;",
 "dhp398:3": "Поднявшего засов пробуждённого,",
 "dhp398:4": "Того называю я брахманом.",
 "dhp399:0": "История Аккосы Бхарадваджи",
 "dhp399:1": "Оскорбление, побои и заточение,",
 "dhp399:2": "Невраждебный кто терпит;",
 "dhp399:3": "Сила терпения — сила-воинство,",
 "dhp399:4": "Того называю я брахманом.",
 "dhp400:0": "История уважаемого Сарипутты",
 "dhp400:1": "Без-гнева, с обетом,",
 "dhp400:2": "С нравственностью, без-надменности;",
 "dhp400:3": "Укрощённого, с последним телом,",
 "dhp400:4": "Того называю я брахманом.",
 "dhp401:0": "История тхери Уппалаванны",
 "dhp401:1": "Вода на листе лотоса,",
 "dhp401:2": "как на острие шила горчичное зерно;",
 "dhp401:3": "Кто не марается в желаниях,",
 "dhp401:4": "Того называю я брахманом.",
 "dhp402:0": "История некоего брахмана",
 "dhp402:1": "Кто боли понимает,",
 "dhp402:2": "здесь же исчерпание своего;",
 "dhp402:3": "Сбросивший ношу, освобождённый,",
 "dhp402:4": "Того называю я брахманом.",
 "dhp403:0": "История бхиккхуни Кхемы",
 "dhp403:1": "Глубокое понимание, мудрого,",
 "dhp403:2": "пути и не-пути знатока;",
 "dhp403:3": "Высшего блага достигшего,",
 "dhp403:4": "Того называю я брахманом.",
 "dhp404:0": "История тхеры Тиссы, жившего в пещере",
 "dhp404:1": "Не смешанного с домохозяевами,",
 "dhp404:2": "и с бездомными, обеими;",
 "dhp404:3": "Без дома странствующего, мало желающего,",
 "dhp404:4": "Того называю я брахманом.",
 "dhp405:0": "История некоего монаха",
 "dhp405:1": "Отложив палку к существам,",
 "dhp405:2": "к трепещущим и к устойчивым;",
 "dhp405:3": "Кто не бьёт, не убивает,",
 "dhp405:4": "Того называю я брахманом.",
 "dhp406:0": "История саманеров",
 "dhp406:1": "Невраждебного среди враждебных,",
 "dhp406:2": "среди нападающих успокоенного;",
 "dhp406:3": "Среди держащих недержащего,",
 "dhp406:4": "Того называю я брахманом.",
 "dhp407:0": "История тхеры Махапантхаки",
 "dhp407:1": "У кого страсть и злоба,",
 "dhp407:2": "самомнение и лицемерие отброшены;",
 "dhp407:3": "Как горчичное зерно на острие шила,",
 "dhp407:4": "Того называю я брахманом.",
 "dhp408:0": "История тхеры Пилинды Ваччхи",
 "dhp408:1": "Негрубую, убедительную,",
 "dhp408:2": "речь правдивую произносит;",
 "dhp408:3": "Которой никого не задевает,",
 "dhp408:4": "Того называю я брахманом.",
 "dhp409:0": "История некоего тхеры",
 "dhp409:1": "Кто здесь длинное или короткое,",
 "dhp409:2": "тонкое, грубое, красивое-некрасивое;",
 "dhp409:3": "В мире невзятого не берёт,",
 "dhp409:4": "Того называю я брахманом.",
 "dhp410:0": "История уважаемого Сарипутты",
 "dhp410:1": "Желаний которого не существует,",
 "dhp410:2": "в этом мире и в следующем;",
 "dhp410:3": "Без желаний, освобождённого,",
 "dhp410:4": "Того называю я брахманом.",
 "dhp411:0": "Достопочтенного Махамоггалланы история",
 "dhp411:1": "У кого привязанности не существуют,",
 "dhp411:2": "поняв, без сомнений;",
 "dhp411:3": "Достигнув бессмертного,",
 "dhp411:4": "Того называю я брахманом.",
 "dhp412:0": "История тхеры Реваты",
 "dhp412:1": "Кто же благо и плохое,",
 "dhp412:2": "оба вида привязанности превзошёл;",
 "dhp412:3": "Без-страданий, без-пыльный, чистый,",
 "dhp412:4": "Того называю я брахманом.",
 "dhp413:0": "История тхеры Чандабхи",
 "dhp413:1": "Как луна, безупречный, чистый,",
 "dhp413:2": "просветлённое, незамутнённое;",
 "dhp413:3": "Радость-бхава-истощённого,",
 "dhp413:4": "Того называю я брахманом.",
 "dhp414:0": "История тхеры Сивали",
 "dhp414:1": "Кто эту загражденную тропу плохопроходимую,",
 "dhp414:2": "сансару, замутненность-заблуждение превзошёл;",
 "dhp414:3": "Пересёкший, иного-достигший, погружённый в джхану,",
 "dhp414:4": "без-дрожания, без-сомнения;",
 "dhp414:5": "Не-удерживаясь, угасший,",
 "dhp414:6": "Того называю я брахманом.",
 "dhp415:0": "История тхеры Сундарасамудды",
 "dhp415:1": "Кто здесь желания отбросив,",
 "dhp415:2": "бездомным странствует;",
 "dhp415:3": "Желание-бхава-истощённого,",
 "dhp415:4": "Того называю я брахманом.",
 "dhp416:0": "История джатилы-тхеры",
 "dhp416:1": "Кто здесь цепляние отбросив,",
 "dhp416:2": "бездомным странствует;",
 "dhp416:3": "Цепляние-бхава-истощённого,",
 "dhp416:4": "Того называю я брахманом.",
 "dhp416:5.0": "История Джотики-тхеры",
 "dhp416:5.1": "Кто здесь цепляние отбросив,",
 "dhp416:6": "бездомным странствует;",
 "dhp416:7": "Цепляние-бхава-истощённого,",
 "dhp416:8": "Того называю я брахманом.",
 "dhp417:0": "История Натапуттаки-тхеры",
 "dhp417:1": "Оставив человеческую связь,",
 "dhp417:2": "божественную связь превзошёл;",
 "dhp417:3": "От всех связей освобождённого,",
 "dhp417:4": "Того называю я брахманом.",
 "dhp418:0": "История Натапуттаки-тхеры",
 "dhp418:1": "Оставив радость и неприязнь,",
 "dhp418:2": "ставший прохладным, без-подпитки;",
 "dhp418:3": "Все-мир-превосходящего героя,",
 "dhp418:4": "Того называю я брахманом.",
 "dhp419:0": "История Вангисы-тхеры",
 "dhp419:1": "Уход кто знает существ,",
 "dhp419:2": "и появление всецело;",
 "dhp419:3": "Не-зацепленного благого пробуждённого,",
 "dhp419:4": "Того называю я брахманом.",
 "dhp420:1": "Чей путь не знают,",
 "dhp420:2": "дэвы, гандхаббы, люди;",
 "dhp420:3": "С-истекшим-истечением араханта,",
 "dhp420:4": "Того называю я брахманом.",
 "dhp421:0": "История Дхаммадинны-тхери",
 "dhp421:1": "У кого впереди и позади,",
 "dhp421:2": "и в середине нет ничего;",
 "dhp421:3": "Без-имущего, без-поддерживания,",
 "dhp421:4": "Того называю я брахманом.",
 "dhp422:0": "История о тхере Ангулимале",
 "dhp422:1": "Быка превосходного героя,",
 "dhp422:2": "великого-ищущего победителя;",
 "dhp422:3": "Непоколебимого омытого пробуждённого,",
 "dhp422:4": "Того называю я брахманом.",
 "dhp423:0": "История Девахита-брахмана",
 "dhp423:1": "Прошлые-жизни кто знает,",
 "dhp423:2": "небеса и падения видит;",
 "dhp423:3": "а после рождения-исчерпания достигший,",
 "dhp423:4": "прямым знанием завершённый мудрец;",
 "dhp423:5": "Все-завершённый-завершением,",
 "dhp423:6": "Того называю я брахманом.",
 "dhp423:7": "Глава брахманов двадцать шестая.",
 "dhp423:8": "Настолько во всей первой главе пар четырнадцать историй, в главе не-беспечности девять, в главе ума девять, в главе цветов двенадцать, в главе незрелого пятнадцать, в главе мудреца одиннадцать, в главе араханта десять, в главе тысячи четырнадцать, в главе плохого двенадцать, в главе наказания одиннадцать, в главе старения девять, в главе себя десять, в главе света одиннадцать, в главе пробуждённого девять, в главе приятного восемь, в главе милого девять, в главе злости восемь, в главе пятна двенадцать, в главе стоящего в явлении десять, в главе пути двенадцать, в главе смешанного девять, в главе ада девять, в главе слона восемь, в главе цепляния двенадцать, в главе монаха двенадцать, в главе брахмана сорок — так триста пятьдесят историй.",
 "dhp423:9": "Семь-двадцать четыреста,",
 "dhp423:10": "четыре-истины-разъясняющим;",
 "dhp423:11": "Семь-трижды и историй,",
 "dhp423:12": "пятью-свыше возникло.",
 "dhp423:13": "В Дхаммападе главоглавление",
 "dhp423:14": "Пар не-беспечность ум,",
 "dhp423:15": "цветок незрелым мудрец;",
 "dhp423:16": "Араханты тысяча и,",
 "dhp423:17": "плохое наказанием те десять.",
 "dhp423:18": "Старение себя и свет и,",
 "dhp423:19": "Будда приятное с любимым;",
 "dhp423:20": "Злость пятно и установленный в Дхамме,",
 "dhp423:21": "главой пути двадцать.",
 "dhp423:22": "Смешанное ад слон,",
 "dhp423:23": "цепляние монах и брахман;",
 "dhp423:24": "Эти двадцать шесть глав,",
 "dhp423:25": "показано Родственником Солнца.",
 "dhp423:26": "Сводка строф",
 "dhp423:27": "В парных двадцать строф,",
 "dhp423:28": "в не-беспечности двенадцать;",
 "dhp423:29": "Одиннадцать в главе ума-состояния,",
 "dhp423:30": "в главе цветов шестнадцать.",
 "dhp423:31": "В глупце также шестнадцать строф,",
 "dhp423:32": "в мудреце четырнадцать;",
 "dhp423:33": "В арахантах десять строф,",
 "dhp423:34": "в тысяче становятся шестнадцать.",
 "dhp423:35": "Тринадцать в главе плохого,",
 "dhp423:36": "в наказании десять и семь;",
 "dhp423:37": "Одиннадцать в главе старения,",
 "dhp423:38": "в главе себя те десять.",
 "dhp423:39": "Двенадцать в главе мира,",
 "dhp423:40": "в главе Будды тринадцать;",
 "dhp423:41": "В приятном и в главе любимого,",
 "dhp423:42": "строфы становятся двенадцать.",
 "dhp423:43": "Четырнадцать в главе злости,",
 "dhp423:44": "в разделе пятен двадцать одна;",
 "dhp423:45": "Семнадцать же в разделе явлений,",
 "dhp423:46": "в разделе пути семнадцать.",
 "dhp423:47": "В смешанном шестнадцать строф,",
 "dhp423:48": "в аду и слоне четырнадцать;",
 "dhp423:49": "Двадцать шесть в разделе цепляния,",
 "dhp423:50": "двадцать три в разделе монахов.",
 "dhp423:51": "Сорок одна строфа,",
 "dhp423:52": "в разделе брахманов высочайшем;",
 "dhp423:53": "Четыре сотни строф,",
 "dhp423:54": "и двадцать три ещё;",
 "dhp423:55": "В Дхаммападе, в сборнике,",
 "dhp423:56": "показано Родственником Солнца.",
 "dhp423:57": "Палийский текст Дхаммапады завершён."
}
