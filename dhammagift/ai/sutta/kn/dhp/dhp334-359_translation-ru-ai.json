{
 "dhp334:0.1": "Малого Собрания",
 "dhp334:0.2": "Дхаммапада",
 "dhp334:0.3": "Глава Цепляния",
 "dhp334:0.4": "История о рыбе Капила",
 "dhp334:1": "У человека, живущего беспечно,",
 "dhp334:2": "Цепляние возрастает, словно малува;",
 "dhp334:3": "Он мечется туда-сюда,",
 "dhp334:4": "Как обезьяна в лесу, ищущая плод.",
 "dhp335:1": "Кого эта низкая одолевает,",
 "dhp335:2": "Цепляние, липкость в мире;",
 "dhp335:3": "Страдания его возрастают,",
 "dhp335:4": "Словно бирана под дождём.",
 "dhp336:1": "Кто же это низкое одолевает,",
 "dhp336:2": "Цепляние, трудно преодолимое в мире;",
 "dhp336:3": "Страдания от него отпадают,",
 "dhp336:4": "Как капля воды с лотоса.",
 "dhp337:1": "То вам говорю, благо вам,",
 "dhp337:2": "Сколько вас здесь собралось;",
 "dhp337:3": "Корень цепляния выкопайте,",
 "dhp337:4": "Как бирану, ищущему корень усиры;",
 "dhp337:5": "Пусть вас, как тростник в потоке,",
 "dhp337:6": "Мара не ломает снова и снова.",
 "dhp338:0": "История о поросятах",
 "dhp338:1": "Как у дерева с неповреждённым, крепким корнем,",
 "dhp338:2": "Даже срубленное, оно снова растёт;",
 "dhp338:3": "Так и с предрасположенностью к цеплянию, не удалённой,",
 "dhp338:4": "Возникает боль эта снова и снова.",
 "dhp339:1": "У кого тридцать шесть потоков,",
 "dhp339:2": "умо-приятные течения сильные;",
 "dhp339:3": "Большие несут неверный взгляд,",
 "dhp339:4": "помыслы на страсть опирающиеся.",
 "dhp340:1": "Текут повсюду потоки,",
 "dhp340:2": "лиана возникает, стоит;",
 "dhp340:3": "И её увидев, лиану возникшую,",
 "dhp340:4": "корень пониманием отсеките.",
 "dhp341:1": "Течения и привязанности,",
 "dhp341:2": "удовлетворённости бывают у существа;",
 "dhp341:3": "Те, к приятному привязанные, приятного ищущие,",
 "dhp341:4": "и идут те к рожденью-старости люди.",
 "dhp342:1": "Цеплянием предваряемые существа,",
 "dhp342:2": "мечутся, как заяц в силке;",
 "dhp342:3": "Связанностью-сцеплением-привязанные,",
 "dhp342:4": "к боли приходят снова и снова надолго.",
 "dhp343:1": "Цеплянием предваряемые существа,",
 "dhp343:2": "мечутся, как заяц в силке;",
 "dhp343:3": "Потому цепляние пусть отвергает,",
 "dhp343:4": "желая бесстрастия-неочарованности себе.",
 "dhp344:0": "История сбившегося с пути монаха",
 "dhp344:1": "Кто, безлесный, к лесу устремившийся,",
 "dhp344:2": "из леса выйдя, к лесу же бежит;",
 "dhp344:3": "Того человека здесь посмотрите,",
 "dhp344:4": "освобождённый, к связанности же бежит.",
 "dhp345:0": "История оков и темницы",
 "dhp345:1": "Не то крепкой связью называют мудрые,",
 "dhp345:2": "Что из железа, дерева и травы;",
 "dhp345:3": "Очарованно-увлечённые к жемчугам-серёжкам,",
 "dhp345:4": "К сыновьям, к жёнам — какая есть привязанность.",
 "dhp346:1": "Это крепкими узами называют мудрые,",
 "dhp346:2": "Увлекающими, мягкими, трудно-освобождаемыми;",
 "dhp346:3": "И это разрезав, странствуют,",
 "dhp346:4": "Не-ожидающие желания-приятное оставив.",
 "dhp347:0": "Кхематхери-история",
 "dhp347:1": "Которые страстью-очарованные попадают в поток,",
 "dhp347:2": "Сами-сделанную, как паук, сеть;",
 "dhp347:3": "И это разрезав, уходят мудрые,",
 "dhp347:4": "Не-ожидающие всю боль оставив.",
 "dhp348:0": "Уггасена-история",
 "dhp348:1": "Отпусти спереди, отпусти сзади,",
 "dhp348:2": "Посередине отпусти, бытие превзошедший;",
 "dhp348:3": "Везде освобождённый умом,",
 "dhp348:4": "Не придёшь ты снова к рождению-старению.",
 "dhp349:0": "Чула-дхануггаха-пандита-история",
 "dhp349:1": "Рассуждением-взбудораженного существа,",
 "dhp349:2": "Сильно-страстного, прекрасное-наблюдающего;",
 "dhp349:3": "Сильнее цепляние разрастается,",
 "dhp349:4": "Это ведь крепко делает связь.",
 "dhp350:1": "В рассуждений-успокоении же кто радуется,",
 "dhp350:2": "Не-ладность развивает всегда памятующий;",
 "dhp350:3": "Этот ведь положит конец,",
 "dhp350:4": "Этот разрежет Мары-связь.",
 "dhp351:0": "История Мары",
 "dhp351:1": "Достигший-цели, бесстрашный,",
 "dhp351:2": "Без-цепляния, без-изъяна;",
 "dhp351:3": "Отрезал бытия-стрелы,",
 "dhp351:4": "Последнее это тело.",
 "dhp352:1": "без-цепляния, без-поддерживания,",
 "dhp352:2": "В изложении-слов знающий;",
 "dhp352:3": "Букв сочетание,",
 "dhp352:4": "Должен знать предыдущее и последующее;",
 "dhp352:5": "Он есть — \"последнее-тело-имеющий,",
 "dhp352:6": "Великое-понимание, великий-человек\" говорится.",
 "dhp353:0": "История Упаки-Адживаки",
 "dhp353:1": "Всё-превзошедший, всё-знающий я,",
 "dhp353:2": "Во всех явлениях незапятнанный;",
 "dhp353:3": "Всё-отбросивший, в цепляния-исчерпании освобождённый,",
 "dhp353:4": "Сам опознав, кого бы указал.",
 "dhp354:0": "История вопроса Сакки",
 "dhp354:1": "Всякое даяние даяние Дхаммы превосходит,",
 "dhp354:2": "Всякий вкус вкус Дхаммы превосходит;",
 "dhp354:3": "Всякую радость радость Дхаммы превосходит,",
 "dhp354:4": "Цепляния-исчерпание всю боль превосходит.",
 "dhp355:0": "История бездетного богача",
 "dhp355:1": "Уничтожают богатства глупого,",
 "dhp355:2": "а не ищущего другого берега;",
 "dhp355:3": "Богатства-цеплянием глупый,",
 "dhp355:4": "уничтожает и себя самого.",
 "dhp356:0": "История Анкуры",
 "dhp356:1": "Сорняки-изъяны поля,",
 "dhp356:2": "страсть-изъян это поколение;",
 "dhp356:3": "Поэтому у лишённых-страсти,",
 "dhp356:4": "данное бывает великоплодным.",
 "dhp357:1": "Сорняки-изъяны поля,",
 "dhp357:2": "вредность-злоба-изъян это поколение;",
 "dhp357:3": "Поэтому у лишённых-вредности-злобы,",
 "dhp357:4": "данное бывает великоплодным.",
 "dhp358:1": "Сорняки-изъяны поля,",
 "dhp358:2": "замутненность-заблуждение-изъян это поколение;",
 "dhp358:3": "Поэтому у лишённых-замутненности-заблуждения,",
 "dhp358:4": "данное бывает великоплодным.",
 "dhp359:1": "Сорняки-изъяны поля,",
 "dhp359:2": "желание-изъян это поколение;",
 "dhp359:3": "Поэтому у лишённых-желания,",
 "dhp359:4": "данное бывает великоплодным.",
 "dhp359:5": "Глава Цепляния двадцать четвёртая."
}
