{
 "dhp76:0.1": "Малого Собрания",
 "dhp76:0.2": "Дхаммапада",
 "dhp76:0.3": "Глава Мудрецов",
 "dhp76:0.4": "История достопочтенного Радхи",
 "dhp76:1": "Как указывающего на сокровища,",
 "dhp76:2": "кого видит видящим изъяны;",
 "dhp76:3": "Порицающего, мудрого,",
 "dhp76:4": "такого мудреца пусть почитает;",
 "dhp76:5": "Такого почитающего,",
 "dhp76:6": "лучше, а не хуже.",
 "dhp77:0": "История Ассаджи и Пунаббасуки",
 "dhp77:1": "Пусть наставляет, пусть учит,",
 "dhp77:2": "и от неподобающего удерживает;",
 "dhp77:3": "Ведь благим он мил становится,",
 "dhp77:4": "неблагим становится немил.",
 "dhp78:0": "История достопочтенного Чханны",
 "dhp78:1": "Не следует общаться с плохими друзьями,",
 "dhp78:2": "не следует общаться с низкими людьми;",
 "dhp78:3": "Следует общаться с друзьями благими,",
 "dhp78:4": "следует общаться с высшими людьми.",
 "dhp79:0": "История достопочтенного Махакаппины",
 "dhp79:1": "Упоённый Дхаммой приятно спит,",
 "dhp79:2": "с прояснённым разумом;",
 "dhp79:3": "В провозглашённой Благородными Дхамме,",
 "dhp79:4": "всегда радуется мудрец.",
 "dhp80:0": "История послушника-мудреца",
 "dhp80:1": "Воду ведь ведут водопроводчики,",
 "dhp80:2": "Стрелочники выпрямляют стрелу;",
 "dhp80:3": "Дерево выпрямляют плотники,",
 "dhp80:4": "Себя укрощают мудрецы.",
 "dhp81:0": "История достопочтенного Лакундакабхаддии",
 "dhp81:1": "Как скала единым куском,",
 "dhp81:2": "ветром не колеблется;",
 "dhp81:3": "Так порицания-похвалам,",
 "dhp81:4": "не колеблются мудрецы.",
 "dhp82:0": "История Канаматы",
 "dhp82:1": "Как озеро глубокое,",
 "dhp82:2": "чистое, безмутное;",
 "dhp82:3": "Так явления услышав,",
 "dhp82:4": "проясняются мудрецы.",
 "dhp83:0": "История о пятистах монахах",
 "dhp83:1": "Везде вот чистые люди оставляют,",
 "dhp83:2": "Не желания-желающие говорят спокойные;",
 "dhp83:3": "Приятным затронутые или же болью,",
 "dhp83:4": "Не высоко-низко мудрецы показывают.",
 "dhp84:0": "История Дхаммикаттхеры",
 "dhp84:1": "Не ради себя, не ради другого,",
 "dhp84:2": "Не сына желает, ни богатства, ни царства;",
 "dhp84:3": "Не желал бы не-Дхаммой успеха себе,",
 "dhp84:4": "Тот нравственный, понимающий, следующий Дхамме будет.",
 "dhp85:0": "История Дхаммассаванаттхеры",
 "dhp85:1": "Малочисленны те среди людей,",
 "dhp85:2": "которые люди, на другой берег идущие;",
 "dhp85:3": "А вот эта остальная толпа,",
 "dhp85:4": "берег же обегает.",
 "dhp86:1": "А которые же правильно-изложенном,",
 "dhp86:2": "явлении следующими-за-явлением;",
 "dhp86:3": "Те люди на другой берег перейдут,",
 "dhp86:4": "смерти-владение трудно-переходимое.",
 "dhp87:0": "История пятисот пришедших монахов",
 "dhp87:1": "Тёмное явление полностью оставив,",
 "dhp87:2": "Светлое развивает мудрец;",
 "dhp87:3": "Из дома в бездомность придя,",
 "dhp87:4": "В уединении где далеко-радость.",
 "dhp88:1": "Там радость-в-уединении пусть ищет,",
 "dhp88:2": "оставив желания, ничего-не-имеющий;",
 "dhp88:3": "Пусть очистит себя,",
 "dhp88:4": "от ум-загрязнений мудрец.",
 "dhp89:1": "У которых в пробуждения-факторах,",
 "dhp89:2": "правильно ум-состояние хорошо-развито;",
 "dhp89:3": "В принятии-и-отказе,",
 "dhp89:4": "не поддерживая которые радуются;",
 "dhp89:5": "С истощёнными истечениями, сияющие,",
 "dhp89:6": "те в мире полностью угасшие.",
 "dhp89:7": "Глава Мудрецов Шестая."
}
