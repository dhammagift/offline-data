{
 "dhp33:0.1": "Малого Собрания",
 "dhp33:0.2": "Дхаммапада",
 "dhp33:0.3": "Глава Ума-состояния",
 "dhp33:0.4": "История Мегхия Тхеры",
 "dhp33:1": "Трепещущий, непостоянный ум,",
 "dhp33:2": "трудноохраняемый, трудносдерживаемый;",
 "dhp33:3": "Прямым делает мудрый,",
