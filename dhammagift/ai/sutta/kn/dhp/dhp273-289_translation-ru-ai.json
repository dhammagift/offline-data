{
 "dhp273:0.1": "Малого Собрания",
 "dhp273:0.2": "Дхаммапада",
 "dhp273:0.3": "Глава Путь",
 "dhp273:0.4": "История о пятистах монахах",
 "dhp273:1": "Из путей восьмичастный наилучший,",
 "dhp273:2": "из истин — четыре положения;",
 "dhp273:3": "Бесстрастие наилучшее из явлений,",
 "dhp273:4": "из двуногих — глазастый.",
 "dhp274:1": "Этот вот путь, нет другого",
 "dhp274:2": "для видения очищения;",
 "dhp274:3": "Вот его вы практикуйте,",
 "dhp274:4": "это Мары обманывание.",
 "dhp275:1": "Вот его практикуя,",
 "dhp275:2": "конец боли совершите;",
 "dhp275:3": "Объявлен вам мной путь,",
 "dhp275:4": "с узнаванием стрелы вынимание.",
 "dhp276:1": "Вами должно быть сделано усердие,",
 "dhp276:2": "объявители — Татхагаты;",
 "dhp276:3": "Практикующие освободятся,",
 "dhp276:4": "зажжённые, от Мары-уз.",
 "dhp277:0": "Тема признака ненадёжности",
 "dhp277:1": "“Все отождествления ненадёжны”,",
 "dhp277:2": "когда пониманием видит;",
 "dhp277:3": "Тогда теряет интерес к боли,",
 "dhp277:4": "это путь очищения.",
 "dhp278:0": "Тема признака боли",
 "dhp278:1": "“Все отождествления болезненны”,",
 "dhp278:2": "когда пониманием видит;",
 "dhp278:3": "Тогда теряет интерес к боли,",
 "dhp278:4": "это путь очищения.",
 "dhp279:0": "Тема признака бессамости",
 "dhp279:1": "«Все явления не-самость», —",
 "dhp279:2": "когда пониманием видит;",
 "dhp279:3": "Тогда теряет интерес к боли,",
 "dhp279:4": "это путь очищения.",
 "dhp280:0": "История достопочтенного Падханакамматиссы",
 "dhp280:1": "Время подъёма не поднимающийся,",
 "dhp280:2": "Юный, сильный, ленью обладающий;",
 "dhp280:3": "С ослабленными устремлениями-умом, ленивый,",
 "dhp280:4": "Пониманием путь вялый не находит.",
 "dhp281:0": "История голодного духа-свиньи",
 "dhp281:1": "Речь охраняя, умом хорошо сдержанный,",
 "dhp281:2": "И телом неблагого не делай;",
 "dhp281:3": "Эти три пути активности очисти,",
 "dhp281:4": "Достигни пути, мудрецами возвещённого.",
 "dhp282:0": "История достопочтенного Поттхилы",
 "dhp282:1": "Из связи ведь рождается мудрость,",
 "dhp282:2": "Из не-связи — мудрости исчерпание;",
 "dhp282:3": "Этот двупуть познав,",
 "dhp282:4": "Для становления и для разлучения;",
 "dhp282:5": "Так себя пусть утвердит,",
 "dhp282:6": "Как мудрость возрастает.",
 "dhp283:0": "История пяти старых монахов",
 "dhp283:1": "Лес рубите, не дерево,",
 "dhp283:2": "Из леса рождается тревога;",
 "dhp283:3": "Срубив лес и чащу,",
 "dhp283:4": "Без-лесными будьте, монахи.",
 "dhp284:1": "Пока ведь чаща не отсечена,",
 "dhp284:2": "Даже малейшее у мужчины к женщинам;",
 "dhp284:3": "Привязан ум-представление до тех пор он,",
 "dhp284:4": "Как телёнок, молоко-пьющий, к матери.",
 "dhp285:0": "История уважаемого золотых-дел-мастера",
 "dhp285:1": "Отрежь привязанность к себе,",
 "dhp285:2": "Как водяную лилию осеннюю рукой;",
 "dhp285:3": "Путь-успокоения именно развивай,",
 "dhp285:4": "Ниббану Благим указанную.",
 "dhp286:0": "История о богатом купце",
 "dhp286:1": "Здесь год проживу,",
 "dhp286:2": "здесь зиму и лето;",
 "dhp286:3": "Так глупец размышляет,",
 "dhp286:4": "препятствия не понимает.",
 "dhp287:0": "История Кисаготами",
 "dhp287:1": "Того сыновьями-скотом-опьянённого,",
 "dhp287:2": "с привязанным-умом человека;",
 "dhp287:3": "Спящую деревню как большой-поток,",
 "dhp287:4": "смерть забрав уносит.",
 "dhp288:0": "История Патачары",
 "dhp288:1": "Не существуют сыновья для защиты,",
 "dhp288:2": "ни отец, ни родственники;",
 "dhp288:3": "Смертью-охваченного,",
 "dhp288:4": "нет у родственников защиты.",
 "dhp289:1": "Этого блага-смысла-цели-силу узнав,",
 "dhp289:2": "мудрец, нравственностью-сдержанный;",
 "dhp289:3": "К ниббане-ведущий путь,",
 "dhp289:4": "быстро очистит.",
 "dhp289:5": "Глава Путь двадцатая."
}
