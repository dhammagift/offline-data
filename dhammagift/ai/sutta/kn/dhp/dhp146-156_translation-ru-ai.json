{
 "dhp146:0.1": "Малого Собрания",
 "dhp146:0.2": "Дхаммапада",
 "dhp146:0.3": "Старость",
 "dhp146:0.4": "История подруг Висакхи",
 "dhp146:1": "Что же за смех, что за радость,",
 "dhp146:2": "когда постоянно пылает;",
 "dhp146:3": "Тьмой покрытые,",
 "dhp146:4": "светильник не ищете.",
 "dhp147:0": "История Сиримы",
 "dhp147:1": "Взгляни на искусно сделанный образ,",
 "dhp147:2": "тело из ран составленное;",
 "dhp147:3": "Больное, многоустремлённое,",
 "dhp147:4": "у которого нет постоянного пребывания.",
 "dhp148:0": "История старшей монахини Уттары",
 "dhp148:1": "Изношена эта материя,",
 "dhp148:2": "гнездо болезней, хрупкая;",
 "dhp148:3": "Разрушается гнилое тело,",
 "dhp148:4": "ведь смерть — конец жизни.",
 "dhp149:0": "История нескольких монахов с завышенной самооценкой",
 "dhp149:1": "Те, что эти негодные,",
 "dhp149:2": "словно тыквы осенью;",
 "dhp149:3": "голубиные кости,",
 "dhp149:4": "их увидев, какое наслаждение.",
 "dhp150:0": "История монахини Нанды, красавицы страны",
 "dhp150:1": "Из костей город построен,",
 "dhp150:2": "мясом и кровью обмазан;",
 "dhp150:3": "Где старость и смерть,",
 "dhp150:4": "самомнение и лицемерие положены.",
 "dhp151:0": "История царицы Маллики",
 "dhp151:1": "Стареют ведь царские колесницы, прекрасно украшенные,",
 "dhp151:2": "И тело тоже к старости подходит;",
 "dhp151:3": "Но Дхамма благих к старости не подходит,",
 "dhp151:4": "Мирные ведь с хорошими объявляют.",
 "dhp152:0": "История старца Лалудайи",
 "dhp152:1": "Малоуслышавший этот человек,",
 "dhp152:2": "как бык-бык стареет;",
 "dhp152:3": "Мяса его возрастают,",
 "dhp152:4": "понимание его не возрастает.",
 "dhp153:0": "История Уданы",
 "dhp153:1": "Много-рождений-блуждание,",
 "dhp153:2": "блуждал я без нахождения;",
 "dhp153:3": "Строителя дома ища,",
 "dhp153:4": "болезненно рождение снова и снова.",
 "dhp154:1": "Строитель дома, ты увиден,",
 "dhp154:2": "снова дома не построишь;",
 "dhp154:3": "Все твои стропила разбиты,",
 "dhp154:4": "конёк дома разрушен;",
 "dhp154:5": "К разрушению пришедший ум,",
 "dhp154:6": "цепляний исчерпания достиг.",
 "dhp155:0": "История сына богатого купца Махадханы",
 "dhp155:1": "Не прожив святой жизни,",
 "dhp155:2": "не получив в юности богатства;",
 "dhp155:3": "Как старые цапли зажигаются,",
 "dhp155:4": "в пруду с иссякшей рыбой.",
 "dhp156:1": "Не прожив святой жизни,",
 "dhp156:2": "не получив в юности богатства;",
 "dhp156:3": "Лежат как стрелы, слишком истощённые,",
 "dhp156:4": "старое оплакивая.",
 "dhp156:5": "Глава Старение Одиннадцатая."
}
