{
 "dhp360:0.1": "Малого Собрания",
 "dhp360:0.2": "Дхаммапада",
 "dhp360:0.3": "Монахов раздел",
 "dhp360:0.4": "Пять монахов история",
 "dhp360:1": "Глазом сдержанность — хорошо,",
 "dhp360:2": "хорошо ухом сдержанность;",
 "dhp360:3": "Носом сдержанность — хорошо,",
 "dhp360:4": "хорошо языком сдержанность.",
 "dhp361:1": "Телом сдержанность — хорошо,",
 "dhp361:2": "хороша речью сдержанность;",
 "dhp361:3": "Умом-представлением сдержанность хороша,",
 "dhp361:4": "хорошо везде сдержанность;",
 "dhp361:5": "Везде сдержанный монах,",
 "dhp361:6": "от всей боли не освобождается.",
 "dhp362:0": "Гусеубийцы-монаха история",
 "dhp362:1": "Рукой сдержанный, ногой сдержанный,",
 "dhp362:2": "Речью сдержанный, сдержанный-высший;",
 "dhp362:3": "Внутренне-радующийся, собранный,",
 "dhp362:4": "Один довольный — того зовут монахом.",
 "dhp363:0": "Кокалики история",
 "dhp363:1": "Кто ртом сдержанный монах,",
 "dhp363:2": "речью-говорящий, невзволнованный;",
 "dhp363:3": "Благо и Дхамму освещает,",
 "dhp363:4": "сладка того речь.",
 "dhp364:0": "Дхамма-радостного старца история",
 "dhp364:1": "Дхамма-радостный, Дхамма-наслаждающийся,",
 "dhp364:2": "Дхамму обдумывающий;",
 "dhp364:3": "Дхамму вспоминающий монах,",
 "dhp364:4": "от благой-Дхаммы не отпадает.",
 "dhp365:0": "Враждебно-обслуживающего монаха история",
 "dhp365:1": "Полученное не презирать",
 "dhp365:2": "на других с завистью не смотри;",
 "dhp365:3": "На других с завистью монах,",
 "dhp365:4": "самадхи не достигает.",
 "dhp366:1": "Даже с малым обретением монах,",
 "dhp366:2": "своё обретение не презирает;",
 "dhp366:3": "Его поистине дэвы восхваляют,",
 "dhp366:4": "чисто-живущего неутомимого.",
 "dhp367:0": "История о брахмане, дарителе пяти мер зерна",
 "dhp367:1": "Полностью в имени-материи,",
 "dhp367:2": "у кого нет «моё»;",
 "dhp367:3": "и из-за не-сущего не страдает,",
 "dhp367:4": "он есть «монахом» называется.",
 "dhp368:0": "История о многих монахах",
 "dhp368:1": "Кто в мирности пребывает, тот монах,",
 "dhp368:2": "уверенный в Учении Пробуждённого;",
 "dhp368:3": "Достигает пути покоя,",
 "dhp368:4": "успокоения составляющих — приятного.",
 "dhp369:1": "Вычерпывай, монах, этот плот,",
 "dhp369:2": "вычерпанный, он лёгким тебе будет;",
 "dhp369:3": "Отрезав страсть и злобу,",
 "dhp369:4": "оттуда к ниббане придёшь.",
 "dhp370:1": "Пять отрежь, пять отбрось,",
 "dhp370:2": "пять сверх того развивать;",
 "dhp370:3": "Пять завязки-превозшедший монах,",
 "dhp370:4": "«затопление переплывшим» называется.",
 "dhp371:1": "Зажгись, монах, не будь беспечным,",
 "dhp371:2": "Пусть тебя желания-множители не веселят ум-состояние;",
 "dhp371:3": "Пусть железный шар не проглотишь, беспечный,",
 "dhp371:4": "Не плачь: «Это боль», — сгорая.",
 "dhp372:1": "Нет джханы у непонимающего,",
 "dhp372:2": "понимания нет у не-джханающего;",
 "dhp372:3": "У кого джхана и понимание есть,",
 "dhp372:4": "тот — вблизи ниббаны.",
 "dhp373:1": "В пустое жилище войдя,",
 "dhp373:2": "с успокоенным умом монаха;",
 "dhp373:3": "нечеловеческая радость бывает,",
 "dhp373:4": "правильно явление проницающему.",
 "dhp374:1": "Откуда-откуда ни осмысливает",
 "dhp374:2": "блоков возникновение-исчезновение;",
 "dhp374:3": "Обретает озарённость-упоение и смягченную-радость,",
 "dhp374:4": "бессмертное то для знающих.",
 "dhp375:1": "Здесь начало бывает,",
 "dhp375:2": "здесь у понимающего монаха;",
 "dhp375:3": "Способностей охрана, довольство,",
 "dhp375:4": "и в Патимоккхе сдержанность.",
 "dhp376:1": "Друзей общайся благих,",
 "dhp376:2": "с чистой жизнью, неутомимых;",
 "dhp376:3": "Гостеприимным будь,",
 "dhp376:4": "в поведении умелым пусть будет;",
 "dhp376:5": "Оттого смягченной-радости обильный,",
 "dhp376:6": "боли край совершит.",
 "dhp377:0": "История о пятистах монахах",
 "dhp377:1": "Как жасмин цветы,",
 "dhp377:2": "увядшие сбрасывает;",
 "dhp377:3": "Так очарованность-страсть и вредность-злобу,",
 "dhp377:4": "сбросьте, монахи.",
 "dhp378:0": "Сутта о Достопочтенном Сантакайе",
 "dhp378:1": "Тело-успокоенный, речь-успокоенная,",
 "dhp378:2": "успокоенный, хорошо-сосредоточенный;",
 "dhp378:3": "Выплюнувший мирское-желание монах,",
 "dhp378:4": "“успокоенный” говорится.",
 "dhp379:0": "Сутта о Достопочтенном Нангалакуле",
 "dhp379:1": "Собой побуждай себя,",
 "dhp379:2": "проверяй себя;",
 "dhp379:3": "Так себя-охраняющий, памятующий,",
 "dhp379:4": "приятно, монах, будешь располагаться.",
 "dhp380:1": "Себя ведь самому — господин,",
 "dhp380:2": "кто же господином другим может быть?",
 "dhp380:3": "Ведь себя — своё направление,",
 "dhp380:4": "поэтому сдерживай себя;",
 "dhp380:5": "Как коня благородного — торговец.",
 "dhp381:0": "Сутта о Достопочтенном Ваккали",
 "dhp381:1": "Смягченной-радости-обильный монах,",
 "dhp381:2": "уверенный в Учении Пробуждённого;",
 "dhp381:3": "Достигает пути покоя,",
 "dhp381:4": "успокоения составляющих — приятного.",
 "dhp382:0": "Сутта о послушнике Сумане",
 "dhp382:1": "Кто вот молодой монах,",
 "dhp382:2": "занимается в учении Пробуждённого;",
 "dhp382:3": "Этот мир освещает,",
 "dhp382:4": "из-за облака освобождённая как луна.",
 "dhp382:5": "Глава о монахах двадцать пятая."
}
