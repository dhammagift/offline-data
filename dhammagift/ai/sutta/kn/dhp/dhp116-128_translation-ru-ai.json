{
 "dhp116:0.1": "Малого Собрания",
 "dhp116:0.2": "Дхаммапада",
 "dhp116:0.3": "Глава Плохого",
 "dhp116:0.4": "История брахмана Чулекасатаки",
 "dhp116:1": "Спеши к благому,",
 "dhp116:2": "от плохого ум удерживай;",
 "dhp116:3": "Ведь медленно делающий благо,",
 "dhp116:4": "в плохом радуется ум-представление.",
 "dhp117:0": "История Сейясакаттхеры",
 "dhp117:1": "Если плохое человек делает,",
 "dhp117:2": "пусть не делает его снова и снова;",
 "dhp117:3": "В нём импульс пусть не делает,",
 "dhp117:4": "Болезненно плохого накопление.",
 "dhp118:0": "История дочери дэвы Ладжи",
 "dhp118:1": "Если благое человек делает,",
 "dhp118:2": "пусть делает его снова и снова;",
 "dhp118:3": "В нём импульс пусть делает,",
 "dhp118:4": "приятно благого накопление.",
 "dhp119:0": "История домохозяина Анатхапиндики",
 "dhp119:1": "Плохой тоже видит благо,",
 "dhp119:2": "пока плохое не созреет;",
 "dhp119:3": "А когда созреет плохое,",
 "dhp119:4": "Когда же созревает плохое, тогда плохой видит плохие [дела].",
 "dhp120:1": "Благой тоже видит плохое,",
 "dhp120:2": "пока благое не созреет;",
 "dhp120:3": "Когда же созревает благое,",
 "dhp120:4": "тогда благой видит благие [дела].",
 "dhp121:0": "История о необузданном снаряжении",
 "dhp121:1": "Не пренебрегай плохим,",
 "dhp121:2": "«не придёт ко мне»;",
 "dhp121:3": "Капля за каплей падая,",
 "dhp121:4": "и кувшин с водой наполняется;",
 "dhp121:5": "Глупый наполняется плохим,",
 "dhp121:6": "понемногу накапливая.",
 "dhp122:0": "История о богаче Билалападаке",
 "dhp122:1": "Не пренебрегай благом,",
 "dhp122:2": "«не придёт ко мне»;",
 "dhp122:3": "Капля за каплей падая,",
 "dhp122:4": "и кувшин с водой наполняется;",
 "dhp122:5": "Знаток наполняется благом,",
 "dhp122:6": "понемногу накапливая.",
 "dhp123:0": "История о богатом купце",
 "dhp123:1": "Как купец — опасный путь,",
 "dhp123:2": "с малым сопровождением, с большим богатством;",
 "dhp123:3": "Как яд — желающий жить,",
 "dhp123:4": "так плохого следует избегать.",
 "dhp124:0": "История о друге-охотнике Куккуты",
 "dhp124:1": "Если бы на руке не было раны,",
 "dhp124:2": "можно было бы рукой нести яд;",
 "dhp124:3": "Нераненого яд не поражает,",
 "dhp124:4": "нет плохого у неделающего.",
 "dhp125:0": "История о волке-охотнике Коке",
 "dhp125:1": "Кто неиспорченному человеку вредит,",
 "dhp125:2": "Чистого человека, без-изъяна;",
 "dhp125:3": "Того же незрелого настигает плохое,",
 "dhp125:4": "Мелкая пыль, брошенная против ветра.",
 "dhp126:0": "История достопочтенного Тиссы, жившего в семье изготовителя драгоценностей",
 "dhp126:1": "В утробе некоторые рождаются,",
 "dhp126:2": "в ад — плохую активность делающие;",
 "dhp126:3": "Рая благого достигают,",
 "dhp126:4": "полностью угасают без истечений.",
 "dhp127:0": "История трёх йоджан",
 "dhp127:1": "Не в пространстве, не в середине океана,",
 "dhp127:2": "Не в расщелину гор войдя;",
 "dhp127:3": "Не находится та область в мире,",
 "dhp127:4": "Где стоящий освободился бы от плохой активности.",
 "dhp128:0": "История Суббуддхи из Сакьев",
 "dhp128:1": "Не в пространстве, не в середине океана,",
 "dhp128:2": "Не в расщелину гор войдя;",
 "dhp128:3": "Не находится та область в мире,",
 "dhp128:4": "Где стоящего не одолела бы смерть.",
 "dhp128:5": "Глава Плохого девятая."
