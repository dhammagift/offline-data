{
 "dhp44:0.1": "Малого Собрания",
 "dhp44:0.2": "Дхаммапада",
 "dhp44:0.3": "Раздел Цветок",
 "dhp44:0.4": "История пятисот монахов, увлечённых разговором о земле",
 "dhp44:1": "Кто эту землю превзойдёт,",
 "dhp44:2": "И мир Ямы и этот с дэвами;",
 "dhp44:3": "Кто Дхаммы-строку хорошо-преподанную,",
 "dhp44:4": "Умелый как цветок разберёт.",
 "dhp45:1": "Ученик землю превзойдёт,",
 "dhp45:2": "И мир Ямы и этот с дэвами;",
 "dhp45:3": "Ученик Дхаммы-строку хорошо-преподанную,",
 "dhp45:4": "Умелый как цветок разберёт.",
 "dhp46:0": "История монаха, медитирующего на мираж",
 "dhp46:1": "Пене-подобным это тело увидев,",
 "dhp46:2": "Мираж-природу полностью-осознав;",
 "dhp46:3": "Отрезав у Мары цветущие-побеги,",
 "dhp46:4": "К невидимости царя-смерти придёт.",
 "dhp47:0": "История Витатубхи",
 "dhp47:1": "Цветы ведь собирающего,",
 "dhp47:2": "с привязанным-умом человека;",
 "dhp47:3": "Спящую деревню как большой-поток,",
 "dhp47:4": "смерть забрав уносит.",
 "dhp48:0": "История девушки Патипуджики",
 "dhp48:1": "Цветы ведь собирающего,",
 "dhp48:2": "с привязанным-умом человека;",
 "dhp48:3": "Ненасытными именно в желаниях,",
 "dhp48:4": "кончающий делает подвластными.",
 "dhp49:0": "История скупого богача Косии",
 "dhp49:1": "Как пчела на цветок,",
 "dhp49:2": "не повреждая окраску и запах;",
 "dhp49:3": "Улетает, взяв нектар,",
 "dhp49:4": "так в деревне пусть странствует мудрец.",
 "dhp50:0": "Павеййя-аджйвака-ваттху",
 "dhp50:1": "Не на чужие недостатки,",
 "dhp50:2": "не на чужое сделанное-несделанное;",
 "dhp50:3": "На своё же пусть смотрит,",
 "dhp50:4": "на сделанное и несделанное.",
 "dhp51:0": "Чаттапани-упасака-ваттху",
 "dhp51:1": "Как прекрасный цветок,",
 "dhp51:2": "красочный, но без запаха;",
 "dhp51:3": "Так хорошо сказанная речь,",
 "dhp51:4": "бесплодна у не делающего.",
 "dhp52:1": "Как прекрасный цветок,",
 "dhp52:2": "Красочный и с запахом;",
 "dhp52:3": "Так хорошо сказанная речь,",
 "dhp52:4": "Плодоносна у делающего.",
 "dhp53:0": "Висакха-ваттху",
 "dhp53:1": "Как из груды цветов",
 "dhp53:2": "можно сделать много гирлянд;",
 "dhp53:3": "Так рождённым смертным",
 "dhp53:4": "нужно делать много благотворного.",
 "dhp54:0": "Ананда-тхера-паньха-ваттху",
 "dhp54:1": "Не цветочный запах против ветра идёт,",
 "dhp54:2": "Не сандал, тагара, жасмин;",
 "dhp54:3": "А благих запах против ветра идёт,",
 "dhp54:4": "Во все стороны чистый человек благоухает.",
 "dhp55:1": "Сандал, тагара или же",
 "dhp55:2": "голубой лотос или жасмин;",
 "dhp55:3": "Из этих видов-запахов,",
 "dhp55:4": "запах нравственности непревзойдённый.",
 "dhp56:0": "История о подаянии еды уважаемому Махакассапе",
 "dhp56:1": "Незначителен этот запах,",
 "dhp56:2": "который от тагары и сандала;",
 "dhp56:3": "А какой запах нравственных,",
 "dhp56:4": "веет среди дэвов высший.",
 "dhp57:0": "История окончательной ниббаны уважаемого Годхики",
 "dhp57:1": "У тех, у кого нравственность совершенна,",
 "dhp57:2": "пребывающих в не-беспечности;",
 "dhp57:3": "правильно-понявших-высвободившихся,",
 "dhp57:4": "Мару путь не найти.",
 "dhp58:0": "История Гарахадинны",
 "dhp58:1": "Как на мусорной куче,",
 "dhp58:2": "выброшенной на большую дорогу;",
 "dhp58:3": "Лотос там родился бы,",
 "dhp58:4": "чистым запахом уму-восхитительный.",
 "dhp59:1": "Так среди ставших мусором,",
 "dhp59:2": "ставших слепыми обывателей;",
 "dhp59:3": "Сияет пониманием,",
 "dhp59:4": "слушатель правильно-пробуждённого.",
 "dhp59:5": "Глава Пуппха Четвёртая."
}
