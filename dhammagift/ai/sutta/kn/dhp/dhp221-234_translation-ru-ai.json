{
 "dhp221:0.1": "Малого Собрания",
 "dhp221:0.2": "Дхаммапада",
 "dhp221:0.3": "Глава гнева",
 "dhp221:0.4": "История Рохини-кхаттия-девушки",
 "dhp221:1": "Злость пусть оставит, пусть полностью оставит самомнение,",
 "dhp221:2": "Связанность всю пусть преодолеет;",
 "dhp221:3": "Того, в имя-образе не застревающего,",
 "dhp221:4": "Ничего-не-имеющего, не настигают боли.",
 "dhp222:0": "История некоего монаха",
 "dhp222:1": "Кто же возникший гнев,",
 "dhp222:2": "как колесницу зашатавшуюся, сдержит;",
 "dhp222:3": "Того я возничим называю,",
 "dhp222:4": "вожжи-держатель — иной человек.",
 "dhp223:0": "История мирянки Уттары",
 "dhp223:1": "Без-гнева победи гнев,",
 "dhp223:2": "не-благое благим победи;",
 "dhp223:3": "Победи скупость даянием,",
 "dhp223:4": "правдой — лживо-говорящего.",
 "dhp224:0": "История вопроса Махамоггалланы",
 "dhp224:1": "Правду говори, не гневайся,",
 "dhp224:2": "дай, даже малое, попрошенный;",
 "dhp224:3": "Этими тремя основаниями,",
 "dhp224:4": "иди к дэвам вблизи.",
 "dhp225:0": "История брахмана-отца Будды",
 "dhp225:1": "Невредительные которые мудрецы,",
 "dhp225:2": "всегда телом сдержанные;",
 "dhp225:3": "Те идут к не-уходящему месту,",
 "dhp225:4": "куда придя, не страдают.",
 "dhp226:0": "История рабыни Пунны",
 "dhp226:1": "Всегда бодрствующих,",
 "dhp226:2": "ночь-и-день обучающихся;",
 "dhp226:3": "Ниббану решившиеся,",
 "dhp226:4": "к прекращению приходят истечения.",
 "dhp227:0": "История мирянина Атулы",
 "dhp227:1": "Древнее это, Атула,",
 "dhp227:2": "не это сегодняшнее только;",
 "dhp227:3": "Порицают молча сидящего,",
 "dhp227:4": "порицают много говорящего;",
 "dhp227:5": "Умеренно говорящего также порицают,",
 "dhp227:6": "нет на свете непорицаемого.",
 "dhp228:1": "Не было и не будет,",
 "dhp228:2": "и сейчас не различается;",
 "dhp228:3": "Всецело порицаемый человек,",
 "dhp228:4": "всецело или восхваляемый.",
 "dhp229:1": "И кого знающие восхваляют,",
 "dhp229:2": "исследовав день за днём;",
 "dhp229:3": "Безупречного в поведении, мудрого,",
 "dhp229:4": "пониманием и нравственностью собранного.",
 "dhp230:1": "Как монета из ямбонского золота,",
 "dhp230:2": "кто того порицать достоин;",
 "dhp230:3": "Дэвы также его одобряют,",
 "dhp230:4": "Даже Брахмой восхваляем.",
 "dhp231:0": "История шестигрупповых",
 "dhp231:1": "Телесный гнев пусть охраняет,",
 "dhp231:2": "телом сдержанным пусть будет;",
 "dhp231:3": "Телесное неблагое поведение оставив,",
 "dhp231:4": "телом благое поведение пусть ведёт.",
 "dhp232:1": "Речевой гнев пусть охраняет,",
 "dhp232:2": "речью сдержанным пусть будет;",
 "dhp232:3": "Речи-дурное-поведение оставив,",
 "dhp232:4": "речью благое-поведение пусть ведёт.",
 "dhp233:1": "Ума-испорченность пусть охраняет,",
 "dhp233:2": "умом сдержанным пусть будет;",
 "dhp233:3": "Ума-дурное-поведение оставив,",
 "dhp233:4": "умом благое-поведение пусть ведёт.",
 "dhp234:1": "Телом сдержанные мудрые,",
 "dhp234:2": "после — речью сдержанные;",
 "dhp234:3": "Умом сдержанные мудрые,",
 "dhp234:4": "вот те хорошо-сдержанные.",
 "dhp234:5": "Глава Кодха Семнадцатая."
}
