{
 "dhp235:0.1": "Малого Собрания",
 "dhp235:0.2": "Дхаммапада",
 "dhp235:0.3": "Пятна-раздел",
 "dhp235:0.4": "История сына мясника",
 "dhp235:1": "Как жёлтый лист ты теперь,",
 "dhp235:2": "И слуги Ямы уже пред тобой;",
 "dhp235:3": "На пороге ухода ты стоишь,",
 "dhp235:4": "И запаса в пути у тебя нет.",
 "dhp236:1": "Сделай же себе остров,",
 "dhp236:2": "Быстро старайся, мудрецом стань;",
 "dhp236:3": "С выметенным пятном, без изъяна,",
 "dhp236:4": "Божественной благородной земли достигнешь.",
 "dhp237:1": "И жизнь подошла к концу теперь,",
 "dhp237:2": "Ты приблизился к присутствию Ямы;",
 "dhp237:3": "Пристанища нет у тебя в пути,",
 "dhp237:4": "И запаса в пути у тебя нет.",
 "dhp238:1": "Сделай же себе остров,",
 "dhp238:2": "Быстро старайся, мудрецом стань;",
 "dhp238:3": "С выметенным пятном, без изъяна,",
 "dhp238:4": "Не придёшь ты снова к рождению-старению.",
 "dhp239:0": "История некоего брахмана",
 "dhp239:1": "Постепенно мудрый,",
 "dhp239:2": "понемногу, мгновение за мгновением;",
 "dhp239:3": "Как серебряных дел мастер,",
 "dhp239:4": "выметай пятно своё.",
 "dhp240:0": "История Тисса Тхеры",
 "dhp240:1": "Как из железа возникшая ржавчина,",
 "dhp240:2": "от него же самого и пожирает его;",
 "dhp240:3": "Так и чрезмерно блуждающего",
 "dhp240:4": "свои же активности ведут в дурную участь.",
 "dhp241:0": "История Лалудайи",
 "dhp241:1": "Без-повторения-пятно — гимнов,",
 "dhp241:2": "без-подъёма-пятно — домов;",
 "dhp241:3": "Пятно красоты — лень,",
 "dhp241:4": "беспечность — охраняющего пятно.",
 "dhp242:0": "История о некоем сыне из хорошей семьи",
 "dhp242:1": "Пятно женщины — плохое-поведение,",
 "dhp242:2": "скупость — дающего пятно;",
 "dhp242:3": "Пятна ведь плохие явления,",
 "dhp242:4": "в этом мире и в следующем.",
 "dhp243:1": "Чем те пятна, пятно-более-пятна,",
 "dhp243:2": "неведение — высшее пятно;",
 "dhp243:3": "Это пятно отбросив,",
 "dhp243:4": "без-пятен будьте, монахи.",
 "dhp244:0": "История о младшем монахе Сари",
 "dhp244:1": "Легко живётся бесстыдному,",
 "dhp244:2": "вороне-дерзкому, нахальному;",
 "dhp244:3": "Врывающемуся, развязному,",
 "dhp244:4": "запятнанному — жизнь.",
 "dhp245:1": "А стыдливому трудно живётся,",
 "dhp245:2": "всегда ищущему чистоту;",
 "dhp245:3": "Не-принижающему, не-развязному,",
 "dhp245:4": "с чистой жизнью, видящему.",
 "dhp246:0": "История о пяти мирянах",
 "dhp246:1": "Кто жизнь уменьшает,",
 "dhp246:2": "и ложное-утверждение говорит;",
 "dhp246:3": "В мире неданное берёт,",
 "dhp246:4": "и к чужой жене идёт.",
 "dhp247:1": "И опьяняющие-напитки-вино-питьё,",
 "dhp247:2": "какой человек предаётся;",
 "dhp247:3": "Здесь же в этом мире,",
 "dhp247:4": "корень подрывает свой.",
 "dhp248:1": "Так, уважаемый человек, знай:",
 "dhp248:2": "плохие явления — необузданные;",
 "dhp248:3": "Пусть тебя корыстолюбие и не-Дхамма",
 "dhp248:4": "долго к боли не приведут.",
 "dhp249:0": "История о младшем Тиссе",
 "dhp249:1": "Даёт ведь по-вере,",
 "dhp249:2": "по-убеждению человек;",
 "dhp249:3": "Там кто же смущается,",
 "dhp249:4": "у других еды-питья;",
 "dhp249:5": "Не тот днём ли ночью ли,",
 "dhp249:6": "самадхи достигает.",
 "dhp250:1": "У кого же это отсечено,",
 "dhp250:2": "с-корнем-вырвано, устранено;",
 "dhp250:3": "Тот ведь днём ли ночью ли,",
 "dhp250:4": "самадхи достигает.",
 "dhp251:0": "История о пяти мирянах",
 "dhp251:1": "Нет огня, подобного страсти,",
 "dhp251:2": "нет вредности-злобы равной зацепки;",
 "dhp251:3": "Нет замутненности-заблуждения равной сети,",
 "dhp251:4": "нет цепляния равной реки.",
 "dhp252:0": "Мендака-купец история",
 "dhp252:1": "Легко видимы изъяны у-других,",
 "dhp252:2": "свои же трудно-видимы;",
 "dhp252:3": "У других ведь те изъяны,",
 "dhp252:4": "развеивает как мякину;",
 "dhp252:5": "Свои же покрывает,",
 "dhp252:6": "как проигрыш игрок плутоватый.",
 "dhp253:0": "Уджджхана-сознающий старец история",
 "dhp253:1": "Чужие-изъяны-наблюдающего,",
 "dhp253:2": "постоянно уджджхана-сознающего;",
 "dhp253:3": "Истечения у того возрастают,",
 "dhp253:4": "далёк тот от-истечений-исчерпания.",
 "dhp254:0": "История странствующего аскета Субхадды",
 "dhp254:1": "В небе следа нет,",
 "dhp254:2": "шрамана нет вовне;",
 "dhp254:3": "В разрастании радуется поколение,",
 "dhp254:4": "без-разрастания — Татхагаты.",
 "dhp255:1": "В небе следа нет,",
 "dhp255:2": "шрамана нет вовне;",
 "dhp255:3": "Отождествления постоянными не бывают,",
 "dhp255:4": "нет у Пробуждённых колебания.",
 "dhp255:5": "Глава Пятна Восемнадцатая."
}
