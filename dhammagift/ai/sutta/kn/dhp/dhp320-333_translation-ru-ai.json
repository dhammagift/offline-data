{
 "dhp320:0.1": "Малого Собрания",
 "dhp320:0.2": "Дхаммапада",
 "dhp320:0.3": "Глава Слон",
 "dhp320:0.4": "История об укрощённом себе",
 "dhp320:1": "Я, как слон в столкновении,",
 "dhp320:2": "с лука упавшую стрелу;",
 "dhp320:3": "Пересуды буду терпеть,",
 "dhp320:4": "ведь безнравственна толпа.",
 "dhp321:1": "Укрощённого ведут на собрание,",
 "dhp321:2": "укрощённого царь восседает;",
 "dhp321:3": "Укрощённый лучший среди людей,",
 "dhp321:4": "который пересуды терпит.",
 "dhp322:1": "Превосходны укрощённые мулы,",
 "dhp322:2": "чистокровные скакуны и синдские кони;",
 "dhp322:3": "Слоны и великие слоны,",
 "dhp322:4": "укрощённый собой — лучше того.",
 "dhp323:0": "История о бывшем укротителе слонов, ставшем монахом",
 "dhp323:1": "Ведь не на этих средствах передвижения,",
 "dhp323:2": "можно достичь не-достигнутой стороны;",
 "dhp323:3": "Как хорошо укрощённым собой,",
 "dhp323:4": "укрощённый укрощённым идёт.",
 "dhp324:0": "История о сыне состарившегося брахмана",
 "dhp324:1": "Дханапало имя слон,",
 "dhp324:2": "с острыми бивнями, трудно сдерживаемый;",
 "dhp324:3": "Связанный, корм не ест,",
 "dhp324:4": "вспоминает слон слоновью рощу.",
 "dhp325:0": "История о Пасенади из Косалы",
 "dhp325:1": "Сонливый когда бывает и много-едящий,",
 "dhp325:2": "Спящий, переворачивающийся-лежащий;",
 "dhp325:3": "Как большой-кабан откормленный-на-выгоне,",
 "dhp325:4": "Снова и снова в чрево приходит глупец.",
 "dhp326:0": "История с Саму и Саманерой",
 "dhp326:1": "Этот прежде ум-состояние бродило странствием,",
 "dhp326:2": "Куда-хочется, где-желается, как-приятно;",
 "dhp326:3": "То сегодня я сдержу первопричинно,",
 "dhp326:4": "Как слона-взбешённого — держащий-крюк.",
 "dhp327:0": "История с павеййякским слоном",
 "dhp327:1": "В не-беспечности-радующимися будьте,",
 "dhp327:2": "свой ум-состояние охраняйте;",
 "dhp327:3": "Из-трудного вытаскивайте себя,",
 "dhp327:4": "как из-грязи — слон.",
 "dhp328:0": "История о многих монахах",
 "dhp328:1": "Если обретёшь проницательного товарища,",
 "dhp328:2": "Вместе идущего, хорошо-пребывающего-стойкого;",
 "dhp328:3": "Одолев все опасности,",
 "dhp328:4": "С ним иди, довольный, памятующий.",
 "dhp329:1": "Если же не обретёшь проницательного товарища,",
 "dhp329:2": "Вместе идущего, хорошо-пребывающего-стойкого;",
 "dhp329:3": "Как царь, завоёванную страну оставив,",
 "dhp329:4": "Один иди, как слон матанга в лесу.",
 "dhp330:1": "Одному хождение лучше,",
 "dhp330:2": "Нет с незрелым товарищества;",
 "dhp330:3": "Один иди и плохого не делай,",
 "dhp330:4": "Не-озабоченный, как матанга-слон в-лесу.",
 "dhp331:0": "История Мары",
 "dhp331:1": "При благе возникшем приятны друзья,",
 "dhp331:2": "Удовлетворённость приятна, какая-бы-ни-была;",
 "dhp331:3": "Благо приятно при жизни-исчерпании,",
 "dhp331:4": "Всей боли приятно покидание.",
 "dhp332:1": "Приятна материнская-забота в мире,",
 "dhp332:2": "а после отцовская-забота приятна;",
 "dhp332:3": "Приятна отшельническая-жизнь в мире,",
 "dhp332:4": "а после брахманская-жизнь приятна.",
 "dhp333:1": "Приятна до старости нравственность,",
 "dhp333:2": "приятна вера, утверждённая;",
 "dhp333:3": "Приятно понимания обретение,",
 "dhp333:4": "злого неделание приятно.",
 "dhp333:5": "Глава Слон двадцать третья."
}
