{
 "dhp167:0.1": "Малого Собрания",
 "dhp167:0.2": "Дхаммапада",
 "dhp167:0.3": "Глава Мир",
 "dhp167:0.4": "История молодого монаха",
 "dhp167:1": "Низкое явление пусть не практикует,",
 "dhp167:2": "с беспечностью пусть не пребывает;",
 "dhp167:3": "Ошибочный взгляд пусть не практикует,",
 "dhp167:4": "пусть не будет мир-умножающим.",
 "dhp168:0": "История Суддходаны",
 "dhp168:1": "Пусть встаёт, не беспечным будет,",
 "dhp168:2": "явление хорошо-поведённое пусть ведёт;",
 "dhp168:3": "Дхамма-ведущий приятно спит,",
 "dhp168:4": "в этом мире и в следующем.",
 "dhp169:1": "Явление пусть ведёт хорошо-поведённое,",
 "dhp169:2": "не его плохо-поведённое пусть ведёт;",
 "dhp169:3": "Дхамма-ведущий приятно спит,",
 "dhp169:4": "в этом мире и в следующем.",
 "dhp170:0": "История пятисот монахов-видящих",
 "dhp170:1": "Как пузырь пусть видит,",
 "dhp170:2": "как пусть видит мираж;",
 "dhp170:3": "Так мир рассматривающего,",
 "dhp170:4": "царь смерти не видит.",
 "dhp171:0": "История царевича Абхайи",
 "dhp171:1": "Идите, смотрите этот мир,",
 "dhp171:2": "ум — царской колеснице подобный;",
 "dhp171:3": "Где глупцы утопают,",
 "dhp171:4": "нет обмотки у знающих.",
 "dhp172:0": "История старца-подметальщика",
 "dhp172:1": "Кто же прежде, побеспечив,",
 "dhp172:2": "потом он не расслабляется;",
 "dhp172:3": "Этот мир освещает,",
 "dhp172:4": "из-за облака освобождённая как луна.",
 "dhp173:0": "История о тхере Ангулимале",
 "dhp173:1": "Которого плохая сделанная активность,",
 "dhp173:2": "благотворным закрывается;",
 "dhp173:3": "Этот мир освещает,",
 "dhp173:4": "из-за облака освобождённая как луна.",
 "dhp174:0": "История о дочери ткача",
 "dhp174:1": "Слеп этот свет,",
 "dhp174:2": "мало кто здесь видит;",
 "dhp174:3": "Как птица из сети вырвавшись,",
 "dhp174:4": "немногие идут к раю.",
 "dhp175:0": "История о тридцати монахах",
 "dhp175:1": "Лебеди идут путём солнца,",
 "dhp175:2": "в пространстве идут силой;",
 "dhp175:3": "Уводятся мудрые из света,",
 "dhp175:4": "победив Мару с его свитой.",
 "dhp176:0": "История о Чинчаманавике",
 "dhp176:1": "У того, кто одно явление преступил,",
 "dhp176:2": "у ложно-утверждающего существа;",
 "dhp176:3": "У того, кто перешёл за этот свет,",
 "dhp176:4": "нет плохого, что не было бы сделано.",
 "dhp177:0": "История о несравненном даянии",
 "dhp177:1": "Ведь скупые в мир дэвов не идут,",
 "dhp177:2": "Глупцы, конечно, не восхваляют даяние;",
 "dhp177:3": "Мудрый же, даяние одобряя,",
 "dhp177:4": "Тем самым он становится счастливым в ином мире.",
 "dhp178:0": "История о сыне Анатхапиндики Кале",
 "dhp178:1": "Единым царством на земле,",
 "dhp178:2": "или уходом в рай;",
 "dhp178:3": "Всем-миром-владычеством,",
 "dhp178:4": "плод обретения слуха — превосходный.",
 "dhp178:5": "Глава Мир Тринадцатая."
