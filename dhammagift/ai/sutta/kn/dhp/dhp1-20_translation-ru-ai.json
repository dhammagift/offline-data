{
 "dhp1:0.1": "Малого Собрания",
 "dhp1:0.2": "Дхаммапада",
 "dhp1:0.3": "Раздел Ямака",
 "dhp1:0.4": "История Чаккхупала Тхеры",
 "dhp1:1": "Ум-представление-предшествующие явления,",
 "dhp1:2": "ум-представление-главные, ум-представление-сотворённые;",
 "dhp1:3": "Если с умом-представлением испорченным",
 "dhp1:4": "говорит или делает;",
 "dhp1:5": "То его боль сопровождает,",
 "dhp1:6": "как колесо — везущего след.",
 "dhp2:0": "История Маттхакундали",
 "dhp2:1": "Ум-представление-предшествующие явления,",
 "dhp2:2": "ум-представление-главные, ум-представление-сотворённые;",
 "dhp2:3": "Если умом ясным,",
 "dhp2:4": "говорит или делает;",
 "dhp2:5": "То его приятное сопровождает,",
 "dhp2:6": "как тень неотступная.",
 "dhp3:0": "История Тисса Тхеры",
 "dhp3:1": "Оскорбил меня, ударил меня,",
 "dhp3:2": "одолел меня, отнял у меня;",
 "dhp3:3": "А которые это затаивают,",
 "dhp3:4": "вражда у тех не успокаивается.",
 "dhp4:1": "Оскорбил меня, ударил меня,",
 "dhp4:2": "одолел меня, отнял у меня;",
 "dhp4:3": "А которые это не затаивают,",
 "dhp4:4": "вражда у тех успокаивается.",
 "dhp5:0": "История Калияккхини",
 "dhp5:1": "Ведь не враждой вражда,",
 "dhp5:2": "успокаивается здесь когда-либо;",
 "dhp5:3": "Без-враждой же успокаивается,",
 "dhp5:4": "это действительность вечная.",
 "dhp6:0": "История Косамбака",
 "dhp6:1": "Другие же не понимают,",
 "dhp6:2": "мы здесь сдерживаемся;",
 "dhp6:3": "А которые там понимают,",
 "dhp6:4": "от того успокаиваются распри.",
 "dhp7:0": "История Махакала Тхеры",
 "dhp7:1": "На-ладность-созерцающим пребывающим,",
 "dhp7:2": "в способностях несдержанный;",
 "dhp7:3": "В еде же без-умеренности,",
 "dhp7:4": "ленивого, слабой-решимости;",
 "dhp7:5": "Того поистине одолевает Мара,",
 "dhp7:6": "как ветер — дерево слабое.",
 "dhp8:1": "Без-прикрас-созерцающим пребывающим,",
 "dhp8:2": "в индриях хорошо-сдержанным;",
 "dhp8:3": "В еде же с умеренностью,",
 "dhp8:4": "Веру, начавшую-решимость;",
 "dhp8:5": "Того ведь не одолевает Мара,",
 "dhp8:6": "Ветер скалу как гору.",
 "dhp9:0": "История Девадатты",
 "dhp9:1": "С неотброшенной-грязью охряную-одежду,",
 "dhp9:2": "кто одеяние наденет;",
 "dhp9:3": "Лишённый самообладания-и-правдивости,",
 "dhp9:4": "не тот охряной-одежды достоин.",
 "dhp10:1": "А кто с отброшенной-грязью,",
 "dhp10:2": "в нравственности хорошо-сосредоточенный;",
 "dhp10:3": "Наделённый самообладанием-и-правдивостью,",
 "dhp10:4": "тот воистину охряной-одежды достоин.",
 "dhp11:0": "История уважаемого Сарипутты",
 "dhp11:1": "В не-сути суть-считающие,",
 "dhp11:2": "в сути же не-суть-видящие;",
 "dhp11:3": "Те сути не достигают,",
 "dhp11:4": "неправильное-намерение-привычка-поприще.",
 "dhp12:1": "Суть же как суть познав,",
 "dhp12:2": "не-суть же как не-суть;",
 "dhp12:3": "Те суть достигают,",
 "dhp12:4": "правильное-намерение-привычка-поприще.",
 "dhp13:0": "История уважаемого Нанды",
 "dhp13:1": "Как дом плохо-покрытый,",
 "dhp13:2": "дождь пронизывает;",
 "dhp13:3": "Так неразвитое ум-состояние,",
 "dhp13:4": "страсть пронизывает.",
 "dhp14:1": "Как дом с хорошей крышей,",
 "dhp14:2": "дождь не проникает;",
 "dhp14:3": "Так хорошо развитое ум-состояние,",
 "dhp14:4": "страсть не проникает.",
 "dhp15:0": "Чундасукарикаваттху",
 "dhp15:1": "Здесь страдает, после смерти страдает,",
 "dhp15:2": "Плохое делающий в обоих местах страдает;",
 "dhp15:3": "Он страдает, он мучается,",
 "dhp15:4": "Увидев активность-загрязнённость свою.",
 "dhp16:0": "Дхаммикаупасакаваттху",
 "dhp16:1": "Здесь радуется, после смерти радуется,",
 "dhp16:2": "Сделавший благо в обоих местах радуется;",
 "dhp16:3": "Он радуется, он ликует,",
 "dhp16:4": "Увидев активность-чистоту свою.",
 "dhp17:0": "История Девадатты",
 "dhp17:1": "Здесь мучается, после смерти мучается,",
 "dhp17:2": "Плохое делающий в обоих местах мучается;",
 "dhp17:3": "«Плохое мной сделано» — мучается,",
 "dhp17:4": "Сильнее мучается, в плохое состояние уйдя.",
 "dhp18:0": "Суманадевиваттху",
 "dhp18:1": "Здесь наслаждается, после смерти наслаждается,",
 "dhp18:2": "Сделавший благо в обоих местах наслаждается;",
 "dhp18:3": "«Благо мной сделано» — наслаждается,",
 "dhp18:4": "Сильнее наслаждается, в хорошее состояние уйдя.",
 "dhp19:0": "История о двух монахах-товарищах",
 "dhp19:1": "Даже если много священного текста произносящий,",
 "dhp19:2": "Не делающий этого — человек беспечный;",
 "dhp19:3": "Как пастух коров считающий чужих,",
 "dhp19:4": "Не причастен он к отшельничеству.",
 "dhp20:1": "Даже если мало священного текста произносящий,",
 "dhp20:2": "Дхаммы следующий согласно дхамме;",
 "dhp20:3": "Страсть и вредность и замутненность оставив,",
 "dhp20:4": "Правильно понимающий, хорошо освобождённый умом;",
 "dhp20:5": "Не поддерживая ни здесь, ни в ином мире,",
 "dhp20:6": "Он причастен к отшельничеству.",
 "dhp20:7": "Глава Ямака Первая."
}
