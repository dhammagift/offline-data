{
 "dhp90:0.1": "Малого Собрания",
 "dhp90:0.2": "Дхаммапада",
 "dhp90:0.3": "Арахант-Глава",
 "dhp90:0.4": "Дживака-вопрос-История",
 "dhp90:1": "Прошедшего-путь, без-страдания,",
 "dhp90:2": "полностью-освобождённого отовсюду;",
 "dhp90:3": "Все-узлы-отбросившего,",
 "dhp90:4": "жжение не существует.",
 "dhp91:0": "История уважаемого Махакассапы",
 "dhp91:1": "Устремляются памятующие,",
 "dhp91:2": "не в жилище радуются те;",
 "dhp91:3": "Как лебеди, пруд покинув,",
 "dhp91:4": "жилище за жилищем покидают те.",
 "dhp92:0": "Белаттхасиса-Тхера-История",
 "dhp92:1": "У которых накопления нет,",
 "dhp92:2": "которые всесторонне-понятую-пищу [едят];",
 "dhp92:3": "Пустотное, без-знаковое и,",
 "dhp92:4": "освобождение у которых область;",
 "dhp92:5": "Как в небе птиц,",
 "dhp92:6": "путь тех трудно-проследим.",
 "dhp93:0": "Ануруддха-Тхера-История",
 "dhp93:1": "У которого истечения истощены,",
 "dhp93:2": "в питании и независим;",
 "dhp93:3": "Пустотное, без-знаковое и,",
 "dhp93:4": "освобождение у которого область;",
 "dhp93:5": "Как в небе птиц,",
 "dhp93:6": "след того трудно-проследим.",
 "dhp94:0": "Махакаччаяна-Тхера-История",
 "dhp94:1": "У которого способности в равновесие-приведены,",
 "dhp94:2": "Как кони, укрощённые возницей,",
 "dhp94:3": "У того, кто отбросил самомнение, без истечений,",
 "dhp94:4": "Даже дэвы тому завидуют — таковому.",
 "dhp95:0": "История уважаемого Сарипутты",
 "dhp95:1": "Подобный земле — не враждует,",
 "dhp95:2": "Подобный столпу Индры — таков, добродетелен;",
 "dhp95:3": "Как озеро, лишённое грязи,",
 "dhp95:4": "Круговороты не случаются для такового.",
 "dhp96:0": "История послушника достопочтенного Тиссы из Косамби",
 "dhp96:1": "Успокоен его ум-состояние,",
 "dhp96:2": "успокоены речь и активность;",
 "dhp96:3": "Правильно-пониманием-высвобождённого,",
 "dhp96:4": "успокоенного, такого.",
 "dhp97:0": "История уважаемого Сарипутты",
 "dhp97:1": "Без веры и неблагодарный,",
 "dhp97:2": "и разрывающий связи — кто человек;",
 "dhp97:3": "Уничтоживший возможность, извергший надежду,",
 "dhp97:4": "он есть высший человек.",
 "dhp98:0": "История достопочтенного Реваты из Акациевой рощи",
 "dhp98:1": "В деревне или в лесу,",
 "dhp98:2": "в низине или на возвышенности;",
 "dhp98:3": "где араханты располагаются,",
 "dhp98:4": "То — красота земли.",
 "dhp99:0": "История одной женщины",
 "dhp99:1": "Приятны леса,",
 "dhp99:2": "где не радуется народ;",
 "dhp99:3": "Лишённые страсти возрадуются,",
 "dhp99:4": "не те, кто ищет желания.",
 "dhp99:5": "Глава Арахантов Седьмая."
