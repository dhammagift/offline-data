{
 "dhp306:0.1": "Малого Собрания",
 "dhp306:0.2": "Дхаммапада",
 "dhp306:0.3": "Глава Ада",
 "dhp306:0.4": "История странствующей аскетки Сундари",
 "dhp306:1": "Говорящий неправду попадает в ад,",
 "dhp306:2": "Или тот, кто сделав, говорит «я не делал»;",
 "dhp306:3": "Оба они после смерти становятся равны,",
 "dhp306:4": "Низкие активностью люди в следующем мире.",
 "dhp307:0": "История страдающих от плодов дурного поведения",
 "dhp307:1": "Многие с охристыми шеями,",
 "dhp307:2": "плохие явления — необузданные;",
 "dhp307:3": "Плохие плохими активностями,",
 "dhp307:4": "в ад они попадают.",
 "dhp308:0": "История монахов с берегов Ваггумуды",
 "dhp308:1": "Лучше раскалённый железный шар съесть,",
 "dhp308:2": "раскалённый, подобный пламени огня;",
 "dhp308:3": "Чем если бы ел безнравственный,",
 "dhp308:4": "несознаваемый подаяние страны.",
 "dhp309:0": "История сына богача Кхемаки",
 "dhp309:1": "Четыре положения мужчина беспечный,",
 "dhp309:2": "Достигает, посещающий чужих жён;",
 "dhp309:3": "Обретение не-блага, нежеланный сон,",
 "dhp309:4": "Порицание третье, ад четвёртый.",
 "dhp310:1": "Обретение не-блага и плохая участь,",
 "dhp310:2": "У испуганного с испуганной радость коротка;",
 "dhp310:3": "И царь налагает тяжёлое наказание,",
 "dhp310:4": "Поэтому мужчина чужую жену не посещает.",
 "dhp311:0": "История непослушного монаха",
 "dhp311:1": "Как трава куса, плохо схваченная,",
 "dhp311:2": "руку только режет;",
 "dhp311:3": "Шраманство, плохо взятое,",
 "dhp311:4": "к аду-ведущее тянет.",
 "dhp312:1": "Любая вялая активность,",
 "dhp312:2": "и запятнанный обет;",
 "dhp312:3": "Сомнительная святая жизнь,",
 "dhp312:4": "то не является велико-плодным.",
 "dhp313:1": "Если делаешь — делай это,",
 "dhp313:2": "крепко это, устремившись;",
 "dhp313:3": "Вялый ведь отшельник,",
 "dhp313:4": "ещё больше набирает пыли.",
 "dhp314:0": "История женщин, движимых завистью",
 "dhp314:1": "Несделанное плохое лучше,",
 "dhp314:2": "потом мучает плохо-сделанное;",
 "dhp314:3": "А сделанное хорошее лучше,",
 "dhp314:4": "что сделав, не раскаиваешься.",
 "dhp315:0": "История о многих монахах",
 "dhp315:1": "Крепость как отдаленная,",
 "dhp315:2": "охраняемая изнутри-снаружи;",
 "dhp315:3": "Так охраняйте себя,",
 "dhp315:4": "момент вас пусть не минует;",
 "dhp315:5": "Момент-превзошедшие ведь страдают,",
 "dhp315:6": "в аду оказавшись.",
 "dhp316:0": "История нигантхов",
 "dhp316:1": "Не-стыдящиеся стыдятся,",
 "dhp316:2": "стыдящиеся не стыдятся;",
 "dhp316:3": "Ошибочный-взгляд приняв,",
 "dhp316:4": "существа идут в плохую-участь.",
 "dhp317:1": "В без-тревоге тревогу-видящие,",
 "dhp317:2": "в тревоге и без-тревогу-видящие;",
 "dhp317:3": "Ошибочный-взгляд приняв,",
 "dhp317:4": "существа идут в плохую-участь.",
 "dhp318:0": "История последователей других учений",
 "dhp318:1": "В без-порочном порочное-считающие,",
 "dhp318:2": "в порочном и без-порочное-видящие;",
 "dhp318:3": "Ошибочный-взгляд приняв,",
 "dhp318:4": "существа идут в плохую-участь.",
 "dhp319:1": "И порочное как порочное узнав,",
 "dhp319:2": "и без-порочное как без-порочное;",
 "dhp319:3": "Правильный взгляд приняв,",
 "dhp319:4": "существа идут в благую участь.",
 "dhp319:5": "Раздел Ада двадцать второй."
}
