{
 "dhp100:0.1": "Малого Собрания",
 "dhp100:0.2": "Дхаммапада",
 "dhp100:0.3": "Глава Тысяча",
 "dhp100:0.4": "Тамбадатхика-убийца-воров история",
 "dhp100:1": "Тысяча даже если речи,",
 "dhp100:2": "бесцельно-слова-собранные;",
 "dhp100:3": "Одно благо-слово лучше,",
 "dhp100:4": "которое услышав успокаивается.",
 "dhp101:0": "Бахия-Даручирия-тхера история",
 "dhp101:1": "Тысяча даже если строфы,",
 "dhp101:2": "бесцельно-слова-собранные;",
 "dhp101:3": "Одна строфа-слово лучше,",
 "dhp101:4": "которое услышав успокаивается.",
 "dhp102:0": "Кундалакеси-тхери история",
