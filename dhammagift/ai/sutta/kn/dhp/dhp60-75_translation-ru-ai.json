{
 "dhp60:0.1": "Малого Собрания",
 "dhp60:0.2": "Дхаммапада",
 "dhp60:0.3": "Глава незрелых",
 "dhp60:0.4": "История одного человека",
 "dhp60:1": "Длинна бодрствующему ночь,",
 "dhp60:2": "длинна уставшему йоджана;",
 "dhp60:3": "Длинна незрелым сансара,",
 "dhp60:4": "истинное явление не понимающим.",
 "dhp61:0": "История проживающих вместе с Махакассапой",
 "dhp61:1": "Если идя не достигает",
 "dhp61:2": "Лучшего или равного себе;",
 "dhp61:3": "Одиночное странствие крепко пусть совершит,",
 "dhp61:4": "Нет у незрелого товарищества.",
 "dhp62:0": "История Анандасеттхи",
 "dhp62:1": "Сыновья у меня, богатство у меня,",
 "dhp62:2": "так незрелый мучается;",
 "dhp62:3": "Ведь себя у себя нет,",
 "dhp62:4": "откуда сыновья, откуда богатство.",
 "dhp63:0": "История вора, разрывающего узлы",
 "dhp63:1": "Который незрелый считает незрелость,",
 "dhp63:2": "мудрецом же и тот;",
 "dhp63:3": "Незрелый же с гордостью мудреца,",
 "dhp63:4": "он ведь “незрелым” зовётся.",
 "dhp64:0": "История старца Удайи",
 "dhp64:1": "Даже если всю жизнь незрелый",
 "dhp64:2": "мудреца обслуживает;",
 "dhp64:3": "Не то явление распознаёт,",
 "dhp64:4": "как половник вкус похлёбки.",
 "dhp65:0": "История тридцати монахов из Павеи",
 "dhp65:1": "Мгновение если даже знающий,",
 "dhp65:2": "мудреца обслуживает;",
 "dhp65:3": "Быстро явление распознаёт,",
 "dhp65:4": "как язык вкус похлёбки.",
 "dhp66:0": "История прокажённого Суппабуддхи",
 "dhp66:1": "Бродят незрелые глупые,",
 "dhp66:2": "как с врагом, с собой;",
 "dhp66:3": "Совершая плохую активность,",
 "dhp66:4": "которая бывает с горьким плодом.",
 "dhp67:0": "История земледельца",
 "dhp67:1": "Не та активность сделана хорошо,",
 "dhp67:2": "которую сделав, сожалеют;",
 "dhp67:3": "Чей со слезами на лице, плача,",
 "dhp67:4": "результат переживает.",
 "dhp68:0": "История цветочника Суманы",
 "dhp68:1": "И та активность сделана хорошо,",
 "dhp68:2": "которую сделав, не сожалеют;",
 "dhp68:3": "Чей довольный, радостный умом,",
 "dhp68:4": "результат переживает.",
 "dhp69:0": "История тхери Уппалаванны",
 "dhp69:1": "Как мёд обдумывает незрелый,",
 "dhp69:2": "пока плохое не созреет;",
 "dhp69:3": "А когда созреет плохое,",
 "dhp69:4": "тогда к боли идёт.",
 "dhp70:0": "История тхеры Джамбуки",
 "dhp70:1": "Месяц за месяцем травинкой,",
 "dhp70:2": "незрелый бы питался едой;",
 "dhp70:3": "Не тот у распознавших явления",
 "dhp70:4": "части не стоит шестнадцатой.",
 "dhp71:0": "История змееподобного духа",
 "dhp71:1": "Ведь плохая сделанная активность,",
 "dhp71:2": "как свежее молоко не отпускается;",
 "dhp71:3": "Жгущего незрелого следует,",
 "dhp71:4": "как пеплом покрытый огонь.",
 "dhp72:0": "История духа с шестьюдесятью крюками",
 "dhp72:1": "Сколько-нибудь ради бесцельного,",
 "dhp72:2": "известность незрелого возрастает;",
 "dhp72:3": "Убивает незрелого его светлая часть,",
 "dhp72:4": "голову ему разбивая.",
 "dhp73:0": "История Читты Гхапати",
 "dhp73:1": "Не-существующее развитие желал бы,",
 "dhp73:2": "предпочтение среди монахов;",
 "dhp73:3": "и в жилищах власть,",
 "dhp73:4": "почитание в чужих семьях.",
 "dhp74:1": "Только мной сделанное пусть считают,",
 "dhp74:2": "домохозяева и ушедшие оба;",
 "dhp74:3": "Только мне подвластны пусть будут,",
 "dhp74:4": "в делах и бездельях в чём-либо;",
 "dhp74:5": "Так незрелого устремление,",
 "dhp74:6": "желание и самомнение возрастают.",
 "dhp75:0": "История послушника Тиссы из Леса",
 "dhp75:1": "Иное ведь для обретения основа,",
 "dhp75:2": "иное — к ниббане ведущая;",
 "dhp75:3": "Так это опознав,",
 "dhp75:4": "монах Будды последователь;",
 "dhp75:5": "Почитание не должен радоваться,",
 "dhp75:6": "уединение пусть взращивает.",
 "dhp75:7": "Глава Бала Пятая."
}
