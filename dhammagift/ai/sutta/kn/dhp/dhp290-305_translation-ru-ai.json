{
 "dhp290:0.1": "Малого Собрания",
 "dhp290:0.2": "Дхаммапада",
 "dhp290:0.3": "Раздел Разное",
 "dhp290:0.4": "История о собственной прошлой деятельности",
 "dhp290:1": "Если от малого-приятного отказавшись,",
 "dhp290:2": "видит он большое приятное;",
 "dhp290:3": "Пусть от малого-приятного откажется знаток,",
 "dhp290:4": "видящий большое приятное.",
 "dhp291:0": "История о поедательнице куриных яиц",
 "dhp291:1": "Чужим-боль-причиняя,",
 "dhp291:2": "своё приятное желает;",
 "dhp291:3": "С враждебностью-смешением-смешанный,",
 "dhp291:4": "от враждебности он не высвобождается.",
 "dhp292:0": "История о монахах Бхаддийи",
 "dhp292:1": "Что должно быть сделано — отброшено,",
 "dhp292:2": "а недолжное делается;",
 "dhp292:3": "У надменных, беспечных,",
 "dhp292:4": "у тех возрастают истечения.",
 "dhp293:1": "А у тех, кто хорошо-предпринял,",
 "dhp293:2": "постоянно телесное памятование;",
 "dhp293:3": "Недолжного те не придерживаются,",
 "dhp293:4": "в должном постоянные-делатели;",
 "dhp293:5": "У памятующих, сознательных,",
 "dhp293:6": "к прекращению приходят истечения.",
 "dhp294:0": "История о Лакундака Бхаддии",
 "dhp294:1": "Мать и отца убив,",
 "dhp294:2": "царей и двух кшатриев;",
 "dhp294:3": "Царство с окружением уничтожив,",
 "dhp294:4": "без-тяготы уходит брахман.",
 "dhp295:1": "Мать и отца убив,",
 "dhp295:2": "царей и двух брахманов;",
 "dhp295:3": "Тигро-пятого уничтожив,",
 "dhp295:4": "без-тяготы уходит брахман.",
 "dhp296:0": "История сына возчика дров",
 "dhp296:1": "Хорошо-пробуждённого пробуждаются,",
 "dhp296:2": "всегда готамы последователи;",
 "dhp296:3": "Тех, у кого днём и ночью,",
 "dhp296:4": "постоянно к-будде-направленное памятование.",
 "dhp297:1": "Хорошо-пробуждённого пробуждаются,",
 "dhp297:2": "всегда готамы последователи;",
 "dhp297:3": "Тех, у кого днём и ночью,",
 "dhp297:4": "постоянно к-дхамме-направленное памятование.",
 "dhp298:1": "Хорошо-пробуждённого пробуждаются,",
 "dhp298:2": "всегда готамы последователи;",
 "dhp298:3": "Тех, у кого днём и ночью,",
 "dhp298:4": "постоянно к-сангхе-направленное памятование.",
 "dhp299:1": "Хорошо-пробуждённого пробуждаются,",
 "dhp299:2": "всегда готамы последователи;",
 "dhp299:3": "Тех, у кого днём и ночью,",
 "dhp299:4": "постоянно телесное памятование.",
 "dhp300:1": "Хорошо-пробуждённого пробуждаются,",
 "dhp300:2": "всегда готамы последователи;",
 "dhp300:3": "Тех, у кого днём и ночью,",
 "dhp300:4": "к-ненасилию рад ум-представление.",
 "dhp301:1": "Хорошо-пробуждённого пробуждаются,",
 "dhp301:2": "всегда готамы последователи;",
 "dhp301:3": "Тех, у кого днём и ночью,",
 "dhp301:4": "к-развитию рад ум-представление.",
 "dhp302:0": "История монаха-сына Ваджиев",
 "dhp302:1": "Трудноуход в бездомность, труднонаслаждение,",
 "dhp302:2": "Труднообитаемы дома, болезненны;",
 "dhp302:3": "Болезненно с-неравными-совместное-проживание,",
 "dhp302:4": "Болью-преследуем странник;",
 "dhp302:5": "Потому не странником пусть будет,",
 "dhp302:6": "И не болью-преследуемым пусть будет.",
 "dhp303:0": "История Читты Гхапати",
 "dhp303:1": "Верующий, нравственностью наделённый,",
 "dhp303:2": "славой-богатством-наделённый;",
 "dhp303:3": "Какую какую местность посещает,",
 "dhp303:4": "там там же почитаем.",
 "dhp304:0": "История о Чуласубхадде",
 "dhp304:1": "Далеко чистые заявляют о себе,",
 "dhp304:2": "как Гималайская гора;",
 "dhp304:3": "Нечистые здесь не видны,",
 "dhp304:4": "ночью брошенные как стрелы.",
 "dhp305:0": "История о достопочтенном, живущем в одиночестве",
 "dhp305:1": "Одно сидение, одна постель,",
 "dhp305:2": "один идёт неутомлённый;",
 "dhp305:3": "Один, укрощая себя,",
 "dhp305:4": "в лесу пусть радуется.",
 "dhp305:5": "Раздел Разное двадцать первый."
