{
 "dhp209:0.1": "Малого Собрания",
 "dhp209:0.2": "Дхаммапада",
 "dhp209:0.3": "Глава Любимого",
 "dhp209:0.4": "История ушедшего в бездомность с двумя ярмами",
 "dhp209:1": "В не-связи себя связывая,",
 "dhp209:2": "а в связи не связывая;",
 "dhp209:3": "Благо оставив, любимое хватающий,",
 "dhp209:4": "завидует само-связи-следующему.",
 "dhp210:1": "С любимыми не соединяйся,",
 "dhp210:2": "с нелюбимыми никогда;",
 "dhp210:3": "Любимых невидение болезненно,",
 "dhp210:4": "и нелюбимых видение.",
 "dhp211:1": "Поэтому любимое не делай,",
 "dhp211:2": "любимого уход ведь плох;",
 "dhp211:3": "Узлы у тех не находятся,",
 "dhp211:4": "у кого нет любимого-нелюбимого.",
 "dhp212:0": "История некоего домохозяина",
 "dhp212:1": "Из любимого рождается страдание,",
 "dhp212:2": "из любимого рождается тревога;",
 "dhp212:3": "У любимого освободившегося,",
 "dhp212:4": "нет страдания, откуда тревога.",
 "dhp213:0": "Висакха-ваттху",
 "dhp213:1": "Из любви рождается страдание,",
 "dhp213:2": "из любви рождается тревога;",
 "dhp213:3": "У любви освободившегося,",
 "dhp213:4": "нет страдания, откуда тревога.",
 "dhp214:0": "История Личчхави",
 "dhp214:1": "Из радости рождается страдание,",
 "dhp214:2": "от радости рождается тревога;",
 "dhp214:3": "От радости освободившегося,",
 "dhp214:4": "нет страдания, откуда тревога.",
 "dhp215:0": "История о не-женщине-запахе-мальчике",
 "dhp215:1": "От желания рождается страдание,",
 "dhp215:2": "от желания рождается тревога;",
 "dhp215:3": "От желания освободившегося,",
 "dhp215:4": "нет страдания, откуда тревога.",
 "dhp216:0": "История некоего брахмана",
 "dhp216:1": "От цепляния рождается страдание,",
 "dhp216:2": "от цепляния рождается тревога;",
 "dhp216:3": "От цепляния освободившегося,",
 "dhp216:4": "нет страдания, откуда тревога.",
 "dhp217:0": "История о пятистах мальчиках",
 "dhp217:1": "Нравственностью и видением наделённого,",
 "dhp217:2": "в явлениях стоящего, правду ведающего;",
 "dhp217:3": "Свою деятельность делающего,",
 "dhp217:4": "того человек делает приятным.",
 "dhp218:0": "История о старце-невозвращающемся",
 "dhp218:1": "Импульсом-рождённый к не-объявленному,",
 "dhp218:2": "Умом-представлением и наполнен пусть будет;",
 "dhp218:3": "И к желаниям не-привязанным-умом-состоянием,",
 "dhp218:4": "Вверх-потоком называется.",
 "dhp219:0": "История Нандии",
 "dhp219:1": "Долго-отсутствовавшего человека,",
 "dhp219:2": "издалека благополучно пришедшего;",
 "dhp219:3": "Родственники-друзья и добрые товарищи,",
 "dhp219:4": "радуются пришедшему.",
 "dhp220:1": "Также и сделавшего благо,",
 "dhp220:2": "из этого мира в другой ушедшего;",
 "dhp220:3": "Благие [дела] принимают,",
 "dhp220:4": "родные — пришедшего дорогого.",
 "dhp220:5": "Раздел Дорогого шестнадцатая."
}
