{
 "dhp157:0.1": "Малого Собрания",
 "dhp157:0.2": "Дхаммапада",
 "dhp157:0.3": "Глава о себе",
 "dhp157:0.4": "История царевича Бодхи",
 "dhp157:1": "Если себя как любимого должен знать,",
 "dhp157:2": "должен охранять его хорошо-охраняемым;",
 "dhp157:3": "Из трёх одну стражу,",
 "dhp157:4": "должен заботиться мудрец.",
 "dhp158:0": "История монаха Упананды Сакьяпутты",
 "dhp158:1": "Себя самого сначала",
 "dhp158:2": "в подобающем должен утвердить;",
 "dhp158:3": "Затем другого должен наставлять,",
 "dhp158:4": "не должен пачкаться мудрец.",
 "dhp159:0": "История монаха Падханикатиссы",
 "dhp159:1": "Если себя так должен делать,",
 "dhp159:2": "как другого наставляет;",
 "dhp159:3": "Хорошо-прирученный, действительно, должен приручать,",
 "dhp159:4": "себя ведь, говорят, трудно приручить.",
 "dhp160:0": "История матери монаха Кумаракассапы",
 "dhp160:1": "Себя ведь самому — господин,",
 "dhp160:2": "кто же господином другим может быть?",
 "dhp160:3": "Собой ведь хорошо-прирученным",
 "dhp160:4": "господина обретает трудно обретаемого.",
 "dhp161:0": "История мирянина Махакалы",
 "dhp161:1": "Собой ведь сделанное плохое,",
 "dhp161:2": "саморождённое, само-возникшее;",
 "dhp161:3": "Сокрушает глупого,",
 "dhp161:4": "Как алмаз — каменный самоцвет.",
 "dhp162:0": "История Девадатты",
 "dhp162:1": "У кого крайняя безнравственность,",
 "dhp162:2": "Как малува, опутавшая дерево сал;",
 "dhp162:3": "Делает он так самого себя,",
 "dhp162:4": "Как того хочет враг.",
 "dhp163:0": "История о попытке раскола Сангхи",
 "dhp163:1": "Легки нехорошие дела,",
 "dhp163:2": "и себе во вред;",
 "dhp163:3": "Что же благо и хорошо,",
 "dhp163:4": "то воистину крайне трудно.",
 "dhp164:0": "История о старце Кале",
 "dhp164:1": "Кто учение арахантов,",
 "dhp164:2": "благородных, живущих Дхаммой;",
 "dhp164:3": "Отвергает глупый,",
 "dhp164:4": "на взгляд полагаясь плохой;",
 "dhp164:5": "Как плоды тростника,",
 "dhp164:6": "к собственной гибели созревает.",
 "dhp165:0": "История о мирянине Чулакале",
 "dhp165:1": "Собой ведь сделанное плохое,",
 "dhp165:2": "собой загрязняется;",
 "dhp165:3": "Собой не сделанное плохое,",
 "dhp165:4": "собой же очищается;",
 "dhp165:5": "Чистота и нечистота — в себе самом,",
 "dhp165:6": "не один другого очистит.",
 "dhp166:0": "История старшего о благе-себя",
 "dhp166:1": "Благо-себя чужим-благом,",
 "dhp166:2": "даже многим не умаляй;",
 "dhp166:3": "Благо-себя опознав,",
 "dhp166:4": "своего-блага-устремленным пусть будет.",
 "dhp166:5": "Глава Атта Двенадцатая."
}
