{
 "dhp21:0.1": "Малого Собрания",
 "dhp21:0.2": "Дхаммапада",
 "dhp21:0.3": "Раздел Аппамада",
 "dhp21:0.4": "История Самавати",
 "dhp21:1": "Не-беспечность — шаг к бессмертному,",
 "dhp21:2": "беспечность — шаг к смерти;",
 "dhp21:3": "Не-беспечные не умирают,",
 "dhp21:4": "те же, кто беспечны, — как мёртвые.",
 "dhp22:1": "Так, различая,",
 "dhp22:2": "мудрецы в не-беспечности;",
 "dhp22:3": "В не-беспечности радуются,",
 "dhp22:4": "в области благородных наслаждаясь.",
 "dhp23:1": "Те зажжённые, постоянные,",
 "dhp23:2": "всегда с твёрдым усердием;",
 "dhp23:3": "Коснутся мудрые ниббаны,",
 "dhp23:4": "от-связи-защиту непревзойденную.",
 "dhp24:0": "История купца Кумбхагхосаки",
 "dhp24:1": "У поднявшегося, памятующего,",
 "dhp24:2": "Чисто-активного, осмотрительно-делающего;",
 "dhp24:3": "Сдержанного, по Дхамме живущего,",
 "dhp24:4": "не-беспечного слава возрастает.",
 "dhp25:0": "История Чулапантхаки",
 "dhp25:1": "Поднятием, не-беспечностью,",
 "dhp25:2": "сдержанностью и обузданием;",
 "dhp25:3": "Остров пусть сделает мудрый,",
 "dhp25:4": "который наводнение не заливает.",
 "dhp26:0": "История, потрясённая созвездием Баланаккхатты",
 "dhp26:1": "Беспечности предаются,",
 "dhp26:2": "Глупые, неразумные люди;",
 "dhp26:3": "Не-беспечность же мудрый,",
 "dhp26:4": "Как лучшее сокровище, защищает.",
 "dhp27:1": "Не беспечности предавайтесь,",
 "dhp27:2": "не желание-радости-связи;",
 "dhp27:3": "Не-беспечный ведь зажжённый,",
 "dhp27:4": "достигает обильного приятного.",
 "dhp28:0": "История уважаемого Махакассапы",
 "dhp28:1": "Беспечность не-беспечностью,",
 "dhp28:2": "когда отбрасывает мудрец;",
 "dhp28:3": "Понимания-террасу взойдя,",
 "dhp28:4": "без-страдающий страдающее поколение;",
 "dhp28:5": "Как на горе стоящий на земле стоящих,",
 "dhp28:6": "знаток глупцов наблюдает.",
 "dhp29:0": "История беспечного и не-беспечного монахов-товарищей",
 "dhp29:1": "Не-беспечный среди беспечных,",
 "dhp29:2": "среди спящих много-бодрствующий;",
 "dhp29:3": "Как слабосильного быстрого коня,",
 "dhp29:4": "оставив, уходит мудрый.",
 "dhp30:0": "История Магхавана",
 "dhp30:1": "Не-беспечностью Магхаван,",
 "dhp30:2": "среди дэвов высшего положения достиг;",
 "dhp30:3": "Не-беспечность одобряют,",
 "dhp30:4": "беспечность порицаема всегда.",
 "dhp31:0": "История некоего монаха",
 "dhp31:1": "В не-беспечности радующийся монах,",
 "dhp31:2": "в беспечности тревогу-видящий.",
 "dhp31:3": "Связывание тонкое грубое,",
 "dhp31:4": "сжигая, как огонь, идёт.",
 "dhp32:0": "История уважаемого Тиссы из города",
 "dhp32:1": "В не-беспечности радующийся монах,",
 "dhp32:2": "в беспечности тревогу-видящий.",
 "dhp32:3": "Неспособен к упадку,",
 "dhp32:4": "ниббаны же вблизи.",
 "dhp32:5": "Глава Аппамада Вторая."
}
