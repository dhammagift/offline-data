{
 "thag2.29:0.1": "Стихи старших монахов 2.29",
 "thag2.29:0.2": "Двойное собрание",
 "thag2.29:0.3": "Раздел Третий",
 "thag2.29:0.4": "Стихи старшего монаха Бхарадваджи",
 "thag2.29:1.1": "“Ревут так мудрые,",
 "thag2.29:1.2": "как львы в горной пещере;",
 "thag2.29:1.3": "Герои, победившие в битвах,",
 "thag2.29:1.4": "победив Мару с его свитой.",
 "thag2.29:2.1": "Учитель мной почтён,",
 "thag2.29:2.2": "Дхамма и Сангха почитаемы;",
 "thag2.29:2.3": "А я доволен и радостен,",
 "thag2.29:2.4": "увидев сына без истечений”.",
 "thag2.29:2.5": "… Старший монах Бхарадваджа …."
}
