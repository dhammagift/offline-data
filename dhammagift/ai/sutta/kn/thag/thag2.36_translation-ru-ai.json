{
 "thag2.36:0.1": "Стихи старших монахов 2.36",
 "thag2.36:0.2": "Двойное собрание",
 "thag2.36:0.3": "Раздел Четвёртый",
 "thag2.36:0.4": "Стихи старшего монахи Нитаки",
 "thag2.36:1.1": "«У кого ум-состояние подобно скале,",
 "thag2.36:1.2": "устойчивое, не колеблется;",
 "thag2.36:1.3": "Бесстрастное к очаровывающим-вызывающим страсть,",
 "thag2.36:1.4": "в возмущаемом не возмущается;",
 "thag2.36:1.5": "У кого так развито ум-состояние,",
 "thag2.36:1.6": "откуда того боль достигнет?",
 "thag2.36:2.1": "У меня ум-состояние подобно скале,",
 "thag2.36:2.2": "устойчивое, не колеблется;",
 "thag2.36:2.3": "Бесстрастное к очаровывающим-вызывающим страсть,",
 "thag2.36:2.4": "в возмущаемом не возмущается;",
 "thag2.36:2.5": "У меня так развитое ум-состояние,",
 "thag2.36:2.6": "откуда меня боль достигнет?»",
 "thag2.36:2.7": "… Старший монах Нитака …."
}
