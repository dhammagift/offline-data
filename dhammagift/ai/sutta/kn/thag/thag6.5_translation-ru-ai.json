{
 "thag6.5:0.1": "Стихи старших монахов 6.5",
 "thag6.5:0.2": "Глава шестых",
 "thag6.5:0.3": "Глава первая",
 "thag6.5:0.4": "Стихи старшего монаха Малукьяпутты",
 "thag6.5:1.1": "“У беспечно-живущего человека,",
 "thag6.5:1.2": "Цепляние возрастает, словно малува;",
 "thag6.5:1.3": "Он мечется туда-сюда,",
 "thag6.5:1.4": "Как обезьяна в лесу, ищущая плод.",
 "thag6.5:2.1": "Кого эта низкая одолевает,",
 "thag6.5:2.2": "Цепляние, липкость в мире;",
 "thag6.5:2.3": "Страдания его возрастают,",
 "thag6.5:2.4": "Словно бирана под дождём.",
 "thag6.5:3.1": "Кто же это низкое одолевает,",
 "thag6.5:3.2": "Цепляние, трудно преодолимое в мире;",
 "thag6.5:3.3": "Страдания от него отпадают,",
 "thag6.5:3.4": "как капля воды с лотоса.",
 "thag6.5:4.1": "То вам говорю, благо вам,",
 "thag6.5:4.2": "Сколько вас здесь собралось;",
 "thag6.5:4.3": "Корень цепляния выкопайте,",
 "thag6.5:4.4": "Как бирану, ищущему корень усиры;",
 "thag6.5:4.5": "Пусть вас, как тростник в потоке,",
 "thag6.5:4.6": "Мара не ломает снова и снова.",
 "thag6.5:5.1": "Делайте слово Пробуждённого,",
 "thag6.5:5.2": "момент вас пусть не минует;",
 "thag6.5:5.3": "Момент-превзошедшие ведь страдают,",
 "thag6.5:5.4": "в аду оказавшись.",
 "thag6.5:6.1": "Беспечность — пыль, беспечность — пыль,",
 "thag6.5:6.2": "беспечностью-преследуемая пыль;",
 "thag6.5:6.3": "Не-беспечностью, знанием",
 "thag6.5:6.4": "вытащи стрелу свою”.",
 "thag6.5:6.5": "… Старший монах Малукьяпутта …."
}
