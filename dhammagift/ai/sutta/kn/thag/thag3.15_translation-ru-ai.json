{
 "thag3.15:0.1": "Стихи старших монахов 3.15",
 "thag3.15:0.2": "Тройной раздел",
 "thag3.15:0.3": "Глава первая",
 "thag3.15:0.4": "Стихи старшего монаха Хариты",
 "thag3.15:1.1": "“Который впереди делаемое,",
 "thag3.15:1.2": "потом тот сделать хочет;",
 "thag3.15:1.3": "Приятное тот покидает места,",
 "thag3.15:1.4": "и потом сожалеет.",
 "thag3.15:2.1": "Что сделал бы, то и говори,",
 "thag3.15:2.2": "что не сделал, того не говори;",
 "thag3.15:2.3": "Не делающего, говорящего,",
 "thag3.15:2.4": "распознают мудрецы.",
 "thag3.15:3.1": "Очень-приятна, право, ниббана,",
 "thag3.15:3.2": "Правильно-пробуждённым изложенное;",
 "thag3.15:3.3": "Без-страданий, без-пыльное, защищённое,",
 "thag3.15:3.4": "где боль устраняется”.",
 "thag3.15:3.5": "… Старший монах Харита …."
}
