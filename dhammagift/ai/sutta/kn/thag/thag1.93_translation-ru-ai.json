{
 "thag1.93:0.1": "Стихи старших монахов 1.93",
 "thag1.93:0.2": "Раздел из одного",
 "thag1.93:0.3": "Десятая глава",
 "thag1.93:0.4": "Стихи старшего монаха Эраки",
 "thag1.93:1.1": "“Болезненны желания, Эрака,",
 "thag1.93:1.2": "Не приятны желания, Эрака;",
 "thag1.93:1.3": "Кто желания желает,",
 "thag1.93:1.4": "Боли тот желает, Эрака;",
 "thag1.93:1.5": "Кто желания не желает,",
 "thag1.93:1.6": "Боли тот не желает, Эрака”.",
 "thag1.93:1.7": "… Старший монах Эрака …."
}
