{
 "thag15.2:0.1": "Стихи старших монахов 15.2",
 "thag15.2:0.2": "Раздел шестнадцати",
 "thag15.2:0.3": "Глава первая",
 "thag15.2:0.4": "Стихи старшего монаха Удайи",
 "thag15.2:1.1": "“Человеком-ставшего пробуждённого,",
 "thag15.2:1.2": "Себя-укрощённого собранного;",
 "thag15.2:1.3": "Движущегося на Брахмо-пути,",
 "thag15.2:1.4": "В ума-успокоении радующегося.",
 "thag15.2:2.1": "Кого люди почитают,",
 "thag15.2:2.2": "всех явлений достигшего-другого-берега;",
 "thag15.2:2.3": "Даже божества его почитают,",
 "thag15.2:2.4": "так мной от араханта услышано.",
 "thag15.2:3.1": "Все связанности превзошедшего,",
 "thag15.2:3.2": "из леса в без-лесье пришедшего;",
 "thag15.2:3.3": "В желаниях в отречении радующегося,",
 "thag15.2:3.4": "освобождённого как скала от золота.",
 "thag15.2:4.1": "Он же превосходно-сияющий нага,",
 "thag15.2:4.2": "гимавату подобный среди прочих скал;",
 "thag15.2:4.3": "Из всех слонов-имён,",
 "thag15.2:4.4": "истинно-именной непревзойдённый.",
 "thag15.2:5.1": "Слона вам расскажу,",
 "thag15.2:5.2": "ведь зла не совершает он;",
 "thag15.2:5.3": "Кротость и без-вредность,",
 "thag15.2:5.4": "ноги слона те две.",
 "thag15.2:6.1": "Памятование и сознательность,",
 "thag15.2:6.2": "поведение наги те трое;",
 "thag15.2:6.3": "Вера-рука великий слон,",
 "thag15.2:6.4": "равностное-видение-его-бивни.",
 "thag15.2:7.1": "Памятование шея голова понимание,",
 "thag15.2:7.2": "исследование обдумывание-явлений;",
 "thag15.2:7.3": "Дхамма-чревом-вместе-пребывание,",
 "thag15.2:7.4": "уединение его хвост.",
 "thag15.2:8.1": "Он джхана-практикующий выдох-радующийся,",
 "thag15.2:8.2": "внутри хорошо-объединённый;",
 "thag15.2:8.3": "Идущий собранный слон,",
 "thag15.2:8.4": "стоящий слон собранный.",
 "thag15.2:9.1": "Сам собранный нага,",
 "thag15.2:9.2": "сидящий также собранный;",
 "thag15.2:9.3": "Везде сдержанный слон,",
 "thag15.2:9.4": "это слона исполненность.",
 "thag15.2:10.1": "Вкушает безупречное,",
 "thag15.2:10.2": "упречное не вкушает;",
 "thag15.2:10.3": "Пропитание-одеяние получив,",
 "thag15.2:10.4": "накопление избегая.",
 "thag15.2:11.1": "Связывание тонкое грубое,",
 "thag15.2:11.2": "всё разрезав привязывание;",
 "thag15.2:11.3": "Куда бы ни шёл,",
 "thag15.2:11.4": "не-привязанным идёт.",
 "thag15.2:12.1": "Как в воде рождённый,",
 "thag15.2:12.2": "лотос разрастается;",
 "thag15.2:12.3": "Не пачкается водой,",
 "thag15.2:12.4": "чистым запахом уму-восхитительный.",
 "thag15.2:13.1": "Так же и в мире рождённый,",
 "thag15.2:13.2": "пробуждённый в мире пребывает;",
 "thag15.2:13.3": "Не пачкается миром,",
 "thag15.2:13.4": "водой лотос как.",
 "thag15.2:14.1": "Большой огонь зажжённый,",
 "thag15.2:14.2": "без-питания угасает;",
 "thag15.2:14.3": "В углях же успокоенных,",
 "thag15.2:14.4": "угасшим называется.",
 "thag15.2:15.1": "Смысла-блага-цели это разъяснение,",
 "thag15.2:15.2": "подобие знающими указано;",
 "thag15.2:15.3": "Поймут великие наги,",
 "thag15.2:15.4": "слона-нагу слоном-нагой указанное.",
 "thag15.2:16.1": "Без страсти, без неприязни,",
 "thag15.2:16.2": "Без заблуждения, без истечений;",
 "thag15.2:16.3": "Тело оставляя, слон-нага,",
 "thag15.2:16.4": "Полностью-угаснет без-истечений”.",
 "thag15.2:16.5": "… старший монах Удайи …",
 "thag15.2:16.6": "Раздел шестнадцати установлен.",
 "thag15.2:17.0": "Там сводка",
 "thag15.2:17.1": "Конданья и Удайи,",
 "thag15.2:17.2": "старших двое тех велико-сильных;",
 "thag15.2:17.3": "В шестнадцатом разделе,",
 "thag15.2:17.4": "стихов две и тридцать."
}
