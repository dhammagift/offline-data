{
 "thag2.4:0.1": "Стихи старших монахов 2.4",
 "thag2.4:0.2": "Двойное собрание",
 "thag2.4:0.3": "Глава первая",
 "thag2.4:0.4": "Стихи старшего монаха Гангатирия",
 "thag2.4:1.1": "“Из трёх пальмовых листьев",
 "thag2.4:1.2": "на берегу Ганги хижина сделана;",
 "thag2.4:1.3": "Из тряпья моя чаша,",
 "thag2.4:1.4": "и из отбросов одеяние.",
 "thag2.4:2.1": "За два промежуточных года",
 "thag2.4:2.2": "одно слово мной было сказано;",
 "thag2.4:2.3": "На третьем промежуточном году",
 "thag2.4:2.4": "тьмы глыба расколота”.",
 "thag2.4:2.5": "… Старший монах Гангатирия …."
}
