{
 "thag5.11:0.1": "Стихи старших монахов 5.11",
 "thag5.11:0.2": "Пятое собрание",
 "thag5.11:0.3": "Глава первая",
 "thag5.11:0.4": "Стихи старшего монаха Сонакутикана",
 "thag5.11:1.1": "«Посвящение и мной получено,",
 "thag5.11:1.2": "освобождён я и без истечений;",
 "thag5.11:1.3": "И тот мной Благословенный увиден,",
 "thag5.11:1.4": "в обители и вместе жил.",
 "thag5.11:2.1": "Много именно ночи Благословенный,",
 "thag5.11:2.2": "под открытым небом провёл;",
 "thag5.11:2.3": "В обитель-вихару искусный Учитель,",
 "thag5.11:2.4": "в обитель-вихару вошёл тогда.",
 "thag5.11:3.1": "Расстелив верхнее одеяние,",
 "thag5.11:3.2": "ложе устроил Готама;",
 "thag5.11:3.3": "Лев в скальной пещере словно,",
 "thag5.11:3.4": "отбросивший тревогу-страх.",
 "thag5.11:4.1": "Оттуда благо-речивый,",
 "thag5.11:4.2": "правильно-пробуждённого последователь;",
 "thag5.11:4.3": "Сона произнёс благую Дхамму,",
 "thag5.11:4.4": "перед лучшим из пробуждённых.",
 "thag5.11:5.1": "Пять блоков полным пониманием,",
 "thag5.11:5.2": "Развив прямой путь;",
 "thag5.11:5.3": "Достигнув высшего успокоения,",
 "thag5.11:5.4": "Полностью-угаснет без-истечений”.",
 "thag5.11:5.5": "… Сона Кутикана старший монах …."
}
