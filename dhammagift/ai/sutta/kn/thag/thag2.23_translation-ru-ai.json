{
 "thag2.23:0.1": "Стихи старших монахов 2.23",
 "thag2.23:0.2": "Двойное собрание",
 "thag2.23:0.3": "Раздел Третий",
 "thag2.23:0.4": "Стихи старшего монаха Собхиты",
 "thag2.23:1.1": "“Памятливый, понимающий монах,",
 "thag2.23:1.2": "с решимостью-силой-усилием;",
 "thag2.23:1.3": "Пятьсот капп я,",
 "thag2.23:1.4": "одну ночь вспомнил.",
 "thag2.23:2.1": "Четыре постановления памятования,",
 "thag2.23:2.2": "семь и восемь развивая;",
 "thag2.23:2.3": "Пятьсот капп я,",
 "thag2.23:2.4": "одну ночь вспомнил”.",
 "thag2.23:2.5": "… Старший монах Собхита …."
}
