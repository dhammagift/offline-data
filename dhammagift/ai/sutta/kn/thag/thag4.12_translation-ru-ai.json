{
 "thag4.12:0.1": "Тхерагатха 4.12",
 "thag4.12:0.2": "Четыре строфы",
 "thag4.12:0.3": "Глава первая",
 "thag4.12:0.4": "Мудитаттхерагатха",
 "thag4.12:1.1": "«Ушёл я ради средств к жизни,",
 "thag4.12:1.2": "получив полное посвящение;",
 "thag4.12:1.3": "Затем веру обрёл я,",
 "thag4.12:1.4": "с крепкой решимостью устремился.",
 "thag4.12:2.1": "Пусть даже это тело развалится,",
 "thag4.12:2.2": "куски мяса распадутся;",
 "thag4.12:2.3": "Оба коленных сустава,",
 "thag4.12:2.4": "голени пусть отпадут у меня.",
 "thag4.12:3.1": "Не буду есть, не буду пить,",
 "thag4.12:3.2": "и из пребывания не выйду;",
 "thag4.12:3.3": "И на боковую не лягу,",
 "thag4.12:3.4": "с цепляния-дротиком не удалённым.",
 "thag4.12:4.1": "Того меня так пребывающего,",
 "thag4.12:4.2": "Узри решительно-упорствующего;",
 "thag4.12:4.3": "Три знания достигнуты,",
 "thag4.12:4.4": "исполнено Будды указание”.",
 "thag4.12:4.5": "… Старший Мудита …",
 "thag4.12:4.6": "Четверная группа установлена.",
 "thag4.12:5.0": "Там сводка",
 "thag4.12:5.1": "Нагасамала и Бхагу,",
 "thag4.12:5.2": "Сабхия и также Нандака;",
 "thag4.12:5.3": "Джамбука, старший Сенака,",
 "thag4.12:5.4": "Самбхута и также Рахула.",
 "thag4.12:6.1": "Есть старший Чандана,",
 "thag4.12:6.2": "эти десять — слушатели Пробуждённого;",
 "thag4.12:6.3": "Дхаммика, старший Саппака,",
 "thag4.12:6.4": "и Мудита — те трое;",
 "thag4.12:6.5": "Строф пятьдесят две,",
 "thag4.12:6.6": "старших всех тринадцать»."
}
