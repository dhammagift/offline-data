{
 "thag3.13:0.1": "Стихи старших монахов 3.13",
 "thag3.13:0.2": "Тройной раздел",
 "thag3.13:0.3": "Глава первая",
 "thag3.13:0.4": "Стихи старшего монаха Абхибхуты",
 "thag3.13:1.1": "“Услышьте, родные, все,",
 "thag3.13:1.2": "Сколько вас здесь собралось;",
 "thag3.13:1.3": "Явление вам объясню,",
 "thag3.13:1.4": "болезненно рождение снова и снова.",
 "thag3.13:2.1": "Начинайте, выходите,",
 "thag3.13:2.2": "Соединяйтесь в учении Будды;",
 "thag3.13:2.3": "Стряхните армию Смерти,",
 "thag3.13:2.4": "Как тростниковый дом — слон.",
 "thag3.13:3.1": "Кто в этой Дхамма-винае,",
 "thag3.13:3.2": "Старательным пребудет;",
 "thag3.13:3.3": "Отбросив рождение-круговорот,",
 "thag3.13:3.4": "боли край совершит”.",
 "thag3.13:3.5": "… Старший монах Абхибхута …."
}
