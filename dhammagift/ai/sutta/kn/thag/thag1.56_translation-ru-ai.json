{
 "thag1.56:0.1": "Стихи старших монахов 1.56",
 "thag1.56:0.2": "Раздел из одного",
 "thag1.56:0.3": "Шестая глава",
 "thag1.56:0.4": "Стихи старшего монаха Кутивихари",
 "thag1.56:1.1": "“Кто в хижине, монах, в хижине,",
 "thag1.56:1.2": "Без страсти, с хорошо установленным умом-состоянием;",
 "thag1.56:1.3": "Так знай, товарищ,",
 "thag1.56:1.4": "Не напрасно тобой хижина сделана”.",
 "thag1.56:1.5": "… Старший монах Кутивихари …."
}
