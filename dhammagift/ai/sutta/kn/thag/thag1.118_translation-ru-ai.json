{
 "thag1.118:0.1": "Стихи старших монахов 1.118",
 "thag1.118:0.2": "Раздел из одного",
 "thag1.118:0.3": "Двенадцатый раздел",
 "thag1.118:0.4": "Стихи старшего монаха Кимилы",
 "thag1.118:1.1": "“Как проклятый падает,",
 "thag1.118:1.2": "Жизнь — материя иная, как есть присутствующая;",
 "thag1.118:1.3": "Этого памятующего, не-отлучающегося,",
 "thag1.118:1.4": "Иным вспоминаю себя”.",
 "thag1.118:1.5": "… Старший монах Кимила …."
}
