{
 "thag16.9:0.1": "Стихи старших монахов 16.9",
 "thag16.9:0.2": "Двадцати-глава",
 "thag16.9:0.3": "Глава первая",
 "thag16.9:0.4": "Стихи старшего монаха Ануруддхи",
 "thag16.9:1.1": "“Оставив мать и отца,",
 "thag16.9:1.2": "сестру, родственников-братьев;",
 "thag16.9:1.3": "Пять желаний-множителей оставив,",
 "thag16.9:1.4": "Ануруддха зажёгся.",
 "thag16.9:2.1": "Собравшись с танцами-пением,",
 "thag16.9:2.2": "с хлопками пробуждённый;",
 "thag16.9:2.3": "Тем чистоты не достиг,",
 "thag16.9:2.4": "в Мары области радуясь.",
 "thag16.9:3.1": "И это превзойдя,",
 "thag16.9:3.2": "радуясь Будды указанию;",
 "thag16.9:3.3": "Всё затопление превзойдя,",
 "thag16.9:3.4": "Ануруддха зажёгся.",
 "thag16.9:4.1": "Образы, звуки, вкусы, запахи,",
 "thag16.9:4.2": "и касания приятные уму;",
 "thag16.9:4.3": "И эти превзойдя,",
 "thag16.9:4.4": "Ануруддха зажёгся.",
 "thag16.9:5.1": "Сбор-подаяния превзойдя,",
 "thag16.9:5.2": "один без-второго мудрец;",
 "thag16.9:5.3": "Ищет тряпичные-одежды,",
 "thag16.9:5.4": "Ануруддха без истечений.",
 "thag16.9:6.1": "Подобрал, взял, выстирал,",
 "thag16.9:6.2": "окрасил, надел мудрец;",
 "thag16.9:6.3": "Тряпичные-одежды разумный,",
 "thag16.9:6.4": "Ануруддха без истечений.",
 "thag16.9:7.1": "Большого-желания и недовольный,",
 "thag16.9:7.2": "общительный и который возбуждённый;",
 "thag16.9:7.3": "Того явления эти бывают,",
 "thag16.9:7.4": "плохие загрязняющие.",
 "thag16.9:8.1": "Памятующий же бывает мало-желающий,",
 "thag16.9:8.2": "довольный без-огорчения;",
 "thag16.9:8.3": "В уединении-радости радостный,",
 "thag16.9:8.4": "всегда с решимостью-усилием.",
 "thag16.9:9.1": "Того явления эти бывают,",
 "thag16.9:9.2": "благотворные стороны пробуждения;",
 "thag16.9:9.3": "Без истечений и он есть,",
 "thag16.9:9.4": "так сказано великим провидцем.",
 "thag16.9:10.1": "Мой замысел узнав,",
 "thag16.9:10.2": "Учитель, непревзойдённый в мире,",
 "thag16.9:10.3": "Умом-представлением созданным телом,",
 "thag16.9:10.4": "сверхспособностью приблизился».",
 "thag16.9:11.1": "Когда у меня было намерение,",
 "thag16.9:11.2": "от того высшее указал;",
 "thag16.9:11.3": "В не-размножении радующийся Будда,",
 "thag16.9:11.4": "без-разрастания научил.",
 "thag16.9:12.1": "Того я явление поняв,",
 "thag16.9:12.2": "пребывал в указании радующийся;",
 "thag16.9:12.3": "Три знания достигнуты,",
 "thag16.9:12.4": "исполнено Будды указание.",
 "thag16.9:13.1": "Пятьдесят пять лет,",
 "thag16.9:13.2": "с тех пор как я сидящий;",
 "thag16.9:13.3": "Двадцать пять лет,",
 "thag16.9:13.4": "с тех пор как вялость устранена.",
 "thag16.9:14.1": "Не было выдохов-вдохов,",
 "thag16.9:14.2": "устойчивого ума-состояния у такого;",
 "thag16.9:14.3": "Недвижимый, покой обретя,",
 "thag16.9:14.4": "зрячий достиг окончательной ниббаны.",
 "thag16.9:15.1": "Несжатым умом-состоянием",
 "thag16.9:15.2": "чувствование перенёс;",
 "thag16.9:15.3": "Как угасание светильника,",
 "thag16.9:15.4": "освобождение ума-состояния было.",
 "thag16.9:16.1": "Эти последние теперь,",
 "thag16.9:16.2": "у мудреца с касанием пятым;",
 "thag16.9:16.3": "Не иные явления будут,",
 "thag16.9:16.4": "у полностью пробуждённого угасшего.",
 "thag16.9:17.1": "Нет отныне повторного проживания,",
 "thag16.9:17.2": "в дэва-теле, Джалини;",
 "thag16.9:17.3": "Исчерпан рождение-круговорот,",
 "thag16.9:17.4": "нет отныне нового [индивидуального] существования.",
 "thag16.9:18.1": "Кто за мгновение тысячекратно,",
 "thag16.9:18.2": "Свет познан с миром Брахмы;",
 "thag16.9:18.3": "Владеющий сиддхи-качествами в смерти-рождении,",
 "thag16.9:18.4": "Вовремя видит дэвов — тот монах.",
 "thag16.9:19.1": "Носильщиком еды был прежде,",
 "thag16.9:19.2": "бедным, добывающим пищу;",
 "thag16.9:19.3": "Шрамана я направил,",
 "thag16.9:19.4": "выше славного.",
 "thag16.9:20.1": "Я в роду Сакьев рождён,",
 "thag16.9:20.2": "Ануруддхой меня знают;",
 "thag16.9:20.3": "Наделённый танцами-пением,",
 "thag16.9:20.4": "с хлопками пробуждённый.",
 "thag16.9:21.1": "Тогда увидел я Пробуждённого,",
 "thag16.9:21.2": "Учителя, откуда нет страха;",
 "thag16.9:21.3": "В нём ум-состояние прояснив,",
 "thag16.9:21.4": "покинул [дом] в бездомность.",
 "thag16.9:22.1": "Прошлые-жизни знаю,",
 "thag16.9:22.2": "где мной прожито прежде;",
 "thag16.9:22.3": "Среди дэвов Тридцати Трёх,",
 "thag16.9:22.4": "стоял я в рождении Сакьев.",
 "thag16.9:23.1": "Семь раз человековладыкой,",
 "thag16.9:23.2": "я царствование вершил;",
 "thag16.9:23.3": "Четырёх-концов победителем,",
 "thag16.9:23.4": "рощи джамбу владыка;",
 "thag16.9:23.5": "Без палки, без меча,",
 "thag16.9:23.6": "по Дхамме наставлял.",
 "thag16.9:24.1": "Отсюда семь, оттуда семь,",
 "thag16.9:24.2": "кругов перерождений четырнадцать;",
 "thag16.9:24.3": "Прошлую жизнь познаю,",
 "thag16.9:24.4": "в мире дэвов стоя тогда.",
 "thag16.9:25.1": "В пятичастном самадхи,",
 "thag16.9:25.2": "умиротворённом, едино-развитом;",
 "thag16.9:25.3": "Умиротворения достигнув,",
 "thag16.9:25.4": "божественный глаз очистился у меня.",
 "thag16.9:26.1": "Уход-приход знаю,",
 "thag16.9:26.2": "существ приход, уход;",
 "thag16.9:26.3": "такого-бытия-иного-бытия,",
 "thag16.9:26.4": "в джхане пятичастной стоя.",
 "thag16.9:27.1": "Обслужен мной Учитель,",
 "thag16.9:27.2": "…",
 "thag16.9:27.3": "…",
 "thag16.9:27.4": "с проводником к индивидуальному существованию покончено.",
 "thag16.9:28.1": "У Ваджджей в Бамбуковой деревне,",
 "thag16.9:28.2": "я, с жизнью-исчерпанием;",
 "thag16.9:28.3": "Снизу в бамбуковой роще,",
 "thag16.9:28.4": "угасну без истечений”.",
 "thag16.9:28.5": "… Старший монах Ануруддха …."
}
