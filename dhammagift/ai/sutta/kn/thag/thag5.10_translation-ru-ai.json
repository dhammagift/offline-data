{
 "thag5.10:0.1": "Стихи старших монахов 5.10",
 "thag5.10:0.2": "Пятое собрание",
 "thag5.10:0.3": "Глава первая",
 "thag5.10:0.4": "Стихи старшего монаха Ясадатты",
 "thag5.10:1.1": "«С умом-состоянием-к-порицанию глупый,",
 "thag5.10:1.2": "слушает Учение Победителя;",
 "thag5.10:1.3": "Далеко он от истинной Дхаммы,",
 "thag5.10:1.4": "от неба земля как.",
 "thag5.10:2.1": "С умом-состоянием-к-порицанию глупый,",
 "thag5.10:2.2": "слушает Учение Победителя;",
 "thag5.10:2.3": "Отпадает от благого Учения,",
 "thag5.10:2.4": "как в тёмной половине луна.",
 "thag5.10:3.1": "С умом-состоянием-к-порицанию глупый,",
 "thag5.10:3.2": "слушает Учение Победителя;",
 "thag5.10:3.3": "Высыхает в благом Учении,",
 "thag5.10:3.4": "рыба в безводье как.",
 "thag5.10:4.1": "С умом-состоянием-к-порицанию глупый,",
 "thag5.10:4.2": "слушает Учение Победителя;",
 "thag5.10:4.3": "Не вырастает в благом Учении,",
 "thag5.10:4.4": "в поле семя как гнилое.",
 "thag5.10:5.1": "А кто с довольным умом-состоянием,",
 "thag5.10:5.2": "слушает Учение Победителя;",
 "thag5.10:5.3": "Исчерпав истечения все,",
 "thag5.10:5.4": "реализовав непоколебимость;",
 "thag5.10:5.5": "Достигнув высшего успокоения,",
 "thag5.10:5.6": "полностью угасает без истечений».",
 "thag5.10:5.7": "… Старший монах Ясадатта …."
}
