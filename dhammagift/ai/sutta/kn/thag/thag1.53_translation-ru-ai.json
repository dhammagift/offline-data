{
 "thag1.53:0.1": "Стихи старших монахов 1.53",
 "thag1.53:0.2": "Раздел из одного",
 "thag1.53:0.3": "Шестая глава",
 "thag1.53:0.4": "Стихи старшего монаха Валлии",
 "thag1.53:1.1": "«Дождит божество, как хорошо спето,",
 "thag1.53:1.2": "Покрыта моя хижина, приятна, безветренна;",
 "thag1.53:1.3": "В ней пребываю старательным,",
 "thag1.53:1.4": "Так что если хочешь, лей дождь, дэва”.",
 "thag1.53:1.5": "… Старший монах Валлия …."
}
