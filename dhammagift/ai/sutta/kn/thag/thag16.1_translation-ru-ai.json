{
 "thag16.1:0.1": "Стихи старших монахов 16.1",
 "thag16.1:0.2": "Двадцати-глава",
 "thag16.1:0.3": "Глава первая",
 "thag16.1:0.4": "Стихи старшего монаха Адхимутты",
 "thag16.1:1.1": "«Ради жертвы или ради богатства,",
 "thag16.1:1.2": "кого убиваем мы прежде;",
 "thag16.1:1.3": "Остаток — тревога бывает,",
 "thag16.1:1.4": "дрожат и причитают.",
 "thag16.1:2.1": "У тебя же нет испуганности,",
 "thag16.1:2.2": "ещё больше цвет проясняется;",
 "thag16.1:2.3": "Почему не стенаешь,",
 "thag16.1:2.4": "в таком великом страхе?»",
 "thag16.1:3.1": "«Нет умственной боли,",
 "thag16.1:3.2": "у не-ожидающего, градоначальник;",
 "thag16.1:3.3": "Превзойдены тревоги все,",
 "thag16.1:3.4": "у исчерпавшего связанности ведь.",
 "thag16.1:4.1": "С исчерпанием существования-путеводности,",
 "thag16.1:4.2": "в видимой действительности как-оно-есть;",
 "thag16.1:4.3": "Не тревога в умирании бывает,",
 "thag16.1:4.4": "как при сбрасывании ноши.",
 "thag16.1:5.1": "Хорошо исполнена святая жизнь мной,",
 "thag16.1:5.2": "и путь хорошо развит;",
 "thag16.1:5.3": "В умирании мне тревоги нет,",
 "thag16.1:5.4": "как при исчерпании болезней.",
 "thag16.1:6.1": "Хорошо исполнена святая жизнь мной,",
 "thag16.1:6.2": "и путь хорошо развит;",
 "thag16.1:6.3": "Без-наслаждения вовлечённости увидены,",
 "thag16.1:6.4": "как выпитый яд, выброшенный.",
 "thag16.1:7.1": "Превзошедший, без-поддерживания,",
 "thag16.1:7.2": "сделавший-дело, без истечений;",
 "thag16.1:7.3": "Довольный при исчерпании жизни бывает,",
 "thag16.1:7.4": "освобождённый от узилища как.",
 "thag16.1:8.1": "Высшей фактичности достигший,",
 "thag16.1:8.2": "ко всему свету-миру бесцельный;",
 "thag16.1:8.3": "Как из воспламенённого дома освобождённый,",
 "thag16.1:8.4": "об умирании не страдает.",
 "thag16.1:9.1": "Что есть собранного что-либо,",
 "thag16.1:9.2": "вовлечённость или где обретается;",
 "thag16.1:9.3": "Всё не-самовластно это,",
 "thag16.1:9.4": "так сказано великим провидцем.",
 "thag16.1:10.1": "Кто это так понимает,",
 "thag16.1:10.2": "как Пробуждённым указано;",
 "thag16.1:10.3": "Не хватает вовлечённости что-либо,",
 "thag16.1:10.4": "раскалённый как железный шар.",
 "thag16.1:11.1": "Не у меня есть ‘был я’,",
 "thag16.1:11.2": "‘буду’ не есть у меня;",
 "thag16.1:11.3": "Отождествления исчезнут,",
 "thag16.1:11.4": "там какой плач.",
 "thag16.1:12.1": "Чистое явление-возникновение,",
 "thag16.1:12.2": "Чистую отождествлений-последовательность;",
 "thag16.1:12.3": "Видящему как-есть,",
 "thag16.1:12.4": "Не тревога бывает, градоначальник.",
 "thag16.1:13.1": "С трава-дровами-равным свет-мир,",
 "thag16.1:13.2": "когда пониманием видит;",
 "thag16.1:13.3": "Моё-присвоение он не-испытывая,",
 "thag16.1:13.4": "‘нет у меня’ так не страдает.",
 "thag16.1:14.1": "Тоскую по телу,",
 "thag16.1:14.2": "вовлеченностью я бесцелен;",
 "thag16.1:14.3": "Это тело разрушится,",
 "thag16.1:14.4": "и другого не будет.",
 "thag16.1:15.1": "Что вам нужно сделать с телом,",
 "thag16.1:15.2": "то делайте, как хотите;",
 "thag16.1:15.3": "Из-за этого у меня там",
 "thag16.1:15.4": "ни злобы, ни любви не будет”.",
 "thag16.1:16.1": "Ту его речь услышав,",
 "thag16.1:16.2": "поразительно, волосы дыбом;",
 "thag16.1:16.3": "Мечи отложив,",
 "thag16.1:16.4": "юноши это сказали.",
 "thag16.1:17.1": "“Что, достопочтенный, сделав,",
 "thag16.1:17.2": "или кто учитель твой;",
 "thag16.1:17.3": "Чьё учение приняв,",
 "thag16.1:17.4": "обретается то без-страдание”.",
 "thag16.1:18.1": "“Всезнающий всё-видящий,",
 "thag16.1:18.2": "победитель — учитель мой;",
 "thag16.1:18.3": "Велико-сострадательный Учитель,",
 "thag16.1:18.4": "всего мира целитель.",
 "thag16.1:19.1": "Им эта Дхамма изложена,",
 "thag16.1:19.2": "к исчерпанию ведущая непревзойдённая;",
 "thag16.1:19.3": "Его учение приняв,",
 "thag16.1:19.4": "обретается то без-страдание”.",
 "thag16.1:20.1": "Услышав разбойники провидца хорошо-сказанное,",
 "thag16.1:20.2": "Отложив мечи и оружие;",
 "thag16.1:20.3": "И от той деятельности отвратились некоторые,",
 "thag16.1:20.4": "И некоторые уход в бездомность восславили.",
 "thag16.1:21.1": "Уйдя в бездомность в Учении Благого,",
 "thag16.1:21.2": "Развив аспекты пробуждения и силы, мудрецы;",
 "thag16.1:21.3": "С возвышенным умом, довольные, с обузданными способностями,",
 "thag16.1:21.4": "Достигли они ниббаны-основы не-составленной.",
 "thag16.1:21.5": "… Старший монах Адхимутта …."
}
