{
 "thag7.3:0.1": "Стихи старших монахов 7.3",
 "thag7.3:0.2": "Семёрки",
 "thag7.3:0.3": "Глава первая",
 "thag7.3:0.4": "Стихи старшего монаха Бхадды",
 "thag7.3:1.1": "“Единственный сын я был,",
 "thag7.3:1.2": "мил матери, мил отцу;",
 "thag7.3:1.3": "Многими обетами-практиками,",
 "thag7.3:1.4": "получен просьбами и.",
 "thag7.3:2.1": "И те меня из сострадания,",
 "thag7.3:2.2": "благо-желающие, добро-ищущие;",
 "thag7.3:2.3": "Оба — отец и мать —",
 "thag7.3:2.4": "Будде поднесли.",
 "thag7.3:3.1": "‘С трудом получен этот сын,",
 "thag7.3:3.2": "нежный, в счастье взращённый;",
 "thag7.3:3.3": "Его даём тебе, защитник,",
 "thag7.3:3.4": "Победителя прислужником’.",
 "thag7.3:4.1": "Учитель же меня приняв,",
 "thag7.3:4.2": "Ананде это сказал;",
 "thag7.3:4.3": "‘Посвяти его быстро,",
 "thag7.3:4.4": "будет благородным он’.",
 "thag7.3:5.1": "Посвятив меня, Учитель,",
 "thag7.3:5.2": "в обитель-вихару вошёл Победитель;",
 "thag7.3:5.3": "Не зашедшем солнце,",
 "thag7.3:5.4": "оттого ум-состояние освободилось моё.",
 "thag7.3:6.1": "Оттого Учитель, отстранив,",
 "thag7.3:6.2": "из уединения поднявшись;",
 "thag7.3:6.3": "«Иди, Бхадда», — мне сказал,",
 "thag7.3:6.4": "это мне было полным посвящением.",
 "thag7.3:7.1": "Семи лет от рождения,",
 "thag7.3:7.2": "получено мной полное посвящение;",
 "thag7.3:7.3": "Три знания достигнуты,",
 "thag7.3:7.4": "ах, явлений-благая-явленность”.",
 "thag7.3:7.5": "… Бхадда Тхера …."
}
