{
 "thag5.4:0.1": "Стихи старших монахов 5.4",
 "thag5.4:0.2": "Пятое собрание",
 "thag5.4:0.3": "Глава первая",
 "thag5.4:0.4": "Стихи старшего монаха Суманы",
 "thag5.4:1.1": "“Которое, стремясь в явлениях,",
 "thag5.4:1.2": "наставник поддержал;",
 "thag5.4:1.3": "Бессмертное желающего,",
 "thag5.4:1.4": "сделано должное-быть-сделанным мной.",
 "thag5.4:2.1": "Достигнуто, засвидетельствовано,",
 "thag5.4:2.2": "самолично явление, без-сомнения;",
 "thag5.4:2.3": "Очищенный-пониманием, без-колебания,",
 "thag5.4:2.4": "провозглашаю в твоём присутствии.",
 "thag5.4:3.1": "Прошлые-жизни знаю,",
 "thag5.4:3.2": "божественное-око очищено;",
 "thag5.4:3.3": "Собственное благо мной достигнуто,",
 "thag5.4:3.4": "исполнено Будды указание.",
 "thag5.4:4.1": "У старательного меня тренировка,",
 "thag5.4:4.2": "хорошо-услышана твоим наставлением;",
 "thag5.4:4.3": "Все мои истечения истощены,",
 "thag5.4:4.4": "нет отныне нового [индивидуального] существования.",
 "thag5.4:5.1": "Наставлял меня благородным-поведением,",
 "thag5.4:5.2": "Сострадая, поддержал;",
 "thag5.4:5.3": "Не-пуст твой совет,",
 "thag5.4:5.4": "учеником я обучен”.",
 "thag5.4:5.5": "… Старший монах Сумана …."
}
