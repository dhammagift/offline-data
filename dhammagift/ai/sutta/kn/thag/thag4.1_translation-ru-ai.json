{
 "thag4.1:0.1": "Стихи старших монахов 4.1",
 "thag4.1:0.2": "Четыре строфы",
 "thag4.1:0.3": "Глава первая",
 "thag4.1:0.4": "Стихи старшего монаха Нагасамалы",
 "thag4.1:1.1": "“Украшенная, хорошо одетая,",
 "thag4.1:1.2": "с гирляндой, с сандалом натёртая;",
 "thag4.1:1.3": "Посреди большой дороги женщина,",
 "thag4.1:1.4": "под музыку танцует танцовщица.",
 "thag4.1:2.1": "За подаянием вошёл я,",
 "thag4.1:2.2": "идущий её увидел;",
 "thag4.1:2.3": "Украшенную, хорошо одетую,",
 "thag4.1:2.4": "словно сеть смерти расставленную.",
 "thag4.1:3.1": "Тогда у меня представление,",
 "thag4.1:3.2": "первопричинно возникло;",
 "thag4.1:3.3": "Недостаток-опасность проявился,",
 "thag4.1:3.4": "незаинтересованность утвердилась.",
 "thag4.1:4.1": "Тогда ум освободился у меня,",
 "thag4.1:4.2": "узри явлений благую-явленность;",
 "thag4.1:4.3": "Три знания достигнуты,",
 "thag4.1:4.4": "исполнено Будды указание”.",
 "thag4.1:4.5": "… Старший монах Нагасамала …."
}
