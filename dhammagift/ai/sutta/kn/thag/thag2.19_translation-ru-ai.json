{
 "thag2.19:0.1": "Стихи старших монахов 2.19",
 "thag2.19:0.2": "Двойное собрание",
 "thag2.19:0.3": "Вторая Глава",
 "thag2.19:0.4": "Стихи старшего монаха Нанды",
 "thag2.19:1.1": "“Непродуктивным представлением",
 "thag2.19:1.2": "украшательством занимался;",
 "thag2.19:1.3": "Взбудоражен, непостоянен я был,",
 "thag2.19:1.4": "желания-страстью мучим.",
 "thag2.19:2.1": "Искусным в средствах я,",
 "thag2.19:2.2": "Пробуждённым, солнца-родственником;",
 "thag2.19:2.3": "Первопричинно практикуя,",
 "thag2.19:2.4": "из существования ум извлёк”.",
 "thag2.19:2.5": "… Старший монах Нанда …."
}
