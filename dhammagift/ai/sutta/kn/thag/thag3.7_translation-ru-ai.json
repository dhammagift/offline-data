{
 "thag3.7:0.1": "Стихи старших монахов 3.7",
 "thag3.7:0.2": "Тройной раздел",
 "thag3.7:0.3": "Глава первая",
 "thag3.7:0.4": "Стихи старшего монаха Вараны",
 "thag3.7:1.1": "“Кто здесь среди людей",
 "thag3.7:1.2": "чужие жизни вредит;",
 "thag3.7:1.3": "Из этого мира и из следующего,",
 "thag3.7:1.4": "из обоих разрушается человек.",
 "thag3.7:2.1": "И кто дружным умом-состоянием",
 "thag3.7:2.2": "всех живых жалеет;",
 "thag3.7:2.3": "Много ведь он порождает,",
 "thag3.7:2.4": "заслуг такой человек.",
 "thag3.7:3.1": "Хорошо-сказанному пусть учится,",
 "thag3.7:3.2": "и шраман-почитанию;",
 "thag3.7:3.3": "И одинокому сидению в уединении,",
 "thag3.7:3.4": "и ума-выравниванию”.",
 "thag3.7:3.5": "… Старший монах Варана …."
}
