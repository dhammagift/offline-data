{
 "thag2.38:0.1": "Стихи старших монахов 2.38",
 "thag2.38:0.2": "Двойное собрание",
 "thag2.38:0.3": "Раздел Четвёртый",
 "thag2.38:0.4": "Стихи старшего монаха Нисабхи",
 "thag2.38:1.1": "“Пять множителей желаний оставив,",
 "thag2.38:1.2": "К мило-образному, умо-восхитительному;",
 "thag2.38:1.3": "С верой из дома выйдя,",
 "thag2.38:1.4": "Боли-конец-делающим пусть будет.",
 "thag2.38:2.1": "Не радуюсь умиранию,",
 "thag2.38:2.2": "не радуюсь жизни;",
 "thag2.38:2.3": "Время же ожидаю,",
 "thag2.38:2.4": "сознательный, памятующий”.",
 "thag2.38:2.5": "… Старший монах Нисабха …."
}
