{
 "thag2.39:0.1": "Стихи старших монахов 2.39",
 "thag2.39:0.2": "Двойное собрание",
 "thag2.39:0.3": "Раздел Четвёртый",
 "thag2.39:0.4": "Стихи старшего монаха Усабхи",
 "thag2.39:1.1": "“С манговым-ростком-сходный,",
 "thag2.39:1.2": "на плечо накинув чивару;",
 "thag2.39:1.3": "Сидя на слоновьей-шее,",
 "thag2.39:1.4": "в деревню за подаянием отправился.",
 "thag2.39:2.1": "Со слоновьего-хребта спустившись,",
 "thag2.39:2.2": "встревоженность обрёл тогда;",
 "thag2.39:2.3": "(Тот) я, возбуждённый тогда будучи,",
 "thag2.39:2.4": "достигнуто мной исчерпание истечений».",
 "thag2.39:2.5": "… Старший монах Усабха …."
}
