{
 "thag1.95:0.1": "Стихи старших монахов 1.95",
 "thag1.95:0.2": "Раздел из одного",
 "thag1.95:0.3": "Десятая глава",
 "thag1.95:0.4": "Стих старшего монаха Чаккхупалы",
 "thag1.95:1.1": "«Слепой я, с уничтоженным глазом,",
 "thag1.95:1.2": "в пустынную дорогу вступивший;",
 "thag1.95:1.3": "даже ползком я пойду,",
 "thag1.95:1.4": "не с товарищем порочным».",
 "thag1.95:1.5": "… Старший монах Чаккхупала …."
}
