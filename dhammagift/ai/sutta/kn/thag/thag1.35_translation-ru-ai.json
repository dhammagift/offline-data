{
 "thag1.35:0.1": "Стихи старших монахов 1.35",
 "thag1.35:0.2": "Раздел из одного",
 "thag1.35:0.3": "Раздел Четвёртый",
 "thag1.35:0.4": "Стих старшего монаха Саманньякани",
 "thag1.35:1.1": "“Приятное ищущий приятное обретает, так поступая,",
 "thag1.35:1.2": "И репутацию достигает, репутация возрастает;",
 "thag1.35:1.3": "Который Благородный Восьмичастный прямой путь,",
 "thag1.35:1.4": "Развивает путь — бессмертного достижения”.",
 "thag1.35:1.5": "… Старший монах Саманньякани …."
}
