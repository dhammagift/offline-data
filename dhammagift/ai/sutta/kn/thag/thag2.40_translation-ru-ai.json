{
 "thag2.40:0.1": "Стихи старших монахов 2.40",
 "thag2.40:0.2": "Двойное собрание",
 "thag2.40:0.3": "Раздел Четвёртый",
 "thag2.40:0.4": "Стихи старшего монаха Каппатакуры",
 "thag2.40:1.1": "«Этот — Каппата, Каппатакура,",
 "thag2.40:1.2": "С чистой, переполненной;",
 "thag2.40:1.3": "В сосуде бессмертного — кусочек Дхаммы,",
 "thag2.40:1.4": "Сделан шаг, чтобы погрузиться в джханы.",
 "thag2.40:2.1": "Не качайся, Каппата,",
 "thag2.40:2.2": "Не ударю тебя по уху;",
 "thag2.40:2.3": "Ведь ты, Каппата, не осознал меры,",
 "thag2.40:2.4": "Посреди Сангхи качаясь».",
 "thag2.40:2.5": "… Старший монах Каппатакура …",
 "thag2.40:2.6": "Глава Четвёртая.",
 "thag2.40:3.0": "Оглавление",
 "thag2.40:3.1": "Мигасира и Сивака,",
 "thag2.40:3.2": "Упавана и мудрец;",
 "thag2.40:3.3": "Исидинна и Каччана,",
 "thag2.40:3.4": "Нитака и великий провидец;",
 "thag2.40:3.5": "Сын Потирии — бык,",
 "thag2.40:3.6": "Бык Каппатакура»."
}
