{
 "thag1.60:0.1": "Стихи старших монахов 1.60",
 "thag1.60:0.2": "Раздел из одного",
 "thag1.60:0.3": "Шестая глава",
 "thag1.60:0.4": "Стихи старшего монаха Сивали",
 "thag1.60:1.1": "“Те мои осуществились устремления,",
 "thag1.60:1.2": "ради чего вошёл я в хижину;",
 "thag1.60:1.3": "Знание-высвобождение постиг,",
 "thag1.60:1.4": "к-самомнению-предрасположенность отбросив”.",
 "thag1.60:1.5": "… Старший монах Сивали …",
 "thag1.60:1.6": "Глава Шестая.",
 "thag1.60:2.0": "Оглавление",
 "thag1.60:2.1": "Годхика и Субаху,",
 "thag1.60:2.2": "Валлия, Уттия, провидец;",
 "thag1.60:2.3": "Старший монах Анджанаванья,",
 "thag1.60:2.4": "двое из хижины-пребывающих;",
 "thag1.60:2.5": "И Раманиякутика,",
 "thag1.60:2.6": "зовомый Косальский Сивали”."
}
