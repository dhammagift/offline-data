{
 "thag2.27:0.1": "Стихи старших монахов 2.27",
 "thag2.27:0.2": "Двойное собрание",
 "thag2.27:0.3": "Раздел Третий",
 "thag2.27:0.4": "Стихи старшего монаха Нандаки",
 "thag2.27:1.1": "“Как хороший скакун,",
 "thag2.27:1.2": "споткнувшись, утверждается;",
 "thag2.27:1.3": "Больше получив трепет,",
 "thag2.27:1.4": "неунывающий несёт ярмо.",
 "thag2.27:2.1": "Так видением-наделённого,",
 "thag2.27:2.2": "правильно-пробуждённого слушателя;",
 "thag2.27:2.3": "Чистокровным меня применяйте,",
 "thag2.27:2.4": "сыном Будды родным”.",
 "thag2.27:2.5": "… Старший монах Нандака …."
}
