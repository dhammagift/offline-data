{
 "thag1.80:0.1": "Стихи старших монахов 1.80",
 "thag1.80:0.2": "Раздел из одного",
 "thag1.80:0.3": "Восьмая глава",
 "thag1.80:0.4": "Стихи старшего монаха Угги",
 "thag1.80:1.1": "“Какая мной сделана активность,",
 "thag1.80:1.2": "малая ли или же большая;",
 "thag1.80:1.3": "Всё это полностью исчерпано,",
 "thag1.80:1.4": "отныне нет повторной вовлеченности-[индивидуального] существования”.",
 "thag1.80:1.5": "… Старший монах Угга …",
 "thag1.80:1.6": "Глава восьмая.",
 "thag1.80:2.0": "Оглавление",
 "thag1.80:2.1": "И старший монах Ваччхапала,",
 "thag1.80:2.2": "Атума молодой брахман провидец;",
 "thag1.80:2.3": "Суямана, Сусарада,",
 "thag1.80:2.4": "и старший монах Пияньджаха;",
 "thag1.80:2.5": "Арохапутта, Мендасира,",
 "thag1.80:2.6": "Раккхита, Уггой называемый”."
}
