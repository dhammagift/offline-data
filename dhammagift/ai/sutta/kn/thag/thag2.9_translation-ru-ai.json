{
 "thag2.9:0.1": "Стихи старших монахов 2.9",
 "thag2.9:0.2": "Двойное собрание",
 "thag2.9:0.3": "Глава первая",
 "thag2.9:0.4": "Стихи старшего монаха Готамы",
 "thag2.9:1.1": "“Приятно спят мудрецы,",
 "thag2.9:1.2": "которые к женщинам не привязаны;",
 "thag2.9:1.3": "Всегда ведь те, что должны охраняться,",
 "thag2.9:1.4": "в которых истина крайне трудна.",
 "thag2.9:2.1": "Убийство мы совершили, желание,",
 "thag2.9:2.2": "бездолжны отныне мы перед тобой;",
 "thag2.9:2.3": "Идём отныне к ниббане,",
 "thag2.9:2.4": "куда придя, не страдают”.",
 "thag2.9:2.5": "… Старший монах Готама …."
}
