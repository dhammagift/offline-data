{
 "thag4.5:0.1": "Стихи старших монахов 4.5",
 "thag4.5:0.2": "Четыре строфы",
 "thag4.5:0.3": "Глава первая",
 "thag4.5:0.4": "Стихи старшего монаха Джамбуки",
 "thag4.5:1.1": "«Пятьдесят пять лет",
 "thag4.5:1.2": "пыль-грязь я носил;",
 "thag4.5:1.3": "Вкушая ежемесячную еду,",
 "thag4.5:1.4": "волосы-бороду я сбривал.",
 "thag4.5:2.1": "На одной ноге я стоял,",
 "thag4.5:2.2": "сидения избегал;",
 "thag4.5:2.3": "Сухие испражнения я ел,",
 "thag4.5:2.4": "и подаяния не принимал.",
 "thag4.5:3.1": "Сделав такое,",
 "thag4.5:3.2": "ведущую в дурную участь;",
 "thag4.5:3.3": "Несомый великим потоком,",
 "thag4.5:3.4": "к Пробуждённому как к прибежищу пришёл.",
 "thag4.5:4.1": "Принятие прибежища узри,",
 "thag4.5:4.2": "узри явлений благую-явленность;",
 "thag4.5:4.3": "Три знания достигнуты,",
 "thag4.5:4.4": "исполнено Будды указание”.",
 "thag4.5:4.5": "… старший монах Джамбука …."
}
