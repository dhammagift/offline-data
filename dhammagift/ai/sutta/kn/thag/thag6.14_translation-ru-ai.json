{
 "thag6.14:0.1": "Стихи старших монахов 6.14",
 "thag6.14:0.2": "Глава шестых",
 "thag6.14:0.3": "Глава первая",
 "thag6.14:0.4": "Саббакамитта Тхера",
 "thag6.14:1.1": "“Двуногий этот нечист,",
 "thag6.14:1.2": "зловонный, разрушается;",
 "thag6.14:1.3": "Разными трупами наполненный,",
 "thag6.14:1.4": "сочащийся оттуда и отсюда.",
 "thag6.14:2.1": "Зверя затаившегося ловушкой,",
 "thag6.14:2.2": "крючком словно водяное растение;",
 "thag6.14:2.3": "Обезьяну словно смолой,",
 "thag6.14:2.4": "связывают обывателя.",
 "thag6.14:3.1": "Образы, звуки, вкусы, запахи,",
 "thag6.14:3.2": "и касания приятные уму;",
 "thag6.14:3.3": "Пять множителей желания эти,",
 "thag6.14:3.4": "в женских образах видны.",
 "thag6.14:4.1": "Которые их обслуживают,",
 "thag6.14:4.2": "с умом-состоянием в страсти обыватели;",
 "thag6.14:4.3": "Увеличивают могилу ужасную,",
 "thag6.14:4.4": "накапливают новое существование.",
 "thag6.14:5.1": "Который их избегает,",
 "thag6.14:5.2": "змеёй точно ногой голову;",
 "thag6.14:5.3": "Тот эту прилипчивость в мире,",
 "thag6.14:5.4": "памятующий полностью преодолевает.",
 "thag6.14:6.1": "В желаниях недостаток-опасность увидев,",
 "thag6.14:6.2": "отречение видя безопасным;",
 "thag6.14:6.3": "Высвобожденный из всех желаний,",
 "thag6.14:6.4": "достигнуто мной исчерпание истечений».",
 "thag6.14:6.5": "… Старший Саббакамитта ….",
 "thag6.14:6.6": "Шестая глава установлена.",
 "thag6.14:7.0": "Там сводка",
 "thag6.14:7.1": "Урувелакассапа и,",
 "thag6.14:7.2": "старший, делающий лечение, и;",
 "thag6.14:7.3": "Маханага и Кулла и,",
 "thag6.14:7.4": "Малукья, Саппадасака;",
 "thag6.14:7.5": "Катияна, Мигаджала,",
 "thag6.14:7.6": "Джента, Сумана по имени;",
 "thag6.14:7.7": "Натамуни, Брахмадатта,",
 "thag6.14:7.8": "Сириманда, всежелающий и;",
 "thag6.14:7.9": "Стихов восемьдесят четыре,",
 "thag6.14:7.10": "старших здесь четырнадцать."
}
