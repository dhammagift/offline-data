{
 "thag1.51:0.1": "Стихи старших монахов 1.51",
 "thag1.51:0.2": "Раздел из одного",
 "thag1.51:0.3": "Шестая глава",
 "thag1.51:0.4": "Стихи старшего монаха Годхики",
 "thag1.51:1.1": "«Дождит божество, как хорошо спето,",
 "thag1.51:1.2": "Покрыта моя хижина, приятна, безветренна;",
 "thag1.51:1.3": "Ум-состояние хорошо сосредоточено у меня,",
 "thag1.51:1.4": "Так что если хочешь, лей дождь, дэва”.",
 "thag1.51:1.5": "… Старший монах Годхика …."
}
