{
 "thag1.22:0.1": "Стихи старших монахов 1.22",
 "thag1.22:0.2": "Раздел из одного",
 "thag1.22:0.3": "Раздел Третий",
 "thag1.22:0.4": "Стихи старшего монаха Читтаки",
 "thag1.22:1.1": "“Синие, с красивыми шеями, с хохолками,",
 "thag1.22:1.2": "Павлины в Каарамбхии кричат;",
 "thag1.22:1.3": "Те, прохладным ветром играемые,",
 "thag1.22:1.4": "Спящего, зажгитесь, пробуждают”.",
 "thag1.22:1.5": "… Старший монах Читтака …."
}
