{
 "thag1.66:0.1": "Стихи старших монахов 1.66",
 "thag1.66:0.2": "Раздел из одного",
 "thag1.66:0.3": "Седьмой раздел",
 "thag1.66:0.4": "Стихи старшего монаха Мегхии",
 "thag1.66:1.1": "“Наставлял великий герой,",
 "thag1.66:1.2": "всех явлений превзошедший;",
 "thag1.66:1.3": "Его я явление услышав,",
 "thag1.66:1.4": "пребывал я вблизи памятующий;",
 "thag1.66:1.5": "Три знания достигнуты,",
 "thag1.66:1.6": "исполнено Будды указание”.",
 "thag1.66:1.7": "… Старший монах Мегхия …."
}
