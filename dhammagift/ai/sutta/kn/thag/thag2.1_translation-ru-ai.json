{
 "thag2.1:0.1": "Стихи старших монахов 2.1",
 "thag2.1:0.2": "Двойное собрание",
 "thag2.1:0.3": "Глава первая",
 "thag2.1:0.4": "Стихи старшего монаха Уттары",
 "thag2.1:1.1": "«Нет никакой вовлеченности постоянной,",
 "thag2.1:1.2": "и отождествления не вечны;",
 "thag2.1:1.3": "Возникают же те блоки,",
 "thag2.1:1.4": "исчезают снова и снова.",
 "thag2.1:2.1": "Эту недостаток-опасность узнав,",
 "thag2.1:2.2": "вовлеченностью я бесцелен;",
 "thag2.1:2.3": "Высвобожденный из всех желаний,",
 "thag2.1:2.4": "достигнуто мной исчерпание истечений».",
 "thag2.1:2.5": "Так действительно уважаемый старший монах Уттара эти стихи произнес."
}
