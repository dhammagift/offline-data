{
 "thag1.75:0.1": "Стихи старших монахов 1.75",
 "thag1.75:0.2": "Раздел из одного",
 "thag1.75:0.3": "Восьмая глава",
 "thag1.75:0.4": "Стих старшего монаха Сусарады",
 "thag1.75:1.1": "“Хорошо — видение хорошо-расположенных,",
 "thag1.75:1.2": "Сомнение отсекается, разум возрастает;",
 "thag1.75:1.3": "Даже незрелого делают мудрецом,",
 "thag1.75:1.4": "Потому хороша встреча с чистыми”.",
 "thag1.75:1.5": "… Старший монах Сусарада …."
}
