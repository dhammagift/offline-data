{
 "thag16.2:0.1": "Стихи старших монахов 16.2",
 "thag16.2:0.2": "Двадцати-глава",
 "thag16.2:0.3": "Глава первая",
 "thag16.2:0.4": "Стихи старшего монаха Парапарии",
 "thag16.2:1.1": "“У шрамана возникла мысль,",
 "thag16.2:1.2": "у монаха, идущего снова и снова;",
 "thag16.2:1.3": "У сидящего в одиночестве,",
 "thag16.2:1.4": "у уединённого, зажёгшегося.",
 "thag16.2:2.1": "Какую последовательность человек,",
 "thag16.2:2.2": "какой обычай, какое поведение;",
 "thag16.2:2.3": "Своё дело делающим будет,",
 "thag16.2:2.4": "и никого не будет тревожить.",
 "thag16.2:3.1": "Способности людей,",
 "thag16.2:3.2": "для блага и неблага;",
 "thag16.2:3.3": "Неохраняемые — для неблага,",
 "thag16.2:3.4": "охраняемые — для блага.",
 "thag16.2:4.1": "Способности же охраняя,",
 "thag16.2:4.2": "и способности оберегая;",
 "thag16.2:4.3": "Своё дело делающим будет,",
 "thag16.2:4.4": "и никого не будет тревожить.",
 "thag16.2:5.1": "Если способность глаза к объектам,",
 "thag16.2:5.2": "идущую не сдерживая;",
 "thag16.2:5.3": "Не видящий недостатка-опасности,",
 "thag16.2:5.4": "тот от боли не освобождается.",
 "thag16.2:6.1": "Если способность уха к звукам,",
 "thag16.2:6.2": "идущую не сдерживая;",
 "thag16.2:6.3": "Не видящий недостатка-опасности,",
 "thag16.2:6.4": "тот от боли не освобождается.",
 "thag16.2:7.1": "Не видящий спасения,",
 "thag16.2:7.2": "к запахам же приобщается;",
 "thag16.2:7.3": "Не освобождается он от боли,",
 "thag16.2:7.4": "на запахах зацикленный.",
 "thag16.2:8.1": "Кислое и сладкое,",
 "thag16.2:8.2": "горькое и острое помня;",
 "thag16.2:8.3": "В вкусо-цеплянии увязший,",
 "thag16.2:8.4": "сердце не понимает.",
 "thag16.2:9.1": "Красивые, не-отвратительные,",
 "thag16.2:9.2": "касания помня;",
 "thag16.2:9.3": "Очарованный, из-за страсти,",
 "thag16.2:9.4": "разнообразную испытывает боль.",
 "thag16.2:10.1": "Ум-представление с этими явлениями,",
 "thag16.2:10.2": "кто не может защитить;",
 "thag16.2:10.3": "То его боль сопровождает,",
 "thag16.2:10.4": "со всеми этими пятью.",
 "thag16.2:11.1": "Гноем и кровью наполненный,",
 "thag16.2:11.2": "многих мертвецов также;",
 "thag16.2:11.3": "Муже-героем сделанный красивый,",
 "thag16.2:11.4": "шкатулку как разукрашенную.",
 "thag16.2:12.1": "Горько-сладкое наслаждение,",
 "thag16.2:12.2": "мило-связывающую боль;",
 "thag16.2:12.3": "Лезвие как мёдом намазанное,",
 "thag16.2:12.4": "облизывая не понимает.",
 "thag16.2:13.1": "В женщино-образе, в женщино-звуке,",
 "thag16.2:13.2": "в касаниях также женщины;",
 "thag16.2:13.3": "В женщино-запахах привязанный,",
 "thag16.2:13.4": "разнообразную испытывает боль.",
 "thag16.2:14.1": "Женщино-потоки все,",
 "thag16.2:14.2": "текут пять в пяти;",
 "thag16.2:14.3": "Им преграду сделать,",
 "thag16.2:14.4": "кто способен, решительный.",
 "thag16.2:15.1": "Он смысла-блага, он установленный в Дхамме,",
 "thag16.2:15.2": "он способный, он проницательный;",
 "thag16.2:15.3": "Делал бы, радуясь,",
 "thag16.2:15.4": "дело, с благо-Дхаммой связанное.",
 "thag16.2:16.1": "А после тонет связанное сознаванием,",
 "thag16.2:16.2": "в изъяне дело бесполезное;",
 "thag16.2:16.3": "‘Не то дело’ посчитав,",
 "thag16.2:16.4": "старательный, проницательный.",
 "thag16.2:17.1": "А что с благом-смыслом-целью связано,",
 "thag16.2:17.2": "и какая в Дхамме-пришедшем радость;",
 "thag16.2:17.3": "То приняв, следуйте,",
 "thag16.2:17.4": "это ведь и есть высшая радость.",
 "thag16.2:18.1": "Высокими-низкими уловками,",
 "thag16.2:18.2": "других желает захватить;",
 "thag16.2:18.3": "Убив, поразив, а после опечалив,",
 "thag16.2:18.4": "отнимает насильно кто у других.",
 "thag16.2:19.1": "Обтёсывая гвоздём гвоздь,",
 "thag16.2:19.2": "выбивает сильный как;",
 "thag16.2:19.3": "Способности способностями же,",
 "thag16.2:19.4": "выбивает умелый так.",
 "thag16.2:20.1": "Веру, решимость, самадхи,",
 "thag16.2:20.2": "памятование-понимание развивая;",
 "thag16.2:20.3": "Пятью пять убив,",
 "thag16.2:20.4": "без-тяготы уходит брахман.",
 "thag16.2:21.1": "Он смысла-блага, он установленный в Дхамме,",
 "thag16.2:21.2": "сделав речь-наставление;",
 "thag16.2:21.3": "Всем полностью Будды,",
 "thag16.2:21.4": "тот человек приятное-комфорт достигает”.",
 "thag16.2:21.5": "… Старший монах Парапария …."
}
