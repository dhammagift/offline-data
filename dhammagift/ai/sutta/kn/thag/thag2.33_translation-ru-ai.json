{
 "thag2.33:0.1": "Стихи старших монахов 2.33",
 "thag2.33:0.2": "Двойное собрание",
 "thag2.33:0.3": "Раздел Четвёртый",
 "thag2.33:0.4": "Стихи старшего монаха Упаваны",
 "thag2.33:1.1": "«Арахант, Благой в мире,",
 "thag2.33:1.2": "ветрами нездоров мудрец;",
 "thag2.33:1.3": "Если горячая вода есть,",
 "thag2.33:1.4": "мудрецу дай, брахман.",
 "thag2.33:2.1": "Почитаемый почитаемых,",
 "thag2.33:2.2": "уважаемых уважаемый;",
 "thag2.33:2.3": "Почитаемый-почтительный,",
 "thag2.33:2.4": "ему я хочу принести”.",
 "thag2.33:2.5": "… старший монах Упавана …."
}
