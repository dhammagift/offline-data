{
 "thag1.50:0.1": "Стихи старших монахов 1.50",
 "thag1.50:0.2": "Раздел из одного",
 "thag1.50:0.3": "Пятая глава",
 "thag1.50:0.4": "Стихи старшего монаха Вималы",
 "thag1.50:1.1": "“Земля и орошается, и дует,",
 "thag1.50:1.2": "Ветер, молния ходят в небе;",
 "thag1.50:1.3": "Успокаиваются рассуждения,",
 "thag1.50:1.4": "Ум хорошо объединён у меня”.",
 "thag1.50:1.5": "… Старший монах Вимала …",
 "thag1.50:1.6": "глава пятая.",
 "thag1.50:2.0": "Оглавление",
 "thag1.50:2.1": "Сириваддха, Ревата старший монах,",
 "thag1.50:2.2": "Сумангала, Санусавхая;",
 "thag1.50:2.3": "И Раманиявихари,",
 "thag1.50:2.4": "Самиддхи, Удджая, Санджая;",
 "thag1.50:2.5": "И Раманеййя, тот старший монах,",
 "thag1.50:2.6": "И Вимала, и Рананьджахота."
}
