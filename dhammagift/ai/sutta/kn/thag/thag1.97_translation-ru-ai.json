{
 "thag1.97:0.1": "Стихи старших монахов 1.97",
 "thag1.97:0.2": "Раздел из одного",
 "thag1.97:0.3": "Десятая глава",
 "thag1.97:0.4": "Стихи старшего монаха Тиссы",
 "thag1.97:1.1": "“Оставив сто-паловую бронзу,",
 "thag1.97:1.2": "Золото, сто-полосное;",
 "thag1.97:1.3": "Взял я глиняную чашу,",
 "thag1.97:1.4": "Это — второе посвящение”.",
 "thag1.97:1.5": "… Старший монах Тисса …."
}
