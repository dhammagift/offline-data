{
 "thag1.37:0.1": "Стихи старших монахов 1.37",
 "thag1.37:0.2": "Раздел из одного",
 "thag1.37:0.3": "Раздел Четвёртый",
 "thag1.37:0.4": "Стихи старшего монаха Кумапуттасахаяки",
 "thag1.37:1.1": "“В разные страны идут,",
 "thag1.37:1.2": "Странствуя несознаваемыми;",
 "thag1.37:1.3": "И самадхи упускают,",
 "thag1.37:1.4": "Что же странствие по стране сделает?",
 "thag1.37:1.5": "Поэтому устранив раздражение,",
 "thag1.37:1.6": "Зажёгся бы, не-откладывая”.",
 "thag1.37:1.7": "… Старший монах Кумапуттасахаяка …."
}
