{
 "thag1.90:0.1": "Стихи старших монахов 1.90",
 "thag1.90:0.2": "Раздел из одного",
 "thag1.90:0.3": "Девятая глава",
 "thag1.90:0.4": "Стихи старшего монаха Самидатты",
 "thag1.90:1.1": "«Пять блоков всесторонне поняты,",
 "thag1.90:1.2": "стоят с отрезанным корнем;",
 "thag1.90:1.3": "Исчерпан рождение-круговорот,",
 "thag1.90:1.4": "отныне нет повторной вовлеченности-[индивидуального] существования”.",
 "thag1.90:1.5": "… Старший монах Самидатта …",
 "thag1.90:1.6": "глава девятая.",
 "thag1.90:2.0": "Оглавление",
 "thag1.90:2.1": "Старший монах Самитигутта и,",
 "thag1.90:2.2": "Кассапа, называемый Львом;",
 "thag1.90:2.3": "Нита, Сунага, Нагита,",
 "thag1.90:2.4": "вошедший провидец Адджуна;",
 "thag1.90:2.5": "Девасабха, который старший монах,",
 "thag1.90:2.6": "Самидатта великой силы»."
}
