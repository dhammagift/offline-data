{
 "thag10.7:0.1": "Стихи старших монахов 10.7",
 "thag10.7:0.2": "Десятичник",
 "thag10.7:0.3": "Глава первая",
 "thag10.7:0.4": "(Другой) Готама-старший-стихи",
 "thag10.7:1.1": "“Следует понимать своё благо,",
 "thag10.7:1.2": "Следует смотреть на изречение;",
 "thag10.7:1.3": "И что здесь было бы подобающим,",
 "thag10.7:1.4": "Для вступившего в шраманство.",
 "thag10.7:2.1": "Друг здесь и благой,",
 "thag10.7:2.2": "Тренировка обширное принятие;",
 "thag10.7:2.3": "И послушание учителям,",
 "thag10.7:2.4": "Это шраману подобающее.",
 "thag10.7:3.1": "К пробуждённым почтительность,",
 "thag10.7:3.2": "К Дхамме уважение как-есть;",
 "thag10.7:3.3": "И к Сангхе почитание,",
 "thag10.7:3.4": "Это шраману подобающее.",
 "thag10.7:4.1": "К поведению-сфере приложенный,",
 "thag10.7:4.2": "Средства к жизни очищены, безупречны;",
 "thag10.7:4.3": "И ума-состояния установление,",
 "thag10.7:4.4": "Это шраману подобающее.",
 "thag10.7:5.1": "Должное поведение и недолжное поведение,",
 "thag10.7:5.2": "В манерах поведения радующее;",
 "thag10.7:5.3": "В высшем уме упражнение,",
 "thag10.7:5.4": "Это шраману подобающее.",
 "thag10.7:6.1": "Лесные жилища,",
 "thag10.7:6.2": "Уединённые, малозвучные;",
 "thag10.7:6.3": "Должны посещаться мудрецом,",
 "thag10.7:6.4": "Это шраману подобающее.",
 "thag10.7:7.1": "И нравственность, и учёность,",
 "thag10.7:7.2": "Явлений различение как-есть;",
 "thag10.7:7.3": "Истин постижение,",
 "thag10.7:7.4": "Это шраману подобающее.",
 "thag10.7:8.1": "И развивал бы 'ненадёжно',",
 "thag10.7:8.2": "Без-личности-сознавание и не-ладности-сознавание;",
 "thag10.7:8.3": "В мире и не-радость,",
 "thag10.7:8.4": "Это шраману подобающее.",
 "thag10.7:9.1": "И развивал бы аспекты пробуждения,",
 "thag10.7:9.2": "Сверх-способности-основы, способности, силы;",
 "thag10.7:9.3": "Восьми-аспектный путь благородный,",
 "thag10.7:9.4": "Это шраману подобающее.",
 "thag10.7:10.1": "Цепляние отбросил бы мудрец,",
 "thag10.7:10.2": "С корнем истечения расщепил бы;",
 "thag10.7:10.3": "Пребывал бы полностью освобождённым,",
 "thag10.7:10.4": "Это шраману подобающе”.",
 "thag10.7:10.5": "… Готамо старший монах …",
 "thag10.7:10.6": "Десять-строф раздел установлен.",
 "thag10.7:11.0": "Там сводка",
 "thag10.7:11.1": "Калудайи и тот старший монах,",
 "thag10.7:11.2": "одиноко-пребывающий и Каппино;",
 "thag10.7:11.3": "Чулапантхака и Каппа,",
 "thag10.7:11.4": "Упасена и Готамо;",
 "thag10.7:11.5": "Семь этих в десятке старших монахов,",
 "thag10.7:11.6": "стихов здесь семьдесят."
}
