{
 "thag4.4:0.1": "Стихи старших монахов 4.4",
 "thag4.4:0.2": "Четыре строфы",
 "thag4.4:0.3": "Глава первая",
 "thag4.4:0.4": "Стихи старшего монаха Нандаки",
 "thag4.4:1.1": "“Проклятье телу, зловонному,",
 "thag4.4:1.2": "в стане Мары, сочащемуся;",
 "thag4.4:1.3": "Девять потоков в теле,",
 "thag4.4:1.4": "которые текут постоянно.",
 "thag4.4:2.1": "Не думай о прошлом,",
 "thag4.4:2.2": "не надейся на Татхагат;",
 "thag4.4:2.3": "Даже на небесах они не радуются,",
 "thag4.4:2.4": "что уж говорить о людях.",
 "thag4.4:3.1": "А которые глупцы неразумные,",
 "thag4.4:3.2": "неразумные, замутнённостью-заблуждением покрытые;",
 "thag4.4:3.3": "Подобные там радуются,",
 "thag4.4:3.4": "в Марою-брошенной привязи.",
 "thag4.4:4.1": "Которых и страсть и злоба,",
 "thag4.4:4.2": "и невидение выбелены;",
 "thag4.4:4.3": "Такой там не радуется,",
 "thag4.4:4.4": "с нитью обрезанной, непривязанный”.",
 "thag4.4:4.5": "… Старший монах Нандака …."
}
