{
 "thag3.11:0.1": "Стихи старших монахов 3.11",
 "thag3.11:0.2": "Тройной раздел",
 "thag3.11:0.3": "Глава первая",
 "thag3.11:0.4": "Стихи старшего монаха Упали",
 "thag3.11:1.1": "“С верой уйдя в бездомность,",
 "thag3.11:1.2": "недавно ушедший, новый;",
 "thag3.11:1.3": "Друзей пусть общается с благими,",
 "thag3.11:1.4": "с чистыми жизнями, неутомлёнными.",
 "thag3.11:2.1": "С верой уйдя в бездомность,",
 "thag3.11:2.2": "недавно ушедший, новый;",
 "thag3.11:2.3": "В Сангхе пребывая, монах,",
 "thag3.11:2.4": "пусть учит выведение мудрый.",
 "thag3.11:3.1": "С верой уйдя в бездомность,",
 "thag3.11:3.2": "недавно ушедший, новый;",
 "thag3.11:3.3": "В каппах и не-каппах умелый,",
 "thag3.11:3.4": "пусть ведёт себя без оглядки”.",
 "thag3.11:3.5": "… Старший монах Упали …."
}
