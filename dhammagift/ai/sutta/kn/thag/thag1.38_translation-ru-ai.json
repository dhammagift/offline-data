{
 "thag1.38:0.1": "Стихи старших монахов 1.38",
 "thag1.38:0.2": "Раздел из одного",
 "thag1.38:0.3": "Раздел Четвёртый",
 "thag1.38:0.4": "Стихи старшего монаха Гавампати",
 "thag1.38:1.1": "“Который силой-способностью Сарабху поставил,",
 "thag1.38:1.2": "Тот Гавампати — не-привязанный, не-колеблющийся;",
 "thag1.38:1.3": "Того все-отождествления-превзошедшего великого мудреца,",
 "thag1.38:1.4": "Дэвы почитают-славят бытие превзошедшего”.",
 "thag1.38:1.5": "… Старший монах Гавампати …."
}
