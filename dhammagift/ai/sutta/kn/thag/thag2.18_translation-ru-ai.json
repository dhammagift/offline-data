{
 "thag2.18:0.1": "Стихи старших монахов 2.18",
 "thag2.18:0.2": "Двойное собрание",
 "thag2.18:0.3": "Вторая Глава",
 "thag2.18:0.4": "Стихи старшего монаха Кимилы",
 "thag2.18:1.1": "“В восточной бамбуковой роще,",
 "thag2.18:1.2": "Сыны Сакьев, товарищи;",
 "thag2.18:1.3": "Оставив немалые богатства,",
 "thag2.18:1.4": "В собранном с подаяний радуются.",
 "thag2.18:2.1": "Решительно-старающиеся, решительные,",
 "thag2.18:2.2": "Всегда с твёрдым усердием;",
 "thag2.18:2.3": "Радуются радости Дхаммы,",
 "thag2.18:2.4": "Оставив мирскую радость”.",
 "thag2.18:2.5": "… Старший монах Кимила …."
}
