{
 "thag4.7:0.1": "Стихи старших монахов 4.7",
 "thag4.7:0.2": "Четыре строфы",
 "thag4.7:0.3": "Глава первая",
 "thag4.7:0.4": "Стихи старшего монаха Самбхуты",
 "thag4.7:1.1": "“Кто в медленное время спешит,",
 "thag4.7:1.2": "а в спешное медлит;",
 "thag4.7:1.3": "Неправильным устроением,",
 "thag4.7:1.4": "глупец к боли идёт.",
 "thag4.7:2.1": "Его блага убывают,",
 "thag4.7:2.2": "как луна на тёмной половине;",
 "thag4.7:2.3": "И бесславие он обретает,",
 "thag4.7:2.4": "и с друзьями ссорится.",
 "thag4.7:3.1": "Кто в медленное время медлит,",
 "thag4.7:3.2": "а в спешное спешит;",
 "thag4.7:3.3": "Правильным устроением,",
 "thag4.7:3.4": "приятное обретает мудрец.",
 "thag4.7:4.1": "Его блага наполняются,",
 "thag4.7:4.2": "как луна на светлой половине;",
 "thag4.7:4.3": "Репутацию и славу он обретает,",
 "thag4.7:4.4": "с друзьями не ссорится”.",
 "thag4.7:4.5": "… Старший монах Самбхута …."
}
