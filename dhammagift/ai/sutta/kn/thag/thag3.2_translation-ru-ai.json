{
 "thag3.2:0.1": "Стихи старших монахов 3.2",
 "thag3.2:0.2": "Тройной раздел",
 "thag3.2:0.3": "Глава первая",
 "thag3.2:0.4": "Стихи старшего монаха Паччая",
 "thag3.2:1.1": "“Пять дней как я продвинулся,",
 "thag3.2:1.2": "ученик, не-достигший-представленного;",
 "thag3.2:1.3": "В обитель-вихару мне вошедшему,",
 "thag3.2:1.4": "ума-состояния устремление было.",
 "thag3.2:2.1": "Не буду есть, не буду пить,",
 "thag3.2:2.2": "из обители-вихары не выйду;",
 "thag3.2:2.3": "И на боковую не лягу,",
 "thag3.2:2.4": "с цепляния-дротиком не удалённым.",
 "thag3.2:3.1": "Того меня так пребывающего,",
 "thag3.2:3.2": "Узри решительно-упорствующего;",
 "thag3.2:3.3": "Три знания достигнуты,",
 "thag3.2:3.4": "исполнено Будды указание”.",
 "thag3.2:3.5": "… Старший Паччай …."
}
