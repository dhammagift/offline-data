{
 "thag1.73:0.1": "Стихи старших монахов 1.73",
 "thag1.73:0.2": "Раздел из одного",
 "thag1.73:0.3": "Восьмая глава",
 "thag1.73:0.4": "Стихи старшего монаха Манавы",
 "thag1.73:1.1": "“Состарившегося увидев и страдающего и больного,",
 "thag1.73:1.2": "И мёртвого увидев, ушедшего с исчерпанием срока жизни;",
 "thag1.73:1.3": "Оттуда я, выйдя, покинул,",
 "thag1.73:1.4": "Отбросив желания, услаждающие ум”.",
 "thag1.73:1.5": "… Старший монах Манава …."
}
