{
 "thag4.2:0.1": "Стихи старших монахов 4.2",
 "thag4.2:0.2": "Четыре строфы",
 "thag4.2:0.3": "Глава первая",
 "thag4.2:0.4": "Стихи старшего монаха Бхагу",
 "thag4.2:1.1": "“Я сонливостью охвачен,",
 "thag4.2:1.2": "из жилища вышел;",
 "thag4.2:1.3": "На площадку для ходьбы поднимаясь,",
 "thag4.2:1.4": "тут же упал на землю.",
 "thag4.2:2.1": "Тело растерев,",
 "thag4.2:2.2": "снова взойдя на площадку для ходьбы;",
 "thag4.2:2.3": "На площадке для ходьбы ходил я,",
 "thag4.2:2.4": "внутри хорошо сосредоточенный.",
 "thag4.2:3.1": "Тогда у меня представление,",
 "thag4.2:3.2": "первопричинно возникло;",
 "thag4.2:3.3": "Недостаток-опасность проявился,",
 "thag4.2:3.4": "незаинтересованность утвердилась.",
 "thag4.2:4.1": "Тогда ум освободился у меня,",
 "thag4.2:4.2": "узри явлений благую-явленность;",
 "thag4.2:4.3": "Три знания достигнуты,",
 "thag4.2:4.4": "исполнено Будды указание”.",
 "thag4.2:4.5": "… Старший монах Бхагу …."
}
