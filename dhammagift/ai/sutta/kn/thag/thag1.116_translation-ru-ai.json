{
 "thag1.116:0.1": "Стихи старших монахов 1.116",
 "thag1.116:0.2": "Раздел из одного",
 "thag1.116:0.3": "Двенадцатый раздел",
 "thag1.116:0.4": "Стихи старшего монаха Парапарии",
 "thag1.116:1.1": "«Шесть внутренне-внешних областей оставив,",
 "thag1.116:1.2": "охраняя-входы хорошо сдержанный;",
 "thag1.116:1.3": "Корень боли извергнув,",
 "thag1.116:1.4": "достигнуто мной исчерпание истечений».",
 "thag1.116:1.5": "… Старший монах Парапария …."
}
