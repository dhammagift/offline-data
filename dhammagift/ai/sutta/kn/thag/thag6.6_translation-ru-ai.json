{
 "thag6.6:0.1": "Стихи старших монахов 6.6",
 "thag6.6:0.2": "Глава шестых",
 "thag6.6:0.3": "Глава первая",
 "thag6.6:0.4": "Стихи старшего монаха Саппадасы",
 "thag6.6:1.1": "“Двадцать пять лет,",
 "thag6.6:1.2": "с тех пор как я ушёл;",
 "thag6.6:1.3": "Даже на миг щелчка пальцев,",
 "thag6.6:1.4": "спокойствия ума-мышления не достиг.",
 "thag6.6:2.1": "Не получив однонаправленности ума-состояния,",
 "thag6.6:2.2": "желания-страстью мучимый;",
 "thag6.6:2.3": "Руки воздев и рыдая,",
 "thag6.6:2.4": "из жилища вышел.",
 "thag6.6:3.1": "Нож возьму,",
 "thag6.6:3.2": "Какая цель в жизни мне;",
 "thag6.6:3.3": "Как же, обучение отбросив,",
 "thag6.6:3.4": "смерть совершит такой, как я.",
 "thag6.6:4.1": "Тогда я, бритву взяв,",
 "thag6.6:4.2": "на кровати сел;",
 "thag6.6:4.3": "Направлена бритва была,",
 "thag6.6:4.4": "чтобы вену перерезать свою.",
 "thag6.6:5.1": "Тогда у меня представление,",
 "thag6.6:5.2": "первопричинно возникло;",
 "thag6.6:5.3": "Недостаток-опасность проявился,",
 "thag6.6:5.4": "незаинтересованность утвердилась.",
 "thag6.6:6.1": "Тогда ум освободился у меня,",
 "thag6.6:6.2": "узри явлений благую-явленность;",
 "thag6.6:6.3": "Три знания достигнуты,",
 "thag6.6:6.4": "исполнено Будды указание”.",
 "thag6.6:6.5": "… Старший монах Саппадаса …."
}
