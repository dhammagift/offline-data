{
 "thag2.26:0.1": "Стихи старших монахов 2.26",
 "thag2.26:0.2": "Двойное собрание",
 "thag2.26:0.3": "Раздел Третий",
 "thag2.26:0.4": "Пуннамасаттхерагатха",
 "thag2.26:1.1": "“Пять преград оставив,",
 "thag2.26:1.2": "от-связи-защиты для достижения;",
 "thag2.26:1.3": "Дхамма-зеркало взяв,",
 "thag2.26:1.4": "знание-видение своё.",
 "thag2.26:2.1": "Рассмотрел я это тело,",
 "thag2.26:2.2": "всё внутреннее и внешнее;",
 "thag2.26:2.3": "Внутренне и внешне,",
 "thag2.26:2.4": "пусто тело увиделось”.",
 "thag2.26:2.5": "… Старший монах Пуннамасо …."
}
