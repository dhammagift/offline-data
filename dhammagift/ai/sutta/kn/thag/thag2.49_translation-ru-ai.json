{
 "thag2.49:0.1": "Стихи старших монахов 2.49",
 "thag2.49:0.2": "Двойное собрание",
 "thag2.49:0.3": "Пятая глава",
 "thag2.49:0.4": "Стихи старшего монаха Сандхиты",
 "thag2.49:1.1": "«У ашваттхи, в зелёном сиянии,",
 "thag2.49:1.2": "на разросшемся дереве;",
 "thag2.49:1.3": "Одно к Пробуждённому-относящееся сознавание,",
 "thag2.49:1.4": "получил я, памятующий.",
 "thag2.49:2.1": "Тридцать одну каппу отсюда,",
 "thag2.49:2.2": "какое сознавание получил я тогда;",
 "thag2.49:2.3": "Благодаря силе того сознавания,",
 "thag2.49:2.4": "достигнуто мной исчерпание истечений».",
 "thag2.49:2.5": "… Старший монах Сандхита …",
 "thag2.49:2.6": "глава пятая.",
 "thag2.49:3.0": "Оглавление",
 "thag2.49:3.1": "Старший монах Кумаракассапа,",
 "thag2.49:3.2": "и Дхаммапала, и Брахмали;",
 "thag2.49:3.3": "Могхараджа, Висакха,",
 "thag2.49:3.4": "и Чулака, и Анупама;",
 "thag2.49:3.5": "Ваджита, старший монах Сандхита,",
 "thag2.49:3.6": "загрязнений-страсти-несущие.",
 "thag2.49:3.7": "Двойное-изложение установлено.",
 "thag2.49:4.0": "Там сводка",
 "thag2.49:4.1": "В разделе парных строф,",
 "thag2.49:4.2": "девяносто и восемь;",
 "thag2.49:4.3": "Старших монахов сорок девять,",
 "thag2.49:4.4": "сказано знатоками метода."
}
