{
 "thag1.26:0.1": "Стихи старших монахов 1.26",
 "thag1.26:0.2": "Раздел из одного",
 "thag1.26:0.3": "Раздел Третий",
 "thag1.26:0.4": "Стихи старшего монаха Абхаи",
 "thag1.26:1.1": "“Услышав хорошо-сказанную речь,",
 "thag1.26:1.2": "Пробуждённым, Солнца-родича;",
