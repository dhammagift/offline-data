{
 "thag16.5:0.1": "Стихи старших монахов 16.5",
 "thag16.5:0.2": "Двадцати-глава",
 "thag16.5:0.3": "Глава первая",
 "thag16.5:0.4": "Стихи старшего монаха Малукьяпутты",
 "thag16.5:1.1": "“Образ увидев, памятование утеряно,",
 "thag16.5:1.2": "Приятный знак в уме-представлении отражающего;",
 "thag16.5:1.3": "С умом-состоянием, охваченным страстью, ведает,",
 "thag16.5:1.4": "И это, удерживая, стоит.",
 "thag16.5:2.1": "У того возрастают чувствования,",
 "thag16.5:2.2": "многие, из образов возникающие;",
 "thag16.5:2.3": "Алчность и раздражение,",
 "thag16.5:2.4": "ум его подавляется;",
 "thag16.5:2.5": "Так накапливающему боль,",
 "thag16.5:2.6": "далеко ниббана говорится.",
 "thag16.5:3.1": "Звук услышав, памятование утеряно,",
 "thag16.5:3.2": "Приятный знак в уме-представлении отражающего;",
 "thag16.5:3.3": "С умом-состоянием, охваченным страстью, ведает,",
 "thag16.5:3.4": "И это, удерживая, стоит.",
 "thag16.5:4.1": "У того возрастают чувствования,",
 "thag16.5:4.2": "многообразны звуко-возникновения;",
 "thag16.5:4.3": "Алчность и раздражение,",
 "thag16.5:4.4": "ум его подавляется;",
 "thag16.5:4.5": "Так накапливающему боль,",
 "thag16.5:4.6": "далеко ниббана говорится.",
 "thag16.5:5.1": "Запах учуяв, памятование утеряно,",
 "thag16.5:5.2": "Приятный знак в уме-представлении отражающего;",
 "thag16.5:5.3": "С умом-состоянием, охваченным страстью, ведает,",
 "thag16.5:5.4": "И это, удерживая, стоит.",
 "thag16.5:6.1": "У того возрастают чувствования,",
 "thag16.5:6.2": "многообразны запахо-возникновения;",
 "thag16.5:6.3": "Алчность и раздражение,",
 "thag16.5:6.4": "ум его подавляется;",
 "thag16.5:6.5": "Так накапливающему боль,",
 "thag16.5:6.6": "далеко ниббана говорится.",
 "thag16.5:7.1": "Вкус вкусив, памятование утеряно,",
 "thag16.5:7.2": "Приятный знак в уме-представлении отражающего;",
 "thag16.5:7.3": "С умом-состоянием, охваченным страстью, ведает,",
 "thag16.5:7.4": "И это, удерживая, стоит.",
 "thag16.5:8.1": "У того возрастают чувствования,",
 "thag16.5:8.2": "многообразны вкусо-возникновения;",
 "thag16.5:8.3": "Алчность и раздражение,",
 "thag16.5:8.4": "ум его подавляется;",
 "thag16.5:8.5": "Так накапливающему боль,",
 "thag16.5:8.6": "далеко ниббана говорится.",
 "thag16.5:9.1": "Касание коснувшись, памятование утеряно,",
 "thag16.5:9.2": "Приятный знак в уме-представлении отражающего;",
 "thag16.5:9.3": "С умом-состоянием, охваченным страстью, ведает,",
 "thag16.5:9.4": "И это, удерживая, стоит.",
 "thag16.5:10.1": "У того возрастают чувствования,",
 "thag16.5:10.2": "многообразны касание-возникновения;",
 "thag16.5:10.3": "Алчность и раздражение,",
 "thag16.5:10.4": "ум его подавляется;",
 "thag16.5:10.5": "Так накапливающему боль,",
 "thag16.5:10.6": "далеко ниббана говорится.",
 "thag16.5:11.1": "Явление узнав, памятование утеряно,",
 "thag16.5:11.2": "Приятный знак в уме-представлении отражающего;",
 "thag16.5:11.3": "С умом-состоянием, охваченным страстью, ведает,",
 "thag16.5:11.4": "И это, удерживая, стоит.",
 "thag16.5:12.1": "У того возрастают чувствования,",
 "thag16.5:12.2": "многообразны явление-возникновения;",
 "thag16.5:12.3": "Алчность и раздражение,",
 "thag16.5:12.4": "ум его подавляется;",
 "thag16.5:12.5": "Так накапливающему боль,",
 "thag16.5:12.6": "далеко ниббана говорится.",
 "thag16.5:13.1": "Не тот очаровывается объектами,",
 "thag16.5:13.2": "образ увидев памятующим;",
 "thag16.5:13.3": "Без-страстным-умом чувствует,",
 "thag16.5:13.4": "и его не удерживает, не стоит.",
 "thag16.5:14.1": "Как ему смотрящему объект,",
 "thag16.5:14.2": "сопровождающего также чувствование;",
 "thag16.5:14.3": "Угасает, не накапливается,",
 "thag16.5:14.4": "так он ведёт памятующий;",
 "thag16.5:14.5": "Так убирающего боль,",
 "thag16.5:14.6": "близко ниббана зовётся.",
 "thag16.5:15.1": "Не очаровывается он звуками,",
 "thag16.5:15.2": "звук услышав памятующим;",
 "thag16.5:15.3": "Без-страстным-умом чувствует,",
 "thag16.5:15.4": "и его не удерживает, не стоит.",
 "thag16.5:16.1": "Как ему слышащему звук,",
 "thag16.5:16.2": "сопровождающего также чувствование;",
 "thag16.5:16.3": "Угасает, не накапливается,",
 "thag16.5:16.4": "так он ведёт памятующий;",
 "thag16.5:16.5": "Так убирающего боль,",
 "thag16.5:16.6": "близко ниббана зовётся.",
 "thag16.5:17.1": "Не очаровывается он запахами,",
 "thag16.5:17.2": "запах унюхав памятующим;",
 "thag16.5:17.3": "Без-страстным-умом чувствует,",
 "thag16.5:17.4": "и его не удерживает, не стоит.",
 "thag16.5:18.1": "Как ему нюхающему запах,",
 "thag16.5:18.2": "сопровождающего также чувствование;",
 "thag16.5:18.3": "Угасает, не накапливается,",
 "thag16.5:18.4": "так он ведёт памятующий;",
 "thag16.5:18.5": "Так убирающего боль,",
 "thag16.5:18.6": "близко ниббана зовётся.",
 "thag16.5:19.1": "Не очаровывается он вкусами,",
 "thag16.5:19.2": "вкус вкусив памятующим;",
 "thag16.5:19.3": "Без-страстным-умом чувствует,",
 "thag16.5:19.4": "и его не удерживает, не стоит.",
 "thag16.5:20.1": "Как если бы вечером наслаждаясь вкусом,",
 "thag16.5:20.2": "сопровождающего также чувствование;",
 "thag16.5:20.3": "Угасает, не накапливается,",
 "thag16.5:20.4": "так он ведёт памятующий;",
 "thag16.5:20.5": "Так убирающего боль,",
 "thag16.5:20.6": "близко ниббана зовётся.",
 "thag16.5:21.1": "Не очаровывается он касаниями,",
 "thag16.5:21.2": "касание коснувшись памятующим;",
 "thag16.5:21.3": "Без-страстным-умом чувствует,",
 "thag16.5:21.4": "и его не удерживает, не стоит.",
 "thag16.5:22.1": "Как ему касающемуся касание,",
 "thag16.5:22.2": "сопровождающего также чувствование;",
 "thag16.5:22.3": "Угасает, не накапливается,",
 "thag16.5:22.4": "так он ведёт памятующий;",
 "thag16.5:22.5": "Так убирающего боль,",
 "thag16.5:22.6": "близко ниббана зовётся.",
 "thag16.5:23.1": "Не очаровывается он явлениями,",
 "thag16.5:23.2": "явление узнав памятующим;",
 "thag16.5:23.3": "Без-страстным-умом чувствует,",
 "thag16.5:23.4": "и его не удерживает, не стоит.",
 "thag16.5:24.1": "Как у того, понимающего явление,",
 "thag16.5:24.2": "сопровождающего также чувствование;",
 "thag16.5:24.3": "Угасает, не накапливается,",
 "thag16.5:24.4": "так он ведёт памятующий;",
 "thag16.5:24.5": "Так убирающего боль,",
 "thag16.5:24.6": "близко ниббана зовётся”.",
 "thag16.5:24.7": "… Старший монах Малукьяпутта …."
}
