{
 "thag4.6:0.1": "Стихи старших монахов 4.6",
 "thag4.6:0.2": "Четыре строфы",
 "thag4.6:0.3": "Глава первая",
 "thag4.6:0.4": "Стихи старшего монаха Сенаки",
 "thag4.6:1.1": "«О, как хорошо мне было,",
 "thag4.6:1.2": "в Гайе, на празднике Гайи;",
 "thag4.6:1.3": "Когда я увидел Пробуждённого,",
 "thag4.6:1.4": "учащего высочайшему учению.",
 "thag4.6:2.1": "Великого сияния, учителя толпы,",
 "thag4.6:2.2": "достигшего высшего, ведущего;",
 "thag4.6:2.3": "Мира с божествами,",
 "thag4.6:2.4": "победителя с несравненным видением.",
 "thag4.6:3.1": "Великого слона, великого героя,",
 "thag4.6:3.2": "великого света, без истечений;",
 "thag4.6:3.3": "Полностью устранившего все истечения,",
 "thag4.6:3.4": "Учителя, ниоткуда не знающего страха.",
 "thag4.6:4.1": "Меня, долго загрязнённого,",
 "thag4.6:4.2": "связанного путами воззрений;",
 "thag4.6:4.3": "Освободил тот Благословенный,",
 "thag4.6:4.4": "от всех уз — Сенаку».",
 "thag4.6:4.5": "… Старший монах Сенака …."
}
