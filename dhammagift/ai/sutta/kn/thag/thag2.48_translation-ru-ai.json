{
 "thag2.48:0.1": "Стихи старших монахов 2.48",
 "thag2.48:0.2": "Двойное собрание",
 "thag2.48:0.3": "Пятая глава",
 "thag2.48:0.4": "Стихи старшего монаха Вадджиты",
 "thag2.48:1.1": "«Скитание долгое время,",
 "thag2.48:1.2": "в существованиях вращаясь;",
 "thag2.48:1.3": "Не видя благородных истин,",
 "thag2.48:1.4": "слепым обыватель.",
 "thag2.48:2.1": "Мной же, прилежным,",
 "thag2.48:2.2": "из сансары вырвано;",
 "thag2.48:2.3": "Все существования отсечены,",
 "thag2.48:2.4": "отныне нет повторной вовлеченности-[индивидуального] существования”.",
 "thag2.48:2.5": "… Старший монах Вадджита …."
}
