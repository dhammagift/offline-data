{
 "thag6.12:0.1": "Стихи старших монахов 6.12",
 "thag6.12:0.2": "Глава шестых",
 "thag6.12:0.3": "Глава первая",
 "thag6.12:0.4": "Стихи старшего монаха Брахмадатты",
 "thag6.12:1.1": "«У безгневного откуда гнев,",
 "thag6.12:1.2": "у укрощённого, живущего правильно;",
 "thag6.12:1.3": "Правильно-пониманием-высвобождённого,",
 "thag6.12:1.4": "успокоенного, такого.",
 "thag6.12:2.1": "Тем самым тот хуже,",
 "thag6.12:2.2": "кто на разгневанного гневается в ответ;",
 "thag6.12:2.3": "Разгневанному не отвечая гневом,",
 "thag6.12:2.4": "битву выигрывает трудно-выигрываемую.",
 "thag6.12:3.1": "Обоим благу ведёт,",
 "thag6.12:3.2": "себе и другому;",
 "thag6.12:3.3": "Другого разгневанным узнав,",
 "thag6.12:3.4": "кто памятующий успокаивается.",
 "thag6.12:4.1": "Обоих лечащего того,",
 "thag6.12:4.2": "себе и другому;",
 "thag6.12:4.3": "Люди считают глупцом,",
 "thag6.12:4.4": "которые явления не знающие.",
 "thag6.12:5.1": "Возникает если в тебе злость,",
 "thag6.12:5.2": "вспомни пример с пилой;",
 "thag6.12:5.3": "Возникает если к вкусам цепляние,",
 "thag6.12:5.4": "пример с мясом сына помни.",
 "thag6.12:6.1": "Если бежит ум-состояние твой,",
 "thag6.12:6.2": "к желаниям и к бхаве;",
 "thag6.12:6.3": "Быстро сдержи памятованием,",
 "thag6.12:6.4": "как скотину, на поле зашедшую”.",
 "thag6.12:6.5": "… Старший монах Брахмадатта …."
}
