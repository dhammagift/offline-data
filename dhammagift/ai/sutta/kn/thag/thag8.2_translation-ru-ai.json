{
 "thag8.2:0.1": "Стихи старших монахов 8.2",
 "thag8.2:0.2": "Восьмеричная группа",
 "thag8.2:0.3": "Глава первая",
 "thag8.2:0.4": "Стихи старшего монаха Сиримитты",
 "thag8.2:1.1": "«Безгневный, безвраждебный,",
 "thag8.2:1.2": "не-лживым, без-клеветы;",
 "thag8.2:1.3": "Он — такой монах,",
 "thag8.2:1.4": "так уйдя не страдает.",
 "thag8.2:2.1": "Безгневный, безвраждебный,",
 "thag8.2:2.2": "не-лживым, без-клеветы;",
 "thag8.2:2.3": "С охраняемыми вратами всегда монах,",
 "thag8.2:2.4": "так уйдя не страдает.",
 "thag8.2:3.1": "Безгневный, безвраждебный,",
 "thag8.2:3.2": "не-лживым, без-клеветы;",
 "thag8.2:3.3": "С благой нравственностью тот монах,",
 "thag8.2:3.4": "так уйдя не страдает.",
 "thag8.2:4.1": "Безгневный, безвраждебный,",
 "thag8.2:4.2": "не-лживым, без-клеветы;",
 "thag8.2:4.3": "С благим другом тот монах,",
 "thag8.2:4.4": "так уйдя не страдает.",
 "thag8.2:5.1": "Безгневный, безвраждебный,",
 "thag8.2:5.2": "не-лживым, без-клеветы;",
 "thag8.2:5.3": "С благим пониманием тот монах,",
 "thag8.2:5.4": "так уйдя не страдает.",
 "thag8.2:6.1": "У кого вера в Татхагату,",
 "thag8.2:6.2": "непоколебимая, хорошо-установленная;",
 "thag8.2:6.3": "И нравственность у кого благая,",
 "thag8.2:6.4": "благородно-желанная, восхваляемая.",
 "thag8.2:7.1": "В Сангхе доверие у кого есть,",
 "thag8.2:7.2": "и выпрямленное видение;",
 "thag8.2:7.3": "«Не-бедный» так его называют,",
 "thag8.2:7.4": "не-пуста его жизнь.",
 "thag8.2:8.1": "Поэтому веру и нравственность,",
 "thag8.2:8.2": "доверие и видение явлений;",
 "thag8.2:8.3": "Применяйте, мудрые,",
 "thag8.2:8.4": "помня Будд указание”.",
 "thag8.2:8.5": "… старший монах Сиримитта …."
}
