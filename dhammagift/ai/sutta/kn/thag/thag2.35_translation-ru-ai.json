{
 "thag2.35:0.1": "Стихи старших монахов 2.35",
 "thag2.35:0.2": "Двойное собрание",
 "thag2.35:0.3": "Раздел Четвёртый",
 "thag2.35:0.4": "Стихи старшего монаха Самбулакаччаны",
 "thag2.35:1.1": "“Дэва и дождит, дэва и грохочет,",
 "thag2.35:1.2": "Один я в страшной пещере пребываю;",
 "thag2.35:1.3": "Тому мне, одному в страшной пещере пребывающему,",
 "thag2.35:1.4": "Нет ни тревоги, ни оцепенения, ни дрожи.",
 "thag2.35:2.1": "Таков мой закон, которому я,",
 "thag2.35:2.2": "Одному в страшной пещере;",
 "thag2.35:2.3": "Пребывающему нет ни тревоги,",
 "thag2.35:2.4": "Ни оцепенения, ни дрожи”.",
 "thag2.35:2.5": "… Старший монах Самбулакаччана …."
}
