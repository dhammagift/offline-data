{
 "thag1.92:0.1": "Стихи старших монахов 1.92",
 "thag1.92:0.2": "Раздел из одного",
 "thag1.92:0.3": "Десятая глава",
 "thag1.92:0.4": "Стихи старшего монаха Виджаи",
 "thag1.92:1.1": "«У кого истечения истощены,",
 "thag1.92:1.2": "в питании и независим;",
 "thag1.92:1.3": "Пустотное, без-знаковое и,",
 "thag1.92:1.4": "освобождение у которого область;",
 "thag1.92:1.5": "Как в небе птиц,",
 "thag1.92:1.6": "шаг того трудноуловим».",
 "thag1.92:1.7": "… Старший монах Виджая …."
}
