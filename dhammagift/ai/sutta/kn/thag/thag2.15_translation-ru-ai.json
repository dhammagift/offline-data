{
 "thag2.15:0.1": "Стихи старших монахов 2.15",
 "thag2.15:0.2": "Двойное собрание",
 "thag2.15:0.3": "Вторая Глава",
 "thag2.15:0.4": "Стихи старшего монаха Саббамитты",
 "thag2.15:1.1": "“Человек с человеком связан,",
 "thag2.15:1.2": "на человека опирается человек;",
 "thag2.15:1.3": "Человек человеком притесняется,",
 "thag2.15:1.4": "и притесняет человек человека.",
 "thag2.15:2.1": "Какая же ему польза от человека,",
 "thag2.15:2.2": "от человека или от рождённого человеком?",
 "thag2.15:2.3": "Человека оставив, ухожу я,",
 "thag2.15:2.4": "притеснив многих людей”.",
 "thag2.15:2.5": "… Старший монах Саббамитта …."
}
