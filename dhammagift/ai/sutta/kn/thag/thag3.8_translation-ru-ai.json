{
 "thag3.8:0.1": "Стихи старших монахов 3.8",
 "thag3.8:0.2": "Тройной раздел",
 "thag3.8:0.3": "Глава первая",
 "thag3.8:0.4": "Стихи старшего монаха Вассики",
 "thag3.8:1.1": "“Один верующий, мудрый,",
 "thag3.8:1.2": "среди неверующих здесь родственников;",
 "thag3.8:1.3": "Установленный в Дхамме, нравственностью наделенный,",
 "thag3.8:1.4": "является к пользе для близких.",
 "thag3.8:2.1": "Сдерживая из сострадания,",
 "thag3.8:2.2": "побуждены родственники мной;",
 "thag3.8:2.3": "Родственно-близкой любовью,",
 "thag3.8:2.4": "дело сделав среди монахов.",
 "thag3.8:3.1": "Те минувшие, скончавшиеся,",
 "thag3.8:3.2": "достигли те тройного неба приятного;",
 "thag3.8:3.3": "Братья мои и мать,",
 "thag3.8:3.4": "наслаждаются желающие-желания”ти.",
 "thag3.8:3.5": "… старший монах Вассика …."
}
