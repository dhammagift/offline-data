{
 "thag1.46:0.1": "Стихи старших монахов 1.46",
 "thag1.46:0.2": "Раздел из одного",
 "thag1.46:0.3": "Пятая глава",
 "thag1.46:0.4": "Стихи старшего монаха Самиддхи",
 "thag1.46:1.1": "“С верой я продвинулся,",
 "thag1.46:1.2": "Из дома в бездомность;",
 "thag1.46:1.3": "Памятование и понимание во мне выросли,",
 "thag1.46:1.4": "И ум-состояние хорошо сосредоточен;",
 "thag1.46:1.5": "Желание делай объекты-материю,",
 "thag1.46:1.6": "Меня ты не одолеешь”.",
 "thag1.46:1.7": "… Старший монах Самиддхи …."
}
