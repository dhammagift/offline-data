{
 "thag2.30:0.1": "Стихи старших монахов 2.30",
 "thag2.30:0.2": "Двойное собрание",
 "thag2.30:0.3": "Раздел Третий",
 "thag2.30:0.4": "Стихи старшего монаха Канхадинны",
 "thag2.30:1.1": "“Обслужены чистые люди,",
 "thag2.30:1.2": "услышаны явления постоянно;",
 "thag2.30:1.3": "Услышав, я буду практиковать,",
 "thag2.30:1.4": "путь, который имеет Бессмертное своим основанием.",
 "thag2.30:2.1": "У меня, у кого страсть к бхаве убита,",
 "thag2.30:2.2": "страсть к бхаве снова у меня не различается;",
 "thag2.30:2.3": "И не было, и не будет у меня,",
 "thag2.30:2.4": "и у меня сейчас не различается”.",
 "thag2.30:2.5": "… Старший монах Канхадинна …",
 "thag2.30:2.6": "раздел третий.",
 "thag2.30:3.0": "Оглавление",
 "thag2.30:3.1": "Уттара, старший монах Бхаддаджи,",
 "thag2.30:3.2": "Собхита, Валлия провидец;",
 "thag2.30:3.3": "И старший монах Витасока,",
 "thag2.30:3.4": "Пуннамаса и Нандака;",
 "thag2.30:3.5": "Бхарата, Бхарадваджа,",
 "thag2.30:3.6": "Канхадинна, великий мудрец."
}
