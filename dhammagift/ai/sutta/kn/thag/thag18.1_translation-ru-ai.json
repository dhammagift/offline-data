{
 "thag18.1:0.1": "Стихи старших монахов 18.1",
 "thag18.1:0.2": "Сороковая глава",
 "thag18.1:0.3": "Глава первая",
 "thag18.1:0.4": "Стихи старшего монаха Махакассапы",
 "thag18.1:1.1": "“Не с толпой впереди иди,",
 "thag18.1:1.2": "Ум-состояние расстроено, самадхи труднодостижимо;",
 "thag18.1:1.3": "Собрание разных людей — боль,",
 "thag18.1:1.4": "Так увидев, толпу не одобряй.",
 "thag18.1:2.1": "Не к семьям пусть подходит мудрец,",
 "thag18.1:2.2": "Ум-состояние расстроено, самадхи труднодостижимо;",
 "thag18.1:2.3": "Он усердный, к вкусам прилипший,",
 "thag18.1:2.4": "Благо оставляет тот, кто приятное-комфорт приносит.",
 "thag18.1:3.1": "“Грязь” ведь её знают,",
 "thag18.1:3.2": "Это которое почтение-почитание в родах;",
 "thag18.1:3.3": "Тонкая стрела трудно-вынимаемая,",
 "thag18.1:3.4": "Почитание низким человеком трудно оставляемо.",
 "thag18.1:4.1": "С места-пребывания спустившись,",
 "thag18.1:4.2": "в город за подаянием отправился;",
 "thag18.1:4.3": "Едящего человека прокажённого,",
 "thag18.1:4.4": "почтительно того обслужил.",
 "thag18.1:5.1": "Тот мне прокажённой рукой,",
 "thag18.1:5.2": "кусок поднёс;",
 "thag18.1:5.3": "Кусок кладущего,",
 "thag18.1:5.4": "палец здесь отпал.",
 "thag18.1:6.1": "У стены-основания опершись,",
 "thag18.1:6.2": "кусок тот съел;",
 "thag18.1:6.3": "При еде или после еды,",
 "thag18.1:6.4": "отвращения у меня не различается.",
 "thag18.1:7.1": "Собранное подаяние — питание,",
 "thag18.1:7.2": "гнилая моча — лекарство;",
 "thag18.1:7.3": "Место-пребывание — корень дерева,",
 "thag18.1:7.4": "и тряпичная одежда;",
 "thag18.1:7.5": "У кого это преодолев,",
 "thag18.1:7.6": "тот — четырёхсторонний человек.",
 "thag18.1:8.1": "Где некоторые изнуряются,",
 "thag18.1:8.2": "взбираясь на скалу;",
 "thag18.1:8.3": "Того Будды наследник,",
 "thag18.1:8.4": "сознательный, памятующий;",
 "thag18.1:8.5": "Силой чудес поддержанный,",
 "thag18.1:8.6": "Кассапа взбирается.",
 "thag18.1:9.1": "Со сбора подаяния вернувшись,",
 "thag18.1:9.2": "на скалу взобравшись, Кассапа;",
 "thag18.1:9.3": "Зажгётся без-поддерживания,",
 "thag18.1:9.4": "отбросивший тревогу-страх.",
 "thag18.1:10.1": "Со сбора подаяния вернувшись,",
 "thag18.1:10.2": "на скалу взобравшись, Кассапа;",
 "thag18.1:10.3": "Зажгётся без-поддерживания,",
 "thag18.1:10.4": "у сгорающих — угасший.",
 "thag18.1:11.1": "Со сбора подаяния вернувшись,",
 "thag18.1:11.2": "на скалу взобравшись, Кассапа;",
 "thag18.1:11.3": "Зажгётся без-поддерживания,",
 "thag18.1:11.4": "сделавший должное, без истечений.",
 "thag18.1:12.1": "Гирляндами карери расстелены,",
 "thag18.1:12.2": "участки земли восхитительны;",
 "thag18.1:12.3": "Слонами оглашаемые, приятные,",
 "thag18.1:12.4": "те скалы радуют меня.",
 "thag18.1:13.1": "Сине-облачного цвета, красивые,",
 "thag18.1:13.2": "с водой прохладной, с хорошими ручьями;",
 "thag18.1:13.3": "Индагопаками покрытые,",
 "thag18.1:13.4": "те скалы радуют меня.",
 "thag18.1:14.1": "Сине-облачным пикам подобны,",
 "thag18.1:14.2": "лучшим остроконечным зданиям подобны;",
 "thag18.1:14.3": "Слонами оглашаемые, приятные,",
 "thag18.1:14.4": "те скалы радуют меня.",
 "thag18.1:15.1": "Орошённые, с приятными площадками,",
 "thag18.1:15.2": "горы провидцами посещаемы;",
 "thag18.1:15.3": "Оглашаемы павлинами,",
 "thag18.1:15.4": "те скалы радуют меня.",
 "thag18.1:16.1": "Достаточно для желающего зажечься,",
 "thag18.1:16.2": "устремлённого меня памятующего;",
 "thag18.1:16.3": "Достаточно мне, стремящемуся к благу,",
 "thag18.1:16.4": "устремившего себя монаха.",
 "thag18.1:17.1": "Достаточно мне удобства-желающего,",
 "thag18.1:17.2": "устремившего себя монаха;",
 "thag18.1:17.3": "Достаточно мне связи-желающего,",
 "thag18.1:17.4": "устремившего себя такого.",
 "thag18.1:18.1": "С цветком льна подобная,",
 "thag18.1:18.2": "небом-облаками покрытая;",
 "thag18.1:18.3": "Разными птицами-группами наполненная,",
 "thag18.1:18.4": "те скалы радуют меня.",
 "thag18.1:19.1": "Не наполненная домохозяевами,",
 "thag18.1:19.2": "зверей-стадами посещаемая;",
 "thag18.1:19.3": "Разными птицами-группами наполненная,",
 "thag18.1:19.4": "те скалы радуют меня.",
 "thag18.1:20.1": "Чистые, широкие скалы,",
 "thag18.1:20.2": "с дикими козами и обезьянами;",
 "thag18.1:20.3": "покрытая мхом и водорослями,",
 "thag18.1:20.4": "те скалы радуют меня.",
 "thag18.1:21.1": "Не пятичастным музыкальным инструментом,",
 "thag18.1:21.2": "Радость мне бывает такая;",
 "thag18.1:21.3": "Как у однонаправленного ум-состоянием,",
 "thag18.1:21.4": "Правильно явление видящему.",
 "thag18.1:22.1": "Активность многую не заставил бы делать,",
 "thag18.1:22.2": "Избегал бы людей, не усердствуя;",
 "thag18.1:22.3": "Усердный тот вкусов-привязанный,",
 "thag18.1:22.4": "Благо оставляет тот, кто приятное-комфорт приносит.",
 "thag18.1:23.1": "Активность многую не заставил бы делать,",
 "thag18.1:23.2": "Избегал бы не-свойственное-себе это;",
 "thag18.1:23.3": "Трудится тело, устаёт,",
 "thag18.1:23.4": "Испытывающий боль тот равновесия не находит.",
 "thag18.1:24.1": "Губ-ударом-только,",
 "thag18.1:24.2": "себя даже не видит;",
 "thag18.1:24.3": "Напряжённо-шеей ходит,",
 "thag18.1:24.4": "«Я лучший» так думает.",
 "thag18.1:25.1": "Не-лучший лучшему-подобный,",
 "thag18.1:25.2": "глупый думает себя;",
 "thag18.1:25.3": "Того знающие не одобряют,",
 "thag18.1:25.4": "Утверждённый в уме человека.",
 "thag18.1:26.1": "А кто 'я лучше' так,",
 "thag18.1:26.2": "или 'я не лучше';",
 "thag18.1:26.3": "'Хуже' или 'равный' так,",
 "thag18.1:26.4": "в разделениях не колеблется.",
 "thag18.1:27.1": "Понимающего, такого, такового,",
 "thag18.1:27.2": "в принципах хорошо собранного;",
 "thag18.1:27.3": "Равновесие ума непревзойдённое,",
 "thag18.1:27.4": "его знающие восхваляли бы.",
 "thag18.1:28.1": "У которого среди товарищей по святой жизни,",
 "thag18.1:28.2": "достойный уважения не обнаруживается;",
 "thag18.1:28.3": "Далеко он от истинной Дхаммы,",
 "thag18.1:28.4": "с неба земля как.",
 "thag18.1:29.1": "У кого же стыдливость-и-боязнь-совершить-проступок,",
 "thag18.1:29.2": "всегда правильно установленное;",
 "thag18.1:29.3": "Возросшие в святой-жизни те,",
 "thag18.1:29.4": "у тех истощены новые существования.",
 "thag18.1:30.1": "Взбудораженный, неспокойный монах,",
 "thag18.1:30.2": "отбросами одетый;",
 "thag18.1:30.3": "Как обезьяна львиной шкурой,",
 "thag18.1:30.4": "так он тем не украшается.",
 "thag18.1:31.1": "Не взволнованный, не суетливый,",
 "thag18.1:31.2": "рассудительный, сдержанный в способностях;",
 "thag18.1:31.3": "Украшается отбросами,",
 "thag18.1:31.4": "как лев в горной пещере.",
 "thag18.1:32.1": "Эти многие божества,",
 "thag18.1:32.2": "обладающие силой, славные;",
 "thag18.1:32.3": "Десять тысяч божеств,",
 "thag18.1:32.4": "все они из множества Брахмы.",
 "thag18.1:33.1": "Предводителя Дхаммы, героя,",
 "thag18.1:33.2": "великого джхана-медитирующего, собранного;",
 "thag18.1:33.3": "Сарипутту почитая,",
 "thag18.1:33.4": "стоят со сложенными ладонями.",
 "thag18.1:34.1": "‘Почтение тебе, чистокровный человек,",
 "thag18.1:34.2": "почтение тебе, высший человек;",
 "thag18.1:34.3": "Которого мы не знаем,",
 "thag18.1:34.4": "на что полагаясь он зажигается.",
 "thag18.1:35.1": "Удивительны, воистину, пробуждённых",
 "thag18.1:35.2": "глубокой область своя;",
 "thag18.1:35.3": "О которых мы не понимаем,",
 "thag18.1:35.4": "с волосо-пронзателями собравшись’.",
 "thag18.1:36.1": "Того так дэва-телами",
 "thag18.1:36.2": "почитаемого почитания-достойного;",
 "thag18.1:36.3": "Сарипутту тогда увидев,",
 "thag18.1:36.4": "Каппины улыбка была.",
 "thag18.1:37.1": "Среди каких бы то ни было в поле-пробуждённого,",
 "thag18.1:37.2": "поместив великого мудреца;",
 "thag18.1:37.3": "В аскетических-качествах превосходен я,",
 "thag18.1:37.4": "равный мне не различается.",
 "thag18.1:38.1": "Обслужен мной Учитель,",
 "thag18.1:38.2": "исполнено Будды указание;",
 "thag18.1:38.3": "Отложен тяжёлый груз,",
 "thag18.1:38.4": "нет отныне нового [индивидуального] существования.",
 "thag18.1:39.1": "Ни в одеянии, ни в лежанке,",
 "thag18.1:39.2": "в еде не пятнается;",
 "thag18.1:39.3": "Готама неизмеримый,",
 "thag18.1:39.4": "как лотоса-цветок без пятен;",
 "thag18.1:39.5": "Водой к отречению-склонённый,",
 "thag18.1:39.6": "из тройного-существования вышедший.",
 "thag18.1:40.1": "Установление-памятования-шея та,",
 "thag18.1:40.2": "вера-рука, великий мудрец;",
 "thag18.1:40.3": "С пониманием-головой, великий-знанием,",
 "thag18.1:40.4": "всегда ведёт успокоенный”.",
 "thag18.1:40.5": "… Махаккассапа Тхера …",
 "thag18.1:40.6": "Сороковая глава установлена.",
 "thag18.1:41.0": "Там сводка",
 "thag18.1:41.1": "В Сороковой главе,",
 "thag18.1:41.2": "Махаккассапой называемый;",
 "thag18.1:41.3": "Один старший монах стихи,",
 "thag18.1:41.4": "сорок и два также."
}
