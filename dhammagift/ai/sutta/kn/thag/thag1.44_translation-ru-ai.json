{
 "thag1.44:0.1": "Стихи старших монахов 1.44",
 "thag1.44:0.2": "Раздел из одного",
 "thag1.44:0.3": "Пятая глава",
 "thag1.44:0.4": "Стихи старшего монаха Сануты",
 "thag1.44:1.1": "“Мёртвого, мама, оплакивают,",
 "thag1.44:1.2": "Который — жизнь — не видна;",
 "thag1.44:1.3": "Живущего меня, мама, видят,",
 "thag1.44:1.4": "Почему меня, мама, оплакиваешь?”",
 "thag1.44:1.5": "… Старший монах Санута …."
}
