{
 "thag1.71:0.1": "Стихи старших монахов 1.71",
 "thag1.71:0.2": "Раздел из одного",
 "thag1.71:0.3": "Восьмая глава",
 "thag1.71:0.4": "Стих старшего монаха Ваччхапалы",
 "thag1.71:1.1": "“Тем, кто видит тонкий, искусный смысл,",
 "thag1.71:1.2": "Умелым в размышлении, скромным в поведении;",
 "thag1.71:1.3": "Связанным с нравственностью старших,",
 "thag1.71:1.4": "Ниббана, поистине, не трудна для достижения”.",
 "thag1.71:1.5": "… Старший монах Ваччхапала …."
}
