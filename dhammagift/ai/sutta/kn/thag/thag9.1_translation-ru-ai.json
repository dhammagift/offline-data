{
 "thag9.1:0.1": "Стихи старших монахов 9.1",
 "thag9.1:0.2": "Девятка",
 "thag9.1:0.3": "Глава первая",
 "thag9.1:0.4": "Стихи старшего монаха Бхуты",
 "thag9.1:1.1": "«Когда боль, старение-умирание — мудрец,",
 "thag9.1:1.2": "Невежды где прицеплены обыватели;",
 "thag9.1:1.3": "Боль для полного понимания только памятуя зажжётся,",
 "thag9.1:1.4": "От того радости высшей не находит.",
 "thag9.1:2.1": "Когда боле-приносящую липкость,",
 "thag9.1:2.2": "Разрастание-соединение-боль-ведущую;",
 "thag9.1:2.3": "Цепляние отбросив только памятуя зажжётся,",
 "thag9.1:2.4": "От того радости высшей не находит.",
 "thag9.1:3.1": "Когда благой дву-четырёх-аспектно-идущий,",
 "thag9.1:3.2": "Путь высший всех загрязнений очищение;",
 "thag9.1:3.3": "Пониманием увидев только памятуя зажжётся,",
 "thag9.1:3.4": "От того радости высшей не находит.",
 "thag9.1:4.1": "Когда без-страданий без-пыльное не-составное,",
 "thag9.1:4.2": "Присутствующий метод всех загрязнений очищение;",
 "thag9.1:4.3": "Развивает связанности-связи-разрубающее,",
 "thag9.1:4.4": "От того радости высшей не находит.",
 "thag9.1:5.1": "Когда в небе грохочет туча-гром,",
 "thag9.1:5.2": "Потоком-покрыто птиц-пути отовсюду;",
 "thag9.1:5.3": "И монах в пещеру-ушедший зажжётся,",
 "thag9.1:5.4": "От того радости высшей не находит.",
 "thag9.1:6.1": "Когда рек цветами-покрытых,",
 "thag9.1:6.2": "Разноцветно-лесных-венков;",
 "thag9.1:6.3": "На берегу сидящий счастливо-умом зажжётся,",
 "thag9.1:6.4": "От того радости высшей не находит.",
 "thag9.1:7.1": "Когда в полночь в уединённом лесу,",
 "thag9.1:7.2": "Дэвы капающем рычат клыкастые;",
 "thag9.1:7.3": "И монах в пещеру-ушедший зажжётся,",
 "thag9.1:7.4": "От того радости высшей не находит.",
 "thag9.1:8.1": "Когда рассуждения сдерживает свои,",
 "thag9.1:8.2": "В ущелье горы, в горной расселине опершись;",
 "thag9.1:8.3": "Без страха, без суеты зажжён,",
 "thag9.1:8.4": "От того радости высшей не находит.",
 "thag9.1:9.1": "Когда счастливый, пятно-суету-страдание-устраняющий,",
 "thag9.1:9.2": "Без засова, без зарослей, без стрелы;",
 "thag9.1:9.3": "Все истечения устранив, зажжён,",
 "thag9.1:9.4": "Тогда радости высочайшей не находит”.",
 "thag9.1:9.5": "… Старший монах Бхута …",
 "thag9.1:9.6": "Девять строф установлены.",
 "thag9.1:10.0": "Там сводка",
 "thag9.1:10.1": "Старший монах Бхута, так-видящий,",
 "thag9.1:10.2": "один, как рог носорога;",
 "thag9.1:10.3": "В девяти строфах,",
 "thag9.1:10.4": "стихов этих девять."
}
