{
 "thag1.20:0.1": "Стихи старших монахов 1.20",
 "thag1.20:0.2": "Раздел из одного",
 "thag1.20:0.3": "Вторая Глава",
 "thag1.20:0.4": "Стихи старшего монаха Аджиты",
 "thag1.20:1.1": "“В умирании мне тревоги нет,",
 "thag1.20:1.2": "привязанности нет к жизни;",
 "thag1.20:1.3": "Сомнение я отброшу,",
 "thag1.20:1.4": "сознательный, памятующий”.",
 "thag1.20:1.5": "… Старший монах Аджита …",
 "thag1.20:1.6": "глава вторая.",
 "thag1.20:2.0": "Оглавление",
 "thag1.20:2.1": "Чулаваччхо, Махаваччхо,",
 "thag1.20:2.2": "Ванаваччхо и Сивако;",
 "thag1.20:2.3": "Кундадхано и Белаттхи,",
 "thag1.20:2.4": "Дасако и сверх того;",
 "thag1.20:2.5": "Старший монах Сингалапитико,",
 "thag1.20:2.6": "Куло и Аджита — десять."
}
