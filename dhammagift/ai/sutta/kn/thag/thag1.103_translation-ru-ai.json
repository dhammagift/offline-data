{
 "thag1.103:0.1": "Стихи старших монахов 1.103",
 "thag1.103:0.2": "Раздел из одного",
 "thag1.103:0.3": "Глава одиннадцатая",
 "thag1.103:0.4": "Стихи старшего монаха Бандхуры",
 "thag1.103:1.1": "«Я в этом не нуждаюсь,",
 "thag1.103:1.2": "Счастливый, вкусом Дхаммы насыщенный;",
 "thag1.103:1.3": "Испив высочайший превосходный вкус,",
 "thag1.103:1.4": "Не буду я с ядом дружбу водить».",
 "thag1.103:1.5": "… Старший монах Бандхура …."
}
