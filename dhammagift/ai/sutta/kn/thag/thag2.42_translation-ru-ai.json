{
 "thag2.42:0.1": "Стихи старших монахов 2.42",
 "thag2.42:0.2": "Двойное собрание",
 "thag2.42:0.3": "Пятая глава",
 "thag2.42:0.4": "Стихи старшего монаха Дхаммапалы",
 "thag2.42:1.1": "“Кто, поистине, молодой монах,",
 "thag2.42:1.2": "занимается в учении Пробуждённого;",
 "thag2.42:1.3": "Бодрствующий — он среди спящих,",
 "thag2.42:1.4": "не-пуста его жизнь.",
 "thag2.42:2.1": "Поэтому веру и нравственность,",
 "thag2.42:2.2": "доверие и видение явлений;",
 "thag2.42:2.3": "Применяйте, мудрые,",
 "thag2.42:2.4": "помня Будд указание”.",
 "thag2.42:2.5": "… старший монах Дхаммапала …."
}
