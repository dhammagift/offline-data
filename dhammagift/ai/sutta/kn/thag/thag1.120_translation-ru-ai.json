{
 "thag1.120:0.1": "Стихи старших монахов 1.120",
 "thag1.120:0.2": "Раздел из одного",
 "thag1.120:0.3": "Двенадцатый раздел",
 "thag1.120:0.4": "Стихи старшего монаха Исидатты",
 "thag1.120:1.1": "«Пять блоков всесторонне поняты,",
 "thag1.120:1.2": "стоят с отрезанным корнем;",
 "thag1.120:1.3": "Боле-исчерпание достигнуто,",
 "thag1.120:1.4": "достигнуто мной исчерпание истечений».",
 "thag1.120:1.5": "… Старший монах Исидатта …",
 "thag1.120:1.6": "Глава двенадцатая.",
 "thag1.120:2.0": "Оглавление",
 "thag1.120:2.1": "Джента и Ваччхаготта,",
 "thag1.120:2.2": "Ваччха и Ванасавхая;",
 "thag1.120:2.3": "Адхимутта, Маханама,",
 "thag1.120:2.4": "Парапария и Яса;",
 "thag1.120:2.5": "Кимила, Вадджипутта,",
 "thag1.120:2.6": "Исидатта великой славы.",
 "thag1.120:2.7": "Первая часть завершена.",
 "thag1.120:3.0": "Там сводка",
 "thag1.120:3.1": "Сто двадцать старших монахов,",
 "thag1.120:3.2": "сделавшие дело, без истечений;",
 "thag1.120:3.3": "В одном-единственном разделе,",
 "thag1.120:3.4": "хорошо спетые великими провидцами."
}
