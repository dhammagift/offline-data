{
 "thag2.3:0.1": "Стихи старших монахов 2.3",
 "thag2.3:0.2": "Двойное собрание",
 "thag2.3:0.3": "Глава первая",
 "thag2.3:0.4": "Стихи старшего монаха Валлии",
 "thag2.3:1.1": "“Обезьяна в пятидверной",
 "thag2.3:1.2": "хижине, заскочив;",
 "thag2.3:1.3": "через дверь обходит,",
 "thag2.3:1.4": "ударяя снова и снова.",
 "thag2.3:2.1": "Стой, обезьяна, не беги,",
 "thag2.3:2.2": "ведь тебе не так, как прежде;",
 "thag2.3:2.3": "схвачен ты пониманием,",
 "thag2.3:2.4": "далеко не уйдёшь”.",
 "thag2.3:2.5": "… Старший монах Валлия …."
}
