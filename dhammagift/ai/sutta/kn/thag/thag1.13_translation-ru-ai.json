{
 "thag1.13:0.1": "Стихи старших монахов 1.13",
 "thag1.13:0.2": "Раздел из одного",
 "thag1.13:0.3": "Вторая Глава",
 "thag1.13:0.4": "Стих старшего монаха Ванаваччхи",
 "thag1.13:1.1": "“Цвета сизых облаков, прекрасные,",
 "thag1.13:1.2": "с прохладной водой, чистой;",
 "thag1.13:1.3": "Индагопаками покрытые,",
 "thag1.13:1.4": "те скалы радуют ум”.",
 "thag1.13:1.5": "… Старший монах Ванаваччха …."
