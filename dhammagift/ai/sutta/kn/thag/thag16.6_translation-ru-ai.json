{
 "thag16.6:0.1": "Стихи старших монахов 16.6",
 "thag16.6:0.2": "Двадцати-глава",
 "thag16.6:0.3": "Глава первая",
 "thag16.6:0.4": "Стихи старшего монаха Селы",
 "thag16.6:1.1": "“Полнотелый, прекрасный видом,",
 "thag16.6:1.2": "Благороднорождённый, приятно-выглядящий;",
 "thag16.6:1.3": "Золотого цвета ты, Благословенный,",
 "thag16.6:1.4": "С белоснежными зубами, решительный.",
 "thag16.6:2.1": "У человека ведь благороднорождённого,",
 "thag16.6:2.2": "какие бывают признаки;",
 "thag16.6:2.3": "Все они в твоём теле,",
 "thag16.6:2.4": "знаки великого человека.",
 "thag16.6:3.1": "С ясными глазами, с приятным лицом,",
 "thag16.6:3.2": "Величественный, прямой, сияющий;",
 "thag16.6:3.3": "В середине собрания шраманов,",
 "thag16.6:3.4": "Как солнце сияешь.",
 "thag16.6:4.1": "Благого вида монах,",
 "thag16.6:4.2": "С кожей подобной золоту;",
 "thag16.6:4.3": "Что тебе в состоянии шрамана,",
 "thag16.6:4.4": "Так высшей-красоты.",
 "thag16.6:5.1": "Царём достоин быть,",
 "thag16.6:5.2": "колесо-вращающим, колесничным-господином;",
 "thag16.6:5.3": "Четырёх-концов победителем,",
 "thag16.6:5.4": "розового-дерева-рощи владыкой.",
 "thag16.6:6.1": "Кшатрии, владельцы, цари,",
 "thag16.6:6.2": "подчинёнными становятся те;",
 "thag16.6:6.3": "Царь-над-царями, людей-владыка,",
 "thag16.6:6.4": "царствование осуществляй, Готама”.",
 "thag16.6:7.1": "«Царь я, Села,",
 "thag16.6:7.2": "(Села — Благословенный)",
 "thag16.6:7.3": "Царь Дхаммы, непревзойдённый;",
 "thag16.6:7.4": "Законом колесо вращаю,",
 "thag16.6:7.5": "Колесо необратимое”.",
 "thag16.6:8.1": "“Пробуждённым признаёшь себя,",
 "thag16.6:8.2": "(так брахман Села)",
 "thag16.6:8.3": "Царь Дхаммы, непревзойдённый;",
 "thag16.6:8.4": "‘Законом колесо вращаю’,",
 "thag16.6:8.5": "Так говорите, Готама.",
 "thag16.6:9.1": "Кто же военачальник уважаемого,",
 "thag16.6:9.2": "последователь, Учителю-последующий;",
 "thag16.6:9.3": "Кто тебя-вот-следует,",
 "thag16.6:9.4": "колесо Учения приведённое-в-движение”.",
 "thag16.6:10.1": "“Мной приведённое-в-движение колесо,",
 "thag16.6:10.2": "(Села — Благословенный)",
 "thag16.6:10.3": "колесо Учения непревзойдённое;",
 "thag16.6:10.4": "Сарипутта следует",
 "thag16.6:10.5": "Рождённый вслед Татхагате.",
 "thag16.6:11.1": "Должное-быть-опознанным опознано,",
 "thag16.6:11.2": "должное-быть-развито развито;",
 "thag16.6:11.3": "Должное-быть-покинуто покинуто мной,",
 "thag16.6:11.4": "потому пробуждённый я, брахман.",
 "thag16.6:12.1": "Устрани во мне сомнение,",
 "thag16.6:12.2": "доверься, брахман;",
 "thag16.6:12.3": "Редкостно видение бывает,",
 "thag16.6:12.4": "полностью пробуждённых часто.",
 "thag16.6:13.1": "Которых ведь редкостен в мире,",
 "thag16.6:13.2": "проявление часто;",
 "thag16.6:13.3": "(Тот) я, брахман, пробуждённым стал,",
 "thag16.6:13.4": "хирург непревзойдённый.",
 "thag16.6:14.1": "Ставшим-Брахмой, несравненным,",
 "thag16.6:14.2": "войско Мары подавляющим;",
 "thag16.6:14.3": "Всех недругов подчинив,",
 "thag16.6:14.4": "радуюсь ниоткуда-не-боящийся”.",
 "thag16.6:15.1": "«Это, уважаемые, послушайте,",
 "thag16.6:15.2": "как говорит обладающий-глазом;",
 "thag16.6:15.3": "Хирург, великий герой,",
 "thag16.6:15.4": "словно лев рычит в лесу.",
 "thag16.6:16.1": "Ставшим-Брахмой, несравненным,",
 "thag16.6:16.2": "войско Мары подавляющим;",
 "thag16.6:16.3": "Кто, увидев, не возрадуется,",
 "thag16.6:16.4": "даже темнорождённый.",
 "thag16.6:17.1": "Кто меня хочет — пусть следует,",
 "thag16.6:17.2": "кто же не хочет — пусть идёт;",
 "thag16.6:17.3": "Здесь я уйду в бездомность,",
 "thag16.6:17.4": "вблизи высшего-понимания”.",
 "thag16.6:18.1": "“И если это нравится почтенному,",
 "thag16.6:18.2": "правильно-пробуждённого учение;",
 "thag16.6:18.3": "Мы тоже уйдём в бездомность,",
 "thag16.6:18.4": "вблизи высшего-понимания”.",
 "thag16.6:19.1": "«Брахманов триста этих,",
 "thag16.6:19.2": "просят со сложенными ладонями;",
 "thag16.6:19.3": "«Святую жизнь вести будем,",
 "thag16.6:19.4": "Благословенный, вблизи тебя».",
 "thag16.6:20.1": "“Хорошо-сформулирована святая жизнь,",
 "thag16.6:20.2": "(Села — Благословенный)",
 "thag16.6:20.3": "В-видимой-действительности-постижимое, вневременное;",
 "thag16.6:20.4": "Где не напрасен уход в бездомность,",
 "thag16.6:20.5": "Усердного, тренирующегося».",
 "thag16.6:21.1": "“К тому прибежищу пришли мы,",
 "thag16.6:21.2": "от этого восьмой, зрячий;",
 "thag16.6:21.3": "За семь ночей Благословенный,",
 "thag16.6:21.4": "укрощены мы в твоём учении.",
 "thag16.6:22.1": "Ты пробуждённый, ты Учитель,",
 "thag16.6:22.2": "ты Мары-одолевающий мудрец;",
 "thag16.6:22.3": "Ты предрасположенности отсек,",
 "thag16.6:22.4": "переплыв, переправляешь это поколение.",
 "thag16.6:23.1": "Удержания тобой превзойдены,",
 "thag16.6:23.2": "истечения тобой сокрушены;",
 "thag16.6:23.3": "Как лев, без подпитки,",
 "thag16.6:23.4": "отбросивший тревогу-страх.",
 "thag16.6:24.1": "Триста монахов этих,",
 "thag16.6:24.2": "стоят со сложенными ладонями;",
 "thag16.6:24.3": "Ноги, герой, простирай,",
 "thag16.6:24.4": "слоны пусть почтят Учителя”.",
 "thag16.6:24.5": "… Старший монах Села …."
}
