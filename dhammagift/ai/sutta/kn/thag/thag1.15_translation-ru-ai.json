{
 "thag1.15:0.1": "Стихи старших монахов 1.15",
 "thag1.15:0.2": "Раздел из одного",
 "thag1.15:0.3": "Вторая Глава",
 "thag1.15:0.4": "Стихи старшего монаха Кундадханы",
 "thag1.15:1.1": "“Пять отсечь, пять отбросить,",
 "thag1.15:1.2": "пять сверх того развивать;",
 "thag1.15:1.3": "Пять завязки-превозшедший монах,",
 "thag1.15:1.4": "затопление-переплывшим говорится”.",
 "thag1.15:1.5": "… старший монах Кундадхана …."
}
