{
 "thag1.109:0.1": "Стихи старших монахов 1.109",
 "thag1.109:0.2": "Раздел из одного",
 "thag1.109:0.3": "Глава одиннадцатая",
 "thag1.109:0.4": "Стихи старшего монаха Сангхараккхиты",
 "thag1.109:1.1": "“Не, поистине, этот высочайшего блага сострадающего,",
 "thag1.109:1.2": "Уединённый обдумывает Учение;",
 "thag1.109:1.3": "Так ведь этот пребывает с раскрытыми способностями,",
 "thag1.109:1.4": "Как лань с детёнышем в лесу”.",
 "thag1.109:1.5": "… Старший монах Сангхараккхита …."
}
