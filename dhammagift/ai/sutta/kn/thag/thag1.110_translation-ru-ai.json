{
 "thag1.110:0.1": "Стихи старших монахов 1.110",
 "thag1.110:0.2": "Раздел из одного",
 "thag1.110:0.3": "Глава одиннадцатая",
 "thag1.110:0.4": "Стихи старшего монаха Усабхи",
 "thag1.110:1.1": "“Деревья на вершинах гор хорошо разрослись,",
 "thag1.110:1.2": "Орошённые свежей большой тучей;",
 "thag1.110:1.3": "Стремящемуся к уединению, сознающему лес,",
 "thag1.110:1.4": "Порождает больше блага быка”.",
 "thag1.110:1.5": "… Старший монах Усабха …",
 "thag1.110:1.6": "глава одиннадцатая.",
 "thag1.110:2.0": "Оглавление",
 "thag1.110:2.1": "Белаттханика, Сетуччха,",
 "thag1.110:2.2": "Бандхура, Кхитака провидец;",
 "thag1.110:2.3": "Малитавамбха, Сухеманта,",
 "thag1.110:2.4": "Дхаммасава, Дхаммасавапита;",
 "thag1.110:2.5": "Старший монах Сангхараккхита,",
 "thag1.110:2.6": "И Усабха — великий мудрец."
}
