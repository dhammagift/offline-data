{
 "thag1.69:0.1": "Стихи старших монахов 1.69",
 "thag1.69:0.2": "Раздел из одного",
 "thag1.69:0.3": "Седьмой раздел",
 "thag1.69:0.4": "Стихи старшего монаха Чханны",
 "thag1.69:1.1": "“Услышав явление великого велико-вкуса,",
 "thag1.69:1.2": "Всезнающим знанием-лучшим указанное;",
 "thag1.69:1.3": "На путь я вступил бессмертного достижения,",
 "thag1.69:1.4": "Он от-связи-защиты пути сведущий”.",
 "thag1.69:1.5": "… Старший монах Чханна …."
}
