{
 "thag20.1:0.1": "Стихи старших монахов 20.1",
 "thag20.1:0.2": "Раздел шестидесяти",
 "thag20.1:0.3": "Глава первая",
 "thag20.1:0.4": "Стихи старшего монаха Махамоггалланы",
 "thag20.1:1.1": "«Лесные, живущие подаянием,",
 "thag20.1:1.2": "в собирании-милостыни радующиеся;",
 "thag20.1:1.3": "Сломаем смерти войско,",
 "thag20.1:1.4": "внутри хорошо-сосредоточенные.",
 "thag20.1:2.1": "Лесные, живущие подаянием,",
 "thag20.1:2.2": "в собирании-милостыни радующиеся;",
 "thag20.1:2.3": "Стряхнём смерти войско,",
 "thag20.1:2.4": "как тростниковый дом — слон.",
 "thag20.1:3.1": "У корней деревьев живущие, постоянные,",
 "thag20.1:3.2": "в собирании-милостыни радующиеся;",
 "thag20.1:3.3": "Сломаем смерти войско,",
 "thag20.1:3.4": "внутри хорошо-сосредоточенные.",
 "thag20.1:4.1": "У корней деревьев живущие, постоянные,",
 "thag20.1:4.2": "в собирании-милостыни радующиеся;",
 "thag20.1:4.3": "Стряхнём смерти войско,",
 "thag20.1:4.4": "как тростниковый дом — слон».",
 "thag20.1:5.1": "«Из костей-скелета хижина,",
 "thag20.1:5.2": "плотью-сухожилиями сшитая;",
 "thag20.1:5.3": "Проклятие телу, вонючему,",
 "thag20.1:5.4": "в чужом теле себя-воображающему.",
 "thag20.1:6.1": "В нечистоты-мешок кожей-обтянутый,",
 "thag20.1:6.2": "с-опухолями-на-шее, демоница;",
 "thag20.1:6.3": "Девять потоков в твоём теле,",
 "thag20.1:6.4": "которые текут постоянно.",
 "thag20.1:7.1": "Твоё тело — девяти-потоков,",
 "thag20.1:7.2": "вонь-производящее, грязное;",
 "thag20.1:7.3": "Монах избегает его,",
 "thag20.1:7.4": "как нечистоты — желающий-чистоты.",
 "thag20.1:8.1": "Если бы так тебя люди знали,",
 "thag20.1:8.2": "как знаю тебя я;",
 "thag20.1:8.3": "Издали бы обходил,",
 "thag20.1:8.4": "как выгребная яма в сезон дождей”.",
 "thag20.1:9.1": "“Так это, великий герой,",
 "thag20.1:9.2": "как ты, шраман, говоришь;",
 "thag20.1:9.3": "В этом некоторые увязают,",
 "thag20.1:9.4": "как в болоте старый бык”.",
 "thag20.1:10.1": "“В небе куркумой,",
 "thag20.1:10.2": "кто бы подумал покрасить;",
 "thag20.1:10.3": "Или другой краской,",
 "thag20.1:10.4": "это лишь к расстройству ведёт.",
 "thag20.1:11.1": "Тот ум, подобный небу,",
 "thag20.1:11.2": "внутренне хорошо объединён;",
 "thag20.1:11.3": "Не нападай на плохой ум,",
 "thag20.1:11.4": "как птица на груду огня”.",
 "thag20.1:12.1": "“Узри разукрашенный образ,",
 "thag20.1:12.2": "тело из ран составленное;",
 "thag20.1:12.3": "Больное, многоустремлённое,",
 "thag20.1:12.4": "у которого нет постоянного пребывания.",
 "thag20.1:13.1": "Узри разукрашенную форму,",
 "thag20.1:13.2": "жемчужиной и серьгой;",
 "thag20.1:13.3": "Кость кожей обтянута,",
 "thag20.1:13.4": "с одеждами красуется.",
 "thag20.1:14.1": "Лаком покрыты ступни,",
 "thag20.1:14.2": "лицо пудрой намазано;",
 "thag20.1:14.3": "Достаточно для обмана незрелого,",
 "thag20.1:14.4": "но не ищущего запредельного.",
 "thag20.1:15.1": "Восьмичастно сделанные волосы,",
 "thag20.1:15.2": "глаза сурьмой намазаны;",
 "thag20.1:15.3": "Достаточно для обмана незрелого,",
 "thag20.1:15.4": "но не ищущего запредельного.",
 "thag20.1:16.1": "Словно новая расписная шкатулка,",
 "thag20.1:16.2": "гнилое тело украшено;",
 "thag20.1:16.3": "Достаточно для обмана незрелого,",
 "thag20.1:16.4": "но не ищущего запредельного.",
 "thag20.1:17.1": "Охотник расставил ловушку,",
 "thag20.1:17.2": "не попался в силок олень;",
 "thag20.1:17.3": "Поев приманку, уходим,",
 "thag20.1:17.4": "тащат охотники на оленей.",
 "thag20.1:18.1": "Перерезана петля оленя,",
 "thag20.1:18.2": "не попался в силок олень;",
 "thag20.1:18.3": "Поев приманку, уходим,",
 "thag20.1:18.4": "горюют охотники на оленей”.",
 "thag20.1:19.1": "«Тогда было то, что ужасающе,",
 "thag20.1:19.2": "тогда было волосы дыбом поднимающее;",
 "thag20.1:19.3": "Наделённого многими видами,",
 "thag20.1:19.4": "в Сарипутте угасшем.",
 "thag20.1:20.1": "Ненадёжны, поистине, отождествления,",
 "thag20.1:20.2": "возникновение-исчезновение-имеющие;",
 "thag20.1:20.3": "Возникнув, прекращаются,",
 "thag20.1:20.4": "их выравнивание приятно-комфортно.",
 "thag20.1:21.1": "Тонкое они проникают,",
 "thag20.1:21.2": "как стрелой волосок;",
 "thag20.1:21.3": "Которые пять блоков видят,",
 "thag20.1:21.4": "как чужое, а не как себя.",
 "thag20.1:22.1": "И которые видят составляющие,",
 "thag20.1:22.2": "как чужое, а не как себя;",
 "thag20.1:22.3": "Постигли утончённое,",
 "thag20.1:22.4": "как стрелой волосок.",
 "thag20.1:23.1": "Как копьём пронзённый,",
 "thag20.1:23.2": "сгорающий на макушке;",
 "thag20.1:23.3": "Для покидания желания-страсти,",
 "thag20.1:23.4": "памятующий монах пусть странствует.",
 "thag20.1:24.1": "Как копьём пронзённый,",
 "thag20.1:24.2": "сгорающий на макушке;",
 "thag20.1:24.3": "Для покидания бхава-страсти,",
 "thag20.1:24.4": "памятующий монах пусть странствует.",
 "thag20.1:25.1": "Побуждаемый развитым-собой,",
 "thag20.1:25.2": "несущим последнее тело;",
 "thag20.1:25.3": "Дворец матери Мигары,",
 "thag20.1:25.4": "пальцем ноги пошевелил.",
 "thag20.1:26.1": "Не это, начатое слабо,",
 "thag20.1:26.2": "не через малость силы;",
 "thag20.1:26.3": "Ниббана должна быть достигнута,",
 "thag20.1:26.4": "всех уз освобождение.",
 "thag20.1:27.1": "И этот молодой монах,",
 "thag20.1:27.2": "этот высший человек;",
 "thag20.1:27.3": "Несёт последнее тело,",
 "thag20.1:27.4": "победив Мару с его свитой.",
 "thag20.1:28.1": "В расщелину проникают молнии,",
 "thag20.1:28.2": "Вебары и Пандавы;",
 "thag20.1:28.3": "В горную расщелину ушедший зажёгся,",
 "thag20.1:28.4": "Сын несравненного такого.",
 "thag20.1:29.1": "Успокоенный, утихший,",
 "thag20.1:29.2": "в уединённом обиталище мудрец;",
 "thag20.1:29.3": "Наследник высшего из пробуждённых,",
 "thag20.1:29.4": "Брахмой почитаемый”.",
 "thag20.1:30.1": "“Успокоенного, утихшего,",
 "thag20.1:30.2": "в уединённом обиталище мудреца;",
 "thag20.1:30.3": "Наследника высшего из пробуждённых,",
 "thag20.1:30.4": "чти, брахман, Кассапу.",
 "thag20.1:31.1": "И кто сто рождений прошёл бы,",
 "thag20.1:31.2": "все брахманские рождения;",
 "thag20.1:31.3": "Соттийо, ведами совершенный,",
 "thag20.1:31.4": "среди людей снова и снова.",
 "thag20.1:32.1": "И если бы он был декламатором,",
 "thag20.1:32.2": "трех вед достигший предела;",
 "thag20.1:32.3": "Это его почитание",
 "thag20.1:32.4": "не стоит и шестнадцатой части.",
 "thag20.1:33.1": "Кто те восемь освобождений",
 "thag20.1:33.2": "до полудня проявил;",
 "thag20.1:33.3": "Прямым порядком, обратным порядком,",
 "thag20.1:33.4": "затем за подаянием идет.",
 "thag20.1:34.1": "Такого монаха не презирай,",
 "thag20.1:34.2": "себя не губи, брахман;",
 "thag20.1:34.3": "Ум-представление направь на веру,",
 "thag20.1:34.4": "в араханте, таком;",
 "thag20.1:34.5": "Быстро, сложив ладони, поклонись,",
 "thag20.1:34.6": "чтобы тебе не раскололо голову”.",
 "thag20.1:35.1": "“Этот не видит истинного учения,",
 "thag20.1:35.2": "скитанием окруженный;",
 "thag20.1:35.3": "Нисходящий, кривой путь,",
 "thag20.1:35.4": "ложный путь преследует.",
 "thag20.1:36.1": "Словно червь, испражнениями измазанный,",
 "thag20.1:36.2": "в составляющих застывший;",
 "thag20.1:36.3": "Погрязший в обретении-и-почитании,",
 "thag20.1:36.4": "пустой идет Поттхило”.",
 "thag20.1:37.1": "“И этого узри приходящим,",
 "thag20.1:37.2": "Сарипутту, прекрасного видом;",
 "thag20.1:37.3": "Освобожденного с обеих сторон,",
 "thag20.1:37.4": "внутри хорошо-объединённого.",
 "thag20.1:38.1": "Без-стрела, с разрушенными связями,",
 "thag20.1:38.2": "тройное знание, смерть-превзошедший;",
 "thag20.1:38.3": "Достойного-даров среди людей,",
 "thag20.1:38.4": "поле блага непревзойденное”.",
 "thag20.1:39.1": "“Эти многие дэвы,",
 "thag20.1:39.2": "обладающие силой, славные;",
 "thag20.1:39.3": "Десять тысяч дэвов,",
 "thag20.1:39.4": "все — брахма-приближенные;",
 "thag20.1:39.5": "Моггаллану почитая,",
 "thag20.1:39.6": "стоят со сложенными ладонями.",
 "thag20.1:40.1": "‘Почтение тебе, чистокровный человек,",
 "thag20.1:40.2": "почтение тебе, высший человек;",
 "thag20.1:40.3": "У кого эти истечения разрушены,",
 "thag20.1:40.4": "достойный-даров ты, почтенный’.",
 "thag20.1:41.1": "Почитаемый людьми и дэвами,",
 "thag20.1:41.2": "возникший, смерть-преодолевающий;",
 "thag20.1:41.3": "Как белый лотос водой,",
 "thag20.1:41.4": "составляющими не пачкается.",
 "thag20.1:42.1": "Кто мгновением тысячечастный мир,",
 "thag20.1:42.2": "обозрел, с миром Брахмы каппой владел;",
 "thag20.1:42.3": "В силе-качествах, в смерти-перерождении, во времени,",
 "thag20.1:42.4": "видит дэвов тот монах”.",
 "thag20.1:43.1": "“Сарипутта в понимании,",
 "thag20.1:43.2": "нравственностью и успокоением;",
 "thag20.1:43.3": "Какой бы ни был достигший-того-берега монах,",
 "thag20.1:43.4": "этим-высшим пусть будет.",
 "thag20.1:44.1": "Коти сто тысяч,",
 "thag20.1:44.2": "Само-существование мгновением создаю;",
 "thag20.1:44.3": "Я в превращениях умел,",
 "thag20.1:44.4": "Владеющим стал я в сверх-силе.",
 "thag20.1:45.1": "Самадхи-знания-владения-парамиты достигший,",
 "thag20.1:45.2": "Моггаллана-готра, Аситы в учении;",
 "thag20.1:45.3": "Знаток отсек, собравший способности,",
 "thag20.1:45.4": "Слон как гнилую лиану — привязь.",
 "thag20.1:46.1": "Обслужен мной Учитель,",
 "thag20.1:46.2": "исполнено Будды указание;",
 "thag20.1:46.3": "Отложен тяжёлый груз,",
 "thag20.1:46.4": "с проводником к индивидуальному существованию покончено.",
 "thag20.1:47.1": "Ради какой цели покинул жизнь,",
 "thag20.1:47.2": "из дома в бездомность;",
 "thag20.1:47.3": "Эта цель мной достигнута,",
 "thag20.1:47.4": "всех связываний исчерпание.",
 "thag20.1:48.1": "Каким ад был,",
 "thag20.1:48.2": "где безнравственные не-приближаются;",
 "thag20.1:48.3": "Последователя задев,",
 "thag20.1:48.4": "и Какусандху брахмана.",
 "thag20.1:49.1": "Сотня была железных кольев,",
 "thag20.1:49.2": "все лично-чувствуемые;",
 "thag20.1:49.3": "Таким ад был,",
 "thag20.1:49.4": "где безнравственные не-приближаются;",
 "thag20.1:49.5": "Последователя задев,",
 "thag20.1:49.6": "и Какусандху брахмана.",
 "thag20.1:50.1": "Кто это познаёт,",
 "thag20.1:50.2": "монах Будды последователь;",
 "thag20.1:50.3": "Такого монаха задев,",
 "thag20.1:50.4": "тёмный, боль обретёшь.",
 "thag20.1:51.1": "Посредине луча стоят,",
 "thag20.1:51.2": "дворцы, каппу-стоящие;",
 "thag20.1:51.3": "Бериллового цвета, сверкающие,",
 "thag20.1:51.4": "пламенные, сияющие;",
 "thag20.1:51.5": "Апсары там танцуют,",
 "thag20.1:51.6": "многообразные, разноцветные.",
 "thag20.1:52.1": "Кто это познаёт,",
 "thag20.1:52.2": "…",
 "thag20.1:52.3": "…",
 "thag20.1:52.4": "тёмный, боль обретёшь.",
 "thag20.1:53.1": "Кто Пробуждённым побуждён,",
 "thag20.1:53.2": "монахов-собрания смотрящего;",
 "thag20.1:53.3": "Дворец матери Мигары,",
 "thag20.1:53.4": "пальцем ноги пошатнул.",
 "thag20.1:54.1": "Кто это познаёт,",
 "thag20.1:54.2": "…",
 "thag20.1:54.3": "…",
 "thag20.1:54.4": "тёмный, боль обретёшь.",
 "thag20.1:55.1": "Кто Веджаянта-дворец,",
 "thag20.1:55.2": "пальцем ноги пошатнул;",
 "thag20.1:55.3": "Силой чудес поддержанный,",
 "thag20.1:55.4": "и встревожил дэвов.",
 "thag20.1:56.1": "Кто это познаёт,",
 "thag20.1:56.2": "…",
 "thag20.1:56.3": "…",
 "thag20.1:56.4": "тёмный, боль обретёшь.",
 "thag20.1:57.1": "Кто в Веджаянте, дворце,",
 "thag20.1:57.2": "Сакку того расспрашивает;",
 "thag20.1:57.3": "И, товарищ, знаешь ли,",
 "thag20.1:57.4": "цепляние-исчерпания-высвобождения;",
 "thag20.1:57.5": "Тому Сакка ответил,",
 "thag20.1:57.6": "вопрос спрошенный как-есть”.",
 "thag20.1:58.1": "“Кто это познаёт,",
 "thag20.1:58.2": "…",
 "thag20.1:58.3": "…",
 "thag20.1:58.4": "тёмный, боль обретёшь.",
 "thag20.1:59.1": "Кто Брахму расспрашивает,",
 "thag20.1:59.2": "В Судхамме стоя, в собрании;",
 "thag20.1:59.3": "И сегодня, товарищ, тот твой взгляд,",
 "thag20.1:59.4": "Который взгляд прежде был;",
 "thag20.1:59.5": "Видишь превосходящее,",
 "thag20.1:59.6": "В мире Брахмы сияющее.",
 "thag20.1:60.1": "Тому Брахма ответил,",
 "thag20.1:60.2": "вопрос спрошенный как-есть;",
 "thag20.1:60.3": "Нет у меня, почтенный, того взгляда,",
 "thag20.1:60.4": "какой мой взгляд прежде был.",
 "thag20.1:61.1": "Вижу превосходящее,",
 "thag20.1:61.2": "в мире брахмы сияющее;",
 "thag20.1:61.3": "(Тот) я, сегодня как скажу,",
 "thag20.1:61.4": "я постоянен, вечен”.",
 "thag20.1:62.1": "“Кто это познаёт,",
 "thag20.1:62.2": "…",
 "thag20.1:62.3": "…",
 "thag20.1:62.4": "тёмный, боль обретёшь.",
 "thag20.1:63.1": "Кто великой горы Меру вершину,",
 "thag20.1:63.2": "освобождением коснулся;",
 "thag20.1:63.3": "Рощу Пуббавидехов,",
 "thag20.1:63.4": "и те, что на земле люди.",
 "thag20.1:64.1": "Кто это познаёт,",
 "thag20.1:64.2": "монах Будды последователь;",
 "thag20.1:64.3": "Такого монаха задев,",
 "thag20.1:64.4": "тёмный, боль обретёшь.",
 "thag20.1:65.1": "Ведь не огонь намеревается,",
 "thag20.1:65.2": "я незрелого сожгу”;",
 "thag20.1:65.3": "Незрелый горящий огонь,",
 "thag20.1:65.4": "задев его, сгорает.",
 "thag20.1:66.1": "Так же именно ты, Мара,",
 "thag20.1:66.2": "напав на Татхагату;",
 "thag20.1:66.3": "Сам сожжёшь себя,",
 "thag20.1:66.4": "незрелый, огонь словно коснувшись.",
 "thag20.1:67.1": "Не-благо порождает Мара,",
 "thag20.1:67.2": "напав на Татхагату;",
 "thag20.1:67.3": "Что же, думаешь, Злой,",
 "thag20.1:67.4": "не для меня плохое созревает.",
 "thag20.1:68.1": "У делающего тебя накапливается плохое,",
 "thag20.1:68.2": "на долгую ночь, Кончающий;",
 "thag20.1:68.3": "Мара, отвернись от Пробуждённого,",
 "thag20.1:68.4": "надежды не делай на монахов”.",
 "thag20.1:69.1": "“Так Мару пригрозил,",
 "thag20.1:69.2": "монах в Бхесакала-роще;",
 "thag20.1:69.3": "Оттого тот недовольный яккха,",
 "thag20.1:69.4": "тут же исчез”.",
 "thag20.1:69.5": "Так поистине уважаемый старший монах Махамоггаллана стихи произнёс.",
 "thag20.1:69.6": "Раздел шестидесяти установлен.",
 "thag20.1:70.0": "Там сводка",
 "thag20.1:70.1": "В разделе шестидесяти,",
 "thag20.1:70.2": "Моггаллана велико-сильный;",
 "thag20.1:70.3": "Одни стихи старших монахов,",
 "thag20.1:70.4": "шестьдесят восемь их есть."
}
