{
 "thag2.31:0.1": "Стихи старших монахов 2.31",
 "thag2.31:0.2": "Двойное собрание",
 "thag2.31:0.3": "Раздел Четвёртый",
 "thag2.31:0.4": "Стихи старшего монаха Мигасиры",
 "thag2.31:1.1": "“С тех пор как я ушёл в бездомность,",
 "thag2.31:1.2": "в правильно-пробуждённого учении;",
 "thag2.31:1.3": "Освобождаясь, поднялся я,",
 "thag2.31:1.4": "желание-дхату превзошёл.",
 "thag2.31:2.1": "Брахмой взирающего,",
 "thag2.31:2.2": "от того ум-состояние освободилось моё;",
 "thag2.31:2.3": "Неколебимо моё освобождение,",
 "thag2.31:2.4": "всех связываний исчерпанием”.",
 "thag2.31:2.5": "… Старший монах Мигасира …."
}
