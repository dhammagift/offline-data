{
 "thag3.1:0.1": "Стихи старших монахов 3.1",
 "thag3.1:0.2": "Тройной раздел",
 "thag3.1:0.3": "Глава первая",
 "thag3.1:0.4": "Стихи старшего монаха Анганикабхарадваджи",
 "thag3.1:1.1": "“Неверно чистоту ища,",
 "thag3.1:1.2": "огонь почитал я в лесу;",
 "thag3.1:1.3": "Путь чистоты не зная,",
 "thag3.1:1.4": "совершал я бессмертный аскетический подвиг.",
 "thag3.1:2.1": "То приятным приятное обретено,",
 "thag3.1:2.2": "узри явлений благую-явленность;",
 "thag3.1:2.3": "Три знания достигнуты,",
 "thag3.1:2.4": "исполнено Будды указание.",
 "thag3.1:3.1": "Брахма-родственником прежде был я,",
 "thag3.1:3.2": "теперь же я брахман;",
 "thag3.1:3.3": "Тройственно-знающий, омытый я,",
 "thag3.1:3.4": "учёный я, сведущий”.",
 "thag3.1:3.5": "… Старший монах Анганикабхарадваджа …."
}
