{
 "thag6.1:0.1": "Стихи старших монахов 6.1",
 "thag6.1:0.2": "Глава шестых",
 "thag6.1:0.3": "Глава первая",
 "thag6.1:0.4": "Стихи старшего монаха Урувелакассапы",
 "thag6.1:1.1": "“Увидев чудеса,",
 "thag6.1:1.2": "Готамы славного;",
 "thag6.1:1.3": "Не тогда я поклонился,",
 "thag6.1:1.4": "завистью-гордостью обманутый.",
 "thag6.1:2.1": "Мой замысел узнав,",
 "thag6.1:2.2": "укорил возничий людей;",
 "thag6.1:2.3": "Оттого мне возникло потрясение,",
 "thag6.1:2.4": "чудесное, волосы-дыбящее.",
 "thag6.1:3.1": "Прежде, когда был джатилой,",
 "thag6.1:3.2": "какое у меня было достижение, малое;",
 "thag6.1:3.3": "То я тогда отбросив,",
 "thag6.1:3.4": "покинул жизнь в учении Победителя.",
 "thag6.1:4.1": "Прежде жертвоприношением довольный,",
 "thag6.1:4.2": "желание-дхату предпосылая;",
 "thag6.1:4.3": "Потом страсть и злобу,",
 "thag6.1:4.4": "и заблуждение устранил.",
 "thag6.1:5.1": "Прошлые-жизни знаю,",
 "thag6.1:5.2": "божественное-око очищено;",
 "thag6.1:5.3": "Обладающий сиддхами, знающий чужой ум,",
 "thag6.1:5.4": "и божественное ухо обрёл.",
 "thag6.1:6.1": "Ради какой цели покинул жизнь,",
 "thag6.1:6.2": "из дома в бездомность;",
 "thag6.1:6.3": "Эта цель мной достигнута,",
 "thag6.1:6.4": "полное исчерпание всех связываний”.",
 "thag6.1:6.5": "… Старший монах Урувелакассапа …."
}
