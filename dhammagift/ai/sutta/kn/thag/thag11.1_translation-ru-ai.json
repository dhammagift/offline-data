{
 "thag11.1:0.1": "Стихи старших монахов 11.1",
 "thag11.1:0.2": "Раздел одиннадцати",
 "thag11.1:0.3": "Глава первая",
 "thag11.1:0.4": "Стихи старшего монаха Санкиччи",
 "thag11.1:1.1": "«Какая тебе цель в лесу, отец,",
 "thag11.1:1.2": "как в пустыне в сезон дождей;",
 "thag11.1:1.3": "Ветры Верамбхи приятны тебе,",
 "thag11.1:1.4": "уединение ведь для джханающих».",
 "thag11.1:2.1": "«Как облака ветер Верамбхи,",
 "thag11.1:2.2": "ветер разгоняет в сезон дождей;",
 "thag11.1:2.3": "Сознавания меня охватывают,",
 "thag11.1:2.4": "с уединением сопряжённое сознавание.",
 "thag11.1:3.1": "Белый, из яйца рождённый,",
 "thag11.1:3.2": "на кладбище обитающий;",
 "thag11.1:3.3": "Порождает же мне памятование,",
 "thag11.1:3.4": "в теле на бесстрастие опирающееся.",
 "thag11.1:4.1": "И что другие не защищают,",
 "thag11.1:4.2": "и кто других не защищает;",
 "thag11.1:4.3": "Он — монах — приятно спит,",
 "thag11.1:4.4": "в желаниях не ожидающий.",
 "thag11.1:5.1": "Чистые, широкие скалы,",
 "thag11.1:5.2": "с дикими козами и обезьянами;",
 "thag11.1:5.3": "покрытая мхом и водорослями,",
 "thag11.1:5.4": "те скалы радуют меня.",
 "thag11.1:6.1": "Прожито мной в лесах,",
 "thag11.1:6.2": "в пещерах и в расселинах;",
 "thag11.1:6.3": "в удалённых местах для сидения,",
 "thag11.1:6.4": "хищным зверем посещаемом.",
 "thag11.1:7.1": "‘Пусть эти убиваются, пусть уничтожаются,",
 "thag11.1:7.2": "боль пусть получают живые существа’;",
 "thag11.1:7.3": "Рассуждения не осознаю,",
 "thag11.1:7.4": "неблагородное, с вредностью-злобой связанное.",
 "thag11.1:8.1": "Обслужен мной Учитель,",
 "thag11.1:8.2": "исполнено Будды указание;",
 "thag11.1:8.3": "Отложен тяжёлый груз,",
 "thag11.1:8.4": "с проводником к индивидуальному существованию покончено.",
 "thag11.1:9.1": "Ради какой цели покинул жизнь,",
 "thag11.1:9.2": "из дома в бездомность;",
 "thag11.1:9.3": "Эта цель мной достигнута,",
 "thag11.1:9.4": "всех связываний исчерпание.",
 "thag11.1:10.1": "Не радуюсь умиранию,",
 "thag11.1:10.2": "не радуюсь жизни;",
 "thag11.1:10.3": "Время же ожидаю,",
 "thag11.1:10.4": "без-отравы наёмный работник как.",
 "thag11.1:11.1": "Не радуюсь умиранию,",
 "thag11.1:11.2": "не радуюсь жизни;",
 "thag11.1:11.3": "Время же ожидаю,",
 "thag11.1:11.4": "сознательный, памятующий”.",
 "thag11.1:11.5": "… Санкичча старший монах …",
 "thag11.1:11.6": "Раздел одиннадцати строф установлен.",
 "thag11.1:12.0": "Там сводка",
 "thag11.1:12.1": "Санкичча старший монах один,",
 "thag11.1:12.2": "сделавший-дело, без истечений;",
 "thag11.1:12.3": "В разделе одиннадцати строф,",
 "thag11.1:12.4": "строф одиннадцать же."
}
