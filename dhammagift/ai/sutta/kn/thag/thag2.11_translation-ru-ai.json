{
 "thag2.11:0.1": "Стихи старших монахов 2.11",
 "thag2.11:0.2": "Двойное собрание",
 "thag2.11:0.3": "Вторая Глава",
 "thag2.11:0.4": "Стихи старшего монаха Махачунды",
 "thag2.11:1.1": "«Послушание — услышанного возрастание,",
 "thag2.11:1.2": "услышанное — понимания возрастание;",
 "thag2.11:1.3": "Пониманием цель познаёт,",
 "thag2.11:1.4": "познанная цель — приятное-комфорт несущая.",
 "thag2.11:2.1": "Пусть практикует уединённые жилища,",
 "thag2.11:2.2": "Ведёт к связанности-освобождению;",
 "thag2.11:2.3": "Если радости не достигнет там,",
 "thag2.11:2.4": "В Сангхе пусть живёт, охраняя себя, памятующий».",
 "thag2.11:2.5": "… Старший монах Махачунда …."
}
