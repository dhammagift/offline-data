{
 "thag4.9:0.1": "Стихи старших монахов 4.9",
 "thag4.9:0.2": "Четыре строфы",
 "thag4.9:0.3": "Глава первая",
 "thag4.9:0.4": "Стихи старшего монаха Чанданы",
 "thag4.9:1.1": "“Золотом покрытая,",
 "thag4.9:1.2": "служанок толпой окружённая;",
 "thag4.9:1.3": "На колене сына взяв,",
 "thag4.9:1.4": "жена ко мне подошла.",
 "thag4.9:2.1": "И её увидев приходящую,",
 "thag4.9:2.2": "своего сына мать;",
 "thag4.9:2.3": "Украшенную, хорошо одетую,",
 "thag4.9:2.4": "словно сеть смерти расставленную.",
 "thag4.9:3.1": "Тогда у меня представление,",
 "thag4.9:3.2": "первопричинно возникло;",
 "thag4.9:3.3": "Недостаток-опасность проявился,",
 "thag4.9:3.4": "незаинтересованность утвердилась.",
 "thag4.9:4.1": "Тогда ум освободился у меня,",
 "thag4.9:4.2": "узри явлений благую-явленность;",
 "thag4.9:4.3": "Три знания достигнуты,",
 "thag4.9:4.4": "исполнено Будды указание”.",
 "thag4.9:4.5": "… Старший монах Чандана …."
}
