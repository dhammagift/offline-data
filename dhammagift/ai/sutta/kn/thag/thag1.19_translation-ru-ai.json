{
 "thag1.19:0.1": "Стихи старших монахов 1.19",
 "thag1.19:0.2": "Раздел из одного",
 "thag1.19:0.3": "Вторая Глава",
 "thag1.19:0.4": "Стихи старшего монаха Кулы",
 "thag1.19:1.1": "“Воду ведь ведут водопроводчики,",
 "thag1.19:1.2": "Стрелочники выпрямляют стрелу;",
