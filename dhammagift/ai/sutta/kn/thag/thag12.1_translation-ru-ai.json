{
 "thag12.1:0.1": "Стихи старших монахов 12.1",
 "thag12.1:0.2": "Раздел двенадцати",
 "thag12.1:0.3": "Глава первая",
 "thag12.1:0.4": "Стихи старшего монаха Силавы",
 "thag12.1:1.1": "“Нравственность именно здесь пусть тренирует,",
 "thag12.1:1.2": "в этом мире хорошо натренированную;",
 "thag12.1:1.3": "Нравственность ведь всякое достижение,",
 "thag12.1:1.4": "приближает практикуемая.",
 "thag12.1:2.1": "Нравственность пусть охраняет мудрый,",
 "thag12.1:2.2": "желая три счастья;",
 "thag12.1:2.3": "Похвалу и обретение богатства,",
 "thag12.1:2.4": "и после смерти на небесах радость.",
 "thag12.1:3.1": "Нравственный ведь многих друзей,",
 "thag12.1:3.2": "сдержанностью сознавание обретает;",
 "thag12.1:3.3": "Безнравственный же от друзей,",
 "thag12.1:3.4": "отпадает, плохое совершая.",
 "thag12.1:4.1": "Бесчестье и непризнание,",
 "thag12.1:4.2": "безнравственный обретает человек;",
 "thag12.1:4.3": "Честь, признание, похвалу,",
 "thag12.1:4.4": "всегда обретает нравственный.",
 "thag12.1:5.1": "Начало — нравственность, основа,",
 "thag12.1:5.2": "благих и мать;",
 "thag12.1:5.3": "Глава всех явлений,",
 "thag12.1:5.4": "поэтому нравственность пусть очищает.",
 "thag12.1:6.1": "Граница и сдержанность — нравственность,",
 "thag12.1:6.2": "ума-состояния украшение;",
 "thag12.1:6.3": "Переправа и всех пробуждённых,",
 "thag12.1:6.4": "поэтому нравственность пусть очищает.",
 "thag12.1:7.1": "Нравственность — сила, несравненная,",
 "thag12.1:7.2": "нравственность — оружие высочайшее;",
 "thag12.1:7.3": "Нравственность — украшение наилучшее,",
 "thag12.1:7.4": "нравственность — доспех удивительный.",
 "thag12.1:8.1": "Нравственность — мост великой силы,",
 "thag12.1:8.2": "нравственность — запах непревзойдённый;",
 "thag12.1:8.3": "Нравственность — мазь наилучшая,",
 "thag12.1:8.4": "которой благоухает во все стороны.",
 "thag12.1:9.1": "Нравственность — провизия превосходная,",
 "thag12.1:9.2": "нравственность — припасы высочайшие;",
 "thag12.1:9.3": "Нравственность — лучший перевозчик,",
 "thag12.1:9.4": "на котором идут во все стороны.",
 "thag12.1:10.1": "Здесь же порицание получает,",
 "thag12.1:10.2": "после смерти в бедствии недовольный;",
 "thag12.1:10.3": "Везде недоволен глупец,",
 "thag12.1:10.4": "в принципах не утверждённый.",
 "thag12.1:11.1": "Здесь же признание получает,",
 "thag12.1:11.2": "после смерти на небесах довольный;",
 "thag12.1:11.3": "Везде доволен знаток,",
 "thag12.1:11.4": "в принципах хорошо утверждённый.",
 "thag12.1:12.1": "Нравственность именно здесь высшая,",
 "thag12.1:12.2": "понимающий же превосходный;",
 "thag12.1:12.3": "Среди людей и среди дэвов,",
 "thag12.1:12.4": "нравственность-пониманием победа”.",
 "thag12.1:12.5": "… Старший монах Силава …."
}
