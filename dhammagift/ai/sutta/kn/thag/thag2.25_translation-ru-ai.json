{
 "thag2.25:0.1": "Стихи старших монахов 2.25",
 "thag2.25:0.2": "Двойное собрание",
 "thag2.25:0.3": "Раздел Третий",
 "thag2.25:0.4": "Стихи старшего монаха Витасоки",
 "thag2.25:1.1": "«Волосы мои будут сбриты,",
 "thag2.25:1.2": "цирюльник подошёл;",
 "thag2.25:1.3": "Оттуда, взяв зеркало,",
 "thag2.25:1.4": "тело (своё) рассмотрел.",
 "thag2.25:2.1": "Пустое тело увиделось,",
 "thag2.25:2.2": "темнота, тьма исчезла;",
 "thag2.25:2.3": "Все одежды отсечены,",
 "thag2.25:2.4": "отныне нет повторной вовлеченности-[индивидуального] существования”.",
 "thag2.25:2.5": "… Старший монах Витасока …."
}
