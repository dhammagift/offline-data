{
 "thag2.28:0.1": "Стихи старших монахов 2.28",
 "thag2.28:0.2": "Двойное собрание",
 "thag2.28:0.3": "Раздел Третий",
 "thag2.28:0.4": "Стихи старшего монаха Бхараты",
 "thag2.28:1.1": "“Иди, Нандака, пойдём,",
 "thag2.28:1.2": "к наставнику;",
 "thag2.28:1.3": "Львиный рык издадим,",
 "thag2.28:1.4": "перед лучшим из пробуждённых.",
 "thag2.28:2.1": "Из-за какого сострадания к нам,",
 "thag2.28:2.2": "нас в бездомные посвятил мудрец;",
 "thag2.28:2.3": "Эта наша цель достигнута,",
 "thag2.28:2.4": "полное исчерпание всех связываний”.",
 "thag2.28:2.5": "… старший монах Бхарата …."
}
