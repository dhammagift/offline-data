{
 "thag5.1:0.1": "Стихи старших монахов 5.1",
 "thag5.1:0.2": "Пятое собрание",
 "thag5.1:0.3": "Глава первая",
 "thag5.1:0.4": "Стихи старшего монаха Раджадатты",
 "thag5.1:1.1": "“Монах, на кладбище пойдя,",
 "thag5.1:1.2": "Увидел женщину выброшенную;",
 "thag5.1:1.3": "Брошенную на месте погребения,",
 "thag5.1:1.4": "Поедаемую червями, пронизанную.",
 "thag5.1:2.1": "Ведь что одни отвращаются,",
 "thag5.1:2.2": "Мёртвое увидев, плохое;",
 "thag5.1:2.3": "Страсть желания проявилась,",
 "thag5.1:2.4": "Слепой словно потекло я стал.",
 "thag5.1:3.1": "До приготовления еды,",
 "thag5.1:3.2": "С того места я ушёл;",
 "thag5.1:3.3": "Памятующий, сознательный я,",
 "thag5.1:3.4": "С одной стороны сел.",
 "thag5.1:4.1": "Тогда у меня представление,",
 "thag5.1:4.2": "первопричинно возникло;",
 "thag5.1:4.3": "Недостаток-опасность проявился,",
 "thag5.1:4.4": "незаинтересованность утвердилась.",
 "thag5.1:5.1": "Тогда ум освободился у меня,",
 "thag5.1:5.2": "узри явлений благую-явленность;",
 "thag5.1:5.3": "Три знания достигнуты,",
 "thag5.1:5.4": "исполнено Будды указание”.",
 "thag5.1:5.5": "… Старший монах Раджадатта …."
}
