{
 "thag2.41:0.1": "Стихи старших монахов 2.41",
 "thag2.41:0.2": "Двойное собрание",
 "thag2.41:0.3": "Пятая глава",
 "thag2.41:0.4": "Стихи старшего монаха Кумаракассапы",
 "thag2.41:1.1": "“Ах, пробуждённые, ах, явления,",
 "thag2.41:1.2": "ах, нашего Учителя достижение;",
 "thag2.41:1.3": "Где такое явление,",
 "thag2.41:1.4": "последователь засвидетельствует.",
 "thag2.41:2.1": "В неисчислимых каппах,",
 "thag2.41:2.2": "самопринадлежность-достигнутыми были;",
 "thag2.41:2.3": "Их это последнее,",
 "thag2.41:2.4": "конечное это тело;",
 "thag2.41:2.5": "Рождение-умирание-круговорот,",
 "thag2.41:2.6": "отныне нет повторной вовлеченности-[индивидуального] существования”.",
 "thag2.41:2.7": "… Старший монах Кумаракассапа …."
}
