{
 "thag1.12:0.1": "Стихи старших монахов 1.12",
 "thag1.12:0.2": "Раздел из одного",
 "thag1.12:0.3": "Вторая Глава",
 "thag1.12:0.4": "Стихи старшего монаха Махаваччхи",
 "thag1.12:1.1": "“Понимания-силой, нравственностью-принципами наделённый,",
 "thag1.12:1.2": "Собранный, в джхане радующийся, памятующий;",
 "thag1.12:1.3": "Ради-смысла-цели еду поедая,",
 "thag1.12:1.4": "Ожидал бы смерти здесь, свободный от страсти”.",
 "thag1.12:1.5": "… Старший монах Махаваччха …."
}
