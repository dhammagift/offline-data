{
 "thag1.57:0.1": "Стихи старших монахов 1.57",
 "thag1.57:0.2": "Раздел из одного",
 "thag1.57:0.3": "Шестая глава",
 "thag1.57:0.4": "Стих старшего монаха Кутивихари Второго",
 "thag1.57:1.1": "“Эту старую хижину,",
 "thag1.57:1.2": "Другую новую хижину ты желаешь;",
 "thag1.57:1.3": "Надежду на хижину отбрось,",
 "thag1.57:1.4": "Болезненна, монах, снова новая хижина”.",
 "thag1.57:1.5": "… Старший монах Кутивихари Второй …."
}
