{
 "thag3.5:0.1": "Стихи старших монахов 3.5",
 "thag3.5:0.2": "Тройной раздел",
 "thag3.5:0.3": "Глава первая",
 "thag3.5:0.4": "Стихи старшего монаха Матангапутты",
 "thag3.5:1.1": "«Чрезмерно холодно, чрезмерно жарко,",
 "thag3.5:1.2": "чрезмерно-поздно это было;",
 "thag3.5:1.3": "Так оставленные-дела,",
 "thag3.5:1.4": "моменты уходят, юноша.",
 "thag3.5:2.1": "А кто и холод, и жару,",
 "thag3.5:2.2": "травы больше не считает;",
 "thag3.5:2.3": "Делая мужские-обязанности,",
 "thag3.5:2.4": "тот от приятного не отпадает.",
 "thag3.5:3.1": "Траву даббу, кушу, потакилу,",
 "thag3.5:3.2": "усиру, мунджу и паббаджу;",
 "thag3.5:3.3": "Грудью отодвину,",
 "thag3.5:3.4": "уединение взращивая”.",
 "thag3.5:3.5": "… старший монах Матангапутта …."
}
