{
 "thag1.105:0.1": "Стихи старших монахов 1.105",
 "thag1.105:0.2": "Раздел из одного",
 "thag1.105:0.3": "Глава одиннадцатая",
 "thag1.105:0.4": "Стихи старшего монаха Малитавамбхи",
 "thag1.105:1.1": "“Даже если недоволен, не живи,",
 "thag1.105:1.2": "даже если радуясь, уходи;",
 "thag1.105:1.3": "Но только не с не-благом-связанное,",
 "thag1.105:1.4": "живи проживание, проницательный”.",
 "thag1.105:1.5": "… Старший монах Малитавамбха …."
}
