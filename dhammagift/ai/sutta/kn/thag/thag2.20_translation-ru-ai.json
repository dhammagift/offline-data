{
 "thag2.20:0.1": "Стихи старших монахов 2.20",
 "thag2.20:0.2": "Двойное собрание",
 "thag2.20:0.3": "Вторая Глава",
 "thag2.20:0.4": "Стихи старшего монаха Сиримы",
 "thag2.20:1.1": "“Другие его одобряют,",
 "thag2.20:1.2": "если сам он не собран;",
 "thag2.20:1.3": "Впустую другие одобряют,",
 "thag2.20:1.4": "ведь сам он не собран.",
 "thag2.20:2.1": "Другие его порицают,",
 "thag2.20:2.2": "если сам он хорошо собран;",
 "thag2.20:2.3": "Впустую другие порицают,",
 "thag2.20:2.4": "ведь сам он хорошо собран”.",
 "thag2.20:2.5": "… Старший Сирима ….",
 "thag2.20:2.6": "глава вторая.",
 "thag2.20:3.0": "Оглавление",
 "thag2.20:3.1": "Чунда и Джотидаса,",
 "thag2.20:3.2": "старший Хераньякани;",
 "thag2.20:3.3": "Сомамитта, Саббамитта,",
 "thag2.20:3.4": "Кала, Тисса и Кимила;",
 "thag2.20:3.5": "Нанда и Сирима также,",
 "thag2.20:3.6": "десять старших великой силы”."
}
