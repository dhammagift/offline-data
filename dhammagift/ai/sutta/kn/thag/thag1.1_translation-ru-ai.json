{
 "thag1.1:0.1": "Стихи старших монахов 1.1",
 "thag1.1:0.2": "Раздел из одного",
 "thag1.1:0.3": "Глава первая",
 "thag1.1:0.4": "Стихи старшего монаха Субхути",
 "thag1.1:1.0.1": "Вступительные стихи",
 "thag1.1:1.0.2": "Поклонение тому Благословенному Араханту Правильно-Пробуждённому.",
 "thag1.1:1.1": "Как львы рычащие,",
 "thag1.1:1.2": "с клыками в горных пещерах;",
 "thag1.1:1.3": "Услышьте о развивших себя,",
 "thag1.1:1.4": "стихи, ведущие к благу-смыслу-цели.",
 "thag1.1:2.1": "По имени, по роду,",
 "thag1.1:2.2": "по тому, как в Дхамме пребывали;",
 "thag1.1:2.3": "По тому, как решительно настроенные, с пониманием,",
 "thag1.1:2.4": "пребывали неустанно.",
 "thag1.1:3.1": "Там и там увидев,",
 "thag1.1:3.2": "коснувшись нетленной стопы;",
 "thag1.1:3.3": "Сделанное пересматривая,",
 "thag1.1:3.4": "этот смысл они произнесли.",
 "thag1.1:4.0": "Стихи старшего монаха Субхути",
 "thag1.1:4.1": "“Покрыта моя хижина, приятна, безветренна,",
 "thag1.1:4.2": "Лей, дэва, как удобно;",
 "thag1.1:4.3": "Ум мой хорошо сосредоточен, освобождён,",
 "thag1.1:4.4": "Пылким пребываю, лей, дэва”.",
 "thag1.1:4.5": "Так действительно уважаемый старший монах Субхути стих произнёс."
}
