{
 "thag1.54:0.1": "Стихи старших монахов 1.54",
 "thag1.54:0.2": "Раздел из одного",
 "thag1.54:0.3": "Шестая глава",
 "thag1.54:0.4": "Стихи старшего монаха Уттии",
 "thag1.54:1.1": "«Дождит божество, как хорошо спето,",
 "thag1.54:1.2": "Покрыта моя хижина, приятна, безветренна;",
 "thag1.54:1.3": "В ней я располагаюсь без второго,",
 "thag1.54:1.4": "Так что если хочешь, лей дождь, дэва”.",
 "thag1.54:1.5": "… Старший монах Уттия …."
}
