{
 "thag2.13:0.1": "Стихи старших монахов 2.13",
 "thag2.13:0.2": "Двойное собрание",
 "thag2.13:0.3": "Вторая Глава",
 "thag2.13:0.4": "Стихи старшего монаха Хераньякани",
 "thag2.13:1.1": "“Проходят дни и ночи,",
 "thag2.13:1.2": "жизнь заканчивается;",
 "thag2.13:1.3": "Долголетие смертных истощается,",
 "thag2.13:1.4": "как вода в маленьких реках.",
 "thag2.13:2.1": "И вот плохие активности,",
 "thag2.13:2.2": "делая, глупый не понимает;",
 "thag2.13:2.3": "Потом ему горько становится,",
 "thag2.13:2.4": "ведь результат его плохой».",
 "thag2.13:2.5": "… Старший монах Хераньякани …."
}
