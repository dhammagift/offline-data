{
 "thag16.3:0.1": "Стихи старших монахов 16.3",
 "thag16.3:0.2": "Двадцати-глава",
 "thag16.3:0.3": "Глава первая",
 "thag16.3:0.4": "Стихи старшего монаха Телакани",
 "thag16.3:1.1": "«Долгое время ведь пылкий,",
 "thag16.3:1.2": "Дхамму обдумывающий;",
 "thag16.3:1.3": "ровности ума-состояния не достиг,",
 "thag16.3:1.4": "спрашивал шраманов и брахманов.",
 "thag16.3:2.1": "‘Кто тот, другого-иного-достигший в мире,",
 "thag16.3:2.2": "кто достиг Бессмертного своим основанием;",
 "thag16.3:2.3": "Чьё явление принимаю,",
 "thag16.3:2.4": "высшего-блага-смысла-цели-понимание’.",
 "thag16.3:3.1": "Внутрь-крюка-попавшим был,",
 "thag16.3:3.2": "как рыба, пожирающая мясо;",
 "thag16.3:3.3": "Связанным великой-Инды-сетью,",
 "thag16.3:3.4": "как асур Вепачитти.",
 "thag16.3:4.1": "Тащу его, не отпускаю,",
 "thag16.3:4.2": "от этого страдания-стенания;",
 "thag16.3:4.3": "Кто мою связь отпустит в мире,",
 "thag16.3:4.4": "пробуждение даст познать.",
 "thag16.3:5.1": "Шрамана или брахмана какого,",
 "thag16.3:5.2": "указывающего на разрушительное;",
 "thag16.3:5.3": "Чьё явление принимаю,",
 "thag16.3:5.4": "старение-смерть-отводящего.",
 "thag16.3:6.1": "Неясностью-сомнением-связанный-узлом,",
 "thag16.3:6.2": "сопротивлением-силой-сознавание-соединённый;",
 "thag16.3:6.3": "гнев-достигший-умом-упрямый,",
 "thag16.3:6.4": "разрывающее-вопли.",
 "thag16.3:7.1": "Цепляние-лук-возникновение,",
 "thag16.3:7.2": "и две с пятнадцатью связанные;",
 "thag16.3:7.3": "Узри грудную клетку сильно,",
 "thag16.3:7.4": "пробив если стоит.",
 "thag16.3:8.1": "Воззрений непокидание,",
 "thag16.3:8.2": "намерением-страстью-возбуждённый;",
 "thag16.3:8.3": "Тем поражённый дрожу я,",
 "thag16.3:8.4": "лист словно ветром-колеблемый.",
 "thag16.3:9.1": "Внутри меня возникнув,",
 "thag16.3:9.2": "быстро сжигает моё;",
 "thag16.3:9.3": "Шести-касаний-областное тело,",
 "thag16.3:9.4": "где помнит всегда.",
 "thag16.3:10.1": "Того не вижу я врача,",
 "thag16.3:10.2": "кто эту стрелу извлечёт;",
 "thag16.3:10.3": "Ни другим оружием,",
 "thag16.3:10.4": "ни иным неясность.",
 "thag16.3:11.1": "Кто мне без-оружия без-раны,",
 "thag16.3:11.2": "Стрелу внутри-лежащую;",
 "thag16.3:11.3": "Не повредив все члены,",
 "thag16.3:11.4": "Стрелу мне извлечёт.",
 "thag16.3:12.1": "Учения-достигший ведь тот высший,",
 "thag16.3:12.2": "яда-изъяна-удалитель;",
 "thag16.3:12.3": "В глубину упавшего меня,",
 "thag16.3:12.4": "суша и руку бы показал.",
 "thag16.3:13.1": "В озеро-дом я погружён,",
 "thag16.3:13.2": "в грязи, уносимой течением;",
 "thag16.3:13.3": "Обман, враждебность, упрямство,",
 "thag16.3:13.4": "апатия-сонливость не расстелены.",
 "thag16.3:14.1": "Возбуждённость-гром-грохот,",
 "thag16.3:14.2": "связанность-туча;",
 "thag16.3:14.3": "Ветры несут неправильный взгляд,",
 "thag16.3:14.4": "помыслы на страсть опирающиеся.",
 "thag16.3:15.1": "Текут повсюду потоки,",
 "thag16.3:15.2": "лиана, пробившись, стоит;",
 "thag16.3:15.3": "Тот поток кто сдержит,",
 "thag16.3:15.4": "ту лиану кто же отсечёт.",
 "thag16.3:16.1": "Границу сделайте, достопочтенные,",
 "thag16.3:16.2": "потоков сдерживание;",
 "thag16.3:16.3": "Пусть твой ум-представление-поток,",
 "thag16.3:16.4": "как дерево внезапно не срежет.",
 "thag16.3:17.1": "Так мной, страха-рождённым,",
 "thag16.3:17.2": "от не-иного иного-ищущим;",
 "thag16.3:17.3": "Защита, понимание-оружие, Учитель,",
 "thag16.3:17.4": "провидцев-собранием-окружённый.",
 "thag16.3:18.1": "Лестницу благую, чистую,",
 "thag16.3:18.2": "из сути-явлений-сделанную, прочную;",
 "thag16.3:18.3": "Дал уносимому,",
 "thag16.3:18.4": "«Не бойся» — и сказал.",
 "thag16.3:19.1": "Установление памятования-террасу,",
 "thag16.3:19.2": "взойдя, я рассмотрел;",
 "thag16.3:19.3": "То, что прежде я воображал,",
 "thag16.3:19.4": "в самостность-влюблённое поколение.",
 "thag16.3:20.1": "И когда путь я увидел,",
 "thag16.3:20.2": "восхождение на корабль;",
 "thag16.3:20.3": "Не утвердившись в себе,",
 "thag16.3:20.4": "стояние увидел высочайшим.",
 "thag16.3:21.1": "Стрелу из-себя-возникшую,",
 "thag16.3:21.2": "из-бхава-нити-произведённую;",
 "thag16.3:21.3": "Для их не-продолжения",
 "thag16.3:21.4": "указал путь высочайший.",
 "thag16.3:22.1": "Долго-время-залёгшее,",
 "thag16.3:22.2": "долгой-ночью утверждённый;",
 "thag16.3:22.3": "Будда мне отогнал узел,",
 "thag16.3:22.4": "яда-порок-уносящий”.",
 "thag16.3:22.5": "… Телакани Тхера …."
}
