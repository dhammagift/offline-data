{
 "thag1.62:0.1": "Стихи старших монахов 1.62",
 "thag1.62:0.2": "Раздел из одного",
 "thag1.62:0.3": "Седьмой раздел",
 "thag1.62:0.4": "Стихи старшего монаха Ваджипутты",
 "thag1.62:1.1": "“Одиноки мы в лесу располагаемся,",
 "thag1.62:1.2": "Как выброшенное в лесу полено;",
 "thag1.62:1.3": "Мне многие завидуют,",
 "thag1.62:1.4": "Как адские существа — идущего на небо”.",
 "thag1.62:1.5": "… Старший монах Ваджипутта …."
}
