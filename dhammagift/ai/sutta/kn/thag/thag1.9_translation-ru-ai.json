{
 "thag1.9:0.1": "Стихи старших монахов 1.9",
 "thag1.9:0.2": "Раздел из одного",
 "thag1.9:0.3": "Глава первая",
 "thag1.9:0.4": "Стихи старшего монаха Пилиндавачи",
 "thag1.9:1.1": "«Хорошо пришёл, не плохо пришёл,",
 "thag1.9:1.2": "Не это плохо обдумано мной;",
 "thag1.9:1.3": "Среди разделённых явлений,",
 "thag1.9:1.4": "Что наилучшее, к тому я пришёл».",
 "thag1.9:1.5": "Так поистине уважаемый старший монах Пилиндавача стих произнёс."
}
