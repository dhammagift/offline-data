{
 "thag14.2:0.1": "Стихи старших монахов 14.2",
 "thag14.2:0.2": "Раздел четырнадцати",
 "thag14.2:0.3": "Глава первая",
 "thag14.2:0.4": "Стихи старшего монаха Годатты",
 "thag14.2:1.1": "“Как хороший скакун,",
 "thag14.2:1.2": "в ярмо впряжённый, ярмо-выносящий;",
 "thag14.2:1.3": "Взболтанный чрезмерной-ношей,",
 "thag14.2:1.4": "сопряжение не превосходит.",
 "thag14.2:2.1": "Так пониманием кто наполнены,",
 "thag14.2:2.2": "океан водой как;",
 "thag14.2:2.3": "Других не презирают,",
 "thag14.2:2.4": "благородная-Дхамма только существ.",
 "thag14.2:3.1": "Время временем-властью достигнув,",
 "thag14.2:3.2": "бхава-не-бхава властью ушедшие;",
 "thag14.2:3.3": "Люди боль обретают,",
 "thag14.2:3.4": "здесь страдают те-юноши.",
 "thag14.2:4.1": "Вознесённые приятным-явлением,",
 "thag14.2:4.2": "боль-явлением приниженные;",
 "thag14.2:4.3": "Двойней глупцы поражаются,",
 "thag14.2:4.4": "как-есть невидящие.",
 "thag14.2:5.1": "Которые же в боли и в приятном,",
 "thag14.2:5.2": "середину шва превзошли;",
 "thag14.2:5.3": "Стоят те столб-Индры-подобно,",
 "thag14.2:5.4": "не те вознесённые-приниженные.",
 "thag14.2:6.1": "Ведь ни в обретении, ни в не-обретении,",
 "thag14.2:6.2": "ни в славе, ни в известности;",
 "thag14.2:6.3": "Ни порицание, ни похвала,",
 "thag14.2:6.4": "ни боль, ни приятное.",
 "thag14.2:7.1": "Везде они не пачкаются,",
 "thag14.2:7.2": "как капля воды на лотосе;",
 "thag14.2:7.3": "Везде счастливы мудрые,",
 "thag14.2:7.4": "везде непобеждённые.",
 "thag14.2:8.1": "И не-обретение по Дхамме,",
 "thag14.2:8.2": "и обретение не-по-Дхамме;",
 "thag14.2:8.3": "Не-обретение по Дхамме лучше,",
 "thag14.2:8.4": "чем обретение не-по-Дхамме.",
 "thag14.2:9.1": "И репутация у малоумных,",
 "thag14.2:9.2": "и отсутствие репутации у знающих;",
 "thag14.2:9.3": "Отсутствие репутации лучше для знающих,",
 "thag14.2:9.4": "чем репутация у малоумных.",
 "thag14.2:10.1": "И похвала от глупых,",
 "thag14.2:10.2": "и порицание от знающих;",
 "thag14.2:10.3": "Порицание от знающих лучше,",
 "thag14.2:10.4": "чем похвала от незрелых.",
 "thag14.2:11.1": "И приятное, состоящее из желания,",
 "thag14.2:11.2": "и боль от уединения;",
 "thag14.2:11.3": "Боль от уединения лучше,",
 "thag14.2:11.4": "чем приятное, состоящее из желания.",
 "thag14.2:12.1": "И жизнь не-по-Дхамме,",
 "thag14.2:12.2": "и смерть по Дхамме;",
 "thag14.2:12.3": "Смерть по Дхамме лучше,",
 "thag14.2:12.4": "чем если бы жил не по Дхамме.",
 "thag14.2:13.1": "Кто отбросил желание и злость,",
 "thag14.2:13.2": "с умиротворённым умом в любом существовании;",
 "thag14.2:13.3": "Они странствуют в мире непривязанными,",
 "thag14.2:13.4": "нет у них милого-немилого.",
 "thag14.2:14.1": "Развив аспекты пробуждения,",
 "thag14.2:14.2": "способности и силы;",
 "thag14.2:14.3": "Достигнув высшего успокоения,",
 "thag14.2:14.4": "полностью угасают, с истекшими истечениями”.",
 "thag14.2:14.5": "… Годатта Тхера …",
 "thag14.2:14.6": "Четырнадцать строф установлено.",
 "thag14.2:15.0": "Там сводка",
 "thag14.2:15.1": "Ревата и Годатта,",
 "thag14.2:15.2": "старших двое тех велико-сильных;",
 "thag14.2:15.3": "В четырнадцати строфах,",
 "thag14.2:15.4": "стихов двадцать восемь."
}
