{
 "thag2.37:0.1": "Стихи старших монахов 2.37",
 "thag2.37:0.2": "Двойное собрание",
 "thag2.37:0.3": "Раздел Четвёртый",
 "thag2.37:0.4": "Стихи старшего монаха Соны Потирии",
 "thag2.37:1.1": "“Не до сна ещё,",
 "thag2.37:1.2": "ночь, гирляндой созвездий украшенная;",
 "thag2.37:1.3": "Бодрствовать именно для этого,",
 "thag2.37:1.4": "ночь для понимающего”.",
 "thag2.37:2.1": "“Со слоновьего плеча упавшего,",
 "thag2.37:2.2": "если слон подойдёт;",
 "thag2.37:2.3": "В битве мне смерть лучше,",
 "thag2.37:2.4": "и если живёт побеждённый”.",
 "thag2.37:2.5": "… Старший монах Сона Потирия …."
}
