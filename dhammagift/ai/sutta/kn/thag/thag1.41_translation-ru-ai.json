{
 "thag1.41:0.1": "Стихи старших монахов 1.41",
 "thag1.41:0.2": "Раздел из одного",
 "thag1.41:0.3": "Пятая глава",
 "thag1.41:0.4": "Стихи старшего монаха Сириваддхи",
 "thag1.41:1.1": "“В расщелину молнии попадают,",
 "thag1.41:1.2": "Вебары и Пандавы;",
 "thag1.41:1.3": "В горную расщелину уйдя, зажгись,",
 "thag1.41:1.4": "Сын несравненного Тадина”.",
 "thag1.41:1.5": "… Старший монах Сириваддха …."
}
