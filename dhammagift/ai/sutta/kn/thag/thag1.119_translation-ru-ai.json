{
 "thag1.119:0.1": "Стихи старших монахов 1.119",
 "thag1.119:0.2": "Раздел из одного",
 "thag1.119:0.3": "Двенадцатый раздел",
 "thag1.119:0.4": "Стихи старшего монаха Ваджипутты",
 "thag1.119:1.1": "“В корне-дерева-чащу углубившись,",
 "thag1.119:1.2": "Ниббану в сердце поместив;",
 "thag1.119:1.3": "Зажгись, Готама, и не беспечность,",
 "thag1.119:1.4": "Что тебе эта болтовня сделает”.",
 "thag1.119:1.5": "… Старший монах Ваджипутта …."
}
