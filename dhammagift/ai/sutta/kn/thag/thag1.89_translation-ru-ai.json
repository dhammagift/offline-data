{
 "thag1.89:0.1": "Тхерагатха 1.89",
 "thag1.89:0.2": "Раздел из одного",
 "thag1.89:0.3": "Девятая глава",
 "thag1.89:0.4": "(Первая) Дэвасабхаттхерагатха",
 "thag1.89:1.1": "«Выбрались из грязи-трясины,",
 "thag1.89:1.2": "пропасти обойдены;",
 "thag1.89:1.3": "Освобождён от потока и узлов,",
 "thag1.89:1.4": "все самооценки разрушены».",
 "thag1.89:1.5": "… Дэвасабхо тхера …."
}
