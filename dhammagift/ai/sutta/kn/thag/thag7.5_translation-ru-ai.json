{
 "thag7.5:0.1": "Стихи старших монахов 7.5",
 "thag7.5:0.2": "Семёрки",
 "thag7.5:0.3": "Глава первая",
 "thag7.5:0.4": "Стихи старшего монаха Сарабханги",
 "thag7.5:1.1": "«Сара, руками разломав,",
 "thag7.5:1.2": "сделав хижину, я жил;",
 "thag7.5:1.3": "Потому мне Сарабханга,",
 "thag7.5:1.4": "имя по договорённости было.",
 "thag7.5:2.1": "Не подобает мне сегодня,",
 "thag7.5:2.2": "сару руками разламывать;",
 "thag7.5:2.3": "Правила обучения нам установлены,",
 "thag7.5:2.4": "Готамой славным.",
 "thag7.5:3.1": "Целиком завершённую болезнь,",
 "thag7.5:3.2": "Сарабханга не видел прежде;",
 "thag7.5:3.3": "Эта же болезнь увидена,",
 "thag7.5:3.4": "Слову следующего сверх-дэвой.",
 "thag7.5:4.1": "Тем путём, которым ушёл Випасси,",
 "thag7.5:4.2": "Тем путём, которым Сикхи и Вессабху;",
 "thag7.5:4.3": "Какусандха, Конагамана и Кассапа,",
 "thag7.5:4.4": "Тем путём ушёл и Готама.",
 "thag7.5:5.1": "Свободные от цепляния, без подпитки,",
 "thag7.5:5.2": "семь пробуждённых, в исчерпание погружённых;",
 "thag7.5:5.3": "Которыми это Учение изложено,",
 "thag7.5:5.4": "истинно-явленными, такими.",
 "thag7.5:6.1": "Четыре благородные истины,",
 "thag7.5:6.2": "из сострадания к дышащим;",
 "thag7.5:6.3": "Боль, скапливание, путь,",
 "thag7.5:6.4": "устранение, исчерпание боли.",
 "thag7.5:7.1": "В чём прекращается боль,",
 "thag7.5:7.2": "в круговороте бесконечном;",
 "thag7.5:7.3": "С распадом этого тела,",
 "thag7.5:7.4": "и с исчерпанием жизни;",
 "thag7.5:7.5": "Другого нового [индивидуального] существования нет,",
 "thag7.5:7.6": "полностью освобождён я от всего”.",
 "thag7.5:7.7": "… Сарабханга Тхера …",
 "thag7.5:7.8": "Семёрка завершена.",
 "thag7.5:8.0": "Там сводка",
 "thag7.5:8.1": "Сундарасамудда Тхера,",
 "thag7.5:8.2": "Тхера Лакундабхаддия;",
 "thag7.5:8.3": "Бхадда Тхера и Сопака,",
 "thag7.5:8.4": "Сарабханга, великий провидец;",
 "thag7.5:8.5": "В Семёрке пять Тхер,",
 "thag7.5:8.6": "стихов тридцать пять."
}
