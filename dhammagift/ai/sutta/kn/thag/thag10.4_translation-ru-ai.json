{
 "thag10.4:0.1": "Стихи старших монахов 10.4",
 "thag10.4:0.2": "Десятичник",
 "thag10.4:0.3": "Глава первая",
 "thag10.4:0.4": "Стихи старшего монаха Чулапантхаки",
 "thag10.4:1.1": "“Медленным моё продвижение было,",
 "thag10.4:1.2": "презираем прежде я был;",
 "thag10.4:1.3": "Брат же меня отослал,",
 "thag10.4:1.4": "‘иди теперь ты домой’.",
 "thag10.4:2.1": "(Тот) я, отосланный будучи,",
 "thag10.4:2.2": "у входа в монастырь;",
 "thag10.4:2.3": "Недовольный там стоял,",
 "thag10.4:2.4": "в Учении с надеждой.",
 "thag10.4:3.1": "Благословенный туда пришёл,",
 "thag10.4:3.2": "голову мою погладил;",
 "thag10.4:3.3": "За руку меня взяв,",
 "thag10.4:3.4": "в монастырь ввёл.",
 "thag10.4:4.1": "Из сострадания ко мне Учитель,",
 "thag10.4:4.2": "подал тряпку для вытирания ног;",
 "thag10.4:4.3": "‘Это чистое установи,",
 "thag10.4:4.4": "с одной стороны хорошо установленное’.",
 "thag10.4:5.1": "Того его слово услышав,",
 "thag10.4:5.2": "пребывал в указании радующийся;",
 "thag10.4:5.3": "Самадхи настроил,",
 "thag10.4:5.4": "высшего блага-смысла-цели достижения ради.",
 "thag10.4:6.1": "Прошлые-жизни знаю,",
 "thag10.4:6.2": "божественное-око очищено;",
 "thag10.4:6.3": "Три знания достигнуты,",
 "thag10.4:6.4": "исполнено Будды указание.",
 "thag10.4:7.1": "Тысячекратно себя,",
 "thag10.4:7.2": "сотворив Пантхака;",
 "thag10.4:7.3": "Сядь в роще Рамме,",
 "thag10.4:7.4": "пока время-чувствование.",
 "thag10.4:8.1": "Тогда мой Учитель послал",
 "thag10.4:8.2": "вестника, объявляющего время;",
 "thag10.4:8.3": "Когда время было объявлено,",
 "thag10.4:8.4": "я с воздуха спустился.",
 "thag10.4:9.1": "Поклонившись Учителю в ноги,",
 "thag10.4:9.2": "с одной стороны сел я;",
 "thag10.4:9.3": "Меня сидящим увидев,",
 "thag10.4:9.4": "тогда Учитель принял.",
 "thag10.4:10.1": "Дар всего мира,",
 "thag10.4:10.2": "принятие подношений;",
 "thag10.4:10.3": "Поле блага для людей,",
 "thag10.4:10.4": "принял дар”.",
 "thag10.4:10.5": "… Чулапантхака Тхера …."
}
