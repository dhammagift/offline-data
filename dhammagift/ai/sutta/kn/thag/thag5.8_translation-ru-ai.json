{
 "thag5.8:0.1": "Стихи старших монахов 5.8",
 "thag5.8:0.2": "Пятое собрание",
 "thag5.8:0.3": "Глава первая",
 "thag5.8:0.4": "Стихи старшего монаха Ваккали",
 "thag5.8:1.1": "“Ветровой болезнью поражённый ты,",
 "thag5.8:1.2": "пребывая в роще лесной;",
 "thag5.8:1.3": "Вступив в область скудную,",
 "thag5.8:1.4": "как, монах, будешь поступать?”.",
 "thag5.8:2.1": "“Озарённостью-упоением и приятным-комфортом обильными,",
 "thag5.8:2.2": "наполняя тело;",
 "thag5.8:2.3": "Скудное также перенося,",
 "thag5.8:2.4": "буду пребывать в роще.",
 "thag5.8:3.1": "Развивая установления памятования,",
 "thag5.8:3.2": "способности и силы;",
 "thag5.8:3.3": "И аспекты пробуждения развивая,",
 "thag5.8:3.4": "буду пребывать в роще.",
 "thag5.8:4.1": "С решимостью начатой, с решительным настроем,",
 "thag5.8:4.2": "постоянно с твёрдым старанием;",
 "thag5.8:4.3": "Согласных, объединённых увидев,",
 "thag5.8:4.4": "буду пребывать в роще.",
 "thag5.8:5.1": "Вспоминая Пробуждённого,",
 "thag5.8:5.2": "высшего, укрощённого, собранного;",
 "thag5.8:5.3": "Неутомимо ночь и день,",
 "thag5.8:5.4": "буду пребывать в роще”.",
 "thag5.8:5.5": "… Старший монах Ваккали …."
}
