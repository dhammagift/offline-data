{
 "thag6.4:0.1": "Стихи старших монахов 6.4",
 "thag6.4:0.2": "Глава шестых",
 "thag6.4:0.3": "Глава первая",
 "thag6.4:0.4": "Стихи старшего монаха Куллы",
 "thag6.4:1.1": "“Кулла, на кладбище придя,",
 "thag6.4:1.2": "увидел женщину брошенную;",
 "thag6.4:1.3": "Брошенную на месте погребения,",
 "thag6.4:1.4": "поедаемую червями, полную.",
 "thag6.4:2.1": "Больную, нечистую, гнилую,",
 "thag6.4:2.2": "увидь, Кулла, тело;",
 "thag6.4:2.3": "Сочащееся, истекающее,",
 "thag6.4:2.4": "глупцами радуемое.",
 "thag6.4:3.1": "Дхамма-зеркало взяв,",
 "thag6.4:3.2": "знания-видения достижения;",
 "thag6.4:3.3": "Рассмотрел я это тело,",
 "thag6.4:3.4": "пустое внутри и снаружи.",
 "thag6.4:4.1": "Как это — так то,",
 "thag6.4:4.2": "как это так и это;",
 "thag6.4:4.3": "Как вниз так вверх,",
 "thag6.4:4.4": "как вверх так вниз.",
 "thag6.4:5.1": "Как днём так ночью,",
 "thag6.4:5.2": "как ночью так днём;",
 "thag6.4:5.3": "Как впереди так позади,",
 "thag6.4:5.4": "как позади так впереди.",
 "thag6.4:6.1": "Пятичастным оркестром,",
 "thag6.4:6.2": "Не радость бывает такая;",
 "thag6.4:6.3": "Как у однонаправленного ум-состоянием,",
 "thag6.4:6.4": "правильно явление видящего”.",
 "thag6.4:6.5": "… Старший монах Кулла …."
}
