{
 "thag1.47:0.1": "Стихи старших монахов 1.47",
 "thag1.47:0.2": "Раздел из одного",
 "thag1.47:0.3": "Пятая глава",
 "thag1.47:0.4": "Стихи старшего монаха Удджаи",
 "thag1.47:1.1": "“Почтение тебе, Пробуждённый, герой, будь славен,",
 "thag1.47:1.2": "полностью освобождён ты от всего;",
 "thag1.47:1.3": "В твоём даянии располагаясь,",
 "thag1.47:1.4": "располагаюсь без истечений.",
 "thag1.47:1.5": "… Старший монах Удджая …."
}
