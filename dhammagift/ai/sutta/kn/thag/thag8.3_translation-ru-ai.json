{
 "thag8.3:0.1": "Стихи старших монахов 8.3",
 "thag8.3:0.2": "Восьмеричная группа",
 "thag8.3:0.3": "Глава первая",
 "thag8.3:0.4": "Стихи старшего монаха Махапантхаки",
 "thag8.3:1.1": "“Когда впервые увидел я,",
 "thag8.3:1.2": "Учителя, от которого нет страха;",
 "thag8.3:1.3": "Тогда у меня возникло вдохновение,",
 "thag8.3:1.4": "увидев высшего из людей.",
 "thag8.3:2.1": "Красоту руками и ногами,",
 "thag8.3:2.2": "кто бы отклонил пришедшую;",
 "thag8.3:2.3": "Такого Учителя,",
 "thag8.3:2.4": "достигнув, упустил бы.",
 "thag8.3:3.1": "Тогда я сына-жену и,",
 "thag8.3:3.2": "богатство-зерно оставил;",
 "thag8.3:3.3": "Волосы-бороду срезав,",
 "thag8.3:3.4": "покинул [дом] в бездомность.",
 "thag8.3:4.1": "Тренировкой-образом-жизни наделенный,",
 "thag8.3:4.2": "в индриях хорошо сдержанный;",
 "thag8.3:4.3": "почитая Полностью-Пробуждённого,",
 "thag8.3:4.4": "пребывал я непобежденным.",
 "thag8.3:5.1": "Тогда у меня возникло стремление,",
 "thag8.3:5.2": "ума-мышления пожелание;",
 "thag8.3:5.3": "Не сидел я ни мгновения,",
 "thag8.3:5.4": "с цепляния-дротиком не удалённым.",
 "thag8.3:6.1": "Того меня так пребывающего,",
 "thag8.3:6.2": "Узри решительно-упорствующего;",
 "thag8.3:6.3": "Три знания достигнуты,",
 "thag8.3:6.4": "исполнено Будды указание.",
 "thag8.3:7.1": "Прошлые-жизни знаю,",
 "thag8.3:7.2": "божественное-око очищено;",
 "thag8.3:7.3": "Архат я, достойный-даров,",
 "thag8.3:7.4": "полностью освобожденный, без опор.",
 "thag8.3:8.1": "Затем, по окончании ночи,",
 "thag8.3:8.2": "восход солнца встречая;",
 "thag8.3:8.3": "Всё цепляние иссушив,",
 "thag8.3:8.4": "в позе лотоса воссел”.",
 "thag8.3:8.5": "… старший монах Махапантхака …",
 "thag8.3:8.6": "Восьмая глава установлена.",
 "thag8.3:9.0": "Там сводка",
 "thag8.3:9.1": "Старший монах Махакаччаяна,",
 "thag8.3:9.2": "Сиримитта, Махапантхака;",
 "thag8.3:9.3": "Эти в-восьмистрофном-разделе",
 "thag8.3:9.4": "стихов двадцать четыре."
}
