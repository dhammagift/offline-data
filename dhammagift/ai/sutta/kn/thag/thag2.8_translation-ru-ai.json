{
 "thag2.8:0.1": "Стихи старших монахов 2.8",
 "thag2.8:0.2": "Двойное собрание",
 "thag2.8:0.3": "Глава первая",
 "thag2.8:0.4": "Стихи старшего монаха Сурадхи",
 "thag2.8:1.1": "“Изношено ведь моё рождение,",
 "thag2.8:1.2": "достигнуто учение Победителя;",
 "thag2.8:1.3": "Покинуто то, что зовётся сетью,",
 "thag2.8:1.4": "с проводником к индивидуальному существованию покончено.",
 "thag2.8:2.1": "Ради чего продвинулся,",
 "thag2.8:2.2": "из дома в бездомность;",
 "thag2.8:2.3": "Эта цель мной достигнута,",
 "thag2.8:2.4": "полное исчерпание всех связываний”.",
 "thag2.8:2.5": "… Старший монах Сурадха …."
}
