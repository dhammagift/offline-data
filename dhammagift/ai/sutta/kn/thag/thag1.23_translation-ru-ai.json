{
 "thag1.23:0.1": "Стихи старших монахов 1.23",
 "thag1.23:0.2": "Раздел из одного",
 "thag1.23:0.3": "Раздел Третий",
 "thag1.23:0.4": "Стихи старшего монаха Госалы",
 "thag1.23:1.1": "“Я вот в бамбуковой роще,",
 "thag1.23:1.2": "поев рисовой каши с мёдом;",
 "thag1.23:1.3": "Правую сторону обходя,",
 "thag1.23:1.4": "блоков возникновение-исчезновение;",
 "thag1.23:1.5": "На склон я вернусь,",
 "thag1.23:1.6": "уединение взращивая”.",
 "thag1.23:1.7": "… Старший монах Госало …."
}
