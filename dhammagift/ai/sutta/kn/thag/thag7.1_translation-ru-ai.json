{
 "thag7.1:0.1": "Стихи старших монахов 7.1",
 "thag7.1:0.2": "Семёрки",
 "thag7.1:0.3": "Глава первая",
 "thag7.1:0.4": "Стихи старшего монаха Сундарасамудды",
 "thag7.1:1.1": "“Украшенная, хорошо одетая,",
 "thag7.1:1.2": "гирляндо-носящая, разукрашенная;",
 "thag7.1:1.3": "Лаком-накрашенные-ноги,",
 "thag7.1:1.4": "на туфли взобравшись, блудница.",
 "thag7.1:2.1": "Туфли сняв,",
 "thag7.1:2.2": "передо мной сложив-ладони;",
 "thag7.1:2.3": "Она меня мягко, нежно,",
 "thag7.1:2.4": "с улыбкой заговорила.",
 "thag7.1:3.1": "Молод ты, ушедший [в бездомность],",
 "thag7.1:3.2": "стой в моём учении;",
 "thag7.1:3.3": "Предавайся человеческим желаниям,",
 "thag7.1:3.4": "я богатство даю тебе;",
 "thag7.1:3.5": "Истинно тебе обещаю,",
 "thag7.1:3.6": "огонь или тебе принесу я.",
 "thag7.1:4.1": "Когда старыми будем,",
 "thag7.1:4.2": "оба посох-опорные;",
 "thag7.1:4.3": "Оба уйдём в бездомность,",
 "thag7.1:4.4": "в обоих случаях — схватив-за-край.",
 "thag7.1:5.1": "И её увидев просящую,",
 "thag7.1:5.2": "блудницу сложившую-ладони;",
 "thag7.1:5.3": "Украшенную, хорошо одетую,",
 "thag7.1:5.4": "словно сеть смерти расставленную.",
 "thag7.1:6.1": "Тогда у меня представление,",
 "thag7.1:6.2": "…",
 "thag7.1:6.3": "…",
 "thag7.1:6.4": "незаинтересованность утвердилась.",
 "thag7.1:7.1": "Тогда ум освободился у меня,",
 "thag7.1:7.2": "…",
 "thag7.1:7.3": "…",
 "thag7.1:7.4": "исполнено Будды указание”.",
 "thag7.1:7.5": "… старший монах Сундарасамудда …."
}
