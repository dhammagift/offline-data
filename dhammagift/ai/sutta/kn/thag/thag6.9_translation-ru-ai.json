{
 "thag6.9:0.1": "Стихи старших монахов 6.9",
 "thag6.9:0.2": "Глава шестых",
 "thag6.9:0.3": "Глава первая",
 "thag6.9:0.4": "Стихи старшего монаха Дженты, сына придворного жреца",
 "thag6.9:1.1": "“Рождением опьянённый,",
 "thag6.9:1.2": "богатством и властью также;",
 "thag6.9:1.3": "Статью, цветом, видом,",
 "thag6.9:1.4": "опьянённый, я ходил.",
 "thag6.9:2.1": "Никого равным себе,",
 "thag6.9:2.2": "и превосходящим не считал;",
 "thag6.9:2.3": "Самомнением поражённый глупец,",
 "thag6.9:2.4": "напыщенный, с поднятым флагом.",
 "thag6.9:3.1": "Мать и отца также,",
 "thag6.9:3.2": "и других, почитаемых старших;",
 "thag6.9:3.3": "Никого не приветствовал,",
 "thag6.9:3.4": "самомнением напыщенный, неуважительный.",
 "thag6.9:4.1": "Увидев ведущего, высшего,",
 "thag6.9:4.2": "лучшего из возничих, превосходнейшего;",
 "thag6.9:4.3": "Сияющего, словно солнце,",
 "thag6.9:4.4": "монашеским собранием окружённого.",
 "thag6.9:5.1": "Самомнение и опьянение отбросив,",
 "thag6.9:5.2": "с прояснённым разумом;",
 "thag6.9:5.3": "Головой приветствовал,",
 "thag6.9:5.4": "всех существ высшего.",
 "thag6.9:6.1": "Превосходство и принижение,",
 "thag6.9:6.2": "покинуты, хорошо искоренены;",
 "thag6.9:6.3": "Я-считание отсечено,",
 "thag6.9:6.4": "все виды самомнения уничтожены”.",
 "thag6.9:6.5": "… Джента пурохитапутта тхера …."
}
