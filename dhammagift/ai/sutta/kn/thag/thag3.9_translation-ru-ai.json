{
 "thag3.9:0.1": "Стихи старших монахов 3.9",
 "thag3.9:0.2": "Тройной раздел",
 "thag3.9:0.3": "Глава первая",
 "thag3.9:0.4": "Стихи старшего монаха Ясоджи",
 "thag3.9:1.1": "“Подобный красному дереву,",
 "thag3.9:1.2": "худой, с жилами, выступающими;",
 "thag3.9:1.3": "Знающий меру в еде и питье,",
 "thag3.9:1.4": "человек с не-унылым умом”.",
 "thag3.9:2.1": "“Затронутый оводами и комарами,",
 "thag3.9:2.2": "в лесу, в большой чаще;",
 "thag3.9:2.3": "Слон, как на поле битвы,",
 "thag3.9:2.4": "памятующий там пусть пребывает.",
 "thag3.9:3.1": "Как брахма — так один,",
 "thag3.9:3.2": "как дэва — так двое;",
 "thag3.9:3.3": "Как деревня — так трое,",
 "thag3.9:3.4": "суматоха — сверх того”.",
 "thag3.9:3.5": "… Старший монах Ясоджа …."
}
