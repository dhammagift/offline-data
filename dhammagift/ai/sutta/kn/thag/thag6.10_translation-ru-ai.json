{
 "thag6.10:0.1": "Стихи старших монахов 6.10",
 "thag6.10:0.2": "Глава шестых",
 "thag6.10:0.3": "Глава первая",
 "thag6.10:0.4": "Стихи старшего монаха Суманы",
 "thag6.10:1.1": "“Когда недавно ушедший в бездомность,",
 "thag6.10:1.2": "по рождению семилетний;",
 "thag6.10:1.3": "Сверхспособностью одолев,",
 "thag6.10:1.4": "змея-царя велико-сверхспособного.",
 "thag6.10:2.1": "Наставнику воду,",
 "thag6.10:2.2": "из Анотатты, великого озера;",
 "thag6.10:2.3": "Приношу, оттуда увидев,",
 "thag6.10:2.4": "меня Учитель это сказал”.",
 "thag6.10:3.1": "“Сарипутта, этого узри,",
 "thag6.10:3.2": "приходящего мальчика;",
 "thag6.10:3.3": "Кувшин с водой взяв,",
 "thag6.10:3.4": "внутри хорошо-объединённого.",
 "thag6.10:4.1": "Приятным поведением,",
 "thag6.10:4.2": "благие манеры;",
 "thag6.10:4.3": "Послушник Ануруддхи,",
 "thag6.10:4.4": "и сверхспособностью сведущий.",
 "thag6.10:5.1": "Чистокровным чистокровный,",
 "thag6.10:5.2": "благим благо-сделанный;",
 "thag6.10:5.3": "Воспитанный Ануруддхой,",
 "thag6.10:5.4": "сделавшим дело обученный.",
 "thag6.10:6.1": "Он достигнув высшего успокоения,",
 "thag6.10:6.2": "реализовав непоколебимость;",
 "thag6.10:6.3": "Послушник — он Сумана,",
 "thag6.10:6.4": "‘пусть меня не знает’ — желает”.",
 "thag6.10:6.5": "… Старший монах Сумана …."
}
