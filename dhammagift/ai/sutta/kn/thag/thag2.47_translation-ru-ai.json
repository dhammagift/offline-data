{
 "thag2.47:0.1": "Стихи старших монахов 2.47",
 "thag2.47:0.2": "Двойное собрание",
 "thag2.47:0.3": "Пятая глава",
 "thag2.47:0.4": "Стихи старшего монаха Анупамы",
 "thag2.47:1.1": "“Радующийся пришедший ум,",
 "thag2.47:1.2": "на кол насаживающий;",
 "thag2.47:1.3": "Туда-сюда же идёшь,",
 "thag2.47:1.4": "куда кол, колода.",
 "thag2.47:2.1": "Этот ум-кол я называю,",
 "thag2.47:2.2": "его называю ум-предатель;",
 "thag2.47:2.3": "Учитель тобой трудно обретаемый обретён,",
 "thag2.47:2.4": "в само-благе меня наставляй”.",
 "thag2.47:2.5": "… Старший монах Анупама …."
}
