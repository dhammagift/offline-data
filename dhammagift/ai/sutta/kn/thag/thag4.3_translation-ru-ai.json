{
 "thag4.3:0.1": "Стихи старших монахов 4.3",
 "thag4.3:0.2": "Четыре строфы",
 "thag4.3:0.3": "Глава первая",
 "thag4.3:0.4": "Стихи старшего монаха Сабхии",
 "thag4.3:1.1": "“А другие не понимают,",
 "thag4.3:1.2": "мы здесь сдерживаемся;",
 "thag4.3:1.3": "А которые там понимают,",
 "thag4.3:1.4": "от того успокаиваются распри.",
 "thag4.3:2.1": "Когда же непонимающие,",
 "thag4.3:2.2": "ведут себя как бессмертные;",
 "thag4.3:2.3": "Понимают же те, кто явление,",
 "thag4.3:2.4": "среди больных — не больные.",
 "thag4.3:3.1": "Любая вялая активность,",
 "thag4.3:3.2": "и запятнанный обет;",
 "thag4.3:3.3": "Сомнительная святая жизнь,",
 "thag4.3:3.4": "то не является велико-плодным.",
 "thag4.3:4.1": "У которого среди товарищей по святой жизни,",
 "thag4.3:4.2": "достойный уважения не обнаруживается;",
 "thag4.3:4.3": "Далеко он от истинной Дхаммы,",
 "thag4.3:4.4": "как небо от земли”.",
 "thag4.3:4.5": "… Старший монах Сабхия …."
}
