{
 "thag5.12:0.1": "Стихи старших монахов 5.12",
 "thag5.12:0.2": "Пятое собрание",
 "thag5.12:0.3": "Глава первая",
 "thag5.12:0.4": "Стихи старшего монаха Косии",
 "thag5.12:1.1": "“Кто, знающий слово старших, знаток,",
 "thag5.12:1.2": "И в том же доме порождает любовь;",
 "thag5.12:1.3": "Он преданным именем и есть мудрец,",
 "thag5.12:1.4": "И познав в явлениях, превосходным будет.",
 "thag5.12:2.1": "Когда бедствия возникшие возвышенные,",
 "thag5.12:2.2": "Не колеблют обдумывающего;",
 "thag5.12:2.3": "Он сильным именем и есть мудрец,",
 "thag5.12:2.4": "И познав в явлениях, превосходным будет.",
 "thag5.12:3.1": "Кто, как океан, стоит непоколебимый,",
 "thag5.12:3.2": "Глубокого понимания, тонко-смысла-видящий;",
 "thag5.12:3.3": "Несокрушимым именем и есть мудрец,",
 "thag5.12:3.4": "И познав в явлениях, превосходным будет.",
 "thag5.12:4.1": "Многоучёным и Дхамму-держащим и есть,",
 "thag5.12:4.2": "Дхаммы следующий согласно дхамме;",
 "thag5.12:4.3": "Он таковым именем и есть мудрец,",
 "thag5.12:4.4": "И познав в явлениях, превосходным будет.",
 "thag5.12:5.1": "И цель кто знает сказанного,",
 "thag5.12:5.2": "И цель узнав, так делает;",
 "thag5.12:5.3": "Цель-внутренним именем он есть мудрец,",
 "thag5.12:5.4": "И познав в явлениях, превосходным будет”.",
 "thag5.12:5.5": "… Старший Косия ….",
 "thag5.12:5.6": "Пятое собрание завершено.",
 "thag5.12:6.0": "Там сводка",
 "thag5.12:6.1": "Раджадатта, Субхута,",
 "thag5.12:6.2": "Гиримананда, Сумана;",
 "thag5.12:6.3": "Ваддха и старший Кассапа,",
 "thag5.12:6.4": "Гаякассапа, Ваккали.",
 "thag5.12:7.1": "Виджита, Ясадатта,",
 "thag5.12:7.2": "Сона, называемый Косьей;",
 "thag5.12:7.3": "Шестьдесят пять стихов,",
 "thag5.12:7.4": "и старших здесь двенадцать."
}
