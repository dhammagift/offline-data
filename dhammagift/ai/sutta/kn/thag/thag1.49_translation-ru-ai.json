{
 "thag1.49:0.1": "Стихи старших монахов 1.49",
 "thag1.49:0.2": "Раздел из одного",
 "thag1.49:0.3": "Пятая глава",
 "thag1.49:0.4": "Стих старшего монаха Раманейяки",
 "thag1.49:1.1": "“При звуках 'чиха-чиха',",
 "thag1.49:1.2": "и при пении раковин;",
 "thag1.49:1.3": "Не трепещет у меня ум-состояние,",
 "thag1.49:1.4": "ведь я предан единственности”.",
 "thag1.49:1.5": "… Старший монах Раманейяка …."
}
