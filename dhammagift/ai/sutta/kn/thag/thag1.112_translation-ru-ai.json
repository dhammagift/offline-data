{
 "thag1.112:0.1": "Стихи старших монахов 1.112",
 "thag1.112:0.2": "Раздел из одного",
 "thag1.112:0.3": "Двенадцатый раздел",
 "thag1.112:0.4": "Стихи старшего монаха Ваччаготты",
 "thag1.112:1.1": "«Тройного знания я, великий джхана-практик,",
 "thag1.112:1.2": "в равновесии ума-мышления умелый;",
 "thag1.112:1.3": "Собственное благо мной достигнуто,",
 "thag1.112:1.4": "исполнено Будды указание”.",
 "thag1.112:1.5": "… старший монах Ваччаготта …."
}
