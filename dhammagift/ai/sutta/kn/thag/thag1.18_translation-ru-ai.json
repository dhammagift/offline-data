{
 "thag1.18:0.1": "Стихи старших монахов 1.18",
 "thag1.18:0.2": "Раздел из одного",
 "thag1.18:0.3": "Вторая Глава",
 "thag1.18:0.4": "Стихи старшего монаха Сингалапиты",
 "thag1.18:1.1": "“Был Будды наследник,",
 "thag1.18:1.2": "монах в Бхесакала-роще;",
 "thag1.18:1.3": "Только лишь сознаванием скелета,",
 "thag1.18:1.4": "проник он эту землю;",
 "thag1.18:1.5": "Думаю я, желание-страсть он",
 "thag1.18:1.6": "быстро-именно отбросит”.",
 "thag1.18:1.7": "… Старший монах Сингалапита …."
}
