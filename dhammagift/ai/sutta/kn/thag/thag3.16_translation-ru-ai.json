{
 "thag3.16:0.1": "Стихи старших монахов 3.16",
 "thag3.16:0.2": "Тройной раздел",
 "thag3.16:0.3": "Глава первая",
 "thag3.16:0.4": "Стихи старшего монаха Вималы",
 "thag3.16:1.1": "“Плохих друзей избегая,",
 "thag3.16:1.2": "следовать высшей личности;",
 "thag3.16:1.3": "В наставлении его стоять,",
 "thag3.16:1.4": "стремясь к непоколебимому приятному.",
 "thag3.16:2.1": "На маленькое бревно взобравшись,",
 "thag3.16:2.2": "как тонет в великом океане;",
 "thag3.16:2.3": "Так с ленивым сойдясь,",
 "thag3.16:2.4": "благо-живущий также тонет;",
 "thag3.16:2.5": "Поэтому то следует избегать,",
 "thag3.16:2.6": "ленивого, низкой решимости.",
 "thag3.16:3.1": "С уединёнными благородными,",
 "thag3.16:3.2": "устремлёнными зажжёнными;",
 "thag3.16:3.3": "Всегда с утверждённой решимостью,",
 "thag3.16:3.4": "с мудрецами следует жить”.",
 "thag3.16:3.5": "… Старший монах Вимала …",
 "thag3.16:3.6": "Тройное Собрание завершено.",
 "thag3.16:4.0": "Там сводка",
 "thag3.16:4.1": "Анганика Бхарадваджа,",
 "thag3.16:4.2": "условие (обстоятельство проявления) Бакула-провидца;",
 "thag3.16:4.3": "Дхания, сын Матанги,",
 "thag3.16:4.4": "Собхита, Варана-провидец.",
 "thag3.16:5.1": "Вассика и Ясоджа,",
 "thag3.16:5.2": "Сатиматтия и Упали;",
 "thag3.16:5.3": "Уттарапала, Абхибхута,",
 "thag3.16:5.4": "Готама и Харита.",
 "thag3.16:6.1": "Старший в тройном разделе,",
 "thag3.16:6.2": "в ниббане безупречным сделан;",
 "thag3.16:6.3": "Тридцать восемь строф,",
 "thag3.16:6.4": "старших шестнадцать воспеты."
}
