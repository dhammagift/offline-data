{
 "thag10.5:0.1": "Стихи старших монахов 10.5",
 "thag10.5:0.2": "Десятичник",
 "thag10.5:0.3": "Глава первая",
 "thag10.5:0.4": "Стихи старшего монаха Каппы",
 "thag10.5:1.1": "“Разнородной-грязью-наполненный,",
 "thag10.5:1.2": "великой-отрыжкой-возникающий;",
 "thag10.5:1.3": "Выгребную яму словно перезревшую,",
 "thag10.5:1.4": "великий нарыв, великая рана.",
 "thag10.5:2.1": "Гноем-кровью-наполненный,",
 "thag10.5:2.2": "нечистот-ямой сдавленный;",
 "thag10.5:2.3": "Водой-сочащееся тело,",
 "thag10.5:2.4": "постоянно сочится гнилью.",
 "thag10.5:3.1": "Шестьюдесятью-сухожилиями-связанное,",
 "thag10.5:3.2": "мясо-мазью-намазанное;",
 "thag10.5:3.3": "Кожей-кольчугой-одетое,",
 "thag10.5:3.4": "гнилое тело, бесполезное.",
 "thag10.5:4.1": "Костей-сцеплением-скреплённое,",
 "thag10.5:4.2": "жилами-ниткой-связанное;",
 "thag10.5:4.3": "Многих-соединения-состоянием,",
 "thag10.5:4.4": "организует позу-движения.",
 "thag10.5:5.1": "Неизменно-направленное к смерти,",
 "thag10.5:5.2": "царя-Мары вблизи;",
 "thag10.5:5.3": "Здесь же отбросив,",
 "thag10.5:5.4": "куда-желает-идущий человек.",
 "thag10.5:6.1": "Неведением-покрыто тело,",
 "thag10.5:6.2": "четырьмя узлами завязан;",
 "thag10.5:6.3": "Затопление-погружающее тело,",
 "thag10.5:6.4": "сетью предрасположенностей покрыто.",
 "thag10.5:7.1": "С пятью преградами связан,",
 "thag10.5:7.2": "рассуждением наполнен;",
 "thag10.5:7.3": "Корнем цепляния сопровождаем,",
 "thag10.5:7.4": "замутненности-заблуждения покровом покрыт.",
 "thag10.5:8.1": "Так это тело вращается,",
 "thag10.5:8.2": "активности-механизмом приводимо;",
 "thag10.5:8.3": "И успех, и неудача,",
 "thag10.5:8.4": "различное состояние случается.",
 "thag10.5:9.1": "Которые это тело присваивают,",
 "thag10.5:9.2": "слепые глупцы обыватели;",
 "thag10.5:9.3": "Увеличивают могилу ужасную,",
 "thag10.5:9.4": "принимают новое существование.",
 "thag10.5:10.1": "Которые это тело избегают,",
 "thag10.5:10.2": "как измазанную нечистотами змею;",
 "thag10.5:10.3": "Корень существования извергнув,",
 "thag10.5:10.4": "полностью угаснут без истечений”.",
 "thag10.5:10.5": "… Каппа Тхера …."
}
