{
 "thag1.114:0.1": "Стихи старших монахов 1.114",
 "thag1.114:0.2": "Раздел из одного",
 "thag1.114:0.3": "Двенадцатый раздел",
 "thag1.114:0.4": "Стихи старшего монаха Адхимутты",
 "thag1.114:1.1": "“У кого тело тяжело от вялости,",
 "thag1.114:1.2": "когда жизнь убывает;",
 "thag1.114:1.3": "у жадного до телесного удовольствия,",
 "thag1.114:1.4": "откуда же чистота шрамана”.",
 "thag1.114:1.5": "… Старший монах Адхимутта …."
}
