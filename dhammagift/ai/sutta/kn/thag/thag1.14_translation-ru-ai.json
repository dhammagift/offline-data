{
 "thag1.14:0.1": "Стихи старших монахов 1.14",
 "thag1.14:0.2": "Раздел из одного",
 "thag1.14:0.3": "Вторая Глава",
 "thag1.14:0.4": "Стихи послушника Сиваки",
 "thag1.14:1.1": "“Наставник мне сказал,",
 "thag1.14:1.2": "отсюда идём, Сивака;",
 "thag1.14:1.3": "В деревне у меня живёт тело,",
 "thag1.14:1.4": "в лес у меня ушёл ум-представление;",
 "thag1.14:1.5": "Даже лежа я иду,",
 "thag1.14:1.6": "нет обмотки у понимающих”.",
 "thag1.14:1.7": "… У старшего Ванаваччхи (Сивики) послушник …."
}
