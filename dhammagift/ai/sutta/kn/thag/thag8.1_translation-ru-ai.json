{
 "thag8.1:0.1": "Стихи старших монахов 8.1",
 "thag8.1:0.2": "Восьмеричная группа",
 "thag8.1:0.3": "Глава первая",
 "thag8.1:0.4": "Стихи старшего монаха Махакаччаяны",
 "thag8.1:1.1": "“Активность многую не заставляй делать,",
 "thag8.1:1.2": "Избегал бы людей, не усердствуя;",
 "thag8.1:1.3": "Он усердный, к вкусам прилипший,",
 "thag8.1:1.4": "Благо оставляет, кто приятное-комфорт приносящий.",
 "thag8.1:2.1": "“Грязь” ведь её знают,",
 "thag8.1:2.2": "Это которое почтение-почитание в родах;",
 "thag8.1:2.3": "Тонкая стрела трудно-вынимаемая,",
 "thag8.1:2.4": "Почитание низким человеком трудно оставляемо.",
 "thag8.1:3.1": "Не другому в подражание,",
 "thag8.1:3.2": "Активность смертного плохая;",
 "thag8.1:3.3": "Сам её не практиковал бы,",
 "thag8.1:3.4": "Активность-родственники ведь, говорят.",
 "thag8.1:4.1": "Не от речи другого — вор,",
 "thag8.1:4.2": "Не от речи другого — мудрец;",
 "thag8.1:4.3": "Себя же он как знает,",
 "thag8.1:4.4": "Дэвы также его так знают.",
 "thag8.1:5.1": "Другие же не понимают,",
 "thag8.1:5.2": "мы здесь сдерживаемся;",
 "thag8.1:5.3": "А которые там понимают,",
 "thag8.1:5.4": "от того успокаиваются распри.",
 "thag8.1:6.1": "Живёт ведь и понимающий,",
 "thag8.1:6.2": "Даже при исчерпании богатства;",
 "thag8.1:6.3": "Понимания же без обретения,",
 "thag8.1:6.4": "Богатый и не живёт.",
 "thag8.1:7.1": "Всё слышит ухом,",
 "thag8.1:7.2": "Всё видит глазом;",
 "thag8.1:7.3": "И увиденное услышанное мудрый",
 "thag8.1:7.4": "всё отбросить заслуживает.",
 "thag8.1:8.1": "Глазастый будто слепой,",
 "thag8.1:8.2": "ушастый глухой как;",
 "thag8.1:8.3": "Понимающий будто немой,",
 "thag8.1:8.4": "сильный слабым как;",
 "thag8.1:8.5": "И когда благо-смысл-цель возникнет,",
 "thag8.1:8.6": "лежал бы как мертвец-лежащий”.",
 "thag8.1:8.7": "… Махакаччаяна старший монах …."
}
