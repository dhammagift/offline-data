{
 "thag1.34:0.1": "Стихи старших монахов 1.34",
 "thag1.34:0.2": "Раздел из одного",
 "thag1.34:0.3": "Раздел Четвёртый",
 "thag1.34:0.4": "Стихи старшего монаха Посии",
 "thag1.34:1.1": "“Не-близкие лучшие эти,",
 "thag1.34:1.2": "всегда ведь понимающим;",
 "thag1.34:1.3": "Из деревни в лес придя,",
 "thag1.34:1.4": "оттуда в дом вошёл;",
 "thag1.34:1.5": "Оттуда поднявшись ушёл,",
 "thag1.34:1.6": "не попрощавшись Посия”.",
 "thag1.34:1.7": "… Старший монах Посия …."
}
