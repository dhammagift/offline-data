{
 "thag5.2:0.1": "Стихи старших монахов 5.2",
 "thag5.2:0.2": "Пятое собрание",
 "thag5.2:0.3": "Глава первая",
 "thag5.2:0.4": "Стихи старшего монаха Субхуты",
 "thag5.2:1.1": "«К не-связи прилагая себя,",
 "thag5.2:1.2": "человек, желающий дела;",
 "thag5.2:1.3": "Если идя не достигает",
 "thag5.2:1.4": "‘это для меня признак невезения’.",
 "thag5.2:2.1": "Вытащенное, в беду попавшее, побеждённое,",
 "thag5.2:2.2": "Если одно отпустить — как проигравший будет;",
 "thag5.2:2.3": "Если же всё отпустить — как слепой будет,",
 "thag5.2:2.4": "из-за невидения ровного-неровного.",
 "thag5.2:3.1": "Что сделал бы, то и говори,",
 "thag5.2:3.2": "что не сделал, того не говори;",
 "thag5.2:3.3": "Не делающего, говорящего,",
 "thag5.2:3.4": "распознают мудрецы.",
 "thag5.2:4.1": "Как прекрасный цветок,",
 "thag5.2:4.2": "красочный, но без запаха;",
 "thag5.2:4.3": "Так хорошо сказанная речь,",
 "thag5.2:4.4": "бесплодна у не делающего.",
 "thag5.2:5.1": "Как прекрасный цветок,",
 "thag5.2:5.2": "Красивый, благоухающий;",
 "thag5.2:5.3": "Так хорошо сказанная речь,",
 "thag5.2:5.4": "Плодоносна [она] у делающего».",
 "thag5.2:5.5": "… Старший монах Субхута …."
}
