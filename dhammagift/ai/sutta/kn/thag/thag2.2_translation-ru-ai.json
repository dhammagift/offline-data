{
 "thag2.2:0.1": "Стихи старших монахов 2.2",
 "thag2.2:0.2": "Двойное собрание",
 "thag2.2:0.3": "Глава первая",
 "thag2.2:0.4": "Стихи старшего монаха Пиндолабхарадваджи",
 "thag2.2:1.1": "“Не это не-благом жизнь,",
 "thag2.2:1.2": "Не питание сердца близкое;",
