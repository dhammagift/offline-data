{
 "thag1.17:0.1": "Стихи старших монахов 1.17",
 "thag1.17:0.2": "Раздел из одного",
 "thag1.17:0.3": "Вторая Глава",
 "thag1.17:0.4": "Стихи старшего монаха Дасаки",
 "thag1.17:1.1": "“Сонливый когда бывает и много-едящий,",
 "thag1.17:1.2": "Спящий, переворачивающийся-лежащий;",
 "thag1.17:1.3": "Как большой-кабан откормленный-на-выгоне,",
 "thag1.17:1.4": "Снова-и-снова в лоно входит тупой”.",
 "thag1.17:1.5": "… Старший монах Дасака …."
}
