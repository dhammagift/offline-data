{
 "thag17.2:0.1": "Стихи старших монахов 17.2",
 "thag17.2:0.2": "Тридцать стихов",
 "thag17.2:0.3": "Глава первая",
 "thag17.2:0.4": "Стихи старшего монаха Сарипутты",
 "thag17.2:1.1": "“Как-ведущий-себя, как-памятующий, памятующий,",
 "thag17.2:1.2": "Сдержанный-в-намерениях, джхана-созерцающий, старательный;",
 "thag17.2:1.3": "Внутренне-радующийся, сосредоточенный-умом,",
 "thag17.2:1.4": "Один довольный — того зовут монахом.",
 "thag17.2:2.1": "Влажное, сухое ли вкушая,",
 "thag17.2:2.2": "Не чрезмерно насыщенным пусть будет;",
 "thag17.2:2.3": "С пустым животом, умеренный в еде,",
 "thag17.2:2.4": "Памятующий монах пусть странствует.",
 "thag17.2:3.1": "Четыре, пять кусков,",
 "thag17.2:3.2": "съев, воду пусть пьёт;",
 "thag17.2:3.3": "Достаточно для приятного пребывания,",
 "thag17.2:3.4": "устремившего себя монаха.",
 "thag17.2:4.1": "Подходящее если его покрывает,",
 "thag17.2:4.2": "одеяние это-нужное;",
 "thag17.2:4.3": "Достаточно для приятного пребывания,",
 "thag17.2:4.4": "устремившего себя монаха.",
 "thag17.2:5.1": "Сидящего со скрещёнными ногами,",
 "thag17.2:5.2": "колени не орошает;",
 "thag17.2:5.3": "Достаточно для приятного пребывания,",
 "thag17.2:5.4": "устремившего себя монаха.",
 "thag17.2:6.1": "Который приятное как боль увидел,",
 "thag17.2:6.2": "боль-увидел как стрелу;",
 "thag17.2:6.3": "Обоими-краями не было,",
 "thag17.2:6.4": "чем в мире что было бы.",
 "thag17.2:7.1": "Пусть мне когда-либо зложелающий,",
 "thag17.2:7.2": "ленивый, с низкой решимостью;",
 "thag17.2:7.3": "Малоучтивый, неуважительный,",
 "thag17.2:7.4": "чем в мире что было бы.",
 "thag17.2:8.1": "Многоучёный и мудрый,",
 "thag17.2:8.2": "в нравственности хорошо-сосредоточенный;",
 "thag17.2:8.3": "Равновесие ума-мышления практикующий,",
 "thag17.2:8.4": "даже на макушке пусть стоит.",
 "thag17.2:9.1": "Кто разрастание практикует,",
 "thag17.2:9.2": "разрастание-радующийся, олень;",
 "thag17.2:9.3": "Упустил тот ниббану,",
 "thag17.2:9.4": "от-связи-защиту непревзойденную.",
 "thag17.2:10.1": "А кто разрастание оставив,",
 "thag17.2:10.2": "в без-разрастания-пути радующийся;",
 "thag17.2:10.3": "Достигает тот ниббаны,",
 "thag17.2:10.4": "от-связи-защиту непревзойденную.",
 "thag17.2:11.1": "В деревне или в лесу,",
 "thag17.2:11.2": "в низине или на возвышенности;",
 "thag17.2:11.3": "где араханты располагаются,",
 "thag17.2:11.4": "То — красота земли.",
 "thag17.2:12.1": "Приятны леса,",
 "thag17.2:12.2": "где не радуется народ;",
 "thag17.2:12.3": "Лишённые страсти возрадуются,",
 "thag17.2:12.4": "не те, кто ищет желания.",
 "thag17.2:13.1": "Как указывающего на сокровища,",
 "thag17.2:13.2": "кого видит видящим изъяны;",
 "thag17.2:13.3": "Порицающего, мудрого,",
 "thag17.2:13.4": "такого мудреца пусть почитает;",
 "thag17.2:13.5": "Такого почитающего,",
 "thag17.2:13.6": "лучше, а не хуже.",
 "thag17.2:14.1": "Пусть наставляет, пусть учит,",
 "thag17.2:14.2": "и от неподобающего удерживает;",
 "thag17.2:14.3": "Ведь благим он мил становится,",
 "thag17.2:14.4": "неблагим становится немил.",
 "thag17.2:15.1": "Другого Благословенный, Будда,",
 "thag17.2:15.2": "явление преподал Зрящий;",
 "thag17.2:15.3": "Явлениям, когда преподаются,",
 "thag17.2:15.4": "ухо склоняет ищущий блага.",
 "thag17.2:16.1": "То моё не напрасное слушание,",
 "thag17.2:16.2": "освобождён я, без истечений.",
 "thag17.2:17.1": "Ни для прошлых жизней,",
 "thag17.2:17.2": "ни для божественного глаза;",
 "thag17.2:17.3": "Для ума-проникновения, сверхспособности,",
 "thag17.2:17.4": "умирания, перерождения;",
 "thag17.2:17.5": "Для слуха-дхату очищения,",
 "thag17.2:17.6": "устремления у меня не различается”.",
 "thag17.2:18.1": "“Корень дерева словно полагаясь,",
 "thag17.2:18.2": "бритый, в накидку одетый;",
 "thag17.2:18.3": "Пониманием высочайший старший монах,",
 "thag17.2:18.4": "Упатисса вот зажигается.",
 "thag17.2:19.1": "Без-рассуждения достигнув,",
 "thag17.2:19.2": "правильно-пробуждённого последователь;",
 "thag17.2:19.3": "Благородным молчанием,",
 "thag17.2:19.4": "обладает тотчас.",
 "thag17.2:20.1": "Как скалистая гора,",
 "thag17.2:20.2": "неподвижная, хорошо установленная;",
 "thag17.2:20.3": "Так, с исчерпанием замутненности-заблуждения монах,",
 "thag17.2:20.4": "скала словно не дрожит”.",
 "thag17.2:21.1": "“У без-изъяна человека,",
 "thag17.2:21.2": "постоянно ищущего чистоту;",
 "thag17.2:21.3": "Даже волосяного кончика плохого,",
 "thag17.2:21.4": "как облачная-глыба виднеется.",
 "thag17.2:22.1": "Не радуюсь умиранию,",
 "thag17.2:22.2": "не радуюсь жизни;",
 "thag17.2:22.3": "Оставлю это тело,",
 "thag17.2:22.4": "сознательный, памятующий.",
 "thag17.2:23.1": "Не радуюсь умиранию,",
 "thag17.2:23.2": "не радуюсь жизни;",
 "thag17.2:23.3": "Время же ожидаю,",
 "thag17.2:23.4": "без платы наёмник как”.",
 "thag17.2:24.1": "“С обеих сторон это умирание только,",
 "thag17.2:24.2": "Не-умирание позади или впереди;",
 "thag17.2:24.3": "Практикуйте, не погибайте,",
 "thag17.2:24.4": "Момент вас пусть не минует.",
 "thag17.2:25.1": "Крепость как отдаленная,",
 "thag17.2:25.2": "охраняемая изнутри-снаружи;",
 "thag17.2:25.3": "Так охраняйте себя,",
 "thag17.2:25.4": "момент вас пусть не минует;",
 "thag17.2:25.5": "Момент-превзошедшие ведь страдают,",
 "thag17.2:25.6": "в аду оказываются”.",
 "thag17.2:26.1": "“Успокоенный, утихший,",
 "thag17.2:26.2": "речью-говорящий, невзволнованный;",
 "thag17.2:26.3": "Стряхивает плохие явления,",
 "thag17.2:26.4": "лист дерева словно ветром.",
 "thag17.2:27.1": "Успокоенный, утихший,",
 "thag17.2:27.2": "речью-говорящий, невзволнованный;",
 "thag17.2:27.3": "Отбросил плохие явления,",
 "thag17.2:27.4": "лист дерева словно ветром.",
 "thag17.2:28.1": "Успокоенный, без-усилия,",
 "thag17.2:28.2": "чистое, безмутное;",
 "thag17.2:28.3": "Благих-принципов, мудрый,",
 "thag17.2:28.4": "боли-края-делающий пусть будет”.",
 "thag17.2:29.1": "“Не доверяй никому так,",
 "thag17.2:29.2": "Ни домохозяевам, ни ушедшим;",
 "thag17.2:29.3": "Хорошими став, нехорошими становятся,",
 "thag17.2:29.4": "Нехорошими став, снова хорошими становятся.",
 "thag17.2:30.1": "Желания-импульс и враждебность,",
 "thag17.2:30.2": "апатия-сонливость у монаха;",
 "thag17.2:30.3": "Возбужденность и неясность-разбредание,",
 "thag17.2:30.4": "пять этих ум-игр.",
 "thag17.2:31.1": "Кого почитаемого,",
 "thag17.2:31.2": "и непочётом, обоими;",
 "thag17.2:31.3": "Самадхи не колеблется,",
 "thag17.2:31.4": "в не-беспечности пребывающие.",
 "thag17.2:32.1": "Того джхана-практикующего, непрерывного,",
 "thag17.2:32.2": "тонко-видящий-проникающий.",
 "thag17.2:32.3": "в поддерживание-исчерпание-радующегося,”",
 "thag17.2:32.4": "называют праведный человек так.",
 "thag17.2:33.1": "Великий океан, земля,",
 "thag17.2:33.2": "гора и ветер;",
 "thag17.2:33.3": "Сравнению не поддаются",
 "thag17.2:33.4": "Учителя превосходного-высвобождения.",
 "thag17.2:34.1": "Колесо-вращающий старший монах,",
 "thag17.2:34.2": "великого-знания, собранный;",
 "thag17.2:34.3": "Земле-воде-огню-подобный,",
 "thag17.2:34.4": "не очаровывается, не злится.",
 "thag17.2:35.1": "Понимания-совершенства достигший,",
 "thag17.2:35.2": "великого-ума, великой-мысли;",
 "thag17.2:35.3": "Не-глупый, глупому-подобный,",
 "thag17.2:35.4": "всегда ведёт угасший.",
 "thag17.2:36.1": "Обслужен мной Учитель,",
 "thag17.2:36.2": "…",
 "thag17.2:36.3": "…",
 "thag17.2:36.4": "с проводником к индивидуальному существованию покончено.",
 "thag17.2:37.1": "Достигайте не-беспечностью,",
 "thag17.2:37.2": "Это моё наставление;",
 "thag17.2:37.3": "Ну же, я угасну полностью,",
 "thag17.2:37.4": "полностью освобождён я от всего”.",
 "thag17.2:37.5": "… Старший монах Сарипутта …"
}
