{
 "thag5.7:0.1": "Стихи старших монахов 5.7",
 "thag5.7:0.2": "Пятое собрание",
 "thag5.7:0.3": "Глава первая",
 "thag5.7:0.4": "Стихи старшего монаха Гаякассапы",
 "thag5.7:1.1": "“Утром, в полдень, вечером,",
 "thag5.7:1.2": "трижды в день я;",
 "thag5.7:1.3": "Погружался в воду (тот) я,",
 "thag5.7:1.4": "в Гае на Гая-праздник.",
 "thag5.7:2.1": "‘Что мной сделано плохого,",
 "thag5.7:2.2": "прежде в других рождениях;",
 "thag5.7:2.3": "То теперь здесь смою’,",
 "thag5.7:2.4": "такой взгляд прежде был.",
 "thag5.7:3.1": "Услышав хорошо сказанную речь,",
 "thag5.7:3.2": "связанное с Дхаммой-благом слово;",
 "thag5.7:3.3": "Истинный, действительный смысл-благо,",
 "thag5.7:3.4": "первопричинно я рассмотрел.",
 "thag5.7:4.1": "Смыто всё плохое мной,",
 "thag5.7:4.2": "без изъяна, чист, прозрачен;",
 "thag5.7:4.3": "Чистый чистого наследник,",
 "thag5.7:4.4": "сын Пробуждённого, родной.",
 "thag5.7:5.1": "Погрузившись в восьмичастный поток,",
 "thag5.7:5.2": "всё плохое я смыл;",
 "thag5.7:5.3": "Три знания я достиг,",
 "thag5.7:5.4": "исполнено Будды указание”.",
 "thag5.7:5.5": "… Гаякассапа старший …."
}
