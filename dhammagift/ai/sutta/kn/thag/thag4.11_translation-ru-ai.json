{
 "thag4.11:0.1": "Стихи старших монахов 4.11",
 "thag4.11:0.2": "Четыре строфы",
 "thag4.11:0.3": "Глава первая",
 "thag4.11:0.4": "Стихи старшего монаха Саппаки",
 "thag4.11:1.1": "“Когда цапля с чисто-белым опереньем,",
 "thag4.11:1.2": "Чёрной тучи страхом устрашённая;",
 "thag4.11:1.3": "Улетает, ища убежище, убежища-ищущая,",
 "thag4.11:1.4": "Тогда река Аджакарани радует меня.",
 "thag4.11:2.1": "Когда цапля с чисто-белым опереньем,",
 "thag4.11:2.2": "Чёрной тучи страхом устрашённая;",
 "thag4.11:2.3": "Ищет укрытие, укрытие-видящая,",
 "thag4.11:2.4": "Тогда река Аджакарани радует меня.",
 "thag4.11:3.1": "Кого же там не радуют",
 "thag4.11:3.2": "розовые яблони с обеих сторон там;",
 "thag4.11:3.3": "Украшают берег реки,",
 "thag4.11:3.4": "позади моего укрытия.",
 "thag4.11:4.1": "Те, от опьянения-и-сонливости хорошо-отказавшиеся,",
 "thag4.11:4.2": "Лягушки, медлительные, квакают;",
 "thag4.11:4.3": "‘Не сегодня от горных рек время разлуки,",
 "thag4.11:4.4": "Безопасна Аджакарани, благоприятна, приятна’”.",
 "thag4.11:4.5": "… Старший монах Саппака …."
}
