{
 "thag1.67:0.1": "Стихи старших монахов 1.67",
 "thag1.67:0.2": "Раздел из одного",
 "thag1.67:0.3": "Седьмой раздел",
 "thag1.67:0.4": "Экадхаммасавания Тхера",
 "thag1.67:1.1": "“Загрязнения выжжены мной,",
 "thag1.67:1.2": "вовлеченности все поканчивающие;",
 "thag1.67:1.3": "Исчерпан рождение-круговорот,",
 "thag1.67:1.4": "отныне нет повторной вовлеченности-[индивидуального] существования”.",
 "thag1.67:1.5": "… Экадхаммасавания старший монах …."
}
