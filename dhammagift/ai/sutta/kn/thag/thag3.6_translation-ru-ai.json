{
 "thag3.6:0.1": "Стихи старших монахов 3.6",
 "thag3.6:0.2": "Тройной раздел",
 "thag3.6:0.3": "Глава первая",
 "thag3.6:0.4": "Стихи старшего монаха Кхудджасобхиты",
 "thag3.6:1.1": "«Те, кто красноречивы, многоучёны,",
 "thag3.6:1.2": "Шраманы, живущие в Паталипутте;",
 "thag3.6:1.3": "Тех-сознавание-один этот юный,",
 "thag3.6:1.4": "У двери стоит Кхудджасобхита».",
 "thag3.6:2.1": "«Те, кто красноречивы, многоучёны,",
 "thag3.6:2.2": "Шраманы, живущие в Паталипутте;",
 "thag3.6:2.3": "Тех-сознавание-один этот юный,",
 "thag3.6:2.4": "У двери стоит, ветром колеблемый».",
 "thag3.6:3.1": "«Благодаря хорошей битве, хорошему жертвоприношению,",
 "thag3.6:3.2": "И победе в сражении;",
 "thag3.6:3.3": "Благодаря святой жизни, прожитой должным образом,",
 "thag3.6:3.4": "Так этот [человек] приятное обретает».",
 "thag3.6:3.5": "… Старший монах Кхудджасобхита …."
}
