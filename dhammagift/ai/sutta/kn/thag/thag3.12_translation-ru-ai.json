{
 "thag3.12:0.1": "Стихи старших монахов 3.12",
 "thag3.12:0.2": "Тройной раздел",
 "thag3.12:0.3": "Глава первая",
 "thag3.12:0.4": "Стихи старшего монаха Уттарапалы",
 "thag3.12:1.1": "“Мудрецом вот меня присутствующего,",
 "thag3.12:1.2": "благо-смысл-цель-обдумывателем;",
 "thag3.12:1.3": "Пять множителей желания в мире,",
 "thag3.12:1.4": "из-за заблуждения повергли меня.",
 "thag3.12:2.1": "Войдя в область Мары,",
 "thag3.12:2.2": "прочной стрелой пронзённый;",
 "thag3.12:2.3": "Смог я от царя смерти,",
 "thag3.12:2.4": "от пут освободиться.",
 "thag3.12:3.1": "Все желания покинуты мной,",
 "thag3.12:3.2": "вовлеченности все разбиты;",
 "thag3.12:3.3": "Исчерпан рождение-круговорот,",
 "thag3.12:3.4": "отныне нет повторной вовлеченности-[индивидуального] существования”.",
 "thag3.12:3.5": "… Старший монах Уттарапала …."
}
