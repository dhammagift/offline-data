{
 "thag1.79:0.1": "Стихи старших монахов 1.79",
 "thag1.79:0.2": "Раздел из одного",
 "thag1.79:0.3": "Восьмая глава",
 "thag1.79:0.4": "Стихи старшего монаха Раккхиты",
 "thag1.79:1.1": "“Вся страсть покинута мной,",
 "thag1.79:1.2": "вся злоба устранена;",
 "thag1.79:1.3": "Вся ушла от меня замутнённость,",
 "thag1.79:1.4": "став прохладным, я угас”.",
 "thag1.79:1.5": "… Старший монах Раккхита …."
}
