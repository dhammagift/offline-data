{
 "thag2.12:0.1": "Стихи старших монахов 2.12",
 "thag2.12:0.2": "Двойное собрание",
 "thag2.12:0.3": "Вторая Глава",
 "thag2.12:0.4": "Стихи старшего монаха Джотидасы",
 "thag2.12:1.1": "“Которые же сковыванием,",
 "thag2.12:1.2": "разнообразием и активностью;",
 "thag2.12:1.3": "Людей сдерживают,",
 "thag2.12:1.4": "грубо-нападающие люди;",
 "thag2.12:1.5": "Те тоже здесь рассеиваются,",
 "thag2.12:1.6": "ведь активность не исчезает.",
 "thag2.12:2.1": "Какую совершает человек активность,",
 "thag2.12:2.2": "благую или плохую;",
 "thag2.12:2.3": "Того именно наследник,",
 "thag2.12:2.4": "какую какую активность проявляет”.",
 "thag2.12:2.5": "… Старший монах Джотидаса …."
}
