{
 "thag1.72:0.1": "Стихи старших монахов 1.72",
 "thag1.72:0.2": "Раздел из одного",
 "thag1.72:0.3": "Восьмая глава",
 "thag1.72:0.4": "Стих старшего монаха Атумы",
 "thag1.72:1.1": "“Как бамбук, хорошо выросший на вершине,",
 "thag1.72:1.2": "Трудно вытащить, когда он разросся ветвями;",
 "thag1.72:1.3": "Так и я, приведённый женой,",
 "thag1.72:1.4": "Позволь мне, я теперь ушёл в бездомность”.",
 "thag1.72:1.5": "… Старший монах Атума …."
}
