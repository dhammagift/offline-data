{
 "thag12.2:0.1": "Стихи старших монахов 12.2",
 "thag12.2:0.2": "Раздел двенадцати",
 "thag12.2:0.3": "Глава первая",
 "thag12.2:0.4": "Стихи старшего монаха Суниты",
 "thag12.2:1.1": "«В низком роду я родился,",
 "thag12.2:1.2": "бедный, скудный на пропитание;",
 "thag12.2:1.3": "Низкая деятельность моя была,",
 "thag12.2:1.4": "был я сбрасывателем цветов.",
 "thag12.2:2.1": "Презираемый людьми,",
 "thag12.2:2.2": "и унижаемый, и принижаемый;",
 "thag12.2:2.3": "Ум-представление сделав низким,",
 "thag12.2:2.4": "кланялся я многим людям.",
 "thag12.2:3.1": "Тогда увидел я Пробуждённого,",
 "thag12.2:3.2": "монашеским собранием окружённого;",
 "thag12.2:3.3": "Входящего великого героя,",
 "thag12.2:3.4": "в Магадхов лучший город.",
 "thag12.2:4.1": "Отбросив коромысло,",
 "thag12.2:4.2": "для поклонения приблизился я;",
 "thag12.2:4.3": "Ко мне из сострадания,",
 "thag12.2:4.4": "встал лучший из людей.",
 "thag12.2:5.1": "Поклонившись Учителю в ноги,",
 "thag12.2:5.2": "в стороне стоял я тогда;",
 "thag12.2:5.3": "Посвящения я попросил,",
 "thag12.2:5.4": "всех существ высшего.",
 "thag12.2:6.1": "Тогда сострадательный Учитель,",
 "thag12.2:6.2": "ко всему миру сострадающий;",
 "thag12.2:6.3": "«Ты иди, монах», — мне сказал,",
 "thag12.2:6.4": "это мне было полным посвящением.",
 "thag12.2:7.1": "(Тот) я один в лесу,",
 "thag12.2:7.2": "пребывая, неутомлённый;",
 "thag12.2:7.3": "Сделал я Учителя выражение,",
 "thag12.2:7.4": "как меня наставлял Победитель.",
 "thag12.2:8.1": "Ночью в первую стражу,",
 "thag12.2:8.2": "прошлые рождения вспомнил;",
 "thag12.2:8.3": "Ночью в среднюю стражу,",
 "thag12.2:8.4": "божественный глаз очистил;",
 "thag12.2:8.5": "Ночью в последнюю стражу,",
 "thag12.2:8.6": "тьмы-глыбу рассеял.",
 "thag12.2:9.1": "Затем, по окончании ночи,",
 "thag12.2:9.2": "солнца восходу навстречу;",
 "thag12.2:9.3": "Инда и Брахма, придя,",
 "thag12.2:9.4": "меня почтили сложенными ладонями.",
 "thag12.2:10.1": "‘Почтение тебе, чистокровный человек,",
 "thag12.2:10.2": "почтение тебе, высший человек;",
 "thag12.2:10.3": "У кого эти истечения разрушены,",
 "thag12.2:10.4": "достойный-даров ты, почтенный’.",
 "thag12.2:11.1": "Тогда, увидев меня, Учитель,",
 "thag12.2:11.2": "собранием дэв окружённого;",
 "thag12.2:11.3": "улыбку явив,",
 "thag12.2:11.4": "этот смысл произнёс.",
 "thag12.2:12.1": "‘Аскезой и святой жизнью,",
 "thag12.2:12.2": "сдержанностью и обузданием;",
 "thag12.2:12.3": "Этим брахман бывает,",
 "thag12.2:12.4": "этот брахман наивысший’.",
 "thag12.2:12.5": "… Сунита Тхера …",
 "thag12.2:12.6": "Двенадцатая глава установлена.",
 "thag12.2:13.0": "Там сводка",
 "thag12.2:13.1": "Нравственный и Сунита,",
 "thag12.2:13.2": "старших двое тех велико-сильных;",
 "thag12.2:13.3": "В двенадцатой главе,",
 "thag12.2:13.4": "стихов двадцать четыре."
}
