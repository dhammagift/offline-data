{
 "thag2.17:0.1": "Стихи старших монахов 2.17",
 "thag2.17:0.2": "Двойное собрание",
 "thag2.17:0.3": "Вторая Глава",
 "thag2.17:0.4": "Стихи старшего монаха Тиссы",
 "thag2.17:1.1": "“Много врагов обретает,",
 "thag2.17:1.2": "бритый, в накидку одетый;",
 "thag2.17:1.3": "Обретающим еды, питья,",
 "thag2.17:1.4": "одежды и ложа.",
 "thag2.17:2.1": "Эту недостаток-опасность узнав,",
 "thag2.17:2.2": "в почитаниях великая тревога;",
 "thag2.17:2.3": "Малообретающий не расплывшийся,",
 "thag2.17:2.4": "памятующий монах пусть странствует”.",
 "thag2.17:2.5": "… Старший монах Тисса …."
}
