{
 "thag1.30:0.1": "Стихи старших монахов 1.30",
 "thag1.30:0.2": "Раздел из одного",
 "thag1.30:0.3": "Раздел Третий",
 "thag1.30:0.4": "Стихи старшего монаха Уттии",
 "thag1.30:1.1": "“Когда недуг у меня возник,",
 "thag1.30:1.2": "памятование у меня возникло;",
 "thag1.30:1.3": "Недуг у меня возник,",
 "thag1.30:1.4": "время мне не быть беспечным”.",
 "thag1.30:1.5": "… Старший монах Уттия …",
 "thag1.30:1.6": "раздел третий.",
 "thag1.30:2.0": "Оглавление",
 "thag1.30:2.1": "Нигродха Читтака старший монах,",
 "thag1.30:2.2": "старший монах Госала Сутагандха;",
 "thag1.30:2.3": "Нандия Абхая старший монах,",
 "thag1.30:2.4": "старший монах Ломасакангия;",
 "thag1.30:2.5": "Джамбугамикапутта также,",
 "thag1.30:2.6": "Харита Уттия — так."
}
