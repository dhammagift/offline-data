{
 "thag5.5:0.1": "Стихи старших монахов 5.5",
 "thag5.5:0.2": "Пятое собрание",
 "thag5.5:0.3": "Глава первая",
 "thag5.5:0.4": "Стихи старшего монаха Ваддхи",
 "thag5.5:1.1": "«Хорошо ведь, поистине, моя мать,",
 "thag5.5:1.2": "Побуждение показала;",
 "thag5.5:1.3": "Чьё я выражение услышав,",
 "thag5.5:1.4": "Наставлённый родительницей;",
 "thag5.5:1.5": "Решительный, решительный,",
 "thag5.5:1.6": "Достиг пробуждения высочайшего.",
 "thag5.5:2.1": "Архат я, достойный-даров,",
 "thag5.5:2.2": "тройной знающий, бессмертного видящий;",
 "thag5.5:2.3": "Одолев Намучи войско,",
 "thag5.5:2.4": "пребываю без истечений.",
 "thag5.5:3.1": "Внутренне и внешне,",
 "thag5.5:3.2": "которые меня пронзили истечения;",
 "thag5.5:3.3": "Все без остатка отсечены,",
 "thag5.5:3.4": "и не возникают снова.",
 "thag5.5:4.1": "Уверенная ведь, сестрица,",
 "thag5.5:4.2": "этот-смысл-цель-пользу произнесла;",
 "thag5.5:4.3": "«Желание ведь, верно, во мне,",
 "thag5.5:4.4": "запутанность твоя не различается».",
 "thag5.5:5.1": "Предел положен боли,",
 "thag5.5:5.2": "последнее это тело-массив;",
 "thag5.5:5.3": "Рождение-умирание-круговорот,",
 "thag5.5:5.4": "отныне нет повторной вовлеченности-[индивидуального] существования”.",
 "thag5.5:5.5": "… Старший монах Ваддха …."
}
