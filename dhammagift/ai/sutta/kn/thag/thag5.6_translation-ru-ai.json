{
 "thag5.6:0.1": "Стихи старших монахов 5.6",
 "thag5.6:0.2": "Пятое собрание",
 "thag5.6:0.3": "Глава первая",
 "thag5.6:0.4": "Стихи старшего монаха Нади-Кассапы",
 "thag5.6:1.1": "“К благу-смыслу-цели, вот, мне Будда,",
 "thag5.6:1.2": "к реке Неранджаре пришёл;",
 "thag5.6:1.3": "Услышав которую Дхамму,",
 "thag5.6:1.4": "ошибочный взгляд я отбросил.",
 "thag5.6:2.1": "Я совершал высокие и низкие жертвоприношения,",
 "thag5.6:2.2": "огненное жертвоприношение я совершал;",
 "thag5.6:2.3": "‘Это очищение’ — так думая,",
 "thag5.6:2.4": "слепым обыватель.",
 "thag5.6:3.1": "В воззрений-чащу войдя,",
 "thag5.6:3.2": "привязанностью обманутый;",
 "thag5.6:3.3": "Нечистое я считал чистым,",
 "thag5.6:3.4": "ослепший, невежественный.",
 "thag5.6:4.1": "Ошибочный взгляд покинут мной,",
 "thag5.6:4.2": "вовлеченности все разбиты;",
 "thag5.6:4.3": "Я совершаю достойной-даров огненное жертвоприношение,",
 "thag5.6:4.4": "почитаю Татхагату.",
 "thag5.6:5.1": "Заблуждения все покинуты мной,",
 "thag5.6:5.2": "бытия-цепляние разбито;",
 "thag5.6:5.3": "Исчерпан рождение-круговорот,",
 "thag5.6:5.4": "отныне нет повторной вовлеченности-[индивидуального] существования”.",
 "thag5.6:5.5": "… Старший монах Нади-Кассапа …."
}
