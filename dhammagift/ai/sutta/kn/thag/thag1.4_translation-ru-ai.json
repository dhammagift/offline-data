{
 "thag1.4:0.1": "Стихи старших монахов 1.4",
 "thag1.4:0.2": "Раздел из одного",
 "thag1.4:0.3": "Глава первая",
 "thag1.4:0.4": "Стихи старшего монаха Пунны",
 "thag1.4:1.1": "“С чистыми только сходитесь,",
 "thag1.4:1.2": "мудрецами, видящими благо;",
 "thag1.4:1.3": "Благо великое, глубокое,",
 "thag1.4:1.4": "трудно-видимое, тонкое, мельчайшее;",
 "thag1.4:1.5": "Мудрые достигают,",
 "thag1.4:1.6": "не-беспечные, проницательные.",
 "thag1.4:1.7": "Так действительно уважаемый старший монах Пунна Мантанипутта эту строфу произнёс."
}
