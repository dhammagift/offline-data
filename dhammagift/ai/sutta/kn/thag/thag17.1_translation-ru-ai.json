{
 "thag17.1:0.1": "Стихи старших монахов 17.1",
 "thag17.1:0.2": "Тридцать стихов",
 "thag17.1:0.3": "Глава первая",
 "thag17.1:0.4": "Стихи старшего монаха Пхуссы",
 "thag17.1:1.1": "Много приятных увидев,",
 "thag17.1:1.2": "развитых, хорошо сдержанных;",
 "thag17.1:1.3": "Мудрец Пандарасаготта,",
 "thag17.1:1.4": "спросил Пхуссу по имени.",
 "thag17.1:2.1": "«С каким импульсом, с какой целью,",
 "thag17.1:2.2": "с каким обликом будут;",
 "thag17.1:2.3": "в грядущем времени,",
 "thag17.1:2.4": "то мне скажи, спрошенный».",
 "thag17.1:3.1": "«Слушай слово моё,",
 "thag17.1:3.2": "мудрец Пандараса по имени;",
 "thag17.1:3.3": "Тщательно восприми,",
 "thag17.1:3.4": "расскажу грядущее.",
 "thag17.1:4.1": "Ворчливые и злопамятные,",
 "thag17.1:4.2": "умаляющие, упрямые, хитрые многие;",
 "thag17.1:4.3": "Суетливые и разноречивые,",
 "thag17.1:4.4": "будут в грядущем.",
 "thag17.1:5.1": "Мнящие себя знающими в явлениях,",
 "thag17.1:5.2": "глубоких, на дальнем берегу пребывающие;",
 "thag17.1:5.3": "Легкомысленные, не уважающие явления,",
 "thag17.1:5.4": "друг к другу без почтения.",
 "thag17.1:6.1": "Много опасностей в мире,",
 "thag17.1:6.2": "возникнут в будущем;",
 "thag17.1:6.3": "Хорошо-указанное это Учение,",
 "thag17.1:6.4": "загрязнят глупые.",
 "thag17.1:7.1": "Лишённые качеств в Сангхе,",
 "thag17.1:7.2": "выступая уверенно;",
 "thag17.1:7.3": "Сильными будут,",
 "thag17.1:7.4": "крикливые, неучёные.",
 "thag17.1:8.1": "Обладающие качествами же в Сангхе,",
 "thag17.1:8.2": "выступая по-настоящему;",
 "thag17.1:8.3": "Слабыми те будут,",
 "thag17.1:8.4": "стыдливые, бесцельные.",
 "thag17.1:9.1": "Серебро, золото",
 "thag17.1:9.2": "поле, участок, коз и овец;",
 "thag17.1:9.3": "Рабов и рабынь глупые,",
 "thag17.1:9.4": "будут принимать в будущем.",
 "thag17.1:10.1": "Недовольные-сознающие глупцы,",
 "thag17.1:10.2": "в принципах не-сосредоточенные;",
 "thag17.1:10.3": "Надменными будут ходить,",
 "thag17.1:10.4": "в ссорах радующиеся, как олени.",
 "thag17.1:11.1": "Возбуждёнными-взволнованными будут,",
 "thag17.1:11.2": "в синие одежды одетые;",
 "thag17.1:11.3": "Обманщики упрямые болтуны хвастуны,",
 "thag17.1:11.4": "будут ходить, словно благородные.",
 "thag17.1:12.1": "С волосами, как масло,",
 "thag17.1:12.2": "суетливые, с подведёнными глазами;",
 "thag17.1:12.3": "По дорогам пойдут",
 "thag17.1:12.4": "Цвета зуба покрыты.",
 "thag17.1:13.1": "Не-отвращение к освобождённым,",
 "thag17.1:13.2": "сильно-окрашенным знаменем араханта;",
 "thag17.1:13.3": "Будут отвращаться от охряного,",
 "thag17.1:13.4": "в белых застрявшие.",
 "thag17.1:14.1": "Желающие приобретения будут,",
 "thag17.1:14.2": "ленивые, слабой решимости;",
 "thag17.1:14.3": "Трудясь в лесных местах,",
 "thag17.1:14.4": "вблизи деревень будут жить.",
 "thag17.1:15.1": "Какие-либо приобретение получат,",
 "thag17.1:15.2": "неправильно-живущие всегда;",
 "thag17.1:15.3": "Именно их подражая,",
 "thag17.1:15.4": "будут следовать несдержанные.",
 "thag17.1:16.1": "Какие-либо не-получающие приобретение,",
 "thag17.1:16.2": "не будут почитаемы;",
 "thag17.1:16.3": "Даже очень мягких тех стойких,",
 "thag17.1:16.4": "не будут тогда обслуживать.",
 "thag17.1:17.1": "Краской милаккху окрашенное,",
 "thag17.1:17.2": "порицая своё знамя;",
 "thag17.1:17.3": "Знамя титтхиев некоторые,",
 "thag17.1:17.4": "будут носить белое.",
 "thag17.1:18.1": "И не-почтение к охряному,",
 "thag17.1:18.2": "тогда у них будет;",
 "thag17.1:18.3": "И размышление об охряном,",
 "thag17.1:18.4": "у монахов не будет.",
 "thag17.1:19.1": "Одолённого болью,",
 "thag17.1:19.2": "стрелой пронзённого, терзающегося;",
 "thag17.1:19.3": "Обдумывания великие ужасные,",
 "thag17.1:19.4": "у слона были непостижимы.",
 "thag17.1:20.1": "Шестибивневый ведь тогда увидев,",
 "thag17.1:20.2": "сильно-окрашенным знаменем араханта;",
 "thag17.1:20.3": "Тотчас же произнёс строфы,",
 "thag17.1:20.4": "слон, с благом-смыслом-целью связанные.",
 "thag17.1:21.1": "‘С нечистотами охру,",
 "thag17.1:21.2": "кто одежду наденет;",
 "thag17.1:21.3": "Лишённый самообладания-и-правдивости,",
 "thag17.1:21.4": "не тот охряной-одежды достоин.",
 "thag17.1:22.1": "А кто с отброшенной-грязью,",
 "thag17.1:22.2": "в нравственности хорошо-сосредоточенный;",
 "thag17.1:22.3": "Наделённый самообладанием-и-правдивостью,",
 "thag17.1:22.4": "тот воистину охряной-одежды достоин.",
 "thag17.1:23.1": "С испорченными принципами глупый,",
 "thag17.1:23.2": "явный, по желанию поступающий;",
 "thag17.1:23.3": "С растерянным умом, безрадостный,",
 "thag17.1:23.4": "не тот охряной-одежды достоин.",
 "thag17.1:24.1": "А кто нравственностью наделённый,",
 "thag17.1:24.2": "без страсти, собранный;",
 "thag17.1:24.3": "С белыми намерениями,",
 "thag17.1:24.4": "тот воистину охряной-одежды достоин.",
 "thag17.1:25.1": "Взбудораженный, надменный глупец,",
 "thag17.1:25.2": "принципов у которого не различается;",
 "thag17.1:25.3": "Белого достоин,",
 "thag17.1:25.4": "охру что сделает.",
 "thag17.1:26.1": "Монахи и монахини,",
 "thag17.1:26.2": "с испорченным умом, неуважительные;",
 "thag17.1:26.3": "Таких с мирным умом,",
 "thag17.1:26.4": "будут сдерживать в будущем.",
 "thag17.1:27.1": "И обучаемые старшими,",
 "thag17.1:27.2": "глупые ношение одеяния;",
 "thag17.1:27.3": "Не услышат глупые,",
 "thag17.1:27.4": "явные в желании-делании.",
 "thag17.1:28.1": "Те так натренированные глупые,",
 "thag17.1:28.2": "друг к другу без уважения;",
 "thag17.1:28.3": "Не примут наставника,",
 "thag17.1:28.4": "как необъезженный конь возницу.",
 "thag17.1:29.1": "Так в грядущем времени,",
 "thag17.1:29.2": "практика будет;",
 "thag17.1:29.3": "Монахов и монахинь,",
 "thag17.1:29.4": "в сроке последнем.’",
 "thag17.1:30.1": "Пока не придёт это,",
 "thag17.1:30.2": "грядущая великая угроза;",
 "thag17.1:30.3": "Послушными будьте, мягкими,",
 "thag17.1:30.4": "друг к другу с уважением.",
 "thag17.1:31.1": "С мирным умом, сострадательные,",
 "thag17.1:31.2": "Будьте в принципах сдержанны;",
 "thag17.1:31.3": "Решительно-старающиеся, решительные,",
 "thag17.1:31.4": "Всегда с твёрдым усердием.",
 "thag17.1:32.1": "Беспечность как угрозу увидев,",
 "thag17.1:32.2": "и не-беспечность как безопасность;",
 "thag17.1:32.3": "Развивайте восьмичастный путь,",
 "thag17.1:32.4": "достигая бессмертной стопы”.",
 "thag17.1:32.5": "… Пхуссо Тхера …."
}
