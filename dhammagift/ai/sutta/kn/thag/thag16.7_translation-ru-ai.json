{
 "thag16.7:0.1": "Стихи старших монахов 16.7",
 "thag16.7:0.2": "Двадцати-глава",
 "thag16.7:0.3": "Глава первая",
 "thag16.7:0.4": "Стихи старшего монаха Бхаддии, сына Калигодхи",
 "thag16.7:1.1": "«На слоне ездил я,",
 "thag16.7:1.2": "тонкие одежды носились;",
 "thag16.7:1.3": "Горный рис елся,",
 "thag16.7:1.4": "с чистым мясом приправленный.",
 "thag16.7:2.1": "Теперь же Бхадда — постоянный,",
 "thag16.7:2.2": "в собранном в чашу радующийся;",
 "thag16.7:2.3": "Зажгётся без-поддерживания,",
 "thag16.7:2.4": "сын Годхи Бхаддия.",
 "thag16.7:3.1": "В отброшенные тряпки одетый — постоянный,",
 "thag16.7:3.2": "в собранном в чашу радующийся;",
 "thag16.7:3.3": "Зажгётся без-поддерживания,",
 "thag16.7:3.4": "сын Годхи Бхаддия.",
 "thag16.7:4.1": "Собирающий подаяние — постоянный,",
 "thag16.7:4.2": "…",
 "thag16.7:4.3": "…",
 "thag16.7:4.4": "…",
 "thag16.7:5.1": "В тройное одеяние одетый — постоянный,",
 "thag16.7:5.2": "…",
 "thag16.7:5.3": "…",
 "thag16.7:5.4": "…",
 "thag16.7:6.1": "Ходящий по порядку — постоянный,",
 "thag16.7:6.2": "…",
 "thag16.7:6.3": "…",
 "thag16.7:6.4": "…",
 "thag16.7:7.1": "Односедящий — постоянный,",
 "thag16.7:7.2": "…",
 "thag16.7:7.3": "…",
 "thag16.7:7.4": "…",
 "thag16.7:8.1": "Из чаши едящий — постоянный,",
 "thag16.7:8.2": "…",
 "thag16.7:8.3": "…",
 "thag16.7:8.4": "…",
 "thag16.7:9.1": "После еды не принимающий — постоянный,",
 "thag16.7:9.2": "…",
 "thag16.7:9.3": "…",
 "thag16.7:9.4": "…",
 "thag16.7:10.1": "Лесной — постоянный,",
 "thag16.7:10.2": "…",
 "thag16.7:10.3": "…",
 "thag16.7:10.4": "…",
 "thag16.7:11.1": "У корня дерева — постоянный,",
 "thag16.7:11.2": "…",
 "thag16.7:11.3": "…",
 "thag16.7:11.4": "…",
 "thag16.7:12.1": "Под открытым небом — постоянный,",
 "thag16.7:12.2": "…",
 "thag16.7:12.3": "…",
 "thag16.7:12.4": "…",
 "thag16.7:13.1": "На кладбище — постоянный,",
 "thag16.7:13.2": "…",
 "thag16.7:13.3": "…",
 "thag16.7:13.4": "…",
 "thag16.7:14.1": "Как постелено — постоянный,",
 "thag16.7:14.2": "…",
 "thag16.7:14.3": "…",
 "thag16.7:14.4": "…",
 "thag16.7:15.1": "Сидящий-на-сидении постоянный,",
 "thag16.7:15.2": "…",
 "thag16.7:15.3": "…",
 "thag16.7:15.4": "…",
 "thag16.7:16.1": "Мало-желающий постоянный,",
 "thag16.7:16.2": "…",
 "thag16.7:16.3": "…",
 "thag16.7:16.4": "…",
 "thag16.7:17.1": "Удовлетворённый постоянный,",
 "thag16.7:17.2": "…",
 "thag16.7:17.3": "…",
 "thag16.7:17.4": "…",
 "thag16.7:18.1": "Уединённый постоянный,",
 "thag16.7:18.2": "…",
 "thag16.7:18.3": "…",
 "thag16.7:18.4": "…",
 "thag16.7:19.1": "Не-смешанный постоянный,",
 "thag16.7:19.2": "…",
 "thag16.7:19.3": "…",
 "thag16.7:19.4": "…",
 "thag16.7:20.1": "Решительный постоянный,",
 "thag16.7:20.2": "…",
 "thag16.7:20.3": "…",
 "thag16.7:20.4": "…",
 "thag16.7:21.1": "Оставив сто-палую чашу,",
 "thag16.7:21.2": "золотую сто-полосную;",
 "thag16.7:21.3": "Взял я глиняную чашу,",
 "thag16.7:21.4": "это второе-посвящение.",
 "thag16.7:22.1": "Высокие круглые стены,",
 "thag16.7:22.2": "прочные башни-крепости;",
 "thag16.7:22.3": "Охраняемый меченосцами,",
 "thag16.7:22.4": "в страхе пребывал я в городе.",
 "thag16.7:23.1": "Теперь же благостный, без-страха,",
 "thag16.7:23.2": "покинув-страх-и-трепет;",
 "thag16.7:23.3": "Зажёгшись, в лес погрузившись,",
 "thag16.7:23.4": "сын Годхи Бхаддия.",
 "thag16.7:24.1": "На нравственность-совокупность опершись,",
 "thag16.7:24.2": "памятование и понимание развивая;",
 "thag16.7:24.3": "Достиг я постепенно,",
 "thag16.7:24.4": "всех-связанностей-исчерпания”.",
 "thag16.7:24.5": "… Бхаддия, сын Калигодхи, старший монах …."
}
