{
 "thag1.27:0.1": "Стихи старших монахов 1.27",
 "thag1.27:0.2": "Раздел из одного",
 "thag1.27:0.3": "Раздел Третий",
 "thag1.27:0.4": "Стихи старшего монаха Ломасакангии",
 "thag1.27:1.1": "“Дарбу, кушу, потакилу,",
 "thag1.27:1.2": "усиру, мунджу и паббаджу;",
 "thag1.27:1.3": "Грудью отодвину,",
 "thag1.27:1.4": "уединение взращивая”.",
 "thag1.27:1.5": "… Старший монах Ломасакангия …."
}
