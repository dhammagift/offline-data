{
 "thag1.16:0.1": "Стихи старших монахов 1.16",
 "thag1.16:0.2": "Раздел из одного",
 "thag1.16:0.3": "Вторая Глава",
 "thag1.16:0.4": "Старший монах Белаттхасиса",
 "thag1.16:1.1": "“Как хороший скакун,",
 "thag1.16:1.2": "плуга-поворотный быстр;",
 "thag1.16:1.3": "Идёт без усилий,",
 "thag1.16:1.4": "так ночи-дни мои;",
 "thag1.16:1.5": "Идут без усилий,",
 "thag1.16:1.6": "при приятном полученном не-плотском”.",
 "thag1.16:1.7": "… Старший монах Белаттхасиса …."
}
