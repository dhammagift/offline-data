{
 "thag1.58:0.1": "Стихи старших монахов 1.58",
 "thag1.58:0.2": "Раздел из одного",
 "thag1.58:0.3": "Шестая глава",
 "thag1.58:0.4": "Раманиякутикатхерагатха",
 "thag1.58:1.1": "«Приятна мне хижина,",
 "thag1.58:1.2": "Верой данная, радующая ум;",
 "thag1.58:1.3": "Нет у меня нужды в девушках,",
 "thag1.58:1.4": "У кого нужда — туда идите, женщины».",
 "thag1.58:1.5": "… Раманиякутико тхера …."
}
