{
 "thag6.13:0.1": "Стихи старших монахов 6.13",
 "thag6.13:0.2": "Глава шестых",
 "thag6.13:0.3": "Глава первая",
 "thag6.13:0.4": "Стихи старшего монаха Сириманды",
 "thag6.13:1.1": "“Закрытое переполняется,",
 "thag6.13:1.2": "открытое не переполняется;",
 "thag6.13:1.3": "Поэтому закрытое открывайте,",
 "thag6.13:1.4": "так это не переполняет.",
 "thag6.13:2.1": "Смертью поражён свет,",
 "thag6.13:2.2": "старением окружён;",
 "thag6.13:2.3": "Копьём-цеплянием пронзён,",
 "thag6.13:2.4": "желанием окутан всегда.",
 "thag6.13:3.1": "Смертью поражён свет,",
 "thag6.13:3.2": "окружён старением и;",
 "thag6.13:3.3": "Избивается постоянно беззащитный,",
 "thag6.13:3.4": "как палкой поражённый змей.",
 "thag6.13:4.1": "Приходят как груды огня,",
 "thag6.13:4.2": "смерть, болезнь, старение — трое;",
 "thag6.13:4.3": "Выйти навстречу силы нет,",
 "thag6.13:4.4": "скорости нет убежать.",
 "thag6.13:5.1": "Не напрасно день проводи,",
 "thag6.13:5.2": "малым или многим;",
 "thag6.13:5.3": "Что что оставляет ночь,",
 "thag6.13:5.4": "то убавлено того жизни.",
 "thag6.13:6.1": "Идущего или стоящего,",
 "thag6.13:6.2": "сидящего или лежащего;",
 "thag6.13:6.3": "Приближается последняя ночь,",
 "thag6.13:6.4": "не тебе время беспечным быть”.",
 "thag6.13:6.5": "… Старший Сириманда …."
}
