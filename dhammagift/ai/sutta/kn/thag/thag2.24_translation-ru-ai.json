{
 "thag2.24:0.1": "Стихи старших монахов 2.24",
 "thag2.24:0.2": "Двойное собрание",
 "thag2.24:0.3": "Раздел Третий",
 "thag2.24:0.4": "Стихи старшего монаха Валлии",
 "thag2.24:1.1": "“Что должно быть сделано с крепкой решимостью,",
 "thag2.24:1.2": "что должно быть сделано желающим пробудиться;",
 "thag2.24:1.3": "Я сделаю, не подведу,",
 "thag2.24:1.4": "узри решимость, упорство.",
 "thag2.24:2.1": "И ты мне путь укажи,",
 "thag2.24:2.2": "тропу, что имеет Бессмертное своим основанием;",
 "thag2.24:2.3": "Я молчанием молчаливого достигну,",
 "thag2.24:2.4": "как поток Ганги — океан”.",
 "thag2.24:2.5": "… Старший монах Валлия …."
}
