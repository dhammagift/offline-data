{
 "thag1.48:0.1": "Стихи старших монахов 1.48",
 "thag1.48:0.2": "Раздел из одного",
 "thag1.48:0.3": "Пятая глава",
 "thag1.48:0.4": "Стихи старшего монаха Санджаи",
 "thag1.48:1.1": "“С тех пор как я ушёл в бездомность,",
 "thag1.48:1.2": "Из дома в бездомность;",
 "thag1.48:1.3": "Не припоминаю намерения,",
 "thag1.48:1.4": "Неблагородного, злобу-содержащего”.",
 "thag1.48:1.5": "… Старший монах Санджая …."
