{
 "thag2.7:0.1": "Стихи старших монахов 2.7",
 "thag2.7:0.2": "Двойное собрание",
 "thag2.7:0.3": "Глава первая",
 "thag2.7:0.4": "Стихи старшего монаха Радхи",
 "thag2.7:1.1": "«Как дом с плохой крышей,",
 "thag2.7:1.2": "дождь пронизывает;",
 "thag2.7:1.3": "Так неразвитое ум-состояние,",
 "thag2.7:1.4": "страсть пронизывает.",
 "thag2.7:2.1": "Как дом с хорошей крышей,",
 "thag2.7:2.2": "Дождь не проникает;",
 "thag2.7:2.3": "Так хорошо развитое ум-состояние,",
 "thag2.7:2.4": "Страсть не проникает».",
 "thag2.7:2.5": "… Старший монах Радха …."
}
