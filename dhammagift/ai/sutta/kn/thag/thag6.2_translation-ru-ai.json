{
 "thag6.2:0.1": "Стихи старших монахов 6.2",
 "thag6.2:0.2": "Глава шестых",
 "thag6.2:0.3": "Глава первая",
 "thag6.2:0.4": "Стихи старшего монаха Текиччакари",
 "thag6.2:1.1": "“Закрыты рисовые зёрна,",
 "thag6.2:1.2": "на току — салфовый рис;",
 "thag6.2:1.3": "И не получу я подаяния,",
 "thag6.2:1.4": "как же я проживу?”.",
 "thag6.2:2.1": "“Пробуждённого неизмеримого вспоминай, доверчивый,",
 "thag6.2:2.2": "Упоением наполненным телом будешь, постоянно радостный.",
 "thag6.2:3.1": "Дхамму неизмеримую вспоминай, доверчивый,",
 "thag6.2:3.2": "Упоением наполненным телом будешь, постоянно радостный.",
 "thag6.2:4.1": "Сангху неизмеримую вспоминай, доверчивый,",
 "thag6.2:4.2": "Упоением наполненным телом будешь, постоянно радостный”.",
 "thag6.2:5.1": "“Под открытым небом пребываешь,",
 "thag6.2:5.2": "Холодны эти зимние ночи;",
 "thag6.2:5.3": "Не дай холоду одолев измучить тебя,",
 "thag6.2:5.4": "Войди ты в обитель с закрытыми засовами”.",
 "thag6.2:6.1": "“Я коснусь четырёх безмерных,",
 "thag6.2:6.2": "Ими счастливо пребуду;",
 "thag6.2:6.3": "Не буду я холодом измучен,",
 "thag6.2:6.4": "Непоколебимым пребывая”.",
 "thag6.2:6.5": "… Старший монах Текиччакари …."
}
