{
 "thag1.117:0.1": "Стихи старших монахов 1.117",
 "thag1.117:0.2": "Раздел из одного",
 "thag1.117:0.3": "Двенадцатый раздел",
 "thag1.117:0.4": "Стихи старшего монаха Ясы",
 "thag1.117:1.1": "“Хорошо умащённый, хорошо одетый,",
 "thag1.117:1.2": "всеми украшениями украшенный;",
 "thag1.117:1.3": "Три знания я достиг,",
 "thag1.117:1.4": "исполнено Будды указание”.",
 "thag1.117:1.5": "… Старший монах Яса …."
}
