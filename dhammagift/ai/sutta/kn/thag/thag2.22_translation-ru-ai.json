{
 "thag2.22:0.1": "Стихи старших монахов 2.22",
 "thag2.22:0.2": "Двойное собрание",
 "thag2.22:0.3": "Раздел Третий",
 "thag2.22:0.4": "Стихи старшего монаха Бхаддаджи",
 "thag2.22:1.1": "«Панада имя тот царь,",
 "thag2.22:1.2": "у которого столб золотой;",
 "thag2.22:1.3": "Поперек шестнадцать локтей,",
 "thag2.22:1.4": "вверх же, говорят, тысячечастный.",
 "thag2.22:2.1": "Тысячеветвистый, стократный,",
 "thag2.22:2.2": "с флагами, из зелёного камня;",
 "thag2.22:2.3": "Танцевали там гандхаббы,",
 "thag2.22:2.4": "шесть тысяч семичастно».",
 "thag2.22:2.5": "… Бхаддаджи старший монах …."
}
