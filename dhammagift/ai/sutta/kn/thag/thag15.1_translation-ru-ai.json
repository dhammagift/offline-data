{
 "thag15.1:0.1": "Стихи старших монахов 15.1",
 "thag15.1:0.2": "Раздел шестнадцати",
 "thag15.1:0.3": "Глава первая",
 "thag15.1:0.4": "Стихи старшего монаха Анньясиконданньи",
 "thag15.1:1.1": "“Этот ещё больше успокаиваюсь,",
 "thag15.1:1.2": "услышав явление великого вкуса;",
 "thag15.1:1.3": "Бесстрастие-неочарованность изложено явление,",
 "thag15.1:1.4": "без подпитки всецело”.",
 "thag15.1:2.1": "“Много на свете красивостей,",
 "thag15.1:2.2": "в этом земном-круге;",
 "thag15.1:2.3": "Сминают, думается, устремление,",
 "thag15.1:2.4": "привлекательное, со страстью связанное.",
 "thag15.1:3.1": "Пылинка же ветром,",
 "thag15.1:3.2": "как после утихания тучи;",
 "thag15.1:3.3": "Так утихают устремления,",
 "thag15.1:3.4": "когда пониманием видит.",
 "thag15.1:4.1": "Все отождествления ненадёжны,”,",
 "thag15.1:4.2": "когда пониманием видит;",
 "thag15.1:4.3": "Тогда теряет интерес к боли,",
 "thag15.1:4.4": "это путь очищения.",
 "thag15.1:5.1": "Все отождествления — боль,”,",
 "thag15.1:5.2": "когда пониманием видит;",
 "thag15.1:5.3": "Тогда теряет интерес к боли,",
 "thag15.1:5.4": "это путь очищения.",
 "thag15.1:6.1": "Все явления — без-личность,”,",
 "thag15.1:6.2": "когда пониманием видит;",
 "thag15.1:6.3": "Тогда теряет интерес к боли,",
 "thag15.1:6.4": "это путь очищения.",
 "thag15.1:7.1": "Пробуждённым-пробуждённый который старший,",
 "thag15.1:7.2": "Конданья, с сильным усердием;",
 "thag15.1:7.3": "Отбросивший рождение и умирание,",
 "thag15.1:7.4": "святой жизни достигший.",
 "thag15.1:8.1": "Затопления-силок, крепкая суета,",
 "thag15.1:8.2": "Скала трудно-раскалываемая;",
 "thag15.1:8.3": "Отсекши суету и силок,",
 "thag15.1:8.4": "Скалу разбив трудно-раскалываемую;",
 "thag15.1:8.5": "Пересёкший, иного-достигший, погружённый в джхану,",
 "thag15.1:8.6": "Освобождён он от Мары-привязи.",
 "thag15.1:9.1": "Взбудораженный, неспокойный монах,",
 "thag15.1:9.2": "друзей получив плохих;",
 "thag15.1:9.3": "Погружается в великом затоплении,",
 "thag15.1:9.4": "волной накрытый.",
 "thag15.1:10.1": "Не взволнованный, не суетливый,",
 "thag15.1:10.2": "рассудительный, сдержанный в способностях;",
 "thag15.1:10.3": "Благой друг, мудрый,",
 "thag15.1:10.4": "боли-конец-делающим пусть будет.",
 "thag15.1:11.1": "Время-побега-подобный,",
 "thag15.1:11.2": "худой, с жилами, выступающими;",
 "thag15.1:11.3": "Знающий меру в еде-питье,",
 "thag15.1:11.4": "не-унывающим-умом человек.",
 "thag15.1:12.1": "Затронутый оводами и комарами,",
 "thag15.1:12.2": "в лесу, в большой чаще;",
 "thag15.1:12.3": "Слон, как на поле битвы,",
 "thag15.1:12.4": "памятующий там пусть пребывает.",
 "thag15.1:13.1": "Не радуюсь умиранию,",
 "thag15.1:13.2": "…",
 "thag15.1:13.3": "…",
 "thag15.1:13.4": "без-отравы наёмный работник как.",
 "thag15.1:14.1": "Не радуюсь умиранию,",
 "thag15.1:14.2": "…",
 "thag15.1:14.3": "…",
 "thag15.1:14.4": "сознательный, памятующий.",
 "thag15.1:15.1": "Обслужен мной Учитель,",
 "thag15.1:15.2": "…",
 "thag15.1:15.3": "…",
 "thag15.1:15.4": "с проводником к индивидуальному существованию покончено.",
 "thag15.1:16.1": "Ради какой цели покинул жизнь,",
 "thag15.1:16.2": "из дома в бездомность;",
 "thag15.1:16.3": "Эта цель мной достигнута,",
 "thag15.1:16.4": "что мне с сожителем?”.",
 "thag15.1:16.5": "… Конданья понявший старший монах …."
}
