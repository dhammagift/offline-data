{
 "thag2.44:0.1": "Стихи старших монахов 2.44",
 "thag2.44:0.2": "Двойное собрание",
 "thag2.44:0.3": "Пятая глава",
 "thag2.44:0.4": "Стихи старшего монаха Могхараджи",
 "thag2.44:1.1": "“С плохой кожей, с хорошим умом-состоянием,",
 "thag2.44:1.2": "Могхараджа, постоянно собранный;",
 "thag2.44:1.3": "Зимние холодные времена-ночи,",
 "thag2.44:1.4": "Монах, ты как будешь делать?”.",
 "thag2.44:2.1": "“С обильным урожаем Магадха,",
 "thag2.44:2.2": "целиком, так мной услышано;",
 "thag2.44:2.3": "Соломой-покрытый лёжку,",
 "thag2.44:2.4": "как другие приятно-живущие”.",
 "thag2.44:2.5": "… Старший монах Могхараджа …."
}
