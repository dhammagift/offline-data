{
 "thag2.6:0.1": "Стихи старших монахов 2.6",
 "thag2.6:0.2": "Двойное собрание",
 "thag2.6:0.3": "Глава первая",
 "thag2.6:0.4": "Стихи старшего монаха Меладжины",
 "thag2.6:1.1": "“Когда я Дхамму услышал,",
 "thag2.6:1.2": "говорящего Учителя;",
 "thag2.6:1.3": "Неуверенности не знаю,",
 "thag2.6:1.4": "всеведущего непобедимого.",
 "thag2.6:2.1": "В вожака каравана, великого героя,",
 "thag2.6:2.2": "в лучшего из возничих;",
 "thag2.6:2.3": "В пути или в практике,",
 "thag2.6:2.4": "неуверенности у меня не существует”.",
 "thag2.6:2.5": "… Старший монах Меладжина …."
}
