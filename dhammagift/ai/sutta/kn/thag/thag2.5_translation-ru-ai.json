{
 "thag2.5:0.1": "Стихи старших монахов 2.5",
 "thag2.5:0.2": "Двойное собрание",
 "thag2.5:0.3": "Глава первая",
 "thag2.5:0.4": "Стихи старшего монаха Аджины",
 "thag2.5:1.1": "“Хоть и является он трижды знающим,",
 "thag2.5:1.2": "смерть перешедшим, без истечений;",
 "thag2.5:1.3": "Неизвестным его глупые,",
 "thag2.5:1.4": "презирают незнающие.",
 "thag2.5:2.1": "А который вот еды-питья,",
 "thag2.5:2.2": "является обретающим здесь индивид;",
 "thag2.5:2.3": "Плохим по природе хоть и является,",
 "thag2.5:2.4": "тот им является почитаемым”.",
 "thag2.5:2.5": "… Старший монах Аджина …."
}
