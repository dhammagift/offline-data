{
 "thag1.43:0.1": "Стихи старших монахов 1.43",
 "thag1.43:0.2": "Раздел из одного",
 "thag1.43:0.3": "Пятая глава",
 "thag1.43:0.4": "Стихи старшего монаха Сумангалы",
 "thag1.43:1.1": "«Хорошо освобождён, хорошо освобождён,",
 "thag1.43:1.2": "Хорошо, хорошо освобождён я от трёх горбатых;",
 "thag1.43:1.3": "Мои серпы, мои плуги,",
 "thag1.43:1.4": "Мои маленькие мотыги.",
 "thag1.43:1.5": "Если даже здесь, здесь,",
 "thag1.43:1.6": "Или же достаточно, достаточно;",
 "thag1.43:1.7": "Зажгись, Сумангала, зажгись, Сумангала,",
 "thag1.43:1.8": "Неопьянённый пребывай, Сумангала».",
 "thag1.43:1.9": "… Старший монах Сумангала …."
}
