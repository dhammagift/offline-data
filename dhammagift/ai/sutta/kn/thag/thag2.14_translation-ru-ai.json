{
 "thag2.14:0.1": "Стихи старших монахов 2.14",
 "thag2.14:0.2": "Двойное собрание",
 "thag2.14:0.3": "Вторая Глава",
 "thag2.14:0.4": "Стихи старшего монаха Сомамитты",
 "thag2.14:1.1": "“На маленькое бревно взобравшись,",
 "thag2.14:1.2": "как тонет в великом океане;",
 "thag2.14:1.3": "Так с ленивым сойдясь,",
 "thag2.14:1.4": "благо-живущий также тонет;",
 "thag2.14:1.5": "Поэтому то следует избегать,",
 "thag2.14:1.6": "ленивого, низкой решимости.",
 "thag2.14:2.1": "С уединёнными благородными,",
 "thag2.14:2.2": "устремлёнными зажжёнными;",
 "thag2.14:2.3": "Всегда с утверждённой решимостью,",
 "thag2.14:2.4": "с мудрецами следует жить”.",
 "thag2.14:2.5": "… старший монах Сомамитта …."
}
