{
 "thag1.108:0.1": "Стихи старших монахов 1.108",
 "thag1.108:0.2": "Раздел из одного",
 "thag1.108:0.3": "Глава одиннадцатая",
 "thag1.108:0.4": "Стихи старшего монаха Дхаммасавапиту",
 "thag1.108:1.1": "“Сто двадцать лет мне,",
 "thag1.108:1.2": "покинул жизнь в бездомность;",
 "thag1.108:1.3": "Три знания достигнуты,",
 "thag1.108:1.4": "исполнено Будды указание”.",
 "thag1.108:1.5": "… Старший монах Дхаммасавапиту …."
}
