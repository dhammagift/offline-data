{
 "thag1.101:0.1": "Стихи старших монахов 1.101",
 "thag1.101:0.2": "Раздел из одного",
 "thag1.101:0.3": "Глава одиннадцатая",
 "thag1.101:0.4": "Стихи старшего монаха Белаттханики",
 "thag1.101:1.1": "“Оставив домохозяйство, не завершив,",
 "thag1.101:1.2": "С болтливым ртом, чревоугодник, ленивый;",
 "thag1.101:1.3": "Как большой-кабан откормленный-на-выгоне,",
 "thag1.101:1.4": "Снова-и-снова в лоно входит тупой”.",
 "thag1.101:1.5": "… Старший монах Белаттханика …."
}
