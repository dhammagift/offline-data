{
 "thag17.3:0.1": "Стихи старших монахов 17.3",
 "thag17.3:0.2": "Тридцать стихов",
 "thag17.3:0.3": "Глава первая",
 "thag17.3:0.4": "Стихи старшего монаха Ананды",
 "thag17.3:1.1": "«С клеветником и гневливым,",
 "thag17.3:1.2": "С жадным и радующимся разрушению;",
 "thag17.3:1.3": "Дружбу не заводил бы мудрец,",
 "thag17.3:1.4": "Плох с подлым человеком общение.",
 "thag17.3:2.1": "С верующим и приятным,",
 "thag17.3:2.2": "С понимающим, многоучёным;",
 "thag17.3:2.3": "Дружбу заводил бы мудрец,",
 "thag17.3:2.4": "Благ с чистым человеком общение.",
 "thag17.3:3.1": "Взгляни на искусно сделанный образ,",
 "thag17.3:3.2": "…",
 "thag17.3:3.3": "…",
 "thag17.3:3.4": "у которого нет постоянного пребывания.",
 "thag17.3:4.1": "Взгляни на искусно сделанный образ,",
 "thag17.3:4.2": "…",
 "thag17.3:4.3": "…",
 "thag17.3:4.4": "одеждами сияет.",
 "thag17.3:5.1": "Лаком окрашена,",
 "thag17.3:5.2": "…",
 "thag17.3:5.3": "…",
 "thag17.3:5.4": "но не ищущего запредельного.",
 "thag17.3:6.1": "Восьмиполосная,",
 "thag17.3:6.2": "…",
 "thag17.3:6.3": "…",
 "thag17.3:6.4": "но не ищущего запредельного.",
 "thag17.3:7.1": "Как новая коробочка для сурьмы,",
 "thag17.3:7.2": "…",
 "thag17.3:7.3": "…",
 "thag17.3:7.4": "но не ищущего запредельного.",
 "thag17.3:8.1": "Многоучёный, красноречивый,",
 "thag17.3:8.2": "Будды прислужник;",
 "thag17.3:8.3": "Сбросивший ношу, отвязанный,",
 "thag17.3:8.4": "ложе организует Готама.",
 "thag17.3:9.1": "С истощёнными истечениями, отвязанный,",
 "thag17.3:9.2": "Вышедший за пределы привязанностей, полностью угасший;",
 "thag17.3:9.3": "Несёт последнее тело,",
 "thag17.3:9.4": "достигший конца рождения и умирания.",
 "thag17.3:10.1": "В котором установлены явления,",
 "thag17.3:10.2": "Пробуждённым, Солнца-родича;",
 "thag17.3:10.3": "На пути, ведущем к ниббане,",
 "thag17.3:10.4": "этот вот стоит Готама.",
 "thag17.3:11.1": "Восемьдесят две от Пробуждённого взял,",
 "thag17.3:11.2": "две тысячи от монахов;",
 "thag17.3:11.3": "Восемьдесят четыре тысячи,",
 "thag17.3:11.4": "которые мне явления передавались.",
 "thag17.3:12.1": "Малоуслышавший этот человек,",
 "thag17.3:12.2": "как бык-вьючный стареет;",
 "thag17.3:12.3": "Мяса его возрастают,",
 "thag17.3:12.4": "понимание его не возрастает.",
 "thag17.3:13.1": "Многоучёный малоучёного,",
 "thag17.3:13.2": "который учёностью превозносится;",
 "thag17.3:13.3": "Слепой светильник-держатель как,",
 "thag17.3:13.4": "так же представляется мне.",
 "thag17.3:14.1": "Многоучёного следует посещать,",
 "thag17.3:14.2": "и учёность не разрушать;",
 "thag17.3:14.3": "Это корень святой жизни,",
 "thag17.3:14.4": "потому явление-держателем пусть будет.",
 "thag17.3:15.1": "Предшествующее-последующее-знающий, благо-знающий,",
 "thag17.3:15.2": "в речениях-словах-искусный;",
 "thag17.3:15.3": "Хорошо-схваченное и схватывает,",
 "thag17.3:15.4": "и благо обдумывает.",
 "thag17.3:16.1": "Терпением импульсным становится,",
 "thag17.3:16.2": "приложив-усилие взвешивает это;",
 "thag17.3:16.3": "Вовремя он прилагает-усилие,",
 "thag17.3:16.4": "внутри хорошо сосредоточенный.",
 "thag17.3:17.1": "Много-услышавшего, явление-несущего,",
 "thag17.3:17.2": "понимающего, пробуждённого последователя;",
 "thag17.3:17.3": "Явления-распознавание ожидая,",
 "thag17.3:17.4": "того следует посещать такого.",
 "thag17.3:18.1": "Многоучёный, явление-держатель,",
 "thag17.3:18.2": "хранитель сокровищницы великого провидца;",
 "thag17.3:18.3": "Глаз всего мира,",
 "thag17.3:18.4": "досточтимый, многоучёный.",
 "thag17.3:19.1": "Дхамма-радостный, Дхамма-наслаждающийся,",
 "thag17.3:19.2": "Дхамму обдумывающий;",
 "thag17.3:19.3": "Дхамму вспоминающий монах,",
 "thag17.3:19.4": "от благой-Дхаммы не отпадает.",
 "thag17.3:20.1": "Тело-скупость-тяжелые,",
 "thag17.3:20.2": "при убывании не встают;",
 "thag17.3:20.3": "у жадного до телесного удовольствия,",
 "thag17.3:20.4": "откуда шраманская приятность.",
 "thag17.3:21.1": "Не идут направления все,",
 "thag17.3:21.2": "явления не проявляются мне;",
 "thag17.3:21.3": "Когда ушёл благой друг,",
 "thag17.3:21.4": "как тьма кажется.",
 "thag17.3:22.1": "Ушедшего товарища,",
 "thag17.3:22.2": "ушедшего-прошедшего Учителя;",
 "thag17.3:22.3": "Нет такого друга,",
 "thag17.3:22.4": "как телесное памятование.",
 "thag17.3:23.1": "Те, что прежние, прошли они,",
 "thag17.3:23.2": "с новыми не сходятся мои;",
 "thag17.3:23.3": "Сегодня один лишь зажгусь,",
 "thag17.3:23.4": "как дождём-политая птица”.",
 "thag17.3:24.1": "“Для видения пришедшие,",
 "thag17.3:24.2": "из разных стран многие;",
 "thag17.3:24.3": "Не препятствуйте, слушатели,",
 "thag17.3:24.4": "пусть видят мой покой”.",
 "thag17.3:25.1": "“Для видения пришедшие,",
 "thag17.3:25.2": "из разных стран многие;",
 "thag17.3:25.3": "Делает Учитель возможность,",
 "thag17.3:25.4": "не удерживает зрячий.",
 "thag17.3:26.1": "Двадцать пять лет,",
 "thag17.3:26.2": "учеником будучи мне;",
 "thag17.3:26.3": "Не желания-сознавание возникло,",
 "thag17.3:26.4": "узри явления-благозаконность.",
 "thag17.3:27.1": "Двадцать пять лет,",
 "thag17.3:27.2": "учеником будучи мне;",
 "thag17.3:27.3": "Не вредности-сознавание возникло,",
 "thag17.3:27.4": "узри явления-благозаконность.",
 "thag17.3:28.1": "Двадцать пять лет,",
 "thag17.3:28.2": "Благословенного обслуживал;",
 "thag17.3:28.3": "Мирным тела-активностью,",
 "thag17.3:28.4": "как тень неотступная.",
 "thag17.3:29.1": "Двадцать пять лет,",
 "thag17.3:29.2": "Благословенного обслуживал;",
 "thag17.3:29.3": "Мирным речи-активностью,",
 "thag17.3:29.4": "как тень неотступная.",
 "thag17.3:30.1": "Двадцать пять лет,",
 "thag17.3:30.2": "Благословенного обслуживал;",
 "thag17.3:30.3": "Мирным ума-активностью,",
 "thag17.3:30.4": "как тень неотступная.",
 "thag17.3:31.1": "Будды прогуливающегося,",
 "thag17.3:31.2": "за спиной прогуливался;",
 "thag17.3:31.3": "Явлениям, когда преподаются,",
 "thag17.3:31.4": "знание мне возникло.",
 "thag17.3:32.1": "Я с-делом-своим,",
 "thag17.3:32.2": "ученик, не-достигший-представленного;",
 "thag17.3:32.3": "И Учителя окончательная ниббана,",
 "thag17.3:32.4": "который наш сострадательный.",
 "thag17.3:33.1": "Тогда было что ужасное,",
 "thag17.3:33.2": "тогда было волосы дыбом поднимающее;",
 "thag17.3:33.3": "Всеми аспектами наилучшего вида,",
 "thag17.3:33.4": "в совершеннопробуждённом окончательно остуженном”.",
 "thag17.3:34.1": "“Многоучёный, явление-держатель,",
 "thag17.3:34.2": "хранитель сокровищницы великого провидца;",
 "thag17.3:34.3": "Глаз всего мира,",
 "thag17.3:34.4": "Ананда окончательно остужен.",
 "thag17.3:35.1": "Многоучёный, явление-держатель,",
 "thag17.3:35.2": "хранитель сокровищницы великого провидца;",
 "thag17.3:35.3": "Глаз всего мира,",
 "thag17.3:35.4": "тьмы рассеиватель.",
 "thag17.3:36.1": "С-памятью, с-осознанностью,",
 "thag17.3:36.2": "с-решимостью и который провидец;",
 "thag17.3:36.3": "Носитель благой Дхаммы старший монах,",
 "thag17.3:36.4": "Ананда, сокровищница драгоценностей”.",
 "thag17.3:37.1": "“Послужен мной Учитель,",
 "thag17.3:37.2": "исполнено Будды указание;",
 "thag17.3:37.3": "Отложен тяжёлый груз,",
 "thag17.3:37.4": "отныне нет повторной вовлеченности-[индивидуального] существования”.",
 "thag17.3:37.5": "… Ананда старший монах …",
 "thag17.3:37.6": "Раздел тридцати установлен.",
 "thag17.3:38.0": "Там сводка",
 "thag17.3:38.1": "Пхуссо, Патиссо, Анандо,",
 "thag17.3:38.2": "трое эти провозглашены;",
 "thag17.3:38.3": "Стихи там насчитаны,",
 "thag17.3:38.4": "сто пять и сверх того."
}
