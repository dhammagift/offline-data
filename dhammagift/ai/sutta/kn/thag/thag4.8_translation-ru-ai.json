{
 "thag4.8:0.1": "Стихи старших монахов 4.8",
 "thag4.8:0.2": "Четыре строфы",
 "thag4.8:0.3": "Глава первая",
 "thag4.8:0.4": "Стихи старшего монаха Рахулы",
 "thag4.8:1.1": "“Обоим наделённый,",
 "thag4.8:1.2": "Рахула-благой меня знают;",
 "thag4.8:1.3": "И что я сын Пробуждённого,",
 "thag4.8:1.4": "и что в явлениях глазастый.",
 "thag4.8:2.1": "И что мои истечения истощены,",
 "thag4.8:2.2": "и что нет нового [индивидуального] существования;",
 "thag4.8:2.3": "Архат я, достойный-даров,",
 "thag4.8:2.4": "тройной-знаток, бессмертного видящий.",
 "thag4.8:3.1": "Желанием ослеплённые, сетью покрытые,",
 "thag4.8:3.2": "цепляния-покрывалом покрытые;",
 "thag4.8:3.3": "Беспечности-родственником связанные,",
 "thag4.8:3.4": "как рыбы в сеть-ловушку.",
 "thag4.8:4.1": "То желание я отбросив,",
 "thag4.8:4.2": "отрезав Мары привязь;",
 "thag4.8:4.3": "С корнем цепляние вырвав,",
 "thag4.8:4.4": "став прохладным, я угас”.",
 "thag4.8:4.5": "… Старший Рахула …."
}
