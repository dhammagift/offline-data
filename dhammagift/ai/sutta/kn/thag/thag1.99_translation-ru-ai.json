{
 "thag1.99:0.1": "Стихи старших монахов 1.99",
 "thag1.99:0.2": "Раздел из одного",
 "thag1.99:0.3": "Десятая глава",
 "thag1.99:0.4": "Стихи старшего монаха Уттии",
 "thag1.99:1.1": "«Звук услышав, памятование утеряно,",
 "thag1.99:1.2": "Приятный знак мыслящему-представляющему;",
 "thag1.99:1.3": "С умом-состоянием, охваченным страстью, ведает,",
 "thag1.99:1.4": "И его, вцепившись, стоит;",
 "thag1.99:1.5": "У него возрастают истечения,",
 "thag1.99:1.6": "В Сансару ведущие».",
 "thag1.99:1.7": "… Старший монах Уттия …."
}
