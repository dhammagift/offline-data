{
 "thag16.10:0.1": "Стихи старших монахов 16.10",
 "thag16.10:0.2": "Двадцати-глава",
 "thag16.10:0.3": "Глава первая",
 "thag16.10:0.4": "Стихи старшего монаха Парапарии",
 "thag16.10:1.1": "У шрамана была мысль,",
 "thag16.10:1.2": "в цветущей большой роще;",
 "thag16.10:1.3": "У сидящего сосредоточенно,",
 "thag16.10:1.4": "у уединённого, зажёгшегося.",
 "thag16.10:2.1": "“Иначе, когда предводитель мира,",
 "thag16.10:2.2": "пребывает высший среди людей;",
 "thag16.10:2.3": "поведение было у монахов,",
 "thag16.10:2.4": "иначе теперь видится.",
 "thag16.10:3.1": "От холода-ветра защита,",
 "thag16.10:3.2": "стыдливости-срамного прикрытие;",
 "thag16.10:3.3": "Умеренное употребляли,",
 "thag16.10:3.4": "довольные тем и другим.",
 "thag16.10:4.1": "Превосходное ли или грубое,",
 "thag16.10:4.2": "малая ли или же большая;",
 "thag16.10:4.3": "Для поддержания употребляли,",
 "thag16.10:4.4": "не жадные, не очарованные.",
 "thag16.10:5.1": "Для жизни принадлежностей,",
 "thag16.10:5.2": "лекарств и условий;",
 "thag16.10:5.3": "Не сильно усердными были,",
 "thag16.10:5.4": "как те для исчерпания истечений.",
 "thag16.10:6.1": "В лесу, у подножий деревьев,",
 "thag16.10:6.2": "в пещерах и в расселинах;",
 "thag16.10:6.3": "Уединение взращивая,",
 "thag16.10:6.4": "пребывали, в том имея опору.",
 "thag16.10:7.1": "Смиренные, утверждённые, легко содержимые,",
 "thag16.10:7.2": "мягкие, без застывшего самомнения;",
 "thag16.10:7.3": "Без-загрязнения, не-болтливые,",
 "thag16.10:7.4": "смысла-обдумывающие, под-властью-идущие.",
 "thag16.10:8.1": "Оттого приятным было,",
 "thag16.10:8.2": "хождение, еда, обслуживание;",
 "thag16.10:8.3": "Маслянистым, как струя масла,",
 "thag16.10:8.4": "был образ-поведения.",
 "thag16.10:9.1": "Все-истечения-исчерпавшие,",
 "thag16.10:9.2": "великие-зажжённые, великие-благотворные;",
 "thag16.10:9.3": "Угасли теперь те старцы,",
 "thag16.10:9.4": "мало теперь таких.",
 "thag16.10:10.1": "И благотворных явлений,",
 "thag16.10:10.2": "и понимания из-за исчерпания;",
 "thag16.10:10.3": "Всеми-способами-лучшим-наделённое,",
 "thag16.10:10.4": "разрушается Учение Победителя.",
 "thag16.10:11.1": "И плохих явлений,",
 "thag16.10:11.2": "и загрязнений какой сезон;",
 "thag16.10:11.3": "Предстали для уединения,",
 "thag16.10:11.4": "а которые остатки-истинной-Дхаммы.",
 "thag16.10:12.1": "Те загрязнения, разрастаясь,",
 "thag16.10:12.2": "овладевают многими людьми;",
 "thag16.10:12.3": "Играют, думаю, с глупцами,",
 "thag16.10:12.4": "как с безумными ракшасы.",
 "thag16.10:13.1": "Загрязнениями-преодолённые те,",
 "thag16.10:13.2": "туда-сюда разбегающиеся;",
 "thag16.10:13.3": "Люди в загрязнения-основаниях,",
 "thag16.10:13.4": "с привязанностью-борьбой объявлены.",
 "thag16.10:14.1": "Оставив истинную Дхамму,",
 "thag16.10:14.2": "друг с другом ссорятся;",
 "thag16.10:14.3": "Взглядо-установления следуя,",
 "thag16.10:14.4": "«это лучше» — считают.",
 "thag16.10:15.1": "И богатство, и сына, и жену,",
 "thag16.10:15.2": "отбросив, ушли;",
 "thag16.10:15.3": "Ради подаяния-еды даже",
 "thag16.10:15.4": "неподобающее совершают.",
 "thag16.10:16.1": "Живот наполнив, поев,",
 "thag16.10:16.2": "лежат навзничь;",
 "thag16.10:16.3": "Какие ведут пробуждённые,",
 "thag16.10:16.4": "речи, Учителем порицаемые.",
 "thag16.10:17.1": "Все ремесла-искусства,",
 "thag16.10:17.2": "внимание направив, изучают;",
 "thag16.10:17.3": "Неуспокоенные внутри,",
 "thag16.10:17.4": "отшельничества-смысл-цель так идёт.",
 "thag16.10:18.1": "Глину, масло, порошок,",
 "thag16.10:18.2": "воду, сиденье, еду;",
 "thag16.10:18.3": "Мирянам подносят,",
 "thag16.10:18.4": "желая большего.",
 "thag16.10:19.1": "Зубочистку, плод слона,",
 "thag16.10:19.2": "цветы, съестное и",
 "thag16.10:19.3": "В подаянии же совершенном,",
 "thag16.10:19.4": "манго и миробалан.",
 "thag16.10:20.1": "В лекарствах как врачи,",
 "thag16.10:20.2": "в должном-недолжном как домохозяева;",
 "thag16.10:20.3": "Как куртизанка в украшении,",
 "thag16.10:20.4": "как кшатрии в правителях.",
 "thag16.10:21.1": "Обманщики, мошенники,",
 "thag16.10:21.2": "лжесвидетели, негодяи;",
 "thag16.10:21.3": "Многими уловками",
 "thag16.10:21.4": "поживу потребляют.",
 "thag16.10:22.1": "Уловкой, обходом,",
 "thag16.10:22.2": "уловкой гонимые;",
 "thag16.10:22.3": "Ради средств к жизни, ухищрением,",
 "thag16.10:22.4": "собирают много богатства.",
 "thag16.10:23.1": "Обслуживают собрание,",
 "thag16.10:23.2": "ради деятельности, а не ради Дхаммы;",
 "thag16.10:23.3": "Дхамму другим учат,",
 "thag16.10:23.4": "ради приобретения, а не ради блага.",
 "thag16.10:24.1": "Из-за обретения Сангхи ссорятся,",
 "thag16.10:24.2": "от Сангхи отстранённые;",
 "thag16.10:24.3": "Чужим обретением живущие,",
 "thag16.10:24.4": "бесстыдные, не стыдятся.",
 "thag16.10:25.1": "Не заняты так некоторые,",
 "thag16.10:25.2": "обритая, в накидку одетая;",
 "thag16.10:25.3": "Почитания только желают,",
 "thag16.10:25.4": "обретение-уважения-опьянённые.",
 "thag16.10:26.1": "Так в разное-направленном,",
 "thag16.10:26.2": "не теперь легко так;",
 "thag16.10:26.3": "Не-достигнутое или достигнуть,",
 "thag16.10:26.4": "достигнутое или удержать.",
 "thag16.10:27.1": "Как в колючем-месте,",
 "thag16.10:27.2": "следовал бы без-обуви;",
 "thag16.10:27.3": "Памятование установив,",
 "thag16.10:27.4": "так в деревне пусть странствует мудрец.",
 "thag16.10:28.1": "Вспомнив прежних йогинов,",
 "thag16.10:28.2": "их поведение-вспоминая;",
 "thag16.10:28.3": "Хотя бы последнее время,",
 "thag16.10:28.4": "достиг бы бессмертного шага.",
 "thag16.10:29.1": "Это сказав в саловой-роще,",
 "thag16.10:29.2": "шраман развитый-в-способностях;",
 "thag16.10:29.3": "Брахман полностью-угасший,",
 "thag16.10:29.4": "провидец с-прекращённым-новым-[индивидуальным]-существованием”.",
 "thag16.10:29.5": "… Парапарийо Тхера …",
 "thag16.10:29.6": "Двадцати-строфие установлено.",
 "thag16.10:30.0": "Там сводка",
 "thag16.10:30.1": "Сфокусированный Парапарийо,",
 "thag16.10:30.2": "Телакани Раттхапало;",
 "thag16.10:30.3": "Малукьясело Бхаддийо;",
 "thag16.10:30.4": "Ангули Диббачаккхуко;",
 "thag16.10:30.5": "Парапарийо десять-этих,",
 "thag16.10:30.6": "в двадцати-строфии перечислены;",
 "thag16.10:30.7": "Стихов две сотни есть,",
 "thag16.10:30.8": "пять-сорок сверх того."
}
