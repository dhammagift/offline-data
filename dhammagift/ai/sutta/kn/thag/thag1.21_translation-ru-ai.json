{
 "thag1.21:0.1": "Стихи старших монахов 1.21",
 "thag1.21:0.2": "Раздел из одного",
 "thag1.21:0.3": "Раздел Третий",
 "thag1.21:0.4": "Стихи старшего монаха Нигродхи",
 "thag1.21:1.1": "“Я тревоги не боюсь,",
