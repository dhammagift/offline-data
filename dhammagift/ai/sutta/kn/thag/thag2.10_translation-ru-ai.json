{
 "thag2.10:0.1": "Стихи старших монахов 2.10",
 "thag2.10:0.2": "Двойное собрание",
 "thag2.10:0.3": "Глава первая",
 "thag2.10:0.4": "Стихи старшего монаха Васабхи",
 "thag2.10:1.1": "“Сначала убивает себя,",
 "thag2.10:1.2": "потом убивает он других;",
 "thag2.10:1.3": "Убитого убивает себя,",
 "thag2.10:1.4": "как птица, пойманная в силок.",
 "thag2.10:2.1": "Не брахман внешним цветом,",
 "thag2.10:2.2": "внутренним цветом ведь брахман;",
 "thag2.10:2.3": "В ком злые активности,",
 "thag2.10:2.4": "он есть тёмный, о Суямпати”.",
 "thag2.10:2.5": "… Васабха старший …",
 "thag2.10:2.6": "Глава первая.",
 "thag2.10:3.0": "Оглавление",
 "thag2.10:3.1": "Уттара и Пиндола,",
 "thag2.10:3.2": "Валлия, Тирия провидец;",
 "thag2.10:3.3": "Аджина и Меладжина,",
 "thag2.10:3.4": "Радха, Сурадха, Готама;",
 "thag2.10:3.5": "С Васабхой эти есть,",
 "thag2.10:3.6": "десять старших великой силы”."
}
