{
 "thag1.115:0.1": "Стихи старших монахов 1.115",
 "thag1.115:0.2": "Раздел из одного",
 "thag1.115:0.3": "Двенадцатый раздел",
 "thag1.115:0.4": "Стихи старшего монаха Маханамы",
 "thag1.115:1.1": "“Вот ты превосходишься горой,",
 "thag1.115:1.2": "Многокудрявой, с саллаки;",
 "thag1.115:1.3": "Охотничьей горой,",
 "thag1.115:1.4": "Славной своей кроной”.",
 "thag1.115:1.5": "… Старший монах Маханама …."
}
