{
 "thag7.2:0.1": "Стихи старших монахов 7.2",
 "thag7.2:0.2": "Семёрки",
 "thag7.2:0.3": "Глава первая",
 "thag7.2:0.4": "Стихи старшего монаха Лакундакабхаддии",
 "thag7.2:1.1": "“Другие в Амбатака-парке,",
 "thag7.2:1.2": "в лесной чаще Бхаддия;",
 "thag7.2:1.3": "С корнем цепляние вырвав,",
 "thag7.2:1.4": "там Бхаддия зажжён.",
 "thag7.2:2.1": "Радуются некоторые с барабанами,",
 "thag7.2:2.2": "с лютнями и с цимбалами;",
 "thag7.2:2.3": "Я же у подножия дерева,",
 "thag7.2:2.4": "радуюсь Будды указанию.",
 "thag7.2:3.1": "Если бы Будда мне дар дал,",
 "thag7.2:3.2": "и был бы достижим мной дар;",
 "thag7.2:3.3": "Взял бы я всего мира,",
 "thag7.2:3.4": "постоянное к-телу-относящееся памятование.",
 "thag7.2:4.1": "Кто меня по образу оценивают,",
 "thag7.2:4.2": "а которые за звуком пошли;",
 "thag7.2:4.3": "Импульс-страсти-властью-охваченные,",
 "thag7.2:4.4": "не знают меня те люди.",
 "thag7.2:5.1": "Внутри и не знает,",
 "thag7.2:5.2": "снаружи и не видит;",
 "thag7.2:5.3": "Сплошь-закрытый глупец,",
 "thag7.2:5.4": "он ведь звуком уносится.",
 "thag7.2:6.1": "Внутри и не знает,",
 "thag7.2:6.2": "снаружи и видит;",
 "thag7.2:6.3": "Снаружи плод-видящий,",
 "thag7.2:6.4": "и тот звуком уносится.",
 "thag7.2:7.1": "Внутри и понимает,",
 "thag7.2:7.2": "снаружи и видит;",
 "thag7.2:7.3": "Без преград видящий,",
 "thag7.2:7.4": "не тот звуком уносится”.",
 "thag7.2:7.5": "… Старший монах Лакундакабхаддия …."
}
