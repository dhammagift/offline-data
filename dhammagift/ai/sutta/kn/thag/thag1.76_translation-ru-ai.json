{
 "thag1.76:0.1": "Стихи старших монахов 1.76",
 "thag1.76:0.2": "Раздел из одного",
 "thag1.76:0.3": "Восьмая глава",
 "thag1.76:0.4": "Стихи старшего монаха Пияньджахи",
 "thag1.76:1.1": "“У взлетающих — падай,",
 "thag1.76:1.2": "у падающих — взлетай;",
 "thag1.76:1.3": "У тех, кто не под контролем — под контролем,",
 "thag1.76:1.4": "у наслаждающихся — не наслаждайся”.",
 "thag1.76:1.5": "… Старший монах Пияньджаха …."
}
