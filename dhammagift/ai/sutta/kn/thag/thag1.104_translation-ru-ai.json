{
 "thag1.104:0.1": "Стихи старших монахов 1.104",
 "thag1.104:0.2": "Раздел из одного",
 "thag1.104:0.3": "Глава одиннадцатая",
 "thag1.104:0.4": "Стих старшего монаха Кхитаки",
 "thag1.104:1.1": "«Лёгок, право, мой тело-массив,",
 "thag1.104:1.2": "Затронут озарённостью-упоением-приятным-комфортом обильным;",
 "thag1.104:1.3": "Словно хлопок, ветром взметённый,",
 "thag1.104:1.4": "Плывёт словно мой тело-массив».",
 "thag1.104:1.5": "… Старший монах Кхитака …."
}
