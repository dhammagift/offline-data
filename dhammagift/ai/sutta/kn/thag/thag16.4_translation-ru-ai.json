{
 "thag16.4:0.1": "Стихи старших монахов 16.4",
 "thag16.4:0.2": "Двадцати-глава",
 "thag16.4:0.3": "Глава первая",
 "thag16.4:0.4": "Стихи старшего монаха Раттхапалы",
 "thag16.4:1.1": "“Узри разукрашенный образ,",
 "thag16.4:1.2": "тело из ран составленное;",
 "thag16.4:1.3": "Больное, многоустремлённое,",
 "thag16.4:1.4": "у которого нет постоянного пребывания.",
 "thag16.4:2.1": "Узри разукрашенную форму,",
 "thag16.4:2.2": "жемчужиной и серьгой;",
 "thag16.4:2.3": "Кость кожей обтянута,",
 "thag16.4:2.4": "с одеждами красуется.",
 "thag16.4:3.1": "Лаком покрыты ступни,",
 "thag16.4:3.2": "лицо пудрой намазано;",
 "thag16.4:3.3": "Достаточно для обмана незрелого,",
 "thag16.4:3.4": "но не ищущего запредельного.",
 "thag16.4:4.1": "Восьмичастно сделанные волосы,",
 "thag16.4:4.2": "глаза сурьмой намазаны;",
 "thag16.4:4.3": "Достаточно для обмана незрелого,",
 "thag16.4:4.4": "но не ищущего запредельного.",
 "thag16.4:5.1": "Словно новая расписная шкатулка,",
 "thag16.4:5.2": "гнилое тело украшено;",
 "thag16.4:5.3": "Достаточно для обмана незрелого,",
 "thag16.4:5.4": "но не ищущего запредельного.",
 "thag16.4:6.1": "Охотник расставил ловушку,",
 "thag16.4:6.2": "не попался в силок олень;",
 "thag16.4:6.3": "Поев приманку, уходим,",
 "thag16.4:6.4": "плачущему оленелову.",
 "thag16.4:7.1": "Перерезана петля оленя,",
 "thag16.4:7.2": "не попался в силок олень;",
 "thag16.4:7.3": "Поев приманку, уходим,",
 "thag16.4:7.4": "скорбящему об охотнике на оленей.",
 "thag16.4:8.1": "Вижу в мире людей с богатством,",
 "thag16.4:8.2": "Получив богатство, не дают из-за заблуждения;",
 "thag16.4:8.3": "Жадные, богатство накопление делают,",
 "thag16.4:8.4": "Ещё больше желания вожделеют.",
 "thag16.4:9.1": "Царь, силой землю покорив,",
 "thag16.4:9.2": "С океаном-границей землю населяя;",
 "thag16.4:9.3": "По эту сторону океана ненасытным будучи,",
 "thag16.4:9.4": "Ту сторону океана также вожделел бы.",
 "thag16.4:10.1": "Царь и другие многие люди,",
 "thag16.4:10.2": "С неоставленным цеплянием к умиранию приходят;",
 "thag16.4:10.3": "Недостаточными став, оставляют тело,",
 "thag16.4:10.4": "В желаниях в мире нет насыщения.",
 "thag16.4:11.1": "Оплакивают его родственники, растрепав волосы,",
 "thag16.4:11.2": "“Ах, вот бы нам не умирать” — говорят;",
 "thag16.4:11.3": "Тканью его покрытого вынеся,",
 "thag16.4:11.4": "Сложив вместе, затем сжигают.",
 "thag16.4:12.1": "Он сгорает, кольями пронзаемый,",
 "thag16.4:12.2": "С одной тканью, оставив богатства;",
 "thag16.4:12.3": "У умирающего не бывает защитников,",
 "thag16.4:12.4": "Семья и друзья или же товарищи.",
 "thag16.4:13.1": "Наследники его богатство уносят,",
 "thag16.4:13.2": "Существо же идёт, куда активность;",
 "thag16.4:13.3": "Умирающего богатство не сопровождает ничто,",
 "thag16.4:13.4": "Ни сыновья, ни жёны, ни богатство, ни царство.",
 "thag16.4:14.1": "Не долгую жизнь получает богатством.",
 "thag16.4:14.2": "И также богатством старость не отбивается;",
 "thag16.4:14.3": "Мала эта жизнь, говорят знатоки,",
 "thag16.4:14.4": "Непостоянная, подверженная изменению.",
 "thag16.4:15.1": "Богатые и бедные касаются касания,",
 "thag16.4:15.2": "Глупый и знаток точно так же касаемы;",
 "thag16.4:15.3": "Глупый ведь глупостью, словно убитый, лежит,",
 "thag16.4:15.4": "Знаток же не дрожит, касанием затронутый.",
 "thag16.4:16.1": "Поэтому ведь понимание лучше богатства,",
 "thag16.4:16.2": "Которым завершение здесь достигает;",
 "thag16.4:16.3": "Из-за незавершённости ведь в существованиях-существованиях,",
 "thag16.4:16.4": "Плохие активности совершает из-за заблуждения.",
 "thag16.4:17.1": "Входит в чрево и в другой мир,",
 "thag16.4:17.2": "В круговорот вступает чередой;",
 "thag16.4:17.3": "Тот, мало-понимающий, доверяя этому,",
 "thag16.4:17.4": "Входит в чрево и в другой мир.",
 "thag16.4:18.1": "Как вор, схваченный на месте взлома,",
 "thag16.4:18.2": "Своей активностью убивается, плохо-явленный;",
 "thag16.4:18.3": "Так поколение, уйдя, в другом мире,",
 "thag16.4:18.4": "Своей активностью убивается, плохо-явленный.",
 "thag16.4:19.1": "Желания ведь красочны, сладки, восхитительны,",
 "thag16.4:19.2": "Разнообразными формами сминают ум-состояние;",
 "thag16.4:19.3": "Опасность в желаниях-множителях увидев,",
 "thag16.4:19.4": "Поэтому я ушёл в бездомность, царь.",
 "thag16.4:20.1": "Как плоды с дерева, падают молодые люди,",
 "thag16.4:20.2": "Молодые и старые — при распаде тела;",
 "thag16.4:20.3": "И это увидев, ушёл в отшельники я, царь,",
 "thag16.4:20.4": "Гарантированно отшельничество же лучше.",
 "thag16.4:21.1": "С верой я продвинулся,",
 "thag16.4:21.2": "приблизившись к Учению Победителя;",
 "thag16.4:21.3": "Не напрасна моя продвинутость,",
 "thag16.4:21.4": "бездолжным вкушаю еду.",
 "thag16.4:22.1": "Желания как горящее увидев,",
 "thag16.4:22.2": "золото как опасность;",
 "thag16.4:22.3": "От вхождения в лоно — боль,",
 "thag16.4:22.4": "в адах — великая тревога.",
 "thag16.4:23.1": "Эту недостаток-опасность узнав,",
 "thag16.4:23.2": "встревоженность обрёл тогда;",
 "thag16.4:23.3": "Тот я, пронзённый тогда, успокоенный,",
 "thag16.4:23.4": "достиг исчерпания истечений.",
 "thag16.4:24.1": "Обслужен мной Учитель,",
 "thag16.4:24.2": "исполнено Будды указание;",
 "thag16.4:24.3": "Отложен тяжёлый груз,",
 "thag16.4:24.4": "с проводником к индивидуальному существованию покончено.",
 "thag16.4:25.1": "Ради чего продвинулся,",
 "thag16.4:25.2": "из дома в бездомность;",
 "thag16.4:25.3": "Эта цель мной достигнута,",
 "thag16.4:25.4": "полное исчерпание всех связываний”.",
 "thag16.4:25.5": "… Раттхапала Тхера …."
}
