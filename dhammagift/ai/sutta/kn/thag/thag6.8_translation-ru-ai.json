{
 "thag6.8:0.1": "Стихи старших монахов 6.8",
 "thag6.8:0.2": "Глава шестых",
 "thag6.8:0.3": "Глава первая",
 "thag6.8:0.4": "Стихи старшего монаха Мигаджалы",
 "thag6.8:1.1": "“Хорошо наставлено Оком-обладающим,",
 "thag6.8:1.2": "Пробуждённым, солнца-родственником;",
 "thag6.8:1.3": "все-связанности-превзошедшим,",
 "thag6.8:1.4": "все-круговерти-уничтожающим.",
 "thag6.8:2.1": "Выводящий, возвышающий,",
 "thag6.8:2.2": "цепляния-корень-иссушающий;",
 "thag6.8:2.3": "Ядовитый-корень, бойню,",
 "thag6.8:2.4": "отрезав, приводит к угасанию.",
 "thag6.8:3.1": "Незнания-корня-ради-разрушения,",
 "thag6.8:3.2": "активности-механизма-разрушитель;",
 "thag6.8:3.3": "Распознаваний в удерживании,",
 "thag6.8:3.4": "знания-ваджры-низвергатель.",
 "thag6.8:4.1": "Чувствований прояснитель,",
 "thag6.8:4.2": "поддерживания-освободитель;",
 "thag6.8:4.3": "Бхаву как угольную-яму,",
 "thag6.8:4.4": "знанием созерцающий.",
 "thag6.8:5.1": "Великий-вкус, глубокий,",
 "thag6.8:5.2": "старения-смерти-преградитель;",
 "thag6.8:5.3": "Благородный восьмеричный путь,",
 "thag6.8:5.4": "боли-успокоитель, благотворный.",
 "thag6.8:6.1": "Активность как активность познав,",
 "thag6.8:6.2": "и созревание-результат как созревание-результат;",
 "thag6.8:6.3": "В зависимости-возникших явлений,",
 "thag6.8:6.4": "как-есть-освещение-видящий;",
 "thag6.8:6.5": "Великое-безопасность-идущий, будучи,",
 "thag6.8:6.6": "завершение-благой”.",
 "thag6.8:6.7": "… Мигаджала старший монах …."
}
