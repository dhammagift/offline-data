{
 "thag1.87:0.1": "Стихи старших монахов 1.87",
 "thag1.87:0.2": "Раздел из одного",
 "thag1.87:0.3": "Девятая глава",
 "thag1.87:0.4": "Стих старшего монаха Павиттхи",
 "thag1.87:1.1": "“Блоки увидены как-есть,",
 "thag1.87:1.2": "вовлеченности все разбиты;",
 "thag1.87:1.3": "Исчерпан рождение-круговорот,",
 "thag1.87:1.4": "отныне нет повторной вовлеченности-[индивидуального] существования”.",
 "thag1.87:1.5": "… Старший монах Павиттха …."
}
