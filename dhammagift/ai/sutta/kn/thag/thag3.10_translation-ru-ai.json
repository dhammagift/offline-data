{
 "thag3.10:0.1": "Стихи старших монахов 3.10",
 "thag3.10:0.2": "Тройной раздел",
 "thag3.10:0.3": "Глава первая",
 "thag3.10:0.4": "Стихи старшего монаха Сатиматтии",
 "thag3.10:1.1": "«Была у тебя прежде вера,",
 "thag3.10:1.2": "она у тебя сегодня не различается;",
 "thag3.10:1.3": "Что твоё, твоим же это и есть,",
 "thag3.10:1.4": "нет плохого поведения у меня.",
 "thag3.10:2.1": "Ненадёжна ведь, нестабильна вера,",
 "thag3.10:2.2": "так увидела ведь она мной;",
 "thag3.10:2.3": "Очаровываются и разочаровываются,",
 "thag3.10:2.4": "в том что же стареет мудрец.",
 "thag3.10:3.1": "Варится у мудреца еда,",
 "thag3.10:3.2": "Понемногу, понемногу в роду за родом;",
 "thag3.10:3.3": "За подаянием буду ходить,",
 "thag3.10:3.4": "Есть сила ног у меня».",
 "thag3.10:3.5": "… Старший монах Сатиматтия …."
}
