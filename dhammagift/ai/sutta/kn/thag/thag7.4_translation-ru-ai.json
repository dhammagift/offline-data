{
 "thag7.4:0.1": "Стихи старших монахов 7.4",
 "thag7.4:0.2": "Семёрки",
 "thag7.4:0.3": "Глава первая",
 "thag7.4:0.4": "Стихи старшего монаха Сопаки",
 "thag7.4:1.1": "“Увидев в тени дворца",
 "thag7.4:1.2": "прогуливающегося наивысшего человека;",
 "thag7.4:1.3": "Туда к нему приблизившись,",
 "thag7.4:1.4": "почтил наилучшего человека.",
 "thag7.4:2.1": "На одно плечо накинув одеяние,",
 "thag7.4:2.2": "сложив ладони;",
 "thag7.4:2.3": "Буду прогуливаться за без-пыльным,",
 "thag7.4:2.4": "всех существ высшего.",
 "thag7.4:3.1": "Тогда вопросы спросил меня,",
 "thag7.4:3.2": "в вопросах сведущий знающий;",
 "thag7.4:3.3": "Без-трепета и без-страха,",
 "thag7.4:3.4": "ответил Учителю я.",
 "thag7.4:4.1": "На разрешённые вопросы",
 "thag7.4:4.2": "одобрил Татхагата;",
 "thag7.4:4.3": "Общину монахов оглядев,",
 "thag7.4:4.4": "этот смысл произнёс.",
 "thag7.4:5.1": "‘Полезно Ангам и Магадхам,",
 "thag7.4:5.2": "Которыми этот пользуется;",
 "thag7.4:5.3": "Одеянием и подаянием,",
 "thag7.4:5.4": "Условием и сиденьем-лежанкой;",
 "thag7.4:5.5": "Вставанием и почтительностью,",
 "thag7.4:5.6": "Тем полезно”, — так сказал.",
 "thag7.4:6.1": "Отныне меня, сопака,",
 "thag7.4:6.2": "для видения приблизился;",
 "thag7.4:6.3": "Это же тебе, Сопака,",
 "thag7.4:6.4": "пусть будет полное посвящение”.",
 "thag7.4:7.1": "Семи лет от рождения я,",
 "thag7.4:7.2": "получив полное посвящение;",
 "thag7.4:7.3": "Применяю последнее тело,",
 "thag7.4:7.4": "ах, явлений-благая-явленность”.",
 "thag7.4:7.5": "… Старший монах Сопака …."
}
