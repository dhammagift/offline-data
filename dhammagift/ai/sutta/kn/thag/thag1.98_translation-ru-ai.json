{
 "thag1.98:0.1": "Стихи старших монахов 1.98",
 "thag1.98:0.2": "Раздел из одного",
 "thag1.98:0.3": "Десятая глава",
 "thag1.98:0.4": "Стихи старшего монаха Абхаи",
 "thag1.98:1.1": "“Образ увидев, памятование утеряно,",
 "thag1.98:1.2": "Приятный знак мыслящему-представляющему;",
 "thag1.98:1.3": "С умом-состоянием, охваченным страстью, ведает,",
 "thag1.98:1.4": "И его, вцепившись, стоит;",
 "thag1.98:1.5": "У него возрастают истечения,",
 "thag1.98:1.6": "К корню-бхавы-ведущие”.",
 "thag1.98:1.7": "… Старший монах Абхая …."
}
