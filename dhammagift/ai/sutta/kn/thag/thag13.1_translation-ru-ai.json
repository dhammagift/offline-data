{
 "thag13.1:0.1": "Стихи старших монахов 13.1",
 "thag13.1:0.2": "Тринадцатая группа",
 "thag13.1:0.3": "Глава первая",
 "thag13.1:0.4": "Стихи старшего монаха Сона Коливисы",
 "thag13.1:1.1": "«Кто в стране был превознесён,",
 "thag13.1:1.2": "царя Анги был слугой;",
 "thag13.1:1.3": "Тот ныне в явлениях превознесён,",
 "thag13.1:1.4": "Сона боли превзошёл.",
 "thag13.1:2.1": "Пять отрежь, пять отбрось,",
 "thag13.1:2.2": "пять сверх того развивать;",
 "thag13.1:2.3": "Пять завязки-превозшедший монах,",
 "thag13.1:2.4": "затопление-переплывшим называется.",
 "thag13.1:3.1": "Надменного беспечного,",
 "thag13.1:3.2": "внешне-стремящегося монаха;",
 "thag13.1:3.3": "Нравственность, самадхи и понимание",
 "thag13.1:3.4": "к исполненности не приходят.",
 "thag13.1:4.1": "Что должно быть сделано — отброшено,",
 "thag13.1:4.2": "а недолжное делается;",
 "thag13.1:4.3": "У надменных, беспечных,",
 "thag13.1:4.4": "у тех возрастают истечения.",
 "thag13.1:5.1": "А у тех, кто хорошо-предпринял,",
 "thag13.1:5.2": "постоянно телесное памятование;",
 "thag13.1:5.3": "Недолжного те не придерживаются,",
 "thag13.1:5.4": "в должном постоянные-делатели;",
 "thag13.1:5.5": "У памятующих, сознательных,",
 "thag13.1:5.6": "к прекращению приходят истечения.",
 "thag13.1:6.1": "На прямой путь указав,",
 "thag13.1:6.2": "идите, не возвращайтесь;",
 "thag13.1:6.3": "Собой побуждай себя,",
 "thag13.1:6.4": "к ниббане устремитесь.",
 "thag13.1:7.1": "При слишком-напряжённой решимости,",
 "thag13.1:7.2": "Учитель, непревзойдённый в мире,",
 "thag13.1:7.3": "Сравнение с виной сделав мне,",
 "thag13.1:7.4": "явление преподал Зрящий;",
 "thag13.1:7.5": "Того его слово услышав,",
 "thag13.1:7.6": "пребывал я в учении радостный.",
 "thag13.1:8.1": "Равновесие я установил,",
 "thag13.1:8.2": "высшего блага достижения;",
 "thag13.1:8.3": "Три знания достигнуты,",
 "thag13.1:8.4": "исполнено Будды указание.",
 "thag13.1:9.1": "К отречению устремлённого,",
 "thag13.1:9.2": "и разъединение ума;",
 "thag13.1:9.3": "Без-враждебности принявшим,",
 "thag13.1:9.4": "и исчерпания поддерживания.",
 "thag13.1:10.1": "К исчерпанию цепляния устремлённого,",
 "thag13.1:10.2": "и незамутнённость ума;",
 "thag13.1:10.3": "Увидев возникновение областей,",
 "thag13.1:10.4": "правильно ум-состояние освобождается.",
 "thag13.1:11.1": "У того правильно освобождённого,",
 "thag13.1:11.2": "с успокоенным умом монаха;",
 "thag13.1:11.3": "Сделанного накопления нет,",
 "thag13.1:11.4": "делаемого не различается.",
 "thag13.1:12.1": "Как скала из одного куска,",
 "thag13.1:12.2": "ветром не колеблется;",
 "thag13.1:12.3": "Так объекты, вкусы, звуки,",
 "thag13.1:12.4": "запахи, касания и все целиком.",
 "thag13.1:13.1": "Приятные явления и неприятные,",
 "thag13.1:13.2": "не волнуют такого;",
 "thag13.1:13.3": "Установленный ум, без-сознавания,",
 "thag13.1:13.4": "и он наблюдает его исчезновение.",
 "thag13.1:13.5": "… Сона Коливиса старший монах …",
 "thag13.1:13.6": "Тринадцатая строфа установлена.",
 "thag13.1:14.0": "Там сводка",
 "thag13.1:14.1": "Сона Коливиса старший монах,",
 "thag13.1:14.2": "единственный великой силой;",
 "thag13.1:14.3": "В тринадцатой строфе,",
 "thag13.1:14.4": "стихи здесь тринадцать."
}
