{
 "thag2.21:0.1": "Стихи старших монахов 2.21",
 "thag2.21:0.2": "Двойное собрание",
 "thag2.21:0.3": "Раздел Третий",
 "thag2.21:0.4": "Стихи старшего монаха Уттары",
 "thag2.21:1.1": "“Блоки мной всесторонне поняты,",
 "thag2.21:1.2": "цепляние мной хорошо устранено;",
 "thag2.21:1.3": "Развиты мной аспекты пробуждения,",
 "thag2.21:1.4": "достигнуто мной исчерпание истечений.",
 "thag2.21:2.1": "Тот я, блоки всесторонне поняв,",
 "thag2.21:2.2": "вырвав сеть-ловушку;",
 "thag2.21:2.3": "Развив аспекты пробуждения,",
 "thag2.21:2.4": "угасну без истечений”.",
 "thag2.21:2.5": "… Уттара старший монах …."
}
