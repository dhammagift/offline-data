{
 "thag1.96:0.1": "Стихи старших монахов 1.96",
 "thag1.96:0.2": "Раздел из одного",
 "thag1.96:0.3": "Десятая глава",
 "thag1.96:0.4": "Стихи старшего монаха Кхандасуманы",
 "thag1.96:1.1": "“Один цветок пожертвовав,",
