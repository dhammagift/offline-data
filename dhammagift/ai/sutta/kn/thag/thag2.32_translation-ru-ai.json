{
 "thag2.32:0.1": "Стихи старших монахов 2.32",
 "thag2.32:0.2": "Двойное собрание",
 "thag2.32:0.3": "Раздел Четвёртый",
 "thag2.32:0.4": "Стихи старшего монаха Сиваки",
 "thag2.32:1.1": "“Ненадёжны дома,",
 "thag2.32:1.2": "там и тут снова и снова;",
 "thag2.32:1.3": "Строителя дома ища,",
 "thag2.32:1.4": "болезненно рождение снова и снова.",
 "thag2.32:2.1": "Строитель дома, ты увиден,",
 "thag2.32:2.2": "снова дома не построишь;",
 "thag2.32:2.3": "Все твои стропила разбиты,",
 "thag2.32:2.4": "и столбы разбиты;",
 "thag2.32:2.5": "Без-границы-сделан ум,",
 "thag2.32:2.6": "здесь же будет разрушен”.",
 "thag2.32:2.7": "… Старший монах Сивака …."
}
