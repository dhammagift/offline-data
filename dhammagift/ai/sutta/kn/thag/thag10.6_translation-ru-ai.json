{
 "thag10.6:0.1": "Стихи старших монахов 10.6",
 "thag10.6:0.2": "Десятичник",
 "thag10.6:0.3": "Глава первая",
 "thag10.6:0.4": "Вангантапутта-Упасена-тхерагатха",
 "thag10.6:1.1": "«Уединённое, безлюдное,",
 "thag10.6:1.2": "хищниками и зверями посещаемое;",
 "thag10.6:1.3": "Пусть занимает такое сиденье-жильё монах,",
 "thag10.6:1.4": "ради уединения.",
 "thag10.6:2.1": "С мусорных куч собрав,",
 "thag10.6:2.2": "с кладбищ и с дорог;",
 "thag10.6:2.3": "Из того сшив накидку,",
 "thag10.6:2.4": "грубую пусть носит одежду.",
 "thag10.6:3.1": "Ум-представление сделав низким,",
 "thag10.6:3.2": "последовательно от рода к роду;",
 "thag10.6:3.3": "За подаянием пусть ходит монах,",
 "thag10.6:3.4": "охраняя врата, хорошо сдержанный.",
 "thag10.6:4.1": "Грубым также довольный,",
 "thag10.6:4.2": "не желает иного вкуса много;",
 "thag10.6:4.3": "У того, кто привязан к вкусам,",
 "thag10.6:4.4": "в джхане не радуется ум.",
 "thag10.6:5.1": "Мало желающий и довольный,",
 "thag10.6:5.2": "уединённо пусть живёт мудрец;",
 "thag10.6:5.3": "Не смешанный с домохозяевами,",
 "thag10.6:5.4": "и с бездомными — обеими.",
 "thag10.6:6.1": "Как глухой и как немой,",
 "thag10.6:6.2": "себя пусть показывает так;",
 "thag10.6:6.3": "Не чрезмерно пусть говорит,",
 "thag10.6:6.4": "в собрании мудрец.",
 "thag10.6:7.1": "Он никого не порицает,",
 "thag10.6:7.2": "вреда пусть избегает;",
 "thag10.6:7.3": "Сдержанный в Патимоккхе,",
 "thag10.6:7.4": "знающим меру пусть будет в еде.",
 "thag10.6:8.1": "Хорошо схваченного знака,",
 "thag10.6:8.2": "в подъёме ума-состояния умелый;",
 "thag10.6:8.3": "Равновесие пусть практикует,",
 "thag10.6:8.4": "своевременно и рассматривание.",
 "thag10.6:9.1": "Решимостью-постоянством наделённый,",
 "thag10.6:9.2": "связанным-усилием пусть будет всегда;",
 "thag10.6:9.3": "И не достигнув боле-конца,",
 "thag10.6:9.4": "доверия пусть не имеет мудрец.",
 "thag10.6:10.1": "Так пребывающего,",
 "thag10.6:10.2": "чистоты-желающего монаха;",
 "thag10.6:10.3": "Истощаются истечения все,",
 "thag10.6:10.4": "и ниббаны достигает”.",
 "thag10.6:10.5": "… Упасена Вангантапутта Тхера …."
}
