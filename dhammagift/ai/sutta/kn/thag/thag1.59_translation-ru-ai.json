{
 "thag1.59:0.1": "Стихи старших монахов 1.59",
 "thag1.59:0.2": "Раздел из одного",
 "thag1.59:0.3": "Шестая глава",
 "thag1.59:0.4": "Стихи старшего монаха Косалавихари",
 "thag1.59:1.1": "“С верой я продвинулся,",
 "thag1.59:1.2": "в лесу мной хижина сделана;",
 "thag1.59:1.3": "Неопьяненный и пылкий,",
 "thag1.59:1.4": "сознательный, памятующий”.",
 "thag1.59:1.5": "… Старший монах Косалавихари …."
}
