{
 "thag1.52:0.1": "Стихи старших монахов 1.52",
 "thag1.52:0.2": "Раздел из одного",
 "thag1.52:0.3": "Шестая глава",
 "thag1.52:0.4": "Стихи старшего монаха Субаху",
 "thag1.52:1.1": "«Дождит божество, как хорошо спето,",
 "thag1.52:1.2": "Покрыта моя хижина, приятна, безветренна;",
 "thag1.52:1.3": "Ум-состояние хорошо сосредоточено на теле,",
 "thag1.52:1.4": "Так что если хочешь, лей дождь, дэва”.",
 "thag1.52:1.5": "… Старший монах Субаху …."
