{
 "thig2.10:0.1": "Тхеригатха 2.10",
 "thig2.10:0.2": "Двойное собрание",
 "thig2.10:0.3": "Сутта Самы-тхери",
 "thig2.10:1.1": "“Четырежды, пять раз,",
 "thig2.10:1.2": "из жилища вышел;",
 "thig2.10:1.3": "Не обретя разума покоя,",
 "thig2.10:1.4": "над умом-состоянием не властвующая;",
 "thig2.10:1.5": "У меня же восьмая ночь,",
 "thig2.10:1.6": "с которой цепляние устранено.",
 "thig2.10:2.1": "Многими болевыми явлениями,",
 "thig2.10:2.2": "не-беспечностью-радостью моей;",
 "thig2.10:2.3": "Цепляния исчерпание достигнуто,",
 "thig2.10:2.4": "исполнено Будды указание”.",
 "thig2.10:3.1": "… Сама-тхери ….",
 "thig2.10:4.1": "Двойное-изложение установлено."
}
