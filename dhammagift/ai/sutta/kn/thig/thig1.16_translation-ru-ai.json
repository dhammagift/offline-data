{
 "thig1.16:0.1": "Тхеригатха 1.16",
 "thig1.16:0.2": "Раздел из одного",
 "thig1.16:0.3": "Вуддхапаббаджитасуманатхеригатха",
 "thig1.16:1.1": "«Счастливо ты, старшая, пребывай,",
 "thig1.16:1.2": "сделав из тряпья одеяние;",
 "thig1.16:1.3": "Успокоена ведь твоя страсть,",
 "thig1.16:1.4": "успокоенной стала ты, угасшей».",
 "thig1.16:2.1": "… Сумана, старшая, ушедшая в монахини …."
}
