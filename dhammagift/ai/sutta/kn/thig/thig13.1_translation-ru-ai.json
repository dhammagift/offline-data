{
 "thig13.1:0.1": "Тхеригатха 13.1",
 "thig13.1:0.2": "Двадцати-глава",
 "thig13.1:0.3": "Амбапалитхеригатха",
 "thig13.1:1.1": "«Чёрные, пчелиного цвета подобные,",
 "thig13.1:1.2": "Завитые на концах мои волосы были;",
 "thig13.1:1.3": "Они от старости пеньковой пакле подобны,",
 "thig13.1:1.4": "Правдиво-говорящего слово не иначе.",
 "thig13.1:2.1": "Благоуханной, как надушенная шкатулка,",
 "thig13.1:2.2": "Цветами полна моя верхушка головы была;",
 "thig13.1:2.3": "Она от старости с запахом шерсти,",
 "thig13.1:2.4": "Правдиво-говорящего слово не иначе.",
 "thig13.1:3.1": "Роще подобны, густо, хорошо посаженные,",
 "thig13.1:3.2": "Гребнем-иглой кончики расчёсанные украшены были;",
 "thig13.1:3.3": "Они от старости редки там и сям,",
 "thig13.1:3.4": "Правдиво-говорящего слово не иначе.",
 "thig13.1:4.1": "Чёрной-прядью-золотом украшенные,",
 "thig13.1:4.2": "Красивы были, хорошо заплетённые, украшенные;",
 "thig13.1:4.3": "Они от старости облысевшей головой стали,",
 "thig13.1:4.4": "Правдиво-говорящего слово не иначе.",
 "thig13.1:5.1": "Художником хорошо сделанные линии,",
 "thig13.1:5.2": "Красивы были мои брови прежде;",
 "thig13.1:5.3": "Они от старости морщинами обвисшие,",
 "thig13.1:5.4": "Правдиво-говорящего слово не иначе.",
 "thig13.1:6.1": "Блестящие, очень красивые, как драгоценные камни,",
 "thig13.1:6.2": "Глаза были очень синие, вытянутые;",
 "thig13.1:6.3": "Они от старости поражённые не красивы,",
 "thig13.1:6.4": "Правдиво-говорящего слово не иначе.",
 "thig13.1:7.1": "Гладкой-возвышенности подобен был и нос,",
 "thig13.1:7.2": "Красив был в юности;",
 "thig13.1:7.3": "Он от старости как бы сдавленный,",
 "thig13.1:7.4": "Правдиво-говорящего слово не иначе.",
 "thig13.1:8.1": "Как браслет хорошо сделанный, хорошо завершённый,",
 "thig13.1:8.2": "Красуются мои мочки ушей;",
 "thig13.1:8.3": "Они от старости морщинами обвисшие,",
 "thig13.1:8.4": "Правдиво-говорящего слово не иначе.",
 "thig13.1:9.1": "Как лотос-бутон-цвет-подобные,",
 "thig13.1:9.2": "Красуются зубы прежде мои;",
 "thig13.1:9.3": "Они старостью сломаны и стёрты,",
 "thig13.1:9.4": "Правдиво-говорящего слово не иначе.",
 "thig13.1:10.1": "В лесу, в чаще бродящая,",
 "thig13.1:10.2": "Как кукушка сладко кукующая;",
 "thig13.1:10.3": "То старостью споткнутое там и сям,",
 "thig13.1:10.4": "Правдиво-говорящего слово не иначе.",
 "thig13.1:11.1": "Как гладкая раковина хорошо отполированная,",
 "thig13.1:11.2": "Красуется шея прежде моя;",
 "thig13.1:11.3": "Она старостью сломана, согнута,",
 "thig13.1:11.4": "Правдиво-говорящего слово не иначе.",
 "thig13.1:12.1": "Как круглый засов-подобные обе,",
 "thig13.1:12.2": "Красуются руки прежде мои;",
 "thig13.1:12.3": "Они старостью как корни бамбука,",
 "thig13.1:12.4": "Правдиво-говорящего слово не иначе.",
 "thig13.1:13.1": "Гладкими кольцами, золотом украшенные,",
 "thig13.1:13.2": "Красуются кисти прежде мои;",
 "thig13.1:13.3": "Они старостью как корни-корневища,",
 "thig13.1:13.4": "Правдиво-говорящего слово не иначе.",
 "thig13.1:14.1": "Полные, круглые, вместе поднятые обе,",
 "thig13.1:14.2": "Красуются груди прежде мои;",
 "thig13.1:14.3": "Как пустые мешки свисают без воды,",
 "thig13.1:14.4": "Правдиво-говорящего слово не иначе.",
 "thig13.1:15.1": "Как золотая доска хорошо отполированная,",
 "thig13.1:15.2": "Красуется тело прежде моё;",
 "thig13.1:15.3": "Оно морщинами тонкими покрыто,",
 "thig13.1:15.4": "Правдиво-говорящего слово не иначе.",
 "thig13.1:16.1": "Как слоновий хобот-подобные обе,",
 "thig13.1:16.2": "Красивые были бёдра прежде мои;",
 "thig13.1:16.3": "Они от старости как бамбуковые трубки,",
 "thig13.1:16.4": "Правдиво-говорящего слово не иначе.",
 "thig13.1:17.1": "Нежными кольцами, золотом украшенные,",
 "thig13.1:17.2": "Красивые были голени прежде мои;",
 "thig13.1:17.3": "Они от старости как кунжутные палочки,",
 "thig13.1:17.4": "Правдиво-говорящего слово не иначе.",
 "thig13.1:18.1": "Хлопком наполненным подобны оба,",
 "thig13.1:18.2": "Красивые были стопы прежде мои;",
 "thig13.1:18.3": "Они от старости потрескавшиеся, морщинистые,",
 "thig13.1:18.4": "Правдиво-говорящего слово не иначе.",
 "thig13.1:19.1": "Таково было это тело,",
 "thig13.1:19.2": "Дряхлое, многих болей вместилище;",
 "thig13.1:19.3": "С облупившейся штукатуркой старый дом,",
 "thig13.1:19.4": "Правдиво-говорящего слово не иначе.",
 "thig13.1:20.1": "… Амбапали Тхери …."
}
