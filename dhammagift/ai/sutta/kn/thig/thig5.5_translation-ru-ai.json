{
 "thig5.5:0.1": "Тхеригатха 5.5",
 "thig5.5:0.2": "Пятое собрание",
 "thig5.5:0.3": "Нандуттаратхеригатха",
 "thig5.5:1.1": "“Огонь, луну и солнце,",
 "thig5.5:1.2": "дэватов почитала;",
 "thig5.5:1.3": "К речным переправам пойдя,",
 "thig5.5:1.4": "в воду вхожу здесь.",
 "thig5.5:2.1": "Много обетов приняв,",
 "thig5.5:2.2": "полголовы выбрила;",
 "thig5.5:2.3": "На земле постель стелю,",
 "thig5.5:2.4": "ночью еду не ем.",
 "thig5.5:3.1": "Украшений-нарядов радостная,",
 "thig5.5:3.2": "омываний и умащений;",
 "thig5.5:3.3": "Обслуживала это тело,",
 "thig5.5:3.4": "желания-страстью мучимая.",
 "thig5.5:4.1": "От того веру обретя,",
 "thig5.5:4.2": "покинул жизнь в бездомность;",
 "thig5.5:4.3": "Увидев тело как-есть,",
 "thig5.5:4.4": "желания-страсть устранена.",
 "thig5.5:5.1": "Все вовлеченности отсечены,",
 "thig5.5:5.2": "хотение и стремление также;",
 "thig5.5:5.3": "От всех связей освобождённые,",
 "thig5.5:5.4": "покоя достигла ума-состояния”.",
 "thig5.5:6.1": "… Нандуттара тхери …."
}
