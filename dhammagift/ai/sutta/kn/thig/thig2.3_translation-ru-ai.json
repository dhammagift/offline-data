{
 "thig2.3:0.1": "Тхеригатха 2.3",
 "thig2.3:0.2": "Двойное собрание",
 "thig2.3:0.3": "Суманггаламататхеригатха",
 "thig2.3:1.1": "«Хорошо освобождена, хорошо освобождена,",
 "thig2.3:1.2": "Хорошо освобождена я от пестика;",
 "thig2.3:1.3": "Бесстыдный мой зонтик или,",
 "thig2.3:1.4": "Горшок мой — как лягушка».",
 "thig2.3:2.1": "Страсть и я, и вредность-злобу,",
 "thig2.3:2.2": "Шипя-шипя, разбиваю;",
 "thig2.3:2.3": "Я, к подножию дерева придя,",
 "thig2.3:2.4": "«Ах, счастье!» — счастливо зажглась».",
 "thig2.3:3.1": "… Суманггаламата тхери …."
}
