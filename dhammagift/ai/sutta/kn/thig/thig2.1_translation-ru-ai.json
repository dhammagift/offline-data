{
 "thig2.1:0.1": "Тхеригатха 2.1",
 "thig2.1:0.2": "Двойное собрание",
 "thig2.1:0.3": "Абхирупананда-тхеригатха",
 "thig2.1:1.1": "“Больное, нечистое, гниющее,",
 "thig2.1:1.2": "увидь, Нанда, это тело;",
 "thig2.1:1.3": "В не-ладности ум развивай,",
 "thig2.1:1.4": "однонаправлено, хорошо собрано.",
 "thig2.1:2.1": "И без-знаковость развивай,",
 "thig2.1:2.2": "к-самомнению-предрасположенность отбрось;",
 "thig2.1:2.3": "От того самомнения-постижения,",
 "thig2.1:2.4": "успокоенной будешь странствовать”.",
 "thig2.1:3.1": "Так действительно Абхирупананда тхери строфы произнесла."
}
