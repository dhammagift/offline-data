{
 "thig9.1:0.1": "Тхеригатха 9.1",
 "thig9.1:0.2": "Девятка",
 "thig9.1:0.3": "Ваддхаматутхеригатха",
 "thig9.1:1.1": "«Пусть же тебе, Ваддха, в мире,",
 "thig9.1:1.2": "лесная чаща не будет никогда;",
 "thig9.1:1.3": "Не будь, сынок, снова и снова,",
 "thig9.1:1.4": "причастным к боли.",
 "thig9.1:2.1": "Ведь приятное, Ваддха, мудрецы,",
 "thig9.1:2.2": "неколебимые, отбросившие сомнения;",
 "thig9.1:2.3": "Ставшие прохладными, достигшие самообладания,",
 "thig9.1:2.4": "пребывают без истечений.",
 "thig9.1:3.1": "Ими пройденный, провидцами,",
 "thig9.1:3.2": "путь для обретения видения;",
 "thig9.1:3.3": "Для боле-края-делания,",
 "thig9.1:3.4": "ты, Ваддха, развивай».",
 "thig9.1:4.1": "«Уверенно ты говоришь,",
 "thig9.1:4.2": "этот смысл, родительница моя;",
 "thig9.1:4.3": "Думаю, верно, матушка,",
 "thig9.1:4.4": "лесной чащи у тебя не различается».",
 "thig9.1:5.1": "«Какие-либо, Ваддха, отождествления,",
 "thig9.1:5.2": "низкие, высшие, средние;",
 "thig9.1:5.3": "Даже малую, малейшую,",
 "thig9.1:5.4": "лесную чащу у меня не различается.",
 "thig9.1:6.1": "Все мои истечения истощены,",
 "thig9.1:6.2": "у старательного зажжённого;",
 "thig9.1:6.3": "Три знания достигнуты,",
 "thig9.1:6.4": "исполнено Будды указание».",
 "thig9.1:7.1": "«Великое, верно, у меня матерью,",
 "thig9.1:7.2": "стрекало сошло;",
 "thig9.1:7.3": "С высшим-благом-связанные строфы,",
 "thig9.1:7.4": "как бы сострадательная.",
 "thig9.1:8.1": "Того его слово услышав,",
 "thig9.1:8.2": "наставление от матери;",
 "thig9.1:8.3": "В явлении-встрепенулся я,",
 "thig9.1:8.4": "от-связи-защиты для достижения.",
 "thig9.1:9.1": "(Тот) я, с усилием-устремлённый,",
 "thig9.1:9.2": "ночь-день неутомлённый;",
 "thig9.1:9.3": "Матерью побуждаемый будучи,",
 "thig9.1:9.4": "достиг покоя высочайшего”.",
 "thig9.1:10.1": "… Ваддхамата Тхери ….",
 "thig9.1:11.1": "Девять строф установлены."
}
