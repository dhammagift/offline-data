{
 "thig3.2:0.1": "Тхеригатха 3.2",
 "thig3.2:0.2": "Тройной раздел",
 "thig3.2:0.3": "Уттама-тхеригатха",
 "thig3.2:1.1": "“Четырежды, пять раз,",
 "thig3.2:1.2": "из жилища вышел;",
 "thig3.2:1.3": "Не обретя разума покоя,",
 "thig3.2:1.4": "в уме-состоянии не владеющая собой.",
 "thig3.2:2.1": "Та к монахине подошла,",
 "thig3.2:2.2": "которая мне верной была;",
 "thig3.2:2.3": "Та мне Дхамму преподала,",
 "thig3.2:2.4": "блоки-области-дхату.",
 "thig3.2:3.1": "Её Дхамму услышав,",
 "thig3.2:3.2": "Как меня наставляла она;",
 "thig3.2:3.3": "Семь дней с одним скрещением ног,",
 "thig3.2:3.4": "Сидела, озарённостью-упоением-приятным-комфортом наполненная;",
 "thig3.2:3.5": "На восьмой ноги вытянула,",
 "thig3.2:3.6": "тьмы-блок разбив”.",
 "thig3.2:4.1": "… Уттама тхери …."
}
