{
 "thig6.8:0.1": "Тхеригатха 6.8",
 "thig6.8:0.2": "Глава шестых",
 "thig6.8:0.3": "Виджаятхеригатха",
 "thig6.8:1.1": "“Четырежды, пять раз,",
 "thig6.8:1.2": "из жилища вышел;",
 "thig6.8:1.3": "Не обретя разума покоя,",
 "thig6.8:1.4": "в уме-состоянии не владеющая собой.",
 "thig6.8:2.1": "К монахине приблизившись,",
 "thig6.8:2.2": "основательно расспросил я;",
 "thig6.8:2.3": "Та мне Дхамму преподала,",
 "thig6.8:2.4": "дхату и области.",
 "thig6.8:3.1": "Четыре благородные истины,",
 "thig6.8:3.2": "способности и силы;",
 "thig6.8:3.3": "Аспекты пробуждения, восьмиаспектный путь,",
 "thig6.8:3.4": "высшего блага-смысла-цели достижения ради.",
 "thig6.8:4.1": "Того его слово услышав,",
 "thig6.8:4.2": "делая инструкцию;",
 "thig6.8:4.3": "Ночью в первую стражу,",
 "thig6.8:4.4": "прошлые рождения вспомнил я.",
 "thig6.8:5.1": "Ночью в среднюю стражу,",
 "thig6.8:5.2": "божественное зрение очистил я;",
 "thig6.8:5.3": "Ночью в последнюю стражу,",
 "thig6.8:5.4": "массу тьмы расколол я.",
 "thig6.8:6.1": "Озарённостью-упоением и приятным тело",
 "thig6.8:6.2": "наполнив, пребывал я тогда;",
 "thig6.8:6.3": "На седьмой ноги вытянул я,",
 "thig6.8:6.4": "тьмы-блок разбив”.",
 "thig6.8:7.1": "… Тхери Виджая ….",
 "thig6.8:8.1": "Шестая глава установлена."
}
