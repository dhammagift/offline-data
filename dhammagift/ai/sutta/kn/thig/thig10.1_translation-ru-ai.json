{
 "thig10.1:0.1": "Тхеригатха 10.1",
 "thig10.1:0.2": "Раздел одиннадцати",
 "thig10.1:0.3": "Кисаготамитхеригатха",
 "thig10.1:1.1": "“С-благим-дружба мудрецом,",
 "thig10.1:1.2": "мир оглядев, восхвалена;",
 "thig10.1:1.3": "С-благим-другом общаясь,",
 "thig10.1:1.4": "даже глупый мудрецом будет.",
 "thig10.1:2.1": "Общаться-следует с чистыми людьми,",
 "thig10.1:2.2": "Понимание так возрастает у общающихся;",
 "thig10.1:2.3": "Общаясь с чистыми людьми,",
 "thig10.1:2.4": "От всех болей освободился бы.",
 "thig10.1:3.1": "Боль и следует познать,",
 "thig10.1:3.2": "Боли и скапливание, устранение;",
 "thig10.1:3.3": "Восьмичастный и путь,",
 "thig10.1:3.4": "Четыре также благородные истины”.",
 "thig10.1:4.1": "“Болезненно женское-состояние,",
 "thig10.1:4.2": "Объявлено мужчин-укротителем-наставником;",
 "thig10.1:4.3": "С-соперницами-вместе ведь болезненно,",
 "thig10.1:4.4": "Некоторые однажды родившие.",
 "thig10.1:5.1": "В горле даже режут,",
 "thig10.1:5.2": "Нежные яды едят;",
 "thig10.1:5.3": "Людей-смерти-в-середину-попавшие,",
 "thig10.1:5.4": "Обе бедствия испытывают”.",
 "thig10.1:6.1": "“Беременная идущая,",
 "thig10.1:6.2": "увидела я мужа мёртвым;",
 "thig10.1:6.3": "На дороге родив,",
 "thig10.1:6.4": "не достигнув своего дома.",
 "thig10.1:7.1": "Два сына умерли,",
 "thig10.1:7.2": "и муж на дороге умер в нищете;",
 "thig10.1:7.3": "Мать, отец и брат",
 "thig10.1:7.4": "сгорают на одном костре”.",
 "thig10.1:8.1": "“В обедневшем роду, в нищете,",
 "thig10.1:8.2": "пережито тобой боли безмерно;",
 "thig10.1:8.3": "И слёзы твои пролиты,",
 "thig10.1:8.4": "и многие тысячи рождений.",
 "thig10.1:9.1": "Прожито среди кладбищ,",
 "thig10.1:9.2": "и также съедены сыновние мяса;",
 "thig10.1:9.3": "С разрушенным родом, всеми порицаемая,",
 "thig10.1:9.4": "с мёртвым мужем, бессмертное достигла я.",
 "thig10.1:10.1": "Развит мной путь,",
 "thig10.1:10.2": "благородный восьмичастный, к бессмертному ведущий;",
 "thig10.1:10.3": "Ниббана засвидетельствована,",
 "thig10.1:10.4": "в зеркало Дхаммы я всмотрелась.",
 "thig10.1:11.1": "Я — вынувшая стрелу,",
 "thig10.1:11.2": "сложившая ношу, сделавшая должное;",
 "thig10.1:11.3": "Киса Готами, старшая монахиня,",
 "thig10.1:11.4": "с высвобождённым умом это произнесла”.",
 "thig10.1:12.1": "… Киса Готами Тхери ….",
 "thig10.1:13.1": "Раздел одиннадцати строф установлен."
}
