{
 "thig5.3:0.1": "Тхеригатха 5.3",
 "thig5.3:0.2": "Пятое собрание",
 "thig5.3:0.3": "Сутта тхери Сихи",
 "thig5.3:1.1": "“Непродуктивным представлением",
 "thig5.3:1.2": "желание-страстью измученная;",
 "thig5.3:1.3": "Была я взбудоражена прежде,",
 "thig5.3:1.4": "в уме-состоянии не владеющая собой.",
 "thig5.3:2.1": "Охваченная загрязнениями,",
 "thig5.3:2.2": "за сознаванием-приятного следующая;",
 "thig5.3:2.3": "Покоя ума-состояния не обрела,",
 "thig5.3:2.4": "страсть-ума-состояния-власти-послушная.",
 "thig5.3:3.1": "Худая, бледная и обесцвеченная,",
 "thig5.3:3.2": "семь лет я странствовала;",
 "thig5.3:3.3": "Не я ни днём ни ночью",
 "thig5.3:3.4": "приятное находила, очень больная.",
 "thig5.3:4.1": "Тогда верёвку взяв,",
 "thig5.3:4.2": "вошла я в глубину леса;",
 "thig5.3:4.3": "Лучше мне здесь повеситься,",
 "thig5.3:4.4": "чем низкое снова делать.",
 "thig5.3:5.1": "Крепкую петлю сделав,",
 "thig5.3:5.2": "к ветке дерева привязав;",
 "thig5.3:5.3": "Накинула петлю на шею,",
 "thig5.3:5.4": "тогда ум мой освободился”.",
 "thig5.3:6.1": "… Тхери Сиха …."
}
