{
 "thig2.2:0.1": "Тхеригатха 2.2",
 "thig2.2:0.2": "Двойное собрание",
 "thig2.2:0.3": "Джентатхеригатха",
 "thig2.2:1.1": "«Эти семь аспектов пробуждения,",
 "thig2.2:1.2": "пути к ниббане-достижению;",
 "thig2.2:1.3": "Развиты они мной все,",
 "thig2.2:1.4": "как Пробуждённым указаны.",
 "thig2.2:2.1": "Увиден ведь мной тот Благословенный,",
 "thig2.2:2.2": "последнее это тело-массив;",
 "thig2.2:2.3": "Исчерпан рождение-круговорот,",
 "thig2.2:2.4": "отныне нет повторной вовлеченности-[индивидуального] существования”.",
 "thig2.2:3.1": "Так действительно старшая монахиня Джента речи произнесла."
}
