{
 "thig3.7:0.1": "Тхеригатха 3.7",
 "thig3.7:0.2": "Тройной раздел",
 "thig3.7:0.3": "Села-тхеригатха",
 "thig3.7:1.1": "“Нет спасения в мире,",
 "thig3.7:1.2": "что уединением сделаешь;",
 "thig3.7:1.3": "Вкушай желания-радости,",
 "thig3.7:1.4": "не будь потом сожалеющей”.",
 "thig3.7:2.1": "“Копья-и-иглы-подобны желания,",
 "thig3.7:2.2": "блоки — разделочная плаха;",
 "thig3.7:2.3": "Что ты ‘желания-радостью’ называешь,",
 "thig3.7:2.4": "‘не-радованием’ теперь она для меня.",
 "thig3.7:3.1": "Везде разрушена радость,",
 "thig3.7:3.2": "Тьмы-глыба расколота;",
 "thig3.7:3.3": "Так знай, Злой,",
 "thig3.7:3.4": "Повержен ты, кончающий».",
 "thig3.7:4.1": "… Села тхери …."
}
