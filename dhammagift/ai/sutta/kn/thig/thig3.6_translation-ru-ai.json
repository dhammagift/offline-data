{
 "thig3.6:0.1": "Тхеригатха 3.6",
 "thig3.6:0.2": "Тройной раздел",
 "thig3.6:0.3": "Суккатхеригатха",
 "thig3.6:1.1": "«Что со мной сделали в Раджагахе люди,",
 "thig3.6:1.2": "Мёд выпив, как небожители;",
 "thig3.6:1.3": "Которые Сукку не обслуживают,",
 "thig3.6:1.4": "Учащую учению Пробуждённого.",
 "thig3.6:2.1": "И это неотразимое,",
 "thig3.6:2.2": "неисчерпаемое, сочное;",
 "thig3.6:2.3": "Пьют, представляется, имеющие понимание,",
 "thig3.6:2.4": "как дождевая туча — возвышенное.",
 "thig3.6:3.1": "Сукка с чистыми явлениями,",
 "thig3.6:3.2": "без страсти, сосредоточенная;",
 "thig3.6:3.3": "Несёт последнее тело,",
 "thig3.6:3.4": "победив Мару с его свитой”.",
 "thig3.6:4.1": "… Сукка тхери …."
}
