{
 "thig5.2:0.1": "Тхеригатха 5.2",
 "thig5.2:0.2": "Пятое собрание",
 "thig5.2:0.3": "Виссаттхатхеригатха",
 "thig5.2:1.1": "«Опьянённая цветом и образом,",
 "thig5.2:1.2": "красотой и славой;",
 "thig5.2:1.3": "Молодостью же надменная,",
 "thig5.2:1.4": "других презирала.",
 "thig5.2:2.1": "Украсив это тело,",
 "thig5.2:2.2": "хорошо разукрашенное, незрелых обманывающее;",
 "thig5.2:2.3": "Стояла у дверей публичного дома,",
 "thig5.2:2.4": "словно охотник, расставивший силки.",
 "thig5.2:3.1": "Украшения показывая,",
 "thig5.2:3.2": "скрытое многое раскрывая;",
 "thig5.2:3.3": "Творила разнообразную иллюзию,",
 "thig5.2:3.4": "высмеивая многих людей.",
 "thig5.2:4.1": "Сегодня, собрав подаяние,",
 "thig5.2:4.2": "обритая, в накидку одетая;",
 "thig5.2:4.3": "Сев у подножия дерева,",
 "thig5.2:4.4": "достигла без-рассуждения.",
 "thig5.2:5.1": "Все связи отсечены,",
 "thig5.2:5.2": "которые божественные и которые человеческие;",
 "thig5.2:5.3": "Исчерпав истечения все,",
 "thig5.2:5.4": "охлаждённой стала я, угасшей”.",
 "thig5.2:6.1": "… Виссаттха, бывшая проститутка, тхери …."
}
