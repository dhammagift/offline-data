{
 "thig5.1:0.1": "Тхеригатха 5.1",
 "thig5.1:0.2": "Пятое собрание",
 "thig5.1:0.3": "Некая старшая тхери",
 "thig5.1:1.1": "“Двадцать пять лет,",
 "thig5.1:1.2": "с тех пор как я ушла в бездомную жизнь;",
 "thig5.1:1.3": "Даже на мгновение щелчка пальцев",
 "thig5.1:1.4": "успокоения ума не обрела.",
 "thig5.1:2.1": "Не обретя разума покоя,",
 "thig5.1:2.2": "желанием-страстью истекающая;",
 "thig5.1:2.3": "Руки воздев и рыдая,",
 "thig5.1:2.4": "в обитель-вихару вошла я.",
 "thig5.1:3.1": "Я к монахине подошла,",
 "thig5.1:3.2": "которая мне верной была;",
 "thig5.1:3.3": "Та мне Дхамму преподала,",
 "thig5.1:3.4": "блоки-области-дхату.",
 "thig5.1:4.1": "Её Дхамму услышав,",
 "thig5.1:4.2": "в стороне я села;",
 "thig5.1:4.3": "Прошлые-жизни знаю,",
 "thig5.1:4.4": "божественное око очищено.",
 "thig5.1:5.1": "И знание охвата ума,",
 "thig5.1:5.2": "дхату слуха очищена;",
 "thig5.1:5.3": "И сверхспособности мной реализованы,",
 "thig5.1:5.4": "достигнуто мной исчерпание истечений;",
 "thig5.1:5.5": "Шесть прямых знаний реализованы,",
 "thig5.1:5.6": "исполнено Будды указание”.",
 "thig5.1:6.1": "… Некая старшая …."
}
