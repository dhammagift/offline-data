{
 "thig13.4:0.1": "Тхеригатха 13.4",
 "thig13.4:0.2": "Двадцати-глава",
 "thig13.4:0.3": "Сундаритхеригатха",
 "thig13.4:1.1": "«Мёртвых, госпожа, сыновей,",
 "thig13.4:1.2": "поедая, ты прежде;",
 "thig13.4:1.3": "Ты днём и ночью,",
 "thig13.4:1.4": "чрезвычайно сокрушаешься.",
 "thig13.4:2.1": "Та же ныне всех съев,",
 "thig13.4:2.2": "сто сыновей, брахманка;",
 "thig13.4:2.3": "Васеттхи, каким образом,",
 "thig13.4:2.4": "не сильно сокрушаешься?»",
 "thig13.4:3.1": "«Многие сотни сыновей,",
 "thig13.4:3.2": "и сотни собраний родственников;",
 "thig13.4:3.3": "Съедены в прошлом,",
 "thig13.4:3.4": "мной и тобой, брахман.",
 "thig13.4:4.1": "Я же, спасение познав,",
 "thig13.4:4.2": "от рождения и умирания;",
 "thig13.4:4.3": "Не печалюсь, не плачу,",
 "thig13.4:4.4": "и не сокрушаюсь».",
 "thig13.4:5.1": "«Удивительно, о Васеттхи,",
 "thig13.4:5.2": "речь говоришь такую;",
 "thig13.4:5.3": "Чью ты Дхамму познав,",
 "thig13.4:5.4": "голос говоришь такой».",
 "thig13.4:6.1": "«Этот, брахман, правильно пробуждённый,",
 "thig13.4:6.2": "в город Митхилу направляющегося;",
 "thig13.4:6.3": "Для полного покидания всякой боли,",
 "thig13.4:6.4": "Учение излагает существам.",
 "thig13.4:7.1": "Его, брахман, араханта,",
 "thig13.4:7.2": "Учение услышав, без-подпитки;",
 "thig13.4:7.3": "Там распознав-истинные-явления,",
 "thig13.4:7.4": "сына-страдание я развеяла”.",
 "thig13.4:8.1": "“Так и я пойду,",
 "thig13.4:8.2": "в город Митхилу направляющегося;",
 "thig13.4:8.3": "Может меня тот Благословенный,",
 "thig13.4:8.4": "от всякой боли освободит”.",
 "thig13.4:9.1": "Увидел брахман Пробуждённого,",
 "thig13.4:9.2": "освобождённого, без-подпитки;",
 "thig13.4:9.3": "Тот ему явление преподал,",
 "thig13.4:9.4": "мудрец, боли превзошедший.",
 "thig13.4:10.1": "Боль, боле-возникновение,",
 "thig13.4:10.2": "и боли преодоление;",
 "thig13.4:10.3": "Благородный восьмичастный путь,",
 "thig13.4:10.4": "К успокоению боли ведущий.",
 "thig13.4:11.1": "Там распознав-истинные-явления,",
 "thig13.4:11.2": "посвящение одобрил;",
 "thig13.4:11.3": "Суджато за три ночи,",
 "thig13.4:11.4": "три знания коснулся.",
 "thig13.4:12.1": "“Ты иди, колесничий, иди,",
 "thig13.4:12.2": "колесницу верни сюда;",
 "thig13.4:12.3": "Здоровье брахманке скажи,",
 "thig13.4:12.4": "‘Посвятился теперь брахман;",
 "thig13.4:12.5": "Суджато за три ночи,",
 "thig13.4:12.6": "три знания коснулся’”.",
 "thig13.4:13.1": "И затем колесницу взяв,",
 "thig13.4:13.2": "и тысячу тоже колесничий;",
 "thig13.4:13.3": "Здоровье брахманке сказал,",
 "thig13.4:13.4": "“Посвятился теперь брахман;",
 "thig13.4:13.5": "Суджато за три ночи,",
 "thig13.4:13.6": "три знания коснулся”.",
 "thig13.4:14.1": "“И эту я колесницу с лошадьми,",
 "thig13.4:14.2": "и тысячу тоже колесничий;",
 "thig13.4:14.3": "Тройное знание брахмана услышав,",
 "thig13.4:14.4": "полную чашу даю тебе”.",
 "thig13.4:15.1": "“Твоим пусть будет конь с колесницей,",
 "thig13.4:15.2": "и тысяча, брахманка;",
 "thig13.4:15.3": "Я тоже уйду в бездомность,",
 "thig13.4:15.4": "вблизи высшего-понимания”.",
 "thig13.4:16.1": "“Слонов, коров, коней, жемчуг и серьги,",
 "thig13.4:16.2": "и это обильное домашнее богатство оставив;",
 "thig13.4:16.3": "Отец ушёл в бездомность твой,",
 "thig13.4:16.4": "наслаждайся благами, красавица;",
 "thig13.4:16.5": "Ты наследница в роду”.",
 "thig13.4:17.1": "“Слонов, коров, коней, жемчуг и серьги,",
 "thig13.4:17.2": "и это прекрасное домашнее богатство оставив;",
 "thig13.4:17.3": "Отец ушёл в бездомность мой,",
 "thig13.4:17.4": "страданием о сыне мучимый;",
 "thig13.4:17.5": "Я тоже уйду в бездомность,",
 "thig13.4:17.6": "страданием о брате мучимая”.",
 "thig13.4:18.1": "“Пусть тебе удастся намерение,",
 "thig13.4:18.2": "которое ты желаешь, красавица;",
 "thig13.4:18.3": "Собранное подаяние и сбор остатков,",
 "thig13.4:18.4": "и тряпичная одежда;",
 "thig13.4:18.5": "Эти преодолевая,",
 "thig13.4:18.6": "в другом мире без истечений”.",
 "thig13.4:19.1": "“Ученице мне, почтенная,",
 "thig13.4:19.2": "божественное-око очищено;",
 "thig13.4:19.3": "Прошлые-жизни знаю,",
 "thig13.4:19.4": "где мной прожито прежде.",
 "thig13.4:20.1": "На тебя полагаясь, благая,",
 "thig13.4:20.2": "старица, в Сангхе прекрасная;",
 "thig13.4:20.3": "Три знания достигнуты,",
 "thig13.4:20.4": "исполнено Будды указание.",
 "thig13.4:21.1": "Разреши мне, почтенная,",
 "thig13.4:21.2": "хочу в Саваттхи пойти;",
 "thig13.4:21.3": "Львиный рык издам я,",
 "thig13.4:21.4": "вблизи наилучшего пробуждённого”.",
 "thig13.4:22.1": "“Узри, Сундари, Учителя,",
 "thig13.4:22.2": "золотого цвета, с кожей блестящей;",
 "thig13.4:22.3": "Необузданных обуздателя,",
 "thig13.4:22.4": "пробуждённого, откуда нет страха”.",
 "thig13.4:23.1": "“Узри Сундари, пришедшую,",
 "thig13.4:23.2": "освобождённого, без-подпитки;",
 "thig13.4:23.3": "без очарованности, освобождённую,",
 "thig13.4:23.4": "сделавшую должное, без истечений.",
 "thig13.4:24.1": "Из Варанаси выйдя,",
 "thig13.4:24.2": "к твоей близости пришла;",
 "thig13.4:24.3": "Ученица твоя, великий герой,",
 "thig13.4:24.4": "к ногам припадает, Сундари.",
 "thig13.4:25.1": "Ты пробуждённый, ты Учитель,",
 "thig13.4:25.2": "твоя дочь я, брахман;",
 "thig13.4:25.3": "Родная, из уст рождённая,",
 "thig13.4:25.4": "сделавшая должное, без истечений”.",
 "thig13.4:26.1": "“Тебе — добро пожаловать, благая,",
 "thig13.4:26.2": "оттуда тебе — не плохо пришла;",
 "thig13.4:26.3": "Вот так обученные приходят,",
 "thig13.4:26.4": "к стопам Учителя припадая;",
 "thig13.4:26.5": "без очарованности, освобождённые,",
 "thig13.4:26.6": "сделавшая должное, без истечений”.",
 "thig13.4:27.1": "… Сундари Тхери …."
}
