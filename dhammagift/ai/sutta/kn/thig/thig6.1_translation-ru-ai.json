{
 "thig6.1:0.1": "Тхеригатха 6.1",
 "thig6.1:0.2": "Глава шестых",
 "thig6.1:0.3": "Пятьсот-с-лишним-тхеригатха",
 "thig6.1:1.1": "“Чей путь не знаешь,",
 "thig6.1:1.2": "пришедшего или ушедшего;",
 "thig6.1:1.3": "Откуда пришедшее существо,",
 "thig6.1:1.4": "‘мой сын’ плачешь.",
 "thig6.1:2.1": "Путь же ведь знаешь,",
 "thig6.1:2.2": "пришедшего или ушедшего;",
 "thig6.1:2.3": "Его не сокрушаешься,",
 "thig6.1:2.4": "такова природа у дышащих.",
 "thig6.1:3.1": "Неприглашённый оттуда пришёл,",
 "thig6.1:3.2": "неразрешённый отсюда ушёл;",
 "thig6.1:3.3": "Откуда-то ведь придя,",
 "thig6.1:3.4": "пожив несколько дней;",
 "thig6.1:3.5": "Отсюда в другое ушёл,",
 "thig6.1:3.6": "оттуда с пониманием идёт.",
 "thig6.1:4.1": "Ушедший в человеческом образе,",
 "thig6.1:4.2": "блуждая, уйдёт;",
 "thig6.1:4.3": "Как пришёл, так ушёл,",
 "thig6.1:4.4": "какой там плач?”",
 "thig6.1:5.1": "“Вынул, поистине, у меня стрелу,",
 "thig6.1:5.2": "трудно-видимую, в сердце-сидящую;",
 "thig6.1:5.3": "Которая у меня, страданием охваченной,",
 "thig6.1:5.4": "сына-страдание развеяла.",
 "thig6.1:6.1": "Я сегодня с вынутой стрелой,",
 "thig6.1:6.2": "Без-голода, полностью-угасшая;",
 "thig6.1:6.3": "Будду, Дхамму и Сангху,",
 "thig6.1:6.4": "Прихожу к прибежищу мудреца”.",
 "thig6.1:7.1": "Так действительно пятьсот-с-лишним тхери монахини …."
}
