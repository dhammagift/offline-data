{
 "thig6.4:0.1": "Тхеригатха 6.4",
 "thig6.4:0.2": "Глава шестых",
 "thig6.4:0.3": "Суджататхеригатха",
 "thig6.4:1.1": "“Украшенная, хорошо одетая,",
 "thig6.4:1.2": "гирляндами сандалом умащённая;",
 "thig6.4:1.3": "Всеми украшениями покрытая,",
 "thig6.4:1.4": "толпой служанок окружённая.",
 "thig6.4:2.1": "Еду и питьё взяв,",
 "thig6.4:2.2": "закуски, кушанья немалые;",
 "thig6.4:2.3": "Из дома выйдя,",
 "thig6.4:2.4": "в парк я направилась.",
 "thig6.4:3.1": "Там насладившись, наигравшись,",
 "thig6.4:3.2": "возвращаясь в свой дом;",
 "thig6.4:3.3": "Монастырь увидеть вошла я,",
 "thig6.4:3.4": "в Сакете, Аньджана-рощу.",
 "thig6.4:4.1": "Увидев Светоч мира,",
 "thig6.4:4.2": "поклонившись, я села;",
 "thig6.4:4.3": "Он мне явление объяснил,",
 "thig6.4:4.4": "из сострадания Зрячий.",
 "thig6.4:5.1": "Услышав же Великого провидца,",
 "thig6.4:5.2": "истину я постигла;",
 "thig6.4:5.3": "Тут же незапылённое явление,",
 "thig6.4:5.4": "коснулась я бессмертного шага.",
 "thig6.4:6.1": "Затем, познав благое Учение,",
 "thig6.4:6.2": "покинул жизнь в бездомность;",
 "thig6.4:6.3": "Три знания достигнуты,",
 "thig6.4:6.4": "не напрасно Учение Пробуждённого”.",
 "thig6.4:7.1": "… Суджата тхери …."
}
