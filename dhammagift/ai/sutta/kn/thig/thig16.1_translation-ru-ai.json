{
 "thig16.1:0.1": "Тхеригатха 16.1",
 "thig16.1:0.2": "Великая глава",
 "thig16.1:0.3": "Сумeдхатхeригатха",
 "thig16.1:1.1": "В Мантавати городе,",
 "thig16.1:1.2": "Царя Кончи главной жены;",
 "thig16.1:1.3": "Дочерью была я, Сумeдха,",
 "thig16.1:1.4": "Убеждённая в наставниках-делателях.",
 "thig16.1:2.1": "Нравственная, красноречивая,",
 "thig16.1:2.2": "Многоучёная, в Учении Пробуждённого обученная;",
 "thig16.1:2.3": "К матери-отцу подойдя,",
 "thig16.1:2.4": "Говорит: “Оба послушайте.",
 "thig16.1:3.1": "В ниббане радостна я,",
 "thig16.1:3.2": "Непостоянно бхава-достижение, даже если божественное;",
 "thig16.1:3.3": "Что уж говорить о пустых желаниях,",
 "thig16.1:3.4": "Малоприятных, многотревожных.",
 "thig16.1:4.1": "Желания горьки, как змея,",
 "thig16.1:4.2": "Яду подобны, в которых одурманены глупцы;",
 "thig16.1:4.3": "Они долгое время в аду,",
 "thig16.1:4.4": "Погружённые, мучаются, больные.",
 "thig16.1:5.1": "Страдают плохие-деятели,",
 "thig16.1:5.2": "В падении плохое-умножающие всегда;",
 "thig16.1:5.3": "Телом и речью,",
 "thig16.1:5.4": "И умом необузданные глупцы.",
 "thig16.1:6.1": "Глупцы те плохо-понимающие,",
 "thig16.1:6.2": "Неосмысляющие, боле-скапливанием остановленные;",
 "thig16.1:6.3": "Учащие не знающие,",
 "thig16.1:6.4": "Не понимают благородные истины.",
 "thig16.1:7.1": "Истины, мама, Буддой-лучшим-изложенные,",
 "thig16.1:7.2": "Те большинство не знающие которые;",
 "thig16.1:7.3": "Радуются бхава-достигнутому,",
 "thig16.1:7.4": "Жаждут у дэвов перерождения.",
 "thig16.1:8.1": "У дэвов также перерождение,",
 "thig16.1:8.2": "Непостоянно в бхава-достигнутом ненадёжном;",
 "thig16.1:8.3": "И не трепещут глупцы,",
 "thig16.1:8.4": "Снова и снова рождения-подлежащего.",
 "thig16.1:9.1": "Четыре падения,",
 "thig16.1:9.2": "И два пути кое-как получаются;",
 "thig16.1:9.3": "И у падших-достигших,",
 "thig16.1:9.4": "Ухода нет в адах.",
 "thig16.1:10.1": "Разрешите мне, оба,",
 "thig16.1:10.2": "Уйти в учение десятисильного;",
 "thig16.1:10.3": "Беспечально буду стараться,",
 "thig16.1:10.4": "Для рождения-умирания-покидания.",
 "thig16.1:11.1": "Что в бхава-достигнутом радованием,",
 "thig16.1:11.2": "Тела-комком никчёмным;",
 "thig16.1:11.3": "Бытия-цепляния устранения ради,",
 "thig16.1:11.4": "Разрешите, уйду.",
 "thig16.1:12.1": "Пробуждённых появление упущено,",
 "thig16.1:12.2": "Не-момент момент получен;",
 "thig16.1:12.3": "Принципы, святая жизнь,",
 "thig16.1:12.4": "Пока жива, не нарушу”.",
 "thig16.1:13.1": "Так говорит Сумедха,",
 "thig16.1:13.2": "Родителям: “Пока не приму пищу;",
 "thig16.1:13.3": "Приму, домохозяева,",
 "thig16.1:13.4": "Смерти во власти буду я”.",
 "thig16.1:14.1": "Мать больна, плачет и отец,",
 "thig16.1:14.2": "Вся полностью подавлена;",
 "thig16.1:14.3": "Пытаются убедить,",
 "thig16.1:14.4": "На террасе дворца на землю упавшую.",
 "thig16.1:15.1": "“Встань, дитя, что печалишься,",
 "thig16.1:15.2": "Тобой отданы в Варанавати;",
 "thig16.1:15.3": "Царь Аникаратта,",
 "thig16.1:15.4": "Красив, ему ты отдана.",
 "thig16.1:16.1": "Главной женой будешь,",
 "thig16.1:16.2": "Аникаратты царя супругой;",
 "thig16.1:16.3": "Принципы, святая жизнь,",
 "thig16.1:16.4": "Уход в бездомные труден, дитя.",
 "thig16.1:17.1": "В царстве власть, богатство, господство,",
 "thig16.1:17.2": "Наслаждения приятны, ты молода;",
 "thig16.1:17.3": "Наслаждайся желания-благами,",
 "thig16.1:17.4": "Свадьба пусть будет твоя, дитя”.",
 "thig16.1:18.1": "Тогда их говорит Сумедха,",
 "thig16.1:18.2": "“Не такого рода бхава-существование лишено сути;",
 "thig16.1:18.3": "Уход в бездомные или будет,",
 "thig16.1:18.4": "Смерть для меня не была бы желанной.",
 "thig16.1:19.1": "Зачем в гнилом теле нечистое,",
 "thig16.1:19.2": "Смердящее, устрашающее, мертвечину;",
 "thig16.1:19.3": "Я бы уселась в мешок,",
 "thig16.1:19.4": "Постоянно сочащийся, полный нечистот.",
 "thig16.1:20.1": "Зачем, зная это,",
 "thig16.1:20.2": "Отвратительное, мясом и кровью измазанное;",
 "thig16.1:20.3": "Обитель червей, пища птиц,",
 "thig16.1:20.4": "Тело кому отдаётся.",
 "thig16.1:21.1": "Уносят на кладбище,",
 "thig16.1:21.2": "Вскоре тело, лишённое распознавания;",
 "thig16.1:21.3": "Выброшенное, как полено,",
 "thig16.1:21.4": "Гнушающимися родственниками.",
 "thig16.1:22.1": "Выбросив его на кладбище,",
 "thig16.1:22.2": "Чужой пищей моются, гнушаясь;",
 "thig16.1:22.3": "Свои мать и отец,",
 "thig16.1:22.4": "Что уж говорить о чужих людях.",
 "thig16.1:23.1": "Привязаны к лишённому сути,",
 "thig16.1:23.2": "Телу — скоплению костей и жил;",
 "thig16.1:23.3": "Слюны, мочи, кала,",
 "thig16.1:23.4": "Полному в гнилом теле.",
 "thig16.1:24.1": "Кто его, разобрав,",
 "thig16.1:24.2": "Внутреннее его наружу сделал бы;",
 "thig16.1:24.3": "Запаха не вынося,",
 "thig16.1:24.4": "Даже собственная мать стала бы брезговать.",
 "thig16.1:25.1": "Блоки-дхату-области,",
 "thig16.1:25.2": "Составное, рождение-корневую боль;",
 "thig16.1:25.3": "Первопричинно исследуя,",
 "thig16.1:25.4": "Варению чего бы я желала.",
 "thig16.1:26.1": "День за днём трижды семьдесят,",
 "thig16.1:26.2": "Сотен девять-девять падали бы на тело;",
 "thig16.1:26.3": "Даже сто лет убийства,",
 "thig16.1:26.4": "Лучше боли если так исчерпание.",
 "thig16.1:27.1": "Приняла бы убийство,",
 "thig16.1:27.2": "Кто распознал бы так Учителя слово;",
 "thig16.1:27.3": "‘Длинна их сансара,",
 "thig16.1:27.4": "Снова и снова убиваемых’.",
 "thig16.1:28.1": "У дэвов и у людей,",
 "thig16.1:28.2": "В лоне животных, в теле асуров;",
 "thig16.1:28.3": "У претов и в адах,",
 "thig16.1:28.4": "Безмерные видны убийства.",
 "thig16.1:29.1": "Убийства в адах многие,",
 "thig16.1:29.2": "У попавшего в бедствие, угнетаемого;",
 "thig16.1:29.3": "Даже у дэвов нет защиты,",
 "thig16.1:29.4": "Ниббана-приятного выше нет.",
 "thig16.1:30.1": "Достигли те ниббаны,",
 "thig16.1:30.2": "Кто привержен учению Десятисильного;",
 "thig16.1:30.3": "Беззаботные стараются,",
 "thig16.1:30.4": "Для рождения-умирания-покидания.",
 "thig16.1:31.1": "Сегодня же, отец, я ухожу в бездомную жизнь —",
 "thig16.1:31.2": "Смешанное с наслаждениями — что с несущественными?",
 "thig16.1:31.3": "Пресыщена я желаниями,",
 "thig16.1:31.4": "Как выблеванное, с пальмой-основанием-сравнимое”.",
 "thig16.1:32.1": "Она так говорит отцу —",
 "thig16.1:32.2": "Ани-кара-ратта, которому она отдана;",
 "thig16.1:32.3": "Прибыл в Варанаватту,",
 "thig16.1:32.4": "В свадебное время, когда настало время.",
 "thig16.1:33.1": "Тогда черные, густые, мягкие,",
 "thig16.1:33.2": "Волосы мечом отрезав, Сумедха;",
 "thig16.1:33.3": "Терем заперев,",
 "thig16.1:33.4": "Первую джхану достигла.",
 "thig16.1:34.1": "И она там достигшая,",
 "thig16.1:34.2": "Ани-кара-ратта же прибыл в город;",
 "thig16.1:34.3": "И в тереме Сумедха",
 "thig16.1:34.4": "Ненадёжности-сознавание развивает.",
 "thig16.1:35.1": "И она обдумывает,",
 "thig16.1:35.2": "Ани-кара-ратта же взошел поспешно;",
 "thig16.1:35.3": "С драгоценностями и золотом украшенный телом,",
 "thig16.1:35.4": "Сложив ладони, просит Сумедху.",
 "thig16.1:36.1": "“В царстве власть-богатство-смеша-",
 "thig16.1:36.2": "Нность, наслаждения приятны, ты молода;",
 "thig16.1:36.3": "Наслаждайся желания-благами,",
 "thig16.1:36.4": "Желания-удовольствия трудно достижимы в мире.",
 "thig16.1:37.1": "Оставлено тобой царство,”",
 "thig16.1:37.2": "Богатством пользуйся, давай подаяния;",
 "thig16.1:37.3": "Не будь недовольна,",
 "thig16.1:37.4": "Мать и отец твои больны”.",
 "thig16.1:38.1": "То ей говорит Сумедха,",
 "thig16.1:38.2": "К желаниям бесцельная, лишённая заблуждения;",
 "thig16.1:38.3": "“Не радуйся желаниям,",
 "thig16.1:38.4": "В желаниях недостаток-опасность узри.",
 "thig16.1:39.1": "Царь четырёх континентов,",
 "thig16.1:39.2": "Мандхата был путём наслаждающихся желаниями;",
 "thig16.1:39.3": "Ненасыщенный скончался,",
 "thig16.1:39.4": "И не были исполнены его желания.",
 "thig16.1:40.1": "Семь драгоценностей пролились бы дождём,",
 "thig16.1:40.2": "Дождь десяти сторон со всех сторон;",
 "thig16.1:40.3": "Нет насыщения желаниями,",
 "thig16.1:40.4": "Ненасыщенными умирают люди.",
 "thig16.1:41.1": "С мечом-колом подобны желания,",
 "thig16.1:41.2": "желания — с головой змеи подобны;",
 "thig16.1:41.3": "С факелом подобны сжигают,",
 "thig16.1:41.4": "скелету подобны.",
 "thig16.1:42.1": "Ненадёжны, непостоянны желания,",
 "thig16.1:42.2": "многобольны, великий яд;",
 "thig16.1:42.3": "Как раскалённый железный шар,",
 "thig16.1:42.4": "корень беды, боль-плодны.",
 "thig16.1:43.1": "С плодом дерева подобны желания,",
 "thig16.1:43.2": "кускам мяса подобны боли;",
 "thig16.1:43.3": "Сну подобны обманчивые,",
 "thig16.1:43.4": "желания взятому взаймы подобны.",
 "thig16.1:44.1": "Как копья-острия желания,",
 "thig16.1:44.2": "болезнь, опухоль, страдание, мучение;",
 "thig16.1:44.3": "Угольной яме подобны,",
 "thig16.1:44.4": "страдания-корень, тревога, убийство.",
 "thig16.1:45.1": "Так много-болезненны желания,",
 "thig16.1:45.2": "названы препятствующие;",
 "thig16.1:45.3": "Идите, не мне в бхаву-ушедшие,",
 "thig16.1:45.4": "доверие есть к себе.",
 "thig16.1:46.1": "Что мне другой сделает,",
 "thig16.1:46.2": "Своей голове горящей;",
 "thig16.1:46.3": "Сопровождая старение-умирание,",
 "thig16.1:46.4": "Того ради уничтожения должно стараться”.",
 "thig16.1:47.1": "Дверь открыв я,",
 "thig16.1:47.2": "Мать-отца и не-сделавших;",
 "thig16.1:47.3": "Увидев на земле сидящих,",
 "thig16.1:47.4": "Плачущих это сказала.",
 "thig16.1:48.1": "“Длинна глупых сансара,",
 "thig16.1:48.2": "Снова и снова плачущих;",
 "thig16.1:48.3": "Неизмеримого отца умирание,",
 "thig16.1:48.4": "Брата убийство и своё убийство.",
 "thig16.1:49.1": "Слезу, молоко, кровь,",
 "thig16.1:49.2": "Сансару неизмеримую помните;",
 "thig16.1:49.3": "Существ скитающихся,",
 "thig16.1:49.4": "Вспомни костей накопление.",
 "thig16.1:50.1": "Вспомни четыре океана,",
 "thig16.1:50.2": "Наполненные слезами, молоком и кровью;",
 "thig16.1:50.3": "Вспомни за одну каппу костей,",
 "thig16.1:50.4": "Накопление с огромным сравнением.",
 "thig16.1:51.1": "В неисчислимом начале скитающегося,",
 "thig16.1:51.2": "Землю Джамбудипы наполненную;",
 "thig16.1:51.3": "Шарики величиной с плод кола,",
 "thig16.1:51.4": "Матерей матери не хватает.",
 "thig16.1:52.1": "Траву-древесину-ветви-листья,",
 "thig16.1:52.2": "Наполненное в неисчислимом начале вспомни;",
 "thig16.1:52.3": "Четырёхпальцевые кусочки,",
 "thig16.1:52.4": "Отцов отцы не хватают.",
 "thig16.1:53.1": "Вспомни слепую черепаху в прежнем",
 "thig16.1:53.2": "Океане и с другой стороны ярмо с дырой;",
 "thig16.1:53.3": "Голову её и вставленную,",
 "thig16.1:53.4": "В человеческом обретении сравнение.",
 "thig16.1:54.1": "Вспомни форму как комок пены по-",
 "thig16.1:54.2": "Добно телу-грязи без сути;",
 "thig16.1:54.3": "Блоки узри ненадёжными,",
 "thig16.1:54.4": "Вспомни в аду многие мучения.",
 "thig16.1:55.1": "Вспомни труп увеличивающим,",
 "thig16.1:55.2": "Снова и снова в тех и других рождениях;",
 "thig16.1:55.3": "Помни страхи крокодилов и,",
 "thig16.1:55.4": "Помни четыре истины.",
 "thig16.1:56.1": "Когда бессмертное существует,",
 "thig16.1:56.2": "Что тебе в выпитой пятерной горечи;",
 "thig16.1:56.3": "Ведь все желания-радости,",
 "thig16.1:56.4": "Горче пятерной горечи.",
 "thig16.1:57.1": "Когда бессмертное существует,",
 "thig16.1:57.2": "Что тебе в желаниях, которые — жгучие муки;",
 "thig16.1:57.3": "Ведь все желания-радости,",
 "thig16.1:57.4": "Пылающие, кипящие, дрожащие, палящие.",
 "thig16.1:58.1": "Когда [они] без-врагов,",
 "thig16.1:58.2": "Что тебе в желаниях, которые — многовраги;",
 "thig16.1:58.3": "Царь, огонь, вор, вода, нелюбимые,",
 "thig16.1:58.4": "Общие желания — многовраги.",
 "thig16.1:59.1": "Когда освобождение существует,",
 "thig16.1:59.2": "Что тебе в желаниях, в которых — убийство-оковы;",
 "thig16.1:59.3": "Ведь в желаниях не-желающие,",
 "thig16.1:59.4": "Убийство-оковы-боли переживают.",
 "thig16.1:60.1": "Зажжённый травяной факел,",
 "thig16.1:60.2": "Хватающего жжёт, не отпускающего;",
 "thig16.1:60.3": "Ведь желания — как факел,",
 "thig16.1:60.4": "Жгут тех, кто их не отпускает.",
 "thig16.1:61.1": "Не из-за малого,",
 "thig16.1:61.2": "Ради желания-приятного оставь огромное приятное;",
 "thig16.1:61.3": "Не будь как рыба путхулома на крючок,",
 "thig16.1:61.4": "Проглотив, потом будешь мучиться.",
 "thig16.1:62.1": "Желание, в желаниях обуздай себя,",
 "thig16.1:62.2": "До тех пор как собака на цепи;",
 "thig16.1:62.3": "Сделают же тебя желания,",
 "thig16.1:62.4": "Голодные, как собаку, чандалы.",
 "thig16.1:63.1": "И безмерную боль,",
 "thig16.1:63.2": "И многие ум-недовольства;",
 "thig16.1:63.3": "Будешь переживать, с желаниями связанный,",
 "thig16.1:63.4": "Оставь ненадёжные желания.",
 "thig16.1:64.1": "Когда нестареющее существует,",
 "thig16.1:64.2": "Что тебе в желаниях, в которых старение;",
 "thig16.1:64.3": "Смертью-болезнью охвачены,",
 "thig16.1:64.4": "Все, везде, рождения.",
 "thig16.1:65.1": "Это нестареющее, это бессмертное,",
 "thig16.1:65.2": "Это нестареющее-бессмертное состояние, без-страдальное;",
 "thig16.1:65.3": "Без-врагов, без-стеснения,",
 "thig16.1:65.4": "Без-спотыкания, без-тревоги, без-мучения.",
 "thig16.1:66.1": "Достигнуто это многими,",
 "thig16.1:66.2": "Бессмертное, и сегодня может быть получено это;",
 "thig16.1:66.3": "Кто первопричинно прилагает усилие,",
 "thig16.1:66.4": "Но не может [тот, кто] не прилагает усилия”.",
 "thig16.1:67.1": "Так говорит Сумедха,",
 "thig16.1:67.2": "В составляющие-ушедшее радости не находя;",
 "thig16.1:67.3": "Успокаивая, не-радующаяся,",
 "thig16.1:67.4": "И волосы на землю бросила премудрая.",
 "thig16.1:68.1": "Встав, не-радующаяся,",
 "thig16.1:68.2": "Сложив ладони, просит она отца того;",
 "thig16.1:68.3": "“Отпустите Сумедху,",
 "thig16.1:68.4": "Уйти в бездомные, чтобы увидеть истину освобождения”.",
 "thig16.1:69.1": "Отпущенная матерью и отцом,",
 "thig16.1:69.2": "ушла в бездомные, страхом страдания устрашённая;",
 "thig16.1:69.3": "Шесть прямых знаний осуществлены,",
 "thig16.1:69.4": "высший плод — обучающейся.",
 "thig16.1:70.1": "Удивительное, небывалое то,",
 "thig16.1:70.2": "ниббана была у царевны;",
 "thig16.1:70.3": "Поведение прошлых жизней,",
 "thig16.1:70.4": "как она объяснила в последнее время.",
 "thig16.1:71.1": "“При Благословенном Конагамане,",
 "thig16.1:71.2": "в новом жилище при Сангхараме;",
 "thig16.1:71.3": "Три подруги, женщины,",
 "thig16.1:71.4": "дарование обители мы дали.",
 "thig16.1:72.1": "Десять раз, сто раз,",
 "thig16.1:72.2": "десять-сот раз и сотни сто раз;",
 "thig16.1:72.3": "Среди дэвов мы рождались,",
 "thig16.1:72.4": "что уж говорить о людях.",
 "thig16.1:73.1": "Среди дэвов великой силой мы были,",
 "thig16.1:73.2": "в человеческом — что уж говорить;",
 "thig16.1:73.3": "Семи-драгоценного главной женой,",
 "thig16.1:73.4": "драгоценностью-женщиной я была.",
 "thig16.1:74.1": "То причина, то источник,",
 "thig16.1:74.2": "Тот корень, и в учении терпение;",
 "thig16.1:74.3": "То первое соединение,",
 "thig16.1:74.4": "То от радости-явлений ниббана.",
 "thig16.1:75.1": "Так делают те, кто звук-",
 "thig16.1:75.2": "Уничтожают выражение безмерно-понимающего;",
 "thig16.1:75.3": "Разочаровываются в бхава-ушедшем,",
 "thig16.1:75.4": "Разочаровавшись, отстраняются”.",
 "thig16.1:76.1": "Так действительно Сумедха Тхери стихи произнесла.",
 "thig16.1:76.2": "Большой раздел установлен.",
 "thig16.1:77.0": "Завершены Стихи старших монахинь",
 "thig16.1:77.1": "Четыре сотни строф,",
 "thig16.1:77.2": "восемьдесят и ещё четырнадцать;",
 "thig16.1:77.3": "Монахинь сто одна,",
 "thig16.1:77.4": "все они исчерпания истечений.",
 "thig16.1:77.5": "Пали Стихов старших монахинь завершена."
}
