{
 "thig6.3:0.1": "Тхеригатха 6.3",
 "thig6.3:0.2": "Глава шестых",
 "thig6.3:0.3": "Кхематхеригатха",
 "thig6.3:1.1": "“Ты молода, красива,",
 "thig6.3:1.2": "я тоже молодая юная;",
 "thig6.3:1.3": "Пятичастным оркестром,",
 "thig6.3:1.4": "иди, Кхема, будем радоваться”.",
 "thig6.3:2.1": "“Этим пахучим телом,",
 "thig6.3:2.2": "больным, разваливающимся;",
 "thig6.3:2.3": "Тошнит меня, стыжусь я,",
 "thig6.3:2.4": "желания-цепляние устранено.",
 "thig6.3:3.1": "Как копья-острия желания,",
 "thig6.3:3.2": "блоки — разделочная плаха;",
 "thig6.3:3.3": "Что ‘ты желание-радость’ говоришь,",
 "thig6.3:3.4": "‘не-радованием’ теперь она для меня.",
 "thig6.3:4.1": "Везде разрушена радость,",
 "thig6.3:4.2": "глыба тьмы расколота;",
 "thig6.3:4.3": "Так знай, Злой,",
 "thig6.3:4.4": "повержен ты, кончающий.",
 "thig6.3:5.1": "Созвездия почитая,",
 "thig6.3:5.2": "огонь обходя в лесу;",
 "thig6.3:5.3": "Как-есть не зная,",
 "thig6.3:5.4": "глупцы чистоту воображали.",
 "thig6.3:6.1": "Я же, почитая,",
 "thig6.3:6.2": "пробуждённого, высшего человека;",
 "thig6.3:6.3": "Освобождена от всех болей,",
 "thig6.3:6.4": "Учителя наставление исполняющая”.",
 "thig6.3:7.1": "… Кхема тхери …."
}
