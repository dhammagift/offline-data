{
 "thig2.5:0.1": "Тхеригатха 2.5",
 "thig2.5:0.2": "Двойное собрание",
 "thig2.5:0.3": "Читта-тхеригатха",
 "thig2.5:1.1": "“Хоть я и худая,",
 "thig2.5:1.2": "больная, крайне слабая;",
 "thig2.5:1.3": "На посох опираясь иду,",
 "thig2.5:1.4": "на гору взобравшись.",
 "thig2.5:2.1": "Верхнюю накидку сняв,",
 "thig2.5:2.2": "и чашу перевернув;",
 "thig2.5:2.3": "На скале оперла себя,",
 "thig2.5:2.4": "тьмы-глыбу расколов”.",
 "thig2.5:3.1": "… Читта тхери …."
}
