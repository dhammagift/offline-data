{
 "thig4.1:0.1": "Тхеригатха 4.1",
 "thig4.1:0.2": "Четыре строфы",
 "thig4.1:0.3": "Бхаддакапиланитхеригатха",
 "thig4.1:1.1": "“Сын Будды наследник,",
 "thig4.1:1.2": "Кассапа хорошо-сосредоточен;",
 "thig4.1:1.3": "Прежние обители кто знает,",
 "thig4.1:1.4": "небеса-и-падения видит.",
 "thig4.1:2.1": "а после рождения-исчерпания достигший,",
 "thig4.1:2.2": "прямым знанием завершённый мудрец;",
 "thig4.1:2.3": "Этими тремя знаниями,",
 "thig4.1:2.4": "тройной-знающий есть брахман.",
 "thig4.1:3.1": "Также Бхадда Капилани,",
 "thig4.1:3.2": "тройная-знающая смерть-побеждающая;",
 "thig4.1:3.3": "Несёт последнее тело,",
 "thig4.1:3.4": "победив Мару с его свитой.",
 "thig4.1:4.1": "Увидев опасность в мире,",
 "thig4.1:4.2": "оба ушли мы;",
 "thig4.1:4.3": "Мы с-истекшими-истечениями, укрощённые,",
 "thig4.1:4.4": "ставшие-прохладными, угасшие”.",
 "thig4.1:5.1": "… Бхадда Капилани тхери ….",
 "thig4.1:6.1": "Четверная группа установлена."
}
