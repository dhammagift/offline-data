{
 "thig3.1:0.1": "Тхеригатха 3.1",
 "thig3.1:0.2": "Тройной раздел",
 "thig3.1:0.3": "Апарасама-тхеригатха",
 "thig3.1:1.1": "“Двадцать пять лет,",
 "thig3.1:1.2": "с тех пор как я ушла в бездомную жизнь;",
 "thig3.1:1.3": "Не припоминаю ума-состояния,",
 "thig3.1:1.4": "ровность обретённую когда-либо.",
 "thig3.1:2.1": "Не обретя разума покоя,",
 "thig3.1:2.2": "над умом-состоянием не властвующая;",
 "thig3.1:2.3": "Оттого я вдохновение-трепет обрела,",
 "thig3.1:2.4": "вспомнив Победителя указание.",
 "thig3.1:3.1": "Многими болевыми явлениями,",
 "thig3.1:3.2": "не-беспечностью-радостью моей;",
 "thig3.1:3.3": "Цепляния исчерпание достигнуто,",
 "thig3.1:3.4": "исполнено Будды указание;",
 "thig3.1:3.5": "Сегодня мне седьмая ночь,",
 "thig3.1:3.6": "с тех пор как цепляние иссушено”.",
 "thig3.1:4.1": "… Апара Сама тхери …."
}
