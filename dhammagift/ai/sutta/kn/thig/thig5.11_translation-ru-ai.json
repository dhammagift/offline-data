{
 "thig5.11:0.1": "Тхеригатха 5.11",
 "thig5.11:0.2": "Пятое собрание",
 "thig5.11:0.3": "Тридцать монахинь-тхери",
 "thig5.11:1.1": "“Песты взяв,",
 "thig5.11:1.2": "зерно толкут юноши;",
 "thig5.11:1.3": "Детей и жён содержа,",
 "thig5.11:1.4": "богатство находят юноши.",
 "thig5.11:2.1": "Делайте Учение Пробуждённого,",
 "thig5.11:2.2": "которую сделав, не сожалеют;",
 "thig5.11:2.3": "Быстро ноги омыв,",
 "thig5.11:2.4": "с одного края садитесь;",
 "thig5.11:2.5": "Равновесию-ума-самадхи посвящённые,",
 "thig5.11:2.6": "делайте Учение Пробуждённого”.",
 "thig5.11:3.1": "Те её слова услышав,",
 "thig5.11:3.2": "Патачары наставление;",
 "thig5.11:3.3": "Ноги омыв,",
 "thig5.11:3.4": "с одного края сели;",
 "thig5.11:3.5": "Равновесию-ума-самадхи посвящённые,",
 "thig5.11:3.6": "сделали Учение Пробуждённого.",
 "thig5.11:4.1": "Ночью в первую стражу,",
 "thig5.11:4.2": "прошлые рождения вспомнили;",
 "thig5.11:4.3": "Ночью в среднюю стражу,",
 "thig5.11:4.4": "божественный глаз очистили;",
 "thig5.11:4.5": "Ночью в последнюю стражу,",
 "thig5.11:4.6": "тьмы-глыбу раскололи.",
 "thig5.11:5.1": "Встав, ноги почтили,",
 "thig5.11:5.2": "“сделано твоё наставление;",
 "thig5.11:5.3": "Как Индру дэвы тридцати,",
 "thig5.11:5.4": "в столкновении непобеждённого;",
 "thig5.11:5.5": "Окружив, будем пребывать,",
 "thig5.11:5.6": "три-ведения имеем, без-истечений”.",
 "thig5.11:6.1": "Так, действительно, тридцать старших монахинь вблизи Патачары о высшем заявили."
}
