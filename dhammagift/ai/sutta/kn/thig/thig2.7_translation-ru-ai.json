{
 "thig2.7:0.1": "Тхеригатха 2.7",
 "thig2.7:0.2": "Двойное собрание",
 "thig2.7:0.3": "Миттатхеригатха",
 "thig2.7:1.1": "“Четырнадцатый, пятнадцатый,",
 "thig2.7:1.2": "и который половины месяца восьмой;",
 "thig2.7:1.3": "И чудесная половина месяца,",
 "thig2.7:1.4": "восьмичастно-хорошо-собранную.",
 "thig2.7:2.1": "Упосатху я соблюла,",
 "thig2.7:2.2": "дэвов-тела радующаяся;",
 "thig2.7:2.3": "Она сегодня одной едой,",
 "thig2.7:2.4": "обритая, в накидку одетая;",
 "thig2.7:2.5": "Дэвов-тела не желаю,",
 "thig2.7:2.6": "выведя из сердца тревогу”.",
 "thig2.7:3.1": "… Тхери Митта …."
}
