{
 "thig13.2:0.1": "Тхеригатха 13.2",
 "thig13.2:0.2": "Двадцати-глава",
 "thig13.2:0.3": "Рохини-тхеригатха",
 "thig13.2:1.1": "«“Шраманы”, почтенная, спишь,”",
 "thig13.2:1.2": "“шраманы” пробуждаешься;",
 "thig13.2:1.3": "Шраманов только восхваляешь,",
 "thig13.2:1.4": "шраманкой верно станешь.",
 "thig13.2:2.1": "Обильную еду и питьё,”",
 "thig13.2:2.2": "шраманам подаёшь;",
 "thig13.2:2.3": "Рохини, сейчас спрашиваю,",
 "thig13.2:2.4": "чем тебе шраманы милы.",
 "thig13.2:3.1": "Не-активности-желающие, ленивые,”",
 "thig13.2:3.2": "чужим подаянием живущие;",
 "thig13.2:3.3": "Надеющиеся, сладкого-желающие,",
 "thig13.2:3.4": "чем тебе шраманы милы”.",
 "thig13.2:4.1": "“Давно же меня, отец,”",
 "thig13.2:4.2": "о шраманах расспрашиваешь;",
 "thig13.2:4.3": "Им тебе расскажу,",
 "thig13.2:4.4": "понимание-нравственность-усердие.",
 "thig13.2:5.1": "Активности-желающие, неленивые,”",
 "thig13.2:5.2": "лучшей-активности делатели;",
 "thig13.2:5.3": "Страсть, злобу покидают,",
 "thig13.2:5.4": "тем мне шраманы милы.",
 "thig13.2:6.1": "Три плохого корня,”",
 "thig13.2:6.2": "стряхивают чистодеятели;",
 "thig13.2:6.3": "Всё плохое ими отброшено,",
 "thig13.2:6.4": "тем мне шраманы милы.",
 "thig13.2:7.1": "Телесная активность чиста у них,",
 "thig13.2:7.2": "и речевая активность такова;",
 "thig13.2:7.3": "Умственная активность чиста у них,",
 "thig13.2:7.4": "тем мне шраманы милы.",
 "thig13.2:8.1": "Без пятен, как очищенная раковина,",
 "thig13.2:8.2": "чисты внутри и снаружи;",
 "thig13.2:8.3": "Полны светлых явлений,",
 "thig13.2:8.4": "тем мне шраманы милы.",
 "thig13.2:9.1": "Многоучёные, эксперты в Дхамме,",
 "thig13.2:9.2": "благородные, живущие Дхаммой;",
 "thig13.2:9.3": "Благо-смысл-цель и Дхамму объясняют,",
 "thig13.2:9.4": "тем мне шраманы милы.",
 "thig13.2:10.1": "Многоучёные, эксперты в Дхамме,",
 "thig13.2:10.2": "благородные, живущие Дхаммой;",
 "thig13.2:10.3": "С однонаправленным умом, памятливые,",
 "thig13.2:10.4": "тем мне шраманы милы.",
 "thig13.2:11.1": "Далеко идущие, памятливые,",
 "thig13.2:11.2": "речи знатоки, без возбуждения;",
 "thig13.2:11.3": "Боли край понимают,",
 "thig13.2:11.4": "тем мне шраманы милы.",
 "thig13.2:12.1": "Из какой бы деревни ни уходили,",
 "thig13.2:12.2": "не оглядываются ни на что;",
 "thig13.2:12.3": "Без привязанности идут,",
 "thig13.2:12.4": "тем мне шраманы милы.",
 "thig13.2:13.1": "Не складывают они в амбары,",
 "thig13.2:13.2": "ни в кувшин, ни в корзину;",
 "thig13.2:13.3": "Завершён их поиск,",
 "thig13.2:13.4": "тем мне шраманы милы.",
 "thig13.2:14.1": "Не берут они золото,",
 "thig13.2:14.2": "ни серебро, ни деньги;",
 "thig13.2:14.3": "Текущим существуют,",
 "thig13.2:14.4": "тем мне шраманы милы.",
 "thig13.2:15.1": "Из разных семей ушли в бездомность,",
 "thig13.2:15.2": "и из разных стран;",
 "thig13.2:15.3": "Друг друга любят,",
 "thig13.2:15.4": "тем мне шраманы милы”.",
 "thig13.2:16.1": "“Для блага ведь нас, почтенная,",
 "thig13.2:16.2": "в роду родилась ты, Рохини;",
 "thig13.2:16.3": "Вера в пробуждённого и в Дхамму,",
 "thig13.2:16.4": "и в Сангху с глубоким почтением.",
 "thig13.2:17.1": "Ты это знаешь,",
 "thig13.2:17.2": "поле блага непревзойдённое;",
 "thig13.2:17.3": "Нам также эти шраманы,",
 "thig13.2:17.4": "принимают подношение.",
 "thig13.2:18.1": "Установлено здесь жертвоприношение,",
 "thig13.2:18.2": "обильное у нас будет”;",
 "thig13.2:18.3": "“Если боишься боли,",
 "thig13.2:18.4": "если тебе боль неприятна.",
 "thig13.2:19.1": "Приди к прибежищу в Пробуждённом,",
 "thig13.2:19.2": "в Дхамме и в Сангхе такого;",
 "thig13.2:19.3": "Прими принципы,",
 "thig13.2:19.4": "это тебе для блага-смысла-цели будет”.",
 "thig13.2:20.1": "“Прихожу к прибежищу в Пробуждённом,",
 "thig13.2:20.2": "в Дхамме и в Сангхе такого;",
 "thig13.2:20.3": "Принимаю принципы,",
 "thig13.2:20.4": "это мне для блага-смысла-цели будет.",
 "thig13.2:21.1": "Брахма-родственником прежде был я,",
 "thig13.2:21.2": "теперь же я брахман;",
 "thig13.2:21.3": "Трёхзнающий учёный я,",
 "thig13.2:21.4": "сведущий я омытый”.",
 "thig13.2:22.1": "… Рохини Тхери …."
}
