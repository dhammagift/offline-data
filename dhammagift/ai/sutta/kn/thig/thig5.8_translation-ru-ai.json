{
 "thig5.8:0.1": "Тхеригатха 5.8",
 "thig5.8:0.2": "Пятое собрание",
 "thig5.8:0.3": "Сонатхеригатха",
 "thig5.8:1.1": "“Десять сыновей родив,",
 "thig5.8:1.2": "в этом образе-нагромождении;",
 "thig5.8:1.3": "Тут я, слабая, старая,",
 "thig5.8:1.4": "к монахине приблизилась.",
 "thig5.8:2.1": "Та мне Дхамму преподала,",
 "thig5.8:2.2": "блоки-области-дхату;",
 "thig5.8:2.3": "Её Дхамму услышав,",
 "thig5.8:2.4": "волосы обрезав, покинула.",
 "thig5.8:3.1": "У меня, обучающейся,",
 "thig5.8:3.2": "божественное-око очищено;",
 "thig5.8:3.3": "Прошлые-жизни знаю,",
 "thig5.8:3.4": "где мной прожито прежде.",
 "thig5.8:4.1": "И без-знаковость развиваю,",
 "thig5.8:4.2": "однонаправленная, хорошо-сосредоточенная;",
 "thig5.8:4.3": "Непосредственно-после-освобождения стала,",
 "thig5.8:4.4": "не-поддерживая, угасшая.",
 "thig5.8:5.1": "Пять блоков всесторонне поняты,",
 "thig5.8:5.2": "стоят с отрезанным корнем;",
 "thig5.8:5.3": "Проклятие тебе, старость, низкая,",
 "thig5.8:5.4": "отныне нет повторной вовлеченности-[индивидуального] существования”.",
 "thig5.8:6.1": "… Сона тхери …."
}
