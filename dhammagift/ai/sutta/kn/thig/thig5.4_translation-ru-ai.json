{
 "thig5.4:0.1": "Тхеригатха 5.4",
 "thig5.4:0.2": "Пятое собрание",
 "thig5.4:0.3": "Сундаринандатхеригатха",
 "thig5.4:1.1": "“Больное, нечистое, гниющее,",
 "thig5.4:1.2": "увидь, Нанда, это тело;",
 "thig5.4:1.3": "В не-ладности ум развивай,",
 "thig5.4:1.4": "однонаправлено, хорошо собрано.",
 "thig5.4:2.1": "Как это — так то,",
 "thig5.4:2.2": "как это так и это;",
 "thig5.4:2.3": "Вонючее, гнилостное веет,",
 "thig5.4:2.4": "глупцами радуемое.",
 "thig5.4:3.1": "Так это рассматривая,",
 "thig5.4:3.2": "ночью и днём неутомимые;",
 "thig5.4:3.3": "Затем своим пониманием,",
 "thig5.4:3.4": "отвратившись, увижу”.",
 "thig5.4:4.1": "“У меня, прилежной,",
 "thig5.4:4.2": "исследующей первопричинно;",
 "thig5.4:4.3": "Как-есть это тело,",
 "thig5.4:4.4": "увидено внутренне-внешне.",
 "thig5.4:5.1": "Тогда я пресытилась телом,",
 "thig5.4:5.2": "и внутренне стала бесстрастной;",
 "thig5.4:5.3": "Прилежная, освобождённая,",
 "thig5.4:5.4": "успокоена я, угасла”.",
 "thig5.4:6.1": "… Сундаринанда тхери …."
}
