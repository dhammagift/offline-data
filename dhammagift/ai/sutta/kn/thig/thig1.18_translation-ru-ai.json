{
 "thig1.18:0.1": "Тхеригатха 1.18",
 "thig1.18:0.2": "Раздел из одного",
 "thig1.18:0.3": "Сангхатхеригатха",
 "thig1.18:1.1": "“Оставив дом, уйдя в бездомность,",
 "thig1.18:1.2": "оставив сына, скотину милую;",
 "thig1.18:1.3": "Оставив страсть и злобу,",
 "thig1.18:1.4": "и незнания выцветание-бесстрастие;",
 "thig1.18:1.5": "С корнем цепляние вырвав,",
 "thig1.18:1.6": "успокоена я, угасла”.",
 "thig1.18:2.1": "… Сангха тхери ….",
 "thig1.18:3.1": "Первая часть завершена."
}
