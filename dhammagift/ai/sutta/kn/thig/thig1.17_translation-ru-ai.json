{
 "thig1.17:0.1": "Тхеригатха 1.17",
 "thig1.17:0.2": "Раздел из одного",
 "thig1.17:0.3": "Дхамма-тхеригатха",
 "thig1.17:1.1": "“Пиндапату обойдя,",
 "thig1.17:1.2": "на посох опираясь, слабая;",
 "thig1.17:1.3": "С дрожащими членами,",
 "thig1.17:1.4": "тут же упала я на землю;",
 "thig1.17:1.5": "Увидев опасность в теле,",
 "thig1.17:1.6": "тогда ум мой освободился”.",
 "thig1.17:2.1": "… Дхамма тхери …."
}
