{
 "thig3.3:0.1": "Тхеригатха 3.3",
 "thig3.3:0.2": "Тройной раздел",
 "thig3.3:0.3": "Апарауттаматхеригатха",
 "thig3.3:1.1": "«Эти семь аспектов пробуждения,",
 "thig3.3:1.2": "пути к ниббане-достижению;",
 "thig3.3:1.3": "Развиты они мной все,",
 "thig3.3:1.4": "как Пробуждённым указаны.",
 "thig3.3:2.1": "Пустотности, без-знака,",
 "thig3.3:2.2": "достигшая я, как желаю;",
 "thig3.3:2.3": "Родная дочь Пробуждённого,",
 "thig3.3:2.4": "ниббаной радующаяся всегда.",
 "thig3.3:3.1": "Все желания отсечены,",
 "thig3.3:3.2": "которые божественные и которые человеческие;",
 "thig3.3:3.3": "Исчерпан рождение-круговорот,",
 "thig3.3:3.4": "отныне нет повторной вовлеченности-[индивидуального] существования”.",
 "thig3.3:4.1": "… Апара уттама тхери …."
}
