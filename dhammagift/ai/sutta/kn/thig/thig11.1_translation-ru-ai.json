{
 "thig11.1:0.1": "Тхеригатха 11.1",
 "thig11.1:0.2": "Раздел двенадцати",
 "thig11.1:0.3": "Уппалаваннатхеригатха",
 "thig11.1:1.1": "“Обе — и мать, и дочь —",
 "thig11.1:1.2": "мы были соперницами;",
 "thig11.1:1.3": "У меня той возникло вдохновение,",
 "thig11.1:1.4": "чудесное, волосы-дыбящее.",
 "thig11.1:2.1": "Прокляты желания, нечистые,",
 "thig11.1:2.2": "зловонные, со многими шипами;",
 "thig11.1:2.3": "Где мать и дочь",
 "thig11.1:2.4": "все вместе жёнами мы были.",
 "thig11.1:3.1": "В желаниях недостаток-опасность увидев,",
 "thig11.1:3.2": "отречение видя безопасным;",
 "thig11.1:3.3": "Та ушла в бездомность в Раджагахе,",
 "thig11.1:3.4": "из дома в бездомность.",
 "thig11.1:4.1": "Прошлые-жизни знаю,",
 "thig11.1:4.2": "божественное-око очищено;",
 "thig11.1:4.3": "И знание охвата ума,",
 "thig11.1:4.4": "дхату уха очищена.",
 "thig11.1:5.1": "И сверхспособности мной реализованы,",
 "thig11.1:5.2": "достигнуто мной исчерпание истечений;",
 "thig11.1:5.3": "Шесть прямых знаний реализованы,",
 "thig11.1:5.4": "исполнено Будды указание.",
 "thig11.1:6.1": "Силой сотворив",
 "thig11.1:6.2": "четырёхугольную колесницу, я;",
 "thig11.1:6.3": "Будды стопы почтив,",
 "thig11.1:6.4": "мира вождя, Такового”.",
 "thig11.1:7.1": "“К прекрасно цветущей вершине подойдя, дереву,",
 "thig11.1:7.2": "Одна ты стоишь у салового дерева;",
 "thig11.1:7.3": "И нет у тебя второй никого,",
 "thig11.1:7.4": "Глупая, не боишься ты обманщиков?”.",
 "thig11.1:8.1": "“Пусть сотня тысяч мошенников,",
 "thig11.1:8.2": "Собравшиеся такими бы стали;",
 "thig11.1:8.3": "Волос не дрогнет и не содрогнётся,",
 "thig11.1:8.4": "Что мне ты, Мара, сделаешь один.",
 "thig11.1:9.1": "Вот я исчезаю,",
 "thig11.1:9.2": "В живот или вхожу тебе;",
 "thig11.1:9.3": "Между бровей стою,",
 "thig11.1:9.4": "Стоящую меня не увидишь.",
 "thig11.1:10.1": "В уме-состоянии подвластна я,",
 "thig11.1:10.2": "Основы сверхспособностей хорошо развиты;",
 "thig11.1:10.3": "Шесть прямых знаний реализованы,",
 "thig11.1:10.4": "исполнено Будды указание.",
 "thig11.1:11.1": "Как копья-острия желания,",
 "thig11.1:11.2": "блоки — разделочная плаха;",
 "thig11.1:11.3": "Что ты ‘желания-радостью’ называешь,",
 "thig11.1:11.4": "‘отвращение’ теперь то моё.",
 "thig11.1:12.1": "Везде разрушена радость,",
 "thig11.1:12.2": "Тьмы-глыба расколота;",
 "thig11.1:12.3": "Так знай, Злой,",
 "thig11.1:12.4": "Повержен ты, кончающий».",
 "thig11.1:13.1": "… Уппалаванна Тхери ….",
 "thig11.1:14.1": "Двенадцатая глава установлена."
}
