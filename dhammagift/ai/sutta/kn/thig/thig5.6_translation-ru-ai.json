{
 "thig5.6:0.1": "Тхеригатха 5.6",
 "thig5.6:0.2": "Пятое собрание",
 "thig5.6:0.3": "Миттакалитхеригатха",
 "thig5.6:1.1": "“С верой уйдя в бездомность,",
 "thig5.6:1.2": "из дома в бездомность;",
 "thig5.6:1.3": "Скиталась я туда-сюда,",
 "thig5.6:1.4": "в приобретении-почтении усердная.",
 "thig5.6:2.1": "Оставив высочайшее благо,",
 "thig5.6:2.2": "низкое благо я практиковала;",
 "thig5.6:2.3": "Загрязнениям под власть попав,",
 "thig5.6:2.4": "цели шраманства не понимала.",
 "thig5.6:3.1": "У меня той возникло вдохновение,",
 "thig5.6:3.2": "сидящей в жилище;",
 "thig5.6:3.3": "На ложный путь я вступила,",
 "thig5.6:3.4": "цеплянию под власть попав.",
 "thig5.6:4.1": "Коротка жизнь моя,",
 "thig5.6:4.2": "старение и болезнь сокрушают;",
 "thig5.6:4.3": "Прежде чем это тело разрушится,",
 "thig5.6:4.4": "нет мне времени быть беспечной.",
 "thig5.6:5.1": "Как-есть взирая,",
 "thig5.6:5.2": "блоков возникновение-исчезновение;",
 "thig5.6:5.3": "Освобождённая в уме, я встала,",
 "thig5.6:5.4": "исполнено Будды указание”.",
 "thig5.6:6.1": "… Митта Кали тхери …."
}
