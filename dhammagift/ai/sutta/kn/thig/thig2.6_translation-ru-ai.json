{
 "thig2.6:0.1": "Тхеригатха 2.6",
 "thig2.6:0.2": "Двойное собрание",
 "thig2.6:0.3": "Меттикатхеригатха",
 "thig2.6:1.1": "“Хоть я и в боли,",
 "thig2.6:1.2": "слабая, ушедшая юность;",
 "thig2.6:1.3": "На посох опираясь иду,",
 "thig2.6:1.4": "на гору взобравшись.",
 "thig2.6:2.1": "Сняв накидку,",
 "thig2.6:2.2": "и чашу перевернув;",
 "thig2.6:2.3": "Сидящей я на скале,",
 "thig2.6:2.4": "тогда ум мой освободился;",
 "thig2.6:2.5": "Три знания достигнуты,",
 "thig2.6:2.6": "исполнено Будды указание”.",
 "thig2.6:3.1": "… Меттика тхери …."
}
