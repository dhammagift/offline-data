{
 "thig5.9:0.1": "Тхеригатха 5.9",
 "thig5.9:0.2": "Пятое собрание",
 "thig5.9:0.3": "Бхаддакундалакесатхеригатха",
 "thig5.9:1.1": "«С обритыми волосами, в грязи,",
 "thig5.9:1.2": "в одной накидке прежде я ходила;",
 "thig5.9:1.3": "В без-проступке проступок видящей,",
 "thig5.9:1.4": "в проступке же без-проступок видящей.",
 "thig5.9:2.1": "Из дневного пребывания выйдя,",
 "thig5.9:2.2": "на Пике Стервятников горе;",
 "thig5.9:2.3": "Увидела без-пыльного Пробуждённого,",
 "thig5.9:2.4": "монашеским собранием окружённого.",
 "thig5.9:3.1": "Опустившись на колени, поклонившись,",
 "thig5.9:3.2": "перед ним сложила ладони;",
 "thig5.9:3.3": "«Иди, бхадда» — мне сказал он,",
 "thig5.9:3.4": "это мне было полным посвящением.",
 "thig5.9:4.1": "Пройдены Анга и Магадха,",
 "thig5.9:4.2": "Вадджи, Каси и Косала;",
 "thig5.9:4.3": "Без долгов пятьдесят лет",
 "thig5.9:4.4": "подаяние по странам я ела.",
 "thig5.9:5.1": "Заслугу, поистине, породил большую,",
 "thig5.9:5.2": "Мудрый, поистине, этот мирянин;",
 "thig5.9:5.3": "Кто Бхадде одеяние дал,",
 "thig5.9:5.4": "полностью освобождённой от всех уз».",
 "thig5.9:6.1": "… Бхадда Кундалакеса тхери …."
}
