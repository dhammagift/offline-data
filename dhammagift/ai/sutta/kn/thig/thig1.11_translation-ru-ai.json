{
 "thig1.11:0.1": "Тхеригатха 1.11",
 "thig1.11:0.2": "Раздел из одного",
 "thig1.11:0.3": "Муттатхеригатха",
 "thig1.11:1.1": "«Хорошо освобождена, хорошо освобождена я,",
 "thig1.11:1.2": "от трех горбатых освобождением;",
 "thig1.11:1.3": "Ступой, пестом,",
 "thig1.11:1.4": "от мужа-горбатого;",
 "thig1.11:1.5": "Освобождена я от рождения-умирания,",
 "thig1.11:1.6": "с проводником к индивидуальному существованию покончено».",
 "thig1.11:2.1": "… Мутта тхери …."
}
