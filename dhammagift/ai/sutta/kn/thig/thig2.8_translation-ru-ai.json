{
 "thig2.8:0.1": "Тхеригатха 2.8",
 "thig2.8:0.2": "Двойное собрание",
 "thig2.8:0.3": "Тхери Абхаямата",
 "thig2.8:1.1": "“Вверх от подошв ступней, мама,",
 "thig2.8:1.2": "вниз от корней волос головы;",
 "thig2.8:1.3": "Осмотри это тело,",
 "thig2.8:1.4": "нечистое, гнилостно-пахнущее.",
 "thig2.8:2.1": "Так пребывающей,",
 "thig2.8:2.2": "вся страсть устранена;",
 "thig2.8:2.3": "Жжение отсечено,",
 "thig2.8:2.4": "охлаждённой стала я, угасшей”.",
 "thig2.8:3.1": "… Тхери Абхаямата …."
}
