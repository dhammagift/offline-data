{
 "thig8.1:0.1": "Тхеригатха 8.1",
 "thig8.1:0.2": "Восьмеричная группа",
 "thig8.1:0.3": "Сисупачала-тхеригатха",
 "thig8.1:1.1": "“Монахиня, нравственностью наделённая,",
 "thig8.1:1.2": "в индриях хорошо-сдерживаемая;",
 "thig8.1:1.3": "Достигает пути покоя,",
 "thig8.1:1.4": "не-насыщающий сок”.",
 "thig8.1:2.1": "«Тридцатитрёх и Ямы",
 "thig8.1:2.2": "и Туситы божества;",
 "thig8.1:2.3": "Нимманарати божества,",
 "thig8.1:2.4": "и те божества, что властвуют;",
 "thig8.1:2.5": "Там ум-состояние направь,",
 "thig8.1:2.6": "где твоё прожито прежде”.",
 "thig8.1:3.1": "«Тридцатитрёх и Ямы",
 "thig8.1:3.2": "и Туситы божества;",
 "thig8.1:3.3": "Нимманарати божества,",
 "thig8.1:3.4": "и те божества, что властвуют.",
 "thig8.1:4.1": "Время от времени существование-за-существованием,",
 "thig8.1:4.2": "в самости-теле предваряемые;",
 "thig8.1:4.3": "Не превзойдя самость,",
 "thig8.1:4.4": "рождение-умирание-несущие.",
 "thig8.1:5.1": "Весь охвачен огнём свет,",
 "thig8.1:5.2": "весь свет освещён;",
 "thig8.1:5.3": "Весь зажжён свет,",
 "thig8.1:5.4": "весь свет сотрясён.",
 "thig8.1:6.1": "Неколебимое, несравнимое,",
 "thig8.1:6.2": "обывателями не посещаемое;",
 "thig8.1:6.3": "Будда Дхамму научил,",
 "thig8.1:6.4": "в том мой ум-представление рад.",
 "thig8.1:7.1": "Того его слово услышав,",
 "thig8.1:7.2": "пребываю в учении радостная;",
 "thig8.1:7.3": "Три знания достигнуты,",
 "thig8.1:7.4": "исполнено Будды указание.",
 "thig8.1:8.1": "Везде разрушена радость,",
 "thig8.1:8.2": "глыба тьмы расколота;",
 "thig8.1:8.3": "Так знай, Злой,",
 "thig8.1:8.4": "повержен ты, кончина”.",
 "thig8.1:9.1": "… Сисупачала тхери ….",
 "thig8.1:10.1": "Восьмая глава установлена."
}
