{
 "thig7.1:0.1": "Тхеригатха 7.1",
 "thig7.1:0.2": "Семёрки",
 "thig7.1:0.3": "Уттара-тхеригатха",
 "thig7.1:1.1": "“Песты взяв,",
 "thig7.1:1.2": "зерно толкут юноши;",
 "thig7.1:1.3": "Детей и жён содержа,",
 "thig7.1:1.4": "богатство находят юноши.",
 "thig7.1:2.1": "Стремитесь в пробуждённого-учении,",
 "thig7.1:2.2": "которую сделав, не сожалеют;",
 "thig7.1:2.3": "Быстро ноги омыв,",
 "thig7.1:2.4": "с одной стороны садитесь.",
 "thig7.1:3.1": "Ум установив,",
 "thig7.1:3.2": "однонаправленный, хорошо сосредоточенный;",
 "thig7.1:3.3": "Рассматривайте составляющие,",
 "thig7.1:3.4": "как чужое и не как себя”.",
 "thig7.1:4.1": "“Её речь услышав,",
 "thig7.1:4.2": "Патачары наставление;",
 "thig7.1:4.3": "Ноги омыв,",
 "thig7.1:4.4": "с одной стороны я села.",
 "thig7.1:5.1": "Ночью в первую стражу,",
 "thig7.1:5.2": "прежние рождения вспомнила;",
 "thig7.1:5.3": "Ночью в среднюю стражу,",
 "thig7.1:5.4": "божественный-глаз очистила.",
 "thig7.1:6.1": "Ночью в последнюю стражу,",
 "thig7.1:6.2": "тьмы-массу рассекла;",
 "thig7.1:6.3": "Тройным-знанием затем я встала,",
 "thig7.1:6.4": "сделано твоё наставление.",
 "thig7.1:7.1": "Как Сакку божества тридцати,",
 "thig7.1:7.2": "в столкновении непобеждённого;",
 "thig7.1:7.3": "Почтив, буду пребывать,",
 "thig7.1:7.4": "тройным-знанием я без-истечений”.",
 "thig7.1:8.1": "… Уттара тхери …."
}
