{
 "thig12.1:0.1": "Тхеригатха 12.1",
 "thig12.1:0.2": "Раздел шестнадцати",
 "thig12.1:0.3": "Пунна-тхеригатха",
 "thig12.1:1.1": "«Носительница воды я в холоде,",
 "thig12.1:1.2": "всегда в воду погружаюсь;",
 "thig12.1:1.3": "Госпожей из-за страха палки боясь,",
 "thig12.1:1.4": "из-за страха словесной ошибки трепеща.",
 "thig12.1:2.1": "Чего, брахман, ты боясь,",
 "thig12.1:2.2": "всегда в воду погружаешься;",
 "thig12.1:2.3": "С дрожащими членами,",
 "thig12.1:2.4": "холод чувствуешь сильно».",
 "thig12.1:3.1": "«Зная ведь меня, госпожа,",
 "thig12.1:3.2": "Пунника, ты спрашиваешь;",
 "thig12.1:3.3": "Совершающего благотворную активность,",
 "thig12.1:3.4": "сдерживающего сделанное плохое.",
 "thig12.1:4.1": "И кто стар или молод,",
 "thig12.1:4.2": "плохую активность совершает;",
 "thig12.1:4.3": "Водоокроплением тот,",
 "thig12.1:4.4": "от плохой активности освобождается».",
 "thig12.1:5.1": "«Кто же тебе это сказал,",
 "thig12.1:5.2": "незнающему незнающий;",
 "thig12.1:5.3": "Водоокроплением имя,",
 "thig12.1:5.4": "от плохой активности освобождается.",
 "thig12.1:6.1": "В рай уж пойдут,",
 "thig12.1:6.2": "все лягушки и черепахи;",
 "thig12.1:6.3": "Слоны и крокодилы,",
 "thig12.1:6.4": "и другие, кто в воде движется».",
 "thig12.1:7.1": "Овцебои, свинобои,",
 "thig12.1:7.2": "рыбаки, звероловы;",
 "thig12.1:7.3": "Преступники и палачи,",
 "thig12.1:7.4": "и иные плохую активность творящие;",
 "thig12.1:7.5": "Водоокроплением даже те,",
 "thig12.1:7.6": "от плохой активности освобождаются.",
 "thig12.1:8.1": "Если эти реки тебе,",
 "thig12.1:8.2": "плохое прежде сделанное множество;",
 "thig12.1:8.3": "Благо бы и они унесли тебе,",
 "thig12.1:8.4": "тем ты отрешён.",
 "thig12.1:9.1": "Чего ты, брахман, боясь,",
 "thig12.1:9.2": "всегда в воду погружаешься;",
 "thig12.1:9.3": "То самое, брахма, не делай,",
 "thig12.1:9.4": "чтобы тебе холод кожу не поразил”.",
 "thig12.1:10.1": "“На ложный путь вставшего меня,",
 "thig12.1:10.2": "на благородный путь наставила;",
 "thig12.1:10.3": "Водоокроплением, почтенная,",
 "thig12.1:10.4": "эту ткань даю тебе”.",
 "thig12.1:11.1": "“Твоей же ткань пусть будет,",
 "thig12.1:11.2": "я не желаю ткани;",
 "thig12.1:11.3": "Если боишься боли,",
 "thig12.1:11.4": "если тебе боль неприятна.",
 "thig12.1:12.1": "Не делай плохую активность,",
 "thig12.1:12.2": "явно или же тайно;",
 "thig12.1:12.3": "Если же плохую активность,",
 "thig12.1:12.4": "будешь делать или делаешь.",
 "thig12.1:13.1": "Тебе от боли нет освобождения,",
 "thig12.1:13.2": "подойдя и убегающего;",
 "thig12.1:13.3": "Если боишься боли,",
 "thig12.1:13.4": "если тебе боль неприятна.",
 "thig12.1:14.1": "Приди к прибежищу в Пробуждённом,",
 "thig12.1:14.2": "в Дхамме и в Сангхе такого;",
 "thig12.1:14.3": "Прими принципы,",
 "thig12.1:14.4": "это тебе для блага-смысла-цели будет”.",
 "thig12.1:15.1": "“Прихожу к прибежищу в Пробуждённом,",
 "thig12.1:15.2": "в Дхамме и в Сангхе такого;",
 "thig12.1:15.3": "Принимаю принципы,",
 "thig12.1:15.4": "это мне для блага-смысла-цели будет.",
 "thig12.1:16.1": "Брахма-родственником прежде был я,",
 "thig12.1:16.2": "сегодня я истинный брахман;",
 "thig12.1:16.3": "Тройной знаток, ведами-наделённый,",
 "thig12.1:16.4": "учёный и я омытый”.",
 "thig12.1:17.1": "… Пунна Тхери ….",
 "thig12.1:18.1": "Раздел шестнадцати установлен."
}
