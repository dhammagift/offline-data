{
 "thig13.5:0.1": "Тхеригатха 13.5",
 "thig13.5:0.2": "Двадцати-глава",
 "thig13.5:0.3": "Субхакуммарадхитатхеригатха",
 "thig13.5:1.1": "«Молодой я была, в чистом одеянии,",
 "thig13.5:1.2": "что прежде Дхамму услышала;",
 "thig13.5:1.3": "У меня, усердной,",
 "thig13.5:1.4": "постижение истины было.",
 "thig13.5:2.1": "Тогда я ко всем желаниям,",
 "thig13.5:2.2": "сильную неприязнь обрела;",
 "thig13.5:2.3": "В само-существовании тревогу увидев,",
 "thig13.5:2.4": "лишь отречения возжелала.",
 "thig13.5:3.1": "Оставив я родню-толпу,",
 "thig13.5:3.2": "и рабов, и работников;",
 "thig13.5:3.3": "Деревни, поля процветающие,",
 "thig13.5:3.4": "приятные, радостные.",
 "thig13.5:4.1": "Оставив, я ушла в бездомность,",
 "thig13.5:4.2": "богатство немалое;",
 "thig13.5:4.3": "Так, с верой уйдя,",
 "thig13.5:4.4": "в благой Дхамме, хорошо возвещенной.",
 "thig13.5:5.1": "Это не было бы уместным,",
 "thig13.5:5.2": "ведь ничего-не-имения желаю;",
 "thig13.5:5.3": "Кто золото, серебро,",
 "thig13.5:5.4": "выбросив, снова возвращается.",
 "thig13.5:6.1": "Серебро или золото",
 "thig13.5:6.2": "не для пробуждения, не для успокоения;",
 "thig13.5:6.3": "Это не подобает шраману,",
 "thig13.5:6.4": "это не благородное богатство.",
 "thig13.5:7.1": "Корыстолюбие и опьянение это,",
 "thig13.5:7.2": "замутнение, страсть-увеличение;",
 "thig13.5:7.3": "Рискованное, с большими усилиями,",
 "thig13.5:7.4": "нет здесь устойчивого пребывания.",
 "thig13.5:8.1": "В этом очарованные и беспечные,",
 "thig13.5:8.2": "с загрязнённым умом люди;",
 "thig13.5:8.3": "Друг с другом враждуя,",
 "thig13.5:8.4": "много совершают убийств.",
 "thig13.5:9.1": "Убийство, пленение, страдание,",
 "thig13.5:9.2": "потеря, страдание-причитание;",
 "thig13.5:9.3": "У тех, кто в желания погружён,",
 "thig13.5:9.4": "видно крушение большое.",
 "thig13.5:10.1": "Меня же родственники, словно враги,",
 "thig13.5:10.2": "«Что вас к желаниям привязывает?»;",
 "thig13.5:10.3": "Знайте меня ушедшей в бездомность,",
 "thig13.5:10.4": "в желаниях видящей угрозу.",
 "thig13.5:11.1": "Ни золотом, ни серебром",
 "thig13.5:11.2": "не истощаются истечения;",
 "thig13.5:11.3": "Враги-убийцы — желания,",
 "thig13.5:11.4": "недруги, стрела-оковы.",
 "thig13.5:12.1": "Меня же родственники, словно враги,",
 "thig13.5:12.2": "«Что вас к желаниям привязывает?»;",
 "thig13.5:12.3": "Знайте меня ушедшей в бездомность,",
 "thig13.5:12.4": "с обритой головой, в накидку одетую.",
 "thig13.5:13.1": "Собранное подаяние и сбор остатков,",
 "thig13.5:13.2": "и тряпичная одежда;",
 "thig13.5:13.3": "Это ведь мне подобает,",
 "thig13.5:13.4": "бездомного-опора.",
 "thig13.5:14.1": "Отброшены великими провидцами желания,",
 "thig13.5:14.2": "которые божественные и которые человеческие;",
 "thig13.5:14.3": "В безопасном месте освобождены те,",
 "thig13.5:14.4": "достигли те непоколебимого приятного.",
 "thig13.5:15.1": "Пусть я с желаниями не соединяюсь,",
 "thig13.5:15.2": "в которых защиты не различается;",
 "thig13.5:15.3": "Враги-убийцы — желания,",
 "thig13.5:15.4": "огня-груде-подобные, болезненные.",
 "thig13.5:16.1": "Препятствие это — тревога,",
 "thig13.5:16.2": "с-разрушением, с-шипом;",
 "thig13.5:16.3": "Жадность очень неровная эта,",
 "thig13.5:16.4": "великая, замутненности-пасть.",
 "thig13.5:17.1": "Напасть, ужасного-вида,",
 "thig13.5:17.2": "желания — змеи-голове-подобные;",
 "thig13.5:17.3": "Которые глупые радуются,",
 "thig13.5:17.4": "ослепшие обыватели.",
 "thig13.5:18.1": "В желания-болоте увязшие ведь,",
 "thig13.5:18.2": "многие в мире невежды;",
 "thig13.5:18.3": "Предела не знают,",
 "thig13.5:18.4": "рождения и умирания.",
 "thig13.5:19.1": "В плохой-удел-уход путь,",
 "thig13.5:19.2": "люди из-за желаний;",
 "thig13.5:19.3": "Многие ведь вступают,",
 "thig13.5:19.4": "себе болезнь приносящий.",
 "thig13.5:20.1": "Так врагов-порождающие,",
 "thig13.5:20.2": "мучение загрязняющее;",
 "thig13.5:20.3": "Мирские-приманки связывающие,",
 "thig13.5:20.4": "желания — умирания-связь.",
 "thig13.5:21.1": "Сводящие с ума, обманывающие,",
 "thig13.5:21.2": "желания — ум-состояние подавляющие;",
 "thig13.5:21.3": "Существ загрязнения ради,",
 "thig13.5:21.4": "быстро Марой расставлено.",
 "thig13.5:22.1": "Бесконечно-опасные желания,",
 "thig13.5:22.2": "многобольны, великий яд;",
 "thig13.5:22.3": "Мало-приятные, раздор-творящие,",
 "thig13.5:22.4": "светлую-сторону иссушающие.",
 "thig13.5:23.1": "Я же такое сделав,",
 "thig13.5:23.2": "бедствие желания-причинное;",
 "thig13.5:23.3": "То не вернусь,",
 "thig13.5:23.4": "ниббаной радующаяся всегда.",
 "thig13.5:24.1": "Раздор сотворив желаний,",
 "thig13.5:24.2": "прохлады-состояния желающая;",
 "thig13.5:24.3": "Не-беспечной пребуду,",
 "thig13.5:24.4": "всех связываний исчерпании.",
 "thig13.5:25.1": "Без-страданий, без-пыльное, защищённое,",
 "thig13.5:25.2": "благородно-восьмичастный прямой;",
 "thig13.5:25.3": "Тот путь прохожу,",
 "thig13.5:25.4": "которым переплыли великие-провидцы”.",
 "thig13.5:26.1": "“Эту видите в-явлении-стоящую,",
 "thig13.5:26.2": "прекрасную кузнеца-дочь;",
 "thig13.5:26.3": "Недвижимость достигнув,",
 "thig13.5:26.4": "у подножия дерева зажглась.",
 "thig13.5:27.1": "Сегодня восьмая, продвинувшаяся,",
 "thig13.5:27.2": "с верой, украшенная благой Дхаммой;",
 "thig13.5:27.3": "Воспитанная Уппалаванной,",
 "thig13.5:27.4": "тройное знание, смерть-устраняющая.",
 "thig13.5:28.1": "Вечером свободная, без долга,",
 "thig13.5:28.2": "монахиня с развитыми способностями;",
 "thig13.5:28.3": "От всех связей освобождённые,",
 "thig13.5:28.4": "сделавшая должное, без истечений”.",
 "thig13.5:29.1": "Её Сакка с сонмом дэвов,",
 "thig13.5:29.2": "подойдя силой;",
 "thig13.5:29.3": "Почтительно приветствует владыка существ,",
 "thig13.5:29.4": "прекрасную дочь кузнеца.",
 "thig13.5:30.1": "… Субха Тхери, дочь кузнеца ….",
 "thig13.5:31.1": "Двадцати-строфие установлено."
}
