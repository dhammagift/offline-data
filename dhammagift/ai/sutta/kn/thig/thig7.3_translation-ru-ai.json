{
 "thig7.3:0.1": "Тхеригатха 7.3",
 "thig7.3:0.2": "Семёрки",
 "thig7.3:0.3": "Упачала-тхеригатха",
 "thig7.3:1.1": "«Памятливая, глазастая,",
 "thig7.3:1.2": "монахиня с развитыми способностями;",
 "thig7.3:1.3": "Проникни в шаг покоя,",
 "thig7.3:1.4": "не-нечистыми-людьми-посещаемый».",
 "thig7.3:2.1": "“Что же рождение не одобряешь,",
 "thig7.3:2.2": "родившись желаниями наслаждается;",
 "thig7.3:2.3": "Вкушай желания-радости,",
 "thig7.3:2.4": "не будь потом сожалеющей”.",
 "thig7.3:3.1": "“У родившегося умирание есть,",
 "thig7.3:3.2": "рук-ног отсечение;",
 "thig7.3:3.3": "Убийство-связывание-мучение,",
 "thig7.3:3.4": "рождённый к боли идёт.",
 "thig7.3:4.1": "Есть в роду Сакьев рождённый,",
 "thig7.3:4.2": "полностью-пробуждённый непобеждённый;",
 "thig7.3:4.3": "Он мне явление объяснил,",
 "thig7.3:4.4": "рождения полное-преодоление.",
 "thig7.3:5.1": "Боль, боле-возникновение,",
 "thig7.3:5.2": "и боли преодоление;",
 "thig7.3:5.3": "Благородный Восьмеричный Путь,",
 "thig7.3:5.4": "К успокоению боли ведущий.",
 "thig7.3:6.1": "Того его слово услышав,",
 "thig7.3:6.2": "пребываю в учении радостная;",
 "thig7.3:6.3": "Три знания достигнуты,",
 "thig7.3:6.4": "исполнено Будды указание.",
 "thig7.3:7.1": "Везде разрушена радость,",
 "thig7.3:7.2": "глыба тьмы расколота;",
 "thig7.3:7.3": "Так знай, Злой,",
 "thig7.3:7.4": "повержен ты, кончина”.",
 "thig7.3:8.1": "… Упачала тхери ….",
 "thig7.3:9.1": "Семёрка завершена."
}
