{
 "thig3.5:0.1": "Тхеригатха 3.5",
 "thig3.5:0.2": "Тройной раздел",
 "thig3.5:0.3": "Уббири-тхеригатха",
 "thig3.5:1.1": "“Мама, Джива! — в лесу рыдаешь,",
 "thig3.5:1.2": "Себя обрети, Уббири;",
 "thig3.5:1.3": "Восемьдесят четыре тысячи,",
 "thig3.5:1.4": "Все с именем Джива;",
 "thig3.5:1.5": "На этом костре сожжены,",
 "thig3.5:1.6": "О ком же ты горюешь?”.",
 "thig3.5:2.1": "“Вынул, поистине, у меня стрелу,",
 "thig3.5:2.2": "трудно-видимую, в сердце-сидящую;",
 "thig3.5:2.3": "Которая у меня, горем-охваченной,",
 "thig3.5:2.4": "дочери-горе развеяла.",
 "thig3.5:3.1": "Я сегодня с вынутой стрелой,",
 "thig3.5:3.2": "Без-голода, полностью-угасшая;",
 "thig3.5:3.3": "Будду, Дхамму и Сангху,",
 "thig3.5:3.4": "Прихожу как прибежище, мудрец”.",
 "thig3.5:4.1": "… Уббири-тхери …."
}
