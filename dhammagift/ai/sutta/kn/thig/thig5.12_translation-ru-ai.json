{
 "thig5.12:0.1": "Тхеригатха 5.12",
 "thig5.12:0.2": "Пятое собрание",
 "thig5.12:0.3": "Тхери Чанда",
 "thig5.12:1.1": "«Бедной я была прежде,",
 "thig5.12:1.2": "вдовой и бездетной;",
 "thig5.12:1.3": "Без друзей и родных,",
 "thig5.12:1.4": "еды и одежды не доставала.",
 "thig5.12:2.1": "Чашу и посох взяв,",
 "thig5.12:2.2": "прося подаяние из дома в дом;",
 "thig5.12:2.3": "Холодом и жаром сжигаемая,",
 "thig5.12:2.4": "семь лет я странствовала.",
 "thig5.12:3.1": "Монахиню же увидев,",
 "thig5.12:3.2": "получающую еду и питьё;",
 "thig5.12:3.3": "Подойдя, я сказала:",
 "thig5.12:3.4": "«Посвящение в бездомность».",
 "thig5.12:4.1": "И она из сострадания ко мне,",
 "thig5.12:4.2": "посвятила меня, Патачара;",
 "thig5.12:4.3": "Затем, наставив меня,",
 "thig5.12:4.4": "к высшему благу побудила.",
 "thig5.12:5.1": "Того его слово услышав,",
 "thig5.12:5.2": "я исполнила наставление;",
 "thig5.12:5.3": "Не напрасным был совет досточтимой,",
 "thig5.12:5.4": "я — трижды знающая, без истечений».",
 "thig5.12:6.1": "… Тхери Чанда ….",
 "thig5.12:7.1": "Пятое собрание завершено."
}
