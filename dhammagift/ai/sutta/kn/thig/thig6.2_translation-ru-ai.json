{
 "thig6.2:0.1": "Тхеригатха 6.2",
 "thig6.2:0.2": "Глава шестых",
 "thig6.2:0.3": "Васеттхитхеригатха",
 "thig6.2:1.1": "«Сына-страданием я угнетена,",
 "thig6.2:1.2": "с помутившимся ум-состоянием, без-сознавания;",
 "thig6.2:1.3": "Нагая, с растрёпанными волосами,",
 "thig6.2:1.4": "туда-сюда бродила я.",
 "thig6.2:2.1": "По улицам, по мусорным кучам,",
 "thig6.2:2.2": "по кладбищам и по дорогам;",
 "thig6.2:2.3": "Ходила я три года,",
 "thig6.2:2.4": "голодом и жаждой мучимая.",
 "thig6.2:3.1": "Тогда увидела я Благого,",
 "thig6.2:3.2": "в город Митхилу направляющегося;",
 "thig6.2:3.3": "Необузданных обуздателя,",
 "thig6.2:3.4": "полностью пробуждённого, откуда нет страха.",
 "thig6.2:4.1": "Свой ум обретя,",
 "thig6.2:4.2": "поклонившись, я села;",
 "thig6.2:4.3": "Он мне явление объяснил,",
 "thig6.2:4.4": "из сострадания Готама.",
 "thig6.2:5.1": "Его Дхамму услышав,",
 "thig6.2:5.2": "покинул жизнь в бездомность;",
 "thig6.2:5.3": "Упражняясь в слове Учителя,",
 "thig6.2:5.4": "я реализовала шаг благой.",
 "thig6.2:6.1": "Все страдания отсечены,",
 "thig6.2:6.2": "покинуты, этому конец;",
 "thig6.2:6.3": "Ведь всесторонне поняты мной основания,",
 "thig6.2:6.4": "откуда страданий возникновение».",
 "thig6.2:7.1": "… Васеттхи Тхери …."
}
