{
 "thig3.4:0.1": "Тхеригатха 3.4",
 "thig3.4:0.2": "Тройной раздел",
 "thig3.4:0.3": "Дантикатхеригатха",
 "thig3.4:1.1": "“Из дневного-пребывания выйдя,",
 "thig3.4:1.2": "на Пике Стервятников горе;",
 "thig3.4:1.3": "Слона, погружающегося-выныривающего,",
 "thig3.4:1.4": "на берегу реки увидела.",
 "thig3.4:2.1": "Человек, стрекало взяв,",
 "thig3.4:2.2": "‘дай ногу’ просит;",
 "thig3.4:2.3": "Слон вытянул ногу,",
 "thig3.4:2.4": "человек на слона взобрался.",
 "thig3.4:3.1": "Увидев неприрученного прирученным,",
 "thig3.4:3.2": "людям под контроль ушедшим;",
 "thig3.4:3.3": "Оттого ум-состояние в самадхи установила,",
 "thig3.4:3.4": "вот так в лес ушедшая”.",
 "thig3.4:4.1": "… Дантика тхери …."
}
