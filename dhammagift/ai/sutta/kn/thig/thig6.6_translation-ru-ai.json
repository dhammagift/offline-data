{
 "thig6.6:0.1": "Тхеригатха 6.6",
 "thig6.6:0.2": "Глава шестых",
 "thig6.6:0.3": "Махападжапатиготамитхеригатха",
 "thig6.6:1.1": "“Будда, герой, почтение тебе,",
 "thig6.6:1.2": "всех существ высший;",
 "thig6.6:1.3": "Кто меня от боли освободил,",
 "thig6.6:1.4": "и другого также многих людей.",
 "thig6.6:2.1": "Вся боль всесторонне понята,",
 "thig6.6:2.2": "Причина-цепляние иссушена;",
 "thig6.6:2.3": "Развит восьмеричный путь,",
 "thig6.6:2.4": "Устранение достигнуто мной.",
 "thig6.6:3.1": "Мать, сын, отец, брат,",
 "thig6.6:3.2": "бабушка и раньше были;",
 "thig6.6:3.3": "Как есть не зная,",
 "thig6.6:3.4": "блуждали мы без успокоения.",
 "thig6.6:4.1": "Увиден ведь мной тот Благословенный,",
 "thig6.6:4.2": "последнее это тело-массив;",
 "thig6.6:4.3": "Исчерпан рождение-круговорот,",
 "thig6.6:4.4": "нет отныне нового [индивидуального] существования.",
 "thig6.6:5.1": "С решимостью начатой, с решительным настроем,",
 "thig6.6:5.2": "постоянно с твёрдым старанием;",
 "thig6.6:5.3": "В согласии последователей вижу,",
 "thig6.6:5.4": "Это пробуждённых почитание.",
 "thig6.6:6.1": "Многим, поистине, пользе-благу-цели,",
 "thig6.6:6.2": "Майя родила Готаму;",
 "thig6.6:6.3": "Болезнью-смертью пронзённых,",
 "thig6.6:6.4": "Боли-блок рассеяла”.",
 "thig6.6:7.1": "… Махападжапатиготами тхери …."
}
