{
 "thig3.8:0.1": "Тхеригатха 3.8",
 "thig3.8:0.2": "Тройной раздел",
 "thig3.8:0.3": "Соматхеригатха",
 "thig3.8:1.1": "“То, что провидцами достигается,",
 "thig3.8:1.2": "положение, трудно достижимое;",
 "thig3.8:1.3": "То двумя пальцами-пониманием",
 "thig3.8:1.4": "можно достичь женщиной”.",
 "thig3.8:2.1": "“Женское состояние что сделает,",
 "thig3.8:2.2": "при уме-состоянии хорошо сосредоточенном;",
 "thig3.8:2.3": "При знании текущем,",
 "thig3.8:2.4": "правильно явление проницающему.",
 "thig3.8:3.1": "Везде разрушена радость,",
 "thig3.8:3.2": "Тьмы-глыба расколота;",
 "thig3.8:3.3": "Так знай, Злой,",
 "thig3.8:3.4": "Повержен ты, кончающий».",
 "thig3.8:4.1": "… Сома тхери ….",
 "thig3.8:5.1": "Тройное Собрание завершено."
}
