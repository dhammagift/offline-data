{
 "thig2.9:0.1": "Тхеригатха 2.9",
 "thig2.9:0.2": "Двойное собрание",
 "thig2.9:0.3": "Абхая-тхеригатха",
 "thig2.9:1.1": "«Абхая, разрушительно тело,",
 "thig2.9:1.2": "где прицеплены обыватели;",
 "thig2.9:1.3": "Оставлю я это тело,",
 "thig2.9:1.4": "сознательная, памятующая.",
 "thig2.9:2.1": "Многими болевыми явлениями,",
 "thig2.9:2.2": "не-беспечностью-радостью моей;",
 "thig2.9:2.3": "Цепляния исчерпание достигнуто,",
 "thig2.9:2.4": "исполнено Будды указание”.",
 "thig2.9:3.1": "… Абхая тхери …."
}
