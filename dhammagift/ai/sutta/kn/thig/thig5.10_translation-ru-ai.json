{
 "thig5.10:0.1": "Тхеригатха 5.10",
 "thig5.10:0.2": "Пятое собрание",
 "thig5.10:0.3": "Тхери Патачара",
 "thig5.10:1.1": "«Плугами пашут поле,",
 "thig5.10:1.2": "семена сеют в землю;",
 "thig5.10:1.3": "Детей и жён содержа,",
 "thig5.10:1.4": "богатство находят юноши.",
 "thig5.10:2.1": "Почему же я, нравственностью наделённая,",
 "thig5.10:2.2": "Учителя наставления исполняющая;",
 "thig5.10:2.3": "Ниббаны не достигаю,",
 "thig5.10:2.4": "неленивая, невзволнованная.",
 "thig5.10:3.1": "Ноги омыв,",
 "thig5.10:3.2": "в воде я делаю;",
 "thig5.10:3.3": "И воду от ног увидев,",
 "thig5.10:3.4": "с возвышенности в низину пришедшую.",
 "thig5.10:4.1": "Оттого ум-состояние в самадхи установила,",
 "thig5.10:4.2": "буду хорошей породистой кобылой;",
 "thig5.10:4.3": "Затем светильник взяв,",
 "thig5.10:4.4": "в обитель-вихару вошла я;",
 "thig5.10:4.5": "Постель осмотрев,",
 "thig5.10:4.6": "на кровати села.",
 "thig5.10:5.1": "Затем иглу взяв,",
 "thig5.10:5.2": "фитиль я вытянула;",
 "thig5.10:5.3": "Как у светильника угасание,",
 "thig5.10:5.4": "освобождение было ума-мышления».",
 "thig5.10:6.1": "… Тхери Патачара …."
}
