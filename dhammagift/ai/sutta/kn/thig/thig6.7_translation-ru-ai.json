{
 "thig6.7:0.1": "Тхеригатха 6.7",
 "thig6.7:0.2": "Глава шестых",
 "thig6.7:0.3": "Гуттатхеригатха",
 "thig6.7:1.1": "«Гутта, ради чего уход в бездомность,",
 "thig6.7:1.2": "оставив сына, богатство, дорогое;",
 "thig6.7:1.3": "То же самое развивай,",
 "thig6.7:1.4": "не иди под власть ума-состояния.",
 "thig6.7:2.1": "Умом-состоянием обманутые существа,",
 "thig6.7:2.2": "в области Мары радующиеся;",
 "thig6.7:2.3": "Много-рождений-блуждание,",
 "thig6.7:2.4": "блуждают невежды.",
 "thig6.7:3.1": "Желания-импульс и враждебность,",
 "thig6.7:3.2": "с-телом-(отождествление)-взгляд также;",
 "thig6.7:3.3": "Правилами-обетами-одержимость,",
 "thig6.7:3.4": "и неясность пятая.",
 "thig6.7:4.1": "Связанности эти,",
 "thig6.7:4.2": "отбросив, монахиня;",
 "thig6.7:4.3": "Относящиеся к низшему миру,",
 "thig6.7:4.4": "не придёшь сюда снова.",
 "thig6.7:5.1": "Страсть, самомнение и неведение,",
 "thig6.7:5.2": "и возбужденность избежав;",
 "thig6.7:5.3": "Связанности разрубив,",
 "thig6.7:5.4": "конец боли положишь.",
 "thig6.7:6.1": "Исчерпав рождение-круговорот,",
 "thig6.7:6.2": "полным пониманием нового существования;",
 "thig6.7:6.3": "В видимой действительности безголодная,",
 "thig6.7:6.4": "успокоенной приведёт”.",
 "thig6.7:7.1": "… Гутта Тхери …."
}
