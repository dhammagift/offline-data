{
 "thig6.5:0.1": "Тхеригатха 6.5",
 "thig6.5:0.2": "Глава шестых",
 "thig6.5:0.3": "Тхери Анопамой",
 "thig6.5:1.1": "«В высоком роду я рождена,",
 "thig6.5:1.2": "с большим богатством, с великим имуществом;",
 "thig6.5:1.3": "цветом-образом наделена,",
 "thig6.5:1.4": "дочь мадджхи, родная.",
 "thig6.5:2.1": "Желаема царскими сыновьями,",
 "thig6.5:2.2": "сыновьями старшин вожделена;",
 "thig6.5:2.3": "отцу моему послал гонца:",
 "thig6.5:2.4": "„Дайте мне Анопаму“.",
 "thig6.5:3.1": "„Сколько весит эта,",
 "thig6.5:3.2": "твоя дочь Анопама;",
 "thig6.5:3.3": "того в восемь раз дам,",
 "thig6.5:3.4": "золота и драгоценностей“.",
 "thig6.5:4.1": "Я же, увидев Пробуждённого,",
 "thig6.5:4.2": "в мире старейшего, непревзойдённого;",
 "thig6.5:4.3": "его стопы почтив,",
 "thig6.5:4.4": "С одной стороны сел.",
 "thig6.5:5.1": "Он мне явление объяснил,",
 "thig6.5:5.2": "из сострадания Готама;",
 "thig6.5:5.3": "Сев на том сиденье,",
 "thig6.5:5.4": "коснулась я третьего плода.",
 "thig6.5:6.1": "Затем волосы отрезав,",
 "thig6.5:6.2": "покинул жизнь в бездомность;",
 "thig6.5:6.3": "Сегодня мне седьмая ночь,",
 "thig6.5:6.4": "с тех пор как цепляние иссушено”.",
 "thig6.5:7.1": "… Тхери Анопама …."
}
