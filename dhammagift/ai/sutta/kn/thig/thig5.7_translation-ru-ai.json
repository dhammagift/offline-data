{
 "thig5.7:0.1": "Тхеригатха 5.7",
 "thig5.7:0.2": "Пятое собрание",
 "thig5.7:0.3": "Стхавира Сакула",
 "thig5.7:1.1": "«В доме живя здесь,",
 "thig5.7:1.2": "Дхамму услышав от монаха;",
 "thig5.7:1.3": "Увидела незапыленную Дхамму,",
 "thig5.7:1.4": "ниббану — шаг нетленный.",
 "thig5.7:2.1": "Я же сына и дочь,",
 "thig5.7:2.2": "богатство и зерно отбросив;",
 "thig5.7:2.3": "волосы обрив,",
 "thig5.7:2.4": "покинул [дом] в бездомность.",
 "thig5.7:3.1": "Послушницей-испытуемой будучи,",
 "thig5.7:3.2": "развивая путь прямой;",
 "thig5.7:3.3": "Отбросила страсть и злобу,",
 "thig5.7:3.4": "и вместе с ними истечения.",
 "thig5.7:4.1": "Монахиней став,",
 "thig5.7:4.2": "прежние рождения вспомнила;",
 "thig5.7:4.3": "Божественное зрение очищено,",
 "thig5.7:4.4": "безупречное, хорошо развитое.",
 "thig5.7:5.1": "Составляющие как чужое увидев,",
 "thig5.7:5.2": "из причины рожденные, распадающиеся;",
 "thig5.7:5.3": "Отбросила истечения все,",
 "thig5.7:5.4": "охлаждённой стала я, угасшей”.",
 "thig5.7:6.1": "… Стхавира Сакула …."
}
