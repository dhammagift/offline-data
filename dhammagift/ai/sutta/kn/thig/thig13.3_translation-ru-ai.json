{
 "thig13.3:0.1": "Тхеригатха 13.3",
 "thig13.3:0.2": "Двадцати-глава",
 "thig13.3:0.3": "Чапатхеригатха",
 "thig13.3:1.1": "«С посохом в руке прежде был,",
 "thig13.3:1.2": "теперь же он охотник на дичь;",
 "thig13.3:1.3": "Из-за надежды в ужасную топь,",
 "thig13.3:1.4": "не смог на тот берег переправиться.",
 "thig13.3:2.1": "Сильно опьянённой меня считая,",
 "thig13.3:2.2": "Чапа сына ублажала;",
 "thig13.3:2.3": "Чапы привязь разрубив,",
 "thig13.3:2.4": "уйду я в бездомность снова».",
 "thig13.3:3.1": "«Не гневайся на меня, великий герой,",
 "thig13.3:3.2": "не гневайся на меня, великий мудрец;",
 "thig13.3:3.3": "Ведь у охваченного гневом,",
 "thig13.3:3.4": "чистоты нет, откуда же аскетичность?»",
 "thig13.3:4.1": "«Уйду я из Налаки,",
 "thig13.3:4.2": "кто же в Налаке останется?",
 "thig13.3:4.3": "Связывающие женской формой,",
 "thig13.3:4.4": "шраманов, живущих Дхаммой».",
 "thig13.3:5.1": "«Иди, Кала, вернись,",
 "thig13.3:5.2": "вкушай желания как прежде;",
 "thig13.3:5.3": "И я тобой подчинена,",
 "thig13.3:5.4": "и те, кто мои родственники».",
 "thig13.3:6.1": "«Отсюда, Чапа, на четверть,",
 "thig13.3:6.2": "как ты говоришь мне;",
 "thig13.3:6.3": "К тебе страстного мужчины,",
 "thig13.3:6.4": "великолепным, право, то будет”.",
 "thig13.3:7.1": "“Как калангини такари,",
 "thig13.3:7.2": "цветущая на вершине горы;",
 "thig13.3:7.3": "Как распустившийся стебель граната,",
 "thig13.3:7.4": "внутри острова как патали.",
 "thig13.3:8.1": "С телом, умащённым жёлтым сандалом,",
 "thig13.3:8.2": "в касийской лучшей одежде;",
 "thig13.3:8.3": "Меня, такую красивую,",
 "thig13.3:8.4": "кого, оставив, уходишь?”.",
 "thig13.3:9.1": "“Как птицелов птицу,",
 "thig13.3:9.2": "которую хочет поймать;",
 "thig13.3:9.3": "Привнесённой красотой,",
 "thig13.3:9.4": "меня ты не поработишь”.",
 "thig13.3:10.1": "“И этот мой плод-сын,",
 "thig13.3:10.2": "Кала, рождён тобой;",
 "thig13.3:10.3": "Меня, такую имеющую сына,",
 "thig13.3:10.4": "кого, оставив, уходишь?”.",
 "thig13.3:11.1": "“Оставляют сыновей мудрые,",
 "thig13.3:11.2": "затем родственников, затем богатство;",
 "thig13.3:11.3": "Уходят в бездомность великие герои,",
 "thig13.3:11.4": "как слон, разорвав путы”.",
 "thig13.3:12.1": "“Сейчас я этого твоего сына,",
 "thig13.3:12.2": "палкой или ножом;",
 "thig13.3:12.3": "на земле или сброшу",
 "thig13.3:12.4": "Сын-страдание не уходит”.",
 "thig13.3:13.1": "“Если сына шакалам,",
 "thig13.3:13.2": "собакам отдашь;",
 "thig13.3:13.3": "Не меня сыном-бытием, подлая,",
 "thig13.3:13.4": "снова повернёшь”.",
 "thig13.3:14.1": "“Ну же теперь, достопочтенная,",
 "thig13.3:14.2": "куда, Кали, пойдёшь;",
 "thig13.3:14.3": "В какую деревню-город,",
 "thig13.3:14.4": "город-столицу”.",
 "thig13.3:15.1": "“Были мы прежде наставниками,",
 "thig13.3:15.2": "не-шраманы, шраманами мнящие;",
 "thig13.3:15.3": "Из деревни в деревню ходили,",
 "thig13.3:15.4": "в городе-столице.",
 "thig13.3:16.1": "Вот ведь Благословенный, пробуждённый,",
 "thig13.3:16.2": "к реке Неранджаре;",
 "thig13.3:16.3": "Для полного покидания всякой боли,",
 "thig13.3:16.4": "явление излагает существам;",
 "thig13.3:16.5": "К нему я иду,",
 "thig13.3:16.6": "он мне Учителем будет”.",
 "thig13.3:17.1": "“Поклонение теперь скажи,",
 "thig13.3:17.2": "мира-вождю, непревзойдённому;",
 "thig13.3:17.3": "Почтение-обход совершив,",
 "thig13.3:17.4": "назначь подношение”.",
 "thig13.3:18.1": "“Это ведь возможно нами,",
 "thig13.3:18.2": "как ты говоришь мне;",
 "thig13.3:18.3": "Поклонение теперь тебе скажу,",
 "thig13.3:18.4": "мира-вождю, непревзойдённому;",
 "thig13.3:18.5": "Почтение-обход совершив,",
 "thig13.3:18.6": "назначу подношение”.",
 "thig13.3:19.1": "И оттуда Кала ушёл,",
 "thig13.3:19.2": "к реке Неранджаре;",
 "thig13.3:19.3": "Он увидел Пробуждённого,",
 "thig13.3:19.4": "объясняющего бессмертный шаг.",
 "thig13.3:20.1": "Боль, боле-возникновение,",
 "thig13.3:20.2": "и боли преодоление;",
 "thig13.3:20.3": "Благородный восьмичастный путь,",
 "thig13.3:20.4": "К успокоению боли ведущий.",
 "thig13.3:21.1": "его стопы почтив,",
 "thig13.3:21.2": "Сделав ему обход справа;",
 "thig13.3:21.3": "Чапе наказав,",
 "thig13.3:21.4": "Ушёл в бездомность;",
 "thig13.3:21.5": "Три знания достигнуты,",
 "thig13.3:21.6": "Исполнено Будды указание.",
 "thig13.3:22.1": "… Чапа Тхери …."
}
