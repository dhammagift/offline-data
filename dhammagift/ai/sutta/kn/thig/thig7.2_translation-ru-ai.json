{
 "thig7.2:0.1": "Тхеригатха 7.2",
 "thig7.2:0.2": "Семёрки",
 "thig7.2:0.3": "Чалатхеригатха",
 "thig7.2:1.1": "“Памятование установив,",
 "thig7.2:1.2": "монахиня с развитыми способностями;",
 "thig7.2:1.3": "Проникни в шаг покоя,",
 "thig7.2:1.4": "составляющих-успокоение приятное”.",
 "thig7.2:2.1": "“Кого же ради обритая ты,",
 "thig7.2:2.2": "шраманкой выглядишь;",
 "thig7.2:2.3": "И не радуешься сектам,",
 "thig7.2:2.4": "что это бродишь одурманенная?”.",
 "thig7.2:3.1": "“Внешние секты,",
 "thig7.2:3.2": "взгляды опирающиеся;",
 "thig7.2:3.3": "Не они явление понимают,",
 "thig7.2:3.4": "не они в явлении сведущи.",
 "thig7.2:4.1": "Есть в роду Сакьев рождённый,",
 "thig7.2:4.2": "Будда, несравненный человек;",
 "thig7.2:4.3": "Он мне явление объяснил,",
 "thig7.2:4.4": "взглядов преодоление.",
 "thig7.2:5.1": "Боль, боле-возникновение,",
 "thig7.2:5.2": "И боли преодоление;",
 "thig7.2:5.3": "Благородный Восьмеричный Путь,",
 "thig7.2:5.4": "К успокоению боли ведущий.",
 "thig7.2:6.1": "Того его слово услышав,",
 "thig7.2:6.2": "пребываю в учении радостная;",
 "thig7.2:6.3": "Три знания достигнуты,",
 "thig7.2:6.4": "исполнено Будды указание.",
 "thig7.2:7.1": "Везде разрушена радость,",
 "thig7.2:7.2": "глыба тьмы расколота;",
 "thig7.2:7.3": "Так знай, Злой,",
 "thig7.2:7.4": "повержен ты, кончина”.",
 "thig7.2:8.1": "… Чала тхери …."
}
