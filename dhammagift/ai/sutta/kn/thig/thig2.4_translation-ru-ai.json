{
 "thig2.4:0.1": "Тхеригатха 2.4",
 "thig2.4:0.2": "Двойное собрание",
 "thig2.4:0.3": "Аддхакаситхеригатха",
 "thig2.4:1.1": "“Покуда в Каси-стране,",
 "thig2.4:1.2": "пошлина мне там была;",
 "thig2.4:1.3": "Её установив, город цену,",
 "thig2.4:1.4": "в половину цены поставил меня.",
 "thig2.4:2.1": "Тогда разочаровалась я в образе-материи,",
 "thig2.4:2.2": "разочаровавшись и отстрастилась;",
 "thig2.4:2.3": "Чтобы снова в рождение-круговорот,",
 "thig2.4:2.4": "не носиться снова и снова;",
 "thig2.4:2.5": "Три знания реализованы,",
 "thig2.4:2.6": "исполнено Будды указание”.",
 "thig2.4:3.1": "… Аддхакаси тхери …."
}
