{
 "snp2.8:0.1": "Сутта Нипата 2.8",
 "snp2.8:0.2": "Дхамма (лодка) сутта",
 "snp2.8:1.1": "Ведь когда человек Дхамму познаёт,",
 "snp2.8:1.2": "Как Индру его дэва почитала бы;",
 "snp2.8:1.3": "Он почитаем, в нём ум-состояние ясное,",
 "snp2.8:1.4": "Многослышащий проявляет Дхамму.",
 "snp2.8:2.1": "Это сделав целью, вникнув, знаток,",
 "snp2.8:2.2": "Дхамму-по-Дхамме практикуя;",
 "snp2.8:2.3": "Знающий, различающий, утончённый бывает,",
 "snp2.8:2.4": "Кто такого почитает старательный.",
 "snp2.8:3.1": "И мелкого незрелого обслуживая,",
 "snp2.8:3.2": "И не-будущего-блага и завистливого;",
 "snp2.8:3.3": "Здесь же Дхамму не различив,",
 "snp2.8:3.4": "Не-переплывший-сомнения к умиранию приходит.",
 "snp2.8:4.1": "Как человек, в реку спустившись,",
 "snp2.8:4.2": "В большую воду, поток с быстрым течением;",
 "snp2.8:4.3": "Он уносимый, по течению идущий,",
 "snp2.8:4.4": "Что он других сможет переправить?",
 "snp2.8:5.1": "Так же Дхамму не различив,",
 "snp2.8:5.2": "Многослышащих не услышав смысла;",
 "snp2.8:5.3": "Сам не зная, не-переплывший-сомнения,",
 "snp2.8:5.4": "Что он других сможет убедить?",
 "snp2.8:6.1": "Как если на лодку крепко взойдя,",
 "snp2.8:6.2": "С вёслами и рулём снаряжённый;",
 "snp2.8:6.3": "Он переправит там и многих других,",
 "snp2.8:6.4": "Там-средство-знающий, умелый, понимающий.",
 "snp2.8:7.1": "И так кто сведущий, развивший ум,",
 "snp2.8:7.2": "Многоучёный есть, с непоколебимыми явлениями;",
 "snp2.8:7.3": "Он, конечно, других наставит, зная,",
 "snp2.8:7.4": "Слух-внимание-основание-достигших.",
 "snp2.8:8.1": "Поэтому, действительно, чистого человека следует почитать,",
 "snp2.8:8.2": "Мудрого и многоучёного;",
 "snp2.8:8.3": "Узнав благо, практикуя,",
 "snp2.8:8.4": "Познавший явление, тот приятное обретёт.",
 "snp2.8:8.5": "Сутта Лодка восьмая."
}
