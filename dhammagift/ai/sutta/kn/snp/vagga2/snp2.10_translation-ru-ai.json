{
 "snp2.10:0.1": "Сутта Нипата 2.10",
 "snp2.10:0.2": "Уттханасутта",
 "snp2.10:1.1": "Вставайте, садитесь,",
 "snp2.10:1.2": "какая цель в вашем сне;",
 "snp2.10:1.3": "Ведь у больных какой сон,",
 "snp2.10:1.4": "у стрелой-пронзённых страдающих.",
 "snp2.10:2.1": "Вставайте, садитесь,",
 "snp2.10:2.2": "Крепко учитесь покою;",
 "snp2.10:2.3": "Чтобы вас, беспечных, распознав,",
 "snp2.10:2.4": "Царь смерти не обманул, подвластных.",
 "snp2.10:3.1": "К чему божества и люди,",
 "snp2.10:3.2": "привязанные, стоят, нуждающиеся;",
 "snp2.10:3.3": "Переплывите эту привязанность,",
 "snp2.10:3.4": "момент вас пусть не минует;",
 "snp2.10:3.5": "Момент-превзошедшие ведь страдают,",
 "snp2.10:3.6": "в аду оказавшись.",
 "snp2.10:4.1": "Беспечность — пыль, беспечность — пыль,",
 "snp2.10:4.2": "За беспечностью следующая пыль;",
 "snp2.10:4.3": "Не-беспечностью, знанием",
 "snp2.10:4.4": "Извлеките стрелу из себя.",
 "snp2.10:4.5": "Уттханасутта десятая."
}
