{
 "snp2.9:0.1": "Сутта Нипата 2.9",
 "snp2.9:0.2": "Сутта о нравственности",
 "snp2.9:1.1": "“С какой нравственностью, с каким поведением,",
 "snp2.9:1.2": "какие активности взращивая;",
 "snp2.9:1.3": "Человек, правильно утвердившийся,",
 "snp2.9:1.4": "высшего блага-смысла-цели достигнет”.",
 "snp2.9:2.1": "“Почитающим старших, не-завистливым пусть будет,",
 "snp2.9:2.2": "Знающим время для посещения учителей;",
 "snp2.9:2.3": "Учения-речь произнесённую, знающий момент,",
 "snp2.9:2.4": "Пусть слушает внимательно хорошо-сказанное.",
 "snp2.9:3.1": "Вовремя пусть ходит к учителям,",
 "snp2.9:3.2": "Упрямство устранив, смиренным-в-поведении;",
 "snp2.9:3.3": "Благо-смысл-цель, явление (Дхамму), сдержанность, святую жизнь,",
 "snp2.9:3.4": "Пусть помнит и пусть практикует.",
 "snp2.9:4.1": "Дхамма-радостный, Дхамма-наслаждающийся,",
 "snp2.9:4.2": "В явлении (Дхамме) утвердившись, знающий решение-по-явлению (Дхамме);",
 "snp2.9:4.3": "Пусть не практикует речь-об-изъяне-явления (Дхаммы),",
 "snp2.9:4.4": "Истинными хорошо-сказанными пусть ведётся.",
 "snp2.9:5.1": "Смех, болтовню, плач, вредность-злобу,",
 "snp2.9:5.2": "Сделанное-обманом, притворство, жадность, самомнение;",
 "snp2.9:5.3": "Грубость, резкость, загрязнённость и ослеплённость,",
 "snp2.9:5.4": "Оставив, пусть живёт, без-опьянения, с устойчивым-умом-состоянием.",
 "snp2.9:6.1": "Познавшими-суть хорошо-сказанные,",
 "snp2.9:6.2": "И услышанное, и познанное-суть-самадхи;",
 "snp2.9:6.3": "У того понимание и услышанное не возрастает,",
 "snp2.9:6.4": "Который дерзкий есть человек беспечный.",
 "snp2.9:7.1": "Явлениям же которые благородным-провозглашённым рады,",
 "snp2.9:7.2": "Непревзойдённые те речью, умом-представлением и активностью;",
 "snp2.9:7.3": "Те покой-нравственность-самадхи-установленные,",
 "snp2.9:7.4": "Услышанного пониманием и суть достигли”.",
 "snp2.9:7.5": "Сутта Нравственность девятая."
}
