{
 "snp2.3:0.1": "Сутта Нипата 2.3",
 "snp2.3:0.2": "Сутта о совести",
 "snp2.3:1.1": "Совесть переступающего, гнушающегося,",
 "snp2.3:1.2": "«Твоим я есть» так говорящего;",
 "snp2.3:1.3": "Сносимые активности не принимающего,",
 "snp2.3:1.4": "«Это не мой» — так его следует знать.",
 "snp2.3:2.1": "Несообразную милую речь,",
 "snp2.3:2.2": "кто среди друзей проявляет;",
 "snp2.3:2.3": "Не делающего, говорящего,",
 "snp2.3:2.4": "распознают мудрецы.",
 "snp2.3:3.1": "Не тот друг, кто всегда неослабно,",
 "snp2.3:3.2": "Опасаясь разрыва, лишь изъян высматривает;",
 "snp2.3:3.3": "В ком же покоится, как на груди сын,",
 "snp2.3:3.4": "Тот воистину друг, кто другими неразделим.",
 "snp2.3:4.1": "Радость-создающее основание,",
 "snp2.3:4.2": "похвалу-несущее приятное;",
 "snp2.3:4.3": "Плод-преимущество развивает,",
 "snp2.3:4.4": "несущий человеческое бремя.",
 "snp2.3:5.1": "Вкус уединения испив,",
 "snp2.3:5.2": "Вкус успокоения и;",
 "snp2.3:5.3": "Без-боли становится, без-зла,",
 "snp2.3:5.4": "Вкус-упоение Дхаммы пьют.",
 "snp2.3:5.5": "Сутта о совести третья."
}
