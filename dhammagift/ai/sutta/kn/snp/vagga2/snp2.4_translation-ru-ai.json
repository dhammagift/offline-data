{
 "snp2.4:0.1": "Сутта Нипата 2.4",
 "snp2.4:0.2": "Сутта Благословения",
 "snp2.4:1.1": "Так мной услышано—",
 "snp2.4:1.2": "одно время Благословенный в Саваттхи располагается, в роще Джеты, в парке Анатхапиндики.",
 "snp2.4:1.3": "И тогда некая дэвата предрассветной ночью, превосходного вида, осветив целиком рощу Джеты, подошла к Благословенному; подойдя, поприветствовав Благословенного, встала с одного края.",
 "snp2.4:1.4": "Рядом встав, та дэвата Благословенного стихом обратилась:",
 "snp2.4:2.1": "“Многие дэвы и люди,",
 "snp2.4:2.2": "благоприятные знаки обдумывали;",
 "snp2.4:2.3": "Желая благополучия,",
 "snp2.4:2.4": "скажи благоприятный знак высочайший”.",
 "snp2.4:3.1": "“Не-общение с глупыми,",
 "snp2.4:3.2": "с мудрецами общение;",
 "snp2.4:3.3": "Почитание почитаемых,",
 "snp2.4:3.4": "это — благоприятный знак высочайший.",
 "snp2.4:4.1": "Проживание в подходящей местности,",
 "snp2.4:4.2": "и прежде совершённое благо;",
 "snp2.4:4.3": "И правильное направление себя,",
 "snp2.4:4.4": "это — благоприятный знак высочайший.",
 "snp2.4:5.1": "И многоучёность, и мастерство,",
 "snp2.4:5.2": "и вычищение хорошо обученное;",
 "snp2.4:5.3": "И хорошо сказанная речь,",
 "snp2.4:5.4": "это — благоприятный знак высочайший.",
 "snp2.4:6.1": "Матери-отца обслуживание,",
 "snp2.4:6.2": "собирание жены-детей;",
 "snp2.4:6.3": "И не-запутанные дела,",
 "snp2.4:6.4": "это — благоприятный знак высочайший.",
 "snp2.4:7.1": "Даяние и следование Учению,",
 "snp2.4:7.2": "и собирание родственников;",
 "snp2.4:7.3": "Неупрекаемые активности,",
 "snp2.4:7.4": "это — благоприятный знак высочайший.",
 "snp2.4:8.1": "Отвращение, воздержание от злого,",
 "snp2.4:8.2": "от опьяняющих напитков воздержание;",
 "snp2.4:8.3": "Не-беспечность в явлениях,",
 "snp2.4:8.4": "это — благоприятный знак высочайший.",
 "snp2.4:9.1": "Достойный уважения и смирение,",
 "snp2.4:9.2": "довольство и благодарность;",
 "snp2.4:9.3": "Своевременное слушание Дхаммы,",
 "snp2.4:9.4": "это — благоприятный знак высочайший.",
 "snp2.4:10.1": "Терпение и легко-наставляемость,",
 "snp2.4:10.2": "и шраманов видение;",
 "snp2.4:10.3": "Своевременное обсуждение Дхаммы,",
 "snp2.4:10.4": "это — благоприятный знак высочайший.",
 "snp2.4:11.1": "Аскеза же и святая жизнь,",
 "snp2.4:11.2": "Благородно-истин вИдение;",
 "snp2.4:11.3": "И ниббаны засвидетельствование,",
 "snp2.4:11.4": "Это — благоприятный знак высочайший.",
 "snp2.4:12.1": "Затронутого мирскими-явлениями,",
 "snp2.4:12.2": "Ум-состояние которого не колеблется;",
 "snp2.4:12.3": "Без-страданий, без-пыльное, защищённое,",
 "snp2.4:12.4": "Это — благоприятный знак высочайший.",
 "snp2.4:13.1": "Такое сделав,",
 "snp2.4:13.2": "Везде непобеждённые;",
 "snp2.4:13.3": "Везде к благополучию идут,",
 "snp2.4:13.4": "То для них благословение высочайшее”.",
 "snp2.4:13.5": "Сутта Благоприятного Знака четвёртая."
}
