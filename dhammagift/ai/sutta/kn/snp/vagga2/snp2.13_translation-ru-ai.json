{
 "snp2.13:0.1": "Сутта Нипата 2.13",
 "snp2.13:0.2": "Сутта о правильном странничестве",
 "snp2.13:1.1": "“Спрашиваю мудреца с-обильным-пониманием,",
 "snp2.13:1.2": "Трёх на тот берег перешедшего, полностью угасшего, с устойчивым состоянием;",
 "snp2.13:1.3": "Выйдя из дома, отбросив желания,",
 "snp2.13:1.4": "Как монах правильно в мире странствовать должен?",
 "snp2.13:2.1": "У кого знамения устранены,",
 "snp2.13:2.2": "(так Благословенный)",
 "snp2.13:2.3": "Взлёты, сны и знаки;",
 "snp2.13:2.4": "Тот, от знамений-порока освобождённый,",
 "snp2.13:2.5": "Правильно в мире странствовать должен.",
 "snp2.13:3.1": "Страсть пусть устранит к человеческим,",
 "snp2.13:3.2": "К божественным желаниям также монах;",
 "snp2.13:3.3": "Превзойдя вовлечённость, постигнув явление,",
 "snp2.13:3.4": "Правильно в мире странствовать должен.",
 "snp2.13:4.1": "Повернув спиной к раздорам,",
 "snp2.13:4.2": "Злость, скупость пусть оставит монах;",
 "snp2.13:4.3": "От благосклонности-враждебности освобождённый,",
 "snp2.13:4.4": "Правильно в мире странствовать должен.",
 "snp2.13:5.1": "Оставив приятное и неприятное,",
 "snp2.13:5.2": "Без поддерживания, независимый нигде;",
 "snp2.13:5.3": "От связывающих полностью освобождённый,",
 "snp2.13:5.4": "Правильно в мире странствовать должен.",
 "snp2.13:6.1": "Он в удержаниях сути не находит,",
 "snp2.13:6.2": "В присвоениях устранив импульс-страсть;",
 "snp2.13:6.3": "Он независимый, другим не ведомый,",
 "snp2.13:6.4": "Правильно в мире странствовать должен.",
 "snp2.13:7.1": "Речью, умом и активностью,",
 "snp2.13:7.2": "Невраждебный, правильно поняв явление;",
 "snp2.13:7.3": "К ниббаны-состоянию стремящийся,",
 "snp2.13:7.4": "Правильно в мире странствовать должен.",
 "snp2.13:8.1": "Кто почитает, пусть не превозносится,",
 "snp2.13:8.2": "Даже будучи обруганным, пусть не вступает в ссору монах;",
 "snp2.13:8.3": "Получив чужую еду, пусть не опьяняется,",
 "snp2.13:8.4": "Правильно в мире странствовать должен.",
 "snp2.13:9.1": "Корыстолюбие и бхаву покинув,",
 "snp2.13:9.2": "Воздерживаясь от резания и связывания, монах;",
 "snp2.13:9.3": "Он, переплывший сомнения, без занозы,",
 "snp2.13:9.4": "Правильно в мире странствовать должен.",
 "snp2.13:10.1": "Уместное для себя увидев,",
 "snp2.13:10.2": "Не должен монах вредить никому в мире;",
 "snp2.13:10.3": "Как-оно-есть-действительность увидев явление,",
 "snp2.13:10.4": "Правильно в мире странствовать должен.",
 "snp2.13:11.1": "У которого закладок нет никаких,",
 "snp2.13:11.2": "Корни и неблаготворные вырваны;",
 "snp2.13:11.3": "Он без ожиданий, не надеясь,",
 "snp2.13:11.4": "Правильно в мире странствовать должен.",
 "snp2.13:12.1": "С истечениями-исчерпанный, покинувший самомнение,",
 "snp2.13:12.2": "Весь страсти-путь превзошедший;",
 "snp2.13:12.3": "Дрессированный, полностью-остуженный, устойчивый-умом,",
 "snp2.13:12.4": "Правильно в мире странствовать должен.",
 "snp2.13:13.1": "Верующий, учёный, видящий направление,",
 "snp2.13:13.2": "Среди разделившихся на группы не идущий за группой знаток;",
 "snp2.13:13.3": "Корыстолюбие, вредность-злобу, отторжение устранив,",
 "snp2.13:13.4": "Правильно в мире странствовать должен.",
 "snp2.13:14.1": "Совершенно-чистый победитель, с откинутым покрывалом,",
 "snp2.13:14.2": "В явлениях искусный, превзошедший, непоколебимый;",
 "snp2.13:14.3": "В знании устранения составляющих умелый,",
 "snp2.13:14.4": "Правильно в мире странствовать должен.",
 "snp2.13:15.1": "В прошлых и будущих также,",
 "snp2.13:15.2": "Каппу превзошедший, превзошедший чистотой понимания;",
 "snp2.13:15.3": "От всех областей освобождённый,",
 "snp2.13:15.4": "Правильно в мире странствовать должен.",
 "snp2.13:16.1": "Познав шаг, постигнув явление,",
 "snp2.13:16.2": "Открытое увидев — покидание истечений;",
 "snp2.13:16.3": "Всех удержаний исчерпанием,",
 "snp2.13:16.4": "Правильно в мире странствовать должен”.",
 "snp2.13:17.1": "“Воистину, Благословенный, так это,",
 "snp2.13:17.2": "Который так-пребывающий выдрессированный монах;",
 "snp2.13:17.3": "Всех связываний-связей превзошедший,",
 "snp2.13:17.4": "Правильно в мире странствовать должен”.",
 "snp2.13:17.5": "Сутта о правильном странничестве тринадцатая."
}
