{
 "snp2.6:0.1": "Сутта Нипата 2.6",
 "snp2.6:0.2": "Сутта Капилы (сутта Дхамма-поведения)",
 "snp2.6:1.1": "Дхамма-поведение, святая жизнь,",
 "snp2.6:1.2": "Это называют наилучшим благом;",
 "snp2.6:1.3": "Если даже ушедшим он является,",
 "snp2.6:1.4": "Из дома в бездомность.",
 "snp2.6:2.1": "Если же он грубо-речистого рода,",
 "snp2.6:2.2": "досаждению радующийся зверь;",
 "snp2.6:2.3": "Жизнь его хуже,",
 "snp2.6:2.4": "пыль увеличивает свою.",
 "snp2.6:3.1": "Ссоре радующийся монах,",
 "snp2.6:3.2": "замутнённости-заблуждения явлением покрытый;",
 "snp2.6:3.3": "Даже возвещённое не знает,",
 "snp2.6:3.4": "Явление Пробуждённым преподанное.",
 "snp2.6:4.1": "Досаждение к воспитавшим себя,",
 "snp2.6:4.2": "незнанием предваряемый;",
 "snp2.6:4.3": "Загрязнение не знает,",
 "snp2.6:4.4": "путь в ад ведущий.",
 "snp2.6:5.1": "В падение вступив,",
 "snp2.6:5.2": "из чрева в чрево, из тьмы во тьму;",
 "snp2.6:5.3": "Он — такой монах,",
 "snp2.6:5.4": "после смерти к боли идёт.",
 "snp2.6:6.1": "Как если бы выгребная яма была,",
 "snp2.6:6.2": "наполненная годами;",
 "snp2.6:6.3": "И кто таковым является,",
 "snp2.6:6.4": "Трудноочищаем ведь с-изъяном.",
 "snp2.6:7.1": "Которого такого вида знаете,",
 "snp2.6:7.2": "монахи, на-домохозяйстве-основанного;",
 "snp2.6:7.3": "С-плохим-желанием, с-плохим-намерением,",
 "snp2.6:7.4": "с-плохим-поведением-и-сферой.",
 "snp2.6:8.1": "Все объединившись став,",
 "snp2.6:8.2": "отвергайте его;",
 "snp2.6:8.3": "Мусор выбросьте,",
 "snp2.6:8.4": "сор удалите.",
 "snp2.6:9.1": "Затем мякину унесите,",
 "snp2.6:9.2": "Не-шраманов, шраманами-считающих;",
 "snp2.6:9.3": "Выбросив с-плохими-желаниями,",
 "snp2.6:9.4": "с-плохим-поведением-и-сферой.",
 "snp2.6:10.1": "Чистые с-чистыми сожительство,",
 "snp2.6:10.2": "устраивайте, памятливые;",
 "snp2.6:10.3": "Оттуда согласные, умелые,",
 "snp2.6:10.4": "Боли конец сделаете.",
 "snp2.6:10.5": "Сутта о-поведении-в-Дхамме шестая."
}
