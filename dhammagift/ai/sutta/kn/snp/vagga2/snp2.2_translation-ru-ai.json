{
 "snp2.2:0.1": "Сутта Нипата 2.2",
 "snp2.2:0.2": "Амагандхасутта",
 "snp2.2:1.1": "«Самака-чинука-чинаки и",
 "snp2.2:1.2": "Листья-плоды, корнеплоды, плоды коровьего гороха;",
 "snp2.2:1.3": "По Дхамме добытое чистые люди вкушая,",
 "snp2.2:1.4": "Не желающие желаний ложь не говорят.",
 "snp2.2:2.1": "Кто, вкушая хорошо сделанное, хорошо приготовленное,",
 "snp2.2:2.2": "Другими данное, поднесённое, превосходное;",
 "snp2.2:2.3": "Отборного риса еду потребляя,",
 "snp2.2:2.4": "Тот ест, Кассапа, амагандху.",
 "snp2.2:3.1": "«Амагандха мне не подходит» —",
 "snp2.2:3.2": "Так именно ты говоришь, брахма-родственник;",
 "snp2.2:3.3": "Отборного риса еду потребляя,",
 "snp2.2:3.4": "Птичьим мясом хорошо приготовленным;",
 "snp2.2:3.5": "Спрашиваю я тебя, Кассапа, об этом смысле:",
 "snp2.2:3.6": "Какого рода твоя амагандха?»",
 "snp2.2:4.1": "«Жизни-уменьшение, убийство, разрезание, связывание,",
 "snp2.2:4.2": "Воровство, ложное-утверждение, обман и мошенничество;",
 "snp2.2:4.3": "Изучение, чужих-жён-обслуживание —",
 "snp2.2:4.4": "Это амагандха, а не мясная еда.",
 "snp2.2:5.1": "Которые здесь в желаниях необузданные люди,",
 "snp2.2:5.2": "Во вкусах жадные, нечистого-состояния придерживающиеся;",
 "snp2.2:5.3": "Взгляда-отрицатели, кривые, труднонаправляемые —",
 "snp2.2:5.4": "Это амагандха, а не мясная еда.",
 "snp2.2:6.1": "Кто грубые, жестокие, клеветники,",
 "snp2.2:6.2": "Друзей-предающие, немилосердные, высокомерные;",
 "snp2.2:6.3": "Берущие-принципы и не дают никому,",
 "snp2.2:6.4": "Это амагандха, а не мясная еда.",
 "snp2.2:7.1": "Злость, гордость, упрямство, выставляние-напоказ,",
 "snp2.2:7.2": "Притворство, зависть, речь-раздувание и;",
 "snp2.2:7.3": "Самомнение-превозношение и с нечистыми дружба,",
 "snp2.2:7.4": "Это амагандха, а не мясная еда.",
 "snp2.2:8.1": "Которые плохие-принципы, долг-убийцы-указывающие,",
 "snp2.2:8.2": "Обманщики-в-сделках здесь поддельные;",
 "snp2.2:8.3": "Низкие-люди которые здесь делают злодеяние,",
 "snp2.2:8.4": "Это амагандха, а не мясная еда.",
 "snp2.2:9.1": "Которые здесь к живым несдержанные люди,",
 "snp2.2:9.2": "У других взяв, к досаждению устремлённые;",
 "snp2.2:9.3": "Безнравственные, жестокие, грубые, неуважительные,",
 "snp2.2:9.4": "Это амагандха, а не мясная еда.",
 "snp2.2:10.1": "К ним жадные, враждебные, нападающие,",
 "snp2.2:10.2": "Всегда-устремлённые, после смерти во тьму идут которые;",
 "snp2.2:10.3": "Падают существа в ад вниз-головой,",
 "snp2.2:10.4": "Это амагандха, а не мясная еда.",
 "snp2.2:11.1": "Не рыбы-мяса-не-употреблением,",
 "snp2.2:11.2": "Не наготой, не бритьём, спутанными-волосами-грязью;",
 "snp2.2:11.3": "Грубыми-шкурами, не огненного-жертвоприношения-обслуживанием,",
 "snp2.2:11.4": "Или какие в мире бессмертные многие аскезы;",
 "snp2.2:11.5": "Мантрами-возлияниями, жертвоприношением-по-сезонам-обслуживанием,",
 "snp2.2:11.6": "Очищают смертного, не переплывшего сомнение.",
 "snp2.2:12.1": "В чувствах охраняемый, познанные-способности пусть живёт,",
 "snp2.2:12.2": "В Дхамме утверждённый, в прямоте-мягкости радующийся;",
 "snp2.2:12.3": "Завязки-превозшедший, все-боли-отбросивший,",
 "snp2.2:12.4": "Не прилипает к виденному-слышанному знаток”.",
 "snp2.2:13.1": "Так этот-смысл Благословенный снова-и-снова,",
 "snp2.2:13.2": "Объяснил его, знающий-мантр-предел;",
 "snp2.2:13.3": "Пёстрыми строфами мудрец разъяснил,",
 "snp2.2:13.4": "Без-нечистоты, не-привязанный, трудно-постижимый.",
 "snp2.2:14.1": "Услышав пробуждённого хорошо-сказанное слово,",
 "snp2.2:14.2": "Без-нечистоты, всякой-боли-устраняющее;",
 "snp2.2:14.3": "Смиренным-умом поклонился Татхагате,",
 "snp2.2:14.4": "Тут же уход в монашество одобрил.",
 "snp2.2:14.5": "Амагандхасутта вторая."
}
