{
 "snp2.11:0.1": "Сутта Нипата 2.11",
 "snp2.11:0.2": "Сутта Рахулы",
 "snp2.11:1.1": "“Надеюсь, при частом совместном проживании",
 "snp2.11:1.2": "ты не презираешь мудреца;",
 "snp2.11:1.3": "Несущий факел среди людей,",
 "snp2.11:1.4": "надеюсь, он почитаем тобой”.",
 "snp2.11:2.1": "“Я при частом совместном проживании",
 "snp2.11:2.2": "не презираю мудреца;",
 "snp2.11:2.3": "Несущий факел среди людей,",
 "snp2.11:2.4": "постоянно почитаем мной”.",
 "snp2.11:3.1": "“Пять множителей желаний оставив,",
 "snp2.11:3.2": "милые-формы, умо-восхитительные;",
 "snp2.11:3.3": "С верой из дома выйдя,",
 "snp2.11:3.4": "боли-конец-делающим будь.",
 "snp2.11:4.1": "Друзей общайся благих,",
 "snp2.11:4.2": "уединённое же сидение-лежание;",
 "snp2.11:4.3": "Уединённое, малолюдное,",
 "snp2.11:4.4": "меру-знающим будь в еде.",
 "snp2.11:5.1": "В одеянии и подаянии,",
 "snp2.11:5.2": "в обстоятельствах, сидении-лежании;",
 "snp2.11:5.3": "К ним цепляния не делай,",
 "snp2.11:5.4": "не возвращайся снова в мир.",
 "snp2.11:6.1": "Сдержанный в Патимоккхе,",
 "snp2.11:6.2": "и в пяти способностях;",
 "snp2.11:6.3": "Памятование, к телу относящееся, пусть у тебя будет,",
 "snp2.11:6.4": "в незаинтересованности обильным будь.",
 "snp2.11:7.1": "Знак обходи,",
 "snp2.11:7.2": "красивое, со страстью связанное;",
 "snp2.11:7.3": "В не-ладности ум развивай,",
 "snp2.11:7.4": "однонаправлено, хорошо собрано.",
 "snp2.11:8.1": "И без-знаковость развивай,",
 "snp2.11:8.2": "К-самомнению-предрасположенность отбрось;",
 "snp2.11:8.3": "От того самомнения-постижения,",
 "snp2.11:8.4": "Успокоенным будет странствовать”.",
 "snp2.11:9.1": "Так, как слышано, Благословенный уважаемого Рахулу этими строфами постоянно наставлял.",
 "snp2.11:9.2": "Сутта Рахулы Одиннадцатая."
}
