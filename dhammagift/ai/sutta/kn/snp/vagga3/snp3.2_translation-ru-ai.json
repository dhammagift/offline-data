{
 "snp3.2:0.1": "Сутта Нипата 3.2",
 "snp3.2:0.2": "Сутта Усилий",
 "snp3.2:1.1": "“Меня, решимостью-настроенного,",
 "snp3.2:1.2": "к реке Неранджаре;",
 "snp3.2:1.3": "Усиленно зажжённого,",
 "snp3.2:1.4": "от-связи-защиты для достижения.",
 "snp3.2:2.1": "Намучи сострадательную речь,",
 "snp3.2:2.2": "произнося, подошёл;",
 "snp3.2:2.3": "‘Худ ты и бледен,",
 "snp3.2:2.4": "близка смерть твоя.",
 "snp3.2:3.1": "Тысяча долей смерти,",
 "snp3.2:3.2": "одна часть — твоя жизнь;",
 "snp3.2:3.3": "Живи, господин, жизнь — лучше,",
 "snp3.2:3.4": "живя, заслуги совершишь.",
 "snp3.2:4.1": "И при ведении тобой святой жизни,",
 "snp3.2:4.2": "и при жертвовании огню;",
 "snp3.2:4.3": "Много накапливается заслуги,",
 "snp3.2:4.4": "Что решимостью сделаешь?",
 "snp3.2:5.1": "Труден путь для решимости,",
 "snp3.2:5.2": "трудноосуществим, трудноодолим’”;",
 "snp3.2:5.3": "Эти строфы произнося, Мара,",
 "snp3.2:5.4": "стоял рядом с Пробуждённым.",
 "snp3.2:6.1": "Тому так говорящему Маре,",
 "snp3.2:6.2": "Благословенный это сказал;",
 "snp3.2:6.3": "“Родственник беспечных, злой,",
 "snp3.2:6.4": "с какой целью сюда пришёл.",
 "snp3.2:7.1": "Даже на малую толику блага,",
 "snp3.2:7.2": "Цели у меня не имеется;",
 "snp3.2:7.3": "А у кого цель — через благо,",
 "snp3.2:7.4": "Того Мара достоин обходить.",
 "snp3.2:8.1": "Есть вера, так же усердие,",
 "snp3.2:8.2": "И понимание у меня имеется;",
 "snp3.2:8.3": "Так меня, даже устремлённого,",
 "snp3.2:8.4": "Что, живущего, выспрашиваешь?",
 "snp3.2:9.1": "Даже рек потоки",
 "snp3.2:9.2": "Этот ветер иссушит;",
 "snp3.2:9.3": "Что же у меня, устремлённого,",
 "snp3.2:9.4": "Кровь не иссохнет?",
 "snp3.2:10.1": "Когда кровь иссыхает,",
 "snp3.2:10.2": "Желчь и слизь иссыхают;",
 "snp3.2:10.3": "Когда плоть истощается,",
 "snp3.2:10.4": "Тем более ум-состояние проясняется;",
 "snp3.2:10.5": "Тем более памятование и понимание,",
 "snp3.2:10.6": "Самадхи у меня утверждается.",
 "snp3.2:11.1": "Того меня так пребывающего,",
 "snp3.2:11.2": "Достигшего высочайшего чувствования;",
 "snp3.2:11.3": "В желаниях не оглядывается ум-состояние,",
 "snp3.2:11.4": "Узри существа чистоту.",
 "snp3.2:12.1": "Желания — твоя первая армия,",
 "snp3.2:12.2": "Вторая — не-радование называется;",
 "snp3.2:12.3": "Третья — голод-жажда те,",
 "snp3.2:12.4": "Четвёртая — цепляние называется.",
 "snp3.2:13.1": "Пятая — апатия-сонливость те,",
 "snp3.2:13.2": "Шестая — страх называется;",
 "snp3.2:13.3": "Седьмая — неясность те,",
 "snp3.2:13.4": "Лицемерие, упрямство те — восьмая.",
 "snp3.2:14.1": "Обретение, репутация, почёт,",
 "snp3.2:14.2": "Неверно обретённая и та репутация;",
 "snp3.2:14.3": "Кто себя превозносит,",
 "snp3.2:14.4": "И других презирает.",
 "snp3.2:15.1": "Это, Намучи, твоё войско,",
 "snp3.2:15.2": "Чёрного атакующее;",
 "snp3.2:15.3": "Его негерой не побеждает,",
 "snp3.2:15.4": "Победив же, обретает приятное.",
 "snp3.2:16.1": "Этот тростник я ношу,",
 "snp3.2:16.2": "Проклята моя жизнь;",
 "snp3.2:16.3": "В битве мне смерть лучше,",
 "snp3.2:16.4": "Чем если бы жил побеждённым.",
 "snp3.2:17.1": "Погрузившись сюда, не видны,",
 "snp3.2:17.2": "Некоторые шраманы-брахманы;",
 "snp3.2:17.3": "И тот путь не знают,",
 "snp3.2:17.4": "Куда идут хорошо-обязанные.",
 "snp3.2:18.1": "Со всех сторон знамённое войско увидев,",
 "snp3.2:18.2": "Снаряжённого Мару с ездовым;",
 "snp3.2:18.3": "На битву я выхожу,",
 "snp3.2:18.4": "Пусть меня с позиции не сдвинет.",
 "snp3.2:19.1": "Которое тобой то не одолевается,",
 "snp3.2:19.2": "Войско мир с дэвами;",
 "snp3.2:19.3": "То тобой пониманием разобью,",
 "snp3.2:19.4": "Сырой горшок как камнем.",
 "snp3.2:20.1": "Подчинив намерение,",
 "snp3.2:20.2": "Памятование и хорошо-установленное;",
 "snp3.2:20.3": "Из страны в страну буду странствовать,",
 "snp3.2:20.4": "Последователей вычищая многих.",
 "snp3.2:21.1": "Они прилежные, решительные,",
 "snp3.2:21.2": "Мои наставления-делающие;",
 "snp3.2:21.3": "Нежелающего они отправятся,",
 "snp3.2:21.4": "Куда отправившись не страдают”.",
 "snp3.2:22.1": "“Семь лет Благословенного,",
 "snp3.2:22.2": "Сопровождал шаг-за-шагом;",
 "snp3.2:22.3": "Случая не достигал,",
 "snp3.2:22.4": "Полностью-пробуждённого памятующего.",
 "snp3.2:23.1": "Мясо-цвета как скалу,",
 "snp3.2:23.2": "Ворон обошёл;",
 "snp3.2:23.3": "«Может, здесь мягкое найдём,",
 "snp3.2:23.4": "Или наслаждение было бы.",
 "snp3.2:24.1": "Не получив там наслаждения,",
 "snp3.2:24.2": "Воронёнок ушёл;",
 "snp3.2:24.3": "Как ворона, скалу задев,",
 "snp3.2:24.4": "Разочаровываем Готаму”.",
 "snp3.2:25.1": "Тому, страданием охваченному,",
 "snp3.2:25.2": "Лютня из-под мышки выпала;",
 "snp3.2:25.3": "Оттого тот недовольный яккха,",
 "snp3.2:25.4": "Там же исчез.",
 "snp3.2:25.5": "Падханасутта вторая."
}
