{
 "snp3.1:0.1": "Сутта Нипата 3.1",
 "snp3.1:0.2": "Сутта Ухода",
 "snp3.1:1.1": "«Посвящение восхвалю я,",
 "snp3.1:1.2": "как посвятился зрячий;",
 "snp3.1:1.3": "Как исследуя он,",
 "snp3.1:1.4": "посвящение одобрил.",
 "snp3.1:2.1": "Стеснена эта жизнь домохозяина,",
 "snp3.1:2.2": "пыли область, — так;",
 "snp3.1:2.3": "Открытостью же посвящение,",
 "snp3.1:2.4": "так увидев, посвятился.",
 "snp3.1:3.1": "Посвятившись, телом",
 "snp3.1:3.2": "плохую активность устранил;",
 "snp3.1:3.3": "Речи-дурное-поведение оставив,",
 "snp3.1:3.4": "средства к жизни очистил.",
 "snp3.1:4.1": "Пришёл в Раджагаху Будда,",
 "snp3.1:4.2": "Магадхов горную крепость;",
 "snp3.1:4.3": "За подаянием отправился,",
 "snp3.1:4.4": "исполненный лучших признаков».",
 "snp3.1:5.1": "Его увидел Бимбисара,",
 "snp3.1:5.2": "на дворце стоя;",
 "snp3.1:5.3": "Увидев признаками наделённого,",
 "snp3.1:5.4": "этот смысл произнёс.",
 "snp3.1:6.1": "“Это, почтенные, послушайте,",
 "snp3.1:6.2": "красивый, великий, чистый;",
 "snp3.1:6.3": "Хождением наделённый,",
 "snp3.1:6.4": "на меру ярда смотрит.",
 "snp3.1:7.1": "Опустивший глаза, памятующий,",
 "snp3.1:7.2": "не этот из низкого рода;",
 "snp3.1:7.3": "Царские гонцы пусть бегут,",
 "snp3.1:7.4": "куда монах пойдёт”.",
 "snp3.1:8.1": "Те посланные царские гонцы,",
 "snp3.1:8.2": "за спиной-за спиной следовали;",
 "snp3.1:8.3": "Куда пойдёт монах,",
 "snp3.1:8.4": "где пребывание будет.",
 "snp3.1:9.1": "По порядку ходя,",
 "snp3.1:9.2": "охраняя-входы хорошо сдержанный;",
 "snp3.1:9.3": "Быстро чашу наполнил,",
 "snp3.1:9.4": "сознательный, памятующий.",
 "snp3.1:10.1": "Сбор-подаяния совершив,",
 "snp3.1:10.2": "Выйдя из города мудрец;",
 "snp3.1:10.3": "К Пандаве направился,",
 "snp3.1:10.4": "Здесь пребывание будет.",
 "snp3.1:11.1": "Увидев к-пребыванию-пришедшего,",
 "snp3.1:11.2": "Три гонца подошли;",
 "snp3.1:11.3": "Из них один придя,",
 "snp3.1:11.4": "Царю сообщил.",
 "snp3.1:12.1": "“Этот монах, великий царь,",
 "snp3.1:12.2": "Пандавы перед-восточной-стороной;",
 "snp3.1:12.3": "Сидящий как тигр-бык,",
 "snp3.1:12.4": "Как лев в горной-пещере”.",
 "snp3.1:13.1": "Услышав гонца-речь,",
 "snp3.1:13.2": "На хорошей-колеснице кшатрий;",
 "snp3.1:13.3": "Спешащий-видом вышел,",
 "snp3.1:13.4": "Куда Пандава-гора.",
 "snp3.1:14.1": "Он на колесницу-землю доехав,",
 "snp3.1:14.2": "С колесницы сойдя, кшатрий;",
 "snp3.1:14.3": "Пешком приблизившись,",
 "snp3.1:14.4": "Приблизившись, к нему подсел.",
 "snp3.1:15.1": "Сев, царь поприветствовал,",
 "snp3.1:15.2": "Беседу, что должно-вспомнить, затем;",
 "snp3.1:15.3": "Беседу он завершив,",
 "snp3.1:15.4": "Этот смысл произнёс.",
 "snp3.1:16.1": "“Юн и молод ты,",
 "snp3.1:16.2": "Перворождённый юнец;",
 "snp3.1:16.3": "Цветом-ростом наделённый,",
 "snp3.1:16.4": "Благородный словно кшатрий.",
 "snp3.1:17.1": "Украшая боевой-строй,",
 "snp3.1:17.2": "Слоновьей-толпой окружённый;",
 "snp3.1:17.3": "Даю богатства, наслаждайся,",
 "snp3.1:17.4": "Род скажи, спрошенный”.",
 "snp3.1:18.1": "“Прямая страна, царь,",
 "snp3.1:18.2": "Гимаванта склона;",
 "snp3.1:18.3": "Богатством-энергией наделённая,",
 "snp3.1:18.4": "У Косал живущие.",
 "snp3.1:19.1": "Аддичи по роду,",
 "snp3.1:19.2": "Сакьи по рождению;",
 "snp3.1:19.3": "Из того рода ушедшим я,",
 "snp3.1:19.4": "Не желания стремясь.",
 "snp3.1:20.1": "В желаниях недостаток-опасность увидев,",
 "snp3.1:20.2": "Отречение увидев как безопасное;",
 "snp3.1:20.3": "К усердию пойду я,",
 "snp3.1:20.4": "Здесь у меня радуется ум-представление”.",
 "snp3.1:20.5": "Сутта Ухода завершена первая."
}
