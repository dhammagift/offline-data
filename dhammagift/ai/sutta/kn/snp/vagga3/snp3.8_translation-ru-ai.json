{
 "snp3.8:0.1": "Сутта Нипата 3.8",
 "snp3.8:0.2": "Сутта Стрелы",
 "snp3.8:1.1": "Без-знаковость не-познана,",
 "snp3.8:1.2": "смертных здесь жизнь;",
 "snp3.8:1.3": "Трудна и коротка,",
 "snp3.8:1.4": "и она с болью сопряжена.",
 "snp3.8:2.1": "Ведь нет такого способа,",
 "snp3.8:2.2": "которым родившиеся не умирают;",
 "snp3.8:2.3": "Даже достигнув старости — умирание,",
 "snp3.8:2.4": "такова природа у дышащих.",
 "snp3.8:3.1": "Как у созревших плодов,",
 "snp3.8:3.2": "утром падения тревога;",
 "snp3.8:3.3": "Так у родившихся смертных,",
 "snp3.8:3.4": "постоянно от умирания тревога.",
 "snp3.8:4.1": "Как у гончара,",
 "snp3.8:4.2": "сделанные глиняные сосуды;",
 "snp3.8:4.3": "Все имеют разбитие пределом,",
 "snp3.8:4.4": "так у смертных жизнь.",
 "snp3.8:5.1": "Молодые и великие,",
 "snp3.8:5.2": "которые глупые и которые мудрецы;",
 "snp3.8:5.3": "Все под власть смерти идут,",
 "snp3.8:5.4": "все смерти предназначение.",
 "snp3.8:6.1": "Тех смертью охваченных,",
 "snp3.8:6.2": "идущих в иной мир;",
 "snp3.8:6.3": "Не отец защищает сына,",
 "snp3.8:6.4": "родственники или же родные.",
 "snp3.8:7.1": "На глазах у родственников,",
 "snp3.8:7.2": "смотри, как они причитают по-разному;",
 "snp3.8:7.3": "Один за одним смертные,",
 "snp3.8:7.4": "как скот на убой, уводятся.",
 "snp3.8:8.1": "Так поражён свет-мир,",
 "snp3.8:8.2": "Смертью и старостью;",
 "snp3.8:8.3": "Потому мудрые не страдают,",
 "snp3.8:8.4": "Узнав устройство света-мира.",
 "snp3.8:9.1": "Чей путь ты не знаешь,",
 "snp3.8:9.2": "пришедшего или ушедшего;",
 "snp3.8:9.3": "Оба конца не видя,",
 "snp3.8:9.4": "бесполезно стенаешь.",
 "snp3.8:10.1": "Если бы стенающий,",
 "snp3.8:10.2": "хоть какую-то пользу извлёк;",
 "snp3.8:10.3": "Запутанный, вредящий себе,",
 "snp3.8:10.4": "сделал бы это разумный.",
 "snp3.8:11.1": "Ведь ни плачем, ни страданием,",
 "snp3.8:11.2": "покоя не достигает ум-мышление;",
 "snp3.8:11.3": "Ещё больше возникает боль,",
 "snp3.8:11.4": "и тело повреждается.",
 "snp3.8:12.1": "Худым, бледным становится,",
 "snp3.8:12.2": "вредя собой себе;",
 "snp3.8:12.3": "Тем умерших не защищают,",
 "snp3.8:12.4": "Бесполезен плач.",
 "snp3.8:13.1": "Страдание не оставив, человек,",
 "snp3.8:13.2": "Больше боли идёт;",
 "snp3.8:13.3": "Причитая об ушедшем,",
 "snp3.8:13.4": "Страдания власть-последовавший.",
 "snp3.8:14.1": "Других также узри идущих,",
 "snp3.8:14.2": "Как-по-активности-пришедших людей;",
 "snp3.8:14.3": "Смерти власть придя,",
 "snp3.8:14.4": "Трепещущих здесь существ.",
 "snp3.8:15.1": "Чем чем ведь думают,",
 "snp3.8:15.2": "Оттуда то становится иным;",
 "snp3.8:15.3": "Такое исчезновение,",
 "snp3.8:15.4": "Узри мира чередование.",
 "snp3.8:16.1": "Хоть сто лет живёт,",
 "snp3.8:16.2": "Больше или же юноша;",
 "snp3.8:16.3": "Родни собрания лишён,",
 "snp3.8:16.4": "Оставляет здесь жизнь.",
 "snp3.8:17.1": "Потому араханта услышав,",
 "snp3.8:17.2": "Выведи плач;",
 "snp3.8:17.3": "Умершего ушедшего увидев,",
 "snp3.8:17.4": "Тот не достижим мной так.",
 "snp3.8:18.1": "Как горящий дом,",
 "snp3.8:18.2": "Водой погасил бы;",
 "snp3.8:18.3": "Также знаток с-пониманием,",
 "snp3.8:18.4": "Мудрец умелый человек;",
 "snp3.8:18.5": "Быстро возникшее страдание,",
 "snp3.8:18.6": "Ветер вату словно развеет.",
 "snp3.8:19.1": "Плач и причитание,",
 "snp3.8:19.2": "И недовольство своё;",
 "snp3.8:19.3": "Своего счастья ища,",
 "snp3.8:19.4": "Извлёк стрелу свою.",
 "snp3.8:20.1": "Извлёкший стрелу, не привязанный,",
 "snp3.8:20.2": "Покоя достигнув разумом;",
 "snp3.8:20.3": "Всё страдание превзойдя,",
 "snp3.8:20.4": "Без страдания становится угасшим.",
 "snp3.8:20.5": "Сутта Стрелы восьмая."
}
