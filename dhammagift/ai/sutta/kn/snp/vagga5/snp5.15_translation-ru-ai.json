{
 "snp5.15:0.1": "Сутта Нипата 5.15",
 "snp5.15:0.2": "Вопрос юного Посалы",
 "snp5.15:1.1": "“Кто прошедшее излагает,",
 "snp5.15:1.2": "(так сказал уважаемый Посала)",
 "snp5.15:1.3": "Без-колебания, отсекший сомнение;",
 "snp5.15:1.4": "Достигший-того-берега всех явлений,",
 "snp5.15:1.5": "С вопросом я пришёл.",
 "snp5.15:2.1": "У того, у кого сознавание-образов исчезло,",
 "snp5.15:2.2": "Все-тело отбросившего;",
 "snp5.15:2.3": "Внутренне и внешне,",
 "snp5.15:2.4": "‘Нет ничего’ видящего;",
 "snp5.15:2.5": "Знание, у Сакьев спрашиваю,",
 "snp5.15:2.6": "Как ведом такой?”.",
 "snp5.15:3.1": "“Все распознавания-устойчивости,",
 "snp5.15:3.2": "(Посала, — сказал Благословенный)",
 "snp5.15:3.3": "Прямо зная, Татхагата;",
 "snp5.15:3.4": "Стоящее это знает,",
 "snp5.15:3.5": "Освобождённое, с тем-как-высшим-прибежищем.",
 "snp5.15:4.1": "‘Ничего-не-имения’-возникновение узнав,",
 "snp5.15:4.2": "‘Радость — связывание’ так;",
 "snp5.15:4.3": "Так это опознав,",
 "snp5.15:4.4": "Оттуда в этом прозревает;",
 "snp5.15:4.5": "Это знание истинно у него,",
 "snp5.15:4.6": "У брахмана, достигшего-совершенства”.",
 "snp5.15:4.7": "Вопрос юного Посалы четырнадцатый."
}
