{
 "snp5.10:0.1": "Сутта Нипата 5.10",
 "snp5.10:0.2": "Вопрос ученика Тодейи",
 "snp5.10:1.1": "“В котором желания не обитают,",
 "snp5.10:1.2": "(так сказал уважаемый Тодейя)",
 "snp5.10:1.3": "Цепляние которого не обнаруживается;",
 "snp5.10:1.4": "И сомнения кто пересёк,",
 "snp5.10:1.5": "Освобождение того каково”.",
 "snp5.10:2.1": "“В котором желания не обитают,",
 "snp5.10:2.2": "(Тодейе Благословенный)",
 "snp5.10:2.3": "Цепляние которого не обнаруживается;",
 "snp5.10:2.4": "И сомнения кто пересёк,",
 "snp5.10:2.5": "Освобождение того нет иного”.",
 "snp5.10:3.1": "“Без-надежды он или с надеждой,",
 "snp5.10:3.2": "Знающий он или пониманием-наделяющий;",
 "snp5.10:3.3": "Мудреца я, Сакка, как бы узнал,",
 "snp5.10:3.4": "То мне разъясни, всевидящий”.",
 "snp5.10:4.1": "“Без-надежды он и не с надеждой,",
 "snp5.10:4.2": "Знающий он и не пониманием-наделяющий;",
 "snp5.10:4.3": "Так, Тодейя, мудреца знай,",
 "snp5.10:4.4": "Ничего-не-имеющего, в желание-бхаву не привязанного”.",
 "snp5.10:4.5": "Вопрос ученика Тодейи девятый."
}
