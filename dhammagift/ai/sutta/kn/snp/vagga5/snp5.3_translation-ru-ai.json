{
 "snp5.3:0.1": "Сутта Нипата 5.3",
 "snp5.3:0.2": "Вопрос ученика Тиссаметтейи",
 "snp5.3:1.1": "“Кто в мире доволен,",
 "snp5.3:1.2": "(так сказал уважаемый Тиссаметтейя)",
 "snp5.3:1.3": "У кого нет волнений;",
 "snp5.3:1.4": "Кто, оба края опознав,",
 "snp5.3:1.5": "В середине, размышляя, не пачкается;",
 "snp5.3:1.6": "Кого называешь великим человеком,",
 "snp5.3:1.7": "Кто здесь швею превзошёл”.",
 "snp5.3:2.1": "“В желаниях святую жизнь ведущий,",
 "snp5.3:2.2": "(Меттейя, — Благословенный)",
 "snp5.3:2.3": "Без-цепляния, всегда памятующий;",
 "snp5.3:2.4": "Различив, угасший монах,",
 "snp5.3:2.5": "У того нет волнений.",
 "snp5.3:3.1": "Он, оба края опознав,",
 "snp5.3:3.2": "В середине, размышляя, не пачкается;",
 "snp5.3:3.3": "Того называю великим человеком,",
 "snp5.3:3.4": "Он здесь швею превзошёл”.",
 "snp5.3:3.5": "Вопрос ученика Тиссаметтейи второй."
}
