{
 "snp5.18:0.1": "Сутта Нипата 5.18",
 "snp5.18:0.2": "Параяна-тхутигатха",
 "snp5.18:1.1": "Это сказал Благословенный, в Магадхах располагаясь, у Скального Святилища,",
 "snp5.18:1.2": "шестнадцатью брахманами-вопрошателями спрошенный, вопрос за вопросом разъяснил.",
 "snp5.18:1.3": "Если бы каждый отдельный вопроса смысл поняв, Дхамму поняв, Дхамму-по-Дхамме практиковал, пошёл бы к старения-умирания дальнему берегу.",
 "snp5.18:1.4": "К-дальнему-берегу-ведущие эти явления, поэтому этого изложения-Дхаммы “Параяна” — таково обозначение.",
 "snp5.18:2.1": "Аджита, Тиссаметтейя,",
 "snp5.18:2.2": "Пуннака и также Меттагу;",
 "snp5.18:2.3": "Дхотака, Упасива и,",
 "snp5.18:2.4": "Нанда и также Хемака.",
 "snp5.18:3.1": "Тодейя-Каппа оба,",
 "snp5.18:3.2": "Джатуканни и мудрец;",
 "snp5.18:3.3": "Бхадраваудха, Удая и,",
 "snp5.18:3.4": "Посала и также брахман;",
 "snp5.18:3.5": "Могхараджа и мудрый,",
 "snp5.18:3.6": "Пингия и великий провидец.",
 "snp5.18:4.1": "Эти к Будде подошли,",
 "snp5.18:4.2": "к совершенному в поведении провидцу;",
 "snp5.18:4.3": "Спрашивая тонкие вопросы,",
 "snp5.18:4.4": "к лучшему из Будд подошли.",
 "snp5.18:5.1": "Им Будда разъяснил,",
 "snp5.18:5.2": "на вопросы спрошенный, как-оно-есть;",
 "snp5.18:5.3": "Вопросов разъяснением,",
 "snp5.18:5.4": "порадовал брахманов мудрец.",
 "snp5.18:6.1": "Те успокоены Оком-обладающим,",
 "snp5.18:6.2": "Пробуждённым, солнца-родственником;",
 "snp5.18:6.3": "Святую жизнь прожили,",
 "snp5.18:6.4": "у лучшего-понимания вблизи.",
 "snp5.18:7.1": "Каждого вопроса,",
 "snp5.18:7.2": "как Пробуждённым указано;",
 "snp5.18:7.3": "Так кто бы практиковал,",
 "snp5.18:7.4": "достиг бы иного от не-иного.",
 "snp5.18:8.1": "От не-иного к иному достиг бы,",
 "snp5.18:8.2": "развивая путь высочайший;",
 "snp5.18:8.3": "Путь тот к иному-переходу,",
 "snp5.18:8.4": "потому к-иному-ведущее так."
}
