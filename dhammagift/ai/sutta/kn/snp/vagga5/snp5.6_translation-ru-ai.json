{
 "snp5.6:0.1": "Сутта Нипата 5.6",
 "snp5.6:0.2": "Дхотака-юноши вопросы",
 "snp5.6:1.1": "“Спрашиваю тебя, Благословенный, скажи мне это,",
 "snp5.6:1.2": "(так сказал уважаемый Дхотака)",
 "snp5.6:1.3": "Речи жажду, великий провидец, твоей;",
 "snp5.6:1.4": "Твоё услышав изречение,",
 "snp5.6:1.5": "Тренируюсь в ниббане для себя”.",
 "snp5.6:2.1": "“Тогда-усердие сделай,",
 "snp5.6:2.2": "(Дхотака, — Благословенный)",
 "snp5.6:2.3": "Здесь же рассудительный, памятующий;",
 "snp5.6:2.4": "Отсюда услышав изречение,",
 "snp5.6:2.5": "Тренируюсь в ниббане для себя”.",
 "snp5.6:3.1": "“Вижу я в мире дэвов и людей,",
 "snp5.6:3.2": "Ничего-не-имеющего брахмана странствующим;",
 "snp5.6:3.3": "Того тебя почитаю, всевидящий,",
 "snp5.6:3.4": "Освободи меня, Сакья, от сомнений”.",
 "snp5.6:4.1": "“Не смогу я освобождения,",
 "snp5.6:4.2": "От сомнения, Дхотака, кого-либо в мире;",
 "snp5.6:4.3": "Дхамму же высшую познавая,",
 "snp5.6:4.4": "Так ты это затопление переплывёшь”.",
 "snp5.6:5.1": "“Наставь, Брахма, милосердствуя,",
 "snp5.6:5.2": "Разъединения-Дхамму, которую я бы познал;",
 "snp5.6:5.3": "Как я, подобно пространству, не-враждебный,",
 "snp5.6:5.4": "Здесь же спокойный, независимый, странствовал бы”.",
 "snp5.6:6.1": "“Провозглашу тебе покой,",
 "snp5.6:6.2": "(Дхотака, — Благословенный)",
 "snp5.6:6.3": "В видимой действительности не понаслышке;",
 "snp5.6:6.4": "Которое познав, памятующим пребывая,",
 "snp5.6:6.5": "Пересечь в мире привязанность”.",
 "snp5.6:7.1": "“И это я приветствую,",
 "snp5.6:7.2": "великий-провидец равностное-высшее;",
 "snp5.6:7.3": "Которое познав, памятующим пребывая,",
 "snp5.6:7.4": "пересечь в мире привязанность”.",
 "snp5.6:8.1": "“Что-либо если сознаёшь,",
 "snp5.6:8.2": "(Дхотака, — Благословенный)",
 "snp5.6:8.3": "Вверх вниз и поперёк и посередине;",
 "snp5.6:8.4": "Это увидев 'обмотка' на свете-в мире,",
 "snp5.6:8.5": "Для бхавы-и-не-бхавы не делай цепляния”.",
 "snp5.6:8.6": "Дхотака-юноши вопросы пятая."
}
