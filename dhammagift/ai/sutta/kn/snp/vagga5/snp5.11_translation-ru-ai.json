{
 "snp5.11:0.1": "Сутта Нипата 5.11",
 "snp5.11:0.2": "Вопрос юного Каппы",
 "snp5.11:1.1": "“В середине потока стоящим,",
 "snp5.11:1.2": "(так сказал уважаемый Каппа)",
 "snp5.11:1.3": "В потоке рождённом, великой угрозе;",
 "snp5.11:1.4": "Старением-смертью охваченных,",
 "snp5.11:1.5": "Остров скажи, почтенный;",
 "snp5.11:1.6": "И ты мне остров объясни,",
 "snp5.11:1.7": "Как это вновь не будет”.",
 "snp5.11:2.1": "“В середине потока стоящим,",
 "snp5.11:2.2": "(Каппа, — Благословенный)",
 "snp5.11:2.3": "В потоке рождённом, великой угрозе;",
 "snp5.11:2.4": "Старением-смертью охваченных,",
 "snp5.11:2.5": "Остров скажу, Каппа, тебе.",
 "snp5.11:3.1": "Без-имущего, без-поддерживания,",
 "snp5.11:3.2": "этот остров без-вновь;",
 "snp5.11:3.3": "Ниббаной так его называю,",
 "snp5.11:3.4": "старения-смерти исчерпание.",
 "snp5.11:4.1": "Это поняв, которые памятливы,",
 "snp5.11:4.2": "в видимой действительности достигшие Ниббаны;",
 "snp5.11:4.3": "Не идут те под Марину власть,",
 "snp5.11:4.4": "Не они Мары подвластны”.",
 "snp5.11:4.5": "Вопрос юного Каппы десятый."
}
