{
 "snp5.12:0.1": "Сутта Нипата 5.12",
 "snp5.12:0.2": "Вопрос юноши Джатуканни",
 "snp5.12:1.1": "“Услышав, я к герою, не-желающему-желания,",
 "snp5.12:1.2": "(так сказал уважаемый Джатуканни)",
 "snp5.12:1.3": "Поток-пересекающего спросить, не-желающий, пришёл;",
 "snp5.12:1.4": "Умиротворённую-ступень скажи, о-рождённый-с-глазами,",
 "snp5.12:1.5": "Как-оно-есть, Благословенный, скажи мне это.",
 "snp5.12:2.1": "Благословенный ведь желания одолев движется,",
 "snp5.12:2.2": "Как солнце землю, сияя сиянием;",
 "snp5.12:2.3": "Ограниченного-пониманием мне, о-обильный-пониманием,",
 "snp5.12:2.4": "Провозгласи явление, которое я бы познал;",
 "snp5.12:2.5": "Рождения-старения здесь покидание».",
 "snp5.12:3.1": "“В желаниях выведя алчность,",
 "snp5.12:3.2": "(Джатуканни, — сказал Благословенный)",
 "snp5.12:3.3": "Отречение увидев как безопасное;",
 "snp5.12:3.4": "Схваченное или отброшенное,",
 "snp5.12:3.5": "Пусть у тебя не будет ничего-своего.",
 "snp5.12:4.1": "Что прежде — то осуши,",
 "snp5.12:4.2": "позади у тебя пусть не будет ничего-своего;",
 "snp5.12:4.3": "В середине если не схватишь,",
 "snp5.12:4.4": "успокоенным будешь странствовать.",
 "snp5.12:5.1": "Полностью в имени-материи,",
 "snp5.12:5.2": "У-лишённого-алчности брахмана;",
 "snp5.12:5.3": "Истечения у него не существуют,",
 "snp5.12:5.4": "Которыми под власть смерти он бы пошёл”.",
 "snp5.12:5.5": "Вопрос юноши Джатуканни одиннадцатый."
}
