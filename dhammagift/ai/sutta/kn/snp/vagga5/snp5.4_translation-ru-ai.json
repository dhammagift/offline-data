{
 "snp5.4:0.1": "Сутта Нипата 5.4",
 "snp5.4:0.2": "Вопрос ученика Пуннаки",
 "snp5.4:1.1": "“К не-колеблющемуся, корне-видящему,",
 "snp5.4:1.2": "(так сказал уважаемый Пуннака)",
 "snp5.4:1.3": "С вопросом я пришёл;",
 "snp5.4:1.4": "На что опираясь, провидцы, люди,",
 "snp5.4:1.5": "Кшатрии, брахманы, для божеств;",
 "snp5.4:1.6": "Жертвоприношения совершали многие здесь в мире,",
 "snp5.4:1.7": "Спрашиваю тебя, Благословенный, скажи мне это”.",
 "snp5.4:2.1": "“Какие-либо эти провидцы, люди,",
 "snp5.4:2.2": "(Пуннака, — Благословенный)",
 "snp5.4:2.3": "Кшатрии, брахманы, для божеств;",
 "snp5.4:2.4": "Жертвоприношения совершали многие здесь в мире,",
 "snp5.4:2.5": "Надеясь, Пуннака, на это-состояние;",
 "snp5.4:2.6": "Старость опираясь, жертвоприношения совершали”.",
 "snp5.4:3.1": "“Какие-либо эти провидцы, люди,",
 "snp5.4:3.2": "(так сказал уважаемый Пуннака)",
 "snp5.4:3.3": "Кшатрии, брахманы, для божеств;",
 "snp5.4:3.4": "Жертвоприношения совершали многие здесь в мире,",
 "snp5.4:3.5": "Неужели они, Благословенный, на пути жертвоприношения прилежные;",
 "snp5.4:3.6": "Пересекли рождение и старость, почтенный,",
 "snp5.4:3.7": "Спрашиваю тебя, Благословенный, скажи мне это”.",
 "snp5.4:4.1": "“Надеются, восхваляют, взывают, совершают подношения,",
 "snp5.4:4.2": "(Пуннака, — Благословенный)",
 "snp5.4:4.3": "Желания взывают, исходя из обретения;",
 "snp5.4:4.4": "Те, привязанные к жертвоприношению, бхава-страстью-очарованные,",
 "snp5.4:4.5": "Не пересекли рождение-старость”, — утверждаю”.",
 "snp5.4:5.1": "“Если те не пересекли, привязанные к жертвоприношению,",
 "snp5.4:5.2": "(так сказал уважаемый Пуннака)",
 "snp5.4:5.3": "Жертвоприношениями рождение и старость, почтенный;",
 "snp5.4:5.4": "То кто же тогда в мире дэвов и людей,",
 "snp5.4:5.5": "Пересёк рождение и старость, почтенный;",
 "snp5.4:5.6": "Спрашиваю тебя, Благословенный, скажи мне это”.",
 "snp5.4:6.1": "“Познав в мире высшее и низшее,",
 "snp5.4:6.2": "(Пуннака, — Благословенный)",
 "snp5.4:6.3": "У кого волнения нет нигде на свете;",
 "snp5.4:6.4": "Равностный, бездымный, без тяготы, без ожиданий,",
 "snp5.4:6.5": "Пересёк тот рождение-старость”, — утверждаю”.",
 "snp5.4:6.6": "Вопрос ученика Пуннаки третий."
}
