{
 "snp5.2:0.1": "Сутта Нипата 5.2",
 "snp5.2:0.2": "Вопрос ученика Аджиты",
 "snp5.2:1.1": "“Чем окутан свет,",
 "snp5.2:1.2": "(так уважаемый Аджита)",
 "snp5.2:1.3": "Чем не проясняется;",
 "snp5.2:1.4": "Чем обмазыванием называешь,",
 "snp5.2:1.5": "Что тому великая тревога”.",
 "snp5.2:2.1": "“Неведением окутан свет,",
 "snp5.2:2.2": "(Аджита, — Благословенный),",
 "snp5.2:2.3": "Желанием-беспечностью не проясняется;",
 "snp5.2:2.4": "Бормотанием-обмазыванием называю,",
 "snp5.2:2.5": "Боль тому великая тревога”.",
 "snp5.2:3.1": "“Текут повсюду потоки,",
 "snp5.2:3.2": "(так уважаемый Аджита)",
 "snp5.2:3.3": "Потоков что преграда;",
 "snp5.2:3.4": "Потоков сдерживание скажи,",
 "snp5.2:3.5": "Чем потоки закрываются”.",
 "snp5.2:4.1": "“Какие потоки на свете,",
 "snp5.2:4.2": "(Аджита, — Благословенный),",
 "snp5.2:4.3": "Памятование им преграда;",
 "snp5.2:4.4": "Потоков сдерживание говорю,",
 "snp5.2:4.5": "Пониманием они закрываются”.",
 "snp5.2:5.1": "“Понимание и памятование и имя-образ,",
 "snp5.2:5.2": "(так уважаемый Аджита)",
 "snp5.2:5.3": "И имя-образ, почтенный;",
 "snp5.2:5.4": "Это мне спрошенный скажи,",
 "snp5.2:5.5": "Где это заканчивается”.",
 "snp5.2:6.1": "“Этот вопрос что спросил,",
 "snp5.2:6.2": "Аджита, тебе говорю;",
 "snp5.2:6.3": "Где и имя и материя",
 "snp5.2:6.4": "без остатка заканчиваются;",
 "snp5.2:6.5": "Распознавания устранением,",
 "snp5.2:6.6": "здесь это заканчивается”.",
 "snp5.2:7.1": "“А которые понявшие-явления,",
 "snp5.2:7.2": "и которые ученики многие здесь;",
 "snp5.2:7.3": "У них мне, рассудительный, поведение,",
 "snp5.2:7.4": "спрошенный скажи, почтенный”.",
 "snp5.2:8.1": "“К желаниям не должен привязываться,",
 "snp5.2:8.2": "Умом не-взволнованным пусть будет;",
 "snp5.2:8.3": "Умелый во всех явлениях,",
 "snp5.2:8.4": "памятующий монах пусть странствует”.",
 "snp5.2:8.5": "Вопрос ученика Аджиты первый."
}
