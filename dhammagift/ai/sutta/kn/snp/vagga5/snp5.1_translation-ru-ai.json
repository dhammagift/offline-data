{
 "snp5.1:0.1": "Сутта Нипата 5.1",
 "snp5.1:0.2": "Ваттхугатха",
 "snp5.1:1.1": "Из Косал древняя Рамма,",
 "snp5.1:1.2": "отправился в южный путь;",
 "snp5.1:1.3": "Ничего-не-иметь стремясь,",
 "snp5.1:1.4": "брахман, в мантрах достигший другого берега.",
 "snp5.1:2.1": "Он в стране Ассаков,",
 "snp5.1:2.2": "близ Алаки;",
 "snp5.1:2.3": "Жил на берегу Годхавари,",
 "snp5.1:2.4": "собирательством и плодами.",
 "snp5.1:3.1": "Рядом с ним,",
 "snp5.1:3.2": "и деревня большая была;",
 "snp5.1:3.3": "От того рождённым доходом,",
 "snp5.1:3.4": "великое жертвоприношение совершил.",
 "snp5.1:4.1": "Великое жертвоприношение совершив,",
 "snp5.1:4.2": "снова вошёл в ашрам;",
 "snp5.1:4.3": "Когда он туда вошёл,",
 "snp5.1:4.4": "другой пришёл брахман.",
 "snp5.1:5.1": "С потёртыми ногами, измученный,",
 "snp5.1:5.2": "с грязными зубами, с пыльной головой;",
 "snp5.1:5.3": "И он к нему приблизившись,",
 "snp5.1:5.4": "пять сотен просит.",
 "snp5.1:6.1": "Его Бавари увидев,",
 "snp5.1:6.2": "сиденьем пригласил;",
 "snp5.1:6.3": "Приятное и благотворное спросил,",
 "snp5.1:6.4": "эту речь произнёс.",
 "snp5.1:7.1": "“Что же моё даяние-дхамма,",
 "snp5.1:7.2": "Всё отдано мной;",
 "snp5.1:7.3": "Разреши мне, брахман,",
 "snp5.1:7.4": "Нет пяти сотен у меня”.",
 "snp5.1:8.1": "“Если мне, просящему,",
 "snp5.1:8.2": "досточтимый не даст;",
 "snp5.1:8.3": "На седьмой день твоя,",
 "snp5.1:8.4": "голова расколется на семь частей”.",
 "snp5.1:9.1": "Создав обманщик,",
 "snp5.1:9.2": "ужасное он возвестил;",
 "snp5.1:9.3": "Ту его речь услышав,",
 "snp5.1:9.4": "Бавари больным стал.",
 "snp5.1:10.1": "Высыхает без пищи,",
 "snp5.1:10.2": "Страданья-стрелой пронзённый;",
 "snp5.1:10.3": "И даже так ума-состояния,",
 "snp5.1:10.4": "В джхане не радуется ум-представление.",
 "snp5.1:11.1": "Испуганного, больным увидев,",
 "snp5.1:11.2": "Дэвата, блага желающая;",
 "snp5.1:11.3": "К Бавари приблизившись,",
 "snp5.1:11.4": "Эту речь произнесла.",
 "snp5.1:12.1": "“Не он голову понимает,",
 "snp5.1:12.2": "Обманщик он, богатства желающий;",
 "snp5.1:12.3": "В темени или в темени-падении,",
 "snp5.1:12.4": "Знание того не различается”.",
 "snp5.1:13.1": "“Тогда кто знает,",
 "snp5.1:13.2": "То мне скажи, спрошенная;",
 "snp5.1:13.3": "Темя и темени-сокрушение,",
 "snp5.1:13.4": "То услышим речь твою”.",
 "snp5.1:14.1": "“И я это не знаю,",
 "snp5.1:14.2": "Знание здесь не различается;",
 "snp5.1:14.3": "В темени и темени-сокрушении,",
 "snp5.1:14.4": "У Победителей здесь видение”.",
 "snp5.1:15.1": "“Тогда кто же знает,",
 "snp5.1:15.2": "На этом круге земли;",
 "snp5.1:15.3": "Темя и темени-сокрушение,",
 "snp5.1:15.4": "То мне скажи, дэвата”.",
 "snp5.1:16.1": "“Из Капилаваттху,",
 "snp5.1:16.2": "Вышел Вожатый мира;",
 "snp5.1:16.3": "Отпрыск царя Оккаки,",
 "snp5.1:16.4": "Сын Сакьев, Светоносный.",
 "snp5.1:17.1": "Он ведь, брахман, полностью пробуждённый,",
 "snp5.1:17.2": "Всех явлений превзошедший;",
 "snp5.1:17.3": "Всех высших знаний-сил достигший,",
 "snp5.1:17.4": "Во всех явлениях глазастый;",
 "snp5.1:17.5": "Все-активности-исчерпания достигший,",
 "snp5.1:17.6": "Высвобожденный при исчерпании удержаний.",
 "snp5.1:18.1": "Будда тот Благословенный в мире,",
 "snp5.1:18.2": "Дхамму учит глазастый;",
 "snp5.1:18.3": "Ты, придя, спроси его,",
 "snp5.1:18.4": "Он тебе это разъяснит”.",
 "snp5.1:19.1": "«Пробуждённый» — слово услышав,",
 "snp5.1:19.2": "Взволнован Бавари стал;",
 "snp5.1:19.3": "Страдания тонким стало,",
 "snp5.1:19.4": "И озарённость-упоение великое обрёл.",
 "snp5.1:20.1": "Тот Бавари удовлетворённый, взволнованный,",
 "snp5.1:20.2": "Ту дэву спрашивает, взволнованным став;",
 "snp5.1:20.3": "«В какой деревне или городе,",
 "snp5.1:20.4": "В какой стране владыка мира;",
 "snp5.1:20.5": "Куда пойдя, увидим,",
 "snp5.1:20.6": "Пробуждённого, двуногого лучшего».",
 "snp5.1:21.1": "«В Саваттхи, в Косальском дворце, победитель,",
 "snp5.1:21.2": "Многопонимающий, превосходный, великого понимания;",
 "snp5.1:21.3": "Он — сын Сакьев, независимый, без истечений,",
 "snp5.1:21.4": "Знающий удар по голове, бык среди людей».",
 "snp5.1:22.1": "Тогда обратился к ученикам,",
 "snp5.1:22.2": "Брахманам, в мантрах сведущим;",
 "snp5.1:22.3": "«Давайте, юноши, скажу,",
 "snp5.1:22.4": "Услышьте слово моё.",
 "snp5.1:23.1": "Тот, кто редок в мире,",
 "snp5.1:23.2": "Проявление часто;",
 "snp5.1:23.3": "Он сегодня в мире возник,",
 "snp5.1:23.4": "Пробуждённый — так известный;",
 "snp5.1:23.5": "Быстро пойдя в Саваттхи,",
 "snp5.1:23.6": "Узрите, господа, двуногого наивысшего”.",
 "snp5.1:24.1": "“Как же тогда мы узнаем,",
 "snp5.1:24.2": "Увидев, что он Будда, о брахман;",
 "snp5.1:24.3": "Незнающим нам расскажи,",
 "snp5.1:24.4": "Как узнаем его мы”.",
 "snp5.1:25.1": "“Пришли ведь в гимнах,",
 "snp5.1:25.2": "Великого человека признаки;",
 "snp5.1:25.3": "Тридцать два и разъяснены,",
 "snp5.1:25.4": "Полностью по порядку.",
 "snp5.1:26.1": "У кого эти есть на теле,",
 "snp5.1:26.2": "Великого человека признаки;",
 "snp5.1:26.3": "Только две у него участи,",
 "snp5.1:26.4": "Третьей ведь не существует.",
 "snp5.1:27.1": "Если домом обладает,",
 "snp5.1:27.2": "Покорив землю эту;",
 "snp5.1:27.3": "Без палки, без меча,",
 "snp5.1:27.4": "По Дхамме наставляет.",
 "snp5.1:28.1": "Если же он уходит,",
 "snp5.1:28.2": "Из дома в бездомность;",
 "snp5.1:28.3": "С открытым покровом, полностью пробуждённый,",
 "snp5.1:28.4": "Арахантом становится непревзойдённым.",
 "snp5.1:29.1": "Рождение, род и признаки,",
 "snp5.1:29.2": "Гимны, учеников и прочее;",
 "snp5.1:29.3": "Темя и темени-сокрушение,",
 "snp5.1:29.4": "Умом лишь спросите.",
 "snp5.1:30.1": "Без преград видящий,",
 "snp5.1:30.2": "Если Буддой станет;",
 "snp5.1:30.3": "Умом спрошенные вопросы,",
 "snp5.1:30.4": "Речью изложит”.",
 "snp5.1:31.1": "Бавари слова услышав,",
 "snp5.1:31.2": "Учеников шестнадцать брахманов;",
 "snp5.1:31.3": "Аджита, Тиссаметтейя,",
 "snp5.1:31.4": "Пуннака и также Меттагу.",
 "snp5.1:32.1": "Дхотака, Упасива и,",
 "snp5.1:32.2": "Нанда и также Хемака;",
 "snp5.1:32.3": "Тодейя-Каппа оба,",
 "snp5.1:32.4": "Джатуканни и мудрец.",
 "snp5.1:33.1": "Бхадраваудха, Удая и,",
 "snp5.1:33.2": "Посала и также брахман;",
 "snp5.1:33.3": "Могхараджа и мудрый,",
 "snp5.1:33.4": "Пингия и великий провидец.",
 "snp5.1:34.1": "Каждый со своей группой, все,",
 "snp5.1:34.2": "Всего мира известные;",
 "snp5.1:34.3": "Зажжённые, в джхане радующиеся, мудрые,",
 "snp5.1:34.4": "Прошлыми склонностями склонённые.",
 "snp5.1:35.1": "Бавари почтив,",
 "snp5.1:35.2": "Сделав и ему обход по правую сторону;",
 "snp5.1:35.3": "Спутанные волосы и шкуры носящие все,",
 "snp5.1:35.4": "Отправились на север лицом.",
 "snp5.1:36.1": "Алаки местонахождение,",
 "snp5.1:36.2": "Патиттхану и Махиссати тогда;",
 "snp5.1:36.3": "Уджджаяни и также Гонаддху,",
 "snp5.1:36.4": "Ведису, Ванасавхаю.",
 "snp5.1:37.1": "Косаби и также Сакету,",
 "snp5.1:37.2": "Саваттхи и лучший город;",
 "snp5.1:37.3": "Сетабью, Капилаваттху,",
 "snp5.1:37.4": "Кусинару и Мандиру.",
 "snp5.1:38.1": "Паву и Бхоганагару,",
 "snp5.1:38.2": "Весали, Магадхи град;",
 "snp5.1:38.3": "Пасанаку и Четию,",
 "snp5.1:38.4": "Восхитительное, уму-восхитительное.",
 "snp5.1:39.1": "Как жаждущий прохладной воды,",
 "snp5.1:39.2": "Как купец великой прибыли;",
 "snp5.1:39.3": "Как тени зноем-опаленный,",
 "snp5.1:39.4": "Поспешно на гору взошли.",
 "snp5.1:40.1": "Благословенный в то время,",
 "snp5.1:40.2": "Монахов-собранием окруженный;",
 "snp5.1:40.3": "Монахам Дхамму преподает,",
 "snp5.1:40.4": "Львом рычит в лесу.",
 "snp5.1:41.1": "Аджита увидел Пробужденного,",
 "snp5.1:41.2": "Как солнце-лучезарное, сияющее;",
 "snp5.1:41.3": "Как луну в пятнадцатый день,",
 "snp5.1:41.4": "Полноты достигшую.",
 "snp5.1:42.1": "И у него на теле увидев,",
 "snp5.1:42.2": "Полноту и признаки;",
 "snp5.1:42.3": "С одного края став, радостный,",
 "snp5.1:42.4": "Уму-вопросы спросил.",
 "snp5.1:43.1": "“О рождении скажи,",
 "snp5.1:43.2": "Род скажи с отличительным признаком;",
 "snp5.1:43.3": "В мантрах совершенство скажи,",
 "snp5.1:43.4": "Сколько изучает брахман”.",
 "snp5.1:44.1": "“Двадцать сотен лет срок жизни,",
 "snp5.1:44.2": "И он по роду Бавари;",
 "snp5.1:44.3": "Три у него знака на теле,",
 "snp5.1:44.4": "Трёх Вед превзошедший.",
 "snp5.1:45.1": "В знаках и преданиях,",
 "snp5.1:45.2": "С Нигханду и Кетубхой;",
 "snp5.1:45.3": "Пятьсот учит,",
 "snp5.1:45.4": "В собственной Дхамме совершенства достигший”.",
 "snp5.1:46.1": "“Знаков разбор,",
 "snp5.1:46.2": "Бавари, высший среди людей;",
 "snp5.1:46.3": "Сомнения-отсекатель, изложи,",
 "snp5.1:46.4": "Пусть у нас сомнения не будет”.",
 "snp5.1:47.1": "“Рот языком закрывает,",
 "snp5.1:47.2": "Шерстинка меж бровей;",
 "snp5.1:47.3": "Скрытое в ножнах сокровенное место,",
 "snp5.1:47.4": "Так знай, юноша”.",
 "snp5.1:48.1": "Вопроса ведь какого-то не слыша,",
 "snp5.1:48.2": "Услышав вопросы изложенными;",
 "snp5.1:48.3": "Обдумывает народ весь,",
 "snp5.1:48.4": "Охваченный веданием, со сложенными ладонями.",
 "snp5.1:49.1": "“Кто же дэва или брахма,",
 "snp5.1:49.2": "Или Индра, супруг Суджи;",
 "snp5.1:49.3": "Умом спрошенные вопросы,",
 "snp5.1:49.4": "Кого это озаряет”.",
 "snp5.1:50.1": "“Темя и темени-сокрушение,",
 "snp5.1:50.2": "Бавари вопрошает;",
 "snp5.1:50.3": "То разъясни, Благословенный,",
 "snp5.1:50.4": "Сомнение выведи у нас, провидец”.",
 "snp5.1:51.1": "“Не-знание головой знай,",
 "snp5.1:51.2": "Знание — головы свергатель;",
 "snp5.1:51.3": "Верой-памятованием-самадхи,",
 "snp5.1:51.4": "Импульсом-усилием соединённые”.",
 "snp5.1:52.1": "Тогда от ведения великим,",
 "snp5.1:52.2": "Укрепившись, юноша;",
 "snp5.1:52.3": "На одно плечо шкуру сделав,",
 "snp5.1:52.4": "К ногам головой припал.",
 "snp5.1:53.1": "“Бавари брахман у достопочтенного,",
 "snp5.1:53.2": "Вместе с учениками, почтенный;",
 "snp5.1:53.3": "С возвышенным умом, радостный,",
 "snp5.1:53.4": "Ногам кланяется, зрячий”.",
 "snp5.1:54.1": "“Счастлив Бавари пусть будет,",
 "snp5.1:54.2": "Вместе с учениками, брахман;",
 "snp5.1:54.3": "И ты счастлив будь,",
 "snp5.1:54.4": "Долго живи, юноша.",
 "snp5.1:55.1": "У Бавари и у тебя,",
 "snp5.1:55.2": "У всех все сомнения;",
 "snp5.1:55.3": "Получив возможность, спрашивайте,",
 "snp5.1:55.4": "Что-либо если умом пожелаете”.",
 "snp5.1:56.1": "Совершенно-пробуждённым получив возможность,",
 "snp5.1:56.2": "Сев, сложив ладони;",
 "snp5.1:56.3": "Аджита первый вопрос,",
 "snp5.1:56.4": "Там спросил Татхагату.",
 "snp5.1:56.5": "Вступительные строфы завершены."
}
