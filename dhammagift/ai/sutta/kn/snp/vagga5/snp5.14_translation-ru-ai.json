{
 "snp5.14:0.1": "Сутта Нипата 5.14",
 "snp5.14:0.2": "Вопрос ученика Удаи",
 "snp5.14:1.1": "“Зажжённый, без пыли сидящий,",
 "snp5.14:1.2": "(так сказал уважаемый Удая)",
 "snp5.14:1.3": "Сделавший-дело, без истечений;",
 "snp5.14:1.4": "Достигший-того-берега всех явлений,",
 "snp5.14:1.5": "С вопросом я пришёл;",
 "snp5.14:1.6": "Освобождение-знанием скажи,",
 "snp5.14:1.7": "Неведения-разбивание”.",
 "snp5.14:2.1": "“Покидание желаний-импульсов,",
 "snp5.14:2.2": "(Удая, — сказал Благословенный) —",
 "snp5.14:2.3": "И недовольств, обеих;",
 "snp5.14:2.4": "И вялости устранение,",
 "snp5.14:2.5": "Сожалений-сдерживание.",
 "snp5.14:3.1": "Равностное-видение-памятованием-очищенное,",
 "snp5.14:3.2": "явлений-обдумывание-предваряющее;",
 "snp5.14:3.3": "Знанием-высвобождение говорю,",
 "snp5.14:3.4": "Неведения-разбивание”.",
 "snp5.14:4.1": "“Чем связан свет,",
 "snp5.14:4.2": "что его выслеживание;",
 "snp5.14:4.3": "Чего покиданием,",
 "snp5.14:4.4": "Ниббаной, так говорится”.",
 "snp5.14:5.1": "“Радость-связью свет,",
 "snp5.14:5.2": "рассуждения выслеживание;",
 "snp5.14:5.3": "Цепляния покиданием,",
 "snp5.14:5.4": "Ниббаной, так говорится”.",
 "snp5.14:6.1": "“Как памятующего, движущегося,",
 "snp5.14:6.2": "Внимание заканчивается;",
 "snp5.14:6.3": "Благословенного спросить придя,",
 "snp5.14:6.4": "То услышим речь твою”.",
 "snp5.14:7.1": "“Внутри и снаружи,",
 "snp5.14:7.2": "Чувствование не-восхваляющего;",
 "snp5.14:7.3": "Так памятующего, движущегося,",
 "snp5.14:7.4": "Внимание заканчивается”.",
 "snp5.14:7.5": "Вопрос ученика Удаи тринадцатый."
}
