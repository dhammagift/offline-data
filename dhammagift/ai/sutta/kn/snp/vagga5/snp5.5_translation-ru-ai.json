{
 "snp5.5:0.1": "Сутта Нипата 5.5",
 "snp5.5:0.2": "Вопрос юного Меттагу",
 "snp5.5:1.1": "“Спрашиваю тебя, Благословенный, скажи мне это,",
 "snp5.5:1.2": "(так сказал уважаемый Меттагу)",
 "snp5.5:1.3": "Считаю тебя знающим веды, с развитым умом;",
 "snp5.5:1.4": "Откуда же боли возникли эти,",
 "snp5.5:1.5": "Какие-либо в мире многообразные”.",
 "snp5.5:2.1": "“Боли же меня происхождение спросил ты,",
 "snp5.5:2.2": "(Меттагу, — Благословенный),",
 "snp5.5:2.3": "То тебе объясню как понимаю;",
 "snp5.5:2.4": "Удержание-основанием проявляются боли,",
 "snp5.5:2.5": "Какие-либо в мире многообразные.",
 "snp5.5:3.1": "Кто же неведающий удержание делает,",
 "snp5.5:3.2": "Снова и снова к боли приходит глупец;",
 "snp5.5:3.3": "Потому понимающий удержание пусть не делает,",
 "snp5.5:3.4": "Боли рождение-проявление видящий”.",
 "snp5.5:4.1": "“Что тебя спросили мы — изложил ты нам,",
 "snp5.5:4.2": "Другое тебя спросим мы — ну-ка скажи;",
 "snp5.5:4.3": "Как же мудрые пересекают затопление,",
 "snp5.5:4.4": "Рождение, старение, страдание-стенание;",
 "snp5.5:4.5": "То мне, мудрец, хорошо объясни,",
 "snp5.5:4.6": "Ведь так тебе известен этот закон”.",
 "snp5.5:5.1": "“Провозглашу тебе явление,",
 "snp5.5:5.2": "(Меттагу, — Благословенный),",
 "snp5.5:5.3": "В видимой действительности не понаслышке;",
 "snp5.5:5.4": "Которое познав, памятующим пребывая,",
 "snp5.5:5.5": "Пересечь в мире привязанность”.",
 "snp5.5:6.1": "“И это я приветствую,",
 "snp5.5:6.2": "великий провидец, явление высшее;",
 "snp5.5:6.3": "Которое познав, памятующим пребывая,",
 "snp5.5:6.4": "пересечь в мире привязанность”.",
 "snp5.5:7.1": "“Что-либо если сознаёшь,",
 "snp5.5:7.2": "(Меттагу, — Благословенный),",
 "snp5.5:7.3": "Вверх вниз и поперёк и посередине;",
 "snp5.5:7.4": "В этом радость и обустройство,",
 "snp5.5:7.5": "Отбросив, внимание в бхаве не стоит.",
 "snp5.5:8.1": "Так пребывающий, памятующий, небеспечный,",
 "snp5.5:8.2": "Монах, идущий, оставив 'моё'-принадлежности;",
 "snp5.5:8.3": "Рождение, старение, страдание-стенание,",
 "snp5.5:8.4": "Здесь же знающий отбросил бы боль”.",
 "snp5.5:9.1": "“Этим радуюсь речи великого провидца,",
 "snp5.5:9.2": "Хорошо изложенной, Готамы без-подпитки;",
 "snp5.5:9.3": "Воистину ведь Благословенный отбросил боль,",
 "snp5.5:9.4": "Ведь так тебе ведома эта Дхамма.",
 "snp5.5:10.1": "И те также несомненно отбросили бы боль,",
 "snp5.5:10.2": "Которых ты, мудрец, устойчиво наставлял бы;",
 "snp5.5:10.3": "Тебя тебе кланяюсь, встретив, нага,",
 "snp5.5:10.4": "Может быть меня Благословенный устойчиво наставит”.",
 "snp5.5:11.1": "“Которого брахмана сведущим узнал бы,",
 "snp5.5:11.2": "Ничего-не-имеющего, к желанию-бхаве не-привязанного;",
 "snp5.5:11.3": "Воистину ведь он это затопление переплыл,",
 "snp5.5:11.4": "Переплывший и на тот берег, без суеты, без колебания.",
 "snp5.5:12.1": "Знающий и который сведущий человек здесь,",
 "snp5.5:12.2": "В бхаве-не-бхаве эту привязанность отпустив;",
 "snp5.5:12.3": "Он без цепляния, без тяготы, без ожиданий,",
 "snp5.5:12.4": "Пересёк тот рождение-старость”, — утверждаю”.",
 "snp5.5:12.5": "Вопрос юного Меттагу четвёртый."
}
