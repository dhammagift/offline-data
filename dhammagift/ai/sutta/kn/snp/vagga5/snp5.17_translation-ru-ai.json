{
 "snp5.17:0.1": "Сутта Нипата 5.17",
 "snp5.17:0.2": "Пингия-юноши вопросы",
 "snp5.17:1.1": "«Стар я, немощен, цвета лишён,",
 "snp5.17:1.2": "(так сказал уважаемый Пингия)",
 "snp5.17:1.3": "Глаза не чисты, слух не лёгок;",
 "snp5.17:1.4": "Пусть я не погибну, одурманенный, на пути,",
 "snp5.17:1.5": "Провозгласи явление, которое я бы познал;",
 "snp5.17:1.6": "Рождения-старения здесь покидание».",
 "snp5.17:2.1": "«Видя, как в образах изнуряются,",
 "snp5.17:2.2": "(Пингия, — Благословенный), —",
 "snp5.17:2.3": "Страдают в образах люди беспечные;",
 "snp5.17:2.4": "Потому ты, Пингия, старательный,",
 "snp5.17:2.5": "Оставь образ, без новой вовлечённости».",
 "snp5.17:3.1": "«Четыре стороны, четыре промежуточные стороны,",
 "snp5.17:3.2": "Вверх, вниз — эти десять сторон;",
 "snp5.17:3.3": "Нет для тебя невиданного, неслышанного, неощутимого,",
 "snp5.17:3.4": "А также нераспознанного чего-либо в мире;",
 "snp5.17:3.5": "Укажи явление, которое я бы познал,",
 "snp5.17:3.6": "Рождения-старения здесь покидание».",
 "snp5.17:4.1": "«Видя людей, охваченных цеплянием,",
 "snp5.17:4.2": "(Пингия, — Благословенный), —",
 "snp5.17:4.3": "Рождённых в му́ке, охваченных старением;",
 "snp5.17:4.4": "Потому ты, Пингия, старательный,",
 "snp5.17:4.5": "Оставь цепляние, без новой вовлечённости».",
 "snp5.17:4.6": "Пингия-юноши вопросы шестнадцатые."
}
