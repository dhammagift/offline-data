{
 "snp5.9:0.1": "Сутта Нипата 5.9",
 "snp5.9:0.2": "Вопрос ученика Хемаки",
 "snp5.9:1.1": "“Которые мне прежде объяснили,",
 "snp5.9:1.2": "(так сказал уважаемый Хемака)",
 "snp5.9:1.3": "Вдали от учения Готамы;",
 "snp5.9:1.4": "‘Так было’ и ‘так будет’,",
 "snp5.9:1.5": "Всё это — молва;",
 "snp5.9:1.6": "Всё это — приумножение догадок,",
 "snp5.9:1.7": "Я в том не нахожу услады.",
 "snp5.9:2.1": "Ты же мне явление изложи,",
 "snp5.9:2.2": "цепляния-сокрушитель, мудрец;",
 "snp5.9:2.3": "Которое познав, памятующим пребывая,",
 "snp5.9:2.4": "пересечь в мире привязанность”.",
 "snp5.9:3.1": "“В отношении видимого, слышимого, ощущаемого, распознаваемого,",
 "snp5.9:3.2": "приятных образов, Хемака;",
 "snp5.9:3.3": "импульса-страсти-устранение,",
 "snp5.9:3.4": "ниббаны-состояние-непреходящее.",
 "snp5.9:4.1": "Это поняв, которые памятливы,",
 "snp5.9:4.2": "в видимой действительности достигшие Ниббаны;",
 "snp5.9:4.3": "успокоены они навсегда,",
 "snp5.9:4.4": "переплывшие в мире привязанность”.",
 "snp5.9:4.5": "Вопрос ученика Хемаки восьмой."
}
