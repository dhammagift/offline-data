{
 "snp5.7:0.1": "Сутта Нипата 5.7",
 "snp5.7:0.2": "Вопрос ученика Упасивы",
 "snp5.7:1.1": "“Один я, Сакка, великое затопление,",
 "snp5.7:1.2": "(так сказал уважаемый Упасива)",
 "snp5.7:1.3": "Независимый, не могу переплыть;",
 "snp5.7:1.4": "Основу скажи, Всевидящий,",
 "snp5.7:1.5": "На которую опираясь, это затопление я бы переплыл”.",
 "snp5.7:2.1": "“На ничто-вот-это взирая, памятующий,",
 "snp5.7:2.2": "(Упасива, — сказал Благословенный),",
 "snp5.7:2.3": "‘Нет’ опираясь, переплыви затопление;",
 "snp5.7:2.4": "Желания оставив, воздержанный от разговоров,",
 "snp5.7:2.5": "Цепляния-исчерпание ночью и днём наблюдай”.",
 "snp5.7:3.1": "“У кого ко всем желаниям страсть угасла,",
 "snp5.7:3.2": "(так сказал уважаемый Упасива)",
 "snp5.7:3.3": "На ничто-вот-это опираясь, оставив самомнение;",
 "snp5.7:3.4": "В сознавания-высвобождении высшем высвобождённый,",
 "snp5.7:3.5": "Будет ли стоять он там, не-следуя?”.",
 "snp5.7:4.1": "“У кого ко всем желаниям страсть угасла,",
 "snp5.7:4.2": "(Упасива, — сказал Благословенный),",
 "snp5.7:4.3": "На ничто-вот-это опираясь, оставив самомнение;",
 "snp5.7:4.4": "В сознавания-высвобождении высшем высвобождённый,",
 "snp5.7:4.5": "Будет стоять он там, не-следуя”.",
 "snp5.7:5.1": "“Если будет стоять он там, не-следуя,",
 "snp5.7:5.2": "Даже множество лет, Всевидящий;",
 "snp5.7:5.3": "Там же он станет прохладным, высвобождённый,",
 "snp5.7:5.4": "Исчезнет ли внимание такого?”.",
 "snp5.7:6.1": "“Как пламя, порывом ветра отброшенное,",
 "snp5.7:6.2": "(Упасива, — сказал Благословенный),",
 "snp5.7:6.3": "К концу уходит, не идёт в счёт;",
 "snp5.7:6.4": "Так мудрец, от имя-тела высвобождённый,",
 "snp5.7:6.5": "К концу уходит, не идёт в счёт”.",
 "snp5.7:7.1": "“Зашедший (закатный) он или же его нет,",
 "snp5.7:7.2": "Или же он вечно здоров;",
 "snp5.7:7.3": "То мне, мудрец, хорошо разъясни,",
 "snp5.7:7.4": "Ведь так тебе известен этот закон”.",
 "snp5.7:8.1": "“У зашедшего (закатного) нет меры,",
 "snp5.7:8.2": "(Упасива, — сказал Благословенный),",
 "snp5.7:8.3": "Чем его назвать — того у него нет;",
 "snp5.7:8.4": "Когда все явления устранены,",
 "snp5.7:8.5": "Устранены и все пути речи”.",
 "snp5.7:8.6": "Вопрос ученика Упасивы шестой."
}
