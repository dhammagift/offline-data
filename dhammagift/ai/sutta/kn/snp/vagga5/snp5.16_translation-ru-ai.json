{
 "snp5.16:0.1": "Сутта Нипата 5.16",
 "snp5.16:0.2": "Вопрос ученика Могхараджи",
 "snp5.16:1.1": "“Дважды я Сакку спросил,",
 "snp5.16:1.2": "(так сказал уважаемый Могхараджа)",
 "snp5.16:1.3": "Не объяснил мне Зрящий;",
 "snp5.16:1.4": "И в третий раз, говорят, дэва-подобный",
 "snp5.16:1.5": "Объяснит — так мной услышано.",
 "snp5.16:2.1": "Этот свет — иной свет,",
 "snp5.16:2.2": "мир Брахмы с дэвами;",
 "snp5.16:2.3": "Взгляда твоего не знает,",
 "snp5.16:2.4": "Готамы славного.",
 "snp5.16:3.1": "Так к превосходно-видящему,",
 "snp5.16:3.2": "есть с вопросом приход;",
 "snp5.16:3.3": "Как на свет взирающего,",
 "snp5.16:3.4": "царь смерти не видит”.",
 "snp5.16:4.1": "“Пустотным свет созерцай,",
 "snp5.16:4.2": "Могхараджа, всегда памятующий;",
 "snp5.16:4.3": "Взгляд-на-самость устранив,",
 "snp5.16:4.4": "Так смерти-преодолевшим будешь;",
 "snp5.16:4.5": "Так мир рассматривающего,",
 "snp5.16:4.6": "Царь смерти не видит”.",
 "snp5.16:4.7": "Вопрос ученика Могхараджи пятнадцатый."
}
