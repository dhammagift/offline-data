{
 "snp5.19:0.1": "Сутта Нипата 5.19",
 "snp5.19:0.2": "Параяна-воспевание-гимны",
 "snp5.19:1.1": "“Параяну воспою я,",
 "snp5.19:1.2": "(так сказал уважаемый Пингия)",
 "snp5.19:1.3": "Как увидел, так и изложил;",
 "snp5.19:1.4": "Безупречный, глубокой мудрости,",
 "snp5.19:1.5": "Без-желания, без-вожделения нага;",
 "snp5.19:1.6": "По какой причине ложь скажет.",
 "snp5.19:2.1": "Отбросившего пятно-заблуждение,",
 "snp5.19:2.2": "самомнение-презрение отбросившего;",
 "snp5.19:2.3": "Давай же я восхвалю,",
 "snp5.19:2.4": "речь, с красотой сопряжённую.",
 "snp5.19:3.1": "Тьму-рассеивающий Буддха, всевидящий,",
 "snp5.19:3.2": "До края света дошедший, все существования превзошедший;",
 "snp5.19:3.3": "Без истечений, всю боль отбросивший,",
 "snp5.19:3.4": "Истинно-называемый, брахмой почитаемый мной.",
 "snp5.19:4.1": "Птица как, покинув малый куст,",
 "snp5.19:4.2": "Многоплодный лес посетила бы;",
 "snp5.19:4.3": "Так и я, малое видящих покинув,",
 "snp5.19:4.4": "Великий океан, как лебедь, достиг.",
 "snp5.19:5.1": "Те, что мне прежде разъясняли,",
 "snp5.19:5.2": "Вдали от учения Готамы;",
 "snp5.19:5.3": "‘Так было’ и ‘так будет’,",
 "snp5.19:5.4": "Всё это — молва;",
 "snp5.19:5.5": "Всё то — рассуждений-умножение.",
 "snp5.19:6.1": "Один, тьму-рассеивающий,",
 "snp5.19:6.2": "сияющий, тот светоносный;",
 "snp5.19:6.3": "Готама с обширным пониманием,",
 "snp5.19:6.4": "готама с обширной мудростью.",
 "snp5.19:7.1": "Который мне Дхамму преподал,",
 "snp5.19:7.2": "В-видимой-действительности-постижимое, вневременное;",
 "snp5.19:7.3": "Цепляния-исчерпание-ведущую,",
 "snp5.19:7.4": "У которой нет сравнения нигде”.",
 "snp5.19:8.1": "“Что же от того ты отдаляешься,",
 "snp5.19:8.2": "на мгновение хотя бы, Пингия;",
 "snp5.19:8.3": "От Готамы с обширным пониманием,",
 "snp5.19:8.4": "от Готамы с обширной мудростью.",
 "snp5.19:9.1": "Который тебе Дхамму преподал,",
 "snp5.19:9.2": "В-видимой-действительности-постижимое, вневременное;",
 "snp5.19:9.3": "Цепляния-исчерпание-ведущую,",
 "snp5.19:9.4": "У которой нет сравнения нигде”.",
 "snp5.19:10.1": "“Я от того не отдаляюсь,",
 "snp5.19:10.2": "на мгновение хотя бы, брахман;",
 "snp5.19:10.3": "От Готамы с обширным пониманием,",
 "snp5.19:10.4": "От Готамы с обширной мудростью.",
 "snp5.19:11.1": "Который мне Дхамму преподал,",
 "snp5.19:11.2": "В-видимой-действительности-постижимое, вневременное;",
 "snp5.19:11.3": "Цепляния-исчерпание-ведущую,",
 "snp5.19:11.4": "У которой нет сравнения нигде.",
 "snp5.19:12.1": "Вижу я его умом-представлением как бы глазом,",
 "snp5.19:12.2": "Ночь-день, брахман, будучи осмотрительным;",
 "snp5.19:12.3": "Почтительно кланяясь, провожу ночь,",
 "snp5.19:12.4": "Именно так считаю я не-отдалением.",
 "snp5.19:13.1": "Вера и озарённость, и ум-представление, и памятование,",
 "snp5.19:13.2": "Не отвлекают меня от учения Готамы;",
 "snp5.19:13.3": "В какую бы сторону ни направлялся обладающий обширным пониманием,",
 "snp5.19:13.4": "Туда, именно туда я склонён.",
 "snp5.19:14.1": "У меня, старого, со слабыми силами,",
 "snp5.19:14.2": "Именно поэтому тело не идёт туда;",
 "snp5.19:14.3": "Намерение-создающей говорю постоянно,",
 "snp5.19:14.4": "Ум-представление ведь мне, брахман, тем связано.",
 "snp5.19:15.1": "В грязи лежащий, трепещущий,",
 "snp5.19:15.2": "От острова к острову переплывал;",
 "snp5.19:15.3": "Тогда увидел я Пробуждённого,",
 "snp5.19:15.4": "Затопление переплывшего, без-истечений”.",
 "snp5.19:16.1": "“Как был Ваккали освобождённый-верой,",
 "snp5.19:16.2": "Бхадравадха, Алави-Готама также;",
 "snp5.19:16.3": "Точно так и ты отпусти веру,",
 "snp5.19:16.4": "Достигнешь ты, Пингия, смерти-царства берега”.",
 "snp5.19:17.1": "“Этот ещё больше успокаиваюсь,",
 "snp5.19:17.2": "Услышав мудреца речь;",
 "snp5.19:17.3": "С открытым покровом, полностью пробуждённый,",
 "snp5.19:17.4": "Без-суеты, красноречивый.",
 "snp5.19:18.1": "Над-дэвами для опознания,",
 "snp5.19:18.2": "Всё знает высшее-и-низшее;",
 "snp5.19:18.3": "Вопросов-конец-делающий Учитель,",
 "snp5.19:18.4": "Сомневающихся признающих.",
 "snp5.19:19.1": "Неколебимое, непоколебимое,",
 "snp5.19:19.2": "У которой нет сравнения нигде;",
 "snp5.19:19.3": "Несомненно достигну, нет здесь сомнения,",
 "snp5.19:19.4": "Так меня применяй с решительным-умом”.",
 "snp5.19:19.5": "Глава Параяна Пятая.",
 "snp5.19:19.6": "Сутта-перечень",
 "snp5.19:20.1": "Урага, Дхания также,",
 "snp5.19:20.2": "Носорога и земледелие;",
 "snp5.19:20.3": "Чунда вовлеченность снова же,",
 "snp5.19:20.4": "Изгой и что-должно-быть-сделано;",
 "snp5.19:20.5": "Хемавата и яккха,",
 "snp5.19:20.6": "Виджая-сутта мудреца-сутта-лучшая.",
 "snp5.19:21.1": "Первая-древесная-лучшая лучшая-глава,",
 "snp5.19:21.2": "Двенадцать-сутт-содержащая хорошо-разделенная;",
 "snp5.19:21.3": "Преподана зрячим незапятнанным,",
 "snp5.19:21.4": "Слышится глава-лучшая змеёй.",
 "snp5.19:22.1": "Драгоценность-нечистота-хири-мангала-именуемый,",
 "snp5.19:22.2": "Сутилома-капила и брахманская-Дхамма;",
 "snp5.19:22.3": "Судно-кто-нравственность-встающий-и,",
 "snp5.19:22.4": "Рахула и снова же Вангиса.",
 "snp5.19:23.1": "Правильно-страннический-также здесь,",
 "snp5.19:23.2": "Дхаммика-сутта-лучшая хорошо-разделенная;",
 "snp5.19:23.3": "Четырнадцать-сутт-содержащая во-втором,",
 "snp5.19:23.4": "Чулака-глава-лучшая так её-называют.",
 "snp5.19:24.1": "Уход-усилие-хорошо-сказанное-именуемый,",
 "snp5.19:24.2": "Пураласа снова же Магха и;",
 "snp5.19:24.3": "Сабхия Кения именно стрела-именуемый,",
 "snp5.19:24.4": "Васеттха-лучший Калика-также и.",
 "snp5.19:25.1": "Налака-сутта-лучшая хорошо-разделенная,",
 "snp5.19:25.2": "То созерцающий так снова же;",
 "snp5.19:25.3": "Двенадцать-сутт-содержащая в-третьем,",
 "snp5.19:25.4": "Слышен раздел-лучший великоимённый.",
 "snp5.19:26.1": "Желание-пещера-восьмая-дурная-имена,",
 "snp5.19:26.2": "Чистый-лучший высший-восьмой-имя;",
 "snp5.19:26.3": "Старение Меттия-лучший хорошо-разделённый,",
 "snp5.19:26.4": "Пасура Магандия до-распада.",
 "snp5.19:27.1": "Ссора-спор оба построения и,",
 "snp5.19:27.2": "Туватака-сам-наказание-Сарипутты;",
 "snp5.19:27.3": "Шестнадцать-сутт-держащий в четвёртом,",
 "snp5.19:27.4": "Восьми-раздел-лучший его называют.",
 "snp5.19:28.1": "В Магадхе стране приятной,",
 "snp5.19:28.2": "В месте-лучшем благо-сделанном-обиталище;",
 "snp5.19:28.3": "На скале-Четия-лучшей хорошо-разделённой,",
 "snp5.19:28.4": "Жил Благословенный, группы-лучший.",
 "snp5.19:29.1": "Оба-пребывания в Агатии,",
 "snp5.19:29.2": "Двенадцать-йоджан собрания;",
 "snp5.19:29.3": "Шестнадцать брахманов, говорят, спрошенный,",
 "snp5.19:29.4": "Вопросов шестнадцать-вопросов-деятельности;",
 "snp5.19:29.5": "Разъяснил явление дал.",
 "snp5.19:30.1": "Смысл-проясняющее-выражение-полное,",
 "snp5.19:30.2": "Явление проповедовал другим-безопасность-рождающее;",
 "snp5.19:30.3": "Для-мира-блага победитель двуногих-лучший,",
 "snp5.19:30.4": "Сутту-лучшую много-явлений-разнообразную;",
 "snp5.19:30.5": "Всех-загрязнений-освобождения-причину,",
 "snp5.19:30.6": "Проповедовал сутту-лучшую двуногих-лучший.",
 "snp5.19:31.1": "Формулировок-смысла-слов соединённое,",
 "snp5.19:31.2": "Букв-сознаванием-сравнения-насыщенное;",
 "snp5.19:31.3": "Мир-исследование-знание-разрушающее,",
 "snp5.19:31.4": "Проповедовал сутту-лучшую двуногих-лучший.",
 "snp5.19:32.1": "Страсти-пятно без-пятна, без-пятна-ведущее,",
 "snp5.19:32.2": "Вредности-пятно без-пятна, без-пятна-ведущее;",
 "snp5.19:32.3": "Замутненности-пятно без-пятна, без-пятна-ведущее,",
 "snp5.19:32.4": "Мир-исследование-знание-разрушающее;",
 "snp5.19:32.5": "Проповедовал сутту-лучшую двуногих-лучший.",
 "snp5.19:33.1": "Загрязнения-пятно без-пятна, без-пятна-ведущее,",
 "snp5.19:33.2": "Недоброй-активности-пятно без-пятна, без-пятна-ведущее;",
 "snp5.19:33.3": "Мир-исследование-знание-разрушающее,",
 "snp5.19:33.4": "Проповедовал сутту-лучшую двуногих-лучший.",
 "snp5.19:34.1": "Истечения-связывание-ярмо-загрязнение,",
 "snp5.19:34.2": "Покровы и три пятна;",
 "snp5.19:34.3": "Того загрязнения-освобождения причина,",
 "snp5.19:34.4": "Проповедовал сутту-лучшую двуногих-лучший.",
 "snp5.19:35.1": "Без-пятна-все-загрязнения-устраняющее,",
 "snp5.19:35.2": "Страсти-бесстрастие-неподвижное-без-страдания;",
 "snp5.19:35.3": "Умиротворённое-возвышенное-трудно-видимое-явление,",
 "snp5.19:35.4": "Проповедовал сутту-лучшую двуногих-лучший.",
 "snp5.19:36.1": "Страсть и вредность-активность-сломавшее-умиротворённое,",
 "snp5.19:36.2": "Лоно-четыре-участи-пять-распознаваний;",
 "snp5.19:36.3": "Цепляние-радость-покров-защита-лиана-освобождение,",
 "snp5.19:36.4": "Проповедовал сутту-лучшую двуногих-лучший.",
 "snp5.19:37.1": "Глубокое-трудно-видимое-тонкое-искусное,",
 "snp5.19:37.2": "Мудрецом-познаваемое-чувствование-искусное-благо;",
 "snp5.19:37.3": "Мир-исследование-знание-разрушающее,",
 "snp5.19:37.4": "Проповедовал сутту-лучшую двуногих-лучший.",
 "snp5.19:38.1": "Девяти-аспектов-цветок-гирлянда-песнь,",
 "snp5.19:38.2": "Способностей-джхан-освобождений-разделённое;",
 "snp5.19:38.3": "Восьми-аспектов-путь-несущая-превосходная-колесница,",
 "snp5.19:38.4": "Проповедовал сутту-лучшую двуногих-лучший.",
 "snp5.19:39.1": "Луне-подобное-без-пятна-всесторонне-очищенное,",
 "snp5.19:39.2": "Океан-подобного, драгоценно-чистого-ума;",
 "snp5.19:39.3": "Цветку-подобного, солнце-подобного-блеска,",
 "snp5.19:39.4": "Проповедовал сутту-лучшую двуногих-лучший.",
 "snp5.19:40.1": "Безопасно-благого, приятно-прохладно-спокойного,",
 "snp5.19:40.2": "Смерти-защиты-высшего, высшего-блага;",
 "snp5.19:40.3": "Того полностью-успокоенного-видения-ради,",
 "snp5.19:40.4": "Проповедовал сутту-лучшую двуногих-лучший.",
 "snp5.19:40.5": "Суттанипата-пали завершена."
}
