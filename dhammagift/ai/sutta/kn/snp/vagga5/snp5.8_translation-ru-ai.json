{
 "snp5.8:0.1": "Сутта Нипата 5.8",
 "snp5.8:0.2": "Вопрос Нанды",
 "snp5.8:1.1": "«Есть в мире мудрецы,",
 "snp5.8:1.2": "(так сказал уважаемый Нанда)",
 "snp5.8:1.3": "Люди говорят — это как же?",
 "snp5.8:1.4": "Знанием-наделённым мудрецом называют,",
 "snp5.8:1.5": "Или же жизнью-наделённым?».",
 "snp5.8:2.1": "«Не взглядом, не слышанием, не знанием, (…)",
 "snp5.8:2.2": "Мудреца здесь, Нанда, благотворные называют;",
 "snp5.8:2.3": "Без-оружия-сделав, без-тяготы, без-желания,",
 "snp5.8:2.4": "Идут которые — те мудрецы, говорю я».",
 "snp5.8:3.1": "«Какие-либо эти шраманы-брахманы,",
 "snp5.8:3.2": "(так сказал уважаемый Нанда)",
 "snp5.8:3.3": "Виденным-слышанным также называют чистоту;",
 "snp5.8:3.4": "Принципами-обетами также называют чистоту,",
 "snp5.8:3.5": "Многообразно называют чистоту.",
 "snp5.8:3.6": "Неужели те, Благословенный, там сдержанно идя,",
 "snp5.8:3.7": "Переплыли рождение и старость, почтенный;",
 "snp5.8:3.8": "Спрашиваю тебя, Благословенный, скажи мне это”.",
 "snp5.8:4.1": "«Какие-либо эти шраманы-брахманы,",
 "snp5.8:4.2": "(Нанда, — Благословенный)",
 "snp5.8:4.3": "Виденным-слышанным также называют чистоту;",
 "snp5.8:4.4": "Принципами-обетами также называют чистоту,",
 "snp5.8:4.5": "Многообразно называют чистоту;",
 "snp5.8:4.6": "Хотя те там сдержанно идут,",
 "snp5.8:4.7": "Не пересекли рождение-старость”, — утверждаю”.",
 "snp5.8:5.1": "«Какие-либо эти шраманы-брахманы,",
 "snp5.8:5.2": "(так сказал уважаемый Нанда)",
 "snp5.8:5.3": "Виденным-слышанным также называют чистоту;",
 "snp5.8:5.4": "Принципами-обетами также называют чистоту,",
 "snp5.8:5.5": "Многообразно называют чистоту.",
 "snp5.8:5.6": "Тех если, мудрец, говоришь не-затопление-переплывшими,",
 "snp5.8:5.7": "То кто же тогда в мире дэвов-людей",
 "snp5.8:5.8": "Переплыл рождение и старость, почтенный,",
 "snp5.8:5.9": "Спрашиваю тебя, Благословенный, скажи мне это”.",
 "snp5.8:6.1": "«Не всех шраманов-брахманов,",
 "snp5.8:6.2": "(Нанда, — Благословенный)",
 "snp5.8:6.3": "Рожденьем-старостью покрыты — утверждаю;",
 "snp5.8:6.4": "Кто тонет в увиденном, услышанном, почувствованном,",
 "snp5.8:6.5": "И в принципах-обетах — всё отбросив.",
 "snp5.8:6.6": "Даже многообразное отбросив всё,",
 "snp5.8:6.7": "Цепляние полным пониманием — без истечений;",
 "snp5.8:6.8": "Вот те люди затопление переплывшие — утверждаю”.",
 "snp5.8:7.1": "“Этим радуюсь речи великого провидца,",
 "snp5.8:7.2": "Хорошо изложенной, Готамы без-подпитки;",
 "snp5.8:7.3": "Кто тонет в увиденном, услышанном, почувствованном,",
 "snp5.8:7.4": "И в принципах-обетах — всё отбросив.",
 "snp5.8:7.5": "Даже многообразное отбросив всё,",
 "snp5.8:7.6": "Цепляние полным пониманием — без истечений;",
 "snp5.8:7.7": "И я тебя затопление переплывшим — утверждаю”.",
 "snp5.8:7.8": "Вопрос Нанды седьмой."
}
