{
 "snp1.3:0.1": "Сутта Нипата 1.3",
 "snp1.3:0.2": "Сутта о носороге",
 "snp1.3:1.1": "“Ко всем существам отложив палку,",
 "snp1.3:1.2": "Не причиняя вреда ни одному из них;",
 "snp1.3:1.3": "Сына не желал бы, откуда товарища,",
 "snp1.3:1.4": "Один пусть странствует как носорог”.",
 "snp1.3:2.1": "“У того, кто в общении рождён, возникают привязанности,",
 "snp1.3:2.2": "Вслед за привязанностью эта боль возникает;",
 "snp1.3:2.3": "Опасность, из привязанности рождённую, видя,",
 "snp1.3:2.4": "Один пусть странствует как носорог”.",
 "snp1.3:3.1": "“Друзей и близких жалея,",
 "snp1.3:3.2": "Теряет благо, с умом, привязанным;",
 "snp1.3:3.3": "Эту тревогу в общении видя,",
 "snp1.3:3.4": "Один пусть странствует как носорог”.",
 "snp1.3:4.1": "“Как бамбук, разросшийся, запутанный,",
 "snp1.3:4.2": "В сыновьях и жёнах какая привязанность;",
 "snp1.3:4.3": "Как побег бамбука, не цепляясь,",
 "snp1.3:4.4": "Один пусть странствует как носорог”.",
 "snp1.3:5.1": "“Как олень в лесу, не связанный,",
 "snp1.3:5.2": "Куда хочет идёт за кормом;",
 "snp1.3:5.3": "Мудрый человек свободу видя,",
 "snp1.3:5.4": "Один пусть странствует как носорог”.",
 "snp1.3:6.1": "“Обращение бывает среди товарищей,",
 "snp1.3:6.2": "В проживании, стоянии, хождении и странствии;",
 "snp1.3:6.3": "Нежеланную свободу видя,",
 "snp1.3:6.4": "Один пусть странствует как носорог”.",
 "snp1.3:7.1": "“Игра, наслаждение бывает среди товарищей,",
 "snp1.3:7.2": "К сыновьям же большая бывает любовь;",
 "snp1.3:7.3": "Разлуку с любимым отвращаясь,",
 "snp1.3:7.4": "Один пусть странствует как носорог”.",
 "snp1.3:8.1": "“Четырёх-сторонний без-отторжения и является,",
 "snp1.3:8.2": "Довольствующийся тем и другим;",
 "snp1.3:8.3": "Опасностей терпящий, бесстрашный,",
 "snp1.3:8.4": "Один пусть странствует как носорог”.",
 "snp1.3:9.1": "“Трудно-общительны отшельники также некоторые,",
 "snp1.3:9.2": "А также домохозяева, дом проживающие;",
 "snp1.3:9.3": "Беспечальный к чужим детям став,",
 "snp1.3:9.4": "Один пусть странствует как носорог”.",
 "snp1.3:10.1": "“Сняв домохозяина признаки,",
 "snp1.3:10.2": "С-отрезанным-листом как ковилара;",
 "snp1.3:10.3": "Отрезав, герой, домохозяина путы,",
 "snp1.3:10.4": "Один пусть странствует как носорог”.",
 "snp1.3:11.1": "“Если обретает проницательного товарища,",
 "snp1.3:11.2": "Вместе идущего, хорошо-пребывающего-стойкого;",
 "snp1.3:11.3": "Одолев все опасности,",
 "snp1.3:11.4": "Должен странствовать с ним, довольный, памятующий”.",
 "snp1.3:12.1": "“Если не обретает проницательного товарища,",
 "snp1.3:12.2": "Вместе идущего, хорошо-пребывающего-стойкого;",
 "snp1.3:12.3": "Как царь, завоёванную страну оставив,",
 "snp1.3:12.4": "Один должен странствовать, как матанга-слон в лесу”.",
 "snp1.3:13.1": "“Поистине, восхваляем товарищества достижение,",
 "snp1.3:13.2": "Лучших равных следует обслуживать товарищей;",
 "snp1.3:13.3": "Их не обретя, безупречно питающийся,",
 "snp1.3:13.4": "Один пусть странствует как носорог”.",
 "snp1.3:14.1": "“Увидев золота блестящие,",
 "snp1.3:14.2": "Сыном кузнеца хорошо-отделанные;",
 "snp1.3:14.3": "Стучащиеся два на руке,",
 "snp1.3:14.4": "Один пусть странствует как носорог”.",
 "snp1.3:15.1": "“Так с другим со мной было бы,",
 "snp1.3:15.2": "Речи-говорение или раздражение;",
 "snp1.3:15.3": "Эту тревогу в будущем видя,",
 "snp1.3:15.4": "Один пусть странствует как носорог”.",
 "snp1.3:16.1": "“Желания ведь пёстры, сладки, восхитительны,",
 "snp1.3:16.2": "Разнообразными формами сминают ум-состояние;",
 "snp1.3:16.3": "Опасность в желаниях-множителях увидев,",
 "snp1.3:16.4": "Один пусть странствует как носорог”.",
 "snp1.3:17.1": "“Бедствие и опухоль и напасть,",
 "snp1.3:17.2": "Болезнь и дротик и тревога это для меня;",
 "snp1.3:17.3": "Эту тревогу в желаниях-множителях увидев,",
 "snp1.3:17.4": "Один пусть странствует как носорог”.",
 "snp1.3:18.1": "“Холод и жару и голод и жажду,",
 "snp1.3:18.2": "Ветер-жару и слепней-гадов;",
 "snp1.3:18.3": "Всё это преодолев,",
 "snp1.3:18.4": "Один пусть странствует как носорог”.",
 "snp1.3:19.1": "“Как слон стада покинув,",
 "snp1.3:19.2": "Рождённый-блоком лотосный возвышенный;",
 "snp1.3:19.3": "Как по-нраву пребывая в лесу,",
 "snp1.3:19.4": "Один пусть странствует как носорог”.",
 "snp1.3:20.1": "“Невозможность для любящего-компанию,",
 "snp1.3:20.2": "Что коснулся бы временное высвобождение;",
 "snp1.3:20.3": "Солнце-родственника речь услышав,",
 "snp1.3:20.4": "Один пусть странствует как носорог”.",
 "snp1.3:21.1": "“Взглядов-искривления превзойдя,",
 "snp1.3:21.2": "Достигший определённости обретший-путь;",
 "snp1.3:21.3": "Возникло-знание-я есть никем-не-ведомый,",
 "snp1.3:21.4": "Один пусть странствует как носорог”.",
 "snp1.3:22.1": "“Без-желания без-обмана без-жажды,",
 "snp1.3:22.2": "Без-злобы вычистивший-пятна-заблуждения;",
 "snp1.3:22.3": "Без-надежды ко всему свету став,",
 "snp1.3:22.4": "Один пусть странствует как носорог”.",
 "snp1.3:23.1": "“Плохого друга следует избегать,",
 "snp1.3:23.2": "Бесцельное-видящего в неровном утверждённого;",
 "snp1.3:23.3": "Сам не обслуживай занятого беспечного,",
 "snp1.3:23.4": "Один пусть странствует как носорог”.",
 "snp1.3:24.1": "“Много-слышащего Дхамму-держащего обслуживай,",
 "snp1.3:24.2": "Друга возвышенного красноречивого;",
 "snp1.3:24.3": "Познав блага-смыслы-цели устранив сомнение,",
 "snp1.3:24.4": "Один пусть странствует как носорог”.",
 "snp1.3:25.1": "“Игру радость желаний-приятное в мире",
 "snp1.3:25.2": "Не украшая себя, не ожидая;",
 "snp1.3:25.3": "От мест украшения воздержавшийся, правдиво-говорящий,",
 "snp1.3:25.4": "Один пусть странствует как носорог”.",
 "snp1.3:26.1": "“Сына и жену, отца и мать,",
 "snp1.3:26.2": "Богатства, зерно и родственников;",
 "snp1.3:26.3": "Оставив желания, какие есть по мере,",
 "snp1.3:26.4": "Один пусть странствует как носорог”.",
 "snp1.3:27.1": "“Обмотка это, малая здесь услада,",
 "snp1.3:27.2": "Малая привлекательность, боль здесь больше;",
 "snp1.3:27.3": "Крюк это, так зная, разумный,",
 "snp1.3:27.4": "Один пусть странствует как носорог”.",
 "snp1.3:28.1": "“Разрубив связанности,",
 "snp1.3:28.2": "Сеть словно разбив, в воде-ходящий;",
 "snp1.3:28.3": "Как огонь сожжённое не возвращаясь,",
 "snp1.3:28.4": "Один пусть странствует как носорог”.",
 "snp1.3:29.1": "“Опустивший глаза, и не с ноги-болтающийся,",
 "snp1.3:29.2": "Охраняющий способности, защищённый умом;",
 "snp1.3:29.3": "Не расплывшийся, не сгорающий,",
 "snp1.3:29.4": "Один пусть странствует как носорог”.",
 "snp1.3:30.1": "“Сняв домохозяина-признаки,",
 "snp1.3:30.2": "Скрыто-лиственный, как паричатта;",
 "snp1.3:30.3": "В охряной одежде, уйдя в бездомность,",
 "snp1.3:30.4": "Один пусть странствует как носорог”.",
 "snp1.3:31.1": "“К вкусам алчности не делая, не жадный,",
 "snp1.3:31.2": "Не-другого-кормящий, последовательно-ходящий;",
 "snp1.3:31.3": "В роду за родом не привязанный умом,",
 "snp1.3:31.4": "Один пусть странствует как носорог”.",
 "snp1.3:32.1": "“Оставив пять преград ума,",
 "snp1.3:32.2": "Загрязнения устранив все;",
 "snp1.3:32.3": "Независимый, отрезав привязанность-злобу,",
 "snp1.3:32.4": "Один пусть странствует как носорог”.",
 "snp1.3:33.1": "“Отвернувшись от приятного и боли,",
 "snp1.3:33.2": "И прежде удовлетворённость-недовольство;",
 "snp1.3:33.3": "Обретя прямо-смотрение равновесие чистое,",
 "snp1.3:33.4": "Один пусть странствует как носорог”.",
 "snp1.3:34.1": "“Начавший усилие для высшего-блага-достижения,",
 "snp1.3:34.2": "С умом-состоянием невялым, с неленивым поведением;",
 "snp1.3:34.3": "С твёрдым старанием, силой-мощью наделённый,",
 "snp1.3:34.4": "Один пусть странствует как носорог”.",
 "snp1.3:35.1": "“Уединение, джхану не оставляя,",
 "snp1.3:35.2": "В явлениях постоянно следующий-по-Дхамме;",
 "snp1.3:35.3": "Недостаток-опасность осознав в существованиях,",
 "snp1.3:35.4": "Один пусть странствует как носорог”.",
 "snp1.3:36.1": "“Цепляния-исчерпание стремясь, неослабный,",
 "snp1.3:36.2": "Не косноязычный, наслушанный, памятующий;",
 "snp1.3:36.3": "Исследовавший-явления, ограниченный, с усердием,",
 "snp1.3:36.4": "Один пусть странствует как носорог”.",
 "snp1.3:37.1": "“Как лев среди звуков невзволнованный,",
 "snp1.3:37.2": "Как ветер в сети не застревающий;",
 "snp1.3:37.3": "Как лотос водой не пачкаемый,",
 "snp1.3:37.4": "Один пусть странствует как носорог”.",
 "snp1.3:38.1": "“Как лев, клыкастый, мощный, одолев,",
 "snp1.3:38.2": "Царь зверей, превзойдя, ходит;",
 "snp1.3:38.3": "Пусть практикует уединённые жилища,",
 "snp1.3:38.4": "Один пусть странствует как носорог”.",
 "snp1.3:39.1": "“Мирность, прямо-смотрение, доброту, высвобождение,",
 "snp1.3:39.2": "Практикуя и мягкость вовремя;",
 "snp1.3:39.3": "Со всем миром не враждующий,",
 "snp1.3:39.4": "Один пусть странствует как носорог”.",
 "snp1.3:40.1": "“Страсть и вредность-злобу отбросив, замутненность-заблуждение,",
 "snp1.3:40.2": "Разрубив связанности;",
 "snp1.3:40.3": "Не трепеща при жизни-исчерпании,",
 "snp1.3:40.4": "Один пусть странствует как носорог”.",
 "snp1.3:41.1": "“Посещают, служат ради причины-цели,",
 "snp1.3:41.2": "Беспричинные редки сегодня друзья;",
 "snp1.3:41.3": "Своекорыстно-понимающие нечистые люди,",
 "snp1.3:41.4": "Один пусть странствует как носорог”.",
 "snp1.3:41.5": "Сутта о носороге третья."
}
