{
 "snp1.5:0.1": "Сутта Нипата 1.5",
 "snp1.5:0.2": "Сутта Чунды",
 "snp1.5:1.1": "“Спрашиваю мудреца с-обильным-пониманием,",
 "snp1.5:1.2": "(так Чунда, сын-кузнеца)",
 "snp1.5:1.3": "Пробуждённого, явления-владыку, с-превзойдённым-цеплянием;",
 "snp1.5:1.4": "Двуногого-лучшего, возничих превосходнейшего,",
 "snp1.5:1.5": "Сколько в мире шраманов — это-вот скажи”.",
 "snp1.5:2.1": "“Четверо шраманов, пятого нет,",
 "snp1.5:2.2": "(Чунда, — Благословенный),",
 "snp1.5:2.3": "Их тебе объявляю, как-свидетель-спрошенный;",
 "snp1.5:2.4": "Пути-победитель и пути-учащий,",
 "snp1.5:2.5": "На пути живущий и кто пути-портящий”.",
 "snp1.5:3.1": "“Кого пути-победителем называют пробуждённые,",
 "snp1.5:3.2": "(так Чунда, сын-кузнеца)",
 "snp1.5:3.3": "Пути-возвещающий каким несравненным является;",
 "snp1.5:3.4": "На пути живущего мне скажи, спрошенный,",
 "snp1.5:3.5": "И затем мне объяви пути-портящего”.",
 "snp1.5:4.1": "“Кто превзошёл-сомнение, без-занозы,",
 "snp1.5:4.2": "Ниббаной-наслаждающийся, не-привязанный;",
 "snp1.5:4.3": "Мира с-дэвами водитель,",
 "snp1.5:4.4": "Такого пути-победителем называют пробуждённые.",
 "snp1.5:5.1": "Высшее как высшее кто-здесь узнав,",
 "snp1.5:5.2": "Возвещает, разъясняет прямо-здесь явление;",
 "snp1.5:5.3": "Его, сомнение-отсекающего, мудреца, без-дрожания,",
 "snp1.5:5.4": "Вторым из монахов называют пути-учащим.",
 "snp1.5:6.1": "Кто в явления-строфе хорошо-изложенной,",
 "snp1.5:6.2": "На пути живёт сдержанный памятующий;",
 "snp1.5:6.3": "Безупречные-шаги ассоциирующийся,",
 "snp1.5:6.4": "Третьим монахи называют живущего-путь.",
 "snp1.5:7.1": "Покрытие сделав для хорошо-нравственных,",
 "snp1.5:7.2": "Вторгающийся, семьи-портящий, наглый;",
 "snp1.5:7.3": "Манипулирующий, несдержанный, болтливый,",
 "snp1.5:7.4": "Под-видом ходящий — он путь-портящий.",
 "snp1.5:8.1": "И этих кто проник, домохозяин,",
 "snp1.5:8.2": "Наслушанный-обученный благородно-слушатель с-пониманием;",
 "snp1.5:8.3": "Все не-таковы' узнав,",
 "snp1.5:8.4": "Так увидев, не ослабляет его вера;",
 "snp1.5:8.5": "Как же испорченным не-испорченное,",
 "snp1.5:8.6": "Чистое не-чистым равным сделать?”",
 "snp1.5:8.7": "Сутта Чунды пятая."
}
