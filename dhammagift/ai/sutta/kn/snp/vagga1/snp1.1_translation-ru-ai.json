{
 "snp1.1:0.1": "Сутта Нипата 1.1",
 "snp1.1:0.2": "Сутта Змея",
 "snp1.1:1.1": "Который возникший гнев устраняет,",
 "snp1.1:1.2": "Расползшийся, змеиный яд как травами;",
 "snp1.1:1.3": "Тот монах оставляет этот-и-тот берег,",
 "snp1.1:1.4": "Как змей — изношенную старую кожу.",
 "snp1.1:2.1": "Который страсть отрезал без остатка,",
 "snp1.1:2.2": "Как лотос, в пруду выросший, сорвав;",
 "snp1.1:2.3": "Тот монах оставляет этот-и-тот берег,",
 "snp1.1:2.4": "Как змей — изношенную старую кожу.",
 "snp1.1:3.1": "Который цепляние отрезал без остатка,",
 "snp1.1:3.2": "Поток, быстротекущий, иссушив;",
 "snp1.1:3.3": "Тот монах оставляет этот-и-тот берег,",
 "snp1.1:3.4": "Как змей — изношенную старую кожу.",
 "snp1.1:4.1": "Который самомнение сокрушил без остатка,",
 "snp1.1:4.2": "Как тростниковый мост, очень слабый, большой поток;",
 "snp1.1:4.3": "Тот монах оставляет этот-и-тот берег,",
 "snp1.1:4.4": "Как змей — изношенную старую кожу.",
 "snp1.1:5.1": "Который не нашёл в существованиях сути,",
 "snp1.1:5.2": "Выискивая, как цветок на смоковнице;",
 "snp1.1:5.3": "Тот монах оставляет этот-и-тот берег,",
 "snp1.1:5.4": "Как змей — изношенную старую кожу.",
 "snp1.1:6.1": "У которого внутри нет гнева,",
 "snp1.1:6.2": "Так-бытие-и-иначе-бытие перешёл;",
 "snp1.1:6.3": "Тот монах оставляет этот-и-тот берег,",
 "snp1.1:6.4": "Как змей — изношенную старую кожу.",
 "snp1.1:7.1": "У которого рассуждения рассеяны,",
 "snp1.1:7.2": "Внутри хорошо разделены без остатка;",
 "snp1.1:7.3": "Тот монах оставляет этот-и-тот берег,",
 "snp1.1:7.4": "Как змей — изношенную старую кожу.",
 "snp1.1:8.1": "Который ни перешёл, ни вернулся,",
 "snp1.1:8.2": "Всё превзошёл это разрастание;",
 "snp1.1:8.3": "Тот монах оставляет этот-и-тот берег,",
 "snp1.1:8.4": "Как змей — изношенную старую кожу.",
 "snp1.1:9.1": "Который ни перешёл, ни вернулся,",
 "snp1.1:9.2": "«Всё это ложно» — зная в мире;",
 "snp1.1:9.3": "Тот монах оставляет этот-и-тот берег,",
 "snp1.1:9.4": "Как змей — изношенную старую кожу.",
 "snp1.1:10.1": "Который ни перешёл, ни вернулся,",
 "snp1.1:10.2": "«Всё это ложно» — без корысти;",
 "snp1.1:10.3": "Тот монах оставляет этот-и-тот берег,",
 "snp1.1:10.4": "Как змей — изношенную старую кожу.",
 "snp1.1:11.1": "Который ни перешёл, ни вернулся,",
 "snp1.1:11.2": "«Всё это ложно» — без страсти;",
 "snp1.1:11.3": "Тот монах оставляет этот-и-тот берег,",
 "snp1.1:11.4": "Как змей — изношенную старую кожу.",
 "snp1.1:12.1": "Который ни перешёл, ни вернулся,",
 "snp1.1:12.2": "«Всё это ложно» — без злобы;",
 "snp1.1:12.3": "Тот монах оставляет этот-и-тот берег,",
 "snp1.1:12.4": "Как змей — изношенную старую кожу.",
 "snp1.1:13.1": "Который ни перешёл, ни вернулся,",
 "snp1.1:13.2": "«Всё это ложно» — без заблуждения;",
 "snp1.1:13.3": "Тот монах оставляет этот-и-тот берег,",
 "snp1.1:13.4": "Как змей — изношенную старую кожу.",
 "snp1.1:14.1": "У которого закладок нет никаких,",
 "snp1.1:14.2": "Корни и неблаготворные вырваны;",
 "snp1.1:14.3": "Тот монах оставляет этот-и-тот берег,",
 "snp1.1:14.4": "Как змей — изношенную старую кожу.",
 "snp1.1:15.1": "У кого дрожь-рождённые не существуют никакие,",
 "snp1.1:15.2": "Для обратного прихода условия;",
 "snp1.1:15.3": "Тот монах оставляет этот-и-тот берег,",
 "snp1.1:15.4": "Как змей — изношенную старую кожу.",
 "snp1.1:16.1": "У кого лес-рождённые не существуют никакие,",
 "snp1.1:16.2": "Для привязывания к бхаве причина-устроение;",
 "snp1.1:16.3": "Тот монах оставляет этот-и-тот берег,",
 "snp1.1:16.4": "Как змей — изношенную старую кожу.",
 "snp1.1:17.1": "Кто преграды отбросив пять,",
 "snp1.1:17.2": "Без-тревоги переплывший сомнение без-занозы;",
 "snp1.1:17.3": "Тот монах оставляет этот-и-тот берег,",
 "snp1.1:17.4": "Змей сброшенную кожу старую — так.",
 "snp1.1:17.5": "Сутта Змей завершена первая."
}
