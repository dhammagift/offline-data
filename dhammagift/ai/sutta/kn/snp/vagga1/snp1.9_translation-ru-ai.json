{
 "snp1.9:0.1": "Сутта Нипата 1.9",
 "snp1.9:0.2": "Сутта Хемаваты",
 "snp1.9:1.1": "“Сегодня пятнадцатый упосатха,",
 "snp1.9:1.2": "(так яккха Сатагира)",
 "snp1.9:1.3": "Божественная ночь наступила;",
 "snp1.9:1.4": "Непревзойдённого-имени Учителя,",
 "snp1.9:1.5": "Давай увидим Готаму”.",
 "snp1.9:2.1": "“Надеюсь, ум-представление хорошо направлен,",
 "snp1.9:2.2": "(так яккха Хемавата)",
 "snp1.9:2.3": "Ко всем существам у такого;",
 "snp1.9:2.4": "Надеюсь, в желательном и нежелательном",
 "snp1.9:2.5": "Намерение под контролем”.",
 "snp1.9:3.1": "“Ум-представление его хорошо направлен",
 "snp1.9:3.2": "(так яккха Сатагира)",
 "snp1.9:3.3": "Ко всем существам у такого;",
 "snp1.9:3.4": "И в желательном и нежелательном,",
 "snp1.9:3.5": "Намерение под контролем”.",
 "snp1.9:4.1": "“Надеюсь, неберёмое не берёт,",
 "snp1.9:4.2": "(так яккха Хемавата)",
 "snp1.9:4.3": "Надеюсь, в существах сдержан;",
 "snp1.9:4.4": "Надеюсь, далёк от беспечности,",
 "snp1.9:4.5": "Надеюсь, джхану не оставляет”.",
 "snp1.9:5.1": "“Он неберёмое не берёт,",
 "snp1.9:5.2": "(так яккха Сатагира)",
 "snp1.9:5.3": "И в существах сдержан;",
 "snp1.9:5.4": "И далёк от беспечности,",
 "snp1.9:5.5": "Пробуждённый джхану не оставляет”.",
 "snp1.9:6.1": "“Надеюсь, ложь не говорит,",
 "snp1.9:6.2": "(так яккха Хемавата)",
 "snp1.9:6.3": "Надеюсь, не груборечив;",
 "snp1.9:6.4": "Надеюсь, оскорбления не говорит,",
 "snp1.9:6.5": "Надеюсь, не говорит грубости”.",
 "snp1.9:7.1": "“Ложь он не говорит,",
 "snp1.9:7.2": "(так яккха Сатагира)",
 "snp1.9:7.3": "После — не истощён речью;",
 "snp1.9:7.4": "После — о прекращении не говорит,",
 "snp1.9:7.5": "Мудростью цель и говорит”.",
 "snp1.9:8.1": "“Надеюсь, не привязывается к желаниям,",
 "snp1.9:8.2": "(так яккха Хемавата)",
 "snp1.9:8.3": "Надеюсь, ум-состояние незамутнённое;",
 "snp1.9:8.4": "Надеюсь, замутненность-заблуждение превзошёл,",
 "snp1.9:8.5": "Надеюсь, в явлениях глазастый”.",
 "snp1.9:9.1": "“Он не привязывается к желаниям,",
 "snp1.9:9.2": "(так яккха Сатагира)",
 "snp1.9:9.3": "После — ум-состояние незамутнённое;",
 "snp1.9:9.4": "Всю замутненность-заблуждение превзошёл,",
 "snp1.9:9.5": "Пробуждённый, в явлениях глазастый”.",
 "snp1.9:10.1": "“Надеюсь, знанием наделён,",
 "snp1.9:10.2": "(так яккха Хемавата)",
 "snp1.9:10.3": "Надеюсь, чисто-поведенческий;",
 "snp1.9:10.4": "Надеюсь, его истечения исчерпаны,",
 "snp1.9:10.5": "Надеюсь, нет повторной вовлеченности-[индивидуального] существования”.",
 "snp1.9:11.1": "“Знанием именно наделён,",
 "snp1.9:11.2": "(так яккха Сатагира)",
 "snp1.9:11.3": "После — чисто-поведенческий;",
 "snp1.9:11.4": "Все истечения исчерпаны,",
 "snp1.9:11.5": "Нет у него повторной вовлеченности-[индивидуального] существования”.",
 "snp1.9:12.1": "“Наделённого мудреца ум-состояние,",
 "snp1.9:12.2": "Активностью и речью;",
 "snp1.9:12.3": "Знанием-поведением-наделённого,",
 "snp1.9:12.4": "Согласно Дхамме его восхваляет”.",
 "snp1.9:13.1": "“Наделённого мудреца ум-состояние,",
 "snp1.9:13.2": "Активностью и речью;",
 "snp1.9:13.3": "Знанием-поведением-наделённого,",
 "snp1.9:13.4": "Явлением радуешься.",
 "snp1.9:14.1": "Наделённого мудреца ум-состояние,",
 "snp1.9:14.2": "Активностью и речью;",
 "snp1.9:14.3": "Знанием-поведением-наделённого,",
 "snp1.9:14.4": "Давай увидим Готаму”.",
 "snp1.9:15.1": "“Эниджангха, худой, герой,",
 "snp1.9:15.2": "Мало-питающийся не-алчный;",
 "snp1.9:15.3": "Мудреца в лесу зажжённого,",
 "snp1.9:15.4": "Иди увидим Готаму.",
 "snp1.9:16.1": "Лев, одиноко-ходящий, слон,",
 "snp1.9:16.2": "В желаниях не-ожидающий;",
 "snp1.9:16.3": "Подойдя, спрашиваем,",
 "snp1.9:16.4": "Мары-силка-освобождение.",
 "snp1.9:17.1": "Рассказчика провозглашающего,",
 "snp1.9:17.2": "Всех-явлений-за-пределом;",
 "snp1.9:17.3": "Пробуждённый, вражды-тревогу превзошедший,",
 "snp1.9:17.4": "Мы спрашиваем Готаму”.",
 "snp1.9:18.1": "“В чём свет порождён,",
 "snp1.9:18.2": "(так яккха Хемавата)",
 "snp1.9:18.3": "В чём делает близость;",
 "snp1.9:18.4": "Что свет поддерживая,",
 "snp1.9:18.5": "В чём свет изнуряется”.",
 "snp1.9:19.1": "“В шести свет порождён,",
 "snp1.9:19.2": "(Хемаватати Благословенный)",
 "snp1.9:19.3": "В шести делает близость;",
 "snp1.9:19.4": "Шесть именно поддерживая,",
 "snp1.9:19.5": "В шести свет изнуряется”.",
 "snp1.9:20.1": "“Какое то поддерживание,",
 "snp1.9:20.2": "Где свет изнуряется;",
 "snp1.9:20.3": "Выход спрошенный скажи,",
 "snp1.9:20.4": "Как от боли освобождается”.",
 "snp1.9:21.1": "“Пять желания-множителей в мире,",
 "snp1.9:21.2": "Ум-представление-шестым провозглашены;",
 "snp1.9:21.3": "Здесь импульс устранив-страстью,",
 "snp1.9:21.4": "Так от боли освобождается.",
 "snp1.9:22.1": "Это света выход,",
 "snp1.9:22.2": "Рассказано вам как-оно-есть;",
 "snp1.9:22.3": "Это вам я говорю,",
 "snp1.9:22.4": "Так от боли освобождается”.",
 "snp1.9:23.1": "“Кто же здесь затопление пересекает,",
 "snp1.9:23.2": "Кто здесь пересекает океан;",
 "snp1.9:23.3": "Без опоры, без поддержки,",
 "snp1.9:23.4": "Кто в глубоком не тонет”.",
 "snp1.9:24.1": "“Всегда нравственностью-наделённый,",
 "snp1.9:24.2": "Понимающий, хорошо-сосредоточенный;",
 "snp1.9:24.3": "Внутренне-мыслящий, памятующий,",
 "snp1.9:24.4": "Затопление пересекает трудно-пересекаемое.",
 "snp1.9:25.1": "Воздерживаясь от желания-сознавания,",
 "snp1.9:25.2": "Все-связанности-превзошедший;",
 "snp1.9:25.3": "Радость-бхава-истощивший,",
 "snp1.9:25.4": "Тот в глубоком не тонет”.",
 "snp1.9:26.1": "“Глубоко-понимающего, тонко-благо-видящего,",
 "snp1.9:26.2": "Ничего-не-имеющего, к желанию-бхаве не-привязанного;",
 "snp1.9:26.3": "Того видите, везде освобождённого,",
 "snp1.9:26.4": "По божественному пути шагающего, великого провидца.",
 "snp1.9:27.1": "Непревзойдённо-именного, тонко-благо-видящего,",
 "snp1.9:27.2": "Дающий понимание, к желания-жилищу не привязанный;",
 "snp1.9:27.3": "Того видите всезнающего, мудрого,",
 "snp1.9:27.4": "По благородному пути шагающего, великого провидца.",
 "snp1.9:28.1": "Хорошо-увидено вот нами сегодня,",
 "snp1.9:28.2": "Хорошо-рассветало, хорошо-встало;",
 "snp1.9:28.3": "Что увидели мы пробуждённого,",
 "snp1.9:28.4": "Затопление-пересёкшего, без-истечений.",
 "snp1.9:29.1": "Эти десять-сотен яккхов,",
 "snp1.9:29.2": "Обладающие силой, обладающие славой;",
 "snp1.9:29.3": "Все к тому прибежищу идут,",
 "snp1.9:29.4": "Ты нам Учитель непревзойдённый.",
 "snp1.9:30.1": "Те мы будем странствовать,",
 "snp1.9:30.2": "Из деревни в деревню, с горы на гору;",
 "snp1.9:30.3": "Почтительно приветствуя Пробуждённого,",
 "snp1.9:30.4": "и Дхаммы превосходную Дхамму”.",
 "snp1.9:30.5": "Сутта Хемаваты завершена девятая."
}
