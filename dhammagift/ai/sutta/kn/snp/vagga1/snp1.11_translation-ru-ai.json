{
 "snp1.11:0.1": "Сутта Нипата 1.11",
 "snp1.11:0.2": "Сутта Победы",
 "snp1.11:1.1": "Идущий ли, или стоящий,",
 "snp1.11:1.2": "сидящий или же лежащий;",
 "snp1.11:1.3": "Сгибает, вытягивает,",
 "snp1.11:1.4": "это тела-массива шевеление.",
 "snp1.11:2.1": "Костно-связочно-соединённый,",
 "snp1.11:2.2": "кожей-плотью-обмазанный;",
 "snp1.11:2.3": "Шкурой тело-массив покрыт,",
 "snp1.11:2.4": "как-есть не виден.",
 "snp1.11:3.1": "Кишко-наполненный, желудочно-наполненный,",
 "snp1.11:3.2": "печени-комка, мочевого пузыря;",
 "snp1.11:3.3": "Сердца, лёгких,",
 "snp1.11:3.4": "почек, селезёнки и.",
 "snp1.11:4.1": "Слизи-соплей, слюны,",
 "snp1.11:4.2": "пота и жира и;",
 "snp1.11:4.3": "Крови, спинно-мозговой и суставной жидкости,",
 "snp1.11:4.4": "желчи и кожного сала и.",
 "snp1.11:5.1": "И его девятью потоками,",
 "snp1.11:5.2": "нечистота течёт постоянно;",
 "snp1.11:5.3": "Из глаза — глазная грязь,",
 "snp1.11:5.4": "из уха — ушная грязь.",
 "snp1.11:6.1": "Слизь-сопли и из носа,",
 "snp1.11:6.2": "ртом изрыгает иногда;",
 "snp1.11:6.3": "Желчь и слизь изрыгает,",
 "snp1.11:6.4": "из тела-массива пот-грязь.",
 "snp1.11:7.1": "И вот его полая голова,",
 "snp1.11:7.2": "мозгом наполнена;",
 "snp1.11:7.3": "Красивым её считает глупец,",
 "snp1.11:7.4": "незнанием предваряемый.",
 "snp1.11:8.1": "Когда же он мёртвым лежит,",
 "snp1.11:8.2": "Вздутый, посиневший;",
 "snp1.11:8.3": "Брошенный на кладбище,",
 "snp1.11:8.4": "Безразличны становятся родственники.",
 "snp1.11:9.1": "Поедают его собаки,",
 "snp1.11:9.2": "и шакалы, и волки, и черви;",
 "snp1.11:9.3": "Вороны и коршуны поедают,",
 "snp1.11:9.4": "и какие ещё есть существа.",
 "snp1.11:10.1": "Услышав слово Пробуждённого,",
 "snp1.11:10.2": "Монах, понимающий здесь;",
 "snp1.11:10.3": "Он ведь его полностью понимает,",
 "snp1.11:10.4": "Как-есть ведь видит.",
 "snp1.11:11.1": "Как это — так то,",
 "snp1.11:11.2": "Как то — так это;",
 "snp1.11:11.3": "Внутренне и внешне,",
 "snp1.11:11.4": "В теле импульс пусть устранит.",
 "snp1.11:12.1": "Импульс-страсть устранив, он,",
 "snp1.11:12.2": "Монах, понимающий здесь;",
 "snp1.11:12.3": "Достиг бессмертного покоя,",
 "snp1.11:12.4": "Ниббаны — нетленного состояния.",
 "snp1.11:13.1": "Это двуногое — нечисто,",
 "snp1.11:13.2": "Зловонно, истощается;",
 "snp1.11:13.3": "Разными трупами наполненный,",
 "snp1.11:13.4": "Сочащийся оттуда и отсюда.",
 "snp1.11:14.1": "Таким телом,",
 "snp1.11:14.2": "Кто бы мог подумать возвысить;",
 "snp1.11:14.3": "Другого же мог бы унизить,",
 "snp1.11:14.4": "От чего кроме как от невидения?",
 "snp1.11:14.5": "Сутта Победы одиннадцатая."
}
