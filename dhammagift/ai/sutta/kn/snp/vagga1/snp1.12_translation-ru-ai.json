{
 "snp1.12:0.1": "Сутта Нипата 1.12",
 "snp1.12:0.2": "Мудреца Сутта",
 "snp1.12:1.1": "От близости тревога рождена,",
 "snp1.12:1.2": "от жилья рождается пыль;",
 "snp1.12:1.3": "Без-жилья, без-близости,",
 "snp1.12:1.4": "это вот мудреца видение.",
 "snp1.12:2.1": "Кто рождённое отсекши не взращивал бы,",
 "snp1.12:2.2": "рождающемуся ему не давал бы подпитки;",
 "snp1.12:2.3": "Того называют одним среди мудрецов странствующим,",
 "snp1.12:2.4": "Увидел он умиротворённый путь великий ищущий.",
 "snp1.12:3.1": "Исследовав основы, измерив семя,",
 "snp1.12:3.2": "привязанность ему не давал бы подпитки;",
 "snp1.12:3.3": "Он вот мудрец, рождения-исчерпания-конец видящий,",
 "snp1.12:3.4": "рассуждение оставив, не идёт к счёту.",
 "snp1.12:4.1": "Познав все обиталища,",
 "snp1.12:4.2": "не желая ни одного из них;",
 "snp1.12:4.3": "Он вот мудрец, без страсти, не жадный,",
 "snp1.12:4.4": "не напрягается, ведь перешедшим на тот берег стал.",
 "snp1.12:5.1": "Всё превзошедшего, всё знающего, мудрого,",
 "snp1.12:5.2": "Во всех явлениях незапятнанного;",
 "snp1.12:5.3": "всё оставившего, в цепляния-исчерпании освобождённого,",
 "snp1.12:5.4": "Того также мудрые мудрецом называют.",
 "snp1.12:6.1": "Понимания-силой, нравственностью-сутью наделённого,",
 "snp1.12:6.2": "собранного, в джхане радующегося, памятующего;",
 "snp1.12:6.3": "От пут освобождённого, без-тщеты, без-истечений,",
 "snp1.12:6.4": "Того также мудрые мудрецом называют.",
 "snp1.12:7.1": "Одного идущего мудреца не-беспечного,",
 "snp1.12:7.2": "В порицаниях-похвалах не дрожащего;",
 "snp1.12:7.3": "Как льва в звуках не испуганного,",
 "snp1.12:7.4": "Как ветер в сети не застревающего;",
 "snp1.12:7.5": "Как лотос водой не пачкающегося,",
 "snp1.12:7.6": "Ведущего других, не ведомого другими;",
 "snp1.12:7.7": "Того также мудрые мудрецом называют.",
 "snp1.12:8.1": "Который в погружении как столб рождается,",
 "snp1.12:8.2": "В котором другие предел речи говорят;",
 "snp1.12:8.3": "Того без очарованности, хорошо-сосредоточенного в способностях,",
 "snp1.12:8.4": "Того также мудрые мудрецом называют.",
 "snp1.12:9.1": "Который действительно устойчивый-в-себе, как стрела прямая,",
 "snp1.12:9.2": "Гнушается активностями плохими;",
 "snp1.12:9.3": "Исследуя неровное и ровное,",
 "snp1.12:9.4": "Того также мудрые мудрецом называют.",
 "snp1.12:10.1": "Который сдержанный-в-себе не делает плохого,",
 "snp1.12:10.2": "Молодой и средний мудрец, сдержанный-в-себе;",
 "snp1.12:10.3": "Не-вызывающий-гнева, он не гневит никого,",
 "snp1.12:10.4": "Того также мудрые мудрецом называют.",
 "snp1.12:11.1": "Если с начала, середины или остатка,",
 "snp1.12:11.2": "Подаяние получит, на чужое-даваемое живущий;",
 "snp1.12:11.3": "Не уместен для восхваления, ни низко-говорящий,",
 "snp1.12:11.4": "Того также мудрые мудрецом называют.",
 "snp1.12:12.1": "Мудреца идущего, воздержавшегося от спаривания,",
 "snp1.12:12.2": "Который в юности нигде не привязывается;",
 "snp1.12:12.3": "От опьянения-беспечности воздержавшегося, полностью-освобождённого,",
 "snp1.12:12.4": "Того также мудрые мудрецом называют.",
 "snp1.12:13.1": "Познав мир, высшее-благо видящего,",
 "snp1.12:13.2": "Затопление, океан переплывшего, такого;",
 "snp1.12:13.3": "Того с разрубленными узлами, не-привязанного, без истечений,",
 "snp1.12:13.4": "Того также мудрые мудрецом называют.",
 "snp1.12:14.1": "Неравны оба — далеко-пребывающие-поведением:",
 "snp1.12:14.2": "Домохозяин, содержащий жену, и без-моего, с хорошими принципами;",
 "snp1.12:14.3": "Для удержания-других-жизней домохозяин несдержан,",
 "snp1.12:14.4": "Всегда мудрец охраняет живых, потому что.",
 "snp1.12:15.1": "Павлин с синей шеей, птица,",
 "snp1.12:15.2": "Лебедя не достигает скорости никогда;",
 "snp1.12:15.3": "Так домохозяин не подражает монаху,",
 "snp1.12:15.4": "Мудрецу, уединённому, в лесу зажжённому.",
 "snp1.12:15.5": "Сутта Мудреца двенадцатая.",
 "snp1.12:15.6": "Глава Урага Первая.",
 "snp1.12:16.0": "Оглавление",
 "snp1.12:16.1": "Урага, Дхания,",
 "snp1.12:16.2": "и с рогом, также пахотный;",
 "snp1.12:16.3": "Чунда, Падение,",
 "snp1.12:16.4": "изгой, развитие мирности.",
 "snp1.12:17.1": "Сагатхира, Алавака,",
 "snp1.12:17.2": "Виджая и также мудрец;",
 "snp1.12:17.3": "Двенадцать этих сутт,",
 "snp1.12:17.4": "Глава Урага называется."
}
