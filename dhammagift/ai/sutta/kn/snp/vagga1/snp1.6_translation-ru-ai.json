{
 "snp1.6:0.1": "Сутта Нипата 1.6",
 "snp1.6:0.2": "Сутта Упадка",
 "snp1.6:1.1": "Так мной услышано—",
 "snp1.6:1.2": "одно время Благословенный в Саваттхи располагается, в роще Джеты, в парке Анатхапиндики.",
 "snp1.6:1.3": "И тогда некая дэвата предрассветной ночью, превосходного вида, осветив целиком рощу Джеты, подошла к Благословенному; подойдя, поприветствовав Благословенного, встала с одного края.",
 "snp1.6:1.4": "Рядом встав, та дэвата Благословенного стихом обратилась:",
 "snp1.6:2.1": "“Падение человека,",
 "snp1.6:2.2": "мы спрашиваем, Готама;",
 "snp1.6:2.3": "Благословенного спросить придя,",
 "snp1.6:2.4": "что есть упадка вход”.",
 "snp1.6:3.1": "“Легкоузнаваемо существование бывает,",
 "snp1.6:3.2": "легкоузнаваемо падение;",
 "snp1.6:3.3": "Дхамму-желающий существование бывает,",
 "snp1.6:3.4": "Дхамму-ненавидящий — падение”.",
 "snp1.6:4.1": "“Так это мы понимаем,",
 "snp1.6:4.2": "первое то падение;",
 "snp1.6:4.3": "Второе, Благословенный, скажи,",
 "snp1.6:4.4": "что есть упадка вход”.",
 "snp1.6:5.1": "“Не-хороших любимы бывают,",
 "snp1.6:5.2": "хороших не делает любимыми;",
 "snp1.6:5.3": "Не-хороших явление одобряет,",
 "snp1.6:5.4": "то — упадка вход”.",
 "snp1.6:6.1": "“Так это мы понимаем,",
 "snp1.6:6.2": "второе то падение;",
 "snp1.6:6.3": "Третье, Благословенный, скажи,",
 "snp1.6:6.4": "что есть упадка вход”.",
 "snp1.6:7.1": "“Сонливость-принципом, собрания-принципом,",
 "snp1.6:7.2": "не-встающий и который человек;",
 "snp1.6:7.3": "Ленивый, гнев-понимающий,",
 "snp1.6:7.4": "то — упадка вход”.",
 "snp1.6:8.1": "“Так это мы понимаем,",
 "snp1.6:8.2": "третье то падение;",
 "snp1.6:8.3": "Четвёртое, Благословенный, скажи,",
 "snp1.6:8.4": "что есть упадка вход”.",
 "snp1.6:9.1": "“Который мать или отца,",
 "snp1.6:9.2": "старого, ушедшей-молодости;",
 "snp1.6:9.3": "Может, святой не носит,",
 "snp1.6:9.4": "то — упадка вход”.",
 "snp1.6:10.1": "“Так это мы понимаем,",
 "snp1.6:10.2": "четвёртый тот — упадок;",
 "snp1.6:10.3": "Пятую, Благословенный, скажи,",
 "snp1.6:10.4": "что есть упадка вход”.",
 "snp1.6:11.1": "“Кто брахмана или шрамана,",
 "snp1.6:11.2": "Или же иного нищего;",
 "snp1.6:11.3": "Ложным-утверждением обманывает,",
 "snp1.6:11.4": "То — упадка вход”.",
 "snp1.6:12.1": "“Так это мы понимаем,",
 "snp1.6:12.2": "Пятый тот — упадок;",
 "snp1.6:12.3": "Шестую, Благословенный, скажи,",
 "snp1.6:12.4": "Что есть упадка вход”.",
 "snp1.6:13.1": "“Богатый имуществом человек,",
 "snp1.6:13.2": "С золотом, с пропитанием;",
 "snp1.6:13.3": "Один вкушает сладости,",
 "snp1.6:13.4": "То — упадка вход”.",
 "snp1.6:14.1": "“Так это мы понимаем,",
 "snp1.6:14.2": "Шестой тот — упадок;",
 "snp1.6:14.3": "Седьмую, Благословенный, скажи,",
 "snp1.6:14.4": "Что есть упадка вход”.",
 "snp1.6:15.1": "“Рождением гордый, богатством гордый,",
 "snp1.6:15.2": "Родом гордый и кто человек;",
 "snp1.6:15.3": "Сознавание-родственника презирает,",
 "snp1.6:15.4": "То — упадка вход”.",
 "snp1.6:16.1": "“Так это мы понимаем,",
 "snp1.6:16.2": "Седьмой тот — упадок;",
 "snp1.6:16.3": "Восьмую, Благословенный, скажи,",
 "snp1.6:16.4": "Что есть упадка вход”.",
 "snp1.6:17.1": "“Женщин-игрок, вина-игрок,",
 "snp1.6:17.2": "Кости-игрок и кто человек;",
 "snp1.6:17.3": "Добытое добытое уничтожает,",
 "snp1.6:17.4": "То — упадка вход”.",
 "snp1.6:18.1": "“Так это мы понимаем,",
 "snp1.6:18.2": "Восьмой тот — упадок;",
 "snp1.6:18.3": "Девятую, Благословенный, скажи,”",
 "snp1.6:18.4": "Что есть упадка вход”.",
 "snp1.6:19.1": "“Своими жёнами недовольный,",
 "snp1.6:19.2": "К блудницам портится;",
 "snp1.6:19.3": "Портится к чужим жёнам,",
 "snp1.6:19.4": "То — упадка вход”.",
 "snp1.6:20.1": "“Так это мы понимаем,",
 "snp1.6:20.2": "Девятый тот упадок;",
 "snp1.6:20.3": "Десятую, Благословенный, скажи,”",
 "snp1.6:20.4": "Что есть упадка вход”.",
 "snp1.6:21.1": "“Перешедший юность мужчина,",
 "snp1.6:21.2": "Приводит с грудями-тимбару;",
 "snp1.6:21.3": "Из-за ревности к ней не спит,",
 "snp1.6:21.4": "То — упадка вход”.",
 "snp1.6:22.1": "“Так это мы понимаем,",
 "snp1.6:22.2": "Десятый тот упадок;",
 "snp1.6:22.3": "Одиннадцатую, Благословенный, скажи,”",
 "snp1.6:22.4": "Что есть упадка вход”.",
 "snp1.6:23.1": "“Женщину пьющую, расточительную,",
 "snp1.6:23.2": "Или мужчину такого же;",
 "snp1.6:23.3": "На власть ставит,",
 "snp1.6:23.4": "То — упадка вход”.",
 "snp1.6:24.1": "“Так это мы понимаем,",
 "snp1.6:24.2": "Одиннадцатый тот упадок;",
 "snp1.6:24.3": "Двенадцатую, Благословенный, скажи,”",
 "snp1.6:24.4": "Что есть упадка вход”.",
 "snp1.6:25.1": "“Малый имуществом, с большим цеплянием,",
 "snp1.6:25.2": "В кхаттийском рождается роду;",
 "snp1.6:25.3": "И он царства желает,",
 "snp1.6:25.4": "То — упадка вход.",
 "snp1.6:26.1": "Эти упадки в мире,",
 "snp1.6:26.2": "Мудрец, рассмотрев,",
 "snp1.6:26.3": "Благородный, видением наделённый,",
 "snp1.6:26.4": "Тот мир благостный посещает”.",
 "snp1.6:26.5": "Сутта Упадка шестая."
}
