{
 "snp4.16:0.1": "Сутта Нипата 4.16",
 "snp4.16:0.2": "Сутта Сарипутта",
 "snp4.16:1.1": "“Не мной увиден отсюда прежде,",
 "snp4.16:1.2": "(так уважаемый Сарипутта)",
 "snp4.16:1.3": "Не услышан ни от кого;",
 "snp4.16:1.4": "Так прекрасно-говорящий Учитель,",
 "snp4.16:1.5": "Из Туситы с группой пришёл.",
 "snp4.16:2.1": "Мира с божествами,",
 "snp4.16:2.2": "как видится обладающий глазом;",
 "snp4.16:2.3": "Всю тьму рассеяв,",
 "snp4.16:2.4": "один радости достиг.",
 "snp4.16:3.1": "Того пробуждённого, не-привязанного, такого,",
 "snp4.16:3.2": "не-лживого, с группой пришедшего;",
 "snp4.16:3.3": "Многих здесь связанных,",
 "snp4.16:3.4": "есть с вопросом приход.",
 "snp4.16:4.1": "Монаха, испытывающего отвращение,",
 "snp4.16:4.2": "посещающего пустое сиденье;",
 "snp4.16:4.3": "Корень дерева, кладбище или,",
 "snp4.16:4.4": "в горных пещерах или.",
 "snp4.16:5.1": "В высоких и низких ложах,",
 "snp4.16:5.2": "сколько там ужасов;",
 "snp4.16:5.3": "Которыми монах не должен дрожать,",
 "snp4.16:5.4": "в беззвучном ложе-сиденье.",
 "snp4.16:6.1": "Сколько опасностей в мире,",
 "snp4.16:6.2": "идущему в не-пройденное направление;",
 "snp4.16:6.3": "Которые монах должен превозмочь,",
 "snp4.16:6.4": "в уединённом сидении-лежании.",
 "snp4.16:7.1": "Какие у него будут высказывания,",
 "snp4.16:7.2": "какие у него здесь области;",
 "snp4.16:7.3": "Какие нравственности-обеты у него будут,",
 "snp4.16:7.4": "устремившего себя монаха.",
 "snp4.16:8.1": "Какую тренировку приняв,",
 "snp4.16:8.2": "едино-направленный, рассудительный, памятующий;",
 "snp4.16:8.3": "Как серебряных дел мастер,",
 "snp4.16:8.4": "вычистит пятно себя”.",
 "snp4.16:9.1": "“У отвращающегося это—приятное,",
 "snp4.16:9.2": "(Сарипутта, — Благословенный)",
 "snp4.16:9.3": "Пустое сидение, лежание если практикует;",
 "snp4.16:9.4": "Пробуждения желающего в соответствии с Дхаммой,",
 "snp4.16:9.5": "То тебе объявлю как понимая.",
 "snp4.16:10.1": "Пяти знаток тревог не боится,",
 "snp4.16:10.2": "Монах памятующий, с ограниченным хождением;",
 "snp4.16:10.3": "Оводов-насекомых, пресмыкающихся,",
 "snp4.16:10.4": "Людей-касаний, четвероногих.",
 "snp4.16:11.1": "Чуждых-явлений также не страшится,",
 "snp4.16:11.2": "Увидев и у них многие ужасы;",
 "snp4.16:11.3": "И другие преодолеет,",
 "snp4.16:11.4": "Опасности благотворного ищущий.",
 "snp4.16:12.1": "Болезни-касанием, голодом затронутый,",
 "snp4.16:12.2": "Холод, и жару вытерпит;",
 "snp4.16:12.3": "Ими затронутый многообразно, без-дома,",
 "snp4.16:12.4": "Усердие, старание крепкое сделает.",
 "snp4.16:13.1": "Воровства не делай, лжи не говори,",
 "snp4.16:13.2": "С мирностью касайся дрожащих и неподвижных;",
 "snp4.16:13.3": "Когда-замутнённость ума-представления должен знать,",
 "snp4.16:13.4": "Тёмного сторонником — пусть отбрасывает.",
 "snp4.16:14.1": "Гнева-самомнения под власть не иди,",
 "snp4.16:14.2": "Корень их выкопав, стой;",
 "snp4.16:14.3": "Тогда приятное или же неприятное,",
 "snp4.16:14.4": "Воистину, уважаемые, преодолеет.",
 "snp4.16:15.1": "Понимание поставив вперёд, с благой-радостью,",
 "snp4.16:15.2": "Устранит те опасности;",
 "snp4.16:15.3": "Не-радование пусть превозмогает на ложе уединённом,",
 "snp4.16:15.4": "Четыре пусть превозмогает плача-явления.",
 "snp4.16:16.1": "Что же буду есть, где же буду есть,",
 "snp4.16:16.2": "Боль, воистину, спал, где сегодня буду спать;",
 "snp4.16:16.3": "Эти рассуждения, плачевные,",
 "snp4.16:16.4": "Пусть устраняет ученик, без-дома-ходящий.",
 "snp4.16:17.1": "Еду получив и одежду вовремя,",
 "snp4.16:17.2": "Меру пусть знает здесь для-удовлетворения-благом;",
 "snp4.16:17.3": "Он в них охраняемый, сдержанно-ходящий в деревне,",
 "snp4.16:17.4": "Даже-будучи-разгневанным, речь грубую не говорит.",
 "snp4.16:18.1": "Опустивший глаза, не с ногами-шатающимися,",
 "snp4.16:18.2": "Джхане-преданный, много-бодрствующий;",
 "snp4.16:18.3": "Равностное-видение начав, сосредоточенный-умом,",
 "snp4.16:18.4": "Рассуждения-остаток, сожаление-отсекает.",
 "snp4.16:19.1": "Побуждаемый речами памятующий радуется,",
 "snp4.16:19.2": "Среди товарищей по святой жизни суету пусть разрушит;",
 "snp4.16:19.3": "Речь пусть выпускает благотворную, не чрезмерно,",
 "snp4.16:19.4": "К мирским разговорам пусть не устремляется.",
 "snp4.16:20.1": "И затем пять пылей в мире,",
 "snp4.16:20.2": "В которых памятующий для выведения тренируется;",
 "snp4.16:20.3": "На объекты, на звуки, а также на вкусы,",
 "snp4.16:20.4": "На запахи, на касания пусть сдерживает страсть.",
 "snp4.16:21.1": "В этих явлениях устранив импульс,",
 "snp4.16:21.2": "Монах памятующий, хорошо освобождённый умом;",
 "snp4.16:21.3": "Своевременно он правильно явление исследуя,",
 "snp4.16:21.4": "Став единым, пусть рассеет тьму он”.",
 "snp4.16:21.5": "Сутта Сарипутта шестнадцатая.",
 "snp4.16:21.6": "Глава Аттхака Четвёртая.",
 "snp4.16:22.0": "Оглавление",
 "snp4.16:22.1": "Желание, и пещера, и злоба,",
 "snp4.16:22.2": "И чистый, и высшее старение;",
 "snp4.16:22.3": "Меттейя и Пасура,",
 "snp4.16:22.4": "Маганди, до-разрушения.",
 "snp4.16:23.1": "Ссора и две построения,",
 "snp4.16:23.2": "И снова туваттака;",
 "snp4.16:23.3": "Сутта с посохом-нападением высшая,",
 "snp4.16:23.4": "Старцем-спрошенным шестнадцать;",
 "snp4.16:23.5": "Так эти сутты,",
 "snp4.16:23.6": "все аттхакаваггические."
}
