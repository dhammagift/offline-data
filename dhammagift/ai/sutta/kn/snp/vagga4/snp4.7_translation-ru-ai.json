{
 "snp4.7:0.1": "Сутта Нипата 4.7",
 "snp4.7:0.2": "Тиссаметтейясутта",
 "snp4.7:1.1": "“Соединённому с соитием,",
 "snp4.7:1.2": "(так сказал уважаемый Тисса Меттейя)",
 "snp4.7:1.3": "Недовольство скажи, почтенный;",
 "snp4.7:1.4": "Услышав твоё наставление,",
 "snp4.7:1.5": "В уединении будем тренироваться”.",
 "snp4.7:2.1": "“Соединённому с соитием,",
 "snp4.7:2.2": "(Меттейя, — Благословенный)",
 "snp4.7:2.3": "Забывает и наставление;",
 "snp4.7:2.4": "И неправильно практикует,",
 "snp4.7:2.5": "Это в нём не-благородное.",
 "snp4.7:3.1": "Один прежде странствовав,",
 "snp4.7:3.2": "Соитие кто практикует;",
 "snp4.7:3.3": "Как повозка, шатающаяся, то в мире,",
 "snp4.7:3.4": "низким называют обывателя.",
 "snp4.7:4.1": "Слава и известность, что прежде,",
 "snp4.7:4.2": "уменьшается и его та;",
 "snp4.7:4.3": "И это увидев, пусть тренируется,",
 "snp4.7:4.4": "соитие чтобы оставить.",
 "snp4.7:5.1": "Намерениями охваченный он,",
 "snp4.7:5.2": "как жалкий зажжётся;",
 "snp4.7:5.3": "Услышав других шум,",
 "snp4.7:5.4": "смущённым бывает он таковым.",
 "snp4.7:6.1": "Затем оружия делает",
 "snp4.7:6.2": "чужими речами побуждаемый;",
 "snp4.7:6.3": "Это и есть его великая алчность,",
 "snp4.7:6.4": "лживость он вбирает.",
 "snp4.7:7.1": "Мудрецом признанный,",
 "snp4.7:7.2": "одинокое поведение установивший;",
 "snp4.7:7.3": "Но если и к соитию привязан,",
 "snp4.7:7.4": "как глупый изнуряется.",
 "snp4.7:8.1": "Эту недостаток-опасность узнав,",
 "snp4.7:8.2": "Мудрец — предыдущее и последующее здесь;",
 "snp4.7:8.3": "Одиночное странствие крепко пусть совершит,",
 "snp4.7:8.4": "Не следует практиковать соитие.",
 "snp4.7:9.1": "Уединение только пусть тренирует,",
 "snp4.7:9.2": "это у благородных высшее;",
 "snp4.7:9.3": "Из-за того себя лучшим пусть не считает,",
 "snp4.7:9.4": "тот — вблизи ниббаны.",
 "snp4.7:10.1": "У пустого мудреца, идущего,",
 "snp4.7:10.2": "в желаниях не-ожидающего;",
 "snp4.7:10.3": "Затопление переплывшего желают,",
 "snp4.7:10.4": "в желаниях увязшие люди”.",
 "snp4.7:10.5": "Тиссаметтейясутта седьмая."
}
