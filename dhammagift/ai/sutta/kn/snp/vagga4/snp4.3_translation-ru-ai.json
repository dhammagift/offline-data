{
 "snp4.3:0.1": "Сутта Нипата 4.3",
 "snp4.3:0.2": "Дуттхаттхакасутта",
 "snp4.3:1.1": "Говорят же злоумные иные,",
 "snp4.3:1.2": "А также же истинноумные говорят;",
 "snp4.3:1.3": "И спор возникший мудрец не приемлет,",
 "snp4.3:1.4": "Потому у мудреца нет суеты нигде.",
 "snp4.3:2.1": "Свой ведь взгляд как бы превзошёл,",
 "snp4.3:2.2": "Импульсом-ведомый, во вкусе утвердившись;",
 "snp4.3:2.3": "Сам завершённости делая,",
 "snp4.3:2.4": "Как ведь знает, так пусть говорит.",
 "snp4.3:3.1": "Кто свои нравственности-обеты человек,",
 "snp4.3:3.2": "Неспрошенный же другим объявляет;",
 "snp4.3:3.3": "Не-благородным явлением умелые того называют,",
 "snp4.3:3.4": "Кто себя самого объявляет.",
 "snp4.3:4.1": "Умиротворённый же монах, охлаждённый,",
 "snp4.3:4.2": "«Так-так» в нравственностях не хвастающий;",
 "snp4.3:4.3": "Того благородным явлением умелые называют,",
 "snp4.3:4.4": "У кого вздутостей нет нигде в мире.",
 "snp4.3:5.1": "Сконструированы составные у кого явления,",
 "snp4.3:5.2": "Предваряемые есть неочищенные;",
 "snp4.3:5.3": "Что в себе видит блага,",
 "snp4.3:5.4": "То опираясь, колеблющийся-покоя-зависимость.",
 "snp4.3:6.1": "Взглядов-укоренения ведь нелегко превзойти,",
 "snp4.3:6.2": "В явлениях определённость твёрдо схваченное;",
 "snp4.3:6.3": "Поэтому человек в тех привязанностях,",
 "snp4.3:6.4": "Отбрасывая и принимая явление.",
 "snp4.3:7.1": "У чистого ведь нет нигде в мире,",
 "snp4.3:7.2": "Сконструированного взгляда в существованиях-несуществованиях;",
 "snp4.3:7.3": "И иллюзию и самомнение отбросив, чистый,",
 "snp4.3:7.4": "Он куда пойдёт, не-приближающийся он.",
 "snp4.3:8.1": "Приближающийся ведь к явлениям приходит к спору,",
 "snp4.3:8.2": "Не-приближающегося каким образом речь скажет;",
 "snp4.3:8.3": "Мы или не-мы ведь не у него есть,",
 "snp4.3:8.4": "Отбросил он взгляд здесь и сейчас всецело.",
 "snp4.3:8.5": "Дуттхаттхакасутта Третья."
}
