{
 "snp4.1:0.1": "Сутта Нипата 4.1",
 "snp4.1:0.2": "Сутта Желания",
 "snp4.1:1.1": "Желание желающего,",
 "snp4.1:1.2": "если у того оно сбывается;",
 "snp4.1:1.3": "Воистину, радостно-умным становится,",
 "snp4.1:1.4": "получив смертный, что желает.",
 "snp4.1:2.1": "У того же желающего,",
 "snp4.1:2.2": "у кого импульс-рождённого существа;",
 "snp4.1:2.3": "Те желания угасают,",
 "snp4.1:2.4": "стрелой-пронзённый точно мнётся.",
 "snp4.1:3.1": "Который желания обходит,",
 "snp4.1:3.2": "змеёй точно ногой голову;",
 "snp4.1:3.3": "Тот эту прилипчивость в мире,",
 "snp4.1:3.4": "памятующий полностью преодолевает.",
 "snp4.1:4.1": "Поле, участок, золото или,",
 "snp4.1:4.2": "коров-коней, рабов-слуг;",
 "snp4.1:4.3": "Женщин, родню, многие желания,",
 "snp4.1:4.4": "который человек жадно желает.",
 "snp4.1:5.1": "Бессильные его сильными считают,",
 "snp4.1:5.2": "сокрушают его напасти;",
 "snp4.1:5.3": "То его боль сопровождает,",
 "snp4.1:5.4": "лодку разбитую точно водой.",
 "snp4.1:6.1": "Потому существо всегда памятующим,",
 "snp4.1:6.2": "желания пусть обходит;",
 "snp4.1:6.3": "Их оставив, пересечёт затопление,",
 "snp4.1:6.4": "лодку оттолкнув точно переплывший.",
 "snp4.1:6.5": "Сутта Желание завершена первая."
}
