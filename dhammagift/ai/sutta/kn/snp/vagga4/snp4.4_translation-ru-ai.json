{
 "snp4.4:0.1": "Сутта Нипата 4.4",
 "snp4.4:0.2": "Сутта о Чистом",
 "snp4.4:1.1": "Вижу я чистое, высшее, без болезней,",
 "snp4.4:1.2": "Увиденным очищение человека происходит;",
 "snp4.4:1.3": "Так понимая, высшим узнав,",
 "snp4.4:1.4": "Чисто-видящим так идёт знание.",
 "snp4.4:2.1": "Если увиденным очищение человека происходит,",
 "snp4.4:2.2": "Или знанием он покидает боль;",
 "snp4.4:2.3": "Иным он очищается, с-подпиткой,",
 "snp4.4:2.4": "Взгляд ведь его ведёт, так говорящего.",
 "snp4.4:3.1": "Не брахман иным очищение говорит,",
 "snp4.4:3.2": "В увиденном, услышанном, в нравственности, в почувствованном;",
 "snp4.4:3.3": "В благе и зле незапятнанный,",
 "snp4.4:3.4": "Самость-отбросивший, не здесь делающий.",
 "snp4.4:4.1": "Прежнее покинув, к другому привязаны,",
 "snp4.4:4.2": "Движению-следующие, те не пересекают привязанность;",
 "snp4.4:4.3": "Те схватывают, отбрасывают,",
 "snp4.4:4.4": "Как обезьяна ветку, отпуская, хватает.",
 "snp4.4:5.1": "Сам приняв обеты, существо,",
 "snp4.4:5.2": "В высокое-низкое идёт, сознаванием-связанный;",
 "snp4.4:5.3": "Знающий же, с ведами встретив явление,",
 "snp4.4:5.4": "Не в высокое-низкое идёт, широко-понимающий.",
 "snp4.4:6.1": "Он во всех явлениях без-вражды-ставший,",
 "snp4.4:6.2": "Что бы ни было увиденное или услышанное, почувствованное;",
 "snp4.4:6.3": "Того же видя открыто идущим,",
 "snp4.4:6.4": "Чем здесь в мире стал бы разделять.",
 "snp4.4:7.1": "Не разделяют, не предпочитают,",
 "snp4.4:7.2": "«Предельная чистота» — те не говорят;",
 "snp4.4:7.3": "Узел-поддерживания, связанный, отпустив,",
 "snp4.4:7.4": "Надежды не строят нигде в мире.",
 "snp4.4:8.1": "Предел-перешедший брахман, того нет,",
 "snp4.4:8.2": "Узнав ли, увидев ли, схваченное;",
 "snp4.4:8.3": "Не страстно-страстный, не бесстрастно-привязанный,",
 "snp4.4:8.4": "У него здесь нет высшего-схваченного.",
 "snp4.4:8.5": "Сутта о Чистом четвёртая."
}
