{
 "snp4.14:0.1": "Сутта Нипата 4.14",
 "snp4.14:0.2": "Туватакасутта",
 "snp4.14:1.1": "“Спрашиваю тебя, Солнца-родич,",
 "snp4.14:1.2": "Уединение и путь-покоя, великий провидец;",
 "snp4.14:1.3": "Как увидев, угасает монах,",
 "snp4.14:1.4": "Не поддерживая в мире что-либо”.",
 "snp4.14:2.1": "“Корень разрастания-сознав,",
 "snp4.14:2.2": "(так Благословенный)",
 "snp4.14:2.3": "Мудростью ‘я есмь’ всё пусть пресечёт;",
 "snp4.14:2.4": "Какое-либо цепляние внутри,",
 "snp4.14:2.5": "Их вычищением всегда памятующий пусть тренируется.",
 "snp4.14:3.1": "Что-либо явление если познаёт,",
 "snp4.14:3.2": "Внутри или же снаружи;",
 "snp4.14:3.3": "Тем силу пусть не делает,",
 "snp4.14:3.4": "Ведь то не угасание чистых сказано.",
 "snp4.14:4.1": "Лучшим тем пусть не мыслит,",
 "snp4.14:4.2": "Худшим или же равным;",
 "snp4.14:4.3": "Затронутый многообразными,",
 "snp4.14:4.4": "Само-мнение не разделяя пусть стоит.",
 "snp4.14:5.1": "Внутри лишь пусть успокоит,",
 "snp4.14:5.2": "Не от иного монах покоя пусть ищет;",
 "snp4.14:5.3": "Внутри успокоенного,",
 "snp4.14:5.4": "Нет самости, откуда ни-самости или.",
 "snp4.14:6.1": "В середине как океана,",
 "snp4.14:6.2": "Волна не рождается, стоящим становится;",
 "snp4.14:6.3": "Так стоящий, не-движимого,",
 "snp4.14:6.4": "Вздутия монах не должен делать нигде”.",
 "snp4.14:7.1": "“Провозгласил открыто-глазый,",
 "snp4.14:7.2": "Очевидное-явление, опасностей-устранение;",
 "snp4.14:7.3": "Практику скажи, достопочтенный,",
 "snp4.14:7.4": "Патимоккху или же самадхи”.",
 "snp4.14:8.1": "“Глазами не-шаткого,",
 "snp4.14:8.2": "От деревенской беседы пусть удержит ухо;",
 "snp4.14:8.3": "И вкусам не должен потакать,",
 "snp4.14:8.4": "И не должен считать своим что-либо в мире.",
 "snp4.14:9.1": "Касанием когда касаемого,",
 "snp4.14:9.2": "Плача монах не должен делать нигде;",
 "snp4.14:9.3": "И существования не должен желать,",
 "snp4.14:9.4": "И в страшных не должен дрожать.",
 "snp4.14:10.1": "Еды и также питья,",
 "snp4.14:10.2": "Закусок и также одежд;",
 "snp4.14:10.3": "Получив, накопления не должен делать,",
 "snp4.14:10.4": "И не должен тревожиться, их не получая.",
 "snp4.14:11.1": "Джхайящий, не-шатконогий,",
 "snp4.14:11.2": "Пусть прекратит беспокойство, не будь беспечным;",
 "snp4.14:11.3": "И на сидениях, на лежаниях,",
 "snp4.14:11.4": "В малошумных монах пусть пребывает.",
 "snp4.14:12.1": "Сон не должен преумножать,",
 "snp4.14:12.2": "Бодрствование пусть практикует, пылкий;",
 "snp4.14:12.3": "Вялость, обман, смех, игру,",
 "snp4.14:12.4": "Совокупление пусть оставит с украшениями.",
 "snp4.14:13.1": "Атхарвану, сновидение, знаки,",
 "snp4.14:13.2": "Не устанавливает и также созвездие;",
 "snp4.14:13.3": "Крик и зачатие,",
 "snp4.14:13.4": "Лечение мой (последователь) пусть не практикует.",
 "snp4.14:14.1": "От порицания пусть не дрожит,",
 "snp4.14:14.2": "Не возгордится похваленный монах;",
 "snp4.14:14.3": "Корыстолюбие вместе со скупостью,",
 "snp4.14:14.4": "Гнев и клевету пусть отбросит.",
 "snp4.14:15.1": "В купле-продаже пусть не стоит,",
 "snp4.14:15.2": "Порицания монах пусть не делает нигде;",
 "snp4.14:15.3": "И в деревне пусть не привязывается,",
 "snp4.14:15.4": "Из-за желания получения пусть людей не заговаривает.",
 "snp4.14:16.1": "И хвастливым пусть не будет монах,",
 "snp4.14:16.2": "И речи намеренной пусть не говорит;",
 "snp4.14:16.3": "Дерзости пусть не учится,",
 "snp4.14:16.4": "Речи спорной пусть не ведет.",
 "snp4.14:17.1": "В лживости пусть не ведется,",
 "snp4.14:17.2": "Сознательный обманов пусть не делает;",
 "snp4.14:17.3": "И жизнью, пониманием,",
 "snp4.14:17.4": "Принципами-практикой другого пусть не презирает.",
 "snp4.14:18.1": "Услышав от разгневанного много речи,",
 "snp4.14:18.2": "Шраманов или обычных людей;",
 "snp4.14:18.3": "Грубым он не должен-отвечать,",
 "snp4.14:18.4": "Ведь успокоенные не-враждуют.",
 "snp4.14:19.1": "И это явление (Дхамму) узнав,",
 "snp4.14:19.2": "Исследуя, монах, всегда памятующий, тренируется;",
 "snp4.14:19.3": "“Успокоенные” — успокоение (ниббути) узнав,",
 "snp4.14:19.4": "В учении Готамы не должен-ослаблять.",
 "snp4.14:20.1": "Превзошедший ведь он, непревзойдённый,",
 "snp4.14:20.2": "Самовидящий явление (Дхамму), не-по-преданию-увидевший;",
 "snp4.14:20.3": "Поэтому в учении того Благословенного,",
 "snp4.14:20.4": "Старательный, всегда с почтением пусть учится».",
 "snp4.14:20.5": "Туватакасутта четырнадцатая."
}
