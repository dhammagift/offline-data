{
 "snp4.10:0.1": "Сутта Нипата 4.10",
 "snp4.10:0.2": "Сутта до-распада",
 "snp4.10:1.1": "“Как видящий, какого принципа,",
 "snp4.10:1.2": "успокоенным называется;",
 "snp4.10:1.3": "То мне, Готама, поведай,",
 "snp4.10:1.4": "спрошенный о высшем человеке”.",
 "snp4.10:2.1": "“Без-цепляния до распада,",
 "snp4.10:2.2": "(так Благословенный)",
 "snp4.10:2.3": "На прошедшее-грядущее не опирающийся;",
 "snp4.10:2.4": "В середине не подсчитываемый,",
 "snp4.10:2.5": "У того нет предпочтения.",
 "snp4.10:3.1": "Без-гнева, без-трепета,",
 "snp4.10:3.2": "не хвастлив, не суетлив;",
 "snp4.10:3.3": "Мерно-говорящий, не взволнованный,",
 "snp4.10:3.4": "Он есть — сдержанный в речи мудрец.",
 "snp4.10:4.1": "Без-привязанности к грядущему,",
 "snp4.10:4.2": "прошедшее не оплакивает;",
 "snp4.10:4.3": "Разъединение видящий в касаниях,",
 "snp4.10:4.4": "и во взглядах не ведётся.",
 "snp4.10:5.1": "Уединённый, не-лживый,",
 "snp4.10:5.2": "не-желающий, не-скупой;",
 "snp4.10:5.3": "Ненапыщенный, не-отвратительный,",
 "snp4.10:5.4": "и в клевете не занятый.",
 "snp4.10:6.1": "В приятном не-опьянённый,",
 "snp4.10:6.2": "и в высокомерии не занятый;",
 "snp4.10:6.3": "Нежный и красноречивый,",
 "snp4.10:6.4": "не верующий, не отстраняется.",
 "snp4.10:7.1": "Из-за желания приобретения не обучается,",
 "snp4.10:7.2": "и при не-приобретении не возмущается;",
 "snp4.10:7.3": "Без-враждебности и к цеплянию,",
 "snp4.10:7.4": "вкусами не увлекается.",
 "snp4.10:8.1": "Прямо-смотрящий, всегда памятующий,",
 "snp4.10:8.2": "в мире не считает равным;",
 "snp4.10:8.3": "Не высший, не низший,",
 "snp4.10:8.4": "у того нет вздутий.",
 "snp4.10:9.1": "У кого опоры нет,",
 "snp4.10:9.2": "познав явление, не-опирающийся;",
 "snp4.10:9.3": "К бхаве или к разлучению,",
 "snp4.10:9.4": "цепляния у кого не обнаруживается.",
 "snp4.10:10.1": "Того называю успокоенным,",
 "snp4.10:10.2": "В желаниях не-ожидающий;",
 "snp4.10:10.3": "Узлы у того не обнаруживаются,",
 "snp4.10:10.4": "Переплыл он липкость.",
 "snp4.10:11.1": "Не у того сыны, скот,",
 "snp4.10:11.2": "Поле и участок обнаруживаются;",
 "snp4.10:11.3": "Самость или же не-самость,",
 "snp4.10:11.4": "в том не обретается.",
 "snp4.10:12.1": "Чем его назвали бы обыватели,",
 "snp4.10:12.2": "а также шраманы-брахманы;",
 "snp4.10:12.3": "То у него не-предвзято,",
 "snp4.10:12.4": "Поэтому в речах не колеблется.",
 "snp4.10:13.1": "Без-страсти, без-скупости,",
 "snp4.10:13.2": "Не о высших говорит мудрец;",
 "snp4.10:13.3": "Не о равных, не о низших,",
 "snp4.10:13.4": "Каппу не строит, не-каппийный.",
 "snp4.10:14.1": "У кого на свете своего нет,",
 "snp4.10:14.2": "И о не-сущем не страдает;",
 "snp4.10:14.3": "И к явлениям не идёт,",
 "snp4.10:14.4": "Он есть — умиротворённым называется”.",
 "snp4.10:14.5": "Сутта до-распада десятая."
}
