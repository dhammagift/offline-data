{
 "snp4.6:0.1": "Сутта Нипата 4.6",
 "snp4.6:0.2": "Сутта Старость",
 "snp4.6:1.1": "Мала ведь жизнь эта,",
 "snp4.6:1.2": "Меньше ста лет умирают;",
 "snp4.6:1.3": "И если кто сверх живёт,",
 "snp4.6:1.4": "То и тот от старости умирает.",
 "snp4.6:2.1": "Страдают люди о том, что считают своим,",
 "snp4.6:2.2": "Ведь не бывают постоянными владения;",
 "snp4.6:2.3": "Разлука-существование только это,",
 "snp4.6:2.4": "Так увидев, в доме не живи.",
 "snp4.6:3.1": "Смертью также то оставляется,",
 "snp4.6:3.2": "Что человек «моё» так считает;",
 "snp4.6:3.3": "И это поняв, мудрец,",
 "snp4.6:3.4": "К моему-бытию не склоняется приверженный.",
 "snp4.6:4.1": "Как во сне встреченное,",
 "snp4.6:4.2": "Пробудившись, человек не видит;",
 "snp4.6:4.3": "Так и дорогих людей,",
 "snp4.6:4.4": "Умерших, ушедших, не видит.",
 "snp4.6:5.1": "Увидены и услышаны те люди,",
 "snp4.6:5.2": "Чьё имя это произносится;",
 "snp4.6:5.3": "Только имя остаётся,",
 "snp4.6:5.4": "Обозначение умершего существа.",
 "snp4.6:6.1": "Страдание-плач-скупость,",
 "snp4.6:6.2": "Не оставляют жадные к тому, что считают своим;",
 "snp4.6:6.3": "Поэтому мудрецы владение,",
 "snp4.6:6.4": "Оставив, странствуют видящие безопасное.",
 "snp4.6:7.1": "Уединённо-ходящего монаха,",
 "snp4.6:7.2": "Пребывающего в уединённом сидении;",
 "snp4.6:7.3": "Согласием называют то его,",
 "snp4.6:7.4": "Кто самость в становлении не показывает.",
 "snp4.6:8.1": "Везде мудрец, не опирающийся,",
 "snp4.6:8.2": "Ни милого не делает, ни немилого;",
 "snp4.6:8.3": "В нём плач и скупость,",
 "snp4.6:8.4": "Как на листе вода не прилипает.",
 "snp4.6:9.1": "Как капля воды на лотосе,",
 "snp4.6:9.2": "На лотосе вода не прилипает;",
 "snp4.6:9.3": "Так мудрец не прилипает,",
 "snp4.6:9.4": "А именно к виденному, слышанному или ощущаемому.",
 "snp4.6:10.1": "Очищенный ведь тем не мнит,",
 "snp4.6:10.2": "А именно виденным, слышанным или ощущаемым;",
 "snp4.6:10.3": "Не через иное чистоты желает,",
 "snp4.6:10.4": "Ведь он ни очаровывается, ни разочаровывается.",
 "snp4.6:10.5": "Сутта о старении шестая."
}
