{
 "snp4.15:0.1": "Сутта Нипата 4.15",
 "snp4.15:0.2": "Сутта с палкой-нападения",
 "snp4.15:1.1": "“С палкой-нападения тревога рождена,",
 "snp4.15:1.2": "людей видите сбившихся в кучу;",
 "snp4.15:1.3": "Встревоженность расскажу,",
 "snp4.15:1.4": "как встревоженным я был.",
 "snp4.15:2.1": "Трепещущее поколение увидев,",
 "snp4.15:2.2": "как рыб в малой воде;",
 "snp4.15:2.3": "Друг с другом враждуя,",
 "snp4.15:2.4": "увидев, меня тревога охватила.",
 "snp4.15:3.1": "Повсюду несущностный свет,",
 "snp4.15:3.2": "все направления взбудоражены;",
 "snp4.15:3.3": "Желая существования себе,",
 "snp4.15:3.4": "не увидел я незавершённого.",
 "snp4.15:4.1": "В конце же враждуя,",
 "snp4.15:4.2": "увидев, неприязнь у меня возникла;",
 "snp4.15:4.3": "Тогда здесь стрелу я увидел,",
 "snp4.15:4.4": "трудно-видимую, в сердце опирающуюся.",
 "snp4.15:5.1": "Какой стрелой пронзённый,",
 "snp4.15:5.2": "во всех направлениях разбегается;",
 "snp4.15:5.3": "Ту самую стрелу вытащив,",
 "snp4.15:5.4": "не бежит и не тонет.",
 "snp4.15:6.1": "Там тренировки воспеваются,",
 "snp4.15:6.2": "которые на свете привязанности.",
 "snp4.15:6.3": "В них занятым пусть не будет,",
 "snp4.15:6.4": "пронзив всецело желания;",
 "snp4.15:6.5": "Тренируется в ниббане своей.",
 "snp4.15:7.1": "Правдивым пусть будет, ненапыщенным,",
 "snp4.15:7.2": "не-лживым, без-клеветы;",
 "snp4.15:7.3": "Без-гнева, корыстолюбия-плохое,",
 "snp4.15:7.4": "разнообразие пусть преодолеет мудрец.",
 "snp4.15:8.1": "Сон, вялость пусть победит, апатию,",
 "snp4.15:8.2": "с беспечностью пусть не пребывает;",
 "snp4.15:8.3": "в пере-самомнении пусть не стоит,",
 "snp4.15:8.4": "с умом-настроенным-на-ниббану человек.",
 "snp4.15:9.1": "В лживости пусть не ведется,",
 "snp4.15:9.2": "к материи привязанность пусть не делает;",
 "snp4.15:9.3": "И самомнение пусть полностью познает,",
 "snp4.15:9.4": "от насилия воздержавшись, пусть живёт.",
 "snp4.15:10.1": "К старому пусть не радуется,",
 "snp4.15:10.2": "к новому приязни пусть не делает;",
 "snp4.15:10.3": "Об исчезающем пусть не печалится,",
 "snp4.15:10.4": "к воздуху привязанным пусть не будет.",
 "snp4.15:11.1": "Алчность называю большим-потоком,",
 "snp4.15:11.2": "Стремление называю бормотанием;",
 "snp4.15:11.3": "Объект-основание — конструированием,",
 "snp4.15:11.4": "Желания-топь трудно-переходима.",
 "snp4.15:12.1": "От правды не отклонившись, мудрец,",
 "snp4.15:12.2": "на суше стоит брахман;",
 "snp4.15:12.3": "Всё он оставляет,",
 "snp4.15:12.4": "Он есть — умиротворённым называется.",
 "snp4.15:13.1": "Он есть — знающий, он сведущий,",
 "snp4.15:13.2": "Познав явление, не-опирающийся;",
 "snp4.15:13.3": "Правильно он в мире двигаясь,",
 "snp4.15:13.4": "Не желает здесь никого.",
 "snp4.15:14.1": "Кто здесь желания пересек-превзошел,",
 "snp4.15:14.2": "Привязанность в мире трудно-преодолимую;",
 "snp4.15:14.3": "Не страдает он, не тревожится,",
 "snp4.15:14.4": "С отрезанным потоком, без-привязки.",
 "snp4.15:15.1": "Что прежде — то осуши,",
 "snp4.15:15.2": "Позади тебе пусть не будет ничего;",
 "snp4.15:15.3": "В середине если не схватишь,",
 "snp4.15:15.4": "Умиротворённым будешь жить.",
 "snp4.15:16.1": "Полностью в имени-материи,",
 "snp4.15:16.2": "У которого нет моё-присвоение;",
 "snp4.15:16.3": "и из-за не-сущего не страдает,",
 "snp4.15:16.4": "Он есть — в мире не стареет.",
 "snp4.15:17.1": "У которого нет «это моё»,",
 "snp4.15:17.2": "И у других также ничего;",
 "snp4.15:17.3": "Моё-присвоение он не-испытывая,",
 "snp4.15:17.4": "«Нет моего» — не страдает.",
 "snp4.15:18.1": "Не-недовольный, не-жадный,",
 "snp4.15:18.2": "Не-колеблющийся, во всём равный;",
 "snp4.15:18.3": "То-благо-смысл-цель объявляю,",
 "snp4.15:18.4": "Спрошенный о не-колеблющемся.",
 "snp4.15:19.1": "У не-движимого понимающего,",
 "snp4.15:19.2": "Нет никакой от-составления-отказа;",
 "snp4.15:19.3": "Отвернулся он от-усилий-напряжения,",
 "snp4.15:19.4": "Защищённое видит повсюду.",
 "snp4.15:20.1": "Не о равных, не о низших,",
 "snp4.15:20.2": "Не о высших говорит мудрец;",
 "snp4.15:20.3": "Успокоенный он без-скупости,",
 "snp4.15:20.4": "Не-цепляет не-отбрасывает”.",
 "snp4.15:20.5": "Сутта с палкой-нападения пятнадцатая."
}
