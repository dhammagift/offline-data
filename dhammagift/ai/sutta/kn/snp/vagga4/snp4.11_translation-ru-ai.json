{
 "snp4.11:0.1": "Сутта Нипата 4.11",
 "snp4.11:0.2": "Калахавивадасутта",
 "snp4.11:1.1": "“Откуда возникшие ссоры и споры,",
 "snp4.11:1.2": "Плач-страдание и скупость вместе;",
 "snp4.11:1.3": "Гордость-высокомерие и клевета вместе,",
 "snp4.11:1.4": "Откуда возникшие они, вот скажи”.",
 "snp4.11:2.1": "“От приятного возникшие ссоры и споры,",
 "snp4.11:2.2": "Плач-страдание и скупость вместе;",
 "snp4.11:2.3": "Гордость-высокомерие и клевета вместе,",
 "snp4.11:2.4": "Со скупостью связанные ссоры и споры;",
 "snp4.11:2.5": "И у спорящих клевета”.",
 "snp4.11:3.1": "“Приятное в мире откуда основанием,",
 "snp4.11:3.2": "И какие корыстолюбия бродят в мире;",
 "snp4.11:3.3": "Надежда и достижение откуда основанием,",
 "snp4.11:3.4": "Которые для будущего человека бывают”.",
 "snp4.11:4.1": "“Импульс основанием приятного в мире,",
 "snp4.11:4.2": "И какие корыстолюбия бродят в мире;",
 "snp4.11:4.3": "Надежда и достижение отсюда основанием,",
 "snp4.11:4.4": "Которые для будущего человека бывают”.",
 "snp4.11:5.1": "“Импульс в мире откуда основанием,",
 "snp4.11:5.2": "И решения откуда возникшие;",
 "snp4.11:5.3": "Злость и ложь и сомнение,",
 "snp4.11:5.4": "И какие явления шраманом сказаны”.",
 "snp4.11:6.1": "“Приятное и дискомфорт что называют в мире,",
 "snp4.11:6.2": "То опираясь возникает импульс;",
 "snp4.11:6.3": "В объектах увидев разлучение и бытие,",
 "snp4.11:6.4": "Решение делает человек в мире.",
 "snp4.11:7.1": "Злость и ложь и сомнение,",
 "snp4.11:7.2": "Эти явления двойкой только будучи;",
 "snp4.11:7.3": "Сомневающийся, для знания-пути тренируется,",
 "snp4.11:7.4": "Узнав, изложены шраманом явления”.",
 "snp4.11:8.1": "“Комфорт и дискомфорт — откуда основание,",
 "snp4.11:8.2": "В чём отсутствующем не бывают эти;",
 "snp4.11:8.3": "Разлучение и существование — и это вот благо-смысл-цель,",
 "snp4.11:8.4": "Это мне объясни, откуда основание”.",
 "snp4.11:9.1": "“Касание-основание комфорта и дискомфорта,",
 "snp4.11:9.2": "При касании отсутствующем не бывают эти;",
 "snp4.11:9.3": "Разлучение и существование — и это вот благо-смысл-цель,",
 "snp4.11:9.4": "Это тебе объясняю отсюда-основание”.",
 "snp4.11:10.1": "“Касание в мире откуда основание,",
 "snp4.11:10.2": "И удерживания также откуда возникшие;",
 "snp4.11:10.3": "В чём отсутствующем нет моё-моё,",
 "snp4.11:10.4": "В чём исчезнувшем не касаются касания”.",
 "snp4.11:11.1": "“Имя и образ — исходя из этого касание,",
 "snp4.11:11.2": "Желания-основания удерживания;",
 "snp4.11:11.3": "При желании несуществующем нет моё-моё,",
 "snp4.11:11.4": "При образе исчезнувшем не касаются касания”.",
 "snp4.11:12.1": "“Как соединившемуся исчезает образ,",
 "snp4.11:12.2": "Приятное и боль — и как исчезает;",
 "snp4.11:12.3": "Это мне объясни, как исчезает,",
 "snp4.11:12.4": "То узнаем — так моё ум-представление было”.",
 "snp4.11:13.1": "“Не сознавательно-сознающий и не бессознательно-сознающий,",
 "snp4.11:13.2": "И не не-сознающий и не исчезнувше-сознающий;",
 "snp4.11:13.3": "Так соединившемуся исчезает образ,",
 "snp4.11:13.4": "Сознавание-основание ведь разрастание-обозначения”.",
 "snp4.11:14.1": "“Что тебя спросили мы — изложил ты нам,",
 "snp4.11:14.2": "Другое тебя спросим мы — ну-ка скажи;",
 "snp4.11:14.3": "До-этого-предела вершиной называют некоторые,",
 "snp4.11:14.4": "Яккхи чистоту здесь мудрецы;",
 "snp4.11:14.5": "Или же иное называют от-этого”.",
 "snp4.11:15.1": "“До-этого-предела вершиной называют некоторые,",
 "snp4.11:15.2": "Яккхи чистоту здесь мудрецы;",
 "snp4.11:15.3": "У тех же некоторые учение называют,",
 "snp4.11:15.4": "Без-остатка-подпитки умелые знающие.",
 "snp4.11:16.1": "И эти узнав как опирающиеся,",
 "snp4.11:16.2": "Узнав, мудрец опоры тот исследователь;",
 "snp4.11:16.3": "Узнав, высвободившийся не в спор вступает,",
 "snp4.11:16.4": "К-существованию-не-существованию не приходит знаток”.",
 "snp4.11:16.5": "Калахавивадасутта одиннадцатая."
}
