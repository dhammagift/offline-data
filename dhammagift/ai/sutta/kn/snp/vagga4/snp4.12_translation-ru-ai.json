{
 "snp4.12:0.1": "Сутта Нипата 4.12",
 "snp4.12:0.2": "Сутта Малого Стечения",
 "snp4.12:1.1": "“Свою-свою-воззрение-окружённые,",
 "snp4.12:1.2": "Споря разное благотворным называют;",
 "snp4.12:1.3": "Кто так знает, тот знает явление,",
 "snp4.12:1.4": "Это отвергая, неполноценен он.",
 "snp4.12:2.1": "Так, споря, спорят,",
 "snp4.12:2.2": "‘Глуп другой, неблаготворен’ — и говорят;",
 "snp4.12:2.3": "Истинна ли речь какая из этих,",
 "snp4.12:2.4": "Все ведь эти благотворно-говорящие”.",
 "snp4.12:3.1": "“Если чужого явления не принимая,",
 "snp4.12:3.2": "Глупым-недоумком становится, низшим-пониманием;",
 "snp4.12:3.3": "Все ведь глупые, совсем-низшие-пониманием,",
 "snp4.12:3.4": "Все эти воззрением-окружённые.",
 "snp4.12:4.1": "Если же своим-воззрением не очищены,",
 "snp4.12:4.2": "Совершенно-чистые-пониманием, благотворные, разумные;",
 "snp4.12:4.3": "У них никого нет ущербного-пониманием,",
 "snp4.12:4.4": "Воззрение ведь у них также так совершенно.",
 "snp4.12:5.1": "Не говорю я это ‘так-истинно’,",
 "snp4.12:5.2": "Что говорят глупые друг другу взаимно;",
 "snp4.12:5.3": "Своё своё воззрение делают истинным,",
 "snp4.12:5.4": "Потому ведь глупым другого считают”.",
 "snp4.12:6.1": "“Что называют истинным ‘так-истинно’ одни,",
 "snp4.12:6.2": "То называют другие пустым, ложным”;",
 "snp4.12:6.3": "Так, погрузившись, спорят,",
 "snp4.12:6.4": "Почему не одно шраманы говорят”.",
 "snp4.12:7.1": "“Одна ведь истина, второй нет,",
 "snp4.12:7.2": "В которой поколение не спорит, зная;",
 "snp4.12:7.3": "Разные те истины сами восхваляют,",
 "snp4.12:7.4": "Потому не одно шраманы говорят”.",
 "snp4.12:8.1": "“Почему же истины говорят разные,",
 "snp4.12:8.2": "Спорщики, умелые в утверждениях;",
 "snp4.12:8.3": "Истины услышанные многие разные,",
 "snp4.12:8.4": "Или же они рассуждение следуют?”.",
 "snp4.12:9.1": "“Вовсе не истины многие разные,",
 "snp4.12:9.2": "Кроме сознавания постоянные в мире;",
 "snp4.12:9.3": "Рассуждение же во взглядах настроив,",
 "snp4.12:9.4": "Истина ложь — двойную природу говорят.",
 "snp4.12:10.1": "В видимом, слышимом, в принципах, в ощущаемом,",
 "snp4.12:10.2": "На это опираясь, видящий превосходство;",
 "snp4.12:10.3": "В решении встав, посмеиваясь,",
 "snp4.12:10.4": "Глупый другой — неумелый, — так говорит.",
 "snp4.12:11.1": "Чем глупым другого считает,",
 "snp4.12:11.2": "Тем себя умелым так говорит;",
 "snp4.12:11.3": "Сам собой он умелый в утверждениях,",
 "snp4.12:11.4": "Другого презирает — то же самое говорит.",
 "snp4.12:12.1": "Чрезмерным взглядом он охвачен,",
 "snp4.12:12.2": "Самомнением опьянён, полным себя мнит;",
 "snp4.12:12.3": "Сам собой, сам, умом окроплённый,",
 "snp4.12:12.4": "Взгляд ведь тот его так завершён.",
 "snp4.12:13.1": "Если же другого речью он принижен,",
 "snp4.12:13.2": "То сам он становится приниженным в понимании;",
 "snp4.12:13.3": "Если же сам он знаток-цели, мудрый,",
 "snp4.12:13.4": "То нет никого незрелого среди шраманов.",
 "snp4.12:14.1": "Иное, чем это, кто провозглашает явлением,",
 "snp4.12:14.2": "Упустили чистоту — они несовершенны;",
 "snp4.12:14.3": "Так и сектанты по-разному говорят,",
 "snp4.12:14.4": "Ведь страстью к своему-взгляду они увлечены.",
 "snp4.12:15.1": "«Здесь только чистота» — так утверждают,",
 "snp4.12:15.2": "В других явлениях чистоты не видят;",
 "snp4.12:15.3": "Так и сектанты по-разному утвердились,",
 "snp4.12:15.4": "В своём-же-деле там крепко говоря.",
 "snp4.12:16.1": "Или в своём-же-деле крепко говоря,",
 "snp4.12:16.2": "Кого же тут незрелым другого сочтёт;",
 "snp4.12:16.3": "Сам ведь он вражду навлечёт,",
 "snp4.12:16.4": "Другого называя незрелым, не-чистоты-явлением.",
 "snp4.12:17.1": "В суждении утвердившись, сам измерив,",
 "snp4.12:17.2": "В мире выше спор ведёт;",
 "snp4.12:17.3": "Оставив все суждения,",
 "snp4.12:17.4": "Вражду не совершает человек в мире”.",
 "snp4.12:17.5": "Сутта Малого Стечения двенадцатая."
}
