{
 "iti66:0.1": "Итивуттака 66",
 "iti66:0.2": "Тройной раздел",
 "iti66:0.3": "Вторая Глава",
 "iti66:0.4": "Сутта Чистоты",
 "iti66:1.1": "Сказано это Благословенным, сказано арахантом, так мной услышано:",
 "iti66:2.1": "“Есть три, монахи, чистоты.",
 "iti66:2.2": "Какие три?",
 "iti66:2.3": "Тело-чистота, речь-чистота, ум-чистота—",
 "iti66:2.4": "эти три, монахи, чистоты”.",
 "iti66:2.5": "Этот смысл Благословенный сказал.",
 "iti66:2.6": "И здесь это говорится:",
 "iti66:3.1": "“Тело-чистый, речь-чистый,",
 "iti66:3.2": "ум-чистый, без-истечений;",
 "iti66:3.3": "Чистого чистотой-наделённого,",
 "iti66:3.4": "называют всё-отбрасывающим”.",
 "iti66:4.1": "Этот смысл также сказан Благословенным, так мной услышано.",
 "iti66:4.2": "Седьмая."
}
