{
 "iti63:0.1": "Итивуттака 63",
 "iti63:0.2": "Тройной раздел",
 "iti63:0.3": "Вторая Глава",
 "iti63:0.4": "Сутта о временах",
 "iti63:1.1": "Сказано это Благословенным, сказано арахантом, так мной услышано:",
 "iti63:2.1": "“Три эти, монахи, времени.",
 "iti63:2.2": "Какие три?",
 "iti63:2.3": "Прошедшее время, грядущее время, текущее время —",
 "iti63:2.4": "эти три, монахи, времени”.",
 "iti63:2.5": "Этот смысл Благословенный сказал.",
 "iti63:2.6": "И здесь это говорится:",
 "iti63:3.1": "“Обозначаемое-сознающие существа,",
 "iti63:3.2": "в обозначаемом утверждённые;",
 "iti63:3.3": "Обозначаемое не поняв всесторонне,",
 "iti63:3.4": "в связь входят со смертью.",
 "iti63:4.1": "Обозначаемое же всесторонне поняв,",
 "iti63:4.2": "описателя не обдумывает;",
 "iti63:4.3": "Коснувшись освобождения умом-мышлением,",
 "iti63:4.4": "пути-к-покою непревзойдённого.",
 "iti63:5.1": "Он есть — описанием-наделённый,",
 "iti63:5.2": "умиротворённый, в умиротворения-основе радующийся;",
 "iti63:5.3": "Различая следующий, установленный в Дхамме,",
 "iti63:5.4": "в подсчёт не идёт сведущий”.",
 "iti63:6.1": "Этот смысл также сказан Благословенным, так мной услышано.",
 "iti63:6.2": "Четвёртая."
}
