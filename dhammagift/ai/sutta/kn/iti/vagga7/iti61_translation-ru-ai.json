{
 "iti61:0.1": "Итивуттака 61",
 "iti61:0.2": "Тройной раздел",
 "iti61:0.3": "Вторая Глава",
 "iti61:0.4": "Сутта Глаза",
 "iti61:1.1": "Сказано это Благословенным, сказано арахантом, так мной услышано:",
 "iti61:2.1": "“Эти три, монахи, глаза.",
 "iti61:2.2": "Какие три?",
 "iti61:2.3": "Плоти-глаз, небесный-глаз, понимание-глаз—",
 "iti61:2.4": "вот эти, монахи, три глаза”.",
 "iti61:2.5": "Этот смысл Благословенный сказал.",
 "iti61:2.6": "И здесь это говорится:",
 "iti61:3.1": "“Плоти-глаз, небесный-глаз,",
 "iti61:3.2": "понимание-глаз непревзойденное;",
 "iti61:3.3": "Эти три глаза,",
 "iti61:3.4": "возвестил человек-высочайший.",
 "iti61:4.1": "Плоти-глаза возникновение,",
 "iti61:4.2": "путь небесного глаза;",
 "iti61:4.3": "Когда знание возникло,",
 "iti61:4.4": "понимание-глаз непревзойденное;",
 "iti61:4.5": "Которого глаза обретением,",
 "iti61:4.6": "от всей боли освобождается”.",
 "iti61:5.1": "Этот смысл также сказан Благословенным, так мной услышано.",
 "iti61:5.2": "Вторая."
}
