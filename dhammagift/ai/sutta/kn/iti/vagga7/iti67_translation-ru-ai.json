{
 "iti67:0.1": "Итивуттака 67",
 "iti67:0.2": "Тройной раздел",
 "iti67:0.3": "Вторая Глава",
 "iti67:0.4": "Сутта Монеия",
 "iti67:1.1": "Сказано это Благословенным, сказано арахантом, так мной услышано:",
 "iti67:2.1": "“Эти три, монахи, монеии.",
 "iti67:2.2": "Какие три?",
 "iti67:2.3": "Тело-безмолвие, речь-безмолвие, ум-безмолвие—",
 "iti67:2.4": "вот эти, монахи, три безмолвия”.",
 "iti67:2.5": "Этот смысл Благословенный сказал.",
 "iti67:2.6": "И здесь это говорится:",
 "iti67:3.1": "“Тело-безмолвного, речь-безмолвного,",
 "iti67:3.2": "ум-безмолвного, без-истечений;",
 "iti67:3.3": "Мудреца, монеией обладающего,",
 "iti67:3.4": "называют смывшим плохое”.",
 "iti67:4.1": "Этот смысл также сказан Благословенным, так мной услышано.",
 "iti67:4.2": "Восьмая."
}
