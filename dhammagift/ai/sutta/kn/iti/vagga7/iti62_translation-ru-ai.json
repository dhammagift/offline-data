{
 "iti62:0.1": "Итивуттака 62",
 "iti62:0.2": "Тройной раздел",
 "iti62:0.3": "Вторая Глава",
 "iti62:0.4": "Сутта Способностей",
 "iti62:1.1": "Сказано это Благословенным, сказано арахантом, так мной услышано:",
 "iti62:2.1": "“Эти три, монахи, способности.",
 "iti62:2.2": "Какие три?",
 "iti62:2.3": "Способность ‘я узнаю ещё-не-узнанное’, способность знания, способность знающего—",
 "iti62:2.4": "вот эти, монахи, три способности”.",
 "iti62:2.5": "Этот смысл Благословенный сказал.",
 "iti62:2.6": "И здесь это говорится:",
 "iti62:3.1": "“Ученика, обучающегося,",
 "iti62:3.2": "прямого-пути следующего;",
 "iti62:3.3": "В исчерпании первое знание,",
 "iti62:3.4": "затем окончательное знание непосредственно.",
 "iti62:4.1": "Затем окончательно-освобождённого,",
 "iti62:4.2": "знание же есть такого;",
 "iti62:4.3": "Неколебимо моё освобождение,",
 "iti62:4.4": "бхава-связывания исчерпанием.",
 "iti62:5.1": "Он есть — наделенный способностями,",
 "iti62:5.2": "умиротворённый, в умиротворения-основе радующийся;",
 "iti62:5.3": "Несёт последнее тело,",
 "iti62:5.4": "победив Мару с его свитой”.",
 "iti62:6.1": "Этот смысл также сказан Благословенным, так мной услышано.",
 "iti62:6.2": "Третья."
}
