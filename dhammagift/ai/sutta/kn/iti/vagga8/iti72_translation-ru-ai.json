{
 "iti72:0.1": "Итивуттака 72",
 "iti72:0.2": "Тройной раздел",
 "iti72:0.3": "Раздел Третий",
 "iti72:0.4": "Сутта Спасения",
 "iti72:1.1": "Сказано это Благословенным, сказано арахантом, так мной услышано:",
 "iti72:2.1": "“Три эти, монахи, спасительные дхату.",
 "iti72:2.2": "Какие три?",
 "iti72:2.3": "Желаний это спасение, то есть отречение, образов это спасение, то есть без-образное, а что-либо существующее составное зависимо-возникшее — устранение тому спасение —",
 "iti72:2.4": "эти три, монахи, спасительные дхату”.",
 "iti72:2.5": "Этот смысл Благословенный сказал.",
 "iti72:2.6": "И здесь это говорится:",
 "iti72:3.1": "“Желаний-спасение узнав,",
 "iti72:3.2": "и образов преодоление;",
 "iti72:3.3": "Всех-составляющих-успокоение,",
 "iti72:3.4": "касаясь, пылкий всегда.",
 "iti72:4.1": "Он ведь правильновидящий монах,",
 "iti72:4.2": "когда от этого высвобождается;",
 "iti72:4.3": "Прямым знанием завершённый, умиротворённый,",
 "iti72:4.4": "вот тот связь превзошедший мудрец”.",
 "iti72:5.1": "Этот смысл также сказан Благословенным, так мной услышано.",
 "iti72:5.2": "Третья."
}
