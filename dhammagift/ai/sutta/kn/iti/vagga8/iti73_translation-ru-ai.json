{
 "iti73:0.1": "Итивуттака 73",
 "iti73:0.2": "Тройной раздел",
 "iti73:0.3": "Раздел Третий",
 "iti73:0.4": "Сутта о более спокойном",
 "iti73:1.1": "Сказано это Благословенным, сказано арахантом, так мной услышано:",
 "iti73:2.1": "“Объекты, монахи, без-объектности более спокойны, без-объектности устранение более спокойно”.",
 "iti73:2.2": "Этот смысл Благословенный сказал.",
 "iti73:2.3": "И здесь это говорится:",
 "iti73:3.1": "“А которые к объектам-идущие существа,",
 "iti73:3.2": "и которые в безобразном пребывающие;",
 "iti73:3.3": "Устранения не понимая,",
 "iti73:3.4": "приходят снова к бхаве.",
 "iti73:4.1": "А которые объекты полностью поняв,",
 "iti73:4.2": "в без-объектном не утвердившиеся;",
 "iti73:4.3": "В устранении те, кто высвобождаются,",
 "iti73:4.4": "те люди — смерти-покидатели.",
 "iti73:5.1": "Телом бессмертную-дхату,",
 "iti73:5.2": "коснувшись без-удержания;",
 "iti73:5.3": "Удержания-отдаление,",
 "iti73:5.4": "засвидетельствовав без истечений;",
 "iti73:5.5": "Показывает правильно-пробуждённый,",
 "iti73:5.6": "без-страданий, без-пыльный шаг”.",
 "iti73:6.1": "Этот смысл также сказан Благословенным, так мной услышано.",
 "iti73:6.2": "Четвёртая."
}
