{
 "iti2:0.1": "Итивуттака 2",
 "iti2:0.2": "Раздел из одного",
 "iti2:0.3": "Глава первая",
 "iti2:0.4": "Сутта о вредности-злобе",
 "iti2:1.1": "Сказано это Благословенным, сказано арахантом, так мной услышано:",
 "iti2:2.1": "“Одно явление, монахи, покиньте;",
 "iti2:2.2": "я вам поручитель за невозвращение.",
 "iti2:2.3": "Какое одно явление?",
 "iti2:2.4": "Вредность-злобу, монахи, одно явление покиньте;",
 "iti2:2.5": "я вам поручитель за невозвращение”.",
 "iti2:2.6": "Этот смысл Благословенный сказал.",
 "iti2:2.7": "И здесь это говорится:",
 "iti2:3.1": "“Какой вредностью-злобой испорчены,",
 "iti2:3.2": "существа идут в плохую участь;",
 "iti2:3.3": "Ту вредность-злобу полностью познав,",
 "iti2:3.4": "покидают прозревающие;",
 "iti2:3.5": "Покинув, не возвращаются снова,",
 "iti2:3.6": "в этот мир когда-либо”.",
 "iti2:4.1": "Этот смысл также сказан Благословенным, так мной услышано.",
 "iti2:4.2": "Вторая."
}
