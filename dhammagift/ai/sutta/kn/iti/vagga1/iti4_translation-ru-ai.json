{
 "iti4:0.1": "Итивуттака 4",
 "iti4:0.2": "Раздел из одного",
 "iti4:0.3": "Глава первая",
 "iti4:0.4": "Сутта о Злости",
 "iti4:1.1": "Сказано это Благословенным, сказано арахантом, так мной услышано:",
 "iti4:2.1": "“Одно явление, монахи, покиньте;",
 "iti4:2.2": "я вам поручитель за невозвращение.",
 "iti4:2.3": "Какое одно явление?",
 "iti4:2.4": "Злость, монахи, как одно явление покиньте;",
 "iti4:2.5": "я вам поручитель за невозвращение”.",
 "iti4:2.6": "Этот смысл Благословенный сказал.",
 "iti4:2.7": "И здесь это говорится:",
 "iti4:3.1": "“Какой злостью разозлённые существа,",
 "iti4:3.2": "существа идут в плохую участь;",
 "iti4:3.3": "Ту злость полностью познав,",
 "iti4:3.4": "покидают прозревающие;",
 "iti4:3.5": "Покинув, не возвращаются снова,",
 "iti4:3.6": "в этот мир когда-либо”.",
 "iti4:4.1": "Этот смысл также сказан Благословенным, так мной услышано.",
 "iti4:4.2": "Четвёртая."
}
