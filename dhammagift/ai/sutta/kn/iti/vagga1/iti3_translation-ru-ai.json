{
 "iti3:0.1": "Итивуттака 3",
 "iti3:0.2": "Раздел из одного",
 "iti3:0.3": "Глава первая",
 "iti3:0.4": "Сутта Замутненности-Заблуждения",
 "iti3:1.1": "Сказано это Благословенным, сказано арахантом, так мной услышано:",
 "iti3:2.1": "“Одно явление, монахи, покиньте;",
 "iti3:2.2": "я вам поручитель за невозвращение.",
 "iti3:2.3": "Какое одно явление?",
 "iti3:2.4": "Замутненность-заблуждение, монахи, одно явление покиньте;",
 "iti3:2.5": "я вам поручитель за невозвращение”.",
 "iti3:2.6": "Этот смысл Благословенный сказал.",
 "iti3:2.7": "И здесь это говорится:",
 "iti3:3.1": "“Каким замутненностью-заблуждением омрачены,",
 "iti3:3.2": "существа идут в плохую участь;",
 "iti3:3.3": "Ту замутненность-заблуждение полностью поняв,",
 "iti3:3.4": "покидают прозревающие;",
 "iti3:3.5": "Покинув, не возвращаются снова,",
 "iti3:3.6": "в этот мир когда-либо”.",
 "iti3:4.1": "Этот смысл также сказан Благословенным, так мной услышано.",
 "iti3:4.2": "Третья."
}
