{
 "iti1:0.1": "Итивуттака 1",
 "iti1:0.2": "Раздел из одного",
 "iti1:0.3": "Глава первая",
 "iti1:0.4": "Сутта корыстолюбия",
 "iti1:1.1": "Сказано это Благословенным, сказано арахантом, так мной услышано:",
 "iti1:2.1": "“Одно явление, монахи, покиньте;",
 "iti1:2.2": "я вам поручитель за невозвращение.",
 "iti1:2.3": "Какое одно явление?",
 "iti1:2.4": "Корыстолюбие, монахи, одно явление покиньте;",
 "iti1:2.5": "я вам поручитель за невозвращение”.",
 "iti1:2.6": "Этот смысл Благословенный сказал.",
 "iti1:2.7": "И здесь это говорится:",
 "iti1:3.1": "“Каким корыстолюбием корыстные,",
 "iti1:3.2": "существа идут в плохую участь;",
 "iti1:3.3": "То корыстолюбие полностью познав,",
 "iti1:3.4": "покидают прозревающие;",
 "iti1:3.5": "Покинув, не возвращаются снова,",
 "iti1:3.6": "в этот мир когда-либо”.",
 "iti1:4.1": "Этот смысл также сказан Благословенным, так мной услышано.",
 "iti1:4.2": "Первая."
}
