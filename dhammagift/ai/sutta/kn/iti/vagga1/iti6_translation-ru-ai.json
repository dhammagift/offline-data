{
 "iti6:0.1": "Итивуттака 6",
 "iti6:0.2": "Раздел из одного",
 "iti6:0.3": "Глава первая",
 "iti6:0.4": "Сутта о самомнении",
 "iti6:1.1": "Сказано это Благословенным, сказано арахантом, так мной услышано:",
 "iti6:2.1": "“Одно явление, монахи, покиньте;",
 "iti6:2.2": "я вам поручитель за невозвращение.",
 "iti6:2.3": "Какое одно явление?",
 "iti6:2.4": "Самомнение, монахи, как одно явление покиньте;",
 "iti6:2.5": "я вам поручитель за невозвращение”.",
 "iti6:2.6": "Этот смысл Благословенный сказал.",
 "iti6:2.7": "И здесь это говорится:",
 "iti6:3.1": "“Каким самомнением опьянённые существа,",
 "iti6:3.2": "существа идут в плохую участь;",
 "iti6:3.3": "То самомнение полностью познав,",
 "iti6:3.4": "покидают прозревающие;",
 "iti6:3.5": "Покинув, не возвращаются снова,",
 "iti6:3.6": "в этот мир когда-либо”.",
 "iti6:4.1": "Этот смысл также сказан Благословенным, так мной услышано.",
 "iti6:4.2": "Шестая."
}
