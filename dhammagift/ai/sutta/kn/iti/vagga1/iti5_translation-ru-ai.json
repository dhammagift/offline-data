{
 "iti5:0.1": "Итивуттака 5",
 "iti5:0.2": "Раздел из одного",
 "iti5:0.3": "Глава первая",
 "iti5:0.4": "Сутта о презрении",
 "iti5:1.1": "Сказано это Благословенным, сказано арахантом, так мной услышано:",
 "iti5:2.1": "“Одно явление, монахи, покиньте;",
 "iti5:2.2": "я вам поручитель за невозвращение.",
 "iti5:2.3": "Какое одно явление?",
 "iti5:2.4": "Презрение, монахи, как одно явление покиньте;",
 "iti5:2.5": "я вам поручитель за невозвращение”.",
 "iti5:2.6": "Этот смысл Благословенный сказал.",
 "iti5:2.7": "И здесь это говорится:",
 "iti5:3.1": "“Каким презрением презрительные,",
 "iti5:3.2": "существа идут в плохую участь;",
 "iti5:3.3": "То презрение полностью познав,",
 "iti5:3.4": "покидают прозревающие;",
 "iti5:3.5": "Покинув, не возвращаются снова,",
 "iti5:3.6": "в этот мир когда-либо”.",
 "iti5:4.1": "Этот смысл также сказан Благословенным, так мной услышано.",
 "iti5:4.2": "Пятая."
}
