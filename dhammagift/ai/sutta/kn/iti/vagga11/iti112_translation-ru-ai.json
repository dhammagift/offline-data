{
 "iti112:0.1": "Итивуттака 112",
 "iti112:0.2": "Четыре строфы",
 "iti112:0.3": "Брахман-Дхамма-жертвоприношение раздел",
 "iti112:0.4": "Сутта Свет-мир",
 "iti112:1.1": "Сказано это Благословенным, сказано арахантом, так мной услышано:",
 "iti112:2.1": "“Свет-мир, монахи, Татхагатой постигнут,",
 "iti112:2.2": "от света-мира Татхагата отвязан.",
 "iti112:2.3": "Свето-мира-скапливание, монахи, Татхагатой постигнуто,",
 "iti112:2.4": "свето-мира-скапливание Татхагатой отброшено.",
 "iti112:2.5": "Свето-мира-устранение, монахи, Татхагатой постигнуто,",
 "iti112:2.6": "свето-мира-устранение Татхагатой засвидетельствовано.",
 "iti112:2.7": "К свето-мира-устранению-ведущая практика, монахи, Татхагатой постигнута,",
 "iti112:2.8": "к свето-мира-устранению-ведущая практика Татхагатой развита.",
 "iti112:3.1": "Что, монахи, в мире с божествами, с Марой, с Брахмой, с шраманами-брахманами, с поколением королей-божеств и людей увидено, услышано, ощущено, распознано, достигнуто, обыскано, обдумано умом — то Татхагатой постигнуто,",
 "iti112:3.2": "поэтому ‘Татхагата’ зовется.",
 "iti112:4.1": "И какую, монахи, ночь Татхагата в непревзойденное правильное пробуждение пробуждается, и какую ночь с остатком-без-подпитки в дхату-ниббаны полностью угасает, что в этом промежутке говорит, изрекает, указывает — всё то именно так и есть, не иначе,",
 "iti112:4.2": "поэтому ‘Татхагата’ зовется.",
 "iti112:5.1": "Как-говорит, монахи, Татхагата так-и-делает, как-делает так-и-говорит,",
 "iti112:5.2": "так как-говорит так-и-делает, как-делает так-и-говорит,",
 "iti112:5.3": "поэтому ‘Татхагата’ зовется.",
 "iti112:6.1": "В мире с божествами, монахи, с Марой, с Брахмой, с шраманами-брахманами, с поколением королей-божеств и людей Татхагата — превосходящий, непревзойденный, видящий-смысл-как-есть, властвующий,",
 "iti112:6.2": "потому Татхагатой говорится”.",
 "iti112:6.3": "Этот смысл Благословенный сказал.",
 "iti112:6.4": "И здесь это говорится:",
 "iti112:7.1": "“Весь свет-мир опознав,",
 "iti112:7.2": "во всём свете-мире как-есть;",
 "iti112:7.3": "От всего света-мира отвязан,",
 "iti112:7.4": "ко всему свету не-приближающийся.",
 "iti112:8.1": "Он есть — всё-превосходящий знаток,",
 "iti112:8.2": "всех-узлов-освободитель;",
 "iti112:8.3": "Коснулась его высшая равность,",
 "iti112:8.4": "Ниббане, лишённой страха.",
 "iti112:9.1": "Этот — с-истекшим-истечениями пробуждённый,”",
 "iti112:9.2": "без-тягости, с-отрезанным-сомнением;",
 "iti112:9.3": "Все-активности-исчерпания достигший,",
 "iti112:9.4": "высвобожденный при удержания-исчерпании.",
 "iti112:10.1": "Этот вот Благословенный Будда,",
 "iti112:10.2": "этот лев непревзойдённый;",
 "iti112:10.3": "Мира с божествами,",
 "iti112:10.4": "колесо-Брахмы запустил.",
 "iti112:11.1": "Так дэвы и люди,",
 "iti112:11.2": "которые Будду как прибежище пошли;",
 "iti112:11.3": "собравшись, его почитают-славят,",
 "iti112:11.4": "великого, бесстрашного.",
 "iti112:12.1": "Дрессированный дрессирующих лучший,",
 "iti112:12.2": "успокоенный успокаивающих провидец;",
 "iti112:12.3": "Высвобожденный высвобождающих главный,",
 "iti112:12.4": "пересёкший переправляющих превосходный.",
 "iti112:13.1": "Так его почитают-славят,",
 "iti112:13.2": "великого, бесстрашного;",
 "iti112:13.3": "В мире с дэвами",
 "iti112:13.4": "нет тебе равного”.",
 "iti112:14.1": "Этот смысл также сказан Благословенным, так мной услышано.",
 "iti112:14.2": "Тринадцатая.",
 "iti112:14.3": "Четверная группа установлена.",
 "iti112:15.0": "Оглавление",
 "iti112:15.1": "Брахманы легко-достижимы знанием,",
 "iti112:15.2": "Шраманские принципы — цепляние, Брахма;",
 "iti112:15.3": "Много-делающие — лживые люди,",
 "iti112:15.4": "Иди, с миром связанный, тринадцать.",
 "iti112:16.0": "Собрание сутт",
 "iti112:16.1": "Семь-двадцать-одно-изложение,",
 "iti112:16.2": "Двойное двадцать-два-сутты-собрание;",
 "iti112:16.3": "С-пятью-пятью-десятью-три,",
 "iti112:16.4": "Тринадцать четвёрки и это которое.",
 "iti112:17.1": "Сто-двенадцать-сутт-с-одной-суттой,",
 "iti112:17.2": "Спев, установили прежде;",
 "iti112:17.3": "Араханты для долгого-сохранения,",
 "iti112:17.4": "То называют именем Итивутта.",
 "iti112:17.5": "Итивуттака-пали завершена."
}
