{
 "iti54:0.1": "Итивуттака 54",
 "iti54:0.2": "Тройной раздел",
 "iti54:0.3": "Глава первая",
 "iti54:0.4": "Сутта Первого-Поиска",
 "iti54:1.1": "Сказано это Благословенным, сказано арахантом, так мной услышано:",
 "iti54:2.1": "“Три эти, монахи, поиска.",
 "iti54:2.2": "Какие три?",
 "iti54:2.3": "Поиск желаний, поиск случая, поиск святой жизни—",
 "iti54:2.4": "вот эти, монахи, три поиска”.",
 "iti54:2.5": "Этот смысл Благословенный сказал.",
 "iti54:2.6": "И здесь это говорится:",
 "iti54:3.1": "“Собранный, сознательный,",
 "iti54:3.2": "памятуя Будды последователь;",
 "iti54:3.3": "И поиск понимает,",
 "iti54:3.4": "и поисков проявление.",
 "iti54:4.1": "Где они устраняются,",
 "iti54:4.2": "и путь, к исчерпанию ведущий;",
 "iti54:4.3": "Поисков исчерпанием монах,",
 "iti54:4.4": "без-желания полностью-остуженный”.",
 "iti54:5.1": "Этот смысл также сказан Благословенным, так мной услышано.",
 "iti54:5.2": "Пятая."
}
