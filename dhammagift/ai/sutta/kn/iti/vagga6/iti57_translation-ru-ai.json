{
 "iti57:0.1": "Итивуттака 57",
 "iti57:0.2": "Тройной раздел",
 "iti57:0.3": "Глава первая",
 "iti57:0.4": "Вторая сутта об истечениях",
 "iti57:1.1": "Сказано это Благословенным, сказано арахантом, так мной услышано:",
 "iti57:2.1": "“Три эти, монахи, истечения.",
 "iti57:2.2": "Какие три?",
 "iti57:2.3": "Желания-истечение, случая-истечение, неразличения-истечение —",
 "iti57:2.4": "Эти три, монахи, истечения.",
 "iti57:2.5": "Этот смысл Благословенный сказал.",
 "iti57:2.6": "И здесь это говорится:",
 "iti57:3.1": "У кого желания-истечение истощено,",
 "iti57:3.2": "и невидение выбелены;",
 "iti57:3.3": "Вовлечённости-истечение полностью истощено,",
 "iti57:3.4": "полностью освобождён, без-подпитки;",
 "iti57:3.5": "Несёт последнее тело,",
 "iti57:3.6": "победив Мару с его свитой”.",
 "iti57:4.1": "Этот смысл также сказан Благословенным, так мной услышано.",
 "iti57:4.2": "Восьмая."
}
