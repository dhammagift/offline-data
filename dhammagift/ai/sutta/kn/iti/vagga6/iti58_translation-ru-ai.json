{
 "iti58:0.1": "Итивуттака 58",
 "iti58:0.2": "Тройной раздел",
 "iti58:0.3": "Глава первая",
 "iti58:0.4": "Сутта Цепляний",
 "iti58:1.1": "Сказано это Благословенным, сказано арахантом, так мной услышано:",
 "iti58:2.1": "“Три эти, монахи, цепляния.",
 "iti58:2.2": "Какие три?",
 "iti58:2.3": "Цепляние желания, цепляние случая, цепляние разлучения—",
 "iti58:2.4": "эти, монахи, три цепляния.”",
 "iti58:2.5": "Этот смысл Благословенный сказал.",
 "iti58:2.6": "И здесь это говорится:",
 "iti58:3.1": "“Цепляния связью связанные,",
 "iti58:3.2": "с умом-состоянием, окрашенным в бхаве-за-бхавой;",
 "iti58:3.3": "Те связанные с Марой,",
 "iti58:3.4": "от-связи-не-защищённые люди;",
 "iti58:3.5": "Существа идут в сансару,",
 "iti58:3.6": "к рождению-умиранию идущие.",
 "iti58:4.1": "А которые цепляние отбросив,",
 "iti58:4.2": "без-цепляния в бхаве-за-бхавой;",
 "iti58:4.3": "Вот те, кто перешли на тот берег в мире,",
 "iti58:4.4": "которые достигли исчерпания истечений”.",
 "iti58:5.1": "Этот смысл также сказан Благословенным, так мной услышано.",
 "iti58:5.2": "Девятая."
}
