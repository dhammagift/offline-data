{
 "iti60:0.1": "Итивуттака 60",
 "iti60:0.2": "Тройной раздел",
 "iti60:0.3": "Вторая Глава",
 "iti60:0.4": "Сутта Оснований Благих Дел",
 "iti60:1.1": "Сказано это Благословенным, сказано арахантом, так мной услышано:",
 "iti60:2.1": "“Есть три, монахи, основания благих дел.",
 "iti60:2.2": "Какие три?",
 "iti60:2.3": "Даяние-состоящее благо-деяния-основа, нравственность-состоящее благо-деяния-основа, развитие-состоящее благо-деяния-основа—",
 "iti60:2.4": "Вот эти, монахи, три благо-деяния-основы”.",
 "iti60:2.5": "Этот смысл Благословенный сказал.",
 "iti60:2.6": "И здесь это говорится:",
 "iti60:3.1": "“Благое именно он пусть тренирует,",
 "iti60:3.2": "простирающееся вперёд, приятно-несущее;",
 "iti60:3.3": "Даяние и ровное-поведение,",
 "iti60:3.4": "ум-мирность и развивает.",
 "iti60:4.1": "Эти явления развив,",
 "iti60:4.2": "три приятно-восходящих;",
 "iti60:4.3": "Без-враждебности приятный мир,",
 "iti60:4.4": "мудрец перерождается”.",
 "iti60:5.1": "Этот смысл также сказан Благословенным, так мной услышано.",
 "iti60:5.2": "Первая."
}
