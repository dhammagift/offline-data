{
 "iti56:0.1": "Итивуттака 56",
 "iti56:0.2": "Тройной раздел",
 "iti56:0.3": "Глава первая",
 "iti56:0.4": "Первая сутта об истечениях",
 "iti56:1.1": "Сказано это Благословенным, сказано арахантом, так мной услышано:",
 "iti56:2.1": "“Три эти, монахи, истечения.",
 "iti56:2.2": "Какие три?",
 "iti56:2.3": "Желания-истечение, случая-истечение, неразличения-истечение —",
 "iti56:2.4": "Эти три, монахи, истечения.",
 "iti56:2.5": "Этот смысл Благословенный сказал.",
 "iti56:2.6": "И здесь это говорится:",
 "iti56:3.1": "“Собранный, сознательный,",
 "iti56:3.2": "памятуя Будды последователь;",
 "iti56:3.3": "И истечения понимает,",
 "iti56:3.4": "и истечений проявление.",
 "iti56:4.1": "Где они устраняются,",
 "iti56:4.2": "и путь, к исчерпанию ведущий;",
 "iti56:4.3": "Истечений исчерпанием монах,",
 "iti56:4.4": "без-желания полностью-остуженный”.",
 "iti56:5.1": "Этот смысл также сказан Благословенным, так мной услышано.",
 "iti56:5.2": "Седьмая."
}
