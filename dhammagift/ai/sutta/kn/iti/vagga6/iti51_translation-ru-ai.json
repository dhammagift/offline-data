{
 "iti51:0.1": "Итивуттака 51",
 "iti51:0.2": "Тройной раздел",
 "iti51:0.3": "Глава первая",
 "iti51:0.4": "Сутта Дхату",
 "iti51:1.1": "Сказано это Благословенным, сказано арахантом, так мной услышано:",
 "iti51:2.1": "“Три эти, монахи, дхату.",
 "iti51:2.2": "Какие три?",
 "iti51:2.3": "Дхату образа, дхату без-образа, дхату устранения —",
 "iti51:2.4": "эти три, монахи, дхату”.",
 "iti51:2.5": "Этот смысл Благословенный сказал.",
 "iti51:2.6": "И здесь это говорится:",
 "iti51:3.1": "“Дхату образа полным пониманием,",
 "iti51:3.2": "в без-образных не утвердившись;",
 "iti51:3.3": "В устранении те, кто высвобождаются,",
 "iti51:3.4": "те люди — смерти-покидатели.",
 "iti51:4.1": "Телом бессмертную дхату,",
 "iti51:4.2": "коснувшись без-удержания;",
 "iti51:4.3": "Удержания-отдаление,",
 "iti51:4.4": "засвидетельствовав без истечений;",
 "iti51:4.5": "Показывает правильно-пробуждённый,",
 "iti51:4.6": "без-страданий, без-пыльный шаг”.",
 "iti51:5.1": "Этот смысл также сказан Благословенным, так мной услышано.",
 "iti51:5.2": "Вторая."
}
