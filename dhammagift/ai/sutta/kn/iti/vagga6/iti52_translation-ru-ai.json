{
 "iti52:0.1": "Итивуттака 52",
 "iti52:0.2": "Тройной раздел",
 "iti52:0.3": "Глава первая",
 "iti52:0.4": "Первая сутта о чувствовании",
 "iti52:1.1": "Сказано это Благословенным, сказано арахантом, так мной услышано:",
 "iti52:2.1": "“Три эти, монахи, чувствования-чувства.",
 "iti52:2.2": "Какие три?",
 "iti52:2.3": "Приятное чувство, болезненное чувство, ни-болезненное-ни-приятное чувство.",
 "iti52:2.4": "эти три, монахи, чувствования”.",
 "iti52:2.5": "Этот смысл Благословенный сказал.",
 "iti52:2.6": "И здесь это говорится:",
 "iti52:3.1": "“Собранный, сознательный,",
 "iti52:3.2": "памятуя Будды последователь;",
 "iti52:3.3": "Чувствование понимает,",
 "iti52:3.4": "и чувствований проявление.",
 "iti52:4.1": "Где они устраняются,",
 "iti52:4.2": "и путь, к исчерпанию ведущий;",
 "iti52:4.3": "Чувствований исчерпанием монах",
 "iti52:4.4": "без-желания полностью-остуженный”.",
 "iti52:5.1": "Этот смысл также сказан Благословенным, так мной услышано.",
 "iti52:5.2": "Третья."
}
