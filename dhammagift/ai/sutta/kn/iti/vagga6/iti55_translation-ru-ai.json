{
 "iti55:0.1": "Итивуттака 55",
 "iti55:0.2": "Тройной раздел",
 "iti55:0.3": "Глава первая",
 "iti55:0.4": "Вторая сутта о поисках",
 "iti55:1.1": "Сказано это Благословенным, сказано арахантом, так мной услышано:",
 "iti55:2.1": "“Три эти, монахи, поиска.",
 "iti55:2.2": "Какие три?",
 "iti55:2.3": "Поиск желаний, поиск случая, поиск святой жизни—",
 "iti55:2.4": "вот эти, монахи, три поиска”.",
 "iti55:2.5": "Этот смысл Благословенный сказал.",
 "iti55:2.6": "И здесь это говорится:",
 "iti55:3.1": "“Поиск желаний, поиск [индивидуального] существования,",
 "iti55:3.2": "поиск святой жизни вместе;",
 "iti55:3.3": "Так истин-схватывание,",
 "iti55:3.4": "взглядов-основания, накопления.",
 "iti55:4.1": "У полностью от страсти отсоединённого,",
 "iti55:4.2": "с цепляния-исчерпанием освобождённого;",
 "iti55:4.3": "Поиски оставлены,",
 "iti55:4.4": "с позициями-взглядами поканчивающие;",
 "iti55:4.5": "Поисков исчерпанием монах,",
 "iti55:4.6": "без ожиданий, без сомнений”.",
 "iti55:5.1": "Этот смысл также сказан Благословенным, так мной услышано.",
 "iti55:5.2": "Шестая."
}
