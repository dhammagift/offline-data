{
 "iti24:0.1": "Итивуттака 24",
 "iti24:0.2": "Раздел из одного",
 "iti24:0.3": "Раздел Третий",
 "iti24:0.4": "Сутта Груды Костей",
 "iti24:1.1": "Сказано это Благословенным, сказано арахантом, так мной услышано:",
 "iti24:2.1": "“Одного индивида, монахи, каппу блуждающего скитающегося был бы так велик костяной остов, груда костей, куча костей, как эта гора Вепулла, если бы собиратель был, и собранное не разрушалось бы”.",
 "iti24:2.2": "Этот смысл Благословенный сказал.",
 "iti24:2.3": "И здесь это говорится:",
 "iti24:3.1": "“За одну-единственную каппу",
 "iti24:3.2": "индивида костей скопление;",
 "iti24:3.3": "Была бы с горой сравнима груда,",
 "iti24:3.4": "так сказано великим провидцем.",
 "iti24:4.1": "И вот эта объявлена,",
 "iti24:4.2": "Вепулла гора великая;",
 "iti24:4.3": "Севернее пика Коршуна,",
 "iti24:4.4": "в Магадхе, в Горной-крепости.",
 "iti24:5.1": "Но когда Благородно-Истины",
 "iti24:5.2": "правильным пониманием видит;",
 "iti24:5.3": "Боль, боле-возникновение,",
 "iti24:5.4": "и боли преодоление;",
 "iti24:5.5": "Благородный восьмичастный путь,",
 "iti24:5.6": "К успокоению боли ведущий.",
 "iti24:6.1": "Он семь раз высшее,",
 "iti24:6.2": "проблуждав, индивид;",
 "iti24:6.3": "Боли-конец-делающим становится,",
 "iti24:6.4": "всех связываний исчерпанием”.",
 "iti24:7.1": "Этот смысл также сказан Благословенным, так мной услышано.",
 "iti24:7.2": "Четвёртая."
}
