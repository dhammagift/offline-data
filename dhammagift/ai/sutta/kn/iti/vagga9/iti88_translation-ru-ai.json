{
 "iti88:0.1": "Итивуттака 88",
 "iti88:0.2": "Тройной раздел",
 "iti88:0.3": "Раздел Четвёртый",
 "iti88:0.4": "Сутта Внутренних Пятен",
 "iti88:1.1": "Сказано это Благословенным, сказано арахантом, так мной услышано:",
 "iti88:2.1": "“Три эти, монахи, внутренних пятна, внутренних недруга, внутренних врага, внутренних убийцы, внутренних противника.",
 "iti88:2.2": "Какие три?",
 "iti88:2.3": "Корыстолюбие, монахи, внутреннее пятно, внутренний недруг, внутренний враг, внутренний убийца, внутренний противник.",
 "iti88:2.4": "Вредность-злоба, монахи, внутреннее пятно, внутренний недруг, внутренний враг, внутренний убийца, внутренний противник.",
 "iti88:2.5": "Замутнённость, монахи, внутреннее пятно, внутренний недруг, внутренний враг, внутренний убийца, внутренний противник.",
 "iti88:2.6": "Эти три, монахи, внутренних пятна, внутренних недруга, внутренних врага, внутренних убийцы, внутренних противника”.",
 "iti88:2.7": "Этот смысл Благословенный сказал.",
 "iti88:2.8": "И здесь это говорится:",
 "iti88:3.1": "“Бесцельное-порождающее корыстолюбие,",
 "iti88:3.2": "корыстолюбие — ум-состояние-возмущающее;",
 "iti88:3.3": "Тревога изнутри рождённая,",
 "iti88:3.4": "её люди не понимают.",
 "iti88:4.1": "Корыстный блага не знает,",
 "iti88:4.2": "корыстный явления не видит;",
 "iti88:4.3": "Темнота тогда есть,",
 "iti88:4.4": "кого корыстолюбие одолевает человека.",
 "iti88:5.1": "А который корыстолюбие отбросив,",
 "iti88:5.2": "в корыстолюбиво-привлекательном не корыстолюбив;",
 "iti88:5.3": "Корыстолюбие устраняется от того,",
 "iti88:5.4": "как капля воды с лотоса.",
 "iti88:6.1": "Бесцельное-порождающая вредность-злоба,",
 "iti88:6.2": "вредность-злоба — ум-состояние-возмущающая;",
 "iti88:6.3": "Тревога изнутри рождённая,",
 "iti88:6.4": "её люди не понимают.",
 "iti88:7.1": "Злобный блага не знает,",
 "iti88:7.2": "злобный явления не видит;",
 "iti88:7.3": "Темнота тогда есть,",
 "iti88:7.4": "кого вредность-злоба одолевает человека.",
 "iti88:8.1": "А который вредность-злобу отбросив,",
 "iti88:8.2": "в вредностно-злобно-привлекательном не злобен;",
 "iti88:8.3": "Вредность-злоба устраняется от того,",
 "iti88:8.4": "как плод пальмы от связки.",
 "iti88:9.1": "Бесцельное-порождающая замутнённость,",
 "iti88:9.2": "замутнённость — ум-состояние-возмущающая;",
 "iti88:9.3": "Тревога изнутри рождённая,",
 "iti88:9.4": "её люди не понимают.",
 "iti88:10.1": "Замутнённый блага не знает,",
 "iti88:10.2": "замутнённый явления не видит;",
 "iti88:10.3": "Темнота тогда есть,",
 "iti88:10.4": "кого замутнённость одолевает человека.",
 "iti88:11.1": "А кто замутнённость отбросив,",
 "iti88:11.2": "в замутняемом не замутняется;",
 "iti88:11.3": "Замутнённость разрушает он всю,",
 "iti88:11.4": "как восходящее солнце тьму.",
 "iti88:12.1": "Этот смысл также сказан Благословенным, так мной услышано.",
 "iti88:12.2": "Девятая."
}
