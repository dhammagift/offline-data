{
 "iti93:0.1": "Итивуттака 93",
 "iti93:0.2": "Тройной раздел",
 "iti93:0.3": "Пятая глава",
 "iti93:0.4": "Сутта Огонь",
 "iti93:1.1": "Сказано это Благословенным, сказано арахантом, так мной услышано:",
 "iti93:2.1": "“Три эти, монахи, огня.",
 "iti93:2.2": "Какие три?",
 "iti93:2.3": "Огонь-страсти, огонь-злобы, огонь-заблуждения —",
 "iti93:2.4": "эти три, монахи, огня”.",
 "iti93:2.5": "Этот смысл Благословенный сказал.",
 "iti93:2.6": "И здесь это говорится:",
 "iti93:3.1": "“Огонь-страсти сжигает смертных,",
 "iti93:3.2": "в желаниях очарованных, одурманенных;",
 "iti93:3.3": "Огонь-злобы же — враждебных,",
 "iti93:3.4": "мужей, жизни-уменьшающих.",
 "iti93:4.1": "Огонь-заблуждения же — затуманенных,",
 "iti93:4.2": "в благородной Дхамме неумелых;",
 "iti93:4.3": "Эти огни не знающие,",
 "iti93:4.4": "в самости-теле радующееся поколение.",
 "iti93:5.1": "Они взращивают ад,",
 "iti93:5.2": "и рождения в мире животных;",
 "iti93:5.3": "Асуров, мир духов,",
 "iti93:5.4": "не освобождённые от Мары-уз.",
 "iti93:6.1": "Те же, кто ночью-и-днём заняты,",
 "iti93:6.2": "в правильно-пробуждённого учении;",
 "iti93:6.3": "Они гасят огонь-страсти,",
 "iti93:6.4": "постоянно не-ладность сознающие.",
 "iti93:7.1": "Огонь-злобы же мирностью,",
 "iti93:7.2": "гасят наивысшие мужи;",
 "iti93:7.3": "Огонь-заблуждения же пониманием,",
 "iti93:7.4": "которое к проникновению ведёт.",
 "iti93:8.1": "Те, успокоив, осмотрительные,",
 "iti93:8.2": "ночью и днём неутомимые;",
 "iti93:8.3": "Без остатка угасают,",
 "iti93:8.4": "без остатка боль превзошли.",
 "iti93:9.1": "Благородных видящие, ведающие цели,",
 "iti93:9.2": "правильно-опознав, мудрецы;",
 "iti93:9.3": "Рождение-исчерпание опознав,",
 "iti93:9.4": "не приходят в новое-существование”.",
 "iti93:10.1": "Этот смысл также сказан Благословенным, так мной услышано.",
 "iti93:10.2": "Четвёртая."
}
