{
 "iti95:0.1": "Итивуттака 95",
 "iti95:0.2": "Тройной раздел",
 "iti95:0.3": "Пятая глава",
 "iti95:0.4": "Сутта о желание-возникновениях",
 "iti95:1.1": "Сказано это Благословенным, сказано арахантом, так мной услышано:",
 "iti95:2.1": "“Три эти, монахи, желание-возникновения.",
 "iti95:2.2": "Какие три?",
 "iti95:2.3": "Представленные-желания, наслаждающиеся-творением, распоряжающиеся-чужим-творением —",
 "iti95:2.4": "эти три, монахи, желание-возникновения”.",
 "iti95:2.5": "Этот смысл Благословенный сказал.",
 "iti95:2.6": "И здесь это говорится:",
 "iti95:3.1": "“Представленные-желания и",
 "iti95:3.2": "и те божества, что властвуют;",
 "iti95:3.3": "Нимманарати божества,",
 "iti95:3.4": "а которые другие желание-наслаждающиеся;",
 "iti95:3.5": "такого-бытия-иного-бытия,",
 "iti95:3.6": "Сансару не превосходят.",
 "iti95:4.1": "Эту недостаток-опасность узнав,",
 "iti95:4.2": "в желание-наслаждениях мудрец;",
 "iti95:4.3": "Все оставит желания,",
 "iti95:4.4": "которые божественные и которые человеческие.",
 "iti95:5.1": "Приятно-образное-приятно-комфортное-схваченность,",
 "iti95:5.2": "отрезав поток трудно-переходимый;",
 "iti95:5.3": "Без остатка угасают,",
 "iti95:5.4": "без остатка боль превзошли.",
 "iti95:6.1": "Благородных видящие, ведающие цели,",
 "iti95:6.2": "правильно-опознав, мудрецы;",
 "iti95:6.3": "Рождение-исчерпание опознав,",
 "iti95:6.4": "не приходят в новое-существование”.",
 "iti95:7.1": "Этот смысл также сказан Благословенным, так мной услышано.",
 "iti95:7.2": "Шестая."
}
