{
 "kp6:0.1": "Малый отрывок 6",
 "kp6:0.2": "Сутта Драгоценностей",
 "kp6:1.1": "Какие здесь сущие собрались,",
 "kp6:1.2": "Земные или какие в пространстве;",
 "kp6:1.3": "Все сущие благодушными пусть будут,",
 "kp6:1.4": "И также внимательно пусть слушают речь.",
 "kp6:2.1": "Потому ведь сущие, слушайте все,",
 "kp6:2.2": "Мирность делайте к людскому роду;",
 "kp6:2.3": "Днём и ночью которые несут подношение,",
 "kp6:2.4": "Потому ведь их охраняйте незабывчивые.",
 "kp6:3.1": "Какое-либо богатство здесь или в ином мире,",
 "kp6:3.2": "Или на небесах какая драгоценность превосходная;",
 "kp6:3.3": "Нет нам равного Татхагате,",
 "kp6:3.4": "И это в Пробуждённом драгоценность превосходная;",
 "kp6:3.5": "Этой истиной да будет благополучие.",
 "kp6:4.1": "Исчерпание, бесстрастие-неочарованность, бессмертное превосходное,",
 "kp6:4.2": "Что обрёл Сакья-мудрец собранный;",
 "kp6:4.3": "Нет тому явлению равного чего-либо,",
 "kp6:4.4": "И это в явлении драгоценность превосходная;",
 "kp6:4.5": "Этой истиной да будет благополучие.",
 "kp6:5.1": "Что Пробуждённый-высший восхвалил чистое,",
 "kp6:5.2": "Самадхи непосредственным называют;",
 "kp6:5.3": "Самадхи тому равного не находится,",
 "kp6:5.4": "И это в явлении драгоценность превосходная;",
 "kp6:5.5": "Этой истиной да будет благополучие.",
 "kp6:6.1": "Какие индивиды восемь сто восхвалены,",
 "kp6:6.2": "Четыре эти пары бывают;",
 "kp6:6.3": "Они достойные-даров Благого последователи,",
 "kp6:6.4": "В них данные — великоплодны;",
 "kp6:6.5": "И это в Сангхе драгоценность превосходная,",
 "kp6:6.6": "Этой истиной да будет благополучие.",
 "kp6:7.1": "Которые хорошо-направлены умом-представлением крепким,",
 "kp6:7.2": "Без-желания в Готамы-учении;",
 "kp6:7.3": "Они достигшие-цели в бессмертное погрузившись,",
 "kp6:7.4": "Получив даром успокоение, наслаждаясь;",
 "kp6:7.5": "И это в Сангхе драгоценность превосходная,",
 "kp6:7.6": "Этой истиной да будет благополучие.",
 "kp6:8.1": "Как придверный-столб в землю-установленный будет,",
 "kp6:8.2": "Четырьмя ветрами непоколебимый;",
 "kp6:8.3": "Такому-подобного чистого человека говорю,",
 "kp6:8.4": "Кто благородные истины постигнув видит;",
 "kp6:8.5": "И это в Сангхе драгоценность превосходная,",
 "kp6:8.6": "Этой истиной да будет благополучие.",
 "kp6:9.1": "Которые благородные истины проясняют,",
 "kp6:9.2": "Глубоким-пониманием хорошо-преподанные;",
 "kp6:9.3": "Хотя бы они были сильно беспечны,",
 "kp6:9.4": "Не они бхаву восьмой раз принимают;",
 "kp6:9.5": "И это в Сангхе драгоценность превосходная,",
 "kp6:9.6": "Этой истиной да будет благополучие.",
 "kp6:10.1": "Сразу с его видения-достижением,",
 "kp6:10.2": "Три эти явления отброшены бывают;",
 "kp6:10.3": "С-телом-(отождествление)-взгляд и разбредание,",
 "kp6:10.4": "И принципы-обеты или что-либо есть какое-нибудь.",
 "kp6:11.1": "От четырёх-плохих-миров и полностью-освобождён,",
 "kp6:11.2": "Шесть-проступков неспособен совершить;",
 "kp6:11.3": "И это в Сангхе драгоценность превосходная,",
 "kp6:11.4": "Этой истиной да будет благополучие.",
 "kp6:12.1": "Хотя бы он активность совершает плохую,",
 "kp6:12.2": "Телом, речью или умом-мышлением;",
 "kp6:12.3": "Неспособен он её скрыть,",
 "kp6:12.4": "Неспособность увидевшего-шаг сказана;",
 "kp6:12.5": "И это в Сангхе драгоценность превосходная,",
 "kp6:12.6": "Этой истиной да будет благополучие.",
 "kp6:13.1": "В лесной чаще, как на цветущей верхушке,",
 "kp6:13.2": "В летних месяцах, в первый летний месяц;",
 "kp6:13.3": "Такой подобной превосходную Дхамму научил,",
 "kp6:13.4": "К ниббане ведущую, высшую, во благо;",
 "kp6:13.5": "И это в Пробуждённом драгоценность превосходная;",
 "kp6:13.6": "Этой истиной да будет благополучие.",
 "kp6:14.1": "Превосходный, превосходного знаток, превосходное дающий, превосходное несущий,",
 "kp6:14.2": "Непревзойдённый, превосходную Дхамму научил;",
 "kp6:14.3": "И это в Пробуждённом драгоценность превосходная;",
 "kp6:14.4": "Этой истиной да будет благополучие.",
 "kp6:15.1": "Уничтожено старое, нового нет возникновения,",
 "kp6:15.2": "С отрешённым умом к будущему существованию;",
 "kp6:15.3": "Те с уничтоженным семенем, не возрастающие импульсом,",
 "kp6:15.4": "Угасают мудрые, как этот светильник;",
 "kp6:15.5": "И это в Сангхе драгоценность превосходная,",
 "kp6:15.6": "Этой истиной да будет благополучие.",
 "kp6:16.1": "Какие здесь сущие собрались,",
 "kp6:16.2": "Земные или какие в пространстве;",
 "kp6:16.3": "Татхагату, божествами-людьми почитаемого,",
 "kp6:16.4": "Будду почитаем — да будет благополучие.",
 "kp6:17.1": "Какие здесь сущие собрались,",
 "kp6:17.2": "Земные или какие в пространстве;",
 "kp6:17.3": "Татхагату, божествами-людьми почитаемого,",
 "kp6:17.4": "Дхамму почитаем — да будет благополучие.",
 "kp6:18.1": "Какие здесь сущие собрались,",
 "kp6:18.2": "Земные или какие в пространстве;",
 "kp6:18.3": "Татхагату, божествами-людьми почитаемого,",
 "kp6:18.4": "Сангху почитаем — да будет благополучие.",
 "kp6:19.1": "Сутта Драгоценность."
}
