{
 "kp5:0.1": "Малое чтение 5",
 "kp5:0.2": "Сутта Благословения",
 "kp5:1.1": "Так мной услышано—",
 "kp5:1.2": "одно время Благословенный в Саваттхи располагается, в роще Джеты, в парке Анатхапиндики.",
 "kp5:1.3": "И тогда некая дэвата предрассветной ночью, превосходного вида, осветив целиком рощу Джеты, подошла к Благословенному; подойдя, поприветствовав Благословенного, встала с одного края.",
 "kp5:1.4": "С одного края встав, та дэвата Благословенного строфой обратилась—",
 "kp5:2.1": "“Многие дэвы и люди,",
 "kp5:2.2": "благоприятные знаки обдумывали;",
 "kp5:2.3": "Желая благополучия,",
 "kp5:2.4": "скажи благоприятный знак высочайший”.",
 "kp5:3.1": "“Не-общение с глупыми,",
 "kp5:3.2": "с мудрецами общение;",
 "kp5:3.3": "Почитание почитаемых,",
 "kp5:3.4": "это — благоприятный знак высочайший.",
 "kp5:4.1": "Проживание в подходящей местности,",
 "kp5:4.2": "и прежде совершённое благо;",
 "kp5:4.3": "И правильное направление себя,",
 "kp5:4.4": "это — благоприятный знак высочайший.",
 "kp5:5.1": "И многоучёность, и мастерство,",
 "kp5:5.2": "и вычищение хорошо обученное;",
 "kp5:5.3": "И хорошо сказанная речь,",
 "kp5:5.4": "это — благоприятный знак высочайший.",
 "kp5:6.1": "Обслуживание матери-отца,",
 "kp5:6.2": "собирание жены-детей;",
 "kp5:6.3": "И не-запутанные дела,",
 "kp5:6.4": "это — благоприятный знак высочайший.",
 "kp5:7.1": "Даяние и следование Учению,",
 "kp5:7.2": "и собирание родственников;",
 "kp5:7.3": "Неупрекаемые активности,",
 "kp5:7.4": "это — благоприятный знак высочайший.",
 "kp5:8.1": "Отвращение, воздержание от злого,",
 "kp5:8.2": "от опьяняющих напитков воздержание;",
 "kp5:8.3": "Не-беспечность в явлениях,",
 "kp5:8.4": "это — благоприятный знак высочайший.",
 "kp5:9.1": "Достойный уважения и смирение,",
 "kp5:9.2": "довольство и благодарность;",
 "kp5:9.3": "Своевременное слушание Дхаммы,",
 "kp5:9.4": "это — благоприятный знак высочайший.",
 "kp5:10.1": "Терпение и легко-наставляемость,",
 "kp5:10.2": "и шраманов видение;",
 "kp5:10.3": "Своевременное обсуждение Дхаммы,",
 "kp5:10.4": "это — благоприятный знак высочайший.",
 "kp5:11.1": "Аскеза же и святая жизнь,",
 "kp5:11.2": "Благородно-Истин видение;",
 "kp5:11.3": "И ниббаны засвидетельствование,",
 "kp5:11.4": "это — благоприятный знак высочайший.",
 "kp5:12.1": "Затронутого мирскими-явлениями,",
 "kp5:12.2": "ум-состояние которого не дрожит;",
 "kp5:12.3": "Без-страданий, без-пыльное, защищённое,",
 "kp5:12.4": "это — благоприятный знак высочайший.",
 "kp5:13.1": "Такое сделав,",
 "kp5:13.2": "Везде непобеждённые;",
 "kp5:13.3": "Везде к благополучию идут,",
 "kp5:13.4": "То для них благословение высочайшее”.",
 "kp5:14.1": "Сутта Благословения."
}
