{
 "kp7:0.1": "Малый Раздел 7",
 "kp7:0.2": "Сутта о Внешних Стенах",
 "kp7:1.1": "У внешних стен стоят,",
 "kp7:1.2": "и у дверей и перекрёстков;",
 "kp7:1.3": "У дверных косяков стоят,",
 "kp7:1.4": "придя в свой собственный дом.",
 "kp7:2.1": "При обильной еде и питье,",
 "kp7:2.2": "закусках и угощении предложенных;",
 "kp7:2.3": "Никто о них не помнит,",
 "kp7:2.4": "существ из-за их активности.",
 "kp7:3.1": "Так дают родственникам,",
 "kp7:3.2": "которые сострадательны;",
 "kp7:3.3": "Чистое превосходное своевременно,",
 "kp7:3.4": "подобающее питьё и еду.",
 "kp7:4.1": "Это пусть будет для ваших родственников,",
 "kp7:4.2": "счастливы пусть будут родственники;",
 "kp7:4.3": "И они, туда собравшись,",
 "kp7:4.4": "родственники-духи, собравшиеся.",
 "kp7:5.1": "При обильной еде и питье,",
 "kp7:5.2": "почтительно радуются;",
 "kp7:5.3": "Долго пусть живут наши родственники,",
 "kp7:5.4": "благодаря кому мы получаем.",
 "kp7:6.1": "И нам сделано почитание,",
 "kp7:6.2": "и дающие не безрезультатны;",
 "kp7:6.3": "Ведь здесь нет земледелия,",
 "kp7:6.4": "скотоводства здесь не различается.",
 "kp7:7.1": "Торговли такой нет,",
 "kp7:7.2": "золотом купля-продажа;",
 "kp7:7.3": "Отсюда данным существуют,",
 "kp7:7.4": "предки ушедшие там.",
 "kp7:8.1": "На возвышенности вода выпавшая,",
 "kp7:8.2": "как в низину течёт;",
 "kp7:8.3": "Точно так отсюда данное,",
 "kp7:8.4": "предкам достаётся.",
 "kp7:9.1": "Как полноводные реки,",
 "kp7:9.2": "наполняют океан;",
 "kp7:9.3": "Точно так отсюда данное,",
 "kp7:9.4": "предкам достаётся.",
 "kp7:10.1": "Дал мне, сделал мне,",
 "kp7:10.2": "родственники, друзья и товарищи мои;",
 "kp7:10.3": "Предкам подношение следует дать,",
 "kp7:10.4": "прежде сделанное вспоминая.",
 "kp7:11.1": "Ведь ни плач, ни страдание,",
 "kp7:11.2": "и какое-либо иное стенание;",
 "kp7:11.3": "Не то предкам на благо,",
 "kp7:11.4": "так остаются родственники.",
 "kp7:12.1": "А это подношение данное,",
 "kp7:12.2": "в Сангхе хорошо установленное;",
 "kp7:12.3": "Долгое время на благо ему,",
 "kp7:12.4": "немедленно достаётся.",
 "kp7:13.1": "Этот родственный долг и показан,",
 "kp7:13.2": "предкам почитание и сделано возвышенное;",
 "kp7:13.3": "И силу монахам недодав,",
 "kp7:13.4": "Вами заслуга порождена немалая.",
 "kp7:14.1": "Сутта о Внешних Стенах."
}
