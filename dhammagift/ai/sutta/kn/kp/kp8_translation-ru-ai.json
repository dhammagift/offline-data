{
 "kp8:0.1": "Малый отрывок 8",
 "kp8:0.2": "Сутта о сокровище",
 "kp8:1.1": "Сокровище прячет человек,",
 "kp8:1.2": "в глубине у воды;",
 "kp8:1.3": "При нужде, когда возникнет дело,",
 "kp8:1.4": "для цели мне будет.",
 "kp8:2.1": "От царя или от плохо сказанного,",
 "kp8:2.2": "от вора или от притеснения;",
 "kp8:2.3": "Для освобождения от долга,",
 "kp8:2.4": "при голоде, в несчастных случаях;",
 "kp8:2.5": "Для этой цели на свете",
 "kp8:2.6": "сокровище имя прячется.",
 "kp8:3.1": "Так долго спрятанное будучи,",
 "kp8:3.2": "в глубине у воды;",
 "kp8:3.3": "Не всё всегда так,",
 "kp8:3.4": "тому оно подходит.",
 "kp8:4.1": "Сокровище или с места сходит,",
 "kp8:4.2": "сознавание или у него путается;",
 "kp8:4.3": "Наги или уносят,",
 "kp8:4.4": "яккхи или уносят его.",
 "kp8:5.1": "Или нелюбимые наследники,",
 "kp8:5.2": "вытаскивают у невидящего;",
 "kp8:5.3": "Когда блага-исчерпание происходит,",
 "kp8:5.4": "всё это разрушается.",
 "kp8:6.1": "У кого даянием, нравственностью,",
 "kp8:6.2": "сдержанностью и обузданием;",
 "kp8:6.3": "Сокровище хорошо спрятанное бывает,",
 "kp8:6.4": "женщины или мужчины.",
 "kp8:7.1": "У святилища или в Сангхе,",
 "kp8:7.2": "у личности или у гостей;",
 "kp8:7.3": "К матери-отцу и также,",
 "kp8:7.4": "а после — у старшего брата.",
 "kp8:8.1": "Это сокровище хорошо спрятанное,",
 "kp8:8.2": "непобедимое, следующее-за-ушедшим;",
 "kp8:8.3": "Оставив в том, с чем уходят,",
 "kp8:8.4": "это взяв, уходит.",
 "kp8:9.1": "Не-общее для других,",
 "kp8:9.2": "не-отнимаемое ворами сокровище;",
 "kp8:9.3": "Пусть совершает знаток благие-дела,",
 "kp8:9.4": "которое сокровище, следующее-за-ушедшим.",
 "kp8:10.1": "Этот дэвов и людей,",
 "kp8:10.2": "все-желания-дающее сокровище;",
 "kp8:10.3": "Чего-чего только ни пожелают,",
 "kp8:10.4": "всё этим достигается.",
 "kp8:11.1": "Золотистость, хороший голос,",
 "kp8:11.2": "хорошее сложение, хорошая внешность;",
 "kp8:11.3": "Владычество и свита,",
 "kp8:11.4": "всё этим достигается.",
 "kp8:12.1": "Царство над областью, господство,",
 "kp8:12.2": "счастье миродержца, приятное;",
 "kp8:12.3": "Даже владычество над дэвами в небесных-мирах,",
 "kp8:12.4": "всё этим достигается.",
 "kp8:13.1": "И человеческое процветание,",
 "kp8:13.2": "в мире дэвов какая радость;",
 "kp8:13.3": "И какая ниббана-успешность,",
 "kp8:13.4": "всё этим достигается.",
 "kp8:14.1": "Друга-успешность получив,",
 "kp8:14.2": "правильно прилагая усилия;",
 "kp8:14.3": "Знание-высвобождение-владение,",
 "kp8:14.4": "всё этим достигается.",
 "kp8:15.1": "Аналитические знания и высвобождения,",
 "kp8:15.2": "и какая слушателя-вершина;",
 "kp8:15.3": "Паччека-пробуждение, будда-состояние,",
 "kp8:15.4": "всё этим достигается.",
 "kp8:16.1": "Так велико-полезна эта,",
 "kp8:16.2": "а именно—блага-успешность;",
 "kp8:16.3": "Потому мудрые одобряют,",
 "kp8:16.4": "мудрецы благо-сделавших.",
 "kp8:17.1": "Сутта о сокровище."
}
