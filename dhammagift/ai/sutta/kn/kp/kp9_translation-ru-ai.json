{
 "kp9:0.1": "Малое чтение 9",
 "kp9:0.2": "Сутта Метта",
 "kp9:1.1": "Должно-быть-сделано-в-цели-умелым,",
 "kp9:1.2": "Чтобы этот путь покоя пройти",
 "kp9:1.3": "Способный, и прямой и очень прямой,",
 "kp9:1.4": "И легко наставляемый должен быть, мягкий, не-надменный.",
 "kp9:2.1": "Удовлетворенный и просто поддерживаемый,",
 "kp9:2.2": "Необременённый и с лёгким бытом;",
 "kp9:2.3": "Спокойно-в способностях и рассудительный,",
 "kp9:2.4": "Ненапыщенный, к семьям не алчный.",
 "kp9:3.1": "Пусть и мелкого не совершает чего-либо,",
 "kp9:3.2": "Которым знающие других порицали бы;",
 "kp9:3.3": "В комфорте и защищены пусть будут.",
 "kp9:3.4": "Все существа пусть будут приятны.",
 "kp9:4.1": "Любые существа (дышащие), которые есть",
 "kp9:4.2": "Подвижные или статичные, без исключения;",
 "kp9:4.3": "Длинные или которые большие,",
 "kp9:4.4": "Средние, короткие, тонкие-плотные.",
 "kp9:5.1": "Видимые или которые невидимые,",
 "kp9:5.2": "Которые вдалеке обитают и невдалеке;",
 "kp9:5.3": "Сущие и появляющиеся,",
 "kp9:5.4": "Все существа пусть будут приятны.",
 "kp9:6.1": "Пусть один другого не обманывал бы,",
 "kp9:6.2": "Не был горделив в чем-либо с кем-либо;",
 "kp9:6.3": "Вызыванием гнева отражения-сознавание,",
 "kp9:6.4": "Один другому боли не желал бы.",
 "kp9:7.1": "Как мама собственного сына",
 "kp9:7.2": "Ценой жизни единственного-сына-защищала бы;",
 "kp9:7.3": "И так обо всех существах,",
 "kp9:7.4": "Ум-представление развивает неизмеримый.",
 "kp9:8.1": "и мирность ко всему свету.",
 "kp9:8.2": "Ум развивает неизмеримый;",
 "kp9:8.3": "вверх и вниз и поперёк,",
 "kp9:8.4": "Не стеснённый, без противления-без-соперничества.",
 "kp9:9.1": "Стоящий, идущий, сидящий ли,",
 "kp9:9.2": "Лежащий покуда был бы без-сонливости;",
 "kp9:9.3": "Это памятование если установит,",
 "kp9:9.4": "Это Брахмы расположение тогда называется.",
 "kp9:10.1": "И ко взгляду не прибегая,",
 "kp9:10.2": "Нравственный, видением наделённый;",
 "kp9:10.3": "В желаниях выведя алчность,",
 "kp9:10.4": "к рождению из утробы не идёт снова”.",
 "kp9:11.1": "Сутта Метта.",
 "kp9:12.1": "Чтение Малого отрывка завершено."
}
