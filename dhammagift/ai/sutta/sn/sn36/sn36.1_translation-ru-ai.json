{
 "sn36.1:0.1": "Связанные Наставления 36.1",
 "sn36.1:0.2": "1. Раздел Сагатха",
 "sn36.1:0.3": "Сутта Самадхи",
 "sn36.1:1.1": "“Три эти, монахи, чувствования-чувства.",
 "sn36.1:1.2": "Какие три?",
 "sn36.1:1.3": "Приятное чувство, болезненное чувство, ни-болезненное-ни-приятное чувство.",
 "sn36.1:1.4": "Эти три, монахи, чувствования.",
 "sn36.1:2.1": "Собранный, сознательный,",
 "sn36.1:2.2": "памятуя Будды последователь;",
 "sn36.1:2.3": "Чувствование понимает,",
 "sn36.1:2.4": "и чувствований проявление.",
 "sn36.1:3.1": "Где они устраняются,",
 "sn36.1:3.2": "и путь, к исчерпанию ведущий;",
 "sn36.1:3.3": "Чувствований исчерпанием монах",
 "sn36.1:3.4": "без-желания полностью-остуженный”.",
 "sn36.1:3.5": "Первая."
}
