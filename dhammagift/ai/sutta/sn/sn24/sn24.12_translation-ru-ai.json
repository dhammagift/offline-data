{
 "sn24.12:0.1": "Связанные Наставления 24.12",
 "sn24.12:0.2": "1. Раздел обретшего слух",
 "sn24.12:0.3": "Сутта Безграничности",
 "sn24.12:1.1": "В условиях Саваттхи.",
 "sn24.12:1.2": "«При наличии чего, монахи, подпитываясь чем, застревая в чём, возникает такой взгляд:",
 "sn24.12:1.3": "“мир безграничен”?”",
 "sn24.12:1.4": "“В Благословенном-укоренены для нас, почтенный, Учения …",
 "sn24.12:1.5": "определённый к-пробуждению-переправляющийся”.",
 "sn24.12:1.6": "Двенадцатая."
}
