{
 "sn24.16:0.1": "Связанные Наставления 24.16",
 "sn24.16:0.2": "1. Раздел обретшего слух",
 "sn24.16:0.3": "Не-существует-Татхагата-сутта",
 "sn24.16:1.1": "В условиях Саваттхи.",
 "sn24.16:1.2": "«При наличии чего, монахи, подпитываясь чем, застревая в чём, возникает такой взгляд:",
 "sn24.16:1.3": "“не существует Татхагата после смерти”?",
 "sn24.16:1.4": "“В Благословенном-укоренены для нас, почтенный, Учения …",
 "sn24.16:1.5": "определённый к-пробуждению-переправляющийся”.",
 "sn24.16:1.6": "Шестнадцатое."
}
