{
 "sn24.13:0.1": "Связанные Наставления 24.13",
 "sn24.13:0.2": "1. Раздел обретшего слух",
 "sn24.13:0.3": "Сутта «И душа и тело — одно»",
 "sn24.13:1.1": "В условиях Саваттхи.",
 "sn24.13:1.2": "«При наличии чего, монахи, подпитываясь чем, застревая в чём, возникает такой взгляд:",
 "sn24.13:1.3": "«И душа и тело — одно»?",
 "sn24.13:1.4": "“В Благословенном-укоренены для нас, почтенный, Учения …",
 "sn24.13:1.5": "определённый к-пробуждению-переправляющийся”.",
 "sn24.13:1.6": "Тринадцатая."
}
