{
 "sn24.15:0.1": "Связанные Наставления 24.15",
 "sn24.15:0.2": "1. Раздел обретшего слух",
 "sn24.15:0.3": "Сутта Существует Татхагата",
 "sn24.15:1.1": "В условиях Саваттхи.",
 "sn24.15:1.2": "«При наличии чего, монахи, подпитываясь чем, застревая в чём, возникает такой взгляд:",
 "sn24.15:1.3": "“существует Татхагата после смерти”?”",
 "sn24.15:1.4": "“В Благословенном-укоренены для нас, почтенный, Учения …",
 "sn24.15:1.5": "определённый к-пробуждению-переправляющийся”.",
 "sn24.15:1.6": "Пятнадцатая."
}
