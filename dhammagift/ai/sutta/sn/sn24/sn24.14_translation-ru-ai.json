{
 "sn24.14:0.1": "Связанные Наставления 24.14",
 "sn24.14:0.2": "1. Раздел обретшего слух",
 "sn24.14:0.3": "Сутта Душа-одно-тело-другое",
 "sn24.14:1.1": "В условиях Саваттхи.",
 "sn24.14:1.2": "«При наличии чего, монахи, подпитываясь чем, застревая в чём, возникает такой взгляд:",
 "sn24.14:1.3": "“душа — одно, тело — другое”?",
 "sn24.14:1.4": "“В Благословенном-укоренены для нас, почтенный, Учения …",
 "sn24.14:1.5": "определённый к-пробуждению-переправляющийся”.",
 "sn24.14:1.6": "Четырнадцатая."
}
