{
 "sn5.7:0.1": "Связанные Наставления 5.7",
 "sn5.7:0.2": "1. Раздел монахинь",
 "sn5.7:0.3": "Сутта Упачалы",
 "sn5.7:1.1": "В условиях Саваттхи.",
 "sn5.7:1.2": "И тогда монахиня Упачала в первую треть дня, одевшись …",
 "sn5.7:1.3": "у одного подножия дерева на дневное пребывание села.",
 "sn5.7:1.4": "И тогда Мара Злой, куда монахиня Упачала, туда подошёл; подойдя к монахине Упачале, это сказал:",
 "sn5.7:1.5": "«Где же ты, монахиня, родиться желаешь?»",
 "sn5.7:1.6": "«Не я, товарищ, где-либо родиться желаю».",
 "sn5.7:2.1": "«Тридцатитрёх и Ямы",
 "sn5.7:2.2": "и Туситы божества;",
 "sn5.7:2.3": "Нимманарати божества,",
 "sn5.7:2.4": "и те божества, что властвуют;",
 "sn5.7:2.5": "Туда ум-состояние направь,",
 "sn5.7:2.6": "радость будешь переживать».",
 "sn5.7:3.1": "«Тридцатитрёх и Ямы",
 "sn5.7:3.2": "и Туситы божества;",
 "sn5.7:3.3": "Нимманарати божества,",
 "sn5.7:3.4": "и те божества, что властвуют;",
 "sn5.7:3.5": "Желание-оковами связанные те,",
 "sn5.7:3.6": "идут под власть Мары вновь.",
 "sn5.7:4.1": "Весь охвачен огнём свет,",
 "sn5.7:4.2": "весь свет продымлён;",
 "sn5.7:4.3": "Весь объят пламенем свет,",
 "sn5.7:4.4": "весь свет сотрясён.",
 "sn5.7:5.1": "Несотрясённое, необъятое пламенем,",
 "sn5.7:5.2": "обывателями не посещаемое;",
 "sn5.7:5.3": "Куда нет хода Маре,",
 "sn5.7:5.4": "там мой ум радуется».",
 "sn5.7:6.1": "И тогда Мара Злой: «Знает меня монахиня Упачала» — болезненный, недовольный, тут же исчез."
}
