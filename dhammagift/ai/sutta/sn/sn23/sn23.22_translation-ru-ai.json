{
 "sn23.22:0.1": "Связанные Наставления 23.22",
 "sn23.22:0.2": "Раздел Второй Мара",
 "sn23.22:0.3": "Сутта Устранение-природы",
 "sn23.22:1.1": "В условиях Саваттхи.",
 "sn23.22:1.2": "С одной стороны сидящий Достопочтенный Радха так обратился к Благословенному:",
 "sn23.22:1.3": "“'Устранение-природа, устранение-природа', почтенный, говорится.",
 "sn23.22:1.4": "Что же, почтенный, устранение-природа?”",
 "sn23.22:1.5": "“Материя, Радха, устранение-природа, чувствование устранение-природа, сознавание устранение-природа, отождествления устранение-природа, внимание устранение-природа.",
 "sn23.22:1.6": "Так видящий…",
 "sn23.22:1.7": "иного существования — понимает”.",
 "sn23.22:1.8": "Двенадцатая.",
 "sn23.22:1.9": "Глава Вторая Мара.",
 "sn23.22:2.0": "Оглавление",
 "sn23.22:2.1": "Мара и мара-природа,",
 "sn23.22:2.2": "С ненадёжностью другие две;",
 "sn23.22:2.3": "С болью также две сказаны,",
 "sn23.22:2.4": "С не-сущностью так же;",
 "sn23.22:2.5": "Исчерпание, исчезновение, скапливание,",
 "sn23.22:2.6": "С устранение-природой двенадцать."
}
