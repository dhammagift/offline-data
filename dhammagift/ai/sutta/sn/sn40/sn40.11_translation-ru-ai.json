{
 "sn40.11:0.1": "Связанные Наставления 40.11",
 "sn40.11:0.2": "Раздел Моггалланы",
 "sn40.11:0.3": "Сутта Чандана",
 "sn40.11:1.1": "Тогда Чандана, дэва-сын…",
 "sn40.11:2.1": "Тогда Суяма, дэва-сын…",
 "sn40.11:3.1": "Тогда Сантусита, дэва-сын…",
 "sn40.11:4.1": "Тогда Сунимита, дэва-сын…",
 "sn40.11:5.1": "Тогда Васаватти, дэва-сын…",
 "sn40.11:6.1": "(Как Сутта Сакки, так эти пять серий должны быть развернуты.)",
 "sn40.11:6.2": "Одиннадцатая.",
 "sn40.11:6.3": "Глава Моггаллана Первая.",
 "sn40.11:7.0": "Оглавление",
 "sn40.11:7.1": "С рассуждением и без рассуждения,",
 "sn40.11:7.2": "и приятным, и прямо-видящий;",
 "sn40.11:7.3": "Бесконечное-пространство и внимание,",
 "sn40.11:7.4": "ничто и ни-сознавания;",
 "sn40.11:7.5": "И без-знаковый, и Способный,",
 "sn40.11:7.6": "и Чандана одиннадцатым.",
 "sn40.11:7.7": "Моггалланасаньютта завершена."
}
