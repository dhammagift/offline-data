{
 "sn45.173:0.1": "Связанные Наставления 45.173",
 "sn45.173:0.2": "14. Раздел Огха",
 "sn45.173:0.3": "Сутта Поддерживания",
 "sn45.173:1.1": "“Четыре эти, монахи, поддерживания.",
 "sn45.173:1.2": "Какие четыре?",
 "sn45.173:1.3": "желания-поддерживание, взглядо-поддерживание, нравственно-обето-поддерживание, самости-утверждение-поддерживание—",
 "sn45.173:1.4": "вот эти, монахи, четыре поддерживания.",
 "sn45.173:1.5": "Для этих, монахи, четырёх поддерживаний познания, полного понимания, полного исчерпания, покидания… этот Благородный Восьмеричный Путь должен быть развит”.",
 "sn45.173:1.6": "Третья."
}
