{
 "sn45.34:0.1": "Связанные Наставления 45.34",
 "sn45.34:0.2": "Раздел Патипатти",
 "sn45.34:0.3": "Сутта Перехода-на-другой-берег",
 "sn45.34:1.1": "В условиях Саваттхи.",
 "sn45.34:1.2": "“Восемь этих, монахи, явлений, развитых преумноженных, от не-иного к иному для перехода приводят.",
 "sn45.34:1.3": "Какие восемь?",
 "sn45.34:1.4": "В частности—правильный взгляд … правильное самадхи.",
 "sn45.34:1.5": "Вот эти, монахи, восемь явлений, развитых взращенных, от не-иного к иному для перехода ведут”.",
 "sn45.34:2.1": "Это сказал Благословенный.",
 "sn45.34:2.2": "Это сказав Благой, в дополнение это сказал Учитель:",
 "sn45.34:3.1": "“Малочисленны те среди людей,",
 "sn45.34:3.2": "которые люди, на другой берег идущие;",
 "sn45.34:3.3": "А вот эта остальная толпа,",
 "sn45.34:3.4": "берег же обегает.",
 "sn45.34:4.1": "А которые же правильно-изложенном,",
 "sn45.34:4.2": "явлении следующими-за-явлением;",
 "sn45.34:4.3": "Те люди на другой берег перейдут,",
 "sn45.34:4.4": "смерти-владение трудно-переходимое.",
 "sn45.34:5.1": "Тёмное явление полностью оставив,",
 "sn45.34:5.2": "светлое развивай, мудрец;",
 "sn45.34:5.3": "Из дома в бездомность придя,",
 "sn45.34:5.4": "в уединение, где трудно-радоваться.",
 "sn45.34:6.1": "Там радость-в-уединении пусть ищет,",
 "sn45.34:6.2": "оставив желания, ничего-не-имеющий;",
 "sn45.34:6.3": "Пусть очистит себя,",
 "sn45.34:6.4": "от ум-загрязнений мудрец.",
 "sn45.34:7.1": "У которых в пробуждения-факторах,",
 "sn45.34:7.2": "правильно ум-состояние хорошо-развито;",
 "sn45.34:7.3": "В принятии-и-отказе,",
 "sn45.34:7.4": "не поддерживая которые радуются;",
 "sn45.34:7.5": "С истощёнными истечениями, сияющие,",
 "sn45.34:7.6": "те в мире полностью угасли”.",
 "sn45.34:7.7": "Четвёртая."
}
