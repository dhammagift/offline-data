{
 "sn45.1:0.1": "Связанные Наставления 45.1",
 "sn45.1:0.2": "1. Глава Не-знание",
 "sn45.1:0.3": "Сутта Неразличение",
 "sn45.1:1.1": "Так мной услышано—",
 "sn45.1:1.2": "одно время Благословенный в Саваттхи располагается, в роще Джеты, в парке Анатхапиндики.",
 "sn45.1:1.3": "И здесь Благословенный к монахам обратился:",
 "sn45.1:1.4": "“Монахи”.",
 "sn45.1:1.5": "“Достопочтенный”, — те монахи Благословенному ответили.",
 "sn45.1:1.6": "Благословенный это сказал:",
 "sn45.1:2.1": "“Неразличение, монахи, предшествует неблаготворных явлений достижению, следом бессовестность без-опасливость.",
 "sn45.1:2.2": "Неразличения-достигшего, монахи, не-видящего ошибочный взгляд возникает;",
 "sn45.1:2.3": "ошибочно-взглядного ошибочное намерение-привычка возникает;",
 "sn45.1:2.4": "ошибочно-намеренного ошибочное высказывание-речь возникает;",
 "sn45.1:2.5": "ошибочно-высказывающегося ошибочный поступок возникает;",
 "sn45.1:2.6": "ошибочно-поступающего ошибочный быт возникает;",
 "sn45.1:2.7": "ошибочно-бытного ошибочное усилие возникает;",
 "sn45.1:2.8": "ошибочно-усиленного ошибочное памятование возникает;",
 "sn45.1:2.9": "ошибочно-памятующего ошибочное самадхи возникает.",
 "sn45.1:3.1": "Различение же, монахи, предшествует благотворных явлений достижению, следом совестливость-опасливость.",
 "sn45.1:3.2": "Различения-достигшего, монахи, видящего правильный взгляд возникает;",
 "sn45.1:3.3": "правильно-взглядного правильное намерение-привычка возникает;",
 "sn45.1:3.4": "правильно-намеренного правильное высказывание-речь возникает;",
 "sn45.1:3.5": "правильно-высказывающегося правильный поступок возникает;",
 "sn45.1:3.6": "правильно-поступающего правильный быт возникает;",
 "sn45.1:3.7": "правильного быта правильное старание возникает;",
 "sn45.1:3.8": "правильного старания правильное памятование возникает;",
 "sn45.1:3.9": "правильного памятования правильное самадхи возникает”.",
 "sn45.1:3.10": "Первая."
}
