{
 "sn45.31:0.1": "Связанные Наставления 45.31",
 "sn45.31:0.2": "Раздел Патипатти",
 "sn45.31:0.3": "Сутта Первая Практика",
 "sn45.31:1.1": "В условиях Саваттхи.",
 "sn45.31:1.2": "“Неправильную практику вам, монахи, преподам, правильную практику.",
