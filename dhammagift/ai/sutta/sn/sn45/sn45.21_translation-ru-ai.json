{
 "sn45.21:0.1": "Связанные Наставления 45.21",
 "sn45.21:0.2": "3. Раздел Миччхатта",
 "sn45.21:0.3": "Сутта Миччхатта",
 "sn45.21:1.1": "В условиях Саваттхи.",
 "sn45.21:1.2": "“Ошибочность вам, монахи, преподам, и правильность.",
 "sn45.21:1.3": "Услышьте это.",
 "sn45.21:1.4": "И что такое, монахи, ошибочность?",
 "sn45.21:1.5": "А именно—ошибочный взгляд… ошибочное самадхи.",
 "sn45.21:1.6": "Это называется, монахи, ошибочностью.",
 "sn45.21:1.7": "И что такое, монахи, правильность?",
 "sn45.21:1.8": "В частности—правильный взгляд … правильное самадхи.",
 "sn45.21:1.9": "Это называется, монахи, правильностью”.",
 "sn45.21:1.10": "Первая."
}
