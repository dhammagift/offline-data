{
 "sn45.22:0.1": "Связанные Наставления 45.22",
 "sn45.22:0.2": "3. Раздел Миччхатта",
 "sn45.22:0.3": "Сутта Неблаготворных Явлений",
 "sn45.22:1.1": "В условиях Саваттхи.",
 "sn45.22:1.2": "“Неблаготворные, монахи, явления объясню и благотворные явления.",
 "sn45.22:1.3": "Услышьте это.",
 "sn45.22:1.4": "И каковы, монахи, неблаготворные явления?",
 "sn45.22:1.5": "А именно—ошибочный взгляд… ошибочное самадхи.",
 "sn45.22:1.6": "Те зовутся, монахи, неблаготворными явлениями.",
 "sn45.22:1.7": "И каковы, монахи, благотворные явления?",
 "sn45.22:1.8": "В частности—правильный взгляд … правильное самадхи.",
 "sn45.22:1.9": "Те зовутся, монахи, благотворными явлениями”.",
 "sn45.22:1.10": "Вторая."
}
