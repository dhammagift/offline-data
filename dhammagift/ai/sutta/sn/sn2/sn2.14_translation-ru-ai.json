{
 "sn2.14:0.1": "Связанные Наставления 2.14",
 "sn2.14:0.2": "2. Анатхапиндикавагга",
 "sn2.14:0.3": "Сутта Нандана",
 "sn2.14:1.1": "Рядом встав, Нандана-дэвапутта Благословенного стихом обратился:",
 "sn2.14:2.1": "“Спрашиваю тебя, Готама, с обширным пониманием,",
 "sn2.14:2.2": "Незакрыто Благословенного знание-видение;",
 "sn2.14:2.3": "Какого вида нравственным называют,",
 "sn2.14:2.4": "Какого вида понимающим называют;",
 "sn2.14:2.5": "Какого вида боль превосходит, и он таков,",
 "sn2.14:2.6": "Какого вида дэвы почитают”.",
 "sn2.14:3.1": "“Кто нравственный, понимающий, развитой-умом,",
 "sn2.14:3.2": "Собранный, в джхане радующийся, памятующий;",
 "sn2.14:3.3": "Всего страдания ушедшие покинуты,",
 "sn2.14:3.4": "Исчерпавший истечения, последнее-тело носящий.",
 "sn2.14:4.1": "Такого вида нравственным называют,",
 "sn2.14:4.2": "Такого вида понимающим называют;",
 "sn2.14:4.3": "Такого вида боль превосходит, и он таков,",
 "sn2.14:4.4": "Такого вида дэвы почитают”."
}
