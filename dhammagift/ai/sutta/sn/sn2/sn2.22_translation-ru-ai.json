{
 "sn2.22:0.1": "Связанные Наставления 2.22",
 "sn2.22:0.2": "3. Глава разных учителей",
 "sn2.22:0.3": "Сутта Кхемы",
 "sn2.22:1.1": "Встав рядом, дэва-сын Кхема в присутствии Благословенного эти строфы произнёс:",
 "sn2.22:2.1": "“Бродят глупые, неразумные,",
 "sn2.22:2.2": "как с врагом, с собой;",
 "sn2.22:2.3": "Совершая плохую активность,",
 "sn2.22:2.4": "которая бывает с горьким плодом.",
 "sn2.22:3.1": "Не та активность сделана хорошо,",
 "sn2.22:3.2": "которую сделав, сожалеют;",
 "sn2.22:3.3": "Чей со слезами на лице, плача,",
 "sn2.22:3.4": "результат переживает.",
 "sn2.22:4.1": "И та активность сделана хорошо,",
 "sn2.22:4.2": "которую сделав, не сожалеют;",
 "sn2.22:4.3": "Чей довольный, радостный умом,",
 "sn2.22:4.4": "результат переживает.",
 "sn2.22:5.1": "Заранее же то пусть делает,",
 "sn2.22:5.2": "что должно знать как благо для себя;",
 "sn2.22:5.3": "Не с повозочным размышлением,",
 "sn2.22:5.4": "обдумав, знаток пусть прилагает усилие.",
 "sn2.22:6.1": "Как повозочный, ровную,",
 "sn2.22:6.2": "гладкую оставив, большую дорогу;",
 "sn2.22:6.3": "Неровным путём взобравшись,",
 "sn2.22:6.4": "с осью сломанной, зажигается.",
 "sn2.22:7.1": "Так, от явлений отойдя,",
 "sn2.22:7.2": "не-Дхамму следуя;",
 "sn2.22:7.3": "Манда смерти-пасть достигнув,",
 "sn2.22:7.4": "с перерезанной осью зажжётся”."
}
