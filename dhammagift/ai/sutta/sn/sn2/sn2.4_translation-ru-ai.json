{
 "sn2.4:0.1": "Связанные Наставления 2.4",
 "sn2.4:0.2": "1. Первая Глава",
 "sn2.4:0.3": "Сутта Магадха",
 "sn2.4:1.1": "В условиях Саваттхи.",
 "sn2.4:1.2": "Рядом стоявший тот магадха дэва-сын Благословенного стихом обратился:",
 "sn2.4:2.1": "“Сколько на свете светочей,",
 "sn2.4:2.2": "которыми свет освещается;",
 "sn2.4:2.3": "Благословенного спросить придя,",
 "sn2.4:2.4": "как узнаем то мы”.",
 "sn2.4:3.1": "“Четыре на свете светоча,",
 "sn2.4:3.2": "пятого здесь не различается;",
 "sn2.4:3.3": "Днём сияет солнце,",
 "sn2.4:3.4": "ночью светит луна.",
 "sn2.4:4.1": "А огонь днём и ночью,",
 "sn2.4:4.2": "там и тут сияет;",
 "sn2.4:4.3": "Всепробуждённый — сияющих лучший,",
 "sn2.4:4.4": "это сияние непревзойдённое”."
}
