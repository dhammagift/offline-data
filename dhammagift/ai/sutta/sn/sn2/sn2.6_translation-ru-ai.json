{
 "sn2.6:0.1": "Связанные Наставления 2.6",
 "sn2.6:0.2": "1. Первая Глава",
 "sn2.6:0.3": "Сутта Желания",
 "sn2.6:1.1": "В условиях Саваттхи.",
 "sn2.6:1.2": "Рядом стоящий тот Желание, сын дэвов, Благословенному это сказал:",
 "sn2.6:1.3": "“Трудно, почтенный, очень трудно, почтенный”.",
 "sn2.6:2.1": "“Трудное ведь делают,",
 "sn2.6:2.2": "(Желание, — сказал Благословенный,)",
 "sn2.6:2.3": "Ученики, в нравственности утверждённые;",
 "sn2.6:2.4": "Устойчивым, в бездомность вошедшим,",
 "sn2.6:2.5": "Довольство бывает, приносящее приятное”.",
 "sn2.6:3.1": "“Трудно обретаемо, почтенный, это — довольство”.",
 "sn2.6:4.1": "“Трудно обретаемое ведь обретают,",
 "sn2.6:4.2": "(Желание, — сказал Благословенный,)",
 "sn2.6:4.3": "В выравнивании ума-состояния радующиеся;",
 "sn2.6:4.4": "Тех, у кого днём и ночью,",
 "sn2.6:4.5": "В развитии рад ум-представление”.",
 "sn2.6:5.1": "“Трудно сосредоточиваем, почтенный, это — ум-состояние”.",
 "sn2.6:6.1": "“Трудно сосредоточиваемое ведь сосредоточивают,",
 "sn2.6:6.2": "(Желание, — сказал Благословенный,)",
 "sn2.6:6.3": "В выравнивании способностей радующиеся;",
 "sn2.6:6.4": "Те, разрубив сети Смерти,",
 "sn2.6:6.5": "Благородные идут, Желание”.",
 "sn2.6:7.1": "“Трудно проходим, почтенный, неровен путь”.",
 "sn2.6:8.1": "“По трудно проходимому, неровному ведь,",
 "sn2.6:8.2": "Благородные идут, Желание;",
 "sn2.6:8.3": "Неблагородные на неровном пути,",
 "sn2.6:8.4": "Падают вниз головой;",
 "sn2.6:8.5": "Благородных ровный путь,",
 "sn2.6:8.6": "Благородные ведь в неровном ровны”."
}
