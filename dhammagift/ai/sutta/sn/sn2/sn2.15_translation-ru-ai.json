{
 "sn2.15:0.1": "Связанные Наставления 2.15",
 "sn2.15:0.2": "2. Анатхапиндикавагга",
 "sn2.15:0.3": "Сутта Чандана",
 "sn2.15:1.1": "Рядом стоявший Чандана, дэва-сын, Благословенного стихом воспел:",
 "sn2.15:2.1": "“Как же пересекает затопление,",
 "sn2.15:2.2": "ночь-день неутомлённый;",
 "sn2.15:2.3": "Без опоры, без поддержки,",
 "sn2.15:2.4": "кто в глубине не тонет?”",
 "sn2.15:3.1": "“Всегда нравственностью-наделённый,",
 "sn2.15:3.2": "Понимающий, хорошо-сосредоточенный;",
 "sn2.15:3.3": "Решительный, решительный,",
 "sn2.15:3.4": "Затопление пересекает трудно-пересекаемое.",
 "sn2.15:4.1": "Воздерживаясь от желания-сознавания,",
 "sn2.15:4.2": "материи-связанность превзошедший;",
 "sn2.15:4.3": "Радость-страсть полностью-исчерпавший,",
 "sn2.15:4.4": "тот в глубине не тонет”."
}
