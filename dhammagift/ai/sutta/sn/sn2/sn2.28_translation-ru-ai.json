{
 "sn2.28:0.1": "Связанные Наставления 2.28",
 "sn2.28:0.2": "3. Глава разных учителей",
 "sn2.28:0.3": "Нандивисаласутта",
 "sn2.28:1.1": "Рядом стоящий Нандивисала, сын дэвов, Благословенного стихом обратился:",
 "sn2.28:2.1": "“Четырёхколёсная, девятивратная,",
 "sn2.28:2.2": "полная корыстолюбием связанная;",
 "sn2.28:2.3": "В грязи рождённая, о великий герой,",
 "sn2.28:2.4": "как же выход будет?”",
 "sn2.28:3.1": "“Отрезав ремень и ремень-верёвку,",
 "sn2.28:3.2": "желание-корыстолюбие и плохое;",
 "sn2.28:3.3": "С корнем цепляние вырвав,",
 "sn2.28:3.4": "так выход будет”."
}
