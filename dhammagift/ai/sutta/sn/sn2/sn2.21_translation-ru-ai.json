{
 "sn2.21:0.1": "Связанные Наставления 2.21",
 "sn2.21:0.2": "3. Глава разных учителей",
 "sn2.21:0.3": "Сутта Сивы",
 "sn2.21:1.1": "Так мной услышано—",
 "sn2.21:1.2": "одно время Благословенный в Саваттхи располагается, в роще Джеты, в парке Анатхапиндики.",
 "sn2.21:1.3": "И тогда Сива, дэва-сын, предрассветной ночью, превосходного вида, осветив целиком рощу Джеты, подошёл к Благословенному; подойдя, Благословенного поприветствовав, с одного края встал.",
 "sn2.21:1.4": "С одного края стоящий Сива, дэва-сын, вблизи Благословенного эти строфы произнёс:",
 "sn2.21:2.1": "“С чистыми только сходитесь,",
 "sn2.21:2.2": "с чистыми делайте близость;",
 "sn2.21:2.3": "Чистых истинное-явление-Дхамму узнав,",
 "sn2.21:2.4": "лучше, а не хуже.",
 "sn2.21:3.1": "С чистыми только сходитесь,",
 "sn2.21:3.2": "с чистыми делайте близость;",
 "sn2.21:3.3": "Чистых истинное-явление-Дхамму узнав,",
 "sn2.21:3.4": "понимание получается, не от иного.",
 "sn2.21:4.1": "С чистыми только сходитесь,",
 "sn2.21:4.2": "с чистыми делайте близость;",
 "sn2.21:4.3": "Чистых истинное-явление-Дхамму узнав,",
 "sn2.21:4.4": "среди страдания не страдает.",
 "sn2.21:5.1": "С чистыми только сходитесь,",
 "sn2.21:5.2": "с чистыми делайте близость;",
 "sn2.21:5.3": "Чистых истинное-явление-Дхамму узнав,",
 "sn2.21:5.4": "среди родственников сияет.",
 "sn2.21:6.1": "С чистыми только сходитесь,",
 "sn2.21:6.2": "с чистыми делайте близость;",
 "sn2.21:6.3": "Чистых истинное-явление-Дхамму узнав,",
 "sn2.21:6.4": "существа идут в благую участь.",
 "sn2.21:7.1": "С чистыми только сходитесь,",
 "sn2.21:7.2": "с чистыми делайте близость;",
 "sn2.21:7.3": "Чистых истинное-явление-Дхамму узнав,",
 "sn2.21:7.4": "существа пребывают постоянно”.",
 "sn2.21:8.1": "И тогда Благословенный Сиву, дэва-сына, строфой ответил:",
 "sn2.21:9.1": "“С чистыми только сходитесь,",
 "sn2.21:9.2": "с чистыми делайте близость;",
 "sn2.21:9.3": "Чистых истинное-явление-Дхамму узнав,",
 "sn2.21:9.4": "от всей боли освобождается”."
}
