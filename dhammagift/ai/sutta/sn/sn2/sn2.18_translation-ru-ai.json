{
 "sn2.18:0.1": "Связанные Наставления 2.18",
 "sn2.18:0.2": "2. Анатхапиндикавагга",
 "sn2.18:0.3": "Сутта Какудха",
 "sn2.18:1.1": "Так мной услышано—",
 "sn2.18:1.2": "Одно время Благословенный в Сакете располагается, в Аньджанаване, в Оленьем парке.",
 "sn2.18:1.3": "И тогда дэва-сын Какудха предрассветной ночью, превосходного вида, осветив целиком Рощу Аньджаны, подошёл к Благословенному; подойдя, поприветствовав Благословенного, встал с одного края. И стоя с одного края, дэва-сын Какудха Благословенному это сказал:",
 "sn2.18:1.4": "“Радуешься, шраман?”",
 "sn2.18:1.5": "“Что обретено, товарищ?”",
 "sn2.18:1.6": "“Тогда, шраман, печалишься?”",
 "sn2.18:1.7": "“Что утрачено, товарищ?”",
 "sn2.18:1.8": "“Тогда, шраман, ни радуешься, ни печалишься?”",
 "sn2.18:1.9": "«Так, товарищ».",
 "sn2.18:2.1": "“Надеюсь, ты без-боли монах,",
 "sn2.18:2.2": "надеюсь, радость не находится;",
 "sn2.18:2.3": "Надеюсь, тебя одного сидящего,",
 "sn2.18:2.4": "неприязнь не накрывает”.",
 "sn2.18:3.1": "“Без-боли, воистину, я, яккха,",
 "sn2.18:3.2": "и после радость не находится;",
 "sn2.18:3.3": "И после меня одного сидящего,",
 "sn2.18:3.4": "неприязнь не накрывает”.",
 "sn2.18:4.1": "“Как ты без-боли монах,",
 "sn2.18:4.2": "как радость не находится;",
 "sn2.18:4.3": "Как тебя одного сидящего,",
 "sn2.18:4.4": "неприязнь не накрывает”.",
 "sn2.18:5.1": "“У боли-рождённого, воистину, радость,",
 "sn2.18:5.2": "у радости-рождённого, воистину, боль;",
 "sn2.18:5.3": "Без-радости, без-боли монах,",
 "sn2.18:5.4": "так знай, товарищ”.",
 "sn2.18:6.1": "“Спустя долгое время действительно вижу",
 "sn2.18:6.2": "брахмана, полностью угасшего;",
 "sn2.18:6.3": "Без-радостного, без-боли монаха,",
 "sn2.18:6.4": "переплывшего в мире прилипчивость”."
}
