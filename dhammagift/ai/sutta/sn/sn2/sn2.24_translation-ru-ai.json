{
 "sn2.24:0.1": "Связанные Наставления 2.24",
 "sn2.24:0.2": "Раздел разных учителей",
 "sn2.24:0.3": "Сутта Гхатикара",
 "sn2.24:1.1": "Встав с одного края, дэвапутта Горшечник вблизи Благословенного эту строфу произнес:",
 "sn2.24:2.1": "“В Авиху переродившись,",
 "sn2.24:2.2": "освобождённые семь монахов;",
 "sn2.24:2.3": "Страсть-и-злобу устранившие,",
 "sn2.24:2.4": "переплывшие в мире прилипчивость”.",
 "sn2.24:3.1": "“И кто же пересёк топь,",
 "sn2.24:3.2": "смерти-владение, столь трудно переходимое;",
 "sn2.24:3.3": "Кто, оставив человеческое тело,",
 "sn2.24:3.4": "божественную связь превзошёл”.",
 "sn2.24:4.1": "“Упако и Палагандо,",
 "sn2.24:4.2": "Пуккусати — те трое;",
 "sn2.24:4.3": "Бхаддийо, Кхандадево,",
 "sn2.24:4.4": "Бахурагги и Сангия;",
 "sn2.24:4.5": "Они, оставив человеческое тело,",
 "sn2.24:4.6": "божественную связь превзошёл”.",
 "sn2.24:5.1": "“Умело говоришь о тех,",
 "sn2.24:5.2": "Мары-силки отбросивших;",
 "sn2.24:5.3": "Чью Дхамму познав,",
 "sn2.24:5.4": "разрубили существования-окову”.",
 "sn2.24:6.1": "“Не иначе как от Благословенного,",
 "sn2.24:6.2": "не иначе как от твоего учения;",
 "sn2.24:6.3": "Чью Дхамму познав,",
 "sn2.24:6.4": "разрубили существования-окову.",
 "sn2.24:7.1": "Где и имя и материя",
 "sn2.24:7.2": "без остатка заканчиваются;",
 "sn2.24:7.3": "Ту Дхамму здесь познав,",
 "sn2.24:7.4": "разрубили существования-окову”.",
 "sn2.24:8.1": "“Глубокую произносишь речь,",
 "sn2.24:8.2": "Трудно-познаваемое, очень-трудно-понимаемое;",
 "sn2.24:8.3": "Чью ты Дхамму познав,",
 "sn2.24:8.4": "речь произносишь такую?”",
 "sn2.24:9.1": "“Гончаром прежде был,",
 "sn2.24:9.2": "в Векалинге горшечником;",
 "sn2.24:9.3": "Мать-отца содержателем был,",
 "sn2.24:9.4": "Кассапы последователем.",
 "sn2.24:10.1": "Воздерживающийся от половых явлений,",
 "sn2.24:10.2": "ведущий святую жизнь, не-плотской;",
 "sn2.24:10.3": "Был я твоим односельчанином,",
 "sn2.24:10.4": "был я твоим прежним другом.",
 "sn2.24:11.1": "И я этих знаю,",
 "sn2.24:11.2": "освобождённых семь монахов;",
 "sn2.24:11.3": "Страсть-вредность-полностью-истощивших,",
 "sn2.24:11.4": "переплывших в мире привязанность”.",
 "sn2.24:12.1": "“Так это тогда было,",
 "sn2.24:12.2": "как говоришь, Бхаггава;",
 "sn2.24:12.3": "Гончаром прежде был,",
 "sn2.24:12.4": "в Векалинге горшечником.",
 "sn2.24:13.1": "Мать-отца содержателем был,",
 "sn2.24:13.2": "Кассапы последователем;",
 "sn2.24:13.3": "Воздерживающийся от половых явлений,",
 "sn2.24:13.4": "ведущий святую жизнь, не-плотской;",
 "sn2.24:13.5": "Был ты моим односельчанином,",
 "sn2.24:13.6": "был ты моим прежним другом”.",
 "sn2.24:14.1": "“Так это прежних,",
 "sn2.24:14.2": "друзей была встреча;",
 "sn2.24:14.3": "Обоих развивших-себя,",
 "sn2.24:14.4": "тело-последнее-несущий”."
}
