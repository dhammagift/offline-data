{
 "sn2.12:0.1": "Связанные Наставления 2.12",
 "sn2.12:0.2": "2. Анатхапиндикавагга",
 "sn2.12:0.3": "Сутта Венду",
 "sn2.12:1.1": "Встав с одного края, божественный сын Венду вблизи Благословенного эту строфу произнес:",
 "sn2.12:2.1": "“Счастливы те люди,",
 "sn2.12:2.2": "Благого обслужив;",
 "sn2.12:2.3": "Следуя в Готамы наставлении,",
 "sn2.12:2.4": "Прилежные пусть учатся”.",
 "sn2.12:3.1": "“Которые мной изложенные в наставлении-строфах,",
 "sn2.12:3.2": "(Венду, — Благословенный),",
 "sn2.12:3.3": "Изучают медитирующие;",
 "sn2.12:3.4": "Вовремя те, не-беспечными будучи,",
 "sn2.12:3.5": "Под власть смерти не пойдут”."
}
