{
 "sn2.17:0.1": "Связанные Наставления 2.17",
 "sn2.17:0.2": "2. Анатхапиндикавагга",
 "sn2.17:0.3": "Сутта Субрахма",
 "sn2.17:1.1": "И с одной стороны стоявший Субрахма, сын дэвов, Благословенного строфой обратился:",
 "sn2.17:2.1": "“Постоянно испугано это ум-состояние,",
 "sn2.17:2.2": "постоянно встревожен этот ум-представление;",
 "sn2.17:2.3": "О невозникших трудностях,",
 "sn2.17:2.4": "а после и о возникших;",
 "sn2.17:2.5": "Если есть неиспуганное,",
 "sn2.17:2.6": "то мне скажи, спрошенный”.",
 "sn2.17:3.1": "“Не иначе как пробуждением, аскезой,",
 "sn2.17:3.2": "не иначе как сдерживанием способностей;",
 "sn2.17:3.3": "Не иначе как полным оставлением всего,",
 "sn2.17:3.4": "благополучие вижу для живых существ”.",
 "sn2.17:4.1": "Это сказал …",
 "sn2.17:4.2": "тут же исчез."
}
