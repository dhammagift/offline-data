{
 "sn2.7:0.1": "Связанные Наставления 2.7",
 "sn2.7:0.2": "1. Первая Глава",
 "sn2.7:0.3": "Сутта Панчалачанда",
 "sn2.7:1.1": "В условиях Саваттхи.",
 "sn2.7:1.2": "Встав рядом, дэва-сын Панчалачанда в присутствии Благословенного эту строфу произнес:",
 "sn2.7:2.1": "“В тесноте, действительно, пространство",
 "sn2.7:2.2": "Обрел великомудрый;",
 "sn2.7:2.3": "Который джхану пробудил, пробужденный,",
 "sn2.7:2.4": "Уединенный бык-мудрец”.",
 "sn2.7:3.1": "“В тесноте также обретают,",
 "sn2.7:3.2": "(Панчалачанда, — Благословенный,)",
 "sn2.7:3.3": "Явление для ниббана-достижения;",
 "sn2.7:3.4": "Которые памятование обрели,",
 "sn2.7:3.5": "Правильно те хорошо сосредоточены”."
}
