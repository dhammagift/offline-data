{
 "sn55.50:0.1": "Связанные Наставления 55.50",
 "sn55.50:0.2": "5. Раздел с заслугами-потоками в стихах",
 "sn55.50:0.3": "Сутта Аспектов",
 "sn55.50:1.1": "“Четыре эти, монахи, аспекты вступления-в-поток.",
 "sn55.50:1.2": "Какие четыре?",
 "sn55.50:1.3": "Ассоциированность с высшими людьми, слышание подлинной Дхаммы, представление у истока, практика Дхаммы по Дхамме—",
 "sn55.50:1.4": "Вот эти, монахи, четыре аспекта вступления-в-поток”.",
 "sn55.50:1.5": "Десятая.",
 "sn55.50:1.6": "Глава Потоков-блага Пятая.",
 "sn55.50:2.0": "Оглавление",
 "sn55.50:2.1": "Потоки три сказаны,",
 "sn55.50:2.2": "Два с великим-богатством;",
 "sn55.50:2.3": "Чистый, Нандия, Бхаддия,",
 "sn55.50:2.4": "Маханама с аспектом те десять."
}
