{
 "sn55.74:0.1": "Связанные Наставления 55.74",
 "sn55.74:0.2": "7. Раздел Махапаннья",
 "sn55.74:0.3": "Сутта Проникающе-Понимания",
 "sn55.74:1.1": "“… К проникающе-пониманию приводят.",
 "sn55.74:1.2": "Какие четыре?",
 "sn55.74:1.3": "Ассоциированность с высшими людьми, слышание подлинной Дхаммы, представление у истока, практика Дхаммы по Дхамме—",
 "sn55.74:1.4": "Вот эти, монахи, четыре явления развитые, прумноженные к проникающе-пониманию приводят”.",
 "sn55.74:1.5": "Тринадцатая.",
 "sn55.74:1.6": "Глава Велико-Понимания Седьмая.",
 "sn55.74:2.0": "Оглавление",
 "sn55.74:2.1": "Великое, многообразное, глубокое,",
 "sn55.74:2.2": "Не-поверхностное, обширное, обильное;",
 "sn55.74:2.3": "Быстрое, лёгкое, радостное, стремительное,",
 "sn55.74:2.4": "Острое и проникающее.",
 "sn55.74:2.5": "Связанные Наставления о Услышавшем Одиннадцатая."
}
