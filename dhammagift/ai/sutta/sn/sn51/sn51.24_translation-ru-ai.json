{
 "sn51.24:0.1": "Связанные Наставления 51.24",
 "sn51.24:0.2": "3. Железный-шар-раздел",
 "sn51.24:0.3": "Сутта Чистая",
 "sn51.24:1.1": "“Четыре эти, монахи, основы сверхспособностей.",
 "sn51.24:1.2": "Какие четыре?",
 "sn51.24:1.3": "Вот, монахи, монах развивает основу сверхспособностей импульсо-самадхи-старания-складыванием наделенную,",
 "sn51.24:1.4": "решимости-самадхи…",
 "sn51.24:1.5": "умо-состояние-самадхи …",
 "sn51.24:1.6": "исследования-самадхи-старания-составляющими наделенную сверхсил-основу развивает—",
 "sn51.24:1.7": "Вот эти, монахи, четыре сверхспособностейосновы”.",
 "sn51.24:1.8": "Четвёртая."
}
