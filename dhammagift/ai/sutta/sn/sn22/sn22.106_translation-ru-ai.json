{
 "sn22.106:0.1": "Связанные Наставления 22.106",
 "sn22.106:0.2": "11. Антавагго",
 "sn22.106:0.3": "Париньнейясутта",
 "sn22.106:1.1": "В условиях Саваттхи.",
 "sn22.106:1.2": "“Должные-быть-понятыми, монахи, явления буду учить, и всестороннее понимание, и всесторонне-понявшего индивида.",
 "sn22.106:1.3": "Услышьте это.",
 "sn22.106:1.4": "И что такое, монахи, должные-быть-поняты явления?",
 "sn22.106:1.5": "Форма, монахи, — должное-быть-понятым явление.",
 "sn22.106:1.6": "Чувствование …",
 "sn22.106:1.7": "сознавание…",
 "sn22.106:1.8": "отождествления…",
 "sn22.106:1.9": "внимание — должное-быть-понятым явление.",
 "sn22.106:1.10": "Те зовутся, монахи, должные-быть-поняты явления.",
 "sn22.106:1.11": "И что такое, монахи, всестороннее понимание?",
 "sn22.106:1.12": "Исчерпание страсти, исчерпание злобы, исчерпание замутненности—",
 "sn22.106:1.13": "это называется, монахи, всестороннее понимание.",
 "sn22.106:1.14": "И кто, монахи, всесторонне-понявший индивид?",
 "sn22.106:1.15": "Арахант следует ответить.",
 "sn22.106:1.16": "Этот уважаемый, так-имя, так-род—",
 "sn22.106:1.17": "это называется, монахи, всесторонне-понявший индивид”.",
 "sn22.106:1.18": "Четвёртая."
}
