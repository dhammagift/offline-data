{
 "sn22.32:0.1": "Связанные Наставления 22.32",
 "sn22.32:0.2": "3. Раздел Бхара",
 "sn22.32:0.3": "Сутта Разрушимость",
 "sn22.32:1.1": "В условиях Саваттхи.",
 "sn22.32:1.2": "“Разрушимость, монахи, буду учить и не-разрушимость.",
 "sn22.32:1.3": "Услышьте это.",
 "sn22.32:1.4": "Что, монахи, разрушимость, что не-разрушимость?",
 "sn22.32:1.5": "Форма, монахи, разрушимость.",
 "sn22.32:1.6": "Её устранение, выравнивание, исчезновение — это не-разрушимость.",
 "sn22.32:1.7": "Чувствование — разрушимость.",
 "sn22.32:1.8": "Его устранение, выравнивание, исчезновение — это не-разрушимость.",
 "sn22.32:1.9": "Сознавание — разрушимость …",
 "sn22.32:1.10": "отождествления — разрушимость.",
 "sn22.32:1.11": "Их устранение, выравнивание, исчезновение — это не-разрушимость.",
 "sn22.32:1.12": "Внимание — разрушимость.",
 "sn22.32:1.13": "Его устранение, выравнивание, исчезновение — это не-разрушимость”.",
 "sn22.32:1.14": "Одиннадцатая.",
 "sn22.32:1.15": "Глава Бхара Третья.",
 "sn22.32:2.0": "Оглавление",
 "sn22.32:2.1": "Ноша, всестороннее понимание, познание,",
 "sn22.32:2.2": "импульс-страсть — четвёртое;",
 "sn22.32:2.3": "Привлекательности три названы,",
 "sn22.32:2.4": "радость — восьмое;",
 "sn22.32:2.5": "Возникновение, корень-беда и",
 "sn22.32:2.6": "одиннадцатое — разрушимость."
}
