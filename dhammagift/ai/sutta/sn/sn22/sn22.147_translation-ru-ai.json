{
 "sn22.147:0.1": "Связанные Наставления 22.147",
 "sn22.147:0.2": "14. Глава Головешки",
 "sn22.147:0.3": "Сутта Нестабильность-наблюдающий",
 "sn22.147:1.1": "В условиях Саваттхи.",
