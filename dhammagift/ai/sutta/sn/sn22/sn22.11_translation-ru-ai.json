{
 "sn22.11:0.1": "Связанные Наставления 22.11",
 "sn22.11:0.2": "1. Глава Накулапиту",
 "sn22.11:0.3": "Сутта Трёхвременной Безличностности",
 "sn22.11:1.1": "В условиях Саваттхи.",
 "sn22.11:1.2": "“Форма, монахи, безличностна — прошлая и будущая;",
 "sn22.11:1.3": "что уж говорить о текущей.",
 "sn22.11:1.4": "Так видя, монахи, обученный благородный последователь на прошедшую рупу не озирающимся является;",
 "sn22.11:1.5": "грядущей рупе не обрадывается;",
 "sn22.11:1.6": "текущей рупы незаинтересованности бесстрастию устранению практикующим является.",
 "sn22.11:1.7": "Чувствование безличностно…",
 "sn22.11:1.8": "сознавание безличностно…",
 "sn22.11:1.9": "отождествления безличностны…",
 "sn22.11:1.10": "распознавание безличностно — прошлое и будущее;",
 "sn22.11:1.11": "что уж говорить о текущей.",
 "sn22.11:1.12": "Так видя, монахи, обученный благородный последователь на прошедшее вниманием не озирающимся является;",
 "sn22.11:1.13": "грядущему вниманию не обрадывается;",
 "sn22.11:1.14": "текущего внимания незаинтересованности бесстрастию устранению практикующим является”.",
 "sn22.11:1.15": "Одиннадцатая.",
 "sn22.11:1.16": "Глава Накулапиту Первая.",
 "sn22.11:2.0": "Оглавление",
 "sn22.11:2.1": "Накулапита из Девадахи,",
 "sn22.11:2.2": "И две [сутты] о Халиддикани;",
 "sn22.11:2.3": "Самадхи и Уединение,",
 "sn22.11:2.4": "Поддерживание и Тревога — две;",
 "sn22.11:2.5": "Прошлое, Будущее, Настоящее —",
 "sn22.11:2.6": "Глава этой называется."
}
