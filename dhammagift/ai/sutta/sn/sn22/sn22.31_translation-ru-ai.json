{
 "sn22.31:0.1": "Связанные Наставления 22.31",
 "sn22.31:0.2": "3. Раздел Бхара",
 "sn22.31:0.3": "Сутта Корень-беды",
 "sn22.31:1.1": "В условиях Саваттхи.",
 "sn22.31:1.2": "“Беду, монахи, преподам и корень-беды.",
 "sn22.31:1.3": "Услышьте это.",
 "sn22.31:1.4": "И что такое, монахи, беда?",
 "sn22.31:1.5": "Материя, монахи, беда, чувствование беда, сознавание беда, отождествления беда, внимание беда.",
 "sn22.31:1.6": "Это называется, монахи, беда.",
 "sn22.31:1.7": "И что такое, монахи, корень-беды?",
 "sn22.31:1.8": "В котором цепляние-прилипание повторяющееся, с радостью-страстью-схожее здесь-и-здесь-обрадывающееся;",
 "sn22.31:1.9": "А именно: желания-цепляние, бытия-цепляние, разлучения-цепляние.",
 "sn22.31:1.10": "Это называется, монахи, корень-беды”.",
 "sn22.31:1.11": "Десятая."
}
