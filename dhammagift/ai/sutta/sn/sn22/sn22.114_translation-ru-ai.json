{
 "sn22.114:0.1": "Связанные Наставления 22.114",
 "sn22.114:0.2": "12. Раздел Дхаммакатхика",
 "sn22.114:0.3": "Сутта Различение",
 "sn22.114:1.1": "В условиях Саваттхи.",
 "sn22.114:1.2": "И с одной стороны севший тот монах Благословенному это сказал:",
 "sn22.114:1.3": "“‘Различение, различение’, почтенный, говорится.",
 "sn22.114:1.4": "Каково это, почтенный, различение;",
 "sn22.114:1.5": "и в каком плане различающий”",
 "sn22.114:1.6": "“Вот, монах, обученный благородный последователь материю понимает, материи-скапливание … материи-устранение … к материи-устранению ведущую практику понимает.",
 "sn22.114:1.7": "Чувствование …",
 "sn22.114:1.8": "сознавание …",
 "sn22.114:1.9": "отождествления понимает …",
 "sn22.114:1.10": "к внимания-устранению ведущую практику понимает.",
 "sn22.114:1.11": "Это называется, монах, различение;",
 "sn22.114:1.12": "и в таком плане различающий”",
 "sn22.114:1.13": "Вторая."
}
