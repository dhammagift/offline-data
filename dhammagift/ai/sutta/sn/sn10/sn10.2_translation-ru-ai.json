{
 "sn10.2:0.1": "Связанные Наставления 10.2",
 "sn10.2:0.2": "Раздел Индаки",
 "sn10.2:0.3": "Сутта Сакка-имя",
 "sn10.2:1.1": "Одно время Благословенный располагается в Раджагахе на горе Пик Грифов.",
 "sn10.2:1.2": "И тогда Сакка-имяк-яккха, где Благословенный туда подошёл; подойдя Благословенного строфой обратился:",
 "sn10.2:2.1": "“У всех-узлов-отбросившего,",
 "sn10.2:2.2": "освобождённого тебя памятующего;",
 "sn10.2:2.3": "Шраману это не хорошо,",
 "sn10.2:2.4": "когда другого наставляешь”.",
 "sn10.2:3.1": "“Каким-либо образом,",
 "sn10.2:3.2": "сожительство, Сакка, возникает;",
 "sn10.2:3.3": "То не достоин имеющий-понимание,",
 "sn10.2:3.4": "умом сострадать.",
 "sn10.2:4.1": "Если умом ясным,",
 "sn10.2:4.2": "что другого наставляет;",
 "sn10.2:4.3": "Тем не становится связан,",
 "sn10.2:4.4": "какое-сострадание, какая-забота”."
}
