{
 "sn10.7:0.1": "Связанные Наставления 10.7",
 "sn10.7:0.2": "Раздел Индаки",
 "sn10.7:0.3": "Сутта Пунаббасу",
 "sn10.7:1.1": "Одно время Благословенный в Саваттхи располагается, в роще Джеты, в парке Анатхапиндики.",
 "sn10.7:1.2": "В то же время Благословенный монахов к ниббане-относящейся наставительной беседой наставляет, воодушевляет, вдохновляет, радует.",
 "sn10.7:1.3": "И те монахи, сделав [это] костью, сделав [это] умом, всем разумом собравшись, склонив ухо, Дхамму слушают.",
 "sn10.7:1.4": "И тогда яккхини мать Пунаббасу детей так успокаивала:",
 "sn10.7:2.1": "“Тише, Уттарика, будь,",
 "sn10.7:2.2": "тише будь, Пунаббасу;",
 "sn10.7:2.3": "Пока я Будды-лучшего,",
 "sn10.7:2.4": "Дхамму услышу Учителя.",
 "sn10.7:3.1": "Ниббану Благословенный говорит,",
 "sn10.7:3.2": "всех уз освобождение;",
 "sn10.7:3.3": "И чрезвычайна у меня есть,",
 "sn10.7:3.4": "в этом явлении привязанность.",
 "sn10.7:4.1": "Мил в мире свой сын,",
 "sn10.7:4.2": "мил в мире свой муж;",
 "sn10.7:4.3": "Чем то милее для меня,",
 "sn10.7:4.4": "этого явления поиск.",
 "sn10.7:5.1": "Ведь ни сын, ни муж,",
 "sn10.7:5.2": "милый, от боли не освободит;",
 "sn10.7:5.3": "Как слышание подлинной Дхаммы",
 "sn10.7:5.4": "от боли освобождает живых существ.",
 "sn10.7:6.1": "В мире, болью охваченном,",
 "sn10.7:6.2": "старением-умиранием связанном;",
 "sn10.7:6.3": "Ради освобождения от старения-умирания,",
 "sn10.7:6.4": "какое явление полностью пробуждено;",
 "sn10.7:6.5": "То явление услышать хочу,",
 "sn10.7:6.6": "Молчи, Пунаббасу”.",
 "sn10.7:7.1": "“Мама, я не заговорю,",
 "sn10.7:7.2": "молчалива эта Уттара;",
 "sn10.7:7.3": "Дхамму же слушай,",
 "sn10.7:7.4": "слышание подлинной Дхаммы — приятно;",
 "sn10.7:7.5": "Подлинной Дхаммы не зная,",
 "sn10.7:7.6": "мама, с болью мы живём.",
 "sn10.7:8.1": "Этот дэвов и людей,",
 "sn10.7:8.2": "заблудших, рассеивающий тьму;",
 "sn10.7:8.3": "Будда, последнее тело имеющий,",
 "sn10.7:8.4": "Дхамму показывает зрячий”.",
 "sn10.7:9.1": "“Хорошо ведь мудрецом зовётся,",
 "sn10.7:9.2": "сын, рождённый от груди;",
 "sn10.7:9.3": "Сын мой высочайшего Будды,",
 "sn10.7:9.4": "Дхамму чистую любит.",
 "sn10.7:10.1": "Пунаббасу, будь счастлив,",
 "sn10.7:10.2": "сегодня я поднялась;",
 "sn10.7:10.3": "Увиденные Благородные Истины,",
 "sn10.7:10.4": "и Уттара пусть услышит меня”."
}
