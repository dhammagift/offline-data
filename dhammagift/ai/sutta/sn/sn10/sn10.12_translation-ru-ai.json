{
 "sn10.12:0.1": "Связанные Наставления 10.12",
 "sn10.12:0.2": "1. Глава Индаки",
 "sn10.12:0.3": "Сутта Алаваки",
 "sn10.12:1.1": "Так мной услышано—",
 "sn10.12:1.2": "Одно время Благословенный в Алави располагается, в обители яккхи Алаваки.",
 "sn10.12:1.3": "И тогда яккха Алавака, где Благословенный туда подошёл; подойдя Благословенному это сказал:",
 "sn10.12:1.4": "“Выходи, шраман”.",
 "sn10.12:1.5": "“Хорошо, товарищ”, — Благословенный вышел.",
 "sn10.12:1.6": "“Входи, шраман”.",
 "sn10.12:1.7": "“Хорошо, товарищ”, — Благословенный вошёл.",
 "sn10.12:1.8": "Во второй раз яккха Алавака Благословенному это сказал:",
 "sn10.12:1.9": "“Выходи, шраман”.",
 "sn10.12:1.10": "“Хорошо, товарищ”, — Благословенный вышел.",
 "sn10.12:1.11": "“Входи, шраман”.",
 "sn10.12:1.12": "“Хорошо, товарищ”, — Благословенный вошёл.",
 "sn10.12:1.13": "В третий раз яккха Алавака Благословенному это сказал:",
 "sn10.12:1.14": "“Выходи, шраман”.",
 "sn10.12:1.15": "“Хорошо, товарищ”, — Благословенный вышел.",
 "sn10.12:1.16": "“Входи, шраман”.",
 "sn10.12:1.17": "“Хорошо, товарищ”, — Благословенный вошёл.",
 "sn10.12:1.18": "В четвёртый раз яккха Алавака Благословенному это сказал:",
 "sn10.12:1.19": "“Выходи, шраман”.",
 "sn10.12:1.20": "“Я тебе, товарищ, не выйду.",
 "sn10.12:1.21": "Которое тобой должно быть сделано то делай”.",
 "sn10.12:1.22": "“Вопрос тебя, шраман, спрошу.",
 "sn10.12:1.23": "Если мне не ответишь, ум-состояние твоё разобью, или сердце твоё расколю, или за ноги взяв за Ганг выброшу”.",
 "sn10.12:1.24": "“Я тебя, товарищ, не вижу в мире с божествами, с Марой и Брахмой, с шраманами и брахманами, с поколением королей-божеств и людей, кто моё ум-состояние бы отбросил или сердце бы расколол, или за ноги схватив за Ганг бы отбросил.",
 "sn10.12:1.25": "Но ты, товарищ, спроси, когда сомневаешься”.",
 "sn10.12:2.1": "“Что здесь богатство человека наилучшее?",
 "sn10.12:2.2": "Что хорошо сделанное приятное приносит?",
 "sn10.12:2.3": "Что же из вкусов слаще?",
 "sn10.12:2.4": "Как живущего жизнь называют наилучшей?”",
 "sn10.12:3.1": "“Вера здесь богатство человека наилучшее,",
 "sn10.12:3.2": "Дхамма хорошо сделанная приятное приносит;",
 "sn10.12:3.3": "Истина же из вкусов слаще,",
 "sn10.12:3.4": "Пониманием живущего жизнь называют наилучшей.”",
 "sn10.12:4.1": "“Как же пересекает затопление,",
 "sn10.12:4.2": "как пересекает океан?",
 "sn10.12:4.3": "Как боль преодолевает,",
 "sn10.12:4.4": "как очищается?”",
 "sn10.12:5.1": "“Верой пересекает затопление,",
 "sn10.12:5.2": "не-беспечностью океан;",
 "sn10.12:5.3": "Решимостью боль преодолевает,",
 "sn10.12:5.4": "пониманием очищается”.",
 "sn10.12:6.1": "“Как же обретает понимание,",
 "sn10.12:6.2": "как же находит богатство;",
 "sn10.12:6.3": "Как же признанье достигает,",
 "sn10.12:6.4": "как же друзей привязывает;",
 "sn10.12:6.5": "Из этого мира в другой мир,",
 "sn10.12:6.6": "как же уйдя не страдает”.",
 "sn10.12:7.1": "“Веря в арахантов,",
 "sn10.12:7.2": "Дхамму ради ниббаны-достижения;",
 "sn10.12:7.3": "Слушая, обретает понимание,",
 "sn10.12:7.4": "старательный, проницательный.",
 "sn10.12:8.1": "Подобающе-действующий, усердный,",
 "sn10.12:8.2": "поднимающийся находит богатство;",
 "sn10.12:8.3": "Правдивостью признанье достигает,",
 "sn10.12:8.4": "давая, друзей привязывает;",
 "sn10.12:8.5": "Из этого мира в другой мир,",
 "sn10.12:8.6": "так уйдя не страдает.",
 "sn10.12:9.1": "У кого эти четыре явления,",
 "sn10.12:9.2": "верующего домохозяина-ищущего;",
 "sn10.12:9.3": "Правдивость, Дхамма, стойкость, оставление,",
 "sn10.12:9.4": "он, уйдя, не страдает.",
 "sn10.12:10.1": "Ну-ка и других спроси,",
 "sn10.12:10.2": "многих шраманов и брахманов;",
 "sn10.12:10.3": "Если от правдивости, Дхаммы, оставления,",
 "sn10.12:10.4": "терпения больше здесь находится”.",
 "sn10.12:11.1": "“Как же теперь спрошу",
 "sn10.12:11.2": "многих шраманов и брахманов;",
 "sn10.12:11.3": "Кто я сегодня понимаю,",
 "sn10.12:11.4": "и польза, которая иная превыше.",
 "sn10.12:12.1": "Для пользы, поистине, мне Пробуждённый,",
 "sn10.12:12.2": "для проживания в Алави пришёл;",
 "sn10.12:12.3": "Кто я сегодня понимаю,",
 "sn10.12:12.4": "где даваемое великоплодно.",
 "sn10.12:13.1": "Так я буду странствовать,",
 "sn10.12:13.2": "из деревни в деревню, из города в город;",
 "sn10.12:13.3": "почитая Полностью-Пробуждённого,",
 "sn10.12:13.4": "и Дхаммы превосходную Дхамму”.",
 "sn10.12:13.5": "Глава Индака Первая.",
 "sn10.12:14.0": "Оглавление",
 "sn10.12:14.1": "Индака, Сакка, Сучи и,",
 "sn10.12:14.2": "Манибхадда и Сану;",
 "sn10.12:14.3": "Пиянкара, Пунаббасу, Судатта и,",
 "sn10.12:14.4": "Две Сукки, Чира и Алави — двенадцать.",
 "sn10.12:14.5": "Яккхасаньютта завершена."
}
