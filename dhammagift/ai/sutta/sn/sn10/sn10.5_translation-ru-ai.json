{
 "sn10.5:0.1": "Связанные Наставления 10.5",
 "sn10.5:0.2": "1. Глава Индаки",
 "sn10.5:0.3": "Сутта Сану",
 "sn10.5:1.1": "Одно время Благословенный в Саваттхи располагается, в роще Джеты, в парке Анатхапиндики.",
 "sn10.5:1.2": "В то же время у некой мирянки сын по имени Сану яккхой был схвачен.",
 "sn10.5:1.3": "И тогда та мирянка, плача, по этому случаю эти строфы произнесла:",
 "sn10.5:2.1": "“Четырнадцатый, пятнадцатый,",
 "sn10.5:2.2": "и который половины месяца восьмой;",
 "sn10.5:2.3": "И чудесная половина месяца,",
 "sn10.5:2.4": "восьмичастно-хорошо-собранную.",
 "sn10.5:3.1": "Упосатху соблюдают,",
 "sn10.5:3.2": "святую жизнь ведут те;",
 "sn10.5:3.3": "С ними яккхи не играют,",
 "sn10.5:3.4": "так мной от арахантов услышано;",
 "sn10.5:3.5": "Теперь же сегодня вижу,",
 "sn10.5:3.6": "яккхи играют с Сану”.",
 "sn10.5:4.1": "“Четырнадцатый, пятнадцатый,",
 "sn10.5:4.2": "и который половины месяца восьмой;",
 "sn10.5:4.3": "И чудесная половина месяца,",
 "sn10.5:4.4": "восьмичастно-хорошо-собранную;",
 "sn10.5:5.1": "Упосатху соблюдают,",
 "sn10.5:5.2": "святую жизнь ведут те.",
 "sn10.5:5.3": "С ними яккхи не играют,",
 "sn10.5:5.4": "хорошо тобой от арахантов услышано;",
 "sn10.5:6.1": "Сану пробуждённому скажи,",
 "sn10.5:6.2": "яккхов речь эту;",
 "sn10.5:6.3": "Не делай плохую активность,",
 "sn10.5:6.4": "явно или если втайне.",
 "sn10.5:7.1": "Если же плохую активность,",
 "sn10.5:7.2": "будешь делать или делаешь;",
 "sn10.5:7.3": "Тебе от боли нет освобождения,",
 "sn10.5:7.4": "взлетев, убегает”.",
 "sn10.5:8.1": "“Мёртвого, мама, оплакивают,",
 "sn10.5:8.2": "или того, кто живой не виден;",
 "sn10.5:8.3": "Живого, мама, видят,",
 "sn10.5:8.4": "почему же меня, мама, оплакиваешь?”.",
 "sn10.5:9.1": "“Мёртвого, сын, оплакивают,",
 "sn10.5:9.2": "или того, кто живой не виден;",
 "sn10.5:9.3": "А кто, желания оставив,",
 "sn10.5:9.4": "сюда возвращается;",
 "sn10.5:9.5": "Того, сын, оплакивают,",
 "sn10.5:9.6": "ведь живой он снова мёртв.",
 "sn10.5:10.1": "Из раскалённых углей извлечённый, дорогой,",
 "sn10.5:10.2": "в раскалённые угли упасть желаешь;",
 "sn10.5:10.3": "Из ада извлечённый, дорогой,",
 "sn10.5:10.4": "в ад упасть желаешь.",
 "sn10.5:11.1": "Бегите, достопочтенный,",
 "sn10.5:11.2": "кому мы пожалуемся;",
 "sn10.5:11.3": "Воспламенённое вынесенное добро",
 "sn10.5:11.4": "снова сжечь желаешь”."
}
