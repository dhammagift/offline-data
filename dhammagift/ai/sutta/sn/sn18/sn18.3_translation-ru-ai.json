{
 "sn18.3:0.1": "Связанные Наставления 18.3",
 "sn18.3:0.2": "1. Первая Глава",
 "sn18.3:0.3": "Сутта Внимание-распознавание",
 "sn18.3:1.1": "В Саваттхи располагается.",
 "sn18.3:1.2": "“То Как представляешь, Рахула,",
 "sn18.3:1.3": "зрительное внимание-распознавание надёжно или ненадёжно?”",
 "sn18.3:1.4": "“Ненадёжно, почтенный” …",
 "sn18.3:1.5": "“ухо-внимание …",
 "sn18.3:1.6": "носо-внимание …",
 "sn18.3:1.7": "языковое внимание…",
 "sn18.3:1.8": "тело-внимание …",
 "sn18.3:1.9": "умо-внимание надёжно или ненадёжно?”",
 "sn18.3:1.10": "“Ненадёжно, почтенный” …",
 "sn18.3:1.11": "“Так видящий, Рахула, обученный последователь Благородного к глазо-вниманию теряет интерес … к ухо-вниманию теряет интерес … к носо-вниманию теряет интерес … к языко-вниманию теряет интерес … к тело-вниманию теряет интерес … к умо-вниманию теряет интерес;",
 "sn18.3:1.12": "Не находящийся, он становится беспристрастным…",
 "sn18.3:1.13": "понимает”.",
 "sn18.3:1.14": "Третья."
}
