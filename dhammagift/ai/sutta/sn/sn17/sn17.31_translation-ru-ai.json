{
 "sn17.31:0.1": "Связанные Наставления 17.31",
 "sn17.31:0.2": "Раздел Четвёртый",
 "sn17.31:0.3": "Сутта Раскола",
 "sn17.31:1.1": "В Саваттхи располагается.",
 "sn17.31:1.2": "“Сурова, монахи, приобретение-уважение-слава.",
 "sn17.31:1.3": "Обретением-уважением-славой покорённый, умом-состоянием захваченный, монахи, Девадатта Сангху расколол.",
 "sn17.31:1.4": "Так суровы, монахи, приобретение-почтение-известность …",
 "sn17.31:1.5": "нужно тренироваться”.",
 "sn17.31:1.6": "Первая."
