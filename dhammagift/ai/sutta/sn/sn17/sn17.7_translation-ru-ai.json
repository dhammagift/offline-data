{
 "sn17.7:0.1": "Связанные Наставления 17.7",
 "sn17.7:0.2": "1. Первая Глава",
 "sn17.7:0.3": "Сутта Дротик",
 "sn17.7:1.1": "В Саваттхи располагается.",
 "sn17.7:1.2": "“Суровы, монахи, приобретение-почтение-известность … для достижения.",
 "sn17.7:1.3": "Кого, монахи, отравленным дротиком пронзённого, ученика, не достигшего умом, приобретение-уважение-известность настигает.",
 "sn17.7:2.1": "“Дротик”, монахи, – приобретения-уважения-известности это обозначение.",
 "sn17.7:2.2": "Так суровы, монахи, приобретение-почтение-известность …",
 "sn17.7:2.3": "так вот вам, монахи, должно тренироваться”.",
 "sn17.7:2.4": "Седьмая."
}
