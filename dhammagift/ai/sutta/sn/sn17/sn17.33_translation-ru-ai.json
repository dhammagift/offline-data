{
 "sn17.33:0.1": "Связанные Наставления 17.33",
 "sn17.33:0.2": "Раздел Четвёртый",
 "sn17.33:0.3": "Сутта Благотворной Дхаммы",
 "sn17.33:1.1": "В Саваттхи располагается.",
 "sn17.33:1.2": "“Сурова, монахи, приобретение-уважение-слава.",
