{
 "sn48.20:0.1": "Связанные Наставления 48.20",
 "sn48.20:0.2": "2. Раздел Мудутара",
 "sn48.20:0.3": "Сутта Исчерпание Истечений",
 "sn48.20:1.1": "“Эти пять, монахи, способностей.",
 "sn48.20:1.2": "Какие пять?",
 "sn48.20:1.3": "Способность веры… способность понимания—",
 "sn48.20:1.4": "вот эти, монахи, пять способностей.",
 "sn48.20:1.5": "И от развитости этих, монахи, пяти способностей, от преумноженности монах истечений исчерпания безистечений разума-высвобождение понимания-высвобождением в видимой действительности лично познав засвидетельствовав (своими глазам) достигнув пребывает”.",
 "sn48.20:1.6": "Десятая.",
 "sn48.20:1.7": "Раздел Мягко-Острый Второй.",
 "sn48.20:2.0": "Оглавление",
 "sn48.20:2.1": "Обретение три сжато,",
 "sn48.20:2.2": "подробно другие три;",
 "sn48.20:2.3": "Практикующий и завершённый,",
 "sn48.20:2.4": "десятая исчерпание-истечений."
}
