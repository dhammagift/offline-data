{
 "sn14.27:0.1": "Связанные Наставления 14.27",
 "sn14.27:0.2": "Раздел Пути-Активности",
 "sn14.27:0.3": "Сутта Десяти Путей Активности",
 "sn14.27:1.1": "В Саваттхи располагается.",
 "sn14.27:1.2": "“По дхату, монахи, существа сходятся, стекаются.",
 "sn14.27:1.3": "Уменьшающие жизнь с уменьшающими жизнь вместе стекаются, сходятся;",
 "sn14.27:1.4": "неданное-берущие …",
 "sn14.27:1.5": "в-желаниях-ошибочно-ведущие себя …",
 "sn14.27:1.6": "ложно-утверждающие …",
 "sn14.27:1.7": "розняще-высказывающиеся …",
 "sn14.27:1.8": "жестко-высказывающиеся …",
 "sn14.27:1.9": "пустословящие с пустословящими стекаются, сходятся;",
 "sn14.27:1.10": "алчные с алчными стекаются, сходятся;",
 "sn14.27:1.11": "с-враждебным-умом с с-враждебным-умом стекаются, сходятся;",
 "sn14.27:1.12": "с-ошибочным-взглядом с с-ошибочным-взглядом стекаются, сходятся.",
 "sn14.27:2.1": "От уменьшения жизни отказавшиеся с от уменьшения жизни отказавшимися вместе стекаются, сходятся;",
 "sn14.27:2.2": "от неданного-взятия отказавшиеся …",
 "sn14.27:2.3": "от в-желаниях-ошибочного-поведения отказавшиеся…",
 "sn14.27:2.4": "от ложно-утверждения отказавшиеся…",
 "sn14.27:2.5": "от рознящей речи …",
 "sn14.27:2.6": "от жесткой речи …",
 "sn14.27:2.7": "от пустословия отказавшиеся с от пустословия отказавшимися стекаются, сходятся;",
 "sn14.27:2.8": "без-алчные с без-алчными стекаются, сходятся;",
 "sn14.27:2.9": "с-без-враждебным-умом с с-без-враждебным-умом стекаются, сходятся;",
 "sn14.27:2.10": "с-правильным-взглядом с с-правильным-взглядом стекаются, сходятся”.",
 "sn14.27:2.11": "Пятая."
}
