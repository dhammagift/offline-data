{
 "sn14.22:0.1": "Связанные Наставления 14.22",
 "sn14.22:0.2": "2. Вторая Глава",
 "sn14.22:0.3": "Сутта с корнем в лени",
 "sn14.22:1.1": "В Саваттхи располагается.",
 "sn14.22:1.2": "“По дхату, монахи, существа сходятся, стекаются.",
 "sn14.22:1.3": "Ленивые с ленивыми стекаются, сходятся;",
 "sn14.22:1.4": "с-потерянным-памятованием с-потерянным-памятованием вместе сходятся, стекаются;",
 "sn14.22:1.5": "плохо-понимающие с плохо-понимающими вместе стекаются, сходятся;",
 "sn14.22:1.6": "решительно-старающиеся с решительно-старающимися вместе сходятся, стекаются;",
 "sn14.22:1.7": "установившие памятование с установившими памятование вместе стекаются, сходятся; понимающие с понимающими вместе стекаются, сходятся ….",
 "sn14.22:1.8": "Двенадцатая.",
 "sn14.22:1.9": "(Везде прошлое-будущее-настоящее сделать.)",
 "sn14.22:1.10": "Раздел Второй.",
 "sn14.22:2.0": "Оглавление",
 "sn14.22:2.1": "Семь с основанием и",
 "sn14.22:2.2": "с кирпичной обителью;",
 "sn14.22:2.3": "Низкая-устремлённость, хождение,",
 "sn14.22:2.4": "со строфами невера седьмая.",
 "sn14.22:3.1": "С корнем в неверии пять,",
 "sn14.22:3.2": "Четыре с корнем в бессовестности;",
 "sn14.22:3.3": "С корнем в безбоязненности три,",
 "sn14.22:3.4": "Две с малоучёностью.",
 "sn14.22:4.1": "Лень одна сказана,",
 "sn14.22:4.2": "Суттанты три пятёрки;",
 "sn14.22:4.3": "Двадцать две сказаны сутты,",
 "sn14.22:4.4": "Раздел Второй называется."
}
