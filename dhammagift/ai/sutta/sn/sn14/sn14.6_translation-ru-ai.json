{
 "sn14.6:0.1": "Связанные Наставления 14.6",
 "sn14.6:0.2": "1. Глава Различий",
 "sn14.6:0.3": "Сутта Внешних-дхату-различий",
 "sn14.6:1.1": "В Саваттхи располагается.",
 "sn14.6:1.2": "“Различие дхату вам, монахи, преподам.",
 "sn14.6:1.3": "Услышьте это…",
 "sn14.6:1.4": "И что такое, монахи, различие дхату?",
 "sn14.6:1.5": "Дхату образа, дхату звука, дхату запаха, дхату вкуса, дхату касания, дхату явления—",
 "sn14.6:1.6": "это называется, монахи, различие дхату”.",
 "sn14.6:1.7": "Шестая."
}
