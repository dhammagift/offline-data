{
 "sn11.8:0.1": "Связанные Наставления 11.8",
 "sn11.8:0.2": "1. Первая Глава",
 "sn11.8:0.3": "Сутта Вэрочана-асуринда",
 "sn11.8:1.1": "В Саваттхи, в роще Джеты.",
 "sn11.8:1.2": "В то же время Благословенный уединённым пребывал в дневном расположении.",
 "sn11.8:1.3": "И тогда Сакка, владыка дэвов, и Вэрочана, владыка асуров, подошли к Благословенному; подойдя, каждый оперся о косяк двери и встал.",
 "sn11.8:1.4": "И тогда Вэрочана, владыка асуров, в присутствии Благословенного произнес эту строфу:",
 "sn11.8:2.1": "“Пусть человек прилагает усилия,",
 "sn11.8:2.2": "пока цель не будет достигнута;",
 "sn11.8:2.3": "Достигнутая цель прекрасна,",
 "sn11.8:2.4": "таково слово Вэрочаны”.",
 "sn11.8:3.1": "“Пусть человек прилагает усилия,",
 "sn11.8:3.2": "пока цель не будет достигнута;",
 "sn11.8:3.3": "Достигнутая цель прекрасна,",
 "sn11.8:3.4": "терпения больше не найти”.",
 "sn11.8:4.1": "“Все существа, рожденные ради цели,",
 "sn11.8:4.2": "там и тут, как подобает;",
 "sn11.8:4.3": "Связь — вот высшее,",
 "sn11.8:4.4": "наслаждение — для всех дышащих”.",
 "sn11.8:4.5": "Достигнутая цель прекрасна,",
 "sn11.8:4.6": "таково слово Вэрочаны”.",
 "sn11.8:5.1": "“Все существа, рожденные ради цели,",
 "sn11.8:5.2": "там и тут, как подобает;",
 "sn11.8:5.3": "Связь — вот высшее,",
 "sn11.8:5.4": "наслаждение — для всех дышащих”.",
 "sn11.8:5.5": "Достигнутая цель прекрасна,",
 "sn11.8:5.6": "терпения больше не найти”."
}
