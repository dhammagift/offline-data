{
 "sn11.25:0.1": "Связанные Наставления 11.25",
 "sn11.25:0.2": "Раздел Третий",
 "sn11.25:0.3": "Сутта Без-гнева",
 "sn11.25:1.1": "Так мной услышано—",
 "sn11.25:1.2": "одно время Благословенный в Саваттхи располагается, в роще Джеты, в парке Анатхапиндики.",
 "sn11.25:1.3": "Здесь Благословенный обратился к монахам… Благословенный это сказал:",
 "sn11.25:1.4": "“Было когда-то, монахи, Сакка, царь дэвов, в зале Судхамма дэвов Таватимсы привлекая, по этому случаю эту строфу произнес:",
 "sn11.25:2.1": "‘Пусть вас гнев не одолеет,",
 "sn11.25:2.2": "и не гневайтесь на гневающихся;",
 "sn11.25:2.3": "Без-гнев и без-вреда,",
 "sn11.25:2.4": "и среди благородных практика;",
 "sn11.25:2.5": "Ведь злых людей гнев,",
 "sn11.25:2.6": "как скала сокрушает’”ти.",
 "sn11.25:2.7": "Третья глава.",
 "sn11.25:3.0": "Оглавление",
 "sn11.25:3.1": "Отсекши некрасивость, иллюзию,",
 "sn11.25:3.2": "по прошествии без-гневный;",
 "sn11.25:3.3": "Указанное пробуждённым-лучшим,",
 "sn11.25:3.4": "это ведь пятерица Сакки.",
 "sn11.25:3.5": "Сакка саньютта завершена.",
 "sn11.25:3.6": "Глава С-гатхами Первая.",
 "sn11.25:4.0": "Оглавление",
 "sn11.25:4.1": "Дэвата, дэвапутта,",
 "sn11.25:4.2": "царь, Мара и монахиня;",
 "sn11.25:4.3": "Брахма, брахман, Вангиса,",
 "sn11.25:4.4": "с лесным-яккхой Васава.",
 "sn11.25:4.5": "С-гатхами-вагга-саньютта-пали завершена."
}
