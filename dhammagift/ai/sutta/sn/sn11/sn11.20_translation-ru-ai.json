{
 "sn11.20:0.1": "Связанные Наставления 11.20",
 "sn11.20:0.2": "Раздел Второй",
 "sn11.20:0.3": "Сутта Почитания-Сангхи",
 "sn11.20:1.1": "В Саваттхи, в роще Джеты.",
 "sn11.20:1.2": "Здесь же… это сказал:",
 "sn11.20:1.3": "“Было когда-то, монахи, Сакка, царь дэвов, к Матали-возничему обратился:",
 "sn11.20:1.4": "‘Запряги, любезный Матали, тысяче-запряжённую колесницу с чистокровными конями, в парковую землю поедем, прекрасную землю для вИдения’.",
 "sn11.20:1.5": "‘Да, достопочтенный’ — и, монахи, Матали возничий Сакки царя дэвов выслушав, тысяче-запряжённую колесницу с чистокровными запрягши Сакке царю дэвов сообщил:",
 "sn11.20:1.6": "‘Запряжён тебе, почтенный, тысяче-запряжённая колесница с чистокровными,",
 "sn11.20:1.7": "теперь время как считаешь’.",
 "sn11.20:1.8": "И тогда, монахи, Сакка царь дэвов с дворца Веджаянты спускаясь, сложив ладони, монашескую Сангху почитает.",
 "sn11.20:1.9": "И тогда, монахи, Матали-возничий Сакку, царя дэвов, строфой обратился:",
 "sn11.20:2.1": "‘Ведь те бы почитали,",
 "sn11.20:2.2": "в гнило-теле-лежащие люди;",
 "sn11.20:2.3": "Погружённые в трупы эти,",
 "sn11.20:2.4": "голодом-жаждой охваченные.",
 "sn11.20:3.1": "Что же их желаешь,",
 "sn11.20:3.2": "бездомных, Васава;",
 "sn11.20:3.3": "Поведение провидцев скажи,",
 "sn11.20:3.4": "то услышим слово твоё’.",
 "sn11.20:4.1": "‘Вот что их желаю,",
 "sn11.20:4.2": "бездомных, Матали;",
 "sn11.20:4.3": "Из какой деревни уходят,",
 "sn11.20:4.4": "не-оглядываясь идут те.",
 "sn11.20:5.1": "Не у них в закрома складывают,",
 "sn11.20:5.2": "не в горшок, не в кастрюлю;",
 "sn11.20:5.3": "Готовое-другими ища,",
 "sn11.20:5.4": "тем живут хорошо-соблюдающие.",
 "sn11.20:6.1": "Благо-советующие мудрые,",
 "sn11.20:6.2": "молчаливые, ровно-ходящие;",
 "sn11.20:6.3": "Божества враждебны с асурами,",
 "sn11.20:6.4": "многие смертные и Матали.",
 "sn11.20:7.1": "Невраждебные среди враждебных,",
 "sn11.20:7.2": "среди нападающих успокоенные;",
 "sn11.20:7.3": "Среди имеющих-владения без-владения,",
 "sn11.20:7.4": "их почитаю я, Матали”.",
 "sn11.20:8.1": "‘Лучшие ведь, говорят, в мире,",
 "sn11.20:8.2": "кого ты, Сакка, почитаешь;",
 "sn11.20:8.3": "И я тех почитаю’.",
 "sn11.20:8.4": "кого почитаешь ты, Васава”’.",
 "sn11.20:9.1": "Это сказав Магхава,",
 "sn11.20:9.2": "царь божеств, Суджампати;",
 "sn11.20:9.3": "Сангху монахов почтив,",
 "sn11.20:9.4": "впереди на колесницу взошёл.",
 "sn11.20:9.5": "Раздел Второй.",
 "sn11.20:10.0": "Оглавление",
 "sn11.20:10.1": "Божеств же три сказаны,",
 "sn11.20:10.2": "бедность и приятность;",
 "sn11.20:10.3": "Жертвователя и почитание,",
 "sn11.20:10.4": "три почитания Сакки."
}
