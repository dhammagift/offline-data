{
 "sn11.21:0.1": "Связанные Наставления 11.21",
 "sn11.21:0.2": "Раздел Третий",
 "sn11.21:0.3": "Сутта Четва",
 "sn11.21:1.1": "В Саваттхи, в роще Джеты.",
 "sn11.21:1.2": "И тогда Сакка, владыка дэвов, где Благословенный туда подошёл; подойдя Благословенного поприветствовав с одного края встал.",
 "sn11.21:1.3": "С одного края встав, Сакка, владыка дэвов, Благословенного строфой обратился:",
 "sn11.21:2.1": "“Что срезав приятно лежит,",
 "sn11.21:2.2": "что срезав не страдает;",
 "sn11.21:2.3": "Какого одного явления,",
 "sn11.21:2.4": "убиение одобряешь, Готама”.",
 "sn11.21:3.1": "“Ворчание срезав приятно лежит,",
 "sn11.21:3.2": "ворчание срезав не страдает;",
 "sn11.21:3.3": "Ворчания с ядовитым корнем,",
 "sn11.21:3.4": "сладко-вершинного, Васава;",
 "sn11.21:3.5": "Убиение благородные одобряют,",
 "sn11.21:3.6": "то ведь срезав не страдает”."
}
