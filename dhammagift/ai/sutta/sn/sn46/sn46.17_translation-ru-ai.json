{
 "sn46.17:0.1": "Связанные Наставления 46.17",
 "sn46.17:0.2": "2. Раздел Гилана",
 "sn46.17:0.3": "Сутта Перехода-на-другой-берег",
 "sn46.17:1.1": "“Семь, монахи, аспектов пробуждения, развитые преумноженные, от не-иного к иному ведут.",
 "sn46.17:1.2": "Какие семь?",
 "sn46.17:1.3": "Аспект пробуждения памятование… аспект пробуждения видение-как-есть—",
 "sn46.17:1.4": "Эти, монахи, семь аспектов пробуждения, развитые преумноженные, от не-иного к иному ведут”.",
 "sn46.17:2.1": "Малочисленны те среди людей,",
 "sn46.17:2.2": "которые люди, на другой берег идущие;",
 "sn46.17:2.3": "А вот эта остальная толпа,",
 "sn46.17:2.4": "берег же обегает.",
 "sn46.17:3.1": "А которые же правильно-изложенном,",
 "sn46.17:3.2": "явлении следующими-за-явлением;",
 "sn46.17:3.3": "Те люди на другой берег перейдут,",
 "sn46.17:3.4": "смерти-владение трудно-переходимое.",
 "sn46.17:4.1": "Тёмное явление полностью оставив,",
 "sn46.17:4.2": "светлое развивай, мудрец;",
 "sn46.17:4.3": "Из дома в бездомность придя,",
 "sn46.17:4.4": "в уединение, где трудно-радоваться.",
 "sn46.17:5.1": "Там радость-в-уединении пусть ищет,",
 "sn46.17:5.2": "оставив желания, ничего-не-имеющий;",
 "sn46.17:5.3": "Пусть очистит себя,",
 "sn46.17:5.4": "от ум-загрязнений мудрец.",
 "sn46.17:6.1": "У которых в пробуждения-факторах,",
 "sn46.17:6.2": "правильно ум-состояние хорошо-развито;",
 "sn46.17:6.3": "В принятии-отдалении,",
 "sn46.17:6.4": "не поддерживая которые радуются;",
 "sn46.17:6.5": "С истощёнными истечениями, сияющие,",
 "sn46.17:6.6": "те в мире полностью угасли”.",
 "sn46.17:6.7": "Седьмая."
}
