{
 "sn46.43:0.1": "Связанные Наставления 46.43",
 "sn46.43:0.2": "5. Раздел Чаккаватти",
 "sn46.43:0.3": "Сутта Мара",
 "sn46.43:1.1": "“Мары-армии-сокрушение вам, монахи, путь преподам;",
 "sn46.43:1.2": "это услышьте.",
 "sn46.43:1.3": "И что такое, монахи, Мары-армии-сокрушающий путь?",
 "sn46.43:1.4": "Это—",
 "sn46.43:1.5": "семь аспектов пробуждения.",
 "sn46.43:1.6": "Какие семь?",
 "sn46.43:1.7": "Аспект пробуждения памятование… аспект пробуждения видение-как-есть—",
 "sn46.43:1.8": "об этом, монахи, Мары-армии-сокрушающий путь.",
 "sn46.43:1.9": "Третья."
}
