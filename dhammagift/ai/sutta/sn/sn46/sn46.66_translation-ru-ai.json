{
 "sn46.66:0.1": "Связанные Наставления 46.66",
 "sn46.66:0.2": "7. Раздел Анапана",
 "sn46.66:0.3": "Анапана-сутта",
 "sn46.66:1.1": "“Анапана-памятование, монахи, развитое…",
 "sn46.66:1.2": "Десятая.",
 "sn46.66:1.3": "Глава Анапана седьмая.",
 "sn46.66:2.0": "Оглавление",
 "sn46.66:2.1": "Скелет, червивый, синюшный,",
 "sn46.66:2.2": "Расчленённый, вздутый — пятая;",
 "sn46.66:2.3": "Мирность, доброта, мягкость,",
 "sn46.66:2.4": "Прямое-видение с анапаной — эти десять."
}
