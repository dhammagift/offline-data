{
 "sn1.26:0.1": "Связанные Наставления 1.26",
 "sn1.26:0.2": "Раздел Копья-волосы тела",
 "sn1.26:0.3": "Сутта Светочи",
 "sn1.26:1.1": "“Сколько на свете светочей,",
 "sn1.26:1.2": "Ими свет освещается;",
 "sn1.26:1.3": "Благословенного спросить придя,",
 "sn1.26:1.4": "Как узнаем мы это?”",
 "sn1.26:2.1": "“Четыре на свете светоча,",
 "sn1.26:2.2": "пятого здесь не различается;",
 "sn1.26:2.3": "Днём сияет солнце,",
 "sn1.26:2.4": "ночью светит луна.",
 "sn1.26:3.1": "А огонь днём и ночью,",
 "sn1.26:3.2": "там и тут сияет;",
 "sn1.26:3.3": "Всепробуждённый — сияющих лучший,",
 "sn1.26:3.4": "это сияние непревзойдённое”."
}
