{
 "sn1.13:0.1": "Связанные Наставления 1.13",
 "sn1.13:0.2": "2. Раздел Радости",
 "sn1.13:0.3": "Сутта Нет-сына-равного",
 "sn1.13:1.1": "В условиях Саваттхи.",
 "sn1.13:1.2": "С одного края встав, та дэвата вблизи Благословенного эту строфу произнесла:",
 "sn1.13:2.1": "“Нет сыну равной любви,",
 "sn1.13:2.2": "нет скоту равного богатства;",
 "sn1.13:2.3": "Нет солнцу равного света,",
 "sn1.13:2.4": "океан — высшая из рек”.",
 "sn1.13:3.1": "“Нет себе равной любви,",
 "sn1.13:3.2": "нет зерну равного богатства;",
 "sn1.13:3.3": "Нет пониманию равного света,",
 "sn1.13:3.4": "дождь — высшая из рек”."
}
