{
 "sn1.9:0.1": "Связанные Наставления 1.9",
 "sn1.9:0.2": "1. Глава Тростник",
 "sn1.9:0.3": "Сутта Желание-самомнения",
 "sn1.9:1.1": "В условиях Саваттхи.",
 "sn1.9:1.2": "С одного края встав, та дэвата вблизи Благословенного эту строфу произнесла:",
 "sn1.9:2.1": "“У желающего-самомнения здесь нет сдержанности,",
 "sn1.9:2.2": "Нет мудрости-молчания у несосредоточенного;",
 "sn1.9:2.3": "Один в лесу пребывая неопьяненный,",
 "sn1.9:2.4": "Царства-смерти не переплывет на тот берег”.",
 "sn1.9:3.1": "“Самомнение отбросив, хорошо сосредоточенный-умом,",
 "sn1.9:3.2": "С чистым-умом, везде полностью освобожденный;",
 "sn1.9:3.3": "Один в лесу пребывая старательный,",
 "sn1.9:3.4": "Он царства-смерти переплывет на тот берег”."
}
