{
 "sn1.22:0.1": "Связанные Наставления 1.22",
 "sn1.22:0.2": "3. Глава Копья-волосы тела",
 "sn1.22:0.3": "Сутта Касания",
 "sn1.22:1.1": "“Не-касающегося касается и,",
 "sn1.22:1.2": "касающегося же от того касается;",
 "sn1.22:1.3": "Поэтому касающегося касается,",
 "sn1.22:1.4": "не-испорченного-испорченный”.",
 "sn1.22:2.1": "«Кто без-враждебного человека враждует,",
 "sn1.22:2.2": "Чистого человека, без-изъяна;",
 "sn1.22:2.3": "Того же незрелого настигает плохое,",
 "sn1.22:2.4": "Тонкая пыль против ветра брошенная»."
}
