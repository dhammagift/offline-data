{
 "sn1.7:0.1": "Связанные Наставления 1.7",
 "sn1.7:0.2": "1. Глава Тростник",
 "sn1.7:0.3": "Сутта Не-полностью-понятые",
 "sn1.7:1.1": "В условиях Саваттхи.",
 "sn1.7:1.2": "С одного края встав, та дэвата вблизи Благословенного эту строфу произнесла:",
 "sn1.7:2.1": "“У кого явления не-полностью-поняты,",
 "sn1.7:2.2": "В чужие-учения уводятся;",
 "sn1.7:2.3": "Спящие те не пробуждаются,",
 "sn1.7:2.4": "Время им пробудиться”.",
 "sn1.7:3.1": "“У кого явления хорошо-полностью-поняты,",
 "sn1.7:3.2": "В чужие-учения не уводятся;",
 "sn1.7:3.3": "Те полностью-пробуждённые, правильным-знанием,",
 "sn1.7:3.4": "Идут среди неровного ровно”."
