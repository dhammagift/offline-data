{
 "sn1.14:0.1": "Связанные Наставления 1.14",
 "sn1.14:0.2": "2. Раздел Радости",
 "sn1.14:0.3": "Сутта Кшатрия",
 "sn1.14:1.1": "“Кшатрий среди двуногих наилучший,",
 "sn1.14:1.2": "бык среди четвероногих;",
 "sn1.14:1.3": "Девушка наилучшая среди жён,",
 "sn1.14:1.4": "и кто из сыновей первенец”.",
 "sn1.14:2.1": "“Пробуждённый среди двуногих наилучший,",
 "sn1.14:2.2": "чистокровный конь среди четвероногих;",
 "sn1.14:2.3": "Послушание наилучшее среди жён,",
 "sn1.14:2.4": "и кто из сыновей послушен”."
}
