{
 "sn1.81:0.1": "Связанные Наставления 1.81",
 "sn1.81:0.2": "8. Глава Четва",
 "sn1.81:0.3": "Сутта Арана",
 "sn1.81:1.1": "“Кто здесь без-трений в мире,",
 "sn1.81:1.2": "кого прожитое не пропадает;",
 "sn1.81:1.3": "Кто здесь желание полностью понимает,",
 "sn1.81:1.4": "кому всегда [принадлежит] пропитание.",
 "sn1.81:2.1": "Кого мать, отец, брат,",
 "sn1.81:2.2": "почитают, когда он утверждён;",
 "sn1.81:2.3": "Кого здесь, хоть и низкого рождения,",
 "sn1.81:2.4": "приветствуют кшатрии”ти.",
 "sn1.81:3.1": "“Шраманы здесь без-трений в мире,",
 "sn1.81:3.2": "у шраманов прожитое не пропадает;",
 "sn1.81:3.3": "Шраманы желание полностью понимают,",
 "sn1.81:3.4": "шраманам всегда [принадлежит] пропитание.",
 "sn1.81:4.1": "Шрамана мать, отец, брат,",
 "sn1.81:4.2": "почитают, когда он утверждён;",
 "sn1.81:4.3": "Шрамана здесь, хоть и низкого рождения,",
 "sn1.81:4.4": "приветствуют кшатрии”ти.",
 "sn1.81:4.5": "Глава Четва восьмая.",
 "sn1.81:5.0": "Оглавление",
 "sn1.81:5.1": "Отрезав колесницу и ум-состояние,",
 "sn1.81:5.2": "дождь, страх не стареет;",
 "sn1.81:5.3": "Владычество, желание, дорожный припас,",
 "sn1.81:5.4": "светильник с без-трением ити.",
 "sn1.81:5.5": "Дэватасаньютта завершена."
}
