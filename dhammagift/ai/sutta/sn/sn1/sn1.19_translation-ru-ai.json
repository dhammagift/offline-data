{
 "sn1.19:0.1": "Связанные Наставления 1.19",
 "sn1.19:0.2": "2. Раздел Радости",
 "sn1.19:0.3": "Сутта Хижина",
 "sn1.19:1.1": "“Надеюсь у тебя нет хижины,",
 "sn1.19:1.2": "надеюсь нет гнезда;",
 "sn1.19:1.3": "Надеюсь нет продолжений,",
 "sn1.19:1.4": "надеюсь освобождён ты от уз”.",
 "sn1.19:2.1": "“В самом деле у меня нет хижины,",
 "sn1.19:2.2": "в самом деле нет гнезда;",
 "sn1.19:2.3": "В самом деле нет продолжений,",
 "sn1.19:2.4": "в самом деле освобождён я от уз”.",
 "sn1.19:3.1": "“Что же я хижиной называю,",
 "sn1.19:3.2": "что тебе называю гнездом;",
 "sn1.19:3.3": "Что тебе продолжением называю,",
 "sn1.19:3.4": "что же я называю узами”.",
 "sn1.19:4.1": "“Мать хижиной называешь,",
 "sn1.19:4.2": "жену называешь гнездом;",
 "sn1.19:4.3": "Сыновей продолжением называешь,",
 "sn1.19:4.4": "цепляние мне называешь узами”.",
 "sn1.19:5.1": "“Хорошо у тебя нет хижины,",
 "sn1.19:5.2": "хорошо нет гнезда;",
 "sn1.19:5.3": "Хорошо нет продолжений,",
 "sn1.19:5.4": "хорошо освобождён ты от уз”."
}
