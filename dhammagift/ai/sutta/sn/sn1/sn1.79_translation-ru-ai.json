{
 "sn1.79:0.1": "Связанные Наставления 1.79",
 "sn1.79:0.2": "8. Глава Четва",
 "sn1.79:0.3": "Сутта Путного",
 "sn1.79:1.1": "“Что связывает путное,",
 "sn1.79:1.2": "что богатств основание;",
 "sn1.79:1.3": "Что человека тащит,",
 "sn1.79:1.4": "что в мире трудно оставить;",
 "sn1.79:1.5": "Чем связаны многие существа,",
 "sn1.79:1.6": "как птицы силком”.",
 "sn1.79:2.1": "“Вера связывает путное,",
 "sn1.79:2.2": "богатство богатств основание;",
 "sn1.79:2.3": "Хотение человека тащит,",
 "sn1.79:2.4": "хотение в мире трудно оставить;",
 "sn1.79:2.5": "Хотением связаны многие существа,",
 "sn1.79:2.6": "как птицы силком”."
}
