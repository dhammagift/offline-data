{
 "sn1.58:0.1": "Связанные Наставления 1.58",
 "sn1.58:0.2": "6. Старость",
 "sn1.58:0.3": "Сутта Неправильный Путь",
 "sn1.58:1.1": "“Что неправильным путём объявлено,",
 "sn1.58:1.2": "что — ночи-дня исчерпание;",
 "sn1.58:1.3": "Что пятно святой жизни,",
 "sn1.58:1.4": "что омовение без воды?”",
 "sn1.58:2.1": "“Страсть неправильным путём объявлена,",
 "sn1.58:2.2": "Возраст — ночи-дня исчерпание;",
 "sn1.58:2.3": "Женщина — пятно святой жизни,",
 "sn1.58:2.4": "Здесь этот [мир] привязывается, поколение;",
 "sn1.58:2.5": "Аскеза же и святая жизнь,",
 "sn1.58:2.6": "То — омовение без воды”."
}
