{
 "sn1.29:0.1": "Связанные Наставления 1.29",
 "sn1.29:0.2": "3. Глава Копья-волосы тела",
 "sn1.29:0.3": "Сутта Четырёхколёсная",
 "sn1.29:1.1": "“Четырёхколёсная, девятивратная,",
 "sn1.29:1.2": "полная корыстолюбием связанная;",
 "sn1.29:1.3": "В грязи рождённая, о великий герой,",
 "sn1.29:1.4": "как же выход будет?”",
 "sn1.29:2.1": "“Отрезав ремень и ремень-верёвку,",
 "sn1.29:2.2": "желание, корыстолюбие и плохое;",
 "sn1.29:2.3": "С корнем цепляние вырвав,",
 "sn1.29:2.4": "так выход будет”."
}
