{
 "sn1.49:0.1": "Связанные Наставления 1.49",
 "sn1.49:0.2": "5. Глава о горящем",
 "sn1.49:0.3": "Сутта Скупости",
 "sn1.49:1.1": "“Кто здесь скупые в мире,",
 "sn1.49:1.2": "скупцы, порицающие;",
 "sn1.49:1.3": "Другим дающим,",
 "sn1.49:1.4": "препятствующие люди.",
 "sn1.49:2.1": "Каков тех результат,",
 "sn1.49:2.2": "и будущее каково;",
 "sn1.49:2.3": "Благословенного спросить придя,",
 "sn1.49:2.4": "как узнаем то мы”.",
 "sn1.49:3.1": "“Кто здесь скупые в мире,",
 "sn1.49:3.2": "скупцы, порицающие;",
 "sn1.49:3.3": "Другим дающим,",
 "sn1.49:3.4": "препятствующие люди.",
 "sn1.49:4.1": "В ад, в животное чрево,",
 "sn1.49:4.2": "в мир Ямы перерождаются;",
 "sn1.49:4.3": "Если приходят к человеческому обличию,",
 "sn1.49:4.4": "в бедном рождаются роду.",
 "sn1.49:5.1": "Одежда, еда, удовольствие, игра,",
 "sn1.49:5.2": "где с трудом обретается;",
 "sn1.49:5.3": "От других надеются глупцы,",
 "sn1.49:5.4": "и того им не обретается;",
 "sn1.49:5.5": "В видимой действительности результат,",
 "sn1.49:5.6": "и в будущем плохой удел”.",
 "sn1.49:6.1": "“Так это понимаем,",
 "sn1.49:6.2": "другое спрашиваем, Готама;",
 "sn1.49:6.3": "Кто здесь, обретя человеческое обличие,",
 "sn1.49:6.4": "щедрые, без скупости.",
 "sn1.49:7.1": "В Пробуждённом уверенные и в Дхамме,",
 "sn1.49:7.2": "и к Сангхе с глубоким почтением;",
 "sn1.49:7.3": "Каков тех результат,",
 "sn1.49:7.4": "и будущее каково;",
 "sn1.49:7.5": "Благословенного спросить придя,",
 "sn1.49:7.6": "как узнаем то мы”.",
 "sn1.49:8.1": "“Кто здесь, обретя человеческое обличие,",
 "sn1.49:8.2": "щедрые, без скупости;",
 "sn1.49:8.3": "В Пробуждённом уверенные и в Дхамме,",
 "sn1.49:8.4": "и к Сангхе с глубоким почтением;",
 "sn1.49:8.5": "Эти раи проявляются,",
 "sn1.49:8.6": "где они перерождаются.",
 "sn1.49:9.1": "Если приходят к человеческому обличию,",
 "sn1.49:9.2": "в богатом роду рождаются;",
 "sn1.49:9.3": "Одежда, еда, удовольствие, игра,",
 "sn1.49:9.4": "где с трудом обретается.",
 "sn1.49:10.1": "В чужих накопленных богатствах,",
 "sn1.49:10.2": "властвуя, радуются;",
 "sn1.49:10.3": "В видимой действительности результат,",
 "sn1.49:10.4": "и в следующем мире — благой удел”."
}
