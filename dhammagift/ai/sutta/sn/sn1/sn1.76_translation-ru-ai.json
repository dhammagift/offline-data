{
 "sn1.76:0.1": "Связанные Наставления 1.76",
 "sn1.76:0.2": "8. Глава Четва",
 "sn1.76:0.3": "Сутта Нестареющего",
 "sn1.76:1.1": "“Что стареет, что не стареет,",
 "sn1.76:1.2": "что обочиной называется;",
 "sn1.76:1.3": "Что явлениям препятствие,",
 "sn1.76:1.4": "что — ночи-дня исчерпание;",
 "sn1.76:1.5": "Что пятно святой жизни,",
 "sn1.76:1.6": "что омовение безводное.",
 "sn1.76:2.1": "Сколько в мире дыр,",
 "sn1.76:2.2": "где богатство не удерживается;",
 "sn1.76:2.3": "Благословенного спросить придя,",
 "sn1.76:2.4": "как узнаем то мы”.",
 "sn1.76:3.1": "“Форма стареет у смертных,",
 "sn1.76:3.2": "имя-род не стареет;",
 "sn1.76:3.3": "Страсть обочиной называется.",
 "sn1.76:4.1": "Корыстолюбие явлениям препятствие,",
 "sn1.76:4.2": "Возраст — ночи-дня исчерпание;",
 "sn1.76:4.3": "Женщина — пятно святой жизни,",
 "sn1.76:4.4": "Здесь этот [мир] привязывается, поколение;",
 "sn1.76:4.5": "Аскеза же и святая жизнь,",
 "sn1.76:4.6": "То омовение безводное.",
 "sn1.76:5.1": "Шесть в мире дыр,",
 "sn1.76:5.2": "где богатство не удерживается;",
 "sn1.76:5.3": "Лень и беспечность,",
 "sn1.76:5.4": "неинициативность, несдержанность;",
 "sn1.76:5.5": "Сонливость и вялость — те дыры,",
 "sn1.76:5.6": "всецело то следует избегать”."
}
