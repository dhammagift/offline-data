{
 "sn1.25:0.1": "Связанные Наставления 1.25",
 "sn1.25:0.2": "Раздел Копья-волосы тела",
 "sn1.25:0.3": "Сутта Арахант",
 "sn1.25:1.1": "“Кто есть монах арахант сделавший-дело,",
 "sn1.25:1.2": "Исчерпавший-истечения носящий-последнее-тело;",
 "sn1.25:1.3": "‘Я говорю’ — и так он сказал бы,",
 "sn1.25:1.4": "‘Мне говорят’ — и так он сказал бы”.",
 "sn1.25:2.1": "“Кто есть монах арахант сделавший-дело,",
 "sn1.25:2.2": "Исчерпавший-истечения носящий-последнее-тело;",
 "sn1.25:2.3": "‘Я говорю’ — и так он сказал бы,",
 "sn1.25:2.4": "‘Мне говорят’ — и так он сказал бы;",
 "sn1.25:2.5": "В мире общие-понятия умелый увидев,",
 "sn1.25:2.6": "Лишь-оборотом-речи так он говорил бы”.",
 "sn1.25:3.1": "“Кто есть монах арахант сделавший-дело,",
 "sn1.25:3.2": "Исчерпавший-истечения носящий-последнее-тело;",
 "sn1.25:3.3": "Самомнение ли, вот, приняв, монах,",
 "sn1.25:3.4": "‘Я говорю’ — и так он сказал бы;",
 "sn1.25:3.5": "‘Мне говорят’ — и так он сказал бы”.",
 "sn1.25:4.1": "“У отбросившего-самомнение нет узлов,",
 "sn1.25:4.2": "Рассеяны узла-самомнения все;",
 "sn1.25:4.3": "Он перешагнувший самомнение-различение премудрый,",
 "sn1.25:4.4": "‘Я говорю’ — и так он сказал бы.",
 "sn1.25:5.1": "‘Мне говорят’ — и так он сказал бы,",
 "sn1.25:5.2": "В мире общие-понятия умелый увидев;",
 "sn1.25:5.3": "Лишь-оборотом-речи так он говорил бы”."
}
