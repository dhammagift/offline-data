{
 "sn1.10:0.1": "Связанные Наставления 1.10",
 "sn1.10:0.2": "Раздел Тростник",
 "sn1.10:0.3": "Сутта Лес",
 "sn1.10:1.1": "В условиях Саваттхи.",
 "sn1.10:1.2": "Рядом встав, та дэвата Благословенного стихом обратилась:",
 "sn1.10:2.1": "“В лесу проживающих,",
 "sn1.10:2.2": "успокоенных, ведущих святую жизнь;",
 "sn1.10:2.3": "Один раз в день принимающих пищу,",
 "sn1.10:2.4": "отчего стать-статус проясняется?”",
 "sn1.10:3.1": "“О прошедшем не печалятся,",
 "sn1.10:3.2": "не устремляются к грядущему;",
 "sn1.10:3.3": "Текущим существуют,",
 "sn1.10:3.4": "оттого стать-статус проясняется.",
 "sn1.10:4.1": "Устремлением к грядущему,",
 "sn1.10:4.2": "печалью о прошедшем;",
 "sn1.10:4.3": "Этим глупцы высыхают,",
 "sn1.10:4.4": "как тростник, срезанный зелёным”.",
 "sn1.10:4.5": "Глава Нала Первая.",
 "sn1.10:5.0": "Оглавление",
 "sn1.10:5.1": "Затопление, освобождение, приведение,",
 "sn1.10:5.2": "Проходят, сколько отсекли и;",
 "sn1.10:5.3": "Бодрствование, не-понятое,",
 "sn1.10:5.4": "Совсем забытые самомнением-желающим;",
 "sn1.10:5.5": "В лесу десятая названа,",
 "sn1.10:5.6": "Глава этой называется."
}
