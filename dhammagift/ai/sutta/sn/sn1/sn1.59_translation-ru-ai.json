{
 "sn1.59:0.1": "Связанные Наставления 1.59",
 "sn1.59:0.2": "6. Старость",
 "sn1.59:0.3": "Вторая сутта",
 "sn1.59:1.1": "“Что второе у человека бывает,",
 "sn1.59:1.2": "Что им управляет?",
 "sn1.59:1.3": "Чему радуясь, смертный,",
 "sn1.59:1.4": "От всякой боли освобождается?”",
 "sn1.59:2.1": "“Вера — второй человеку бывает,",
 "sn1.59:2.2": "Понимание им управляет;",
 "sn1.59:2.3": "Ниббане радуясь, смертный,",
 "sn1.59:2.4": "От всякой боли освобождается?”"
}
