{
 "sn1.42:0.1": "Связанные Наставления 1.42",
 "sn1.42:0.2": "5. Глава о горящем",
 "sn1.42:0.3": "Сутта Что-Дающий",
 "sn1.42:1.1": "«Что-дающий силу-дающим бывает,",
 "sn1.42:1.2": "что-дающий бывает цвет-дающим;",
 "sn1.42:1.3": "Что-дающий приятное-дающим бывает,",
 "sn1.42:1.4": "что-дающий бывает глаз-дающим;",
 "sn1.42:1.5": "Кто же все-дающим бывает,",
 "sn1.42:1.6": "то мне скажи, спрошенный”.",
 "sn1.42:2.1": "«Еду-дающий силу-дающим бывает,",
 "sn1.42:2.2": "одежду-дающий бывает цвет-дающим;",
 "sn1.42:2.3": "Средство-передвижения-дающий приятное-дающим бывает,",
 "sn1.42:2.4": "светильник-дающий бывает глаз-дающим.",
 "sn1.42:3.1": "А тот все-дающим бывает,",
 "sn1.42:3.2": "кто даёт пристанище;",
 "sn1.42:3.3": "Не-умирание-дающим же тот бывает,",
 "sn1.42:3.4": "кто Дхамму наставляет»."
}
