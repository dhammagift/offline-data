{
 "sn1.24:0.1": "Связанные Наставления 1.24",
 "sn1.24:0.2": "3. Глава Копья-волосы тела",
 "sn1.24:0.3": "Сутта Ум-представление-сдерживание",
 "sn1.24:1.1": "“Откуда-откуда ум-представление сдерживать,",
