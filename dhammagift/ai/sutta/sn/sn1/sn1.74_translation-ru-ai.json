{
 "sn1.74:0.1": "Связанные Наставления 1.74",
 "sn1.74:0.2": "8. Глава Четва",
 "sn1.74:0.3": "Сутта Дождя",
 "sn1.74:1.1": "“Что среди взлетающих наилучшее,",
 "sn1.74:1.2": "что среди падающих наилучшее;",
 "sn1.74:1.3": "Что среди уходящих в бездомные,",
 "sn1.74:1.4": "что среди говорящих наилучшее”.",
 "sn1.74:2.1": "“Семя среди взлетающих наилучшее,",
 "sn1.74:2.2": "дождь среди падающих наилучший;",
 "sn1.74:2.3": "Коровы среди уходящих в бездомные,",
 "sn1.74:2.4": "сын среди говорящих наилучший”.",
 "sn1.74:3.1": "“Знание среди взлетающих наилучшее,",
 "sn1.74:3.2": "не-знание среди падающих наилучшее;",
 "sn1.74:3.3": "Сангха среди уходящих в бездомные,",
 "sn1.74:3.4": "Будда среди говорящих наилучший”."
}
