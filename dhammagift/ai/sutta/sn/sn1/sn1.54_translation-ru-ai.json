{
 "sn1.54:0.1": "Связанные Наставления 1.54",
 "sn1.54:0.2": "6. Старость",
 "sn1.54:0.3": "Сутта Основание",
 "sn1.54:1.1": "“Что основание людей,",
 "sn1.54:1.2": "что здесь высший друг;",
 "sn1.54:1.3": "Что существа поддерживают,",
 "sn1.54:1.4": "которые дышащие (живые) на земле опираются”.",
 "sn1.54:2.1": "“Сыновья — основание людей,",
 "sn1.54:2.2": "и жена — высший друг;",
 "sn1.54:2.3": "Дождём сущие поддерживают жизнь,",
 "sn1.54:2.4": "которые дышащие (живые) на земле опираются”."
}
