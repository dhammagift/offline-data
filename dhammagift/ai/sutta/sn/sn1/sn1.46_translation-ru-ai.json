{
 "sn1.46:0.1": "Связанные Наставления 1.46",
 "sn1.46:0.2": "Раздел о горящем",
 "sn1.46:0.3": "Сутта Аккхара",
 "sn1.46:1.1": "“Толпой нимф оглашаемый,",
 "sn1.46:1.2": "толпой пишачей посещаемый;",
 "sn1.46:1.3": "Лес Заблуждение имя,",
 "sn1.46:1.4": "как же выход будет?”",
 "sn1.46:2.1": "“Прямой имя тот путь,",
 "sn1.46:2.2": "без-страха имя то направление;",
 "sn1.46:2.3": "Колесница Бесшумная имя,",
 "sn1.46:2.4": "колёсами-явления оснащённая.",
 "sn1.46:3.1": "Стыдливость у неё подпорка,",
 "sn1.46:3.2": "памятования покрытие;",
 "sn1.46:3.3": "Явление возничим называю,",
 "sn1.46:3.4": "правильный взгляд — передовой.",
 "sn1.46:4.1": "У кого такая колесница,",
 "sn1.46:4.2": "у женщины или мужчины;",
 "sn1.46:4.3": "Он именно на этой колеснице,",
 "sn1.46:4.4": "к ниббане вблизи”."
}
