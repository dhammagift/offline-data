{
 "sn1.17:0.1": "Связанные Наставления 1.17",
 "sn1.17:0.2": "2. Раздел Радости",
 "sn1.17:0.3": "Сутта Трудного",
 "sn1.17:1.1": "“Трудно, с трудом терпимо,",
 "sn1.17:1.2": "невежественным шраманство;",
 "sn1.17:1.3": "Многие там затруднения,",
 "sn1.17:1.4": "где глупец увязает”.",
 "sn1.17:2.1": "“Сколько дней вести шраманство,",
 "sn1.17:2.2": "если ум-состояние не сдерживать?",
 "sn1.17:2.3": "На каждом шагу увязал бы,",
 "sn1.17:2.4": "под власть намерений попадая”.",
 "sn1.17:3.1": "Как черепаха аспекты в своём панцире,",
 "sn1.17:3.2": "Собирает монах ум-рассуждения;",
 "sn1.17:3.3": "Независимый, не причиняя вреда друг другу,",
 "sn1.17:3.4": "Полностью остуженный, не стал бы упрекать никого”."
}
