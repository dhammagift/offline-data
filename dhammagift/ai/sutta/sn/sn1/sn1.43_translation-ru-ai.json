{
 "sn1.43:0.1": "Связанные Наставления 1.43",
 "sn1.43:0.2": "5. Глава о горящем",
 "sn1.43:0.3": "Сутта Еда",
 "sn1.43:1.1": "“Еду только радуются,",
 "sn1.43:1.2": "оба — дэвы и люди;",
 "sn1.43:1.3": "Кто же такой тот яккха,",
 "sn1.43:1.4": "который еду не радуется”.",
 "sn1.43:2.1": "“Которые её дают с верой,",
 "sn1.43:2.2": "с прояснённым разумом;",
 "sn1.43:2.3": "Та же самая еда сопровождает их,",
 "sn1.43:2.4": "в этом мире и в следующем.",
 "sn1.43:3.1": "Поэтому устранив скупость,",
 "sn1.43:3.2": "следует давать даяние, победив загрязнение;",
 "sn1.43:3.3": "Благие заслуги в следующем мире",
 "sn1.43:3.4": "опорой являются для существ”."
}
