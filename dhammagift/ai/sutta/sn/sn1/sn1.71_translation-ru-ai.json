{
 "sn1.71:0.1": "Связанные Наставления 1.71",
 "sn1.71:0.2": "8. Глава Четва",
 "sn1.71:0.3": "Сутта Четва",
 "sn1.71:1.1": "В условиях Саваттхи.",
 "sn1.71:1.2": "Рядом встав, та дэвата Благословенного стихом обратилась:",
 "sn1.71:2.1": "“Что срезав приятно лежит,",
 "sn1.71:2.2": "что срезав не страдает;",
 "sn1.71:2.3": "Какого одного явления,",
 "sn1.71:2.4": "убиение одобряешь, Готама”.",
 "sn1.71:3.1": "“Ворчание срезав приятно лежит,",
 "sn1.71:3.2": "ворчание срезав не страдает;",
 "sn1.71:3.3": "Ворчания с ядовитым корнем,",
 "sn1.71:3.4": "со сладкой вершиной, дэвата;",
 "sn1.71:3.5": "Убиение благородные одобряют,",
 "sn1.71:3.6": "то ведь срезав не страдает”."
}
