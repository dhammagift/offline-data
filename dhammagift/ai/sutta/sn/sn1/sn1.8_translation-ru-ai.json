{
 "sn1.8:0.1": "Связанные Наставления 1.8",
 "sn1.8:0.2": "1. Глава Тростник",
 "sn1.8:0.3": "Сутта Полностью-Забытое",
 "sn1.8:1.1": "В условиях Саваттхи.",
 "sn1.8:1.2": "С одного края встав, та дэвата вблизи Благословенного эту строфу произнесла:",
