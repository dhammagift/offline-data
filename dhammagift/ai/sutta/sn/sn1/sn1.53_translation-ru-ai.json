{
 "sn1.53:0.1": "Связанные Наставления 1.53",
 "sn1.53:0.2": "6. Старость",
 "sn1.53:0.3": "Сутта Друг",
 "sn1.53:1.1": "“Что уезжающему друг,",
 "sn1.53:1.2": "что друг в своём доме;",
 "sn1.53:1.3": "Что друг родившемуся-благу,",
 "sn1.53:1.4": "что друг в следующем”.",
 "sn1.53:2.1": "“Караван уезжающему друг,",
 "sn1.53:2.2": "мать друг в своём доме;",
 "sn1.53:2.3": "Товарищ родившемуся-благу,",
 "sn1.53:2.4": "бывает другом снова и снова;",
 "sn1.53:2.5": "Самосделанные блага,",
 "sn1.53:2.6": "то друг в следующем”."
}
