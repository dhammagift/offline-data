{
 "sn1.30:0.1": "Связанные Наставления 1.30",
 "sn1.30:0.2": "Раздел Копья-волосы тела",
 "sn1.30:0.3": "Сутта Эниджангха",
 "sn1.30:1.1": "“Эниджангха, худой, герой,",
 "sn1.30:1.2": "мало-едящий, не-алчный;",
 "sn1.30:1.3": "Лев, одиноко-ходящий, слон,",
 "sn1.30:1.4": "к желаниям не-взирающий;",
 "sn1.30:1.5": "Подойдя, спрашиваем,",
 "sn1.30:1.6": "как от боли освобождается?”",
 "sn1.30:2.1": "“Пять желания-множителей в мире,",
 "sn1.30:2.2": "с умом-представлением как шестым объявлены;",
 "sn1.30:2.3": "Здесь импульс устранив-страстью,",
 "sn1.30:2.4": "так от боли освобождается”.",
 "sn1.30:2.5": "Глава Сатти Третья.",
 "sn1.30:3.0": "Оглавление",
 "sn1.30:3.1": "Сатти касается также,",
 "sn1.30:3.2": "спутанность, ума-представления-преграда;",
 "sn1.30:3.3": "Арахантом, светильник,",
 "sn1.30:3.4": "стрела, с большим-богатством также;",
 "sn1.30:3.5": "С четырёхколёсным девятая,",
 "sn1.30:3.6": "эниджангхой те десять”."
}
