{
 "sn1.50:0.1": "Связанные Наставления 1.50",
 "sn1.50:0.2": "Раздел о горящем",
 "sn1.50:0.3": "Сутта Гхатикара",
 "sn1.50:1.1": "“В Авиху переродившись,",
 "sn1.50:1.2": "освобождённые семь монахов;",
 "sn1.50:1.3": "Страсть-и-злобу устранившие,",
 "sn1.50:1.4": "переплывшие в мире прилипчивость”.",
 "sn1.50:2.1": "“И кто же пересёк топь,",
 "sn1.50:2.2": "смерти-владение, столь трудно переходимое;",
 "sn1.50:2.3": "Кто, оставив человеческое тело,",
 "sn1.50:2.4": "божественную связь превзошёл”.",
 "sn1.50:3.1": "“Упако и Палагандо,",
 "sn1.50:3.2": "Пуккусати — те трое;",
 "sn1.50:3.3": "Бхаддийо, Кхандадево,",
 "sn1.50:3.4": "Бахурагги и Сингийо;",
 "sn1.50:3.5": "Они, оставив человеческое тело,",
 "sn1.50:3.6": "божественную связь превзошёл”.",
 "sn1.50:4.1": "“Умело говоришь о тех,",
 "sn1.50:4.2": "Мары-силки отбросивших;",
 "sn1.50:4.3": "Чью Дхамму познав,",
 "sn1.50:4.4": "разрубили существования-окову”.",
 "sn1.50:5.1": "“Не иначе как от Благословенного,",
 "sn1.50:5.2": "не иначе как от твоего учения;",
 "sn1.50:5.3": "Чью Дхамму познав,",
 "sn1.50:5.4": "разрубили существования-окову.",
 "sn1.50:6.1": "Где и имя и материя",
 "sn1.50:6.2": "без остатка заканчиваются;",
 "sn1.50:6.3": "Ту Дхамму здесь познав,",
 "sn1.50:6.4": "разрубили существования-окову”.",
 "sn1.50:7.1": "“Глубокую произносишь речь,",
 "sn1.50:7.2": "Трудно-познаваемое, очень-трудно-понимаемое;",
 "sn1.50:7.3": "Чью ты Дхамму познав,",
 "sn1.50:7.4": "речь произносишь такую?”",
 "sn1.50:8.1": "“Гончаром прежде был,",
 "sn1.50:8.2": "в Векалинге горшечником;",
 "sn1.50:8.3": "Мать-отца содержателем был,",
 "sn1.50:8.4": "Кассапы последователем.",
 "sn1.50:9.1": "Воздерживающийся от половых явлений,",
 "sn1.50:9.2": "ведущий святую жизнь, не-плотской;",
 "sn1.50:9.3": "Был я твоим односельчанином,",
 "sn1.50:9.4": "был я твоим прежним другом.",
 "sn1.50:10.1": "И я этих знаю,",
 "sn1.50:10.2": "освобождённых семь монахов;",
 "sn1.50:10.3": "Страсть-вредность-полностью-истощивших,",
 "sn1.50:10.4": "переплывших в мире привязанность”.",
 "sn1.50:11.1": "“Так это тогда было,",
 "sn1.50:11.2": "как говоришь, Бхаггава;",
 "sn1.50:11.3": "Гончаром прежде был,",
 "sn1.50:11.4": "в Векалинге горшечником;",
 "sn1.50:11.5": "Мать-отца содержателем был,",
 "sn1.50:11.6": "Кассапы последователем.",
 "sn1.50:12.1": "Воздерживающийся от половых явлений,",
 "sn1.50:12.2": "ведущий святую жизнь, не-плотской;",
 "sn1.50:12.3": "Был ты моим односельчанином,",
 "sn1.50:12.4": "был ты моим прежним другом”.",
 "sn1.50:13.1": "“Так это прежних,",
 "sn1.50:13.2": "друзей была встреча;",
 "sn1.50:13.3": "Обоих развивших-себя,",
 "sn1.50:13.4": "тело-последнее-несущий”.",
 "sn1.50:13.5": "Глава Воспламенённого Пятая.",
 "sn1.50:14.0": "Оглавление",
 "sn1.50:14.1": "Воспламенено что-дающее пищу,",
 "sn1.50:14.2": "одно-коренное-неизмеримое;",
 "sn1.50:14.3": "Аккхара-вана-ропа-джета,",
 "sn1.50:14.4": "скупостью скручивается."
}
