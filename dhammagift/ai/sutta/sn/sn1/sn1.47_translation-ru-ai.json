{
 "sn1.47:0.1": "Связанные Наставления 1.47",
 "sn1.47:0.2": "5. Глава о горящем",
 "sn1.47:0.3": "Сутта Лесосажателей",
 "sn1.47:1.1": "“У кого днём и ночью,",
 "sn1.47:1.2": "всегда благо разрастается;",
 "sn1.47:1.3": "В Дхамме стоящие, нравственностью обладающие,",
 "sn1.47:1.4": "какие люди идут на небеса”.",
 "sn1.47:2.1": "“Сажающие рощи, сажающие леса,",
 "sn1.47:2.2": "какие люди мосты строят;",
 "sn1.47:2.3": "Колодцы и пруды,",
 "sn1.47:2.4": "кто даёт жильё.",
 "sn1.47:3.1": "У них днём и ночью,",
 "sn1.47:3.2": "всегда благо разрастается;",
 "sn1.47:3.3": "В Дхамме стоящие, нравственностью обладающие,",
 "sn1.47:3.4": "те люди идут на небеса”."
}
