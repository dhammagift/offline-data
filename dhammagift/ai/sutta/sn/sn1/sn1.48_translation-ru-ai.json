{
 "sn1.48:0.1": "Связанные Наставления 1.48",
 "sn1.48:0.2": "5. Глава о горящем",
 "sn1.48:0.3": "Сутта Джетавана",
 "sn1.48:1.1": "«Вот эта Джетавана,",
 "sn1.48:1.2": "провидцев-собранием посещаемая;",
 "sn1.48:1.3": "Обитаема Царём-Дхаммы,",
 "sn1.48:1.4": "озарённость-порождающая для меня.",
 "sn1.48:2.1": "Активность, знание и Дхамма,",
 "sn1.48:2.2": "нравственность, жизнь наивысшая;",
 "sn1.48:2.3": "Этим смертные очищаются,",
 "sn1.48:2.4": "не родом или богатством.",
 "sn1.48:3.1": "Поэтому мудрый человек,",
 "sn1.48:3.2": "видя благо-смысл-цель для себя;",
 "sn1.48:3.3": "Первопричинно исследует Дхамму,",
 "sn1.48:3.4": "так в этом очищается.",
 "sn1.48:4.1": "Только Сарипутта пониманием,",
 "sn1.48:4.2": "нравственностью и успокоением;",
 "sn1.48:4.3": "Какой бы ни был достигший-того-берега монах,",
 "sn1.48:4.4": "этим-наивысшим пусть будет»."
}
