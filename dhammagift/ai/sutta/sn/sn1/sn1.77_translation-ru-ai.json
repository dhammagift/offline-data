{
 "sn1.77:0.1": "Связанные Наставления 1.77",
 "sn1.77:0.2": "8. Глава Четва",
 "sn1.77:0.3": "Сутта Владычества",
 "sn1.77:1.1": "“Что владычество в мире,",
 "sn1.77:1.2": "что из вещей наилучшее;",
 "sn1.77:1.3": "Что оружие-пятно в мире,",
 "sn1.77:1.4": "что в мире нарыв.",
 "sn1.77:2.1": "Что уносящего останавливают,",
 "sn1.77:2.2": "уносящий же кто приятен;",
 "sn1.77:2.3": "Что снова и снова приходящего,",
 "sn1.77:2.4": "приветствуют мудрецы”.",
 "sn1.77:3.1": "“Власть — владычество в мире,",
 "sn1.77:3.2": "женщина — из вещей наилучшая;",
 "sn1.77:3.3": "Злость — оружие-пятно в мире,",
 "sn1.77:3.4": "воры — в мире нарыв.",
 "sn1.77:4.1": "Вора уносящего останавливают,",
 "sn1.77:4.2": "уносящий — шраман приятен;",
 "sn1.77:4.3": "Шрамана снова и снова приходящего,",
 "sn1.77:4.4": "приветствуют мудрецы”."
}
