{
 "sn1.28:0.1": "Связанные Наставления 1.28",
 "sn1.28:0.2": "Раздел Копья-волосы тела",
 "sn1.28:0.3": "Сутта Большое-богатство",
 "sn1.28:1.1": "“Большим-богатством, большим-достоянием,",
 "sn1.28:1.2": "и владеющие странами кшатрии;",
 "sn1.28:1.3": "Друг-друга одолевают-алчностью,",
 "sn1.28:1.4": "в желаниях ненасытные.",
 "sn1.28:2.1": "У тех, в-усердие-рождённых,",
 "sn1.28:2.2": "бхава-потоком-следующих;",
 "sn1.28:2.3": "Где цепляние оставили,",
 "sn1.28:2.4": "кто на свете без-усердия”.",
 "sn1.28:3.1": "“Оставив дом, уйдя в бездомность,",
 "sn1.28:3.2": "оставив сына, скотину милую;",
 "sn1.28:3.3": "Оставив страсть и злобу,",
 "sn1.28:3.4": "и незнания выцветание-бесстрастие;",
 "sn1.28:3.5": "С-исчерпанными-истечениями араханты,",
 "sn1.28:3.6": "те на свете без-усердия”."
}
