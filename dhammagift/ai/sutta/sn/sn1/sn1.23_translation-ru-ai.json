{
 "sn1.23:0.1": "Связанные Наставления 1.23",
 "sn1.23:0.2": "Раздел Копья-волосы тела",
 "sn1.23:0.3": "Сутта Сплетение",
 "sn1.23:1.1": "“Внутреннее сплетение, внешнее сплетение,",
 "sn1.23:1.2": "Сплетением сплетено поколение;",
 "sn1.23:1.3": "То тебя, Готама, спрашиваю:",
 "sn1.23:1.4": "Кто это сплетение расплетёт?”",
 "sn1.23:2.1": "“В нравственности утвердившись, человек с-пониманием,",
 "sn1.23:2.2": "Ум и понимание развивая;",
 "sn1.23:2.3": "Пылкий, рассудительный монах,",
 "sn1.23:2.4": "Он это сплетение расплетёт.",
 "sn1.23:3.1": "Которых и страсть и злоба,",
 "sn1.23:3.2": "и невидение выбелены;",
 "sn1.23:3.3": "С-исчерпанными-истечениями араханты,",
 "sn1.23:3.4": "у тех расплетено сплетение.",
 "sn1.23:4.1": "Где и имя и материя",
 "sn1.23:4.2": "без остатка заканчиваются;",
 "sn1.23:4.3": "Отторжение и объекто-сознавание,",
 "sn1.23:4.4": "здесь это сплетение разрубается”."
}
