{
 "sn1.57:0.1": "Связанные Наставления 1.57",
 "sn1.57:0.2": "6. Старость",
 "sn1.57:0.3": "Третья-сутта-о-рождении",
 "sn1.57:1.1": "“Что рождает человека,",
 "sn1.57:1.2": "что у него разбегается;",
 "sn1.57:1.3": "Что в круговерть вступает,",
 "sn1.57:1.4": "Что тому окончательным прибежищем?”",
 "sn1.57:2.1": "“Цепляние рождает человека,",
 "sn1.57:2.2": "ум-состояние у него разбегается;",
 "sn1.57:2.3": "Существо в круговерть вступает,",
 "sn1.57:2.4": "Активность тому окончательным прибежищем.”"
}
