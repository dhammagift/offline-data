{
 "sn15.10:0.1": "Связанные Наставления 15.10",
 "sn15.10:0.2": "1. Первая Глава",
 "sn15.10:0.3": "Сутта Личности",
 "sn15.10:1.1": "Одно время Благословенный располагается в Раджагахе на горе Пик Грифов.",
 "sn15.10:1.2": "И здесь Благословенный к монахам обратился:",
 "sn15.10:1.3": "“Монахи”.",
 "sn15.10:1.4": "“Достопочтенный”, — те монахи Благословенному ответили.",
 "sn15.10:1.5": "Благословенный это сказал:",
 "sn15.10:2.1": "“Без-постижимого-начала это, монахи, скитание (стечение, самсара)…",
 "sn15.10:2.2": "одного индивида, монахи, за каппу блуждающего скитающегося был бы так велик костяной остов, костяная куча, костяная груда, как эта гора Вепулла, если бы собиратель был, и собранное не разрушалось.",
 "sn15.10:2.3": "Что тому причина?",
 "sn15.10:2.4": "Без-постижимого-начала это, монахи, скитание…",
 "sn15.10:2.5": "достаточно, чтобы высвободится”.",
 "sn15.10:3.1": "Это сказал Благословенный.",
 "sn15.10:3.2": "Это сказав Благой, в дополнение это сказал Учитель:",
 "sn15.10:4.1": "“За одну-единственную каппу",
 "sn15.10:4.2": "индивида костей скопление;",
 "sn15.10:4.3": "Была бы с горой сравнима груда,",
 "sn15.10:4.4": "так сказано великим провидцем.",
 "sn15.10:5.1": "И вот эта объявлена,",
 "sn15.10:5.2": "Вепулла гора великая;",
 "sn15.10:5.3": "Севернее пика Коршуна,",
 "sn15.10:5.4": "в Магадхе, в Горной-крепости.",
 "sn15.10:6.1": "Но когда Благородно-Истины",
 "sn15.10:6.2": "правильным пониманием видит;",
 "sn15.10:6.3": "Боль, боле-возникновение,",
 "sn15.10:6.4": "и боли преодоление;",
 "sn15.10:6.5": "Благородный восьмичастный путь,",
 "sn15.10:6.6": "К успокоению боли ведущий.",
 "sn15.10:7.1": "Он — семь раз максимум —",
 "sn15.10:7.2": "проблуждав, индивид;",
 "sn15.10:7.3": "Боли-конец-делающим становится,",
 "sn15.10:7.4": "всех связываний исчерпанием”.",
 "sn15.10:7.5": "Десятая.",
 "sn15.10:7.6": "Первая Глава.",
 "sn15.10:8.0": "Оглавление",
 "sn15.10:8.1": "Трава-дрова и земля,",
 "sn15.10:8.2": "слеза, молоко и гора;",
 "sn15.10:8.3": "Горчичные зёрна, последователи, Ганг,",
 "sn15.10:8.4": "палка и личностью и."
}
