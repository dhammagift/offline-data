{
 "sn47.73-84:0.1": "Связанные Наставления 47.73–84",
 "sn47.73-84:0.2": "8. Раздел Балакарания",
 "sn47.73-84:0.3": "Сутта Начинающаяся С Требующий Сил",
 "sn47.73-84:1.1": "“Это как, монахи, какие-либо дела, требующие сил, делаются”",
 "sn47.73-84:1.2": "должно быть расширенно.",
 "sn47.73-84:1.3": "Глава Балакарания Восьмая.",
 "sn47.73-84:2.0": "Оглавление",
 "sn47.73-84:2.1": "Сила, и зерно, и нага, и",
 "sn47.73-84:2.2": "дерево с кувшином иглой;",
 "sn47.73-84:2.3": "Небом и два облака,",
 "sn47.73-84:2.4": "судно пришедшее река."
}
