{
 "sn47.63-72:0.1": "Связанные Наставления 47.63–72",
 "sn47.63-72:0.2": "7. Глава Аппамада",
 "sn47.63-72:0.3": "Сутты Начинающиеся с Татхагата",
 "sn47.63-72:1.1": "“Среди каких бы то ни было, монахи, существ – безногих, либо двуногих, либо четвероногих, либо многоногих”",
 "sn47.63-72:1.2": "должно быть расширенно.",
 "sn47.63-72:1.3": "Глава Аппамада Седьмая.",
 "sn47.63-72:2.0": "Оглавление",
 "sn47.63-72:2.1": "Татхагата, след-шаг, вершина,",
 "sn47.63-72:2.2": "корень, сердцевина и вассика;",
 "sn47.63-72:2.3": "Царь, луна и солнце,",
 "sn47.63-72:2.4": "тканью десятая стопа."
}
