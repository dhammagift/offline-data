{
 "sn47.42:0.1": "Связанные Наставления 47.42",
 "sn47.42:0.2": "5. Раздел Амата",
 "sn47.42:0.3": "Сутта Скапливания",
 "sn47.42:1.1": "“Четырёх, монахи, установлений памятования и скапливание и захождение научу.",
 "sn47.42:1.2": "Услышьте это.",
 "sn47.42:1.3": "И что, монахи, тела скапливание?",
 "sn47.42:1.4": "От питания-скапливания тела скапливание;",
 "sn47.42:1.5": "от питания-устранения тела захождение.",
 "sn47.42:1.6": "От касания-скапливания чувствований скапливание;",
 "sn47.42:1.7": "от касания-устранения чувствований захождение.",
 "sn47.42:1.8": "От имя-рупы-скапливания ума-состояния скапливание;",
 "sn47.42:1.9": "от имя-рупы-устранения ума-состояния захождение.",
 "sn47.42:1.10": "От мыследеятельности-скапливания явлений скапливание;",
 "sn47.42:1.11": "от мыследеятельности-устранения явлений захождение”.",
 "sn47.42:1.12": "Вторая."
