{
 "sn47.85-94:0.1": "Связанные Наставления 47.85–94",
 "sn47.85-94:0.2": "9. Раздел Есана",
 "sn47.85-94:0.3": "Сутты Начинающиеся с Поиска",
 "sn47.85-94:1.1": "“Три эти, монахи, поиска.",
 "sn47.85-94:1.2": "Какие три?",
 "sn47.85-94:1.3": "Желания-поиск, [индивидуального] существования-поиск, святой-жизни-поиск”",
 "sn47.85-94:1.4": "должно быть расширенно.",
 "sn47.85-94:1.5": "Глава Есана Девятая.",
 "sn47.85-94:2.0": "Оглавление",
 "sn47.85-94:2.1": "Поиск, вид, истечение,",
 "sn47.85-94:2.2": "Бхава с болезненности три;",
 "sn47.85-94:2.3": "Загрязнение, пятно и тягость,",
 "sn47.85-94:2.4": "Чувство, цепляние и залипание."
}
