{
 "sn35.227:0.1": "Связанные Наставления 35.227",
 "sn35.227:0.2": "Раздел Сокращение Саттхи",
 "sn35.227:0.3": "Внешние-области-не-я сутта",
 "sn35.227:1.1": "“Объекты, монахи, не-я. Звуки … запахи … вкусы … касания … явления не-я.",
 "sn35.227:1.2": "Так видящий…",
 "sn35.227:1.3": "иного существования — понимает”.",
 "sn35.227:1.4": "Шестидесяти-сокращение завершено.",
 "sn35.227:2.0": "Оглавление",
 "sn35.227:2.1": "Импульсом восемнадцать являются,",
 "sn35.227:2.2": "прошедшим и две по девять;",
 "sn35.227:2.3": "Что ненадёжно-восемнадцать сказаны,",
 "sn35.227:2.4": "три внутренне-внешних;",
 "sn35.227:2.5": "Сокращение шестидесятое сказано,",
 "sn35.227:2.6": "Пробуждённым солнца-родственником.",
 "sn35.227:2.7": "Сутт шестьдесят."
}
