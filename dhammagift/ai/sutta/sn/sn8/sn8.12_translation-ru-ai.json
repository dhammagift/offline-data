{
 "sn8.12:0.1": "Связанные Наставления 8.12",
 "sn8.12:0.2": "1. Раздел Вангисы",
 "sn8.12:0.3": "Сутта Вангисы",
 "sn8.12:1.1": "Одно время уважаемый Вангиса в Саваттхи располагается, в роще Джеты, в парке Анатхапиндики.",
 "sn8.12:1.2": "И вот в то время уважаемый Вангиса, недавно достигшим арахантства став, освобождения-приятное переживая, по этому случаю эти строфы произнес:",
 "sn8.12:2.1": "“Поэзией-опьянённые бродили мы прежде,",
 "sn8.12:2.2": "из деревни в деревню, из города в город;",
 "sn8.12:2.3": "Тогда увидели мы всепробуждённого,",
 "sn8.12:2.4": "Вера у нас возникла.",
 "sn8.12:3.1": "Он мне явление объяснил,",
 "sn8.12:3.2": "блоки-области-дхату;",
 "sn8.12:3.3": "Его я явление услышав,",
 "sn8.12:3.4": "покинул [дом] в бездомность.",
 "sn8.12:4.1": "Многих, поистине, ради блага-смысла-цели,",
 "sn8.12:4.2": "пробуждение обрёл мудрец;",
 "sn8.12:4.3": "Монахов и монахинь,",
 "sn8.12:4.4": "которые путь-вошедшие-видящие.",
 "sn8.12:5.1": "Благим-приходом, поистине, мне было,",
 "sn8.12:5.2": "моё, у Будды вблизи;",
 "sn8.12:5.3": "Три знания достигнуты,",
 "sn8.12:5.4": "исполнено Будды указание.",
 "sn8.12:6.1": "Прошлые-жизни знаю,",
 "sn8.12:6.2": "Божественное-око очищено;",
 "sn8.12:6.3": "Трёхзнанием, сиддхи-достигший я,",
 "sn8.12:6.4": "Ума-состояния-пути-знаток”.",
 "sn8.12:7.0": "Оглавление",
 "sn8.12:7.1": "Ушедшие не-радование и",
 "sn8.12:7.2": "приятные превозношение;",
 "sn8.12:7.3": "Анандой хорошо сказанное,",
 "sn8.12:7.4": "Сарипутты приглашение;",
 "sn8.12:7.5": "Более тысячи Конданья,",
 "sn8.12:7.6": "Моггалланой Гаггара;",
 "sn8.12:7.7": "Вангисой двенадцать.",
 "sn8.12:7.8": "Вангиса саньютта завершена."
}
