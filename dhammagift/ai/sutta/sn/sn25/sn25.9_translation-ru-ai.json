{
 "sn25.9:0.1": "Связанные Наставления 25.9",
 "sn25.9:0.2": "1. Глава глаза",
 "sn25.9:0.3": "Сутта Твёрдого-дхату",
 "sn25.9:1.1": "В условиях Саваттхи.",
 "sn25.9:1.2": "“Твёрдый-дхату, монахи, ненадёжный-нестабильный, изменчивый, становящийся-иным;",
 "sn25.9:1.3": "жидкости-дхату …",
 "sn25.9:1.4": "дхату тепла…",
 "sn25.9:1.5": "дхату ветра…",
 "sn25.9:1.6": "дхату пространства…",
 "sn25.9:1.7": "внимания-распознавания-дхату ненадёжный-нестабильный, изменчивый, становящийся-иным.",
 "sn25.9:1.8": "Кто, монахи, эти явления так принимает на веру, настраивается, это зовется ‘следующий-вере …",
 "sn25.9:1.9": "к-пробуждению-переправляющийся’”.",
 "sn25.9:1.10": "Девятая."
}
