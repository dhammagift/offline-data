{
 "sn25.8:0.1": "Связанные Наставления 25.8",
 "sn25.8:0.2": "1. Глава глаза",
 "sn25.8:0.3": "Сутта Объекто-цепляния",
 "sn25.8:1.1": "В условиях Саваттхи.",
 "sn25.8:1.2": "“Объекто-цепляние, монахи, ненадёжно, изменчиво, становится иным;",
 "sn25.8:1.3": "звуко-цепляние …",
 "sn25.8:1.4": "запахо-цепляние …",
 "sn25.8:1.5": "вкусо-цепляние …",
 "sn25.8:1.6": "касание-цепляние …",
 "sn25.8:1.7": "явленье-цепляние ненадёжно, изменчиво, становится иным.",
 "sn25.8:1.8": "Кто, монахи, эти явления так принимает на веру, настраивается, это зовется ‘следующий-вере …",
 "sn25.8:1.9": "к-пробуждению-переправляющийся’”.",
 "sn25.8:1.10": "Восьмая."
}
