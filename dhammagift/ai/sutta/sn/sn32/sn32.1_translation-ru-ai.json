{
 "sn32.1:0.1": "Связанные Наставления 32.1",
 "sn32.1:0.2": "1. Раздел Валахака",
 "sn32.1:0.3": "Сутта Чистая",
 "sn32.1:1.1": "В условиях Саваттхи.",
 "sn32.1:1.2": "“Валахака-телесных вам, монахи, божеств преподам.",
