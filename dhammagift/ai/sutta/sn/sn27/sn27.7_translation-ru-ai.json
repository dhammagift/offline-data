{
 "sn27.7:0.1": "Связанные Наставления 27.7",
 "sn27.7:0.2": "1. Раздел загрязнений",
 "sn27.7:0.3": "Сутта Осмысливания",
 "sn27.7:1.1": "В условиях Саваттхи.",
 "sn27.7:1.2": "“Любой, монахи, который образу-осмысливанию импульс-страсть, то ума-состояния это загрязнение.",
 "sn27.7:1.3": "Который звуку-осмысливанию …",
 "sn27.7:1.4": "который запаху-осмысливанию …",
 "sn27.7:1.5": "который вкусу-осмысливанию …",
 "sn27.7:1.6": "который касанию-осмысливанию …",
 "sn27.7:1.7": "который явлению-осмысливанию импульс-страсть, то ума-состояния это загрязнение.",
 "sn27.7:1.8": "Когда, монахи, монахом …",
 "sn27.7:1.9": "в явлениях, подлежащих опознанию-засвидетельствованию».",
 "sn27.7:1.10": "Седьмая."
}
