{
 "sn27.4:0.1": "Связанные Наставления 27.4",
 "sn27.4:0.2": "1. Раздел загрязнений",
 "sn27.4:0.3": "Сутта Соприкасания",
 "sn27.4:1.1": "В условиях Саваттхи.",
 "sn27.4:1.2": "«Любой, монахи, в касании-глаза импульс-страсть — это загрязнение ума-состояния.",
 "sn27.4:1.3": "Любой в касании-уха …",
 "sn27.4:1.4": "любой в касании-носа …",
 "sn27.4:1.5": "любой в касании-языка …",
 "sn27.4:1.6": "любой в касании-тела …",
 "sn27.4:1.7": "любой в касании-ума-представления импульс-страсть — это загрязнение ума-состояния.",
 "sn27.4:1.8": "Когда, монахи, монахом …",
 "sn27.4:1.9": "в явлениях, подлежащих опознанию-засвидетельствованию».",
 "sn27.4:1.10": "Четвёртая."
}
