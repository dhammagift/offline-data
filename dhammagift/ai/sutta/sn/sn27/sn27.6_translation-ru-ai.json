{
 "sn27.6:0.1": "Связанные Наставления 27.6",
 "sn27.6:0.2": "1. Раздел загрязнений",
 "sn27.6:0.3": "Сутта Сознаваний",
 "sn27.6:1.1": "В условиях Саваттхи.",
 "sn27.6:1.2": "«Любой, монахи, в сознавании-образе импульс-страсть — это загрязнение ума-состояния.",
 "sn27.6:1.3": "Любой в сознавании-звуке …",
 "sn27.6:1.4": "любой в сознавании-запахе …",
 "sn27.6:1.5": "любой в сознавании-вкусе …",
 "sn27.6:1.6": "любой в сознавании-касании …",
 "sn27.6:1.7": "любой в сознавании-явлении импульс-страсть — это загрязнение ума-состояния.",
 "sn27.6:1.8": "Когда, монахи, монахом …",
 "sn27.6:1.9": "в явлениях, подлежащих опознанию-засвидетельствованию».",
 "sn27.6:1.10": "Шестая."
