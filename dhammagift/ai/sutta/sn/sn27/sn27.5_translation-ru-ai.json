{
 "sn27.5:0.1": "Связанные Наставления 27.5",
 "sn27.5:0.2": "1. Раздел загрязнений",
 "sn27.5:0.3": "Сутта Затронутостью-Рожденное",
 "sn27.5:1.1": "В условиях Саваттхи.",
 "sn27.5:1.2": "“Какой, монахи, в рождённом-касанием-глаза чувствовании импульс-страсть, то ума-состояния загрязнение.",
 "sn27.5:1.3": "Какой в рождённом-касанием-уха чувствовании…",
 "sn27.5:1.4": "какой в рождённом-касанием-носа чувствовании…",
 "sn27.5:1.5": "какой в рождённом-касанием-языка чувствовании…",
 "sn27.5:1.6": "какой в рождённом-касанием-тела чувствовании…",
 "sn27.5:1.7": "какой в рождённом-касанием-ума-представления чувствовании импульс-страсть, то ума-состояния загрязнение.",
 "sn27.5:1.8": "Когда, монахи, монахом …",
 "sn27.5:1.9": "в явлениях, подлежащих опознанию-засвидетельствованию».",
 "sn27.5:1.10": "Пятая."
}
