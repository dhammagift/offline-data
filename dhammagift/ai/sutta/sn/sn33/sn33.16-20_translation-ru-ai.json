{
 "sn33.16:0.1": "Связанные Наставления 33.16–20",
 "sn33.16:0.2": "1. Раздел Ваччхаготты",
 "sn33.16:0.3": "Материи-непрояснения-и-прочее-сутты-пятерица",
 "sn33.16:1.1": "В условиях Саваттхи.",
 "sn33.16:1.2": "Рядом севший странник Ваччхаготта Благословенному это сказал:",
 "sn33.16:1.3": "В чем, уважаемый Готама, причина, какой повод…",
 "sn33.16:1.4": "Материи, Ваччха, из-за непрояснения… “к-материи-устранению-ведущей практики из-за непрояснения….",
 "sn33.17:1.1": "В условиях Саваттхи.",
 "sn33.17:1.2": "“Чувствования, Ваччха….",
 "sn33.18:1.1": "В условиях Саваттхи.",
 "sn33.18:1.2": "“Сознавания, Ваччха….",
 "sn33.19:1.1": "В условиях Саваттхи.",
 "sn33.19:1.2": "“Составляющих, Ваччха….",
 "sn33.20:1.1": "В условиях Саваттхи.",
 "sn33.20:1.2": "“Распознавания, Ваччха, из-за непрояснения…",
 "sn33.20:1.3": "к-распознаванию-устранению-ведущей практики из-за непрояснения…",
 "sn33.20:1.4": "двадцатая."
}
