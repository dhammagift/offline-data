{
 "sn33.11:0.1": "Связанные Наставления 33.11–15",
 "sn33.11:0.2": "1. Раздел Ваччхаготты",
 "sn33.11:0.3": "Пять сутт о не-проникновении в материю и т.д.",
 "sn33.11:1.1": "В условиях Саваттхи.",
 "sn33.11:1.2": "“В материи, Ваччха, из-за не-проникновения… к материи-устранению-ведущей практики из-за не-проникновения….",
 "sn33.12:1.1": "В условиях Саваттхи.",
 "sn33.12:1.2": "“В чувствовании, Ваччха, из-за не-проникновения….",
 "sn33.13:1.1": "В условиях Саваттхи.",
 "sn33.13:1.2": "“В сознавании, Ваччха, из-за не-проникновения….",
 "sn33.14:1.1": "В условиях Саваттхи.",
 "sn33.14:1.2": "“В составляющих, Ваччха, из-за не-проникновения….",
 "sn33.15:1.1": "В условиях Саваттхи.",
 "sn33.15:1.2": "“В распознавании, Ваччха, из-за не-проникновения….",
 "sn33.15:1.3": "Пятнадцатая."
}
