{
 "sn12.1:0.1": "Связанные Наставления 12.1",
 "sn12.1:0.2": "1. Глава Будда",
 "sn12.1:0.3": "Сутта Зависимой Последовательности",
 "sn12.1:1.1": "Так мной услышано—",
 "sn12.1:1.2": "одно время Благословенный в Саваттхи располагается, в роще Джеты, в парке Анатхапиндики.",
 "sn12.1:1.3": "И здесь Благословенный к монахам обратился:",
 "sn12.1:1.4": "“Монахи”.",
 "sn12.1:1.5": "“Достопочтенный”, — те монахи Благословенному ответили.",
 "sn12.1:1.6": "Благословенный это сказал:",
 "sn12.1:1.7": "“Зависимую Последовательность вам, монахи, объясню.",
 "sn12.1:1.8": "То услышьте, хорошо в уме-представлении отразите, буду говорить”.",
 "sn12.1:1.9": "“Так, почтенный”, — те монахи Благословенному ответили.",
 "sn12.1:1.10": "Благословенный это сказал:",
 "sn12.1:2.1": "“И что такое, монахи, зависимая последовательность?",
 "sn12.1:2.2": "Невидением обусловлены, монахи, составляющие;",
 "sn12.1:2.3": "составляющими обусловлено внимание;",
 "sn12.1:2.4": "вниманием обусловлена имя-материя;",
 "sn12.1:2.5": "именем-материей обусловлена шестеричная-область;",
 "sn12.1:2.6": "шестеричной областью обусловлено касание;",
 "sn12.1:2.7": "касанием обусловлено ведание;",
 "sn12.1:2.8": "веданием обусловлено цепляние;",
 "sn12.1:2.9": "цеплянием обусловлено поддерживание;",
 "sn12.1:2.10": "поддерживанием обусловлена вовлеченность;",
 "sn12.1:2.11": "вовлеченностью обусловлено рождение;",
 "sn12.1:2.12": "рождением обусловлено старение-умирание, страдание, плач, боль, недовольство, тоска появляются.",
 "sn12.1:2.13": "Так этого полного боли-блока есть скапливание.",
 "sn12.1:2.14": "Это называется, монахи, зависимой последовательностью.",
 "sn12.1:3.1": "Но именно от невидения без-остатка-без-очарованности-устранения — составляющих-устранение;",
 "sn12.1:3.2": "от устранения составляющих — внимания-устранение;",
 "sn12.1:3.3": "от внимания-устранения — имя-материи-устранение;",
 "sn12.1:3.4": "от имя-материи-устранения — шестеричной-области-устранение;",
 "sn12.1:3.5": "от шестеричной-области-устранения — касания-устранение;",
 "sn12.1:3.6": "от касания-устранения — ведания-устранение;",
 "sn12.1:3.7": "от ведания-устранения — цепляния-устранение;",
 "sn12.1:3.8": "от цепляния-устранения — поддерживания-устранение;",
 "sn12.1:3.9": "поддерживания-устранением — бытия-устранение;",
 "sn12.1:3.10": "бытия-устранением — рождения-устранение;",
 "sn12.1:3.11": "рождения-устранением — старение-умирание, страдание, плач, боль, недовольство, тоска устраняются.",
 "sn12.1:3.12": "Так этого полного боли-блока есть устранение”.",
 "sn12.1:3.13": "Это сказал Благословенный.",
 "sn12.1:3.14": "Довольные те монахи Благословенного речи обрадовались.",
 "sn12.1:3.15": "Первая."
}
