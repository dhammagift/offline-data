{
 "sn12.72-81:0.1": "Связанные Наставления 12.72–81",
 "sn12.72-81:0.2": "8. Раздел шраманов и брахманов",
 "sn12.72-81:0.3": "Десятица сутт рождения и т.д.",
 "sn12.72-81:1.1": "“В Саваттхи располагается.",
 "sn12.72-81:1.2": "Рождение не понимают…",
 "sn12.72-81:2.1": "“Бхаву не понимают…",
 "sn12.72-81:3.1": "“Поддерживание не понимают…",
 "sn12.72-81:4.1": "“Цепляние не понимают…",
 "sn12.72-81:5.1": "“Чувствование не понимают…",
 "sn12.72-81:6.1": "“Касание не понимают…",
 "sn12.72-81:7.1": "“Шестеричную-область не понимают…",
 "sn12.72-81:8.1": "“Имя-материю не понимают…",
 "sn12.72-81:9.1": "“Распознавание не понимают…",
 "sn12.72-81:10.1": "“Составляющие не понимают, составляющих скапливание не понимают, составляющих устранение не понимают, к составляющих-устранению-ведущую практику не понимают…",
 "sn12.72-81:10.2": "понимают…",
 "sn12.72-81:10.3": "лично познав, реализовав, достигнув, пребывают”.",
 "sn12.72-81:10.4": "Одиннадцатая.",
 "sn12.72-81:10.5": "Глава шраманов и брахманов восьмая.",
 "sn12.72-81:11.0": "Оглавление",
 "sn12.72-81:11.1": "Одиннадцать условий сказаны,",
 "sn12.72-81:11.2": "четырёх-истин разбор;",
 "sn12.72-81:11.3": "Глава шраманов и брахманов,",
 "sn12.72-81:11.4": "в основании бывает восьмая.",
 "sn12.72-81:12.0": "глава-перечисление",
 "sn12.72-81:12.1": "Пробуждённый, питание, десять сил,",
 "sn12.72-81:12.2": "Калара, домохозяин пятый;",
 "sn12.72-81:12.3": "Глава боли, большая глава,",
 "sn12.72-81:12.4": "Восьмая шраманов и брахманов."
}
