{
 "sn9.2:0.1": "Связанные Наставления 9.2",
 "sn9.2:0.2": "1. Глава Лес",
 "sn9.2:0.3": "Сутта Вставание",
 "sn9.2:1.1": "Одно время некий монах в Косалах располагается в некой лесной чаще.",
 "sn9.2:1.2": "И в то время тот монах, уйдя на дневное пребывание, спит.",
 "sn9.2:1.3": "И тогда та, что в той лесной чаще обитающая, дэва, тому монаху сострадательная, блага желающая, того монаха желая встряхнуть, где тот монах, туда подошла; подойдя того монаха строфами обратилась:",
 "sn9.2:2.1": "“Вставай, монах, что спишь,",
 "sn9.2:2.2": "какой смысл в спанье твоём;",
 "sn9.2:2.3": "Больному ведь какой сон,",
 "sn9.2:2.4": "стрелой пронзённому, страдающему.",
 "sn9.2:3.1": "Той верой, с которой ушёл в бездомность,",
 "sn9.2:3.2": "из дома в бездомность;",
 "sn9.2:3.3": "Ту самую веру укрепляй,",
 "sn9.2:3.4": "не дай сну собой овладеть”.",
 "sn9.2:4.1": "“Ненадёжны, непостоянны желания,",
 "sn9.2:4.2": "в которых глупый только очарован;",
 "sn9.2:4.3": "Среди привязанностей освобождённый, непривязанный,",
 "sn9.2:4.4": "зачем ушедшего в бездомность тревожить.",
 "sn9.2:5.1": "Через выведение импульса-страсти,",
 "sn9.2:5.2": "через преодоление невидения;",
 "sn9.2:5.3": "То знание высшее очищение,",
 "sn9.2:5.4": "зачем ушедшего в бездомность тревожить.",
 "sn9.2:6.1": "Отсекши невидение видением,",
 "sn9.2:6.2": "через исчерпание истечений;",
 "sn9.2:6.3": "Без-страдания, без-томления,",
 "sn9.2:6.4": "зачем ушедшего в бездомность тревожить.",
 "sn9.2:7.1": "С начатой решимостью, устремлённым умом,",
 "sn9.2:7.2": "Постоянно с твёрдым усердием;",
 "sn9.2:7.3": "Ниббану желающего,",
 "sn9.2:7.4": "Зачем ушедшего в бездомность тревожить”."
}
