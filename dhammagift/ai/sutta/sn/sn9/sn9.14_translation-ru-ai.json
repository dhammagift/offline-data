{
 "sn9.14:0.1": "Связанные Наставления 9.14",
 "sn9.14:0.2": "1. Глава Лес",
 "sn9.14:0.3": "Сутта Ворующего-Запах",
 "sn9.14:1.1": "Одно время некий монах в Косалах располагается в некой лесной чаще.",
 "sn9.14:1.2": "И вот в то время тот монах после обеда, вернувшись с подаяния, войдя в лотосовый пруд, нюхает лотос.",
 "sn9.14:1.3": "И тогда та, что в той лесной роще обитала, дэвата, тому монаху сострадательная, желающая блага, того монаха желая встряхнуть, где тот монах, туда подошла; подойдя того монаха строфой обратилась:",
 "sn9.14:2.1": "“Этот водный цветок,",
 "sn9.14:2.2": "не взятый ты нюхаешь;",
 "sn9.14:2.3": "Это один из аспектов краж,",
 "sn9.14:2.4": "ворующий-запах ты, почтенный”.",
 "sn9.14:3.1": "“Не уношу, не ломаю,",
 "sn9.14:3.2": "издалека нюхаю водный;",
 "sn9.14:3.3": "Так по какой же причине,",
 "sn9.14:3.4": "ворующим-запах называюсь.",
 "sn9.14:4.1": "А тот, кто корни выкапывает,",
 "sn9.14:4.2": "белые лотосы ломает;",
 "sn9.14:4.3": "Такой, с деятельностью смешанной,",
 "sn9.14:4.4": "почему же он не называется?”.",
 "sn9.14:5.1": "“Смешанно-грубый человек,",
 "sn9.14:5.2": "как промасленная тряпка;",
 "sn9.14:5.3": "К нему у меня речи нет,",
 "sn9.14:5.4": "а ты достоин, чтобы я сказал.",
 "sn9.14:6.1": "У безупречного человека,",
 "sn9.14:6.2": "постоянно ищущего чистоту;",
 "sn9.14:6.3": "Даже волосяного кончика плохого,",
 "sn9.14:6.4": "как облачко кажется”.",
 "sn9.14:7.1": "“Поистине, меня, дух, ты знаешь,",
 "sn9.14:7.2": "а после меня жалеешь;",
 "sn9.14:7.3": "Снова, яккха, скажи,",
 "sn9.14:7.4": "когда видишь такое”.",
 "sn9.14:8.1": "“Не тебя мы проживаем,",
 "sn9.14:8.2": "и не твои мы желание-работники;",
 "sn9.14:8.3": "Ты сам, монах, должен знать,",
 "sn9.14:8.4": "куда идти в благую участь”.",
 "sn9.14:9.1": "И тогда тот монах той дэвой встряхнутый, встряску обрёл.",
 "sn9.14:9.2": "Глава Лесная Первая.",
 "sn9.14:10.0": "Оглавление",
 "sn9.14:10.1": "Уединение и постановление,",
 "sn9.14:10.2": "Кассапаготтой и группой;",
 "sn9.14:10.3": "Ананда и Ануруддха,",
 "sn9.14:10.4": "Нагадатта и домохозяйка.",
 "sn9.14:11.1": "Ваджипутта и Весали,",
 "sn9.14:11.2": "Декламацией и неправильно;",
 "sn9.14:11.3": "В полуденное время с открытыми способностями —",
 "sn9.14:11.4": "Цветком лотоса четырнадцать становится.",
 "sn9.14:11.5": "Лесная саньютта завершена."
}
