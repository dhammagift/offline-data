{
 "an10.120:0.1": "Восходящие Наставления 10.120",
 "an10.120:0.2": "Раздел Пассорохани",
 "an10.120:0.3": "Сутта Второе-Нисхождение",
 "an10.120:1.1": "“Благородное, монахи, нисхождение вам объясню.",
 "an10.120:1.2": "Услышьте это …",
 "an10.120:1.3": "и что такое, монахи, благородное нисхождение?",
 "an10.120:1.4": "Вот, монахи, благородно-слушатель это заключает:",
 "an10.120:1.5": "‘У ошибочного взгляда плохой результат —",
 "an10.120:1.6": "в видимой действительности и в последующем’.",
 "an10.120:1.7": "Он, так обдумав, ошибочный взгляд оставляет;",
 "an10.120:1.8": "от ошибочного взгляда нисходит.",
 "an10.120:1.9": "У ошибочного устремления плохой результат …",
 "an10.120:1.10": "у ошибочной речи …",
 "an10.120:1.11": "у ошибочных действий …",
 "an10.120:1.12": "у ошибочного быта …",
 "an10.120:1.13": "у ошибочного старания …",
 "an10.120:1.14": "у ошибочной памятовательности …",
 "an10.120:1.15": "Для с-ошибочным-самадхи человека-личности правильное-самадхи для полного-остужения есть.",
 "an10.120:1.16": "у ошибочного знания …",
 "an10.120:1.17": "у ошибочного высвобождения плохой результат —",
 "an10.120:1.18": "в видимой действительности и в последующем.",
 "an10.120:1.19": "Он, так обдумав, ошибочное высвобождение оставляет;",
 "an10.120:1.20": "от ошибочного высвобождения нисходит.",
 "an10.120:1.21": "Это называется, монахи, благородное нисхождение”.",
 "an10.120:1.22": "Восьмая."
}
