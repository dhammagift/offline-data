{
 "an10.78:0.1": "Восходящие Наставления 10.78",
 "an10.78:0.2": "Раздел Аканкха",
 "an10.78:0.3": "Сутта Нигантха",
 "an10.78:1.1": "“С десятью, монахи, не-благими явлениями наделены нигантхи.",
 "an10.78:1.2": "Какими десятью?",
 "an10.78:1.3": "Без-верные, монахи, нигантхи;",
 "an10.78:1.4": "безнравственные, монахи, нигантхи;",
 "an10.78:1.5": "бесстыдные, монахи, нигантхи;",
 "an10.78:1.6": "не-боящиеся, монахи, нигантхи;",
 "an10.78:1.7": "с-нечистыми-связанные, монахи, нигантхи;",
 "an10.78:1.8": "себя-восхваляющие других-унижающие, монахи, нигантхи;",
 "an10.78:1.9": "увиденным-одержимые удерживающие-схватившие плохо-отдаляющиеся, монахи, нигантхи;",
 "an10.78:1.10": "лживые, монахи, нигантхи;",
 "an10.78:1.11": "с-плохими-желаниями, монахи, нигантхи;",
 "an10.78:1.12": "с-плохими-друзьями, монахи, нигантхи—",
 "an10.78:1.13": "с этими, монахи, десятью не-благими явлениями наделены нигантхи”.",
 "an10.78:1.14": "Восьмая."
}
