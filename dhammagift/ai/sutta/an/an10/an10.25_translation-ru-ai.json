{
 "an10.25:0.1": "Восходящие Наставления 10.25",
 "an10.25:0.2": "3. Большая Глава",
 "an10.25:0.3": "Сутта Касины",
 "an10.25:1.1": "“Эти десять, монахи, касин-областей.",
