{
 "an5.40:0.1": "Восходящие Наставления 5.40",
 "an5.40:0.2": "Раздел Суманы",
 "an5.40:0.3": "Сутта Большого Сала",
 "an5.40:1.1": "“На Гималаи, монахи, царя-гору опираясь, большие салы пятью возрастаниями возрастают.",
 "an5.40:1.2": "Какими пятью?",
 "an5.40:1.3": "Ветвями-листьями-листвой возрастают;",
 "an5.40:1.4": "корой возрастают;",
 "an5.40:1.5": "лубом возрастают;",
 "an5.40:1.6": "заболонью возрастают;",
 "an5.40:1.7": "сердцевиной возрастают.",
 "an5.40:1.8": "На Гималаи, монахи, царя-гору опираясь, большие салы этими пятью возрастаниями возрастают.",
 "an5.40:1.9": "Точно так, монахи, на верующего сына семьи опираясь, домочадцы пятью возрастаниями возрастают.",
 "an5.40:1.10": "Какими пятью?",
 "an5.40:1.11": "Верой возрастает;",
 "an5.40:1.12": "нравственностью возрастает;",
 "an5.40:1.13": "учёностью возрастает;",
 "an5.40:1.14": "щедростью возрастает;",
 "an5.40:1.15": "пониманием возрастает.",
 "an5.40:1.16": "На верующего, монахи, сына семьи опираясь, домочадцы этими пятью возрастаниями возрастает.",
 "an5.40:2.1": "Как если бы скала-гора,",
 "an5.40:2.2": "в лесу, в большой чаще;",
 "an5.40:2.3": "Её деревья опирая,",
 "an5.40:2.4": "возрастают те лесные растения.",
 "an5.40:3.1": "Так же нравственностью-наделённого,",
 "an5.40:3.2": "Верующего сына семьи этого;",
 "an5.40:3.3": "Опирая возрастают,",
 "an5.40:3.4": "Сыновья-жёны и родственники;",
 "an5.40:3.5": "Партнёры, семья-собрание и,",
 "an5.40:3.6": "И те, кто от него зависят.",
 "an5.40:4.1": "У него нравственного нравственность,",
 "an5.40:4.2": "щедрость и благие поступки;",
 "an5.40:4.3": "Видя, подражают,",
 "an5.40:4.4": "которые бывают разумные.",
 "an5.40:5.1": "Здесь Дхамму прожив,",
 "an5.40:5.2": "путь к благому-идущий;",
 "an5.40:5.3": "Радостные в мире дэвов,",
 "an5.40:5.4": "наслаждаются желающие-желания”ти.",
 "an5.40:5.5": "Десятая.",
 "an5.40:5.6": "Глава Сумана Четвёртая.",
 "an5.40:6.0": "Оглавление",
 "an5.40:6.1": "Сумана, Чунди, Уггахо,",
 "an5.40:6.2": "лев даяния-преимуществ;",
 "an5.40:6.3": "Время-еды-вера и,",
 "an5.40:6.4": "сыновьями-залами те десять."
}
