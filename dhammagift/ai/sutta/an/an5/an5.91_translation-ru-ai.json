{
 "an5.91:0.1": "Восходящие Наставления 5.91",
 "an5.91:0.2": "10. Какудхавагга",
 "an5.91:0.3": "Сутта Первое-совершенство",
 "an5.91:1.1": "“Пять этих, монахи, наделённостей.",
 "an5.91:1.2": "Какие пять?",
 "an5.91:1.3": "Вера-наделённость, нравственность-наделённость, обученность-наделённость, щедрость-наделённость, понимание-наделённость—",
 "an5.91:1.4": "эти, монахи, пять наделённостей”.",
 "an5.91:1.5": "Первая."
}
