{
 "an5.245:0.1": "Восходящие Наставления 5.245",
 "an5.245:0.2": "25. Раздел плохого-поведения",
 "an5.245:0.3": "Вторая Сутта о неблагом поведении",
 "an5.245:1.1": "“Пять эти, монахи, недостатки-опасности в плохом-поведении.",
 "an5.245:1.2": "Какие пять?",
 "an5.245:1.3": "Сам себя порицает;",
 "an5.245:1.4": "проверив, знающие порицают;",
 "an5.245:1.5": "плохая молва-слава поднимается;",
 "an5.245:1.6": "от истинной Дхаммы отходит;",
 "an5.245:1.7": "в не-истинной Дхамме утверждается.",
 "an5.245:1.8": "Вот эти, монахи, пять недостатков-опасностей в плохом-поведении.",
 "an5.245:2.1": "Пять эти, монахи, преимуществ в хорошем-поведении.",
 "an5.245:2.2": "Какие пять?",
 "an5.245:2.3": "Сам себя не порицает;",
 "an5.245:2.4": "проверив, знающие одобряют;",
 "an5.245:2.5": "благая молва о репутации восходит;",
 "an5.245:2.6": "от не-истинной Дхаммы отходит;",
 "an5.245:2.7": "в истинной Дхамме утверждается.",
 "an5.245:2.8": "Вот эти, монахи, пять преимуществ в хорошем-поведении”.",
 "an5.245:2.9": "Пятая."
}
