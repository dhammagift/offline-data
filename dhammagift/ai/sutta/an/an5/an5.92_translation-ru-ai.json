{
 "an5.92:0.1": "Восходящие Наставления 5.92",
 "an5.92:0.2": "10. Какудхавагга",
 "an5.92:0.3": "Вторая-Наделённость-Сутта",
 "an5.92:1.1": "“Пять этих, монахи, наделённостей.",
