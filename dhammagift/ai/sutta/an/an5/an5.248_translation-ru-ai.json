{
 "an5.248:0.1": "Восходящие Наставления 5.248",
 "an5.248:0.2": "25. Раздел плохого-поведения",
 "an5.248:0.3": "Сутта Второе-ум-представление-дурное-поведение",
 "an5.248:1.1": "“Пять эти, монахи, недостатки-опасности в дурном поведении ума … преимущества в хорошем поведении ума.",
 "an5.248:1.2": "Какие пять?",
 "an5.248:1.3": "Сам себя не порицает;",
 "an5.248:1.4": "проверив, знающие одобряют;",
 "an5.248:1.5": "благая молва о репутации восходит;",
 "an5.248:1.6": "от не-истинной Дхаммы отходит;",
 "an5.248:1.7": "в истинной Дхамме утверждается.",
 "an5.248:1.8": "Эти пять, монахи, — преимущества в хорошем поведении ума”.",
 "an5.248:1.9": "Восьмая."
}
