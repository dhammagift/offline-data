{
 "an5.36:0.1": "Восходящие Наставления 5.36",
 "an5.36:0.2": "Раздел Суманы",
 "an5.36:0.3": "Сутта Своевременного Даяния",
 "an5.36:1.1": "“Эти пять, монахи, своевременных даяний.",
 "an5.36:1.2": "Какие пять?",
 "an5.36:1.3": "Пришедшему даяние даёт;",
 "an5.36:1.4": "уходящему даяние даёт;",
 "an5.36:1.5": "больному даяние даёт;",
 "an5.36:1.6": "в голоде даяние даёт;",
 "an5.36:1.7": "какие есть новые зерна, новые плоды — их первыми у нравственных устанавливает.",
 "an5.36:1.8": "Вот эти, монахи, пять своевременных даяний.",
 "an5.36:2.1": "Вовремя дают понимающие,",
 "an5.36:2.2": "щедрые, без скупости;",
 "an5.36:2.3": "Вовремя данное у благородных,",
 "an5.36:2.4": "прямых, таковых.",
 "an5.36:3.1": "С прояснённым умом у того",
 "an5.36:3.2": "обильным становится подношение;",
 "an5.36:3.3": "Кто там радуется,",
 "an5.36:3.4": "услугу делает или;",
 "an5.36:3.5": "От этого подношение не умаляется,",
 "an5.36:3.6": "они тоже блага дольщики.",
 "an5.36:4.1": "Поэтому давай с неотступающим умом,",
 "an5.36:4.2": "Где данное — великоплодно;",
 "an5.36:4.3": "Благие заслуги в следующем мире",
 "an5.36:4.4": "Установлением становятся для живых”.",
 "an5.36:4.5": "Шестая."
}
