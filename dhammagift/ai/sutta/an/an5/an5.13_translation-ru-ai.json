{
 "an5.13:0.1": "Восходящие Наставления 5.13",
 "an5.13:0.2": "Раздел Силы",
 "an5.13:0.3": "Сутта вкратце",
 "an5.13:1.1": "“Пять этих, монахи, сил.",
 "an5.13:1.2": "Какие пять?",
 "an5.13:1.3": "Сила веры, сила решимости, сила памятования, сила самадхи, сила понимания—",
 "an5.13:1.4": "Вот эти, монахи, пять сил”.",
 "an5.13:1.5": "Третья."
}
