{
 "an5.204:0.1": "Восходящие Наставления 5.204",
 "an5.204:0.2": "Раздел Кимила",
 "an5.204:0.3": "Сутта Силы",
 "an5.204:1.1": "“Пять этих, монахи, сил.",
 "an5.204:1.2": "Какие пять?",
 "an5.204:1.3": "Сила веры, сила стыда, сила боязни, сила решимости, сила понимания—",
 "an5.204:1.4": "Вот эти, монахи, пять сил”.",
 "an5.204:1.5": "Четвёртая."
}
