{
 "an5.35:0.1": "Восходящие Наставления 5.35",
 "an5.35:0.2": "Раздел Суманы",
 "an5.35:0.3": "Сутта Пользы-Даяния",
 "an5.35:1.1": "“Пять эти, монахи, в даянии пользы.",
 "an5.35:1.2": "Какие пять?",
 "an5.35:1.3": "Многих людей любим он, приятен;",
 "an5.35:1.4": "чистые люди общаются;",
 "an5.35:1.5": "благая молва о репутации восходит;",
 "an5.35:1.6": "от домохозяйских принципов не отступившим бывает;",
 "an5.35:1.7": "с распадом тела, после смерти, в благую участь, в небесный мир возникает.",
 "an5.35:1.8": "Эти вот, монахи, пять в даянии пользы.",
 "an5.35:2.1": "Дающий любим бывает,",
 "an5.35:2.2": "благих явление следуя;",
 "an5.35:2.3": "Чистые его всегда общаются,",
 "an5.35:2.4": "сознающие, ведущие святую жизнь.",
 "an5.35:3.1": "Те ему явление учат,",
 "an5.35:3.2": "всей-боли-устраняющее;",
 "an5.35:3.3": "Какое он явление здесь познав,",
 "an5.35:3.4": "Остывает без истечений”.",
 "an5.35:3.5": "Пятая."
}
