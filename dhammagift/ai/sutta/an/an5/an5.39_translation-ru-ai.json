{
 "an5.39:0.1": "Восходящие Наставления 5.39",
 "an5.39:0.2": "Раздел Суманы",
 "an5.39:0.3": "Сутта Сын",
 "an5.39:1.1": "“Эти пять, монахи, оснований видя, мать-отец сына желают в роду рождающегося.",
 "an5.39:1.2": "Какие пять?",
 "an5.39:1.3": "Вскормленный или нас прокормит;",
 "an5.39:1.4": "дело или нам сделает;",
 "an5.39:1.5": "родовая линия долго простоит;",
 "an5.39:1.6": "наследство примет;",
 "an5.39:1.7": "или же умершим предкам подношение передаст.",
 "an5.39:1.8": "Эти, монахи, пять оснований видя, мать-отец сына желают в роду рождающегося.",
 "an5.39:2.1": "Пять оснований видя,",
 "an5.39:2.2": "сына желают мудрецы;",
 "an5.39:2.3": "Вскормленный или нас прокормит,",
 "an5.39:2.4": "дело или нам сделает.",
 "an5.39:3.1": "Родовая линия долго простоит,",
 "an5.39:3.2": "наследство примет;",
 "an5.39:3.3": "Или же умершим,",
 "an5.39:3.4": "подношение передаст.",
 "an5.39:4.1": "Основания эти видя,",
 "an5.39:4.2": "сына желают мудрецы;",
 "an5.39:4.3": "Потому благие, чистые люди,",
 "an5.39:4.4": "благодарные, признательные.",
 "an5.39:5.1": "Кормят мать-отца,",
 "an5.39:5.2": "прежнее сделанное помня;",
 "an5.39:5.3": "Делают им дела,",
 "an5.39:5.4": "как то — прежним делателям.",
 "an5.39:6.1": "Наставления исполняющий, кормильца кормящий,",
 "an5.39:6.2": "род-линию не умаляя;",
 "an5.39:6.3": "Верующий, нравственностью наделённый,",
 "an5.39:6.4": "сыном является похвальным”.",
 "an5.39:6.5": "Девятая."
}
