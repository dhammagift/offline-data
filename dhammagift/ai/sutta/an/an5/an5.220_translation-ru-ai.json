{
 "an5.220:0.1": "Восходящие Наставления 5.220",
 "an5.220:0.2": "Раздел Оскорбляющего",
 "an5.220:0.3": "Сутта Мадхура",
 "an5.220:1.1": "“Пять эти, монахи, недостатки-опасности в Мадхуре.",
 "an5.220:1.2": "Какие пять?",
 "an5.220:1.3": "Неровные дороги, много пыли, свирепые собаки, дикие духи, трудная еда.",
 "an5.220:1.4": "Вот эти, монахи, пять недостатков-опасностей в Мадхуре”.",
 "an5.220:1.5": "Десятая.",
 "an5.220:1.6": "Глава Оскорблений Вторая.",
 "an5.220:2.0": "Оглавление",
 "an5.220:2.1": "Оскорбление-ссора-принцип,",
 "an5.220:2.2": "многоречивый, два нетерпения;",
 "an5.220:2.3": "Неприятные два сказаны,",
 "an5.220:2.4": "в огне с Мадхурой и."
