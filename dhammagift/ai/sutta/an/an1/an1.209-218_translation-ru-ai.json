{
 "an1.209:0.1": "Восходящие Наставления 1",
 "an1.209:0.2": "16. Раздел Третий",
 "an1.209:1.1": "“Это высшее, монахи, моих слушателей монахов желающих-обучения, а именно Рахула.",
 "an1.210:1.1": "… С верой-ушедших а именно Раттхапала.",
 "an1.211:1.1": "… Первую палочку берущих а именно Кундадхана.",
 "an1.212:1.1": "… Красноречивых а именно Вангиша.",
 "an1.213:1.1": "… Всецело-приятных а именно Упасена Вангантапутта.",
 "an1.214:1.1": "… Обитель-назначающих а именно Дабба Маллапутта.",
 "an1.215:1.1": "… Дэватам милым-приятным а именно Пилиндаваччха.",
 "an1.216:1.1": "… Быстро-высших-знаний а именно Бахия Даручирия.",
 "an1.217:1.1": "… Разнообразно-говорящих а именно Кумаракассапа.",
 "an1.218:1.1": "… Аналитического-знания-достигших а именно Махакоттхита”.",
 "an1.218:1.2": "Глава третья."
}
