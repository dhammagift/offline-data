{
 "an1.235:0.1": "Восходящие Наставления 1",
 "an1.235:0.2": "18. Пятая Глава",
 "an1.235:1.1": "“Это главное, монахи, из моих последовательниц-монахинь, знающих давно, а именно—Махападжапатиготами.",
 "an1.236:1.1": "… Из велико-понимающих а именно—Кхема.",
 "an1.237:1.1": "… Из обладающих сверхспособностями а именно—Уппалаванна.",
 "an1.238:1.1": "… Из знатоков вычищения а именно—Патачара.",
 "an1.239:1.1": "… Из говорящих о явлениях а именно—Дхаммадинна.",
 "an1.240:1.1": "… Из джхана-практикующих а именно—Нанда.",
 "an1.241:1.1": "… Из решимость-приложивших а именно—Сона.",
 "an1.242:1.1": "… Из божественно-глаз-имеющих а именно—Бакула.",
 "an1.243:1.1": "… Из быстро-сверхзнающих а именно—Бхадда Кундалакеса.",
 "an1.244:1.1": "… Из прошлые-обители вспоминающих а именно—Бхадда Капилани.",
 "an1.245:1.1": "… Из велико-сверхзнания-достигших а именно—Бхаддакаччана.",
 "an1.246:1.1": "… Из грубо-одежду-носящих а именно—Кисаготами.",
 "an1.247:1.1": "… Из веро-устремлённых а именно—Сингалакамата”.",
 "an1.247:1.2": "Глава пятая."
}
