{
 "an1.198:0.1": "Восходящие Наставления 1",
 "an1.198:0.2": "15. Вторая Глава",
 "an1.198:1.1": "“Это-лучшее, монахи, моих слушателей монахов умом-созданное тело творящих, а именно Чулапантхака.",
 "an1.199:1.1": "… Ум-поворота-умелых а именно Чулапантхака.",
 "an1.200:1.1": "… Сознавание-поворота-умелых а именно Махапантхака.",
 "an1.201:1.1": "… Без-конфликта-пребывающих а именно Субхути.",
 "an1.202:1.1": "… Достойных-даров а именно Субхути.",
 "an1.203:1.1": "… Лесных а именно Ревата из-акации-рощи.",
 "an1.204:1.1": "… Джхана-практикующих а именно Канкхаревата.",
 "an1.205:1.1": "… Решимость-проявивших а именно Сона Коливиса.",
 "an1.206:1.1": "… Благое-речь-имеющих а именно Сона Кутиканна.",
 "an1.207:1.1": "… Получающих а именно Сивали.",
 "an1.208:1.1": "… Верой-устремлённых а именно Ваккали”.",
 "an1.208:1.2": "Глава Вторая."
}
