{
 "an8.18:0.1": "Восходящие Наставления 8.18",
 "an8.18:0.2": "2. Большая Глава",
 "an8.18:0.3": "Вторая Сутта о связывании",
 "an8.18:1.1": "“Восемью, монахи, аспектами мужчина женщину связывает.",
 "an8.18:1.2": "Какими восемью?",
 "an8.18:1.3": "Плачем, монахи, мужчина женщину связывает;",
 "an8.18:1.4": "смехом, монахи, мужчина женщину связывает;",
 "an8.18:1.5": "говорением, монахи, мужчина женщину связывает;",
 "an8.18:1.6": "внешним видом, монахи, мужчина женщину связывает;",
 "an8.18:1.7": "лесным подарком, монахи, мужчина женщину связывает;",
 "an8.18:1.8": "запахом, монахи, мужчина женщину связывает;",
 "an8.18:1.9": "вкусом, монахи, мужчина женщину связывает;",
 "an8.18:1.10": "касанием, монахи, мужчина женщину связывает.",
 "an8.18:1.11": "Этими, монахи, восемью аспектами мужчина женщину связывает.",
 "an8.18:1.12": "Те, монахи, существа хорошо связаны, которые касанием связаны”.",
 "an8.18:1.13": "Восьмая."
}
