{
 "an8.75:0.1": "Восходящие Наставления 8.75",
 "an8.75:0.2": "8. Раздел Ямака",
 "an8.75:0.3": "Сутта Первое-совершенство",
 "an8.75:1.1": "“Эти восемь, монахи, достижений.",
 "an8.75:1.2": "Какие восемь?",
 "an8.75:1.3": "Достижение в начинании, достижение в сохранении, благое дружество, сбалансированная жизнь, достижение в вере, достижение в нравственности, достижение в щедрости, достижение в понимании—",
 "an8.75:1.4": "эти, монахи, восемь достижений.",
 "an8.75:2.1": "Начинающий в делах,",
 "an8.75:2.2": "старательный, умелый;",
 "an8.75:2.3": "Сбалансированно организует быт,",
 "an8.75:2.4": "накопленное охраняет.",
 "an8.75:3.1": "Верующий, нравственностью наделённый,",
 "an8.75:3.2": "щедрый, лишённый скупости;",
 "an8.75:3.3": "Постоянно путь очищает,",
 "an8.75:3.4": "благополучие в следующем.",
 "an8.75:4.1": "Так эти восемь явлений,",
 "an8.75:4.2": "верующего домохозяина-ищущего;",
 "an8.75:4.3": "Провозглашённые истинно-именным,",
 "an8.75:4.4": "в обоих случаях приносящие приятное.",
 "an8.75:5.1": "Для блага в этой жизни,",
 "an8.75:5.2": "и для приятного в следующем;",
 "an8.75:5.3": "Так у домохозяев",
 "an8.75:5.4": "щедрость заслугу увеличивает”.",
 "an8.75:5.5": "Пятая."
}
