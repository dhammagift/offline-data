{
 "an8.17:0.1": "Восходящие Наставления 8.17",
 "an8.17:0.2": "2. Большая Глава",
 "an8.17:0.3": "Первая Сутта о Связывании",
 "an8.17:1.1": "“Восемью, монахи, способами женщина мужчину связывает.",
 "an8.17:1.2": "Какими восемью?",
 "an8.17:1.3": "Плачем, монахи, женщина мужчину связывает;",
 "an8.17:1.4": "смехом, монахи, женщина мужчину связывает;",
 "an8.17:1.5": "говорением, монахи, женщина мужчину связывает;",
 "an8.17:1.6": "видом, монахи, женщина мужчину связывает;",
 "an8.17:1.7": "лесным сбором, монахи, женщина мужчину связывает;",
 "an8.17:1.8": "запахом, монахи, женщина мужчину связывает;",
 "an8.17:1.9": "вкусом, монахи, женщина мужчину связывает;",
 "an8.17:1.10": "касанием, монахи, женщина мужчину связывает.",
 "an8.17:1.11": "Этими, монахи, восемью способами женщина мужчину связывает.",
 "an8.17:1.12": "Те, монахи, существа хорошо связаны, которые касанием связаны”.",
 "an8.17:1.13": "Седьмая."
}
