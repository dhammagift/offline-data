{
 "an8.15:0.1": "Восходящие Наставления 8.15",
 "an8.15:0.2": "2. Большая Глава",
 "an8.15:0.3": "Сутта Пятна",
 "an8.15:1.1": "“Восемь этих, монахи, пятен.",
 "an8.15:1.2": "Какие восемь?",
 "an8.15:1.3": "Без-повторения-пятно, монахи, гимнов;",
 "an8.15:1.4": "без-подъёма-пятно, монахи, домов;",
 "an8.15:1.5": "пятно, монахи, красоты — лень;",
 "an8.15:1.6": "беспечность, монахи, охраняющего — пятно;",
 "an8.15:1.7": "пятно, монахи, женщины — плохое-поведение;",
 "an8.15:1.8": "скупость, монахи, дающего — пятно;",
 "an8.15:1.9": "пятна, монахи, плохие неблаготворные явления в этом мире и в следующем;",
 "an8.15:1.10": "чем те, монахи, пятна, пятно-более-пятна — невидение — высшее пятно.",
 "an8.15:1.11": "Эти, монахи, восемь пятен.",
 "an8.15:2.1": "Без-повторения-пятно — гимнов,",
 "an8.15:2.2": "без-подъёма-пятно — домов;",
 "an8.15:2.3": "Пятно красоты — лень,",
 "an8.15:2.4": "беспечность — охраняющего пятно.",
 "an8.15:3.1": "Пятно женщины — плохое-поведение,",
 "an8.15:3.2": "скупость — дающего пятно;",
 "an8.15:3.3": "Пятна ведь плохие явления,",
 "an8.15:3.4": "в этом мире и в следующем;",
 "an8.15:3.5": "Чем те пятна, пятно-более-пятна,",
 "an8.15:3.6": "невидение — высшее пятно”.",
 "an8.15:3.7": "Пятая."
}
