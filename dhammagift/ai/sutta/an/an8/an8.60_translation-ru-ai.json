{
 "an8.60:0.1": "Восходящие Наставления 8.60",
 "an8.60:0.2": "6. Раздел Готами",
 "an8.60:0.3": "Вторая Сутта о Личностях",
 "an8.60:1.1": "«Эти восемь, монахи, личности достойны… непревзойденное поле блага миру.",
 "an8.60:1.2": "Какие восемь?",
 "an8.60:1.3": "Услышавший, практикующий реализацию плода услышавшего… арахант, практикующий для арахантства.",
 "an8.60:1.4": "Эти, монахи, восемь личностей достойны подношений … непревзойденное поле блага для мира.",
 "an8.60:2.1": "Четверо практикующих,",
 "an8.60:2.2": "четверо в плоде стоящих;",
 "an8.60:2.3": "Эта Сангха высочайшая,",
 "an8.60:2.4": "существ восемь личностей.",
 "an8.60:3.1": "У жертвующих людей,",
 "an8.60:3.2": "заслуги-ожидающих дышащих;",
 "an8.60:3.3": "Совершающих приносящую-опору заслугу,",
 "an8.60:3.4": "здесь данное великоплодно».",
 "an8.60:3.5": "Десятая.",
 "an8.60:3.6": "Глава Готами Первая.",
 "an8.60:4.0": "Оглавление",
 "an8.60:4.1": "Готами наставление кратко,",
 "an8.60:4.2": "Диргхаджану и Удджая;",
 "an8.60:4.3": "Тревоги две достойных и",
 "an8.60:4.4": "две и восемь личностей."
}
