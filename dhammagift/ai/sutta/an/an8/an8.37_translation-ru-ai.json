{
 "an8.37:0.1": "Восходящие Наставления 8.37",
 "an8.37:0.2": "4. Раздел даяния",
 "an8.37:0.3": "Сутта Даяния Чистого Человека",
 "an8.37:1.1": "“Вот эти восемь, монахи, даяний чистого человека.",
 "an8.37:1.2": "Какие восемь?",
 "an8.37:1.3": "Чистое даёт, превосходное даёт, своевременно даёт, уместное даёт, разборчиво даёт, постоянно даёт, давая ум-состояние проясняет, дав удовлетворённым является.",
 "an8.37:1.4": "Эти вот, монахи, восемь даяний чистого человека.",
 "an8.37:2.1": "Чистое превосходное своевременно,",
 "an8.37:2.2": "уместное питьё-еду;",
 "an8.37:2.3": "Постоянно даёт даяние,",
 "an8.37:2.4": "на благих-полях у ведущих-чистую-жизнь.",
 "an8.37:3.1": "И не сожалеющий,",
 "an8.37:3.2": "пожертвовав подношение большое;",
 "an8.37:3.3": "Так данные даяния,",
 "an8.37:3.4": "восхваляют прозревающие.",
 "an8.37:4.1": "Так совершив жертвоприношение, мудрый,",
 "an8.37:4.2": "верующий, освобождённым разумом;",
 "an8.37:4.3": "Без-враждебности приятный мир,",
 "an8.37:4.4": "мудрец перерождается”.",
 "an8.37:4.5": "Седьмая."
}
