{
 "an8.31:0.1": "Восходящие Наставления 8.31",
 "an8.31:0.2": "4. Раздел даяния",
 "an8.31:0.3": "Первая Сутта Даяния",
 "an8.31:1.1": "“Вот восемь, монахи, даяний.",
 "an8.31:1.2": "Какие восемь?",
 "an8.31:1.3": "С вызовом даяние даёт,",
 "an8.31:1.4": "из страха даяние даёт,",
 "an8.31:1.5": "‘дал мне’ — так даяние даёт,",
 "an8.31:1.6": "‘даст мне’ — так даяние даёт,",
 "an8.31:1.7": "‘хорошо даяние’ — так даяние даёт,",
 "an8.31:1.8": "‘я готовлю, эти не готовят; не достоин я, готовящий, неготовящим даяния не давать’ — так даяние даёт,",
 "an8.31:1.9": "‘это мне даяние дающему благая молва-слава восходит’ — так даяние даёт,",
 "an8.31:1.10": "для ума-украшения, ума-снаряжения-цели даяние даёт.",
 "an8.31:1.11": "Вот эти, монахи, восемь даяний”.",
 "an8.31:1.12": "Первая."
}
