{
 "an2.151:0.1": "Восходящие Наставления 2",
 "an2.151:0.2": "14. Раздел гостеприимства",
 "an2.151:1.0": "151",
 "an2.151:1.1": "“Два этих, монахи, гостеприимства.",
 "an2.151:1.2": "Какие две?",
 "an2.151:1.3": "Гостеприимство материальное и гостеприимство Дхаммой.",
 "an2.151:1.4": "Вот эти, монахи, два гостеприимства.",
 "an2.151:1.5": "Это наивысшее, монахи, из этих двух гостеприимств, а именно гостеприимство Дхаммой”.",
 "an2.152:1.0": "152",
 "an2.152:1.1": "“Два этих, монахи, приветствия.",
 "an2.152:1.2": "Какие две?",
 "an2.152:1.3": "Приветствие материальное и приветствие Дхаммой.",
 "an2.152:1.4": "Вот эти, монахи, два приветствия.",
 "an2.152:1.5": "Это наивысшее, монахи, из этих двух приветствий, а именно приветствие Дхаммой”.",
 "an2.153:1.0": "153",
 "an2.153:1.1": "“Два этих, монахи, поиска.",
 "an2.153:1.2": "Какие два?",
 "an2.153:1.3": "Поиск материального и поиск Дхаммы.",
 "an2.153:1.4": "Вот эти, монахи, два поиска.",
 "an2.153:1.5": "Это наивысшее, монахи, из этих двух поисков, а именно поиск Дхаммы”.",
 "an2.154:1.0": "154",
 "an2.154:1.1": "“Два этих, монахи, искания.",
 "an2.154:1.2": "Какие два?",
 "an2.154:1.3": "Искание материального и искание Дхаммы.",
 "an2.154:1.4": "Вот эти, монахи, два искания.",
 "an2.154:1.5": "Это наивысшее, монахи, из этих двух исканий, а именно искание Дхаммы”.",
 "an2.155:1.0": "155",
 "an2.155:1.1": "“Два этих, монахи, разыскания.",
 "an2.155:1.2": "Какие два?",
 "an2.155:1.3": "Разыскание материального и разыскание Дхаммы.",
 "an2.155:1.4": "Вот эти, монахи, два разыскания.",
 "an2.155:1.5": "Это наивысшее, монахи, из этих двух поисков, а именно—поиск Дхаммы”.",
 "an2.156:1.0": "156",
 "an2.156:1.1": "“Два этих, монахи, почитания.",
 "an2.156:1.2": "Какие два?",
 "an2.156:1.3": "Материальное почитание и почитание Дхаммы.",
 "an2.156:1.4": "Вот эти, монахи, два почитания.",
 "an2.156:1.5": "Это наивысшее, монахи, из этих двух почитаний, а именно—почитание Дхаммы”.",
 "an2.157:1.0": "157",
 "an2.157:1.1": "“Два этих, монахи, гостеприимства.",
 "an2.157:1.2": "Какие две?",
 "an2.157:1.3": "Материальное гостеприимство и гостеприимство Дхаммы.",
 "an2.157:1.4": "Вот эти, монахи, два гостеприимства.",
 "an2.157:1.5": "Это наивысшее, монахи, из этих двух гостеприимств, а именно—гостеприимство Дхаммы”.",
 "an2.158:1.0": "158",
 "an2.158:1.1": "“Два этих, монахи, свершения.",
 "an2.158:1.2": "Какие два?",
 "an2.158:1.3": "Материальное свершение и свершение Дхаммы.",
 "an2.158:1.4": "Вот эти, монахи, два свершения.",
 "an2.158:1.5": "Это наивысшее, монахи, из этих двух свершений, а именно—свершение Дхаммы”.",
 "an2.159:1.0": "159",
 "an2.159:1.1": "“Два этих, монахи, возрастания.",
 "an2.159:1.2": "Какие два?",
 "an2.159:1.3": "Материальное возрастание и возрастание Дхаммы.",
 "an2.159:1.4": "Вот эти, монахи, два возрастания.",
 "an2.159:1.5": "Это наивысшее, монахи, из этих двух возрастаний, а именно—возрастание Дхаммы”.",
 "an2.160:1.0": "160",
 "an2.160:1.1": "“Два этих, монахи, сокровища.",
 "an2.160:1.2": "Какие две?",
 "an2.160:1.3": "Материальное сокровище и сокровище Дхаммы.",
 "an2.160:1.4": "Вот эти, монахи, два сокровища.",
 "an2.160:1.5": "Это высшее, монахи, из этих двух драгоценностей, это — драгоценность явления”.",
 "an2.161:1.0": "161",
 "an2.161:1.1": "“Два накопления, монахи.",
 "an2.161:1.2": "Какие две?",
 "an2.161:1.3": "Накопление материального и накопление явления.",
 "an2.161:1.4": "Вот эти, монахи, два накопления.",
 "an2.161:1.5": "Это высшее, монахи, из этих двух накоплений, это — накопление явления”.",
 "an2.162:1.0": "162",
 "an2.162:1.1": "“Две полноты, монахи.",
 "an2.162:1.2": "Какие две?",
 "an2.162:1.3": "Полнота материального и полнота явления.",
 "an2.162:1.4": "Вот эти, монахи, две полноты.",
 "an2.162:1.5": "Это высшее, монахи, из этих двух полнот, это — полнота явления”.",
 "an2.162:1.6": "Глава Сантхара Четвёртая."
}
