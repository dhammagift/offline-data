{
 "an9.31:0.1": "Восходящие Наставления 9.31",
 "an9.31:0.2": "Раздел Саттаваса",
 "an9.31:0.3": "Сутта Последовательных Устранений",
 "an9.31:1.1": "“Эти девять, монахи, последовательных устранений.",
 "an9.31:1.2": "Какие девять?",
 "an9.31:1.3": "Первую джхану достигшего желание-сознавание устранено;",
 "an9.31:1.4": "вторую джхану достигшего рассуждение-выслеживание устранены;",
 "an9.31:1.5": "третью джхану достигшего озарённость-упоение устранена;",
 "an9.31:1.6": "четвёртую джхану достигшего выдохи-вдохи устранены;",
 "an9.31:1.7": "пространства-бескрайнего-область достигшего материя-сознавание устранено;",
 "an9.31:1.8": "распознавания-бескрайнего-область достигшего пространства-бескрайнего-область-сознавание устранено;",
 "an9.31:1.9": "без-чего-либо-область достигшего распознавания-бескрайнего-область-сознавание устранено;",
 "an9.31:1.10": "ни-сознавания-ни-бессознательности-область достигшего без-чего-либо-область-сознавание устранено;",
 "an9.31:1.11": "сознания-почувствованного-устранение достигшего сознавание и чувство устранены бывают.",
 "an9.31:1.12": "Эти, монахи, девять последовательных устранений”.",
 "an9.31:1.13": "Одиннадцатая.",
 "an9.31:1.14": "Глава Саттаваса Третья.",
 "an9.31:2.0": "Оглавление",
 "an9.31:2.1": "Стояния, дикий конь, цепляние,",
 "an9.31:2.2": "Семь пониманий, сила-юность;",
 "an9.31:2.3": "Две вражды, два негодования,",
 "an9.31:2.4": "Последовательным устранением и."
}
