{
 "an4.120:0.1": "Восходящие Наставления 4.120",
 "an4.120:0.2": "12. Глава Кеси",
 "an4.120:0.3": "Сутта Вторая-Тревога",
 "an4.120:1.1": "“Четыре эти, монахи, тревоги.",
 "an4.120:1.2": "Какие четыре?",
 "an4.120:1.3": "Тревога-огонь, тревога-вода, тревога-царь, тревога-вор—",
 "an4.120:1.4": "Вот эти, монахи, четыре тревоги”.",
 "an4.120:1.5": "Десятая.",
 "an4.120:1.6": "Глава Кеси Вторая.",
 "an4.120:2.0": "Оглавление",
 "an4.120:2.1": "Кеси, быстрота, и стрекало,",
 "an4.120:2.2": "Слон, с местом пятая;",
 "an4.120:2.3": "Не-беспечность и охрана,",
 "an4.120:2.4": "Волнующее и две тревоги."
}
