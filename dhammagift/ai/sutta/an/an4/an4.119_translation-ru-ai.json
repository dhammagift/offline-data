{
 "an4.119:0.1": "Восходящие Наставления 4.119",
 "an4.119:0.2": "12. Глава Кеси",
 "an4.119:0.3": "Первая Сутта о Тревогах",
 "an4.119:1.1": "“Четыре эти, монахи, тревоги.",
 "an4.119:1.2": "Какие четыре?",
 "an4.119:1.3": "Тревога рождения, тревога старения, тревога болезни, тревога умирания—",
 "an4.119:1.4": "Вот эти, монахи, четыре тревоги”.",
 "an4.119:1.5": "Девятая."
}
