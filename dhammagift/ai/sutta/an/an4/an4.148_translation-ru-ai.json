{
 "an4.148:0.1": "Восходящие Наставления 4.148",
 "an4.148:0.2": "15. Раздел Сияния",
 "an4.148:0.3": "Сутта Дурного Поведения",
 "an4.148:1.1": "“Четыре эти, монахи, рече-проступка.",
 "an4.148:1.2": "Какие четыре?",
 "an4.148:1.3": "Ложное утверждение, рознящая речь, жёсткая речь, пустословие—",
 "an4.148:1.4": "Вот эти, монахи, четыре рече-проступка”.",
 "an4.148:1.5": "Восьмая."
