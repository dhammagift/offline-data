{
 "an4.161:0.1": "Восходящие Наставления 4.161",
 "an4.161:0.2": "17. Раздел практики",
 "an4.161:0.3": "Сутта вкратце",
 "an4.161:1.1": "“Четыре эти, монахи, практики.",
 "an4.161:1.2": "Какие четыре?",
 "an4.161:1.3": "Болезненная практика с медленным постижением,",
 "an4.161:1.4": "болезненная практика с быстрым постижением,",
 "an4.161:1.5": "приятная практика с медленным постижением,",
 "an4.161:1.6": "приятная практика с быстрым постижением—",
 "an4.161:1.7": "эти вот, монахи, четыре практики”.",
 "an4.161:1.8": "Первая."
}
