{
 "an4.17:0.1": "Восходящие Наставления 4.17",
 "an4.17:0.2": "Раздел Странствия",
 "an4.17:0.3": "Первая Сутта о не-должном-поведении",
 "an4.17:1.1": "“Четыре эти, монахи, не-должных-поведения.",
 "an4.17:1.2": "Какие четыре?",
 "an4.17:1.3": "По импульсу-поведению идёт, по злобе-поведению идёт, по заблуждению-поведению идёт, по страху-поведению идёт—",
 "an4.17:1.4": "Вот эти, монахи, четыре не-должных-поведения.",
 "an4.17:2.1": "Импульсом, злобой, тревогой, заблуждением,",
 "an4.17:2.2": "кто явление превосходит;",
 "an4.17:2.3": "Умаляется его репутация,",
 "an4.17:2.4": "как луна в тёмной половине”.",
 "an4.17:2.5": "Седьмая."
}
