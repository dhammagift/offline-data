{
 "an4.23:0.1": "Восходящие Наставления 4.23",
 "an4.23:0.2": "Раздел Урувелы",
 "an4.23:0.3": "Сутта Свет-мир",
 "an4.23:1.1": "“Свет, монахи, Татхагатой постигнут.",
 "an4.23:1.2": "От света Татхагата отсоединён.",
 "an4.23:1.3": "Света-скапливание, монахи, Татхагатой постигнуто.",
 "an4.23:1.4": "Света-скапливание Татхагатой покинуто.",
 "an4.23:1.5": "Света-устранение, монахи, Татхагатой постигнуто.",
 "an4.23:1.6": "Света-устранение Татхагатой засвидетельствовано.",
 "an4.23:1.7": "К света-устранению-ведущая практика, монахи, Татхагатой постигнута.",
 "an4.23:1.8": "К света-устранению-ведущая практика Татхагатой развита.",
 "an4.23:2.1": "Что, монахи, в мире с божествами, с Марой, с Брахмой, с шраманами-брахманами, с поколением королей-божеств и людей увидено, услышано, ощущено, распознано, достигнуто, обыскано, обдумано умом — всё то Татхагатой постигнуто.",
 "an4.23:2.2": "Поэтому ‘Татхагата’ зовется.",
 "an4.23:3.1": "И какую, монахи, ночь Татхагата в непревзойденное правильное пробуждение пробуждается и какую ночь в без-остаточной ниббана-дхату угасает, что в этом промежутке говорит, излагает, разъясняет — всё то именно так и есть, не иначе.",
 "an4.23:3.2": "Поэтому ‘Татхагата’ зовется.",
 "an4.23:4.1": "Как-говорящий, монахи, Татхагата так-делающий, как-делающий так-говорящий.",
 "an4.23:4.2": "Так как-говорящий так-делающий, как-делающий так-говорящий.",
 "an4.23:4.3": "Поэтому ‘Татхагата’ зовется.",
 "an4.23:5.1": "В мире с божествами, монахи, с Марой, с Брахмой, с шраманами-брахманами, с поколением королей-божеств и людей Татхагата — превосходящий, непревзойденный, видящий, властвующий.",
 "an4.23:5.2": "Поэтому ‘Татхагата’ зовется.",
 "an4.23:6.1": "Весь свет опознав,",
 "an4.23:6.2": "весь свет как-есть;",
 "an4.23:6.3": "Весь свет отсоединён,",
 "an4.23:6.4": "ко всему свету не-приближающийся.",
 "an4.23:7.1": "Он есть — всё-превосходящий знаток,",
 "an4.23:7.2": "всех-узлов-освободитель;",
 "an4.23:7.3": "Коснулся его высший покой,",
 "an4.23:7.4": "Ниббане, лишённой страха.",
 "an4.23:8.1": "Этот — с-истекшим-истечениями пробуждённый,”",
 "an4.23:8.2": "без-тягости, с-отрезанным-сомнением;",
 "an4.23:8.3": "Все-активности-исчерпания достигший,",
 "an4.23:8.4": "высвобожденный при удержания-исчерпании.",
 "an4.23:9.1": "Этот вот Благословенный Будда,",
 "an4.23:9.2": "этот лев непревзойдённый;",
 "an4.23:9.3": "Мира с божествами,",
 "an4.23:9.4": "колесо-Брахмы запустил.",
 "an4.23:10.1": "Так дэвы и люди,",
 "an4.23:10.2": "которые Будду как прибежище пошли;",
 "an4.23:10.3": "собравшись, его почитают-славят,",
 "an4.23:10.4": "великого, бесстрашного.",
 "an4.23:11.1": "Дрессированный дрессирующих лучший,",
 "an4.23:11.2": "успокоенный успокаивающих провидец;",
 "an4.23:11.3": "Высвобожденный высвобождающих главный,",
 "an4.23:11.4": "пересёкший переправляющих превосходный.",
 "an4.23:12.1": "Так его почитают-славят,",
 "an4.23:12.2": "великого, бесстрашного;",
 "an4.23:12.3": "В мире с дэвами",
 "an4.23:12.4": "нет мне равного-индивидуума”.",
 "an4.23:12.5": "Третья."
}
