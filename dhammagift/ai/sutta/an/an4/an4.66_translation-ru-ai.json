{
 "an4.66:0.1": "Восходящие Наставления 4.66",
 "an4.66:0.2": "Раздел Паттакамма",
 "an4.66:0.3": "Сутта Со-страстью",
 "an4.66:1.1": "“Четыре эти, монахи, индивидуума есть наблюдающиеся на свете.",
 "an4.66:1.2": "Какие четыре?",
 "an4.66:1.3": "Со-страстью, со-злобой, со-замутнённостью, с самомнением—",
 "an4.66:1.4": "Эти вот, монахи, четыре индивидуума есть наблюдающиеся на свете.",
 "an4.66:2.1": "Очарованные очаровывающими-вызывающими-страсть,",
 "an4.66:2.2": "Приятно-образное-радующиеся;",
 "an4.66:2.3": "Замутнённостью покрытые существа,",
 "an4.66:2.4": "Связанные увеличивают привязку.",
 "an4.66:3.1": "Из-страсти-рождённое и из-злобы-рождённое,",
 "an4.66:3.2": "из-замутнённости-рождённое и у не-видящих;",
 "an4.66:3.3": "Совершающие неблаготворную активность,",
 "an4.66:3.4": "с-сожалением, боль-несущую.",
 "an4.66:4.1": "Невидением окутанные люди,",
 "an4.66:4.2": "слепые, безглазые;",
 "an4.66:4.3": "Как явления таковы будучи,",
 "an4.66:4.4": "не так-вот-этими считают”.",
 "an4.66:4.5": "Шестая."
}
