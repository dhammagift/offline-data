{
 "an4.42:0.1": "Восходящие Наставления 4.42",
 "an4.42:0.2": "5. Рохитассавагга",
 "an4.42:0.3": "Сутта Разъяснения Вопросов",
 "an4.42:1.1": "“Четыре эти, монахи, разъяснения вопросов.",
 "an4.42:1.2": "Какие четыре?",
 "an4.42:1.3": "Есть, монахи, вопрос, разъясняемый однозначно;",
 "an4.42:1.4": "есть, монахи, вопрос, разъясняемый разделением;",
 "an4.42:1.5": "есть, монахи, вопрос, разъясняемый встречным вопросом;",
 "an4.42:1.6": "есть, монахи, вопрос, который следует отставить.",
 "an4.42:1.7": "Вот эти, монахи, четыре разъяснения вопросов.",
 "an4.42:2.1": "Однозначное высказывание — одно,",
 "an4.42:2.2": "разделительное высказывание — другое;",
 "an4.42:2.3": "Третье — встречным вопросом,",
 "an4.42:2.4": "четвёртое же следует отставить.",
 "an4.42:3.1": "И кто в них, там и тут,",
 "an4.42:3.2": "знает сообразно Дхамме;",
 "an4.42:3.3": "Умелый в четырёх вопросах,",
 "an4.42:3.4": "называют такого монаха.",
 "an4.42:4.1": "Трудно приблизиться, трудно одолеть,",
 "an4.42:4.2": "глубок, трудно сокрушим;",
 "an4.42:4.3": "И в благе и в не-благе,",
 "an4.42:4.4": "в обоих он сведущ.",
 "an4.42:5.1": "Не-благо он избегает,",
 "an4.42:5.2": "благо приобретает мудрец.",
 "an4.42:5.3": "пользу постигший знаток,",
 "an4.42:5.4": "об этом 'мудрец' говорится”.",
 "an4.42:5.5": "Вторая."
}
