{
 "an4.18:0.1": "Восходящие Наставления 4.18",
 "an4.18:0.2": "2. Глава Странствия",
 "an4.18:0.3": "Вторая сутта о не-отклонениях",
 "an4.18:1.1": "“Четыре эти, монахи, не-отклонения.",
 "an4.18:1.2": "Какие четыре?",
 "an4.18:1.3": "По импульсу-отклонения не идёт, по враждебности-отклонения не идёт, по заблуждению-отклонения не идёт, по тревоге-отклонения не идёт—",
 "an4.18:1.4": "Вот эти, монахи, четыре не-отклонения.",
 "an4.18:2.1": "Импульсом, злобой, тревогой, заблуждением,",
 "an4.18:2.2": "кто явление не превосходит;",
 "an4.18:2.3": "Наполняется его репутация,",
 "an4.18:2.4": "как в светлой половине луна”.",
 "an4.18:2.5": "Восьмая."
}
