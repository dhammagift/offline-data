{
 "an4.32:0.1": "Восходящие Наставления 4.32",
 "an4.32:0.2": "Раздел Колеса",
 "an4.32:0.3": "Сутта Объединения",
 "an4.32:1.1": "“Четыре эти, монахи, основы объединения.",
 "an4.32:1.2": "Какие четыре?",
 "an4.32:1.3": "Даяние, приятная речь, благо-смысл-цель-деяние, равностность—",
 "an4.32:1.4": "Вот эти, монахи, четыре основы объединения.",
 "an4.32:2.1": "Даяние и приветливое слово,",
 "an4.32:2.2": "и благо-деяние, какое есть здесь;",
 "an4.32:2.3": "И равность в явлениях,",
 "an4.32:2.4": "там и тут, как подобает;",
 "an4.32:2.5": "Эти, поистине, объединения в мире,",
 "an4.32:2.6": "как ось колесницы у едущего.",
 "an4.32:3.1": "И если бы этих объединений не было,",
 "an4.32:3.2": "то ни мать из-за сына,",
 "an4.32:3.3": "ни отец из-за сына",
 "an4.32:3.4": "не получали бы уважения и почитания.",
 "an4.32:4.1": "Поскольку же эти объединения",
 "an4.32:4.2": "мудрецы взирают;",
 "an4.32:4.3": "поэтому величия достигают",
 "an4.32:4.4": "и достойны похвалы они”.",
 "an4.32:4.5": "Вторая."
}
