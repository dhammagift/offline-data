{
 "an4.47:0.1": "Восходящие Наставления 4.47",
 "an4.47:0.2": "5. Рохитассавагга",
 "an4.47:0.3": "Сутта Сувидура",
 "an4.47:1.1": "“Четыре эти, монахи, далеко-отдалённые.",
 "an4.47:1.2": "Какие четыре?",
 "an4.47:1.3": "Небо и, монахи, земля;",
 "an4.47:1.4": "это первое далеко-отдалённое.",
 "an4.47:1.5": "И этот, монахи, берег океана и тот;",
 "an4.47:1.6": "это второе далеко-отдалённое.",
 "an4.47:1.7": "И откуда, монахи, солнце восходит и где заходит;",
 "an4.47:1.8": "это третье далеко-отдалённое.",
 "an4.47:1.9": "И чистых, монахи, действительность и нечистых действительность;",
 "an4.47:1.10": "это четвёртое далеко-отдалённое.",
 "an4.47:1.11": "Вот эти, монахи, четыре далеко-отдалённые.",
 "an4.47:2.1": "Небо далеко и земля далека,",
 "an4.47:2.2": "Тот берег океана, говорят, далёк;",
 "an4.47:2.3": "И откуда солнце восходит,",
 "an4.47:2.4": "Светоносный, и где заходит;",
 "an4.47:2.5": "Но ещё более далёким, говорят,",
 "an4.47:2.6": "Чистых действительность и нечистых действительность.",
 "an4.47:3.1": "Неизменным бывает чистых собрание,",
 "an4.47:3.2": "Сколько бы ни длилось, таким же и бывает;",
 "an4.47:3.3": "Быстро ведь уходит нечистых собрание,",
 "an4.47:3.4": "Потому чистых действительность от нечистых далека”.",
 "an4.47:3.5": "Седьмая."
}
