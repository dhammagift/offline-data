{
 "an4.253:0.1": "Восходящие Наставления 4.253",
 "an4.253:0.2": "25. Раздел тревоги-проступка",
 "an4.253:0.3": "Сутта Четвёртая Речь",
 "an4.253:1.1": "“Четыре, монахи, благородных речения.",
 "an4.253:1.2": "Какие четыре?",
 "an4.253:1.3": "В видимом — говорение-о-видимом, в слышимом — говорение-о-слышимом, в ощущаемом — говорение-об-ощущаемом, в распознаваемом — говорение-о-распознаваемом—",
 "an4.253:1.4": "Эти, монахи, четыре благородных речения”.",
 "an4.253:1.5": "Одиннадцатая.",
 "an4.253:1.6": "Глава Нарушение-Тревога Пятая.",
 "an4.253:2.0": "Оглавление",
 "an4.253:2.1": "Разрыв, нарушение и тренировка,",
 "an4.253:2.2": "лучший, достойный ступы;",
 "an4.253:2.3": "Рост понимания, много полезного,",
 "an4.253:2.4": "речи четыре стоят.",
 "an4.253:2.5": "Пятая Пятидесятка Завершена."
}
