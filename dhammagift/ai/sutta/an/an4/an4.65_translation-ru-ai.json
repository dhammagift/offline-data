{
 "an4.65:0.1": "Восходящие Наставления 4.65",
 "an4.65:0.2": "Раздел Паттакамма",
 "an4.65:0.3": "Сутта Объектов",
 "an4.65:1.1": "“Четыре эти, монахи, индивидуума есть наблюдающиеся на свете.",
 "an4.65:1.2": "Какие четыре?",
 "an4.65:1.3": "Образ-мерило образ-доверяющий, звук-мерило звук-доверяющий, грубость-мерило грубость-доверяющий, явление-мерило явление-доверяющий—",
 "an4.65:1.4": "Эти вот, монахи, четыре индивидуума есть наблюдающиеся на свете.",
 "an4.65:2.1": "А которые образы измерили,",
 "an4.65:2.2": "а которые за звуком пошли;",
 "an4.65:2.3": "Импульс-страсти-властью-охваченные,",
 "an4.65:2.4": "не понимают те люди.",
 "an4.65:3.1": "Внутри и не знает,",
 "an4.65:3.2": "снаружи и не видит;",
 "an4.65:3.3": "Сплошь-закрытый глупец,",
 "an4.65:3.4": "он ведь звуком уносится.",
 "an4.65:4.1": "Внутри и не знает,",
 "an4.65:4.2": "снаружи и видит;",
 "an4.65:4.3": "Снаружи плод-видящий,",
 "an4.65:4.4": "и тот звуком уносится.",
 "an4.65:5.1": "Внутри и понимает,",
 "an4.65:5.2": "снаружи и видит;",
 "an4.65:5.3": "Без-преград-видящий,",
 "an4.65:5.4": "не тот звуком уносится”.",
 "an4.65:5.5": "Пятая."
}
