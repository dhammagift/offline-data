{
 "an4.74:0.1": "Восходящие Наставления 4.74",
 "an4.74:0.2": "8. Раздел безошибочного",
 "an4.74:0.3": "Сутта Первая о Вершинах",
 "an4.74:1.1": "“Четыре эти, монахи, вершины.",
 "an4.74:1.2": "Какие четыре?",
 "an4.74:1.3": "Вершина нравственности, вершина самадхи, вершина понимания, вершина высвобождения—",
 "an4.74:1.4": "Вот эти, монахи, четыре вершины”.",
 "an4.74:1.5": "Четвёртая."
