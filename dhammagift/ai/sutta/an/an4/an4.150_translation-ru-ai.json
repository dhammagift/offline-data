{
 "an4.150:0.1": "Восходящие Наставления 4.150",
 "an4.150:0.2": "15. Раздел Сияния",
 "an4.150:0.3": "Сутта Сердцевины",
 "an4.150:1.1": "“Четыре, монахи, сути.",
 "an4.150:1.2": "Какие четыре?",
 "an4.150:1.3": "Суть нравственности, суть самадхи, суть понимания, суть высвобождения—",
 "an4.150:1.4": "Эти, монахи, четыре сути”.",
 "an4.150:1.5": "Десятая.",
 "an4.150:1.6": "Глава Сияния Пятая.",
 "an4.150:2.0": "Оглавление",
 "an4.150:2.1": "Сияние, свет, освещение,",
 "an4.150:2.2": "сияние и свечение;",
 "an4.150:2.3": "Два времени, два поведения,",
 "an4.150:2.4": "являются сутью те десять.",
 "an4.150:2.5": "Третья Пятидесятка Завершена."
}
