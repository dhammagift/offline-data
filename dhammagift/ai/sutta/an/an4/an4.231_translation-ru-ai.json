{
 "an4.231:0.1": "Восходящие Наставления 4.231",
 "an4.231:0.2": "23. Глава дурного поведения",
 "an4.231:0.3": "Сутта Поэта",
 "an4.231:1.1": "“Четыре, монахи, поэта.",
 "an4.231:1.2": "Какие четыре?",
 "an4.231:1.3": "Мыслящий поэт, слышащий поэт, смысловой поэт, вдохновенный поэт—",
 "an4.231:1.4": "Эти, монахи, четыре поэта”.",
 "an4.231:1.5": "Одиннадцатая.",
 "an4.231:1.6": "Глава Дуччарита Третья.",
 "an4.231:2.0": "Оглавление",
 "an4.231:2.1": "Дурное поведение, взгляд и неблагодарный,",
 "an4.231:2.2": "Жизни-уменьшение и два пути;",
 "an4.231:2.3": "Два пути речи сказаны,",
 "an4.231:2.4": "Бесстыдство с глупым поэтом."
}
