{
 "an3.183-352:0.1": "Восходящие Наставления 3",
 "an3.183-352:0.2": "18. Сокращение Страсть",
 "an3.183-352:0.3": "~",
 "an3.183-352:1.1": "Для опознания страсти, монахи, три явления должны быть развиты.",
 "an3.183-352:1.2": "Какие три?",
 "an3.183-352:1.3": "Пустотное самадхи, без-знаковое самадхи, без-направленное самадхи —",
 "an3.183-352:1.4": "для опознания страсти, монахи, эти три явления должны быть развиты. (…)",
 "an3.183-352:2.1": "Для полного понимания страсти, монахи…",
 "an3.183-352:2.2": "исчерпывания…",
 "an3.183-352:2.3": "покидания…",
 "an3.183-352:2.4": "исчерпания…",
 "an3.183-352:2.5": "исчезновения…",
 "an3.183-352:2.6": "бесстрастия…",
 "an3.183-352:2.7": "устранения…",
 "an3.183-352:2.8": "отказа…",
 "an3.183-352:2.9": "отдаления эти три явления должны быть развиты.",
 "an3.183-352:3.1": "Вредности-злобы…",
 "an3.183-352:3.2": "заблуждения…",
 "an3.183-352:3.3": "ворчания…",
 "an3.183-352:3.4": "жестокости…",
 "an3.183-352:3.5": "умаления…",
 "an3.183-352:3.6": "завистливого соперничества…",
 "an3.183-352:3.7": "ревности…",
 "an3.183-352:3.8": "жадности…",
 "an3.183-352:3.9": "обмана…",
 "an3.183-352:3.10": "хитрости…",
 "an3.183-352:3.11": "упрямства…",
 "an3.183-352:3.12": "агрессии…",
 "an3.183-352:3.13": "самомнения…",
 "an3.183-352:3.14": "завышенной самооценки…",
 "an3.183-352:3.15": "опьянения…",
 "an3.183-352:3.16": "беспечности…",
 "an3.183-352:3.17": "познания…",
 "an3.183-352:3.18": "полного понимания…",
 "an3.183-352:3.19": "исчерпывания…",
 "an3.183-352:3.20": "покидания…",
 "an3.183-352:3.21": "исчерпания…",
 "an3.183-352:3.22": "исчезновения…",
 "an3.183-352:3.23": "бесстрастия…",
 "an3.183-352:3.24": "устранения…",
 "an3.183-352:3.25": "отказа…",
 "an3.183-352:3.26": "отдаления эти три явления должны быть развиты.",
 "an3.183-352:4.1": "Это сказал Благословенный.",
 "an3.183-352:4.2": "Довольные те монахи Благословенного речи обрадовались.",
 "an3.183-352:4.3": "Сокращение Страсть Закончено.",
 "an3.183-352:5.0": "Оглавление",
 "an3.183-352:5.1": "Страсть и вредность-злобу и замутненность-заблуждение,",
 "an3.183-352:5.2": "гнев-негодование-пятый;",
 "an3.183-352:5.3": "Пренебрежение-высокомерие-зависть и,",
 "an3.183-352:5.4": "скупость-обман-хитрость.",
 "an3.183-352:6.1": "Упрямство-агрессию-самомнение и,",
 "an3.183-352:6.2": "завышенную самооценку-опьянение и;",
 "an3.183-352:6.3": "Беспечности семнадцать сказано,",
 "an3.183-352:6.4": "страсти-серии-опирающиеся.",
 "an3.183-352:7.1": "Эти сравнением-связанные,",
 "an3.183-352:7.2": "достижением познания;",
 "an3.183-352:7.3": "Полным пониманием исчерпания,",
 "an3.183-352:7.4": "покиданием-исчерпанием-уходом;",
 "an3.183-352:7.5": "Бесстрастие-устранение-оставление,",
 "an3.183-352:7.6": "отдаления эти десять.",
 "an3.183-352:8.1": "Пустотное, без-знаковое и,",
 "an3.183-352:8.2": "без-направленное — три;",
 "an3.183-352:8.3": "Самадхи-коренные повторения—",
 "an3.183-352:8.4": "даже в остатках установлены.",
 "an3.183-352:8.5": "Третья Пятидесятка Завершена.",
 "an3.183-352:8.6": "Текст Трёхчастного Собрания завершён."
}
