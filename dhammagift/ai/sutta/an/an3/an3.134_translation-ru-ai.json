{
 "an3.134:0.1": "Восходящие Наставления 3.134",
 "an3.134:0.2": "14. Глава Воинов-наёмников",
 "an3.134:0.3": "Сутта о собраниях",
 "an3.134:1.1": "“Три эти, монахи, собрания.",
 "an3.134:1.2": "Какие три?",
 "an3.134:1.3": "Собрание, воспитанное возвышением, собрание, воспитанное расспросом, собрание, воспитанное насколько-возможно—",
 "an3.134:1.4": "Вот эти, монахи, три собрания”.",
 "an3.134:1.5": "Вторая."
}
