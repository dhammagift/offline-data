{
 "an3.45:0.1": "Восходящие Наставления 3.45",
 "an3.45:0.2": "5. Малая глава",
 "an3.45:0.3": "Сутта Мудреца",
 "an3.45:1.1": "“Эти три, монахи, мудрецом-установленные, чистым человеком-установленные.",
 "an3.45:1.2": "Какие три?",
 "an3.45:1.3": "Даяние, монахи, мудрецом-установленное, чистым человеком-установленное.",
 "an3.45:1.4": "Уход в бездомность, монахи, мудрецом-установленный, чистым человеком-установленный.",
 "an3.45:1.5": "Матери-отца, монахи, обслуживание мудрецом-установленное, чистым человеком-установленное.",
 "an3.45:1.6": "Вот эти, монахи, три мудрецом-установленных, чистым человеком-установленных.",
 "an3.45:2.1": "Чистыми даяние установлено,",
 "an3.45:2.2": "безвредность, сдержанность, укрощение;",
 "an3.45:2.3": "Матери-отца обслуживание,",
 "an3.45:2.4": "мирных, святую жизнь ведущих.",
 "an3.45:3.1": "Чистых эти положения,",
 "an3.45:3.2": "которые практикует мудрец;",
 "an3.45:3.3": "Благородный, видением наделённый,",
 "an3.45:3.4": "он мир посещает благоприятный”.",
 "an3.45:3.5": "Пятая."
}
