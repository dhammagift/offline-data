{
 "an3.90:0.1": "Восходящие Наставления 3.90",
 "an3.90:0.2": "9. Раздел о шраманах",
 "an3.90:0.3": "Вторая сутта о трёх тренировках",
 "an3.90:1.1": "“Три эти, монахи, тренировки.",
 "an3.90:1.2": "Какие три?",
 "an3.90:1.3": "Высшая-нравственность-тренировка, высший-ум-тренировка, высшее-понимание-тренировка.",
 "an3.90:2.1": "И что такое, монахи, высшая-нравственность-тренировка?",
 "an3.90:2.2": "Вот, монахи, монах нравственный бывает … приняв тренируется в тренировочных правилах.",
 "an3.90:2.3": "Это называется, монахи, высшая-нравственность-тренировка.",
 "an3.90:3.1": "И что такое, монахи, высший-ум-тренировка?",
 "an3.90:3.2": "Вот, монахи, монах, отойдя от желаний … четвёртую джхану достигнув пребывает.",
 "an3.90:3.3": "Это называется, монахи, высший-ум-тренировка.",
 "an3.90:4.1": "И что такое, монахи, высшее-понимание-тренировка?",
 "an3.90:4.2": "Вот, монахи, монах истечений исчерпания, без истечений разума-высвобождение понимания-высвобождение в видимой действительности лично познав, реализовав, достигнув пребывает.",
 "an3.90:4.3": "Это называется, монахи, высшее-понимание-тренировка.",
 "an3.90:4.4": "Вот эти, монахи, три тренировки.",
 "an3.90:5.1": "Высшую нравственность, высший ум-мышление,",
 "an3.90:5.2": "и высшее понимание — решительный;",
 "an3.90:5.3": "Сильный, стойкий, зажжённый,",
 "an3.90:5.4": "осознанным, с охраняемыми способностями пусть живёт.",
 "an3.90:6.1": "Как впереди так позади,",
 "an3.90:6.2": "как позади так впереди;",
 "an3.90:6.3": "Как вниз так вверх,",
 "an3.90:6.4": "как вверх так вниз.",
 "an3.90:7.1": "Как днём так ночью,",
 "an3.90:7.2": "как ночью так днём;",
 "an3.90:7.3": "Одолев все стороны,",
 "an3.90:7.4": "безмерным самадхи.",
 "an3.90:8.1": "То зовут ученика практикой,",
 "an3.90:8.2": "а после — чисто-поведением;",
 "an3.90:8.3": "То зовут в мире пробуждённым,",
 "an3.90:8.4": "стойким, практики-конца-достигшим.",
 "an3.90:9.1": "Распознавания устранением,",
 "an3.90:9.2": "цепляния-исчерпанием-освобождённых;",
 "an3.90:9.3": "Как угасание светильника,",
 "an3.90:9.4": "освобождение бывает ума-мышления”.",
 "an3.90:9.5": "Десятая."
}
