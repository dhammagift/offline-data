{
 "an7.5:0.1": "Восходящие Наставления 7.5",
 "an7.5:0.2": "1. Глава о богатстве",
 "an7.5:0.3": "Сутта Сжатое Богатство",
 "an7.5:1.1": "«Семь этих, монахи, богатств.",
 "an7.5:1.2": "Какие семь?",
 "an7.5:1.3": "Вера-богатство, нравственность-богатство, стыд-богатство, боязнь-богатство, учёность-богатство, щедрость-богатство, понимание-богатство.",
 "an7.5:1.4": "Эти вот, монахи, семь богатств.",
 "an7.5:2.1": "Вера-богатство, нравственность-богатство,",
 "an7.5:2.2": "стыд, боязнь — богатство;",
 "an7.5:2.3": "Учёность-богатство и щедрость,",
 "an7.5:2.4": "понимание — седьмое богатство.",
 "an7.5:3.1": "У кого эти богатства есть,",
 "an7.5:3.2": "у женщины или мужчины;",
 "an7.5:3.3": "Не-бедным его называют,",
 "an7.5:3.4": "не-пуста его жизнь.",
 "an7.5:4.1": "Поэтому веру и нравственность,",
 "an7.5:4.2": "ясность, явления-видение;",
 "an7.5:4.3": "Применяйте, мудрые,",
 "an7.5:4.4": "памятование пробуждённых учения».",
 "an7.5:4.5": "Пятая."
}
