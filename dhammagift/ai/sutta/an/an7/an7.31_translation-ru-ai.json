{
 "an7.31:0.1": "Восходящие Наставления 7.31",
 "an7.31:0.2": "Раздел о семёрках Ваджиев",
 "an7.31:0.3": "Сутта Упадка",
 "an7.31:1.1": "“Семь эти, монахи, для мирянина упадки …",
 "an7.31:1.2": "семь эти, монахи, для мирянина подъёмы.",
 "an7.31:1.3": "Какие семь?",
 "an7.31:1.4": "Видение монахов не упускает,",
 "an7.31:1.5": "слышание подлинной Дхаммы не пренебрегает,",
 "an7.31:1.6": "в высшей нравственности тренируется,",
 "an7.31:1.7": "доверчивым становится,",
 "an7.31:1.8": "к монахам — старшим, и новым, и средним — с умом-без-критики Дхамму слушает, не ища изъяны,",
 "an7.31:1.9": "не вне этого достойную-даров ищет,",
 "an7.31:1.10": "здесь же первое-деяние совершает.",
 "an7.31:1.11": "Эти вот, монахи, семь для мирянина подъёмов.",
 "an7.31:2.1": "Видение само-развитых,",
 "an7.31:2.2": "Который упускает мирянин;",
 "an7.31:2.3": "И слышание благородных явлений,",
 "an7.31:2.4": "В высшей нравственности не тренируется.",
 "an7.31:3.1": "Маловерие к монахам,",
 "an7.31:3.2": "всё больше и больше возрастает;",
 "an7.31:3.3": "И с умом порицания,",
 "an7.31:3.4": "подлинную Дхамму слушать желает.",
 "an7.31:4.1": "Вне этого другое,",
 "an7.31:4.2": "достойную-даров ищет;",
 "an7.31:4.3": "И именно там предварительное-делание,",
 "an7.31:4.4": "кто делает мирянин.",
 "an7.31:5.1": "Эти вот, упадка",
 "an7.31:5.2": "семь явлений хорошо-наставленных;",
 "an7.31:5.3": "Мирянин ассоциирующийся,",
 "an7.31:5.4": "от-истинной-Дхаммы отпадает.",
 "an7.31:6.1": "Видение само-развитых,",
 "an7.31:6.2": "Который не упускает мирянин;",
 "an7.31:6.3": "И слышание благородных явлений,",
 "an7.31:6.4": "В-высшей-нравственности и тренируется.",
 "an7.31:7.1": "Вера и его к монахам,",
 "an7.31:7.2": "всё больше и больше возрастает;",
 "an7.31:7.3": "И-без-порицания-умом,",
 "an7.31:7.4": "подлинную Дхамму слушать желает.",
 "an7.31:8.1": "Не отсюда вовне другое,",
 "an7.31:8.2": "достойную-даров ищет;",
 "an7.31:8.3": "И здесь же предшествующее-делание,",
 "an7.31:8.4": "кто делает мирянин.",
 "an7.31:9.1": "Эти вот не-отпадательные,",
 "an7.31:9.2": "Семь явлений хорошо-наставленных;",
 "an7.31:9.3": "Мирянин ассоциирующийся,",
 "an7.31:9.4": "От-истинной-Дхаммы не отпадает”.",
 "an7.31:9.5": "Одиннадцатая.",
 "an7.31:9.6": "Глава Вадджисаттака Третья.",
 "an7.31:10.0": "Оглавление",
 "an7.31:10.1": "Саранда и Вассакара,",
 "an7.31:10.2": "три-семёрки монахов;",
 "an7.31:10.3": "Бодхи-сознавание и два упадка,",
 "an7.31:10.4": "неудача и поражение."
}
