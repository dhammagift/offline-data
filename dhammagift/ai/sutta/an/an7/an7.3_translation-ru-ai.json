{
 "an7.3:0.1": "Восходящие Наставления 7.3",
 "an7.3:0.2": "1. Глава о богатстве",
 "an7.3:0.3": "Сутта Сжатые Силы",
 "an7.3:1.1": "Так мной услышано—",
 "an7.3:1.2": "одно время Благословенный в Саваттхи располагается, в роще Джеты, в парке Анатхапиндики …",
 "an7.3:1.3": "Вот эти семь, монахи, сил.",
 "an7.3:1.4": "Какие семь?",
 "an7.3:1.5": "Сила веры, сила решимости, сила стыда, сила боязни, сила памятования, сила самадхи, сила понимания.",
 "an7.3:1.6": "Вот эти, монахи, семь сил.",
 "an7.3:2.1": "Сила веры и решимость,",
 "an7.3:2.2": "стыд, боязнь — сила;",
 "an7.3:2.3": "Сила памятования и самадхи,",
 "an7.3:2.4": "понимание — седьмая сила;",
 "an7.3:2.5": "Этими сильный монах,",
 "an7.3:2.6": "приятно живёт мудрец.",
 "an7.3:3.1": "Первопричинно исследует Дхамму,",
 "an7.3:3.2": "пониманием благо-смысл-цель прозревает;",
 "an7.3:3.3": "Как угасание светильника,",
 "an7.3:3.4": "освобождение бывает ума-мышления”.",
 "an7.3:3.5": "Третья."
}
