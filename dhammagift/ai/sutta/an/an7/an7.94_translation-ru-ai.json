{
 "an7.94:0.1": "Восходящие Наставления 7.94",
 "an7.94:0.2": "9. Раздел о шраманах",
 "an7.94:0.3": "Сутта Подлинная Дхамма",
 "an7.94:1.1": "“Семь эти, монахи, подлинные явления.",
