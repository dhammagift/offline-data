{
 "an7.29:0.1": "Восходящие Наставления 7.29",
 "an7.29:0.2": "Раздел о семёрках Ваджиев",
 "an7.29:0.3": "Вторая сутта об упадке",
 "an7.29:1.1": "“Семь эти, монахи, явления для мирянина к упадку ведут.",
 "an7.29:1.2": "Какие семь?",
 "an7.29:1.3": "Видение монахов упускает,",
 "an7.29:1.4": "слышание подлинной Дхаммы пренебрегает,",
 "an7.29:1.5": "в высшей нравственности не тренируется,",
 "an7.29:1.6": "маловерным становится,",
 "an7.29:1.7": "к монахам — старшим, и новым, и средним — с умом-критикой Дхамму слушает, ища изъяны,",
 "an7.29:1.8": "вне этого достойную-даров ищет,",
 "an7.29:1.9": "и там первое-деяние совершает.",
 "an7.29:1.10": "Эти вот, монахи, семь явлений для мирянина к упадку ведут.",
 "an7.29:2.1": "Семь эти, монахи, явления для мирянина к не-упадку ведут.",
 "an7.29:2.2": "Какие семь?",
 "an7.29:2.3": "Видение монахов не упускает,",
 "an7.29:2.4": "слышание подлинной Дхаммы не пренебрегает,",
 "an7.29:2.5": "в высшей нравственности тренируется,",
 "an7.29:2.6": "доверчивым становится,",
 "an7.29:2.7": "к монахам — старшим, и новым, и средним — с умом-без-критики Дхамму слушает, не ища изъяны,",
 "an7.29:2.8": "не вне этого достойную-даров ищет,",
 "an7.29:2.9": "здесь же первое-деяние совершает.",
 "an7.29:2.10": "Эти вот, монахи, семь явлений для мирянина к не-упадку ведут”.",
 "an7.29:2.11": "Это сказал Благословенный.",
 "an7.29:2.12": "Это сказав Благой, в дополнение это сказал Учитель:",
 "an7.29:3.1": "“Видение само-развитых,",
 "an7.29:3.2": "Который упускает мирянин;",
 "an7.29:3.3": "И слышание благородных явлений,",
 "an7.29:3.4": "В высшей нравственности не тренируется.",
 "an7.29:4.1": "Маловерие к монахам,",
 "an7.29:4.2": "всё больше и больше возрастает;",
 "an7.29:4.3": "И с умом порицания,",
 "an7.29:4.4": "подлинную Дхамму слушать желает.",
 "an7.29:5.1": "Вне этого другое,",
 "an7.29:5.2": "достойную-даров ищет;",
 "an7.29:5.3": "И именно там предварительное-делание,",
 "an7.29:5.4": "кто делает мирянин.",
 "an7.29:6.1": "Эти вот, упадка",
 "an7.29:6.2": "семь явлений хорошо-наставленных;",
 "an7.29:6.3": "Мирянин ассоциирующийся,",
 "an7.29:6.4": "от-истинной-Дхаммы отпадает.",
 "an7.29:7.1": "Видение само-развитых,",
 "an7.29:7.2": "Который не упускает мирянин;",
 "an7.29:7.3": "И слышание благородных явлений,",
 "an7.29:7.4": "В-высшей-нравственности и тренируется.",
 "an7.29:8.1": "Вера и его к монахам,",
 "an7.29:8.2": "всё больше и больше возрастает;",
 "an7.29:8.3": "И-без-порицания-умом,",
 "an7.29:8.4": "подлинную Дхамму слушать желает.",
 "an7.29:9.1": "Не отсюда вовне другое,",
 "an7.29:9.2": "достойную-даров ищет;",
 "an7.29:9.3": "И здесь же предшествующее-делание,",
 "an7.29:9.4": "кто делает мирянин.",
 "an7.29:10.1": "Эти вот не-отпадательные,",
 "an7.29:10.2": "Семь явлений хорошо-наставленных;",
 "an7.29:10.3": "Мирянин ассоциирующийся,",
 "an7.29:10.4": "От-истинной-Дхаммы не отпадает”.",
 "an7.29:10.5": "Девятая."
}
