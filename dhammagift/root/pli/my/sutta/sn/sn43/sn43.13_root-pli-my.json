  "sn43.13:0.3": "2. Anatasuttaṃ ",
  "sn43.13:1.1": "‘‘Anatañca vo, bhikkhave, desessāmi, anatagāmiñca maggaṃ. ",
  "sn43.13:1.2": "Taṃ suṇātha. ",
  "sn43.13:1.3": "Katamañca, bhikkhave, anataṃ…pe…’’. ",
  "sn43.13:1.4": "(Yathā asaṅkhataṃ tathā vitthāretabbaṃ). ",
  "sn43.13:1.5": "Dutiyaṃ. "
}
