  "sn35.99:0.2": "",
  "sn35.99:0.3": "6. Samādhisuttaṃ ",
  "sn35.99:1.1": "‘‘Samādhiṃ, bhikkhave, bhāvetha. ",
  "sn35.99:1.2": "Samāhito, bhikkhave, bhikkhu yathābhūtaṃ pajānāti. ",
  "sn35.99:1.3": "Kiñca yathābhūtaṃ pajānāti? ",
  "sn35.99:1.4": "‘Cakkhu anicca’nti yathābhūtaṃ pajānāti; ",
  "sn35.99:1.5": "‘rūpā aniccā’ti yathābhūtaṃ pajānāti; ",
  "sn35.99:1.6": "‘cakkhuviññāṇaṃ anicca’nti yathābhūtaṃ pajānāti; ",
  "sn35.99:1.7": "‘cakkhusamphasso anicco’ti yathābhūtaṃ pajānāti. ",
  "sn35.99:1.8": "‘Yampidaṃ cakkhusamphassapaccayā uppajjati vedayitaṃ sukhaṃ vā dukkhaṃ vā adukkhamasukhaṃ vā tampi anicca’nti yathābhūtaṃ pajānāti…pe… ",
  "sn35.99:1.9": "‘mano anicca’nti yathābhūtaṃ pajānāti. ",
  "sn35.99:1.10": "Dhammā… ",
  "sn35.99:1.11": "manoviññāṇaṃ… ",
  "sn35.99:1.12": "manosamphasso… ",
  "sn35.99:1.13": "‘yampidaṃ manosamphassapaccayā uppajjati vedayitaṃ sukhaṃ vā dukkhaṃ vā adukkhamasukhaṃ vā tampi anicca’nti yathābhūtaṃ pajānāti. ",
  "sn35.99:1.14": "Samādhiṃ, bhikkhave, bhāvetha. ",
  "sn35.99:1.15": "Samāhito, bhikkhave, bhikkhu yathābhūtaṃ pajānātī’’ti. ",
  "sn35.99:1.16": "Chaṭṭhaṃ. "
}
