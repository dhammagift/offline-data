{
  "sn15.14:0.1": "",
  "sn15.14:0.2": "",
  "sn15.14:0.3": "4. Mātusuttaṃ ",
  "sn15.14:1.1": "Sāvatthiyaṃ viharati…pe… ",
  "sn15.14:1.2": "‘‘anamataggoyaṃ, bhikkhave, saṃsāro…pe… ",
  "sn15.14:1.3": "na so, bhikkhave, satto sulabharūpo yo namātābhūtapubbo iminā dīghena addhunā. ",
  "sn15.14:1.4": "Taṃ kissa hetu? ",
  "sn15.14:1.5": "Anamataggoyaṃ, bhikkhave, saṃsāro…pe… ",
  "sn15.14:1.6": "alaṃ vimuccitu’’nti. ",
  "sn15.14:1.7": "Catutthaṃ. "
}
