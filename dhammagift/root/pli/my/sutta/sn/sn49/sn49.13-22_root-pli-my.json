{
  "sn49.13-22:0.1": "",
  "sn49.13-22:0.2": "2. Appamādavaggo ",
  "sn49.13-22:0.3": "",
  "sn49.13-22:1.1": "(Appamādavaggo sammappadhānavasena vitthāretabbo). ",
  "sn49.13-22:2.0": "Tassuddānaṃ – ",
  "sn49.13-22:2.1": "Tathāgataṃ padaṃ kūṭaṃ, ",
  "sn49.13-22:2.2": "mūlaṃ sārena vassikaṃ; ",
  "sn49.13-22:2.3": "Rājā candimasūriyā, ",
  "sn49.13-22:2.4": "vatthena dasamaṃ padanti. "
}
