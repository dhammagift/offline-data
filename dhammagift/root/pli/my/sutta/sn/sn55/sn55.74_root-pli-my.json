  "sn55.74:0.3": "",
  "sn55.74:1.1": "Nibbedhikapaññatā saṃvattanti. ",
  "sn55.74:1.2": "Katame cattāro? ",
  "sn55.74:1.3": "Sappurisasaṃsevo, saddhammassavanaṃ, yonisomanasikāro, dhammānudhammappaṭipatti – ",
  "sn55.74:1.4": "ime kho, bhikkhave, cattāro dhammā bhāvitā bahulīkatā nibbedhikapaññatāya saṃvattantī’’ti. ",
  "sn55.74:1.5": "Terasamaṃ. ",
  "sn55.74:1.6": "Mahāpaññavaggo sattamo. ",
  "sn55.74:2.0": "Tassuddānaṃ – ",
  "sn55.74:2.1": "Mahā puthu vipula-gambhīraṃ, ",
  "sn55.74:2.2": "appamatta-bhūri-bāhullaṃ; ",
  "sn55.74:2.3": "Sīgha-lahu-hāsa-javana, ",
  "sn55.74:2.4": "tikkha-nibbedhikāya cāti. ",
  "sn55.74:2.5": "Sotāpattisaṃyuttaṃ ekādasamaṃ. "
}
