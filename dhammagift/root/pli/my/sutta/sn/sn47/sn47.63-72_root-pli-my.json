{
  "sn47.63-72:0.1": "",
  "sn47.63-72:0.2": "7. Appamādavaggo ",
  "sn47.63-72:0.3": "1-10. Tathāgatādisuttadasakaṃ ",
  "sn47.63-72:1.1": "Yāvatā, bhikkhave, sattā apadā vā dvipadā vā catuppadā vā bahuppadā vāti ",
  "sn47.63-72:1.2": "vitthāretabbaṃ. ",
  "sn47.63-72:1.3": "Appamādavaggo sattamo. ",
  "sn47.63-72:2.0": "Tassuddānaṃ – ",
  "sn47.63-72:2.1": "Tathāgataṃ padaṃ kūṭaṃ, ",
  "sn47.63-72:2.2": "mūlaṃ sāro ca vassikaṃ; ",
  "sn47.63-72:2.3": "Rājā candimasūriyā, ",
  "sn47.63-72:2.4": "vatthena dasamaṃ padanti. "
}
