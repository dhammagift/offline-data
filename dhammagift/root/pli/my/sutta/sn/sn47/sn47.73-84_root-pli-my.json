{
  "sn47.73-84:0.1": "",
  "sn47.73-84:0.2": "8. Balakaraṇīyavaggo ",
  "sn47.73-84:0.3": "1-12. Balādisuttadvādasakaṃ ",
  "sn47.73-84:1.1": "Seyyathāpi, bhikkhave, ye keci balakaraṇīyā kammantā karīyantīti ",
  "sn47.73-84:1.2": "vitthāretabbaṃ. ",
  "sn47.73-84:1.3": "Balakaraṇīyavaggo aṭṭhamo. ",
  "sn47.73-84:2.0": "Tassuddānaṃ – ",
  "sn47.73-84:2.1": "Balaṃ bījañca nāgo ca, ",
  "sn47.73-84:2.2": "rukkho kumbhena sūkiyā; ",
  "sn47.73-84:2.3": "Ākāsena ca dve meghā, ",
  "sn47.73-84:2.4": "nāvā āgantukā nadīti. "
}
