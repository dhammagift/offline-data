{
  "sn47.85-94:0.1": "",
  "sn47.85-94:0.2": "9. Esanāvaggo ",
  "sn47.85-94:0.3": "1-10. Esanādisuttadasakaṃ ",
  "sn47.85-94:1.1": "Tisso imā, bhikkhave, esanā. ",
  "sn47.85-94:1.2": "Katamā tisso? ",
  "sn47.85-94:1.3": "Kāmesanā, bhavesanā, brahmacariyesanāti ",
  "sn47.85-94:1.4": "vitthāretabbaṃ. ",
  "sn47.85-94:1.5": "Esanāvaggo navamo. ",
  "sn47.85-94:2.0": "Tassuddānaṃ – ",
  "sn47.85-94:2.1": "Esanā vidhā āsavo, ",
  "sn47.85-94:2.2": "bhavo ca dukkhatā tisso; ",
  "sn47.85-94:2.3": "Khilaṃ malañca nīgho ca, ",
  "sn47.85-94:2.4": "vedanā taṇhā tasināya cāti. "
}
