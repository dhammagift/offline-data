  "sn11.16:0.2": "",
  "sn11.16:0.3": "6. Yajamānasuttaṃ ",
  "sn11.16:1.1": "Ekaṃ samayaṃ bhagavā rājagahe viharati gijjhakūṭe pabbate. ",
  "sn11.16:1.2": "Atha kho sakko devānamindo yena bhagavā tenupasaṅkami; upasaṅkamitvā bhagavantaṃ abhivādetvā ekamantaṃ aṭṭhāsi. ",
  "sn11.16:1.3": "Ekamantaṃ ṭhito kho sakko devānamindo bhagavantaṃ gāthāya ajjhabhāsi – ",
  "sn11.16:2.1": "‘‘Yajamānānaṃ manussānaṃ, ",
  "sn11.16:2.2": "puññapekkhāna pāṇinaṃ; ",
  "sn11.16:2.3": "Karotaṃ opadhikaṃ puññaṃ, ",
  "sn11.16:2.4": "kattha dinnaṃ mahapphala’’nti. ",
  "sn11.16:3.1": "‘‘Cattāro ca paṭipannā, ",
  "sn11.16:3.2": "cattāro ca phale ṭhitā; ",
  "sn11.16:3.3": "Esa saṅgho ujubhūto, ",
  "sn11.16:3.4": "paññāsīlasamāhito. ",
  "sn11.16:4.1": "‘‘Yajamānānaṃ manussānaṃ, ",
  "sn11.16:4.2": "puññapekkhāna pāṇinaṃ; ",
  "sn11.16:4.3": "Karotaṃ opadhikaṃ puññaṃ, ",
  "sn11.16:4.4": "saṅghe dinnaṃ mahapphala’’nti. "
}
