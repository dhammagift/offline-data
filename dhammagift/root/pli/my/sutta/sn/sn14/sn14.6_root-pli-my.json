  "sn14.6:0.1": "",
  "sn14.6:0.2": "",
  "sn14.6:0.3": "6. Bāhiradhātunānattasuttaṃ ",
  "sn14.6:1.1": "Sāvatthiyaṃ viharati…pe… ",
  "sn14.6:1.2": "‘‘dhātunānattaṃ vo, bhikkhave, desessāmi. ",
  "sn14.6:1.3": "Taṃ suṇātha…pe… ",
  "sn14.6:1.4": "katamañca, bhikkhave, dhātunānattaṃ? ",
  "sn14.6:1.5": "Rūpadhātu saddadhātu gandhadhātu rasadhātu phoṭṭhabbadhātu dhammadhātu – ",
  "sn14.6:1.6": "idaṃ vuccati, bhikkhave, dhātunānatta’’nti. ",
  "sn14.6:1.7": "Chaṭṭhaṃ. "
}
