  "sn14.21:0.3": "11. Appassutamūlakasuttaṃ ",
  "sn14.21:1.1": "Sāvatthiyaṃ viharati…pe… ",
  "sn14.21:1.2": "‘‘dhātusova, bhikkhave, sattā saṃsandanti samenti. ",
  "sn14.21:1.3": "Appassutā appassutehi saddhiṃ saṃsandanti samenti; ",
  "sn14.21:1.4": "kusītā kusītehi saddhiṃ saṃsandanti samenti; ",
  "sn14.21:1.5": "duppaññā duppaññehi saddhiṃ saṃsandanti samenti; ",
  "sn14.21:1.6": "bahussutā bahussutehi saddhiṃ saṃsandanti samenti; ",
  "sn14.21:1.7": "āraddhavīriyā āraddhavīriyehi saddhiṃ saṃsandanti samenti; paññavanto paññavantehi saddhiṃ saṃsandanti samenti…pe…. (1) ",
  "sn14.21:2.1": "‘‘Appassutā appassutehi saddhiṃ saṃsandanti samenti; ",
  "sn14.21:2.2": "muṭṭhassatino muṭṭhassatīhi saddhiṃ saṃsandanti samenti; ",
  "sn14.21:2.3": "duppaññā duppaññehi saddhiṃ saṃsandanti samenti; ",
  "sn14.21:2.4": "bahussutā bahussutehi saddhiṃ saṃsandanti samenti; ",
  "sn14.21:2.5": "upaṭṭhitassatino upaṭṭhitassatīhi saddhiṃ saṃsandanti samenti; paññavanto paññavantehi saddhiṃ saṃsandanti samentīti…pe…. ",
  "sn14.21:2.6": "Ekādasamaṃ. (2) "
}
