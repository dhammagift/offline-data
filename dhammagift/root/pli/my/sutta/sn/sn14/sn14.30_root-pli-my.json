{
  "sn14.30:0.1": "",
  "sn14.30:0.2": "4. Catutthavaggo ",
  "sn14.30:0.3": "1. Catudhātusuttaṃ ",
  "sn14.30:1.1": "Ekaṃ samayaṃ bhagavā sāvatthiyaṃ viharati jetavane anāthapiṇḍikassa ārāme…pe… ",
  "sn14.30:1.2": "‘‘catasso imā, bhikkhave, dhātuyo. ",
  "sn14.30:1.3": "Katamā catasso? ",
  "sn14.30:1.4": "Pathavīdhātu, āpodhātu, tejodhātu, vāyodhātu – ",
  "sn14.30:1.5": "imā kho, bhikkhave, catasso dhātuyo’’ti. ",
  "sn14.30:1.6": "Paṭhamaṃ. "
}
