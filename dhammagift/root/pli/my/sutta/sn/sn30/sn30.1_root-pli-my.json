{
  "sn30.1:0.1": "9. Supaṇṇasaṃyuttaṃ ",
  "sn30.1:0.2": "",
  "sn30.1:0.3": "1. Suddhikasuttaṃ ",
  "sn30.1:1.1": "Sāvatthinidānaṃ. ",
  "sn30.1:1.2": "‘‘Catasso imā, bhikkhave, supaṇṇayoniyo. ",
  "sn30.1:1.3": "Katamā catasso? ",
  "sn30.1:1.4": "Aṇḍajā supaṇṇā, jalābujā supaṇṇā, saṃsedajā supaṇṇā, opapātikā supaṇṇā – ",
  "sn30.1:1.5": "imā kho, bhikkhave, catasso supaṇṇayoniyo’’ti. ",
  "sn30.1:1.6": "Paṭhamaṃ. "
}
