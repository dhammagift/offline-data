{
  "sn46.175-184:0.1": "",
  "sn46.175-184:0.2": "18. Punaoghavaggo ",
  "sn46.175-184:0.3": "357-366. Punaoghādisuttaṃ ",
  "sn46.175-184:1.1": "Bojjhaṅgasaṃyutassa ",
  "sn46.175-184:1.2": "punaoghavaggo aṭṭhārasamo. ",
  "sn46.175-184:2.0": "Uddānaṃ – ",
  "sn46.175-184:2.1": "Ogho yogo upādānaṃ, ",
  "sn46.175-184:2.2": "ganthā anusayena ca; ",
  "sn46.175-184:2.3": "Kāmaguṇā nīvaraṇā, ",
  "sn46.175-184:2.4": "khandhā oruddhambhāgiyānīti. ",
  "sn46.175-184:3.1": "(Rāgavinayapariyosāna-dosavinayapariyosāna-mohavinayapariyosānavaggo vitthāretabbo). ",
  "sn46.175-184:3.2": "(Yadapi maggasaṃyuttaṃ vitthāretabbaṃ, tadapi bojjhaṅgasaṃyuttaṃ vitthāretabbaṃ). ",
  "sn46.175-184:3.3": "Bojjhaṅgasaṃyuttaṃ dutiyaṃ. "
}
