  "sn46.165-174:0.1": "",
  "sn46.165-174:0.2": "17. Punaesanāvaggo ",
  "sn46.165-174:0.3": "346-356. Punaesanādisuttaṃ ",
  "sn46.165-174:1.1": "",
  "sn46.165-174:1.2": "Punaesanāvaggo sattarasamo. ",
  "sn46.165-174:2.0": "Uddānaṃ – ",
  "sn46.165-174:2.1": "Esanā vidhā āsavo, ",
  "sn46.165-174:2.2": "bhavo ca dukkhatā tisso; ",
  "sn46.165-174:2.3": "Khilaṃ malañca nīgho ca, ",
  "sn46.165-174:2.4": "vedanātaṇhā tasināya cāti. "
}
