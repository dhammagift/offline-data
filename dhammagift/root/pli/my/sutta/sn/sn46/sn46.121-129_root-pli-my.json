{
  "sn46.121-129:0.1": "",
  "sn46.121-129:0.2": "13. Oghavaggo ",
  "sn46.121-129:0.3": "1-8. Oghādisuttaṃ ",
  "sn46.121-129:1.1": "‘‘Cattārome bhikkhave, oghā. ",
  "sn46.121-129:1.2": "Katame cattāro? ",
  "sn46.121-129:1.3": "Kāmogho, bhavogho, diṭṭhogho, avijjoghoti ",
  "sn46.121-129:1.4": "vitthāretabbaṃ. "
}
