{
  "sn46.111-120:0.1": "",
  "sn46.111-120:0.2": "12. Esanāvaggo ",
  "sn46.111-120:0.3": "1-10. Esanādisuttaṃ ",
  "sn46.111-120:1.1": "‘‘Tisso imā, bhikkhave, esanā. ",
  "sn46.111-120:1.2": "Katamā tisso? ",
  "sn46.111-120:1.3": "Kāmesanā, bhavesanā, brahmacariyesanāti vitthāretabbaṃ. ",
  "sn46.111-120:1.4": "Esanāvaggo dvādasamo. ",
  "sn46.111-120:2.0": "Tassuddānaṃ – ",
  "sn46.111-120:2.1": "Esanā vidhā āsavo, ",
  "sn46.111-120:2.2": "bhavo ca dukkhatā tisso; ",
  "sn46.111-120:2.3": "Khilaṃ malañca nīgho ca, ",
  "sn46.111-120:2.4": "vedanā taṇhā tasināya cāti. ",
  "sn46.111-120:3.1": "(Bojjhaṅgasaṃyuttassa esanāpeyyālaṃ vivekanissitato vitthāretabbaṃ). "
}
