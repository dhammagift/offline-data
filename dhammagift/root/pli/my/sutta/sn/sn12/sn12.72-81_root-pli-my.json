{
  "sn12.72-81:0.1": "",
  "sn12.72-81:0.2": "",
  "sn12.72-81:0.3": "2-11. Jātisuttādidasakaṃ ",
  "sn12.72-81:1.1": "Sāvatthiyaṃ viharati…pe… ",
  "sn12.72-81:1.2": "jātiṃ nappajānanti…pe…. (3) ",
  "sn12.72-81:2.1": "Bhavaṃ nappajānanti…pe…. (4) ",
  "sn12.72-81:3.1": "Upādānaṃ nappajānanti…pe…. (5) ",
  "sn12.72-81:4.1": "Taṇhaṃ nappajānanti…pe…. (6) ",
  "sn12.72-81:5.1": "Vedanaṃ nappajānanti…pe…. (7) ",
  "sn12.72-81:6.1": "Phassaṃ nappajānanti…pe…. (8) ",
  "sn12.72-81:7.1": "Saḷāyatanaṃ nappajānanti…pe…. (9) ",
  "sn12.72-81:8.1": "Nāmarūpaṃ nappajānanti…pe…. (10) ",
  "sn12.72-81:9.1": "Viññāṇaṃ nappajānanti…pe…. (11) ",
  "sn12.72-81:10.1": "‘‘Saṅkhāre nappajānanti, saṅkhārasamudayaṃ nappajānanti, saṅkhāranirodhaṃ nappajānanti, saṅkhāranirodhagāminiṃ paṭipadaṃ nappajānanti…pe… saṅkhāre ",
  "sn12.72-81:10.2": "pajānanti…pe… ",
  "sn12.72-81:10.3": "sayaṃ abhiññā sacchikatvā upasampajja viharantī’’ti. ",
  "sn12.72-81:10.4": "Ekādasamaṃ. ",
  "sn12.72-81:10.5": "Samaṇabrāhmaṇavaggo aṭṭhamo. ",
  "sn12.72-81:11.0": "Tassuddānaṃ – ",
  "sn12.72-81:11.1": "Paccayekādasa vuttā, ",
  "sn12.72-81:11.2": "catusaccavibhajjanā; ",
  "sn12.72-81:11.3": "Samaṇabrāhmaṇavaggo, ",
  "sn12.72-81:11.4": "nidāne bhavati aṭṭhamo. ",
  "sn12.72-81:12.0": "Vagguddānaṃ – ",
  "sn12.72-81:12.1": "Buddho āhāro dasabalo, ",
  "sn12.72-81:12.2": "kaḷāro gahapatipañcamo; ",
  "sn12.72-81:12.3": "Dukkhavaggo mahāvaggo, ",
  "sn12.72-81:12.4": "aṭṭhamo samaṇabrāhmaṇoti. "
}
