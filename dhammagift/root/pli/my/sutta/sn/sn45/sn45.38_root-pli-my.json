  "sn45.38:0.2": "",
  "sn45.38:0.3": "8. Dutiyabrahmaññasuttaṃ ",
  "sn45.38:1.1": "Sāvatthinidānaṃ. ",
  "sn45.38:1.2": "‘‘Brahmaññañca vo, bhikkhave, desessāmi, brahmaññatthañca. ",
  "sn45.38:1.3": "Taṃ suṇātha. ",
  "sn45.38:1.4": "Katamañca, bhikkhave, brahmaññaṃ? ",
  "sn45.38:1.5": "Ayameva ariyo aṭṭhaṅgiko maggo, seyyathidaṃ – ",
  "sn45.38:1.6": "sammādiṭṭhi…pe… sammāsamādhi. ",
  "sn45.38:1.7": "Idaṃ vuccati, bhikkhave, brahmaññaṃ. ",
  "sn45.38:1.8": "Katamo ca, bhikkhave, brahmaññattho? ",
  "sn45.38:1.9": "Yo kho, bhikkhave, rāgakkhayo dosakkhayo mohakkhayo – ",
  "sn45.38:1.10": "ayaṃ vuccati, bhikkhave, brahmaññattho’’ti. ",
  "sn45.38:1.11": "Aṭṭhamaṃ. "
}
