  "sn53.13-22:0.3": "",
  "sn53.13-22:1.1": "Appamādavaggo vitthāretabbo. ",
  "sn53.13-22:2.0": "Tassuddānaṃ – ",
  "sn53.13-22:2.1": "Tathāgataṃ padaṃ kūṭaṃ, ",
  "sn53.13-22:2.2": "mūlaṃ sāro ca vassikaṃ; ",
  "sn53.13-22:2.3": "Rājā candimasūriyā, ",
  "sn53.13-22:2.4": "vatthena dasamaṃ padanti. "
}
