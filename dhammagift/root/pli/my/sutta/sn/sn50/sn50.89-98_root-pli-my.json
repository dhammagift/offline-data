{
  "sn50.89-98:0.1": "",
  "sn50.89-98:0.2": "9. Esanāvaggo ",
  "sn50.89-98:0.3": "1-12. Esanādisuttadvādasakaṃ ",
  "sn50.89-98:1.1": "Evaṃ esanāpāḷi vitthāretabbā – rāgavinayapariyosānaṃ dosavinayapariyosānaṃ mohavinayapariyosānaṃ. ",
  "sn50.89-98:1.2": "Esanāvaggo navamo. ",
  "sn50.89-98:2.0": "Tassuddānaṃ – ",
  "sn50.89-98:2.1": "Esanā vidhā āsavo, ",
  "sn50.89-98:2.2": "bhavo ca dukkhatā tisso; ",
  "sn50.89-98:2.3": "Khilaṃ malañca nīgho ca, ",
  "sn50.89-98:2.4": "vedanā taṇhā tasinā cāti. "
}
