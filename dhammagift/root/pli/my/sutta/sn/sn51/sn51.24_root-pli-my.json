{
  "sn51.24:0.1": "",
  "sn51.24:0.2": "",
  "sn51.24:0.3": "4. Suddhikasuttaṃ ",
  "sn51.24:1.1": "‘‘Cattārome, bhikkhave, iddhipādā. ",
  "sn51.24:1.2": "Katame cattāro? ",
  "sn51.24:1.3": "Idha, bhikkhave, bhikkhu chandasamādhippadhānasaṅkhārasamannāgataṃ iddhipādaṃ bhāveti, ",
  "sn51.24:1.4": "vīriyasamādhi…pe… cittasamādhi…pe… ",
  "sn51.24:1.5": "",
  "sn51.24:1.6": "vīmaṃsāsamādhippadhānasaṅkhārasamannāgataṃ iddhipādaṃ bhāveti – ",
  "sn51.24:1.7": "ime kho, bhikkhave, cattāro iddhipādā’’ti. ",
  "sn51.24:1.8": "Catutthaṃ. "
}
