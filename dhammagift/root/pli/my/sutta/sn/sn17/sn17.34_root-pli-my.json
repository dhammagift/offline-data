{
  "sn17.34:0.1": "",
  "sn17.34:0.2": "",
  "sn17.34:0.3": "4. Sukkadhammasuttaṃ ",
  "sn17.34:1.1": "Sāvatthiyaṃ viharati…pe… ",
  "sn17.34:1.2": "‘‘dāruṇo, bhikkhave, lābhasakkārasiloko. ",
  "sn17.34:1.3": "Lābhasakkārasilokena abhibhūtassa pariyādiṇṇacittassa, bhikkhave, devadattassa sukko dhammo samucchedamagamā. ",
  "sn17.34:1.4": "Evaṃ dāruṇo kho, bhikkhave, lābhasakkārasiloko…pe… ",
  "sn17.34:1.5": "sikkhitabba’’nti. ",
  "sn17.34:1.6": "Catutthaṃ. "
}
