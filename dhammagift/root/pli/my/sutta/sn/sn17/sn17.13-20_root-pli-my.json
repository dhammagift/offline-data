{
  "sn17.13-20:0.1": "",
  "sn17.13-20:0.2": "",
  "sn17.13-20:0.3": "3-10. Suvaṇṇanikkhasuttādiaṭṭhakaṃ ",
  "sn17.13-20:1.1": "Sāvatthiyaṃ viharati…pe… ",
  "sn17.13-20:1.2": "‘‘idhāhaṃ, bhikkhave, ekaccaṃ puggalaṃ evaṃ cetasā ceto paricca pajānāmi – ",
  "sn17.13-20:1.3": "‘na cāyamāyasmā suvaṇṇanikkhassāpi hetu…pe… ",
  "sn17.13-20:1.4": "suvaṇṇanikkhasatassāpi hetu… ",
  "sn17.13-20:1.5": "siṅgīnikkhassāpi hetu… ",
  "sn17.13-20:1.6": "siṅgīnikkhasatassāpi hetu… ",
  "sn17.13-20:1.7": "pathaviyāpi jātarūpaparipūrāya hetu… ",
  "sn17.13-20:1.8": "āmisakiñcikkhahetupi… ",
  "sn17.13-20:1.9": "jīvitahetupi… ",
  "sn17.13-20:1.10": "janapadakalyāṇiyāpi hetu sampajānamusā bhāseyyā’ti. ",
  "sn17.13-20:1.11": "Tamenaṃ passāmi aparena samayena lābhasakkārasilokena abhibhūtaṃ pariyādiṇṇacittaṃ sampajānamusā bhāsantaṃ. ",
  "sn17.13-20:1.12": "Evaṃ dāruṇo kho, bhikkhave, lābhasakkārasiloko…pe… ",
  "sn17.13-20:1.13": "evañhi vo, bhikkhave, sikkhitabba’’nti. ",
  "sn17.13-20:1.14": "Dasamaṃ. ",
  "sn17.13-20:1.15": "Dutiyo vaggo. ",
  "sn17.13-20:2.0": "Tassuddānaṃ – ",
  "sn17.13-20:2.1": "Dve pāti dve suvaṇṇā ca, ",
  "sn17.13-20:2.2": "siṅgīhi apare duve; ",
  "sn17.13-20:2.3": "Pathavī kiñcikkhajīvitaṃ, ",
  "sn17.13-20:2.4": "janapadakalyāṇiyā dasāti. "
}
