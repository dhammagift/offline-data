{
  "sn17.31:0.1": "",
  "sn17.31:0.2": "4. Catutthavaggo ",
  "sn17.31:0.3": "1. Bhindisuttaṃ ",
  "sn17.31:1.1": "Sāvatthiyaṃ viharati…pe… ",
  "sn17.31:1.2": "‘‘dāruṇo, bhikkhave, lābhasakkārasiloko. ",
  "sn17.31:1.3": "Lābhasakkārasilokena abhibhūto pariyādiṇṇacitto, bhikkhave, devadatto saṅghaṃ bhindi. ",
  "sn17.31:1.4": "Evaṃ dāruṇo kho, bhikkhave, lābhasakkārasiloko…pe… ",
  "sn17.31:1.5": "sikkhitabba’’nti. ",
  "sn17.31:1.6": "Paṭhamaṃ. "
}
