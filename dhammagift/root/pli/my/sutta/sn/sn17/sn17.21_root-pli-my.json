{
  "sn17.21:0.1": "",
  "sn17.21:0.2": "3. Tatiyavaggo ",
  "sn17.21:0.3": "1. Mātugāmasuttaṃ ",
  "sn17.21:1.1": "Sāvatthiyaṃ viharati…pe… ",
  "sn17.21:1.2": "‘‘dāruṇo, bhikkhave, lābhasakkārasiloko…pe… ",
  "sn17.21:1.3": "na tassa, bhikkhave, mātugāmo eko ekassa cittaṃ pariyādāya tiṭṭhati yassa lābhasakkārasiloko cittaṃ pariyādāya tiṭṭhati. ",
  "sn17.21:1.4": "Evaṃ dāruṇo kho, bhikkhave, lābhasakkārasiloko …pe… ",
  "sn17.21:1.5": "evañhi vo, bhikkhave, sikkhitabba’’nti. ",
  "sn17.21:1.6": "Paṭhamaṃ. "
}
