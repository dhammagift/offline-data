  "sn17.32:0.1": "",
  "sn17.32:0.2": "",
  "sn17.32:0.3": "2. Kusalamūlasuttaṃ ",
  "sn17.32:1.1": "Sāvatthiyaṃ viharati…pe… ",
  "sn17.32:1.2": "‘‘dāruṇo, bhikkhave, lābhasakkārasiloko. ",
  "sn17.32:1.3": "Lābhasakkārasilokena abhibhūtassa pariyādiṇṇacittassa, bhikkhave, devadattassa kusalamūlaṃ samucchedamagamā. ",
  "sn17.32:1.4": "Evaṃ dāruṇo kho, bhikkhave, lābhasakkārasiloko…pe… ",
  "sn17.32:1.5": "sikkhitabba’’nti. ",
  "sn17.32:1.6": "Dutiyaṃ. "
}
