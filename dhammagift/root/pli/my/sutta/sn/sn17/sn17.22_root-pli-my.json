{
  "sn17.22:0.1": "",
  "sn17.22:0.2": "",
  "sn17.22:0.3": "2. Kalyāṇīsuttaṃ ",
  "sn17.22:1.1": "Sāvatthiyaṃ viharati…pe… ",
  "sn17.22:1.2": "‘‘dāruṇo, bhikkhave, lābhasakkārasiloko…pe… ",
  "sn17.22:1.3": "na tassa, bhikkhave, janapadakalyāṇī ekā ekassa cittaṃ pariyādāya tiṭṭhati yassa lābhasakkārasiloko cittaṃ pariyādāya tiṭṭhati. ",
  "sn17.22:1.4": "Evaṃ dāruṇo kho, bhikkhave, lābhasakkārasiloko…pe… ",
  "sn17.22:1.5": "evañhi vo, bhikkhave, sikkhitabba’’nti. ",
  "sn17.22:1.6": "Dutiyaṃ. "
}
