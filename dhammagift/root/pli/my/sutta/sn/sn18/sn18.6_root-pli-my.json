  "sn18.6:0.1": "",
  "sn18.6:0.2": "",
  "sn18.6:0.3": "6. Saññāsuttaṃ ",
  "sn18.6:1.1": "Sāvatthiyaṃ viharati…pe… ",
  "sn18.6:1.2": "‘‘taṃ kiṃ maññasi, rāhula, ",
  "sn18.6:1.3": "rūpasaññā niccā vā aniccā vā’’ti? ",
  "sn18.6:1.4": "‘‘Aniccā, bhante’’…pe… ",
  "sn18.6:1.5": "‘‘saddasaññā…pe… ",
  "sn18.6:1.6": "gandhasaññā… ",
  "sn18.6:1.7": "rasasaññā… ",
  "sn18.6:1.8": "phoṭṭhabbasaññā… ",
  "sn18.6:1.9": "dhammasaññā niccā vā aniccā vā’’ti? ",
  "sn18.6:1.10": "‘‘Aniccā, bhante’’…pe… ",
  "sn18.6:1.11": "‘‘evaṃ passaṃ, rāhula, sutavā ariyasāvako rūpasaññāyapi nibbindati…pe… saddasaññāyapi nibbindati… gandhasaññāyapi nibbindati… rasasaññāyapi nibbindati… phoṭṭhabbasaññāyapi nibbindati… dhammasaññāyapi nibbindati…pe… ",
  "sn18.6:1.12": "pajānātī’’ti. ",
  "sn18.6:1.13": "Chaṭṭhaṃ. "
}
