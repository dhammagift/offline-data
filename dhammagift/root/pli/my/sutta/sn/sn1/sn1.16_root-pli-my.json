  "sn1.16:0.3": "6. Niddātandīsuttaṃ ",
  "sn1.16:1.1": "‘‘Niddā tandī vijambhitā , ",
  "sn1.16:1.2": "aratī bhattasammado. ",
  "sn1.16:1.3": "Etena nappakāsati, ",
  "sn1.16:1.4": "ariyamaggo idha pāṇina’’nti. ",
  "sn1.16:2.1": "‘‘Niddaṃ tandiṃ vijambhitaṃ, ",
  "sn1.16:2.2": "aratiṃ bhattasammadaṃ; ",
  "sn1.16:2.3": "Vīriyena naṃ paṇāmetvā, ",
  "sn1.16:2.4": "ariyamaggo visujjhatī’’ti. "
}
