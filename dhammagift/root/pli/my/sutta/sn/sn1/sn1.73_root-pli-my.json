  "sn1.73:0.1": "",
  "sn1.73:0.2": "",
  "sn1.73:0.3": "73. 3. Vittasuttaṃ ",
  "sn1.73:1.1": "‘‘Kiṃsūdha vittaṃ purisassa seṭṭhaṃ, ",
  "sn1.73:1.2": "kiṃsu suciṇṇo sukhamāvahati; ",
  "sn1.73:1.3": "Kiṃsu have sādutaraṃ rasānaṃ, ",
  "sn1.73:1.4": "kathaṃjīviṃ jīvitamāhu seṭṭha’’nti. ",
  "sn1.73:2.1": "‘‘Saddhīdha vittaṃ purisassa seṭṭhaṃ, ",
  "sn1.73:2.2": "dhammo suciṇṇo sukhamāvahati; ",
  "sn1.73:2.3": "Saccaṃ have sādutaraṃ rasānaṃ, ",
  "sn1.73:2.4": "paññājīviṃ jīvitamāhu seṭṭha’’nti. "
}
