  "cp33:0.4": "111. 13. Suvaṇṇasāmacariyā ",
  "cp33:1.1": "‘‘Sāmo yadā vane āsiṃ, ",
  "cp33:1.2": "sakkena abhinimmito; ",
  "cp33:1.3": "Pavane sīhabyagghe ca, ",
  "cp33:1.4": "mettāyamupanāmayiṃ. ",
  "cp33:2.1": "112. ‘‘Sīhabyagghehi dīpīhi, ",
  "cp33:2.2": "acchehi mahisehi ca; ",
  "cp33:2.3": "Pasadamigavarāhehi, ",
  "cp33:2.4": "parivāretvā vane vasiṃ. ",
  "cp33:3.1": "113. ‘‘Na maṃ koci uttasati, ",
  "cp33:3.2": "napi bhāyāmi kassaci; ",
  "cp33:3.3": "Mettābalenupatthaddho, ",
  "cp33:3.4": "ramāmi pavane tadā’’ti. ",
  "cp33:4.1": "Suvaṇṇasāmacariyaṃ terasamaṃ. "
}
