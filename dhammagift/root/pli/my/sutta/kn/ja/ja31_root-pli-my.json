  "ja31:0.3": "4. Kulāvakavaggo ",
  "ja31:0.4": "31. 31. Kulāvakajātakaṃ ",
  "ja31:1.1": "Kulāvakā mātali simbalismiṃ, ",
  "ja31:1.2": "īsāmukhena parivajjayassu; ",
  "ja31:1.3": "Kāmaṃ cajāma asuresu pāṇaṃ, ",
  "ja31:1.4": "mā me dijā vikkulavā ahesunti. ",
  "ja31:2.1": "Kulāvakajātakaṃ paṭhamaṃ. "
}
