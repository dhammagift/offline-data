  "ja92:0.4": "92. 92. Mahāsārajātakaṃ ",
  "ja92:1.1": "Ukkaṭṭhe sūramicchanti, ",
  "ja92:1.2": "mantīsu akutūhalaṃ; ",
  "ja92:1.3": "Piyañca annapānamhi, ",
  "ja92:1.4": "atthe jāte ca paṇḍitanti. ",
  "ja92:2.1": "Mahāsārajātakaṃ dutiyaṃ. "
}
