{
  "ja417:0.1": "8. Aṭṭhakanipāto ",
  "ja417:0.2": "",
  "ja417:0.3": "",
  "ja417:0.4": "1. 417. Kaccānijātakaṃ (1) ",
  "ja417:1.1": "Odātavatthā suci allakesā, ",
  "ja417:1.2": "kaccāni kiṃ kumbhimadhissayitvā ; ",
  "ja417:1.3": "Piṭṭhā tilā dhovasi taṇḍulāni, ",
  "ja417:1.4": "tilodano hehiti kissa hetu. ",
  "ja417:2.1": "2. Na kho ayaṃ brāhmaṇa bhojanatthā , ",
  "ja417:2.2": "tilodano hehiti sādhupakko; ",
  "ja417:2.3": "Dhammo mato tassa pahuttamajja , ",
  "ja417:2.4": "ahaṃ karissāmi susānamajjhe. ",
  "ja417:3.1": "3. Anuvicca kaccāni karohi kiccaṃ, ",
  "ja417:3.2": "dhammo mato ko nu taveva saṃsi; ",
  "ja417:3.3": "Sahassanetto atulānubhāvo, ",
  "ja417:3.4": "na miyyatī dhammavaro kadāci. ",
  "ja417:4.1": "4. Daḷhappamāṇaṃ mama ettha brahme, ",
  "ja417:4.2": "dhammo mato natthi mamettha kaṅkhā; ",
  "ja417:4.3": "Ye yeva dāni pāpā bhavanti, ",
  "ja417:4.4": "te teva dāni sukhitā bhavanti. ",
  "ja417:5.1": "5. Suṇisā hi mayhaṃ vañjhā ahosi, ",
  "ja417:5.2": "sā maṃ vadhitvāna vijāyi puttaṃ; ",
  "ja417:5.3": "Sā dāni sabbassa kulassa issarā, ",
  "ja417:5.4": "ahaṃ panamhi apaviddhā ekikā. ",
  "ja417:6.1": "6. Jīvāmi vohaṃ na matohamasmi , ",
  "ja417:6.2": "taveva atthāya idhāgatosmi; ",
  "ja417:6.3": "Yā taṃ vadhitvāna vijāyi puttaṃ, ",
  "ja417:6.4": "sahāva puttena karomi bhasmaṃ. ",
  "ja417:7.1": "7. Evañca te ruccati devarāja, ",
  "ja417:7.2": "mameva atthāya idhāgatosi; ",
  "ja417:7.3": "Ahañca putto suṇisā ca nattā, ",
  "ja417:7.4": "sammodamānā gharamāvasema. ",
  "ja417:8.1": "8. Evañca te ruccati kātiyāni, ",
  "ja417:8.2": "hatāpi santā na jahāsi dhammaṃ; ",
  "ja417:8.3": "Tuvañca putto suṇisā ca nattā, ",
  "ja417:8.4": "sammodamānā gharamāvasetha. ",
  "ja417:9.1": "9. Sā kātiyānī suṇisāya saddhiṃ, ",
  "ja417:9.2": "sammodamānā gharamāvasittha; ",
  "ja417:9.3": "Putto ca nattā ca upaṭṭhahiṃsu, ",
  "ja417:9.4": "devānamindena adhiggahītāti. ",
  "ja417:10.1": "Kaccānijātakaṃ paṭhamaṃ. "
}
