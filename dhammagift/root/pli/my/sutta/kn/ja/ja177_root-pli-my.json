  "ja177:0.4": "53. 177. Tindukajātakaṃ (2-3-7) ",
  "ja177:1.1": "Dhanuhatthakalāpehi, ",
  "ja177:1.2": "nettiṃ savaradhāribhi; ",
  "ja177:1.3": "Samantā parikiṇṇamha, ",
  "ja177:1.4": "kathaṃ mokkho bhavissati. ",
  "ja177:2.1": "54. Appeva bahukiccānaṃ, ",
  "ja177:2.2": "attho jāyetha koci naṃ; ",
  "ja177:2.3": "Atthi rukkhassa acchinnaṃ, ",
  "ja177:2.4": "khajjathaññeva tindukanti. ",
  "ja177:3.1": "Tindukajātakaṃ sattamaṃ. "
}
