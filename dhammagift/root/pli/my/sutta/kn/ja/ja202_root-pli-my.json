  "ja202:0.4": "103. 202. Keḷisīlajātakaṃ (2-6-2) ",
  "ja202:1.1": "Haṃsā koñcā mayūrā ca, ",
  "ja202:1.2": "hatthayo pasadā migā; ",
  "ja202:1.3": "Sabbe sīhassa bhāyanti, ",
  "ja202:1.4": "natthi kāyasmi tulyatā. ",
  "ja202:2.1": "104. Evameva manussesu, ",
  "ja202:2.2": "daharo cepi paññavā; ",
  "ja202:2.3": "So hi tattha mahā hoti, ",
  "ja202:2.4": "neva bālo sarīravāti. ",
  "ja202:3.1": "Keḷisīlajātakaṃ dutiyaṃ. "
}
