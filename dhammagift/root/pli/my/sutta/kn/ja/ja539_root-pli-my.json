  "ja539:72.5": "Pahāya pabbajissāmi, ",
  "ja539:72.6": "taṃ kudāssu bhavissati. ",
  "ja539:73.1": "192. ‘‘Kadāhaṃ rathārohe ca, ",
  "ja539:73.2": "sabbālaṅkārabhūsite; ",
  "ja539:73.3": "Nīlavammadhare sūre, ",
  "ja539:73.4": "cāpahatthe kalāpine ; ",
  "ja539:73.5": "Pahāya pabbajissāmi, ",
  "ja539:73.6": "taṃ kudāssu bhavissati. ",
  "ja539:74.1": "193. ‘‘Kadāhaṃ dhanuggahe ca, ",
  "ja539:74.2": "sabbālaṅkārabhūsite; ",
  "ja539:74.3": "Nīlavammadhare sūre, ",
  "ja539:74.4": "cāpahatthe kalāpine; ",
  "ja539:74.5": "Pahāya pabbajissāmi, ",
  "ja539:74.6": "taṃ kudāssu bhavissati . ",
  "ja539:75.1": "194. ‘‘Kadāhaṃ rājaputte ca, ",
  "ja539:75.2": "sabbālaṅkārabhūsite; ",
  "ja539:75.3": "Citravammadhare sūre, ",
  "ja539:75.4": "kañcanāveḷadhārine; ",
  "ja539:75.5": "Pahāya pabbajissāmi, ",
  "ja539:75.6": "taṃ kudāssu bhavissati. ",
  "ja539:76.1": "195. ‘‘Kadāhaṃ ariyagaṇe ca, ",
  "ja539:76.2": "vatavante alaṅkate; ",
  "ja539:76.3": "Haricandanalittaṅge, ",
  "ja539:76.4": "kāsikuttamadhārine; ",
  "ja539:76.5": "Pahāya pabbajissāmi, ",
  "ja539:76.6": "taṃ kudāssu bhavissati. ",
  "ja539:77.1": "196. ‘‘Kadāhaṃ amaccagaṇe ca, ",
  "ja539:77.2": "sabbālaṅkārabhūsite; ",
  "ja539:77.3": "Pītavammadhare sūre, ",
  "ja539:77.4": "purato gacchamāline ; ",
  "ja539:77.5": "Pahāya pabbajissāmi, ",
  "ja539:77.6": "taṃ kudāssu bhavissati . ",
  "ja539:78.1": "197. ‘‘Kadāhaṃ sattasatā bhariyā, ",
  "ja539:78.2": "sabbālaṅkārabhūsitā; ",
  "ja539:78.3": "Pahāya pabbajissāmi, ",
  "ja539:78.4": "taṃ kudāssu bhavissati. ",
  "ja539:79.1": "198. ‘‘Kadāhaṃ sattasatā bhariyā, ",
  "ja539:79.2": "susaññā tanumajjhimā; ",
  "ja539:79.3": "Pahāya pabbajissāmi, ",
  "ja539:79.4": "taṃ kudāssu bhavissati. ",
  "ja539:80.1": "199. ‘‘Kadāhaṃ sattasatā bhariyā, ",
  "ja539:80.2": "assavā piyabhāṇinī; ",
  "ja539:80.3": "Pahāya pabbajissāmi, ",
  "ja539:80.4": "taṃ kudāssu bhavissati. ",
  "ja539:81.1": "200. ‘‘Kadāhaṃ satapalaṃ kaṃsaṃ, ",
  "ja539:81.2": "sovaṇṇaṃ satarājikaṃ; ",
  "ja539:81.3": "Pahāya pabbajissāmi, ",
  "ja539:81.4": "taṃ kudāssu bhavissati. ",
  "ja539:82.1": "201. ‘‘Kadāssu maṃ hatthigumbā, ",
  "ja539:82.2": "sabbālaṅkārabhūsitā; ",
  "ja539:82.3": "Suvaṇṇakacchā mātaṅgā, ",
  "ja539:82.4": "hemakappanavāsasā. ",
  "ja539:83.1": "202. ‘‘Ārūḷhā gāmaṇīyehi, ",
  "ja539:83.2": "tomaraṅkusapāṇibhi; ",
  "ja539:83.3": "Yantaṃ maṃ nānuyissanti, ",
  "ja539:83.4": "taṃ kudāssu bhavissati. ",
  "ja539:84.1": "203. ‘‘Kadāssu maṃ assagumbā, ",
  "ja539:84.2": "sabbālaṅkārabhūsitā; ",
  "ja539:84.3": "Ājānīyāva jātiyā, ",
  "ja539:84.4": "sindhavā sīghavāhanā. ",
  "ja539:85.1": "204. ‘‘Ārūḷhā gāmaṇīyehi, ",
  "ja539:85.2": "illiyācāpadhāribhi; ",
  "ja539:85.3": "Yantaṃ maṃ nānuyissanti, ",
  "ja539:85.4": "taṃ kudāssu bhavissati. ",
  "ja539:86.1": "205. ‘‘Kadāssu maṃ rathasenī, ",
  "ja539:86.2": "sannaddhā ussitaddhajā; ",
  "ja539:86.3": "Dīpā athopi veyyagghā, ",
  "ja539:86.4": "sabbālaṅkārabhūsitā. ",
  "ja539:87.1": "206. ‘‘Ārūḷhā gāmaṇīyehi, ",
  "ja539:87.2": "cāpahatthehi vammibhi; ",
  "ja539:87.3": "Yantaṃ maṃ nānuyissanti, ",
  "ja539:87.4": "taṃ kudāssu bhavissati. ",
  "ja539:88.1": "207. ‘‘Kadāssu maṃ soṇṇarathā , ",
  "ja539:88.2": "sannaddhā ussitaddhajā; ",
  "ja539:88.3": "Dīpā athopi veyyagghā, ",
  "ja539:88.4": "sabbālaṅkārabhūsitā. ",
  "ja539:89.1": "208. ‘‘Ārūḷhā gāmaṇīyehi, ",
  "ja539:89.2": "cāpahatthehi vammibhi; ",
  "ja539:89.3": "Yantaṃ maṃ nānuyissanti, ",
  "ja539:89.4": "taṃ kudāssu bhavissati. ",
  "ja539:90.1": "209. ‘‘Kadāssu maṃ sajjhurathā, ",
  "ja539:90.2": "sannaddhā ussitaddhajā; ",
  "ja539:90.3": "Dīpā athopi veyyagghā, ",
  "ja539:90.4": "sabbālaṅkārabhūsitā. ",
  "ja539:91.1": "210. ‘‘Ārūḷhā gāmaṇīyehi, ",
  "ja539:91.2": "cāpahatthehi vammibhi; ",
  "ja539:91.3": "Yantaṃ maṃ nānuyissanti, ",
  "ja539:91.4": "taṃ kudāssu bhavissati. ",
  "ja539:92.1": "211. ‘‘Kadāssu maṃ assarathā, ",
  "ja539:92.2": "sannaddhā ussitaddhajā; ",
  "ja539:92.3": "Dīpā athopi veyyagghā, ",
  "ja539:92.4": "sabbālaṅkārabhūsitā. ",
  "ja539:93.1": "212. ‘‘Ārūḷhā gāmaṇīyehi, ",
  "ja539:93.2": "cāpahatthehi vammibhi; ",
  "ja539:93.3": "Yantaṃ maṃ nānuyissanti, ",
  "ja539:93.4": "taṃ kudāssu bhavissati. ",
  "ja539:94.1": "213. ‘‘Kadāssu maṃ oṭṭharathā, ",
  "ja539:94.2": "sannaddhā ussitaddhajā; ",
  "ja539:94.3": "Dīpā athopi veyyagghā, ",
  "ja539:94.4": "sabbālaṅkārabhūsitā. ",
  "ja539:95.1": "214. ‘‘Ārūḷhā gāmaṇīyehi, ",
  "ja539:95.2": "cāpahatthehi vammibhi; ",
  "ja539:95.3": "Yantaṃ maṃ nānuyissanti, ",
  "ja539:95.4": "taṃ kudāssu bhavissati. ",
  "ja539:96.1": "215. ‘‘Kadāssu maṃ goṇarathā, ",
  "ja539:96.2": "sannaddhā ussitaddhajā; ",
  "ja539:96.3": "Dīpā athopi veyyagghā, ",
  "ja539:96.4": "sabbālaṅkārabhūsitā. ",
  "ja539:97.1": "216. ‘‘Ārūḷhā gāmaṇīyehi, ",
  "ja539:97.2": "cāpahatthehi vammibhi; ",
  "ja539:97.3": "Yantaṃ maṃ nānuyissanti, ",
  "ja539:97.4": "taṃ kudāssu bhavissati. ",
  "ja539:98.1": "217. ‘‘Kadāssu maṃ ajarathā, ",
  "ja539:98.2": "sannaddhā ussitaddhajā; ",
  "ja539:98.3": "Dīpā athopi veyyagghā, ",
  "ja539:98.4": "sabbālaṅkārabhūsitā. ",
  "ja539:99.1": "218. ‘‘Ārūḷhā gāmaṇīyehi, ",
  "ja539:99.2": "cāpahatthehi vammibhi; ",
  "ja539:99.3": "Yantaṃ maṃ nānuyissanti, ",
  "ja539:99.4": "taṃ kudāssu bhavissati. ",
  "ja539:100.1": "219. ‘‘Kadāssu maṃ meṇḍarathā, ",
  "ja539:100.2": "sannaddhā ussitaddhajā; ",
  "ja539:100.3": "Dīpā athopi veyyagghā, ",
  "ja539:100.4": "sabbālaṅkārabhūsitā. ",
  "ja539:101.1": "220. ‘‘Ārūḷhā gāmaṇīyehi, ",
  "ja539:101.2": "cāpahatthehi vammibhi; ",
  "ja539:101.3": "Yantaṃ maṃ nānuyissanti, ",
  "ja539:101.4": "taṃ kudāssu bhavissati. ",
  "ja539:102.1": "221. ‘‘Kadāssu maṃ migarathā, ",
  "ja539:102.2": "sannaddhā ussitaddhajā; ",
  "ja539:102.3": "Dīpā athopi veyyagghā, ",
  "ja539:102.4": "sabbālaṅkārabhūsitā. ",
  "ja539:103.1": "222. ‘‘Ārūḷhā gāmaṇīyehi, ",
  "ja539:103.2": "cāpahatthehi vammibhi; ",
  "ja539:103.3": "Yantaṃ maṃ nānuyissanti, ",
  "ja539:103.4": "taṃ kudāssu bhavissati. ",
  "ja539:104.1": "223. ‘‘Kadāssu maṃ hatthārohā, ",
  "ja539:104.2": "sabbālaṅkārabhūsitā; ",
  "ja539:104.3": "Nīlavammadharā sūrā, ",
  "ja539:104.4": "tomaraṅkusapāṇino; ",
  "ja539:104.5": "Yantaṃ maṃ nānuyissanti, ",
  "ja539:104.6": "taṃ kudāssu bhavissati. ",
  "ja539:105.1": "224. ‘‘Kadāssu maṃ assārohā, ",
  "ja539:105.2": "sabbālaṅkārabhūsitā; ",
  "ja539:105.3": "Nīlavammadharā sūrā, ",
  "ja539:105.4": "illiyācāpadhārino; ",
  "ja539:105.5": "Yantaṃ maṃ nānuyissanti, ",
  "ja539:105.6": "taṃ kudāssu bhavissati. ",
  "ja539:106.1": "225. ‘‘Kadāssu maṃ rathārohā, ",
  "ja539:106.2": "sabbālaṅkārabhūsitā; ",
  "ja539:106.3": "Nīlavammadharā sūrā, ",
  "ja539:106.4": "cāpahatthā kalāpino; ",
  "ja539:106.5": "Yantaṃ maṃ nānuyissanti, ",
  "ja539:106.6": "taṃ kudāssu bhavissati. ",
  "ja539:107.1": "226. ‘‘Kadāssu maṃ dhanuggahā, ",
  "ja539:107.2": "sabbālaṅkārabhūsitā; ",
  "ja539:107.3": "Nīlavammadharā sūrā, ",
  "ja539:107.4": "cāpahatthā kalāpino; ",
  "ja539:107.5": "Yantaṃ maṃ nānuyissanti, ",
  "ja539:107.6": "taṃ kudāssu bhavissati. ",
  "ja539:108.1": "227. ‘‘Kadāssu maṃ rājaputtā, ",
  "ja539:108.2": "sabbālaṅkārabhūsitā; ",
  "ja539:108.3": "Citravammadharā sūrā, ",
  "ja539:108.4": "kañcanāveḷadhārino; ",
  "ja539:108.5": "Yantaṃ maṃ nānuyissanti, ",
  "ja539:108.6": "taṃ kudāssu bhavissati. ",
  "ja539:109.1": "228. ‘‘Kadāssu maṃ ariyagaṇā, ",
  "ja539:109.2": "vatavantā alaṅkatā; ",
  "ja539:109.3": "Haricandanalittaṅgā, ",
  "ja539:109.4": "kāsikuttamadhārino; ",
  "ja539:109.5": "Yantaṃ maṃ nānuyissanti, ",
  "ja539:109.6": "taṃ kudāssu bhavissati. ",
  "ja539:110.1": "229. ‘‘Kadāssu maṃ amaccagaṇā, ",
  "ja539:110.2": "sabbālaṅkārabhūsitā; ",
  "ja539:110.3": "Pītavammadharā sūrā, ",
  "ja539:110.4": "purato gacchamālino ; ",
  "ja539:110.5": "Yantaṃ maṃ nānuyissanti, ",
  "ja539:110.6": "taṃ kudāssu bhavissati. ",
  "ja539:111.1": "230. ‘‘Kadāssu maṃ sattasatā bhariyā, ",
  "ja539:111.2": "sabbālaṅkārabhūsitā; ",
  "ja539:111.3": "Yantaṃ maṃ nānuyissanti, ",
  "ja539:111.4": "taṃ kudāssu bhavissati. ",
  "ja539:112.1": "231. ‘‘Kadāssu maṃ sattasatā bhariyā, ",
  "ja539:112.2": "susaññā tanumajjhimā; ",
  "ja539:112.3": "Yantaṃ maṃ nānuyissanti, ",
  "ja539:112.4": "taṃ kudāssu bhavissati. ",
  "ja539:113.1": "232. ‘‘Kadāssu maṃ sattasatā bhariyā, ",
  "ja539:113.2": "assavā piyabhāṇinī; ",
  "ja539:113.3": "Yantaṃ maṃ nānuyissanti, ",
  "ja539:113.4": "taṃ kudāssu bhavissati. ",
  "ja539:114.1": "233. ‘‘Kadāhaṃ pattaṃ gahetvāna, ",
  "ja539:114.2": "muṇḍo saṅghāṭipāruto; ",
  "ja539:114.3": "Piṇḍikāya carissāmi, ",
  "ja539:114.4": "taṃ kudāssu bhavissati. ",
  "ja539:115.1": "234. ‘‘Kadāhaṃ paṃsukūlānaṃ, ",
  "ja539:115.2": "ujjhitānaṃ mahāpathe; ",
  "ja539:115.3": "Saṅghāṭiṃ dhārayissāmi, ",
  "ja539:115.4": "taṃ kudāssu bhavissati. ",
  "ja539:116.1": "235. ‘‘Kadāhaṃ sattāhasammeghe , ",
  "ja539:116.2": "ovaṭṭho allacīvaro; ",
  "ja539:116.3": "Piṇḍikāya carissāmi, ",
  "ja539:116.4": "taṃ kudāssu bhavissati. ",
  "ja539:117.1": "236. ‘‘Kadāhaṃ sabbattha gantvā , ",
  "ja539:117.2": "rukkhā rukkhaṃ vanā vanaṃ; ",
  "ja539:117.3": "Anapekkho gamissāmi, ",
  "ja539:117.4": "taṃ kudāssu bhavissati. ",
  "ja539:118.1": "237. ‘‘Kadāhaṃ giriduggesu, ",
  "ja539:118.2": "pahīnabhayabheravo; ",
  "ja539:118.3": "Adutiyo gamissāmi , ",
  "ja539:118.4": "taṃ kudāssu bhavissati. ",
  "ja539:119.1": "238. ‘‘Kadāhaṃ vīṇaṃ varujjako , ",
  "ja539:119.2": "sattatantiṃ manoramaṃ; ",
  "ja539:119.3": "Cittaṃ ujuṃ karissāmi, ",
  "ja539:119.4": "taṃ kudāssu bhavissati. ",
  "ja539:120.1": "239. ‘‘Kadāhaṃ rathakārova, ",
  "ja539:120.2": "parikantaṃ upāhanaṃ; ",
  "ja539:120.3": "Kāmasaññojane checchaṃ , ",
  "ja539:120.4": "ye dibbe ye ca mānuse’’. ",
  "ja539:121.1": "240. ‘‘Tā ca sattasatā bhariyā, ",
  "ja539:121.2": "sabbālaṅkārabhūsitā; ",
  "ja539:121.3": "Bāhā paggayha pakkanduṃ, ",
  "ja539:121.4": "kasmā no vijahissasi. ",
  "ja539:122.1": "241. ‘‘Tā ca sattasatā bhariyā, ",
  "ja539:122.2": "susaññā tanumajjhimā; ",
  "ja539:122.3": "Bāhā paggayha pakkanduṃ, ",
  "ja539:122.4": "kasmā no vijahissasi. ",
  "ja539:123.1": "242. ‘‘Tā ca sattasatā bhariyā, ",
  "ja539:123.2": "assavā piyabhāṇinī; ",
  "ja539:123.3": "Bāhā paggayha pakkanduṃ, ",
  "ja539:123.4": "kasmā no vijahissasi. ",
  "ja539:124.1": "243. ‘‘Tā ca sattasatā bhariyā, ",
  "ja539:124.2": "sabbālaṅkārabhūsitā; ",
  "ja539:124.3": "Hitvā sampaddavī rājā, ",
  "ja539:124.4": "pabbajjāya purakkhato. ",
  "ja539:125.1": "244. ‘‘Tā ca sattasatā bhariyā, ",
  "ja539:125.2": "susaññā tanumajjhimā; ",
  "ja539:125.3": "Hitvā sampaddavī rājā, ",
  "ja539:125.4": "pabbajjāya purakkhato. ",
  "ja539:126.1": "245. ‘‘Tā ca sattasatā bhariyā, ",
  "ja539:126.2": "assavā piyabhāṇinī; ",
  "ja539:126.3": "Hitvā sampaddavī rājā, ",
  "ja539:126.4": "pabbajjāya purakkhato’’. ",
  "ja539:127.1": "246. ‘‘Hitvā satapalaṃ kaṃsaṃ, ",
  "ja539:127.2": "sovaṇṇaṃ satarājikaṃ; ",
  "ja539:127.3": "Aggahī mattikaṃ pattaṃ, ",
  "ja539:127.4": "taṃ dutiyābhisecanaṃ’’. ",
  "ja539:128.1": "247. ‘‘Bhesmā aggisamā jālā, ",
  "ja539:128.2": "kosā ḍayhanti bhāgaso; ",
  "ja539:128.3": "Rajataṃ jātarūpañca, ",
  "ja539:128.4": "muttā veḷuriyā bahū. ",
  "ja539:129.1": "248. ‘‘Maṇayo saṅkhamuttā ca, ",
  "ja539:129.2": "vatthikaṃ haricandanaṃ; ",
  "ja539:129.3": "Ajinaṃ daṇḍabhaṇḍañca, ",
  "ja539:129.4": "lohaṃ kāḷāyasaṃ bahū; ",
  "ja539:129.5": "Ehi rāja nivattassu, ",
  "ja539:129.6": "mā tetaṃ vinasā dhanaṃ’’ . ",
  "ja539:130.1": "249. ‘‘Susukhaṃ vata jīvāma, ",
  "ja539:130.2": "yesaṃ no natthi kiñcanaṃ; ",
  "ja539:130.3": "Mithilāya dayhamānāya, ",
  "ja539:130.4": "na me kiñci adayhatha’’. ",
  "ja539:131.1": "250. ‘‘Aṭaviyo samuppannā, ",
  "ja539:131.2": "raṭṭhaṃ viddhaṃsayanti taṃ; ",
  "ja539:131.3": "Ehi rāja nivattassu, ",
  "ja539:131.4": "mā raṭṭhaṃ vinasā idaṃ’’. ",
  "ja539:132.1": "251. ‘‘Susukhaṃ vata jīvāma, ",
  "ja539:132.2": "yesaṃ no natthi kiñcanaṃ; ",
  "ja539:132.3": "Raṭṭhe vilumpamānamhi, ",
  "ja539:132.4": "na me kiñci ahīratha. ",
  "ja539:133.1": "252. ‘‘Susukhaṃ vata jīvāma, ",
  "ja539:133.2": "yesaṃ no natthi kiñcanaṃ; ",
  "ja539:133.3": "Pītibhakkhā bhavissāma, ",
  "ja539:133.4": "devā ābhassarā yathā’’. ",
  "ja539:134.1": "253. ‘‘Kimheso mahato ghoso, ",
  "ja539:134.2": "kā nu gāmeva kīḷiyā ; ",
  "ja539:134.3": "Samaṇa teva pucchāma, ",
  "ja539:134.4": "kattheso abhisaṭo jano’’. ",
  "ja539:135.1": "254. ‘‘Mamaṃ ohāya gacchantaṃ, ",
  "ja539:135.2": "ettheso abhisaṭo jano; ",
  "ja539:135.3": "Sīmātikkamanaṃ yantaṃ, ",
  "ja539:135.4": "munimonassa pattiyā; ",
  "ja539:135.5": "Missaṃ nandīhi gacchantaṃ, ",
  "ja539:135.6": "kiṃ jānamanupucchasi’’. ",
  "ja539:136.1": "255. ‘‘Māssu tiṇṇo amaññittha , ",
  "ja539:136.2": "sarīraṃ dhārayaṃ imaṃ; ",
  "ja539:136.3": "Atīraṇeyya yamidaṃ , ",
  "ja539:136.4": "bahū hi paripanthayo’’. ",
  "ja539:137.1": "256. ‘‘Ko nu me paripanthassa, ",
  "ja539:137.2": "mamaṃ evaṃvihārino; ",
  "ja539:137.3": "Yo neva diṭṭhe nādiṭṭhe, ",
  "ja539:137.4": "kāmānamabhipatthaye’’. ",
  "ja539:138.1": "257. ‘‘Niddā tandī vijambhitā, ",
  "ja539:138.2": "aratī bhattasammado; ",
  "ja539:138.3": "Āvasanti sarīraṭṭhā, ",
  "ja539:138.4": "bahū hi paripanthayo’’. ",
  "ja539:139.1": "258. ‘‘Kalyāṇaṃ vata maṃ bhavaṃ, ",
  "ja539:139.2": "brāhmaṇa manusāsati ; ",
  "ja539:139.3": "Brāhmaṇa teva pucchāmi, ",
  "ja539:139.4": "ko nu tvamasi mārisa’’. ",
  "ja539:140.1": "259. ‘‘Nārado iti me nāmaṃ , ",
  "ja539:140.2": "kassapo iti maṃ vidū; ",
  "ja539:140.3": "Bhoto sakāsamāgacchiṃ, ",
  "ja539:140.4": "sādhu sabbhi samāgamo. ",
  "ja539:141.1": "260. ‘‘Tassa te sabbo ānando, ",
  "ja539:141.2": "vihāro upavattatu; ",
  "ja539:141.3": "Yaṃ ūnaṃ taṃ paripūrehi, ",
  "ja539:141.4": "khantiyā upasamena ca. ",
  "ja539:142.1": "261. ‘‘Pasāraya sannatañca, ",
  "ja539:142.2": "unnatañca pasāraya ; ",
  "ja539:142.3": "Kammaṃ vijjañca dhammañca, ",
  "ja539:142.4": "sakkatvāna paribbaja’’. ",
  "ja539:143.1": "262. ‘‘Bahū hatthī ca asse ca, ",
  "ja539:143.2": "nagare janapadāni ca; ",
  "ja539:143.3": "Hitvā janaka pabbajito, ",
  "ja539:143.4": "kapāle ratimajjhagā. ",
  "ja539:144.1": "263. ‘‘Kacci nu te jānapadā, ",
  "ja539:144.2": "mittāmaccā ca ñātakā; ",
  "ja539:144.3": "Dubbhimakaṃsu janaka, ",
  "ja539:144.4": "kasmā te taṃ aruccatha’’. ",
  "ja539:145.1": "264. ‘‘Na migājina jātucche , ",
  "ja539:145.2": "ahaṃ kañci kudācanaṃ; ",
  "ja539:145.3": "Adhammena jine ñātiṃ, ",
  "ja539:145.4": "na cāpi ñātayo mamaṃ. ",
  "ja539:146.1": "265. ‘‘Disvāna lokavattantaṃ, ",
  "ja539:146.2": "khajjantaṃ kaddamīkataṃ; ",
  "ja539:146.3": "Haññare bajjhare cettha, ",
  "ja539:146.4": "yattha sanno puthujjano; ",
  "ja539:146.5": "Etāhaṃ upamaṃ katvā, ",
  "ja539:146.6": "bhikkhakosmi migājina’’. ",
  "ja539:147.1": "266. ‘‘Ko nu te bhagavā satthā, ",
  "ja539:147.2": "kassetaṃ vacanaṃ suci; ",
  "ja539:147.3": "Na hi kappaṃ vā vijjaṃ vā, ",
  "ja539:147.4": "paccakkhāya rathesabha; ",
  "ja539:147.5": "Samaṇaṃ āhu vattantaṃ, ",
  "ja539:147.6": "yathā dukkhassatikkamo’’. ",
  "ja539:148.1": "267. ‘‘Na migājina jātucche, ",
  "ja539:148.2": "ahaṃ kañci kudācanaṃ; ",
  "ja539:148.3": "Samaṇaṃ brāhmaṇaṃ vāpi, ",
  "ja539:148.4": "sakkatvā anupāvisiṃ’’. ",
  "ja539:149.1": "268. ‘‘Mahatā cānubhāvena, ",
  "ja539:149.2": "gacchanto siriyā jalaṃ; ",
  "ja539:149.3": "Gīyamānesu gītesu, ",
  "ja539:149.4": "vajjamānesu vaggusu. ",
  "ja539:150.1": "269. ‘‘Tūriyatāḷasaṅghuṭṭhe , ",
  "ja539:150.2": "sammatālasamāhite; ",
  "ja539:150.3": "Sa migājina maddakkhiṃ, ",
  "ja539:150.4": "phaliṃ ambaṃ tirocchadaṃ; ",
  "ja539:150.5": "Haññamānaṃ manussehi, ",
  "ja539:150.6": "phalakāmehi jantubhi. ",
  "ja539:151.1": "270. ‘‘So khohaṃ taṃ siriṃ hitvā, ",
  "ja539:151.2": "orohitvā migājina; ",
  "ja539:151.3": "Mūlaṃ ambassupāgacchiṃ, ",
  "ja539:151.4": "phalino nipphalassa ca. ",
  "ja539:152.1": "271. ‘‘Phaliṃ ambaṃ hataṃ disvā, ",
  "ja539:152.2": "viddhaṃstaṃ vinaḷīkataṃ; ",
  "ja539:152.3": "Athekaṃ itaraṃ ambaṃ, ",
  "ja539:152.4": "nīlobhāsaṃ manoramaṃ. ",
  "ja539:153.1": "272. ‘‘Evameva nūnamhepi , ",
  "ja539:153.2": "issare bahukaṇṭake; ",
  "ja539:153.3": "Amittā no vadhissanti, ",
  "ja539:153.4": "yathā ambo phalī hato. ",
  "ja539:154.1": "273. ‘‘Ajinamhi haññate dīpi, ",
  "ja539:154.2": "nāgo dantehi haññate; ",
  "ja539:154.3": "Dhanamhi dhanino hanti, ",
  "ja539:154.4": "aniketamasanthavaṃ; ",
  "ja539:154.5": "Phalī ambo aphalo ca, ",
  "ja539:154.6": "te satthāro ubho mama’’. ",
  "ja539:155.1": "274. ‘‘Sabbo jano pabyādhito, ",
  "ja539:155.2": "rājā pabbajito iti; ",
  "ja539:155.3": "Hatthārohā anīkaṭṭhā, ",
  "ja539:155.4": "rathikā pattikārakā. ",
  "ja539:156.1": "275. ‘‘Assāsayitvā janataṃ, ",
  "ja539:156.2": "ṭhapayitvā paṭicchadaṃ; ",
  "ja539:156.3": "Puttaṃ rajje ṭhapetvāna, ",
  "ja539:156.4": "atha pacchā pabbajissasi’’. ",
  "ja539:157.1": "276. ‘‘Cattā mayā jānapadā, ",
  "ja539:157.2": "mittāmaccā ca ñātakā; ",
  "ja539:157.3": "Santi puttā videhānaṃ, ",
  "ja539:157.4": "dīghāvu raṭṭhavaḍḍhano; ",
  "ja539:157.5": "Te rajjaṃ kārayissanti, ",
  "ja539:157.6": "mithilāyaṃ pajāpati’’. ",
  "ja539:158.1": "277. ‘‘Ehi taṃ anusikkhāmi, ",
  "ja539:158.2": "yaṃ vākyaṃ mama ruccati; ",
  "ja539:158.3": "Rajjaṃ tuvaṃ kārayasi , ",
  "ja539:158.4": "pāpaṃ duccaritaṃ bahuṃ; ",
  "ja539:158.5": "Kāyena vācā manasā, ",
  "ja539:158.6": "yena gacchasi duggatiṃ. ",
  "ja539:159.1": "278. ‘‘Paradinnakena paraniṭṭhitena, ",
  "ja539:159.2": "piṇḍena yāpehi sa dhīradhammo’’. ",
  "ja539:160.1": "279. ‘‘Yopi catutthe bhattakāle na bhuñje, ",
  "ja539:160.2": "ajuṭṭhamārīva khudāya miyye; ",
  "ja539:160.3": "Na tveva piṇḍaṃ luḷitaṃ anariyaṃ, ",
  "ja539:160.4": "kulaputtarūpo sappuriso na seve; ",
  "ja539:160.5": "Tayidaṃ na sādhu tayidaṃ na suṭṭhu, ",
  "ja539:160.6": "sunakhucchiṭṭhakaṃ janaka bhuñjase tuvaṃ’’. ",
  "ja539:161.1": "280. ‘‘Na cāpi me sīvali so abhakkho, ",
  "ja539:161.2": "yaṃ hoti cattaṃ gihino sunassa vā; ",
  "ja539:161.3": "Ye keci bhogā idha dhammaladdhā, ",
  "ja539:161.4": "sabbo so bhakkho anavayoti vutto’’. ",
  "ja539:162.1": "281. ‘‘Kumārike upaseniye, ",
  "ja539:162.2": "niccaṃ niggaḷamaṇḍite; ",
  "ja539:162.3": "Kasmā te eko bhujo janati, ",
  "ja539:162.4": "eko te na janatī bhujo’’. ",
  "ja539:163.1": "282. ‘‘Imasmiṃ me samaṇa hatthe, ",
  "ja539:163.2": "paṭimukkā dunīvarā ; ",
  "ja539:163.3": "Saṅghātā jāyate saddo, ",
  "ja539:163.4": "dutiyasseva sā gati. ",
  "ja539:164.1": "283. ‘‘Imasmiṃ me samaṇa hatthe, ",
  "ja539:164.2": "paṭimukko ekanīvaro ; ",
  "ja539:164.3": "So adutiyo na janati, ",
  "ja539:164.4": "munibhūtova tiṭṭhati. ",
  "ja539:165.1": "284. ‘‘Vivādappatto dutiyo, ",
  "ja539:165.2": "keneko vivadissati; ",
  "ja539:165.3": "Tassa te saggakāmassa, ",
  "ja539:165.4": "ekattamuparocataṃ’’. ",
  "ja539:166.1": "285. ‘‘Suṇāsi sīvali kathā , ",
  "ja539:166.2": "kumāriyā paveditā; ",
  "ja539:166.3": "Pesiyā maṃ garahittho, ",
  "ja539:166.4": "dutiyasseva sā gati. ",
  "ja539:167.1": "286. ‘‘Ayaṃ dvedhāpatho bhadde, ",
  "ja539:167.2": "anuciṇṇo pathāvihi; ",
  "ja539:167.3": "Tesaṃ tvaṃ ekaṃ gaṇhāhi, ",
  "ja539:167.4": "ahamekaṃ punāparaṃ. ",
  "ja539:168.1": "287. ‘‘Māvaca maṃ tvaṃ pati meti, ",
  "ja539:168.2": "nāhaṃ bhariyāti vā puna’’; ",
  "ja539:168.3": "‘‘Imameva kathayantā, ",
  "ja539:168.4": "thūṇaṃ nagarupāgamuṃ. ",
  "ja539:169.1": "288. ‘‘Koṭṭhake usukārassa, ",
  "ja539:169.2": "bhattakāle upaṭṭhite; ",
  "ja539:169.3": "Tatrā ca so usukāro, ",
  "ja539:169.4": "(ekaṃ daṇḍaṃ ujuṃ kataṃ;) ",
  "ja539:169.5": "Ekañca cakkhuṃ niggayha, ",
  "ja539:169.6": "jimhamekena pekkhati’’. ",
  "ja539:170.1": "289. ‘‘Evaṃ no sādhu passasi, ",
  "ja539:170.2": "usukāra suṇohi me; ",
  "ja539:170.3": "Yadekaṃ cakkhuṃ niggayha, ",
  "ja539:170.4": "jimhamekena pekkhasi’’. ",
  "ja539:171.1": "290. ‘‘Dvīhi samaṇa cakkhūhi, ",
  "ja539:171.2": "visālaṃ viya khāyati; ",
  "ja539:171.3": "Asampatvā paramaṃ liṅgaṃ, ",
  "ja539:171.4": "nujubhāvāya kappati. ",
  "ja539:172.1": "291. ‘‘Ekañca cakkhuṃ niggayha, ",
  "ja539:172.2": "jimhamekena pekkhato; ",
  "ja539:172.3": "Sampatvā paramaṃ liṅgaṃ, ",
  "ja539:172.4": "ujubhāvāya kappati. ",
  "ja539:173.1": "292. ‘‘Vivādappatto dutiyo, ",
  "ja539:173.2": "keneko vivadissati; ",
  "ja539:173.3": "Tassa te saggakāmassa, ",
  "ja539:173.4": "ekattamuparocataṃ’’. ",
  "ja539:174.1": "293. ‘‘Suṇāsi sīvali kathā , ",
  "ja539:174.2": "usukārena veditā; ",
  "ja539:174.3": "Pesiyā maṃ garahittho, ",
  "ja539:174.4": "dutiyasseva sā gati. ",
  "ja539:175.1": "294. ‘‘Ayaṃ dvedhāpatho bhadde, ",
  "ja539:175.2": "anuciṇṇo pathāvihi; ",
  "ja539:175.3": "Tesaṃ tvaṃ ekaṃ gaṇhāhi, ",
  "ja539:175.4": "ahamekaṃ punāparaṃ. ",
  "ja539:176.1": "295. ‘‘Māvaca maṃ tvaṃ pati meti, ",
  "ja539:176.2": "nāhaṃ bhariyāti vā puna’’; ",
  "ja539:176.3": "‘‘Muñjāvesikā pavāḷhā, ",
  "ja539:176.4": "ekā vihara sīvalī’’ti. ",
  "ja539:177.1": "Mahājanakajātakaṃ dutiyaṃ. "
}
