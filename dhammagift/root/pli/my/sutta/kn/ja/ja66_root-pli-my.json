  "ja66:0.4": "66. Mudulakkhaṇajātakaṃ 66. ",
  "ja66:1.1": "Ekā icchā pure āsi, ",
  "ja66:1.2": "aladdhā mudulakkhaṇaṃ; ",
  "ja66:1.3": "Yato laddhā aḷārakkhī, ",
  "ja66:1.4": "icchā icchaṃ vijāyathāti. ",
  "ja66:2.1": "Mudulakkhaṇajātakaṃ chaṭṭhaṃ. "
}
