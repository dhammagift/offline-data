  "ja198:0.4": "95. 198. Rādhajātakaṃ (2-5-8) ",
  "ja198:1.1": "Pavāsā āgato tāta, ",
  "ja198:1.2": "idāni nacirāgato; ",
  "ja198:1.3": "Kaccinnu tāta te mātā, ",
  "ja198:1.4": "na aññamupasevati. ",
  "ja198:2.1": "96. Na kho panetaṃ subhaṇaṃ, ",
  "ja198:2.2": "giraṃ saccupasaṃhitaṃ; ",
  "ja198:2.3": "Sayetha poṭṭhapādova, ",
  "ja198:2.4": "mummure upakūthitoti . ",
  "ja198:3.1": "Rādhajātakaṃ aṭṭhamaṃ. "
}
