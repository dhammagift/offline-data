  "ja32:0.4": "32. 32. Naccajātakaṃ ",
  "ja32:1.1": "Rudaṃ manuññaṃ rucirā ca piṭṭhi, ",
  "ja32:1.2": "veḷuriyavaṇṇūpanibhā ca gīvā; ",
  "ja32:1.3": "Byāmamattāni ca pekhuṇāni, ",
  "ja32:1.4": "naccena te dhītaraṃ no dadāmīti. ",
  "ja32:2.1": "Naccajātakaṃ dutiyaṃ. "
}
