  "ja132:0.4": "132. 132. Bhīrukajātakaṃ ",
  "ja132:1.1": "Kusalūpadese dhitiyā daḷhāya ca, ",
  "ja132:1.2": "anivattitattābhayabhīrutāya ca; ",
  "ja132:1.3": "Na rakkhasīnaṃ vasamāgamimhase, ",
  "ja132:1.4": "sa sotthibhāvo mahatā bhayena meti. ",
  "ja132:2.1": "Bhīruka jātakaṃ dutiyaṃ. "
}
