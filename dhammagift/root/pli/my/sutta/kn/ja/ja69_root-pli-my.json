  "ja69:0.4": "69. 69. Visavantajātakaṃ ",
  "ja69:1.1": "Dhiratthu taṃ visaṃ vantaṃ, ",
  "ja69:1.2": "yamahaṃ jīvitakāraṇā; ",
  "ja69:1.3": "Vantaṃ paccāvamissāmi , ",
  "ja69:1.4": "mataṃ me jīvitā varanti. ",
  "ja69:2.1": "Visavantajātakaṃ navamaṃ. "
}
