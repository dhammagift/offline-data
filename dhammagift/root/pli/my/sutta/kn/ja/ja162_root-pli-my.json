  "ja162:0.4": "162. Santhavajātakaṃ (2-2-2) 23. ",
  "ja162:1.1": "Na santhavasmā paramatthi pāpiyo, ",
  "ja162:1.2": "yo santhavo kāpurisena hoti; ",
  "ja162:1.3": "Santappito sappinā pāyasena , ",
  "ja162:1.4": "kicchākataṃ paṇṇakuṭiṃ adayhi . ",
  "ja162:2.1": "24. Na santhavasmā paramatthi seyyo, ",
  "ja162:2.2": "yo santhavo sappurisena hoti; ",
  "ja162:2.3": "Sīhassa byagghassa ca dīpino ca, ",
  "ja162:2.4": "sāmā mukhaṃ lehati santhavenāti. ",
  "ja162:3.1": "Santhavajātakaṃ dutiyaṃ. "
}
