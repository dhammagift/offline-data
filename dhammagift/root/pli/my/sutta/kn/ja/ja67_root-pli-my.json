  "ja67:0.4": "67. Ucchaṅgajātakaṃ 67. ",
  "ja67:1.1": "Ucchaṅge deva me putto, ",
  "ja67:1.2": "pathe dhāvantiyā pati; ",
  "ja67:1.3": "Tañca desaṃ na passāmi, ",
  "ja67:1.4": "yato sodariyamānayeti . ",
  "ja67:2.1": "Ucchaṅgajātakaṃ sattamaṃ. "
}
