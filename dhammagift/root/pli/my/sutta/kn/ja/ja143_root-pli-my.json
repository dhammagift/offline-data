  "ja143:0.4": "143. 143. Virocajātakaṃ ",
  "ja143:1.1": "Lasī ca te nipphalitā, ",
  "ja143:1.2": "matthako ca padālito ; ",
  "ja143:1.3": "Sabbā te phāsukā bhaggā, ",
  "ja143:1.4": "ajja kho tvaṃ virocasīti. ",
  "ja143:2.1": "Virocajātakaṃ tatiyaṃ. "
}
