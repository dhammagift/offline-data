  "ja179:0.3": "",
  "ja179:0.4": "179. Satadhammajātakaṃ (2-3-9) 57. ",
  "ja179:1.1": "Tañca appañca ucchiṭṭhaṃ, ",
  "ja179:1.2": "tañca kicchena no adā; ",
  "ja179:1.3": "Sohaṃ brāhmaṇajātiko, ",
  "ja179:1.4": "yaṃ bhuttaṃ tampi uggataṃ. ",
  "ja179:2.1": "58. Evaṃ dhammaṃ niraṃkatvā , ",
  "ja179:2.2": "yo adhammena jīvati; ",
  "ja179:2.3": "Satadhammova lābhena, ",
  "ja179:2.4": "laddhenapi na nandatīti. ",
  "ja179:3.1": "Satadhammajātakaṃ navamaṃ. "
}
