  "ja245:0.4": "190. 245. Mūlapariyāyajātakaṃ (2-10-5) ",
  "ja245:1.1": "Kālo ghasati bhūtāni, ",
  "ja245:1.2": "sabbāneva sahattanā; ",
  "ja245:1.3": "Yo ca kālaghaso bhūto, ",
  "ja245:1.4": "sa bhūtapacaniṃ paci. ",
  "ja245:2.1": "191. Bahūni narasīsāni, ",
  "ja245:2.2": "lomasāni brahāni ca; ",
  "ja245:2.3": "Gīvāsu paṭimukkāni, ",
  "ja245:2.4": "kocidevettha kaṇṇavāti. ",
  "ja245:3.1": "Mūlapariyāyajātakaṃ pañcamaṃ. "
}
