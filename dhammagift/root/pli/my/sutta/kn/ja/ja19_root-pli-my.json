  "ja19:0.4": "19. 19. Āyācitabhattajātakaṃ ",
  "ja19:1.1": "Sace mucce pecca mucce , ",
  "ja19:1.2": "muccamāno hi bajjhati; ",
  "ja19:1.3": "Na hevaṃ dhīrā muccanti, ",
  "ja19:1.4": "mutti bālassa bandhananti. ",
  "ja19:2.1": "Āyācitabhattajātakaṃ navamaṃ. "
}
