  "ja77:0.4": "77. Mahāsupinajātakaṃ 77. ",
  "ja77:1.1": "Usabhā rukkhā gāviyo gavā ca, ",
  "ja77:1.2": "asso kaṃso siṅgālī ca kumbho; ",
  "ja77:1.3": "Pokkharaṇī ca apākacandanaṃ, ",
  "ja77:1.4": "lābūni sīdanti silā plavanti. ",
  "ja77:2.1": "Maṇḍūkiyo kaṇhasappe gilanti, ",
  "ja77:2.2": "kākaṃ supaṇṇā parivārayanti; ",
  "ja77:2.3": "Tasā vakā eḷakānaṃ bhayāhi, ",
  "ja77:2.4": "vipariyāso vattati nayidha matthīti. ",
  "ja77:3.1": "Mahāsupinajātakaṃ sattamaṃ. "
}
