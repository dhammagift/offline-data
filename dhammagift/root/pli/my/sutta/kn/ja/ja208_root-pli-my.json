  "ja208:0.4": "115. 208. Susumārajātakaṃ (2-6-8) ",
  "ja208:1.1": "Alaṃ metehi ambehi, ",
  "ja208:1.2": "jambūhi panasehi ca; ",
  "ja208:1.3": "Yāni pāraṃ samuddassa, ",
  "ja208:1.4": "varaṃ mayhaṃ udumbaro. ",
  "ja208:2.1": "116. Mahatī vata te bondi, ",
  "ja208:2.2": "na ca paññā tadūpikā; ",
  "ja208:2.3": "Susumāra vañcito mesi, ",
  "ja208:2.4": "gaccha dāni yathāsukhanti. ",
  "ja208:3.1": "Susumārajātakaṃ aṭṭhamaṃ. "
}
