  "ja391:0.4": "108. 391. Vijjādharajātakaṃ (6-2-6) ",
  "ja391:1.1": "Dubbaṇṇarūpaṃ tuvamariyavaṇṇī, ",
  "ja391:1.2": "purakkhatvā pañjaliko namassasi; ",
  "ja391:1.3": "Seyyo nu te so udavā sarikkho, ",
  "ja391:1.4": "nāmaṃ parassattano cāpi brūhi. ",
  "ja391:2.1": "109. Na nāmagottaṃ gaṇhanti rāja, ",
  "ja391:2.2": "sammaggatānujjugatāna devā; ",
  "ja391:2.3": "Ahañca te nāmadheyyaṃ vadāmi, ",
  "ja391:2.4": "sakkohamasmī tidasānamindo. ",
  "ja391:3.1": "110. Yo disvā bhikkhuṃ caraṇūpapannaṃ, ",
  "ja391:3.2": "purakkhatvā pañjaliko namassati; ",
  "ja391:3.3": "Pucchāmi taṃ devarājetamatthaṃ, ",
  "ja391:3.4": "ito cuto kiṃ labhate sukhaṃ so. ",
  "ja391:4.1": "111. Yo disvā bhikkhuṃ caraṇūpapannaṃ, ",
  "ja391:4.2": "purakkhatvā pañjaliko namassati; ",
  "ja391:4.3": "Diṭṭheva dhamme labhate pasaṃsaṃ, ",
  "ja391:4.4": "saggañca so yāti sarīrabhedā. ",
  "ja391:5.1": "112. Lakkhī vata me udapādi ajja, ",
  "ja391:5.2": "yaṃ vāsavaṃ bhūtapatiddasāma; ",
  "ja391:5.3": "Bhikkhuñca disvāna tuvañca sakka, ",
  "ja391:5.4": "kāhāmi puññāni anappakāni. ",
  "ja391:6.1": "113. Addhā have sevitabbā sapaññā, ",
  "ja391:6.2": "bahussutā ye bahuṭhānacintino; ",
  "ja391:6.3": "Bhikkhuñca disvāna mamañca rāja, ",
  "ja391:6.4": "karohi puññāni anappakāni. ",
  "ja391:7.1": "114. Akkodhano niccapasannacitto, ",
  "ja391:7.2": "sabbātithīyācayogo bhavitvā; ",
  "ja391:7.3": "Nihacca mānaṃ abhivādayissaṃ, ",
  "ja391:7.4": "sutvāna devinda subhāsitānīti. ",
  "ja391:8.1": "Vijjādhara jātakaṃ chaṭṭhaṃ. "
}
