  "ja61:0.3": "7. Itthivaggo ",
  "ja61:0.4": "61. Asātamantajātakaṃ 61. ",
  "ja61:1.1": "Asā lokitthiyo nāma, ",
  "ja61:1.2": "velā tāsaṃ na vijjati; ",
  "ja61:1.3": "Sārattā ca pagabbhā ca, ",
  "ja61:1.4": "sikhī sabbaghaso yathā; ",
  "ja61:1.5": "Tā hitvā pabbajissāmi, ",
  "ja61:1.6": "vivekamanubrūhayanti. ",
  "ja61:2.1": "Asātamantajātakaṃ paṭhamaṃ. "
}
