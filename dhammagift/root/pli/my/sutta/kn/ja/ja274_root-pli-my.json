  "ja274:0.4": "70. 274. Lolajātakaṃ (3-3-4) ",
  "ja274:1.1": "Kāyaṃ balākā sikhinī, ",
  "ja274:1.2": "corī laṅghipitāmahā; ",
  "ja274:1.3": "Oraṃ balāke āgaccha, ",
  "ja274:1.4": "caṇḍo me vāyaso sakhā. ",
  "ja274:2.1": "71. Nāhaṃ balākā sikhinī, ",
  "ja274:2.2": "ahaṃ lolosmi vāyaso; ",
  "ja274:2.3": "Akatvā vacanaṃ tuyhaṃ, ",
  "ja274:2.4": "passa lūnosmi āgato. ",
  "ja274:3.1": "72. Punapāpajjasī samma, ",
  "ja274:3.2": "sīlañhi tava tādisaṃ; ",
  "ja274:3.3": "Na hi mānusakā bhogā, ",
  "ja274:3.4": "subhuñjā honti pakkhināti. ",
  "ja274:4.1": "Lolajātakaṃ catutthaṃ. "
}
