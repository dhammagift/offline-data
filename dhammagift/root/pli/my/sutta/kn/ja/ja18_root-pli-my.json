  "ja18:0.4": "18. Matakabhattajātakaṃ 18. ",
  "ja18:1.1": "Evaṃ ce sattā jāneyyuṃ, ",
  "ja18:1.2": "dukkhāyaṃ jātisambhavo; ",
  "ja18:1.3": "Na pāṇo pāṇinaṃ haññe, ",
  "ja18:1.4": "pāṇaghātī hi socatīti. ",
  "ja18:2.1": "Matakabhattajātakaṃ aṭṭhamaṃ. "
}
