{
  "ja541:0.1": "",
  "ja541:0.2": "",
  "ja541:0.3": "",
  "ja541:0.4": "421. 541. Nimijātakaṃ (4) ",
  "ja541:1.1": "‘‘Accheraṃ vata lokasmiṃ, ",
  "ja541:1.2": "uppajjanti vicakkhaṇā; ",
  "ja541:1.3": "Yadā ahu nimirājā, ",
  "ja541:1.4": "paṇḍito kusalatthiko. ",
  "ja541:2.1": "422. ‘‘Rājā sabbavidehānaṃ, ",
  "ja541:2.2": "adā dānaṃ arindamo; ",
  "ja541:2.3": "Tassa taṃ dadato dānaṃ, ",
  "ja541:2.4": "saṅkappo udapajjatha; ",
  "ja541:2.5": "Dānaṃ vā brahmacariyaṃ vā, ",
  "ja541:2.6": "katamaṃ su mahapphalaṃ. ",
  "ja541:3.1": "423. Tassa saṅkappamaññāya, ",
  "ja541:3.2": "maghavā devakuñjaro; ",
  "ja541:3.3": "Sahassanetto pāturahu, ",
  "ja541:3.4": "vaṇṇena vihanaṃ tamaṃ. ",
  "ja541:4.1": "424. Salomahaṭṭho manujindo, ",
  "ja541:4.2": "vāsavaṃ avacā nimi; ",
  "ja541:4.3": "‘‘Devatā nusi gandhabbo, ",
  "ja541:4.4": "adu sakko purindado. ",
  "ja541:5.1": "425. ‘‘Na ca me tādiso vaṇṇo, ",
  "ja541:5.2": "diṭṭho vā yadi vā suto; ",
  "ja541:5.3": "Ācikkha me tvaṃ bhaddante, ",
  "ja541:5.4": "kathaṃ jānemu taṃ mayaṃ’’ . ",
  "ja541:6.1": "426. Salomahaṭṭhaṃ ñatvāna, ",
  "ja541:6.2": "vāsavo avacā nimiṃ; ",
  "ja541:6.3": "‘‘Sakkohamasmi devindo, ",
  "ja541:6.4": "āgatosmi tavantike; ",
  "ja541:6.5": "Alomahaṭṭho manujinda, ",
  "ja541:6.6": "puccha pañhaṃ yamicchasi’’. ",
  "ja541:7.1": "427. So ca tena katokāso, ",
  "ja541:7.2": "vāsavaṃ avacā nimi; ",
  "ja541:7.3": "‘‘Pucchāmi taṃ mahārāja , ",
  "ja541:7.4": "sabbabhūtānamissara; ",
  "ja541:7.5": "Dānaṃ vā brahmacariyaṃ vā, ",
  "ja541:7.6": "katamaṃ su mahapphalaṃ’’. ",
  "ja541:8.1": "428. So puṭṭho naradevena, ",
  "ja541:8.2": "vāsavo avacā nimiṃ; ",
  "ja541:8.3": "‘‘Vipākaṃ brahmacariyassa, ",
  "ja541:8.4": "jānaṃ akkhāsijānato. ",
  "ja541:9.1": "429. ‘‘Hīnena brahmacariyena, ",
  "ja541:9.2": "khattiye upapajjati; ",
  "ja541:9.3": "Majjhimena ca devattaṃ, ",
  "ja541:9.4": "uttamena visujjhati. ",
  "ja541:10.1": "430. ‘‘Na hete sulabhā kāyā, ",
  "ja541:10.2": "yācayogena kenaci; ",
  "ja541:10.3": "Ye kāye upapajjanti, ",
  "ja541:10.4": "anāgārā tapassino. ",
  "ja541:11.1": "431. ‘‘Dudīpo sāgaro selo, ",
  "ja541:11.2": "mujakindo bhagīraso; ",
  "ja541:11.3": "Usindaro kassapo ca , ",
  "ja541:11.4": "asako ca puthujjano. ",
  "ja541:12.1": "432. ‘‘Ete caññe ca rājāno, ",
  "ja541:12.2": "khattiyā brāhmaṇā bahū; ",
  "ja541:12.3": "Puthuyaññaṃ yajitvāna, ",
  "ja541:12.4": "petattaṃ nātivattisuṃ. ",
  "ja541:13.1": "",
  "ja541:14.1": "433. ‘‘Atha yīme avattiṃsu, ",
  "ja541:14.2": "anāgārā tapassino; ",
  "ja541:14.3": "Sattisayo yāmahanu, ",
  "ja541:14.4": "somayāmo manojavo. ",
  "ja541:15.1": "434. ‘‘Samuddo māgho bharato ca, ",
  "ja541:15.2": "isi kālapurakkhato ; ",
  "ja541:15.3": "Aṅgīraso kassapo ca, ",
  "ja541:15.4": "kisavaccho akatti ca. ",
  "ja541:16.1": "435. ‘‘Uttarena nadī sīdā, ",
  "ja541:16.2": "gambhīrā duratikkamā; ",
  "ja541:16.3": "Naḷaggivaṇṇā jotanti, ",
  "ja541:16.4": "sadā kañcanapabbatā. ",
  "ja541:17.1": "436. ‘‘Parūḷhakacchā tagarā, ",
  "ja541:17.2": "rūḷhakacchā vanā nagā; ",
  "ja541:17.3": "Tatrāsuṃ dasasahassā, ",
  "ja541:17.4": "porāṇā isayo pure. ",
  "ja541:18.1": "437. ‘‘Ahaṃ seṭṭhosmi dānena, ",
  "ja541:18.2": "saṃyamena damena ca; ",
  "ja541:18.3": "Anuttaraṃ vataṃ katvā, ",
  "ja541:18.4": "pakiracārī samāhite. ",
  "ja541:19.1": "438. ‘‘Jātimantaṃ ajaccañca, ",
  "ja541:19.2": "ahaṃ ujugataṃ naraṃ; ",
  "ja541:19.3": "Ativelaṃ namassissaṃ, ",
  "ja541:19.4": "kammabandhū hi māṇavā . ",
  "ja541:20.1": "439. ‘‘Sabbe vaṇṇā adhammaṭṭhā, ",
  "ja541:20.2": "patanti nirayaṃ adho; ",
  "ja541:20.3": "Sabbe vaṇṇā visujjhanti, ",
  "ja541:20.4": "caritvā dhammamuttamaṃ’’. ",
  "ja541:21.1": "440. Idaṃ vatvāna maghavā, ",
  "ja541:21.2": "devarājā sujampati; ",
  "ja541:21.3": "Vedehamanusāsitvā, ",
  "ja541:21.4": "saggakāyaṃ apakkami. ",
  "ja541:22.1": "441. ‘‘Imaṃ bhonto nisāmetha, ",
  "ja541:22.2": "yāvantettha samāgatā; ",
  "ja541:22.3": "Dhammikānaṃ manussānaṃ, ",
  "ja541:22.4": "vaṇṇaṃ uccāvacaṃ bahuṃ. ",
  "ja541:23.1": "442. ‘‘Yathā ayaṃ nimirājā, ",
  "ja541:23.2": "paṇḍito kusalatthiko; ",
  "ja541:23.3": "Rājā sabbavidehānaṃ, ",
  "ja541:23.4": "adā dānaṃ arindamo. ",
  "ja541:24.1": "443. ‘‘Tassa taṃ dadato dānaṃ, ",
  "ja541:24.2": "saṅkappo udapajjatha; ",
  "ja541:24.3": "Dānaṃ vā brahmacariyaṃ vā, ",
  "ja541:24.4": "katamaṃ su mahapphalaṃ’’. ",
  "ja541:25.1": "444. Abbhuto vata lokasmiṃ, ",
  "ja541:25.2": "uppajji lomahaṃsano; ",
  "ja541:25.3": "Dibbo ratho pāturahu, ",
  "ja541:25.4": "vedehassa yasassino. ",
  "ja541:26.1": "445. Devaputto mahiddhiko, ",
  "ja541:26.2": "mātali devasārathi; ",
  "ja541:26.3": "Nimantayittha rājānaṃ, ",
  "ja541:26.4": "vedehaṃ mithilaggahaṃ. ",
  "ja541:27.1": "446. ‘‘Ehimaṃ rathamāruyha, ",
  "ja541:27.2": "rājaseṭṭha disampati; ",
  "ja541:27.3": "Devā dassanakāmā te, ",
  "ja541:27.4": "tāvatiṃsā saindakā; ",
  "ja541:27.5": "Saramānā hi te devā, ",
  "ja541:27.6": "sudhammāyaṃ samacchare’’. ",
  "ja541:28.1": "447. Tato rājā taramāno, ",
  "ja541:28.2": "vedeho mithilaggaho; ",
  "ja541:28.3": "Āsanā vuṭṭhahitvāna, ",
  "ja541:28.4": "pamukho rathamāruhi. ",
  "ja541:29.1": "448. Abhirūḷhaṃ rathaṃ dibbaṃ, ",
  "ja541:29.2": "mātali etadabravi; ",
  "ja541:29.3": "‘‘Kena taṃ nemi maggena, ",
  "ja541:29.4": "rājaseṭṭha disampati; ",
  "ja541:29.5": "Yena vā pāpakammantā, ",
  "ja541:29.6": "puññakammā ca ye narā’’. ",
  "ja541:30.1": "449. ‘‘Ubhayeneva maṃ nehi, ",
  "ja541:30.2": "mātali devasārathi; ",
  "ja541:30.3": "Yena vā pāpakammantā, ",
  "ja541:30.4": "puññakammā ca ye narā’’. ",
  "ja541:31.1": "450. ‘‘Kena taṃ paṭhamaṃ nemi, ",
  "ja541:31.2": "rājaseṭṭha disampati; ",
  "ja541:31.3": "Yena vā pāpakammantā, ",
  "ja541:31.4": "puññakammā ca ye narā’’. ",
  "ja541:32.1": "451. ‘‘Niraye tāva passāmi, ",
  "ja541:32.2": "āvāse pāpakamminaṃ; ",
  "ja541:32.3": "Ṭhānāni luddakammānaṃ, ",
  "ja541:32.4": "dussīlānañca yā gati’’. ",
  "ja541:33.1": "452. Dassesi mātali rañño, ",
  "ja541:33.2": "duggaṃ vetaraṇiṃ nadiṃ; ",
  "ja541:33.3": "Kuthitaṃ khārasaṃyuttaṃ, ",
  "ja541:33.4": "tattaṃ aggisikhūpamaṃ . ",
  "ja541:34.1": "453. Nimī have mātalimajjhabhāsatha , ",
  "ja541:34.2": "disvā janaṃ patamānaṃ vidugge; ",
  "ja541:34.3": "‘‘Bhayañhi maṃ vindati sūta disvā, ",
  "ja541:34.4": "pucchāmi taṃ mātali devasārathi; ",
  "ja541:34.5": "Ime nu maccā kimakaṃsu pāpaṃ, ",
  "ja541:34.6": "yeme janā vetaraṇiṃ patanti’’. ",
  "ja541:35.1": "454. Tassa puṭṭho viyākāsi, ",
  "ja541:35.2": "mātali devasārathi; ",
  "ja541:35.3": "Vipākaṃ pāpakammānaṃ, ",
  "ja541:35.4": "jānaṃ akkhāsijānato. ",
  "ja541:36.1": "455. ‘‘Ye dubbale balavantā jīvaloke, ",
  "ja541:36.2": "hiṃsanti rosanti supāpadhammā; ",
  "ja541:36.3": "Te luddakammā pasavetva pāpaṃ, ",
  "ja541:36.4": "teme janā vetaraṇiṃ patanti’’. ",
  "ja541:37.1": "456. ‘‘Sāmā ca soṇā sabalā ca gijjhā, ",
  "ja541:37.2": "kākolasaṅghā adanti bheravā; ",
  "ja541:37.3": "Bhayañhi maṃ vindati sūta disvā, ",
  "ja541:37.4": "pucchāmi taṃ mātali devasārathi; ",
  "ja541:37.5": "Ime nu maccā kimakaṃsu pāpaṃ, ",
  "ja541:37.6": "yeme jane kākolasaṅghā adanti’’. ",
  "ja541:38.1": "457. Tassa puṭṭho viyākāsi, ",
  "ja541:38.2": "mātali devasārathi; ",
  "ja541:38.3": "Vipākaṃ pāpakammānaṃ, ",
  "ja541:38.4": "jānaṃ akkhāsijānato. ",
  "ja541:39.1": "458. ‘‘Ye kecime maccharino kadariyā, ",
  "ja541:39.2": "paribhāsakā samaṇabrāhmaṇānaṃ; ",
  "ja541:39.3": "Hiṃsanti rosanti supāpadhammā, ",
  "ja541:39.4": "te luddakammā pasavetva pāpaṃ; ",
  "ja541:39.5": "Teme jane kākolasaṅghā adanti’’. ",
  "ja541:40.1": "459. ‘‘Sajotibhūtā pathaviṃ kamanti, ",
  "ja541:40.2": "tattehi khandhehi ca pothayanti; ",
  "ja541:40.3": "Bhayañhi maṃ vindati sūta disvā, ",
  "ja541:40.4": "pucchāmi taṃ mātali devasārathi; ",
  "ja541:40.5": "Ime nu maccā kimakaṃsu pāpaṃ, ",
  "ja541:40.6": "yeme janā khandhahatā sayanti’’. ",
  "ja541:41.1": "460. Tassa puṭṭho viyākāsi, ",
  "ja541:41.2": "mātali devasārathi; ",
  "ja541:41.3": "Vipākaṃ pāpakammānaṃ, ",
  "ja541:41.4": "jānaṃ akkhāsijānato. ",
  "ja541:42.1": "461. ‘‘Ye jīvalokasmi supāpadhammino, ",
  "ja541:42.2": "narañca nāriñca apāpadhammaṃ; ",
  "ja541:42.3": "Hiṃsanti rosanti supāpadhammā , ",
  "ja541:42.4": "te luddakammā pasavetva pāpaṃ; ",
  "ja541:42.5": "Teme janā khandhahatā sayanti’’. ",
  "ja541:43.1": "462. ‘‘Aṅgārakāsuṃ apare phuṇanti , ",
  "ja541:43.2": "narā rudantā paridaḍḍhagattā; ",
  "ja541:43.3": "Bhayañhi maṃ vidanti sūta disvā, ",
  "ja541:43.4": "pucchāmi taṃ mātali devasārathi; ",
  "ja541:43.5": "Ime nu maccā kimakaṃsu pāpaṃ, ",
  "ja541:43.6": "yeme janā aṅgārakāsuṃ phuṇanti’’. ",
  "ja541:44.1": "463. Tassa puṭṭho viyākāsi, ",
  "ja541:44.2": "mātali devasārathi; ",
  "ja541:44.3": "Vipākaṃ pāpakammānaṃ, ",
  "ja541:44.4": "jānaṃ akkhāsijānato. ",
  "ja541:45.1": "464. ‘‘Ye keci pūgāya dhanassa hetu, ",
  "ja541:45.2": "sakkhiṃ karitvā iṇaṃ jāpayanti; ",
  "ja541:45.3": "Te jāpayitvā janataṃ janinda, ",
  "ja541:45.4": "te luddakammā pasavetva pāpaṃ; ",
  "ja541:45.5": "Teme janā aṅgārakāsuṃ phuṇanti’’. ",
  "ja541:46.1": "465. ‘‘Sajotibhūtā jalitā padittā, ",
  "ja541:46.2": "padissati mahatī lohakumbhī; ",
  "ja541:46.3": "Bhayañhi maṃ vindati sūta disvā, ",
  "ja541:46.4": "pucchāmi taṃ mātali devasārathi; ",
  "ja541:46.5": "Ime nu maccā kimakaṃsu pāpaṃ, ",
  "ja541:46.6": "yeme janā avaṃsirā lohakumbhiṃ patanti’’. ",
  "ja541:47.1": "466. Tassa puṭṭho viyākāsi, ",
  "ja541:47.2": "mātali devasārathi; ",
  "ja541:47.3": "Vipākaṃ pāpakammānaṃ, ",
  "ja541:47.4": "jānaṃ akkhāsijānato. ",
  "ja541:48.1": "467. ‘‘Ye sīlavantaṃ samaṇaṃ brāhmaṇaṃ vā, ",
  "ja541:48.2": "hiṃsanti rosanti supāpadhammā; ",
  "ja541:48.3": "Te luddakammā pasavetva pāpaṃ, ",
  "ja541:48.4": "teme janā avaṃsirā lohakumbhiṃ patanti’’. ",
  "ja541:49.1": "468. ‘‘Luñcanti gīvaṃ atha veṭhayitvā , ",
  "ja541:49.2": "uṇhodakasmiṃ pakiledayitvā ; ",
  "ja541:49.3": "Bhayañhi maṃ vindati sūta disvā, ",
  "ja541:49.4": "pucchāmi taṃ mātali devasārathi; ",
  "ja541:49.5": "Ime nu maccā kimakaṃsu pāpaṃ, ",
  "ja541:49.6": "yeme janā luttasirā sayanti’’. ",
  "ja541:50.1": "469. Tassa puṭṭho viyākāsi, ",
  "ja541:50.2": "mātali devasārathi; ",
  "ja541:50.3": "Vipākaṃ pāpakammānaṃ, ",
  "ja541:50.4": "jānaṃ akkhāsijānato. ",
  "ja541:51.1": "470. ‘‘Ye jīvalokasmi supāpadhammino, ",
  "ja541:51.2": "pakkhī gahetvāna viheṭhayanti te; ",
  "ja541:51.3": "Viheṭhayitvā sakuṇaṃ janinda, ",
  "ja541:51.4": "te luddakāmā pasavetva pāpaṃ; ",
  "ja541:51.5": "Teme janā luttasirā sayanti. ",
  "ja541:52.1": "471. ‘‘Pahūtatoyā anigādhakūlā , ",
  "ja541:52.2": "nadī ayaṃ sandati suppatitthā; ",
  "ja541:52.3": "Ghammābhitattā manujā pivanti, ",
  "ja541:52.4": "pītañca tesaṃ bhusa hoti pāni. ",
  "ja541:53.1": "472. ‘‘Bhayañhi maṃ vindati sūta disvā, ",
  "ja541:53.2": "pucchāmi taṃ mātali devasārathi; ",
  "ja541:53.3": "Ime nu maccā kimakaṃsu pāpaṃ, ",
  "ja541:53.4": "pītañca tesaṃ bhusa hoti pāni’’. ",
  "ja541:54.1": "473. Tassa puṭṭho viyākāsi, ",
  "ja541:54.2": "mātali devasārathi; ",
  "ja541:54.3": "Vipākaṃ pāpakammānaṃ, ",
  "ja541:54.4": "jānaṃ akkhāsijānato. ",
  "ja541:55.1": "474. ‘‘Ye suddhadhaññaṃ palāsena missaṃ, ",
  "ja541:55.2": "asuddhakammā kayino dadanti; ",
  "ja541:55.3": "Ghammābhitattāna pipāsitānaṃ, ",
  "ja541:55.4": "pītañca tesaṃ bhusa hoti pāni’’. ",
  "ja541:56.1": "475. ‘‘Usūhi sattīhi ca tomarehi, ",
  "ja541:56.2": "dubhayāni passāni tudanti kandataṃ; ",
  "ja541:56.3": "Bhayañhi maṃ vindati sūta disvā, ",
  "ja541:56.4": "pucchāmi taṃ mātali devasārathi; ",
  "ja541:56.5": "Ime nu maccā kimakaṃsu pāpaṃ, ",
  "ja541:56.6": "yeme janā sattihatā sayanti’’. ",
  "ja541:57.1": "476. Tassa puṭṭho viyākāsi, ",
  "ja541:57.2": "mātali devasārathi; ",
  "ja541:57.3": "Vipākaṃ pāpakammānaṃ, ",
  "ja541:57.4": "jānaṃ akkhāsijānato. ",
  "ja541:58.1": "477. ‘‘Ye jīvalokasmi asādhukammino, ",
  "ja541:58.2": "adinnamādāya karonti jīvikaṃ; ",
  "ja541:58.3": "Dhaññaṃ dhanaṃ rajataṃ jātarūpaṃ, ",
  "ja541:58.4": "ajeḷakañcāpi pasuṃ mahiṃsaṃ ; ",
  "ja541:58.5": "Te luddakammā pasavetva pāpaṃ, ",
  "ja541:58.6": "teme janā sattihatā sayanti’’. ",
  "ja541:59.1": "478. ‘‘Gīvāya baddhā kissa ime puneke, ",
  "ja541:59.2": "aññe vikantā bilakatā sayanti ; ",
  "ja541:59.3": "Bhayañhi maṃ vindati sūta disvā, ",
  "ja541:59.4": "pucchāmi taṃ mātali devasārathi; ",
  "ja541:59.5": "Ime nu maccā kimakaṃsu pāpaṃ, ",
  "ja541:59.6": "yeme janā bilakatā sayanti’’. ",
  "ja541:60.1": "479. Tassa puṭṭho viyākāsi, ",
  "ja541:60.2": "mātali devasārathi; ",
  "ja541:60.3": "Vipākaṃ pāpakammānaṃ, ",
  "ja541:60.4": "jānaṃ akkhāsijānato. ",
  "ja541:61.1": "480. ‘‘Orabbhikā sūkarikā ca macchikā, ",
  "ja541:61.2": "pasuṃ mahiṃsañca ajeḷakañca; ",
  "ja541:61.3": "Hantvāna sūnesu pasārayiṃsu, ",
  "ja541:61.4": "te luddakammā pasavetva pāpaṃ; ",
  "ja541:61.5": "Teme janā bilakatā sayanti. ",
  "ja541:62.1": "481. ‘‘Rahado ayaṃ muttakarīsapūro, ",
  "ja541:62.2": "duggandharūpo asuci pūti vāti; ",
  "ja541:62.3": "Khudāparetā manujā adanti, ",
  "ja541:62.4": "bhayañhi maṃ vindati sūta disvā; ",
  "ja541:62.5": "Pucchāmi taṃ mātali devasārathi, ",
  "ja541:62.6": "ime nu maccā kimakaṃsu pāpaṃ; ",
  "ja541:62.7": "Yeme janā muttakarīsabhakkhā’’. ",
  "ja541:63.1": "482. Tassa puṭṭho viyākāsi, ",
  "ja541:63.2": "mātali devasārathi; ",
  "ja541:63.3": "Vipākaṃ pāpakammānaṃ, ",
  "ja541:63.4": "jānaṃ akkhāsijānato. ",
  "ja541:64.1": "483. ‘‘Ye kecime kāraṇikā virosakā, ",
  "ja541:64.2": "paresaṃ hiṃsāya sadā niviṭṭhā; ",
  "ja541:64.3": "Te luddakammā pasavetva pāpaṃ, ",
  "ja541:64.4": "mittadduno mīḷhamadanti bālā. ",
  "ja541:65.1": "484. ‘‘Rahado ayaṃ lohitapubbapūro, ",
  "ja541:65.2": "duggandharūpo asuci pūti vāti; ",
  "ja541:65.3": "Ghammābhitattā manujā pivanti, ",
  "ja541:65.4": "bhayañhi maṃ vindati sūta disvā; ",
  "ja541:65.5": "Pucchāmi taṃ mātali devasārathi, ",
  "ja541:65.6": "ime nu maccā kimakaṃsu pāpaṃ; ",
  "ja541:65.7": "Yeme janā lohitapubbabhakkhā’’. ",
  "ja541:66.1": "485. Tassa puṭṭho viyākāsi, ",
  "ja541:66.2": "mātali devasārathi; ",
  "ja541:66.3": "Vipākaṃ pāpakammānaṃ, ",
  "ja541:66.4": "jānaṃ akkhāsijānato. ",
  "ja541:67.1": "486. ‘‘Ye mātaraṃ vā pitaraṃ vā jīvaloke , ",
  "ja541:67.2": "pārājikā arahante hananti; ",
  "ja541:67.3": "Te luddakammā pasavetva pāpaṃ, ",
  "ja541:67.4": "teme janā lohitapubbabhakkhā’’. ",
  "ja541:68.1": "487. ‘‘Jivhañca passa baḷisena viddhaṃ, ",
  "ja541:68.2": "vihataṃ yathā saṅkusatena cammaṃ; ",
  "ja541:68.3": "Phandanti macchāva thalamhi khittā, ",
  "ja541:68.4": "muñcanti kheḷaṃ rudamānā kimete. ",
  "ja541:69.1": "488. ‘‘Bhayañhi maṃ vindati sūta disvā, ",
  "ja541:69.2": "pucchāmi taṃ mātali devasārathi; ",
  "ja541:69.3": "Ime nu maccā kimakaṃsu pāpaṃ, ",
  "ja541:69.4": "yeme janā vaṅkaghastā sayanti’’. ",
  "ja541:70.1": "489. Tassa puṭṭho viyākāsi, ",
  "ja541:70.2": "mātali devasārathi; ",
  "ja541:70.3": "Vipākaṃ pāpakammānaṃ, ",
  "ja541:70.4": "jānaṃ akkhāsijānato. ",
  "ja541:71.1": "490. ‘‘Ye keci sandhānagatā manussā, ",
  "ja541:71.2": "agghena agghaṃ kayaṃ hāpayanti; ",
  "ja541:71.3": "Kuṭena kuṭaṃ dhanalobhahetu, ",
  "ja541:71.4": "channaṃ yathā vāricaraṃ vadhāya. ",
  "ja541:72.1": "491. ‘‘Na hi kūṭakārissa bhavanti tāṇā, ",
  "ja541:72.2": "sakehi kammehi purakkhatassa; ",
  "ja541:72.3": "Te luddakammā pasavetva pāpaṃ, ",
  "ja541:72.4": "teme janā vaṅkaghastā sayanti’’. ",
  "ja541:73.1": "492. ‘‘Nārī imā samparibhinnagattā, ",
  "ja541:73.2": "paggayha kandanti bhuje dujaccā; ",
  "ja541:73.3": "Sammakkhitā lohitapubbalittā, ",
  "ja541:73.4": "gāvo yathā āghātane vikantā; ",
  "ja541:73.5": "Tā bhūmibhāgasmiṃ sadā nikhātā, ",
  "ja541:73.6": "khandhātivattanti sajotibhūtā. ",
  "ja541:74.1": "493. ‘‘Bhayañhi maṃ vindati sūta disvā, ",
  "ja541:74.2": "pucchāmi taṃ mātali devasārathi; ",
  "ja541:74.3": "Imā nu nāriyo kimakaṃsu pāpaṃ, ",
  "ja541:74.4": "yā bhūmibhāgasmiṃ sadā nikhātā; ",
  "ja541:74.5": "Khandhātivattanti sajotibhūtā’’. ",
  "ja541:75.1": "494. Tassa puṭṭho viyākāsi, ",
  "ja541:75.2": "mātali devasārathi; ",
  "ja541:75.3": "Vipākaṃ pāpakammānaṃ, ",
  "ja541:75.4": "jānaṃ akkhāsijānato. ",
  "ja541:76.1": "495. ‘‘Kolitthiyāyo idha jīvaloke, ",
  "ja541:76.2": "asuddhakammā asataṃ acāruṃ; ",
  "ja541:76.3": "Tā dittarūpā pati vippahāya, ",
  "ja541:76.4": "aññaṃ acāruṃ ratikhiḍḍahetu; ",
  "ja541:76.5": "Tā jīvalokasmiṃ ramāpayitvā, ",
  "ja541:76.6": "khandhātivattanti sajotibhūtā. ",
  "ja541:77.1": "496. ‘‘Pāde gahetvā kissa ime puneke, ",
  "ja541:77.2": "avaṃsirā narake pātayanti; ",
  "ja541:77.3": "Bhayañhi maṃ vindati sūta disvā, ",
  "ja541:77.4": "pucchāmi taṃ mātali devasārathi; ",
  "ja541:77.5": "Ime nu maccā kimakaṃsu pāpaṃ, ",
  "ja541:77.6": "yeme janā avaṃsirā narake pātayanti’’. ",
  "ja541:78.1": "497. Tassa puṭṭho viyākāsi, ",
  "ja541:78.2": "mātali devasārathi; ",
  "ja541:78.3": "Vipākaṃ pāpakammānaṃ, ",
  "ja541:78.4": "jānaṃ akkhāsijānato. ",
  "ja541:79.1": "498. ‘‘Ye jīvalokasmi asādhukammino, ",
  "ja541:79.2": "parassa dārāni atikkamanti; ",
  "ja541:79.3": "Te tādisā uttamabhaṇḍathenā, ",
  "ja541:79.4": "teme janā avaṃsirā narake pātayanti. ",
  "ja541:80.1": "499. ‘‘Te vassapūgāni bahūni tattha, ",
  "ja541:80.2": "nirayesu dukkhaṃ vedanaṃ vedayanti; ",
  "ja541:80.3": "Na hi pāpakārissa bhavanti tāṇā, ",
  "ja541:80.4": "sakehi kammehi purakkhatassa; ",
  "ja541:80.5": "Te luddakammā pasavetva pāpaṃ, ",
  "ja541:80.6": "teme janā avaṃsirā narake pātayanti’’. ",
  "ja541:81.1": "500. ‘‘Uccāvacāme vividhā upakkamā, ",
  "ja541:81.2": "nirayesu dissanti sughorarūpā; ",
  "ja541:81.3": "Bhayañhi maṃ vindati sūta disvā, ",
  "ja541:81.4": "pucchāmi taṃ mātali devasārathi; ",
  "ja541:81.5": "Ime nu maccā kimakaṃsu pāpaṃ, ",
  "ja541:81.6": "yeme janā adhimattā dukkhā tibbā; ",
  "ja541:81.7": "Kharā kaṭukā vedanā vedayanti’’. ",
  "ja541:82.1": "501. Tassa puṭṭho viyākāsi, ",
  "ja541:82.2": "mātali devasārathi; ",
  "ja541:82.3": "Vipākaṃ pāpakammānaṃ, ",
  "ja541:82.4": "jānaṃ akkhāsijānato. ",
  "ja541:83.1": "502. ‘‘Ye jīvalokasmi supāpadiṭṭhino, ",
  "ja541:83.2": "vissāsakammāni karonti mohā; ",
  "ja541:83.3": "Parañca diṭṭhīsu samādapenti, ",
  "ja541:83.4": "te pāpadiṭṭhiṃ pasavetva pāpaṃ; ",
  "ja541:83.5": "Teme janā adhimattā dukkhā tibbā, ",
  "ja541:83.6": "kharā kaṭukā vedanā vedayanti. ",
  "ja541:84.1": "503. ‘‘Viditā te mahārāja, ",
  "ja541:84.2": "āvāsā pāpakamminaṃ; ",
  "ja541:84.3": "Ṭhānāni luddakammānaṃ, ",
  "ja541:84.4": "dussīlānañca yā gati; ",
  "ja541:84.5": "Uyyāhi dāni rājīsi, ",
  "ja541:84.6": "devarājassa santike’’. ",
  "ja541:85.1": "",
  "ja541:86.1": "504. ‘‘Pañcathūpaṃ dissatidaṃ vimānaṃ, ",
  "ja541:86.2": "mālāpiḷandhā sayanassa majjhe; ",
  "ja541:86.3": "Tatthacchati nārī mahānubhāvā, ",
  "ja541:86.4": "uccāvacaṃ iddhi vikubbamānā. ",
  "ja541:87.1": "505. ‘‘Vittī hi maṃ vindati sūta disvā, ",
  "ja541:87.2": "pucchāmi taṃ mātali devasārathi; ",
  "ja541:87.3": "Ayaṃ nu nārī kimakāsi sādhuṃ, ",
  "ja541:87.4": "yā modati saggapattā vimāne’’. ",
  "ja541:88.1": "506. Tassa puṭṭho viyākāsi, ",
  "ja541:88.2": "mātali devasārathi; ",
  "ja541:88.3": "Vipākaṃ puññakammānaṃ, ",
  "ja541:88.4": "jānaṃ akkhāsijānato. ",
  "ja541:89.1": "507. ‘‘Yadi te sutā bīraṇī jīvaloke, ",
  "ja541:89.2": "āmāyadāsī ahu brāhmaṇassa; ",
  "ja541:89.3": "Sā pattakāle atithiṃ viditvā, ",
  "ja541:89.4": "mātāva puttaṃ sakimābhinandī; ",
  "ja541:89.5": "Saṃyamā saṃvibhāgā ca, ",
  "ja541:89.6": "sā vimānasmi modati. ",
  "ja541:90.1": "508. ‘‘Daddallamānā ābhenti , ",
  "ja541:90.2": "vimānā satta nimmitā; ",
  "ja541:90.3": "Tattha yakkho mahiddhiko, ",
  "ja541:90.4": "sabbābharaṇabhūsito; ",
  "ja541:90.5": "Samantā anupariyāti, ",
  "ja541:90.6": "nārīgaṇapurakkhato. ",
  "ja541:91.1": "509. ‘‘Vittī hi maṃ vindati sūta disvā, ",
  "ja541:91.2": "pucchāmi taṃ mātali devasārathi; ",
  "ja541:91.3": "Ayaṃ nu macco kimakāsi sādhuṃ, ",
  "ja541:91.4": "yo modati saggapatto vimāne’’. ",
  "ja541:92.1": "510. Tassa puṭṭho viyākāsi, ",
  "ja541:92.2": "mātali devasārathi; ",
  "ja541:92.3": "Vipākaṃ puññakammānaṃ, ",
  "ja541:92.4": "jānaṃ akkhāsijānato. ",
  "ja541:93.1": "511. ‘‘Soṇadinno gahapati, ",
  "ja541:93.2": "esa dānapatī ahu; ",
  "ja541:93.3": "Esa pabbajituddissa, ",
  "ja541:93.4": "vihāre satta kārayi. ",
  "ja541:94.1": "512. ‘‘Sakkaccaṃ te upaṭṭhāsi, ",
  "ja541:94.2": "bhikkhavo tattha vāsike; ",
  "ja541:94.3": "Acchādanañca bhattañca, ",
  "ja541:94.4": "senāsanaṃ padīpiyaṃ. ",
  "ja541:94.5": "Adāsi ujubhūtesu, ",
  "ja541:94.6": "vippasannena cetasā. ",
  "ja541:95.1": "513. ‘‘Cātuddasiṃ pañcadasiṃ, ",
  "ja541:95.2": "yā ca pakkhassa aṭṭhamī ; ",
  "ja541:95.3": "Pāṭihāriyapakkhañca, ",
  "ja541:95.4": "aṭṭhaṅgasusamāhitaṃ. ",
  "ja541:96.1": "514. ‘‘Uposathaṃ upavasī, ",
  "ja541:96.2": "sadā sīlesu saṃvuto; ",
  "ja541:96.3": "Saṃyamā saṃvibhāgā ca, ",
  "ja541:96.4": "so vimānasmi modati. ",
  "ja541:97.1": "515. ‘‘Pabhāsati midaṃ byamhaṃ, ",
  "ja541:97.2": "phalikāsu sunimmitaṃ; ",
  "ja541:97.3": "Nārīvaragaṇākiṇṇaṃ, ",
  "ja541:97.4": "kūṭāgāravarocitaṃ; ",
  "ja541:97.5": "Upetaṃ annapānehi, ",
  "ja541:97.6": "naccagītehi cūbhayaṃ. ",
  "ja541:98.1": "516. ‘‘Vittī hi maṃ vindati sūta disvā, ",
  "ja541:98.2": "pucchāmi taṃ mātali devasārathi; ",
  "ja541:98.3": "Ime nu maccā kimakaṃsu sādhuṃ, ",
  "ja541:98.4": "ye modare saggapattā vimāne’’. ",
  "ja541:99.1": "517. Tassa puṭṭho viyākāsi, ",
  "ja541:99.2": "mātali devasārathi; ",
  "ja541:99.3": "Vipākaṃ puññakammānaṃ, ",
  "ja541:99.4": "jānaṃ akkhāsijānato. ",
  "ja541:100.1": "518. ‘‘Yā kāci nāriyo idha jīvaloke, ",
  "ja541:100.2": "sīlavantiyo upāsikā; ",
  "ja541:100.3": "Dāne ratā niccaṃ pasannacittā, ",
  "ja541:100.4": "sacce ṭhitā uposathe appamattā; ",
  "ja541:100.5": "Saṃyamā saṃvibhāgā ca, ",
  "ja541:100.6": "tā vimānasmi modare. ",
  "ja541:101.1": "519. ‘‘Pabhāsati midaṃ byamhaṃ, ",
  "ja541:101.2": "veḷuriyāsu nimmitaṃ; ",
  "ja541:101.3": "Upetaṃ bhūmibhāgehi, ",
  "ja541:101.4": "vibhattaṃ bhāgaso mitaṃ. ",
  "ja541:102.1": "520. ‘‘Āḷambarā mudiṅgā ca, ",
  "ja541:102.2": "naccagītā suvāditā; ",
  "ja541:102.3": "Dibbā saddā niccharanti, ",
  "ja541:102.4": "savanīyā manoramā. ",
  "ja541:103.1": "521. ‘‘Nāhaṃ evaṃgataṃ jātu , ",
  "ja541:103.2": "evaṃsuruciraṃ pure; ",
  "ja541:103.3": "Saddaṃ samabhijānāmi, ",
  "ja541:103.4": "diṭṭhaṃ vā yadi vā sutaṃ. ",
  "ja541:104.1": "522. ‘‘Vittī hi maṃ vindati sūta disvā, ",
  "ja541:104.2": "pucchāmi taṃ mātali devasārathi; ",
  "ja541:104.3": "Ime nu maccā kimakaṃsu sādhuṃ, ",
  "ja541:104.4": "ye modare saggapattā vimāne’’. ",
  "ja541:105.1": "523. Tassa puṭṭho viyākāsi, ",
  "ja541:105.2": "mātali devasārathi; ",
  "ja541:105.3": "Vipākaṃ puññakammānaṃ, ",
  "ja541:105.4": "jānaṃ akkhāsijānato. ",
  "ja541:106.1": "524. ‘‘Ye keci maccā idha jīvaloke, ",
  "ja541:106.2": "sīlavantā upāsakā; ",
  "ja541:106.3": "Ārāme udapāne ca, ",
  "ja541:106.4": "papā saṅkamanāni ca; ",
  "ja541:106.5": "Arahante sītibhūte , ",
  "ja541:106.6": "sakkaccaṃ paṭipādayuṃ. ",
  "ja541:107.1": "525. ‘‘Cīvaraṃ piṇḍapātañca, ",
  "ja541:107.2": "paccayaṃ sayanāsanaṃ; ",
  "ja541:107.3": "Adaṃsu ujubhūtesu, ",
  "ja541:107.4": "vippasannena cetasā. ",
  "ja541:108.1": "526. ‘‘Cātuddasiṃ pañcadasiṃ, ",
  "ja541:108.2": "yā ca pakkhassa aṭṭhamī; ",
  "ja541:108.3": "Pāṭihāriyapakkhañca, ",
  "ja541:108.4": "aṭṭhaṅgasusamāhitaṃ. ",
  "ja541:109.1": "527. ‘‘Uposathaṃ upavasuṃ, ",
  "ja541:109.2": "sadā sīlesu saṃvutā; ",
  "ja541:109.3": "Saṃyamā saṃvibhāgā ca, ",
  "ja541:109.4": "te vimānasmi modare. ",
  "ja541:110.1": "528. ‘‘Pabhāsati midaṃ byamhaṃ, ",
  "ja541:110.2": "phalikāsu sunimmitaṃ; ",
  "ja541:110.3": "Nārīvaragaṇākiṇṇaṃ, ",
  "ja541:110.4": "kūṭāgāravarocitaṃ. ",
  "ja541:111.1": "529. ‘‘Upetaṃ annapānehi, ",
  "ja541:111.2": "naccagītehi cūbhayaṃ; ",
  "ja541:111.3": "Najjo cānupariyāti, ",
  "ja541:111.4": "nānāpupphadumāyutā. ",
  "ja541:112.1": "530. ‘‘Vittī hi maṃ vindati sūta disvā, ",
  "ja541:112.2": "pucchāmi taṃ mātali devasārathi; ",
  "ja541:112.3": "Ayaṃ nu macco kimakāsi sādhuṃ, ",
  "ja541:112.4": "yo modatī saggapatto vimāne’’. ",
  "ja541:113.1": "531. Tassa puṭṭho viyākāsi, ",
  "ja541:113.2": "mātali devasārathi; ",
  "ja541:113.3": "Vipākaṃ puññakammānaṃ, ",
  "ja541:113.4": "jānaṃ akkhāsijānato. ",
  "ja541:114.1": "532. ‘‘Mithilāyaṃ gahapati, ",
  "ja541:114.2": "esa dānapatī ahu; ",
  "ja541:114.3": "Ārāme udapāne ca, ",
  "ja541:114.4": "papā saṅkamanāni ca; ",
  "ja541:114.5": "Arahante sītibhūte, ",
  "ja541:114.6": "sakkaccaṃ paṭipādayi. ",
  "ja541:115.1": "533. ‘‘Cīvaraṃ piṇḍapātañca, ",
  "ja541:115.2": "paccayaṃ sayanāsanaṃ; ",
  "ja541:115.3": "Adāsi ujubhūtesu, ",
  "ja541:115.4": "vippasannena cetasā. ",
  "ja541:116.1": "534. ‘‘Cātuddasiṃ pañcadasiṃ, ",
  "ja541:116.2": "yā ca pakkhassa aṭṭhamī; ",
  "ja541:116.3": "Pāṭihāriyapakkhañca, ",
  "ja541:116.4": "aṭṭhaṅgasusamāhitaṃ. ",
  "ja541:117.1": "535. ‘‘Uposathaṃ upavasī, ",
  "ja541:117.2": "sadā sīlesu saṃvuto; ",
  "ja541:117.3": "Saṃyamā saṃvibhāgā ca, ",
  "ja541:117.4": "so vimānasmi modati’’. ",
  "ja541:118.1": "536. ‘‘Pabhāsati midaṃ byamhaṃ, ",
  "ja541:118.2": "phalikāsu sunimmitaṃ ; ",
  "ja541:118.3": "Nārīvaragaṇākiṇṇaṃ, ",
  "ja541:118.4": "kūṭāgāravarocitaṃ. ",
  "ja541:119.1": "537. ‘‘Upetaṃ annapānehi, ",
  "ja541:119.2": "naccagītehi cūbhayaṃ; ",
  "ja541:119.3": "Najjo cānupariyāti, ",
  "ja541:119.4": "nānāpupphadumāyutā. ",
  "ja541:120.1": "538. ‘‘Rājāyatanā kapitthā ca, ",
  "ja541:120.2": "ambā sālā ca jambuyo; ",
  "ja541:120.3": "Tindukā ca piyālā ca, ",
  "ja541:120.4": "dumā niccaphalā bahū. ",
  "ja541:121.1": "539. ‘‘Vittī hi maṃ vindati sūta disvā, ",
  "ja541:121.2": "pucchāmi taṃ mātali devasārathi; ",
  "ja541:121.3": "Ayaṃ nu macco kimakāsi sādhuṃ, ",
  "ja541:121.4": "yo modatī saggapatto vimāne’’. ",
  "ja541:122.1": "540. ‘‘Tassa puṭṭho viyākāsi, ",
  "ja541:122.2": "mātali devasārathi; ",
  "ja541:122.3": "Vipākaṃ puññakammānaṃ, ",
  "ja541:122.4": "jānaṃ akkhāsijānato. ",
  "ja541:123.1": "541. ‘‘Mithilāyaṃ gahapati, ",
  "ja541:123.2": "esa dānapatī ahu; ",
  "ja541:123.3": "Ārāme udapāne ca, ",
  "ja541:123.4": "papā saṅkamanāni ca; ",
  "ja541:123.5": "Arahante sītibhūte, ",
  "ja541:123.6": "sakkaccaṃ paṭipādayi. ",
  "ja541:124.1": "542. ‘‘Cīvaraṃ piṇḍapātañca, ",
  "ja541:124.2": "paccayaṃ sayanāsanaṃ; ",
  "ja541:124.3": "Adāsi ujubhūtesu, ",
  "ja541:124.4": "vippasannena cetasā. ",
  "ja541:125.1": "543. ‘‘Cātuddasiṃ pañcadasiṃ, ",
  "ja541:125.2": "yā ca pakkhassa aṭṭhamī; ",
  "ja541:125.3": "Pāṭihāriyapakkhañca, ",
  "ja541:125.4": "aṭṭhaṅgasusamāhitaṃ. ",
  "ja541:126.1": "544. ‘‘Uposathaṃ upavasī, ",
  "ja541:126.2": "sadā sīlesu saṃvuto; ",
  "ja541:126.3": "Saṃyamā saṃvibhāgā ca, ",
  "ja541:126.4": "so vimānasmi modati’’. ",
  "ja541:127.1": "545. ‘‘Pabhāsati midaṃ byamhaṃ, ",
  "ja541:127.2": "veḷuriyāsu nimmitaṃ; ",
  "ja541:127.3": "Upetaṃ bhūmibhāgehi, ",
  "ja541:127.4": "vibhattaṃ bhāgaso mitaṃ. ",
  "ja541:128.1": "546. ‘‘Āḷambarā mudiṅgā ca, ",
  "ja541:128.2": "naccagītā suvāditā; ",
  "ja541:128.3": "Dibyā saddā niccharanti, ",
  "ja541:128.4": "savanīyā manoramā. ",
  "ja541:129.1": "547. ‘‘Nāhaṃ evaṃgataṃ jātu , ",
  "ja541:129.2": "evaṃsuruciyaṃ pure; ",
  "ja541:129.3": "Saddaṃ samabhijānāmi, ",
  "ja541:129.4": "diṭṭhaṃ vā yadi vā sutaṃ. ",
  "ja541:130.1": "548. ‘‘Vittī hi maṃ vindati sūta disvā, ",
  "ja541:130.2": "pucchāmi taṃ mātali devasārathi; ",
  "ja541:130.3": "Ayaṃ nu macco kimakāsi sādhuṃ, ",
  "ja541:130.4": "yo modati saggapatto vimāne’’. ",
  "ja541:131.1": "549. Tassa puṭṭho viyākāsi, ",
  "ja541:131.2": "mātali devasārathi; ",
  "ja541:131.3": "Vipākaṃ puññakammānaṃ, ",
  "ja541:131.4": "jānaṃ akkhāsijānato. ",
  "ja541:132.1": "550. ‘‘Bārāṇasiyaṃ gahapati, ",
  "ja541:132.2": "esa dānapatī ahu; ",
  "ja541:132.3": "Ārāme udapāne ca, ",
  "ja541:132.4": "papā saṅkamanāni ca; ",
  "ja541:132.5": "Arahante sītibhūte, ",
  "ja541:132.6": "sakkaccaṃ paṭipādayi. ",
  "ja541:133.1": "551. ‘‘Cīvaraṃ piṇḍapātañca, ",
  "ja541:133.2": "paccayaṃ sayanāsanaṃ; ",
  "ja541:133.3": "Adāsi ujubhūtesu, ",
  "ja541:133.4": "vippasannena cetasā. ",
  "ja541:134.1": "552. ‘‘Cātuddasiṃ pañcadasiṃ, ",
  "ja541:134.2": "yā ca pakkhassa aṭṭhamī; ",
  "ja541:134.3": "Pāṭihāriyapakkhañca, ",
  "ja541:134.4": "aṭṭhaṅgasusamāhitaṃ. ",
  "ja541:135.1": "553. ‘‘Uposathaṃ upavasī, ",
  "ja541:135.2": "sadāsīlesu saṃvuto; ",
  "ja541:135.3": "Saṃyamā saṃvibhāgā ca, ",
  "ja541:135.4": "so vimānasmi modati. ",
  "ja541:136.1": "554. ‘‘Yathā udayamādicco, ",
  "ja541:136.2": "hoti lohitako mahā; ",
  "ja541:136.3": "Tathūpamaṃ idaṃ byamhaṃ, ",
  "ja541:136.4": "jātarūpassa nimmitaṃ. ",
  "ja541:137.1": "555. ‘‘Vittī hi maṃ vindati sūta disvā, ",
  "ja541:137.2": "pucchāmi taṃ mātali devasārathi; ",
  "ja541:137.3": "Ayaṃ nu macco kimakāsi sādhuṃ, ",
  "ja541:137.4": "yo modatī saggapatto vimāne’’. ",
  "ja541:138.1": "556. Tassa puṭṭho viyākāsi, ",
  "ja541:138.2": "mātali devasārathi; ",
  "ja541:138.3": "Vipākaṃ puññakammānaṃ, ",
  "ja541:138.4": "jānaṃ akkhāsijānato. ",
  "ja541:139.1": "557. ‘‘Sāvatthiyaṃ gahapati, ",
  "ja541:139.2": "esa dānapatī ahu; ",
  "ja541:139.3": "Ārāme udapāne ca, ",
  "ja541:139.4": "papā saṅkamanāni ca; ",
  "ja541:139.5": "Arahante sītibhūte, ",
  "ja541:139.6": "sakkaccaṃ paṭipādayi. ",
  "ja541:140.1": "558. ‘‘Cīvaraṃ piṇḍapātañca, ",
  "ja541:140.2": "paccayaṃ sayanāsanaṃ; ",
  "ja541:140.3": "Adāsi ujubhūtesu, ",
  "ja541:140.4": "vippasannena cetasā. ",
  "ja541:141.1": "559. ‘‘Cātuddasiṃ pañcadasiṃ, ",
  "ja541:141.2": "yā ca pakkhassa aṭṭhamī; ",
  "ja541:141.3": "Pāṭihāriyapakkhañca, ",
  "ja541:141.4": "aṭṭhaṅgasusamāhitaṃ. ",
  "ja541:142.1": "560. ‘‘Uposathaṃ upavasī, ",
  "ja541:142.2": "sadā sīlesu saṃvuto; ",
  "ja541:142.3": "Saṃyamā saṃvibhāgā ca, ",
  "ja541:142.4": "so vimānasmi modati. ",
  "ja541:143.1": "561. ‘‘Vehāyasā me bahukā, ",
  "ja541:143.2": "jātarūpassa nimmitā; ",
  "ja541:143.3": "Daddallamānā ābhenti, ",
  "ja541:143.4": "vijjuvabbhaghanantare. ",
  "ja541:144.1": "",
  "ja541:145.1": "562. ‘‘Vittī hi maṃ vindati sūta disvā, ",
  "ja541:145.2": "pucchāmi taṃ mātali devasārathi; ",
  "ja541:145.3": "Ime nu maccā kimakaṃsu sādhuṃ, ",
  "ja541:145.4": "ye modare saggapattā vimāne’’. ",
  "ja541:146.1": "563. Tassa puṭṭho viyākāsi, ",
  "ja541:146.2": "mātali devasārathi; ",
  "ja541:146.3": "Vipākaṃ puññakammānaṃ, ",
  "ja541:146.4": "jānaṃ akkhāsijānato. ",
  "ja541:147.1": "564. ‘‘Saddhāya suniviṭṭhāya, ",
  "ja541:147.2": "saddhamme suppavedite; ",
  "ja541:147.3": "Akaṃsu satthu vacanaṃ, ",
  "ja541:147.4": "sammāsambuddhasāsane ; ",
  "ja541:147.5": "Tesaṃ etāni ṭhānāni, ",
  "ja541:147.6": "yāni tvaṃ rāja passasi. ",
  "ja541:148.1": "565. ‘‘Viditā te mahārāja, ",
  "ja541:148.2": "āvāsā pāpakamminaṃ; ",
  "ja541:148.3": "Atho kalyāṇakammānaṃ, ",
  "ja541:148.4": "ṭhānāni viditāni te; ",
  "ja541:148.5": "Uyyāhi dāni rājīsi, ",
  "ja541:148.6": "devarājassa santike’’. ",
  "ja541:149.1": "566. ‘‘Sahassayuttaṃ hayavāhiṃ, ",
  "ja541:149.2": "dibbayānamadhiṭṭhito; ",
  "ja541:149.3": "Yāyamāno mahārājā, ",
  "ja541:149.4": "addā sīdantare nage; ",
  "ja541:149.5": "Disvānāmantayī sūtaṃ, ",
  "ja541:149.6": "‘‘ime ke nāma pabbatā’’. ",
  "ja541:150.1": "567. Tassa puṭṭho viyākāsi, ",
  "ja541:150.2": "mātali devasārathi; ",
  "ja541:150.3": "Vipākaṃ puññakammānaṃ, ",
  "ja541:150.4": "jānaṃ akkhāsijānato . ",
  "ja541:151.1": "568. ‘‘Sudassano karavīko, ",
  "ja541:151.2": "īsadharo yugandharo; ",
  "ja541:151.3": "Nemindharo vinatako, ",
  "ja541:151.4": "assakaṇṇo girī brahā. ",
  "ja541:152.1": "569. ‘‘Ete sīdantare nagā, ",
  "ja541:152.2": "anupubbasamuggatā; ",
  "ja541:152.3": "Mahārājānamāvāsā, ",
  "ja541:152.4": "yāni tvaṃ rāja passasi. ",
  "ja541:153.1": "570. ‘‘Anekarūpaṃ ruciraṃ, ",
  "ja541:153.2": "nānācitraṃ pakāsati; ",
  "ja541:153.3": "Ākiṇṇaṃ indasadisehi, ",
  "ja541:153.4": "byaggheheva surakkhitaṃ . ",
  "ja541:154.1": "571. ‘‘Vittī hi maṃ vindati sūta disvā, ",
  "ja541:154.2": "pucchāmi taṃ mātali devasārathi; ",
  "ja541:154.3": "Imaṃ nu dvāraṃ kimabhaññamāhu , ",
  "ja541:154.4": "(manorama dissati dūratova.) ",
  "ja541:155.1": "572. Tassa puṭṭho viyākāsi, ",
  "ja541:155.2": "mātali devasārathi; ",
  "ja541:155.3": "Vipākaṃ puññakammānaṃ, ",
  "ja541:155.4": "jānaṃ akkhāsijānato. ",
  "ja541:156.1": "573. ‘‘Citrakūṭoti yaṃ āhu, ",
  "ja541:156.2": "devarājapavesanaṃ; ",
  "ja541:156.3": "Sudassanassa girino, ",
  "ja541:156.4": "dvārañhetaṃ pakāsati. ",
  "ja541:157.1": "574. ‘‘Anekarūpaṃ ruciraṃ, ",
  "ja541:157.2": "nānācitraṃ pakāsati; ",
  "ja541:157.3": "Ākiṇṇaṃ indasadisehi, ",
  "ja541:157.4": "byaggheheva surakkhitaṃ; ",
  "ja541:157.5": "Pavisetena rājīsi, ",
  "ja541:157.6": "arajaṃ bhūmimakkama’’. ",
  "ja541:158.1": "575. ‘‘Sahassayuttaṃ hayavāhiṃ, ",
  "ja541:158.2": "dibbayānamadhiṭṭhito; ",
  "ja541:158.3": "Yāyamāno mahārājā, ",
  "ja541:158.4": "addā devasabhaṃ idaṃ. ",
  "ja541:159.1": "576. ‘‘Yathā sarade ākāse , ",
  "ja541:159.2": "nīlobhāso padissati; ",
  "ja541:159.3": "Tathūpamaṃ idaṃ byamhaṃ, ",
  "ja541:159.4": "veḷuriyāsu nimmitaṃ. ",
  "ja541:160.1": "577. ‘‘Vittī hi maṃ vindati sūta disvā, ",
  "ja541:160.2": "pucchāmi taṃ mātali devasārathi; ",
  "ja541:160.3": "Imaṃ nu byamhaṃ kimabhaññamāhu , ",
  "ja541:160.4": "(manorama dissati dūratova.) ",
  "ja541:161.1": "578. Tassa puṭṭho viyākāsi, ",
  "ja541:161.2": "mātali devasārathi; ",
  "ja541:161.3": "Vipākaṃ puññakammānaṃ, ",
  "ja541:161.4": "jānaṃ akkhāsijānato. ",
  "ja541:162.1": "579. ‘‘Sudhammā iti yaṃ āhu, ",
  "ja541:162.2": "passesā dissate sabhā; ",
  "ja541:162.3": "Veḷuriyārucirā citrā, ",
  "ja541:162.4": "dhārayanti sunimmitā. ",
  "ja541:163.1": "580. ‘‘Aṭṭhaṃsā sukatā thambhā, ",
  "ja541:163.2": "sabbe veḷuriyāmayā; ",
  "ja541:163.3": "Yattha devā tāvatiṃsā, ",
  "ja541:163.4": "sabbe indapurohitā. ",
  "ja541:164.1": "581. ‘‘Atthaṃ devamanussānaṃ, ",
  "ja541:164.2": "cintayantā samacchare; ",
  "ja541:164.3": "Pavisetena rājīsi, ",
  "ja541:164.4": "devānaṃ anumodanaṃ’’. ",
  "ja541:165.1": "582. ‘‘Taṃ devā paṭinandiṃsu, ",
  "ja541:165.2": "disvā rājānamāgataṃ; ",
  "ja541:165.3": "‘‘Svāgataṃ te mahārāja, ",
  "ja541:165.4": "atho te adurāgataṃ; ",
  "ja541:165.5": "Nisīda dāni rājīsi, ",
  "ja541:165.6": "devarājassa santike’’. ",
  "ja541:166.1": "583. ‘‘Sakkopi paṭinandittha , ",
  "ja541:166.2": "vedehaṃ mithilaggahaṃ; ",
  "ja541:166.3": "Nimantayittha kāmehi, ",
  "ja541:166.4": "āsanena ca vāsavo. ",
  "ja541:167.1": "584. ‘‘Sādhu khosi anuppatto, ",
  "ja541:167.2": "āvāsaṃ vasavattinaṃ; ",
  "ja541:167.3": "Vasa devesu rājīsi, ",
  "ja541:167.4": "sabbakāmasamiddhisu; ",
  "ja541:167.5": "Tāvatiṃsesu devesu, ",
  "ja541:167.6": "bhuñja kāme amānuse’’. ",
  "ja541:168.1": "585. ‘‘Yathā yācitakaṃ yānaṃ, ",
  "ja541:168.2": "yathā yācitakaṃ dhanaṃ; ",
  "ja541:168.3": "Evaṃsampadamevetaṃ, ",
  "ja541:168.4": "yaṃ parato dānapaccayā. ",
  "ja541:169.1": "586. ‘‘Na cāhametamicchāmi, ",
  "ja541:169.2": "yaṃ parato dānapaccayā; ",
  "ja541:169.3": "Sayaṃkatāni puññāni, ",
  "ja541:169.4": "taṃ me āveṇikaṃ dhanaṃ. ",
  "ja541:170.1": "587. ‘‘Sohaṃ gantvā manussesu, ",
  "ja541:170.2": "kāhāmi kusalaṃ bahuṃ; ",
  "ja541:170.3": "Dānena samacariyāya, ",
  "ja541:170.4": "saṃyamena damena ca; ",
  "ja541:170.5": "Yaṃ katvā sukhito hoti, ",
  "ja541:170.6": "na ca pacchānutappati’’. ",
  "ja541:171.1": "588. ‘‘Bahūpakāro no bhavaṃ, ",
  "ja541:171.2": "mātali devasārathi; ",
  "ja541:171.3": "Yo me kalyāṇakammānaṃ, ",
  "ja541:171.4": "pāpānaṃ paṭidassayi’’ . ",
  "ja541:172.1": "589. ‘‘Idaṃ vatvā nimirājā, ",
  "ja541:172.2": "vedeho mithilaggaho; ",
  "ja541:172.3": "Puthuyaññaṃ yajitvāna, ",
  "ja541:172.4": "saṃyamaṃ ajjhupāgamī’’ti. ",
  "ja541:173.1": "Nimijātakaṃ catutthaṃ. "
}
