  "ja7:0.4": "7. 7. Kaṭṭhahārijātakaṃ ",
  "ja7:1.1": "Putto tyāhaṃ mahārāja, ",
  "ja7:1.2": "tvaṃ maṃ posa janādhipa; ",
  "ja7:1.3": "Aññepi devo poseti, ",
  "ja7:1.4": "kiñca devo sakaṃ pajanti. ",
  "ja7:2.1": "Kaṭṭhahāri jātakaṃ sattamaṃ. "
}
