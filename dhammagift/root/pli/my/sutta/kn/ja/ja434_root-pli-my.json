  "ja434:0.4": "69. 434. Cakkavākajātakaṃ (8) ",
  "ja434:1.1": "Kāsāyavatthe sakuṇe vadāmi, ",
  "ja434:1.2": "duve duve nandamane carante; ",
  "ja434:1.3": "Kaṃ aṇḍajaṃ aṇḍajā mānusesu, ",
  "ja434:1.4": "jātiṃ pasaṃsanti tadiṅgha brūtha. ",
  "ja434:2.1": "70. Amhe manussesu manussahiṃsa, ",
  "ja434:2.2": "anubbate cakkavāke vadanti; ",
  "ja434:2.3": "Kalyāṇabhāvamhe dijesu sammatā, ",
  "ja434:2.4": "abhirūpā vicarāma aṇṇave. ( ) ",
  "ja434:2.5": "",
  "ja434:3.1": "71. Kiṃ aṇṇave kāni phalāni bhuñje, ",
  "ja434:3.2": "maṃsaṃ kuto khādatha cakkavākā; ",
  "ja434:3.3": "Kiṃ bhojanaṃ bhuñjatha vo anomā , ",
  "ja434:3.4": "balañca vaṇṇo ca anapparūpā . ",
  "ja434:4.1": "72. Na aṇṇave santi phalāni dhaṅka, ",
  "ja434:4.2": "maṃsaṃ kuto khādituṃ cakkavāke; ",
  "ja434:4.3": "Sevālabhakkhamha apāṇabhojanā , ",
  "ja434:4.4": "na ghāsahetūpi karoma pāpaṃ. ",
  "ja434:5.1": "73. Na me idaṃ ruccati cakkavāka, ",
  "ja434:5.2": "asmiṃ bhave bhojanasannikāso; ",
  "ja434:5.3": "Ahosi pubbe tato me aññathā, ",
  "ja434:5.4": "icceva me vimati ettha jātā. ",
  "ja434:6.1": "74. Ahampi maṃsāni phalāni bhuñje, ",
  "ja434:6.2": "annāni ca loṇiyateliyāni; ",
  "ja434:6.3": "Rasaṃ manussesu labhāmi bhottuṃ, ",
  "ja434:6.4": "sūrova saṅgāmamukhaṃ vijetvā; ",
  "ja434:6.5": "Na ca me tādiso vaṇṇo, ",
  "ja434:6.6": "cakkavāka yathā tava. ",
  "ja434:7.1": "75. Asuddhabhakkhosi khaṇānupātī, ",
  "ja434:7.2": "kicchena te labbhati annapānaṃ; ",
  "ja434:7.3": "Na tussasī rukkhaphalehi dhaṅka, ",
  "ja434:7.4": "maṃsāni vā yāni susānamajjhe. ",
  "ja434:8.1": "76. Yo sāhasena adhigamma bhoge, ",
  "ja434:8.2": "paribhuñjati dhaṅka khaṇānupātī; ",
  "ja434:8.3": "Tato upakkosati naṃ sabhāvo, ",
  "ja434:8.4": "upakkuṭṭho vaṇṇabalaṃ jahāti. ",
  "ja434:9.1": "77. Appampi ce nibbutiṃ bhuñjatī yadi, ",
  "ja434:9.2": "asāhasena aparūpaghātī ; ",
  "ja434:9.3": "Balañca vaṇṇo ca tadassa hoti, ",
  "ja434:9.4": "na hi sabbo āhāramayena vaṇṇoti. ",
  "ja434:10.1": "Cakkavākajātakaṃ aṭṭhamaṃ. "
}
