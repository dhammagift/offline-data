  "ja88:0.4": "88. 88. Sārambhajātakaṃ ",
  "ja88:1.1": "Kalyāṇimeva muñceyya, ",
  "ja88:1.2": "na hi muñceyya pāpikaṃ; ",
  "ja88:1.3": "Mokkho kalyāṇiyā sādhu, ",
  "ja88:1.4": "mutvā tappati pāpikanti. ",
  "ja88:2.1": "Sārambhajātakaṃ aṭṭhamaṃ. "
}
