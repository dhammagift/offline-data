  "ja172:0.3": "",
  "ja172:0.4": "172. Daddarajātakaṃ (2-3-2) 43. ",
  "ja172:1.1": "Ko nu saddena mahatā, ",
  "ja172:1.2": "abhinādeti daddaraṃ; ",
  "ja172:1.3": "Taṃ sīhā nappaṭinadanti , ",
  "ja172:1.4": "ko nāmeso migādhibhū. ",
  "ja172:2.1": "44. Adhamo migajātānaṃ, ",
  "ja172:2.2": "siṅgālo tāta vassati; ",
  "ja172:2.3": "Jātimassa jigucchantā, ",
  "ja172:2.4": "tuṇhī sīhā samacchareti. ",
  "ja172:3.1": "Daddarajātakaṃ dutiyaṃ. "
}
