  "ja212:0.4": "123. 212. Ucchiṭṭhabhattajātakaṃ (2-7-2) ",
  "ja212:1.1": "Añño uparimo vaṇṇo, ",
  "ja212:1.2": "añño vaṇṇo ca heṭṭhimo; ",
  "ja212:1.3": "Brāhmaṇī tveva pucchāmi, ",
  "ja212:1.4": "kiṃ heṭṭhā kiñca uppari. ",
  "ja212:2.1": "124. Ahaṃ naṭosmi bhaddante, ",
  "ja212:2.2": "bhikkhakosmi idhāgato; ",
  "ja212:2.3": "Ayañhi koṭṭhamotiṇṇo, ",
  "ja212:2.4": "ayaṃ so yaṃ gavesasīti. ",
  "ja212:3.1": "Ucchiṭṭhabhattajātakaṃ dutiyaṃ. "
}
