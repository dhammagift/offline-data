  "ja419:0.4": "419. Sulasājātakaṃ (3) 18. ",
  "ja419:1.1": "Idaṃ suvaṇṇakāyūraṃ, ",
  "ja419:1.2": "muttā veḷuriyā bahū; ",
  "ja419:1.3": "Sabbaṃ harassu bhaddante, ",
  "ja419:1.4": "mañca dāsīti sāvaya. ",
  "ja419:2.1": "19. Oropayassu kalyāṇi, ",
  "ja419:2.2": "mā bāḷhaṃ paridevasi; ",
  "ja419:2.3": "Na cāhaṃ abhijānāmi, ",
  "ja419:2.4": "ahantvā dhanamābhataṃ. ",
  "ja419:3.1": "20. Yato sarāmi attānaṃ, ",
  "ja419:3.2": "yato pattāsmi viññutaṃ; ",
  "ja419:3.3": "Na cāhaṃ abhijānāmi, ",
  "ja419:3.4": "aññaṃ piyataraṃ tayā. ",
  "ja419:4.1": "21. Ehi taṃ upagūhissaṃ , ",
  "ja419:4.2": "karissañca padakkhiṇaṃ; ",
  "ja419:4.3": "Na hi dāni puna atthi, ",
  "ja419:4.4": "mama tuyhañca saṅgamo. ",
  "ja419:5.1": "22. Na hi sabbesu ṭhānesu, ",
  "ja419:5.2": "puriso hoti paṇḍito; ",
  "ja419:5.3": "Itthīpi paṇḍitā hoti, ",
  "ja419:5.4": "tattha tattha vicakkhaṇā. ",
  "ja419:6.1": "23. Na hi sabbesu ṭhānesu, ",
  "ja419:6.2": "puriso hoti paṇḍito; ",
  "ja419:6.3": "Itthīpi paṇḍitā hoti, ",
  "ja419:6.4": "lahuṃ atthaṃ vicintikā . ",
  "ja419:7.1": "24. Lahuñca vata khippañca, ",
  "ja419:7.2": "nikaṭṭhe samacetayi; ",
  "ja419:7.3": "Migaṃ puṇṇāyateneva , ",
  "ja419:7.4": "sulasā sattukaṃ vadhi. ",
  "ja419:8.1": "25. Yodha uppatitaṃ atthaṃ, ",
  "ja419:8.2": "na khippamanubujjhati; ",
  "ja419:8.3": "So haññati mandamati, ",
  "ja419:8.4": "corova girigabbhare. ",
  "ja419:9.1": "26. Yo ca uppatitaṃ atthaṃ, ",
  "ja419:9.2": "khippameva nibodhati; ",
  "ja419:9.3": "Muccate sattusambādhā, ",
  "ja419:9.4": "sulasā sattukāmivāti. ",
  "ja419:10.1": "Sulasājātakaṃ tatiyaṃ. "
}
