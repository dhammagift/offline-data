  "ja191:0.3": "5. Ruhakavaggo ",
  "ja191:0.4": "191. Ruhakajātakaṃ (2-5-1) 81. ",
  "ja191:1.1": "Api ruhaka chinnāpi, ",
  "ja191:1.2": "jiyā sandhīyate puna; ",
  "ja191:1.3": "Sandhīyassu purāṇiyā, ",
  "ja191:1.4": "mā kodhassa vasaṃ gami. ",
  "ja191:2.1": "82. Vijjamānesu vākesu , ",
  "ja191:2.2": "vijjamānesu kārisu; ",
  "ja191:2.3": "Aññaṃ jiyaṃ karissāmi, ",
  "ja191:2.4": "alaññeva purāṇiyāti. ",
  "ja191:3.1": "Ruhakajātakaṃ paṭhamaṃ. "
}
