  "ja542:0.4": "590. 542. Umaṅgajātakaṃ (5) ",
  "ja542:1.1": "‘‘Pañcālo sabbasenāya, ",
  "ja542:1.2": "brahmadattoyamāgato; ",
  "ja542:1.3": "Sāyaṃ pañcāliyā senā, ",
  "ja542:1.4": "appameyyā mahosadha. ",
  "ja542:2.1": "591. ‘‘Vīthimatī pattimatī, ",
  "ja542:2.2": "sabbasaṅgāmakovidā; ",
  "ja542:2.3": "Ohārinī saddavatī, ",
  "ja542:2.4": "bherisaṅkhappabodhanā. ",
  "ja542:3.1": "592. ‘‘Lohavijjā alaṅkārā, ",
  "ja542:3.2": "dhajinī vāmarohinī; ",
  "ja542:3.3": "Sippiyehi susampannā, ",
  "ja542:3.4": "sūrehi suppatiṭṭhitā. ",
  "ja542:4.1": "593. ‘‘Dasettha paṇḍitā āhu, ",
  "ja542:4.2": "bhūripaññā rahogamā ; ",
  "ja542:4.3": "Mātā ekādasī rañño, ",
  "ja542:4.4": "pañcāliyaṃ pasāsati. ",
  "ja542:5.1": "594. ‘‘Athetthekasataṃ khatyā, ",
  "ja542:5.2": "anuyantā yasassino; ",
  "ja542:5.3": "Acchinnaraṭṭhā byathitā, ",
  "ja542:5.4": "pañcāliyaṃ vasaṃ gatā. ",
  "ja542:6.1": "595. ‘‘Yaṃvadā-takkarā rañño, ",
  "ja542:6.2": "akāmā piyabhāṇino; ",
  "ja542:6.3": "Pañcālamanuyāyanti, ",
  "ja542:6.4": "akāmā vasino gatā. ",
  "ja542:7.1": "596. ‘‘Tāya senāya mithilā, ",
  "ja542:7.2": "tisandhiparivāritā; ",
  "ja542:7.3": "Rājadhānī videhānaṃ, ",
  "ja542:7.4": "samantā parikhaññati. ",
  "ja542:8.1": "597. ‘‘Uddhaṃ tārakajātāva, ",
  "ja542:8.2": "samantā parivāritā; ",
  "ja542:8.3": "Mahosadha vijānāhi, ",
  "ja542:8.4": "kathaṃ mokkho bhavissati’’. ",
  "ja542:9.1": "598. ‘‘Pāde deva pasārehi, ",
  "ja542:9.2": "bhuñja kāme ramassu ca; ",
  "ja542:9.3": "Hitvā pañcāliyaṃ senaṃ, ",
  "ja542:9.4": "brahmadatto palāyiti’’ . ",
  "ja542:10.1": "599. ‘‘Rājā santhavakāmo te, ",
  "ja542:10.2": "ratanāni pavecchati; ",
  "ja542:10.3": "Āgacchantu ito dūtā, ",
  "ja542:10.4": "mañjukā piyabhāṇino. ",
  "ja542:11.1": "600. ‘‘Bhāsantu mudukā vācā, ",
  "ja542:11.2": "yā vācā paṭinanditā; ",
  "ja542:11.3": "Pañcālo ca videho ca , ",
  "ja542:11.4": "ubho ekā bhavantu te’’. ",
  "ja542:12.1": "601. ‘‘Kathaṃ nu kevaṭṭa mahosadhena, ",
  "ja542:12.2": "samāgamo āsi tadiṅgha brūhi; ",
  "ja542:12.3": "Kacci te paṭinijjhatto, ",
  "ja542:12.4": "kacci tuṭṭho mahosadho’’. ",
  "ja542:13.1": "602. ‘‘Anariyarūpo puriso janinda, ",
  "ja542:13.2": "asammodako thaddho asabbhirūpo; ",
  "ja542:13.3": "Yathā mūgo ca badhiro ca, ",
  "ja542:13.4": "na kiñcitthaṃ abhāsatha’’ . ",
  "ja542:14.1": "603. ‘‘Addhā idaṃ mantapadaṃ sududdasaṃ, ",
  "ja542:14.2": "attho suddho naravīriyena diṭṭho; ",
  "ja542:14.3": "Tathā hi kāyo mama sampavedhati, ",
  "ja542:14.4": "hitvā sayaṃ ko parahatthamessati’’. ",
  "ja542:15.1": "604. ‘‘Channañhi ekāva matī sameti, ",
  "ja542:15.2": "ye paṇḍitā uttamabhūripattā; ",
  "ja542:15.3": "Yānaṃ ayānaṃ atha vāpi ṭhānaṃ, ",
  "ja542:15.4": "mahosadha tvampi matiṃ karohi’’. ",
  "ja542:16.1": "605. ‘‘Jānāsi kho rāja mahānubhāvo, ",
  "ja542:16.2": "mahabbalo cūḷanibrahmadatto; ",
  "ja542:16.3": "Rājā ca taṃ icchati māraṇatthaṃ , ",
  "ja542:16.4": "migaṃ yathā okacarena luddo. ",
  "ja542:17.1": "606. ‘‘Yathāpi maccho baḷisaṃ, ",
  "ja542:17.2": "vaṅkaṃ maṃsena chāditaṃ; ",
  "ja542:17.3": "Āmagiddho na jānāti, ",
  "ja542:17.4": "maccho maraṇamattano. ",
  "ja542:18.1": "607. ‘‘Evameva tuvaṃ rāja, ",
  "ja542:18.2": "cūḷaneyyassa dhītaraṃ; ",
  "ja542:18.3": "Kāmagiddho na jānāsi, ",
  "ja542:18.4": "macchova maraṇamattano. ",
  "ja542:19.1": "608. ‘‘Sace gacchasi pañcālaṃ, ",
  "ja542:19.2": "khippamattaṃ jahissati; ",
  "ja542:19.3": "Migaṃ panthānubandhaṃva , ",
  "ja542:19.4": "mahantaṃ bhayamessati’’. ",
  "ja542:20.1": "609. ‘‘Mayameva bālamhase eḷamūgā, ",
  "ja542:20.2": "ye uttamatthāni tayī lapimhā; ",
  "ja542:20.3": "Kimeva tvaṃ naṅgalakoṭivaḍḍho, ",
  "ja542:20.4": "atthāni jānāsi yathāpi aññe’’. ",
  "ja542:21.1": "610. ‘‘Imaṃ gale gahetvāna, ",
  "ja542:21.2": "nāsetha vijitā mama; ",
  "ja542:21.3": "Yo me ratanalābhassa, ",
  "ja542:21.4": "antarāyāya bhāsati’’. ",
  "ja542:22.1": "611. ‘‘Tato ca so apakkamma, ",
  "ja542:22.2": "vedehassa upantikā; ",
  "ja542:22.3": "Atha āmantayī dūtaṃ, ",
  "ja542:22.4": "mādharaṃ suvapaṇḍitaṃ. ",
  "ja542:23.1": "612. ‘‘Ehi samma haritapakkha , ",
  "ja542:23.2": "veyyāvaccaṃ karohi me; ",
  "ja542:23.3": "Atthi pañcālarājassa, ",
  "ja542:23.4": "sāḷikā sayanapālikā. ",
  "ja542:24.1": "613. ‘Taṃ bandhanena pucchassu, ",
  "ja542:24.2": "sā hi sabbassa kovidā; ",
  "ja542:24.3": "Sā tesaṃ sabbaṃ jānāti, ",
  "ja542:24.4": "rañño ca kosiyassa ca. ",
  "ja542:25.1": "614. ‘‘‘Āmo’ti so paṭissutvā, ",
  "ja542:25.2": "mādharo suvapaṇḍito; ",
  "ja542:25.3": "Agamāsi haritapakkho , ",
  "ja542:25.4": "sāḷikāya upantikaṃ. ",
  "ja542:26.1": "615. ‘‘Tato ca kho so gantvāna, ",
  "ja542:26.2": "mādharo suvapaṇḍito; ",
  "ja542:26.3": "Athāmantayi sugharaṃ, ",
  "ja542:26.4": "sāḷikaṃ mañjubhāṇikaṃ. ",
  "ja542:27.1": "616. ‘Kacci te sughare khamanīyaṃ, ",
  "ja542:27.2": "kacci vesse anāmayaṃ; ",
  "ja542:27.3": "Kacci te madhunā lājā, ",
  "ja542:27.4": "labbhate sughare tuvaṃ’ . ",
  "ja542:28.1": "617. ‘Kusalañceva me samma, ",
  "ja542:28.2": "atho samma anāmayaṃ; ",
  "ja542:28.3": "Atho me madhunā lājā, ",
  "ja542:28.4": "labbhate suvapaṇḍita. ",
  "ja542:29.1": "618. ‘Kuto nu samma āgamma, ",
  "ja542:29.2": "kassa vā pahito tuvaṃ; ",
  "ja542:29.3": "Na ca mesi ito pubbe, ",
  "ja542:29.4": "diṭṭho vā yadi vā suto’’. ",
  "ja542:30.1": "619. ‘‘Ahosiṃ sivirājassa, ",
  "ja542:30.2": "pāsāde sayanapālako; ",
  "ja542:30.3": "Tato so dhammiko rājā, ",
  "ja542:30.4": "baddhe mocesi bandhanā’’. ",
  "ja542:31.1": "620. ‘‘Tassa mekā dutiyāsi, ",
  "ja542:31.2": "sāḷikā mañjubhāṇikā; ",
  "ja542:31.3": "Taṃ tattha avadhī seno, ",
  "ja542:31.4": "pekkhato sughare mama’’. ",
  "ja542:32.1": "621. ‘‘Tassā kāmā hi sammatto, ",
  "ja542:32.2": "āgatosmi tavantike; ",
  "ja542:32.3": "Sace kareyya okāsaṃ, ",
  "ja542:32.4": "ubhayova vasāmase’’. ",
  "ja542:33.1": "622. ‘‘Suvova suviṃ kāmeyya, ",
  "ja542:33.2": "sāḷiko pana sāḷikaṃ; ",
  "ja542:33.3": "Suvassa sāḷikāyeva , ",
  "ja542:33.4": "saṃvāso hoti kīdiso’’. ",
  "ja542:34.1": "623. ‘‘Yoyaṃ kāme kāmayati, ",
  "ja542:34.2": "api caṇḍālikāmapi; ",
  "ja542:34.3": "Sabbo hi sadiso hoti, ",
  "ja542:34.4": "natthi kāme asādiso’’. ",
  "ja542:35.1": "624. ‘‘Atthi jampāvatī nāma, ",
  "ja542:35.2": "mātā sivissa rājino; ",
  "ja542:35.3": "Sā bhariyā vāsudevassa, ",
  "ja542:35.4": "kaṇhassa mahesī piyā. ",
  "ja542:36.1": "625. ‘‘Raṭṭhavatī kimpurisī, ",
  "ja542:36.2": "sāpi vacchaṃ akāmayi; ",
  "ja542:36.3": "Manusso migiyā saddhiṃ, ",
  "ja542:36.4": "natthi kāme asādiso’’. ",
  "ja542:37.1": "626. ‘‘Handa khvāhaṃ gamissāmi, ",
  "ja542:37.2": "sāḷike mañjubhāṇike; ",
  "ja542:37.3": "Paccakkhānupadañhetaṃ, ",
  "ja542:37.4": "atimaññasi nūna maṃ’’. ",
  "ja542:38.1": "627. ‘‘Na sirī taramānassa, ",
  "ja542:38.2": "mādhara suvapaṇḍita; ",
  "ja542:38.3": "Idheva tāva acchassu, ",
  "ja542:38.4": "yāva rājāna dakkhasi ; ",
  "ja542:38.5": "Sossi saddaṃ mudiṅgānaṃ, ",
  "ja542:38.6": "ānubhāvañca rājino’’. ",
  "ja542:39.1": "628. ‘‘Yo nu khvāyaṃ tibbo saddo, ",
  "ja542:39.2": "tirojanapade suto; ",
  "ja542:39.3": "Dhītā pañcālarājassa, ",
  "ja542:39.4": "osadhī viya vaṇṇinī; ",
  "ja542:39.5": "Taṃ dassati videhānaṃ, ",
  "ja542:39.6": "so vivāho bhavissati’’. ",
  "ja542:40.1": "629. ‘‘Ediso mā amittānaṃ, ",
  "ja542:40.2": "vivāho hotu mādhara; ",
  "ja542:40.3": "Yathā pañcālarājassa, ",
  "ja542:40.4": "vedehena bhavissati’’. ",
  "ja542:41.1": "630. ‘‘Ānayitvāna vedehaṃ, ",
  "ja542:41.2": "pañcālānaṃ rathesabho; ",
  "ja542:41.3": "Tato naṃ ghātayissati, ",
  "ja542:41.4": "nassa sakhī bhavissati’’. ",
  "ja542:42.1": "631. ‘‘Handa kho maṃ anujānāhi, ",
  "ja542:42.2": "rattiyo sattamattiyo; ",
  "ja542:42.3": "Yāvāhaṃ sivirājassa, ",
  "ja542:42.4": "ārocemi mahesino; ",
  "ja542:42.5": "Laddho ca me āvasatho, ",
  "ja542:42.6": "sāḷikāya upantikaṃ’’ . ",
  "ja542:43.1": "632. ‘‘Handa kho taṃ anujānāmi, ",
  "ja542:43.2": "rattiyo sattamattiyo; ",
  "ja542:43.3": "Sace tvaṃ sattarattena, ",
  "ja542:43.4": "nāgacchasi mamantike; ",
  "ja542:43.5": "Maññe okkantasattaṃ maṃ, ",
  "ja542:43.6": "matāya āgamissasi’’. ",
  "ja542:44.1": "633. ‘‘Tato ca kho so gantvāna, ",
  "ja542:44.2": "mādharo suvapaṇḍito; ",
  "ja542:44.3": "Mahosadhassa akkhāsi, ",
  "ja542:44.4": "sāḷikāvacanaṃ idaṃ’’. ",
  "ja542:45.1": "634. ‘‘Yasseva ghare bhuñjeyya bhogaṃ, ",
  "ja542:45.2": "tasseva atthaṃ puriso careyya’’; ",
  "ja542:45.3": "‘‘Handāhaṃ gacchāmi pure janinda, ",
  "ja542:45.4": "pañcālarājassa puraṃ surammaṃ; ",
  "ja542:45.5": "Nivesanāni māpetuṃ, ",
  "ja542:45.6": "vedehassa yasassino. ",
  "ja542:46.1": "635. ‘‘Nivesanāni māpetvā, ",
  "ja542:46.2": "vedehassa yasassino; ",
  "ja542:46.3": "Yadā te pahiṇeyyāmi, ",
  "ja542:46.4": "tadā eyyāsi khattiya’’. ",
  "ja542:47.1": "636. ‘‘Tato ca pāyāsi pure mahosadho, ",
  "ja542:47.2": "pañcālarājassa puraṃ surammaṃ; ",
  "ja542:47.3": "Nivesanāni māpetuṃ, ",
  "ja542:47.4": "vedehassa yasassino’’. ",
  "ja542:48.1": "637. ‘‘Nivesanāni māpetvā, ",
  "ja542:48.2": "vedehassa yasassino; ",
  "ja542:48.3": "Athassa pāhiṇī dūtaṃ, ",
  "ja542:48.4": "vedehaṃ mithilaggahaṃ ; ",
  "ja542:48.5": "Ehi dāni mahārāja, ",
  "ja542:48.6": "māpitaṃ te nivesanaṃ’’. ",
  "ja542:49.1": "638. ‘‘Tato ca rājā pāyāsi, ",
  "ja542:49.2": "senāya caturaṅgiyā ; ",
  "ja542:49.3": "Anantavāhanaṃ daṭṭhuṃ, ",
  "ja542:49.4": "phītaṃ kapiliyaṃ puraṃ’’. ",
  "ja542:50.1": "639. ‘‘Tato ca kho so gantvāna, ",
  "ja542:50.2": "brahmadattassa pāhiṇi; ",
  "ja542:50.3": "‘Āgato’smi mahārāja, ",
  "ja542:50.4": "tava pādāni vandituṃ. ",
  "ja542:51.1": "640. ‘Dadāhi dāni me bhariyaṃ, ",
  "ja542:51.2": "nāriṃ sabbaṅgasobhiniṃ; ",
  "ja542:51.3": "Suvaṇṇena paṭicchannaṃ, ",
  "ja542:51.4": "dāsīgaṇapurakkhataṃ’’’. ",
  "ja542:52.1": "641. ‘‘Svāgataṃ teva vedeha, ",
  "ja542:52.2": "atho te adurāgataṃ; ",
  "ja542:52.3": "Nakkhattaṃyeva paripuccha, ",
  "ja542:52.4": "ahaṃ kaññaṃ dadāmi te; ",
  "ja542:52.5": "Suvaṇṇena paṭicchannaṃ, ",
  "ja542:52.6": "dāsīgaṇapurakkhataṃ’’. ",
  "ja542:53.1": "642. ‘‘Tato ca rājā vedeho, ",
  "ja542:53.2": "nakkhattaṃ paripucchatha ; ",
  "ja542:53.3": "Nakkhattaṃ paripucchitvā, ",
  "ja542:53.4": "brahmadattassa pāhiṇi. ",
  "ja542:54.1": "643. ‘‘Dadāhi dāni me bhariyaṃ, ",
  "ja542:54.2": "nāriṃ sabbaṅgasobhiniṃ; ",
  "ja542:54.3": "Suvaṇṇena paṭicchannaṃ, ",
  "ja542:54.4": "dāsīgaṇapurakkhataṃ’’. ",
  "ja542:55.1": "644. ‘‘Dadāmi dāni te bhariyaṃ, ",
  "ja542:55.2": "nāriṃ sabbaṅgasobhiniṃ; ",
  "ja542:55.3": "Suvaṇṇena paṭicchannaṃ, ",
  "ja542:55.4": "dāsīgaṇapurakkhataṃ’’. ",
  "ja542:56.1": "645. ‘‘Hatthī assā rathā pattī, ",
  "ja542:56.2": "senā tiṭṭhanti vammitā ; ",
  "ja542:56.3": "Ukkā padittā jhāyanti, ",
  "ja542:56.4": "kinnu maññanti paṇḍitā. ",
  "ja542:57.1": "646. ‘‘Hatthī assā rathā pattī, ",
  "ja542:57.2": "senā tiṭṭhanti vammitā ; ",
  "ja542:57.3": "Ukkā padittā jhāyanti, ",
  "ja542:57.4": "kiṃ nu kāhanti paṇḍita’’. ",
  "ja542:58.1": "647. ‘‘Rakkhati taṃ mahārāja, ",
  "ja542:58.2": "cūḷaneyyo mahabbalo; ",
  "ja542:58.3": "Paduṭṭho brahmadattena , ",
  "ja542:58.4": "pāto taṃ ghātayissati’’. ",
  "ja542:59.1": "648. ‘‘Ubbedhati me hadayaṃ, ",
  "ja542:59.2": "mukhañca parisussati; ",
  "ja542:59.3": "Nibbutiṃ nādhigacchāmi, ",
  "ja542:59.4": "aggidaḍḍhova ātape. ",
  "ja542:60.1": "649. ‘‘Kammārānaṃ yathā ukkā, ",
  "ja542:60.2": "anto jhāyati no bahi; ",
  "ja542:60.3": "Evampi hadayaṃ mayhaṃ, ",
  "ja542:60.4": "anto jhāyati no bahi’’. ",
  "ja542:61.1": "650. ‘‘Pamatto mantanātīto, ",
  "ja542:61.2": "bhinnamantosi khattiya; ",
  "ja542:61.3": "Idāni kho taṃ tāyantu, ",
  "ja542:61.4": "paṇḍitā mantino janā. ",
  "ja542:62.1": "651. ‘‘Akatvāmaccassa vacanaṃ, ",
  "ja542:62.2": "atthakāmahitesino; ",
  "ja542:62.3": "Attapītirato rājā, ",
  "ja542:62.4": "migo kūṭeva ohito. ",
  "ja542:63.1": "652. ‘‘Yathāpi maccho baḷisaṃ, ",
  "ja542:63.2": "vaṅkaṃ maṃsena chāditaṃ; ",
  "ja542:63.3": "Āmagiddho na jānāti, ",
  "ja542:63.4": "maccho maraṇamattano. ",
  "ja542:64.1": "653. ‘‘Evameva tuvaṃ rāja, ",
  "ja542:64.2": "cūḷaneyyassa dhītaraṃ; ",
  "ja542:64.3": "Kāmagiddho na jānāsi, ",
  "ja542:64.4": "macchova maraṇamattano. ",
  "ja542:65.1": "654. ‘‘Sace gacchasi pañcālaṃ, ",
  "ja542:65.2": "khippamattaṃ jahissasi; ",
  "ja542:65.3": "Migaṃ panthānubandhaṃva, ",
  "ja542:65.4": "mahantaṃ bhayamessati. ",
  "ja542:66.1": "655. ‘‘Anariyarūpo puriso janinda, ",
  "ja542:66.2": "ahīva ucchaṅgagato ḍaseyya; ",
  "ja542:66.3": "Na tena mittiṃ kayirātha dhīro , ",
  "ja542:66.4": "dukkho have kāpurisena saṅgamo. ",
  "ja542:67.1": "656. ‘‘Yadeva jaññā purisaṃ janinda, ",
  "ja542:67.2": "sīlavāyaṃ bahussuto; ",
  "ja542:67.3": "Teneva mittiṃ kayirātha dhīro, ",
  "ja542:67.4": "sukho have sappurisena saṅgamo’’. ",
  "ja542:68.1": "657. ‘‘Bālo tuvaṃ eḷamūgosi rāja, ",
  "ja542:68.2": "yo uttamatthāni mayī lapittho; ",
  "ja542:68.3": "Kimevahaṃ naṅgalakoṭivaḍḍho, ",
  "ja542:68.4": "atthāni jānāmi yathāpi aññe. ",
  "ja542:69.1": "658. ‘‘Imaṃ gale gahetvāna, ",
  "ja542:69.2": "nāsetha vijitā mama; ",
  "ja542:69.3": "Yo me ratanalābhassa, ",
  "ja542:69.4": "antarāyāya bhāsati’’. ",
  "ja542:70.1": "659. ‘‘Mahosadha atītena, ",
  "ja542:70.2": "nānuvijjhanti paṇḍitā; ",
  "ja542:70.3": "Kiṃ maṃ assaṃva sambandhaṃ, ",
  "ja542:70.4": "patodeneva vijjhasi. ",
  "ja542:71.1": "660. ‘‘Sace passasi mokkhaṃ vā, ",
  "ja542:71.2": "khemaṃ vā pana passasi; ",
  "ja542:71.3": "Teneva maṃ anusāsa, ",
  "ja542:71.4": "kiṃ atītena vijjhasi’’. ",
  "ja542:72.1": "661. ‘‘Atītaṃ mānusaṃ kammaṃ, ",
  "ja542:72.2": "dukkaraṃ durabhisambhavaṃ; ",
  "ja542:72.3": "Na taṃ sakkomi mocetuṃ, ",
  "ja542:72.4": "tvaṃ pajānassu khattiya. ",
  "ja542:73.1": "662. ‘‘Santi vehāyasā nāgā, ",
  "ja542:73.2": "iddhimanto yasassino; ",
  "ja542:73.3": "Tepi ādāya gaccheyyuṃ, ",
  "ja542:73.4": "yassa honti tathāvidhā. ",
  "ja542:74.1": "663. ‘‘Santi vehāyasā assā, ",
  "ja542:74.2": "iddhimanto yasassino; ",
  "ja542:74.3": "Tepi ādāya gaccheyyuṃ, ",
  "ja542:74.4": "yassa honti tathāvidhā. ",
  "ja542:75.1": "664. ‘‘Santi vehāyasā pakkhī, ",
  "ja542:75.2": "iddhimanto yasassino; ",
  "ja542:75.3": "Tepi ādāya gaccheyyuṃ, ",
  "ja542:75.4": "yassa honti tathāvidhā. ",
  "ja542:76.1": "665. ‘‘Santi vehāyasā yakkhā, ",
  "ja542:76.2": "iddhimanto yasassino; ",
  "ja542:76.3": "Tepi ādāya gaccheyyuṃ, ",
  "ja542:76.4": "yassa honti tathāvidhā. ",
  "ja542:77.1": "666. ‘‘Atītaṃ mānusaṃ kammaṃ, ",
  "ja542:77.2": "dukkaraṃ durabhisambhavaṃ; ",
  "ja542:77.3": "Na taṃ sakkomi mocetuṃ, ",
  "ja542:77.4": "antalikkhena khattiya’’. ",
  "ja542:78.1": "667. ‘‘Atīradassī puriso, ",
  "ja542:78.2": "mahante udakaṇṇave; ",
  "ja542:78.3": "Yattha so labhate gādhaṃ , ",
  "ja542:78.4": "tattha so vindate sukhaṃ. ",
  "ja542:79.1": "668. ‘‘Evaṃ amhañca rañño ca, ",
  "ja542:79.2": "tvaṃ patiṭṭhā mahosadha; ",
  "ja542:79.3": "Tvaṃ nosi mantinaṃ seṭṭho, ",
  "ja542:79.4": "amhe dukkhā pamocaya’’. ",
  "ja542:80.1": "669. ‘‘Atītaṃ mānusaṃ kammaṃ, ",
  "ja542:80.2": "dukkaraṃ durabhisambhavaṃ; ",
  "ja542:80.3": "Na taṃ sakkomi mocetuṃ, ",
  "ja542:80.4": "tvaṃ pajānassu senaka’’. ",
  "ja542:81.1": "670. ‘‘Suṇohi metaṃ vacanaṃ, ",
  "ja542:81.2": "passa senaṃ mahabbhayaṃ; ",
  "ja542:81.3": "Senakaṃ dāni pucchāmi, ",
  "ja542:81.4": "kiṃ kiccaṃ idha maññasi’’. ",
  "ja542:82.1": "671. ‘‘Aggiṃ vā dvārato dema, ",
  "ja542:82.2": "gaṇhāmase vikantanaṃ ; ",
  "ja542:82.3": "Aññamaññaṃ vadhitvāna, ",
  "ja542:82.4": "khippaṃ hissāma jīvitaṃ; ",
  "ja542:82.5": "Mā no rājā brahmadatto, ",
  "ja542:82.6": "ciraṃ dukkhena mārayi’’. ",
  "ja542:83.1": "672. ‘‘Suṇohi metaṃ vacanaṃ, ",
  "ja542:83.2": "passa senaṃ mahabbhayaṃ; ",
  "ja542:83.3": "Pukkusaṃ dāni pucchāmi, ",
  "ja542:83.4": "kiṃ kiccaṃ idha maññasi’’. ",
  "ja542:84.1": "673. ‘‘Visaṃ khāditvā miyyāma, ",
  "ja542:84.2": "khippaṃ hissāma jīvitaṃ; ",
  "ja542:84.3": "Mā no rājā brahmadatto, ",
  "ja542:84.4": "ciraṃ dukkhena mārayi’’. ",
  "ja542:85.1": "674. ‘‘Suṇohi metaṃ vacanaṃ, ",
  "ja542:85.2": "passa senaṃ mahabbhayaṃ; ",
  "ja542:85.3": "Kāmindaṃ dāni pucchāmi, ",
  "ja542:85.4": "kiṃ kiccaṃ idha maññasi’’. ",
  "ja542:86.1": "675. ‘‘Rajjuyā bajjha miyyāma, ",
  "ja542:86.2": "papātā papatāmase ; ",
  "ja542:86.3": "Mā no rājā brahmadatto, ",
  "ja542:86.4": "ciraṃ dukkhena mārayi’’. ",
  "ja542:87.1": "676. ‘‘Suṇohi metaṃ vacanaṃ, ",
  "ja542:87.2": "passa senaṃ mahabbhayaṃ; ",
  "ja542:87.3": "Devindaṃ dāni pucchāmi, ",
  "ja542:87.4": "kiṃ kiccaṃ idha maññasi’’. ",
  "ja542:88.1": "677. ‘‘Aggiṃ vā dvārato dema, ",
  "ja542:88.2": "gaṇhāmase vikantanaṃ; ",
  "ja542:88.3": "Aññamaññaṃ vadhitvāna, ",
  "ja542:88.4": "khippaṃ hissāma jīvitaṃ; ",
  "ja542:88.5": "Na no sakkoti mocetuṃ, ",
  "ja542:88.6": "sukheneva mahosadho’’. ",
  "ja542:89.1": "678. ‘‘Yathā kadalino sāraṃ, ",
  "ja542:89.2": "anvesaṃ nādhigacchati; ",
  "ja542:89.3": "Evaṃ anvesamānā naṃ, ",
  "ja542:89.4": "pañhaṃ najjhagamāmase. ",
  "ja542:90.1": "679. ‘‘Yathā simbalino sāraṃ, ",
  "ja542:90.2": "anvesaṃ nādhigacchati; ",
  "ja542:90.3": "Evaṃ anvesamānā naṃ, ",
  "ja542:90.4": "pañhaṃ najjhagamāmase. ",
  "ja542:91.1": "680. ‘‘Adese vata no vuṭṭhaṃ, ",
  "ja542:91.2": "kuñjarānaṃvanodake; ",
  "ja542:91.3": "Sakāse dummanussānaṃ, ",
  "ja542:91.4": "bālānaṃ avijānataṃ. ",
  "ja542:92.1": "681. ‘‘Ubbedhati me hadayaṃ, ",
  "ja542:92.2": "mukhañca parisussati; ",
  "ja542:92.3": "Nibbutiṃ nādhigacchāmi, ",
  "ja542:92.4": "aggidaḍḍhova ātape. ",
  "ja542:93.1": "682. ‘‘Kammārānaṃ yathā ukkā, ",
  "ja542:93.2": "anto jhāyati no bahi; ",
  "ja542:93.3": "Evampi hadayaṃ mayhaṃ, ",
  "ja542:93.4": "anto jhāyati no bahi’’. ",
  "ja542:94.1": "683. ‘‘Tato so paṇḍito dhīro, ",
  "ja542:94.2": "atthadassī mahosadho; ",
  "ja542:94.3": "Vedehaṃ dukkhitaṃ disvā, ",
  "ja542:94.4": "idaṃ vacanamabravi. ",
  "ja542:95.1": "684. ‘Mā tvaṃ bhāyi mahārāja, ",
  "ja542:95.2": "mā tvaṃ bhāyi rathesabha; ",
  "ja542:95.3": "Ahaṃ taṃ mocayissāmi, ",
  "ja542:95.4": "rāhuggahaṃva candimaṃ. ",
  "ja542:96.1": "685. ‘Mā tvaṃ bhāyi mahārāja, ",
  "ja542:96.2": "mā tvaṃ bhāyi rathesabha; ",
  "ja542:96.3": "Ahaṃ taṃ mocayissāmi, ",
  "ja542:96.4": "rāhuggahaṃva sūriyaṃ. ",
  "ja542:97.1": "686. ‘‘Mā tvaṃ bhāyi mahārāja, ",
  "ja542:97.2": "mā tvaṃ bhāyi rathesabha; ",
  "ja542:97.3": "Ahaṃ taṃ mocayissāmi, ",
  "ja542:97.4": "paṅke sannaṃva kuñjaraṃ. ",
  "ja542:98.1": "687. ‘Mā tvaṃ bhāyi mahārāja, ",
  "ja542:98.2": "mā tvaṃ bhāyi rathesabha; ",
  "ja542:98.3": "Ahaṃ taṃ mocayissāmi, ",
  "ja542:98.4": "peḷābaddhaṃva pannagaṃ. ",
  "ja542:99.1": "688. ‘Mā tvaṃ bhāyi mahārāja, ",
  "ja542:99.2": "mā tvaṃ bhāyi rathesabha; ",
  "ja542:99.3": "Ahaṃ taṃ mocayissāmi, ",
  "ja542:99.4": "pakkhiṃ baddhaṃva pañjare . ",
  "ja542:100.1": "689. ‘Mā tvaṃ bhāyi mahārāja, ",
  "ja542:100.2": "mā tvaṃ bhāyi rathesabha; ",
  "ja542:100.3": "Ahaṃ taṃ mocayissāmi, ",
  "ja542:100.4": "macche jālagateriva. ",
  "ja542:101.1": "690. ‘Mā tvaṃ bhāyi mahārāja, ",
  "ja542:101.2": "mā tvaṃ bhāyi rathesabha; ",
  "ja542:101.3": "Ahaṃ taṃ mocayissāmi, ",
  "ja542:101.4": "sayoggabalavāhanaṃ. ",
  "ja542:102.1": "691. ‘Mā tvaṃ bhāyi mahārāja, ",
  "ja542:102.2": "mā tvaṃ bhāyi rathesabha; ",
  "ja542:102.3": "Pañcālaṃ vāhayissāmi , ",
  "ja542:102.4": "kākasenaṃva leḍḍunā. ",
  "ja542:103.1": "692. ‘Adu paññā kimatthiyā, ",
  "ja542:103.2": "amacco vāpi tādiso; ",
  "ja542:103.3": "Yo taṃ sambādhapakkhandaṃ , ",
  "ja542:103.4": "dukkhā na parimocaye’’’. ",
  "ja542:104.1": "693. ‘‘Etha māṇavā uṭṭhetha, ",
  "ja542:104.2": "mukhaṃ sodhetha sandhino; ",
  "ja542:104.3": "Vedeho sahamaccehi, ",
  "ja542:104.4": "umaṅgena gamissati’’. ",
  "ja542:105.1": "694. ‘‘Tassa taṃ vacanaṃ sutvā, ",
  "ja542:105.2": "paṇḍitassānucārino ; ",
  "ja542:105.3": "Umaṅgadvāraṃ vivariṃsu, ",
  "ja542:105.4": "yantayutte ca aggaḷe’’. ",
  "ja542:106.1": "695. ‘‘Purato senako yāti, ",
  "ja542:106.2": "pacchato ca mahosadho; ",
  "ja542:106.3": "Majjhe ca rājā vedeho, ",
  "ja542:106.4": "amaccaparivārito’’. ",
  "ja542:107.1": "696. ‘‘Umaṅgā nikkhamitvāna, ",
  "ja542:107.2": "vedeho nāvamāruhi; ",
  "ja542:107.3": "Abhirūḷhañca taṃ ñatvā , ",
  "ja542:107.4": "anusāsi mahosadho. ",
  "ja542:108.1": "697. ‘Ayaṃ te sasuro deva, ",
  "ja542:108.2": "ayaṃ sassu janādhipa; ",
  "ja542:108.3": "Yathā mātu paṭipatti, ",
  "ja542:108.4": "evaṃ te hotu sassuyā. ",
  "ja542:109.1": "698. ‘Yathāpi niyako bhātā, ",
  "ja542:109.2": "saudariyo ekamātuko; ",
  "ja542:109.3": "Evaṃ pañcālacando te, ",
  "ja542:109.4": "dayitabbo rathesabha. ",
  "ja542:110.1": "699. ‘Ayaṃ pañcālacandī te, ",
  "ja542:110.2": "rājaputtī abhicchitā ; ",
  "ja542:110.3": "Kāmaṃ karohi te tāya, ",
  "ja542:110.4": "bhariyā te rathesabha’’’. ",
  "ja542:111.1": "700. ‘‘Āruyha nāvaṃ taramāno, ",
  "ja542:111.2": "kinnu tīramhi tiṭṭhasi; ",
  "ja542:111.3": "Kicchā muttāmha dukkhato, ",
  "ja542:111.4": "yāma dāni mahosadha’’. ",
  "ja542:112.1": "701. ‘‘Nesa dhammo mahārāja, ",
  "ja542:112.2": "yohaṃ senāya nāyako; ",
  "ja542:112.3": "Senaṅgaṃ parihāpetvā, ",
  "ja542:112.4": "attānaṃ parimocaye. ",
  "ja542:113.1": "702. ‘‘Nivesanamhi te deva, ",
  "ja542:113.2": "senaṅgaṃ parihāpitaṃ; ",
  "ja542:113.3": "Taṃ dinnaṃ brahmadattena, ",
  "ja542:113.4": "ānayissaṃ rathesabha’’. ",
  "ja542:114.1": "703. ‘‘Appaseno mahāsenaṃ, ",
  "ja542:114.2": "kathaṃ viggayha ṭhassasi; ",
  "ja542:114.3": "Dubbalo balavantena, ",
  "ja542:114.4": "vihaññissasi paṇḍita’’. ",
  "ja542:115.1": "704. ‘‘Appasenopi ce mantī, ",
  "ja542:115.2": "mahāsenaṃ amantinaṃ; ",
  "ja542:115.3": "Jināti rājā rājāno, ",
  "ja542:115.4": "ādiccovudayaṃ tamaṃ’’. ",
  "ja542:116.1": "705. ‘‘Susukhaṃ vata saṃvāso, ",
  "ja542:116.2": "paṇḍitehīti senaka; ",
  "ja542:116.3": "Pakkhīva pañjare baddhe, ",
  "ja542:116.4": "macche jālagateriva; ",
  "ja542:116.5": "Amittahatthattagate , ",
  "ja542:116.6": "mocayī no mahosadho’’. ",
  "ja542:117.1": "706. ‘‘Evametaṃ mahārāja, ",
  "ja542:117.2": "paṇḍitā hi sukhāvahā; ",
  "ja542:117.3": "Pakkhīva pañjare baddhe, ",
  "ja542:117.4": "macche jālagateriva; ",
  "ja542:117.5": "Amittahatthattagate, ",
  "ja542:117.6": "mocayī no mahosadho’’. ",
  "ja542:118.1": "707. ‘‘Rakkhitvā kasiṇaṃ rattiṃ, ",
  "ja542:118.2": "cūḷaneyyo mahabbalo; ",
  "ja542:118.3": "Udentaṃ aruṇuggasmiṃ, ",
  "ja542:118.4": "upakāriṃ upāgami. ",
  "ja542:119.1": "708. ‘‘Āruyha pavaraṃ nāgaṃ, ",
  "ja542:119.2": "balavantaṃ saṭṭhihāyanaṃ; ",
  "ja542:119.3": "Rājā avoca pañcālo, ",
  "ja542:119.4": "cūḷaneyyo mahabbalo. ",
  "ja542:120.1": "709. ‘‘Sannaddho maṇivammena , ",
  "ja542:120.2": "saramādāya pāṇinā; ",
  "ja542:120.3": "Pesiye ajjhabhāsittha, ",
  "ja542:120.4": "puthugumbe samāgate. ",
  "ja542:121.1": "710. ‘‘Hatthārohe anīkaṭṭhe, ",
  "ja542:121.2": "rathike pattikārake; ",
  "ja542:121.3": "Upāsanamhi katahatthe, ",
  "ja542:121.4": "vālavedhe samāgate’’. ",
  "ja542:122.1": "711. ‘‘Pesetha kuñjare dantī, ",
  "ja542:122.2": "balavante saṭṭhihāyane; ",
  "ja542:122.3": "Maddantu kuñjarā nagaraṃ, ",
  "ja542:122.4": "vedehena sumāpitaṃ. ",
  "ja542:123.1": "712. ‘‘Vacchadantamukhā setā, ",
  "ja542:123.2": "tikkhaggā aṭṭhivedhino; ",
  "ja542:123.3": "Paṇunnā dhanuvegena, ",
  "ja542:123.4": "sampatantutarītarā. ",
  "ja542:124.1": "713. ‘‘Māṇavā vammino sūrā, ",
  "ja542:124.2": "citradaṇḍayutāvudhā; ",
  "ja542:124.3": "Pakkhandino mahānāgā, ",
  "ja542:124.4": "hatthīnaṃ hontu sammukhā. ",
  "ja542:125.1": "714. ‘‘Sattiyo teladhotāyo, ",
  "ja542:125.2": "accimantā pabhassarā; ",
  "ja542:125.3": "Vijjotamānā tiṭṭhantu, ",
  "ja542:125.4": "sataraṃsīva tārakā. ",
  "ja542:126.1": "715. ‘‘Āvudhabalavantānaṃ, ",
  "ja542:126.2": "guṇikāyūradhārinaṃ; ",
  "ja542:126.3": "Etādisānaṃ yodhānaṃ, ",
  "ja542:126.4": "saṅgāme apalāyinaṃ; ",
  "ja542:126.5": "Vedeho kuto muccissati, ",
  "ja542:126.6": "sace pakkhīva kāhiti. ",
  "ja542:127.1": "716. ‘‘Tiṃsa me purisanāvutyo, ",
  "ja542:127.2": "sabbevekekaniccitā; ",
  "ja542:127.3": "Yesaṃ samaṃ na passāmi, ",
  "ja542:127.4": "kevalaṃ mahimaṃ caraṃ. ",
  "ja542:128.1": "717. ‘‘Nāgā ca kappitā dantī, ",
  "ja542:128.2": "balavanto saṭṭhihāyanā; ",
  "ja542:128.3": "Yesaṃ khandhesu sobhanti, ",
  "ja542:128.4": "kumārā cārudassanā; ",
  "ja542:129.1": "718. ‘‘Pītālaṅkārā pītavasanā, ",
  "ja542:129.2": "pītuttaranivāsanā; ",
  "ja542:129.3": "Nāgakhandhesu sobhanti, ",
  "ja542:129.4": "devaputtāva nandane. ",
  "ja542:130.1": "719. ‘‘Pāṭhīnavaṇṇā nettiṃsā, ",
  "ja542:130.2": "teladhotā pabhassarā; ",
  "ja542:130.3": "Niṭṭhitā naradhīrehi , ",
  "ja542:130.4": "samadhārā sunissitā. ",
  "ja542:131.1": "720. ‘‘Vellālino vītamalā, ",
  "ja542:131.2": "sikkāyasamayā daḷhā; ",
  "ja542:131.3": "Gahitā balavantehi, ",
  "ja542:131.4": "suppahārappahāribhi. ",
  "ja542:132.1": "721. ‘‘Suvaṇṇatharusampannā, ",
  "ja542:132.2": "lohitakacchupadhāritā; ",
  "ja542:132.3": "Vivattamānā sobhanti, ",
  "ja542:132.4": "vijjuvabbhaghanantare. ",
  "ja542:133.1": "722. ‘‘Paṭākā vammino sūrā, ",
  "ja542:133.2": "asicammassa kovidā; ",
  "ja542:133.3": "Dhanuggahā sikkhitarā , ",
  "ja542:133.4": "nāgakhandhe nipātino . ",
  "ja542:134.1": "723. ‘‘Etādisehi parikkhitto, ",
  "ja542:134.2": "natthi mokkho ito tava; ",
  "ja542:134.3": "Pabhāvaṃ te na passāmi, ",
  "ja542:134.4": "yena tvaṃ mithilaṃ vaje’’. ",
  "ja542:135.1": "724. ‘‘Kiṃ nu santaramānova, ",
  "ja542:135.2": "nāgaṃ pesesi kuñjaraṃ; ",
  "ja542:135.3": "Pahaṭṭharūpo āpatasi , ",
  "ja542:135.4": "siddhatthosmīti maññasi. ",
  "ja542:136.1": "725. ‘‘Oharetaṃ dhanuṃ cāpaṃ, ",
  "ja542:136.2": "khurappaṃ paṭisaṃhara; ",
  "ja542:136.3": "Oharetaṃ subhaṃ vammaṃ, ",
  "ja542:136.4": "veḷuriyamaṇisanthataṃ’’ . ",
  "ja542:137.1": "726. ‘‘Pasannamukhavaṇṇosi, ",
  "ja542:137.2": "mitapubbañca bhāsasi; ",
  "ja542:137.3": "Hoti kho maraṇakāle, ",
  "ja542:137.4": "edisī vaṇṇasampadā’’. ",
  "ja542:138.1": "727. ‘‘Moghaṃ te gajjitaṃ rāja, ",
  "ja542:138.2": "bhinnamantosi khattiya; ",
  "ja542:138.3": "Duggaṇhosi tayā rājā, ",
  "ja542:138.4": "khaḷuṅkeneva sindhavo. ",
  "ja542:139.1": "728. ‘‘Tiṇṇo hiyyo rājā gaṅgaṃ, ",
  "ja542:139.2": "sāmacco saparijjano; ",
  "ja542:139.3": "Haṃsarājaṃ yathā dhaṅko, ",
  "ja542:139.4": "anujjavaṃ patissasi’’. ",
  "ja542:140.1": "729. ‘‘Siṅgālā rattibhāgena, ",
  "ja542:140.2": "phullaṃ disvāna kiṃsukaṃ; ",
  "ja542:140.3": "Maṃsapesīti maññantā, ",
  "ja542:140.4": "paribyūḷhā migādhamā. ",
  "ja542:141.1": "730. ‘‘Vītivattāsu rattīsu, ",
  "ja542:141.2": "uggatasmiṃ divākare ; ",
  "ja542:141.3": "Kiṃsukaṃ phullitaṃ disvā, ",
  "ja542:141.4": "āsacchinnā migādhamā. ",
  "ja542:142.1": "731. ‘‘Evameva tuvaṃ rāja, ",
  "ja542:142.2": "vedehaṃ parivāriya ; ",
  "ja542:142.3": "Āsacchinno gamissasi, ",
  "ja542:142.4": "siṅgālā kiṃsukaṃ yathā’’. ",
  "ja542:143.1": "732. ‘‘Imassa hatthe pāde ca, ",
  "ja542:143.2": "kaṇṇanāsañca chindatha; ",
  "ja542:143.3": "Yo me amittaṃ hatthagataṃ, ",
  "ja542:143.4": "vedehaṃ parimocayi. ",
  "ja542:144.1": "733. ‘‘Imaṃ maṃsaṃva pātabyaṃ , ",
  "ja542:144.2": "sūle katvā pacantu naṃ; ",
  "ja542:144.3": "Yo me amittaṃ hatthagataṃ, ",
  "ja542:144.4": "vedehaṃ parimocayi. ",
  "ja542:145.1": "734. ‘‘Yathāpi āsabhaṃ cammaṃ, ",
  "ja542:145.2": "pathabyā vitaniyyati; ",
  "ja542:145.3": "Sīhassa atho byagghassa, ",
  "ja542:145.4": "hoti saṅkusamāhataṃ. ",
  "ja542:146.1": "735. ‘‘Evaṃ taṃ vitanitvāna, ",
  "ja542:146.2": "vedhayissāmi sattiyā; ",
  "ja542:146.3": "Yo me amittaṃ hatthagataṃ, ",
  "ja542:146.4": "vedehaṃ parimocayi’’. ",
  "ja542:147.1": "736. ‘‘Sace me hatthe pāde ca, ",
  "ja542:147.2": "kaṇṇanāsañca checchasi; ",
  "ja542:147.3": "Evaṃ pañcālacandassa, ",
  "ja542:147.4": "vedeho chedayissati. ",
  "ja542:148.1": "737. ‘‘Sace me hatthe pāde ca, ",
  "ja542:148.2": "kaṇṇanāsañca checchasi; ",
  "ja542:148.3": "Evaṃ pañcālacandiyā, ",
  "ja542:148.4": "vedeho chedayissati. ",
  "ja542:149.1": "738. ‘‘Sace me hatthe pāde ca, ",
  "ja542:149.2": "kaṇṇanāsañca checchasi; ",
  "ja542:149.3": "Evaṃ nandāya deviyā, ",
  "ja542:149.4": "vedeho chedayissati. ",
  "ja542:150.1": "739. ‘‘Sace me hatthe pāde ca, ",
  "ja542:150.2": "kaṇṇanāsañca checchasi; ",
  "ja542:150.3": "Evaṃ te puttadārassa, ",
  "ja542:150.4": "vedeho chedayissati. ",
  "ja542:151.1": "740. ‘‘Sace maṃsaṃva pātabyaṃ, ",
  "ja542:151.2": "sūle katvā pacissasi; ",
  "ja542:151.3": "Evaṃ pañcālacandassa, ",
  "ja542:151.4": "vedeho pācayissati. ",
  "ja542:152.1": "741. ‘‘Sace maṃsaṃva pātabyaṃ, ",
  "ja542:152.2": "sūle katvā pacissasi; ",
  "ja542:152.3": "Evaṃ pañcālacandiyā, ",
  "ja542:152.4": "vedeho pācayissati. ",
  "ja542:153.1": "742. ‘‘Sace maṃsaṃva pātabyaṃ, ",
  "ja542:153.2": "sūle katvā pacissasi; ",
  "ja542:153.3": "Evaṃ nandāya deviyā, ",
  "ja542:153.4": "vedeho pācayissati. ",
  "ja542:154.1": "743. ‘‘Sace maṃsaṃva pātabyaṃ, ",
  "ja542:154.2": "sūle katvā pacissasi; ",
  "ja542:154.3": "Evaṃ te puttadārassa, ",
  "ja542:154.4": "vedeho pācayissati. ",
  "ja542:155.1": "744. ‘‘Sace maṃ vitanitvāna, ",
  "ja542:155.2": "vedhayissasi sattiyā; ",
  "ja542:155.3": "Evaṃ pañcālacandassa, ",
  "ja542:155.4": "vedeho vedhayissati. ",
  "ja542:156.1": "745. ‘‘Sace maṃ vitanitvāna, ",
  "ja542:156.2": "vedhayissasi sattiyā; ",
  "ja542:156.3": "Evaṃ pañcālacandiyā, ",
  "ja542:156.4": "vedeho vedhayissati. ",
  "ja542:157.1": "746. ‘‘Sace maṃ vitanitvāna, ",
  "ja542:157.2": "vedhayissasi sattiyā; ",
  "ja542:157.3": "Evaṃ nandāya deviyā, ",
  "ja542:157.4": "vedeho vedhayissati. ",
  "ja542:158.1": "747. ‘‘Sace maṃ vitanitvāna, ",
  "ja542:158.2": "vedhayissasi sattiyā; ",
  "ja542:158.3": "Evaṃ te puttadārassa, ",
  "ja542:158.4": "vedeho vedhayissati; ",
  "ja542:158.5": "Evaṃ no mantitaṃ raho, ",
  "ja542:158.6": "vedehena mayā saha. ",
  "ja542:159.1": "748. ‘‘Yathāpi palasataṃ cammaṃ, ",
  "ja542:159.2": "kontimantāsuniṭṭhitaṃ ; ",
  "ja542:159.3": "Upeti tanutāṇāya, ",
  "ja542:159.4": "sarānaṃ paṭihantave. ",
  "ja542:160.1": "749. ‘‘Sukhāvaho dukkhanudo, ",
  "ja542:160.2": "vedehassa yasassino; ",
  "ja542:160.3": "Matiṃ te paṭihaññāmi, ",
  "ja542:160.4": "usuṃ palasatena vā’’. ",
  "ja542:161.1": "750. ‘‘Iṅgha passa mahārāja, ",
  "ja542:161.2": "suññaṃ antepuraṃ tava; ",
  "ja542:161.3": "Orodhā ca kumārā ca, ",
  "ja542:161.4": "tava mātā ca khattiya; ",
  "ja542:161.5": "Umaṅgā nīharitvāna, ",
  "ja542:161.6": "vedehassupanāmitā’’. ",
  "ja542:162.1": "751. ‘‘Iṅgha antepuraṃ mayhaṃ, ",
  "ja542:162.2": "gantvāna vicinātha naṃ; ",
  "ja542:162.3": "Yathā imassa vacanaṃ, ",
  "ja542:162.4": "saccaṃ vā yadi vā musā’’. ",
  "ja542:163.1": "752. ‘‘Evametaṃ mahārāja, ",
  "ja542:163.2": "yathā āha mahosadho; ",
  "ja542:163.3": "Suññaṃ antepuraṃ sabbaṃ, ",
  "ja542:163.4": "kākapaṭṭanakaṃ yathā’’. ",
  "ja542:164.1": "753. ‘‘Ito gatā mahārāja, ",
  "ja542:164.2": "nārī sabbaṅgasobhanā; ",
  "ja542:164.3": "Kosambaphalakasussoṇī , ",
  "ja542:164.4": "haṃsagaggarabhāṇinī. ",
  "ja542:165.1": "754. ‘‘Ito nītā mahārāja, ",
  "ja542:165.2": "nārī sabbaṅgasobhanā; ",
  "ja542:165.3": "Koseyyavasanā sāmā, ",
  "ja542:165.4": "jātarūpasumekhalā. ",
  "ja542:166.1": "755. ‘‘Surattapādā kalyāṇī, ",
  "ja542:166.2": "suvaṇṇamaṇimekhalā; ",
  "ja542:166.3": "Pārevatakkhī sutanū, ",
  "ja542:166.4": "bimboṭṭhā tanumajjhimā. ",
  "ja542:167.1": "756. ‘‘Sujātā bhujalaṭṭhīva, ",
  "ja542:167.2": "vedīva tanumajjhimā; ",
  "ja542:167.3": "Dīghassā kesā asitā, ",
  "ja542:167.4": "īsakaggapavellitā. ",
  "ja542:168.1": "757. ‘‘Sujātā migachāpāva, ",
  "ja542:168.2": "hemantaggisikhāriva; ",
  "ja542:168.3": "Nadīva giriduggesu, ",
  "ja542:168.4": "sañchannā khuddaveḷubhi. ",
  "ja542:169.1": "758. ‘‘Nāganāsūru kalyāṇī, ",
  "ja542:169.2": "paramā timbarutthanī; ",
  "ja542:169.3": "Nātidīghā nātirassā, ",
  "ja542:169.4": "nālomā nātilomasā’’. ",
  "ja542:170.1": "759. ‘‘Nandāya nūna maraṇena, ",
  "ja542:170.2": "nandasi sirivāhana; ",
  "ja542:170.3": "Ahañca nūna nandā ca, ",
  "ja542:170.4": "gacchāma yamasādhanaṃ’’. ",
  "ja542:171.1": "760. ‘‘Dibbaṃ adhīyase māyaṃ, ",
  "ja542:171.2": "akāsi cakkhumohanaṃ; ",
  "ja542:171.3": "Yo me amittaṃ hatthagataṃ, ",
  "ja542:171.4": "vedehaṃ parimocayi’’. ",
  "ja542:172.1": "761. ‘‘Adhīyanti mahārāja , ",
  "ja542:172.2": "dibbamāyidha paṇḍitā; ",
  "ja542:172.3": "Te mocayanti attānaṃ, ",
  "ja542:172.4": "paṇḍitā mantino janā. ",
  "ja542:173.1": "762. ‘‘Santi māṇavaputtā me, ",
  "ja542:173.2": "kusalā sandhichedakā; ",
  "ja542:173.3": "Yesaṃ katena maggena, ",
  "ja542:173.4": "vedeho mithilaṃ gato’’. ",
  "ja542:174.1": "763. ‘‘Iṅgha passa mahārāja, ",
  "ja542:174.2": "umaṅgaṃ sādhu māpitaṃ; ",
  "ja542:174.3": "Hatthīnaṃ atha assānaṃ, ",
  "ja542:174.4": "rathānaṃ atha pattinaṃ; ",
  "ja542:174.5": "Ālokabhūtaṃ tiṭṭhantaṃ, ",
  "ja542:174.6": "umaṅgaṃ sādhu māpitaṃ’’ . ",
  "ja542:175.1": "764. ‘‘Lābhā vata videhānaṃ, ",
  "ja542:175.2": "yassimedisā paṇḍitā; ",
  "ja542:175.3": "Ghare vasanti vijite, ",
  "ja542:175.4": "yathā tvaṃsi mahosadha’’. ",
  "ja542:176.1": "765. ‘‘Vuttiñca parihārañca, ",
  "ja542:176.2": "diguṇaṃ bhattavetanaṃ; ",
  "ja542:176.3": "Dadāmi vipule bhoge, ",
  "ja542:176.4": "bhuñja kāme ramassu ca; ",
  "ja542:176.5": "Mā videhaṃ paccagamā, ",
  "ja542:176.6": "kiṃ videho karissati’’. ",
  "ja542:177.1": "766. ‘‘Yo cajetha mahārāja, ",
  "ja542:177.2": "bhattāraṃ dhanakāraṇā; ",
  "ja542:177.3": "Ubhinnaṃ hoti gārayho, ",
  "ja542:177.4": "attano ca parassa ca; ",
  "ja542:177.5": "Yāva jīveyya vedeho, ",
  "ja542:177.6": "nāññassa puriso siyā. ",
  "ja542:178.1": "767. ‘‘Yo cajetha mahārāja, ",
  "ja542:178.2": "bhattāraṃ dhanakāraṇā; ",
  "ja542:178.3": "Ubhinnaṃ hoti gārayho, ",
  "ja542:178.4": "attano ca parassa ca; ",
  "ja542:178.5": "Yāva tiṭṭheyya vedeho, ",
  "ja542:178.6": "nāññassa vijite vase’’. ",
  "ja542:179.1": "768. ‘‘Dammi nikkhasahassaṃ te, ",
  "ja542:179.2": "gāmāsītiñca kāsisu; ",
  "ja542:179.3": "Dāsisatāni cattāri, ",
  "ja542:179.4": "dammi bhariyāsatañca te; ",
  "ja542:179.5": "Sabbaṃ senaṅgamādāya, ",
  "ja542:179.6": "sotthiṃ gaccha mahosadha. ",
  "ja542:180.1": "769. ‘‘Yāva dadantu hatthīnaṃ, ",
  "ja542:180.2": "assānaṃ diguṇaṃ vidhaṃ; ",
  "ja542:180.3": "Tappentu annapānena, ",
  "ja542:180.4": "rathike pattikārake’’. ",
  "ja542:181.1": "770. ‘‘Hatthī asse rathe pattī, ",
  "ja542:181.2": "gacchevādāya paṇḍita; ",
  "ja542:181.3": "Passatu taṃ mahārājā, ",
  "ja542:181.4": "vedeho mithilaṃ gataṃ . ",
  "ja542:182.1": "771. ‘‘Hatthī assā rathā pattī, ",
  "ja542:182.2": "senā padissate mahā; ",
  "ja542:182.3": "Caturaṅginī bhīsarūpā, ",
  "ja542:182.4": "kiṃ nu maññasi paṇḍita’’ . ",
  "ja542:183.1": "772. ‘‘Ānando te mahārāja, ",
  "ja542:183.2": "uttamo paṭidissati; ",
  "ja542:183.3": "Sabbaṃ senaṅgamādāya, ",
  "ja542:183.4": "sotthiṃ patto mahosadho’’. ",
  "ja542:184.1": "773. ‘‘Yathā petaṃ susānasmiṃ, ",
  "ja542:184.2": "chaḍḍetvā caturo janā; ",
  "ja542:184.3": "Evaṃ kapilaye tyamha , ",
  "ja542:184.4": "chaḍḍayitvā idhāgatā. ",
  "ja542:185.1": "774. ‘‘Atha tvaṃ kena vaṇṇena, ",
  "ja542:185.2": "kena vā pana hetunā; ",
  "ja542:185.3": "Kena vā atthajātena, ",
  "ja542:185.4": "attānaṃ parimocayi’’. ",
  "ja542:186.1": "775. ‘‘Atthaṃ atthena vedeha, ",
  "ja542:186.2": "mantaṃ mantena khattiya; ",
  "ja542:186.3": "Parivārayiṃ rājānaṃ, ",
  "ja542:186.4": "jambudīpaṃva sāgaro’’. ",
  "ja542:187.1": "776. ‘‘Dinnaṃ nikkhasahassaṃ me, ",
  "ja542:187.2": "gāmāsīti ca kāsisu; ",
  "ja542:187.3": "Dāsīsatāni cattāri, ",
  "ja542:187.4": "dinnaṃ bhariyāsatañca me; ",
  "ja542:187.5": "Sabbaṃ senaṅgamādāya, ",
  "ja542:187.6": "sotthināmhi idhāgato’’. ",
  "ja542:188.1": "777. ‘‘Susukhaṃ vata saṃvāso, ",
  "ja542:188.2": "paṇḍitehīti senaka; ",
  "ja542:188.3": "Pakkhīva pañjare baddhe, ",
  "ja542:188.4": "macche jālagateriva; ",
  "ja542:188.5": "Amittahatthattagate , ",
  "ja542:188.6": "mocayī no mahosadho’’. ",
  "ja542:189.1": "778. ‘‘Evametaṃ mahārāja, ",
  "ja542:189.2": "paṇḍitā hi sukhāvahā; ",
  "ja542:189.3": "Pakkhīva pañjare baddhe, ",
  "ja542:189.4": "macche jālagateriva; ",
  "ja542:189.5": "Amittahatthattagate, ",
  "ja542:189.6": "mocayī no mahosadho’’. ",
  "ja542:190.1": "779. ‘‘Āhaññantu sabbavīṇā, ",
  "ja542:190.2": "bheriyo dindimāni ca; ",
  "ja542:190.3": "Dhamentu māgadhā saṅkhā, ",
  "ja542:190.4": "vaggū nadantu dundubhī’’. ",
  "ja542:191.1": "780. ‘‘Orodhā ca kumārā ca, ",
  "ja542:191.2": "vesiyānā ca brāhmaṇā; ",
  "ja542:191.3": "Bahuṃ annañca pānañca, ",
  "ja542:191.4": "paṇḍitassābhihārayuṃ. ",
  "ja542:192.1": "781. ‘‘Hatthārohā anīkaṭṭhā, ",
  "ja542:192.2": "rathikā pattikārakā; ",
  "ja542:192.3": "Bahuṃ annañca pānañca, ",
  "ja542:192.4": "paṇḍitassābhihārayuṃ. ",
  "ja542:193.1": "782. ‘‘Samāgatā jānapadā, ",
  "ja542:193.2": "negamā ca samāgatā; ",
  "ja542:193.3": "Bahuṃ annañca pānañca, ",
  "ja542:193.4": "paṇḍitassābhihārayuṃ. ",
  "ja542:194.1": "783. ‘‘Bahujano pasannosi, ",
  "ja542:194.2": "disvā paṇḍitamāgataṃ; ",
  "ja542:194.3": "Paṇḍitamhi anuppatte, ",
  "ja542:194.4": "celukkhepo avattathā’’ti. ",
  "ja542:195.1": "Umaṅgajātakaṃ pañcamaṃ. "
}
