  "ja456:0.4": "13. 456. Juṇhajātakaṃ (2) ",
  "ja456:1.1": "Suṇohi mayhaṃ vacanaṃ janinda, ",
  "ja456:1.2": "atthena juṇhamhi idhānupatto; ",
  "ja456:1.3": "Na brāhmaṇe addhike tiṭṭhamāne, ",
  "ja456:1.4": "gantabba māhu dvipadinda seṭṭha. ",
  "ja456:2.1": "14. Suṇomi tiṭṭhāmi vadehi brahme, ",
  "ja456:2.2": "yenāsi atthena idhānupatto; ",
  "ja456:2.3": "Kaṃ vā tvamatthaṃ mayi patthayāno, ",
  "ja456:2.4": "idhāgamā brahme tadiṅgha brūhi. ",
  "ja456:3.1": "15. Dadāhi me gāmavarāni pañca, ",
  "ja456:3.2": "dāsīsataṃ satta gavaṃsatāni; ",
  "ja456:3.3": "Parosahassañca suvaṇṇanikkhe, ",
  "ja456:3.4": "bhariyā ca me sādisī dve dadāhi. ",
  "ja456:4.1": "16. Tapo nu te brāhmaṇa bhiṃsarūpo, ",
  "ja456:4.2": "mantā nu te brāhmaṇa cittarūpā; ",
  "ja456:4.3": "Yakkhā nu te assavā santi keci, ",
  "ja456:4.4": "atthaṃ vā me abhijānāsi kattaṃ. ",
  "ja456:5.1": "17. Na me tapo atthi na cāpi mantā, ",
  "ja456:5.2": "yakkhāpi me assavā natthi keci; ",
  "ja456:5.3": "Atthampi te nābhijānāmi kattaṃ, ",
  "ja456:5.4": "pubbe ca kho saṅgatimattamāsi. ",
  "ja456:6.1": "18. Paṭhamaṃ idaṃ dassanaṃ jānato me, ",
  "ja456:6.2": "na tābhijānāmi ito puratthā; ",
  "ja456:6.3": "Akkhāhi me pucchito etamatthaṃ, ",
  "ja456:6.4": "kadā kuhiṃ vā ahu saṅgamo no. ",
  "ja456:7.1": "19. Gandhārarājassa puramhi ramme, ",
  "ja456:7.2": "avasimhase takkasīlāyaṃ deva; ",
  "ja456:7.3": "Tatthandhakāramhi timīsikāyaṃ , ",
  "ja456:7.4": "aṃsena aṃsaṃ samaghaṭṭayimha. ",
  "ja456:8.1": "20. Te tattha ṭhatvāna ubho janinda, ",
  "ja456:8.2": "sārāṇiyaṃ vītisārayimha tattha; ",
  "ja456:8.3": "Sāyeva no saṅgatimattamāsi, ",
  "ja456:8.4": "tato na pacchā na pure ahosi. ",
  "ja456:9.1": "21. Yadā kadāci manujesu brahme, ",
  "ja456:9.2": "samāgamo sappurisena hoti; ",
  "ja456:9.3": "Na paṇḍitā saṅgatisanthavāni, ",
  "ja456:9.4": "pubbe kataṃ vāpi vināsayanti. ",
  "ja456:10.1": "22. Bālāva kho saṅgatisanthavāni, ",
  "ja456:10.2": "pubbe kataṃ vāpi vināsayanti; ",
  "ja456:10.3": "Bahumpi bālesu kataṃ vinassati, ",
  "ja456:10.4": "tathā hi bālā akataññurūpā. ",
  "ja456:11.1": "23. Dhīrā ca kho saṅgatisanthavāni, ",
  "ja456:11.2": "pubbe kataṃ vāpi na nāsayanti; ",
  "ja456:11.3": "Appampi dhīresu kataṃ na nassati, ",
  "ja456:11.4": "tathā hi dhīrā sukataññurūpā. ",
  "ja456:12.1": "24. Dadāmi te gāmavarāni pañca, ",
  "ja456:12.2": "dāsīsataṃ satta gavaṃsatāni; ",
  "ja456:12.3": "Parosahassañca suvaṇṇanikkhe, ",
  "ja456:12.4": "bhariyā ca te sādisī dve dadāmi. ",
  "ja456:13.1": "25. Evaṃ sataṃ hoti samecca rāja, ",
  "ja456:13.2": "nakkhattarājāriva tārakānaṃ; ",
  "ja456:13.3": "Āpūratī kāsipatī tathāhaṃ, ",
  "ja456:13.4": "tayāpi me saṅgamo ajja laddhoti. ",
  "ja456:14.1": "Juṇhajātakaṃ dutiyaṃ. "
}
