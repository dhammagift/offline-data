  "ja330:0.3": "",
  "ja330:0.4": "330. Sīlavīmaṃsajātakaṃ (4-3-10) 117. ",
  "ja330:1.1": "Sīlaṃ kireva kalyāṇaṃ, ",
  "ja330:1.2": "sīlaṃ loke anuttaraṃ; ",
  "ja330:1.3": "Passa ghoraviso nāgo, ",
  "ja330:1.4": "sīlavāti na haññati. ",
  "ja330:2.1": "118. Yāvadevassahū kiñci, ",
  "ja330:2.2": "tāvadeva akhādisuṃ; ",
  "ja330:2.3": "Saṅgamma kulalā loke, ",
  "ja330:2.4": "na hiṃsanti akiñcanaṃ. ",
  "ja330:3.1": "119. Sukhaṃ nirāsā supati, ",
  "ja330:3.2": "āsā phalavatī sukhā; ",
  "ja330:3.3": "Āsaṃ nirāsaṃ katvāna, ",
  "ja330:3.4": "sukhaṃ supati piṅgalā. ",
  "ja330:4.1": "120. Na samādhiparo atthi, ",
  "ja330:4.2": "asmiṃ loke paramhi ca; ",
  "ja330:4.3": "Na paraṃ nāpi attānaṃ, ",
  "ja330:4.4": "vihiṃsati samāhitoti. ",
  "ja330:5.1": "Sīlavīmaṃsajātakaṃ dasamaṃ. ",
  "ja330:5.2": "Kuṭidūsakavaggo tatiyo. ",
  "ja330:6.1": "Tassuddānaṃ – ",
  "ja330:7.1": "Samanussa -saduddubha-yācanako, ",
  "ja330:7.2": "atha meṇḍavaruttama-godhavaro; ",
  "ja330:7.3": "Atha kāyasakepuka bhotīvaro, ",
  "ja330:7.4": "atha rādhasusīlavarena dasāti. "
}
