  "ja221:0.3": "8. Kāsāvavaggo ",
  "ja221:0.4": "221. Kāsāvajātakaṃ (2-8-1) 141. ",
  "ja221:1.1": "Anikkasāvo kāsāvaṃ, ",
  "ja221:1.2": "yo vatthaṃ paridahissati ; ",
  "ja221:1.3": "Apeto damasaccena, ",
  "ja221:1.4": "na so kāsāvamarahati. ",
  "ja221:2.1": "142. Yo ca vantakasāvassa, ",
  "ja221:2.2": "sīlesu susamāhito; ",
  "ja221:2.3": "Upeto damasaccena, ",
  "ja221:2.4": "sa ve kāsāvamarahatīti. ",
  "ja221:3.1": "Kāsāvajātakaṃ paṭhamaṃ. "
}
