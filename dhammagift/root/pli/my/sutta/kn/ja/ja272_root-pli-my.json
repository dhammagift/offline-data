  "ja272:0.3": "",
  "ja272:0.4": "272. Byagghajātakaṃ (3-3-2) 64. ",
  "ja272:1.1": "Yena mittena saṃsaggā, ",
  "ja272:1.2": "yogakkhemo vihiyyati; ",
  "ja272:1.3": "Pubbevajjhābhavaṃ tassa, ",
  "ja272:1.4": "rukkhe akkhīva paṇḍito. ",
  "ja272:2.1": "65. Yena mittena saṃsaggā, ",
  "ja272:2.2": "yogakkhemo pavaḍḍhati; ",
  "ja272:2.3": "Kareyyattasamaṃ vuttiṃ, ",
  "ja272:2.4": "sabbakiccesu paṇḍito. ",
  "ja272:3.1": "66. Etha byagghā nivattavho, ",
  "ja272:3.2": "paccupetha mahāvanaṃ; ",
  "ja272:3.3": "Mā vanaṃ chindi nibyagghaṃ, ",
  "ja272:3.4": "byagghā māhesu nibbanāti. ",
  "ja272:4.1": "Byagghajātakaṃ dutiyaṃ. "
}
