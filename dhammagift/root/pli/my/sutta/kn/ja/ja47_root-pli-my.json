  "ja47:0.4": "47. 47. Vāruṇidūsakajātakaṃ ",
  "ja47:1.1": "Na ve anatthakusalena, ",
  "ja47:1.2": "atthacariyā sukhāvahā; ",
  "ja47:1.3": "Hāpeti atthaṃ dummedho, ",
  "ja47:1.4": "koṇḍañño vāruṇiṃ yathāti. ",
  "ja47:2.1": "Vāruṇidūsakajātakaṃ sattamaṃ. "
}
