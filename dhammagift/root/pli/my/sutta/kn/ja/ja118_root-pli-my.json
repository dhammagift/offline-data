  "ja118:0.4": "118. Vaṭṭakajātakaṃ 118. ",
  "ja118:1.1": "Nācintayanto puriso, ",
  "ja118:1.2": "visesamadhigacchati; ",
  "ja118:1.3": "Cintitassa phalaṃ passa, ",
  "ja118:1.4": "muttosmi vadhabandhanāti. ",
  "ja118:2.1": "Vaṭṭakajātakaṃ aṭṭhamaṃ. "
}
