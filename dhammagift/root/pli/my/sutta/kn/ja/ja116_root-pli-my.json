  "ja116:0.4": "116. 116. Dubbacajātakaṃ ",
  "ja116:1.1": "Atikaramakarācariya, ",
  "ja116:1.2": "mayhampetaṃ na ruccati; ",
  "ja116:1.3": "Catutthe laṅghayitvāna, ",
  "ja116:1.4": "pañcamāyasi āvutoti. ",
  "ja116:2.1": "Dubbacajātakaṃ chaṭṭhaṃ. "
}
