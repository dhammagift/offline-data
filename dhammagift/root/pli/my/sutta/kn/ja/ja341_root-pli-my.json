  "ja341:0.1": "",
  "ja341:0.2": "",
  "ja341:0.3": "5. Cūḷakuṇālavaggo ",
  "ja341:0.4": "161. 341. Kaṇḍarījātakaṃ (4-5-1) ",
  "ja341:1.1": "Narānamārāmakarāsu nārisu, ",
  "ja341:1.2": "anekacittāsu aniggahāsu ca; ",
  "ja341:1.3": "Sabbattha nāpītikarāpi ce siyā , ",
  "ja341:1.4": "na vissase titthasamā hi nāriyo. ",
  "ja341:2.1": "162. Yaṃ ve disvā kaṇḍarīkinnarānaṃ , ",
  "ja341:2.2": "sabbitthiyo na ramanti agāre; ",
  "ja341:2.3": "Taṃ tādisaṃ maccaṃ cajitvā bhariyā, ",
  "ja341:2.4": "aññaṃ disvā purisaṃ pīṭhasappiṃ. ",
  "ja341:3.1": "163. Bakassa ca bāvarikassa rañño, ",
  "ja341:3.2": "accantakāmānugatassa bhariyā; ",
  "ja341:3.3": "Avācarī paṭṭhavasānugassa , ",
  "ja341:3.4": "kaṃ vāpi itthī nāticare tadaññaṃ. ",
  "ja341:4.1": "164. Piṅgiyānī sabbalokissarassa, ",
  "ja341:4.2": "rañño piyā brahmadattassa bhariyā; ",
  "ja341:4.3": "Avācarī paṭṭhavasānugassa, ",
  "ja341:4.4": "taṃ vāpi sā nājjhagā kāmakāminīti. ",
  "ja341:5.1": "Kaṇḍarījātakaṃ paṭhamaṃ. "
}
