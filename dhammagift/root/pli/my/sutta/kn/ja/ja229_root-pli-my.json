  "ja229:0.4": "157. 229. Palāyitajātakaṃ (2-8-9) ",
  "ja229:1.1": "Gajaggameghehi hayaggamālibhi, ",
  "ja229:1.2": "rathūmijātehi sarābhivassebhi ; ",
  "ja229:1.3": "Tharuggahāvaṭṭa daḷhappahāribhi, ",
  "ja229:1.4": "parivāritā takkasilā samantato. ",
  "ja229:2.1": "158. Abhidhāvatha cūpadhāvatha ca , ",
  "ja229:2.2": "vividhā vināditā vadantibhi; ",
  "ja229:2.3": "Vattatajja tumulo ghoso yathā, ",
  "ja229:2.4": "vijjulatā jaladharassa gajjatoti . ",
  "ja229:3.1": "Palāyitajātakaṃ navamaṃ. "
}
