  "ja55:0.4": "55. 55. Pañcāvudhajātakaṃ ",
  "ja55:1.1": "Yo alīnena cittena, ",
  "ja55:1.2": "alīnamanaso naro; ",
  "ja55:1.3": "Bhāveti kusalaṃ dhammaṃ, ",
  "ja55:1.4": "yogakkhemassa pattiyā; ",
  "ja55:1.5": "Pāpuṇe anupubbena, ",
  "ja55:1.6": "sabbasaṃyojanakkhayanti. ",
  "ja55:2.1": "Pañcāvudhajātakaṃ pañcamaṃ. "
}
