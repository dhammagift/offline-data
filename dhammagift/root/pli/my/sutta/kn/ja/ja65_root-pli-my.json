  "ja65:0.4": "65. 65. Anabhiratijātakaṃ ",
  "ja65:1.1": "Yathā nadī ca pantho ca, ",
  "ja65:1.2": "pānāgāraṃ sabhā papā; ",
  "ja65:1.3": "Evaṃ lokitthiyo nāma, ",
  "ja65:1.4": "nāsaṃ kujjhanti paṇḍitāti. ",
  "ja65:2.1": "Anabhiratijātakaṃ pañcamaṃ. "
}
