  "ja194:0.3": "",
  "ja194:0.4": "194. Maṇicorajātakaṃ (2-5-4) 87. ",
  "ja194:1.1": "Na santi devā pavasanti nūna, ",
  "ja194:1.2": "na hi nūna santi idha lokapālā; ",
  "ja194:1.3": "Sahasā karontānamasaññatānaṃ, ",
  "ja194:1.4": "na hi nūna santī paṭisedhitāro. ",
  "ja194:2.1": "88. Akāle vassatī tassa, ",
  "ja194:2.2": "kāle tassa na vassati; ",
  "ja194:2.3": "Saggā ca cavati ṭhānā, ",
  "ja194:2.4": "nanu so tāvatā hatoti. ",
  "ja194:3.1": "Maṇicorajātakaṃ catutthaṃ. "
}
