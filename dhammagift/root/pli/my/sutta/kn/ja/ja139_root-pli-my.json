  "ja139:0.4": "139. 139. Ubhatobhaṭṭhajātakaṃ ",
  "ja139:1.1": "Akkhī bhinnā paṭo naṭṭho, ",
  "ja139:1.2": "sakhigehe ca bhaṇḍanaṃ; ",
  "ja139:1.3": "Ubhato paduṭṭhā kammantā , ",
  "ja139:1.4": "udakamhi thalamhi cāti. ",
  "ja139:2.1": "Ubhatobhaṭṭhajātakaṃ navamaṃ. "
}
