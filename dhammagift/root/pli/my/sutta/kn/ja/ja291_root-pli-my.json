  "ja291:0.1": "",
  "ja291:0.2": "",
  "ja291:0.3": "5. Kumbhavaggo ",
  "ja291:0.4": "121. 291. Surāghaṭajātakaṃ (2-5-1) ",
  "ja291:1.1": "Sabbakāmadadaṃ kumbhaṃ, ",
  "ja291:1.2": "kuṭaṃ laddhāna dhuttako; ",
  "ja291:1.3": "Yāva naṃ anupāleti, ",
  "ja291:1.4": "tāva so sukhamedhati. ",
  "ja291:2.1": "122. Yadā matto ca ditto ca, ",
  "ja291:2.2": "pamādā kumbhamabbhidā; ",
  "ja291:2.3": "Tadā naggo ca pottho ca, ",
  "ja291:2.4": "pacchā bālo vihaññati. ",
  "ja291:3.1": "123. Evameva yo dhanaṃ laddhā, ",
  "ja291:3.2": "pamatto paribhuñjati; ",
  "ja291:3.3": "Pacchā tappati dummedho, ",
  "ja291:3.4": "kuṭaṃ bhitvāva dhuttakoti. ",
  "ja291:4.1": "Surāghaṭa jātakaṃ paṭhamaṃ. "
}
