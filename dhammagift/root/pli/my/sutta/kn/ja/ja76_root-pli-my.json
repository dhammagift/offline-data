  "ja76:0.4": "76. 76. Asaṅkiyajātakaṃ ",
  "ja76:1.1": "Asaṅkiyomhi gāmamhi, ",
  "ja76:1.2": "araññe natthi me bhayaṃ; ",
  "ja76:1.3": "Ujuṃ maggaṃ samārūḷho, ",
  "ja76:1.4": "mettāya karuṇāya cāti. ",
  "ja76:2.1": "Asaṅkiyajātakaṃ chaṭṭhaṃ. "
}
