  "ja544:0.4": "544. Candakumārajātakaṃ (7) 982. ",
  "ja544:1.1": "‘‘Rājāsi luddakammo, ",
  "ja544:1.2": "ekarājā pupphavatīyā; ",
  "ja544:1.3": "So pucchi brahmabandhuṃ, ",
  "ja544:1.4": "khaṇḍahālaṃ purohitaṃ mūḷhaṃ. ",
  "ja544:2.1": "983. ‘Saggāna maggamācikkha , ",
  "ja544:2.2": "tvaṃsi brāhmaṇa dhammavinayakusalo; ",
  "ja544:2.3": "Yathā ito vajanti sugatiṃ, ",
  "ja544:2.4": "narā puññāni katvāna’. ",
  "ja544:3.1": "984. ‘Atidānaṃ daditvāna, ",
  "ja544:3.2": "avajjhe deva ghātetvā; ",
  "ja544:3.3": "Evaṃ vajanti sugatiṃ, ",
  "ja544:3.4": "narā puññāni katvāna’. ",
  "ja544:4.1": "985. ‘Kiṃ pana taṃ atidānaṃ, ",
  "ja544:4.2": "ke ca avajjhā imasmi lokasmiṃ; ",
  "ja544:4.3": "Etañca kho no akkhāhi, ",
  "ja544:4.4": "yajissāmi dadāmi dānāni’. ",
  "ja544:5.1": "986. ‘Puttehi deva yajitabbaṃ, ",
  "ja544:5.2": "mahesīhi negamehi ca; ",
  "ja544:5.3": "Usabhehi ājāniyehi catūhi, ",
  "ja544:5.4": "sabbacatukkena deva yajitabbaṃ’’’. ",
  "ja544:6.1": "987. ‘‘Taṃ sutvā antepure, ",
  "ja544:6.2": "kumārā mahesiyo ca haññantu; ",
  "ja544:6.3": "Eko ahosi nigghoso, ",
  "ja544:6.4": "bhismā accuggato saddo’’. ",
  "ja544:7.1": "988. ‘‘Gacchatha vadetha kumāre, ",
  "ja544:7.2": "candaṃ sūriyañca bhaddasenañca; ",
  "ja544:7.3": "Sūrañca vāmagottañca, ",
  "ja544:7.4": "pacurā kira hotha yaññatthāya. ",
  "ja544:8.1": "989. ‘‘Kumāriyopi vadetha, ",
  "ja544:8.2": "upasenaṃ kokilañca muditañca; ",
  "ja544:8.3": "Nandañcāpi kumāriṃ, ",
  "ja544:8.4": "pacurā kira hotha yaññatthāya. ",
  "ja544:9.1": "990. ‘‘Vijayampi mayhaṃ mahesiṃ, ",
  "ja544:9.2": "erāvatiṃ kesiniṃ sunandañca; ",
  "ja544:9.3": "Lakkhaṇavarūpapannā, ",
  "ja544:9.4": "pacurā kira hotha yaññatthāya. ",
  "ja544:10.1": "991. ‘‘Gahapatayo ca vadetha, ",
  "ja544:10.2": "puṇṇamukhaṃ bhaddiyaṃ siṅgālañca; ",
  "ja544:10.3": "Vaḍḍhañcāpi gahapatiṃ, ",
  "ja544:10.4": "pacurā kira hotha yaññatthāya’’. ",
  "ja544:11.1": "992. ‘‘Te tattha gahapatayo, ",
  "ja544:11.2": "avocisuṃ samāgatā puttadāraparikiṇṇā; ",
  "ja544:11.3": "Sabbeva sikhino deva karohi, ",
  "ja544:11.4": "atha vā no dāse sāvehi’’. ",
  "ja544:12.1": "993. ‘‘Abhayaṃkarampi me hatthiṃ, ",
  "ja544:12.2": "nāḷāgiriṃ accuggataṃ varuṇadantaṃ ; ",
  "ja544:12.3": "Ānetha kho ne khippaṃ, ",
  "ja544:12.4": "yaññatthāya bhavissanti. ",
  "ja544:13.1": "994. ‘‘Assaratanampi kesiṃ, ",
  "ja544:13.2": "surāmukhaṃ puṇṇakaṃ vinatakañca; ",
  "ja544:13.3": "Ānetha kho ne khippaṃ, ",
  "ja544:13.4": "yaññatthāya bhavissanti. ",
  "ja544:14.1": "995. ‘‘Usabhampi yūthapatiṃ anojaṃ, ",
  "ja544:14.2": "nisabhaṃ gavampatiṃ tepi mayhaṃ ānetha; ",
  "ja544:14.3": "Samūha karontu sabbaṃ, ",
  "ja544:14.4": "yajissāmi dadāmi dānāni. ",
  "ja544:15.1": "996. ‘‘Sabbaṃ paṭiyādetha, ",
  "ja544:15.2": "yaññaṃ pana uggatamhi sūriyamhi; ",
  "ja544:15.3": "Āṇāpetha ca kumāre , ",
  "ja544:15.4": "abhiramantu imaṃ rattiṃ. ",
  "ja544:16.1": "997. ‘‘Sabbaṃ upaṭṭhapetha, ",
  "ja544:16.2": "yaññaṃ pana uggatamhi sūriyamhi; ",
  "ja544:16.3": "Vadetha dāni kumāre, ",
  "ja544:16.4": "ajja kho pacchimā ratti’’. ",
  "ja544:17.1": "998. ‘‘Taṃtaṃ mātā avaca, ",
  "ja544:17.2": "rodantī āgantvā vimānato; ",
  "ja544:17.3": "Yañño kira te putta, ",
  "ja544:17.4": "bhavissati catūhi puttehi’’. ",
  "ja544:18.1": "999. ‘‘Sabbepi mayhaṃ puttā cattā, ",
  "ja544:18.2": "candasmiṃ haññamānasmiṃ; ",
  "ja544:18.3": "Puttehi yaññaṃ yajitvāna, ",
  "ja544:18.4": "sugatiṃ saggaṃ gamissāmi’’. ",
  "ja544:19.1": "1000. ‘‘Mā taṃ putta saddahesi, ",
  "ja544:19.2": "sugati kira hoti puttayaññena; ",
  "ja544:19.3": "Nirayāneso maggo, ",
  "ja544:19.4": "neso maggo hi saggānaṃ. ",
  "ja544:20.1": "1001. ‘‘Dānāni dehi koṇḍañña, ",
  "ja544:20.2": "ahiṃsā sabbabhūtabhabyānaṃ’’; ",
  "ja544:20.3": "Esa maggo sugatiyā, ",
  "ja544:20.4": "na ca maggo puttayaññena’’. ",
  "ja544:21.1": "1002. ‘‘Ācariyānaṃ vacanā, ",
  "ja544:21.2": "ghātessaṃ candañca sūriyañca; ",
  "ja544:21.3": "Puttehi yaññaṃ yajitvāna duccajehi, ",
  "ja544:21.4": "sugatiṃ saggaṃ gamissāmi’’. ",
  "ja544:22.1": "1003. ‘‘Taṃtaṃ pitāpi avaca, ",
  "ja544:22.2": "vasavattī orasaṃ sakaṃ puttaṃ; ",
  "ja544:22.3": "Yañño kira te putta, ",
  "ja544:22.4": "bhavissati catūhi puttehi’’. ",
  "ja544:23.1": "1004. ‘‘Sabbepi mayhaṃ puttā cattā, ",
  "ja544:23.2": "candasmiṃ haññamānasmiṃ; ",
  "ja544:23.3": "Puttehi yaññaṃ yajitvāna, ",
  "ja544:23.4": "sugatiṃ saggaṃ gamissāmi’’. ",
  "ja544:24.1": "1005. ‘‘Mā taṃ putta saddahesi, ",
  "ja544:24.2": "sugati kira hoti puttayaññena; ",
  "ja544:24.3": "Nirayāneso maggo, ",
  "ja544:24.4": "neso maggo hi saggānaṃ. ",
  "ja544:25.1": "1006. ‘‘Dānāni dehi koṇḍañña, ",
  "ja544:25.2": "ahiṃsā sabbabhūtabhabyānaṃ; ",
  "ja544:25.3": "Esa maggo sugatiyā, ",
  "ja544:25.4": "na ca maggo puttayaññena’’. ",
  "ja544:26.1": "1007. ‘‘Ācariyānaṃ vacanā, ",
  "ja544:26.2": "ghātessaṃ candañca sūriyañca; ",
  "ja544:26.3": "Puttehi yaññaṃ yajitvāna duccajehi, ",
  "ja544:26.4": "sugatiṃ saggaṃ gamissāmi’’. ",
  "ja544:27.1": "1008. ‘‘Dānāni dehi koṇḍañña, ",
  "ja544:27.2": "ahiṃsā sabbabhūtabhabyānaṃ; ",
  "ja544:27.3": "Puttaparivuto tuvaṃ, ",
  "ja544:27.4": "raṭṭhaṃ janapadañca pālehi’’. ",
  "ja544:28.1": "1009. ‘‘Mā no deva avadhi, ",
  "ja544:28.2": "dāse no dehi khaṇḍahālassa; ",
  "ja544:28.3": "Api nigaḷabandhakāpi, ",
  "ja544:28.4": "hatthī asse ca pālema. ",
  "ja544:29.1": "1010. ‘‘Mā no deva avadhi, ",
  "ja544:29.2": "dāse no dehi khaṇḍahālassa; ",
  "ja544:29.3": "Api nigaḷabandhakāpi, ",
  "ja544:29.4": "hatthichakaṇāni ujjhema. ",
  "ja544:30.1": "1011. ‘‘Mā no deva avadhi, ",
  "ja544:30.2": "dāse no dehi khaṇḍahālassa; ",
  "ja544:30.3": "Api nigaḷabandhakāpi, ",
  "ja544:30.4": "assachakaṇāni ujjhema. ",
  "ja544:31.1": "1012. ‘‘Mā no deva avadhi, ",
  "ja544:31.2": "dāse no dehi khaṇḍahālassa ; ",
  "ja544:31.3": "Yassa honti tava kāmā, ",
  "ja544:31.4": "api raṭṭhā pabbājitā; ",
  "ja544:31.5": "Bhikkhācariyaṃ carissāma’’. ",
  "ja544:32.1": "1013. ‘‘Dukkhaṃ kho me janayatha, ",
  "ja544:32.2": "vilapantā jīvitassa kāmā hi; ",
  "ja544:32.3": "Muñcetha dāni kumāre, ",
  "ja544:32.4": "alampi me hotu puttayaññena’’. ",
  "ja544:33.1": "1014. ‘‘Pubbeva khosi me vutto, ",
  "ja544:33.2": "dukkaraṃ durabhisambhavañcetaṃ; ",
  "ja544:33.3": "Atha no upakkhaṭassa yaññassa, ",
  "ja544:33.4": "kasmā karosi vikkhepaṃ. ",
  "ja544:34.1": "1015. ‘‘Sabbe vajanti sugatiṃ, ",
  "ja544:34.2": "ye yajanti yepi yājenti; ",
  "ja544:34.3": "Ye cāpi anumodanti, ",
  "ja544:34.4": "yajantānaṃ edisaṃ mahāyaññaṃ’’. ",
  "ja544:35.1": "1016. ‘‘Atha kissa jano pubbe, ",
  "ja544:35.2": "sotthānaṃ brāhmaṇe avācesi; ",
  "ja544:35.3": "Atha no akāraṇasmā, ",
  "ja544:35.4": "yaññatthāya deva ghātesi. ",
  "ja544:36.1": "1017. ‘‘Pubbeva no daharakāle , ",
  "ja544:36.2": "na hanesi na ghātesi; ",
  "ja544:36.3": "Daharamhā yobbanaṃ pattā, ",
  "ja544:36.4": "adūsakā tāta haññāma. ",
  "ja544:37.1": "1018. ‘‘Hatthigate assagate, ",
  "ja544:37.2": "sannaddhe passa no mahārāja; ",
  "ja544:37.3": "Yuddhe vā yujjhamāne vā, ",
  "ja544:37.4": "na hi mādisā sūrā honti yaññatthāya. ",
  "ja544:38.1": "1019. ‘‘Paccante vāpi kupite, ",
  "ja544:38.2": "aṭavīsu vā mādise niyojenti; ",
  "ja544:38.3": "Atha no akāraṇasmā, ",
  "ja544:38.4": "abhūmiyaṃ tāta haññāma. ",
  "ja544:39.1": "1020. ‘‘Yāpi hi tā sakuṇiyo, ",
  "ja544:39.2": "vasanti tiṇagharāni katvāna; ",
  "ja544:39.3": "Tāsampi piyā puttā, ",
  "ja544:39.4": "atha no tvaṃ deva ghātesi. ",
  "ja544:40.1": "1021. ‘‘Mā tassa saddahesi, ",
  "ja544:40.2": "na maṃ khaṇḍahālo ghāteyya; ",
  "ja544:40.3": "Mamañhi so ghātetvāna, ",
  "ja544:40.4": "anantarā tampi deva ghāteyya. ",
  "ja544:41.1": "1022. ‘‘Gāmavaraṃ nigamavaraṃ dadanti, ",
  "ja544:41.2": "bhogampissa mahārāja; ",
  "ja544:41.3": "Athaggapiṇḍikāpi, ",
  "ja544:41.4": "kule kule hete bhuñjanti. ",
  "ja544:42.1": "1023. ‘‘Tesampi tādisānaṃ, ",
  "ja544:42.2": "icchanti dubbhituṃ mahārāja; ",
  "ja544:42.3": "Yebhuyyena ete, ",
  "ja544:42.4": "akataññuno brāhmaṇā deva. ",
  "ja544:43.1": "1024. ‘‘Mā no deva avadhi, ",
  "ja544:43.2": "dāse no dehi khaṇḍahālassa; ",
  "ja544:43.3": "Api nigaḷabandhakāpi, ",
  "ja544:43.4": "hatthī asse ca pālema. ",
  "ja544:44.1": "1025. ‘‘Mā no deva avadhi, ",
  "ja544:44.2": "dāse no dehi khaṇḍahālassa; ",
  "ja544:44.3": "Api nigaḷabandhakāpi, ",
  "ja544:44.4": "hatthichakaṇāni ujjhema. ",
  "ja544:45.1": "1026. ‘‘Mā no deva avadhi, ",
  "ja544:45.2": "dāse no dehi khaṇḍahālassa; ",
  "ja544:45.3": "Api nigaḷabandhakāpi, ",
  "ja544:45.4": "assachakaṇāni ujjhema. ",
  "ja544:46.1": "1027. ‘‘Mā no deva avadhi, ",
  "ja544:46.2": "dāse no dehi khaṇḍahālassa; ",
  "ja544:46.3": "Yassa honti tava kāmā, ",
  "ja544:46.4": "api raṭṭhā pabbājitā; ",
  "ja544:46.5": "Bhikkhācariyaṃ carissāma’’. ",
  "ja544:47.1": "1028. ‘‘Dukkhaṃ kho me janayatha, ",
  "ja544:47.2": "vilapantā jīvitassa kāmā hi; ",
  "ja544:47.3": "Muñcetha dāni kumāre, ",
  "ja544:47.4": "alampi me hotu puttayaññena’’. ",
  "ja544:48.1": "1029. ‘‘Pubbeva khosi me vutto, ",
  "ja544:48.2": "dukkaraṃ durabhisambhavañcetaṃ; ",
  "ja544:48.3": "Atha no upakkhaṭassa yaññassa, ",
  "ja544:48.4": "kasmā karosi vikkhepaṃ. ",
  "ja544:49.1": "1030. ‘‘Sabbe vajanti sugatiṃ, ",
  "ja544:49.2": "ye yajanti yepi yājenti; ",
  "ja544:49.3": "Ye cāpi anumodanti, ",
  "ja544:49.4": "yajantānaṃ edisaṃ mahāyaññaṃ’’. ",
  "ja544:50.1": "1031. ‘‘Yadi kira yajitvā puttehi, ",
  "ja544:50.2": "devalokaṃ ito cutā yanti; ",
  "ja544:50.3": "Brāhmaṇo tāva yajatu, ",
  "ja544:50.4": "pacchāpi yajasi tuvaṃ rājā. ",
  "ja544:51.1": "1032. ‘‘Yadi kira yajitvā puttehi, ",
  "ja544:51.2": "devalokaṃ ito cutā yanti; ",
  "ja544:51.3": "Esveva khaṇḍahālo, ",
  "ja544:51.4": "yajataṃ sakehi puttehi. ",
  "ja544:52.1": "1033. ‘‘Evaṃ jānanto khaṇḍahālo, ",
  "ja544:52.2": "kiṃ puttake na ghātesi; ",
  "ja544:52.3": "Sabbañca ñātijanaṃ, ",
  "ja544:52.4": "attānañca na ghātesi. ",
  "ja544:53.1": "1034. ‘‘Sabbe vajanti nirayaṃ, ",
  "ja544:53.2": "ye yajanti yepi yājenti; ",
  "ja544:53.3": "Ye cāpi anumodanti, ",
  "ja544:53.4": "yajantānaṃ edisaṃ mahāyaññaṃ. ",
  "ja544:54.1": "1035. ‘‘Sace hi so sujjhati yo hanāti, ",
  "ja544:54.2": "hatopi so saggamupeti ṭhānaṃ; ",
  "ja544:54.3": "Bhovādi bhovādina mārayeyyuṃ, ",
  "ja544:54.4": "ye cāpi tesaṃ abhisaddaheyyuṃ’’ . ",
  "ja544:55.1": "1036. ‘‘Kathañca kira puttakāmāyo, ",
  "ja544:55.2": "gahapatayo gharaṇiyo ca; ",
  "ja544:55.3": "Nagaramhi na uparavanti rājānaṃ, ",
  "ja544:55.4": "mā ghātayi orasaṃ puttaṃ. ",
  "ja544:56.1": "1037. ‘‘Kathañca kira puttakāmāyo, ",
  "ja544:56.2": "gahapatayo gharaṇiyo ca; ",
  "ja544:56.3": "Nagaramhi na uparavanti rājānaṃ, ",
  "ja544:56.4": "mā ghātayi atrajaṃ puttaṃ. ",
  "ja544:57.1": "1038. ‘‘Rañño camhi atthakāmo, ",
  "ja544:57.2": "hito ca sabbajanapadassa ; ",
  "ja544:57.3": "Na koci assa paṭighaṃ, ",
  "ja544:57.4": "mayā jānapado na pavedeti’’. ",
  "ja544:58.1": "1039. ‘‘Gacchatha vo gharaṇiyo, ",
  "ja544:58.2": "tātañca vadetha khaṇḍahālañca; ",
  "ja544:58.3": "Mā ghātetha kumāre, ",
  "ja544:58.4": "adūsake sīhasaṅkāse. ",
  "ja544:59.1": "1040. ‘‘Gacchatha vo gharaṇiyo, ",
  "ja544:59.2": "tātañca vadetha khaṇḍahālañca; ",
  "ja544:59.3": "Mā ghātetha kumāre, ",
  "ja544:59.4": "apekkhite sabbalokassa’’. ",
  "ja544:60.1": "1041. ‘‘Yaṃ nūnāhaṃ jāyeyyaṃ, ",
  "ja544:60.2": "rathakārakulesu vā; ",
  "ja544:60.3": "Pukkusakulesu vā vessesu vā jāyeyyaṃ; ",
  "ja544:60.4": "Na hajja maṃ rāja yaññe ghāteyya’’. ",
  "ja544:61.1": "1042. ‘‘Sabbā sīmantiniyo gacchatha, ",
  "ja544:61.2": "ayyassa khaṇḍahālassa; ",
  "ja544:61.3": "Pādesu nipatatha, ",
  "ja544:61.4": "aparādhāhaṃ na passāmi. ",
  "ja544:62.1": "1043. ‘‘Sabbā sīmantiniyo gacchatha, ",
  "ja544:62.2": "ayyassa khaṇḍahālassa; ",
  "ja544:62.3": "Pādesu nipatatha, ",
  "ja544:62.4": "kinte bhante mayaṃ adūsema’’. ",
  "ja544:63.1": "1044. ‘‘Kapaṇā vilapati selā, ",
  "ja544:63.2": "disvāna bhātare upanītatte; ",
  "ja544:63.3": "Yañño kira me ukkhipito, ",
  "ja544:63.4": "tātena saggakāmena’’. ",
  "ja544:64.1": "1045. ‘‘Āvatti parivatti ca, ",
  "ja544:64.2": "vasulo sammukhā rañño; ",
  "ja544:64.3": "Mā no pitaraṃ avadhi, ",
  "ja544:64.4": "daharamhā yobbanaṃ pattā’’. ",
  "ja544:65.1": "1046. ‘‘Eso te vasula pitā, ",
  "ja544:65.2": "samehi pitarā saha; ",
  "ja544:65.3": "Dukkhaṃ kho me janayasi, ",
  "ja544:65.4": "vilapanto antepurasmiṃ; ",
  "ja544:65.5": "Muñcetha dāni kumāre, ",
  "ja544:65.6": "alampi me hotu puttayaññena’’. ",
  "ja544:66.1": "1047. ‘‘Pubbeva khosi me vutto, ",
  "ja544:66.2": "dukkaraṃ durabhisambhavañcetaṃ; ",
  "ja544:66.3": "Atha no upakkhaṭassa yaññassa, ",
  "ja544:66.4": "kasmā karosi vikkhepaṃ. ",
  "ja544:67.1": "1048. ‘‘Sabbe vajanti sugatiṃ, ",
  "ja544:67.2": "ye yajanti yepi yājenti; ",
  "ja544:67.3": "Ye cāpi anumodanti, ",
  "ja544:67.4": "yajantānaṃ edisaṃ mahāyaññaṃ’’. ",
  "ja544:68.1": "1049. ‘‘Sabbaratanassa yañño upakkhaṭo, ",
  "ja544:68.2": "ekarāja tava paṭiyatto; ",
  "ja544:68.3": "Abhinikkhamassu deva, ",
  "ja544:68.4": "saggaṃ gato tvaṃ pamodissasi’’. ",
  "ja544:69.1": "1050. ‘‘Daharā sattasatā etā, ",
  "ja544:69.2": "candakumārassa bhariyāyo; ",
  "ja544:69.3": "Kese pakiritvāna , ",
  "ja544:69.4": "rodantiyo maggamanuyāyiṃsu . ",
  "ja544:70.1": "1051. ‘‘Aparā pana sokena, ",
  "ja544:70.2": "nikkhantā nandane viya devā; ",
  "ja544:70.3": "Kese pakiritvāna , ",
  "ja544:70.4": "rodantiyo maggamanuyāyiṃsu’’ . ",
  "ja544:71.1": "1052. ‘‘Kāsikasucivatthadharā, ",
  "ja544:71.2": "kuṇḍalino agalucandanavilittā; ",
  "ja544:71.3": "Niyyanti candasūriyā, ",
  "ja544:71.4": "yaññatthāya ekarājassa. ",
  "ja544:72.1": "1053. ‘‘Kāsikasucivatthadharā, ",
  "ja544:72.2": "kuṇḍalino agalucandanavilittā; ",
  "ja544:72.3": "Niyyanti candasūriyā, ",
  "ja544:72.4": "mātu katvā hadayasokaṃ. ",
  "ja544:73.1": "1054. ‘‘Kāsikasucivatthadharā, ",
  "ja544:73.2": "kuṇḍalino agalucandanavilittā; ",
  "ja544:73.3": "Niyyanti candasūriyā, ",
  "ja544:73.4": "janassa katvā hadayasokaṃ. ",
  "ja544:74.1": "1055. ‘‘Maṃsarasabhojanā nhāpakasunhāpitā , ",
  "ja544:74.2": "kuṇḍalino agalucandanavilittā; ",
  "ja544:74.3": "Niyyanti candasūriyā, ",
  "ja544:74.4": "yaññatthāya ekarājassa. ",
  "ja544:75.1": "1056. ‘‘Maṃsarasabhojanā nhāpakasunhāpitā, ",
  "ja544:75.2": "kuṇḍalino agalucandanavilittā; ",
  "ja544:75.3": "Niyyanti candasūriyā, ",
  "ja544:75.4": "mātu katvā hadayasokaṃ. ",
  "ja544:76.1": "1057. ‘‘Maṃsarasabhojanā nhāpakasunhāpitā, ",
  "ja544:76.2": "kuṇḍalino agalucandanavilittā; ",
  "ja544:76.3": "Niyyanti candasūriyā, ",
  "ja544:76.4": "janassa katvā hadayasokaṃ . ",
  "ja544:77.1": "1058. ‘‘Yassu pubbe hatthivaradhuragate, ",
  "ja544:77.2": "hatthīhi anuvajanti; ",
  "ja544:77.3": "Tyajja candasūriyā, ",
  "ja544:77.4": "ubhova pattikā yanti. ",
  "ja544:78.1": "1059. ‘‘Yassu pubbe assavaradhuragate, ",
  "ja544:78.2": "assehi anuvajanti; ",
  "ja544:78.3": "Tyajja candasūriyā, ",
  "ja544:78.4": "ubhova pattikā yanti. ",
  "ja544:79.1": "1060. ‘‘Yassu pubbe rathavaradhuragate, ",
  "ja544:79.2": "rathehi anuvajanti; ",
  "ja544:79.3": "Tyajja candasūriyā, ",
  "ja544:79.4": "ubhova pattikā yanti. ",
  "ja544:80.1": "1061. ‘‘Yehissu pubbe nīyiṃsu , ",
  "ja544:80.2": "tapanīyakappanehi turaṅgehi; ",
  "ja544:80.3": "Tyajja candasūriyā, ",
  "ja544:80.4": "ubhova pattikā yanti’’. ",
  "ja544:81.1": "1062. ‘‘Yadi sakuṇi maṃsamicchasi, ",
  "ja544:81.2": "ḍayassu pubbena pupphavatiyā; ",
  "ja544:81.3": "Yajatettha ekarājā, ",
  "ja544:81.4": "sammūḷho catūhi puttehi. ",
  "ja544:82.1": "1063. ‘‘Yadi sakuṇi maṃsamicchasi, ",
  "ja544:82.2": "ḍayassu pubbena pupphavatiyā; ",
  "ja544:82.3": "Yajatettha ekarājā, ",
  "ja544:82.4": "sammūḷho catūhi kaññāhi. ",
  "ja544:83.1": "1064. ‘‘Yadi sakuṇi maṃsamicchasi, ",
  "ja544:83.2": "ḍayassu pubbena pupphavatiyā; ",
  "ja544:83.3": "Yajatettha ekarājā, ",
  "ja544:83.4": "sammūḷho catūhi mahesīhi. ",
  "ja544:84.1": "1065. ‘‘Yadi sakuṇi maṃsamicchasi, ",
  "ja544:84.2": "ḍayassu pubbena pupphavatiyā; ",
  "ja544:84.3": "Yajatettha ekarājā, ",
  "ja544:84.4": "sammūḷho catūhi gahapatīhi. ",
  "ja544:85.1": "1066. ‘‘Yadi sakuṇi maṃsamicchasi, ",
  "ja544:85.2": "ḍayassu pubbe pupphavatiyā; ",
  "ja544:85.3": "Yajatettha ekarājā, ",
  "ja544:85.4": "sammūḷho catūhi hatthīhi. ",
  "ja544:86.1": "1067. ‘‘Yadi sakuṇi maṃsamicchasi, ",
  "ja544:86.2": "ḍayassu pubbena pupphavatiyā; ",
  "ja544:86.3": "Yajatettha ekarājā, ",
  "ja544:86.4": "sammūḷho catūhi assehi. ",
  "ja544:87.1": "1068. ‘‘Yadi sakuṇi maṃsamicchasi, ",
  "ja544:87.2": "ḍayassu pubbena pupphavatiyā; ",
  "ja544:87.3": "Yajatettha ekarājā, ",
  "ja544:87.4": "sammūḷho catūhi usabhehi. ",
  "ja544:88.1": "1069. ‘‘Yadi sakuṇi maṃsamicchasi, ",
  "ja544:88.2": "ḍayassu pubbena pupphavatiyā; ",
  "ja544:88.3": "Yajatettha ekarājā, ",
  "ja544:88.4": "sammūḷho sabbacatukkena’’. ",
  "ja544:89.1": "1070. ‘‘Ayamassa pāsādo, ",
  "ja544:89.2": "idaṃ antepuraṃ suramaṇīyaṃ ; ",
  "ja544:89.3": "Tedāni ayyaputtā, ",
  "ja544:89.4": "cattāro vadhāya ninnītā. ",
  "ja544:90.1": "1071. ‘‘Idamassa kūṭāgāraṃ, ",
  "ja544:90.2": "sovaṇṇaṃ pupphamalyavikiṇṇaṃ; ",
  "ja544:90.3": "Tedāni ayyaputtā, ",
  "ja544:90.4": "cattāro vadhāya ninnītā. ",
  "ja544:91.1": "1072. ‘‘Idamassa uyyānaṃ, ",
  "ja544:91.2": "supupphitaṃ sabbakālikaṃ rammaṃ; ",
  "ja544:91.3": "Tedāni ayyaputtā, ",
  "ja544:91.4": "cattāro vadhāya ninnītā. ",
  "ja544:92.1": "1073. ‘‘Idamassa asokavanaṃ, ",
  "ja544:92.2": "supupphitaṃ sabbakālikaṃ rammaṃ; ",
  "ja544:92.3": "Tedāni ayyaputtā, ",
  "ja544:92.4": "cattāro vadhāya ninnītā. ",
  "ja544:93.1": "1074. ‘‘Idamassa kaṇikāravanaṃ, ",
  "ja544:93.2": "supupphitaṃ sabbakālikaṃ rammaṃ; ",
  "ja544:93.3": "Tedāni ayyaputtā, ",
  "ja544:93.4": "cattāro vadhāya ninnītā. ",
  "ja544:94.1": "1075. ‘‘Idamassa pāṭalivanaṃ, ",
  "ja544:94.2": "supupphitaṃ sabbakālikaṃ rammaṃ; ",
  "ja544:94.3": "Tedāni ayyaputtā, ",
  "ja544:94.4": "cattāro vadhāya ninnītā. ",
  "ja544:95.1": "1076. ‘‘Idamassa ambavanaṃ, ",
  "ja544:95.2": "supupphitaṃ sabbakālikaṃ rammaṃ; ",
  "ja544:95.3": "Tedāni ayyaputtā, ",
  "ja544:95.4": "cattāro vadhāya ninnītā. ",
  "ja544:96.1": "1077. ‘‘Ayamassa pokkharaṇī, ",
  "ja544:96.2": "sañchannā padumapuṇḍarīkehi; ",
  "ja544:96.3": "Nāvā ca sovaṇṇavikatā, ",
  "ja544:96.4": "pupphavalliyā cittā suramaṇīyā; ",
  "ja544:96.5": "Tedāni ayyaputtā, ",
  "ja544:96.6": "cattāro vadhāya ninnītā’’. ",
  "ja544:97.1": "1078. ‘‘Idamassa hatthiratanaṃ, ",
  "ja544:97.2": "erāvaṇo gajo balī dantī; ",
  "ja544:97.3": "Tedāni ayyaputtā, ",
  "ja544:97.4": "cattāro vadhāya ninnītā. ",
  "ja544:98.1": "1079. ‘‘Idamassa assaratanaṃ, ",
  "ja544:98.2": "ekakhūro asso; ",
  "ja544:98.3": "Tedāni ayyaputtā, ",
  "ja544:98.4": "cattāro vadhāya ninnītā. ",
  "ja544:99.1": "1080. ‘‘Ayamassa assaratho, ",
  "ja544:99.2": "sāḷiya nigghoso subho ratanavicitto; ",
  "ja544:99.3": "Yatthassu ayyaputtā, ",
  "ja544:99.4": "sobhiṃsu nandane viya devā; ",
  "ja544:99.5": "Tedāni ayyaputtā, ",
  "ja544:99.6": "cattāro vadhāya ninnītā. ",
  "ja544:100.1": "1081. ‘‘Kathaṃ nāma sāmasamasundarehi, ",
  "ja544:100.2": "candanamudukagattehi ; ",
  "ja544:100.3": "Rājā yajissate yaññaṃ, ",
  "ja544:100.4": "sammūḷho catūhi puttehi. ",
  "ja544:101.1": "1082. ‘‘Kathaṃ nāma sāmasamasundarāhi, ",
  "ja544:101.2": "candanamudukagattāhi; ",
  "ja544:101.3": "Rājā yajissate yaññaṃ, ",
  "ja544:101.4": "sammūḷho catūhi kaññāhi. ",
  "ja544:102.1": "1083. ‘‘Kathaṃ nāma sāmasamasundarāhi, ",
  "ja544:102.2": "candanamudukagattāhi; ",
  "ja544:102.3": "Rājā yajissate yaññaṃ, ",
  "ja544:102.4": "sammūḷho catūhi mahesīhi. ",
  "ja544:103.1": "1084. ‘‘Kathaṃ nāma sāmasamasundarehi, ",
  "ja544:103.2": "candanamudukagattehi; ",
  "ja544:103.3": "Rājā yajissate yaññaṃ, ",
  "ja544:103.4": "sammūḷho catūhi gahapatīhi. ",
  "ja544:104.1": "1085. ‘‘Yathā honti gāmanigamā, ",
  "ja544:104.2": "suññā amanussakā brahāraññā; ",
  "ja544:104.3": "Tathā hessati pupphavatiyā, ",
  "ja544:104.4": "yiṭṭhesu candasūriyesu’’. ",
  "ja544:105.1": "1086. ‘‘Ummattikā bhavissāmi, ",
  "ja544:105.2": "bhūnahatā paṃsunā ca parikiṇṇā; ",
  "ja544:105.3": "Sace candavaraṃ hanti, ",
  "ja544:105.4": "pāṇā me deva rujjhanti . ",
  "ja544:106.1": "1087. ‘‘Ummattikā bhavissāmi, ",
  "ja544:106.2": "bhūnahatā paṃsunā ca parikiṇṇā; ",
  "ja544:106.3": "Sace sūriyavaraṃ hanti, ",
  "ja544:106.4": "pāṇā me deva rujjhanti’’. ",
  "ja544:107.1": "1088. ‘‘Kiṃ nu mā na ramāpeyyuṃ, ",
  "ja544:107.2": "aññamaññaṃ piyaṃvadā; ",
  "ja544:107.3": "Ghaṭṭikā uparikkhī ca, ",
  "ja544:107.4": "pokkharaṇī ca bhārikā ; ",
  "ja544:107.5": "Candasūriyesu naccantiyo, ",
  "ja544:107.6": "samā tāsaṃ na vijjati’’. ",
  "ja544:108.1": "1089. ‘‘Imaṃ mayhaṃ hadayasokaṃ, ",
  "ja544:108.2": "paṭimuñcatu khaṇḍahāla tava mātā; ",
  "ja544:108.3": "Yo mayhaṃ hadayasoko, ",
  "ja544:108.4": "candamhi vadhāya ninnīte. ",
  "ja544:109.1": "1090. ‘‘Imaṃ mayhaṃ hadayasokaṃ, ",
  "ja544:109.2": "paṭimuñcatu khaṇḍahāla tava mātā; ",
  "ja544:109.3": "Yo mayhaṃ hadayasoko, ",
  "ja544:109.4": "sūriyamhi vadhāya ninnīte. ",
  "ja544:110.1": "1091. ‘‘Imaṃ mayhaṃ hadayasokaṃ, ",
  "ja544:110.2": "paṭimuñcatu khaṇḍahāla tava jāyā; ",
  "ja544:110.3": "Yo mayhaṃ hadayasoko, ",
  "ja544:110.4": "candamhi vadhāya ninnīte. ",
  "ja544:111.1": "1092. ‘‘Imaṃ mayhaṃ hadayasokaṃ, ",
  "ja544:111.2": "paṭimuñcatu khaṇḍahāla tava jāyā; ",
  "ja544:111.3": "Yo mayhaṃ hadayasoko, ",
  "ja544:111.4": "sūriyamhi vadhāya ninnīte. ",
  "ja544:112.1": "1093. ‘‘Mā ca putte mā ca patiṃ, ",
  "ja544:112.2": "addakkhi khaṇḍahāla tava mātā; ",
  "ja544:112.3": "Yo ghātesi kumāre, ",
  "ja544:112.4": "adūsake sīhasaṅkāse. ",
  "ja544:113.1": "1094. ‘‘Mā ca putte mā ca patiṃ, ",
  "ja544:113.2": "addakkhi khaṇḍahāla tava mātā; ",
  "ja544:113.3": "Yo ghātesi kumāre, ",
  "ja544:113.4": "apekkhite sabbalokassa. ",
  "ja544:114.1": "1095. ‘‘Mā ca putte mā ca patiṃ, ",
  "ja544:114.2": "addakkhi khaṇḍahāla tava jāyā; ",
  "ja544:114.3": "Yo ghātesi kumāre, ",
  "ja544:114.4": "adūsake sīhasaṅkāse. ",
  "ja544:115.1": "1096. ‘‘Mā ca putte mā ca patiṃ, ",
  "ja544:115.2": "addakkhi khaṇḍahāla tava jāyā; ",
  "ja544:115.3": "Yo ghātesi kumāre, ",
  "ja544:115.4": "apekkhite sabbalokassa’’. ",
  "ja544:116.1": "1097. ‘‘Mā no deva avadhi, ",
  "ja544:116.2": "dāse no dehi khaṇḍahālassa; ",
  "ja544:116.3": "Api nigaḷabandhakāpi, ",
  "ja544:116.4": "hatthī asse ca pālema. ",
  "ja544:117.1": "1098. ‘‘Mā no deva avadhi, ",
  "ja544:117.2": "dāse no dehi khaṇḍahālassa; ",
  "ja544:117.3": "Api nigaḷabandhakāpi, ",
  "ja544:117.4": "hatthichakaṇāni ujjhema. ",
  "ja544:118.1": "1099. ‘‘Mā no deva avadhi, ",
  "ja544:118.2": "dāse no dehi khaṇḍahālassa; ",
  "ja544:118.3": "Api nigaḷabandhakāpi, ",
  "ja544:118.4": "assachakaṇāni ujjhema. ",
  "ja544:119.1": "1100. ‘‘Mā no deva avadhi, ",
  "ja544:119.2": "dāse no dehi khaṇḍahālassa; ",
  "ja544:119.3": "Yassa honti tava kāmā, ",
  "ja544:119.4": "api raṭṭhā pabbājitā; ",
  "ja544:119.5": "Bhikkhācariyaṃ carissāma. ",
  "ja544:120.1": "1101. ‘‘Dibbaṃ deva upayācanti, ",
  "ja544:120.2": "puttatthikāpi daliddā; ",
  "ja544:120.3": "Paṭibhānānipi hitvā, ",
  "ja544:120.4": "putte na labhanti ekaccā. ",
  "ja544:121.1": "1102. ‘‘Āsīsikāni karonti, ",
  "ja544:121.2": "puttā no jāyantu tato paputtā ; ",
  "ja544:121.3": "Atha no akāraṇasmā, ",
  "ja544:121.4": "yaññatthāya deva ghātesi. ",
  "ja544:122.1": "1103. ‘‘Upayācitakena puttaṃ labhanti, ",
  "ja544:122.2": "mā tāta no aghātesi; ",
  "ja544:122.3": "Mā kicchāladdhakehi puttehi, ",
  "ja544:122.4": "yajittho imaṃ yaññaṃ. ",
  "ja544:123.1": "1104. ‘‘Upayācitakena puttaṃ labhanti, ",
  "ja544:123.2": "mā tāta no aghātesi; ",
  "ja544:123.3": "Mā kapaṇaladdhakehi puttehi, ",
  "ja544:123.4": "ammāya no vippavāsesi’’. ",
  "ja544:124.1": "1105. ‘‘Bahudukkhā posiya candaṃ, ",
  "ja544:124.2": "amma tuvaṃ jīyase puttaṃ; ",
  "ja544:124.3": "Vandāmi kho te pāde, ",
  "ja544:124.4": "labhataṃ tāto paralokaṃ. ",
  "ja544:125.1": "1106. ‘‘Handa ca maṃ upaguyha, ",
  "ja544:125.2": "pāde te amma vandituṃ dehi; ",
  "ja544:125.3": "Gacchāmi dāni pavāsaṃ , ",
  "ja544:125.4": "yaññatthāya ekarājassa. ",
  "ja544:126.1": "1107. ‘‘Handa ca maṃ upaguyha , ",
  "ja544:126.2": "pāde te amma vandituṃ dehi; ",
  "ja544:126.3": "Gacchāmi dāni pavāsaṃ, ",
  "ja544:126.4": "mātu katvā hadayasokaṃ. ",
  "ja544:127.1": "1108. Handa ca maṃ upaguyha , ",
  "ja544:127.2": "pāde te amma vandituṃ dehi; ",
  "ja544:127.3": "Gacchāmi dāni pavāsaṃ, ",
  "ja544:127.4": "janassa katvā hadayasokaṃ’’. ",
  "ja544:128.1": "1109. ‘‘Handa ca padumapattānaṃ, ",
  "ja544:128.2": "moḷiṃ bandhassu gotamiputta; ",
  "ja544:128.3": "Campakadalamissāyo , ",
  "ja544:128.4": "esā te porāṇikā pakati. ",
  "ja544:129.1": "1110. ‘‘Handa ca vilepanaṃ te, ",
  "ja544:129.2": "pacchimakaṃ candanaṃ vilimpassu; ",
  "ja544:129.3": "Yehi ca suvilitto, ",
  "ja544:129.4": "sobhasi rājaparisāyaṃ. ",
  "ja544:130.1": "1111. ‘‘Handa ca mudukāni vatthāni, ",
  "ja544:130.2": "pacchimakaṃ kāsikaṃ nivāsehi; ",
  "ja544:130.3": "Yehi ca sunivattho, ",
  "ja544:130.4": "sobhasi rājaparisāyaṃ. ",
  "ja544:131.1": "1112. ‘‘Muttāmaṇikanakavibhūsitāni, ",
  "ja544:131.2": "gaṇhassu hatthābharaṇāni; ",
  "ja544:131.3": "Yehi ca hatthābharaṇehi, ",
  "ja544:131.4": "sobhasi rājaparisāyaṃ’’. ",
  "ja544:132.1": "1113. ‘‘Na hi nūnāyaṃ raṭṭhapālo, ",
  "ja544:132.2": "bhūmipati janapadassa dāyādo; ",
  "ja544:132.3": "Lokissaro mahanto, ",
  "ja544:132.4": "putte snehaṃ janayati’’. ",
  "ja544:133.1": "1114. ‘‘Mayhampi piyā puttā, ",
  "ja544:133.2": "attā ca piyo tumhe ca bhariyāyo; ",
  "ja544:133.3": "Saggañca patthayāno , ",
  "ja544:133.4": "tenāhaṃ ghātayissāmi’’. ",
  "ja544:134.1": "1115. ‘‘Maṃ paṭhamaṃ ghātehi, ",
  "ja544:134.2": "mā me hadayaṃ dukkhaṃ phālesi; ",
  "ja544:134.3": "Alaṅkato sundarako, ",
  "ja544:134.4": "putto deva tava sukhumālo. ",
  "ja544:135.1": "1116. ‘‘Handayya maṃ hanassu, ",
  "ja544:135.2": "paraloke candakena hessāmi; ",
  "ja544:135.3": "Puññaṃ karassu vipulaṃ, ",
  "ja544:135.4": "vicarāma ubhopi paraloke’’. ",
  "ja544:136.1": "1117. ‘‘Mā tvaṃ cande rucci maraṇaṃ , ",
  "ja544:136.2": "bahukā tava devarā visālakkhi; ",
  "ja544:136.3": "Te taṃ ramayissanti, ",
  "ja544:136.4": "yiṭṭhasmiṃ gotamiputte’’. ",
  "ja544:137.1": "1118. ‘‘Evaṃ vutte candā attānaṃ, ",
  "ja544:137.2": "hanti hatthatalakehi’’; ",
  "ja544:137.3": "‘‘Alamettha jīvitena, ",
  "ja544:137.4": "pissāmi visaṃ marissāmi. ",
  "ja544:138.1": "1119. ‘‘Na hi nūnimassa rañño, ",
  "ja544:138.2": "mittāmaccā ca vijjare suhadā; ",
  "ja544:138.3": "Ye na vadanti rājānaṃ, ",
  "ja544:138.4": "mā ghātayi orase putte. ",
  "ja544:139.1": "1120. ‘‘Na hi nūnimassa rañño, ",
  "ja544:139.2": "ñātī mittā ca vijjare suhadā; ",
  "ja544:139.3": "Ye na vadanti rājānaṃ, ",
  "ja544:139.4": "mā ghātayi atraje putte. ",
  "ja544:140.1": "1121. ‘‘Ime tepi mayhaṃ puttā, ",
  "ja544:140.2": "guṇino kāyūradhārino rāja; ",
  "ja544:140.3": "Tehipi yajassu yaññaṃ, ",
  "ja544:140.4": "atha muñcatu gotamiputte. ",
  "ja544:141.1": "1122. ‘‘Bilasataṃ maṃ katvāna, ",
  "ja544:141.2": "yajassu sattadhā mahārāja; ",
  "ja544:141.3": "Mā jeṭṭhaputtamavadhi, ",
  "ja544:141.4": "adūsakaṃ sīhasaṅkāsaṃ. ",
  "ja544:142.1": "1123. ‘‘Bilasataṃ maṃ katvāna, ",
  "ja544:142.2": "yajassu sattadhā mahārāja; ",
  "ja544:142.3": "Mā jeṭṭhaputtamavadhi, ",
  "ja544:142.4": "apekkhitaṃ sabbalokassa’’. ",
  "ja544:143.1": "1124. ‘‘Bahukā tava dinnābharaṇā, ",
  "ja544:143.2": "uccāvacā subhaṇitamhi; ",
  "ja544:143.3": "Muttāmaṇiveḷuriyā, ",
  "ja544:143.4": "etaṃ te pacchimakaṃ dānaṃ’’. ",
  "ja544:144.1": "1125. ‘‘Yesaṃ pubbe khandhesu, ",
  "ja544:144.2": "phullā mālāguṇā vivattiṃsu; ",
  "ja544:144.3": "Tesajjapi sunisito , ",
  "ja544:144.4": "nettiṃso vivattissati khandhesu. ",
  "ja544:145.1": "1126. ‘‘Yesaṃ pubbe khandhesu, ",
  "ja544:145.2": "cittā mālāguṇā vivattiṃsu; ",
  "ja544:145.3": "Tesajjapi sunisito, ",
  "ja544:145.4": "nettiṃso vivattissati khandhesu. ",
  "ja544:146.1": "1127. ‘‘Aciraṃ vata nettiṃso, ",
  "ja544:146.2": "vivattissati rājaputtānaṃ khandhesu; ",
  "ja544:146.3": "Atha mama hadayaṃ na phalati, ",
  "ja544:146.4": "tāva daḷhabandhañca me āsi. ",
  "ja544:147.1": "1128. ‘‘Kāsikasucivatthadharā, ",
  "ja544:147.2": "kuṇḍalino agalucandanavilittā; ",
  "ja544:147.3": "Niyyātha candasūriyā, ",
  "ja544:147.4": "yaññatthāya ekarājassa. ",
  "ja544:148.1": "1129. ‘‘Kāsikasucivatthadharā, ",
  "ja544:148.2": "kuṇḍalino agalucandanavilittā; ",
  "ja544:148.3": "Niyyātha candasūriyā, ",
  "ja544:148.4": "mātu katvā hadayasokaṃ. ",
  "ja544:149.1": "1130. ‘‘Kāsikasucivatthadharā, ",
  "ja544:149.2": "kuṇḍalino agalucandanavilittā; ",
  "ja544:149.3": "Niyyātha candasūriyā, ",
  "ja544:149.4": "janassa katvā hadayasokaṃ. ",
  "ja544:150.1": "1131. ‘‘Maṃsarasabhojanā nhāpakasunhāpitā, ",
  "ja544:150.2": "kuṇḍalino agalucandanavilittā; ",
  "ja544:150.3": "Niyyātha candasūriyā, ",
  "ja544:150.4": "yaññatthāya ekarājassa. ",
  "ja544:151.1": "1132. ‘‘Maṃsarasabhojanā nhāpakasunhāpitā, ",
  "ja544:151.2": "kuṇḍalino agalucandanavilittā; ",
  "ja544:151.3": "Niyyātha candasūriyā, ",
  "ja544:151.4": "mātu katvā hadayasokaṃ. ",
  "ja544:152.1": "1133. ‘‘Maṃsarasabhojanā nhāpakasunhāpitā, ",
  "ja544:152.2": "kuṇḍalino agalucandanavilittā; ",
  "ja544:152.3": "Niyyātha candasūriyā, ",
  "ja544:152.4": "janassa katvā hadayasokaṃ’’. ",
  "ja544:153.1": "1134. ‘‘Sabbasmiṃ upakkhaṭasmiṃ, ",
  "ja544:153.2": "nisīdite candasmiṃ yaññatthāya; ",
  "ja544:153.3": "Pañcālarājadhītā pañjalikā, ",
  "ja544:153.4": "sabbaparisāya samanupariyāyi . ",
  "ja544:154.1": "1135. ‘‘Yena saccena khaṇḍahālo, ",
  "ja544:154.2": "pāpakammaṃ karoti dummedho; ",
  "ja544:154.3": "Etena saccavajjena, ",
  "ja544:154.4": "samaṅginī sāmikena homi. ",
  "ja544:155.1": "1136. ‘‘Ye idhatthi amanussā, ",
  "ja544:155.2": "yāni ca yakkhabhūtabhabyāni; ",
  "ja544:155.3": "Karontu me veyyāvaṭikaṃ, ",
  "ja544:155.4": "samaṅginī sāmikena homi. ",
  "ja544:156.1": "1137. ‘‘Yā devatā idhāgatā, ",
  "ja544:156.2": "yāni ca yakkhabhūtabhabyāni; ",
  "ja544:156.3": "Saraṇesiniṃ anāthaṃ tāyatha maṃ, ",
  "ja544:156.4": "yācāmahaṃ patimāhaṃ ajeyaṃ’’ . ",
  "ja544:157.1": "1138. ‘‘Taṃ sutvā amanusso, ",
  "ja544:157.2": "ayokūṭaṃ paribbhametvāna; ",
  "ja544:157.3": "Bhayamassa janayanto, ",
  "ja544:157.4": "rājānaṃ idamavoca. ",
  "ja544:158.1": "1139. ‘‘Bujjhassu kho rājakali, ",
  "ja544:158.2": "mā tāhaṃ matthakaṃ nitāḷesiṃ ; ",
  "ja544:158.3": "Mā jeṭṭhaputtamavadhi, ",
  "ja544:158.4": "adūsakaṃ sīhasaṅkāsaṃ. ",
  "ja544:159.1": "1140. ‘‘Ko te diṭṭho rājakali, ",
  "ja544:159.2": "puttabhariyāyo haññamānāyo ; ",
  "ja544:159.3": "Seṭṭhi ca gahapatayo, ",
  "ja544:159.4": "adūsakā saggakāmā hi. ",
  "ja544:160.1": "1141. ‘‘Taṃ sutvā khaṇḍahālo, ",
  "ja544:160.2": "rājā ca abbhutamidaṃ disvāna; ",
  "ja544:160.3": "Sabbesaṃ bandhanāni mocesuṃ, ",
  "ja544:160.4": "yathā taṃ anupaghātaṃ . ",
  "ja544:161.1": "1142. ‘‘Sabbesu vippamuttesu, ",
  "ja544:161.2": "ye tattha samāgatā tadā āsuṃ; ",
  "ja544:161.3": "Sabbe ekekaleḍḍukamadaṃsu, ",
  "ja544:161.4": "esa vadho khaṇḍahālassa’’. ",
  "ja544:162.1": "1143. ‘‘Sabbe paviṭṭhā nirayaṃ, ",
  "ja544:162.2": "yathā taṃ pāpakaṃ karitvāna; ",
  "ja544:162.3": "Na hi pāpakammaṃ katvā, ",
  "ja544:162.4": "labbhā sugatiṃ ito gantuṃ’’. ",
  "ja544:163.1": "1144. ‘‘Sabbesu vippamuttesu, ",
  "ja544:163.2": "ye tattha samāgatā tadā āsuṃ; ",
  "ja544:163.3": "Candaṃ abhisiñciṃsu, ",
  "ja544:163.4": "samāgatā rājaparisā ca. ",
  "ja544:164.1": "1145. ‘‘Sabbesu vippamuttesu, ",
  "ja544:164.2": "ye tattha samāgatā tadā āsuṃ; ",
  "ja544:164.3": "Candaṃ abhisiñciṃsu, ",
  "ja544:164.4": "samāgatā rājakaññāyo ca. ",
  "ja544:165.1": "1146. ‘‘Sabbesu vippamuttesu, ",
  "ja544:165.2": "ye tattha samāgatā tadā āsuṃ; ",
  "ja544:165.3": "Candaṃ abhisiñciṃsu, ",
  "ja544:165.4": "samāgatā devaparisā ca. ",
  "ja544:166.1": "1147. ‘‘Sabbesu vippamuttesu, ",
  "ja544:166.2": "ye tattha samāgatā tadā āsuṃ; ",
  "ja544:166.3": "Candaṃ abhisiñciṃsu, ",
  "ja544:166.4": "samāgatā devakaññāyo ca. ",
  "ja544:167.1": "1148. ‘‘Sabbesu vippamuttesu, ",
  "ja544:167.2": "ye tattha samāgatā tadā āsuṃ; ",
  "ja544:167.3": "Celukkhepamakaruṃ, ",
  "ja544:167.4": "samāgatā rājaparisā ca. ",
  "ja544:168.1": "1149. ‘‘Sabbesu vippamuttesu, ",
  "ja544:168.2": "ye tattha samāgatā tadā āsuṃ; ",
  "ja544:168.3": "Celukkhepamakaruṃ, ",
  "ja544:168.4": "samāgatā rājakaññāyo ca. ",
  "ja544:169.1": "1150. ‘‘Sabbesu vippamuttesu, ",
  "ja544:169.2": "ye tattha samāgatā tadā āsuṃ; ",
  "ja544:169.3": "Celukkhepamakaruṃ, ",
  "ja544:169.4": "samāgatā devaparisā ca. ",
  "ja544:170.1": "1151. ‘‘Sabbesu vippamuttesu, ",
  "ja544:170.2": "ye tattha samāgatā tadā āsuṃ; ",
  "ja544:170.3": "Celukkhepamakaruṃ, ",
  "ja544:170.4": "samāgatā devakaññāyo ca. ",
  "ja544:171.1": "1152. ‘‘Sabbesu vippamuttesu, ",
  "ja544:171.2": "bahū ānanditā ahuṃ ; ",
  "ja544:171.3": "Nandiṃ pavesi nagaraṃ , ",
  "ja544:171.4": "bandhanā mokkho aghositthā’’ti. ",
  "ja544:172.1": "Candakumārajātakaṃ sattamaṃ. "
}
