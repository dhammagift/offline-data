  "ja63:0.4": "63. Takkapaṇḍitajātakaṃ 63. ",
  "ja63:1.1": "Kodhanā akataññū ca, ",
  "ja63:1.2": "pisuṇā mittabhedikā ; ",
  "ja63:1.3": "Brahmacariyaṃ cara bhikkhu, ",
  "ja63:1.4": "so sukhaṃ na vihāhasīti . ",
  "ja63:2.1": "Takkapaṇḍitajātakaṃ tatiyaṃ. "
}
