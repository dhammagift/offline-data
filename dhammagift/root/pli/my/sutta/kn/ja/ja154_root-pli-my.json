  "ja154:0.4": "154. Uragajātaka (2-1-4) 7. ",
  "ja154:1.1": "Idhūragānaṃ pavaro paviṭṭho, ",
  "ja154:1.2": "selassa vaṇṇena pamokkhamicchaṃ; ",
  "ja154:1.3": "Brahmañca vaṇṇaṃ apacāyamāno, ",
  "ja154:1.4": "bubhukkhito no vitarāmi bhottuṃ. ",
  "ja154:2.1": "8. So brahmagutto cirameva jīva, ",
  "ja154:2.2": "dibyā ca te pātubhavantu bhakkhā; ",
  "ja154:2.3": "Yo brahmavaṇṇaṃ apacāyamāno, ",
  "ja154:2.4": "bubhukkhito no vitarāsi bhottunti. ",
  "ja154:3.1": "Uragajātakaṃ catutthaṃ. "
}
