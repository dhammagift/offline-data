  "ja23:0.4": "23. 23. Gojānīyajātakaṃ ",
  "ja23:1.1": "Api passena semāno, ",
  "ja23:1.2": "sallebhi sallalīkato; ",
  "ja23:1.3": "Seyyova vaḷavā gojo , ",
  "ja23:1.4": "yuñja maññeva sārathīti. ",
  "ja23:2.1": "Gojānīya jātakaṃ tatiyaṃ. "
}
