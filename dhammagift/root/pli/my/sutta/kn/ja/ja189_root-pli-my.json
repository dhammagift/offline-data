  "ja189:0.3": "",
  "ja189:0.4": "189. Sīhacammajātakaṃ (2-4-9) 77. ",
  "ja189:1.1": "Netaṃ sīhassa naditaṃ, ",
  "ja189:1.2": "na byagghassa na dīpino; ",
  "ja189:1.3": "Pāruto sīhacammena, ",
  "ja189:1.4": "jammo nadati gadrabho. ",
  "ja189:2.1": "78. Cirampi kho taṃ khādeyya, ",
  "ja189:2.2": "gadrabho haritaṃ yavaṃ; ",
  "ja189:2.3": "Pāruto sīhacammena, ",
  "ja189:2.4": "ravamānova dūsayīti. ",
  "ja189:3.1": "Sīhacammajātakaṃ navamaṃ. "
}
