  "ja12:0.4": "12. 12. Nigrodhamigajātakaṃ ",
  "ja12:1.1": "Nigrodhameva seveyya, ",
  "ja12:1.2": "na sākhamupasaṃvase; ",
  "ja12:1.3": "Nigrodhasmiṃ mataṃ seyyo, ",
  "ja12:1.4": "yañce sākhasmi jīvitanti. ",
  "ja12:2.1": "Nigrodhamigajātakaṃ dutiyaṃ. "
}
