  "ja478:0.4": "478. Dūtajātakaṃ (5) 54. ",
  "ja478:1.1": "Dūte te brahme pāhesiṃ, ",
  "ja478:1.2": "gaṅgātīrasmi jhāyato; ",
  "ja478:1.3": "Tesaṃ puṭṭho na byākāsi, ",
  "ja478:1.4": "dukkhaṃ guyhamataṃ nu te. ",
  "ja478:2.1": "55. Sace te dukkhamuppajje, ",
  "ja478:2.2": "kāsīnaṃ raṭṭhavaḍḍhana; ",
  "ja478:2.3": "Mā kho naṃ tassa akkhāhi, ",
  "ja478:2.4": "yo taṃ dukkhā na mocaye. ",
  "ja478:3.1": "56. Yo tassa dukkhajātassa, ",
  "ja478:3.2": "ekaṅgamapi bhāgaso ; ",
  "ja478:3.3": "Vippamoceyya dhammena, ",
  "ja478:3.4": "kāmaṃ tassa pavedaya . ",
  "ja478:4.1": "57. Suvijānaṃ siṅgālānaṃ, ",
  "ja478:4.2": "sakuṇānañca vassitaṃ; ",
  "ja478:4.3": "Manussavassitaṃ rāja, ",
  "ja478:4.4": "dubbijānataraṃ tato. ",
  "ja478:5.1": "58. Api ce maññatī poso, ",
  "ja478:5.2": "ñāti mitto sakhāti vā; ",
  "ja478:5.3": "Yo pubbe sumano hutvā, ",
  "ja478:5.4": "pacchā sampajjate diso. ",
  "ja478:6.1": "59. Yo attano dukkhamanānupuṭṭho, ",
  "ja478:6.2": "pavedaye jantu akālarūpe; ",
  "ja478:6.3": "Ānandino tassa bhavantimittā , ",
  "ja478:6.4": "hitesino tassa dukhī bhavanti. ",
  "ja478:7.1": "60. Kālañca ñatvāna tathāvidhassa, ",
  "ja478:7.2": "medhāvīnaṃ ekamanaṃ viditvā; ",
  "ja478:7.3": "Akkheyya tibbāni parassa dhīro, ",
  "ja478:7.4": "saṇhaṃ giraṃ atthavatiṃ pamuñce. ",
  "ja478:8.1": "61. Sace ca jaññā avisayhamattano, ",
  "ja478:8.2": "na te hi mayhaṃ sukhāgamāya; ",
  "ja478:8.3": "Ekova tibbāni saheyya dhīro, ",
  "ja478:8.4": "saccaṃ hirottappamapekkhamāno. ",
  "ja478:9.1": "62. Ahaṃ raṭṭhāni vicaranto, ",
  "ja478:9.2": "nigame rājadhāniyo; ",
  "ja478:9.3": "Bhikkhamāno mahārāja, ",
  "ja478:9.4": "ācariyassa dhanatthiko. ",
  "ja478:10.1": "63. Gahapatī rājapurise, ",
  "ja478:10.2": "mahāsāle ca brāhmaṇe; ",
  "ja478:10.3": "Alatthaṃ satta nikkhāni, ",
  "ja478:10.4": "suvaṇṇassa janādhipa; ",
  "ja478:10.5": "Te me naṭṭhā mahārāja, ",
  "ja478:10.6": "tasmā socāmahaṃ bhusaṃ. ",
  "ja478:11.1": "64. Purisā te mahārāja, ",
  "ja478:11.2": "manasānuvicintitā; ",
  "ja478:11.3": "Nālaṃ dukkhā pamocetuṃ, ",
  "ja478:11.4": "tasmā tesaṃ na byāhariṃ. ",
  "ja478:12.1": "65. Tvañca kho me mahārāja, ",
  "ja478:12.2": "manasānuvicintito; ",
  "ja478:12.3": "Alaṃ dukkhā pamocetuṃ, ",
  "ja478:12.4": "tasmā tuyhaṃ pavedayiṃ. ",
  "ja478:13.1": "66. Tassādāsi pasannatto, ",
  "ja478:13.2": "kāsīnaṃ raṭṭhavaḍḍhano; ",
  "ja478:13.3": "Jātarūpamaye nikkhe, ",
  "ja478:13.4": "suvaṇṇassa catuddasāti. ",
  "ja478:14.1": "Dūtajātakaṃ pañcamaṃ. "
}
