  "ja45:0.4": "45. 45. Rohiṇijātakaṃ ",
  "ja45:1.1": "Seyyo amitto medhāvī, ",
  "ja45:1.2": "yañce bālānukampako; ",
  "ja45:1.3": "Passa rohiṇikaṃ jammiṃ, ",
  "ja45:1.4": "mātaraṃ hantvāna socatīti. ",
  "ja45:2.1": "Rohiṇijātakaṃ pañcamaṃ. "
}
