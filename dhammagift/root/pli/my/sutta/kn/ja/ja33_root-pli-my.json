  "ja33:0.4": "33. 33. Sammodamānajātakaṃ ",
  "ja33:1.1": "Sammodamānā gacchanti, ",
  "ja33:1.2": "jālamādāya pakkhino; ",
  "ja33:1.3": "Yadā te vivadissanti, ",
  "ja33:1.4": "tadā ehinti me vasanti. ",
  "ja33:2.1": "Sammodamānajātakaṃ tatiyaṃ. "
}
