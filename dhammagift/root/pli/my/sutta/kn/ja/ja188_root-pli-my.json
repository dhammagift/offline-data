  "ja188:0.4": "188. Sīhakotthujātakaṃ (2-4-8) 75. ",
  "ja188:1.1": "Sīhaṅgulī sīhanakho, ",
  "ja188:1.2": "sīhapādapatiṭṭhito; ",
  "ja188:1.3": "So sīho sīhasaṅghamhi, ",
  "ja188:1.4": "eko nadati aññathā. ",
  "ja188:2.1": "76. Mā tvaṃ nadi rājaputta, ",
  "ja188:2.2": "appasaddo vane vasa; ",
  "ja188:2.3": "Sarena kho taṃ jāneyyuṃ, ",
  "ja188:2.4": "na hi te pettiko saroti. ",
  "ja188:3.1": "Sīhakotthujātakaṃ aṭṭhamaṃ. "
}
