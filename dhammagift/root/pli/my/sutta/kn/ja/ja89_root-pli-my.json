  "ja89:0.4": "89. Kuhakajātakaṃ 89. ",
  "ja89:1.1": "Vācāva kira te āsi, ",
  "ja89:1.2": "saṇhā sakhilabhāṇino; ",
  "ja89:1.3": "Tiṇamatte asajjittho, ",
  "ja89:1.4": "no ca nikkhasataṃ haranti. ",
  "ja89:2.1": "Kuhakajātakaṃ navamaṃ. "
}
