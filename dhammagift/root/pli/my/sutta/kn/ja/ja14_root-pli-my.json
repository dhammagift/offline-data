  "ja14:0.4": "14. 14. Vātamigajātakaṃ ",
  "ja14:1.1": "Na kiratthi rasehi pāpiyo, ",
  "ja14:1.2": "āvāsehi va santhavehi vā; ",
  "ja14:1.3": "Vātamigaṃ gahananissitaṃ , ",
  "ja14:1.4": "vasamānesi rasehi sañjayoti. ",
  "ja14:2.1": "Vātamigajātakaṃ catutthaṃ. "
}
