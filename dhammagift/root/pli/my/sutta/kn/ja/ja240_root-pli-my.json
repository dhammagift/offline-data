  "ja240:0.4": "240. Mahāpiṅgalajātakaṃ (2-9-10) 179. ",
  "ja240:1.1": "Sabbo jano hiṃsito piṅgalena, ",
  "ja240:1.2": "tasmiṃ mate paccayā vedayanti; ",
  "ja240:1.3": "Piyo nu te āsi akaṇhanetto, ",
  "ja240:1.4": "kasmā nu tvaṃ rodasi dvārapāla. ",
  "ja240:2.1": "180. Na me piyo āsi akaṇhanetto, ",
  "ja240:2.2": "bhāyāmi paccāgamanāya tassa; ",
  "ja240:2.3": "Ito gato hiṃseyya maccurājaṃ, ",
  "ja240:2.4": "so hiṃsito āneyya puna idha. ",
  "ja240:3.1": "181. Daḍḍho vāhasahassehi, ",
  "ja240:3.2": "sitto ghaṭasatehi so; ",
  "ja240:3.3": "Parikkhatā ca sā bhūmi, ",
  "ja240:3.4": "mā bhāyi nāgamissatīti. ",
  "ja240:4.1": "Mahāpiṅgalajātakaṃ dasamaṃ. ",
  "ja240:4.2": "Upāhanavaggo navamo. ",
  "ja240:5.1": "Tassuddānaṃ – ",
  "ja240:6.1": "Varupāhana khujja vikaṇṇakako, ",
  "ja240:6.2": "asitābhuya pañcamavacchanakho; ",
  "ja240:6.3": "Dija pemavaruttamaekapadaṃ, ",
  "ja240:6.4": "kumināmukha piṅgalakena dasāti. "
}
