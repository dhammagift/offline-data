  "ja157:0.4": "157. Guṇajātakaṃ (2-1-7) 13. ",
  "ja157:1.1": "Yena kāmaṃ paṇāmeti, ",
  "ja157:1.2": "dhammo balavataṃ migī; ",
  "ja157:1.3": "Unnadantī vijānāhi, ",
  "ja157:1.4": "jātaṃ saraṇato bhayaṃ. ",
  "ja157:2.1": "14. Api cepi dubbalo mitto, ",
  "ja157:2.2": "mittadhammesu tiṭṭhati; ",
  "ja157:2.3": "So ñātako ca bandhu ca, ",
  "ja157:2.4": "so mitto so ca me sakhā; ",
  "ja157:2.5": "Dāṭhini mātimaññittho , ",
  "ja157:2.6": "siṅgālo mama pāṇadoti. ",
  "ja157:3.1": "Guṇajātakaṃ sattamaṃ. "
}
