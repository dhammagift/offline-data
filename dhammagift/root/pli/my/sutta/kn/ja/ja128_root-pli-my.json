  "ja128:0.4": "128. Biḷāravatajātakaṃ 128. ",
  "ja128:1.1": "Yo ve dhammaṃ dhajaṃ katvā, ",
  "ja128:1.2": "nigūḷho pāpamācare; ",
  "ja128:1.3": "Vissāsayitvā bhūtāni, ",
  "ja128:1.4": "biḷāraṃ nāma taṃ vatanti. ",
  "ja128:2.1": "Biḷāravatajātakaṃ aṭṭhamaṃ. "
}
