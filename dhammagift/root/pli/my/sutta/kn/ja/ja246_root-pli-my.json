  "ja246:0.4": "192. 246. Bālovādajātakaṃ (2-10-6) ",
  "ja246:1.1": "Hantvā chetvā vadhitvā ca, ",
  "ja246:1.2": "deti dānaṃ asaññato; ",
  "ja246:1.3": "Edisaṃ bhattaṃ bhuñjamāno, ",
  "ja246:1.4": "sa pāpamupalimpati . ",
  "ja246:2.1": "193. Puttadārampi ce hantvā, ",
  "ja246:2.2": "deti dānaṃ asaññato; ",
  "ja246:2.3": "Bhuñjamānopi sappañño, ",
  "ja246:2.4": "na pāpamupalimpatīti. ",
  "ja246:3.1": "Bālovādajātakaṃ chaṭṭhaṃ. "
}
