  "ja99:0.4": "99. Parosahassajātakaṃ 99. ",
  "ja99:1.1": "Parosahassampi samāgatānaṃ, ",
  "ja99:1.2": "kandeyyuṃ te vassasataṃ apaññā; ",
  "ja99:1.3": "Ekova seyyo puriso sapañño, ",
  "ja99:1.4": "yo bhāsitassa vijānāti atthanti. ",
  "ja99:2.1": "Parosahassajātakaṃ navamaṃ. "
}
