  "ja192:0.4": "83. 192. Sirikāḷakaṇṇijātakaṃ (2-5-2) ",
  "ja192:1.1": "Itthī siyā rūpavatī, ",
  "ja192:1.2": "sā ca sīlavatī siyā; ",
  "ja192:1.3": "Puriso taṃ na iccheyya, ",
  "ja192:1.4": "saddahāsi mahosadha. ",
  "ja192:2.1": "84. Saddahāmi mahārāja, ",
  "ja192:2.2": "puriso dubbhago siyā; ",
  "ja192:2.3": "Sirī ca kāḷakaṇṇī ca, ",
  "ja192:2.4": "na samenti kudācananti. ",
  "ja192:3.1": "Sirikāḷakaṇṇijātakaṃ dutiyaṃ. "
}
