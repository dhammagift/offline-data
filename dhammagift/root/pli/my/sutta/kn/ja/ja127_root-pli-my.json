  "ja127:0.4": "127. 127. Kalaṇḍukajātakaṃ ",
  "ja127:1.1": "Te desā tāni vatthūni, ",
  "ja127:1.2": "ahañca vanagocaro; ",
  "ja127:1.3": "Anuvicca kho taṃ gaṇheyyuṃ, ",
  "ja127:1.4": "piva khīraṃ kalaṇḍukāti. ",
  "ja127:2.1": "Kalaṇḍukajātakaṃ sattamaṃ. "
}
