  "ja266:0.4": "266. Vātaggasindhavajātakaṃ (3-2-6) 46. ",
  "ja266:1.1": "Yenāsi kisiyā paṇḍu, ",
  "ja266:1.2": "yena bhattaṃ na ruccati; ",
  "ja266:1.3": "Ayaṃ so āgato bhattā , ",
  "ja266:1.4": "kasmā dāni palāyasi. ",
  "ja266:2.1": "47. Sace panādikeneva, ",
  "ja266:2.2": "santhavo nāma jāyati; ",
  "ja266:2.3": "Yaso hāyati itthīnaṃ, ",
  "ja266:2.4": "tasmā tāta palāyahaṃ . ",
  "ja266:3.1": "48. Yassassinaṃ kule jātaṃ, ",
  "ja266:3.2": "āgataṃ yā na icchati; ",
  "ja266:3.3": "Socati cirarattāya, ",
  "ja266:3.4": "vātaggamiva bhaddalīti . ",
  "ja266:4.1": "Vātaggasindhavajātakaṃ chaṭṭhaṃ. "
}
