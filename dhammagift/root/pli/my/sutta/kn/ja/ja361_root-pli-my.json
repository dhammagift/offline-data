  "ja361:0.1": "",
  "ja361:0.2": "",
  "ja361:0.3": "2. Vaṇṇārohavaggo ",
  "ja361:0.4": "60. 361. Vaṇṇārohajātakaṃ (5-2-1) ",
  "ja361:1.1": "Vaṇṇārohena jātiyā, ",
  "ja361:1.2": "balanikkamanena ca; ",
  "ja361:1.3": "Subāhu na mayā seyyo, ",
  "ja361:1.4": "sudāṭha iti bhāsasi. ",
  "ja361:2.1": "61. Vaṇṇārohena jātiyā, ",
  "ja361:2.2": "balanikkamanena ca; ",
  "ja361:2.3": "Sudāṭho na mayā seyyo, ",
  "ja361:2.4": "subāhu iti bhāsasi. ",
  "ja361:3.1": "62. Evaṃ ce maṃ viharantaṃ, ",
  "ja361:3.2": "subāhu samma dubbhasi; ",
  "ja361:3.3": "Na dānāhaṃ tayā saddhiṃ, ",
  "ja361:3.4": "saṃvāsamabhirocaye. ",
  "ja361:4.1": "63. Yo paresaṃ vacanāni, ",
  "ja361:4.2": "saddaheyya yathātathaṃ; ",
  "ja361:4.3": "Khippaṃ bhijjetha mittasmiṃ, ",
  "ja361:4.4": "verañca pasave bahuṃ. ",
  "ja361:5.1": "64. Na so mitto yo sadā appamatto, ",
  "ja361:5.2": "bhedāsaṅkī randhamevānupassī; ",
  "ja361:5.3": "Yasmiñca setī urasīva putto, ",
  "ja361:5.4": "sa ve mitto yo abhejjo parehīti. ",
  "ja361:6.1": "Vaṇṇārohajātakaṃ paṭhamaṃ. "
}
