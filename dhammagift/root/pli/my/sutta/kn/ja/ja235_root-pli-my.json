  "ja235:0.4": "169. 235. Vacchanakhajātakaṃ (2-9-5) ",
  "ja235:1.1": "Sukhā gharā vacchanakha, ",
  "ja235:1.2": "sahiraññā sabhojanā; ",
  "ja235:1.3": "Yattha bhutvā pivitvā ca, ",
  "ja235:1.4": "sayeyyātha anussuko. ",
  "ja235:2.1": "170. Gharā nānīhamānassa, ",
  "ja235:2.2": "gharā nābhaṇato musā; ",
  "ja235:2.3": "Gharā nādinnadaṇḍassa, ",
  "ja235:2.4": "paresaṃ anikubbato ; ",
  "ja235:2.5": "Evaṃ chiddaṃ durabhisambhavaṃ , ",
  "ja235:2.6": "ko gharaṃ paṭipajjatīti. ",
  "ja235:3.1": "Vacchanakhajātakaṃ pañcamaṃ. "
}
