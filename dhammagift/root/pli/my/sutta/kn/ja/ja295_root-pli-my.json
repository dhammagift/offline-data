  "ja295:0.3": "",
  "ja295:0.4": "295. Antajātakaṃ (3-5-5) 133. ",
  "ja295:1.1": "Usabhasseva te khandho, ",
  "ja295:1.2": "sīhasseva vijambhitaṃ; ",
  "ja295:1.3": "Migarāja namo tyatthu, ",
  "ja295:1.4": "api kiñci labhāmase. ",
  "ja295:2.1": "134. Kulaputtova jānāti, ",
  "ja295:2.2": "kulaputtaṃ pasaṃsituṃ; ",
  "ja295:2.3": "Mayūragīvasaṅkāsa, ",
  "ja295:2.4": "ito pariyāhi vāyasa. ",
  "ja295:3.1": "135. Migānaṃ siṅgālo anto, ",
  "ja295:3.2": "pakkhīnaṃ pana vāyaso; ",
  "ja295:3.3": "Eraṇḍo anto rukkhānaṃ, ",
  "ja295:3.4": "tayo antā samāgatāti. ",
  "ja295:4.1": "Antajātakaṃ pañcamaṃ. "
}
