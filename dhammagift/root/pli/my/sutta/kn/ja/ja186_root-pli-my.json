  "ja186:0.4": "186. Dadhivāhanajātakaṃ (2-4-6) 71. ",
  "ja186:1.1": "Vaṇṇagandharasūpeto, ",
  "ja186:1.2": "amboyaṃ ahuvā pure; ",
  "ja186:1.3": "Tameva pūjaṃ labhamāno, ",
  "ja186:1.4": "kenambo kaṭukapphalo. ",
  "ja186:2.1": "72. Pucimandaparivāro, ",
  "ja186:2.2": "ambo te dadhivāhana; ",
  "ja186:2.3": "Mūlaṃ mūlena saṃsaṭṭhaṃ, ",
  "ja186:2.4": "sākhā sākhā nisevare ; ",
  "ja186:2.5": "Asātasannivāsena, ",
  "ja186:2.6": "tenambo kaṭukapphaloti. ",
  "ja186:3.1": "Dadhivāhanajātakaṃ chaṭṭhaṃ. "
}
