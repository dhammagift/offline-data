  "ja16:0.4": "16. Tipallatthamigajātakaṃ 16. ",
  "ja16:1.1": "Migaṃ tipallattha manekamāyaṃ, ",
  "ja16:1.2": "aṭṭhakkhuraṃ aḍḍharattāpapāyiṃ ; ",
  "ja16:1.3": "Ekena sotena chamāssasanto, ",
  "ja16:1.4": "chahi kalāhitibhoti bhāgineyyoti. ",
  "ja16:2.1": "Tipallatthamigajātakaṃ chaṭṭhaṃ. "
}
