  "ja280:0.3": "",
  "ja280:0.4": "280. Puṭadūsakajātakaṃ (3-3-10) 88. ",
  "ja280:1.1": "Addhā hi nūna migarājā, ",
  "ja280:1.2": "puṭakammassa kovido; ",
  "ja280:1.3": "Tathā hi puṭaṃ dūseti, ",
  "ja280:1.4": "aññaṃ nūna karissati. ",
  "ja280:2.1": "89. Na me mātā vā pitā vā, ",
  "ja280:2.2": "puṭakammassa kovido; ",
  "ja280:2.3": "Kataṃ kataṃ kho dūsema, ",
  "ja280:2.4": "evaṃ dhammamidaṃ kulaṃ. ",
  "ja280:3.1": "90. Yesaṃ vo ediso dhammo, ",
  "ja280:3.2": "adhammo pana kīdiso; ",
  "ja280:3.3": "Mā vo dhammaṃ adhammaṃ vā, ",
  "ja280:3.4": "addasāma kudācananti. ",
  "ja280:4.1": "Puṭadūsakajātakaṃ dasamaṃ. ",
  "ja280:4.2": "Udapānavaggo tatiyo. ",
  "ja280:5.1": "Tassuddānaṃ – ",
  "ja280:6.1": "Udapānavaraṃ vanabyaggha kapi, ",
  "ja280:6.2": "sikhinī ca balāka ruciravaro; ",
  "ja280:6.3": "Sujanādhiparomakadūsa puna, ",
  "ja280:6.4": "satapattavaro puṭakamma dasāti. "
}
