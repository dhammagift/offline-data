  "ja114:0.4": "114. Mitacintijātakaṃ 114. ",
  "ja114:1.1": "Bahucintī appacintī, ",
  "ja114:1.2": "ubho jāle abajjhare; ",
  "ja114:1.3": "Mitacintī pamocesī, ",
  "ja114:1.4": "ubho tattha samāgatāti. ",
  "ja114:2.1": "Mitacintijātakaṃ catutthaṃ. "
}
