  "ja431:0.4": "40. 431. Haritacajātakaṃ (5) ",
  "ja431:1.1": "Sutaṃ metaṃ mahābrahme, ",
  "ja431:1.2": "kāme bhuñjati hārito; ",
  "ja431:1.3": "Kaccetaṃ vacanaṃ tucchaṃ, ",
  "ja431:1.4": "kacci suddho iriyyasi. ",
  "ja431:2.1": "41. Evametaṃ mahārāja, ",
  "ja431:2.2": "yathā te vacanaṃ sutaṃ; ",
  "ja431:2.3": "Kummaggaṃ paṭipannosmi, ",
  "ja431:2.4": "mohaneyyesu mucchito. ",
  "ja431:3.1": "42. Adu paññā kimatthiyā, ",
  "ja431:3.2": "nipuṇā sādhucintinī ; ",
  "ja431:3.3": "Yāya uppatitaṃ rāgaṃ, ",
  "ja431:3.4": "kiṃ mano na vinodaye. ",
  "ja431:4.1": "43. Cattārome mahārāja, ",
  "ja431:4.2": "loke atibalā bhusā; ",
  "ja431:4.3": "Rāgo doso mado moho, ",
  "ja431:4.4": "yattha paññā na gādhati. ",
  "ja431:5.1": "44. Arahā sīlasampanno, ",
  "ja431:5.2": "suddho carati hārito; ",
  "ja431:5.3": "Medhāvī paṇḍito ceva, ",
  "ja431:5.4": "iti no sammato bhavaṃ. ",
  "ja431:6.1": "45. Medhāvīnampi hiṃsanti, ",
  "ja431:6.2": "isiṃ dhammaguṇe rataṃ; ",
  "ja431:6.3": "Vitakkā pāpakā rāja, ",
  "ja431:6.4": "subhā rāgūpasaṃhitā. ",
  "ja431:7.1": "46. Uppannāyaṃ sarīrajo, ",
  "ja431:7.2": "rāgo vaṇṇavidūsano tava; ",
  "ja431:7.3": "Taṃ pajaha bhaddamatthu te, ",
  "ja431:7.4": "bahunnāsi medhāvisammato. ",
  "ja431:8.1": "47. Te andhakārake kāme, ",
  "ja431:8.2": "bahudukkhe mahāvise; ",
  "ja431:8.3": "Tesaṃ mūlaṃ gavesissaṃ, ",
  "ja431:8.4": "checchaṃ rāgaṃ sabandhanaṃ. ",
  "ja431:9.1": "48. Idaṃ vatvāna hārito, ",
  "ja431:9.2": "isi saccaparakkamo; ",
  "ja431:9.3": "Kāmarāgaṃ virājetvā, ",
  "ja431:9.4": "brahmalokūpago ahūti. ",
  "ja431:10.1": "Haritacajātakaṃ pañcamaṃ. "
}
