  "ja404:0.4": "61. 404. Kapijātakaṃ (7-1-9) ",
  "ja404:1.1": "Yattha verī nivasati, ",
  "ja404:1.2": "na vase tattha paṇḍito; ",
  "ja404:1.3": "Ekarattaṃ dirattaṃ vā, ",
  "ja404:1.4": "dukkhaṃ vasati verisu. ",
  "ja404:2.1": "62. Diso ve lahucittassa, ",
  "ja404:2.2": "posassānuvidhīyato; ",
  "ja404:2.3": "Ekassa kapino hetu, ",
  "ja404:2.4": "yūthassa anayo kato. ",
  "ja404:3.1": "63. Bālova paṇḍitamānī, ",
  "ja404:3.2": "yūthassa parihārako; ",
  "ja404:3.3": "Sacittassa vasaṃ gantvā, ",
  "ja404:3.4": "sayethāyaṃ yathā kapi. ",
  "ja404:4.1": "64. Na sādhu balavā bālo, ",
  "ja404:4.2": "yūthassa parihārako; ",
  "ja404:4.3": "Ahito bhavati ñātīnaṃ, ",
  "ja404:4.4": "sakuṇānaṃva cetako . ",
  "ja404:5.1": "65. Dhīrova balavā sādhu, ",
  "ja404:5.2": "yūthassa parihārako; ",
  "ja404:5.3": "Hito bhavati ñātīnaṃ, ",
  "ja404:5.4": "tidasānaṃva vāsavo. ",
  "ja404:6.1": "66. Yo ca sīlañca paññañca, ",
  "ja404:6.2": "sutañcattani passati; ",
  "ja404:6.3": "Ubhinnamatthaṃ carati, ",
  "ja404:6.4": "attano ca parassa ca. ",
  "ja404:7.1": "67. Tasmā tuleyya mattānaṃ, ",
  "ja404:7.2": "sīlapaññāsutāmiva ; ",
  "ja404:7.3": "Gaṇaṃ vā parihare dhīro, ",
  "ja404:7.4": "eko vāpi paribbajeti. ",
  "ja404:8.1": "Kapijātakaṃ navamaṃ. "
}
