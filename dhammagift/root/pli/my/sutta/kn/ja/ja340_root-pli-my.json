  "ja340:0.3": "",
  "ja340:0.4": "157. 340. Visayhajātakaṃ (4-4-10) ",
  "ja340:1.1": "Adāsi dānāni pure visayha, ",
  "ja340:1.2": "dadato ca te khayadhammo ahosi; ",
  "ja340:1.3": "Ito paraṃ ce na dadeyya dānaṃ, ",
  "ja340:1.4": "tiṭṭheyyuṃ te saṃyamantassa bhogā. ",
  "ja340:2.1": "158. Anariyamariyena sahassanetta, ",
  "ja340:2.2": "suduggatenāpi akiccamāhu; ",
  "ja340:2.3": "Mā vo dhanaṃ taṃ ahu devarāja , ",
  "ja340:2.4": "yaṃ bhogahetu vijahemu saddhaṃ. ",
  "ja340:3.1": "159. Yena eko ratho yāti, ",
  "ja340:3.2": "yāti tenāparo ratho; ",
  "ja340:3.3": "Porāṇaṃ nihitaṃ vattaṃ, ",
  "ja340:3.4": "vattataññeva vāsava. ",
  "ja340:4.1": "160. Yadi hessati dassāma, ",
  "ja340:4.2": "asante kiṃ dadāmase; ",
  "ja340:4.3": "Evaṃbhūtāpi dassāma, ",
  "ja340:4.4": "mā dānaṃ pamadamhaseti. ",
  "ja340:5.1": "Visayhajātakaṃ dasamaṃ. ",
  "ja340:5.2": "Kokilavaggo catuttho. ",
  "ja340:6.1": "Tassuddānaṃ – ",
  "ja340:7.1": "Ativelapabhāsati jītavaro, ",
  "ja340:7.2": "vanamajjha rathesabha jimhagamo; ",
  "ja340:7.3": "Atha jambu tiṇāsanapīṭhavaraṃ, ",
  "ja340:7.4": "atha taṇḍula mora visayha dasāti. "
}
