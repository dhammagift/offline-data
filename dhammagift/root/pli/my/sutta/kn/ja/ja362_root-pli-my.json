  "ja362:0.4": "362. Sīlavīmaṃsajātakaṃ (5-2-2) 65. ",
  "ja362:1.1": "Sīlaṃ seyyo sutaṃ seyyo, ",
  "ja362:1.2": "iti me saṃsayo ahu; ",
  "ja362:1.3": "Sīlameva sutā seyyo, ",
  "ja362:1.4": "iti me natthi saṃsayo. ",
  "ja362:2.1": "66. Moghā jāti ca vaṇṇo ca, ",
  "ja362:2.2": "sīlameva kiruttamaṃ; ",
  "ja362:2.3": "Sīlena anupetassa, ",
  "ja362:2.4": "sutenattho na vijjati. ",
  "ja362:3.1": "67. Khattiyo ca adhammaṭṭho, ",
  "ja362:3.2": "vesso cādhammanissito; ",
  "ja362:3.3": "Te pariccajjubho loke, ",
  "ja362:3.4": "upapajjanti duggatiṃ. ",
  "ja362:4.1": "68. Khattiyā brāhmaṇā vessā, ",
  "ja362:4.2": "suddā caṇḍālapukkusā; ",
  "ja362:4.3": "Idha dhammaṃ caritvāna, ",
  "ja362:4.4": "bhavanti tidive samā. ",
  "ja362:5.1": "69. Na vedā samparāyāya, ",
  "ja362:5.2": "na jāti nāpi bandhavā; ",
  "ja362:5.3": "Sakañca sīlaṃ saṃsuddhaṃ, ",
  "ja362:5.4": "samparāyāya sukhāya cāti . ",
  "ja362:6.1": "Sīlavīmaṃsajātakaṃ dutiyaṃ. "
}
