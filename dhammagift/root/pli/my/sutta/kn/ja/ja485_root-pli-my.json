  "ja485:0.4": "485. Candakinnarījātakaṃ (2) 18. ",
  "ja485:1.1": "Upanīyatidaṃ maññe, ",
  "ja485:1.2": "cande lohitamaddane; ",
  "ja485:1.3": "Ajja jahāmi jīvitaṃ, ",
  "ja485:1.4": "pāṇā me cande nirujjhanti. ",
  "ja485:2.1": "19. Osīdi me dukkhaṃ hadayaṃ, ",
  "ja485:2.2": "me ḍayhate nitammāmi; ",
  "ja485:2.3": "Tava candiyā socantiyā, ",
  "ja485:2.4": "na naṃ aññehi sokehi. ",
  "ja485:3.1": "20. Tiṇamiva vanamiva milāyāmi , ",
  "ja485:3.2": "nadī aparipuṇṇāva sussāmi; ",
  "ja485:3.3": "Tava candiyā socantiyā, ",
  "ja485:3.4": "na naṃ aññehi sokehi. ",
  "ja485:4.1": "21. Vassamiva sare pāde , ",
  "ja485:4.2": "imāni assūni vattare mayhaṃ; ",
  "ja485:4.3": "Tava candiyā socantiyā, ",
  "ja485:4.4": "na naṃ aññehi sokehi. ",
  "ja485:5.1": "22. Pāpo khosi rājaputta, ",
  "ja485:5.2": "yo me icchitaṃ patiṃ varākiyā; ",
  "ja485:5.3": "Vijjhasi vanamūlasmiṃ, ",
  "ja485:5.4": "soyaṃ viddho chamā seti. ",
  "ja485:6.1": "23. Imaṃ mayhaṃ hadayasokaṃ, ",
  "ja485:6.2": "paṭimuñcatu rājaputta tava mātā; ",
  "ja485:6.3": "Yo mayhaṃ hadayasoko, ",
  "ja485:6.4": "kimpurisaṃ avekkhamānāya. ",
  "ja485:7.1": "24. Imaṃ mayhaṃ hadayasokaṃ, ",
  "ja485:7.2": "paṭimuñcatu rājaputta tava jāyā; ",
  "ja485:7.3": "Yo mayhaṃ hadayasoko, ",
  "ja485:7.4": "kimpurisaṃ avekkhamānāya. ",
  "ja485:8.1": "25. Mā ca puttaṃ mā ca patiṃ, ",
  "ja485:8.2": "addakkhi rājaputta tava mātā; ",
  "ja485:8.3": "Yo kimpurisaṃ avadhi, ",
  "ja485:8.4": "adūsakaṃ mayha kāmā hi . ",
  "ja485:9.1": "26. Mā ca puttaṃ mā ca patiṃ, ",
  "ja485:9.2": "addakkhi rājaputta tava jāyā; ",
  "ja485:9.3": "Yo kimpurisaṃ avadhi, ",
  "ja485:9.4": "adūsakaṃ mayha kāmā hi. ",
  "ja485:10.1": "27. Mā tvaṃ cande rodi, ",
  "ja485:10.2": "mā soci vanatimiramattakkhi; ",
  "ja485:10.3": "Mama tvaṃ hehisi bhariyā, ",
  "ja485:10.4": "rājakule pūjitā nārībhi . ",
  "ja485:11.1": "28. Api nūnahaṃ marissaṃ, ",
  "ja485:11.2": "nāhaṃ rājaputta tava hessaṃ; ",
  "ja485:11.3": "Yo kimpurisaṃ avadhi, ",
  "ja485:11.4": "adūsakaṃ mayha kāmā hi. ",
  "ja485:12.1": "29. Api bhīruke api jīvitukāmike, ",
  "ja485:12.2": "kimpurisi gaccha himavantaṃ; ",
  "ja485:12.3": "Tālīsatagarabhojanā, ",
  "ja485:12.4": "aññe taṃ migā ramissanti. ",
  "ja485:13.1": "30. Te pabbatā tā ca kandarā, ",
  "ja485:13.2": "tā ca giriguhāyo tatheva tiṭṭhanti ; ",
  "ja485:13.3": "Tattheva taṃ apassantī, ",
  "ja485:13.4": "kimpurisa kathaṃ ahaṃ kassaṃ. ",
  "ja485:14.1": "31. Te paṇṇasanthatā ramaṇīyā, ",
  "ja485:14.2": "vāḷamigehi anuciṇṇā; ",
  "ja485:14.3": "Tattheva taṃ apassantī, ",
  "ja485:14.4": "kimpurisa kathaṃ ahaṃ kassaṃ . ",
  "ja485:15.1": "32. Te pupphasanthatā ramaṇīyā, ",
  "ja485:15.2": "vāḷamigehi anuciṇṇā; ",
  "ja485:15.3": "Tattheva taṃ apassantī, ",
  "ja485:15.4": "kimpurisa kathaṃ ahaṃ kassaṃ. ",
  "ja485:16.1": "33. Acchā savanti girivana nadiyo, ",
  "ja485:16.2": "kusumābhikiṇṇasotāyo; ",
  "ja485:16.3": "Tattheva taṃ apassantī, ",
  "ja485:16.4": "kimpurisa kathaṃ ahaṃ kassaṃ. ",
  "ja485:17.1": "34. Nīlāni himavato pabbatassa, ",
  "ja485:17.2": "kūṭāni dassanīyāni ; ",
  "ja485:17.3": "Tattheva taṃ apassantī, ",
  "ja485:17.4": "kimpurisa kathaṃ ahaṃ kassaṃ. ",
  "ja485:18.1": "35. Pītāni himavato pabbatassa, ",
  "ja485:18.2": "kūṭāni dassanīyāni; ",
  "ja485:18.3": "Tattheva taṃ apassantī, ",
  "ja485:18.4": "kimpurisa kathaṃ ahaṃ kassaṃ. ",
  "ja485:19.1": "36. Tambāni himavato pabbatassa, ",
  "ja485:19.2": "kūṭāni dassanīyāni; ",
  "ja485:19.3": "Tattheva taṃ apassantī, ",
  "ja485:19.4": "kimpurisa kathaṃ ahaṃ kassaṃ. ",
  "ja485:20.1": "37. Tuṅgāni himavato pabbatassa, ",
  "ja485:20.2": "kūṭāni dassanīyāni; ",
  "ja485:20.3": "Tattheva taṃ apassantī, ",
  "ja485:20.4": "kimpurisa kathaṃ ahaṃ kassaṃ. ",
  "ja485:21.1": "38. Setāni himavato pabbatassa, ",
  "ja485:21.2": "kūṭāni dassanīyāni; ",
  "ja485:21.3": "Tattheva taṃ apassantī, ",
  "ja485:21.4": "kimpurisa kathaṃ ahaṃ kassaṃ. ",
  "ja485:22.1": "39. Citrāni himavato pabbatassa, ",
  "ja485:22.2": "kūṭāni dassanīyāni; ",
  "ja485:22.3": "Tattheva taṃ apassantī, ",
  "ja485:22.4": "kimpurisa kathaṃ ahaṃ kassaṃ. ",
  "ja485:23.1": "40. Yakkhagaṇasevite gandhamādane, ",
  "ja485:23.2": "osadhebhi sañchanne; ",
  "ja485:23.3": "Tattheva taṃ apassantī, ",
  "ja485:23.4": "kimpurisa kathaṃ ahaṃ kassaṃ. ",
  "ja485:24.1": "41. Kimpurisasevite gandhamādane, ",
  "ja485:24.2": "osadhebhi sañchanne; ",
  "ja485:24.3": "Tattheva taṃ apassantī, ",
  "ja485:24.4": "kimpurisa kathaṃ ahaṃ kassaṃ. ",
  "ja485:25.1": "42. Vande te ayirabrahme , ",
  "ja485:25.2": "yo me icchitaṃ patiṃ varākiyā; ",
  "ja485:25.3": "Amatena abhisiñci, ",
  "ja485:25.4": "samāgatāsmi piyatamena. ",
  "ja485:26.1": "43. Vicarāma dāni girivana nadiyo, ",
  "ja485:26.2": "kusumābhikiṇṇasotāyo; ",
  "ja485:26.3": "Nānādumavasanāyo , ",
  "ja485:26.4": "piyaṃvadā aññamaññassāti. ",
  "ja485:27.1": "Candakinnarījātakaṃ dutiyaṃ. "
}
