  "ja300:0.3": "",
  "ja300:0.4": "300. Vakajātakaṃ (3-5-10) 148. ",
  "ja300:1.1": "Parapāṇarodhā jīvanto, ",
  "ja300:1.2": "maṃsalohitabhojano; ",
  "ja300:1.3": "Vako vataṃ samādāya, ",
  "ja300:1.4": "upapajji uposathaṃ. ",
  "ja300:2.1": "149. Tassa sakko vataññāya, ",
  "ja300:2.2": "ajarūpenupāgami; ",
  "ja300:2.3": "Vītatapo ajjhappatto, ",
  "ja300:2.4": "bhañji lohitapo tapaṃ. ",
  "ja300:3.1": "150. Evameva idhekacce, ",
  "ja300:3.2": "samādānamhi dubbalā; ",
  "ja300:3.3": "Lahuṃ karonti attānaṃ, ",
  "ja300:3.4": "vakova ajakāraṇāti. ",
  "ja300:4.1": "Vakajātakaṃ dasamaṃ. ",
  "ja300:4.2": "Kumbhavaggo pañcamo. ",
  "ja300:5.1": "Tassuddānaṃ – ",
  "ja300:6.1": "Varakumbha supattasirivhayano, ",
  "ja300:6.2": "sucisammata bindusaro cusabho; ",
  "ja300:6.3": "Saritaṃpati caṇḍi jarākapinā, ",
  "ja300:6.4": "atha makkaṭiyā vakakena dasāti. ",
  "ja300:7.1": "Atha vagguddānaṃ – ",
  "ja300:8.1": "Saṅkappo padumo ceva, ",
  "ja300:8.2": "udapānena tatiyaṃ; ",
  "ja300:8.3": "Abbhantaraṃ ghaṭabhedaṃ, ",
  "ja300:8.4": "tikanipātamhilaṅkatanti. ",
  "ja300:9.1": "Tikanipātaṃ niṭṭhitaṃ. "
}
