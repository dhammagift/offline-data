{
  "ja251:0.1": "",
  "ja251:0.2": "3. Tikanipāto ",
  "ja251:0.3": "1. Saṅkappavaggo ",
  "ja251:0.4": "251. Saṅkapparāgajātakaṃ (3-1-1) 1. ",
  "ja251:1.1": "Saṅkapparāgadhotena, ",
  "ja251:1.2": "vitakkanisitena ca; ",
  "ja251:1.3": "Nālaṅkatena bhadrena , ",
  "ja251:1.4": "usukārākatena ca . ",
  "ja251:2.1": "2. Na kaṇṇāyatamuttena, ",
  "ja251:2.2": "nāpi morūpasevinā; ",
  "ja251:2.3": "Tenamhi hadaye viddho, ",
  "ja251:2.4": "sabbaṅgaparidāhinā. ",
  "ja251:3.1": "3. Āvedhañca na passāmi, ",
  "ja251:3.2": "yato ruhiramassave; ",
  "ja251:3.3": "Yāva ayoniso cittaṃ, ",
  "ja251:3.4": "sayaṃ me dukkhamābhatanti. ",
  "ja251:4.1": "Saṅkapparāgajātakaṃ paṭhamaṃ. "
}
