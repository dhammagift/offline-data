  "ja453:0.4": "155. 453. Mahāmaṅgalajātakaṃ (15) ",
  "ja453:1.1": "Kiṃsu naro jappamadhiccakāle, ",
  "ja453:1.2": "kaṃ vā vijjaṃ katamaṃ vā sutānaṃ; ",
  "ja453:1.3": "So macco asmiñca paramhi loke, ",
  "ja453:1.4": "kathaṃ karo sotthānena gutto. ",
  "ja453:2.1": "156. Yassa devā pitaro ca sabbe, ",
  "ja453:2.2": "sarīsapā sabbabhūtāni cāpi; ",
  "ja453:2.3": "Mettāya niccaṃ apacitāni honti, ",
  "ja453:2.4": "bhūtesu ve sotthānaṃ tadāhu. ",
  "ja453:3.1": "157. Yo sabbalokassa nivātavutti, ",
  "ja453:3.2": "itthīpumānaṃ sahadārakānaṃ; ",
  "ja453:3.3": "Khantā duruttānamappaṭikūlavādī, ",
  "ja453:3.4": "adhivāsanaṃ sotthānaṃ tadāhu. ",
  "ja453:4.1": "158. Yo nāvajānāti sahāyamitte , ",
  "ja453:4.2": "sippena kulyāhi dhanena jaccā; ",
  "ja453:4.3": "Rucipañño atthakāle matīmā , ",
  "ja453:4.4": "sahāyesu ve sotthānaṃ tadāhu. ",
  "ja453:5.1": "159. Mittāni ve yassa bhavanti santo, ",
  "ja453:5.2": "saṃvissatthā avisaṃvādakassa; ",
  "ja453:5.3": "Na mittadubbhī saṃvibhāgī dhanena, ",
  "ja453:5.4": "mittesu ve sotthānaṃ tadāhu. ",
  "ja453:6.1": "160. Yassa bhariyā tulyavayā samaggā, ",
  "ja453:6.2": "anubbatā dhammakāmā pajātā ; ",
  "ja453:6.3": "Koliniyā sīlavatī patibbatā, ",
  "ja453:6.4": "dāresu ve sotthānaṃ tadāhu. ",
  "ja453:7.1": "161. Yassa rājā bhūtapati yasassī, ",
  "ja453:7.2": "jānāti soceyyaṃ parakkamañca; ",
  "ja453:7.3": "Advejjhatā suhadayaṃ mamanti, ",
  "ja453:7.4": "rājūsu ve sotthānaṃ tadāhu. ",
  "ja453:8.1": "162. Annañca pānañca dadāti saddho, ",
  "ja453:8.2": "mālañca gandhañca vilepanañca; ",
  "ja453:8.3": "Pasannacitto anumodamāno, ",
  "ja453:8.4": "saggesu ve sotthānaṃ tadāhu. ",
  "ja453:9.1": "163. Yamariyadhammena punanti vuddhā, ",
  "ja453:9.2": "ārādhitā samacariyāya santo; ",
  "ja453:9.3": "Bahussutā isayo sīlavanto, ",
  "ja453:9.4": "arahantamajjhe sotthānaṃ tadāhu. ",
  "ja453:10.1": "164. Etāni kho sotthānāni loke, ",
  "ja453:10.2": "viññuppasatthāni sukhudrayāni ; ",
  "ja453:10.3": "Tānīdha sevetha naro sapañño, ",
  "ja453:10.4": "na hi maṅgale kiñcanamatthi saccanti. ",
  "ja453:11.1": "Mahāmaṅgalajātakaṃ pannarasamaṃ. "
}
