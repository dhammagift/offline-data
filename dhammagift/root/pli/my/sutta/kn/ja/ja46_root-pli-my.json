  "ja46:0.4": "46. 46. Ārāmadūsakajātakaṃ ",
  "ja46:1.1": "Na ve anatthakusalena, ",
  "ja46:1.2": "atthacariyā sukhāvahā; ",
  "ja46:1.3": "Hāpeti atthaṃ dummedho, ",
  "ja46:1.4": "kapi ārāmiko yathāti. ",
  "ja46:2.1": "Ārāmadūsakajātakaṃ chaṭṭhaṃ. "
}
