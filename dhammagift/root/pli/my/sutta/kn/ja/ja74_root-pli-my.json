  "ja74:0.4": "74. Rukkhadhammajātakaṃ 74. ",
  "ja74:1.1": "Sādhū sambahulā ñātī, ",
  "ja74:1.2": "api rukkhā araññajā; ",
  "ja74:1.3": "Vāto vahati ekaṭṭhaṃ, ",
  "ja74:1.4": "brahantampi vanappatinti. ",
  "ja74:2.1": "Rukkhadhammajātakaṃ catutthaṃ. "
}
