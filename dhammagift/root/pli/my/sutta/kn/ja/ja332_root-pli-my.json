  "ja332:0.4": "125. 332. Rathalaṭṭhijātakaṃ (4-4-2) ",
  "ja332:1.1": "Api hantvā hato brūti, ",
  "ja332:1.2": "jetvā jitoti bhāsati; ",
  "ja332:1.3": "Pubbavakkhāyino rāja, ",
  "ja332:1.4": "aññadatthu na saddahe. ",
  "ja332:2.1": "126. Tasmā paṇḍitajātiyo, ",
  "ja332:2.2": "suṇeyya itarassapi; ",
  "ja332:2.3": "Ubhinnaṃ vacanaṃ sutvā, ",
  "ja332:2.4": "yathā dhammo tathā kare. ",
  "ja332:3.1": "127. Alaso gihī kāmabhogī na sādhu, ",
  "ja332:3.2": "asaññato pabbajito na sādhu; ",
  "ja332:3.3": "Rājā na sādhu anisammakārī, ",
  "ja332:3.4": "yo paṇḍito kodhano taṃ na sādhu. ",
  "ja332:4.1": "128. Nisamma khattiyo kayirā, ",
  "ja332:4.2": "nānisamma disampati; ",
  "ja332:4.3": "Nisammakārino rāja , ",
  "ja332:4.4": "yaso kitti ca vaḍḍhatīti. ",
  "ja332:5.1": "Rathalaṭṭhijātakaṃ dutiyaṃ. "
}
