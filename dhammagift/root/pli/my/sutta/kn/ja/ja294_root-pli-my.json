  "ja294:0.3": "",
  "ja294:0.4": "130. 294. Jambukhādakajātakaṃ (3-5-4) ",
  "ja294:1.1": "Koyaṃ bindussaro vaggu, ",
  "ja294:1.2": "saravantāna muttamo; ",
  "ja294:1.3": "Accuto jambusākhāya, ",
  "ja294:1.4": "moracchāpova kūjati. ",
  "ja294:2.1": "131. Kulaputtova jānāti , ",
  "ja294:2.2": "kulaputtaṃ pasaṃsituṃ; ",
  "ja294:2.3": "Byagghacchāpasarīvaṇṇa, ",
  "ja294:2.4": "bhuñja samma dadāmi te. ",
  "ja294:3.1": "132. Cirassaṃ vata passāmi, ",
  "ja294:3.2": "musāvādī samāgate; ",
  "ja294:3.3": "Vantādaṃ kuṇapādañca, ",
  "ja294:3.4": "aññamaññaṃ pasaṃsaketi. ",
  "ja294:4.1": "Jambukhādakajātakaṃ catutthaṃ. "
}
