  "ja146:0.4": "146. Samuddakākajātakaṃ 146. ",
  "ja146:1.1": "Api nu hanukā santā, ",
  "ja146:1.2": "mukhañca parisussati; ",
  "ja146:1.3": "Oramāma na pārema, ",
  "ja146:1.4": "pūrateva mahodadhīti. ",
  "ja146:2.1": "Samuddakākajātakaṃ chaṭṭhaṃ. "
}
