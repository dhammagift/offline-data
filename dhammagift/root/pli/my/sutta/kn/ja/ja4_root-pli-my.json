  "ja4:0.4": "4. 4. Cūḷaseṭṭhijātakaṃ ",
  "ja4:1.1": "Appakenapi medhāvī, ",
  "ja4:1.2": "pābhatena vicakkhaṇo; ",
  "ja4:1.3": "Samuṭṭhāpeti attānaṃ, ",
  "ja4:1.4": "aṇuṃ aggiṃva sandhamanti. ",
  "ja4:2.1": "Cūḷa seṭṭhijātakaṃ catutthaṃ. "
}
