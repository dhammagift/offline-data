  "ja72:0.4": "72. Sīlavahatthijātakaṃ 72. ",
  "ja72:1.1": "Akataññussa posassa, ",
  "ja72:1.2": "niccaṃ vivaradassino; ",
  "ja72:1.3": "Sabbaṃ ce pathaviṃ dajjā, ",
  "ja72:1.4": "neva naṃ abhirādhayeti. ",
  "ja72:2.1": "Sīlavahatthijātakaṃ dutiyaṃ. "
}
