  "ja225:0.4": "149. 225. Khantivaṇṇajātakaṃ (2-8-5) ",
  "ja225:1.1": "Atthi me puriso deva, ",
  "ja225:1.2": "sabbakiccesu byāvaṭo ; ",
  "ja225:1.3": "Tassa cekoparādhatthi, ",
  "ja225:1.4": "tattha tvaṃ kinti maññasi. ",
  "ja225:2.1": "150. Amhākampatthi puriso, ",
  "ja225:2.2": "ediso idha vijjati; ",
  "ja225:2.3": "Dullabho aṅgasampanno, ",
  "ja225:2.4": "khantirasmāka ruccatīti. ",
  "ja225:3.1": "Khantivaṇṇajātakaṃ pañcamaṃ. "
}
