  "ja375:0.4": "135. 375. Kapotajātakaṃ (5-3-5) ",
  "ja375:1.1": "Idāni khomhi sukhito arogo, ",
  "ja375:1.2": "nikkaṇṭako nippatito kapoto; ",
  "ja375:1.3": "Kāhāmi dānī hadayassa tuṭṭhiṃ, ",
  "ja375:1.4": "tathāhimaṃ maṃsasākaṃ baleti. ",
  "ja375:2.1": "136. Kāyaṃ balākā sikhino, ",
  "ja375:2.2": "corī laṅghipitāmahā; ",
  "ja375:2.3": "Oraṃ balāke āgaccha, ",
  "ja375:2.4": "caṇḍo me vāyaso sakhā. ",
  "ja375:3.1": "137. Alañhi te jagghitāye, ",
  "ja375:3.2": "mamaṃ disvāna edisaṃ; ",
  "ja375:3.3": "Vilūnaṃ sūdaputtena, ",
  "ja375:3.4": "piṭṭhamaṇḍena makkhitaṃ. ",
  "ja375:4.1": "138. Sunhāto suvilittosi, ",
  "ja375:4.2": "annapānena tappito; ",
  "ja375:4.3": "Kaṇṭhe ca te veḷuriyo, ",
  "ja375:4.4": "agamā nu kajaṅgalaṃ. ",
  "ja375:5.1": "139. Mā te mitto amitto vā, ",
  "ja375:5.2": "agamāsi kajaṅgalaṃ; ",
  "ja375:5.3": "Piñchāni tattha lāyitvā, ",
  "ja375:5.4": "kaṇṭhe bandhanti vaṭṭanaṃ. ",
  "ja375:6.1": "140. Punapāpajjasī samma, ",
  "ja375:6.2": "sīlañhi tava tādisaṃ; ",
  "ja375:6.3": "Na hi mānusakā bhogā, ",
  "ja375:6.4": "subhuñjā honti pakkhināti. ",
  "ja375:7.1": "Kapotajātakaṃ pañcamaṃ. ",
  "ja375:7.2": "Aḍḍhavaggo tatiyo. ",
  "ja375:8.1": "Tassuddānaṃ – ",
  "ja375:9.1": "Atha vaṇṇa sasīla hiri labhate, ",
  "ja375:9.2": "sumukhā visa sāḷiyamittavaro; ",
  "ja375:9.3": "Atha cakka palāsa sarāja sato, ",
  "ja375:9.4": "yava bāla kapotaka pannarasāti. ",
  "ja375:10.1": "Atha vagguddānaṃ – ",
  "ja375:11.1": "Jīnañca vaṇṇaṃ asamaṃvaguppari, ",
  "ja375:11.2": "sudesitā jātakanti santi vīsati ; ",
  "ja375:11.3": "Mahesino brahmacarittamutta- ",
  "ja375:11.4": "mavoca gāthā atthavatī subyañjanāti. ",
  "ja375:12.1": "Pañcakanipātaṃ niṭṭhitaṃ. "
}
