  "ja349:0.4": "193. 349. Sandhibhedajātakaṃ (4-5-9) ",
  "ja349:1.1": "Neva itthīsu sāmaññaṃ, ",
  "ja349:1.2": "nāpi bhakkhesu sārathi; ",
  "ja349:1.3": "Athassa sandhibhedassa, ",
  "ja349:1.4": "passa yāva sucintitaṃ. ",
  "ja349:2.1": "194. Asi tikkhova maṃsamhi, ",
  "ja349:2.2": "pesuññaṃ parivattati; ",
  "ja349:2.3": "Yatthūsabhañca sīhañca, ",
  "ja349:2.4": "bhakkhayanti migādhamā. ",
  "ja349:3.1": "195. Imaṃ so sayanaṃ seti, ",
  "ja349:3.2": "yamimaṃ passasi sārathi; ",
  "ja349:3.3": "Yo vācaṃ sandhibhedassa, ",
  "ja349:3.4": "pisuṇassa nibodhati. ",
  "ja349:4.1": "196. Te janā sukhamedhanti, ",
  "ja349:4.2": "narā saggagatāriva; ",
  "ja349:4.3": "Ye vācaṃ sandhibhedassa, ",
  "ja349:4.4": "nāvabodhanti sārathīti. ",
  "ja349:5.1": "Sandhibhedajātakaṃ navamaṃ. "
}
