  "ja256:0.4": "16. 256. Jarūdapānajātakaṃ (3-1-6) ",
  "ja256:1.1": "Jarūdapānaṃ khaṇamānā, ",
  "ja256:1.2": "vāṇijā udakatthikā; ",
  "ja256:1.3": "Ajjhagamuṃ ayasaṃ lohaṃ , ",
  "ja256:1.4": "tipusīsañca vāṇijā; ",
  "ja256:1.5": "Rajataṃ jātarūpañca, ",
  "ja256:1.6": "muttā veḷūriyā bahū. ",
  "ja256:2.1": "17. Te ca tena asantuṭṭhā, ",
  "ja256:2.2": "bhiyyo bhiyyo akhāṇisuṃ; ",
  "ja256:2.3": "Te tatthāsīviso ghoro, ",
  "ja256:2.4": "tejassī tejasā hani. ",
  "ja256:3.1": "18. Tasmā khaṇe nātikhaṇe, ",
  "ja256:3.2": "atikhātaṃ hi pāpakaṃ; ",
  "ja256:3.3": "Khātena ca dhanaṃ laddhaṃ, ",
  "ja256:3.4": "atikhātena nāsitanti. ",
  "ja256:4.1": "Jarūdapānajātakaṃ chaṭṭhaṃ. "
}
