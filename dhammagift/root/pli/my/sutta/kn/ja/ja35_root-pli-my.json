  "ja35:0.4": "35. Vaṭṭakajātakaṃ 35. ",
  "ja35:1.1": "Santi pakkhā apatanā, ",
  "ja35:1.2": "santi pādā avañcanā; ",
  "ja35:1.3": "Mātāpitā ca nikkhantā, ",
  "ja35:1.4": "jātaveda paṭikkamāti. ",
  "ja35:2.1": "Vaṭṭakajātakaṃ pañcamaṃ. "
}
