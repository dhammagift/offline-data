  "ja104:0.4": "104. Mittavindakajātakaṃ 104. ",
  "ja104:1.1": "Catubbhi aṭṭhajjhagamā, ",
  "ja104:1.2": "aṭṭhāhipi ca soḷasa; ",
  "ja104:1.3": "Soḷasāhi ca bāttiṃsa , ",
  "ja104:1.4": "atricchaṃ cakkamāsado; ",
  "ja104:1.5": "Icchāhatassa posassa, ",
  "ja104:1.6": "cakkaṃ bhamati matthaketi. ",
  "ja104:2.1": "Mittavindakajātakaṃ catutthaṃ. "
}
