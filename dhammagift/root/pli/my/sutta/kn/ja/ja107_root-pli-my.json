  "ja107:0.4": "107. 107. Sālittakajātakaṃ ",
  "ja107:1.1": "Sādhu kho sippakaṃ nāma, ",
  "ja107:1.2": "api yādisa kīdisaṃ; ",
  "ja107:1.3": "Passa khañjappahārena, ",
  "ja107:1.4": "laddhā gāmā catuddisāti. ",
  "ja107:2.1": "Sālittakajātakaṃ sattamaṃ. "
}
