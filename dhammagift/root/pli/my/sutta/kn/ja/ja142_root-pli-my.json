  "ja142:0.4": "142. Siṅgālajātakaṃ 142. ",
  "ja142:1.1": "Etañhi te durājānaṃ, ",
  "ja142:1.2": "yaṃ sesi matasāyikaṃ; ",
  "ja142:1.3": "Yassa te kaḍḍhamānassa, ",
  "ja142:1.4": "hatthā daṇḍo na muccatīti. ",
  "ja142:2.1": "Siṅgālajātakaṃ dutiyaṃ. "
}
