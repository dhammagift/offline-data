  "ja262:0.4": "34. 262. Mudupāṇijātakaṃ (3-2-2) ",
  "ja262:1.1": "Pāṇi ce muduko cassa, ",
  "ja262:1.2": "nāgo cassa sukārito; ",
  "ja262:1.3": "Andhakāro ca vasseyya, ",
  "ja262:1.4": "atha nūna tadā siyā. ",
  "ja262:2.1": "35. Analā mudusambhāsā, ",
  "ja262:2.2": "duppūrā tā nadīsamā; ",
  "ja262:2.3": "Sīdanti naṃ viditvāna, ",
  "ja262:2.4": "ārakā parivajjaye. ",
  "ja262:3.1": "36. Yaṃ etā upasevanti, ",
  "ja262:3.2": "chandasā vā dhanena vā; ",
  "ja262:3.3": "Jātavedova saṃ ṭhānaṃ, ",
  "ja262:3.4": "khippaṃ anudahanti nanti. ",
  "ja262:4.1": "Mudupāṇijātakaṃ dutiyaṃ. "
}
