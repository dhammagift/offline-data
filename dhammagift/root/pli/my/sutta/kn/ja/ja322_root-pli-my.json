  "ja322:0.4": "322. Duddubhajātakaṃ (4-3-2) 85. ",
  "ja322:1.1": "Duddubhāyati bhaddante, ",
  "ja322:1.2": "yasmiṃ dese vasāmahaṃ; ",
  "ja322:1.3": "Ahampetaṃ na jānāmi, ",
  "ja322:1.4": "kimetaṃ duddubhāyati. ",
  "ja322:2.1": "86. Beluvaṃ patitaṃ sutvā, ",
  "ja322:2.2": "duddubhanti saso javi; ",
  "ja322:2.3": "Sasassa vacanaṃ sutvā, ",
  "ja322:2.4": "santattā migavāhinī. ",
  "ja322:3.1": "87. Appatvā padaviññāṇaṃ, ",
  "ja322:3.2": "paraghosānusārino; ",
  "ja322:3.3": "Panādaparamā bālā, ",
  "ja322:3.4": "te honti parapattiyā. ",
  "ja322:4.1": "88. Ye ca sīlena sampannā, ",
  "ja322:4.2": "paññāyūpasame ratā; ",
  "ja322:4.3": "Ārakā viratā dhīrā, ",
  "ja322:4.4": "na honti parapattiyāti. ",
  "ja322:5.1": "Duddubhajātakaṃ dutiyaṃ. "
}
