  "ja216:0.4": "131. 216. Macchajātakaṃ (2-7-6) ",
  "ja216:1.1": "Na māyamaggi tapati, ",
  "ja216:1.2": "na sūlo sādhutacchito; ",
  "ja216:1.3": "Yañca maṃ maññate macchī, ",
  "ja216:1.4": "aññaṃ so ratiyā gato. ",
  "ja216:2.1": "132. So maṃ dahati rāgaggi, ",
  "ja216:2.2": "cittaṃ cūpatapeti maṃ; ",
  "ja216:2.3": "Jālino muñcathāyirā maṃ, ",
  "ja216:2.4": "na kāme haññate kvacīti. ",
  "ja216:3.1": "Macchajātakaṃ chaṭṭhaṃ. "
}
