  "ja343:0.4": "169. 343. Kuntinījātakaṃ (4-5-3) ",
  "ja343:1.1": "Avasimha tavāgāre, ",
  "ja343:1.2": "niccaṃ sakkatapūjitā; ",
  "ja343:1.3": "Tvameva dānimakari, ",
  "ja343:1.4": "handa rāja vajāmahaṃ. ",
  "ja343:2.1": "170. Yo ve kate paṭikate, ",
  "ja343:2.2": "kibbise paṭikibbise; ",
  "ja343:2.3": "Evaṃ taṃ sammatī veraṃ, ",
  "ja343:2.4": "vasa kuntini māgamā. ",
  "ja343:3.1": "171. Na katassa ca kattā ca, ",
  "ja343:3.2": "metti sandhīyate puna; ",
  "ja343:3.3": "Hadayaṃ nānujānāti, ",
  "ja343:3.4": "gacchaññeva rathesabha. ",
  "ja343:4.1": "172. Katassa ceva kattā ca, ",
  "ja343:4.2": "metti sandhīyate puna; ",
  "ja343:4.3": "Dhīrānaṃ no ca bālānaṃ, ",
  "ja343:4.4": "vasa kuntini māgamāti. ",
  "ja343:5.1": "Kuntinījātakaṃ tatiyaṃ. "
}
