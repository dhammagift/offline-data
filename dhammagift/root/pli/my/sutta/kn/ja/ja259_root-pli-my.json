  "ja259:0.4": "25. 259. Tirīṭavacchajātakaṃ (3-1-9) ",
  "ja259:1.1": "Nayimassa vijjāmayamatthi kiñci, ",
  "ja259:1.2": "na bandhavo no pana te sahāyo; ",
  "ja259:1.3": "Atha kena vaṇṇena tirīṭavaccho , ",
  "ja259:1.4": "tedaṇḍiko bhuñjati aggapiṇḍaṃ. ",
  "ja259:2.1": "26. Āpāsu me yuddhaparājitassa, ",
  "ja259:2.2": "ekassa katvā vivanasmi ghore; ",
  "ja259:2.3": "Pasārayī kicchagatassa pāṇiṃ, ",
  "ja259:2.4": "tenūdatāriṃ dukhasaṃpareto. ",
  "ja259:3.1": "27. Etassa kiccena idhānupatto, ",
  "ja259:3.2": "vesāyino visayā jīvaloke; ",
  "ja259:3.3": "Lābhāraho tāta tirīṭavaccho, ",
  "ja259:3.4": "dethassa bhogaṃ yajathañca yaññanti. ",
  "ja259:4.1": "Tirīṭavacchajātakaṃ navamaṃ. "
}
