  "ja145:0.4": "145. 145. Rādhajātakaṃ ",
  "ja145:1.1": "Na tvaṃ rādha vijānāsi, ",
  "ja145:1.2": "aḍḍharatte anāgate; ",
  "ja145:1.3": "Abyayataṃ vilapasi, ",
  "ja145:1.4": "virattā kosiyāyaneti. ",
  "ja145:2.1": "Rādhajātakaṃ pañcamaṃ. "
}
