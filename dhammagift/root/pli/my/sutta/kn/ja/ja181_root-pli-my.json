  "ja181:0.1": "",
  "ja181:0.2": "",
  "ja181:0.3": "4. Asadisavaggo ",
  "ja181:0.4": "61. 181. Asadisajātakaṃ (2-4-1) ",
  "ja181:1.1": "Dhanuggaho asadiso, ",
  "ja181:1.2": "rājaputto mahabbalo; ",
  "ja181:1.3": "Dūrepātī akkhaṇavedhī, ",
  "ja181:1.4": "mahākāyappadālano. ",
  "ja181:2.1": "62. Sabbāmitte raṇaṃ katvā, ",
  "ja181:2.2": "na ca kañci viheṭhayi; ",
  "ja181:2.3": "Bhātaraṃ sotthiṃ katvāna, ",
  "ja181:2.4": "saṃyamaṃ ajjhupāgamīti. ",
  "ja181:3.1": "Asadisajātakaṃ paṭhamaṃ. "
}
