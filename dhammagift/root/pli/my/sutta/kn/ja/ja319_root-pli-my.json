  "ja319:0.3": "",
  "ja319:0.4": "319. Tittirajātakaṃ (4-2-9) 73. ",
  "ja319:1.1": "Susukhaṃ vata jīvāmi, ",
  "ja319:1.2": "labhāmi ceva bhuñjituṃ; ",
  "ja319:1.3": "Paripantheva tiṭṭhāmi, ",
  "ja319:1.4": "kā nu bhante gatī mama. ",
  "ja319:2.1": "74. Mano ce te nappaṇamati, ",
  "ja319:2.2": "pakkhi pāpassa kammuno; ",
  "ja319:2.3": "Abyāvaṭassa bhadrassa, ",
  "ja319:2.4": "na pāpamupalimpati. ",
  "ja319:3.1": "75. Ñātako no nisinnoti, ",
  "ja319:3.2": "bahu āgacchate jano; ",
  "ja319:3.3": "Paṭicca kammaṃ phusati, ",
  "ja319:3.4": "tasmiṃ me saṅkate mano. ",
  "ja319:4.1": "76. Na paṭicca kammaṃ phusati, ",
  "ja319:4.2": "mano ce nappadussati; ",
  "ja319:4.3": "Appossukkassa bhadrassa, ",
  "ja319:4.4": "na pāpamupalimpatīti. ",
  "ja319:5.1": "Tittirajātakaṃ navamaṃ. "
}
