  "ja207:0.4": "113. 207. Assakajātakaṃ (2-6-7) ",
  "ja207:1.1": "Ayamassakarājena, ",
  "ja207:1.2": "deso vicarito mayā; ",
  "ja207:1.3": "Anukāmaya kāmena , ",
  "ja207:1.4": "piyena patinā saha. ",
  "ja207:2.1": "114. Navena sukhadukkhena, ",
  "ja207:2.2": "porāṇaṃ apidhīyati ; ",
  "ja207:2.3": "Tasmā assakaraññāva, ",
  "ja207:2.4": "kīṭo piyataro mamāti. ",
  "ja207:3.1": "Assakajātakaṃ sattamaṃ. "
}
