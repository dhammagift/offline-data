  "ja174:0.4": "47. 174. Dubbhiyamakkaṭajātakaṃ (2-3-4) ",
  "ja174:1.1": "Adamha te vāri pahūtarūpaṃ, ",
  "ja174:1.2": "ghammābhitattassa pipāsitassa; ",
  "ja174:1.3": "So dāni pitvāna kiriṅkarosi , ",
  "ja174:1.4": "asaṅgamo pāpajanena seyyo. ",
  "ja174:2.1": "48. Ko te suto vā diṭṭho vā, ",
  "ja174:2.2": "sīlavā nāma makkaṭo; ",
  "ja174:2.3": "Idāni kho taṃ ohacchaṃ , ",
  "ja174:2.4": "esā asmāka dhammatāti. ",
  "ja174:3.1": "Dubbhiyamakkaṭajātakaṃ catutthaṃ. "
}
