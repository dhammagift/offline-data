  "ja48:0.4": "48. 48. Vedabbajātakaṃ ",
  "ja48:1.1": "Anupāyena yo atthaṃ, ",
  "ja48:1.2": "icchati so vihaññati; ",
  "ja48:1.3": "Cetā haniṃsu vedabbaṃ , ",
  "ja48:1.4": "sabbe te byasanamajjhagūti. ",
  "ja48:2.1": "Vedabba jātakaṃ aṭṭhamaṃ. "
}
