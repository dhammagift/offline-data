  "ja138:0.4": "138. Godhajātakaṃ 138. ",
  "ja138:1.1": "Kiṃ te jaṭāhi dummedha, ",
  "ja138:1.2": "kiṃ te ajinasāṭiyā; ",
  "ja138:1.3": "Abbhantaraṃ te gahanaṃ, ",
  "ja138:1.4": "bāhiraṃ parimajjasīti. ",
  "ja138:2.1": "Godhajātakaṃ aṭṭhamaṃ. "
}
