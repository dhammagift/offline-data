  "ja68:0.4": "68. 68. Sāketajātakaṃ ",
  "ja68:1.1": "Yasmiṃ mano nivisati, ",
  "ja68:1.2": "cittañcāpi pasīdati; ",
  "ja68:1.3": "Adiṭṭhapubbake pose, ",
  "ja68:1.4": "kāmaṃ tasmimpi vissaseti. ",
  "ja68:2.1": "Sāketajātakaṃ aṭṭhamaṃ. "
}
