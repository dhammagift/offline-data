  "ja232:0.4": "163. 232. Vīṇāguṇajātakaṃ (2-9-2) ",
  "ja232:1.1": "Ekacintito yamattho, ",
  "ja232:1.2": "bālo apariṇāyako; ",
  "ja232:1.3": "Na hi khujjena vāmena, ",
  "ja232:1.4": "bhoti saṅgantumarahasi. ",
  "ja232:2.1": "164. Purisūsabhaṃ maññamānā, ",
  "ja232:2.2": "ahaṃ khujjamakāmayiṃ; ",
  "ja232:2.3": "Soyaṃ saṃkuṭito seti, ",
  "ja232:2.4": "chinnatanti yathā viṇāti . ",
  "ja232:3.1": "Vīṇāguṇajātakaṃ dutiyaṃ. "
}
