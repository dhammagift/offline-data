  "ja398:0.4": "15. 398. Sutanujātakaṃ (7-1-3) ",
  "ja398:1.1": "Rājā te bhattaṃ pāhesi, ",
  "ja398:1.2": "suciṃ maṃsūpasecanaṃ; ",
  "ja398:1.3": "Maghadevasmiṃ adhivatthe, ",
  "ja398:1.4": "ehi nikkhamma bhuñjassu. ",
  "ja398:2.1": "16. Ehi māṇava orena, ",
  "ja398:2.2": "bhikkhamādāya sūpitaṃ; ",
  "ja398:2.3": "Tvañca māṇava bhikkhā ca , ",
  "ja398:2.4": "ubho bhakkhā bhavissatha. ",
  "ja398:3.1": "17. Appakena tuvaṃ yakkha, ",
  "ja398:3.2": "thullamatthaṃ jahissasi; ",
  "ja398:3.3": "Bhikkhaṃ te nāharissanti, ",
  "ja398:3.4": "janā maraṇasaññino. ",
  "ja398:4.1": "18. Laddhāya yakkhā tava niccabhikkhaṃ, ",
  "ja398:4.2": "suciṃ paṇītaṃ rasasā upetaṃ; ",
  "ja398:4.3": "Bhikkhañca te āhariyo naro idha, ",
  "ja398:4.4": "sudullabho hehiti bhakkhite mayi. ",
  "ja398:5.1": "19. Mameva sutano attho, ",
  "ja398:5.2": "yathā bhāsasi māṇava; ",
  "ja398:5.3": "Mayā tvaṃ samanuññāto, ",
  "ja398:5.4": "sotthiṃ passāhi mātaraṃ. ",
  "ja398:6.1": "20. Khaggaṃ chattañca pātiñca, ",
  "ja398:6.2": "gacchamādāya māṇava; ",
  "ja398:6.3": "Sotthiṃ passatu te mātā, ",
  "ja398:6.4": "tvañca passāhi mātaraṃ. ",
  "ja398:7.1": "21. Evaṃ yakkha sukhī hohi, ",
  "ja398:7.2": "saha sabbehi ñātibhi; ",
  "ja398:7.3": "Dhanañca me adhigataṃ, ",
  "ja398:7.4": "rañño ca vacanaṃ katanti. ",
  "ja398:8.1": "Sutanujātakaṃ tatiyaṃ. "
}
