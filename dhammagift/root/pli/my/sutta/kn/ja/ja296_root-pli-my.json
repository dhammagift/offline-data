  "ja296:0.4": "136. 296. Samuddajātakaṃ (3-5-6) ",
  "ja296:1.1": "Ko nāyaṃ loṇatoyasmiṃ, ",
  "ja296:1.2": "samantā paridhāvati; ",
  "ja296:1.3": "Macche makare ca vāreti, ",
  "ja296:1.4": "ūmīsu ca vihaññati. ",
  "ja296:2.1": "137. Anantapāyī sakuṇo, ",
  "ja296:2.2": "atittoti disāsuto; ",
  "ja296:2.3": "Samuddaṃ pātumicchāmi, ",
  "ja296:2.4": "sāgaraṃ saritaṃ patiṃ. ",
  "ja296:3.1": "138. So ayaṃ hāyati ceva, ",
  "ja296:3.2": "pūrate ca mahodadhi; ",
  "ja296:3.3": "Nāssa nāyati pītanto, ",
  "ja296:3.4": "apeyyo kira sāgaroti. ",
  "ja296:4.1": "Samuddajātakaṃ chaṭṭhaṃ. "
}
