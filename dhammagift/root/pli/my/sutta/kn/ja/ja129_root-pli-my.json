  "ja129:0.4": "129. Aggikabhāradvājajātakaṃ 129. ",
  "ja129:1.1": "Nāyaṃ sikhā puññahetu, ",
  "ja129:1.2": "ghāsahetu ayaṃ sikhā; ",
  "ja129:1.3": "Nāṅguṭṭhagaṇanaṃ yāti, ",
  "ja129:1.4": "alaṃ te hotu aggikāti. ",
  "ja129:2.1": "Aggikabhāradvājajātakaṃ navamaṃ. "
}
