  "ja187:0.4": "73. 187. Catumaṭṭhajātakaṃ (2-4-7) ",
  "ja187:1.1": "Ucce viṭabhimāruyha, ",
  "ja187:1.2": "mantayavho rahogatā; ",
  "ja187:1.3": "Nīce oruyha mantavho, ",
  "ja187:1.4": "migarājāpi sossati. ",
  "ja187:2.1": "74. Yaṃ suvaṇṇo suvaṇṇena , ",
  "ja187:2.2": "devo devena mantaye; ",
  "ja187:2.3": "Kiṃ tettha catumaṭṭhassa, ",
  "ja187:2.4": "bilaṃ pavisa jambukāti. ",
  "ja187:3.1": "Catumaṭṭhajātakaṃ sattamaṃ. "
}
