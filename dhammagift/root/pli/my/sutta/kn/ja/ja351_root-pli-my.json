{
  "ja351:0.1": "5. Pañcakanipāto ",
  "ja351:0.2": "",
  "ja351:0.3": "1. Maṇikuṇḍalavaggo ",
  "ja351:0.4": "1. 351. Maṇikuṇḍalajātakaṃ (5-1-1) ",
  "ja351:1.1": "Jīno rathassaṃ maṇikuṇḍale ca, ",
  "ja351:1.2": "putte ca dāre ca tatheva jīno; ",
  "ja351:1.3": "Sabbesu bhogesu asesakesu , ",
  "ja351:1.4": "kasmā na santappasi sokakāle. ",
  "ja351:2.1": "2. Pubbeva maccaṃ vijahanti bhogā, ",
  "ja351:2.2": "macco vā te pubbataraṃ jahāti; ",
  "ja351:2.3": "Asassatā bhogino kāmakāmi, ",
  "ja351:2.4": "tasmā na socāmahaṃ sokakāle. ",
  "ja351:3.1": "3. Udeti āpūrati veti cando, ",
  "ja351:3.2": "atthaṃ tapetvāna paleti sūriyo; ",
  "ja351:3.3": "Viditā mayā sattuka lokadhammā, ",
  "ja351:3.4": "tasmā na socāmahaṃ sokakāle. ",
  "ja351:4.1": "4. Alaso gihī kāmabhogī na sādhu, ",
  "ja351:4.2": "asaññato pabbajito na sādhu; ",
  "ja351:4.3": "Rājā na sādhu anisammakārī, ",
  "ja351:4.4": "yo paṇḍito kodhano taṃ na sādhu. ",
  "ja351:5.1": "5. Nisamma khattiyo kayirā, ",
  "ja351:5.2": "nānisamma disampati; ",
  "ja351:5.3": "Nisammakārino rāja , ",
  "ja351:5.4": "yaso kitti ca vaḍḍhatīti. ",
  "ja351:6.1": "Maṇikuṇḍalajātakaṃ paṭhamaṃ. "
}
