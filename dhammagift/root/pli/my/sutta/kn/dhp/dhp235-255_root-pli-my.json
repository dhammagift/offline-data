  "dhp235:0.1": "",
  "dhp235:0.2": "",
  "dhp235:0.3": "18. Malavaggo ",
  "dhp235:0.4": "235. ",
  "dhp235:1": "Paṇḍupalāsova dānisi, ",
  "dhp235:2": "yamapurisāpi ca te upaṭṭhitā; ",
  "dhp235:3": "Uyyogamukhe ca tiṭṭhasi, ",
  "dhp235:4": "pātheyyampi ca te na vijjati. ",
  "dhp236:1": "236. So karohi dīpamattano, ",
  "dhp236:2": "khippaṃ vāyama paṇḍito bhava; ",
  "dhp236:3": "Niddhantamalo anaṅgaṇo, ",
  "dhp236:4": "dibbaṃ ariyabhūmiṃ upehisi . ",
  "dhp237:1": "237. Upanītavayo ca dānisi, ",
  "dhp237:2": "sampayātosi yamassa santike; ",
  "dhp237:3": "Vāso te natthi antarā, ",
  "dhp237:4": "pātheyyampi ca te na vijjati. ",
  "dhp238:1": "238. So karohi dīpamattano, ",
  "dhp238:2": "khippaṃ vāyama paṇḍito bhava; ",
  "dhp238:3": "Niddhantamalo anaṅgaṇo, ",
  "dhp238:4": "na punaṃ jātijaraṃ upehisi. ",
  "dhp239:0": "",
  "dhp239:1": "239. Anupubbena medhāvī, ",
  "dhp239:2": "thokaṃ thokaṃ khaṇe khaṇe; ",
  "dhp239:3": "Kammāro rajatasseva, ",
  "dhp239:4": "niddhame malamattano. ",
  "dhp240:0": "",
  "dhp240:1": "240. Ayasāva malaṃ samuṭṭhitaṃ , ",
  "dhp240:2": "tatuṭṭhāya tameva khādati; ",
  "dhp240:3": "Evaṃ atidhonacārinaṃ, ",
  "dhp240:4": "sāni kammāni nayanti duggatiṃ. ",
  "dhp241:0": "",
  "dhp241:1": "241. Asajjhāyamalā mantā, ",
  "dhp241:2": "anuṭṭhānamalā gharā; ",
  "dhp241:3": "Malaṃ vaṇṇassa kosajjaṃ, ",
  "dhp241:4": "pamādo rakkhato malaṃ. ",
  "dhp242:0": "",
  "dhp242:1": "242. Malitthiyā duccaritaṃ, ",
  "dhp242:2": "maccheraṃ dadato malaṃ; ",
  "dhp242:3": "Malā ve pāpakā dhammā, ",
  "dhp242:4": "asmiṃ loke paramhi ca. ",
  "dhp243:1": "243. Tato malā malataraṃ, ",
  "dhp243:2": "avijjā paramaṃ malaṃ; ",
  "dhp243:3": "Etaṃ malaṃ pahantvāna, ",
  "dhp243:4": "nimmalā hotha bhikkhavo. ",
  "dhp244:0": "",
  "dhp244:1": "244. Sujīvaṃ ahirikena, ",
  "dhp244:2": "kākasūrena dhaṃsinā; ",
  "dhp244:3": "Pakkhandinā pagabbhena, ",
  "dhp244:4": "saṃkiliṭṭhena jīvitaṃ. ",
  "dhp245:1": "245. Hirīmatā ca dujjīvaṃ, ",
  "dhp245:2": "niccaṃ sucigavesinā; ",
  "dhp245:3": "Alīnenāppagabbhena, ",
  "dhp245:4": "suddhājīvena passatā. ",
  "dhp246:0": "",
  "dhp246:1": "246. Yo pāṇamatipāteti, ",
  "dhp246:2": "musāvādañca bhāsati; ",
  "dhp246:3": "Loke adinnamādiyati, ",
  "dhp246:4": "paradārañca gacchati. ",
  "dhp247:1": "247. Surāmerayapānañca, ",
  "dhp247:2": "yo naro anuyuñjati; ",
  "dhp247:3": "Idhevameso lokasmiṃ, ",
  "dhp247:4": "mūlaṃ khaṇati attano. ",
  "dhp248:1": "248. Evaṃ bho purisa jānāhi, ",
  "dhp248:2": "pāpadhammā asaññatā; ",
  "dhp248:3": "Mā taṃ lobho adhammo ca, ",
  "dhp248:4": "ciraṃ dukkhāya randhayuṃ. ",
  "dhp249:0": "",
  "dhp249:1": "249. Dadāti ve yathāsaddhaṃ, ",
  "dhp249:2": "yathāpasādanaṃ jano; ",
  "dhp249:3": "Tattha yo maṅku bhavati , ",
  "dhp249:4": "paresaṃ pānabhojane; ",
  "dhp249:5": "Na so divā vā rattiṃ vā, ",
  "dhp249:6": "samādhimadhigacchati. ",
  "dhp250:1": "250. Yassa cetaṃ samucchinnaṃ, ",
  "dhp250:2": "mūlaghaccaṃ samūhataṃ; ",
  "dhp250:3": "Sa ve divā vā rattiṃ vā, ",
  "dhp250:4": "samādhimadhigacchati. ",
  "dhp251:0": "",
  "dhp251:1": "251. Natthi rāgasamo aggi, ",
  "dhp251:2": "natthi dosasamo gaho; ",
  "dhp251:3": "Natthi mohasamaṃ jālaṃ, ",
  "dhp251:4": "natthi taṇhāsamā nadī. ",
  "dhp252:0": "",
  "dhp252:1": "252. Sudassaṃ vajjamaññesaṃ, ",
  "dhp252:2": "attano pana duddasaṃ; ",
  "dhp252:3": "Paresaṃ hi so vajjāni, ",
  "dhp252:4": "opunāti yathā bhusaṃ; ",
  "dhp252:5": "Attano pana chādeti, ",
  "dhp252:6": "kaliṃva kitavā saṭho. ",
  "dhp253:0": "",
  "dhp253:1": "253. Paravajjānupassissa, ",
  "dhp253:2": "niccaṃ ujjhānasaññino; ",
  "dhp253:3": "Āsavā tassa vaḍḍhanti, ",
  "dhp253:4": "ārā so āsavakkhayā. ",
  "dhp254:0": "",
  "dhp254:1": "254. Ākāseva padaṃ natthi, ",
  "dhp254:2": "samaṇo natthi bāhire; ",
  "dhp254:3": "Papañcābhiratā pajā, ",
  "dhp254:4": "nippapañcā tathāgatā. ",
  "dhp255:1": "255. Ākāseva padaṃ natthi, ",
  "dhp255:2": "samaṇo natthi bāhire; ",
  "dhp255:3": "Saṅkhārā sassatā natthi, ",
  "dhp255:4": "natthi buddhānamiñjitaṃ. ",
  "dhp255:5": "Malavaggo aṭṭhārasamo niṭṭhito. "
}
