  "dhp129:0.1": "",
  "dhp129:0.2": "",
  "dhp129:0.3": "10. Daṇḍavaggo ",
  "dhp129:0.4": "129. ",
  "dhp129:1": "Sabbe tasanti daṇḍassa, ",
  "dhp129:2": "sabbe bhāyanti maccuno; ",
  "dhp129:3": "Attānaṃ upamaṃ katvā, ",
  "dhp129:4": "na haneyya na ghātaye. ",
  "dhp130:0": "",
  "dhp130:1": "130. Sabbe tasanti daṇḍassa, ",
  "dhp130:2": "sabbesaṃ jīvitaṃ piyaṃ; ",
  "dhp130:3": "Attānaṃ upamaṃ katvā, ",
  "dhp130:4": "na haneyya na ghātaye. ",
  "dhp131:0": "",
  "dhp131:1": "131. Sukhakāmāni bhūtāni, ",
  "dhp131:2": "yo daṇḍena vihiṃsati; ",
  "dhp131:3": "Attano sukhamesāno, ",
  "dhp131:4": "pecca so na labhate sukhaṃ. ",
  "dhp132:1": "132. Sukhakāmāni bhūtāni, ",
  "dhp132:2": "yo daṇḍena na hiṃsati; ",
  "dhp132:3": "Attano sukhamesāno, ",
  "dhp132:4": "pecca so labhate sukhaṃ. ",
  "dhp133:0": "",
  "dhp133:1": "133. Māvoca pharusaṃ kañci, ",
  "dhp133:2": "vuttā paṭivadeyyu taṃ ; ",
  "dhp133:3": "Dukkhā hi sārambhakathā, ",
  "dhp133:4": "paṭidaṇḍā phuseyyu taṃ . ",
  "dhp134:1": "134. Sace neresi attānaṃ, ",
  "dhp134:2": "kaṃso upahato yathā; ",
  "dhp134:3": "Esa pattosi nibbānaṃ, ",
  "dhp134:4": "sārambho te na vijjati. ",
  "dhp135:0": "",
  "dhp135:1": "135. Yathā daṇḍena gopālo, ",
  "dhp135:2": "gāvo pājeti gocaraṃ; ",
  "dhp135:3": "Evaṃ jarā ca maccu ca, ",
  "dhp135:4": "āyuṃ pājenti pāṇinaṃ. ",
  "dhp136:0": "",
  "dhp136:1": "136. Atha pāpāni kammāni, ",
  "dhp136:2": "karaṃ bālo na bujjhati; ",
  "dhp136:3": "Sehi kammehi dummedho, ",
  "dhp136:4": "aggidaḍḍhova tappati. ",
  "dhp137:0": "",
  "dhp137:1": "137. Yo daṇḍena adaṇḍesu, ",
  "dhp137:2": "appaduṭṭhesu dussati; ",
  "dhp137:3": "Dasannamaññataraṃ ṭhānaṃ, ",
  "dhp137:4": "khippameva nigacchati. ",
  "dhp138:1": "138. Vedanaṃ pharusaṃ jāniṃ, ",
  "dhp138:2": "sarīrassa ca bhedanaṃ ; ",
  "dhp138:3": "Garukaṃ vāpi ābādhaṃ, ",
  "dhp138:4": "cittakkhepañca pāpuṇe. ",
  "dhp139:1": "139. Rājato vā upasaggaṃ , ",
  "dhp139:2": "abbhakkhānañca dāruṇaṃ; ",
  "dhp139:3": "Parikkhayañca ñātīnaṃ, ",
  "dhp139:4": "bhogānañca pabhaṅguraṃ . ",
  "dhp140:1": "140. Atha vāssa agārāni, ",
  "dhp140:2": "aggi ḍahati pāvako; ",
  "dhp140:3": "Kāyassa bhedā duppañño, ",
  "dhp140:4": "nirayaṃ sopapajjati . ",
  "dhp141:0": "",
  "dhp141:1": "141. Na naggacariyā na jaṭā na paṅkā, ",
  "dhp141:2": "nānāsakā thaṇḍilasāyikā vā; ",
  "dhp141:3": "Rajojallaṃ ukkuṭikappadhānaṃ, ",
  "dhp141:4": "sodhenti maccaṃ avitiṇṇakaṅkhaṃ. ",
  "dhp142:0": "",
  "dhp142:1": "142. Alaṅkato cepi samaṃ careyya, ",
  "dhp142:2": "santo danto niyato brahmacārī; ",
  "dhp142:3": "Sabbesu bhūtesu nidhāya daṇḍaṃ, ",
  "dhp142:4": "so brāhmaṇo so samaṇo sa bhikkhu. ",
  "dhp143:0": "",
  "dhp143:1": "143. Hirīnisedho puriso, ",
  "dhp143:2": "koci lokasmi vijjati; ",
  "dhp143:3": "Yo niddaṃ apabodheti , ",
  "dhp143:4": "asso bhadro kasāmiva. ",
  "dhp144:1": "144. Asso yathā bhadro kasāniviṭṭho, ",
  "dhp144:2": "ātāpino saṃvegino bhavātha; ",
  "dhp144:3": "Saddhāya sīlena ca vīriyena ca, ",
  "dhp144:4": "samādhinā dhammavinicchayena ca; ",
  "dhp144:5": "Sampannavijjācaraṇā patissatā, ",
  "dhp144:6": "jahissatha dukkhamidaṃ anappakaṃ. ",
  "dhp145:0": "",
  "dhp145:1": "145. Udakañhi nayanti nettikā, ",
  "dhp145:2": "usukārā namayanti tejanaṃ; ",
  "dhp145:3": "Dāruṃ namayanti tacchakā, ",
  "dhp145:4": "attānaṃ damayanti subbatā. ",
  "dhp145:5": "Daṇḍavaggo dasamo niṭṭhito. "
}
