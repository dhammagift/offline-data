  "dhp256:0.1": "",
  "dhp256:0.2": "",
  "dhp256:0.3": "19. Dhammaṭṭhavaggo ",
  "dhp256:0.4": "256. ",
  "dhp256:1": "Na tena hoti dhammaṭṭho, ",
  "dhp256:2": "yenatthaṃ sāhasā naye; ",
  "dhp256:3": "Yo ca atthaṃ anatthañca, ",
  "dhp256:4": "ubho niccheyya paṇḍito. ",
  "dhp257:1": "257. Asāhasena dhammena, ",
  "dhp257:2": "samena nayatī pare; ",
  "dhp257:3": "Dhammassa gutto medhāvī, ",
  "dhp257:4": "‘‘dhammaṭṭho’’ti pavuccati. ",
  "dhp258:0": "",
  "dhp258:1": "258. Na tena paṇḍito hoti, ",
  "dhp258:2": "yāvatā bahu bhāsati; ",
  "dhp258:3": "Khemī averī abhayo, ",
  "dhp258:4": "‘‘paṇḍito’’ti pavuccati. ",
  "dhp259:0": "",
  "dhp259:1": "259. Na tāvatā dhammadharo, ",
  "dhp259:2": "yāvatā bahu bhāsati; ",
  "dhp259:3": "Yo ca appampi sutvāna, ",
  "dhp259:4": "dhammaṃ kāyena passati; ",
  "dhp259:5": "Sa ve dhammadharo hoti, ",
  "dhp259:6": "yo dhammaṃ nappamajjati. ",
  "dhp260:0": "",
  "dhp260:1": "260. Na tena thero so hoti , ",
  "dhp260:2": "yenassa palitaṃ siro; ",
  "dhp260:3": "Paripakko vayo tassa, ",
  "dhp260:4": "‘‘moghajiṇṇo’’ti vuccati. ",
  "dhp261:1": "261. Yamhi saccañca dhammo ca, ",
  "dhp261:2": "ahiṃsā saṃyamo damo; ",
  "dhp261:3": "Sa ve vantamalo dhīro, ",
  "dhp261:4": "‘‘thero’’ iti pavuccati. ",
  "dhp262:0": "",
  "dhp262:1": "262. Na vākkaraṇamattena, ",
  "dhp262:2": "vaṇṇapokkharatāya vā; ",
  "dhp262:3": "Sādhurūpo naro hoti, ",
  "dhp262:4": "issukī maccharī saṭho. ",
  "dhp263:1": "263. Yassa cetaṃ samucchinnaṃ, ",
  "dhp263:2": "mūlaghaccaṃ samūhataṃ; ",
  "dhp263:3": "Sa vantadoso medhāvī, ",
  "dhp263:4": "‘‘sādhurūpo’’ti vuccati. ",
  "dhp264:0": "",
  "dhp264:1": "264. Na muṇḍakena samaṇo, ",
  "dhp264:2": "abbato alikaṃ bhaṇaṃ; ",
  "dhp264:3": "Icchālobhasamāpanno, ",
  "dhp264:4": "samaṇo kiṃ bhavissati. ",
  "dhp265:1": "265. Yo ca sameti pāpāni, ",
  "dhp265:2": "aṇuṃ thūlāni sabbaso; ",
  "dhp265:3": "Samitattā hi pāpānaṃ, ",
  "dhp265:4": "‘‘samaṇo’’ti pavuccati. ",
  "dhp266:0": "",
  "dhp266:1": "266. Na tena bhikkhu so hoti, ",
  "dhp266:2": "yāvatā bhikkhate pare; ",
  "dhp266:3": "Vissaṃ dhammaṃ samādāya, ",
  "dhp266:4": "bhikkhu hoti na tāvatā. ",
  "dhp267:1": "267. Yodha puññañca pāpañca, ",
  "dhp267:2": "bāhetvā brahmacariyavā ; ",
  "dhp267:3": "Saṅkhāya loke carati, ",
  "dhp267:4": "sa ve ‘‘bhikkhū’’ti vuccati. ",
  "dhp268:0": "",
  "dhp268:1": "268. Na monena munī hoti, ",
  "dhp268:2": "mūḷharūpo aviddasu; ",
  "dhp268:3": "Yo ca tulaṃva paggayha, ",
  "dhp268:4": "varamādāya paṇḍito. ",
  "dhp269:1": "269. Pāpāni parivajjeti, ",
  "dhp269:2": "sa munī tena so muni; ",
  "dhp269:3": "Yo munāti ubho loke, ",
  "dhp269:4": "‘‘muni’’ tena pavuccati. ",
  "dhp270:0": "",
  "dhp270:1": "270. Na tena ariyo hoti, ",
  "dhp270:2": "yena pāṇāni hiṃsati; ",
  "dhp270:3": "Ahiṃsā sabbapāṇānaṃ, ",
  "dhp270:4": "‘‘ariyo’’ti pavuccati. ",
  "dhp271:0": "",
  "dhp271:1": "271. Na sīlabbatamattena, ",
  "dhp271:2": "bāhusaccena vā pana; ",
  "dhp271:3": "Atha vā samādhilābhena, ",
  "dhp271:4": "vivittasayanena vā. ",
  "dhp272:1": "272. Phusāmi nekkhammasukhaṃ, ",
  "dhp272:2": "aputhujjanasevitaṃ; ",
  "dhp272:3": "Bhikkhu vissāsamāpādi, ",
  "dhp272:4": "appatto āsavakkhayaṃ. ",
  "dhp272:5": "Dhammaṭṭhavaggo ekūnavīsatimo niṭṭhito. "
}
