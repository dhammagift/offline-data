{
  "dhp1:0.1": "Namo tassa bhagavato arahato sammāsambuddhassa Khuddakanikāye Dhammapadapāḷi ",
  "dhp1:0.2": "",
  "dhp1:0.3": "1. Yamakavaggo ",
  "dhp1:0.4": "1. ",
  "dhp1:1": "Manopubbaṅgamā dhammā, ",
  "dhp1:2": "manoseṭṭhā manomayā; ",
  "dhp1:3": "Manasā ce paduṭṭhena, ",
  "dhp1:4": "bhāsati vā karoti vā; ",
  "dhp1:5": "Tato naṃ dukkhamanveti, ",
  "dhp1:6": "cakkaṃva vahato padaṃ. ",
  "dhp2:0": "",
  "dhp2:1": "2. Manopubbaṅgamā dhammā, ",
  "dhp2:2": "manoseṭṭhā manomayā; ",
  "dhp2:3": "Manasā ce pasannena, ",
  "dhp2:4": "bhāsati vā karoti vā; ",
  "dhp2:5": "Tato naṃ sukhamanveti, ",
  "dhp2:6": "chāyāva anapāyinī . ",
  "dhp3:0": "",
  "dhp3:1": "3. Akkocchi maṃ avadhi maṃ, ",
  "dhp3:2": "ajini maṃ ahāsi me; ",
  "dhp3:3": "Ye ca taṃ upanayhanti, ",
  "dhp3:4": "veraṃ tesaṃ na sammati. ",
  "dhp4:1": "4. Akkocchi maṃ avadhi maṃ, ",
  "dhp4:2": "ajini maṃ ahāsi me; ",
  "dhp4:3": "Ye ca taṃ nupanayhanti, ",
  "dhp4:4": "veraṃ tesūpasammati. ",
  "dhp5:0": "",
  "dhp5:1": "5. Na hi verena verāni, ",
  "dhp5:2": "sammantīdha kudācanaṃ; ",
  "dhp5:3": "Averena ca sammanti, ",
  "dhp5:4": "esa dhammo sanantano. ",
  "dhp6:0": "",
  "dhp6:1": "6. Pare ca na vijānanti, ",
  "dhp6:2": "mayamettha yamāmase; ",
  "dhp6:3": "Ye ca tattha vijānanti, ",
  "dhp6:4": "tato sammanti medhagā. ",
  "dhp7:0": "",
  "dhp7:1": "7. Subhānupassiṃ viharantaṃ, ",
  "dhp7:2": "indriyesu asaṃvutaṃ; ",
  "dhp7:3": "Bhojanamhi cāmattaññuṃ, ",
  "dhp7:4": "kusītaṃ hīnavīriyaṃ; ",
  "dhp7:5": "Taṃ ve pasahati māro, ",
  "dhp7:6": "vāto rukkhaṃva dubbalaṃ. ",
  "dhp8:1": "8. Asubhānupassiṃ viharantaṃ, ",
  "dhp8:2": "indriyesu susaṃvutaṃ; ",
  "dhp8:3": "Bhojanamhi ca mattaññuṃ, ",
  "dhp8:4": "saddhaṃ āraddhavīriyaṃ; ",
  "dhp8:5": "Taṃ ve nappasahati māro, ",
  "dhp8:6": "vāto selaṃva pabbataṃ. ",
  "dhp9:0": "",
  "dhp9:1": "9. Anikkasāvo kāsāvaṃ, ",
  "dhp9:2": "yo vatthaṃ paridahissati; ",
  "dhp9:3": "Apeto damasaccena, ",
  "dhp9:4": "na so kāsāvamarahati. ",
  "dhp10:1": "10. Yo ca vantakasāvassa, ",
  "dhp10:2": "sīlesu susamāhito; ",
  "dhp10:3": "Upeto damasaccena, ",
  "dhp10:4": "sa ve kāsāvamarahati. ",
  "dhp11:0": "",
  "dhp11:1": "11. Asāre sāramatino, ",
  "dhp11:2": "sāre cāsāradassino; ",
  "dhp11:3": "Te sāraṃ nādhigacchanti, ",
  "dhp11:4": "micchāsaṅkappagocarā. ",
  "dhp12:1": "12. Sārañca sārato ñatvā, ",
  "dhp12:2": "asārañca asārato; ",
  "dhp12:3": "Te sāraṃ adhigacchanti, ",
  "dhp12:4": "sammāsaṅkappagocarā. ",
  "dhp13:0": "",
  "dhp13:1": "13. Yathā agāraṃ ducchannaṃ, ",
  "dhp13:2": "vuṭṭhī samativijjhati; ",
  "dhp13:3": "Evaṃ abhāvitaṃ cittaṃ, ",
  "dhp13:4": "rāgo samativijjhati. ",
  "dhp14:1": "14. Yathā agāraṃ suchannaṃ, ",
  "dhp14:2": "vuṭṭhī na samativijjhati; ",
  "dhp14:3": "Evaṃ subhāvitaṃ cittaṃ, ",
  "dhp14:4": "rāgo na samativijjhati. ",
  "dhp15:0": "",
  "dhp15:1": "15. Idha socati pecca socati, ",
  "dhp15:2": "pāpakārī ubhayattha socati; ",
  "dhp15:3": "So socati so vihaññati, ",
  "dhp15:4": "disvā kammakiliṭṭhamattano. ",
  "dhp16:0": "",
  "dhp16:1": "16. Idha modati pecca modati, ",
  "dhp16:2": "katapuñño ubhayattha modati; ",
  "dhp16:3": "So modati so pamodati, ",
  "dhp16:4": "disvā kammavisuddhimattano. ",
  "dhp17:0": "",
  "dhp17:1": "17. Idha tappati pecca tappati, ",
  "dhp17:2": "pāpakārī ubhayattha tappati; ",
  "dhp17:3": "‘‘Pāpaṃ me kata’’nti tappati, ",
  "dhp17:4": "bhiyyo tappati duggatiṃ gato. ",
  "dhp18:0": "",
  "dhp18:1": "18. Idha nandati pecca nandati, ",
  "dhp18:2": "katapuñño ubhayattha nandati; ",
  "dhp18:3": "‘‘Puññaṃ me kata’’nti nandati, ",
  "dhp18:4": "bhiyyo nandati suggatiṃ gato. ",
  "dhp19:0": "",
  "dhp19:1": "19. Bahumpi ce saṃhita bhāsamāno, ",
  "dhp19:2": "na takkaro hoti naro pamatto; ",
  "dhp19:3": "Gopova gāvo gaṇayaṃ paresaṃ, ",
  "dhp19:4": "na bhāgavā sāmaññassa hoti. ",
  "dhp20:1": "20. Appampi ce saṃhita bhāsamāno, ",
  "dhp20:2": "dhammassa hoti anudhammacārī; ",
  "dhp20:3": "Rāgañca dosañca pahāya mohaṃ, ",
  "dhp20:4": "sammappajāno suvimuttacitto; ",
  "dhp20:5": "Anupādiyāno idha vā huraṃ vā, ",
  "dhp20:6": "sa bhāgavā sāmaññassa hoti. ",
  "dhp20:7": "Yamakavaggo paṭhamo niṭṭhito. "
}
