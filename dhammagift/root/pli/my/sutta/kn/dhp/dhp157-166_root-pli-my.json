{
  "dhp157:0.1": "",
  "dhp157:0.2": "",
  "dhp157:0.3": "12. Attavaggo ",
  "dhp157:0.4": "157. ",
  "dhp157:1": "Attānañce piyaṃ jaññā, ",
  "dhp157:2": "rakkheyya naṃ surakkhitaṃ; ",
  "dhp157:3": "Tiṇṇaṃ aññataraṃ yāmaṃ, ",
  "dhp157:4": "paṭijaggeyya paṇḍito. ",
  "dhp158:0": "",
  "dhp158:1": "158. Attānameva paṭhamaṃ, ",
  "dhp158:2": "patirūpe nivesaye; ",
  "dhp158:3": "Athaññamanusāseyya, ",
  "dhp158:4": "na kilisseyya paṇḍito. ",
  "dhp159:0": "159. Attānaṃ ",
  "dhp159:1": "ce tathā kayirā, ",
  "dhp159:2": "yathāññamanusāsati; ",
  "dhp159:3": "Sudanto vata dametha, ",
  "dhp159:4": "attā hi kira duddamo. ",
  "dhp160:0": "",
  "dhp160:1": "160. Attā hi attano nātho, ",
  "dhp160:2": "ko hi nātho paro siyā; ",
  "dhp160:3": "Attanā hi sudantena, ",
  "dhp160:4": "nāthaṃ labhati dullabhaṃ. ",
  "dhp161:0": "",
  "dhp161:1": "161. Attanā hi kataṃ pāpaṃ, ",
  "dhp161:2": "attajaṃ attasambhavaṃ; ",
  "dhp161:3": "Abhimatthati dummedhaṃ, ",
  "dhp161:4": "vajiraṃ vasmamayaṃ maṇiṃ. ",
  "dhp162:0": "",
  "dhp162:1": "162. Yassa accantadussīlyaṃ, ",
  "dhp162:2": "māluvā sālamivotthataṃ; ",
  "dhp162:3": "Karoti so tathattānaṃ, ",
  "dhp162:4": "yathā naṃ icchatī diso. ",
  "dhp163:0": "",
  "dhp163:1": "163. Sukarāni asādhūni, ",
  "dhp163:2": "attano ahitāni ca; ",
  "dhp163:3": "Yaṃ ve hitañca sādhuñca, ",
  "dhp163:4": "taṃ ve paramadukkaraṃ. ",
  "dhp164:0": "",
  "dhp164:1": "164. Yo sāsanaṃ arahataṃ, ",
  "dhp164:2": "ariyānaṃ dhammajīvinaṃ; ",
  "dhp164:3": "Paṭikkosati dummedho, ",
  "dhp164:4": "diṭṭhiṃ nissāya pāpikaṃ; ",
  "dhp164:5": "Phalāni kaṭṭhakasseva, ",
  "dhp164:6": "attaghātāya phallati. ",
  "dhp165:0": "",
  "dhp165:1": "165. Attanā hi kataṃ pāpaṃ, ",
  "dhp165:2": "attanā saṃkilissati; ",
  "dhp165:3": "Attanā akataṃ pāpaṃ, ",
  "dhp165:4": "attanāva visujjhati; ",
  "dhp165:5": "Suddhī asuddhi paccattaṃ, ",
  "dhp165:6": "nāñño aññaṃ visodhaye. ",
  "dhp166:0": "",
  "dhp166:1": "166. Attadatthaṃ paratthena, ",
  "dhp166:2": "bahunāpi na hāpaye; ",
  "dhp166:3": "Attadatthamabhiññāya, ",
  "dhp166:4": "sadatthapasuto siyā. ",
  "dhp166:5": "Attavaggo dvādasamo niṭṭhito. "
}
