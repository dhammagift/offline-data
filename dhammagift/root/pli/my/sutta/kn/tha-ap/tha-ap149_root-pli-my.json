  "tha-ap149:0.2": "",
  "tha-ap149:0.3": "7. Maggadāyakattheraapadānaṃ 32. ",
  "tha-ap149:1.1": "‘‘Uttaritvāna nadikaṃ, ",
  "tha-ap149:1.2": "vanaṃ gacchati cakkhumā; ",
  "tha-ap149:1.3": "Tamaddasāsiṃ sambuddhaṃ, ",
  "tha-ap149:1.4": "siddhatthaṃ varalakkhaṇaṃ. ",
  "tha-ap149:2.1": "33. ‘‘Kudāla piṭakamādāya, ",
  "tha-ap149:2.2": "samaṃ katvāna taṃ pathaṃ; ",
  "tha-ap149:2.3": "Satthāraṃ abhivādetvā, ",
  "tha-ap149:2.4": "sakaṃ cittaṃ pasādayiṃ. ",
  "tha-ap149:3.1": "34. ‘‘Catunnavutito kappe, ",
  "tha-ap149:3.2": "yaṃ kammamakariṃ tadā; ",
  "tha-ap149:3.3": "Duggatiṃ nābhijānāmi, ",
  "tha-ap149:3.4": "maggadānassidaṃ phalaṃ. ",
  "tha-ap149:4.1": "35. ‘‘Sattapaññāsakappamhi, ",
  "tha-ap149:4.2": "eko āsiṃ janādhipo; ",
  "tha-ap149:4.3": "Nāmena suppabuddhoti, ",
  "tha-ap149:4.4": "nāyako so narissaro. ",
  "tha-ap149:5.1": "36. ‘‘Paṭisambhidā catasso ",
  "tha-ap149:5.2": "…pe… ",
  "tha-ap149:5.3": "kataṃ buddhassa sāsanaṃ’’. ",
  "tha-ap149:6.1": "Itthaṃ sudaṃ āyasmā maggadāyako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap149:7.1": "Maggadāyakattherassāpadānaṃ sattamaṃ. "
}
