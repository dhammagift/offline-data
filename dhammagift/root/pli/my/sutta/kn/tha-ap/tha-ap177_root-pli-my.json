  "tha-ap177:0.1": "",
  "tha-ap177:0.2": "",
  "tha-ap177:0.3": "21. 5. Sīhāsanadāyakattheraapadānaṃ ",
  "tha-ap177:1.1": "‘‘Nibbute lokanāthamhi, ",
  "tha-ap177:1.2": "padumuttaranāyake; ",
  "tha-ap177:1.3": "Pasannacitto sumano, ",
  "tha-ap177:1.4": "sīhāsanamadāsahaṃ. ",
  "tha-ap177:2.1": "22. ‘‘Bahūhi gandhamālehi, ",
  "tha-ap177:2.2": "diṭṭhadhammasukhāvahe; ",
  "tha-ap177:2.3": "Tattha pūjañca katvāna, ",
  "tha-ap177:2.4": "nibbāyati bahujjano. ",
  "tha-ap177:3.1": "23. ‘‘Pasannacitto sumano, ",
  "tha-ap177:3.2": "vanditvā bodhimuttamaṃ; ",
  "tha-ap177:3.3": "Kappānaṃ satasahassaṃ, ",
  "tha-ap177:3.4": "duggatiṃ nupapajjahaṃ. ",
  "tha-ap177:4.1": "24. ‘‘Pannarasasahassamhi, ",
  "tha-ap177:4.2": "kappānaṃ aṭṭha āsu te ; ",
  "tha-ap177:4.3": "Siluccayasanāmā ca, ",
  "tha-ap177:4.4": "rājāno cakkavattino. ",
  "tha-ap177:5.1": "25. ‘‘Paṭisambhidā catasso…pe… ",
  "tha-ap177:5.2": "",
  "tha-ap177:5.3": "kataṃ buddhassa sāsanaṃ’’. ",
  "tha-ap177:6.1": "Itthaṃ sudaṃ āyasmā sīhāsanadāyako thero imā gāthāyo abhāsitthāti; ",
  "tha-ap177:7.1": "Sīhāsanadāyakattherassāpadānaṃ pañcamaṃ. "
}
