  "tha-ap398:0.1": "",
  "tha-ap398:0.2": "",
  "tha-ap398:0.3": "386. 6. Bākulattheraapadānaṃ ",
  "tha-ap398:1.1": "‘‘Himavantassāvidūre, ",
  "tha-ap398:1.2": "sobhito nāma pabbato; ",
  "tha-ap398:1.3": "Assamo sukato mayhaṃ, ",
  "tha-ap398:1.4": "sakasissehi māpito. ",
  "tha-ap398:2.1": "387. ‘‘Maṇḍapā ca bahū tattha, ",
  "tha-ap398:2.2": "pupphitā sinduvārakā; ",
  "tha-ap398:2.3": "Kapitthā ca bahū tattha, ",
  "tha-ap398:2.4": "pupphitā jīvajīvakā . ",
  "tha-ap398:3.1": "388. ‘‘Nigguṇḍiyo bahū tattha, ",
  "tha-ap398:3.2": "badarāmalakāni ca; ",
  "tha-ap398:3.3": "Phārusakā alābū ca, ",
  "tha-ap398:3.4": "puṇḍarīkā ca pupphitā. ",
  "tha-ap398:4.1": "389. ‘‘Āḷakā beluvā tattha, ",
  "tha-ap398:4.2": "kadalī mātuluṅgakā; ",
  "tha-ap398:4.3": "Mahānāmā bahū tattha, ",
  "tha-ap398:4.4": "ajjunā ca piyaṅgukā. ",
  "tha-ap398:5.1": "390. ‘‘Kosambā saḷalā nimbā , ",
  "tha-ap398:5.2": "nigrodhā ca kapitthanā; ",
  "tha-ap398:5.3": "Ediso assamo mayhaṃ, ",
  "tha-ap398:5.4": "sasissohaṃ tahiṃ vasiṃ. ",
  "tha-ap398:6.1": "391. ‘‘Anomadassī bhagavā, ",
  "tha-ap398:6.2": "sayambhū lokanāyako; ",
  "tha-ap398:6.3": "Gavesaṃ paṭisallānaṃ, ",
  "tha-ap398:6.4": "mamassamamupāgami. ",
  "tha-ap398:7.1": "392. ‘‘Upetamhi mahāvīre, ",
  "tha-ap398:7.2": "anomadassimahāyase; ",
  "tha-ap398:7.3": "Khaṇena lokanāthassa, ",
  "tha-ap398:7.4": "vātābādho samuṭṭhahi. ",
  "tha-ap398:8.1": "393. ‘‘Vicaranto araññamhi, ",
  "tha-ap398:8.2": "addasaṃ lokanāyakaṃ; ",
  "tha-ap398:8.3": "Upagantvāna sambuddhaṃ, ",
  "tha-ap398:8.4": "cakkhumantaṃ mahāyasaṃ. ",
  "tha-ap398:9.1": "394. ‘‘Iriyañcāpi disvāna, ",
  "tha-ap398:9.2": "upalakkhesahaṃ tadā; ",
  "tha-ap398:9.3": "Asaṃsayañhi buddhassa, ",
  "tha-ap398:9.4": "byādhi no udapajjatha. ",
  "tha-ap398:10.1": "395. ‘‘Khippaṃ assamamāgañchiṃ, ",
  "tha-ap398:10.2": "mama sissāna santike; ",
  "tha-ap398:10.3": "Bhesajjaṃ kattukāmohaṃ, ",
  "tha-ap398:10.4": "sisse āmantayiṃ tadā. ",
  "tha-ap398:11.1": "396. ‘‘Paṭissuṇitvāna me vākyaṃ, ",
  "tha-ap398:11.2": "sissā sabbe sagāravā; ",
  "tha-ap398:11.3": "Ekajjhaṃ sannipatiṃsu, ",
  "tha-ap398:11.4": "satthugāravatā mama. ",
  "tha-ap398:12.1": "397. ‘‘Khippaṃ pabbatamāruyha, ",
  "tha-ap398:12.2": "sabbosadhamahāsahaṃ ; ",
  "tha-ap398:12.3": "Pānīyayogaṃ katvāna, ",
  "tha-ap398:12.4": "buddhaseṭṭhassadāsahaṃ. ",
  "tha-ap398:13.1": "398. ‘‘Paribhutte mahāvīre, ",
  "tha-ap398:13.2": "sabbaññulokanāyake; ",
  "tha-ap398:13.3": "Khippaṃ vāto vūpasami, ",
  "tha-ap398:13.4": "sugatassa mahesino. ",
  "tha-ap398:14.1": "399. ‘‘Passaddhaṃ darathaṃ disvā, ",
  "tha-ap398:14.2": "anomadassī mahāyaso; ",
  "tha-ap398:14.3": "Sakāsane nisīditvā, ",
  "tha-ap398:14.4": "imā gāthā abhāsatha. ",
  "tha-ap398:15.1": "400. ‘‘‘Yo me pādāsi bhesajjaṃ, ",
  "tha-ap398:15.2": "byādhiñca samayī mama; ",
  "tha-ap398:15.3": "Tamahaṃ kittayissāmi, ",
  "tha-ap398:15.4": "suṇātha mama bhāsato. ",
  "tha-ap398:16.1": "401. ‘‘‘Kappasatasahassāni, ",
  "tha-ap398:16.2": "devaloke ramissati; ",
  "tha-ap398:16.3": "Vādite tūriye tattha, ",
  "tha-ap398:16.4": "modissati sadā ayaṃ. ",
  "tha-ap398:17.1": "402. ‘‘‘Manussalokamāgantvā, ",
  "tha-ap398:17.2": "sukkamūlena codito; ",
  "tha-ap398:17.3": "Sahassakkhattuṃ rājā ca, ",
  "tha-ap398:17.4": "cakkavattī bhavissati. ",
  "tha-ap398:18.1": "403. ‘‘‘Pañcapaññāsakappamhi, ",
  "tha-ap398:18.2": "anomo nāma khattiyo; ",
  "tha-ap398:18.3": "Cāturanto vijitāvī, ",
  "tha-ap398:18.4": "jambumaṇḍassa issaro. ",
  "tha-ap398:19.1": "404. ‘‘‘Sattaratanasampanno, ",
  "tha-ap398:19.2": "cakkavattī mahabbalo; ",
  "tha-ap398:19.3": "Tāvatiṃsepi khobhetvā, ",
  "tha-ap398:19.4": "issaraṃ kārayissati. ",
  "tha-ap398:20.1": "405. ‘‘‘Devabhūto manusso vā, ",
  "tha-ap398:20.2": "appābādho bhavissati; ",
  "tha-ap398:20.3": "Pariggahaṃ vivajjetvā, ",
  "tha-ap398:20.4": "byādhiṃ loke tarissati. ",
  "tha-ap398:21.1": "406. ‘‘‘Apparimeyye ito kappe, ",
  "tha-ap398:21.2": "okkākakulasambhavo; ",
  "tha-ap398:21.3": "Gotamo nāma gottena, ",
  "tha-ap398:21.4": "satthā loke bhavissati. ",
  "tha-ap398:22.1": "407. ‘‘‘Tassa dhammesu dāyādo, ",
  "tha-ap398:22.2": "oraso dhammanimmito; ",
  "tha-ap398:22.3": "Sabbāsave pariññāya, ",
  "tha-ap398:22.4": "nibbāyissatināsavo. ",
  "tha-ap398:23.1": "408. ‘‘‘Kilese jhāpayitvāna, ",
  "tha-ap398:23.2": "taṇhāsotaṃ tarissati; ",
  "tha-ap398:23.3": "Bākulo nāma nāmena, ",
  "tha-ap398:23.4": "hessati satthu sāvako. ",
  "tha-ap398:24.1": "409. ‘‘‘Idaṃ sabbaṃ abhiññāya, ",
  "tha-ap398:24.2": "gotamo sakyapuṅgavo; ",
  "tha-ap398:24.3": "Bhikkhusaṅghe nisīditvā, ",
  "tha-ap398:24.4": "etadagge ṭhapessati’. ",
  "tha-ap398:25.1": "410. ‘‘Anomadassī bhagavā, ",
  "tha-ap398:25.2": "sayambhū lokanāyako; ",
  "tha-ap398:25.3": "Vivekānuvilokento, ",
  "tha-ap398:25.4": "mamassamamupāgami. ",
  "tha-ap398:26.1": "411. ‘‘Upāgataṃ mahāvīraṃ, ",
  "tha-ap398:26.2": "sabbaññuṃ lokanāyakaṃ; ",
  "tha-ap398:26.3": "Sabbosadhena tappesiṃ, ",
  "tha-ap398:26.4": "pasanno sehi pāṇibhi. ",
  "tha-ap398:27.1": "412. ‘‘Tassa me sukataṃ kammaṃ, ",
  "tha-ap398:27.2": "sukhette bījasampadā; ",
  "tha-ap398:27.3": "Khepetuṃ neva sakkomi, ",
  "tha-ap398:27.4": "tadā hi sukataṃ mama. ",
  "tha-ap398:28.1": "413. ‘‘Lābhā mama suladdhaṃ me, ",
  "tha-ap398:28.2": "yohaṃ addakkhi nāyakaṃ; ",
  "tha-ap398:28.3": "Tena kammāvasesena, ",
  "tha-ap398:28.4": "pattomhi acalaṃ padaṃ. ",
  "tha-ap398:29.1": "414. ‘‘Sabbametaṃ abhiññāya, ",
  "tha-ap398:29.2": "gotamo sakyapuṅgavo; ",
  "tha-ap398:29.3": "Bhikkhusaṅghe nisīditvā, ",
  "tha-ap398:29.4": "etadagge ṭhapesi maṃ. ",
  "tha-ap398:30.1": "415. ‘‘Aparimeyye ito kappe, ",
  "tha-ap398:30.2": "yaṃ kammamakariṃ tadā; ",
  "tha-ap398:30.3": "Duggatiṃ nābhijānāmi, ",
  "tha-ap398:30.4": "bhesajjassa idaṃ phalaṃ. ",
  "tha-ap398:31.1": "416. ‘‘Kilesā jhāpitā mayhaṃ, ",
  "tha-ap398:31.2": "bhavā sabbe samūhatā; ",
  "tha-ap398:31.3": "Sabbāsavā parikkhīṇā, ",
  "tha-ap398:31.4": "natthi dāni punabbhavo. ",
  "tha-ap398:32.1": "417. ‘‘Svāgataṃ vata me āsi…pe… ",
  "tha-ap398:32.2": "",
  "tha-ap398:32.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap398:33.1": "418. ‘‘Paṭisambhidā catasso…pe… ",
  "tha-ap398:33.2": "",
  "tha-ap398:33.3": "kataṃ buddhassa sāsanaṃ’’. ",
  "tha-ap398:34.1": "Itthaṃ sudaṃ āyasmā bākulo thero imā gāthāyo abhāsitthāti; ",
  "tha-ap398:35.1": "Bākulattherassāpadānaṃ chaṭṭhaṃ. "
}
