  "tha-ap26:0.2": "",
  "tha-ap26:0.3": "4. Pañcasīlasamādāniyattheraapadānaṃ 134. ",
  "tha-ap26:1.1": "‘‘Nagare candavatiyā, ",
  "tha-ap26:1.2": "bhatako āsahaṃ tadā; ",
  "tha-ap26:1.3": "Parakammāyane yutto, ",
  "tha-ap26:1.4": "pabbajjaṃ na labhāmahaṃ. ",
  "tha-ap26:2.1": "135. ‘‘Mahandhakārapihitā, ",
  "tha-ap26:2.2": "tividhaggīhi ḍayhare; ",
  "tha-ap26:2.3": "Kena nu kho upāyena, ",
  "tha-ap26:2.4": "visaṃyutto bhave ahaṃ. ",
  "tha-ap26:3.1": "136. ‘‘Deyyadhammo ca me natthi, ",
  "tha-ap26:3.2": "varāko bhatako ahaṃ; ",
  "tha-ap26:3.3": "Yaṃnūnāhaṃ pañcasīlaṃ, ",
  "tha-ap26:3.4": "rakkheyyaṃ paripūrayaṃ. ",
  "tha-ap26:4.1": "137. ‘‘Anomadassissa munino, ",
  "tha-ap26:4.2": "nisabho nāma sāvako; ",
  "tha-ap26:4.3": "Tamahaṃ upasaṅkamma, ",
  "tha-ap26:4.4": "pañcasikkhāpadaggahiṃ. ",
  "tha-ap26:5.1": "138. ‘‘Vassasatasahassāni, ",
  "tha-ap26:5.2": "āyu vijjati tāvade; ",
  "tha-ap26:5.3": "Tāvatā pañcasīlāni, ",
  "tha-ap26:5.4": "paripuṇṇāni gopayiṃ. ",
  "tha-ap26:6.1": "139. ‘‘Maccukāle ca sampatte, ",
  "tha-ap26:6.2": "devā assāsayanti maṃ; ",
  "tha-ap26:6.3": "‘Ratho sahassayutto te, ",
  "tha-ap26:6.4": "mārisāyaṃ upaṭṭhito’. ",
  "tha-ap26:7.1": "140. ‘‘Vattante carime citte, ",
  "tha-ap26:7.2": "mama sīlaṃ anussariṃ; ",
  "tha-ap26:7.3": "Tena kammena sukatena, ",
  "tha-ap26:7.4": "tāvatiṃsaṃ agacchahaṃ. ",
  "tha-ap26:8.1": "141. ‘‘Tiṃsakkhattuñca devindo, ",
  "tha-ap26:8.2": "devarajjamakārayiṃ; ",
  "tha-ap26:8.3": "Dibbasukhaṃ anubhaviṃ, ",
  "tha-ap26:8.4": "accharāhi purakkhato. ",
  "tha-ap26:9.1": "142. ‘‘Pañcasattatikkhattuñca, ",
  "tha-ap26:9.2": "cakkavattī ahosahaṃ; ",
  "tha-ap26:9.3": "Padesarajjaṃ vipulaṃ, ",
  "tha-ap26:9.4": "gaṇanāto asaṅkhiyaṃ. ",
  "tha-ap26:10.1": "143. ‘‘Devalokā cavitvāna, ",
  "tha-ap26:10.2": "sukkamūlena codito; ",
  "tha-ap26:10.3": "Pure vesāliyaṃ jāto, ",
  "tha-ap26:10.4": "mahāsāle suaḍḍhake. ",
  "tha-ap26:11.1": "144. ‘‘Vassūpanāyike kāle, ",
  "tha-ap26:11.2": "dippante jinasāsane; ",
  "tha-ap26:11.3": "Mātā ca me pitā ceva, ",
  "tha-ap26:11.4": "pañcasikkhāpadaggahuṃ. ",
  "tha-ap26:12.1": "145. ‘‘Saha sutvānahaṃ sīlaṃ, ",
  "tha-ap26:12.2": "mama sīlaṃ anussariṃ; ",
  "tha-ap26:12.3": "Ekāsane nisīditvā, ",
  "tha-ap26:12.4": "arahattamapāpuṇiṃ. ",
  "tha-ap26:13.1": "146. ‘‘Jātiyā pañcavassena, ",
  "tha-ap26:13.2": "arahattamapāpuṇiṃ; ",
  "tha-ap26:13.3": "Upasampādayi buddho, ",
  "tha-ap26:13.4": "guṇamaññāya cakkhumā. ",
  "tha-ap26:14.1": "147. ‘‘Paripuṇṇāni gopetvā, ",
  "tha-ap26:14.2": "pañcasikkhāpadānahaṃ; ",
  "tha-ap26:14.3": "Aparimeyye ito kappe, ",
  "tha-ap26:14.4": "vinipātaṃ na gacchahaṃ. ",
  "tha-ap26:15.1": "148. ‘‘Svāhaṃ yasamanubhaviṃ, ",
  "tha-ap26:15.2": "tesaṃ sīlāna vāhasā; ",
  "tha-ap26:15.3": "Kappakoṭimpi kittento, ",
  "tha-ap26:15.4": "kittaye ekadesakaṃ. ",
  "tha-ap26:16.1": "149. ‘‘Pañcasīlāni gopetvā, ",
  "tha-ap26:16.2": "tayo hetū labhāmahaṃ; ",
  "tha-ap26:16.3": "Dīghāyuko mahābhogo, ",
  "tha-ap26:16.4": "tikkhapañño bhavāmahaṃ. ",
  "tha-ap26:17.1": "150. ‘‘Saṃkittento ca sabbesaṃ, ",
  "tha-ap26:17.2": "abhimattañca porisaṃ; ",
  "tha-ap26:17.3": "Bhavābhave saṃsaritvā, ",
  "tha-ap26:17.4": "ete ṭhāne labhāmahaṃ. ",
  "tha-ap26:18.1": "151. ‘‘Aparimeyyasīlesu, ",
  "tha-ap26:18.2": "vattantā jinasāvakā; ",
  "tha-ap26:18.3": "Bhavesu yadi rajjeyyuṃ, ",
  "tha-ap26:18.4": "vipāko kīdiso bhave. ",
  "tha-ap26:19.1": "152. ‘‘Suciṇṇaṃ me pañcasīlaṃ, ",
  "tha-ap26:19.2": "bhatakena tapassinā ; ",
  "tha-ap26:19.3": "Tena sīlenahaṃ ajja, ",
  "tha-ap26:19.4": "mocayiṃ sabbabandhanā. ",
  "tha-ap26:20.1": "153. ‘‘Aparimeyye ito kappe, ",
  "tha-ap26:20.2": "pañcasīlāni gopayiṃ; ",
  "tha-ap26:20.3": "Duggatiṃ nābhijānāmi, ",
  "tha-ap26:20.4": "pañcasīlānidaṃ phalaṃ. ",
  "tha-ap26:21.1": "154. ‘‘Paṭisambhidā catasso, ",
  "tha-ap26:21.2": "vimokkhāpi ca aṭṭhime; ",
  "tha-ap26:21.3": "Chaḷabhiññā sacchikatā, ",
  "tha-ap26:21.4": "kataṃ buddhassa sāsanaṃ’’. ",
  "tha-ap26:22.1": "Itthaṃ sudaṃ āyasmā pañcasīlasamādāniyo thero imā gāthāyo abhāsitthāti. ",
  "tha-ap26:23.1": "Pañcasīlasamādāniyattherassāpadānaṃ catutthaṃ. "
}
