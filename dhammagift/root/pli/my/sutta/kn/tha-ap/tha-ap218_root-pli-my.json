  "tha-ap218:0.3": "27. 6. Sandhitattheraapadānaṃ ",
  "tha-ap218:1.1": "‘‘Assatthe haritobhāse, ",
  "tha-ap218:1.2": "saṃvirūḷhamhi pādape; ",
  "tha-ap218:1.3": "Ekaṃ buddhagataṃ saññaṃ, ",
  "tha-ap218:1.4": "alabhiṃhaṃ patissato. ",
  "tha-ap218:2.1": "28. ‘‘Ekattiṃse ito kappe, ",
  "tha-ap218:2.2": "yaṃ saññamalabhiṃ tadā; ",
  "tha-ap218:2.3": "Tassā saññāya vāhasā, ",
  "tha-ap218:2.4": "patto me āsavakkhayo. ",
  "tha-ap218:3.1": "29. ‘‘Ito terasakappamhi, ",
  "tha-ap218:3.2": "dhaniṭṭho nāma khattiyo; ",
  "tha-ap218:3.3": "Sattaratanasampanno, ",
  "tha-ap218:3.4": "cakkavattī mahabbalo. ",
  "tha-ap218:4.1": "30. ‘‘Paṭisambhidā catasso…pe… ",
  "tha-ap218:4.2": "",
  "tha-ap218:4.3": "kataṃ buddhassa sāsanaṃ’’. ",
  "tha-ap218:5.1": "Itthaṃ sudaṃ āyasmā sandhito thero imā gāthāyo abhāsitthāti. ",
  "tha-ap218:6.1": "Sandhitattherassāpadānaṃ chaṭṭhaṃ. "
}
