  "tha-ap74:0.2": "",
  "tha-ap74:0.3": "2. Padasaññakattheraapadānaṃ 5. ",
  "tha-ap74:1.1": "‘‘Akkantañca padaṃ disvā, ",
  "tha-ap74:1.2": "tissassādiccabandhuno; ",
  "tha-ap74:1.3": "Haṭṭho haṭṭhena cittena, ",
  "tha-ap74:1.4": "pade cittaṃ pasādayiṃ. ",
  "tha-ap74:2.1": "6. ‘‘Dvenavute ito kappe, ",
  "tha-ap74:2.2": "yaṃ saññamalabhiṃ tadā; ",
  "tha-ap74:2.3": "Duggatiṃ nābhijānāmi, ",
  "tha-ap74:2.4": "padasaññāyidaṃ phalaṃ. ",
  "tha-ap74:3.1": "7. ‘‘Ito sattamake kappe, ",
  "tha-ap74:3.2": "sumedho nāma khattiyo; ",
  "tha-ap74:3.3": "Sattaratanasampanno, ",
  "tha-ap74:3.4": "cakkavatī mahabbalo. ",
  "tha-ap74:4.1": "8. ‘‘Paṭisambhidā catasso ",
  "tha-ap74:4.2": "…pe… ",
  "tha-ap74:4.3": "kataṃ buddhassa sāsanaṃ’’. ",
  "tha-ap74:5.1": "Itthaṃ sudaṃ āyasmā padasaññako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap74:6.1": "Padasaññakattherassāpadānaṃ dutiyaṃ. "
}
