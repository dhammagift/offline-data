{
  "tha-ap273:0.1": "",
  "tha-ap273:0.2": "28. Suvaṇṇabibbohanavaggo ",
  "tha-ap273:0.3": "1. 1. Suvaṇṇabibbohaniyattheraapadānaṃ ",
  "tha-ap273:1.1": "‘‘Ekāsanaṃ ahamadaṃ, ",
  "tha-ap273:1.2": "pasanno sehi pāṇibhi; ",
  "tha-ap273:1.3": "Bibbohanañca pādāsiṃ, ",
  "tha-ap273:1.4": "uttamatthassa pattiyā. ",
  "tha-ap273:2.1": "2. ‘‘Ekanavutito kappe, ",
  "tha-ap273:2.2": "bibbohanamadāsahaṃ; ",
  "tha-ap273:2.3": "Duggatiṃ nābhijānāmi, ",
  "tha-ap273:2.4": "bibbohanassidaṃ phalaṃ. ",
  "tha-ap273:3.1": "3. ‘‘Ito tesaṭṭhime kappe, ",
  "tha-ap273:3.2": "asamo nāma khattiyo; ",
  "tha-ap273:3.3": "Sattaratanasampanno, ",
  "tha-ap273:3.4": "cakkavattī mahabbalo. ",
  "tha-ap273:4.1": "4. ‘‘Paṭisambhidā catasso, ",
  "tha-ap273:4.2": "vimokkhāpi ca aṭṭhime; ",
  "tha-ap273:4.3": "Chaḷabhiññā sacchikatā, ",
  "tha-ap273:4.4": "kataṃ buddhassa sāsanaṃ’’. ",
  "tha-ap273:5.1": "Itthaṃ sudaṃ āyasmā suvaṇṇabibbohaniyo thero imā gāthāyo abhāsitthāti. ",
  "tha-ap273:6.1": "Suvaṇṇabibbohaniyattherassāpadānaṃ paṭhamaṃ. "
}
