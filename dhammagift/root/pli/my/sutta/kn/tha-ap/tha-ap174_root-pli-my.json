  "tha-ap174:0.2": "",
  "tha-ap174:0.3": "9. 2. Nisseṇidāyakattheraapadānaṃ ",
  "tha-ap174:1.1": "‘‘Koṇḍaññassa bhagavato, ",
  "tha-ap174:1.2": "lokajeṭṭhassa tādino; ",
  "tha-ap174:1.3": "Ārohatthāya pāsādaṃ, ",
  "tha-ap174:1.4": "nisseṇī kāritā mayā. ",
  "tha-ap174:2.1": "10. ‘‘Tena cittappasādena, ",
  "tha-ap174:2.2": "anubhotvāna sampadā; ",
  "tha-ap174:2.3": "Dhāremi antimaṃ dehaṃ, ",
  "tha-ap174:2.4": "sammāsambuddhasāsane. ",
  "tha-ap174:3.1": "11. ‘‘Ekattiṃsamhi kappānaṃ, ",
  "tha-ap174:3.2": "sahassamhi tayo ahuṃ ; ",
  "tha-ap174:3.3": "Sambahulā nāma rājāno, ",
  "tha-ap174:3.4": "cakkavattī mahabbalā. ",
  "tha-ap174:4.1": "12. ‘‘Paṭisambhidā catasso…pe… ",
  "tha-ap174:4.2": "",
  "tha-ap174:4.3": "kataṃ buddhassa sāsanaṃ’’. ",
  "tha-ap174:5.1": "Itthaṃ sudaṃ āyasmā nisseṇidāyako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap174:6.1": "Nisseṇidāyakattherassāpadānaṃ dutiyaṃ. "
}
