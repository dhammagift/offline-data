  "tha-ap276:0.2": "",
  "tha-ap276:0.3": "4. Abbhañjanadāyakattheraapadānaṃ 14. ",
  "tha-ap276:1.1": "‘‘Koṇḍaññassa bhagavato, ",
  "tha-ap276:1.2": "vītarāgassa tādino; ",
  "tha-ap276:1.3": "Ākāsasamacittassa , ",
  "tha-ap276:1.4": "nippapañcassa jhāyino. ",
  "tha-ap276:2.1": "15. ‘‘Sabbamohātivattassa, ",
  "tha-ap276:2.2": "sabbalokahitesino; ",
  "tha-ap276:2.3": "Abbhañjanaṃ mayā dinnaṃ, ",
  "tha-ap276:2.4": "dvipadindassa tādino. ",
  "tha-ap276:3.1": "16. ‘‘Aparimeyye ito kappe, ",
  "tha-ap276:3.2": "abbhañjanamadaṃ tadā ; ",
  "tha-ap276:3.3": "Duggatiṃ nābhijānāmi, ",
  "tha-ap276:3.4": "abbhañjanassidaṃ phalaṃ. ",
  "tha-ap276:4.1": "17. ‘‘Ito pannarase kappe, ",
  "tha-ap276:4.2": "cirappo nāma khattiyo; ",
  "tha-ap276:4.3": "Sattaratanasampanno, ",
  "tha-ap276:4.4": "cakkavattī mahabbalo. ",
  "tha-ap276:5.1": "18. ‘‘Paṭisambhidā catasso ",
  "tha-ap276:5.2": "…pe… ",
  "tha-ap276:5.3": "kataṃ buddhassa sāsanaṃ’’. ",
  "tha-ap276:6.1": "Itthaṃ sudaṃ āyasmā abbhañjanadāyako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap276:7.1": "Abbhañjanadāyakattherassāpadānaṃ catutthaṃ. "
}
