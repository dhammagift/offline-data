  "tha-ap205:0.1": "",
  "tha-ap205:0.2": "",
  "tha-ap205:0.3": "10. 3. Kiṅkaṇipupphiyattheraapadānaṃ ",
  "tha-ap205:1.1": "‘‘Kañcanagghiyasaṅkāso, ",
  "tha-ap205:1.2": "sabbaññū lokanāyako; ",
  "tha-ap205:1.3": "Odakaṃ dahamoggayha, ",
  "tha-ap205:1.4": "sināyi lokanāyako. ",
  "tha-ap205:2.1": "11. ‘‘Paggayha kiṅkaṇiṃ pupphaṃ, ",
  "tha-ap205:2.2": "vipassissābhiropayiṃ; ",
  "tha-ap205:2.3": "Udaggacitto sumano, ",
  "tha-ap205:2.4": "dvipadindassa tādino. ",
  "tha-ap205:3.1": "12. ‘‘Ekanavutito kappe, ",
  "tha-ap205:3.2": "yaṃ pupphamabhiropayiṃ; ",
  "tha-ap205:3.3": "Duggatiṃ nābhijānāmi, ",
  "tha-ap205:3.4": "buddhapūjāyidaṃ phalaṃ. ",
  "tha-ap205:4.1": "13. ‘‘Sattavīsatikappamhi, ",
  "tha-ap205:4.2": "rājā bhīmaratho ahu; ",
  "tha-ap205:4.3": "Sattaratanasampanno, ",
  "tha-ap205:4.4": "cakkavattī mahabbalo. ",
  "tha-ap205:5.1": "14. ‘‘Paṭisambhidā catasso…pe… ",
  "tha-ap205:5.2": "",
  "tha-ap205:5.3": "kataṃ buddhassa sāsanaṃ’’. ",
  "tha-ap205:6.1": "Itthaṃ sudaṃ āyasmā kiṅkaṇipupphiyo thero imā gāthāyo abhāsitthāti. ",
  "tha-ap205:7.1": "Kiṅkaṇipupphiyattherassāpadānaṃ tatiyaṃ. "
}
