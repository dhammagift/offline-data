  "tha-ap159:0.3": "7. Tiṇasūlakattheraapadānaṃ 35. ",
  "tha-ap159:1.1": "‘‘Himavantassāvidūre, ",
  "tha-ap159:1.2": "bhūtagaṇo nāma pabbato; ",
  "tha-ap159:1.3": "Vasateko jino tattha, ",
  "tha-ap159:1.4": "sayambhū lokanissaṭo. ",
  "tha-ap159:2.1": "36. ‘‘Tiṇasūlaṃ gahetvāna, ",
  "tha-ap159:2.2": "buddhassa abhiropayiṃ; ",
  "tha-ap159:2.3": "Ekūnasatasahassaṃ, ",
  "tha-ap159:2.4": "kappaṃ na vinipātiko. ",
  "tha-ap159:3.1": "37. ‘‘Ito ekādase kappe, ",
  "tha-ap159:3.2": "ekosiṃ dharaṇīruho; ",
  "tha-ap159:3.3": "Sattaratanasampanno, ",
  "tha-ap159:3.4": "cakkavattī mahabbalo. ",
  "tha-ap159:4.1": "38. ‘‘Paṭisambhidā catasso ",
  "tha-ap159:4.2": "…pe… ",
  "tha-ap159:4.3": "kataṃ buddhassa sāsanaṃ’’. ",
  "tha-ap159:5.1": "Itthaṃ sudaṃ āyasmā tiṇasūlako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap159:6.1": "Tiṇasūlakattherassāpadānaṃ sattamaṃ. "
}
