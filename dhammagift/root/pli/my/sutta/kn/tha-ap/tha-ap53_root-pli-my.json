{
  "tha-ap53:0.1": "",
  "tha-ap53:0.2": "6. Bījanivaggo ",
  "tha-ap53:0.3": "1. 1. Vidhūpanadāyakattheraapadānaṃ ",
  "tha-ap53:1.1": "‘‘Padumuttarabuddhassa, ",
  "tha-ap53:1.2": "lokajeṭṭhassa tādino; ",
  "tha-ap53:1.3": "Bījanikā mayā dinnā, ",
  "tha-ap53:1.4": "dvipadindassa tādino. ",
  "tha-ap53:2.1": "2. ‘‘Sakaṃ cittaṃ pasādetvā, ",
  "tha-ap53:2.2": "paggahetvāna añjaliṃ; ",
  "tha-ap53:2.3": "Sambuddhamabhivādetvā, ",
  "tha-ap53:2.4": "pakkamiṃ uttarāmukho. ",
  "tha-ap53:3.1": "3. ‘‘Bījaniṃ paggahetvāna, ",
  "tha-ap53:3.2": "satthā lokagganāyako ; ",
  "tha-ap53:3.3": "Bhikkhusaṅghe ṭhito santo, ",
  "tha-ap53:3.4": "imā gāthā abhāsatha. ",
  "tha-ap53:4.1": "4. ‘‘‘Iminā bījanidānena, ",
  "tha-ap53:4.2": "cittassa paṇidhīhi ca; ",
  "tha-ap53:4.3": "Kappānaṃ satasahassaṃ, ",
  "tha-ap53:4.4": "vinipātaṃ na gacchati’. ",
  "tha-ap53:5.1": "5. ‘‘Āraddhavīriyo pahitatto, ",
  "tha-ap53:5.2": "cetoguṇasamāhito; ",
  "tha-ap53:5.3": "Jātiyā sattavassohaṃ, ",
  "tha-ap53:5.4": "arahattaṃ apāpuṇiṃ. ",
  "tha-ap53:6.1": "6. ‘‘Saṭṭhikappasahassamhi, ",
  "tha-ap53:6.2": "bījamānasanāmakā; ",
  "tha-ap53:6.3": "Soḷasāsiṃsu rājāno, ",
  "tha-ap53:6.4": "cakkavattī mahabbalā. ",
  "tha-ap53:7.1": "7. ‘‘Paṭisambhidā catasso, ",
  "tha-ap53:7.2": "vimokkhāpi ca aṭṭhime; ",
  "tha-ap53:7.3": "Chaḷabhiññā sacchikatā, ",
  "tha-ap53:7.4": "kataṃ buddhassa sāsanaṃ’’. ",
  "tha-ap53:8.1": "Itthaṃ sudaṃ āyasmā vidhūpanadāyako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap53:9.1": "Vidhūpanadāyakattherassāpadānaṃ paṭhamaṃ. "
}
