  "tha-ap124:0.1": "",
  "tha-ap124:0.2": "",
  "tha-ap124:0.3": "10. 2. Pupphathūpiyattheraapadānaṃ ",
  "tha-ap124:1.1": "‘‘Himavantassāvidūre, ",
  "tha-ap124:1.2": "kukkuro nāma pabbato; ",
  "tha-ap124:1.3": "Vemajjhe tassa vasati, ",
  "tha-ap124:1.4": "brāhmaṇo mantapāragū. ",
  "tha-ap124:2.1": "11. ‘‘Pañca sissasahassāni, ",
  "tha-ap124:2.2": "parivārenti maṃ sadā; ",
  "tha-ap124:2.3": "Pubbuṭṭhāyī ca te āsuṃ, ",
  "tha-ap124:2.4": "mantesu ca visāradā. ",
  "tha-ap124:3.1": "12. ‘‘Buddho loke samuppanno, ",
  "tha-ap124:3.2": "taṃ vijānātha no bhavaṃ; ",
  "tha-ap124:3.3": "Asītibyañjanānassa, ",
  "tha-ap124:3.4": "bāttiṃsavaralakkhaṇā. ",
  "tha-ap124:4.1": "13. ‘‘Byāmappabho jinavaro, ",
  "tha-ap124:4.2": "ādiccova virocati; ",
  "tha-ap124:4.3": "Sissānaṃ vacanaṃ sutvā, ",
  "tha-ap124:4.4": "brāhmaṇo mantapāragū. ",
  "tha-ap124:5.1": "14. ‘‘Assamā abhinikkhamma, ",
  "tha-ap124:5.2": "disaṃ pucchati sissake ; ",
  "tha-ap124:5.3": "Yamhi dese mahāvīro, ",
  "tha-ap124:5.4": "vasati lokanāyako. ",
  "tha-ap124:6.1": "15. ‘‘Tāhaṃ disaṃ namassissaṃ, ",
  "tha-ap124:6.2": "jinaṃ appaṭipuggalaṃ; ",
  "tha-ap124:6.3": "Udaggacitto sumano, ",
  "tha-ap124:6.4": "pūjesiṃ taṃ tathāgataṃ. ",
  "tha-ap124:7.1": "16. ‘‘Etha sissā gamissāma, ",
  "tha-ap124:7.2": "dakkhissāma tathāgataṃ; ",
  "tha-ap124:7.3": "Vanditvā satthuno pāde, ",
  "tha-ap124:7.4": "sossāma jinasāsanaṃ. ",
  "tha-ap124:8.1": "17. ‘‘Ekāhaṃ abhinikkhamma, ",
  "tha-ap124:8.2": "byādhiṃ paṭilabhiṃ ahaṃ; ",
  "tha-ap124:8.3": "Byādhinā pīḷito santo, ",
  "tha-ap124:8.4": "sālaṃ vāsayituṃ gamiṃ. ",
  "tha-ap124:9.1": "18. ‘‘Sabbe sisse samānetvā, ",
  "tha-ap124:9.2": "apucchiṃ te tathāgataṃ; ",
  "tha-ap124:9.3": "Kīdisaṃ lokanāthassa, ",
  "tha-ap124:9.4": "guṇaṃ paramabuddhino. ",
  "tha-ap124:10.1": "19. ‘‘Te me puṭṭhā viyākaṃsu, ",
  "tha-ap124:10.2": "yathā dassāvino tathā; ",
  "tha-ap124:10.3": "Sakkaccaṃ buddhaseṭṭhaṃ taṃ, ",
  "tha-ap124:10.4": "desesuṃ mama sammukhā. ",
  "tha-ap124:11.1": "20. ‘‘Tesāhaṃ vacanaṃ sutvā, ",
  "tha-ap124:11.2": "sakaṃ cittaṃ pasādayiṃ; ",
  "tha-ap124:11.3": "Pupphehi thūpaṃ katvāna, ",
  "tha-ap124:11.4": "tattha kālaṅkato ahaṃ. ",
  "tha-ap124:12.1": "21. ‘‘Te me sarīraṃ jhāpetvā, ",
  "tha-ap124:12.2": "agamuṃ buddhasantikaṃ; ",
  "tha-ap124:12.3": "Añjaliṃ paggahetvāna, ",
  "tha-ap124:12.4": "satthāramabhivādayuṃ. ",
  "tha-ap124:13.1": "22. ‘‘Pupphehi thūpaṃ katvāna, ",
  "tha-ap124:13.2": "sugatassa mahesino; ",
  "tha-ap124:13.3": "Kappānaṃ satasahassaṃ, ",
  "tha-ap124:13.4": "duggatiṃ nupapajjahaṃ. ",
  "tha-ap124:14.1": "23. ‘‘Cattālīsasahassamhi, ",
  "tha-ap124:14.2": "kappe soḷasa khattiyā; ",
  "tha-ap124:14.3": "Nāmenaggisamā nāma, ",
  "tha-ap124:14.4": "cakkavattī mahabbalā. ",
  "tha-ap124:15.1": "24. ‘‘Vīsakappasahassamhi, ",
  "tha-ap124:15.2": "rājāno cakkavattino; ",
  "tha-ap124:15.3": "Ghatāsanasanāmāva, ",
  "tha-ap124:15.4": "aṭṭhattiṃsa mahīpatī. ",
  "tha-ap124:16.1": "25. ‘‘Paṭisambhidā catasso…pe… ",
  "tha-ap124:16.2": "",
  "tha-ap124:16.3": "kataṃ buddhassa sāsanaṃ’’. ",
  "tha-ap124:17.1": "Itthaṃ sudaṃ āyasmā pupphathūpiyo thero imā gāthāyo abhāsitthāti. ",
  "tha-ap124:18.1": "Pupphathūpiyattherassāpadānaṃ dutiyaṃ. "
}
