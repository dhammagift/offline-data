  "vv47:0.3": "",
  "vv47:0.4": "795. 9. Pītavimānavatthu ",
  "vv47:1.1": "‘‘Pītavatthe pītadhaje, ",
  "vv47:1.2": "pītālaṅkārabhūsite; ",
  "vv47:1.3": "Pītacandanalittaṅge, ",
  "vv47:1.4": "pītauppalamālinī . ",
  "vv47:2.1": "796. ‘‘Pītapāsādasayane, ",
  "vv47:2.2": "pītāsane pītabhājane; ",
  "vv47:2.3": "Pītachatte pītarathe, ",
  "vv47:2.4": "pītasse pītabījane. ",
  "vv47:3.1": "797. ‘‘Kiṃ kammamakarī bhadde, ",
  "vv47:3.2": "pubbe mānusake bhave; ",
  "vv47:3.3": "Devate pucchitācikkha, ",
  "vv47:3.4": "kissa kammassidaṃ phala’’nti. ",
  "vv47:4.1": "798. ‘‘Kosātakī nāma latatthi bhante, ",
  "vv47:4.2": "tittikā anabhicchitā; ",
  "vv47:4.3": "Tassā cattāri pupphāni, ",
  "vv47:4.4": "thūpaṃ abhihariṃ ahaṃ. ",
  "vv47:5.1": "799. ‘‘Satthu sarīramuddissa, ",
  "vv47:5.2": "vippasannena cetasā; ",
  "vv47:5.3": "Nāssa maggaṃ avekkhissaṃ, ",
  "vv47:5.4": "na taggamanasā satī. ",
  "vv47:6.1": "800. ‘‘Tato maṃ avadhī gāvī, ",
  "vv47:6.2": "thūpaṃ apattamānasaṃ; ",
  "vv47:6.3": "Tañcāhaṃ abhisañceyyaṃ, ",
  "vv47:6.4": "bhiyyo nūna ito siyā. ",
  "vv47:7.1": "801. ‘‘Tena kammena devinda, ",
  "vv47:7.2": "maghavā devakuñjaro; ",
  "vv47:7.3": "Pahāya mānusaṃ dehaṃ, ",
  "vv47:7.4": "tava sahabya māgatā’’ti. ",
  "vv47:8.1": "802. Idaṃ sutvā tidasādhipati, ",
  "vv47:8.2": "maghavā devakuñjaro; ",
  "vv47:8.3": "Tāvatiṃse pasādento, ",
  "vv47:8.4": "mātaliṃ etadabravi . ",
  "vv47:9.1": "803. ‘‘Passa mātali accheraṃ, ",
  "vv47:9.2": "cittaṃ kammaphalaṃ idaṃ; ",
  "vv47:9.3": "Appakampi kataṃ deyyaṃ, ",
  "vv47:9.4": "puññaṃ hoti mahapphalaṃ. ",
  "vv47:10.1": "804. ‘‘Natthi citte pasannamhi, ",
  "vv47:10.2": "appakā nāma dakkhiṇā; ",
  "vv47:10.3": "Tathāgate vā sambuddhe, ",
  "vv47:10.4": "atha vā tassa sāvake. ",
  "vv47:11.1": "805. ‘‘Ehi mātali amhepi, ",
  "vv47:11.2": "bhiyyo bhiyyo mahemase; ",
  "vv47:11.3": "Tathāgatassa dhātuyo, ",
  "vv47:11.4": "sukho puññāna muccayo. ",
  "vv47:12.1": "806. ‘‘Tiṭṭhante nibbute cāpi, ",
  "vv47:12.2": "same citte samaṃ phalaṃ; ",
  "vv47:12.3": "Cetopaṇidhihetu hi, ",
  "vv47:12.4": "sattā gacchanti suggatiṃ. ",
  "vv47:13.1": "807. ‘‘Bahūnaṃ vata atthāya, ",
  "vv47:13.2": "uppajjanti tathāgatā; ",
  "vv47:13.3": "Yattha kāraṃ karitvāna, ",
  "vv47:13.4": "saggaṃ gacchanti dāyakā’’ti. ",
  "vv47:14.1": "Pītavimānaṃ navamaṃ. "
}
