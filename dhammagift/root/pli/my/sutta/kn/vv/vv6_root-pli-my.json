  "vv6:0.4": "6. Paṭhamanāvāvimānavatthu 43. ",
  "vv6:1.1": "‘‘Suvaṇṇacchadanaṃ nāvaṃ, ",
  "vv6:1.2": "nāri āruyha tiṭṭhasi; ",
  "vv6:1.3": "Ogāhasi pokkharaṇiṃ, ",
  "vv6:1.4": "padmaṃ chindasi pāṇinā. ",
  "vv6:2.1": "44. ‘‘Kena tetādiso vaṇṇo, ",
  "vv6:2.2": "kena te idha mijjhati; ",
  "vv6:2.3": "Uppajjanti ca te bhogā, ",
  "vv6:2.4": "ye keci manaso piyā. ",
  "vv6:3.1": "45. ‘‘Pucchāmi taṃ devi mahānubhāve, ",
  "vv6:3.2": "manussabhūtā kimakāsi puññaṃ; ",
  "vv6:3.3": "Kenāsi evaṃ jalitānubhāvā, ",
  "vv6:3.4": "vaṇṇo ca te sabbadisā pabhāsatī’’ti. ",
  "vv6:4.1": "46. Sā devatā attamanā, ",
  "vv6:4.2": "moggallānena pucchitā; ",
  "vv6:4.3": "Pañhaṃ puṭṭhā viyākāsi, ",
  "vv6:4.4": "yassa kammassidaṃ phalaṃ. ",
  "vv6:5.1": "47. ‘‘Ahaṃ manussesu manussabhūtā, ",
  "vv6:5.2": "purimāya jātiyā manussaloke; ",
  "vv6:5.3": "Disvāna bhikkhū tasite kilante, ",
  "vv6:5.4": "uṭṭhāya pātuṃ udakaṃ adāsiṃ. ",
  "vv6:6.1": "48. ‘‘Yo ve kilantāna pipāsitānaṃ, ",
  "vv6:6.2": "uṭṭhāya pātuṃ udakaṃ dadāti; ",
  "vv6:6.3": "Sītodakā tassa bhavanti najjo, ",
  "vv6:6.4": "pahūtamalyā bahupuṇḍarīkā. ",
  "vv6:7.1": "49. ‘‘Taṃ āpagā anupariyanti sabbadā, ",
  "vv6:7.2": "sītodakā vālukasanthatā nadī; ",
  "vv6:7.3": "Ambā ca sālā tilakā ca jambuyo, ",
  "vv6:7.4": "uddālakā pāṭaliyo ca phullā. ",
  "vv6:8.1": "50. ‘‘Taṃ bhūmibhāgehi upetarūpaṃ, ",
  "vv6:8.2": "vimānaseṭṭhaṃ bhusasobhamānaṃ; ",
  "vv6:8.3": "Tassīdha kammassa ayaṃ vipāko, ",
  "vv6:8.4": "etādisaṃ puññakatā labhanti. ",
  "vv6:9.1": "51. ‘‘Tena metādiso vaṇṇo, ",
  "vv6:9.2": "tena me idha mijjhati; ",
  "vv6:9.3": "Uppajjanti ca me bhogā, ",
  "vv6:9.4": "ye keci manaso piyā. ",
  "vv6:10.1": "52. ‘‘Akkhāmi te bhikkhu mahānubhāva, ",
  "vv6:10.2": "manussabhūtā yamakāsi puññaṃ; ",
  "vv6:10.3": "Tenamhi evaṃ jalitānubhāvā, ",
  "vv6:10.4": "vaṇṇo ca me sabbadisā pabhāsatī’’ti. ",
  "vv6:11.1": "Paṭhamanāvāvimānaṃ chaṭṭhaṃ. "
}
