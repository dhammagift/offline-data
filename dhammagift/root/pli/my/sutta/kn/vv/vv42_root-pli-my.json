  "vv42:0.3": "",
  "vv42:0.4": "711. 4. Alomavimānavatthu ",
  "vv42:1.1": "‘‘Abhikkantena vaṇṇena, ",
  "vv42:1.2": "yā tvaṃ tiṭṭhasi devate; ",
  "vv42:1.3": "Obhāsentī disā sabbā, ",
  "vv42:1.4": "osadhī viya tārakā. ",
  "vv42:2.1": "712. ‘‘Kena tetādiso vaṇṇo…pe… ",
  "vv42:2.2": "",
  "vv42:2.3": "Vaṇṇo ca te sabbadisā pabhāsatī’’ti. ",
  "vv42:3.1": "714. Sā devatā attamanā…pe… ",
  "vv42:3.2": "",
  "vv42:3.3": "yassa kammassidaṃ phalaṃ. ",
  "vv42:4.1": "715. ‘‘Ahañca bārāṇasiyaṃ, ",
  "vv42:4.2": "buddhassādiccabandhuno; ",
  "vv42:4.3": "Adāsiṃ sukkhakummāsaṃ, ",
  "vv42:4.4": "pasannā sehi pāṇibhi. ",
  "vv42:5.1": "716. ‘‘Sukkhāya aloṇikāya ca, ",
  "vv42:5.2": "passa phalaṃ kummāsapiṇḍiyā; ",
  "vv42:5.3": "Alomaṃ sukhitaṃ disvā, ",
  "vv42:5.4": "ko puññaṃ na karissati. ",
  "vv42:6.1": "717. ‘‘Tena metādiso vaṇṇo…pe… ",
  "vv42:6.2": "",
  "vv42:6.3": "vaṇṇo ca me sabbadisā pabhāsatī’’ti. ",
  "vv42:7.1": "Alomavimānaṃ catutthaṃ. "
}
