  "vv85:0.4": "11. Sunikkhittavimānavatthu 1282. ",
  "vv85:1.1": "‘‘Uccamidaṃ maṇithūṇaṃ vimānaṃ, ",
  "vv85:1.2": "samantato dvādasa yojanāni; ",
  "vv85:1.3": "Kūṭāgārā sattasatā uḷārā, ",
  "vv85:1.4": "veḷuriyathambhā rucakatthatā subhā. ",
  "vv85:2.1": "1283. ‘‘Tatthacchasi pivasi khādasi ca, ",
  "vv85:2.2": "dibbā ca vīṇā pavadanti vagguṃ; ",
  "vv85:2.3": "Dibbā rasā kāmaguṇettha pañca, ",
  "vv85:2.4": "nāriyo ca naccanti suvaṇṇachannā. ",
  "vv85:3.1": "1284. ‘‘Kena tetādiso vaṇṇo, ",
  "vv85:3.2": "kena te idha mijjhati; ",
  "vv85:3.3": "Uppajjanti ca te bhogā, ",
  "vv85:3.4": "ye keci manaso piyā. ",
  "vv85:4.1": "1285. ‘‘Pucchāmi ‘taṃ deva mahānubhāva, ",
  "vv85:4.2": "manussabhūto kimakāsi puññaṃ; ",
  "vv85:4.3": "Kenāsi evaṃ jalitānubhāvo, ",
  "vv85:4.4": "vaṇṇo ca te sabbadisā pabhāsatī’’ti. ",
  "vv85:5.1": "1286. So devaputto attamano, ",
  "vv85:5.2": "moggallānena pucchito; ",
  "vv85:5.3": "Pañhaṃ puṭṭho viyākāsi, ",
  "vv85:5.4": "yassa kammassidaṃ phalaṃ. ",
  "vv85:6.1": "1287. ‘‘Dunnikkhittaṃ mālaṃ sunikkhipitvā, ",
  "vv85:6.2": "patiṭṭhapetvā sugatassa thūpe; ",
  "vv85:6.3": "Mahiddhiko camhi mahānubhāvo, ",
  "vv85:6.4": "dibbehi kāmehi samaṅgibhūto. ",
  "vv85:7.1": "1288. ‘‘Tena metādiso vaṇṇo, ",
  "vv85:7.2": "Tena me idha mijjhati; ",
  "vv85:7.3": "Uppajjanti ca me bhogā, ",
  "vv85:7.4": "Ye keci manaso piyā. ",
  "vv85:8.1": "1289. ‘‘Akkhāmi te bhikkhu mahānubhāva, ",
  "vv85:8.2": "Manussabhūto yamahaṃ akāsiṃ; ",
  "vv85:8.3": "Tenamhi evaṃ jalitānubhāvo, ",
  "vv85:8.4": "Vaṇṇo ca me sabbadisā pabhāsatī’’ti. ",
  "vv85:9.1": "Sunikkhittavimānaṃ ekādasamaṃ. ",
  "vv85:9.2": "Sunikkhittavaggo sattamo niṭṭhito. ",
  "vv85:10.1": "Tassuddānaṃ – ",
  "vv85:11.1": "Dve daliddā vanavihārā, ",
  "vv85:11.2": "bhatako gopālakaṇḍakā; ",
  "vv85:11.3": "Anekavaṇṇamaṭṭhakuṇḍalī, ",
  "vv85:11.4": "serīsako sunikkhittaṃ; ",
  "vv85:11.5": "Purisānaṃ tatiyo vaggo pavuccatīti. ",
  "vv85:12.1": "Bhāṇavāraṃ catutthaṃ niṭṭhitaṃ. ",
  "vv85:13.1": "Vimānavatthupāḷi niṭṭhitā. "
}
