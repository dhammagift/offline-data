  "vv43:0.4": "5. Kañjikadāyikāvimānavatthu 719. ",
  "vv43:1.1": "‘‘Abhikkantena vaṇṇena ",
  "vv43:1.2": "…pe… ",
  "vv43:1.3": "osadhī viya tārakā. ",
  "vv43:2.1": "720. ‘‘Kena tetādiso vaṇṇo ",
  "vv43:2.2": "…pe… ",
  "vv43:2.3": "vaṇṇo ca me sabbadisā pabhāsatī’’ti. ",
  "vv43:3.1": "722. Sā devatā attamanā ",
  "vv43:3.2": "…pe… ",
  "vv43:3.3": "yassa kammassidaṃ phalaṃ. ",
  "vv43:4.1": "723. ‘‘Ahaṃ andhakavindamhi, ",
  "vv43:4.2": "buddhassādiccabandhuno; ",
  "vv43:4.3": "Adāsiṃ kolasampākaṃ, ",
  "vv43:4.4": "kañjikaṃ teladhūpitaṃ. ",
  "vv43:5.1": "724. ‘‘Pipphalyā lasuṇena ca, ",
  "vv43:5.2": "missaṃ lāmañjakena ca; ",
  "vv43:5.3": "Adāsiṃ ujubhūtasmiṃ , ",
  "vv43:5.4": "vippasannena cetasā. ",
  "vv43:6.1": "725. ‘‘Yā mahesittaṃ kāreyya, ",
  "vv43:6.2": "cakkavattissa rājino; ",
  "vv43:6.3": "Nārī sabbaṅgakalyāṇī, ",
  "vv43:6.4": "bhattu cānomadassikā; ",
  "vv43:6.5": "Ekassa kañjikadānassa, ",
  "vv43:6.6": "kalaṃ nāgghati soḷasiṃ. ",
  "vv43:7.1": "726. ‘‘Sataṃ nikkhā sataṃ assā, ",
  "vv43:7.2": "sataṃ assatarīrathā; ",
  "vv43:7.3": "Sataṃ kaññāsahassāni, ",
  "vv43:7.4": "āmuttamaṇikuṇḍalā; ",
  "vv43:7.5": "Ekassa kañjikadānassa, ",
  "vv43:7.6": "kalaṃ nāgghanti soḷasiṃ. ",
  "vv43:8.1": "727. ‘‘Sataṃ hemavatā nāgā, ",
  "vv43:8.2": "īsādantā urūḷhavā; ",
  "vv43:8.3": "Suvaṇṇakacchā mātaṅgā, ",
  "vv43:8.4": "hemakappanavāsasā; ",
  "vv43:8.5": "Ekassa kañjikadānassa, ",
  "vv43:8.6": "kalaṃ nāgghanti soḷasiṃ. ",
  "vv43:9.1": "728. ‘‘Catunnamapi dīpānaṃ, ",
  "vv43:9.2": "issaraṃ yodha kāraye; ",
  "vv43:9.3": "Ekassa kañjikadānassa, ",
  "vv43:9.4": "kalaṃ nāgghati soḷasi’’nti. ",
  "vv43:10.1": "Kañjikadāyikāvimānaṃ pañcamaṃ. "
}
