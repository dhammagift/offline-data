  "vv14:0.4": "14. Dutiyasuṇisāvimānavatthu 116. ",
  "vv14:1.1": "‘‘Abhikkantena vaṇṇena, ",
  "vv14:1.2": "yā tvaṃ tiṭṭhasi devate; ",
  "vv14:1.3": "Obhāsentī disā sabbā, ",
  "vv14:1.4": "osadhī viya tārakā. ",
  "vv14:2.1": "117. ‘‘Kena tetādiso vaṇṇo, ",
  "vv14:2.2": "kena te idha mijjhati; ",
  "vv14:2.3": "Uppajjanti ca te bhogā, ",
  "vv14:2.4": "ye keci manaso piyā. ",
  "vv14:3.1": "118. ‘‘Pucchāmi taṃ devi mahānubhāve, ",
  "vv14:3.2": "manussabhūtā kimakāsi puññaṃ; ",
  "vv14:3.3": "Kenāsi evaṃ jalitānubhāvā, ",
  "vv14:3.4": "vaṇṇo ca te sabbadisā pabhāsatī’’ti. ",
  "vv14:4.1": "119. Sā devatā attamanā, ",
  "vv14:4.2": "moggallānena pucchitā; ",
  "vv14:4.3": "Pañhaṃ puṭṭhā viyākāsi, ",
  "vv14:4.4": "yassa kammassidaṃ phalaṃ. ",
  "vv14:5.1": "120. ‘‘Ahaṃ manussesu manussabhūtā, ",
  "vv14:5.2": "suṇisā ahosiṃ sasurassa gehe. ",
  "vv14:6.1": "121. ‘‘Addasaṃ virajaṃ bhikkhuṃ, ",
  "vv14:6.2": "vippasannamanāvilaṃ; ",
  "vv14:6.3": "Tassa adāsahaṃ bhāgaṃ, ",
  "vv14:6.4": "pasannā sehi pāṇibhi; ",
  "vv14:6.5": "Kummāsapiṇḍaṃ datvāna, ",
  "vv14:6.6": "modāmi nandane vane. ",
  "vv14:7.1": "122. ‘‘Tena metādiso vaṇṇo, ",
  "vv14:7.2": "tena me idha mijjhati; ",
  "vv14:7.3": "Uppajjanti ca me bhogā, ",
  "vv14:7.4": "ye keci manaso piyā. ",
  "vv14:8.1": "123. ‘‘Akkhāmi te bhikkhu mahānubhāva, ",
  "vv14:8.2": "manussabhūtā yamakāsi puññaṃ; ",
  "vv14:8.3": "Tenamhi evaṃ jalitānubhāvā, ",
  "vv14:8.4": "vaṇṇo ca me sabbadisā pabhāsatī’’ti. ",
  "vv14:9.1": "Dutiyasuṇisāvimānaṃ cuddasamaṃ. "
}
