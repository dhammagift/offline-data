  "vv9:0.4": "75. 9. Dīpavimānavatthu ",
  "vv9:1.1": "‘‘Abhikkantena vaṇṇena, ",
  "vv9:1.2": "yā tvaṃ tiṭṭhasi devate; ",
  "vv9:1.3": "Obhāsentī disā sabbā, ",
  "vv9:1.4": "osadhī viya tārakā. ",
  "vv9:2.1": "76. ‘‘Kena tetādiso vaṇṇo, ",
  "vv9:2.2": "kena te idha mijjhati; ",
  "vv9:2.3": "Uppajjanti ca te bhogā, ",
  "vv9:2.4": "ye keci manaso piyā. ",
  "vv9:3.1": "77. ‘‘Kena tvaṃ vimalobhāsā, ",
  "vv9:3.2": "atirocasi devatā ; ",
  "vv9:3.3": "Kena te sabbagattehi, ",
  "vv9:3.4": "sabbā obhāsate disā. ",
  "vv9:4.1": "78. ‘‘Pucchāmi taṃ devi mahānubhāve, ",
  "vv9:4.2": "manussabhūtā kimakāsi puññaṃ; ",
  "vv9:4.3": "Kenāsi evaṃ jalitānubhāvā, ",
  "vv9:4.4": "vaṇṇo ca te sabbadisā pabhāsatī’’ti. ",
  "vv9:5.1": "79. Sā devatā attamanā, ",
  "vv9:5.2": "moggallānena pucchitā; ",
  "vv9:5.3": "Pañhaṃ puṭṭhā viyākāsi, ",
  "vv9:5.4": "yassa kammassidaṃ phalaṃ. ",
  "vv9:6.1": "80. ‘‘Ahaṃ manussesu manussabhūtā, ",
  "vv9:6.2": "purimāya jātiyā manussaloke; ",
  "vv9:6.3": "Tamandhakāramhi timīsikāyaṃ, ",
  "vv9:6.4": "padīpakālamhi adāsi dīpaṃ . ",
  "vv9:7.1": "81. ‘‘Yo andhakāramhi timīsikāyaṃ, ",
  "vv9:7.2": "padīpakālamhi dadāti dīpaṃ; ",
  "vv9:7.3": "Uppajjati jotirasaṃ vimānaṃ, ",
  "vv9:7.4": "pahūtamalyaṃ bahupuṇḍarīkaṃ. ",
  "vv9:8.1": "82. ‘‘Tena metādiso vaṇṇo, ",
  "vv9:8.2": "tena me idha mijjhati; ",
  "vv9:8.3": "Uppajjanti ca me bhogā, ",
  "vv9:8.4": "ye keci manaso piyā. ",
  "vv9:9.1": "83. ‘‘Tenāhaṃ vimalobhāsā, ",
  "vv9:9.2": "atirocāmi devatā; ",
  "vv9:9.3": "Tena me sabbagattehi, ",
  "vv9:9.4": "sabbā obhāsate disā. ",
  "vv9:10.1": "84. ‘‘Akkhāmi te bhikkhu mahānubhāva, ",
  "vv9:10.2": "manussabhūtā yamakāsi puññaṃ; ",
  "vv9:10.3": "Tenamhi evaṃ jalitānubhāvā, ",
  "vv9:10.4": "vaṇṇo ca me sabbadisā pabhāsatī’’ti. ",
  "vv9:11.1": "Dīpavimānaṃ navamaṃ. "
}
