  "vv73:0.4": "9. Dutiyakuṇḍalīvimānavatthu 1101. ",
  "vv73:1.1": "‘‘Alaṅkato malyadharo suvattho, ",
  "vv73:1.2": "sukuṇḍalī kappitakesamassu; ",
  "vv73:1.3": "Āmuttahatthābharaṇo yasassī, ",
  "vv73:1.4": "dibbe vimānamhi yathāpi candimā. ",
  "vv73:2.1": "1102. ‘‘Dibbā ca vīṇā pavadanti vagguṃ, ",
  "vv73:2.2": "aṭṭhaṭṭhakā sikkhitā sādhurūpā; ",
  "vv73:2.3": "Dibbā ca kaññā tidasacarā uḷārā, ",
  "vv73:2.4": "naccanti gāyanti pamodayanti. ",
  "vv73:3.1": "1103. ‘‘Deviddhipattosi mahānubhāvo, ",
  "vv73:3.2": "manussabhūto kimakāsi puññaṃ; ",
  "vv73:3.3": "Kenāsi evaṃ jalitānubhāvo, ",
  "vv73:3.4": "vaṇṇo ca te sabbadisā pabhāsatī’’ti. ",
  "vv73:4.1": "1104. So devaputto attamano ",
  "vv73:4.2": "…pe… ",
  "vv73:4.3": "yassa kammassidaṃ phalaṃ. ",
  "vv73:5.1": "1105. ‘‘Ahaṃ manussesu manussabhūto, ",
  "vv73:5.2": "disvāna samaṇe sādhurūpe ; ",
  "vv73:5.3": "Sampannavijjācaraṇe yasassī, ",
  "vv73:5.4": "bahussute sīlavante pasanne ; ",
  "vv73:5.5": "Annañca pānañca pasannacitto, ",
  "vv73:5.6": "sakkacca dānaṃ vipulaṃ adāsiṃ. ",
  "vv73:6.1": "1106. ‘‘Tena metādiso vaṇṇo ",
  "vv73:6.2": "…pe… ",
  "vv73:6.3": "vaṇṇo ca me sabbadisā pabhāsatī’’ti. ",
  "vv73:7.1": "Dutiyakuṇḍalīvimānaṃ navamaṃ. "
}
