  "vv64:0.3": "",
  "vv64:0.4": "14. Mahārathavimānavatthu 1015. ",
  "vv64:1.1": "‘‘Sahassayuttaṃ hayavāhanaṃ subhaṃ, ",
  "vv64:1.2": "āruyhimaṃ sandanaṃ nekacittaṃ; ",
  "vv64:1.3": "Uyyānabhūmiṃ abhito anukkamaṃ, ",
  "vv64:1.4": "purindado bhūtapatīva vāsavo. ",
  "vv64:2.1": "1016. ‘‘Sovaṇṇamayā te rathakubbarā ubho, ",
  "vv64:2.2": "phalehi aṃsehi atīva saṅgatā; ",
  "vv64:2.3": "Sujātagumbā naravīraniṭṭhitā, ",
  "vv64:2.4": "virocatī pannaraseva cando. ",
  "vv64:3.1": "1017. ‘‘Suvaṇṇajālāvatato ratho ayaṃ, ",
  "vv64:3.2": "bahūhi nānāratanehi cittito; ",
  "vv64:3.3": "Sunandighoso ca subhassaro ca, ",
  "vv64:3.4": "virocatī cāmarahatthabāhubhi. ",
  "vv64:4.1": "1018. ‘‘Imā ca nābhyo manasābhinimmitā, ",
  "vv64:4.2": "rathassa pādantaramajjhabhūsitā; ",
  "vv64:4.3": "Imā ca nābhyo satarājicittitā, ",
  "vv64:4.4": "sateratā vijjurivappabhāsare. ",
  "vv64:5.1": "1019. ‘‘Anekacittāvatato ratho ayaṃ, ",
  "vv64:5.2": "puthū ca nemī ca sahassaraṃsiko; ",
  "vv64:5.3": "Tesaṃ saro suyyati vaggurūpo, ",
  "vv64:5.4": "pañcaṅgikaṃ turiyamivappavāditaṃ. ",
  "vv64:6.1": "1020. ‘‘Sirasmiṃ cittaṃ maṇicandakappitaṃ, ",
  "vv64:6.2": "sadā visuddhaṃ ruciraṃ pabhassaraṃ; ",
  "vv64:6.3": "Suvaṇṇarājīhi atīva saṅgataṃ, ",
  "vv64:6.4": "veḷuriyarājīva atīva sobhati. ",
  "vv64:7.1": "1021. ‘‘Ime ca vāḷī maṇicandakappitā, ",
  "vv64:7.2": "ārohakambū sujavā brahūpamā. ",
  "vv64:7.3": "Brahā mahantā balino mahājavā, ",
  "vv64:7.4": "mano tavaññāya tatheva siṃsare . ",
  "vv64:8.1": "1022. ‘‘Ime ca sabbe sahitā catukkamā, ",
  "vv64:8.2": "mano tavaññāya tatheva siṃsare; ",
  "vv64:8.3": "Samaṃ vahantā mudukā anuddhatā, ",
  "vv64:8.4": "āmodamānā turagāna muttamā. ",
  "vv64:9.1": "1023. ‘‘Dhunanti vagganti patanti cambare, ",
  "vv64:9.2": "abbhuddhunantā sukate piḷandhane; ",
  "vv64:9.3": "Tesaṃ saro suyyati vaggurūpo, ",
  "vv64:9.4": "pañcaṅgikaṃ turiyamivappavāditaṃ. ",
  "vv64:10.1": "1024. ‘‘Rathassa ghoso apiḷandhanāna ca, ",
  "vv64:10.2": "khurassa nādo abhihiṃsanāya ca; ",
  "vv64:10.3": "Ghoso suvaggū samitassa suyyati, ",
  "vv64:10.4": "gandhabbatūriyāni vicitrasaṃvane. ",
  "vv64:11.1": "1025. ‘‘Rathe ṭhitā tā migamandalocanā, ",
  "vv64:11.2": "āḷārapamhā hasitā piyaṃvadā; ",
  "vv64:11.3": "Veḷuriyajālāvatatā tanucchavā, ",
  "vv64:11.4": "sadeva gandhabbasūraggapūjitā. ",
  "vv64:12.1": "1026. ‘‘Tā rattarattambarapītavāsasā, ",
  "vv64:12.2": "visālanettā abhirattalocanā; ",
  "vv64:12.3": "Kule sujātā sutanū sucimhitā, ",
  "vv64:12.4": "rathe ṭhitā pañjalikā upaṭṭhitā. ",
  "vv64:13.1": "1027. ‘‘Tā kambukeyūradharā suvāsasā, ",
  "vv64:13.2": "sumajjhimā ūruthanūpapannā; ",
  "vv64:13.3": "Vaṭṭaṅguliyo sumukhā sudassanā, ",
  "vv64:13.4": "rathe ṭhitā pañjalikā upaṭṭhitā. ",
  "vv64:14.1": "1028. ‘‘Aññā suveṇī susu missakesiyo, ",
  "vv64:14.2": "samaṃ vibhattāhi pabhassarāhi ca; ",
  "vv64:14.3": "Anubbatā tā tava mānase ratā, ",
  "vv64:14.4": "rathe ṭhitā pañjalikā upaṭṭhitā. ",
  "vv64:15.1": "1029. ‘‘Āveḷiniyo padumuppalacchadā, ",
  "vv64:15.2": "alaṅkatā candanasāravāsitā ; ",
  "vv64:15.3": "Anubbatā tā tava mānase ratā, ",
  "vv64:15.4": "rathe ṭhitā pañjalikā upaṭṭhitā. ",
  "vv64:16.1": "1030. ‘‘Tā māliniyo padumuppalacchadā, ",
  "vv64:16.2": "alaṅkatā candanasāravāsitā; ",
  "vv64:16.3": "Anubbatā tā tava mānase ratā, ",
  "vv64:16.4": "rathe ṭhitā pañjalikā upaṭṭhitā. ",
  "vv64:17.1": "1031. ‘‘Kaṇṭhesu te yāni piḷandhanāni, ",
  "vv64:17.2": "hatthesu pādesu tatheva sīse; ",
  "vv64:17.3": "Obhāsayantī dasa sabbaso disā, ",
  "vv64:17.4": "abbhuddayaṃ sāradikova bhāṇumā. ",
  "vv64:18.1": "1032. ‘‘Vātassa vegena ca sampakampitā, ",
  "vv64:18.2": "bhujesu mālā apiḷandhanāni ca; ",
  "vv64:18.3": "Muñcanti ghosaṃ rūciraṃ suciṃ subhaṃ, ",
  "vv64:18.4": "sabbehi viññūhi sutabbarūpaṃ. ",
  "vv64:19.1": "1033. ‘‘Uyyānabhūmyā ca duvaddhato ṭhitā, ",
  "vv64:19.2": "rathā ca nāgā tūriyāni ca saro; ",
  "vv64:19.3": "Tameva devinda pamodayanti, ",
  "vv64:19.4": "vīṇā yathā pokkharapattabāhubhi. ",
  "vv64:20.1": "1034. ‘‘Imāsu vīṇāsu bahūsu vaggūsu, ",
  "vv64:20.2": "manuññarūpāsu hadayeritaṃ pītiṃ ; ",
  "vv64:20.3": "Pavajjamānāsu atīva accharā, ",
  "vv64:20.4": "bhamanti kaññā padumesu sikkhitā. ",
  "vv64:21.1": "1035. ‘‘Yadā ca gītāni ca vāditāni ca, ",
  "vv64:21.2": "naccāni cimāni samenti ekato; ",
  "vv64:21.3": "Athettha naccanti athettha accharā, ",
  "vv64:21.4": "obhāsayantī ubhato varitthiyo. ",
  "vv64:22.1": "1036. ‘‘So modasi turiyagaṇappabodhano, ",
  "vv64:22.2": "mahīyamāno vajirāvudhoriva; ",
  "vv64:22.3": "Imāsu vīṇāsu bahūsu vaggūsu, ",
  "vv64:22.4": "manuññarūpāsu hadayeritaṃ pītiṃ. ",
  "vv64:23.1": "1037. ‘‘Kiṃ tvaṃ pure kammamakāsi attanā, ",
  "vv64:23.2": "manussabhūto purimāya jātiyā; ",
  "vv64:23.3": "Uposathaṃ kaṃ vā tuvaṃ upāvasi, ",
  "vv64:23.4": "kaṃ dhammacariyaṃ vatamābhirocayi. ",
  "vv64:24.1": "1038. ‘‘Nayīdamappassa katassa kammuno, ",
  "vv64:24.2": "pubbe suciṇṇassa uposathassa vā; ",
  "vv64:24.3": "Iddhānubhāvo vipulo ayaṃ tava, ",
  "vv64:24.4": "yaṃ devasaṅghaṃ abhirocase bhusaṃ. ",
  "vv64:25.1": "1039. ‘‘Dānassa te idaṃ phalaṃ, ",
  "vv64:25.2": "atho sīlassa vā pana; ",
  "vv64:25.3": "Atho añjalikammassa, ",
  "vv64:25.4": "taṃ me akkhāhi pucchito’’ti. ",
  "vv64:26.1": "1040. So devaputto attamano, ",
  "vv64:26.2": "moggallānena pucchito; ",
  "vv64:26.3": "Pañhaṃ puṭṭho viyākāsi, ",
  "vv64:26.4": "yassa kammassidaṃ phalanti. ",
  "vv64:27.1": "1041. ‘‘Jitindriyaṃ buddhamanomanikkamaṃ, ",
  "vv64:27.2": "naruttamaṃ kassapamaggapuggalaṃ; ",
  "vv64:27.3": "Avāpurantaṃ amatassa dvāraṃ, ",
  "vv64:27.4": "devātidevaṃ satapuññalakkhaṇaṃ. ",
  "vv64:28.1": "1042. ‘‘Tamaddasaṃ kuñjaramoghatiṇṇaṃ, ",
  "vv64:28.2": "suvaṇṇasiṅgīnadabimbasādisaṃ; ",
  "vv64:28.3": "Disvāna taṃ khippamahuṃ sucīmano, ",
  "vv64:28.4": "tameva disvāna subhāsitaddhajaṃ. ",
  "vv64:29.1": "1043. ‘‘Tamannapānaṃ athavāpi cīvaraṃ, ",
  "vv64:29.2": "suciṃ paṇītaṃ rasasā upetaṃ; ",
  "vv64:29.3": "Pupphābhikkiṇamhi sake nivesane, ",
  "vv64:29.4": "patiṭṭhapesiṃ sa asaṅgamānaso. ",
  "vv64:30.1": "1044. ‘‘Tamannapānena ca cīvarena ca, ",
  "vv64:30.2": "khajjena bhojjena ca sāyanena ca; ",
  "vv64:30.3": "Santappayitvā dvipadānamuttamaṃ, ",
  "vv64:30.4": "so saggaso devapure ramāmahaṃ. ",
  "vv64:31.1": "1045. ‘‘Etenupāyena imaṃ niraggaḷaṃ, ",
  "vv64:31.2": "yaññaṃ yajitvā tividhaṃ visuddhaṃ. ",
  "vv64:31.3": "Pahāyahaṃ mānusakaṃ samussayaṃ, ",
  "vv64:31.4": "indūpamo devapure ramāmahaṃ. ",
  "vv64:32.1": "1046. ‘‘Āyuñca vaṇṇañca sukhaṃ balañca, ",
  "vv64:32.2": "paṇītarūpaṃ abhikaṅkhatā muni; ",
  "vv64:32.3": "Annañca pānañca bahuṃ susaṅkhataṃ, ",
  "vv64:32.4": "patiṭṭhapetabbamasaṅgamānase. ",
  "vv64:33.1": "1047. ‘‘Nayimasmiṃ loke parasmiṃ vā pana, ",
  "vv64:33.2": "buddhena seṭṭho va samo va vijjati; ",
  "vv64:33.3": "Āhuneyyānaṃ paramāhutiṃ gato, ",
  "vv64:33.4": "puññatthikānaṃ vipulapphalesina’’nti. ",
  "vv64:34.1": "Mahārathavimānaṃ cuddasamaṃ. ",
  "vv64:34.2": "Mahārathavaggo pañcamo niṭṭhito. ",
  "vv64:35.1": "Tassuddānaṃ – ",
  "vv64:36.1": "Maṇḍūko revatī chatto, ",
  "vv64:36.2": "kakkaṭo dvārapālako; ",
  "vv64:36.3": "Dve karaṇīyā dve sūci, ",
  "vv64:36.4": "tayo nāgā ca dve rathā; ",
  "vv64:36.5": "Purisānaṃ paṭhamo vaggo pavuccatīti. ",
  "vv64:37.1": "Bhāṇavāraṃ tatiyaṃ niṭṭhitaṃ. "
}
