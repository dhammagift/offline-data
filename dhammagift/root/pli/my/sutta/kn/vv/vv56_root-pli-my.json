  "vv56:0.4": "926. 6. Paṭhamakaraṇīyavimānavatthu ",
  "vv56:1.1": "‘‘Uccamidaṃ maṇithūṇaṃ vimānaṃ, ",
  "vv56:1.2": "samantato dvādasa yojanāni; ",
  "vv56:1.3": "Kūṭāgārā sattasatā uḷārā, ",
  "vv56:1.4": "veḷuriyathambhā rucakatthatā subhā. ",
  "vv56:2.1": "927. ‘‘Tatthacchasi pivasi khādasi ca, ",
  "vv56:2.2": "dibbā ca vīṇā pavadanti vagguṃ; ",
  "vv56:2.3": "Dibbā rasā kāmaguṇettha pañca, ",
  "vv56:2.4": "nāriyo ca naccanti suvaṇṇachannā. ",
  "vv56:3.1": "928. ‘‘Kena tetādiso vaṇṇo…pe… ",
  "vv56:3.2": "",
  "vv56:3.3": "Vaṇṇo ca te sabbadisā pabhāsatī’’ti. ",
  "vv56:4.1": "930. So devaputto attamano…pe…yassa ",
  "vv56:4.2": "",
  "vv56:4.3": "kammassidaṃ phalaṃ. ",
  "vv56:5.1": "931. ‘‘Karaṇīyāni puññāni, ",
  "vv56:5.2": "paṇḍitena vijānatā; ",
  "vv56:5.3": "Sammaggatesu buddhesu, ",
  "vv56:5.4": "yattha dinnaṃ mahapphalaṃ. ",
  "vv56:6.1": "932. ‘‘Atthāya vata me buddho, ",
  "vv56:6.2": "araññā gāmamāgato; ",
  "vv56:6.3": "Tattha cittaṃ pasādetvā, ",
  "vv56:6.4": "tāvatiṃsūpago ahaṃ . ",
  "vv56:7.1": "933. ‘‘Tena metādiso vaṇṇo…pe…vaṇṇo ",
  "vv56:7.2": "",
  "vv56:7.3": "ca me sabbadisā pabhāsatī’’ti. ",
  "vv56:8.1": "Paṭhamakaraṇīyavimānaṃ chaṭṭhaṃ. "
}
