  "vv74:0.4": "10. (Uttara) pāyāsivimānavatthu 1108. ",
  "vv74:1.1": "‘‘Yā devarājassa sabhā sudhammā, ",
  "vv74:1.2": "yatthacchati devasaṅgho samaggo; ",
  "vv74:1.3": "Tathūpamaṃ tuyhamidaṃ vimānaṃ, ",
  "vv74:1.4": "obhāsayaṃ tiṭṭhati antalikkhe. ",
  "vv74:2.1": "1109. ‘‘Deviddhipattosi mahānubhāvo, ",
  "vv74:2.2": "manussabhūto kimakāsi puññaṃ; ",
  "vv74:2.3": "Kenāsi evaṃ jalitānubhāvo, ",
  "vv74:2.4": "vaṇṇo ca te sabbadisā pabhāsatī’’ti. ",
  "vv74:3.1": "1110. So devaputto attamano ",
  "vv74:3.2": "…pe… ",
  "vv74:3.3": "yassa kammassidaṃ phalaṃ. ",
  "vv74:4.1": "1111. ‘‘Ahaṃ manussesu manussabhūto, ",
  "vv74:4.2": "rañño pāyāsissa ahosiṃ māṇavo; ",
  "vv74:4.3": "Laddhā dhanaṃ saṃvibhāgaṃ akāsiṃ, ",
  "vv74:4.4": "piyā ca me sīlavanto ahesuṃ; ",
  "vv74:4.5": "Annañca pānañca pasannacitto, ",
  "vv74:4.6": "sakkacca dānaṃ vipulaṃ adāsiṃ. ",
  "vv74:5.1": "1112. ‘‘Tena metādiso vaṇṇo…pe. ",
  "vv74:5.2": "",
  "vv74:5.3": "…vaṇṇo ca me sabbadisā pabhāsatī’’ti. (Uttara) ",
  "vv74:6.1": "pāyāsivimānaṃ dasamaṃ. ",
  "vv74:7.1": "Pāyāsivaggo chaṭṭho niṭṭhito. ",
  "vv74:8.1": "Tassuddānaṃ – ",
  "vv74:9.1": "Dve agārino phaladāyī, ",
  "vv74:9.2": "dve upassayadāyī bhikkhāya dāyī; ",
  "vv74:9.3": "Yavapālako ceva dve, ",
  "vv74:9.4": "kuṇḍalino pāyāsīti ; ",
  "vv74:10.1": "Purisānaṃ dutiyo vaggo pavuccatīti. "
}
