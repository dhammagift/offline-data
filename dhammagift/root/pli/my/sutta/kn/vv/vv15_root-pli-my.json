  "vv15:0.4": "15. Uttarāvimānavatthu 124. ",
  "vv15:1.1": "‘‘Abhikkantena vaṇṇena, ",
  "vv15:1.2": "yā tvaṃ tiṭṭhasi devate; ",
  "vv15:1.3": "Obhāsentī disā sabbā, ",
  "vv15:1.4": "osadhī viya tārakā. ",
  "vv15:2.1": "125. ‘‘Kena tetādiso vaṇṇo, ",
  "vv15:2.2": "kena te idha mijjhati; ",
  "vv15:2.3": "Uppajjanti ca te bhogā, ",
  "vv15:2.4": "ye keci manaso piyā. ",
  "vv15:3.1": "126. ‘‘Pucchāmi taṃ devi mahānubhāve, ",
  "vv15:3.2": "manussabhūtā kimakāsi puññaṃ; ",
  "vv15:3.3": "Kenāsi evaṃ jalitānubhāvā, ",
  "vv15:3.4": "vaṇṇo ca te sabbadisā pabhāsatī’’ti. ",
  "vv15:4.1": "127. Sā devatā attamanā, ",
  "vv15:4.2": "moggallānena pucchitā; ",
  "vv15:4.3": "Pañhaṃ puṭṭhā viyākāsi, ",
  "vv15:4.4": "yassa kammassidaṃ phalaṃ. ",
  "vv15:5.1": "128. ‘‘Issā ca maccheramatho paḷāso, ",
  "vv15:5.2": "nāhosi mayhaṃ gharamāvasantiyā; ",
  "vv15:5.3": "Akkodhanā bhattuvasānuvattinī, ",
  "vv15:5.4": "uposathe niccahamappamattā. ",
  "vv15:6.1": "129. ‘‘Cātuddasiṃ pañcadasiṃ, ",
  "vv15:6.2": "yā ca pakkhassa aṭṭhamī; ",
  "vv15:6.3": "Pāṭihāriyapakkhañca, ",
  "vv15:6.4": "aṭṭhaṅgasusamāgataṃ. ",
  "vv15:7.1": "130. ‘‘Uposathaṃ upavasissaṃ, ",
  "vv15:7.2": "sadā sīlesu saṃvutā; ",
  "vv15:7.3": "Saññamā saṃvibhāgā ca, ",
  "vv15:7.4": "vimānaṃ āvasāmahaṃ . ",
  "vv15:8.1": "131. ‘‘Pāṇātipātā viratā, ",
  "vv15:8.2": "musāvādā ca saññatā; ",
  "vv15:8.3": "Theyyā ca aticārā ca, ",
  "vv15:8.4": "majjapānā ca ārakā . ",
  "vv15:9.1": "132. ‘‘Pañcasikkhāpade ratā, ",
  "vv15:9.2": "ariyasaccāna kovidā; ",
  "vv15:9.3": "Upāsikā cakkhumato, ",
  "vv15:9.4": "gotamassa yasassino. ",
  "vv15:10.1": "133. ‘‘Sāhaṃ sakena sīlena, ",
  "vv15:10.2": "yasasā ca yasassinī; ",
  "vv15:10.3": "Anubhomi sakaṃ puññaṃ, ",
  "vv15:10.4": "sukhitā camhināmayā. ",
  "vv15:11.1": "134. ‘‘Tena metādiso vaṇṇo, ",
  "vv15:11.2": "tena me idha mijjhati; ",
  "vv15:11.3": "Uppajjanti ca me bhogā, ",
  "vv15:11.4": "ye keci manaso piyā. ",
  "vv15:12.1": "135. ‘‘Akkhāmi te bhikkhu mahānubhāva, ",
  "vv15:12.2": "manussabhūtā yamahaṃ akāsiṃ; ",
  "vv15:12.3": "Tenamhi evaṃ jalitānubhāvā, ",
  "vv15:12.4": "vaṇṇo ca me sabbadisā pabhāsatīti. ",
  "vv15:13.1": "‘‘Mama ca, bhante, vacanena bhagavato pāde sirasā vandeyyāsi – ",
  "vv15:13.2": "‘uttarā nāma, bhante, upāsikā bhagavato pāde sirasā vandatī’ti. ",
  "vv15:13.3": "Anacchariyaṃ kho panetaṃ, bhante, yaṃ maṃ bhagavā aññatarasmiṃ sāmaññaphale byākareyya , taṃ bhagavā sakadāgāmiphale byākāsī’’ti. ",
  "vv15:14.1": "Uttarāvimānaṃ pannarasamaṃ. "
}
