  "vv28:0.3": "",
  "vv28:0.4": "11. Dutiyabhikkhādāyikāvimānavatthu 278. ",
  "vv28:1.1": "‘‘Abhikkantena vaṇṇena, ",
  "vv28:1.2": "yā tvaṃ tiṭṭhasi devate; ",
  "vv28:1.3": "Obhāsentī disā sabbā, ",
  "vv28:1.4": "osadhī viya tārakā. ",
  "vv28:2.1": "279. ‘‘Kena tetādiso vaṇṇo ",
  "vv28:2.2": "…pe… ",
  "vv28:2.3": "vaṇṇo ca te sabbadisā pabhāsatī’’ti. ",
  "vv28:3.1": "281. Sā devatā attamanā ",
  "vv28:3.2": "…pe… ",
  "vv28:3.3": "yassa kammassidaṃ phalaṃ. ",
  "vv28:4.1": "282. ‘‘Ahaṃ manussesu manussabhūtā, ",
  "vv28:4.2": "purimāya jātiyā manussaloke. ",
  "vv28:5.1": "283. ‘‘Addasaṃ virajaṃ bhikkhuṃ, ",
  "vv28:5.2": "vippasannamanāvilaṃ; ",
  "vv28:5.3": "Tassa adāsahaṃ bhikkhaṃ, ",
  "vv28:5.4": "pasannā sehi pāṇibhi. ",
  "vv28:6.1": "284. ‘‘Tena metādiso vaṇṇo…pe. … ",
  "vv28:6.2": "",
  "vv28:6.3": "vaṇṇo ca me sabbadisā pabhāsatī’’ti. ",
  "vv28:7.1": "Dutiyabhikkhādāyikāvimānaṃ ekādasamaṃ. ",
  "vv28:8.1": "Cittalatāvaggo dutiyo niṭṭhito. Tassuddānaṃ – ",
  "vv28:9.1": "Dāsī ceva lakhumā ca, ",
  "vv28:9.2": "atha ācāmadāyikā; ",
  "vv28:9.3": "Caṇḍālī bhadditthī ceva , ",
  "vv28:9.4": "soṇadinnā uposathā; ",
  "vv28:9.5": "Niddā ceva suniddā ca , ",
  "vv28:9.6": "dve ca bhikkhāya dāyikā; ",
  "vv28:9.7": "Vaggo tena pavuccatīti. ",
  "vv28:10.1": "",
  "vv28:11.1": "Bhāṇavāraṃ paṭhamaṃ niṭṭhitaṃ. "
}
