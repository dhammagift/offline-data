  "vv67:0.3": "",
  "vv67:0.4": "3. Phaladāyakavimānavatthu 1060. ",
  "vv67:1.1": "‘‘Uccamidaṃ maṇithūṇaṃ vimānaṃ, ",
  "vv67:1.2": "samantato soḷasa yojanāni; ",
  "vv67:1.3": "Kūṭāgārā sattasatā uḷārā, ",
  "vv67:1.4": "veḷuriyathambhā rucakatthatā subhā. ",
  "vv67:2.1": "1061. ‘‘Tatthacchasi pivasi khādasi ca, ",
  "vv67:2.2": "dibbā ca vīṇā pavadanti vagguṃ; ",
  "vv67:2.3": "Aṭṭhaṭṭhakā sikkhitā sādhurūpā, ",
  "vv67:2.4": "dibbā ca kaññā tidasacarā uḷārā; ",
  "vv67:2.5": "Naccanti gāyanti pamodayanti. ",
  "vv67:3.1": "1062. ‘‘Deviddhipattosi mahānubhāvo, ",
  "vv67:3.2": "manussabhūto kimakāsi puññaṃ; ",
  "vv67:3.3": "Kenāsi evaṃ jalitānubhāvo, ",
  "vv67:3.4": "vaṇṇo ca te sabbadisā pabhāsatī’’ti. ",
  "vv67:4.1": "1063. So devaputto attamano ",
  "vv67:4.2": "…pe… ",
  "vv67:4.3": "yassa kammassidaṃ phalaṃ. ",
  "vv67:5.1": "1064. ‘‘Phaladāyī phalaṃ vipulaṃ labhati, ",
  "vv67:5.2": "dadamujugatesu pasannamānaso; ",
  "vv67:5.3": "So hi pamodati saggagato tidive , ",
  "vv67:5.4": "anubhoti ca puññaphalaṃ vipulaṃ. ",
  "vv67:6.1": "1065. ‘‘Tavevāhaṃ mahāmuni, ",
  "vv67:6.2": "adāsiṃ caturo phale. ",
  "vv67:7.1": "1066. ‘‘Tasmā hi phalaṃ alameva dātuṃ, ",
  "vv67:7.2": "niccaṃ manussena sukhatthikena; ",
  "vv67:7.3": "Dibbāni vā patthayatā sukhāni, ",
  "vv67:7.4": "manussasobhaggatamicchatā vā. ",
  "vv67:8.1": "1067. ‘‘Tena metādiso vaṇṇo ",
  "vv67:8.2": "…pe… ",
  "vv67:8.3": "Vaṇṇo ca me sabbadisā pabhāsatī’’ti. ",
  "vv67:9.1": "Phaladāyakavimānaṃ tatiyaṃ. "
}
