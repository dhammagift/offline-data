  "vv26:0.3": "",
  "vv26:0.4": "258. 9. Suniddāvimānavatthu ",
  "vv26:1.1": "‘‘Abhikkantena vaṇṇena…pe… ",
  "vv26:1.2": "",
  "vv26:1.3": "osadhī viya tārakā. ",
  "vv26:2.1": "259. ‘‘Kena tetādiso vaṇṇo…pe… ",
  "vv26:2.2": "",
  "vv26:2.3": "vaṇṇo ca te sabbadisā pabhāsatī’’ti. ",
  "vv26:3.1": "261. Sā devatā attamanā…pe… ",
  "vv26:3.2": "",
  "vv26:3.3": "yassa kammassidaṃ phalaṃ. ",
  "vv26:4.1": "262. ‘‘Suniddāti maṃ aññaṃsu, ",
  "vv26:4.2": "rājagahasmiṃ upāsikā; ",
  "vv26:4.3": "Saddhā sīlena sampannā, ",
  "vv26:4.4": "saṃvibhāgaratā sadā. ",
  "vv26:5.1": "",
  "vv26:6.1": "266. (Yathā niddāvimānaṃ tathā vitthāretabbaṃ.) 267. ‘‘Pañcasikkhāpade ratā, ",
  "vv26:6.2": "ariyasaccāna kovidā; ",
  "vv26:6.3": "Upāsikā cakkhumato, ",
  "vv26:6.4": "gotamassa yasassino. ",
  "vv26:7.1": "268. ‘‘Tena metādiso vaṇṇo…pe… ",
  "vv26:7.2": "",
  "vv26:7.3": "vaṇṇo ca me sabbadisā pabhāsatī’’ti. ",
  "vv26:8.1": "Suniddāvimānaṃ navamaṃ. "
}
