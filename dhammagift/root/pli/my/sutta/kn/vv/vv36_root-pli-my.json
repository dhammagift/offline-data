  "vv36:0.4": "8. Mallikāvimānavatthu 658. ",
  "vv36:1.1": "‘‘Pītavatthe pītadhaje, ",
  "vv36:1.2": "pītālaṅkārabhūsite; ",
  "vv36:1.3": "Pītantarāhi vaggūhi, ",
  "vv36:1.4": "apiḷandhāva sobhasi. ",
  "vv36:2.1": "659. ‘‘Kā kambukāyūradhare , ",
  "vv36:2.2": "kañcanāveḷabhūsite; ",
  "vv36:2.3": "Hemajālakasañchanne , ",
  "vv36:2.4": "nānāratanamālinī. ",
  "vv36:3.1": "660. ‘‘Sovaṇṇamayā lohitaṅgamayā ca, ",
  "vv36:3.2": "muttāmayā veḷuriyamayā ca; ",
  "vv36:3.3": "Masāragallā sahalohitaṅgā , ",
  "vv36:3.4": "pārevatakkhīhi maṇīhi cittatā. ",
  "vv36:4.1": "661. ‘‘Koci koci ettha mayūrasussaro, ",
  "vv36:4.2": "haṃsassa rañño karavīkasussaro; ",
  "vv36:4.3": "Tesaṃ saro suyyati vaggurūpo, ",
  "vv36:4.4": "pañcaṅgikaṃ tūriyamivappavāditaṃ. ",
  "vv36:5.1": "662. ‘‘Ratho ca te subho vaggu , ",
  "vv36:5.2": "nānāratanacittito ; ",
  "vv36:5.3": "Nānāvaṇṇāhi dhātūhi, ",
  "vv36:5.4": "suvibhattova sobhati. ",
  "vv36:6.1": "663. ‘‘Tasmiṃ rathe kañcanabimbavaṇṇe, ",
  "vv36:6.2": "yā tvaṃ ṭhitā bhāsasi maṃ padesaṃ; ",
  "vv36:6.3": "Devate pucchitācikkha, ",
  "vv36:6.4": "kissa kammassidaṃ phala’’nti. ",
  "vv36:7.1": "664. ‘‘Sovaṇṇajālaṃ maṇisoṇṇacittitaṃ , ",
  "vv36:7.2": "muttācitaṃ hemajālena channaṃ ; ",
  "vv36:7.3": "Parinibbute gotame appameyye, ",
  "vv36:7.4": "pasannacittā ahamābhiropayiṃ. ",
  "vv36:8.1": "665. ‘‘Tāhaṃ kammaṃ karitvāna, ",
  "vv36:8.2": "kusalaṃ buddhavaṇṇitaṃ; ",
  "vv36:8.3": "Apetasokā sukhitā, ",
  "vv36:8.4": "sampamodāmanāmayā’’ti. ",
  "vv36:9.1": "Mallikāvimānaṃ aṭṭhamaṃ. "
}
