  "vv13:0.3": "",
  "vv13:0.4": "13. Paṭhamasuṇisāvimānavatthu 108. ",
  "vv13:1.1": "‘‘Abhikkantena vaṇṇena, ",
  "vv13:1.2": "yā tvaṃ tiṭṭhasi devate; ",
  "vv13:1.3": "Obhāsentī disā sabbā, ",
  "vv13:1.4": "osadhī viya tārakā. ",
  "vv13:2.1": "109. ‘‘Kena tetādiso vaṇṇo, ",
  "vv13:2.2": "kena te idha mijjhati; ",
  "vv13:2.3": "Uppajjanti ca te bhogā, ",
  "vv13:2.4": "ye keci manaso piyā. ",
  "vv13:3.1": "110. ‘‘Pucchāmi taṃ devi mahānubhāve, ",
  "vv13:3.2": "manussabhūtā kimakāsi puññaṃ; ",
  "vv13:3.3": "Kenāsi evaṃ jalitānubhāvā, ",
  "vv13:3.4": "vaṇṇo ca te sabbadisā pabhāsatī’’ti. ",
  "vv13:4.1": "111. Sā devatā attamanā, ",
  "vv13:4.2": "moggallānena pucchitā; ",
  "vv13:4.3": "Pañhaṃ puṭṭhā viyākāsi, ",
  "vv13:4.4": "yassa kammassidaṃ phalaṃ. ",
  "vv13:5.1": "112. ‘‘Ahaṃ manussesu manussabhūtā, ",
  "vv13:5.2": "suṇisā ahosiṃ sasurassa gehe . ",
  "vv13:6.1": "113. ‘‘Addasaṃ virajaṃ bhikkhuṃ, ",
  "vv13:6.2": "vippasannamanāvilaṃ; ",
  "vv13:6.3": "Tassa adāsahaṃ pūvaṃ, ",
  "vv13:6.4": "pasannā sehi pāṇibhi; ",
  "vv13:6.5": "Bhāgaḍḍhabhāgaṃ datvāna, ",
  "vv13:6.6": "modāmi nandane vane. ",
  "vv13:7.1": "114. ‘‘Tena metādiso vaṇṇo, ",
  "vv13:7.2": "tena me idha mijjhati; ",
  "vv13:7.3": "Uppajjanti ca me bhogā, ",
  "vv13:7.4": "ye keci manaso piyā. ",
  "vv13:8.1": "115. ‘‘Akkhāmi te bhikkhu mahānubhāva, ",
  "vv13:8.2": "manussabhūtā yamakāsi puññaṃ; ",
  "vv13:8.3": "Tenamhi evaṃ jalitānubhāvā, ",
  "vv13:8.4": "vaṇṇo ca me sabbadisā pabhāsatī’’ti. ",
  "vv13:9.1": "Paṭhamasuṇisāvimānaṃ terasamaṃ. "
}
