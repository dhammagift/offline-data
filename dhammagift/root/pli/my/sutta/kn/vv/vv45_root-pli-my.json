  "vv45:0.4": "7. Caturitthivimānavatthu 755. ",
  "vv45:1.1": "‘‘Abhikkantena vaṇṇena ",
  "vv45:1.2": "…pe… ",
  "vv45:1.3": "vaṇṇo ca te sabbadisā pabhāsatī’’ti. ",
  "vv45:2.1": "758. Sā devatā attamanā ",
  "vv45:2.2": "…pe… ",
  "vv45:2.3": "yassa kammassidaṃ phalaṃ. ",
  "vv45:3.1": "759. ‘‘Indīvarānaṃ hatthakaṃ ahamadāsiṃ, ",
  "vv45:3.2": "bhikkhuno piṇḍāya carantassa; ",
  "vv45:3.3": "Esikānaṃ uṇṇatasmiṃ, ",
  "vv45:3.4": "nagaravare paṇṇakate ramme. ",
  "vv45:4.1": "760. ‘‘Tena metādiso vaṇṇo ",
  "vv45:4.2": "…pe… ",
  "vv45:4.3": "vaṇṇo ca me sabbadissā pabhāsatī’’ti. ",
  "vv45:5.1": "762. ‘‘Abhikkantena vaṇṇena ",
  "vv45:5.2": "…pe… ",
  "vv45:5.3": "vaṇṇo ca te sabbadisā pabhāsatī’’ti. ",
  "vv45:6.1": "765. Sā devatā attamanā ",
  "vv45:6.2": "…pe… ",
  "vv45:6.3": "yassa kammassidaṃ phalaṃ. ",
  "vv45:7.1": "766. ‘‘Nīluppalahatthakaṃ ahamadāsiṃ, ",
  "vv45:7.2": "bhikkhuno piṇḍāya carantassa; ",
  "vv45:7.3": "Esikānaṃ uṇṇatasmiṃ, ",
  "vv45:7.4": "nagaravare paṇṇakate ramme. ",
  "vv45:8.1": "767. ‘‘Tena metādiso vaṇṇo ",
  "vv45:8.2": "…pe… ",
  "vv45:8.3": "vaṇṇo ca me sabbadisā pabhāsatī’’ti. ",
  "vv45:9.1": "769. ‘‘Abhikkantena vaṇṇena ",
  "vv45:9.2": "…pe… ",
  "vv45:9.3": "vaṇṇo ca te sabbadisā pabhāsatī’’ti. ",
  "vv45:10.1": "772. Sā devatā attamanā ",
  "vv45:10.2": "…pe… ",
  "vv45:10.3": "yassa kammassidaṃ phalaṃ. ",
  "vv45:11.1": "773. ‘‘Odātamūlakaṃ haritapattaṃ, ",
  "vv45:11.2": "udakasmiṃ sare jātaṃ ahamadāsiṃ; ",
  "vv45:11.3": "Bhikkhuno piṇḍāya carantassa, ",
  "vv45:11.4": "esikānaṃ uṇṇatasmiṃ; ",
  "vv45:11.5": "Nagaravare paṇṇakate ramme. ",
  "vv45:12.1": "774. ‘‘Tena metādiso vaṇṇo ",
  "vv45:12.2": "…pe… ",
  "vv45:12.3": "vaṇṇo ca me sabbadisā pabhāsatī’’ti. ",
  "vv45:13.1": "776. ‘‘Abhikkantena vaṇṇena ",
  "vv45:13.2": "…pe… ",
  "vv45:13.3": "vaṇṇo ca te sabbadisā pabhāsatī’’ti. ",
  "vv45:14.1": "779. Sā devatā attamanā ",
  "vv45:14.2": "…pe… ",
  "vv45:14.3": "yassa kammassidaṃ phalaṃ. ",
  "vv45:15.1": "780. ‘‘Ahaṃ sumanā sumanassa sumanamakuḷāni, ",
  "vv45:15.2": "dantavaṇṇāni ahamadāsiṃ; ",
  "vv45:15.3": "Bhikkhuno piṇḍāya carantassa, ",
  "vv45:15.4": "esikānaṃ uṇṇatasmiṃ; ",
  "vv45:15.5": "Nagaravare paṇṇakate ramme. ",
  "vv45:16.1": "781. ‘‘Tena metādiso vaṇṇo ",
  "vv45:16.2": "…pe… ",
  "vv45:16.3": "vaṇṇo ca me sabbadisā pabhāsatī’’ti. ",
  "vv45:17.1": "Caturitthivimānaṃ sattamaṃ. "
}
