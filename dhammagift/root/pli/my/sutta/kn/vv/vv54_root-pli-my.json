  "vv54:0.3": "",
  "vv54:0.4": "4. Kakkaṭakarasadāyakavimānavatthu 910. ",
  "vv54:1.1": "‘‘Uccamidaṃ maṇithūṇaṃ vimānaṃ, ",
  "vv54:1.2": "samantato dvādasa yojanāni; ",
  "vv54:1.3": "Kūṭāgārā sattasatā uḷārā, ",
  "vv54:1.4": "veḷuriyathambhā rucakatthatā subhā. ",
  "vv54:2.1": "911. ‘‘Tatthacchasi pivasi khādasi ca, ",
  "vv54:2.2": "dibbā ca vīṇā pavadanti vagguṃ ; ",
  "vv54:2.3": "Dibbā rasā kāmaguṇettha pañca, ",
  "vv54:2.4": "nāriyo ca naccanti suvaṇṇachannā. ",
  "vv54:3.1": "912. ‘‘Kena tetādiso vaṇṇo, ",
  "vv54:3.2": "kena te idha mijjhati; ",
  "vv54:3.3": "Uppajjanti ca te bhogā, ",
  "vv54:3.4": "ye keci manaso piyā. ",
  "vv54:4.1": "913. ‘‘Pucchāmi taṃ deva mahānubhāva, ",
  "vv54:4.2": "manussabhūto kimakāsi puññaṃ; ",
  "vv54:4.3": "Kenāsi evaṃ jalitānubhāvo, ",
  "vv54:4.4": "vaṇṇo ca te sabbadisā pabhāsatī’’ti. ",
  "vv54:5.1": "914. So devaputto attamano, ",
  "vv54:5.2": "moggallānena pucchito; ",
  "vv54:5.3": "Pañhaṃ puṭṭho viyākāsi, ",
  "vv54:5.4": "yassa kammassidaṃ phalaṃ. ",
  "vv54:6.1": "915. ‘‘Satisamuppādakaro, ",
  "vv54:6.2": "dvāre kakkaṭako ṭhito; ",
  "vv54:6.3": "Niṭṭhito jātarūpassa, ",
  "vv54:6.4": "sobhati dasapādako. ",
  "vv54:7.1": "916. ‘‘Tena metādiso vaṇṇo, ",
  "vv54:7.2": "tena me idha mijjhati; ",
  "vv54:7.3": "Uppajjanti ca me bhogā, ",
  "vv54:7.4": "ye keci manaso piyā. ",
  "vv54:8.1": "917. ‘‘Akkhāmi te bhikkhu mahānubhāva, ",
  "vv54:8.2": "manussabhūto yamakāsi puññaṃ; ",
  "vv54:8.3": "Tenamhi evaṃ jalitānubhāvo, ",
  "vv54:8.4": "vaṇṇo ca me sabbadisā pabhāsatī’’ti. ",
  "vv54:9.1": "Kakkaṭakarasadāyakavimānaṃ catutthaṃ. ",
  "vv54:10.1": "(Anantaraṃ pañcavimānaṃ yathā kakkaṭakarasadāyakavimānaṃ tathā vitthāretabbaṃ) "
}
