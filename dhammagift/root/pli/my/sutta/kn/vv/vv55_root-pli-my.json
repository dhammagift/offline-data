  "vv55:0.4": "5. Dvārapālavimānavatthu 918. ",
  "vv55:1.1": "‘‘Uccamidaṃ maṇithūṇaṃ vimānaṃ, ",
  "vv55:1.2": "samantato dvādasa yojanāni; ",
  "vv55:1.3": "Kūṭāgārā sattasatā uḷārā, ",
  "vv55:1.4": "veḷuriyathambhā rucakatthatā subhā. ",
  "vv55:2.1": "919. ‘‘Tatthacchasi pivasi khādasi ca, ",
  "vv55:2.2": "dibbā ca vīṇā pavadanti vagguṃ; ",
  "vv55:2.3": "Dibbā rasā kāmaguṇettha pañca, ",
  "vv55:2.4": "nāriyo ca naccanti suvaṇṇachannā. ",
  "vv55:3.1": "920. ‘‘Kena tetādiso vaṇṇo ",
  "vv55:3.2": "…pe… ",
  "vv55:3.3": "vaṇṇo ca te sabbadisā pabhāsatī’’ti. ",
  "vv55:4.1": "922. So devaputto attamano, ",
  "vv55:4.2": "moggallānena pucchito; ",
  "vv55:4.3": "Pañhaṃ puṭṭho viyākāsi, ",
  "vv55:4.4": "yassa kammassidaṃ phalaṃ. ",
  "vv55:5.1": "923. ‘‘Dibbaṃ mamaṃ vassasahassamāyu, ",
  "vv55:5.2": "vācābhigītaṃ manasā pavattitaṃ; ",
  "vv55:5.3": "Ettāvatā ṭhassati puññakammo, ",
  "vv55:5.4": "dibbehi kāmehi samaṅgibhūto. ",
  "vv55:6.1": "924. ‘‘Tena metādiso vaṇṇo ",
  "vv55:6.2": "…pe… ",
  "vv55:6.3": "vaṇṇo ca me sabbadisā pabhāsatī’’ti. ",
  "vv55:7.1": "Dvārapālavimānaṃ pañcamaṃ. "
}
