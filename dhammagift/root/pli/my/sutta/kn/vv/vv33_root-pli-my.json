  "vv33:100.0": "36. Sakkhalikadāyikāvimānavatthu (25) ",
  "vv33:100.1": "613. ‘‘Sakkhalikaṃ ahamadāsiṃ, ",
  "vv33:100.2": "bhikkhuno piṇḍāya carantassa…pe…. ",
  "vv33:100.3": "",
  "vv33:101.1": "614. ‘‘Tassā me passa vimānaṃ, ",
  "vv33:101.2": "accharā kāmavaṇṇinīhamasmi; ",
  "vv33:101.3": "Accharāsahassassāhaṃ, ",
  "vv33:101.4": "pavarā passa puññānaṃ vipākaṃ. ",
  "vv33:102.1": "615. ‘‘Tena metādiso vaṇṇo…pe…vaṇṇo ",
  "vv33:102.2": "",
  "vv33:102.3": "ca me sabbadisā pabhāsatī’’ti. ",
  "vv33:103.1": "617. ‘‘Svāgataṃ vata me ajja, ",
  "vv33:103.2": "suppabhātaṃ suhuṭṭhitaṃ ; ",
  "vv33:103.3": "Yaṃ addasāmi devatāyo, ",
  "vv33:103.4": "accharā kāmavaṇṇiniyo . ",
  "vv33:104.1": "618. ‘‘Imāsāhaṃ dhammaṃ sutvā , ",
  "vv33:104.2": "kāhāmi kusalaṃ bahuṃ. ",
  "vv33:104.3": "Dānena samacariyāya, ",
  "vv33:104.4": "saññamena damena ca; ",
  "vv33:104.5": "Svāhaṃ tattha gamissāmi , ",
  "vv33:104.6": "yattha gantvā na socare’’ti. ",
  "vv33:105.1": "Guttilavimānaṃ pañcamaṃ. "
}
