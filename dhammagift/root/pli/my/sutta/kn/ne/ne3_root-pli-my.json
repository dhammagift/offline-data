{
  "ne3:0.1": "",
  "ne3:0.2": "3. Niddesavāro ",
  "ne3:1.1": "Tattha saṅkhepato netti kittitā. ",
  "ne3:2.0": "Hārasaṅkhepo 1. ",
  "ne3:2.1": "Assādādīnavatā, ",
  "ne3:2.2": "nissaraṇampi ca phalaṃ upāyo ca; ",
  "ne3:2.3": "Āṇattī ca bhagavato, ",
  "ne3:2.4": "yogīnaṃ desanāhāro. ",
  "ne3:3.1": "2. Yaṃ pucchitañca vissajjitañca, ",
  "ne3:3.2": "suttassa yā ca anugīti; ",
  "ne3:3.3": "Suttassa yo pavicayo, ",
  "ne3:3.4": "hāro vicayoti niddiṭṭho. ",
  "ne3:4.1": "3. Sabbesaṃ hārānaṃ, ",
  "ne3:4.2": "yā bhūmī yo ca gocaro tesaṃ; ",
  "ne3:4.3": "Yuttāyuttaparikkhā, ",
  "ne3:4.4": "hāro yuttīti niddiṭṭho. ",
  "ne3:5.1": "4. Dhammaṃ deseti jino, ",
  "ne3:5.2": "tassa ca dhammassa yaṃ padaṭṭhānaṃ; ",
  "ne3:5.3": "Iti yāva sabbadhammā, ",
  "ne3:5.4": "eso hāro padaṭṭhāno. ",
  "ne3:6.1": "5. Vuttamhi ekadhamme, ",
  "ne3:6.2": "ye dhammā ekalakkhaṇā keci; ",
  "ne3:6.3": "Vuttā bhavanti sabbe, ",
  "ne3:6.4": "so hāro lakkhaṇo nāma. ",
  "ne3:7.1": "6. Neruttamadhippāyo, ",
  "ne3:7.2": "byañjanamatha desanānidānañca; ",
  "ne3:7.3": "Pubbāparānusandhī, ",
  "ne3:7.4": "eso hāro catubyūho. ",
  "ne3:8.1": "7. Ekamhi padaṭṭhāne, ",
  "ne3:8.2": "pariyesati sesakaṃ padaṭṭhānaṃ; ",
  "ne3:8.3": "Āvaṭṭati paṭipakkhe, ",
  "ne3:8.4": "āvaṭṭo nāma so hāro. ",
  "ne3:9.1": "8. Dhammañca padaṭṭhānaṃ, ",
  "ne3:9.2": "bhūmiñca vibhajjate ayaṃ hāro; ",
  "ne3:9.3": "Sādhāraṇe asādhāraṇe ",
  "ne3:9.4": "ca neyyo vibhattīti. ",
  "ne3:10.1": "9. Kusalākusale dhamme, ",
  "ne3:10.2": "niddiṭṭhe bhāvite pahīne ca; ",
  "ne3:10.3": "Parivattati paṭipakkhe, ",
  "ne3:10.4": "hāro parivattano nāma. ",
  "ne3:11.1": "10. Vevacanāni bahūni tu, ",
  "ne3:11.2": "sutte vuttāni ekadhammassa; ",
  "ne3:11.3": "Yo jānāti suttavidū, ",
  "ne3:11.4": "vevacano nāma so hāro. ",
  "ne3:12.1": "11. Ekaṃ bhagavā dhammaṃ, ",
  "ne3:12.2": "paññattīhi vividhāhi deseti; ",
  "ne3:12.3": "So ākāro ñeyyo, ",
  "ne3:12.4": "paññattī nāma hāroti. ",
  "ne3:13.1": "12. Yo ca paṭiccuppādo, ",
  "ne3:13.2": "indriyakhandhā ca dhātu āyatanā; ",
  "ne3:13.3": "Etehi otarati yo, ",
  "ne3:13.4": "otaraṇo nāma so hāro. ",
  "ne3:14.1": "13. Vissajjitamhi pañhe, ",
  "ne3:14.2": "gāthāyaṃ pucchitāyamārabbha; ",
  "ne3:14.3": "Suddhāsuddhaparikkhā, ",
  "ne3:14.4": "hāro so sodhano nāma. ",
  "ne3:15.1": "14. Ekattatāya dhammā, ",
  "ne3:15.2": "yepi ca vemattatāya niddiṭṭhā; ",
  "ne3:15.3": "Tena vikappayitabbā, ",
  "ne3:15.4": "eso hāro adhiṭṭhāno. ",
  "ne3:16.1": "15. Ye dhammā yaṃ dhammaṃ, ",
  "ne3:16.2": "janayantippaccayā paramparato; ",
  "ne3:16.3": "Hetumavakaḍḍhayitvā, ",
  "ne3:16.4": "eso hāro parikkhāro. ",
  "ne3:17.1": "16. Ye dhammā yaṃ mūlā, ",
  "ne3:17.2": "ye cekatthā pakāsitā muninā; ",
  "ne3:17.3": "Te samaropayitabbā, ",
  "ne3:17.4": "esa samāropano hāro. Nayasaṅkhepo ",
  "ne3:18.0": "17. ",
  "ne3:18.1": "Taṇhañca avijjampi ca, ",
  "ne3:18.2": "samathena vipassanā yo neti; ",
  "ne3:18.3": "Saccehi yojayitvā, ",
  "ne3:18.4": "ayaṃ nayo nandiyāvaṭṭo. ",
  "ne3:19.1": "18. Yo akusale samūlehi, ",
  "ne3:19.2": "neti kusale ca kusalamūlehi; ",
  "ne3:19.3": "Bhūtaṃ tathaṃ avitathaṃ, ",
  "ne3:19.4": "tipukkhalaṃ taṃ nayaṃ āhu. ",
  "ne3:20.1": "19. Yo neti vipallāsehi, ",
  "ne3:20.2": "kilese indriyehi saddhamme; ",
  "ne3:20.3": "Etaṃ nayaṃ nayavidū, ",
  "ne3:20.4": "sīhavikkīḷitaṃ āhu. ",
  "ne3:21.1": "20. Veyyākaraṇesu hi ye, ",
  "ne3:21.2": "kusalākusalā tahiṃ tahiṃ vuttā; ",
  "ne3:21.3": "Manasā volokayate, ",
  "ne3:21.4": "taṃ khu disālocanaṃ āhu. ",
  "ne3:22.1": "21. Oloketvā disalocanena, ",
  "ne3:22.2": "ukkhipiya yaṃ samāneti; ",
  "ne3:22.3": "Sabbe kusalākusale, ",
  "ne3:22.4": "ayaṃ nayo aṅkuso nāma. ",
  "ne3:23.1": "22. Soḷasa hārā paṭhamaṃ, ",
  "ne3:23.2": "disalocanato disā viloketvā; ",
  "ne3:23.3": "Saṅkhipiya aṅkusena hi, ",
  "ne3:23.4": "nayehi tīhi niddise suttaṃ. ",
  "ne3:24.0": "Dvādasapada ",
  "ne3:24.1": "23. Akkharaṃ padaṃ byañjanaṃ, ",
  "ne3:24.2": "nirutti tatheva niddeso; ",
  "ne3:24.3": "Ākārachaṭṭhavacanaṃ, ",
  "ne3:24.4": "ettāva byañjanaṃ sabbaṃ. ",
  "ne3:25.1": "24. Saṅkāsanā pakāsanā, ",
  "ne3:25.2": "vivaraṇā vibhajanuttānīkammapaññatti; ",
  "ne3:25.3": "Etehi chahi padehi, ",
  "ne3:25.4": "attho kammañca niddiṭṭhaṃ. ",
  "ne3:26.1": "25. Tīṇi ca nayā anūnā, ",
  "ne3:26.2": "atthassa ca chappadāni gaṇitāni; ",
  "ne3:26.3": "Navahi padehi bhagavato, ",
  "ne3:26.4": "vacanassattho samāyutto. ",
  "ne3:27.1": "26. Atthassa navappadāni, ",
  "ne3:27.2": "byañjanapariyeṭṭhiyā catubbīsa; ",
  "ne3:27.3": "Ubhayaṃ saṅkalayitvā , ",
  "ne3:27.4": "tettiṃsā ettikā nettīti. ",
  "ne3:27.5": "Niddesavāro. "
}
