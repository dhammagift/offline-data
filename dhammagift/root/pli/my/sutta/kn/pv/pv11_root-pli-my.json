  "pv11:0.3": "73. 11. Nāgapetavatthu ",
  "pv11:1.1": "‘‘Puratova setena paleti hatthinā, ",
  "pv11:1.2": "majjhe pana assatarīrathena; ",
  "pv11:1.3": "Pacchā ca kaññā sivikāya nīyati, ",
  "pv11:1.4": "obhāsayantī dasa sabbato disā. ",
  "pv11:2.1": "74. ‘‘Tumhe pana muggarahatthapāṇino, ",
  "pv11:2.2": "rudaṃmukhā chinnapabhinnagattā; ",
  "pv11:2.3": "Manussabhūtā kimakattha pāpaṃ, ",
  "pv11:2.4": "yenaññamaññassa pivātha lohita’’nti. ",
  "pv11:3.1": "75. ‘‘Puratova yo gacchati kuñjarena, ",
  "pv11:3.2": "setena nāgena catukkamena; ",
  "pv11:3.3": "Amhāka putto ahu jeṭṭhako so , ",
  "pv11:3.4": "dānāni datvāna sukhī pamodati. ",
  "pv11:4.1": "76. ‘‘Yo so majjhe assatarīrathena, ",
  "pv11:4.2": "catubbhi yuttena suvaggitena; ",
  "pv11:4.3": "Amhāka putto ahu majjhimo so, ",
  "pv11:4.4": "amaccharī dānavatī virocati. ",
  "pv11:5.1": "77. ‘‘Yā sā ca pacchā sivikāya nīyati, ",
  "pv11:5.2": "nārī sapaññā migamandalocanā; ",
  "pv11:5.3": "Amhāka dhītā ahu sā kaniṭṭhikā, ",
  "pv11:5.4": "bhāgaḍḍhabhāgena sukhī pamodati. ",
  "pv11:6.1": "78. ‘‘Ete ca dānāni adaṃsu pubbe, ",
  "pv11:6.2": "pasannacittā samaṇabrāhmaṇānaṃ; ",
  "pv11:6.3": "Mayaṃ pana maccharino ahumha, ",
  "pv11:6.4": "paribhāsakā samaṇabrāhmaṇānaṃ; ",
  "pv11:6.5": "Ete ca datvā paricārayanti, ",
  "pv11:6.6": "mayañca sussāma naḷova chinno’’ti . ",
  "pv11:7.1": "79. ‘‘Kiṃ tumhākaṃ bhojanaṃ kiṃ sayānaṃ, ",
  "pv11:7.2": "kathañca yāpetha supāpadhammino; ",
  "pv11:7.3": "Pahūtabhogesu anappakesu, ",
  "pv11:7.4": "sukhaṃ virādhāya dukkhajja pattā’’ti. ",
  "pv11:8.1": "80. ‘‘Aññamaññaṃ vadhitvāna, ",
  "pv11:8.2": "pivāma pubbalohitaṃ; ",
  "pv11:8.3": "Bahuṃ pitvā na dhātā homa, ",
  "pv11:8.4": "nacchādimhase mayaṃ. ",
  "pv11:9.1": "81. ‘‘Icceva maccā paridevayanti, ",
  "pv11:9.2": "adāyakā pecca yamassa ṭhāyino; ",
  "pv11:9.3": "Ye te vidicca adhigamma bhoge, ",
  "pv11:9.4": "na bhuñjare nāpi karonti puññaṃ. ",
  "pv11:10.1": "82. ‘‘Te khuppipāsūpagatā parattha, ",
  "pv11:10.2": "pacchā ciraṃ jhāyare ḍayhamānā; ",
  "pv11:10.3": "Kammāni katvāna dukhudrāni, ",
  "pv11:10.4": "anubhonti dukkhaṃ kaṭukapphalāni. ",
  "pv11:11.1": "83. ‘‘Ittaraṃ hi dhanaṃ dhaññaṃ, ",
  "pv11:11.2": "ittaraṃ idha jīvitaṃ; ",
  "pv11:11.3": "Ittaraṃ ittarato ñatvā, ",
  "pv11:11.4": "dīpaṃ kayirātha paṇḍito. ",
  "pv11:12.1": "84. ‘‘Ye te evaṃ pajānanti, ",
  "pv11:12.2": "narā dhammassa kovidā; ",
  "pv11:12.3": "Te dāne nappamajjanti, ",
  "pv11:12.4": "sutvā arahataṃ vaco’’ti. ",
  "pv11:13.1": "Nāgapetavatthu ekādasamaṃ. "
}
