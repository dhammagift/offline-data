  "pv49:0.3": "14. Bhogasaṃharapetavatthu 801. ",
  "pv49:1.1": "‘‘Mayaṃ bhoge saṃharimha, ",
  "pv49:1.2": "samena visamena ca; ",
  "pv49:1.3": "Te aññe paribhuñjanti, ",
  "pv49:1.4": "mayaṃ dukkhassa bhāginī’’ti. ",
  "pv49:2.1": "Bhogasaṃharapetavatthu cuddasamaṃ. "
}
