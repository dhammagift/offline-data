  "pv39:0.3": "714. 4. Revatīpetavatthu ",
  "pv39:1.1": "‘‘Uṭṭhehi revate supāpadhamme, ",
  "pv39:1.2": "apārutadvāre adānasīle; ",
  "pv39:1.3": "Nessāma taṃ yattha thunanti duggatā, ",
  "pv39:1.4": "samappitā nerayikā dukhenā’’ti. ",
  "pv39:2.1": "715. Icceva vatvāna yamassa dūtā, ",
  "pv39:2.2": "te dve yakkhā lohitakkhā brahantā; ",
  "pv39:2.3": "Paccekabāhāsu gahetvā revataṃ, ",
  "pv39:2.4": "pakkāmayuṃ devagaṇassa santike. ",
  "pv39:3.1": "716. ‘‘Ādiccavaṇṇaṃ ruciraṃ pabhassaraṃ, ",
  "pv39:3.2": "byamhaṃ subhaṃ kañcanajālachannaṃ; ",
  "pv39:3.3": "Kassetamākiṇṇajanaṃ vimānaṃ, ",
  "pv39:3.4": "suriyassa raṃsīriva jotamānaṃ. ",
  "pv39:4.1": "717. ‘‘Nārīgaṇā candanasāralittā , ",
  "pv39:4.2": "ubhato vimānaṃ upasobhayanti; ",
  "pv39:4.3": "Taṃ dissati suriyasamānavaṇṇaṃ, ",
  "pv39:4.4": "ko modati saggapatto vimāne’’ti. ",
  "pv39:5.1": "718. ‘‘Bārāṇasiyaṃ nandiyo nāmāsi, ",
  "pv39:5.2": "upāsako amaccharī dānapati vadaññū; ",
  "pv39:5.3": "Tassetamākiṇṇajanaṃ vimānaṃ, ",
  "pv39:5.4": "suriyassa raṃsīriva jotamānaṃ. ",
  "pv39:6.1": "719. ‘‘Nārīgaṇā candanasāralittā, ",
  "pv39:6.2": "ubhato vimānaṃ upasobhayanti; ",
  "pv39:6.3": "Taṃ dissati suriyasamānavaṇṇaṃ, ",
  "pv39:6.4": "so modati saggapatto vimāne’’ti. ",
  "pv39:7.1": "720. ‘‘Nandiyassāhaṃ bhariyā, ",
  "pv39:7.2": "agārinī sabbakulassa issarā; ",
  "pv39:7.3": "Bhattu vimāne ramissāmi dānahaṃ, ",
  "pv39:7.4": "na patthaye nirayadassanāyā’’ti. ",
  "pv39:8.1": "721. ‘‘Eso te nirayo supāpadhamme, ",
  "pv39:8.2": "puññaṃ tayā akataṃ jīvaloke; ",
  "pv39:8.3": "Na hi maccharī rosako pāpadhammo, ",
  "pv39:8.4": "saggūpagānaṃ labhati sahabyata’’nti. ",
  "pv39:9.1": "722. ‘‘Kiṃ nu gūthañca muttañca, ",
  "pv39:9.2": "asucī paṭidissati; ",
  "pv39:9.3": "Duggandhaṃ kimidaṃ mīḷhaṃ, ",
  "pv39:9.4": "kimetaṃ upavāyatī’’ti. ",
  "pv39:10.1": "723. ‘‘Esa saṃsavako nāma, ",
  "pv39:10.2": "gambhīro sataporiso; ",
  "pv39:10.3": "Yattha vassasahassāni, ",
  "pv39:10.4": "tuvaṃ paccasi revate’’ti. ",
  "pv39:11.1": "724. ‘‘Kiṃ nu kāyena vācāya, ",
  "pv39:11.2": "manasā dukkaṭaṃ kataṃ; ",
  "pv39:11.3": "Kena saṃsavako laddho, ",
  "pv39:11.4": "gambhīro sataporiso’’ti. ",
  "pv39:12.1": "725. ‘‘Samaṇe brāhmaṇe cāpi, ",
  "pv39:12.2": "aññe vāpi vanibbake; ",
  "pv39:12.3": "Musāvādena vañcesi, ",
  "pv39:12.4": "taṃ pāpaṃ pakataṃ tayā. ",
  "pv39:13.1": "726. ‘‘Tena saṃsavako laddho, ",
  "pv39:13.2": "gambhīro sataporiso; ",
  "pv39:13.3": "Tattha vassasahassāni, ",
  "pv39:13.4": "tuvaṃ paccasi revate. ",
  "pv39:14.1": "727. ‘‘Hatthepi chindanti athopi pāde, ",
  "pv39:14.2": "kaṇṇepi chindanti athopi nāsaṃ; ",
  "pv39:14.3": "Athopi kākoḷagaṇā samecca, ",
  "pv39:14.4": "saṅgamma khādanti viphandamāna’’nti. ",
  "pv39:15.1": "728. ‘‘Sādhu kho maṃ paṭinetha, ",
  "pv39:15.2": "kāhāmi kusalaṃ bahuṃ; ",
  "pv39:15.3": "Dānena samacariyāya, ",
  "pv39:15.4": "saṃyamena damena ca; ",
  "pv39:15.5": "Yaṃ katvā sukhitā honti, ",
  "pv39:15.6": "na ca pacchānutappare’’ti. ",
  "pv39:16.1": "729. ‘‘Pure tuvaṃ pamajjitvā, ",
  "pv39:16.2": "idāni paridevasi; ",
  "pv39:16.3": "Sayaṃ katānaṃ kammānaṃ, ",
  "pv39:16.4": "vipākaṃ anubhossasī’’ti. ",
  "pv39:17.1": "730. ‘‘Ko devalokato manussalokaṃ, ",
  "pv39:17.2": "gantvāna puṭṭho me evaṃ vadeyya; ",
  "pv39:17.3": "‘Nikkhittadaṇḍesu dadātha dānaṃ, ",
  "pv39:17.4": "acchādanaṃ seyya mathannapānaṃ; ",
  "pv39:17.5": "Na hi maccharī rosako pāpadhammo, ",
  "pv39:17.6": "saggūpagānaṃ labhati sahabyataṃ’. ",
  "pv39:18.1": "731. ‘‘Sāhaṃ nūna ito gantvā, ",
  "pv39:18.2": "yoniṃ laddhāna mānusiṃ; ",
  "pv39:18.3": "Vadaññū sīlasampannā, ",
  "pv39:18.4": "kāhāmi kusalaṃ bahuṃ; ",
  "pv39:18.5": "Dānena samacariyāya, ",
  "pv39:18.6": "saṃyamena damena ca. ",
  "pv39:19.1": "732. ‘‘Ārāmāni ca ropissaṃ, ",
  "pv39:19.2": "dugge saṅkamanāni ca; ",
  "pv39:19.3": "Papañca udapānañca, ",
  "pv39:19.4": "vippasannena cetasā. ",
  "pv39:20.1": "733. ‘‘Cātuddasiṃ pañcadasiṃ, ",
  "pv39:20.2": "yā ca pakkhassa aṭṭhamī; ",
  "pv39:20.3": "Pāṭihāriyapakkhañca, ",
  "pv39:20.4": "aṭṭhaṅgasusamāgataṃ. ",
  "pv39:21.1": "734. ‘‘Uposathaṃ upavasissaṃ, ",
  "pv39:21.2": "sadā sīlesu saṃvutā; ",
  "pv39:21.3": "Na ca dāne pamajjissaṃ, ",
  "pv39:21.4": "sāmaṃ diṭṭhamidaṃ mayā’’ti. ",
  "pv39:22.1": "735. Iccevaṃ vippalapantiṃ, ",
  "pv39:22.2": "phandamānaṃ tato tato; ",
  "pv39:22.3": "Khipiṃsu niraye ghore, ",
  "pv39:22.4": "uddhaṃpādaṃ avaṃsiraṃ. ",
  "pv39:23.1": "736. ‘‘Ahaṃ pure maccharinī ahosiṃ, ",
  "pv39:23.2": "paribhāsikā samaṇabrāhmaṇānaṃ; ",
  "pv39:23.3": "Vitathena ca sāmikaṃ vañcayitvā, ",
  "pv39:23.4": "paccāmahaṃ niraye ghorarūpe’’ti. ",
  "pv39:24.1": "Revatīpetavatthu catutthaṃ. "
}
