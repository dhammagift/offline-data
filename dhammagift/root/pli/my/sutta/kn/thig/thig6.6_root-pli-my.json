  "thig6.6:0.2": "",
  "thig6.6:0.3": "6. Mahāpajāpatigotamītherīgāthā 157. ",
  "thig6.6:1.1": "‘‘Buddha vīra namo tyatthu, ",
  "thig6.6:1.2": "sabbasattānamuttama; ",
  "thig6.6:1.3": "Yo maṃ dukkhā pamocesi, ",
  "thig6.6:1.4": "aññañca bahukaṃ janaṃ. ",
  "thig6.6:2.1": "158. ‘‘Sabbadukkhaṃ pariññātaṃ, ",
  "thig6.6:2.2": "hetutaṇhā visositā; ",
  "thig6.6:2.3": "Bhāvito aṭṭhaṅgiko maggo, ",
  "thig6.6:2.4": "nirodho phusito mayā. ",
  "thig6.6:3.1": "159. ‘‘Mātā putto pitā bhātā, ",
  "thig6.6:3.2": "ayyakā ca pure ahuṃ; ",
  "thig6.6:3.3": "Yathābhuccamajānantī, ",
  "thig6.6:3.4": "saṃsariṃhaṃ anibbisaṃ. ",
  "thig6.6:4.1": "160. ‘‘Diṭṭho hi me so bhagavā, ",
  "thig6.6:4.2": "antimoyaṃ samussayo; ",
  "thig6.6:4.3": "Vikkhīṇo jātisaṃsāro, ",
  "thig6.6:4.4": "natthi dāni punabbhavo. ",
  "thig6.6:5.1": "161. ‘‘Āraddhavīriye pahitatte, ",
  "thig6.6:5.2": "niccaṃ daḷhaparakkame; ",
  "thig6.6:5.3": "Samagge sāvake passe, ",
  "thig6.6:5.4": "esā buddhāna vandanā. ",
  "thig6.6:6.1": "162. ‘‘Bahūnaṃ vata atthāya, ",
  "thig6.6:6.2": "māyā janayi gotamaṃ; ",
  "thig6.6:6.3": "Byādhimaraṇatunnānaṃ, ",
  "thig6.6:6.4": "dukkhakkhandhaṃ byapānudī’’ti. … ",
  "thig6.6:7.1": "Mahāpajāpatigotamī therī…. "
}
