{
  "thig4.1:0.1": "",
  "thig4.1:0.2": "4. Catukkanipāto ",
  "thig4.1:0.3": "1. Bhaddākāpilānītherīgāthā 63. ",
  "thig4.1:1.1": "‘‘Putto buddhassa dāyādo, ",
  "thig4.1:1.2": "kassapo susamāhito; ",
  "thig4.1:1.3": "Pubbenivāsaṃ yovedi, ",
  "thig4.1:1.4": "saggāpāyañca passati. ",
  "thig4.1:2.1": "64. ‘‘Atho jātikkhayaṃ patto, ",
  "thig4.1:2.2": "abhiññāvosito muni; ",
  "thig4.1:2.3": "Etāhi tīhi vijjāhi, ",
  "thig4.1:2.4": "tevijjo hoti brāhmaṇo. ",
  "thig4.1:3.1": "65. ‘‘Tatheva bhaddā kāpilānī, ",
  "thig4.1:3.2": "tevijjā maccuhāyinī; ",
  "thig4.1:3.3": "Dhāreti antimaṃ dehaṃ, ",
  "thig4.1:3.4": "jetvā māraṃ savāhanaṃ. ",
  "thig4.1:4.1": "66. ‘‘Disvā ādīnavaṃ loke, ",
  "thig4.1:4.2": "ubho pabbajitā mayaṃ; ",
  "thig4.1:4.3": "Tyamha khīṇāsavā dantā, ",
  "thig4.1:4.4": "sītibhūtamha nibbutā’’ti. … ",
  "thig4.1:5.1": "Bhaddā kāpilānī therī…. ",
  "thig4.1:6.1": "Catukkanipāto niṭṭhito. "
}
