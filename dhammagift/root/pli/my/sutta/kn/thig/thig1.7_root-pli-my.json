  "thig1.7:0.3": "7. 7. Vīrātherīgāthā ",
  "thig1.7:1.1": "‘‘Vīrā vīrehi dhammehi, ",
  "thig1.7:1.2": "bhikkhunī bhāvitindriyā; ",
  "thig1.7:1.3": "Dhārehi antimaṃ dehaṃ, ",
  "thig1.7:1.4": "jetvā māraṃ savāhini’’nti . … ",
  "thig1.7:2.1": "Vīrā therī…. "
}
