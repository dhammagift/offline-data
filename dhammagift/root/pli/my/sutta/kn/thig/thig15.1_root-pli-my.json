{
  "thig15.1:0.1": "15. Cattālīsanipāto ",
  "thig15.1:0.2": "",
  "thig15.1:0.3": "402. 1. Isidāsītherīgāthā ",
  "thig15.1:1.1": "Nagaramhi kusumanāme, ",
  "thig15.1:1.2": "pāṭaliputtamhi pathaviyā maṇḍe; ",
  "thig15.1:1.3": "Sakyakulakulīnāyo, ",
  "thig15.1:1.4": "dve bhikkhuniyo hi guṇavatiyo. ",
  "thig15.1:2.1": "403. Isidāsī tattha ekā, ",
  "thig15.1:2.2": "dutiyā bodhīti sīlasampannā ca; ",
  "thig15.1:2.3": "Jhānajjhāyanaratāyo, ",
  "thig15.1:2.4": "bahussutāyo dhutakilesāyo. ",
  "thig15.1:3.1": "404. Tā piṇḍāya caritvā, ",
  "thig15.1:3.2": "bhattatthaṃ kariya dhotapattāyo; ",
  "thig15.1:3.3": "Rahitamhi sukhanisinnā, ",
  "thig15.1:3.4": "imā girā abbhudīresuṃ. ",
  "thig15.1:4.1": "405. ‘‘Pāsādikāsi ayye, ",
  "thig15.1:4.2": "isidāsi vayopi te aparihīno; ",
  "thig15.1:4.3": "Kiṃ disvāna byālikaṃ, ",
  "thig15.1:4.4": "athāsi nekkhammamanuyuttā’’. ",
  "thig15.1:5.1": "406. Evamanuyuñjiyamānā sā, ",
  "thig15.1:5.2": "rahite dhammadesanākusalā; ",
  "thig15.1:5.3": "Isidāsī vacanamabravi, ",
  "thig15.1:5.4": "‘‘suṇa bodhi yathāmhi pabbajitā. ",
  "thig15.1:6.1": "407. ‘‘Ujjeniyā puravare, ",
  "thig15.1:6.2": "mayhaṃ pitā sīlasaṃvuto seṭṭhi; ",
  "thig15.1:6.3": "Tassamhi ekadhītā, ",
  "thig15.1:6.4": "piyā manāpā ca dayitā ca. ",
  "thig15.1:7.1": "408. ‘‘Atha me sāketato varakā, ",
  "thig15.1:7.2": "āgacchumuttamakulīnā; ",
  "thig15.1:7.3": "Seṭṭhī pahūtaratano, ",
  "thig15.1:7.4": "tassa mamaṃ suṇhamadāsi tāto. ",
  "thig15.1:8.1": "409. ‘‘Sassuyā sassurassa ca, ",
  "thig15.1:8.2": "sāyaṃ pātaṃ paṇāmamupagamma; ",
  "thig15.1:8.3": "Sirasā karomi pāde, ",
  "thig15.1:8.4": "vandāmi yathāmhi anusiṭṭhā. ",
  "thig15.1:9.1": "410. ‘‘Yā mayhaṃ sāmikassa, ",
  "thig15.1:9.2": "bhaginiyo bhātuno parijano vā; ",
  "thig15.1:9.3": "Tamekavarakampi disvā, ",
  "thig15.1:9.4": "ubbiggā āsanaṃ demi. ",
  "thig15.1:10.1": "411. ‘‘Annena ca pānena ca, ",
  "thig15.1:10.2": "khajjena ca yañca tattha sannihitaṃ; ",
  "thig15.1:10.3": "Chādemi upanayāmi ca, ",
  "thig15.1:10.4": "demi ca yaṃ yassa patirūpaṃ. ",
  "thig15.1:11.1": "412. ‘‘Kālena upaṭṭhahitvā , ",
  "thig15.1:11.2": "gharaṃ samupagamāmi ummāre; ",
  "thig15.1:11.3": "Dhovantī hatthapāde, ",
  "thig15.1:11.4": "pañjalikā sāmikamupemi. ",
  "thig15.1:12.1": "413. ‘‘Kocchaṃ pasādaṃ añjaniñca, ",
  "thig15.1:12.2": "ādāsakañca gaṇhitvā; ",
  "thig15.1:12.3": "Parikammakārikā viya, ",
  "thig15.1:12.4": "sayameva patiṃ vibhūsemi. ",
  "thig15.1:13.1": "414. ‘‘Sayameva odanaṃ sādhayāmi, ",
  "thig15.1:13.2": "sayameva bhājanaṃ dhovantī; ",
  "thig15.1:13.3": "Mātāva ekaputtakaṃ, ",
  "thig15.1:13.4": "tathā bhattāraṃ paricarāmi. ",
  "thig15.1:14.1": "415. ‘‘Evaṃ maṃ bhattikataṃ, ",
  "thig15.1:14.2": "anurattaṃ kārikaṃ nihatamānaṃ; ",
  "thig15.1:14.3": "Uṭṭhāyikaṃ analasaṃ, ",
  "thig15.1:14.4": "sīlavatiṃ dussate bhattā. ",
  "thig15.1:15.1": "416. ‘‘So mātarañca pitarañca, ",
  "thig15.1:15.2": "bhaṇati ‘āpucchahaṃ gamissāmi; ",
  "thig15.1:15.3": "Isidāsiyā na saha vacchaṃ, ",
  "thig15.1:15.4": "ekāgārehaṃ saha vatthuṃ’. ",
  "thig15.1:16.1": "417. ‘‘‘Mā evaṃ putta avaca, ",
  "thig15.1:16.2": "isidāsī paṇḍitā paribyattā; ",
  "thig15.1:16.3": "Uṭṭhāyikā analasā, ",
  "thig15.1:16.4": "kiṃ tuyhaṃ na rocate putta’. ",
  "thig15.1:17.1": "418. ‘‘‘Na ca me hiṃsati kiñci, ",
  "thig15.1:17.2": "na cahaṃ isidāsiyā saha vacchaṃ; ",
  "thig15.1:17.3": "Dessāva me alaṃ me, ",
  "thig15.1:17.4": "apucchāhaṃ gamissāmi’. ",
  "thig15.1:18.1": "419. ‘‘Tassa vacanaṃ suṇitvā, ",
  "thig15.1:18.2": "sassu sasuro ca maṃ apucchiṃsu; ",
  "thig15.1:18.3": "‘Kissa tayā aparaddhaṃ, ",
  "thig15.1:18.4": "bhaṇa vissaṭṭhā yathābhūtaṃ’. ",
  "thig15.1:19.1": "420. ‘‘‘Napihaṃ aparajjhaṃ kiñci, ",
  "thig15.1:19.2": "napi hiṃsemi na bhaṇāmi dubbacanaṃ; ",
  "thig15.1:19.3": "Kiṃ sakkā kātuyye, ",
  "thig15.1:19.4": "yaṃ maṃ viddessate bhattā’. ",
  "thig15.1:20.1": "421. ‘‘Te maṃ pitugharaṃ paṭinayiṃsu, ",
  "thig15.1:20.2": "vimanā dukhena adhibhūtā; ",
  "thig15.1:20.3": "‘Puttamanurakkhamānā, ",
  "thig15.1:20.4": "jitāmhase rūpiniṃ lakkhiṃ’. ",
  "thig15.1:21.1": "422. ‘‘Atha maṃ adāsi tāto, ",
  "thig15.1:21.2": "aḍḍhassa gharamhi dutiyakulikassa; ",
  "thig15.1:21.3": "Tato upaḍḍhasuṅkena, ",
  "thig15.1:21.4": "yena maṃ vindatha seṭṭhi. ",
  "thig15.1:22.1": "423. ‘‘Tassapi gharamhi māsaṃ, ",
  "thig15.1:22.2": "avasiṃ atha sopi maṃ paṭiccharayi ; ",
  "thig15.1:22.3": "Dāsīva upaṭṭhahantiṃ, ",
  "thig15.1:22.4": "adūsikaṃ sīlasampannaṃ. ",
  "thig15.1:23.1": "424. ‘‘Bhikkhāya ca vicarantaṃ, ",
  "thig15.1:23.2": "damakaṃ dantaṃ me pitā bhaṇati; ",
  "thig15.1:23.3": "‘Hohisi me jāmātā, ",
  "thig15.1:23.4": "nikkhipa poṭṭhiñca ghaṭikañca’. ",
  "thig15.1:24.1": "425. ‘‘Sopi vasitvā pakkhaṃ , ",
  "thig15.1:24.2": "atha tātaṃ bhaṇati ‘dehi me poṭṭhiṃ; ",
  "thig15.1:24.3": "Ghaṭikañca mallakañca, ",
  "thig15.1:24.4": "punapi bhikkhaṃ carissāmi’. ",
  "thig15.1:25.1": "426. ‘‘Atha naṃ bhaṇatī tāto, ",
  "thig15.1:25.2": "ammā sabbo ca me ñātigaṇavaggo; ",
  "thig15.1:25.3": "‘Kiṃ te na kīrati idha, ",
  "thig15.1:25.4": "bhaṇa khippaṃ taṃ te karihi’ti. ",
  "thig15.1:26.1": "427. ‘‘Evaṃ bhaṇito bhaṇati, ",
  "thig15.1:26.2": "‘yadi me attā sakkoti alaṃ mayhaṃ; ",
  "thig15.1:26.3": "Isidāsiyā na saha vacchaṃ, ",
  "thig15.1:26.4": "ekagharehaṃ saha vatthuṃ’. ",
  "thig15.1:27.1": "428. ‘‘Vissajjito gato so, ",
  "thig15.1:27.2": "ahampi ekākinī vicintemi; ",
  "thig15.1:27.3": "‘Āpucchitūna gacchaṃ, ",
  "thig15.1:27.4": "marituye vā pabbajissaṃ vā’. ",
  "thig15.1:28.1": "429. ‘‘Atha ayyā jinadattā, ",
  "thig15.1:28.2": "āgacchī gocarāya caramānā; ",
  "thig15.1:28.3": "Tātakulaṃ vinayadharī, ",
  "thig15.1:28.4": "bahussutā sīlasampannā. ",
  "thig15.1:29.1": "430. ‘‘Taṃ disvāna amhākaṃ, ",
  "thig15.1:29.2": "uṭṭhāyāsanaṃ tassā paññāpayiṃ; ",
  "thig15.1:29.3": "Nisinnāya ca pāde, ",
  "thig15.1:29.4": "vanditvā bhojanamadāsiṃ. ",
  "thig15.1:30.1": "431. ‘‘Annena ca pānena ca, ",
  "thig15.1:30.2": "khajjena ca yañca tattha sannihitaṃ; ",
  "thig15.1:30.3": "Santappayitvā avacaṃ, ",
  "thig15.1:30.4": "‘ayye icchāmi pabbajituṃ’. ",
  "thig15.1:31.1": "432. ‘‘Atha maṃ bhaṇatī tāto, ",
  "thig15.1:31.2": "‘idheva puttaka carāhi tvaṃ dhammaṃ; ",
  "thig15.1:31.3": "Annena ca pānena ca, ",
  "thig15.1:31.4": "tappaya samaṇe dvijātī ca’. ",
  "thig15.1:32.1": "433. ‘‘Athahaṃ bhaṇāmi tātaṃ, ",
  "thig15.1:32.2": "rodantī añjaliṃ paṇāmetvā; ",
  "thig15.1:32.3": "‘Pāpañhi mayā pakataṃ, ",
  "thig15.1:32.4": "kammaṃ taṃ nijjaressāmi’. ",
  "thig15.1:33.1": "434. ‘‘Atha maṃ bhaṇatī tāto, ",
  "thig15.1:33.2": "‘pāpuṇa bodhiñca aggadhammañca; ",
  "thig15.1:33.3": "Nibbānañca labhassu, ",
  "thig15.1:33.4": "yaṃ sacchikarī dvipadaseṭṭho’. ",
  "thig15.1:34.1": "435. ‘‘Mātāpitū abhivādayitvā, ",
  "thig15.1:34.2": "sabbañca ñātigaṇavaggaṃ; ",
  "thig15.1:34.3": "Sattāhaṃ pabbajitā, ",
  "thig15.1:34.4": "tisso vijjā aphassayiṃ. ",
  "thig15.1:35.1": "436. ‘‘Jānāmi attano satta, ",
  "thig15.1:35.2": "jātiyo yassayaṃ phalavipāko; ",
  "thig15.1:35.3": "Taṃ tava ācikkhissaṃ, ",
  "thig15.1:35.4": "taṃ ekamanā nisāmehi. ",
  "thig15.1:36.1": "437. ‘‘Nagaramhi erakacche , ",
  "thig15.1:36.2": "suvaṇṇakāro ahaṃ pahūtadhano; ",
  "thig15.1:36.3": "Yobbanamadena matto ",
  "thig15.1:36.4": "so, paradāraṃ asevihaṃ. ",
  "thig15.1:37.1": "438. ‘‘Sohaṃ tato cavitvā, ",
  "thig15.1:37.2": "nirayamhi apaccisaṃ ciraṃ; ",
  "thig15.1:37.3": "Pakko tato ca uṭṭhahitvā, ",
  "thig15.1:37.4": "makkaṭiyā kucchimokkamiṃ. ",
  "thig15.1:38.1": "439. ‘‘Sattāhajātakaṃ maṃ, ",
  "thig15.1:38.2": "mahākapi yūthapo nillacchesi; ",
  "thig15.1:38.3": "Tassetaṃ kammaphalaṃ, ",
  "thig15.1:38.4": "yathāpi gantvāna paradāraṃ. ",
  "thig15.1:39.1": "440. ‘‘Sohaṃ tato cavitvā, ",
  "thig15.1:39.2": "kālaṃ karitvā sindhavāraññe; ",
  "thig15.1:39.3": "Kāṇāya ca khañjāya ca, ",
  "thig15.1:39.4": "eḷakiyā kucchimokkamiṃ. ",
  "thig15.1:40.1": "441. ‘‘Dvādasa vassāni ahaṃ, ",
  "thig15.1:40.2": "nillacchito dārake parivahitvā; ",
  "thig15.1:40.3": "Kimināvaṭṭo akallo, ",
  "thig15.1:40.4": "yathāpi gantvāna paradāraṃ. ",
  "thig15.1:41.1": "442. ‘‘Sohaṃ tato cavitvā, ",
  "thig15.1:41.2": "govāṇijakassa gāviyā jāto; ",
  "thig15.1:41.3": "Vaccho lākhātambo, ",
  "thig15.1:41.4": "nillacchito dvādase māse. ",
  "thig15.1:42.1": "443. ‘‘Voḍhūna naṅgalamahaṃ, ",
  "thig15.1:42.2": "sakaṭañca dhārayāmi; ",
  "thig15.1:42.3": "Andhovaṭṭo akallo, ",
  "thig15.1:42.4": "yathāpi gantvāna paradāraṃ. ",
  "thig15.1:43.1": "444. ‘‘Sohaṃ tato cavitvā, ",
  "thig15.1:43.2": "vīthiyā dāsiyā ghare jāto; ",
  "thig15.1:43.3": "Neva mahilā na puriso, ",
  "thig15.1:43.4": "yathāpi gantvāna paradāraṃ. ",
  "thig15.1:44.1": "445. ‘‘Tiṃsativassamhi mato, ",
  "thig15.1:44.2": "sākaṭikakulamhi dārikā jātā; ",
  "thig15.1:44.3": "Kapaṇamhi appabhoge, ",
  "thig15.1:44.4": "dhanika purisapātabahulamhi. ",
  "thig15.1:45.1": "446. ‘‘Taṃ maṃ tato satthavāho, ",
  "thig15.1:45.2": "ussannāya vipulāya vaḍḍhiyā; ",
  "thig15.1:45.3": "Okaḍḍhati vilapantiṃ, ",
  "thig15.1:45.4": "acchinditvā kulagharasmā. ",
  "thig15.1:46.1": "447. ‘‘Atha soḷasame vasse, ",
  "thig15.1:46.2": "disvā maṃ pattayobbanaṃ kaññaṃ; ",
  "thig15.1:46.3": "Orundhatassa putto, ",
  "thig15.1:46.4": "giridāso nāma nāmena. ",
  "thig15.1:47.1": "448. ‘‘Tassapi aññā bhariyā, ",
  "thig15.1:47.2": "sīlavatī guṇavatī yasavatī ca; ",
  "thig15.1:47.3": "Anurattā bhattāraṃ, ",
  "thig15.1:47.4": "tassāhaṃ viddesanamakāsiṃ. ",
  "thig15.1:48.1": "449. ‘‘Tassetaṃ kammaphalaṃ, ",
  "thig15.1:48.2": "yaṃ maṃ apakīritūna gacchanti; ",
  "thig15.1:48.3": "Dāsīva upaṭṭhahantiṃ, ",
  "thig15.1:48.4": "tassapi anto kato mayā’’ti. … ",
  "thig15.1:49.1": "Isidāsī therī…. ",
  "thig15.1:50.1": "Cattālīsanipāto niṭṭhito. "
}
