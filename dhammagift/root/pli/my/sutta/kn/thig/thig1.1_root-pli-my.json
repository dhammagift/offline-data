{
  "thig1.1:0.1": "Khuddakanikāye Therīgāthāpāḷi ",
  "thig1.1:0.2": "1. Ekakanipāto ",
  "thig1.1:0.3": "1. Aññatarātherīgāthā 1. ",
  "thig1.1:1.0": "Namo tassa bhagavato arahato sammāsambuddhassa ",
  "thig1.1:1.1": "‘‘Sukhaṃ supāhi therike, ",
  "thig1.1:1.2": "katvā coḷena pārutā; ",
  "thig1.1:1.3": "Upasanto hi te rāgo, ",
  "thig1.1:1.4": "sukkhaḍākaṃ va kumbhiya’’nti. ",
  "thig1.1:2.1": "Itthaṃ sudaṃ aññatarā therī apaññātā bhikkhunī gāthaṃ abhāsitthāti. "
}
