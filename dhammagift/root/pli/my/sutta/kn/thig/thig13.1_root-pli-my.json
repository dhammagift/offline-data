{
  "thig13.1:0.1": "",
  "thig13.1:0.2": "13. Vīsatinipāto ",
  "thig13.1:0.3": "1. Ambapālītherīgāthā 252. ",
  "thig13.1:1.1": "‘‘Kāḷakā bhamaravaṇṇasādisā, ",
  "thig13.1:1.2": "vellitaggā mama muddhajā ahuṃ; ",
  "thig13.1:1.3": "Te jarāya sāṇavākasādisā, ",
  "thig13.1:1.4": "saccavādivacanaṃ anaññathā. ",
  "thig13.1:2.1": "253. ‘‘Vāsitova surabhī karaṇḍako, ",
  "thig13.1:2.2": "pupphapūra mama uttamaṅgajo . ",
  "thig13.1:2.3": "Taṃ jarāyatha salomagandhikaṃ, ",
  "thig13.1:2.4": "saccavādivacanaṃ anaññathā. ",
  "thig13.1:3.1": "254. ‘‘Kānanaṃva sahitaṃ suropitaṃ, ",
  "thig13.1:3.2": "kocchasūcivicitaggasobhitaṃ; ",
  "thig13.1:3.3": "Taṃ jarāya viralaṃ tahiṃ tahiṃ, ",
  "thig13.1:3.4": "saccavādivacanaṃ anaññathā. ",
  "thig13.1:4.1": "255. ‘‘Kaṇhakhandhakasuvaṇṇamaṇḍitaṃ, ",
  "thig13.1:4.2": "sobhate suveṇīhilaṅkataṃ; ",
  "thig13.1:4.3": "Taṃ jarāya khalitaṃ siraṃ kataṃ, ",
  "thig13.1:4.4": "saccavādivacanaṃ anaññathā. ",
  "thig13.1:5.1": "256. ‘‘Cittakārasukatāva lekhikā, ",
  "thig13.1:5.2": "sobhare su bhamukā pure mama; ",
  "thig13.1:5.3": "Tā jarāya valibhippalambitā, ",
  "thig13.1:5.4": "saccavādivacanaṃ anaññathā. ",
  "thig13.1:6.1": "257. ‘‘Bhassarā surucirā yathā maṇī, ",
  "thig13.1:6.2": "nettahesumabhinīlamāyatā; ",
  "thig13.1:6.3": "Te jarāyabhihatā na sobhare, ",
  "thig13.1:6.4": "saccavādivacanaṃ anaññathā. ",
  "thig13.1:7.1": "258. ‘‘Saṇhatuṅgasadisī ca nāsikā, ",
  "thig13.1:7.2": "sobhate su abhiyobbanaṃ pati; ",
  "thig13.1:7.3": "Sā jarāya upakūlitā viya, ",
  "thig13.1:7.4": "saccavādivacanaṃ anaññathā. ",
  "thig13.1:8.1": "259. ‘‘Kaṅkaṇaṃ va sukataṃ suniṭṭhitaṃ, ",
  "thig13.1:8.2": "sobhare su mama kaṇṇapāḷiyo; ",
  "thig13.1:8.3": "Tā jarāya valibhippalambitā, ",
  "thig13.1:8.4": "saccavādivacanaṃ anaññathā. ",
  "thig13.1:9.1": "260. ‘‘Pattalīmakulavaṇṇasādisā, ",
  "thig13.1:9.2": "sobhare su dantā pure mama; ",
  "thig13.1:9.3": "Te jarāya khaṇḍitā cāsitā , ",
  "thig13.1:9.4": "saccavādivacanaṃ anaññathā. ",
  "thig13.1:10.1": "261. ‘‘Kānanamhi vanasaṇḍacārinī, ",
  "thig13.1:10.2": "kokilāva madhuraṃ nikūjihaṃ; ",
  "thig13.1:10.3": "Taṃ jarāya khalitaṃ tahiṃ tahiṃ, ",
  "thig13.1:10.4": "saccavādivacanaṃ anaññathā. ",
  "thig13.1:11.1": "262. ‘‘Saṇhakamburiva suppamajjitā, ",
  "thig13.1:11.2": "sobhate su gīvā pure mama; ",
  "thig13.1:11.3": "Sā jarāya bhaggā vināmitā, ",
  "thig13.1:11.4": "saccavādivacanaṃ anaññathā. ",
  "thig13.1:12.1": "263. ‘‘Vaṭṭapalighasadisopamā ubho, ",
  "thig13.1:12.2": "sobhare su bāhā pure mama; ",
  "thig13.1:12.3": "Tā jarāya yatha pāṭalibbalitā , ",
  "thig13.1:12.4": "saccavādivacanaṃ anaññathā. ",
  "thig13.1:13.1": "264. ‘‘Saṇhamuddikasuvaṇṇamaṇḍitā, ",
  "thig13.1:13.2": "sobhare su hatthā pure mama; ",
  "thig13.1:13.3": "Te jarāya yathā mūlamūlikā, ",
  "thig13.1:13.4": "saccavādivacanaṃ anaññathā. ",
  "thig13.1:14.1": "265. ‘‘Pīnavaṭṭasahituggatā ubho, ",
  "thig13.1:14.2": "sobhare su thanakā pure mama; ",
  "thig13.1:14.3": "Thevikīva lambanti nodakā, ",
  "thig13.1:14.4": "saccavādivacanaṃ anaññathā. ",
  "thig13.1:15.1": "266. ‘‘Kañcanassaphalakaṃva sammaṭṭhaṃ, ",
  "thig13.1:15.2": "sobhate su kāyo pure mama; ",
  "thig13.1:15.3": "So valīhi sukhumāhi otato, ",
  "thig13.1:15.4": "saccavādivacanaṃ anaññathā. ",
  "thig13.1:16.1": "267. ‘‘Nāgabhogasadisopamā ubho, ",
  "thig13.1:16.2": "sobhare su ūrū pure mama; ",
  "thig13.1:16.3": "Te jarāya yathā veḷunāḷiyo, ",
  "thig13.1:16.4": "saccavādivacanaṃ anaññathā. ",
  "thig13.1:17.1": "268. ‘‘Saṇhanūpurasuvaṇṇamaṇḍitā, ",
  "thig13.1:17.2": "sobhare su jaṅghā pure mama; ",
  "thig13.1:17.3": "Tā jarāya tiladaṇḍakāriva, ",
  "thig13.1:17.4": "saccavādivacanaṃ anaññathā. ",
  "thig13.1:18.1": "269. ‘‘Tūlapuṇṇasadisopamā ubho, ",
  "thig13.1:18.2": "sobhare su pādā pure mama; ",
  "thig13.1:18.3": "Te jarāya phuṭitā valīmatā, ",
  "thig13.1:18.4": "saccavādivacanaṃ anaññathā. ",
  "thig13.1:19.1": "270. ‘‘Ediso ahu ayaṃ samussayo, ",
  "thig13.1:19.2": "jajjaro bahudukkhānamālayo; ",
  "thig13.1:19.3": "Sopalepapatito jarāgharo, ",
  "thig13.1:19.4": "saccavādivacanaṃ anaññathā’’. … ",
  "thig13.1:20.1": "Ambapālī therī…. "
}
