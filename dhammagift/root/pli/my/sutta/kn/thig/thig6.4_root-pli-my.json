  "thig6.4:0.2": "",
  "thig6.4:0.3": "145. 4. Sujātātherīgāthā ",
  "thig6.4:1.1": "‘‘Alaṅkatā suvasanā, ",
  "thig6.4:1.2": "mālinī candanokkhitā; ",
  "thig6.4:1.3": "Sabbābharaṇasañchannā, ",
  "thig6.4:1.4": "dāsīgaṇapurakkhatā. ",
  "thig6.4:2.1": "146. ‘‘Annaṃ pānañca ādāya, ",
  "thig6.4:2.2": "khajjaṃ bhojjaṃ anappakaṃ; ",
  "thig6.4:2.3": "Gehato nikkhamitvāna, ",
  "thig6.4:2.4": "uyyānamabhihārayiṃ. ",
  "thig6.4:3.1": "147. ‘‘Tattha ramitvā kīḷitvā, ",
  "thig6.4:3.2": "āgacchantī sakaṃ gharaṃ; ",
  "thig6.4:3.3": "Vihāraṃ daṭṭhuṃ pāvisiṃ, ",
  "thig6.4:3.4": "sākete añjanaṃ vanaṃ. ",
  "thig6.4:4.1": "148. ‘‘Disvāna lokapajjotaṃ, ",
  "thig6.4:4.2": "vanditvāna upāvisiṃ; ",
  "thig6.4:4.3": "So me dhammamadesesi, ",
  "thig6.4:4.4": "anukampāya cakkhumā. ",
  "thig6.4:5.1": "149. ‘‘Sutvā ca kho mahesissa, ",
  "thig6.4:5.2": "saccaṃ sampaṭivijjhahaṃ; ",
  "thig6.4:5.3": "Tattheva virajaṃ dhammaṃ, ",
  "thig6.4:5.4": "phusayiṃ amataṃ padaṃ. ",
  "thig6.4:6.1": "150. ‘‘Tato viññātasaddhammā, ",
  "thig6.4:6.2": "pabbajiṃ anagāriyaṃ; ",
  "thig6.4:6.3": "Tisso vijjā anuppattā, ",
  "thig6.4:6.4": "amoghaṃ buddhasāsana’’nti. … ",
  "thig6.4:7.1": "Sujātā therī…. "
}
