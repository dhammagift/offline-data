  "thig3.8:0.3": "8. Somātherīgāthā 60. ",
  "thig3.8:1.1": "‘‘Yaṃ taṃ isīhi pattabbaṃ, ",
  "thig3.8:1.2": "ṭhānaṃ durabhisambhavaṃ; ",
  "thig3.8:1.3": "Na taṃ dvaṅgulapaññāya, ",
  "thig3.8:1.4": "sakkā pappotumitthiyā’’. ",
  "thig3.8:2.1": "61. ‘‘Itthibhāvo no kiṃ kayirā, ",
  "thig3.8:2.2": "cittamhi susamāhite; ",
  "thig3.8:2.3": "Ñāṇamhi vattamānamhi, ",
  "thig3.8:2.4": "sammā dhammaṃ vipassato. ",
  "thig3.8:3.1": "62. ‘‘Sabbattha vihatā nandī, ",
  "thig3.8:3.2": "tamokhandho padālito; ",
  "thig3.8:3.3": "Evaṃ jānāhi pāpima, ",
  "thig3.8:3.4": "nihato tvamasi antakā’’ti. … ",
  "thig3.8:4.1": "Somā therī…. ",
  "thig3.8:5.1": "Tikanipāto niṭṭhito. "
}
