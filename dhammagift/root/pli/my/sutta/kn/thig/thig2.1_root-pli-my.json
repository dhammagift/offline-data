{
  "thig2.1:0.1": "",
  "thig2.1:0.2": "2. Dukanipāto ",
  "thig2.1:0.3": "1. Abhirūpanandātherīgāthā 19. ",
  "thig2.1:1.1": "‘‘Āturaṃ asuciṃ pūtiṃ, ",
  "thig2.1:1.2": "passa nande samussayaṃ; ",
  "thig2.1:1.3": "Asubhāya cittaṃ bhāvehi, ",
  "thig2.1:1.4": "ekaggaṃ susamāhitaṃ. ",
  "thig2.1:2.1": "20. ‘‘Animittañca bhāvehi, ",
  "thig2.1:2.2": "mānānusayamujjaha; ",
  "thig2.1:2.3": "Tato mānābhisamayā, ",
  "thig2.1:2.4": "upasantā carissasī’’ti. ",
  "thig2.1:3.1": "Itthaṃ sudaṃ bhagavā abhirūpanandaṃ sikkhamānaṃ imāhi gāthāhi abhiṇhaṃ ovadatīti . "
}
