  "thig2.10:0.2": "",
  "thig2.10:0.3": "37. 10. Sāmātherīgāthā ",
  "thig2.10:1.1": "‘‘Catukkhattuṃ pañcakkhattuṃ, ",
  "thig2.10:1.2": "vihārā upanikkhamiṃ; ",
  "thig2.10:1.3": "Aladdhā cetaso santiṃ, ",
  "thig2.10:1.4": "citte avasavattinī; ",
  "thig2.10:1.5": "Tassā me aṭṭhamī ratti, ",
  "thig2.10:1.6": "yato taṇhā samūhatā. ",
  "thig2.10:2.1": "38. ‘‘Bahūhi dukkhadhammehi, ",
  "thig2.10:2.2": "appamādaratāya me; ",
  "thig2.10:2.3": "Taṇhakkhayo anuppatto, ",
  "thig2.10:2.4": "kataṃ buddhassa sāsana’’nti. … ",
  "thig2.10:3.1": "Sāmā therī…. ",
  "thig2.10:4.1": "Dukanipāto niṭṭhito. "
}
