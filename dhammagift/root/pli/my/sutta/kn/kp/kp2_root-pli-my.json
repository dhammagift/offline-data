{
  "kp2:0.1": "",
  "kp2:0.2": "2. Dasasikkhāpadaṃ ",
  "kp2:1.1": "Pāṇātipātā veramaṇī-sikkhāpadaṃ samādiyāmi. ",
  "kp2:2.1": "Adinnādānā veramaṇī-sikkhāpadaṃ samādiyāmi. ",
  "kp2:3.1": "Abrahmacariyā veramaṇī-sikkhāpadaṃ samādiyāmi. ",
  "kp2:4.1": "Musāvādā veramaṇī-sikkhāpadaṃ samādiyāmi. ",
  "kp2:5.1": "Surāmerayamajjapamādaṭṭhānā veramaṇī-sikkhāpadaṃ samādiyāmi. ",
  "kp2:6.1": "Vikālabhojanā veramaṇī-sikkhāpadaṃ samādiyāmi. ",
  "kp2:7.1": "Nacca-gīta-vādita-visūkadassanā veramaṇī-sikkhāpadaṃ samādiyāmi. ",
  "kp2:8.1": "Mālā-gandha-vilepana-dhāraṇa-maṇḍana-vibhūsanaṭṭhānā veramaṇī-sikkhāpadaṃ samādiyāmi. ",
  "kp2:9.1": "Uccāsayana-mahāsayanā veramaṇī-sikkhāpadaṃ samādiyāmi. ",
  "kp2:10.1": "Jātarūpa-rajatapaṭiggahaṇā veramaṇī-sikkhāpadaṃ samādiyāmi. ",
  "kp2:11.1": "Dasasikkhāpadaṃ niṭṭhitaṃ. "
}
