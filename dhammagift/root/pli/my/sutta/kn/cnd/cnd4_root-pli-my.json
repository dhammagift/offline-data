  "cnd4:0.3": "18. Pārāyanānugītigāthā 156. ",
  "cnd4:1.1": "‘‘Pārāyanamanugāyissaṃ, ",
  "cnd4:1.2": "[iccāyasmā piṅgiyo] ",
  "cnd4:1.3": "Yathāddakkhi tathākkhāsi, ",
  "cnd4:1.4": "vimalo bhūrimedhaso; ",
  "cnd4:1.5": "Nikkāmo nibbano nāgo, ",
  "cnd4:1.6": "kissa hetu musā bhaṇe. ",
  "cnd4:2.1": "157. ‘‘Pahīnamalamohassa, ",
  "cnd4:2.2": "mānamakkhappahāyino; ",
  "cnd4:2.3": "Handāhaṃ kittayissāmi, ",
  "cnd4:2.4": "giraṃ vaṇṇūpasañhitaṃ. ",
  "cnd4:3.1": "158. ‘‘Tamonudo buddho samantacakkhu, ",
  "cnd4:3.2": "lokantagū sabbabhavātivatto; ",
  "cnd4:3.3": "Anāsavo sabbadukkhappahīno, ",
  "cnd4:3.4": "saccavhayo brahme upāsito me. ",
  "cnd4:4.1": "159. ‘‘Dijo yathā kubbanakaṃ pahāya, ",
  "cnd4:4.2": "bahupphalaṃ kānanamāvaseyya; ",
  "cnd4:4.3": "Evampahaṃ appadasse pahāya, ",
  "cnd4:4.4": "mahodadhiṃ haṃsoriva ajjhapatto. ",
  "cnd4:5.1": "160. ‘‘Yeme pubbe viyākaṃsu, ",
  "cnd4:5.2": "huraṃ gotamasāsanā; ",
  "cnd4:5.3": "Iccāsi iti bhavissati; ",
  "cnd4:5.4": "Sabbaṃ taṃ itihītihaṃ, ",
  "cnd4:5.5": "sabbaṃ taṃ takkavaḍḍhanaṃ. ",
  "cnd4:6.1": "161. ‘‘Eko tamanudāsino, ",
  "cnd4:6.2": "jutimā so pabhaṅkaro; ",
  "cnd4:6.3": "Gotamo bhūripaññāṇo, ",
  "cnd4:6.4": "gotamo bhūrimedhaso. ",
  "cnd4:7.1": "162. ‘‘Yo me dhammamadesesi, ",
  "cnd4:7.2": "sandiṭṭhikamakālikaṃ; ",
  "cnd4:7.3": "Taṇhakkhayamanītikaṃ, ",
  "cnd4:7.4": "yassa natthi upamā kvaci’’. ",
  "cnd4:8.1": "163. ‘‘Kiṃ nu tamhā vippavasasi, ",
  "cnd4:8.2": "muhuttamapi piṅgiya; ",
  "cnd4:8.3": "Gotamā bhūripaññāṇā, ",
  "cnd4:8.4": "gotamā bhūrimedhasā. ",
  "cnd4:9.1": "164. ‘‘Yo te dhammamadesesi, ",
  "cnd4:9.2": "sandiṭṭhikamakālikaṃ; ",
  "cnd4:9.3": "Taṇhakkhayamanītikaṃ, ",
  "cnd4:9.4": "yassa natthi upamā kvaci’’. ",
  "cnd4:10.1": "165. ‘‘Nāhaṃ tamhā vippavasāmi, ",
  "cnd4:10.2": "muhuttamapi brāhmaṇa; ",
  "cnd4:10.3": "Gotamā bhūripaññāṇā, ",
  "cnd4:10.4": "gotamā bhūrimedhasā. ",
  "cnd4:11.1": "166. ‘‘Yo me dhammamadesesi, ",
  "cnd4:11.2": "sandiṭṭhikamakālikaṃ; ",
  "cnd4:11.3": "Taṇhakkhayamanītikaṃ, ",
  "cnd4:11.4": "yassa natthi upamā kvaci. ",
  "cnd4:12.1": "167. ‘‘Passāmi naṃ manasā cakkhunāva, ",
  "cnd4:12.2": "rattindivaṃ brāhmaṇa appamatto. ",
  "cnd4:12.3": "Namassamāno vivasemi rattiṃ, ",
  "cnd4:12.4": "teneva maññāmi avippavāsaṃ. ",
  "cnd4:13.1": "168. ‘‘Saddhā ca pīti ca mano sati ca, ",
  "cnd4:13.2": "Nāpentime gotamasāsanamhā; ",
  "cnd4:13.3": "Yaṃ yaṃ disaṃ vajati bhūripañño, ",
  "cnd4:13.4": "sa tena teneva natohamasmi. ",
  "cnd4:14.1": "169. ‘‘Jiṇṇassa me dubbalathāmakassa, ",
  "cnd4:14.2": "teneva kāyo na paleti tattha; ",
  "cnd4:14.3": "Saṅkappayantāya vajāmi niccaṃ, ",
  "cnd4:14.4": "mano hi me brāhmaṇa tena yutto. ",
  "cnd4:15.1": "170. ‘‘Paṅke sayāno pariphandamāno, ",
  "cnd4:15.2": "dīpā dīpaṃ upallaviṃ; ",
  "cnd4:15.3": "Athaddasāsiṃ sambuddhaṃ, ",
  "cnd4:15.4": "oghatiṇṇamanāsavaṃ. ",
  "cnd4:16.1": "171. ‘‘Yathā ahū vakkali muttasaddho, ",
  "cnd4:16.2": "bhadrāvudho āḷavigotamo ca; ",
  "cnd4:16.3": "Evameva tvampi pamuñcassu saddhaṃ, ",
  "cnd4:16.4": "gamissasi tvaṃ piṅgiya maccudheyyassa pāraṃ’’ . ",
  "cnd4:17.1": "172. ‘‘Esa bhiyyo pasīdāmi, ",
  "cnd4:17.2": "sutvāna munino vaco; ",
  "cnd4:17.3": "Vivaṭṭacchado sambuddho, ",
  "cnd4:17.4": "akhilo paṭibhānavā. ",
  "cnd4:18.1": "173. ‘‘Adhideve abhiññāya, ",
  "cnd4:18.2": "sabbaṃ vedi paroparaṃ; ",
  "cnd4:18.3": "Pañhānantakaro satthā, ",
  "cnd4:18.4": "kaṅkhīnaṃ paṭijānataṃ. ",
  "cnd4:19.1": "174. ‘‘Asaṃhīraṃ asaṃkuppaṃ, ",
  "cnd4:19.2": "yassa natthi upamā kvaci; ",
  "cnd4:19.3": "Addhā gamissāmi na mettha kaṅkhā, ",
  "cnd4:19.4": "evaṃ maṃ dhārehi adhimuttacitta’’nti . ",
  "cnd4:19.5": "Pārāyanānugītigāthā niṭṭhitā. "
}
