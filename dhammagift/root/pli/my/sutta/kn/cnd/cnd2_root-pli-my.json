{
  "cnd2:0.1": "",
  "cnd2:0.2": "",
  "cnd2:0.3": "57. 1. Ajitamāṇavapucchā ",
  "cnd2:1.0.1": "",
  "cnd2:1.1": "‘‘Kenassu nivuto loko, ",
  "cnd2:1.2": "[iccāyasmā ajito] ",
  "cnd2:1.3": "Kenassu nappakāsati; ",
  "cnd2:1.4": "Kissābhilepanaṃ brūsi, ",
  "cnd2:1.5": "kiṃsu tassa mahabbhayaṃ’’. ",
  "cnd2:2.1": "58. ‘‘Avijjāya nivuto loko, ",
  "cnd2:2.2": "[ajitāti bhagavā] ",
  "cnd2:2.3": "Vevicchā pamādā nappakāsati; ",
  "cnd2:2.4": "Jappābhilepanaṃ brūmi, ",
  "cnd2:2.5": "dukkhamassa mahabbhayaṃ’’. ",
  "cnd2:3.1": "59. ‘‘Savanti sabbadhi sotā, ",
  "cnd2:3.2": "[iccāyasmā ajito] ",
  "cnd2:3.3": "Sotānaṃ kiṃ nivāraṇaṃ; ",
  "cnd2:3.4": "Sotānaṃ saṃvaraṃ brūhi, ",
  "cnd2:3.5": "kena sotā pidhiyyare’’. ",
  "cnd2:4.1": "60. ‘‘Yāni sotāni lokasmiṃ, ",
  "cnd2:4.2": "[ajitāti bhagavā] ",
  "cnd2:4.3": "Sati tesaṃ nivāraṇaṃ; ",
  "cnd2:4.4": "Sotānaṃ saṃvaraṃ brūmi, ",
  "cnd2:4.5": "paññāyete pidhiyyare’’. ",
  "cnd2:5.1": "61. ‘‘Paññā ceva sati cāpi , ",
  "cnd2:5.2": "[iccāyasmā ajito] ",
  "cnd2:5.3": "Nāmarūpañca mārisa; ",
  "cnd2:5.4": "Etaṃ me puṭṭho pabrūhi, ",
  "cnd2:5.5": "katthetaṃ uparujjhati’’. ",
  "cnd2:6.1": "62. ‘‘Yametaṃ pañhaṃ apucchi, ",
  "cnd2:6.2": "ajita taṃ vadāmi te; ",
  "cnd2:6.3": "Yattha nāmañca rūpañca, ",
  "cnd2:6.4": "asesaṃ uparujjhati; ",
  "cnd2:6.5": "Viññāṇassa nirodhena, ",
  "cnd2:6.6": "etthetaṃ uparujjhati’’. ",
  "cnd2:7.1": "63. ‘‘Ye ca saṅkhātadhammāse, ",
  "cnd2:7.2": "ye ca sekhā puthū idha; ",
  "cnd2:7.3": "Tesaṃ me nipako iriyaṃ, ",
  "cnd2:7.4": "puṭṭho pabrūhi mārisa’’. ",
  "cnd2:8.1": "64. ‘‘Kāmesu nābhigijjheyya, ",
  "cnd2:8.2": "manasānāvilo siyā; ",
  "cnd2:8.3": "Kusalo sabbadhammānaṃ, ",
  "cnd2:8.4": "sato bhikkhu paribbaje’’ti. ",
  "cnd2:8.5": "Ajitamāṇavapucchā paṭhamā. ",
  "cnd2:9.0": "2. Tissametteyyamāṇavapucchā 65. ",
  "cnd2:9.1": "‘‘Kodha santusito loke, ",
  "cnd2:9.2": "[iccāyasmā tissametteyyo] ",
  "cnd2:9.3": "Kassa no santi iñjitā; ",
  "cnd2:9.4": "Ko ubhantamabhiññāya, ",
  "cnd2:9.5": "majjhe mantā na lippati ; ",
  "cnd2:9.6": "Kaṃ brūsi mahāpurisoti, ",
  "cnd2:9.7": "ko idha sibbinimaccagā’’ti . ",
  "cnd2:10.1": "66. ‘‘Kāmesu brahmacariyavā, ",
  "cnd2:10.2": "[metteyyāti bhagavā] ",
  "cnd2:10.3": "Vītataṇho sadā sato; ",
  "cnd2:10.4": "Saṅkhāya nibbuto bhikkhu, ",
  "cnd2:10.5": "tassa no santi iñjitā. ",
  "cnd2:11.1": "67. ‘‘So ubhantamabhiññāya, ",
  "cnd2:11.2": "majjhe mantā na lippati; ",
  "cnd2:11.3": "Taṃ brūmi mahāpurisoti, ",
  "cnd2:11.4": "so idha sibbinimaccagā’’ti. ",
  "cnd2:11.5": "Tissametteyyamāṇavapucchā dutiyā. ",
  "cnd2:12.0": "3. Puṇṇakamāṇavapucchā 68. ",
  "cnd2:12.1": "‘‘Anejaṃ mūladassāviṃ, ",
  "cnd2:12.2": "[iccāyasmā puṇṇako] ",
  "cnd2:12.3": "Atthi pañhena āgamaṃ; ",
  "cnd2:12.4": "Kiṃ nissitā isayo manujā, ",
  "cnd2:12.5": "khattiyā brāhmaṇā devatānaṃ; ",
  "cnd2:12.6": "Yaññamakappayiṃsu puthūdha loke, ",
  "cnd2:12.7": "pucchāmi taṃ bhagavā brūhi metaṃ’’. ",
  "cnd2:13.1": "69. ‘‘Ye kecime isayo manujā, ",
  "cnd2:13.2": "[puṇṇakāti bhagavā] ",
  "cnd2:13.3": "Khattiyā brāhmaṇā devatānaṃ; ",
  "cnd2:13.4": "Yaññamakappayiṃsu puthūdha loke, ",
  "cnd2:13.5": "āsīsamānā puṇṇaka itthattaṃ; ",
  "cnd2:13.6": "Jaraṃ sitā yaññamakappayiṃsu’’. ",
  "cnd2:14.1": "70. ‘‘Ye kecime isayo manujā, ",
  "cnd2:14.2": "[iccāyasmā puṇṇako] ",
  "cnd2:14.3": "Khattiyā brāhmaṇā devatānaṃ; ",
  "cnd2:14.4": "Yaññamakappayiṃsu puthūdha loke, ",
  "cnd2:14.5": "kaccisu te bhagavā yaññapathe appamattā; ",
  "cnd2:14.6": "Atāruṃ jātiñca jarañca mārisa, ",
  "cnd2:14.7": "pucchāmi taṃ bhagavā brūhi metaṃ’’. ",
  "cnd2:15.1": "71. ‘‘Āsīsanti thomayanti, abhijappanti juhanti; ",
  "cnd2:15.2": "[Puṇṇakāti bhagavā] ",
  "cnd2:15.3": "Kāmābhijappanti paṭicca lābhaṃ, ",
  "cnd2:15.4": "te yājayogā bhavarāgarattā; ",
  "cnd2:15.5": "Nātariṃsu jātijaranti brūmi’’. ",
  "cnd2:16.1": "72. ‘‘Te ce nātariṃsu yājayogā, ",
  "cnd2:16.2": "[iccāyasmā puṇṇako] ",
  "cnd2:16.3": "Yaññehi jātiñca jarañca mārisa; ",
  "cnd2:16.4": "Atha ko carahi devamanussaloke, ",
  "cnd2:16.5": "atāri jātiñca jarañca mārisa; ",
  "cnd2:16.6": "Pucchāmi taṃ bhagavā brūhi metaṃ’’. ",
  "cnd2:17.1": "73. ‘‘Saṅkhāya lokasmi paroparāni, ",
  "cnd2:17.2": "[puṇṇakāti bhagavā] ",
  "cnd2:17.3": "Yassiñjitaṃ natthi kuhiñci loke; ",
  "cnd2:17.4": "Santo vidhūmo anīgho nirāso, ",
  "cnd2:17.5": "atāri so jātijaranti brūmī’’ti. ",
  "cnd2:17.6": "Puṇṇakamāṇavapucchā tatiyā. ",
  "cnd2:18.0": "4. Mettagūmāṇavapucchā 74. ",
  "cnd2:18.1": "‘‘Pucchāmi taṃ bhagavā brūhi metaṃ, ",
  "cnd2:18.2": "[iccāyasmā mettagū] ",
  "cnd2:18.3": "Maññāmi taṃ vedaguṃ bhāvitattaṃ; ",
  "cnd2:18.4": "Kuto nu dukkhā samudāgatā ime, ",
  "cnd2:18.5": "ye keci lokasmimanekarūpā’’. ",
  "cnd2:19.1": "75. ‘‘Dukkhassa ve maṃ pabhavaṃ apucchasi, ",
  "cnd2:19.2": "[mettagūti bhagavā] ",
  "cnd2:19.3": "Taṃ te pavakkhāmi yathā pajānaṃ; ",
  "cnd2:19.4": "Upadhinidānā pabhavanti dukkhā, ",
  "cnd2:19.5": "ye keci lokasmimanekarūpā. ",
  "cnd2:20.1": "76. ‘‘Yo ve avidvā upadhiṃ karoti, ",
  "cnd2:20.2": "punappunaṃ dukkhamupeti mando; ",
  "cnd2:20.3": "Tasmā pajānaṃ upadhiṃ na kayirā, ",
  "cnd2:20.4": "dukkhassa jātippabhavānupassī’’. ",
  "cnd2:21.1": "77. ‘‘Yaṃ taṃ apucchimha akittayī no, ",
  "cnd2:21.2": "aññaṃ taṃ pucchāma tadiṅgha brūhi; ",
  "cnd2:21.3": "‘Kathaṃ nu dhīrā vitaranti oghaṃ, ",
  "cnd2:21.4": "jātiṃ jaraṃ sokapariddavañca’; ",
  "cnd2:21.5": "Taṃ me muni sādhu viyākarohi, ",
  "cnd2:21.6": "tathā hi te vidito esa dhammo’’. ",
  "cnd2:22.1": "78. ‘‘Kittayissāmi te dhammaṃ, ",
  "cnd2:22.2": "[mettagūti bhagavā] ",
  "cnd2:22.3": "Diṭṭhe dhamme anītihaṃ; ",
  "cnd2:22.4": "Yaṃ viditvā sato caraṃ, ",
  "cnd2:22.5": "tare loke visattikaṃ’’. ",
  "cnd2:23.1": "79. ‘‘Tañcāhaṃ abhinandāmi, ",
  "cnd2:23.2": "mahesi dhammamuttamaṃ; ",
  "cnd2:23.3": "Yaṃ viditvā sato caraṃ, ",
  "cnd2:23.4": "tare loke visattikaṃ’’. ",
  "cnd2:24.1": "80. ‘‘Yaṃ kiñci sampajānāsi, ",
  "cnd2:24.2": "[mettagūti bhagavā] ",
  "cnd2:24.3": "Uddhaṃ adho tiriyañcāpi majjhe; ",
  "cnd2:24.4": "Etesu nandiñca nivesanañca, ",
  "cnd2:24.5": "panujja viññāṇaṃ bhave na tiṭṭhe. ",
  "cnd2:25.1": "81. ‘‘Evaṃvihārī sato appamatto, ",
  "cnd2:25.2": "bhikkhu caraṃ hitvā mamāyitāni; ",
  "cnd2:25.3": "Jātiṃ jaraṃ sokapariddavañca, ",
  "cnd2:25.4": "idheva vidvā pajaheyya dukkhaṃ’’. ",
  "cnd2:26.1": "82. ‘‘Etābhinandāmi vaco mahesino, ",
  "cnd2:26.2": "sukittitaṃ gotamanūpadhīkaṃ; ",
  "cnd2:26.3": "Addhā hi bhagavā pahāsi dukkhaṃ, ",
  "cnd2:26.4": "tathā hi te vidito esa dhammo. ",
  "cnd2:27.1": "83. ‘‘Te cāpi nūnappajaheyyu dukkhaṃ, ",
  "cnd2:27.2": "ye tvaṃ muni aṭṭhitaṃ ovadeyya; ",
  "cnd2:27.3": "Taṃ taṃ namassāmi samecca nāga, ",
  "cnd2:27.4": "appeva maṃ bhagavā aṭṭhitaṃ ovadeyya’’. ",
  "cnd2:28.1": "84. ‘‘Yaṃ brāhmaṇaṃ vedagumābhijaññā, ",
  "cnd2:28.2": "akiñcanaṃ kāmabhave asattaṃ; ",
  "cnd2:28.3": "Addhā hi so oghamimaṃ atāri, ",
  "cnd2:28.4": "tiṇṇo ca pāraṃ akhilo akaṅkho. ",
  "cnd2:29.1": "85. ‘‘Vidvā ca yo vedagū naro idha, ",
  "cnd2:29.2": "bhavābhave saṅgamimaṃ visajja; ",
  "cnd2:29.3": "So vītataṇho anīgho nirāso, ",
  "cnd2:29.4": "atāri so jātijaranti brūmī’’ti. ",
  "cnd2:29.5": "Mettagūmāṇavapucchā catutthī. ",
  "cnd2:30.0": "5. Dhotakamāṇavapucchā 86. ",
  "cnd2:30.1": "‘‘Pucchāmi taṃ bhagavā brūhi metaṃ, ",
  "cnd2:30.2": "[iccāyasmā dhotako] ",
  "cnd2:30.3": "Vācābhikaṅkhāmi mahesi tuyhaṃ; ",
  "cnd2:30.4": "Tava sutvāna nigghosaṃ, ",
  "cnd2:30.5": "sikkhe nibbānamattano’’. ",
  "cnd2:31.1": "87. ‘‘Tenahātappaṃ karohi, ",
  "cnd2:31.2": "[dhotakāti bhagavā] ",
  "cnd2:31.3": "Idheva nipako sato; ",
  "cnd2:31.4": "Ito sutvāna nigghosaṃ, ",
  "cnd2:31.5": "sikkhe nibbānamattano’’. ",
  "cnd2:32.1": "88. ‘‘Passāmahaṃ devamanussaloke, ",
  "cnd2:32.2": "akiñcanaṃ brāhmaṇamiriyamānaṃ; ",
  "cnd2:32.3": "Taṃ taṃ namassāmi samantacakkhu, ",
  "cnd2:32.4": "pamuñca maṃ sakka kathaṃkathāhi’’. ",
  "cnd2:33.1": "89. ‘‘Nāhaṃ sahissāmi pamocanāya, ",
  "cnd2:33.2": "kathaṃkathiṃ dhotaka kañci loke; ",
  "cnd2:33.3": "Dhammañca seṭṭhaṃ abhijānamāno , ",
  "cnd2:33.4": "evaṃ tuvaṃ oghamimaṃ taresi’’. ",
  "cnd2:34.1": "90. ‘‘Anusāsa brahme karuṇāyamāno, ",
  "cnd2:34.2": "vivekadhammaṃ yamahaṃ vijaññaṃ; ",
  "cnd2:34.3": "Yathāhaṃ ākāsova abyāpajjamāno, ",
  "cnd2:34.4": "idheva santo asito careyyaṃ’’. ",
  "cnd2:35.1": "91. ‘‘Kittayissāmi te santiṃ, ",
  "cnd2:35.2": "[dhotakāti bhagavā] ",
  "cnd2:35.3": "Diṭṭhe dhamme anītihaṃ; ",
  "cnd2:35.4": "Yaṃ viditvā sato caraṃ, ",
  "cnd2:35.5": "tare loke visattikaṃ’’. ",
  "cnd2:36.1": "92. ‘‘Tañcāhaṃ abhinandāmi, ",
  "cnd2:36.2": "mahesi santimuttamaṃ; ",
  "cnd2:36.3": "Yaṃ viditvā sato caraṃ, ",
  "cnd2:36.4": "tare loke visattikaṃ’’. ",
  "cnd2:37.1": "93. ‘‘Yaṃ kiñci sampajānāsi, ",
  "cnd2:37.2": "[dhotakāti bhagavā] ",
  "cnd2:37.3": "Uddhaṃ adho tiriyañcāpi majjhe; ",
  "cnd2:37.4": "Etaṃ viditvā saṅgoti loke, ",
  "cnd2:37.5": "bhavābhavāya mākāsi taṇha’’nti. ",
  "cnd2:37.6": "Dhotakamāṇavapucchā pañcamī. ",
  "cnd2:38.0": "6. Upasīvamāṇavapucchā 94. ",
  "cnd2:38.1": "‘‘Eko ahaṃ sakka mahantamoghaṃ, ",
  "cnd2:38.2": "[iccāyasmā upasīvo] ",
  "cnd2:38.3": "Anissito no visahāmi tārituṃ; ",
  "cnd2:38.4": "Ārammaṇaṃ brūhi samantacakkhu, ",
  "cnd2:38.5": "yaṃ nissito oghamimaṃ tareyyaṃ’’. ",
  "cnd2:39.1": "95. ‘‘Ākiñcaññaṃ pekkhamāno satimā, ",
  "cnd2:39.2": "[upasīvāti bhagavā] ",
  "cnd2:39.3": "Natthīti nissāya tarassu oghaṃ; ",
  "cnd2:39.4": "Kāme pahāya virato kathāhi, ",
  "cnd2:39.5": "taṇhakkhayaṃ nattamahābhipassa’’. ",
  "cnd2:40.1": "96. ‘‘Sabbesu kāmesu yo vītarāgo, ",
  "cnd2:40.2": "[iccāyasmā upasīvo] ",
  "cnd2:40.3": "Ākiñcaññaṃ nissito hitvā maññaṃ; ",
  "cnd2:40.4": "Saññāvimokkhe parame vimutto , ",
  "cnd2:40.5": "tiṭṭhe nu so tattha anānuyāyī’’ . ",
  "cnd2:41.1": "97. ‘‘Sabbesu kāmesu yo vītarāgo, ",
  "cnd2:41.2": "[upasīvāti bhagavā] ",
  "cnd2:41.3": "Ākiñcaññaṃ nissito hitvā maññaṃ; ",
  "cnd2:41.4": "Saññāvimokkhe parame vimutto, ",
  "cnd2:41.5": "tiṭṭheyya so tattha anānuyāyī’’. ",
  "cnd2:42.1": "98. ‘‘Tiṭṭhe ce so tattha anānuyāyī, ",
  "cnd2:42.2": "pūgampi vassānaṃ samantacakkhu; ",
  "cnd2:42.3": "Tattheva so sītisiyā vimutto, ",
  "cnd2:42.4": "cavetha viññāṇaṃ tathāvidhassa’’. ",
  "cnd2:43.1": "99. ‘‘Acci yathā vātavegena khittā, ",
  "cnd2:43.2": "[upasīvāti bhagavā] ",
  "cnd2:43.3": "Atthaṃ paleti na upeti saṅkhaṃ; ",
  "cnd2:43.4": "Evaṃ munī nāmakāyā vimutto, ",
  "cnd2:43.5": "atthaṃ paleti na upeti saṅkhaṃ’’. ",
  "cnd2:44.1": "100. ‘‘Atthaṅgato so uda vā so natthi, ",
  "cnd2:44.2": "udāhu ve sassatiyā arogo; ",
  "cnd2:44.3": "Taṃ me munī sādhu viyākarohi, ",
  "cnd2:44.4": "tathā hi te vidito esa dhammo’’. ",
  "cnd2:45.1": "101. ‘‘Atthaṅgatassa na pamāṇamatthi, ",
  "cnd2:45.2": "[upasīvāti bhagavā] ",
  "cnd2:45.3": "Yena naṃ vajjuṃ taṃ tassa natthi; ",
  "cnd2:45.4": "Sabbesu dhammesu samūhatesu, ",
  "cnd2:45.5": "samūhatā vādapathāpi sabbe’’ti. ",
  "cnd2:45.6": "Upasīvamāṇavapucchā chaṭṭhī. ",
  "cnd2:46.0": "7. Nandamāṇavapucchā 102. ",
  "cnd2:46.1": "‘‘Santi loke munayo, ",
  "cnd2:46.2": "[iccāyasmā nando] ",
  "cnd2:46.3": "Janā vadanti tayidaṃ kathaṃsu; ",
  "cnd2:46.4": "Ñāṇūpapannaṃ muni no vadanti, ",
  "cnd2:46.5": "udāhu ve jīvitenūpapannaṃ’’. ",
  "cnd2:47.1": "103. ‘‘Na diṭṭhiyā na sutiyā na ñāṇena, ",
  "cnd2:47.2": "munīdha nanda kusalā vadanti; ",
  "cnd2:47.3": "Visenikatvā anīghā nirāsā, ",
  "cnd2:47.4": "caranti ye te munayoti brūmi’’. ",
  "cnd2:48.1": "104. ‘‘Ye kecime samaṇabrāhmaṇāse, ",
  "cnd2:48.2": "[iccāyasmā nando] ",
  "cnd2:48.3": "Diṭṭhassutenāpi vadanti suddhiṃ; ",
  "cnd2:48.4": "Sīlabbatenāpi vadanti suddhiṃ, ",
  "cnd2:48.5": "Anekarūpena vadanti suddhiṃ; ",
  "cnd2:48.6": "Kaccissu te bhagavā tattha yatā carantā, ",
  "cnd2:48.7": "Atāru jātiñca jarañca mārisa; ",
  "cnd2:48.8": "Pucchāmi taṃ bhagavā brūhi metaṃ’’. ",
  "cnd2:49.1": "105. ‘‘Ye kecime samaṇabrāhmaṇāse, ",
  "cnd2:49.2": "[nandāti bhagavā] ",
  "cnd2:49.3": "Diṭṭhassutenāpi vadanti suddhiṃ; ",
  "cnd2:49.4": "Sīlabbatenāpi vadanti suddhiṃ, ",
  "cnd2:49.5": "anekarūpena vadanti suddhiṃ; ",
  "cnd2:49.6": "Kiñcāpi te tattha yatā caranti, ",
  "cnd2:49.7": "nātariṃsu jātijaranti brūmi’’. ",
  "cnd2:50.1": "106. ‘‘Ye kecime samaṇabrāhmaṇāse, ",
  "cnd2:50.2": "[iccāyasmā nando] ",
  "cnd2:50.3": "Diṭṭhassutenāpi vadanti suddhiṃ; ",
  "cnd2:50.4": "Sīlabbatenāpi vadanti suddhiṃ, ",
  "cnd2:50.5": "anekarūpena vadanti suddhiṃ; ",
  "cnd2:50.6": "Te ce muni brūsi anoghatiṇṇe, ",
  "cnd2:50.7": "atha ko carahi devamanussaloke; ",
  "cnd2:50.8": "Atāri jātiñca jarañca mārisa, ",
  "cnd2:50.9": "pucchāmi taṃ bhagavā brūhi metaṃ’’. ",
  "cnd2:51.1": "107. ‘‘Nāhaṃ sabbe samaṇabrāhmaṇāse, ",
  "cnd2:51.2": "[nandāti bhagavā] ",
  "cnd2:51.3": "Jātijarāya nivutāti brūmi; ",
  "cnd2:51.4": "Ye sīdha diṭṭhaṃ va sutaṃ mutaṃ vā, ",
  "cnd2:51.5": "sīlabbataṃ vāpi pahāya sabbaṃ; ",
  "cnd2:51.6": "Anekarūpampi pahāya sabbaṃ, ",
  "cnd2:51.7": "taṇhaṃ pariññāya anāsavāse; ",
  "cnd2:51.8": "Te ve narā oghatiṇṇāti brūmi’’. ",
  "cnd2:52.1": "108. ‘‘Etābhinandāmi vaco mahesino, ",
  "cnd2:52.2": "sukittitaṃ gotamanūpadhīkaṃ; ",
  "cnd2:52.3": "Ye sīdha diṭṭhaṃ va sutaṃ mutaṃ vā, ",
  "cnd2:52.4": "sīlabbataṃ vāpi pahāya sabbaṃ; ",
  "cnd2:52.5": "Anekarūpampi pahāya sabbaṃ, ",
  "cnd2:52.6": "taṇhaṃ pariññāya anāsavāse; ",
  "cnd2:52.7": "Ahampi te oghatiṇṇāti brūmī’’ti. ",
  "cnd2:52.8": "Nandamāṇavapucchā sattamā. ",
  "cnd2:53.0": "8. Hemakamāṇavapucchā 109. ",
  "cnd2:53.1": "‘‘Ye me pubbe viyākaṃsu, ",
  "cnd2:53.2": "[iccāyasmā hemako] ",
  "cnd2:53.3": "Huraṃ gotamasāsanā; ",
  "cnd2:53.4": "Iccāsi iti bhavissati, ",
  "cnd2:53.5": "sabbaṃ taṃ itihītihaṃ; ",
  "cnd2:53.6": "Sabbaṃ taṃ takkavaḍḍhanaṃ, ",
  "cnd2:53.7": "nāhaṃ tattha abhiramiṃ. ",
  "cnd2:54.1": "110. ‘‘Tvañca me dhammamakkhāhi, ",
  "cnd2:54.2": "taṇhānigghātanaṃ muni; ",
  "cnd2:54.3": "Yaṃ viditvā sato caraṃ, ",
  "cnd2:54.4": "tare loke visattikaṃ’’. ",
  "cnd2:55.1": "111. ‘‘Idha diṭṭhasutamutaviññātesu, ",
  "cnd2:55.2": "piyarūpesu hemaka; ",
  "cnd2:55.3": "Chandarāgavinodanaṃ, ",
  "cnd2:55.4": "nibbānapadamaccutaṃ. ",
  "cnd2:56.1": "112. ‘‘Etadaññāya ye satā, ",
  "cnd2:56.2": "diṭṭhadhammābhinibbutā; ",
  "cnd2:56.3": "Upasantā ca te sadā, ",
  "cnd2:56.4": "tiṇṇā loke visattika’’nti. ",
  "cnd2:56.5": "Hemakamāṇavapucchā aṭṭhamā. ",
  "cnd2:57.0": "9. Todeyyamāṇavapucchā 113. ",
  "cnd2:57.1": "‘‘Yasmiṃ kāmā na vasanti, ",
  "cnd2:57.2": "[iccāyasmā todeyyo] ",
  "cnd2:57.3": "Taṇhā yassa na vijjati; ",
  "cnd2:57.4": "Kathaṃkathā ca yo tiṇṇo, ",
  "cnd2:57.5": "vimokkho tassa kīdiso’’. ",
  "cnd2:58.1": "114. ‘‘Yasmiṃ kāmā na vasanti, ",
  "cnd2:58.2": "[todeyyāti bhagavā] ",
  "cnd2:58.3": "Taṇhā yassa na vijjati; ",
  "cnd2:58.4": "Kathaṃkathā ca yo tiṇṇo, ",
  "cnd2:58.5": "vimokkho tassa nāparo’’. ",
  "cnd2:59.1": "115. ‘‘Nirāsaso so uda āsasāno , ",
  "cnd2:59.2": "paññāṇavā so uda paññakappī; ",
  "cnd2:59.3": "Muniṃ ahaṃ sakka yathā vijaññaṃ, ",
  "cnd2:59.4": "taṃ me viyācikkha samantacakkhu’’. ",
  "cnd2:60.1": "116. ‘‘Nirāsaso so na ca āsasāno, ",
  "cnd2:60.2": "paññāṇavā so na ca paññakappī; ",
  "cnd2:60.3": "Evampi todeyya muniṃ vijāna, ",
  "cnd2:60.4": "akiñcanaṃ kāmabhave asatta’’nti. ",
  "cnd2:60.5": "Todeyyamāṇavapucchā navamā. ",
  "cnd2:61.0": "10. Kappamāṇavapucchā 117. ",
  "cnd2:61.1": "‘‘Majjhe sarasmiṃ tiṭṭhataṃ, ",
  "cnd2:61.2": "[iccāyasmā kappo] ",
  "cnd2:61.3": "Oghe jāte mahabbhaye; ",
  "cnd2:61.4": "Jarāmaccuparetānaṃ, ",
  "cnd2:61.5": "dīpaṃ pabrūhi mārisa; ",
  "cnd2:61.6": "Tvañca me dīpamakkhāhi, ",
  "cnd2:61.7": "yathāyidaṃ nāparaṃ siyā’’. ",
  "cnd2:62.1": "118. ‘‘Majjhe sarasmiṃ tiṭṭhataṃ, ",
  "cnd2:62.2": "[kappāti bhagavā] ",
  "cnd2:62.3": "Oghe jāte mahabbhaye; ",
  "cnd2:62.4": "Jarāmaccuparetānaṃ, ",
  "cnd2:62.5": "dīpaṃ pabrūmi kappa te. ",
  "cnd2:63.1": "119. ‘‘Akiñcanaṃ anādānaṃ, ",
  "cnd2:63.2": "etaṃ dīpaṃ anāparaṃ; ",
  "cnd2:63.3": "Nibbānaṃ iti naṃ brūmi, ",
  "cnd2:63.4": "jarāmaccuparikkhayaṃ. ",
  "cnd2:64.1": "120. ‘‘Etadaññāya ye satā, ",
  "cnd2:64.2": "diṭṭhadhammābhinibbutā; ",
  "cnd2:64.3": "Na te māravasānugā, ",
  "cnd2:64.4": "na te mārassa paṭṭhagū’’ti . ",
  "cnd2:64.5": "Kappamāṇavapucchā dasamā. ",
  "cnd2:65.0": "11. Jatukaṇṇimāṇavapucchā 121. ",
  "cnd2:65.1": "‘‘Sutvānahaṃ vīramakāmakāmiṃ, ",
  "cnd2:65.2": "[iccāyasmā jatukaṇṇi] ",
  "cnd2:65.3": "Oghātigaṃ puṭṭhumakāmamāgamaṃ; ",
  "cnd2:65.4": "Santipadaṃ brūhi sahajanetta, ",
  "cnd2:65.5": "yathātacchaṃ bhagavā brūhi metaṃ. ",
  "cnd2:66.1": "122. ‘‘Bhagavā hi kāme abhibhuyya iriyati, ",
  "cnd2:66.2": "ādiccova pathaviṃ tejī tejasā; ",
  "cnd2:66.3": "Parittapaññassa me bhūripañña, ",
  "cnd2:66.4": "ācikkha dhammaṃ yamahaṃ vijaññaṃ; ",
  "cnd2:66.5": "Jātijarāya idha vippahānaṃ’’. ",
  "cnd2:67.1": "123. ‘‘Kāmesu vinaya gedhaṃ, ",
  "cnd2:67.2": "[jatukaṇṇīti bhagavā] ",
  "cnd2:67.3": "Nekkhammaṃ daṭṭhu khemato; ",
  "cnd2:67.4": "Uggahitaṃ nirattaṃ vā, ",
  "cnd2:67.5": "mā te vijjittha kiñcanaṃ. ",
  "cnd2:68.1": "124. ‘‘Yaṃ pubbe taṃ visosehi, ",
  "cnd2:68.2": "pacchā te māhu kiñcanaṃ; ",
  "cnd2:68.3": "Majjhe ce no gahessasi, ",
  "cnd2:68.4": "upasanto carissasi. ",
  "cnd2:69.1": "125. ‘‘Sabbaso nāmarūpasmiṃ, ",
  "cnd2:69.2": "vītagedhassa brāhmaṇa; ",
  "cnd2:69.3": "Āsavāssa na vijjanti, ",
  "cnd2:69.4": "yehi maccuvasaṃ vaje’’ti. ",
  "cnd2:69.5": "Jatukaṇṇimāṇavapucchā ekādasamā. ",
  "cnd2:70.0": "12. Bhadrāvudhamāṇavapucchā 126. ",
  "cnd2:70.1": "‘‘Okañjahaṃ taṇhacchidaṃ anejaṃ, ",
  "cnd2:70.2": "[iccāyasmā bhadrāvudho] ",
  "cnd2:70.3": "Nandiñjahaṃ oghatiṇṇaṃ vimuttaṃ; ",
  "cnd2:70.4": "Kappañjahaṃ abhiyāce sumedhaṃ, ",
  "cnd2:70.5": "sutvāna nāgassa apanamissanti ito. ",
  "cnd2:71.1": "127. ‘‘Nānājanā janapadehi saṅgatā, ",
  "cnd2:71.2": "Tava vīra vākyaṃ abhikaṅkhamānā; ",
  "cnd2:71.3": "Tesaṃ tuvaṃ sādhu viyākarohi, ",
  "cnd2:71.4": "tathā hi te vidito esa dhammo’’. ",
  "cnd2:72.1": "128. ‘‘Ādānataṇhaṃ vinayetha sabbaṃ, ",
  "cnd2:72.2": "[bhadrāvudhāti bhagavā] ",
  "cnd2:72.3": "Uddhaṃ adho tiriyañcāpi majjhe; ",
  "cnd2:72.4": "Yaṃ yañhi lokasmimupādiyanti, ",
  "cnd2:72.5": "teneva māro anveti jantuṃ. ",
  "cnd2:73.1": "129. ‘‘Tasmā pajānaṃ na upādiyetha, ",
  "cnd2:73.2": "bhikkhu sato kiñcanaṃ sabbaloke; ",
  "cnd2:73.3": "Ādānasatte iti pekkhamāno, ",
  "cnd2:73.4": "pajaṃ imaṃ maccudheyye visatta’’nti. ",
  "cnd2:73.5": "Bhadrāvudhamāṇavapucchā dvādasamā. ",
  "cnd2:74.0": "13. Udayamāṇavapucchā 130. ",
  "cnd2:74.1": "‘‘Jhāyiṃ virajamāsīnaṃ, ",
  "cnd2:74.2": "[iccāyasmā udayo] ",
  "cnd2:74.3": "Katakiccaṃ anāsavaṃ; ",
  "cnd2:74.4": "Pāraguṃ sabbadhammānaṃ, ",
  "cnd2:74.5": "atthi pañhena āgamaṃ; ",
  "cnd2:74.6": "Aññāvimokkhaṃ pabrūhi, ",
  "cnd2:74.7": "avijjāya pabhedanaṃ’’. ",
  "cnd2:75.1": "131. ‘‘Pahānaṃ kāmacchandānaṃ, ",
  "cnd2:75.2": "[udayāti bhagavā] ",
  "cnd2:75.3": "Domanassāna cūbhayaṃ; ",
  "cnd2:75.4": "Thinassa ca panūdanaṃ, ",
  "cnd2:75.5": "kukkuccānaṃ nivāraṇaṃ. ",
  "cnd2:76.1": "132. ‘‘Upekkhāsatisaṃsuddhaṃ, ",
  "cnd2:76.2": "dhammatakkapurejavaṃ; ",
  "cnd2:76.3": "Aññāvimokkhaṃ pabrūmi, ",
  "cnd2:76.4": "avijjāya pabhedanaṃ’’. ",
  "cnd2:77.1": "133. ‘‘Kiṃsu saṃyojano loko, ",
  "cnd2:77.2": "kiṃsu tassa vicāraṇaṃ; ",
  "cnd2:77.3": "Kissassa vippahānena, ",
  "cnd2:77.4": "nibbānaṃ iti vuccati’’. ",
  "cnd2:78.1": "134. ‘‘Nandisaṃyojano loko, ",
  "cnd2:78.2": "vitakkassa vicāraṇaṃ; ",
  "cnd2:78.3": "Taṇhāya vippahānena, ",
  "cnd2:78.4": "nibbānaṃ iti vuccati’’. ",
  "cnd2:79.1": "135. ‘‘Kathaṃ satassa carato, ",
  "cnd2:79.2": "viññāṇaṃ uparujjhati; ",
  "cnd2:79.3": "Bhagavantaṃ puṭṭhumāgamma, ",
  "cnd2:79.4": "taṃ suṇoma vaco tava’’. ",
  "cnd2:80.1": "136. ‘‘Ajjhattañca bahiddhā ca, ",
  "cnd2:80.2": "vedanaṃ nābhinandato; ",
  "cnd2:80.3": "Evaṃ satassa carato, ",
  "cnd2:80.4": "viññāṇaṃ uparujjhatī’’ti. ",
  "cnd2:80.5": "Udayamāṇavapucchā terasamā. ",
  "cnd2:81.0": "14. Posālamāṇavapucchā 137. ",
  "cnd2:81.1": "‘‘Yo atītaṃ ādisati, ",
  "cnd2:81.2": "[iccāyasmā posālo] ",
  "cnd2:81.3": "Anejo chinnasaṃsayo; ",
  "cnd2:81.4": "Pāraguṃ sabbadhammānaṃ, ",
  "cnd2:81.5": "atthi pañhena āgamaṃ. ",
  "cnd2:82.1": "138. ‘‘Vibhūtarūpasaññissa, ",
  "cnd2:82.2": "sabbakāyappahāyino; ",
  "cnd2:82.3": "Ajjhattañca bahiddhā ca, ",
  "cnd2:82.4": "natthi kiñcīti passato; ",
  "cnd2:82.5": "Ñāṇaṃ sakkānupucchāmi, ",
  "cnd2:82.6": "kathaṃ neyyo tathāvidho’’. ",
  "cnd2:83.1": "139. ‘‘Viññāṇaṭṭhitiyo sabbā, ",
  "cnd2:83.2": "[posālāti bhagavā] ",
  "cnd2:83.3": "Abhijānaṃ tathāgato; ",
  "cnd2:83.4": "Tiṭṭhantamenaṃ jānāti, ",
  "cnd2:83.5": "vimuttaṃ tapparāyaṇaṃ. ",
  "cnd2:84.1": "140. ‘‘Ākiñcaññasambhavaṃ ñatvā, ",
  "cnd2:84.2": "nandī saṃyojanaṃ iti; ",
  "cnd2:84.3": "Evametaṃ abhiññāya, ",
  "cnd2:84.4": "tato tattha vipassati; ",
  "cnd2:84.5": "Etaṃ ñāṇaṃ tathaṃ tassa, ",
  "cnd2:84.6": "brāhmaṇassa vusīmato’’ti. ",
  "cnd2:84.7": "Posālamāṇavapucchā cuddasamā. ",
  "cnd2:85.0": "15. Mogharājamāṇavapucchā 141. ",
  "cnd2:85.1": "‘‘Dvāhaṃ sakkaṃ apucchissaṃ, ",
  "cnd2:85.2": "[iccāyasmā mogharājā] ",
  "cnd2:85.3": "Na me byākāsi cakkhumā; ",
  "cnd2:85.4": "Yāvatatiyañca devīsi, ",
  "cnd2:85.5": "byākarotīti me sutaṃ. ",
  "cnd2:86.1": "142. ‘‘Ayaṃ loko paro loko, ",
  "cnd2:86.2": "brahmaloko sadevako; ",
  "cnd2:86.3": "Diṭṭhiṃ te nābhijānāti, ",
  "cnd2:86.4": "gotamassa yasassino. ",
  "cnd2:87.1": "143. ‘‘Evaṃ abhikkantadassāviṃ, ",
  "cnd2:87.2": "atthi pañhena āgamaṃ; ",
  "cnd2:87.3": "Kathaṃ lokaṃ avekkhantaṃ, ",
  "cnd2:87.4": "maccurājā na passati’’. ",
  "cnd2:88.1": "144. ‘‘Suññato lokaṃ avekkhassu, ",
  "cnd2:88.2": "mogharāja sadā sato; ",
  "cnd2:88.3": "Attānudiṭṭhiṃ ūhacca, ",
  "cnd2:88.4": "evaṃ maccutaro siyā; ",
  "cnd2:88.5": "Evaṃ lokaṃ avekkhantaṃ, ",
  "cnd2:88.6": "maccurājā na passatī’’ti. ",
  "cnd2:88.7": "Mogharājamāṇavapucchā pannarasamā. ",
  "cnd2:89.0": "16. Piṅgiyamāṇavapucchā 145. ",
  "cnd2:89.1": "‘‘Jiṇṇohamasmi abalo vītavaṇṇo, ",
  "cnd2:89.2": "[iccāyasmā piṅgiyo] ",
  "cnd2:89.3": "Nettā na suddhā savanaṃ na phāsu; ",
  "cnd2:89.4": "Māhaṃ nassaṃ momuho antarāva, ",
  "cnd2:89.5": "ācikkha dhammaṃ yamahaṃ vijaññaṃ; ",
  "cnd2:89.6": "Jātijarāya idha vippahānaṃ’’. ",
  "cnd2:90.1": "146. ‘‘Disvāna rūpesu vihaññamāne, ",
  "cnd2:90.2": "[piṅgiyāti bhagavā] ",
  "cnd2:90.3": "Ruppanti rūpesu janā pamattā; ",
  "cnd2:90.4": "Tasmā tuvaṃ piṅgiya appamatto, ",
  "cnd2:90.5": "jahassu rūpaṃ apunabbhavāya’’. ",
  "cnd2:91.1": "147. ‘‘Disā catasso vidisā catasso, ",
  "cnd2:91.2": "uddhaṃ adho dasa disā imāyo; ",
  "cnd2:91.3": "Na tuyhaṃ adiṭṭhaṃ asutaṃ amutaṃ , ",
  "cnd2:91.4": "atho aviññātaṃ kiñcanamatthi loke; ",
  "cnd2:91.5": "Ācikkha dhammaṃ yamahaṃ vijaññaṃ, ",
  "cnd2:91.6": "jātijarāya idha vippahānaṃ’’. ",
  "cnd2:92.1": "148. ‘‘Taṇhādhipanne manuje pekkhamāno, ",
  "cnd2:92.2": "[piṅgiyāti bhagavā] ",
  "cnd2:92.3": "Santāpajāte jarasā parete; ",
  "cnd2:92.4": "Tasmā tuvaṃ piṅgiya appamatto, ",
  "cnd2:92.5": "jahassu taṇhaṃ apunabbhavāyā’’ti. ",
  "cnd2:92.6": "Piṅgiyamāṇavapucchā soḷasamā. "
}
