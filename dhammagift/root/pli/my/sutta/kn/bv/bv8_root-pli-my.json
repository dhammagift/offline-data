{
  "bv8:0.1": "",
  "bv8:0.2": "1. 8. Sobhitabuddhavaṃso ",
  "bv8:1.1": "Revatassa aparena, ",
  "bv8:1.2": "sobhito nāma nāyako; ",
  "bv8:1.3": "Samāhito santacitto, ",
  "bv8:1.4": "asamo appaṭipuggalo. ",
  "bv8:2.1": "2. So jino sakagehamhi, ",
  "bv8:2.2": "mānasaṃ vinivattayi; ",
  "bv8:2.3": "Patvāna kevalaṃ bodhiṃ, ",
  "bv8:2.4": "dhammacakkaṃ pavattayi. ",
  "bv8:3.1": "3. Yāva heṭṭhā avīcito, ",
  "bv8:3.2": "bhavaggā cāpi uddhato; ",
  "bv8:3.3": "Etthantare ekaparisā, ",
  "bv8:3.4": "ahosi dhammadesane. ",
  "bv8:4.1": "4. Tāya parisāya sambuddho, ",
  "bv8:4.2": "dhammacakkaṃ pavattayi; ",
  "bv8:4.3": "Gaṇanāya na vattabbo, ",
  "bv8:4.4": "paṭhamābhisamayo ahu. ",
  "bv8:5.1": "5. Tato parampi desente, ",
  "bv8:5.2": "marūnañca samāgame; ",
  "bv8:5.3": "Navutikoṭisahassānaṃ, ",
  "bv8:5.4": "dutiyābhisamayo ahu. ",
  "bv8:6.1": "6. Punāparaṃ rājaputto, ",
  "bv8:6.2": "jayaseno nāma khattiyo; ",
  "bv8:6.3": "Ārāmaṃ ropayitvāna, ",
  "bv8:6.4": "buddhe niyyādayī tadā. ",
  "bv8:7.1": "7. Tassa yāgaṃ pakittento, ",
  "bv8:7.2": "dhammaṃ desesi cakkhumā; ",
  "bv8:7.3": "Tadā koṭisahassānaṃ, ",
  "bv8:7.4": "tatiyābhisamayo ahu. ",
  "bv8:8.1": "8. Sannipātā tayo āsuṃ, ",
  "bv8:8.2": "sobhitassa mahesino; ",
  "bv8:8.3": "Khīṇāsavānaṃ vimalānaṃ, ",
  "bv8:8.4": "santacittāna tādinaṃ. ",
  "bv8:9.1": "9. Uggato nāma so rājā, ",
  "bv8:9.2": "dānaṃ deti naruttame; ",
  "bv8:9.3": "Tamhi dāne samāgañchuṃ, ",
  "bv8:9.4": "arahantā satakoṭiyo. ",
  "bv8:10.1": "10. Punāparaṃ puragaṇo , ",
  "bv8:10.2": "deti dānaṃ naruttame; ",
  "bv8:10.3": "Tadā navutikoṭīnaṃ, ",
  "bv8:10.4": "dutiyo āsi samāgamo. ",
  "bv8:11.1": "11. Devaloke vasitvāna, ",
  "bv8:11.2": "yadā orohatī jino; ",
  "bv8:11.3": "Tadā asītikoṭīnaṃ, ",
  "bv8:11.4": "tatiyo āsi samāgamo. ",
  "bv8:12.1": "12. Ahaṃ tena samayena, ",
  "bv8:12.2": "sujāto nāma brāhmaṇo; ",
  "bv8:12.3": "Tadā sasāvakaṃ buddhaṃ, ",
  "bv8:12.4": "annapānena tappayiṃ. ",
  "bv8:13.1": "13. Sopi maṃ buddho byākāsi, ",
  "bv8:13.2": "sobhito lokanāyako; ",
  "bv8:13.3": "‘‘Aparimeyyito kappe, ",
  "bv8:13.4": "ayaṃ buddho bhavissati. ",
  "bv8:14.1": "14. ‘‘Padhānaṃ padahitvāna…pe… ",
  "bv8:14.2": "",
  "bv8:14.3": "hessāma sammukhā imaṃ’’. ",
  "bv8:15.1": "15. Tassāpi vacanaṃ sutvā, ",
  "bv8:15.2": "haṭṭho saṃviggamānaso; ",
  "bv8:15.3": "Tamevatthamanuppattiyā, ",
  "bv8:15.4": "uggaṃ dhitimakāsahaṃ. ",
  "bv8:16.1": "16. Sudhammaṃ nāma nagaraṃ, ",
  "bv8:16.2": "sudhammo nāma khattiyo; ",
  "bv8:16.3": "Sudhammā nāma janikā, ",
  "bv8:16.4": "sobhitassa mahesino. ",
  "bv8:17.1": "17. Navavassasahassāni, ",
  "bv8:17.2": "agāraṃ ajjha so vasi; ",
  "bv8:17.3": "Kumudo nāḷino padumo, ",
  "bv8:17.4": "tayo pāsādamuttamā. ",
  "bv8:18.1": "18. Sattatiṃsasahassāni, ",
  "bv8:18.2": "nāriyo samalaṅkatā; ",
  "bv8:18.3": "Maṇilā nāma sā nārī, ",
  "bv8:18.4": "sīho nāmāsi atrajo. ",
  "bv8:19.1": "19. Nimitte caturo disvā, ",
  "bv8:19.2": "pāsādenābhinikkhami; ",
  "bv8:19.3": "Sattāhaṃ padhānacāraṃ, ",
  "bv8:19.4": "caritvā purisuttamo. ",
  "bv8:20.1": "20. Brahmunā yācito santo, ",
  "bv8:20.2": "sobhito lokanāyako; ",
  "bv8:20.3": "Vatti cakkaṃ mahāvīro, ",
  "bv8:20.4": "sudhammuyyānamuttame. ",
  "bv8:21.1": "21. Asamo ca sunetto ca, ",
  "bv8:21.2": "ahesuṃ aggasāvakā; ",
  "bv8:21.3": "Anomo nāmupaṭṭhāko, ",
  "bv8:21.4": "sobhitassa mahesino. ",
  "bv8:22.1": "22. Nakulā ca sujātā ca, ",
  "bv8:22.2": "ahesuṃ aggasāvikā; ",
  "bv8:22.3": "Bujjhamāno ca so buddho, ",
  "bv8:22.4": "nāgamūle abujjhatha. ",
  "bv8:23.1": "23. Rammo ceva sudatto ca, ",
  "bv8:23.2": "ahesuṃ aggupaṭṭhakā; ",
  "bv8:23.3": "Nakulā ceva cittā ca, ",
  "bv8:23.4": "ahesuṃ aggupaṭṭhikā. ",
  "bv8:24.1": "24. Aṭṭhapaṇṇāsaratanaṃ, ",
  "bv8:24.2": "accuggato mahāmuni; ",
  "bv8:24.3": "Obhāseti disā sabbā, ",
  "bv8:24.4": "sataraṃsīva uggato. ",
  "bv8:25.1": "25. Yathā suphullaṃ pavanaṃ, ",
  "bv8:25.2": "nānāgandhehi dhūpitaṃ; ",
  "bv8:25.3": "Tatheva tassa pāvacanaṃ, ",
  "bv8:25.4": "sīlagandhehi dhūpitaṃ. ",
  "bv8:26.1": "26. Yathāpi sāgaro nāma, ",
  "bv8:26.2": "dassanena atappiyo; ",
  "bv8:26.3": "Tatheva tassa pāvacanaṃ, ",
  "bv8:26.4": "savaṇena atappiyaṃ. ",
  "bv8:27.1": "27. Navutivassasahassāni, ",
  "bv8:27.2": "āyu vijjati tāvade; ",
  "bv8:27.3": "Tāvatā tiṭṭhamāno so, ",
  "bv8:27.4": "tāresi janataṃ bahuṃ. ",
  "bv8:28.1": "28. Ovādaṃ anusiṭṭhiñca, ",
  "bv8:28.2": "datvāna sesake jane; ",
  "bv8:28.3": "Hutāsanova tāpetvā, ",
  "bv8:28.4": "nibbuto so sasāvako. ",
  "bv8:29.1": "29. So ca buddho asamasamo, ",
  "bv8:29.2": "tepi sāvakā balappattā; ",
  "bv8:29.3": "Sabbaṃ tamantarahitaṃ, ",
  "bv8:29.4": "nanu rittā sabbasaṅkhārā. ",
  "bv8:30.1": "30. Sobhito varasambuddho, ",
  "bv8:30.2": "sīhārāmamhi nibbuto; ",
  "bv8:30.3": "Dhātuvitthārikaṃ āsi, ",
  "bv8:30.4": "tesu tesu padesatoti. ",
  "bv8:31.1": "Sobhitassa bhagavato vaṃso chaṭṭho. "
}
