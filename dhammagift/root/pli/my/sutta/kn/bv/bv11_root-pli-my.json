{
  "bv11:0.1": "",
  "bv11:0.2": "11. Nāradabuddhavaṃso 1. ",
  "bv11:1.1": "Padumassa aparena, ",
  "bv11:1.2": "sambuddho dvipaduttamo; ",
  "bv11:1.3": "Nārado nāma nāmena, ",
  "bv11:1.4": "asamo appaṭipuggalo. ",
  "bv11:2.1": "2. So buddho cakkavattissa, ",
  "bv11:2.2": "jeṭṭho dayitaoraso; ",
  "bv11:2.3": "Āmukkamālābharaṇo, ",
  "bv11:2.4": "uyyānaṃ upasaṅkami. ",
  "bv11:3.1": "3. Tatthāsi rukkho yasavipulo, ",
  "bv11:3.2": "abhirūpo brahā suci; ",
  "bv11:3.3": "Tamajjhapatvā upanisīdi, ",
  "bv11:3.4": "mahāsoṇassa heṭṭhato. ",
  "bv11:4.1": "4. Tattha ñāṇavaruppajji, ",
  "bv11:4.2": "anantaṃ vajirūpamaṃ; ",
  "bv11:4.3": "Tena vicini saṅkhāre, ",
  "bv11:4.4": "ukkujjamavakujjakaṃ . ",
  "bv11:5.1": "5. Tattha sabbakilesāni, ",
  "bv11:5.2": "asesamabhivāhayi; ",
  "bv11:5.3": "Pāpuṇī kevalaṃ bodhiṃ, ",
  "bv11:5.4": "buddhañāṇe ca cuddasa. ",
  "bv11:6.1": "6. Pāpuṇitvāna sambodhiṃ, ",
  "bv11:6.2": "dhammacakkaṃ pavattayi; ",
  "bv11:6.3": "Koṭisatasahassānaṃ, ",
  "bv11:6.4": "paṭhamābhisamayo ahu. ",
  "bv11:7.1": "7. Mahādoṇaṃ nāgarājaṃ, ",
  "bv11:7.2": "vinayanto mahāmuni; ",
  "bv11:7.3": "Pāṭiheraṃ tadākāsi, ",
  "bv11:7.4": "dassayanto sadevake. ",
  "bv11:8.1": "8. Tadā devamanussānaṃ, ",
  "bv11:8.2": "tamhi dhammappakāsane; ",
  "bv11:8.3": "Navutikoṭisahassāni, ",
  "bv11:8.4": "tariṃsu sabbasaṃsayaṃ. ",
  "bv11:9.1": "9. Yamhi kāle mahāvīro, ",
  "bv11:9.2": "ovadī sakamatrajaṃ; ",
  "bv11:9.3": "Asītikoṭisahassānaṃ, ",
  "bv11:9.4": "tatiyābhisamayo ahu. ",
  "bv11:10.1": "10. Sannipātā tayo āsuṃ, ",
  "bv11:10.2": "nāradassa mahesino; ",
  "bv11:10.3": "Koṭisatasahassānaṃ, ",
  "bv11:10.4": "paṭhamo āsi samāgamo. ",
  "bv11:11.1": "11. Yadā buddho buddhaguṇaṃ, ",
  "bv11:11.2": "sanidānaṃ pakāsayi; ",
  "bv11:11.3": "Navutikoṭisahassāni, ",
  "bv11:11.4": "samiṃsu vimalā tadā. ",
  "bv11:12.1": "12. Yadā verocano nāgo, ",
  "bv11:12.2": "dānaṃ dadāti satthuno; ",
  "bv11:12.3": "Tadā samiṃsu jinaputtā, ",
  "bv11:12.4": "asītisatasahassiyo. ",
  "bv11:13.1": "13. Ahaṃ tena samayena, ",
  "bv11:13.2": "jaṭilo uggatāpano; ",
  "bv11:13.3": "Antalikkhacaro āsiṃ, ",
  "bv11:13.4": "pañcābhiññāsu pāragū. ",
  "bv11:14.1": "14. Tadāpāhaṃ asamasamaṃ, ",
  "bv11:14.2": "sasaṅghaṃ saparijjanaṃ; ",
  "bv11:14.3": "Annapānena tappetvā, ",
  "bv11:14.4": "candanenābhipūjayiṃ. ",
  "bv11:15.1": "15. Sopi maṃ tadā byākāsi, ",
  "bv11:15.2": "nārado lokanāyako; ",
  "bv11:15.3": "‘‘Aparimeyyito kappe, ",
  "bv11:15.4": "ayaṃ buddho bhavissati. ",
  "bv11:16.1": "16. ‘‘Padhānaṃ padahitvāna ",
  "bv11:16.2": "…pe… ",
  "bv11:16.3": "hessāma sammukhā imaṃ’’. ",
  "bv11:17.1": "17. Tassāpi vacanaṃ sutvā, ",
  "bv11:17.2": "bhiyyo hāsetva mānasaṃ; ",
  "bv11:17.3": "Adhiṭṭhahiṃ vataṃ uggaṃ, ",
  "bv11:17.4": "dasapāramipūriyā. ",
  "bv11:18.1": "18. Nagaraṃ dhaññavatī nāma, ",
  "bv11:18.2": "sudevo nāma khattiyo; ",
  "bv11:18.3": "Anomā nāma janikā, ",
  "bv11:18.4": "nāradassa mahesino. ",
  "bv11:19.1": "19. Navavassasahassāni, ",
  "bv11:19.2": "agāraṃ ajjha so vasi; ",
  "bv11:19.3": "Jito vijitābhirāmo, ",
  "bv11:19.4": "tayo pāsādamuttamā. ",
  "bv11:20.1": "20. Ticattārīsasahassāni, ",
  "bv11:20.2": "nāriyo samalaṅkatā; ",
  "bv11:20.3": "Vijitasenā nāma nārī, ",
  "bv11:20.4": "nanduttaro nāma atrajo. ",
  "bv11:21.1": "21. Nimitte caturo disvā, ",
  "bv11:21.2": "padasā gamanena nikkhami; ",
  "bv11:21.3": "Sattāhaṃ padhānacāraṃ, ",
  "bv11:21.4": "acarī purisuttamo . ",
  "bv11:22.1": "22. Brahmunā yācito santo, ",
  "bv11:22.2": "nārado lokanāyako; ",
  "bv11:22.3": "Vatti cakkaṃ mahāvīro, ",
  "bv11:22.4": "dhanañcuyyānamuttame. ",
  "bv11:23.1": "23. Bhaddasālo jitamitto, ",
  "bv11:23.2": "ahesuṃ aggasāvakā; ",
  "bv11:23.3": "Vāseṭṭho nāmupaṭṭhāko, ",
  "bv11:23.4": "nāradassa mahesino. ",
  "bv11:24.1": "24. Uttarā phaggunī ceva, ",
  "bv11:24.2": "ahesuṃ aggasāvikā; ",
  "bv11:24.3": "Bodhi tassa bhagavato, ",
  "bv11:24.4": "mahāsoṇoti vuccati. ",
  "bv11:25.1": "25. Uggarindo vasabho ca, ",
  "bv11:25.2": "ahesuṃ aggupaṭṭhakā; ",
  "bv11:25.3": "Indāvarī ca vaṇḍī ca, ",
  "bv11:25.4": "ahesuṃ aggupaṭṭhikā. ",
  "bv11:26.1": "26. Aṭṭhāsītiratanāni, ",
  "bv11:26.2": "accuggato mahāmuni; ",
  "bv11:26.3": "Kañcanagghiyasaṅkāso, ",
  "bv11:26.4": "dasasahassī virocati. ",
  "bv11:27.1": "27. Tassa byāmappabhā kāyā, ",
  "bv11:27.2": "niddhāvati disodisaṃ; ",
  "bv11:27.3": "Nirantaraṃ divārattiṃ, ",
  "bv11:27.4": "yojanaṃ pharate sadā. ",
  "bv11:28.1": "28. Na keci tena samayena, ",
  "bv11:28.2": "samantā yojane janā; ",
  "bv11:28.3": "Ukkāpadīpe ujjālenti, ",
  "bv11:28.4": "buddharaṃsīhi otthaṭā. ",
  "bv11:29.1": "29. Navutivassasahassāni, ",
  "bv11:29.2": "āyu vijjati tāvade; ",
  "bv11:29.3": "Tāvatā tiṭṭhamāno so, ",
  "bv11:29.4": "tāresi janataṃ bahuṃ. ",
  "bv11:30.1": "30. Yathā uḷūhi gaganaṃ, ",
  "bv11:30.2": "vicittaṃ upasobhati; ",
  "bv11:30.3": "Tatheva sāsanaṃ tassa, ",
  "bv11:30.4": "arahantehi sobhati. ",
  "bv11:31.1": "31. Saṃsārasotaṃ taraṇāya, ",
  "bv11:31.2": "sesake paṭipannake; ",
  "bv11:31.3": "Dhammasetuṃ daḷhaṃ katvā, ",
  "bv11:31.4": "nibbuto so narāsabho. ",
  "bv11:32.1": "32. Sopi buddho asamasamo, ",
  "bv11:32.2": "tepi khīṇāsavā atulatejā; ",
  "bv11:32.3": "Sabbaṃ tamantarahitaṃ, ",
  "bv11:32.4": "nanu rittā sabbasaṅkhārā. ",
  "bv11:33.1": "33. Nārado jinavasabho, ",
  "bv11:33.2": "nibbuto sudassane pure; ",
  "bv11:33.3": "Tatthevassa thūpavaro, ",
  "bv11:33.4": "catuyojanamuggatoti. ",
  "bv11:34.1": "Nāradassa bhagavato vaṃso navamo. "
}
