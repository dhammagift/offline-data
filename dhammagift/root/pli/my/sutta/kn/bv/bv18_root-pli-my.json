{
  "bv18:0.1": "",
  "bv18:0.2": "1. 18. Siddhatthabuddhavaṃso ",
  "bv18:1.1": "Dhammadassissa aparena, ",
  "bv18:1.2": "siddhattho nāma nāyako; ",
  "bv18:1.3": "Nihanitvā tamaṃ sabbaṃ, ",
  "bv18:1.4": "sūriyo abbhuggato yathā. ",
  "bv18:2.1": "2. Sopi patvāna sambodhiṃ, ",
  "bv18:2.2": "santārento sadevakaṃ; ",
  "bv18:2.3": "Abhivassi dhammameghena, ",
  "bv18:2.4": "nibbāpento sadevakaṃ. ",
  "bv18:3.1": "3. Tassāpi atulatejassa, ",
  "bv18:3.2": "ahesuṃ abhisamayā tayo; ",
  "bv18:3.3": "Koṭisatasahassānaṃ, ",
  "bv18:3.4": "paṭhamābhisamayo ahu. ",
  "bv18:4.1": "4. Punāparaṃ bhīmarathe , ",
  "bv18:4.2": "yadā āhani dundubhiṃ; ",
  "bv18:4.3": "Tadā navutikoṭīnaṃ, ",
  "bv18:4.4": "dutiyābhisamayo ahu. ",
  "bv18:5.1": "5. Yadā buddho dhammaṃ desesi, ",
  "bv18:5.2": "vebhāre so puruttame; ",
  "bv18:5.3": "Tadā navutikoṭīnaṃ, ",
  "bv18:5.4": "tatiyābhisamayo ahu. ",
  "bv18:6.1": "6. Sannipātā tayo āsuṃ, ",
  "bv18:6.2": "tasmimpi dvipaduttame; ",
  "bv18:6.3": "Khīṇāsavānaṃ vimalānaṃ, ",
  "bv18:6.4": "santacittāna tādinaṃ. ",
  "bv18:7.1": "7. Koṭisatānaṃ navutīnaṃ , ",
  "bv18:7.2": "asītiyāpi ca koṭinaṃ; ",
  "bv18:7.3": "Ete āsuṃ tayo ṭhānā, ",
  "bv18:7.4": "vimalānaṃ samāgame. ",
  "bv18:8.1": "8. Ahaṃ tena samayena, ",
  "bv18:8.2": "maṅgalo nāma tāpaso; ",
  "bv18:8.3": "Uggatejo duppasaho, ",
  "bv18:8.4": "abhiññābalasamāhito. ",
  "bv18:9.1": "9. Jambuto phalamānetvā ",
  "bv18:9.2": "siddhatthassa adāsahaṃ; ",
  "bv18:9.3": "Paṭiggahetvā sambuddho, ",
  "bv18:9.4": "idaṃ vacanamabravi. ",
  "bv18:10.1": "10. ‘‘Passatha imaṃ tāpasaṃ, ",
  "bv18:10.2": "jaṭilaṃ uggatāpanaṃ; ",
  "bv18:10.3": "Catunnavutito kappe, ",
  "bv18:10.4": "ayaṃ buddho bhavissati. ",
  "bv18:11.1": "11. ‘‘Padhānaṃ padahitvāna…pe… ",
  "bv18:11.2": "",
  "bv18:11.3": "hessāma sammukhā imaṃ’’. ",
  "bv18:12.1": "12. Tassāpi vacanaṃ sutvā, ",
  "bv18:12.2": "bhiyyo cittaṃ pasādayiṃ; ",
  "bv18:12.3": "Uttariṃ vatamadhiṭṭhāsiṃ, ",
  "bv18:12.4": "dasapāramipūriyā. ",
  "bv18:13.1": "13. Vebhāraṃ nāma nagaraṃ, ",
  "bv18:13.2": "udeno nāma khattiyo; ",
  "bv18:13.3": "Suphassā nāma janikā, ",
  "bv18:13.4": "siddhatthassa mahesino. ",
  "bv18:14.1": "14. Dasavassasahassāni, ",
  "bv18:14.2": "agāraṃ ajjha so vasi; ",
  "bv18:14.3": "Kokāsuppalakokanadā, ",
  "bv18:14.4": "tayo pāsādamuttamā. ",
  "bv18:15.1": "15. Tisoḷasasahassāni, ",
  "bv18:15.2": "nāriyo samalaṅkatā; ",
  "bv18:15.3": "Somanassā nāma sā nārī, ",
  "bv18:15.4": "anupamo nāma atrajo. ",
  "bv18:16.1": "16. Nimitte caturo disvā, ",
  "bv18:16.2": "sivikāyābhinikkhami; ",
  "bv18:16.3": "Anūnadasamāsāni, ",
  "bv18:16.4": "padhānaṃ padahī jino. ",
  "bv18:17.1": "17. Brahmunā yācito santo, ",
  "bv18:17.2": "siddhattho lokanāyako; ",
  "bv18:17.3": "Vatti cakkaṃ mahāvīro, ",
  "bv18:17.4": "migadāye naruttamo. ",
  "bv18:18.1": "18. Sambalo ca sumitto ca, ",
  "bv18:18.2": "ahesuṃ aggasāvakā; ",
  "bv18:18.3": "Revato nāmupaṭṭhāko, ",
  "bv18:18.4": "siddhatthassa mahesino. ",
  "bv18:19.1": "19. Sīvalā ca surāmā ca, ",
  "bv18:19.2": "ahesuṃ aggasāvikā; ",
  "bv18:19.3": "Bodhi tassa bhagavato, ",
  "bv18:19.4": "kaṇikāroti vuccati. ",
  "bv18:20.1": "20. Suppiyo ca samuddo ca, ",
  "bv18:20.2": "ahesuṃ aggupaṭṭhakā; ",
  "bv18:20.3": "Rammā ceva surammā ca, ",
  "bv18:20.4": "ahesuṃ aggupaṭṭhikā. ",
  "bv18:21.1": "21. So buddho saṭṭhiratanaṃ, ",
  "bv18:21.2": "ahosi nabhamuggato; ",
  "bv18:21.3": "Kañcanagghiyasaṅkāso, ",
  "bv18:21.4": "dasasahassī virocati. ",
  "bv18:22.1": "22. Sopi buddho asamasamo, ",
  "bv18:22.2": "atulo appaṭipuggalo; ",
  "bv18:22.3": "Vassasatasahassāni, ",
  "bv18:22.4": "loke aṭṭhāsi cakkhumā. ",
  "bv18:23.1": "23. Vipulaṃ pabhaṃ dassayitvā, ",
  "bv18:23.2": "pupphāpetvāna sāvake; ",
  "bv18:23.3": "Vilāsetvā samāpatyā, ",
  "bv18:23.4": "nibbuto so sasāvako. ",
  "bv18:24.1": "24. Siddhattho munivaro buddho, ",
  "bv18:24.2": "anomārāmamhi nibbuto; ",
  "bv18:24.3": "Tatthevassa thūpavaro, ",
  "bv18:24.4": "catuyojanamuggatoti. ",
  "bv18:25.1": "Siddhatthassa bhagavato vaṃso soḷasamo. "
}
