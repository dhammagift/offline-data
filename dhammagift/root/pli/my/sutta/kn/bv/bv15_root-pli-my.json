{
  "bv15:0.1": "",
  "bv15:0.2": "15. Piyadassībuddhavaṃso 1. ",
  "bv15:1.1": "Sujātassa aparena, ",
  "bv15:1.2": "sayambhū lokanāyako; ",
  "bv15:1.3": "Durāsado asamasamo, ",
  "bv15:1.4": "piyadassī mahāyaso. ",
  "bv15:2.1": "2. Sopi buddho amitayaso, ",
  "bv15:2.2": "ādiccova virocati; ",
  "bv15:2.3": "Sabbaṃ tamaṃ nihantvāna, ",
  "bv15:2.4": "dhammacakkaṃ pavattayi. ",
  "bv15:3.1": "3. Tassāpi atulatejassa, ",
  "bv15:3.2": "ahesuṃ abhisamayā tayo; ",
  "bv15:3.3": "Koṭisatasahassānaṃ, ",
  "bv15:3.4": "paṭhamābhisamayo ahu. ",
  "bv15:4.1": "4. Sudassano devarājā, ",
  "bv15:4.2": "micchādiṭṭhimarocayi; ",
  "bv15:4.3": "Tassa diṭṭhiṃ vinodento, ",
  "bv15:4.4": "satthā dhammamadesayi. ",
  "bv15:5.1": "5. Janasannipāto atulo, ",
  "bv15:5.2": "mahāsannipatī tadā; ",
  "bv15:5.3": "Navutikoṭisahassānaṃ, ",
  "bv15:5.4": "dutiyābhisamayo ahu. ",
  "bv15:6.1": "6. Yadā doṇamukhaṃ hatthiṃ, ",
  "bv15:6.2": "vinesi narasārathi; ",
  "bv15:6.3": "Asītikoṭisahassānaṃ, ",
  "bv15:6.4": "tatiyābhisamayo ahu. ",
  "bv15:7.1": "7. Sannipātā tayo āsuṃ, ",
  "bv15:7.2": "tassāpi piyadassino; ",
  "bv15:7.3": "Koṭisatasahassānaṃ, ",
  "bv15:7.4": "paṭhamo āsi samāgamo. ",
  "bv15:8.1": "8. Tato paraṃ navutikoṭī, ",
  "bv15:8.2": "samiṃsu ekato munī; ",
  "bv15:8.3": "Tatiye sannipātamhi, ",
  "bv15:8.4": "asītikoṭiyo ahū. ",
  "bv15:9.1": "9. Ahaṃ tena samayena, ",
  "bv15:9.2": "kassapo nāma brāhmaṇo ; ",
  "bv15:9.3": "Ajjhāyako mantadharo, ",
  "bv15:9.4": "tiṇṇaṃ vedāna pāragū. ",
  "bv15:10.1": "10. Tassa dhammaṃ suṇitvāna, ",
  "bv15:10.2": "pasādaṃ janayiṃ ahaṃ; ",
  "bv15:10.3": "Koṭisatasahassehi, ",
  "bv15:10.4": "saṅghārāmaṃ amāpayiṃ. ",
  "bv15:11.1": "11. Tassa datvāna ārāmaṃ, ",
  "bv15:11.2": "haṭṭho saṃviggamānaso; ",
  "bv15:11.3": "Saraṇe pañca sīle ca , ",
  "bv15:11.4": "daḷhaṃ katvā samādiyiṃ. ",
  "bv15:12.1": "12. Sopi maṃ buddho byākāsi, ",
  "bv15:12.2": "saṅghamajjhe nisīdiya; ",
  "bv15:12.3": "‘‘Aṭṭhārase kappasate, ",
  "bv15:12.4": "ayaṃ buddho bhavissati. ",
  "bv15:13.1": "13. ‘‘Padhānaṃ padahitvāna ",
  "bv15:13.2": "…pe… ",
  "bv15:13.3": "hessāma sammukhā imaṃ’’. ",
  "bv15:14.1": "14. Tassāpi vacanaṃ sutvā, ",
  "bv15:14.2": "bhiyyo cittaṃ pasādayiṃ; ",
  "bv15:14.3": "Uttariṃ vatamadhiṭṭhāsiṃ, ",
  "bv15:14.4": "dasapāramipūriyā. ",
  "bv15:15.1": "15. Sudhaññaṃ nāma nagaraṃ, ",
  "bv15:15.2": "sudatto nāma khattiyo; ",
  "bv15:15.3": "Candā nāmāsi janikā, ",
  "bv15:15.4": "piyadassissa satthuno. ",
  "bv15:16.1": "16. Navavassasahassāni, ",
  "bv15:16.2": "agāraṃ ajjha so vasi; ",
  "bv15:16.3": "Sunimmalavimalagiriguhā, ",
  "bv15:16.4": "tayo pāsādamuttamā. ",
  "bv15:17.1": "17. Tettiṃsasahassāni ca, ",
  "bv15:17.2": "nāriyo samalaṅkatā; ",
  "bv15:17.3": "Vimalā nāma nārī ca, ",
  "bv15:17.4": "kañcanāveḷo nāma atrajo. ",
  "bv15:18.1": "18. Nimitte caturo disvā, ",
  "bv15:18.2": "rathayānena nikkhami; ",
  "bv15:18.3": "Chamāsaṃ padhānacāraṃ, ",
  "bv15:18.4": "acarī purisuttamo. ",
  "bv15:19.1": "19. Brahmunā yācito santo, ",
  "bv15:19.2": "piyadassī mahāmuni; ",
  "bv15:19.3": "Vatti cakkaṃ mahāvīro, ",
  "bv15:19.4": "usabhuyyāne manorame. ",
  "bv15:20.1": "20. Pālito sabbadassī ca, ",
  "bv15:20.2": "ahesuṃ aggasāvakā; ",
  "bv15:20.3": "Sobhito nāmupaṭṭhāko, ",
  "bv15:20.4": "piyadassissa satthuno. ",
  "bv15:21.1": "21. Sujātā dhammadinnā ca, ",
  "bv15:21.2": "ahesuṃ aggasāvikā; ",
  "bv15:21.3": "Bodhi tassa bhagavato, ",
  "bv15:21.4": "kakudhoti pavuccati. ",
  "bv15:22.1": "22. Sandhako dhammako ceva, ",
  "bv15:22.2": "ahesuṃ aggupaṭṭhakā; ",
  "bv15:22.3": "Visākhā dhammadinnā ca, ",
  "bv15:22.4": "ahesuṃ aggupaṭṭhikā. ",
  "bv15:23.1": "23. Sopi buddho amitayaso, ",
  "bv15:23.2": "dvattiṃsavaralakkhaṇo; ",
  "bv15:23.3": "Asītihatthamubbedho, ",
  "bv15:23.4": "sālarājāva dissati. ",
  "bv15:24.1": "24. Aggicandasūriyānaṃ, ",
  "bv15:24.2": "natthi tādisikā pabhā; ",
  "bv15:24.3": "Yathā ahu pabhā tassa, ",
  "bv15:24.4": "asamassa mahesino. ",
  "bv15:25.1": "25. Tassāpi devadevassa, ",
  "bv15:25.2": "āyu tāvatakaṃ ahu; ",
  "bv15:25.3": "Navutivassasahassāni, ",
  "bv15:25.4": "loke aṭṭhāsi cakkhumā. ",
  "bv15:26.1": "26. Sopi buddho asamasamo, ",
  "bv15:26.2": "yugānipi tāni atuliyāni; ",
  "bv15:26.3": "Sabbaṃ tamantarahitaṃ, ",
  "bv15:26.4": "nanu rittā sabbasaṅkhārā. ",
  "bv15:27.1": "27. Piyadassī munivaro, ",
  "bv15:27.2": "assatthārāmamhi nibbuto; ",
  "bv15:27.3": "Tatthevassa jinathūpo, ",
  "bv15:27.4": "tīṇiyojanamuggatoti. ",
  "bv15:28.1": "Piyadassissa bhagavato vaṃso terasamo. "
}
