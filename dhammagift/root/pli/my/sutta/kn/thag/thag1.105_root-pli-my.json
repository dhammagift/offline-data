  "thag1.105:0.4": "5. Malitavambhattheragāthā 105. ",
  "thag1.105:1.1": "‘‘Ukkaṇṭhitopi na vase, ",
  "thag1.105:1.2": "ramamānopi pakkame; ",
  "thag1.105:1.3": "Na tvevānatthasaṃhitaṃ, ",
  "thag1.105:1.4": "vase vāsaṃ vicakkhaṇo’’ti. … ",
  "thag1.105:1.5": "Malitavambho thero…. "
}
