  "thag1.92:0.4": "2. Vijayattheragāthā 92. ",
  "thag1.92:1.1": "‘‘Yassāsavā parikkhīṇā, ",
  "thag1.92:1.2": "āhāre ca anissito; ",
  "thag1.92:1.3": "Suññatā animitto ca, ",
  "thag1.92:1.4": "vimokkho yassa gocaro; ",
  "thag1.92:1.5": "Ākāseva sakuntānaṃ, ",
  "thag1.92:1.6": "padaṃ tassa durannaya’’nti. … ",
  "thag1.92:1.7": "Vijayo thero…. "
}
