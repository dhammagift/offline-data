  "thag1.71:0.3": "8. Aṭṭhamavaggo ",
  "thag1.71:0.4": "71. 1. Vacchapālattheragāthā ",
  "thag1.71:1.1": "‘‘Susukhumanipuṇatthadassinā, ",
  "thag1.71:1.2": "matikusalena nivātavuttinā; ",
  "thag1.71:1.3": "Saṃsevitavuddhasīlinā , ",
  "thag1.71:1.4": "nibbānaṃ na hi tena dullabha’’nti. … ",
  "thag1.71:1.5": "Vacchapālo thero…. "
}
