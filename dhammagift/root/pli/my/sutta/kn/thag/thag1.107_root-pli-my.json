  "thag1.107:0.4": "7. Dhammasavattheragāthā 107. ",
  "thag1.107:1.1": "‘‘Pabbajiṃ tulayitvāna, ",
  "thag1.107:1.2": "agārasmānagāriyaṃ; ",
  "thag1.107:1.3": "Tisso vijjā anuppattā, ",
  "thag1.107:1.4": "kataṃ buddhassa sāsana’’nti. … ",
  "thag1.107:1.5": "Dhammasavo thero…. "
}
