  "thag2.45:0.4": "209. 5. Visākhapañcālaputtattheragāthā ",
  "thag2.45:1.1": "‘‘Na ukkhipe no ca parikkhipe pare, ",
  "thag2.45:1.2": "okkhipe pāragataṃ na eraye; ",
  "thag2.45:1.3": "Na cattavaṇṇaṃ parisāsu byāhare, ",
  "thag2.45:1.4": "anuddhato sammitabhāṇi subbato. ",
  "thag2.45:2.1": "210. ‘‘Susukhumanipuṇatthadassinā, ",
  "thag2.45:2.2": "matikusalena nivātavuttinā; ",
  "thag2.45:2.3": "Saṃsevitavuddhasīlinā, ",
  "thag2.45:2.4": "nibbānaṃ na hi tena dullabha’’nti. … ",
  "thag2.45:2.5": "Visākho pañcālaputto thero …. "
}
