  "thag1.116:0.4": "116. 6. Pārāpariyattheragāthā ",
  "thag1.116:1.1": "‘‘Chaphassāyatane hitvā, ",
  "thag1.116:1.2": "guttadvāro susaṃvuto; ",
  "thag1.116:1.3": "Aghamūlaṃ vamitvāna, ",
  "thag1.116:1.4": "patto me āsavakkhayo’’ti. … ",
  "thag1.116:1.5": "Pārāpariyo thero …. "
}
