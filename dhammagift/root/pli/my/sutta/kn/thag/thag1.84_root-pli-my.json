  "thag1.84:0.4": "4. Nītattheragāthā 84. ",
  "thag1.84:1.1": "‘‘Sabbarattiṃ supitvāna, ",
  "thag1.84:1.2": "divā saṅgaṇike rato; ",
  "thag1.84:1.3": "Kudāssu nāma dummedho, ",
  "thag1.84:1.4": "dukkhassantaṃ karissatī’’ti. … ",
  "thag1.84:1.5": "Nīto thero…. "
}
