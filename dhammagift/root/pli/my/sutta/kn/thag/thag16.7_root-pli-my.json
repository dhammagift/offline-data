  "thag16.7:0.1": "",
  "thag16.7:0.2": "",
  "thag16.7:0.3": "",
  "thag16.7:0.4": "7. Kāḷigodhāputtabhaddiyattheragāthā 842. ",
  "thag16.7:1.1": "‘‘Yātaṃ me hatthigīvāya, ",
  "thag16.7:1.2": "sukhumā vatthā padhāritā; ",
  "thag16.7:1.3": "Sālīnaṃ odano bhutto, ",
  "thag16.7:1.4": "sucimaṃsūpasecano. ",
  "thag16.7:2.1": "843. ‘‘Sojja bhaddo sātatiko, ",
  "thag16.7:2.2": "uñchāpattāgate rato; ",
  "thag16.7:2.3": "Jhāyati anupādāno, ",
  "thag16.7:2.4": "putto godhāya bhaddiyo. ",
  "thag16.7:3.1": "844. ‘‘Paṃsukūlī sātatiko, ",
  "thag16.7:3.2": "uñchāpattāgate rato; ",
  "thag16.7:3.3": "Jhāyati anupādāno, ",
  "thag16.7:3.4": "putto godhāya bhaddiyo. ",
  "thag16.7:4.1": "845. ‘‘Piṇḍapātī sātatiko ",
  "thag16.7:4.2": "",
  "thag16.7:4.3": "…pe…. ",
  "thag16.7:4.4": "",
  "thag16.7:5.1": "846. ‘‘Tecīvarī sātatiko ",
  "thag16.7:5.2": "",
  "thag16.7:5.3": "…pe…. ",
  "thag16.7:5.4": "",
  "thag16.7:6.1": "847. ‘‘Sapadānacārī sātatiko ",
  "thag16.7:6.2": "",
  "thag16.7:6.3": "…pe…. ",
  "thag16.7:6.4": "",
  "thag16.7:7.1": "848. ‘‘Ekāsanī sātatiko ",
  "thag16.7:7.2": "",
  "thag16.7:7.3": "…pe…. ",
  "thag16.7:7.4": "",
  "thag16.7:8.1": "849. ‘‘Pattapiṇḍī sātatiko ",
  "thag16.7:8.2": "",
  "thag16.7:8.3": "…pe…. ",
  "thag16.7:8.4": "",
  "thag16.7:9.1": "850. ‘‘Khalupacchābhattī sātatiko ",
  "thag16.7:9.2": "",
  "thag16.7:9.3": "…pe…. ",
  "thag16.7:9.4": "",
  "thag16.7:10.1": "851. ‘‘Āraññiko sātatiko ",
  "thag16.7:10.2": "",
  "thag16.7:10.3": "…pe…. ",
  "thag16.7:10.4": "",
  "thag16.7:11.1": "852. ‘‘Rukkhamūliko sātatiko ",
  "thag16.7:11.2": "",
  "thag16.7:11.3": "…pe…. ",
  "thag16.7:11.4": "",
  "thag16.7:12.1": "853. ‘‘Abbhokāsī sātatiko ",
  "thag16.7:12.2": "",
  "thag16.7:12.3": "…pe…. ",
  "thag16.7:12.4": "",
  "thag16.7:13.1": "854. ‘‘Sosāniko sātatiko ",
  "thag16.7:13.2": "",
  "thag16.7:13.3": "…pe…. ",
  "thag16.7:13.4": "",
  "thag16.7:14.1": "855. ‘‘Yathāsanthatiko sātatiko ",
  "thag16.7:14.2": "",
  "thag16.7:14.3": "…pe…. ",
  "thag16.7:14.4": "",
  "thag16.7:15.1": "856. ‘‘Nesajjiko sātatiko ",
  "thag16.7:15.2": "",
  "thag16.7:15.3": "…pe…. ",
  "thag16.7:15.4": "",
  "thag16.7:16.1": "857. ‘‘Appiccho sātatiko ",
  "thag16.7:16.2": "",
  "thag16.7:16.3": "…pe…. ",
  "thag16.7:16.4": "",
  "thag16.7:17.1": "858. ‘‘Santuṭṭho sātatiko ",
  "thag16.7:17.2": "",
  "thag16.7:17.3": "…pe…. ",
  "thag16.7:17.4": "",
  "thag16.7:18.1": "859. ‘‘Pavivitto sātatiko ",
  "thag16.7:18.2": "",
  "thag16.7:18.3": "…pe…. ",
  "thag16.7:18.4": "",
  "thag16.7:19.1": "860. ‘‘Asaṃsaṭṭho sātatiko ",
  "thag16.7:19.2": "",
  "thag16.7:19.3": "…pe…. ",
  "thag16.7:19.4": "",
  "thag16.7:20.1": "861. ‘‘Āraddhavīriyo sātatiko ",
  "thag16.7:20.2": "",
  "thag16.7:20.3": "…pe…. ",
  "thag16.7:20.4": "",
  "thag16.7:21.1": "862. ‘‘Hitvā satapalaṃ kaṃsaṃ, ",
  "thag16.7:21.2": "sovaṇṇaṃ satarājikaṃ; ",
  "thag16.7:21.3": "Aggahiṃ mattikāpattaṃ, ",
  "thag16.7:21.4": "idaṃ dutiyābhisecanaṃ. ",
  "thag16.7:22.1": "863. ‘‘Ucce maṇḍalipākāre, ",
  "thag16.7:22.2": "daḷhamaṭṭālakoṭṭhake; ",
  "thag16.7:22.3": "Rakkhito khaggahatthehi, ",
  "thag16.7:22.4": "uttasaṃ vihariṃ pure. ",
  "thag16.7:23.1": "864. ‘‘Sojja bhaddo anutrāsī, ",
  "thag16.7:23.2": "pahīnabhayabheravo; ",
  "thag16.7:23.3": "Jhāyati vanamogayha, ",
  "thag16.7:23.4": "putto godhāya bhaddiyo. ",
  "thag16.7:24.1": "865. ‘‘Sīlakkhandhe patiṭṭhāya, ",
  "thag16.7:24.2": "satiṃ paññañca bhāvayaṃ; ",
  "thag16.7:24.3": "Pāpuṇiṃ anupubbena, ",
  "thag16.7:24.4": "sabbasaṃyojanakkhaya’’nti. … ",
  "thag16.7:24.5": "Bhaddiyo kāḷigodhāya putto thero…. "
}
