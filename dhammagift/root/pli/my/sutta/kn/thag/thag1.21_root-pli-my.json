  "thag1.21:0.3": "3. Tatiyavaggo ",
  "thag1.21:0.4": "21. 1. Nigrodhattheragāthā ",
  "thag1.21:1.1": "‘‘Nāhaṃ bhayassa bhāyāmi, ",
  "thag1.21:1.2": "satthā no amatassa kovido; ",
  "thag1.21:1.3": "Yattha bhayaṃ nāvatiṭṭhati, ",
  "thag1.21:1.4": "tena maggena vajanti bhikkhavo’’ti. … ",
  "thag1.21:1.5": "Nigrodho thero…. "
}
