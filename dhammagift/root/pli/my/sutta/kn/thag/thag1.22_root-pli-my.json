  "thag1.22:0.4": "22. 2. Cittakattheragāthā ",
  "thag1.22:1.1": "‘‘Nīlā sugīvā sikhino, ",
  "thag1.22:1.2": "morā kārambhiyaṃ abhinadanti; ",
  "thag1.22:1.3": "Te sītavātakīḷitā , ",
  "thag1.22:1.4": "suttaṃ jhāyaṃ nibodhentī’’ti. … ",
  "thag1.22:1.5": "Cittako thero…. "
}
