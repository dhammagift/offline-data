  "thag1.51:0.3": "6. Chaṭṭhavaggo ",
  "thag1.51:0.4": "1. Godhikattheragāthā 51. ",
  "thag1.51:1.1": "‘‘Vassati devo yathā sugītaṃ, ",
  "thag1.51:1.2": "channā me kuṭikā sukhā nivātā; ",
  "thag1.51:1.3": "Cittaṃ susamāhitañca mayhaṃ, ",
  "thag1.51:1.4": "atha ce patthayasi pavassa devā’’ti. … ",
  "thag1.51:1.5": "Godhiko thero…. "
}
