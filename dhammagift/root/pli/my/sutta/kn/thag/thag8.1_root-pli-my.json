{
  "thag8.1:0.1": "8. Aṭṭhakanipāto ",
  "thag8.1:0.2": "",
  "thag8.1:0.3": "",
  "thag8.1:0.4": "494. 1. Mahākaccāyanattheragāthā ",
  "thag8.1:1.1": "‘‘Kammaṃ bahukaṃ na kāraye, ",
  "thag8.1:1.2": "parivajjeyya janaṃ na uyyame; ",
  "thag8.1:1.3": "So ussukko rasānugiddho, ",
  "thag8.1:1.4": "atthaṃ riñcati yo sukhādhivāho. ",
  "thag8.1:2.1": "495. ‘‘Paṅkoti hi naṃ avedayuṃ, ",
  "thag8.1:2.2": "yāyaṃ vandanapūjanā kulesu; ",
  "thag8.1:2.3": "Sukhumaṃ sallaṃ durubbahaṃ, ",
  "thag8.1:2.4": "sakkāro kāpurisena dujjaho. ",
  "thag8.1:3.1": "496. ‘‘Na parassupanidhāya, ",
  "thag8.1:3.2": "kammaṃ maccassa pāpakaṃ; ",
  "thag8.1:3.3": "Attanā taṃ na seveyya, ",
  "thag8.1:3.4": "kammabandhūhi mātiyā. ",
  "thag8.1:4.1": "497. ‘‘Na pare vacanā coro, ",
  "thag8.1:4.2": "na pare vacanā muni; ",
  "thag8.1:4.3": "Attā ca naṃ yathāvedi , ",
  "thag8.1:4.4": "devāpi naṃ tathā vidū. ",
  "thag8.1:5.1": "498. ‘‘Pare ca na vijānanti, ",
  "thag8.1:5.2": "mayamettha yamāmase; ",
  "thag8.1:5.3": "Ye ca tattha vijānanti, ",
  "thag8.1:5.4": "tato sammanti medhagā. ",
  "thag8.1:6.1": "499. ‘‘Jīvate vāpi sappañño, ",
  "thag8.1:6.2": "api vittaparikkhayo; ",
  "thag8.1:6.3": "Paññāya ca alābhena , ",
  "thag8.1:6.4": "vittavāpi na jīvati. ",
  "thag8.1:7.1": "500. ‘‘Sabbaṃ suṇāti sotena, ",
  "thag8.1:7.2": "sabbaṃ passati cakkhunā; ",
  "thag8.1:7.3": "Na ca diṭṭhaṃ sutaṃ dhīro, ",
  "thag8.1:7.4": "sabbaṃ ujjhitumarahati. ",
  "thag8.1:8.1": "501. ‘‘Cakkhumāssa yathā andho, ",
  "thag8.1:8.2": "sotavā badhiro yathā; ",
  "thag8.1:8.3": "Paññavāssa yathā mūgo, ",
  "thag8.1:8.4": "balavā dubbaloriva; ",
  "thag8.1:8.5": "Atha atthe samuppanne, ",
  "thag8.1:8.6": "sayetha matasāyika’’nti. … ",
  "thag8.1:8.7": "Mahākaccāyano thero…. "
}
