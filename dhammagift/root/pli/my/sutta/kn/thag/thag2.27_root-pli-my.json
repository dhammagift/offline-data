  "thag2.27:0.4": "7. Nandakattheragāthā 173. ",
  "thag2.27:1.1": "‘‘Yathāpi bhaddo ājañño, ",
  "thag2.27:1.2": "khalitvā patitiṭṭhati; ",
  "thag2.27:1.3": "Bhiyyo laddāna saṃvegaṃ, ",
  "thag2.27:1.4": "adīno vahate dhuraṃ. ",
  "thag2.27:2.1": "174. ‘‘Evaṃ dassanasampannaṃ, ",
  "thag2.27:2.2": "sammāsambuddhasāvakaṃ; ",
  "thag2.27:2.3": "Ājānīyaṃ maṃ dhāretha, ",
  "thag2.27:2.4": "puttaṃ buddhassa orasa’’nti. … ",
  "thag2.27:2.5": "Nandako thero…. "
}
