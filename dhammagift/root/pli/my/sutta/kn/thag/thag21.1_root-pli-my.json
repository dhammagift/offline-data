{
  "thag21.1:0.1": "",
  "thag21.1:0.2": "21. Mahānipāto ",
  "thag21.1:0.3": "",
  "thag21.1:0.4": "1. Vaṅgīsattheragāthā 1218. ",
  "thag21.1:1.1": "‘‘Nikkhantaṃ vata maṃ santaṃ, ",
  "thag21.1:1.2": "agārasmānagāriyaṃ; ",
  "thag21.1:1.3": "Vitakkā upadhāvanti, ",
  "thag21.1:1.4": "pagabbhā kaṇhato ime. ",
  "thag21.1:2.1": "1219. ‘‘Uggaputtā mahissāsā, ",
  "thag21.1:2.2": "sikkhitā daḷhadhammino ; ",
  "thag21.1:2.3": "Samantā parikireyyuṃ, ",
  "thag21.1:2.4": "sahassaṃ apalāyinaṃ. ",
  "thag21.1:3.1": "1220. ‘‘Sacepi ettakā bhiyyo, ",
  "thag21.1:3.2": "āgamissanti itthiyo; ",
  "thag21.1:3.3": "Neva maṃ byādhayissanti , ",
  "thag21.1:3.4": "dhamme samhi patiṭṭhito. ",
  "thag21.1:4.1": "1221. ‘‘Sakkhī hi me sutaṃ etaṃ, ",
  "thag21.1:4.2": "buddhassādiccabandhuno; ",
  "thag21.1:4.3": "Nibbānagamanaṃ maggaṃ, ",
  "thag21.1:4.4": "tattha me nirato mano. ",
  "thag21.1:5.1": "1222. ‘‘Evaṃ ce maṃ viharantaṃ, ",
  "thag21.1:5.2": "pāpima upagacchasi; ",
  "thag21.1:5.3": "Tathā maccu karissāmi, ",
  "thag21.1:5.4": "na me maggampi dakkhasi. ",
  "thag21.1:6.1": "1223. ‘‘Aratiñca ratiñca pahāya, ",
  "thag21.1:6.2": "sabbaso gehasitañca vitakkaṃ; ",
  "thag21.1:6.3": "Vanathaṃ na kareyya kuhiñci, ",
  "thag21.1:6.4": "nibbanatho avanatho sa bhikkhu. ",
  "thag21.1:7.1": "1224. ‘‘Yamidha pathaviñca vehāsaṃ, ",
  "thag21.1:7.2": "rūpagataṃ jagatogadhaṃ kiñci; ",
  "thag21.1:7.3": "Parijīyati sabbamaniccaṃ, ",
  "thag21.1:7.4": "evaṃ samecca caranti mutattā. ",
  "thag21.1:8.1": "1225. ‘‘Upadhīsu janā gadhitāse, ",
  "thag21.1:8.2": "diṭṭhasute paṭighe ca mute ca; ",
  "thag21.1:8.3": "Ettha vinodaya chandamanejo, ",
  "thag21.1:8.4": "yo hettha na limpati muni tamāhu . ",
  "thag21.1:9.1": "1226. ‘‘Atha saṭṭhisitā savitakkā, ",
  "thag21.1:9.2": "puthujjanatāya adhammā niviṭṭhā; ",
  "thag21.1:9.3": "Na ca vaggagatassa kuhiñci, ",
  "thag21.1:9.4": "no pana duṭṭhullagāhī sa bhikkhu. ",
  "thag21.1:10.1": "1227. ‘‘Dabbo cirarattasamāhito, ",
  "thag21.1:10.2": "akuhako nipako apihālu; ",
  "thag21.1:10.3": "Santaṃ padaṃ ajjhagamā muni, ",
  "thag21.1:10.4": "paṭicca parinibbuto kaṅkhati kālaṃ. ",
  "thag21.1:11.1": "1228. ‘‘Mānaṃ pajahassu gotama, ",
  "thag21.1:11.2": "mānapathañca jahassu asesaṃ; ",
  "thag21.1:11.3": "Mānapathamhi sa mucchito, ",
  "thag21.1:11.4": "vippaṭisārīhuvā cirarattaṃ. ",
  "thag21.1:12.1": "1229. ‘‘Makkhena makkhitā pajā, ",
  "thag21.1:12.2": "mānahatā nirayaṃ papatanti; ",
  "thag21.1:12.3": "Socanti janā cirarattaṃ, ",
  "thag21.1:12.4": "mānahatā nirayaṃ upapannā. ",
  "thag21.1:13.1": "1230. ‘‘Na hi socati bhikkhu kadāci, ",
  "thag21.1:13.2": "maggajino sammā paṭipanno; ",
  "thag21.1:13.3": "Kittiñca sukhañcānubhoti, ",
  "thag21.1:13.4": "dhammadasoti tamāhu tathattaṃ. ",
  "thag21.1:14.1": "1231. ‘‘Tasmā akhilo idha padhānavā, ",
  "thag21.1:14.2": "nīvaraṇāni pahāya visuddho; ",
  "thag21.1:14.3": "Mānañca pahāya asesaṃ, ",
  "thag21.1:14.4": "vijjāyantakaro samitāvī. ",
  "thag21.1:15.1": "1232. ‘‘Kāmarāgena ḍayhāmi, ",
  "thag21.1:15.2": "cittaṃ me pariḍayhati; ",
  "thag21.1:15.3": "Sādhu nibbāpanaṃ brūhi, ",
  "thag21.1:15.4": "anukampāya gotama. ",
  "thag21.1:16.1": "1233. ‘‘Saññāya vipariyesā, ",
  "thag21.1:16.2": "cittaṃ te pariḍayhati; ",
  "thag21.1:16.3": "Nimittaṃ parivajjehi, ",
  "thag21.1:16.4": "subhaṃ rāgūpasaṃhitaṃ ( ) . ",
  "thag21.1:17.1": "1234. ‘‘Asubhāya cittaṃ bhāvehi, ",
  "thag21.1:17.2": "ekaggaṃ susamāhitaṃ; ",
  "thag21.1:17.3": "Sati kāyagatā tyatthu, ",
  "thag21.1:17.4": "nibbidābahulo bhava. ",
  "thag21.1:18.1": "1235. ‘‘Animittañca bhāvehi, ",
  "thag21.1:18.2": "mānānusayamujjaha; ",
  "thag21.1:18.3": "Tato mānābhisamayā, ",
  "thag21.1:18.4": "upasanto carissasi. ",
  "thag21.1:19.1": "1236. ‘‘Tameva vācaṃ bhāseyya, ",
  "thag21.1:19.2": "yāyattānaṃ na tāpaye; ",
  "thag21.1:19.3": "Pare ca na vihiṃseyya, ",
  "thag21.1:19.4": "sā ve vācā subhāsitā. ",
  "thag21.1:20.1": "1237. ‘‘Piyavācameva bhāseyya, ",
  "thag21.1:20.2": "yā vācā paṭinanditā; ",
  "thag21.1:20.3": "Yaṃ anādāya pāpāni, ",
  "thag21.1:20.4": "paresaṃ bhāsate piyaṃ. ",
  "thag21.1:21.1": "1238. ‘‘Saccaṃ ve amatā vācā, ",
  "thag21.1:21.2": "esa dhammo sanantano; ",
  "thag21.1:21.3": "Sacce atthe ca dhamme ca, ",
  "thag21.1:21.4": "āhu santo patiṭṭhitā. ",
  "thag21.1:22.1": "1239. ‘‘Yaṃ buddho bhāsati vācaṃ, ",
  "thag21.1:22.2": "khemaṃ nibbānapattiyā; ",
  "thag21.1:22.3": "Dukkhassantakiriyāya, ",
  "thag21.1:22.4": "sā ve vācānamuttamā. ",
  "thag21.1:23.1": "1240. ‘‘Gambhīrapañño medhāvī, ",
  "thag21.1:23.2": "maggāmaggassa kovido; ",
  "thag21.1:23.3": "Sāriputto mahāpañño, ",
  "thag21.1:23.4": "dhammaṃ deseti bhikkhunaṃ. ",
  "thag21.1:24.1": "1241. ‘‘Saṅkhittenapi deseti, ",
  "thag21.1:24.2": "vitthārenapi bhāsati; ",
  "thag21.1:24.3": "Sālikāyiva nigghoso, ",
  "thag21.1:24.4": "paṭibhānaṃ udiyyati . ",
  "thag21.1:25.1": "1242. ‘‘Tassa taṃ desayantassa, ",
  "thag21.1:25.2": "suṇanti madhuraṃ giraṃ; ",
  "thag21.1:25.3": "Sarena rajanīyena, ",
  "thag21.1:25.4": "savanīyena vaggunā; ",
  "thag21.1:25.5": "Udaggacittā muditā, ",
  "thag21.1:25.6": "sotaṃ odhenti bhikkhavo. ",
  "thag21.1:26.1": "1243. ‘‘Ajja pannarase visuddhiyā, ",
  "thag21.1:26.2": "bhikkhū pañcasatā samāgatā; ",
  "thag21.1:26.3": "Saṃyojanabandhanacchidā, ",
  "thag21.1:26.4": "anīghā khīṇapunabbhavā isī. ",
  "thag21.1:27.1": "1244. ‘‘Cakkavattī yathā rājā, ",
  "thag21.1:27.2": "amaccaparivārito; ",
  "thag21.1:27.3": "Samantā anupariyeti, ",
  "thag21.1:27.4": "sāgarantaṃ mahiṃ imaṃ. ",
  "thag21.1:28.1": "1245. ‘‘Evaṃ vijitasaṅgāmaṃ, ",
  "thag21.1:28.2": "satthavāhaṃ anuttaraṃ; ",
  "thag21.1:28.3": "Sāvakā payirupāsanti, ",
  "thag21.1:28.4": "tevijjā maccuhāyino. ",
  "thag21.1:29.1": "1246. ‘‘Sabbe bhagavato puttā, ",
  "thag21.1:29.2": "palāpettha na vijjati; ",
  "thag21.1:29.3": "Taṇhāsallassa hantāraṃ, ",
  "thag21.1:29.4": "vande ādiccabandhunaṃ. ",
  "thag21.1:30.1": "1247. ‘‘Parosahassaṃ bhikkhūnaṃ, ",
  "thag21.1:30.2": "sugataṃ payirupāsati; ",
  "thag21.1:30.3": "Desentaṃ virajaṃ dhammaṃ, ",
  "thag21.1:30.4": "nibbānaṃ akutobhayaṃ. ",
  "thag21.1:31.1": "1248. ‘‘Suṇanti dhammaṃ vimalaṃ, ",
  "thag21.1:31.2": "sammāsambuddhadesitaṃ; ",
  "thag21.1:31.3": "Sobhati vata sambuddho, ",
  "thag21.1:31.4": "bhikkhusaṅghapurakkhato. ",
  "thag21.1:32.1": "1249. ‘‘‘Nāganāmo’si bhagavā, ",
  "thag21.1:32.2": "isīnaṃ isisattamo; ",
  "thag21.1:32.3": "Mahāmeghova hutvāna, ",
  "thag21.1:32.4": "sāvake abhivassasi. ",
  "thag21.1:33.1": "1250. ‘‘Divā vihārā nikkhamma, ",
  "thag21.1:33.2": "satthudassanakamyatā; ",
  "thag21.1:33.3": "Sāvako te mahāvīra, ",
  "thag21.1:33.4": "pāde vandati vaṅgiso. ",
  "thag21.1:34.1": "1251. ‘‘Ummaggapathaṃ mārassa, ",
  "thag21.1:34.2": "abhibhuyya carati pabhijja khīlāni; ",
  "thag21.1:34.3": "Taṃ passatha bandhapamuñcakaraṃ, ",
  "thag21.1:34.4": "asitaṃva bhāgaso pavibhajja. ",
  "thag21.1:35.1": "1252. ‘‘Oghassa hi nitaraṇatthaṃ, ",
  "thag21.1:35.2": "anekavihitaṃ maggaṃ akkhāsi; ",
  "thag21.1:35.3": "Tasmiñca amate akkhāte, ",
  "thag21.1:35.4": "dhammadasā ṭhitā asaṃhīrā. ",
  "thag21.1:36.1": "1253. ‘‘Pajjotakaro ativijjha , ",
  "thag21.1:36.2": "sabbaṭhitīnaṃ atikkamamaddasa ; ",
  "thag21.1:36.3": "Ñatvā ca sacchikatvā ca, ",
  "thag21.1:36.4": "aggaṃ so desayi dasaddhānaṃ. ",
  "thag21.1:37.1": "1254. ‘‘Evaṃ sudesite dhamme, ",
  "thag21.1:37.2": "ko pamādo vijānataṃ dhammaṃ; ",
  "thag21.1:37.3": "Tasmā hi tassa bhagavato sāsane, ",
  "thag21.1:37.4": "appamatto sadā namassamanusikkhe. ",
  "thag21.1:38.1": "1255. ‘‘Buddhānubuddho yo thero, ",
  "thag21.1:38.2": "koṇḍañño tibbanikkamo; ",
  "thag21.1:38.3": "Lābhī sukhavihārānaṃ, ",
  "thag21.1:38.4": "vivekānaṃ abhiṇhaso. ",
  "thag21.1:39.1": "1256. ‘‘Yaṃ sāvakena pattabbaṃ, ",
  "thag21.1:39.2": "satthu sāsanakārinā; ",
  "thag21.1:39.3": "Sabbassa taṃ anuppattaṃ, ",
  "thag21.1:39.4": "appamattassa sikkhato. ",
  "thag21.1:40.1": "1257. ‘‘Mahānubhāvo tevijjo, ",
  "thag21.1:40.2": "cetopariyakovido; ",
  "thag21.1:40.3": "Koṇḍañño buddhadāyādo, ",
  "thag21.1:40.4": "pāde vandati satthuno. ",
  "thag21.1:41.1": "1258. ‘‘Nagassa passe āsīnaṃ, ",
  "thag21.1:41.2": "muniṃ dukkhassa pāraguṃ; ",
  "thag21.1:41.3": "Sāvakā payirupāsanti, ",
  "thag21.1:41.4": "tevijjā maccuhāyino. ",
  "thag21.1:42.1": "1259. ‘‘Cetasā anupariyeti, ",
  "thag21.1:42.2": "moggallāno mahiddhiko; ",
  "thag21.1:42.3": "Cittaṃ nesaṃ samanvesaṃ , ",
  "thag21.1:42.4": "vippamuttaṃ nirūpadhiṃ. ",
  "thag21.1:43.1": "1260. ‘‘Evaṃ sabbaṅgasampannaṃ, ",
  "thag21.1:43.2": "muniṃ dukkhassa pāraguṃ; ",
  "thag21.1:43.3": "Anekākārasampannaṃ, ",
  "thag21.1:43.4": "payirupāsanti gotamaṃ. ",
  "thag21.1:44.1": "1261. ‘‘Cando yathā vigatavalāhake nabhe, ",
  "thag21.1:44.2": "virocati vītamalova bhāṇumā; ",
  "thag21.1:44.3": "Evampi aṅgīrasa tvaṃ mahāmuni, ",
  "thag21.1:44.4": "atirocasi yasasā sabbalokaṃ. ",
  "thag21.1:45.1": "1262. ‘‘Kāveyyamattā vicarimha pubbe, ",
  "thag21.1:45.2": "gāmā gāmaṃ purā puraṃ; ",
  "thag21.1:45.3": "Athaddasāma sambuddhaṃ, ",
  "thag21.1:45.4": "sabbadhammāna pāraguṃ. ",
  "thag21.1:46.1": "1263. ‘‘So me dhammamadesesi, ",
  "thag21.1:46.2": "muni dukkhassa pāragū; ",
  "thag21.1:46.3": "Dhammaṃ sutvā pasīdimha, ",
  "thag21.1:46.4": "saddhā no udapajjatha. ",
  "thag21.1:47.1": "1264. ‘‘Tassāhaṃ vacanaṃ sutvā, ",
  "thag21.1:47.2": "khandhe āyatanāni ca; ",
  "thag21.1:47.3": "Dhātuyo ca viditvāna, ",
  "thag21.1:47.4": "pabbajiṃ anagāriyaṃ. ",
  "thag21.1:48.1": "1265. ‘‘Bahūnaṃ vata atthāya, ",
  "thag21.1:48.2": "uppajjanti tathāgatā; ",
  "thag21.1:48.3": "Itthīnaṃ purisānañca, ",
  "thag21.1:48.4": "ye te sāsanakārakā. ",
  "thag21.1:49.1": "1266. ‘‘Tesaṃ kho vata atthāya, ",
  "thag21.1:49.2": "bodhimajjhagamā muni; ",
  "thag21.1:49.3": "Bhikkhūnaṃ bhikkhunīnañca, ",
  "thag21.1:49.4": "ye nirāmagataddasā. ",
  "thag21.1:50.1": "1267. ‘‘Sudesitā cakkhumatā, ",
  "thag21.1:50.2": "buddhenādiccabandhunā; ",
  "thag21.1:50.3": "Cattāri ariyasaccāni, ",
  "thag21.1:50.4": "anukampāya pāṇinaṃ. ",
  "thag21.1:51.1": "1268. ‘‘Dukkhaṃ dukkhasamuppādaṃ, ",
  "thag21.1:51.2": "dukkhassa ca atikkamaṃ; ",
  "thag21.1:51.3": "Ariyaṃ caṭṭhaṅgikaṃ maggaṃ, ",
  "thag21.1:51.4": "dukkhūpasamagāminaṃ. ",
  "thag21.1:52.1": "1269. ‘‘Evamete tathā vuttā, ",
  "thag21.1:52.2": "diṭṭhā me te yathā tathā; ",
  "thag21.1:52.3": "Sadattho me anuppatto, ",
  "thag21.1:52.4": "kataṃ buddhassa sāsanaṃ. ",
  "thag21.1:53.1": "1270. ‘‘Svāgataṃ vata me āsi, ",
  "thag21.1:53.2": "mama buddhassa santike; ",
  "thag21.1:53.3": "Suvibhattesu dhammesu, ",
  "thag21.1:53.4": "yaṃ seṭṭhaṃ tadupāgamiṃ. ",
  "thag21.1:54.1": "1271. ‘‘Abhiññāpāramippatto, ",
  "thag21.1:54.2": "sotadhātu visodhitā; ",
  "thag21.1:54.3": "Tevijjo iddhipattomhi, ",
  "thag21.1:54.4": "cetopariyakovido. ",
  "thag21.1:55.1": "1272. ‘‘Pucchāmi satthāramanomapaññaṃ, ",
  "thag21.1:55.2": "diṭṭheva dhamme yo vicikicchānaṃ chettā; ",
  "thag21.1:55.3": "Aggāḷave kālamakāsi bhikkhu, ",
  "thag21.1:55.4": "ñāto yasassī abhinibbutatto. ",
  "thag21.1:56.1": "1273. ‘‘Nigrodhakappo iti tassa nāmaṃ, ",
  "thag21.1:56.2": "tayā kataṃ bhagavā brāhmaṇassa; ",
  "thag21.1:56.3": "So taṃ namassaṃ acari mutyapekho, ",
  "thag21.1:56.4": "āraddhavīriyo daḷhadhammadassī. ",
  "thag21.1:57.1": "1274. ‘‘Taṃ sāvakaṃ sakka mayampi sabbe, ",
  "thag21.1:57.2": "aññātumicchāma samantacakkhu; ",
  "thag21.1:57.3": "Samavaṭṭhitā no savanāya sotā , ",
  "thag21.1:57.4": "tuvaṃ no satthā tvamanuttarosi’’. ",
  "thag21.1:58.1": "1275. Chinda no vicikicchaṃ brūhi metaṃ, ",
  "thag21.1:58.2": "parinibbutaṃ vedaya bhūripañña; ",
  "thag21.1:58.3": "Majjheva no bhāsa samantacakkhu, ",
  "thag21.1:58.4": "sakkova devāna sahassanetto. ",
  "thag21.1:59.1": "1276. ‘‘Ye keci ganthā idha mohamaggā, ",
  "thag21.1:59.2": "aññāṇapakkhā vicikicchaṭhānā; ",
  "thag21.1:59.3": "Tathāgataṃ patvā na te bhavanti, ",
  "thag21.1:59.4": "cakkhuñhi etaṃ paramaṃ narānaṃ. ",
  "thag21.1:60.1": "1277. ‘‘No ce hi jātu puriso kilese, ",
  "thag21.1:60.2": "vāto yathā abbhaghanaṃ vihāne; ",
  "thag21.1:60.3": "Tamovassa nivuto sabbaloko, ",
  "thag21.1:60.4": "jotimantopi na pabhāseyyuṃ . ",
  "thag21.1:61.1": "1278. ‘‘Dhīrā ca pajjotakarā bhavanti, ",
  "thag21.1:61.2": "taṃ taṃ ahaṃ vīra tatheva maññe; ",
  "thag21.1:61.3": "Vipassinaṃ jānamupāgamimha, ",
  "thag21.1:61.4": "parisāsu no āvikarohi kappaṃ. ",
  "thag21.1:62.1": "1279. ‘‘Khippaṃ giraṃ eraya vaggu vagguṃ, ",
  "thag21.1:62.2": "haṃsova paggayha saṇikaṃ nikūja; ",
  "thag21.1:62.3": "Bindussarena suvikappitena, ",
  "thag21.1:62.4": "sabbeva te ujjugatā suṇoma. ",
  "thag21.1:63.1": "1280. ‘‘Pahīnajātimaraṇaṃ asesaṃ, ",
  "thag21.1:63.2": "niggayha dhonaṃ vadessāmi dhammaṃ; ",
  "thag21.1:63.3": "Na kāmakāro hi puthujjanānaṃ, ",
  "thag21.1:63.4": "saṅkheyyakāro ca tathāgatānaṃ. ",
  "thag21.1:64.1": "1281. ‘‘Sampannaveyyākaraṇaṃ tavedaṃ, ",
  "thag21.1:64.2": "samujjupaññassa samuggahītaṃ; ",
  "thag21.1:64.3": "Ayamañjali pacchimo suppaṇāmito, ",
  "thag21.1:64.4": "mā mohayī jānamanomapañña. ",
  "thag21.1:65.1": "1282. ‘‘Paroparaṃ ariyadhammaṃ viditvā, ",
  "thag21.1:65.2": "mā mohayī jānamanomavīriya; ",
  "thag21.1:65.3": "Vāriṃ yathā ghammani ghammatatto, ",
  "thag21.1:65.4": "vācābhikaṅkhāmi sutaṃ pavassa. ",
  "thag21.1:66.1": "1283. ‘‘Yadatthikaṃ brahmacariyaṃ acarī, ",
  "thag21.1:66.2": "kappāyano kaccissataṃ amoghaṃ; ",
  "thag21.1:66.3": "Nibbāyi so ādu saupādiseso , ",
  "thag21.1:66.4": "yathā vimutto ahu taṃ suṇoma. ",
  "thag21.1:67.1": "1284. ‘‘‘Acchecchi taṇhaṃ idha nāmarūpe, ",
  "thag21.1:67.2": "(Iti bhagavā) ",
  "thag21.1:67.3": "kaṇhassa sotaṃ dīgharattānusayitaṃ; ",
  "thag21.1:67.4": "Atāri jātiṃ maraṇaṃ asesaṃ’, ",
  "thag21.1:67.5": "iccabravi bhagavā pañcaseṭṭho. ",
  "thag21.1:68.1": "1285. ‘‘Esa sutvā pasīdāmi, ",
  "thag21.1:68.2": "vaco te isisattama; ",
  "thag21.1:68.3": "Amoghaṃ kira me puṭṭhaṃ, ",
  "thag21.1:68.4": "na maṃ vañcesi brāhmaṇo. ",
  "thag21.1:69.1": "1286. ‘‘Yathā vādī tathā kārī, ",
  "thag21.1:69.2": "ahu buddhassa sāvako; ",
  "thag21.1:69.3": "Acchecchi maccuno jālaṃ, ",
  "thag21.1:69.4": "tataṃ māyāvino daḷhaṃ. ",
  "thag21.1:70.1": "1287. ‘‘Addasa bhagavā ādiṃ, ",
  "thag21.1:70.2": "upādānassa kappiyo; ",
  "thag21.1:70.3": "Accagā vata kappāno, ",
  "thag21.1:70.4": "maccudheyyaṃ suduttaraṃ. ",
  "thag21.1:71.1": "1288. ‘‘Taṃ devadevaṃ vandāmi, ",
  "thag21.1:71.2": "puttaṃ te dvipaduttama; ",
  "thag21.1:71.3": "Anujātaṃ mahāvīraṃ, ",
  "thag21.1:71.4": "nāgaṃ nāgassa orasa’’nti. ",
  "thag21.1:71.5": "Itthaṃ sudaṃ āyasmā vaṅgīso thero gāthāyo Abhāsitthāti. ",
  "thag21.1:71.6": "Mahānipāto niṭṭhito. ",
  "thag21.1:72.0": "Tatruddānaṃ – ",
  "thag21.1:72.1": "Sattatimhi nipātamhi, ",
  "thag21.1:72.2": "vaṅgīso paṭibhāṇavā; ",
  "thag21.1:72.3": "Ekova thero natthañño, ",
  "thag21.1:72.4": "gāthāyo ekasattatīti. ",
  "thag21.1:72.5": "Niṭṭhitā theragāthāyo. ",
  "thag21.1:73.0": "Tatruddānaṃ – ",
  "thag21.1:73.1": "Sahassaṃ honti tā gāthā, ",
  "thag21.1:73.2": "tīṇi saṭṭhisatāni ca; ",
  "thag21.1:73.3": "Therā ca dve satā saṭṭhi, ",
  "thag21.1:73.4": "cattāro ca pakāsitā. ",
  "thag21.1:74.1": "Sīhanādaṃ naditvāna, ",
  "thag21.1:74.2": "buddhaputtā anāsavā; ",
  "thag21.1:74.3": "Khemantaṃ pāpuṇitvāna, ",
  "thag21.1:74.4": "aggikhandhāva nibbutāti. ",
  "thag21.1:74.5": "Theragāthāpāḷi niṭṭhitā. "
}
