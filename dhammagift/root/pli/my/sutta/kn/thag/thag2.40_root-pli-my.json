  "thag2.40:0.3": "",
  "thag2.40:0.4": "10. Kappaṭakurattheragāthā 199. ",
  "thag2.40:1.1": "‘‘Ayamiti kappaṭo kappaṭakuro, ",
  "thag2.40:1.2": "acchāya atibharitāya ; ",
  "thag2.40:1.3": "Amataghaṭikāyaṃ dhammakaṭamatto , ",
  "thag2.40:1.4": "katapadaṃ jhānāni ocetuṃ. ",
  "thag2.40:2.1": "200. ‘‘Mā kho tvaṃ kappaṭa pacālesi, ",
  "thag2.40:2.2": "mā tvaṃ upakaṇṇamhi tāḷessaṃ; ",
  "thag2.40:2.3": "Na hi tvaṃ kappaṭa mattamaññāsi, ",
  "thag2.40:2.4": "saṅghamajjhamhi pacalāyamānoti. … ",
  "thag2.40:2.5": "Kappaṭakuro thero…. ",
  "thag2.40:2.6": "Vaggo catuttho niṭṭhito. ",
  "thag2.40:3.0": "Tassuddānaṃ – ",
  "thag2.40:3.1": "Migasiro sivako ca, ",
  "thag2.40:3.2": "upavāno ca paṇḍito; ",
  "thag2.40:3.3": "Isidinno ca kaccāno, ",
  "thag2.40:3.4": "nitako ca mahāvasī; ",
  "thag2.40:3.5": "Poṭiriyaputto nisabho, ",
  "thag2.40:3.6": "usabho kappaṭakuroti. "
}
