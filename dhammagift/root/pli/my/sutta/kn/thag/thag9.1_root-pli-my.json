{
  "thag9.1:0.1": "9. Navakanipāto ",
  "thag9.1:0.2": "",
  "thag9.1:0.3": "",
  "thag9.1:0.4": "518. 1. Bhūtattheragāthā ",
  "thag9.1:1.1": "‘‘Yadā dukkhaṃ jarāmaraṇanti paṇḍito, ",
  "thag9.1:1.2": "aviddasū yattha sitā puthujjanā; ",
  "thag9.1:1.3": "Dukkhaṃ pariññāya satova jhāyati, ",
  "thag9.1:1.4": "tato ratiṃ paramataraṃ na vindati. ",
  "thag9.1:2.1": "519. ‘‘Yadā dukkhassāvahaniṃ visattikaṃ, ",
  "thag9.1:2.2": "papañcasaṅghātadukhādhivāhiniṃ; ",
  "thag9.1:2.3": "Taṇhaṃ pahantvāna satova jhāyati, ",
  "thag9.1:2.4": "tato ratiṃ paramataraṃ na vindati. ",
  "thag9.1:3.1": "520. ‘‘Yadā sivaṃ dvecaturaṅgagāminaṃ, ",
  "thag9.1:3.2": "magguttamaṃ sabbakilesasodhanaṃ; ",
  "thag9.1:3.3": "Paññāya passitva satova jhāyati, ",
  "thag9.1:3.4": "tato ratiṃ paramataraṃ na vindati. ",
  "thag9.1:4.1": "521. ‘‘Yadā asokaṃ virajaṃ asaṅkhataṃ, ",
  "thag9.1:4.2": "santaṃ padaṃ sabbakilesasodhanaṃ; ",
  "thag9.1:4.3": "Bhāveti saññojanabandhanacchidaṃ, ",
  "thag9.1:4.4": "tato ratiṃ paramataraṃ na vindati. ",
  "thag9.1:5.1": "522. ‘‘Yadā nabhe gajjati meghadundubhi, ",
  "thag9.1:5.2": "dhārākulā vihagapathe samantato; ",
  "thag9.1:5.3": "Bhikkhū ca pabbhāragatova jhāyati, ",
  "thag9.1:5.4": "tato ratiṃ paramataraṃ na vindati. ",
  "thag9.1:6.1": "523. ‘‘Yadā nadīnaṃ kusumākulānaṃ, ",
  "thag9.1:6.2": "vicitta-vāneyya-vaṭaṃsakānaṃ; ",
  "thag9.1:6.3": "Tīre nisinno sumanova jhāyati, ",
  "thag9.1:6.4": "tato ratiṃ paramataraṃ na vindati. ",
  "thag9.1:7.1": "524. ‘‘Yadā nisīthe rahitamhi kānane, ",
  "thag9.1:7.2": "deve gaḷantamhi nadanti dāṭhino; ",
  "thag9.1:7.3": "Bhikkhū ca pabbhāragatova jhāyati, ",
  "thag9.1:7.4": "tato ratiṃ paramataraṃ na vindati. ",
  "thag9.1:8.1": "525. ‘‘Yadā vitakke uparundhiyattano, ",
  "thag9.1:8.2": "nagantare nagavivaraṃ samassito; ",
  "thag9.1:8.3": "Vītaddaro vītakhilova jhāyati, ",
  "thag9.1:8.4": "tato ratiṃ paramataraṃ na vindati. ",
  "thag9.1:9.1": "526. ‘‘Yadā sukhī malakhilasokanāsano, ",
  "thag9.1:9.2": "niraggaḷo nibbanatho visallo; ",
  "thag9.1:9.3": "Sabbāsave byantikatova jhāyati, ",
  "thag9.1:9.4": "tato ratiṃ paramataraṃ na vindatī’’ti. … ",
  "thag9.1:9.5": "Bhūto thero…. ",
  "thag9.1:9.6": "Navakanipāto niṭṭhito. ",
  "thag9.1:10.0": "Tatruddānaṃ – ",
  "thag9.1:10.1": "Bhūto tathaddaso thero, ",
  "thag9.1:10.2": "eko khaggavisāṇavā; ",
  "thag9.1:10.3": "Navakamhi nipātamhi, ",
  "thag9.1:10.4": "gāthāyopi imā navāti. "
}
