  "thag1.111:0.3": "12. Dvādasamavaggo ",
  "thag1.111:0.4": "1. Jentattheragāthā 111. ",
  "thag1.111:1.1": "‘‘Duppabbajjaṃ ve duradhivāsā gehā, ",
  "thag1.111:1.2": "dhammo gambhīro duradhigamā bhogā; ",
  "thag1.111:1.3": "Kicchā vutti no itarītareneva, ",
  "thag1.111:1.4": "yuttaṃ cintetuṃ satatamaniccata’’nti. … ",
  "thag1.111:1.5": "Jento thero…. "
}
