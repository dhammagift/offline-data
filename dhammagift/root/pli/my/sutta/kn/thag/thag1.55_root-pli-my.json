  "thag1.55:0.4": "5. Añjanavaniyattheragāthā 55. ",
  "thag1.55:1.1": "‘‘Āsandiṃ kuṭikaṃ katvā, ",
  "thag1.55:1.2": "ogayha añjanaṃ vanaṃ; ",
  "thag1.55:1.3": "Tisso vijjā anuppattā, ",
  "thag1.55:1.4": "kataṃ buddhassa sāsana’’nti. … ",
  "thag1.55:1.5": "Añjanavaniyo thero…. "
}
