  "thag2.29:0.4": "177. 9. Bhāradvājattheragāthā ",
  "thag2.29:1.1": "‘‘Nadanti evaṃ sappaññā, ",
  "thag2.29:1.2": "sīhāva girigabbhare; ",
  "thag2.29:1.3": "Vīrā vijitasaṅgāmā, ",
  "thag2.29:1.4": "jetvā māraṃ savāhaniṃ . ",
  "thag2.29:2.1": "178. ‘‘Satthā ca pariciṇṇo me, ",
  "thag2.29:2.2": "dhammo saṅgho ca pūjito; ",
  "thag2.29:2.3": "Ahañca vitto sumano, ",
  "thag2.29:2.4": "puttaṃ disvā anāsava’’nti. … ",
  "thag2.29:2.5": "Bhāradvājo thero…. "
}
