  "thag8.2:0.3": "",
  "thag8.2:0.4": "2. Sirimittattheragāthā 502. ",
  "thag8.2:1.1": "‘‘Akkodhanonupanāhī, ",
  "thag8.2:1.2": "amāyo rittapesuṇo; ",
  "thag8.2:1.3": "Sa ve tādisako bhikkhu, ",
  "thag8.2:1.4": "evaṃ pecca na socati. ",
  "thag8.2:2.1": "503. ‘‘Akkodhanonupanāhī, ",
  "thag8.2:2.2": "amāyo rittapesuṇo; ",
  "thag8.2:2.3": "Guttadvāro sadā bhikkhu, ",
  "thag8.2:2.4": "evaṃ pecca na socati. ",
  "thag8.2:3.1": "504. ‘‘Akkodhanonupanāhī, ",
  "thag8.2:3.2": "amāyo rittapesuṇo; ",
  "thag8.2:3.3": "Kalyāṇasīlo so bhikkhu, ",
  "thag8.2:3.4": "evaṃ pecca na socati. ",
  "thag8.2:4.1": "505. ‘‘Akkodhanonupanāhī, ",
  "thag8.2:4.2": "amāyo rittapesuṇo; ",
  "thag8.2:4.3": "Kalyāṇamitto so bhikkhu, ",
  "thag8.2:4.4": "evaṃ pecca na socati. ",
  "thag8.2:5.1": "506. ‘‘Akkodhanonupanāhī, ",
  "thag8.2:5.2": "amāyo rittapesuṇo; ",
  "thag8.2:5.3": "Kalyāṇapañño so bhikkhu, ",
  "thag8.2:5.4": "evaṃ pecca na socati. ",
  "thag8.2:6.1": "507. ‘‘Yassa saddhā tathāgate, ",
  "thag8.2:6.2": "acalā suppatiṭṭhitā; ",
  "thag8.2:6.3": "Sīlañca yassa kalyāṇaṃ, ",
  "thag8.2:6.4": "ariyakantaṃ pasaṃsitaṃ. ",
  "thag8.2:7.1": "508. ‘‘Saṅghe pasādo yassatthi, ",
  "thag8.2:7.2": "ujubhūtañca dassanaṃ; ",
  "thag8.2:7.3": "‘Adaliddo’ti taṃ āhu, ",
  "thag8.2:7.4": "amoghaṃ tassa jīvitaṃ. ",
  "thag8.2:8.1": "509. ‘‘Tasmā saddhañca sīlañca, ",
  "thag8.2:8.2": "pasādaṃ dhammadassanaṃ; ",
  "thag8.2:8.3": "Anuyuñjetha medhāvī, ",
  "thag8.2:8.4": "saraṃ buddhāna sāsana’’nti. … ",
  "thag8.2:8.5": "Sirimitto thero…. "
}
