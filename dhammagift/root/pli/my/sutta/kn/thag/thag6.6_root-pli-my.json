  "thag6.6:0.4": "405. 6. Sappadāsattheragāthā ",
  "thag6.6:1.1": "‘‘Paṇṇavīsativassāni, ",
  "thag6.6:1.2": "yato pabbajito ahaṃ; ",
  "thag6.6:1.3": "Accharāsaṅghātamattampi, ",
  "thag6.6:1.4": "cetosantimanajjhagaṃ. ",
  "thag6.6:2.1": "406. ‘‘Aladdhā cittassekaggaṃ, ",
  "thag6.6:2.2": "kāmarāgena aṭṭito ; ",
  "thag6.6:2.3": "Bāhā paggayha kandanto, ",
  "thag6.6:2.4": "vihārā upanikkhamiṃ . ",
  "thag6.6:3.1": "407. ‘‘Satthaṃ vā āharissāmi, ",
  "thag6.6:3.2": "ko attho jīvitena me; ",
  "thag6.6:3.3": "Kathaṃ hi sikkhaṃ paccakkhaṃ, ",
  "thag6.6:3.4": "kālaṃ kubbetha mādiso. ",
  "thag6.6:4.1": "408. ‘‘Tadāhaṃ khuramādāya, ",
  "thag6.6:4.2": "mañcakamhi upāvisiṃ; ",
  "thag6.6:4.3": "Parinīto khuro āsi, ",
  "thag6.6:4.4": "dhamaniṃ chettumattano. ",
  "thag6.6:5.1": "409. ‘‘Tato me manasīkāro, ",
  "thag6.6:5.2": "yoniso udapajjatha; ",
  "thag6.6:5.3": "Ādīnavo pāturahu, ",
  "thag6.6:5.4": "nibbidā samatiṭṭhatha. ",
  "thag6.6:6.1": "410. ‘‘Tato cittaṃ vimucci me, ",
  "thag6.6:6.2": "passa dhammasudhammataṃ; ",
  "thag6.6:6.3": "Tisso vijjā anuppattā, ",
  "thag6.6:6.4": "kataṃ buddhassa sāsana’’nti. … ",
  "thag6.6:6.5": "Sappadāso thero…. "
}
