{
  "thag18.1:0.1": "",
  "thag18.1:0.2": "18. Cattālīsanipāto ",
  "thag18.1:0.3": "",
  "thag18.1:0.4": "1. Mahākassapattheragāthā 1054. ",
  "thag18.1:1.1": "‘‘Na gaṇena purakkhato care, ",
  "thag18.1:1.2": "vimano hoti samādhi dullabho; ",
  "thag18.1:1.3": "Nānājanasaṅgaho dukho, ",
  "thag18.1:1.4": "iti disvāna gaṇaṃ na rocaye. ",
  "thag18.1:2.1": "1055. ‘‘Na kulāni upabbaje muni, ",
  "thag18.1:2.2": "vimano hoti samādhi dullabho; ",
  "thag18.1:2.3": "So ussukko rasānugiddho, ",
  "thag18.1:2.4": "atthaṃ riñcati yo sukhāvaho. ",
  "thag18.1:3.1": "1056. ‘‘Paṅkoti hi naṃ avedayuṃ, ",
  "thag18.1:3.2": "yāyaṃ vandanapūjanā kulesu; ",
  "thag18.1:3.3": "Sukhumaṃ salla durubbahaṃ, ",
  "thag18.1:3.4": "sakkāro kāpurisena dujjaho. ",
  "thag18.1:4.1": "1057. ‘‘Senāsanamhā oruyha, ",
  "thag18.1:4.2": "nagaraṃ piṇḍāya pāvisiṃ; ",
  "thag18.1:4.3": "Bhuñjantaṃ purisaṃ kuṭṭhiṃ, ",
  "thag18.1:4.4": "sakkaccaṃ taṃ upaṭṭhahiṃ. ",
  "thag18.1:5.1": "1058. ‘‘So me pakkena hatthena, ",
  "thag18.1:5.2": "ālopaṃ upanāmayi; ",
  "thag18.1:5.3": "Ālopaṃ pakkhipantassa, ",
  "thag18.1:5.4": "aṅguli cettha chijjatha. ",
  "thag18.1:6.1": "1059. ‘‘Kuṭṭamūlañca nissāya, ",
  "thag18.1:6.2": "ālopaṃ taṃ abhuñjisaṃ; ",
  "thag18.1:6.3": "Bhuñjamāne vā bhutte vā, ",
  "thag18.1:6.4": "jegucchaṃ me na vijjati. ",
  "thag18.1:7.1": "1060. ‘‘Uttiṭṭhapiṇḍo āhāro, ",
  "thag18.1:7.2": "pūtimuttañca osadhaṃ; ",
  "thag18.1:7.3": "Senāsanaṃ rukkhamūlaṃ, ",
  "thag18.1:7.4": "paṃsukūlañca cīvaraṃ; ",
  "thag18.1:7.5": "Yassete abhisambhutvā , ",
  "thag18.1:7.6": "sa ve cātuddiso naro. ",
  "thag18.1:8.1": "1061. ‘‘Yattha eke vihaññanti, ",
  "thag18.1:8.2": "āruhantā siluccayaṃ; ",
  "thag18.1:8.3": "Tassa buddhassa dāyādo, ",
  "thag18.1:8.4": "sampajāno patissato; ",
  "thag18.1:8.5": "Iddhibalenupatthaddho, ",
  "thag18.1:8.6": "kassapo abhirūhati. ",
  "thag18.1:9.1": "1062. ‘‘Piṇḍapātapaṭikkanto, ",
  "thag18.1:9.2": "selamāruyha kassapo; ",
  "thag18.1:9.3": "Jhāyati anupādāno, ",
  "thag18.1:9.4": "pahīnabhayabheravo. ",
  "thag18.1:10.1": "1063. ‘‘Piṇḍapātapaṭikkanto, ",
  "thag18.1:10.2": "selamāruyha kassapo; ",
  "thag18.1:10.3": "Jhāyati anupādāno, ",
  "thag18.1:10.4": "ḍayhamānesu nibbuto. ",
  "thag18.1:11.1": "1064. ‘‘Piṇḍapātapaṭikkanto, ",
  "thag18.1:11.2": "selamāruyha kassapo; ",
  "thag18.1:11.3": "Jhāyati anupādāno, ",
  "thag18.1:11.4": "katakicco anāsavo. ",
  "thag18.1:12.1": "1065. ‘‘Karerimālāvitatā, ",
  "thag18.1:12.2": "bhūmibhāgā manoramā; ",
  "thag18.1:12.3": "Kuñjarābhirudā rammā, ",
  "thag18.1:12.4": "te selā ramayanti maṃ. ",
  "thag18.1:13.1": "1066. ‘‘Nīlabbhavaṇṇā rucirā, ",
  "thag18.1:13.2": "vārisītā sucindharā; ",
  "thag18.1:13.3": "Indagopakasañchannā, ",
  "thag18.1:13.4": "te selā ramayanti maṃ. ",
  "thag18.1:14.1": "1067. ‘‘Nīlabbhakūṭasadisā, ",
  "thag18.1:14.2": "kūṭāgāravarūpamā; ",
  "thag18.1:14.3": "Vāraṇābhirudā rammā, ",
  "thag18.1:14.4": "te selā ramayanti maṃ. ",
  "thag18.1:15.1": "1068. ‘‘Abhivuṭṭhā rammatalā, ",
  "thag18.1:15.2": "nagā isibhi sevitā; ",
  "thag18.1:15.3": "Abbhunnaditā sikhīhi, ",
  "thag18.1:15.4": "te selā ramayanti maṃ. ",
  "thag18.1:16.1": "1069. ‘‘Alaṃ jhāyitukāmassa, ",
  "thag18.1:16.2": "pahitattassa me sato; ",
  "thag18.1:16.3": "Alaṃ me atthakāmassa , ",
  "thag18.1:16.4": "pahitattassa bhikkhuno. ",
  "thag18.1:17.1": "1070. ‘‘Alaṃ me phāsukāmassa, ",
  "thag18.1:17.2": "pahitattassa bhikkhuno; ",
  "thag18.1:17.3": "Alaṃ me yogakāmassa, ",
  "thag18.1:17.4": "pahitattassa tādino. ",
  "thag18.1:18.1": "1071. ‘‘Umāpupphena samānā, ",
  "thag18.1:18.2": "gaganāvabbhachāditā; ",
  "thag18.1:18.3": "Nānādijagaṇākiṇṇā, ",
  "thag18.1:18.4": "te selā ramayanti maṃ. ",
  "thag18.1:19.1": "1072. ‘‘Anākiṇṇā gahaṭṭhehi, ",
  "thag18.1:19.2": "migasaṅghanisevitā; ",
  "thag18.1:19.3": "Nānādijagaṇākiṇṇā, ",
  "thag18.1:19.4": "te selā ramayanti maṃ. ",
  "thag18.1:20.1": "1073. ‘‘Acchodikā puthusilā, ",
  "thag18.1:20.2": "gonaṅgulamigāyutā; ",
  "thag18.1:20.3": "Ambusevālasañchannā, ",
  "thag18.1:20.4": "te selā ramayanti maṃ. ",
  "thag18.1:21.1": "1074. ‘‘Na pañcaṅgikena turiyena, ",
  "thag18.1:21.2": "rati me hoti tādisī; ",
  "thag18.1:21.3": "Yathā ekaggacittassa, ",
  "thag18.1:21.4": "sammā dhammaṃ vipassato. ",
  "thag18.1:22.1": "1075. ‘‘Kammaṃ bahukaṃ na kāraye, ",
  "thag18.1:22.2": "parivajjeyya janaṃ na uyyame; ",
  "thag18.1:22.3": "Ussukko so rasānugiddho, ",
  "thag18.1:22.4": "atthaṃ riñcati yo sukhāvaho. ",
  "thag18.1:23.1": "1076. ‘‘Kammaṃ bahukaṃ na kāraye, ",
  "thag18.1:23.2": "parivajjeyya anattaneyyametaṃ; ",
  "thag18.1:23.3": "Kicchati kāyo kilamati, ",
  "thag18.1:23.4": "dukkhito so samathaṃ na vindati. ",
  "thag18.1:24.1": "1077. ‘‘Oṭṭhappahatamattena, ",
  "thag18.1:24.2": "attānampi na passati; ",
  "thag18.1:24.3": "Patthaddhagīvo carati, ",
  "thag18.1:24.4": "ahaṃ seyyoti maññati. ",
  "thag18.1:25.1": "1078. ‘‘Aseyyo seyyasamānaṃ, ",
  "thag18.1:25.2": "bālo maññati attānaṃ; ",
  "thag18.1:25.3": "Na taṃ viññū pasaṃsanti, ",
  "thag18.1:25.4": "patthaddhamānasaṃ naraṃ. ",
  "thag18.1:26.1": "1079. ‘‘Yo ca seyyohamasmīti, ",
  "thag18.1:26.2": "nāhaṃ seyyoti vā pana; ",
  "thag18.1:26.3": "Hīno taṃsadiso vāti, ",
  "thag18.1:26.4": "vidhāsu na vikampati. ",
  "thag18.1:27.1": "1080. ‘‘Paññavantaṃ tathā tādiṃ, ",
  "thag18.1:27.2": "sīlesu susamāhitaṃ; ",
  "thag18.1:27.3": "Cetosamathamanuttaṃ, ",
  "thag18.1:27.4": "tañce viññū pasaṃsare. ",
  "thag18.1:28.1": "1081. ‘‘Yassa sabrahmacārīsu, ",
  "thag18.1:28.2": "gāravo nūpalabbhati; ",
  "thag18.1:28.3": "Ārakā hoti saddhammā, ",
  "thag18.1:28.4": "nabhato puthavī yathā. ",
  "thag18.1:29.1": "1082. ‘‘Yesañca hiri ottappaṃ, ",
  "thag18.1:29.2": "sadā sammā upaṭṭhitaṃ; ",
  "thag18.1:29.3": "Virūḷhabrahmacariyā te, ",
  "thag18.1:29.4": "tesaṃ khīṇā punabbhavā. ",
  "thag18.1:30.1": "1083. ‘‘Uddhato capalo bhikkhu, ",
  "thag18.1:30.2": "paṃsukūlena pāruto; ",
  "thag18.1:30.3": "Kapīva sīhacammena, ",
  "thag18.1:30.4": "na so tenupasobhati. ",
  "thag18.1:31.1": "1084. ‘‘Anuddhato acapalo, ",
  "thag18.1:31.2": "nipako saṃvutindriyo; ",
  "thag18.1:31.3": "Sobhati paṃsukūlena, ",
  "thag18.1:31.4": "sīhova girigabbhare. ",
  "thag18.1:32.1": "1085. ‘‘Ete sambahulā devā, ",
  "thag18.1:32.2": "iddhimanto yasassino; ",
  "thag18.1:32.3": "Dasadevasahassāni, ",
  "thag18.1:32.4": "sabbe te brahmakāyikā. ",
  "thag18.1:33.1": "1086. ‘‘Dhammasenāpatiṃ vīraṃ, ",
  "thag18.1:33.2": "mahājhāyiṃ samāhitaṃ; ",
  "thag18.1:33.3": "Sāriputtaṃ namassantā, ",
  "thag18.1:33.4": "tiṭṭhanti pañjalīkatā. ",
  "thag18.1:34.1": "1087. ‘‘‘Namo te purisājañña, ",
  "thag18.1:34.2": "namo te purisuttama; ",
  "thag18.1:34.3": "Yassa te nābhijānāma, ",
  "thag18.1:34.4": "yampi nissāya jhāyati . ",
  "thag18.1:35.1": "1088. ‘‘‘Accheraṃ vata buddhānaṃ, ",
  "thag18.1:35.2": "gambhīro gocaro sako; ",
  "thag18.1:35.3": "Ye mayaṃ nābhijānāma, ",
  "thag18.1:35.4": "vālavedhisamāgatā’. ",
  "thag18.1:36.1": "1089. ‘‘Taṃ tathā devakāyehi, ",
  "thag18.1:36.2": "pūjitaṃ pūjanārahaṃ; ",
  "thag18.1:36.3": "Sāriputtaṃ tadā disvā, ",
  "thag18.1:36.4": "kappinassa sitaṃ ahu. ",
  "thag18.1:37.1": "1090. ‘‘Yāvatā buddhakhettamhi, ",
  "thag18.1:37.2": "ṭhapayitvā mahāmuniṃ; ",
  "thag18.1:37.3": "Dhutaguṇe visiṭṭhohaṃ, ",
  "thag18.1:37.4": "sadiso me na vijjati. ",
  "thag18.1:38.1": "1091. ‘‘Pariciṇṇo mayā satthā, ",
  "thag18.1:38.2": "kataṃ buddhassa sāsanaṃ; ",
  "thag18.1:38.3": "Ohito garuko bhāro, ",
  "thag18.1:38.4": "natthi dāni punabbhavo. ",
  "thag18.1:39.1": "1092. ‘‘Na cīvare na sayane, ",
  "thag18.1:39.2": "bhojane nupalimpati; ",
  "thag18.1:39.3": "Gotamo anappameyyo, ",
  "thag18.1:39.4": "muḷālapupphaṃ vimalaṃva; ",
  "thag18.1:39.5": "Ambunā nekkhammaninno, ",
  "thag18.1:39.6": "tibhavābhinissaṭo. ",
  "thag18.1:40.1": "1093. ‘‘Satipaṭṭhānagīvo so, ",
  "thag18.1:40.2": "saddhāhattho mahāmuni; ",
  "thag18.1:40.3": "Paññāsīso mahāñāṇī, ",
  "thag18.1:40.4": "sadā carati nibbuto’’ti. … ",
  "thag18.1:40.5": "Mahākassapo thero…. ",
  "thag18.1:40.6": "Cattālīsanipāto niṭṭhito. ",
  "thag18.1:41.0": "Tatruddānaṃ – ",
  "thag18.1:41.1": "Cattālīsanipātamhi, ",
  "thag18.1:41.2": "mahākassapasavhayo; ",
  "thag18.1:41.3": "Ekova thero gāthāyo, ",
  "thag18.1:41.4": "cattāsīla duvepi cāti. "
}
