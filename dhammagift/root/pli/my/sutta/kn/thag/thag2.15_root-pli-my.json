  "thag2.15:0.4": "5. Sabbamittattheragāthā 149. ",
  "thag2.15:1.1": "‘‘Jano janamhi sambaddho , ",
  "thag2.15:1.2": "janamevassito jano; ",
  "thag2.15:1.3": "Jano janena heṭhīyati, ",
  "thag2.15:1.4": "heṭheti ca jano janaṃ. ",
  "thag2.15:2.1": "150. ‘‘Ko hi tassa janenattho, ",
  "thag2.15:2.2": "janena janitena vā; ",
  "thag2.15:2.3": "Janaṃ ohāya gacchaṃ taṃ, ",
  "thag2.15:2.4": "heṭhayitvā bahuṃ jana’’nti. … ",
  "thag2.15:2.5": "Sabbamitto thero…. "
}
