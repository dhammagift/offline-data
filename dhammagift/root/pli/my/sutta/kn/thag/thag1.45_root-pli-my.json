  "thag1.45:0.4": "45. 5. Ramaṇīyavihārittheragāthā ",
  "thag1.45:1.1": "‘‘Yathāpi bhaddo ājañño, ",
  "thag1.45:1.2": "khalitvā patitiṭṭhati; ",
  "thag1.45:1.3": "Evaṃ dassanasampannaṃ, ",
  "thag1.45:1.4": "sammāsambuddhasāvaka’’nti. … ",
  "thag1.45:1.5": "Ramaṇīyavihāritthero…. "
}
