{
  "thag13.1:0.1": "",
  "thag13.1:0.2": "13. Terasanipāto ",
  "thag13.1:0.3": "",
  "thag13.1:0.4": "1. Soṇakoḷivisattheragāthā 632. ",
  "thag13.1:1.1": "‘‘Yāhu raṭṭhe samukkaṭṭho, ",
  "thag13.1:1.2": "rañño aṅgassa paddhagū ; ",
  "thag13.1:1.3": "Svājja dhammesu ukkaṭṭho, ",
  "thag13.1:1.4": "soṇo dukkhassa pāragū. ",
  "thag13.1:2.1": "633. ‘‘Pañca chinde pañca jahe, ",
  "thag13.1:2.2": "pañca cuttari bhāvaye; ",
  "thag13.1:2.3": "Pañcasaṅgātigo bhikkhu, ",
  "thag13.1:2.4": "oghatiṇṇoti vuccati. ",
  "thag13.1:3.1": "634. ‘‘Unnaḷassa pamattassa, ",
  "thag13.1:3.2": "bāhirāsassa bhikkhuno; ",
  "thag13.1:3.3": "Sīlaṃ samādhi paññā ca, ",
  "thag13.1:3.4": "pāripūriṃ na gacchati. ",
  "thag13.1:4.1": "635. ‘‘Yañhi kiccaṃ apaviddhaṃ , ",
  "thag13.1:4.2": "akiccaṃ pana karīyati; ",
  "thag13.1:4.3": "Unnaḷānaṃ pamattānaṃ, ",
  "thag13.1:4.4": "tesaṃ vaḍḍhanti āsavā. ",
  "thag13.1:5.1": "636. ‘‘Yesañca susamāraddhā, ",
  "thag13.1:5.2": "niccaṃ kāyagatā sati; ",
  "thag13.1:5.3": "Akiccaṃ te na sevanti, ",
  "thag13.1:5.4": "kicce sātaccakārino; ",
  "thag13.1:5.5": "Satānaṃ sampajānānaṃ, ",
  "thag13.1:5.6": "atthaṃ gacchanti āsavā. ",
  "thag13.1:6.1": "637. ‘‘Ujumaggamhi akkhāte, ",
  "thag13.1:6.2": "gacchatha mā nivattatha; ",
  "thag13.1:6.3": "Attanā codayattānaṃ, ",
  "thag13.1:6.4": "nibbānamabhihāraye. ",
  "thag13.1:7.1": "638. ‘‘Accāraddhamhi vīriyamhi, ",
  "thag13.1:7.2": "satthā loke anuttaro; ",
  "thag13.1:7.3": "Vīṇopamaṃ karitvā me, ",
  "thag13.1:7.4": "dhammaṃ desesi cakkhumā; ",
  "thag13.1:7.5": "Tassāhaṃ vacanaṃ sutvā, ",
  "thag13.1:7.6": "vihāsiṃ sāsane rato. ",
  "thag13.1:8.1": "639. ‘‘Samathaṃ paṭipādesiṃ, ",
  "thag13.1:8.2": "uttamatthassa pattiyā; ",
  "thag13.1:8.3": "Tisso vijjā anuppattā, ",
  "thag13.1:8.4": "kataṃ buddhassa sāsanaṃ. ",
  "thag13.1:9.1": "640. ‘‘Nekkhamme adhimuttassa, ",
  "thag13.1:9.2": "pavivekañca cetaso; ",
  "thag13.1:9.3": "Abyāpajjhādhimuttassa , ",
  "thag13.1:9.4": "upādānakkhayassa ca. ",
  "thag13.1:10.1": "641. ‘‘Taṇhakkhayādhimuttassa, ",
  "thag13.1:10.2": "asammohañca cetaso; ",
  "thag13.1:10.3": "Disvā āyatanuppādaṃ, ",
  "thag13.1:10.4": "sammā cittaṃ vimuccati. ",
  "thag13.1:11.1": "642. ‘‘Tassa sammā vimuttassa, ",
  "thag13.1:11.2": "santacittassa bhikkhuno; ",
  "thag13.1:11.3": "Katassa paṭicayo natthi, ",
  "thag13.1:11.4": "karaṇīyaṃ na vijjati. ",
  "thag13.1:12.1": "643. ‘‘Selo yathā ekaghano , ",
  "thag13.1:12.2": "vātena na samīrati; ",
  "thag13.1:12.3": "Evaṃ rūpā rasā saddā, ",
  "thag13.1:12.4": "gandhā phassā ca kevalā. ",
  "thag13.1:13.1": "644. ‘‘Iṭṭhā dhammā aniṭṭhā ca, ",
  "thag13.1:13.2": "nappavedhenti tādino; ",
  "thag13.1:13.3": "Ṭhitaṃ cittaṃ visaññuttaṃ, ",
  "thag13.1:13.4": "vayañcassānupassatī’’ti. … ",
  "thag13.1:13.5": "Soṇo koḷiviso thero…. ",
  "thag13.1:13.6": "Terasanipāto niṭṭhito. ",
  "thag13.1:14.0": "Tatruddānaṃ – ",
  "thag13.1:14.1": "Soṇo koḷiviso thero, ",
  "thag13.1:14.2": "ekoyeva mahiddhiko; ",
  "thag13.1:14.3": "Terasamhi nipātamhi, ",
  "thag13.1:14.4": "gāthāyo cettha terasāti. "
}
