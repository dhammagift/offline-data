  "thag1.28:0.4": "28. 8. Jambugāmikaputtattheragāthā ",
  "thag1.28:1.1": "‘‘Kacci no vatthapasuto, ",
  "thag1.28:1.2": "kacci no bhūsanārato; ",
  "thag1.28:1.3": "Kacci sīlamayaṃ gandhaṃ, ",
  "thag1.28:1.4": "kiṃ tvaṃ vāyasi netarā pajā’’ti. … ",
  "thag1.28:1.5": "Jambugāmikaputto thero…. "
}
