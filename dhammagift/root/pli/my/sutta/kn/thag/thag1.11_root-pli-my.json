  "thag1.11:0.3": "2. Dutiyavaggo ",
  "thag1.11:0.4": "11. 1. Cūḷavacchattheragāthā ",
  "thag1.11:1.1": "‘‘Pāmojjabahulo bhikkhu, ",
  "thag1.11:1.2": "dhamme buddhappavedite; ",
  "thag1.11:1.3": "Adhigacche padaṃ santaṃ, ",
  "thag1.11:1.4": "saṅkhārūpasamaṃ sukha’’nti. … ",
  "thag1.11:1.5": "Cūḷavaccho thero…. "
}
