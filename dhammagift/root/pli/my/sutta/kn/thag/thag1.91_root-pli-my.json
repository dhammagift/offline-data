  "thag1.91:0.3": "10. Dasamavaggo ",
  "thag1.91:0.4": "91. 1. Paripuṇṇakattheragāthā ",
  "thag1.91:1.1": "‘‘Na tathā mataṃ satarasaṃ, ",
  "thag1.91:1.2": "sudhannaṃ yaṃ mayajja paribhuttaṃ; ",
  "thag1.91:1.3": "Aparimitadassinā gotamena, ",
  "thag1.91:1.4": "buddhena desito dhammo’’ti. … ",
  "thag1.91:1.5": "Paripuṇṇako thero…. "
}
