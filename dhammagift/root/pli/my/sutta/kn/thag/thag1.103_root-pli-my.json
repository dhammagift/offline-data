  "thag1.103:0.4": "3. Bandhurattheragāthā 103. ",
  "thag1.103:1.1": "‘‘Nāhaṃ etena atthiko, ",
  "thag1.103:1.2": "sukhito dhammarasena tappito; ",
  "thag1.103:1.3": "Pitvā rasaggamuttamaṃ, ",
  "thag1.103:1.4": "na ca kāhāmi visena santhava’’nti. … ",
  "thag1.103:1.5": "Bandhuro thero…. "
}
