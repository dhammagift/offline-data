  "thag1.101:0.3": "11. Ekādasamavaggo ",
  "thag1.101:0.4": "1. Belaṭṭhānikattheragāthā 101. ",
  "thag1.101:1.1": "‘‘Hitvā gihittaṃ anavositatto, ",
  "thag1.101:1.2": "mukhanaṅgalī odariko kusīto; ",
  "thag1.101:1.3": "Mahāvarāhova nivāpapuṭṭho, ",
  "thag1.101:1.4": "punappunaṃ gabbhamupeti mando’’ti. … ",
  "thag1.101:1.5": "Belaṭṭhāniko thero…. "
}
