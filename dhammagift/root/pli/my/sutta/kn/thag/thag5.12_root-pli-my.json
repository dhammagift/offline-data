  "thag5.12:0.3": "",
  "thag5.12:0.4": "12. Kosiyattheragāthā 370. ",
  "thag5.12:1.1": "‘‘Yo ve garūnaṃ vacanaññu dhīro, ",
  "thag5.12:1.2": "vase ca tamhi janayetha pemaṃ; ",
  "thag5.12:1.3": "So bhattimā nāma ca hoti paṇḍito, ",
  "thag5.12:1.4": "ñatvā ca dhammesu visesi assa. ",
  "thag5.12:2.1": "371. ‘‘Yaṃ āpadā uppatitā uḷārā, ",
  "thag5.12:2.2": "nakkhambhayante paṭisaṅkhayantaṃ; ",
  "thag5.12:2.3": "So thāmavā nāma ca hoti paṇḍito, ",
  "thag5.12:2.4": "ñatvā ca dhammesu visesi assa. ",
  "thag5.12:3.1": "372. ‘‘Yo ve samuddova ṭhito anejo, ",
  "thag5.12:3.2": "gambhīrapañño nipuṇatthadassī; ",
  "thag5.12:3.3": "Asaṃhāriyo nāma ca hoti paṇḍito, ",
  "thag5.12:3.4": "ñatvā ca dhammesu visesi assa. ",
  "thag5.12:4.1": "373. ‘‘Bahussuto dhammadharo ca hoti, ",
  "thag5.12:4.2": "dhammassa hoti anudhammacārī; ",
  "thag5.12:4.3": "So tādiso nāma ca hoti paṇḍito, ",
  "thag5.12:4.4": "ñatvā ca dhammesu visesi assa. ",
  "thag5.12:5.1": "374. ‘‘Atthañca yo jānāti bhāsitassa, ",
  "thag5.12:5.2": "atthañca ñatvāna tathā karoti; ",
  "thag5.12:5.3": "Atthantaro nāma sa hoti paṇḍito, ",
  "thag5.12:5.4": "ñatvā ca dhammesu visesi assā’’ti. … ",
  "thag5.12:5.5": "Kosiyo thero…. ",
  "thag5.12:5.6": "Pañcakanipāto niṭṭhito. ",
  "thag5.12:6.0": "Tatruddānaṃ – ",
  "thag5.12:6.1": "Rājadatto subhūto ca, ",
  "thag5.12:6.2": "girimānandasumanā; ",
  "thag5.12:6.3": "Vaḍḍho ca kassapo thero, ",
  "thag5.12:6.4": "gayākassapavakkalī. ",
  "thag5.12:7.1": "Vijito yasadatto ca, ",
  "thag5.12:7.2": "soṇo kosiyasavhayo; ",
  "thag5.12:7.3": "Saṭṭhi ca pañca gāthāyo, ",
  "thag5.12:7.4": "therā ca ettha dvādasāti. "
}
