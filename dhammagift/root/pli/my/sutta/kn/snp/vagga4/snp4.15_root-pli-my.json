{
  "snp4.15:0.1": "",
  "snp4.15:0.2": "15. Attadaṇḍasuttaṃ 941. ",
  "snp4.15:1.1": "‘‘Attadaṇḍā bhayaṃ jātaṃ, ",
  "snp4.15:1.2": "janaṃ passatha medhagaṃ; ",
  "snp4.15:1.3": "Saṃvegaṃ kittayissāmi, ",
  "snp4.15:1.4": "yathā saṃvijitaṃ mayā. ",
  "snp4.15:2.1": "942. ‘‘Phandamānaṃ pajaṃ disvā, ",
  "snp4.15:2.2": "macche appodake yathā; ",
  "snp4.15:2.3": "Aññamaññehi byāruddhe, ",
  "snp4.15:2.4": "disvā maṃ bhayamāvisi. ",
  "snp4.15:3.1": "943. ‘‘Samantamasāro loko, ",
  "snp4.15:3.2": "disā sabbā sameritā; ",
  "snp4.15:3.3": "Icchaṃ bhavanamattano, ",
  "snp4.15:3.4": "nāddasāsiṃ anositaṃ. ",
  "snp4.15:4.1": "944. ‘‘Osānetveva byāruddhe, ",
  "snp4.15:4.2": "disvā me aratī ahu; ",
  "snp4.15:4.3": "Athettha sallamaddakkhiṃ, ",
  "snp4.15:4.4": "duddasaṃ hadayanissitaṃ. ",
  "snp4.15:5.1": "945. ‘‘Yena sallena otiṇṇo, ",
  "snp4.15:5.2": "disā sabbā vidhāvati; ",
  "snp4.15:5.3": "Tameva sallamabbuyha, ",
  "snp4.15:5.4": "na dhāvati na sīdati. ",
  "snp4.15:6.1": "946. ‘‘Tattha sikkhānugīyanti , ",
  "snp4.15:6.2": "yāni loke gadhitāni; ",
  "snp4.15:6.3": "Na tesu pasuto siyā, ",
  "snp4.15:6.4": "nibbijjha sabbaso kāme; ",
  "snp4.15:6.5": "Sikkhe nibbānamattano. ",
  "snp4.15:7.1": "947. ‘‘Sacco siyā appagabbho, ",
  "snp4.15:7.2": "amāyo rittapesuṇo; ",
  "snp4.15:7.3": "Akkodhano lobhapāpaṃ, ",
  "snp4.15:7.4": "vevicchaṃ vitare muni. ",
  "snp4.15:8.1": "948. ‘‘Niddaṃ tandiṃ sahe thīnaṃ, ",
  "snp4.15:8.2": "pamādena na saṃvase; ",
  "snp4.15:8.3": "Atimāne na tiṭṭheyya, ",
  "snp4.15:8.4": "nibbānamanaso naro. ",
  "snp4.15:9.1": "949. ‘‘Mosavajje na nīyetha, ",
  "snp4.15:9.2": "rūpe snehaṃ na kubbaye; ",
  "snp4.15:9.3": "Mānañca parijāneyya, ",
  "snp4.15:9.4": "sāhasā virato care. ",
  "snp4.15:10.1": "950. ‘‘Purāṇaṃ nābhinandeyya, ",
  "snp4.15:10.2": "nave khantiṃ na kubbaye; ",
  "snp4.15:10.3": "Hiyyamāne na soceyya, ",
  "snp4.15:10.4": "ākāsaṃ na sito siyā. ",
  "snp4.15:11.1": "951. ‘‘Gedhaṃ brūmi mahoghoti, ",
  "snp4.15:11.2": "ājavaṃ brūmi jappanaṃ; ",
  "snp4.15:11.3": "Ārammaṇaṃ pakappanaṃ, ",
  "snp4.15:11.4": "kāmapaṅko duraccayo. ",
  "snp4.15:12.1": "952. ‘‘Saccā avokkamma muni, ",
  "snp4.15:12.2": "thale tiṭṭhati brāhmaṇo; ",
  "snp4.15:12.3": "Sabbaṃ so paṭinissajja, ",
  "snp4.15:12.4": "sa ve santoti vuccati. ",
  "snp4.15:13.1": "953. ‘‘Sa ve vidvā sa vedagū, ",
  "snp4.15:13.2": "ñatvā dhammaṃ anissito; ",
  "snp4.15:13.3": "Sammā so loke iriyāno, ",
  "snp4.15:13.4": "na pihetīdha kassaci. ",
  "snp4.15:14.1": "954. ‘‘Yodha kāme accatari, ",
  "snp4.15:14.2": "saṅgaṃ loke duraccayaṃ; ",
  "snp4.15:14.3": "Na so socati nājjheti, ",
  "snp4.15:14.4": "chinnasoto abandhano. ",
  "snp4.15:15.1": "955. ‘‘Yaṃ pubbe taṃ visosehi, ",
  "snp4.15:15.2": "pacchā te māhu kiñcanaṃ; ",
  "snp4.15:15.3": "Majjhe ce no gahessasi, ",
  "snp4.15:15.4": "upasanto carissasi. ",
  "snp4.15:16.1": "956. ‘‘Sabbaso nāmarūpasmiṃ, ",
  "snp4.15:16.2": "yassa natthi mamāyitaṃ; ",
  "snp4.15:16.3": "Asatā ca na socati, ",
  "snp4.15:16.4": "sa ve loke na jīyati. ",
  "snp4.15:17.1": "957. ‘‘Yassa natthi idaṃ meti, ",
  "snp4.15:17.2": "paresaṃ vāpi kiñcanaṃ; ",
  "snp4.15:17.3": "Mamattaṃ so asaṃvindaṃ, ",
  "snp4.15:17.4": "natthi meti na socati. ",
  "snp4.15:18.1": "958. ‘‘Aniṭṭhurī ananugiddho, ",
  "snp4.15:18.2": "anejo sabbadhī samo; ",
  "snp4.15:18.3": "Tamānisaṃsaṃ pabrūmi, ",
  "snp4.15:18.4": "pucchito avikampinaṃ. ",
  "snp4.15:19.1": "959. ‘‘Anejassa vijānato, ",
  "snp4.15:19.2": "natthi kāci nisaṅkhati . ",
  "snp4.15:19.3": "Virato so viyārabbhā, ",
  "snp4.15:19.4": "khemaṃ passati sabbadhi. ",
  "snp4.15:20.1": "960. ‘‘Na samesu na omesu, ",
  "snp4.15:20.2": "na ussesu vadate muni; ",
  "snp4.15:20.3": "Santo so vītamaccharo, ",
  "snp4.15:20.4": "nādeti na nirassatī’’ti. ",
  "snp4.15:20.5": "Attadaṇḍasuttaṃ pannarasamaṃ niṭṭhitaṃ. "
}
