{
  "snp4.9:0.1": "",
  "snp4.9:0.2": "841. 9. Māgaṇḍiyasuttaṃ ",
  "snp4.9:1.1": "‘‘Disvāna taṇhaṃ aratiṃ ragañca , ",
  "snp4.9:1.2": "nāhosi chando api methunasmiṃ; ",
  "snp4.9:1.3": "Kimevidaṃ muttakarīsapuṇṇaṃ, ",
  "snp4.9:1.4": "pādāpi naṃ samphusituṃ na icche’’. ",
  "snp4.9:2.1": "842. ‘‘Etādisaṃ ce ratanaṃ na icchasi, ",
  "snp4.9:2.2": "nāriṃ narindehi bahūhi patthitaṃ; ",
  "snp4.9:2.3": "Diṭṭhigataṃ sīlavataṃ nu jīvitaṃ , ",
  "snp4.9:2.4": "bhavūpapattiñca vadesi kīdisaṃ’’. ",
  "snp4.9:3.1": "843. ‘‘Idaṃ vadāmīti na tassa hoti, ",
  "snp4.9:3.2": "(māgaṇḍiyāti bhagavā) ",
  "snp4.9:3.3": "Dhammesu niccheyya samuggahītaṃ; ",
  "snp4.9:3.4": "Passañca diṭṭhīsu anuggahāya, ",
  "snp4.9:3.5": "Ajjhattasantiṃ pacinaṃ adassaṃ’’. ",
  "snp4.9:4.1": "844. ‘‘Vinicchayā yāni pakappitāni, ",
  "snp4.9:4.2": "(iti māgaṇḍiyo ) ",
  "snp4.9:4.3": "Te ve munī brūsi anuggahāya; ",
  "snp4.9:4.4": "Ajjhattasantīti yametamatthaṃ, ",
  "snp4.9:4.5": "Kathaṃ nu dhīrehi paveditaṃ taṃ’’. ",
  "snp4.9:5.1": "845. ‘‘Na diṭṭhiyā na sutiyā na ñāṇena, ",
  "snp4.9:5.2": "(māgaṇḍiyāti bhagavā) ",
  "snp4.9:5.3": "Sīlabbatenāpi na suddhimāha; ",
  "snp4.9:5.4": "Adiṭṭhiyā assutiyā añāṇā, ",
  "snp4.9:5.5": "Asīlatā abbatā nopi tena; ",
  "snp4.9:5.6": "Ete ca nissajja anuggahāya, ",
  "snp4.9:5.7": "Santo anissāya bhavaṃ na jappe’’. ",
  "snp4.9:6.1": "846. ‘‘No ce kira diṭṭhiyā na sutiyā na ñāṇena, ",
  "snp4.9:6.2": "(iti māgaṇḍiyo) ",
  "snp4.9:6.3": "Sīlabbatenāpi na suddhimāha; ",
  "snp4.9:6.4": "Adiṭṭhiyā assutiyā añāṇā, ",
  "snp4.9:6.5": "Asīlatā abbatā nopi tena; ",
  "snp4.9:6.6": "Maññāmahaṃ momuhameva dhammaṃ, ",
  "snp4.9:6.7": "Diṭṭhiyā eke paccenti suddhiṃ’’. ",
  "snp4.9:7.1": "847. ‘‘Diṭṭhañca nissāya anupucchamāno, ",
  "snp4.9:7.2": "(māgaṇḍiyāti bhagavā) ",
  "snp4.9:7.3": "Samuggahītesu pamohamāgā ; ",
  "snp4.9:7.4": "Ito ca nāddakkhi aṇumpi saññaṃ, ",
  "snp4.9:7.5": "Tasmā tuvaṃ momuhato dahāsi. ",
  "snp4.9:8.1": "848. ‘‘Samo visesī uda vā nihīno, ",
  "snp4.9:8.2": "yo maññatī so vivadetha tena; ",
  "snp4.9:8.3": "Tīsu vidhāsu avikampamāno, ",
  "snp4.9:8.4": "samo visesīti na tassa hoti. ",
  "snp4.9:9.1": "849. ‘‘Saccanti so brāhmaṇo kiṃ vadeyya, ",
  "snp4.9:9.2": "musāti vā so vivadetha kena; ",
  "snp4.9:9.3": "Yasmiṃ samaṃ visamaṃ vāpi natthi, ",
  "snp4.9:9.4": "sa kena vādaṃ paṭisaṃyujeyya. ",
  "snp4.9:10.1": "850. ‘‘Okaṃ pahāya aniketasārī, ",
  "snp4.9:10.2": "gāme akubbaṃ muni santhavāni ; ",
  "snp4.9:10.3": "Kāmehi ritto apurekkharāno, ",
  "snp4.9:10.4": "kathaṃ na viggayha janena kayirā. ",
  "snp4.9:11.1": "851. ‘‘Yehi vivitto vicareyya loke, ",
  "snp4.9:11.2": "na tāni uggayha vadeyya nāgo; ",
  "snp4.9:11.3": "Jalambujaṃ kaṇḍakaṃ vārijaṃ yathā, ",
  "snp4.9:11.4": "jalena paṅkena canūpalittaṃ; ",
  "snp4.9:11.5": "Evaṃ munī santivādo agiddho, ",
  "snp4.9:11.6": "kāme ca loke ca anūpalitto. ",
  "snp4.9:12.1": "852. ‘‘Na vedagū diṭṭhiyāyako na mutiyā, ",
  "snp4.9:12.2": "sa mānameti na hi tammayo so; ",
  "snp4.9:12.3": "Na kammunā nopi sutena neyyo, ",
  "snp4.9:12.4": "anūpanīto sa nivesanesu. ",
  "snp4.9:13.1": "853. ‘‘Saññāvirattassa na santi ganthā, ",
  "snp4.9:13.2": "paññāvimuttassa na santi mohā; ",
  "snp4.9:13.3": "Saññañca diṭṭhiñca ye aggahesuṃ, ",
  "snp4.9:13.4": "te ghaṭṭayantā vicaranti loke’’ti. ",
  "snp4.9:13.5": "Māgaṇḍiyasuttaṃ navamaṃ niṭṭhitaṃ. "
}
