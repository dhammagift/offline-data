{
  "snp4.5:0.1": "",
  "snp4.5:0.2": "802. 5. Paramaṭṭhakasuttaṃ ",
  "snp4.5:1.1": "Paramanti diṭṭhīsu paribbasāno, ",
  "snp4.5:1.2": "yaduttari kurute jantu loke; ",
  "snp4.5:1.3": "Hīnāti aññe tato sabbamāha, ",
  "snp4.5:1.4": "tasmā vivādāni avītivatto. ",
  "snp4.5:2.1": "803. Yadattanī passati ānisaṃsaṃ, ",
  "snp4.5:2.2": "diṭṭhe sute sīlavate mute vā; ",
  "snp4.5:2.3": "Tadeva so tattha samuggahāya, ",
  "snp4.5:2.4": "nihīnato passati sabbamaññaṃ. ",
  "snp4.5:3.1": "804. Taṃ vāpi ganthaṃ kusalā vadanti, ",
  "snp4.5:3.2": "yaṃ nissito passati hīnamaññaṃ; ",
  "snp4.5:3.3": "Tasmā hi diṭṭhaṃ va sutaṃ mutaṃ vā, ",
  "snp4.5:3.4": "sīlabbataṃ bhikkhu na nissayeyya. ",
  "snp4.5:4.1": "805. Diṭṭhimpi lokasmiṃ na kappayeyya, ",
  "snp4.5:4.2": "ñāṇena vā sīlavatena vāpi; ",
  "snp4.5:4.3": "Samoti attānamanūpaneyya, ",
  "snp4.5:4.4": "hīno na maññetha visesi vāpi. ",
  "snp4.5:5.1": "806. Attaṃ pahāya anupādiyāno, ",
  "snp4.5:5.2": "ñāṇepi so nissayaṃ no karoti; ",
  "snp4.5:5.3": "Sa ve viyattesu na vaggasārī, ",
  "snp4.5:5.4": "diṭṭhimpi so na pacceti kiñci. ",
  "snp4.5:6.1": "807. Yassūbhayante paṇidhīdha natthi, ",
  "snp4.5:6.2": "bhavābhavāya idha vā huraṃ vā; ",
  "snp4.5:6.3": "Nivesanā tassa na santi keci, ",
  "snp4.5:6.4": "dhammesu niccheyya samuggahītaṃ. ",
  "snp4.5:7.1": "808. Tassīdha diṭṭhe va sute mute vā, ",
  "snp4.5:7.2": "pakappitā natthi aṇūpi saññā; ",
  "snp4.5:7.3": "Taṃ brāhmaṇaṃ diṭṭhimanādiyānaṃ, ",
  "snp4.5:7.4": "kenīdha lokasmiṃ vikappayeyya. ",
  "snp4.5:8.1": "809. Na kappayanti na purekkharonti, ",
  "snp4.5:8.2": "dhammāpi tesaṃ na paṭicchitāse; ",
  "snp4.5:8.3": "Na brāhmaṇo sīlavatena neyyo, ",
  "snp4.5:8.4": "pāraṅgato na pacceti tādīti. ",
  "snp4.5:8.5": "Paramaṭṭhakasuttaṃ pañcamaṃ niṭṭhitaṃ. "
}
