{
  "snp4.11:0.1": "",
  "snp4.11:0.2": "868. 11. Kalahavivādasuttaṃ ",
  "snp4.11:1.1": "‘‘Kutopahūtā kalahā vivādā, ",
  "snp4.11:1.2": "paridevasokā sahamaccharā ca; ",
  "snp4.11:1.3": "Mānātimānā sahapesuṇā ca, ",
  "snp4.11:1.4": "kutopahūtā te tadiṅgha brūhi’’. ",
  "snp4.11:2.1": "869. ‘‘Piyappahūtā kalahā vivādā, ",
  "snp4.11:2.2": "Paridevasokā sahamaccharā ca; ",
  "snp4.11:2.3": "Mānātimānā sahapesuṇā ca, ",
  "snp4.11:2.4": "Maccherayuttā kalahā vivādā; ",
  "snp4.11:2.5": "Vivādajātesu ca pesuṇāni’’. ",
  "snp4.11:3.1": "870. ‘‘Piyā su lokasmiṃ kutonidānā, ",
  "snp4.11:3.2": "ye cāpi lobhā vicaranti loke; ",
  "snp4.11:3.3": "Āsā ca niṭṭhā ca kutonidānā, ",
  "snp4.11:3.4": "ye samparāyāya narassa honti’’. ",
  "snp4.11:4.1": "871. ‘‘Chandānidānāni piyāni loke, ",
  "snp4.11:4.2": "ye cāpi lobhā vicaranti loke; ",
  "snp4.11:4.3": "Āsā ca niṭṭhā ca itonidānā, ",
  "snp4.11:4.4": "ye samparāyāya narassa honti’’. ",
  "snp4.11:5.1": "872. ‘‘Chando nu lokasmiṃ kutonidāno, ",
  "snp4.11:5.2": "vinicchayā cāpi kutopahūtā; ",
  "snp4.11:5.3": "Kodho mosavajjañca kathaṃkathā ca, ",
  "snp4.11:5.4": "ye vāpi dhammā samaṇena vuttā’’. ",
  "snp4.11:6.1": "873. ‘‘Sātaṃ asātanti yamāhu loke, ",
  "snp4.11:6.2": "tamūpanissāya pahoti chando; ",
  "snp4.11:6.3": "Rūpesu disvā vibhavaṃ bhavañca, ",
  "snp4.11:6.4": "vinicchayaṃ kubbati jantu loke. ",
  "snp4.11:7.1": "874. ‘‘Kodho mosavajjañca kathaṃkathā ca, ",
  "snp4.11:7.2": "etepi dhammā dvayameva sante; ",
  "snp4.11:7.3": "Kathaṃkathī ñāṇapathāya sikkhe, ",
  "snp4.11:7.4": "ñatvā pavuttā samaṇena dhammā’’. ",
  "snp4.11:8.1": "875. ‘‘Sātaṃ asātañca kutonidānā, ",
  "snp4.11:8.2": "kismiṃ asante na bhavanti hete; ",
  "snp4.11:8.3": "Vibhavaṃ bhavañcāpi yametamatthaṃ, ",
  "snp4.11:8.4": "etaṃ me pabrūhi yatonidānaṃ’’. ",
  "snp4.11:9.1": "876. ‘‘Phassanidānaṃ sātaṃ asātaṃ, ",
  "snp4.11:9.2": "phasse asante na bhavanti hete; ",
  "snp4.11:9.3": "Vibhavaṃ bhavañcāpi yametamatthaṃ, ",
  "snp4.11:9.4": "etaṃ te pabrūmi itonidānaṃ’’. ",
  "snp4.11:10.1": "877. ‘‘Phasso nu lokasmi kutonidāno, ",
  "snp4.11:10.2": "pariggahā cāpi kutopahūtā; ",
  "snp4.11:10.3": "Kismiṃ asante na mamattamatthi, ",
  "snp4.11:10.4": "kismiṃ vibhūte na phusanti phassā’’. ",
  "snp4.11:11.1": "878. ‘‘Nāmañca rūpañca paṭicca phasso, ",
  "snp4.11:11.2": "icchānidānāni pariggahāni; ",
  "snp4.11:11.3": "Icchāyasantyā na mamattamatthi, ",
  "snp4.11:11.4": "rūpe vibhūte na phusanti phassā’’. ",
  "snp4.11:12.1": "879. ‘‘Kathaṃsametassa vibhoti rūpaṃ, ",
  "snp4.11:12.2": "sukhaṃ dukhañcāpi kathaṃ vibhoti; ",
  "snp4.11:12.3": "Etaṃ me pabrūhi yathā vibhoti, ",
  "snp4.11:12.4": "taṃ jāniyāmāti me mano ahu’’. ",
  "snp4.11:13.1": "880. ‘‘Na saññasaññī na visaññasaññī, ",
  "snp4.11:13.2": "nopi asaññī na vibhūtasaññī; ",
  "snp4.11:13.3": "Evaṃsametassa vibhoti rūpaṃ, ",
  "snp4.11:13.4": "saññānidānā hi papañcasaṅkhā’’. ",
  "snp4.11:14.1": "881. ‘‘Yaṃ taṃ apucchimha akittayī no, ",
  "snp4.11:14.2": "Aññaṃ taṃ pucchāma tadiṅgha brūhi; ",
  "snp4.11:14.3": "Ettāvataggaṃ nu vadanti heke, ",
  "snp4.11:14.4": "Yakkhassa suddhiṃ idha paṇḍitāse; ",
  "snp4.11:14.5": "Udāhu aññampi vadanti etto. ",
  "snp4.11:15.1": "882. ‘‘Ettāvataggampi vadanti heke, ",
  "snp4.11:15.2": "yakkhassa suddhiṃ idha paṇḍitāse; ",
  "snp4.11:15.3": "Tesaṃ paneke samayaṃ vadanti, ",
  "snp4.11:15.4": "anupādisese kusalā vadānā. ",
  "snp4.11:16.1": "883. ‘‘Ete ca ñatvā upanissitāti, ",
  "snp4.11:16.2": "ñatvā munī nissaye so vimaṃsī; ",
  "snp4.11:16.3": "Ñatvā vimutto na vivādameti, ",
  "snp4.11:16.4": "bhavābhavāya na sameti dhīro’’ti. ",
  "snp4.11:16.5": "Kalahavivādasuttaṃ ekādasamaṃ niṭṭhitaṃ. "
}
