{
  "snp1.3:0.1": "",
  "snp1.3:0.2": "3. Khaggavisāṇasuttaṃ 35. ",
  "snp1.3:1.1": "Sabbesu bhūtesu nidhāya daṇḍaṃ, ",
  "snp1.3:1.2": "aviheṭhayaṃ aññatarampi tesaṃ; ",
  "snp1.3:1.3": "Na puttamiccheyya kuto sahāyaṃ, ",
  "snp1.3:1.4": "eko care khaggavisāṇakappo. ",
  "snp1.3:2.1": "36. Saṃsaggajātassa bhavanti snehā, ",
  "snp1.3:2.2": "snehanvayaṃ dukkhamidaṃ pahoti; ",
  "snp1.3:2.3": "Ādīnavaṃ snehajaṃ pekkhamāno, ",
  "snp1.3:2.4": "eko care khaggavisāṇakappo. ",
  "snp1.3:3.1": "37. Mitte suhajje anukampamāno, ",
  "snp1.3:3.2": "hāpeti atthaṃ paṭibaddhacitto; ",
  "snp1.3:3.3": "Etaṃ bhayaṃ santhave pekkhamāno, ",
  "snp1.3:3.4": "eko care khaggavisāṇakappo. ",
  "snp1.3:4.1": "38. Vaṃso visālova yathā visatto, ",
  "snp1.3:4.2": "puttesu dāresu ca yā apekkhā; ",
  "snp1.3:4.3": "Vaṃsakkaḷīrova asajjamāno, ",
  "snp1.3:4.4": "eko care khaggavisāṇakappo. ",
  "snp1.3:5.1": "39. Migo araññamhi yathā abaddho , ",
  "snp1.3:5.2": "yenicchakaṃ gacchati gocarāya; ",
  "snp1.3:5.3": "Viññū naro seritaṃ pekkhamāno, ",
  "snp1.3:5.4": "eko care khaggavisāṇakappo. ",
  "snp1.3:6.1": "40. Āmantanā hoti sahāyamajjhe, ",
  "snp1.3:6.2": "vāse ṭhāne gamane cārikāya; ",
  "snp1.3:6.3": "Anabhijjhitaṃ seritaṃ pekkhamāno, ",
  "snp1.3:6.4": "eko care khaggavisāṇakappo. ",
  "snp1.3:7.1": "41. Khiḍḍā ratī hoti sahāyamajjhe, ",
  "snp1.3:7.2": "puttesu ca vipulaṃ hoti pemaṃ; ",
  "snp1.3:7.3": "Piyavippayogaṃ vijigucchamāno, ",
  "snp1.3:7.4": "eko care khaggavisāṇakappo. ",
  "snp1.3:8.1": "42. Cātuddiso appaṭigho ca hoti, ",
  "snp1.3:8.2": "santussamāno itarītarena; ",
  "snp1.3:8.3": "Parissayānaṃ sahitā achambhī, ",
  "snp1.3:8.4": "eko care khaggavisāṇakappo. ",
  "snp1.3:9.1": "43. Dussaṅgahā pabbajitāpi eke, ",
  "snp1.3:9.2": "atho gahaṭṭhā gharamāvasantā; ",
  "snp1.3:9.3": "Appossukko paraputtesu hutvā, ",
  "snp1.3:9.4": "eko care khaggavisāṇakappo. ",
  "snp1.3:10.1": "44. Oropayitvā gihibyañjanāni , ",
  "snp1.3:10.2": "sañchinnapatto yathā koviḷāro; ",
  "snp1.3:10.3": "Chetvāna vīro gihibandhanāni, ",
  "snp1.3:10.4": "eko care khaggavisāṇakappo. ",
  "snp1.3:11.1": "45. Sace labhetha nipakaṃ sahāyaṃ, ",
  "snp1.3:11.2": "saddhiṃ caraṃ sādhuvihāridhīraṃ; ",
  "snp1.3:11.3": "Abhibhuyya sabbāni parissayāni, ",
  "snp1.3:11.4": "careyya tenattamano satīmā. ",
  "snp1.3:12.1": "46. No ce labhetha nipakaṃ sahāyaṃ, ",
  "snp1.3:12.2": "saddhiṃ caraṃ sādhuvihāridhīraṃ; ",
  "snp1.3:12.3": "Rājāva raṭṭhaṃ vijitaṃ pahāya, ",
  "snp1.3:12.4": "eko care mātaṅgaraññeva nāgo. ",
  "snp1.3:13.1": "47. Addhā pasaṃsāma sahāyasampadaṃ, ",
  "snp1.3:13.2": "seṭṭhā samā sevitabbā sahāyā; ",
  "snp1.3:13.3": "Ete aladdhā anavajjabhojī, ",
  "snp1.3:13.4": "eko care khaggavisāṇakappo. ",
  "snp1.3:14.1": "48. Disvā suvaṇṇassa pabhassarāni, ",
  "snp1.3:14.2": "kammāraputtena suniṭṭhitāni; ",
  "snp1.3:14.3": "Saṅghaṭṭamānāni duve bhujasmiṃ, ",
  "snp1.3:14.4": "eko care khaggavisāṇakappo. ",
  "snp1.3:15.1": "49. Evaṃ dutiyena sahā mamassa, ",
  "snp1.3:15.2": "vācābhilāpo abhisajjanā vā; ",
  "snp1.3:15.3": "Etaṃ bhayaṃ āyatiṃ pekkhamāno, ",
  "snp1.3:15.4": "eko care khaggavisāṇakappo. ",
  "snp1.3:16.1": "50. Kāmā hi citrā madhurā manoramā, ",
  "snp1.3:16.2": "virūparūpena mathenti cittaṃ; ",
  "snp1.3:16.3": "Ādīnavaṃ kāmaguṇesu disvā, ",
  "snp1.3:16.4": "eko care khaggavisāṇakappo. ",
  "snp1.3:17.1": "51. Ītī ca gaṇḍo ca upaddavo ca, ",
  "snp1.3:17.2": "rogo ca sallañca bhayañca metaṃ; ",
  "snp1.3:17.3": "Etaṃ bhayaṃ kāmaguṇesu disvā, ",
  "snp1.3:17.4": "eko care khaggavisāṇakappo. ",
  "snp1.3:18.1": "52. Sītañca uṇhañca khudaṃ pipāsaṃ, ",
  "snp1.3:18.2": "vātātape ḍaṃsasarīsape ca; ",
  "snp1.3:18.3": "Sabbānipetāni abhisambhavitvā, ",
  "snp1.3:18.4": "eko care khaggavisāṇakappo. ",
  "snp1.3:19.1": "53. Nāgova yūthāni vivajjayitvā, ",
  "snp1.3:19.2": "sañjātakhandho padumī uḷāro; ",
  "snp1.3:19.3": "Yathābhirantaṃ viharaṃ araññe, ",
  "snp1.3:19.4": "eko care khaggavisāṇakappo. ",
  "snp1.3:20.1": "54. Aṭṭhānataṃ saṅgaṇikāratassa, ",
  "snp1.3:20.2": "yaṃ phassaye sāmayikaṃ vimuttiṃ; ",
  "snp1.3:20.3": "Ādiccabandhussa vaco nisamma, ",
  "snp1.3:20.4": "eko care khaggavisāṇakappo. ",
  "snp1.3:21.1": "55. Diṭṭhīvisūkāni upātivatto, ",
  "snp1.3:21.2": "patto niyāmaṃ paṭiladdhamaggo; ",
  "snp1.3:21.3": "Uppannañāṇomhi anaññaneyyo, ",
  "snp1.3:21.4": "eko care khaggavisāṇakappo. ",
  "snp1.3:22.1": "56. Nillolupo nikkuho nippipāso, ",
  "snp1.3:22.2": "nimmakkho niddhantakasāvamoho; ",
  "snp1.3:22.3": "Nirāsayo sabbaloke bhavitvā, ",
  "snp1.3:22.4": "eko care khaggavisāṇakappo. ",
  "snp1.3:23.1": "57. Pāpaṃ sahāyaṃ parivajjayetha, ",
  "snp1.3:23.2": "anatthadassiṃ visame niviṭṭhaṃ; ",
  "snp1.3:23.3": "Sayaṃ na seve pasutaṃ pamattaṃ, ",
  "snp1.3:23.4": "eko care khaggavisāṇakappo. ",
  "snp1.3:24.1": "58. Bahussutaṃ dhammadharaṃ bhajetha, ",
  "snp1.3:24.2": "mittaṃ uḷāraṃ paṭibhānavantaṃ; ",
  "snp1.3:24.3": "Aññāya atthāni vineyya kaṅkhaṃ, ",
  "snp1.3:24.4": "eko care khaggavisāṇakappo. ",
  "snp1.3:25.1": "59. Khiḍḍaṃ ratiṃ kāmasukhañca loke, ",
  "snp1.3:25.2": "analaṅkaritvā anapekkhamāno; ",
  "snp1.3:25.3": "Vibhūsanaṭṭhānā virato saccavādī, ",
  "snp1.3:25.4": "eko care khaggavisāṇakappo. ",
  "snp1.3:26.1": "60. Puttañca dāraṃ pitarañca mātaraṃ, ",
  "snp1.3:26.2": "dhanāni dhaññāni ca bandhavāni ; ",
  "snp1.3:26.3": "Hitvāna kāmāni yathodhikāni, ",
  "snp1.3:26.4": "eko care khaggavisāṇakappo. ",
  "snp1.3:27.1": "61. Saṅgo eso parittamettha sokhyaṃ, ",
  "snp1.3:27.2": "appassādo dukkhamettha bhiyyo; ",
  "snp1.3:27.3": "Gaḷo eso iti ñatvā mutīmā , ",
  "snp1.3:27.4": "eko care khaggavisāṇakappo. ",
  "snp1.3:28.1": "62. Sandālayitvāna saṃyojanāni, ",
  "snp1.3:28.2": "jālaṃva bhetvā salilambucārī; ",
  "snp1.3:28.3": "Aggīva daḍḍhaṃ anivattamāno, ",
  "snp1.3:28.4": "eko care khaggavisāṇakappo. ",
  "snp1.3:29.1": "63. Okkhittacakkhū na ca pādalolo, ",
  "snp1.3:29.2": "guttindriyo rakkhitamānasāno; ",
  "snp1.3:29.3": "Anavassuto apariḍayhamāno, ",
  "snp1.3:29.4": "eko care khaggavisāṇakappo. ",
  "snp1.3:30.1": "64. Ohārayitvā gihibyañjanāni, ",
  "snp1.3:30.2": "sañchannapatto yathā pārichatto; ",
  "snp1.3:30.3": "Kāsāyavattho abhinikkhamitvā, ",
  "snp1.3:30.4": "eko care khaggavisāṇakappo. ",
  "snp1.3:31.1": "65. Rasesu gedhaṃ akaraṃ alolo, ",
  "snp1.3:31.2": "anaññaposī sapadānacārī; ",
  "snp1.3:31.3": "Kule kule appaṭibaddhacitto , ",
  "snp1.3:31.4": "eko care khaggavisāṇakappo. ",
  "snp1.3:32.1": "66. Pahāya pañcāvaraṇāni cetaso, ",
  "snp1.3:32.2": "upakkilese byapanujja sabbe; ",
  "snp1.3:32.3": "Anissito chetva sinehadosaṃ , ",
  "snp1.3:32.4": "eko care khaggavisāṇakappo. ",
  "snp1.3:33.1": "67. Vipiṭṭhikatvāna sukhaṃ dukhañca, ",
  "snp1.3:33.2": "pubbeva ca somanassadomanassaṃ; ",
  "snp1.3:33.3": "Laddhānupekkhaṃ samathaṃ visuddhaṃ, ",
  "snp1.3:33.4": "eko care khaggavisāṇakappo. ",
  "snp1.3:34.1": "68. Āraddhavīriyo paramatthapattiyā, ",
  "snp1.3:34.2": "alīnacitto akusītavutti; ",
  "snp1.3:34.3": "Daḷhanikkamo thāmabalūpapanno, ",
  "snp1.3:34.4": "eko care khaggavisāṇakappo. ",
  "snp1.3:35.1": "69. Paṭisallānaṃ jhānamariñcamāno, ",
  "snp1.3:35.2": "dhammesu niccaṃ anudhammacārī; ",
  "snp1.3:35.3": "Ādīnavaṃ sammasitā bhavesu, ",
  "snp1.3:35.4": "eko care khaggavisāṇakappo. ",
  "snp1.3:36.1": "70. Taṇhakkhayaṃ patthayamappamatto, ",
  "snp1.3:36.2": "aneḷamūgo sutavā satīmā; ",
  "snp1.3:36.3": "Saṅkhātadhammo niyato padhānavā, ",
  "snp1.3:36.4": "eko care khaggavisāṇakappo. ",
  "snp1.3:37.1": "71. Sīhova saddesu asantasanto, ",
  "snp1.3:37.2": "vātova jālamhi asajjamāno; ",
  "snp1.3:37.3": "Padumaṃva toyena alippamāno , ",
  "snp1.3:37.4": "eko care khaggavisāṇakappo. ",
  "snp1.3:38.1": "72. Sīho yathā dāṭhabalī pasayha, ",
  "snp1.3:38.2": "rājā migānaṃ abhibhuyya cārī; ",
  "snp1.3:38.3": "Sevetha pantāni senāsanāni, ",
  "snp1.3:38.4": "eko care khaggavisāṇakappo. ",
  "snp1.3:39.1": "73. Mettaṃ upekkhaṃ karuṇaṃ vimuttiṃ, ",
  "snp1.3:39.2": "āsevamāno muditañca kāle; ",
  "snp1.3:39.3": "Sabbena lokena avirujjhamāno, ",
  "snp1.3:39.4": "eko care khaggavisāṇakappo. ",
  "snp1.3:40.1": "74. Rāgañca dosañca pahāya mohaṃ, ",
  "snp1.3:40.2": "sandālayitvāna saṃyojanāni; ",
  "snp1.3:40.3": "Asantasaṃ jīvitasaṅkhayamhi, ",
  "snp1.3:40.4": "eko care khaggavisāṇakappo. ",
  "snp1.3:41.1": "75. Bhajanti sevanti ca kāraṇatthā, ",
  "snp1.3:41.2": "nikkāraṇā dullabhā ajja mittā; ",
  "snp1.3:41.3": "Attaṭṭhapaññā asucī manussā, ",
  "snp1.3:41.4": "eko care khaggavisāṇakappo. ",
  "snp1.3:41.5": "Khaggavisāṇasuttaṃ tatiyaṃ niṭṭhitaṃ. "
}
