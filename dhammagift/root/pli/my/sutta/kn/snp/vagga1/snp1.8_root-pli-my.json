{
  "snp1.8:0.1": "",
  "snp1.8:0.2": "143. 8. Mettasuttaṃ ",
  "snp1.8:1.1": "Karaṇīyamatthakusalena, ",
  "snp1.8:1.2": "yanta santaṃ padaṃ abhisamecca; ",
  "snp1.8:1.3": "Sakko ujū ca suhujū ca, ",
  "snp1.8:1.4": "sūvaco cassa mudu anatimānī. ",
  "snp1.8:2.1": "144. Santussako ca subharo ca, ",
  "snp1.8:2.2": "appakicco ca sallahukavutti; ",
  "snp1.8:2.3": "Santindriyo ca nipako ca, ",
  "snp1.8:2.4": "appagabbho kulesvananugiddho. ",
  "snp1.8:3.1": "145. Na ca khuddamācare kiñci, ",
  "snp1.8:3.2": "yena viññū pare upavadeyyuṃ; ",
  "snp1.8:3.3": "Sukhino va khemino hontu, ",
  "snp1.8:3.4": "sabbasattā bhavantu sukhitattā. ",
  "snp1.8:4.1": "146. Ye keci pāṇabhūtatthi, ",
  "snp1.8:4.2": "tasā vā thāvarā vanavasesā; ",
  "snp1.8:4.3": "Dīghā vā ye va mahantā , ",
  "snp1.8:4.4": "majjhimā rassakā aṇukathūlā. ",
  "snp1.8:5.1": "147. Diṭṭhā vā ye va adiṭṭhā , ",
  "snp1.8:5.2": "ye va dūre vasanti avidūre; ",
  "snp1.8:5.3": "Bhūtā va sambhavesī va , ",
  "snp1.8:5.4": "sabbasattā bhavantu sukhitattā. ",
  "snp1.8:6.1": "148. Na paro paraṃ nikubbetha, ",
  "snp1.8:6.2": "nātimaññetha katthaci na kañci ; ",
  "snp1.8:6.3": "Byārosanā paṭighasaññā, ",
  "snp1.8:6.4": "nāññamaññassa dukkhamiccheyya. ",
  "snp1.8:7.1": "149. Mātā yathā niyaṃ puttamāyusā ",
  "snp1.8:7.2": "ekaputtamanurakkhe; ",
  "snp1.8:7.3": "Evampi sabbabhūtesu, ",
  "snp1.8:7.4": "mānasaṃ bhāvaye aparimāṇaṃ. ",
  "snp1.8:8.1": "150. Mettañca sabbalokasmi, ",
  "snp1.8:8.2": "mānasaṃ bhāvaye aparimāṇaṃ; ",
  "snp1.8:8.3": "Uddhaṃ adho ca tiriyañca, ",
  "snp1.8:8.4": "asambādhaṃ averamasapattaṃ. ",
  "snp1.8:9.1": "151. Tiṭṭhaṃ caraṃ nisinno va , ",
  "snp1.8:9.2": "sayāno yāvatāssa vitamiddho ; ",
  "snp1.8:9.3": "Etaṃ satiṃ adhiṭṭheyya, ",
  "snp1.8:9.4": "brahmametaṃ vihāramidhamāhu. ",
  "snp1.8:10.1": "152. Diṭṭhiñca anupaggamma, ",
  "snp1.8:10.2": "sīlavā dassanena sampanno; ",
  "snp1.8:10.3": "Kāmesu vinaya gedhaṃ, ",
  "snp1.8:10.4": "na hi jātuggabbhaseyya punaretīti. ",
  "snp1.8:10.5": "Mettasuttaṃ aṭṭhamaṃ niṭṭhitaṃ. "
}
