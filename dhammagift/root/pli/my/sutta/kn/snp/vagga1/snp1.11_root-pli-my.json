{
  "snp1.11:0.1": "",
  "snp1.11:0.2": "11. Vijayasuttaṃ 195. ",
  "snp1.11:1.1": "Caraṃ vā yadi vā tiṭṭhaṃ, ",
  "snp1.11:1.2": "nisinno uda vā sayaṃ; ",
  "snp1.11:1.3": "Samiñjeti pasāreti, ",
  "snp1.11:1.4": "esā kāyassa iñjanā. ",
  "snp1.11:2.1": "196. Aṭṭhinahārusaṃyutto, ",
  "snp1.11:2.2": "tacamaṃsāvalepano; ",
  "snp1.11:2.3": "Chaviyā kāyo paṭicchanno, ",
  "snp1.11:2.4": "yathābhūtaṃ na dissati. ",
  "snp1.11:3.1": "197. Antapūro udarapūro, ",
  "snp1.11:3.2": "yakanapeḷassa vatthino; ",
  "snp1.11:3.3": "Hadayassa papphāsassa, ",
  "snp1.11:3.4": "vakkassa pihakassa ca. ",
  "snp1.11:4.1": "198. Siṅghāṇikāya kheḷassa, ",
  "snp1.11:4.2": "sedassa ca medassa ca; ",
  "snp1.11:4.3": "Lohitassa lasikāya, ",
  "snp1.11:4.4": "pittassa ca vasāya ca. ",
  "snp1.11:5.1": "199. Athassa navahi sotehi, ",
  "snp1.11:5.2": "asucī savati sabbadā; ",
  "snp1.11:5.3": "Akkhimhā akkhigūthako, ",
  "snp1.11:5.4": "kaṇṇamhā kaṇṇagūthako. ",
  "snp1.11:6.1": "200. Siṅghāṇikā ca nāsato, ",
  "snp1.11:6.2": "mukhena vamatekadā; ",
  "snp1.11:6.3": "Pittaṃ semhañca vamati, ",
  "snp1.11:6.4": "kāyamhā sedajallikā. ",
  "snp1.11:7.1": "201. Athassa susiraṃ sīsaṃ, ",
  "snp1.11:7.2": "matthaluṅgassa pūritaṃ; ",
  "snp1.11:7.3": "Subhato naṃ maññati, bālo ",
  "snp1.11:7.4": "avijjāya purakkhato. ",
  "snp1.11:8.1": "202. Yadā ca so mato seti, ",
  "snp1.11:8.2": "uddhumāto vinīlako; ",
  "snp1.11:8.3": "Apaviddho susānasmiṃ, ",
  "snp1.11:8.4": "anapekkhā honti ñātayo. ",
  "snp1.11:9.1": "203. Khādanti naṃ suvānā ca, ",
  "snp1.11:9.2": "siṅgālā vakā kimī; ",
  "snp1.11:9.3": "Kākā gijjhā ca khādanti, ",
  "snp1.11:9.4": "ye caññe santi pāṇino. ",
  "snp1.11:10.1": "204. Sutvāna buddhavacanaṃ, ",
  "snp1.11:10.2": "bhikkhu paññāṇavā idha; ",
  "snp1.11:10.3": "So kho naṃ parijānāti, ",
  "snp1.11:10.4": "yathābhūtañhi passati. ",
  "snp1.11:11.1": "205. Yathā idaṃ tathā etaṃ, ",
  "snp1.11:11.2": "yathā etaṃ tathā idaṃ; ",
  "snp1.11:11.3": "Ajjhattañca bahiddhā ca, ",
  "snp1.11:11.4": "kāye chandaṃ virājaye. ",
  "snp1.11:12.1": "206. Chandarāgaviratto so, ",
  "snp1.11:12.2": "bhikkhu paññāṇavā idha; ",
  "snp1.11:12.3": "Ajjhagā amataṃ santiṃ, ",
  "snp1.11:12.4": "nibbānaṃ padamaccutaṃ. ",
  "snp1.11:13.1": "207. Dvipādakoyaṃ asuci, ",
  "snp1.11:13.2": "duggandho parihārati ; ",
  "snp1.11:13.3": "Nānākuṇapaparipūro, ",
  "snp1.11:13.4": "vissavanto tato tato. ",
  "snp1.11:14.1": "208. Etādisena kāyena, ",
  "snp1.11:14.2": "yo maññe uṇṇametave ; ",
  "snp1.11:14.3": "Paraṃ vā avajāneyya, ",
  "snp1.11:14.4": "kimaññatra adassanāti. ",
  "snp1.11:14.5": "Vijayasuttaṃ ekādasamaṃ niṭṭhitaṃ. "
}
