{
  "snp1.5:0.1": "",
  "snp1.5:0.2": "83. 5. Cundasuttaṃ ",
  "snp1.5:1.1": "‘‘Pucchāmi muniṃ pahūtapaññaṃ, ",
  "snp1.5:1.2": "(iti cundo kammāraputto) ",
  "snp1.5:1.3": "Buddhaṃ dhammassāmiṃ vītataṇhaṃ; ",
  "snp1.5:1.4": "Dvipaduttamaṃ sārathīnaṃ pavaraṃ, ",
  "snp1.5:1.5": "kati loke samaṇā tadiṅgha brūhi’’. ",
  "snp1.5:2.1": "84. ‘‘Caturo samaṇā na pañcamatthi, ",
  "snp1.5:2.2": "(cundāti bhagavā) ",
  "snp1.5:2.3": "Te te āvikaromi sakkhipuṭṭho; ",
  "snp1.5:2.4": "Maggajino maggadesako ca, ",
  "snp1.5:2.5": "magge jīvati yo ca maggadūsī’’. ",
  "snp1.5:3.1": "85. ‘‘Kaṃ maggajinaṃ vadanti buddhā, ",
  "snp1.5:3.2": "(iti cundo kammāraputto) ",
  "snp1.5:3.3": "Maggakkhāyī kathaṃ atulyo hoti; ",
  "snp1.5:3.4": "Magge jīvati me brūhi puṭṭho, ",
  "snp1.5:3.5": "atha me āvikarohi maggadūsiṃ’’ . ",
  "snp1.5:4.1": "86. ‘‘Yo tiṇṇakathaṃkatho visallo, ",
  "snp1.5:4.2": "nibbānābhirato anānugiddho; ",
  "snp1.5:4.3": "Lokassa sadevakassa netā, ",
  "snp1.5:4.4": "tādiṃ maggajinaṃ vadanti buddhā. ",
  "snp1.5:5.1": "87. ‘‘Paramaṃ paramanti yodha ñatvā, ",
  "snp1.5:5.2": "akkhāti vibhajate idheva dhammaṃ; ",
  "snp1.5:5.3": "Taṃ kaṅkhachidaṃ muniṃ anejaṃ, ",
  "snp1.5:5.4": "dutiyaṃ bhikkhunamāhu maggadesiṃ. ",
  "snp1.5:6.1": "88. ‘‘Yo dhammapade sudesite, ",
  "snp1.5:6.2": "magge jīvati saññato satīmā; ",
  "snp1.5:6.3": "Anavajjapadāni sevamāno, ",
  "snp1.5:6.4": "tatiyaṃ bhikkhunamāhu maggajīviṃ. ",
  "snp1.5:7.1": "89. ‘‘Chadanaṃ katvāna subbatānaṃ, ",
  "snp1.5:7.2": "pakkhandī kuladūsako pagabbho; ",
  "snp1.5:7.3": "Māyāvī asaññato palāpo, ",
  "snp1.5:7.4": "patirūpena caraṃ sa maggadūsī. ",
  "snp1.5:8.1": "90. ‘‘Ete ca paṭivijjhi yo gahaṭṭho, ",
  "snp1.5:8.2": "sutavā ariyasāvako sapañño; ",
  "snp1.5:8.3": "Sabbe netādisāti ñatvā, ",
  "snp1.5:8.4": "iti disvā na hāpeti tassa saddhā; ",
  "snp1.5:8.5": "Kathaṃ hi duṭṭhena asampaduṭṭhaṃ, ",
  "snp1.5:8.6": "suddhaṃ asuddhena samaṃ kareyyā’’ti. ",
  "snp1.5:8.7": "Cundasuttaṃ pañcamaṃ niṭṭhitaṃ. "
}
