{
  "snp2.9:0.1": "",
  "snp2.9:0.2": "326. 9. Kiṃsīlasuttaṃ ",
  "snp2.9:1.1": "‘‘Kiṃsīlo kiṃsamācāro, ",
  "snp2.9:1.2": "kāni kammāni brūhayaṃ; ",
  "snp2.9:1.3": "Naro sammā niviṭṭhassa, ",
  "snp2.9:1.4": "uttamatthañca pāpuṇe’’. ",
  "snp2.9:2.1": "327. ‘‘Vuḍḍhāpacāyī anusūyako siyā, ",
  "snp2.9:2.2": "kālaññū cassa garūnaṃ dassanāya; ",
  "snp2.9:2.3": "Dhammiṃ kathaṃ erayitaṃ khaṇaññū, ",
  "snp2.9:2.4": "suṇeyya sakkacca subhāsitāni. ",
  "snp2.9:3.1": "328. ‘‘Kālena gacche garūnaṃ sakāsaṃ, ",
  "snp2.9:3.2": "thambhaṃ niraṃkatvā nivātavutti; ",
  "snp2.9:3.3": "Atthaṃ dhammaṃ saṃyamaṃ brahmacariyaṃ, ",
  "snp2.9:3.4": "anussare ceva samācare ca. ",
  "snp2.9:4.1": "329. ‘‘Dhammārāmo dhammarato, ",
  "snp2.9:4.2": "dhamme ṭhito dhammavinicchayaññū; ",
  "snp2.9:4.3": "Nevācare dhammasandosavādaṃ, ",
  "snp2.9:4.4": "tacchehi nīyetha subhāsitehi. ",
  "snp2.9:5.1": "330. ‘‘Hassaṃ jappaṃ paridevaṃ padosaṃ, ",
  "snp2.9:5.2": "māyākataṃ kuhanaṃ giddhi mānaṃ; ",
  "snp2.9:5.3": "Sārambhaṃ kakkasaṃ kasāvañca mucchaṃ , ",
  "snp2.9:5.4": "hitvā care vītamado ṭhitatto. ",
  "snp2.9:6.1": "331. ‘‘Viññātasārāni subhāsitāni, ",
  "snp2.9:6.2": "sutañca viññātasamādhisāraṃ; ",
  "snp2.9:6.3": "Na tassa paññā ca sutañca vaḍḍhati, ",
  "snp2.9:6.4": "yo sāhaso hoti naro pamatto. ",
  "snp2.9:7.1": "332. ‘‘Dhamme ca ye ariyapavedite ratā, ",
  "snp2.9:7.2": "Anuttarā te vacasā manasā kammunā ca; ",
  "snp2.9:7.3": "Te santisoraccasamādhisaṇṭhitā, ",
  "snp2.9:7.4": "Sutassa paññāya ca sāramajjhagū’’ti. ",
  "snp2.9:7.5": "Kiṃsīlasuttaṃ navamaṃ niṭṭhitaṃ. "
}
