{
  "snp2.1:0.1": "",
  "snp2.1:0.2": "2. Cūḷavaggo 1. Ratanasuttaṃ 224. ",
  "snp2.1:1.1": "Yānīdha bhūtāni samāgatāni, ",
  "snp2.1:1.2": "bhummāni vā yāni va antalikkhe; ",
  "snp2.1:1.3": "Sabbeva bhūtā sumanā bhavantu, ",
  "snp2.1:1.4": "athopi sakkacca suṇantu bhāsitaṃ. ",
  "snp2.1:2.1": "225. Tasmā hi bhūtā nisāmetha sabbe, ",
  "snp2.1:2.2": "mettaṃ karotha mānusiyā pajāya; ",
  "snp2.1:2.3": "Divā ca ratto ca haranti ye baliṃ, ",
  "snp2.1:2.4": "tasmā hi ne rakkhatha appamattā. ",
  "snp2.1:3.1": "226. Yaṃ kiñci vittaṃ idha vā huraṃ vā, ",
  "snp2.1:3.2": "saggesu vā yaṃ ratanaṃ paṇītaṃ; ",
  "snp2.1:3.3": "Na no samaṃ atthi tathāgatena, ",
  "snp2.1:3.4": "idampi buddhe ratanaṃ paṇītaṃ; ",
  "snp2.1:3.5": "Etena saccena suvatthi hotu. ",
  "snp2.1:4.1": "227. Khayaṃ virāgaṃ amataṃ paṇītaṃ, ",
  "snp2.1:4.2": "yadajjhagā sakyamunī samāhito; ",
  "snp2.1:4.3": "Na tena dhammena samatthi kiñci, ",
  "snp2.1:4.4": "idampi dhamme ratanaṃ paṇītaṃ; ",
  "snp2.1:4.5": "Etena saccena suvatthi hotu. ",
  "snp2.1:5.1": "228. Yaṃ buddhaseṭṭho parivaṇṇayī suciṃ, ",
  "snp2.1:5.2": "samādhimānantarikaññamāhu; ",
  "snp2.1:5.3": "Samādhinā tena samo na vijjati, ",
  "snp2.1:5.4": "idampi dhamme ratanaṃ paṇītaṃ; ",
  "snp2.1:5.5": "Etena saccena suvatthi hotu. ",
  "snp2.1:6.1": "229. Ye puggalā aṭṭha sataṃ pasatthā, ",
  "snp2.1:6.2": "cattāri etāni yugāni honti; ",
  "snp2.1:6.3": "Te dakkhiṇeyyā sugatassa sāvakā, ",
  "snp2.1:6.4": "etesu dinnāni mahapphalāni; ",
  "snp2.1:6.5": "Idampi saṅghe ratanaṃ paṇītaṃ, ",
  "snp2.1:6.6": "etena saccena suvatthi hotu. ",
  "snp2.1:7.1": "230. Ye suppayuttā manasā daḷhena, ",
  "snp2.1:7.2": "nikkāmino gotamasāsanamhi; ",
  "snp2.1:7.3": "Te pattipattā amataṃ vigayha, ",
  "snp2.1:7.4": "laddhā mudhā nibbutiṃ bhuñjamānā; ",
  "snp2.1:7.5": "Idampi saṅghe ratanaṃ paṇītaṃ, ",
  "snp2.1:7.6": "etena saccena suvatthi hotu. ",
  "snp2.1:8.1": "231. Yathindakhīlo pathavissito siyā, ",
  "snp2.1:8.2": "catubbhi vātehi asampakampiyo; ",
  "snp2.1:8.3": "Tathūpamaṃ sappurisaṃ vadāmi, ",
  "snp2.1:8.4": "yo ariyasaccāni avecca passati; ",
  "snp2.1:8.5": "Idampi saṅghe ratanaṃ paṇītaṃ, ",
  "snp2.1:8.6": "etena saccena suvatthi hotu. ",
  "snp2.1:9.1": "232. Ye ariyasaccāni vibhāvayanti, ",
  "snp2.1:9.2": "gambhīrapaññena sudesitāni; ",
  "snp2.1:9.3": "Kiñcāpi te honti bhusaṃ pamattā, ",
  "snp2.1:9.4": "na te bhavaṃ aṭṭhamamādiyanti; ",
  "snp2.1:9.5": "Idampi saṅghe ratanaṃ paṇītaṃ, ",
  "snp2.1:9.6": "etena saccena suvatthi hotu. ",
  "snp2.1:10.1": "233. Sahāvassa dassanasampadāya , ",
  "snp2.1:10.2": "tayassu dhammā jahitā bhavanti; ",
  "snp2.1:10.3": "Sakkāyadiṭṭhi vicikicchitañca, ",
  "snp2.1:10.4": "sīlabbataṃ vāpi yadatthi kiñci. ",
  "snp2.1:11.1": "234. Catūhapāyehi ca vippamutto, ",
  "snp2.1:11.2": "chaccābhiṭhānāni bhabba kātuṃ ; ",
  "snp2.1:11.3": "Idampi saṅghe ratanaṃ paṇītaṃ, ",
  "snp2.1:11.4": "etena saccena suvatthi hotu. ",
  "snp2.1:12.1": "235. Kiñcāpi so kamma karoti pāpakaṃ, ",
  "snp2.1:12.2": "kāyena vācā uda cetasā vā; ",
  "snp2.1:12.3": "Abhabba so tassa paṭicchadāya , ",
  "snp2.1:12.4": "abhabbatā diṭṭhapadassa vuttā; ",
  "snp2.1:12.5": "Idampi saṅghe ratanaṃ paṇītaṃ, ",
  "snp2.1:12.6": "etena saccena suvatthi hotu. ",
  "snp2.1:13.1": "236. Vanappagumbe yatha phussitagge, ",
  "snp2.1:13.2": "gimhānamāse paṭhamasmiṃ gimhe; ",
  "snp2.1:13.3": "Tathūpamaṃ dhammavaraṃ adesayi , ",
  "snp2.1:13.4": "nibbānagāmiṃ paramaṃ hitāya; ",
  "snp2.1:13.5": "Idampi buddhe ratanaṃ paṇītaṃ, ",
  "snp2.1:13.6": "etena saccena suvatthi hotu. ",
  "snp2.1:14.1": "237. Varo varaññū varado varāharo, ",
  "snp2.1:14.2": "anuttaro dhammavaraṃ adesayi; ",
  "snp2.1:14.3": "Idampi buddhe ratanaṃ paṇītaṃ, ",
  "snp2.1:14.4": "etena saccena suvatthi hotu. ",
  "snp2.1:15.1": "238. Khīṇaṃ purāṇaṃ nava natthi sambhavaṃ, ",
  "snp2.1:15.2": "virattacittāyatike bhavasmiṃ; ",
  "snp2.1:15.3": "Te khīṇabījā avirūḷhichandā, ",
  "snp2.1:15.4": "nibbanti dhīrā yathāyaṃ padīpo; ",
  "snp2.1:15.5": "Idampi saṅghe ratanaṃ paṇītaṃ, ",
  "snp2.1:15.6": "etena saccena suvatthi hotu. ",
  "snp2.1:16.1": "239. Yānīdha bhūtāni samāgatāni, ",
  "snp2.1:16.2": "bhummāni vā yāni va antalikkhe; ",
  "snp2.1:16.3": "Tathāgataṃ devamanussapūjitaṃ, ",
  "snp2.1:16.4": "buddhaṃ namassāma suvatthi hotu. ",
  "snp2.1:17.1": "240. Yānīdha bhūtāni samāgatāni, ",
  "snp2.1:17.2": "bhummāni vā yāni va antalikkhe; ",
  "snp2.1:17.3": "Tathāgataṃ devamanussapūjitaṃ, ",
  "snp2.1:17.4": "dhammaṃ namassāma suvatthi hotu. ",
  "snp2.1:18.1": "241. Yānīdha bhūtāni samāgatāni, ",
  "snp2.1:18.2": "bhummāni vā yāni va antalikkhe; ",
  "snp2.1:18.3": "Tathāgataṃ devamanussapūjitaṃ, ",
  "snp2.1:18.4": "saṅghaṃ namassāma suvatthi hotūti. ",
  "snp2.1:18.5": "Ratanasuttaṃ paṭhamaṃ niṭṭhitaṃ. "
}
