  "snp2.13:0.1": "",
  "snp2.13:0.2": "361. 13. Sammāparibbājanīyasuttaṃ ",
  "snp2.13:1.1": "‘‘Pucchāmi muniṃ pahūtapaññaṃ, ",
  "snp2.13:1.2": "Tiṇṇaṃ pāraṅgataṃ parinibbutaṃ ṭhitattaṃ; ",
  "snp2.13:1.3": "Nikkhamma gharā panujja kāme, ",
  "snp2.13:1.4": "kathaṃ bhikkhu Sammā so loke paribbajeyya’’. ",
  "snp2.13:2.1": "362. ‘‘Yassa maṅgalā samūhatā, ",
  "snp2.13:2.2": "(iti bhagavā) ",
  "snp2.13:2.3": "Uppātā supinā ca lakkhaṇā ca; ",
  "snp2.13:2.4": "So maṅgaladosavippahīno, ",
  "snp2.13:2.5": "Sammā so loke paribbajeyya. ",
  "snp2.13:3.1": "363. ‘‘Rāgaṃ vinayetha mānusesu, ",
  "snp2.13:3.2": "dibbesu kāmesu cāpi bhikkhu; ",
  "snp2.13:3.3": "Atikkamma bhavaṃ samecca dhammaṃ, ",
  "snp2.13:3.4": "sammā so loke paribbajeyya. ",
  "snp2.13:4.1": "364. ‘‘Vipiṭṭhikatvāna pesuṇāni, ",
  "snp2.13:4.2": "kodhaṃ kadariyaṃ jaheyya bhikkhu; ",
  "snp2.13:4.3": "Anurodhavirodhavippahīno, ",
  "snp2.13:4.4": "sammā so loke paribbajeyya. ",
  "snp2.13:5.1": "365. ‘‘Hitvāna piyañca appiyañca, ",
  "snp2.13:5.2": "anupādāya anissito kuhiñci; ",
  "snp2.13:5.3": "Saṃyojaniyehi vippamutto, ",
  "snp2.13:5.4": "sammā so loke paribbajeyya. ",
  "snp2.13:6.1": "366. ‘‘Na so upadhīsu sārameti, ",
  "snp2.13:6.2": "ādānesu vineyya chandarāgaṃ; ",
  "snp2.13:6.3": "So anissito anaññaneyyo, ",
  "snp2.13:6.4": "sammā so loke paribbajeyya. ",
  "snp2.13:7.1": "367. ‘‘Vacasā manasā ca kammunā ca, ",
  "snp2.13:7.2": "aviruddho sammā viditvā dhammaṃ; ",
  "snp2.13:7.3": "Nibbānapadābhipatthayāno, ",
  "snp2.13:7.4": "sammā so loke paribbajeyya. ",
  "snp2.13:8.1": "368. ‘‘Yo vandati manti nuṇṇameyya , ",
  "snp2.13:8.2": "akkuṭṭhopi na sandhiyetha bhikkhu; ",
  "snp2.13:8.3": "Laddhā parabhojanaṃ na majje, ",
  "snp2.13:8.4": "sammā so loke paribbajeyya. ",
  "snp2.13:9.1": "369. ‘‘Lobhañca bhavañca vippahāya, ",
  "snp2.13:9.2": "virato chedanabandhanā ca bhikkhu; ",
  "snp2.13:9.3": "So tiṇṇakathaṃkatho visallo, ",
  "snp2.13:9.4": "sammā so loke paribbajeyya. ",
  "snp2.13:10.1": "370. ‘‘Sāruppaṃ attano viditvā, ",
  "snp2.13:10.2": "no ca bhikkhu hiṃseyya kañci loke; ",
  "snp2.13:10.3": "Yathā tathiyaṃ viditvā dhammaṃ, ",
  "snp2.13:10.4": "sammā so loke paribbajeyya. ",
  "snp2.13:11.1": "371. ‘‘Yassānusayā na santi keci, ",
  "snp2.13:11.2": "mūlā ca akusalā samūhatāse; ",
  "snp2.13:11.3": "So nirāso anāsisāno , ",
  "snp2.13:11.4": "sammā so loke paribbajeyya. ",
  "snp2.13:12.1": "372. ‘‘Āsavakhīṇo pahīnamāno, ",
  "snp2.13:12.2": "sabbaṃ rāgapathaṃ upātivatto; ",
  "snp2.13:12.3": "Danto parinibbuto ṭhitatto, ",
  "snp2.13:12.4": "sammā so loke paribbajeyya. ",
  "snp2.13:13.1": "373. ‘‘Saddho sutavā niyāmadassī, ",
  "snp2.13:13.2": "vaggagatesu na vaggasāri dhīro; ",
  "snp2.13:13.3": "Lobhaṃ dosaṃ vineyya paṭighaṃ, ",
  "snp2.13:13.4": "sammā so loke paribbajeyya. ",
  "snp2.13:14.1": "374. ‘‘Saṃsuddhajino vivaṭṭacchado, ",
  "snp2.13:14.2": "dhammesu vasī pāragū anejo; ",
  "snp2.13:14.3": "Saṅkhāranirodhañāṇakusalo, ",
  "snp2.13:14.4": "sammā so loke paribbajeyya. ",
  "snp2.13:15.1": "375. ‘‘Atītesu anāgatesu cāpi, ",
  "snp2.13:15.2": "kappātīto aticcasuddhipañño; ",
  "snp2.13:15.3": "Sabbāyatanehi vippamutto, ",
  "snp2.13:15.4": "sammā so loke paribbajeyya. ",
  "snp2.13:16.1": "376. ‘‘Aññāya padaṃ samecca dhammaṃ, ",
  "snp2.13:16.2": "vivaṭaṃ disvāna pahānamāsavānaṃ; ",
  "snp2.13:16.3": "Sabbupadhīnaṃ parikkhayāno , ",
  "snp2.13:16.4": "sammā so loke paribbajeyya’’. ",
  "snp2.13:17.1": "377. ‘‘Addhā hi bhagavā tatheva etaṃ, ",
  "snp2.13:17.2": "yo so evaṃvihārī danto bhikkhu; ",
  "snp2.13:17.3": "Sabbasaṃyojanayogavītivatto , ",
  "snp2.13:17.4": "sammā so loke paribbajeyyā’’ti. ",
  "snp2.13:17.5": "Sammāparibbājanīyasuttaṃ terasamaṃ niṭṭhitaṃ. "
}
