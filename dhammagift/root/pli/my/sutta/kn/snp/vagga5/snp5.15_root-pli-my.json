{
  "snp5.15:0.1": "",
  "snp5.15:0.2": "1118. 14. Posālamāṇavapucchā ",
  "snp5.15:1.1": "‘‘Yo atītaṃ ādisati, ",
  "snp5.15:1.2": "(iccāyasmā posālo) ",
  "snp5.15:1.3": "anejo chinnasaṃsayo; ",
  "snp5.15:1.4": "Pāraguṃ sabbadhammānaṃ, ",
  "snp5.15:1.5": "atthi pañhena āgamaṃ. ",
  "snp5.15:2.1": "1119. ‘‘Vibhūtarūpasaññissa, ",
  "snp5.15:2.2": "sabbakāyappahāyino; ",
  "snp5.15:2.3": "Ajjhattañca bahiddhā ca, ",
  "snp5.15:2.4": "natthi kiñcīti passato; ",
  "snp5.15:2.5": "Ñāṇaṃ sakkānupucchāmi, ",
  "snp5.15:2.6": "kathaṃ neyyo tathāvidho’’. ",
  "snp5.15:3.1": "1120. ‘‘Viññāṇaṭṭhitiyo sabbā, ",
  "snp5.15:3.2": "(posālāti bhagavā) ",
  "snp5.15:3.3": "abhijānaṃ tathāgato; ",
  "snp5.15:3.4": "Tiṭṭhantamenaṃ jānāti, ",
  "snp5.15:3.5": "vimuttaṃ tapparāyaṇaṃ. ",
  "snp5.15:4.1": "1121. ‘‘Ākiñcaññasambhavaṃ ñatvā, ",
  "snp5.15:4.2": "nandī saṃyojanaṃ iti; ",
  "snp5.15:4.3": "Evametaṃ abhiññāya, ",
  "snp5.15:4.4": "tato tattha vipassati; ",
  "snp5.15:4.5": "Etaṃ ñāṇaṃ tathaṃ tassa, ",
  "snp5.15:4.6": "brāhmaṇassa vusīmato’’ti. ",
  "snp5.15:4.7": "Posālamāṇavapucchā cuddasamā niṭṭhitā. "
}
