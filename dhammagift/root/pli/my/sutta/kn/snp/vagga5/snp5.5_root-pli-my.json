  "snp5.5:0.1": "",
  "snp5.5:0.2": "1055. 4. Mettagūmāṇavapucchā ",
  "snp5.5:1.1": "‘‘Pucchāmi taṃ bhagavā brūhi me taṃ, ",
  "snp5.5:1.2": "(iccāyasmā mettagū) ",
  "snp5.5:1.3": "Maññāmi taṃ vedaguṃ bhāvitattaṃ; ",
  "snp5.5:1.4": "Kuto nu dukkhā samudāgatā ime, ",
  "snp5.5:1.5": "ye keci lokasmimanekarūpā’’. ",
  "snp5.5:2.1": "1056. ‘‘Dukkhassa ve maṃ pabhavaṃ apucchasi, ",
  "snp5.5:2.2": "(mettagūti bhagavā) ",
  "snp5.5:2.3": "Taṃ te pavakkhāmi yathā pajānaṃ; ",
  "snp5.5:2.4": "Upadhinidānā pabhavanti dukkhā, ",
  "snp5.5:2.5": "ye keci lokasmimanekarūpā. ",
  "snp5.5:3.1": "1057. ‘‘Yo ve avidvā upadhiṃ karoti, ",
  "snp5.5:3.2": "punappunaṃ dukkhamupeti mando; ",
  "snp5.5:3.3": "Tasmā pajānaṃ upadhiṃ na kayirā, ",
  "snp5.5:3.4": "dukkhassa jātippabhavānupassī’’. ",
  "snp5.5:4.1": "1058. ‘‘Yaṃ taṃ apucchimha akittayī no, ",
  "snp5.5:4.2": "aññaṃ taṃ pucchāma tadiṅgha brūhi; ",
  "snp5.5:4.3": "Kathaṃ nu dhīrā vitaranti oghaṃ, ",
  "snp5.5:4.4": "jātiṃ jaraṃ sokapariddavañca; ",
  "snp5.5:4.5": "Taṃ me muni sādhu viyākarohi, ",
  "snp5.5:4.6": "tathā hi te vidito esa dhammo’’. ",
  "snp5.5:5.1": "1059. ‘‘Kittayissāmi te dhammaṃ, ",
  "snp5.5:5.2": "(mettagūti bhagavā) ",
  "snp5.5:5.3": "Diṭṭhe dhamme anītihaṃ; ",
  "snp5.5:5.4": "Yaṃ viditvā sato caraṃ, ",
  "snp5.5:5.5": "tare loke visattikaṃ’’. ",
  "snp5.5:6.1": "1060. ‘‘Tañcāhaṃ abhinandāmi, ",
  "snp5.5:6.2": "mahesi dhammamuttamaṃ; ",
  "snp5.5:6.3": "Yaṃ viditvā sato caraṃ, ",
  "snp5.5:6.4": "tare loke visattikaṃ’’. ",
  "snp5.5:7.1": "1061. ‘‘Yaṃ kiñci sampajānāsi, ",
  "snp5.5:7.2": "(mettagūti bhagavā) ",
  "snp5.5:7.3": "Uddhaṃ adho tiriyañcāpi majjhe; ",
  "snp5.5:7.4": "Etesu nandiñca nivesanañca, ",
  "snp5.5:7.5": "panujja viññāṇaṃ bhave na tiṭṭhe. ",
  "snp5.5:8.1": "1062. ‘‘Evaṃvihārī sato appamatto, ",
  "snp5.5:8.2": "bhikkhu caraṃ hitvā mamāyitāni; ",
  "snp5.5:8.3": "Jātiṃ jaraṃ sokapariddavañca, ",
  "snp5.5:8.4": "idheva vidvā pajaheyya dukkhaṃ’’. ",
  "snp5.5:9.1": "1063. ‘‘Etābhinandāmi vaco mahesino, ",
  "snp5.5:9.2": "sukittitaṃ gotamanūpadhīkaṃ; ",
  "snp5.5:9.3": "Addhā hi bhagavā pahāsi dukkhaṃ, ",
  "snp5.5:9.4": "tathā hi te vidito esa dhammo. ",
  "snp5.5:10.1": "1064. ‘‘Te cāpi nūnappajaheyyu dukkhaṃ, ",
  "snp5.5:10.2": "ye tvaṃ muni aṭṭhitaṃ ovadeyya; ",
  "snp5.5:10.3": "Taṃ taṃ namassāmi samecca nāga, ",
  "snp5.5:10.4": "appeva maṃ bhagavā aṭṭhitaṃ ovadeyya’’. ",
  "snp5.5:11.1": "1065. ‘‘Yaṃ brāhmaṇaṃ vedagumābhijaññā, ",
  "snp5.5:11.2": "akiñcanaṃ kāmabhave asattaṃ; ",
  "snp5.5:11.3": "Addhā hi so oghamimaṃ atāri, ",
  "snp5.5:11.4": "tiṇṇo ca pāraṃ akhilo akaṅkho. ",
  "snp5.5:12.1": "1066. ‘‘Vidvā ca yo vedagū naro idha, ",
  "snp5.5:12.2": "bhavābhave saṅgamimaṃ visajja; ",
  "snp5.5:12.3": "So vītataṇho anīgho nirāso, ",
  "snp5.5:12.4": "atāri so jātijaranti brūmī’’ti. ",
  "snp5.5:12.5": "Mettagūmāṇavapucchā catutthī niṭṭhitā. "
}
