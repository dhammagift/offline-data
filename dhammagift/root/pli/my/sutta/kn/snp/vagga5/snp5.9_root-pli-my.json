{
  "snp5.9:0.1": "",
  "snp5.9:0.2": "8. Hemakamāṇavapucchā 1090. ",
  "snp5.9:1.1": "‘‘Ye me pubbe viyākaṃsu, ",
  "snp5.9:1.2": "(iccāyasmā hemako) ",
  "snp5.9:1.3": "Huraṃ gotamasāsanā; ",
  "snp5.9:1.4": "Iccāsi iti bhavissati, ",
  "snp5.9:1.5": "sabbaṃ taṃ itihītihaṃ; ",
  "snp5.9:1.6": "Sabbaṃ taṃ takkavaḍḍhanaṃ, ",
  "snp5.9:1.7": "nāhaṃ tattha abhiramiṃ. ",
  "snp5.9:2.1": "1091. ‘‘Tvañca me dhammamakkhāhi, ",
  "snp5.9:2.2": "taṇhānigghātanaṃ muni; ",
  "snp5.9:2.3": "Yaṃ viditvā sato caraṃ, ",
  "snp5.9:2.4": "tare loke visattikaṃ’’. ",
  "snp5.9:3.1": "1092. ‘‘Idha diṭṭhasutamutaviññātesu, ",
  "snp5.9:3.2": "piyarūpesu hemaka; ",
  "snp5.9:3.3": "Chandarāgavinodanaṃ, ",
  "snp5.9:3.4": "nibbānapadamaccutaṃ. ",
  "snp5.9:4.1": "1093. ‘‘Etadaññāya ye satā, ",
  "snp5.9:4.2": "diṭṭhadhammābhinibbutā; ",
  "snp5.9:4.3": "Upasantā ca te sadā, ",
  "snp5.9:4.4": "tiṇṇā loke visattika’’nti. ",
  "snp5.9:4.5": "Hemakamāṇavapucchā aṭṭhamā niṭṭhitā. "
}
