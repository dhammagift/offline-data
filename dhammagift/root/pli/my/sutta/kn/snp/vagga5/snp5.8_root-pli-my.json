{
  "snp5.8:0.1": "",
  "snp5.8:0.2": "7. Nandamāṇavapucchā 1083. ",
  "snp5.8:1.1": "‘‘Santi loke munayo, ",
  "snp5.8:1.2": "(iccāyasmā nando) ",
  "snp5.8:1.3": "Janā vadanti tayidaṃ kathaṃsu; ",
  "snp5.8:1.4": "Ñāṇūpapannaṃ no muniṃ vadanti, ",
  "snp5.8:1.5": "udāhu ve jīvitenūpapannaṃ’’. ",
  "snp5.8:2.1": "1084. ‘‘Na diṭṭhiyā na sutiyā na ñāṇena, (na sīlabbatena) ",
  "snp5.8:2.2": "Munīdha nanda kusalā vadanti; ",
  "snp5.8:2.3": "Visenikatvā anīghā nirāsā, ",
  "snp5.8:2.4": "caranti ye te munayoti brūmi’’. ",
  "snp5.8:3.1": "1085. ‘‘Ye kecime samaṇabrāhmaṇāse, ",
  "snp5.8:3.2": "(iccāyasmā nando) ",
  "snp5.8:3.3": "Diṭṭhassutenāpi vadanti suddhiṃ; ",
  "snp5.8:3.4": "Sīlabbatenāpi vadanti suddhiṃ, ",
  "snp5.8:3.5": "anekarūpena vadanti suddhiṃ; ",
  "snp5.8:3.6": "Kaccissu te bhagavā tattha yatā carantā, ",
  "snp5.8:3.7": "atāru jātiñca jarañca mārisa; ",
  "snp5.8:3.8": "Pucchāmi taṃ bhagavā brūhi me taṃ’’. ",
  "snp5.8:4.1": "1086. ‘‘Ye kecime samaṇabrāhmaṇāse, ",
  "snp5.8:4.2": "(nandāti bhagavā) ",
  "snp5.8:4.3": "Diṭṭhassutenāpi vadanti suddhiṃ; ",
  "snp5.8:4.4": "Sīlabbatenāpi vadanti suddhiṃ, ",
  "snp5.8:4.5": "anekarūpena vadanti suddhiṃ; ",
  "snp5.8:4.6": "Kiñcāpi te tattha yatā caranti, ",
  "snp5.8:4.7": "nāriṃsu jātijaranti brūmi’’. ",
  "snp5.8:5.1": "1087. ‘‘Ye kecime samaṇabrāhmaṇāse, ",
  "snp5.8:5.2": "(iccāyasmā nando) ",
  "snp5.8:5.3": "Diṭṭhassutenāpi vadanti suddhiṃ; ",
  "snp5.8:5.4": "Sīlabbatenāpi vadanti suddhiṃ, ",
  "snp5.8:5.5": "anekarūpena vadanti suddhiṃ; ",
  "snp5.8:5.6": "Te ce muni brūsi anoghatiṇṇe, ",
  "snp5.8:5.7": "atha ko carahi devamanussaloke; ",
  "snp5.8:5.8": "Atāri jātiñca jarañca mārisa, ",
  "snp5.8:5.9": "pucchāmi taṃ bhagavā brūhi me taṃ’’. ",
  "snp5.8:6.1": "1088. ‘‘Nāhaṃ sabbe samaṇabrāhmaṇāse, ",
  "snp5.8:6.2": "(nandāti bhagavā) ",
  "snp5.8:6.3": "Jātijarāya nivutāti brūmi; ",
  "snp5.8:6.4": "Ye sīdha diṭṭhaṃva sutaṃ mutaṃ vā, ",
  "snp5.8:6.5": "sīlabbataṃ vāpi pahāya sabbaṃ; ",
  "snp5.8:6.6": "Anekarūpampi pahāya sabbaṃ, ",
  "snp5.8:6.7": "taṇhaṃ pariññāya anāsavāse; ",
  "snp5.8:6.8": "Te ve narā oghatiṇṇāti brūmi’’. ",
  "snp5.8:7.1": "1089. ‘‘Etābhinandāmi vaco mahesino, ",
  "snp5.8:7.2": "sukittitaṃ gotamanūpadhīkaṃ; ",
  "snp5.8:7.3": "Ye sīdha diṭṭhaṃ va sutaṃ mutaṃ vā, ",
  "snp5.8:7.4": "sīlabbataṃ vāpi pahāya sabbaṃ; ",
  "snp5.8:7.5": "Anekarūpampi pahāya sabbaṃ, ",
  "snp5.8:7.6": "taṇhaṃ pariññāya anāsavāse; ",
  "snp5.8:7.7": "Ahampi te oghatiṇṇāti brūmī’’ti. ",
  "snp5.8:7.8": "Nandamāṇavapucchā sattamā niṭṭhitā. "
}
