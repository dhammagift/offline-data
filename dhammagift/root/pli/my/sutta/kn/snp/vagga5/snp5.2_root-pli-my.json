{
  "snp5.2:0.1": "",
  "snp5.2:0.2": "1038. 1. Ajitamāṇavapucchā ",
  "snp5.2:1.1": "‘‘Kenassu nivuto loko, ",
  "snp5.2:1.2": "(iccāyasmā ajito) ",
  "snp5.2:1.3": "Kenassu nappakāsati; ",
  "snp5.2:1.4": "Kissābhilepanaṃ brūsi, ",
  "snp5.2:1.5": "kiṃsu tassa mahabbhayaṃ’’. ",
  "snp5.2:2.1": "1039. ‘‘Avijjāya nivuto loko, ",
  "snp5.2:2.2": "(ajitāti bhagavā) ",
  "snp5.2:2.3": "Vevicchā pamādā nappakāsati; ",
  "snp5.2:2.4": "Jappābhilepanaṃ brūmi, ",
  "snp5.2:2.5": "dukkhamassa mahabbhayaṃ’’. ",
  "snp5.2:3.1": "1040. ‘‘Savanti sabbadhi sotā, ",
  "snp5.2:3.2": "(iccāyasmā ajito) ",
  "snp5.2:3.3": "Sotānaṃ kiṃ nivāraṇaṃ; ",
  "snp5.2:3.4": "Sotānaṃ saṃvaraṃ brūhi, ",
  "snp5.2:3.5": "kena sotā pidhiyyare’’ . ",
  "snp5.2:4.1": "1041. ‘‘Yāni sotāni lokasmiṃ, ",
  "snp5.2:4.2": "(ajitāti bhagavā) ",
  "snp5.2:4.3": "Sati tesaṃ nivāraṇaṃ; ",
  "snp5.2:4.4": "Sotānaṃ saṃvaraṃ brūmi, ",
  "snp5.2:4.5": "paññāyete pidhiyyare’’. ",
  "snp5.2:5.1": "1042. ‘‘Paññā ceva sati yañca , ",
  "snp5.2:5.2": "(iccāyasmā ajito) ",
  "snp5.2:5.3": "Nāmarūpañca mārisa; ",
  "snp5.2:5.4": "Etaṃ me puṭṭho pabrūhi, ",
  "snp5.2:5.5": "katthetaṃ uparujjhati’’. ",
  "snp5.2:6.1": "1043. ‘‘Yametaṃ pañhaṃ apucchi, ",
  "snp5.2:6.2": "ajita taṃ vadāmi te; ",
  "snp5.2:6.3": "Yattha nāmañca rūpañca, ",
  "snp5.2:6.4": "asesaṃ uparujjhati; ",
  "snp5.2:6.5": "Viññāṇassa nirodhena, ",
  "snp5.2:6.6": "etthetaṃ uparujjhati’’. ",
  "snp5.2:7.1": "1044. ‘‘Ye ca saṅkhātadhammāse, ",
  "snp5.2:7.2": "ye ca sekhā puthū idha; ",
  "snp5.2:7.3": "Tesaṃ me nipako iriyaṃ, ",
  "snp5.2:7.4": "puṭṭho pabrūhi mārisa’’. ",
  "snp5.2:8.1": "1045. ‘‘Kāmesu nābhigijjheyya, ",
  "snp5.2:8.2": "manasānāvilo siyā; ",
  "snp5.2:8.3": "Kusalo sabbadhammānaṃ, ",
  "snp5.2:8.4": "sato bhikkhu paribbaje’’ti. ",
  "snp5.2:8.5": "Ajitamāṇavapucchā paṭhamā niṭṭhitā. "
}
