{
  "snp5.10:0.1": "",
  "snp5.10:0.2": "1094. 9. Todeyyamāṇavapucchā ",
  "snp5.10:1.1": "‘‘Yasmiṃ kāmā na vasanti, ",
  "snp5.10:1.2": "(iccāyasmā todeyyo) ",
  "snp5.10:1.3": "Taṇhā yassa na vijjati; ",
  "snp5.10:1.4": "Kathaṃkathā ca yo tiṇṇo, ",
  "snp5.10:1.5": "vimokkho tassa kīdiso’’. ",
  "snp5.10:2.1": "1095. ‘‘Yasmiṃ kāmā na vasanti, ",
  "snp5.10:2.2": "(todeyyāti bhagavā) ",
  "snp5.10:2.3": "Taṇhā yassa na vijjati; ",
  "snp5.10:2.4": "Kathaṃkathā ca yo tiṇṇo, ",
  "snp5.10:2.5": "vimokkho tassa nāparo’’. ",
  "snp5.10:3.1": "1096. ‘‘Nirāsaso so uda āsasāno, ",
  "snp5.10:3.2": "paññāṇavā so uda paññakappī; ",
  "snp5.10:3.3": "Muniṃ ahaṃ sakka yathā vijaññaṃ, ",
  "snp5.10:3.4": "taṃ me viyācikkha samantacakkhu’’. ",
  "snp5.10:4.1": "1097. ‘‘Nirāsaso so na ca āsasāno, ",
  "snp5.10:4.2": "paññāṇavā so na ca paññakappī; ",
  "snp5.10:4.3": "Evampi todeyya muniṃ vijāna, ",
  "snp5.10:4.4": "akiñcanaṃ kāmabhave asatta’’nti. ",
  "snp5.10:4.5": "Todeyyamāṇavapucchā navamā niṭṭhitā. "
}
