{
  "snp5.13:0.1": "",
  "snp5.13:0.2": "12. Bhadrāvudhamāṇavapucchā 1107. ",
  "snp5.13:1.1": "‘‘Okañjahaṃ taṇhacchidaṃ anejaṃ, ",
  "snp5.13:1.2": "(iccāyasmā bhadrāvudho) ",
  "snp5.13:1.3": "Nandiñjahaṃ oghatiṇṇaṃ vimuttaṃ; ",
  "snp5.13:1.4": "Kappañjahaṃ abhiyāce sumedhaṃ, ",
  "snp5.13:1.5": "sutvāna nāgassa apanamissanti ito. ",
  "snp5.13:2.1": "1108. ‘‘Nānājanā janapadehi saṅgatā, ",
  "snp5.13:2.2": "tava vīra vākyaṃ abhikaṅkhamānā; ",
  "snp5.13:2.3": "Tesaṃ tuvaṃ sādhu viyākarohi, ",
  "snp5.13:2.4": "tathā hi te vidito esa dhammo’’. ",
  "snp5.13:3.1": "1109. ‘‘Ādānataṇhaṃ vinayetha sabbaṃ, ",
  "snp5.13:3.2": "(bhadrāvudhāti bhagavā) ",
  "snp5.13:3.3": "Uddhaṃ adho tiriyañcāpi majjhe; ",
  "snp5.13:3.4": "Yaṃ yañhi lokasmimupādiyanti, ",
  "snp5.13:3.5": "teneva māro anveti jantuṃ. ",
  "snp5.13:4.1": "1110. ‘‘Tasmā pajānaṃ na upādiyetha, ",
  "snp5.13:4.2": "bhikkhu sato kiñcanaṃ sabbaloke; ",
  "snp5.13:4.3": "Ādānasatte iti pekkhamāno, ",
  "snp5.13:4.4": "pajaṃ imaṃ maccudheyye visatta’’nti. ",
  "snp5.13:4.5": "Bhadrāvudhamāṇavapucchā dvādasamā niṭṭhitā. "
}
