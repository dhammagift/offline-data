{
  "snp3.1:0.1": "",
  "snp3.1:0.2": "3. Mahāvaggo 407. 1. Pabbajjāsuttaṃ ",
  "snp3.1:1.1": "Pabbajjaṃ kittayissāmi, ",
  "snp3.1:1.2": "yathā pabbaji cakkhumā; ",
  "snp3.1:1.3": "Yathā vīmaṃsamāno so, ",
  "snp3.1:1.4": "pabbajjaṃ samarocayi. ",
  "snp3.1:2.1": "408. Sambādhoyaṃ gharāvāso, ",
  "snp3.1:2.2": "rajassāyatanaṃ iti; ",
  "snp3.1:2.3": "Abbhokāsova pabbajjā, ",
  "snp3.1:2.4": "iti disvāna pabbaji. ",
  "snp3.1:3.1": "409. Pabbajitvāna kāyena, ",
  "snp3.1:3.2": "pāpakammaṃ vivajjayi; ",
  "snp3.1:3.3": "Vacīduccaritaṃ hitvā, ",
  "snp3.1:3.4": "ājīvaṃ parisodhayi. ",
  "snp3.1:4.1": "410. Agamā rājagahaṃ buddho, ",
  "snp3.1:4.2": "magadhānaṃ giribbajaṃ; ",
  "snp3.1:4.3": "Piṇḍāya abhihāresi, ",
  "snp3.1:4.4": "ākiṇṇavaralakkhaṇo. ",
  "snp3.1:5.1": "411. Tamaddasā bimbisāro, ",
  "snp3.1:5.2": "pāsādasmiṃ patiṭṭhito; ",
  "snp3.1:5.3": "Disvā lakkhaṇasampannaṃ, ",
  "snp3.1:5.4": "imamatthaṃ abhāsatha. ",
  "snp3.1:6.1": "412. ‘‘Imaṃ bhonto nisāmetha, ",
  "snp3.1:6.2": "abhirūpo brahā suci; ",
  "snp3.1:6.3": "Caraṇena ca sampanno, ",
  "snp3.1:6.4": "yugamattañca pekkhati. ",
  "snp3.1:7.1": "413. ‘‘Okkhittacakkhu satimā, ",
  "snp3.1:7.2": "nāyaṃ nīcakulāmiva; ",
  "snp3.1:7.3": "Rājadūtābhidhāvantu, ",
  "snp3.1:7.4": "kuhiṃ bhikkhu gamissati’’. ",
  "snp3.1:8.1": "414. Te pesitā rājadūtā, ",
  "snp3.1:8.2": "piṭṭhito anubandhisuṃ; ",
  "snp3.1:8.3": "Kuhiṃ gamissati bhikkhu, ",
  "snp3.1:8.4": "kattha vāso bhavissati. ",
  "snp3.1:9.1": "415. Sapadānaṃ caramāno, ",
  "snp3.1:9.2": "guttadvāro susaṃvuto; ",
  "snp3.1:9.3": "Khippaṃ pattaṃ apūresi, ",
  "snp3.1:9.4": "sampajāno paṭissato. ",
  "snp3.1:10.1": "416. Piṇḍacāraṃ caritvāna, ",
  "snp3.1:10.2": "nikkhamma nagarā muni; ",
  "snp3.1:10.3": "Paṇḍavaṃ abhihāresi, ",
  "snp3.1:10.4": "ettha vāso bhavissati. ",
  "snp3.1:11.1": "417. Disvāna vāsūpagataṃ, ",
  "snp3.1:11.2": "tayo dūtā upāvisuṃ; ",
  "snp3.1:11.3": "Tesu ekova āgantvā, ",
  "snp3.1:11.4": "rājino paṭivedayi. ",
  "snp3.1:12.1": "418. ‘‘Esa bhikkhu mahārāja, ",
  "snp3.1:12.2": "paṇḍavassa puratthato ; ",
  "snp3.1:12.3": "Nisinno byagghusabhova, ",
  "snp3.1:12.4": "sīhova girigabbhare’’. ",
  "snp3.1:13.1": "419. Sutvāna dūtavacanaṃ, ",
  "snp3.1:13.2": "bhaddayānena khattiyo; ",
  "snp3.1:13.3": "Taramānarūpo niyyāsi, ",
  "snp3.1:13.4": "yena paṇḍavapabbato. ",
  "snp3.1:14.1": "420. Sa yānabhūmiṃ yāyitvā, ",
  "snp3.1:14.2": "yānā oruyha khattiyo; ",
  "snp3.1:14.3": "Pattiko upasaṅkamma, ",
  "snp3.1:14.4": "āsajja naṃ upāvisi. ",
  "snp3.1:15.1": "421. Nisajja rājā sammodi, ",
  "snp3.1:15.2": "kathaṃ sāraṇīyaṃ tato; ",
  "snp3.1:15.3": "Kathaṃ so vītisāretvā, ",
  "snp3.1:15.4": "imamatthaṃ abhāsatha. ",
  "snp3.1:16.1": "422. ‘‘Yuvā ca daharo cāsi, ",
  "snp3.1:16.2": "paṭhamuppattiko susu; ",
  "snp3.1:16.3": "Vaṇṇārohena sampanno, ",
  "snp3.1:16.4": "jātimā viya khattiyo. ",
  "snp3.1:17.1": "423. ‘‘Sobhayanto anīkaggaṃ, ",
  "snp3.1:17.2": "nāgasaṅghapurakkhato; ",
  "snp3.1:17.3": "Dadāmi bhoge bhuñjassu, ",
  "snp3.1:17.4": "jātiṃ akkhāhi pucchito’’. ",
  "snp3.1:18.1": "424. ‘‘Ujuṃ janapado rāja, ",
  "snp3.1:18.2": "himavantassa passato; ",
  "snp3.1:18.3": "Dhanavīriyena sampanno, ",
  "snp3.1:18.4": "kosalesu niketino. ",
  "snp3.1:19.1": "425. ‘‘Ādiccā nāma gottena, ",
  "snp3.1:19.2": "sākiyā nāma jātiyā; ",
  "snp3.1:19.3": "Tamhā kulā pabbajitomhi, ",
  "snp3.1:19.4": "na kāme abhipatthayaṃ. ",
  "snp3.1:20.1": "426. ‘‘Kāmesvādīnavaṃ disvā, ",
  "snp3.1:20.2": "nekkhammaṃ daṭṭhu khemato; ",
  "snp3.1:20.3": "Padhānāya gamissāmi, ",
  "snp3.1:20.4": "ettha me rañjatī mano’’ti. ",
  "snp3.1:20.5": "Pabbajjāsuttaṃ paṭhamaṃ niṭṭhitaṃ. "
}
