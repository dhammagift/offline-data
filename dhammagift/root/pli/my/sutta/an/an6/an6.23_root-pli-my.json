  "an6.23:0.1": "",
  "an6.23:0.2": "",
  "an6.23:0.3": "3. Bhayasuttaṃ ",
  "an6.23:1.1": "‘‘‘Bhaya’nti, bhikkhave, kāmānametaṃ adhivacanaṃ; ",
  "an6.23:1.2": "‘dukkha’nti, bhikkhave, kāmānametaṃ adhivacanaṃ; ",
  "an6.23:1.3": "‘rogo’ti, bhikkhave, kāmānametaṃ adhivacanaṃ; ",
  "an6.23:1.4": "‘gaṇḍo’ti, bhikkhave, kāmānametaṃ adhivacanaṃ; ",
  "an6.23:1.5": "‘saṅgo’ti, bhikkhave, kāmānametaṃ adhivacanaṃ; ",
  "an6.23:1.6": "‘paṅko’ti, bhikkhave, kāmānametaṃ adhivacanaṃ. ",
  "an6.23:2.1": "‘‘Kasmā ca, bhikkhave, ‘bhaya’nti kāmānametaṃ adhivacanaṃ? ",
  "an6.23:2.2": "Kāmarāgarattāyaṃ, bhikkhave, chandarāgavinibaddho diṭṭhadhammikāpi bhayā na parimuccati, samparāyikāpi bhayā na parimuccati, tasmā ‘bhaya’nti kāmānametaṃ adhivacanaṃ. ",
  "an6.23:2.3": "Kasmā ca, bhikkhave, dukkhanti…pe… ",
  "an6.23:2.4": "rogoti… ",
  "an6.23:2.5": "gaṇḍoti… ",
  "an6.23:2.6": "saṅgoti… ",
  "an6.23:2.7": "paṅkoti kāmānametaṃ adhivacanaṃ? ",
  "an6.23:2.8": "Kāmarāgarattāyaṃ, bhikkhave, chandarāgavinibaddho diṭṭhadhammikāpi paṅkā na parimuccati, samparāyikāpi paṅkā na parimuccati, tasmā ‘paṅko’ti kāmānametaṃ adhivacana’’nti. ",
  "an6.23:3.1": "‘‘Bhayaṃ dukkhaṃ rogo gaṇḍo, ",
  "an6.23:3.2": "saṅgo paṅko ca ubhayaṃ; ",
  "an6.23:3.3": "Ete kāmā pavuccanti, ",
  "an6.23:3.4": "yattha satto puthujjano. ",
  "an6.23:4.1": "‘‘Upādāne bhayaṃ disvā, ",
  "an6.23:4.2": "jātimaraṇasambhave; ",
  "an6.23:4.3": "Anupādā vimuccanti, ",
  "an6.23:4.4": "jātimaraṇasaṅkhaye. ",
  "an6.23:5.1": "‘‘Te khemappattā sukhino, ",
  "an6.23:5.2": "diṭṭhadhammābhinibbutā; ",
  "an6.23:5.3": "Sabbaverabhayātītā , ",
  "an6.23:5.4": "sabbadukkhaṃ upaccagu’’nti. ",
  "an6.23:5.5": "tatiyaṃ; "
}
