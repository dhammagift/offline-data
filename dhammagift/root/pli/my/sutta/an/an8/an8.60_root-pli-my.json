  "an8.60:0.1": "",
  "an8.60:0.2": "",
  "an8.60:0.3": "10. Dutiyapuggalasuttaṃ ",
  "an8.60:1.1": "‘‘Aṭṭhime, bhikkhave, puggalā āhuneyyā…pe… anuttaraṃ puññakkhettaṃ lokassa. ",
  "an8.60:1.2": "Katame aṭṭha? ",
  "an8.60:1.3": "Sotāpanno, sotāpattiphalasacchikiriyāya paṭipanno…pe… arahā, arahattāya paṭipanno. ",
  "an8.60:1.4": "Ime kho, bhikkhave, aṭṭha puggalā āhuneyyā…pe… anuttaraṃ puññakkhettaṃ lokassā’’ti. ",
  "an8.60:2.1": "‘‘Cattāro ca paṭipannā, ",
  "an8.60:2.2": "cattāro ca phale ṭhitā; ",
  "an8.60:2.3": "Esa saṅgho samukkaṭṭho, ",
  "an8.60:2.4": "sattānaṃ aṭṭha puggalā. ",
  "an8.60:3.1": "‘‘Yajamānānaṃ manussānaṃ, ",
  "an8.60:3.2": "puññapekkhāna pāṇinaṃ; ",
  "an8.60:3.3": "Karotaṃ opadhikaṃ puññaṃ, ",
  "an8.60:3.4": "ettha dinnaṃ mahapphala’’nti. ",
  "an8.60:3.5": "dasamaṃ; ",
  "an8.60:3.6": "Gotamīvaggo paṭhamo. ",
  "an8.60:4.0": "Tassuddānaṃ – ",
  "an8.60:4.1": "Gotamī ovādaṃ saṃkhittaṃ, ",
  "an8.60:4.2": "dīghajāṇu ca ujjayo; ",
  "an8.60:4.3": "Bhayā dve āhuneyyā ca, ",
  "an8.60:4.4": "dve ca aṭṭha puggalāti. "
}
