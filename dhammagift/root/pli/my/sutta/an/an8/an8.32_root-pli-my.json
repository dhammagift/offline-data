  "an8.32:0.1": "",
  "an8.32:0.2": "",
  "an8.32:0.3": "32. 2. Dutiyadānasuttaṃ ",
  "an8.32:1.1": "‘‘Saddhā hiriyaṃ kusalañca dānaṃ, ",
  "an8.32:1.2": "Dhammā ete sappurisānuyātā; ",
  "an8.32:1.3": "Etañhi maggaṃ diviyaṃ vadanti, ",
  "an8.32:1.4": "Etena hi gacchati devaloka’’nti. ",
  "an8.32:1.5": "dutiyaṃ; "
}
