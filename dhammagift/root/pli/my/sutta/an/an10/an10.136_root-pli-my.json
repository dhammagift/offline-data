  "an10.136:0.2": "",
  "an10.136:0.3": "3. Akusalasuttaṃ ",
  "an10.136:1.1": "‘‘Akusalañca vo, bhikkhave, desessāmi kusalañca. ",
  "an10.136:1.2": "Taṃ suṇātha …pe… ",
  "an10.136:1.3": "katamañca, bhikkhave, akusalaṃ? ",
  "an10.136:1.4": "Micchādiṭṭhi…pe… micchāvimutti – ",
  "an10.136:1.5": "idaṃ vuccati, bhikkhave, akusalaṃ. ",
  "an10.136:1.6": "Katamañca, bhikkhave, kusalaṃ? ",
  "an10.136:1.7": "Sammādiṭṭhi…pe… sammāvimutti – ",
  "an10.136:1.8": "idaṃ vuccati, bhikkhave, kusala’’nti. ",
  "an10.136:1.9": "Tatiyaṃ. "
}
