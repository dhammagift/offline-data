  "an10.195:0.1": "",
  "an10.195:0.2": "",
  "an10.195:0.3": "7. Bhāvetabbadhammasuttaṃ ",
  "an10.195:1.1": "‘‘Bhāvetabbañca vo, bhikkhave, dhammaṃ desessāmi na bhāvetabbañca. ",
  "an10.195:1.2": "Taṃ suṇātha…pe… ",
  "an10.195:1.3": "katamo ca, bhikkhave, na bhāvetabbo dhammo? ",
  "an10.195:1.4": "Pāṇātipāto …pe… ",
  "an10.195:1.5": "micchādiṭṭhi – ",
  "an10.195:1.6": "ayaṃ vuccati, bhikkhave, na bhāvetabbo dhammo. ",
  "an10.195:2.1": "‘‘Katamo ca, bhikkhave, bhāvetabbo dhammo? ",
  "an10.195:2.2": "Pāṇātipātā veramaṇī…pe… ",
  "an10.195:2.3": "sammādiṭṭhi – ",
  "an10.195:2.4": "ayaṃ vuccati, bhikkhave, bhāvetabbo dhammo’’ti. ",
  "an10.195:2.5": "Sattamaṃ. "
}
