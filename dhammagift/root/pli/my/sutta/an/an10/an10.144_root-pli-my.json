  "an10.144:0.2": "",
  "an10.144:0.3": "11. Dukkhavipākasuttaṃ ",
  "an10.144:1.1": "‘‘Dukkhavipākañca vo, bhikkhave, dhammaṃ desessāmi sukhavipākañca. ",
  "an10.144:1.2": "Taṃ suṇātha…pe… ",
  "an10.144:1.3": "katamo ca, bhikkhave, dukkhavipāko dhammo? ",
  "an10.144:1.4": "Micchādiṭṭhi…pe… micchāvimutti – ",
  "an10.144:1.5": "ayaṃ vuccati, bhikkhave, dukkhavipāko dhammo. ",
  "an10.144:1.6": "Katamo ca, bhikkhave, sukhavipāko dhammo? ",
  "an10.144:1.7": "Sammādiṭṭhi…pe… sammāvimutti – ",
  "an10.144:1.8": "ayaṃ vuccati, bhikkhave, sukhavipāko dhammo’’ti. ",
  "an10.144:1.9": "Ekādasamaṃ. ",
  "an10.144:1.10": "Sādhuvaggo catuttho. "
}
