  "an10.147:0.1": "",
  "an10.147:0.2": "",
  "an10.147:0.3": "3. Saddhammasuttaṃ ",
  "an10.147:1.1": "‘‘Saddhammañca vo, bhikkhave, dhammaṃ desessāmi asaddhammañca. ",
  "an10.147:1.2": "Taṃ suṇātha…pe… ",
  "an10.147:1.3": "katamo ca, bhikkhave, asaddhammo? ",
  "an10.147:1.4": "Micchādiṭṭhi…pe… micchāvimutti – ",
  "an10.147:1.5": "ayaṃ vuccati, bhikkhave, asaddhammo. ",
  "an10.147:1.6": "Katamo ca, bhikkhave, saddhammo? ",
  "an10.147:1.7": "Sammādiṭṭhi…pe… sammāvimutti – ",
  "an10.147:1.8": "ayaṃ vuccati, bhikkhave, saddhammo’’ti. ",
  "an10.147:1.9": "Tatiyaṃ. "
}
