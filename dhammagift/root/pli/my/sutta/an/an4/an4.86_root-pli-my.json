  "an4.86:0.1": "",
  "an4.86:0.2": "",
  "an4.86:0.3": "6. Oṇatoṇatasuttaṃ ",
  "an4.86:1.1": "‘‘Cattārome, bhikkhave, puggalā santo saṃvijjamānā lokasmiṃ. ",
  "an4.86:1.2": "Katame cattāro? ",
  "an4.86:1.3": "Oṇatoṇato, ",
  "an4.86:1.4": "oṇatuṇṇato, ",
  "an4.86:1.5": "uṇṇatoṇato, ",
  "an4.86:1.6": "uṇṇatuṇṇato. ",
  "an4.86:1.7": "Ime kho, bhikkhave, cattāro puggalā santo saṃvijjamānā lokasmi’’nti . ",
  "an4.86:1.8": "Chaṭṭhaṃ. "
}
