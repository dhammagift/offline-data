{
  "an4.151:0.1": "4. Catutthapaṇṇāsakaṃ ",
  "an4.151:0.2": "(16) 1. Indriyavaggo ",
  "an4.151:0.3": "1. Indriyasuttaṃ ",
  "an4.151:1.1": "‘‘Cattārimāni, bhikkhave, indriyāni. ",
  "an4.151:1.2": "Katamāni cattāri? ",
  "an4.151:1.3": "Saddhindriyaṃ, vīriyindriyaṃ, satindriyaṃ, samādhindriyaṃ – ",
  "an4.151:1.4": "imāni kho, bhikkhave, cattāri indriyānī’’ti. ",
  "an4.151:1.5": "Paṭhamaṃ. "
}
