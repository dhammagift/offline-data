  "an4.133:0.2": "",
  "an4.133:0.3": "3. Ugghaṭitaññūsuttaṃ ",
  "an4.133:1.1": "‘‘Cattārome, bhikkhave, puggalā santo saṃvijjamānā lokasmiṃ. ",
  "an4.133:1.2": "Katame cattāro? ",
  "an4.133:1.3": "Ugghaṭitaññū, vipañcitaññū, neyyo, padaparamo – ",
  "an4.133:1.4": "ime kho, bhikkhave, cattāro puggalā santo saṃvijjamānā lokasmi’’nti . ",
  "an4.133:1.5": "Tatiyaṃ. "
}
