  "an4.153:0.1": "",
  "an4.153:0.2": "",
  "an4.153:0.3": "3. Paññābalasuttaṃ ",
  "an4.153:1.1": "‘‘Cattārimāni, bhikkhave, balāni. ",
  "an4.153:1.2": "Katamāni cattāri? ",
  "an4.153:1.3": "Paññābalaṃ, vīriyabalaṃ, anavajjabalaṃ, saṅgahabalaṃ – ",
  "an4.153:1.4": "imāni kho, bhikkhave, cattāri balānī’’ti. ",
  "an4.153:1.5": "Tatiyaṃ. "
}
