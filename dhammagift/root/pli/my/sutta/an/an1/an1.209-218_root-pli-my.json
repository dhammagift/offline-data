{
  "an1.209:0.1": "",
  "an1.209:0.2": "3. Tatiyavaggo ",
  "an1.209:1.1": "‘‘Etadaggaṃ, bhikkhave, mama sāvakānaṃ bhikkhūnaṃ sikkhākāmānaṃ yadidaṃ rāhulo’’. … ",
  "an1.210:1.1": "Saddhāpabbajitānaṃ yadidaṃ raṭṭhapālo. … ",
  "an1.211:1.1": "Paṭhamaṃ salākaṃ gaṇhantānaṃ yadidaṃ kuṇḍadhāno. … ",
  "an1.212:1.1": "Paṭibhānavantānaṃ yadidaṃ vaṅgīso. … ",
  "an1.213:1.1": "Samantapāsādikānaṃ yadidaṃ upaseno vaṅgantaputto. … ",
  "an1.214:1.1": "Senāsanapaññāpakānaṃ yadidaṃ dabbo mallaputto. … ",
  "an1.215:1.1": "Devatānaṃ piyamanāpānaṃ yadidaṃ pilindavaccho. … ",
  "an1.216:1.1": "Khippābhiññānaṃ yadidaṃ bāhiyo dārucīriyo. … ",
  "an1.217:1.1": "Cittakathikānaṃ yadidaṃ kumārakassapo. … ",
  "an1.218:1.1": "Paṭisambhidāpattānaṃ yadidaṃ mahākoṭṭhitoti . ",
  "an1.218:1.2": "Vaggo tatiyo. "
}
