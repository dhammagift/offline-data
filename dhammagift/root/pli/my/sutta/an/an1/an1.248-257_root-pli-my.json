{
  "an1.248:0.1": "",
  "an1.248:0.2": "6. Chaṭṭhavaggo ",
  "an1.248:1.1": "‘‘Etadaggaṃ, bhikkhave, mama sāvakānaṃ upāsakānaṃ paṭhamaṃ saraṇaṃ gacchantānaṃ yadidaṃ tapussabhallikā vāṇijā’’. … ",
  "an1.249:1.1": "Dāyakānaṃ yadidaṃ sudatto gahapati anāthapiṇḍiko. … ",
  "an1.250:1.1": "Dhammakathikānaṃ yadidaṃ citto gahapati macchikāsaṇḍiko. … ",
  "an1.251:1.1": "Catūhi saṅgahavatthūhi parisaṃ saṅgaṇhantānaṃ yadidaṃ hatthako āḷavako. … ",
  "an1.252:1.1": "Paṇītadāyakānaṃ yadidaṃ mahānāmo sakko. … ",
  "an1.253:1.1": "Manāpadāyakānaṃ yadidaṃ uggo gahapati vesāliko. … ",
  "an1.254:1.1": "Saṅghupaṭṭhākānaṃ yadidaṃ hatthigāmako uggato gahapati. … ",
  "an1.255:1.1": "Aveccappasannānaṃ yadidaṃ sūrambaṭṭho . … ",
  "an1.256:1.1": "Puggalappasannānaṃ yadidaṃ jīvako komārabhacco. … ",
  "an1.257:1.1": "Vissāsakānaṃ yadidaṃ nakulapitā gahapatīti. ",
  "an1.257:1.2": "Vaggo chaṭṭho. "
}
