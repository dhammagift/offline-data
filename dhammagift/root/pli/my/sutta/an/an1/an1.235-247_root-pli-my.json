{
  "an1.235:0.1": "",
  "an1.235:0.2": "5. Pañcamavaggo ",
  "an1.235:1.1": "‘‘Etadaggaṃ, bhikkhave, mama sāvikānaṃ bhikkhunīnaṃ rattaññūnaṃ yadidaṃ mahāpajāpatigotamī’’. … ",
  "an1.236:1.1": "Mahāpaññānaṃ yadidaṃ khemā. … ",
  "an1.237:1.1": "Iddhimantīnaṃ yadidaṃ uppalavaṇṇā. … ",
  "an1.238:1.1": "Vinayadharānaṃ yadidaṃ paṭācārā. … ",
  "an1.239:1.1": "Dhammakathikānaṃ yadidaṃ dhammadinnā. … ",
  "an1.240:1.1": "Jhāyīnaṃ yadidaṃ nandā. … ",
  "an1.241:1.1": "Āraddhavīriyānaṃ yadidaṃ soṇā. … ",
  "an1.242:1.1": "Dibbacakkhukānaṃ yadidaṃ bakulā . … ",
  "an1.243:1.1": "Khippābhiññānaṃ yadidaṃ bhaddā kuṇḍalakesā. … ",
  "an1.244:1.1": "Pubbenivāsaṃ anussarantīnaṃ yadidaṃ bhaddā kāpilānī. … Mahābhiññappattānaṃ ",
  "an1.245:1.1": "yadidaṃ bhaddakaccānā. … ",
  "an1.246:1.1": "Lūkhacīvaradharānaṃ yadidaṃ kisāgotamī. … ",
  "an1.247:1.1": "Saddhādhimuttānaṃ yadidaṃ siṅgālakamātāti . ",
  "an1.247:1.2": "Vaggo pañcamo. "
}
