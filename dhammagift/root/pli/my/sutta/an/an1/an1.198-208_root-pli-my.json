{
  "an1.198:0.1": "",
  "an1.198:0.2": "2. Dutiyavaggo ",
  "an1.198:1.1": "‘‘Etadaggaṃ, bhikkhave, mama sāvakānaṃ bhikkhūnaṃ manomayaṃ kāyaṃ abhinimminantānaṃ yadidaṃ cūḷapanthako’’ . … ",
  "an1.199:1.1": "Cetovivaṭṭakusalānaṃ yadidaṃ cūḷapanthako. … ",
  "an1.200:1.1": "Saññāvivaṭṭakusalānaṃ yadidaṃ mahāpanthako. … ",
  "an1.201:1.1": "Araṇavihārīnaṃ yadidaṃ subhūti. … ",
  "an1.202:1.1": "Dakkhiṇeyyānaṃ yadidaṃ subhūti. … ",
  "an1.203:1.1": "Āraññakānaṃ yadidaṃ revato khadiravaniyo. … ",
  "an1.204:1.1": "Jhāyīnaṃ yadidaṃ kaṅkhārevato. … ",
  "an1.205:1.1": "Āraddhavīriyānaṃ yadidaṃ soṇo koḷiviso. … ",
  "an1.206:1.1": "Kalyāṇavākkaraṇānaṃ yadidaṃ soṇo kuṭikaṇṇo. … ",
  "an1.207:1.1": "Lābhīnaṃ yadidaṃ sīvali. … ",
  "an1.208:1.1": "Saddhādhimuttānaṃ yadidaṃ vakkalīti. ",
  "an1.208:1.2": "Vaggo dutiyo. "
}
