{
  "an1.258:0.1": "",
  "an1.258:0.2": "7. Sattamavaggo ",
  "an1.258:1.1": "‘‘Etadaggaṃ, bhikkhave, mama sāvikānaṃ upāsikānaṃ paṭhamaṃ saraṇaṃ gacchantīnaṃ yadidaṃ sujātā seniyadhītā’’ . … ",
  "an1.259:1.1": "Dāyikānaṃ yadidaṃ visākhā migāramātā. … ",
  "an1.260:1.1": "Bahussutānaṃ yadidaṃ khujjuttarā. … ",
  "an1.261:1.1": "Mettāvihārīnaṃ yadidaṃ sāmāvatī. … ",
  "an1.262:1.1": "Jhāyīnaṃ yadidaṃ uttarānandamātā. … ",
  "an1.263:1.1": "Paṇītadāyikānaṃ yadidaṃ suppavāsā koliyadhītā. … ",
  "an1.264:1.1": "Gilānupaṭṭhākīnaṃ yadidaṃ suppiyā upāsikā. … ",
  "an1.265:1.1": "Aveccappasannānaṃ yadidaṃ kātiyānī. … ",
  "an1.266:1.1": "Vissāsikānaṃ yadidaṃ nakulamātā gahapatānī. … ",
  "an1.267:1.1": "Anussavappasannānaṃ yadidaṃ kāḷī upāsikā kulagharikā ti. ",
  "an1.267:1.2": "Vaggo sattamo. ",
  "an1.267:1.3": "Etadaggavaggo cuddasamo. "
}
