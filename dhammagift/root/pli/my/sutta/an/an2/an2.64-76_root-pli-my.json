  "an2.64:0.1": "",
  "an2.64:0.2": "(7) 2. Sukhavaggo ",
  "an2.64:1.0": "65. ",
  "an2.64:1.1": "‘‘Dvemāni, bhikkhave, sukhāni. ",
  "an2.64:1.2": "Katamāni dve? ",
  "an2.64:1.3": "Gihisukhañca pabbajitasukhañca. ",
  "an2.64:1.4": "Imāni kho, bhikkhave, dve sukhāni. ",
  "an2.64:1.5": "Etadaggaṃ, bhikkhave, imesaṃ dvinnaṃ sukhānaṃ yadidaṃ pabbajitasukha’’nti. ",
  "an2.65:1.0": "66. ",
  "an2.65:1.1": "‘‘Dvemāni, bhikkhave, sukhāni. ",
  "an2.65:1.2": "Katamāni dve? ",
  "an2.65:1.3": "Kāmasukhañca nekkhammasukhañca. ",
  "an2.65:1.4": "Imāni kho, bhikkhave, dve sukhāni. ",
  "an2.65:1.5": "Etadaggaṃ, bhikkhave, imesaṃ dvinnaṃ sukhānaṃ yadidaṃ nekkhammasukha’’nti. ",
  "an2.66:1.0": "67. ",
  "an2.66:1.1": "‘‘Dvemāni, bhikkhave, sukhāni. ",
  "an2.66:1.2": "Katamāni dve? ",
  "an2.66:1.3": "Upadhisukhañca nirupadhisukhañca. ",
  "an2.66:1.4": "Imāni kho, bhikkhave, dve sukhāni. ",
  "an2.66:1.5": "Etadaggaṃ, bhikkhave, imesaṃ dvinnaṃ sukhānaṃ yadidaṃ nirupadhisukha’’nti. ",
  "an2.67:1.0": "68. ",
  "an2.67:1.1": "‘‘Dvemāni, bhikkhave, sukhāni. ",
  "an2.67:1.2": "Katamāni dve? ",
  "an2.67:1.3": "Sāsavasukhañca anāsavasukhañca. ",
  "an2.67:1.4": "Imāni kho, bhikkhave, dve sukhāni. ",
  "an2.67:1.5": "Etadaggaṃ, bhikkhave, imesaṃ dvinnaṃ sukhānaṃ yadidaṃ anāsavasukha’’nti. ",
  "an2.68:1.0": "69. ",
  "an2.68:1.1": "‘‘Dvemāni, bhikkhave, sukhāni. ",
  "an2.68:1.2": "Katamāni dve? ",
  "an2.68:1.3": "Sāmisañca sukhaṃ nirāmisañca sukhaṃ. ",
  "an2.68:1.4": "Imāni kho, bhikkhave, dve sukhāni. ",
  "an2.68:1.5": "Etadaggaṃ, bhikkhave, imesaṃ dvinnaṃ sukhānaṃ yadidaṃ nirāmisaṃ sukha’’nti. ",
  "an2.69:1.0": "70. ",
  "an2.69:1.1": "‘‘Dvemāni, bhikkhave, sukhāni. ",
  "an2.69:1.2": "Katamāni dve? ",
  "an2.69:1.3": "Ariyasukhañca anariyasukhañca. ",
  "an2.69:1.4": "Imāni kho, bhikkhave, dve sukhāni. ",
  "an2.69:1.5": "Etadaggaṃ, bhikkhave, imesaṃ dvinnaṃ sukhānaṃ yadidaṃ ariyasukha’’nti. ",
  "an2.70:1.0": "71. ",
  "an2.70:1.1": "‘‘Dvemāni, bhikkhave, sukhāni. ",
  "an2.70:1.2": "Katamāni dve? ",
  "an2.70:1.3": "Kāyikañca sukhaṃ cetasikañca sukhaṃ. ",
  "an2.70:1.4": "Imāni kho, bhikkhave, dve sukhāni. ",
  "an2.70:1.5": "Etadaggaṃ, bhikkhave, imesaṃ dvinnaṃ sukhānaṃ yadidaṃ cetasikaṃ sukha’’nti. ",
  "an2.71:1.0": "72. ",
  "an2.71:1.1": "‘‘Dvemāni, bhikkhave, sukhāni. ",
  "an2.71:1.2": "Katamāni dve? ",
  "an2.71:1.3": "Sappītikañca sukhaṃ nippītikañca sukhaṃ. ",
  "an2.71:1.4": "Imāni kho, bhikkhave, dve sukhāni. ",
  "an2.71:1.5": "Etadaggaṃ, bhikkhave, imesaṃ dvinnaṃ sukhānaṃ yadidaṃ nippītikaṃ sukha’’nti. ",
  "an2.72:1.0": "73. ",
  "an2.72:1.1": "‘‘Dvemāni, bhikkhave, sukhāni. ",
  "an2.72:1.2": "Katamāni dve? ",
  "an2.72:1.3": "Sātasukhañca upekkhāsukhañca. ",
  "an2.72:1.4": "Imāni kho, bhikkhave, dve sukhāni. ",
  "an2.72:1.5": "Etadaggaṃ, bhikkhave, imesaṃ dvinnaṃ sukhānaṃ yadidaṃ upekkhāsukha’’nti. ",
  "an2.73:1.0": "74. ",
  "an2.73:1.1": "‘‘Dvemāni, bhikkhave, sukhāni. ",
  "an2.73:1.2": "Katamāni dve? ",
  "an2.73:1.3": "Samādhisukhañca asamādhisukhañca. ",
  "an2.73:1.4": "Imāni kho, bhikkhave, dve sukhāni. ",
  "an2.73:1.5": "Etadaggaṃ, bhikkhave, imesaṃ dvinnaṃ sukhānaṃ yadidaṃ samādhisukha’’nti. ",
  "an2.74:1.0": "75. ",
  "an2.74:1.1": "‘‘Dvemāni, bhikkhave, sukhāni. ",
  "an2.74:1.2": "Katamāni dve? ",
  "an2.74:1.3": "Sappītikārammaṇañca sukhaṃ nippītikārammaṇañca sukhaṃ. ",
  "an2.74:1.4": "Imāni kho, bhikkhave, dve sukhāni. ",
  "an2.74:1.5": "Etadaggaṃ, bhikkhave, imesaṃ dvinnaṃ sukhānaṃ yadidaṃ nippītikārammaṇaṃ sukha’’nti. ",
  "an2.75:1.0": "76. ",
  "an2.75:1.1": "‘‘Dvemāni, bhikkhave, sukhāni. ",
  "an2.75:1.2": "Katamāni dve? ",
  "an2.75:1.3": "Sātārammaṇañca sukhaṃ upekkhārammaṇañca sukhaṃ. ",
  "an2.75:1.4": "Imāni kho, bhikkhave, dve sukhāni. ",
  "an2.75:1.5": "Etadaggaṃ, bhikkhave, imesaṃ dvinnaṃ sukhānaṃ yadidaṃ upekkhārammaṇaṃ sukha’’nti. ",
  "an2.76:1.0": "77. ",
  "an2.76:1.1": "‘‘Dvemāni, bhikkhave, sukhāni. ",
  "an2.76:1.2": "Katamāni dve? ",
  "an2.76:1.3": "Rūpārammaṇañca sukhaṃ arūpārammaṇañca sukhaṃ. ",
  "an2.76:1.4": "Imāni kho, bhikkhave, dve sukhāni. ",
  "an2.76:1.5": "Etadaggaṃ, bhikkhave, imesaṃ dvinnaṃ sukhānaṃ yadidaṃ arūpārammaṇaṃ sukha’’nti. ",
  "an2.76:1.6": "Sukhavaggo dutiyo. "
}
