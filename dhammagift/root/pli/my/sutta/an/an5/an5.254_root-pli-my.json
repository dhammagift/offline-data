  "an5.254:0.1": "",
  "an5.254:0.2": "",
  "an5.254:0.3": "4. Pañcamacchariyasuttaṃ ",
  "an5.254:1.1": "‘‘Pañcimāni, bhikkhave, macchariyāni. ",
  "an5.254:1.2": "Katamāni pañca? ",
  "an5.254:1.3": "Āvāsamacchariyaṃ, kulamacchariyaṃ, lābhamacchariyaṃ, vaṇṇamacchariyaṃ, dhammamacchariyaṃ – ",
  "an5.254:1.4": "imāni kho, bhikkhave, pañca macchariyāni. ",
  "an5.254:1.5": "Imesaṃ kho, bhikkhave, pañcannaṃ macchariyānaṃ etaṃ paṭikuṭṭhaṃ , yadidaṃ dhammamacchariya’’nti. ",
  "an5.254:1.6": "Catutthaṃ. "
}
