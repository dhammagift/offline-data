  "an5.182:0.1": "",
  "an5.182:0.2": "",
  "an5.182:0.3": "2. Cīvarasuttaṃ ",
  "an5.182:1.1": "‘‘Pañcime, bhikkhave, paṃsukūlikā. ",
  "an5.182:1.2": "Katame pañca? ",
  "an5.182:1.3": "Mandattā momūhattā paṃsukūliko hoti…pe… idamatthitaṃyeva nissāya paṃsukūliko hoti. ",
  "an5.182:1.4": "Ime kho, bhikkhave, pañca paṃsukūlikā’’ti. ",
  "an5.182:1.5": "Dutiyaṃ. "
}
