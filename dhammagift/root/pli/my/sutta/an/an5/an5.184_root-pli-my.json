  "an5.184:0.1": "",
  "an5.184:0.2": "",
  "an5.184:0.3": "4. Sosānikasuttaṃ ",
  "an5.184:1.1": "‘‘Pañcime, bhikkhave, sosānikā. ",
  "an5.184:1.2": "Katame pañca? ",
  "an5.184:1.3": "Mandattā momūhattā sosāniko hoti…pe… idamatthitaṃyeva nissāya sosāniko hoti. ",
  "an5.184:1.4": "Ime kho, bhikkhave, pañca sosānikā’’ti. ",
  "an5.184:1.5": "Catutthaṃ. "
}
