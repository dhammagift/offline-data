  "an7.36:0.2": "",
  "an7.36:0.3": "5. Paṭhamamittasuttaṃ ",
  "an7.36:1.1": "‘‘Sattahi, bhikkhave, aṅgehi samannāgato mitto sevitabbo. ",
  "an7.36:1.2": "Katamehi sattahi? ",
  "an7.36:1.3": "Duddadaṃ dadāti, dukkaraṃ karoti, dukkhamaṃ khamati, guyhamassa āvi karoti, guyhamassa pariguhati , āpadāsu na jahati, khīṇena nātimaññati. ",
  "an7.36:1.4": "Imehi kho, bhikkhave, sattahi aṅgehi samannāgato mitto sevitabbo’’ti. ",
  "an7.36:2.1": "‘‘Duddadaṃ dadāti mitto, ",
  "an7.36:2.2": "dukkarañcāpi kubbati; ",
  "an7.36:2.3": "Athopissa duruttāni, ",
  "an7.36:2.4": "khamati dukkhamāni ca . ",
  "an7.36:3.1": "‘‘Guyhañca tassa akkhāti, ",
  "an7.36:3.2": "guyhassa parigūhati; ",
  "an7.36:3.3": "Āpadāsu na jahāti, ",
  "an7.36:3.4": "khīṇena nātimaññati. ",
  "an7.36:4.1": "‘‘Yamhi etāni ṭhānāni, ",
  "an7.36:4.2": "saṃvijjantīdha puggale; ",
  "an7.36:4.3": "So mitto mittakāmena, ",
  "an7.36:4.4": "bhajitabbo tathāvidho’’ti. ",
  "an7.36:4.5": "pañcamaṃ; "
}
