{
  "ya6.1.1:0.1": "Abhidhammapiṭake Yamakapāḷi (dutiyo bhāgo) 6. Saṅkhārayamakaṃ ",
  "ya6.1.1:0.2": "",
  "ya6.1.1:0.3": "1. Paṇṇattivāro (Ka) uddeso ",
  "ya6.1.1:1.1": "Namo tassa bhagavato arahato sammāsambuddhassa ",
  "ya6.1.1:2.1": "Tayo saṅkhārā – kāyasaṅkhāro, vacīsaṅkhāro, cittasaṅkhāroti. Assāsapassāsā kāyasaṅkhāro, vitakkavicārā vacīsaṅkhāro, saññā ca vedanā ca cittasaṅkhāro. Ṭhapetvā vitakkavicāre sabbepi cittasampayuttakā dhammā cittasaṅkhāro. ",
  "ya6.1.1:3.0.1": "1. Padasodhanavāro (Ka) anulomaṃ ",
  "ya6.1.1:3.0.2": "(Ka) ",
  "ya6.1.1:3.1": "kāyo kāyasaṅkhāro? (Kha) ",
  "ya6.1.1:4.1": "kāyasaṅkhāro kāyo? (Ka) ",
  "ya6.1.1:5.1": "vacī vacīsaṅkhāro? (Kha) ",
  "ya6.1.1:6.1": "vacīsaṅkhāro vacī? (Ka) ",
  "ya6.1.1:7.1": "cittaṃ cittasaṅkhāro? (Kha) ",
  "ya6.1.1:8.1": "cittasaṅkhāro cittaṃ? (Kha) paccanīkaṃ (Ka) ",
  "ya6.1.1:9.0": "",
  "ya6.1.1:9.1": "na kāyo na kāyasaṅkhāro? (Kha) ",
  "ya6.1.1:10.1": "na kāyasaṅkhāro na kāyo? (Ka) ",
  "ya6.1.1:11.1": "na vacī na vacīsaṅkhāro? (Kha) ",
  "ya6.1.1:12.1": "na vacīsaṅkhāro na vacī? (Ka) ",
  "ya6.1.1:13.1": "na cittaṃ na cittasaṅkhāro? (Kha) ",
  "ya6.1.1:14.1": "na cittasaṅkhāro na cittaṃ? ",
  "ya6.1.1:15.0.1": "2. Padasodhanamūlacakkavāro (Ka) anulomaṃ ",
  "ya6.1.1:15.0.2": "(Ka) ",
  "ya6.1.1:15.1": "kāyo kāyasaṅkhāro? (Kha) ",
  "ya6.1.1:16.1": "saṅkhārā vacīsaṅkhāro? (Ka) ",
  "ya6.1.1:17.1": "kāyo kāyasaṅkhāro? (Kha) ",
  "ya6.1.1:18.1": "saṅkhārā cittasaṅkhāro? (Ka) ",
  "ya6.1.1:19.1": "vacī vacīsaṅkhāro? (Kha) ",
  "ya6.1.1:20.1": "saṅkhārā kāyasaṅkhāro? (Ka) ",
  "ya6.1.1:21.1": "vacī vacīsaṅkhāro? (Kha) ",
  "ya6.1.1:22.1": "saṅkhārā cittasaṅkhāro? (Ka) ",
  "ya6.1.1:23.1": "cittaṃ cittasaṅkhāro? (Kha) ",
  "ya6.1.1:24.1": "saṅkhārā kāyasaṅkhāro? (Ka) ",
  "ya6.1.1:25.1": "cittaṃ cittasaṅkhāro? (Kha) ",
  "ya6.1.1:26.1": "saṅkhārā vacīsaṅkhāro? (Kha) paccanīkaṃ (Ka) ",
  "ya6.1.1:27.0": "",
  "ya6.1.1:27.1": "na kāyo na kāyasaṅkhāro? (Kha) ",
  "ya6.1.1:28.1": "na saṅkhārā na vacīsaṅkhāro? (Ka) ",
  "ya6.1.1:29.1": "na kāyo na kāyasaṅkhāro? (Kha) ",
  "ya6.1.1:30.1": "na saṅkhārā na cittasaṅkhāro? (Ka) ",
  "ya6.1.1:31.1": "na vacī na vacīsaṅkhāro? (Kha) ",
  "ya6.1.1:32.1": "na saṅkhārā na kāyasaṅkhāro? (Ka) ",
  "ya6.1.1:33.1": "na vacī na vacīsaṅkhāro? (Kha) ",
  "ya6.1.1:34.1": "na saṅkhārā na cittasaṅkhāro? (Ka) ",
  "ya6.1.1:35.1": "na cittaṃ na cittasaṅkhāro? (Kha) ",
  "ya6.1.1:36.1": "na saṅkhārā na kāyasaṅkhāro? (Ka) ",
  "ya6.1.1:37.1": "na cittaṃ na cittasaṅkhāro? (Kha) ",
  "ya6.1.1:38.1": "na saṅkhārā na vacīsaṅkhāro? ",
  "ya6.1.1:39.0.1": "3. Suddhasaṅkhāravāro (Ka) anulomaṃ ",
  "ya6.1.1:39.0.2": "(Ka) ",
  "ya6.1.1:39.1": "kāyasaṅkhāro vacīsaṅkhāro? (Kha) ",
  "ya6.1.1:40.1": "vacīsaṅkhāro kāyasaṅkhāro? (Ka) ",
  "ya6.1.1:41.1": "kāyasaṅkhāro cittasaṅkhāro? (Kha) ",
  "ya6.1.1:42.1": "cittasaṅkhāro kāyasaṅkhāro? (Ka) ",
  "ya6.1.1:43.1": "vacīsaṅkhāro cittasaṅkhāro? (Kha) ",
  "ya6.1.1:44.1": "cittasaṅkhāro vacīsaṅkhāro? ",
  "ya6.1.1:45.0": "(Kha) paccanīkaṃ (Ka) ",
  "ya6.1.1:45.1": "na kāyasaṅkhāro na vacīsaṅkhāro? (Kha) ",
  "ya6.1.1:46.1": "na vacīsaṅkhāro na kāyasaṅkhāro? (Ka) ",
  "ya6.1.1:47.1": "na kāyasaṅkhāro na cittasaṅkhāro? (Kha) ",
  "ya6.1.1:48.1": "na cittasaṅkhāro na kāyasaṅkhāro? (Ka) ",
  "ya6.1.1:49.1": "na vacīsaṅkhāro na cittasaṅkhāro? (Kha) ",
  "ya6.1.1:50.1": "na cittasaṅkhāro na vacīsaṅkhāro? ",
  "ya6.1.1:51.1": "Paṇṇattiuddesavāro. Paṇṇattivāro. "
}
