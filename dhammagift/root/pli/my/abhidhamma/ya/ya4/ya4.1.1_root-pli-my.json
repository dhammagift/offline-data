{
  "ya4.1.1:0.1": "4. Dhātuyamakaṃ ",
  "ya4.1.1:0.2": "",
  "ya4.1.1:0.3": "1. Paṇṇattivāro (Ka) uddeso ",
  "ya4.1.1:1.1": "Namo tassa bhagavato arahato sammāsambuddhassa ",
  "ya4.1.1:2.1": "Aṭṭhārasa dhātuyo – cakkhudhātu, sotadhātu, ghānadhātu, jivhādhātu, kāyadhātu, rūpadhātu, saddadhātu, gandhadhātu, rasadhātu, phoṭṭhabbadhātu, cakkhuviññāṇadhātu, sotaviññāṇadhātu, ghānaviññāṇadhātu, jivhāviññāṇadhātu, kāyaviññāṇadhātu, manodhātu, manoviññāṇadhātu, dhammadhātu. ",
  "ya4.1.1:3.0.1": "1. Padasodhanavāro (Ka) anulomaṃ ",
  "ya4.1.1:3.0.2": "(Ka) ",
  "ya4.1.1:3.1": "cakkhu cakkhudhātu? (Kha) ",
  "ya4.1.1:4.1": "cakkhudhātu cakkhu? (Ka) ",
  "ya4.1.1:5.1": "sotaṃ sotadhātu? (Kha) ",
  "ya4.1.1:6.1": "sotadhātu sotaṃ?…Pe… (Ka) ",
  "ya4.1.1:7.1": "cakkhuviññāṇaṃ cakkhuviññāṇadhātu? (Kha) ",
  "ya4.1.1:8.1": "cakkhuviññāṇadhātu cakkhuviññāṇaṃ?…Pe… (Ka) ",
  "ya4.1.1:9.1": "mano manodhātu? (Kha) ",
  "ya4.1.1:10.1": "manodhātu mano? (Ka) ",
  "ya4.1.1:11.1": "manoviññāṇaṃ manoviññāṇadhātu? (Kha) ",
  "ya4.1.1:12.1": "manoviññāṇadhātu manoviññāṇaṃ? (Ka) ",
  "ya4.1.1:13.1": "dhammo dhammadhātu? (Kha) ",
  "ya4.1.1:14.1": "dhammadhātu dhammo? ",
  "ya4.1.1:15.0": "(Kha) paccanīkaṃ (Ka) ",
  "ya4.1.1:15.1": "na cakkhu na cakkhudhātu? (Kha) ",
  "ya4.1.1:16.1": "na cakkhudhātu na cakkhu? (Ka) ",
  "ya4.1.1:17.1": "na sotaṃ na sotadhātu? (Kha) ",
  "ya4.1.1:18.1": "na sotadhātu na sotaṃ?…Pe… (Ka) ",
  "ya4.1.1:19.1": "na cakkhuviññāṇaṃ na cakkhuviññāṇadhātu? (Kha) ",
  "ya4.1.1:20.1": "na cakkhuviññāṇadhātu na cakkhuviññāṇaṃ?…Pe… (Ka) ",
  "ya4.1.1:21.1": "na mano na manodhātu? (Kha) ",
  "ya4.1.1:22.1": "na manodhātu na mano? (Ka) ",
  "ya4.1.1:23.1": "na manoviññāṇaṃ na manoviññāṇadhātu? (Kha) ",
  "ya4.1.1:24.1": "na manoviññāṇadhātu na manoviññāṇaṃ? (Ka) ",
  "ya4.1.1:25.1": "na dhammo na dhammadhātu? (Kha) ",
  "ya4.1.1:26.1": "na dhammadhātu na dhammo? ",
  "ya4.1.1:27.0.1": "2. Padasodhanamūlacakkavāro (Ka) anulomaṃ ",
  "ya4.1.1:27.0.2": "(Ka) ",
  "ya4.1.1:27.1": "cakkhu cakkhudhātu? (Kha) ",
  "ya4.1.1:28.1": "dhātū sotadhātu?…Pe… (Ka) ",
  "ya4.1.1:29.1": "cakkhu cakkhudhātu? (Kha) ",
  "ya4.1.1:30.1": "dhātū dhammadhātu? ",
  "ya4.1.1:31.1": "(Yathā āyatanayamake cakkaṃ bandhitaṃ evamidha cakkaṃ bandhitabbaṃ.) ",
  "ya4.1.1:32.0": "(Kha) paccanīkaṃ (Ka) ",
  "ya4.1.1:32.1": "na cakkhu na cakkhudhātu? (Kha) ",
  "ya4.1.1:33.1": "na dhātū na sotadhātu? (Ka) ",
  "ya4.1.1:34.1": "na cakkhu na cakkhudhātu? (Kha) ",
  "ya4.1.1:35.1": "na dhātū na ghānadhātu?…Pe… (Ka) ",
  "ya4.1.1:36.1": "na cakkhu na cakkhudhātu? (Kha) ",
  "ya4.1.1:37.1": "na dhātū na dhammadhātu?…Pe… (Ka) ",
  "ya4.1.1:38.1": "na dhammo na dhammadhātu? (Kha) ",
  "ya4.1.1:39.1": "na dhātū na cakkhudhātu?…Pe… (Ka) ",
  "ya4.1.1:40.1": "na dhammo na dhammadhātu? (Kha) ",
  "ya4.1.1:41.1": "na dhātū na manoviññāṇadhātu? ",
  "ya4.1.1:42.1": "(Cakkaṃ bandhitabbaṃ). ",
  "ya4.1.1:43.0.1": "3. Suddhadhātuvāro (Ka) anulomaṃ ",
  "ya4.1.1:43.0.2": "(Ka) ",
  "ya4.1.1:43.1": "cakkhu dhātu? (Kha) ",
  "ya4.1.1:44.1": "dhātū cakkhu? (Ka) ",
  "ya4.1.1:45.1": "sotaṃ dhātu? (Kha) ",
  "ya4.1.1:46.1": "dhātū sotaṃ? ",
  "ya4.1.1:47.1": "Ghānaṃ dhātu?…Pe… jivhā dhātu?… Kāyo dhātu?… Rūpaṃ dhātu?… Saddo dhātu?… Gandho dhātu?… Raso dhātu?… Phoṭṭhabbo dhātu?… (Ka) ",
  "ya4.1.1:48.1": "cakkhuviññāṇaṃ dhātu? (Kha) ",
  "ya4.1.1:49.1": "dhātū cakkhuviññāṇaṃ? (Ka) ",
  "ya4.1.1:50.1": "sotaviññāṇaṃ dhātu? (Kha) ",
  "ya4.1.1:51.1": "dhātū sotaviññāṇaṃ? … ",
  "ya4.1.1:52.1": "Ghānaviññāṇaṃ?…Pe… jivhāviññāṇaṃ?… Kāyaviññāṇaṃ? (Ka) ",
  "ya4.1.1:53.1": "mano dhātu? (Kha) ",
  "ya4.1.1:54.1": "dhātū mano? (Ka) ",
  "ya4.1.1:55.1": "manoviññāṇaṃ dhātu? (Kha) ",
  "ya4.1.1:56.1": "dhātū manoviññāṇaṃ? (Ka) ",
  "ya4.1.1:57.1": "dhammo dhātu? (Kha) ",
  "ya4.1.1:58.1": "dhātū dhammo? ",
  "ya4.1.1:59.0": "(Kha) paccanīkaṃ (Ka) ",
  "ya4.1.1:59.1": "na cakkhu na dhātu? (Kha) ",
  "ya4.1.1:60.1": "na dhātū na cakkhu? (Ka) ",
  "ya4.1.1:61.1": "na sotaṃ na dhātu? (Kha) ",
  "ya4.1.1:62.1": "na dhātū na sotaṃ? … ",
  "ya4.1.1:63.1": "Na ghānaṃ?… Na jivhā?… Na kāyo?… Na rūpaṃ? … Na saddo?… Na gandho?… Na raso?… Na phoṭṭhabbo? (Ka) ",
  "ya4.1.1:64.1": "na cakkhuviññāṇaṃ na dhātu? (Kha) ",
  "ya4.1.1:65.1": "na dhātū na cakkhuviññāṇaṃ? … ",
  "ya4.1.1:66.1": "Na sotaviññāṇaṃ?…Pe… na ghānaviññāṇaṃ?… Na jivhāviññāṇaṃ? (Ka) ",
  "ya4.1.1:67.1": "na kāyaviññāṇaṃ na dhātu? (Kha) ",
  "ya4.1.1:68.1": "na dhātū na kāyaviññāṇaṃ? (Ka) ",
  "ya4.1.1:69.1": "na mano na dhātu? (Kha) ",
  "ya4.1.1:70.1": "na dhātū na mano? (Ka) ",
  "ya4.1.1:71.1": "na manoviññāṇaṃ na dhātu? (Kha) ",
  "ya4.1.1:72.1": "na dhātū na manoviññāṇaṃ? (Ka) ",
  "ya4.1.1:73.1": "na dhammo na dhātu? (Kha) ",
  "ya4.1.1:74.1": "na dhātū na dhammo? ",
  "ya4.1.1:75.0.1": "4. Suddhadhātumūlacakkavāro (Ka) anulomaṃ ",
  "ya4.1.1:75.0.2": "(Ka) ",
  "ya4.1.1:75.1": "cakkhu dhātu? (Kha) ",
  "ya4.1.1:76.1": "dhātū sotaṃ?…Pe… (Ka) ",
  "ya4.1.1:77.1": "cakkhu dhātu? (Kha) ",
  "ya4.1.1:78.1": "dhātū dhammo?…Pe… (Ka) ",
  "ya4.1.1:79.1": "dhammo dhātu? (Kha) ",
  "ya4.1.1:80.1": "dhātū cakkhu?…Pe… (Ka) ",
  "ya4.1.1:81.1": "dhammo dhātu? (Kha) ",
  "ya4.1.1:82.1": "dhātū manoviññāṇaṃ? ",
  "ya4.1.1:83.1": "(Cakkaṃ bandhitabbaṃ). ",
  "ya4.1.1:84.0": "(Kha) paccanīkaṃ (Ka) ",
  "ya4.1.1:84.1": "na cakkhu na dhātu? (Kha) ",
  "ya4.1.1:85.1": "na dhātū na sotaṃ? (Ka) ",
  "ya4.1.1:86.1": "na cakkhu na dhātu? (Kha) ",
  "ya4.1.1:87.1": "na dhātū na ghānaṃ?…Pe…. (Ka) ",
  "ya4.1.1:88.1": "na cakkhu na dhātu? (Kha) ",
  "ya4.1.1:89.1": "na dhātū na dhammo?…Pe… (Ka) ",
  "ya4.1.1:90.1": "na dhammo na dhātu? (Kha) ",
  "ya4.1.1:91.1": "na dhātū na cakkhu?…Pe… (Ka) ",
  "ya4.1.1:92.1": "na dhammo na dhātu? (Kha) ",
  "ya4.1.1:93.1": "na dhātū na manoviññāṇaṃ? ",
  "ya4.1.1:94.1": "(Cakkaṃ bandhitabbaṃ). ",
  "ya4.1.1:95.1": "Paṇṇattiuddesavāro. "
}
