{
  "dt2.8:0.1": "",
  "dt2.8:0.2": "",
  "dt2.8:0.3": "8. Aṭṭhamanayo 8. Vippayuttenasampayuttapadaniddeso ",
  "dt2.8:1.1": "Rūpakkhandhena ye dhammā vippayuttā, te dhammā katihi khandhehi katihāyatanehi katihi dhātūhi sampayuttāti? ",
  "dt2.8:1.2": "Natthi. ",
  "dt2.8:2.1": "Vedanākkhandhena ye dhammā… ",
  "dt2.8:2.2": "saññākkhandhena ye dhammā… ",
  "dt2.8:2.3": "saṅkhārakkhandhena ye dhammā… ",
  "dt2.8:2.4": "viññāṇakkhandhena ye dhammā…pe… ",
  "dt2.8:2.5": "saraṇehi dhammehi ye dhammā… ",
  "dt2.8:2.6": "araṇehi dhammehi ye dhammā vippayuttā, te dhammā katihi khandhehi katihāyatanehi katihi dhātūhi sampayuttāti? ",
  "dt2.8:2.7": "Natthi. ",
  "dt2.8:3.1": "Dhammāyatanaṃ dhammadhātu, ",
  "dt2.8:3.2": "atha jīvitaṃ nāmarūpaṃ; ",
  "dt2.8:3.3": "Saḷāyatanaṃ jātijarāmataṃ, ",
  "dt2.8:3.4": "dve ca tike na labbhare. ",
  "dt2.8:4.1": "Paṭhamantare satta ca, ",
  "dt2.8:4.2": "gocchake dasa aparante; ",
  "dt2.8:4.3": "Cuddasa cha ca matthake, ",
  "dt2.8:4.4": "iccete sattacattālīsa dhammā; ",
  "dt2.8:4.5": "Samucchede na labbhanti, ",
  "dt2.8:4.6": "moghapucchakena cāti. ",
  "dt2.8:5.1": "Vippayuttenasampayuttapadaniddeso aṭṭhamo. "
}
