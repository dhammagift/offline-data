{
  "dt1.1:0.1": "Abhidhammapiṭake Dhātukathāpāḷi ",
  "dt1.1:0.2": "Uddeso ",
  "dt1.1:0.3": "1. Nayamātikā ",
  "dt1.1:1.1": "Namo tassa bhagavato arahato sammāsambuddhassa ",
  "dt1.1:2.1": "(1) Saṅgaho asaṅgaho (2) ",
  "dt1.1:3.1": "saṅgahitena asaṅgahitaṃ (3) ",
  "dt1.1:4.1": "asaṅgahitena saṅgahitaṃ (4) ",
  "dt1.1:5.1": "saṅgahitena saṅgahitaṃ (5) ",
  "dt1.1:6.1": "asaṅgahitena asaṅgahitaṃ (6) ",
  "dt1.1:7.1": "sampayogo vippayogo ",
  "dt1.1:8.1": "(7)sampayuttena vippayuttaṃ (8) ",
  "dt1.1:9.1": "vippayuttena sampayuttaṃ (9) ",
  "dt1.1:10.1": "sampayuttena sampayuttaṃ ",
  "dt1.1:11.1": "(10)vippayuttena vippayuttaṃ (11) ",
  "dt1.1:12.1": "saṅgahitena sampayuttaṃ vippayuttaṃ (12) ",
  "dt1.1:13.1": "sampayuttena saṅgahitaṃ asaṅgahitaṃ (13) ",
  "dt1.1:14.1": "asaṅgahitena sampayuttaṃ vippayuttaṃ (14) ",
  "dt1.1:15.1": "vippayuttena saṅgahitaṃ asaṅgahitaṃ. 2. Abbhantaramātikā (1) "
}
