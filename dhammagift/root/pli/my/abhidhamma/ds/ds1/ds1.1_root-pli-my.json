{
  "ds1.1:0.1": "Abhidhammapiṭake Dhammasaṅgaṇīpāḷi ",
  "ds1.1:0.2": "Mātikā 1. Tikamātikā ",
  "ds1.1:1.0.1": "",
  "ds1.1:1.0.2": "Namo tassa bhagavato arahato sammāsambuddhassa ",
  "ds1.1:1.1": "(Ka) kusalā dhammā. (Kha) ",
  "ds1.1:2.1": "akusalā dhammā. (Ga) ",
  "ds1.1:3.1": "abyākatā dhammā. (Ka) ",
  "ds1.1:4.0": "",
  "ds1.1:4.1": "sukhāya vedanāya sampayuttā dhammā. (Kha) ",
  "ds1.1:5.1": "dukkhāya vedanāya sampayuttā dhammā. (Ga) ",
  "ds1.1:6.1": "adukkhamasukhāya vedanāya sampayuttā dhammā. (Ka) ",
  "ds1.1:7.0": "",
  "ds1.1:7.1": "vipākā dhammā. (Kha) ",
  "ds1.1:8.1": "vipākadhammadhammā. (Ga) ",
  "ds1.1:9.1": "nevavipākanavipākadhammadhammā. (Ka) ",
  "ds1.1:10.0": "",
  "ds1.1:10.1": "upādiṇṇupādāniyā dhammā. (Kha) ",
  "ds1.1:11.1": "anupādiṇṇupādāniyā dhammā. (Ga) ",
  "ds1.1:12.1": "anupādiṇṇaanupādāniyā dhammā. (Ka) ",
  "ds1.1:13.0": "",
  "ds1.1:13.1": "saṃkiliṭṭhasaṃkilesikā dhammā. ",
  "ds1.1:14.1": "(Kha) asaṃkiliṭṭhasaṃkilesikā dhammā. ",
  "ds1.1:15.1": "(Ga) asaṃkiliṭṭhaasaṃkilesikā dhammā. (Ka) ",
  "ds1.1:16.0": "",
  "ds1.1:16.1": "savitakkasavicārā dhammā. (Kha) ",
  "ds1.1:17.1": "avitakkavicāramattā dhammā. (Ga) ",
  "ds1.1:18.1": "avitakkaavicārā dhammā. (Ka) ",
  "ds1.1:19.0": "",
  "ds1.1:19.1": "pītisahagatā dhammā. (Kha) ",
  "ds1.1:20.1": "sukhasahagatā dhammā. (Ga) ",
  "ds1.1:21.1": "upekkhāsahagatā dhammā. (Ka) ",
  "ds1.1:22.0": "",
  "ds1.1:22.1": "dassanena pahātabbā dhammā. (Kha) ",
  "ds1.1:23.1": "bhāvanāya pahātabbā dhammā. (Ga) ",
  "ds1.1:24.1": "neva dassanena na bhāvanāya pahātabbā dhammā. (Ka) ",
  "ds1.1:25.0": "",
  "ds1.1:25.1": "dassanena pahātabbahetukā dhammā. (Kha) ",
  "ds1.1:26.1": "bhāvanāya pahātabbahetukā dhammā. (Ga) ",
  "ds1.1:27.1": "neva dassanena na bhāvanāya pahātabbahetukā dhammā. (Ka) ",
  "ds1.1:28.0": "",
  "ds1.1:28.1": "ācayagāmino dhammā. (Kha) ",
  "ds1.1:29.1": "apacayagāmino dhammā. (Ga) ",
  "ds1.1:30.1": "nevācayagāmināpacayagāmino dhammā. (Ka) ",
  "ds1.1:31.0": "",
  "ds1.1:31.1": "sekkhā dhammā. (Kha) ",
  "ds1.1:32.1": "asekkhā dhammā. (Ga) ",
  "ds1.1:33.1": "nevasekkhanāsekkhā dhammā. (Ka) ",
  "ds1.1:34.0": "",
  "ds1.1:34.1": "parittā dhammā. (Kha) ",
  "ds1.1:35.1": "mahaggatā dhammā. (Ga) ",
  "ds1.1:36.1": "appamāṇā dhammā. (Ka) ",
  "ds1.1:37.0": "",
  "ds1.1:37.1": "parittārammaṇā dhammā. (Kha) ",
  "ds1.1:38.1": "mahaggatārammaṇā dhammā. (Ga) ",
  "ds1.1:39.1": "appamāṇārammaṇā dhammā. (Ka) ",
  "ds1.1:40.0": "",
  "ds1.1:40.1": "hīnā dhammā. (Kha) ",
  "ds1.1:41.1": "majjhimā dhammā. (Ga) ",
  "ds1.1:42.1": "paṇītā dhammā. (Ka) ",
  "ds1.1:43.0": "",
  "ds1.1:43.1": "micchattaniyatā dhammā. (Kha) ",
  "ds1.1:44.1": "sammattaniyatā dhammā. (Ga) ",
  "ds1.1:45.1": "aniyatā dhammā. (Ka) ",
  "ds1.1:46.0": "",
  "ds1.1:46.1": "maggārammaṇā dhammā. (Kha) ",
  "ds1.1:47.1": "maggahetukā dhammā. (Ga) ",
  "ds1.1:48.1": "maggādhipatino dhammā. (Ka) ",
  "ds1.1:49.0": "",
  "ds1.1:49.1": "uppannā dhammā. (Kha) ",
  "ds1.1:50.1": "anuppannā dhammā. (Ga) ",
  "ds1.1:51.1": "uppādino dhammā. (Ka) ",
  "ds1.1:52.0": "",
  "ds1.1:52.1": "atītā dhammā. (Kha) ",
  "ds1.1:53.1": "anāgatā dhammā. (Ga) ",
  "ds1.1:54.1": "paccuppannā dhammā. (Ka) ",
  "ds1.1:55.0": "",
  "ds1.1:55.1": "atītārammaṇā dhammā. (Kha) ",
  "ds1.1:56.1": "anāgatārammaṇā dhammā. (Ga) ",
  "ds1.1:57.1": "paccuppannārammaṇā dhammā. (Ka) ",
  "ds1.1:58.0": "",
  "ds1.1:58.1": "ajjhattā dhammā. (Kha) ",
  "ds1.1:59.1": "bahiddhā dhammā. (Ga) ",
  "ds1.1:60.1": "ajjhattabahiddhā dhammā. (Ka) ",
  "ds1.1:61.0": "",
  "ds1.1:61.1": "ajjhattārammaṇā dhammā. (Kha) ",
  "ds1.1:62.1": "bahiddhārammaṇā dhammā. (Ga) ",
  "ds1.1:63.1": "ajjhattabahiddhārammaṇā dhammā. (Ka) ",
  "ds1.1:64.0": "",
  "ds1.1:64.1": "sanidassanasappaṭighā dhammā. (Kha) ",
  "ds1.1:65.1": "anidassanasappaṭighā dhammā. (Ga) ",
  "ds1.1:66.1": "anidassanaappaṭighā dhammā. ",
  "ds1.1:66.2": "Tikamātikā. "
}
