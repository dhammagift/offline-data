{
  "patthana10.13:0.1": "",
  "patthana10.13:0.2": "",
  "patthana10.13:0.3": "22-7-13. Sanidassanattika-cūḷantaradukāni ",
  "patthana10.13:1.1": "Nasanidassanasappaṭighaṃ naappaccayaṃ dhammaṃ paṭicca…pe… nasanidassanasappaṭighaṃ naasaṅkhataṃ dhammaṃ paṭicca…. ",
  "patthana10.13:2.1": "",
  "patthana10.13:3.1": "Nasanidassanasappaṭighaṃ nasanidassanaṃ dhammaṃ paṭicca…. ",
  "patthana10.13:4.1": "",
  "patthana10.13:5.1": "Nasanidassanasappaṭighaṃ nasappaṭighaṃ dhammaṃ paṭicca…. ",
  "patthana10.13:6.1": "Nasanidassanasappaṭighaṃ naappaṭighaṃ dhammaṃ paṭicca…. (Saṃkhittaṃ.) ",
  "patthana10.13:7.1": "Nasanidassanasappaṭighaṃ narūpiṃ dhammaṃ paṭicca… ",
  "patthana10.13:8.1": "nasanidassanasappaṭighaṃ naarūpiṃ dhammaṃ paṭicca…. ",
  "patthana10.13:9.1": "Nasanidassanasappaṭighaṃ nalokiyaṃ dhammaṃ paṭicca…. ",
  "patthana10.13:10.1": "Nasanidassanasappaṭighaṃ nalokuttaraṃ dhammaṃ paṭicca…. ",
  "patthana10.13:11.1": "Nasanidassanasappaṭighaṃ nakenaci viññeyyaṃ dhammaṃ paṭicca…pe… nasanidassanasappaṭighaṃ nanakenaci viññeyyaṃ dhammaṃ paṭicca…. ",
  "patthana10.13:12.1": ""
}
