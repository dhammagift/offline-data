  "patthana10.4:0.1": "",
  "patthana10.4:0.2": "",
  "patthana10.4:0.3": "1-7-13. Kusalattika-cūḷantaradukāni ",
  "patthana10.4:1.1": "Nakusalaṃ naappaccayaṃ dhammaṃ paṭicca…pe… nakusalaṃ naasaṅkhataṃ dhammaṃ paṭicca…. ",
  "patthana10.4:2.1": "",
  "patthana10.4:3.1": "Nakusalaṃ nasanidassanaṃ dhammaṃ paṭicca…. ",
  "patthana10.4:4.1": "",
  "patthana10.4:5.1": "Nakusalaṃ nasappaṭighaṃ dhammaṃ paṭicca…. ",
  "patthana10.4:6.1": "",
  "patthana10.4:7.1": "Nakusalaṃ naappaṭighaṃ dhammaṃ paṭicca…. ",
  "patthana10.4:8.1": "",
  "patthana10.4:9.1": "Nakusalaṃ narūpiṃ dhammaṃ paṭicca…. ",
  "patthana10.4:10.1": "",
  "patthana10.4:11.1": "Nakusalaṃ naarūpiṃ dhammaṃ paṭicca…. ",
  "patthana10.4:12.1": "",
  "patthana10.4:13.1": "Nakusalaṃ nalokiyaṃ dhammaṃ paṭicca…. ",
  "patthana10.4:14.1": "",
  "patthana10.4:15.1": "Nakusalaṃ nalokuttaraṃ dhammaṃ paṭicca…. ",
  "patthana10.4:16.1": "",
  "patthana10.4:17.1": "Nakusalaṃ nakenaci viññeyyaṃ dhammaṃ paṭicca…pe… nakusalaṃ nanakenaci viññeyyaṃ dhammaṃ paṭicca…. ",
  "patthana10.4:18.1": ""
}
