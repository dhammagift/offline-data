{
  "patthana10.5:0.1": "",
  "patthana10.5:0.2": "",
  "patthana10.5:0.3": "1-14-19. Kusalattika-āsavagocchakaṃ ",
  "patthana10.5:1.1": "Nakusalaṃ noāsavaṃ dhammaṃ paṭicca…. ",
  "patthana10.5:2.1": "Nakusalaṃ nanoāsavaṃ dhammaṃ paṭicca…. ",
  "patthana10.5:3.1": "Nakusalaṃ nasāsavaṃ dhammaṃ paṭicca…. ",
  "patthana10.5:4.1": "Nakusalaṃ naanāsavaṃ dhammaṃ paṭicca…. ",
  "patthana10.5:5.1": "Nakusalaṃ naāsavasampayuttaṃ dhammaṃ paṭicca…. ",
  "patthana10.5:6.1": "Nakusalaṃ naāsavavippayuttaṃ dhammaṃ paṭicca…. ",
  "patthana10.5:7.1": "Nakusalaṃ noāsavañceva naanāsavañca dhammaṃ paṭicca…. ",
  "patthana10.5:8.1": "Nakusalaṃ naanāsavañceva nano ca āsavaṃ dhammaṃ paṭicca…. ",
  "patthana10.5:9.1": "Nakusalaṃ naanāsavañceva naāsavavippayuttañca dhammaṃ paṭicca…. ",
  "patthana10.5:10.1": "Nakusalaṃ naāsavavippayuttañceva nano ca āsavaṃ dhammaṃ paṭicca…. ",
  "patthana10.5:11.1": "Nakusalaṃ āsavavippayuttaṃ nasāsavaṃ dhammaṃ paṭicca…. ",
  "patthana10.5:12.1": "Nakusalaṃ āsavavippayuttaṃ naanāsavaṃ dhammaṃ paṭicca…. "
}
