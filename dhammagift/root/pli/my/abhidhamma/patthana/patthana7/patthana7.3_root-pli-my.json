  "patthana7.3:0.3": "3. Vipākattikaṃ 1-7. Paṭiccavārādi ",
  "patthana7.3:1.1": "Navipākaṃ dhammaṃ paṭicca navipāko dhammo uppajjati hetupaccayā…pe…. ",
  "patthana7.3:2.1": "Navipākadhammadhammaṃ paṭicca navipākadhammadhammo uppajjati hetupaccayā…pe…. ",
  "patthana7.3:3.1": "Nanevavipākanavipākadhammadhammaṃ paṭicca nanevavipākanavipākadhammadhammo uppajjati hetupaccayā. (Saṃkhittaṃ.) ",
  "patthana7.3:4.1": ""
}
