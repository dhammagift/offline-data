{
  "patthana12.10:0.1": "",
  "patthana12.10:0.2": "",
  "patthana12.10:0.3": "20-54-1. Saññojanādidukāni-hetudukaṃ ",
  "patthana12.10:1.1": "Nosaññojanaṃ nahetuṃ dhammaṃ paṭicca…. ",
  "patthana12.10:2.1": "",
  "patthana12.10:3.1": "Noganthaṃ nahetuṃ dhammaṃ paṭicca…. ",
  "patthana12.10:4.1": "",
  "patthana12.10:5.1": "Nooghaṃ nahetuṃ dhammaṃ paṭicca…pe… noyogaṃ nahetuṃ dhammaṃ paṭicca…. ",
  "patthana12.10:6.1": "",
  "patthana12.10:7.1": "Nonīvaraṇaṃ nahetuṃ dhammaṃ paṭicca…. ",
  "patthana12.10:8.1": "",
  "patthana12.10:9.1": "Noparāmāsaṃ nahetuṃ dhammaṃ paṭicca…. ",
  "patthana12.10:10.1": ""
}
