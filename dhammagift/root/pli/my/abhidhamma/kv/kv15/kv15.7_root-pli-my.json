  "kv15.7:0.3": "15. Pannarasamavaggo ",
  "kv15.7:0.4": "(151) 7. Saññāvedayitakathā ",
  "kv15.7:1.1": "Saññāvedayitanirodhasamāpatti lokuttarāti? ",
  "kv15.7:1.2": "Āmantā. ",
  "kv15.7:1.3": "Maggo phalaṃ nibbānaṃ, sotāpattimaggo sotāpattiphalaṃ…pe… bojjhaṅgoti? ",
  "kv15.7:1.4": "Na hevaṃ vattabbe…pe…. ",
  "kv15.7:2.1": "Na vattabbaṃ – ",
  "kv15.7:2.2": "‘‘saññāvedayitanirodhasamāpatti lokuttarāti? ",
  "kv15.7:2.3": "Āmantā. ",
  "kv15.7:2.4": "Lokiyāti? ",
  "kv15.7:2.5": "Na hevaṃ vattabbe. ",
  "kv15.7:2.6": "Tena hi lokuttarāti. ",
  "kv15.7:2.7": "Saññāvedayitakathā niṭṭhitā. "
}
