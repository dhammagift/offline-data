  "pli-tv-bu-vb-sk17:1.0": "592. ",
  "pli-tv-bu-vb-sk17:1.1": "Tena samayena buddho bhagavā sāvatthiyaṃ viharati jetavane anāthapiṇḍikassa ārāme. ",
  "pli-tv-bu-vb-sk17:1.2": "Tena kho pana samayena chabbaggiyā bhikkhū bāhuppacālakaṃ antaraghare gacchanti bāhuṃ olambentā…pe…. ",
  "pli-tv-bu-vb-sk17:1.3.0": "",
  "pli-tv-bu-vb-sk17:1.3.1": "‘‘Na bāhuppacālakaṃ antaraghare gamissāmīti sikkhā karaṇīyā’’ti. ",
  "pli-tv-bu-vb-sk17:1.4": "Na bāhuppacālakaṃ antaraghare gantabbaṃ. ",
  "pli-tv-bu-vb-sk17:1.5": "Bāhuṃ paggahetvā gantabbaṃ. ",
  "pli-tv-bu-vb-sk17:1.6": "Yo anādariyaṃ paṭicca bāhuppacālakaṃ antaraghare gacchati bāhuṃ olambento, āpatti dukkaṭassa. ",
  "pli-tv-bu-vb-sk17:1.7.0": "",
  "pli-tv-bu-vb-sk17:1.7.1": "Anāpatti ",
  "pli-tv-bu-vb-sk17:1.8.1": "asañcicca…pe… ",
  "pli-tv-bu-vb-sk17:1.8.2": "",
  "pli-tv-bu-vb-sk17:1.8.3": "",
  "pli-tv-bu-vb-sk17:1.8.4": "",
  "pli-tv-bu-vb-sk17:1.8.5": "",
  "pli-tv-bu-vb-sk17:1.8.6": "",
  "pli-tv-bu-vb-sk17:1.9": "ādikammikassāti. ",
  "pli-tv-bu-vb-sk17:1.10": "Sattamasikkhāpadaṃ niṭṭhitaṃ. "
}
