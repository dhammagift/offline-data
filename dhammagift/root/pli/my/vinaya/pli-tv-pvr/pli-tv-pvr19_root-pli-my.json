  "pli-tv-pvr19:0.1": "",
  "pli-tv-pvr19:0.2": "Dutiyagāthāsaṅgaṇikaṃ ",
  "pli-tv-pvr19:0.3": "1. Kāyikādiāpatti ",
  "pli-tv-pvr19:1.1": "Kati āpattiyo kāyikā, ",
  "pli-tv-pvr19:1.2": "kati vācasikā katā. ",
  "pli-tv-pvr19:1.3": "Chādentassa kati āpattiyo, ",
  "pli-tv-pvr19:1.4": "kati saṃsaggapaccayā. ",
  "pli-tv-pvr19:2.1": "Chāpattiyo kāyikā, ",
  "pli-tv-pvr19:2.2": "cha vācasikā katā; ",
  "pli-tv-pvr19:2.3": "Chādentassa tisso āpattiyo, ",
  "pli-tv-pvr19:2.4": "pañca saṃsaggapaccayā. ",
  "pli-tv-pvr19:3.1": "Aruṇugge kati āpattiyo, ",
  "pli-tv-pvr19:3.2": "kati yāvatatiyakā; ",
  "pli-tv-pvr19:3.3": "Katettha aṭṭha vatthukā, ",
  "pli-tv-pvr19:3.4": "katihi sabbasaṅgaho. ",
  "pli-tv-pvr19:4.1": "Aruṇugge tisso āpattiyo, ",
  "pli-tv-pvr19:4.2": "dve yāvatatiyakā; ",
  "pli-tv-pvr19:4.3": "Ekettha aṭṭha vatthukā, ",
  "pli-tv-pvr19:4.4": "ekena sabbasaṅgaho. ",
  "pli-tv-pvr19:5.1": "Vinayassa kati mūlāni, ",
  "pli-tv-pvr19:5.2": "yāni buddhena paññattā; ",
  "pli-tv-pvr19:5.3": "Vinayagarukā kati vuttā, ",
  "pli-tv-pvr19:5.4": "duṭṭhullacchādanā kati. ",
  "pli-tv-pvr19:6.1": "Vinayassa dve mūlāni, ",
  "pli-tv-pvr19:6.2": "yāni buddhena paññattā; ",
  "pli-tv-pvr19:6.3": "Vinayagarukā dve vuttā, ",
  "pli-tv-pvr19:6.4": "dve duṭṭhullacchādanā. ",
  "pli-tv-pvr19:7.1": "Gāmantare kati āpattiyo, ",
  "pli-tv-pvr19:7.2": "kati nadipārapaccayā; ",
  "pli-tv-pvr19:7.3": "Katimaṃsesu thullaccayaṃ, ",
  "pli-tv-pvr19:7.4": "katimaṃsesu dukkaṭaṃ. ",
  "pli-tv-pvr19:8.1": "Gāmantare catasso āpattiyo, ",
  "pli-tv-pvr19:8.2": "catasso nadipārapaccayā; ",
  "pli-tv-pvr19:8.3": "Ekamaṃse thullaccayaṃ, ",
  "pli-tv-pvr19:8.4": "navamaṃsesu dukkaṭaṃ. ",
  "pli-tv-pvr19:9.1": "Kati vācasikā rattiṃ, ",
  "pli-tv-pvr19:9.2": "kati vācasikā divā; ",
  "pli-tv-pvr19:9.3": "Dadamānassa kati āpattiyo, ",
  "pli-tv-pvr19:9.4": "paṭiggaṇhantassa kittakā. ",
  "pli-tv-pvr19:10.1": "Dve vācasikā rattiṃ, ",
  "pli-tv-pvr19:10.2": "dve vācasikā divā; ",
  "pli-tv-pvr19:10.3": "Dadamānassa tisso āpattiyo, ",
  "pli-tv-pvr19:10.4": "cattāro ca paṭiggahe. ",
  "pli-tv-pvr19:11.0": "2. Desanāgāminiyādiāpatti ",
  "pli-tv-pvr19:11.1": "475. Kati desanāgāminiyo, ",
  "pli-tv-pvr19:11.2": "kati sappaṭikammā katā; ",
  "pli-tv-pvr19:11.3": "Katettha appaṭikammā vuttā, ",
  "pli-tv-pvr19:11.4": "buddhenādiccabandhunā. ",
  "pli-tv-pvr19:12.1": "Pañca desanāgāminiyo, ",
  "pli-tv-pvr19:12.2": "cha sappaṭikammā katā; ",
  "pli-tv-pvr19:12.3": "Ekettha appaṭikammā vuttā, ",
  "pli-tv-pvr19:12.4": "buddhenādiccabandhunā. ",
  "pli-tv-pvr19:13.1": "Vinayagarukā kati vuttā, ",
  "pli-tv-pvr19:13.2": "kāyavācasikāni ca; ",
  "pli-tv-pvr19:13.3": "Kati vikāle dhaññaraso, ",
  "pli-tv-pvr19:13.4": "kati ñatticatutthena sammuti. ",
  "pli-tv-pvr19:14.1": "Vinayagarukā dve vuttā, ",
  "pli-tv-pvr19:14.2": "kāyavācasikāni ca; ",
  "pli-tv-pvr19:14.3": "Eko vikāle dhaññaraso, ",
  "pli-tv-pvr19:14.4": "ekā ñatticatutthena sammuti. ",
  "pli-tv-pvr19:15.1": "Pārājikā kāyikā kati, ",
  "pli-tv-pvr19:15.2": "kati saṃvāsakabhūmiyo; ",
  "pli-tv-pvr19:15.3": "Katinaṃ ratticchedo, ",
  "pli-tv-pvr19:15.4": "paññattā dvaṅgulā kati. ",
  "pli-tv-pvr19:16.1": "Pārājikā kāyikā dve, ",
  "pli-tv-pvr19:16.2": "dve saṃvāsakabhūmiyo; ",
  "pli-tv-pvr19:16.3": "Dvinnaṃ ratticchedo, ",
  "pli-tv-pvr19:16.4": "paññattā dvaṅgulā duve. ",
  "pli-tv-pvr19:17.1": "Katattānaṃ vadhitvāna, ",
  "pli-tv-pvr19:17.2": "katihi saṅgho bhijjati; ",
  "pli-tv-pvr19:17.3": "Katettha paṭhamāpattikā, ",
  "pli-tv-pvr19:17.4": "ñattiyā karaṇā kati. ",
  "pli-tv-pvr19:18.1": "Dve attānaṃ vadhitvāna, ",
  "pli-tv-pvr19:18.2": "dvīhi saṅgho bhijjati; ",
  "pli-tv-pvr19:18.3": "Dvettha paṭhamāpattikā, ",
  "pli-tv-pvr19:18.4": "ñattiyā karaṇā duve. ",
  "pli-tv-pvr19:19.1": "Pāṇātipāte kati āpattiyo, ",
  "pli-tv-pvr19:19.2": "vācā pārājikā kati; ",
  "pli-tv-pvr19:19.3": "Obhāsanā kati vuttā, ",
  "pli-tv-pvr19:19.4": "sañcarittena vā kati. ",
  "pli-tv-pvr19:20.1": "Pāṇātipāte tisso āpattiyo; ",
  "pli-tv-pvr19:20.2": "Vācā pārājikā tayo; ",
  "pli-tv-pvr19:20.3": "Obhāsanā tayo vuttā; ",
  "pli-tv-pvr19:20.4": "Sañcarittena vā tayo. ",
  "pli-tv-pvr19:21.1": "Kati puggalā na upasampādetabbā, ",
  "pli-tv-pvr19:21.2": "kati kammānaṃ saṅgahā; ",
  "pli-tv-pvr19:21.3": "Nāsitakā kati vuttā, ",
  "pli-tv-pvr19:21.4": "katinaṃ ekavācikā. ",
  "pli-tv-pvr19:22.1": "Tayo puggalā na upasampādetabbā, ",
  "pli-tv-pvr19:22.2": "tayo kammānaṃ saṅgahā; ",
  "pli-tv-pvr19:22.3": "Nāsitakā tayo vuttā, ",
  "pli-tv-pvr19:22.4": "tiṇṇannaṃ ekavācikā. ",
  "pli-tv-pvr19:23.1": "Adinnādāne kati āpattiyo, ",
  "pli-tv-pvr19:23.2": "kati methunapaccayā; ",
  "pli-tv-pvr19:23.3": "Chindantassa kati āpattiyo, ",
  "pli-tv-pvr19:23.4": "kati chaḍḍitapaccayā. ",
  "pli-tv-pvr19:24.1": "Adinnādāne tisso āpattiyo, ",
