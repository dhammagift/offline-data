{
  "sn48.1:0.1": "indriyasaṃyuttaṃ ",
  "sn48.1:0.2": "suddhikavaggo paṭhamo ",
  "sn48.1:0.3": "",
  "sn48.1:1.1": "sāvatthīnidānaṃ. ",
  "sn48.1:1.2": "tatra kho bhagavā etadavoca ",
  "sn48.1:1.3": "pañcimāni bhikkhave indriyāni. ",
  "sn48.1:1.4": "katamāni pañca. ",
  "sn48.1:1.5": "saddhindriyaṃ viriyindriyaṃ satindriyaṃ samādhindriyaṃ paññindriyaṃ. ",
  "sn48.1:1.6": "imāni kho bhikkhave pañcindriyānīti. ",
  "sn48.1:1.7": ""
}
