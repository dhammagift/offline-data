{
  "sn48.8:0.1": "",
  "sn48.8:0.2": "",
  "sn48.8:0.3": "",
  "sn48.8:1.1": "pañcimāni bhikkhave indriyāni. ",
  "sn48.8:1.2": "katamāni pañca. ",
  "sn48.8:1.3": "saddhindriyaṃ …pe… paññindriyaṃ. ",
  "sn48.8:1.4": "kattha ca bhikkhave saddhindriyaṃ daṭṭhabbaṃ. ",
  "sn48.8:1.5": "catūsu sotāpattiyaṅgesu ",
  "sn48.8:1.6": "ettha saddhindriyaṃ daṭṭhabbaṃ. ",
  "sn48.8:1.7": "kattha ca bhikkhave viriyindriyaṃ daṭṭhabbaṃ. ",
  "sn48.8:1.8": "catūsu sammappadhānesu ",
  "sn48.8:1.9": "ettha viriyindriyaṃ daṭṭhabbaṃ. ",
  "sn48.8:1.10": "kattha ca bhikkhave satindriyaṃ daṭṭhabbaṃ. ",
  "sn48.8:1.11": "catūsu satipaṭṭhānesu ",
  "sn48.8:1.12": "ettha satindriyaṃ daṭṭhabbaṃ. ",
  "sn48.8:1.13": "kattha ca bhikkhave samādhindriyaṃ daṭṭhabbaṃ. ",
  "sn48.8:1.14": "catūsu jhānesu ",
  "sn48.8:1.15": "ettha samādhindriyaṃ daṭṭhabbaṃ. ",
  "sn48.8:1.16": "kattha ca bhikkhave paññindriyaṃ daṭṭhabbaṃ. ",
  "sn48.8:1.17": "catūsu ariyasaccesu ",
  "sn48.8:1.18": "ettha paññindriyaṃ daṭṭhabbaṃ. ",
  "sn48.8:1.19": "imāni kho bhikkhave pañcindriyānīti. ",
  "sn48.8:1.20": ""
}
