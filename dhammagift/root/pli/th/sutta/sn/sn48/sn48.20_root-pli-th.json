{
  "sn48.20:0.1": "",
  "sn48.20:0.2": "",
  "sn48.20:0.3": "",
  "sn48.20:1.1": "pañcimāni bhikkhave indriyāni. ",
  "sn48.20:1.2": "katamāni pañca. ",
  "sn48.20:1.3": "saddhindriyaṃ …pe… paññindriyaṃ. ",
  "sn48.20:1.4": "imāni kho bhikkhave pañcindriyāni. ",
  "sn48.20:1.5": "imesaṃ kho bhikkhave pañcannaṃ indriyānaṃ bhāvitattā bahulīkatattā bhikkhu āsavānaṃ khayā anāsavaṃ cetovimuttiṃ paññāvimuttiṃ diṭṭheva dhamme sayaṃ abhiññā sacchikatvā upasampajja viharatīti. ",
  "sn48.20:1.6": "",
  "sn48.20:1.7": "mudutaravaggo dutiyo. ",
  "sn48.20:2.0": "tassuddānaṃ ",
  "sn48.20:2.1": "paṭilābho ca tayo saṅkhittā ",
  "sn48.20:2.2": "vitthārā apare tayo ",
  "sn48.20:2.3": "paṭipanno cupasamo āsavānaṃ ",
  "sn48.20:2.4": "khayo cimeti. "
}
