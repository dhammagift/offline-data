{
  "sn10.7:0.1": "",
  "sn10.7:0.2": "",
  "sn10.7:0.3": "sattamaṃ punabbasusuttaṃ ",
  "sn10.7:1.1": "ekaṃ samayaṃ bhagavā sāvatthiyaṃ viharati jetavane anāthapiṇḍikassa ārāme. ",
  "sn10.7:1.2": "tena kho pana samayena bhagavā bhikkhū nibbānapaṭisaṃyuttāya dhammiyā kathāya sandasseti samādapeti samuttejeti sampahaṃseti. ",
  "sn10.7:1.3": "te ca bhikkhū aṭṭhikatvā manasikatvā sabbacetaso samannāharitvā ohitasotā dhammaṃ suṇanti. ",
  "sn10.7:1.4": "atha kho punabbasumātā yakkhinī puttakaṃ evaṃ tosesi ",
  "sn10.7:2.1": "tuṇhī uttarike hohi ",
  "sn10.7:2.2": "tuṇhī hohi punabbasu ",
  "sn10.7:2.3": "yāvāhaṃ buddhaseṭṭhassa ",
  "sn10.7:2.4": "dhammaṃ sossāmi satthuno ",
  "sn10.7:3.1": "nibbānaṃ bhagavā āha ",
  "sn10.7:3.2": "sabbaganthappamocanaṃ ",
  "sn10.7:3.3": "ativelā ca me hoti ",
  "sn10.7:3.4": "asmiṃ dhamme piyāyanā ",
  "sn10.7:4.1": "piyo loke sako putto ",
  "sn10.7:4.2": "piyo loke sako pati ",
  "sn10.7:4.3": "tato piyataraṃ mayhaṃ ",
  "sn10.7:4.4": "assa dhammassa magganā ",
  "sn10.7:5.1": "na hi putto pati vāpi ",
  "sn10.7:5.2": "piyo dukkhā pamocaye ",
  "sn10.7:5.3": "yathā saddhammassavanaṃ ",
  "sn10.7:5.4": "dukkhā moceti pāṇinaṃ ",
  "sn10.7:6.1": "loke dukkhaparetasmiṃ ",
  "sn10.7:6.2": "jarāmaraṇasaṃyute ",
  "sn10.7:6.3": "jarāmaraṇamokkhāya ",
  "sn10.7:6.4": "yaṃ dhammaṃ abhisambudhaṃ ",
  "sn10.7:6.5": "taṃ dhammaṃ sotumicchāmi ",
  "sn10.7:6.6": "tuṇhī hohi punabbasūti. ",
  "sn10.7:7.1": "amma na byāharissāmi ",
  "sn10.7:7.2": "tuṇhībhūtāyamuttarā ",
  "sn10.7:7.3": "dhammameva nisāmehi ",
  "sn10.7:7.4": "saddhammassavanaṃ sukhaṃ ",
  "sn10.7:7.5": "saddhammassa anaññāya ",
  "sn10.7:7.6": "amma dukkhaṃ carāmase ",
  "sn10.7:8.1": "esa devamanussānaṃ ",
  "sn10.7:8.2": "sammūḷhānaṃ pabhaṅkaro ",
  "sn10.7:8.3": "buddho antimasārīro ",
  "sn10.7:8.4": "dhammaṃ deseti cakkhumāti. ",
  "sn10.7:9.1": "sādhu kho paṇḍito nāma ",
  "sn10.7:9.2": "putto jāto ure sayo ",
  "sn10.7:9.3": "putto me buddhaseṭṭhassa ",
  "sn10.7:9.4": "dhammasuddhaṃ piyāyati ",
  "sn10.7:10.1": "punabbasu sukhī hohi ",
  "sn10.7:10.2": "ajjāhamhi samuggatā ",
  "sn10.7:10.3": "diṭṭhāni ariyasaccāni ",
  "sn10.7:10.4": "uttarāpi suṇātu meti. "
}
