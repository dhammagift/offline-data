{
  "sn10.5:0.1": "",
  "sn10.5:0.2": "",
  "sn10.5:0.3": "pañcamaṃ sānusuttaṃ ",
  "sn10.5:1.1": "ekaṃ samayaṃ bhagavā sāvatthiyaṃ viharati jetavane anāthapiṇḍikassa ārāme. ",
  "sn10.5:1.2": "tena kho pana samayena aññatarissā upāsikāya sānu nāma putto yakkhena gahito hoti. ",
  "sn10.5:1.3": "atha kho sā upāsikā paridevamānā tāyaṃ velāyaṃ imā gāthāyo abhāsi ",
  "sn10.5:2.1": "cātuddasiṃ pañcadasiṃ ",
  "sn10.5:2.2": "yā ca pakkhassa aṭṭhamī ",
  "sn10.5:2.3": "pārihārikapakkhañca ",
  "sn10.5:2.4": "aṭṭhaṅgasusamāgataṃ ",
  "sn10.5:3.1": "uposathaṃ upavasanti ",
  "sn10.5:3.2": "brahmacariyaṃ caranti ye ",
  "sn10.5:3.3": "na tehi yakkhā kīḷanti ",
  "sn10.5:3.4": "iti me arahataṃ sutaṃ ",
  "sn10.5:3.5": "sādāni ajja passāmi ",
  "sn10.5:3.6": "yakkhā kīḷanti sānunāti. ",
  "sn10.5:4.1": "cātuddasiṃ pañcadasiṃ ",
  "sn10.5:4.2": "yā ca pakkhassa aṭṭhamī ",
  "sn10.5:4.3": "pārihārikapakkhañca ",
  "sn10.5:4.4": "aṭṭhaṅgasusamāgataṃ ",
  "sn10.5:5.1": "uposathaṃ upavasanti ",
  "sn10.5:5.2": "brahmacariyaṃ caranti ye ",
  "sn10.5:5.3": "na tehi yakkhā kīḷanti ",
  "sn10.5:5.4": "sāhu te arahataṃ sutaṃ ",
  "sn10.5:6.1": "sānana pabuddhaṃ vajjāsi ",
  "sn10.5:6.2": "yakkhānaṃ vacanaṃ idaṃ ",
  "sn10.5:6.3": "mākāsi pāpakaṃ kammaṃ ",
  "sn10.5:6.4": "āvi vā yadi vā raho ",
  "sn10.5:7.1": "saceva pāpakaṃ kammaṃ ",
  "sn10.5:7.2": "karissasi karosi vā ",
  "sn10.5:7.3": "na te dukkhā pamutyatthi ",
  "sn10.5:7.4": "uppaccāpi palāyatoti. ",
  "sn10.5:8.1": "mataṃ vā amma rodanti ",
  "sn10.5:8.2": "yo vā jīvaṃ na dissati ",
  "sn10.5:8.3": "jīvantaṃ amma passantī ",
  "sn10.5:8.4": "kasmā maṃ amma rodasīti. ",
  "sn10.5:9.1": "mataṃ vā putta rodanti ",
  "sn10.5:9.2": "yo vā jīvaṃ na dissati ",
  "sn10.5:9.3": "yo ca kāme cajitvāna ",
  "sn10.5:9.4": "punarāgacchate idha ",
  "sn10.5:9.5": "taṃ vāpi putta rodanti ",
  "sn10.5:9.6": "puna jīvaṃ mato hi so ",
  "sn10.5:10.1": "kukkulā ubbhato tāta ",
  "sn10.5:10.2": "kukkulaṃ patitumicchasi ",
  "sn10.5:10.3": "narakā ubhato tāta ",
  "sn10.5:10.4": "narakaṃ patitumicchasi ",
  "sn10.5:11.1": "abhidhāvatha bhaddante ",
  "sn10.5:11.2": "kassa ujjhāpayāmase ",
  "sn10.5:11.3": "ādittā nibbhataṃ bhaṇḍaṃ ",
  "sn10.5:11.4": "puna ḍayhitumicchasīti. "
}
