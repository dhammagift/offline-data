{
  "sn10.2:0.1": "",
  "sn10.2:0.2": "",
  "sn10.2:0.3": "dutiyaṃ sakkasuttaṃ ",
  "sn10.2:1.1": "ekaṃ samayaṃ bhagavā rājagahe viharati gijjhakūṭe pabbate. ",
  "sn10.2:1.2": "atha kho sakkanāmako yakkho yena bhagavā tenupasaṅkami upasaṅkamitvā bhagavantaṃ gāthāya ajjhabhāsi ",
  "sn10.2:2.1": "sabbaganthappahīnassa ",
  "sn10.2:2.2": "vippamuttassa te sato ",
  "sn10.2:2.3": "samaṇassa na taṃ sādhu ",
  "sn10.2:2.4": "yadaññamanusāsatīti. ",
  "sn10.2:3.1": "yena kenaci vaṇṇena ",
  "sn10.2:3.2": "saṃvāso sakka jāyati ",
  "sn10.2:3.3": "na taṃ arahati sappañño ",
  "sn10.2:3.4": "manasā anukampituṃ ",
  "sn10.2:4.1": "manasā ce pasannena ",
  "sn10.2:4.2": "yadaññamanusāsati ",
  "sn10.2:4.3": "na tena hoti saṃyutto ",
  "sn10.2:4.4": "yānukampā anuddayāti. "
}
