  "sn43.2:0.3": "",
  "sn43.2:1.1": "asaṅkhatañca vo bhikkhave desissāmi asaṅkhatagāmiñca maggaṃ ",
  "sn43.2:1.2": "taṃ suṇātha. ",
  "sn43.2:1.3": "katamañca bhikkhave asaṅkhataṃ. ",
  "sn43.2:1.4": "yo bhikkhave rāgakkhayo dosakkhayo mohakkhayo. ",
  "sn43.2:1.5": "idaṃ vuccati bhikkhave asaṅkhataṃ. ",
  "sn43.2:1.6": "katamo ca bhikkhave asaṅkhatagāmimaggo. ",
  "sn43.2:1.7": "samatho ca vipassanā ca. ",
  "sn43.2:1.8": "ayaṃ vuccati bhikkhave asaṅkhatagāmimaggo …pe… ",
  "sn43.2:1.9": ""
}
