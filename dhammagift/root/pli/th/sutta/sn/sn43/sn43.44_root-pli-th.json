{
  "sn43.44:0.1": "",
  "sn43.44:0.2": "",
  "sn43.44:0.3": "",
  "sn43.44:1.1": "parāyanañca vo bhikkhave desissāmi parāyanagāmiñca maggaṃ ",
  "sn43.44:1.2": "taṃ suṇātha. ",
  "sn43.44:1.3": "katamañca bhikkhave parāyanaṃ. ",
  "sn43.44:1.4": "yo bhikkhave rāgakkhayo dosakkhayo mohakkhayo. ",
  "sn43.44:1.5": "idaṃ vuccati bhikkhave parāyanaṃ. ",
  "sn43.44:1.6": "katamo ca bhikkhave parāyanagāmimaggo. ",
  "sn43.44:1.7": "kāyagatāsati. ",
  "sn43.44:1.8": "ayaṃ vuccati bhikkhave parāyanagāmimaggo. ",
  "sn43.44:1.9": "iti kho bhikkhave desitaṃ vo mayā parāyanaṃ desito parāyanagāmimaggo. ",
  "sn43.44:1.10": "yaṃ bhikkhave satthārā karaṇīyaṃ sāvakānaṃ hitesinā anukampakena anukampaṃ upādāya kataṃ vo taṃ mayā. ",
  "sn43.44:1.11": "etāni bhikkhave rukkhamūlāni etāni suññāgārāni. jhāyatha bhikkhave mā pamādattha mā pacchā vippaṭisārino ahuvattha. ayaṃ vo amhākaṃ anusāsanīti. ",
  "sn43.44:1.12": "yathā asaṅkhataṃ vitthāritaṃ tathā vitthāretabbaṃ. ",
  "sn43.44:1.13": "",
  "sn43.44:1.14": "dutiyo vaggo samatto. ",
  "sn43.44:2.0": "tassuddānaṃ ",
  "sn43.44:2.1": "asaṅkhataṃ anataṃ anāsavaṃ ",
  "sn43.44:2.2": "saccañca pāraṃ nipuṇaṃ sududdasaṃ ",
  "sn43.44:2.3": "ajajjarantaṃ dhuvaṃ apalokinaṃ ",
  "sn43.44:2.4": "anidassanaṃ nippapañcasantaṃ. ",
  "sn43.44:3.1": "amataṃ paṇītañca sivañca khemaṃ ",
  "sn43.44:3.2": "taṇhakkhayo acchariyañca abbhutaṃ ",
  "sn43.44:3.3": "anītikaṃ anītikadhammaṃ ",
  "sn43.44:3.4": "nibbānametaṃ sugatena desitaṃ. ",
  "sn43.44:4.1": "abyāpajjho virāgo ca ",
  "sn43.44:4.2": "suddhi mutti anālayo ",
  "sn43.44:4.3": "dīpaṃ leṇañca tāṇañca ",
  "sn43.44:4.4": "saraṇañca parāyananti. ",
  "sn43.44:4.5": "asaṅkhatasaṃyuttaṃ samattaṃ. "
}
