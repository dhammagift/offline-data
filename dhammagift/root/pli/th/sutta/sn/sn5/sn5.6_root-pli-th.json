{
  "sn5.6:0.1": "",
  "sn5.6:0.2": "",
  "sn5.6:0.3": "chaṭṭhaṃ cālāsuttaṃ ",
  "sn5.6:1.1": "sāvatthīnidānaṃ. ",
  "sn5.6:1.2": "atha kho cālā bhikkhunī pubbaṇhasamayaṃ nivāsetvā …pe… ",
  "sn5.6:1.3": "aññatarasmiṃ rukkhamūle divāvihāraṃ nisīdi. ",
  "sn5.6:1.4": "atha kho māro pāpimā yena cālā bhikkhunī …pe… upasaṅkamitvā cālaṃ bhikkhuniṃ etadavoca ",
  "sn5.6:1.5": "kiṃ nu kho tvaṃ bhikkhuni na rocesīti. ",
  "sn5.6:1.6": "jātiṃ khvāhaṃ āvuso na rocemīti. ",
  "sn5.6:2.1": "kiṃ nu jātiṃ na rocesi ",
  "sn5.6:2.2": "jāto kāmāni bhuñjati ",
  "sn5.6:2.3": "ko nu tvaṃ idamādapayi ",
  "sn5.6:2.4": "jāti mā roca bhikkhunīti. ",
  "sn5.6:3.1": "jātassa maraṇaṃ hoti ",
  "sn5.6:3.2": "jāto dukkhāni passati ",
  "sn5.6:3.3": "bandhaṃ vadhaṃ pariklesaṃ ",
  "sn5.6:3.4": "tasmā jātiṃ na rocaye ",
  "sn5.6:4.1": "buddho dhammamadesesi ",
  "sn5.6:4.2": "jātiyā samatikkamaṃ ",
  "sn5.6:4.3": "sabbadukkhappahānāya ",
  "sn5.6:4.4": "so maṃ sacce nivesayi ",
  "sn5.6:5.1": "ye ca rūpūpagā sattā ",
  "sn5.6:5.2": "ye ca arūpabhāgino ",
  "sn5.6:5.3": "nirodhaṃ appajānantā ",
  "sn5.6:5.4": "āgantāro punabbhavanti. ",
  "sn5.6:6.1": "atha kho māro pāpimā jānāti maṃ cālā bhikkhunīti dukkhī dummano tatthevantaradhāyīti. "
}
