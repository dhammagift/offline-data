{
  "sn5.8:0.1": "",
  "sn5.8:0.2": "",
  "sn5.8:0.3": "aṭṭhamaṃ sīsupacālāsuttaṃ ",
  "sn5.8:1.1": "sāvatthiyaṃ … ",
  "sn5.8:1.2": "atha kho sīsupacālā bhikkhunī pubbaṇhasamayaṃ nivāsetvā …pe… ",
  "sn5.8:1.3": "aññatarasmiṃ rukkhamūle divāvihāraṃ nisīdi. ",
  "sn5.8:1.4": "atha kho māro pāpimā yena sīsupacālā bhikkhunī tenupasaṅkami upasaṅkamitvā sīsupacāraṃ bhikkhuniṃ etadavoca ",
  "sn5.8:1.5": "kassa nu tvaṃ bhikkhuni pāsaṇḍaṃ rocesīti. ",
  "sn5.8:1.6": "na khvāhaṃ āvuso kassaci pāsaṇḍaṃ rocemīti. ",
  "sn5.8:2.1": "kiṃ nu uddissa muṇḍāsi ",
  "sn5.8:2.2": "samaṇī viya dissasi ",
  "sn5.8:2.3": "na ca rocesi pāsaṇḍaṃ ",
  "sn5.8:2.4": "kimidaṃ carasi momuhāti. ",
  "sn5.8:3.1": "ito bahiddhā pāsaṇḍā ",
  "sn5.8:3.2": "diṭṭhīsu saṃsidanti te ",
  "sn5.8:3.3": "na tesaṃ dhammaṃ rocemi na ",
  "sn5.8:3.4": "te dhammassa kovidā ",
  "sn5.8:4.1": "atthi sakyakule jāto ",
  "sn5.8:4.2": "buddho appaṭipuggalo ",
  "sn5.8:4.3": "sabbābhibhū māranudo ",
  "sn5.8:4.4": "sabbattha maparājito ",
  "sn5.8:5.1": "sabbattha mutto assito ",
  "sn5.8:5.2": "sabbaṃ passati cakkhumā ",
  "sn5.8:5.3": "sabbakammakkhayaṃ patto ",
  "sn5.8:5.4": "vimutto upadhisaṅkhaye ",
  "sn5.8:5.5": "so mayhaṃ bhagavā satthā ",
  "sn5.8:5.6": "tassa rocemi sāsananti. ",
  "sn5.8:6.1": "atha kho māro pāpimā jānāti maṃ sīsupacālā bhikkhunīti dukkhī dummano tatthevantaradhāyīti. "
}
