{
  "sn5.7:0.1": "",
  "sn5.7:0.2": "",
  "sn5.7:0.3": "sattamaṃ upacālāsuttaṃ ",
  "sn5.7:1.1": "sāvatthīnidānaṃ. ",
  "sn5.7:1.2": "atha kho upacālā bhikkhunī pubbaṇhasamayaṃ nivāsetvā …pe… ",
  "sn5.7:1.3": "aññatarasmiṃ rukkhamūle divāvihāraṃ nisīdi. ",
  "sn5.7:1.4": "atha kho māro pāpimā …pe… upacālaṃ bhikkhuniṃ etadavoca ",
  "sn5.7:1.5": "kathannu tvaṃ bhikkhuni uppajjitukāmāti. ",
  "sn5.7:1.6": "na khvāhaṃ āvuso katthaci uppajjitukāmāti. ",
  "sn5.7:2.1": "tāvatiṃsā ca yāmā ca ",
  "sn5.7:2.2": "tusitā cāpi devatā ",
  "sn5.7:2.3": "nimmānaratino devā ",
  "sn5.7:2.4": "ye devā vasavattino ",
  "sn5.7:2.5": "tattha cittaṃ paṇidhehi ",
  "sn5.7:2.6": "rati paccanubhossasīti. ",
  "sn5.7:3.1": "tāvatiṃsā ca yāmā ca ",
  "sn5.7:3.2": "tusitā cāpi devatā ",
  "sn5.7:3.3": "nimmānaratino devā ",
  "sn5.7:3.4": "ye devā vasavattino ",
  "sn5.7:3.5": "kāmabandhanabandhā te ",
  "sn5.7:3.6": "enti māravasaṃ puna ",
  "sn5.7:4.1": "sabbova āditto loko ",
  "sn5.7:4.2": "sabbo loko padhūpito ",
  "sn5.7:4.3": "sabbo pajjalito loko ",
  "sn5.7:4.4": "sabbo loko pakampito ",
  "sn5.7:5.1": "akampitaṃ acalitaṃ ",
  "sn5.7:5.2": "aputhujjanasevitaṃ ",
  "sn5.7:5.3": "agati yattha mārassa ",
  "sn5.7:5.4": "tattha me nirato manoti. ",
  "sn5.7:6.1": "atha kho māro pāpimā jānāti maṃ upacālā bhikkhunīti dukkhī dummano tatthevantaradhāyīti. "
}
