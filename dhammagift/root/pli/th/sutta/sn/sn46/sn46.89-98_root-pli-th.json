  "sn46.89-98:0.1": "",
  "sn46.89-98:0.2": "",
  "sn46.89-98:0.3": "",
  "sn46.89-98:1.1": "gaṅgāpeyyālo navamo. yāvatā bhikkhave sattā apādā vā dvipādā vā catuppādā vā bahuppādā vāti vitthāretabbaṃ. ",
  "sn46.89-98:1.2": "",
  "sn46.89-98:2.0": "",
  "sn46.89-98:2.1": "tathāgataṃ padaṃ kūṭaṃ ",
  "sn46.89-98:2.2": "mūlaṃ sārena vassikaṃ ",
  "sn46.89-98:2.3": "rājā candimasuriyā ca ",
  "sn46.89-98:2.4": "vatthena dasamaṃ padaṃ. ",
  "sn46.89-98:3.1": "(appamādavaggo bojjhaṅgasaṃyuttassa bojjhaṅgavasena vitthāretabbo). "
}
