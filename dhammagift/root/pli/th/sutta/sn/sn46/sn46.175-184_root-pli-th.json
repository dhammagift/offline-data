  "sn46.175-184:0.1": "",
  "sn46.175-184:0.2": "",
  "sn46.175-184:0.3": "",
  "sn46.175-184:1.1": "",
  "sn46.175-184:1.2": "bojjhaṅgasaṃyuttassa esanāvaggo sattarasamo. ",
  "sn46.175-184:2.0": "",
  "sn46.175-184:2.1": "ogho yogo upādānaṃ ",
  "sn46.175-184:2.2": "ganthā anusayena ca ",
  "sn46.175-184:2.3": "kāmaguṇā nīvaraṇā ",
  "sn46.175-184:2.4": "khandhā uddhambhāgiyānīti. (rāgavinayapariyosānadosavinayapariyosānamohavinayapariyosānavasena ",
  "sn46.175-184:3.1": "oghavaggo vitthāretabbo). aṭṭhārasamo. ",
  "sn46.175-184:3.2": "(yadapi maggasaṃyuttaṃ vitthāritaṃ tadapi bojjhaṅgasaṃyuttaṃ vitthāretabbaṃ). ",
  "sn46.175-184:3.3": "bojjhaṅgasaṃyuttaṃ samattaṃ. "
}
