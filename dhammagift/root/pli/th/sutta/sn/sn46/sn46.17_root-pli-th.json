  "sn46.17:0.1": "",
  "sn46.17:0.2": "",
  "sn46.17:0.3": "",
  "sn46.17:1.1": "sattime bhikkhave bojjhaṅgā bhāvitā bahulīkatā apārā pāraṅgamanāya saṃvattanti. ",
  "sn46.17:1.2": "katame satta. ",
  "sn46.17:1.3": "satisambojjhaṅgo. pe. upekkhāsambojjhaṅgo. ",
  "sn46.17:1.4": "ime kho bhikkhave satta bojjhaṅgā bhāvitā bahulīkatā apārā pāraṅgamanāya saṃvattantīti ",
  "sn46.17:2.1": "appakā te manussesu ",
  "sn46.17:2.2": "ye janā pāragāmino ",
  "sn46.17:2.3": "athāyaṃ itarā pajā ",
  "sn46.17:2.4": "tīramevānudhāvati. ",
  "sn46.17:3.1": "ye ca kho sammadakkhāte ",
  "sn46.17:3.2": "dhamme dhammānuvattino ",
  "sn46.17:3.3": "te janā pāramessanti ",
  "sn46.17:3.4": "maccudheyyaṃ suduttaraṃ. ",
  "sn46.17:4.1": "kaṇhaṃ dhammaṃ vippahāya ",
  "sn46.17:4.2": "sukkaṃ bhāvetha paṇḍito ",
  "sn46.17:4.3": "okā anokamāgamma ",
  "sn46.17:4.4": "viveke yattha dūramaṃ. ",
  "sn46.17:5.1": "tatrābhiratimiccheyya ",
  "sn46.17:5.2": "hitvā kāme akiñcano ",
  "sn46.17:5.3": "pariyodapeyya attānaṃ ",
  "sn46.17:5.4": "cittaklesehi paṇḍito. ",
  "sn46.17:6.1": "yesaṃ sambodhiyaṅgesu ",
  "sn46.17:6.2": "sammā cittaṃ subhāvitaṃ ",
  "sn46.17:6.3": "ādānapaṭinissagge ",
  "sn46.17:6.4": "anupādāya ye ratā ",
  "sn46.17:6.5": "khīṇāsavā jutimanto ",
  "sn46.17:6.6": "te loke parinibbutāti. ",
  "sn46.17:6.7": ""
}
