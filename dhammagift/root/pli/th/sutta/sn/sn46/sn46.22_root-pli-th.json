  "sn46.22:1.1": "satta vo bhikkhave bojjhaṅge desissāmi ",
  "sn46.22:1.2": "taṃ suṇātha. ",
  "sn46.22:1.3": "katame ca bhikkhave satta bojjhaṅgā. ",
  "sn46.22:1.4": "satisambojjhaṅgo. pe. upekkhāsambojjhaṅgo. ",
  "sn46.22:1.5": "ime kho bhikkhave satta bojjhaṅgāti. ",
  "sn46.22:1.6": ""
}
