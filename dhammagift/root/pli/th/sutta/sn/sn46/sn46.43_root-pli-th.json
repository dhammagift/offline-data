  "sn46.43:0.1": "",
  "sn46.43:0.2": "",
  "sn46.43:0.3": "",
  "sn46.43:1.1": "mārasenappamaddanaṃ vo bhikkhave maggaṃ desissāmi ",
  "sn46.43:1.2": "taṃ suṇātha. ",
  "sn46.43:1.3": "katamo ca bhikkhave mārasenappamaddano maggo. ",
  "sn46.43:1.4": "yadidaṃ ",
  "sn46.43:1.5": "satta bojjhaṅgā. ",
  "sn46.43:1.6": "katame satta. ",
  "sn46.43:1.7": "satisambojjhaṅgo. pe. upekkhāsambojjhaṅgo. ",
  "sn46.43:1.8": "ayaṃ bhikkhave mārasenappamaddano maggoti. ",
  "sn46.43:1.9": "sāvatthī. "
}
