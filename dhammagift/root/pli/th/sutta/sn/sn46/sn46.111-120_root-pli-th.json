{
  "sn46.111-120:0.1": "",
  "sn46.111-120:0.2": "",
  "sn46.111-120:0.3": "",
  "sn46.111-120:1.1": "tisso imā bhikkhave esanā. ",
  "sn46.111-120:1.2": "katamā tisso. ",
  "sn46.111-120:1.3": "kāmesanā bhavesanā brahmacariyesanāti vitthāretabbaṃ. ",
  "sn46.111-120:1.4": "",
  "sn46.111-120:2.0": "",
  "sn46.111-120:2.1": "esanā vidhā āsavo ",
  "sn46.111-120:2.2": "bhavo ca dukkhatā tisso ",
  "sn46.111-120:2.3": "khīlaṃ malaṃ ca nīgho ca ",
  "sn46.111-120:2.4": "vedanā taṇhāyena cāti. ",
  "sn46.111-120:3.1": "(bojjhaṅgasaṃyuttassa esanāpeyyālaṃ vivekanissitato vidūhi vitthāretabbaṃ). esanāvaggo dvādasamo. "
}
