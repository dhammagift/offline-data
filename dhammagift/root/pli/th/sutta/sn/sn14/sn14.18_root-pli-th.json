  "sn14.18:0.3": "",
  "sn14.18:1.1": "sāvatthiyaṃ viharati … tatra kho bhagavā … ",
  "sn14.18:1.2": "dhātusova bhikkhave sattā saṃsandanti samenti ",
  "sn14.18:1.3": "assaddhā assaddhehi saddhiṃ saṃsandanti samenti ",
  "sn14.18:1.4": "ahirikā ahirikehi saddhiṃ saṃsandanti samenti ",
  "sn14.18:1.5": "duppaññā duppaññehi saddhiṃ saṃsandanti samenti. ",
  "sn14.18:1.6": "saddhā saddhehi saddhiṃ saṃsandanti samenti ",
  "sn14.18:1.7": "hirimanā hirimanehi saddhiṃ saṃsandanti samenti ",
  "sn14.18:1.8": "paññavanto paññavantehi saddhiṃ saṃsandanti samenti. ",
  "sn14.18:1.9": "atītampi bhikkhave addhānaṃ dhātusova sattā saṃsandiṃsu samiṃsu …pe… ",
  "sn14.18:1.10": "anāgatampi bhikkhave addhānaṃ dhātusova sattā saṃsandissanti samessanti …pe… ",
  "sn14.18:2.1": "etarahipi bhikkhave paccuppannaṃ addhānaṃ dhātusova sattā saṃsandanti samenti ",
  "sn14.18:2.2": "assaddhā assaddhehi saddhiṃ saṃsandanti samenti ",
  "sn14.18:2.3": "ahirikā ahirikehi saddhiṃ saṃsandanti samenti duppaññā duppaññehi saddhiṃ saṃsandanti samenti ",
  "sn14.18:2.4": "saddhā saddhehi saddhiṃ saṃsandanti samenti ",
  "sn14.18:2.5": "hirimanā hirimanehi saddhiṃ saṃsandanti samenti ",
  "sn14.18:2.6": "paññavanto paññavantehi saddhiṃ saṃsandanti samenti. ",
  "sn14.18:3.1": "dhātusova bhikkhave sattā saṃsandanti samenti ",
  "sn14.18:3.2": "assaddhā assaddhehi saddhiṃ saṃsandanti samenti ",
  "sn14.18:3.3": "anottāpino anottāpīhi saddhiṃ saṃsandanti samenti ",
  "sn14.18:3.4": "duppaññā duppaññehi saddhiṃ saṃsandanti samenti. ",
  "sn14.18:3.5": "saddhā saddhehi saddhiṃ saṃsandanti samenti ",
  "sn14.18:3.6": "ottāpino ottāpīhi saddhiṃ saṃsandanti samenti ",
  "sn14.18:3.7": "paññavanto paññavantehi saddhiṃ saṃsandanti samenti. ",
  "sn14.18:3.8": "",
  "sn14.18:4.1": "",
  "sn14.18:4.2": "assaddhā assaddhehi saddhiṃ saṃsandanti samenti ",
  "sn14.18:4.3": "appassutā appassutehi saddhiṃ saṃsandanti samenti ",
  "sn14.18:4.4": "duppaññā duppaññehi saddhiṃ saṃsandanti samenti. ",
  "sn14.18:4.5": "saddhā saddhehi saddhiṃ saṃsandanti samenti bahussutā bahussutehi saddhiṃ saṃsandanti samenti paññavanto paññavantehi saddhiṃ saṃsandanti samenti. ",
  "sn14.18:5.1": "",
  "sn14.18:5.2": "assaddhā assaddhehi saddhiṃ saṃsandanti samenti ",
  "sn14.18:5.3": "kusītā kusītehi saddhiṃ saṃsandanti samenti ",
  "sn14.18:5.4": "duppaññā duppaññehi saddhiṃ saṃsandanti samenti. ",
  "sn14.18:5.5": "saddhā saddhehi saddhiṃ saṃsandanti samenti ",
  "sn14.18:5.6": "āraddhaviriyā āraddhaviriyehi saddhiṃ saṃsandanti samenti paññavanto paññavantehi saddhiṃ saṃsandanti samenti. ",
  "sn14.18:6.1": "",
  "sn14.18:6.2": "assaddhā assaddhehi saddhiṃ saṃsandanti samenti ",
  "sn14.18:6.3": "muṭṭhassatino muṭṭhassatīhi saddhiṃ saṃsandanti samenti ",
  "sn14.18:6.4": "duppaññā duppaññehi saddhiṃ saṃsandanti samenti. ",
  "sn14.18:6.5": "saddhā saddhehi saddhiṃ saṃsandanti samenti ",
  "sn14.18:6.6": "upaṭṭhitassatino upaṭṭhitassatīhi saddhiṃ saṃsandanti samenti paññavanto paññavantehi saddhiṃ saṃsandanti samentīti. ",
  "sn14.18:6.7": "aṭṭhamaṃ. "
}
