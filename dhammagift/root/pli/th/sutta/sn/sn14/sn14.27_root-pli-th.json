  "sn14.27:0.1": "",
  "sn14.27:0.2": "",
  "sn14.27:0.3": "",
  "sn14.27:1.1": "sāvatthiyaṃ viharati … tatra kho bhagavā … ",
  "sn14.27:1.2": "dhātusova bhikkhave sattā saṃsandanti samenti ",
  "sn14.27:1.3": "pāṇātipātino pāṇātipātīhi saddhiṃ saṃsandanti samenti ",
  "sn14.27:1.4": "adinnādāyino … ",
  "sn14.27:1.5": "kāmesumicchācārino … ",
  "sn14.27:1.6": "musāvādino … ",
  "sn14.27:1.7": "pisuṇavācā … ",
  "sn14.27:1.8": "pharusavācā … ",
  "sn14.27:1.9": "samphappalāpino samphappalāpīhi saddhiṃ saṃsandanti samenti ",
  "sn14.27:1.10": "abhijjhāluno abhijjhālūhi saddhiṃ saṃsandanti samenti ",
  "sn14.27:1.11": "byāpannacittā byāpannacittehi saddhiṃ saṃsandanti samenti ",
  "sn14.27:1.12": "micchādiṭṭhikā micchādiṭṭhikehi saddhiṃ saṃsandanti samenti. ",
  "sn14.27:2.1": "pāṇātipātā paṭiviratā pāṇātipātā paṭiviratehi saddhiṃ saṃsandanti samenti ",
  "sn14.27:2.2": "adinnādānā paṭiviratā … ",
  "sn14.27:2.3": "kāmesumicchācārā ",
  "sn14.27:2.4": "paṭiviratā … ",
  "sn14.27:2.5": "pisuṇāya vācāya … ",
  "sn14.27:2.6": "pharusāya vācāya … ",
  "sn14.27:2.7": "samphappalāpā paṭiviratā samphappalāpā paṭiviratehi saddhiṃ saṃsandanti samenti ",
  "sn14.27:2.8": "anabhijjhāluno anabhijjhālūhi saddhiṃ saṃsandanti samenti ",
  "sn14.27:2.9": "abyāpannacittā abyāpannacittehi saddhiṃ saṃsandanti samenti ",
  "sn14.27:2.10": "sammādiṭṭhikā sammādiṭṭhikehi saddhiṃ saṃsandanti samentīti. ",
  "sn14.27:2.11": "pañcamaṃ. "
}
