{
  "sn14.26:0.1": "",
  "sn14.26:0.2": "",
  "sn14.26:0.3": "",
  "sn14.26:1.1": "sāvatthiyaṃ viharati … tatra kho bhagavā … ",
  "sn14.26:1.2": "dhātusova bhikkhave sattā saṃsandanti samenti ",
  "sn14.26:1.3": "pāṇātipātino pāṇātipātīhi saddhiṃ saṃsandanti samenti ",
  "sn14.26:1.4": "adinnādāyino adinnādāyīhi saddhiṃ saṃsandanti samenti ",
  "sn14.26:1.5": "kāmesumicchācārino kāmesumicchācārīhi saddhiṃ saṃsandanti samenti ",
  "sn14.26:1.6": "musāvādino musāvādīhi saddhiṃ saṃsandanti samenti ",
  "sn14.26:1.7": "pisuṇavācā pisuṇavācehi saddhiṃ saṃsandanti samenti ",
  "sn14.26:1.8": "pharusavācā pharusavācehi saddhiṃ saṃsandanti samenti ",
  "sn14.26:1.9": "samphappalāpino samphappalāpīhi saddhiṃ saṃsandanti samenti. ",
  "sn14.26:2.1": "pāṇātipātā paṭiviratā … ",
  "sn14.26:2.2": "adinnādānā paṭiviratā … ",
  "sn14.26:2.3": "kāmesumicchācārā paṭiviratā … ",
  "sn14.26:2.4": "musāvādā paṭiviratā … ",
  "sn14.26:2.5": "pisuṇāya vācāya paṭiviratā pisuṇāya vācāya paṭiviratehi saddhiṃ saṃsandanti samenti ",
  "sn14.26:2.6": "pharusāya vācāya paṭiviratā pharusāya vācāya paṭiviratehi saddhiṃ saṃsandanti samenti ",
  "sn14.26:2.7": "samphappalāpā paṭiviratā samphappalāpā paṭiviratehi saddhiṃ saṃsandanti samentīti. ",
  "sn14.26:2.8": "catutthaṃ. "
}
