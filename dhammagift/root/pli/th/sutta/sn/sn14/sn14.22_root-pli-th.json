{
  "sn14.22:0.1": "",
  "sn14.22:0.2": "",
  "sn14.22:0.3": "",
  "sn14.22:1.1": "sāvatthiyaṃ viharati … tatra kho bhagavā … ",
  "sn14.22:1.2": "dhātusova bhikkhave sattā saṃsandanti samenti ",
  "sn14.22:1.3": "kusītā kusītehi saddhiṃ saṃsandanti samenti ",
  "sn14.22:1.4": "muṭṭhassatino muṭṭhassatīhi saddhiṃ saṃsandanti samenti ",
  "sn14.22:1.5": "duppaññā duppaññehi saddhiṃ saṃsandanti samenti. ",
  "sn14.22:1.6": "āraddhaviriyā āraddhaviriyehi saddhiṃ saṃsandanti samenti ",
  "sn14.22:1.7": "upaṭṭhitassatino upaṭṭhitassatīhi saddhiṃ saṃsandanti samenti paññavanto paññavantehi saddhiṃ saṃsandanti samentīti. ",
  "sn14.22:1.8": "dvādasamaṃ. [evaṃ ",
  "sn14.22:1.9": "sabbattha atītānāgatapaccuppannaṃ kātabbaṃ]. dutiyavaggo ",
  "sn14.22:1.10": "dutiyo. tassa uddānaṃ ",
  "sn14.22:2.0": "",
  "sn14.22:2.1": "sattimaṃ sanidānañca ",
  "sn14.22:2.2": "giñjakāvasathena ca ",
  "sn14.22:2.3": "hīnādhimutti caṅkamaṃ ",
  "sn14.22:2.4": "satāpāraddhasattamaṃ ",
  "sn14.22:3.1": "assaddhamūlakā pañca ",
  "sn14.22:3.2": "cattāro ahirikamūlakā ",
  "sn14.22:3.3": "anottappamūlakā tīṇi ",
  "sn14.22:3.4": "dve appassutena ca ",
  "sn14.22:4.1": "kusītaṃ ekakaṃ vuttaṃ ",
  "sn14.22:4.2": "suttantā tīṇi pañcakāti. ",
  "sn14.22:4.3": "",
  "sn14.22:4.4": ""
}
