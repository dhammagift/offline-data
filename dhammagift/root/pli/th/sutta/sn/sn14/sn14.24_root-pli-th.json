{
  "sn14.24:0.1": "",
  "sn14.24:0.2": "",
  "sn14.24:0.3": "",
  "sn14.24:1.1": "sāvatthiyaṃ viharati … tatra kho bhagavā … ",
  "sn14.24:1.2": "dhātusova bhikkhave sattā saṃsandanti samenti ",
  "sn14.24:1.3": "assaddhā assaddhehi saddhiṃ saṃsandanti samenti ",
  "sn14.24:1.4": "ahirikā ahirikehi saddhiṃ saṃsandanti samenti ",
  "sn14.24:1.5": "anottāpino anottāpīhi saddhiṃ saṃsandanti samenti ",
  "sn14.24:1.6": "dussīlā dussīlehi saddhiṃ saṃsandanti samenti ",
  "sn14.24:1.7": "duppaññā duppaññehi saddhiṃ saṃsandanti samenti. ",
  "sn14.24:2.1": "saddhā saddhehi saddhiṃ saṃsandanti samenti ",
  "sn14.24:2.2": "hirimanā hirimanehi saddhiṃ saṃsandanti samenti ",
  "sn14.24:2.3": "ottāpino ottāpīhi saddhiṃ saṃsandanti samenti ",
  "sn14.24:2.4": "sīlavanto sīlavantehi saddhiṃ saṃsandanti samenti ",
  "sn14.24:2.5": "paññavanto paññavantehi saddhiṃ saṃsandanti samentīti. ",
  "sn14.24:2.6": "dutiyaṃ. "
}
