  "sn14.38:0.1": "",
  "sn14.38:0.2": "",
  "sn14.38:0.3": "",
  "sn14.38:1.1": "sāvatthiyaṃ viharati … tatra kho bhagavā … ",
  "sn14.38:1.2": "catasso imā bhikkhave dhātuyo ",
  "sn14.38:1.3": "katamā catasso ",
  "sn14.38:1.4": "paṭhavīdhātu āpodhātu tejodhātu vāyodhātu. ",
  "sn14.38:1.5": "ye hi keci bhikkhave samaṇā vā brāhmaṇā vā imāsaṃ catunnaṃ dhātūnaṃ samudayañca atthaṅgamañca assādañca ādī navañca nissaraṇañca yathābhūtaṃ nappajānanti ",
  "sn14.38:1.6": "[vitthāretabbaṃ] ",
  "sn14.38:1.7": "pajā nanti … ",
  "sn14.38:1.8": "sayaṃ abhiññā sacchikatvā upasampajja viharantīti. ",
  "sn14.38:1.9": "navamaṃ. "
}
