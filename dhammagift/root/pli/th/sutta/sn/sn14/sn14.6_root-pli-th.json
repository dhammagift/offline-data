  "sn14.6:0.3": "",
  "sn14.6:1.1": "sāvatthiyaṃ viharati … tatra kho bhagavā … ",
  "sn14.6:1.2": "dhātunānattaṃ vo bhikkhave desissāmi ",
  "sn14.6:1.3": "taṃ suṇātha … ",
  "sn14.6:1.4": "katamañca bhikkhave dhātunānattaṃ. ",
  "sn14.6:1.5": "rūpadhātu saddadhātu gandhadhātu rasadhātu phoṭṭhabbadhātu dhammadhātu. ",
  "sn14.6:1.6": "idaṃ vuccati bhikkhave dhātunānattanti. ",
  "sn14.6:1.7": "chaṭṭhaṃ. "
}
