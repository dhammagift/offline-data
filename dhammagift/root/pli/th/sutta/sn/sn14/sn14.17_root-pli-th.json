{
  "sn14.17:0.1": "",
  "sn14.17:0.2": "",
  "sn14.17:0.3": "",
  "sn14.17:1.1": "sāvatthiyaṃ viharati … tatra kho bhagavā … etadavoca ",
  "sn14.17:1.2": "dhātusova bhikkhave sattā saṃsandanti samenti ",
  "sn14.17:1.3": "assaddhā assaddhehi saddhiṃ saṃsandanti samenti ",
  "sn14.17:1.4": "ahirikā ahirikehi saddhiṃ saṃsandanti samenti ",
  "sn14.17:1.5": "anottāpino anottāpīhi saddhiṃ saṃsandanti samenti ",
  "sn14.17:1.6": "appassutā appassutehi saddhiṃ saṃsandanti samenti ",
  "sn14.17:1.7": "kusītā kusītehi saddhiṃ saṃsandanti samenti ",
  "sn14.17:1.8": "muṭṭhassatino muṭṭhassatīhi saddhiṃ saṃsandanti samenti ",
  "sn14.17:1.9": "duppaññā duppaññehi saddhiṃ saṃsandanti samenti. ",
  "sn14.17:2.1": "atītampi bhikkhave addhānaṃ dhātusova sattā saṃsandiṃsu samiṃsu ",
  "sn14.17:2.2": "assaddhā assaddhehi saddhiṃ saṃsandiṃsu samiṃsu ",
  "sn14.17:2.3": "ahirikā ahirikehi saddhiṃ saṃsandiṃsu samiṃsu ",
  "sn14.17:2.4": "anottāpino anottāpīhi saddhiṃ saṃsandiṃsu samiṃsu ",
  "sn14.17:2.5": "appassutā appassutehi saddhiṃ saṃsandiṃsu samiṃsu ",
  "sn14.17:2.6": "kusītā kusītehi saddhiṃ saṃsandiṃsu samiṃsu ",
  "sn14.17:2.7": "muṭṭhassatino muṭṭhassatīhi saddhiṃ saṃsandiṃsu samiṃsu ",
  "sn14.17:2.8": "duppaññā duppaññehi saddhiṃ saṃsandiṃsu samiṃsu. ",
  "sn14.17:3.1": "anāgatampi bhikkhave addhānaṃ dhātusova sattā saṃsandissanti samessanti ",
  "sn14.17:3.2": "assaddhā assaddhehi saddhiṃ saṃsandissanti samessanti ",
  "sn14.17:3.3": "ahirikā ahirikehi saddhiṃ saṃsandissanti samessanti ",
  "sn14.17:3.4": "anottāpino anottāpīhi saddhiṃ … ",
  "sn14.17:3.5": "appassutā appassutehi saddhiṃ … ",
  "sn14.17:3.6": "kusītā kusītehi saddhiṃ … ",
  "sn14.17:3.7": "muṭṭhassatino muṭṭhassatīhi saddhiṃ … ",
  "sn14.17:3.8": "duppaññā duppaññehi saddhiṃ saṃsandissanti samessanti. ",
  "sn14.17:4.1": "etarahipi bhikkhave paccuppannaṃ addhānaṃ dhātusova sattā saṃsandanti samenti ",
  "sn14.17:4.2": "assaddhā assaddhehi saddhiṃ saṃsandanti samenti ",
  "sn14.17:4.3": "ahirikā ahirikehi saddhiṃ …pe… ",
  "sn14.17:4.4": "anottāpino anottāpīhi saddhiṃ … ",
  "sn14.17:4.5": "appassutā appassutehi saddhiṃ … ",
  "sn14.17:4.6": "kusītā kusītehi saddhiṃ … ",
  "sn14.17:4.7": "muṭṭhassatino muṭṭhassatīhi saddhiṃ … ",
  "sn14.17:4.8": "duppaññā duppaññehi saddhiṃ saṃsandanti samenti. ",
  "sn14.17:5.1": "dhātusova bhikkhave sattā saṃsandanti samenti ",
  "sn14.17:5.2": "saddhā saddhehi saddhiṃ saṃsandanti samenti ",
  "sn14.17:5.3": "hirimanā hirimanehi saddhiṃ saṃsandanti samenti ",
  "sn14.17:5.4": "ottāpino ottāpīhi saddhiṃ saṃsandanti samenti ",
  "sn14.17:5.5": "bahussutā bahussutehi saddhiṃ saṃsandanti samenti ",
  "sn14.17:5.6": "āraddhaviriyā āraddhaviriyehi saddhiṃ saṃsandanti samenti ",
  "sn14.17:5.7": "upaṭṭhitassatino upaṭṭhitassatīhi saddhiṃ saṃsandanti samenti ",
  "sn14.17:5.8": "paññavanto paññavantehi saddhiṃ saṃsandanti samenti. ",
  "sn14.17:5.9": "atītampi bhikkhave addhānaṃ …pe… ",
  "sn14.17:5.10": "anāgatampi bhikkhave addhānaṃ …pe… ",
  "sn14.17:5.11": "etarahipi bhikkhave paccuppannaṃ ",
  "sn14.17:5.12": "…pe… ",
  "sn14.17:5.13": "saṃsandanti samentīti. ",
  "sn14.17:5.14": "sattamaṃ. "
}
