  "sn14.2:0.1": "",
  "sn14.2:0.2": "",
  "sn14.2:0.3": "",
  "sn14.2:1.1": "sāvatthiyaṃ viharati … tatra kho bhagavā … ",
  "sn14.2:1.2": "dhātunānattaṃ bhikkhave paṭicca uppajjati phassanānattaṃ. ",
  "sn14.2:1.3": "katamañca bhikkhave dhātunānattaṃ. ",
  "sn14.2:1.4": "cakkhudhātu sotadhātu ghānadhātu jivhādhātu kāyadhātu manodhātu. ",
  "sn14.2:1.5": "idaṃ vuccati bhikkhave dhātunānattaṃ. ",
  "sn14.2:2.1": "katamañca bhikkhave dhātunānattaṃ paṭicca uppajjati phassa nānattaṃ. ",
  "sn14.2:2.2": "cakkhudhātuṃ bhikkhave paṭicca uppajjati cakkhusamphasso ",
  "sn14.2:2.3": "sotadhātuṃ paṭicca … ",
  "sn14.2:2.4": "ghānadhātuṃ paṭicca … ",
  "sn14.2:2.5": "jivhādhātuṃ paṭicca … ",
  "sn14.2:2.6": "kāya dhātuṃ paṭicca … ",
  "sn14.2:2.7": "manodhātuṃ paṭicca uppajjati manosamphasso. ",
  "sn14.2:2.8": "evaṃ kho bhikkhave dhātunānattaṃ paṭicca uppajjati phassanānattanti. ",
  "sn14.2:2.9": "dutiyaṃ. "
}
