  "sn14.20:0.1": "",
  "sn14.20:0.2": "",
  "sn14.20:0.3": "",
  "sn14.20:1.1": "sāvatthiyaṃ viharati … tatra kho bhagavā … ",
  "sn14.20:1.2": "dhātusova bhikkhave sattā saṃsandanti samenti ",
  "sn14.20:1.3": "anottāpino anottāpīhi saddhiṃ saṃsandanti samenti ",
  "sn14.20:1.4": "appassutā appassutehi saddhiṃ saṃsandanti samenti ",
  "sn14.20:1.5": "duppaññā duppaññehi saddhiṃ saṃsandanti samenti. ",
  "sn14.20:1.6": "ottāpino ottāpīhi saddhiṃ saṃsandanti samenti ",
  "sn14.20:1.7": "bahussutā bahussutehi saddhiṃ saṃsandanti samenti paññavanto paññavantehi saddhiṃ saṃsandanti samenti. anottāpino ",
  "sn14.20:2.1": "anottāpīhi saddhiṃ saṃsandanti samenti ",
  "sn14.20:2.2": "kusītā kusītehi saddhiṃ saṃsandanti samenti ",
  "sn14.20:2.3": "duppaññā duppaññehi saddhiṃ saṃsandanti samenti. ",
  "sn14.20:2.4": "ottāpino ottāpīhi saddhiṃ saṃsandanti samenti ",
  "sn14.20:2.5": "āraddhaviriyā āraddhaviriyehi saddhiṃ saṃsandanti samenti paññavanto paññavantehi saddhiṃ saṃsandanti samenti. anottāpino ",
  "sn14.20:3.1": "anottāpīhi saddhiṃ saṃsanadanti samenti ",
  "sn14.20:3.2": "muṭṭhassatino muṭṭhassatīhi saddhiṃ saṃsandanti samenti ",
  "sn14.20:3.3": "duppaññā duppaññehi saddhiṃ saṃsandanti samenti. ",
  "sn14.20:3.4": "ottāpino ottāpīhi saddhiṃ saṃsandanti samenti ",
  "sn14.20:3.5": "upaṭṭhitassatino upaṭṭhitassatīhi saddhiṃ saṃsandanti samenti paññavanto paññavantehi saddhiṃ saṃsandanti samentīti. ",
  "sn14.20:3.6": "dasamaṃ. "
}
