{
  "sn2.21:0.1": "",
  "sn2.21:0.2": "nānātitthiyavaggo tatiyo ",
  "sn2.21:0.3": "paṭhamaṃ sivasuttaṃ ",
  "sn2.21:1.1": "evamme sutaṃ ",
  "sn2.21:1.2": "ekaṃ samayaṃ bhagavā sāvatthiyaṃ viharati jetavane anāthapiṇḍikassa ārāme. ",
  "sn2.21:1.3": "atha kho sivo devaputto abhikkantāya rattiyā abhikkantavaṇṇo kevalakappaṃ jetavanaṃ obhāsetvā yena bhagavā tenupasaṅkami upasaṅkamitvā bhagavantaṃ abhivādetvā ekamantaṃ aṭṭhāsi. ",
  "sn2.21:1.4": "ekamantaṃ ṭhito kho sivo devaputto bhagavato santike imā gāthāyo abhāsi ",
  "sn2.21:2.1": "sabbhireva samāsetha ",
  "sn2.21:2.2": "sabbhi kubbetha santhavaṃ ",
  "sn2.21:2.3": "sataṃ saddhammamaññāya ",
  "sn2.21:2.4": "seyyo hoti na pāpiyo ",
  "sn2.21:3.1": "sabbhireva samāsetha ",
  "sn2.21:3.2": "sabbhi kubbetha santhavaṃ ",
  "sn2.21:3.3": "sataṃ saddhammamaññāya ",
  "sn2.21:3.4": "paññaṃ labhati nāññato ",
  "sn2.21:4.1": "sabbhireva samāsetha ",
  "sn2.21:4.2": "sabbhi kubbetha santhavaṃ ",
  "sn2.21:4.3": "sataṃ saddhammamaññāya ",
  "sn2.21:4.4": "sokamajjhe na socati ",
  "sn2.21:5.1": "sabbhireva samāsetha ",
  "sn2.21:5.2": "sabbhi kubbetha santhavaṃ ",
  "sn2.21:5.3": "sataṃ saddhammamaññāya ",
  "sn2.21:5.4": "ñātimajjhe virocati ",
  "sn2.21:6.1": "sabbhireva samāsetha ",
  "sn2.21:6.2": "sabbhi kubbetha santhavaṃ ",
  "sn2.21:6.3": "sataṃ saddhammamaññāya ",
  "sn2.21:6.4": "sattā gacchanti sugatiṃ ",
  "sn2.21:7.1": "sabbhireva samāsetha ",
  "sn2.21:7.2": "sabbhi kubbetha santhavaṃ ",
  "sn2.21:7.3": "sataṃ saddhammamaññāya ",
  "sn2.21:7.4": "sattā tiṭṭhanti sātatanti. ",
  "sn2.21:8.1": "atha kho bhagavā sivaṃ devaputtaṃ gāthāya ajjhabhāsi ",
  "sn2.21:9.1": "sabbhireva samāsetha ",
  "sn2.21:9.2": "sabbhi kubbetha santhavaṃ ",
  "sn2.21:9.3": "sataṃ saddhammamaññāya ",
  "sn2.21:9.4": "sabbadukkhā pamuccatīti. "
}
