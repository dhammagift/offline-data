{
  "sn2.17:0.1": "",
  "sn2.17:0.2": "",
  "sn2.17:0.3": "sattamaṃ subrahmasuttaṃ ",
  "sn2.17:1.1": "ekamantaṃ ṭhito kho subrahmā devaputto bhagavantaṃ gāthāya ajjhabhāsi ",
  "sn2.17:2.1": "niccamutrastamidaṃ cittaṃ ",
  "sn2.17:2.2": "niccamubbiggamidaṃ mano ",
  "sn2.17:2.3": "anuppannesu kiccesu ",
  "sn2.17:2.4": "atho uppattitesu ca ",
  "sn2.17:2.5": "sace atthi anutrastaṃ ",
  "sn2.17:2.6": "taṃ me akkhāhi pucchitoti. ",
  "sn2.17:3.1": "nāññatra bojjhaṅga tapasā ",
  "sn2.17:3.2": "nāññatra indriyasaṃvarā ",
  "sn2.17:3.3": "nāññatra sabbanissaggā ",
  "sn2.17:3.4": "sotthiṃ passāmi pāṇinanti. ",
  "sn2.17:4.1": "idamavoca. pe. ",
  "sn2.17:4.2": "tatthevantaradhāyīti. "
}
