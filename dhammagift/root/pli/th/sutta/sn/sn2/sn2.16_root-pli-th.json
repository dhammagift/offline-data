{
  "sn2.16:0.1": "",
  "sn2.16:0.2": "",
  "sn2.16:0.3": "chaṭṭhaṃ vāsudattasuttaṃ ",
  "sn2.16:1.1": "ekamantaṃ ṭhito kho vāsudatto devaputto bhagavato santike imaṃ gāthaṃ abhāsi ",
  "sn2.16:2.1": "sattiyā viya omaṭṭho ",
  "sn2.16:2.2": "ḍayhamāneva matthake ",
  "sn2.16:2.3": "kāmarāgappahānāya ",
  "sn2.16:2.4": "sato bhikkhu paribbajeti. ",
  "sn2.16:3.1": "sattiyā viya omaṭṭho ",
  "sn2.16:3.2": "ḍayhamāneva matthake ",
  "sn2.16:3.3": "sakkāyadiṭṭhippahānāya ",
  "sn2.16:3.4": "sato bhikkhu paribbajeti. "
}
