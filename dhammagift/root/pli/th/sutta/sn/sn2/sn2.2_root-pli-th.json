{
  "sn2.2:0.1": "",
  "sn2.2:0.2": "",
  "sn2.2:0.3": "dutiyaṃ dutiyakassapasuttaṃ ",
  "sn2.2:1.1": "sāvatthiyaṃ ārāme ... ",
  "sn2.2:1.2": "ekamantaṃ ṭhito kho kassapoṭa devaputto bhagavato santike imaṃ gāthaṃ abhāsi ",
  "sn2.2:2.1": "bhikkhu siyā jhāyi vimuttacitto ",
  "sn2.2:2.2": "ākaṅkhe ve hadayassānupattiṃ ",
  "sn2.2:2.3": "lokassa ñatvā udayabyañca ",
  "sn2.2:2.4": "sucetaso anissito tadānisaṃ soti. "
}
