{
  "sn2.12:0.1": "",
  "sn2.12:0.2": "",
  "sn2.12:0.3": "dutiyaṃ veṇḍusuttaṃ ",
  "sn2.12:1.1": "ekamantaṃ ṭhito kho veṇḍu devaputto bhagavato santike imaṃ gāthaṃ abhāsi ",
  "sn2.12:2.1": "sukhitā vata te manujā ",
  "sn2.12:2.2": "sugataṃ payirupāsiya ",
  "sn2.12:2.3": "yuñja gotamasāsane ",
  "sn2.12:2.4": "appamattānusikkhareti. ",
  "sn2.12:3.1": "ye me vutte satthipade ",
  "sn2.12:3.2": "[veṇḍūti bhagavā] ",
  "sn2.12:3.3": "anusikkhanti jhāyino ",
  "sn2.12:3.4": "kāle te appamajjantā ",
  "sn2.12:3.5": "na maccuvasagā siyunti. "
}
