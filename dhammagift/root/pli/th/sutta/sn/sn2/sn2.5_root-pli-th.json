{
  "sn2.5:0.1": "",
  "sn2.5:0.2": "",
  "sn2.5:0.3": "pañcamaṃ dāmalisuttaṃ ",
  "sn2.5:1.1": "sāvatthiyaṃ ārāme ... ",
  "sn2.5:1.2": "atha kho dāmali devaputto abhikkantāya rattiyā abhikkantavaṇṇo kevalakappaṃ jetavanaṃ obhāsetvā yena bhagavā tenupasaṅkami upasaṅkamitvā bhagavantaṃ abhivādetvā ekamantaṃ aṭṭhāsi. ",
  "sn2.5:1.3": "ekamantaṃ ṭhito kho dāmali devaputto bhagavato santike imaṃ gāthaṃ abhāsi ",
  "sn2.5:2.1": "karaṇīyametaṃ brāhmaṇena ",
  "sn2.5:2.2": "padhānamakilāsunā ",
  "sn2.5:2.3": "kāmānaṃ vippahānena ",
  "sn2.5:2.4": "na tenāsiṃsate bhavanti. ",
  "sn2.5:3.1": "natthi kiccaṃ brāhmaṇassa ",
  "sn2.5:3.2": "[dāmalīti bhagavā] ",
  "sn2.5:3.3": "katakicco hi brāhmaṇo ",
  "sn2.5:3.4": "yāva na gādhaṃ labhati nadīsu ",
  "sn2.5:3.5": "āyūhati sabbagattebhi jantu ",
  "sn2.5:3.6": "gādhañca laddhāna thale ṭhito so ",
  "sn2.5:3.7": "nāyūhati pāragato hi hoti ",
  "sn2.5:4.1": "esūpamā dāmali brāhmaṇassa ",
  "sn2.5:4.2": "khīṇāsavassa nipakassa jhāyino ",
  "sn2.5:4.3": "pappuyya jātimaraṇassa antaṃ ",
  "sn2.5:4.4": "nāyūhati pāragato hi hotīti. "
}
