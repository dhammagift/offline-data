{
  "sn2.24:0.1": "",
  "sn2.24:0.2": "",
  "sn2.24:0.3": "catutthaṃ ghaṭikārasuttaṃ ",
  "sn2.24:1.1": "ekamantaṃ ṭhito kho ghaṭikāro devaputto bhagavato santike imaṃ gāthaṃ abhāsi ",
  "sn2.24:2.1": "avihaṃ upapannāse ",
  "sn2.24:2.2": "vimuttā satta bhikkhavo ",
  "sn2.24:2.3": "rāgadosaparikkhīṇā ",
  "sn2.24:2.4": "tiṇṇā loke visattikanti. ",
  "sn2.24:3.1": "ye ca te ataruṃ saṅgaṃ ",
  "sn2.24:3.2": "maccudheyyaṃ suduttaraṃ ",
  "sn2.24:3.3": "te hitvā mānusaṃ dehaṃ ",
  "sn2.24:3.4": "dibbayogamupaccagunti. ",
  "sn2.24:4.1": "upako phalagaṇḍo ca ",
  "sn2.24:4.2": "pukkusāti ca te tayo ",
  "sn2.24:4.3": "bhaddiyo khaṇḍadevo ca ",
  "sn2.24:4.4": "bāhuraggi ca siṅgiyo ",
  "sn2.24:4.5": "te hitvā mānusaṃ dehaṃ ",
  "sn2.24:4.6": "dibbayogamupaccagunti. ",
  "sn2.24:5.1": "kusalī bhāsasī tesaṃ ",
  "sn2.24:5.2": "mārapāsappahāyinaṃ ",
  "sn2.24:5.3": "kassa te dhammamaññāya ",
  "sn2.24:5.4": "acchiduṃ bhavabandhananti. ",
  "sn2.24:6.1": "na aññatra bhagavatā ",
  "sn2.24:6.2": "nāññatra tava sāsanā ",
  "sn2.24:6.3": "yassa te dhammamaññāya ",
  "sn2.24:6.4": "acchiduṃ bhavabandhanaṃ ",
  "sn2.24:7.1": "yattha nāmañca rūpañca ",
  "sn2.24:7.2": "asesaṃ uparujjhati ",
  "sn2.24:7.3": "taṃ te dhammamidhaññāya ",
  "sn2.24:7.4": "acchiduṃ bhavabandhananti. ",
  "sn2.24:8.1": "gambhīraṃ bhāsasī vācaṃ ",
  "sn2.24:8.2": "dubbijānaṃ sudubbudhaṃ ",
  "sn2.24:8.3": "kassa tvaṃ dhammamaññāya ",
  "sn2.24:8.4": "vācaṃ bhāsasi īdisanti. ",
  "sn2.24:9.1": "kumbhakāro pure āsiṃ ",
  "sn2.24:9.2": "vebhaḷiṅge ghaṭīkaro ",
  "sn2.24:9.3": "mātāpettibharo āsiṃ ",
  "sn2.24:9.4": "kassapassa upāsako ",
  "sn2.24:10.1": "virato methunā dhammā ",
  "sn2.24:10.2": "brahmacārī nirāmiso ",
  "sn2.24:10.3": "ahuvā te sagāmeyyo ",
  "sn2.24:10.4": "ahuvā te pure sakhā ",
  "sn2.24:11.1": "sohamete pajānāmi ",
  "sn2.24:11.2": "vimutte satta bhikkhavo ",
  "sn2.24:11.3": "rāgadosaparikkhīṇe ",
  "sn2.24:11.4": "tiṇṇe loke visattikanti. ",
  "sn2.24:12.1": "evametaṃ tadā āsi ",
  "sn2.24:12.2": "yathā bhāsasi bhaggava ",
  "sn2.24:12.3": "kumbhakāro pure āsi ",
  "sn2.24:12.4": "vebhaḷiṅge ghaṭīkaro ",
  "sn2.24:13.1": "mātāpettibharo āsi ",
  "sn2.24:13.2": "kassapassa upāsako ",
  "sn2.24:13.3": "virato methunā dhammā ",
  "sn2.24:13.4": "brahmacārī nirāmiso ",
  "sn2.24:13.5": "ahuvā me sagāmeyyo ",
  "sn2.24:13.6": "ahuvā me pure sakhāti. ",
  "sn2.24:14.1": "evametaṃ purāṇānaṃ ",
  "sn2.24:14.2": "sahāyānamahu saṅgamo ",
  "sn2.24:14.3": "ubhinnaṃ bhāvitattānaṃ ",
  "sn2.24:14.4": "sarīrantimadhārinanti. "
}
