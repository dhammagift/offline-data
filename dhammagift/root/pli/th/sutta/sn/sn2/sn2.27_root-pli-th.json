{
  "sn2.27:0.1": "",
  "sn2.27:0.2": "",
  "sn2.27:0.3": "sattamaṃ nandasuttaṃ ",
  "sn2.27:1.1": "ekamantaṃ ṭhito kho nando devaputto bhagavato santike imaṃ gāthaṃ abhāsi ",
  "sn2.27:2.1": "accenti kālā tarayanti rattiyo ",
  "sn2.27:2.2": "vayoguṇā anupubbaṃ jahanti ",
  "sn2.27:2.3": "etaṃ bhayaṃ maraṇe pekkhamāno ",
  "sn2.27:2.4": "puññāni kayirātha sukhāvahānīti. ",
  "sn2.27:3.1": "accenti kālā tarayanti rattiyo ",
  "sn2.27:3.2": "vayoguṇā anupubbaṃ jahanti ",
  "sn2.27:3.3": "etaṃ bhayaṃ maraṇe pekkhamāno ",
  "sn2.27:3.4": "lokāmisaṃ pajahe santipekkhoti. "
}
