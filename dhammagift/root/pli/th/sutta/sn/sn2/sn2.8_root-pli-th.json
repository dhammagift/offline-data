{
  "sn2.8:0.1": "",
  "sn2.8:0.2": "",
  "sn2.8:0.3": "aṭṭhamaṃ tāyanasuttaṃ ",
  "sn2.8:1.1": "",
  "sn2.8:1.2": "atha kho tāyano devaputto purāṇatitthakaro abhikkantāya rattiyā abhikkantavaṇṇo kevalakappaṃ jetavanaṃ obhāsetvā yena bhagavā tenupasaṅkami upasaṅkamitvā bhagavantaṃ abhivādetvā ekamantaṃ aṭṭhāsi. ",
  "sn2.8:1.3": "ekamantaṃ ṭhito kho tāyano devaputto bhagavato santike imā gāthāyo abhāsi ",
  "sn2.8:2.1": "chinda sotaṃ parakkamma ",
  "sn2.8:2.2": "kāme panūda brāhmaṇa ",
  "sn2.8:2.3": "nappahāya muni kāme ",
  "sn2.8:2.4": "nekattamupapajjati ",
  "sn2.8:3.1": "kayirā ce kayirāthenaṃ ",
  "sn2.8:3.2": "daḷhamenaṃ parakkame ",
  "sn2.8:3.3": "sithilo hi paribbājo ",
  "sn2.8:3.4": "bhiyyo ākirate rajaṃ ",
  "sn2.8:4.1": "akataṃ dukkaṭaṃ seyyo ",
  "sn2.8:4.2": "pacchā tappati dukkaṭaṃ ",
  "sn2.8:4.3": "katañca sukataṃ seyyo ",
  "sn2.8:4.4": "yaṃ katvā nānutappati ",
  "sn2.8:5.1": "kuso yathā duggahito ",
  "sn2.8:5.2": "hatthamevānukantati ",
  "sn2.8:5.3": "sāmaññaṃ dupparāmaṭṭhaṃ ",
  "sn2.8:5.4": "nirayāyūpakaḍḍhati ",
  "sn2.8:6.1": "yaṅkiñci sithilaṃ kammaṃ ",
  "sn2.8:6.2": "saṅkiliṭṭhañca yaṃ vataṃ ",
  "sn2.8:6.3": "saṅkassaraṃ brahmacariyaṃ ",
  "sn2.8:6.4": "na taṃ hoti mahapphalanti. ",
  "sn2.8:7.1": "idamavoca tāyano devaputto ",
  "sn2.8:7.2": "idaṃ vatvā bhagavantaṃ abhivādetvā padakkhiṇaṃ katvā tatthevantaradhāyīti. ",
  "sn2.8:8.1": "atha kho bhagavā tassā rattiyā accayena bhikkhū āmantesi ",
  "sn2.8:8.2": "imaṃ bhikkhave rattiṃ tāyano nāma devaputto purāṇatitthakaro abhikkantāya rattiyā abhikkantavaṇṇo kevalakappaṃ jetavanaṃ obhāsetvā yenāhaṃ tenupasaṅkami upasaṅkamitvā maṃ abhivādetvā ekamantaṃ aṭṭhāsi ",
  "sn2.8:8.3": "ekamantaṃ ṭhito kho tāyano devaputto mama santike imā gāthāyo abhāsi ",
  "sn2.8:9.1": "chinda sotaṃ parakkamma ",
  "sn2.8:9.2": "kāme panūda brāhmaṇa ",
  "sn2.8:9.3": "nappahāya muni kāme ",
  "sn2.8:9.4": "nekattamupapajjati ",
  "sn2.8:10.1": "kayirā ce kayirāthenaṃ ",
  "sn2.8:10.2": "daḷhamenaṃ parakkame ",
  "sn2.8:10.3": "sithilo hi paribbājo ",
  "sn2.8:10.4": "bhiyyo ākirate rajaṃ ",
  "sn2.8:11.1": "akataṃ dukkaṭaṃ seyyo ",
  "sn2.8:11.2": "pacchā tappati dukkaṭaṃ ",
  "sn2.8:11.3": "katañca sukataṃ seyyo ",
  "sn2.8:11.4": "yaṃ katvā nānutappati ",
  "sn2.8:12.1": "kuso yathā duggahito ",
  "sn2.8:12.2": "hatthamevānukantati ",
  "sn2.8:12.3": "sāmaññaṃ dupparāmaṭṭhaṃ ",
  "sn2.8:12.4": "nirayāyūpakaḍḍhati ",
  "sn2.8:13.1": "yaṅkiñci sithilaṃ kammaṃ ",
  "sn2.8:13.2": "saṅkiliṭṭhañca yaṃ vataṃ ",
  "sn2.8:13.3": "saṅkassaraṃ brahmacariyaṃ ",
  "sn2.8:13.4": "na taṃ hoti mahapphalanti. ",
  "sn2.8:14.1": "idamavoca bhikkhave tāyano devaputto idaṃ vatvā maṃ abhivādetvātha padakkhiṇaṃ katvā tatthevantaradhāyi ",
  "sn2.8:14.2": "uggaṇhātha bhikkhave tāyanagāthā ",
  "sn2.8:14.3": "pariyāpuṇātha bhikkhave tāyanagāthā ",
  "sn2.8:14.4": "dhāretha bhikkhave tāyanagāthā ",
  "sn2.8:14.5": "atthasañhitā bhikkhave tāyanagāthā ādibrahmacariyakāti. "
}
