{
  "sn2.25:0.1": "",
  "sn2.25:0.2": "",
  "sn2.25:0.3": "pañcamaṃ jantusuttaṃ ",
  "sn2.25:1.1": "evamme sutaṃ ",
  "sn2.25:1.2": "ekaṃ samayaṃ sambahulā bhikkhū kosalesu viharanti himavantapasse araññakuṭikāyaṃ uddhatā unnaḷā capalā mukharā vikiṇṇavācā muṭṭhassatino asampajānā asamāhitā vibbhantacittā pākatindriyā. ",
  "sn2.25:2.1": "atha kho jantu devaputto tadahuposathe paṇṇarase yena te bhikkhū tenupasaṅkami upasaṅkamitvā te bhikkhū gāthāhi ajjhabhāsi ",
  "sn2.25:3.1": "sukhajīvino pure āsuṃ ",
  "sn2.25:3.2": "bhikkhū gotamasāvakā ",
  "sn2.25:3.3": "anicchā piṇḍamesanā ",
  "sn2.25:3.4": "anicchā sayanāsanaṃ ",
  "sn2.25:3.5": "loke aniccataṃ ñatvā ",
  "sn2.25:3.6": "dukkhassantamakaṃsu te ",
  "sn2.25:4.1": "dupposaṃ katvā attānaṃ ",
  "sn2.25:4.2": "gāme gāmaṇikā viya ",
  "sn2.25:4.3": "bhutvā bhutvā nipajjanti ",
  "sn2.25:4.4": "parāgāresu mucchitā ",
  "sn2.25:5.1": "saṃghassa añjaliṃ katvā ",
  "sn2.25:5.2": "idhekacce vadāmahaṃ ",
  "sn2.25:5.3": "apaviṭṭhā anāthā te ",
  "sn2.25:5.4": "yathā petā tatheva te ",
  "sn2.25:6.1": "ye kho pamattā viharanti ",
  "sn2.25:6.2": "te me sandhāya bhāsitaṃ ",
  "sn2.25:6.3": "ye appamattā viharanti ",
  "sn2.25:6.4": "namo tesaṃ karomahanti. "
}
