  "sn12.45:0.3": "",
  "sn12.45:1.1": "evamme sutaṃ ",
  "sn12.45:1.2": "ekaṃ samayaṃ bhagavā ñātike viharati giñjakāvasathe. ",
  "sn12.45:1.3": "atha kho bhagavā rahogato paṭisallīno imaṃ dhammapariyāyaṃ abhāsi ",
  "sn12.45:2.1": "cakkhuñca paṭicca rūpe ca uppajjati cakkhuviññāṇaṃ tiṇṇaṃ saṅgati phasso ",
  "sn12.45:2.2": "phassapaccayā vedanā ",
  "sn12.45:2.3": "vedanāpaccayā taṇhā ",
  "sn12.45:2.4": "taṇhāpaccayā upādānaṃ …pe… ",
  "sn12.45:2.5": "evametassa kevalassa dukkhakkhandhassa samudayo hoti. ",
  "sn12.45:3.1": "sotañca paṭicca sadde ca … ",
  "sn12.45:3.2": "ghānañca paṭicca gandhe ca … ",
  "sn12.45:3.3": "jivhañca paṭicca rase ca … ",
  "sn12.45:3.4": "kāyañca paṭicca phoṭṭhabbe ca … ",
  "sn12.45:3.5": "manañca paṭicca dhamme ca uppajjati manoviññāṇaṃ tiṇṇaṃ saṅgati phasso ",
  "sn12.45:3.6": "phassapaccayā vedanā ",
  "sn12.45:3.7": "vedanāpaccayā taṇhā ",
  "sn12.45:3.8": "taṇhāpaccayā upādānaṃ …pe… ",
  "sn12.45:3.9": "evametassa kevalassa dukkhakkhandhassa samudayo hoti. ",
  "sn12.45:4.1": "cakkhuñca paṭicca rūpe ca uppajjati cakkhuviññāṇaṃ tiṇṇaṃ saṅgati phasso ",
  "sn12.45:4.2": "phassapaccayā vedanā ",
  "sn12.45:4.3": "vedanāpaccayā taṇhā ",
  "sn12.45:4.4": "tassāyeva taṇhāya asesavirāganirodhā upādānanirodho ",
  "sn12.45:4.5": "upādānanirodhā bhavanirodho …pe… ",
  "sn12.45:4.6": "evametassa kevalassa dukkhakkhandhassa nirodho hoti. ",
  "sn12.45:5.1": "sotañca paṭicca sadde ca …pe… ",
  "sn12.45:5.2": "manañca paṭicca dhamme ca uppajjati manoviññāṇaṃ tiṇṇaṃ saṅgati phasso ",
  "sn12.45:5.3": "phassapaccayā vedanā ",
  "sn12.45:5.4": "vedanāpaccayā taṇhā ",
  "sn12.45:5.5": "tassāyeva taṇhāya asesavirāganirodhā upādānanirodho ",
  "sn12.45:5.6": "upādānanirodhā bhavanirodho …pe… ",
  "sn12.45:5.7": "evametassa kevalassa dukkhakkhandhassa nirodho hotīti. ",
  "sn12.45:6.1": "tena kho pana samayena aññataro bhikkhu bhagavato upassuti ṭhito hoti. ",
  "sn12.45:6.2": "addasā kho bhagavā taṃ bhikkhuṃ upassuti ṭhitaṃ ",
  "sn12.45:6.3": "disvāna taṃ bhikkhuṃ etadavoca ",
  "sn12.45:6.4": "assosi no tvaṃ bhikkhu imaṃ dhammapariyāyanti. ",
  "sn12.45:6.5": "evaṃ bhanteti. ",
  "sn12.45:6.6": "uggaṇhāhi tvaṃ bhikkhu imaṃ dhammapariyāyaṃ ",
  "sn12.45:6.7": "pariyāpuṇāhi tvaṃ bhikkhu imaṃ dhammapariyāyaṃ ",
  "sn12.45:6.8": "dhārehi tvaṃ bhikkhu imaṃ dhammapariyāyaṃ ",
  "sn12.45:6.9": "atthasañhitoyaṃ bhikkhu dhammapariyāyo ādibrahmacariyakoti. ",
  "sn12.45:6.10": "pañcamaṃ. "
}
