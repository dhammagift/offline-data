{
  "sn12.1:0.1": "suttantapiṭake saṃyuttanikāyassa dutiyo bhāgo nidānavaggo namo tassa bhagavato arahato sammāsambuddhassa abhisamayasaṃyuttaṃ ",
  "sn12.1:0.2": "buddhavaggo paṭhamo ",
  "sn12.1:0.3": "",
  "sn12.1:1.1": "evamme sutaṃ ",
  "sn12.1:1.2": "ekaṃ samayaṃ bhagavā sāvatthiyaṃ viharati jetavane anāthapiṇḍikassa ārāme. ",
  "sn12.1:1.3": "tatra kho bhagavā bhikkhū āmantesi ",
  "sn12.1:1.4": "bhikkhavoti. ",
  "sn12.1:1.5": "bhadanteti te bhikkhū bhagavato paccassosuṃ. ",
  "sn12.1:1.6": "bhagavā etadavoca ",
  "sn12.1:1.7": "paṭiccasamuppādaṃ vo bhikkhave desissāmi ",
  "sn12.1:1.8": "taṃ suṇātha sādhukaṃ manasikarotha bhāsissāmīti. ",
  "sn12.1:1.9": "evaṃ bhanteti kho te bhikkhū bhagavato paccassosuṃ. ",
  "sn12.1:1.10": "bhagavā etadavoca ",
  "sn12.1:2.1": "katamo ca bhikkhave paṭiccasamuppādo ",
  "sn12.1:2.2": "avijjāpaccayā bhikkhave saṅkhārā ",
  "sn12.1:2.3": "saṅkhārapaccayā viññāṇaṃ ",
  "sn12.1:2.4": "viññāṇapaccayā nāmarūpaṃ ",
  "sn12.1:2.5": "nāmarūpapaccayā saḷāyatanaṃ ",
  "sn12.1:2.6": "saḷāyatana paccayā phasso ",
  "sn12.1:2.7": "phassapaccayā vedanā ",
  "sn12.1:2.8": "vedanāpaccayā taṇhā ",
  "sn12.1:2.9": "taṇhāpaccayā upādānaṃ ",
  "sn12.1:2.10": "upādānapaccayā bhavo ",
  "sn12.1:2.11": "bhavapaccayā jāti ",
  "sn12.1:2.12": "jātipaccayā jarāmaraṇaṃ sokaparidevadukkhadomanassupāyāsā sambhavanti. ",
  "sn12.1:2.13": "evametassa kevalassa dukkhakkhandhassa samudayo hoti. ",
  "sn12.1:2.14": "ayaṃ vuccati bhikkhave paṭiccasamuppādo. ",
  "sn12.1:3.1": "avijjāya tveva asesavirāganirodhā saṅkhāranirodho ",
  "sn12.1:3.2": "saṅkhāranirodhā viññāṇanirodho ",
  "sn12.1:3.3": "viññāṇanirodhā nāmarūpanirodho ",
  "sn12.1:3.4": "nāmarūpanirodhā saḷāyatananirodho ",
  "sn12.1:3.5": "saḷāyatananirodhā phassanirodho ",
  "sn12.1:3.6": "phassanirodhā vedanānirodho ",
  "sn12.1:3.7": "vedanānirodhā taṇhānirodho ",
  "sn12.1:3.8": "taṇhānirodhā upādānanirodho ",
  "sn12.1:3.9": "upādānanirodhā bhavanirodho ",
  "sn12.1:3.10": "bhavanirodhā jātinirodho ",
  "sn12.1:3.11": "jātinirodhā jarāmaraṇaṃ sokaparidevadukkhadomanassupāyāsā nirujjhanti. ",
  "sn12.1:3.12": "evametassa kevalassa dukkhakkhandhassa nirodho hotīti. ",
  "sn12.1:3.13": "idamavoca bhagavā ",
  "sn12.1:3.14": "attamanā te bhikkhū bhagavato bhāsitaṃ abhinandunti. ",
  "sn12.1:3.15": "paṭhamaṃ. "
}
