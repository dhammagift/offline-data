  "sn12.3:0.1": "",
  "sn12.3:0.2": "",
  "sn12.3:0.3": "",
  "sn12.3:1.1": "sāvatthiyaṃ viharati … ",
  "sn12.3:1.2": "micchāpaṭipadañca vo bhikkhave desissāmi sammāpaṭipadañca ",
  "sn12.3:1.3": "taṃ suṇātha sādhukaṃ manasikarotha bhāsissāmīti. ",
  "sn12.3:1.4": "evaṃ bhanteti kho te bhikkhū bhagavato paccassosuṃ. ",
  "sn12.3:1.5": "bhagavā etadavoca ",
  "sn12.3:2.1": "katamā ca bhikkhave micchāpaṭipadā ",
  "sn12.3:2.2": "avijjāpaccayā bhikkhave saṅkhārā ",
  "sn12.3:2.3": "saṅkhārapaccayā viññāṇaṃ …pe… ",
  "sn12.3:2.4": "evametassa kevalassa dukkhakkhandhassa samudayo hoti. ",
  "sn12.3:2.5": "ayaṃ vuccati bhikkhave micchāpaṭipadā. ",
  "sn12.3:3.1": "katamā ca bhikkhave sammāpaṭipadā ",
  "sn12.3:3.2": "avijjāya tveva asesavirāganirodhā saṅkhāranirodho ",
  "sn12.3:3.3": "saṅkhāranirodhā viññāṇanirodho …pe… ",
  "sn12.3:3.4": "evametassa kevalassa dukkhakkhandhassa nirodho hoti. ",
  "sn12.3:3.5": "ayaṃ vuccati bhikkhave sammāpaṭipadāti. ",
  "sn12.3:3.6": "tatiyaṃ. "
}
