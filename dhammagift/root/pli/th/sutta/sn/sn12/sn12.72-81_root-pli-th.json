  "sn12.72-81:0.1": "",
  "sn12.72-81:0.2": "",
  "sn12.72-81:0.3": "",
  "sn12.72-81:1.1": "evamme sutaṃ …pe… ",
  "sn12.72-81:1.2": "jātiṃ nappajānanti …pe… ",
  "sn12.72-81:2.1": "bhavaṃ nappajānanti … ",
  "sn12.72-81:3.1": "upādānaṃ nappajānanti … ",
  "sn12.72-81:4.1": "taṇhaṃ nappajānanti … ",
  "sn12.72-81:5.1": "vedanaṃ nappajānanti … ",
  "sn12.72-81:6.1": "phassaṃ nappajānanti … ",
  "sn12.72-81:7.1": "saḷāyatanaṃ nappajānanti … ",
  "sn12.72-81:8.1": "nāmarūpaṃ nappajānanti … ",
  "sn12.72-81:9.1": "viññāṇaṃ nappajānanti … ",
  "sn12.72-81:10.1": "saṅkhāre nappajā nanti saṅkhārasamudayaṃ nappajānanti saṅkhāranirodhaṃ nappajānanti saṅkhāra nirodhagāminiṃ paṭipadaṃ nappajānanti ",
  "sn12.72-81:10.2": "…pe… ",
  "sn12.72-81:10.3": "sayaṃ abhiññā sacchikatvā upasampajja viharantīti. ",
  "sn12.72-81:10.4": "ekādasamaṃ. ",
  "sn12.72-81:10.5": "samaṇabrāhmaṇavaggo aṭṭhamo. ",
  "sn12.72-81:11.0": "tassa uddānaṃ ",
  "sn12.72-81:11.1": "paccayekādasa vuttā ",
  "sn12.72-81:11.2": "catusaccavibhajjanā ",
  "sn12.72-81:11.3": "samaṇabrāhmaṇavaggo ",
  "sn12.72-81:11.4": "nidānaṃ bhavati aṭṭhamaṃ. ",
  "sn12.72-81:12.0": "",
  "sn12.72-81:12.1": "vaggassa uddānaṃ buddho āhāradasabalo kaḷāraṃ ",
  "sn12.72-81:12.2": "gahapatipañcamaṃ ",
  "sn12.72-81:12.3": "dukkhavaggo mahāvaggo ",
  "sn12.72-81:12.4": "aṭṭhamaṃ samaṇabrāhmaṇanti. "
}
