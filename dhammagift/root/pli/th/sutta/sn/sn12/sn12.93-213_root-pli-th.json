  "sn12.93-103:0.1": "",
  "sn12.93-103:0.2": "",
  "sn12.93-103:0.3": "",
  "sn12.93-103:1.1": "jarāmaraṇaṃ bhikkhave ajānatā apassatā yathābhūtaṃ jarāmaraṇe yathābhūtaṃ ñāṇāya sikkhā karaṇīyā. ",
  "sn12.93-103:2.1": "",
  "sn12.104-114:1.1": "",
  "sn12.104-114:1.2": "[evaṃ peyyālo catusaccikaṃ kātabbaṃ] yogo karaṇīyo … ",
  "sn12.115-125:1.1": "",
  "sn12.115-125:1.2": "chando karaṇīyo … ",
  "sn12.126-136:1.1": "",
  "sn12.126-136:1.2": "ussoḷhī karaṇīyā … appaṭi vānī ",
  "sn12.137-147:1.1": "",
  "sn12.137-147:1.2": "karaṇīyā … ",
  "sn12.148-158:1.1": "",
  "sn12.148-158:1.2": "ātappaṃ karaṇīyaṃ … ",
  "sn12.159-169:1.1": "",
  "sn12.159-169:1.2": "viriyaṃ karaṇīyaṃ … ",
  "sn12.170-180:1.1": "",
  "sn12.170-180:1.2": "sātaccaṃ karaṇīyaṃ … ",
  "sn12.181-191:1.1": "",
  "sn12.181-191:1.2": "sati karaṇīyā … ",
  "sn12.192-202:1.1": "",
  "sn12.192-202:1.2": "sampajaññaṃ karaṇīyaṃ … ",
  "sn12.203-213:1.1": "",
  "sn12.203-213:1.2": "appamādo karaṇīyoti. ",
  "sn12.203-213:1.3": "antarapeyyālo navamo. ",
  "sn12.203-213:2.0": "tassa uddānaṃ ",
  "sn12.203-213:2.1": "satthā sikkhā ca yogo ca ",
  "sn12.203-213:2.2": "chando ussoḷhi ",
  "sn12.203-213:2.3": "pañcamī appaṭivāniyātappaṃ ",
  "sn12.203-213:2.4": "viriyaṃ sātacca vuccati ",
  "sn12.203-213:2.5": "sati ca sampajaññañca ",
  "sn12.203-213:2.6": "appamādena dvādasāti. ",
  "sn12.203-213:2.7": "suttantā antarapeyyālā niṭṭhitā. ",
  "sn12.203-213:3.1": "pare te dvādasa honti ",
  "sn12.203-213:3.2": "suttā dvattiṃsa satāni ca ",
  "sn12.203-213:3.3": "catusaccena te vuttā ",
  "sn12.203-213:3.4": "peyyālā antaramhi yeti. ",
  "sn12.203-213:3.5": "antarapeyyālesu uddānaṃ samattaṃ. ",
  "sn12.203-213:3.6": ""
}
