{
  "sn38.16:0.1": "",
  "sn38.16:0.2": "",
  "sn38.16:0.3": "",
  "sn38.16:1.1": "kiṃ nu kho āvuso sārīputta imasmiṃ dhammavinaye dukkaranti. ",
  "sn38.16:1.2": "pabbajjā kho āvuso imasmiṃ dhammavinaye dukkarāti. ",
  "sn38.16:1.3": "pabbajitena panāvuso kiṃ dukkaranti. ",
  "sn38.16:1.4": "pabbajitena kho āvuso abhirati dukkarāti. ",
  "sn38.16:1.5": "abhiratena panāvuso sārīputta kiṃ dukkaranti. ",
  "sn38.16:1.6": "abhiratena kho āvuso dhammānudhammapaṭipatti dukkarāti. ",
  "sn38.16:1.7": "kīvaciraṃ panāvuso dhammānudhammapaṭipanno bhikkhu arahaṃ assāti. ",
  "sn38.16:1.8": "na ciraṃ āvusoti. ",
  "sn38.16:1.9": "",
  "sn38.16:1.10": "jambukhādakasaṃyuttaṃ samattaṃ. ",
  "sn38.16:2.0": "tassuddānaṃ ",
  "sn38.16:2.1": "nibbānaṃ arahattañca ",
  "sn38.16:2.2": "dhammavādī kimatthiyaṃ ",
  "sn38.16:2.3": "assāso paramassāso ",
  "sn38.16:2.4": "vedanā āsavāvijjā ",
  "sn38.16:2.5": "taṇhā oghā upādānaṃ ",
  "sn38.16:2.6": "bhavo dukkhañca sakkāyo ",
  "sn38.16:2.7": "imasmiṃ dhammavinaye dukkaranti. "
}
