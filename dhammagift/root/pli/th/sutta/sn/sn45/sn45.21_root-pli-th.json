{
  "sn45.21:0.1": "",
  "sn45.21:0.2": "micchattavaggo tatiyo ",
  "sn45.21:0.3": "",
  "sn45.21:1.1": "sāvatthīnidānaṃ. ",
  "sn45.21:1.2": "micchattañca vo bhikkhave desessāmi sammattañca ",
  "sn45.21:1.3": "taṃ suṇātha. ",
  "sn45.21:1.4": "katamañca bhikkhave micchattaṃ. ",
  "sn45.21:1.5": "seyyathīdaṃ. micchādiṭṭhi …pe… micchāsamādhi. ",
  "sn45.21:1.6": "idaṃ vuccati bhikkhave micchattaṃ. ",
  "sn45.21:1.7": "katamañca bhikkhave sammattaṃ. ",
  "sn45.21:1.8": "seyyathīdaṃ. sammādiṭṭhi …pe… sammāsamādhi. ",
  "sn45.21:1.9": "idaṃ vuccati bhikkhave sammattanti. ",
  "sn45.21:1.10": ""
}
