  "sn45.40:0.1": "",
  "sn45.40:0.2": "",
  "sn45.40:0.3": "",
  "sn45.40:1.1": "sāvatthīnidānaṃ. ",
  "sn45.40:1.2": "brahmacariyañca vo bhikkhave desissāmi brahmacariyatthañca ",
  "sn45.40:1.3": "taṃ suṇātha. ",
  "sn45.40:1.4": "katamañca bhikkhave brahmacariyaṃ. ",
  "sn45.40:1.5": "ayamevāriyo aṭṭhaṅgiko maggo. seyyathīdaṃ. ",
  "sn45.40:1.6": "sammādiṭṭhi. pe. sammāsamādhi. ",
  "sn45.40:1.7": "idaṃ vuccati bhikkhave brahmacariyaṃ. ",
  "sn45.40:1.8": "katamo ca bhikkhave brahmacariyattho. ",
  "sn45.40:1.9": "yo ca bhikkhave rāgakkhayo dosakkhayo mohakkhayo. ",
  "sn45.40:1.10": "ayaṃ vuccati bhikkhave brahmacariyatthoti. ",
  "sn45.40:1.11": "",
  "sn45.40:1.12": "paṭipattivaggo catuttho. ",
  "sn45.40:2.0": "tassuddānaṃ ",
  "sn45.40:2.1": "paṭipatti paṭipanno ca ",
  "sn45.40:2.2": "viraddhañca pāraṃ gamā ",
  "sn45.40:2.3": "sāmaññena dve vuttā ",
  "sn45.40:2.4": "brahmaññā apare duve ",
  "sn45.40:2.5": "brahmacariyena dve vuttā ",
  "sn45.40:2.6": "vaggo tena pavuccatīti. "
}
