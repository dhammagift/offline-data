{
  "sn45.31:0.1": "",
  "sn45.31:0.2": "paṭipattivaggo catuttho ",
  "sn45.31:0.3": "",
  "sn45.31:1.1": "sāvatthīnidānaṃ. ",
  "sn45.31:1.2": "micchāpaṭipattiñca vo bhikkhave desessāmi sammāpaṭipattiñca ",
  "sn45.31:1.3": "taṃ suṇātha. ",
  "sn45.31:1.4": "katamā ca bhikkhave micchāpaṭipatti. ",
  "sn45.31:1.5": "seyyathīdaṃ. micchādiṭṭhi. pe. micchāsamādhi. ",
  "sn45.31:1.6": "ayaṃ vuccati bhikkhave micchāpaṭipatti. ",
  "sn45.31:1.7": "katamā ca bhikkhave sammāpaṭipatti. ",
  "sn45.31:1.8": "seyyathīdaṃ. sammādiṭṭhi. pe. sammāsamādhi. ",
  "sn45.31:1.9": "ayaṃ vuccati bhikkhave sammāpaṭipattīti. ",
  "sn45.31:1.10": ""
}
