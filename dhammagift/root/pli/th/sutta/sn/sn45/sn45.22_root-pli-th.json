  "sn45.22:0.3": "",
  "sn45.22:1.1": "sāvatthīnidānaṃ. ",
  "sn45.22:1.2": "akusale ca vo bhikkhave dhamme desissāmi kusale ca dhamme ",
  "sn45.22:1.3": "taṃ suṇātha. ",
  "sn45.22:1.4": "katame ca bhikkhave akusalā dhammā. ",
  "sn45.22:1.5": "seyyathīdaṃ. micchādiṭṭhi. pe. micchāsamādhi. ",
  "sn45.22:1.6": "ime vuccanti bhikkhave akusalā dhammā. ",
  "sn45.22:1.7": "katame ca bhikkhave kusalā dhammā. ",
  "sn45.22:1.8": "seyyathīdaṃ. sammādiṭṭhi. pe. sammāsamādhi. ",
  "sn45.22:1.9": "ime vuccanti bhikkhave kusalā dhammāti. ",
  "sn45.22:1.10": ""
}
