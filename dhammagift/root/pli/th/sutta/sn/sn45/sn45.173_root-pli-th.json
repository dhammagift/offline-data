  "sn45.173:0.3": "",
  "sn45.173:1.1": "sāvatthīnidānaṃ. cattārimāni bhikkhave upādānāni. ",
  "sn45.173:1.2": "katamāni cattāri. ",
  "sn45.173:1.3": "kāmūpādānaṃ diṭṭhūpādānaṃ sīlabbatūpādānaṃ attavādūpādānaṃ. ",
  "sn45.173:1.4": "imāni kho bhikkhave cattāri upādānāni. ",
  "sn45.173:1.5": "imesaṃ kho bhikkhave catunnaṃ upādānānaṃ abhiññāya pariññāya parikkhayāya pahānāya …pe… ayaṃ ariyo aṭṭhaṅgiko maggo bhāvetabboti. ",
  "sn45.173:1.6": ""
}
