  "sn45.64-68:1.1": "ekadhammo bhikkhave bahupakāro ariyassa aṭṭhaṅgikassa maggassa uppādāya. ",
  "sn45.64-68:1.2": "katamo ekadhammo. ",
  "sn45.64-68:1.3": "yadidaṃ sīlasampadā …pe… ",
  "sn45.64-68:1.4": "yadidaṃ chandasampadā …pe… ",
  "sn45.64-68:1.5": "yadidaṃ attasampadā …pe… ",
  "sn45.64-68:1.6": "yadidaṃ diṭṭhisampadā …pe… ",
  "sn45.64-68:1.7": "yadidaṃ appamādasampadā …pe… ",
  "sn45.64-68:1.8": "sāvatthīnidānaṃ. "
}
