{
  "sn45.171:0.1": "",
  "sn45.171:0.2": "oghavaggo terasamo ",
  "sn45.171:0.3": "",
  "sn45.171:1.1": "sāvatthīnidānaṃ. ",
  "sn45.171:1.2": "cattārome bhikkhave oghā. ",
  "sn45.171:1.3": "katame cattāro. ",
  "sn45.171:1.4": "kāmogho bhavogho diṭṭhogho avijjogho. ",
  "sn45.171:1.5": "ime kho bhikkhave cattāro oghā. ",
  "sn45.171:1.6": "imesaṃ kho bhikkhave catunnaṃ oghānaṃ abhiññāya pariññāya parikkhayāya pahānāya …pe… ayaṃ ariyo aṭṭhaṅgiko maggo bhāvetabboti. ",
  "sn45.171:1.7": "(yathā esanā evaṃ vitthāretabbaṃ). ",
  "sn45.171:1.8": "sāvatthīnidānaṃ. "
}
