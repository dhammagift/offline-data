  "sn45.179:0.3": "",
  "sn45.179:1.1": "pañcimāni bhikkhave orambhāgiyāni saññojanāni. ",
  "sn45.179:1.2": "katamāni pañca. ",
  "sn45.179:1.3": "sakkāyadiṭṭhi vicikicchā sīlabbataparāmāso kāmacchando byāpādo. ",
  "sn45.179:1.4": "imāni kho bhikkhave pañcorambhāgiyāni saññojanāni. ",
  "sn45.179:1.5": "imesaṃ kho bhikkhave pañcannaṃ orambhāgiyānaṃ saññojanānaṃ abhiññāya pariññāya parikkhayāya pahānāya. pe. ayaṃ ariyo aṭṭhaṅgiko maggo bhāvetabboti. ",
  "sn45.179:1.6": "sāvatthīnidānaṃ. "
}
