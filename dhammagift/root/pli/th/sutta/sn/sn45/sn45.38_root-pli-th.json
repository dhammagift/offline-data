  "sn45.38:0.3": "",
  "sn45.38:1.1": "sāvatthīnidānaṃ. ",
  "sn45.38:1.2": "brahmaññañca vo bhikkhave desissāmi brahmaññatthañca ",
  "sn45.38:1.3": "taṃ suṇātha. ",
  "sn45.38:1.4": "katamañca bhikkhave brahmaññaṃ. ",
  "sn45.38:1.5": "ayameva ariyo aṭṭhaṅgiko maggo. seyyathīdaṃ. ",
  "sn45.38:1.6": "sammādiṭṭhi. pe. sammāsamādhi. ",
  "sn45.38:1.7": "idaṃ vuccati bhikkhave brahmaññaṃ. ",
  "sn45.38:1.8": "katamo ca bhikkhave brahmaññattho. ",
  "sn45.38:1.9": "yo ca bhikkhave rāgakkhayo dosakkhayo mohakkhayo. ",
  "sn45.38:1.10": "ayaṃ vuccati bhikkhave brahmaññatthoti. ",
  "sn45.38:1.11": ""
}
