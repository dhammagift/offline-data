  "sn45.23:1.1": "sāvatthīnidānaṃ. ",
  "sn45.23:1.2": "micchāpaṭipadañca vo bhikkhave desessāmi sammāpaṭipadañca ",
  "sn45.23:1.3": "taṃ suṇātha. ",
  "sn45.23:1.4": "katamā ca bhikkhave micchāpaṭipadā. ",
  "sn45.23:1.5": "seyyathīdaṃ. micchādiṭṭhi. pe. micchāsamādhi. ",
  "sn45.23:1.6": "ayaṃ vuccati bhikkhave micchāpaṭipadā. ",
  "sn45.23:1.7": "katamā ca bhikkhave sammāpaṭipadā. ",
  "sn45.23:1.8": "seyyathīdaṃ. sammādiṭṭhi. pe. sammāsamādhi. ",
  "sn45.23:1.9": "ayaṃ vuccati bhikkhave sammāpaṭipadāti. ",
  "sn45.23:1.10": ""
}
