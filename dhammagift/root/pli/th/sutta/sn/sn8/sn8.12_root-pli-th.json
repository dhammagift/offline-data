{
  "sn8.12:0.1": "",
  "sn8.12:0.2": "",
  "sn8.12:0.3": "dvādasamaṃ vaṅgīsasuttaṃ ",
  "sn8.12:1.1": "ekaṃ samayaṃ āyasmā vaṅgīso sāvatthiyaṃ viharati jetavane anāthapiṇḍikassa ārāme. ",
  "sn8.12:1.2": "tena kho pana samayena āyasmā vaṅgīso aciraarahattappatto hoti vimuttisukhaṃ paṭisaṃvedī tāyaṃ velāyaṃ imā gāthāyo abhāsi ",
  "sn8.12:2.1": "kāveyyamattā vicarimha pubbe ",
  "sn8.12:2.2": "gāmā gāmaṃ purā puraṃ ",
  "sn8.12:2.3": "athaddasāma sambuddhaṃ ",
  "sn8.12:2.4": "saddhā no upapajjatha ",
  "sn8.12:3.1": "so me dhammamadesesi ",
  "sn8.12:3.2": "khandhe āyatanāni dhātuyo ",
  "sn8.12:3.3": "tassāhaṃ dhammaṃ sutvāna ",
  "sn8.12:3.4": "pabbajiṃ anagāriyaṃ ",
  "sn8.12:4.1": "bahunnaṃ vata atthāya ",
  "sn8.12:4.2": "bodhimajjhagamā muni ",
  "sn8.12:4.3": "bhikkhūnaṃ bhikkhunīnañca ",
  "sn8.12:4.4": "ye niyāmagataddasā ",
  "sn8.12:5.1": "svāgataṃ vata me āsi ",
  "sn8.12:5.2": "mama buddhassa santike ",
  "sn8.12:5.3": "tisso vijjā anuppattā ",
  "sn8.12:5.4": "kataṃ buddhassa sāsanaṃ ",
  "sn8.12:6.1": "pubbenivāsaṃ jānāmi ",
  "sn8.12:6.2": "dibbacakkhuṃ visodhitaṃ ",
  "sn8.12:6.3": "tevijjo iddhipattomhi ",
  "sn8.12:6.4": "cetopariyāyakovidoti. vaṅgīsasaṃyuttaṃ samattaṃ. ",
  "sn8.12:7.0": "tassuddānaṃ ",
  "sn8.12:7.1": "nikkhantaarati ceva ",
  "sn8.12:7.2": "pesalāatimaññanā ",
  "sn8.12:7.3": "ānandena subhāsitā ",
  "sn8.12:7.4": "sārīputtapavāraṇā ",
  "sn8.12:7.5": "parosahassaṃ koṇḍañño ",
  "sn8.12:7.6": "moggallānena gaggarā ",
  "sn8.12:7.7": "vaṅgīsena dvādasāti. ",
  "sn8.12:7.8": ""
}
