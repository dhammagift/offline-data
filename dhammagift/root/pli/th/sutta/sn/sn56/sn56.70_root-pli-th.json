  "sn56.70:1.1": "evameva kho bhikkhave appakā te sattā ye kulejeṭṭhāpacāyino atha kho eteva bahutarā sattā ye akulejeṭṭhāpacāyinoti. vaggo. ",
  "sn56.70:1.2": "",
  "sn56.70:1.3": "uddānaṃ ",
  "sn56.70:2.0": "",
  "sn56.70:2.1": "aññatra paccantaṃ paññāya ",
  "sn56.70:2.2": "surāmerayaodakā ",
  "sn56.70:2.3": "matteyyapetteyyā cāpi ",
  "sn56.70:2.4": "sāmaññaṃ brāhmapacāyikanti. "
}
