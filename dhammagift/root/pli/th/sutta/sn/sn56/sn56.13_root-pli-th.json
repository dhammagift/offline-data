{
  "sn56.13:0.1": "",
  "sn56.13:0.2": "",
  "sn56.13:0.3": "",
  "sn56.13:1.1": "cattārimāni bhikkhave ariyasaccāni. ",
  "sn56.13:1.2": "katamāni cattāri. ",
  "sn56.13:1.3": "dukkhaṃ ariyasaccaṃ dukkhasamudayo ariyasaccaṃ dukkhanirodho ariyasaccaṃ dukkhanirodhagāminīpaṭipadā ariyasaccaṃ. ",
  "sn56.13:2.1": "katamañca bhikkhave dukkhaṃ ariyasaccaṃ. ",
  "sn56.13:2.2": "pañcupādānakkhandhātissa vacanīyaṃ. katame pañca. ",
  "sn56.13:2.3": "rūpūpādānakkhandho …pe… viññāṇūpādānakkhandho. ",
  "sn56.13:2.4": "idaṃ vuccati bhikkhave dukkhaṃ ariyasaccaṃ. ",
  "sn56.13:3.1": "katamañca bhikkhave dukkhasamudayo ariyasaccaṃ. ",
  "sn56.13:3.2": "yāyaṃ taṇhā ponobbhavikā nandirāgasahagatā tatratatrābhinandinī. seyyathīdaṃ. ",
  "sn56.13:3.3": "kāmataṇhā bhavataṇhā vibhavataṇhā. ",
  "sn56.13:3.4": "idaṃ vuccati bhikkhave dukkhasamudayo ariyasaccaṃ. ",
  "sn56.13:4.1": "katamañca bhikkhave dukkhanirodho ariyasaccaṃ. ",
  "sn56.13:4.2": "yo tassā yeva taṇhāya asesavirāganirodho cāgo paṭinissaggo mutti anālayo. ",
  "sn56.13:4.3": "idaṃ vuccati bhikkhave dukkhanirodho ariyasaccaṃ. ",
  "sn56.13:5.1": "katamañca bhikkhave dukkhanirodhagāminīpaṭipadā ariyasaccaṃ. ",
  "sn56.13:5.2": "ayameva ariyo aṭṭhaṅgiko maggo. seyyathīdaṃ. ",
  "sn56.13:5.3": "sammādiṭṭhi …pe… sammāsamādhi. ",
  "sn56.13:5.4": "idaṃ vuccati bhikkhave dukkhanirodhagāminīpaṭipadā ariyasaccaṃ. ",
  "sn56.13:5.5": "imāni kho bhikkhave cattāri ariyasaccāni. ",
  "sn56.13:6.1": "tasmā tiha bhikkhave idaṃ dukkhanti yogo karaṇīyo …pe… ayaṃ dukkhanirodhagāminī paṭipadāti yogo karaṇīyoti. ",
  "sn56.13:6.2": ""
}
