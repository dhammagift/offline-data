{
  "sn56.14:0.1": "",
  "sn56.14:0.2": "",
  "sn56.14:0.3": "",
  "sn56.14:1.1": "cattārimāni bhikkhave ariyasaccāni. ",
  "sn56.14:1.2": "katamāni cattāri. ",
  "sn56.14:1.3": "dukkhaṃ ariyasaccaṃ dukkhasamudayo ariyasaccaṃ dukkhanirodho ariyasaccaṃ dukkhanirodhagāminīpaṭipadā ariyasaccaṃ. ",
  "sn56.14:2.1": "katamañca bhikkhave dukkhaṃ ariyasaccaṃ. ",
  "sn56.14:2.2": "cha ajjhattikāni āyatanānītissa vacanīyaṃ. ",
  "sn56.14:2.3": "katamāni cha. ",
  "sn56.14:2.4": "cakkhvāyatanaṃ …pe… manāyatanaṃ. ",
  "sn56.14:2.5": "idaṃ vuccati bhikkhave dukkhaṃ ariyasaccaṃ. ",
  "sn56.14:3.1": "katamañca bhikkhave dukkhasamudayo ariyasaccaṃ. ",
  "sn56.14:3.2": "yāyaṃ taṇhā ponobbhavikā nandirāgasahagatā tatratatrābhinandinī. seyyathīdaṃ. kāmataṇhā bhavataṇhā vibhavataṇhā. ",
  "sn56.14:3.3": "idaṃ vuccati bhikkhave dukkhasamudayo ariyasaccaṃ. ",
  "sn56.14:4.1": "katamañca bhikkhave dukkhanirodho ariyasaccaṃ. ",
  "sn56.14:4.2": "yo tassāyeva taṇhāya asesavirāganirodho cāgo paṭinissaggo mutti anālayo. ",
  "sn56.14:4.3": "idaṃ vuccati bhikkhave dukkhanirodho ariyasaccaṃ. ",
  "sn56.14:5.1": "katamañca bhikkhave dukkhanirodhagāminīpaṭipadā ariyasaccaṃ. ",
  "sn56.14:5.2": "ayameva ariyo aṭṭhaṅgiko maggo. seyyathīdaṃ. ",
  "sn56.14:5.3": "sammādiṭṭhi …pe… sammāsamādhi. ",
  "sn56.14:5.4": "idaṃ vuccati bhikkhave dukkhanirodhagāminīpaṭipadā ariyasaccaṃ. ",
  "sn56.14:5.5": "imāni kho bhikkhave cattāri ariyasaccāni. ",
  "sn56.14:6.1": "tasmā tiha bhikkhave idaṃ dukkhanti yogo karaṇīyo …pe… ayaṃ dukkhanirodhagāminī paṭipadāti yogo karaṇīyoti. ",
  "sn56.14:6.2": ""
}
