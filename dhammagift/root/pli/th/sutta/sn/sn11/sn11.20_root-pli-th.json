{
  "sn11.20:0.1": "",
  "sn11.20:0.2": "",
  "sn11.20:0.3": "dasamaṃ tatiyasakkanamassanasuttaṃ ",
  "sn11.20:1.1": "",
  "sn11.20:1.2": "sāvatthīnidānaṃ. ",
  "sn11.20:1.3": "bhūtapubbaṃ bhikkhave sakko devānamindo mātaliṃ saṅgāhakaṃ āmantesi ",
  "sn11.20:1.4": "yojehi samma mātali sahassayuttaṃ ājaññarathaṃ uyyānabhūmiṃ gacchāma subhūmiṃ dassanāyāti. ",
  "sn11.20:1.5": "evaṃ bhaddantavāti kho bhikkhave mātali saṅgāhako sakkassa devānamindassa paṭissutvā sahassayuttaṃ ājaññarathaṃ yojetvā sakkassa devānamindassa paṭivedesi ",
  "sn11.20:1.6": "yutto kho te mārisa sahassayutto ājaññaratho ",
  "sn11.20:1.7": "yassadāni kālaṃ maññasīti. ",
  "sn11.20:1.8": "atha kho bhikkhave sakko devānamindo vejayantapāsādā orohanto añjaliṃ katvā sudaṃ bhikkhusaṅghaṃ namassati. ",
  "sn11.20:1.9": "atha kho bhikkhave mātali saṅgāhako sakkaṃ devānamindaṃ gāthāya ajjhabhāsi ",
  "sn11.20:2.1": "taṃ hi ete namasseyyuṃ ",
  "sn11.20:2.2": "pūtidehasayā narā ",
  "sn11.20:2.3": "nimuggā kuṇapasmete khuppipāsā ",
  "sn11.20:2.4": "samappitā ",
  "sn11.20:3.1": "kiṃ nu tesaṃ pihayasi ",
  "sn11.20:3.2": "anāgārāna vāsava ",
  "sn11.20:3.3": "ācāraṃ isinaṃ brūhi ",
  "sn11.20:3.4": "taṃ suṇoma vaco tavāti. ",
  "sn11.20:4.1": "etaṃ tesaṃ pihayāmi ",
  "sn11.20:4.2": "anāgārāna mātali ",
  "sn11.20:4.3": "yamhā gāmā pakkamanti ",
  "sn11.20:4.4": "anapekkhā vajanti te ",
  "sn11.20:5.1": "na tesaṃ koṭṭhe openti ",
  "sn11.20:5.2": "na kumbhā na kaḷopiyaṃ ",
  "sn11.20:5.3": "paraniṭṭhitamesanā ",
  "sn11.20:5.4": "tena yāpenti subbatā ",
  "sn11.20:6.1": "sumantamantino dhīrā ",
  "sn11.20:6.2": "tuṇhībhūtā samañcarā ",
  "sn11.20:6.3": "devā viruddhā asurehi ",
  "sn11.20:6.4": "puthumaccā ca mātali ",
  "sn11.20:7.1": "aviruddhā viruddhesu ",
  "sn11.20:7.2": "attadaṇḍesu nibbutā ",
  "sn11.20:7.3": "sādānesu anādānā ",
  "sn11.20:7.4": "te namassāmi mātalīti. ",
  "sn11.20:8.1": "seṭṭhā hi kira lokasmiṃ ",
  "sn11.20:8.2": "ye tvaṃ sakka namassasi ",
  "sn11.20:8.3": "ahampi te namassāmi ",
  "sn11.20:8.4": "ye namassasi vāsavāti. ",
  "sn11.20:9.1": "idaṃ vatvāna maghavā ",
  "sn11.20:9.2": "devarājā sujampati ",
  "sn11.20:9.3": "bhikkhusaṅghaṃ namassitvā ",
  "sn11.20:9.4": "pamukho rathamāruhīti. ",
  "sn11.20:9.5": "dutiyo vaggo. ",
  "sn11.20:10.0": "tassuddānaṃ ",
  "sn11.20:10.1": "vatapadena tayo vuttā ",
  "sn11.20:10.2": "daḷiddañca rāmaṇeyyakaṃ ",
  "sn11.20:10.3": "yajamānañca vandanā ",
  "sn11.20:10.4": "tayo sakkanamassanāti. sakkapañcakaṃ tatiyaṃ "
}
