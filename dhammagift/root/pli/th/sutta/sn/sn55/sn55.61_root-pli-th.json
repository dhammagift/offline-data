  "sn55.61:0.3": "",
  "sn55.61:1.1": "paññāvepullāya saṃvattantīti. ",
  "sn55.61:1.2": "",
  "sn55.61:1.3": "sappaññavaggo chaṭṭho. ",
  "sn55.61:2.0": "tassuddānaṃ ",
  "sn55.61:2.1": "sagāthakaṃ vassavutthaṃ ",
  "sn55.61:2.2": "dhammadinnagilāyanaṃ ",
  "sn55.61:2.3": "caturo phalā paṭilābho ",
  "sn55.61:2.4": "vuḍḍhi vepullatāya cāti. "
}
