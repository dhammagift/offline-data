{
  "sn55.50:0.1": "",
  "sn55.50:0.2": "",
  "sn55.50:0.3": "",
  "sn55.50:1.1": "cattārimāni bhikkhave sotāpattiyaṅgāni. ",
  "sn55.50:1.2": "katamāni cattāri. ",
  "sn55.50:1.3": "sappurisasaṃsevo saddhammassavanaṃ yonisomanasikāro dhammānudhammapaṭipatti. ",
  "sn55.50:1.4": "imāni kho bhikkhave cattāri sotāpattiyaṅgānīti. ",
  "sn55.50:1.5": "",
  "sn55.50:1.6": "sagāthakapuññābhisandavaggo pañcamo. ",
  "sn55.50:2.0": "tassuddānaṃ ",
  "sn55.50:2.1": "abhisandena tayo vuttā ",
  "sn55.50:2.2": "duve mahaddhanena ca ",
  "sn55.50:2.3": "bhikkhu nandiyabhaddiyaṃ ",
  "sn55.50:2.4": "mahānāmaṅgena te dasāti. "
}
