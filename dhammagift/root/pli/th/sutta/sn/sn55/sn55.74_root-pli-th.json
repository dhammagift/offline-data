  "sn55.74:0.1": "",
  "sn55.74:0.2": "",
  "sn55.74:0.3": "",
  "sn55.74:1.1": "nibbedhikapaññatāya saṃvattantīti. ",
  "sn55.74:1.2": "katame cattāro. ",
  "sn55.74:1.3": "sappurisasaṃsevo saddhammassavanaṃ yonisomanasikāro dhammānudhammapaṭipatti. ",
  "sn55.74:1.4": "ime kho bhikkhave cattāro dhammā bhāvitā bahulīkatā nibbedhikapaññatāya saṃvattantīti. ",
  "sn55.74:1.5": "",
  "sn55.74:1.6": "mahāpaññavaggo sattamo. ",
  "sn55.74:2.0": "tassuddānaṃ ",
  "sn55.74:2.1": "mahāputhuvipulagambhīraṃ appamattabhūribāhula ",
  "sn55.74:2.2": "sīghalahuhāsajavana ",
  "sn55.74:2.3": "tikkhanibbedhikāya ",
  "sn55.74:2.4": "cāti. ",
  "sn55.74:2.5": "sotāpattisaṃyuttaṃ samattaṃ. "
}
