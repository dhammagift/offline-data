{
  "sn30.1:0.1": "supaṇṇasaṃyuttaṃ ",
  "sn30.1:0.2": "",
  "sn30.1:0.3": "",
  "sn30.1:1.1": "sāvatthī. tatra kho. ",
  "sn30.1:1.2": "catasso imā bhikkhave supaṇṇayoniyo. ",
  "sn30.1:1.3": "katamā catasso. ",
  "sn30.1:1.4": "aṇḍajā supaṇṇā jalābujā supaṇṇā saṃsedajā supaṇṇā upapātikā supaṇṇā. ",
  "sn30.1:1.5": "imā kho bhikkhave catasso supaṇṇayoniyoti. ",
  "sn30.1:1.6": ""
}
