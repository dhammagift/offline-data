  "sn40.11:0.1": "",
  "sn40.11:0.2": "",
  "sn40.11:0.3": "",
  "sn40.11:1.1": "atha kho candano devaputto …pe… ",
  "sn40.11:2.1": "atha kho suyāmo devaputto. ",
  "sn40.11:3.1": "",
  "sn40.11:4.1": "atha kho sunimmito devaputto. ",
  "sn40.11:5.1": "atha kho vasavatti devaputto. ",
  "sn40.11:6.1": "(ime pañca peyyālā yathā sakko ",
  "sn40.11:6.2": "devānamindo tathā ",
  "sn40.11:6.3": "vitthāretabbāti). moggallānasaṃyuttaṃ samattaṃ. ",
  "sn40.11:7.0": "tassuddānaṃ ",
  "sn40.11:7.1": "savitakkāvitakkañca ",
  "sn40.11:7.2": "sukhena ca upekkhako ",
  "sn40.11:7.3": "ākāsañceva viññāṇaṃ ",
  "sn40.11:7.4": "ākiñcaññā nevasaññinā ",
  "sn40.11:7.5": "animitto ca sakko ca ",
  "sn40.11:7.6": "candanekādasena cāti. ",
  "sn40.11:7.7": ""
}
