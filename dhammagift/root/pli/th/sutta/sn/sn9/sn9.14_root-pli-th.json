{
  "sn9.14:0.1": "",
  "sn9.14:0.2": "",
  "sn9.14:0.3": "cuddasamaṃ padumapupphasuttaṃ ",
  "sn9.14:1.1": "ekaṃ samayaṃ aññataro bhikkhu kosalesu viharati aññatarasmiṃ vanasaṇḍe. ",
  "sn9.14:1.2": "tena kho pana samayena so bhikkhu pacchābhattaṃ piṇḍapātapaṭikkanto pokkharaṇiṃ ogāhetvā padumaṃ upasiṅghati. ",
  "sn9.14:1.3": "atha kho yā tasmiṃ vanasaṇḍe adhivatthā devatā tassa bhikkhuno anukampikā atthakāmā taṃ bhikkhuṃ saṃvejetukāmā yena so bhikkhu tenupasaṅkami upasaṅkamitvā taṃ bhikkhuṃ gāthāya ajjhabhāsi ",
  "sn9.14:2.1": "yametaṃ vārijaṃ pupphaṃ ",
  "sn9.14:2.2": "adinnaṃ upasiṅghasi ",
  "sn9.14:2.3": "ekaṅgametaṃ theyyānaṃ ",
  "sn9.14:2.4": "gandhatthenosi mārisāti. ",
  "sn9.14:3.1": "na harāmi na bhañjāmi ",
  "sn9.14:3.2": "ārā siṅghāmi vārijaṃ ",
  "sn9.14:3.3": "atha kena nu vaṇṇena ",
  "sn9.14:3.4": "gandhatthenoti vuccati ",
  "sn9.14:4.1": "yvāyaṃ bhiṃsāni khanati ",
  "sn9.14:4.2": "puṇḍarīkāni bhañjati ",
  "sn9.14:4.3": "evaṃ ākiṇṇakammanto ",
  "sn9.14:4.4": "kasmā eso na vuccatīti. ",
  "sn9.14:5.1": "ākiṇṇaluddho puriso ",
  "sn9.14:5.2": "ativelaṃva makkhito ",
  "sn9.14:5.3": "tasmiṃ me vacanaṃ natthi ",
  "sn9.14:5.4": "tañca arahāmi vattave ",
  "sn9.14:6.1": "anaṅgaṇassa posassa ",
  "sn9.14:6.2": "niccaṃ sucigavesino ",
  "sn9.14:6.3": "vālaggamattaṃ pāpassa ",
  "sn9.14:6.4": "abbhāmattaṃva khāyatīti. ",
  "sn9.14:7.1": "addhā maṃ yakkha jānāsi ",
  "sn9.14:7.2": "atho maṃ anukampasi ",
  "sn9.14:7.3": "punapi yakkha vajjāsi ",
  "sn9.14:7.4": "yadā passasi edisanti. ",
  "sn9.14:8.1": "neva taṃ upajīvāmi ",
  "sn9.14:8.2": "napi te bhaddakamhase 2 ",
  "sn9.14:8.3": "tvameva bhikkhu jāneyya ",
  "sn9.14:8.4": "yena gaccheyya sugatinti. ",
  "sn9.14:9.1": "atha kho so bhikkhu tāya devatāya saṃvejito saṃvegamāpādīti. ",
  "sn9.14:9.2": "vanasaṃyuttaṃ samattaṃ. ",
  "sn9.14:10.0": "tassuddānaṃ ",
  "sn9.14:10.1": "vivekaṃ upaṭṭhānañca ",
  "sn9.14:10.2": "kassapagottena sambahulā ",
  "sn9.14:10.3": "ānando anuruddhañca ",
  "sn9.14:10.4": "nāgadattañca kulagharaṇī ",
  "sn9.14:11.1": "vajjīputto ca vesālī ",
  "sn9.14:11.2": "sajjhāyena ayoniso ",
  "sn9.14:11.3": "majjhantakālamhi pākatindriyā ",
  "sn9.14:11.4": "padumapupphena cuddasa bhaveti. ",
  "sn9.14:11.5": ""
}
