{
  "sn9.6:0.1": "",
  "sn9.6:0.2": "",
  "sn9.6:0.3": "chaṭṭhaṃ anuruddhasuttaṃ ",
  "sn9.6:1.1": "ekaṃ samayaṃ āyasmā anuruddho kosalesu viharati aññatarasmiṃ vanasaṇḍe. ",
  "sn9.6:1.2": "atha kho aññatarā tāvatiṃsakāyikā devatā jālinī nāma āyasmato anuruddhassa purāṇadutiyikā yenāyasmā anuruddho tenupasaṅkami upasaṅkamitvā āyasmantaṃ anuruddhaṃ gāthāya ajjhabhāsi ",
  "sn9.6:2.1": "tattha cittaṃ paṇidhehi ",
  "sn9.6:2.2": "yattha te vusitaṃ pure ",
  "sn9.6:2.3": "tāvatiṃsesu devesu ",
  "sn9.6:2.4": "sabbakāmasamiddhisu ",
  "sn9.6:2.5": "purakkhato parivuto ",
  "sn9.6:2.6": "devagaṇehi sobhasīti. ",
  "sn9.6:3.1": "duggatā devakaññāyo ",
  "sn9.6:3.2": "sakkāyasmiṃ patiṭṭhitā ",
  "sn9.6:3.3": "te cāpi duggatā sattā ",
  "sn9.6:3.4": "devakaññāhi patthitāti. ",
  "sn9.6:4.1": "na te sukhaṃ pajānanti ",
  "sn9.6:4.2": "ye na passanti nandanaṃ ",
  "sn9.6:4.3": "āvāsaṃ naradevānaṃ ",
  "sn9.6:4.4": "tidasānaṃ yasassinanti. ",
  "sn9.6:5.1": "na tvaṃ bāle vijānāsi ",
  "sn9.6:5.2": "yathā arahataṃ vaco ",
  "sn9.6:5.3": "aniccā sabbe saṅkhārā ",
  "sn9.6:5.4": "uppādavayadhammino ",
  "sn9.6:5.5": "uppajjitvā nirujjhanti ",
  "sn9.6:5.6": "tesaṃ vūpasamo sukho ",
  "sn9.6:6.1": "natthidāni punāvāso ",
  "sn9.6:6.2": "devakāyasmi jālinī ",
  "sn9.6:6.3": "vikkhīṇo jātisaṃsāro ",
  "sn9.6:6.4": "natthidāni punabbhavoti. "
}
