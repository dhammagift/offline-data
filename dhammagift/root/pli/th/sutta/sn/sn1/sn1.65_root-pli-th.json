{
  "sn1.65:0.1": "",
  "sn1.65:0.2": "",
  "sn1.65:0.3": "pañcamaṃ bandhanasuttaṃ ",
  "sn1.65:1.1": "kiṃsu sambandhano loko ",
  "sn1.65:1.2": "kiṃsu tassa vicāraṇaṃ ",
  "sn1.65:1.3": "kissassa vippahānena ",
  "sn1.65:1.4": "sabbaṃ chindati bandhananti. ",
  "sn1.65:2.1": "nandisambandhano loko ",
  "sn1.65:2.2": "vitakkassa vicāraṇaṃ ",
  "sn1.65:2.3": "taṇhāya vippahānena ",
  "sn1.65:2.4": "sabbaṃ chindati bandhananti. "
}
