{
  "sn1.53:0.1": "",
  "sn1.53:0.2": "",
  "sn1.53:0.3": "tatiyaṃ mittasuttaṃ ",
  "sn1.53:1.1": "kiṃsu pasavato mittaṃ ",
  "sn1.53:1.2": "kiṃsu mittaṃ sake ghare ",
  "sn1.53:1.3": "kiṃ mittaṃ atthajātassa ",
  "sn1.53:1.4": "kiṃ mittaṃ samparāyikanti. ",
  "sn1.53:2.1": "sattho pasavato mittaṃ ",
  "sn1.53:2.2": "mātā mittaṃ sake ghare ",
  "sn1.53:2.3": "sahāyo atthajātassa ",
  "sn1.53:2.4": "hoti mittaṃ punappunaṃ ",
  "sn1.53:2.5": "sayaṃ katāni puññāni ",
  "sn1.53:2.6": "taṃ mittaṃ samparāyikanti. "
}
