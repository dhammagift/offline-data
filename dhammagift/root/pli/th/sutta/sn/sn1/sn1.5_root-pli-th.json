{
  "sn1.5:0.1": "",
  "sn1.5:0.2": "",
  "sn1.5:0.3": "pañcamaṃ katichindisuttaṃ ",
  "sn1.5:1.1": "",
  "sn1.5:1.2": "ekamantaṃ ṭhitā kho sā devatā bhagavantaṃ gāthāya ajjhabhāsi ",
  "sn1.5:2.1": "kati chinde kati jahe ",
  "sn1.5:2.2": "kati vuttari bhāvaye ",
  "sn1.5:2.3": "kati saṅgātito bhikkhu ",
  "sn1.5:2.4": "oghatiṇṇoti vuccatīti. ",
  "sn1.5:3.1": "pañca chinde pañca jahe ",
  "sn1.5:3.2": "pañca vuttari bhāvaye ",
  "sn1.5:3.3": "pañca saṅgātito bhikkhu ",
  "sn1.5:3.4": "oghatiṇṇoti vuccatīti. "
}
