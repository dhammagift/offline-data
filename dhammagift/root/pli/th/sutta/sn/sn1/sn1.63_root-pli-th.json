  "sn1.63:0.3": "tatiyaṃ taṇhāsuttaṃ ",
  "sn1.63:1.1": "kenassu nīyati loko ",
  "sn1.63:1.2": "kenassu parikissati ",
  "sn1.63:1.3": "kissassa ekadhammassa ",
  "sn1.63:1.4": "sabbeva vasamanvagūti. ",
  "sn1.63:2.1": "taṇhāya nīyati loko ",
  "sn1.63:2.2": "taṇhāya parikissati ",
  "sn1.63:2.3": "taṇhāya ekadhammassa ",
  "sn1.63:2.4": "sabbeva vasamanvagūti. "
}
