{
  "sn1.33:0.1": "",
  "sn1.33:0.2": "",
  "sn1.33:0.3": "tatiyaṃ sādhusuttaṃ ",
  "sn1.33:1.1": "",
  "sn1.33:1.2": "atha kho sambahulā satullapakāyikā devatāyo abhikkantāya rattiyā abhikkantavaṇṇā kevalakappaṃ jetavanaṃ obhāsetvā yena bhagavā tenupasaṅkamiṃsu upasaṅkamitvā bhagavantaṃ abhivādetvā ekamantaṃ aṭṭhaṃsu. ",
  "sn1.33:1.3": "ekamantaṃ ṭhitā kho ekā devatā bhagavato santike imaṃ udānaṃ udānesi ",
  "sn1.33:2.1": "sādhu kho mārisa dānaṃ ",
  "sn1.33:2.2": "maccherā ca pamādā ca ",
  "sn1.33:2.3": "evaṃ dānaṃ na dīyati ",
  "sn1.33:2.4": "puññamākaṅkhamānena ",
  "sn1.33:2.5": "deyyaṃ hoti vijānatāti. ",
  "sn1.33:3.1": "atha kho aparā devatā bhagavato santike imaṃ udānaṃ udānesi ",
  "sn1.33:4.1": "sādhu kho mārisa dānaṃ ",
  "sn1.33:4.2": "apica appakasmiṃpi sāhu dānaṃ ",
  "sn1.33:5.1": "appasmeke pavecchanti ",
  "sn1.33:5.2": "bahuneke na diccharū ",
  "sn1.33:5.3": "appasmā dakkhiṇā dinnā ",
  "sn1.33:5.4": "sahassena samaṃ mitāti. ",
  "sn1.33:6.1": "atha kho aparā devatā bhagavato santike imaṃ udānaṃ udānesi ",
  "sn1.33:7.1": "sādhu kho mārisa dānaṃ ",
  "sn1.33:7.2": "appakasmiṃpi sāhu dānaṃ ",
  "sn1.33:7.3": "apica saddhāyapi sāhu dānaṃ ",
  "sn1.33:7.4": "dānañca yuddhañca samānamāhu ",
  "sn1.33:7.5": "appāpi santā bahuke jinanti ",
  "sn1.33:7.6": "appampi ce saddahāno dadāti ",
  "sn1.33:7.7": "teneva so hoti sukhī paratthāti. ",
  "sn1.33:8.1": "atha kho aparā devatā bhagavato santike imaṃ udānaṃ udānesi ",
  "sn1.33:9.1": "sādhu kho mārisa dānaṃ ",
  "sn1.33:9.2": "appakasmiṃpi sāhu dānaṃ ",
  "sn1.33:9.3": "saddhāyapi sāhu dānaṃ ",
  "sn1.33:9.4": "apica dhammaladdhassapi sāhu dānaṃ ",
  "sn1.33:10.1": "yo dhammaladdhassa dadāti dānaṃ ",
  "sn1.33:10.2": "uṭṭhānaviriyādhigatassa jantu< ",
  "sn1.33:10.3": "atikkamma vetaraṇiṃ yamassa ",
  "sn1.33:10.4": "dibbāni ṭhānāni upeti maccoti. ",
  "sn1.33:11.1": "atha kho aparā devatā bhagavato santike imaṃ udānaṃ udānesi ",
  "sn1.33:12.1": "sādhu kho mārisa dānaṃ ",
  "sn1.33:12.2": "appakasmiṃpi sāhu dānaṃ ",
  "sn1.33:12.3": "saddhāyapi sāhu dānaṃ ",
  "sn1.33:12.4": "dhammaladdhassapi sāhu dānaṃ ",
  "sn1.33:12.5": "apica viceyyadānaṃpi sādhu ",
  "sn1.33:13.1": "viceyyadānaṃ sugatappasatthaṃ ",
  "sn1.33:13.2": "ye dakkhiṇeyyā idha jīvaloke ",
  "sn1.33:13.3": "etesu dinnāni mahapphalāni ",
  "sn1.33:13.4": "vījāni vuttāni yathā sukhetteti. ",
  "sn1.33:14.1": "atha kho aparā devatā bhagavato santike imaṃ udānaṃ udānesi ",
  "sn1.33:15.1": "sādhu kho mārisa dānaṃ ",
  "sn1.33:15.2": "appakasmiṃpi sāhu dānaṃ ",
  "sn1.33:15.3": "saddhāyapi sāhu dānaṃ ",
  "sn1.33:15.4": "dhammaladdhassapi sāhu dānaṃ ",
  "sn1.33:15.5": "viceyyadānaṃpi sādhu ",
  "sn1.33:15.6": "apica pāṇesupi sādhu saṃyamo ",
  "sn1.33:16.1": "yo pāṇabhūtāniaheṭhayaṃ caraṃ ",
  "sn1.33:16.2": "parūpavādā na karoti pāpaṃ ",
  "sn1.33:16.3": "bhīruṃ pasaṃsanti na hi tattha sūraṃ ",
  "sn1.33:16.4": "bhayā hi santo na karonti pāpanti. ",
  "sn1.33:17.1": "atha kho aparā devatā bhagavantaṃ etadavoca ",
  "sn1.33:17.2": "kassa nu kho bhagavā subhāsitanti. ",
  "sn1.33:18.1": "sabbāsaṃ vo subhāsitaṃ pariyāyena apica mamāpi suṇātha ",
  "sn1.33:19.1": "saddhāhi dānaṃ bahudhā pasatthaṃ ",
  "sn1.33:19.2": "dānā ca kho dhammapadaṃva seyyo ",
  "sn1.33:19.3": "pubbeva hi pubbatareva santo ",
  "sn1.33:19.4": "nibbānamevajjhagamama sapaññāti. "
}
