{
  "sn1.71:0.1": "",
  "sn1.71:0.2": "ghatvāvaggo aṭṭhamo ",
  "sn1.71:0.3": "paṭhamaṃ ghatvāsuttaṃ ",
  "sn1.71:1.1": "",
  "sn1.71:1.2": "ekamantaṃ ṭhitā kho sā devatā bhagavantaṃ gāthāya ajjhabhāsi ",
  "sn1.71:2.1": "kiṃsu ghatvā sukhaṃ seti ",
  "sn1.71:2.2": "kiṃsu ghatvā na socati ",
  "sn1.71:2.3": "kissassa ekadhammassa ",
  "sn1.71:2.4": "vadhaṃ rocesi gotamāti. ",
  "sn1.71:3.1": "kodhaṃ ghatvā sukhaṃ seti ",
  "sn1.71:3.2": "kodhaṃ ghatvā na socati ",
  "sn1.71:3.3": "kodhassa visamūlassa ",
  "sn1.71:3.4": "madhuraggassa devate ",
  "sn1.71:3.5": "vadhaṃ ariyā pasaṃsanti ",
  "sn1.71:3.6": "tañhi ghatvā na socatīti. "
}
