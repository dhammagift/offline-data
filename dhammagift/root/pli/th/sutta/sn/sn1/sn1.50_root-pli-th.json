{
  "sn1.50:0.1": "",
  "sn1.50:0.2": "",
  "sn1.50:0.3": "dasamaṃ ghaṭikarasuttaṃ ",
  "sn1.50:1.1": "avihaṃ upapannāse ",
  "sn1.50:1.2": "vimuttā satta bhikkhavo ",
  "sn1.50:1.3": "rāgadosaparikkhīṇā ",
  "sn1.50:1.4": "tiṇṇā loke visattikanti. ",
  "sn1.50:2.1": "ye ca te ataruṃ saṅgaṃ ",
  "sn1.50:2.2": "maccudheyyaṃ suduttaraṃ ",
  "sn1.50:2.3": "te hitvā mānusaṃ dehaṃ ",
  "sn1.50:2.4": "dibbayogaṃ upaccagunti. ",
  "sn1.50:3.1": "upako phalagaṇḍo ca ",
  "sn1.50:3.2": "pukkusāti ca te tayo ",
  "sn1.50:3.3": "bhaddiyo khaṇḍadevo ca ",
  "sn1.50:3.4": "bahudantī ca siṅgiyo ",
  "sn1.50:3.5": "te hitvā mānusaṃ dehaṃ ",
  "sn1.50:3.6": "dibbayogaṃ upaccagunti. ",
  "sn1.50:4.1": "kusalī bhāsasī tesaṃ ",
  "sn1.50:4.2": "mārapāsappahāyinaṃ ",
  "sn1.50:4.3": "kassa te dhammamaññāya ",
  "sn1.50:4.4": "acchiduṃ bhavabandhananti. ",
  "sn1.50:5.1": "na aññatra bhagavatā ",
  "sn1.50:5.2": "nāññatra tava sāsanā ",
  "sn1.50:5.3": "yassa te dhammamaññāya ",
  "sn1.50:5.4": "acchiduṃ bhavabandhanaṃ ",
  "sn1.50:6.1": "yattha nāmañca rūpañca ",
  "sn1.50:6.2": "asesaṃ uparujjhati ",
  "sn1.50:6.3": "taṃ te dhammamidhaññāya ",
  "sn1.50:6.4": "acchiduṃ bhavabandhananti. ",
  "sn1.50:7.1": "gambhīraṃ bhāsasī vācaṃ ",
  "sn1.50:7.2": "dubbijānaṃ sudubbudhaṃ ",
  "sn1.50:7.3": "kassa tvaṃ dhammamaññāya ",
  "sn1.50:7.4": "vācaṃ bhāsasi īdisanti. ",
  "sn1.50:8.1": "kumbhakāro pure āsiṃ ",
  "sn1.50:8.2": "vebhaḷiṅge ghaṭīkaro ",
  "sn1.50:8.3": "mātāpettibharo āsiṃ ",
  "sn1.50:8.4": "kassapassa upāsako ",
  "sn1.50:9.1": "virato methunā dhammā ",
  "sn1.50:9.2": "brahmacārī nirāmiso ",
  "sn1.50:9.3": "ahuvā te sagāmeyyo ",
  "sn1.50:9.4": "ahuvā te pure sakhā ",
  "sn1.50:10.1": "sohamete pajānāmi ",
  "sn1.50:10.2": "vimutte satta bhikkhavo ",
  "sn1.50:10.3": "rāgadosaparikkhīṇe ",
  "sn1.50:10.4": "tiṇṇe loke visattikanti. ",
  "sn1.50:11.1": "evametaṃ tadā āsi ",
  "sn1.50:11.2": "yathā bhāsasi bhaggava ",
  "sn1.50:11.3": "kumbhakāro pure āsi ",
  "sn1.50:11.4": "vebhaḷiṅge ghaṭīkaro ",
  "sn1.50:11.5": "mātāpettibharo āsi ",
  "sn1.50:11.6": "kassapassa upāsako ",
  "sn1.50:12.1": "virato methunā dhammā ",
  "sn1.50:12.2": "brahmacārī nirāmiso ",
  "sn1.50:12.3": "ahuvā me sagāmeyyo ",
  "sn1.50:12.4": "ahuvā me pure sakhāti. ",
  "sn1.50:13.1": "evametaṃ purāṇānaṃ ",
  "sn1.50:13.2": "sahāyānamahu saṅgamo ",
  "sn1.50:13.3": "ubhinnaṃ bhāvitattānaṃ ",
  "sn1.50:13.4": "sarīrantimadhārinanti. ",
  "sn1.50:13.5": "ādittavaggo pañcamo. ",
  "sn1.50:14.0": "tassuddānaṃ ",
  "sn1.50:14.1": "ādittaṃ kindadaṃ annaṃ ",
  "sn1.50:14.2": "ekamūlaṃ anomiyaṃ ",
  "sn1.50:14.3": "accharā vanaropajetaṃ ",
  "sn1.50:14.4": "maccherena ghaṭīkaroti. "
}
