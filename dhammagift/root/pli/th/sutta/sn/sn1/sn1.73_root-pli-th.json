{
  "sn1.73:0.1": "",
  "sn1.73:0.2": "",
  "sn1.73:0.3": "tatiyaṃ vittasuttaṃ ",
  "sn1.73:1.1": "kiṃsūdha vittaṃ purisassa seṭṭhaṃ ",
  "sn1.73:1.2": "kiṃsu suciṇṇo sukhamāvahāti ",
  "sn1.73:1.3": "kiṃsu have sādhutaraṃ rasānaṃ ",
  "sn1.73:1.4": "kathaṃjīvī jīvitamāhu seṭṭhanti. ",
  "sn1.73:2.1": "saddhīdha vittaṃ purisassa seṭṭhaṃ ",
  "sn1.73:2.2": "dhammo suciṇṇo sukhamāvahāti ",
  "sn1.73:2.3": "saccaṃ have sādhutaraṃ rasānaṃ ",
  "sn1.73:2.4": "paññājīvī jīvitamāhu seṭṭhanti. "
}
