{
  "sn1.47:0.1": "",
  "sn1.47:0.2": "",
  "sn1.47:0.3": "sattamaṃ vanaropasuttaṃ ",
  "sn1.47:1.1": "kesaṃ divā ca ratto ca ",
  "sn1.47:1.2": "sadā puññaṃ pavaḍḍhati ",
  "sn1.47:1.3": "dhammaṭṭhā sīlasampannā ",
  "sn1.47:1.4": "ke janā saggagāminoti. ",
  "sn1.47:2.1": "ārāmaropā vanaropā ",
  "sn1.47:2.2": "ye janā setukārakā ",
  "sn1.47:2.3": "papañca udapānañca ",
  "sn1.47:2.4": "ye dadanti upassayaṃ ",
  "sn1.47:3.1": "tesaṃ divā ca ratto ca ",
  "sn1.47:3.2": "sadā puññaṃ pavaḍḍhati ",
  "sn1.47:3.3": "dhammaṭṭhā sīlasampannā ",
  "sn1.47:3.4": "te janā saggagāminoti. "
}
