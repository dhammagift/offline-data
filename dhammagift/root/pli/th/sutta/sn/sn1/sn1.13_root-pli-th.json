{
  "sn1.13:0.1": "",
  "sn1.13:0.2": "",
  "sn1.13:0.3": "tatiyaṃ natthiputtasamasuttaṃ ",
  "sn1.13:1.1": "",
  "sn1.13:1.2": "ekamantaṃ ṭhitā kho sā devatā bhagavato santike imaṃ gāthaṃ abhāsi ",
  "sn1.13:2.1": "natthi puttasamaṃ pemaṃ ",
  "sn1.13:2.2": "natthi gosamikaṃ dhanaṃ ",
  "sn1.13:2.3": "natthi suriyasamā ābhā ",
  "sn1.13:2.4": "samuddaparamā sarāti. ",
  "sn1.13:3.1": "natthi attasamaṃ pemaṃ ",
  "sn1.13:3.2": "natthi dhaññasamaṃ dhanaṃ ",
  "sn1.13:3.3": "natthi paññāsamā ābhā ",
  "sn1.13:3.4": "vuṭṭhi ve paramā sarāti. "
}
