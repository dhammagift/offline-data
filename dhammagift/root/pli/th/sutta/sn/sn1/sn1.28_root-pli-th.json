{
  "sn1.28:0.1": "",
  "sn1.28:0.2": "",
  "sn1.28:0.3": "aṭṭhamaṃ mahaddhanasuttaṃ ",
  "sn1.28:1.1": "mahaddhanā mahābhogā ",
  "sn1.28:1.2": "raṭṭhavantopi khattiyā ",
  "sn1.28:1.3": "aññamaññābhigijjhanti ",
  "sn1.28:1.4": "kāmesu analaṅkatā ",
  "sn1.28:2.1": "tesu ussukajātesu ",
  "sn1.28:2.2": "bhavasotānusārisu ",
  "sn1.28:2.3": "rodhataṇhaṃ pavāhiṃsu ",
  "sn1.28:2.4": "ke lokasmiṃ anussukāti. ",
  "sn1.28:3.1": "hitvā agāraṃ pabbajitā ",
  "sn1.28:3.2": "hitvā puttaṃ pasumpiyaṃ ",
  "sn1.28:3.3": "hitvā rāgañca dosañca ",
  "sn1.28:3.4": "avijjañca virājiya ",
  "sn1.28:3.5": "khīṇāsavā arahanto ",
  "sn1.28:3.6": "te lokasmiṃ anussukāti. "
}
