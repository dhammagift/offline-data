{
  "sn1.14:0.1": "",
  "sn1.14:0.2": "",
  "sn1.14:0.3": "catutthaṃ khattiyasuttaṃ ",
  "sn1.14:1.1": "ekamantaṃ ṭhitā kho sā devatā bhagavato santike imaṃ gāthaṃ abhāsi khattiyo dipadaṃ seṭṭho ",
  "sn1.14:1.2": "balibaddho catuppadaṃ ",
  "sn1.14:1.3": "komārī seṭṭhā bhariyānaṃ ",
  "sn1.14:1.4": "yo ca puttāna pubbajoti. ",
  "sn1.14:2.1": "sambuddho dipadaṃ seṭṭho ",
  "sn1.14:2.2": "ājānīyo catuppadaṃ ",
  "sn1.14:2.3": "sussūsā seṭṭhā bhariyānaṃ ",
  "sn1.14:2.4": "yo ca puttānamassavoti. "
}
