{
  "sn1.34:0.1": "",
  "sn1.34:0.2": "",
  "sn1.34:0.3": "catutthaṃ nasantisuttaṃ ",
  "sn1.34:1.1": "ekaṃ samayaṃ bhagavā sāvatthiyaṃ viharati jetavane anāthapiṇḍikassa ārāme. ",
  "sn1.34:1.2": "atha kho sambahulā satullapakāyikā devatāyo abhikkantāya rattiyā abhikkantavaṇṇā kevalakappaṃ jetavanaṃ obhāsetvā yena bhagavā tenupasaṅkamiṃsu upasaṅkamitvā bhagavantaṃ abhivādetvā ekamantaṃ aṭṭhaṃsu. ",
  "sn1.34:1.3": "ekamantaṃ ṭhitā kho ekā devatā bhagavato santike imaṃ gāthaṃ abhāsi ",
  "sn1.34:2.1": "na santi kāmā manujesu niccā ",
  "sn1.34:2.2": "santīdha kamanīyāni yesu baddho ",
  "sn1.34:2.3": "yesu pamatto apunāgamanaṃ ",
  "sn1.34:2.4": "anāgantvā puriso maccudheyyāti. ",
  "sn1.34:3.1": "chandajaṃ aghaṃ chandajaṃ dukkhaṃ ",
  "sn1.34:3.2": "chandavinayā aghavinayo ",
  "sn1.34:3.3": "aghavinayā dukkhavinayoti. ",
  "sn1.34:4.1": "na te kāmā yāni citrāni loke ",
  "sn1.34:4.2": "saṅkapparāgo purisassa kāmo ",
  "sn1.34:4.3": "tiṭṭhanti citrāni tatheva loke ",
  "sn1.34:4.4": "athettha dhīrā vinayanti chandaṃ. ",
  "sn1.34:5.1": "kodhaṃ jahe vippajaheyya mānaṃ ",
  "sn1.34:5.2": "saññojanaṃ sabbamatikkameyya ",
  "sn1.34:5.3": "taṃ nāmarūpasmimasajjamānaṃ ",
  "sn1.34:5.4": "akiñcanaṃ nānupatanti dukkhā. ",
  "sn1.34:6.1": "pahāsi saṅkhaṃ na vimānamāgā ",
  "sn1.34:6.2": "acchejji taṇhaṃ idha nāmarūpe ",
  "sn1.34:6.3": "taṃ chinnaganthaṃ anighaṃ nirāsaṃ ",
  "sn1.34:6.4": "pariyesamānā nājjhagamama ",
  "sn1.34:6.5": "devā manussā idha vā huraṃ vā ",
  "sn1.34:6.6": "saggesu vā sabbanivesanesūti. ",
  "sn1.34:7.1": "tañce hi nāddakkhuṃ tathā vimuttaṃ ",
  "sn1.34:7.2": "[iccāyasmā mogharājā] ",
  "sn1.34:7.3": "devā manussā idha vā huraṃ vā ",
  "sn1.34:7.4": "naruttamaṃ atthacaraṃ narānaṃ ",
  "sn1.34:7.5": "ye taṃ namassanti pasaṃsiyā teti. ",
  "sn1.34:8.1": "pasaṃsiyā tepi bhavanti bhikkhu ",
  "sn1.34:8.2": "[mogharājāti bhagavā] ",
  "sn1.34:8.3": "ye taṃ namassanti tathā vimuttaṃ ",
  "sn1.34:8.4": "aññāya dhammaṃ vicikicchaṃ pahāya ",
  "sn1.34:8.5": "saṅgātitā tepi bhavanti bhikkhūti. "
}
