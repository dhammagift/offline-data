{
  "sn1.4:0.1": "",
  "sn1.4:0.2": "",
  "sn1.4:0.3": "catutthaṃ accentisuttaṃ ",
  "sn1.4:1.1": "",
  "sn1.4:1.2": "ekamantaṃ ṭhitā kho sā devatā bhagavato santike imaṃ gāthaṃ abhāsi ",
  "sn1.4:2.1": "accenti kālā tarayanti rattiyo ",
  "sn1.4:2.2": "vayoguṇā anupubbaṃ jahanti ",
  "sn1.4:2.3": "etaṃ bhayaṃ maraṇe pekkhamāno ",
  "sn1.4:2.4": "puññāni kayirātha sukhāvahānīti. ",
  "sn1.4:3.1": "accenti kālā tarayanti rattiyo ",
  "sn1.4:3.2": "vayoguṇā anupubbaṃ jahanti ",
  "sn1.4:3.3": "etaṃ bhayaṃ maraṇe pekkhamāno ",
  "sn1.4:3.4": "lokāmisaṃ pajahe santipekkhoti. "
}
