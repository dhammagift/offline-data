{
  "sn1.27:0.1": "",
  "sn1.27:0.2": "",
  "sn1.27:0.3": "sattamaṃ sarasuttaṃ ",
  "sn1.27:1.1": "kuto sarā nivattanti ",
  "sn1.27:1.2": "kattha vaṭṭaṃ na vattati ",
  "sn1.27:1.3": "kattha nāmañca rūpañca ",
  "sn1.27:1.4": "asesaṃ uparujjhatīti. ",
  "sn1.27:2.1": "yattha āpo ca paṭhavī ",
  "sn1.27:2.2": "tejo vāyo na gādhati ",
  "sn1.27:2.3": "ato sarā nivattanti ",
  "sn1.27:2.4": "ettha vaṭṭaṃ na vattati ",
  "sn1.27:2.5": "ettha nāmañca rūpañca ",
  "sn1.27:2.6": "asesaṃ uparujjhatīti. "
}
