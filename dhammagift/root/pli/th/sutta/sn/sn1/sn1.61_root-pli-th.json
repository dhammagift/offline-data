{
  "sn1.61:0.1": "",
  "sn1.61:0.2": "andhavaggo sattamo ",
  "sn1.61:0.3": "paṭhamaṃ nāmasuttaṃ ",
  "sn1.61:1.1": "kiṃsu sabbaṃ andhabhavi ",
  "sn1.61:1.2": "kismā bhiyyo na vijjati ",
  "sn1.61:1.3": "kissassa ekadhammassa ",
  "sn1.61:1.4": "sabbeva vasamanvagūti. ",
  "sn1.61:2.1": "nāmaṃ sabbaṃ andhabhavi ",
  "sn1.61:2.2": "nāmā bhiyyo na vijjati ",
  "sn1.61:2.3": "nāmassa ekadhammassa ",
  "sn1.61:2.4": "sabbeva vasamanvagūti. "
}
