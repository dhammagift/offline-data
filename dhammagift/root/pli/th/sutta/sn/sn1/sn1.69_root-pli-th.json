  "sn1.69:0.3": "navamaṃ icchāsuttaṃ ",
  "sn1.69:1.1": "kenassu bajjhati loko ",
  "sn1.69:1.2": "kissa vinayāya muccati ",
  "sn1.69:1.3": "kissassa vippahānena ",
  "sn1.69:1.4": "sabbaṃ chindati bandhananti. ",
  "sn1.69:2.1": "icchāya bajjhati loko ",
  "sn1.69:2.2": "icchāvinayāya muccati ",
  "sn1.69:2.3": "icchāya vippahānena ",
  "sn1.69:2.4": "sabbaṃ chindati bandhananti. "
}
