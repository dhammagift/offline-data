{
  "sn1.64:0.1": "",
  "sn1.64:0.2": "",
  "sn1.64:0.3": "catutthaṃ saññojanasuttaṃ ",
  "sn1.64:1.1": "kiṃsu saññojano loko ",
  "sn1.64:1.2": "kiṃsu tassa vicāraṇaṃ ",
  "sn1.64:1.3": "kissassa vippahānena ",
  "sn1.64:1.4": "nibbānaṃ iti vuccatīti. ",
  "sn1.64:2.1": "nandisaññojano loko ",
  "sn1.64:2.2": "vitakkassa vicāraṇaṃ ",
  "sn1.64:2.3": "taṇhāya vippahānena ",
  "sn1.64:2.4": "nibbānaṃ iti vuccatīti. "
}
