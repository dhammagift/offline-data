{
  "sn1.75:0.1": "",
  "sn1.75:0.2": "",
  "sn1.75:0.3": "pañcamaṃ bhītasuttaṃ ",
  "sn1.75:1.1": "kiṃsūdha bhītā janatā anekā ",
  "sn1.75:1.2": "maggovanekāyatanappavutto ",
  "sn1.75:1.3": "pucchāmi taṃ gotama bhūripañña ",
  "sn1.75:1.4": "kismiṃ ṭhito paralokaṃ na bhāyeti. ",
  "sn1.75:2.1": "vācaṃ manañca paṇidhāya sammā ",
  "sn1.75:2.2": "kāyena pāpāni akubbamāno ",
  "sn1.75:2.3": "bahunnapānaṃ gharamāvasanto ",
  "sn1.75:2.4": "saddho mudū saṃvibhāgī vadaññū ",
  "sn1.75:2.5": "etesu dhammesu ṭhito catūsu ",
  "sn1.75:2.6": "dhamme ṭhito paralokaṃ na bhāyeti. "
}
