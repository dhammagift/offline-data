{
  "sn1.54:0.1": "",
  "sn1.54:0.2": "",
  "sn1.54:0.3": "catutthaṃ vatthusuttaṃ ",
  "sn1.54:1.1": "kiṃsu vatthu manussānaṃ ",
  "sn1.54:1.2": "kiṃsūdha paramā sakhā ",
  "sn1.54:1.3": "kiṃsu bhūtā upajīvanti ",
  "sn1.54:1.4": "ye pāṇā paṭhaviṃ sitāti. ",
  "sn1.54:2.1": "puttā vatthu manussānaṃ ",
  "sn1.54:2.2": "bhariyā paramā sakhā ",
  "sn1.54:2.3": "vuṭṭhiṃ bhūtā upajīvanti ",
  "sn1.54:2.4": "ye pāṇā paṭhaviṃ sitāti. "
}
