{
  "sn17.13-20:0.1": "",
  "sn17.13-20:0.2": "",
  "sn17.13-20:0.3": "",
  "sn17.13-20:1.1": "sāvatthiyaṃ viharati … ",
  "sn17.13-20:1.2": "idhāhaṃ bhikkhave ekaccaṃ puggalaṃ evaṃ cetasā ceto paricca pajānāmi ",
  "sn17.13-20:1.3": "na vāyamāyasmā suvaṇṇa nikkhassapi hetu … ",
  "sn17.13-20:1.4": "suvaṇṇanikkhasatassapi hetu … ",
  "sn17.13-20:1.5": "siṅginikkhassapi hetu … ",
  "sn17.13-20:1.6": "siṅginikkhasatassapi hetu … ",
  "sn17.13-20:1.7": "paṭhaviyāpi jātarūpaparipūrāya hetu … ",
  "sn17.13-20:1.8": "āmisakiñcikkhahetupi … ",
  "sn17.13-20:1.9": "jīvitahetupi … ",
  "sn17.13-20:1.10": "janapadakalyāṇiyāpi hetu sam pajānamusā bhāseyyāti ",
  "sn17.13-20:1.11": "tamenaṃ passāmi aparena samayena lābha sakkārasilokena abhibhūtaṃ pariyādinnacittaṃ sampajānamusā bhāsantaṃ. ",
  "sn17.13-20:1.12": "evaṃ dāruṇo kho bhikkhave lābhasakkārasiloko …pe… ",
  "sn17.13-20:1.13": "evañhi vo bhikkhave sikkhitabbanti. ",
  "sn17.13-20:1.14": "dasamaṃ. dutiyavaggo ",
  "sn17.13-20:1.15": "dutiyo. tassa uddānaṃ ",
  "sn17.13-20:2.0": "",
  "sn17.13-20:2.1": "dve pātī dveva suvaṇṇā ",
  "sn17.13-20:2.2": "siṅgīhi apare duve ",
  "sn17.13-20:2.3": "paṭhavī kiñcikkhajīvita- ",
  "sn17.13-20:2.4": "janapadakalyāṇiyā dasāti. "
}
