{
  "sn17.21:0.1": "",
  "sn17.21:0.2": "tatiyavaggo tatiyo ",
  "sn17.21:0.3": "",
  "sn17.21:1.1": "sāvatthiyaṃ viharati … tatra kho bhagavā … ",
  "sn17.21:1.2": "dāruṇo bhikkhave lābhasakkārasiloko …pe… adhigamāya. ",
  "sn17.21:1.3": "na tassa bhikkhave mātugāmo eko ekassa cittaṃ pariyādāya tiṭṭhati yassa lābhasakkārasiloko cittaṃ pariyādāya tiṭṭhati …pe… ",
  "sn17.21:1.4": "evaṃ dāruṇo kho bhikkhave lābhasakkārasiloko …pe… ",
  "sn17.21:1.5": "evañhi vo bhikkhave sikkhitabbanti. ",
  "sn17.21:1.6": "paṭhamaṃ. "
}
