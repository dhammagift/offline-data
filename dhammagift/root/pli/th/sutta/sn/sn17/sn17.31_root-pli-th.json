{
  "sn17.31:0.1": "",
  "sn17.31:0.2": "catutthavaggo catuttho ",
  "sn17.31:0.3": "",
  "sn17.31:1.1": "sāvatthiyaṃ viharati … tatra kho bhagavā … ",
  "sn17.31:1.2": "dāruṇo bhikkhave lābhasakkārasiloko …pe… ",
  "sn17.31:1.3": "lābhasakkārasilokena abhibhūto pariyādinnacitto bhikkhave devadatto saṅghaṃ bhindi. ",
  "sn17.31:1.4": "evaṃ dāruṇo kho bhikkhave lābhasakkārasiloko …pe… ",
  "sn17.31:1.5": "sikkhitabbanti. ",
  "sn17.31:1.6": "paṭhamaṃ. "
}
