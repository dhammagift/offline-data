  "sn17.22:0.3": "",
  "sn17.22:1.1": "sāvatthiyaṃ viharati … ",
  "sn17.22:1.2": "dāruṇo bhikkhave lābhasakkārasiloko …pe… adhigamāya. ",
  "sn17.22:1.3": "na tassa bhikkhave janapadakalyāṇī ekā ekassa cittaṃ pariyādāya tiṭṭhati yassa lābhasakkārasiloko cittaṃ pariyādāya tiṭṭhati …pe… ",
  "sn17.22:1.4": "evaṃ dāruṇo kho bhikkhave lābhasakkārasiloko …pe… ",
  "sn17.22:1.5": "evañhi vo bhikkhave sikkhitabbanti. ",
  "sn17.22:1.6": "dutiyaṃ. "
}
