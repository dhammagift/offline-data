  "sn47.42:0.1": "",
  "sn47.42:0.2": "",
  "sn47.42:0.3": "",
  "sn47.42:1.1": "catunnaṃ bhikkhave satipaṭṭhānānaṃ samudayañca atthaṅgamañca desissāmi ",
  "sn47.42:1.2": "taṃ suṇātha. ",
  "sn47.42:1.3": "ko ca bhikkhave kāyassa samudayo. ",
  "sn47.42:1.4": "āhārasamudayā kāyassa samudayo ",
  "sn47.42:1.5": "āhāranirodhā kāyassa atthaṅgamo ",
  "sn47.42:1.6": "phassasamudayā vedanānaṃ samudayo ",
  "sn47.42:1.7": "phassanirodhā vedanānaṃ atthaṅgamo ",
  "sn47.42:1.8": "nāmarūpasamudayā cittassa samudayo ",
  "sn47.42:1.9": "nāmarūpanirodhā cittassa atthaṅgamo ",
  "sn47.42:1.10": "manasikārasamudayā dhammānaṃ samudayo ",
  "sn47.42:1.11": "manasikāranirodhā dhammānaṃ atthaṅgamoti. ",
  "sn47.42:1.12": ""
}
