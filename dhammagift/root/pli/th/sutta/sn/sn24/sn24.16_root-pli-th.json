  "sn24.16:1.1": "sāvatthī. tatra kho. ",
  "sn24.16:1.2": "kasmiṃ nu kho bhikkhave sati kiṃ upādāya kiṃ abhinivissa evaṃ diṭṭhi uppajjati ",
  "sn24.16:1.3": "na hoti tathāgato parammaraṇāti. ",
  "sn24.16:1.4": "bhagavaṃmūlakā no bhante dhammā …pe… ",
  "sn24.16:1.5": "niyato sambodhiparāyanoti. ",
  "sn24.16:1.6": ""
}
