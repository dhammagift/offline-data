  "sn24.44:1.1": "adukkhamasukhī attā hoti arogo parammaraṇāti. ",
  "sn24.44:1.2": "bhagavaṃmūlakā no bhante dhammā …pe… ",
  "sn24.44:2.1": "rūpe kho bhikkhave sati rūpaṃ upādāya rūpaṃ abhinivissa evaṃ diṭṭhi uppajjati ",
  "sn24.44:2.2": "adukkhamasukhī attā hoti arogo parammaraṇāti. ",
  "sn24.44:2.3": "vedanāya sati …pe… ",
  "sn24.44:2.4": "saññāya sati. ",
  "sn24.44:2.5": "saṅkhāresu sati. ",
  "sn24.44:2.6": "viññāṇe sati viññāṇaṃ upādāya viññāṇaṃ abhinivissa evaṃ diṭṭhi uppajjati ",
  "sn24.44:2.7": "adukkhamasukhī attā hoti arogo parammaraṇāti. ",
  "sn24.44:3.1": "taṃ kiṃ maññatha bhikkhave rūpaṃ niccaṃ vā aniccaṃ vāti. ",
  "sn24.44:3.2": "aniccaṃ bhante …pe… ",
  "sn24.44:3.3": "vipariṇāmadhammaṃ api nu taṃ anupādāya evaṃ diṭṭhi uppajjeyya ",
  "sn24.44:3.4": "adukkhamasukhī attā hoti arogo paramamaraṇāti. ",
  "sn24.44:3.5": "no hetaṃ bhante. ",
  "sn24.44:3.6": "iti kho bhikkhave dukkhe sati dukkhaṃ upādāya dukkhaṃ abhinivissa evaṃ diṭṭhi uppajjati ",
  "sn24.44:3.7": "adukkhamasukhī attā hoti arogo parammaraṇāti. ",
  "sn24.44:3.8": "vedanā …pe… ",
  "sn24.44:3.9": "saññā. ",
  "sn24.44:3.10": "saṅkhārā. ",
  "sn24.44:3.11": "viññāṇaṃ niccaṃ vā aniccaṃ vāti. ",
  "sn24.44:3.12": "aniccaṃ bhante …pe… ",
  "sn24.44:3.13": "vipariṇāmadhammaṃ api nu taṃ anupādāya evaṃ diṭṭhi uppajjeyya ",
  "sn24.44:3.14": "adukkhamasukhī attā hoti arogo parammaraṇāti. ",
  "sn24.44:3.15": "no hetaṃ bhante. ",
  "sn24.44:3.16": "iti kho bhikkhave dukkhe sati dukkhaṃ upādāya dukkhaṃ abhinivissa evaṃ diṭṭhi uppajjati ",
  "sn24.44:3.17": "adukkhamasukhī attā hoti arogo parammaraṇāti ( ",
  "sn24.44:3.18": "",
  "sn24.44:3.19": "dutiyapeyyālo ). ",
