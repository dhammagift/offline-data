  "sn35.170:1.1": "yaṃ bhikkhave aniccaṃ tatra vo chandarāgo pahātabbo. ",
  "sn35.170:1.2": "kiñca bhikkhave aniccaṃ. ",
  "sn35.170:1.3": "cakkhuṃ bhikkhave aniccaṃ ",
  "sn35.170:1.4": "tatra vo chandarāgo pahātabbo …pe… ",
  "sn35.170:1.5": "jivhā aniccā ",
  "sn35.170:1.6": "tatra vo chandarāgo pahātabbo …pe… ",
  "sn35.170:1.7": "mano anicco ",
  "sn35.170:1.8": "tatra vo chandarāgo pahātabbo. ",
  "sn35.170:1.9": "yaṃ bhikkhave aniccaṃ tatra vo chandarāgo pahātabboti. "
}
