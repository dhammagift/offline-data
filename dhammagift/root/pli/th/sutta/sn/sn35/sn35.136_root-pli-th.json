  "sn35.136:0.1": "",
  "sn35.136:0.2": "",
  "sn35.136:0.3": "",
  "sn35.136:1.1": "rūpārāmā bhikkhave devamanussā rūparatā rūpasamuditā ",
  "sn35.136:1.2": "rūpavipariṇāmavirāganirodhā dukkhā bhikkhave devamanussā viharanti. ",
  "sn35.136:1.3": "saddārāmā bhikkhave devamanussā saddaratā saddasammuditā ",
  "sn35.136:1.4": "saddavipariṇāmavirāganirodhā dukkhā bhikkhave devamanussā viharanti. ",
  "sn35.136:1.5": "gandhārāmā ",
  "sn35.136:1.6": "rasārāmā ",
  "sn35.136:1.7": "phoṭṭhabbārāmā ",
  "sn35.136:1.8": "dhammārāmā bhikkhave devamanussā dhammaratā dhammasamuditā ",
  "sn35.136:1.9": "dhammavipariṇāmavirāganirodhā dukkhā bhikkhave devamanussā viharanti. ",
  "sn35.136:1.10": "tathāgato ca kho bhikkhave arahaṃ sammāsambuddho rūpānaṃ samudayañca atthaṅgamañca assādañca ādīnavañca nissaraṇañca yathābhūtaṃ viditvā na rūpārāmo na rūparato na rūpasamudito ",
  "sn35.136:1.11": "rūpavipariṇāmavirāganirodhā sukho bhikkhave tathāgato viharati. ",
  "sn35.136:1.12": "saddānaṃ ",
  "sn35.136:1.13": "gandhānaṃ ",
  "sn35.136:1.14": "rasānaṃ ",
  "sn35.136:1.15": "phoṭṭhabbānaṃ ",
  "sn35.136:1.16": "dhammānaṃ samudayañca atthaṅgamañca assādañca ādīnavañca nissaraṇañca yathābhūtaṃ viditvā na dhammārāmo na dhammarato na dhammasamudito ",
  "sn35.136:1.17": "dhammavipariṇāmavirāganirodhā sukho bhikkhave tathāgato viharatīti. ",
  "sn35.136:1.18": "idamavoca bhagavā ",
  "sn35.136:1.19": "idaṃ vatvāna sugato athāparaṃ etadavoca satthā ",
  "sn35.136:2.1": "rūpā saddā gandhā rasā ",
  "sn35.136:2.2": "phassā dhammā ca kevalā ",
  "sn35.136:2.3": "iṭṭhā kantā manāpā ca ",
  "sn35.136:2.4": "yāvatatthīti vuccati. ",
  "sn35.136:3.1": "sadevakassa lokassa ",
  "sn35.136:3.2": "ete vo sukhasammatā ",
  "sn35.136:3.3": "yattha ce te nirujjhanti ",
  "sn35.136:3.4": "taṃ tesaṃ dukkhasammataṃ. ",
  "sn35.136:4.1": "sukhaṃ ca diṭṭhamariyebhi ",
  "sn35.136:4.2": "sakkāyassa nirodhanaṃ ",
  "sn35.136:4.3": "paccanikamidaṃ hoti ",
  "sn35.136:4.4": "sabbalokena passataṃ. ",
  "sn35.136:5.1": "yaṃ pare sukhato āhu ",
  "sn35.136:5.2": "tadariyā ahu dukkhato ",
  "sn35.136:5.3": "yaṃ pare dukkhato āhu ",
  "sn35.136:5.4": "tadariyā sukhato vidū. ",
  "sn35.136:6.1": "passa dhammaṃ duvijānaṃ ",
  "sn35.136:6.2": "sammūḷhettha aviddasu ",
  "sn35.136:6.3": "nivutānaṃ tamo hoti ",
  "sn35.136:6.4": "andhakāro apassataṃ. ",
  "sn35.136:7.1": "satañca vivaṭaṃ hoti ",
  "sn35.136:7.2": "āloko passatāmiva ",
  "sn35.136:7.3": "santike na vijānanti ",
  "sn35.136:7.4": "maggā dhammassa akovidā. ",
  "sn35.136:8.1": "bhavarāgaparetehi ",
  "sn35.136:8.2": "bhavasotānusāribhi ",
  "sn35.136:8.3": "māradheyyānupannebhi ",
  "sn35.136:8.4": "nāyaṃ dhammo susambuddho. ",
  "sn35.136:9.1": "ko nu aññatramariyebhi ",
  "sn35.136:9.2": "padaṃ sambuddhamarahati ",
  "sn35.136:9.3": "yaṃ padaṃ sammadaññāya ",
  "sn35.136:9.4": "parinibbanti anāsavāti. ",
  "sn35.136:9.5": "tatiyaṃ. "
}
