  "sn35.107:0.1": "",
  "sn35.107:0.2": "",
  "sn35.107:0.3": "",
  "sn35.107:1.1": "lokassa bhikkhave samudayañca atthaṅgamañca desissāmi ",
  "sn35.107:1.2": "taṃ suṇātha. ",
  "sn35.107:1.3": "katamo ca bhikkhave lokassa samudayo. ",
  "sn35.107:1.4": "cakkhuñca paṭicca rūpe ca uppajjati cakkhuviññāṇaṃ tiṇṇaṃ saṅgati phasso ",
  "sn35.107:1.5": "phassapaccayā vedanā ",
  "sn35.107:1.6": "vedanāpaccayā taṇhā ",
  "sn35.107:1.7": "taṇhāpaccayā upādānaṃ ",
  "sn35.107:1.8": "upādānapaccayā bhavo ",
  "sn35.107:1.9": "bhavapaccayā jāti ",
  "sn35.107:1.10": "jātipaccayā jarāmaraṇaṃ sokaparidevadukkhadomanassupāyāsā sambhavanti. ",
  "sn35.107:1.11": "ayaṃ lokassa samudayo …pe… ",
  "sn35.107:1.12": "jivhañca paṭicca rase ca uppajjati …pe… ",
  "sn35.107:1.13": "manañca paṭicca dhamme ca uppajjati manoviññāṇaṃ tiṇṇaṃ saṅgati phasso ",
  "sn35.107:1.14": "phassapaccayā vedanā ",
  "sn35.107:1.15": "vedanāpaccayā taṇhā ",
  "sn35.107:1.16": "taṇhāpaccayā upādānaṃ ",
  "sn35.107:1.17": "upādānapaccayā bhavo ",
  "sn35.107:1.18": "bhavapaccayā jāti ",
  "sn35.107:1.19": "jātipaccayā jarāmaraṇaṃ sokaparidevadukkhadomanassupāyāsā sambhavanti. ",
  "sn35.107:1.20": "ayaṃ kho bhikkhave lokassa samudayo. ",
  "sn35.107:2.1": "katamo ca bhikkhave lokassa atthaṅgamo. ",
  "sn35.107:2.2": "cakkhuñca paṭicca rūpe ca uppajjati cakkhuviññāṇaṃ tiṇṇaṃ saṅgati phasso ",
  "sn35.107:2.3": "phassapaccayā vedanā ",
  "sn35.107:2.4": "vedanāpaccayā taṇhā ",
  "sn35.107:2.5": "tassā yeva taṇhāya asesavirāganirodhā upādānanirodho ",
  "sn35.107:2.6": "upādānanirodhā bhavanirodho ",
  "sn35.107:2.7": "bhavanirodhā jātinirodho ",
  "sn35.107:2.8": "jātinirodhā jarāmaraṇaṃ sokaparidevadukkhadomanassupāyāsā nirujjhanti. ",
  "sn35.107:2.9": "evametassa kevalassa dukkhakkhandhassa nirodho hoti. ",
  "sn35.107:2.10": "ayaṃ lokassa atthaṅgamo …pe… ",
  "sn35.107:2.11": "jivhañca paṭicca rase ca uppajjati …pe… ",
  "sn35.107:2.12": "manañca paṭicca dhamme ca uppajjati manoviññāṇaṃ tiṇṇaṃ saṅgati phasso ",
  "sn35.107:2.13": "phassapaccayā vedanā ",
  "sn35.107:2.14": "vedanāpaccayā taṇhā ",
  "sn35.107:2.15": "tassāyeva taṇhāya asesavirāganirodhā upādānanirodho ",
  "sn35.107:2.16": "…pe… ",
  "sn35.107:2.17": "evametassa kevalassa dukkhakkhandhassa nirodho hoti. ",
  "sn35.107:2.18": "ayaṃ kho bhikkhave lokassa atthaṅgamoti. ",
  "sn35.107:2.19": "catutthaṃ. "
}
