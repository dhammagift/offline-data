  "sn35.169:1.1": "yaṃ bhikkhave aniccaṃ tatra vo rāgo pahātabbo. ",
  "sn35.169:1.2": "kiñca bhikkhave aniccaṃ. ",
  "sn35.169:1.3": "cakkhuṃ bhikkhave aniccaṃ ",
  "sn35.169:1.4": "tatra vo rāgo pahātabbo …pe… ",
  "sn35.169:1.5": "jivhā aniccā ",
  "sn35.169:1.6": "tatra vo rāgo pahātabbo …pe… ",
  "sn35.169:1.7": "mano anicco ",
  "sn35.169:1.8": "tatra vo rāgo pahātabbo. ",
  "sn35.169:1.9": "yaṃ bhikkhave aniccaṃ tatra vo rāgo pahātabboti. "
}
