  "sn35.137:0.1": "",
  "sn35.137:0.2": "",
  "sn35.137:0.3": "",
  "sn35.137:1.1": "rūpārāmā bhikkhave devamanussā rūparatā rūpasamuditā ",
  "sn35.137:1.2": "rūpavipariṇāmavirāganirodhā dukkhā bhikkhave devamanussā viharanti. ",
  "sn35.137:1.3": "saddārāmā ",
  "sn35.137:1.4": "gandhārāmā ",
  "sn35.137:1.5": "rasārāmā ",
  "sn35.137:1.6": "phoṭṭhabbārāmā ",
  "sn35.137:1.7": "dhammārāmā bhikkhave devamanussā dhammaratā dhammasamuditā ",
  "sn35.137:1.8": "dhammavipariṇāmavirāganirodhā dukkhā bhikkhave devamanussā viharanti. ",
  "sn35.137:1.9": "tathāgato ca kho bhikkhave arahaṃ sammāsambuddho rūpānaṃ samudayañca atthaṅgamañca assādañca ādīnavañca nissaraṇañca yathābhūtaṃ viditvā na rūpārāmo na rūparato na rūpasamudito ",
  "sn35.137:1.10": "rūpavipariṇāmavirāganirodhā sukho bhikkhave tathāgato viharati. ",
  "sn35.137:1.11": "saddānaṃ ",
  "sn35.137:1.12": "gandhānaṃ ",
  "sn35.137:1.13": "rasānaṃ ",
  "sn35.137:1.14": "phoṭṭhabbaṃ ",
  "sn35.137:1.15": "dhammānaṃ samudayañca atthaṅgamañca assādañca ādīnavañca nissaraṇañca yathābhūtaṃ viditvā na dhammārāmo na dhammarato na dhammasamudito ",
  "sn35.137:1.16": "dhammavipariṇāmavirāganirodhā sukho bhikkhave tathāgato viharatīti. ",
  "sn35.137:1.17": "catutthaṃ. "
}
