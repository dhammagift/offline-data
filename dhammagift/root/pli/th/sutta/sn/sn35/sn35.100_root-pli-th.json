  "sn35.100:0.3": "",
  "sn35.100:1.1": "paṭisallīnā bhikkhave yogamāpajjatha. ",
  "sn35.100:1.2": "paṭisallīno bhikkhave bhikkhu yathābhūtaṃ pajānāti. ",
  "sn35.100:1.3": "kiñca yathābhūtaṃ pajānāti. ",
  "sn35.100:1.4": "cakkhuṃ aniccanti yathābhūtaṃ pajānāti ",
  "sn35.100:1.5": "rūpā aniccāti yathābhūtaṃ pajānāti ",
  "sn35.100:1.6": "cakkhuviññāṇaṃ aniccanti yathābhūtaṃ pajānāti ",
  "sn35.100:1.7": "cakkhusamphasso aniccoti yathābhūtaṃ pajānāti …pe… ",
  "sn35.100:1.8": "yampidaṃ manosamphassapaccayā uppajjati vedayitaṃ sukhaṃ vā dukkhaṃ vā adukkhamasukhaṃ vā tampi aniccanti yathābhūtaṃ pajānāti. ",
  "sn35.100:1.9": "paṭisallīnā bhikkhave yogamāpajjatha. ",
  "sn35.100:1.10": "paṭisallīno bhikkhave bhikkhu yathābhūtaṃ pajānātīti. ",
  "sn35.100:1.11": "sattamaṃ. "
}
