  "sn35.113:0.3": "",
  "sn35.113:1.1": "ekaṃ samayaṃ bhagavā ñātike viharati giñjakāvasathe. ",
  "sn35.113:1.2": "atha kho bhagavā rahogato paṭisallīno imaṃ dhammapariyāyaṃ abhāsi ",
  "sn35.113:1.3": "cakkhuñca paṭicca rūpe ca uppajjati cakkhuviññāṇaṃ tiṇṇaṃ saṅgati phasso ",
  "sn35.113:1.4": "phassapaccayā vedanā ",
  "sn35.113:1.5": "vedanāpaccayā taṇhā ",
  "sn35.113:1.6": "taṇhāpaccayā upādānaṃ ",
  "sn35.113:1.7": "upādānapaccayā bhavo ",
  "sn35.113:1.8": "bhavapaccayā jāti ",
  "sn35.113:1.9": "jātipaccayā jarāmaraṇaṃ sokaparidevadukkhadomanassupāyāsā sambhavanti. ",
  "sn35.113:1.10": "evametassa kevalassa dukkhakkhandhassa samudayo hoti …pe… ",
  "sn35.113:1.11": "jivhañca paṭicca rase ca uppajjati …pe… ",
  "sn35.113:1.12": "manañca paṭicca dhamme ca uppajjati manoviññāṇaṃ tiṇṇaṃ saṅgati phasso ",
  "sn35.113:1.13": "phassapaccayā vedanā ",
  "sn35.113:1.14": "vedanāpaccayā taṇhā ",
  "sn35.113:1.15": "taṇhāpaccayā upādānaṃ ",
  "sn35.113:1.16": "upādānapaccayā bhavo ",
  "sn35.113:1.17": "bhavapaccayā jāti ",
  "sn35.113:1.18": "jātipaccayā jarāmaraṇaṃ sokaparidevadukkhadomanassupāyāsā sambhavanti. ",
  "sn35.113:1.19": "evametassa kevalassa dukkhakkhandhassa samudayo hoti. ",
  "sn35.113:2.1": "cakkhuñca paṭicca rūpe ca uppajjati cakkhuviññāṇaṃ tiṇṇaṃ saṅgati phasso ",
  "sn35.113:2.2": "phassapaccayā vedanā ",
  "sn35.113:2.3": "vedanāpaccayā taṇhā ",
  "sn35.113:2.4": "tassā yeva taṇhāya asesavirāganirodhā upādānanirodho ",
  "sn35.113:2.5": "upādānanirodhā bhavanirodho ",
  "sn35.113:2.6": "bhavanirodhā jātinirodho ",
  "sn35.113:2.7": "jātinirodhā jarāmaraṇaṃ sokaparidevadukkhadomanassupāyāsā nirujjhanti. ",
  "sn35.113:2.8": "evametassa kevalassa dukkhakkhandhassa nirodho hoti …pe… ",
  "sn35.113:2.9": "jivhañca paṭicca rase ca uppajjati …pe… ",
  "sn35.113:2.10": "manañca paṭicca dhamme ca uppajjati manoviññāṇaṃ tiṇṇaṃ saṅgati phasso ",
  "sn35.113:2.11": "phassapaccayā vedanā ",
  "sn35.113:2.12": "vedanāpaccayā taṇhā ",
  "sn35.113:2.13": "tassā yeva taṇhāya asesavirāganirodhā upādānanirodho ",
  "sn35.113:2.14": "upādānanirodhā …pe… ",
  "sn35.113:2.15": "evametassa kevalassa dukkhakkhandhassa nirodho hotīti. navamaṃ. ",
  "sn35.113:3.1": "tena kho pana samayena aññataro bhikkhu bhagavato upassuti ṭhito hoti. ",
  "sn35.113:3.2": "addasā kho bhagavā taṃ bhikkhuṃ upassutiṃ ṭhitaṃ ",
  "sn35.113:3.3": "disvāna taṃ bhikkhuṃ etadavoca ",
  "sn35.113:3.4": "assosi tvaṃ bhikkhu imaṃ dhammapariyāyanti. ",
  "sn35.113:3.5": "evaṃ bhante. ",
  "sn35.113:3.6": "uggaṇhāhi tvaṃ bhikkhu imaṃ dhammapariyāyaṃ ",
  "sn35.113:3.7": "pariyāpuṇāhi tvaṃ bhikkhu imaṃ dhammapariyāyaṃ ",
  "sn35.113:3.8": "dhārehi tvaṃ bhikkhu imaṃ dhammapariyāyaṃ ",
  "sn35.113:3.9": "atthasañhitoyaṃ bhikkhu dhammapariyāyo ādibrahmacariyakoti. ",
  "sn35.113:3.10": "dasamaṃ. ",
  "sn35.113:3.11": "yogakkhemivaggo paṭhamo. ",
  "sn35.113:4.0": "tassuddānaṃ ",
  "sn35.113:4.1": "yogakkhemi upādāya ",
  "sn35.113:4.2": "dukkhaloko ca seyyo ca ",
  "sn35.113:4.3": "saññojanaṃ upādānaṃ ",
  "sn35.113:4.4": "dveparijānaṃ upassūtīti. "
}
