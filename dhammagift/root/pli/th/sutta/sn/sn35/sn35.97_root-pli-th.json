  "sn35.97:0.1": "",
  "sn35.97:0.2": "",
  "sn35.97:0.3": "",
  "sn35.97:1.1": "sāvatthīnidānaṃ …pe… pamādavihāriñca vo bhikkhave desissāmi appamādavihāriñca ",
  "sn35.97:1.2": "taṃ suṇātha. ",
  "sn35.97:1.3": "kathañca bhikkhave pamādavihārī hoti. ",
  "sn35.97:1.4": "cakkhundriyaṃ asaṃvutassa bhikkhave viharato cittaṃ byāsiccati cakkhuviññeyyesu rūpesu ",
  "sn35.97:1.5": "tassa byāsittacittassa pāmujjaṃ na hoti ",
  "sn35.97:1.6": "pāmujje asati pīti na hoti ",
  "sn35.97:1.7": "pītiyā asati passaddhi na hoti ",
  "sn35.97:1.8": "passaddhiyā asati dukkhaṃ viharati ",
  "sn35.97:1.9": "dukkhino cittaṃ na samādhiyati ",
  "sn35.97:1.10": "asamāhite citte dhammā na pātubhavanti ",
  "sn35.97:1.11": "dhammānaṃ apātubhāvā pamādavihārītveva saṅkhaṃ gacchati …pe… ",
  "sn35.97:1.12": "jivhindriyaṃ asaṃvutassa bhikkhave viharato cittaṃ byāsiccati jivhāviññeyyesu rasesu ",
  "sn35.97:1.13": "tassa byāsittacittassa …pe… ",
  "sn35.97:1.14": "pamādavihārītveva saṅkhaṃ gacchati …pe… ",
  "sn35.97:1.15": "manindriyaṃ asaṃvutassa bhikkhave viharato cittaṃ byāsiccati manoviññeyyesu dhammesu ",
  "sn35.97:1.16": "tassa byāsittacittassa pāmujjaṃ na hoti ",
  "sn35.97:1.17": "pāmujje asati pīti na hoti ",
  "sn35.97:1.18": "pītiyā asati passaddhi na hoti ",
  "sn35.97:1.19": "passaddhiyā asati dukkhaṃ viharati ",
  "sn35.97:1.20": "dukkhino cittaṃ na samādhiyati ",
  "sn35.97:1.21": "asamāhite citte dhammā na pātubhavanti ",
  "sn35.97:1.22": "dhammānaṃ apātubhāvā pamādavihārītveva saṅkhaṃ gacchati. ",
  "sn35.97:1.23": "evaṃ kho bhikkhave pamādavihārī hoti. ",
  "sn35.97:2.1": "kathañca bhikkhave appamādavihārī hoti. ",
  "sn35.97:2.2": "cakkhundriyaṃ saṃvutassa bhikkhave viharato cittaṃ na byāsiccati cakkhuviññeyyesu rūpesu ",
  "sn35.97:2.3": "tassa abyāsittacittassa pāmujjaṃ jāyati ",
  "sn35.97:2.4": "pamuditassa pīti jāyati ",
  "sn35.97:2.5": "pītimanassa kāyo passambhati ",
  "sn35.97:2.6": "passaddhakāyo sukhaṃ viharati ",
  "sn35.97:2.7": "sukhino cittaṃ samādhiyati ",
  "sn35.97:2.8": "samāhate citte dhammā pātubhavanti ",
  "sn35.97:2.9": "dhammānaṃ pātubhāvā appamādavihārītveva saṅkhaṃ gacchati …pe… ",
  "sn35.97:2.10": "jivhindriyaṃ saṃvutassa bhikkhave viharato cittaṃ na byāsiccati …pe… ",
  "sn35.97:2.11": "appamādavihārītveva saṅkhaṃ gacchati …pe… ",
  "sn35.97:2.12": "manindriyaṃ saṃvutassa bhikkhave viharato cittaṃ na byāsiccati manoviññeyyesu dhammesu ",
  "sn35.97:2.13": "tassa abyāsittacittassa pāmujjaṃ jāyati ",
  "sn35.97:2.14": "pamuditassa pīti jāyati ",
  "sn35.97:2.15": "pītimanassa kāyo passambhati ",
  "sn35.97:2.16": "passaddhakāyo sukhaṃ vedayati ",
  "sn35.97:2.17": "sukhino cittaṃ samādhiyati ",
  "sn35.97:2.18": "samāhite citte dhammā pātubhavanti ",
  "sn35.97:2.19": "dhammānaṃ pātubhāvā appamādavihārītveva saṅkhaṃ gacchati. ",
  "sn35.97:2.20": "evaṃ kho bhikkhave appamādavihārī hotīti. ",
  "sn35.97:2.21": "catutthaṃ. "
}
