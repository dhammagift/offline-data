  "sn35.92:0.1": "",
  "sn35.92:0.2": "",
  "sn35.92:0.3": "",
  "sn35.92:1.1": "dvayaṃ vo bhikkhave desissāmi. ",
  "sn35.92:1.2": "taṃ suṇātha. ",
  "sn35.92:1.3": "kiñca bhikkhave dvayaṃ ",
  "sn35.92:1.4": "cakkhuñceva rūpā ca sotañca saddā ca ghānañca gandhā ca jivhā ca rasā ca kāyo ca phoṭṭhabbā ca mano ca dhammā ca ",
  "sn35.92:1.5": "idaṃ vuccati bhikkhave dvayaṃ. ",
  "sn35.92:2.1": "yo bhikkhave evaṃ vadeyya ",
  "sn35.92:2.2": "ahametaṃ dvayaṃ paccakkhāya aññaṃ dvayaṃ paññapessāmīti. tassa vācā vatthu devassa ",
  "sn35.92:2.3": "puṭṭho ca na sampāyeyya ",
  "sn35.92:2.4": "uttariṃ ca vighātaṃ āpajjeyya. ",
  "sn35.92:2.5": "taṃ kissa hetu. ",
  "sn35.92:2.6": "yathā taṃ bhikkhave avisayasminti. ",
  "sn35.92:2.7": "navamaṃ. "
}
