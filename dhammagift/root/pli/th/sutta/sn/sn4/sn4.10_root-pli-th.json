{
  "sn4.10:0.1": "",
  "sn4.10:0.2": "",
  "sn4.10:0.3": "dasamaṃ dutiyaāyusuttaṃ ",
  "sn4.10:1.1": "",
  "sn4.10:1.2": "ekaṃ samayaṃ bhagavā rājagahe …pe… ",
  "sn4.10:1.3": "tatra kho bhagavā etadavoca ",
  "sn4.10:2.1": "appamidaṃ bhikkhave manussānaṃ āyu ",
  "sn4.10:2.2": "gamanīyo samparāyo kattabbaṃ kusalaṃ caritabbaṃ brahmacariyaṃ ",
  "sn4.10:2.3": "natthi jātassa amaraṇaṃ ",
  "sn4.10:2.4": "yo bhikkhave ciraṃ jīvati so vassasataṃ appaṃ vā bhiyyoti. ",
  "sn4.10:3.1": "atha kho māro pāpimā yena bhagavā tenupasaṅkami upasaṅkamitvā bhagavantaṃ gāthāya ajjhabhāsi ",
  "sn4.10:4.1": "nāccayanti ahorattā ",
  "sn4.10:4.2": "jīvitaṃ nūparujjhati ",
  "sn4.10:4.3": "āyuṃ anucariyati maccānaṃ ",
  "sn4.10:4.4": "nemiva rathakubbaranti. ",
  "sn4.10:5.1": "accayanti ahorattā ",
  "sn4.10:5.2": "jīvitaṃ uparujjhati ",
  "sn4.10:5.3": "āyu khīyati maccānaṃ ",
  "sn4.10:5.4": "kunnadīnaṃva odakanti. ",
  "sn4.10:6.1": "atha kho māro pāpimā jānāti maṃ bhagavā jānāti maṃ sugatoti dukkhī dummano tatthevantaradhāyīti. ",
  "sn4.10:6.2": "paṭhamo vaggo. ",
  "sn4.10:7.0": "tassuddānaṃ ",
  "sn4.10:7.1": "tapokammañca nāgo ca ",
  "sn4.10:7.2": "subhaṃ pāsena te duve ",
  "sn4.10:7.3": "sappo suppati nandanaṃ ",
  "sn4.10:7.4": "āyunā apare duveti. "
}
