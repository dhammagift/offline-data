  "sn18.6:1.1": "sāvatthiyaṃ viharati … ",
  "sn18.6:1.2": "taṃ kiṃ maññasi rāhula ",
  "sn18.6:1.3": "rūpasaññā niccā vā aniccā vāti. ",
  "sn18.6:1.4": "aniccā bhante … ",
  "sn18.6:1.5": "saddasaññā … gandha ",
  "sn18.6:1.6": "saññā … ",
  "sn18.6:1.7": "rasasaññā … ",
  "sn18.6:1.8": "phoṭṭhabbasaññā … ",
  "sn18.6:1.9": "dhammasaññā niccā vā aniccā vāti. ",
  "sn18.6:1.10": "aniccā bhante …. ",
  "sn18.6:1.11": "evaṃ passaṃ rāhula sutavā ariyasāvako rūpasaññāyapi nibbindati saddasaññāyapi nibbindati gandhasaññāyapi nibbindati rasasaññāyapi nibbindati phoṭṭhabbasaññāyapi nibbindati dhamma saññāyapi nibbindati …pe… ",
  "sn18.6:1.12": "pajānātīti. ",
  "sn18.6:1.13": "chaṭṭhaṃ. "
}
