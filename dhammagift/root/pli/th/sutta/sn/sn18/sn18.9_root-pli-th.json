  "sn18.9:1.1": "sāvatthiyaṃ viharati … ",
  "sn18.9:1.2": "taṃ kiṃ maññasi rāhula ",
  "sn18.9:1.3": "paṭhavīdhātu niccā vā aniccā vāti. ",
  "sn18.9:1.4": "aniccā bhante … ",
  "sn18.9:1.5": "āpodhātu … ",
  "sn18.9:1.6": "tejodhātu … ",
  "sn18.9:1.7": "vāyodhātu … ",
  "sn18.9:1.8": "ākāsadhātu … ",
  "sn18.9:1.9": "viññāṇadhātu niccā vā aniccā vāti. ",
  "sn18.9:1.10": "aniccā bhante …. ",
  "sn18.9:1.11": "evaṃ passaṃ rāhula sutavā ariyasāvako paṭhavīdhātuyāpi nibbindati āpodhātuyāpi nibbindati tejodhātuyāpi nibbindata vāyo dhātuyāpi nibbindati ākāsadhātuyāpi nibbindati viññāṇadhātuyāpi nibbindati …pe… ",
  "sn18.9:1.12": "pajānātīti. ",
  "sn18.9:1.13": "navamaṃ. "
}
