  "sn18.2:0.3": "[etena peyyālena dasa suttantā kātabbā] ",
  "sn18.2:1.1": "sāvatthiyaṃ viharati … ",
  "sn18.2:1.2": "taṃ kiṃ maññasi rāhula ",
  "sn18.2:1.3": "rūpā niccā vā aniccā vāti. ",
  "sn18.2:1.4": "aniccā bhante … ",
  "sn18.2:1.5": "saddā …pe… ",
  "sn18.2:1.6": "gandhā … ",
  "sn18.2:1.7": "rasā … ",
  "sn18.2:1.8": "phoṭṭhabbā … ",
  "sn18.2:1.9": "dhammā niccā vā aniccā vāti. ",
  "sn18.2:1.10": "aniccā bhante …. ",
  "sn18.2:1.11": "evaṃ passaṃ rāhula sutavā ariyasāvako rūpesupi nib bindati saddesupi nibbindati gandhesupi nibbindati rasesupi nibbindati phoṭṭhabbesupi nibbindati dhammesupi nibbindati ",
  "sn18.2:1.12": "nibbindaṃ virajjati …pe… ",
  "sn18.2:1.13": "pajānātīti. ",
  "sn18.2:1.14": "dutiyaṃ. "
}
