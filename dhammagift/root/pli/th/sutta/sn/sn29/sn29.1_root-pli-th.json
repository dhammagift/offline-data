{
  "sn29.1:0.1": "nāgasaṃyuttaṃ ",
  "sn29.1:0.2": "",
  "sn29.1:0.3": "",
  "sn29.1:1.1": "sāvatthī. tatra kho. ",
  "sn29.1:1.2": "catasso imā bhikkhave nāgayoniyo. ",
  "sn29.1:1.3": "katamā catasso. ",
  "sn29.1:1.4": "aṇḍajā nāgā jalābujā nāgā saṃsedajā nāgā upapātikā nāgā. ",
  "sn29.1:1.5": "imā kho bhikkhave catasso nāgayoniyoti. ",
  "sn29.1:1.6": ""
}
