{
  "sn15.10:0.1": "",
  "sn15.10:0.2": "",
  "sn15.10:0.3": "",
  "sn15.10:1.1": "ekaṃ samayaṃ bhagavā rājagahe viharati gijjha kūte pabbate. ",
  "sn15.10:1.2": "tatra kho bhagavā bhikkhū āmantesi ",
  "sn15.10:1.3": "bhikkhavoti. ",
  "sn15.10:1.4": "bhadanteti te bhikkhū bhagavato paccassosuṃ. ",
  "sn15.10:1.5": "bhagavā etadavoca ",
  "sn15.10:2.1": "anamataggoyaṃ bhikkhave saṃsāro …pe… ",
  "sn15.10:2.2": "ekassa puggalassa bhikkhave kappaṃ sandhāvato saṃsarato siyā evaṃ mahā aṭṭhikaṅkalo aṭṭhipuñjo aṭṭhirāsi yathāyaṃ vepullo pabbato sace saṃhārako assa sambhatañca na vinasseyya ",
  "sn15.10:2.3": "taṃ kissa hetu ",
  "sn15.10:2.4": "anamataggoyaṃ bhikkhave saṃsāro …pe… ",
  "sn15.10:2.5": "alaṃ vimuccitunti. ",
  "sn15.10:3.1": "idamavoca bhagavā ",
  "sn15.10:3.2": "idaṃ vatvāna sugato athāparaṃ eta davoca satthā ",
  "sn15.10:4.1": "ekassekena kappena ",
  "sn15.10:4.2": "puggalassaṭṭhisañcayo ",
  "sn15.10:4.3": "siyā pabbatasamo rāsi ",
  "sn15.10:4.4": "iti vuttaṃ mahesinā ",
  "sn15.10:5.1": "so kho panāyaṃ akkhāto ",
  "sn15.10:5.2": "vepullo pabbato mahā ",
  "sn15.10:5.3": "uttaro gijjhakūṭassa ",
  "sn15.10:5.4": "magadhānaṃ giribbaje ",
  "sn15.10:6.1": "yato ca ariyasaccāni ",
  "sn15.10:6.2": "sammappaññāya passati ",
  "sn15.10:6.3": "dukkhaṃ dukkhasamuppādaṃ ",
  "sn15.10:6.4": "dukkhassa ca atikkamaṃ ",
  "sn15.10:6.5": "ariyañcaṭṭhaṅgikaṃ maggaṃ ",
  "sn15.10:6.6": "dukkhūpasamagāminaṃ ",
  "sn15.10:7.1": "sattakkhattuparamaṃ ",
  "sn15.10:7.2": "sandhāvitvāna puggalo ",
  "sn15.10:7.3": "dukkhassantakaro hoti ",
  "sn15.10:7.4": "sabbasaññojanakkhayāti. ",
  "sn15.10:7.5": "dasamaṃ. paṭhamavaggo ",
  "sn15.10:7.6": "paṭhamo. tassa ",
  "sn15.10:8.0": "uddānaṃ ",
  "sn15.10:8.1": "tiṇakaṭṭhañca paṭhavī ",
  "sn15.10:8.2": "assu khīrañca pabbataṃ ",
  "sn15.10:8.3": "sāsapā sāvako gaṅgā ",
  "sn15.10:8.4": "daṇḍo ca puggalena cāti. "
}
