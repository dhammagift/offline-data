{
  "sn15.15:0.1": "[sabbesaṃ evaṃ peyyālo] ",
  "sn15.15:0.2": "",
  "sn15.15:0.3": "",
  "sn15.15:1.1": "sāvatthiyaṃ viharati … tatra kho bhagavā … ",
  "sn15.15:1.2": "anamataggoyaṃ bhikkhave saṃsāro …pe… ",
  "sn15.15:1.3": "na so bhikkhave satto sulabharūpo yo na pitā bhūtapubbo …pe… ",
  "sn15.15:1.4": "",
  "sn15.15:1.5": "pañcamaṃ. "
}
