  "sn15.14:0.3": "",
  "sn15.14:1.1": "sāvatthiyaṃ viharati … tatra kho bhagavā … ",
  "sn15.14:1.2": "anamataggoyaṃ bhikkhave saṃsāro …pe… ",
  "sn15.14:1.3": "na so bhikkhave satto sulabharūpo yo na mātā bhūtapubbo iminā dīghena addhunā ",
  "sn15.14:1.4": "taṃ kissa hetu ",
  "sn15.14:1.5": "ana mataggoyaṃ bhikkhave saṃsāro …pe… ",
  "sn15.14:1.6": "alaṃ vimuccitunti. ",
  "sn15.14:1.7": "catutthaṃ. "
}
