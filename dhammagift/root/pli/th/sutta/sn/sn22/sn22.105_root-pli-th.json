  "sn22.105:0.3": "",
  "sn22.105:1.1": "sāvatthī. ",
  "sn22.105:1.2": "sakkāyañca vo bhikkhave desissāmi sakkāyasamudayañca sakkāyanirodhañca sakkāyanirodhagāminīpaṭipadañca ",
  "sn22.105:1.3": "taṃ suṇātha. ",
  "sn22.105:1.4": "katamo ca bhikkhave sakkāyo. ",
  "sn22.105:1.5": "pañcupādānakkhandhātissa vacanīyaṃ. ",
  "sn22.105:1.6": "katame pañca. ",
  "sn22.105:1.7": "seyyathīdaṃ. rūpūpādānakkhandho …pe… viññāṇūpādānakkhandho. ",
  "sn22.105:1.8": "ayaṃ vuccati bhikkhave sakkāyo. ",
  "sn22.105:1.9": "katamo ca bhikkhave sakkāyasamudayo. ",
  "sn22.105:1.10": "yāyaṃ taṇhā ponobbhavikā nandirāgasahagatā tatratatrābhinandinī. seyyathīdaṃ. kāmataṇhā bhavataṇhā vibhavataṇhā. ",
  "sn22.105:1.11": "ayaṃ vuccati bhikkhave sakkāyasamudayo. ",
  "sn22.105:1.12": "katamo ca bhikkhave sakkāyanirodho. ",
  "sn22.105:1.13": "yo tassā yeva taṇhāya asesavirāganirodho cāgo paṭinissaggo mutti anālayo. ",
  "sn22.105:1.14": "ayaṃ vuccati bhikkhave sakkāyanirodho. ",
  "sn22.105:1.15": "katamā ca bhikkhave sakkāyanirodhagāminīpaṭipadā. ",
  "sn22.105:1.16": "ayameva ariyo aṭṭhaṅgiko maggo. ",
  "sn22.105:1.17": "seyyathīdaṃ. sammādiṭṭhi sammāsaṅkappo …pe… sammāsamādhi. ",
  "sn22.105:1.18": "ayaṃ vuccati bhikkhave sakkāyanirodhagāminīpaṭipadāti. ",
  "sn22.105:1.19": ""
}
