  "sn22.76:0.1": "",
  "sn22.76:0.2": "",
  "sn22.76:0.3": "",
  "sn22.76:1.1": "sāvatthī. tatra kho. ",
  "sn22.76:1.2": "rūpaṃ bhikkhave aniccaṃ ",
  "sn22.76:1.3": "yadaniccaṃ taṃ dukkhaṃ ",
  "sn22.76:1.4": "yaṃ dukkhaṃ tadanattā ",
  "sn22.76:1.5": "yadanattā taṃ netaṃ mama nesohamasmi na meso attāti evametaṃ yathābhūtaṃ sammappaññāya daṭṭhabbaṃ. ",
  "sn22.76:1.6": "vedanā. ",
  "sn22.76:1.7": "saññā. ",
  "sn22.76:1.8": "saṅkhārā. ",
  "sn22.76:1.9": "viññāṇaṃ aniccaṃ ",
  "sn22.76:1.10": "yadaniccaṃ taṃ dukkhaṃ ",
  "sn22.76:1.11": "yaṃ dukkhaṃ tadanattā ",
  "sn22.76:1.12": "yadanattā taṃ netaṃ mama nesohamasmi na meso attāti evametaṃ yathābhūtaṃ sammappaññāya daṭṭhabbaṃ. ",
  "sn22.76:2.1": "evaṃ passaṃ bhikkhave sutavā ariyasāvako rūpasmiṃpi nibbindati vedanāyapi. saññāyapi. saṅkhāresupi. viññāṇasmiṃpi nibbindati ",
  "sn22.76:2.2": "nibbindaṃ virajjati virāgā vimuccati. vimuttasmiṃ vimuttamiti ñāṇaṃ hoti. ",
  "sn22.76:2.3": "khīṇā jāti vusitaṃ brahmacariyaṃ kataṃ karaṇīyaṃ nāparaṃ itthattāyāti pajānāti. ",
  "sn22.76:2.4": "yāvatā bhikkhave sattāvāsā yāvatā bhavaggaṃ ete aggā ete seṭṭhā lokasmiṃ yadidaṃ arahantoti. ",
  "sn22.76:3.1": "idamavoca bhagavā ",
  "sn22.76:3.2": "idaṃ vatvāna sugato athāparaṃ etadavoca satthā ",
  "sn22.76:4.1": "sukhino vata arahanto ",
  "sn22.76:4.2": "taṇhā tesaṃ na vijjati ",
  "sn22.76:4.3": "asmimāno samucchinno ",
  "sn22.76:4.4": "mohajālaṃ padālitaṃ. ",
  "sn22.76:5.1": "anejante anuppattā ",
  "sn22.76:5.2": "cittaṃ tesaṃ anāvilaṃ ",
  "sn22.76:5.3": "loke anupalittā te ",
  "sn22.76:5.4": "brahmabhūtā anāsavā. ",
  "sn22.76:6.1": "pañcakkhandhe pariññāya ",
  "sn22.76:6.2": "sattasaddhammagocarā ",
  "sn22.76:6.3": "pasaṃsiyā sappurisā ",
  "sn22.76:6.4": "puttā buddhassa orasā. ",
  "sn22.76:7.1": "sattaratanasampannā ",
  "sn22.76:7.2": "tīsu sikkhāsu sikkhitā ",
  "sn22.76:7.3": "anuvicaranti mahāvīrā ",
  "sn22.76:7.4": "pahīnabhayabheravā. ",
  "sn22.76:8.1": "dasahaṅgehi sampannā ",
  "sn22.76:8.2": "mahānāgā samāhitā ",
  "sn22.76:8.3": "ete kho seṭṭhā lokasmiṃ ",
  "sn22.76:8.4": "taṇhā tesaṃ na vijjati. ",
  "sn22.76:9.1": "asekkhañāṇaṃ uppannaṃ ",
  "sn22.76:9.2": "antimoyaṃ samussayo ",
  "sn22.76:9.3": "yo sāro brahmacariyassa ",
  "sn22.76:9.4": "tasmiṃ aparapaccayā. ",
  "sn22.76:10.1": "vidhāsu na vikampanti ",
  "sn22.76:10.2": "vippamuttā punabbhavā ",
  "sn22.76:10.3": "dantabhūmiṃ anuppattā ",
  "sn22.76:10.4": "te loke vijitāvino. ",
  "sn22.76:11.1": "uddhaṃ tiriyaṃ apācinaṃ ",
  "sn22.76:11.2": "nandi tesaṃ na vijjati ",
  "sn22.76:11.3": "nadanti te sīhanādaṃ ",
  "sn22.76:11.4": "buddhā loke anuttarāti. ",
  "sn22.76:11.5": ""
}
