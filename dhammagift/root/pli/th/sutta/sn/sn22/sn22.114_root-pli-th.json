  "sn22.114:0.3": "",
  "sn22.114:1.1": "sāvatthī. ",
  "sn22.114:1.2": "ekamantaṃ nisinno kho so bhikkhu bhagavantaṃ etadavoca ",
  "sn22.114:1.3": "vijjā vijjāti bhante vuccati ",
  "sn22.114:1.4": "katamā nu kho bhante vijjā ",
  "sn22.114:1.5": "kittāvatā ca vijjāgato hotīti. ",
  "sn22.114:1.6": "idha bhikkhu sutavā ariyasāvako rūpaṃ pajānāti rūpasamudayaṃ …pe… rūpanirodhagāminīpaṭipadaṃ pajānāti ",
  "sn22.114:1.7": "vedanaṃ. ",
  "sn22.114:1.8": "saññaṃ. ",
  "sn22.114:1.9": "saṅkhāre pajānāti …pe… ",
  "sn22.114:1.10": "viññāṇanirodhagāminīpaṭipadaṃ pajānāti. ",
  "sn22.114:1.11": "ayaṃ vuccati bhikkhu vijjā ",
  "sn22.114:1.12": "ettāvatā ca vijjāgato hotīti. ",
  "sn22.114:1.13": ""
}
