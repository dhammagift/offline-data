{
  "sn22.113:0.1": "khandhasaṃyuttassa cullapaṇṇāsake dhammakathikavaggo dutiyo ",
  "sn22.113:0.2": "",
  "sn22.113:0.3": "",
  "sn22.113:1.1": "sāvatthī. ",
  "sn22.113:1.2": "atha kho aññataro bhikkhu yena bhagavā tenupasaṅkami …pe… ",
  "sn22.113:1.3": "nisinno kho so bhikkhu bhagavantaṃ etadavoca ",
  "sn22.113:1.4": "avijjā avijjāti bhante vuccati ",
  "sn22.113:1.5": "katamā nu kho bhante avijjā ",
  "sn22.113:1.6": "kittāvatā ca avijjāgato hotīti. ",
  "sn22.113:1.7": "idha bhikkhu assutavā puthujjano rūpaṃ nappajānāti rūpasamudayaṃ nappajānāti rūpanirodhaṃ nappajānāti rūpanirodhagāminīpaṭipadaṃ nappajānāti ",
  "sn22.113:1.8": "vedanaṃ nappajānāti. ",
  "sn22.113:1.9": "saññaṃ nappajānāti. ",
  "sn22.113:1.10": "saṅkhāre nappajānāti. viññāṇaṃ nappajānāti …pe… ",
  "sn22.113:1.11": "viññāṇanirodhagāminīpaṭipadaṃ nappajānāti. ",
  "sn22.113:1.12": "ayaṃ vuccati bhikkhu avijjā ",
  "sn22.113:1.13": "ettāvatā ca avijjāgato hotīti. ",
  "sn22.113:1.14": ""
}
