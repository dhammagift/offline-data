  "sn22.149:0.3": "",
  "sn22.149:1.1": "sāvatthī. ",
  "sn22.149:1.2": "saddhāpabbajitassa bhikkhave kulaputtassa ayamanudhammo hoti ",
  "sn22.149:1.3": "yaṃ rūpe anattānupassī vihareyya ",
  "sn22.149:1.4": "vedanāya. ",
  "sn22.149:1.5": "saññāya. ",
  "sn22.149:1.6": "saṅkhāresu. ",
  "sn22.149:1.7": "viññāṇe anattānupassī vihareyya. so rūpe ",
  "sn22.149:1.8": "anattānupassī viharanto vedanāya. ",
  "sn22.149:1.9": "saññāya. ",
  "sn22.149:1.10": "saṅkhāresu. ",
  "sn22.149:1.11": "viññāṇe anattānupassī viharanto rūpaṃ parijānāti vedanaṃ. ",
  "sn22.149:1.12": "saññaṃ. ",
  "sn22.149:1.13": "saṅkhāre. ",
  "sn22.149:1.14": "viññāṇaṃ parijānāti ",
  "sn22.149:1.15": "so rūpaṃ parijānaṃ vedanaṃ. saññaṃ. saṅkhāre. viññāṇaṃ parijānaṃ parimuccati rūpamhā parimuccati vedanāya parimuccati saññāya parimuccati saṅkhārehi parimuccati viññāṇamhā parimuccati jātiyā jarāya maraṇena sokehi paridevehi dukkhehi domanassehi upāyāsehi ",
  "sn22.149:1.16": "parimuccati dukkhasmāti vadāmīti. ",
  "sn22.149:1.17": "",
  "sn22.149:1.18": "",
  "sn22.149:2.0": "kukkuḷavaggo catuttho tassuddānaṃ ",
  "sn22.149:2.1": "kukkuḷā tayo aniccena ",
  "sn22.149:2.2": "dukkhena apare tayo ",
  "sn22.149:2.3": "anattena tayo vuttā ",
  "sn22.149:2.4": "kulaputtena dve dukkhāti. "
}
