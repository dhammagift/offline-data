{
  "sn22.22:0.1": "khandhasaṃyuttassa mūlapaṇṇāsake bhāravaggo tatiyo ",
  "sn22.22:0.2": "",
  "sn22.22:0.3": "",
  "sn22.22:1.1": "sāvatthiyaṃ. tatra kho. ",
  "sn22.22:1.2": "bhārañca vo bhikkhave desissāmi bhārahārañca bhāranikkhepanañca taṃ suṇātha …pe… etadavoca katamo ca bhikkhave bhāro. pañcupādānakkhandhātissa vacanīyaṃ. bhārādānañca ayaṃ ",
  "sn22.22:1.3": "",
  "sn22.22:1.4": "",
  "sn22.22:1.5": "",
  "sn22.22:1.6": "katame pañca. ",
  "sn22.22:1.7": "rūpūpādānakkhandho vedanūpādānakkhandho saññūpādānakkhandho saṅkhārūpādānakkhandho viññāṇūpādānakkhandho. ",
  "sn22.22:1.8": "ayaṃ vuccati bhikkhave bhāro. ",
  "sn22.22:2.1": "katamo ca bhikkhave bhārahāro. ",
  "sn22.22:2.2": "puggalotissa vacanīyaṃ. ",
  "sn22.22:2.3": "svāyaṃ āyasmā evaṃnāmo evaṃgotto. ",
  "sn22.22:2.4": "ayaṃ vuccati bhikkhave bhārahāro. ",
  "sn22.22:3.1": "katamañca bhikkhave bhārādānaṃ. ",
  "sn22.22:3.2": "yāyaṃ taṇhā ponobbhavikā nandirāgasahagatā tatratatrābhinandinī. seyyathīdaṃ. ",
  "sn22.22:3.3": "kāmataṇhā bhavataṇhā vibhavataṇhā. ",
  "sn22.22:3.4": "idaṃ vuccati bhikkhave bhārādānaṃ. ",
  "sn22.22:4.1": "katamañca bhikkhave bhāranikkhepanaṃ. ",
  "sn22.22:4.2": "yo tassā yeva taṇhāya asesavirāganirodho cāgo paṭinissaggo mutti anālayo. ",
  "sn22.22:4.3": "idaṃ vuccati bhikkhave bhāranikkhepananti. ",
  "sn22.22:5.1": "idamavoca bhagavā ",
  "sn22.22:5.2": "idaṃ vatvāna sugato athāparaṃ etadavoca satthā ",
  "sn22.22:6.1": "bhārā have pañcakkhandhā ",
  "sn22.22:6.2": "bhārahāro ca puggalo ",
  "sn22.22:6.3": "bhārādānaṃ dukkhaṃ loke ",
  "sn22.22:6.4": "bhāranikkhepanaṃ sukhaṃ ",
  "sn22.22:7.1": "nikkhipitvā garuṃ bhāraṃ ",
  "sn22.22:7.2": "aññaṃ bhāraṃ anādiya ",
  "sn22.22:7.3": "samūlaṃ taṇhaṃ abbuyha ",
  "sn22.22:7.4": "nicchāto parinibbutoti. ",
  "sn22.22:7.5": ""
}
