{
  "sn22.31:0.1": "",
  "sn22.31:0.2": "",
  "sn22.31:0.3": "",
  "sn22.31:1.1": "sāvatthiyaṃ. tatra kho. ",
  "sn22.31:1.2": "aghañca vo bhikkhave desessāmi aghamūlañca ",
  "sn22.31:1.3": "taṃ suṇātha. ",
  "sn22.31:1.4": "katamañca bhikkhave aghaṃ. ",
  "sn22.31:1.5": "rūpaṃ bhikkhave aghaṃ vedanā aghaṃ saññā aghaṃ saṅkhārā aghaṃ viññāṇaṃ aghaṃ. ",
  "sn22.31:1.6": "idaṃ vuccati bhikkhave aghaṃ. ",
  "sn22.31:1.7": "katamañca bhikkhave aghamūlaṃ. ",
  "sn22.31:1.8": "yāyaṃ taṇhā ponobbhavikā nandirāgasahagatā tatratatrābhinandinī. ",
  "sn22.31:1.9": "seyyathīdaṃ. kāmataṇhā bhavataṇhā vibhavataṇhā. ",
  "sn22.31:1.10": "idaṃ vuccati bhikkhave aghamūlanti. ",
  "sn22.31:1.11": ""
}
