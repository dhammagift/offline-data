  "sn22.104:0.3": "",
  "sn22.104:1.1": "sāvatthī. ",
  "sn22.104:1.2": "dukkhañca vo bhikkhave desissāmi dukkhasamudayañca dukkhanirodhañca dukkhanirodhagāminīpaṭipadañca ",
  "sn22.104:1.3": "taṃ suṇātha. ",
  "sn22.104:1.4": "katamañca bhikkhave dukkhaṃ. ",
  "sn22.104:1.5": "pañcupādānakkhandhātissa vacanīyaṃ. ",
  "sn22.104:1.6": "katame pañca. ",
  "sn22.104:1.7": "seyyathīdaṃ. rūpūpādānakkhandho …pe… viññāṇūpādānakkhandho. ",
  "sn22.104:1.8": "idaṃ vuccati bhikkhave dukkhaṃ. ",
  "sn22.104:1.9": "katamo ca bhikkhave dukkhasamudayo. ",
  "sn22.104:1.10": "yāyaṃ taṇhā ponobbhavikā nandirāgasahagatā tatratatrābhinandinī. seyyathīdaṃ. kāmataṇhā bhavataṇhā vibhavataṇhā. ",
  "sn22.104:1.11": "ayaṃ vuccati bhikkhave dukkhasamudayo. ",
  "sn22.104:1.12": "katamo ca bhikkhave dukkhanirodho. ",
  "sn22.104:1.13": "yo tassā yeva taṇhāya asesavirāganirodho cāgo paṭinissaggo mutti anālayo. ",
  "sn22.104:1.14": "ayaṃ vuccati bhikkhave dukkhanirodho. ",
  "sn22.104:1.15": "katamā ca bhikkhave dukkhanirodhagāminīpaṭipadā. ",
  "sn22.104:1.16": "ayameva ariyo aṭṭhaṅgiko maggo. ",
  "sn22.104:1.17": "seyyathīdaṃ. sammādiṭṭhi …pe… sammāsamādhi. ",
  "sn22.104:1.18": "ayaṃ vuccati bhikkhave dukkhanirodhagāminīpaṭipadāti. ",
  "sn22.104:1.19": ""
}
