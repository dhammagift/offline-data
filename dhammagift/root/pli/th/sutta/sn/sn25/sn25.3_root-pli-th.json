  "sn25.3:1.1": "sāvatthī. ",
  "sn25.3:1.2": "cakkhuviññāṇaṃ bhikkhave aniccaṃ vipariṇāmi aññathābhāvi ",
  "sn25.3:1.3": "sotaviññāṇaṃ …pe… ",
  "sn25.3:1.4": "ghānaviññāṇaṃ. ",
  "sn25.3:1.5": "jivhāviññāṇaṃ. ",
  "sn25.3:1.6": "kāyaviññāṇaṃ. ",
  "sn25.3:1.7": "manoviññāṇaṃ aniccaṃ vipariṇāmi aññathābhāvi. ",
  "sn25.3:1.8": "yo bhikkhave …pe… sacchikaroti. yassa kho bhikkhave …pe… sacchikaroti. yo bhikkhave …pe… ",
  "sn25.3:1.9": "sambodhiparāyanoti. ",
  "sn25.3:1.10": ""
}
