  "sn27.4:1.1": "",
  "sn27.4:1.2": "yo bhikkhave cakkhusamphassasmiṃ chandarāgo cittasseso upakkileso ",
  "sn27.4:1.3": "yo sotasamphassasmiṃ. ",
  "sn27.4:1.4": "yo ghānasamphassasmiṃ. ",
  "sn27.4:1.5": "yo jivhāsamphassasmiṃ. ",
  "sn27.4:1.6": "yo kāyasamphassasmiṃ. ",
  "sn27.4:1.7": "yo manosamphassasmiṃ chandarāgo cittasseso upakkileso. ",
  "sn27.4:1.8": "yato kho bhikkhave bhikkhuno …pe… ",
  "sn27.4:1.9": "abhiññā sacchikaraṇīyesu dhammesūti. ",
