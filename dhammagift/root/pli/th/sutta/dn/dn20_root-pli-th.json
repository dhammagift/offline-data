  "dn20:9.19": "modamānā abhikkāmuṃ ",
  "dn20:9.20": "bhikkhūnaṃ samitiṃ vanaṃ. ",
  "dn20:9.21": "pacchimañca disaṃ rājā ",
  "dn20:9.22": "virūpakkho pasāsati ",
  "dn20:9.23": "nāgānaṃ ādhipati ",
  "dn20:9.24": "mahārājā yasassi so. ",
  "dn20:9.25": "puttāpi tassa bahavo ",
  "dn20:9.26": "indanāmā mahabbalā ",
  "dn20:9.27": "iddhimanto jutimanto ",
  "dn20:9.28": "vaṇṇavanto yasassino ",
  "dn20:9.29": "modamānā abhikkāmuṃ ",
  "dn20:9.30": "bhikkhūnaṃ samitiṃ vanaṃ. ",
  "dn20:9.31": "uttarañca disaṃ rājā ",
  "dn20:9.32": "kuvero tappasāsati yakkhānaṃ ",
  "dn20:9.33": "ādhipati ",
  "dn20:9.34": "mahārājā yasassi so. ",
  "dn20:9.35": "puttāpi tassa bahavo ",
  "dn20:9.36": "indanāmā bahabbalā ",
  "dn20:9.37": "iddhimanto jutimanto ",
  "dn20:9.38": "vaṇṇavanto yasassino ",
  "dn20:9.39": "modanānā abhikkāmuṃ ",
  "dn20:9.40": "bhikkhūnaṃ samitiṃ vanaṃ. ",
  "dn20:9.41": "purimadisaṃ dhataraṭṭho ",
  "dn20:9.42": "dakkhiṇena virūḷhako ",
  "dn20:9.43": "pacchimena virūpakkho ",
  "dn20:9.44": "kuvero uttaraṃ disaṃ ",
  "dn20:9.45": "cattāro te mahārājā ",
  "dn20:9.46": "samantā caturo disā ",
  "dn20:9.47": "daddallamānā aṭṭhaṃsu ",
  "dn20:9.48": "vane kāpilavatthave. ",
  "dn20:10.1": "tesaṃ māyāvino dāsā ",
  "dn20:10.2": "āgū vañcanikā saṭhā ",
  "dn20:10.3": "māyā kuṭeṇḍu veṭeṇḍu viṭū ",
  "dn20:10.4": "ca viṭuṭo saha ",
  "dn20:10.5": "candano kāmaseṭṭho ca ",
  "dn20:10.6": "kinnughaṇḍu nighaṇḍu ca. ",
  "dn20:10.7": "panādo opamañño ca ",
  "dn20:10.8": "devasūto ca mātali ",
  "dn20:10.9": "cittaseno ca gandhabbo ",
  "dn20:10.10": "naḷorājā janosabho ",
  "dn20:10.11": "āgū pañcasikho ceva ",
  "dn20:10.12": "timbarū suriyavacchasā. ",
  "dn20:10.13": "ete caññe ca rājāno ",
  "dn20:10.14": "gandhabbā saha rājubhi ",
  "dn20:10.15": "modamānā abhikkāmuṃ ",
  "dn20:10.16": "bhikkhūnaṃ samitiṃ vanaṃ. ",
  "dn20:11.1": "athāgū nābhasā nāgā ",
  "dn20:11.2": "vesālā saha tacchakā ",
  "dn20:11.3": "kambalassatarā āgū ",
  "dn20:11.4": "pāyāgā saha ñātibhi ",
  "dn20:11.5": "yāmunā dhataraṭṭhā ca ",
  "dn20:11.6": "āgū nāgā yasassino ",
  "dn20:11.7": "erāvaṇo mahānāgo ",
  "dn20:11.8": "sopāga samitiṃ vanaṃ. ",
  "dn20:11.9": "ye nāgarāje sahasā haranti ",
  "dn20:11.10": "dibbā dijā pakkhi visuddhacakkhū ",
  "dn20:11.11": "vehāyasā te vanamajjhapattā ",
  "dn20:11.12": "citrā supaṇṇā iti tesa nāmaṃ ",
  "dn20:11.13": "abhayantadā nāgarājānamāsī ",
  "dn20:11.14": "supaṇṇato khemamakāsi buddho ",
  "dn20:11.15": "saṇhāhi vācāhi upavhayantā ",
  "dn20:11.16": "nāgā supaṇṇā saraṇamakaṃsu buddhaṃ. ",
  "dn20:12.1": "jitā vajirahatthena ",
  "dn20:12.2": "samuddaṃ asurā sitā ",
  "dn20:12.3": "bhātaro vāsavassete ",
  "dn20:12.4": "iddhimanto yasassino. ",
  "dn20:12.5": "kālakañjā mahābhismā ",
  "dn20:12.6": "asurā dānaveghasā ",
  "dn20:12.7": "vepacitti sucitti ca ",
  "dn20:12.8": "pahārādo namucī saha. ",
  "dn20:12.9": "satañca baliputtānaṃ ",
  "dn20:12.10": "sabbe verocanāmakā ",
  "dn20:12.11": "sannayhitvā baliṃ senaṃ ",
  "dn20:12.12": "rāhubhaddamupāgamuṃ ",
  "dn20:12.13": "samayodāni bhaddante ",
  "dn20:12.14": "bhikkhūnaṃ samitiṃ vanaṃ. ",
  "dn20:13.1": "āpo ca devā paṭhavī ca ",
  "dn20:13.2": "tejo vāyo tadāgamuṃ ",
  "dn20:13.3": "varuṇā vāruṇā devā ",
  "dn20:13.4": "somo ca yasasā saha. ",
  "dn20:13.5": "mettākaruṇākāyikā ",
  "dn20:13.6": "āgū devā yasassino ",
  "dn20:13.7": "dasete dasadhā kāyā ",
  "dn20:13.8": "sabbe nānattavaṇṇino ",
  "dn20:13.9": "iddhimanto jutimanto ",
  "dn20:13.10": "vaṇṇavanto yasassino ",
  "dn20:13.11": "modamānā abhikkāmuṃ ",
  "dn20:13.12": "bhikkhūnaṃ samitiṃ vanaṃ. ",
  "dn20:14.1": "veṇḍū ca devā sahalī ca ",
  "dn20:14.2": "asamā ca duve yamā ",
  "dn20:14.3": "candassūpanisā devā ",
  "dn20:14.4": "candamāgū purakkhitā. ",
  "dn20:14.5": "suriyassūpanisā devā ",
  "dn20:14.6": "suriyamāgū purakkhitā ",
  "dn20:14.7": "nakkhattāni purakkhatvā ",
  "dn20:14.8": "āgū mandavalāhakā ",
  "dn20:14.9": "vasūnaṃ vāsavo seṭṭho ",
  "dn20:14.10": "sakko pāga purindado. ",
  "dn20:14.11": "dasete dasadhā kāyā ",
  "dn20:14.12": "sabbe nānattavaṇṇino ",
  "dn20:14.13": "iddhimanto jutimanto ",
  "dn20:14.14": "vaṇṇavanto yasassino ",
  "dn20:14.15": "modamānā abhikkāmuṃ ",
  "dn20:14.16": "bhikkhūnaṃ samitiṃ vanaṃ. ",
  "dn20:15.1": "athāgū sahabhū devā ",
  "dn20:15.2": "jalamaggisikhāriva ",
  "dn20:15.3": "ariṭṭhakā ca rojā ca ",
  "dn20:15.4": "ummāpupphanibhāsino ",
  "dn20:15.5": "varuṇā sahadhammā ca ",
  "dn20:15.6": "accutā ca anejakā ",
  "dn20:15.7": "sūleyyarucirā āgū ",
  "dn20:15.8": "āgū vāsavanesino. ",
  "dn20:15.9": "dasete dasadhā kāyā ",
  "dn20:15.10": "sabbe nānattavaṇṇino ",
  "dn20:15.11": "iddhimanto jutimanto ",
  "dn20:15.12": "vaṇṇavanto yasassino ",
  "dn20:15.13": "modamānā abhikkāmuṃ ",
  "dn20:15.14": "bhikkhūnaṃ samitiṃ vanaṃ. ",
  "dn20:16.1": "samānā mahāsamānā ",
  "dn20:16.2": "mānusā mānusuttamā ",
  "dn20:16.3": "khiḍḍāpadūsikā āgū ",
  "dn20:16.4": "āgū manopadūsikā ",
  "dn20:16.5": "athāgū harayo devā ",
  "dn20:16.6": "ye ca lohitavāsino ",
  "dn20:16.7": "pāragā mahāpāragā ",
  "dn20:16.8": "āgū devā yasassino. ",
  "dn20:16.9": "dasete dasadhā kāyā ",
  "dn20:16.10": "sabbe nānattavaṇṇino ",
