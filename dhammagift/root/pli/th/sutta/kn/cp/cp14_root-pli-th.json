{
  "cp14:0.1": "",
  "cp14:0.2": "",
  "cp14:0.3": "",
  "cp14:0.4": "catutthaṃ cūḷabodhi cariyaṃ ",
  "cp14:1.1": "punāparaṃ yadā homi ",
  "cp14:1.2": "cūḷabodhi susīlavā ",
  "cp14:1.3": "bhavaṃ disvāna bhayato ",
  "cp14:1.4": "nekkhammaṃ abhinikkhamiṃ. ",
  "cp14:2.1": "yā me dutiyikā āsi ",
  "cp14:2.2": "brāhmaṇī kanakasannibhā ",
  "cp14:2.3": "sāpi vaṭṭe anapekkhā ",
  "cp14:2.4": "nekkhammaṃ abhinikkhami. ",
  "cp14:3.1": "nirālayā chinnabandhu ",
  "cp14:3.2": "anapekkhā kule gaṇe ",
  "cp14:3.3": "carantā gāma nigamaṃ ",
  "cp14:3.4": "bārāṇasiṃ upāgamuṃ. ",
  "cp14:4.1": "tattha vasāma nipakā ",
  "cp14:4.2": "asaṃsaṭṭhā kule gaṇe ",
  "cp14:4.3": "nirākule appasadde ",
  "cp14:4.4": "rājuyyāne vasāmubho. ",
  "cp14:5.1": "uyyānadassanaṃ gantvā ",
  "cp14:5.2": "rājā addasa brāhmaṇiṃ ",
  "cp14:5.3": "upasaṅgamma maṃ pucchi ",
  "cp14:5.4": "tuyhesā kā kassa bhariyā. ",
  "cp14:6.1": "evaṃ vutte ahan tassa ",
  "cp14:6.2": "idaṃ vacanamabraviṃ ",
  "cp14:6.3": "na mayhaṃ bhariyā esā ",
  "cp14:6.4": "sahadhammā ekasāsanī. ",
  "cp14:7.1": "tassā sāratta gadhito ",
  "cp14:7.2": "gāhāpetvāna ceṭake ",
  "cp14:7.3": "nippīḷayanto balasā ",
  "cp14:7.4": "antepuraṃ pavesayi. ",
  "cp14:8.1": "odapattikiyā mayhaṃ ",
  "cp14:8.2": "sahajātā ekasāsanī ",
  "cp14:8.3": "ākaḍḍhitvā nayantiyā ",
  "cp14:8.4": "kopo me uppajjatha. ",
  "cp14:9.1": "saha kope samuppanne ",
  "cp14:9.2": "sīlabbatamanussariṃ ",
  "cp14:9.3": "tattheva kopaṃ niggaṇhiṃ ",
  "cp14:9.4": "nādāsiṃ vaḍḍhitūpari. ",
  "cp14:10.1": "yadi taṃ brāhmaṇiṃ koci ",
  "cp14:10.2": "koṭṭeyya tiṇ hasattiyā ",
  "cp14:10.3": "neva sīlaṃ pabhindeyyaṃ ",
  "cp14:10.4": "bodhiyā yeva kāraṇā. ",
  "cp14:11.1": "na me sā brāhmaṇī dessā ",
  "cp14:11.2": "napi me balaṃ na vijjati ",
  "cp14:11.3": "sabbaññutaṃ piyaṃ mayhaṃ ",
  "cp14:11.4": "tasmā sīlānurakkhissanti. ",
  "cp14:12.1": "cūḷa bodhi cariyaṃ catutthaṃ. "
}
