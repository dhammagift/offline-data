  "cp18:0.1": "",
  "cp18:0.2": "",
  "cp18:0.3": "",
  "cp18:0.4": "aṭṭhamaṃ dhammadevaputta cariyaṃ ",
  "cp18:1.1": "punāparaṃ yadā homi ",
  "cp18:1.2": "mahesakkho mahiddhiko ",
  "cp18:1.3": "dhammo nāma mahāyakkho ",
  "cp18:1.4": "sabbalokānukampako. ",
  "cp18:2.1": "dasa kusalakammapathe ",
  "cp18:2.2": "samādapento mahājanaṃ ",
  "cp18:2.3": "carāmi gāmanigamaṃ ",
  "cp18:2.4": "samitto saparijano. ",
  "cp18:3.1": "pāpo kadariyo yakkho ",
  "cp18:3.2": "dīpento dasa pāpake ",
  "cp18:3.3": "sopettha mahiyā carati ",
  "cp18:3.4": "samitto saparijano. ",
  "cp18:4.1": "dhammavādī adhammo ca ",
  "cp18:4.2": "ubho paccanikā mayaṃ ",
  "cp18:4.3": "dhure dhuraṃ ghaṭayantā ",
  "cp18:4.4": "samimhā paṭipathe ubho. ",
  "cp18:5.1": "kalaho vattatī bhesmā ",
  "cp18:5.2": "kalyāṇa pāpakassa ca ",
  "cp18:5.3": "maggā ukkamanatthāya ",
  "cp18:5.4": "mahāyuddho upaṭṭhito. ",
  "cp18:6.1": "yadi han tassa pakuppeyyaṃ ",
  "cp18:6.2": "yadi bhinde tapoguṇaṃ ",
  "cp18:6.3": "saha parijanantassa ",
  "cp18:6.4": "rajabhūtaṃ kareyyahaṃ. ",
  "cp18:7.1": "apicāhaṃ sīlarakkhāya ",
  "cp18:7.2": "nibbāpetvāna mānasaṃ ",
  "cp18:7.3": "saha janenukkamitvā ",
  "cp18:7.4": "pathaṃ pāpassa dāsahaṃ. ",
  "cp18:8.1": "saha pathato ukkante ",
  "cp18:8.2": "katvā cittassa nibbutiṃ ",
  "cp18:8.3": "vivaraṃ adāsi paṭhavī ",
  "cp18:8.4": "pāpayakkhassa tāvadeti. ",
  "cp18:9.1": "dhammadevaputta cariyaṃ aṭṭhamaṃ. "
}
