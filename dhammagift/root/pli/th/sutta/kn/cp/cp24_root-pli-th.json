{
  "cp24:0.1": "",
  "cp24:0.2": "",
  "cp24:0.3": "",
  "cp24:0.4": "catutthaṃ bhiṃsa cariyaṃ ",
  "cp24:1.1": "punāparaṃ yadā homi ",
  "cp24:1.2": "kāsīnaṃ puravaruttame ",
  "cp24:1.3": "bhaginī ca bhātaro satta ",
  "cp24:1.4": "nibbattā sotthiye kule. ",
  "cp24:2.1": "etesaṃ pubbajo āsiṃ ",
  "cp24:2.2": "hiri sukkamupāgato ",
  "cp24:2.3": "bhavaṃ disvāna bhayato ",
  "cp24:2.4": "nekkhammābhirato ahaṃ. ",
  "cp24:3.1": "mātāpitūhi pahitā ",
  "cp24:3.2": "sahāyā ekamānasā ",
  "cp24:3.3": "kāmehi maṃ nimantenti ",
  "cp24:3.4": "kulavaṃsaṃ dhārehīti. ",
  "cp24:4.1": "yantesaṃ vacanaṃ vuttaṃ ",
  "cp24:4.2": "gihidhamme sukhāvahaṃ ",
  "cp24:4.3": "tam me ahosi kaṭhinaṃ ",
  "cp24:4.4": "tatta phālasamaṃ viya. ",
  "cp24:5.1": "te maṃ tadā ukkhipantaṃ ",
  "cp24:5.2": "pucchiṃsu patthitaṃ mama ",
  "cp24:5.3": "kiṃ tvaṃ patthayasi samma ",
  "cp24:5.4": "yadi kāme na bhuñjasi. ",
  "cp24:6.1": "tesāhaṃ evamavacaṃ ",
  "cp24:6.2": "attakāmo hitesinaṃ ",
  "cp24:6.3": "nāhaṃ patthemi gihibhāvaṃ ",
  "cp24:6.4": "nekkhammābhirato ahaṃ. ",
  "cp24:7.1": "te mayhaṃ vacanaṃ sutvā ",
  "cp24:7.2": "pituṃ mātuñca sāvayuṃ ",
  "cp24:7.3": "mātā pitā evamāhu ",
  "cp24:7.4": "sabbepi pabbajāma bho. ",
  "cp24:8.1": "ubho mātā pitā mayhaṃ ",
  "cp24:8.2": "bhaginī satta bhātaro ",
  "cp24:8.3": "amitaṃ dhanaṃ chaḍḍayitvā ",
  "cp24:8.4": "pāvisimhā mahāvananti. ",
  "cp24:9.1": "bhiṃsa cariyaṃ catutthaṃ. "
}
