{
  "cp20:0.1": "",
  "cp20:0.2": "",
  "cp20:0.3": "",
  "cp20:0.4": "dasamaṃ saṅkhapāla cariyaṃ ",
  "cp20:1.1": "punāparaṃ yadā homi ",
  "cp20:1.2": "saṅkhapālo mahiddhiko ",
  "cp20:1.3": "dāḍhāvudho ghoraviso ",
  "cp20:1.4": "dvijivho uragābhibhū. ",
  "cp20:2.1": "catuppathe mahāpathe nānājana ",
  "cp20:2.2": "samākule ",
  "cp20:2.3": "caturo aṅge adhiṭṭhāya ",
  "cp20:2.4": "tattha vāsamakappayiṃ. ",
  "cp20:3.1": "chaviyā cammena maṃsena ",
  "cp20:3.2": "nhārūhi aṭṭhikehi vā ",
  "cp20:3.3": "yassa etena karaṇīyaṃ ",
  "cp20:3.4": "dinnaṃ yeva harātu so. ",
  "cp20:4.1": "addasaṃsu bhojaputtā ",
  "cp20:4.2": "kharā luddhā akāruṇā ",
  "cp20:4.3": "upagacchuṃ mamaṃ tattha ",
  "cp20:4.4": "daṇḍa muggarapāṇino. ",
  "cp20:5.1": "nāsāya vinivijjhitvā ",
  "cp20:5.2": "naṅguṭṭhe piṭṭhi kaṇṭhake ",
  "cp20:5.3": "kāje āropayitvāna ",
  "cp20:5.4": "bhojaputtā hariṃsu maṃ. ",
  "cp20:6.1": "sasāgarantaṃ paṭhaviṃ ",
  "cp20:6.2": "sakānanaṃ sapabbataṃ ",
  "cp20:6.3": "icchamāno cahan tattha ",
  "cp20:6.4": "nāsavātena jhāpaye. ",
  "cp20:7.1": "sūlehi vijjhayantepi ",
  "cp20:7.2": "koṭṭayantepi sattibhi ",
  "cp20:7.3": "bhojaputte na kuppāmi ",
  "cp20:7.4": "esā me sīlapāramīti. ",
  "cp20:8.1": "saṅkhapāla cariyaṃ dasamaṃ. ",
  "cp20:9.1": "",
  "cp20:10.1": "tassuddānaṃ ",
  "cp20:11.1": "hatthināgo bhūridatto ",
  "cp20:11.2": "campeyyo bodhi māhiso ",
  "cp20:11.3": "ruru mātaṅga dhammo ca ",
  "cp20:11.4": "atrajo ca jayaddiso. ",
  "cp20:12.1": "ete sabbe sīlabalā ",
  "cp20:12.2": "parikkhārā padesikā ",
  "cp20:12.3": "jīvitaṃ parirakkhitvā ",
  "cp20:12.4": "sīlāni anurakkhissaṃ. ",
  "cp20:13.1": "saṅkhapālassa me sato ",
  "cp20:13.2": "sabbakālaṃpi jīvitaṃ ",
  "cp20:13.3": "yassa kassaci niyyantaṃ ",
  "cp20:13.4": "tasmā sā sīlapāramīti. ",
  "cp20:14.1": "sīlapārami niddeso niṭṭhito. 3. nekkhammādipāramitā "
}
