{
  "cp21:0.1": "",
  "cp21:0.2": "",
  "cp21:0.3": "",
  "cp21:0.4": "paṭhamaṃ yudhañjaya cariyaṃ ",
  "cp21:1.1": "yadāhaṃ amitayaso ",
  "cp21:1.2": "rājaputto yudhañjayo ",
  "cp21:1.3": "ussāvabinduṃ suriyātape ",
  "cp21:1.4": "patitaṃ disvāna saṃvijiṃ. ",
  "cp21:2.1": "tamevādhipatiṃ katvā ",
  "cp21:2.2": "saṃvegamānubrūhayiṃ ",
  "cp21:2.3": "mātu pituñca vanditvā ",
  "cp21:2.4": "pabbajjamanuyācihaṃ. ",
  "cp21:3.1": "yācanti maṃ pañjalikā ",
  "cp21:3.2": "sanegamā saraṭṭhakā ",
  "cp21:3.3": "ajjeva putta paṭipajja ",
  "cp21:3.4": "iddhaṃ phītaṃ mahāmahiṃ. ",
  "cp21:4.1": "sarājake saorodhe ",
  "cp21:4.2": "sanegame saraṭṭhake ",
  "cp21:4.3": "karuṇaṃ paridevante ",
  "cp21:4.4": "anapekkho pariccajiṃ. ",
  "cp21:5.1": "kevalaṃ paṭhavīrajjaṃ ñāti ",
  "cp21:5.2": "parijanaṃ yasaṃ ",
  "cp21:5.3": "cajamāno na cintesiṃ ",
  "cp21:5.4": "bodhiyā yeva kāraṇā. ",
  "cp21:6.1": "mātā pitā na me dessā ",
  "cp21:6.2": "napi me dessā mahāyasā ",
  "cp21:6.3": "sabbaññutaṃ piyaṃ mayhaṃ ",
  "cp21:6.4": "tasmā rajjaṃ pariccajinti. ",
  "cp21:7.1": "yudhañjaya cariyaṃ paṭhamaṃ. "
}
