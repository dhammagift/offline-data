{
  "cp4:0.1": "",
  "cp4:0.2": "",
  "cp4:0.3": "",
  "cp4:0.4": "catutthaṃ mahāsudassana cariyaṃ ",
  "cp4:1.1": "kusāvatimhi nagare ",
  "cp4:1.2": "yadā āsiṃ mahīpati ",
  "cp4:1.3": "mahāsudassano nāma ",
  "cp4:1.4": "cakkavatti mahabbalo. ",
  "cp4:2.1": "tatthāhaṃ divase tikkhattuṃ ",
  "cp4:2.2": "ghosāpemi tahiṃ tahiṃ ",
  "cp4:2.3": "ko kiṃ icchati pattheti ",
  "cp4:2.4": "kassa kiṃ diyyatū dhanaṃ. ",
  "cp4:3.1": "ko chātako ko tasito ",
  "cp4:3.2": "ko mālaṃ ko vilepanaṃ ",
  "cp4:3.3": "nānārattāni vatthāni ",
  "cp4:3.4": "ko naggo paridahissati ",
  "cp4:4.1": "ko pathe chattamādeti ",
  "cp4:4.2": "kopāhanā mudū subhā. ",
  "cp4:4.3": "iti sāyañca pāto ca ",
  "cp4:4.4": "ghosāpemi tahiṃ tahiṃ ",
  "cp4:5.1": "na taṃ dasasu ṭhānesu ",
  "cp4:5.2": "na hi ṭhānasatesu vā. ",
  "cp4:5.3": "anekasata ṭhānesu ",
  "cp4:5.4": "paṭiyattaṃ yācake dhanaṃ ",
  "cp4:6.1": "divā vā yadivā rattiṃ ",
  "cp4:6.2": "yadi eti vaṇibbako. ",
  "cp4:6.3": "laddhā yadicchakaṃ bhogaṃ ",
  "cp4:6.4": "pūrahatthova gacchati ",
  "cp4:7.1": "evarūpaṃ mahādānaṃ ",
  "cp4:7.2": "adāsiṃ yāvajīvikaṃ. ",
  "cp4:7.3": "napāhaṃ dessaṃ dhanaṃ dammi ",
  "cp4:7.4": "napi natthi nicayo mayi ",
  "cp4:8.1": "yathāpi āturo nāma ",
  "cp4:8.2": "rogato parimuttiyā. ",
  "cp4:8.3": "dhanena vejjaṃ tappetvā ",
  "cp4:8.4": "rogato parimuccati ",
  "cp4:9.1": "tathevāhaṃ jānamāno ",
  "cp4:9.2": "paripūretuṃ asesato. ",
  "cp4:9.3": "ūnamanaṃ pūrayituṃ ",
  "cp4:9.4": "demi dānaṃ vaṇibbake ",
  "cp4:9.5": "nirālayo apaccāso ",
  "cp4:9.6": "sambodhimanupattiyāti. ",
  "cp4:10.1": "mahāsudassana cariyaṃ catutthaṃ. "
}
