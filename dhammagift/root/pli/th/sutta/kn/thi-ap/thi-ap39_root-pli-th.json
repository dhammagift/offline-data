{
  "thi-ap39:0.1": "",
  "thi-ap39:0.2": "",
  "thi-ap39:0.3": "",
  "thi-ap39:1.1": "yo raṃsirucitāveḷo ",
  "thi-ap39:1.2": "phusso nāma mahāmuni ",
  "thi-ap39:1.3": "tassāhaṃ bhaginī āsiṃ ",
  "thi-ap39:1.4": "ajāyiṃ khattiye kule. ",
  "thi-ap39:2.1": "tassa dhammaṃ suṇitvāhaṃ ",
  "thi-ap39:2.2": "vippasannena cetasā ",
  "thi-ap39:2.3": "mahādānaṃ daditvāna ",
  "thi-ap39:2.4": "patthayiṃ rūpasampadaṃ. ",
  "thi-ap39:3.1": "ekatiṃse ito kappe ",
  "thi-ap39:3.2": "sikhī lokagganāyako ",
  "thi-ap39:3.3": "uppanno lokapajjoto ",
  "thi-ap39:3.4": "tilokasaraṇo jino. ",
  "thi-ap39:4.1": "tadā aruṇapure ramme ",
  "thi-ap39:4.2": "brahmaññakulasambhavā ",
  "thi-ap39:4.3": "vimuttacittaṃ kupitā ",
  "thi-ap39:4.4": "bhikkhuniṃ abhisāpayiṃ. ",
  "thi-ap39:5.1": "vesikā ca anācārā ",
  "thi-ap39:5.2": "jinasāsanadūsikā ",
  "thi-ap39:5.3": "evaṃ akkosayitvāna ",
  "thi-ap39:5.4": "tena pāpena kammunā. ",
  "thi-ap39:6.1": "dāruṇaṃ nirayaṃ gantvā ",
  "thi-ap39:6.2": "mahādukkhasamappitā ",
  "thi-ap39:6.3": "tato cutā manussesu ",
  "thi-ap39:6.4": "upapannā tapassinī. ",
  "thi-ap39:7.1": "dasajātisahassāni ",
  "thi-ap39:7.2": "gaṇikattaṃ akārayiṃ ",
  "thi-ap39:7.3": "tato pāpā na muccissaṃ ",
  "thi-ap39:7.4": "bhutvā duṭṭhavisaṃ yathā. ",
  "thi-ap39:8.1": "brahmavesamasevissaṃ ",
  "thi-ap39:8.2": "kassape jinasāsane ",
  "thi-ap39:8.3": "tena kammavipākena ",
  "thi-ap39:8.4": "ajāyiṃ tidase pure. ",
  "thi-ap39:9.1": "pacchime bhavasampatte ",
  "thi-ap39:9.2": "ahosiṃ opapātikā ",
  "thi-ap39:9.3": "ambasākhantare jātā ",
  "thi-ap39:9.4": "ambapālīti tenahaṃ. ",
  "thi-ap39:10.1": "parivutā pāṇakoṭīhi ",
  "thi-ap39:10.2": "pabbajiṃ jinasāsane ",
  "thi-ap39:10.3": "pattāhaṃ acalaṃ ṭhānaṃ ",
  "thi-ap39:10.4": "dhītā buddhassa orasā. ",
  "thi-ap39:11.1": "iddhīsu ca vasī homi ",
  "thi-ap39:11.2": "dibbāya sotadhātuyā ",
  "thi-ap39:11.3": "cetopariyañāṇassa ",
  "thi-ap39:11.4": "vasī homi mahāmune. ",
  "thi-ap39:12.1": "pubbenivāsaṃ jānāmi ",
  "thi-ap39:12.2": "dibbacakkhuṃ visodhitaṃ ",
  "thi-ap39:12.3": "sabbāsavaparikkhīṇā ",
  "thi-ap39:12.4": "natthi dāni punabbhavo. ",
  "thi-ap39:13.1": "atthadhammaniruttīsu ",
  "thi-ap39:13.2": "paṭibhāṇe tatheva ca ",
  "thi-ap39:13.3": "ñāṇaṃ me vimalaṃ suddhaṃ ",
  "thi-ap39:13.4": "buddhaseṭṭhassa vāhasā. ",
  "thi-ap39:14.1": "kilesā jhāpitā mayhaṃ ",
  "thi-ap39:14.2": "bhavā sabbe samūhatā nāgīva bandhanaṃ chetvā ",
  "thi-ap39:14.3": "viharāmi anāsavā. ",
  "thi-ap39:15.1": "svāgataṃ vata me āsi ",
  "thi-ap39:15.2": "buddhaseṭṭhassa santike tisso vijjā anuppattā ",
  "thi-ap39:15.3": "kataṃ buddhassa sāsanaṃ. ",
  "thi-ap39:16.1": "paṭisambhidā catasso ",
  "thi-ap39:16.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "thi-ap39:16.3": "kataṃ buddhassa sāsananti. ",
  "thi-ap39:17.1": "itthaṃ sudaṃ āyasmā ambapālī bhikkhunī imā gāthāyo abhāsitthāti. ",
  "thi-ap39:18.1": "ambapālītheriyā apadānaṃ samattaṃ. dasamaṃ selātheriyāpadānaṃ (40) "
}
