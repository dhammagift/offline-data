{
  "thi-ap17:0.1": "",
  "thi-ap17:0.2": "",
  "thi-ap17:0.3": "",
  "thi-ap17:1.1": "ekadā lokapajjoto ",
  "thi-ap17:1.2": "vesāliyaṃ mahāvane ",
  "thi-ap17:1.3": "kūṭāgāresu sālāya ",
  "thi-ap17:1.4": "vasate narasārathi. ",
  "thi-ap17:2.1": "tadā jinassa mātucchā ",
  "thi-ap17:2.2": "mahāgotami bhikkhunī ",
  "thi-ap17:2.3": "tahiṃyeva pure ramme ",
  "thi-ap17:2.4": "vasi bhikkhunupassaye. ",
  "thi-ap17:3.1": "bhikkhunīhi vimuttāhi ",
  "thi-ap17:3.2": "satehi saha pañcahi ",
  "thi-ap17:3.3": "rahogatāya tassevaṃ ",
  "thi-ap17:3.4": "cittassāpi vitakkitaṃ. ",
  "thi-ap17:4.1": "buddhassa parinibbānaṃ ",
  "thi-ap17:4.2": "sāvakaggayugassa vā ",
  "thi-ap17:4.3": "rāhulānandanandānaṃ ",
  "thi-ap17:4.4": "nāhaṃ lacchāmi passituṃ. ",
  "thi-ap17:5.1": "",
  "thi-ap17:5.2": "",
  "thi-ap17:5.3": "",
  "thi-ap17:5.4": "",
  "thi-ap17:6.1": "paṭikaccāyusaṅkhāraṃ ",
  "thi-ap17:6.2": "osajjitvāna nibbutiṃ ",
  "thi-ap17:6.3": "gaccheyyaṃ lokanāthena ",
  "thi-ap17:6.4": "anuññātā mahesinā. ",
  "thi-ap17:7.1": "tathā pañcasatānaṃpi ",
  "thi-ap17:7.2": "bhikkhunīnaṃ vitakkitaṃ ",
  "thi-ap17:7.3": "āsi khemādikānampi ",
  "thi-ap17:7.4": "etadeva vitakkitaṃ. ",
  "thi-ap17:8.1": "bhūmicālo tadā āsi ",
  "thi-ap17:8.2": "nāditā devadundubhi ",
  "thi-ap17:8.3": "upassayādhivatthāyo ",
  "thi-ap17:8.4": "devatā sokapīḷitā. ",
  "thi-ap17:9.1": "vilapantā sakaruṇaṃ ",
  "thi-ap17:9.2": "tatthassūni pavattayuṃ ",
  "thi-ap17:9.3": "sabbā bhikkhuniyo tāhi ",
  "thi-ap17:9.4": "upagantvāna gotamiṃ. ",
  "thi-ap17:10.1": "nipacca sirasā pāde ",
  "thi-ap17:10.2": "idaṃ vacanamabravuṃ ",
  "thi-ap17:10.3": "tattha tolayavāsittā ",
  "thi-ap17:10.4": "mayamayye rahogatā. ",
  "thi-ap17:11.1": "sācalā calitā bhūmi ",
  "thi-ap17:11.2": "nāditā devadundubhi ",
  "thi-ap17:11.3": "paridevā ca suyyante ",
  "thi-ap17:11.4": "kimatthaṃ nūna gotami. ",
  "thi-ap17:12.1": "tadā avoca sā sabbaṃ ",
  "thi-ap17:12.2": "yathāparivitakkitaṃ ",
  "thi-ap17:12.3": "tatopi sabbā āhaṃsu ",
  "thi-ap17:12.4": "yathāparivitakkitaṃ. ",
  "thi-ap17:13.1": "yadi te rucitaṃ ayye ",
  "thi-ap17:13.2": "nibbānaṃ paramaṃ sivaṃ ",
  "thi-ap17:13.3": "nibbāyissāma sabbāpi ",
  "thi-ap17:13.4": "buddhānuññātapubbake. ",
  "thi-ap17:14.1": "mayaṃ sahāva nikkhantā ",
  "thi-ap17:14.2": "gharāpica bhavāpica ",
  "thi-ap17:14.3": "sahāyeva gamissāma ",
  "thi-ap17:14.4": "nibbānaṃ puramuttamaṃ. ",
  "thi-ap17:15.1": "nibbānāya vajantīnaṃ ",
  "thi-ap17:15.2": "kiṃ vakkhāmīti sā vadaṃ ",
  "thi-ap17:15.3": "saha sabbāhi niggañchi ",
  "thi-ap17:15.4": "bhikkhunīlayanā tadā. ",
  "thi-ap17:16.1": "upassaye yādhivatthā ",
  "thi-ap17:16.2": "devatā tā khamantu me ",
  "thi-ap17:16.3": "bhikkhunīlayanassedaṃ ",
  "thi-ap17:16.4": "pacchimaṃ dassanaṃ mama. ",
  "thi-ap17:17.1": "na jarā maccu vā yattha ",
  "thi-ap17:17.2": "appiyehi samāgamo ",
  "thi-ap17:17.3": "piyehi na viyogotthi ",
  "thi-ap17:17.4": "taṃ vajjiyaṃ asaṅkhataṃ. ",
  "thi-ap17:18.1": "avītarāgā taṃ sutvā ",
  "thi-ap17:18.2": "vacanaṃ sugatorasā ",
  "thi-ap17:18.3": "sokaṭṭā parideviṃsu ",
  "thi-ap17:18.4": "aho no appapuññatā. ",
  "thi-ap17:19.1": "bhikkhunīnilayo suñño ",
  "thi-ap17:19.2": "bhūto tāhi vinā ayaṃ ",
  "thi-ap17:19.3": "pabhāte viya tārāyo ",
  "thi-ap17:19.4": "na dissanti jinorasā. ",
  "thi-ap17:20.1": "nibbānaṃ gotamī yāti ",
  "thi-ap17:20.2": "satehi saha pañcahi ",
  "thi-ap17:20.3": "nadīsatehiva sahā ",
  "thi-ap17:20.4": "gaṅgā pañcahi sāgaraṃ. ",
  "thi-ap17:21.1": "rathiyāya vajantī taṃ ",
  "thi-ap17:21.2": "disvā saddhā upāsikā ",
  "thi-ap17:21.3": "gharā nikkhamma pādesu ",
  "thi-ap17:21.4": "nipacca idamabravuṃ. ",
  "thi-ap17:22.1": "pasīdassu mahābhoge ",
  "thi-ap17:22.2": "anāthāyo vihāya no ",
  "thi-ap17:22.3": "tayā na yuttaṃ nibbātuṃ ",
  "thi-ap17:22.4": "icchaṭṭā vilapiṃsu tā. ",
  "thi-ap17:23.1": "tāsaṃ sokapahānatthaṃ ",
  "thi-ap17:23.2": "avoca madhuraṃ giraṃ ",
  "thi-ap17:23.3": "ruditena alaṃ puttā ",
  "thi-ap17:23.4": "hāsakāloyamajja vo. ",
  "thi-ap17:24.1": "pariññātaṃ mayā dukkhaṃ ",
  "thi-ap17:24.2": "dukkhahetu vivajjito ",
  "thi-ap17:24.3": "nirodho me sacchikato ",
  "thi-ap17:24.4": "maggo cāpi subhāvito. ",
  "thi-ap17:25.1": "paṭhamaṃ bhāṇavāraṃ. ",
  "thi-ap17:26.1": "pariciṇṇo mayā satthā ",
  "thi-ap17:26.2": "kataṃ buddhassa sāsanaṃ ",
  "thi-ap17:26.3": "ohito garuko bhāro ",
  "thi-ap17:26.4": "bhavanetti samūhatā. ",
  "thi-ap17:27.1": "yassatthāya pabbajitā ",
  "thi-ap17:27.2": "agārasmā anagāriyaṃ ",
  "thi-ap17:27.3": "so me attho anuppatto ",
  "thi-ap17:27.4": "sabbasaṃyojanakkhayo. ",
  "thi-ap17:28.1": "buddho tassa ca saddhammo ",
  "thi-ap17:28.2": "anūno yāva tiṭṭhati ",
  "thi-ap17:28.3": "nibbātuṃ tāva kālo me ",
  "thi-ap17:28.4": "mā maṃ socatha puttikā. ",
  "thi-ap17:29.1": "koṇḍaññānandanandādi ",
  "thi-ap17:29.2": "tiṭṭhanti rāhulo jino ",
  "thi-ap17:29.3": "sukhito sahito saṅgho ",
  "thi-ap17:29.4": "hatadappāva titthiyā. ",
  "thi-ap17:30.1": "okkākavaṃsassa yaso ",
  "thi-ap17:30.2": "ussito māramaddano ",
  "thi-ap17:30.3": "nanu sampattikālo me ",
  "thi-ap17:30.4": "nibbānatthāya puttikā. ",
  "thi-ap17:31.1": "cirappabhūti yaṃ mayhaṃ ",
  "thi-ap17:31.2": "patthitaṃ ajja sijjhate ",
  "thi-ap17:31.3": "ānandabherikāloyaṃ ",
  "thi-ap17:31.4": "kiṃ vo assūhi puttikā. ",
  "thi-ap17:32.1": "sace mayi dayā atthi ",
  "thi-ap17:32.2": "yadi catthi kataññutā ",
  "thi-ap17:32.3": "saddhammaṭṭhitiyā sabbā ",
  "thi-ap17:32.4": "karotha viriyaṃ daḷhaṃ. ",
  "thi-ap17:33.1": "thīnaṃ adāsi pabbajjaṃ ",
  "thi-ap17:33.2": "sambuddho yācito mayā ",
  "thi-ap17:33.3": "tasmā yathāhaṃ nandissaṃ ",
  "thi-ap17:33.4": "tathā taṃ anutiṭṭhatha. ",
  "thi-ap17:34.1": "tā evamanussāsitvā ",
  "thi-ap17:34.2": "bhikkhunīhi purakkhatā ",
  "thi-ap17:34.3": "upecca buddhaṃ vanditvā ",
  "thi-ap17:34.4": "idaṃ vacanamabraviṃ. ",
  "thi-ap17:35.1": "ahaṃ sugata te mātā ",
  "thi-ap17:35.2": "tuvaṃ dhīra pitā mama ",
  "thi-ap17:35.3": "saddhammasukhado nātha ",
  "thi-ap17:35.4": "tayā jātamhi gotama. ",
  "thi-ap17:36.1": "saṃvaddhitoyaṃ sugata ",
  "thi-ap17:36.2": "rūpakāyo mayā tava ",
  "thi-ap17:36.3": "ānandiyo dhammakāyo ",
  "thi-ap17:36.4": "mama saṃvaddhito tayā. ",
  "thi-ap17:37.1": "muhuttaṃ taṇhāsamanaṃ ",
  "thi-ap17:37.2": "khīraṃ tvaṃ pāyito mayā ",
  "thi-ap17:37.3": "tayāhaṃ santamaccantaṃ ",
  "thi-ap17:37.4": "dhammakhīrampi pāyitā. ",
  "thi-ap17:38.1": "bandhanārakkhane mayhaṃ ",
  "thi-ap17:38.2": "anaṇo tvaṃ mahāmune ",
  "thi-ap17:38.3": "puttakāmitthiyo yācaṃ ",
  "thi-ap17:38.4": "labhanti tādisaṃ sutaṃ. ",
  "thi-ap17:39.1": "mandhātādinarindānaṃ ",
  "thi-ap17:39.2": "yā mātā sā bhavaṇṇave ",
  "thi-ap17:39.3": "nimuggāhaṃ tayā putta ",
  "thi-ap17:39.4": "tāritā bhavasāgarā. ",
  "thi-ap17:40.1": "rañño mātā mahesīti ",
  "thi-ap17:40.2": "sulabhaṃ nāmamitthinaṃ ",
  "thi-ap17:40.3": "buddhamātāti yaṃ nāmaṃ ",
  "thi-ap17:40.4": "etaṃ paramadullabhaṃ. ",
  "thi-ap17:41.1": "tañca laddhaṃ mahāvīra ",
  "thi-ap17:41.2": "paṇidhānaṃ mamantayā ",
  "thi-ap17:41.3": "anukaṃ vā mahantaṃ vā ",
  "thi-ap17:41.4": "taṃ sabbaṃ pūritaṃ tayā. ",
  "thi-ap17:42.1": "parinibbātumicchāmi ",
  "thi-ap17:42.2": "vihāyemaṃ kalevaraṃ ",
  "thi-ap17:42.3": "anujānāhi me vīra ",
  "thi-ap17:42.4": "dukkhantakara nāyaka. ",
  "thi-ap17:43.1": "cakkaṅkusadhajākiṇṇe ",
  "thi-ap17:43.2": "pāde kamalakomale ",
  "thi-ap17:43.3": "pasārehi paṇāmante ",
  "thi-ap17:43.4": "karissaṃ puttapemahaṃ. ",
  "thi-ap17:44.1": "suvaṇṇarāsisaṅkāsaṃ ",
  "thi-ap17:44.2": "sarīraṃ kurupākaṭaṃ ",
  "thi-ap17:44.3": "katvā dehaṃ sudiṭṭhante santaṃ ",
  "thi-ap17:44.4": "gacchāmi nāyaka. ",
  "thi-ap17:45.1": "dvattiṃsalakkhaṇūpetaṃ ",
  "thi-ap17:45.2": "suppabhālaṅkataṃ tanuṃ ",
  "thi-ap17:45.3": "sañchagghanāva bālakkhaṃ ",
  "thi-ap17:45.4": "mātucchaṃ dassayi jino. ",
  "thi-ap17:46.1": "phullāravindasaṅkāse ",
  "thi-ap17:46.2": "taruṇādiccasappabhe ",
  "thi-ap17:46.3": "cakkaṅkite pādatale ",
  "thi-ap17:46.4": "tato sā sirasā pati. ",
  "thi-ap17:47.1": "paṇamāmi narādiccaṃ ",
  "thi-ap17:47.2": "ādiccakulaketunaṃ ",
  "thi-ap17:47.3": "pacchime saraṇaṃ mayhaṃ ",
  "thi-ap17:47.4": "na taṃ dakkhāmahaṃ puna. ",
  "thi-ap17:48.1": "itthiyo nāma lokagga ",
  "thi-ap17:48.2": "sabbadosakarā matā ",
  "thi-ap17:48.3": "yadi kocatthi doso me ",
  "thi-ap17:48.4": "khamassu karuṇākara. ",
  "thi-ap17:49.1": "itthikānañca pabbajjaṃ ",
  "thi-ap17:49.2": "yamahaṃ yāciṃ punappunaṃ ",
  "thi-ap17:49.3": "tattha ce atthi doso me ",
  "thi-ap17:49.4": "taṃ khamassu narāsabha. ",
  "thi-ap17:50.1": "mayā bhikkhuniyo vīra ",
  "thi-ap17:50.2": "tavānuññāya sāsitā ",
  "thi-ap17:50.3": "tattha ce atthi dunnītaṃ ",
  "thi-ap17:50.4": "taṃ khamassu khamādhiti. ",
  "thi-ap17:51.1": "akkhante nāma khantabbaṃ ",
  "thi-ap17:51.2": "kiṃ bhave guṇabhūsane ",
  "thi-ap17:51.3": "kimuttarante vakkhāmi ",
  "thi-ap17:51.4": "nibbānāya vadantiyā. ",
  "thi-ap17:52.1": "suddhe anūne mama bhikkhusaṅghe ",
  "thi-ap17:52.2": "lokā ito nissarituṃ khamante ",
  "thi-ap17:52.3": "pabhātakāle byasanaṅgatānaṃ ",
  "thi-ap17:52.4": "disvāna niyyāti hi candalekhā. ",
  "thi-ap17:53.1": "tadetarā bhikkhuniyo jinaggaṃ ",
  "thi-ap17:53.2": "tārāva candānugatā sumeruṃ ",
  "thi-ap17:53.3": "padakkhiṇaṃ katva nipacca pāde ",
  "thi-ap17:53.4": "ṭhitā mukhantassamudikkhamānā. ",
  "thi-ap17:54.1": "na tittipubbaṃ tava dassanena ",
  "thi-ap17:54.2": "cakkhuṃ na sotaṃ tava bhāsitena ",
  "thi-ap17:54.3": "cittaṃ mamaṃ kevalamekameva ",
  "thi-ap17:54.4": "pappuyya taṃ dhammarasena tittiṃ. ",
  "thi-ap17:55.1": "nadato parisāyante vādidappapahārino ",
  "thi-ap17:55.2": "",
  "thi-ap17:55.3": "ye te dakkhanti vadanaṃ ",
  "thi-ap17:55.4": "dhaññā te narapuṅgava. ",
  "thi-ap17:56.1": "dīghaṅgulitambanakhe ",
  "thi-ap17:56.2": "subhe āyatapaṇhike ",
  "thi-ap17:56.3": "ye pāde paṇamāyanti ",
  "thi-ap17:56.4": "tepi dhaññā raṇantaga. ",
  "thi-ap17:57.1": "madhurāni pahaṭṭhāni ",
  "thi-ap17:57.2": "dosajhāni hitāni ca ",
  "thi-ap17:57.3": "ye te vākyāni suṇanti ",
  "thi-ap17:57.4": "tepi dhaññā naruttama. ",
  "thi-ap17:58.1": "dhaññāhante mahāvīra ",
  "thi-ap17:58.2": "pādapūjanatappavā ",
  "thi-ap17:58.3": "tiṇṇasaṃsārakantārā ",
  "thi-ap17:58.4": "suvākyena sirīmato. ",
  "thi-ap17:59.1": "tato sā anusāvetvā ",
  "thi-ap17:59.2": "bhikkhusaṅghamhi subbatā ",
  "thi-ap17:59.3": "rāhulānandanande ca ",
  "thi-ap17:59.4": "vanditvā idamabravi. ",
  "thi-ap17:60.1": "āsivisālayasame ",
  "thi-ap17:60.2": "rogāvāse kalevare ",
  "thi-ap17:60.3": "nibbiṇṇā dukkhasaṅkete ",
  "thi-ap17:60.4": "jarāmaraṇagocare. ",
  "thi-ap17:61.1": "nānākuṇapamalākiṇṇe ",
  "thi-ap17:61.2": "parāyatte nirīhake ",
  "thi-ap17:61.3": "tena nibbātumicchāmi ",
  "thi-ap17:61.4": "anumaññatha puttakā. ",
  "thi-ap17:62.1": "nando rāhulabhaddo ca ",
  "thi-ap17:62.2": "vītasokā nirāsavā ",
  "thi-ap17:62.3": "ṭhitācalā dhitī vīrā ",
  "thi-ap17:62.4": "dhammatamanucintayuṃ. ",
  "thi-ap17:63.1": "dhiratthu saṅkhataṃ lokaṃ ",
  "thi-ap17:63.2": "asāraṃ kadalūpamaṃ ",
  "thi-ap17:63.3": "māyāmarīcisadisaṃ ",
  "thi-ap17:63.4": "ittaraṃ anavaṭṭhitaṃ. ",
  "thi-ap17:64.1": "yattha nāma jinassāyaṃ ",
  "thi-ap17:64.2": "mātucchā buddhaposikā ",
  "thi-ap17:64.3": "gotamī nidhanaṃ yāti ",
  "thi-ap17:64.4": "aniccaṃ sabbasaṅkhataṃ. ",
  "thi-ap17:65.1": "ānando ca tadā sekho ",
  "thi-ap17:65.2": "kaniṭṭho jinavacchalo ",
  "thi-ap17:65.3": "tatthassūni karonto so ",
  "thi-ap17:65.4": "karuṇaṃ paridevati. ",
  "thi-ap17:66.1": "bhāsantī gotamī yāti ",
  "thi-ap17:66.2": "nūna buddhopi nibbutiṃ ",
  "thi-ap17:66.3": "gacchati na cireneva ",
  "thi-ap17:66.4": "aggi viya nirindhano. ",
  "thi-ap17:67.1": "evaṃ vilapamānantaṃ ",
  "thi-ap17:67.2": "ānandaṃ āha gotamī ",
  "thi-ap17:67.3": "sutisāgaragambhīraṃ ",
  "thi-ap17:67.4": "buddhopaṭṭhānatapparaṃ. ",
  "thi-ap17:68.1": "na yuttaṃ socituṃ putta ",
  "thi-ap17:68.2": "hāsakāle upaṭṭhite ",
  "thi-ap17:68.3": "tassā me maraṇaṃ putta ",
  "thi-ap17:68.4": "nibbānantamupāgataṃ. ",
  "thi-ap17:69.1": "tayā tāta samajjhiṭṭho ",
  "thi-ap17:69.2": "pabbajjaṃ anujāni no ",
  "thi-ap17:69.3": "mā putta vimano hohi ",
  "thi-ap17:69.4": "saphalo te parissamo. ",
  "thi-ap17:70.1": "yaṃ na diṭṭhaṃ purāṇehi ",
  "thi-ap17:70.2": "titthikācariyehi ca ",
  "thi-ap17:70.3": "taṃ padaṃ sukumārīhi ",
  "thi-ap17:70.4": "sattavassāhi veditaṃ. ",
  "thi-ap17:71.1": "buddhasāsanapāletā ",
  "thi-ap17:71.2": "pacchimaṃ dassanaṃ tava ",
  "thi-ap17:71.3": "tattha gacchāmahaṃ putta ",
  "thi-ap17:71.4": "gato yattha na dissati. ",
  "thi-ap17:72.1": "kadāci dhammaṃ desento ",
  "thi-ap17:72.2": "khipi lokagganāyako ",
  "thi-ap17:72.3": "tadāhaṃ āsīsavācaṃ ",
  "thi-ap17:72.4": "avocaṃ anukampikā. ",
  "thi-ap17:73.1": "ciraṃ jīva mahāvīra ",
  "thi-ap17:73.2": "kappaṃ tiṭṭha mahāmune ",
  "thi-ap17:73.3": "sabbalokahitatthāya ",
  "thi-ap17:73.4": "bhavassu ajarāmaro. ",
  "thi-ap17:74.1": "taṃ tathāvādiniṃ buddho ",
  "thi-ap17:74.2": "mamaṃ so etadabravi ",
  "thi-ap17:74.3": "nahevaṃ vandiyā buddhā ",
  "thi-ap17:74.4": "yathā vandasi gotami. ",
  "thi-ap17:75.1": "kathañcarahi sabbaññū ",
  "thi-ap17:75.2": "vanditabbā tathāgatā ",
  "thi-ap17:75.3": "kathaṃ avandiyā buddhā ",
  "thi-ap17:75.4": "taṃ me akkhāhi pucchito. ",
  "thi-ap17:76.1": "āraddhaviriye pahitatte ",
  "thi-ap17:76.2": "niccaṃ daḷhaparakkame ",
  "thi-ap17:76.3": "samagge sāvake passa ",
  "thi-ap17:76.4": "etaṃ buddhāna vandanaṃ. ",
  "thi-ap17:77.1": "tato upassayaṃ gantvā ",
  "thi-ap17:77.2": "ekikāhaṃ vicintayiṃ ",
  "thi-ap17:77.3": "samaggaṃ parisaṃ nātho ",
  "thi-ap17:77.4": "roceti tibhavantago. ",
  "thi-ap17:78.1": "handāhaṃ parinibbāyaṃ ",
  "thi-ap17:78.2": "mā vipattiṃ tamaddasaṃ ",
  "thi-ap17:78.3": "evāhaṃ cintayitvāna ",
  "thi-ap17:78.4": "disvāna isisattamaṃ. ",
  "thi-ap17:79.1": "parinibbānakālaṃ maṃ ",
  "thi-ap17:79.2": "ārocemi vināyakaṃ ",
  "thi-ap17:79.3": "tato so samanuññāsi ",
  "thi-ap17:79.4": "kālaṃ jānāhi gotami. ",
  "thi-ap17:80.1": "kilesā jhāpitā mayhaṃ ",
  "thi-ap17:80.2": "bhavā sabbe samūhatā nāgīva bandhanaṃ chetvā ",
  "thi-ap17:80.3": "viharāmi anāsavā. ",
  "thi-ap17:81.1": "svāgataṃ vata me āsi ",
  "thi-ap17:81.2": "buddhaseṭṭhassa santike tisso vijjā anuppattā ",
  "thi-ap17:81.3": "kataṃ buddhassa sāsanaṃ. ",
  "thi-ap17:82.1": "paṭisambhidā catasso ",
  "thi-ap17:82.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "thi-ap17:82.3": "kataṃ buddhassa sāsanaṃ. ",
  "thi-ap17:83.1": "thīnaṃ dhammābhisamaye ",
  "thi-ap17:83.2": "ye bālā vimatiṃ gatā ",
  "thi-ap17:83.3": "tesaṃ diṭṭhipahānatthaṃ ",
  "thi-ap17:83.4": "iddhiṃ dassehi gotami. ",
  "thi-ap17:84.1": "tadā nipacca sambuddhaṃ ",
  "thi-ap17:84.2": "upatitvāna ambaraṃ ",
  "thi-ap17:84.3": "iddhī anekā dassesi ",
  "thi-ap17:84.4": "buddhānuññāya gotamī. ",
  "thi-ap17:85.1": "ekikā bahudhā āsi ",
  "thi-ap17:85.2": "bahukā cekikā tathā ",
  "thi-ap17:85.3": "āvibhāvaṃ tirobhāvaṃ ",
  "thi-ap17:85.4": "tirokuḍḍaṃ tironagaṃ. ",
  "thi-ap17:86.1": "asajjamānā agamā ",
  "thi-ap17:86.2": "bhūmiyampi nimujjatha ",
  "thi-ap17:86.3": "abhijjamāne udake ",
  "thi-ap17:86.4": "agañchi mahiyaṃ yathā. ",
  "thi-ap17:87.1": "sakuṇīva yathākāse ",
  "thi-ap17:87.2": "pallaṅkena kamī tadā ",
  "thi-ap17:87.3": "vasaṃ vattesi kāyena ",
  "thi-ap17:87.4": "yāva brahmanivesanaṃ. ",
  "thi-ap17:88.1": "sineruṃ daṇḍaṃ katvāna ",
  "thi-ap17:88.2": "chattaṃ katvā mahāmahiṃ ",
  "thi-ap17:88.3": "samūlaṃ parivattetvā ",
  "thi-ap17:88.4": "dhārayaṃ caṅkamī nabhe. ",
  "thi-ap17:89.1": "chassūrodayakālova ",
  "thi-ap17:89.2": "lokañcākāsi rucitaṃ ",
  "thi-ap17:89.3": "yugandhe viya taṃ lokaṃ jālamālāgulaṃ ",
  "thi-ap17:89.4": "akā. ",
  "thi-ap17:90.1": "muccalindaṃ mahāselaṃ ",
  "thi-ap17:90.2": "meruṃ mandāradaddare ",
  "thi-ap17:90.3": "sāsapāniva sabbāni ",
  "thi-ap17:90.4": "ekenaggaṇhi muṭṭhinā. ",
  "thi-ap17:91.1": "aṅgulaggena chādesi ",
  "thi-ap17:91.2": "bhākaraṃ sanisākaraṃ ",
  "thi-ap17:91.3": "candasuriyasahassāni ",
  "thi-ap17:91.4": "āveḷamiva dhārayi. ",
  "thi-ap17:92.1": "catusāgaratoyāni ",
  "thi-ap17:92.2": "dhārayi ekapāṇinā ",
  "thi-ap17:92.3": "yugandhajaladākāraṃ ",
  "thi-ap17:92.4": "mahāvassaṃ avassatha. ",
  "thi-ap17:93.1": "cakkavattiṃ saparisaṃ ",
  "thi-ap17:93.2": "māpayi sā nabhattale ",
  "thi-ap17:93.3": "garuḷaṃ dviradaṃ sīhaṃ ",
  "thi-ap17:93.4": "vinadantañca dassayi. ",
  "thi-ap17:94.1": "ekikā abhinimmitvā ",
  "thi-ap17:94.2": "appameyyaṃ bhikkhunīgaṇaṃ ",
  "thi-ap17:94.3": "puna antaradhāpetvā ",
  "thi-ap17:94.4": "ekikā munimabravi. ",
  "thi-ap17:95.1": "mātucchā te mahāvīra ",
  "thi-ap17:95.2": "tava sāsanakārikā ",
  "thi-ap17:95.3": "anuppattā sakaṃ atthaṃ ",
  "thi-ap17:95.4": "pāde vandāmi cakkhumā. ",
  "thi-ap17:96.1": "dassetvā vividhaṃ iddhiṃ ",
  "thi-ap17:96.2": "orohitvā nabhattalā ",
  "thi-ap17:96.3": "vanditvā lokapajjotaṃ ",
  "thi-ap17:96.4": "ekamantaṃ nisīdi sā. ",
  "thi-ap17:97.1": "sā vīsavassasatikā ",
  "thi-ap17:97.2": "jātiyāhaṃ mahāmuni ",
  "thi-ap17:97.3": "alaṃ ettāvatā vīra ",
  "thi-ap17:97.4": "nibbāyissāmi nāyaka. ",
  "thi-ap17:98.1": "tadātivimhitā sabbā ",
  "thi-ap17:98.2": "parisā sā katañjalī ",
  "thi-ap17:98.3": "avocayye kataṃ āsi ",
  "thi-ap17:98.4": "atuliddhi parakkame. ",
  "thi-ap17:99.1": "padumuttaro nāma jino ",
  "thi-ap17:99.2": "sabbadhammesu cakkhumā ",
  "thi-ap17:99.3": "ito satasahassamhi ",
  "thi-ap17:99.4": "kappe uppajji nāyako. ",
  "thi-ap17:100.1": "tadāhaṃ haṃsavatiyā ",
  "thi-ap17:100.2": "jātāmaccakule ahu ",
  "thi-ap17:100.3": "sabbopakārasampanne ",
  "thi-ap17:100.4": "iddhe phīte mahaddhane. ",
  "thi-ap17:101.1": "kadāci pitunā saddhiṃ ",
  "thi-ap17:101.2": "dāsīgaṇapurakkhatā ",
  "thi-ap17:101.3": "mahatā parivārena ",
  "thi-ap17:101.4": "taṃ upecca narāsabhaṃ. ",
  "thi-ap17:102.1": "vāsavaṃ viya vassantaṃ ",
  "thi-ap17:102.2": "dhammameghamanāsavaṃ ",
  "thi-ap17:102.3": "saradādiccasadisaṃ ",
  "thi-ap17:102.4": "raṃsimālākulaṃ jinaṃ. ",
  "thi-ap17:103.1": "disvā cittaṃ pasādetvā ",
  "thi-ap17:103.2": "sutvā cassa subhāsitaṃ ",
  "thi-ap17:103.3": "mātucchaṃ bhikkhuniṃ agge ",
  "thi-ap17:103.4": "ṭhapentaṃ naranāyakaṃ. ",
  "thi-ap17:104.1": "sutvā datvā mahādānaṃ ",
  "thi-ap17:104.2": "sattāhaṃ tassa tādino ",
  "thi-ap17:104.3": "sasaṅghassa naraggassa ",
  "thi-ap17:104.4": "paccayāni bahūni ca. ",
  "thi-ap17:105.1": "nipacca pādamūlamhi ",
  "thi-ap17:105.2": "taṃ ṭhānaṃ abhipatthayiṃ ",
  "thi-ap17:105.3": "tato mahāparisati ",
  "thi-ap17:105.4": "avoca isisattamo. ",
  "thi-ap17:106.1": "yā sasaṅghaṃ abhojesi ",
  "thi-ap17:106.2": "sattāhaṃ lokanāyakaṃ ",
  "thi-ap17:106.3": "tamahaṃ kittayissāmi ",
  "thi-ap17:106.4": "suṇātha mama bhāsato. ",
  "thi-ap17:107.1": "satasahasse ito kappe ",
  "thi-ap17:107.2": "okkākakulasambhavo ",
  "thi-ap17:107.3": "gotamo nāma nāmena ",
  "thi-ap17:107.4": "satthā loke bhavissati. ",
  "thi-ap17:108.1": "tassa dhammesu dāyādā ",
  "thi-ap17:108.2": "orasā dhammanimmitā ",
  "thi-ap17:108.3": "gotamī nāma nāmena ",
  "thi-ap17:108.4": "hessati satthusāvikā. ",
  "thi-ap17:109.1": "tassa buddhassa mātucchā ",
  "thi-ap17:109.2": "jīvitāpālikā ayaṃ ",
  "thi-ap17:109.3": "rattaññūnañca aggattaṃ ",
  "thi-ap17:109.4": "bhikkhunīnaṃ labhissati. ",
  "thi-ap17:110.1": "taṃ sutvāhaṃ pamuditā ",
  "thi-ap17:110.2": "yāvajīvaṃ tadā jinaṃ ",
  "thi-ap17:110.3": "paccayehi upaṭṭhitvā ",
  "thi-ap17:110.4": "tato kālaṃ katā ahaṃ. ",
  "thi-ap17:111.1": "tāvatiṃsesu devesu ",
  "thi-ap17:111.2": "sabbakāmasamiddhisu ",
  "thi-ap17:111.3": "nibbattā dasahaṅgehi ",
  "thi-ap17:111.4": "aññe abhibhaviṃ ahaṃ. ",
  "thi-ap17:112.1": "rūpasaddehi gandhehi ",
  "thi-ap17:112.2": "rasehi phussanehi ca ",
  "thi-ap17:112.3": "āyunāpica vaṇṇena ",
  "thi-ap17:112.4": "sukhena yasasāpica. ",
  "thi-ap17:113.1": "tathevādhipateyyena ",
  "thi-ap17:113.2": "adhigayha virocahaṃ ",
  "thi-ap17:113.3": "ahosiṃ amarindassa ",
  "thi-ap17:113.4": "mahesī dayitā tahiṃ. ",
  "thi-ap17:114.1": "saṃsāre saṃsarantīhaṃ ",
  "thi-ap17:114.2": "kammavāyusameritā ",
  "thi-ap17:114.3": "kāsikarañño visaye ",
  "thi-ap17:114.4": "ajāyiṃ dāsagāmake. ",
  "thi-ap17:115.1": "pañcadāsasatānūnā ",
  "thi-ap17:115.2": "nivasanti tahiṃ tadā ",
  "thi-ap17:115.3": "sabbesaṃ tattha yo jeṭṭho ",
  "thi-ap17:115.4": "tassa jāyā ahosahaṃ. ",
  "thi-ap17:116.1": "sayambhuno pañcasatā ",
  "thi-ap17:116.2": "gāmaṃ piṇḍāya pāvisuṃ ",
  "thi-ap17:116.3": "te disvāna ahaṃ tuṭṭhā ",
  "thi-ap17:116.4": "saha sabbehi ñātibhi. ",
  "thi-ap17:117.1": "katvā pañcasataṃ kuṭiṃ ",
  "thi-ap17:117.2": "cātumāse upaṭṭhiya ",
  "thi-ap17:117.3": "ticīvarāni datvāna ",
  "thi-ap17:117.4": "pasannamha sasāmikā. ",
  "thi-ap17:118.1": "tato cutā sapatikā tāvatiṃsaṃ ",
  "thi-ap17:118.2": "gatā mayaṃ ",
  "thi-ap17:118.3": "pacchime ca bhave dāni ",
  "thi-ap17:118.4": "jātā devadahe pure. ",
  "thi-ap17:119.1": "pitā añjanasakko me ",
  "thi-ap17:119.2": "mātā mama sulakkhaṇā ",
  "thi-ap17:119.3": "tato kapilavatthusmiṃ ",
  "thi-ap17:119.4": "suddhodanagharaṃ gatā. ",
  "thi-ap17:120.1": "sabbā sakyakule jātā ",
  "thi-ap17:120.2": "sakyānaṃ gharamāgamuṃ ",
  "thi-ap17:120.3": "ahaṃ seṭṭhā ca sabbāsaṃ ",
  "thi-ap17:120.4": "jinassāpādikā ahuṃ. ",
  "thi-ap17:121.1": "sa me puttobhinikkhamma ",
  "thi-ap17:121.2": "buddho āsi vināyako ",
  "thi-ap17:121.3": "pacchāhaṃ pabbajitvāna ",
  "thi-ap17:121.4": "satehi saha pañcahi. ",
  "thi-ap17:122.1": "sākiyānīhi vīrāhi ",
  "thi-ap17:122.2": "saha santisukhaṃ phusiṃ ",
  "thi-ap17:122.3": "ye tadā pubbajātiyā ",
  "thi-ap17:122.4": "asmākaṃ āsu sāmino. ",
  "thi-ap17:123.1": "saha puññassa kattāro ",
  "thi-ap17:123.2": "mahāsamayakārakā ",
  "thi-ap17:123.3": "phusiṃsu arahattante ",
  "thi-ap17:123.4": "sugatenānukampitā. ",
  "thi-ap17:124.1": "tadetarā bhikkhunīyo ",
  "thi-ap17:124.2": "ārūhiṃsu nabhattalaṃ ",
  "thi-ap17:124.3": "saṅgatā viya tārāyo ",
  "thi-ap17:124.4": "virociṃsu mahiddhikā. ",
  "thi-ap17:125.1": "iddhī anekā dassesuṃ ",
  "thi-ap17:125.2": "pilandhavikatiṃ yathā ",
  "thi-ap17:125.3": "kammāro kanakasseva ",
  "thi-ap17:125.4": "puññakammesu sikkhitā. ",
  "thi-ap17:126.1": "dassetvā pāṭiherāni ",
  "thi-ap17:126.2": "vividhāni bahūni ca ",
  "thi-ap17:126.3": "tosetvā vādiccavaraṃ ",
  "thi-ap17:126.4": "muniṃ saparisaṃ tadā. ",
  "thi-ap17:127.1": "orohitvā nabhatalā ",
  "thi-ap17:127.2": "vanditvā isisattamaṃ ",
  "thi-ap17:127.3": "anuññātā naraggena ",
  "thi-ap17:127.4": "yathāṭṭhāne nisīdisuṃ. ",
  "thi-ap17:128.1": "ahonukampikāmhākaṃ ",
  "thi-ap17:128.2": "sabbāsaṃ vīra gotamī ",
  "thi-ap17:128.3": "vāsitā tāya puññehi ",
  "thi-ap17:128.4": "pattā no āsavakkhayaṃ. ",
  "thi-ap17:129.1": "kilesā jhāpitāmhākaṃ ",
  "thi-ap17:129.2": "bhavā sabbe samūhatā ",
  "thi-ap17:129.3": "nāgīva bandhanaṃ chetvā ",
  "thi-ap17:129.4": "viharāma anāsavā. ",
  "thi-ap17:130.1": "svāgataṃ vata no āsi ",
  "thi-ap17:130.2": "buddhaseṭṭhassa santike ",
  "thi-ap17:130.3": "tisso vijjā anuppattā ",
  "thi-ap17:130.4": "kataṃ buddhassa sāsanaṃ. ",
  "thi-ap17:131.1": "paṭisambhidā catasso ",
  "thi-ap17:131.2": "vimokkhāpica aṭṭhime ",
  "thi-ap17:131.3": "chaḷabhiññā sacchikatā ",
  "thi-ap17:131.4": "kataṃ buddhassa sāsanaṃ. ",
  "thi-ap17:132.1": "iddhiyañca vasī homa ",
  "thi-ap17:132.2": "dibbāya sotadhātuyā ",
  "thi-ap17:132.3": "cetopariyañāṇassa ",
  "thi-ap17:132.4": "vasī homa mahāmuni. ",
  "thi-ap17:133.1": "pubbenivāsaṃ jānāma ",
  "thi-ap17:133.2": "dibbacakkhu visodhitaṃ ",
  "thi-ap17:133.3": "sabbāsavaparikkhīṇā ",
  "thi-ap17:133.4": "natthi dāni punabbhavo. ",
  "thi-ap17:134.1": "atthe dhamme ca nerutte ",
  "thi-ap17:134.2": "paṭibhāṇe ca vijjati ",
  "thi-ap17:134.3": "ñāṇaṃ amhaṃ mahāvīra ",
  "thi-ap17:134.4": "uppannaṃ tava santike. ",
  "thi-ap17:135.1": "asmāhi pariciṇṇosi ",
  "thi-ap17:135.2": "mettacittāhi nāyaka ",
  "thi-ap17:135.3": "anujānāhi sabbāyo ",
  "thi-ap17:135.4": "nibbānāya mahāmune. ",
  "thi-ap17:136.1": "nibbāyissāma iccevaṃ ",
  "thi-ap17:136.2": "kiṃ vakkhāmi vadantiyo ",
  "thi-ap17:136.3": "yassa dāni ca vo kālaṃ ",
  "thi-ap17:136.4": "maññathāti jinobravi. ",
  "thi-ap17:137.1": "gotamiādikā tāyo ",
  "thi-ap17:137.2": "tadā bhikkhuniyo jinaṃ ",
  "thi-ap17:137.3": "vanditvā āsanā tamhā ",
  "thi-ap17:137.4": "vuṭṭhāya agamiṃsu tā. ",
  "thi-ap17:138.1": "mahatā janakāyena ",
  "thi-ap17:138.2": "saha lokagganāyako ",
  "thi-ap17:138.3": "anusaṃsāvayi dhīro ",
  "thi-ap17:138.4": "mātucchaṃ yāva koṭṭhakaṃ. ",
  "thi-ap17:139.1": "tadā nipati pādesu ",
  "thi-ap17:139.2": "gotamī lokabandhuno ",
  "thi-ap17:139.3": "sahetarāhi sabbāhi ",
  "thi-ap17:139.4": "pacchimaṃ pādavandanaṃ. ",
  "thi-ap17:140.1": "idaṃ pacchimakaṃ mayhaṃ ",
  "thi-ap17:140.2": "lokanāthassa dassanaṃ ",
  "thi-ap17:140.3": "na puno amatākāraṃ ",
  "thi-ap17:140.4": "passissāmi mukhaṃ tava. ",
  "thi-ap17:141.1": "na ca me vandanaṃ vīra ",
  "thi-ap17:141.2": "tava pāde sukomale ",
  "thi-ap17:141.3": "samphusissati lokagga ",
  "thi-ap17:141.4": "ajja gacchāmi nibbutiṃ. ",
  "thi-ap17:142.1": "rūpena kintavānena ",
  "thi-ap17:142.2": "diṭṭhe dhamme yathātathe ",
  "thi-ap17:142.3": "sabbaṃ saṅkhatamevetaṃ ",
  "thi-ap17:142.4": "anassāsikamittaraṃ. ",
  "thi-ap17:143.1": "sā saha tāhi gantvāna ",
  "thi-ap17:143.2": "bhikkhunūpassayaṃ sakaṃ ",
  "thi-ap17:143.3": "aḍḍhapallaṅkamābhujja ",
  "thi-ap17:143.4": "nisīdi paramāsane. ",
  "thi-ap17:144.1": "tadā upāsikā tattha ",
  "thi-ap17:144.2": "buddhasāsanavacchalā ",
  "thi-ap17:144.3": "tassā pavattiṃ sutvāna ",
  "thi-ap17:144.4": "upesuṃ pādavandikā. ",
  "thi-ap17:145.1": "karehi uraṃ pahantā ",
  "thi-ap17:145.2": "chinnamūlā yathā latā ",
  "thi-ap17:145.3": "rudantā karuṇaṃ rāvaṃ ",
  "thi-ap17:145.4": "sokaṭṭā bhūmipātikā. ",
  "thi-ap17:146.1": "mā no saraṇade nāthe ",
  "thi-ap17:146.2": "vihāyāgami nibbutiṃ ",
  "thi-ap17:146.3": "nipatitvāna yācāma ",
  "thi-ap17:146.4": "sabbāyo sirasā mayaṃ. ",
  "thi-ap17:147.1": "yā padhānaṃ gamā tāsaṃ ",
  "thi-ap17:147.2": "saddhā paññā upāsikā ",
  "thi-ap17:147.3": "tassā sīsaṃ pamajjantī ",
  "thi-ap17:147.4": "idaṃ vacanamabravi. ",
  "thi-ap17:148.1": "alaṃ puttā vilāpena ",
  "thi-ap17:148.2": "mārapāsānuvattinā ",
  "thi-ap17:148.3": "aniccaṃ saṅkhataṃ sabbaṃ ",
  "thi-ap17:148.4": "viyogantaṃ calācalaṃ. ",
  "thi-ap17:149.1": "tato sā tā visajjitvā ",
  "thi-ap17:149.2": "paṭhamajjhānamuttamaṃ ",
  "thi-ap17:149.3": "dutiyañca tatiyañca ",
  "thi-ap17:149.4": "samāpajji catutthakaṃ. ",
  "thi-ap17:150.1": "ākāsāyatanañceva ",
  "thi-ap17:150.2": "viññāṇañcāyatanaṃ tathā ",
  "thi-ap17:150.3": "ākiñcaṃ nevasaññañca ",
  "thi-ap17:150.4": "samāpajji yathākkamaṃ. ",
  "thi-ap17:151.1": "paṭilomena jhānāni ",
  "thi-ap17:151.2": "samāpajjatha gotamī ",
  "thi-ap17:151.3": "yāvatā paṭhamaṃ jhānaṃ ",
  "thi-ap17:151.4": "tayo yāva catutthakaṃ. ",
  "thi-ap17:152.1": "tato vuṭṭhāya nibbāyi ",
  "thi-ap17:152.2": "dīpaccīva nirāsavā ",
  "thi-ap17:152.3": "bhūmicālo mahā āsi ",
  "thi-ap17:152.4": "nabhasā vijjutā pati. ",
  "thi-ap17:153.1": "panāditā dundubhiyo ",
  "thi-ap17:153.2": "parideviṃsu devatā ",
  "thi-ap17:153.3": "pupphavuṭṭhi ca gaganā ",
  "thi-ap17:153.4": "abhivassatha medaniṃ. ",
  "thi-ap17:154.1": "kampito merurājāpi ",
  "thi-ap17:154.2": "raṅgamajjhe yathā naṭo ",
  "thi-ap17:154.3": "sokena vātidīno ca ",
  "thi-ap17:154.4": "viravo āsi sāgaro. ",
  "thi-ap17:155.1": "devā nāgāsurā brahmā ",
  "thi-ap17:155.2": "saṃviggāhaṃsu taṃkhaṇe ",
  "thi-ap17:155.3": "aniccā vata saṅkhārā ",
  "thi-ap17:155.4": "yathāyaṃ vilayaṃ gatā. ",
  "thi-ap17:156.1": "yā cemaṃ parivāriṃsu ",
  "thi-ap17:156.2": "satthusāsanakārikā ",
  "thi-ap17:156.3": "tāyopi anupādānā ",
  "thi-ap17:156.4": "dīpasikhā viya nibbutā. ",
  "thi-ap17:157.1": "hā yogā vippayogantā ",
  "thi-ap17:157.2": "hāniccaṃ sabbasaṅkhataṃ ",
  "thi-ap17:157.3": "hā jīvitaṃ vināsantaṃ ",
  "thi-ap17:157.4": "iccāsi paridevanā. ",
  "thi-ap17:158.1": "tato devā ca brahmā ca ",
  "thi-ap17:158.2": "lokadhammānuvattanaṃ ",
  "thi-ap17:158.3": "kālānurūpaṃ kubbanti ",
  "thi-ap17:158.4": "upetvā isisattamaṃ. ",
  "thi-ap17:159.1": "tadā āmantayi satthā ",
  "thi-ap17:159.2": "ānandaṃ sutisāgaraṃ ",
  "thi-ap17:159.3": "gacchānanda nivedehi ",
  "thi-ap17:159.4": "bhikkhūnaṃ mātu nibbutiṃ. ",
  "thi-ap17:160.1": "tadānando nirānando ",
  "thi-ap17:160.2": "assunā puṇṇalocano ",
  "thi-ap17:160.3": "gaggarena sarenāha ",
  "thi-ap17:160.4": "samāgacchantu bhikkhavo. ",
  "thi-ap17:161.1": "pubbadikkhiṇapacchāsu ",
  "thi-ap17:161.2": "uttarāya vasanti ",
  "thi-ap17:161.3": "ye mayhaṃ sā bhikkhunī mātā ",
  "thi-ap17:161.4": "bhikkhavo sugatorasā. ",
  "thi-ap17:162.1": "yā vaddhayi payattena ",
  "thi-ap17:162.2": "sarīraṃ pacchimaṃ mune ",
  "thi-ap17:162.3": "sā gotamī gatā santiṃ ",
  "thi-ap17:162.4": "tārāva suriyodaye. ",
  "thi-ap17:163.1": "buddhamātāti saññattiṃ ",
  "thi-ap17:163.2": "ṭhapayitvā gatā samaṃ ",
  "thi-ap17:163.3": "na yattha pañcanettopi ",
  "thi-ap17:163.4": "tattha dakkhati nāyako. ",
  "thi-ap17:164.1": "yassatthi sugate saddhā ",
  "thi-ap17:164.2": "yo vā sisso mahāmune ",
  "thi-ap17:164.3": "buddhassa mātu sakkāraṃ ",
  "thi-ap17:164.4": "karotu sugatoraso. ",
  "thi-ap17:165.1": "sudūraṭṭhāpi taṃ sutvā ",
  "thi-ap17:165.2": "sīghamāgaccha bhikkhavo ",
  "thi-ap17:165.3": "keci buddhānubhāvena ",
  "thi-ap17:165.4": "keci iddhīsu kovidā. ",
  "thi-ap17:166.1": "kūṭāgāravare ramme ",
  "thi-ap17:166.2": "sabbasoṇṇamaye subhe ",
  "thi-ap17:166.3": "mañcakaṃ samaropesuṃ ",
  "thi-ap17:166.4": "yattha suttāsi gotamī. ",
  "thi-ap17:167.1": "cattāro lokapālā ye ",
  "thi-ap17:167.2": "aṃsehi samadhārayuṃ ",
  "thi-ap17:167.3": "sesā sakkādikā devā ",
  "thi-ap17:167.4": "kūṭāgāre samaggahuṃ. ",
  "thi-ap17:168.1": "kūṭāgārāni sabbāni ",
  "thi-ap17:168.2": "āsuṃ pañcasatāni hi ",
  "thi-ap17:168.3": "saradādiccavaṇṇāni ",
  "thi-ap17:168.4": "visukammakatāni hi. ",
  "thi-ap17:169.1": "sabbā tahiṃ bhikkhuniyo ",
  "thi-ap17:169.2": "āsuṃ mañcesu sāyitā ",
  "thi-ap17:169.3": "devānaṃ khandhamāruyha ",
  "thi-ap17:169.4": "niyyanti anupubbaso. ",
  "thi-ap17:170.1": "sabbaso chāditaṃ āsi ",
  "thi-ap17:170.2": "vitānena nabhattalaṃ ",
  "thi-ap17:170.3": "satārā candasurā ca ",
  "thi-ap17:170.4": "lañchitā kanakāmayā. ",
  "thi-ap17:171.1": "paṭākā ussitānekā ",
  "thi-ap17:171.2": "cittakā pupphakañcukā ",
  "thi-ap17:171.3": "obhaggākāsapadumā ",
  "thi-ap17:171.4": "mahiyā pupphamuggataṃ. ",
  "thi-ap17:172.1": "dissanti candasuriyā ",
  "thi-ap17:172.2": "vijjalanti ca tārakā ",
  "thi-ap17:172.3": "majjhaṅgatopicādicco ",
  "thi-ap17:172.4": "na tāpesi sasī yathā. ",
  "thi-ap17:173.1": "devā dibbehi gandhehi ",
  "thi-ap17:173.2": "mālehi surabhīhi ca ",
  "thi-ap17:173.3": "vāditehi ca naccehi ",
  "thi-ap17:173.4": "saṅgītīhi ca pūjayuṃ. ",
  "thi-ap17:174.1": "nāgāsūrā ca brahmāno ",
  "thi-ap17:174.2": "yathāsatti yathābalaṃ ",
  "thi-ap17:174.3": "pūjayiṃsu viniyyanti ",
  "thi-ap17:174.4": "nibbutaṃ buddhamātaraṃ. ",
  "thi-ap17:175.1": "sabbāyo purato nītā ",
  "thi-ap17:175.2": "nibbutā sugatorasā ",
  "thi-ap17:175.3": "gotamī niyyate pacchā ",
  "thi-ap17:175.4": "sakkatā buddhaposikā. ",
  "thi-ap17:176.1": "purato devamanujā ",
  "thi-ap17:176.2": "sanāgāsūrabrahmakā ",
  "thi-ap17:176.3": "pacchā sasāvako buddho ",
  "thi-ap17:176.4": "pūjatthaṃ yāti mātuyā. ",
  "thi-ap17:177.1": "buddhassa parinibbānaṃ ",
  "thi-ap17:177.2": "nedisaṃ āsi yādisaṃ ",
  "thi-ap17:177.3": "gotamīparinibbānaṃ ",
  "thi-ap17:177.4": "atiacchariyaṃ ahu. na ",
  "thi-ap17:178.1": "buddho buddhanibbāne sārīputtādi ",
  "thi-ap17:178.2": "bhikkhavo ",
  "thi-ap17:178.3": "buddho gotaminibbāne ",
  "thi-ap17:178.4": "sārīputtādikā yathā. ",
  "thi-ap17:179.1": "citakāni karitvāna ",
  "thi-ap17:179.2": "sabbagandhamayāni ca ",
  "thi-ap17:179.3": "gandhacuṇṇavikiṇṇāni ",
  "thi-ap17:179.4": "jhāpayiṃsu ca tā tahiṃ. ",
  "thi-ap17:180.1": "sesabhāgāni ḍayhiṃsu ",
  "thi-ap17:180.2": "aṭṭhisesāni sabbaso ",
  "thi-ap17:180.3": "ādando ca tadāvoca ",
  "thi-ap17:180.4": "saṃvegajanakaṃ vaco. ",
  "thi-ap17:181.1": "gotamī nidhanaṃ yātā ",
  "thi-ap17:181.2": "daḍḍhañcassā sarīrakaṃ ",
  "thi-ap17:181.3": "saṅketaṃ buddhanibbānaṃ ",
  "thi-ap17:181.4": "na cirena bhavissati. ",
  "thi-ap17:182.1": "tato gotamidhātūni ",
  "thi-ap17:182.2": "tassā pattagatāni so ",
  "thi-ap17:182.3": "upanāmesi nāthassa ",
  "thi-ap17:182.4": "ānando buddhacodito. ",
  "thi-ap17:183.1": "pāṇinā tāni paggayha ",
  "thi-ap17:183.2": "avoca isisattamo ",
  "thi-ap17:183.3": "mahato sāravantassa ",
  "thi-ap17:183.4": "yathā rukkhassa tiṭṭhato. ",
  "thi-ap17:184.1": "yo so mahattaro khandho ",
  "thi-ap17:184.2": "palujjeyya aniccatā ",
  "thi-ap17:184.3": "tathā bhikkhunisaṅghassa ",
  "thi-ap17:184.4": "gotamī parinibbutā. ",
  "thi-ap17:185.1": "ānanda passa buddhassa ",
  "thi-ap17:185.2": "nibbutāyapi mātuyā ",
  "thi-ap17:185.3": "sarīramattasesāya ",
  "thi-ap17:185.4": "na sokaparidevanā. ",
  "thi-ap17:186.1": "na sociyā paresaṃ sā ",
  "thi-ap17:186.2": "tiṇṇasaṃsārasāgarā ",
  "thi-ap17:186.3": "parivajjitasantāpā ",
  "thi-ap17:186.4": "sītibhūtā sunibbutā. ",
  "thi-ap17:187.1": "paṇḍitāsi mahāpaññā ",
  "thi-ap17:187.2": "puthupaññā tatheva ca ",
  "thi-ap17:187.3": "rattaññū bhikkhunīnaṃ sā ",
  "thi-ap17:187.4": "evaṃ viññātha bhikkhavo. ",
  "thi-ap17:188.1": "iddhiyā ca vasī āsi ",
  "thi-ap17:188.2": "dibbāya sotadhātuyā ",
  "thi-ap17:188.3": "cetopariyañāṇassa ",
  "thi-ap17:188.4": "vasī āsi ca gotamī. ",
  "thi-ap17:189.1": "pubbenivāsamaññāsi ",
  "thi-ap17:189.2": "dibbacakkhu visodhitaṃ ",
  "thi-ap17:189.3": "sabbāsavā parikkhīṇā ",
  "thi-ap17:189.4": "natthi dāni punabbhavo. ",
  "thi-ap17:190.1": "atthadhammaniruttīsu ",
  "thi-ap17:190.2": "paṭibhāṇe tatheva ca ",
  "thi-ap17:190.3": "parisuddhaṃ ahu ñāṇaṃ ",
  "thi-ap17:190.4": "tasmā socaniyā na sā. ",
  "thi-ap17:191.1": "ayoghanahatasseva ",
  "thi-ap17:191.2": "jalato jātavedaso ",
  "thi-ap17:191.3": "anupubbūpasantassa ",
  "thi-ap17:191.4": "yathā na ñāyate gati. ",
  "thi-ap17:192.1": "evaṃ sammāvimuttānaṃ ",
  "thi-ap17:192.2": "kāmabandhoghatārinaṃ ",
  "thi-ap17:192.3": "paññāpātuṃ gati natthi ",
  "thi-ap17:192.4": "pattānaṃ acalaṃ padaṃ. ",
  "thi-ap17:193.1": "attadīpā tato hotha ",
  "thi-ap17:193.2": "satipaṭṭhānagocarā ",
  "thi-ap17:193.3": "bhāvetvā sattabojjhaṅgaṃ ",
  "thi-ap17:193.4": "dukkhasantaṃ ",
  "thi-ap17:194.1": "karissathāti. itthaṃ sudaṃ āyasmā mahāpajāpatigotamī bhikkhunī imā gāthāyo abhāsitthāti. ",
  "thi-ap17:195.1": "mahāpajāpatigotamītheriyā apadānaṃ samattaṃ. aṭṭhamaṃ khemātheriyāpadānaṃ (18) "
}
