{
  "thi-ap1:0.1": "",
  "thi-ap1:0.2": "",
  "thi-ap1:0.3": "",
  "thi-ap1:1.1": "",
  "thi-ap1:2.1": "atha therikāpadānāni suṇātha ",
  "thi-ap1:3.1": "bhagavati konāgamane ",
  "thi-ap1:3.2": "saṅghārāmamhi nivesamhi ",
  "thi-ap1:3.3": "sakhiyo tisso janiyo ",
  "thi-ap1:3.4": "vihāradānaṃ adamhase. ",
  "thi-ap1:4.1": "dasakkhattuṃ satakkhattuṃ ",
  "thi-ap1:4.2": "satānaṃ ca satakkhattuṃ ",
  "thi-ap1:4.3": "devesu upapajjimha ",
  "thi-ap1:4.4": "ko vādo mānuse bhave. ",
  "thi-ap1:5.1": "devesu mahiddhikā hutvā ",
  "thi-ap1:5.2": "mānusakamhi ko vādo ",
  "thi-ap1:5.3": "sattaratanassa mahesī ",
  "thi-ap1:5.4": "itthīratanaṃ ahaṃ bhaviṃ. ",
  "thi-ap1:6.1": "tattha sañcitaṃ kusalaṃ ",
  "thi-ap1:6.2": "susamiddhakulappajā ",
  "thi-ap1:6.3": "dhanañjānī ca khemā ca ",
  "thi-ap1:6.4": "ahaṃpica tayo janā. ",
  "thi-ap1:7.1": "ārāmaṃ sukataṃ katvā ",
  "thi-ap1:7.2": "sabbāvayavamaṇḍitaṃ ",
  "thi-ap1:7.3": "buddhappamukhasaṅghassa ",
  "thi-ap1:7.4": "niyyādetvā pamoditā. ",
  "thi-ap1:8.1": "yattha yatthūpapajjāmi ",
  "thi-ap1:8.2": "tassa kammassa vāhasā ",
  "thi-ap1:8.3": "devesu aggataṃ pattā ",
  "thi-ap1:8.4": "manussesu tatheva ca. ",
  "thi-ap1:9.1": "imasmiṃyeva kappasmiṃ ",
  "thi-ap1:9.2": "brahmabandhu mahāyaso ",
  "thi-ap1:9.3": "kassapo nāma nāmena ",
  "thi-ap1:9.4": "uppajji vadataṃ varo. ",
  "thi-ap1:10.1": "upaṭṭhāko mahesissa ",
  "thi-ap1:10.2": "tadā āsi narissaro ",
  "thi-ap1:10.3": "kāsirājā kikī nāma ",
  "thi-ap1:10.4": "bārāṇasīpuruttame. ",
  "thi-ap1:11.1": "tassāsuṃ satta dhītaro ",
  "thi-ap1:11.2": "rājakaññā sukhe ṭhitā ",
  "thi-ap1:11.3": "buddhupaṭṭhānaniratā ",
  "thi-ap1:11.4": "brahmacariyaṃ cariṃsu tā. ",
  "thi-ap1:12.1": "tāsaṃ sahāyikā hutvā ",
  "thi-ap1:12.2": "sīlesu susamāhitā ",
  "thi-ap1:12.3": "datvā dānāni sakkaccaṃ ",
  "thi-ap1:12.4": "agāreva vattaṃ cariṃ. ",
  "thi-ap1:13.1": "tena kammena sukatena ",
  "thi-ap1:13.2": "cetanāpaṇidhīhi ca ",
  "thi-ap1:13.3": "jahitvā mānusaṃ dehaṃ ",
  "thi-ap1:13.4": "tāvatiṃsūpagā ahaṃ. ",
  "thi-ap1:14.1": "tato cutā yāmāsaggaṃ ",
  "thi-ap1:14.2": "tatohaṃ tusitaṃ gatā ",
  "thi-ap1:14.3": "tato ca nimmānaratiṃ ",
  "thi-ap1:14.4": "vasavattipuraṃ gatā. ",
  "thi-ap1:15.1": "yattha yatthūpapajjāmi ",
  "thi-ap1:15.2": "puññakammasamāhitā ",
  "thi-ap1:15.3": "tattha tattheva rājūnaṃ ",
  "thi-ap1:15.4": "mahesittamakārayiṃ. ",
  "thi-ap1:16.1": "tato cutā manussatte ",
  "thi-ap1:16.2": "rājūnaṃ cakkavattinaṃ ",
  "thi-ap1:16.3": "maṇḍalīnañca rājūnaṃ ",
  "thi-ap1:16.4": "mahesittamakārayiṃ. ",
  "thi-ap1:17.1": "sampattiṃ anubhotvāna ",
  "thi-ap1:17.2": "devesu mānusesu ca ",
  "thi-ap1:17.3": "sabbattha sukhitā hutvā ",
  "thi-ap1:17.4": "nekajātīsu saṃsariṃ. ",
  "thi-ap1:18.1": "so hetu ca so pabhavo ",
  "thi-ap1:18.2": "taṃ mūlaṃ sāsane khamaṃ taṃ ",
  "thi-ap1:18.3": "paṭhamaṃ samodhānaṃ ",
  "thi-ap1:18.4": "taṃ dhammaratāya nibbutaṃ. ",
  "thi-ap1:19.1": "kilesā jhāpitā mayhaṃ ",
  "thi-ap1:19.2": "bhavā sabbe samūhatā ",
  "thi-ap1:19.3": "nāgīva bandhanaṃ chetvā ",
  "thi-ap1:19.4": "viharāmi anāsavā. ",
  "thi-ap1:20.1": "svāgataṃ vata me āsi ",
  "thi-ap1:20.2": "buddhaseṭṭhassa santike ",
  "thi-ap1:20.3": "tisso vijjā anuppattā ",
  "thi-ap1:20.4": "kataṃ buddhassa sāsanaṃ. ",
  "thi-ap1:21.1": "paṭisambhidā catasso ",
  "thi-ap1:21.2": "vimokkhāpica aṭṭhime ",
  "thi-ap1:21.3": "chaḷabhiññā sacchikatā ",
  "thi-ap1:21.4": "kataṃ buddhassa sāsananti. ",
  "thi-ap1:22.1": "itthaṃ sudaṃ āyasmā sumedhā bhikkhunī imā gāthāyo abhāsitthāti. ",
  "thi-ap1:23.1": "sumedhātheriyā apadānaṃ samattaṃ. dutiyaṃ mekhaladāyikātheriyāpadānaṃ (2) "
}
