{
  "thi-ap10:0.1": "",
  "thi-ap10:0.2": "",
  "thi-ap10:0.3": "",
  "thi-ap10:1.1": "nagare bandhumatiyā ",
  "thi-ap10:1.2": "āsiṃ udakahārikā ",
  "thi-ap10:1.3": "udahārena jīvāmi ",
  "thi-ap10:1.4": "tena posemi dārake. ",
  "thi-ap10:2.1": "deyyadhammo ca me natthi ",
  "thi-ap10:2.2": "puññakkhette anuttare ",
  "thi-ap10:2.3": "koṭṭhakaṃ upasaṅkamma ",
  "thi-ap10:2.4": "udakaṃ paṭṭhapesahaṃ. ",
  "thi-ap10:3.1": "tena kammena sukatena ",
  "thi-ap10:3.2": "tāvatiṃsaṃ agañchahaṃ ",
  "thi-ap10:3.3": "tattha me sukataṃ byamhaṃ ",
  "thi-ap10:3.4": "udahārena nimmitaṃ. ",
  "thi-ap10:4.1": "accharānaṃ sahassassa ",
  "thi-ap10:4.2": "ahaṃ hi pavarā tadā ",
  "thi-ap10:4.3": "dasaṭṭhānehi tā sabbā ",
  "thi-ap10:4.4": "abhibhomi tadā ahaṃ. ",
  "thi-ap10:5.1": "paññāsaṃ devarājūnaṃ ",
  "thi-ap10:5.2": "mahesittamakārayiṃ ",
  "thi-ap10:5.3": "vīsaticakkavattīnaṃ ",
  "thi-ap10:5.4": "mahesittamakārayiṃ. ",
  "thi-ap10:6.1": "duve bhave saṃsarāmi ",
  "thi-ap10:6.2": "devatte atha mānuse ",
  "thi-ap10:6.3": "duggatiṃ nābhijānāmi ",
  "thi-ap10:6.4": "udakadānassidaṃ phalaṃ. ",
  "thi-ap10:7.1": "pabbatagge dumagge vā ",
  "thi-ap10:7.2": "antalikkhe ca bhūmiyaṃ ",
  "thi-ap10:7.3": "yadā udakamicchāmi ",
  "thi-ap10:7.4": "khippaṃ paṭilabhāmahaṃ. ",
  "thi-ap10:8.1": "avuṭṭhikā disā atthi ",
  "thi-ap10:8.2": "santattā khuppitā hi me ",
  "thi-ap10:8.3": "mama saṅkappamaññāya ",
  "thi-ap10:8.4": "mahāmegho pavassati. ",
  "thi-ap10:9.1": "kadāci nīyamānāya ",
  "thi-ap10:9.2": "ñātisaṅghena me tadā ",
  "thi-ap10:9.3": "yadā icchāmahaṃ vassaṃ ",
  "thi-ap10:9.4": "mahāmegho ajāyatha. ",
  "thi-ap10:10.1": "uṇhaṃ vā pariḷāho vā ",
  "thi-ap10:10.2": "sarīre me na vijjati ",
  "thi-ap10:10.3": "kāye ca me rajo natthi ",
  "thi-ap10:10.4": "udakadānassidaṃ phalaṃ. ",
  "thi-ap10:11.1": "visuddhamanasā ajja ",
  "thi-ap10:11.2": "apetamanapāpikā ",
  "thi-ap10:11.3": "sabbāsavaparikkhīṇā ",
  "thi-ap10:11.4": "natthi dāni punabbhavo. ",
  "thi-ap10:12.1": "ekanavute ito kappe ",
  "thi-ap10:12.2": "yaṃ kammamakariṃ tadā ",
  "thi-ap10:12.3": "duggatiṃ nābhijānāmi ",
  "thi-ap10:12.4": "udakadānassidaṃ phalaṃ. ",
  "thi-ap10:13.1": "kilesā jhāpitā mayhaṃ ",
  "thi-ap10:13.2": "bhavā sabbe samūhatā nāgīva bandhanaṃ chetvā ",
  "thi-ap10:13.3": "viharāmi anāsavā. ",
  "thi-ap10:14.1": "svāgataṃ vata me āsi ",
  "thi-ap10:14.2": "buddhaseṭṭhassa santike tisso vijjā anuppattā ",
  "thi-ap10:14.3": "kataṃ buddhassa sāsanaṃ. ",
  "thi-ap10:15.1": "paṭisambhidā catasso ",
  "thi-ap10:15.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "thi-ap10:15.3": "kataṃ buddhassa sāsananti. ",
  "thi-ap10:16.1": "itthaṃ sudaṃ āyasmā udakadāyikā bhikkhunī imā gāthāyo abhāsitthāti. ",
  "thi-ap10:17.1": "udakadāyikātheriyā apadānaṃ samattaṃ. uddānaṃ sumedhā mekhaladadā maṇḍapasaṅkamantathā naḷamālinī piṇḍadadā kaṭacchuuppalappadā. dīpaudakadāyī ca gāthāyo gaṇitāviha ekagāthā satañceva sattarasaṃ taduttari. ",
  "thi-ap10:18.1": "sumedhāvaggo paṭhamo. ",
