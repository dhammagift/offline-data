{
  "thi-ap4:0.1": "",
  "thi-ap4:0.2": "",
  "thi-ap4:0.3": "",
  "thi-ap4:1.1": "koṇḍaññassa bhagavato ",
  "thi-ap4:1.2": "lokajeṭṭhassa tādino ",
  "thi-ap4:1.3": "rathiyaṃ paṭipannassa ",
  "thi-ap4:1.4": "tārayantassa pāṇino. ",
  "thi-ap4:2.1": "gharato nikkhamitvāna ",
  "thi-ap4:2.2": "avakujja nipajjahaṃ ",
  "thi-ap4:2.3": "anukampako lokajeṭṭho ",
  "thi-ap4:2.4": "sirasi akkami tadā. ",
  "thi-ap4:3.1": "akkamitvāna sirasi ",
  "thi-ap4:3.2": "agamā lokanāyako ",
  "thi-ap4:3.3": "tena cittappasādena ",
  "thi-ap4:3.4": "tusitaṃ agamāsahaṃ. ",
  "thi-ap4:4.1": "kilesā jhāpitā mayhaṃ ",
  "thi-ap4:4.2": "bhavā sabbe samūhatā nāgīva bandhanaṃ chetvā ",
  "thi-ap4:4.3": "viharāmi anāsavā. ",
  "thi-ap4:5.1": "svāgataṃ vata me āsi ",
  "thi-ap4:5.2": "buddhaseṭṭhassa santike tisso vijjā anuppattā ",
  "thi-ap4:5.3": "kataṃ buddhassa sāsanaṃ. ",
  "thi-ap4:6.1": "paṭisambhidā catasso ",
  "thi-ap4:6.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "thi-ap4:6.3": "kataṃ buddhassa sāsananti. ",
  "thi-ap4:7.1": "itthaṃ sudaṃ āyasmā saṅkamanadā bhikkhunī imā gāthāyo abhāsitthāti. ",
  "thi-ap4:8.1": "saṅkamanadātheriyā apadānaṃ samattaṃ. pañcamaṃ naḷamālikātheriyāpadānaṃ (5) "
}
