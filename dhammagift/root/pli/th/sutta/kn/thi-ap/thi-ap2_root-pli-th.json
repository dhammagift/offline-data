{
  "thi-ap2:0.1": "",
  "thi-ap2:0.2": "",
  "thi-ap2:0.3": "",
  "thi-ap2:1.1": "siddhatthassa bhagavato ",
  "thi-ap2:1.2": "thūpakāramakāsahaṃ ",
  "thi-ap2:1.3": "mekhalikā mayā dinnā ",
  "thi-ap2:1.4": "navakammassa satthuno. ",
  "thi-ap2:2.1": "niṭṭhite ca mahāthūpe ",
  "thi-ap2:2.2": "mekhalaṃ punadāsahaṃ ",
  "thi-ap2:2.3": "lokanāthassa munino ",
  "thi-ap2:2.4": "pasannā sehi pāṇibhi. ",
  "thi-ap2:3.1": "catunavute ito kappe ",
  "thi-ap2:3.2": "mekhalaṃ adadiṃ tadā ",
  "thi-ap2:3.3": "duggatiṃ nābhijānāmi ",
  "thi-ap2:3.4": "thūpakārassidaṃ phalaṃ. ",
  "thi-ap2:4.1": "kilesā jhāpitā mayhaṃ ",
  "thi-ap2:4.2": "bhavā sabbe samūhatā nāgīva bandhanaṃ chetvā ",
  "thi-ap2:4.3": "viharāmi anāsavā. ",
  "thi-ap2:5.1": "svāgataṃ vata me āsi ",
  "thi-ap2:5.2": "buddhaseṭṭhassa santike tisso vijjā anuppattā ",
  "thi-ap2:5.3": "kataṃ buddhassa sāsanaṃ. ",
  "thi-ap2:6.1": "paṭisambhidā catasso ",
  "thi-ap2:6.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "thi-ap2:6.3": "kataṃ buddhassa sāsananti. ",
  "thi-ap2:7.1": "itthaṃ sudaṃ āyasmā mekhaladāyikā bhikkhunī imā gāthāyo abhāsitthāti. ",
  "thi-ap2:8.1": "mekhaladāyikātheriyā apadānaṃ samattaṃ. tatiyaṃ maṇḍapadāyikātheriyāpadānaṃ (3) "
}
