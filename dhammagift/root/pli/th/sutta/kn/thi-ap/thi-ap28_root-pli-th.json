  "thi-ap28:76.2": "mahārāja suṇohi me ",
  "thi-ap28:76.3": "cattāḷīsakoṭisatā ",
  "thi-ap28:76.4": "pañcakoṭisatāni ca. ",
  "thi-ap28:77.1": "etesaṃ devadevānaṃ ",
  "thi-ap28:77.2": "mahādānaṃ pavattayiṃ ",
  "thi-ap28:77.3": "adhikāraṃ mahā mayhaṃ ",
  "thi-ap28:77.4": "mahārāja suṇohi me. ",
  "thi-ap28:78.1": "saṭṭhikoṭisatā buddhā ",
  "thi-ap28:78.2": "sattatikoṭisatāni ca ",
  "thi-ap28:78.3": "etesaṃ devadevānaṃ ",
  "thi-ap28:78.4": "mahādānaṃ pavattayiṃ. ",
  "thi-ap28:79.1": "adhikāraṃ mahā mayhaṃ ",
  "thi-ap28:79.2": "mahārāja suṇohi me ",
  "thi-ap28:79.3": "asītikoṭisatā buddhā ",
  "thi-ap28:79.4": "navutikoṭisatāni ca. ",
  "thi-ap28:80.1": "etesaṃ devadevānaṃ ",
  "thi-ap28:80.2": "mahādānaṃ pavattayiṃ ",
  "thi-ap28:80.3": "adhikāraṃ mahā mayhaṃ ",
  "thi-ap28:80.4": "mahārāja suṇohi me. ",
  "thi-ap28:81.1": "koṭisatasahassāni ",
  "thi-ap28:81.2": "honti lokagganāyakā ",
  "thi-ap28:81.3": "etesaṃ devadevānaṃ ",
  "thi-ap28:81.4": "mahādānaṃ pavattayiṃ. ",
  "thi-ap28:82.1": "adhikāraṃ mahā mayhaṃ ",
  "thi-ap28:82.2": "mahārāja suṇohi me ",
  "thi-ap28:82.3": "navakoṭisahassāni ",
  "thi-ap28:82.4": "apare lokanāyakā. ",
  "thi-ap28:83.1": "etesaṃ devadevānaṃ ",
  "thi-ap28:83.2": "mahādānaṃ pavattayiṃ ",
  "thi-ap28:83.3": "adhikāraṃ mahā mayhaṃ ",
  "thi-ap28:83.4": "mahārāja suṇohi me. ",
  "thi-ap28:84.1": "koṭisatasahassāni ",
  "thi-ap28:84.2": "pañcāsīti mahesinaṃ ",
  "thi-ap28:84.3": "pañcāsītikoṭisatā ",
  "thi-ap28:84.4": "sattavīsati koṭiyo. ",
  "thi-ap28:85.1": "etesaṃ devadevānaṃ ",
  "thi-ap28:85.2": "mahādānaṃ pavattayiṃ ",
  "thi-ap28:85.3": "adhikāraṃ mahā mayhaṃ ",
  "thi-ap28:85.4": "mahārāja suṇohi me. ",
  "thi-ap28:86.1": "paccekabuddhā vītarāgā ",
  "thi-ap28:86.2": "aṭṭhamatthakakoṭiyo ",
  "thi-ap28:86.3": "adhakāraṃ mahā mayhaṃ ",
  "thi-ap28:86.4": "mahārāja suṇohi me. ",
  "thi-ap28:87.1": "khīṇāsavā vītamalā ",
  "thi-ap28:87.2": "asaṅkheyyā buddhasāvakā ",
  "thi-ap28:87.3": "adhikāraṃ mahā mayhaṃ ",
  "thi-ap28:87.4": "mahārāja suṇohi me. ",
  "thi-ap28:88.1": "evaṃ dhammesu ciṇṇānaṃ ",
  "thi-ap28:88.2": "sadā saddhammacārino ",
  "thi-ap28:88.3": "dhammacārī sukhaṃ seti ",
  "thi-ap28:88.4": "asmiṃ loke paramhi ca. ",
  "thi-ap28:89.1": "dhammañcare sucaritaṃ ",
  "thi-ap28:89.2": "na taṃ duccaritaṃ care ",
  "thi-ap28:89.3": "dhammacārī sukhaṃ seti ",
  "thi-ap28:89.4": "asmiṃ loke paramhi ca. ",
  "thi-ap28:90.1": "nibbinditvāna saṃsāre ",
  "thi-ap28:90.2": "pabbajiṃ anagāriyaṃ ",
  "thi-ap28:90.3": "sahassaparivārena ",
  "thi-ap28:90.4": "pabbajitvā akiñcanā. ",
  "thi-ap28:91.1": "agāraṃ vijahitvāna ",
  "thi-ap28:91.2": "pabbajiṃ anagāriyaṃ ",
  "thi-ap28:91.3": "aḍḍhamāse asampatte ",
  "thi-ap28:91.4": "catusaccaṃ apāpuṇiṃ. ",
  "thi-ap28:92.1": "cīvaraṃ piṇḍapātañca ",
  "thi-ap28:92.2": "paccayaṃ sayanāsanaṃ ",
  "thi-ap28:92.3": "upanenti bahūneke ",
  "thi-ap28:92.4": "sāgareyeva ummiyo. ",
  "thi-ap28:93.1": "kilesā jhāpitā mayhaṃ ",
  "thi-ap28:93.2": "bhavā sabbe samūhatā nāgīva bandhanaṃ chetvā ",
  "thi-ap28:93.3": "viharāmi anāsavā. ",
  "thi-ap28:94.1": "svāgataṃ vata me āsi ",
  "thi-ap28:94.2": "buddhaseṭṭhassa santike tisso vijjā anuppattā ",
  "thi-ap28:94.3": "kataṃ buddhassa sāsanaṃ. ",
  "thi-ap28:95.1": "paṭisambhidā catasso ",
  "thi-ap28:95.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "thi-ap28:95.3": "kataṃ buddhassa sāsanaṃ. ",
  "thi-ap28:96.1": "evaṃ bahuvidhaṃ dukkhaṃ ",
  "thi-ap28:96.2": "sampattiṃ ca bahubbidhaṃ ",
  "thi-ap28:96.3": "visuddhabhāvasampattā ",
  "thi-ap28:96.4": "labhāmi sabbasampadā. ",
  "thi-ap28:97.1": "yo dadāti sakattānaṃ ",
  "thi-ap28:97.2": "puññatthāya mahesino ",
  "thi-ap28:97.3": "sahāyasampadā honti ",
  "thi-ap28:97.4": "nibbānapadamasaṅkhataṃ. ",
  "thi-ap28:98.1": "parikkhīṇaṃ atītañca ",
  "thi-ap28:98.2": "paccuppannaṃ anāgataṃ ",
  "thi-ap28:98.3": "sabbakammaṃ mamaṃ khīṇaṃ ",
  "thi-ap28:98.4": "pāde vandāmi cakkhumāti. ",
  "thi-ap28:99.1": "itthaṃ sudaṃ āyasmā yasodharā bhikkhunī bhagavato sammukhā imā gāthāyo abhāsitthāti. ",
  "thi-ap28:100.1": "yasodharātheriyā apadānaṃ samattaṃ. navamaṃ dasasahassatheriyāpadānaṃ (29) "
}
