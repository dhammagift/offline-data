{
  "thi-ap3:0.1": "",
  "thi-ap3:0.2": "",
  "thi-ap3:0.3": "",
  "thi-ap3:1.1": "konāgamanabuddhassa ",
  "thi-ap3:1.2": "maṇḍapo kārito mayā ",
  "thi-ap3:1.3": "thūpañca pavaramadaṃ ",
  "thi-ap3:1.4": "buddhassa lokabandhuno. ",
  "thi-ap3:2.1": "yaṃ yaṃ janapadaṃ yāmi ",
  "thi-ap3:2.2": "nigame rājadhāniyo ",
  "thi-ap3:2.3": "sabbattha pūjitā homi ",
  "thi-ap3:2.4": "puññakammassidaṃ phalaṃ. ",
  "thi-ap3:3.1": "kilesā jhāpitā mayhaṃ ",
  "thi-ap3:3.2": "bhavā sabbe samūhatā nāgīva bandhanaṃ chetvā ",
  "thi-ap3:3.3": "viharāmi anāsavā. ",
  "thi-ap3:4.1": "svāgataṃ vata me āsi ",
  "thi-ap3:4.2": "mama buddhassa santike tisso vijjā anuppattā ",
  "thi-ap3:4.3": "kataṃ buddhassa sāsanaṃ. ",
  "thi-ap3:5.1": "paṭisambhidā catasso ",
  "thi-ap3:5.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "thi-ap3:5.3": "kataṃ buddhassa sāsananti. ",
  "thi-ap3:6.1": "itthaṃ sudaṃ āyasmā maṇḍapadāyikā bhikkhunī imā gāthāyo abhāsitthāti. ",
  "thi-ap3:7.1": "maṇḍapadāyikātheriyā apadānaṃ samattaṃ. catutthaṃ saṅkamanadātheriyāpadānaṃ (4) "
}
