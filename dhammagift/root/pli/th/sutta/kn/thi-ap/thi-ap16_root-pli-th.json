{
  "thi-ap16:0.1": "",
  "thi-ap16:0.2": "",
  "thi-ap16:0.3": "",
  "thi-ap16:1.1": "candabhāgānadītīre ",
  "thi-ap16:1.2": "ahosiṃ kinnarī tadā ",
  "thi-ap16:1.3": "addasaṃ virajaṃ buddhaṃ ",
  "thi-ap16:1.4": "sayambhuṃ aparājitaṃ. ",
  "thi-ap16:2.1": "pasannacittā sumanā ",
  "thi-ap16:2.2": "vedajātā katañjalī ",
  "thi-ap16:2.3": "naḷamālaṃ gahetvāna ",
  "thi-ap16:2.4": "sayambhuṃ abhipūjayiṃ. ",
  "thi-ap16:3.1": "tena kammena sukatena ",
  "thi-ap16:3.2": "cetanāpaṇidhīhi ca ",
  "thi-ap16:3.3": "jahitvā kinnarīdehaṃ ",
  "thi-ap16:3.4": "tāvatiṃsaṃ agañchahaṃ. ",
  "thi-ap16:4.1": "chattiṃsadevarājūnaṃ ",
  "thi-ap16:4.2": "mahesittamakārayiṃ ",
  "thi-ap16:4.3": "manasā patthitaṃ mayhaṃ ",
  "thi-ap16:4.4": "nibbattati yathicchitaṃ. ",
  "thi-ap16:5.1": "dasannaṃ cakkavattīnaṃ ",
  "thi-ap16:5.2": "mahesittamakārayiṃ ",
  "thi-ap16:5.3": "ocitattāva hutvāna ",
  "thi-ap16:5.4": "saṃsarāmi bhavesuhaṃ. ",
  "thi-ap16:6.1": "kusalaṃ vijjate mayhaṃ ",
  "thi-ap16:6.2": "pabbajiṃ anagāriyaṃ ",
  "thi-ap16:6.3": "pūjārahā ahaṃ ajja ",
  "thi-ap16:6.4": "sakyaputtassa sāsane. ",
  "thi-ap16:7.1": "catunavute ",
  "thi-ap16:7.2": "",
  "thi-ap16:7.3": "ito ",
  "thi-ap16:7.4": "",
  "thi-ap16:8.1": "kappe ",
  "thi-ap16:8.2": "yaṃ buddhamabhipūjayiṃ ",
  "thi-ap16:8.3": "duggatiṃ nābhijānāmi ",
  "thi-ap16:8.4": "naḷamālāyidaṃ phalaṃ. ",
  "thi-ap16:9.1": "visuddhamanasā ajja apetamanapāpikā sabbāsavaparikkhīṇā natthi dāni punabbhavo. kilesā jhāpitā mayhaṃ ",
  "thi-ap16:9.2": "bhavā sabbe samūhatā nāgīva bandhanaṃ chetvā ",
  "thi-ap16:9.3": "viharāmi anāsavā. ",
  "thi-ap16:10.1": "svāgataṃ vata me āsi ",
  "thi-ap16:10.2": "buddhaseṭṭhassa santike tisso vijjā anuppattā ",
  "thi-ap16:10.3": "kataṃ buddhassa sāsanaṃ. ",
  "thi-ap16:11.1": "paṭisambhidā catasso ",
  "thi-ap16:11.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "thi-ap16:11.3": "kataṃ buddhassa sāsananti. ",
  "thi-ap16:12.1": "itthaṃ sudaṃ āyasmā naḷamālikā bhikkhunī imā gāthāyo abhāsitthāti. ",
  "thi-ap16:13.1": "naḷamālikātheriyā apadānaṃ samattaṃ. sattamaṃ mahāpajāpatigotamītheriyāpadānaṃ (17) "
}
