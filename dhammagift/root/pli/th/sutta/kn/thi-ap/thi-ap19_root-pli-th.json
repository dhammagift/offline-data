{
  "thi-ap19:0.1": "",
  "thi-ap19:0.2": "",
  "thi-ap19:0.3": "",
  "thi-ap19:1.1": "bhikkhunī uppalavaṇṇā ",
  "thi-ap19:1.2": "iddhiyā pāramiṃ gatā ",
  "thi-ap19:1.3": "vanditvā satthuno pāde ",
  "thi-ap19:1.4": "imaṃ vacanamabravi. ",
  "thi-ap19:2.1": "nitiṇṇā jātisaṃsāraṃ ",
  "thi-ap19:2.2": "pattāhaṃ acalaṃ padaṃ ",
  "thi-ap19:2.3": "sabbadukkhaṃ mayā khīṇaṃ ",
  "thi-ap19:2.4": "ārocemi mahāmuni. ",
  "thi-ap19:3.1": "yāvatā parisā atthi ",
  "thi-ap19:3.2": "pasannā jinasāsane ",
  "thi-ap19:3.3": "yesañca meparādhotthi ",
  "thi-ap19:3.4": "khamantu jinasammukhā. ",
  "thi-ap19:4.1": "saṃsāre saṃsarantā me ",
  "thi-ap19:4.2": "khalitaṃ me sace bhave ",
  "thi-ap19:4.3": "ārocemi mahāvīra ",
  "thi-ap19:4.4": "aparādhaṃ khamassu me. ",
  "thi-ap19:5.1": "iddhiñcāpi nidassehi ",
  "thi-ap19:5.2": "mama sāsanakārike ",
  "thi-ap19:5.3": "catasso parisā ajja ",
  "thi-ap19:5.4": "kaṅkhaṃ chindāhi yāvatā. ",
  "thi-ap19:6.1": "dhītā tuyhaṃ mahāvīra ",
  "thi-ap19:6.2": "paññavanta jutindhara ",
  "thi-ap19:6.3": "bahuñca dukkaraṃ kammaṃ ",
  "thi-ap19:6.4": "kataṃ me atidukkaraṃ. ",
  "thi-ap19:7.1": "uppalasseva me vaṇṇo ",
  "thi-ap19:7.2": "nāmenuppalanāmikā ",
  "thi-ap19:7.3": "sā dhītā te mahāvīra ",
  "thi-ap19:7.4": "pāde vandāmi cakkhumā. ",
  "thi-ap19:8.1": "rāhulo ca ahañceva ",
  "thi-ap19:8.2": "nekajātisate bahū ",
  "thi-ap19:8.3": "ekasmiṃ sambhave jātā ",
  "thi-ap19:8.4": "samānachandacetasā. ",
  "thi-ap19:9.1": "nibbatti ekato hoti ",
  "thi-ap19:9.2": "jātiyā cāpi ekato ",
  "thi-ap19:9.3": "pacchime bhavasampatte ubhayo ",
  "thi-ap19:9.4": "nāmasambhavā. ",
  "thi-ap19:10.1": "putto ca rāhulo nāma ",
  "thi-ap19:10.2": "dhītā uppalasavhayā ",
  "thi-ap19:10.3": "passa vīra mama iddhiṃ ",
  "thi-ap19:10.4": "balaṃ dassemi satthuno. ",
  "thi-ap19:11.1": "mahāsamudde caturo ",
  "thi-ap19:11.2": "pakkhipi hatthapāṇiyaṃ ",
  "thi-ap19:11.3": "telaṃ hatthagatañceva ",
  "thi-ap19:11.4": "khiḍḍo komārako yathā. ",
  "thi-ap19:12.1": "ubbattayitvā paṭhaviṃ ",
  "thi-ap19:12.2": "pakkhipi hatthapāṇiyaṃ ",
  "thi-ap19:12.3": "cittamuñjaṃ yathā nāma ",
  "thi-ap19:12.4": "luñci komārako yuvā. ",
  "thi-ap19:13.1": "cakkavāḷasamaṃ pāṇiṃ ",
  "thi-ap19:13.2": "chādayitvāna matthake ",
  "thi-ap19:13.3": "vassāpetvāna phusitaṃ ",
  "thi-ap19:13.4": "nānāvaṇṇaṃ punappunaṃ. ",
  "thi-ap19:14.1": "bhūmiṃ udukkhalaṃ katvā ",
  "thi-ap19:14.2": "dhaññaṃ katvāna sakkharaṃ ",
  "thi-ap19:14.3": "sineruṃ musalaṃ katvā ",
  "thi-ap19:14.4": "maddi komārikā yathā. ",
  "thi-ap19:15.1": "dhītāhaṃ buddhaseṭṭhassa ",
  "thi-ap19:15.2": "nāmenuppalasavhayā ",
  "thi-ap19:15.3": "abhiññāsu vasībhūtā ",
  "thi-ap19:15.4": "tava sāsanakārikā. ",
  "thi-ap19:16.1": "nānāvikubbanaṃ katvā ",
  "thi-ap19:16.2": "dassetvā lokanāyakaṃ ",
  "thi-ap19:16.3": "nāmagottaṃ pakāsetvā ",
  "thi-ap19:16.4": "pāde vandāmi cakkhumā. ",
  "thi-ap19:17.1": "iddhiyā ca vasī homi ",
  "thi-ap19:17.2": "dibbāya sotadhātuyā ",
  "thi-ap19:17.3": "cetopariyañāṇassa ",
  "thi-ap19:17.4": "vasī homi mahāmune. ",
  "thi-ap19:18.1": "pubbenivāsaṃ jānāmi ",
  "thi-ap19:18.2": "dibbacakkhuṃ visodhitaṃ ",
  "thi-ap19:18.3": "sabbāsavā parikkhīṇā ",
  "thi-ap19:18.4": "natthi dāni punabbhavo. ",
  "thi-ap19:19.1": "atthadhammaniruttīsu ",
  "thi-ap19:19.2": "paṭibhāṇe tatheva ca ",
  "thi-ap19:19.3": "ñāṇaṃ me vipulaṃ suddhaṃ ",
  "thi-ap19:19.4": "sabhāvena mahesino. ",
  "thi-ap19:20.1": "purimānaṃ jinaggānaṃ ",
  "thi-ap19:20.2": "saṅgāmantena dassitaṃ ",
  "thi-ap19:20.3": "adhikāraṃ bahu mayhaṃ ",
  "thi-ap19:20.4": "tuyhatthāya mahāmuni. ",
  "thi-ap19:21.1": "yaṃ mayā purimaṃ kammaṃ ",
  "thi-ap19:21.2": "kusalaṃ sara me muni ",
  "thi-ap19:21.3": "tavatthāya mahāvīra ",
  "thi-ap19:21.4": "puññaṃ upacitaṃ mayā. ",
  "thi-ap19:22.1": "abhabbaṭṭhāne vajjetvā ",
  "thi-ap19:22.2": "paripācento anācāraṃ ",
  "thi-ap19:22.3": "tavatthāya mahāvīra ",
  "thi-ap19:22.4": "cattaṃ me jīvituttamaṃ. ",
  "thi-ap19:23.1": "dasakoṭisahassāni ",
  "thi-ap19:23.2": "adāsi mama jīvitaṃ ",
  "thi-ap19:23.3": "paricattā ca me homi ",
  "thi-ap19:23.4": "tavatthāya mahāmuni. ",
  "thi-ap19:24.1": "tadātivimhitā sabbā ",
  "thi-ap19:24.2": "sirasāva katañjalī ",
  "thi-ap19:24.3": "avocayye kataṃ āsi ",
  "thi-ap19:24.4": "atuliddhi parakkamā. ",
  "thi-ap19:25.1": "satasahasse ito kappe ",
  "thi-ap19:25.2": "nāgakaññā ahaṃ tadā ",
  "thi-ap19:25.3": "vimalā nāma nāmena ",
  "thi-ap19:25.4": "kaññānaṃ sādhusammatā. ",
  "thi-ap19:26.1": "mahorago mahānāgo ",
  "thi-ap19:26.2": "pasanno jinasāsane ",
  "thi-ap19:26.3": "padumuttaraṃ mahātejaṃ ",
  "thi-ap19:26.4": "nimantesi sasāvakaṃ. ",
  "thi-ap19:27.1": "ratanamayañca maṇḍapaṃ ",
  "thi-ap19:27.2": "pallaṅkaṃ ratanāmayaṃ ",
  "thi-ap19:27.3": "ratanavālukākiṇṇaṃ ",
  "thi-ap19:27.4": "upabhogaṃ ratanāmayaṃ. ",
  "thi-ap19:28.1": "maggañca paṭiyādesi ",
  "thi-ap19:28.2": "ratanadhajabhūsitaṃ ",
  "thi-ap19:28.3": "paccuggantvāna sambuddhaṃ ",
  "thi-ap19:28.4": "vajjanto turiyehi so. ",
  "thi-ap19:29.1": "parisāhi ca catūhi ",
  "thi-ap19:29.2": "pharate lokanāyako ",
  "thi-ap19:29.3": "mahoragassa bhavane ",
  "thi-ap19:29.4": "nisīdi paramāsane. ",
  "thi-ap19:30.1": "annapānaṃ khādanīyaṃ ",
  "thi-ap19:30.2": "bhojanañca mahārahaṃ ",
  "thi-ap19:30.3": "varaṃ varañca pādāsi ",
  "thi-ap19:30.4": "nāgarājā mahāyasaṃ. ",
  "thi-ap19:31.1": "bhuñjitvāna sa sambuddho ",
  "thi-ap19:31.2": "patte dhovitva yoniso ",
  "thi-ap19:31.3": "anumodaniyaṃkāsi ",
  "thi-ap19:31.4": "nāgakaññā mahiddhikā. ",
  "thi-ap19:32.1": "sabbaññuṃ phullitaṃ disvā ",
  "thi-ap19:32.2": "nāgakaññā mahāyasaṃ ",
  "thi-ap19:32.3": "pasannaṃ satthuno cittaṃ ",
  "thi-ap19:32.4": "sunivaddhañca mānasaṃ. ",
  "thi-ap19:33.1": "mamañca cittamaññāya ",
  "thi-ap19:33.2": "jalajuttamanāmako ",
  "thi-ap19:33.3": "tasmiṃ khaṇe mahāvīro ",
  "thi-ap19:33.4": "bhikkhuniṃ dassayiddhiyā. ",
  "thi-ap19:34.1": "iddhī anekā dassesi ",
  "thi-ap19:34.2": "bhikkhunī sā visāradā ",
  "thi-ap19:34.3": "pamoditā vedajātā ",
  "thi-ap19:34.4": "satthāraṃ etadabraviṃ. ",
  "thi-ap19:35.1": "addasāhaṃ imā iddhī ",
  "thi-ap19:35.2": "sumitā itarāyapi ",
  "thi-ap19:35.3": "kathaṃ ahosi sā dhīra ",
  "thi-ap19:35.4": "iddhiyā suvisāradā. ",
  "thi-ap19:36.1": "orasāmukhato jātā ",
  "thi-ap19:36.2": "dhītā mama mahiddhikā ",
  "thi-ap19:36.3": "mamānusāsanīkārā ",
  "thi-ap19:36.4": "iddhiyā suvisāradā. ",
  "thi-ap19:37.1": "buddhassa vacanaṃ sutvā tuṭṭhā ",
  "thi-ap19:37.2": "evaṃ avocahaṃ ",
  "thi-ap19:37.3": "ahaṃpi tādisā homi ",
  "thi-ap19:37.4": "iddhiyā suvisāradā. ",
  "thi-ap19:38.1": "pamoditāhaṃ sumanā ",
  "thi-ap19:38.2": "pattauttamamānasā ",
  "thi-ap19:38.3": "anāgatamhi addhāne ",
  "thi-ap19:38.4": "īdisā homi nāyaka. ",
  "thi-ap19:39.1": "maṇimayañca pallaṅkaṃ ",
  "thi-ap19:39.2": "maṇḍapañca pabhassaraṃ ",
  "thi-ap19:39.3": "annapānena tappetvā ",
  "thi-ap19:39.4": "sasaṅghaṃ lokanāyakaṃ. ",
  "thi-ap19:40.1": "nāgānaṃ pavaraṃ pupphaṃ ",
  "thi-ap19:40.2": "aruṇaṃ nāma uppalaṃ ",
  "thi-ap19:40.3": "vaṇṇaṃ me īdisaṃ hotu ",
  "thi-ap19:40.4": "pūjesiṃ lokanāyakaṃ. ",
  "thi-ap19:41.1": "tena kammena sukatena ",
  "thi-ap19:41.2": "cetanāpaṇidhīhi ca ",
  "thi-ap19:41.3": "jahitvā mānusaṃ dehaṃ ",
  "thi-ap19:41.4": "tāvatiṃsaṃ agañchahaṃ. ",
  "thi-ap19:42.1": "tato cutāhaṃ manuje ",
  "thi-ap19:42.2": "upapannā sayambhuno ",
  "thi-ap19:42.3": "uppalehi paṭicchannaṃ ",
  "thi-ap19:42.4": "piṇḍapātamadāsahaṃ. ",
  "thi-ap19:43.1": "ekanavute ito kappe ",
  "thi-ap19:43.2": "vipassī nāma nāyako ",
  "thi-ap19:43.3": "uppajji cārunayano ",
  "thi-ap19:43.4": "sabbadhammesu cakkhumā. ",
  "thi-ap19:44.1": "seṭṭhidhītā tadā hutvā ",
  "thi-ap19:44.2": "bārāṇasipuruttame ",
  "thi-ap19:44.3": "nimantetvāna sambuddhaṃ ",
  "thi-ap19:44.4": "sasaṅghaṃ lokanāyakaṃ. ",
  "thi-ap19:45.1": "mahādānaṃ daditvāna ",
  "thi-ap19:45.2": "uppalehi vināyakaṃ ",
  "thi-ap19:45.3": "pūjayitvā ca teheva ",
  "thi-ap19:45.4": "vaṇṇasobhaṃ apatthayiṃ. ",
  "thi-ap19:46.1": "imamhi bhaddake kappe ",
  "thi-ap19:46.2": "brahmabandhu mahāyaso ",
  "thi-ap19:46.3": "kassapo nāma nāmena ",
  "thi-ap19:46.4": "uppajji vadataṃ varo. ",
  "thi-ap19:47.1": "upaṭṭhāko mahesissa ",
  "thi-ap19:47.2": "tadā āsi narissaro ",
  "thi-ap19:47.3": "kāsirājā kikīnāma ",
  "thi-ap19:47.4": "bārāṇasipuruttame. ",
  "thi-ap19:48.1": "tassāsiṃ dutiyā dhītā ",
  "thi-ap19:48.2": "samaṇīguttasavhayā ",
  "thi-ap19:48.3": "dhammaṃ sutvā jinaggassa ",
  "thi-ap19:48.4": "pabbajjaṃ samarocayiṃ. ",
  "thi-ap19:49.1": "anujāni na no tāto ",
  "thi-ap19:49.2": "agāreva tadā mayaṃ ",
  "thi-ap19:49.3": "vīsaṃ vassasahassāni ",
  "thi-ap19:49.4": "vicarimha atanditā. ",
  "thi-ap19:50.1": "komāribrahmacariyaṃ ",
  "thi-ap19:50.2": "rājakaññā sukheṭṭhitā ",
  "thi-ap19:50.3": "buddhopaṭṭhānaniratā ",
  "thi-ap19:50.4": "muditā satta dhītaro. ",
  "thi-ap19:51.1": "samaṇī samaṇaguttā ca ",
  "thi-ap19:51.2": "bhikkhunī bhikkhudāsikā ",
  "thi-ap19:51.3": "dhammā ceva sudhammā ca ",
  "thi-ap19:51.4": "sattamī saṅghadāsikā. ",
  "thi-ap19:52.1": "ahaṃ khemā ca sappaññā ",
  "thi-ap19:52.2": "paṭācārā ca kuṇḍalā ",
  "thi-ap19:52.3": "kisāgotamī dhammadinnā ",
  "thi-ap19:52.4": "visākhā hoti sattamī. ",
  "thi-ap19:53.1": "tehi kammehi sukatehi ",
  "thi-ap19:53.2": "cetanāpaṇidhīhi ca ",
  "thi-ap19:53.3": "jahitvā mānusaṃ dehaṃ ",
  "thi-ap19:53.4": "tāvatiṃsaṃ agañchahaṃ. ",
  "thi-ap19:54.1": "tato cutā manussesu ",
  "thi-ap19:54.2": "upapannā mahākule ",
  "thi-ap19:54.3": "pītamaṭṭhavaraṃ dussaṃ ",
  "thi-ap19:54.4": "adaṃ arahato ahaṃ. ",
  "thi-ap19:55.1": "tato cutā ariṭṭhapure ",
  "thi-ap19:55.2": "jātā vippakule ahaṃ ",
  "thi-ap19:55.3": "dhītā tiriṭivacchassa ",
  "thi-ap19:55.4": "ummādantī manoharā. ",
  "thi-ap19:56.1": "tato cutā janapade ",
  "thi-ap19:56.2": "kule aññatare ahaṃ ",
  "thi-ap19:56.3": "pasutā nātiphītamhi ",
  "thi-ap19:56.4": "sāliṃ gopemahantadā. ",
  "thi-ap19:57.1": "disvā paccekasambuddhaṃ ",
  "thi-ap19:57.2": "pañcalājasatānahaṃ ",
  "thi-ap19:57.3": "datvā padumachannāni ",
  "thi-ap19:57.4": "pañca puttasatānipi. ",
  "thi-ap19:58.1": "patthayiṃ tesu puttesu ",
  "thi-ap19:58.2": "madhuṃ datvā sayambhuno ",
  "thi-ap19:58.3": "tato cutā araññehaṃ ",
  "thi-ap19:58.4": "ajāyiṃ padumodare. ",
  "thi-ap19:59.1": "kāsirañño mahesīhaṃ ",
  "thi-ap19:59.2": "hutvā sakkatapūjitā ",
  "thi-ap19:59.3": "ajaniṃ rājaputtānaṃ ",
  "thi-ap19:59.4": "anūnaṃ satapañcakaṃ. ",
  "thi-ap19:60.1": "yadā te yobbanappattā ",
  "thi-ap19:60.2": "kīḷantā jalakīḷitaṃ ",
  "thi-ap19:60.3": "disvāna opattapadumaṃ ",
  "thi-ap19:60.4": "āsuṃ paccekanāyakā. ",
  "thi-ap19:61.1": "sāhaṃ tehi vinābhūtā ",
  "thi-ap19:61.2": "sutavarehi sokinī ",
  "thi-ap19:61.3": "cutā isigilipasse ",
  "thi-ap19:61.4": "gāmakamhi ajāyihaṃ. ",
  "thi-ap19:62.1": "yadā buddhāsutamati ",
  "thi-ap19:62.2": "sutānaṃ attanopica ",
  "thi-ap19:62.3": "yāguṃ ādāya gacchanti ",
  "thi-ap19:62.4": "aṭṭha paccekanāyake. ",
  "thi-ap19:63.1": "bhikkhāya gāmaṃ gacchante ",
  "thi-ap19:63.2": "disvā putte anussariṃ ",
  "thi-ap19:63.3": "khīradhārā viniggañchi ",
  "thi-ap19:63.4": "tadā me puttapemasā. ",
  "thi-ap19:64.1": "tato tesaṃ adaṃ yāguṃ ",
  "thi-ap19:64.2": "pasannā sehi pāṇibhi ",
  "thi-ap19:64.3": "tato cutāhaṃ tidasaṃ ",
  "thi-ap19:64.4": "nandanaṃ upapajjahaṃ. ",
  "thi-ap19:65.1": "anubhotvā sukhadukkhaṃ ",
  "thi-ap19:65.2": "saṃsaritvā bhavābhave ",
  "thi-ap19:65.3": "tavatthāya mahāvīra ",
  "thi-ap19:65.4": "pariccattañca jīvitaṃ. ",
  "thi-ap19:66.1": "evaṃ bahuvidhaṃ dukkhaṃ ",
  "thi-ap19:66.2": "sampattī ca bahūvidhā ",
  "thi-ap19:66.3": "pacchime bhavasampatte ",
  "thi-ap19:66.4": "jātā sāvatthiyaṃ pure. ",
  "thi-ap19:67.1": "mahaddhane seṭṭhikule ",
  "thi-ap19:67.2": "sukhite sajjite tathā ",
  "thi-ap19:67.3": "nānāratanapajjote ",
  "thi-ap19:67.4": "sabbakāmasamiddhane. ",
  "thi-ap19:68.1": "sakkatapūjitā ceva ",
  "thi-ap19:68.2": "mānitāpacitā tathā ",
  "thi-ap19:68.3": "rūpasiriṃ anuppattā ",
  "thi-ap19:68.4": "kulesu atisakkatā. ",
  "thi-ap19:69.1": "atīva patthitā cāsiṃ ",
  "thi-ap19:69.2": "rūpabhogasirīhi ca ",
  "thi-ap19:69.3": "patthitā seṭṭhiputtehi ",
  "thi-ap19:69.4": "anekehi satehi ca. ",
  "thi-ap19:70.1": "agāraṃ pajahitvāna ",
  "thi-ap19:70.2": "pabbajiṃ anagāriyaṃ ",
  "thi-ap19:70.3": "aḍḍhamāse asampatte ",
  "thi-ap19:70.4": "catusaccaṃ apāpuṇiṃ. ",
  "thi-ap19:71.1": "iddhiyā abhinimmitvā ",
  "thi-ap19:71.2": "caturassaṃ rathaṃ ahaṃ ",
  "thi-ap19:71.3": "buddhassa pāde avandiṃ ",
  "thi-ap19:71.4": "lokanāthasirimato. ",
  "thi-ap19:72.1": "supupphitaggaṃ upagamma pādapaṃ ",
  "thi-ap19:72.2": "ekā tuvaṃ tiṭṭhasi sālamūle ",
  "thi-ap19:72.3": "na cāpi tuyhaṃ dutiyatthi koci ",
  "thi-ap19:72.4": "bāle na tvaṃ bhāyasi dhuttakānaṃ. ",
  "thi-ap19:73.1": "sataṃ sahassānipi dhuttakānaṃ ",
  "thi-ap19:73.2": "idhāgatā edisakā bhaveyyuṃ ",
  "thi-ap19:73.3": "lomaṃ na iñje napi sampavedhe ",
  "thi-ap19:73.4": "kiṃ me tuvaṃ māra karissaseko. ",
  "thi-ap19:74.1": "esā antaradhāyāmi ",
  "thi-ap19:74.2": "kucchiṃ vā pavisāmi te ",
  "thi-ap19:74.3": "bhamukantarikāyampi ",
  "thi-ap19:74.4": "tiṭṭhantiṃ maṃ na dakkhasi. ",
  "thi-ap19:75.1": "cittamhi vasibhūtāhaṃ ",
  "thi-ap19:75.2": "iddhipādā suvibhāvitā ",
  "thi-ap19:75.3": "sabbabandhanamuttāmhi ",
  "thi-ap19:75.4": "na taṃ bhāyāmi āvuso. ",
  "thi-ap19:76.1": "sattisūlūpamā kāmā ",
  "thi-ap19:76.2": "khandhāpi adhikuṇḍarā ",
  "thi-ap19:76.3": "yattha kāmaratiṃ brūsi ",
  "thi-ap19:76.4": "arati dāni sā mama. ",
  "thi-ap19:77.1": "sabbattha vihatā nandi ",
  "thi-ap19:77.2": "tamokkhandhā padālitā ",
  "thi-ap19:77.3": "evaṃ jānāhi pāpima ",
  "thi-ap19:77.4": "nihato tvamasi antaka. ",
  "thi-ap19:78.1": "jino tasmiṃ guṇe tuṭṭho ",
  "thi-ap19:78.2": "etadagge ṭhapesi maṃ ",
  "thi-ap19:78.3": "seṭṭhā iddhimatīnanti ",
  "thi-ap19:78.4": "parisāsu vināyako. ",
  "thi-ap19:79.1": "pariciṇṇo mayā satthā ",
  "thi-ap19:79.2": "kataṃ buddhassa sāsanaṃ ",
  "thi-ap19:79.3": "ohito guruko bhāro ",
  "thi-ap19:79.4": "bhavanetti samūhatā. ",
  "thi-ap19:80.1": "yassatthāya pabbajitā ",
  "thi-ap19:80.2": "agārasmā anagāriyaṃ ",
  "thi-ap19:80.3": "so me attho anuppatto ",
  "thi-ap19:80.4": "sabbasaṃyojanakkhayo. ",
  "thi-ap19:81.1": "cīvaraṃ piṇḍapātañca ",
  "thi-ap19:81.2": "paccayaṃ sayanāsanaṃ ",
  "thi-ap19:81.3": "khaṇena upanāmenti ",
  "thi-ap19:81.4": "sahassāni samantato. ",
  "thi-ap19:82.1": "kilesā jhāpitā mayhaṃ ",
  "thi-ap19:82.2": "bhavā sabbe samūhatā nāgīva bandhanaṃ chetvā ",
  "thi-ap19:82.3": "viharāmi anāsavā. ",
  "thi-ap19:83.1": "svāgataṃ vata me āsi ",
  "thi-ap19:83.2": "buddhaseṭṭhassa santike tisso vijjā anuppattā ",
  "thi-ap19:83.3": "kataṃ buddhassa sāsanaṃ. ",
  "thi-ap19:84.1": "paṭisambhidā catasso ",
  "thi-ap19:84.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "thi-ap19:84.3": "kataṃ buddhassa sāsananti. ",
  "thi-ap19:85.1": "itthaṃ sudaṃ āyasmā uppalavaṇṇā bhikkhunī imā gāthāyo abhāsitthāti. ",
  "thi-ap19:86.1": "uppalavaṇṇātheriyā apadānaṃ samattaṃ. dasamaṃ paṭācārātheriyāpadānaṃ (20) "
}
