{
  "snp4.11:0.1": "",
  "snp4.11:0.2": "",
  "snp4.11:1.1": "kuto pahūtā kalahā vivādā ",
  "snp4.11:1.2": "paridevasokā sahamaccharā ca ",
  "snp4.11:1.3": "mānātimānā sahapesuṇā ca ",
  "snp4.11:1.4": "kuto pahūtā te tadiṅgha brūhi. ",
  "snp4.11:2.1": "piyappahūtā kalahā vivādā ",
  "snp4.11:2.2": "paridevasokā sahamaccharā ca ",
  "snp4.11:2.3": "mānātimānā sahapesuṇā ca ",
  "snp4.11:2.4": "maccherayuttā kalahā vivādā ",
  "snp4.11:2.5": "vivādajātesu ca pesuṇāni. ",
  "snp4.11:3.1": "piyā su lokasmiṃ kutonidānā ",
  "snp4.11:3.2": "ye vāpi lobhā vicaranti loke ",
  "snp4.11:3.3": "āsā ca niṭṭhā ca kutonidānā ",
  "snp4.11:3.4": "ye samparāyāya narassa honti. ",
  "snp4.11:4.1": "chandānidānāni piyāni loke ",
  "snp4.11:4.2": "ye vāpi lobhā vicaranti loke ",
  "snp4.11:4.3": "āsā ca niṭṭhā ca itonidānā ",
  "snp4.11:4.4": "ye samparāyāya narassa honti. ",
  "snp4.11:5.1": "chando nu lokasmiṃ kutonidāno ",
  "snp4.11:5.2": "vinicchayā vāpi kuto pahūtā ",
  "snp4.11:5.3": "kodho mosavajjañca kathaṅkathā ca ",
  "snp4.11:5.4": "ye vāpi dhammā samaṇena vuttā. ",
  "snp4.11:6.1": "sātaṃ asātanti yamāhu loke ",
  "snp4.11:6.2": "tamūpanissāya pahoti chando ",
  "snp4.11:6.3": "rūpesu disvā vibhavaṃ bhavañca ",
  "snp4.11:6.4": "vinicchayaṃ kurute jantu loke. ",
  "snp4.11:7.1": "kodho mosavajjañca kathaṅkathā ca ",
  "snp4.11:7.2": "etepi dhammā dvayameva sante ",
  "snp4.11:7.3": "kathaṅkathī ñāṇapathāya sikkhe ",
  "snp4.11:7.4": "ñatvā pavuttā samaṇena dhammā. ",
  "snp4.11:8.1": "sātaṃ asātañca kutonidānā ",
  "snp4.11:8.2": "kismiṃ asante na bhavanti hete ",
  "snp4.11:8.3": "vibhavaṃ bhavañcāpi yametamatthaṃ ",
  "snp4.11:8.4": "etamme pabrūhi yatonidānaṃ. ",
  "snp4.11:9.1": "phassanidānaṃ sātaṃ asātaṃ ",
  "snp4.11:9.2": "phasse asante na bhavanti hete ",
  "snp4.11:9.3": "vibhavaṃ bhavañcāpi yametamatthaṃ ",
  "snp4.11:9.4": "etante pabrūmi itonidānaṃ. ",
  "snp4.11:10.1": "phasso nu lokasmiṃ kutonidāno ",
  "snp4.11:10.2": "pariggahā vāpi kuto pahūtā ",
  "snp4.11:10.3": "kasmiṃ asante na mamattamatthi ",
  "snp4.11:10.4": "kasmiṃ vibhūte na phusanti phassā. ",
  "snp4.11:11.1": "nāmañca rūpañca paṭicca phasso ",
  "snp4.11:11.2": "icchānidānāni pariggahāni ",
  "snp4.11:11.3": "icchāya asantyā na mamattamatthi ",
  "snp4.11:11.4": "rūpe vibhūte na phusanti phassā. ",
  "snp4.11:12.1": "kathaṃsametassa vibhoti rūpaṃ ",
  "snp4.11:12.2": "sukhaṃ dukkhaṃ vāpi kathaṃ vibhoti ",
  "snp4.11:12.3": "etamme pabrūhi yathā vibhoti ",
  "snp4.11:12.4": "taṃ jāniyāma iti me mano ahu. ",
  "snp4.11:13.1": "na saññasaññī na visaññasaññī ",
  "snp4.11:13.2": "nopi asaññī na vibhūtasaññī ",
  "snp4.11:13.3": "evaṃsametassa vibhoti rūpaṃ ",
  "snp4.11:13.4": "saññānidānā hi papañcasaṅkhā. ",
  "snp4.11:14.1": "yantaṃ apucchimha akittayi no ",
  "snp4.11:14.2": "aññantaṃ pucchāma tadiṅgha brūhi ",
  "snp4.11:14.3": "ettāvataggaṃ no vadanti heke ",
  "snp4.11:14.4": "yakkhassa suddhiṃ idha paṇḍitāse ",
  "snp4.11:14.5": "udāhu aññampi vadanti etto. ",
  "snp4.11:15.1": "ettāvataggampi vadanti heke ",
  "snp4.11:15.2": "yakkhassa suddhiṃ idha paṇḍitāse ",
  "snp4.11:15.3": "tesaṃ puneke samayaṃ vadanti ",
  "snp4.11:15.4": "anupādisese kusalā vadānā. ",
  "snp4.11:16.1": "ete ca ñatvā upanissitāti ",
  "snp4.11:16.2": "ñatvā munī nissaye so vimaṃsī ",
  "snp4.11:16.3": "ñatvā vimutto na vivādameti ",
  "snp4.11:16.4": "bhavābhavāya na sameti dhīroti. ",
  "snp4.11:16.5": "kalahavivādasuttaṃ ekādasamaṃ. suttanipāte catutthassa aṭṭhakavaggassa dvādasamaṃ cūḷaviyūhasuttaṃ 12 sakaṃ sakaṃ diṭṭhiparibbasānā "
}
