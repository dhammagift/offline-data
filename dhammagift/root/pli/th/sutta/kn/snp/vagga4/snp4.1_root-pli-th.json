{
  "snp4.1:0.1": "",
  "snp4.1:0.2": "",
  "snp4.1:1.1": "kāmaṃ kāmayamānassa ",
  "snp4.1:1.2": "tassa ce taṃ samijjhati ",
  "snp4.1:1.3": "addhā pītimano hoti ",
  "snp4.1:1.4": "laddhā macco yadicchati. ",
  "snp4.1:2.1": "tassa ce kāmayānassa ",
  "snp4.1:2.2": "chandajātassa jantuno ",
  "snp4.1:2.3": "te kāmā parihāyanti ",
  "snp4.1:2.4": "sallaviddhova ruppati. ",
  "snp4.1:3.1": "yo kāme parivajjeti ",
  "snp4.1:3.2": "sappasseva padā siro ",
  "snp4.1:3.3": "somaṃ visattikaṃ loke ",
  "snp4.1:3.4": "sato samativattati. ",
  "snp4.1:4.1": "khettaṃ vatthuṃ hiraññañca ",
  "snp4.1:4.2": "gavāssaṃ dāsaporisaṃ ",
  "snp4.1:4.3": "thiyo bandhū puthū kāme ",
  "snp4.1:4.4": "yo naro anugijjhati ",
  "snp4.1:5.1": "abalā naṃ balīyanti ",
  "snp4.1:5.2": "maddante naṃ parissayā ",
  "snp4.1:5.3": "tato naṃ dukkhamanveti ",
  "snp4.1:5.4": "nāvaṃ bhinnamivodakaṃ. ",
  "snp4.1:6.1": "tasmā jantu sadā sato ",
  "snp4.1:6.2": "kāmāni parivajjaye ",
  "snp4.1:6.3": "te pahāya tare oghaṃ ",
  "snp4.1:6.4": "nāvaṃ sitvāva pāragūti. ",
  "snp4.1:6.5": "kāmasuttaṃ paṭhamaṃ. suttanipāte catutthassa aṭṭhakavaggassa dutiyaṃ guhaṭṭhakasuttaṃ 2 "
}
