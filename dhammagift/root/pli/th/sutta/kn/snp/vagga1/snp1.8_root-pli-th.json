{
  "snp1.8:0.1": "suttanipāte uragavaggassa aṭṭhamaṃ mettasuttaṃ ",
  "snp1.8:0.2": "",
  "snp1.8:1.1": "8 karaṇīyamatthakusalena ",
  "snp1.8:1.2": "yantaṃ santaṃ padaṃ abhisamecca ",
  "snp1.8:1.3": "sakko ujū ca suhujū ca ",
  "snp1.8:1.4": "suvaco cassa mudu anatimānī. ",
  "snp1.8:2.1": "santussako ca subharo ca ",
  "snp1.8:2.2": "appakicco ca sallahukavutti ",
  "snp1.8:2.3": "santindriyo ca nipako ca ",
  "snp1.8:2.4": "appagabbho kulesu ananugiddho. ",
  "snp1.8:3.1": "na ca khuddaṃ samācare kiñci ",
  "snp1.8:3.2": "ye na viññū pare upavadeyyuṃ. ",
  "snp1.8:3.3": "sukhino vā khemino hontu ",
  "snp1.8:3.4": "sabbe sattā bhavantu sukhitattā ",
  "snp1.8:4.1": "ye keci pāṇabhūtatthi ",
  "snp1.8:4.2": "tasā vā thāvarā vā anavasesā ",
  "snp1.8:4.3": "dīghā vā ye mahantā vā ",
  "snp1.8:4.4": "majjhimā rassakā aṇukathūlā ",
  "snp1.8:5.1": "diṭṭhā vā ye ca adiṭṭhā ",
  "snp1.8:5.2": "ye ca dūre vasanti avidūre ",
  "snp1.8:5.3": "bhūtā vā sambhavesī vā ",
  "snp1.8:5.4": "sabbe sattā bhavantu sukhitattā. ",
  "snp1.8:6.1": "na paro paraṃ nikubbetha ",
  "snp1.8:6.2": "nātimaññetha katthaci naṃ kiñci ",
  "snp1.8:6.3": "byārosanā paṭīghasaññā ",
  "snp1.8:6.4": "nāññamaññassa dukkhamiccheyya. ",
  "snp1.8:7.1": "mātā yathā niyaṃ puttaṃ ",
  "snp1.8:7.2": "āyusā ekaputtamanurakkhe ",
  "snp1.8:7.3": "evampi sabbabhūtesu ",
  "snp1.8:7.4": "mānasambhāvaye aparimāṇaṃ ",
  "snp1.8:8.1": "mettañca sabbalokasmiṃ ",
  "snp1.8:8.2": "mānasambhāvaye aparimāṇaṃ ",
  "snp1.8:8.3": "uddhaṃ adho ca tiriyañca ",
  "snp1.8:8.4": "asambādhaṃ averaṃ ",
  "snp1.8:9.1": "asapattaṃ tiṭṭhañcaraṃ nisinno vā ",
  "snp1.8:9.2": "sayāno vā yāva tassa vigatamiddho. ",
  "snp1.8:9.3": "etaṃ satiṃ adhiṭṭheyya ",
  "snp1.8:9.4": "brahmametaṃ vihāraṃ idhamāhu. ",
  "snp1.8:10.1": "diṭṭhiñca anupagamma ",
  "snp1.8:10.2": "sīlavā dassanena sampanno ",
  "snp1.8:10.3": "kāmesu vineyya gedhaṃ ",
  "snp1.8:10.4": "na hi jātu gabbhaseyyaṃ punaretīti. ",
  "snp1.8:10.5": "mettasuttaṃ aṭṭhamaṃ. "
}
