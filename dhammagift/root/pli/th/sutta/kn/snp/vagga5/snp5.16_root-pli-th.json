{
  "snp5.16:0.1": "suttanipāte pañcamassa pārāyanavaggassa ",
  "snp5.16:0.2": "paṇṇarasamā mogharājapañhā ",
  "snp5.16:1.1": "15 dvāhaṃ sakka apucchissaṃ ",
  "snp5.16:1.2": "(iccāyasmā mogharājā) ",
  "snp5.16:1.3": "na me byākāsi cakkhumā ",
  "snp5.16:1.4": "yāvatatiyañca devisi ",
  "snp5.16:1.5": "byākarotīti me sutaṃ ",
  "snp5.16:2.1": "ayaṃ loko paro loko ",
  "snp5.16:2.2": "brahmaloko sadevako ",
  "snp5.16:2.3": "diṭṭhinte nābhijānāmi ",
  "snp5.16:2.4": "gotamassa yasassino ",
  "snp5.16:3.1": "evaṃ abhikkantadassāviṃ ",
  "snp5.16:3.2": "atthī pañhena āgamaṃ ",
  "snp5.16:3.3": "kathaṃ lokaṃ avekkhantaṃ ",
  "snp5.16:3.4": "maccurājā na passati. ",
  "snp5.16:4.1": "suññato lokaṃ avekkhassu ",
  "snp5.16:4.2": "mogharājā sadā sato ",
  "snp5.16:4.3": "attānudiṭṭhiṃ ūhacca ",
  "snp5.16:4.4": "evaṃ maccutaro siyā ",
  "snp5.16:4.5": "evaṃ lokaṃ avekkhantaṃ ",
  "snp5.16:4.6": "maccurājā na passatīti. ",
  "snp5.16:4.7": "mogharājamāṇavakapañhā paṇṇarasamā. "
}
