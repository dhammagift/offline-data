{
  "snp5.7:0.1": "suttanipāte pañcamassa pārāyanavaggassa chaṭṭhī upasīvapañhā ",
  "snp5.7:0.2": "",
  "snp5.7:1.1": "6 eko ahaṃ sakka mahantamoghaṃ ",
  "snp5.7:1.2": "(iccāyasmā upasīvo) ",
  "snp5.7:1.3": "anissito no visahāmi tārituṃ ",
  "snp5.7:1.4": "ārammaṇaṃ brūhi samantacakkhu ",
  "snp5.7:1.5": "yaṃ nissito oghamimaṃ tareyya. ",
  "snp5.7:2.1": "ākiñcaññaṃ pekkhamā no satimā ",
  "snp5.7:2.2": "(upasīvāti bhagavā) ",
  "snp5.7:2.3": "natthīti nissāya tarassu oghaṃ ",
  "snp5.7:2.4": "kāme pahāya virato kathāhi ",
  "snp5.7:2.5": "taṇhakkhayaṃ rattamahābhipassa. ",
  "snp5.7:3.1": "sabbesu kāmesu yo vītarāgo ",
  "snp5.7:3.2": "(iccāyasmā upasīvo) ",
  "snp5.7:3.3": "ākiñcaññaṃ nissito hitvamaññaṃ ",
  "snp5.7:3.4": "saññāvimokkhe parame vimutto ",
  "snp5.7:3.5": "tiṭṭhe nu so tattha anānuvāyī. ",
  "snp5.7:4.1": "sabbesu kāmesu yo vītarāgo ",
  "snp5.7:4.2": "(upasīvāti bhagavā) ",
  "snp5.7:4.3": "ākiñcaññaṃ nissito hitvamaññaṃ ",
  "snp5.7:4.4": "saññāvimokkhe parame vimutto ",
  "snp5.7:4.5": "tiṭṭheyya so tattha anānuvāyī ",
  "snp5.7:5.1": "tiṭṭhe ce so tattha anānuvāyī ",
  "snp5.7:5.2": "pūgampi vassānaṃ samantacakkhu ",
  "snp5.7:5.3": "tattheva so sīti siyā vimutto ",
  "snp5.7:5.4": "bhavetha viññāṇaṃ tathāvidhassa. ",
  "snp5.7:6.1": "acci yathā vātavegena khittaṃ ",
  "snp5.7:6.2": "(upasīvāti bhagavā) ",
  "snp5.7:6.3": "atthaṃ paleti na upeti saṅkhaṃ ",
  "snp5.7:6.4": "evaṃ munī nāmakāyā vimutto ",
  "snp5.7:6.5": "atthaṃ paleti na upeti saṅkhaṃ. ",
  "snp5.7:7.1": "atthaṅgato so uda vā so natthi ",
  "snp5.7:7.2": "udāhu ve sassatiyā arogo ",
  "snp5.7:7.3": "tamme munī sādhu viyākarohi ",
  "snp5.7:7.4": "tathā hi te vidito esa dhammo. ",
  "snp5.7:8.1": "atthaṅgatassa na pamāṇamatthi ",
  "snp5.7:8.2": "(upasīvāti bhagavā) ",
  "snp5.7:8.3": "yena naṃ vajju taṃ tassa natthi ",
  "snp5.7:8.4": "sabbesu dhammesu samūhatesu ",
  "snp5.7:8.5": "samūhatā vādapathāpi sabbeti. ",
  "snp5.7:8.6": "upasīvamāṇavakapañhā chaṭṭhī. suttanipāte pañcamassa pārāyanavaggassa sattamā nandapañhā. "
}
