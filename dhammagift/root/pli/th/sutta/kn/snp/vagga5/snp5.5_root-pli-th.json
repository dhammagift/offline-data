{
  "snp5.5:0.1": "suttanipāte pañcamassa pārāyanavaggassa catutthī mettagūpañhā ",
  "snp5.5:0.2": "",
  "snp5.5:1.1": "4 pucchāmi taṃ bhagavā brūhi me taṃ ",
  "snp5.5:1.2": "(iccāyasmā mettagū) ",
  "snp5.5:1.3": "maññāmi taṃ vedaguṃ bhāvitattaṃ ",
  "snp5.5:1.4": "kuto nu dukkhā samupāgatāme ",
  "snp5.5:1.5": "ye keci lokasmiṃ anekarūpā. ",
  "snp5.5:2.1": "dukkhassa ve maṃ pabhavaṃ apucchasi ",
  "snp5.5:2.2": "(mettagūti bhagavā) ",
  "snp5.5:2.3": "tante pavakkhāmi yathā pajānaṃ ",
  "snp5.5:2.4": "upadhīnidānā pabhavanti dukkhā ",
  "snp5.5:2.5": "ye keci lokasmiṃ anekarūpā ",
  "snp5.5:3.1": "yo ve avidvā upadhiṃ karoti ",
  "snp5.5:3.2": "punappunaṃ dukkhamupeti mando ",
  "snp5.5:3.3": "tasmā pajānaṃ upadhiṃ na kayirā ",
  "snp5.5:3.4": "dukkhassa jātippabhavānupassī. ",
  "snp5.5:4.1": "yantaṃ apucchimha akittayi no ",
  "snp5.5:4.2": "aññaṃ pucchāma tadiṅgha brūhi ",
  "snp5.5:4.3": "kathaṃ nu dhīrā vitaranti oghaṃ ",
  "snp5.5:4.4": "jātijaraṃ sokapariddavañca ",
  "snp5.5:4.5": "tamme munī sādhu viyākarohi ",
  "snp5.5:4.6": "tathā hi te vidito esa dhammo. ",
  "snp5.5:5.1": "kittayissāmi te dhammaṃ ",
  "snp5.5:5.2": "(mettagūti bhagavā) ",
  "snp5.5:5.3": "diṭṭhe dhamme anītihaṃ ",
  "snp5.5:5.4": "yaṃ viditvā sato caraṃ ",
  "snp5.5:5.5": "tare loke visattikaṃ. ",
  "snp5.5:6.1": "tañcāhaṃ abhinandāmi ",
  "snp5.5:6.2": "mahesi dhammamuttamaṃ ",
  "snp5.5:6.3": "yaṃ viditvā sato caraṃ ",
  "snp5.5:6.4": "tare loke visattikaṃ. ",
  "snp5.5:7.1": "yaṅkiñci sampajānāsi ",
  "snp5.5:7.2": "(mettagūti bhagavā) ",
  "snp5.5:7.3": "uddhaṃ adho tiriyañcāpi majjhe ",
  "snp5.5:7.4": "etesu nandiñca nivesanañca ",
  "snp5.5:7.5": "panujja viññāṇaṃ bhave na tiṭṭhe ",
  "snp5.5:8.1": "evaṃvihārī sato appamatto ",
  "snp5.5:8.2": "bhikkhu caraṃ hitvā mamāyitāni ",
  "snp5.5:8.3": "jātijaraṃ sokapariddavañca ",
  "snp5.5:8.4": "idheva vidvā pajaheyya dukkhaṃ. ",
  "snp5.5:9.1": "etābhinandāmi vaco mahesino ",
  "snp5.5:9.2": "sukittitaṃ gotama nūpadhīkaṃ ",
  "snp5.5:9.3": "addhā hi bhagavā pahāsi dukkhaṃ ",
  "snp5.5:9.4": "tathā hi te vidito esa dhammo. ",
  "snp5.5:10.1": "te cāpi nūna pajaheyyu dukkhaṃ ",
  "snp5.5:10.2": "ye tvaṃ munī aṭṭhitaṃ ovadeyya ",
  "snp5.5:10.3": "taṃ taṃ namassāmi samecca nāga ",
  "snp5.5:10.4": "appeva maṃ (bhagavā) aṭṭhitaṃ ovadeyya. ",
  "snp5.5:11.1": "yaṃ brāhmaṇaṃ vedaguṃ abhijaññaṃ ",
  "snp5.5:11.2": "akiñcanaṃ kāmabhave asattaṃ ",
  "snp5.5:11.3": "addhā hi so oghamimaṃ atāri ",
  "snp5.5:11.4": "tiṇṇo ca pāraṃ akhilo akaṅkho ",
  "snp5.5:12.1": "vidvā ca so vedagū naro idha ",
  "snp5.5:12.2": "bhavābhave saṅgamimaṃ visajja ",
  "snp5.5:12.3": "so vītataṇho anigho nirāso ",
  "snp5.5:12.4": "atāri so jātijaranti brūmīti. ",
  "snp5.5:12.5": "mettagūmāṇavakapañhā catutthī. "
}
