{
  "snp5.14:0.1": "suttanipāte pañcamassa pārāyanavaggassa terasamā udayapañhā ",
  "snp5.14:0.2": "",
  "snp5.14:1.1": "13 jhāyiṃ virajamāsinaṃ ",
  "snp5.14:1.2": "(iccāyasmā udayo) ",
  "snp5.14:1.3": "katakiccaṃ anāsavaṃ ",
  "snp5.14:1.4": "pāraguṃ sabbadhammānaṃ ",
  "snp5.14:1.5": "atthī pañhena āgamaṃ ",
  "snp5.14:1.6": "aññaṃ vimokkhaṃ pabrūhi ",
  "snp5.14:1.7": "avijjāya pabhedanaṃ. ",
  "snp5.14:2.1": "pahānaṃ kāmachandānaṃ ",
  "snp5.14:2.2": "(udayāti bhagavā) ",
  "snp5.14:2.3": "domanassāna cūbhayaṃ ",
  "snp5.14:2.4": "thīnassa ca panudanaṃ ",
  "snp5.14:2.5": "kukkuccānaṃ nivāraṇaṃ ",
  "snp5.14:3.1": "upekkhāsatisaṃsuddhaṃ ",
  "snp5.14:3.2": "dhammatakkapurejavaṃ ",
  "snp5.14:3.3": "aññaṃ vimokkhaṃ pabrūmi ",
  "snp5.14:3.4": "avijjāya pabhedanaṃ. ",
  "snp5.14:4.1": "kiṃsu saññojano loko ",
  "snp5.14:4.2": "kiṃsu tassa vicāraṇā ",
  "snp5.14:4.3": "kissassa vippahānena ",
  "snp5.14:4.4": "nibbānaṃ iti vuccati. ",
  "snp5.14:5.1": "nandisaññojano loko ",
  "snp5.14:5.2": "vitakkassa vicāraṇā ",
  "snp5.14:5.3": "taṇhāya vippahānena ",
  "snp5.14:5.4": "nibbānaṃ iti vuccati. ",
  "snp5.14:6.1": "kathaṃsatassa carato ",
  "snp5.14:6.2": "viññāṇaṃ uparujjhati ",
  "snp5.14:6.3": "bhavantaṃ puṭṭhumāgamma ",
  "snp5.14:6.4": "taṃ sujhoma vaco tava. ",
  "snp5.14:7.1": "ajjhattañca bahiddhā ca ",
  "snp5.14:7.2": "vedanaṃ nābhinandato ",
  "snp5.14:7.3": "evaṃsatassa carato ",
  "snp5.14:7.4": "viññāṇaṃ uparujjhatīti. ",
  "snp5.14:7.5": "udayamāṇavakapañhā terasamā. "
}
