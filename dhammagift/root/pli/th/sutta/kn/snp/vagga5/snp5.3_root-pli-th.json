{
  "snp5.3:0.1": "",
  "snp5.3:0.2": "",
  "snp5.3:1.1": "kodha santusito loke ",
  "snp5.3:1.2": "(iccāyasmā tissametteyyo) ",
  "snp5.3:1.3": "kassa no santi iñjitā ",
  "snp5.3:1.4": "ko ubhantamabhiññāya ",
  "snp5.3:1.5": "majjhe mantā na limpati ",
  "snp5.3:1.6": "kaṃ brūsi mahāpurisoti ",
  "snp5.3:1.7": "ko idha sibbanimaccagā. ",
  "snp5.3:2.1": "kāmesu brahmacariyavā ",
  "snp5.3:2.2": "(metteyyāti bhagavā) ",
  "snp5.3:2.3": "vītataṇho sadā sato ",
  "snp5.3:2.4": "saṅkhāya nibbuto bhikkhu ",
  "snp5.3:2.5": "tassa no santi iñjitā ",
  "snp5.3:3.1": "so ubhantamabhiññāya ",
  "snp5.3:3.2": "majjhe mantā na limpati ",
  "snp5.3:3.3": "taṃ brūmi mahāpurisoti ",
  "snp5.3:3.4": "so idha sibbanimaccagāti. ",
  "snp5.3:3.5": "tissametteyyamāṇavakapañhā dutiyā. suttanipāte pañcamassa pārāyanavaggassa tatiyā puṇṇakapañhā 3 "
}
