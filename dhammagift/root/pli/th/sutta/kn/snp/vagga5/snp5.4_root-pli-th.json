{
  "snp5.4:0.1": "",
  "snp5.4:0.2": "",
  "snp5.4:1.1": "anejaṃ mūladassāviṃ ",
  "snp5.4:1.2": "(iccāyasmā puṇṇako) ",
  "snp5.4:1.3": "atthī pañhena āgamaṃ ",
  "snp5.4:1.4": "kiṃ nissitā isayo manujā ",
  "snp5.4:1.5": "khattiyā brāhmaṇā devatānaṃ ",
  "snp5.4:1.6": "yaññamakappiṃsu puthūdha loke ",
  "snp5.4:1.7": "pucchāmi taṃ bhagavā brūhi me taṃ. ",
  "snp5.4:2.1": "ye kecime isayo manujā ",
  "snp5.4:2.2": "(puṇṇakāti bhagavā) ",
  "snp5.4:2.3": "khattiyā brāhmaṇā devatānaṃ ",
  "snp5.4:2.4": "yaññamakappiṃsu puthūdha loke ",
  "snp5.4:2.5": "āsiṃsamānā puṇṇaka itthataṃ ",
  "snp5.4:2.6": "jaraṃ sitā yaññamakappayiṃsu. ",
  "snp5.4:3.1": "ye kecime isayo manujā ",
  "snp5.4:3.2": "(iccāyasmā puṇṇako) ",
  "snp5.4:3.3": "khattiyā brāhmaṇā devatānaṃ ",
  "snp5.4:3.4": "yaññamakappiṃsu puthūdha loke ",
  "snp5.4:3.5": "kaccissu te bhagavā (yaññapathe) appamattā ",
  "snp5.4:3.6": "atāru jātiñca jarañca mārisa ",
  "snp5.4:3.7": "pucchāmi taṃ bhagavā brūhi me taṃ. ",
  "snp5.4:4.1": "āsiṃsanti thomayanti (abhijappanti) juhanti ",
  "snp5.4:4.2": "(puṇṇakāti bhagavā) ",
  "snp5.4:4.3": "kāmābhijappanti paṭicca lābhaṃ ",
  "snp5.4:4.4": "te yājayogā bhavarāgarattā ",
  "snp5.4:4.5": "nātariṃsu jātijaranti brūmi. ",
  "snp5.4:5.1": "te ce nātariṃsu yājayogā ",
  "snp5.4:5.2": "(iccāyasmā puṇṇako) ",
  "snp5.4:5.3": "yaññehi jātiñca jarañca mārisa ",
  "snp5.4:5.4": "atha ko carahi devamanussaloke ",
  "snp5.4:5.5": "atāri jātiñca jarañca mārisa ",
  "snp5.4:5.6": "pucchāmi taṃ bhagavā brūhi me taṃ. ",
  "snp5.4:6.1": "saṅkhāya lokasmiṃ parovarāni ",
  "snp5.4:6.2": "(puṇṇakāti bhagavā) ",
  "snp5.4:6.3": "yassiñjitaṃ natthi kuhiñci loke ",
  "snp5.4:6.4": "santo vidhūmo anigho nirāso ",
  "snp5.4:6.5": "atāri so jātijarañca brūmīti. ",
  "snp5.4:6.6": "puṇṇakamāṇavakapañhā tatiyā. suttanipāte pañcamassa pārāyanavaggassa catutthī mettagūpañhā 4 "
}
