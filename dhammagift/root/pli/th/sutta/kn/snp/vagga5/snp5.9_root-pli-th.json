{
  "snp5.9:0.1": "",
  "snp5.9:0.2": "",
  "snp5.9:1.1": "pubbe viyākaṃsu ",
  "snp5.9:1.2": "(iccāyasmā hemako) ",
  "snp5.9:1.3": "(huraṃ gotamasāsanā) ",
  "snp5.9:1.4": "iccāsi iti bhavissati ",
  "snp5.9:1.5": "sabbantaṃ itihītihaṃ ",
  "snp5.9:1.6": "sabbantaṃ takkavaḍḍhanaṃ ",
  "snp5.9:1.7": "(nāhaṃ tattha abhiramiṃ) ",
  "snp5.9:2.1": "tvañca me dhammamakkhāhi ",
  "snp5.9:2.2": "taṇhānigghātanaṃ muni ",
  "snp5.9:2.3": "yaṃ viditvā sato caraṃ ",
  "snp5.9:2.4": "tare loke visattikaṃ. ",
  "snp5.9:3.1": "idha diṭṭhasutamutaṃ (viññātesu) ",
  "snp5.9:3.2": "piyarūpesu hemaka ",
  "snp5.9:3.3": "chandarāgavinodanaṃ ",
  "snp5.9:3.4": "nibbānapadamaccutaṃ ",
  "snp5.9:4.1": "etadaññāya ye satā ",
  "snp5.9:4.2": "diṭṭhadhammābhinibbutā ",
  "snp5.9:4.3": "upasantā ca te satā ",
  "snp5.9:4.4": "tiṇṇā loke visattikanti. ",
  "snp5.9:4.5": "hemakamāṇavakapañhā aṭṭhamā. suttanipāte pañcamassa pārāyanavaggassa navamā todeyyapañhā 9 "
}
