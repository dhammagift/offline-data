{
  "snp5.8:0.1": "",
  "snp5.8:0.2": "",
  "snp5.8:1.1": "santi loke munayo ",
  "snp5.8:1.2": "(iccāyasmā nando) ",
  "snp5.8:1.3": "janā vadanti tayidaṃ kathaṃ su ",
  "snp5.8:1.4": "ñāṇūpapannaṃ muni no vadanti ",
  "snp5.8:1.5": "udāhu ve jīvitenūpapannaṃ. ",
  "snp5.8:2.1": "na diṭṭhiyā na sutiyā na ñāṇena (na sīlabbatena) ",
  "snp5.8:2.2": "munīdha nanda kusalā vadanti ",
  "snp5.8:2.3": "visenikatvā anighā nirāsā ",
  "snp5.8:2.4": "vadanti ye te munayoti brūmi. ",
  "snp5.8:3.1": "ye kecime samaṇabrāhmaṇā se ",
  "snp5.8:3.2": "(iccāyasmā nando) ",
  "snp5.8:3.3": "diṭṭhe sutenāpi vadanti suddhiṃ ",
  "snp5.8:3.4": "sīlabbatenāpi vadanti suddhiṃ ",
  "snp5.8:3.5": "anekarūpena vadanti suddhiṃ. ",
  "snp5.8:3.6": "kaccissu te (bhagavā) tattha yathā carantā ",
  "snp5.8:3.7": "atāru jātiñca jarañca mārisa ",
  "snp5.8:3.8": "pucchāmi taṃ bhagavā brūhi me taṃ. ",
  "snp5.8:4.1": "ye kecime samaṇabrāhmaṇā se ",
  "snp5.8:4.2": "(nandāti bhagavā) ",
  "snp5.8:4.3": "diṭṭhe sutenāpi vadanti suddhiṃ ",
  "snp5.8:4.4": "sīlabbatenāpi vadanti suddhiṃ ",
  "snp5.8:4.5": "anekarūpena vadanti suddhiṃ ",
  "snp5.8:4.6": "kiñcāpi te tattha yathā caranti ",
  "snp5.8:4.7": "nātariṃsu jātijaranti brūmi. ",
  "snp5.8:5.1": "ye kecime samaṇabrāhmaṇā se ",
  "snp5.8:5.2": "(iccāyasmā nando) ",
  "snp5.8:5.3": "diṭṭhe sutenāpi vadanti suddhiṃ ",
  "snp5.8:5.4": "sīlabbatenāpi vadanti suddhiṃ ",
  "snp5.8:5.5": "anekarūpena vadanti suddhiṃ ",
  "snp5.8:5.6": "te ce muni brūsi anoghatiṇṇe ",
  "snp5.8:5.7": "atha ko carahi devamanussaloke ",
  "snp5.8:5.8": "atāri jātiñca jarañca mārisa ",
  "snp5.8:5.9": "pucchāmi taṃ bhagavā brūhi me taṃ. ",
  "snp5.8:6.1": "nāhaṃ sabbe samaṇabrāhmaṇā se ",
  "snp5.8:6.2": "(nandāti bhagavā) ",
  "snp5.8:6.3": "jātijarāya nivutāti brūmi ",
  "snp5.8:6.4": "yesīdha diṭṭhaṃ va sutaṃ mutaṃ vā ",
  "snp5.8:6.5": "sīlabbataṃ vāpi pahāya sabbaṃ ",
  "snp5.8:6.6": "anekarūpampi pahāya sabbaṃ ",
  "snp5.8:6.7": "taṇhaṃ pariññāya anāsavā ye ",
  "snp5.8:6.8": "te ve narā oghatiṇṇāti brūmi. ",
  "snp5.8:7.1": "etābhinandāmi vaco mahesino ",
  "snp5.8:7.2": "sukittitaṃ gotama nūpadhīkaṃ ",
  "snp5.8:7.3": "yesīdha diṭṭhaṃ va sutaṃ mutaṃ vā ",
  "snp5.8:7.4": "sīlabbataṃ vāpi pahāya sabbaṃ ",
  "snp5.8:7.5": "anekarūpampi pahāya sabbaṃ ",
  "snp5.8:7.6": "taṇhaṃ pariññāya anāsavā ye ",
  "snp5.8:7.7": "ahampi te oghatiṇṇāti brūmīti. ",
  "snp5.8:7.8": "nandamāṇavakapañhā sattamā. suttanipāte pañcamassa pārāyanavaggassa aṭṭhamā hemakapañhā 8 yeme "
}
