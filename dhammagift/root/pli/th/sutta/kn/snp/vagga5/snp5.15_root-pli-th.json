{
  "snp5.15:0.1": "",
  "snp5.15:0.2": "",
  "snp5.15:1.1": "yo atītaṃ ādisati ",
  "snp5.15:1.2": "(iccāyasmā posālo) ",
  "snp5.15:1.3": "anejo chinnasaṃsayo ",
  "snp5.15:1.4": "pāragū sabbadhammānaṃ ",
  "snp5.15:1.5": "atthī pañhena āgamaṃ ",
  "snp5.15:2.1": "vibhūtarūpasaññissa ",
  "snp5.15:2.2": "sabbakāyappahāyino ",
  "snp5.15:2.3": "ajjhattañca bahiddhā ca ",
  "snp5.15:2.4": "natthi kiñcīti passato ",
  "snp5.15:2.5": "ñāṇaṃ sakkānupucchāmi ",
  "snp5.15:2.6": "kathaṃ neyyo tathāvidho. ",
  "snp5.15:3.1": "viññāṇaṭṭhitiyo sabbā ",
  "snp5.15:3.2": "(posālāti bhagavā) ",
  "snp5.15:3.3": "abhijānaṃ tathāgato ",
  "snp5.15:3.4": "tiṭṭhantamenaṃ jānāti ",
  "snp5.15:3.5": "vimuttaṃ tapparāyanaṃ ",
  "snp5.15:4.1": "ākiñcaññāsambhavaṃ nandisaññojanaṃ ",
  "snp5.15:4.2": "iti ",
  "snp5.15:4.3": "evamevaṃ abhiññāya ",
  "snp5.15:4.4": "tato tattha vipassati ",
  "snp5.15:4.5": "evaṃ ñāṇaṃ kathaṃ tassa ",
  "snp5.15:4.6": "brāhmaṇassa vusīmatoti. ",
  "snp5.15:4.7": "posālamāṇavakapañhā cuddasamā. suttanipāte pañcamassa pārāyanavaggassa paṇṇarasamā mogharājapañhā 15 "
}
