{
  "snp5.11:0.1": "suttanipāte pañcamassa pārāyanavaggassa dasamā kappapañhā ",
  "snp5.11:0.2": "",
  "snp5.11:1.1": "10 majjhe sarasmiṃ tiṭṭhataṃ ",
  "snp5.11:1.2": "(iccāyasmā kappo) ",
  "snp5.11:1.3": "oghe jāte mahabbhaye ",
  "snp5.11:1.4": "jarāmaccuparetānaṃ ",
  "snp5.11:1.5": "dīpaṃ pabrūhi mārisa ",
  "snp5.11:1.6": "tvañca me dīpamakkhāhi ",
  "snp5.11:1.7": "yathāyidaṃ nāparaṃ siyā. ",
  "snp5.11:2.1": "majjhe sarasmiṃ tiṭṭhataṃ ",
  "snp5.11:2.2": "(kappāti bhagavā) ",
  "snp5.11:2.3": "oghe jāte mahabbhaye ",
  "snp5.11:2.4": "jarāmaccuparetānaṃ ",
  "snp5.11:2.5": "dīpaṃ pabrūmi kappa te. ",
  "snp5.11:3.1": "akiñcanaṃ anādānaṃ ",
  "snp5.11:3.2": "etaṃ dīpaṃ anāparaṃ ",
  "snp5.11:3.3": "nibbānaṃ iti naṃ brūmi ",
  "snp5.11:3.4": "jarāmaccuparikkhayaṃ. ",
  "snp5.11:4.1": "etadaññāya ye satā ",
  "snp5.11:4.2": "diṭṭhadhammābhinibbutā ",
  "snp5.11:4.3": "na te māravasānugā ",
  "snp5.11:4.4": "na te mārassa paṭṭhagūti. ",
  "snp5.11:4.5": "kappamāṇavakapañhā dasamā. "
}
