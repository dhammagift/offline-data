{
  "snp5.17:0.1": "",
  "snp5.17:0.2": "",
  "snp5.17:1.1": "jiṇṇohamasmī abalo vivaṇṇo ",
  "snp5.17:1.2": "(iccāyasmā piṅgiyo) ",
  "snp5.17:1.3": "nettā na suddhā savanaṃ na phāsu ",
  "snp5.17:1.4": "māhampanassaṃ momuho antarāya ",
  "snp5.17:1.5": "ācikkha dhammaṃ yamahaṃ vijaññaṃ ",
  "snp5.17:1.6": "jātijarāya idha vippahānaṃ. ",
  "snp5.17:2.1": "disvāna rūpesu vihaññamāne ",
  "snp5.17:2.2": "(piṅgiyāti bhagavā) ",
  "snp5.17:2.3": "ruppanti rūpesu janā pamattā ",
  "snp5.17:2.4": "tasmā tuvaṃ piṅgiya appamatto ",
  "snp5.17:2.5": "jahassu rūpaṃ apunabbhavāya. ",
  "snp5.17:3.1": "disā catasso vidisā catasso ",
  "snp5.17:3.2": "uddhaṃ adho dasa disā imāyo ",
  "snp5.17:3.3": "na tuyhaṃ adiṭṭhaṃ asutāmutaṃ vā ",
  "snp5.17:3.4": "atho aviññātaṃ kiñcimatthi loke ",
  "snp5.17:3.5": "ācikkha dhammaṃ yamahaṃ vijaññaṃ ",
  "snp5.17:3.6": "jātijarāya idha vippahānaṃ. ",
  "snp5.17:4.1": "tañhādhipanne manuje pekkhamāno ",
  "snp5.17:4.2": "(piṅgiyāti bhagavā) ",
  "snp5.17:4.3": "santāpajāte jarasāparete ",
  "snp5.17:4.4": "tasmā tuvaṃ piṅgiya appamatto ",
  "snp5.17:4.5": "jahassu taṇhaṃ apunabbhavāyāti. ",
  "snp5.17:4.6": "piṅgiyamāṇavakapañhā soḷasamā. "
}
