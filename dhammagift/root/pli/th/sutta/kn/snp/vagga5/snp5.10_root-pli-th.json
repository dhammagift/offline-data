{
  "snp5.10:0.1": "",
  "snp5.10:0.2": "",
  "snp5.10:1.1": "yasmiṃ kāmā na vasanti ",
  "snp5.10:1.2": "(iccāyasmā todeyyo) ",
  "snp5.10:1.3": "taṇhā yassa na vijjati ",
  "snp5.10:1.4": "kathaṅkathā ca yo tiṇṇo ",
  "snp5.10:1.5": "vimokkho tassa kīdiso. ",
  "snp5.10:2.1": "yasmiṃ kāmā na vasanti ",
  "snp5.10:2.2": "(todeyyāti bhagavā) ",
  "snp5.10:2.3": "taṇhā yassa na vijjati ",
  "snp5.10:2.4": "kathaṅkathā ca yo tiṇṇo ",
  "snp5.10:2.5": "vimokkho tassa nāparo. ",
  "snp5.10:3.1": "nirāsaso so uda āsasāno ",
  "snp5.10:3.2": "paññāṇavāso uda paññakappī ",
  "snp5.10:3.3": "muniṃ ahaṃ sakka yathā vijaññaṃ ",
  "snp5.10:3.4": "tamme viyācikkha samantacakkhu. ",
  "snp5.10:4.1": "nirāsaso so na ca āsasāno ",
  "snp5.10:4.2": "paññāṇavāso na ca paññakappī ",
  "snp5.10:4.3": "evampi todeyya muniṃ vijāna ",
  "snp5.10:4.4": "akiñcanaṃ kāmabhave asattanti. ",
  "snp5.10:4.5": "todeyyamāṇavakapañhā navamā. suttanipāte pañcamassa pārāyanavaggassa dasamā kappapañhā 10 "
}
