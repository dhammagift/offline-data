{
  "snp2.12:0.1": "suttanipāte dutiyassa cūḷavaggassa dvādasamaṃ vaṅgīsasuttaṃ ",
  "snp2.12:0.2": "",
  "snp2.12:1.1": "12 evamme sutaṃ. ",
  "snp2.12:1.2": "ekaṃ samayaṃ bhagavā āḷaviyaṃ viharati aggāḷave cetiye. ",
  "snp2.12:1.3": "tena kho pana samayena āyasmato vaṅgīsassa upajjhāyo nigrodhakappo nāma thero aggāḷave cetiye aciraparibbuto hoti. ",
  "snp2.12:1.4": "atha kho āyasmato vaṅgīsassa rahogatassa paṭisallīnassa evaṃ cetaso parivitakko udapādi ",
  "snp2.12:1.5": "parinibbuto nu kho me upajjhāyo udāhu no parinibbutoti. ",
  "snp2.12:1.6": "atha kho āyasmā vaṅgīso sāyaṇhasamayaṃ paṭisallānā vuṭṭhito yena bhagavā tenupasaṅkami upasaṅkamitvā bhagavantaṃ abhivādetvā ekamantaṃ nisīdi. ekamantaṃ nisinno kho āyasmā vaṅgīso bhagavantaṃ etadavoca ",
  "snp2.12:1.7": "idha mayhaṃ bhante rahogatassa paṭisallīnassa evaṃ cetaso parivitakko udapādi ",
  "snp2.12:1.8": "parinibbuto nu kho me upajjhāyo udāhu no parinibbutoti. ",
  "snp2.12:1.9": "atha kho āyasmā vaṅgīso uṭṭhāyāsanā ekaṃsaṃ cīvaraṃ katvā yena bhagavā tenañjalimpaṇāmetvā bhagavantaṃ gāthāya ajjhabhāsi ",
  "snp2.12:2.1": "pucchāma satthāraṃ anomapaññaṃ ",
  "snp2.12:2.2": "diṭṭheva dhamme yo vicikicchānaṃ chettā ",
  "snp2.12:2.3": "aggāḷave kālamakāsi bhikkhu ",
  "snp2.12:2.4": "ñāto yasassī abhinibbutatto. ",
  "snp2.12:3.1": "nigrodhakappo iti tassa nāmaṃ ",
  "snp2.12:3.2": "tayā kataṃ bhagavā brāhmaṇassa ",
  "snp2.12:3.3": "so taṃ namassaṃ acariṃ mutyapekkho ",
  "snp2.12:3.4": "āraddhaviriyo daḷhadhammadassī. ",
  "snp2.12:4.1": "taṃ sāvakaṃ sakka mayampi sabbe ",
  "snp2.12:4.2": "aññātumicchāma samantacakkhu ",
  "snp2.12:4.3": "samavaṭṭhitā no savanāya sotā ",
  "snp2.12:4.4": "tuvaṃ no satthā tvamanuttarosi. ",
  "snp2.12:5.1": "chindeva no vicikicchaṃ brūhi metaṃ ",
  "snp2.12:5.2": "parinibbutaṃ vedaya bhūripañña ",
  "snp2.12:5.3": "majjhe ca no bhāsa samantacakkhu ",
  "snp2.12:5.4": "sakkova devānaṃ sahassanetto. ",
  "snp2.12:6.1": "ye keci ganthā idha mohamaggā ",
  "snp2.12:6.2": "aññāṇapakkhā vicikicchaṭhānā ",
  "snp2.12:6.3": "tathāgataṃ patvā na te bhavanti ",
  "snp2.12:6.4": "cakkhuṃ hi etaṃ paramaṃ narānaṃ. ",
  "snp2.12:7.1": "no ce hi jātu puriso kilese ",
  "snp2.12:7.2": "vāto yathā abbhaghanaṃ vihāne ",
  "snp2.12:7.3": "tamovassa nivuto sabbaloko ",
  "snp2.12:7.4": "na jotimantopi narā tapeyyuṃ. ",
  "snp2.12:8.1": "dhīrā ca pajjotakarā bhavanti ",
  "snp2.12:8.2": "taṃ taṃ ahaṃ dhīra tatheva maññe ",
  "snp2.12:8.3": "vipassinaṃ jānamupāgamamha ",
  "snp2.12:8.4": "parisāsu no āvikarohi kappaṃ. ",
  "snp2.12:9.1": "khippaṃ giraṃ eraya vaggu vagguṃ ",
  "snp2.12:9.2": "haṃsāva paggayha saṇiṃ nikujja ",
  "snp2.12:9.3": "bindussarena suvikappitena ",
  "snp2.12:9.4": "sabbeva te ujjugatā suṇoma. ",
  "snp2.12:10.1": "pahīnajātimaraṇaṃ asesaṃ ",
  "snp2.12:10.2": "niggayha dhonaṃ vadessāmi dhammaṃ ",
  "snp2.12:10.3": "na kāmakāro hi puthujjanānaṃ ",
  "snp2.12:10.4": "saṅkheyyakāro ca tathāgatānaṃ. ",
  "snp2.12:11.1": "sampannaveyyākaraṇaṃ tvayidaṃ ",
  "snp2.12:11.2": "samujjapaññassa samuggahītaṃ ",
  "snp2.12:11.3": "ayamañjalī pacchimo suppaṇāmito ",
  "snp2.12:11.4": "mā mohayī jānamanomapañña. ",
  "snp2.12:12.1": "parovaraṃ ariyadhammaṃ viditvā ",
  "snp2.12:12.2": "mā mohayī jānamanomavīra ",
  "snp2.12:12.3": "vāriṃ yathā ghammani ghammatatto ",
  "snp2.12:12.4": "vācābhikaṅkhāmi sutassa vassa. ",
  "snp2.12:13.1": "yadatthikaṃ brahmacariyaṃ acāri ",
  "snp2.12:13.2": "kappāyano kiñcissa taṃ amoghaṃ ",
  "snp2.12:13.3": "nibbāyi so ādu saupādiseso ",
  "snp2.12:13.4": "yathā vimutto ahu taṃ suṇoma. ",
  "snp2.12:14.1": "acchecchi taṇhaṃ idha nāmarūpe ",
  "snp2.12:14.2": "(ti bhagavā) ",
  "snp2.12:14.3": "kaṇhassa sotaṃ dīgharattānusayitaṃ ",
  "snp2.12:14.4": "atāri jātiṃ maraṇaṃ asesaṃ ",
  "snp2.12:14.5": "iccabravī bhagavā pañcaseṭṭho. ",
  "snp2.12:15.1": "esa sutvā pasīdāmi ",
  "snp2.12:15.2": "vaco te isisattamū ",
  "snp2.12:15.3": "amoghaṃ kira me puṭṭhaṃ ",
  "snp2.12:15.4": "na maṃ vañcesi brāhmaṇo ",
  "snp2.12:16.1": "yathāvādī tathākārī ",
  "snp2.12:16.2": "ahu buddhassa sāvako ",
  "snp2.12:16.3": "acchidā maccuno jālaṃ ",
  "snp2.12:16.4": "taṃ taṃ māyāvino daḷhaṃ. ",
  "snp2.12:17.1": "addasa bhagavā ādiṃ ",
  "snp2.12:17.2": "upādānassa kappiyo ",
  "snp2.12:17.3": "accagā vata kappāyano ",
  "snp2.12:17.4": "maccudheyyaṃ suduttaranti. ",
  "snp2.12:17.5": "vaṅgīsasuttaṃ dvādasamaṃ. "
}
