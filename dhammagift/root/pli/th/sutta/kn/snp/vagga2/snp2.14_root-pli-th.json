{
  "snp2.14:0.1": "suttanipāte dutiyassa cūḷavaggassa cuddasamaṃ dhammikasuttaṃ ",
  "snp2.14:0.2": "",
  "snp2.14:1.1": "14 evamme sutaṃ. ",
  "snp2.14:1.2": "ekaṃ samayaṃ bhagavā sāvatthiyaṃ viharati jetavane anāthapiṇḍikassa ārāme. ",
  "snp2.14:1.3": "atha kho dhammiko upāsako pañcahi upāsakasatehi saddhiṃ yena bhagavā tenupasaṅkami upasaṅkamitvā bhagavantaṃ abhivādetvā ekamantaṃ nisīdi. ekamantaṃ nisinno kho dhammiko upāsako bhagavantaṃ gāthāya ajjhabhāsi ",
  "snp2.14:2.1": "pucchāmi taṃ gotama bhūripañña ",
  "snp2.14:2.2": "kathaṅkaro sāvako sādhu hoti ",
  "snp2.14:2.3": "yo vā agārā anagārameti ",
  "snp2.14:2.4": "agārino vā panupāsakāse. ",
  "snp2.14:3.1": "tuvañhi lokassa sadevakassa ",
  "snp2.14:3.2": "gatiṃ pajānāsi parāyanañca ",
  "snp2.14:3.3": "na tatthi tulyo nipuṇatthadassī ",
  "snp2.14:3.4": "tuvañhi buddhaṃ pavaraṃ vadanti. ",
  "snp2.14:4.1": "sabbaṃ tuvaṃ ñāṇamavecca dhammaṃ ",
  "snp2.14:4.2": "pakāsesi satte anukampamāno ",
  "snp2.14:4.3": "vivaṭacchadosi samantacakkhu ",
  "snp2.14:4.4": "virocasi vimalo sabbaloke. ",
  "snp2.14:5.1": "agacchi te santike nāgarājā ",
  "snp2.14:5.2": "erāvaṇo nāma jinoti sutvā ",
  "snp2.14:5.3": "sopi tayā mantayitvājjhagamā ",
  "snp2.14:5.4": "sādhūti sutvāna patītarūpo. ",
  "snp2.14:6.1": "rājāpi taṃ vessavaṇo kuvero ",
  "snp2.14:6.2": "upeti dhammaṃ paripucchamāno ",
  "snp2.14:6.3": "tassāpi tvaṃ pucchito bravīsi ",
  "snp2.14:6.4": "so cāpi sutvāna patītarūpo. ",
  "snp2.14:7.1": "ye kecime titthiyā vādasīlā ",
  "snp2.14:7.2": "ājīvakā vā yadi vā niganthā ",
  "snp2.14:7.3": "paññāya taṃ nātitaranti sabbe ",
  "snp2.14:7.4": "ṭhito vajantaṃ viya sīghagāmiṃ. ",
  "snp2.14:8.1": "ye kecime brāhmaṇā vādasīlā ",
  "snp2.14:8.2": "vuḍḍhā vāpi brāhmaṇā santi keci ",
  "snp2.14:8.3": "sabbe tayī atthabaddhā bhavanti ",
  "snp2.14:8.4": "ye cāpi aññe vādino maññamānā. ",
  "snp2.14:9.1": "ayañhi dhammo nipuṇo sukho ca ",
  "snp2.14:9.2": "yoyaṃ tayā bhagavā suppavutto ",
  "snp2.14:9.3": "tameva sabbe mayaṃ sussumānā ",
  "snp2.14:9.4": "taṃ no vada pucchito buddhaseṭṭha. ",
  "snp2.14:10.1": "sabbepime bhikkhavo sannisinnā ",
  "snp2.14:10.2": "upāsakā cāpi tattheva sotuṃ ",
  "snp2.14:10.3": "suṇantu dhammaṃ vimalenānubuddhaṃ ",
  "snp2.14:10.4": "subhāsitaṃ vāsavasseva devā. ",
  "snp2.14:11.1": "suṇātha me bhikkhavo sāvayāmi vo ",
  "snp2.14:11.2": "dhammaṃ dhutaṃ tañca carātha sabbe ",
  "snp2.14:11.3": "iriyāpathaṃ pabbajitānulomikaṃ ",
  "snp2.14:11.4": "sevetha naṃ atthadassī matimā. ",
  "snp2.14:12.1": "no ve vikāle vicareyya bhikkhu ",
  "snp2.14:12.2": "gāme ca piṇḍāya careyya kāle ",
  "snp2.14:12.3": "akālacāriṃ hi sajanti saṅgā ",
  "snp2.14:12.4": "tasmā vikāle na caranti buddhā. ",
  "snp2.14:13.1": "rūpā ca saddā ca rasā ca gandhā ",
  "snp2.14:13.2": "phassā ca ye sammadayanti satte ",
  "snp2.14:13.3": "etesu dhammesu vineyya chandaṃ ",
  "snp2.14:13.4": "kālena so pavise pātarāsaṃ. ",
  "snp2.14:14.1": "piṇḍaṃ ca bhikkhu samayena laddhā ",
  "snp2.14:14.2": "eko paṭikkamma raho nisīde ",
  "snp2.14:14.3": "ajjhattacintī na mano bahiddhā ",
  "snp2.14:14.4": "nicchāraye saṅgahitattabhāvo. ",
  "snp2.14:15.1": "sacepi so sallape sāvakena ",
  "snp2.14:15.2": "aññena vā kenaci bhikkhunā vā ",
  "snp2.14:15.3": "dhammaṃ paṇītaṃ tamudāhareyya ",
  "snp2.14:15.4": "na pesuṇaṃ nopi parūpavādaṃ. ",
  "snp2.14:16.1": "vādañhi eke paṭiseniyanti ",
  "snp2.14:16.2": "na te pasaṃsāma parittapaññe ",
  "snp2.14:16.3": "tato tato ne pasajanti saṅgā ",
  "snp2.14:16.4": "cittañhi te tattha gamenti dūre. ",
  "snp2.14:17.1": "piṇḍaṃ vihāraṃ sayanāsanañca ",
  "snp2.14:17.2": "āpañca saṅghāṭirajūpavāhanaṃ ",
  "snp2.14:17.3": "sutvāna dhammaṃ sugatena desitaṃ ",
  "snp2.14:17.4": "saṅkhāya seve varapaññasāvako. ",
  "snp2.14:18.1": "tasmā hi piṇḍe sayanāsane ca ",
  "snp2.14:18.2": "āpe ca saṅghāṭirajūpavāhane ",
  "snp2.14:18.3": "etesu dhammesu anūpalitto ",
  "snp2.14:18.4": "bhikkhu yathā pokkhare vāribindu. ",
  "snp2.14:19.1": "gahaṭṭhavattaṃ pana vo vadāmi ",
  "snp2.14:19.2": "yathākaro sāvako sādhu hoti ",
  "snp2.14:19.3": "na hesa labbhā sapariggahena ",
  "snp2.14:19.4": "phassetu yo kevalo bhikkhudhammo. ",
  "snp2.14:20.1": "pāṇaṃ na hane na ca ghātayeyya ",
  "snp2.14:20.2": "na cānujaññā hanataṃ paresaṃ ",
  "snp2.14:20.3": "sabbesu bhūtesu nidhāya daṇḍaṃ ",
  "snp2.14:20.4": "ye thāvarā ye ca tasā santi loke. ",
  "snp2.14:21.1": "tato adinnaṃ parivajjayeyya ",
  "snp2.14:21.2": "kiñci kvaci sāvako bujjhamāno ",
  "snp2.14:21.3": "na hāraye harataṃ nānujaññā ",
  "snp2.14:21.4": "sabbaṃ adinnaṃ parivajjayeyya. ",
  "snp2.14:22.1": "abrahmacariyaṃ parivajjayeyya ",
  "snp2.14:22.2": "aṅgārakāsuṃ jalitaṃva viññū ",
  "snp2.14:22.3": "asambhuṇanto pana brahmacariyaṃ ",
  "snp2.14:22.4": "parassa dāraṃ nātikkameyya. ",
  "snp2.14:23.1": "sabhaggato vā parisaggato vā ",
  "snp2.14:23.2": "ekassa ceko na musā bhaṇeyya ",
  "snp2.14:23.3": "na bhāṇaye bhaṇataṃ nānujaññā ",
  "snp2.14:23.4": "sabbaṃ abhūtaṃ parivajjayeyya. ",
  "snp2.14:24.1": "majjañca pāṇaṃ na samācareyya ",
  "snp2.14:24.2": "dhammaṃ idaṃ rocaye yo gahaṭṭho ",
  "snp2.14:24.3": "na pāyaye pivitaṃ nānujaññā ",
  "snp2.14:24.4": "ummādanantaṃ iti naṃ viditvā. ",
  "snp2.14:25.1": "madā hi pāpāni karonti bālā ",
  "snp2.14:25.2": "kārenti caññepi jane pamatte ",
  "snp2.14:25.3": "etaṃ apuññāyatanaṃ vivajjaye ",
  "snp2.14:25.4": "ummādanaṃ mohanaṃ bālakantaṃ. ",
  "snp2.14:26.1": "pāṇaṃ na hane na cādinnamādiye ",
  "snp2.14:26.2": "musā na bhāse na ca majjapo siyā ",
  "snp2.14:26.3": "abrahmacariyā virameyya methunā ",
  "snp2.14:26.4": "rattiṃ na bhuñjeyya vikālabhojanaṃ ",
  "snp2.14:27.1": "mālaṃ na dhāre na ca gandhamācare ",
  "snp2.14:27.2": "mañce chamāyaṃ va sayetha santhate ",
  "snp2.14:27.3": "etaṃ hi aṭṭhaṅgikamāhuposathaṃ ",
  "snp2.14:27.4": "buddhena dukkhantagunā pakāsitaṃ. ",
  "snp2.14:28.1": "tato ca pakkhassupavassuposathaṃ ",
  "snp2.14:28.2": "cātuddasiṃ pañcadasiñca aṭṭhamiṃ ",
  "snp2.14:28.3": "pāṭihārikapakkhañca pasannamānaso ",
  "snp2.14:28.4": "aṭṭhaṅgupetaṃ susamattarūpaṃ. ",
  "snp2.14:29.1": "tato ca pāto upavuṭṭhuposatho ",
  "snp2.14:29.2": "annena pānena ca bhikkhusaṅghaṃ ",
  "snp2.14:29.3": "pasannacitto anumodamāno ",
  "snp2.14:29.4": "yathārahaṃ saṃvibhajetha viññū. ",
  "snp2.14:30.1": "dhammena mātāpitaro bhareyya ",
  "snp2.14:30.2": "payojaye dhammikaṃ so vaṇijjaṃ ",
  "snp2.14:30.3": "etaṃ gihīvattayamappamatto ",
  "snp2.14:30.4": "sayampabhe nāma upeti deveti. ",
  "snp2.14:30.5": "dhammikasuttaṃ cuddasamaṃ. ",
  "snp2.14:30.6": "cūḷavaggo dutiyo. ",
  "snp2.14:31.0": "tassuddānaṃ ",
  "snp2.14:31.1": "ratanāmagandho hiri ca ",
  "snp2.14:31.2": "maṅgalaṃ sūcilomena ",
  "snp2.14:31.3": "kapilo brāhmaṇopi ca ",
  "snp2.14:31.4": "nāvā kiṃsīlauṭṭhāno ",
  "snp2.14:32.1": "rāhulo puna vaṅgīso paribbājaniyo ",
  "snp2.14:32.2": "tathā ",
  "snp2.14:32.3": "dhammikañca viduno ahu ",
  "snp2.14:32.4": "cuḷavaggañhi cuddasāti. "
}
