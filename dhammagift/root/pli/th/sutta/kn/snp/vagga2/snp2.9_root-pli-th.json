{
  "snp2.9:0.1": "suttanipāte dutiyassa cūḷavaggassa navamaṃ kiṃsīlasuttaṃ ",
  "snp2.9:0.2": "",
  "snp2.9:1.1": "9 kiṃsīlo kiṃsamācāro ",
  "snp2.9:1.2": "kāni kammāni brūhayaṃ ",
  "snp2.9:1.3": "naro sammāniviṭṭhassa ",
  "snp2.9:1.4": "uttamatthañca pāpuṇe. ",
  "snp2.9:2.1": "vuḍḍhāpacāyī anusuyyako siyā ",
  "snp2.9:2.2": "kālaññu cassa gurunaṃ dassanāya ",
  "snp2.9:2.3": "dhammiṃ kathaṃ erayitaṃ khaṇaññū ",
  "snp2.9:2.4": "suṇeyya sakkacca subhāsitāni. ",
  "snp2.9:3.1": "kālena gacche gurunaṃ sakāsaṃ ",
  "snp2.9:3.2": "thambhaṃ niraṅkatvā nivātavuttī ",
  "snp2.9:3.3": "atthaṃ dhammaṃ saṃyamaṃ brahmacariyaṃ ",
  "snp2.9:3.4": "anussare ceva sammācare ca. ",
  "snp2.9:4.1": "dhammārāmo dhammarato ",
  "snp2.9:4.2": "dhamme ṭhito dhammavinicchayaññū ",
  "snp2.9:4.3": "nevācare dhammasandosavādaṃ ",
  "snp2.9:4.4": "tacchehi nīyetha subhāsitehi. ",
  "snp2.9:5.1": "hassaṃ ca jappaṃ paridevaṃ padosaṃ ",
  "snp2.9:5.2": "māyākataṃ kūhanaṃ giddhimānaṃ ",
  "snp2.9:5.3": "sārambhakakkassakasāvamucchaṃ ",
  "snp2.9:5.4": "hitvā care vītamado ṭhitatto. ",
  "snp2.9:6.1": "viññātasārāni subhāsitāni ",
  "snp2.9:6.2": "sutañca viññāta samādhisāraṃ ",
  "snp2.9:6.3": "na tassa paññā ca sutañca vaḍḍhati ",
  "snp2.9:6.4": "yo sāhaso hoti naro pamatto. ",
  "snp2.9:7.1": "dhamme ca ye ariyappavedite ratā ",
  "snp2.9:7.2": "anuttarā te vacasā manasā kammunā ca ",
  "snp2.9:7.3": "te santisoraccasamādhisaṇṭhitā ",
  "snp2.9:7.4": "sutassa paññāya ca sāramajjhagūti. ",
  "snp2.9:7.5": "kiṃsīlasuttaṃ navamaṃ. "
}
