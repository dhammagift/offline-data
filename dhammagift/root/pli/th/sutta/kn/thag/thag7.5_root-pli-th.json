{
  "thag7.5:0.1": "",
  "thag7.5:0.2": "",
  "thag7.5:0.3": "",
  "thag7.5:0.4": "",
  "thag7.5:1.1": "5 sare hatthehi bhañjitvā ",
  "thag7.5:1.2": "katvāna kuṭimacchisaṃ ",
  "thag7.5:1.3": "tena me sarabhaṅgoti ",
  "thag7.5:1.4": "nāmaṃ sammatiyā ahu. ",
  "thag7.5:2.1": "na mayhaṃ kappate ajja ",
  "thag7.5:2.2": "sare hatthehi bhañjituṃ ",
  "thag7.5:2.3": "sikkhāpadā no paññattā ",
  "thag7.5:2.4": "gotamena yasassinā. ",
  "thag7.5:3.1": "sakalaṃ samattaṃ rogaṃ ",
  "thag7.5:3.2": "sarabhaṅgo nāddasaṃ pubbe ",
  "thag7.5:3.3": "soyaṃ rogo diṭṭho ",
  "thag7.5:3.4": "vacanakarenātidevassa. ",
  "thag7.5:4.1": "yeneva maggena gato vipassī ",
  "thag7.5:4.2": "yeneva maggena sikhī ca vessabhū ",
  "thag7.5:4.3": "kakusandhakonāgamano ca kassapo ",
  "thag7.5:4.4": "tenañjasena agamāsi gotamo. ",
  "thag7.5:5.1": "vītataṇhā anādānā ",
  "thag7.5:5.2": "satta buddhā khayogadhā ",
  "thag7.5:5.3": "yehayaṃ desito dhammo ",
  "thag7.5:5.4": "dhammabhūtehi tādihi ",
  "thag7.5:6.1": "cattāri ariyasaccāni ",
  "thag7.5:6.2": "anukampāya pāṇinaṃ ",
  "thag7.5:6.3": "dukkhaṃ samudayo maggo ",
  "thag7.5:6.4": "nirodho dukkhasaṅkhayo. ",
  "thag7.5:7.1": "yasmiṃ nivattate dukkhaṃ ",
  "thag7.5:7.2": "saṃsārasmiṃ anantakaṃ ",
  "thag7.5:7.3": "bhedā imassa kāyassa ",
  "thag7.5:7.4": "jīvitassa ca saṅkhayā ",
  "thag7.5:7.5": "añño punabbhavo natthi ",
  "thag7.5:7.6": "suvimuttomhi sabbadhīti. ",
  "thag7.5:7.7": "sarabhaṅgo thero. ",
  "thag7.5:7.8": "uddānaṃ ",
  "thag7.5:8.0": "",
  "thag7.5:8.1": "sundarasamuddo thero ",
  "thag7.5:8.2": "thero lakuṇṭabhaddiyo ",
  "thag7.5:8.3": "bhaddo thero ca sopāko ",
  "thag7.5:8.4": "sarabhaṅgo mahāisi ",
  "thag7.5:8.5": "sattake pañcakā therā ",
  "thag7.5:8.6": "gāthāyo pañcatiṃsatīti. sattakanipāto niṭṭhito. "
}
