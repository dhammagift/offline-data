{
  "thag1.71:0.1": "theragāthāya ekanipātassa aṭṭhamavaggo ",
  "thag1.71:0.2": "",
  "thag1.71:0.3": "",
  "thag1.71:0.4": "",
  "thag1.71:1.1": "1 susukhumanipuṇatthadassinā ",
  "thag1.71:1.2": "matikusalena nivātavuttinā ",
  "thag1.71:1.3": "saṃsevitabuddhasīsinā ",
  "thag1.71:1.4": "nibbānaṃ na hi tena dullabhanti. ",
  "thag1.71:1.5": "vacchapālo thero. "
}
