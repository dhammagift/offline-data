{
  "thag14.2:0.1": "",
  "thag14.2:0.2": "",
  "thag14.2:0.3": "",
  "thag14.2:0.4": "",
  "thag14.2:1.1": "2 yathāpi bhaddo ājañño ",
  "thag14.2:1.2": "dhure yutto dhurassaho ",
  "thag14.2:1.3": "mathito atibhārena ",
  "thag14.2:1.4": "saṃyuttaṃ nātivattati ",
  "thag14.2:2.1": "evaṃ paññāya ye tittā ",
  "thag14.2:2.2": "samuddo vārinā yathā ",
  "thag14.2:2.3": "na pare atimaññanti ",
  "thag14.2:2.4": "ariyadhammova pāṇinaṃ. ",
  "thag14.2:3.1": "kāle kālavasampattā ",
  "thag14.2:3.2": "bhavābhavavasaṃ gatā ",
  "thag14.2:3.3": "narā dukkhaṃ nigacchanti ",
  "thag14.2:3.4": "te ca socanti māṇavā. ",
  "thag14.2:4.1": "unnatā sukhadhammena ",
  "thag14.2:4.2": "dukkhadhammena vonatā ",
  "thag14.2:4.3": "dvayena bālā haññanti ",
  "thag14.2:4.4": "yathābhūtaṃ adassino. ",
  "thag14.2:5.1": "ye ca dukkhe sukhamhi ca ",
  "thag14.2:5.2": "majjhe sibbanimaccagū ",
  "thag14.2:5.3": "ṭhitā te indakhīlova ",
  "thag14.2:5.4": "na te unnataonatā. ",
  "thag14.2:6.1": "na heva lābhe nālābhe ",
  "thag14.2:6.2": "na yase na ca kittiyā ",
  "thag14.2:6.3": "na nindāya pasaṃsāya ",
  "thag14.2:6.4": "na te dukkhe sukhamhi ca ",
  "thag14.2:7.1": "sabbattha te na lippanti ",
  "thag14.2:7.2": "udabinduva pokkhare ",
  "thag14.2:7.3": "sabbattha sukhitā dhīrā ",
  "thag14.2:7.4": "sabbattha aparājitā. ",
  "thag14.2:8.1": "dhammena ca alābho yo ",
  "thag14.2:8.2": "yo ca lābho adhammiko ",
  "thag14.2:8.3": "alābho dhammiko seyyo ",
  "thag14.2:8.4": "yañce lābho adhammiko. ",
  "thag14.2:9.1": "yaso ca appabuddhīnaṃ ",
  "thag14.2:9.2": "viññūnaṃ ayaso ca yo ",
  "thag14.2:9.3": "ayaso ca seyyo viññūnaṃ ",
  "thag14.2:9.4": "na yaso appabuddhinaṃ. ",
  "thag14.2:10.1": "dummedhehi pasaṃsā ca ",
  "thag14.2:10.2": "viññūhi garahā ca yā ",
  "thag14.2:10.3": "garahāva seyyo viññūhi ",
  "thag14.2:10.4": "yañce bālappasaṃsanā. ",
  "thag14.2:11.1": "sukhañca kāmamayikaṃ ",
  "thag14.2:11.2": "dukkhañca pavivekiyaṃ ",
  "thag14.2:11.3": "pavivekiyaṃ dukkhaṃ seyyo ",
  "thag14.2:11.4": "yañce kāmamayaṃ sukhaṃ. ",
  "thag14.2:12.1": "jīvitañca adhammena ",
  "thag14.2:12.2": "dhammena maraṇañca yaṃ ",
  "thag14.2:12.3": "maraṇaṃ dhammikaṃ seyyo ",
  "thag14.2:12.4": "yañce jīve adhammikaṃ. ",
  "thag14.2:13.1": "kāmakodhappahīnā ye ",
  "thag14.2:13.2": "santacittā bhavābhave ",
  "thag14.2:13.3": "caranti loke asitā ",
  "thag14.2:13.4": "natthi tesaṃ piyāpiyaṃ. ",
  "thag14.2:14.1": "bhāvayitvāna bojjhaṅge ",
  "thag14.2:14.2": "indriyāni balāni ca ",
  "thag14.2:14.3": "pappuyya paramaṃ santiṃ ",
  "thag14.2:14.4": "parinibbanti anāsavāti. ",
  "thag14.2:14.5": "godatto thero. ",
  "thag14.2:14.6": "uddānaṃ ",
  "thag14.2:15.0": "",
  "thag14.2:15.1": "revato ceva godatto ",
  "thag14.2:15.2": "therā dvete mahiddhikā ",
  "thag14.2:15.3": "cuddasamhi nipātamhi ",
  "thag14.2:15.4": "gāthāyo aṭṭhavīsatīti. cuddasakanipāto niṭṭhito. "
}
