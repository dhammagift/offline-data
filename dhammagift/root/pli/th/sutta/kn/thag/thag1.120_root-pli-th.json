  "thag1.120:0.3": "",
  "thag1.120:0.4": "",
  "thag1.120:1.1": "pañcakkhandhā pariññātā ",
  "thag1.120:1.2": "tiṭṭhanti chinnamūlakā ",
  "thag1.120:1.3": "dukkhakkhayo anuppatto ",
  "thag1.120:1.4": "patto me āsavakkhayoti. ",
  "thag1.120:1.5": "isidatto thero. ",
  "thag1.120:1.6": "uddānaṃ ",
  "thag1.120:2.0": "",
  "thag1.120:2.1": "jento ca vacchagotto ca ",
  "thag1.120:2.2": "vaccho ca nāgasavhayo ",
  "thag1.120:2.3": "adhimutto mahānāmo ",
  "thag1.120:2.4": "pārāpariyo yasopi ca ",
  "thag1.120:2.5": "kimbilo vajjiputto ca ",
  "thag1.120:2.6": "isidatto mahāyasoti. ",
  "thag1.120:2.7": "dvādasamo vaggo. ",
  "thag1.120:3.0": "tatruddānaṃ bhavati. ",
  "thag1.120:3.1": "vīsuttarasataṃ therā ",
  "thag1.120:3.2": "katakiccā anāsavā ",
  "thag1.120:3.3": "ekakeva nipātamhi ",
  "thag1.120:3.4": "susaṅgītā mahesibhīti. ekanipāto niṭṭhito dukanipāto theragāthāya dukanipātassa paṭhamavaggo 1 "
}
