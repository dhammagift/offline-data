  "thag5.2:0.3": "",
  "thag5.2:0.4": "",
  "thag5.2:1.1": "ayoge yuñjamattānaṃ ",
  "thag5.2:1.2": "puriso kiccamicchako ",
  "thag5.2:1.3": "caraṃ ce nādhigaccheyya ",
  "thag5.2:1.4": "taṃ ve dubbhagalakkhaṇaṃ. ",
  "thag5.2:2.1": "abbūḷhaṃ aghatajīvitaṃ ",
  "thag5.2:2.2": "ekañce ossajjeyya kalīva siyā ",
  "thag5.2:2.3": "sabbānipi ce ossajjeyya andhova siyā ",
  "thag5.2:2.4": "samavisamassa adassanato. ",
  "thag5.2:3.1": "yañhi kayirā tañhi vade ",
  "thag5.2:3.2": "yaṃ na kayirā na taṃ vade ",
  "thag5.2:3.3": "akarontaṃ bhāsamānaṃ ",
  "thag5.2:3.4": "parijānanti paṇḍitā. ",
  "thag5.2:4.1": "yathāpi ruciraṃ pupphaṃ ",
  "thag5.2:4.2": "vaṇṇavantaṃ agandhakaṃ ",
  "thag5.2:4.3": "evaṃ subhāsitā vācā ",
  "thag5.2:4.4": "aphalā hoti akubbato. ",
  "thag5.2:5.1": "yathāpi ruciraṃ pupphaṃ ",
  "thag5.2:5.2": "vaṇṇavantaṃ sagandhakaṃ ",
  "thag5.2:5.3": "evaṃ subhāsitā vācā ",
  "thag5.2:5.4": "saphalā hoti sukubbatoti ",
  "thag5.2:5.5": "subhūto thero. 3 "
}
