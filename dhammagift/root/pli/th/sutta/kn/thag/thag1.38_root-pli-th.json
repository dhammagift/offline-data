  "thag1.38:1.1": "8 yo iddhiyā sarabhuṃ aṭṭhapesi gavampati ",
  "thag1.38:1.2": "so asito anejo ",
  "thag1.38:1.3": "taṃ sabbasaṅgātigataṃ mahāmuniṃ ",
  "thag1.38:1.4": "devā namassanti bhavassa pāragunti. ",
  "thag1.38:1.5": "gavampati thero. "
}
