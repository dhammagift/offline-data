  "thag2.29:0.4": "",
  "thag2.29:1.1": "9 nadanti evaṃ sappaññā ",
  "thag2.29:1.2": "sīhāva girigabbhare ",
  "thag2.29:1.3": "dhīrā vijitasaṅgāmā ",
  "thag2.29:1.4": "jetvā māraṃ savāhanaṃ. ",
  "thag2.29:2.1": "satthā ca pariciṇṇo me ",
  "thag2.29:2.2": "dhammo saṅgho ca pūjito ",
  "thag2.29:2.3": "ahañca citto sumano ",
  "thag2.29:2.4": "puttaṃ disvā anāsavanti. ",
  "thag2.29:2.5": "bhāradvājo thero. "
}
