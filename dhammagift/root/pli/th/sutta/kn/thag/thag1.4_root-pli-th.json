  "thag1.4:1.1": "4 sabbhireva samāsetha ",
  "thag1.4:1.2": "paṇḍitehatthadassibhi ",
  "thag1.4:1.3": "atthaṃ mahantaṃ gambhīraṃ ",
  "thag1.4:1.4": "duddasaṃ nipuṇaṃ aṇuṃ ",
  "thag1.4:1.5": "dhīrā samadhigacchanti ",
  "thag1.4:1.6": "appamattā vicakkhaṇāti. ",
  "thag1.4:1.7": "itthaṃ sudaṃ āyasmā puṇṇo mantāniputto thero gāthaṃ abhāsittha. "
}
