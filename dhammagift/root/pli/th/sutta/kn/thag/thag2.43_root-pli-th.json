  "thag2.43:0.4": "",
  "thag2.43:1.1": "3 kassindriyāni samathaṃ gatāni ",
  "thag2.43:1.2": "assā yathā sārakinā sudantā ",
  "thag2.43:1.3": "pahīnamānassa anāsavassa ",
  "thag2.43:1.4": "devāpi tassa pihayanti tādino. ",
  "thag2.43:2.1": "mayhindriyāni samathaṃ gatāni ",
  "thag2.43:2.2": "assā yathā sārathinā sudantā ",
  "thag2.43:2.3": "pahīnamānassa anāsavassa ",
  "thag2.43:2.4": "devāpi mayhaṃ pihayanti tādinoti. ",
  "thag2.43:2.5": "brahmāli thero. "
}
