  "thag1.19:1.1": "9 udakaṃ hi nayanti nettikā ",
  "thag1.19:1.2": "usukārā namayanti tejanaṃ ",
  "thag1.19:1.3": "dāruṃ namayanti tacchakā ",
  "thag1.19:1.4": "attānaṃ damayanti subbatāti. ",
  "thag1.19:1.5": "kuḷo thero. "
}
