  "thag1.7:1.1": "7 yo pānudi maccurājassa senaṃ ",
  "thag1.7:1.2": "naḷasetuṃva sudubbalaṃ mahogho ",
  "thag1.7:1.3": "vijitāvi apetabheravo hi ",
  "thag1.7:1.4": "danto so parinibbuto ṭhitattoti. ",
  "thag1.7:1.5": "itthaṃ sudaṃ āyasmā bhalliyo thero. "
}
