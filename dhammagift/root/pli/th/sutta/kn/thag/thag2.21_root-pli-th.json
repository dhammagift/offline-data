{
  "thag2.21:0.1": "theragāthāya dukanipātassa tatiyavaggo ",
  "thag2.21:0.2": "",
  "thag2.21:0.3": "",
  "thag2.21:0.4": "",
  "thag2.21:1.1": "1 khandhā mayā pariññātā ",
  "thag2.21:1.2": "taṇhā me susamūhatā ",
  "thag2.21:1.3": "bhāvitā mama bojjhaṅgā ",
  "thag2.21:1.4": "patto me āsavakkhayo. ",
  "thag2.21:2.1": "sohaṃ khandhe pariññāya ",
  "thag2.21:2.2": "abbhahitvāna jāliniṃ ",
  "thag2.21:2.3": "bhāvayitvāna bojjhaṅge ",
  "thag2.21:2.4": "nibbāyissaṃ anāsavoti. ",
  "thag2.21:2.5": "uttaro thero. "
}
