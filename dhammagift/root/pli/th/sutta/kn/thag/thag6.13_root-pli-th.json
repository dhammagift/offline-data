  "thag6.13:0.4": "",
  "thag6.13:1.1": "13 channamativassati ",
  "thag6.13:1.2": "vivaṭaṃ nātivassati ",
  "thag6.13:1.3": "tasmā channaṃ vivaretha ",
  "thag6.13:1.4": "evantaṃ nātivassati. ",
  "thag6.13:2.1": "maccunabbhāhato loko ",
  "thag6.13:2.2": "jarāya parivārito ",
  "thag6.13:2.3": "taṇhāsallena otiṇṇo ",
  "thag6.13:2.4": "icchādhūpāyito sadā. ",
  "thag6.13:3.1": "maccunabbhāhato loko ",
  "thag6.13:3.2": "parikkhitto jarāya ca ",
  "thag6.13:3.3": "haññati niccamattāṇo ",
  "thag6.13:3.4": "pattadaṇḍova takkaro. ",
  "thag6.13:4.1": "āgacchantaggikkhandhāva ",
  "thag6.13:4.2": "maccubyādhijarā tayo ",
  "thag6.13:4.3": "paccuggantuṃ balaṃ natthi ",
  "thag6.13:4.4": "javo natthi palāyituṃ. ",
  "thag6.13:5.1": "amoghaṃ divasaṃ kayirā ",
  "thag6.13:5.2": "appena bahukena vā ",
  "thag6.13:5.3": "yaṃ yaṃ vivahate ratti ",
  "thag6.13:5.4": "tadūnantassa jīvitaṃ. ",
  "thag6.13:6.1": "carato tiṭṭhato vāpi ",
  "thag6.13:6.2": "āsīnasayanassa vā ",
  "thag6.13:6.3": "upeti carimā ratti ",
  "thag6.13:6.4": "na te kālo pamajjitunti. ",
  "thag6.13:6.5": "sirimaṇḍo thero. "
}
