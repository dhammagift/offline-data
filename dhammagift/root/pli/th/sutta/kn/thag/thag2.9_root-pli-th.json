  "thag2.9:0.4": "",
  "thag2.9:1.1": "9 sukhaṃ supanti munayo ",
  "thag2.9:1.2": "ye itthīsu na bajjhare ",
  "thag2.9:1.3": "sadā ve rakkhitabbāsu ",
  "thag2.9:1.4": "yāsu saccaṃ sudullabhaṃ. ",
  "thag2.9:2.1": "vadhaṃ carimha te kāma ",
  "thag2.9:2.2": "anaṇādāni te mayaṃ ",
  "thag2.9:2.3": "gacchāmadāni nibbānaṃ ",
  "thag2.9:2.4": "yattha gantvā na socatīti. ",
  "thag2.9:2.5": "gotamo thero. "
}
