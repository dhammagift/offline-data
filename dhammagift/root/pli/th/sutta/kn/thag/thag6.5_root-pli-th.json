  "thag6.5:0.1": "",
  "thag6.5:0.2": "",
  "thag6.5:0.3": "",
  "thag6.5:0.4": "",
  "thag6.5:1.1": "manujassa pamattacārino ",
  "thag6.5:1.2": "taṇhā vaḍḍhati māluvā viya ",
  "thag6.5:1.3": "so pariplavati hurāhuraṃ ",
  "thag6.5:1.4": "phalamicchaṃva vanasmiṃ vānaro. ",
  "thag6.5:2.1": "yaṃ esā sahate jammī ",
  "thag6.5:2.2": "taṇhā loke visattikā ",
  "thag6.5:2.3": "sokā tassa pavaḍḍhanti ",
  "thag6.5:2.4": "abhivuṭṭhaṃva vīraṇaṃ. ",
  "thag6.5:3.1": "yo cetaṃ sahate jammiṃ ",
  "thag6.5:3.2": "taṇhaṃ loke duraccayaṃ ",
  "thag6.5:3.3": "sokā tamhā papatanti ",
  "thag6.5:3.4": "udabinduva pokkharā. ",
  "thag6.5:4.1": "taṃ vo vadāmi bhaddaṃ vo ",
  "thag6.5:4.2": "yāvantettha samāgatā ",
  "thag6.5:4.3": "taṇhāya mūlaṃ khaṇatha ",
  "thag6.5:4.4": "usīratthova vīraṇaṃ ",
  "thag6.5:4.5": "mā vo naḷaṃva sotova ",
  "thag6.5:4.6": "māro bhañji punappunaṃ. ",
  "thag6.5:5.1": "karotha buddhavacanaṃ ",
  "thag6.5:5.2": "khaṇo ve mā upaccagā ",
  "thag6.5:5.3": "khaṇātītā hi socanti ",
  "thag6.5:5.4": "nirayamhi samappitā. ",
  "thag6.5:6.1": "pamādo rajo ",
  "thag6.5:6.2": "pamādānupatito rajo ",
  "thag6.5:6.3": "appamādena vijjāya ",
  "thag6.5:6.4": "abbuhe sallamattanoti. ",
  "thag6.5:6.5": "māluṅkyaputto thero. 6 "
}
