  "thag1.53:1.1": "3 vassati devo yathā sugītaṃ ",
  "thag1.53:1.2": "channā me kuṭikā sukhā nivātā ",
  "thag1.53:1.3": "tassaṃ viharāmi appamatto ",
  "thag1.53:1.4": "atha ce patthayasi pavassa devāti. ",
  "thag1.53:1.5": "valliyo thero. "
}
