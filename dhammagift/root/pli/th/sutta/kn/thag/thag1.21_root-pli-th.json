{
  "thag1.21:0.1": "theragāthāya ekanipātassa tatiyavaggo ",
  "thag1.21:0.2": "",
  "thag1.21:0.3": "",
  "thag1.21:0.4": "",
  "thag1.21:1.1": "1 nāhaṃ bhayassa bhāyāmi ",
  "thag1.21:1.2": "satthā no amatassa kovido ",
  "thag1.21:1.3": "yattha bhayaṃ nāvatiṭṭhati ",
  "thag1.21:1.4": "tena maggena vajanti bhikkhavoti. ",
  "thag1.21:1.5": "nigrodho thero. "
}
