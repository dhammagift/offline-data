{
  "thag9.1:0.1": "",
  "thag9.1:0.2": "",
  "thag9.1:0.3": "",
  "thag9.1:0.4": "",
  "thag9.1:1.1": "yadā dukkhaṃ jarāmaraṇanti paṇḍito ",
  "thag9.1:1.2": "aviddasū yattha sitā puthujjanā ",
  "thag9.1:1.3": "dukkhaṃ pariññāya satova jhāyati ",
  "thag9.1:1.4": "tato ratiṃ paramataraṃ na vindati. ",
  "thag9.1:2.1": "yadā dukkhassāvahaniṃ visattikaṃ ",
  "thag9.1:2.2": "papañcasaṅghāṭadukkhādhivāhaniṃ ",
  "thag9.1:2.3": "taṇhaṃ pahatvāna satova jhāyati ",
  "thag9.1:2.4": "tato ratiṃ paramataraṃ na vindati. ",
  "thag9.1:3.1": "yadā sivaṃ dvecaturaṅgagāminaṃ ",
  "thag9.1:3.2": "magguttamaṃ sabbakilesasodhanaṃ ",
  "thag9.1:3.3": "paññāya phusitvā satova jhāyati ",
  "thag9.1:3.4": "tato ratiṃ paramataraṃ na vindati. ",
  "thag9.1:4.1": "yadā asokaṃ virajaṃ asaṅkhataṃ ",
  "thag9.1:4.2": "santaṃ padaṃ sabbakilesasodhanaṃ ",
  "thag9.1:4.3": "bhāveti saññojanabandhanacchidaṃ ",
  "thag9.1:4.4": "tato ratiṃ paramataraṃ na vindati. ",
  "thag9.1:5.1": "yadā nabhe gajjati meghadundubhi ",
  "thag9.1:5.2": "dhārākulā vihaṅgapathe samantato ",
  "thag9.1:5.3": "bhikkhu ca pabbhāragatova jhāyati ",
  "thag9.1:5.4": "tato ratiṃ paramataraṃ na vindati. ",
  "thag9.1:6.1": "yadā nadīnaṃ kusumākulānaṃ ",
  "thag9.1:6.2": "vicittavāneyya vaṭaṃsakānaṃ ",
  "thag9.1:6.3": "tīre nisinno sumanova jhāyati ",
  "thag9.1:6.4": "tato ratiṃ paramataraṃ na vindati. ",
  "thag9.1:7.1": "yadā nisīve rahitamhi kānane ",
  "thag9.1:7.2": "deve gaḷantamhi nadanti dāṭhino ",
  "thag9.1:7.3": "bhikkhu ca pabbhāragatova jhāyati ",
  "thag9.1:7.4": "tato ratiṃ paramataraṃ na vindati. ",
  "thag9.1:8.1": "yadā vitakke uparundhiyattano ",
  "thag9.1:8.2": "nagantare nagavivaraṃ samassito ",
  "thag9.1:8.3": "vītaddaro vigatakhilova jhāyati ",
  "thag9.1:8.4": "tato ratiṃ paramataraṃ na vindati. ",
  "thag9.1:9.1": "yadā sukhī malakhilasokanāsano ",
  "thag9.1:9.2": "niraggalo nibbanatho visallo ",
  "thag9.1:9.3": "sabbāsave byantikatova jhāyati ",
  "thag9.1:9.4": "tato ratiṃ paramataraṃ na vindatīti. ",
  "thag9.1:9.5": "bhūto thero. ",
  "thag9.1:9.6": "uddānaṃ ",
  "thag9.1:10.0": "",
  "thag9.1:10.1": "bhūto tathaddaso thero ",
  "thag9.1:10.2": "eko khaggavisāṇavā ",
  "thag9.1:10.3": "navakamhi nipātamhi ",
  "thag9.1:10.4": "gāthāyopi imā navāti. navakanipāto niṭṭhito. theragāthāya dasakanipāto 1 aṅgārinodāni "
}
