  "thag1.52:1.1": "2 vassati devo yathā sugītaṃ ",
  "thag1.52:1.2": "channā me kuṭikā sukhā nivātā ",
  "thag1.52:1.3": "cittaṃ susamāhitañca mayhaṃ ",
  "thag1.52:1.4": "atha ce patthayasi pavassa devāti. ",
  "thag1.52:1.5": "subāhu thero. "
}
