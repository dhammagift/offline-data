  "thag1.60:0.4": "",
  "thag1.60:1.1": "te me ijjhiṃsu saṅkappā ",
  "thag1.60:1.2": "yadattho pāvisiṃ kuṭiṃ ",
  "thag1.60:1.3": "vijjāvimuttiṃ paccessaṃ ",
  "thag1.60:1.4": "mānānusayamujjahanti. ",
  "thag1.60:1.5": "sīvalī ",
  "thag1.60:1.6": "thero. uddānaṃ ",
  "thag1.60:2.0": "",
  "thag1.60:2.1": "godhiko ca subāhu ca ",
  "thag1.60:2.2": "valliyo uttiyo isi ",
  "thag1.60:2.3": "añjanāvaniyo thero ",
  "thag1.60:2.4": "duve kuṭivihārino ",
  "thag1.60:2.5": "ramaṇīyakuṭiko thero kosallavhayasīvalīti. ",
  "thag1.60:2.6": "vaggo chaṭṭho. theragāthāya ekanipātassa sattamavaggo 1 "
