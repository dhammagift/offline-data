  "thag1.22:1.1": "2 nīlā sugīvā sikhino ",
  "thag1.22:1.2": "morā kāraviyaṃ abhinadanti ",
  "thag1.22:1.3": "te sītavātakalitā ",
  "thag1.22:1.4": "suttaṃ jhānaṃ nibodhentīti ",
  "thag1.22:1.5": "cittako thero. "
}
