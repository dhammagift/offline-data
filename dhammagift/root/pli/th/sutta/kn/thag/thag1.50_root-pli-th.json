  "thag1.50:0.3": "",
  "thag1.50:0.4": "",
  "thag1.50:1.1": "10 dharaṇīva siccati vāti ",
  "thag1.50:1.2": "māluto vijjutā carati nabhe ",
  "thag1.50:1.3": "upasammanti vitakkā ",
  "thag1.50:1.4": "cittaṃ susamāhitaṃ mamanti. ",
  "thag1.50:1.5": "vimalo thero. ",
  "thag1.50:1.6": "uddānaṃ ",
  "thag1.50:2.0": "",
  "thag1.50:2.1": "sirivaḍḍho revato thero khadiravaniyo ",
  "thag1.50:2.2": "sumaṅgalo sānu ",
  "thag1.50:2.3": "ramaṇīyavihārī ca ",
  "thag1.50:2.4": "samiddhi ",
  "thag1.50:2.5": "ujjayasañjayo rāmaṇeyyako so thero ",
  "thag1.50:2.6": "vimalo ca raṇañjahoti. vaggo pañcamo. "
}
