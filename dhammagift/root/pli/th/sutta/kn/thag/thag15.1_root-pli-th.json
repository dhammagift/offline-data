{
  "thag15.1:0.1": "theragāthāya soḷasakanipāto ",
  "thag15.1:0.2": "",
  "thag15.1:0.3": "",
  "thag15.1:0.4": "",
  "thag15.1:1.1": "1 esa bhiyyo pasīdāmi ",
  "thag15.1:1.2": "sutvā dhammaṃ mahārasaṃ ",
  "thag15.1:1.3": "virāgo desito dhammo ",
  "thag15.1:1.4": "anupādāya sabbaso. ",
  "thag15.1:2.1": "bahūni loke citrāni ",
  "thag15.1:2.2": "asmiṃ paṭhavimaṇḍale ",
  "thag15.1:2.3": "mathenti maññe saṅkappaṃ ",
  "thag15.1:2.4": "subhaṃ rāgūpasaṃhitaṃ. ",
  "thag15.1:3.1": "rajamupātaṃ vātena ",
  "thag15.1:3.2": "yathā megho pasāmaye ",
  "thag15.1:3.3": "evaṃ sammanti saṅkappā ",
  "thag15.1:3.4": "yadā paññāya passati. ",
  "thag15.1:4.1": "sabbe saṅkhārā aniccāti ",
  "thag15.1:4.2": "yadā paññāya passati ",
  "thag15.1:4.3": "atha nibbindati dukkhe ",
  "thag15.1:4.4": "esa maggo visuddhiyā. ",
  "thag15.1:5.1": "sabbe saṅkhārā dukkhāti ",
  "thag15.1:5.2": "yadā paññāya passati ",
  "thag15.1:5.3": "atha nibbindati dukkhe ",
  "thag15.1:5.4": "esa maggo visuddhiyā. ",
  "thag15.1:6.1": "sabbe dhammā anattāti ",
  "thag15.1:6.2": "yadā paññāya passati ",
  "thag15.1:6.3": "atha nibbindati dukkhe ",
  "thag15.1:6.4": "esa maggo visuddhiyā. ",
  "thag15.1:7.1": "buddhānubuddho yo thero ",
  "thag15.1:7.2": "koṇḍañño tibbanikkamo ",
  "thag15.1:7.3": "pahīnajātimaraṇo ",
  "thag15.1:7.4": "brahmacariyassa kevalī. ",
  "thag15.1:8.1": "oghapāso daḷho khīlo ",
  "thag15.1:8.2": "pabbato duppadāliyo ",
  "thag15.1:8.3": "chetvā khīlañca pāsañca ",
  "thag15.1:8.4": "selaṃ chetvāna dubbhidaṃ ",
  "thag15.1:8.5": "tiṇṇo pāraṅgato jhāyī ",
  "thag15.1:8.6": "mutto so mārabandhanā. ",
  "thag15.1:9.1": "uddhato capalo bhikkhu ",
  "thag15.1:9.2": "mitte āgamma pāpake ",
  "thag15.1:9.3": "saṃsīdati mahoghasmiṃ ",
  "thag15.1:9.4": "ummiyā paṭikujjito. ",
  "thag15.1:10.1": "anuddhato acapalo ",
  "thag15.1:10.2": "nipako saṃvutindriyo ",
  "thag15.1:10.3": "kalyāṇamitto medhāvī ",
  "thag15.1:10.4": "dukkhassantakaro siyā. ",
  "thag15.1:11.1": "kālāpabbaṅgasaṅkāso ",
  "thag15.1:11.2": "kīso dhamanisaṇṭhito ",
  "thag15.1:11.3": "mattaññū annapānasmiṃ ",
  "thag15.1:11.4": "adīnamanaso naro ",
  "thag15.1:12.1": "phuṭṭho ḍaṃsehi makasehi ",
  "thag15.1:12.2": "araññasmiṃ brahāvane ",
  "thag15.1:12.3": "nāgo saṅgāmasīseva ",
  "thag15.1:12.4": "sato tatrādhivāsaye. ",
  "thag15.1:13.1": "nābhinandāmi maraṇaṃ ",
  "thag15.1:13.2": "nābhinandāmi jīvitaṃ kālañca paṭikaṅkhāmi ",
  "thag15.1:13.3": "",
  "thag15.1:13.4": "nibbisaṃ bhatako yathā. ",
  "thag15.1:14.1": "nābhinandāmi maraṇaṃ ",
  "thag15.1:14.2": "nābhinandāmi jīvitaṃ kālañca paṭikaṅkhāmi ",
  "thag15.1:14.3": "",
  "thag15.1:14.4": "sampajāno patissato. ",
  "thag15.1:15.1": "pariciṇṇo mayā satthā ",
  "thag15.1:15.2": "kataṃ buddhassa sāsanaṃ ohito garuko bhāro ",
  "thag15.1:15.3": "",
  "thag15.1:15.4": "bhavanetti samūhatā. ",
  "thag15.1:16.1": "yassa catthāya pabbajito ",
  "thag15.1:16.2": "agārasmā anagāriyaṃ ",
  "thag15.1:16.3": "so me attho anuppatto ",
  "thag15.1:16.4": "kiṃ me saddhivihārināti. ",
  "thag15.1:16.5": "aññākoṇḍañño thero. "
}
