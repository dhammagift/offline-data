  "thag1.57:1.1": "7 ayamāhu purāṇiyā kuṭikā ",
  "thag1.57:1.2": "aññaṃ patthayase navaṃ kuṭiṃ ",
  "thag1.57:1.3": "āsaṃ kuṭiyā virājaya ",
  "thag1.57:1.4": "dukkhā bhikkhu puna navā kuṭīti. ",
  "thag1.57:1.5": "kuṭivihārī thero. "
}
