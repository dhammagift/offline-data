  "thag3.5:0.3": "",
  "thag3.5:0.4": "",
  "thag3.5:1.1": "5 atisītaṃ atiuṇhaṃ ",
  "thag3.5:1.2": "atisāyamidaṃ ahu ",
  "thag3.5:1.3": "iti visaṭṭhakammante ",
  "thag3.5:1.4": "khaṇā accenti māṇave. ",
  "thag3.5:2.1": "yo ca sītañca uṇhañca ",
  "thag3.5:2.2": "tiṇā bhiyyo na maññati ",
  "thag3.5:2.3": "karaṃ purisakiccāni ",
  "thag3.5:2.4": "so sukhā na vihāyati. ",
  "thag3.5:3.1": "dabbaṃ kusaṃ poṭakilaṃ ",
  "thag3.5:3.2": "usīraṃ muñjapabbajaṃ ",
  "thag3.5:3.3": "urasā panudahissāmi ",
  "thag3.5:3.4": "vivekamanubrūhayanti. ",
  "thag3.5:3.5": "mātaṅgaputto thero. "
}
