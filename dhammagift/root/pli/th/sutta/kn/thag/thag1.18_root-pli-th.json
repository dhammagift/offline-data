  "thag1.18:0.4": "",
  "thag1.18:1.1": "8 ahu buddhassa dāyādo ",
  "thag1.18:1.2": "bhikkhu bhesakaḷāvane ",
  "thag1.18:1.3": "kevalaṃ aṭṭhisaññāya ",
  "thag1.18:1.4": "aphari paṭhaviṃ imaṃ ",
  "thag1.18:1.5": "maññehaṃ kāmarāgaṃ so ",
  "thag1.18:1.6": "khippameva pahīyatīti. ",
  "thag1.18:1.7": "siṅgālapitā thero. "
}
