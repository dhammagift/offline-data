  "thag1.36:1.1": "6 sādhu sutaṃ sādhu caritakaṃ ",
  "thag1.36:1.2": "sādhu sadā aniketavihāro ",
  "thag1.36:1.3": "atthapucchanaṃ padakkhiṇakammaṃ ",
  "thag1.36:1.4": "etaṃ sāmaññaṃ akiñcanassāti. ",
  "thag1.36:1.5": "kumāputto thero. "
}
