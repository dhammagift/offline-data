{
  "thag1.91:0.1": "theragāthāya ekanipātassa dasamavaggo ",
  "thag1.91:0.2": "",
  "thag1.91:0.3": "",
  "thag1.91:0.4": "",
  "thag1.91:1.1": "1 na tathāmataṃ satarasaṃ ",
  "thag1.91:1.2": "sudhannaṃ yaṃ mayajja paribhuttaṃ ",
  "thag1.91:1.3": "aparimitadassinā gotamena ",
  "thag1.91:1.4": "buddhena desito dhammoti. ",
  "thag1.91:1.5": "paripuṇṇako thero. "
}
