  "thag1.119:1.1": "9 rukkhamūlagahanaṃ pasakkhiya ",
  "thag1.119:1.2": "nibbānaṃ hadayasmiṃ opiya ",
  "thag1.119:1.3": "jhāya gotama mā ca pamādo ",
  "thag1.119:1.4": "kinte biḷibiḷikā karissatīti. ",
  "thag1.119:1.5": "vajjiputto thero. "
}
