  "thag2.16:0.3": "",
  "thag2.16:0.4": "",
  "thag2.16:1.1": "6 kāḷī itthī brahatī dhaṅkarūpā ",
  "thag2.16:1.2": "satthiñca bhetvā aparañca satthiṃ ",
  "thag2.16:1.3": "bāhañca bhetvā aparañca bāhuṃ ",
  "thag2.16:1.4": "sīsañca bhetvā dadhithālakaṃva ",
  "thag2.16:1.5": "esā nisinnā abhisandahitvā. ",
  "thag2.16:2.1": "yo ve aviddhā upadhiṃ karoti ",
  "thag2.16:2.2": "punappunaṃ dukkhamupeti mando ",
  "thag2.16:2.3": "tasmā pajānaṃ upadhiṃ na kayirā ",
  "thag2.16:2.4": "māhaṃ puna bhinnasiro sayissanti. ",
  "thag2.16:2.5": "mahākālo thero. "
}
