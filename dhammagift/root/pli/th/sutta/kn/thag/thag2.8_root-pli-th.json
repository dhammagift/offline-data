  "thag2.8:1.1": "khīṇā hi mayhaṃ jāti ",
  "thag2.8:1.2": "vusitaṃ jinasāsanaṃ ",
  "thag2.8:1.3": "pahīno jālasaṅkhāto ",
  "thag2.8:1.4": "bhavanetti samūhatā. ",
  "thag2.8:2.1": "yassatthāya pabbajito ",
  "thag2.8:2.2": "agārasmā anagāriyaṃ ",
  "thag2.8:2.3": "so me attho anuppatto ",
  "thag2.8:2.4": "sabbasaṃyojanakkhayoti. ",
  "thag2.8:2.5": "surādho thero. 9 "
}
