{
  "thag1.61:0.1": "theragāthāya ekanipātassa sattamavaggo ",
  "thag1.61:0.2": "",
  "thag1.61:0.3": "",
  "thag1.61:0.4": "",
  "thag1.61:1.1": "1 passati passo passantaṃ ",
  "thag1.61:1.2": "apassantañca passati ",
  "thag1.61:1.3": "apassanto apassantaṃ ",
  "thag1.61:1.4": "passantañca na passatīti. ",
  "thag1.61:1.5": "vappo thero. "
