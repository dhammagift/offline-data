  "thag2.26:0.4": "",
  "thag2.26:1.1": "6 pañca nīvaraṇe hitvā ",
  "thag2.26:1.2": "yogakkhemassa pattiyā ",
  "thag2.26:1.3": "dhammādāsaṃ gahetvāna ",
  "thag2.26:1.4": "ñāṇadassanamattano ",
  "thag2.26:2.1": "paccavekkhiṃ imaṃ kāyaṃ ",
  "thag2.26:2.2": "sabbaṃ santarabāhiraṃ ",
  "thag2.26:2.3": "ajjhattañca bahiddhāca ",
  "thag2.26:2.4": "tuccho kāyo adissathāti. ",
  "thag2.26:2.5": "puṇṇamāso thero. "
}
