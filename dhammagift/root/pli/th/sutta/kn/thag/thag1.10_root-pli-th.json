  "thag1.10:0.3": "",
  "thag1.10:0.4": "",
  "thag1.10:1.1": "vihari apekkhaṃ idha vā huraṃ vā ",
  "thag1.10:1.2": "yo vedagū santusito yatatto ",
  "thag1.10:1.3": "sabbesu dhammesu anūpalitto ",
  "thag1.10:1.4": "lokassa jaññā udayabbayañcāti. ",
  "thag1.10:1.5": "puṇṇamāso thero. uddānaṃ ",
  "thag1.10:1.6": "",
  "thag1.10:2.0": "",
  "thag1.10:2.1": "subhūti koṭṭhito thero ",
  "thag1.10:2.2": "kaṅkhārevatapuṇṇako ",
  "thag1.10:2.3": "mantāniputto dabbo ca ",
  "thag1.10:2.4": "sītavaniyo ca bhalliyo ",
  "thag1.10:2.5": "vīro pilindavaccho ca ",
  "thag1.10:2.6": "puṇṇamāso tamonudoti. vaggo paṭhamo. theragāthāya ekanipātassa dutiyavaggo 1 pāmujjabahulo "
}
