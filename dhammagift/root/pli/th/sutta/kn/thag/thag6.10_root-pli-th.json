  "thag6.10:0.1": "",
  "thag6.10:0.2": "",
  "thag6.10:0.3": "",
  "thag6.10:0.4": "",
  "thag6.10:1.1": "10 yadā navo pabbajito ",
  "thag6.10:1.2": "jātiyā sattavassiko ",
  "thag6.10:1.3": "iddhiyā abhibhotvāna ",
  "thag6.10:1.4": "pannagindaṃ mahiddhikaṃ ",
  "thag6.10:2.1": "upajjhāyassa udakaṃ ",
  "thag6.10:2.2": "anotattā mahāsarā ",
  "thag6.10:2.3": "āharāmi tato disvā ",
  "thag6.10:2.4": "maṃ satthā etadabravi ",
  "thag6.10:3.1": "sāriputta imaṃ passa ",
  "thag6.10:3.2": "āgacchantaṃ kumārakaṃ ",
  "thag6.10:3.3": "udakumbhakamādāya ",
  "thag6.10:3.4": "ajjhattaṃ susamāhitaṃ. ",
  "thag6.10:4.1": "pāsādikena vattena ",
  "thag6.10:4.2": "kalyāṇairiyāpatho ",
  "thag6.10:4.3": "sāmaṇeronuruddhassa ",
  "thag6.10:4.4": "iddhiyā ca visārado ",
  "thag6.10:5.1": "ājāniyena ājañño ",
  "thag6.10:5.2": "sādhunā sādhukārito ",
  "thag6.10:5.3": "vinīto anuruddhena ",
  "thag6.10:5.4": "katakiccena sikkhito ",
  "thag6.10:6.1": "so patvā paramaṃ santiṃ ",
  "thag6.10:6.2": "sacchikatvā akuppataṃ ",
  "thag6.10:6.3": "sāmaṇero sa sumano ",
  "thag6.10:6.4": "mā maṃ jaññāti icchatīti. ",
  "thag6.10:6.5": "sumano thero. "
}
