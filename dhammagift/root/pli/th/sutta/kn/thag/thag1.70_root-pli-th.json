  "thag1.70:0.4": "",
  "thag1.70:1.1": "10 sīlameva idha aggaṃ ",
  "thag1.70:1.2": "paññavā pana uttamo ",
  "thag1.70:1.3": "manussesu ca devesu ",
  "thag1.70:1.4": "sīlapaññāṇato jayanti. ",
  "thag1.70:1.5": "puṇṇo thero. ",
  "thag1.70:1.6": "uddānaṃ ",
  "thag1.70:2.0": "",
  "thag1.70:2.1": "vappo ca vajjiputto ca ",
  "thag1.70:2.2": "pakkho vimalakoṇḍañño ",
  "thag1.70:2.3": "ukkhepakaṭavaccho ca ",
  "thag1.70:2.4": "meghiyo ekadhammiko ",
  "thag1.70:2.5": "ekudāniyachanno ca ",
  "thag1.70:2.6": "puṇṇatthero mahabbaloti. vaggo sattamo. "
}
