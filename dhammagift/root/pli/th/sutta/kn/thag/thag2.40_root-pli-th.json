  "thag2.40:0.3": "",
  "thag2.40:0.4": "",
  "thag2.40:1.1": "10 ayamiti kappaṭo kappaṭakuro ",
  "thag2.40:1.2": "acchāya accaṃbharāya ",
  "thag2.40:1.3": "amataghaṭikāyaṃ dhammakaṭapatto ",
  "thag2.40:1.4": "kaṭapadaṃ jhānāni ocetuṃ. ",
  "thag2.40:2.1": "mā kho tvaṃ kappaṭa pacālesi ",
  "thag2.40:2.2": "mā taṃ upakaṇṇakamhi tāḷessaṃ ",
  "thag2.40:2.3": "na hi tvaṃ kappaṭa mattamaññāsi ",
  "thag2.40:2.4": "saṅghamajjhamhi pacalāyamānoti. ",
  "thag2.40:2.5": "kappaṭakuro thero. ",
  "thag2.40:2.6": "uddānaṃ ",
  "thag2.40:3.0": "",
  "thag2.40:3.1": "migasiro sivako ca ",
  "thag2.40:3.2": "upavāṇo ca paṇḍito ",
  "thag2.40:3.3": "isidinno ca kaccāno ",
  "thag2.40:3.4": "khitako ca mahāvasī ",
  "thag2.40:3.5": "poṭiriyaputto nisabho ",
  "thag2.40:3.6": "usabho kappaṭakuroti. vaggo catuttho. "
}
