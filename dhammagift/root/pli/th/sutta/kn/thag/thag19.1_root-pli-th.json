{
  "thag19.1:0.1": "",
  "thag19.1:0.2": "",
  "thag19.1:0.3": "",
  "thag19.1:0.4": "",
  "thag19.1:1.1": "kadā nuhaṃ pabbatakandarāsu ",
  "thag19.1:1.2": "ekākiyo addutiyo vihassaṃ ",
  "thag19.1:1.3": "aniccato sabbabhavaṃ vipassaṃ ",
  "thag19.1:1.4": "taṃ me idantaṃ nu kadā bhavissati. ",
  "thag19.1:2.1": "kadā nuhaṃ bhinnapaṭandharo muni ",
  "thag19.1:2.2": "kāsāvavattho amamo nirāsayo ",
  "thag19.1:2.3": "rāgañca dosañca tatheva mohaṃ ",
  "thag19.1:2.4": "hitvā sukhī pavanagato vihassaṃ. ",
  "thag19.1:3.1": "kadā aniccaṃ vadharoganiddhaṃ ",
  "thag19.1:3.2": "kāyaṃ imaṃ maccurājassa padūtaṃ ",
  "thag19.1:3.3": "vipassamāno vītabhayo vihassaṃ ",
  "thag19.1:3.4": "eko vane taṃ nu kadā bhavissati. ",
  "thag19.1:4.1": "kadā nuhaṃ bhayajananiṃ dukkhāvahaṃ ",
  "thag19.1:4.2": "taṇhālataṃ bahuvidhānuvattaniṃ ",
  "thag19.1:4.3": "paññāmayaṃ tikhiṇamasiṃ gahetvā ",
  "thag19.1:4.4": "chetvā vase tampi kadā bhavissati. ",
  "thag19.1:5.1": "kadā nu paññāmayamuggatejaṃ ",
  "thag19.1:5.2": "satthaṃ isīnaṃ ahamādayitvā ",
  "thag19.1:5.3": "māraṃ sasenaṃ sahasā bhañjissaṃ ",
  "thag19.1:5.4": "sīhāsane tannu kadā bhavissati. ",
  "thag19.1:6.1": "kadā nuhaṃ sabbhi samāgamesu ",
  "thag19.1:6.2": "diṭṭho bhave dhammagarūhi tādihi ",
  "thag19.1:6.3": "yathāvadassīhi jitindriyehi ",
  "thag19.1:6.4": "padhāniyo tannu kadā bhavissati. ",
  "thag19.1:7.1": "kadā nu maṃ tandikhudāpipāsā ",
  "thag19.1:7.2": "vātātapā kīṭasiriṃsapā vā ",
  "thag19.1:7.3": "nibādhayissanti na taṃ giribbaje ",
  "thag19.1:7.4": "attatthiyaṃ tannu kadā bhavissati. ",
  "thag19.1:8.1": "kadā nu kho yaṃ viditaṃ mahesinā ",
  "thag19.1:8.2": "cattāri saccāni sududdasāni ",
  "thag19.1:8.3": "samāhitatto satimā agacchaṃ ",
  "thag19.1:8.4": "paññāya taṃ tannu kadā bhavissati. ",
  "thag19.1:9.1": "kadā nu rūpe amite ca sadde ",
  "thag19.1:9.2": "gandhe rase phusitabbe ca dhamme ",
  "thag19.1:9.3": "ādittatohaṃ samathehi yutto ",
  "thag19.1:9.4": "paññāya dakkhaṃ tadidaṃ kadā me. ",
  "thag19.1:10.1": "kadā nuhaṃ dubbacanena vutto ",
  "thag19.1:10.2": "tatonimittaṃ vimano na hessaṃ ",
  "thag19.1:10.3": "atho pasaṭṭhopi tatonimittaṃ ",
  "thag19.1:10.4": "tuṭṭho na hessaṃ tadidaṃ kadā me. ",
  "thag19.1:11.1": "kadā nu kaṭṭhe ca tiṇe latā ca ",
  "thag19.1:11.2": "khandhe imehaṃ amite ca dhamme ",
  "thag19.1:11.3": "ajjhatikāneva ca bāhirāni ca ",
  "thag19.1:11.4": "samaṃ tuleyyaṃ tadidaṃ kadā me. ",
  "thag19.1:12.1": "kadā nu maṃ pāvusakālamegho ",
  "thag19.1:12.2": "navena toyena sacīvaraṃ vane ",
  "thag19.1:12.3": "isippayātamhi pathe vajantaṃ ",
  "thag19.1:12.4": "ovassate tannu kadā bhavissati. ",
  "thag19.1:13.1": "kadā mayūrassa sikhaṇḍino vane ",
  "thag19.1:13.2": "dijassa sutvā girigabbhare rutaṃ ",
  "thag19.1:13.3": "paccuṭṭhahitvā amatassa pattiyā ",
  "thag19.1:13.4": "sañcintaye tannu kadā bhavissati. ",
  "thag19.1:14.1": "kadā nu gaṅgaṃ yamunaṃ sarassatiṃ ",
  "thag19.1:14.2": "pātālakhittaṃ vaḷavāmukhañca ",
  "thag19.1:14.3": "asajjamāno patareyyamiddhiyā ",
  "thag19.1:14.4": "vibhiṃsanaṃ taṃ nu kadā bhavissati. ",
  "thag19.1:15.1": "kadā nu nāgova saṅgāmacārī ",
  "thag19.1:15.2": "padālaye kāmaguṇesu chandaṃ ",
  "thag19.1:15.3": "nibbajjayaṃ sabbasubhaṃ nimittaṃ ",
  "thag19.1:15.4": "jhāne yutto tannu kadā bhavissati. ",
  "thag19.1:16.1": "kadā iṇaṭṭova daliddako nidhiṃ ",
  "thag19.1:16.2": "ārādhayitvā dhanikehi pīḷito ",
  "thag19.1:16.3": "tuṭṭho bhavissaṃ adhigamma sāsanaṃ ",
  "thag19.1:16.4": "mahesino tannu kadā bhavissati. ",
  "thag19.1:17.1": "bahūni vassāni tayāmhi yācito ",
  "thag19.1:17.2": "agāravāsena alaṃ nu te idaṃ ",
  "thag19.1:17.3": "taṃ dāni maṃ pabbajitaṃ samānaṃ ",
  "thag19.1:17.4": "kiṃkāraṇaṃ citta tuvaṃ na yuñjasi. ",
  "thag19.1:18.1": "nanu ahaṃ citta tayāmhi yācito ",
  "thag19.1:18.2": "giribbaje citrachadā vihaṅgamā ",
  "thag19.1:18.3": "mahindaghosatthanitābhigajjino ",
  "thag19.1:18.4": "te taṃ ramissanti vanamhi jhāyinaṃ. ",
  "thag19.1:19.1": "kulamhi mitte ca piye ca ñātake ",
  "thag19.1:19.2": "khiḍḍāratiṃ kāmaguṇañca loke ",
  "thag19.1:19.3": "sabbaṃ pahāya idamajjhupāgato ",
  "thag19.1:19.4": "athopi tvaṃ citta na mayha tussasi. ",
  "thag19.1:20.1": "mameva etaṃ na hitaṃ paresaṃ ",
  "thag19.1:20.2": "sannāhakāle paridevitena kiṃ ",
  "thag19.1:20.3": "sabbaṃ idaṃ calaṃ iti pekkhamāno ",
  "thag19.1:20.4": "abhinikkhamiṃ amataṃ padaṃ jigīsaṃ. ",
  "thag19.1:21.1": "suvuttavādī dvipadānamuttamo ",
  "thag19.1:21.2": "mahābhisakko naradhammasārathi ",
  "thag19.1:21.3": "cittaṃ calaṃ makkaṭasannibhaṃ iti ",
  "thag19.1:21.4": "avītarāgena sudunnivāriyaṃ. ",
  "thag19.1:22.1": "kāmā hi citrā madhurā manoramā ",
  "thag19.1:22.2": "aviddasu yattha sitā puthujjanā ",
  "thag19.1:22.3": "te dukkhamicchanti punabbhavesino ",
  "thag19.1:22.4": "cittena nītā niraye niraṅkatā. ",
  "thag19.1:23.1": "mayūrakoñcābhirudamhi kānane ",
  "thag19.1:23.2": "dīpīhi byagghehi purakkhato vasaṃ ",
  "thag19.1:23.3": "kāye apekkhaṃ jaha mā padhāraya ",
  "thag19.1:23.4": "itissu maṃ citta pure niyuñjasi. ",
  "thag19.1:24.1": "bhāvehi jhānāni ca indriyāni ca ",
  "thag19.1:24.2": "balāni bojjhaṅgasamādhibhāvanā ",
  "thag19.1:24.3": "tisso ca vijjā phusa buddhasāsane ",
  "thag19.1:24.4": "itissu maṃ citta pure niyuñjasi. ",
  "thag19.1:25.1": "bhāvehi maggaṃ amatassa pattiyā ",
  "thag19.1:25.2": "niyyānikaṃ sabbadukkhakkhayogadhaṃ ",
  "thag19.1:25.3": "aṭṭhaṅgikaṃ sabbakilesasodhanaṃ ",
  "thag19.1:25.4": "itissu maṃ citta pure niyuñjasi. ",
  "thag19.1:26.1": "dukkhanti khandhe paṭipassa yoniso ",
  "thag19.1:26.2": "yato ca dukkhaṃ samudeti taṃ jaha ",
  "thag19.1:26.3": "idheva dukkhassa karohi antaṃ ",
  "thag19.1:26.4": "itissu maṃ citta pure niyuñjasi. ",
  "thag19.1:27.1": "aniccaṃ dukkhanti vipassa yoniso ",
  "thag19.1:27.2": "suññaṃ anattāti aghaṃ vadhanti ca ",
  "thag19.1:27.3": "manovicāre uparundha cetaso ",
  "thag19.1:27.4": "itissu maṃ citta pure niyuñjasi. ",
  "thag19.1:28.1": "muṇḍo virūpo abhisāpamāgato ",
  "thag19.1:28.2": "kapālahatthova kulesu bhikkhassu ",
  "thag19.1:28.3": "yuñjassu satthu vacane mahesino ",
  "thag19.1:28.4": "itissu maṃ citta pure niyuñjasi. ",
  "thag19.1:29.1": "susaṃvutatto visikhantaraṃ caraṃ ",
  "thag19.1:29.2": "kulesu kāmesu asaṅgamānaso ",
  "thag19.1:29.3": "cando yathā dosinapuṇṇamāsiyā ",
  "thag19.1:29.4": "itissu maṃ citta pure niyuñjasi. ",
  "thag19.1:30.1": "āraññiko hoti ca piṇḍapātiko ",
  "thag19.1:30.2": "sosāniko hoti ca paṃsukūliko ",
  "thag19.1:30.3": "nesajjiko hoti sadā dhute rato ",
  "thag19.1:30.4": "itissu maṃ citta pure niyuñjasi. ",
  "thag19.1:31.1": "ropetvā rukkhāni yathā phalesī ",
  "thag19.1:31.2": "mūle taruṃ chettu tameva icchasi ",
  "thag19.1:31.3": "tathūpamaṃ citta idaṃ karosi ",
  "thag19.1:31.4": "yammaṃ aniccamhi cale niyuñjasi. ",
  "thag19.1:32.1": "arūpa dūraṅgama ekacāri ",
  "thag19.1:32.2": "na te karissaṃ vacanaṃ idānihaṃ ",
  "thag19.1:32.3": "dukkhā hi kāmā kaṭukā mahabbhayāā ",
  "thag19.1:32.4": "nibbānamevābhimano carissaṃ. ",
  "thag19.1:33.1": "nāhaṃ alakkhyā ahirīkatāya vā ",
  "thag19.1:33.2": "na cittahetū na ca dūrakantanā ",
  "thag19.1:33.3": "ājīvahetū ca ahaṃ na nikkhamiṃ ",
  "thag19.1:33.4": "kato ca te citta paṭissavo mayā. ",
  "thag19.1:34.1": "appicchatā sappurisehi vaṇṇitā ",
  "thag19.1:34.2": "makkhappahānaṃ vūpasamo dukkhassa ",
  "thag19.1:34.3": "itissu maṃ citta tadā niyuñjasi ",
  "thag19.1:34.4": "idāni tvaṃ gacchasi pubbaciṇṇaṃ. ",
  "thag19.1:35.1": "taṇhaṃ virajjañca piyāpiyañca ",
  "thag19.1:35.2": "subhāni rūpāni sukhā ca vedanā ",
  "thag19.1:35.3": "manopiyā kāmaguṇā ca vantā ",
  "thag19.1:35.4": "vante ahaṃ āvasituṃ na ussahe. ",
  "thag19.1:36.1": "sabbattha te citta vaco kataṃ mayā ",
  "thag19.1:36.2": "bahūsu jātisu na mesi kopito ",
  "thag19.1:36.3": "ajjhattasambhavo kataññutāya te ",
  "thag19.1:36.4": "dukkhe ciraṃ saṃsaritaṃ tayā kate. ",
  "thag19.1:37.1": "tvaññeva no citta karosi brāhmaṇo ",
  "thag19.1:37.2": "tvaṃ khattiyā rājādisī karosi ",
  "thag19.1:37.3": "vessā ca suddā ca bhavāma ekadā ",
  "thag19.1:37.4": "devattanaṃ vāpi taveva vāhasā. ",
  "thag19.1:38.1": "taveva hetū asurā bhavāmase ",
  "thag19.1:38.2": "tvaṃmūlakaṃ nerayikā bhavāmase ",
  "thag19.1:38.3": "atho tiracchānagatāpi ekadā ",
  "thag19.1:38.4": "petattanaṃ vāpi taveva vāhasā. ",
  "thag19.1:39.1": "na nūna dubbhissasi maṃ punappunaṃ ",
  "thag19.1:39.2": "muhuṃ muhuṃ vāraṇikaṃva dussahaṃ ",
  "thag19.1:39.3": "ummattakeneva mayā palobhasi ",
  "thag19.1:39.4": "kiñcāpi te citta virādhitaṃ mayā. ",
  "thag19.1:40.1": "idaṃ pure cittamacāri cārikaṃ ",
  "thag19.1:40.2": "yenicchakaṃ yatthakāmaṃ yathāsukhaṃ ",
  "thag19.1:40.3": "tadajjahaṃ niggahissāmi yoniso ",
  "thag19.1:40.4": "hatthiṃ pabhinnaṃ viya aṅkusaggaho. ",
  "thag19.1:41.1": "satthā ca me lokamimaṃ adhiṭṭhahi ",
  "thag19.1:41.2": "aniccato addhuvato asārato ",
  "thag19.1:41.3": "pakkhanda maṃ citta jinassa sāsane ",
  "thag19.1:41.4": "tārehi oghā mahato suduttarā. ",
  "thag19.1:42.1": "na te idaṃ citta yathāpurāṇakaṃ ",
  "thag19.1:42.2": "nāhaṃ alaṃ tuyha vase nivattituṃ ",
  "thag19.1:42.3": "mahesino pabbajitomhi sāsane ",
  "thag19.1:42.4": "na mādisā honti vināsadhārino. ",
  "thag19.1:43.1": "nagā samuddā saritā vasundharā ",
  "thag19.1:43.2": "disā catasso vidisā adhodisā ",
  "thag19.1:43.3": "sabbe aniccā tibhavā upaddutā ",
  "thag19.1:43.4": "kuhiṃ gato citta sukhaṃ ramissasi. ",
  "thag19.1:44.1": "dhī dhī paraṃ kiṃ mama citta kāhasi ",
  "thag19.1:44.2": "na te alaṃ citta vasānuvattako ",
  "thag19.1:44.3": "na jātu bhastaṃ dubhato mukhaṃ chupe ",
  "thag19.1:44.4": "dhiratthu pūraṃ navasotasandani. ",
  "thag19.1:45.1": "varāhaeṇeyyavigāḷhasevite ",
  "thag19.1:45.2": "pabbhārakūṭe pakaṭeva sundare ",
  "thag19.1:45.3": "navambunā pāvusasittakānane ",
  "thag19.1:45.4": "tahiṃ guhāgehagato ramissasi. ",
  "thag19.1:46.1": "sunīlagīvā susikhā supekhuṇā ",
  "thag19.1:46.2": "sucittapattacchadanā vihaṅgamā ",
  "thag19.1:46.3": "sumañjughosatthanitādhigajjino ",
  "thag19.1:46.4": "te taṃ ramissanti vanamhi jhāyinaṃ. ",
  "thag19.1:47.1": "vuṭṭhamhi deve caturaṅgule tiṇe ",
  "thag19.1:47.2": "sampupphite meghanibhamhi kānane ",
  "thag19.1:47.3": "nagantare viṭapisamo sayissaṃ ",
  "thag19.1:47.4": "taṃ me mudu hohiti tūlasannibhaṃ. ",
  "thag19.1:48.1": "tathā tu karissāmi yathāpi issaro ",
  "thag19.1:48.2": "yaṃ labbhati tenapi hotu me alaṃ ",
  "thag19.1:48.3": "taṃ taṃ karissāmi yathā atandito ",
  "thag19.1:48.4": "biḷārabhastaṃva yathā sumadditaṃ. ",
  "thag19.1:49.1": "tathā tu karissāmi yathāpi issaro ",
  "thag19.1:49.2": "yaṃ labbhati tenapi hotu me alaṃ ",
  "thag19.1:49.3": "viriyena taṃ mayha vasānayissaṃ ",
  "thag19.1:49.4": "gajaṃva mattaṃ kusalaṅkusaggaho. ",
  "thag19.1:50.1": "tayā sudantena avatthitena hi ",
  "thag19.1:50.2": "hayena yoggācariyova ujjunā ",
  "thag19.1:50.3": "pahomi maggaṃ paṭipajjituṃ sivaṃ ",
  "thag19.1:50.4": "cittānurakkhīhi sadā nisevitaṃ. ",
  "thag19.1:51.1": "ārammaṇe taṃ balasā nibandhissaṃ ",
  "thag19.1:51.2": "nāgaṃva thambhamhi daḷhāya rajjuyā ",
  "thag19.1:51.3": "tamme suguttaṃ satiyā subhāvitaṃ ",
  "thag19.1:51.4": "anissitaṃ sabbabhavesu hehisi. ",
  "thag19.1:52.1": "paññāya chetvā vipathānusārinaṃ ",
  "thag19.1:52.2": "yogena niggayha pathe nivesiya ",
  "thag19.1:52.3": "disvā samudayaṃ vibhavañca sambhavaṃ ",
  "thag19.1:52.4": "dāyādako hehisi aggavādino. ",
  "thag19.1:53.1": "catubbipallāsavasaṃ adhiṭṭhitaṃ ",
  "thag19.1:53.2": "gāmaṇḍalaṃva parinesi citta maṃ ",
  "thag19.1:53.3": "nanu saññojanabandhanacchidaṃ ",
  "thag19.1:53.4": "saṃsevase kāruṇikaṃ mahāmuniṃ. ",
  "thag19.1:54.1": "migo yathā seri sucittakānane ",
  "thag19.1:54.2": "rammaṃ giriṃ pāvisi abbhamālinaṃ ",
  "thag19.1:54.3": "anākule tattha nage ramissasi ",
  "thag19.1:54.4": "asaṃsayaṃ citta parābhavissasi. ",
  "thag19.1:55.1": "ye tuyha chandena vasena vattino ",
  "thag19.1:55.2": "narā ca nārī ca anubhonti yaṃ sukhaṃ ",
  "thag19.1:55.3": "aviddasu māravasānuvattino ",
  "thag19.1:55.4": "bhavābhinandī tava citta sevakāti. ",
  "thag19.1:55.5": "tālapuṭo thero. ",
  "thag19.1:55.6": "uddānaṃ paññāsamhi nipātamhi eko tālapuṭo suci gāthāyo tattha paññāsa puna pañca ca uttarīti. paññāsanipāto samatto. theragāthāya saṭṭhikanipāto 1 ",
