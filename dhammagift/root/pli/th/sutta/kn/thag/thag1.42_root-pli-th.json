  "thag1.42:1.1": "2 hale upahale sīsupahale halā upahalā sīsupahalā ",
  "thag1.42:1.2": "patissatikā nu kho viharatha ",
  "thag1.42:1.3": "āgato vo vālaṃ viya vedhiyatīti. ",
  "thag1.42:1.4": "khadiravaniyo thero. "
}
