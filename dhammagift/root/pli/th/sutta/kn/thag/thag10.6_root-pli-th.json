{
  "thag10.6:0.1": "",
  "thag10.6:0.2": "",
  "thag10.6:0.3": "",
  "thag10.6:0.4": "",
  "thag10.6:1.1": "vivittaṃ appanigghosaṃ ",
  "thag10.6:1.2": "vāḷamiganisevitaṃ ",
  "thag10.6:1.3": "seve senāsanaṃ bhikkhu ",
  "thag10.6:1.4": "paṭisallānakāraṇā. ",
  "thag10.6:2.1": "saṅkārapuñjā āhatvā ",
  "thag10.6:2.2": "susānā rathiyāhi ca ",
  "thag10.6:2.3": "tato saṅghāṭikaṃ katvā ",
  "thag10.6:2.4": "lūkhaṃ dhāreyya cīvaraṃ. ",
  "thag10.6:3.1": "nīcaṃ manaṃ karitvāna ",
  "thag10.6:3.2": "sapadānaṃ kulā kulaṃ ",
  "thag10.6:3.3": "piṇḍikāya care bhikkhu ",
  "thag10.6:3.4": "guttadvāro susaṃvuto. ",
  "thag10.6:4.1": "lūkhenapi ca santusse ",
  "thag10.6:4.2": "nāññaṃ patthe rasaṃ bahuṃ ",
  "thag10.6:4.3": "rasesu anugiddhassa ",
  "thag10.6:4.4": "jhāne na ramatī mano. ",
  "thag10.6:5.1": "appiccho ceva santuṭṭho ",
  "thag10.6:5.2": "pavivitto vase muni ",
  "thag10.6:5.3": "asaṃsaṭṭho gahaṭṭhehi ",
  "thag10.6:5.4": "anāgārehi cūbhayaṃ. ",
  "thag10.6:6.1": "yathā jaḷo ca mūgo ca ",
  "thag10.6:6.2": "attānaṃ dassaye tathā ",
  "thag10.6:6.3": "nātivelaṃ pabhāseyya ",
  "thag10.6:6.4": "saṅghamajjhamhi paṇḍito. ",
  "thag10.6:7.1": "na so upavade kañci ",
  "thag10.6:7.2": "upaghātaṃ vivajjaye ",
  "thag10.6:7.3": "saṃvuto pātimokkhasmiṃ ",
  "thag10.6:7.4": "mattaññū cassa bhojane. ",
  "thag10.6:8.1": "suggahītanimittassa ",
  "thag10.6:8.2": "cittassuppādakovido ",
  "thag10.6:8.3": "samathaṃ anuyuñjeyya ",
  "thag10.6:8.4": "kālena ca vipassanaṃ. ",
  "thag10.6:9.1": "viriyasātaccasampanno ",
  "thag10.6:9.2": "yuttayogo sadā siyā ",
  "thag10.6:9.3": "na ca appatvā dukkhantaṃ ",
  "thag10.6:9.4": "vissāsaṃ eyya paṇḍito. ",
  "thag10.6:10.1": "evaṃ viharamānassa ",
  "thag10.6:10.2": "suddhikāmassa bhikkhuno ",
  "thag10.6:10.3": "khiyyanti āsavā sabbe ",
  "thag10.6:10.4": "nibbutiñcādhigacchatīti. ",
  "thag10.6:10.5": "upaseno vaṅgantaputto thero. 7 "
}
