  "thag2.4:1.1": "4 tiṇṇaṃ me tālapattānaṃ ",
  "thag2.4:1.2": "gaṅgātīre kuṭī katā ",
  "thag2.4:1.3": "chavasittova me patto ",
  "thag2.4:1.4": "paṅsukūlañca cīvaraṃ. ",
  "thag2.4:2.1": "dvinnaṃ antaravassānaṃ ",
  "thag2.4:2.2": "ekavācā me bhāsitā ",
  "thag2.4:2.3": "tatiye antaravassamhi ",
  "thag2.4:2.4": "tamokkhandho padālitoti. ",
  "thag2.4:2.5": "gaṅgātīriyo thero. "
}
