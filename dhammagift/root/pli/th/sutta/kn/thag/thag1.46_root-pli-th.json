  "thag1.46:1.1": "6 saddhāyāhaṃ pabbajito ",
  "thag1.46:1.2": "agārasmā anagāriyaṃ ",
  "thag1.46:1.3": "sati paññā ca me vuḍḍhā ",
  "thag1.46:1.4": "cittañca susamāhitaṃ. ",
  "thag1.46:1.5": "kāmaṃ karassu rūpāni ",
  "thag1.46:1.6": "neva maṃ byādhayissasīti. ",
  "thag1.46:1.7": "samiddhi thero. "
}
