  "thag2.24:1.1": "yaṃ kiccaṃ daḷhaviriyena ",
  "thag2.24:1.2": "yaṃ kiccaṃ bodhumicchatā ",
  "thag2.24:1.3": "karissaṃ nāvarajjhissaṃ ",
  "thag2.24:1.4": "passa viriyaṃ parakkamaṃ. ",
  "thag2.24:2.1": "tvañca me maggamakkhāhi ",
  "thag2.24:2.2": "añjasaṃ amatogadhaṃ ",
  "thag2.24:2.3": "ahaṃ monena monissaṃ ",
  "thag2.24:2.4": "gaṅgāsotova sāgaranti. ",
  "thag2.24:2.5": "valliyo thero. 5 "
}
