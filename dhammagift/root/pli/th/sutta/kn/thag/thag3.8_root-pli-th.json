  "thag3.8:0.3": "",
  "thag3.8:0.4": "",
  "thag3.8:1.1": "8 ekopi saddho medhāvī ",
  "thag3.8:1.2": "assaddhānaṃ ca ñātinaṃ ",
  "thag3.8:1.3": "dhammaṭṭho sīlasampanno ",
  "thag3.8:1.4": "hoti atthāya bandhunaṃ. ",
  "thag3.8:2.1": "niggayha anukampāya ",
  "thag3.8:2.2": "coditā ñātayo mayā ",
  "thag3.8:2.3": "ñātibandhavapemena ",
  "thag3.8:2.4": "kāraṃ katvāna bhikkhusu. ",
  "thag3.8:3.1": "te abbhatītā kālakatā ",
  "thag3.8:3.2": "pattā te tidivaṃ sukhaṃ ",
  "thag3.8:3.3": "bhātaro mayhaṃ mātā ca ",
  "thag3.8:3.4": "modanti kāmakāminoti. ",
  "thag3.8:3.5": "passiko thero. "
}
