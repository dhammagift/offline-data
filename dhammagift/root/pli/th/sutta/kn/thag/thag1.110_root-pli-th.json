  "thag1.110:0.3": "",
  "thag1.110:0.4": "",
  "thag1.110:1.1": "nagā nagaggesu susaṃvirūḷhā ",
  "thag1.110:1.2": "udaggameghena navena sittā ",
  "thag1.110:1.3": "vivekakāmassa araññasaññino ",
  "thag1.110:1.4": "janeti bhiyyo usabhassa kalyatanti. ",
  "thag1.110:1.5": "usabho thero. ",
  "thag1.110:1.6": "uddānaṃ belaṭṭhakāni ",
  "thag1.110:2.0": "",
  "thag1.110:2.1": "setuccho ",
  "thag1.110:2.2": "bandhuro khitako isi ",
  "thag1.110:2.3": "malitavambho suhemanto ",
  "thag1.110:2.4": "dhammasaṃvaro dhammasaṭapitā ",
  "thag1.110:2.5": "saṅgharakkhitatthero ca ",
  "thag1.110:2.6": "usabho ca mahāmunīti. vaggo ekādasamo. theragāthāya ekanipātassa dvādasamavaggo 1 "
