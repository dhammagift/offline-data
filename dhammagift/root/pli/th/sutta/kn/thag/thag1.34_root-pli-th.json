  "thag1.34:1.1": "4 anāsannavarā etā ",
  "thag1.34:1.2": "niccameva vijānatā ",
  "thag1.34:1.3": "gāmā araññamāgamma ",
  "thag1.34:1.4": "tato gehaṃ upāvisiṃ ",
  "thag1.34:1.5": "tato uṭṭhāya pakkāmiṃ ",
  "thag1.34:1.6": "anāmantetvā posiyoti. ",
  "thag1.34:1.7": "posiyo thero. "
}
