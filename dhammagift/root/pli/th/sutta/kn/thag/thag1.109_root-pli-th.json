  "thag1.109:1.1": "9 na nūnāyaṃ paramahitānukampino ",
  "thag1.109:1.2": "rahogato anuvigaṇeti sāsanaṃ ",
  "thag1.109:1.3": "tathā hayaṃ vīharati pākatindriyo ",
  "thag1.109:1.4": "migī yathā taruṇajātikā vaneti. ",
  "thag1.109:1.5": "saṅgharakkhito thero. "
}
