{
  "thag1.41:0.1": "theragāthāya ekanipātassa pañcamavaggo ",
  "thag1.41:0.2": "",
  "thag1.41:0.3": "",
  "thag1.41:0.4": "",
  "thag1.41:1.1": "1 vivaramanupatanti vijjutā ",
  "thag1.41:1.2": "vebhārassa ca paṇḍavassa ca ",
  "thag1.41:1.3": "nagavivaragato ca jhāyati ",
  "thag1.41:1.4": "putto appaṭimassa tādinoti. ",
  "thag1.41:1.5": "sirivaḍḍho thero. "
}
