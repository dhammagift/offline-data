  "thag3.9:0.3": "",
  "thag3.9:0.4": "",
  "thag3.9:1.1": "kālāpabbaṅgasaṅkāso ",
  "thag3.9:1.2": "kīso dhamanisaṇṭhito ",
  "thag3.9:1.3": "mattaññū annapānasmiṃ ",
  "thag3.9:1.4": "alīnamanaso naro. ",
  "thag3.9:2.1": "phuṭṭho ḍaṃsehi makasehi ",
  "thag3.9:2.2": "araññasmiṃ brahāvane ",
  "thag3.9:2.3": "nāgo saṅgāmasīseva ",
  "thag3.9:2.4": "sato tatrādhivāsaye. ",
  "thag3.9:3.1": "yathā brahmā tathā eko ",
  "thag3.9:3.2": "yathā devo tathā duve ",
  "thag3.9:3.3": "yathā gāmo tathā tayo ",
  "thag3.9:3.4": "kolāhalaṃ tatuttarinti. ",
  "thag3.9:3.5": "yasojo thero. 10 "
}
