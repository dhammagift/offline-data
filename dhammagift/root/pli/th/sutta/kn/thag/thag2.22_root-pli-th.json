  "thag2.22:0.4": "",
  "thag2.22:1.1": "panādo nāma so rājā ",
  "thag2.22:1.2": "yassa yūpo suvaṇṇiyo ",
  "thag2.22:1.3": "tiriyaṃ soḷasubbedho ",
  "thag2.22:1.4": "uccamāhu sahassadhā. ",
  "thag2.22:2.1": "sahassakaṇḍo satageṇḍu ",
  "thag2.22:2.2": "dhajālu haritāmayo ",
  "thag2.22:2.3": "anaccuṃ tattha gandhabbā ",
  "thag2.22:2.4": "cha sahassāni sattadhāti. ",
  "thag2.22:2.5": "bhaddaji thero. 3 "
}
