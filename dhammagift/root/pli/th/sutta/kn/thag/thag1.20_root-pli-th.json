  "thag1.20:0.4": "",
  "thag1.20:1.1": "maraṇe me bhayaṃ natthi ",
  "thag1.20:1.2": "nikanti natthi jīvite ",
  "thag1.20:1.3": "sandehaṃ nikkhipissāmi ",
  "thag1.20:1.4": "sampajāno patissatoti. ",
  "thag1.20:1.5": "ajito thero. ",
  "thag1.20:1.6": "uddānaṃ ",
  "thag1.20:2.0": "",
  "thag1.20:2.1": "cūḷavaccho mahāvaccho ",
  "thag1.20:2.2": "vanavaccho ca sīvako ",
  "thag1.20:2.3": "kuṇḍadhāno ca belaṭṭhi ",
  "thag1.20:2.4": "dāsako ca tato paraṃ ",
  "thag1.20:2.5": "siṅgālapitiko thero ",
  "thag1.20:2.6": "kuḷo ca ajito dasāti. vaggo dutiyo. theragāthāya ekanipātassa tatiyavaggo 1 "
}
