{
  "thag10.1:0.1": "theragāthāya dasakanipāto ",
  "thag10.1:0.2": "",
  "thag10.1:0.3": "",
  "thag10.1:0.4": "",
  "thag10.1:1.1": "1 aṅgārinodāni dumā bhadante ",
  "thag10.1:1.2": "phalesino chadanaṃ vippahāya ",
  "thag10.1:1.3": "te accimantova pabhāsayanti ",
  "thag10.1:1.4": "samayo mahāvīra bhagī rasānaṃ. ",
  "thag10.1:2.1": "dumāni phullāni manoramāni ",
  "thag10.1:2.2": "samantato sabbadisā pavanti ",
  "thag10.1:2.3": "pattaṃ pahāya phalamāsasānā ",
  "thag10.1:2.4": "kālo ito pakkamanāya vīra. ",
  "thag10.1:3.1": "nevātisītaṃ na panātiuṇhaṃ ",
  "thag10.1:3.2": "sukhā utu addhaniyā bhadante ",
  "thag10.1:3.3": "passantu taṃ sākiyā koḷiyā ca ",
  "thag10.1:3.4": "pacchāmukhaṃ rohiṇiyaṃ tarantaṃ. ",
  "thag10.1:4.1": "āsāya kasate khettaṃ ",
  "thag10.1:4.2": "bījaṃ āsāya vappati ",
  "thag10.1:4.3": "āsāya vāṇijā yanti ",
  "thag10.1:4.4": "samuddaṃ dhanahārakā. ",
  "thag10.1:4.5": "yāya āsāya tiṭṭhāmi ",
  "thag10.1:4.6": "sā me āsā vipaccatu. ",
  "thag10.1:5.1": "punappunañceva vapanti bījaṃ ",
  "thag10.1:5.2": "punappunaṃ vassati devarājā ",
  "thag10.1:5.3": "punappunaṃ khettaṃ kasanti kassakā ",
  "thag10.1:5.4": "punappunaṃ dhaññamupeti raṭṭhaṃ. ",
  "thag10.1:6.1": "punappunaṃ yācanakā caranti ",
  "thag10.1:6.2": "punappunaṃ dānapatī dadanti ",
  "thag10.1:6.3": "punappunaṃ dānapatī daditvā ",
  "thag10.1:6.4": "punappunaṃ saggamupenti ṭhānaṃ. ",
  "thag10.1:7.1": "dhīro have sattayugaṃ puneti ",
  "thag10.1:7.2": "yasmiṃ kule jāyati bhūripañño ",
  "thag10.1:7.3": "maññāmahaṃ sakkati devadevo ",
  "thag10.1:7.4": "tayā hi jāto muni saccanāmo. ",
  "thag10.1:8.1": "suddhodano nāma pitā mahesino ",
  "thag10.1:8.2": "buddhassa mātā pana māyā mahesī ",
  "thag10.1:8.3": "yā bodhisattaṃ parihariya kucchinā ",
  "thag10.1:8.4": "kāyassa bhedā tidivasmi modati. ",
  "thag10.1:9.1": "sā gotamī kālakatā ito cutā ",
  "thag10.1:9.2": "dibbehi kāmehi samaṅgibhūtā ",
  "thag10.1:9.3": "sā modati kāmaguṇehi pañcahi ",
  "thag10.1:9.4": "parivāritā devagaṇehi tehi. ",
  "thag10.1:10.1": "buddhassa puttomhi asayhasāhino ",
  "thag10.1:10.2": "aṅgīrasassappaṭimassa tādino ",
  "thag10.1:10.3": "pitu pitā mayhaṃ tuvaṃsi sakka ",
  "thag10.1:10.4": "dhammena me gotama ayyakosīti. ",
  "thag10.1:10.5": "kāḷudāyī thero. "
}
