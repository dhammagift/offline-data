  "thag2.30:0.1": "",
  "thag2.30:0.2": "",
  "thag2.30:0.3": "",
  "thag2.30:0.4": "",
  "thag2.30:1.1": "upāsitā sappurisā ",
  "thag2.30:1.2": "sutā dhammā abhiṇhaso ",
  "thag2.30:1.3": "sutvāna paṭipajjissaṃ ",
  "thag2.30:1.4": "añjasaṃ amatogadhaṃ. ",
  "thag2.30:2.1": "bhavarāgahatassa me sato ",
  "thag2.30:2.2": "bhavarāgo puna me na vijjati ",
  "thag2.30:2.3": "na cāhu na ca me bhavissati ",
  "thag2.30:2.4": "na ca me etarahipi vijjatīti. ",
  "thag2.30:2.5": "kaṇhadinno thero. ",
  "thag2.30:2.6": "uddānaṃ ",
  "thag2.30:3.0": "",
  "thag2.30:3.1": "uttaro bhaddaji thero ",
  "thag2.30:3.2": "sobhito valliyo isi ",
  "thag2.30:3.3": "vītasoko ca so thero ",
  "thag2.30:3.4": "puṇṇamāso ca nandako ",
  "thag2.30:3.5": "bhārato bhāradvājo ca ",
  "thag2.30:3.6": "kaṇhadinno mahāmunīti. vaggo tatiyo. theragāthāya dukanipātassa catutthavaggo 1 "
}
