  "thag2.41:1.1": "aho buddhā aho dhammā ",
  "thag2.41:1.2": "aho no satthu sampadā ",
  "thag2.41:1.3": "yattha etādisaṃ dhammaṃ ",
  "thag2.41:1.4": "sāvako sacchikāhiti. ",
  "thag2.41:2.1": "asaṅkheyyesu kappesu ",
  "thag2.41:2.2": "sakkāyādhigatā ahuṃ ",
  "thag2.41:2.3": "tesamayaṃ pacchimako ",
  "thag2.41:2.4": "carimoyaṃ samussayo ",
  "thag2.41:2.5": "jātimaraṇasaṃsāro ",
  "thag2.41:2.6": "natthidāni punabbhavoti. ",
  "thag2.41:2.7": "kumārakassapo thero. 2 "
}
