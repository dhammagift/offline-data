  "thag1.30:1.1": "ābādhe me samuppanne ",
  "thag1.30:1.2": "sati me upapajjatha ",
  "thag1.30:1.3": "ābādho me samuppanno ",
  "thag1.30:1.4": "kālo me nappamajjitunti. ",
  "thag1.30:1.5": "uttiyo thero. ",
  "thag1.30:1.6": "uddānaṃ ",
  "thag1.30:2.0": "",
  "thag1.30:2.1": "nigrodho cittako thero ",
  "thag1.30:2.2": "gosālatthero sugandho ",
  "thag1.30:2.3": "nandiyo abhayo thero ",
  "thag1.30:2.4": "thero lomasakaṅgiyo ",
  "thag1.30:2.5": "jumbugāmikaputto ca ",
  "thag1.30:2.6": "hārito uttiyo isīti. vaggo tatiyo. theragāthāya ekanipātassa catutthavaggo 1 "
