{
  "thag1.101:0.1": "theragāthāya ekanipātassa ekādasamavaggo ",
  "thag1.101:0.2": "",
  "thag1.101:0.3": "",
  "thag1.101:0.4": "",
  "thag1.101:1.1": "1 hitvā gihitvaṃ anavositatto ",
  "thag1.101:1.2": "mukhanaṅgalī odariko kusīto ",
  "thag1.101:1.3": "mahāvarāhova nivāpapuṭṭho ",
  "thag1.101:1.4": "punappunaṃ gabbhamupeti mandoti. ",
  "thag1.101:1.5": "belaṭṭhakāni thero. "
}
