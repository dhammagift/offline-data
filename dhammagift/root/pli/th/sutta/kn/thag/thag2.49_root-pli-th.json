  "thag2.49:0.1": "",
  "thag2.49:0.2": "",
  "thag2.49:0.3": "",
  "thag2.49:0.4": "",
  "thag2.49:1.1": "9 assatthe haritobhāse ",
  "thag2.49:1.2": "saṃvirūḷhamhi pādape ",
  "thag2.49:1.3": "ekaṃ buddhagataṃ saññaṃ ",
  "thag2.49:1.4": "alabhitthaṃ patissato. ",
  "thag2.49:2.1": "ekatiṃse ito kappe ",
  "thag2.49:2.2": "yaṃ saññaṃ alabhiṃ tadā ",
  "thag2.49:2.3": "tassā saññāya vāhasā ",
  "thag2.49:2.4": "patto me āsavakkhayoti. ",
  "thag2.49:2.5": "sandhito thero. ",
  "thag2.49:2.6": "uddānaṃ ",
  "thag2.49:3.0": "",
  "thag2.49:3.1": "kumārakassapo thero ",
  "thag2.49:3.2": "dhammapālo ca brahmāli ",
  "thag2.49:3.3": "mogharājā visākho ca ",
  "thag2.49:3.4": "cūḷako ca anūpamo ",
  "thag2.49:3.5": "vajjito sandhito thero ",
  "thag2.49:3.6": "kilesarajavāhanoti. ",
  "thag2.49:3.7": "vaggo pañcamo. tathā ",
  "thag2.49:4.0": "",
  "thag2.49:4.1": "dukanipātamhi ",
  "thag2.49:4.2": "navuti ceva aṭṭha ca ",
  "thag2.49:4.3": "therā ekūnapaññāsaṃ ",
  "thag2.49:4.4": "bhāsitā nayakovidā. dukanipāto niṭṭhito. "
}
