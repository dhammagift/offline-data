  "thag2.2:0.4": "",
  "thag2.2:1.1": "nayidaṃ anayena jīvitaṃ ",
  "thag2.2:1.2": "nāhāro hadayassa santiko ",
  "thag2.2:1.3": "āhāraṭṭhitiko samussayo ",
  "thag2.2:1.4": "iti disvāna carāmi esanaṃ. ",
  "thag2.2:2.1": "paṅkoti hi naṃ avedayuṃ ",
  "thag2.2:2.2": "yāyaṃ vandanapūjanā kulesu ",
  "thag2.2:2.3": "sukhumaṃ sallaṃ durubbahaṃ ",
  "thag2.2:2.4": "sakkāro kāpurisena dujjahoti. ",
  "thag2.2:2.5": "itthaṃ sudaṃ āyasmā piṇḍolabhāradvājo thero gāthāyo abhāsitthāti. 3 "
}
