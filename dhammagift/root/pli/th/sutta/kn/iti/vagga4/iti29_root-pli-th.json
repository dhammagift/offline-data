  "iti29:0.3": "",
  "iti29:0.4": "",
  "iti29:1.1": "bhagavatā vuttamarahatāti me sutaṃ ",
  "iti29:2.1": "dvīhi bhikkhave dhammehi samannāgato bhikkhu diṭṭheva dhamme sukhaṃ viharati avighātaṃ anupāyāsaṃ apariḷāhaṃ ",
  "iti29:2.2": "kāyassa bhedā parammaraṇā sugati pāṭikaṅkhā ",
  "iti29:2.3": "katamehi dvīhi ",
  "iti29:2.4": "indriyesu guttadvāratāya ca bhojane mattaññutāya ca ",
  "iti29:2.5": "imehi kho bhikkhave dvīhi dhammehi samannāgato bhikkhu diṭṭheva dhamme sukhaṃ viharati avighātaṃ anupāyāsaṃ apariḷāhaṃ ",
  "iti29:2.6": "kāyassa bhedā parammaraṇā sugati pāṭikaṅkhāti. ",
  "iti29:2.7": "etamatthaṃ bhagavā avoca. ",
  "iti29:2.8": "tatthetaṃ iti vuccati ",
  "iti29:3.1": "cakkhusotañca ghānañca ",
  "iti29:3.2": "jivhā kāyo atho mano ",
  "iti29:3.3": "etāni yassa dvārāni ",
  "iti29:3.4": "suguttāni ca bhikkhuno ",
  "iti29:4.1": "bhojanamhi ca mattaññū ",
  "iti29:4.2": "indriyesu ca saṃvuto ",
  "iti29:4.3": "kāyasukhaṃ cetosukhaṃ ",
  "iti29:4.4": "sukhaṃ so adhigacchati ",
  "iti29:5.1": "aḍayhamānena kāyena ",
  "iti29:5.2": "aḍayhamānena cetasā ",
  "iti29:5.3": "divā vā yadi vā rattiṃ ",
  "iti29:5.4": "sukhaṃ viharati tādisoti. ",
  "iti29:6.1": "ayampi attho vutto bhagavatā iti me sutanti. ",
  "iti29:6.2": "dutiyaṃ. 3 vuttaṃ hetaṃ "
}
