  "iti31:0.4": "",
  "iti31:1.1": "bhagavatā vuttamarahatāti me sutaṃ ",
  "iti31:2.1": "dveme bhikkhave dhammā atapanīyā ",
  "iti31:2.2": "katame dve ",
  "iti31:2.3": "idha bhikkhave ekacco katakalyāṇo hoti katakusalo katabhīruttāṇo akatapāpo akataluddho akatakibbiso ",
  "iti31:2.4": "so kataṃ me kalyāṇantipi na tappati akataṃme pāpantipi na tappati ",
  "iti31:2.5": "ime kho bhikkhave dve dhammā atapanīyāti. ",
  "iti31:2.6": "etamatthaṃ bhagavā avoca. ",
  "iti31:2.7": "tatthetaṃ iti vuccati ",
  "iti31:3.1": "kāyaduccaritaṃ hitvā ",
  "iti31:3.2": "vacīduccaritāni vā ",
  "iti31:3.3": "manoduccaritaṃ hitvā ",
  "iti31:3.4": "yañcaññaṃ dosasañhitaṃ ",
  "iti31:4.1": "akatvā akusalaṃ kammaṃ ",
  "iti31:4.2": "katvāna kusalaṃ bahuṃ ",
  "iti31:4.3": "kāyassa bhedā sappañño ",
  "iti31:4.4": "saggaṃ so upapajjatīti. ",
  "iti31:5.1": "ayampi attho vutto bhagavatā iti me sutanti. ",
  "iti31:5.2": "catutthaṃ. 5 vuttaṃ hetaṃ "
}
