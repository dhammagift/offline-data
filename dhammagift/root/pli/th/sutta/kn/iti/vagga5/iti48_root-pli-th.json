  "iti48:0.1": "",
  "iti48:0.2": "",
  "iti48:0.3": "",
  "iti48:0.4": "",
  "iti48:1.1": "11 vuttaṃ hetaṃ bhagavatā vuttamarahatāti me sutaṃ ",
  "iti48:2.1": "dveme bhikkhave āpāyikā nerayikā idampahāya ",
  "iti48:2.2": "katame dve ",
  "iti48:2.3": "yo abrahmacārī brahmacārīpaṭiñño yo ca paripuṇṇaṃ parisuddhaṃ brahmacariyaṃ carantaṃ amūlakena abrahmacariyena anuddhaṃseti. ",
  "iti48:2.4": "ime kho bhikkhave dve āpāyikā nerayikā idampahāyāti. ",
  "iti48:2.5": "etamatthaṃ bhagavā avoca. ",
  "iti48:2.6": "tatthetaṃ iti vuccati ",
  "iti48:3.1": "abhūtavādī nirayaṃ upeti ",
  "iti48:3.2": "yo cāpi katvā na karomiccāha ",
  "iti48:3.3": "ubhopi te pecca samā bhavanti ",
  "iti48:3.4": "nihīnakammā manujā parattha. ",
  "iti48:4.1": "kāsāvakaṇṭhā bahavo ",
  "iti48:4.2": "pāpadhammā asaññatā ",
  "iti48:4.3": "pāpā pāpehi kammehi ",
  "iti48:4.4": "nirayaṃ te upapajjare ",
  "iti48:5.1": "seyyo ayoguḷo bhutto ",
  "iti48:5.2": "tatto aggisikhūpamo ",
  "iti48:5.3": "yañce bhuñjeyya dussīlo ",
  "iti48:5.4": "raṭṭhapiṇḍaṃ asaññatoti. ",
  "iti48:6.1": "ayampi attho vutto bhagavatā iti me sutanti. ",
  "iti48:6.2": "ekādasamaṃ. "
}
