  "iti77:1.1": "bhagavatā vuttamarahatāti me sutaṃ ",
  "iti77:2.1": "bhindantāyaṃ bhikkhave kāyo viññāṇaṃ virāgadhammaṃ sabbe upadhī aniccā dukkhā vipariṇāmadhammāti. ",
  "iti77:2.2": "etamatthaṃ bhagavā avoca. ",
  "iti77:2.3": "tatthetaṃ iti vuccati ",
  "iti77:3.1": "kāyañca bhindantaṃ ñatvā ",
  "iti77:3.2": "viññāṇañca pabhaṅguṇaṃ ",
  "iti77:3.3": "upadhīsu bhayaṃ disvā ",
  "iti77:3.4": "jātimaraṇamajjagā ",
  "iti77:3.5": "sampatvā paramaṃ santiṃ ",
  "iti77:3.6": "kālaṃ kaṅkhati bhāvitattoti. ",
  "iti77:4.1": "ayampi attho vutto bhagavatā iti me sutanti. ",
  "iti77:4.2": "aṭṭhamaṃ. 9 vuttaṃ hetaṃ "
}
