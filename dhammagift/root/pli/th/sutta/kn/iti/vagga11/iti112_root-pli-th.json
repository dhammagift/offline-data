{
  "iti112:0.1": "",
  "iti112:0.2": "",
  "iti112:0.3": "",
  "iti112:0.4": "",
  "iti112:1.1": "bhagavatā vuttamarahatāti me sutaṃ ",
  "iti112:2.1": "loko bhikkhave tathāgatena abhisambuddho ",
  "iti112:2.2": "lokasmā tathāgato visaṃyutto ",
  "iti112:2.3": "lokasamudayo bhikkhave tathāgatena abhisambuddho ",
  "iti112:2.4": "lokasamudayo tathāgatassa pahīno ",
  "iti112:2.5": "lokanirodho bhikkhave tathāgatena abhisambuddho ",
  "iti112:2.6": "lokanirodho tathāgatassa sacchikato ",
  "iti112:2.7": "lokanirodhagāminī paṭipadā bhikkhave tathāgatena abhisambuddhā ",
  "iti112:2.8": "lokanirodhagāminī paṭipadā tathāgatassa bhāvitā. ",
  "iti112:3.1": "yaṃ bhikkhave sadevakassa lokassa samārakassa sabrahmakassa sassamaṇabrāhmaṇiyā pajāya sadevamanussāya diṭṭhaṃ sutaṃ mutaṃ viññātaṃ pattaṃ pariyesitaṃ anuvicaritaṃ manasā yasmā taṃ tathāgatena abhisambuddhaṃ ",
  "iti112:3.2": "tasmā tathāgatoti vuccati. ",
  "iti112:4.1": "yañca bhikkhave rattiṃ tathāgato anuttaraṃ sammāsambodhiṃ abhisambujjhati yañca rattiṃ anupādisesāya nibbānadhātuyā parinibbāyati yametasmiṃ antare bhāsati lapati niddisati sabbantaṃ tatheva hoti no aññathā ",
  "iti112:4.2": "tasmā tathāgatoti vuccati. ",
  "iti112:5.1": "yathāvādī bhikkhave tathāgato tathākārī yathākārī tathāvādī ",
  "iti112:5.2": "iti yathāvādī tathākārī yathākārī tathāvādī ",
  "iti112:5.3": "tasmā tathāgatoti vuccati. ",
  "iti112:6.1": "sadevake bhikkhave loke samārake sabrahmake sassamaṇabrāhmaṇiyā pajāya sadevamanussāya tathāgato abhibhū anabhibhūto aññadatthudaso vasavattī ",
  "iti112:6.2": "tasmā tathāgatoti vuccatīti. ",
  "iti112:6.3": "etamatthaṃ bhagavā avoca. ",
  "iti112:6.4": "tatthetaṃ iti vuccati ",
  "iti112:7.1": "sabbalokaṃ abhiññāya ",
  "iti112:7.2": "sabbaloke yathātathaṃ ",
  "iti112:7.3": "sabbalokavisaṃyutto ",
  "iti112:7.4": "sabbaloke anūpamo ",
  "iti112:8.1": "sabbe sabbābhibhū dhīro ",
  "iti112:8.2": "sabbaganthappamocano. ",
  "iti112:8.3": "phuṭṭhassa paramā santi ",
  "iti112:8.4": "nibbānaṃ akutobhayaṃ. ",
  "iti112:9.1": "esa khīṇāsavo buddho ",
  "iti112:9.2": "anīgho chinnasaṃsayo ",
  "iti112:9.3": "sabbakammakkhayaṃ patto ",
  "iti112:9.4": "vimutto upadhisaṅkhaye ",
  "iti112:10.1": "esa so bhagavā buddho ",
  "iti112:10.2": "esa sīho anuttaro ",
  "iti112:10.3": "sadevakassa lokassa ",
  "iti112:10.4": "brahmacakkaṃ pavattayi. ",
  "iti112:11.1": "iti devā manussā ca ",
  "iti112:11.2": "ye buddhaṃ saraṇaṃ gatā ",
  "iti112:11.3": "saṅgamma taṃ namassanti ",
  "iti112:11.4": "mahantaṃ vītasāradaṃ. ",
  "iti112:12.1": "danto damayataṃ seṭṭho ",
  "iti112:12.2": "santo samayataṃ isī ",
  "iti112:12.3": "mutto mocayataṃ aggo ",
  "iti112:12.4": "tiṇṇo tārayataṃ varo. ",
  "iti112:13.1": "iti hetaṃ namassanti ",
  "iti112:13.2": "mahantaṃ vītasāradaṃ. ",
  "iti112:13.3": "sadevakasmiṃ lokasmiṃ ",
  "iti112:13.4": "natthi te paṭipuggaloti. ",
  "iti112:14.1": "ayampi attho vutto bhagavatā iti me sutanti. ",
  "iti112:14.2": "terasamaṃ. ",
  "iti112:14.3": "catukkanipāto niṭṭhito. ",
  "iti112:15.0": "tassuddānaṃ ",
  "iti112:15.1": "brāhmaṇā cattāri jānaṃ ",
  "iti112:15.2": "samaṇasīlā taṇhā brahmā ",
  "iti112:15.3": "bahukārā kuhanā purisā ",
  "iti112:15.4": "caraṃ sampannalokena terasāti. ",
  "iti112:16.0": "itivuttake dvādasādhikasatasuttanti itivuttakaṃ niṭṭhitaṃ. ",
  "iti112:16.1": "sattavisekanipātaṃ ",
  "iti112:16.2": "dukkaṃ bāvīsasuttasaṅgahitaṃ ",
  "iti112:16.3": "samapaññāsamatha tikaṃ ",
  "iti112:16.4": "terasa catukkañca iti yamidaṃ ",
  "iti112:17.1": "dvidasuttarasuttasate ",
  "iti112:17.2": "saṃgāyitvā samādahaṃsu purā ",
  "iti112:17.3": "arahanto ciraṭṭhitiyā ",
  "iti112:17.4": "tamāhu nāmena itivuttanti. ",
  "iti112:17.5": "itivuttakapāḷi niṭṭhitā. idaṃ marammapotthake āgataṃ. suttantapiṭake khuddakanikāyassa suttanipāto namo tassa bhagavato arahato sammāsambuddhassa. paṭhamo uragavaggo paṭhamaṃ uragasuttaṃ 1 "
}
