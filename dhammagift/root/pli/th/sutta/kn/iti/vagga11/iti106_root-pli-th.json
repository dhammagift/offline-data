  "iti106:1.1": "",
  "iti106:2.1": "sabrahmakāni bhikkhave tāni kulāni yesaṃ puttānaṃ mātāpitaro ajjhāgāre pūjitā honti. ",
  "iti106:2.2": "sapubbadevatāni bhikkhave tāni kulāni yesaṃ puttānaṃ mātāpitaro ajjhāgāre pūjitā honti. ",
  "iti106:2.3": "sapubbācariyāni bhikkhave tāni kulāni yesaṃ puttānaṃ mātāpitaro ajjhāgāre pūjitā honti. ",
  "iti106:2.4": "sāhuneyyāni bhikkhave tāni kulāni yesaṃ puttānaṃ mātāpitaro ajjhāgāre pūjitā honti. ",
  "iti106:3.1": "brahmāti bhikkhave mātāpitūnaṃ etaṃ adhivacanaṃ. ",
  "iti106:3.2": "pubbadevatāti bhikkhave mātāpitūnaṃ etaṃ adhivacanaṃ. ",
  "iti106:3.3": "pubbācariyāti bhikkhave mātāpitūnaṃ etaṃ adhivacanaṃ. ",
  "iti106:3.4": "āhuneyyāti bhikkhave mātāpitūnaṃ etaṃ adhivacanaṃ. ",
  "iti106:3.5": "taṃ kissa hetu ",
  "iti106:3.6": "bahukārā bhikkhave mātāpitaro puttānaṃ āpādakā posakā imassa dassetāroti. ",
  "iti106:3.7": "",
  "iti106:3.8": "",
  "iti106:4.1": "brahmāti mātāpitaro ",
  "iti106:4.2": "pubbācariyāti vuccare ",
  "iti106:4.3": "āhuneyyā ca puttānaṃ ",
  "iti106:4.4": "pajāya anukampakā. ",
  "iti106:5.1": "tasmā hi ne namasseyya ",
  "iti106:5.2": "sakkareyya ca paṇḍito ",
  "iti106:5.3": "annena atho pānena ",
  "iti106:5.4": "vatthena sayanena ca ",
  "iti106:5.5": "ucchādanena nhāpanena ",
  "iti106:5.6": "pādānaṃ dhovanena ca. ",
  "iti106:6.1": "tāya naṃ pāricariyāya ",
  "iti106:6.2": "mātāpitūsu paṇḍitā ",
  "iti106:6.3": "idheva naṃ pasaṃsanti ",
  "iti106:6.4": "pecca sagge pamodatīti. ",
  "iti106:7.1": "",
  "iti106:7.2": "sattamaṃ. 8 "
}
