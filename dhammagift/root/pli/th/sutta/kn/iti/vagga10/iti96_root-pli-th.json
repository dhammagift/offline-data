  "iti96:1.1": "",
  "iti96:2.1": "kāmayogayutto bhikkhave bhavayogayutto āgāmī hoti āgantvā itthattaṃ. ",
  "iti96:2.2": "kāmayogavisaṃyutto bhikkhave bhavayogayutto anāgāmī hoti anāgantvā itthattaṃ. ",
  "iti96:2.3": "kāmayogavisaṃyutto bhikkhave bhavayogavisaṃyutto arahaṃ hoti khīṇāsavoti. ",
  "iti96:2.4": "",
  "iti96:2.5": "",
  "iti96:3.1": "kāmayogena saṃyuttā ",
  "iti96:3.2": "bhavayogena cūbhayaṃ ",
  "iti96:3.3": "sattā gacchanti saṃsāraṃ ",
  "iti96:3.4": "jātimaraṇagāminanti. ",
  "iti96:4.1": "ye ca kāme pahantvāna ",
  "iti96:4.2": "appattā āsavakkhayaṃ ",
  "iti96:4.3": "bhavayogena saṃyuttā ",
  "iti96:4.4": "anāgāmīti vuccare. ",
  "iti96:5.1": "ye ca kho chinnasaṃsayā ",
  "iti96:5.2": "khīṇamānapunabbhavā ",
  "iti96:5.3": "te ve pāragatā loke ",
  "iti96:5.4": "ye pattā āsavakkhayanti. ",
  "iti96:6.1": "",
  "iti96:6.2": "sattamaṃ. 8 ",
  "iti96:6.3": ""
}
