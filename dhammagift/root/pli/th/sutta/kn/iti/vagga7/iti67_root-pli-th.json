  "iti67:0.4": "",
  "iti67:1.1": "8 vuttaṃ hetaṃ bhagavatā vuttamarahatāti me sutaṃ ",
  "iti67:2.1": "tīṇimāni bhikkhave moneyyāni ",
  "iti67:2.2": "katamāni tīṇi ",
  "iti67:2.3": "kāyamoneyyaṃ vacīmoneyyaṃ manomoneyyaṃ. ",
  "iti67:2.4": "imāni kho bhikkhave tīṇi moneyyānīti. ",
  "iti67:2.5": "etamatthaṃ bhagavā avoca. ",
  "iti67:2.6": "tatthetaṃ iti vuccati ",
  "iti67:3.1": "kāyamuniṃ vācāmuniṃ ",
  "iti67:3.2": "manomunimanāsavaṃ ",
  "iti67:3.3": "muniṃ moneyyasampannaṃ ",
  "iti67:3.4": "āhu ninhātapāpakanti. ",
  "iti67:4.1": "ayampi attho vutto bhagavatā iti me sutanti. ",
  "iti67:4.2": "aṭṭhamaṃ. "
}
