  "iti60:0.4": "",
  "iti60:1.1": "bhagavatā vuttamarahatāti me sutaṃ ",
  "iti60:2.1": "tīṇimāni bhikkhave puññakiriyāvatthūni ",
  "iti60:2.2": "katamāni tīṇi ",
  "iti60:2.3": "dānamayaṃ puññakiriyāvatthu sīlamayaṃ puññakiriyāvatthu bhāvanāmayaṃ puññakiriyāvatthu. ",
  "iti60:2.4": "imāni kho bhikkhave tīṇi puññakiriyāvatthūnīti. ",
  "iti60:2.5": "etamatthaṃ bhagavā avoca. ",
  "iti60:2.6": "tatthetaṃ iti vuccati ",
  "iti60:3.1": "puññameva so sikkheyya ",
  "iti60:3.2": "āyataggaṃ sukhindriyaṃ ",
  "iti60:3.3": "dānañca samacariyañca ",
  "iti60:3.4": "mettacittañca bhāvaye ",
  "iti60:4.1": "ete dhamme bhāvayitvā ",
  "iti60:4.2": "tayo sukhasamuddaye ",
  "iti60:4.3": "abyāpajjhaṃ sukhaṃ lokaṃ ",
  "iti60:4.4": "paṇḍito upapajjatīti. ",
  "iti60:5.1": "ayampi attho vutto bhagavatā iti me sutanti. ",
  "iti60:5.2": "paṭhamaṃ. 2 vuttaṃ hetaṃ "
}
