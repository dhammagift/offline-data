  "iti88:0.4": "",
  "iti88:1.1": "9 ",
  "iti88:2.1": "tayome bhikkhave antarā malā antarā amittā antarā sapattā antarā vadhakā antarā paccatthikā ",
  "iti88:2.2": "katame tayo ",
  "iti88:2.3": "lobho bhikkhave antarā malo antarā amitto antarā sapatto antarā vadhako antarā paccatthiko. ",
  "iti88:2.4": "doso bhikkhave antarā malo antarā amitto antarā sapatto antarā vadhako antarā paccatthiko. ",
  "iti88:2.5": "moho bhikkhave antarā malo antarā amitto antarā sapatto antarā vadhako antarā paccatthiko. ",
  "iti88:2.6": "ime kho bhikkhave tayo antarā malā antarā amittā antarā ",
  "iti88:2.7": "sapattā antarā vadhakā ",
  "iti88:2.8": "antarā paccatthikāti. ",
  "iti88:3.1": "anatthajanano lobho ",
  "iti88:3.2": "lobho cittappakopano ",
  "iti88:3.3": "bhayamantarato jātaṃ ",
  "iti88:3.4": "taṃ jano nāvabujjhati. ",
  "iti88:4.1": "luddho atthaṃ na jānāti ",
  "iti88:4.2": "luddho dhammaṃ na passati ",
  "iti88:4.3": "andhatamaṃ tadā hoti ",
  "iti88:4.4": "yaṃ lobho sahate naraṃ. ",
  "iti88:5.1": "yo ca lobhaṃ pahantvāna ",
  "iti88:5.2": "lobhaneyye na lubbhati ",
  "iti88:5.3": "lobho pahiyyate tamhā ",
  "iti88:5.4": "udabinduva pokkharā. ",
  "iti88:6.1": "anatthajanano doso ",
  "iti88:6.2": "doso cittappakopano ",
  "iti88:6.3": "bhayamantarato jātaṃ ",
  "iti88:6.4": "taṃ jano nāvabujjhati. ",
  "iti88:7.1": "duṭṭho atthaṃ na jānāti ",
  "iti88:7.2": "duṭṭho dhammaṃ na passati ",
  "iti88:7.3": "andhatamaṃ tadā hoti ",
  "iti88:7.4": "yaṃ doso sahate naraṃ. ",
  "iti88:8.1": "yo ca dosaṃ pahantvāna ",
  "iti88:8.2": "dosaneyye na dussati ",
  "iti88:8.3": "doso pahiyyate tamhā ",
  "iti88:8.4": "tālapakkaṃva bandhanā. ",
  "iti88:9.1": "anatthajanano moho ",
  "iti88:9.2": "moho cittappakopano ",
  "iti88:9.3": "bhayamantarato jātaṃ ",
  "iti88:9.4": "taṃ jano nāvabujjhati. ",
  "iti88:10.1": "mūḷho atthaṃ na jānāti ",
  "iti88:10.2": "mūḷho dhammaṃ na passati ",
  "iti88:10.3": "andhatamaṃ tadā hoti ",
  "iti88:10.4": "yaṃ moho sahate naraṃ. ",
  "iti88:11.1": "yo ca mohaṃ pahantvāna ",
  "iti88:11.2": "mohaneyye na muyhati ",
  "iti88:11.3": "mohaṃ vihanti so sabbaṃ ",
  "iti88:11.4": "ādiccovudayaṃ tamanti. ",
  "iti88:12.1": "",
  "iti88:12.2": "navamaṃ. "
}
