  "ja468:0.3": "",
  "ja468:0.4": "5 janasandhajātakaṃ ",
  "ja468:1.1": "dasa khalumāni ṭhānāni ",
  "ja468:1.2": "yāni pubbe akaritvā ",
  "ja468:1.3": "sa pacchā anutappati iccāha ",
  "ja468:1.4": "rājā janasandho. ",
  "ja468:2.1": "aladdhā vittaṃ tapati ",
  "ja468:2.2": "pubbe asamudānitaṃ ",
  "ja468:2.3": "na pubbe dhanamesissaṃ ",
  "ja468:2.4": "iti pacchānutappati. ",
  "ja468:3.1": "sakyarūpaṃ pure santaṃ ",
  "ja468:3.2": "mayā sippaṃ na sikkhitaṃ ",
  "ja468:3.3": "kicchā vutti asippassa ",
  "ja468:3.4": "iti pacchānutappati. ",
  "ja468:4.1": "kūṭavedī pure āsiṃ ",
  "ja468:4.2": "pisuṇo piṭṭhimaṃsiko ",
  "ja468:4.3": "caṇḍo ca pharuso cāsiṃ ",
  "ja468:4.4": "iti pacchānutappati. ",
  "ja468:5.1": "pāṇātipātī pure āsiṃ ",
  "ja468:5.2": "luddo cāpi anāriyo ",
  "ja468:5.3": "bhūtānaṃ nāpacāyissaṃ ",
  "ja468:5.4": "iti pacchānutappati. ",
  "ja468:6.1": "bahūsu vata santīsu ",
  "ja468:6.2": "anāpadāsu itthisu ",
  "ja468:6.3": "paradāraṃ āsevissaṃ ",
  "ja468:6.4": "iti pacchānutappati. ",
  "ja468:7.1": "bahumhi vata santamhi ",
  "ja468:7.2": "annapāne upaṭṭhite ",
  "ja468:7.3": "na pubbe adadaṃ dānaṃ ",
  "ja468:7.4": "iti pacchānutappati. ",
  "ja468:8.1": "mātaraṃ pitaraṃ ",
  "ja468:8.2": "cāpi jiṇṇake ",
  "ja468:8.3": "gatayobbane pahusanto na posissaṃ ",
  "ja468:8.4": "iti pacchānutappati. ",
  "ja468:9.1": "ācariyamanusatthāraṃ ",
  "ja468:9.2": "sabbakāmarasāharaṃ ",
  "ja468:9.3": "pitaraṃ atimaññissaṃ ",
  "ja468:9.4": "iti pacchānutappati. ",
  "ja468:10.1": "samaṇe brāhmaṇe cāpi ",
  "ja468:10.2": "sīlavante bahussute ",
  "ja468:10.3": "na pubbe payirupāsissaṃ ",
  "ja468:10.4": "iti pacchānutappati. ",
  "ja468:11.1": "sādhu hoti tapo ciṇṇo ",
  "ja468:11.2": "santo ca payirupāsito ",
  "ja468:11.3": "na ca pubbe tapo ciṇṇo ",
  "ja468:11.4": "iti pacchānutappati. ",
  "ja468:12.1": "yo ca etāni ṭhānāni ",
  "ja468:12.2": "yoniso paṭipajjati ",
  "ja468:12.3": "karaṃ purisakiccāni ",
  "ja468:12.4": "sa pacchā nānutappatīti. ",
  "ja468:13.1": "janasandhajātakaṃ pañcamaṃ. "
}
