  "ja250:0.3": "",
  "ja250:0.4": "10 kapijātakaṃ ",
  "ja250:1.1": "ayaṃ isi upasamasaññame rato ",
  "ja250:1.2": "sa tiṭṭhati sisirabhayena addhito ",
  "ja250:1.3": "handa ayaṃ pavisatumaṃ agārakaṃ ",
  "ja250:1.4": "vinetu sītaṃ darathañca kevalaṃ. ",
  "ja250:2.1": "nāyaṃ isi upasamasaññame rato ",
  "ja250:2.2": "kapi ayaṃ dumbarasākhagocaro ",
  "ja250:2.3": "so dūsako rosako cāpi jammo ",
  "ja250:2.4": "sace vaje imampi dūsaye gharanti. ",
  "ja250:3.1": "kapijātakaṃ dasamaṃ. ",
  "ja250:3.2": "sigālavaggo dasamo. ",
  "ja250:4.1": "tassuddānaṃ. ",
  "ja250:5.1": "atha rājā sigālavaro sunakho ",
  "ja250:5.2": "tathā kosiya icchati kālaghaso ",
  "ja250:5.3": "atha dānavaroṭṭhapi sārathinā ",
  "ja250:5.4": "punampavanañca sisirakapi dasa. ",
  "ja250:6.1": "vagguddānaṃ. ",
  "ja250:7.1": "daḷhañca vaggaṃ aparena santhavaṃ kalyāṇavaggāsadiso ca ruhakaṃ nataṃdaḷhaṃ ",
  "ja250:7.2": "bīraṇatthambhakā ",
  "ja250:7.3": "puna ",
  "ja250:7.4": "kāsāvupāhana sigālakena dasāti. ",
  "ja250:8.1": "dukanipātaṃ niṭṭhitaṃ. "
}
