  "ja170:0.3": "",
  "ja170:0.4": "10 kakaṇṭakajātakaṃ ",
  "ja170:1.1": "nāyaṃ pure unnamati ",
  "ja170:1.2": "toraṇagge kakaṇṭako ",
  "ja170:1.3": "mahosadha vijānāhi ",
  "ja170:1.4": "kena thaddho kakaṇṭako. ",
  "ja170:2.1": "aladdhapubbaṃ laddhāna ",
  "ja170:2.2": "aḍḍhamāsaṃ kakaṇṭako ",
  "ja170:2.3": "atimaññati rājānaṃ ",
  "ja170:2.4": "vedehaṃ mithilaggahanti. ",
  "ja170:3.1": "kakaṇṭakajātakaṃ dasamaṃ. ",
  "ja170:3.2": "santhavavaggo dutiyo. ",
  "ja170:4.1": "tassuddānaṃ. ",
  "ja170:5.1": "atha indasamāna sapaṇṇakuṭi ",
  "ja170:5.2": "susimuttama gijjha jalābujako ",
  "ja170:5.3": "upasāḷhaka bhikkhu salāpavaro ",
  "ja170:5.4": "atha mettavaro dasa puṇṇamāti. "
}
