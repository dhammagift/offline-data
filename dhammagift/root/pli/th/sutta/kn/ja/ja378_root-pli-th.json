  "ja378:0.1": "",
  "ja378:0.2": "",
  "ja378:0.3": "",
  "ja378:0.4": "3 darīmukhajātakaṃ ",
  "ja378:1.1": "paṅko ca kāmā palipo ca kāmā ",
  "ja378:1.2": "bhayañca metaṃ timūlaṃ pavuttaṃ ",
  "ja378:1.3": "rajo ca dhūmo ca mayā pakāsitā ",
  "ja378:1.4": "hitvā tuvaṃ pabbaja brahmadatta. ",
  "ja378:2.1": "gadhito ca ratto ca adhimucchito ca ",
  "ja378:2.2": "kāmesvāhaṃ brāhmaṇa bhiṃsarūpaṃ ",
  "ja378:2.3": "taṃ nussahe jīvikattho pahātuṃ ",
  "ja378:2.4": "kāhāmi puññāni anappakāni. ",
  "ja378:3.1": "yo atthakāmassa hitānukampino ",
  "ja378:3.2": "ovajjamāno na karoti sāsanaṃ ",
  "ja378:3.3": "idameva seyyo iti maññamāno ",
  "ja378:3.4": "punappunaṃ gabbhamupeti mando. ",
  "ja378:4.1": "so ghorarūpaṃ nirayaṃ upeti ",
  "ja378:4.2": "subhāsubhaṃ muttakarīsapūraṃ ",
  "ja378:4.3": "sattā sakāye na jahanti giddhā ",
  "ja378:4.4": "ye honti kāmesu avītarāgā. ",
  "ja378:5.1": "miḷhena littā ruhirena makkhitā ",
  "ja378:5.2": "semhena littā upanikkhamanti ",
  "ja378:5.3": "yaṃ yaṃ hi kāyena phusanti tāvade ",
  "ja378:5.4": "sabbaṃ asātaṃ dukkhameva kevalaṃ. ",
  "ja378:6.1": "disvā vadāmi na hi aññato savaṃ ",
  "ja378:6.2": "pubbenivāsaṃ bahukaṃ sarāmi ",
  "ja378:6.3": "citrāhi gāthāhi subhāsitāhi ",
  "ja378:6.4": "darīmukho nijjhāpayī sumedhanti. ",
  "ja378:7.1": "darīmukhajātakaṃ tatiyaṃ. "
}
