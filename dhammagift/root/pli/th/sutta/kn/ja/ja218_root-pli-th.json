  "ja218:0.1": "",
  "ja218:0.2": "",
  "ja218:0.3": "",
  "ja218:0.4": "8 kūṭavāṇijajātakaṃ ",
  "ja218:1.1": "saṭhassa sāṭheyyamidaṃ sucintitaṃ ",
  "ja218:1.2": "paccoḍḍitaṃ paṭikūṭassa kūṭaṃ ",
  "ja218:1.3": "phālaṃ ce khādeyyuṃ mūsikā ",
  "ja218:1.4": "kasmā kumāraṃ kulalā no hareyyuṃ. ",
  "ja218:2.1": "kūṭassa hi santi kūṭakūṭā ",
  "ja218:2.2": "bhavati paro nikatino nikatyā ",
  "ja218:2.3": "dehi puttanaṭṭha phālanaṭṭhassa phālaṃ ",
  "ja218:2.4": "mā te puttamahāsi phālanaṭṭhoti. ",
  "ja218:3.1": "kūṭavāṇijajātakaṃ aṭṭhamaṃ. "
}
