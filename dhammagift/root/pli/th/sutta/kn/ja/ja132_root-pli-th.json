  "ja132:0.3": "",
  "ja132:0.4": "2 pañcabhīrukajātakaṃ ",
  "ja132:1.1": "kusalūpadese dhitiyā daḷhāya ca ",
  "ja132:1.2": "avatthitattā bhayabhīrutāya ca ",
  "ja132:1.3": "na rakkhasīnaṃ vasamāgamimha ",
  "ja132:1.4": "sa sotthibhāvo mahatā bhayena meti. ",
  "ja132:2.1": "pañcabhīrukajātakaṃ dutiyaṃ. "
}
