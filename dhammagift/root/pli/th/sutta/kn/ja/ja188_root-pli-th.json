  "ja188:0.3": "",
  "ja188:0.4": "8 sīhakotthukajātakaṃ ",
  "ja188:1.1": "sīhaṅguli sīhanakho ",
  "ja188:1.2": "sīhapādappatiṭṭhito ",
  "ja188:1.3": "so sīho sīhasaṅghamhi ",
  "ja188:1.4": "eko nadati aññathā. ",
  "ja188:2.1": "mā tvaṃ nadi rājaputta ",
  "ja188:2.2": "appasaddo vane vasa ",
  "ja188:2.3": "sarena kho taṃ jāneyyuṃ ",
  "ja188:2.4": "na hi te pettiko saroti. ",
  "ja188:3.1": "sīhakotthukajātakaṃ aṭṭhamaṃ "
}
