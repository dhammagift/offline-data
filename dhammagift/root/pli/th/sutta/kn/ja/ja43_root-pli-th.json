  "ja43:0.4": "3 veḷukajātakaṃ ",
  "ja43:1.1": "yo atthakāmassa hitānukampino ",
  "ja43:1.2": "ovajjamāno na karoti sāsanaṃ ",
  "ja43:1.3": "evaṃ so nihato seti ",
  "ja43:1.4": "veḷukassa yathā pitāti. ",
  "ja43:2.1": "veḷukajātakaṃ tatiyaṃ. "
}
