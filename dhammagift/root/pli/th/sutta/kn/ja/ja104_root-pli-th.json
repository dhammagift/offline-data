  "ja104:0.3": "",
  "ja104:0.4": "4 mittavindajātakaṃ ",
  "ja104:1.1": "catubbhi aṭṭhajjhagamā ",
  "ja104:1.2": "aṭṭhābhipi ca soḷasa ",
  "ja104:1.3": "soḷasābhi ca battiṃsa ",
  "ja104:1.4": "atricchaṃ cakkamāsado ",
  "ja104:1.5": "icchāhatassa posassa ",
  "ja104:1.6": "cakkaṃ bhamati matthaketi. ",
  "ja104:2.1": "mittavindajātakaṃ catutthaṃ. "
}
