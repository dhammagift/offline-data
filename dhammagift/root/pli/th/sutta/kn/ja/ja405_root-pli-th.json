  "ja405:0.1": "",
  "ja405:0.2": "",
  "ja405:0.3": "",
  "ja405:0.4": "10 bakabrahmajātakaṃ ",
  "ja405:1.1": "dvāsattati gotama puññakammā ",
  "ja405:1.2": "vasavattino jātijaraṃ atītā ",
  "ja405:1.3": "ayamantimā vedagū brahmupapatti ",
  "ja405:1.4": "asmābhijappanti janā anekā. ",
  "ja405:2.1": "appañca hetaṃ na hi dīghamāyu ",
  "ja405:2.2": "yaṃ tvaṃ baka maññasi dīghamāyuṃ ",
  "ja405:2.3": "sataṃ sahassāna nirabbudānaṃ ",
  "ja405:2.4": "āyuṃ pajānāmi tavāha brahme. ",
  "ja405:3.1": "anantadassī bhagavāhamasmi ",
  "ja405:3.2": "jātijjaraṃ sokamupātivatto ",
  "ja405:3.3": "kiṃ me purāṇaṃ vatasīlavattaṃ ",
  "ja405:3.4": "ācikkha metaṃ yamahaṃ vijaññaṃ. ",
  "ja405:4.1": "yaṃ tvaṃ apāyesi bahū manusse ",
  "ja405:4.2": "pipāsite ghammanisamparete ",
  "ja405:4.3": "tante purāṇaṃ vatasīlavattaṃ ",
  "ja405:4.4": "suttappabuddhova anussarāmi. ",
  "ja405:5.1": "yaṃ eṇikūlasmiṃ janataṃ gahītaṃ ",
  "ja405:5.2": "amocayī gayhaka nīyamānaṃ ",
  "ja405:5.3": "tante purāṇaṃ vatasīlavattaṃ ",
  "ja405:5.4": "suttappabuddhova anussarāmi. ",
  "ja405:6.1": "gaṅgāya sotasmiṃ gahītanāvaṃ ",
  "ja405:6.2": "luddena nāgena manussakappā ",
  "ja405:6.3": "amocayī tvaṃ balasā pasayha ",
  "ja405:6.4": "tante purāṇaṃ vatasīlavattaṃ ",
  "ja405:6.5": "suttappabuddhova anussarāmi. ",
  "ja405:7.1": "kappo ca te patthacaro ahosiṃ ",
  "ja405:7.2": "sambuddhivantaṃ vati taṃ amaññaṃ ",
  "ja405:7.3": "tante purāṇaṃ vatasīlavattaṃ ",
  "ja405:7.4": "suttappabuddhova anussarāmi. ",
  "ja405:8.1": "addhā pajānāsi mametamāyuṃ ",
  "ja405:8.2": "aññaṃpi jānāsi tathāhi buddho ",
  "ja405:8.3": "tathāhi tāyaṃ jalitānubhāvo ",
  "ja405:8.4": "obhāsayaṃ tiṭṭhati brahmalokanti. ",
  "ja405:9.1": "bakabrahmajātakaṃ dasamaṃ. ",
  "ja405:9.2": "kukkuvaggo paṭhamo. ",
  "ja405:10.1": "tassuddānaṃ. ",
  "ja405:11.1": "varakaṇṇika cāpavaro sutano ",
  "ja405:11.2": "atha gijjha sarohitamacchavaro ",
  "ja405:11.3": "puna dasaṇṇaka senaka yācanako ",
  "ja405:11.4": "atha verī sabrahmabakena dasa. "
}
