  "ja44:0.4": "4 makasajātakaṃ ",
  "ja44:1.1": "seyyo amitto matiyā upeto ",
  "ja44:1.2": "na tveva mitto mativippahīno ",
  "ja44:1.3": "makasaṃ vadhissanti hi elamūgo ",
  "ja44:1.4": "putto pitu abbhidā uttamaṅganti. ",
  "ja44:2.1": "makasajātakaṃ catutthaṃ. "
}
