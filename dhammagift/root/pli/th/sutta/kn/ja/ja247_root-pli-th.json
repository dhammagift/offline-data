  "ja247:0.3": "",
  "ja247:0.4": "7 pādañjalijātakaṃ ",
  "ja247:1.1": "addhā pādañjalī sabbe ",
  "ja247:1.2": "paññāya atirocati ",
  "ja247:1.3": "tathā hi oṭṭhaṃ bhañjati ",
  "ja247:1.4": "uttariṃ nūna passati. ",
  "ja247:2.1": "nāyaṃ dhammaṃ adhammaṃ vā ",
  "ja247:2.2": "atthānatthañca bujjhati ",
  "ja247:2.3": "aññatra oṭṭhanibbhogā ",
  "ja247:2.4": "nāyaṃ jānāti kiñcananti. ",
  "ja247:3.1": "pādañjalijātakaṃ sattamaṃ. "
}
