  "ja294:0.3": "",
  "ja294:0.4": "4 jambūkhādakajātakaṃ ",
  "ja294:1.1": "koyaṃ bindussaro vaggu ",
  "ja294:1.2": "saravantānamuttamo ",
  "ja294:1.3": "accuto jambusākhāya ",
  "ja294:1.4": "moracchāpova kujjati. ",
  "ja294:2.1": "kulaputto pajānāti ",
  "ja294:2.2": "kulaputtaṃ pasaṃsituṃ ",
  "ja294:2.3": "byagghacchāpasadisavaṇṇa ",
  "ja294:2.4": "bhuñja samma dadāmi te. ",
  "ja294:3.1": "cirassaṃ vata passāmi ",
  "ja294:3.2": "musāvādī samāgate ",
  "ja294:3.3": "vantādaṃ kuṇapādañca ",
  "ja294:3.4": "aññamaññaṃ pasaṃsaketi. ",
  "ja294:4.1": "jambūkhādakajātakaṃ catutthaṃ. "
}
