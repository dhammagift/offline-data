  "ja314:0.1": "",
  "ja314:0.2": "",
  "ja314:0.3": "",
  "ja314:0.4": "4 lohakumbhijātakaṃ ",
  "ja314:1.1": "dujjīvitamajīvimha ",
  "ja314:1.2": "yesanno na dadāmase ",
  "ja314:1.3": "vijjamānesu bhogesu ",
  "ja314:1.4": "dīpaṃ nākamha attano. ",
  "ja314:2.1": "saṭṭhiṃ vassasahassāni ",
  "ja314:2.2": "paripuṇṇāni sabbaso ",
  "ja314:2.3": "niraye paccamānānaṃ ",
  "ja314:2.4": "kadā anto bhavissati. ",
  "ja314:3.1": "natthi anto kuto anto ",
  "ja314:3.2": "na anto paṭidissati ",
  "ja314:3.3": "tadāhi pakataṃ pāpaṃ ",
  "ja314:3.4": "mama tuyhañca mārisa. ",
  "ja314:4.1": "sohaṃ nūna ito gantvā ",
  "ja314:4.2": "yoniṃ laddhāna mānusiṃ ",
  "ja314:4.3": "vadaññū sīlasampanno ",
  "ja314:4.4": "kāhāmi kusalaṃ bahunti. ",
  "ja314:5.1": "lohakumbhijātakaṃ catutthaṃ. "
}
