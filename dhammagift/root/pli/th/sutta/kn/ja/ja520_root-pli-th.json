  "ja520:0.3": "",
  "ja520:0.4": "10 bhaṇḍutiṇḍukajātakaṃ ",
  "ja520:1.1": "appamādo amataṃ padaṃ ",
  "ja520:1.2": "pamādo maccuno padaṃ ",
  "ja520:1.3": "appamattā na mīyanti ",
  "ja520:1.4": "ye pamattā yathā matā. ",
  "ja520:2.1": "madā pamādo jāyetha ",
  "ja520:2.2": "pamādā jāyate khayo ",
  "ja520:2.3": "khayā padosā jāyanti ",
  "ja520:2.4": "mā mado bharatūsabha. ",
  "ja520:3.1": "bahū hi khattiyā jīnā ",
  "ja520:3.2": "atthaṃ raṭṭhaṃ pamādino ",
  "ja520:3.3": "athopi gāmino gāmā ",
  "ja520:3.4": "anāgārā agārino. ",
  "ja520:4.1": "khattiyassa pamattassa ",
  "ja520:4.2": "raṭṭhasmiṃ raṭṭhavaḍḍhana ",
  "ja520:4.3": "sabbe bhogā vinassanti ",
  "ja520:4.4": "rañño taṃ vuccate aghaṃ. ",
  "ja520:5.1": "nesa dhammo mahārāja ",
  "ja520:5.2": "ativelaṃ pamajjasi ",
  "ja520:5.3": "iddhaṃ phītaṃ janapadaṃ ",
  "ja520:5.4": "corā viddhaṃsayanti naṃ. ",
  "ja520:6.1": "na te puttā bhavissanti ",
  "ja520:6.2": "na hiraññaṃ na dhāniyaṃ ",
  "ja520:6.3": "raṭṭhe vilumpamānamhi ",
  "ja520:6.4": "sabbabhogehi jiyyasi. ",
  "ja520:7.1": "sabbabhogaparijiṇṇaṃ ",
  "ja520:7.2": "rājānaṃ vāpi khattiyaṃ ",
  "ja520:7.3": "ñātimittā suhajjā ca ",
  "ja520:7.4": "na taṃ maññanti mantiyaṃ. ",
  "ja520:8.1": "hatthārohā anīkaṭṭhā ",
  "ja520:8.2": "rathikā pattikārakā ",
  "ja520:8.3": "tamevamupajīvantā ",
  "ja520:8.4": "na taṃ maññanti mantiyaṃ. ",
  "ja520:9.1": "asaṃvihitakammantaṃ ",
  "ja520:9.2": "bālaṃ dummantimantinaṃ ",
  "ja520:9.3": "sirī jahati dummedhaṃ ",
  "ja520:9.4": "jiṇṇaṃva urago tacaṃ. ",
  "ja520:10.1": "susaṃvihitakammantaṃ ",
  "ja520:10.2": "kāluṭṭhāyiṃ atanditaṃ ",
  "ja520:10.3": "sabbe bhogābhivaḍḍhanti ",
  "ja520:10.4": "gāvo sausabhāmiva ",
  "ja520:11.1": "upassutiṃ mahārāja ",
  "ja520:11.2": "raṭṭhe janapade cara ",
  "ja520:11.3": "tattha disvā ca sutvā ca ",
  "ja520:11.4": "tato taṃ paṭipajjasi. ",
  "ja520:12.1": "evaṃ vedetu pañcālo ",
  "ja520:12.2": "saṅgāme saramappito ",
  "ja520:12.3": "yathāhamajja vedemi ",
  "ja520:12.4": "kaṇṭakena samappito. ",
  "ja520:13.1": "jiṇṇo dubbalacakkhūsi ",
  "ja520:13.2": "na rūpaṃ sādhu passasi ",
  "ja520:13.3": "kiṃ tattha brahmadattassa ",
  "ja520:13.4": "yantaṃ maggeyya kaṇṭako. ",
  "ja520:14.1": "bahvettha brahmadattassa ",
  "ja520:14.2": "yohaṃ maggasmi brāhmaṇa ",
  "ja520:14.3": "arakkhitā jānapadā ",
  "ja520:14.4": "adhammabalinā hatā. ",
  "ja520:15.1": "rattiñhi corā khādanti ",
  "ja520:15.2": "divā khādanti tuṇḍiyā ",
  "ja520:15.3": "raṭṭhasmiṃ kūṭarājassa ",
  "ja520:15.4": "bahu adhammiko jano. ",
  "ja520:16.1": "etādise bhaye jāte ",
  "ja520:16.2": "bhayaṭṭā tāta māṇavā ",
  "ja520:16.3": "nillenakāni kubbanti ",
  "ja520:16.4": "vane āhatva kaṇṭakaṃ. ",
  "ja520:17.1": "kadāssu nāma yaṃ rājā ",
  "ja520:17.2": "brahmadatto marissati ",
  "ja520:17.3": "yassa raṭṭhasmi jiyyanti ",
  "ja520:17.4": "appatikā kumārikā. ",
  "ja520:18.1": "dubbhāsitañhi te jammi ",
  "ja520:18.2": "anatthapadakovide ",
  "ja520:18.3": "kuhiṃ rājā kumārīnaṃ ",
  "ja520:18.4": "bhattāraṃ pariyesati. ",
  "ja520:19.1": "na me dubbhāsitaṃ brahme ",
  "ja520:19.2": "kovidatthapadā ahaṃ ",
  "ja520:19.3": "arakkhitā jānapadā ",
  "ja520:19.4": "adhammabalinā hatā. ",
  "ja520:20.1": "rattiñhi corā khādanti ",
  "ja520:20.2": "divā khādanti tuṇḍiyā ",
  "ja520:20.3": "raṭṭhasmiṃ kūṭarājassa ",
  "ja520:20.4": "bahu adhammiko jano ",
  "ja520:20.5": "dujjīve dubbhare dāre ",
  "ja520:20.6": "kuto bhattā kumāriyā. ",
  "ja520:21.1": "evaṃ sayatu pañcālo ",
  "ja520:21.2": "saṅgāme sattiyā hato ",
  "ja520:21.3": "yathāyaṃ kapaṇo seti ",
  "ja520:21.4": "hato phālena sāliyo. ",
  "ja520:22.1": "adhammena tuvaṃ jamma ",
  "ja520:22.2": "brahmadattassa kujjhasi ",
  "ja520:22.3": "yo tvaṃ sapasi rājānaṃ ",
  "ja520:22.4": "aparajjhitvāna attano. ",
  "ja520:23.1": "dhammena brahmadattassa ",
  "ja520:23.2": "ahaṃ kujjhāmi brāhmaṇa ",
  "ja520:23.3": "arakkhitā jānapadā ",
  "ja520:23.4": "adhammabalinā hatā. ",
  "ja520:24.1": "rattiñhi corā khādanti ",
  "ja520:24.2": "divā khādanti tuṇḍiyā ",
  "ja520:24.3": "raṭṭhasmiṃ kūṭarājassa ",
  "ja520:24.4": "bahu adhammiko jano. ",
  "ja520:25.1": "sā nūna puna re pakkā ",
  "ja520:25.2": "vikāle bhattamāhari ",
  "ja520:25.3": "bhattahāriṃ apekkhanto ",
  "ja520:25.4": "hato phālena sāliyo. ",
  "ja520:26.1": "evaṃ haññatu pañcālo ",
  "ja520:26.2": "saṅgāme asinā hato ",
  "ja520:26.3": "yathāhamajja pahato ",
  "ja520:26.4": "khīrañca me pavattitaṃ. ",
  "ja520:27.1": "yaṃ pasu khīraṃ chaḍḍeti ",
  "ja520:27.2": "pasu phālaṃ vihiṃsati ",
  "ja520:27.3": "kiṃ tattha brahmadattassa ",
  "ja520:27.4": "yaṃ no garahate bhavaṃ. ",
  "ja520:28.1": "gārayho brahme pañcālo ",
  "ja520:28.2": "brahmadattassa rājino ",
  "ja520:28.3": "arakkhitā jānapadā ",
  "ja520:28.4": "adhammabalinā hatā. ",
  "ja520:29.1": "rattiñhi corā khādanti ",
  "ja520:29.2": "divā khādanti tuṇḍiyā ",
  "ja520:29.3": "raṭṭhasmiṃ kūṭarājassa ",
  "ja520:29.4": "bahu adhammiko jano. ",
  "ja520:30.1": "caṇḍā ākaḍḍhanā gāvī ",
  "ja520:30.2": "yaṃ pure na duhāmase ",
  "ja520:30.3": "taṃdāni ajja dohāma ",
  "ja520:30.4": "khīrakāmehupaddutā. ",
  "ja520:31.1": "evaṃ kandatu pañcālo ",
  "ja520:31.2": "vimutto vippasukkhatu ",
  "ja520:31.3": "yathāyaṃ kapaṇā gāvī ",
  "ja520:31.4": "vimuttā paridhāvati. ",
  "ja520:32.1": "yaṃ pasu pasupālassa ",
  "ja520:32.2": "sambhameyya raveyya vā ",
  "ja520:32.3": "konīdha aparādhatthi ",
  "ja520:32.4": "brahmadattassa rājino. ",
  "ja520:33.1": "aparādho mahābrahme ",
  "ja520:33.2": "brahmadattassa rājino ",
  "ja520:33.3": "arakkhitā jānapadā ",
  "ja520:33.4": "adhammabalinā hatā. ",
  "ja520:34.1": "rattiñhi corā khādanti ",
  "ja520:34.2": "divā khādanti tuṇḍiyā ",
  "ja520:34.3": "raṭṭhasmiṃ kūṭarājassa ",
  "ja520:34.4": "bahu adhammiko jano ",
  "ja520:34.5": "kathaṃ no asikosatthā ",
  "ja520:34.6": "khīrapā haññate pajā. ",
  "ja520:35.1": "evaṃ khajjatu pañcālo ",
  "ja520:35.2": "hato yuddhe saputtako ",
  "ja520:35.3": "yathāhamajja khajjāmi ",
  "ja520:35.4": "gāmikehi araññajo. ",
  "ja520:36.1": "na sabbabhūtesu vidhenti rakkhaṃ ",
  "ja520:36.2": "rājāno maṇḍūka manussaloke ",
  "ja520:36.3": "nettāvatā rājā adhammacārī ",
  "ja520:36.4": "yaṃ tādisaṃ jīvamadeyyu dhaṅkā. ",
  "ja520:37.1": "adhammarūpo vata brahmacārī ",
  "ja520:37.2": "anuppiyaṃ bhāsasi khattiyassa ",
  "ja520:37.3": "vilumpamānāya puthuppajāya ",
  "ja520:37.4": "pūjesi rājaṃ paramappavādiṃ. ",
  "ja520:38.1": "sace idaṃ brahme surajjakaṃ siyā ",
  "ja520:38.2": "phītaṃ raṭṭhaṃ muditaṃ vippasannaṃ ",
  "ja520:38.3": "bhutvā baliṃ aggapiṇḍañca kākā ",
  "ja520:38.4": "na mādisaṃ jīvamadeyyu dhaṅkāti. ",
  "ja520:39.1": "bhaṇḍutiṇḍukajātakaṃ dasamaṃ. ",
  "ja520:40.1": "",
  "ja520:41.1": "tassuddānaṃ ",
  "ja520:42.1": "kiṃchanda kumbha jayaddisa chaddanta ",
  "ja520:42.2": "atha paṇḍitasambhava sīrakapi ",
  "ja520:42.3": "dakarakkhasa paṇḍaranāgavaro ",
  "ja520:42.4": "atha sambula tiṇḍukadevasuto. ",
  "ja520:43.1": "tiṃsatinipātaṃ niṭṭhitaṃ. "
}
