  "ja329:0.3": "",
  "ja329:0.4": "9 kāḷabāhujātakaṃ ",
  "ja329:1.1": "yaṃ annapānassa pure labhāma ",
  "ja329:1.2": "tandāni sākhamigameva gacchati ",
  "ja329:1.3": "gacchāmadāni vanameva rādha ",
  "ja329:1.4": "asakkatāvamha dhanañjayāya. ",
  "ja329:2.1": "lābho alābho yaso ayaso ca ",
  "ja329:2.2": "nindā pasaṃsā ca sukhaṃ ca dukkhaṃ ",
  "ja329:2.3": "ete aniccā manujesu dhammā ",
  "ja329:2.4": "mā soci kiṃ socasi poṭṭhapāda. ",
  "ja329:3.1": "addhā tuvaṃ paṇḍitakosi rādha ",
  "ja329:3.2": "jānāsi atthāni anāgatāni ",
  "ja329:3.3": "kathaṃ nukho sākhamigaṃ dakkhāma ",
  "ja329:3.4": "niddhāpitaṃ rājakulatova jammaṃ. ",
  "ja329:4.1": "cāleti kaṇṇaṃ bhakuṭiṃ karoti ",
  "ja329:4.2": "muhuṃ muhuṃ bhāyate kumāre ",
  "ja329:4.3": "sayameva taṃ kāhati kāḷabāhu ",
  "ja329:4.4": "yenārakā ṭhassati annapānāti. ",
  "ja329:5.1": "kāḷabāhujātakaṃ navamaṃ. "
}
