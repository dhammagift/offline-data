  "ja124:0.4": "4 ambajātakaṃ ",
  "ja124:1.1": "vāyametheva puriso ",
  "ja124:1.2": "na nibbindeyya paṇḍito ",
  "ja124:1.3": "vāyāmassa phalaṃ passa ",
  "ja124:1.4": "bhuttā ambā anītihanti. ",
  "ja124:2.1": "ambajātakaṃ catutthaṃ. "
}
