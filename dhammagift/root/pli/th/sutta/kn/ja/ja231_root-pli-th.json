  "ja231:0.1": "",
  "ja231:0.2": "",
  "ja231:0.3": "9 upāhanavaggo ",
  "ja231:0.4": "1 upāhanajātakaṃ ",
  "ja231:1.1": "yathāpi kītā purisassupāhanā ",
  "ja231:1.2": "sukhassa atthāya dukhaṃ udabbahe ",
  "ja231:1.3": "ghammābhitattā talasāva pīḷitā ",
  "ja231:1.4": "tasseva pāde purisassa khādare. ",
  "ja231:2.1": "evameva yo dukkulino anariyo ",
  "ja231:2.2": "tumhāka vijjañca sutañca ādiya ",
  "ja231:2.3": "tameva so tattha sutena khādati ",
  "ja231:2.4": "anariyo vuccatupāhanūpamoti. ",
  "ja231:3.1": "upāhanajātakaṃ paṭhamaṃ. "
}
