  "ja292:0.3": "",
  "ja292:0.4": "2 supattajātakaṃ ",
  "ja292:1.1": "bārāṇasyaṃ mahārāja ",
  "ja292:1.2": "kākarājā nivāsako ",
  "ja292:1.3": "asītiyā sahassehi ",
  "ja292:1.4": "supatto parivārito. ",
  "ja292:2.1": "tassa dohaḷinī bhariyā ",
  "ja292:2.2": "supassā bhakkhitumicchati ",
  "ja292:2.3": "rañño mahānase pakkaṃ ",
  "ja292:2.4": "paccagghaṃ rājabhojanaṃ. ",
  "ja292:3.1": "tesāhaṃ pahito dūto ",
  "ja292:3.2": "rañño camhi idhāgato ",
  "ja292:3.3": "bhattu apacitiṃ kummi ",
  "ja292:3.4": "nāsāyamakaraṃ vaṇanti. ",
  "ja292:4.1": "supattajātakaṃ dutiyaṃ. "
}
