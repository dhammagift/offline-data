  "ja93:0.4": "3 vissāsabhojanajātakaṃ ",
  "ja93:1.1": "na vissase avissatthe ",
  "ja93:1.2": "vissatthepi na vissase ",
  "ja93:1.3": "vissāsā bhayamanveti ",
  "ja93:1.4": "sīhaṃva migamātukāti. ",
  "ja93:2.1": "vissāsabhojanajātakaṃ tatiyaṃ. "
}
