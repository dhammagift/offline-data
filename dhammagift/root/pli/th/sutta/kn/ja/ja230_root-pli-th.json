  "ja230:0.3": "",
  "ja230:0.4": "10 dutiyapalāyijātakaṃ ",
  "ja230:1.1": "dhajamaparimitaṃ anantapāraṃ ",
  "ja230:1.2": "duppasahaṃ dhaṅkehi sāgaramiva ",
  "ja230:1.3": "girimiva anilena ",
  "ja230:1.4": "duppasaho duppasaho ahamajja tādisena. ",
  "ja230:2.1": "mā bāliyaṃ vippalapi na hissa tādisaṃ ",
  "ja230:2.2": "vidayhase na hi labhase nisedhakaṃ ",
  "ja230:2.3": "āsajjasi gajamiva ekacārinaṃ ",
  "ja230:2.4": "yo taṃ padā naḷamiva pothayissatīti. ",
  "ja230:3.1": "dutiyapalāyijātakaṃ dasamaṃ. ",
  "ja230:3.2": "kāsāvavaggo aṭṭhamo. ",
  "ja230:4.1": "tassuddānaṃ. ",
  "ja230:5.1": "varavattha vaco dumakhīṇaphalaṃ ",
  "ja230:5.2": "caturodhammavaraṃ purisuttama ",
  "ja230:5.3": "dhaṅka magadhā ca tayogiri nāma ",
  "ja230:5.4": "gajaggavaro dhajavarena dasa. "
}
