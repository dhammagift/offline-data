  "ja87:0.4": "7 maṅgalajātakaṃ ",
  "ja87:1.1": "yassa maṅgalā samūhatā ",
  "ja87:1.2": "uppātā supinā ca lakkhaṇā ca ",
  "ja87:1.3": "so maṅgaladosavītivatto ",
  "ja87:1.4": "yugayogādhigato na jātumetīti. ",
  "ja87:2.1": "maṅgalajātakaṃ sattamaṃ. "
}
