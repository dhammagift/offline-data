  "ja356:0.1": "",
  "ja356:0.2": "",
  "ja356:0.3": "",
  "ja356:0.4": "6 kārandiyajātakaṃ ",
  "ja356:1.1": "eko araññe girikandarāyaṃ ",
  "ja356:1.2": "paggayha mahantaselaṃ pavejjhasi ",
  "ja356:1.3": "punappunaṃ santaramānarūpo ",
  "ja356:1.4": "kārandiya konu tavayidhattho. ",
  "ja356:2.1": "ahañhimaṃ sāgarasevitantaṃ ",
  "ja356:2.2": "samaṃ karissāmi yathāpi pāṇiṃ ",
  "ja356:2.3": "vikīriya sānūni ca pabbatāni ",
  "ja356:2.4": "tasmā selaṃ kandarāyaṃ pakkhipāmi. ",
  "ja356:3.1": "nayimaṃ mahiṃ arahati pāṇikappaṃ ",
  "ja356:3.2": "samaṃ manusso karaṇāyameko maññāmi ",
  "ja356:3.3": "maññeva dariṃ jigiṃsaṃ ",
  "ja356:3.4": "kārandiya hāyasi jīvalokaṃ. ",
  "ja356:4.1": "sace ayaṃ bhūtadharaṃ na sakko ",
  "ja356:4.2": "samaṃ manusso karaṇāyameko ",
  "ja356:4.3": "evameva tvaṃ brahme ime manusse ",
  "ja356:4.4": "nānādiṭṭhike nānayissasi te. ",
  "ja356:5.1": "saṅkhittarūpena bhavaṃ mamatthaṃ ",
  "ja356:5.2": "akkhāsi kārandiya evametaṃ ",
  "ja356:5.3": "yathā na sakkā paṭhavī samāyaṃ ",
  "ja356:5.4": "kātuṃ manussena tathā manussāti. ",
  "ja356:6.1": "kārandiyajātakaṃ chaṭṭhaṃ. "
}
