  "ja300:0.1": "",
  "ja300:0.2": "",
  "ja300:0.3": "",
  "ja300:0.4": "10 bakajātakaṃ ",
  "ja300:1.1": "parapāṇaghāte jīvanto ",
  "ja300:1.2": "maṃsalohitabhojano ",
  "ja300:1.3": "bako vataṃ samādāya ",
  "ja300:1.4": "upapajji uposathaṃ. ",
  "ja300:2.1": "tassa sakko vataññāya ",
  "ja300:2.2": "ajarūpenupāgami ",
  "ja300:2.3": "vītatapo ajjhapatto ",
  "ja300:2.4": "bhañji lohitapo tapaṃ. ",
  "ja300:3.1": "evameva idhekacco ",
  "ja300:3.2": "samādānasmi dubbalo ",
  "ja300:3.3": "lahuṃ karoti attānaṃ ",
  "ja300:3.4": "bakova ajakāraṇāti. ",
  "ja300:4.1": "bakajātakaṃ dasamaṃ. ",
  "ja300:4.2": "kumbhavaggo pañcamo. ",
  "ja300:5.1": "tassuddānaṃ. ",
  "ja300:6.1": "varakumbha supattasirivhayano ",
  "ja300:6.2": "sucisammata bindussaro cusabho ",
  "ja300:6.3": "saritaṃpati caṇḍī jarākapinā ",
  "ja300:6.4": "atha makkaṭiyā vakakena dasāti. ",
  "ja300:7.1": "vagguddānaṃ. ",
  "ja300:8.1": "saṅkappo padumo ceva ",
  "ja300:8.2": "udapānena tatiyaṃ ",
  "ja300:8.3": "abbhantaraṃ ghaṭabhedaṃ ",
  "ja300:8.4": "tikanipātamhilaṅkataṃ. ",
  "ja300:9.1": "tikanipātaṃ niṭṭhitaṃ. "
}
