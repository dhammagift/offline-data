  "ja36:0.4": "6 sakuṇajātakaṃ ",
  "ja36:1.1": "yannissitā jagatiruhaṃ (vihaṅgamā) ",
  "ja36:1.2": "svāyaṃ aggiṃ pamuñcati ",
  "ja36:1.3": "disā bhajatha vaṅkaṅgā ",
  "ja36:1.4": "jātaṃ saraṇato bhayanti. ",
  "ja36:2.1": "sakuṇajātakaṃ chaṭṭhaṃ. "
}
