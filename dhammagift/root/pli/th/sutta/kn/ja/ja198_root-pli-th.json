  "ja198:0.3": "",
  "ja198:0.4": "8 rādhajātakaṃ ",
  "ja198:1.1": "pavāsā āgato tāta ",
  "ja198:1.2": "idāni na cirāgato ",
  "ja198:1.3": "kacci nu tāta te mātā ",
  "ja198:1.4": "na aññamupasevati. ",
  "ja198:2.1": "na kho panetaṃ subhaṇaṃ ",
  "ja198:2.2": "giraṃ saccūpasañhitaṃ ",
  "ja198:2.3": "sayetha poṭṭhapādova ",
  "ja198:2.4": "mummare upakūsitoti. ",
  "ja198:3.1": "rādhajātakaṃ aṭṭhamaṃ. "
}
