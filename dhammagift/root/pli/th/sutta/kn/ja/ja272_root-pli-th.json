  "ja272:0.3": "",
  "ja272:0.4": "2 byagghajātakaṃ ",
  "ja272:1.1": "yena mittena saṃsaggā ",
  "ja272:1.2": "yogakkhemo vihīyati ",
  "ja272:1.3": "pubbevajjhābhavantassa rakkhe ",
  "ja272:1.4": "akkhiṃva paṇḍito. ",
  "ja272:2.1": "yena mittena saṃsaggā ",
  "ja272:2.2": "yogakkhemo pavaḍḍhati ",
  "ja272:2.3": "kareyyattasamaṃ vuttiṃ ",
  "ja272:2.4": "sabbakiccesu paṇḍito. ",
  "ja272:3.1": "etha byagghā nivattavho ",
  "ja272:3.2": "paccupetha mahāvanaṃ ",
  "ja272:3.3": "mā no vanaṃ chindi nibyagghaṃ ",
  "ja272:3.4": "byagghā māhesu nibbanāti. ",
  "ja272:4.1": "byagghajātakaṃ dutiyaṃ. "
}
