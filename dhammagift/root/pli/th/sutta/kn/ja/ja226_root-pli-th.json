  "ja226:0.3": "",
  "ja226:0.4": "6 kosiyajātakaṃ ",
  "ja226:1.1": "kāle nikkhamanā sādhu ",
  "ja226:1.2": "nākāle sādhu nikkhamo ",
  "ja226:1.3": "akālena hi nikkhamma ",
  "ja226:1.4": "ekakampi bahujjano ",
  "ja226:1.5": "na kiñci atthaṃ jāteti ",
  "ja226:1.6": "dhaṅkasenāva kosiyaṃ. ",
  "ja226:2.1": "dhīro vidhividhānaññū ",
  "ja226:2.2": "paresaṃ vivarānugū ",
  "ja226:2.3": "sabbāmitte vasīkatvā ",
  "ja226:2.4": "kosiyova sukhī siyāti. ",
  "ja226:3.1": "kosiyajātakaṃ chaṭṭhaṃ. "
}
