  "ja177:0.4": "7 tindukajātakaṃ ",
  "ja177:1.1": "dhanuhatthakalāpehi ",
  "ja177:1.2": "nettiṃsavaradhāribhi ",
  "ja177:1.3": "samantā parikiṇṇamhā ",
  "ja177:1.4": "kathaṃ mokkho bhavissati. ",
  "ja177:2.1": "appeva bahukiccānaṃ ",
  "ja177:2.2": "attho jāyetha koci naṃ ",
  "ja177:2.3": "atthi rukkhassa acchinnaṃ ",
  "ja177:2.4": "khajja taññeva tindukanti. ",
  "ja177:3.1": "tindukajātakaṃ sattamaṃ. "
}
