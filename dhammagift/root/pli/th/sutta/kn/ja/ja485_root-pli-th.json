  "ja485:0.4": "2 candakinnarajātakaṃ ",
  "ja485:1.1": "upanīyatidaṃ maññe ",
  "ja485:1.2": "cande lohitamaddane ",
  "ja485:1.3": "ajjāpi vijahāmi jīvitaṃ ",
  "ja485:1.4": "pāṇā me cande nirujjhanti. ",
  "ja485:2.1": "osadhi me dukkhaṃ hadayaṃ ",
  "ja485:2.2": "me ḍayhate nitammāmi ",
  "ja485:2.3": "tava candiyā socantiyā ",
  "ja485:2.4": "na naṃ aññehi sokehi. ",
  "ja485:3.1": "tiṇamiva vanamiva milāyāmi ",
  "ja485:3.2": "nadī aparipuṇṇāva sussāmi ",
  "ja485:3.3": "tava candiyā socantiyā ",
  "ja485:3.4": "na naṃ aññehi sokehi. ",
  "ja485:4.1": "vassamiva sare pāde ",
  "ja485:4.2": "imāni assūni vattare mayhaṃ ",
  "ja485:4.3": "tava candiyā socantiyā ",
  "ja485:4.4": "na naṃ aññehi sokehi. ",
  "ja485:5.1": "pāpo kho rājaputto ",
  "ja485:5.2": "yo me icchitapatiṃ varākiyā ",
  "ja485:5.3": "vijjhi vanamūlasmiṃ ",
  "ja485:5.4": "soyaṃ viddho chamā seti. ",
  "ja485:6.1": "imaṃ mayhaṃ hadayasokaṃ ",
  "ja485:6.2": "paṭimuñcatu rājaputta tava mātā ",
  "ja485:6.3": "yo mayhaṃ hadayasoko ",
  "ja485:6.4": "kiṃpurisaṃ avekkhamānāya. ",
  "ja485:7.1": "imaṃ mayhaṃ hadayasokaṃ ",
  "ja485:7.2": "paṭimuñcatu rājaputta tava jāyā ",
  "ja485:7.3": "yo mayhaṃ hadayasoko ",
  "ja485:7.4": "kiṃpurisaṃ avekkhamānāya. ",
  "ja485:8.1": "mā ca puttaṃ mā ca patiṃ ",
  "ja485:8.2": "addakkhi rājaputta tava mātā ",
  "ja485:8.3": "yo kiṃpurisaṃ avadhi ",
  "ja485:8.4": "adūsakaṃ mayhaṃ kāmāhi. ",
  "ja485:9.1": "mā ca puttaṃ mā ca patiṃ ",
  "ja485:9.2": "addakkhi rājaputta tava jāyā ",
  "ja485:9.3": "yo kiṃpurisaṃ avadhi ",
  "ja485:9.4": "adūsakaṃ mayhaṃ kāmāhi. ",
  "ja485:10.1": "mā tvaṃ cande rodi ",
  "ja485:10.2": "mā soci vanatimiramattakkhi ",
  "ja485:10.3": "mama tvaṃ hehisi bhariyā ",
  "ja485:10.4": "rājakule pūjitā nārībhi. ",
  "ja485:11.1": "api nūnāhaṃ marissaṃ ",
  "ja485:11.2": "nāhaṃ rājaputta tava hessaṃ ",
  "ja485:11.3": "yo kiṃpurisaṃ avadhi ",
  "ja485:11.4": "adūsakaṃ mayhaṃ kāmāhi. ",
  "ja485:12.1": "api bhīruke api jīvitukāmike ",
  "ja485:12.2": "kiṃpurisī gaccha himavantaṃ ",
  "ja485:12.3": "tālisataggarabhojanā ",
  "ja485:12.4": "aññe taṃ migā ramissanti. ",
  "ja485:13.1": "te pabbatā tā ca kandarā ",
  "ja485:13.2": "tā ca giriguhāyo tattha ",
  "ja485:13.3": "taṃ apassantī ",
  "ja485:13.4": "kiṃpurisa kathaṃ ahaṃ kāsaṃ. yesu pabbatesu mayaṃ ekato abhiramimhā tattha taṃ apassantī kiṃpurisa kathaṃ ahaṃ kāsaṃ. ",
  "ja485:14.1": "te paṇṇasanthatā ramaṇīyā ",
  "ja485:14.2": "vāḷamigehi anuciṇṇā ",
  "ja485:14.3": "tattha taṃ apassantī ",
  "ja485:14.4": "kiṃpurisa kathaṃ ahaṃ kāsaṃ. ",
  "ja485:15.1": "te pupphasanthatā ramaṇīyā ",
  "ja485:15.2": "vāḷamigehi anuciṇṇā ",
  "ja485:15.3": "tattha taṃ apassantī ",
  "ja485:15.4": "kiṃpurisa kathaṃ ahaṃ kāsaṃ. ",
  "ja485:16.1": "acchā savantī girivananadiyo ",
  "ja485:16.2": "kusumābhikiṇṇasotāyo ",
  "ja485:16.3": "tattha taṃ apassantī ",
  "ja485:16.4": "kiṃpurisa kathaṃ ahaṃ kāsaṃ. ",
  "ja485:17.1": "nīlāni himavato pabbatassa ",
  "ja485:17.2": "kūṭāni dassanīyāni ",
  "ja485:17.3": "tattha taṃ apassantī ",
  "ja485:17.4": "kiṃpurisa kathaṃ ahaṃ kāsaṃ. ",
  "ja485:18.1": "pītāni himavato pabbatassa ",
  "ja485:18.2": "kūṭāni dassanīyāni ",
  "ja485:18.3": "tattha taṃ apassantī ",
  "ja485:18.4": "kiṃpurisa kathaṃ ahaṃ kāsaṃ. ",
  "ja485:19.1": "tambāni himavato pabbatassa ",
  "ja485:19.2": "kūṭāni dassanīyāni ",
  "ja485:19.3": "tattha taṃ apassantī ",
  "ja485:19.4": "kiṃpurisa kathaṃ ahaṃ kāsaṃ. ",
  "ja485:20.1": "tuṅgāni himavato pabbatassa ",
  "ja485:20.2": "kūṭāni dassanīyāni ",
  "ja485:20.3": "tattha taṃ apassantī ",
  "ja485:20.4": "kiṃpurisa kathaṃ ahaṃ kāsaṃ. ",
  "ja485:21.1": "setāni himavato pabbatassa ",
  "ja485:21.2": "kūṭāni dassanīyāni ",
  "ja485:21.3": "tattha taṃ apassantī ",
  "ja485:21.4": "kiṃpurisa kathaṃ ahaṃ kāsaṃ. ",
  "ja485:22.1": "citrāni himavato pabbatassa ",
  "ja485:22.2": "kūṭāni dassanīyāni ",
  "ja485:22.3": "tattha taṃ apassantī ",
  "ja485:22.4": "kiṃpurisa kathaṃ ahaṃ kāsaṃ. ",
  "ja485:23.1": "yakkhagaṇasevite gandhamādane ",
  "ja485:23.2": "osadhehi sañchanne ",
  "ja485:23.3": "tattha taṃ apassantī ",
  "ja485:23.4": "kiṃpurisa kathaṃ ahaṃ kāsaṃ. ",
  "ja485:24.1": "kiṃpurisasevite gandhamādane ",
  "ja485:24.2": "osadhehi sañchanne ",
  "ja485:24.3": "tattha taṃ apassantī ",
  "ja485:24.4": "kiṃpurisa kathaṃ ahaṃ kāsaṃ. ",
  "ja485:25.1": "vande te (pāde) ayirabrahme ",
  "ja485:25.2": "yo me icchitaṃ patiṃ varākiyā ",
  "ja485:25.3": "amatena abhisiñci ",
  "ja485:25.4": "samāgatasmiṃ piyatamena. ",
  "ja485:26.1": "vicarāmadāni girivananadiyo ",
  "ja485:26.2": "kusumābhikiṇṇasotāyo ",
  "ja485:26.3": "nānādumavasanāyo ",
  "ja485:26.4": "piyaṃvadā aññamaññassāti. ",
  "ja485:27.1": "candakinnarajātakaṃ dutiyaṃ "
}
