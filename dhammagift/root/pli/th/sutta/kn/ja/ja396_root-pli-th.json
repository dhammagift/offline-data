{
  "ja396:0.1": "sattakanipātajātakaṃ 1 kukkuvaggo ",
  "ja396:0.2": "",
  "ja396:0.3": "",
  "ja396:0.4": "1 kukkujātakaṃ ",
  "ja396:1.1": "diyaḍḍhakukkū udayena kaṇṇikā ",
  "ja396:1.2": "vidatthiyo aṭṭha parikkhipanti naṃ ",
  "ja396:1.3": "sā sīsapā sāramayā apheggukā ",
  "ja396:1.4": "kuhiṃ ṭhitā uparito na dhaṃsati. ",
  "ja396:2.1": "yā tiṃsati sāramayā apheggukā ",
  "ja396:2.2": "parikiriya gopāṇasiyo samaṭṭhitā ",
  "ja396:2.3": "tāhi susaṅgahitā balasā ca pīḷitā ",
  "ja396:2.4": "samaṭṭhitā uparito na dhaṃsati. ",
  "ja396:3.1": "evampi mittehi daḷhehi paṇḍito ",
  "ja396:3.2": "abhejjarūpehi sucīhi mantibhi ",
  "ja396:3.3": "susaṅgahīto siriyā na dhaṃsati ",
  "ja396:3.4": "gopānasībhāravahāva kaṇṇikā. ",
  "ja396:4.1": "kharattacaṃ bellaṃ yathāpi satthavā ",
  "ja396:4.2": "anāmasantopi karoti tittakaṃ ",
  "ja396:4.3": "samāharaṃ sādhukaroti patthavā ",
  "ja396:4.4": "asādhukayirā tanubandhamuddharaṃ. ",
  "ja396:5.1": "evampi gāmanigamesu paṇḍito ",
  "ja396:5.2": "asāhasaṃ rāja dhanāni saṅgharaṃ ",
  "ja396:5.3": "dhammānuvattī paṭipajjamāno ",
  "ja396:5.4": "phātiṃ kayirā aviheṭhayaṃ paraṃ ",
  "ja396:6.1": "odātamūlaṃ sucivārisambhavaṃ ",
  "ja396:6.2": "jātaṃ yathā pokkharaṇīsu ambujaṃ ",
  "ja396:6.3": "padumaṃ yathā agginibhāsiphālimaṃ ",
  "ja396:6.4": "na kaddamo na rajo na vāri limpati. ",
  "ja396:7.1": "evampi vohārasuciṃ asāhasaṃ ",
  "ja396:7.2": "visuddhakammanta mapetapāpakaṃ ",
  "ja396:7.3": "na limpati kammakilesa tādiso ",
  "ja396:7.4": "jātaṃ yathā pokkharaṇīsu ambujanti. ",
  "ja396:8.1": "kukkujātakaṃ paṭhamaṃ. "
}
