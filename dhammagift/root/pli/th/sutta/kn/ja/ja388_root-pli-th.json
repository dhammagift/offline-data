  "ja388:0.1": "",
  "ja388:0.2": "",
  "ja388:0.3": "",
  "ja388:0.4": "3 tuṇḍilajātakaṃ ",
  "ja388:1.1": "navacchaddake dāni diyyati ",
  "ja388:1.2": "puṇṇāyaṃ doṇi suvāminī ṭhitā ",
  "ja388:1.3": "bahuko jano pāsapāṇiko ",
  "ja388:1.4": "no ca kho me paṭibhāti bhuñjituṃ. ",
  "ja388:2.1": "tasasi bhamasi leṇamicchasi ",
  "ja388:2.2": "atāṇosi kuhiṃ gamissasi ",
  "ja388:2.3": "appossuko bhuñja tuṇḍila ",
  "ja388:2.4": "maṃsatthāya posiyāmase. ",
  "ja388:3.1": "ogaha rahadaṃ akaddamaṃ ",
  "ja388:3.2": "sabbaṃ sedamalaṃ pavāhaya ",
  "ja388:3.3": "gaṇhāhi navaṃ vilepanaṃ ",
  "ja388:3.4": "yassa gandho na kadāci chijjati. ",
  "ja388:4.1": "katamo nu rahado akaddamo ",
  "ja388:4.2": "kiṃsu sedamalanti vuccati ",
  "ja388:4.3": "katamañca navaṃ vilepanaṃ ",
  "ja388:4.4": "kassa gandho na kadāci chijjati. ",
  "ja388:5.1": "dhammo rahado akaddamo ",
  "ja388:5.2": "pāpaṃ sedamalanti vuccati ",
  "ja388:5.3": "sīlañca navaṃ vilepanaṃ ",
  "ja388:5.4": "tassa gandho na kadāci chijjati. ",
  "ja388:6.1": "nandanti sarīraghātino ",
  "ja388:6.2": "na ca nandanti sarīradhārino ",
  "ja388:6.3": "puṇṇāya puṇṇamāsiyā ",
  "ja388:6.4": "ramamānāva jahanti jīvitanti. ",
  "ja388:7.1": "tuṇḍilajātakaṃ tatiyaṃ. "
}
