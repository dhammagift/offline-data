  "ja182:0.1": "",
  "ja182:0.2": "",
  "ja182:0.3": "",
  "ja182:0.4": "2 saṅgāmāvacarajātakaṃ ",
  "ja182:1.1": "saṅgāmāvacaro sūro ",
  "ja182:1.2": "balavā iti vissuto ",
  "ja182:1.3": "kinnu toraṇamāsajja ",
  "ja182:1.4": "paṭikkamasi kuñjara. ",
  "ja182:2.1": "omadda khippaṃ palīghaṃ ",
  "ja182:2.2": "esikāni ca ubbaha ",
  "ja182:2.3": "toraṇāni ca madditvā ",
  "ja182:2.4": "khippaṃ pavisa kuñjarāti. ",
  "ja182:3.1": "saṅgāmāvacarajātakaṃ dutiyaṃ. "
}
