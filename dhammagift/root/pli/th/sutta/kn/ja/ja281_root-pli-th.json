{
  "ja281:0.1": "4 abbhantaravaggo ",
  "ja281:0.2": "",
  "ja281:0.3": "",
  "ja281:0.4": "1 abbhantarajātakaṃ ",
  "ja281:1.1": "abbhantaro nāma dumo ",
  "ja281:1.2": "yassa dibyamidaṃ phalaṃ ",
  "ja281:1.3": "bhutvā dohaḷinī nārī ",
  "ja281:1.4": "cakkavattiṃ vijāyati. ",
  "ja281:2.1": "tvampi bhadde mahesīsi ",
  "ja281:2.2": "sā cāpi patino piyā ",
  "ja281:2.3": "āharissati te rājā ",
  "ja281:2.4": "idaṃ abbhantaraṃ phalaṃ. ",
  "ja281:3.1": "bhatturatthe parakkanto ",
  "ja281:3.2": "yaṃ ṭhānamadhigacchati ",
  "ja281:3.3": "sūro attapariccāgī ",
  "ja281:3.4": "labhamāno bhavāmahanti. ",
  "ja281:4.1": "abbhantarajātakaṃ paṭhamaṃ. "
}
