  "ja340:0.3": "",
  "ja340:0.4": "10 visayhajātakaṃ ",
  "ja340:1.1": "adāsi dānāni pure visayha ",
  "ja340:1.2": "dadato ca te khayadhammo ahosi ",
  "ja340:1.3": "ito parañce na dadeyya dānaṃ ",
  "ja340:1.4": "tiṭṭheyyuṃ te saṃyamantassa bhogā. ",
  "ja340:2.1": "anariyamariyena sahassanetta ",
  "ja340:2.2": "suduggatenāpi akiccamāhu ",
  "ja340:2.3": "mā vo dhanaṃ taṃ ahu vā janinda ",
  "ja340:2.4": "yaṃ bhogahetu vijahemu saddhaṃ. ",
  "ja340:3.1": "yena eko ratho yāti ",
  "ja340:3.2": "yāti tena paro ratho ",
  "ja340:3.3": "porāṇaṃ nihitaṃ vattaṃ ",
  "ja340:3.4": "vattataññeva vāsava. ",
  "ja340:4.1": "yadi hessati dassāma ",
  "ja340:4.2": "asante kiṃ dadāmhase ",
  "ja340:4.3": "evaṃ bhūtāpi dassāma ",
  "ja340:4.4": "mā dānaṃ pamadāmhaseti. ",
  "ja340:5.1": "visayhajātakaṃ dasamaṃ. ",
  "ja340:5.2": "kokilavaggo catuttho. ",
  "ja340:6.1": "tassuddānaṃ. ",
  "ja340:7.1": "ativelaṃ pabhāsati jinavaro ",
  "ja340:7.2": "vanamajjhe rathesabha jimhagamo ",
  "ja340:7.3": "atha jambu tiṇāsanapīṭhavaraṃ ",
  "ja340:7.4": "atha taṇḍulaṃ mora visayha dasa. "
}
