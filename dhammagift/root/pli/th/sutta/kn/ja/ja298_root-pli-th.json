  "ja298:0.3": "",
  "ja298:0.4": "8 udumbarajātakaṃ ",
  "ja298:1.1": "udumbarā cime pakkā ",
  "ja298:1.2": "nigrodhā ca kapitthanā ",
  "ja298:1.3": "ehi nikkhamma bhuñjassu ",
  "ja298:1.4": "kiṃ jighacchāya miyyasi. ",
  "ja298:2.1": "evaṃ so suhito hoti ",
  "ja298:2.2": "yo vuḍḍhamapacāyati ",
  "ja298:2.3": "yathāhamajja suhito ",
  "ja298:2.4": "dumapakkāni māsito. ",
  "ja298:3.1": "yaṃ vanejo vanejassa ",
  "ja298:3.2": "vañceyya kapino kapi ",
  "ja298:3.3": "daharopi na saddheyya ",
  "ja298:3.4": "nahi jiṇṇo jarākapīti. ",
  "ja298:4.1": "udumbarajātakaṃ aṭṭhamaṃ. "
}
