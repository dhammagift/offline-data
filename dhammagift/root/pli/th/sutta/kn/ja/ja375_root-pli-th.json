  "ja375:0.1": "",
  "ja375:0.2": "",
  "ja375:0.3": "",
  "ja375:0.4": "5 kapotakajātakaṃ ",
  "ja375:1.1": "idāni khomhi sukhito arogo ",
  "ja375:1.2": "nikkaṇṭako nippatito kapoto ",
  "ja375:1.3": "kāhāmidāni hadayassa tuṭṭhiṃ ",
  "ja375:1.4": "tathāhi maṃ maṃsasākaṃ baleti. ",
  "ja375:2.1": "kāyaṃ balākā sikhinī ",
  "ja375:2.2": "corī laṅghīpitāmahā ",
  "ja375:2.3": "oraṃ balāke āgaccha ",
  "ja375:2.4": "caṇḍo me vāyaso sakhā. ",
  "ja375:3.1": "alañhi te jagghitāye ",
  "ja375:3.2": "mamaṃ disvāna edisaṃ ",
  "ja375:3.3": "vilūnaṃ sūdaputtena ",
  "ja375:3.4": "piṭṭhamaṭṭhena makkhitaṃ. ",
  "ja375:4.1": "sunhāto suvilittosi ",
  "ja375:4.2": "annapānena tappito ",
  "ja375:4.3": "kaṇṭhe ca te veḷuriyo ",
  "ja375:4.4": "agamāsi kajaṅgalaṃ. ",
  "ja375:5.1": "mā te mitto amitto vā ",
  "ja375:5.2": "agamāsi kajaṅgalaṃ ",
  "ja375:5.3": "piñjāni tattha lāyitvā ",
  "ja375:5.4": "kaṇṭhe bandhanti vaṭṭanaṃ. ",
  "ja375:6.1": "puna pāpajjasī samma ",
  "ja375:6.2": "sīlaṃ hi tava tādisaṃ ",
  "ja375:6.3": "na hi mānusakā bhogā ",
  "ja375:6.4": "subhuñjā honti pakkhinoti. ",
  "ja375:7.1": "kapotakajātakaṃ niṭṭhitaṃ. ",
  "ja375:7.2": "aḍḍhavaggo tatiyo. ",
  "ja375:8.1": "tassuddānaṃ. ",
  "ja375:9.1": "atha vaṇṇa sasīla hiri labhate ",
  "ja375:9.2": "sumukhāsi sasāliya mittavaro ",
  "ja375:9.3": "atha cakka palāsa sarāja sato ",
  "ja375:9.4": "yava bāla kapotaka paṇṇarasa. ",
  "ja375:10.1": "tatra vagguddānaṃ bhavati. ",
  "ja375:11.1": "jinañca vaṇṇaṃ asamaṃ vaguppari ",
  "ja375:11.2": "sudesitā jātakanti santi vīsati ",
  "ja375:11.3": "mahesino brahmacarittamutta ",
  "ja375:11.4": "mavoca gāthā atthavatī subyañjanā. ",
  "ja375:12.1": "pañcakanipātaṃ niṭṭhitaṃ. "
}
