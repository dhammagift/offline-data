  "ja219:0.1": "",
  "ja219:0.2": "",
  "ja219:0.3": "",
  "ja219:0.4": "9 garahitajātakaṃ ",
  "ja219:1.1": "hiraññaṃ me suvaṇṇaṃ me ",
  "ja219:1.2": "esā rattindivā kathā ",
  "ja219:1.3": "dummedhānaṃ manussānaṃ ",
  "ja219:1.4": "ariyadhammaṃ apassataṃ ",
  "ja219:2.1": "dve dve gahapatayo gehe ",
  "ja219:2.2": "eko tattha amassuko ",
  "ja219:2.3": "lambatthano veṇikato ",
  "ja219:2.4": "atho aṅkitakaṇṇako ",
  "ja219:2.5": "kīto dhanena bahunā ",
  "ja219:2.6": "so taṃ vitudate jananti. ",
  "ja219:3.1": "garahitajātakaṃ navamaṃ. "
}
