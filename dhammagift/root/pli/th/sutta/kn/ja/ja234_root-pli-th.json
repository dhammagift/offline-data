  "ja234:0.3": "",
  "ja234:0.4": "4 asitābhujātakaṃ ",
  "ja234:1.1": "tvamevadānimakari ",
  "ja234:1.2": "yaṃ kāmo byagamā tayi ",
  "ja234:1.3": "soyaṃ appaṭisandhiko ",
  "ja234:1.4": "kharā chinnaṃva renukaṃ. ",
  "ja234:2.1": "atricchā atilobhena ",
  "ja234:2.2": "atilobhamadena ca ",
  "ja234:2.3": "evaṃ hāyati atthamhā ",
  "ja234:2.4": "ahaṃva asitābhuyāti. ",
  "ja234:3.1": "asitābhujātakaṃ catutthaṃ. "
}
