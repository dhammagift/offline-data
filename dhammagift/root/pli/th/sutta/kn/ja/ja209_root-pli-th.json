  "ja209:0.3": "",
  "ja209:0.4": "9 kakkarajātakaṃ ",
  "ja209:1.1": "diṭṭhā mayā vane rukkhā ",
  "ja209:1.2": "assakaṇṇā vibhedakā ",
  "ja209:1.3": "na tāni evaṃ sakkanti ",
  "ja209:1.4": "yathā tvaṃ rukkhaṃ sakkasi. ",
  "ja209:2.1": "purāṇakakkaro ayaṃ ",
  "ja209:2.2": "bhetvā pañjaramāgato ",
  "ja209:2.3": "kusalo vālapāsānaṃ ",
  "ja209:2.4": "apakkamati bhāsatīti. ",
  "ja209:3.1": "kakkarajātakaṃ navamaṃ. "
}
