  "ja49:0.4": "9 nakkhattajātakaṃ ",
  "ja49:1.1": "nakkhattaṃ paṭimānentaṃ ",
  "ja49:1.2": "attho bālaṃ upaccagā ",
  "ja49:1.3": "attho atthassa nakkhattaṃ ",
  "ja49:1.4": "kiṃ karissanti tārakāti. ",
  "ja49:2.1": "nakkhattajātakaṃ navamaṃ. "
}
