  "ja135:0.4": "5 candābhajātakaṃ ",
  "ja135:1.1": "candābhaṃ suriyābhañca ",
  "ja135:1.2": "yodha paññāya gādhati ",
  "ja135:1.3": "avitakkena jhānena ",
  "ja135:1.4": "hoti ābhassarūpagoti. ",
  "ja135:2.1": "candābhajātakaṃ pañcamaṃ. "
}
