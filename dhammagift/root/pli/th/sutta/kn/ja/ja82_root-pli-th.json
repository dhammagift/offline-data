  "ja82:0.4": "2 mittavindajātakaṃ ",
  "ja82:1.1": "atikkamma ramaṇakaṃ ",
  "ja82:1.2": "sadāmattañca dūbhakaṃ ",
  "ja82:1.3": "svāsi pāsāṇamāsīno ",
  "ja82:1.4": "yasmā jīvaṃ na mokkhasīti. ",
  "ja82:2.1": "mittavindajātakaṃ dutiyaṃ. "
}
