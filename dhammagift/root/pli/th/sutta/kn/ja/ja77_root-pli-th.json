  "ja77:0.3": "",
  "ja77:0.4": "7 mahāsupinajātakaṃ ",
  "ja77:1.1": "usabhā rukkhā gāviyo gavā ca ",
  "ja77:1.2": "asso kaṃso sigālī ca kumbho ",
  "ja77:1.3": "pokkharaṇī ca apākacandanaṃ ",
  "ja77:1.4": "lāvūni sīdanti silā plavanti ",
  "ja77:2.1": "maṇḍūkiyo kaṇhasappe gilanti ",
  "ja77:2.2": "kākaṃ suvaṇṇā parivārayanti ",
  "ja77:2.3": "tasā vakā eḷakānaṃ bhayā hi ",
  "ja77:2.4": "vipariyāyo vattati nayidhamatthīti. ",
  "ja77:3.1": "mahāsupinajātakaṃ sattamaṃ. "
}
