  "ja229:0.3": "",
  "ja229:0.4": "9 palāyijātakaṃ ",
  "ja229:1.1": "gajaggameghebhi hayaggamālibhi ",
  "ja229:1.2": "rathūmijātebhi sarābhivassabhi dhanuggahā ",
  "ja229:1.3": "vaṭṭadaḷhappahāribhi ",
  "ja229:1.4": "parivāritā takkasilā samantato. ",
  "ja229:2.1": "abhidhāvathā cuppatathā ca ",
  "ja229:2.2": "vividhavinaditā va dantibhi ",
  "ja229:2.3": "vattatajja tumulo ghoso yathā ",
  "ja229:2.4": "vijjutā jaladharassa gajjatoti. ",
  "ja229:3.1": "palāyijātakaṃ navamaṃ. "
}
