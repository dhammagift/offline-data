  "ja215:0.4": "5 kacchapajātakaṃ ",
  "ja215:1.1": "avadhi vata attānaṃ ",
  "ja215:1.2": "kacchapova pabyāharaṃ ",
  "ja215:1.3": "suggahitasmiṃ kaṭṭhasmiṃ ",
  "ja215:1.4": "vācāya sakiyā vadhi. ",
  "ja215:2.1": "etampi disvā naravīraseṭṭha ",
  "ja215:2.2": "vācaṃ pamuñce kusalaṃ nātivelaṃ ",
  "ja215:2.3": "passasi bahubhāṇena ",
  "ja215:2.4": "kacchapaṃ byasanaṃ gatanti. ",
  "ja215:3.1": "kacchapajātakaṃ pañcamaṃ. "
}
