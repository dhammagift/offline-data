  "ja325:0.1": "",
  "ja325:0.2": "",
  "ja325:0.3": "",
  "ja325:0.4": "5 godhajātakaṃ ",
  "ja325:1.1": "samaṇantaṃ maññamāno ",
  "ja325:1.2": "upagañchiṃ asaññataṃ ",
  "ja325:1.3": "so maṃ daṇḍena pāhāsi ",
  "ja325:1.4": "yathā assamaṇo tathā. ",
  "ja325:2.1": "kinte jaṭāhi dummedha ",
  "ja325:2.2": "kinte ajinasāṭiyā ",
  "ja325:2.3": "abbhantarante gahanaṃ ",
  "ja325:2.4": "bāhiraṃ parimajjasi. ",
  "ja325:3.1": "ehi godha nivattassu ",
  "ja325:3.2": "bhuñja sālīnamodanaṃ ",
  "ja325:3.3": "telaṃ loṇañca me atthi ",
  "ja325:3.4": "pahutaṃ mayhaṃ pipphali. ",
  "ja325:4.1": "esa bhiyyo pavekkhāmi ",
  "ja325:4.2": "vammikaṃ sataporisaṃ ",
  "ja325:4.3": "telaṃ loṇañca kintesi ",
  "ja325:4.4": "ahitaṃ mayhaṃ pipphalīti. ",
  "ja325:5.1": "godhajātakaṃ pañcamaṃ. "
}
