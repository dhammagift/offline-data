  "ja187:0.3": "",
  "ja187:0.4": "7 catumaṭṭhajātakaṃ ",
  "ja187:1.1": "ucce viṭapimāruyha ",
  "ja187:1.2": "mantayavho rahogatā ",
  "ja187:1.3": "nīce oruyha mantavho ",
  "ja187:1.4": "migarājāpi sossati. ",
  "ja187:2.1": "yaṃ supaṇṇo supaṇṇena ",
  "ja187:2.2": "devo devena mantaye ",
  "ja187:2.3": "kiṃ tattha catumaṭṭhassa ",
  "ja187:2.4": "vilaṃ pavisa jambukāti. ",
  "ja187:3.1": "catumaṭṭhajātakaṃ sattamaṃ. "
}
