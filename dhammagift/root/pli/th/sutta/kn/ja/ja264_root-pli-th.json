  "ja264:0.3": "",
  "ja264:0.4": "4 mahāpanādajātakaṃ ",
  "ja264:1.1": "panādo nāma so rājā ",
  "ja264:1.2": "yassa yūpo suvaṇṇiyo ",
  "ja264:1.3": "tiriyaṃ soḷasubbedho ",
  "ja264:1.4": "uccamāhu sahassadhā. ",
  "ja264:2.1": "sahassakaṇḍo satageṇḍu ",
  "ja264:2.2": "dhajālu haritāmayo ",
  "ja264:2.3": "anaccuṃ tattha gandhabbā ",
  "ja264:2.4": "cha sahassāni sattadhā. ",
  "ja264:3.1": "evametaṃ tadā āsi ",
  "ja264:3.2": "yathā bhāsasi bhaddaji ",
  "ja264:3.3": "sakko ahaṃ tadā āsiṃ ",
  "ja264:3.4": "veyyāvaccakaro tavāti. ",
  "ja264:4.1": "mahāpanādajātakaṃ catutthaṃ. "
}
