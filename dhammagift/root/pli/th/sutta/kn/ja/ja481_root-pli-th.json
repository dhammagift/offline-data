  "ja481:0.1": "",
  "ja481:0.2": "",
  "ja481:0.3": "",
  "ja481:0.4": "8 takkāriyajātakaṃ ",
  "ja481:1.1": "ahameva dubbhāsitaṃ bhāsi bālo ",
  "ja481:1.2": "bhekovaraññe ahimavhāyamāno ",
  "ja481:1.3": "takkāriye sobbhamimaṃ patāmi ",
  "ja481:1.4": "na kireva sādhu ativelabhāṇī. ",
  "ja481:2.1": "pappoti macco ativelabhāṇī ",
  "ja481:2.2": "bandhaṃ vadhaṃ sokapariddavañca ",
  "ja481:2.3": "attānameva garahāsi ettha ",
  "ja481:2.4": "ācariya taṃ nikkhaṇanti sobbhe. ",
  "ja481:3.1": "kimevāhaṃ tuṇḍilaṃ ",
  "ja481:3.2": "anupucchiṃ kareyyāsaṃ bhātaraṃ kālikāya ",
  "ja481:3.3": "naggovahaṃ vatthayugañca jino ",
  "ja481:3.4": "ayampi attho bahu tādisova. ",
  "ja481:4.1": "yo yujjhamānānaṃ ayujjhamāno ",
  "ja481:4.2": "meṇḍantaraṃ accupatī kuliṅgo ",
  "ja481:4.3": "so piṃsito meṇḍasirehi tattha ",
  "ja481:4.4": "ayampi attho bahu tādisova. ",
  "ja481:5.1": "caturo janā potthakamaggahesuṃ ",
  "ja481:5.2": "ekañca posaṃ anurakkhamānā ",
  "ja481:5.3": "sabbeva te bhinnasirā sayiṃsu ",
  "ja481:5.4": "ayampi attho bahu tādisova. ",
  "ja481:6.1": "ajā yathā veḷugumbasmiṃ bandhā ",
  "ja481:6.2": "avekkhipantī asimajjhagacchi ",
  "ja481:6.3": "teneva tassā galakaṃ vikantā ",
  "ja481:6.4": "ayampi attho bahu ",
  "ja481:7.1": "tādisova. nayime devā nāpi gandhabbaputtā ",
  "ja481:7.2": "migā ime atthavasābhatā ime ",
  "ja481:7.3": "ekañca naṃ sāyamāse pacantu ",
  "ja481:7.4": "ekaṃ punappātarāse pacantu. ",
  "ja481:8.1": "sataṃ sahassāna dubbhāsitānaṃ ",
  "ja481:8.2": "kalampi nāgghati subhāsitassa ",
  "ja481:8.3": "dubbhāsitaṃ saṅkamāno kileso ",
  "ja481:8.4": "tasmā tuṇhī kiṃpuriso na bālyā. ",
  "ja481:9.1": "yā mesā byākāsi pamuñcathetaṃ ",
  "ja481:9.2": "giriñca naṃ himavantaṃ nayantu ",
  "ja481:9.3": "imañca kho dentu mahānasāya ",
  "ja481:9.4": "pātova naṃ pātarāse pacantu. ",
  "ja481:10.1": "pajjunnanāthā pasavo ",
  "ja481:10.2": "pasunāthā ayaṃ pajā ",
  "ja481:10.3": "tvaṃnāthosmi mahārāja ",
  "ja481:10.4": "amhanāthā mama bhariyā ",
  "ja481:10.5": "dvinnamaññataraṃ ñatvā ",
  "ja481:10.6": "mutto gaccheyya pabbataṃ. ",
  "ja481:11.1": "na ve nindā suparivajjayātha ",
  "ja481:11.2": "nānājanā sevitabbā janinda ",
  "ja481:11.3": "yeneva eko labhate pasaṃsaṃ ",
  "ja481:11.4": "teneva añño labhate ninditāraṃ. ",
  "ja481:12.1": "sabbo loko paracittena aticitto ",
  "ja481:12.2": "sabbo loko cittavā samhi citte ",
  "ja481:12.3": "paccekacittā puthu sabbasattā ",
  "ja481:12.4": "kassīdha cittassa vase na vatte. ",
  "ja481:13.1": "tuṇhī ahu kiṃpuriso sabhariyo ",
  "ja481:13.2": "yodāni byākāsi bhayassa bhīto ",
  "ja481:13.3": "sodāni mutto sukhito arogo ",
  "ja481:13.4": "vācā kirevatthavatī narānanti. ",
  "ja481:14.1": "takkāriyajātakaṃ aṭṭhamaṃ. "
}
