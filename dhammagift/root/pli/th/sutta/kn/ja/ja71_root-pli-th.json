  "ja71:0.3": "8 varuṇavaggo ",
  "ja71:0.4": "1 varuṇajātakaṃ ",
  "ja71:1.1": "yo pubbe karaṇīyāni ",
  "ja71:1.2": "pacchā so kātumicchati ",
  "ja71:1.3": "varuṇakaṭṭhaṃ bhañjova ",
  "ja71:1.4": "sa pacchā anutappatīti. ",
  "ja71:2.1": "varuṇajātakaṃ paṭhamaṃ. "
}
