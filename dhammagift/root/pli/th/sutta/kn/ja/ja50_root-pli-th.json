  "ja50:0.4": "10 dummedhajātakaṃ ",
  "ja50:1.1": "dummedhānaṃ sahassena ",
  "ja50:1.2": "yañño me upayācito ",
  "ja50:1.3": "idāni khohaṃ yajissāmi ",
  "ja50:1.4": "bahu adhammiko janoti. ",
  "ja50:2.1": "dummedhajātakaṃ dasamaṃ. ",
  "ja50:2.2": "atthakāmavaggo pañcamo. ",
  "ja50:3.1": "paṭhamapaṇṇāsako tassuddānaṃ. ",
  "ja50:4.1": "atha mittakamātu kapotavaro ",
  "ja50:4.2": "tathā veḷuka elamūgo rohiṇi ",
  "ja50:4.3": "kapi vāruṇi cetacarā ca puna ",
  "ja50:4.4": "tathā tāraka yaññavarena dasa. ",
  "ja50:5.1": ""
}
