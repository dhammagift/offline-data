  "ja256:0.3": "",
  "ja256:0.4": "6 jarūdapānajātakaṃ ",
  "ja256:1.1": "jarūdapānaṃ khaṇamānā ",
  "ja256:1.2": "vāṇijā udakatthikā ",
  "ja256:1.3": "ajjhaggaṃsu ayolohaṃ ",
  "ja256:1.4": "tipusīsañca māṇayo ",
  "ja256:1.5": "rajataṃ jātarūpañca ",
  "ja256:1.6": "muttā veḷuriyā bahū. ",
  "ja256:2.1": "te ca tena asantuṭṭhā ",
  "ja256:2.2": "bhiyyo bhiyyo khaṇiṃsu ",
  "ja256:2.3": "te tatthapāsīviso ghoro ",
  "ja256:2.4": "tejasī tejasā hani. ",
  "ja256:3.1": "tasmā khaṇe nātikkhaṇe ",
  "ja256:3.2": "atikkhātamhi pāpakaṃ ",
  "ja256:3.3": "khaṇanena dhanaṃ laddhaṃ ",
  "ja256:3.4": "atikkhātena nāsitanti. ",
  "ja256:4.1": "jarūdapānajātakaṃ chaṭṭhaṃ. "
}
