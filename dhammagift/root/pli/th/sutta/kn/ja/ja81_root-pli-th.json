{
  "ja81:0.1": "9 apāyimhavaggo ",
  "ja81:0.2": "",
  "ja81:0.3": "",
  "ja81:0.4": "1 surāpānajātakaṃ ",
  "ja81:1.1": "apāyimha anaccimha ",
  "ja81:1.2": "agāyimha rudimha ca ",
  "ja81:1.3": "visaññikaraṇiṃ pitvā ",
  "ja81:1.4": "diṭṭhā nāhumha vānarāti. ",
  "ja81:2.1": "surāpānajātakaṃ paṭhamaṃ. "
}
