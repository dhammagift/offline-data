  "ja343:0.1": "",
  "ja343:0.2": "",
  "ja343:0.3": "",
  "ja343:0.4": "3 kuntinījātakaṃ ",
  "ja343:1.1": "avasimha tavāgāre ",
  "ja343:1.2": "niccaṃ sakkatapūjitā ",
  "ja343:1.3": "tvamevadānimakari ",
  "ja343:1.4": "handa rāja vajāmahaṃ. ",
  "ja343:2.1": "yo ve kate paṭikate ",
  "ja343:2.2": "kibbise paṭikibbise ",
  "ja343:2.3": "evantaṃ sammati veraṃ ",
  "ja343:2.4": "vasa kuntini mā gamā. ",
  "ja343:3.1": "na katassa ca kattā ca ",
  "ja343:3.2": "mitti sandhiyate puna ",
  "ja343:3.3": "hadayaṃ nānujānāti ",
  "ja343:3.4": "gacchaññeva rathesabha. ",
  "ja343:4.1": "katassa ceva kattā ca ",
  "ja343:4.2": "mitti sandhiyate puna ",
  "ja343:4.3": "dhīrānaṃ no ca bālānaṃ ",
  "ja343:4.4": "vasa kuntini mā gamāti. ",
  "ja343:5.1": "kuntinījātakaṃ tatiyaṃ. "
}
