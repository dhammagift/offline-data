{
  "ja351:0.1": "pañcakanipātajātakaṃ 1 maṇikuṇḍalavaggo ",
  "ja351:0.2": "",
  "ja351:0.3": "",
  "ja351:0.4": "1 maṇikuṇḍalajātakaṃ ",
  "ja351:1.1": "jinno raṭṭhassamaṇikuṇḍale ca ",
  "ja351:1.2": "putte ca dāre ca tatheva jinno ",
  "ja351:1.3": "sabbesu bhogesu asesakesu ",
  "ja351:1.4": "kasmā na santappasi sokakāle. ",
  "ja351:2.1": "pubbeva maccaṃ vijahanti bhogā ",
  "ja351:2.2": "macco vā te pubbataraṃ jahāti ",
  "ja351:2.3": "asassatā bhogino kāmakāmi ",
  "ja351:2.4": "tasmā na socāmahaṃ sokakāle. ",
  "ja351:3.1": "udeti pūreti khīyati cando ",
  "ja351:3.2": "atthaṅgametvāna paleti sūriyo ",
  "ja351:3.3": "vijitā mayā sattuka lokadhammā ",
  "ja351:3.4": "tasmā na socāmahaṃ sokakāle. ",
  "ja351:4.1": "alaso gihī kāmabhogī na sādhu ",
  "ja351:4.2": "asaññato pabbajito na sādhu ",
  "ja351:4.3": "rājā na sādhu anisammakārī ",
  "ja351:4.4": "yo paṇḍito kodhano taṃ na sādhu. ",
  "ja351:5.1": "nisamma khattiyo kayirā ",
  "ja351:5.2": "nānisamma disampati ",
  "ja351:5.3": "nisammakārino rañño ",
  "ja351:5.4": "yaso kittī ca vaḍḍhatīti. ",
  "ja351:6.1": "maṇikuṇḍalajātakaṃ paṭhamaṃ. "
}
