  "ja70:0.3": "",
  "ja70:0.4": "10 kuddālajātakaṃ ",
  "ja70:1.1": "na taṃ jitaṃ sādhu jitaṃ ",
  "ja70:1.2": "yaṃ jitaṃ avajiyyati ",
  "ja70:1.3": "taṃ kho jitaṃ sādhu jitaṃ ",
  "ja70:1.4": "yaṃ jitaṃ nāvajiyyatīti. ",
  "ja70:2.1": "kuddālajātakaṃ dasamaṃ. ",
  "ja70:2.2": "itthīvaggo sattamo. ",
  "ja70:3.1": "tassuddānaṃ. ",
  "ja70:4.1": "sikhī sabbagghasopica vīṇavaro ",
  "ja70:4.2": "pisuṇā mittabhedikā nandi nadī ",
  "ja70:4.3": "mudulakkhaṇa sodariyā ca mano ",
  "ja70:4.4": "visa sādhujitena bhavanti dasa. "
}
