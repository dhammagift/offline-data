  "ja34:0.4": "4 macchajātakaṃ ",
  "ja34:1.1": "na maṃ sītaṃ na maṃ uṇhaṃ ",
  "ja34:1.2": "na maṃ jālasmi bādhanaṃ ",
  "ja34:1.3": "yañca maṃ maññate macchī ",
  "ja34:1.4": "aññaṃ so ratiyā gatoti. ",
  "ja34:2.1": "macchajātakaṃ catutthaṃ. "
}
