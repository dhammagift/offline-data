  "ja80:0.3": "",
  "ja80:0.4": "10 bhīmasenajātakaṃ ",
  "ja80:1.1": "yante pavikatthitaṃ pure ",
  "ja80:1.2": "atha te pūtisarā sajanti pacchā ",
  "ja80:1.3": "ubhayaṃ na sameti bhīmasena ",
  "ja80:1.4": "yuddhakathā ca idañca te vihaññanti. ",
  "ja80:2.1": "bhīmasenajātakaṃ dasamaṃ. ",
  "ja80:2.2": "varuṇavaggo aṭṭhamo. ",
  "ja80:3.1": "tassuddānaṃ. ",
  "ja80:4.1": "varuṇā akataññūvare tu saccavaraṃ ",
  "ja80:4.2": "savanappatinā ca abhitthanaya ",
  "ja80:4.3": "karuṇāya silāpalva illisato ",
  "ja80:4.4": "puna dindima pūtisarena dasa. "
}
