  "ja350:0.1": "",
  "ja350:0.2": "",
  "ja350:0.3": "",
  "ja350:0.4": "10 devatāpañhajātakaṃ ",
  "ja350:1.1": "hanti hatthehi pādehi ",
  "ja350:1.2": "mukhañca parisumbhati ",
  "ja350:1.3": "save rāja piyo hoti ",
  "ja350:1.4": "kantena tvābhipassasi. ",
  "ja350:2.1": "akkosati yathākāmaṃ ",
  "ja350:2.2": "āgamañcassa necchati ",
  "ja350:2.3": "save rāja piyo hoti ",
  "ja350:2.4": "kantena tvābhipassasi. ",
  "ja350:3.1": "abbhakkhāti abhūtena ",
  "ja350:3.2": "alikenābhisāraye ",
  "ja350:3.3": "save rāja piyo hoti ",
  "ja350:3.4": "kantena tvābhipassasi. ",
  "ja350:4.1": "haraṃ annañca pānañca ",
  "ja350:4.2": "vatthasenāsanāni ca ",
  "ja350:4.3": "(aññadatthuṃ harā santā) ",
  "ja350:4.4": "teve rāja piyā honti ",
  "ja350:4.5": "kantena tvābhipassasīti. ",
  "ja350:5.1": "devatāpañhajātakaṃ dasamaṃ. ",
  "ja350:5.2": "cullakuṇālavaggo pañcamo. ",
  "ja350:6.1": "tassuddānaṃ. ",
  "ja350:7.1": "narānaṃ asakkhi vasimhavaro ",
  "ja350:7.2": "niliyamaggivarañca puna ",
  "ja350:7.3": "puna rasāyasakūṭavaro ",
  "ja350:7.4": "tathārañña sārathi hanti dasa. ",
  "ja350:8.1": "tatra vagguddānaṃ ",
  "ja350:9.1": "bhavati. vivaraṃ pucimandañca ",
  "ja350:9.2": "kuṭidūsaṃ bahubhāṇakaṃ ",
  "ja350:9.3": "cullakuṇālavaggo so ",
  "ja350:9.4": "pañcamo suppakāsitoti. ",
  "ja350:10.1": "catukkanipātaṃ niṭṭhitaṃ. "
}
