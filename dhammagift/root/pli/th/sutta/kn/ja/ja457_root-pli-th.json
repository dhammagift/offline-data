  "ja457:0.2": "",
  "ja457:0.3": "",
  "ja457:0.4": "3 dhammadevaputtajātakaṃ ",
  "ja457:1.1": "yasokaro puññakarohamasmi ",
  "ja457:1.2": "sadatthuto samaṇabrāhmaṇānaṃ ",
  "ja457:1.3": "maggāraho devamanussapūjito ",
  "ja457:1.4": "dhammo ahaṃ dehi adhamma maggaṃ. ",
  "ja457:2.1": "adhammayānaṃ daḷhamāruhitvā ",
  "ja457:2.2": "asantasanto balavāhamasmi ",
  "ja457:2.3": "sa kissa hetumhi tavajja dajjaṃ ",
  "ja457:2.4": "maggaṃ ahaṃ dhamma adinnapubbaṃ. ",
  "ja457:3.1": "dhammo have pāturahosi pubbe ",
  "ja457:3.2": "pacchā adhammo udapādi loke ",
  "ja457:3.3": "jeṭṭho ca seṭṭho ca sanantano ca ",
  "ja457:3.4": "uyyāhi jeṭṭhassa kaniṭṭha maggā ",
  "ja457:4.1": "na yācanāya napi pāṭirūpā ",
  "ja457:4.2": "na arahattā tehaṃ dadeyya maggaṃ ",
  "ja457:4.3": "yuddhañca no hotu ubhinnamajja ",
  "ja457:4.4": "yuddhasmi yo jissati tassa maggo. ",
  "ja457:5.1": "sabbā disā anuvissaṭohamasmi ",
  "ja457:5.2": "mahabbalo amitayaso atulyo ",
  "ja457:5.3": "guṇehi sabbehi upetarūpo ",
  "ja457:5.4": "dhammo adhamma tvaṃ kathaṃ vijessasi. ",
  "ja457:6.1": "lohena ve haññati jātarūpaṃ ",
  "ja457:6.2": "na jātarūpena hananti lohaṃ ",
  "ja457:6.3": "sace adhammo haññati dhammamajja ",
  "ja457:6.4": "ayo suvaṇṇaṃ viya dassaneyyaṃ. ",
  "ja457:7.1": "sace tuvaṃ yuddhabalo adhamma ",
  "ja457:7.2": "na tuyha vuḍḍhā ca garū ca atthi ",
  "ja457:7.3": "maggañca te dammi piyāppiyena ",
  "ja457:7.4": "vācāduruttānipi te khamāmi. ",
  "ja457:8.1": "idañca sutvā vacanaṃ adhammo ",
  "ja457:8.2": "avaṃsiro patito uddhapādo ",
  "ja457:8.3": "yuddhatthikove na labhāmi yuddhaṃ ",
  "ja457:8.4": "ettāvatā hoti hato adhammo. ",
  "ja457:9.1": "khantībalo yuddhabalaṃ vijetvā ",
  "ja457:9.2": "hantvā adhammaṃ nihanitva bhūmyā ",
  "ja457:9.3": "pāyāsi citto abhiruyha sandanaṃ ",
  "ja457:9.4": "maggeneva atibalo saccanikkamo. ",
  "ja457:10.1": "mātā pitā samaṇabrāhmaṇā ca ",
  "ja457:10.2": "asammānitā yassa sake agāre ",
  "ja457:10.3": "idheva nikkhippa sarīradehaṃ ",
  "ja457:10.4": "kāyassa bhedā nirayaṃ vajanti te ",
  "ja457:10.5": "yathā adhammo patito avaṃsiro. ",
  "ja457:11.1": "mātā pitā samaṇabrāhmaṇā ca ",
  "ja457:11.2": "susammānitā yassa sake agāre ",
  "ja457:11.3": "idheva nikkhippa sarīradehaṃ ",
  "ja457:11.4": "kāyassa bhedā sugatiṃ vajanti te ",
  "ja457:11.5": "yathāpi dhammo abhiruyha sandananti. ",
  "ja457:12.1": "dhammadevaputtajātakaṃ tatiyaṃ. "
}
