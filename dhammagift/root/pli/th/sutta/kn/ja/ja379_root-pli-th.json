  "ja379:0.1": "",
  "ja379:0.2": "",
  "ja379:0.3": "",
  "ja379:0.4": "4 nerujātakaṃ ",
  "ja379:1.1": "kākolā kākasaṅghā ca ",
  "ja379:1.2": "mayañca patataṃ varā ",
  "ja379:1.3": "sabbeva sadisā homa ",
  "ja379:1.4": "imaṃ āgamma pabbataṃ. ",
  "ja379:2.1": "idha sīhā ca byagghā ca ",
  "ja379:2.2": "sakuṇā ca migādhamā ",
  "ja379:2.3": "sabbeva sadisā honti ",
  "ja379:2.4": "ayaṃ ko nāma pabbato. ",
  "ja379:3.1": "imaṃ nerunti jānanti ",
  "ja379:3.2": "manussā pabbatuttamaṃ ",
  "ja379:3.3": "idha vaṇṇena sampannā ",
  "ja379:3.4": "vasanti sabbapāṇino. ",
  "ja379:4.1": "amānanā yattha siyā ",
  "ja379:4.2": "santānaṃ vā vimānanā ",
  "ja379:4.3": "hīnasammānanā vāpi ",
  "ja379:4.4": "na tattha vasatī vase. ",
  "ja379:5.1": "yattha alaso ca dakkho ca ",
  "ja379:5.2": "sūro bhīru ca pūjiyā ",
  "ja379:5.3": "na tattha santo vasanti ",
  "ja379:5.4": "avisesakare nage. ",
  "ja379:6.1": "nāyaṃ neru vibhajati ",
  "ja379:6.2": "hīnaukkaṭṭhamajjhime ",
  "ja379:6.3": "avisesakaro neru ",
  "ja379:6.4": "handa neruṃ jahāmaseti. ",
  "ja379:7.1": "nerujātakaṃ catutthaṃ. "
}
