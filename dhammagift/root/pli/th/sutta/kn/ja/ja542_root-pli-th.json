  "ja542:160.1": "sukhāvaho dukkhanūdo ",
  "ja542:160.2": "vedehassa yasassino ",
  "ja542:160.3": "matinte paṭihaññāmi ",
  "ja542:160.4": "usuṃ palasatena vā. ",
  "ja542:161.1": "iṅgha passa mahārāja ",
  "ja542:161.2": "suññaṃ antepuraṃ tava ",
  "ja542:161.3": "orodhā ca kumārā ca ",
  "ja542:161.4": "tava mātā ca khattiya ",
  "ja542:161.5": "ummaṅgā nīharitvāna ",
  "ja542:161.6": "vedehassupanāmitā. ",
  "ja542:162.1": "iṅgha antepuraṃ mayhaṃ ",
  "ja542:162.2": "gantvāna vicinātha naṃ ",
  "ja542:162.3": "yathā imassa vacanaṃ ",
  "ja542:162.4": "saccaṃ vā yadi vā musā. ",
  "ja542:163.1": "evametaṃ mahārāja ",
  "ja542:163.2": "yathā āha mahosadho ",
  "ja542:163.3": "suññaṃ antepuraṃ sabbaṃ ",
  "ja542:163.4": "kākapatanakaṃ yathā. ",
  "ja542:164.1": "ito gatā mahārāja ",
  "ja542:164.2": "nārī sabbaṅgasobhanā ",
  "ja542:164.3": "kosumbhaphalakasussoṇī ",
  "ja542:164.4": "haṃsagaggarabhāṇinī. ",
  "ja542:165.1": "ito nītā mahārāja ",
  "ja542:165.2": "nārī sabbaṅgasobhanā ",
  "ja542:165.3": "koseyyavasanā sāmā ",
  "ja542:165.4": "jātarūpasumekhalā. ",
  "ja542:166.1": "surattapādā kalyāṇī ",
  "ja542:166.2": "suvaṇṇamaṇimekhalā ",
  "ja542:166.3": "pārevatakkhī sutanū ",
  "ja542:166.4": "bimboṭṭhā tanumajjhimā. ",
  "ja542:167.1": "sujātā bhujalaṭṭhīva ",
  "ja542:167.2": "vedīva tanumajjhimā ",
  "ja542:167.3": "dīghassā kesā asitā ",
  "ja542:167.4": "īsakaggapavellitā. ",
  "ja542:168.1": "sujātā migacchāpīva ",
  "ja542:168.2": "hemantaggisikhāriva ",
  "ja542:168.3": "nadīva giriduggesu ",
  "ja542:168.4": "sañchannā khuddaveḷubhi. ",
  "ja542:169.1": "nāganāsūrukalyāṇī paṭhamā ",
  "ja542:169.2": "timbarutthanī ",
  "ja542:169.3": "nātidīghā nātirassā ",
  "ja542:169.4": "nālomā nātilomakā. ",
  "ja542:170.1": "nandāya nūna maraṇena ",
  "ja542:170.2": "nandasi sirivāhana ",
  "ja542:170.3": "ahañca nūna nandā ca ",
  "ja542:170.4": "gacchāma yamasādhanaṃ. ",
  "ja542:171.1": "dibbaṃ adhiyase māyaṃ ",
  "ja542:171.2": "akāsi cakkhumohanaṃ ",
  "ja542:171.3": "yo me amittaṃ hatthagataṃ ",
  "ja542:171.4": "vedehaṃ parimocayi. ",
  "ja542:172.1": "adhiyanti ve mahārāja ",
  "ja542:172.2": "dibbamāyīdha paṇḍitā ",
  "ja542:172.3": "te mocayanti attānaṃ ",
  "ja542:172.4": "paṇḍitā mantino janā. ",
  "ja542:173.1": "santi māṇavaputtā me ",
  "ja542:173.2": "kusalā sandhichedakā ",
  "ja542:173.3": "yesaṃ katena maggena ",
  "ja542:173.4": "vedeho mithilaṃ gato. ",
  "ja542:174.1": "iṅgha passa mahārāja ",
  "ja542:174.2": "ummaṅgaṃ sādhumāpitaṃ ",
  "ja542:174.3": "hatthīnaṃ atha assānaṃ ",
  "ja542:174.4": "rathānaṃ atha pattinaṃ ",
  "ja542:174.5": "ālokabhūtaṃ tiṭṭhantaṃ ",
  "ja542:174.6": "ummaṅgaṃ sādhuniṭṭhitaṃ. ",
  "ja542:175.1": "lābhā vata videhānaṃ ",
  "ja542:175.2": "yassime edisā paṇḍitā ",
  "ja542:175.3": "ghare vasanti vijite ",
  "ja542:175.4": "yathā tvamasi mahosadha. ",
  "ja542:176.1": "vuttiñca parihārañca ",
  "ja542:176.2": "diguṇaṃ bhattavettanaṃ ",
  "ja542:176.3": "dadāmi vipule bhoge ",
  "ja542:176.4": "bhuñja kāme ramassu ca ",
  "ja542:176.5": "mā videhaṃ paccagamā ",
  "ja542:176.6": "kiṃ videho karissati. ",
  "ja542:177.1": "yo cajetha mahārāja ",
  "ja542:177.2": "bhattāraṃ dhanakāraṇā ",
  "ja542:177.3": "ubhinnaṃ hoti gārayho ",
  "ja542:177.4": "attano ca parassa ca ",
  "ja542:177.5": "yāva jīveyya vedeho ",
  "ja542:177.6": "nāññassa vijite vase. ",
  "ja542:178.1": "yo cajetha mahārāja ",
  "ja542:178.2": "bhattāraṃ dhanakāraṇā ",
  "ja542:178.3": "ubhinnaṃ hoti gārayho ",
  "ja542:178.4": "attano ca parassa ca ",
  "ja542:178.5": "yāva tiṭṭheyya vedeho ",
  "ja542:178.6": "nāññassa puriso siyaṃ. ",
  "ja542:179.1": "dammi nikkhasahassante ",
  "ja542:179.2": "gāmāsītiñca kāsisu ",
  "ja542:179.3": "dāsīsatāni cattāri ",
  "ja542:179.4": "dammi bhariyāsatañca te ",
  "ja542:179.5": "sabbaṃ senāṅgamādāya ",
  "ja542:179.6": "sotthiṃ gaccha mahosadha. ",
  "ja542:180.1": "yāva dadantu hatthīnaṃ ",
  "ja542:180.2": "assānaṃ diguṇaṃ vidhaṃ ",
  "ja542:180.3": "tappentu annapānena ",
  "ja542:180.4": "rathike pattikārake. ",
  "ja542:181.1": "hatthī asse rathe pattī ",
  "ja542:181.2": "gacchevādāya paṇḍita ",
  "ja542:181.3": "passatu taṃ mahārājā ",
  "ja542:181.4": "vedeho mithilaṃ gataṃ. ",
  "ja542:182.1": "hatthī assā rathā pattī ",
  "ja542:182.2": "senā sādissate mahā ",
  "ja542:182.3": "caturaṅginī bhiṃsarūpā ",
  "ja542:182.4": "kinnu maññanti paṇḍitā. ",
  "ja542:183.1": "ānando te mahārāja ",
  "ja542:183.2": "uttamo paṭidissati ",
  "ja542:183.3": "sabbaṃ senāṅgamādāya ",
  "ja542:183.4": "sotthippatto mahosadho. ",
  "ja542:184.1": "yathā petaṃ susānasmiṃ ",
  "ja542:184.2": "chaḍḍetvā caturo janā ",
  "ja542:184.3": "evaṃ kappiliye tyamhā ",
  "ja542:184.4": "chaḍḍayitvā idhāgatā. ",
  "ja542:185.1": "atha tvaṃ kena vaṇṇena ",
  "ja542:185.2": "kena vā pana hetunā ",
  "ja542:185.3": "kena vā atthajātena ",
  "ja542:185.4": "attānaṃ parimocayi. ",
  "ja542:186.1": "atthaṃ atthena vedeha ",
  "ja542:186.2": "mantaṃ mantena khattiya ",
  "ja542:186.3": "parivārayissaṃ rājānaṃ ",
  "ja542:186.4": "jambūdīpaṃva sāgaro. ",
  "ja542:187.1": "dinnaṃ nikkhasahassaṃ me ",
  "ja542:187.2": "gāmāsītiñca kāsisu ",
  "ja542:187.3": "dāsīsatāni cattāri ",
  "ja542:187.4": "dinnaṃ bhariyāsatañca me ",
  "ja542:187.5": "sabbaṃ senāṅgamādāya ",
  "ja542:187.6": "sotthināmhi idhāgato. ",
  "ja542:188.1": "susukhaṃ vata saṃvāso ",
  "ja542:188.2": "paṇḍitehīti senaka ",
  "ja542:188.3": "pakkhīva pañjare bandhe ",
  "ja542:188.4": "macche jālagateriva ",
  "ja542:188.5": "amittahatthatthagate ",
  "ja542:188.6": "mocayi no mahosadho. ",
  "ja542:189.1": "evameva mahārāja ",
  "ja542:189.2": "paṇḍitā hi sukhāvahā ",
  "ja542:189.3": "pakkhīva pañjare bandhe ",
  "ja542:189.4": "macche jālagateriva ",
  "ja542:189.5": "amittahatthatthagate ",
  "ja542:189.6": "mocayi no mahosadho. ",
  "ja542:190.1": "āhaññantu sabbavīṇā ",
  "ja542:190.2": "bheriyo dendimāni ca ",
  "ja542:190.3": "dhamantu māgadhā saṅkhā ",
  "ja542:190.4": "vaggū nadantu dundubhī. ",
  "ja542:191.1": "orodhā ca kumārā ca ",
  "ja542:191.2": "vesiyānā ca brāhmaṇā ",
  "ja542:191.3": "bahuṃ annañca pānañca ",
  "ja542:191.4": "paṇḍitassābhihārayuṃ. ",
  "ja542:192.1": "hatthārohā anīkaṭṭhā ",
  "ja542:192.2": "rathikā pattikārakā ",
  "ja542:192.3": "bahuṃ annañca pānañca ",
  "ja542:192.4": "paṇḍitassābhihārayuṃ. ",
  "ja542:193.1": "samāgatā jānapadā ",
  "ja542:193.2": "negamā ca samāgatā ",
  "ja542:193.3": "bahuṃ annañca pānañca ",
  "ja542:193.4": "paṇḍitassābhihārayuṃ. ",
  "ja542:194.1": "bahujjano pasannosi ",
  "ja542:194.2": "disvā paṇḍitamāgataṃ ",
  "ja542:194.3": "paṇḍitamhi anuppatte ",
  "ja542:194.4": "celukkhepo pavattathāti. ",
  "ja542:195.1": "mahosadhajātakaṃ pañcamaṃ. 6 bhūridattajātakaṃ "
}
