{
  "ja301:0.1": "",
  "ja301:0.2": "catukkanipātajātakaṃ ",
  "ja301:0.3": "1 kāliṅgavaggo ",
  "ja301:0.4": "1 cullakāliṅgajātakaṃ ",
  "ja301:1.1": "vivaratha imāsaṃ dvāraṃ ",
  "ja301:1.2": "nagarantaṃ pavīsituṃ aruṇarājassa ",
  "ja301:1.3": "sīhena susiṭṭhena ",
  "ja301:1.4": "surakkhitaṃ nandisenena. ",
  "ja301:2.1": "jayo kāliṅgānaṃ asayhasāhinaṃ ",
  "ja301:2.2": "parājayo ajayo assakānaṃ ",
  "ja301:2.3": "iccevaṃ te bhāsitaṃ brahmacāri ",
  "ja301:2.4": "na ujubhūtā vitathaṃ bhaṇanti. ",
  "ja301:3.1": "devā musāvādamupātivattā ",
  "ja301:3.2": "saccaṃ tathaṃ paramaṃ karaṃ nu sakka ",
  "ja301:3.3": "tante musā bhāsitaṃ devarāja ",
  "ja301:3.4": "kiṃ vā paṭicca maghavā mahinda. ",
  "ja301:4.1": "nanu te sutaṃ brāhmaṇa bhaññamāne ",
  "ja301:4.2": "devā na issanti purisaparakkamassa ",
  "ja301:4.3": "damo samādhi manaso abhejjo ",
  "ja301:4.4": "abyattatā nikkamanañca kāle ",
  "ja301:4.5": "daḷhañca viriyaṃ purisaparakkamo ca ",
  "ja301:4.6": "teneva āsi vijayo assakānanti. ",
  "ja301:5.1": "cullakāliṅgajātakaṃ paṭhamaṃ. "
}
