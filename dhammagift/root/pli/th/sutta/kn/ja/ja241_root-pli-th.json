{
  "ja241:0.1": "10 sigālavaggo ",
  "ja241:0.2": "",
  "ja241:0.3": "",
  "ja241:0.4": "1 sabbadāṭhijātakaṃ ",
  "ja241:1.1": "sigālo mānathaddho ca ",
  "ja241:1.2": "parivārena atthiko ",
  "ja241:1.3": "pāpuṇi mahatiṃ bhūmiṃ ",
  "ja241:1.4": "rājāsi sabbadāṭhinaṃ. ",
  "ja241:2.1": "evameva manussesu ",
  "ja241:2.2": "yo hoti parivāravā ",
  "ja241:2.3": "so hi tattha mahā hoti ",
  "ja241:2.4": "sigālo viya dāṭhinanti. ",
  "ja241:3.1": "sabbadāṭhijātakaṃ paṭhamaṃ. "
}
