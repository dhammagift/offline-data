  "ja391:0.3": "",
  "ja391:0.4": "6 pabbajitaviheṭhakajātakaṃ ",
  "ja391:1.1": "dubbaṇṇarūpaṃ tvamariyavaṇṇī ",
  "ja391:1.2": "purakkhitvā pañjaliko namassasi ",
  "ja391:1.3": "seyyo nu te so udāhu sarikkho ",
  "ja391:1.4": "nāmaṃ parassattano cāpi brūhi. ",
  "ja391:2.1": "na nāmagottaṃ gaṇhanti rāja ",
  "ja391:2.2": "samaggatānujjugatāna devā ",
  "ja391:2.3": "ahañca te nāmadheyyaṃ vadāmi ",
  "ja391:2.4": "sakkohamasmī tidasānamindo. ",
  "ja391:3.1": "yo disvā bhikkhuṃ caraṇūpapannaṃ ",
  "ja391:3.2": "purakkhitvā pañjaliko namassati ",
  "ja391:3.3": "pucchāmi taṃ devarājetamatthaṃ ",
  "ja391:3.4": "ito cuto kiṃ labhate sukhaṃ so. ",
  "ja391:4.1": "yo disvā bhikkhuṃ caraṇūpapannaṃ ",
  "ja391:4.2": "purakkhitvā pañjaliko namassati ",
  "ja391:4.3": "diṭṭheva dhamme labhate pasaṃsaṃ ",
  "ja391:4.4": "saggañca so yāti sarīrabhedā. ",
  "ja391:5.1": "lakkhī vata me udapādi ajja ",
  "ja391:5.2": "yaṃ vāsavaṃ bhūtipatiddasāma ",
  "ja391:5.3": "bhikkhuñca disvāna tuvañca sakka ",
  "ja391:5.4": "kāhāmi puññāni anappakāni. ",
  "ja391:6.1": "addhā have sevitabbā sapaññā ",
  "ja391:6.2": "bahussutā ye bahuṭhānacintino ",
  "ja391:6.3": "bhikkhuñca disvāna mamañca rāja ",
  "ja391:6.4": "karohi puññāni anappakāni. ",
  "ja391:7.1": "akkodhano niccapasannacitto ",
  "ja391:7.2": "sabbātithīyācayogo bhavitvā ",
  "ja391:7.3": "nihañña mānaṃ abhivādayissaṃ ",
  "ja391:7.4": "sutvāna devinda subhāsitānīti. ",
  "ja391:8.1": "pabbajitaviheṭhakajātakaṃ chaṭṭhaṃ. "
}
