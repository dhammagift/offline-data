  "ja283:0.1": "",
  "ja283:0.2": "",
  "ja283:0.3": "",
  "ja283:0.4": "3 vaḍḍhakīsūkarajātakaṃ ",
  "ja283:1.1": "varaṃ varaṃ tvaṃ nihanaṃ pure cari ",
  "ja283:1.2": "asmiṃ padese abhibhuyya sūkare ",
  "ja283:1.3": "sodāni eko byaggha pagamma jhāyasi ",
  "ja283:1.4": "balannu te byaggha na cajja vijjati. ",
  "ja283:2.1": "imassutā yanti disodisaṃ pure ",
  "ja283:2.2": "bhayaddhitā leṇagavesino puthū ",
  "ja283:2.3": "tedāni saṅgamma vasanti ekato ",
  "ja283:2.4": "yatthaṭṭhitā duppasahajjime mayā. ",
  "ja283:3.1": "namatthu saṅghāna samāgatānaṃ ",
  "ja283:3.2": "disvā sayaṃ saṃkhya vadāmi abbhutaṃ ",
  "ja283:3.3": "byagghaṃ migā yattha jiniṃsu dāṭhino ",
  "ja283:3.4": "sāmaggiyā dāṭhabalesu muccareti. ",
  "ja283:4.1": "vaḍḍhakīsūkarajātakaṃ tatiyaṃ. "
}
