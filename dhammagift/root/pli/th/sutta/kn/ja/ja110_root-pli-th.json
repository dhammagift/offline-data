  "ja110:0.3": "",
  "ja110:0.4": "10 sabbasaṃhārakapañho ",
  "ja110:1.1": "sabbasaṃhārako natthi ",
  "ja110:1.2": "suddhaṃ kaṅgu pavāyati ",
  "ja110:1.3": "alikaṃ bhāsatiyaṃ dhuttī ",
  "ja110:1.4": "saccamāhu mahallikāti. ",
  "ja110:2.1": "sabbasaṃhārakapañho dasamo. ",
  "ja110:2.2": "parosatavaggo ekādasamo. ",
  "ja110:3.1": "tassuddānaṃ. ",
  "ja110:4.1": "saparosata tāyita verī puna ",
  "ja110:4.2": "bhamacakka tha nāgasirivhayano ",
  "ja110:4.3": "sukhakañca vata sippaka bāhiyā ",
  "ja110:4.4": "kuṇḍapūva mahallikakā ca dasa. "
}
