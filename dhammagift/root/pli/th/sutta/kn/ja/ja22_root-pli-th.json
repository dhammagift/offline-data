  "ja22:0.4": "2 kukkurajātakaṃ ",
  "ja22:1.1": "ye kukkurā rājakulasmi vaḍḍhā ",
  "ja22:1.2": "koleyyakā vaṇṇabalūpapannā ",
  "ja22:1.3": "teme na vajjhā mayamasma vajjhā ",
  "ja22:1.4": "nāyaṃ saghaccā dubbalaghātikāyanti. ",
  "ja22:2.1": "kukkurajātakaṃ dutiyaṃ. "
}
