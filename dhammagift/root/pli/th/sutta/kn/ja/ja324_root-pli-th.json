  "ja324:0.1": "",
  "ja324:0.2": "",
  "ja324:0.3": "",
  "ja324:0.4": "4 cammasāṭakajātakaṃ ",
  "ja324:1.1": "kalyāṇarūpo vatāyaṃ catuppado ",
  "ja324:1.2": "subhaddako ceva supesalo ca ",
  "ja324:1.3": "yo brāhmaṇaṃ jātimantūpapannaṃ ",
  "ja324:1.4": "apacāyati meṇḍavaro yasassī. ",
  "ja324:2.1": "mā brāhmaṇa ittaradassanena ",
  "ja324:2.2": "vissāsamāpajji catuppadassa ",
  "ja324:2.3": "daḷhappahāraṃ abhikattukāmo ",
  "ja324:2.4": "avasakkati dassati suppahāraṃ. ",
  "ja324:3.1": "uruṭṭhī bhaggā patito khāribhāro ",
  "ja324:3.2": "sabbaṃ bhaṇḍaṃ brāhmaṇasseva bhinnaṃ ",
  "ja324:3.3": "ubhopi bāhā paggayheva kandati ",
  "ja324:3.4": "abhidhāvataṃ haññati brahmacāriṃ. ",
  "ja324:4.1": "evaṃ so nihato seti ",
  "ja324:4.2": "yo apūjaṃ pasaṃsati ",
  "ja324:4.3": "yathāhamajja pahato ",
  "ja324:4.4": "hato meṇḍena dummatīti. ",
  "ja324:5.1": "cammasāṭakajātakaṃ catutthaṃ. "
}
