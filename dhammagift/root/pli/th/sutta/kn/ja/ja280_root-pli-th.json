  "ja280:0.3": "",
  "ja280:0.4": "10 pūṭadūsakajātakaṃ ",
  "ja280:1.1": "addhā hi nūna migarājā ",
  "ja280:1.2": "pūṭakammassa kovido ",
  "ja280:1.3": "tathāhi pūṭaṃ dūseti ",
  "ja280:1.4": "aññaṃ nūna karissati. ",
  "ja280:2.1": "na me pitā vā mātā vā ",
  "ja280:2.2": "pūṭakammassa kovidā ",
  "ja280:2.3": "kataṃ kataṃ kho dūsema ",
  "ja280:2.4": "evaṃdhammamidaṃ kulaṃ. ",
  "ja280:3.1": "yesaṃ vo ediso dhammo ",
  "ja280:3.2": "adhammo pana kīdiso ",
  "ja280:3.3": "mā vo dhammaṃ adhammaṃ vā ",
  "ja280:3.4": "addasāma kudācananti. ",
  "ja280:4.1": "pūṭadūsakajātakaṃ dasamaṃ. ",
  "ja280:4.2": "",
  "ja280:5.1": "udapānavaggo tatiyo tassuddānaṃ. ",
  "ja280:6.1": "udapānavaraṃ vanabyaggha kapi ",
  "ja280:6.2": "sikhinī ca balākaruciravaro sujanādhipa romaka ",
  "ja280:6.3": "dūsa puna ",
  "ja280:6.4": "satapattavaro pūṭakamma dasa. "
}
