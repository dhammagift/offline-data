  "ja13:0.3": "",
  "ja13:0.4": "3 kaṇḍinajātakaṃ ",
  "ja13:1.1": "dhiratthu kaṇḍinaṃ sallaṃ ",
  "ja13:1.2": "purisaṃ gāḷhavedhinaṃ ",
  "ja13:1.3": "dhiratthu taṃ janapadaṃ ",
  "ja13:1.4": "yatthitthī pariṇāyikā ",
  "ja13:1.5": "te vāpi dhikkitā sattā ",
  "ja13:1.6": "ye itthīnaṃ vasaṃ gatāti. ",
  "ja13:2.1": "kaṇḍinajātakaṃ tatiyaṃ. "
}
