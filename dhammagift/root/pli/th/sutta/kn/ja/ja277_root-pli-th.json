  "ja277:0.3": "",
  "ja277:0.4": "7 romajātakaṃ ",
  "ja277:1.1": "vassāni paññāsa samādhikāni ",
  "ja277:1.2": "vāsimhi selassa guhāya romaka ",
  "ja277:1.3": "asaṅkamānā abhinibbutacittā ",
  "ja277:1.4": "hatthatthamāyanti mamaṇḍajā pure. ",
  "ja277:2.1": "tedāni vaṅkaṅga kimatthamussukkā ",
  "ja277:2.2": "bhajanti aññaṃ girikandaraṃ dijā nanu ",
  "ja277:2.3": "na maññanti mamaṃ yathā pure ",
  "ja277:2.4": "cirampavuṭṭhā athavā na te ime. ",
  "ja277:3.1": "jānāma taṃ na mayaṃ sammuḷhā ",
  "ja277:3.2": "sveva tvaṃ te mayamasma naññe ",
  "ja277:3.3": "cittañca te asmi jane paduṭṭhaṃ ",
  "ja277:3.4": "ājīvaka tena taṃ uttasāmāti. ",
  "ja277:4.1": "romajātakaṃ sattamaṃ. "
}
