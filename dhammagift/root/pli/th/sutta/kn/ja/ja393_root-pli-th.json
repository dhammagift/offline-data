  "ja393:0.2": "",
  "ja393:0.3": "",
  "ja393:0.4": "8 vighāsādajātakaṃ ",
  "ja393:1.1": "susukhaṃ vata jīvanti ",
  "ja393:1.2": "ye janā vighāsādino ",
  "ja393:1.3": "diṭṭheva dhamme pāsaṃsā ",
  "ja393:1.4": "samparāye ca suggati. ",
  "ja393:2.1": "sukassa bhāsamānassa ",
  "ja393:2.2": "na nisāmetha paṇḍitā ",
  "ja393:2.3": "idaṃ suṇātha sodariyā ",
  "ja393:2.4": "amhevāyaṃ pasaṃsati. ",
  "ja393:3.1": "nāhaṃ tumhe pasaṃsāmi ",
  "ja393:3.2": "kuṇapādā suṇātha me ",
  "ja393:3.3": "ucchiṭṭhabhojino tumhe ",
  "ja393:3.4": "na tumhe vighāsādino ",
  "ja393:4.1": "sattavassā pabbajitā ",
  "ja393:4.2": "majjharaññe sikhaṇḍino ",
  "ja393:4.3": "vighāseneva yāpentā ",
  "ja393:4.4": "mayaṃ ce bhoto gārayhā ",
  "ja393:4.5": "ke nu bhoto pasaṃsiyā. ",
  "ja393:5.1": "tumhe sīhānaṃ byagghānaṃ ",
  "ja393:5.2": "vāḷānañcāvasiṭṭhakaṃ ",
  "ja393:5.3": "ucchiṭṭheneva yāpentā ",
  "ja393:5.4": "maññivho vighāsādino. ",
  "ja393:6.1": "ye brāhmaṇassa samaṇassa ",
  "ja393:6.2": "aññassa ca vaṇibbino ",
  "ja393:6.3": "datvāvasesaṃ bhuñjanti ",
  "ja393:6.4": "te janā vighāsādinoti. ",
  "ja393:7.1": "vighāsādajātakaṃ aṭṭhamaṃ. "
}
