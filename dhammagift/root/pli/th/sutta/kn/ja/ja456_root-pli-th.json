{
  "ja456:0.1": "",
  "ja456:0.2": "",
  "ja456:0.3": "",
  "ja456:0.4": "2 juṇhajātakaṃ ",
  "ja456:1.1": "suṇohi mayhaṃ vacanaṃ janinda ",
  "ja456:1.2": "atthena juṇhamhi idhānupatto ",
  "ja456:1.3": "na brāhmaṇe addhike tiṭṭhamāne ",
  "ja456:1.4": "gantabbamāhu dvipadānaseṭṭha. ",
  "ja456:2.1": "suṇomi tiṭṭhāmi vadehi brahme ",
  "ja456:2.2": "yenāpi atthena idhānupatto ",
  "ja456:2.3": "kaṃ vā tvamatthaṃ mayi patthayāno ",
  "ja456:2.4": "idhāgamā brahme tadiṅgha brūhi. ",
  "ja456:3.1": "dadāhi me gāmavarāni pañca ",
  "ja456:3.2": "",
  "ja456:3.3": "dāsīsataṃ satta gavaṃsatāni parosahassañca suvaṇṇanikkhe ",
  "ja456:3.4": "bhariyā ca me sādisī dve dadāhi. ",
  "ja456:4.1": "tapo nu te brāhmaṇa bhiṃsarūpo ",
  "ja456:4.2": "mantā nu te brāhmaṇa cittarūpā ",
  "ja456:4.3": "yakkhā nu te assavā santi keci ",
  "ja456:4.4": "atthaṃ vā me abhijānāsi kattaṃ. ",
  "ja456:5.1": "na me tapo atthi na cāpi mantā ",
  "ja456:5.2": "yakkhāpi me assavā natthi keci ",
  "ja456:5.3": "atthaṃpi te nābhijānāmi kattaṃ ",
  "ja456:5.4": "pubbeva kho saṅgatimattamāsi. ",
  "ja456:6.1": "paṭhamaṃ idaṃ dassanaṃ jānato me ",
  "ja456:6.2": "na tābhijānāmi ito puratthā ",
  "ja456:6.3": "akkhāhi me pucchito etamatthaṃ ",
  "ja456:6.4": "kadā kuhiṃ vā ahu saṅgamo no. ",
  "ja456:7.1": "gandhārarājassa puramhi ramme ",
  "ja456:7.2": "avasimhase takkasilāya deva ",
  "ja456:7.3": "tatthandhakāramhi timissakāyaṃ ",
  "ja456:7.4": "aṃsena aṃsaṃ samaghaṭṭayimhā ",
  "ja456:8.1": "te tattha ṭhatvāna ubho janinda ",
  "ja456:8.2": "sārāṇiyaṃ vītisārimha tattha ",
  "ja456:8.3": "sāyeva no saṅgatimattamāsi ",
  "ja456:8.4": "tato na pacchā na pure ",
  "ja456:9.1": "kadāci. yadākadāci manujesu brahme ",
  "ja456:9.2": "samāgamo sappurisena hoti ",
  "ja456:9.3": "na paṇḍitā saṅgatisanthavāni ",
  "ja456:9.4": "pubbe kataṃ vāpi vināsayanti. ",
  "ja456:10.1": "bālā ca kho saṅgatisanthavāni ",
  "ja456:10.2": "pubbe kataṃ vāpi vināsayanti ",
  "ja456:10.3": "bahuṃpi bālesu kataṃ vinassati ",
  "ja456:10.4": "tathāhi bālā akataññurūpā. ",
  "ja456:11.1": "dhīrā ca kho saṅgatisanthavāni ",
  "ja456:11.2": "pubbe kataṃ vāpi na nāsayanti ",
  "ja456:11.3": "appaṃpi dhīresu kataṃ na nassati ",
  "ja456:11.4": "tathāhi dhīrā sukataññurūpā ",
  "ja456:12.1": "dadāmi te gāmavarāni pañca ",
  "ja456:12.2": "",
  "ja456:12.3": "dāsīsataṃ satta gavaṃsatāni parosahassañca suvaṇṇanikkhe ",
  "ja456:12.4": "bhariyā ca te sādisī dve dadāmi. ",
  "ja456:13.1": "evaṃ sataṃ hoti samecca rāja ",
  "ja456:13.2": "nakkhattarājāriva tārakānaṃ ",
  "ja456:13.3": "āpūratī kāsipatī yathā ahaṃ ",
  "ja456:13.4": "tayā hi me saṅgamo ajja laddhoti. ",
  "ja456:14.1": "juṇhajātakaṃ dutiyaṃ. "
}
