{
  "ja121:0.1": "13 kusanāḷivaggo ",
  "ja121:0.2": "",
  "ja121:0.3": "",
  "ja121:0.4": "1 kusanāḷijātakaṃ ",
  "ja121:1.1": "kare sarikkho athavāpi seṭṭho ",
  "ja121:1.2": "nihīnako vāpi kareyya eko ",
  "ja121:1.3": "kareyyumete byasane uttamatthaṃ ",
  "ja121:1.4": "yathā ahaṃ kusanāḷi rucāyanti. ",
  "ja121:2.1": "kusanāḷijātakaṃ paṭhamaṃ. "
}
