{
  "ja271:0.1": "3 udapānadūsakavaggo ",
  "ja271:0.2": "",
  "ja271:0.3": "",
  "ja271:0.4": "1 udapānadūsakajātakaṃ ",
  "ja271:1.1": "āraññakassa isino ",
  "ja271:1.2": "ciraṃ rattaṃ tapassino ",
  "ja271:1.3": "kicchākataṃ udapānaṃ ",
  "ja271:1.4": "kathaṃ samma apāhasi. ",
  "ja271:2.1": "esa dhammo sigālānaṃ ",
  "ja271:2.2": "yaṃ pivitvā ohadāmase ",
  "ja271:2.3": "pitupitāmahaṃ dhammo ",
  "ja271:2.4": "na taṃ ujjhātumarahasi. ",
  "ja271:3.1": "yesaṃ vo ediso dhammo ",
  "ja271:3.2": "adhammo pana kīdiso ",
  "ja271:3.3": "mā vo dhammaṃ adhammaṃ vā ",
  "ja271:3.4": "addasāma kudācananti. ",
  "ja271:4.1": "udapānadūsakajātakaṃ paṭhamaṃ. "
}
