{
  "ja411:0.1": "",
  "ja411:0.2": "",
  "ja411:0.3": "",
  "ja411:0.4": "6 susīmajātakaṃ ",
  "ja411:1.1": "kāḷāni kesāni pure ahesuṃ ",
  "ja411:1.2": "jātāni sīsamhi yathāpadese ",
  "ja411:1.3": "tānijja setāni susīma disvā ",
  "ja411:1.4": "dhammaṃ cara brahmacariyassa kālo. ",
  "ja411:2.1": "mameva deva palitaṃ na tuyhaṃ ",
  "ja411:2.2": "mameva sīsaṃ mama uttamaṅgaṃ ",
  "ja411:2.3": "atthaṃ karissanti musā abhāṇiṃ ",
  "ja411:2.4": "ekāparādhaṃ khamatha rājaseṭṭha. ",
  "ja411:3.1": "daharo tvaṃ dassanīyosi rāja ",
  "ja411:3.2": "paṭhamuggato hosi yathā kalīro ",
  "ja411:3.3": "rajjañca kārehi mamañca passa ",
  "ja411:3.4": "mā kālikaṃ anudhāvi janinda. ",
  "ja411:4.1": "passāmi vohaṃ dahariṃ kumāriṃ ",
  "ja411:4.2": "sāmaṭṭhapassaṃ sutanuṃ sumajjhaṃ ",
  "ja411:4.3": "kālappallavāva pavellamānā ",
  "ja411:4.4": "palobhayantīva naresu gacchati. ",
  "ja411:5.1": "tamena passāmi parena nāriṃ ",
  "ja411:5.2": "āsītikaṃ nāvutikañca jaccā ",
  "ja411:5.3": "daṇḍaṃ gahetvāna pavedhamānaṃ ",
  "ja411:5.4": "gopāṇasībhaggasamaṃ carantaṃ. ",
  "ja411:6.1": "sohaṃ tamevānuvicintayanto ",
  "ja411:6.2": "eko sayāmi sayanassa majjhe ",
  "ja411:6.3": "ahampi evaṃ iti pekkhamāno gehe ",
  "ja411:6.4": "na rame brahmacariyassa kālo. ",
  "ja411:7.1": "rajju vālambanī cesā ",
  "ja411:7.2": "yā gehe vasato rati ",
  "ja411:7.3": "etaṃpi chetvāna vajanti dhīrā ",
  "ja411:7.4": "anapekkhino kāmasukhaṃ pahāyāti. ",
  "ja411:8.1": "susīmajātakaṃ chaṭṭhaṃ. "
}
