  "ja492:0.1": "",
  "ja492:0.2": "",
  "ja492:0.3": "",
  "ja492:0.4": "9 tacchasūkarajātakaṃ ",
  "ja492:1.1": "yadesamānā vicarimhā ",
  "ja492:1.2": "pabbatāni vanāni ca ",
  "ja492:1.3": "anvesaṃ vipule ñātī ",
  "ja492:1.4": "teme adhigatā mayā. ",
  "ja492:2.1": "bahuṃ cidaṃ mūlaphalaṃ ",
  "ja492:2.2": "bhakkho cāyaṃ anappako ",
  "ja492:2.3": "rammā cimā girinajjo ",
  "ja492:2.4": "phāsuvāso bhavissati. ",
  "ja492:3.1": "idhevāhaṃ vasissāmi ",
  "ja492:3.2": "saha sabbehi ñātibhi ",
  "ja492:3.3": "appossukko nirāsaṅkī ",
  "ja492:3.4": "asoko akutobhayo. ",
  "ja492:4.1": "aññañhi leṇaṃ pariyesa ",
  "ja492:4.2": "sattu no idha vijjati ",
  "ja492:4.3": "so taccha sūkare hanti ",
  "ja492:4.4": "idhāgantvā varaṃ varaṃ. ",
  "ja492:5.1": "ko numhākaṃ idha sattu ",
  "ja492:5.2": "ko ñātī susamāgate ",
  "ja492:5.3": "duppadhaṃse padhaṃseti ",
  "ja492:5.4": "taṃ me akkhāhi pucchito. ",
  "ja492:6.1": "uddhaggarājī migarājā ",
  "ja492:6.2": "balī dāṭhāvudho migo ",
  "ja492:6.3": "so taccha sūkare hanti ",
  "ja492:6.4": "idhāgantvā varaṃ varaṃ. ",
  "ja492:7.1": "na no dāṭhā na vijjanti ",
  "ja492:7.2": "balaṃ kāye samohitaṃ ",
  "ja492:7.3": "sabbe samaggā hutvāna ",
  "ja492:7.4": "vasaṃ kāhāma ekakaṃ. ",
  "ja492:8.1": "hadayaṅgamaṃ kaṇṇasukhaṃ ",
  "ja492:8.2": "vācaṃ bhāsasi tacchaka ",
  "ja492:8.3": "yopi yuddhe pālayetha ",
  "ja492:8.4": "taṃpi pacchā hanāmase. ",
  "ja492:9.1": "pāṇātipātā virato nusajja ",
  "ja492:9.2": "abhayaṃ nu te sabbabhūtesu dinnaṃ ",
  "ja492:9.3": "dāṭhā nu te migaviriya na santi ",
  "ja492:9.4": "yo saṅghapatto kapaṇova jhāyasi. ",
  "ja492:10.1": "na me dāṭhā na vijjanti ",
  "ja492:10.2": "balaṃ kāye samohitaṃ ",
  "ja492:10.3": "ñātī ca disvāna samaṅgi ekato ",
  "ja492:10.4": "tasmā ca jhāyāmi vanamhi ekako. ",
  "ja492:11.1": "imassudaṃ yanti disādisaṃ pure ",
  "ja492:11.2": "bhayaṭṭitā leṇagavesino puthū ",
  "ja492:11.3": "tedāni saṅgamma vasanti ekato ",
  "ja492:11.4": "yatthaṭṭhitā duppasahajja te mayā ",
  "ja492:12.1": "pariṇāyakasampannā ",
  "ja492:12.2": "sahitā ekavādino ",
  "ja492:12.3": "te maṃ samaggā hiṃseyyuṃ ",
  "ja492:12.4": "tasmā nesaṃ na patthaye. ",
  "ja492:13.1": "ekova indo asure jināti ",
  "ja492:13.2": "ekova seno hanti dije pasayha ",
  "ja492:13.3": "ekova byaggho migasaṅghapatto ",
  "ja492:13.4": "varaṃ varaṃ hanti balañhi tādisaṃ. ",
  "ja492:14.1": "naheva indo na seno ",
  "ja492:14.2": "napi byaggho migādhipo ",
  "ja492:14.3": "samagge sahite ñātī byaggho ",
  "ja492:14.4": "na kurute vase. ",
  "ja492:15.1": "kumbhilakā sakuṇikā ",
  "ja492:15.2": "saṅghino gaṇacārino ",
  "ja492:15.3": "sammodamānā ekajjhaṃ ",
  "ja492:15.4": "uppatanti uyyanti ca. ",
  "ja492:16.1": "tesañca ḍiyamānānaṃ ",
  "ja492:16.2": "ekettha apasakkati ",
  "ja492:16.3": "tañca seno nitāleti ",
  "ja492:16.4": "veyyagghiyeva sā gati. ",
  "ja492:17.1": "ussāhito jaṭilena ",
  "ja492:17.2": "luddenāmisacakkhunā ",
  "ja492:17.3": "dāṭhī dāṭhīsu pakkhandi ",
  "ja492:17.4": "maññamāno yathā pure. ",
  "ja492:18.1": "sādhu sambahulā ñātī ",
  "ja492:18.2": "api rukkhā araññajā ",
  "ja492:18.3": "sūkarehi samaggehi ",
  "ja492:18.4": "byaggho ekāyane hato. ",
  "ja492:19.1": "brāhmaṇañceva byagghañca ",
  "ja492:19.2": "ubho hantvāna sūkarā ",
  "ja492:19.3": "ānandino pamoditā ",
  "ja492:19.4": "mahānādamanādisuṃ. ",
  "ja492:20.1": "te sudumbaramūlasmiṃ ",
  "ja492:20.2": "sūkarā susamāgatā ",
  "ja492:20.3": "tacchakaṃ abhisiñciṃsu ",
  "ja492:20.4": "tvaṃ no rājāsi issaroti. ",
  "ja492:21.1": "tacchasūkarajātakaṃ navamaṃ. "
}
