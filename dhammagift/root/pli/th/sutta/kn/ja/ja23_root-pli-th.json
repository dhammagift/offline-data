  "ja23:0.4": "3 bhojājānīyajātakaṃ ",
  "ja23:1.1": "api passena semāno ",
  "ja23:1.2": "sallebhi sallalīkato ",
  "ja23:1.3": "seyyova vaḷavā bhojjho ",
  "ja23:1.4": "yuñja maññeva sārathīti. ",
  "ja23:2.1": "bhojājānīyajātakaṃ tatiyaṃ. "
}
