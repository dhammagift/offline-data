  "ja96:0.4": "6 telapattajātakaṃ ",
  "ja96:1.1": "samatittikaṃ anavasekaṃ ",
  "ja96:1.2": "telapattaṃ yathā parihareyya ",
  "ja96:1.3": "evaṃ sacittamanurakkhe (satiyā) ",
  "ja96:1.4": "patthayāno disaṃ agatapubbanti. ",
  "ja96:2.1": "telapattajātakaṃ chaṭṭhaṃ. "
}
