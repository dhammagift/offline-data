{
  "ja342:0.1": "",
  "ja342:0.2": "",
  "ja342:0.3": "",
  "ja342:0.4": "2 vānarajātakaṃ ",
  "ja342:1.1": "asakkhiṃ vata attānaṃ ",
  "ja342:1.2": "uṭṭhātuṃ udakā thalaṃ ",
  "ja342:1.3": "nadānāhaṃ puna tuyhaṃ ",
  "ja342:1.4": "vasaṃ gacchāmi vārija. ",
  "ja342:2.1": "alametehi ambehi ",
  "ja342:2.2": "jambūhi panasehi ca ",
  "ja342:2.3": "yāni pāraṃ samuddassa ",
  "ja342:2.4": "varaṃ mayhaṃ udumbaro. ",
  "ja342:3.1": "yo ca uppatitaṃ atthaṃ ",
  "ja342:3.2": "na khippamanubujjhati ",
  "ja342:3.3": "amittavasamanveti ",
  "ja342:3.4": "pacchā ca anutappati. ",
  "ja342:4.1": "yo ca uppatitaṃ atthaṃ ",
  "ja342:4.2": "khippameva nibodhati ",
  "ja342:4.3": "muccate sattusambādhā ",
  "ja342:4.4": "na ca pacchānutappatīti. ",
  "ja342:5.1": "vānarajātakaṃ dutiyaṃ. "
}
