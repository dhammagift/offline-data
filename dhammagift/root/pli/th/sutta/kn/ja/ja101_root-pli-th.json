  "ja101:0.3": "11 parosatavaggo ",
  "ja101:0.4": "1 parosatajātakaṃ ",
  "ja101:1.1": "parosataṃ vepi samāgatānaṃ ",
  "ja101:1.2": "jhāyeyyu te vassasataṃ apaññā ",
  "ja101:1.3": "ekova seyyo puriso sapañño ",
  "ja101:1.4": "yo bhāsitassa vijānāti atthanti. ",
  "ja101:2.1": "parosatajātakaṃ paṭhamaṃ. "
}
