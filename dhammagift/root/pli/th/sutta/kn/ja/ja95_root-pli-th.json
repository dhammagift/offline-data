  "ja95:0.4": "5 mahāsudassanajātakaṃ ",
  "ja95:1.1": "aniccā vata saṅkhārā ",
  "ja95:1.2": "uppādavayadhammino ",
  "ja95:1.3": "uppajjitvā nirujjhanti ",
  "ja95:1.4": "tesaṃ vūpasamo sukhoti. ",
  "ja95:2.1": "mahāsudassanajātakaṃ pañcamaṃ. "
}
