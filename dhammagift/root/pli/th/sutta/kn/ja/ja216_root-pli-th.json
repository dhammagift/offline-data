  "ja216:0.4": "6 macchajātakaṃ ",
  "ja216:1.1": "na māyamaggi tapati ",
  "ja216:1.2": "na sūlo sādhu tacchito ",
  "ja216:1.3": "yañca maṃ maññate macchī ",
  "ja216:1.4": "aññaṃ so ratiyā gato. ",
  "ja216:2.1": "so maṃ dahati rāgaggi ",
  "ja216:2.2": "cittañcūpatapeti maṃ ",
  "ja216:2.3": "jālino muñcathayirā maṃ ",
  "ja216:2.4": "na kāme haññate kvacīti. ",
  "ja216:3.1": "macchajātakaṃ chaṭṭhaṃ. "
}
