  "ja158:0.3": "",
  "ja158:0.4": "8 suhanujātakaṃ ",
  "ja158:1.1": "nayidaṃ visamasīlena ",
  "ja158:1.2": "soṇena suhanussaha ",
  "ja158:1.3": "suhanupi tādisoyeva ",
  "ja158:1.4": "yo soṇassa sa gocaro. ",
  "ja158:2.1": "pakkhandinā pagabbhena ",
  "ja158:2.2": "niccaṃ sandānakhādinā ",
  "ja158:2.3": "sameti pāpaṃ pāpena ",
  "ja158:2.4": "sameti asatāsatanti. ",
  "ja158:3.1": "suhanujātakaṃ aṭṭhamaṃ. "
}
