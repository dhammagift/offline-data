{
  "ja171:0.1": "3 kalyāṇadhammavaggo ",
  "ja171:0.2": "",
  "ja171:0.3": "",
  "ja171:0.4": "1 kalyāṇadhammajātakaṃ ",
  "ja171:1.1": "kalyāṇadhammoti yadā janinda ",
  "ja171:1.2": "loke samaññaṃ anupāpuṇāti ",
  "ja171:1.3": "tasmā na hiyyetha naro sapañño ",
  "ja171:1.4": "hiriyāpi santo dhuramādiyanti. ",
  "ja171:2.1": "sāyaṃ samaññā idha majja pattā ",
  "ja171:2.2": "kalyāṇadhammoti janinda loke ",
  "ja171:2.3": "tāhaṃ samekkhaṃ idha pabbajissaṃ ",
  "ja171:2.4": "na hi matthi chando idha kāmabhogeti. ",
  "ja171:3.1": "kalyāṇadhammajātakaṃ paṭhamaṃ. "
}
