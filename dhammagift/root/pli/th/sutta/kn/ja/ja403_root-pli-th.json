  "ja403:0.3": "",
  "ja403:0.4": "8 aṭṭhisenajātakaṃ ",
  "ja403:1.1": "yeme ahaṃ na jānāmi ",
  "ja403:1.2": "aṭṭhisena vanibbake ",
  "ja403:1.3": "te maṃ saṅgamma yācanti ",
  "ja403:1.4": "kasmā maṃ tvaṃ na yācasi. ",
  "ja403:2.1": "yācako appiyo hoti ",
  "ja403:2.2": "yācaṃ adadamappiyo ",
  "ja403:2.3": "tasmāhantaṃ na yācāmi ",
  "ja403:2.4": "mā me viddessanā ahu. ",
  "ja403:3.1": "yo ca yācanajīvāno ",
  "ja403:3.2": "kāle yācaṃ na yācati ",
  "ja403:3.3": "parañca puññaṃ dhaṃseti ",
  "ja403:3.4": "attanāpi na jīvati. ",
  "ja403:4.1": "yo ca yācanajīvāno ",
  "ja403:4.2": "kāle yācaṃpi yācati ",
  "ja403:4.3": "parañca puññaṃ labbheti ",
  "ja403:4.4": "attanāpi ca jīvati. ",
  "ja403:5.1": "na ve dussanti sappaññā ",
  "ja403:5.2": "disvā yācakamāgate ",
  "ja403:5.3": "brahmacārī piyo mesi ",
  "ja403:5.4": "vara bhaññitamicchasi. ",
  "ja403:6.1": "na ve yācanti sappaññā ",
  "ja403:6.2": "dhīro ca viditumarahati ",
  "ja403:6.3": "uddissa ariyā tiṭṭhanti ",
  "ja403:6.4": "esā ariyāna yācanā. ",
  "ja403:7.1": "dadāmi te brāhmaṇa rohiṇīnaṃ ",
  "ja403:7.2": "gavaṃ sahassaṃ saha puṅgavena ",
  "ja403:7.3": "ariyo hi ariyassa kathaṃ na dajjā ",
  "ja403:7.4": "sutvāna gāthā tava dhammayuttāti. ",
  "ja403:8.1": "aṭṭhisenajātakaṃ aṭṭhamaṃ. "
}
