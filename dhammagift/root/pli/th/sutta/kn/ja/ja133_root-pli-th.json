  "ja133:0.4": "3 ghatāsanajātakaṃ ",
  "ja133:1.1": "khemaṃ yahiṃ tattha arī udīrito ",
  "ja133:1.2": "dakassa majjhe jalate ghatāsano ",
  "ja133:1.3": "na ajja vāso mahiyā mahīruhe ",
  "ja133:1.4": "disā bhajavho saraṇajja no bhayanti. ",
  "ja133:2.1": "ghatāsanajātakaṃ tatiyaṃ. "
}
