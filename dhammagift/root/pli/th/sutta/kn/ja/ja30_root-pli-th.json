  "ja30:0.3": "",
  "ja30:0.4": "10 muṇikajātakaṃ ",
  "ja30:1.1": "mā muṇikassa pihayi ",
  "ja30:1.2": "āturannāni bhuñjati ",
  "ja30:1.3": "appossukko bhusaṅkhāda ",
  "ja30:1.4": "etaṃ dīghāyulakkhaṇanti. ",
  "ja30:2.1": "muṇikajātakaṃ dasamaṃ. ",
  "ja30:2.2": "kuruṅgavaggo tatiyo. ",
  "ja30:3.1": "tassuddānaṃ. ",
  "ja30:4.1": "kuruṅgassa kukkura bhojavaro ",
  "ja30:4.2": "puna vāḷavassasirivayano ",
  "ja30:4.3": "mahiḷāmukha ",
  "ja30:4.4": "vahate dhura muṇikena dasa. "
}
