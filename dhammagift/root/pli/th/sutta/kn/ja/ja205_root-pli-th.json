  "ja205:0.3": "",
  "ja205:0.4": "5 gaṅgeyyajātakaṃ ",
  "ja205:1.1": "sobhanti macchā gaṅgeyyā ",
  "ja205:1.2": "atho sobhanti yāmunā ",
  "ja205:1.3": "catuppadāyaṃ puriso ",
  "ja205:1.4": "nigrodhaparimaṇḍalo ",
  "ja205:1.5": "īsakāyatagīvo ca ",
  "ja205:1.6": "sabbeva atirocati. ",
  "ja205:2.1": "yaṃ pucchito na taṃ akkhā ",
  "ja205:2.2": "aññaṃ akkhāti pucchito ",
  "ja205:2.3": "attappasaṃsako poso ",
  "ja205:2.4": "nāyaṃ asmāka ruccatīti. ",
  "ja205:3.1": "gaṅgeyyajātakaṃ pañcamaṃ. "
}
