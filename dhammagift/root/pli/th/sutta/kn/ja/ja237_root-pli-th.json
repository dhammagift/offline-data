  "ja237:0.3": "",
  "ja237:0.4": "7 sāketajātakaṃ ",
  "ja237:1.1": "ko nu kho bhagavā hetu ",
  "ja237:1.2": "ekacce idha puggale ",
  "ja237:1.3": "atīva hadayaṃ nibbāti ",
  "ja237:1.4": "cittañcāpi pasīdati. ",
  "ja237:2.1": "pubbeva sannivāsena ",
  "ja237:2.2": "paccuppannahitena vā ",
  "ja237:2.3": "evantaṃ jāyate pemaṃ ",
  "ja237:2.4": "uppalaṃva yathodaketi. ",
  "ja237:3.1": "sāketajātakaṃ sattamaṃ. "
}
