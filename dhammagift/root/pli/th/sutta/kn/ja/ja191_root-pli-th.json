{
  "ja191:0.1": "5 ruhakavaggo ",
  "ja191:0.2": "",
  "ja191:0.3": "",
  "ja191:0.4": "1 ruhakajātakaṃ ",
  "ja191:1.1": "ambho ruhaka chinnāpi ",
  "ja191:1.2": "jiyā sandhiyyate puna ",
  "ja191:1.3": "sandhiyassu purāṇiyā ",
  "ja191:1.4": "mā kodhassa vasaṃ gami. ",
  "ja191:2.1": "vijjamānesu (mudu) vākesu ",
  "ja191:2.2": "vijjamānesu kārisu ",
  "ja191:2.3": "aññaṃ jiyaṃ karissāmi ",
  "ja191:2.4": "alaññeva purāṇiyāti. ",
  "ja191:3.1": "ruhakajātakaṃ paṭhamaṃ. "
}
