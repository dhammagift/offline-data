  "ja222:0.1": "",
  "ja222:0.2": "",
  "ja222:0.3": "",
  "ja222:0.4": "2 cullanandiyajātakaṃ ",
  "ja222:1.1": "idaṃ tadācariyavaco ",
  "ja222:1.2": "pārāsariyo yadābravi ",
  "ja222:1.3": "mā su tvaṃ akari pāpaṃ ",
  "ja222:1.4": "yaṃ tvaṃ pacchā katantape. ",
  "ja222:2.1": "yāni karoti puriso ",
  "ja222:2.2": "tāni attani passati ",
  "ja222:2.3": "kalyāṇakārī kalyāṇaṃ ",
  "ja222:2.4": "pāpakārī ca pāpakaṃ ",
  "ja222:2.5": "yādisaṃ vapate bījaṃ ",
  "ja222:2.6": "tādisaṃ harate phalanti. ",
  "ja222:3.1": "cullanandiyajātakaṃ dutiyaṃ. "
}
