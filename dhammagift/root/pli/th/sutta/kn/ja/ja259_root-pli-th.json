  "ja259:0.3": "",
  "ja259:0.4": "9 tiritivacchajātakaṃ ",
  "ja259:1.1": "nayimassa vijjāmayamatthi kiñci ",
  "ja259:1.2": "na bandhavo no pana te sahāyo ",
  "ja259:1.3": "atha kena vaṇṇena tirītivaccho ",
  "ja259:1.4": "tedaṇḍiko bhuñjati aggapiṇḍaṃ. ",
  "ja259:2.1": "āpāsu me yuddhaparājitassa ",
  "ja259:2.2": "ekassa katvā vivanasmi ghore ",
  "ja259:2.3": "pasārayi kicchagatassa pāṇiṃ ",
  "ja259:2.4": "tenuddhatāriṃ dukhasampareto. ",
  "ja259:3.1": "etassa kicchena idhānupatto ",
  "ja259:3.2": "veyyāsino vīsaya jīvaloke ",
  "ja259:3.3": "lābhāraho tāta tirītivaccho ",
  "ja259:3.4": "dethassa bhogaṃ yajitañca yaññanti. ",
  "ja259:4.1": "tiritivacchajātakaṃ navamaṃ. "
}
