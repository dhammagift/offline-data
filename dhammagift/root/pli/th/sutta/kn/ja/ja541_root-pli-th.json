  "ja541:75.4": "jānaṃ akkhāsijānato. ",
  "ja541:76.1": "kolitthiyāyo idha jīvaloke ",
  "ja541:76.2": "asuddhakammā asataṃ acāruṃ ",
  "ja541:76.3": "tā dittarūpā pati vippahāya ",
  "ja541:76.4": "aññaṃ acāruṃ ratikhiḍḍahetu ",
  "ja541:76.5": "tā jīvalokasmiṃ ramāpayitvā ",
  "ja541:76.6": "khandhātivattanti sajotibhūtā. ",
  "ja541:77.1": "pāde gahetvā kissime puneke ",
  "ja541:77.2": "avaṃsirā narake pātayanti ",
  "ja541:77.3": "bhayaṃ hi maṃ vindati sūta disvā ",
  "ja541:77.4": "pucchāmi taṃ mātali devasārathi ",
  "ja541:77.5": "ime nu maccā kimakaṃsu pāpaṃ ",
  "ja541:77.6": "yeme janā (avaṃsirā) narake pātayanti. ",
  "ja541:78.1": "tassa puṭṭho viyākāsi ",
  "ja541:78.2": "mātali devasārathi ",
  "ja541:78.3": "vipākaṃ pāpakammānaṃ ",
  "ja541:78.4": "jānaṃ akkhāsijānato. ",
  "ja541:79.1": "ye jīvalokasmiṃ asādhukammino ",
  "ja541:79.2": "parassa dārāni atikkamanti ",
  "ja541:79.3": "te tādisā uttamabhaṇḍathenā ",
  "ja541:79.4": "teme janā (avaṃsirā) narake pātayanti. ",
  "ja541:80.1": "te vassapūgāni bahūni tattha ",
  "ja541:80.2": "nirayesu dukkhaṃ vedanaṃ vedayanti ",
  "ja541:80.3": "na hi pāpakārissa bhavanti tāṇā ",
  "ja541:80.4": "sakehi kammehi purakkhitassa ",
  "ja541:80.5": "te luddakammā pasavetva pāpaṃ ",
  "ja541:80.6": "teme janā (avaṃsirā) narake pātayanti. ",
  "ja541:81.1": "uccāvacāme vividhā upakkamā ",
  "ja541:81.2": "nirayesu dissanti sughorarūpā ",
  "ja541:81.3": "bhayaṃ hi maṃ vindati sūta disvā ",
  "ja541:81.4": "pucchāmi taṃ mātali devasārathi ",
  "ja541:81.5": "ime nu maccā kimakaṃsu pāpaṃ ",
  "ja541:81.6": "yeme janā adhimattā dukkhā tippā ",
  "ja541:81.7": "kharā kaṭukā vedanā vedayanti. ",
  "ja541:82.1": "tassa puṭṭho viyākāsi ",
  "ja541:82.2": "mātali devasārathi ",
  "ja541:82.3": "vipākaṃ pāpakammānaṃ ",
  "ja541:82.4": "jānaṃ akkhāsijānato. ",
  "ja541:83.1": "ye jīvalokasmiṃ supāpadiṭṭhino ",
  "ja541:83.2": "vissāsakammāni karonti mohā ",
  "ja541:83.3": "parañca diṭṭhīsu samādapenti ",
  "ja541:83.4": "te pāpadiṭṭhī pasavetva pāpaṃ ",
  "ja541:83.5": "teme janā adhimattā dukkhā tippā ",
  "ja541:83.6": "kharā kaṭukā vedanā vedayanti. ",
  "ja541:84.1": "viditāni te mahārāja ",
  "ja541:84.2": "āvāsaṃ pāpakamminaṃ ",
  "ja541:84.3": "ṭhānāni luddakammānaṃ ",
  "ja541:84.4": "dussīlānañca yā gati ",
  "ja541:84.5": "uyyāhidāni rājisi ",
  "ja541:84.6": "devarājassa santike. ",
  "ja541:85.1": "",
  "ja541:86.1": "pañcathūpaṃ dissatidaṃ vimānaṃ ",
  "ja541:86.2": "mālāpilandhā sayanassa majjhe ",
  "ja541:86.3": "tatthacchatī nāri mahānubhāvā ",
  "ja541:86.4": "uccāvacaṃ iddhi vikubbamānā ",
  "ja541:87.1": "vittī hi maṃ vindati sūta disvā ",
  "ja541:87.2": "pucchāmi taṃ mātali devasārathi ",
  "ja541:87.3": "ayaṃ nu nārī kimakāsi sādhuṃ ",
  "ja541:87.4": "yā modatī saggappattā vimāne. ",
  "ja541:88.1": "tassa puṭṭho viyākāsi ",
  "ja541:88.2": "mātali devasārathi ",
  "ja541:88.3": "vipākaṃ puññakammānaṃ ",
  "ja541:88.4": "jānaṃ akkhāsijānato. ",
  "ja541:89.1": "yadi te sutā biraṇī jīvaloke ",
  "ja541:89.2": "āmāyadāsī ahu brāhmaṇassa ",
  "ja541:89.3": "sā pattakālaṃ atithiṃ viditvā ",
  "ja541:89.4": "mātāva puttaṃ sakimābhinandī ",
  "ja541:89.5": "saññamā saṃvibhāgā ca ",
  "ja541:89.6": "sā vimānasmi modati. ",
  "ja541:90.1": "daddallamānā ābhanti ",
  "ja541:90.2": "vimānā satta nimmitā ",
  "ja541:90.3": "tattha yakkho mahiddhiko ",
  "ja541:90.4": "sabbābharaṇabhūsito ",
  "ja541:90.5": "samantā anupariyāyati ",
  "ja541:90.6": "nārīgaṇapurakkhito. ",
  "ja541:91.1": "vittī hi maṃ vindati sūta disvā ",
  "ja541:91.2": "pucchāmi taṃ mātali devasārathi ",
  "ja541:91.3": "ayaṃ nu macco kimakāsi sādhuṃ ",
  "ja541:91.4": "yo modati saggappatto vimāne. ",
