  "ja174:0.3": "",
  "ja174:0.4": "4 dubbhiyamakkaṭajātakaṃ ",
  "ja174:1.1": "adamha te vāri bahuttarūpaṃ ",
  "ja174:1.2": "ghammābhitattassa pipāsitassa ",
  "ja174:1.3": "sodāni pitvāna kikiṃ karosi ",
  "ja174:1.4": "na saṅgamo pāpajanena seyyo. ",
  "ja174:2.1": "ko te suto vā diṭṭho vā ",
  "ja174:2.2": "sīlavā nāma makkaṭo ",
  "ja174:2.3": "idāni kho taṃ ohaccaṃ ",
  "ja174:2.4": "esā asmākadhammatāti. ",
  "ja174:3.1": "dubbhiyamakkaṭajātakaṃ catutthaṃ. 5 ādiccupaṭṭhānajātakaṃ. "
}
