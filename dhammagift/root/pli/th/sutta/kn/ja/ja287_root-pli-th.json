  "ja287:0.3": "",
  "ja287:0.4": "7 lābhagarahikajātakaṃ ",
  "ja287:1.1": "nānummatto nāpisuṇo ",
  "ja287:1.2": "nānaṭo nākutūhalo ",
  "ja287:1.3": "muḷhesu labhate lābhaṃ ",
  "ja287:1.4": "esā te anusāsanī. ",
  "ja287:2.1": "dhiratthu taṃ yasalābhaṃ ",
  "ja287:2.2": "dhanalābhañca brāhmaṇa ",
  "ja287:2.3": "yā vutti vinipātena ",
  "ja287:2.4": "adhammacariyāya vā. ",
  "ja287:3.1": "api ce pattamādāya ",
  "ja287:3.2": "anāgāro paribbaje ",
  "ja287:3.3": "esāva jīvikā seyyo ",
  "ja287:3.4": "yā cādhammena esanāti. ",
  "ja287:4.1": "lābhagarahikajātakaṃ sattamaṃ. "
}
