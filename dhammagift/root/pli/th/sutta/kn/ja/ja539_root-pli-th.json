  "ja539:154.5": "phalī ambo aphalo ca ",
  "ja539:154.6": "te satthāro ubho mama. ",
  "ja539:155.1": "sabbo jano sabyādhito ",
  "ja539:155.2": "rājā pabbajito iti ",
  "ja539:155.3": "hatthārohā anīkaṭṭhā ",
  "ja539:155.4": "rathikā pattikārakā ",
  "ja539:156.1": "assāsayitvā janataṃ ",
  "ja539:156.2": "ṭhapayitvā paṭicchadaṃ ",
  "ja539:156.3": "puttaṃ rajje ṭhapetvāna ",
  "ja539:156.4": "atha pacchā pabbajissasi. ",
  "ja539:157.1": "cattā mayā jānapadā ",
  "ja539:157.2": "mittāmaccā ca ñātakā ",
  "ja539:157.3": "santi puttā videhānaṃ ",
  "ja539:157.4": "dīghāvu raṭṭhavaḍḍhano ",
  "ja539:157.5": "te rajjaṃ kārayissanti ",
  "ja539:157.6": "mithilāyaṃ pajāpati. ",
  "ja539:158.1": "ehi taṃ anusikkhāmi ",
  "ja539:158.2": "yaṃ vākyaṃ mama ruccati ",
  "ja539:158.3": "rajjaṃ tuvaṃ kārayantī ",
  "ja539:158.4": "pāpaṃ duccaritaṃ bahuṃ ",
  "ja539:158.5": "kāyena vācā manasā ",
  "ja539:158.6": "yena gacchasi duggatiṃ ",
  "ja539:159.1": "paradinnakena paraniṭṭhitena ",
  "ja539:159.2": "piṇḍena yāpeti 4 sa dhīradhammo. ",
  "ja539:160.1": "yopi catutthe bhattakāle na bhuñje ",
  "ja539:160.2": "ajjhuṭṭhamāriva khudāya miyye ",
  "ja539:160.3": "na tveva piṇḍaṃ lulitaṃ anariyaṃ ",
  "ja539:160.4": "kulaputtarūpo sappuriso nu seve ",
  "ja539:160.5": "tayidaṃ na sādhu tayidaṃ na suṭṭhu ",
  "ja539:160.6": "sunakhucchiṭṭhakaṃ janaka bhuñjase tuvaṃ. ",
  "ja539:161.1": "na cāpi me sīvali so abhakkho ",
  "ja539:161.2": "yaṃ hoti cattaṃ gihino sunakhassa vā ",
  "ja539:161.3": "yekeci bhogā idha dhammaladdhā ",
  "ja539:161.4": "sabbo so bhakkho anavayoti vutto. ",
  "ja539:162.1": "kumārike upaseniye ",
  "ja539:162.2": "niccaṃ niggalamaṇḍite ",
  "ja539:162.3": "kasmā te eko bhujo janati ",
  "ja539:162.4": "eko te na janatī bhujo. ",
  "ja539:163.1": "imasmiṃ me samaṇa hatthe ",
  "ja539:163.2": "paṭimukkā dunīvarā ",
  "ja539:163.3": "saṅghaṭṭā jāyate saddo ",
  "ja539:163.4": "dutiyasseva sā gati ",
  "ja539:164.1": "imasmiṃ me samaṇa hatthe ",
  "ja539:164.2": "paṭimukko ekanīvaro ",
  "ja539:164.3": "so adutiyo na janati ",
  "ja539:164.4": "munibhūtova tiṭṭhati ",
  "ja539:165.1": "vivādappatto dutiyo ",
  "ja539:165.2": "keneko vivadissati ",
  "ja539:165.3": "tassa te saggakāmassa ",
  "ja539:165.4": "ekattamuparocataṃ. ",
  "ja539:166.1": "suṇasi sīvalī gāthā ",
  "ja539:166.2": "kumāriyā paveditā ",
  "ja539:166.3": "pesiyā maṃ garahittho ",
  "ja539:166.4": "dutiyasseva sā gati ",
  "ja539:167.1": "ayaṃ dvedhā patho bhadde ",
  "ja539:167.2": "anuciṇṇo pathāvihi ",
  "ja539:167.3": "tesaṃ tvaṃ ekaṃ gaṇhāhi ",
  "ja539:167.4": "ahamekaṃ punāparaṃ ",
  "ja539:168.1": "mā ca maṃ tvaṃ pati meti ",
  "ja539:168.2": "nāhaṃ bhariyāti taṃ puna. ",
  "ja539:168.3": "imameva kathayantā ",
  "ja539:168.4": "thūṇaṃ nagaramupāgamuṃ. ",
  "ja539:169.1": "koṭṭhake usukārassa ",
  "ja539:169.2": "bhattakāle upaṭṭhite ",
  "ja539:169.3": "tatra ca so usukāro ",
  "ja539:169.4": "ekaṃ daṇḍaṃ ujuṃ kataṃ ",
  "ja539:169.5": "ekañca cakkhuṃ niggayha ",
  "ja539:169.6": "jimhamekena pekkhati. ",
  "ja539:170.1": "evanno sādhu passasi ",
  "ja539:170.2": "usukāra suṇohi me ",
  "ja539:170.3": "yadekaṃ cakkhuṃ niggayha ",
  "ja539:170.4": "jimhamekena pekkhasi. ",
  "ja539:171.1": "dvīhi samaṇa cakkhūhi ",
  "ja539:171.2": "visālaṃ viya khāyati ",
  "ja539:171.3": "appatvā paramaṃ liṅgaṃ ",
  "ja539:171.4": "nujubhāvāya kappati. ",
  "ja539:172.1": "ekañca cakkhuṃ niggayha ",
  "ja539:172.2": "jimhamekena pekkhato ",
  "ja539:172.3": "sampatvā paramaṃ liṅgaṃ ",
  "ja539:172.4": "ujubhāvāya kappati. ",
  "ja539:173.1": "vivādappatto dutiyo ",
  "ja539:173.2": "keneko vivadissati ",
  "ja539:173.3": "tassa te saggakāmassa ",
  "ja539:173.4": "ekattamuparocataṃ. ",
  "ja539:174.1": "suṇasi sīvalī gāthā ",
  "ja539:174.2": "usukārena veditā ",
  "ja539:174.3": "pesiyā maṃ garahittho ",
  "ja539:174.4": "dutiyasseva sā gati ",
  "ja539:175.1": "ayaṃ dvedhā patho bhadde ",
  "ja539:175.2": "anuciṇṇo pathāvihi ",
  "ja539:175.3": "tesaṃ tvaṃ ekaṃ gaṇhāhi ",
  "ja539:175.4": "ahamekaṃ punāparaṃ ",
  "ja539:176.1": "neva maṃ tvaṃ pati meti ",
  "ja539:176.2": "nāhaṃ bhariyāti taṃ puna ",
  "ja539:176.3": "muñjā isakā pabyūḷhā ",
  "ja539:176.4": "ekā vihara sīvalīti. ",
  "ja539:177.1": "mahājanakajātakaṃ dutiyaṃ. "
}
