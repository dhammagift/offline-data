{
  "ja131:0.1": "14 asampadānavaggo ",
  "ja131:0.2": "",
  "ja131:0.3": "",
  "ja131:0.4": "1 asampadānajātakaṃ ",
  "ja131:1.1": "asampadānenitarītarassa ",
  "ja131:1.2": "bālassa mittāni kalī bhavanti ",
  "ja131:1.3": "tasmā harāmi bhusamaḍḍhamānaṃ ",
  "ja131:1.4": "mā me mitti bhijjittha sassatāyanti. ",
  "ja131:2.1": "asampadānajātakaṃ paṭhamaṃ. "
}
