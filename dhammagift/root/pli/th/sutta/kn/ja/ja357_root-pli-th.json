  "ja357:0.3": "",
  "ja357:0.4": "7 laṭukikajātakaṃ ",
  "ja357:1.1": "vandāmi taṃ kuñjaraṃ saṭṭhihāyanaṃ ",
  "ja357:1.2": "āraññakaṃ yūthapatiṃ yasassiṃ ",
  "ja357:1.3": "pakkhehi taṃ pañjalikaṃ karomi ",
  "ja357:1.4": "mā me vadhi puttake dubbalāya. ",
  "ja357:2.1": "vandāmi taṃ kuñjaraṃ ekacāriṃ ",
  "ja357:2.2": "āraññakaṃ pabbatasānugocaraṃ ",
  "ja357:2.3": "pakkhehi taṃ pañjalikaṃ karomi ",
  "ja357:2.4": "mā me vadhi puttake dubbalāya. ",
  "ja357:3.1": "vadhissāmi te laṭukike puttakāni ",
  "ja357:3.2": "kiṃ me tvaṃ kāhasi dubbalāsi ",
  "ja357:3.3": "satasahassānipi tādisīnaṃ ",
  "ja357:3.4": "vāmena pādena pappothayeyyaṃ. ",
  "ja357:4.1": "naheva sabbattha balena kiccaṃ ",
  "ja357:4.2": "balaṃ hi bālassa vadhāya hoti ",
  "ja357:4.3": "karissāmi te nāgarāja anatthaṃ ",
  "ja357:4.4": "yo me vadhi puttake dubbalāya. ",
  "ja357:5.1": "kākañca passa laṭukikaṃ ",
  "ja357:5.2": "maṇḍūkaṃ nīlamakkhikaṃ ",
  "ja357:5.3": "ete nāgaṃ aghātesuṃ ",
  "ja357:5.4": "passa verassa verinaṃ ",
  "ja357:5.5": "tasmā hi veraṃ na kayirātha ",
  "ja357:5.6": "appiyenapi kenacīti. ",
  "ja357:6.1": "laṭukikajātakaṃ sattamaṃ. "
}
