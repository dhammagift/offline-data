  "ja59:0.4": "9 bherivādajātakaṃ ",
  "ja59:1.1": "dhame dhame nātidhame ",
  "ja59:1.2": "atidhantaṃ hi pāpakaṃ ",
  "ja59:1.3": "dhamantena sataṃ laddhaṃ ",
  "ja59:1.4": "atidhantena nāsitanti. ",
  "ja59:2.1": "bherivādajātakaṃ navamaṃ. "
}
