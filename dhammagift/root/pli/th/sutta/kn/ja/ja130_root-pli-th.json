  "ja130:0.3": "",
  "ja130:0.4": "10 kosiyajātakaṃ ",
  "ja130:1.1": "yathā vācā ca bhuñjassu ",
  "ja130:1.2": "yathā bhuttañca byāhara ",
  "ja130:1.3": "ubhayante na sameti ",
  "ja130:1.4": "vācā bhuttañca kosiyeti. ",
  "ja130:2.1": "kosiyajātakaṃ dasamaṃ. ",
  "ja130:2.2": "kusanāḷivaggo terasamo. ",
  "ja130:3.1": "tassuddānaṃ. ",
  "ja130:4.1": "kusanāḷisirivhayano ca yasaṃ ",
  "ja130:4.2": "dadhi mamba kaṭāhaka pañcamako ",
  "ja130:4.3": "atha pāpa sakhira biḷāravataṃ ",
  "ja130:4.4": "sikhi kosiya savhayanena dasa. "
}
