{
  "ja21:0.1": "3 kuruṅgavaggo ",
  "ja21:0.2": "",
  "ja21:0.3": "",
  "ja21:0.4": "1 kuruṅgamigajātakaṃ ",
  "ja21:1.1": "ñātametaṃ kuruṅgassa ",
  "ja21:1.2": "yaṃ tvaṃ sepaṇṇi seyyasi ",
  "ja21:1.3": "aññaṃ sepaṇṇiṃ gacchāmi ",
  "ja21:1.4": "na me te ruccate phalanti. ",
  "ja21:2.1": "kuruṅgamigajātakaṃ paṭhamaṃ. "
}
