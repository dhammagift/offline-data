  "ja503:0.1": "",
  "ja503:0.2": "",
  "ja503:0.3": "",
  "ja503:0.4": "7 sattigumbajātakaṃ ",
  "ja503:1.1": "migaluddo mahārājā ",
  "ja503:1.2": "pañcālānaṃ rathesako ",
  "ja503:1.3": "nikkhanto saha senāya ",
  "ja503:1.4": "ogaṇo vanamāgamā. ",
  "ja503:2.1": "tatthaddasa araññasmiṃ ",
  "ja503:2.2": "takkarānaṃ kuṭiṃkataṃ ",
  "ja503:2.3": "tasmā kuṭiyā nikkhamma ",
  "ja503:2.4": "suvo luddāni bhāsati. ",
  "ja503:3.1": "sampannavāhano poso ",
  "ja503:3.2": "yuvā sammaṭṭhakuṇḍalī ",
  "ja503:3.3": "sobhati lohituṇhīso ",
  "ja503:3.4": "divā suriyova bhāsati. ",
  "ja503:4.1": "majjhantike sampatike ",
  "ja503:4.2": "sutto rājā sasārathi ",
  "ja503:4.3": "handassābharaṇaṃ sabbaṃ ",
  "ja503:4.4": "gaṇhāma sahasā mayaṃ. ",
  "ja503:5.1": "nissivepi rahodāni ",
  "ja503:5.2": "sutto rājā sasārathi ",
  "ja503:5.3": "ādāya vatthaṃ maṇikuṇḍalañca ",
  "ja503:5.4": "hantvāna sākhāhi avattharāma. ",
  "ja503:6.1": "kinnu ummattarūpova ",
  "ja503:6.2": "sattigumba pabhāsasi ",
  "ja503:6.3": "durāsadā hi rājāno ",
  "ja503:6.4": "aggi pajjalito yathā. ",
  "ja503:7.1": "atha tvaṃ patikolumba ",
  "ja503:7.2": "matto thullāni gajjasi ",
  "ja503:7.3": "mātari mayha naggāya ",
  "ja503:7.4": "kiṃ nu tvaṃ vijigucchase. ",
  "ja503:8.1": "uṭṭhehi samma taramāno ",
  "ja503:8.2": "rathaṃ yojehi sārathi ",
  "ja503:8.3": "sakuṇo me na ruccati ",
  "ja503:8.4": "aññaṃ gacchāma assamaṃ. ",
  "ja503:9.1": "yutto ratho mahārāja ",
  "ja503:9.2": "yutto ca balavāhano ",
  "ja503:9.3": "adhitiṭṭha mahārāja ",
  "ja503:9.4": "aññaṃ gacchāma assamaṃ. ",
  "ja503:10.1": "konumeva gatā sabbe ",
  "ja503:10.2": "ye asmiṃ paricārakā ",
  "ja503:10.3": "esa gacchati pañcālo ",
  "ja503:10.4": "mutto tesaṃ adassanā. ",
  "ja503:11.1": "kodaṇḍakāni gaṇhatha ",
  "ja503:11.2": "sattiyo tomarāni ca ",
  "ja503:11.3": "esa gacchati pañcālo ",
  "ja503:11.4": "mā vo muñcittha jīvitaṃ. ",
  "ja503:12.1": "athāparo paṭinandittha ",
  "ja503:12.2": "suvo lohitatuṇḍiko ",
  "ja503:12.3": "svāgatante mahārāja ",
  "ja503:12.4": "atho te adurāgataṃ ",
  "ja503:12.5": "issarosi anuppatto ",
  "ja503:12.6": "yaṃ idhatthi pavedaya. ",
  "ja503:13.1": "tiṇḍukāni piyālāni ",
  "ja503:13.2": "madhuke kāsumāriyo ",
  "ja503:13.3": "phalāni khuddakappāni ",
  "ja503:13.4": "bhuñja rāja varaṃ varaṃ. ",
  "ja503:14.1": "idaṃpi pāniyaṃ sītaṃ ",
  "ja503:14.2": "ābhataṃ girigabbharā ",
  "ja503:14.3": "tato piva mahārāja ",
  "ja503:14.4": "sace tvaṃ abhikaṅkhasi. ",
  "ja503:15.1": "araññaṃ uñchāya gatā ",
  "ja503:15.2": "ye asmiṃ paricārakā ",
  "ja503:15.3": "sayaṃ uṭṭhāya gaṇhavho ",
  "ja503:15.4": "hatthā me natthi dātave. ",
  "ja503:16.1": "bhaddako vatāyaṃ pakkhī ",
  "ja503:16.2": "dijo paramadhammiko ",
  "ja503:16.3": "atheso itaro pakkhī ",
  "ja503:16.4": "suvo luddāni bhāsati. ",
  "ja503:17.1": "etaṃ hanatha bandhatha ",
  "ja503:17.2": "mā vo muñcittha jīvitaṃ ",
  "ja503:17.3": "iccevaṃ vilapantassa ",
  "ja503:17.4": "sotthī pattosmi assamaṃ. ",
  "ja503:18.1": "bhātarosma mahārāja ",
  "ja503:18.2": "sodariyā ekamātukā ",
  "ja503:18.3": "ekarukkhasmi saṃvaḍḍhā ",
  "ja503:18.4": "nānākhettagatā ubho. ",
  "ja503:19.1": "sattigumbo ca corānaṃ ",
  "ja503:19.2": "ahañca isinaṃ idha ",
  "ja503:19.3": "asataṃ so sataṃ ahaṃ ",
  "ja503:19.4": "tena dhammena no vinā. ",
  "ja503:20.1": "yattha vadho ca bandho ca ",
  "ja503:20.2": "nikati vañcanāni ca ",
  "ja503:20.3": "ālopā sahasākārā ",
  "ja503:20.4": "tāni so tattha sikkhati. ",
  "ja503:21.1": "idha saccañca dhammo ca ",
  "ja503:21.2": "ahiṃsā saṃyamo damo ",
  "ja503:21.3": "āsanūdakadāyīnaṃ ",
  "ja503:21.4": "aṅke vaḍḍhosmi bhārata. ",
  "ja503:22.1": "yaṃ yaṃ hi rāja bhajati ",
  "ja503:22.2": "santaṃ vā yadi vā asaṃ ",
  "ja503:22.3": "sīlavantaṃ visīlaṃ vā ",
  "ja503:22.4": "vasaṃ tasseva gacchati. ",
  "ja503:23.1": "yādisaṃ kurute mittaṃ ",
  "ja503:23.2": "yādisañcūpasevati ",
  "ja503:23.3": "sopi tādisako hoti ",
  "ja503:23.4": "sahavāsopi tādiso. ",
  "ja503:24.1": "sevamāno sevamānaṃ ",
  "ja503:24.2": "samphuṭṭho samphusaṃ paraṃ ",
  "ja503:24.3": "saro duṭṭho kalāpaṃva ",
  "ja503:24.4": "alittamupalimpati. ",
  "ja503:24.5": "upalimpabhayā dhīro ",
  "ja503:24.6": "neva pāpasakhā siyā ",
  "ja503:25.1": "pūtimacchaṃ kusaggena ",
  "ja503:25.2": "yo naro upanayhati ",
  "ja503:25.3": "kusāpi pūti vāyanti ",
  "ja503:25.4": "evaṃ bālūpasevanā. ",
  "ja503:26.1": "taggaraṃva palāsena ",
  "ja503:26.2": "yo naro upanayhati ",
  "ja503:26.3": "pattāpi surabhī vāyanti ",
  "ja503:26.4": "evaṃ dhīrūpasevanā ",
  "ja503:27.1": "tasmā palāsapuṭasseva ",
  "ja503:27.2": "ñatvā sampākamattano ",
  "ja503:27.3": "asante nūpaseveyya ",
  "ja503:27.4": "sante seveyya paṇḍito ",
  "ja503:27.5": "asanto nirayaṃ nenti ",
  "ja503:27.6": "santo pāpenti suggatinti. ",
  "ja503:28.1": "sattigumbajātakaṃ sattamaṃ. "
}
