  "ja11:0.3": "2 sīlavaggo ",
  "ja11:0.4": "1 lakkhaṇajātakaṃ ",
  "ja11:1.1": "hoti sīlavataṃ attho ",
  "ja11:1.2": "paṭisanthāravuttinaṃ ",
  "ja11:1.3": "lakkhaṇaṃ passa āyantaṃ ",
  "ja11:1.4": "ñātisaṅghapurakkhitaṃ ",
  "ja11:1.5": "atha passasimaṃ kāḷaṃ ",
  "ja11:1.6": "suvihīnaṃva ñātibhīti. ",
  "ja11:2.1": "lakkhaṇajātakaṃ paṭhamaṃ "
}
