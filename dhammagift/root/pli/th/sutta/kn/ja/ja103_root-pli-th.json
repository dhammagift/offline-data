  "ja103:0.4": "3 verijātakaṃ ",
  "ja103:1.1": "yattha veriṃ niviṃsati ",
  "ja103:1.2": "na vase tattha paṇḍito ",
  "ja103:1.3": "ekarattaṃ dvirattaṃ vā ",
  "ja103:1.4": "dukkhaṃ vasati verisūti. ",
  "ja103:2.1": "verijātakaṃ tatiyaṃ. "
}
