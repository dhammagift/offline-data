{
  "ja341:0.1": "5 cullakuṇālavaggo ",
  "ja341:0.2": "",
  "ja341:0.3": "",
  "ja341:0.4": "1 kuṇḍalikajātakaṃ ",
  "ja341:1.1": "narānamārāmakarāsu nārīsu ",
  "ja341:1.2": "sabbattanā pītikarāpi ",
  "ja341:1.3": "ce siyuṃ ",
  "ja341:1.4": "na vissase titthasamā hi nāriyo. ",
  "ja341:2.1": "yañca disvā kinnarakinnarīnaṃ ",
  "ja341:2.2": "sabbitthiyo na ramanti agāre ",
  "ja341:2.3": "taṃ tādisaṃ sāmikaṃ cajitvā bhariyā ",
  "ja341:2.4": "aññaṃ disvā purisaṃ pīṭhasappiṃ. ",
  "ja341:3.1": "bakassa ca bāvarikassa rañño ",
  "ja341:3.2": "accantakāmānugatassa bhariyā ",
  "ja341:3.3": "accācarī baddhavasānugassa ",
  "ja341:3.4": "kiṃ vā itthī nāticare tadaññaṃ. ",
  "ja341:4.1": "piyaṅgāni sabbalokissarassa ",
  "ja341:4.2": "rañño piyā brahmadattassa bhariyā ",
  "ja341:4.3": "accācarī baddhavasānugassa ",
  "ja341:4.4": "taṃ vāpi sā nājjhagā kāmakāminīti. ",
  "ja341:5.1": "kuṇḍalikajātakaṃ paṭhamaṃ. "
}
