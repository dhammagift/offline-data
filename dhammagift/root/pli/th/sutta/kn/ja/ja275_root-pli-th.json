  "ja275:0.1": "",
  "ja275:0.2": "",
  "ja275:0.3": "",
  "ja275:0.4": "5 rucirajātakaṃ ",
  "ja275:1.1": "kāyaṃ balākā rucirā ",
  "ja275:1.2": "kākaniṇḍasmi macchati ",
  "ja275:1.3": "caṇḍo kāko sakhā mayhaṃ ",
  "ja275:1.4": "yassa cetaṃ kulāvakaṃ. ",
  "ja275:2.1": "nanu maṃ samma jānāsi ",
  "ja275:2.2": "dija sāmakabhojanaṃ ",
  "ja275:2.3": "akatvā vacanaṃ tuyhaṃ ",
  "ja275:2.4": "passa lūnosmi āgato. ",
  "ja275:3.1": "puna pāpajjasī samma ",
  "ja275:3.2": "sīlaṃ hi tava tādisaṃ ",
  "ja275:3.3": "nahi mānusikā bhogā ",
  "ja275:3.4": "subhuñjā honti pakkhināti. ",
  "ja275:4.1": "rucirajātakaṃ pañcamaṃ. "
}
