  "ja285:0.3": "",
  "ja285:0.4": "5 maṇisūkarajātakaṃ ",
  "ja285:1.1": "dariyā satta vassāni ",
  "ja285:1.2": "tiṃsamattā vasāmase ",
  "ja285:1.3": "haññāma maṇino ābhaṃ ",
  "ja285:1.4": "iti no mantitaṃ ahu. ",
  "ja285:2.1": "yāvatā maṇi ghaṃsāma ",
  "ja285:2.2": "bhiyyo vodāyate maṇi ",
  "ja285:2.3": "idañcidāni pucchāma ",
  "ja285:2.4": "kiṃ kiccaṃ idha maññasi. ",
  "ja285:3.1": "ayaṃ maṇi veḷuriyo ",
  "ja285:3.2": "akāco vimalo subho ",
  "ja285:3.3": "nāssa sakkā siriṃ hantuṃ ",
  "ja285:3.4": "apakkamatha sūkarāti. ",
  "ja285:4.1": "maṇisūkarajātakaṃ pañcamaṃ. "
}
