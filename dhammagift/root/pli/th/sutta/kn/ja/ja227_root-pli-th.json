  "ja227:0.1": "",
  "ja227:0.2": "",
  "ja227:0.3": "",
  "ja227:0.4": "7 gūthapāṇakajātakaṃ ",
  "ja227:1.1": "sūro sūrena saṅgamma ",
  "ja227:1.2": "vikkantena pahārinā ",
  "ja227:1.3": "ehi nāga nivattassu ",
  "ja227:1.4": "kinnu bhīto palāyasi ",
  "ja227:1.5": "passantu aṅgamagadhā ",
  "ja227:1.6": "mama tuyhañca vikkamaṃ. ",
  "ja227:2.1": "na taṃ pādā vadhissāmi ",
  "ja227:2.2": "na dantehi na soṇḍiyā ",
  "ja227:2.3": "mīḷhena taṃ vadhissāmi ",
  "ja227:2.4": "pūti haññatu pūtināti. ",
  "ja227:3.1": "gūthapāṇakajātakaṃ sattamaṃ. "
}
