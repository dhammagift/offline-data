  "ja162:0.1": "",
  "ja162:0.2": "",
  "ja162:0.3": "",
  "ja162:0.4": "2 santhavajātakaṃ ",
  "ja162:1.1": "na santhavasmā paramatthi pāpiyo ",
  "ja162:1.2": "yo santhavo kāpurisena hoti ",
  "ja162:1.3": "santappito sappinā pāyāsena ",
  "ja162:1.4": "kicchā kataṃ paṇṇakuṭiṃ adaḍḍhahi. ",
  "ja162:2.1": "na santhavasmā paramatthi seyyo ",
  "ja162:2.2": "yo santhavo sappurisena hoti ",
  "ja162:2.3": "sīhassa bayagghassa ca dīpino ca ",
  "ja162:2.4": "sāmā mukhaṃ lehati santhavenāti. ",
  "ja162:3.1": "santhavajātakaṃ dutiyaṃ. "
}
