  "ja10:0.1": "",
  "ja10:0.2": "",
  "ja10:0.3": "",
  "ja10:0.4": "10 sukhavihārijātakaṃ ",
  "ja10:1.1": "yañca aññe na rakkhanti ",
  "ja10:1.2": "yo ca aññe na rakkhati ",
  "ja10:1.3": "save rāja sukhaṃ seti ",
  "ja10:1.4": "kāmesu anapekkhavāti. ",
  "ja10:2.1": "sukhavihārijātakaṃ dasamaṃ. ",
  "ja10:2.2": "apaṇṇakavaggo paṭhamo. ",
  "ja10:3.1": "tassuddānaṃ. ",
  "ja10:4.1": "varāpaṇṇaka vaṇṇapatha serivaro ",
  "ja10:4.2": "suvicakkhaṇa taṇḍulanāḷikassā ",
  "ja10:4.3": "hiri putta varuttagāmaninā ",
  "ja10:4.4": "yo ca na rakkhati tena dasa. "
}
