  "ja284:0.1": "",
  "ja284:0.2": "",
  "ja284:0.3": "",
  "ja284:0.4": "4 sirijātakaṃ ",
  "ja284:1.1": "yaṃ ussukkā saṅgharanti ",
  "ja284:1.2": "alakkhikā bahuṃ dhanaṃ ",
  "ja284:1.3": "sippavanto asippā vā ",
  "ja284:1.4": "lakkhikā tāni bhuñjare. ",
  "ja284:2.1": "sabbattha katapuññassa ",
  "ja284:2.2": "aticcaññeva pāṇino ",
  "ja284:2.3": "uppajjanti bahū bhogā ",
  "ja284:2.4": "api nāyatanesupi. ",
  "ja284:3.1": "kukkuṭo maṇayo daṇḍo ",
  "ja284:3.2": "thiyo ca puññalakkhaṇā ",
  "ja284:3.3": "uppajjanti apāpassa ",
  "ja284:3.4": "katapuññassa jantunoti. ",
  "ja284:4.1": "sirijātakaṃ catutthaṃ. "
}
