  "ja152:0.1": "",
  "ja152:0.2": "",
  "ja152:0.3": "",
  "ja152:0.4": "2 sigālajātakaṃ ",
  "ja152:1.1": "asamekkhitakammantaṃ ",
  "ja152:1.2": "turitābhinipātinaṃ ",
  "ja152:1.3": "tāni kammāni tappenti ",
  "ja152:1.4": "uṇhaṃ vajjhohitaṃ mukhe. ",
  "ja152:2.1": "sīho ca sīhanādena ",
  "ja152:2.2": "daddaraṃ abhinādayi ",
  "ja152:2.3": "sutvā sīhassa nigghosaṃ ",
  "ja152:2.4": "sigālo daddare vasaṃ ",
  "ja152:2.5": "bhīto santāsamāpādi ",
  "ja152:2.6": "hadayañcassa apphalīti. ",
  "ja152:3.1": "sigālajātakaṃ dutiyaṃ. "
}
