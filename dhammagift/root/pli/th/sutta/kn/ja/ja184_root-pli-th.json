  "ja184:0.3": "",
  "ja184:0.4": "4 giridattajātakaṃ ",
  "ja184:1.1": "dūsito giridattena ",
  "ja184:1.2": "hayo sāmassa paṇḍavo ",
  "ja184:1.3": "porāṇaṃ pakatiṃ hitvā ",
  "ja184:1.4": "tassevānuvidhiyyati. ",
  "ja184:2.1": "sace ca tanujo poso ",
  "ja184:2.2": "siṅgārākārakappito ",
  "ja184:2.3": "ānane taṃ gahetvāna ",
  "ja184:2.4": "maṇḍale parivattaye ",
  "ja184:2.5": "khippameva pahantvāna ",
  "ja184:2.6": "tassevānuvidhiyyatīti. ",
  "ja184:3.1": "giridattajātakaṃ catutthaṃ. "
}
