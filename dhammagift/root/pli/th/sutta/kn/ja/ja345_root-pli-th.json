  "ja345:0.3": "",
  "ja345:0.4": "5 gajakumbhajātakaṃ ",
  "ja345:1.1": "vanaṃ yadaggi dahati ",
  "ja345:1.2": "pāvako kaṇhavattanī ",
  "ja345:1.3": "kathaṃ karosi pacalaka ",
  "ja345:1.4": "evaṃ dandhaparakkamo. ",
  "ja345:2.1": "bahūni rukkhachiddāni ",
  "ja345:2.2": "paṭhabyā vivarāni ca ",
  "ja345:2.3": "tāni ce nābhisambhoma ",
  "ja345:2.4": "hoti no kālapariyāyo. ",
  "ja345:3.1": "yo dandhakāle tarati ",
  "ja345:3.2": "taraṇīye ca dandhati ",
  "ja345:3.3": "sukkhapaṇṇaṃva akkamma ",
  "ja345:3.4": "atthaṃ bhañjati attano. ",
  "ja345:4.1": "yo dandhakāle dandheti ",
  "ja345:4.2": "taraṇīye ca tārayi ",
  "ja345:4.3": "sasīva rattiṃ vibhajaṃ ",
  "ja345:4.4": "tassattho paripūratīti. ",
  "ja345:5.1": "gajakumbhajātakaṃ pañcamaṃ. "
}
