{
  "ja376:0.1": "",
  "ja376:0.2": "chakkanipātajātakaṃ ",
  "ja376:0.3": "1 āvāriyavaggo ",
  "ja376:0.4": "1 āvāriyajātakaṃ ",
  "ja376:1.1": "māsu kujjha bhūmipati ",
  "ja376:1.2": "māsu kujjha rathesabha ",
  "ja376:1.3": "kuddhaṃ appaṭikujjhanto ",
  "ja376:1.4": "rājā raṭṭhassa pūjito ",
  "ja376:2.1": "gāme vā yadivāraññe ",
  "ja376:2.2": "ninne vā yadivā thale ",
  "ja376:2.3": "sabbatthamanusāsāmi ",
  "ja376:2.4": "māsu kujjha rathesabha. ",
  "ja376:3.1": "āvāriyapitā nāma ",
  "ja376:3.2": "ahu gaṅgāya nāviko ",
  "ja376:3.3": "pubbe janaṃ tārayitvā ",
  "ja376:3.4": "pacchā yācati vetanaṃ ",
  "ja376:3.5": "tenassa bhaṇḍanaṃ hoti ",
  "ja376:3.6": "na ca bhogehi vaḍḍhati. ",
  "ja376:4.1": "atiṇṇaññeva yācassu ",
  "ja376:4.2": "apāraṃ tāta nāvika ",
  "ja376:4.3": "añño hi tiṇṇassa mano ",
  "ja376:4.4": "añño hoti tiresino. ",
  "ja376:5.1": "gāme vā yadivāraññe ",
  "ja376:5.2": "ninne vā yadivā thale ",
  "ja376:5.3": "sabbatthamanusāsāmi ",
  "ja376:5.4": "māsu kujjhittha nāvika. ",
  "ja376:6.1": "yāyeva anusāsaniyā ",
  "ja376:6.2": "rājā gāmavaraṃ adā ",
  "ja376:6.3": "tāyeva anusāsaniyā ",
  "ja376:6.4": "nāviko paharī mukhaṃ. ",
  "ja376:7.1": "bhattaṃ bhinnaṃ hatā bhariyā ",
  "ja376:7.2": "gabbho ca patito chamā ",
  "ja376:7.3": "migova jātarūpena ",
  "ja376:7.4": "na tenatthaṃ avaḍḍhitunti. ",
  "ja376:8.1": "āvāriyajātakaṃ paṭhamaṃ. "
}
