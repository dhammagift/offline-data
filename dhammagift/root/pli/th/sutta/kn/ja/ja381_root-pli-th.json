  "ja381:0.3": "",
  "ja381:0.4": "6 migālopajātakaṃ ",
  "ja381:1.1": "na me ruci migālopa ",
  "ja381:1.2": "yassa te tādisī gati ",
  "ja381:1.3": "atuccaṃ tāta gacchasi ",
  "ja381:1.4": "abhūmiṃ tāta sevasi. ",
  "ja381:2.1": "catukkaṇṇaṃva kedāraṃ ",
  "ja381:2.2": "yathā te paṭhavī siyā ",
  "ja381:2.3": "tato tāta nivattassu ",
  "ja381:2.4": "māsu etto paraṃ gami. ",
  "ja381:3.1": "santi aññepi sakuṇā ",
  "ja381:3.2": "pattayānā vihaṅgamā ",
  "ja381:3.3": "ukkhittā vātavegena ",
  "ja381:3.4": "naṭṭhā te sassatīsamā. ",
  "ja381:4.1": "akatvā aparaṇṇassa ",
  "ja381:4.2": "pitu vuḍḍhassa sāsanaṃ ",
  "ja381:4.3": "kālavāte atikkamma ",
  "ja381:4.4": "verambhānaṃ vasaṃ agā. ",
  "ja381:5.1": "tassa puttā ca dārā ca ",
  "ja381:5.2": "ye caññe anujīvino ",
  "ja381:5.3": "sabbe byasanamāpāduṃ ",
  "ja381:5.4": "anovādakare dije. ",
  "ja381:6.1": "evampi idha vuḍḍhānaṃ ",
  "ja381:6.2": "yo vākyaṃ nāvabujjhati ",
  "ja381:6.3": "atisīmaṃ caro ditto ",
  "ja381:6.4": "gijjho vātītasāsano ",
  "ja381:6.5": "sabbe byasanaṃ papponti ",
  "ja381:6.6": "akatvā buddhasāsananti. ",
  "ja381:7.1": "migālopajātakaṃ chaṭṭhaṃ. "
}
