  "ja286:0.3": "",
  "ja286:0.4": "6 sālukajātakaṃ ",
  "ja286:1.1": "mā sālukassa pihayi ",
  "ja286:1.2": "āturannāni bhuñjati ",
  "ja286:1.3": "appossukko bhusaṃ khāda ",
  "ja286:1.4": "etaṃ dīghāyulakkhaṇaṃ. ",
  "ja286:2.1": "idāni so idhāgantvā ",
  "ja286:2.2": "atithi yuttasevako ",
  "ja286:2.3": "atha dakkhasi sālukaṃ ",
  "ja286:2.4": "sayantaṃ mūsaluttaraṃ. ",
  "ja286:3.1": "vikantaṃ sūkaraṃ disvā ",
  "ja286:3.2": "sayantaṃ mūsaluttaraṃ ",
  "ja286:3.3": "jaraggavā acintesuṃ ",
  "ja286:3.4": "varamhākaṃ bhusāmivāti. ",
  "ja286:4.1": "sālukajātakaṃ chaṭṭhaṃ. "
}
