  "ja83:0.3": "",
  "ja83:0.4": "3 kāḷakaṇṇijātakaṃ ",
  "ja83:1.1": "mitto have sattapadena hoti ",
  "ja83:1.2": "sahāyo pana dvādasakena hoti ",
  "ja83:1.3": "māsaḍḍhamāsena ca ñāti hoti ",
  "ja83:1.4": "tatuttariṃ attasamopi hoti ",
  "ja83:1.5": "sohaṃ kathaṃ attasukhassa hetu ",
  "ja83:1.6": "cirasanthutaṃ kāḷakaṇṇiṃ jaheyyanti. ",
  "ja83:2.1": "kāḷakaṇṇijātakaṃ tatiyaṃ. "
}
