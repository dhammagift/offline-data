  "ja299:0.3": "",
  "ja299:0.4": "9 komāriyaputtajātakaṃ ",
  "ja299:1.1": "pure tuvaṃ sīlavataṃ sakāse ",
  "ja299:1.2": "okkandikaṃ kīḷasi assamamhi ",
  "ja299:1.3": "karohare makkaṭiyāni makkaṭa ",
  "ja299:1.4": "na taṃ mayaṃ sīlavataṃ ramāma. ",
  "ja299:2.1": "sutā hi mayhaṃ paramā visuddhi ",
  "ja299:2.2": "komāriyaputtassa bahussutassa ",
  "ja299:2.3": "mādāni maṃ maññi tuvaṃ yathā pure ",
  "ja299:2.4": "jhānābhiyuttā viharāma āvuso. ",
  "ja299:3.1": "sacepi selasmi vapeyya bījaṃ ",
  "ja299:3.2": "devo ca vasse na hi taṃ virūḷhe ",
  "ja299:3.3": "sutā hi te sā paramā visuddhi ",
  "ja299:3.4": "ārā tuvaṃ makkaṭa jhānabhūmyāti. ",
  "ja299:4.1": "komāriyaputtajātakaṃ navamaṃ. "
}
