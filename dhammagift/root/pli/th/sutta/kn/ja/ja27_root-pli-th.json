  "ja27:0.4": "7 abhiṇhajātakaṃ ",
  "ja27:1.1": "nālaṃ kabalaṃ padātave ",
  "ja27:1.2": "na piṇḍaṃ na kuse na ghaṃsituṃ ",
  "ja27:1.3": "maññāmi abhiṇhadassanā ",
  "ja27:1.4": "nāgo sinehamakāsi kukkureti. ",
  "ja27:2.1": "abhiṇhajātakaṃ sattamaṃ. "
}
