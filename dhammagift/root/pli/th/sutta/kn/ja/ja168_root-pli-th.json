  "ja168:0.3": "",
  "ja168:0.4": "8 sakuṇagghijātakaṃ ",
  "ja168:1.1": "seno balasā patamāno ",
  "ja168:1.2": "lāpaṃ gocaraṭṭhāyinaṃ ",
  "ja168:1.3": "sahasā ajjhapattova ",
  "ja168:1.4": "maraṇaṃ tenupāgami. ",
  "ja168:2.1": "sohaṃ nayena sampanno ",
  "ja168:2.2": "pettike gocare rato ",
  "ja168:2.3": "apetasattu modāmi ",
  "ja168:2.4": "sampassaṃ atthamattanoti. ",
  "ja168:3.1": "sakuṇagghijātakaṃ aṭṭhamaṃ. "
}
