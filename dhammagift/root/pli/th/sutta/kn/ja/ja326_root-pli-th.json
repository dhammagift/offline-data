  "ja326:0.1": "",
  "ja326:0.2": "",
  "ja326:0.3": "",
  "ja326:0.4": "6 kakkārujātakaṃ ",
  "ja326:1.1": "kāyena yo nāvahare ",
  "ja326:1.2": "vācāya na musā bhaṇe ",
  "ja326:1.3": "yaso laddhā na majjeyya ",
  "ja326:1.4": "save kakkārumarahati. ",
  "ja326:2.1": "dhammena vittameseyya ",
  "ja326:2.2": "na nikatyā dhanaṃ hare ",
  "ja326:2.3": "bhoge laddhā na majjeyya ",
  "ja326:2.4": "save kakkārumarahati. ",
  "ja326:3.1": "yassa cittaṃ ahāliddaṃ ",
  "ja326:3.2": "saddhā ca avirāginī ",
  "ja326:3.3": "eko sāduṃ na bhuñjeyya ",
  "ja326:3.4": "save kakkārumarahati. ",
  "ja326:4.1": "sammukhā vā tirokkhā vā ",
  "ja326:4.2": "yo sante na paribhāsati ",
  "ja326:4.3": "yathāvādī tathākārī ",
  "ja326:4.4": "save kakkārumarahatīti. ",
  "ja326:5.1": "kakkārujātakaṃ chaṭṭhaṃ. "
}
