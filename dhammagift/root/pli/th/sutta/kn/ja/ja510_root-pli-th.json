  "ja510:0.1": "",
  "ja510:0.2": "",
  "ja510:0.3": "",
  "ja510:0.4": "14 ayogharajātakaṃ ",
  "ja510:1.1": "yamekarattiṃ paṭhamaṃ ",
  "ja510:1.2": "gabbhe vasati māṇavo ",
  "ja510:1.3": "abbhuṭṭhitova so yāti ",
  "ja510:1.4": "sa gacchaṃ na nivattati. ",
  "ja510:2.1": "na yujjhamānā na balena vassitā ",
  "ja510:2.2": "narā na jīranti na cāpi miyyare ",
  "ja510:2.3": "sabbañhi taṃ jātijarāyupaddutaṃ ",
  "ja510:2.4": "tamme matī hoti carāmi dhammaṃ. ",
  "ja510:3.1": "caturaṅginiṃ sena subhiṃsarūpaṃ ",
  "ja510:3.2": "jayanti raṭṭhādhipatī pasayha ",
  "ja510:3.3": "na maccuno jayitumussahanti ",
  "ja510:3.4": "tamme matī hoti carāmi dhammaṃ. ",
  "ja510:4.1": "hatthīhi assehi rathehi pattihi ",
  "ja510:4.2": "parivāritā muñcare ekacceyyā ",
  "ja510:4.3": "na maccuno muñcitumussahanti ",
  "ja510:4.4": "tamme matī hoti carāmi dhammaṃ. ",
  "ja510:5.1": "hatthīhi assehi rathehi pattihi ",
  "ja510:5.2": "sūrā pabhañjanti padhaṃsayanti ",
  "ja510:5.3": "na maccuno bhañjitumussahanti ",
  "ja510:5.4": "tamme matī hoti carāmi dhammaṃ. ",
  "ja510:6.1": "mattā gajā bhinnagaḷā pabhinnā ",
  "ja510:6.2": "nagarāni maddanti janaṃ hananti ",
  "ja510:6.3": "na maccuno madditumussahanti ",
  "ja510:6.4": "tamme matī hoti carāmi dhammaṃ. ",
  "ja510:7.1": "issāsino katahatthāpi vīrā ",
  "ja510:7.2": "dūrepātī akkhaṇavedhinopi ",
  "ja510:7.3": "na maccuno vijjhitumussahanti ",
  "ja510:7.4": "tamme matī hoti carāmi dhammaṃ. ",
  "ja510:8.1": "sarāni khīyanti saselakānanā ",
  "ja510:8.2": "sabbaṃpi taṃ khīyati dīghamantaraṃ ",
  "ja510:8.3": "sabbaṃ hi taṃ bhañjare kālapariyāyaṃ ",
  "ja510:8.4": "tamme matī hoti carāmi dhammaṃ. ",
  "ja510:9.1": "sabbesamevaṃ hi narīnarānaṃ ",
  "ja510:9.2": "calācalaṃ pāṇabhunodha jīvitaṃ ",
  "ja510:9.3": "paṭova dhuttassa dumova kūlajo ",
  "ja510:9.4": "tamme matī hoti carāmi dhammaṃ. ",
  "ja510:10.1": "dumapphalāneva patanti māṇavā ",
  "ja510:10.2": "daharā ca vuḍḍhā ca sarīrabhedā ",
  "ja510:10.3": "nāriyo narā majjhimaporisā ca ",
  "ja510:10.4": "tamme matī hoti carāmi dhammaṃ. ",
  "ja510:11.1": "nāyaṃ vayo tārakarājasannibho ",
  "ja510:11.2": "yadabbhatītaṃ gatamevadāni taṃ ",
  "ja510:11.3": "jiṇṇassa hī natthi ratī kuto sukhaṃ ",
  "ja510:11.4": "tamme matī hoti carāmi dhammaṃ. ",
  "ja510:12.1": "yakkhā pisācā athavāpi petā ",
  "ja510:12.2": "kuppitā te assasanti manusse ",
  "ja510:12.3": "na maccuno assasitumussahanti ",
  "ja510:12.4": "tamme matī hoti carāmi dhammaṃ. ",
  "ja510:13.1": "yakkhe pisāce athavāpi pete ",
  "ja510:13.2": "kuppitepi te nijjhapanaṃ karonti ",
  "ja510:13.3": "na maccuno nijjhapanamussahanti ",
  "ja510:13.4": "tamme matī hoti carāmi dhammaṃ. ",
  "ja510:14.1": "aparādhake dūsake heṭhake ca ",
  "ja510:14.2": "rājāno daṇḍenti viditvāna dosaṃ ",
  "ja510:14.3": "na maccuno daṇḍayitumussahanti ",
  "ja510:14.4": "tamme matī hoti carāmi dhammaṃ. ",
  "ja510:15.1": "aparādhakā dūsakā heṭhakā ca ",
  "ja510:15.2": "labhanti te rājāno nijjhapetuṃ ",
  "ja510:15.3": "na maccuno nijjhapanaṃ karonti ",
  "ja510:15.4": "tamme matī hoti carāmi dhammaṃ. ",
  "ja510:16.1": "na khattiyopi na ca brāhmaṇopi ",
  "ja510:16.2": "na aḍḍhakā balavā tejavāpi ",
  "ja510:16.3": "na maccurājassa apekkhamatthi ",
  "ja510:16.4": "tamme matī hoti carāmi dhammaṃ. ",
  "ja510:17.1": "sīhā ca byagghā ca athopi dīpiyo ",
  "ja510:17.2": "pasayha khādanti viphandamānaṃ ",
  "ja510:17.3": "na maccuno khāditumussahanti ",
  "ja510:17.4": "tamme matī hoti carāmi dhammaṃ. ",
  "ja510:18.1": "māyākārā raṅgamajjhe karontā ",
  "ja510:18.2": "mohenti cakkhūni janassa tāvade ",
  "ja510:18.3": "na maccuno mohayitumussahanti ",
  "ja510:18.4": "tamme matī hoti carāmi dhammaṃ. ",
  "ja510:19.1": "āsīvisā kuppitā uggatejā ",
  "ja510:19.2": "ḍaṃsanti mārentipi te manusse ",
  "ja510:19.3": "na maccuno ḍaṃsitumussahanti ",
  "ja510:19.4": "tamme matī hoti carāmi dhammaṃ. ",
  "ja510:20.1": "āsīvisā kuppitā yaṃ ḍaṃsanti ",
  "ja510:20.2": "tikicchakā tesa visaṃ hananti ",
  "ja510:20.3": "na maccuno daṭṭhavisaṃ hananti ",
  "ja510:20.4": "tamme matī hoti carāmi dhammaṃ. ",
  "ja510:21.1": "dhammantarī vettaruṇo ca bhojo ",
  "ja510:21.2": "visāni hantvāna bhujaṅgamānaṃ ",
  "ja510:21.3": "suyyanti te kālakatā tatheva ",
  "ja510:21.4": "tamme matī hoti carāmi dhammaṃ. ",
  "ja510:22.1": "vijjādharā ghoramadhīyamānā ",
  "ja510:22.2": "adassanaṃ osadhebhi vajanti ",
  "ja510:22.3": "na maccurājassa vajanti ",
  "ja510:22.4": "adassanaṃ tamme matī hoti carāmi dhammaṃ. ",
  "ja510:23.1": "dhammo have rakkhati dhammacāriṃ ",
  "ja510:23.2": "dhammo suciṇṇo sukhamāvahāti ",
  "ja510:23.3": "esānisaṃso dhamme suciṇṇe ",
  "ja510:23.4": "na duggatiṃ gacchati dhammacārī. ",
  "ja510:24.1": "nahi dhammo adhammo ca ",
  "ja510:24.2": "ubho samavipākino ",
  "ja510:24.3": "adhammo nirayaṃ neti ",
  "ja510:24.4": "dhammo pāpeti suggatinti. ",
  "ja510:25.1": "ayogharajātakaṃ cuddasamaṃ. ",
  "ja510:26.1": "",
  "ja510:27.1": "tassuddānaṃ. ",
  "ja510:28.1": "mātaṅga sambhūta sīvi sirimanto ",
  "ja510:28.2": "rohana haṃsa sattigumbo bhallātiya ",
  "ja510:28.3": "somanassa campeyya brahma pañca ",
  "ja510:28.4": "paṇḍita cirassaṃvata ayoghara vīsatinipātaṃ niṭṭhitaṃ. "
}
