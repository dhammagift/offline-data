  "ja159:0.1": "",
  "ja159:0.2": "",
  "ja159:0.3": "",
  "ja159:0.4": "9 morajātakaṃ ",
  "ja159:1.1": "udetayañcakkhumā ekarājā ",
  "ja159:1.2": "harissavaṇṇo paṭhavippabhāso ",
  "ja159:1.3": "taṃ taṃ namassāmi harissavaṇṇaṃ paṭhavippabhāsaṃ ",
  "ja159:1.4": "tayajja guttā viharemu divasaṃ ",
  "ja159:2.1": "ye brāhmaṇā vedagu sabbadhamme ",
  "ja159:2.2": "te me namo te ca maṃ pālayantu ",
  "ja159:2.3": "namatthu buddhānaṃ namatthu bodhiyā ",
  "ja159:2.4": "namo vimuttānaṃ namo vimuttiyā ",
  "ja159:2.5": "imaṃ so parittaṃ katvā ",
  "ja159:2.6": "moro carati esanā. ",
  "ja159:3.1": "apetayañcakkhumā ekarājā ",
  "ja159:3.2": "harissavaṇṇo paṭhavippabhāso ",
  "ja159:3.3": "taṃ taṃ namassāmi harissavaṇṇaṃ paṭhavippabhāsaṃ ",
  "ja159:3.4": "tayajja guttā viharemu rattiṃ ",
  "ja159:4.1": "ye brāhmaṇā vedagu sabbadhamme ",
  "ja159:4.2": "te me namo te ca maṃ pālayantu ",
  "ja159:4.3": "namatthu buddhānaṃ namatthu bodhiyā ",
  "ja159:4.4": "namo vimuttānaṃ namo vimuttiyā ",
  "ja159:4.5": "imaṃ so parittaṃ katvā ",
  "ja159:4.6": "moro vāsamakappayīti. ",
  "ja159:5.1": "morajātakaṃ navamaṃ. "
}
