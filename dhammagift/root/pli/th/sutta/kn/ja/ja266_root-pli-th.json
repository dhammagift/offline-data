  "ja266:0.3": "",
  "ja266:0.4": "6 vātaggasindhavajātakaṃ ",
  "ja266:1.1": "yenāsi kīsiyā paṇḍu ",
  "ja266:1.2": "yena bhattaṃ na ruccati ",
  "ja266:1.3": "ayaṃ so āgato bhatto ",
  "ja266:1.4": "kasmādāni palāyasi. ",
  "ja266:2.1": "nukho panādikeneva ",
  "ja266:2.2": "santhavo nāma jāyati ",
  "ja266:2.3": "yaso hāyati itthīnaṃ ",
  "ja266:2.4": "tasmā tāta palāyihaṃ. ",
  "ja266:3.1": "yasassinaṃ kule jātaṃ ",
  "ja266:3.2": "ābhataṃ yā na icchati ",
  "ja266:3.3": "socatī cirarattāya ",
  "ja266:3.4": "vātaggamiva gadrabhīti. ",
  "ja266:4.1": "vātaggasindhavajātakaṃ chaṭṭhaṃ "
}
