  "ja149:0.4": "9 ekapaṇṇajātakaṃ ",
  "ja149:1.1": "ekapaṇṇo ayaṃ rukkho ",
  "ja149:1.2": "na bhūmyā caturaṅgulo ",
  "ja149:1.3": "phalena visakappena ",
  "ja149:1.4": "mahāyaṃ kiṃ bhavissatīti. ",
  "ja149:2.1": "ekapaṇṇajātakaṃ navamaṃ. "
}
