{
  "ja111:0.1": "12 haṃsivaggo ",
  "ja111:0.2": "",
  "ja111:0.3": "",
  "ja111:0.4": "1 gadrabhapañho ",
  "ja111:1.1": "haṃsi tuvaṃ evaṃ maññasi seyyo ",
  "ja111:1.2": "puttena pitāti rāja seṭṭha ",
  "ja111:1.3": "handassatarassa te ayaṃ ",
  "ja111:1.4": "assatarassa hi gadrabho pitāti. ",
  "ja111:2.1": "gadarbhapañho paṭhamo. "
}
