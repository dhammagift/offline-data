  "ja475:0.1": "",
  "ja475:0.2": "",
  "ja475:0.3": "",
  "ja475:0.4": "2 phandanajātakaṃ ",
  "ja475:1.1": "kuṭhārihattho puriso ",
  "ja475:1.2": "vanamoggayha tiṭṭhasi ",
  "ja475:1.3": "puṭṭho me samma akkhāhi ",
  "ja475:1.4": "kiṃ dāruṃ chetumicchasi. ",
  "ja475:2.1": "īso vanāni carasi ",
  "ja475:2.2": "samāni visamāni ca ",
  "ja475:2.3": "puṭṭho me samma akkhāhi ",
  "ja475:2.4": "kiṃ dāruṃ nemiyā daḷhaṃ. ",
  "ja475:3.1": "neva sālo na khadiro ",
  "ja475:3.2": "nāssakaṇṇo kuto dhavo ",
  "ja475:3.3": "rukkho ca phandano nāma ",
  "ja475:3.4": "taṃ dāruṃ nemiyā daḷhaṃ. ",
  "ja475:4.1": "kīdisānissa pattāni ",
  "ja475:4.2": "khandho vā pana kīdiso ",
  "ja475:4.3": "puṭṭho me samma akkhāhi ",
  "ja475:4.4": "yathā jānemu phandanaṃ. ",
  "ja475:5.1": "yassa sākhā palambanti ",
  "ja475:5.2": "namanti na ca bhañjare ",
  "ja475:5.3": "so rukkho phandano nāma ",
  "ja475:5.4": "yassa mūle ahaṃ ṭhito. ",
  "ja475:6.1": "arānaṃ cakkanābhīnaṃ ",
  "ja475:6.2": "īsānemirathassa ca ",
  "ja475:6.3": "sabbassa te kammaniyo ",
  "ja475:6.4": "ayaṃ hessati phandano. ",
  "ja475:7.1": "iti phandanarukkhopi ",
  "ja475:7.2": "devatā ajjhabhāsatha ",
  "ja475:7.3": "mayhampi vacanaṃ atthi ",
  "ja475:7.4": "bhāradvāja suṇohi me. ",
  "ja475:8.1": "imassa upakkhandhamhā ",
  "ja475:8.2": "ukkacca caturaṅgulaṃ ",
  "ja475:8.3": "tena nemiṃ pariharesi ",
  "ja475:8.4": "evaṃ daḷhataraṃ siyā. ",
  "ja475:9.1": "iti phandanarukkhopi ",
  "ja475:9.2": "veraṃ kappesi devatā ",
  "ja475:9.3": "jātānañca ajātānaṃ ",
  "ja475:9.4": "īsānaṃ dukkhamāvahi. ",
  "ja475:10.1": "iccevaṃ phandano īsaṃ ",
  "ja475:10.2": "īso ca pana phandanaṃ ",
  "ja475:10.3": "aññamaññaṃ vivādena ",
  "ja475:10.4": "aññamaññamaghātayuṃ. ",
  "ja475:11.1": "evameva manussesu ",
  "ja475:11.2": "vivādo yattha jāyati ",
  "ja475:11.3": "mayūranaccaṃ naccanti ",
  "ja475:11.4": "yathā te īsaphandanā. ",
  "ja475:12.1": "taṃ vo vadāmi bhaddaṃ vo ",
  "ja475:12.2": "yāvantettha samāgatā ",
  "ja475:12.3": "sammodatha mā vivadittha ",
  "ja475:12.4": "mā hotha īsaphandanā. ",
  "ja475:13.1": "sāmagyameva sikkhetha ",
  "ja475:13.2": "buddhehetaṃ pasaṃsitaṃ ",
  "ja475:13.3": "sāmagyarato dhammaṭṭho ",
  "ja475:13.4": "yogakkhemā na dhaṃsatīti. ",
  "ja475:14.1": "phandanajātakaṃ dutiyaṃ. "
}
