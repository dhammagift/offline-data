  "ja228:0.3": "",
  "ja228:0.4": "8 kāmanītajātakaṃ ",
  "ja228:1.1": "tayo giriṃ antaraṃ kāmayāmi ",
  "ja228:1.2": "pañcālo kuruyo kekake ca ",
  "ja228:1.3": "tatuttariṃ brāhmaṇa kāmayāmi ",
  "ja228:1.4": "tikiccha maṃ brāhmaṇa kāmanītaṃ. ",
  "ja228:2.1": "kaṇhāhi daṭṭhassa karonti heke ",
  "ja228:2.2": "amanussaviṭṭhassa karonti paṇḍitā ",
  "ja228:2.3": "na kāmanītassa karoti koci ",
  "ja228:2.4": "okkantasukkassa hi kā tikicchāti. ",
  "ja228:3.1": "kāmanītajātakaṃ aṭṭhamaṃ. "
}
