  "ja129:0.4": "9 aggikajātakaṃ ",
  "ja129:1.1": "nāyaṃ sikhā puññahetu ",
  "ja129:1.2": "ghāsahetu ayaṃ sikhā ",
  "ja129:1.3": "naṅguṭṭhagaṇanaṃ yāti ",
  "ja129:1.4": "alante hotu aggikāti. ",
  "ja129:2.1": "aggikajātakaṃ navamaṃ. "
}
