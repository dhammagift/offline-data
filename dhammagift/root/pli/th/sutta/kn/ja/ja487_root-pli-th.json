  "ja487:0.3": "",
  "ja487:0.4": "4 uddālakajātakaṃ ",
  "ja487:1.1": "kharājinā jaṭilā paṅkadantā ",
  "ja487:1.2": "dummakkharūpā ye mantaṃ japanti kacci ",
  "ja487:1.3": "nu te mānusake payoge ",
  "ja487:1.4": "idaṃ vidū parimuttā apāyā. ",
  "ja487:2.1": "pāpāni kammāni kareyya rāja ",
  "ja487:2.2": "bahussuto ce na careyya dhammaṃ ",
  "ja487:2.3": "sahassavedopi na taṃ paṭicca ",
  "ja487:2.4": "dukkhā pamuñce caraṇaṃ apatvā. ",
  "ja487:3.1": "sahassavedopi na taṃ paṭicca ",
  "ja487:3.2": "dukkhā pamuñce caraṇaṃ apatvā ",
  "ja487:3.3": "maññāmi vedā aphalā bhavanti ",
  "ja487:3.4": "sasaṃyamaṃ caraṇaññeva saccaṃ. ",
  "ja487:4.1": "naheva vedā aphalā bhavanti ",
  "ja487:4.2": "sasaṃyamaṃ caraṇaññeva saccaṃ ",
  "ja487:4.3": "kittiñca pappoti adhicca vede ",
  "ja487:4.4": "santiṃ puṇeti caraṇena danto. ",
  "ja487:5.1": "bhaccā mātā pitā bandhu ",
  "ja487:5.2": "yena jāto svayeva so ",
  "ja487:5.3": "uddālako ahaṃ bhoto ",
  "ja487:5.4": "sotthiyakulavaṃsato. ",
  "ja487:6.1": "kathaṃ bho brāhmaṇo hoti ",
  "ja487:6.2": "kathaṃ bhavati kevalī ",
  "ja487:6.3": "kathañca parinibbānaṃ ",
  "ja487:6.4": "dhammaṭṭho kinti vuccati. ",
  "ja487:7.1": "niraṃ katvā aggimādāya brāhmaṇo ",
  "ja487:7.2": "āposiñcaṃ yajaṃ usseti yūpaṃ ",
  "ja487:7.3": "evaṅkaro brāhmaṇo hoti khemī ",
  "ja487:7.4": "dhamme ṭhitaṃ tena amāpayiṃsu. ",
  "ja487:8.1": "na suddhi secanena atthi ",
  "ja487:8.2": "napi kevalī brāhmaṇo ",
  "ja487:8.3": "na ceva khanti soraccaṃ ",
  "ja487:8.4": "napi so parinibbuto. ",
  "ja487:9.1": "kathaṃ bho brāhmaṇo hoti ",
  "ja487:9.2": "kathaṃ bhavati kevalī ",
  "ja487:9.3": "kathañca parinibbānaṃ ",
  "ja487:9.4": "dhammaṭṭho kinti vuccati. ",
  "ja487:10.1": "akhettabandhu amamo nirāso ",
  "ja487:10.2": "nillobhapāpo bhavalobhakhīṇo ",
  "ja487:10.3": "evaṅkaro brāhmaṇo hoti khemī ",
  "ja487:10.4": "dhamme ṭhitaṃ tena amāpayiṃsu. ",
  "ja487:11.1": "khattiyā brāhmaṇā vessā ",
  "ja487:11.2": "suddā caṇḍālapukkusā ",
  "ja487:11.3": "sabbeva soratā dantā ",
  "ja487:11.4": "sabbeva parinibbutā ",
  "ja487:11.5": "sabbesaṃ sītibhūtānaṃ ",
  "ja487:11.6": "atthi seyyotha pāpiyo. ",
  "ja487:12.1": "khattiyā brāhmaṇā vessā ",
  "ja487:12.2": "suddā caṇḍālapukkusā ",
  "ja487:12.3": "sabbeva soratā dantā ",
  "ja487:12.4": "sabbeva parinibbutā ",
  "ja487:12.5": "sabbesaṃ sītibhūtānaṃ ",
  "ja487:12.6": "natthi seyyotha pāpiyo. ",
  "ja487:13.1": "khattiyā brāhmaṇā vessā ",
  "ja487:13.2": "suddā caṇḍālapukkusā ",
  "ja487:13.3": "sabbeva soratā dantā ",
  "ja487:13.4": "sabbeva parinibbutā ",
  "ja487:14.1": "sabbesaṃ sītibhūtānaṃ ",
  "ja487:14.2": "natthi seyyotha pāpiyo ",
  "ja487:14.3": "pasatthaṃ carasi brahmaññaṃ ",
  "ja487:14.4": "sotthiyakulavaṃsataṃ. ",
  "ja487:15.1": "nānārattehi vatthehi ",
  "ja487:15.2": "vimānaṃ bhavati chāditaṃ ",
  "ja487:15.3": "na tesaṃ chāyā vatthānaṃ ",
  "ja487:15.4": "so rāgo anupajjatha ",
  "ja487:16.1": "evameva manussesu ",
  "ja487:16.2": "yadā sujjhanti māṇavā ",
  "ja487:16.3": "na tesaṃ jātiṃ pucchanti ",
  "ja487:16.4": "dhammamaññāya subbatāti. ",
  "ja487:17.1": "uddālakajātakaṃ catutthaṃ. "
}
