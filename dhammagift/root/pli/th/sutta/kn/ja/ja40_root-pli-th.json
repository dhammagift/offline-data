  "ja40:0.3": "",
  "ja40:0.4": "10 khadiraṅgārajātakaṃ ",
  "ja40:1.1": "kāmaṃ patāmi nirayaṃ ",
  "ja40:1.2": "uddhapādo avaṃsiro ",
  "ja40:1.3": "nānariyaṃ karissāmi ",
  "ja40:1.4": "handa piṇḍaṃ paṭiggahāti. ",
  "ja40:2.1": "khadiraṅgārajātakaṃ dasamaṃ. ",
  "ja40:2.2": "kulāvakavaggo catuttho. ",
  "ja40:3.1": "tassuddānaṃ. ",
  "ja40:4.1": "siri mātali dhītara pakkhivaro ",
  "ja40:4.2": "ratirāgato mātāpitā ca puna ",
  "ja40:4.3": "jagatīruha vuḍḍha sukakkaṭako ",
  "ja40:4.4": "tathā nandaka piṇḍavarena dasa. "
}
