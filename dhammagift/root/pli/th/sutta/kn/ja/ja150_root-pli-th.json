  "ja150:0.3": "",
  "ja150:0.4": "10 sañjīvajātakaṃ ",
  "ja150:1.1": "asantaṃ yo paggaṇhāti ",
  "ja150:1.2": "asantaṃ cūpasevati ",
  "ja150:1.3": "tameva ghāsaṃ kurute ",
  "ja150:1.4": "byaggho sañjīviko yathāti. ",
  "ja150:2.1": "sañjīvajātakaṃ dasamaṃ. ",
  "ja150:2.2": "kakaṇṭakavaggo paṇṇarasamo. ",
  "ja150:3.1": "tassuddānaṃ. ",
  "ja150:4.1": "sukhamedhati daṇḍavaro ca puna ",
  "ja150:4.2": "lasi vāladhi pañcamarādhavaro ",
  "ja150:4.3": "samahodadhi kattika bondi puna ",
  "ja150:4.4": "caturaṅgula byagghavarena ",
  "ja150:5.1": "dasa. ",
  "ja150:6.1": "tatra vagguddānaṃ ",
  "ja150:7.1": "bhavati. ",
  "ja150:7.2": "apaṇṇakaṃ sīlavagga kuruṅga kulāvakaṃ atthakāmena pañcamaṃ ",
  "ja150:7.3": "āsiṃso itthī varuṇaṃ apāyi ",
  "ja150:7.4": "littavaggena te dasa ",
  "ja150:7.5": "parosataṃ haṃsi sarikkhaṃ ",
  "ja150:7.6": "asampadaṃ pāpasevivaggo ",
  "ja150:8.1": "ekanipātamhilaṅkataṃ. ",
  "ja150:9.1": "ekanipātaṃ niṭṭhitaṃ. "
}
