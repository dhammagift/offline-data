  "ja233:0.3": "",
  "ja233:0.4": "3 vikaṇṇakajātakaṃ ",
  "ja233:1.1": "kāmaṃ yahiṃ icchasi tena gaccha ",
  "ja233:1.2": "viddhosi mammamhi vikaṇṇakena ",
  "ja233:1.3": "hatosi bhattena savāditena ",
  "ja233:1.4": "lolova macche anubandhamāno. ",
  "ja233:2.1": "evampi lokāmisamopatanto ",
  "ja233:2.2": "vihaññati cittavasānuvattī ",
  "ja233:2.3": "so haññati ñātisakhāna majjhe ",
  "ja233:2.4": "macchānugo soriva suṃsumāroti. ",
  "ja233:3.1": "vikaṇṇakajātakaṃ tatiyaṃ. "
}
