  "ja296:0.3": "",
  "ja296:0.4": "6 samuddajātakaṃ ",
  "ja296:1.1": "ko nvāyaṃ loṇatoyasmiṃ ",
  "ja296:1.2": "samantā paridhāvati ",
  "ja296:1.3": "macche makare ca vāreti ",
  "ja296:1.4": "ūmīsu ca vihaññati. ",
  "ja296:2.1": "anantapāyī sakuṇo ",
  "ja296:2.2": "atittoti disā suto ",
  "ja296:2.3": "samuddaṃ pātumicchāmi ",
  "ja296:2.4": "sāgaraṃ saritappatiṃ. ",
  "ja296:3.1": "soyaṃ hāyatī ceva ",
  "ja296:3.2": "pūrateva mahodadhi ",
  "ja296:3.3": "nāssa nāyati pītanto ",
  "ja296:3.4": "apeyyo kira sāgaroti. ",
  "ja296:4.1": "samuddajātakaṃ chaṭṭhaṃ. "
}
