  "ja400:0.3": "",
  "ja400:0.4": "5 dabbapupphajātakaṃ ",
  "ja400:1.1": "anutīracārī bhaddante ",
  "ja400:1.2": "sahāyamanudhāva maṃ ",
  "ja400:1.3": "mahā me gahito maccho ",
  "ja400:1.4": "so maṃ harati vegasā. ",
  "ja400:2.1": "gambhīracārī bhaddante ",
  "ja400:2.2": "daḷhaṃ gaṇhāhi thāmasā ",
  "ja400:2.3": "ahaṃ taṃ uddharissāmi ",
  "ja400:2.4": "supaṇṇo uragammiva. ",
  "ja400:3.1": "vivādo no samuppanno ",
  "ja400:3.2": "dabbapuppha suṇohi me ",
  "ja400:3.3": "samehi medhagaṃ samma ",
  "ja400:3.4": "vivādo vūpasammatu. ",
  "ja400:4.1": "dhammaṭṭhohaṃ pure āsiṃ ",
  "ja400:4.2": "bahuaṭṭaṃva tīritaṃ ",
  "ja400:4.3": "samemi medhagaṃ samma ",
  "ja400:4.4": "vivādo vūpasammatu. ",
  "ja400:5.1": "anutīracārī naṅguṭṭhaṃ ",
  "ja400:5.2": "sīsaṃ gambhīracārino ",
  "ja400:5.3": "accāyaṃ majjhimokhaṇḍo ",
  "ja400:5.4": "dhammaṭṭhassa bhavissati. ",
  "ja400:6.1": "ciraṃpi bhakkho abhavissa ",
  "ja400:6.2": "sace na vivademase ",
  "ja400:6.3": "asīsakaṃ anaṅguṭṭhaṃ ",
  "ja400:6.4": "sigālo harati rohitaṃ. ",
  "ja400:7.1": "yathāpi rājā nandeyya ",
  "ja400:7.2": "rajjaṃ laddhāna khattiyo ",
  "ja400:7.3": "evāhamajja nandāmi ",
  "ja400:7.4": "disvā puṇṇamukhaṃ patiṃ. ",
  "ja400:8.1": "kathannu thalajo santo ",
  "ja400:8.2": "udake macchaṃ parāmasi ",
  "ja400:8.3": "puṭṭho me samma akkhāhi ",
  "ja400:8.4": "kathaṃ adhigataṃ tayā. ",
  "ja400:9.1": "vivādena kisā honti ",
  "ja400:9.2": "vivādena dhanakkhayā ",
  "ja400:9.3": "jinā uddā vivādena ",
  "ja400:9.4": "bhuñja māyāvi rohitaṃ. ",
  "ja400:10.1": "evameva manussesu ",
  "ja400:10.2": "vivādo yattha jāyati. ",
  "ja400:10.3": "dhammaṭṭhaṃ paṭidhāvanti ",
  "ja400:10.4": "so hi nesaṃ vināyako ",
  "ja400:10.5": "dhanāpi tattha jīyanti ",
  "ja400:10.6": "rājakoso pavaḍḍhatīti. ",
  "ja400:11.1": "dabbapupphajātakaṃ pañcamaṃ. "
}
