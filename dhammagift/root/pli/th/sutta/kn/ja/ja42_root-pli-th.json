  "ja42:0.4": "2 kapotakajātakaṃ ",
  "ja42:1.1": "yo atthakāmassa hitānukampino ",
  "ja42:1.2": "ovajjamāno na karoti sāsanaṃ ",
  "ja42:1.3": "kapotakassa vacanaṃ akatvā ",
  "ja42:1.4": "amittahatthatthagatova setīti. ",
  "ja42:2.1": "kapotakajātakaṃ dutiyaṃ. "
}
