  "ja60:0.3": "",
  "ja60:0.4": "10 saṅkhadhamanajātakaṃ ",
  "ja60:1.1": "dhame dhame nātidhame ",
  "ja60:1.2": "atidhantaṃ hi pāpakaṃ ",
  "ja60:1.3": "dhantenādhigatā bhogā ",
  "ja60:1.4": "te tāto vidhamī dhamanti. ",
  "ja60:2.1": "saṅkhadhamanajātakaṃ dasamaṃ. ",
  "ja60:2.2": "āsiṃsavaggo chaṭṭho. ",
  "ja60:3.1": "tassuddānaṃ. ",
  "ja60:4.1": "yathā icchi tathāhu dakā thalā ",
  "ja60:4.2": "sura sāduphalova alīnamano ",
  "ja60:4.3": "saṃpahaṭṭhamano caturo ca tayo ",
  "ja60:4.4": "sataladdhakabhogamanena dasa. "
}
