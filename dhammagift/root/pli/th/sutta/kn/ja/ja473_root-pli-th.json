  "ja473:0.3": "",
  "ja473:0.4": "10 mittāmittajātakaṃ ",
  "ja473:1.1": "kāni kammāni kubbānaṃ ",
  "ja473:1.2": "kathaṃ viññū parakkame ",
  "ja473:1.3": "amittaṃ jāneyya medhāvī ",
  "ja473:1.4": "disvā sutvā ca paṇḍito. ",
  "ja473:2.1": "na naṃ umhayate disvā ",
  "ja473:2.2": "na ca naṃ paṭinandati ",
  "ja473:2.3": "cakkhūnissa na dadāti ",
  "ja473:2.4": "paṭilomañca vattati. ",
  "ja473:3.1": "amitte tassa bhajati ",
  "ja473:3.2": "mitte tassa na sevati ",
  "ja473:3.3": "vaṇṇakāme nivāreti ",
  "ja473:3.4": "akkosante pasaṃsati. ",
  "ja473:4.1": "guyhañca tassa nakkhāti ",
  "ja473:4.2": "tassa guyhaṃ na gūhati ",
  "ja473:4.3": "kammaṃ tassa na vaṇṇeti ",
  "ja473:4.4": "paññassa nappasaṃsati. ",
  "ja473:5.1": "abhave nandati tassa ",
  "ja473:5.2": "bhave tassa na nandati ",
  "ja473:5.3": "acchariyaṃ bhojanaṃ laddhā ",
  "ja473:5.4": "tassa nuppajjate sati ",
  "ja473:5.5": "tato naṃ nānukampati ",
  "ja473:5.6": "ahāsopi labheyyito. ",
  "ja473:6.1": "iccete soḷasākārā ",
  "ja473:6.2": "amittasmiṃ patiṭṭhitā ",
  "ja473:6.3": "yehi amittaṃ jāneyya ",
  "ja473:6.4": "disvā sutvā ca paṇḍito. ",
  "ja473:7.1": "kāni kammāni kubbānaṃ ",
  "ja473:7.2": "kathaṃ viññū parakkame ",
  "ja473:7.3": "mittaṃ jāneyya medhāvī ",
  "ja473:7.4": "disvā sutvā ca paṇḍito. ",
  "ja473:8.1": "pavutthañcassa sarati ",
  "ja473:8.2": "āgataṃ abhinandati ",
  "ja473:8.3": "tato kelāyiko hoti ",
  "ja473:8.4": "vācāya paṭinandati. ",
  "ja473:9.1": "mitte tasseva bhajati ",
  "ja473:9.2": "amitte tassa na sevati ",
  "ja473:9.3": "akkosante nivāreti ",
  "ja473:9.4": "vaṇṇakāme pasaṃsati. ",
  "ja473:10.1": "guyhañca tassa akkhāti ",
  "ja473:10.2": "tassa guyhañca gūhati ",
  "ja473:10.3": "kammañca tassa vaṇṇeti ",
  "ja473:10.4": "paññamassa pasaṃsati. ",
  "ja473:11.1": "bhave ca nandati tassa ",
  "ja473:11.2": "abhave tassa na nandati ",
  "ja473:11.3": "acchariyaṃ bhojanaṃ laddhā ",
  "ja473:11.4": "tassa uppajjate sati ",
  "ja473:11.5": "tato naṃ anukampati ",
  "ja473:11.6": "pahāsopi labheyyito. ",
  "ja473:12.1": "iccete soḷasākārā ",
  "ja473:12.2": "mittasmiṃ supatiṭṭhitā ",
  "ja473:12.3": "yehi mittañca jāneyya ",
  "ja473:12.4": "disvā sutvā ca paṇḍitoti. ",
  "ja473:13.1": "mittāmittajātakaṃ dasamaṃ. ",
  "ja473:14.1": "",
  "ja473:15.1": "tassuddānaṃ. ",
  "ja473:16.1": "lahucitta sasāla kasanti puna ",
  "ja473:16.2": "atha kāma dasakhaluṭṭhānavaro ",
  "ja473:16.3": "atha kaṇha sukosiya meṇḍavaro ",
  "ja473:16.4": "padumo puna mittavarena dasa. dvādasanipātaṃ niṭṭhitaṃ. "
}
