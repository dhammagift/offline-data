  "ja140:0.3": "",
  "ja140:0.4": "10 kākajātakaṃ ",
  "ja140:1.1": "niccaṃ ubbiggahadayā ",
  "ja140:1.2": "sabbalokavihesakā ",
  "ja140:1.3": "tasmā nesaṃ vasā natthi ",
  "ja140:1.4": "kākānamhāka ñātinanti. ",
  "ja140:2.1": "kākajātakaṃ dasamaṃ. ",
  "ja140:2.2": "asampadānavaggo cuddasamo. ",
  "ja140:3.1": "tassuddānaṃ. ",
  "ja140:4.1": "itarītara rakkhasi khemiyo ca ",
  "ja140:4.2": "parosatapañhena ābhassaro puna ",
  "ja140:4.3": "atha haṃsavaruttama babbu jaṭaṃ ",
  "ja140:4.4": "paṭanaṭṭhaka kākavarena dasa. "
}
