  "ja86:0.4": "6 sīlavīmaṃsanajātakaṃ ",
  "ja86:1.1": "sīlaṃ kireva kalyāṇaṃ ",
  "ja86:1.2": "sīlaṃ loke anuttaraṃ ",
  "ja86:1.3": "passa ghoraviso nāgo ",
  "ja86:1.4": "sīlavāti na haññatīti. ",
  "ja86:2.1": "sīlavīmaṃsanajātakaṃ chaṭṭhaṃ. "
}
