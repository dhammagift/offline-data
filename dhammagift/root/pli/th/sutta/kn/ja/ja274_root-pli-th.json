  "ja274:0.3": "",
  "ja274:0.4": "4 lolajātakaṃ ",
  "ja274:1.1": "kāya balākā sikhinī ",
  "ja274:1.2": "corī laṅghīpitāmahā ",
  "ja274:1.3": "oraṃ balāke āgaccha ",
  "ja274:1.4": "caṇḍo me vāyaso sakhā. ",
  "ja274:2.1": "nāhaṃ balākā sikhinī ",
  "ja274:2.2": "ahaṃ lolasmi vāyaso ",
  "ja274:2.3": "akatvā vacanaṃ tuyhaṃ ",
  "ja274:2.4": "passa lūnosmi āgato. ",
  "ja274:3.1": "puna pāpajjasī samma ",
  "ja274:3.2": "sīlaṃ hi tava tādisaṃ ",
  "ja274:3.3": "nahi mānusikā bhogā ",
  "ja274:3.4": "subhuñjā honti pakkhināti. ",
  "ja274:4.1": "lolajātakaṃ catutthaṃ. "
}
