  "ja246:0.3": "",
  "ja246:0.4": "6 bālovādajātakaṃ ",
  "ja246:1.1": "hantvā ghatvā vadhitvā ca ",
  "ja246:1.2": "deti dānaṃ asaññato ",
  "ja246:1.3": "īdisaṃ bhattaṃ bhuñjamāno ",
  "ja246:1.4": "sa pāpa mupalimpati. ",
  "ja246:2.1": "puttadārampi ce hantvā ",
  "ja246:2.2": "deti dānaṃ asaññato ",
  "ja246:2.3": "bhuñjamānopi sappañño ",
  "ja246:2.4": "na pāpa 2 mupalimpatīti. ",
  "ja246:3.1": "bālovādajātakaṃ chaṭṭhaṃ. "
}
