  "ja112:0.4": "2 amarādevīpañho ",
  "ja112:1.1": "yena sattuvilaṅgā ca ",
  "ja112:1.2": "diguṇapalāso ca pupphito ",
  "ja112:1.3": "yenādāmi tena vadāmi ",
  "ja112:1.4": "yena nādāmi na tena vadāmi ",
  "ja112:1.5": "esa maggo yavamajjhakassa ",
  "ja112:1.6": "etaṃ channapathaṃ vijānāhīti. ",
  "ja112:2.1": "amarādevīpañho dutiyo. "
}
