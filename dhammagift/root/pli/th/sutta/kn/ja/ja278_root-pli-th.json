{
  "ja278:0.1": "",
  "ja278:0.2": "",
  "ja278:0.3": "",
  "ja278:0.4": "8 himasajātakaṃ ",
  "ja278:1.1": "kimatthamabhisandhāya ",
  "ja278:1.2": "lahucittassa dubbhino ",
  "ja278:1.3": "sabbakāmaduhasseva ",
  "ja278:1.4": "imaṃ dukkhaṃ titikkhasi. ",
  "ja278:2.1": "siṅgena nīharāsetaṃ ",
  "ja278:2.2": "padasāva adhiṭṭhaha ",
  "ja278:2.3": "bhiyyo bālā pakuṭṭeyyuṃ ",
  "ja278:2.4": "no cassa paṭisedhako. ",
  "ja278:3.1": "mamevāyaṃ maññamāno ",
  "ja278:3.2": "aññaṃpevaṃ karissati ",
  "ja278:3.3": "te naṃ tattha vadhissanti ",
  "ja278:3.4": "sā me mutti bhavissatīti. ",
  "ja278:4.1": "mahisajātakaṃ aṭṭhamaṃ. "
}
