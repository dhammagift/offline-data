{
  "dhp21:0.1": "",
  "dhp21:0.2": "",
  "dhp21:0.3": "dhammapadagāthāya dutiyo appamādavaggo ",
  "dhp21:0.4": "",
  "dhp21:1": "2 appamādo amataṃ padaṃ ",
  "dhp21:2": "pamādo maccuno padaṃ ",
  "dhp21:3": "appamattā na mīyanti ",
  "dhp21:4": "ye pamattā yathā matā etaṃ ",
  "dhp22:1": "visesato ñatvā ",
  "dhp22:2": "appamādamhi paṇḍitā ",
  "dhp22:3": "appamāde pamodanti ",
  "dhp22:4": "ariyānaṃ gocare ratā ",
  "dhp23:1": "te jhāyino sātatikā ",
  "dhp23:2": "niccaṃ daḷhaparakkamā ",
  "dhp23:3": "phusanti dhīrā nibbānaṃ ",
  "dhp23:4": "yogakkhemaṃ anuttaraṃ. ",
  "dhp24:0": "",
  "dhp24:1": "uṭṭhānavato satimato ",
  "dhp24:2": "sucikammassa nisammakārino ",
  "dhp24:3": "saññatassa ca dhammajīvino ",
  "dhp24:4": "appamattassa yaso bhivaḍḍhati. ",
  "dhp25:0": "",
  "dhp25:1": "uṭṭhānenappamādena ",
  "dhp25:2": "saññamena damena ca ",
  "dhp25:3": "dīpaṃ kayirātha medhāvī ",
  "dhp25:4": "yaṃ ogho nābhikīrati. ",
  "dhp26:0": "",
  "dhp26:1": "pamādamanuyuñjanti ",
  "dhp26:2": "bālā dummedhino janā ",
  "dhp26:3": "appamādañca medhāvī ",
  "dhp26:4": "dhanaṃ seṭṭhaṃva rakkhati. ",
  "dhp27:1": "mā pamādamanuyuñjetha ",
  "dhp27:2": "mā kāmaratisanthavaṃ ",
  "dhp27:3": "appamatto hi jhāyanto ",
  "dhp27:4": "pappoti vipulaṃ sukhaṃ. ",
  "dhp28:0": "",
  "dhp28:1": "pamādaṃ appamādena ",
  "dhp28:2": "yadā nudati paṇḍito ",
  "dhp28:3": "paññāpāsādamāruyha ",
  "dhp28:4": "asoko sokiniṃ pajaṃ ",
  "dhp28:5": "pabbataṭṭhova bhummaṭṭhe ",
  "dhp28:6": "dhīro bāle avekkhati. ",
  "dhp29:0": "",
  "dhp29:1": "appamatto pamattesu ",
  "dhp29:2": "suttesu bahujāgaro ",
  "dhp29:3": "abalassaṃva sīghasso ",
  "dhp29:4": "hitvā yāti sumedhaso. ",
  "dhp30:0": "",
  "dhp30:1": "appamādena maghavā ",
  "dhp30:2": "devānaṃ seṭṭhataṃ gato ",
  "dhp30:3": "appamādaṃ pasaṃsanti ",
  "dhp30:4": "pamādo garahito sadā. ",
  "dhp31:0": "",
  "dhp31:1": "appamādarato bhikkhu ",
  "dhp31:2": "pamāde bhayadassi vā ",
  "dhp31:3": "saññojanaṃ aṇuṃ thūlaṃ ",
  "dhp31:4": "ḍahaṃ aggīva gacchati. ",
  "dhp32:0": "",
  "dhp32:1": "appamādarato bhikkhu ",
  "dhp32:2": "pamāde bhayadassi vā ",
  "dhp32:3": "abhabbo parihānāya ",
  "dhp32:4": "nibbānasseva santike. ",
  "dhp32:5": "appamādavaggo dutiyo. "
}
