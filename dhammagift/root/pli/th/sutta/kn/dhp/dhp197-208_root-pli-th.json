{
  "dhp197:0.1": "",
  "dhp197:0.2": "",
  "dhp197:0.3": "dhammapadagāthāya paṇṇarasamo sukhavaggo ",
  "dhp197:0.4": "",
  "dhp197:1": "15 susukhaṃ vata jīvāma ",
  "dhp197:2": "verinesu averino ",
  "dhp197:3": "verinesu manussesu ",
  "dhp197:4": "viharāma averino. ",
  "dhp198:1": "susukhaṃ vata jīvāma ",
  "dhp198:2": "āturesu anāturā ",
  "dhp198:3": "āturesu manussesu ",
  "dhp198:4": "viharāma anāturā. ",
  "dhp199:1": "susukhaṃ vata jīvāma ",
  "dhp199:2": "ussukesu anussukā ",
  "dhp199:3": "ussukesu manussesu ",
  "dhp199:4": "viharāma anussukā. ",
  "dhp200:0": "",
  "dhp200:1": "susukhaṃ vata jīvāma ",
  "dhp200:2": "yesanno natthi kiñcanaṃ ",
  "dhp200:3": "pītibhakkhā bhavissāma ",
  "dhp200:4": "devā ābhassarā yathā. ",
  "dhp201:0": "",
  "dhp201:1": "jayaṃ veraṃ pasavati ",
  "dhp201:2": "dukkhaṃ seti parājito ",
  "dhp201:3": "upasanto sukhaṃ seti ",
  "dhp201:4": "hitvā jayaparājayaṃ. ",
  "dhp202:0": "",
  "dhp202:1": "natthi rāgasamo aggi ",
  "dhp202:2": "natthi dosasamo kali ",
  "dhp202:3": "natthi khandhādisā dukkhā ",
  "dhp202:4": "natthi santiparaṃ sukhaṃ. jighacchā paramā ",
  "dhp203:0": "",
  "dhp203:1": "rogā ",
  "dhp203:2": "saṅkhārā paramā dukkhā ",
  "dhp203:3": "etaṃ ñatvā yathābhūtaṃ ",
  "dhp203:4": "nibbānaṃ paramaṃ sukhaṃ. ",
  "dhp204:0": "",
  "dhp204:1": "ārogyaparamā lābhā ",
  "dhp204:2": "santuṭṭhīparamaṃ dhanaṃ ",
  "dhp204:3": "vissāsaparamā ñāti ",
  "dhp204:4": "nibbānaṃ paramaṃ sukhaṃ. ",
  "dhp205:0": "",
  "dhp205:1": "pavivekarasaṃ pitvā ",
  "dhp205:2": "rasaṃ upasamassa ca ",
  "dhp205:3": "niddaro hoti nippāpo ",
  "dhp205:4": "dhammapītirasaṃ pivaṃ. sādhu ",
  "dhp206:0": "",
  "dhp206:1": "dassanamariyānaṃ ",
  "dhp206:2": "sannivāso sadā sukho ",
  "dhp206:3": "adassanena bālānaṃ ",
  "dhp206:4": "niccameva sukhī siyā. ",
  "dhp207:1": "bālasaṅgatacārī hi ",
  "dhp207:2": "dīghamaddhāna socati ",
  "dhp207:3": "dukkho bālehi saṃvāso ",
  "dhp207:4": "amitteneva sabbadā. ",
  "dhp207:5": "dhīro ca sukhasaṃvāso ",
  "dhp207:6": "ñātīnaṃva samāgamo ",
  "dhp208:1": "tasmā hi ",
  "dhp208:2": "dhīrañca paññañca bahussutañca ",
  "dhp208:3": "dhorayhasīlaṃ vatavantamariyaṃ ",
  "dhp208:4": "taṃ tādisaṃ sappurisaṃ sumedhaṃ ",
  "dhp208:5": "bhajetha nakkhattapathaṃva candimā. ",
  "dhp208:6": "sukhavaggo paṇṇarasamo. "
}
