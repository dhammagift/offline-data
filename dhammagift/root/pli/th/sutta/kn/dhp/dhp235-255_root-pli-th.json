  "dhp235:0.4": "",
  "dhp235:1": "",
  "dhp235:2": "yamapurisāpi ca taṃ upaṭṭhitā ",
  "dhp235:3": "uyyogamukhe ca tiṭṭhasi ",
  "dhp235:4": "pātheyyampi ca te na vijjati. ",
  "dhp236:1": "so karohi dīpamattano ",
  "dhp236:2": "khippaṃ vāyama paṇḍito bhava ",
  "dhp236:3": "niddhantamalo anaṅgaṇo ",
  "dhp236:4": "dibbaṃ ariyabhūmimehisi. ",
  "dhp237:1": "upanītavayo va dānisi ",
  "dhp237:2": "sampayātosi yamassa santikaṃ ",
  "dhp237:3": "vāsopi ca te natthi antarā ",
  "dhp237:4": "pātheyyampi ca te na vijjati. ",
  "dhp238:1": "so karohi dīpamattano ",
  "dhp238:2": "khippaṃ vāyama paṇḍito bhava ",
  "dhp238:3": "niddhantamalo anaṅgaṇo ",
  "dhp238:4": "na puna jātijaraṃ upehisi. ",
  "dhp239:0": "",
  "dhp239:1": "anupubbena medhāvī ",
  "dhp239:2": "thokaṃ thokaṃ khaṇe khaṇe ",
  "dhp239:3": "kammāro rajatasseva ",
  "dhp239:4": "niddhame malamattano. ayasā va ",
  "dhp240:0": "",
  "dhp240:1": "malaṃ samuṭṭhitaṃ ",
  "dhp240:2": "taduṭṭhāya tameva khādati ",
  "dhp240:3": "evaṃ atidhonacārinaṃ ",
  "dhp240:4": "sāni kammāni nayanti duggatiṃ. ",
  "dhp241:0": "",
  "dhp241:1": "asajjhāyamalā mantā ",
  "dhp241:2": "anuṭṭhānamalā gharā ",
  "dhp241:3": "malaṃ vaṇṇassa kosajjaṃ ",
  "dhp241:4": "pamādo rakkhato malaṃ. ",
  "dhp242:0": "",
  "dhp242:1": "malitthiyā duccaritaṃ ",
  "dhp242:2": "maccheraṃ dadato malaṃ ",
  "dhp242:3": "malā ve pāpakā dhammā ",
  "dhp242:4": "asmiṃ loke paramhi ca ",
  "dhp243:1": "tato malā malataraṃ ",
  "dhp243:2": "avijjā paramaṃ malaṃ ",
  "dhp243:3": "etaṃ malaṃ pahatvāna ",
  "dhp243:4": "nimmalā hotha bhikkhavo. ",
  "dhp244:0": "",
  "dhp244:1": "sujīvaṃ ahirikena ",
  "dhp244:2": "kākasūrena dhaṃsinā ",
  "dhp244:3": "pakkhandinā pagabbhena ",
  "dhp244:4": "saṅkiliṭṭhena jīvitaṃ. ",
  "dhp245:1": "hirīmatā ca dujjīvaṃ ",
  "dhp245:2": "niccaṃ sucigavesinā ",
  "dhp245:3": "alīnenāpagabbhena ",
  "dhp245:4": "suddhājīvena passatā. ",
  "dhp246:0": "",
  "dhp246:1": "yo pāṇamatimāpeti ",
  "dhp246:2": "musāvādañca bhāsati ",
  "dhp246:3": "loke adinnaṃ ādiyati ",
  "dhp246:4": "paradārañca gacchati ",
  "dhp247:1": "surāmerayapānañca ",
  "dhp247:2": "yo naro anuyuñjati ",
  "dhp247:3": "idhevameso lokasmiṃ ",
  "dhp247:4": "mūlaṃ khanati attano. ",
  "dhp248:1": "evaṃ bho purisa jānāhi ",
  "dhp248:2": "pāpadhammā asaññatā ",
  "dhp248:3": "mā naṃ lobho adhammo ca ",
  "dhp248:4": "ciraṃ dukkhāya randhayuṃ. ",
  "dhp249:0": "",
  "dhp249:1": "dadāti ve yathāsaddhaṃ ",
  "dhp249:2": "yathāpasādanaṃ jano ",
  "dhp249:3": "tattha yo maṅkuto hoti ",
  "dhp249:4": "paresaṃ pānabhojane ",
  "dhp249:5": "na so divā vā rattiṃ vā ",
  "dhp249:6": "samādhiṃ adhigacchati. yassacetaṃ ",
  "dhp250:1": "samucchinnaṃ ",
  "dhp250:2": "mulaghaccaṃ samūhataṃ ",
  "dhp250:3": "sa ve divā vā rattiṃ vā ",
  "dhp250:4": "samādhiṃ adhigacchati. ",
  "dhp251:0": "",
  "dhp251:1": "natthi rāgasamo aggi ",
  "dhp251:2": "natthi dosasamo gaho ",
  "dhp251:3": "natthi mohasamaṃ jālaṃ ",
  "dhp251:4": "natthi taṇhāsamā nadī. ",
  "dhp252:0": "",
  "dhp252:1": "sudassaṃ vajjamaññesaṃ ",
  "dhp252:2": "attano pana duddasaṃ ",
  "dhp252:3": "paresaṃ hi so vajjāni ",
  "dhp252:4": "opunāti yathābhusaṃ ",
  "dhp252:5": "attano pana chādeti ",
  "dhp252:6": "kaliṃva kitavā saṭho. ",
  "dhp253:0": "",
  "dhp253:1": "paravajjānupassissa ",
  "dhp253:2": "niccaṃ ujjhānasaññino ",
  "dhp253:3": "āsavā tassa vaḍḍhanti ",
  "dhp253:4": "ārā so āsavakkhayā. ",
  "dhp254:0": "",
  "dhp254:1": "ākāseva padaṃ natthi ",
  "dhp254:2": "samaṇo natthi bāhiro ",
  "dhp254:3": "papañcābhiratā pajā ",
  "dhp254:4": "nippapañcā tathāgatā. ",
  "dhp255:1": "ākāseva padaṃ natthi ",
  "dhp255:2": "samaṇo natthi bāhiro ",
  "dhp255:3": "saṅkhārā sassatā natthi ",
  "dhp255:4": "natthi buddhānamiñjitaṃ. ",
  "dhp255:5": "malavaggo aṭṭhārasamo. dhammapadagāthāya ekūnavīsatimo dhammaṭṭhavaggo 19 "
}
