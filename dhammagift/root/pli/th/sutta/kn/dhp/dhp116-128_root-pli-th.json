{
  "dhp116:0.1": "",
  "dhp116:0.2": "",
  "dhp116:0.3": "dhammapadagāthāya navamo pāpavaggo ",
  "dhp116:0.4": "",
  "dhp116:1": "9 abhittharetha kalyāṇe ",
  "dhp116:2": "pāpā cittaṃ nivāraye ",
  "dhp116:3": "dandhaṃ hi karato puññaṃ ",
  "dhp116:4": "pāpasmiṃ ramatī mano. ",
  "dhp117:0": "",
  "dhp117:1": "pāpañce puriso kayirā ",
  "dhp117:2": "na naṃ kayirā punappunaṃ ",
  "dhp117:3": "na tamhi chandaṃ kayirātha ",
  "dhp117:4": "dukkho pāpassa uccayo. ",
  "dhp118:0": "",
  "dhp118:1": "puññañce puriso kayirā ",
  "dhp118:2": "kayirāthenaṃ punappunaṃ ",
  "dhp118:3": "tamhi chandaṃ kayirātha ",
  "dhp118:4": "sukho puññassa uccayo. ",
  "dhp119:0": "",
  "dhp119:1": "pāpopi passati bhadraṃ ",
  "dhp119:2": "yāva pāpaṃ na paccati ",
  "dhp119:3": "yadā ca paccati pāpaṃ ",
  "dhp119:4": "atha (pāpo) pāpāni passati. ",
  "dhp120:1": "bhadropi passati pāpaṃ ",
  "dhp120:2": "yāva bhadraṃ na paccati ",
  "dhp120:3": "yadā ca paccati bhadraṃ ",
  "dhp120:4": "atha (bhadro) bhadrāni passati. ",
  "dhp121:0": "",
  "dhp121:1": "māvamaññetha pāpassa ",
  "dhp121:2": "na mattaṃ āgamissati ",
  "dhp121:3": "udabindunipātena ",
  "dhp121:4": "udakumbhopi pūrati āpūrati ",
  "dhp121:5": "bālo pāpassa ",
  "dhp121:6": "thokaṃ thokaṃpi ācinaṃ. ",
  "dhp122:0": "",
  "dhp122:1": "māvamaññetha puññassa ",
  "dhp122:2": "na mattaṃ āgamissati ",
  "dhp122:3": "udabindunipātena ",
  "dhp122:4": "udakumbhopi pūrati āpūrati ",
  "dhp122:5": "dhīro puññassa ",
  "dhp122:6": "thokaṃ thokaṃpi ācinaṃ. ",
  "dhp123:0": "",
  "dhp123:1": "vāṇijova bhayaṃ maggaṃ ",
  "dhp123:2": "appasattho mahaddhano ",
  "dhp123:3": "visaṃ jīvitukāmova ",
  "dhp123:4": "pāpāni parivajjaye. ",
  "dhp124:0": "",
  "dhp124:1": "pāṇimhi ce vaṇo nāssa ",
  "dhp124:2": "hareyya pāṇinā visaṃ ",
  "dhp124:3": "nābbaṇaṃ visamanveti ",
  "dhp124:4": "natthi pāpaṃ akubbato. ",
  "dhp125:0": "",
  "dhp125:1": "yo appaduṭṭhassa narassa dussati ",
  "dhp125:2": "suddhassa posassa anaṅgaṇassa ",
  "dhp125:3": "tameva bālaṃ pacceti pāpaṃ ",
  "dhp125:4": "sukhumo rajo paṭivātaṃva khitto. ",
  "dhp126:0": "",
  "dhp126:1": "gabbhameke upapajjanti ",
  "dhp126:2": "nirayaṃ pāpakammino ",
  "dhp126:3": "saggaṃ sugatino yanti ",
  "dhp126:4": "parinibbanti anāsavā. ",
  "dhp127:0": "",
  "dhp127:1": "na antalikkhe na samuddamajjhe ",
  "dhp127:2": "na pabbatānaṃ vivaraṃ pavīsaṃ ",
  "dhp127:3": "na vijjatī so jagatippadeso ",
  "dhp127:4": "yatraṭṭhito muñceyya pāpakammā. ",
  "dhp128:0": "",
  "dhp128:1": "na antalikkhe na samuddamajjhe ",
  "dhp128:2": "na pabbatānaṃ vivaraṃ pavīsaṃ ",
  "dhp128:3": "na vijjatī so jagatippadeso ",
  "dhp128:4": "yatraṭṭhitaṃ nappasaheyya maccu. ",
  "dhp128:5": "pāpavaggo navamo. "
}
