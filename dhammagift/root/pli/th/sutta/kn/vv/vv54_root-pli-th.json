  "vv54:0.3": "",
  "vv54:0.4": "",
  "vv54:1.1": "4 uccamidaṃ maṇithūṇaṃ vimānaṃ ",
  "vv54:1.2": "samantato dvādasa yojanāni ",
  "vv54:1.3": "kūṭāgārā sattasatā uḷārā ",
  "vv54:1.4": "veḷuriyatthambhā ruciratthatā subhā ",
  "vv54:2.1": "tatthacchasi pivasi khādasi ca ",
  "vv54:2.2": "dibbā ca vīṇā pavadanti vaggū ",
  "vv54:2.3": "dibbā rasā kāmaguṇettha pañca ",
  "vv54:2.4": "nāriyo ca naccanti suvaṇṇachannā ",
  "vv54:3.1": "kena te tādiso vaṇṇo ",
  "vv54:3.2": "kena te idhamijjhati ",
  "vv54:3.3": "uppajjanti ca te bhogā ",
  "vv54:3.4": "ye keci manaso piyā ",
  "vv54:4.1": "pucchāmi taṃ deva mahānubhāva ",
  "vv54:4.2": "manussabhūto kimakāsi puññaṃ ",
  "vv54:4.3": "kenāsi evañjalitānubhāvo ",
  "vv54:4.4": "vaṇṇo ca te sabbadisā pabhāsatīti. ",
  "vv54:5.1": "so devaputto attamano ",
  "vv54:5.2": "moggallānena pucchito ",
  "vv54:5.3": "pañhaṃ puṭṭho viyākāsi ",
  "vv54:5.4": "yassa kammassidaṃ phalaṃ ",
  "vv54:6.1": "sati samuppādakaro ",
  "vv54:6.2": "dvāre kakkaṭako ṭhito ",
  "vv54:6.3": "niṭṭhito jātarūpassa ",
  "vv54:6.4": "sobhati dasapādako ",
  "vv54:7.1": "tena me tādiso vaṇṇo ",
  "vv54:7.2": "tena me idhamijjhati ",
  "vv54:7.3": "uppajjanti ca me bhogā ",
  "vv54:7.4": "ye keci manaso piyā ",
  "vv54:8.1": "",
  "vv54:8.2": "",
  "vv54:8.3": "tenamhi evañjalitānubhāvo ",
  "vv54:8.4": "vaṇṇo ca me sabbadisā pabhāsatīti. ",
  "vv54:9.1": "kakkaṭarasadāyakavimānaṃ catutthaṃ ",
  "vv54:10.1": "itaraṃ pañcavimānaṃ yathā kakkaṭavimānaṃ tathā vitthāretabbaṃ. "
}
