  "vv33:104.2": "kāhāmi kusalaṃ bahuṃ ",
  "vv33:104.3": "dānena samacariyāya ",
  "vv33:104.4": "saṃyamena damena ca ",
  "vv33:104.5": "sāhaṃ tattha gamissāmi ",
  "vv33:104.6": "yattha gantvā na socareti. ",
  "vv33:105.1": "guttilavimānaṃ pañcamaṃ. 6 "
}
