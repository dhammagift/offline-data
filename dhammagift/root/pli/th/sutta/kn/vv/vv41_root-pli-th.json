  "vv41:0.4": "",
  "vv41:1.1": "alaṅkatā kanakakañcanācitaṃ ",
  "vv41:1.2": "suvaṇṇajālacittaṃ mahantaṃ ",
  "vv41:1.3": "abhiruyha gajavaraṃ sukappitaṃ ",
  "vv41:1.4": "idhāgamā vehāsayaṃ antalikkhe ",
  "vv41:2.1": "nāgassa dantesu duvesu nimmitā ",
  "vv41:2.2": "acchodakā paduminiyo suphullā ",
  "vv41:2.3": "padumesu turiyagaṇā pavajjare ",
  "vv41:2.4": "imā ca naccanti manoharāyo ",
  "vv41:3.1": "deviddhipattāsi mahānubhāve ",
  "vv41:3.2": "manussabhūtā kimakāsi puññaṃ ",
  "vv41:3.3": "kenāsi evañjalitānubhāvā ",
  "vv41:3.4": "vaṇṇo ca te sabbadisā pabhāsatīti. ",
  "vv41:4.1": "bārāṇasiyaṃ upasaṅkamitvā ",
  "vv41:4.2": "buddhassāhaṃ vatthayugaṃ adāsiṃ ",
  "vv41:4.3": "pādāni vanditvā chamā nisīdiṃ ",
  "vv41:4.4": "cittāva taṃ añjalikaṃ akāsiṃ ",
  "vv41:5.1": "buddho ca me kañcanasannibhattaco ",
  "vv41:5.2": "adesayi samudayadukkhaniccataṃ ",
  "vv41:5.3": "asaṅkhataṃ dukkhanirodhasaccaṃ ",
  "vv41:5.4": "maggaṃ adesayi yato vijānissaṃ ",
  "vv41:6.1": "appāyukī kālakatā tato cutā ",
  "vv41:6.2": "upapannā tidasānaṃ yasassinī ",
  "vv41:6.3": "sakkassāhaṃ aññatarā pajāpati ",
  "vv41:6.4": "yasuttarā nāma disāsu vissutāti. ",
  "vv41:7.1": "nāgavimānaṃ tatiyaṃ. 4 "
}
