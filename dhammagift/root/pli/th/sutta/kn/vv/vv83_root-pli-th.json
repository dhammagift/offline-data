  "vv83:0.3": "",
  "vv83:0.4": "",
  "vv83:1.1": "9 alaṅkato maṭṭhakuṇḍalī ",
  "vv83:1.2": "mālādhārī haricandanussado ",
  "vv83:1.3": "bāhā paggayha kandasi ",
  "vv83:1.4": "vanamajjhe kiṃ dukkhito tuvanti. ",
  "vv83:2.1": "sovaṇṇamayo pabhassaro ",
  "vv83:2.2": "uppanno rathapañjaro mama ",
  "vv83:2.3": "tassa cakkayugaṃ na vindāmi ",
  "vv83:2.4": "tena dukkhena jahissāmi jīvitanti. ",
  "vv83:3.1": "sovaṇṇamayaṃ maṇimayaṃ ",
  "vv83:3.2": "lohitaṅgamayaṃ atha rūpiyamayaṃ ",
  "vv83:3.3": "ācikkha me tuvaṃ bhaddamāṇava ",
  "vv83:3.4": "cakkayugaṃ paṭilābhayāmi teti. ",
  "vv83:4.1": "so māṇavo tassa pāvadi ",
  "vv83:4.2": "candimasuriyā ubhayettha dissare ",
  "vv83:4.3": "sovaṇṇamayo ratho mama ",
  "vv83:4.4": "tena cakkayugena sobhatīti. ",
  "vv83:5.1": "bālo kho tvamasi māṇava ",
  "vv83:5.2": "yo tvaṃ patthayasi apatthiyaṃ ",
  "vv83:5.3": "maññāmi tuvaṃ marissasi ",
  "vv83:5.4": "na hi tuvaṃ lacchasi candimasuriye ti. ",
  "vv83:6.1": "gamanāgamanaṃpi dissati ",
  "vv83:6.2": "vaṇṇadhātu ubhayattha vīthiyā ",
  "vv83:6.3": "peto pana kālakato na dissati ",
  "vv83:6.4": "ko nīdha kandataṃ bālyataroti. ",
  "vv83:7.1": "saccaṃ kho vadesi māṇava ",
  "vv83:7.2": "ahameva kandataṃ bālyataro ",
  "vv83:7.3": "candaṃ viya dārako rudaṃ ",
  "vv83:7.4": "petaṃ kālakatābhipatthayanti ",
  "vv83:8.1": "ādittaṃ vata maṃ santaṃ ",
  "vv83:8.2": "ghatasittaṃva pāvakaṃ ",
  "vv83:8.3": "vārinā viya osiñcaṃ ",
  "vv83:8.4": "sabbaṃ nibbāpaye daraṃ ",
  "vv83:9.1": "abbūḷhaṃ vata me sallaṃ ",
  "vv83:9.2": "sokaṃ hadayanissitaṃ ",
  "vv83:9.3": "yo me sokaparetassa ",
  "vv83:9.4": "puttasokaṃ apānudi ",
  "vv83:10.1": "svāhaṃ abbūḷhasallosmi ",
  "vv83:10.2": "sītabhūtosmi nibbuto ",
  "vv83:10.3": "na socāmi na rodāmi ",
  "vv83:10.4": "tava sutvāna māṇavāti ",
  "vv83:11.1": "devatā nusi gandhabbo ",
  "vv83:11.2": "ādū sakko purindado ",
  "vv83:11.3": "ko vā tvaṃ kassa vā putto ",
  "vv83:11.4": "kathaṃ jānemu taṃ mayanti. ",
  "vv83:12.1": "yañca kandasi yañca rodasi ",
  "vv83:12.2": "puttaṃ āḷāhane sayaṃ ḍahitvā ",
  "vv83:12.3": "svāhaṃ kusalaṃ karitvāna kammaṃ ",
  "vv83:12.4": "tidasānaṃ sahabyataṃ pattoti. ",
  "vv83:13.1": "appaṃ vā bahuṃ vā na addasāmi ",
  "vv83:13.2": "dānaṃ dadantassa sake agāre ",
  "vv83:13.3": "uposathakammaṃ vā tādisaṃ ",
  "vv83:13.4": "kena kammena gatosi devalokanti. ",
  "vv83:14.1": "ābādhikohaṃ dukkhito gilāno ",
  "vv83:14.2": "ātūrarūpomhi sake nivesane ",
  "vv83:14.3": "buddhaṃ vigatarajaṃ vitiṇṇakaṅkhaṃ ",
  "vv83:14.4": "addakkhiṃ sugataṃ anomapaññaṃ ",
  "vv83:15.1": "svāhaṃ muditamano pasannacitto ",
  "vv83:15.2": "añjaliṃ akariṃ tathāgatassa ",
  "vv83:15.3": "tāhaṃ kusalaṃ karitvāna kammaṃ ",
  "vv83:15.4": "tidasānaṃ sahabyataṃ pattoti. ",
  "vv83:16.1": "acchariyaṃ vata abbhūtaṃ vata ",
  "vv83:16.2": "añjalīkammassa ayamīdiso vipāko ",
  "vv83:16.3": "ahaṃpi muditamano pasannacitto ",
  "vv83:16.4": "ajjeva buddhaṃ saraṇaṃ vajāmīti. ",
  "vv83:17.1": "ajjeva buddhaṃ saraṇaṃ vajāhi ",
  "vv83:17.2": "dhammañca saṅghañca pasannacitto ",
  "vv83:17.3": "tatheva sikkhāya padāni pañca ",
  "vv83:17.4": "akhaṇḍaphullāni samādiyassu ",
  "vv83:18.1": "pāṇātipātā viramassu khippaṃ ",
  "vv83:18.2": "loke adinnaṃ parivajjayassu ",
  "vv83:18.3": "amajjapo no ca musā bhaṇāhi ",
  "vv83:18.4": "sakena dārena ca hohi tuṭṭhoti. ",
  "vv83:19.1": "atthakāmosi me yakkha ",
  "vv83:19.2": "hitakāmosi devate ",
  "vv83:19.3": "karomi tuyhaṃ vacanaṃ ",
  "vv83:19.4": "tvamasi ācariyo mama ",
  "vv83:20.1": "upemi saraṇaṃ buddhaṃ ",
  "vv83:20.2": "dhammañcāpi anuttaraṃ ",
  "vv83:20.3": "saṅghañca naradevassa ",
  "vv83:20.4": "gacchāmi saraṇaṃ ahaṃ ",
  "vv83:21.1": "pāṇātipātā viramāmi khippaṃ ",
  "vv83:21.2": "loke adinnaṃ parivajjayāmi ",
  "vv83:21.3": "amajjapo no ca musā bhaṇāmi ",
  "vv83:21.4": "sakena dārena ca homi tuṭṭhoti. ",
  "vv83:22.1": "maṭṭhakuṇḍalivimānaṃ navamaṃ. "
}
