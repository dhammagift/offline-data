  "vv77:0.4": "",
  "vv77:1.1": "3 uccamidaṃ maṇithūṇaṃ vimānaṃ ",
  "vv77:1.2": "samantato dvādasa yojanāni ",
  "vv77:1.3": "kūṭāgārā sattasatā urāḷā ",
  "vv77:1.4": "veḷuriyatthambhā ruciratthatā subhā ",
  "vv77:2.1": "tacthacchasi pivasi khādasi ca ",
  "vv77:2.2": "dibbā ca vīṇā pavadanti vaggū ",
  "vv77:2.3": "dibbā rasā kāmaguṇettha pañca ",
  "vv77:2.4": "nāriyo ca naccanti suvaṇṇachannā ",
  "vv77:3.1": "kena te tādiso vaṇṇo … ",
  "vv77:3.2": "pe … ",
  "vv77:3.3": "vaṇṇo ca te sabbadisā pabhāsatīti. ",
  "vv77:4.1": "so devaputto attamano moggallānena pucchito … ",
  "vv77:4.2": "pe … ",
  "vv77:4.3": "yassa kammassidaṃ phalaṃ ",
  "vv77:5.1": "ahaṃ manussesu manussabhūto ",
  "vv77:5.2": "vivane pathe caṅkamaṃ akāsiṃ ",
  "vv77:5.3": "ārāmarukkhāni ca ropayissaṃ ",
  "vv77:5.4": "piyā ca me sīlavanto ahesuṃ ",
  "vv77:5.5": "annañca pānañca pasannacitto ",
  "vv77:5.6": "sakkacca dānaṃ vipulaṃ adāsiṃ ",
  "vv77:6.1": "tena me tādiso vaṇṇo … ",
  "vv77:6.2": "pe … ",
  "vv77:6.3": "vaṇṇo ca me sabbadisā pabhāsatīti. ",
  "vv77:7.1": "maṇithūṇavimānaṃ tatiyaṃ. "
}
