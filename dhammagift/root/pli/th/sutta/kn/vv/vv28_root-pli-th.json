  "vv28:0.4": "",
  "vv28:1.1": "abhikkantena vaṇṇena ",
  "vv28:1.2": "yā tvaṃ tiṭṭhasi devate ",
  "vv28:1.3": "obhāsentī disā sabbā ",
  "vv28:1.4": "osadhī viya tārakā ",
  "vv28:2.1": "kena te tādiso vaṇṇo … ",
  "vv28:2.2": "pe … ",
  "vv28:2.3": "vaṇṇo ca te sabbadisā pabhāsatīti. ",
  "vv28:3.1": "sā devatā attamanā moggallānena pucchitā … ",
  "vv28:3.2": "pe … ",
  "vv28:3.3": "yassa kammassidaṃ phalaṃ ",
  "vv28:4.1": "ahaṃ manussesu manussabhūtā ",
  "vv28:4.2": "purimāya jātiyā manussaloke ",
  "vv28:5.1": "addasaṃ virajaṃ buddhaṃ ",
  "vv28:5.2": "vippasannamanāvilaṃ ",
  "vv28:5.3": "tassa adāsihaṃ bhikkhaṃ ",
  "vv28:5.4": "pasannā sakehi pāṇihi ",
  "vv28:6.1": "tena me tādiso vaṇṇo … ",
  "vv28:6.2": "pe … ",
  "vv28:6.3": "vaṇṇo ca me sabbadisā pabhāsatīti. ",
  "vv28:7.1": "dutiyabhikkhādāyikavimānaṃ ekādasamaṃ. ",
  "vv28:8.1": "uddānaṃ ",
  "vv28:9.1": "dāsī ceva lakhumā ca ",
  "vv28:9.2": "atha ācāmadāyikā ",
  "vv28:9.3": "caṇḍālī bhadditthikā ceva ",
  "vv28:9.4": "soṇadinnā uposathā ",
  "vv28:9.5": "niddā ceva sudinnā ca ",
  "vv28:9.6": "dve ca bhikkhāyadāyikā ",
  "vv28:9.7": "vaggo tena pavuccatīti. ",
  "vv28:10.1": "itthivimāne dutiyo vaggo. ",
  "vv28:11.1": "bhāṇavāraṃ paṭhamaṃ. tatiyo pārichattakavaggo 1 "
}
