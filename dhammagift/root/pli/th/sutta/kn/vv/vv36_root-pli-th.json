  "vv36:0.1": "",
  "vv36:0.2": "",
  "vv36:0.3": "",
  "vv36:0.4": "",
  "vv36:1.1": "pītavatthe pītadhaje ",
  "vv36:1.2": "pītālaṅkārabhūsite ",
  "vv36:1.3": "pītantarāhi vaggūhi ",
  "vv36:1.4": "apilandhā va sobhasi ",
  "vv36:2.1": "kakambukāyuradhare ",
  "vv36:2.2": "kañcanāveḷabhūsite ",
  "vv36:2.3": "hemajālakasañchanne ",
  "vv36:2.4": "nānāratanamālinī ",
  "vv36:3.1": "sovaṇṇamayā lohitaṅkamayā ca ",
  "vv36:3.2": "muttāmayā veḷuriyāmayā ca ",
  "vv36:3.3": "masāragallā sahalohitakā ",
  "vv36:3.4": "pārevatakkhīhi maṇīhi cittatā ",
  "vv36:4.1": "koci koci ettha mayūrasussaro ",
  "vv36:4.2": "haṃsassa rañño karavīkasussaro ",
  "vv36:4.3": "tesaṃ saro suyyati vaggurūpo ",
  "vv36:4.4": "pañcaṅgikaṃ turiyamivappavāditaṃ ",
  "vv36:5.1": "ratho ca te subho vaggū ",
  "vv36:5.2": "nānāratanacittaṅgo ",
  "vv36:5.3": "nānāvaṇṇīhi dhātūhi ",
  "vv36:5.4": "suvibhatto va sobhati ",
  "vv36:6.1": "tasmiṃ rathe kāñcanabimbavaṇṇe ",
  "vv36:6.2": "yattha ṭhitā bhāsasimaṃ padesaṃ ",
  "vv36:6.3": "devate pucchitācikkha ",
  "vv36:6.4": "kissa kammassidaṃ phalanti. ",
  "vv36:7.1": "sovaṇṇajālaṃ maṇisoṇṇacittaṃ ",
  "vv36:7.2": "muttācittaṃ hemajālena channaṃ ",
  "vv36:7.3": "parinibbute gotame appameyye ",
  "vv36:7.4": "pasannacittā ahamābhiropayiṃ ",
  "vv36:8.1": "tāhaṃ kammaṃ karitvāna ",
  "vv36:8.2": "kusalaṃ buddhavaṇṇitaṃ ",
  "vv36:8.3": "apetasokā sukhitā ",
  "vv36:8.4": "sampamodāmanāmayāti. ",
  "vv36:9.1": "mallikāvimānaṃ aṭṭhamaṃ. 9 "
}
