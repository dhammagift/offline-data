  "vv53:0.4": "",
  "vv53:1.1": "yo vadataṃ pavaro manujesu ",
  "vv53:1.2": "sakyamunī bhagavā katakicco ",
  "vv53:1.3": "pāragato balaviriyasamaṅgī ",
  "vv53:1.4": "taṃ sugataṃ saraṇatthamupehi ",
  "vv53:2.1": "rāgavirāgamaneñjamasokaṃ ",
  "vv53:2.2": "dhammasaṅkhatamappaṭikūlaṃ ",
  "vv53:2.3": "madhuramimaṃ paguṇaṃ suvibhattaṃ ",
  "vv53:2.4": "dhammamimaṃ saraṇatthamupehi ",
  "vv53:3.1": "yattha ca dinnamahapphalamāhu ",
  "vv53:3.2": "catūsu sucīsu purisayugesu ",
  "vv53:3.3": "aṭṭha ca puggaladhammaddasā te ",
  "vv53:3.4": "saṅghamimaṃ saraṇatthamupehīti. ",
  "vv53:4.1": "na tathā tapati nabhasmiṃ suriyo ",
  "vv53:4.2": "cando na bhāsati na phusso ",
  "vv53:4.3": "yathā tulamidaṃ mahappabhāsaṃ ",
  "vv53:4.4": "ko nu tvaṃ tidivāmahimupāgami ",
  "vv53:5.1": "chindati ca raṃsi pabhākarassa ",
  "vv53:5.2": "sādhikavīsati yojanāni ābhā ",
  "vv53:5.3": "rattimpi ca yathā divaṃ karoti ",
  "vv53:5.4": "parisuddhaṃ vimalaṃ subhaṃ vimānaṃ ",
  "vv53:6.1": "bahūpadumavicitrapuṇḍarīkaṃ ",
  "vv53:6.2": "vokiṇṇaṃ kusumehi nekavicittaṃ ",
  "vv53:6.3": "arajavirajahemajālacchannaṃ ",
  "vv53:6.4": "ākāse tapati yathāpi suriyo ",
  "vv53:7.1": "rattakambalapītavāsasāhi ",
  "vv53:7.2": "agalūpiyaṅgukacandanussadāhi ",
  "vv53:7.3": "kañcanatanusannibhattacāhi ",
  "vv53:7.4": "paripūraṅgagaṇaṃva tārakāhi ",
  "vv53:8.1": "naranāriyo bahukettha nekavaṇṇā kusumavibhūsitā ",
  "vv53:8.2": "bharaṇetta sumanā ",
  "vv53:8.3": "anilapamuñcitā pavantisurabhi tapanīyacittattā ",
  "vv53:8.4": "suvaṇṇachadanā ",
  "vv53:9.1": "kissa kammassa ayaṃ vipāko ",
  "vv53:9.2": "kenāsi kammaphalenidhūpapanno ",
  "vv53:9.3": "yathā ca te adhigatamidaṃ vimānaṃ ",
  "vv53:9.4": "tadanurūpaṃ avahasi iṅgha puṭṭhoti. ",
  "vv53:10.1": "yamidha pathe samecca māṇavena ",
  "vv53:10.2": "satthānusāsi anukampamāno ",
  "vv53:10.3": "tava ratanavarassa dhammaṃ sutvā ",
  "vv53:10.4": "karissāmīti ca iti bravittha chatto ",
  "vv53:11.1": "jinapavaraṃ upemi saraṇaṃ ",
  "vv53:11.2": "dhammañcāpi tatheva bhikkhusaṅghaṃ ",
  "vv53:11.3": "noti paṭhamaṃ avocāhaṃ bhante ",
  "vv53:11.4": "pacchā te vacanaṃ tathevakāsiṃ ",
  "vv53:12.1": "mā ca pāṇavadhaṃ vividhamācarassu asuciṃ ",
  "vv53:12.2": "na hi pāṇesu asaññataṃ avaṇṇayiṃsu sappaññā ",
  "vv53:12.3": "noti paṭhamaṃ avocāhaṃ bhante ",
  "vv53:12.4": "pacchā te vacanaṃ tathevakāsiṃ ",
  "vv53:13.1": "mā ca parajanassa ",
  "vv53:13.2": "",
  "vv53:13.3": "",
  "vv53:13.4": "",
  "vv53:14.1": "rakkhitāyo ",
  "vv53:14.2": "parabhariyāyo agamā anariyametaṃ ",
  "vv53:14.3": "noti paṭhamaṃ avocāhaṃ bhante ",
  "vv53:14.4": "pacchā te vacanaṃ tathevakāsiṃ ",
  "vv53:15.1": "mā ca vitathaṃ aññathā abhaṇi ",
  "vv53:15.2": "na hi musāvādaṃ avaṇṇayiṃsu sappaññā ",
  "vv53:15.3": "noti paṭhamaṃ avocāhaṃ bhante ",
  "vv53:15.4": "pacchā te vacanaṃ tathevakāsiṃ ",
  "vv53:16.1": "yena ca purisassa apeti saññā ",
  "vv53:16.2": "taṃ vajjaṃ parivajjayassu sabbaṃ ",
  "vv53:16.3": "noti paṭhamaṃ avocāhaṃ bhante ",
  "vv53:16.4": "pacchā te vacanaṃ tathevakāsiṃ ",
  "vv53:17.1": "svāhaṃ idha pañcasikkhā karitvā ",
  "vv53:17.2": "paṭipajjitvā tathāgatassa dhamme ",
  "vv53:17.3": "dve pathamagamāsiṃ coramajjhe ",
  "vv53:17.4": "te maṃ tattha vadhiṃsu bhogahetu ",
  "vv53:18.1": "ettakamidaṃ anussarāmi kusalaṃ ",
  "vv53:18.2": "tato paraṃ na me vijjati aññaṃ ",
  "vv53:18.3": "tena sucaritena kammunāhaṃ ",
  "vv53:18.4": "upapanno tidivesu kāmakāmī ",
  "vv53:19.1": "passa khaṇamuhuttasaññamassa ",
  "vv53:19.2": "anudhammapaṭipattiyā vipākaṃ ",
  "vv53:19.3": "jalamiva yasasā pekkhamānā ",
  "vv53:19.4": "bahukāmāpi hayanti hīnadhammā ",
  "vv53:20.1": "passa katipayāya desanāya ",
  "vv53:20.2": "sugatiñcamhi gato sukhañca patto ",
  "vv53:20.3": "ye ca te sattañca suṇanti dhammaṃ ",
  "vv53:20.4": "maññe te amataṃ phusanti khemaṃ ",
  "vv53:21.1": "appakampi kataṃ mahāvipākaṃ ",
  "vv53:21.2": "vipulaṃ hoti tathāgatassa dhamme ",
  "vv53:21.3": "passa katapuññatāya chatto ",
  "vv53:21.4": "obhāseti paṭhaviṃ yathāpi suriyo ",
  "vv53:22.1": "kimidaṃ kusalaṃ kimācarema ",
  "vv53:22.2": "icceke hi samecca mantayanti ",
  "vv53:22.3": "te mayaṃ puna deva laddhā mānussattaṃ ",
  "vv53:22.4": "paṭipannā vicāremu sīlavanto ",
  "vv53:23.1": "bahukāro anukampako ca me satthā ",
  "vv53:23.2": "iti me sati agamā divādivassa ",
  "vv53:23.3": "svāhaṃ upagatomhi saccanāmaṃ ",
  "vv53:23.4": "anukampassu punapi suṇomi dhammaṃ ",
  "vv53:24.1": "yedha pajahanti kāmarāgaṃ ",
  "vv53:24.2": "bhavarāgānussayañca pahāya mohaṃ ",
  "vv53:24.3": "na ca te upenti gabbhaseyyaṃ ",
  "vv53:24.4": "parinibbānagatā hi sītibhūtāti. ",
  "vv53:25.1": "chattamāṇavakavimānaṃ tatiyaṃ. 4 "
}
