  "vv27:1.1": "abhikkantena vaṇṇena ",
  "vv27:1.2": "yā tvaṃ tiṭṭhasi devate ",
  "vv27:1.3": "obhāsentī disā sabbā ",
  "vv27:1.4": "osadhī viya tārakā ",
  "vv27:2.1": "kena te tādiso vaṇṇo … ",
  "vv27:2.2": "pe … ",
  "vv27:2.3": "vaṇṇo ca te sabbadisā pabhāsatīti. ",
  "vv27:3.1": "sā devatā attamanā moggallānena pucchitā … ",
  "vv27:3.2": "pe … ",
  "vv27:3.3": "yassa kammassidaṃ phalaṃ ",
  "vv27:4.1": "ahaṃ manussesu manussabhūtā ",
  "vv27:4.2": "purimāya jātiyā masussaloke ",
  "vv27:5.1": "addasaṃ virajaṃ buddhaṃ ",
  "vv27:5.2": "vippasannamanāvilaṃ ",
  "vv27:5.3": "tassa adāsihaṃ bhikkhaṃ ",
  "vv27:5.4": "pasannā sakehi pāṇihi ",
  "vv27:6.1": "tena me tādiso vaṇṇo … ",
  "vv27:6.2": "pe … ",
  "vv27:6.3": "vaṇṇo ca me sabbadisā pabhāsatīti. ",
  "vv27:7.1": "bhikkhādāyikavimānaṃ dasamaṃ. 11 "
}
