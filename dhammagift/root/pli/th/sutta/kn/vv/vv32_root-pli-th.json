  "vv32:0.1": "",
  "vv32:0.2": "",
  "vv32:0.3": "",
  "vv32:0.4": "",
  "vv32:1.1": "latā ca sajjā pavarā ca devatā ",
  "vv32:1.2": "acchimutīrājavarassa sirīmato ",
  "vv32:1.3": "sutā ca rañño vessavaṇṇassa dhītā ",
  "vv32:1.4": "rājī matī dhammaguṇehi sobhita ",
  "vv32:2.1": "pañcettha nāriyo agamaṃsu nhāyituṃ ",
  "vv32:2.2": "sītodakaṃ uppaliniṃ sivaṃ nadiṃ ",
  "vv32:2.3": "tā tattha nhāyitvā ramitvā devatā ",
  "vv32:2.4": "naccitvā gāyitvā sutālataṃ bravi ",
  "vv32:3.1": "pucchāmi taṃ uppalamāladhārini ",
  "vv32:3.2": "āveḷini kāñcanasannibhattace ",
  "vv32:3.3": "pītarattāmbakkhi nabheva sobhaṇe ",
  "vv32:3.4": "dīghāyukī kena kato yaso tava ",
  "vv32:4.1": "kenāsi bhadde patino piyatarā ",
  "vv32:4.2": "visiṭṭhakalyāṇitarassa rūpato ",
  "vv32:4.3": "padakkhiṇā naccagītavādite ",
  "vv32:4.4": "ācikkha no tvaṃ naranāri pucchitāti. ",
  "vv32:5.1": "ahaṃ manussesu manussabhūtā ",
  "vv32:5.2": "uḷārabhoge kule suṇisā ahosiṃ ",
  "vv32:5.3": "akkodhanā bhattu vasānuvattinī appamattā ",
  "vv32:5.4": "uposathe ",
  "vv32:6.1": "manussabhūtā daharā apāvikā ",
  "vv32:6.2": "pasannacittā patimābhirādhayiṃ ",
  "vv32:6.3": "sadevaraṃ sassuraṃ sadāsakaṃ ",
  "vv32:6.4": "abhirādhayiṃ tamhi kato yaso mama ",
  "vv32:7.1": "sāhaṃ tena kusalena kammunā ",
  "vv32:7.2": "catubbhi ṭhānesu visesamajjhagā ",
  "vv32:7.3": "āyuñca vaṇṇañca sukhaṃ balañca ",
  "vv32:7.4": "khiddaṃ ratiṃ paccanubhomanappakaṃ ",
  "vv32:8.1": "sutaṃ nu taṃ bhāsati yaṃ ayaṃ latā ",
  "vv32:8.2": "yaṃ no āpucchimha akittayino ",
  "vv32:8.3": "patino kiramhākaṃ visiṭṭhā nārinaṃ ",
  "vv32:8.4": "gatī ca nesaṃ pavarā ca devatā ",
  "vv32:9.1": "patīsu dhammaṃ paricarāma sabbā ",
  "vv32:9.2": "patibbatā yathābhavanti itthiyo ",
  "vv32:9.3": "patīsu dhammaṃ paricarāma sabbā ",
  "vv32:9.4": "lacchāmase bhāsati yaṃ ayaṃ latā ",
  "vv32:10.1": "sīho yathā pabbatasānugocaro ",
  "vv32:10.2": "mahindharaṃ pabbatamāvasitvā ",
  "vv32:10.3": "pasayha gantvā itare catuppade ",
  "vv32:10.4": "khudde mige khādati maṃsabhojano ",
  "vv32:11.1": "tatheva saddhā idha ariyasāvikā ",
  "vv32:11.2": "bhattāraṃ nissāya patiṃ anubbatā ",
  "vv32:11.3": "kodhaṃ vadhitvā anubhuyya maccheraṃ ",
  "vv32:11.4": "saggamhi sā modati dhammacārinīti. ",
  "vv32:12.1": "latāvimānaṃ catutthaṃ. 5 "
}
