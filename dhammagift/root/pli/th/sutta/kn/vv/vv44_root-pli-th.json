  "vv44:0.4": "",
  "vv44:1.1": "abhikkantena vaṇṇena yā tvaṃ tiṭṭhasi devate … ",
  "vv44:1.2": "pe … ",
  "vv44:1.3": "osadhī viya tārakā ",
  "vv44:2.1": "tassā te naccamānāya ",
  "vv44:2.2": "aṅgamaṅgehi sabbaso ",
  "vv44:2.3": "dibbā saddāniccharanti ",
  "vv44:2.4": "savanīyā manoramā ",
  "vv44:3.1": "tassā te naccamānāya ",
  "vv44:3.2": "aṅgamaṅgehi sabbaso ",
  "vv44:3.3": "dibbā gandhā pavāyanti ",
  "vv44:3.4": "sucigandhā manoramā ",
  "vv44:4.1": "vivattamānā kāyena ",
  "vv44:4.2": "yā veṇīsu pilandhanā ",
  "vv44:4.3": "tesaṃ suyyati nigghoso ",
  "vv44:4.4": "turiye pañcaṅgike yathā ",
  "vv44:5.1": "vaṭaṃsakā vātadhūtā ",
  "vv44:5.2": "vātena sampakampitā ",
  "vv44:5.3": "tesaṃ suyyati nigghoso ",
  "vv44:5.4": "turiye pañcaṅgike yathā ",
  "vv44:6.1": "yāpi te sirasi mālā ",
  "vv44:6.2": "sucigandhā manoramā ",
  "vv44:6.3": "vāti gandho disā sabbā ",
  "vv44:6.4": "rukkho mañjūsako yathā ",
  "vv44:7.1": "ghāyase taṃ sucigandhaṃ ",
  "vv44:7.2": "rūpaṃ passasi amānusaṃ ",
  "vv44:7.3": "devate pucchitācikkha ",
  "vv44:7.4": "kissa kammassidaṃ phalanti. ",
  "vv44:8.1": "sāvatthiyaṃ mayha sakhī bhadante ",
  "vv44:8.2": "saṅghassa kāresi mahāvihāraṃ ",
  "vv44:8.3": "tattha pasannā ahamānumodiṃ ",
  "vv44:8.4": "disvā agārañca piyañca metaṃ ",
  "vv44:9.1": "tāyeva me suddhanumodanāya ",
  "vv44:9.2": "laddhaṃ vimānabbhūtadassaneyyaṃ ",
  "vv44:9.3": "samantato soḷasayojanāni ",
  "vv44:9.4": "vehāsayaṃ gacchati iddhiyā mama ",
  "vv44:10.1": "kūṭāgārā nivesā me ",
  "vv44:10.2": "vibhattā bhāgaso mitā ",
  "vv44:10.3": "daddallamānā ābhanti ",
  "vv44:10.4": "samantā satayojanaṃ ",
  "vv44:11.1": "pokkharañño ca me ettha ",
  "vv44:11.2": "puthulomanisevitā ",
  "vv44:11.3": "acchodakā vippasannā ",
  "vv44:11.4": "sovaṇṇavālukasanthatā ",
  "vv44:12.1": "nānāpadumasañchannā ",
  "vv44:12.2": "puṇḍarīkasamotatā ",
  "vv44:12.3": "surabhī sampavāyanti ",
  "vv44:12.4": "manuññamāluteritā ",
  "vv44:13.1": "jambuyo panasā tālā ",
  "vv44:13.2": "nāḷikerā vanāni ca ",
  "vv44:13.3": "anto nivesane jātā ",
  "vv44:13.4": "nānārukkhā aropitā ",
  "vv44:14.1": "nānāturiyasaṅghuṭṭhaṃ ",
  "vv44:14.2": "accharāgaṇaghositaṃ ",
  "vv44:14.3": "yopi maṃ supine passe ",
  "vv44:14.4": "sopi vitto siyā naro ",
  "vv44:15.1": "etādisaṃ abbhūtadassaneyyaṃ ",
  "vv44:15.2": "vimānaṃ sabbaso pabhaṃ ",
  "vv44:15.3": "mama kammehi nibbattaṃ ",
  "vv44:15.4": "alaṃ puññāni kātave ",
  "vv44:16.1": "tāyeva te suddhanumodanāya ",
  "vv44:16.2": "laddhaṃ vimānabbhūtadassaneyyaṃ ",
  "vv44:16.3": "yā ceva sā dānamadāsi nārī ",
  "vv44:16.4": "tassā gatiṃ brūhi kuhiṃ uppannā sāti. ",
  "vv44:17.1": "yā sā ahu mayha sakhī bhadante ",
  "vv44:17.2": "saṅghassa kāresi mahāvihāraṃ ",
  "vv44:17.3": "viññātadhammā sā adāsi dānaṃ ",
  "vv44:17.4": "uppannā nimmānaratīsu devesu ",
  "vv44:18.1": "pajāpatī tassa sunimmitassa ",
  "vv44:18.2": "acintiyā kammavipāka tassā ",
  "vv44:18.3": "yametaṃ pucchasi kuhiṃ uppannā sāti ",
  "vv44:18.4": "bhante viyākāsiṃ anaññathā ahaṃ ",
  "vv44:19.1": "tena haññepi samādapetha ",
  "vv44:19.2": "saṅghassa dānāni dadātha vittā ",
  "vv44:19.3": "dhammañca suṇātha pasannamānasā ",
  "vv44:19.4": "sudullabho laddho manussalābho ",
  "vv44:20.1": "yaṃ maggaṃ maggādhipatī adesayi ",
  "vv44:20.2": "brahmassaro kañcanasannibhattaco ",
  "vv44:20.3": "saṅghassa dānāni dadātha vittā ",
  "vv44:20.4": "mahapphalā yattha bhavanti dakkhiṇā ",
  "vv44:21.1": "ye puggalā aṭṭhasataṃ pasaṭṭhā ",
  "vv44:21.2": "cattāri etāni yugāni honti ",
  "vv44:21.3": "te dakkhiṇeyyā sugatassa sāvakā ",
  "vv44:21.4": "etesu dinnāni mahapphalāni ",
  "vv44:22.1": "cattāro ca paṭipannā ",
  "vv44:22.2": "cattāro ca phale ṭhitā ",
  "vv44:22.3": "esa saṅgho ujubhūto ",
  "vv44:22.4": "paññāsīlasamāhito ",
  "vv44:23.1": "yajamānānaṃ manussānaṃ ",
  "vv44:23.2": "puññapekkhāna pāṇinaṃ ",
  "vv44:23.3": "karontaṃ opadhikaṃ puññaṃ ",
  "vv44:23.4": "saṅghe dinnaṃ mahapphalaṃ ",
  "vv44:24.1": "eso hi saṅgho vipulo mahagghato ",
  "vv44:24.2": "esappameyyo udadhīva sāgaro ",
  "vv44:24.3": "etehi seṭṭhā naraviriyasāvakā ",
  "vv44:24.4": "pabhaṅkarā dhammamudīrayanti ",
  "vv44:25.1": "tesaṃ sudinnaṃ suhuttaṃ suyiṭṭhaṃ ",
  "vv44:25.2": "ye saṅghamuddissa dadanti dānaṃ ",
  "vv44:25.3": "sā dakkhiṇā saṅghagatā patiṭṭhitā ",
  "vv44:25.4": "mahapphalā lokavidūhi vaṇṇitā ",
  "vv44:26.1": "etādisaṃ puññamanussarantā ",
  "vv44:26.2": "ye vedajātā vicaranti loke ",
  "vv44:26.3": "vineyya maccheramalaṃ samūlaṃ ",
  "vv44:26.4": "aninditā saggamupenti ṭhānanti. ",
  "vv44:27.1": "vihāravimānaṃ chaṭṭhaṃ. ",
  "vv44:27.2": "bhāṇavāraṃ dutiyaṃ. 7 "
}
