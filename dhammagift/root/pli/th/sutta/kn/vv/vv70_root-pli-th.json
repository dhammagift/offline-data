  "vv70:1.1": "6 uccamidaṃ maṇithūṇaṃ vimānaṃ ",
  "vv70:1.2": "samantato dvādasa yojanāni ",
  "vv70:1.3": "kūṭāgārā sattasatā uḷārā ",
  "vv70:1.4": "veḷuriyatthambhā ruciratthatā subhā ",
  "vv70:2.1": "deviddhipattosi mahānubhāvo … ",
  "vv70:2.2": "pe … ",
  "vv70:2.3": "",
  "vv70:2.4": "vaṇṇo ca te sabbadisā pabhāsatīti. ",
  "vv70:3.1": "so devaputto attamano moggallānena pucchito … ",
  "vv70:3.2": "pe … ",
  "vv70:3.3": "yassa kammassidaṃ phalaṃ ",
  "vv70:4.1": "ahaṃ manussesu manussabhūto ",
  "vv70:4.2": "disvāna bhikkhuṃ tasitaṃ kilantaṃ ",
  "vv70:4.3": "ekāhaṃ bhikkhaṃ paṭipādayissaṃ ",
  "vv70:4.4": "samaṅgibhattena tadā akāsiṃ ",
  "vv70:5.1": "tena me tādiso vaṇṇo … ",
  "vv70:5.2": "pe … ",
  "vv70:5.3": "vaṇṇo ca me sabbadisā pabhāsatīti. ",
  "vv70:6.1": "bhikkhādāyakavimānaṃ chaṭṭhaṃ. "
}
