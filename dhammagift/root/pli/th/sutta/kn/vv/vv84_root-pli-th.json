{
  "vv84:0.1": "",
  "vv84:0.2": "",
  "vv84:0.3": "",
  "vv84:0.4": "",
  "vv84:1.1": "suṇotha yakkhassa ca vāṇijāna ca ",
  "vv84:1.2": "samāgamo yattha tadā ahosi ",
  "vv84:1.3": "yathā kathaṃ itaritarena cāpi ",
  "vv84:1.4": "subhāsitaṃ tañca suṇātha sabbe ",
  "vv84:2.1": "yo so ahu rājā pāyāsi nāma ",
  "vv84:2.2": "bhummānaṃ sahabyagato yasassī ",
  "vv84:2.3": "so modamāno va sake vimāne ",
  "vv84:2.4": "amānuso mānuse ajjhabhāsīti. ",
  "vv84:3.1": "saṅke araññe amanussaṭhāne ",
  "vv84:3.2": "kantāre appodake appabhakkhe ",
  "vv84:3.3": "suduggame vanapathassa majjhe ",
  "vv84:3.4": "vaṅkambhayā naṭṭhamanā manussā ",
  "vv84:4.1": "nayidha phalā mūlamayā ca santi ",
  "vv84:4.2": "upādānaṃ natthi kutodha bhikkhā ",
  "vv84:4.3": "aññatra paṃsūhi ca vālukāhi ca ",
  "vv84:4.4": "tattāhi uṇhāhi ca dāruṇāhi ",
  "vv84:5.1": "ujjaṅgalaṃ tattamidaṃ kapālaṃ ",
  "vv84:5.2": "anāyasaṃ paralokena tulyaṃ ",
  "vv84:5.3": "luddānamāvāsamidaṃ purāṇaṃ ",
  "vv84:5.4": "bhūmippadeso abhisattarūpo ",
  "vv84:6.1": "atha tumhe kena nu vaṇṇena ",
  "vv84:6.2": "kimāsamānā imaṃ padesaṃ hi ",
  "vv84:6.3": "anupaviṭṭhā sahasā samecca ",
  "vv84:6.4": "lobhā bhayā atha vā sampamūḷhāti. ",
  "vv84:7.1": "magadhesu aṅgesu ca satthavāhā ",
  "vv84:7.2": "āropiyamha papaniyaṃ pahuttaṃ ",
  "vv84:7.3": "te yāmase sindhusovīrabhūmiṃ ",
  "vv84:7.4": "dhanatthikā udayaṃ patthayānā ",
  "vv84:8.1": "divā pipāsaṃ nadhivāsayantā ",
  "vv84:8.2": "yoggānukampañca samekkhamānā ",
  "vv84:8.3": "etena vegena āyāma sabbe ",
  "vv84:8.4": "terattiṃ maggaṃ paṭipannā vikāle ",
  "vv84:9.1": "te duppayātā aparaddhamaggā ",
  "vv84:9.2": "andhākulā vippanaṭṭhā araññe ",
  "vv84:9.3": "suduggame vanapathassa majjhe ",
  "vv84:9.4": "disaṃ na jānāma pamūḷhacittā ",
  "vv84:10.1": "idañca disvāna adiṭṭhapubbaṃ ",
  "vv84:10.2": "vimānaseṭṭhañca tuvañca yakkha ",
  "vv84:10.3": "tatuttariṃ jīvitamāsiṃsanā ",
  "vv84:10.4": "disvā patītā sumanā udaggāti. ",
  "vv84:11.1": "pāraṃ samuddassa imañca vanaṃ vettaṃ ",
  "vv84:11.2": "paraṃ sakupathañca maggaṃ ",
  "vv84:11.3": "nadiyo pana pabbatānañca duggā ",
  "vv84:11.4": "puthu disā gacchatha bhogahetu ",
  "vv84:12.1": "pakkhandiyānaṃ vijitaṃ paresaṃ ",
  "vv84:12.2": "verajjake mānuse pekkhamānā ",
  "vv84:12.3": "yaṃ vo sutaṃ atha vāpi diṭṭhaṃ ",
  "vv84:12.4": "accherakaṃ taṃ vo suṇoma tātāti. ",
  "vv84:13.1": "itopi accherataraṃ kumāra ",
  "vv84:13.2": "na no sutaṃ vā atha vāpi diṭṭhaṃ ",
  "vv84:13.3": "atītamānussakameva sabbaṃ ",
  "vv84:13.4": "disvāna tappāma anomavaṇṇaṃ ",
  "vv84:14.1": "vehāsayaṃ pokkharañño savanti ",
  "vv84:14.2": "pahūtamālyā bahupuṇḍarīkā ",
  "vv84:14.3": "dumā ca te niccaphalūpapannā ",
  "vv84:14.4": "atīva gandhā surabhī pavāyanti ",
  "vv84:15.1": "veḷuriyatthambhā satamussitāse ",
  "vv84:15.2": "silappavāḷassa ca āyataṃsā ",
  "vv84:15.3": "masāragallā saha lohitakā ",
  "vv84:15.4": "thambhā ime jotirasā mayāse ",
  "vv84:16.1": "sahassatthambhaṃ atulānubhāvaṃ ",
  "vv84:16.2": "tesuppari sādhumidaṃ vimānaṃ ",
  "vv84:16.3": "ratanantaraṃ kañcanavedimissaṃ ",
  "vv84:16.4": "tapanīyapaṭṭehi ca sādhu channaṃ ",
  "vv84:17.1": "jambonaduttamidaṃ sumaṭṭho ",
  "vv84:17.2": "pāsādasopāṇaphalūpapanno ",
  "vv84:17.3": "daḷho ca vaggū ca susaṅgato ca ",
  "vv84:17.4": "atīva nijjhānakhamo manuñño ",
  "vv84:18.1": "ratanantarasmiṃ bahu annapānaṃ ",
  "vv84:18.2": "parivārito accharāsaṅgaṇena ",
  "vv84:18.3": "murajaālambaraturiyasaṅghuṭṭho ",
  "vv84:18.4": "abhivanditosi thūtivandanāya ",
  "vv84:19.1": "so modasi nārigaṇappabodhano ",
  "vv84:19.2": "vimānapāsādavare manorame ",
  "vv84:19.3": "acintiyo sabbaguṇūpapanno ",
  "vv84:19.4": "rājā yathā vessavaṇo nalinyā ",
  "vv84:20.1": "devo nu āsi uda vāsi yakkho ",
  "vv84:20.2": "udāhu devindo manussabhūto ",
  "vv84:20.3": "pucchanti taṃ vāṇijasatthavāhā ",
  "vv84:20.4": "ācikkha ko nāma tuvaṃsi yakkhoti. ",
  "vv84:21.1": "serissako nāma ahamhi yakkho ",
  "vv84:21.2": "kantāriyo vanapathamhi gutto ",
  "vv84:21.3": "imaṃ padesaṃ abhipālayāmi ",
  "vv84:21.4": "vacanakaro vessavaṇṇassa raññoti. ",
  "vv84:22.1": "adhiccaladdhaṃ pariṇāmajante sayaṃ ",
  "vv84:22.2": "kataṃ udāhu devehi dinnaṃ ",
  "vv84:22.3": "pucchanti taṃ vāṇijasatthavāhā ",
  "vv84:22.4": "kathaṃ tayā laddhamidaṃ manuññaṃ ",
  "vv84:23.1": "nādhiccaladdhaṃ na pariṇāmajante ",
  "vv84:23.2": "na sayaṃ kataṃ na hi devehi dinnaṃ ",
  "vv84:23.3": "sakehi kammehi apāpakehi ",
  "vv84:23.4": "puññehi me laddhamidaṃ manuññaṃ ",
  "vv84:24.1": "kiṃ te vataṃ kiṃ pana brahmacariyaṃ ",
  "vv84:24.2": "kissa suciṇṇassa ayaṃ vipāko ",
  "vv84:24.3": "pucchanti taṃ vāṇijasatthavāhā ",
  "vv84:24.4": "kathaṃ tayā laddhamidaṃ vimānaṃ ",
  "vv84:25.1": "mama pāyāsīti ahu samaññā ",
  "vv84:25.2": "rajjaṃ yadā kārayiṃ kosalānaṃ ",
  "vv84:25.3": "natthi kudiṭṭhi kadariyo pāpadhammo ",
  "vv84:25.4": "ucchedavādī ca tadā ahosiṃ ",
  "vv84:26.1": "samaṇo ca kho āsi kumārakassapo ",
  "vv84:26.2": "bahussuto cittakathī uḷāro ",
  "vv84:26.3": "so me tadā dhammakathaṃ akāsi ",
  "vv84:26.4": "diṭṭhivisūkāni vinodayi me ",
  "vv84:27.1": "tāhaṃ tassa dhammakathaṃ suṇitvā ",
  "vv84:27.2": "upāsakattaṃ paṭivedayissaṃ ",
  "vv84:27.3": "pāṇātipātā virato ahosiṃ ",
  "vv84:27.4": "loke adinnaṃ parivajjayissaṃ ",
  "vv84:27.5": "amajjapo no ca musā abhāṇiṃ ",
  "vv84:27.6": "sakena dārena ca homi tuṭṭho ",
  "vv84:28.1": "taṃ me vataṃ taṃ pana brahmacariyaṃ ",
  "vv84:28.2": "tassa suciṇṇassa ayaṃ vipāko ",
  "vv84:28.3": "teheva kammehi apāpakehi ",
  "vv84:28.4": "puññehi me laddhamidaṃ vimānaṃ ",
  "vv84:29.1": "saccaṃ kirāhaṃsu narā sapaññā ",
  "vv84:29.2": "anaññathā vacanaṃ paṇḍitānaṃ ",
  "vv84:29.3": "yahiṃ yahiṃ gacchati puññakammo ",
  "vv84:29.4": "tahiṃ tahiṃ modati kāmakāmī ",
  "vv84:30.1": "yahiṃ yahiṃ sokapariddavo ca ",
  "vv84:30.2": "vadho ca bandho ca parikkileso ",
  "vv84:30.3": "tahiṃ tahiṃ gacchati pāpakammo ",
  "vv84:30.4": "na muccati duggatiyā kadāci ",
  "vv84:31.1": "sammūḷharūpo va jano ahosi ",
  "vv84:31.2": "asmiṃ muhutte kalalīkato ca ",
  "vv84:31.3": "janassimassa tuyhañca kumāra ",
  "vv84:31.4": "apaccayo kena nu kho ahosi ",
  "vv84:32.1": "ime sirisapavanā tātā ",
  "vv84:32.2": "dibbā gandhā surabhī pavanti ",
  "vv84:32.3": "te sampavāyanti idaṃ vimānaṃ ",
  "vv84:32.4": "divā ca ratto ca tamaṃ nihantvā ",
  "vv84:33.1": "imesañca kho vassasataccayena ",
  "vv84:33.2": "sipāṭikā phalanti ekamekā ",
  "vv84:33.3": "mānussakaṃ vassasataṃ atītaṃ ",
  "vv84:33.4": "yadagge kāyamhi idhūpapanno ",
  "vv84:34.1": "dibbānahaṃ vassasatāni pañca ",
  "vv84:34.2": "asmiṃ vimānamhi ṭhatvāna tātā ",
  "vv84:34.3": "āyukkhayā puññakkhayā cavissaṃ ",
  "vv84:34.4": "teneva sokena pamucchitosmi ",
  "vv84:35.1": "kathaṃ nu soceyya tathāvidho so ",
  "vv84:35.2": "laddhā vimānaṃ atulaṃ cirāyaṃ ",
  "vv84:35.3": "ye cāpi kho ittaraṃ upapanno ",
  "vv84:35.4": "te nūna soceyya parittapuññāti. ",
  "vv84:36.1": "anucchaviṃ ovadiyañca me taṃ ",
  "vv84:36.2": "yaṃ maṃ tumhe peyyavācaṃ vadetha ",
  "vv84:36.3": "tumheva kho tāta mayānuguttā ",
  "vv84:36.4": "yenicchakaṃ tena paletha sotthinti. ",
  "vv84:37.1": "gantvā mayaṃ sindhusovīrabhūmiṃ ",
  "vv84:37.2": "dhanatthikā uddayapatthayānā ",
  "vv84:37.3": "yathā payogā paripuṇṇacāgā ",
  "vv84:37.4": "kāhāma serissa mahaṃ uḷāranti. ",
  "vv84:38.1": "mā heva serissa mahaṃ akattha ",
  "vv84:38.2": "sabbañca vo bhavissati yaṃ vadetha ",
  "vv84:38.3": "pāpāni kammāni vivajjayātha ",
  "vv84:38.4": "dhammānuyogañca adhiṭṭhahāthāti. ",
  "vv84:39.1": "upāsako atthi imamhi saṅghe ",
  "vv84:39.2": "bahussuto sīlavatūpapanno ",
  "vv84:39.3": "saddho ca cāgī ca supesalo ca ",
  "vv84:39.4": "vicakkhaṇo santusito mutīmā ",
  "vv84:40.1": "sañjānamāno na musā bhaṇeyya ",
  "vv84:40.2": "parūpaghātāya na cetayeyya ",
  "vv84:40.3": "vebhūtikaṃ pisuṇaṃ no kareyya ",
  "vv84:40.4": "saṇhañca vācaṃ sakhilaṃ bhaṇeyya ",
  "vv84:41.1": "sagāravo sappatisso vinīto ",
  "vv84:41.2": "apāpako adhisīle visuddho ",
  "vv84:41.3": "so mātaraṃ pitarañcāpi jantu ",
  "vv84:41.4": "dhammena poseti ariyavutti ",
  "vv84:42.1": "maññe so mātāpitūnaṃ hi kāraṇā ",
  "vv84:42.2": "bhogāni pariyesati na attahetu ",
  "vv84:42.3": "mātāpitūnañca yo accayena ",
  "vv84:42.4": "nekkhammapoṇo carissati brahmacariyaṃ ",
  "vv84:43.1": "ujū avaṅko asaṭho amāyo ",
  "vv84:43.2": "na lesakappena ca vohareyya ",
  "vv84:43.3": "so tādiso sukatakammakārī ",
  "vv84:43.4": "dhamme ṭhito kinti labhetha dukkhaṃ ",
  "vv84:44.1": "taṃ kāraṇā pātukatomhi attanā ",
  "vv84:44.2": "tasmā ca maṃ passatha vāṇijā se ",
  "vv84:44.3": "aññatra te na hi bhasmi bhavetha ",
  "vv84:44.4": "addhākulā vippanaṭṭhā araññe ",
  "vv84:44.5": "taṃ khippamānena lahuṃ parena ",
  "vv84:44.6": "sukho have sappurisena saṅgamoti. ",
  "vv84:45.1": "kinnāma so kiñca karoti kammaṃ ",
  "vv84:45.2": "kiṃ nāmadheyyaṃ kiṃ pana tassa gottaṃ ",
  "vv84:45.3": "mayampi maṃ daṭṭhukāmamha yakkha ",
  "vv84:45.4": "yassānukampāya idhāgatosi ",
  "vv84:45.5": "lābhā hi tassa yassa tvampi hesīti. ",
  "vv84:46.1": "yo kappako sambhavanāmadheyyo ",
  "vv84:46.2": "upāsako kocchabhaṇḍūpajīvī ",
  "vv84:46.3": "jānātha naṃ tumhākaṃ pesasi yo so ",
  "vv84:46.4": "mā ca kho naṃ hīḷittha supesalo soti. ",
  "vv84:47.1": "jānāmase yaṃ tvaṃ vadesi yakkha ",
  "vv84:47.2": "na kho taṃ jānāmase edisoti ",
  "vv84:47.3": "mayampi naṃ pūjayissāma yakkha ",
  "vv84:47.4": "sutvāna tuyhaṃ vacanaṃ uḷāranti. ",
  "vv84:48.1": "ye kecimasmiṃ sabbe manussā ",
  "vv84:48.2": "daharā mahantā atha vāpi majjhimā ",
  "vv84:48.3": "sabbeva te ālabhantu vimānaṃ ",
  "vv84:48.4": "passantu puññānaṃ phalaṃ kadariyāti. ",
  "vv84:49.1": "te tattha sabbeva ahaṃ pureti ",
  "vv84:49.2": "taṃ kappakaṃ tattha purakkhitvā ",
  "vv84:49.3": "sabbeva te ālabhiṃsu vimānaṃ ",
  "vv84:49.4": "masakkasāraṃ viya vāsavassa ",
  "vv84:50.1": "te tattha sabbeva ahaṃ pureti ",
  "vv84:50.2": "upāsakattaṃ paṭidesayiṃsu ",
  "vv84:50.3": "pāṇātipātā viratā ahesuṃ ",
  "vv84:50.4": "loke adinnaṃ parivajjayiṃsu ",
  "vv84:50.5": "amajjapā no ca musā bhaṇiṃsu ",
  "vv84:50.6": "sakena dārena ahesuṃ tuṭṭhā ",
  "vv84:51.1": "te tattha sabbeva ahaṃ pureti ",
  "vv84:51.2": "upāsakattaṃ paṭidesayitvā ",
  "vv84:51.3": "pakkāmi satthā anumodamāno ",
  "vv84:51.4": "yakkhiddhiyā anumato punappunaṃ ",
  "vv84:52.1": "gantvāna te sindhusovīrabhūmiṃ ",
  "vv84:52.2": "dhanatthikā uddayaṃ patthayānā ",
  "vv84:52.3": "yathā payogā paripuṇṇalābhā ",
  "vv84:52.4": "paccāgamuṃ pātaliputtamakkhataṃ ",
  "vv84:53.1": "gantvāna te saṅ gharaṃ sotthivanto ",
  "vv84:53.2": "puttehi dārehi samaṅgibhūtā ",
  "vv84:53.3": "ānandacittā sumanā patītā ",
  "vv84:53.4": "akaṃsu serissa mahaṃ uḷāraṃ ",
  "vv84:53.5": "serissakaṃ pariveṇaṃ māpayiṃsu ",
  "vv84:54.1": "etādisā sappurisāna sevanā ",
  "vv84:54.2": "mahiddhiyā dhammaguṇāna sevanā ",
  "vv84:54.3": "ekassa atthāya upāsakassa ",
  "vv84:54.4": "sabbeva sattā sukhitā ahesunti. ",
  "vv84:55.1": "serissakavimānaṃ dasamaṃ. 11 "
}
