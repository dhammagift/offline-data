  "vv60:1.1": "10 susukkakhandhaṃ abhiruyha nāgaṃ ",
  "vv60:1.2": "akācinaṃ dantibaliṃ mahājavaṃ ",
  "vv60:1.3": "āruyha gajaṃ pavaraṃ sukappitaṃ ",
  "vv60:1.4": "idhāgamā vehāsayamantalikkhe ",
  "vv60:2.1": "nāgassa dantesu duvesu nimmitā ",
  "vv60:2.2": "acchodakā paduminiyo suphullā ",
  "vv60:2.3": "padumesu ca turiyagaṇā pavajjare ",
  "vv60:2.4": "imā ca naccanti manoharāyo ",
  "vv60:3.1": "deviddhipattosi mahānubhāvo ",
  "vv60:3.2": "manussabhūto kimakāsi puññaṃ ",
  "vv60:3.3": "kenāsi evañjalitānubhāvo ",
  "vv60:3.4": "vaṇṇo ca te sabbadisā pabhāsatīti. ",
  "vv60:4.1": "so devaputto attamano ",
  "vv60:4.2": "moggallānena pucchito … ",
  "vv60:4.3": "pe … ",
  "vv60:4.4": "yassa kammassidaṃ phalaṃ ",
  "vv60:5.1": "aṭṭheva muṭṭhipupphāni ",
  "vv60:5.2": "kassapassa bhagavato ",
  "vv60:5.3": "thūpasmiṃ abhiropayiṃ ",
  "vv60:5.4": "pasanno sakehi pāṇihi ",
  "vv60:6.1": "tena me tādiso vaṇṇo … ",
  "vv60:6.2": "pe … ",
  "vv60:6.3": "vaṇṇo ca me sabbadisā pabhāsatīti. ",
  "vv60:7.1": "nāgavimānaṃ dasamaṃ. "
}
