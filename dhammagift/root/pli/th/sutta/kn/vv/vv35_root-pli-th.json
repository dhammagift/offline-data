  "vv35:0.3": "",
  "vv35:0.4": "",
  "vv35:1.1": "7 phalikarajatahemajālacchannaṃ ",
  "vv35:1.2": "vividhavicitraphalamaddasaṃ surammaṃ ",
  "vv35:1.3": "byamhaṃ sunimmitaṃ toraṇūpapannaṃ ",
  "vv35:1.4": "rājakūpakiṇṇamidaṃ subhaṃ vimānaṃ ",
  "vv35:2.1": "bhāti ca dasa disā nabheva suriyo ",
  "vv35:2.2": "sarade tamapanudo sahassaraṃsī ",
  "vv35:2.3": "tathā tapati midaṃ tava vimānaṃ ",
  "vv35:2.4": "jalamiva dhūmasikho nisenabhagge ",
  "vv35:3.1": "musativa nayanaṃ sateritāva ",
  "vv35:3.2": "ākāse ṭhapitamidaṃ manuññaṃ ",
  "vv35:3.3": "vīṇāmurajasammatāḷaghuṭṭhaṃ ",
  "vv35:3.4": "iddhaṃ indapuraṃ yathā tava midaṃ ",
  "vv35:4.1": "padumakumudauppalakuvalayaṃ ",
  "vv35:4.2": "yothikā bhaṇḍikā nojakā ca santi ",
  "vv35:4.3": "sālakusumitapupphitā asokā ",
  "vv35:4.4": "vividhadumaggasugandhasevitamidaṃ ",
  "vv35:5.1": "salaḷalabujasujakasaṃyuttā kusakasuphullitalatā ",
  "vv35:5.2": "va ",
  "vv35:5.3": "lambinīhi maṇijālasadisayasassinī ",
  "vv35:5.4": "rammā pokkharaṇī upaṭṭhitā te ",
  "vv35:6.1": "udakaruhā ca yetthi pupphajātā ",
  "vv35:6.2": "phalajā yeva santi rukkhajātā ",
  "vv35:6.3": "mānussakā amānussakā ca dibbā ",
  "vv35:6.4": "sagge tuyhaṃ nivesanamhi jātā ",
  "vv35:7.1": "kissa samadamassa ayaṃ vipāko ",
  "vv35:7.2": "kenāsi kammaphalenidhūpapannā ",
  "vv35:7.3": "yathā ca te adhigatamidaṃ vimānaṃ ",
  "vv35:7.4": "tadanupadaṃ avacāsi aḷārapakhumeti. ",
  "vv35:8.1": "yathā ca me adhigatamidaṃ vimānaṃ ",
  "vv35:8.2": "koñcamayuracakorasaṅghacaritaṃ ",
  "vv35:8.3": "dibyapilavahaṃ sarājaciṇṇaṃ ",
  "vv35:8.4": "dijakāraṇḍavakokilābhināditaṃ ",
  "vv35:9.1": "nānāsantānakapuppharukkhavividhā ",
  "vv35:9.2": "pātalijambuasokarukkhavantaṃ ",
  "vv35:9.3": "yathā ca me adhigatamidaṃ vimānaṃ ",
  "vv35:9.4": "tante pavedissāmi suṇohi bhante ",
  "vv35:10.1": "magadhavarapuratthime ",
  "vv35:10.2": "nāḷakagāmako nāma atthi bhante ",
  "vv35:10.3": "tattha ahosiṃ pure suṇisā ",
  "vv35:10.4": "sesavatīti tattha jāniṃsu mamaṃ ",
  "vv35:11.1": "sāhaṃ apaciṃ tattha kammakusalaṃ ",
  "vv35:11.2": "devamanussapūjitaṃ mahantaṃ ",
  "vv35:11.3": "upatissaṃ nibbutaṃ appameyyaṃ ",
  "vv35:11.4": "muditamanā kusumehi abbhokiriṃ ",
  "vv35:12.1": "paramagatigatañca pūjayitvā ",
  "vv35:12.2": "antimadehadharaṃ isiṃ uḷāraṃ ",
  "vv35:12.3": "pahāya mānusakaṃ samussayaṃ ",
  "vv35:12.4": "tidasāgatā idhamāvasāmi ṭhānanti. ",
  "vv35:13.1": "sesavatīvimānaṃ sattamaṃ. "
}
