{
  "vv29:0.1": "tatiyo pārichattakavaggo ",
  "vv29:0.2": "",
  "vv29:0.3": "",
  "vv29:0.4": "",
  "vv29:1.1": "1 uḷāro te yaso vaṇṇo ",
  "vv29:1.2": "sabbā obhāsate disā ",
  "vv29:1.3": "nāriyo naccanti gāyanti ",
  "vv29:1.4": "devaputtā alaṅkatā ",
  "vv29:2.1": "modanti parivārenti ",
  "vv29:2.2": "tava pūjāya devate ",
  "vv29:2.3": "sovaṇṇāni vimānāni ",
  "vv29:2.4": "tavimāni sudassane ",
  "vv29:3.1": "tuvaṃpi issarā tesaṃ ",
  "vv29:3.2": "sabbakāmasamiddhinaṃ ",
  "vv29:3.3": "abhijātā mahantāsi ",
  "vv29:3.4": "devakāye pamodasi ",
  "vv29:3.5": "devate pucchitācikkha ",
  "vv29:3.6": "yassa kammassidaṃ phalanti. ",
  "vv29:4.1": "ahaṃ manussesu manussabhūtā ",
  "vv29:4.2": "dussīle kule ",
  "vv29:4.3": "suṇisā ahosiṃ ",
  "vv29:4.4": "assaddhesu kadariyesu saddhāsīlena ",
  "vv29:5.1": "sampannā ",
  "vv29:5.2": "",
  "vv29:5.3": "piṇḍāya caramānassa ",
  "vv29:5.4": "apūvaṃ te adāsihaṃ ",
  "vv29:6.1": "",
  "vv29:6.2": "",
  "vv29:6.3": "tassa adāsihaṃ pūvaṃ ",
  "vv29:6.4": "pasannā sakehi pāṇihi ",
  "vv29:7.1": "itissā sassu paribhāsi ",
  "vv29:7.2": "avinītā tuvaṃ vadhū ",
  "vv29:7.3": "na maṃ sampucchituṃ icchi ",
  "vv29:7.4": "samaṇassa dadāmahaṃ ",
  "vv29:8.1": "tato me sassu kupitā ",
  "vv29:8.2": "pahāsi musalena maṃ ",
  "vv29:8.3": "kuṭaṅgañchi avadhi maṃ ",
  "vv29:8.4": "nāsakkhiṃ jīvituṃ ciraṃ ",
  "vv29:9.1": "sāhaṃ kāyassa bhedā ca ",
  "vv29:9.2": "vippamuttā tato cutā ",
  "vv29:9.3": "tāvatiṃsānaṃ devānaṃ ",
  "vv29:9.4": "upapannā sahabyataṃ ",
  "vv29:10.1": "tena me tādiso vaṇṇo … ",
  "vv29:10.2": "pe … ",
  "vv29:10.3": "vaṇṇo ca me sabbadisā pabhāsatīti. ",
  "vv29:11.1": "uḷāravimānaṃ paṭhamaṃ. "
}
