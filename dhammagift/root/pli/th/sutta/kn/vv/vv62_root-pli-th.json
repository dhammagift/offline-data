  "vv62:0.4": "",
  "vv62:1.1": "ko nu dibbena yānena ",
  "vv62:1.2": "sabbasetena hatthinā ",
  "vv62:1.3": "turiyāḷitanigghoso ",
  "vv62:1.4": "antalikkhe mahiyyati ",
  "vv62:2.1": "devatā nusi gandhabbo ",
  "vv62:2.2": "ādū sakko purindado ",
  "vv62:2.3": "ajānantā taṃ pucchāma ",
  "vv62:2.4": "kathaṃ jānemu taṃ mayanti. ",
  "vv62:3.1": "namhi devo na gandhabbo ",
  "vv62:3.2": "nāpi sakko purindado ",
  "vv62:3.3": "sudhammā nāma ye devā ",
  "vv62:3.4": "tesaṃ aññataro ahanti. ",
  "vv62:4.1": "pucchāma deva sudhamma ",
  "vv62:4.2": "puthuṃ katvāna añjaliṃ ",
  "vv62:4.3": "kiṃ katvā mānuse kammaṃ ",
  "vv62:4.4": "sudhammaṃ upapajjasīti. ",
  "vv62:5.1": "ucchāgāraṃ tiṇāgāraṃ ",
  "vv62:5.2": "vatthāgārañca yo dade ",
  "vv62:5.3": "tiṇṇamaññataraṃ datvā ",
  "vv62:5.4": "sudhammaṃ upapajjatīti. ",
  "vv62:6.1": "tatiyanāgavimānaṃ dvādasamaṃ. 13 daḷhadhammanisārassa "
}
