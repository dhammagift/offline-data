  "vv16:0.1": "",
  "vv16:0.2": "",
  "vv16:0.3": "",
  "vv16:0.4": "",
  "vv16:1.1": "yuttā ca te paramaalaṅkatā hayā ",
  "vv16:1.2": "adhomukhā aghasi gamā balī javā ",
  "vv16:1.3": "abhinimmitā pañcarathā satā ca te ",
  "vv16:1.4": "anventi taṃ sārathicoditā hayā ",
  "vv16:2.1": "sā tiṭṭhasi rathavare alaṅkatā ",
  "vv16:2.2": "obhāsayaṃ jalamiva jotipāvako ",
  "vv16:2.3": "pucchāmi taṃ varatanu anomadassane ",
  "vv16:2.4": "kasmā kāyā anadhivaraṃ upāgami ",
  "vv16:3.1": "kāmaggapattānaṃ yamāhuanuttarā ",
  "vv16:3.2": "nimmāya nimmāya ramanti devatā ",
  "vv16:3.3": "tasmā kāyā accharākāmāvaṇṇanī ",
  "vv16:3.4": "idhāgatā anadhivaraṃ namassituṃ ",
  "vv16:4.1": "kiṃ tvaṃ pure sucaritamācarī idha ",
  "vv16:4.2": "kenāsi tvaṃ amitayasā sukhedhitā ",
  "vv16:4.3": "iddhī ca te anadhivarā vihaṅgamā ",
  "vv16:4.4": "vaṇṇo ca te dasa disā virocati ",
  "vv16:5.1": "devehi tvaṃ parivutasakkatā casi ",
  "vv16:5.2": "kuto cutā sugatigatāsi devate ",
  "vv16:5.3": "kassa vā tvaṃ vacanakarānusāsaniṃ ",
  "vv16:5.4": "ācikkha me tvaṃ yadi buddhasāvikā (ti). ",
  "vv16:6.1": "nagantare nagaravare sumāpite ",
  "vv16:6.2": "paricārikā rājavarassa sirīmato ",
  "vv16:6.3": "naccehi gītehi paramasusikkhitā ahuṃ ",
  "vv16:6.4": "sirimāti maṃ rājagahe avediṃsu ",
  "vv16:7.1": "buddho ca me isisanibho vināyako ",
  "vv16:7.2": "adesayi samudayadukkhaniccataṃ ",
  "vv16:7.3": "asaṅkhataṃ dukkhanirodhaṃ sassataṃ ",
  "vv16:7.4": "maggañcimaṃ akuṭilaṃ añjasaṃ sivaṃ ",
  "vv16:8.1": "sutvānahaṃ amatapadaṃ asaṅkhataṃ ",
  "vv16:8.2": "tathāgatassa anadhivarassa sāsanaṃ ",
  "vv16:8.3": "sīlesvāhaṃ paramasusaṃvutā ahuṃ ",
  "vv16:8.4": "dhamme ṭhitā naravarabuddhadesite ",
  "vv16:9.1": "ñatvāna taṃ virajaṃ padaṃ asaṅkhataṃ ",
  "vv16:9.2": "tathāgatena anadhivarena desitaṃ ",
  "vv16:9.3": "tatthevahaṃ samathasamādhimāphusiṃ ",
  "vv16:9.4": "sā yeva me paramaniyāmatā ahu ",
  "vv16:10.1": "laddhānahaṃ amatavaraṃ visesanaṃ ",
  "vv16:10.2": "ekaṃsikā abhisamaye visesayi ",
  "vv16:10.3": "asaṃsayā bahujanapūjitā ahaṃ ",
  "vv16:10.4": "khiḍḍaṃ ratiṃ paccanubhomanappakaṃ ",
  "vv16:11.1": "evaṃ ahaṃ amatarasamhi devatā ",
  "vv16:11.2": "tathāgatassa anadhivarassa sāvikā ",
  "vv16:11.3": "dhammaddasā paṭhamaphale patiṭṭhitā ",
  "vv16:11.4": "sotāpannā na ca punamatthi duggati ",
  "vv16:12.1": "sā vandituṃ anadhivaraṃ upāgamiṃ ",
  "vv16:12.2": "pāsādite kusalarate ca bhikkhavo ",
  "vv16:12.3": "namassituṃ samaṇasamāgamaṃ sivaṃ ",
  "vv16:12.4": "sagāravā sirimato dhammarājino ",
  "vv16:13.1": "disvā muniṃ muditamanamhi pīṇitā ",
  "vv16:13.2": "tathāgataṃ naravaradhammasārathiṃ ",
  "vv16:13.3": "taṇhacchidaṃ kusalarataṃ vināyakaṃ ",
  "vv16:13.4": "vandāmahaṃ paramahitānukampakanti. ",
  "vv16:14.1": "sirimāvimānaṃ soḷasamaṃ. "
}
