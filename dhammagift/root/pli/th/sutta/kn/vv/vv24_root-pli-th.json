  "vv24:0.3": "",
  "vv24:0.4": "",
  "vv24:1.1": "abhikkantena vaṇṇena ",
  "vv24:1.2": "yā tvaṃ tiṭṭhasi devate ",
  "vv24:1.3": "obhāsentī disā sabbā ",
  "vv24:1.4": "osadhī viya tārakā ",
  "vv24:2.1": "kena te tādiso vaṇṇo … ",
  "vv24:2.2": "pe … ",
  "vv24:2.3": "vaṇṇo ca te sabbadisā pabhāsatīti. ",
  "vv24:3.1": "sā devatā attamanā moggallānena pucchitā … ",
  "vv24:3.2": "pe … ",
  "vv24:3.3": "yassa kammassidaṃ phalaṃ ",
  "vv24:4.1": "uposathāti maṃ aññiṃsu ",
  "vv24:4.2": "sāketāyaṃ upāsikā ",
  "vv24:4.3": "saddhāsīlena sampannā ",
  "vv24:4.4": "saṃvibhāgaratā sadā ",
  "vv24:5.1": "acchādanañca bhattañca ",
  "vv24:5.2": "senāsanaṃ padīpiyaṃ ",
  "vv24:5.3": "adāsiṃ ujubhūtesu ",
  "vv24:5.4": "vippasannena cetasā ",
  "vv24:6.1": "cātuddasiṃ pañcadasiṃ ",
  "vv24:6.2": "yā ca pakkhassa aṭṭhamī ",
  "vv24:6.3": "pāṭihāriyapakkhañca ",
  "vv24:6.4": "aṭṭhaṅgasusamāgataṃ ",
  "vv24:7.1": "uposathaṃ upavasiṃ ",
  "vv24:7.2": "sadā sīle ",
  "vv24:7.3": "susaṃvutā ",
  "vv24:7.4": "",
  "vv24:8.1": "pāṇātipātā viratā ",
  "vv24:8.2": "musāvādā ca saññatā ",
  "vv24:8.3": "theyyā ca aticārā ca ",
  "vv24:8.4": "majjapānā ca ārakā ",
  "vv24:9.1": "pañcasikkhāpade ratā ",
  "vv24:9.2": "ariyasaccāna kovidā ",
  "vv24:9.3": "upāsikā cakkhumato ",
  "vv24:9.4": "gotamassa yasassino ",
  "vv24:10.1": "tena me tādiso vaṇṇo … ",
  "vv24:10.2": "pe … ",
  "vv24:10.3": "vaṇṇo ca me sabbadisā pabhāsatīti. ",
  "vv24:11.1": "abhikkhaṇaṃ nandanaṃ sutvā ",
  "vv24:11.2": "chando me upapajjatha ",
  "vv24:11.3": "tattha cittaṃ paṇidhāya ",
  "vv24:11.4": "upapannamhi nandanaṃ ",
  "vv24:12.1": "nākāsiṃ satthu vacanaṃ ",
  "vv24:12.2": "buddhassādiccabandhuno ",
  "vv24:12.3": "hīne cittaṃ paṇidhāya ",
  "vv24:12.4": "samhi pacchānutāpinī ",
  "vv24:13.1": "kīva ciraṃ vimānasmiṃ ",
  "vv24:13.2": "idha vassasuposathe ",
  "vv24:13.3": "devate pucchitācikkha ",
  "vv24:13.4": "yadi jānāsi āyu ",
  "vv24:14.1": "no ",
  "vv24:14.2": "(iti). saṭṭhivassasahassāni ",
  "vv24:14.3": "idha ṭhatvā mahāmuni ",
  "vv24:14.4": "ito cutā gamissāmi ",
  "vv24:14.5": "manussānaṃ sahabyatanti. ",
  "vv24:15.1": "mā tvaṃ uposathe bhayi ",
  "vv24:15.2": "sambuddhenāsi byākatā ",
  "vv24:15.3": "sotāpannā visesayi ",
  "vv24:15.4": "pahīnā tava duggatīti. ",
  "vv24:16.1": "uposathavimānaṃ sattamaṃ. 8 "
}
