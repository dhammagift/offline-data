{
  "vv6:0.1": "",
  "vv6:0.2": "",
  "vv6:0.3": "",
  "vv6:0.4": "",
  "vv6:1.1": "suvaṇṇacchadanaṃ nāvaṃ ",
  "vv6:1.2": "nāri āruyha tiṭṭhasi ",
  "vv6:1.3": "ogāḷhasi pokkharaṇiṃ ",
  "vv6:1.4": "padumaṃ chindasi pāṇinā ",
  "vv6:2.1": "kūṭāgārā nivesā te vibhattā bhāgaso mitā daddallamānā ābhanti samantā caturo disā kena te tādiso vaṇṇo ",
  "vv6:2.2": "kena te idhamijjhati ",
  "vv6:2.3": "uppajjanti ca te bhogā ",
  "vv6:2.4": "ye keci manaso piyā ",
  "vv6:3.1": "pucchāmi taṃ devi mahānubhāve ",
  "vv6:3.2": "manussabhūtā kimakāsi puññaṃ ",
  "vv6:3.3": "kenāsi evañjalitānubhāvā ",
  "vv6:3.4": "vaṇṇo ca te sabbadisā pabhāsatīti. ",
  "vv6:4.1": "sā devatā attamanā ",
  "vv6:4.2": "moggallānena pucchitā ",
  "vv6:4.3": "pañhaṃ puṭṭhā viyākāsi ",
  "vv6:4.4": "yassa kammassidaṃ phalaṃ ",
  "vv6:5.1": "ahaṃ manussesu manussabhūtā ",
  "vv6:5.2": "purimāya jātiyā manussaloke ",
  "vv6:5.3": "disvāna bhikkhū tasite kilante ",
  "vv6:5.4": "uṭṭhāya pātuṃ udakaṃ adāsiṃ ",
  "vv6:6.1": "yo ve kilantāna pipāsitānaṃ ",
  "vv6:6.2": "uṭṭhāya pātuṃ udakaṃ dadāti ",
  "vv6:6.3": "sītodakā tassa bhavanti najjo ",
  "vv6:6.4": "pahūtamalyā bahupuṇḍarīkā ",
  "vv6:7.1": "taṃ āpagā anupariyanti sabbadā ",
  "vv6:7.2": "sītodakā vālukasanthatā nadī ",
  "vv6:7.3": "ambā ca sālā tilakā ca jambuyo ",
  "vv6:7.4": "uddālakā pāṭaliyo ca phullā ",
  "vv6:8.1": "taṃ bhūmibhāgehi upetarūpaṃ ",
  "vv6:8.2": "vimānaseṭṭhaṃ bhusasobhamānaṃ ",
  "vv6:8.3": "tasseva kammassa ayaṃ vipāko ",
  "vv6:8.4": "etādisaṃ puññakatā labhanti ",
  "vv6:9.1": "kūṭāgārā nivesā me vibhattā bhāgaso mitā daddallamānā ābhanti samantā caturo disā tena me tādiso vaṇṇo ",
  "vv6:9.2": "tena me idhamijjhati ",
  "vv6:9.3": "uppajjanti ca me bhogā ",
  "vv6:9.4": "ye keci manaso piyā ",
  "vv6:10.1": "akkhāmi te bhikkhu mahānubhāva ",
  "vv6:10.2": "manussabhūtā yamahaṃ akāsiṃ ",
  "vv6:10.3": "tenamhi evañjalitānubhāvā ",
  "vv6:10.4": "vaṇṇo ca me sabbadisā pabhāsatīti. ",
  "vv6:11.1": "nāvāvimānaṃ chaṭṭhaṃ. "
}
