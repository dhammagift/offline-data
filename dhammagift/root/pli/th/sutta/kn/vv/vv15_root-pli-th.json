{
  "vv15:0.1": "",
  "vv15:0.2": "",
  "vv15:0.3": "",
  "vv15:0.4": "",
  "vv15:1.1": "abhikkantena vaṇṇena ",
  "vv15:1.2": "yā tvaṃ tiṭṭhasi devate ",
  "vv15:1.3": "obhāsentī disā sabbā ",
  "vv15:1.4": "osadhī viya tārakā ",
  "vv15:2.1": "kena te tādiso vaṇṇo ",
  "vv15:2.2": "kena te idhamijjhati ",
  "vv15:2.3": "uppajjanti ca te bhogā ",
  "vv15:2.4": "ye keci manaso piyā ",
  "vv15:3.1": "pucchāmi taṃ devi mahānubhāve ",
  "vv15:3.2": "manussabhūtā kimakāsi puññaṃ ",
  "vv15:3.3": "kenāsi evañjalitānubhāvā ",
  "vv15:3.4": "vaṇṇo ca te sabbadisā pabhāsatīti. ",
  "vv15:4.1": "sā devatā attamanā ",
  "vv15:4.2": "moggallānena pucchitā ",
  "vv15:4.3": "pañhaṃ puṭṭhā viyākāsi ",
  "vv15:4.4": "yassa kammassidaṃ phalaṃ ",
  "vv15:5.1": "issā ca macchariyamāno palāso ",
  "vv15:5.2": "nāhosi mayhaṃ gharamāvasantiyā ",
  "vv15:5.3": "akkodhanā bhattu vasānuvattinī ",
  "vv15:5.4": "uposathe niccappamattā ",
  "vv15:6.1": "cātuddasiṃ pañcadasiṃ ",
  "vv15:6.2": "yā ca pakkhassa aṭṭhamī ",
  "vv15:6.3": "pāṭihāriyapakkhañca ",
  "vv15:6.4": "aṭṭhaṅgasusamāgataṃ ",
  "vv15:7.1": "uposathaṃ upavasiṃ ",
  "vv15:7.2": "sadā sīle susaṃvutā ",
  "vv15:7.3": "saññamā saṃvibhāgā ca ",
  "vv15:7.4": "vimānaṃ āvasāmahaṃ ",
  "vv15:8.1": "pāṇātipātā viratā ",
  "vv15:8.2": "musāvādā ca saññatā ",
  "vv15:8.3": "theyyā ca aticārā ca ",
  "vv15:8.4": "majjapānā ca ārakā ",
  "vv15:9.1": "pañcasikkhāpade ratā ",
  "vv15:9.2": "ariyasaccāna kovidā ",
  "vv15:9.3": "upāsikā cakkhumato ",
  "vv15:9.4": "gotamassa yasassino ",
  "vv15:10.1": "sāhaṃ sakena sīlena ",
  "vv15:10.2": "yasasā ca yasassinī ",
  "vv15:10.3": "anubhomi sakaṃ puññaṃ ",
  "vv15:10.4": "sukhitā camhi anāmayā ",
  "vv15:11.1": "tena me tādiso vaṇṇo ",
  "vv15:11.2": "tena me idhamijjhati ",
  "vv15:11.3": "uppajjanti ca me bhogā ",
  "vv15:11.4": "ye keci manaso piyā ",
  "vv15:12.1": "akkhāmi te bhikkhu mahānubhāva ",
  "vv15:12.2": "manussabhūtā yamahaṃ akāsiṃ ",
  "vv15:12.3": "tenamhi evañjalitānubhāvā ",
  "vv15:12.4": "vaṇṇo ca me sabbadisā pabhāsatīti. ",
  "vv15:13.1": "mama ca bhante vacanena bhagavato pāde sirasā vandeyyāsi ",
  "vv15:13.2": "uttarā nāma bhante upāsikā bhagavato pāde sirasā vandatīti ",
  "vv15:13.3": "anacchariyaṃ kho panetaṃ bhante yaṃ maṃ bhagavā aññatarasmiṃ sāmaññaphale byākareyya taṃ bhagavā sakadāgāmiphale byākāsīti. ",
  "vv15:14.1": "uttarāvimānaṃ paṇṇarasamaṃ. "
}
