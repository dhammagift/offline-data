  "vv43:0.1": "",
  "vv43:0.2": "",
  "vv43:0.3": "",
  "vv43:0.4": "",
  "vv43:1.1": "5 abhikkantena vaṇṇena yā tvaṃ tiṭṭhasi devate … ",
  "vv43:1.2": "pe … ",
  "vv43:1.3": "osadhī viya tārakā ",
  "vv43:2.1": "kena te tādiso vaṇṇo … ",
  "vv43:2.2": "pe … ",
  "vv43:2.3": "vaṇṇo ca te sabbadisā pabhāsatīti. ",
  "vv43:3.1": "sā devatā attamanā moggallānena pucchitā … ",
  "vv43:3.2": "pe … ",
  "vv43:3.3": "yassa kammassidaṃ phalaṃ ",
  "vv43:4.1": "ahaṃ andhakavindasmiṃ ",
  "vv43:4.2": "buddhassādiccabandhuno ",
  "vv43:4.3": "adāsiṃ kolasampākaṃ ",
  "vv43:4.4": "kañjikaṃ teladhūpitaṃ ",
  "vv43:5.1": "pipphalyā lasuṇena ca ",
  "vv43:5.2": "missaṃ lāmajjakena ca ",
  "vv43:5.3": "adāsiṃ ujubhūtasmiṃ ",
  "vv43:5.4": "vippasannena cetasā ",
  "vv43:6.1": "yā mahesitaṃ kāreyya ",
  "vv43:6.2": "cakkavattissa rājino ",
  "vv43:6.3": "nārī sabbaṅgakalyāṇī ",
  "vv43:6.4": "bhattu cānomadassikā ",
  "vv43:6.5": "etassa kañjikadānassa ",
  "vv43:6.6": "kalaṃ nāgghanti soḷasiṃ ",
  "vv43:7.1": "sataṃ nikkhā sataṃ assā ",
  "vv43:7.2": "sataṃ assatarīrathā ",
  "vv43:7.3": "sataṃ kaññāsahassāni ",
  "vv43:7.4": "āmuttamaṇikuṇḍalā ",
  "vv43:7.5": "etassa kañjikadānassa ",
  "vv43:7.6": "kalaṃ nāgghanti soḷasiṃ ",
  "vv43:8.1": "sataṃ hemavatā nāgā ",
  "vv43:8.2": "īsādantā urūḷhavā ",
  "vv43:8.3": "suvaṇṇakacchā mātaṅgā ",
  "vv43:8.4": "hemakappanivāsasā ",
  "vv43:8.5": "etassa kañjikadānassa ",
  "vv43:8.6": "kalaṃ nāgghanti soḷasiṃ ",
  "vv43:9.1": "catunnaṃpi padīpānaṃ ",
  "vv43:9.2": "issaraṃ yodha kāraye ",
  "vv43:9.3": "etassa kañjikadānassa ",
  "vv43:9.4": "kalaṃ nāgghanti soḷasinti. ",
  "vv43:10.1": "kañjikadāyikāvimānaṃ pañcamaṃ. "
}
