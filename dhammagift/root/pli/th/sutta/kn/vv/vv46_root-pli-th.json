  "vv46:1.1": "ambavanaṃ rammaṃ ",
  "vv46:1.2": "pāsādettha mahallako ",
  "vv46:1.3": "nānāturiyasaṅghuṭṭho ",
  "vv46:1.4": "accharāgaṇaghosito ",
  "vv46:2.1": "padīpo cettha jalati ",
  "vv46:2.2": "niccaṃ sovaṇṇayo mahā ",
  "vv46:2.3": "dussaphalehi rukkhehi ",
  "vv46:2.4": "samantā parivārito ",
  "vv46:3.1": "kena te ambavanaṃ rammaṃ pāsādettha mahallako kena te tādiso vaṇṇo … ",
  "vv46:3.2": "pe … ",
  "vv46:3.3": "vaṇṇo ca te sabbadisā pabhāsatīti. ",
  "vv46:4.1": "sā devatā attamanā moggallānena pucchitā … ",
  "vv46:4.2": "pe … ",
  "vv46:4.3": "yassa kammassidaṃ phalaṃ ",
  "vv46:5.1": "ahaṃ manussesu manussabhūtā ",
  "vv46:5.2": "purimāya jātiyā manussaloke ",
  "vv46:5.3": "vihāraṃ saṅghassa kāresiṃ ",
  "vv46:5.4": "ambehi parivāritaṃ ",
  "vv46:6.1": "pariyosite vihāre ",
  "vv46:6.2": "kārente niṭṭhite mahe ",
  "vv46:6.3": "ambe acchādayitvāna ",
  "vv46:6.4": "katvā dussamaye phale ",
  "vv46:7.1": "padīpaṃ tattha jāletvā ",
  "vv46:7.2": "bhojayitvā gaṇuttamaṃ ",
  "vv46:7.3": "niyyādesiṃ taṃ saṅghassa ",
  "vv46:7.4": "pasannā sakehi pāṇihi ",
  "vv46:8.1": "tena me ambavanaṃ rammaṃ ",
  "vv46:8.2": "pāsādettha mahallako ",
  "vv46:8.3": "nānāturiyasaṅghuṭṭho ",
  "vv46:8.4": "accharāgaṇaghosito ",
  "vv46:9.1": "padīpo cettha jalati ",
  "vv46:9.2": "niccaṃ sovaṇṇayo mahā ",
  "vv46:9.3": "dussaphalehi rukkhehi ",
  "vv46:9.4": "samantā parivārito ",
  "vv46:10.1": "tena me tādiso vaṇṇo … ",
  "vv46:10.2": "pe … ",
  "vv46:10.3": "vaṇṇo ca me sabbadisā pabhāsatīti. ",
  "vv46:11.1": "ambavimānaṃ aṭṭhamaṃ. 9 "
