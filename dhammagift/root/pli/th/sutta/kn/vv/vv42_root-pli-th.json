  "vv42:1.1": "abhikkantena vaṇṇena ",
  "vv42:1.2": "yā tvaṃ tiṭṭhasi devate ",
  "vv42:1.3": "obhāsentī disā sabbā ",
  "vv42:1.4": "osadhī viya tārakā ",
  "vv42:2.1": "kena te tādiso vaṇṇo … ",
  "vv42:2.2": "pe … ",
  "vv42:2.3": "vaṇṇo ca te sabbadisā pabhāsatīti. ",
  "vv42:3.1": "sā devatā attamanā moggallānena pucchitā … ",
  "vv42:3.2": "pe … ",
  "vv42:3.3": "yassa kammassidaṃ phalaṃ ",
  "vv42:4.1": "ahañca bārāṇasiyaṃ ",
  "vv42:4.2": "buddhassādiccabandhuno ",
  "vv42:4.3": "adāsiṃ sukkhakummāsaṃ ",
  "vv42:4.4": "pasannā sakehi pāṇihi ",
  "vv42:5.1": "sukkhāya aloṇikāya ca ",
  "vv42:5.2": "passa phalaṃ kummāsapiṇḍiyā ",
  "vv42:5.3": "alomaṃ sukhitaṃ disvā ",
  "vv42:5.4": "ko puññaṃ na karissati ",
  "vv42:6.1": "tena me tādiso vaṇṇo … ",
  "vv42:6.2": "pe … ",
  "vv42:6.3": "vaṇṇo ca me sabbadisā pabhāsatīti. ",
  "vv42:7.1": "alomavimānaṃ catutthaṃ. 5 "
}
