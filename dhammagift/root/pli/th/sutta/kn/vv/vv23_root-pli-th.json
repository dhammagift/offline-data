  "vv23:0.3": "",
  "vv23:0.4": "",
  "vv23:1.1": "6 abhikkantena vaṇṇena ",
  "vv23:1.2": "yā tvaṃ tiṭṭhasi devate ",
  "vv23:1.3": "obhāsentī disā sabbā ",
  "vv23:1.4": "osadhī viya tārakā ",
  "vv23:2.1": "kena te tādiso vaṇṇo ",
  "vv23:2.2": "kena te idhamijjhati ",
  "vv23:2.3": "uppajjanti ca te bhogā ",
  "vv23:2.4": "ye keci manaso piyā ",
  "vv23:3.1": "pucchāmi taṃ devi mahānubhāve ",
  "vv23:3.2": "manussabhūtā kimakāsi puññaṃ ",
  "vv23:3.3": "kenāsi evañjalitānubhāvā ",
  "vv23:3.4": "vaṇṇo ca te sabbadisā pabhāsatīti. ",
  "vv23:4.1": "sā devatā attamanā ",
  "vv23:4.2": "moggallānena pucchitā ",
  "vv23:4.3": "pañhaṃ puṭṭhā viyākāsi ",
  "vv23:4.4": "yassa kammassidaṃ phalaṃ ",
  "vv23:5.1": "soṇadinnāti maṃ aññiṃsu ",
  "vv23:5.2": "nālandāyaṃ upāsikā ",
  "vv23:5.3": "saddhāsīlena sampannā ",
  "vv23:5.4": "saṃvibhāgaratā sadā ",
  "vv23:6.1": "acchādanañca bhattañca ",
  "vv23:6.2": "senāsanaṃ padīpiyaṃ ",
  "vv23:6.3": "adāsiṃ ujubhūtesu ",
  "vv23:6.4": "vippasannena cetasā ",
  "vv23:7.1": "cātuddasiṃ pañcadasiṃ ",
  "vv23:7.2": "yā ca pakkhassa aṭṭhamī ",
  "vv23:7.3": "pāṭihāriyapakkhañca ",
  "vv23:7.4": "aṭṭhaṅgasusamāgataṃ ",
  "vv23:8.1": "uposathaṃ upavasiṃ ",
  "vv23:8.2": "sadā sīle ",
  "vv23:8.3": "susaṃvutā ",
  "vv23:8.4": "",
  "vv23:9.1": "pāṇātipātā viratā ",
  "vv23:9.2": "musāvādā ca saññatā ",
  "vv23:9.3": "theyyā ca aticārā ca ",
  "vv23:9.4": "majjapānā ca ārakā ",
  "vv23:10.1": "pañcasikkhāpade ratā ",
  "vv23:10.2": "ariyasaccāna kovidā ",
  "vv23:10.3": "upāsikā cakkhumato ",
  "vv23:10.4": "gotamassa yasassino ",
  "vv23:11.1": "tena me tādiso vaṇṇo … ",
  "vv23:11.2": "pe … ",
  "vv23:11.3": "vaṇṇo ca me sabbadisā pabhāsatīti. ",
  "vv23:12.1": "soṇadinnāvimānaṃ chaṭṭhaṃ. "
}
