  "vv67:0.4": "",
  "vv67:1.1": "3 uccamidaṃ maṇithūṇaṃ vimānaṃ ",
  "vv67:1.2": "samantato dvādasa yojanāni ",
  "vv67:1.3": "kūṭāgārā sattasatā uḷārā ",
  "vv67:1.4": "veḷuriyatthambhā ruciratthatā subhā ",
  "vv67:2.1": "tatthacchasi pivasi khādasi ca ",
  "vv67:2.2": "dibbā ca vīṇā pavadanti vaggū ",
  "vv67:2.3": "aṭṭhaṭṭhakā sikkhitā sādhurūpā ",
  "vv67:2.4": "dibbā ca kaññā tidasacarā uḷārā ",
  "vv67:2.5": "naccanti gāyanti pamodayanti ",
  "vv67:3.1": "deviddhipattosi mahānubhāvo ",
  "vv67:3.2": "manussabhūto kimakāsi puññaṃ ",
  "vv67:3.3": "kenāsi evañjalitānubhāvo ",
  "vv67:3.4": "vaṇṇo ca te sabbadisā pabhāsatīti. ",
  "vv67:4.1": "so devaputto attamano ",
  "vv67:4.2": "moggallānena pucchito pañhaṃ puṭṭho viyākāsi ",
  "vv67:4.3": "yassa kammassidaṃ phalaṃ ",
  "vv67:5.1": "phaladāyī phalaṃ vipulaṃ labhati ",
  "vv67:5.2": "dadamujugatesu pasannamānaso ",
  "vv67:5.3": "so hi modati saggappatto tidive ",
  "vv67:5.4": "anubhoti ca puññaphalaṃ vipulaṃ ",
  "vv67:6.1": "tathevāhaṃ mahāmuni ",
  "vv67:6.2": "adāsiṃ caturo phale ",
  "vv67:7.1": "tasmā hi phalaṃ alameva dātuṃ ",
  "vv67:7.2": "niccaṃ manussena sukhatthikena ",
  "vv67:7.3": "dibbāni vā patthayatā sukhāni ",
  "vv67:7.4": "manussasobhāgyatamicchitā vā ti. ",
  "vv67:8.1": "tena me tādiso vaṇṇo … ",
  "vv67:8.2": "pe … ",
  "vv67:8.3": "vaṇṇo ca me sabbadisā pabhāsatīti. ",
  "vv67:9.1": "phaladāyakavimānaṃ tatiyaṃ. "
}
