  "vv48:0.3": "",
  "vv48:0.4": "",
  "vv48:1.1": "10 obhāsayitvā paṭhaviṃ sadevakaṃ ",
  "vv48:1.2": "atirocasi candimasuriyā viya ",
  "vv48:1.3": "siriyā ca vaṇṇena yasena tejasā ",
  "vv48:1.4": "brahmāva deve tidase sahindake ",
  "vv48:2.1": "pucchāmi taṃ uppalamāladhārine ",
  "vv48:2.2": "āveḷine kañcanasannibhattace ",
  "vv48:2.3": "alaṅkate uttamavatthadhārine ",
  "vv48:2.4": "kā tvaṃ subhe devate vandase mamaṃ ",
  "vv48:3.1": "",
  "vv48:3.2": "",
  "vv48:3.3": "dānaṃ suciṇṇaṃ atha sīlasaññamo ",
  "vv48:3.4": "kenūpapannā sugatiṃ yasassinī ",
  "vv48:3.5": "devate pucchitācikkha ",
  "vv48:3.6": "kissa kammassidaṃ phalaṃ (iti. ) ",
  "vv48:4.1": "idante bhante idhameva gāmaṃ ",
  "vv48:4.2": "piṇḍāya amhāka gharaṃ upāgami ",
  "vv48:4.3": "tato te ucchussa adāsiṃ khaṇḍikaṃ ",
  "vv48:4.4": "pasannacittā atulāya pītiyā ",
  "vv48:5.1": "sassu ca pacchā anuyuñjate mamaṃ ",
  "vv48:5.2": "kahaṃ nu ucchuṃ vadhu te avākari ",
  "vv48:5.3": "na chaḍḍitaṃ na pana khāditaṃ mayā ",
  "vv48:5.4": "santassa bhikkhussa sayaṃ adāsihaṃ ",
  "vv48:6.1": "tuyhañcidaṃ issariyaṃ atho mama ",
  "vv48:6.2": "itissa sassu paribhāsate mamaṃ ",
  "vv48:6.3": "leḍḍuṃ gahetvā pahāraṃ adāsi me ",
  "vv48:6.4": "tato cutā kālakatamhi devatā ",
  "vv48:7.1": "tadeva kammaṃ kusalaṃ kataṃ mayā ",
  "vv48:7.2": "sukhañca kammaṃ anubhomi attanā ",
  "vv48:7.3": "devehi saddhiṃ paricāriyāmahaṃ ",
  "vv48:7.4": "modāmahaṃ kāmaguṇehi pañcahi ",
  "vv48:8.1": "tadeva kammaṃ kusalaṃ kataṃ mayā ",
  "vv48:8.2": "sukhañca kammaṃ anubhomi attanā ",
  "vv48:8.3": "devindaguttā tidasehi rakkhitā ",
  "vv48:8.4": "samappitā kāmaguṇehi pañcahi ",
  "vv48:9.1": "etādisaṃ puññaphalaṃ anappakaṃ ",
  "vv48:9.2": "mahāvipākā mama ucchudakkhiṇā ",
  "vv48:9.3": "devehi saddhiṃ paricāriyāmahaṃ ",
  "vv48:9.4": "modāmahaṃ kāmaguṇehi pañcahi ",
  "vv48:10.1": "etādisaṃ puññaphalaṃ anappakaṃ ",
  "vv48:10.2": "mahājutikā mama ucchudakkhiṇā ",
  "vv48:10.3": "devindaguttā tidasehi rakkhitā ",
  "vv48:10.4": "sahassanettoriva nandane vane ",
  "vv48:11.1": "tuvañca bhante anukampakaṃ viduṃ ",
  "vv48:11.2": "upecca vandiṃ kusalañca pucchimaṃ ",
  "vv48:11.3": "tato te ucchussa adāsi khaṇḍikaṃ ",
  "vv48:11.4": "pasannacittā atulāya pītiyāti. ",
  "vv48:12.1": "ucchuvimānaṃ dasamaṃ. "
}
