  "vv72:1.1": "alaṅkato mālyadharo suvattho ",
  "vv72:1.2": "sukuṇḍalī kappitakesamassu ",
  "vv72:1.3": "āmuttahatthābharaṇo yasassī ",
  "vv72:1.4": "dibbe vimānamhi yathāpi candimā ",
  "vv72:2.1": "dibbā ca vīṇā pavadanti vaggū ",
  "vv72:2.2": "aṭṭhaṭṭhakā sikkhitā sādhurūpā ",
  "vv72:2.3": "dibbā ca kaññā tidasacarā uḷārā ",
  "vv72:2.4": "naccanti gāyanti pamodayanti ",
  "vv72:3.1": "deviddhipattosi mahānubhāvo ",
  "vv72:3.2": "manussabhūto kimakāsi puññaṃ ",
  "vv72:3.3": "kenāsi evañjalitānubhāvo ",
  "vv72:3.4": "vaṇṇo ca te sabbadisā pabhāsatīti. ",
  "vv72:4.1": "so devaputto attamano moggallānena pucchito … ",
  "vv72:4.2": "pe … ",
  "vv72:4.3": "yassa kammassidaṃ phalaṃ ",
  "vv72:5.1": "ahaṃ manussesu manussabhūto ",
  "vv72:5.2": "disvāna samaṇe sīlavante ",
  "vv72:5.3": "sampannavijjācaraṇe yasassī ",
  "vv72:5.4": "bahussute taṇhakkhayūpapanne ",
  "vv72:5.5": "annañca pānañca pasannacitto ",
  "vv72:5.6": "sakkacca dānaṃ vipulaṃ adāsiṃ ",
  "vv72:6.1": "tena me tādiso vaṇṇo … ",
  "vv72:6.2": "pe … ",
  "vv72:6.3": "vaṇṇo ca me sabbadisā pabhāsatīti. ",
  "vv72:7.1": "kuṇḍalīvimānaṃ aṭṭhamaṃ. 9 "
}
