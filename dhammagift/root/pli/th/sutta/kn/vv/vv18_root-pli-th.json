{
  "vv18:0.1": "dutiyo cittalatāvaggo ",
  "vv18:0.2": "",
  "vv18:0.3": "",
  "vv18:0.4": "",
  "vv18:1.1": "1 api sakkova devindo ",
  "vv18:1.2": "ramme cittalatāvane ",
  "vv18:1.3": "samantā anupariyāsi ",
  "vv18:1.4": "nārīgaṇapurakkhatā ",
  "vv18:1.5": "obhāsentī disā sabbā ",
  "vv18:1.6": "osadhī viya tārakā ",
  "vv18:2.1": "kena te tādiso vaṇṇo ",
  "vv18:2.2": "kena te idhamijjhati ",
  "vv18:2.3": "uppajjanti ca te bhogā ",
  "vv18:2.4": "ye keci manaso piyā ",
  "vv18:3.1": "pucchāmi taṃ devi mahānubhāve ",
  "vv18:3.2": "manussabhūtā kimakāsi puññaṃ ",
  "vv18:3.3": "kenāsi evañjalitānubhāvā ",
  "vv18:3.4": "vaṇṇo ca te sabbadisā pabhāsatīti. ",
  "vv18:4.1": "sā devatā attamanā ",
  "vv18:4.2": "moggallānena pucchitā ",
  "vv18:4.3": "pañhaṃ puṭṭhā viyākāsi ",
  "vv18:4.4": "yassa kammassidaṃ phalaṃ ",
  "vv18:5.1": "ahaṃ manussesu manussabhūtā ",
  "vv18:5.2": "dāsī ahosiṃ parapessiyā kule ",
  "vv18:6.1": "upāsikā cakkhumato ",
  "vv18:6.2": "gotamassa yasassino ",
  "vv18:6.3": "tassā me nikkamo āsi ",
  "vv18:6.4": "sāsane tassa tādino ",
  "vv18:7.1": "kāmaṃ bhijjatu yaṃ kāyo ",
  "vv18:7.2": "neva atthettha santhanaṃ ",
  "vv18:7.3": "sikkhāpadānaṃ pañcannaṃ ",
  "vv18:7.4": "maggo sovatthiko sivo ",
  "vv18:8.1": "akaṇṭako agahaṇo ",
  "vv18:8.2": "uju sabbhipavedito ",
  "vv18:8.3": "nikkamassa phalaṃ passa ",
  "vv18:8.4": "yathidaṃ pāpuṇitthikā ",
  "vv18:9.1": "āmantaṇikā raññomhi ",
  "vv18:9.2": "sakkassa vasavattino ",
  "vv18:9.3": "saṭṭhi turiyasahassāni ",
  "vv18:9.4": "paṭibodhaṃ karonti me ",
  "vv18:10.1": "ālambo gaggamo bhīmo ",
  "vv18:10.2": "sādhuvādi pasaṃsiyo ",
  "vv18:10.3": "pokkharo ca suphasso ca ",
  "vv18:10.4": "vīṇā mokkhā ca nāriyo ",
  "vv18:11.1": "nandā ceva sunandā ca ",
  "vv18:11.2": "soṇadinnā sucimbhikā ",
  "vv18:11.3": "ālambusā missakesī ",
  "vv18:11.4": "puṇḍarīkāti dāruṇī ",
  "vv18:12.1": "enipassā supassā ca ",
  "vv18:12.2": "subhaddā mudukāvadī ",
  "vv18:12.3": "etā aññā ca seyyāse ",
  "vv18:12.4": "accharānaṃ pabodhikā ",
  "vv18:13.1": "tā maṃ kālenupāgantvā ",
  "vv18:13.2": "abhibhāsanti devatā ",
  "vv18:13.3": "handa naccāma gāyāma ",
  "vv18:13.4": "handa taṃ ramayāmase ",
  "vv18:14.1": "nayidaṃ akatapuññānaṃ ",
  "vv18:14.2": "katapuññānamevidaṃ ",
  "vv18:14.3": "asokaṃ nandanaṃ rammaṃ ",
  "vv18:14.4": "tidasānaṃ mahāvanaṃ ",
  "vv18:15.1": "sukhaṃ akatapuññānaṃ ",
  "vv18:15.2": "idha natthi parattha ca ",
  "vv18:15.3": "sukhañca katapuññānaṃ ",
  "vv18:15.4": "idha ceva parattha ca ",
  "vv18:16.1": "tesaṃ sahabyakāmānaṃ ",
  "vv18:16.2": "kattabbaṃ kusalaṃ bahuṃ ",
  "vv18:16.3": "katapuññā hi modanti ",
  "vv18:16.4": "sagge bhogasamaṅginoti. ",
  "vv18:17.1": "dāsīvimānaṃ paṭhamaṃ. "
}
