  "vv79:0.4": "",
  "vv79:1.1": "5 uccamidaṃ maṇithūṇaṃ vimānaṃ ",
  "vv79:1.2": "samantato dvādasa yojanāni ",
  "vv79:1.3": "kūṭāgārā sattasatā uḷārā ",
  "vv79:1.4": "veḷuriyatthambhā ruciratthatā subhā ",
  "vv79:2.1": "tatthacchasi pivasi khādasi ca ",
  "vv79:2.2": "dibbā ca vīṇā pavadanti vaggū ",
  "vv79:2.3": "dibbā rasā kāmaguṇettha pañca ",
  "vv79:2.4": "nāriyo ca naccanti suvaṇṇachannā ",
  "vv79:3.1": "kena te tādiso vaṇṇo … ",
  "vv79:3.2": "pe … ",
  "vv79:3.3": "vaṇṇo ca te sabbadisā pabhāsatīti. ",
  "vv79:4.1": "so devaputto attamano moggallānena pucchito … ",
  "vv79:4.2": "pe … ",
  "vv79:4.3": "yassa kammassidaṃ phalaṃ ",
  "vv79:5.1": "gimhānaṃ pacchime māse ",
  "vv79:5.2": "patāpante divaṅkare ",
  "vv79:5.3": "paresaṃ bhatako poso ",
  "vv79:5.4": "ambārāmaṃ asiñcahaṃ ",
  "vv79:6.1": "atha tenāgamā bhikkhu ",
  "vv79:6.2": "sāriputtoti vissuto ",
  "vv79:6.3": "kilantarūpo kāyena ",
  "vv79:6.4": "akilantopi cetasā ",
  "vv79:7.1": "tañca disvāna āyantaṃ ",
  "vv79:7.2": "avoca ambasiñcako ",
  "vv79:7.3": "sādhu taṃ bhante nhāpeyyaṃ ",
  "vv79:7.4": "yaṃ mamassa sukhāvahaṃ ",
  "vv79:8.1": "tassa me anukampāya ",
  "vv79:8.2": "nikkhipi pattacīvaraṃ ",
  "vv79:8.3": "nisīdi rukkhamūlasmiṃ ",
  "vv79:8.4": "chāyāya ekacīvaro ",
  "vv79:9.1": "tañca acchena vārinā ",
  "vv79:9.2": "pasannamānaso theraṃ ",
  "vv79:9.3": "nhāpayiṃ rukkhamūlasmiṃ ",
  "vv79:9.4": "chāyāya ekacīvaraṃ ",
  "vv79:10.1": "ambo ca sitto samaṇo nahāpito ",
  "vv79:10.2": "mayā ca puññaṃ pasutaṃ anappakaṃ ",
  "vv79:10.3": "iti so pītiyā kāyaṃ ",
  "vv79:10.4": "sabbaṃ pharati attano ",
  "vv79:11.1": "tadeva ettakaṃ kammaṃ ",
  "vv79:11.2": "akāsiṃ tāya jātiyā ",
  "vv79:11.3": "pahāya mānusaṃ dehaṃ ",
  "vv79:11.4": "upapannomhi nandanaṃ ",
  "vv79:12.1": "nandane pavare ramme ",
  "vv79:12.2": "nānādijagaṇāyute ",
  "vv79:12.3": "ramāmi naccagītehi ",
  "vv79:12.4": "accharāhi purakkhitoti. ",
  "vv79:13.1": "ambavimānaṃ pañcamaṃ. "
}
