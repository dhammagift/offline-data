{
  "vv64:0.1": "",
  "vv64:0.2": "",
  "vv64:0.3": "",
  "vv64:0.4": "",
  "vv64:1.1": "14 sahassayuttaṃ hayavāhanaṃ subhaṃ ",
  "vv64:1.2": "āruyhimaṃ sandananekacittaṃ ",
  "vv64:1.3": "uyyānabhūmiṃ abhito anukkamaṃ ",
  "vv64:1.4": "purindado bhūtapatīva vāsavo ",
  "vv64:2.1": "sovaṇṇamayā te rathakubbarā ubho ",
  "vv64:2.2": "phalehi aṃsehi atīva saṅgatā ",
  "vv64:2.3": "sujātagumbā naravīraniṭṭhitā ",
  "vv64:2.4": "virocati paṇṇaraseva cando ",
  "vv64:3.1": "suvaṇṇajālāvitato ratho ayaṃ ",
  "vv64:3.2": "bahūhi nānāratanehi cittito ",
  "vv64:3.3": "sunandighoso ca subhassaro ca ",
  "vv64:3.4": "virocati cāmarahatthabāhuhi ",
  "vv64:4.1": "imā ca nābhyo manasāhi nimmitā ",
  "vv64:4.2": "rathassa pādantaramajjhabhūsitā ",
  "vv64:4.3": "imā ca nābhyo satarājicittitā ",
  "vv64:4.4": "sateritā vijjurivappabhāsare ",
  "vv64:5.1": "anekacittāvitato ratho ayaṃ ",
  "vv64:5.2": "puthū ca nemī ca sahassaraṃsiyo ",
  "vv64:5.3": "tesaṃ saro suyyati vaggurūpo ",
  "vv64:5.4": "(pañcaṅgikaṃ turiyamivappavāditaṃ ",
  "vv64:6.1": "sirasmiṃ cittaṃ maṇisandakappitaṃ ",
  "vv64:6.2": "sadā visuddhaṃ ruciraṃ pabhassaraṃ ",
  "vv64:6.3": "suvaṇṇarājīhi atīva saṅgataṃ ",
  "vv64:6.4": "veḷuriyarājīhi atīva sobhati) ",
  "vv64:7.1": "ime ca vāḷī maṇisandakappitā ",
  "vv64:7.2": "ārohakambū sujavā brahmūpamā ",
  "vv64:7.3": "brahā mahantā balino mahājavā ",
  "vv64:7.4": "mano tavaññāya tatheva siṃsare ",
  "vv64:8.1": "ime ca sabbe sahitā catukkamā ",
  "vv64:8.2": "mano tavaññāya tatheva siṃsare ",
  "vv64:8.3": "samaṃ vahanti mudukā anuddhatā ",
  "vv64:8.4": "āmodamānā turagānamuttamā ",
  "vv64:9.1": "dhūnanti vattanti pavattanti ambare ",
  "vv64:9.2": "abbhuddhanantā sukate pilandhane ",
  "vv64:9.3": "tesaṃ saro suyyati vaggurūpo ",
  "vv64:9.4": "pañcaṅgikaṃ turiyamivappavāditaṃ ",
  "vv64:10.1": "rathassa ghoso apilandhanāni ",
  "vv64:10.2": "khurassa nādī abhisaṃsanāya ca ",
  "vv64:10.3": "ghoso suvaggū samitassa suyyati ",
  "vv64:10.4": "gandhabbaturiyāni vicitrasavane ",
  "vv64:11.1": "rathe ṭhitā tā migamandalocanā ",
  "vv64:11.2": "āḷārapamhā hasitā piyaṃvadā ",
  "vv64:11.3": "veḷuriyajālā vinatā tanucchavā ",
  "vv64:11.4": "sadeva gandhabbasuraggapūjitā ",
  "vv64:12.1": "rattā rattambarapītavāsasā ",
  "vv64:12.2": "visālanettā abhirattalocanā ",
  "vv64:12.3": "kulesu jātā sutanū suvimhitā ",
  "vv64:12.4": "rathe ṭhitā pañjalikā upaṭṭhitā ",
  "vv64:13.1": "kākambukā yuradharā suvavāsasā ",
  "vv64:13.2": "sumajjhimā ūruthanopapannā ",
  "vv64:13.3": "vaṭṭaṅguliyo sumukhā sudassanā ",
  "vv64:13.4": "rathe ṭhitā pañjalikā upaṭṭhitā ",
  "vv64:14.1": "aññāsu veṇīsu sumissakesiyo ",
  "vv64:14.2": "samaṃ vibhattāhi pabhassarāhi ca ",
  "vv64:14.3": "anupubbatā tā tava mānase ratā ",
  "vv64:14.4": "rathe ṭhitā pañjalikā upaṭṭhitā ",
  "vv64:15.1": "āveḷiniyo padumuppalacchadā ",
  "vv64:15.2": "alaṅkatā candanasāravositā ",
  "vv64:15.3": "anupubbatā tā tava mānase ratā ",
  "vv64:15.4": "rathe ṭhitā pañjalikā upaṭṭhitā ",
  "vv64:16.1": "tā māliniyo padumuppalacchadā ",
  "vv64:16.2": "alaṅkatā candanasāravositā ",
  "vv64:16.3": "anupubbatā tā tava mānase ratā ",
  "vv64:16.4": "rathe ṭhitā pañjalikā upaṭṭhitā ",
  "vv64:17.1": "kaṇṭhesu te yāni pilandhanāni ca ",
  "vv64:17.2": "hatthesu pādesu tatheva sīse ",
  "vv64:17.3": "obhāsayanti dasa sabbato disā ",
  "vv64:17.4": "abbhuddayaṃ sāradikova bhāṇumā ",
  "vv64:18.1": "vātassa vegena ca sampakampitā ",
  "vv64:18.2": "bhujesu mālā apilandhanāni ca ",
  "vv64:18.3": "muñcanti ghosaṃ ruciraṃ suciṃ subhaṃ ",
  "vv64:18.4": "sabbehi viññūhi susattarūpaṃ ",
  "vv64:19.1": "uyyānabhumyā ca duvaṭṭhito ṭhitā ",
  "vv64:19.2": "rathā ca nāgā turiyāni vāsaro ",
  "vv64:19.3": "tameva devinda pamodayanti ",
  "vv64:19.4": "vīṇā yathā pokkharapattabāhuhi ",
  "vv64:20.1": "imāsu vīṇāsu bahūsu vaggūsu ",
  "vv64:20.2": "manuññarūpāsu hadayeritampi taṃ ",
  "vv64:20.3": "pavajjamānāsu atīva accharā ",
  "vv64:20.4": "bhamanti kaññā padumesu sikkhitā ",
  "vv64:21.1": "yathā ca gītāni ca vāditāni ca ",
  "vv64:21.2": "naccāni cimāni samenti ekato ",
  "vv64:21.3": "athettha naccanti athettha accharā ",
  "vv64:21.4": "obhāsayanti ubhato va rattiyā ",
  "vv64:22.1": "so modasi turiyagaṇappabodhano ",
  "vv64:22.2": "mahīyamāno vajirāvudhoriva ",
  "vv64:22.3": "imāsu vīṇāsu bahūsu vaggūsu ",
  "vv64:22.4": "manuññarūpāsu hadayeritampi taṃ ",
  "vv64:23.1": "kiṃ tvaṃ pure kammamakāsi attanā ",
  "vv64:23.2": "manussabhūto purimāya jātiyā ",
  "vv64:23.3": "uposathaṃ kiṃ va tuvaṃ upāvisi ",
  "vv64:23.4": "kiṃ dhammacariyaṃ vatamābhirocasi nayidaṃ ",
  "vv64:24.1": "appassa katassa kammuno ",
  "vv64:24.2": "pubbe suciṇṇassa uposathassa vā ",
  "vv64:24.3": "iddhānubhāvo vipulo ayaṃ tava ",
  "vv64:24.4": "yaṃ devasaṅghaṃ abhirocase bhusaṃ ",
  "vv64:25.1": "dānassa te idaṃ phalaṃ ",
  "vv64:25.2": "atho sīlassa vā pana ",
  "vv64:25.3": "atho añjalikammassa ",
  "vv64:25.4": "tamme akkhāhi pucchito (iti). ",
  "vv64:26.1": "so devaputto attamano ",
  "vv64:26.2": "moggallānena pucchito ",
  "vv64:26.3": "pañhaṃ puṭṭho viyākāsi ",
  "vv64:26.4": "yassa kammassidaṃ phalaṃ ",
  "vv64:27.1": "jitindriyaṃ buddhamanomanikkamaṃ ",
  "vv64:27.2": "naruttamaṃ kassapamaggapuggalaṃ ",
  "vv64:27.3": "apāpurantaṃ amatassa dvāraṃ ",
  "vv64:27.4": "devātidevaṃ satapuññalakkhaṇaṃ ",
  "vv64:28.1": "tamaddasaṃ kuñjaramoghatiṇṇaṃ ",
  "vv64:28.2": "suvaṇṇasiṅginadabimbasādisaṃ ",
  "vv64:28.3": "disvāna taṃ khippamahuṃ sucimano ",
  "vv64:28.4": "tameva disvāna subhāsitaddhajaṃ ",
  "vv64:29.1": "tamannapānaṃ atha vāpi cīvaraṃ ",
  "vv64:29.2": "suciṃ paṇītaṃ rasasā upetaṃ ",
  "vv64:29.3": "pupphābhikiṇṇamhi sake nivāsane ",
  "vv64:29.4": "patiṭṭhapesiṃ sa asaṅgamānaso ",
  "vv64:30.1": "tamannapānena ca cīvarena ca ",
  "vv64:30.2": "khajjena bhojjena ca sāyanena ca ",
  "vv64:30.3": "santappayitvā dipadānamuttamaṃ ",
  "vv64:30.4": "so saggaso devapure ramāmahaṃ ",
  "vv64:31.1": "etenupāyena imaṃ niraggalaṃ ",
  "vv64:31.2": "yaññaṃ yajitvā tividhaṃ visuddhaṃ ",
  "vv64:31.3": "pahāyahaṃ mānussakaṃ samussayaṃ ",
  "vv64:31.4": "indasamo devapure ramāmahaṃ ",
  "vv64:32.1": "āyuñca vaṇṇañca sukhaṃ balañca ",
  "vv64:32.2": "paṇītarūpaṃ abhikaṅkhatā muni ",
  "vv64:32.3": "annañca pānañca bahuṃ susaṅkhataṃ ",
  "vv64:32.4": "patiṭṭhapetabbamasaṅgamānaso ",
  "vv64:33.1": "imasmiṃ loke parasmiṃ vā pana ",
  "vv64:33.2": "buddhena seṭṭho ca samo na vijjati ",
  "vv64:33.3": "āhuneyyānaṃ paramāhutaṃ gato ",
  "vv64:33.4": "puññatthikānaṃ vipulapphalesinanti. ",
  "vv64:34.1": "mahārathavimānaṃ cuddasamaṃ. ",
  "vv64:34.2": "uddānaṃ ",
  "vv64:35.1": "",
  "vv64:36.1": "maṇḍūko revatī chatto ",
  "vv64:36.2": "kakkaṭako dvārapālako ",
  "vv64:36.3": "dve karaṇīyā dve sūcī ",
  "vv64:36.4": "tayo nāgā ca dve rathā ",
  "vv64:36.5": "purisānaṃ pañcamo vaggoti paṭhamo vaggo pavuccatīti. ",
  "vv64:37.1": "bhāṇavāraṃ tatiyaṃ. "
}
