  "pv28:0.1": "",
  "pv28:0.2": "",
  "pv28:0.3": "",
  "pv28:1.1": "ruciraṃ pabhassaraṃ ",
  "pv28:1.2": "vimānamāruyha anekacittaṃ ",
  "pv28:1.3": "tatthacchasi devi mahānubhāve ",
  "pv28:1.4": "pathaddhani paṇṇaraseva cando. ",
  "pv28:2.1": "vaṇṇo ca te kanakassa sannibho ",
  "pv28:2.2": "uttamarūpo bhusadassaneyyo ",
  "pv28:2.3": "pallaṅkaseṭṭhe atule nisinnā ",
  "pv28:2.4": "ekā tuvaṃ natthi tuyhaṃ sāmiko. ",
  "pv28:3.1": "imā ca te pokkharaññā samantato ",
  "pv28:3.2": "pahūtamāsā bahupuṇḍarīkā ",
  "pv28:3.3": "sovaṇṇacuṇṇehi samantamotatā ",
  "pv28:3.4": "na tattha paṅko paṇṇako ca vijjati. ",
  "pv28:4.1": "haṃsāpime dassanīyā manoramā ",
  "pv28:4.2": "udakasmiṃ anupariyanti sabbadā ",
  "pv28:4.3": "samayya vaggupanadanti sabbe ",
  "pv28:4.4": "bindussarā dundubhīnaṃ va ghoso. ",
  "pv28:5.1": "daddallamānā yasasā yasassinī ",
  "pv28:5.2": "nāvāya ca tvaṃ avalamba tiṭṭhasi ",
  "pv28:5.3": "ālāracamhe hasite piyaṃ vade ",
  "pv28:5.4": "sabbaṅgakalyāṇi bhusaṃ virocasi. ",
  "pv28:6.1": "idaṃ vimānaṃ virajaṃ sameṭṭhitaṃ uyyānavanaṃ ",
  "pv28:6.2": "ratinandavaḍḍhanaṃ icchāmi ",
  "pv28:6.3": "te nāri anomadassane ",
  "pv28:6.4": "tayā saha nandane idha moditunti. ",
  "pv28:7.1": "karohi kammaṃ idha vedanīyaṃ ",
  "pv28:7.2": "cittañca te idha nitañca hotu ",
  "pv28:7.3": "katvāna kammaṃ idha modanīyaṃ ",
  "pv28:7.4": "evaṃ mamaṃ lacchasi kāmakāmininti. ",
  "pv28:8.1": "sādhūti so tassā paṭisuṇitvā ",
  "pv28:8.2": "akāsi kammaṃ tahiṃ vedanīyaṃ ",
  "pv28:8.3": "katvāna kammaṃ tahiṃ vedanīyaṃ ",
  "pv28:8.4": "uppajji māṇavo tassā sahabyatanti. ",
  "pv28:9.1": "rathakārīpetavatthu tatiyaṃ. ",
  "pv28:9.2": "bhāṇavāraṃ dutiyaṃ. 4 "
}
