  "pv24:1.1": "12 sovaṇṇasopāṇaphalakā ",
  "pv24:1.2": "sovaṇṇavālukasanthatā ",
  "pv24:1.3": "tattha so gandhiyo vaggū ",
  "pv24:1.4": "sucigandhā manoramā ",
  "pv24:2.1": "nānārukkhehi sañchannā ",
  "pv24:2.2": "nānāgandhasameritā ",
  "pv24:2.3": "nānāpadumasañchannā ",
  "pv24:2.4": "puṇḍarīkasamohatā. ",
  "pv24:3.1": "surabhī sampavāyanti ",
  "pv24:3.2": "manuññā māluteritā ",
  "pv24:3.3": "haṃsakoñcābhirudā ca ",
  "pv24:3.4": "cakkavākābhikujitā ",
  "pv24:4.1": "nānādijagaṇākiṇṇā ",
  "pv24:4.2": "nānāsaragaṇāyutā ",
  "pv24:4.3": "nānāphaladharā rukkhā ",
  "pv24:4.4": "nānāmāladharā vanā. ",
  "pv24:5.1": "na manussesu īdisaṃ ",
  "pv24:5.2": "nagaraṃ yādisaṃ idaṃ ",
  "pv24:5.3": "pāsādā ca bahukā tuyhaṃ ",
  "pv24:5.4": "sovaṇṇarūpiyamayā ",
  "pv24:5.5": "daddallamānā ābhenti ",
  "pv24:5.6": "samantā caturo disā. ",
  "pv24:6.1": "pañca dāsīsatā tuyhaṃ ",
  "pv24:6.2": "yā temā paricārikā ",
  "pv24:6.3": "tā kambukāyūradharā ",
  "pv24:6.4": "kañcanācelabhūsitā. ",
  "pv24:7.1": "pallaṅkā bahukā tuyhaṃ ",
  "pv24:7.2": "sovaṇṇarūpiyamayā ",
  "pv24:7.3": "kadalīmigasañchannā ",
  "pv24:7.4": "sajjā goṇakasanthatā ",
  "pv24:8.1": "yattha tuvaṃ vāsupagatā ",
  "pv24:8.2": "sabbakāmasamiddhinī. ",
  "pv24:8.3": "sampattāya aḍḍharattāya ",
  "pv24:8.4": "tato uṭṭhāya gacchasi ",
  "pv24:9.1": "uyyānabhūmiṃ gantvāna ",
  "pv24:9.2": "pokkharaññā samantato. ",
  "pv24:9.3": "tassā tīre tuvaṃ thāsi ",
  "pv24:9.4": "harite saddale subhe ",
  "pv24:10.1": "tato te kaṇṇamuṇḍo ca sunakho ",
  "pv24:10.2": "aṅgamaṅgāni khādati. ",
  "pv24:10.3": "yadā ca khāyitā āsi ",
  "pv24:10.4": "aṭṭhisaṅkhalikā katā ",
  "pv24:10.5": "ogāhasi pokkharaṇiṃ ",
  "pv24:10.6": "hoti kāyo yathā pure. ",
  "pv24:11.1": "tato tvaṃ aṅgapaccaṅgī ",
  "pv24:11.2": "sucārū piyadassanā ",
  "pv24:11.3": "vatthena pārupitvāna ",
  "pv24:11.4": "āyāsi mama santikaṃ. ",
  "pv24:12.1": "kinnu kāyena vācāya ",
  "pv24:12.2": "manasā dukkaṭaṃ kataṃ ",
  "pv24:12.3": "kissa kammavipākena ",
  "pv24:12.4": "kaṇṇamuṇḍo ca sunakho ",
  "pv24:12.5": "aṅgamaṅgāni khādatīti. ",
  "pv24:13.1": "kimbilāyaṃ gahapati ",
  "pv24:13.2": "saddho āsi upāsako ",
  "pv24:13.3": "tassāhaṃ bhariyā āsi ",
  "pv24:13.4": "dussīlā aticārinī. ",
  "pv24:14.1": "evamāticaramānāya ",
  "pv24:14.2": "sāmiko etadabrūvi ",
  "pv24:14.3": "netaṃ channaṃ paṭirūpaṃ ",
  "pv24:14.4": "yaṃ tvaṃ aticarāsi maṃ. ",
  "pv24:15.1": "sāhaṃ ghorañca sapathaṃ ",
  "pv24:15.2": "musāvādaṃ abhāsissaṃ ",
  "pv24:15.3": "nāhantaṃ aticarāmi ",
  "pv24:15.4": "kāyena uda cetasā ",
  "pv24:16.1": "sacāhantaṃ aticarāmi ",
  "pv24:16.2": "kāyena uda cetasā ",
  "pv24:16.3": "ayaṃ kaṇṇamuṇḍo sunakho ",
  "pv24:16.4": "aṅgamaṅgāni khādatu. ",
  "pv24:17.1": "tassa kammassa vipākaṃ ",
  "pv24:17.2": "musāvādassa cūbhayaṃ ",
  "pv24:17.3": "sattavassasatāni ca ",
  "pv24:17.4": "anubhūtaṃ yatopi me ",
  "pv24:17.5": "kaṇṇamuṇḍo ca sunakho ",
  "pv24:17.6": "aṅgamaṅgāni khādatīti. ",
  "pv24:18.1": "tvañca deva bahūpakāro ",
  "pv24:18.2": "atthāya me idhāgato ",
  "pv24:18.3": "sumuttāhaṃ kaṇṇamuṇḍassa ",
  "pv24:18.4": "asokā akutobhayā ",
  "pv24:19.1": "nāhaṃ deva namassāmi ",
  "pv24:19.2": "yācāmi añjalīkatā ",
  "pv24:19.3": "bhuñja amānuse kāme ",
  "pv24:19.4": "rama deva mayā sahāti. ",
  "pv24:20.1": "bhuttā amānusā kāmā ",
  "pv24:20.2": "ramitomhi tayā saha ",
  "pv24:20.3": "tāhaṃ subhage yācāmi ",
  "pv24:20.4": "khippaṃ paṭinayāhi manti. ",
  "pv24:21.1": "kaṇṇamuṇḍapetavatthu dvādasamaṃ. "
}
