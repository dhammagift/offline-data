  "pv3:1.1": "dibbaṃ subhaṃ dhāresi vaṇṇadhātuṃ ",
  "pv3:1.2": "vehāyasaṃ tiṭṭhasi antalikkhe ",
  "pv3:1.3": "mukhañca te kimiyo pūtigandhaṃ ",
  "pv3:1.4": "khādanti kiṃ kammamakāsi pubbeti. ",
  "pv3:2.1": "samaṇo ahaṃ pāpo dukkhavāco ",
  "pv3:2.2": "tapassirūpo mukhasā asaññato ",
  "pv3:2.3": "laddhā ca me tapasā vaṇṇadhātu ",
  "pv3:2.4": "mukhañca me pesuniyena pūti. ",
  "pv3:3.1": "tayidaṃ tayā nārada sāmaṃ diṭṭhaṃ ",
  "pv3:3.2": "anukampakā ye kusalā vadeyyuṃ ",
  "pv3:3.3": "mā pesunaṃ mā ca musā abhāṇi ",
  "pv3:3.4": "yakkho tuvaṃ hohisi kāmakāmīti. ",
  "pv3:4.1": "pūtimukhapetvatthu tatiyaṃ. 4 yaṅkiñcārammaṇaṃ "
}
