  "pv11:0.1": "",
  "pv11:0.2": "",
  "pv11:0.3": "",
  "pv11:1.1": "11 purato ca setena paleti hatthinā ",
  "pv11:1.2": "majjhe pana assatarīrathena ",
  "pv11:1.3": "pacchā ca kaññā sivikāyaṃ niyyāti ",
  "pv11:1.4": "obhāsayantī dasa sabbato disā. ",
  "pv11:2.1": "tumhe pana muggarahatthapāṇino ",
  "pv11:2.2": "rudammukhā bhinnapabhinnagattā ",
  "pv11:2.3": "manussabhūtā kimakattha pāpaṃ ",
  "pv11:2.4": "yenaññamaññassa pivātha lohitaṃ (iti). ",
  "pv11:3.1": "purato va yo gacchati kuñjarena ",
  "pv11:3.2": "setena nāgena catukkamena ",
  "pv11:3.3": "amhākaṃ putto ahu so pajeṭṭhako ",
  "pv11:3.4": "dānāni datvāna sukhiṃ pamodati. ",
  "pv11:4.1": "yo so majjhe assatarīrathena ",
  "pv11:4.2": "catubbhi yuttena suvaggitena ",
  "pv11:4.3": "amhākaṃ putto ahu majjhimo so ",
  "pv11:4.4": "amaccharī dānapati virocati. ",
  "pv11:5.1": "yā sā pacchā sivikāya niyyāti ",
  "pv11:5.2": "nārī sapaññā migamaṇḍalocanā ",
  "pv11:5.3": "amhākaṃ dhītā ahu sā kaniṭṭhā ",
  "pv11:5.4": "bhāgaḍḍhabhāgena sukhī pamodati. ",
  "pv11:6.1": "ete ca dānāni adaṃsu pubbe ",
  "pv11:6.2": "pasannacittā samaṇabrāhmaṇānaṃ ",
  "pv11:6.3": "mayaṃ pana maccharino ahumhā ",
  "pv11:6.4": "paribhāsakā samaṇabrāhmaṇānaṃ ",
  "pv11:6.5": "ete ca datvā paricārayanti ",
  "pv11:6.6": "mayañca sussāma naḷova dittoti. ",
  "pv11:7.1": "kiṃ tumhākaṃ bhojanaṃ kiṃ sayanaṃ ",
  "pv11:7.2": "kathañca yāpetha supāpadhammino ",
  "pv11:7.3": "pahūtabhogesu anappakesu ",
  "pv11:7.4": "sukhaṃ virāgāya dukkhajja pattā. ",
  "pv11:8.1": "aññamaññaṃ vadhitvāna ",
  "pv11:8.2": "pivāma pubbalohitaṃ ",
  "pv11:8.3": "bahuṃ pitvā na dātā homa ",
  "pv11:8.4": "nacchādimhamhase mayaṃ. ",
  "pv11:9.1": "icceva maccā paridevayanti ",
  "pv11:9.2": "adāyikā pecca yamassa ṭhāyino ",
  "pv11:9.3": "ye te viriccā adhigamma bhoge ",
  "pv11:9.4": "na bhuñjare nāpi karonti puññaṃ. ",
  "pv11:10.1": "te khuppipāsupagatā parattha ",
  "pv11:10.2": "pacchā ciraṃ jhāyire ḍayhamānā ",
  "pv11:10.3": "kammāni katvāna dukkhudrayāni ",
  "pv11:10.4": "anubhonti dukkhaṃ kaṭukapphalāni. ",
  "pv11:11.1": "ittaraṃ hi dhanadhaññaṃ ",
  "pv11:11.2": "ittaraṃ idha jīvitaṃ ",
  "pv11:11.3": "ittaraṃ ittarato ñatvā ",
  "pv11:11.4": "dīpaṃ kayirātha paṇḍito. ",
  "pv11:12.1": "ye te evaṃ pajānanti ",
  "pv11:12.2": "narā dhammassa kovidā ",
  "pv11:12.3": "te dāne nappamajjanti ",
  "pv11:12.4": "sutvā arahataṃ vacoti. ",
  "pv11:13.1": "nāgapetavatthu ekādasamaṃ. "
}
