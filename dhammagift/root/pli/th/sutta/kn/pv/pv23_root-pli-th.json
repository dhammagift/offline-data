  "pv23:0.3": "",
  "pv23:1.1": "ahaṃ pure pabbajitassa bhikkhuno ",
  "pv23:1.2": "suttaṃ adāsi upagamma yācitā ",
  "pv23:1.3": "tassa vipāko vipulaṃ phalūpalabbhati ",
  "pv23:1.4": "bahū ca me uppajjare vatthakoṭiyo. ",
  "pv23:2.1": "pupphābhikiṇṇaṃ ramitaṃ vimānaṃ ",
  "pv23:2.2": "anekacittaṃ naranārisevitaṃ ",
  "pv23:2.3": "sāhaṃ bhuñjāmi ca pārupāmi ca ",
  "pv23:2.4": "pahūtavittā na ca tāva khīyati. ",
  "pv23:3.1": "tasseva kammassa vipākamanvyā ",
  "pv23:3.2": "sukhañca sātañca idhūpalabbhati ",
  "pv23:3.3": "sāhaṃ gantvā punadeva mānusaṃ ",
  "pv23:3.4": "kāhāmi puññāni nayeyyaputta manti. ",
  "pv23:4.1": "satta tuvaṃ vassasatā idhāgatā ",
  "pv23:4.2": "jiṇṇā ca vuḍḍhā ca tahiṃ bhavissasi ",
  "pv23:4.3": "sabbeva te kālakatā ca ñātakā ",
  "pv23:4.4": "tvaṃ tattha gantvāna ito karissasīti. ",
  "pv23:5.1": "satteva vassāni idhāgatāya me ",
  "pv23:5.2": "dibbañca sukhañca samappitāya ",
  "pv23:5.3": "sāhaṃ gantvā punareva mānusaṃ ",
  "pv23:5.4": "kāhāmi puññāni nayeyyaputta manti. ",
  "pv23:6.1": "so taṃ gahetvāna pasayha bāhāyaṃ ",
  "pv23:6.2": "paccānayitvāna punareva theriṃ sudubbalaṃ ",
  "pv23:6.3": "vajjesi aññaṃpi janaṃ idhāgataṃ ",
  "pv23:6.4": "karotha puññāni sukhūpalabbhatīti. ",
  "pv23:7.1": "diṭṭhā mayā akatena sādhunā ",
  "pv23:7.2": "petā vihaññanti tatheva mānusā ",
  "pv23:7.3": "kammañca katvā sukhavedanīyaṃ ",
  "pv23:7.4": "devā manussā ca sukhe ṭhitā pajāti. ",
  "pv23:8.1": "suttapetavatthu ekādasamaṃ. 12 sovaṇṇasopāṇaphalakā sovaṇṇavālukasanthatā "
}
