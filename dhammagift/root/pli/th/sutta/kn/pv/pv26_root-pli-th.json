  "pv26:1.1": "abhijjamāne vārimhi ",
  "pv26:1.2": "gaṅgāya idha gacchasi ",
  "pv26:1.3": "naggo pubbaḍḍhapetova ",
  "pv26:1.4": "mālādhārī alaṅkato ",
  "pv26:1.5": "kuhiṃ gamissasi peto ",
  "pv26:1.6": "kattha vāso bhavissatīti. ",
  "pv26:2.1": "cundaṭṭhilaṃ gamissāmi ",
  "pv26:2.2": "peto so iti bhāsati ",
  "pv26:2.3": "antare vāsabhagāmaṃ ",
  "pv26:2.4": "bārāṇasiyā va santike. ",
  "pv26:3.1": "tañca disvā mahāmatto ",
  "pv26:3.2": "koliyo iti vissuto ",
  "pv26:3.3": "sattubhattañca petassa ",
  "pv26:3.4": "pītakañca yugaṃ adā. ",
  "pv26:4.1": "nāvāya tiṭṭhamānāya ",
  "pv26:4.2": "kappakassa adāpayi ",
  "pv26:4.3": "kappakassa padinnamhi ",
  "pv26:4.4": "ṭhāne petassa dissatha. ",
  "pv26:5.1": "tato suvatthavasano ",
  "pv26:5.2": "mālādhārī alaṅkato ",
  "pv26:5.3": "ṭhāne ṭhitassa petassa ",
  "pv26:5.4": "dakkhiṇā upakappatha ",
  "pv26:5.5": "tasmā dajjetha petānaṃ ",
  "pv26:5.6": "anukampāya punappunanti. ",
  "pv26:6.1": "sāhunnavāsino eke ",
  "pv26:6.2": "aññe kesanivāsino ",
  "pv26:6.3": "petā bhattāya gacchanti ",
  "pv26:6.4": "pakkamanti diso ",
  "pv26:7.1": "disaṃ. dūrepekepadhāvitvā aladdhā ",
  "pv26:7.2": "ca nivattare ",
  "pv26:7.3": "chātā pamucchitā gantvā ",
  "pv26:7.4": "bhūmiyaṃ paṭisumbhitā ",
  "pv26:8.1": "keci tattha ca patitā ",
  "pv26:8.2": "bhūmiyaṃ paṭisumbhitā ",
  "pv26:8.3": "pubbe akatakalyāṇā ",
  "pv26:8.4": "aggidaḍḍhāva ātape. ",
  "pv26:9.1": "mayaṃ pubbe pāpadhammā ",
  "pv26:9.2": "gharaṇikulamātaro ",
  "pv26:9.3": "santesu deyyadhammesu ",
  "pv26:9.4": "dīpaṃ nākamha attano. ",
  "pv26:10.1": "pahūtaṃ annapānaṃ hi ",
  "pv26:10.2": "apissu avakirīyati ",
  "pv26:10.3": "samaggate pabbajite ",
  "pv26:10.4": "na ca kiñci adamhase. ",
  "pv26:11.1": "akammakāmā alasā ",
  "pv26:11.2": "sādhukāmā mahagghasā ",
  "pv26:11.3": "ālopapiṇḍadātāro ",
  "pv26:11.4": "paṭiggahe paribhāsitā. ",
  "pv26:12.1": "te gharā tā va dāsiyo ",
  "pv26:12.2": "tānevābharaṇāni no ",
  "pv26:12.3": "te añño paricārenti ",
  "pv26:12.4": "mayaṃ dukkhassa bhāgino ",
  "pv26:13.1": "veṇiṃ vā avaññā honti ",
  "pv26:13.2": "rathakārī ca dubbhikā ",
  "pv26:13.3": "caṇḍālī kapaṇā honti ",
  "pv26:13.4": "kappakā ca punappunaṃ. ",
  "pv26:14.1": "yāni yāni nihīnāni ",
  "pv26:14.2": "kulāni kapaṇāni ca ",
  "pv26:14.3": "tesu tesveva jāyanti ",
  "pv26:14.4": "esā maccharino gati. ",
  "pv26:15.1": "pubbe ca katakalyāṇā ",
  "pv26:15.2": "dāyakā vītamaccharā ",
  "pv26:15.3": "saggante paripūrenti ",
  "pv26:15.4": "obhāsenti ca nandanaṃ. ",
  "pv26:16.1": "vejayante ca pāsāde ",
  "pv26:16.2": "ramitvā kāmakāmino ",
  "pv26:16.3": "uccākulesu jāyanti ",
  "pv26:16.4": "sabhogesu tato cutā. ",
  "pv26:17.1": "kūṭāgāre ca pāsāde ",
  "pv26:17.2": "pallaṅke goṇakatthate ",
  "pv26:17.3": "vijitaṅgā morahatthehi ",
  "pv26:17.4": "kule jātā yasassino. ",
  "pv26:18.1": "aṅgato aṅgaṃ gacchanti ",
  "pv26:18.2": "mālādhārī alaṅkatā ",
  "pv26:18.3": "jātiyo upatiṭṭhanti ",
  "pv26:18.4": "sāyaṃ pātaṃ sukhesino. ",
  "pv26:19.1": "nayidaṃ akatapuññānaṃ ",
  "pv26:19.2": "katapuññānamevidaṃ ",
  "pv26:19.3": "asokaṃ nandanaṃ rammaṃ ",
  "pv26:19.4": "tidasānaṃ mahāvanaṃ ",
  "pv26:20.1": "sukhaṃ akatapuññānaṃ ",
  "pv26:20.2": "idha natthi parattha ca ",
  "pv26:20.3": "sukhañca katapuññānaṃ ",
  "pv26:20.4": "idha ceva paratthaca. ",
  "pv26:21.1": "tesaṃ sahabyakāmānaṃ ",
  "pv26:21.2": "kattabbaṃ kusalaṃ bahuṃ ",
  "pv26:21.3": "katapuññā hi modanti ",
  "pv26:21.4": "sagge bhogasamaṅginoti. ",
  "pv26:22.1": "abhijjamānapetavatthu paṭhamaṃ. 2 "
}
