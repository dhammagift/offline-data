  "pv46:0.3": "",
  "pv46:1.1": "11 diṭṭhā tayā nirayā tiracchānayonī ",
  "pv46:1.2": "petā asurā vāpi manussadevā ",
  "pv46:1.3": "sayamaddasa kammavipākamattano ",
  "pv46:1.4": "nessāmi taṃ pāṭaliputtamakkhataṃ ",
  "pv46:1.5": "tattha gantvā kusalaṃ karohi kammanti. ",
  "pv46:2.1": "atthakāmosi me yakkha ",
  "pv46:2.2": "hitakāmosi devate ",
  "pv46:2.3": "karomi tuyhaṃ vacanaṃ ",
  "pv46:2.4": "tvamasi ācariyo me. ",
  "pv46:3.1": "diṭṭhā mayā nirayā tiracchānayonī ",
  "pv46:3.2": "petā asurā vāpi manussadevā sayamaddasa ",
  "pv46:3.3": "kammavipākamattano ",
  "pv46:3.4": "kāhāmi puññāni anappakānīti. ",
  "pv46:4.1": "pāṭaliputtapetavatthu ekādasamaṃ. "
}
