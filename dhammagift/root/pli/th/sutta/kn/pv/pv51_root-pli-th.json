  "pv51:1.1": "ummattarūpova ",
  "pv51:1.2": "migo bhantova dhāvasi ",
  "pv51:1.3": "nisaṃsayaṃ pāpakammaṃ ",
  "pv51:1.4": "kinnu saddayase tuvanti. ",
  "pv51:2.1": "ahaṃ bhante petomhi ",
  "pv51:2.2": "duggato yamalokiko ",
  "pv51:2.3": "pāpakammaṃ karitvāna ",
  "pv51:2.4": "petalokaṃ ito gato. ",
  "pv51:3.1": "saṭṭhī kūṭasahassāni ",
  "pv51:3.2": "paripuṇṇāni sabbaso ",
  "pv51:3.3": "sīse mayhaṃ nipatanti ",
  "pv51:3.4": "te bhindanti ca matthakanti. ",
  "pv51:4.1": "kinnu kāyena vācāya ",
  "pv51:4.2": "manasā dukkaṭaṃ kataṃ ",
  "pv51:4.3": "kissa kammavipākena ",
  "pv51:4.4": "petalokaṃ ito gatoti. ",
  "pv51:5.1": "saṭṭhī kūṭasahassāni ",
  "pv51:5.2": "paripuṇṇāni sabbaso ",
  "pv51:5.3": "sīse tuyhaṃ nipatanti ",
  "pv51:5.4": "te bhindanti ca matthakanti. ",
  "pv51:6.1": "athaddusāsiṃ sambuddhaṃ ",
  "pv51:6.2": "sunettaṃ bhāvitindriyaṃ ",
  "pv51:6.3": "nisinnaṃ rukkhamūlasmiṃ ",
  "pv51:6.4": "jhāyantaṃ akutobhayaṃ. ",
  "pv51:7.1": "sālittakappahārena no ",
  "pv51:7.2": "bhindissaṃ tassa matthakaṃ ",
  "pv51:7.3": "tassa kammavipākena ",
  "pv51:7.4": "idaṃ dukkhaṃ nigacchati. ",
  "pv51:8.1": "saṭṭhī kūṭasahassāni ",
  "pv51:8.2": "paripuṇṇāni sabbaso ",
  "pv51:8.3": "sīse mayhaṃ nipatanti ",
  "pv51:8.4": "te bhindanti ca matthakanti. ",
  "pv51:9.1": "dhammena te kāpurisa ",
  "pv51:9.2": "saṭṭhī kūṭasahassāni ",
  "pv51:9.3": "paripuṇṇāni sabbaso ",
  "pv51:9.4": "sīse tuyhaṃ nipatanti ",
  "pv51:9.5": "te bhindanti ca matthakanti. ",
  "pv51:10.1": "saṭṭhikūṭasahassapetavatthu soḷasamaṃ. ",
  "pv51:11.1": "",
  "pv51:12.1": "tassuddānaṃ ",
  "pv51:13.1": "ambasakkharo serissako ca ",
  "pv51:13.2": "piṅgalo revatī ucchukhādako ",
  "pv51:13.3": "dve kumārā dve gūthabhojanā pāṭalipokkharaṇī ",
  "pv51:13.4": "ca ",
  "pv51:14.1": "akkhato ",
  "pv51:14.2": "bhogasaṃharā ",
  "pv51:14.3": "seṭṭhiputtā saṭṭhikūṭasahassāni ",
  "pv51:14.4": "vaggo tena pavuccatīti. ",
  "pv51:15.1": "mahāvaggo ",
  "pv51:16.1": "",
  "pv51:16.2": "catuttho. ",
  "pv51:16.3": "petavatthu ",
  "pv51:16.4": "samattaṃ. ",
  "pv51:17.1": ""
}
