{
  "pv36:0.1": "catuttho mahāvaggo ",
  "pv36:0.2": "",
  "pv36:0.3": "",
  "pv36:1.1": "1 vesāli nāma nagaratthi vajjīnaṃ ",
  "pv36:1.2": "tattha ahu licchavi ambasakkharo ",
  "pv36:1.3": "disvāna petaṃ nagarassa bāhiraṃ ",
  "pv36:1.4": "tattheva pucchittha taṃ kāraṇatthiko. ",
  "pv36:2.1": "seyyā nisajjā nayimassa atthi ",
  "pv36:2.2": "abhikkamo natthi paṭikkamo ca ",
  "pv36:2.3": "asītapītaṃ khāyitavatthabhogā ",
  "pv36:2.4": "paricārikā sāpi imassa natthi. ",
  "pv36:3.1": "ye ñātakā diṭṭhasutā suhajjā ",
  "pv36:3.2": "anukampakā yassa ahesuṃ pubbe ",
  "pv36:3.3": "daṭṭhuṃpi dāni na labhanti taṃpi ",
  "pv36:3.4": "virājitatto hi janena tena. ",
  "pv36:4.1": "na duggatassa bhavanti mittā ",
  "pv36:4.2": "jahanti mittā vikalaṃ viditvā ",
  "pv36:4.3": "atthañca disvā parivārayanti ",
  "pv36:4.4": "bahū ca mittā uggatassa honti. ",
  "pv36:5.1": "nihīnattho sabbabhogehi kiccho ",
  "pv36:5.2": "sammakkhito saṃparibhinnagatto ",
  "pv36:5.3": "ussāvabinduva palimpamāno ",
  "pv36:5.4": "ajja suve jīvitassuparodho. ",
  "pv36:6.1": "etādisaṃ uttamakicchapattaṃ ",
  "pv36:6.2": "uttāsitaṃ picumandassa sūle ",
  "pv36:6.3": "atha tvaṃ kena vaṇṇena vadesi yakkha ",
  "pv36:6.4": "jīva bho jīvitameva seyyoti. ",
  "pv36:7.1": "sālohito eso ahosi mayhaṃ ",
  "pv36:7.2": "ahaṃ sarāmi purimāya jātiyā ",
  "pv36:7.3": "disvā ca me kāruññaṃ ahosi rāja ",
  "pv36:7.4": "mā pāpadhammo nirayaṃ patāyaṃ. ",
  "pv36:8.1": "ito cuto licchavi esa poso ",
  "pv36:8.2": "sattussadaṃ nīrayaṃ ghorarūpaṃ ",
  "pv36:8.3": "uppajjati dukkaṭakammakārī ",
  "pv36:8.4": "mahābhitāpaṃ kaṭukaṃ bhayānakaṃ. ",
  "pv36:9.1": "anekabhāgena guṇena seyyo ",
  "pv36:9.2": "ayameva sūlo nirayena tena mā ",
  "pv36:9.3": "ekantadukkhaṃ kaṭukaṃ bhayānakaṃ ",
  "pv36:9.4": "ekantatippaṃ nirayaṃ patāyaṃ. ",
  "pv36:10.1": "idañca sutvā vacanaṃ mameso ",
  "pv36:10.2": "dukkhūpanīto vijaheyya pāpaṃ ",
  "pv36:10.3": "tasmā ahaṃ santike na bhaṇāmi ",
  "pv36:10.4": "mā mekato jīvatassuparodhoti. ",
  "pv36:11.1": "aññāto eso purisassa attho ",
  "pv36:11.2": "aññaṃpi icchāmase pucchituṃ tuvaṃ ",
  "pv36:11.3": "okāsakammaṃ mama no sace karosi ",
  "pv36:11.4": "pucchāmihaṃ na ca no kujjhitabbaṃ. ",
  "pv36:12.1": "addhā paṭiññā me tadā ahu ",
  "pv36:12.2": "acikkhanā appasannassa hoti ",
  "pv36:12.3": "akāmāsaddheyyavacoti katvā ",
  "pv36:12.4": "pucchassu maṃ kāmaṃ yathā visayhanti. ",
  "pv36:13.1": "yaṃ kiñcāhaṃ cakkhunā passissāmi ",
  "pv36:13.2": "sabbaṃpi tāhaṃ abhisaddaheyyaṃ ",
  "pv36:13.3": "disvāpi taṃ nopi ce saddaheyya ",
  "pv36:13.4": "kareyyāsi me yakkha tiyassa kammanti. ",
  "pv36:14.1": "saccappaṭiññā tava mesā hotu ",
  "pv36:14.2": "sutvāna dhammaṃ labhassupasādaṃ ",
  "pv36:14.3": "aññatthiko no ca paduṭṭhacitto ",
  "pv36:14.4": "yante sutaṃ asutaṃ vāpi dhammaṃ. ",
  "pv36:14.5": "sabbaṃ akkhissaṃ yathā pajānaṃ ",
  "pv36:15.1": "setena assena alaṅkatena ",
  "pv36:15.2": "upayāsi sūlāvutakassa santike ",
  "pv36:15.3": "yānaṃ idaṃ abbhūtaṃ dassaneyyaṃ ",
  "pv36:15.4": "kissetaṃ kammassa ayaṃ vipāko. ",
  "pv36:16.1": "vesāliyā tassa nagarassa majjhe ",
  "pv36:16.2": "cikkhalamagge nagaraṃ ahosi ",
  "pv36:16.3": "gosīsamekāhaṃ pasannacitto ",
  "pv36:16.4": "setuṃ gahetvā nagarasmiṃ nikkhipi. ",
  "pv36:17.1": "etasmiṃ pādāni patiṭṭhapetvā ",
  "pv36:17.2": "mayañca aññe ca atikkamimha ",
  "pv36:17.3": "yānaṃ idaṃ abbhūtaṃ dassaneyyaṃ ",
  "pv36:17.4": "tasseva kammassa ayaṃ vipāko. ",
  "pv36:18.1": "vaṇṇo ca te sabbadisā pabhāsati ",
  "pv36:18.2": "gandho ca te sabbadisā pavāyati ",
  "pv36:18.3": "yakkhiddhipattosi mahānubhāvo ",
  "pv36:18.4": "naggo cāsi kissa ayaṃ vipāko. ",
  "pv36:19.1": "akkodhano niccapasannacitto ",
  "pv36:19.2": "saṇhāhi vācāhi janaṃ upesi ",
  "pv36:19.3": "tasseva kammassa ayaṃ vipāko ",
  "pv36:19.4": "dibbo me vaṇṇo satataṃ pabhāsati. ",
  "pv36:20.1": "yasañca kittiñca dhamme ṭhitānaṃ ",
  "pv36:20.2": "disvāna mantemi pasannacitto ",
  "pv36:20.3": "tasseva kammassa ayaṃ vipāko ",
  "pv36:20.4": "dibbo me gandho satataṃ pavāyati. ",
  "pv36:21.1": "sahāyānaṃ tiṭṭhasmiṃ nahāyantānaṃ ",
  "pv36:21.2": "thale gahetvā nidahissa dussaṃ ",
  "pv36:21.3": "kiñcatthiko no ca paduṭṭhacitto ",
  "pv36:21.4": "tenamhi naggo kasirā pavutti. ",
  "pv36:22.1": "yo kīḷamāno ca karoti pāpaṃ ",
  "pv36:22.2": "tassīdisaṃ kammavipākamāhu ",
  "pv36:22.3": "akīḷamāno pana yo karoti ",
  "pv36:22.4": "kiṃ tassa kammassa vipākamāhu. ",
  "pv36:23.1": "ye duṭṭhasaṅkappamanā manussā ",
  "pv36:23.2": "kāyena vācāya ca saṅkiliṭṭhā ",
  "pv36:23.3": "kāyassa bhedā abhisamparāyaṃ ",
  "pv36:23.4": "asaṃsayaṃ te nirayaṃ upenti. ",
  "pv36:24.1": "apare pana sugatiṃ āsisamānā ",
  "pv36:24.2": "dāne ratā saṅgahitattabhāvā ",
  "pv36:24.3": "kāyassa bhedā abhisamparāyaṃ ",
  "pv36:24.4": "asaṃsayaṃ te sugatiṃ upentīti. ",
  "pv36:25.1": "taṃ kinti jāneyyaṃ ahaṃ avecca ",
  "pv36:25.2": "kalyāṇapāpassa ayaṃ vipāko ",
  "pv36:25.3": "kiṃ vāhaṃ disvā abhisaddaheyyaṃ ",
  "pv36:25.4": "ko vāpi maṃ saddahāpeyya etanti. ",
  "pv36:26.1": "disvā ca sutvā abhisaddahassu ",
  "pv36:26.2": "kalyāṇapāpassa ayaṃ vipāko ",
  "pv36:26.3": "kalyāṇapāpe ubhaye asante ",
  "pv36:26.4": "siyā nu sattā sugatā duggatā vā. ",
  "pv36:27.1": "no cettha kammāni kareyya maccā ",
  "pv36:27.2": "kalyāṇapāpāni manussaloke ",
  "pv36:27.3": "nāhesuṃ sattā sugatā duggatā vā ",
  "pv36:27.4": "hīnā paṇītā ca manussaloke. ",
  "pv36:28.1": "yasmā ca kammāni karonti maccā ",
  "pv36:28.2": "kalyāṇapāpāni manussaloke ",
  "pv36:28.3": "tasmā sattā sugatā duggatā vā ",
  "pv36:28.4": "hīnā paṇītā ca manussaloke. ",
  "pv36:29.1": "dvayañca kammānaṃ vipākamāhu ",
  "pv36:29.2": "sukhassa dukkhassa ca vedanīyaṃ ",
  "pv36:29.3": "tāva devatā parivārayanti ",
  "pv36:29.4": "paccanti bālā dvayataṃ apassinoti. ",
  "pv36:30.1": "na matthi kammāni sayaṃ katāni ",
  "pv36:30.2": "datvāpi me natthi so ādiseyya ",
  "pv36:30.3": "acchādanaṃ sayanamathannapānaṃ ",
  "pv36:30.4": "tenamhi naggo kasirā pavuttīti. ",
  "pv36:31.1": "siyā nu kho kāraṇaṃ kiñci yakkha ",
  "pv36:31.2": "acchādanaṃ yena tuvaṃ labhetha ",
  "pv36:31.3": "ācikkha me tvaṃ yadatthi hetu ",
  "pv36:31.4": "saddhāyitaṃ hetuvaco suṇoti. ",
  "pv36:32.1": "kappitako nāma idhatthi bhikkhu ",
  "pv36:32.2": "jhāyī susīlo arahā vimutto ",
  "pv36:32.3": "guttindriyo saṃvutapātimokkho ",
  "pv36:32.4": "sītibhūto uttamadiṭṭhipatto ",
  "pv36:33.1": "sakhilo vadaññū suvaco sumukho ",
  "pv36:33.2": "svāgamo suppaṭimuttako cāpi ",
  "pv36:33.3": "puññassa khettaṃ araṇavihārī ",
  "pv36:33.4": "devamanussānañca dakkhiṇeyyo ",
  "pv36:34.1": "santo vidhūmo anīgho nirāso ",
  "pv36:34.2": "mutto visallo amamo avaṅko ",
  "pv36:34.3": "nirūpadhi sabbapapañcakhīṇo ",
  "pv36:34.4": "tisso vijjā anuppatto jutimā. ",
  "pv36:35.1": "appaññato disvāpi na sujāno ",
  "pv36:35.2": "munīti naṃ vajjīsu voharanti ",
  "pv36:35.3": "jānanti taṃ yakkhabhūtaṃ anejaṃ ",
  "pv36:35.4": "kalyāṇadhammaṃ vicarantaṃ loke. ",
  "pv36:36.1": "tassa tuvaṃ ekaṃ yugaṃ duve vā ",
  "pv36:36.2": "mamuddisitvāna sace dadetha ",
  "pv36:36.3": "paṭiggahitāni ca tāni assu ",
  "pv36:36.4": "mamañca passetha saṃnaddhadussanti. ",
  "pv36:37.1": "kasmiṃ padese samaṇaṃ vasantaṃ ",
  "pv36:37.2": "gantvāna passemu mayaṃ idāni ",
  "pv36:37.3": "sa majja kaṅkhaṃ vicikicchitañca ",
  "pv36:37.4": "diṭṭhivisūkāni ko vinodaye ceti. ",
  "pv36:38.1": "eso nisinno kapinaccanāyaṃ ",
  "pv36:38.2": "parivārito devatāhi bahūhi ",
  "pv36:38.3": "dhammikathaṃ bhāsati saccanāmo ",
  "pv36:38.4": "sakasmi accherake appamattoti. ",
  "pv36:39.1": "tathāhaṃ kassāmi gantvā idāni ",
  "pv36:39.2": "acchādayissaṃ samaṇaṃ yugena ",
  "pv36:39.3": "paṭiggahitāni ca tāni passa ",
  "pv36:39.4": "tuvañca passemu saṃnaddhadussanti. ",
  "pv36:40.1": "mā akkhaṇe pabbajitaṃ upāgami ",
  "pv36:40.2": "sādhu vo licchavinesa dhammo ",
  "pv36:40.3": "tato ca kāle upasaṅkamitvā ",
  "pv36:40.4": "tattheva passāmi raho nisinnanti. ",
  "pv36:41.1": "tathā hi vatvā agamāsi tattha ",
  "pv36:41.2": "parivārito dāsagaṇena licchavi ",
  "pv36:41.3": "so taṃ nagaraṃ upasaṅkamitvā ",
  "pv36:41.4": "vāsupagañchittha sake nivesane. ",
  "pv36:42.1": "tato ca kāle gihikiccāni katvā ",
  "pv36:42.2": "nhātvā pivitvā ca khaṇaṃ labhitvā ",
  "pv36:42.3": "viceyya peḷato ca yugāni aṭṭha ",
  "pv36:42.4": "gāhāpayi dāsagaṇena licchavi. ",
  "pv36:43.1": "so taṃ padesaṃ upasaṅkamitvā ",
  "pv36:43.2": "taṃ addasa samaṇaṃ santacittaṃ ",
  "pv36:43.3": "paṭikkantaṃ gocarato nivattaṃ ",
  "pv36:43.4": "sītibhūtaṃ rukkhamūle nisinnaṃ. ",
  "pv36:44.1": "tamenaṃ avoca upasaṅkamitvā ",
  "pv36:44.2": "appābādhaṃ phāsuvihārañca pucchi ",
  "pv36:44.3": "vesāliyaṃ licchavi ahaṃ bhadante ",
  "pv36:44.4": "jānanti maṃ licchavi ambasakkharo. ",
  "pv36:45.1": "imāni me aṭṭha yugāni ",
  "pv36:45.2": "bhante paṭiggaṇha bhante dadāmi tuyhaṃ ",
  "pv36:45.3": "teneva atthena idhāgatosmi ",
  "pv36:45.4": "yathā ahaṃ attamano bhaveyyaṃ. ",
  "pv36:46.1": "dūratova samaṇabrāhmaṇā ca ",
  "pv36:46.2": "nivesanante parivajjayanti ",
  "pv36:46.3": "pattāni bhijjanti tava nivesane ",
  "pv36:46.4": "saṅghāṭiyo cāpi vidālayanti. ",
  "pv36:47.1": "athāpare pādakudārikāhi ",
  "pv36:47.2": "avaṃsirā samaṇā pāṭiyanti ",
  "pv36:47.3": "etādisaṃ pabbajitaṃ vihesaṃ ",
  "pv36:47.4": "tayā kataṃ samaṇā pāpuṇanti. ",
  "pv36:48.1": "tiṇena telaṃpi na tvaṃ adāsi ",
  "pv36:48.2": "mūḷhassa maggaṃpi na pāvadāsi ",
  "pv36:48.3": "andhassa daṇḍaṃ sayamādiyāsi ",
  "pv36:48.4": "etādiso kadariyo asaṃvuto. ",
  "pv36:48.5": "atha tvaṃ kena vaṇṇena kimeva disvā ",
  "pv36:48.6": "amhehi saha saṃvibhāgaṃ karosi. ",
  "pv36:49.1": "paccemi bhante yaṃ tvaṃ vadesi. ",
  "pv36:49.2": "vimosayi samaṇabrāhmaṇe ca. ",
  "pv36:49.3": "khiḍḍatthiko no ca paduṭṭhacitto ",
  "pv36:49.4": "etaṃpi me dukkaṭameva bhante ",
  "pv36:50.1": "khiḍḍāya kho pasavitvāna pāpaṃ ",
  "pv36:50.2": "vedeti dukkhaṃ appamattabhogī ",
  "pv36:50.3": "daharo yuvā nagganiyassa bhāgī ",
  "pv36:50.4": "kiṃsu tato dukkhatarassa hoti. ",
  "pv36:51.1": "taṃ disvā saṃvegamalamatthaṃ bhante ",
  "pv36:51.2": "tappaccayā vāpi dadāmi dānaṃ ",
  "pv36:51.3": "paṭiggaṇha bhante vatthayugāni aṭṭha ",
  "pv36:51.4": "yakkhassimāgacchantu dakkhiṇāyo. ",
  "pv36:52.1": "addhā hi dānaṃ bahudhā pasaṭṭhaṃ ",
  "pv36:52.2": "dadato ca te akkhayadhammamatthu ",
  "pv36:52.3": "paṭiggaṇhāmi te vatthayugāni aṭṭha ",
  "pv36:52.4": "yakkhassimāgacchantu dakkhiṇāyo. ",
  "pv36:53.1": "tato hi so ācamayitvā licchavi ",
  "pv36:53.2": "therassa datvāna yugāni aṭṭha ",
  "pv36:53.3": "paṭiggahitāni ca tāni vāssuṃ ",
  "pv36:53.4": "yakkhañca passetha saṃnaddhadussaṃ. ",
  "pv36:54.1": "tamaddasa candanasāralittaṃ ",
  "pv36:54.2": "ājaññamāruyha uḷāravaṇṇaṃ ",
  "pv36:54.3": "alaṅkataṃ sādhunivatthadussaṃ ",
  "pv36:54.4": "parivāritaṃ yakkhamahiddhipattaṃ. ",
  "pv36:55.1": "so taṃ disvā attamano udaggo ",
  "pv36:55.2": "pahaṭṭhacittova subhaggarūpo ",
  "pv36:55.3": "kammañca disvāna mahāvipākaṃ ",
  "pv36:55.4": "sandiṭṭhikaṃ cakkhunā sacchikatvā. ",
  "pv36:56.1": "tamenamavoca upasaṅkamitvā ",
  "pv36:56.2": "dassāmi dānaṃ samaṇabrāhmaṇānaṃ ",
  "pv36:56.3": "na cāpi me kiñci adeyyamatthi ",
  "pv36:56.4": "tuvañca me yakkha bahūpakāro. ",
  "pv36:57.1": "tuvañca me licchavi ekadesaṃ ",
  "pv36:57.2": "adāsi dānāni amoghametaṃ ",
  "pv36:57.3": "svāhaṃ karissāmi tayā va sakkhiṃ ",
  "pv36:57.4": "amānuso mānusakena saddhiṃ. ",
  "pv36:58.1": "gati ca bandhū ca parāyanañca ",
  "pv36:58.2": "mitto mamāsi atha devatāsi ",
  "pv36:58.3": "yācāmi taṃ pañjaliko bhavitvā ",
  "pv36:58.4": "icchāmi taṃ yakkha punāpi daṭṭhuṃ. ",
  "pv36:59.1": "sace tuvaṃ assaddho bhavissasi ",
  "pv36:59.2": "kadariyarūpo vippaṭipannacitto ",
  "pv36:59.3": "teneva maṃ licchavi dassanāya ",
  "pv36:59.4": "disvā ca taṃ nopi ca ālapissaṃ. ",
  "pv36:60.1": "sace tuvaṃ bhavissasi dhammagāravo ",
  "pv36:60.2": "dāne rato saṅgahitattabhāvo ",
  "pv36:60.3": "opānabhūto samaṇabrāhmaṇānaṃ ",
  "pv36:60.4": "evaṃ mamaṃ licchavi dassanāya. ",
  "pv36:61.1": "disvā ca taṃ ālapissaṃ bhadante ",
  "pv36:61.2": "imañca sūlato lahuṃ pamuñca ",
  "pv36:61.3": "yato nidānaṃ akarimha sakkhiṃ ",
  "pv36:61.4": "maññāmi sūlāvutakassa kāraṇā ",
  "pv36:62.1": "te aññamaññaṃ akarimha sakkhiṃ. ",
  "pv36:62.2": "ayañca sūlāvuto lahuṃ pamutto ",
  "pv36:62.3": "sakkacca dhammāni samācaranto ",
  "pv36:62.4": "muñceyya so nirayāva tamhā ",
  "pv36:62.5": "kammaṃ siyā aññatra savedanīyaṃ. ",
  "pv36:63.1": "kappitakañca upasaṅkamitvā ",
  "pv36:63.2": "tena saha saṃvibhajitvāna kāle ",
  "pv36:63.3": "sayaṃ mukhena upanisajja puccha ",
  "pv36:63.4": "so te akkhissati etamatthaṃ. ",
  "pv36:64.1": "tameva bhikkhuṃ upasaṅkamitvā ",
  "pv36:64.2": "pucchassu puññatthiko no ca paduṭṭhacitto ",
  "pv36:64.3": "so te sutaṃ asutañcāpi dhammaṃ ",
  "pv36:64.4": "sabbaṃpi akkhissati yathā pajānaṃ suto ca dhammaṃ sugatiṃ akkhissa. ",
  "pv36:65.1": "so tattha rahassaṃ samullapitvā ",
  "pv36:65.2": "sakkhiṃ karitvāna amānusena ",
  "pv36:65.3": "pakkāmi so licchavīnaṃ sakāsaṃ ",
  "pv36:65.4": "atha bravi parisaṃ sannisinnaṃ. ",
  "pv36:66.1": "suṇantu bhonto mama ekavākyaṃ ",
  "pv36:66.2": "varaṃ varissaṃ labhissāmi atthaṃ ",
  "pv36:66.3": "sūlāvuto puriso luddakammo ",
  "pv36:66.4": "paṇītadaṇḍo anusattarūpo. ",
  "pv36:67.1": "ettāvatā vīsatirattimattā ",
  "pv36:67.2": "yato āvuto neva jīvati na mato ",
  "pv36:67.3": "tāhaṃ mocayissāmi dāni ",
  "pv36:67.4": "yathā matiṃ anujānātu saṅgho. ",
  "pv36:68.1": "etañca aññañca lahuṃ pamuñca ",
  "pv36:68.2": "ko taṃ vadetha ca tathā karontaṃ ",
  "pv36:68.3": "yathā pajānāsi tathā karohi ",
  "pv36:68.4": "yathā matiṃ anujānāti saṅgho. ",
  "pv36:69.1": "so taṃ padesaṃ upasaṅkamitvā ",
  "pv36:69.2": "sūlāvutaṃ mocayi khippameva ",
  "pv36:69.3": "mā bhāyi sammāti ca taṃ avoca ",
  "pv36:69.4": "tikicchakānañca upaṭṭhapesi. ",
  "pv36:70.1": "kappitakañca upasaṅkamitvā ",
  "pv36:70.2": "tena saha saṃvibhajitvāna kāle ",
  "pv36:70.3": "sayaṃ mukheneva upanisajja licchavi ",
  "pv36:70.4": "tattheva pucchatthanaṃ kāraṇatthiko. ",
  "pv36:71.1": "sūlāvuto puriso luddakammo ",
  "pv36:71.2": "paṇītadaṇḍo anusattarūpo ",
  "pv36:71.3": "ettāvatā vīsatirattimattā ",
  "pv36:71.4": "yato āvuto neva jīvati na mato. ",
  "pv36:72.1": "so mocito gantvā mayā idāni ",
  "pv36:72.2": "etassa yakkhassa vacoti bhante ",
  "pv36:72.3": "siyā nu kho kāraṇaṃ kiñcideva ",
  "pv36:72.4": "yena so nirayaṃ no vajeyya. ",
  "pv36:73.1": "ācikkha bhante yadi atthi hetu ",
  "pv36:73.2": "saddhāyitaṃ hetu vacoti suṇoma ",
  "pv36:73.3": "na tesaṃ kammānaṃ vināsamatthi ",
  "pv36:73.4": "avedayitvā idha bayantibhāvo. ",
  "pv36:74.1": "sace so dhammāni samācareyya ",
  "pv36:74.2": "sakkaccaṃ rattindivaṃ appamatto ",
  "pv36:74.3": "muñceyya so nirayā ca tamhā ",
  "pv36:74.4": "kammaṃ siyā aññatra vedanīyaṃ. ",
  "pv36:75.1": "aññāto eso purisassa attho ",
  "pv36:75.2": "mamaṃpidāni anukampa bhante ",
  "pv36:75.3": "anusāsa maṃ ovada bhūripañña ",
  "pv36:75.4": "yathā ahaṃ no nirayaṃ vajeyyaṃ. ",
  "pv36:76.1": "ajjeva buddhaṃ saraṇaṃ upehi ",
  "pv36:76.2": "dhammañca saṅghañca pasannacitto ",
  "pv36:76.3": "tatheva sikkhāpadāni pañca ",
  "pv36:76.4": "akhaṇḍaphullāni samādiyassu. ",
  "pv36:77.1": "pāṇātipātā viramassu khippaṃ ",
  "pv36:77.2": "loke adinnaṃ parivajjayassu ",
  "pv36:77.3": "amajjapo mā ca musā abhāsi ",
  "pv36:77.4": "sakena dārena ca hohi tuṭṭho. ",
  "pv36:77.5": "imañca aṭṭhaṅgavaraṃ upetaṃ ",
  "pv36:77.6": "samādiyāhi kusalaṃ sukhindriyaṃ. ",
  "pv36:78.1": "cīvaraṃ piṇḍapātañca ",
  "pv36:78.2": "paccayaṃ sayanāsanaṃ ",
  "pv36:78.3": "annapānaṃ khādanīyaṃ ",
  "pv36:78.4": "vatthaṃ senāsanāni ca. ",
  "pv36:78.5": "dadāhi ujubhūtesu ",
  "pv36:78.6": "sadā puññaṃ pavaḍḍhati bhikkhū ",
  "pv36:79.1": "ca sīlasampanne ",
  "pv36:79.2": "vītarāge bahussute ",
  "pv36:79.3": "tappehi annapānena ",
  "pv36:79.4": "sadā puññaṃ pavaḍḍhati. ",
  "pv36:80.1": "evañca dhammāni samācaranto ",
  "pv36:80.2": "sakkaccaṃ rattindivaṃ appamatto ",
  "pv36:80.3": "muñceyya so nirayā ca tamhā ",
  "pv36:80.4": "kammaṃ siyā aññatra vedanīyaṃ. ",
  "pv36:81.1": "ajjeva buddhaṃ saraṇaṃ upemi ",
  "pv36:81.2": "dhammañca saṅghañca pasannacitto ",
  "pv36:81.3": "tatheva sikkhāpadāni pañca ",
  "pv36:81.4": "akhaṇḍaphullāni samādiyāmi. ",
  "pv36:82.1": "pāṇātipātā viramāmi khippaṃ ",
  "pv36:82.2": "loke adinnaṃ parivajjayāmi ",
  "pv36:82.3": "amajjapo no ca musā bhaṇāmi ",
  "pv36:82.4": "sakena dārena ca homi tuṭṭho. ",
  "pv36:82.5": "imañca ariyaṃ aṭṭhaṅgavaraṃ upetaṃ ",
  "pv36:82.6": "samādiyāmi kusalaṃ sukhindriyaṃ. ",
  "pv36:83.1": "cīvaraṃ piṇḍapātañca ",
  "pv36:83.2": "paccayaṃ sayanāsanaṃ ",
  "pv36:83.3": "annapānaṃ khādanīyaṃ ",
  "pv36:83.4": "vatthaṃ senāsanāni ca ",
  "pv36:84.1": "bhikkhū ca sīlasampanne ",
  "pv36:84.2": "vītarāge bahussute ",
  "pv36:84.3": "dadāmi na vikkappāmi ",
  "pv36:84.4": "buddhānaṃ sāsane rato. ",
  "pv36:85.1": "etādiso licchavi ambasakkharo ",
  "pv36:85.2": "vesāliyaṃ aññataro upāsako ",
  "pv36:85.3": "saddho mudu kārakaro ca bhikkhu ",
  "pv36:85.4": "saṅghañca sakkacca tadā upaṭṭhahi. ",
  "pv36:86.1": "sūlāvuto ca arogo hutvā ",
  "pv36:86.2": "serisukhī pabbajjaṃ upāgami ",
  "pv36:86.3": "āgamma kappitakuttamaṃ ",
  "pv36:86.4": "ubhopi sāmaññaphalāni ajjhaguṃ. ",
  "pv36:87.1": "etādisā sappurisānaṃ sevanā ",
  "pv36:87.2": "mahāphalā hoti sataṃ vijānataṃ ",
  "pv36:87.3": "sūlāvuto aggaphalaṃ phussati ",
  "pv36:87.4": "phalaṃ kaniṭṭhaṃ pana ambasakkharoti. ",
  "pv36:88.1": "ambasakkharapetavatthu paṭhamaṃ. "
}
