  "pv2:1.1": "2 kāyo te sabbaso vaṇṇo ",
  "pv2:1.2": "sabbā obhāsate disā ",
  "pv2:1.3": "mukhaṃ te sūkarasseva ",
  "pv2:1.4": "kiṃ kammamakarā pureti. ",
  "pv2:2.1": "kāyena saññato āsiṃ ",
  "pv2:2.2": "vācāyāsiṃ asaññato ",
  "pv2:2.3": "tena me tādiso vaṇṇo ",
  "pv2:2.4": "yathā passasi nārada ",
  "pv2:3.1": "tantyāhaṃ nārada brūmi ",
  "pv2:3.2": "sāmaṃ diṭṭhamidantayā ",
  "pv2:3.3": "mākāsi mukhasā pāpaṃ ",
  "pv2:3.4": "mā kho sūkaramukho ahūti. ",
  "pv2:4.1": "sūkarapetavatthu dutiyaṃ. "
}
