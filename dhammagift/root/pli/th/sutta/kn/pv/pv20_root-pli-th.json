  "pv20:1.1": "naggo kīso pabbajitosi bhante ",
  "pv20:1.2": "rattiṃ kuhiṃ gacchasi kissa hetu ",
  "pv20:1.3": "ācikkha me taṃ api sakkuṇemu ",
  "pv20:1.4": "sabbena vittaṃ paṭipādaye tuvanti. ",
  "pv20:2.1": "bārāṇasinagaraṃ dūraghuṭṭhaṃ ",
  "pv20:2.2": "tatthāhaṃ gahapati addhako ahu dinno ",
  "pv20:2.3": "adātā gathitmano āmisasmiṃ ",
  "pv20:2.4": "dussīlyena yamavisayamhi patto. ",
  "pv20:3.1": "so sūcikāya kilamito tehi ",
  "pv20:3.2": "teneva ñātīsu yāmi āmisakiñcihetu ",
  "pv20:3.3": "adānasīlā na ca saddahanti ",
  "pv20:3.4": "dānaṃ phalaṃ hoti paramhi loke. ",
  "pv20:4.1": "dhītā ca mayhaṃ lapate abhikkhaṇaṃ ",
  "pv20:4.2": "dassāmi dānaṃ pitunnaṃ pitāmahānaṃ ",
  "pv20:4.3": "upaṭṭhitaṃ parivisayanti brāhmaṇā ",
  "pv20:4.4": "yāmihaṃ andhakāvindaṃ bhuttuṃ. ",
  "pv20:5.1": "tamavoca rājā tavamanubhaviyāna tampi ",
  "pv20:5.2": "eyyāsi khippaṃ ahampi karissa pūjaṃ ",
  "pv20:5.3": "ācikkha me taṃ yadi atthi hetu ",
  "pv20:5.4": "saddhāyitaṃ hetuvaco suṇoma. ",
  "pv20:6.1": "tathāti vatvā agamāsi tattha ",
  "pv20:6.2": "bhuñjiṃsu bhattaṃ na padakkhiṇārahā pacchā ",
  "pv20:6.3": "gamī rājagahaṃ punāparaṃ ",
  "pv20:6.4": "pāturahosi purato janādhipassa. ",
  "pv20:7.1": "disvāna petaṃ punadeva āgataṃ ",
  "pv20:7.2": "rājā avoca ahaṃpi kiṃ dadāmi ",
  "pv20:7.3": "ācikkha me taṃ yadi atthi hetu ",
  "pv20:7.4": "yena tuvaṃ cirataraṃ pīṇito siyā. ",
  "pv20:8.1": "buddhañca saṅghaṃ parivisiyāna rāja ",
  "pv20:8.2": "annena pānenapi cīvarena ",
  "pv20:8.3": "taṃ dakkhiṇaṃ ādisa me hitāya ",
  "pv20:8.4": "evaṃ ahaṃ cirataraṃ pīṇito siyā. ",
  "pv20:9.1": "tato ca rājā nipatitvā tāvadeva ",
  "pv20:9.2": "dānaṃ sahatthā atulañca datvā saṅghe ",
  "pv20:9.3": "ca ārocayi pakatiṃ tathāgatassa ",
  "pv20:9.4": "petassa padakkhiṇaṃ ādisittha. ",
  "pv20:10.1": "so pūjito ativiya sobhamāno ",
  "pv20:10.2": "pāturahosi purato janādhipassa ",
  "pv20:10.3": "yakkhohamasmiṃ paramiddhipatto ",
  "pv20:10.4": "na mayhaṃ iddhisamasadisā manussā. ",
  "pv20:11.1": "passānubhāvaṃ aparimitaṃ mamayidaṃ ",
  "pv20:11.2": "tayānudiṭṭhaṃ atulaṃ daditvā saṅghe ",
  "pv20:11.3": "saṃtappito sasataṃ sadā bahūhi ",
  "pv20:11.4": "yāmi ahaṃ sukhito manussadevāti. ",
  "pv20:12.1": "cūḷaseṭṭhīpetavatthu aṭṭhamaṃ. 9 ",
  "pv20:12.2": ""
}
