{
  "kp9:0.1": "",
  "kp9:0.2": "khuddakapāṭhe karaṇīyamettasuttaṃ ",
  "kp9:1.1": "karaṇīyamatthakusalena ",
  "kp9:1.2": "yantaṃ santaṃ padaṃ abhisamecca ",
  "kp9:1.3": "sakko ujū ca suhujū ca ",
  "kp9:1.4": "suvaco cassa mudu anatimānī ",
  "kp9:2.1": "santussako ca subharo ca ",
  "kp9:2.2": "appakicco ca sallahukavutti ",
  "kp9:2.3": "santindriyo ca nipako ca ",
  "kp9:2.4": "appagabbho kulesu ananugiddho. ",
  "kp9:3.1": "na ca khuddaṃ samācare kiñci ",
  "kp9:3.2": "yena viññū pare upavadeyyuṃ. ",
  "kp9:3.3": "sukhino vā khemino hontu ",
  "kp9:3.4": "sabbe sattā bhavantu sukhitattā ",
  "kp9:4.1": "yekeci pāṇabhūtatthi ",
  "kp9:4.2": "tasā vā thāvarā vā anavasesā ",
  "kp9:4.3": "dīghā vā ye mahantā vā ",
  "kp9:4.4": "majjhimā rassakā aṇukathūlā ",
  "kp9:5.1": "diṭṭhā vā ye ca adiṭṭhā ",
  "kp9:5.2": "ye ca dūre vasanti avidūre ",
  "kp9:5.3": "bhūtā vā sambhavesī vā ",
  "kp9:5.4": "sabbe sattā bhavantu sukhitattā ",
  "kp9:6.1": "na paro paraṃ nikubbetha ",
  "kp9:6.2": "nātimaññetha katthaci naṃ kiñci ",
  "kp9:6.3": "byārosanā paṭīghasaññā ",
  "kp9:6.4": "nāññamaññassa dukkhamiccheyya. ",
  "kp9:7.1": "mātā yathā niyaṃ puttaṃ ",
  "kp9:7.2": "āyusā ekaputtamanurakkhe ",
  "kp9:7.3": "evampi sabbabhūtesu ",
  "kp9:7.4": "mānasambhāvaye aparimāṇaṃ ",
  "kp9:8.1": "mettañca sabbalokasmiṃ ",
  "kp9:8.2": "mānasambhāvaye aparimāṇaṃ ",
  "kp9:8.3": "uddhaṃ adho ca tiriyañca ",
  "kp9:8.4": "asambādhaṃ averaṃ ",
  "kp9:9.1": "asapattaṃ tiṭṭhañcaraṃ nisinno vā ",
  "kp9:9.2": "sayāno vā yāva tassa vigatamiddho ",
  "kp9:9.3": "etaṃ satiṃ adhiṭṭheyya ",
  "kp9:9.4": "brahmametaṃ vihāraṃ idamāhu. ",
  "kp9:10.1": "diṭṭhiñca anupagamma ",
  "kp9:10.2": "sīlavā dassanena sampanno ",
  "kp9:10.3": "kāmesu vineyya gedhaṃ ",
  "kp9:10.4": "na hi jātu gabbhaseyyaṃ punaretīti. ",
  "kp9:11.1": "mettasuttaṃ ",
  "kp9:12.1": "niṭṭhitaṃ. khuddakapāṭho samatto. "
}
