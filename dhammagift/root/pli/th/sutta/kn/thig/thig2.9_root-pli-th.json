  "thig2.9:0.3": "",
  "thig2.9:1.1": "abhaye bhiduro kāyo ",
  "thig2.9:1.2": "yattha sattā puthujjanā ",
  "thig2.9:1.3": "nikkhipissāmimaṃ dehaṃ ",
  "thig2.9:1.4": "sampajānā paṭīsatā. ",
  "thig2.9:2.1": "bahūhi dukkhadhammehi ",
  "thig2.9:2.2": "appamādaratāya me ",
  "thig2.9:2.3": "taṇhakkhayo anuppatto ",
  "thig2.9:2.4": "kataṃ buddhassa sāsanaṃ. ",
  "thig2.9:3.1": "abhayattherī. 10 "
}
