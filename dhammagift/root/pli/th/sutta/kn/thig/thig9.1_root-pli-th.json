  "thig9.1:0.1": "",
  "thig9.1:0.2": "",
  "thig9.1:0.3": "",
  "thig9.1:1.1": "mā su te vaḍḍhalokamhi ",
  "thig9.1:1.2": "vanatho ahu kudācanaṃ ",
  "thig9.1:1.3": "mā puttaka punappunaṃ ",
  "thig9.1:1.4": "ahu dukkhassa bhāgimā. ",
  "thig9.1:2.1": "sukhaṃ hi vaḍḍha munayo ",
  "thig9.1:2.2": "anejā chinnasaṃsayā ",
  "thig9.1:2.3": "sītibhūtā damappattā ",
  "thig9.1:2.4": "viharanti anāsavā. ",
  "thig9.1:3.1": "tehānuciṇṇaṃ isībhi ",
  "thig9.1:3.2": "maggaṃ dassanapattiyā ",
  "thig9.1:3.3": "dukkhassantakiriyāya ",
  "thig9.1:3.4": "tvaṃ vaḍḍha anubrūhaya. ",
  "thig9.1:4.1": "visāradāva bhaṇasi ",
  "thig9.1:4.2": "etamatthaṃ janetti me ",
  "thig9.1:4.3": "maññāmi nūna māmike ",
  "thig9.1:4.4": "vanatho te na vijjati. ",
  "thig9.1:5.1": "ye keci vaḍḍha saṅkhārā ",
  "thig9.1:5.2": "hīnaukkaṭṭhamajjhimā ",
  "thig9.1:5.3": "aṇupi aṇumattopi ",
  "thig9.1:5.4": "vanatho me na vijjati. ",
  "thig9.1:6.1": "sabbe me āsavā khīṇā ",
  "thig9.1:6.2": "appamattassa jhāyato ",
  "thig9.1:6.3": "tisso vijjā anuppattā ",
  "thig9.1:6.4": "kataṃ buddhassa sāsanaṃ. ",
  "thig9.1:7.1": "uḷāraṃ vata me mātā ",
  "thig9.1:7.2": "patodaṃ samavassari ",
  "thig9.1:7.3": "paramatthasañhitā gāthā ",
  "thig9.1:7.4": "yathāpi anukampikā. ",
  "thig9.1:8.1": "tassāhaṃ vacanaṃ sutvā ",
  "thig9.1:8.2": "anusiṭṭhiṃ janettiyā ",
  "thig9.1:8.3": "dhammasaṃvegamāpādiṃ ",
  "thig9.1:8.4": "yogakkhemassa pattiyā. ",
  "thig9.1:9.1": "sohaṃ padhānapahitatto ",
  "thig9.1:9.2": "rattindivamatandito ",
  "thig9.1:9.3": "mātarā codito santo ",
  "thig9.1:9.4": "aphusiṃ santimuttamaṃ. ",
  "thig9.1:10.1": "vaḍḍhamātā. ",
  "thig9.1:11.1": "navakanipāto samatto. therīgāthāya ekādasakanipāto 1 "
}
