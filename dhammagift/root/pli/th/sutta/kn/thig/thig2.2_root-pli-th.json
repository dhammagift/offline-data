  "thig2.2:0.3": "",
  "thig2.2:1.1": "2 ye ime satta bojjhaṅgā ",
  "thig2.2:1.2": "maggā nibbānapattiyā ",
  "thig2.2:1.3": "bhāvitā te mayā sabbe ",
  "thig2.2:1.4": "yathā buddhena desitā. ",
  "thig2.2:2.1": "diṭṭho hi me so bhagavā ",
  "thig2.2:2.2": "antimoyaṃ samussayo ",
  "thig2.2:2.3": "vikkhīṇo jātisaṃsāro ",
  "thig2.2:2.4": "natthidāni ",
  "thig2.2:3.1": "punabbhavo. jantā. "
}
