{
  "thig15.1:0.1": "therīgāthāya cattāḷīsanipāto ",
  "thig15.1:0.2": "",
  "thig15.1:0.3": "",
  "thig15.1:1.1": "1 nagaramhi kusumanāme ",
  "thig15.1:1.2": "pāṭaliputtamhi paṭhaviyā maṇḍe ",
  "thig15.1:1.3": "sakyakulakulīnāyo ",
  "thig15.1:1.4": "dve bhikkhuniyo guṇavatiyo. ",
  "thig15.1:2.1": "isidāsī tattha ekā ",
  "thig15.1:2.2": "dutiyā bodhīti sīlasampannā ca ",
  "thig15.1:2.3": "jhānajjhāyanaratāyo ",
  "thig15.1:2.4": "bahussutāyo dhutakilesāyo. ",
  "thig15.1:3.1": "tā piṇḍāya caritvāna ",
  "thig15.1:3.2": "bhattatthaṃ kariya dhotāpattāyo ",
  "thig15.1:3.3": "rahitamhi sukhanisinnā ",
  "thig15.1:3.4": "imā girā abbhavadesuṃ. ",
  "thig15.1:4.1": "pāsādikāsi ayye ",
  "thig15.1:4.2": "isidāsi vayopi te aparihīno ",
  "thig15.1:4.3": "kiṃ disvāna valikaṃ ",
  "thig15.1:4.4": "athāsi nekkhammamanuyuttā. ",
  "thig15.1:5.1": "evamanuyuñjamānā sā ",
  "thig15.1:5.2": "rahite dhammadesanākusalā ",
  "thig15.1:5.3": "isidāsī idaṃ vacanamābravi ",
  "thig15.1:5.4": "suṇa bodhi yathāmhi pabbajitā. ",
  "thig15.1:6.1": "ito paraṃ visajjanakathā ujjeniyā puravare ",
  "thig15.1:6.2": "mayhaṃ pitā sīlasaṃvuto seṭṭhī ",
  "thig15.1:6.3": "tassamhi ekā dhītā ",
  "thig15.1:6.4": "piyā manāpā dayitā ca. ",
  "thig15.1:7.1": "atha me sāketato varako āgacchi ",
  "thig15.1:7.2": "uttamakulīno ",
  "thig15.1:7.3": "seṭṭhī bahutaratano ",
  "thig15.1:7.4": "tassa maṃ suṇhaṃ adāsi tāto. ",
  "thig15.1:8.1": "sassuyā sassurassa ca ",
  "thig15.1:8.2": "sāyaṃ pātaṃ paṇāmamupagamma ",
  "thig15.1:8.3": "sirasā karomi pāde ",
  "thig15.1:8.4": "vandāmi yathāmhi anusiṭṭhā. ",
  "thig15.1:9.1": "yā mayhaṃ sāmikassa ",
  "thig15.1:9.2": "bhaginiyo bhātuno parijano vā ",
  "thig15.1:9.3": "taṃ ekavārakaṃpi disvā ",
  "thig15.1:9.4": "ubbiggā āsanaṃ demi. ",
  "thig15.1:10.1": "annena pānena ca ",
  "thig15.1:10.2": "khajjena ca yañca tattha sannihitaṃ ",
  "thig15.1:10.3": "chādemi upanayāmi ca ",
  "thig15.1:10.4": "demi ca yaṃ yassa paṭirūpaṃ. ",
  "thig15.1:11.1": "kālena uṭṭhahitvā ",
  "thig15.1:11.2": "patigharaṃ samupagamiṃ ",
  "thig15.1:11.3": "ummāradhotahatthapādā ",
  "thig15.1:11.4": "pañjalikā sāmikamupemihaṃ. ",
  "thig15.1:12.1": "kocchaṃ pāsādaṃ añjanañca ",
  "thig15.1:12.2": "ādāsakañca gaṇhitvā ",
  "thig15.1:12.3": "parikammakārikā viya ",
  "thig15.1:12.4": "sayameva patiṃ vibhūsemi. ",
  "thig15.1:13.1": "sayameva odanaṃ sādhayāmi ",
  "thig15.1:13.2": "sayameva bhājanaṃ dhoviṃ ",
  "thig15.1:13.3": "mātāva ekaputtakaṃ ",
  "thig15.1:13.4": "tathā bhattāraṃ paricarāmi. ",
  "thig15.1:14.1": "evaṃ maṃ bhattikataṃ ",
  "thig15.1:14.2": "anuttaraṃ kārikaṃ taṃ nihatamānaṃ ",
  "thig15.1:14.3": "uṭṭhāyikaṃ analasaṃ ",
  "thig15.1:14.4": "silavatiṃ dussate bhattā. ",
  "thig15.1:15.1": "so mātarañca pitarañca ",
  "thig15.1:15.2": "bhaṇati āpucchāhaṃ gamissāmi ",
  "thig15.1:15.3": "isidāsiyā na saha vacchaṃ ",
  "thig15.1:15.4": "ekāgārehaṃ sahavatthuṃ. ",
  "thig15.1:16.1": "mā evaṃ putta avaca ",
  "thig15.1:16.2": "isidāsī paṇḍitā paribyattā ",
  "thig15.1:16.3": "uṭṭhāyikā analasā ",
  "thig15.1:16.4": "kiṃ tuyhaṃ na rocate putta. ",
  "thig15.1:17.1": "na ca me hiṃsati kiñci ",
  "thig15.1:17.2": "na cāhaṃ isidāsiyā saha vacchaṃ ",
  "thig15.1:17.3": "dessāva me alaṃ me ",
  "thig15.1:17.4": "āpucchāhaṃ gamissāmi. ",
  "thig15.1:18.1": "tassa vacanaṃ suṇitvā ",
  "thig15.1:18.2": "sassū sassuro ca maṃ apucchiṃsu ",
  "thig15.1:18.3": "kissa tayā aparaddhaṃ ",
  "thig15.1:18.4": "bhaṇa kataṃ vissaṭṭhā yathābhūtaṃ. ",
  "thig15.1:19.1": "napihaṃ aparajjhaṃ kiñci ",
  "thig15.1:19.2": "napi hiṃseva na gaṇāmi dubbacanaṃ ",
  "thig15.1:19.3": "kiṃ sakkā kātuye ",
  "thig15.1:19.4": "yaṃ maṃ videssate bhattā. ",
  "thig15.1:20.1": "te maṃ pitu gharaṃ paṭi- nayiṃsu ",
  "thig15.1:20.2": "vimanā dukkhena avibhūtā ",
  "thig15.1:20.3": "puttamanurakkhamānā ",
  "thig15.1:20.4": "jināmhase rūpiniṃ lacchiṃ. ",
  "thig15.1:21.1": "atha maṃ adāsi tāto ",
  "thig15.1:21.2": "aḍḍhassa gharamhi dutiyakulikassa ",
  "thig15.1:21.3": "tato upaḍḍhasuṅkena ",
  "thig15.1:21.4": "yena maṃ vindatha seṭṭhi. ",
  "thig15.1:22.1": "tassapi gharamhi māsaṃ ",
  "thig15.1:22.2": "avasiṃ atha sopi maṃ paṭicchati ",
  "thig15.1:22.3": "dāsīva upaṭṭhahantiṃ ",
  "thig15.1:22.4": "adūsikaṃ sīlasampannaṃ. ",
  "thig15.1:23.1": "bhikkhāya ca vicarantaṃ ",
  "thig15.1:23.2": "damakaṃ dantaṃ me pitā bhaṇati ",
  "thig15.1:23.3": "so hisi me jāmātā ",
  "thig15.1:23.4": "nikkhipa pontiñca ghaṭikañca. ",
  "thig15.1:24.1": "sopi vasitvā pakkhaṃ ",
  "thig15.1:24.2": "atha tātaṃ bhaṇati dehi me pontiṃ ",
  "thig15.1:24.3": "ghaṭikañca kapallakañca ",
  "thig15.1:24.4": "punapi bhikkhaṃ carissāmi. ",
  "thig15.1:25.1": "atha naṃ bhaṇati tāto ",
  "thig15.1:25.2": "ammā sabbo ca me ñātigaṇavaggo ",
  "thig15.1:25.3": "kinte na karati idha ",
  "thig15.1:25.4": "bhaṇa khippaṃ yante karihiti. ",
  "thig15.1:26.1": "evaṃ bhaṇito bhaṇati ",
  "thig15.1:26.2": "yadi me attā sakkoti alaṃ mayhaṃ ",
  "thig15.1:26.3": "isidāsiyā na vacchaṃ ",
  "thig15.1:26.4": "ekagharehaṃ sahavatthuṃ. ",
  "thig15.1:27.1": "vissajjito gato so ",
  "thig15.1:27.2": "ahaṃpi ekākinī vicintemi ",
  "thig15.1:27.3": "āpucchitvāna gacchāmi ",
  "thig15.1:27.4": "marituṃ vā pabbajituṃ. ",
  "thig15.1:28.1": "atha ayyā jinadattā ",
  "thig15.1:28.2": "āgacchi gocarāya caramānā ",
  "thig15.1:28.3": "tāta kulaṃ vinayadharī ",
  "thig15.1:28.4": "bahussutā sīlasampannā. ",
  "thig15.1:29.1": "taṃ disvāna amhākaṃ ",
  "thig15.1:29.2": "uṭṭhāyāsanaṃ tassā paññāpayiṃ ",
  "thig15.1:29.3": "nisinnāya ca pāde ",
  "thig15.1:29.4": "vanditvā bhojanamadāsiṃ. ",
  "thig15.1:30.1": "annapānena ",
  "thig15.1:30.2": "khajjena ca yañca tattha sannihitaṃ ",
  "thig15.1:30.3": "santappayitvāna avacaṃ ",
  "thig15.1:30.4": "ayye icchāmi pabbajituṃ. ",
  "thig15.1:31.1": "atha maṃ bhaṇati tāto ",
  "thig15.1:31.2": "idheva puttike carāhi taṃ dhammaṃ ",
  "thig15.1:31.3": "annena ca pānena ca ",
  "thig15.1:31.4": "santappaya samaṇe dvijātī ca. ",
  "thig15.1:32.1": "athāhaṃ bhaṇāmi tātaṃ ",
  "thig15.1:32.2": "rodantī añjaliṃ paṇāmetvā ",
  "thig15.1:32.3": "anujānāhi maṃ tāta mayā pakataṃ ",
  "thig15.1:32.4": "kammaṃ taṃ nijjaressāmi. ",
  "thig15.1:33.1": "atha maṃ bhaṇati tāto ",
  "thig15.1:33.2": "pāpuṇa bodhiñca aggadhammañca ",
  "thig15.1:33.3": "nibbānañca labhassu ",
  "thig15.1:33.4": "yaṃ sacchikari dvipadaseṭṭho. ",
  "thig15.1:34.1": "mātāpitū abhivādayitvā ",
  "thig15.1:34.2": "sabbañca ñātigaṇavaggaṃ ",
  "thig15.1:34.3": "sattāhaṃ pabbajitā ",
  "thig15.1:34.4": "tisso vijjā aphussayiṃ. ",
  "thig15.1:35.1": "jānāmi attano satta ",
  "thig15.1:35.2": "jātiyo yassā yaṃ phalaṃ vipāko ",
  "thig15.1:35.3": "taṃ tava ācikkhissaṃ ",
  "thig15.1:35.4": "taṃ ekamanā nisāmehi ",
  "thig15.1:36.1": "nagaramhi erakakacche ",
  "thig15.1:36.2": "suvaṇṇakāro ahaṃ pahutadhano ",
  "thig15.1:36.3": "yobbanamadena matto ",
  "thig15.1:36.4": "so paradāraṃ āsevihaṃ. ",
  "thig15.1:37.1": "sohaṃ tato cavitvā ",
  "thig15.1:37.2": "nirayamhi apaccisaṃ ciraṃ ",
  "thig15.1:37.3": "pakko tato ca uṭṭhahitvā ",
  "thig15.1:37.4": "makkaṭiyā kucchimokkamiṃ. ",
  "thig15.1:38.1": "sattāhaṃ jātakammaṃ ",
  "thig15.1:38.2": "mahākapi yūthapo nillacchesi ",
  "thig15.1:38.3": "tassetaṃ kammaphalaṃ ",
  "thig15.1:38.4": "yathāpi gantvāna paradāraṃ. ",
  "thig15.1:39.1": "sohaṃ tato cavitvā ",
  "thig15.1:39.2": "kālaṃ karitvā sindhavāraññe ",
  "thig15.1:39.3": "kāṇāya ca khañjāya ca ",
  "thig15.1:39.4": "eḷakiyā kucchimokkamiṃ. ",
  "thig15.1:40.1": "dvādasavassāni ahaṃ ",
  "thig15.1:40.2": "nillacchito dārake parivahitvā ",
  "thig15.1:40.3": "kiminā vaṭṭo akallo ",
  "thig15.1:40.4": "yathāpi gantvāna paradāraṃ. ",
  "thig15.1:41.1": "sohaṃ tato cavitvā ",
  "thig15.1:41.2": "govāṇijakassa gāviyā jāto ",
  "thig15.1:41.3": "vaccho lākhātambo ",
  "thig15.1:41.4": "nillacchito dvādase māse. ",
  "thig15.1:42.1": "te puna naṅgalamahaṃ ",
  "thig15.1:42.2": "sakaṭaṃ ca dhārayāmi ",
  "thig15.1:42.3": "andho vaṭṭo akallo ",
  "thig15.1:42.4": "yathāpi gantvāna paradāraṃ. ",
  "thig15.1:43.1": "sohaṃ tato cavitvā ",
  "thig15.1:43.2": "vīthiyā dāsiṃyā ghare jāto ",
  "thig15.1:43.3": "neva mahilā na puriso ",
  "thig15.1:43.4": "yathāpi gantvāna paradāraṃ. ",
  "thig15.1:44.1": "tiṃsativassamhi mato ",
  "thig15.1:44.2": "sākaṭikakulamhi dārikā jātā ",
  "thig15.1:44.3": "kapaṇamhi appabhoge ",
  "thig15.1:44.4": "dhanikapurisapātabahulamhi. ",
  "thig15.1:45.1": "taṃ maṃ tato satthavāho ",
  "thig15.1:45.2": "ussannāya vipulāya vaḍḍhiyā ",
  "thig15.1:45.3": "okaḍḍhati vilapantiṃ ",
  "thig15.1:45.4": "acchinditvā kulagharassa. ",
  "thig15.1:46.1": "atha soḷasame vasse ",
  "thig15.1:46.2": "disvāna maṃ pattayobbanaṃ kaññaṃ ",
  "thig15.1:46.3": "oruddha tassa putto ",
  "thig15.1:46.4": "giridāso nāma nāmena. ",
  "thig15.1:47.1": "tassapi aññā bhariyā ",
  "thig15.1:47.2": "sīlavatī guṇavatī yasavatī ca ",
  "thig15.1:47.3": "anurattā bhattāraṃ ",
  "thig15.1:47.4": "tassāhaṃ viddesanamakāsiṃ. ",
  "thig15.1:48.1": "tassetaṃ kammaphalaṃ ",
  "thig15.1:48.2": "yaṃ maṃ apakiritūna gacchanti ",
  "thig15.1:48.3": "dāsīva upaṭṭhahantiṃ ",
  "thig15.1:48.4": "tassapi anto kato mayāti. ",
  "thig15.1:49.1": "isidāsī. ",
  "thig15.1:50.1": "cattāḷīsanipāto samatto. "
}
