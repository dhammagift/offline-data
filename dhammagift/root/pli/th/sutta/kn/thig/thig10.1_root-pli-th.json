{
  "thig10.1:0.1": "",
  "thig10.1:0.2": "",
  "thig10.1:0.3": "",
  "thig10.1:1.1": "kalyāṇamittatā muninā ",
  "thig10.1:1.2": "lokaṃ ādissa vaṇṇitā ",
  "thig10.1:1.3": "kalyāṇamitte bhajamāno ",
  "thig10.1:1.4": "api bālo paṇḍito assa. ",
  "thig10.1:2.1": "bhajitabbā sappurisā ",
  "thig10.1:2.2": "paññā tathāpi vaḍḍhati bhajantānaṃ ",
  "thig10.1:2.3": "bhajamāno yo koci khattiyādiko sappurise ",
  "thig10.1:2.4": "sabbehipi dukkhehi ceva mocaye ",
  "thig10.1:3.1": "dukkhañceva vijāneyya ",
  "thig10.1:3.2": "dukkhassa ca samudayaṃ nirodhaṭṭhaṅgikamaggaṃ ",
  "thig10.1:3.3": "cattāri ",
  "thig10.1:3.4": "ariyasaccāni ca. ",
  "thig10.1:4.1": "dukkho itthibhāvo ",
  "thig10.1:4.2": "akkhāto purisadammasārathinā. ",
  "thig10.1:4.3": "sapattikampi hi dukkhaṃ ",
  "thig10.1:4.4": "appekaccā sakiṃ vijātāyo ",
  "thig10.1:5.1": "galake apakantanti sukhumāliyo ",
  "thig10.1:5.2": "visāni khādanti ",
  "thig10.1:5.3": "janamārakamajjhagatā ",
  "thig10.1:5.4": "dve byasanānubhontipi. ",
  "thig10.1:6.1": "upavijaññā gacchantī ",
  "thig10.1:6.2": "addasāhaṃ patiṃ mataṃ ",
  "thig10.1:6.3": "panthe vijāyitvāna ",
  "thig10.1:6.4": "appattāhaṃ sakaṃ gehaṃ. ",
  "thig10.1:7.1": "dve puttā kālakatā ",
  "thig10.1:7.2": "pati ca panthe mato kapaṇikāya ",
  "thig10.1:7.3": "mātā pitā ca bhātā ca ",
  "thig10.1:7.4": "ḍayhanti ekacitakāyaṃ. ",
  "thig10.1:8.1": "khīṇakulamhi kapaṇe ",
  "thig10.1:8.2": "anubhūtaṃ te dukkhaṃ aparimāṇaṃ ",
  "thig10.1:8.3": "assu ca te pavattaṃ hi ",
  "thig10.1:8.4": "bahūni jātisahassāni. ",
  "thig10.1:9.1": "passiṃ taṃ susānamajjhe ",
  "thig10.1:9.2": "athopi khāditāni puttamaṃsāni ",
  "thig10.1:9.3": "hatakulikā sabbagarahitā ",
  "thig10.1:9.4": "matapatikā amataṃ adhigacchiṃ. ",
  "thig10.1:10.1": "bhāvito me ayaṃ maggo ",
  "thig10.1:10.2": "ariyoṭṭhaṅgiko amatagāmī ",
  "thig10.1:10.3": "nibbānaṃpi sacchikataṃ ",
  "thig10.1:10.4": "dhammādāsaṃ avekkhihaṃ. ",
  "thig10.1:11.1": "ahamhi kantasallā ",
  "thig10.1:11.2": "ohitabhārā kataṃ me karaṇīyaṃ ",
  "thig10.1:11.3": "kīsāgotamī therī ",
  "thig10.1:11.4": "suvimuttacittā imaṃ bhaṇīti. ",
  "thig10.1:12.1": "kīsāgotamī. ",
  "thig10.1:13.1": "ekādasakanipāto samatto. therīgāthāya dvādasakanipāto 1 "
}
