  "thig3.5:1.1": "amma jīvāhi vanamhi kandasi ",
  "thig3.5:1.2": "attānaṃ adhigaccha ubbiri ",
  "thig3.5:1.3": "cūḷāsītisahassāni ",
  "thig3.5:1.4": "sabbā jīvasanāmikā ",
  "thig3.5:1.5": "etamhāḷāhane daḍḍhā ",
  "thig3.5:1.6": "tāsaṃ kamanusocasi. ",
  "thig3.5:2.1": "abbuhi vata me sallaṃ ",
  "thig3.5:2.2": "duddasaṃ hadayanissitaṃ ",
  "thig3.5:2.3": "yaṃ me sokaparetāya ",
  "thig3.5:2.4": "dhītu sokaṃ byapānudi. ",
  "thig3.5:3.1": "sājja abbūḷhasallāhaṃ ",
  "thig3.5:3.2": "nicchātā parinibbutā ",
  "thig3.5:3.3": "buddhaṃ dhammañca saṅghañca ",
  "thig3.5:3.4": "upemi saraṇaṃ muniṃ. ",
  "thig3.5:4.1": "ubbiri. 6 kiṃ me "
}
