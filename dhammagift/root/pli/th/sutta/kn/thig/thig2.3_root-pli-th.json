  "thig2.3:1.1": "sumuttikā ",
  "thig2.3:1.2": "sādhu muttikamhi musalassa ",
  "thig2.3:1.3": "ahiriko me chattakaṃ vāpi ",
  "thig2.3:1.4": "ukkhalikā me daliddabhāvāti. ",
  "thig2.3:2.1": "rāgañca ahaṃ dosañca ",
  "thig2.3:2.2": "vicchindantī viharāmi ",
  "thig2.3:2.3": "sā rukkhamūlamupagamma ",
  "thig2.3:2.4": "aho sukhanti sukhato jhāyāmi. aññatarā ",
  "thig2.3:3.1": "therībhikkhunī apaññātā. 4 "
}
