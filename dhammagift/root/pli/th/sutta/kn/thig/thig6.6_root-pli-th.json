{
  "thig6.6:0.1": "",
  "thig6.6:0.2": "",
  "thig6.6:0.3": "",
  "thig6.6:1.1": "buddha vīra namo tayatthu ",
  "thig6.6:1.2": "sabbasattānamuttama ",
  "thig6.6:1.3": "yo maṃ dukkhā pamocesi ",
  "thig6.6:1.4": "aññañca bahukaṃ janaṃ. ",
  "thig6.6:2.1": "sabbadukkhaṃ pariññātaṃ ",
  "thig6.6:2.2": "hetutaṇhā visositā ",
  "thig6.6:2.3": "bhāvitaṭṭhaṅgiko maggo ",
  "thig6.6:2.4": "nirodho phusito mayā. ",
  "thig6.6:3.1": "mātā putto pitā bhātā ",
  "thig6.6:3.2": "ayyikā ca pure ahuṃ ",
  "thig6.6:3.3": "yathābhuccaṃ ajānantī ",
  "thig6.6:3.4": "saṃsarihaṃ anibbisaṃ. ",
  "thig6.6:4.1": "diṭṭho hi me so bhagavā ",
  "thig6.6:4.2": "antimoyaṃ samussayo ",
  "thig6.6:4.3": "vikkhīṇo jātisaṃsāro ",
  "thig6.6:4.4": "natthi dāni punabbhavo. ",
  "thig6.6:5.1": "āraddhaviriye pahitatte ",
  "thig6.6:5.2": "niccaṃ daḷhaparakkame ",
  "thig6.6:5.3": "samagge sāvake passa ",
  "thig6.6:5.4": "esā buddhāna vandanā. ",
  "thig6.6:6.1": "bahūnaṃ vata atthāya ",
  "thig6.6:6.2": "māyā janayi gotamaṃ ",
  "thig6.6:6.3": "byādhimaraṇatunnānaṃ ",
  "thig6.6:6.4": "dukkhakkhandhaṃ byapānudi. ",
  "thig6.6:7.1": "mahāpajāpatī gotamī. 7 "
}
