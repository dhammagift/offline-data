{
  "bv6:0.1": "",
  "bv6:0.2": "catuttho sumanabuddhavaṃso ",
  "bv6:1.1": "maṅgalassa aparena ",
  "bv6:1.2": "sumano nāma nāyako ",
  "bv6:1.3": "sabbadhammehi asamo ",
  "bv6:1.4": "sabbasattānamuttamo. ",
  "bv6:2.1": "tadā amatabheriyo ",
  "bv6:2.2": "āhani mekhale pure ",
  "bv6:2.3": "dhamma saṅkha samāyuttaṃ ",
  "bv6:2.4": "navaṅga jinasāsanaṃ. ",
  "bv6:3.1": "vijinitvā 4 kilese so ",
  "bv6:3.2": "patto sambodhimuttamaṃ ",
  "bv6:3.3": "māpesi nagaraṃ satthā ",
  "bv6:3.4": "saddhammapuravaruttamaṃ. ",
  "bv6:4.1": "nirantaraṃ akuṭilaṃ ",
  "bv6:4.2": "ujuṃ vipula vitthataṃ ",
  "bv6:4.3": "māpesi so mahāvīthiṃ ",
  "bv6:4.4": "satipaṭṭhāna varuttamaṃ. ",
  "bv6:5.1": "phale cattāri sāmaññe ",
  "bv6:5.2": "catasso paṭisambhidā ",
  "bv6:5.3": "chaḷabhiññāṭṭhasamāpattī ",
  "bv6:5.4": "pasāresi tattha vīthiyaṃ. ",
  "bv6:6.1": "ye appamattā akhilā ",
  "bv6:6.2": "hiri viriyehupāgatā ",
  "bv6:6.3": "te te ime guṇavare ",
  "bv6:6.4": "ādiyanti yathā sukhaṃ. ",
  "bv6:7.1": "evameva tena yogena ",
  "bv6:7.2": "uddharanto mahājanaṃ ",
  "bv6:7.3": "bodhesi paṭhamaṃ satthā ",
  "bv6:7.4": "koṭi satasahassiyo. ",
  "bv6:8.1": "yamhi kāle mahāvīro ",
  "bv6:8.2": "ovadi titthiye gaṇe ",
  "bv6:8.3": "koṭi satasahassāni ",
  "bv6:8.4": "dutiye dhammadesane. ",
  "bv6:9.1": "yadā devā manussā ca ",
  "bv6:9.2": "samaggā ekamānasā ",
  "bv6:9.3": "nirodhapañhaṃ pucchiṃsu ",
  "bv6:9.4": "saṃsayañcāpi mānasaṃ. ",
  "bv6:10.1": "tadāpi dhammadesane ",
  "bv6:10.2": "nirodhaparidīpane ",
  "bv6:10.3": "navuti koṭisahassānaṃ ",
  "bv6:10.4": "tatiyābhisamayo ahu. ",
  "bv6:11.1": "sannipātā tayo āsuṃ ",
  "bv6:11.2": "sumanassa mahesino ",
  "bv6:11.3": "khīṇāsavānaṃ vimalānaṃ ",
  "bv6:11.4": "santicittāna tādinaṃ. ",
  "bv6:12.1": "vassaṃ vuṭṭhassa bhagavato ",
  "bv6:12.2": "abhisaṅghuṭṭhe pavāraṇe ",
  "bv6:12.3": "koṭi satasahassehi ",
  "bv6:12.4": "pavāresi tathāgato. ",
  "bv6:13.1": "tato paraṃ sannipāte ",
  "bv6:13.2": "vimale kañcanapabbate ",
  "bv6:13.3": "navuti koṭisahassānaṃ ",
  "bv6:13.4": "dutiyo āsi samāgamo. ",
  "bv6:14.1": "yadā sakko devarājā ",
  "bv6:14.2": "buddhadassanamupāgami ",
  "bv6:14.3": "asīti koṭisahassānaṃ ",
  "bv6:14.4": "tatiyo āsi samāgamo. ",
  "bv6:15.1": "ahaṃ tena samayena ",
  "bv6:15.2": "nāgarājā mahiddhiko ",
  "bv6:15.3": "atulo nāma nāmena ",
  "bv6:15.4": "uppannakusalasañcayo. ",
  "bv6:16.1": "tadāhaṃ nāgabhavanā ",
  "bv6:16.2": "nikkhamitvā sañātibhi ",
  "bv6:16.3": "nāgānaṃ dibba turiyehi ",
  "bv6:16.4": "sasaṅghaṃ jinamupaṭṭhahiṃ. ",
  "bv6:17.1": "koṭi satasahassāni ",
  "bv6:17.2": "anna pānena tappayiṃ ",
  "bv6:17.3": "pacceka dussayugaṃ datvā ",
  "bv6:17.4": "saraṇaṃ tamupāgamiṃ. ",
  "bv6:18.1": "sopi maṃ buddho byākāsi ",
  "bv6:18.2": "sumano lokanāyako ",
  "bv6:18.3": "aparimeyye ito kappe ",
  "bv6:18.4": "ayaṃ buddho bhavissati. ",
  "bv6:19.1": "ahu kapilavhayā rammā nikkhamitvā tathāgato padhānaṃ padahitvāna ",
  "bv6:19.2": "katvā dukkarakārikaṃ. ajapāla rukkhamūlasmiṃ nisīditvā tathāgato tattha pāyāsaṃ paggayha nerañjaramupehiti. nerañjarāya tīramhi pāyāsaṃ adi so jino paṭiyatta varamaggena bodhimūlamhi ehiti. tato padakkhiṇaṃ katvā bodhimaṇḍaṃ anuttaraṃ assattha rukkhamūlamhi bujjhissati mahāyaso. imassa janikā mātā māyā nāma bhavissati pitā suddhodano nāma ayaṃ hessati gotamo. anāsavā vītarāgā santacittā samāhitā kolito upatisso ca aggā hessanti sāvakā ānando nāmupaṭṭhāko upaṭṭhissati maṃ jinaṃ. khemā uppalavaṇṇā ca aggā hessanti sāvikā anāsavā vītarāgā santacittā samāhitā. bodhi tassa bhagavato assatthoti pavuccati citto ca hatthāḷavako aggā hessantupaṭṭhakā. nandamātā ca uttarā aggā hessantupaṭṭhikā āyu vassa sataṃ tassa gotamassa yasassino. idaṃ sutvāna vacanaṃ asamassa mahesino āmoditā nara marū buddhavījaṅkuro ayaṃ. ukkuṭṭhi saddā vattanti apphoṭenti hasanti ca katañjalī namassanti dasasahassī sadevakā. yadi massa lokanāthassa virajjissāma sāsanaṃ anāgatamhi addhāne hessāma sammukhā imaṃ. yathā manussā nadiṃ tarantā paṭititthaṃ virajjhiya heṭṭhā titthaṃ gahetvāna uttaranti mahānadiṃ. evameva mayaṃ sabbe yadi muñcāmi maṃ jinaṃ anāgatamhi addhāne ",
  "bv6:19.3": "hessāma sammukhā imaṃ. ",
  "bv6:20.1": "tassāpi vacanaṃ sutvā ",
  "bv6:20.2": "bhiyyo cittaṃ pasādayiṃ ",
  "bv6:20.3": "uttariṃ vattamadhiṭṭhāsiṃ ",
  "bv6:20.4": "dasa pāramipūriyā. mekhalaṃ nāma ",
  "bv6:21.1": "nagaraṃ ",
  "bv6:21.2": "sudatto nāma khattiyo ",
  "bv6:21.3": "sirimā nāma janikā ",
  "bv6:21.4": "sumanassa mahesino. ",
  "bv6:22.1": "nava vassa sahassāni ",
  "bv6:22.2": "agāraṃ ajjhāvasi so ",
  "bv6:22.3": "cando sucando vaṭaṃso ",
  "bv6:22.4": "tayo pāsāda muttamā. ",
  "bv6:23.1": "tesaṭṭhi satasahassāni ",
  "bv6:23.2": "nāriyo samalaṅkatā ",
  "bv6:23.3": "vaṭaṃsakī nāma nārī ",
  "bv6:23.4": "anupamo nāma atrajo. ",
  "bv6:24.1": "nimitte caturo disvā ",
  "bv6:24.2": "hatthi yānena nikkhami ",
  "bv6:24.3": "anūna dasamāsāni ",
  "bv6:24.4": "padhānaṃ padahī jino. ",
  "bv6:25.1": "brahmunā yācito santo ",
  "bv6:25.2": "sumano lokanāyako ",
  "bv6:25.3": "vattacakko mahāvīro ",
  "bv6:25.4": "mekhale puravaruttame. ",
  "bv6:26.1": "saraṇo bhāvitatto ca ",
  "bv6:26.2": "ahesuṃ aggasāvakā ",
  "bv6:26.3": "udeno nāmupaṭṭhāko ",
  "bv6:26.4": "sumanassa mahesino. ",
  "bv6:27.1": "soṇā ca upasoṇā ca ",
  "bv6:27.2": "ahesuṃ aggasāvikā ",
  "bv6:27.3": "sopi buddho asamasamo ",
  "bv6:27.4": "nāgamūle abujjhatha. ",
  "bv6:28.1": "varuṇo ceva saraṇo ca ",
  "bv6:28.2": "ahesuṃ aggupaṭṭhakā ",
  "bv6:28.3": "cālā ca upacālā ca ",
  "bv6:28.4": "ahesuṃ aggupaṭṭhikā. ",
  "bv6:29.1": "uccattanena so buddho ",
  "bv6:29.2": "navuti hatthamuggato kañcanagghika ",
  "bv6:29.3": "saṅkāso ",
  "bv6:29.4": "dasasahassī virocati. ",
  "bv6:30.1": "navutivassa sahassāni ",
  "bv6:30.2": "āyu vijjati tāvade ",
  "bv6:30.3": "tāvatā tiṭṭhamāno so ",
  "bv6:30.4": "tāresi janataṃ bahuṃ. ",
  "bv6:31.1": "tāraṇīye tārayitvā ",
  "bv6:31.2": "bodhaneyye abodhayi ",
  "bv6:31.3": "parinibbāyi sambuddho ",
  "bv6:31.4": "uḷurājāva atthami. ",
  "bv6:32.1": "te ca khīṇāsavā bhikkhū ",
  "bv6:32.2": "so ca buddho asādiso ",
  "bv6:32.3": "atulaṃ pabhaṃ dassayitvā ",
  "bv6:32.4": "nibbutā te mahāyasā. ",
  "bv6:33.1": "tañca ñāṇamatuliyaṃ ",
  "bv6:33.2": "tāni ca atuliyāni ratanāni ",
  "bv6:33.3": "sabbaṃ samantarahitaṃ ",
  "bv6:33.4": "nanu rittā sabbasaṅkhārāti. ",
  "bv6:34.1": "sumano yasadharo buddho ",
  "bv6:34.2": "aṅgārāmamhi nibbuto ",
  "bv6:34.3": "tattheva tassa jinathūpo ",
  "bv6:34.4": "catu ",
  "bv6:35.1": "yojanamuggato. sumana buddhavaṃso catuttho. "
}
