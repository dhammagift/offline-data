{
  "bv21:0.1": "",
  "bv21:0.2": "ekūnavīsatimo vipassi buddhavaṃso ",
  "bv21:1.1": "pussassa aparena ",
  "bv21:1.2": "sambuddho dipaduttamo ",
  "bv21:1.3": "vipassī nāma nāmena ",
  "bv21:1.4": "loke uppajji cakkhumā. ",
  "bv21:2.1": "avijjaṇḍaṃ padāletvā ",
  "bv21:2.2": "patto sambodhimuttamaṃ ",
  "bv21:2.3": "dhammacakkaṃ pavattetuṃ ",
  "bv21:2.4": "pakkāmi bandhumatī puraṃ. ",
  "bv21:3.1": "dhammacakkaṃ pavattetvā ",
  "bv21:3.2": "ubho bodhesi nāyako ",
  "bv21:3.3": "gaṇanāya na vattabbo ",
  "bv21:3.4": "paṭhamābhisamayo ahu. ",
  "bv21:4.1": "punāparaṃ amitayaso ",
  "bv21:4.2": "tattha saccaṃ pakāsayi ",
  "bv21:4.3": "caturāsīti sahassānaṃ ",
  "bv21:4.4": "dutiyābhisamayo ahu. ",
  "bv21:5.1": "caturāsīti sahassāni ",
  "bv21:5.2": "sambuddhamanupabbajuṃ tesamārāma ",
  "bv21:5.3": "pattānaṃ ",
  "bv21:5.4": "dhammaṃ desesi cakkhumā. ",
  "bv21:6.1": "sabbākārena bhāsato ",
  "bv21:6.2": "ṭhatvā upanissā jino ",
  "bv21:6.3": "tepi dhammavaraṃ gantvā ",
  "bv21:6.4": "tatiyābhisamayo ahu. ",
  "bv21:7.1": "sannipātā tayo āsuṃ ",
  "bv21:7.2": "vippassissa mahesino ",
  "bv21:7.3": "khīṇāsavānaṃ vimalānaṃ ",
  "bv21:7.4": "santacittāna tādinaṃ. ",
  "bv21:8.1": "aṭṭhasaṭṭhisatasahassānaṃ ",
  "bv21:8.2": "paṭhamo āsi samāgamo ",
  "bv21:8.3": "bhikkhu satasahassānaṃ ",
  "bv21:8.4": "dutiyo āsi samāgamo. ",
  "bv21:9.1": "asīti bhikkhu sahassānaṃ ",
  "bv21:9.2": "tatiyo āsi samāgamo ",
  "bv21:9.3": "tattha bhikkhu gaṇa majjhe ",
  "bv21:9.4": "sambuddho atirocati. ",
  "bv21:10.1": "ahan tena samayena ",
  "bv21:10.2": "nāgarājā mahiddhiko ",
  "bv21:10.3": "atulo nāma nāmena ",
  "bv21:10.4": "puññavanto jutindharo. ",
  "bv21:11.1": "nekānaṃ nāgakoṭīnaṃ ",
  "bv21:11.2": "parivāretvānahaṃ tadā ",
  "bv21:11.3": "vajjanto dibba turiyehi ",
  "bv21:11.4": "lokajeṭṭhaṃ upāgamiṃ. ",
  "bv21:12.1": "upasaṅkamitvāna sambuddhaṃ ",
  "bv21:12.2": "vipassiṃ lokanāyakaṃ ",
  "bv21:12.3": "maṇi muttā ratanakhacitaṃ ",
  "bv21:12.4": "sabbābharaṇa vibhūsitaṃ ",
  "bv21:12.5": "nimantetvā dhammarājassa ",
  "bv21:12.6": "suvaṇṇapīṭhamadāsahaṃ. ",
  "bv21:13.1": "sopi maṃ buddho byākāsi ",
  "bv21:13.2": "saṅghamajjhe nisīdiya ",
  "bv21:13.3": "ekanavuti ito kappe ",
  "bv21:13.4": "ayaṃ buddho bhavissati. ",
  "bv21:14.1": "ahu kapilavhayā rammā ",
  "bv21:14.2": "nikkhamitvā tathāgato ",
  "bv21:14.3": "padhānaṃ padahitvāna ",
  "bv21:14.4": "katvā dukkarakārikaṃ. ",
  "bv21:15.1": "ajapāla rukkhamūlasmiṃ ",
  "bv21:15.2": "nisīditvā tathāgato ",
  "bv21:15.3": "tattha pāyāsaṃ paggayha ",
  "bv21:15.4": "nerañjaramupehiti. ",
  "bv21:16.1": "nerañjarāya tīramhi ",
  "bv21:16.2": "pāyāsaṃ adi so jino ",
  "bv21:16.3": "paṭiyatta varamaggena ",
  "bv21:16.4": "bodhimūlamhi ehiti. ",
  "bv21:17.1": "tato padakkhiṇaṃ katvā ",
  "bv21:17.2": "bodhimaṇḍaṃ anuttaraṃ assattha ",
  "bv21:17.3": "mūle sambodhiṃ ",
  "bv21:17.4": "bujjhissati mahāyaso. ",
  "bv21:18.1": "imassa janikā mātā ",
  "bv21:18.2": "māyā nāma bhavissati ",
  "bv21:18.3": "pitā suddhodano nāma ",
  "bv21:18.4": "ayaṃ hessati gotamo. ",
  "bv21:19.1": "",
  "bv21:19.2": "",
  "bv21:19.3": "kolito upatisso ca ",
  "bv21:19.4": "aggā hessanti sāvakā ",
  "bv21:19.5": "anāsavā vītarāgā santacittā samāhitā ānando nāmupaṭṭhāko ",
  "bv21:19.6": "upaṭṭhissati maṃ jinaṃ. ",
  "bv21:20.1": "khemā uppalavaṇṇā ca ",
  "bv21:20.2": "aggā hessanti sāvikā ",
  "bv21:20.3": "anāsavā vītarāgā ",
  "bv21:20.4": "santacittā samāhitā. ",
  "bv21:20.5": "bodhi tassa bhagavato ",
  "bv21:20.6": "assatthoti pavuccati ",
  "bv21:21.1": "citto ca hatthāḷavako ",
  "bv21:21.2": "aggā hessantupaṭṭhakā. ",
  "bv21:21.3": "nandamātā ca uttarā ",
  "bv21:21.4": "aggā hessantupaṭṭhikā ",
  "bv21:21.5": "āyu vassa sataṃ tassa ",
  "bv21:21.6": "gotamassa yasassino. ",
  "bv21:22.1": "idaṃ sutvāna vacanaṃ ",
  "bv21:22.2": "asamassa mahesino āmoditā nara marū buddhavījaṅkuro ayaṃ. ukkuṭṭhi saddā vattanti apphoṭenti hasanti ca katañjalī namassanti dasasahassī sadevakā. yadimassa lokanāthassa virajjhissāma sāsanaṃ anāgatamhi addhāne ",
  "bv21:22.3": "hessāma sammukhā imaṃ. ",
  "bv21:23.1": "yathā manussā nadiṃ tarantā paṭititthaṃ virajjhiya heṭṭhā titthaṃ gahetvā uttaranti mahānadiṃ. evameva mayaṃ sabbe yadi muñcāmi maṃ jinaṃ anāgatamhi addhāne hessāma sammukhā imaṃ. tassāpi vacanaṃ sutvā ",
  "bv21:23.2": "bhiyyo cittaṃ pasādayiṃ ",
  "bv21:23.3": "uttariṃ vattamadhiṭṭhāsiṃ dasa ",
  "bv21:23.4": "pāramipūriyā. ",
  "bv21:24.1": "nagaraṃ bandhumatī nāma ",
  "bv21:24.2": "bandhumo nāma khattiyo ",
  "bv21:24.3": "mātā bandhumatī nāma ",
  "bv21:24.4": "vipassissa mahesino. ",
  "bv21:25.1": "aṭṭha vassa sahassāni ",
  "bv21:25.2": "agāraṃ ajjhāvasi so ",
  "bv21:25.3": "nando sunando sirimā ",
  "bv21:25.4": "tayo pāsādamuttamā. ",
  "bv21:26.1": "ticattāri sahassāni ",
  "bv21:26.2": "nāriyo samalaṅkatā ",
  "bv21:26.3": "sudassanā nāma nārī ",
  "bv21:26.4": "samavattakkhandho nāma atrajo. ",
  "bv21:27.1": "nimitte caturo disvā ",
  "bv21:27.2": "ratha yānena nikkhami ",
  "bv21:27.3": "anūna aṭṭhamāsāni ",
  "bv21:27.4": "padhānaṃ padahī jino. ",
  "bv21:28.1": "brahmunā yācito santo ",
  "bv21:28.2": "vipassī lokanāyako ",
  "bv21:28.3": "vattacakko mahāvīro ",
  "bv21:28.4": "migadāye naruttamo. ",
  "bv21:29.1": "khandho ca tissa nāmo ca ",
  "bv21:29.2": "ahesuṃ aggasāvakā ",
  "bv21:29.3": "asoko nāmupaṭṭhāko ",
  "bv21:29.4": "vipassissa mahesino. ",
  "bv21:30.1": "candā ca candamittā ca ",
  "bv21:30.2": "ahesuṃ aggasāvikā ",
  "bv21:30.3": "bodhi tassa bhagavato ",
  "bv21:30.4": "pāṭalīti pavuccati. ",
  "bv21:31.1": "punabbasumitto nāgo ca ",
  "bv21:31.2": "ahesuṃ aggupaṭṭhakā ",
  "bv21:31.3": "sirimā uttarā ceva ",
  "bv21:31.4": "ahesuṃ aggupaṭṭhikā. ",
  "bv21:32.1": "asīti hatthamubbedho ",
  "bv21:32.2": "vipassī lokanāyako ",
  "bv21:32.3": "pabhā niddhāvatī tassa ",
  "bv21:32.4": "samantā satta yojane. ",
  "bv21:33.1": "asītivassasahassāni ",
  "bv21:33.2": "āyu buddhassa tāvade ",
  "bv21:33.3": "tāvatā tiṭṭhamāno so ",
  "bv21:33.4": "tāresi janataṃ bahuṃ. ",
  "bv21:34.1": "bahudeva manussānaṃ ",
  "bv21:34.2": "bandhanaṃ parimocayi ",
  "bv21:34.3": "maggāmaggañca ācikkhi ",
  "bv21:34.4": "avasesa puthujjane. ",
  "bv21:35.1": "ālokaṃ dassayitvāna ",
  "bv21:35.2": "dassetvā amataṃ padaṃ ",
  "bv21:35.3": "jalitvā aggi kkhandhova ",
  "bv21:35.4": "nibbuto so sasāvako. ",
  "bv21:36.1": "iddhivaraṃ puññavaraṃ ",
  "bv21:36.2": "lakkhaṇa cakkasumitaṃ ",
  "bv21:36.3": "sabbaṃ samantarahitaṃ ",
  "bv21:36.4": "nanu rittā sabbasaṅkhārāti. ",
  "bv21:37.1": "vipassī naravaro vīro ",
  "bv21:37.2": "sumittārāmamhi nibbuto ",
  "bv21:37.3": "tattheva tassa thūpavaro ",
  "bv21:37.4": "satta ",
  "bv21:38.1": "yojanamussitoti. vipassibuddhavaṃso ekūnavīsatimo. "
}
