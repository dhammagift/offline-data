{
  "bv12:0.1": "",
  "bv12:0.2": "dasamo padumuttara buddhavaṃso ",
  "bv12:1.1": "nāradassa aparena ",
  "bv12:1.2": "sambuddho dipaduttamo ",
  "bv12:1.3": "padumuttaro nāma jino ",
  "bv12:1.4": "akkhobbho sāgarūpamo. ",
  "bv12:2.1": "maṇḍakappo ca so āsi ",
  "bv12:2.2": "yamhi buddho ajāyatha ",
  "bv12:2.3": "ussannakusalā janatā ",
  "bv12:2.4": "tamhi kappe ajāyatha. ",
  "bv12:3.1": "padumuttarassa bhagavato ",
  "bv12:3.2": "paṭhame dhammadesane ",
  "bv12:3.3": "koṭi satasahassānaṃ ",
  "bv12:3.4": "dhammābhisamayo ahu. ",
  "bv12:4.1": "tato paraṃpi vassante ",
  "bv12:4.2": "tappayante ca pāṇine ",
  "bv12:4.3": "sattattiṃsa sahassānaṃ ",
  "bv12:4.4": "dutiyābhisamayo ahu. ",
  "bv12:5.1": "yamhi kāle mahāvīro ",
  "bv12:5.2": "ānandaṃ upasaṅkami ",
  "bv12:5.3": "pitu santikaṃ upagantvā ",
  "bv12:5.4": "āhani amatadundubhiṃ. ",
  "bv12:6.1": "āhate amatabherimhi ",
  "bv12:6.2": "vassante dhammavuṭṭhiyo ",
  "bv12:6.3": "paññāsa satasahassānaṃ ",
  "bv12:6.4": "tatiyābhisamayo ahu. ",
  "bv12:7.1": "ovādako viññāpako ",
  "bv12:7.2": "tārako sabbapāṇinaṃ ",
  "bv12:7.3": "desanākusalo buddho ",
  "bv12:7.4": "tāresi janataṃ bahuṃ. ",
  "bv12:8.1": "sannipātā tayo āsuṃ ",
  "bv12:8.2": "padumuttarassa satthuno ",
  "bv12:8.3": "koṭi satasahassānaṃ ",
  "bv12:8.4": "paṭhamo āsi samāgamo. ",
  "bv12:9.1": "yadā buddho asamasamo ",
  "bv12:9.2": "vasi vebhārapabbate ",
  "bv12:9.3": "navuti koṭisahassānaṃ ",
  "bv12:9.4": "dutiyo āsi samāgamo. ",
  "bv12:10.1": "puna cārikaṃ pakkante ",
  "bv12:10.2": "gāma nigama raṭṭhato ",
  "bv12:10.3": "asīti koṭisahassānaṃ ",
  "bv12:10.4": "tatiyo āsi samāgamo. ",
  "bv12:11.1": "ahantena samayena ",
  "bv12:11.2": "jaṭilo nāma raṭṭhiko ",
  "bv12:11.3": "sambuddhappamukhaṃ saṅghaṃ ",
  "bv12:11.4": "sabhattaṃ dussamadāsihaṃ. ",
  "bv12:12.1": "sopi maṃ buddho byākāsi ",
  "bv12:12.2": "saṅghamajjhe nisīdiya ",
  "bv12:12.3": "satasahasse ito kappe ",
  "bv12:12.4": "ayaṃ buddho bhavissati. ",
  "bv12:13.1": "ahu kapilavhayā rammā nikkhamitvā tathāgato padhānaṃ padahitvāna ",
  "bv12:13.2": "katvā dukkarakārikaṃ. ajapāla rukkhamūlasmiṃ nisīditvā tathāgato tattha pāyāsaṃ paggayha nerañjaramupehiti. nerañjarāya tīramhi pāyāsaṃ adi so jino paṭiyatta varamaggena bodhimūlamhi ehiti. tato padakkhiṇaṃ katvā bodhimaṇḍaṃ anuttaraṃ assattha rukkhamūlamhi bujjhissati mahāyaso. imassa janikā mātā māyā nāma bhavissati pitā suddhodano nāma ayaṃ hessati gotamo. anāsavā vītarāgā santacittā samāhitā kolito upatisso ca aggā hessanti sāvakā ānando nāmupaṭṭhāko upaṭṭhissatimaṃ jinaṃ. khemā uppalavaṇṇā ca aggā hessanti sāvikā anāsavā vītarāgā santacittā samāhitā. bodhi tassa bhagavato assatthoti pavuccati citto ca hatthāḷavako aggā hessantupaṭṭhakā. nandamātā ca uttarā aggā hessantupaṭṭhikā āyu vassa sataṃ tassa gotamassa yasassino. idaṃ sutvāna vacanaṃ asamassa mahesino āmoditā nara marū buddhavījaṅkuro ayaṃ. ukkuṭṭhi saddā vattanti apphoṭenti hasanti ca katañjalī namassanti dasasahassī sadevakā. yadi massa lokanāthassa virajjhissāma sāsanaṃ anāgatamhi addhāne hessāma sammukhā imaṃ. yathā manussā nadiṃ tarantā paṭititthaṃ virajjhiya heṭṭhā titthaṃ gahetvāna uttaranti mahānadiṃ. evameva mayaṃ sabbe yadi muñcāmi maṃ jinaṃ anāgatamhi addhāne ",
  "bv12:13.3": "hessāma sammukhā imaṃ. ",
  "bv12:14.1": "tassāpi vacanaṃ sutvā ",
  "bv12:14.2": "uttariṃ vattamadhiṭṭhahiṃ ",
  "bv12:14.3": "akāsiṃ uggaṃ daḷhaṃ dhitiṃ ",
  "bv12:14.4": "dasa pāramipūriyā. ",
  "bv12:15.1": "byāhatā titthiyā sabbe ",
  "bv12:15.2": "vimanā dummanā tadā ",
  "bv12:15.3": "na tesaṃ keci paricaranti ",
  "bv12:15.4": "raṭṭhato nicchubhanti te. ",
  "bv12:16.1": "sabbe tattha samāgantvā ",
  "bv12:16.2": "upagacchuṃ buddhasantike ",
  "bv12:16.3": "tuvaṃ nātho mahāvīra ",
  "bv12:16.4": "saraṇaṃ hohi cakkhumā. ",
  "bv12:17.1": "anukampako kāruṇiko ",
  "bv12:17.2": "hitesī sabbapāṇinaṃ ",
  "bv12:17.3": "sampatte titthiye sabbe ",
  "bv12:17.4": "pañcasīle patiṭṭhahi. ",
  "bv12:18.1": "evaṃ nirākulaṃ āsi ",
  "bv12:18.2": "suññataṃ titthiyehi taṃ ",
  "bv12:18.3": "vicittaṃ arahantehi ",
  "bv12:18.4": "vasībhūtehi tādihi. ",
  "bv12:19.1": "nagaraṃ haṃsavatī nāma ",
  "bv12:19.2": "ānando nāma khattiyo ",
  "bv12:19.3": "sujātā nāma janikā ",
  "bv12:19.4": "padumuttara satthuno. ",
  "bv12:20.1": "nava vassa sahassāni ",
  "bv12:20.2": "agāraṃ ajjhāvasi so nārī ",
  "bv12:20.3": "bāhano yasavatī ",
  "bv12:20.4": "tayo pāsāda muttamā. ticattāri ",
  "bv12:21.1": "sahassāni ",
  "bv12:21.2": "nāriyo samalaṅkatā ",
  "bv12:21.3": "vasuladattā nāma nārī ",
  "bv12:21.4": "uttaro nāma atrajo. ",
  "bv12:22.1": "nimitte caturo disvā ",
  "bv12:22.2": "pāsādenābhinikkhami ",
  "bv12:22.3": "sattāhaṃ padhānacāraṃ ",
  "bv12:22.4": "acari purisuttamo. ",
  "bv12:23.1": "brahmunā yācito santo ",
  "bv12:23.2": "padumuttaro vināyako ",
  "bv12:23.3": "vattacakko mahāvīro ",
  "bv12:23.4": "mithiluyyānamuttame. ",
  "bv12:24.1": "devilo ca sujāto ca ",
  "bv12:24.2": "ahesuṃ aggasāvakā ",
  "bv12:24.3": "sumano nāmupaṭṭhāko ",
  "bv12:24.4": "padumuttarassa satthuno. ",
  "bv12:25.1": "amitā asamā ceva ",
  "bv12:25.2": "ahesuṃ aggasāvikā ",
  "bv12:25.3": "bodhi tassa bhagavato ",
  "bv12:25.4": "salaḷoti pavuccati. ",
  "bv12:26.1": "amito ceva tisso ca ",
  "bv12:26.2": "ahesuṃ aggupaṭṭhakā ",
  "bv12:26.3": "hatthā ceva sucittā ca ",
  "bv12:26.4": "ahesuṃ aggupaṭṭhikā. ",
  "bv12:27.1": "aṭṭhapaññāsa ratanaṃ ",
  "bv12:27.2": "accuggato mahāmuni ",
  "bv12:27.3": "kañcanagghika saṅkāso ",
  "bv12:27.4": "dvattiṃsa varalakkhaṇo. ",
  "bv12:28.1": "kuḍḍā kavāṭā bhitti ca ",
  "bv12:28.2": "rukkhā nagasiluccayo ",
  "bv12:28.3": "na tassāvaraṇaṃ atthi ",
  "bv12:28.4": "samantā dvādasayojane. ",
  "bv12:29.1": "vassa satasahassāni ",
  "bv12:29.2": "āyu vijjati tāvade ",
  "bv12:29.3": "tāvatā tiṭṭhamāno so ",
  "bv12:29.4": "tāresi janataṃ bahuṃ. ",
  "bv12:30.1": "santāretvā bahujaññaṃ ",
  "bv12:30.2": "chinditvā sabbasaṃsayaṃ ",
  "bv12:30.3": "jalitvā aggi kkhandhova ",
  "bv12:30.4": "nibbuto so sasāvako. ",
  "bv12:31.1": "padumuttaro jino buddho ",
  "bv12:31.2": "nandārāmamhi nibbuto ",
  "bv12:31.3": "tattheva tassa thūpavaro ",
  "bv12:31.4": "dvādasa ",
  "bv12:32.1": "mubbedhayojanoti. padumuttara buddhavaṃso dasamo. "
}
