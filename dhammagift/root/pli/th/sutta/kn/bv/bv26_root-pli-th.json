{
  "bv26:0.1": "",
  "bv26:0.2": "catuvīsatimo kassapa buddhavaṃso ",
  "bv26:1.1": "konāgamanassa aparena ",
  "bv26:1.2": "sambuddho dipaduttamo ",
  "bv26:1.3": "kassapo nāma nāmena ",
  "bv26:1.4": "dhammarājā pabhaṅkaro. ",
  "bv26:2.1": "sa chaḍḍitaṃ kulamūlaṃ ",
  "bv26:2.2": "bahūnaṃ pāṇapūjitaṃ ",
  "bv26:2.3": "datvāna dāyake dānaṃ ",
  "bv26:2.4": "pūrayitvāna mānasaṃ ",
  "bv26:2.5": "usabho vāḷakaṃ bhetvā ",
  "bv26:2.6": "patto sambodhimuttamaṃ. ",
  "bv26:3.1": "dhammacakkaṃ pavattente ",
  "bv26:3.2": "kassape lokanāyake ",
  "bv26:3.3": "vīsati koṭisahassānaṃ ",
  "bv26:3.4": "paṭhamābhisamayo ahu. ",
  "bv26:4.1": "catumāsaṃ yadā buddho ",
  "bv26:4.2": "loke carati cārikaṃ ",
  "bv26:4.3": "dasa koṭisahassānaṃ ",
  "bv26:4.4": "dutiyābhisamayo ahu. ",
  "bv26:5.1": "yamakaṃ vikubbanaṃ katvā ",
  "bv26:5.2": "ñāṇadhātuṃ pakittayi ",
  "bv26:5.3": "pañca koṭisahassānaṃ ",
  "bv26:5.4": "tatiyābhisamayo ahu. ",
  "bv26:6.1": "sudhammadevapure ramme ",
  "bv26:6.2": "tattha dhammaṃ pakittayi ",
  "bv26:6.3": "tīṇi koṭisahassāni ",
  "bv26:6.4": "devānaṃ bodhayī jino. ",
  "bv26:7.1": "nara devassa yakkhassa ",
  "bv26:7.2": "apare ca dhammadesane ",
  "bv26:7.3": "etesānaṃ abhisamayo ",
  "bv26:7.4": "gaṇanāto asaṅkhiyo. ",
  "bv26:8.1": "tassāpi devadevassa ",
  "bv26:8.2": "eko āsi samāgamo ",
  "bv26:8.3": "khīṇāsavānaṃ vimalānaṃ ",
  "bv26:8.4": "santacittāna tādinaṃ. ",
  "bv26:9.1": "vīsati bhikkhu sahassānaṃ ",
  "bv26:9.2": "tadā āsi samāgamo ",
  "bv26:9.3": "abhikkanta bhavantānaṃ ",
  "bv26:9.4": "hiri sīlena tādinaṃ. ",
  "bv26:10.1": "ahaṃ tadā māṇavako ",
  "bv26:10.2": "jotipāloti vissuto ",
  "bv26:10.3": "ajjhāyiko mantadharo ",
  "bv26:10.4": "tiṇṇaṃ vedāna pāragū. ",
  "bv26:11.1": "lakkhaṇe itihāse ca ",
  "bv26:11.2": "saddhamme pāramiṃ gato ",
  "bv26:11.3": "bhummantalikkhe kusalo ",
  "bv26:11.4": "katavijjo anāmayo. ",
  "bv26:12.1": "kassapassa bhagavato ",
  "bv26:12.2": "ghaṭikāro nāmupaṭṭhako ",
  "bv26:12.3": "sagāravo sappatisso ",
  "bv26:12.4": "nibbuto tatiye phale. ",
  "bv26:13.1": "ādāya maṃ ghaṭikāro ",
  "bv26:13.2": "upagañchi kassapaṃ jinaṃtha ",
  "bv26:13.3": "tassa dhammaṃ suṇitvāna ",
  "bv26:13.4": "pabbajiṃ tassa santike. ",
  "bv26:14.1": "āraddhaviriyo hutvā ",
  "bv26:14.2": "vattāvattesu kovido ",
  "bv26:14.3": "na kvaci parihāyāmi ",
  "bv26:14.4": "pūremi jinasāsanaṃ. ",
  "bv26:15.1": "yāvatā buddha bhaṇitaṃ ",
  "bv26:15.2": "navaṅga satthusāsanaṃ ",
  "bv26:15.3": "sabbaṃ pariyāpuṇitvāna ",
  "bv26:15.4": "sobhayiṃ jinasāsanaṃ. ",
  "bv26:16.1": "mama acchariyaṃ disvā ",
  "bv26:16.2": "sopi buddho viyākari ",
  "bv26:16.3": "imamhi bhaddake kappe ",
  "bv26:16.4": "ayaṃ buddho bhavissati. ",
  "bv26:17.1": "ahu kapilavhayā rammā ",
  "bv26:17.2": "nikkhamitvā tathāgato ",
  "bv26:17.3": "padhānaṃ padahitvāna ",
  "bv26:17.4": "katvā dukkarakārikaṃ. ",
  "bv26:18.1": "ajapāla rukkhamūlamhi ",
  "bv26:18.2": "nisīditvā tathāgato ",
  "bv26:18.3": "tattha pāyāsaṃ samādāya ",
  "bv26:18.4": "nerañjaramupehiti. ",
  "bv26:19.1": "nerañjarāya tīramhi ",
  "bv26:19.2": "pāyāsaṃ paribhuñjiya ",
  "bv26:19.3": "paṭiyatta varamaggena ",
  "bv26:19.4": "bodhimūlamhi ehiti. ",
  "bv26:20.1": "tato padakkhiṇaṃ katvā ",
  "bv26:20.2": "bodhimaṇḍaṃ anuttaraṃ ",
  "bv26:20.3": "assatthamūle ",
  "bv26:20.4": "",
  "bv26:20.5": "sambodhiṃ ",
  "bv26:20.6": "bujjhissati mahāyaso. ",
  "bv26:21.1": "imassa janikā mātā ",
  "bv26:21.2": "māyā nāma bhavissati ",
  "bv26:21.3": "pitā suddhodano nāma ",
  "bv26:21.4": "ayaṃ hessati gotamo. ",
  "bv26:22.1": "",
  "bv26:22.2": "",
  "bv26:22.3": "kolito upatisso ca ",
  "bv26:22.4": "aggā hessanti sāvakā ",
  "bv26:22.5": "anāsavā vītarāgā santacittā samāhitā ānando nāmupaṭṭhāko ",
  "bv26:22.6": "upaṭṭhissatimaṃ jinaṃ. ",
  "bv26:23.1": "khemā uppalavaṇṇā ca ",
  "bv26:23.2": "aggā hessanti sāvikā ",
  "bv26:23.3": "anāsavā vītarāgā santacittā ",
  "bv26:23.4": "samāhitā. ",
  "bv26:23.5": "bodhi tassa bhagavato ",
  "bv26:23.6": "assatthoti pavuccati ",
  "bv26:24.1": "citto ca hatthāḷavako ",
  "bv26:24.2": "aggā hessantupaṭṭhakā. ",
  "bv26:24.3": "nandamātā ca uttarā ",
  "bv26:24.4": "aggā hessantupaṭṭhikā ",
  "bv26:25.1": "āyu vassa sataṃ tassa gotamassa yasassino. idaṃ sutvāna vacanaṃ ",
  "bv26:25.2": "asamassa mahesino ",
  "bv26:25.3": "āmoditā nara ",
  "bv26:25.4": "marū buddhavījaṅkuro ayaṃ. ",
  "bv26:26.1": "ukkuṭṭhi saddā vattanti ",
  "bv26:26.2": "apphoṭenti hasanti ca ",
  "bv26:26.3": "katañjalī namassanti ",
  "bv26:26.4": "dasasahassī sadevakā. ",
  "bv26:27.1": "yadi massa lokanāthassa ",
  "bv26:27.2": "virajjhissāma sāsanaṃ ",
  "bv26:27.3": "anāgatamhi addhāne ",
  "bv26:27.4": "hessāma sammukhā imaṃ. ",
  "bv26:28.1": "yathā manussā nadiṃ tarantā ",
  "bv26:28.2": "paṭititthaṃ virajjhiya ",
  "bv26:28.3": "heṭṭhā titthaṃ gahetvāna ",
  "bv26:28.4": "uttaranti mahānadiṃ. ",
  "bv26:29.1": "evameva mayaṃ sabbe ",
  "bv26:29.2": "yadi muñcāmi maṃ jinaṃ ",
  "bv26:29.3": "anāgatamhi addhāne ",
  "bv26:29.4": "hessāma sammukhā imaṃ. ",
  "bv26:30.1": "tassāpi vacanaṃ sutvā ",
  "bv26:30.2": "bhiyyo cittaṃ pasādayiṃ ",
  "bv26:30.3": "uttariṃ vattamadhiṭṭhāsiṃ dasa ",
  "bv26:30.4": "pāramipūriyā. ",
  "bv26:31.1": "evamahaṃ saṃsaritvā ",
  "bv26:31.2": "parivajjento anācaraṃ ",
  "bv26:31.3": "dukkaraṃ pakataṃ mayhaṃ ",
  "bv26:31.4": "bodhiyā yeva kāraṇā. ",
  "bv26:32.1": "nagaraṃ bārāṇasī nāma ",
  "bv26:32.2": "kīki nāmāsi khattiyo ",
  "bv26:32.3": "vasati tattha nagare ",
  "bv26:32.4": "sambuddhassa mahākulaṃ. ",
  "bv26:33.1": "brāhmaṇo brahmadatto ca ",
  "bv26:33.2": "āsi buddhassa so pitā mātā ",
  "bv26:33.3": "dhanavatī nāma ",
  "bv26:33.4": "kassapassa mahesino. ",
  "bv26:34.1": "duve vassa sahassāni ",
  "bv26:34.2": "agāraṃ ajjhāvasi so ",
  "bv26:34.3": "haṃso yaso siricando ",
  "bv26:34.4": "tayo pāsāda muttamā. ",
  "bv26:35.1": "tisoḷasa sahassāni ",
  "bv26:35.2": "nāriyo samalaṅkatā ",
  "bv26:35.3": "sunandā nāma sā nārī ",
  "bv26:35.4": "vijitaseno nāma atrajo. ",
  "bv26:36.1": "nimitte caturo disvā ",
  "bv26:36.2": "pāsādenābhinikkhami ",
  "bv26:36.3": "sattāhaṃ padhānacāraṃ ",
  "bv26:36.4": "acari purisuttamo. ",
  "bv26:37.1": "brahmunā yācito santo ",
  "bv26:37.2": "kassapo lokanāyako ",
  "bv26:37.3": "vattacakko mahāvīro ",
  "bv26:37.4": "migadāye naruttamo. ",
  "bv26:38.1": "tisso ca bhāradvājo ca ",
  "bv26:38.2": "ahesuṃ aggasāvakā ",
  "bv26:38.3": "sabbamitto nāmupaṭṭhāko ",
  "bv26:38.4": "kassapassa mahesino. ",
  "bv26:39.1": "anulā ca uruvelā ca ",
  "bv26:39.2": "ahesuṃ aggasāvikā ",
  "bv26:39.3": "bodhi tassa bhagavato ",
  "bv26:39.4": "nigrodhoti pavuccati. ",
  "bv26:40.1": "sumaṅgalo ghaṭikāro ca ",
  "bv26:40.2": "ahesuṃ aggupaṭṭhakā ",
  "bv26:40.3": "vijitasenā ca bhaddā ca ",
  "bv26:40.4": "ahesuṃ aggupaṭṭhikā. ",
  "bv26:41.1": "uccattanena so buddho ",
  "bv26:41.2": "vīsati ratanamuggato ",
  "bv26:41.3": "vijjulaṭṭhiva ākāse ",
  "bv26:41.4": "candova gahapūrito. ",
  "bv26:42.1": "vīsati vassa sahassāni ",
  "bv26:42.2": "āyu tassa mahesino ",
  "bv26:42.3": "tāvatā tiṭṭhamāno so ",
  "bv26:42.4": "tāresi janataṃ bahuṃ. ",
  "bv26:43.1": "dhamma taḷākaṃ māpayitvā ",
  "bv26:43.2": "sīlaṃ datvā vilepanaṃ ",
  "bv26:43.3": "dhamma dussaṃ nivāsetvā ",
  "bv26:43.4": "dhamma mālaṃ vibhajjiya. ",
  "bv26:44.1": "dhamma vimalamādāsaṃ ",
  "bv26:44.2": "ṭhapayitvā mahājane ",
  "bv26:44.3": "keci nibbānaṃ patthentā ",
  "bv26:44.4": "passantu me alaṅkaraṃ. ",
  "bv26:45.1": "sīla kañcukaṃ datvāna ",
  "bv26:45.2": "jhāna kavaca cammikaṃ ",
  "bv26:45.3": "dhamma cammaṃ pārupitvā ",
  "bv26:45.4": "datvā sannāhamuttamaṃ. ",
  "bv26:46.1": "sati phalakaṃ datvāna ",
  "bv26:46.2": "tikhiṇañāṇa kuntimaṃ ",
  "bv26:46.3": "dhamma khaggavaraṃ datvā ",
  "bv26:46.4": "sīla sattuppamaddanaṃ. ",
  "bv26:47.1": "tevijjābhūsaṃ datvāna ",
  "bv26:47.2": "āveḷaṃ caturo phale ",
  "bv26:47.3": "chaḷabhiññābharaṇaṃ datvā ",
  "bv26:47.4": "dhamma puppha pilandhanaṃ. ",
  "bv26:48.1": "saddhamma paṇḍaracchattaṃ ",
  "bv26:48.2": "datvā pāpanivāraṇaṃ ",
  "bv26:48.3": "māpayitvā abhayaṃ pupphaṃ ",
  "bv26:48.4": "nibbuto so sasāvako. ",
  "bv26:49.1": "eso hi sammāsambuddho ",
  "bv26:49.2": "appameyyo durāsado ",
  "bv26:49.3": "eso hi dhammaratano ",
  "bv26:49.4": "svākkhāto ehipassiko. ",
  "bv26:50.1": "eso hi saṅgharatano ",
  "bv26:50.2": "supaṭipanno anuttaro ",
  "bv26:50.3": "sabbaṃ samantarahitaṃ ",
  "bv26:50.4": "nanu rittā sabbasaṅkhārāti. ",
  "bv26:51.1": "mahākassapo jino satthā ",
  "bv26:51.2": "setabyārāmamhi nibbuto ",
  "bv26:51.3": "tattheva tassa jinathūpo ",
  "bv26:51.4": "yojanubbedhamuggatoti. ",
  "bv26:52.1": "kassapa buddhavaṃso catuvīsatimo. "
}
