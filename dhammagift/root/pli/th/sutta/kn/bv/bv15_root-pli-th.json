{
  "bv15:0.1": "",
  "bv15:0.2": "terasamo piyadassi buddhavaṃso ",
  "bv15:1.1": "sujātassa aparena ",
  "bv15:1.2": "sayambhū lokanāyako ",
  "bv15:1.3": "durāsado asamasamo ",
  "bv15:1.4": "piyadassī mahāyaso. ",
  "bv15:2.1": "sopi buddho amitayaso ",
  "bv15:2.2": "ādiccova virocati nihantvāna tamaṃ ",
  "bv15:2.3": "sabbaṃ ",
  "bv15:2.4": "dhammacakkaṃ pavattayi. ",
  "bv15:3.1": "tassāpi atulatejassa ",
  "bv15:3.2": "ahesuṃ abhisamayā tayo ",
  "bv15:3.3": "koṭi satasahassānaṃ ",
  "bv15:3.4": "paṭhamābhisamayo ahu. ",
  "bv15:4.1": "sudassano devarājā ",
  "bv15:4.2": "micchādiṭṭhimarocayi ",
  "bv15:4.3": "tassa diṭṭhiṃ vinodento ",
  "bv15:4.4": "satthā dhammamadesayi. ",
  "bv15:5.1": "janasannipāto atulo ",
  "bv15:5.2": "mahā sannipatī tadā ",
  "bv15:5.3": "nava koṭisahassānaṃ ",
  "bv15:5.4": "dutiyābhisamayo ahu. ",
  "bv15:6.1": "yadā doṇamukhaṃ hatthiṃ ",
  "bv15:6.2": "vineti narasārathi ",
  "bv15:6.3": "asīti koṭisahassānaṃ ",
  "bv15:6.4": "tatiyābhisamayo ahu. ",
  "bv15:7.1": "sannipātā tayo āsuṃ ",
  "bv15:7.2": "tassāpi piyadassino ",
  "bv15:7.3": "koṭi satasahassānaṃ ",
  "bv15:7.4": "paṭhamo āsi samāgamo. ",
  "bv15:8.1": "tato paraṃ navutikoṭī ",
  "bv15:8.2": "samiṃsu ekato munī ",
  "bv15:8.3": "tatiye sannipātamhi ",
  "bv15:8.4": "asītikoṭiyo ahu. ",
  "bv15:9.1": "ahan tena samayena ",
  "bv15:9.2": "kassapo nāma māṇavo ",
  "bv15:9.3": "ajjhāyiko mantadharo ",
  "bv15:9.4": "tiṇṇaṃ vedāna pāragū. ",
  "bv15:10.1": "tassa dhammaṃ suṇitvāna ",
  "bv15:10.2": "pasādaṃ janayiṃ ahaṃ ",
  "bv15:10.3": "koṭi satasahassehi ",
  "bv15:10.4": "saṅghārāmaṃ amāpayiṃ. ",
  "bv15:11.1": "tassa datvāna ārāmaṃ ",
  "bv15:11.2": "haṭṭho saṃviggamānaso ",
  "bv15:11.3": "saraṇe pañcasīle ca ",
  "bv15:11.4": "daḷhaṃ katvā samādayiṃ. ",
  "bv15:12.1": "sopi maṃ buddho byākāsi ",
  "bv15:12.2": "saṅghamajjhe nisīdiya ",
  "bv15:12.3": "aṭṭhārasa kappasate ",
  "bv15:12.4": "ayaṃ buddho bhavissati. ",
  "bv15:13.1": "ahu kapilavhayā rammā nikkhamitvā tathāgato padhānaṃ padahitvāna ",
  "bv15:13.2": "katvā dukkarakārikaṃ. ajapāla rukkhamūlasmiṃ nisīditvā tathāgato tattha pāyāsaṃ paggayha nerañjaramupehiti. nerañjarāya tīramhi pāyāsaṃ adi so jino paṭiyatta varamaggena bodhimūlamhi ehiti. tato padakkhiṇaṃ katvā bodhimaṇḍaṃ anuttaraṃ assattha rukkhamūlamhi bujjhissati mahāyaso. imassa janikā mātā māyā nāma bhavissati pitā suddhodano nāma ayaṃ hessati gotamo. anāsavā vītarāgā santacittā samāhitā kolito upatisso ca aggā hessanti sāvakā ānando nāmupaṭṭhāko upaṭṭhissatimaṃ jinaṃ. khemā uppalavaṇṇā ca aggā hessanti sāvikā anāsavā vītarāgā santacittā samāhitā. bodhi tassa bhagavato assatthoti pavuccati citto ca hatthāḷavako aggā hessantupaṭṭhakā. nandamātā ca uttarā aggā hessantupaṭṭhikā āyu vassa sataṃ tassa gotamassa yasassino. idaṃ sutvāna vacanaṃ asamassa mahesino āmoditā nara marū buddhavījaṅkuro ayaṃ. ukkuṭṭhi saddā vattanti apphoṭenti hasanti ca katañjalī namassanti dasasahassī sadevakā. yadi massa lokanāthassa virajjhissāma sāsanaṃ anāgatamhi addhāne hessāma sammukhā imaṃ. yathā manussā nadiṃ tarantā paṭititthaṃ virajjhiya heṭṭhā titthaṃ gahetvāna uttaranti mahānadiṃ. evameva mayaṃ sabbe yadi muñcāmi maṃ jinaṃ anāgatamhi addhāne ",
  "bv15:13.3": "hessāma sammukhā imaṃ. ",
  "bv15:14.1": "tassāpi vacanaṃ sutvā ",
  "bv15:14.2": "bhiyyo cittaṃ pasādayiṃ ",
  "bv15:14.3": "uttariṃ vattamadhiṭṭhāsiṃ ",
  "bv15:14.4": "dasa pāramipūriyā. ",
  "bv15:15.1": "sudhaññaṃ nāma nagaraṃ ",
  "bv15:15.2": "sudatto nāma khattiyo ",
  "bv15:15.3": "sucandā nāma janikā ",
  "bv15:15.4": "piyadassissa satthuno. ",
  "bv15:16.1": "nava vassa sahassāni ",
  "bv15:16.2": "agāraṃ ajjhāvasi so ",
  "bv15:16.3": "sunimmala vimala girigūhā ",
  "bv15:16.4": "tayo pāsādamuttamā. ",
  "bv15:17.1": "tettiṃsati sahassāni ",
  "bv15:17.2": "nāriyo samalaṅkatā ",
  "bv15:17.3": "vimalā nāma sā nārī kañcanāveḷa ",
  "bv15:17.4": "atrajo. ",
  "bv15:18.1": "nimitte caturo disvā ",
  "bv15:18.2": "ratha yānena nikkhami ",
  "bv15:18.3": "chamāsaṃ padhānacāraṃ ",
  "bv15:18.4": "acari purisuttamo. ",
  "bv15:19.1": "brahmunā yācito santo ",
  "bv15:19.2": "piyadassiṃ mahāmuni ",
  "bv15:19.3": "vattacakko mahāvīro ",
  "bv15:19.4": "usabhuyyāne manorame. ",
  "bv15:20.1": "pālito sabbadassī ca ",
  "bv15:20.2": "ahesuṃ aggasāvakā ",
  "bv15:20.3": "sobhito nāmupaṭṭhāko ",
  "bv15:20.4": "piyadassissa satthuno. ",
  "bv15:21.1": "sujātā dhammadinnā ca ",
  "bv15:21.2": "ahesuṃ aggasāvikā ",
  "bv15:21.3": "bodhi tassa bhagavato ",
  "bv15:21.4": "kakudhoti pavuccati. ",
  "bv15:22.1": "sandako dhammiko ceva ",
  "bv15:22.2": "ahesuṃ aggupaṭṭhakā ",
  "bv15:22.3": "visākhā dhammadinnā ca ",
  "bv15:22.4": "ahesuṃ aggupaṭṭhikā. ",
  "bv15:23.1": "sopi buddho amitayaso ",
  "bv15:23.2": "dvattiṃsa varalakkhaṇo ",
  "bv15:23.3": "asītihatthamubbedho ",
  "bv15:23.4": "sālarājāva dissati. ",
  "bv15:24.1": "aggiyā canda suriyānaṃ ",
  "bv15:24.2": "natthi tādisikā pabhā ",
  "bv15:24.3": "yathā ahu pabhā tassa ",
  "bv15:24.4": "asamassa mahesino. ",
  "bv15:25.1": "tassāpi devadevassa ",
  "bv15:25.2": "āyu tāvattakā ahu ",
  "bv15:25.3": "navuti vassa sahassāni ",
  "bv15:25.4": "loke aṭṭhāsi cakkhumā. ",
  "bv15:26.1": "sopi buddho asamasamo ",
  "bv15:26.2": "yugānipi tāni atuliyāni ",
  "bv15:26.3": "sabbaṃ samantarahitaṃ ",
  "bv15:26.4": "nanu rittā sabbasaṅkhārāti. ",
  "bv15:27.1": "piyadassī munivaro ",
  "bv15:27.2": "assatthārāmamhi nibbuto ",
  "bv15:27.3": "tattheva tassa jinathūpo ",
  "bv15:27.4": "tīṇi yojanamuggatoti. ",
  "bv15:28.1": "piyadassibuddhavaṃso terasamo. "
}
