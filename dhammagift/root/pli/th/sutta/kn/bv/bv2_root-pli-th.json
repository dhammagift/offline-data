  "bv2:107.3": "mayaṃpetaṃ vijānāma ",
  "bv2:107.4": "dhuvaṃ buddho bhavissasi. ",
  "bv2:108.1": "buddhassa vacanaṃ sutvā ",
  "bv2:108.2": "dasasahassīna cūbhayaṃ ",
  "bv2:108.3": "tuṭṭha haṭṭho pamodito ",
  "bv2:108.4": "evaṃ cintesihantadā. ",
  "bv2:109.1": "advejjhavacanā buddhā ",
  "bv2:109.2": "amogha vacanā jinā ",
  "bv2:109.3": "vitathaṃ natthi buddhānaṃ ",
  "bv2:109.4": "dhuvaṃ buddho bhavāmihaṃ. ",
  "bv2:110.1": "yathā khittaṃ nabhe leṇḍaṃ ",
  "bv2:110.2": "dhuvaṃ patati bhūmiyaṃ ",
  "bv2:110.3": "tatheva buddha seṭṭhānaṃ ",
  "bv2:110.4": "vacanaṃ dhuva sassataṃ. ",
  "bv2:110.5": "[vitathaṃ natthi buddhānaṃ ",
  "bv2:110.6": "dhuvaṃ buddho bhavāmihaṃ] ",
  "bv2:111.1": "yathāpi sabba sattānaṃ ",
