{
  "bv18:0.1": "",
  "bv18:0.2": "soḷasamo siddhatthabuddhavaṃso ",
  "bv18:1.1": "dhammadassissa aparena ",
  "bv18:1.2": "siddhattho lokanāyako nihantvāna ",
  "bv18:1.3": "tamaṃ sabbaṃ ",
  "bv18:1.4": "suriyo abbhuggato yathā. ",
  "bv18:2.1": "sopi patvāna sambodhiṃ ",
  "bv18:2.2": "santārento sadevakaṃ ",
  "bv18:2.3": "abhivassi dhammameghena ",
  "bv18:2.4": "nibbāpento sadevakaṃ. ",
  "bv18:3.1": "tassāpi atulatejassa ",
  "bv18:3.2": "ahesuṃ abhisamayā tayo ",
  "bv18:3.3": "koṭisatasahassānaṃ ",
  "bv18:3.4": "paṭhamābhisamayo ahu. ",
  "bv18:4.1": "punāparaṃ bhīmaraṭṭhe ",
  "bv18:4.2": "yadā āhani dundubhiṃ ",
  "bv18:4.3": "tadā navutikoṭīnaṃ ",
  "bv18:4.4": "dutiyābhisamayo ahu. ",
  "bv18:5.1": "yadā buddho dhammaṃ desesi ",
  "bv18:5.2": "vebhāre so naruttamo ",
  "bv18:5.3": "tadā navutikoṭīnaṃ ",
  "bv18:5.4": "tatiyābhisamayo ahu. ",
  "bv18:6.1": "sannipātā tayo āsuṃ ",
  "bv18:6.2": "siddhatthassa mahesino ",
  "bv18:6.3": "khīṇāsavānaṃ vimalānaṃ ",
  "bv18:6.4": "santacittāna tādinaṃ. ",
  "bv18:7.1": "koṭisatānaṃ navutiyā ",
  "bv18:7.2": "asītiyāpica koṭinaṃ ",
  "bv18:7.3": "ete āsuṃ tayo ṭhānā ",
  "bv18:7.4": "vimalānaṃ samāgame. ",
  "bv18:8.1": "ahan tena samayena ",
  "bv18:8.2": "maṅgalo nāma tāpaso ",
  "bv18:8.3": "uggatejo duppasaho ",
  "bv18:8.4": "abhiññābalasamāhito. ",
  "bv18:9.1": "jambuto phalamāhatvā ",
  "bv18:9.2": "siddhatthassa adāsahaṃ ",
  "bv18:9.3": "paṭiggahetvāna sambuddho ",
  "bv18:9.4": "idaṃ vacanamabravi. ",
  "bv18:10.1": "passatha imaṃ tāpasaṃ ",
  "bv18:10.2": "jaṭilaṃ uggatāpanaṃ ",
  "bv18:10.3": "catunavuti ito kappe ",
  "bv18:10.4": "ayaṃ buddho bhavissati. ",
  "bv18:11.1": "ahu kapilavhayā rammā nikkhamitvā tathāgato padhānaṃ padahitvāna ",
  "bv18:11.2": "katvā dukkarakārikaṃ. ajapāla rukkhamūlasmiṃ nisīditvā tathāgato tattha pāyāsaṃ paggayha nerañjaramupehiti. nerañjarāya tīramhi pāyāsaṃ adi so jino paṭiyatta varamaggena bodhimūlamhi ehiti. tato padakkhiṇaṃ katvā bodhimaṇḍaṃ anuttaraṃ assattha rukkhamūlamhi bujjhissati mahāyaso. imassa janikā mātā māyā nāma bhavissati pitā suddhodano nāma ayaṃ hessati gotamo. kolito upatisso ca aggā hessanti sāvakā anāsavā vītarāgā santacittā samāhitā ānando nāmupaṭṭhāko upaṭṭhissati maṃ jinaṃ. khemā uppalavaṇṇā ca aggā hessanti sāvikā anāsavā vītarāgā santacittā samāhitā. bodhi tassa bhagavato assatthoti pavuccati citto ca hatthāḷavako aggā hessantupaṭṭhakā. nandamātā ca uttarā aggā hessantupaṭṭhikā āyu vassa sataṃ tassa gotamassa yasassino. idaṃ sutvāna vacanaṃ asamassa mahesino āmoditā nara marū buddhavījaṅkuro ayaṃ. ukkuṭṭhi saddā vattanti apphoṭenti hasanti ca katañjalī namassanti dasasahassī sadevakā. yadi massa lokanāthassa virajjhissāma sāsanaṃ anāgatamhi addhāne hessāma sammukhā imaṃ. yathā manussā nadiṃ tarantā paṭititthaṃ virajjhiya heṭṭhā titthaṃ gahetvāna uttaranti mahānadiṃ. evameva mayaṃ sabbe yadi muñcāmi maṃ jinaṃ anāgatamhi addhāne ",
  "bv18:11.3": "hessāma sammukhā imaṃ. ",
  "bv18:12.1": "tassāpi vacanaṃ sutvā ",
  "bv18:12.2": "bhiyyo cittaṃ pasādayiṃ ",
  "bv18:12.3": "uttariṃ vattamadhiṭṭhāsiṃ dasa ",
  "bv18:12.4": "pāramipūriyā. ",
  "bv18:13.1": "vebhāraṃ nāma nagaraṃ ",
  "bv18:13.2": "udeno nāma khattiyo ",
  "bv18:13.3": "suphassā nāma janikā ",
  "bv18:13.4": "siddhatthassa mahesino. ",
  "bv18:14.1": "dasa vassa sahassāni ",
  "bv18:14.2": "agāraṃ ajjhāvasi so kokāsuppala ",
  "bv18:14.3": "kokanudā ",
  "bv18:14.4": "tayo pāsādamuttamā. ",
  "bv18:15.1": "tisoḷasa sahassāni ",
  "bv18:15.2": "nāriyo samalaṅkatā ",
  "bv18:15.3": "sumanā nāma sā nārī ",
  "bv18:15.4": "anupamo nāma atrajo. ",
  "bv18:16.1": "nimitte caturo disvā ",
  "bv18:16.2": "sivikāyābhinikkhami ",
  "bv18:16.3": "anūna dasamāsāni ",
  "bv18:16.4": "padhānaṃ padahī jino. ",
  "bv18:17.1": "brahmunā yācito santo ",
  "bv18:17.2": "siddhattho lokanāyako ",
  "bv18:17.3": "vattacakko mahāvīro ",
  "bv18:17.4": "migadāye naruttamo. ",
  "bv18:18.1": "sambalo ca sumitto ca ",
  "bv18:18.2": "ahesuṃ aggasāvakā ",
  "bv18:18.3": "revato nāmupaṭṭhāko ",
  "bv18:18.4": "siddhatthassa mahesino. ",
  "bv18:19.1": "sīvalā ca surāmā ca ",
  "bv18:19.2": "ahesuṃ aggasāvikā ",
  "bv18:19.3": "bodhi tassa bhagavato ",
  "bv18:19.4": "kaṇṇikāroti vuccati. ",
  "bv18:20.1": "suppiyo ca sambuddho ca ",
  "bv18:20.2": "ahesuṃ aggupaṭṭhakā ",
  "bv18:20.3": "rammā ceva surammā ca ",
  "bv18:20.4": "ahesuṃ aggupaṭṭhikā. ",
  "bv18:21.1": "so buddho saṭṭhiratanaṃ ",
  "bv18:21.2": "ahosi nabhamuggato ",
  "bv18:21.3": "kañcanagghika saṅkāso ",
  "bv18:21.4": "dasasahassī virocati. ",
  "bv18:22.1": "sopi buddho asamasamo ",
  "bv18:22.2": "atulo appaṭipuggalo ",
  "bv18:22.3": "vassa satasahassāni ",
  "bv18:22.4": "loke aṭṭhāsi cakkhumā. ",
  "bv18:23.1": "vipulappabhaṃ dassayitvā ",
  "bv18:23.2": "pupphāpetvāna sāvake ",
  "bv18:23.3": "vilāsetvā varasamāpattiyā ",
  "bv18:23.4": "nibbuto so sasāvako. ",
  "bv18:24.1": "siddhattho munivaro buddho ",
  "bv18:24.2": "anomārāmamhi nibbuto ",
  "bv18:24.3": "tattheva tassa thūpavaro ",
  "bv18:24.4": "catu ",
  "bv18:25.1": "yojanamuggatoti. siddhattha buddhavaṃso soḷasamo. "
}
