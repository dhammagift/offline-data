{
  "bv22:0.1": "",
  "bv22:0.2": "vīsatimo sikhibuddhavaṃso ",
  "bv22:1.1": "vipassissa aparena ",
  "bv22:1.2": "sambuddho dipaduttamo ",
  "bv22:1.3": "sikhivhayo nāma jino ",
  "bv22:1.4": "asamo appaṭipuggalo. ",
  "bv22:2.1": "mārasenaṃ pamadditvā ",
  "bv22:2.2": "patto sambodhimuttamaṃ ",
  "bv22:2.3": "dhammacakkaṃ pavattesi ",
  "bv22:2.4": "anukampāya pāṇinaṃ. ",
  "bv22:3.1": "dhammacakkaṃ pavattente ",
  "bv22:3.2": "sikhimhi jinapuṅgave ",
  "bv22:3.3": "koṭi satasahassānaṃ ",
  "bv22:3.4": "paṭhamābhisamayo ahu. ",
  "bv22:4.1": "aparaṃpi dhammaṃ desente ",
  "bv22:4.2": "gaṇaseṭṭhe naruttame ",
  "bv22:4.3": "navuti koṭisahassānaṃ ",
  "bv22:4.4": "dutiyābhisamayo ahu. ",
  "bv22:5.1": "yamakapāṭihāriyaṃ ",
  "bv22:5.2": "dassayante sadevake ",
  "bv22:5.3": "asīti koṭisahassānaṃ ",
  "bv22:5.4": "tatiyābhisamayo ahu. ",
  "bv22:6.1": "sannipātā tayo āsuṃ ",
  "bv22:6.2": "sikhissāpi mahesino ",
  "bv22:6.3": "khīṇāsavānaṃ vimalānaṃ ",
  "bv22:6.4": "santacittāna tādinaṃ. ",
  "bv22:7.1": "bhikkhu satasahassānaṃ ",
  "bv22:7.2": "paṭhamo āsi samāgamo ",
  "bv22:7.3": "asītibhikkhusahassānaṃ ",
  "bv22:7.4": "dutiyo āsi samāgamo. ",
  "bv22:8.1": "sattatibhikkhusahassānaṃ ",
  "bv22:8.2": "tatiyo āsi samāgamo ",
  "bv22:8.3": "anupalitto padumaṃva ",
  "bv22:8.4": "toyamhi sampavaḍḍhitaṃ. ",
  "bv22:9.1": "ahan tena samayena ",
  "bv22:9.2": "arindamo nāma khattiyo ",
  "bv22:9.3": "sambuddhappamukhaṃ saṅghaṃ ",
  "bv22:9.4": "anna pānena tappayiṃ. ",
  "bv22:10.1": "bahudussavaraṃ datvā ",
  "bv22:10.2": "dussakoṭiṃ anappakaṃ ",
  "bv22:10.3": "alaṅkataṃ hatthiyānaṃ ",
  "bv22:10.4": "sambuddhassa adāsahaṃ. ",
  "bv22:11.1": "hatthi yānaṃ nimminitvā ",
  "bv22:11.2": "kappiyaṃ upanāmayiṃ ",
  "bv22:11.3": "pūrayiṃ mānasaṃ mayhaṃ ",
  "bv22:11.4": "niccaṃ daḷhamupaṭṭhitaṃ. ",
  "bv22:12.1": "sopi maṃ buddho byākāsi ",
  "bv22:12.2": "sikhī lokagganāyako ",
  "bv22:12.3": "ekattiṃse ito kappe ",
  "bv22:12.4": "ayaṃ buddho bhavissati. ",
  "bv22:13.1": "ahu kapilavhayā rammā ",
  "bv22:13.2": "nikkhamitvā tathāgato padhānaṃ padahitvāna katvā dukkarakārikaṃ. ajapālarukkhamūlasmiṃ nisīditvā tathāgato tattha pāyāsaṃ paggayha nerañjaramupehiti. nerañjarāya tīramhi pāyāsaṃ adi so jino paṭiyatta varamaggena bodhimūlamhi ehiti. tato padakkhiṇaṃ katvā bodhimaṇḍaṃ anuttaraṃ assattha rukkhamūlamhi bujjhissati mahāyaso. imassa janikā mātā māyā nāma bhavissati pitā suddhodano nāma ayaṃ hessati gotamo. anāsavā vītarāgā santacittā samāhitā kolito upatisso ca aggā hessanti sāvakā ānando nāmupaṭṭhāko upaṭṭhissati maṃ jinaṃ. khemā uppalavaṇṇā ca aggā hessanti sāvikā anāsavā vītarāgā santacittā samāhitā. bodhi tassa bhagavato assatthoti pavuccati citto ca hatthāḷavako aggā hessantupaṭṭhakā. nandamātā ca uttarā aggā hessantupaṭṭhikā āyu vassa sataṃ tassa gotamassa yasassino. idaṃ sutvāna vacanaṃ asamassa mahesino āmoditā nara marū buddhavījaṅkuro ayaṃ. ukkuṭṭhi saddā vattanti apphoṭenti hasanti ca katañjalī namassanti dasasahassī sadevakā. yadi massa lokanāthassa virajjhissāma sāsanaṃ anāgatamhi addhāne ",
  "bv22:13.3": "hessāma sammukhā imaṃ. ",
  "bv22:14.1": "yathā manussā nadiṃ tarantā paṭititthaṃ virajjhiya heṭṭhā titthaṃ gahetvāna uttaranti mahānadiṃ. evameva mayaṃ sabbe yadi muñcāmi maṃ jinaṃ anāgatamhi addhāne hessāma sammukhā imaṃ. tassāpi vacanaṃ sutvā ",
  "bv22:14.2": "bhiyyo cittaṃ pasādayiṃ ",
  "bv22:14.3": "uttariṃ vattamadhiṭṭhāsiṃ dasa ",
  "bv22:14.4": "pāramipūriyā. ",
  "bv22:15.1": "nagaraṃ aruṇavatī nāma ",
  "bv22:15.2": "aruṇo nāma khattiyo ",
  "bv22:15.3": "pabhāvatī nāma janikā ",
  "bv22:15.4": "sikhissa ca mahesino. ",
  "bv22:16.1": "satta vassa sahassāni ",
  "bv22:16.2": "agāraṃ ajjhāvasi so suvaḍḍhako ",
  "bv22:16.3": "giri nārīvāhano ",
  "bv22:16.4": "tayo pāsāda muttamā. ",
  "bv22:17.1": "catuvīsati sahassāni ",
  "bv22:17.2": "nāriyo samalaṅkatā ",
  "bv22:17.3": "sabbakāmā nāma sā nārī ",
  "bv22:17.4": "atulo nāma atrajo. ",
  "bv22:18.1": "nimitte caturo disvā ",
  "bv22:18.2": "hatthi yānena nikkhamiṭa ",
  "bv22:18.3": "aṭṭhamāsaṃ padhānacāraṃ ",
  "bv22:18.4": "acari purisuttamo. ",
  "bv22:19.1": "brahmunā yācito santo ",
  "bv22:19.2": "sikhī lokagganāyako ",
  "bv22:19.3": "vattacakko mahāvīro ",
  "bv22:19.4": "migadāye naruttamo. ",
  "bv22:20.1": "abhibhū sambhavo nāma ",
  "bv22:20.2": "ahesuṃ aggasāvakā ",
  "bv22:20.3": "khemaṅkaro nāmupaṭṭhāko ",
  "bv22:20.4": "sikhissa ca mahesino. ",
  "bv22:21.1": "makhilā ca padumā ca ",
  "bv22:21.2": "ahesuṃ aggasāvikā ",
  "bv22:21.3": "bodhi tassa bhagavato ",
  "bv22:21.4": "puṇḍarīkoti vuccati. ",
  "bv22:22.1": "sirivaḍḍho ca nando ca ",
  "bv22:22.2": "ahesuṃ aggupaṭṭhakā ",
  "bv22:22.3": "cittā ceva sucittā ca ",
  "bv22:22.4": "ahesuṃ aggupaṭṭhikā. ",
  "bv22:23.1": "uccattanena so buddho ",
  "bv22:23.2": "sattatihatthamuggato ",
  "bv22:23.3": "kañcanagghika saṅkāso ",
  "bv22:23.4": "dvattiṃsa varalakkhaṇo. ",
  "bv22:24.1": "tassāpi byāmappabhā kāyā ",
  "bv22:24.2": "niccharanti nirantaraṃ ",
  "bv22:24.3": "disodisaṃ niccharanti ",
  "bv22:24.4": "tīṇi yojanāni so pabhā. ",
  "bv22:25.1": "sattati vassa sahassāni ",
  "bv22:25.2": "āyu tassa mahesino ",
  "bv22:25.3": "tāvatā tiṭṭhamāno so ",
  "bv22:25.4": "tāresi janataṃ bahuṃ. ",
  "bv22:26.1": "dhammameghaṃ vassitvāna ",
  "bv22:26.2": "temayitvā sadevake ",
  "bv22:26.3": "khemataṃ pāpayitvāna ",
  "bv22:26.4": "nibbuto so sasāvako. ",
  "bv22:27.1": "anubyañjana sampannaṃ ",
  "bv22:27.2": "dvattiṃsa varalakkhaṇaṃ ",
  "bv22:27.3": "sabbaṃ samantarahitaṃ ",
  "bv22:27.4": "nanu rittā sabbasaṅkhārāti. ",
  "bv22:28.1": "sikhī munivaro buddho ",
  "bv22:28.2": "assārāmamhi nibbuto ",
  "bv22:28.3": "tattheva tassa thūpavaro ",
  "bv22:28.4": "tīṇi ",
  "bv22:29.1": "yojanamuggatoti. sikhi buddhavaṃso vīsatimo. "
}
