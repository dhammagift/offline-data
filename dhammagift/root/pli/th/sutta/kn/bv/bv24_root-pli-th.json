{
  "bv24:0.1": "",
  "bv24:0.2": "dvāvīsatimo kukkusandha buddhavaṃso ",
  "bv24:1.1": "vessabhussa aparena ",
  "bv24:1.2": "sambuddho dipaduttamo ",
  "bv24:1.3": "kukkusandho nāma nāmena ",
  "bv24:1.4": "appameyyo durāsado. ",
  "bv24:2.1": "ugghāṭetvā sabbabhavaṃ ",
  "bv24:2.2": "cariyāya pāramiṅgato ",
  "bv24:2.3": "sīhova pañjaraṃ bhetvā ",
  "bv24:2.4": "patto sambodhimuttamaṃ. ",
  "bv24:3.1": "dhammacakkaṃ pavattente ",
  "bv24:3.2": "kukkusandhe lokanāyake ",
  "bv24:3.3": "cattāḷīsa koṭisahassānaṃ ",
  "bv24:3.4": "paṭhamābhisamayo ahu. ",
  "bv24:4.1": "antalikkhamhi ākāse ",
  "bv24:4.2": "yamakaṃ katvā vikubbanaṃ ",
  "bv24:4.3": "tiṃsa koṭisahassānaṃ ",
  "bv24:4.4": "bodhesi deva mānuse. ",
  "bv24:5.1": "naradevassa yakkhassa ",
  "bv24:5.2": "catusaccap pakāsane ",
  "bv24:5.3": "dhammābhisamayo tassa ",
  "bv24:5.4": "gaṇanāto asaṅkhiyo. ",
  "bv24:6.1": "kukkusandhassa bhagavato ",
  "bv24:6.2": "eko āsi samāgamo ",
  "bv24:6.3": "khīṇāsavānaṃ vimalānaṃ ",
  "bv24:6.4": "santacittāna tādinaṃ. ",
  "bv24:7.1": "cattāḷīsa sahassānaṃ ",
  "bv24:7.2": "tadā āsi samāgamo ",
  "bv24:7.3": "danta bhūmi ",
  "bv24:7.4": "manuppattānaṃ āsavādigaṇakkhayā. ",
  "bv24:8.1": "ahan tena samayena ",
  "bv24:8.2": "khemo nāmāsi khattiyo ",
  "bv24:8.3": "tathāgate jinaputte ",
  "bv24:8.4": "dānaṃ datvā anappakaṃ. ",
  "bv24:9.1": "pattañca cīvaraṃ datvā ",
  "bv24:9.2": "añjanaṃ madhulaṭṭhikaṃ ",
  "bv24:9.3": "imetaṃ patthitaṃ sabbaṃ ",
  "bv24:9.4": "paṭiyādemi varaṃ varaṃ. ",
  "bv24:10.1": "sopi maṃ muni byākāsi ",
  "bv24:10.2": "kukkusandho vināyako ",
  "bv24:10.3": "imamhi bhaddake kappe ",
  "bv24:10.4": "ayaṃ buddho bhavissati. ",
  "bv24:11.1": "ahu kapilavhayā rammā ",
  "bv24:11.2": "nikkhamitvā tathāgato padhānaṃ padahitvāna katvā dukkarakārikaṃ. ajapāla rukkhamūlasmiṃ nisīditvā tathāgato tattha pāyāsaṃ paggayha nerañjaramupehiti. nerañjarāya tīramhi pāyāsaṃ adi so jino paṭiyatta varamaggena bodhimūlamhi ehiti. tato padakkhiṇaṃ katvā bodhimaṇḍaṃ anuttaraṃ assattha rukkhamūlamhi bujjhissati mahāyaso. imassa janikā mātā māyā nāma bhavissati pitā suddhodano nāma ayaṃ hessati gotamo. kolito upatisso ca aggā hessanti sāvakā anāsavā vītarāgā santacittā samāhitā ānando nāmupaṭṭhāko upaṭṭhissati maṃ jinaṃ. khemā uppalavaṇṇā ca aggā hessanti sāvikā anāsavā vītarāgā santacittā samāhitā. bodhi tassa bhagavato assatthoti pavuccati citto ca hatthāḷavako aggā hessantupaṭṭhakā. nandamātā ca uttarā aggā hessantupaṭṭhikā āyu vassa sataṃ tassa gotamassa yasassino. idaṃ sutvāna vacanaṃ asamassa mahesino āmoditā nara marū buddhavījaṅkuro ayaṃ. ukkuṭṭhi saddā vattanti apphoṭenta hasanti ca katañjalī namassanti dasasahassī sadevakā. yadi massa lokanāthassa virajjhissāma sāsanaṃ anāgatamhi addhāne hessāma sammukhā imaṃ. yathā manussā nadiṃ tarantā paṭititthaṃ virajjhiya heṭṭhā titthaṃ gahetvāna uttaranti mahānadiṃ. evameva mayaṃ sabbe yadi muñcāmi maṃ jinaṃ anāgatamhi addhāne ",
  "bv24:11.3": "hessāma sammukhā imaṃ. ",
  "bv24:12.1": "tassāpi vacanaṃ sutvā ",
  "bv24:12.2": "bhiyyo cittaṃ pasādayiṃ ",
  "bv24:12.3": "uttariṃ vattamadhiṭṭhāsiṃ dasa ",
  "bv24:12.4": "pāramipūriyā. ",
  "bv24:13.1": "nagaraṃ khemavatī nāma ",
  "bv24:13.2": "khemo nāmāsahaṃ tadā ",
  "bv24:13.3": "sabbaññutaṃ gavesanto ",
  "bv24:13.4": "pabbajiṃ tassa santike. ",
  "bv24:14.1": "brāhmaṇo aggidatto ca ",
  "bv24:14.2": "āsi buddhassa so pitā ",
  "bv24:14.3": "visākhā nāma janikā ",
  "bv24:14.4": "kukkusandhassa mahesino. ",
  "bv24:15.1": "vasati tattha khemapure ",
  "bv24:15.2": "sambuddhassa mahākulaṃ ",
  "bv24:15.3": "narānaṃ pavaraṃ seṭṭhaṃ ",
  "bv24:15.4": "jātimantaṃ mahāyasaṃ. ",
  "bv24:16.1": "catuvassasahassāni ",
  "bv24:16.2": "agāraṃ ajjhāvasi so kāmavaḍḍha ",
  "bv24:16.3": "kāmasuddhirativaḍḍhano ",
  "bv24:16.4": "tayo pāsādamuttamā. ",
  "bv24:17.1": "samatiṃsa sahassāni ",
  "bv24:17.2": "nāriyo samalaṅkatā ",
  "bv24:17.3": "ropinī nāma sā nārī ",
  "bv24:17.4": "uttaro nāma atrajo. ",
  "bv24:18.1": "nimitte caturo disvā ",
  "bv24:18.2": "ratha yānena nikkhami ",
  "bv24:18.3": "anūnakaṃ aṭṭhamāsaṃ ",
  "bv24:18.4": "padhānaṃ padahī jino. ",
  "bv24:19.1": "brahmunā yācito santo ",
  "bv24:19.2": "kukkusandho lokanāyako ",
  "bv24:19.3": "vattacakko mahāvīro ",
  "bv24:19.4": "migadāye naruttamo. ",
  "bv24:20.1": "vidhuro sañjīva nāmo ca ",
  "bv24:20.2": "ahesuṃ aggasāvakā ",
  "bv24:20.3": "buddhijo nāmupaṭṭhāko ",
  "bv24:20.4": "kukkusandhassa mahesino. ",
  "bv24:21.1": "sāmā ca campa nāmā ca ",
  "bv24:21.2": "ahesuṃ aggasāvikā ",
  "bv24:21.3": "bodhi tassa bhagavato ",
  "bv24:21.4": "sirisoti pavuccati. ",
  "bv24:22.1": "accuggato ca sumano ",
  "bv24:22.2": "ahesuṃ aggupaṭṭhakā ",
  "bv24:22.3": "nandā ceva sunnadā ca ",
  "bv24:22.4": "ahesuṃ aggupaṭṭhikā. ",
  "bv24:23.1": "cattāḷīsaratanāni ",
  "bv24:23.2": "accuggato mahāmuni ",
  "bv24:23.3": "kanakap pabhā niccharati ",
  "bv24:23.4": "samantā dasayojanaṃ. ",
  "bv24:24.1": "cattāḷīsa vassa sahassāni ",
  "bv24:24.2": "āyu tassa mahesino ",
  "bv24:24.3": "tāvatā tiṭṭhamāno so ",
  "bv24:24.4": "tāresi janataṃ bahuṃ. ",
  "bv24:25.1": "dhammāpaṇaṃ pasāretvā ",
  "bv24:25.2": "nara nārīnaṃ sadevake ",
  "bv24:25.3": "naditvā sīhanādaṃva ",
  "bv24:25.4": "nibbuto so sasāvako. ",
  "bv24:26.1": "aṭṭhaṅga vacana sampanno ",
  "bv24:26.2": "acchiddāni nirantaraṃ ",
  "bv24:26.3": "sabbaṃ samantarahitaṃ ",
  "bv24:26.4": "nanu rittā sabbasaṅkhārāti. ",
  "bv24:27.1": "kukkusandho jinavaro ",
  "bv24:27.2": "khemārāmamhi nibbuto ",
  "bv24:27.3": "tattheva tassa thūpavaro ",
  "bv24:27.4": "gāvuta nabhamuggatoti. ",
  "bv24:28.1": "kukkusandha buddhavaṃso dvāvīsatimo. "
}
