{
  "bv17:0.1": "",
  "bv17:0.2": "paṇṇarasamo dhammadassi buddhavaṃso ",
  "bv17:1.1": "tattheva maṇḍakappamhi ",
  "bv17:1.2": "dhammadassī mahāyaso ",
  "bv17:1.3": "tamandhakāraṃ vidhamitvā ",
  "bv17:1.4": "atirocati sadevake. ",
  "bv17:2.1": "tassāpi atulatejassa ",
  "bv17:2.2": "dhammacakkappavattane ",
  "bv17:2.3": "koṭisatasahassānaṃ ",
  "bv17:2.4": "paṭhamābhisamayo ahu. ",
  "bv17:3.1": "yadā buddho dhammadassī ",
  "bv17:3.2": "vinesi sañjayaṃ isī ",
  "bv17:3.3": "tadā navutikoṭīnaṃ ",
  "bv17:3.4": "dutiyābhisamayo ahu. ",
  "bv17:4.1": "yadā sakko upagañchi ",
  "bv17:4.2": "sapariso vināyakaṃ ",
  "bv17:4.3": "tadā asītikoṭīnaṃ ",
  "bv17:4.4": "tatiyābhisamayo ahu. ",
  "bv17:5.1": "tassāpi devadevassa ",
  "bv17:5.2": "sannipātā tayo āsuṃ ",
  "bv17:5.3": "khīṇāsavānaṃ vimalānaṃ ",
  "bv17:5.4": "santacittāna tādinaṃ. pa ",
  "bv17:6.1": "yadā buddho dhammadassī ",
  "bv17:6.2": "saraṇe vassaṃ upāgami ",
  "bv17:6.3": "tadā koṭisahassānaṃ ",
  "bv17:6.4": "paṭhamo āsi samāgamo. ",
  "bv17:7.1": "punāparaṃ yadā buddho ",
  "bv17:7.2": "devato eti mānusaṃ ",
  "bv17:7.3": "tadāpi satakoṭīnaṃ ",
  "bv17:7.4": "dutiyo āsi samāgamo. ",
  "bv17:8.1": "punāparaṃ yadā buddho ",
  "bv17:8.2": "pakāsesi dhute guṇe ",
  "bv17:8.3": "tadā asītikoṭinaṃ ",
  "bv17:8.4": "tatiyo āsi samāgamo. ",
  "bv17:9.1": "ahan tena samayena ",
  "bv17:9.2": "sakko āsiṃ purindado ",
  "bv17:9.3": "dibbagandhena mālena turiyena ",
  "bv17:9.4": "abhipūjayiṃ. ",
  "bv17:10.1": "sopi maṃ tadā byākāsi ",
  "bv17:10.2": "devamajjhe nisīdiya ",
  "bv17:10.3": "aṭṭhārasa kappasate ",
  "bv17:10.4": "ayaṃ buddho bhavissati. ",
  "bv17:11.1": "ahu kapilavhayā rammā nikkhamitvā tathāgato padhānaṃ padahitvāna ",
  "bv17:11.2": "katvā dukkarakārikaṃ. ajapāla rukkhamūlasmiṃ nisīditvā tathāgato tattha pāyāsaṃ paggayha nerañjaramupehiti. nerañjarāya tīramhi pāyāsaṃ adi so jino paṭiyatta varamaggena bodhimūlamhi ehiti. tato padakkhiṇaṃ katvā bodhimaṇḍaṃ anuttaraṃ assattha rukkhamūlamhi bujjhissati mahāyaso. imassa janikā mātā māyā nāma bhavissati pitā suddhodano nāma ayaṃ hessati gotamo. kolito upatisso ca aggā hessanti sāvakā anāsavā vītarāgā santacittā samāhitā ānando nāmupaṭṭhāko upaṭṭhissati maṃ jinaṃ. khemā uppalavaṇṇā ca aggā hessanti sāvikā anāsavā vītarāgā santacittā samāhitā. bodhi tassa bhagavato assatthoti pavuccati citto ca hatthāḷavako aggā hessantupaṭṭhakā. nandamātā ca uttarā aggā hessantupaṭṭhikā āyu vassa sataṃ tassa gotamassa yasassino. idaṃ sutvāna vacanaṃ asamassa mahesino āmoditā nara marū buddhavījaṅkuro ayaṃ. ukkuṭṭhi saddā vattanti apphoṭenti hasanti ca katañjalī namassanti dasasahassī sadevakā. yadi massa lokanāthassa virajjhissāma sāsanaṃ anāgatamhi addhāne hessāma sammukhā imaṃ. yathā manussā nadiṃ tarantā paṭititthaṃ virajjhiya heṭṭhā titthaṃ gahetvāna uttaranti mahānadiṃ. evameva mayaṃ sabbe yadi muñcāmi maṃ jinaṃ anāgatamhi addhāne ",
  "bv17:11.3": "hessāma sammukhā imaṃ. ",
  "bv17:12.1": "tassāpi vacanaṃ sutvā ",
  "bv17:12.2": "bhiyyo cittaṃ pasādayiṃ ",
  "bv17:12.3": "uttariṃ vattamadhiṭṭhāsiṃ dasa ",
  "bv17:12.4": "pāramipūriyā. ",
  "bv17:13.1": "saraṇaṃ nāma nagaraṃ ",
  "bv17:13.2": "saraṇo nāma khattiyo ",
  "bv17:13.3": "sunandā nāma janikā ",
  "bv17:13.4": "dhammadassissa satthuno. ",
  "bv17:14.1": "aṭṭha vassa sahassāni ",
  "bv17:14.2": "agāraṃ ajjhāvasi so ",
  "bv17:14.3": "arajo virajo sudassano ",
  "bv17:14.4": "tayo pāsāda muttamā. ",
  "bv17:15.1": "cattāḷīsa sahassāni ",
  "bv17:15.2": "nāriyo samalaṅkatā ",
  "bv17:15.3": "vicikolī nāma nārī ",
  "bv17:15.4": "atrajo puññavaḍḍhano. ",
  "bv17:16.1": "nimitte caturo disvā ",
  "bv17:16.2": "pāsādenābhinikkhami ",
  "bv17:16.3": "sattāhaṃ padhānacāraṃ ",
  "bv17:16.4": "acari purisuttamo. ",
  "bv17:17.1": "brahmunā yācito santo ",
  "bv17:17.2": "dhammadassī narāsabho ",
  "bv17:17.3": "vattacakko mahāvīro ",
  "bv17:17.4": "migadāye naruttamo. ",
  "bv17:18.1": "padumo pussadevo ca ",
  "bv17:18.2": "ahesuṃ aggasāvakā ",
  "bv17:18.3": "sudatto nāmupaṭṭhāko ",
  "bv17:18.4": "dhammadassissa satthuno. ",
  "bv17:19.1": "khemā ca saccanāmā ca ",
  "bv17:19.2": "ahesuṃ aggasāvikā ",
  "bv17:19.3": "bodhi tassa bhagavato ",
  "bv17:19.4": "timbajāloti vuccati. ",
  "bv17:20.1": "subhaddo kaṭissaho ceva ",
  "bv17:20.2": "ahesuṃ aggupaṭṭhakā ",
  "bv17:20.3": "sāḷisā ca kaḷissā ca ",
  "bv17:20.4": "ahesuṃ aggupaṭṭhikā. ",
  "bv17:21.1": "sopi buddho asamasamo ",
  "bv17:21.2": "asīti hatthamuggato ",
  "bv17:21.3": "atirocati tejena ",
  "bv17:21.4": "dasasahassamhi dhātuyā. ",
  "bv17:22.1": "suphullo sālarājāva ",
  "bv17:22.2": "vijjuva gagane yathā ",
  "bv17:22.3": "majjhantikeva suriyo ",
  "bv17:22.4": "evaṃ so upasobhatha. ",
  "bv17:23.1": "tassāpi atulatejassa ",
  "bv17:23.2": "samakaṃ āsi jīvitaṃ ",
  "bv17:23.3": "vassa satasahassāni ",
  "bv17:23.4": "loke aṭṭhāsi cakkhumā. ",
  "bv17:24.1": "obhāsaṃ dassayitvāna ",
  "bv17:24.2": "vimalaṃ katvāna sāsanaṃ ",
  "bv17:24.3": "cavi candova gagane ",
  "bv17:24.4": "nibbuto so sasāvakoti. ",
  "bv17:25.1": "dhammadassī mahāvīro ",
  "bv17:25.2": "kesārāmamhi nibbuto ",
  "bv17:25.3": "tasseva so thūpavaro ",
  "bv17:25.4": "tīṇi ",
  "bv17:26.1": "yojanamuggatoti. dhammadassibuddhavaṃso paṇṇarasamo. "
}
