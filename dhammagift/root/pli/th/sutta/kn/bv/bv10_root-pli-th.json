{
  "bv10:0.1": "",
  "bv10:0.2": "aṭṭhamo paduma buddhavaṃso ",
  "bv10:1.1": "anomadassissa aparena ",
  "bv10:1.2": "sambuddho dipaduttamo ",
  "bv10:1.3": "padumo nāma nāmena ",
  "bv10:1.4": "asamo appaṭipuggalo. ",
  "bv10:2.1": "tassāpi asamaṃ sīlaṃ ",
  "bv10:2.2": "samādhipi anantako ",
  "bv10:2.3": "asaṅkheyyaṃ ñāṇavaraṃ ",
  "bv10:2.4": "vimuttipi anūpamā. ",
  "bv10:3.1": "tassāpi atulatejassa ",
  "bv10:3.2": "dhammacakkappavattane ",
  "bv10:3.3": "abhisamayā tayo āsuṃ ",
  "bv10:3.4": "mahātama pavāhanā. ",
  "bv10:4.1": "paṭhamābhisamaye buddho ",
  "bv10:4.2": "koṭisatamabodhayi ",
  "bv10:4.3": "dutiyābhisamaye dhīro ",
  "bv10:4.4": "navutikoṭimabodhayi. ",
  "bv10:5.1": "yadā ca padumo buddho ",
  "bv10:5.2": "ovadi sakamatrajaṃ ",
  "bv10:5.3": "tadā asītikoṭīnaṃ ",
  "bv10:5.4": "tatiyābhisamayo ahu. ",
  "bv10:6.1": "sannipātā tayo āsuṃ ",
  "bv10:6.2": "padumassa mahesino ",
  "bv10:6.3": "koṭi satasahassānaṃ ",
  "bv10:6.4": "paṭhamo āsi samāgamo. ",
  "bv10:7.1": "kaṭhinatthārasamaye ",
  "bv10:7.2": "uppanne kaṭhinacīvare ",
  "bv10:7.3": "dhammasenāpatitthāya ",
  "bv10:7.4": "bhikkhū sibbiṃsu cīvaraṃ. ",
  "bv10:8.1": "tadā te vimalā bhikkhū ",
  "bv10:8.2": "chaḷabhiññā mahiddhikā ",
  "bv10:8.3": "tīṇi satasahassāni ",
  "bv10:8.4": "samiṃsu aparājitā. ",
  "bv10:9.1": "punāparaṃ so naravusabho ",
  "bv10:9.2": "pavane vāsaṃ upāgami ",
  "bv10:9.3": "tadā samāgamo āsi ",
  "bv10:9.4": "dvinnaṃ satasahassānaṃ. ",
  "bv10:10.1": "ahan tena samayena ",
  "bv10:10.2": "sīho āsiṃ migābhibhū ",
  "bv10:10.3": "vivekamanubrūhantaṃ ",
  "bv10:10.4": "pavane addasaṃ jinaṃ. ",
  "bv10:11.1": "vanditvā sirasā pāde ",
  "bv10:11.2": "katvāna taṃ padakkhiṇaṃ ",
  "bv10:11.3": "tikkhattuṃ abhināditvā ",
  "bv10:11.4": "sattāhaṃ jinamupaṭṭhahiṃ. ",
  "bv10:12.1": "sattāhaṃ varasamāpattiyā ",
  "bv10:12.2": "vuṭṭhahitvā tathāgato ",
  "bv10:12.3": "manasā cintayitvāna ",
  "bv10:12.4": "koṭibhikkhū samānayi. ",
  "bv10:13.1": "tadāpi so mahāvīro ",
  "bv10:13.2": "tesaṃ majjhe viyākari ",
  "bv10:13.3": "aparimeyye ito kappe ",
  "bv10:13.4": "ayaṃ buddho bhavissati. ",
  "bv10:14.1": "ahu kapilavhayā rammā nikkhamitvā tathāgato padhānaṃ padahitvāna ",
  "bv10:14.2": "katvā dukkarakārikaṃ. ajapāla rukkhamūlasmiṃ nisīditvā tathāgato tattha pāyāsaṃ paggayha nerañjaramupehiti. nerañjarāya tīramhi pāyāsaṃ adi so jino paṭiyatta varamaggena bodhimūlamhi ehiti. tato padakkhiṇaṃ katvā bodhimaṇḍaṃ anuttaraṃ assattha rukkhamūlamhi bujjhissati mahāyaso. imassa janikā mātā māyā nāma bhavissati pitā suddhodano nāma ayaṃ hessati gotamo. anāsavā vītarāgā santacittā samāhitā kolito upatisso ca aggā hessanti sāvakā ānando nāmupaṭṭhāko upaṭṭhissati maṃ jinaṃ. khemā uppalavaṇṇā ca aggā hessanti sāvikā anāsavā vītarāgā santacittā samāhitā. bodhi tassa bhagavato assatthoti pavuccati citto ca hatthāḷavako akgā hessantupaṭṭhakā. nandamātā ca uttarā aggā hessantupaṭṭhikā āyu vassa sataṃ tassa gotamassa yasassino. idaṃ sutvāna vacanaṃ asamassa mahesino āmoditā nara marū buddhavījaṅkuro ayaṃ. ukkuṭṭhi saddā vattanti apphoṭenti hasanti ca katañjalī namassanti dasasahassī sadevakā. yadi massa lokanāthassa virajjhissāma sāsanaṃ anāgatamhi addhāne hessāma sammukhā imaṃ. yathā manussā nadiṃ tarantā paṭititthaṃ virajjhiya heṭṭhā titthaṃ gahetvāna uttaranti mahānadiṃ. evameva mayaṃ sabbe yadi muñcāmi maṃ jinaṃ anāgatamhi addhāne ",
  "bv10:14.3": "hessāma sammukhā imaṃ. ",
  "bv10:15.1": "tassāpi vacanaṃ sutvā ",
  "bv10:15.2": "bhiyyo cittaṃ pasādayiṃ ",
  "bv10:15.3": "uttariṃ vattamadhiṭṭhāsiṃ ",
  "bv10:15.4": "dasa pāramipūriyā. ",
  "bv10:16.1": "campakaṃ nāma nagaraṃ ",
  "bv10:16.2": "asamo nāma khattiyo ",
  "bv10:16.3": "asamā nāma janikā ",
  "bv10:16.4": "padumassa mahesino. ",
  "bv10:17.1": "dasa vassasahassāni ",
  "bv10:17.2": "agāraṃ ajjhāvasi so nando vasu ",
  "bv10:17.3": "yasattaro ",
  "bv10:17.4": "tayo pāsāda muttamā. ",
  "bv10:18.1": "tettiṃsa sahassāni ",
  "bv10:18.2": "nāriyo samalaṅkatā ",
  "bv10:18.3": "uttarā nāma sā nārī ",
  "bv10:18.4": "rammo nāmāsi atrajo. ",
  "bv10:19.1": "nimitte caturo disvā ",
  "bv10:19.2": "ratha yānena nikkhami ",
  "bv10:19.3": "anūna aṭṭhamāsāni ",
  "bv10:19.4": "padhānaṃ padahī jino. ",
  "bv10:20.1": "brahmunā yācito santo ",
  "bv10:20.2": "padumo lokanāyako ",
  "bv10:20.3": "vattacakko mahāvīro ",
  "bv10:20.4": "dhanañjuyyānamuttame. ",
  "bv10:21.1": "sālo ca upasālo ca ",
  "bv10:21.2": "ahesuṃ aggasāvakā ",
  "bv10:21.3": "varuṇo nāmupaṭṭhāko ",
  "bv10:21.4": "padumassa mahesino. ",
  "bv10:22.1": "rādhā ceva surādhā ca ",
  "bv10:22.2": "ahesuṃ aggasāvikā ",
  "bv10:22.3": "bodhi tassa bhagavato ",
  "bv10:22.4": "mahāsoṇoti vuccati. ",
  "bv10:23.1": "sabhiyo ceva asamo ca ",
  "bv10:23.2": "ahesuṃ aggupaṭṭhakā ",
  "bv10:23.3": "ruci ca nandimārā ca ",
  "bv10:23.4": "ahesuṃ aggupaṭṭhikā. ",
  "bv10:24.1": "aṭṭhapaṇṇāsa ratanaṃ ",
  "bv10:24.2": "accuggato mahāmuni ",
  "bv10:24.3": "pabhā niddhāvatī tassa ",
  "bv10:24.4": "asamā sabbato disā. ",
  "bv10:25.1": "candappabhā suriyappabhā ",
  "bv10:25.2": "ratanagghi maṇippabhā ",
  "bv10:25.3": "sabbāpi tā hatā honti ",
  "bv10:25.4": "patvā jinappabhuttamaṃ. ",
  "bv10:26.1": "vassa satasahassāni ",
  "bv10:26.2": "āyu vijjati tāvade ",
  "bv10:26.3": "tāvatā tiṭṭhamāno so ",
  "bv10:26.4": "tāresi janataṃ bahuṃ. ",
  "bv10:27.1": "paripakka mānase satte ",
  "bv10:27.2": "bodhayitvā asesato ",
  "bv10:27.3": "sesaññe anusāsetvā ",
  "bv10:27.4": "nibbuto so sasāvako. ",
  "bv10:28.1": "uragova tacaṃ jiṇṇaṃ ",
  "bv10:28.2": "vuḍḍha pattaṃva pādapo ",
  "bv10:28.3": "jahitvā sabbasaṅkhāre ",
  "bv10:28.4": "nibbuto so yathā sikhīti. ",
  "bv10:29.1": "padumo jinavaro satthā ",
  "bv10:29.2": "dhammārāmamhi nibbuto ",
  "bv10:29.3": "dhātu vitthārikaṃ āsi ",
  "bv10:29.4": "tesu tesu padesatoti. ",
  "bv10:30.1": "paduma buddhavaṃso aṭṭhamo. "
}
