{
  "bv20:0.1": "",
  "bv20:0.2": "aṭṭhārasamo pussa buddhavaṃso ",
  "bv20:1.1": "tattheva maṇḍakappamhi ",
  "bv20:1.2": "ahu satthā anuttaro ",
  "bv20:1.3": "anūpamo asamasamo ",
  "bv20:1.4": "pusso lokagganāyako. ",
  "bv20:2.1": "sopi sabbaṃ tamaṃ hantvā ",
  "bv20:2.2": "vijaṭetvā mahājaṭaṃ ",
  "bv20:2.3": "sadevakaṃ tappayanto ",
  "bv20:2.4": "abhivassi amatambunā. ",
  "bv20:3.1": "dhammacakkaṃ pavattente ",
  "bv20:3.2": "phusse nakkhattamaṅgale ",
  "bv20:3.3": "asīti satasahassānaṃ ",
  "bv20:3.4": "paṭhamābhisamayo ahu. ",
  "bv20:4.1": "navuti satasahassānaṃ ",
  "bv20:4.2": "dutiyābhisamayo ahu ",
  "bv20:4.3": "asīti satasahassānaṃ ",
  "bv20:4.4": "tatiyābhisamayo ahu. ",
  "bv20:5.1": "sannipātā tayo āsuṃ ",
  "bv20:5.2": "pussassa ca mahesino ",
  "bv20:5.3": "khīṇāsavānaṃ vimalānaṃ ",
  "bv20:5.4": "santacittāna tādinaṃ. ",
  "bv20:6.1": "saṭṭhisatasahassānaṃ ",
  "bv20:6.2": "paṭhamo āsi samāgamo ",
  "bv20:6.3": "paññāsa satasahassānaṃ ",
  "bv20:6.4": "dutiyā āsi samāgamo. ",
  "bv20:7.1": "cattāḷīsa satasahassānaṃ ",
  "bv20:7.2": "tatiyo āsi samāgamo ",
  "bv20:7.3": "anupādā vimuttānaṃ ",
  "bv20:7.4": "vocchinnapaṭisandhinaṃ. ",
  "bv20:8.1": "ahan tena samayena ",
  "bv20:8.2": "vijito nāma khattiyo ",
  "bv20:8.3": "chaḍḍayitvā mahārajjaṃ ",
  "bv20:8.4": "pabbajiṃ tassa santike. ",
  "bv20:9.1": "sopi maṃ buddho byākāsi ",
  "bv20:9.2": "pusso lokagganāyako ",
  "bv20:9.3": "dvenavute ito kappe ",
  "bv20:9.4": "ayaṃ buddho bhavissati. ",
  "bv20:10.1": "ahu kapilavhayā rammā nikkhamitvā tathāgato padhānaṃ padahitvāna ",
  "bv20:10.2": "katvā dukkarakārikaṃ. ajapāla rukkhamūlasmiṃ nisīditvā tathāgato tattha pāyāsaṃ paggayha nerañjaramupehiti. nerañjarāya tīramhi pāyāsaṃ adi so jino paṭiyatta varamaggena bodhimūlamhi ehiti. tato padakkhiṇaṃ katvā bodhimaṇḍaṃ anuttaraṃ assattha rukkhamūlamhi bujjhissati mahāyaso. imassa janikā mātā māyā nāma bhavissati pitā suddhodano nāma ayaṃ hessati gotamo. kolito upatisso ca aggā hessanti sāvakā anāsavā vītarāgā santacittā samāhitā ānando nāmupaṭṭhāko upaṭṭhissatimaṃ jinaṃ. khemā uppalavaṇṇā ca aggā hessanti sāvakā anāsavā vītarāgā santacittā samāhitā. bodhi tassa bhagavato assatthoti pavuccati citto ca hatthāḷavako aggā hessantupaṭṭhakā. nandamātā ca uttarā aggā hessantupaṭṭhikā āyu vassa sataṃ tassa gotamassa yasassino. idaṃ sutvāna vacanaṃ asamassa mahesino āmoditā naramarū buddhavījaṅkuro ayaṃ. ukkuṭṭhi saddā vattanti apphoṭenti hasanti ca katañjalī namassanti dasasahassī sadevakā. yadi massa lokanāthassa virajjhissāma sāsanaṃ anāgatamhi addhāne ",
  "bv20:10.3": "hessāma sammukhā imaṃ. ",
  "bv20:11.1": "tassāpi vacanaṃ sutvā ",
  "bv20:11.2": "bhiyyo cittaṃ pasādayiṃ ",
  "bv20:11.3": "uttariṃ vattamadhiṭṭhāsiṃ ",
  "bv20:11.4": "dasa pāramipūriyā. ",
  "bv20:12.1": "suttantaṃ vinayañcāpi ",
  "bv20:12.2": "navaṅga satthusāsanaṃ ",
  "bv20:12.3": "sabbaṃ pariyāpuṇitvāna ",
  "bv20:12.4": "sobhayiṃ jinasāsanaṃ. ",
  "bv20:13.1": "tattha ppamatto viharanto ",
  "bv20:13.2": "brahmaṃ bhāvetvā bhāvanaṃ ",
  "bv20:13.3": "abhiññāsu pāramiṃ gantvā ",
  "bv20:13.4": "brahmalokamagañchihaṃ. ",
  "bv20:14.1": "kāsikaṃ nāma nagaraṃ ",
  "bv20:14.2": "jayaseno nāma khattiyo ",
  "bv20:14.3": "sirimā nāma janikā ",
  "bv20:14.4": "pussassa ca mahesino. ",
  "bv20:15.1": "nava vassa sahassāni ",
  "bv20:15.2": "agāraṃ ajjhāvasi so garuḷa ",
  "bv20:15.3": "haṃsa suvaṇṇatārā ",
  "bv20:15.4": "tayo pāsāda muttamā. tevīsati ",
  "bv20:16.1": "sahassāni ",
  "bv20:16.2": "nāriyo samalaṅkatā ",
  "bv20:16.3": "kīsāgotamī nāma ānando ",
  "bv20:16.4": "nāma atrajo. ",
  "bv20:17.1": "nimitte caturo disvā ",
  "bv20:17.2": "hatthi yānena nikkhami ",
  "bv20:17.3": "sattāhaṃ padhānacāraṃ ",
  "bv20:17.4": "acari purisuttamo. ",
  "bv20:18.1": "brahmunā yācito santo ",
  "bv20:18.2": "pusso lokagganāyako ",
  "bv20:18.3": "vattacakko mahāvīro ",
  "bv20:18.4": "migadāye naruttamo. ",
  "bv20:19.1": "surakkhito dhammaseno ",
  "bv20:19.2": "ahesuṃ aggasāvakā ",
  "bv20:19.3": "sabhiyyo nāmupaṭṭhāko ",
  "bv20:19.4": "pussassa ca mahesino. ",
  "bv20:20.1": "cālā ca upacālā ca ",
  "bv20:20.2": "ahesuṃ aggasāvikā ",
  "bv20:20.3": "bodhi tassa bhagavato ",
  "bv20:20.4": "āmalakoti vuccati. ",
  "bv20:21.1": "anañjayo visākho ca ",
  "bv20:21.2": "ahesuṃ aggupaṭṭhakā ",
  "bv20:21.3": "padumā sirināgā ca ",
  "bv20:21.4": "ahesuṃ aggupaṭṭhikā. ",
  "bv20:22.1": "aṭṭhapaṇṇāsa ratanaṃ ",
  "bv20:22.2": "sopi accuggato muni ",
  "bv20:22.3": "sobhati sataraṃsīva ",
  "bv20:22.4": "uḷurājāva pūrito. ",
  "bv20:23.1": "navuti vassa sahassāni ",
  "bv20:23.2": "āyu vijjati tāvade ",
  "bv20:23.3": "tāvatā tiṭṭhamāno so ",
  "bv20:23.4": "tāresi janataṃ bahuṃ. ",
  "bv20:24.1": "ovaditvā bahū satte ",
  "bv20:24.2": "santāretvā bahū jane ",
  "bv20:24.3": "sopi satthā atulayaso ",
  "bv20:24.4": "nibbuto so sasāvako. ",
  "bv20:25.1": "pusso jinavaro satthā ",
  "bv20:25.2": "senārāmamhi nibbuto ",
  "bv20:25.3": "dhātuvitthārikaṃ āsi ",
  "bv20:25.4": "tesu tesu padesatoti. ",
  "bv20:26.1": "pussa buddhavaṃso aṭṭhārasamo. "
}
