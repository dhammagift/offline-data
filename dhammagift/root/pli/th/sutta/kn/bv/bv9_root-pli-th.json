{
  "bv9:0.1": "",
  "bv9:0.2": "sattamo anomadassi buddhavaṃso ",
  "bv9:1.1": "sobhitassa aparena ",
  "bv9:1.2": "sambuddho dipaduttamo ",
  "bv9:1.3": "anomadassī amitayaso ",
  "bv9:1.4": "tejasī duratikkamo. ",
  "bv9:2.1": "so chetvā bandhanaṃ sabbaṃ ",
  "bv9:2.2": "viddhaṃsetvā tayo bhave ",
  "bv9:2.3": "anivatti gamanaṃ maggaṃ ",
  "bv9:2.4": "desesi deva mānuse. ",
  "bv9:3.1": "sāgarova asaṅ khobbho ",
  "bv9:3.2": "pabbatova durāsado ",
  "bv9:3.3": "ākāsova ananto so ",
  "bv9:3.4": "sālarājāva phullito. ",
  "bv9:4.1": "dassanenapi taṃ buddhaṃ ",
  "bv9:4.2": "tositā honti pāṇino ",
  "bv9:4.3": "byāharantaṃ giraṃ sutvā ",
  "bv9:4.4": "amataṃ pāpuṇanti te. ",
  "bv9:5.1": "dhammābhisamayo tassa ",
  "bv9:5.2": "iddho phīto tadā ahu ",
  "bv9:5.3": "koṭisatāni abhisamiṃsu ",
  "bv9:5.4": "paṭhame dhammadesane. ",
  "bv9:6.1": "tato paraṃ abhisamaye ",
  "bv9:6.2": "vassante dhammavuṭṭhiyo ",
  "bv9:6.3": "asītikoṭī abhisamiṃsu ",
  "bv9:6.4": "dutiye dhammadesane. ",
  "bv9:7.1": "tato paraṃ hi vassante ",
  "bv9:7.2": "tappayanteva pāṇinaṃ ",
  "bv9:7.3": "aṭṭhasattati koṭīnaṃ ",
  "bv9:7.4": "tatiyābhisamayo ahu. ",
  "bv9:8.1": "sannipātā tayo āsuṃ ",
  "bv9:8.2": "tassāpi ca mahesino ",
  "bv9:8.3": "abhiññābala ppattānaṃ ",
  "bv9:8.4": "pupphitānaṃ vimuttiyā. ",
  "bv9:9.1": "aṭṭha satasahassānaṃ ",
  "bv9:9.2": "sannipātā tadā ahu ",
  "bv9:9.3": "pahīna mada mohānaṃ ",
  "bv9:9.4": "santacittāna tādinaṃ. ",
  "bv9:10.1": "satta satasahassānaṃ ",
  "bv9:10.2": "dutiyo āsi samāgamo ",
  "bv9:10.3": "anaṅgaṇānaṃ virajānaṃ ",
  "bv9:10.4": "upasantāna tādinaṃ. ",
  "bv9:11.1": "channaṃ satasahassānaṃ ",
  "bv9:11.2": "tatiyo āsi samāgamo ",
  "bv9:11.3": "abhiññābala ppattānaṃ ",
  "bv9:11.4": "nibbutānaṃ tapassinaṃ. ",
  "bv9:12.1": "ahan tena samayena ",
  "bv9:12.2": "yakkho āsiṃ mahiddhiko ",
  "bv9:12.3": "nekānaṃ yakkhakoṭīnaṃ ",
  "bv9:12.4": "vasavattimhi issaro. ",
  "bv9:13.1": "tadāpi taṃ buddhavaraṃ ",
  "bv9:13.2": "upagantvā mahesinaṃ ",
  "bv9:13.3": "anna pānena tappesiṃ ",
  "bv9:13.4": "sasaṅghaṃ lokanāyakaṃ. ",
  "bv9:14.1": "sopi maṃ tadā byākāsi ",
  "bv9:14.2": "visuddhanayano muni ",
  "bv9:14.3": "aparimeyye ito kappe ",
  "bv9:14.4": "ayaṃ buddho bhavissati. ",
  "bv9:15.1": "ahu kapilavhayā rammā nikkhamitvā tathāgato padhānaṃ padahitvāna ",
  "bv9:15.2": "katvā dukkarakārikaṃ. ajapāla rukkhamūlasmiṃ nisīditvā tathāgato tattha pāyāsaṃ paggayha nerañjaramupehiti. nerañjarāya tīramhi pāyāsaṃ adi so jino paṭiyatta varamaggena bodhimūlamhi ehiti. tato padakkhiṇaṃ katvā bodhimaṇḍaṃ anuttaraṃ assattha rukkhamūlamhi bujjhissati mahāyaso. imassa janikā mātā māyā nāma bhavissati pitā suddhodano nāma ayaṃ hessati gotamo. anāsavā vītarāgā santacittā samāhitā kolito upatisso ca aggā hessanti sāvakā ānando nāmupaṭṭhāko upaṭṭhissatimaṃ jinaṃ. khemā uppalavaṇṇā ca aggā hessanti sāvikā anāsavā vītarāgā santacittā samāhitā. bodhi tassa bhagavato assatthoti pavuccati citto ca hatthāḷavako aggā hessantupaṭṭhakā. nandamātā ca uttarā aggā hessantupaṭṭhikā āyu vassa sataṃ tassa gotamassa yasassino. idaṃ sutvāna vacanaṃ asamassa mahesino āmoditā nara marū buddhavījaṅkuro ayaṃ. ukkuṭṭhi saddā vattanti apphoṭenti hasanti ca katañjalī namassanti dasasahassī sadevakā. yadi massa lokanāthassa virajjhissāma sāsanaṃ anāgatamhi addhāne hessāma sammukhā imaṃ. yathā manussā nadiṃ tarantā paṭititthaṃ virajjhiya heṭṭhā titthaṃ gahetvāna uttaranti mahānadiṃ. evameva mayaṃ sabbe yadi muñcāmi maṃ jinaṃ anāgatamhi addhāne ",
  "bv9:15.3": "hessāma sammukhā imaṃ. ",
  "bv9:16.1": "tassāpi vacanaṃ sutvā ",
  "bv9:16.2": "tuṭṭho saṃviggamānaso ",
  "bv9:16.3": "uttariṃ vattamadhiṭṭhāsiṃ ",
  "bv9:16.4": "dasa pāramipūriyā. ",
  "bv9:17.1": "nagaraṃ candavatī nāma ",
  "bv9:17.2": "yasavā nāma khattiyo ",
  "bv9:17.3": "mātā yasodharā nāma ",
  "bv9:17.4": "anomadassissa satthuno. ",
  "bv9:18.1": "dasa vassa sahassāni ",
  "bv9:18.2": "agāraṃ ajjhāvasi so ",
  "bv9:18.3": "siri upasiri vaḍḍho ",
  "bv9:18.4": "tayo pāsāda muttamā. ",
  "bv9:19.1": "tevīsati sahassāni ",
  "bv9:19.2": "nāriyo samalaṅkatā ",
  "bv9:19.3": "sirimā nāma sā nārī ",
  "bv9:19.4": "upasālo nāma atrajo. ",
  "bv9:20.1": "nimitte caturo disvā ",
  "bv9:20.2": "sivikāyābhinikkhami ",
  "bv9:20.3": "anūna dasamāsāni ",
  "bv9:20.4": "padhānaṃ padahī jino. ",
  "bv9:21.1": "brahmunā yācito santo ",
  "bv9:21.2": "anomadassī mahāmuni ",
  "bv9:21.3": "vattacakko mahāvīro ",
  "bv9:21.4": "sudassanuyyānamuttame. ",
  "bv9:22.1": "nisabho ca anomo ca ",
  "bv9:22.2": "ahesuṃ aggasāvakā ",
  "bv9:22.3": "varuṇo nāmupaṭṭhāko ",
  "bv9:22.4": "anomadassissa satthuno. ",
  "bv9:23.1": "sundarā ca sumanā ca ",
  "bv9:23.2": "ahesuṃ aggasāvikā ",
  "bv9:23.3": "bodhi tassa bhagavato ",
  "bv9:23.4": "ajjunoti pavuccati. ",
  "bv9:24.1": "nandivaḍḍho sirivaḍḍho ",
  "bv9:24.2": "ahesuṃ aggupaṭṭhakā ",
  "bv9:24.3": "uplā ca padumā ca ",
  "bv9:24.4": "ahesuṃ aggupaṭṭhikā. ",
  "bv9:25.1": "aṭṭhapaṇṇāsa ratanaṃ ",
  "bv9:25.2": "accuggato mahāmuni ",
  "bv9:25.3": "pabhā niddhāvatī tassa ",
  "bv9:25.4": "sataraṃsīva uggato. ",
  "bv9:26.1": "vassa satasahassāni ",
  "bv9:26.2": "āyu vijjati tāvade ",
  "bv9:26.3": "tāvatā tiṭṭhamāno so ",
  "bv9:26.4": "tāresi janataṃ bahuṃ. ",
  "bv9:27.1": "supupphitaṃ pāvacanaṃ ",
  "bv9:27.2": "arahantehi tādihi ",
  "bv9:27.3": "vītarāgehi vimalehi ",
  "bv9:27.4": "sobhati jinasāsanaṃ. ",
  "bv9:28.1": "so ca satthā amitayaso ",
  "bv9:28.2": "yugāni tāni atuliyāni ",
  "bv9:28.3": "sabbaṃ samantarahitaṃ ",
  "bv9:28.4": "nanu rittā sabbasaṅkhārāti. ",
  "bv9:29.1": "anomadassī jino satthā ",
  "bv9:29.2": "dhammārāmamhi nibbuto ",
  "bv9:29.3": "tattheva tassa jinathūpo ",
  "bv9:29.4": "ubbedho pana ",
  "bv9:30.1": "vīsatīti. anomadassi buddhavaṃso sattamo. "
}
