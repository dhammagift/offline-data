{
  "bv8:0.1": "",
  "bv8:0.2": "chaṭṭho sobhita buddhavaṃso ",
  "bv8:1.1": "revatassa aparena ",
  "bv8:1.2": "sobhito nāma nāyako ",
  "bv8:1.3": "samāhito santacitto ",
  "bv8:1.4": "asamo appaṭipuggalo. ",
  "bv8:2.1": "so jino sakagehamhi ",
  "bv8:2.2": "mānasaṃ vinivattayi ",
  "bv8:2.3": "patvāna kevalaṃ bodhiṃ ",
  "bv8:2.4": "dhammacakkaṃ pavattayi. ",
  "bv8:3.1": "yāva uddhaṃ avīcito ",
  "bv8:3.2": "bhavaggā cāpi heṭṭhato ",
  "bv8:3.3": "etthantare ekaparisā ",
  "bv8:3.4": "ahosi dhammadesane. ",
  "bv8:4.1": "tāya parisāya sambuddho ",
  "bv8:4.2": "dhammacakkaṃ pavattayi ",
  "bv8:4.3": "gaṇanāya na vattabbo ",
  "bv8:4.4": "paṭhamābhisamayo ahu. ",
  "bv8:5.1": "tato paraṃpi desente ",
  "bv8:5.2": "nara marūnaṃ samāgame ",
  "bv8:5.3": "navuti koṭisahassānaṃ ",
  "bv8:5.4": "dutiyābhisamayo ahu. ",
  "bv8:6.1": "punāparaṃ rājaputto ",
  "bv8:6.2": "jayaseno nāma khattiyo ",
  "bv8:6.3": "ārāmaṃ ropayitvāna ",
  "bv8:6.4": "buddhe niyyādayī tadā. ",
  "bv8:7.1": "tassa yāgaṃ pakittento ",
  "bv8:7.2": "dhammaṃ deseti cakkhumā ",
  "bv8:7.3": "tadā koṭisahassānaṃ ",
  "bv8:7.4": "tatiyābhisamayo ahu. ",
  "bv8:8.1": "sannipātā tayo āsuṃ ",
  "bv8:8.2": "sobhitassa mahesino ",
  "bv8:8.3": "khīṇāsavānaṃ vimalānaṃ ",
  "bv8:8.4": "santacittāna tādinaṃ. ",
  "bv8:9.1": "uggato nāma so rājā ",
  "bv8:9.2": "dānaṃ deti naruttame ",
  "bv8:9.3": "tamhi dāne samāgañchuṃ ",
  "bv8:9.4": "arahantā satakoṭiyo. ",
  "bv8:10.1": "punāparaṃ pūga gaṇo dānaṃ ",
  "bv8:10.2": "deti naruttame ",
  "bv8:10.3": "tadā navuti koṭīnaṃ ",
  "bv8:10.4": "dutiyo āsi samāgamo. ",
  "bv8:11.1": "devaloke vasitvāna ",
  "bv8:11.2": "yadā orohatī jino ",
  "bv8:11.3": "tadā asīti koṭīnaṃ ",
  "bv8:11.4": "tatiyo āsi samāgamo. ",
  "bv8:12.1": "ahan tena samayena ",
  "bv8:12.2": "sujāto nāma brāhmaṇo ",
  "bv8:12.3": "tadā sasāvakaṃ buddhaṃ ",
  "bv8:12.4": "anna pānena tappayiṃ. ",
  "bv8:13.1": "sopi maṃ buddho byākāsi ",
  "bv8:13.2": "sobhito lokanāyako ",
  "bv8:13.3": "aparimeyye ito kappe ",
  "bv8:13.4": "ayaṃ buddho bhavissati. ",
  "bv8:14.1": "ahu kapilavhayā rammā nikkhamitvā tathāgato padhānaṃ padahitvāna ",
  "bv8:14.2": "katvā dukkarakārikaṃ. ajapāla rukkhamūlasmiṃ nisīditvā tathāgato tattha pāyāsaṃ paggayha nerañjaramupehiti. nerañjarāya tīramhi pāyāsaṃ adi so jino paṭiyatta varamaggena bodhimūlamhi ehiti. tato padakkhiṇaṃ katvā bodhimaṇḍaṃ anuttaraṃ assattha rukkhamūlamhi bujjhissati mahāyaso. imassa janikā mātā māyā nāma bhavissati pitā suddhodano nāma ayaṃ hessati gotamo. anāsavā vītarāgā santacittā samāhitā kolito upatisso ca aggā hessanti sāvakā ānando nāmupaṭṭhāko upaṭṭhissati maṃ jinaṃ. khemā uppalavaṇṇā ca aggā hessanti sāvikā anāsavā vītarāgā santacittā samāhitā. bodhi tassa bhagavato assatthoti pavuccati citto ca hatthāḷavako aggā hessantupaṭṭhakā. nandamātā ca uttarā aggā hessantupaṭṭhikā āyu vassa sataṃ tassa gotamassa yasassino. idaṃ sutvāna vacanaṃ asamassa mahesino āmoditā nara marū buddhavījaṅkuro ayaṃ. ukkuṭṭhi saddā vattanti apphoṭenti hasanti ca katañjalī namassanti dasasahassī sadevakā. yadi massa lokanāthassa virajjhissāma sāsanaṃ anāgatamhi addhāne hessāma sammukhā imaṃ. yathā manussā nadiṃ tarantā paṭititthaṃ virajjhiya heṭṭhā titthaṃ gahetvāna uttaranti mahānadiṃ. evameva mayaṃ sabbe yadi muñcāmimaṃ jinaṃ anāgatamhi addhāne ",
  "bv8:14.3": "hessāma sammukhā imaṃ. ",
  "bv8:15.1": "tassāpi vacanaṃ sutvā ",
  "bv8:15.2": "tuṭṭho saṃviggamānaso ",
  "bv8:15.3": "tamevatthamanupattiyā ",
  "bv8:15.4": "uggaṃ dhitimakāsahaṃ. ",
  "bv8:16.1": "sudhammaṃ nāma nagaraṃ ",
  "bv8:16.2": "sudhammo nāma khattiyo ",
  "bv8:16.3": "sudhammā nāma janikā ",
  "bv8:16.4": "sobhitassa mahesino. ",
  "bv8:17.1": "nava vassa sahassāni ",
  "bv8:17.2": "agāraṃ ajjhāvasi so ",
  "bv8:17.3": "kumudo naḷinī padumo ",
  "bv8:17.4": "tayo pāsādamuttamā. ",
  "bv8:18.1": "ticattāri sahassāni ",
  "bv8:18.2": "nāriyo samalaṅkatā ",
  "bv8:18.3": "makilā nāma sā nārī ",
  "bv8:18.4": "sīho nāmāsi atrajo. ",
  "bv8:19.1": "nimitte caturo disvā ",
  "bv8:19.2": "pāsādenābhinikkhami ",
  "bv8:19.3": "sattāhaṃ padhānacāraṃ ",
  "bv8:19.4": "caritvā purisuttamo. ",
  "bv8:20.1": "brahmunā yācito santo ",
  "bv8:20.2": "sobhito lokanāyako ",
  "bv8:20.3": "vattacakko mahāvīro ",
  "bv8:20.4": "sudhammuyyānamuttame. ",
  "bv8:21.1": "asamo ca sunetto ca ",
  "bv8:21.2": "ahesuṃ aggasāvakā ",
  "bv8:21.3": "anomo nāmupaṭṭhāko ",
  "bv8:21.4": "sobhitassa mahesino. ",
  "bv8:22.1": "nakulā ca sujātā ca ",
  "bv8:22.2": "ahesuṃ aggasāvikā ",
  "bv8:22.3": "bujjhamāno ca so buddho ",
  "bv8:22.4": "nāgamūle abujjhatha. ",
  "bv8:23.1": "rammo ceva sunetto ca ",
  "bv8:23.2": "ahesuṃ aggupaṭṭhakā ",
  "bv8:23.3": "nakulā ceva cittā ca ",
  "bv8:23.4": "ahesuṃ aggupaṭṭhikā. ",
  "bv8:24.1": "aṭṭhapaññāsa ratanaṃ ",
  "bv8:24.2": "accuggato mahāmuni ",
  "bv8:24.3": "obhāseti disā sabbā ",
  "bv8:24.4": "sataraṃsīva uggato. ",
  "bv8:25.1": "yathā suphullaṃ pavanaṃ ",
  "bv8:25.2": "nānāgandhehi dhūpitaṃ ",
  "bv8:25.3": "tatheva tassa pāvacanaṃ ",
  "bv8:25.4": "sīlagandhehi dhūpitaṃ. ",
  "bv8:26.1": "yathāpi sāgaro nāma ",
  "bv8:26.2": "dassanena atappiyo ",
  "bv8:26.3": "tatheva tassa pāvacanaṃ ",
  "bv8:26.4": "savanena atappiyaṃ. ",
  "bv8:27.1": "navuti vassa sahassāni ",
  "bv8:27.2": "āyu vijjati tāvade ",
  "bv8:27.3": "tāvatā tiṭṭhamāno so ",
  "bv8:27.4": "tāresi janataṃ bahuṃ. ",
  "bv8:28.1": "ovādaṃ anusiṭṭhiñca ",
  "bv8:28.2": "datvāna sesake jane ",
  "bv8:28.3": "hutāsanova tāpetvā ",
  "bv8:28.4": "nibbuto so sasāvako. ",
  "bv8:29.1": "so ca buddho asamasamo ",
  "bv8:29.2": "te ca sāvakā balappattā ",
  "bv8:29.3": "sabbaṃ samantarahitaṃ ",
  "bv8:29.4": "nanu rittā sabbasaṅkhārāti. ",
  "bv8:30.1": "sobhito varasambuddho ",
  "bv8:30.2": "sīhārāmamhi nibbuto ",
  "bv8:30.3": "dhātu vitthārikaṃ āsi ",
  "bv8:30.4": "tesu tesu padesatoti. ",
  "bv8:31.1": "sobhita buddhavaṃso chaṭṭho. "
}
