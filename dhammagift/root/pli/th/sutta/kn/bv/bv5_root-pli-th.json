{
  "bv5:0.1": "",
  "bv5:0.2": "tatiyo maṅgalabuddhavaṃso ",
  "bv5:1.1": "koṇḍaññassa aparena ",
  "bv5:1.2": "maṅgalo nāma nāyako ",
  "bv5:1.3": "tamaṃ loke nihantvāna ",
  "bv5:1.4": "dhammokkamabhidhārayi. ",
  "bv5:2.1": "atulāsi pabhā tassa ",
  "bv5:2.2": "jinehaññehi uttari canda ",
  "bv5:2.3": "suriyap pabhaṃ hantvā ",
  "bv5:2.4": "dasasahassī virocati. ",
  "bv5:3.1": "sopi buddho pakāsesi ",
  "bv5:3.2": "caturo saccavaruttame ",
  "bv5:3.3": "te te saccarasaṃ pitvā ",
  "bv5:3.4": "vinodenti mahātamaṃ. ",
  "bv5:4.1": "patvāna bodhimatulaṃ ",
  "bv5:4.2": "paṭhame dhammadesane ",
  "bv5:4.3": "koṭi satasahassānaṃ ",
  "bv5:4.4": "paṭhamābhisamayo ahu. ",
  "bv5:5.1": "surinda devabhavane ",
  "bv5:5.2": "buddho dhammamadesayi ",
  "bv5:5.3": "tadā koṭi ",
  "bv5:5.4": "satasahassānaṃ dutiyābhisamayo ahu. ",
  "bv5:6.1": "yadā sunando cakkavatti ",
  "bv5:6.2": "sambuddhamupasaṅkami ",
  "bv5:6.3": "tadā āhani sambuddho ",
  "bv5:6.4": "dhammabheriṃ varuttamaṃ. ",
  "bv5:7.1": "sunandassānucarā ca ",
  "bv5:7.2": "tadāsuṃ navuti koṭiyo ",
  "bv5:7.3": "sabbe te niravasesā ",
  "bv5:7.4": "ahesuṃ ehibhikkhukā. ",
  "bv5:8.1": "sannipātā tayo āsuṃ ",
  "bv5:8.2": "maṅgalassa mahesino ",
  "bv5:8.3": "koṭi satasahassānaṃ ",
  "bv5:8.4": "paṭhamo āsi samāgamo. koṭi satasahassānaṃ ",
  "bv5:9.1": "dutiyo āsi samāgamo tatiye navutikoṭīnaṃ ",
  "bv5:9.2": "tatiyo āsi samāgamo. ",
  "bv5:9.3": "khīṇāsavānaṃ vimalānaṃ ",
  "bv5:9.4": "tadā āsi samāgamo ",
  "bv5:10.1": "ahaṃ tena samayena ",
  "bv5:10.2": "suruci nāma brāhmaṇo. ",
  "bv5:10.3": "ajjhāyiko mantadharo ",
  "bv5:10.4": "tiṇṇaṃ vedāna pāragū ",
  "bv5:11.1": "tamahaṃ upasaṅkamiṃ ",
  "bv5:11.2": "saraṇaṃ gantvāna satthuno. ",
  "bv5:11.3": "sambuddhap pamukhaṃ saṅghaṃ ",
  "bv5:11.4": "gandha mālena pūjayiṃ ",
  "bv5:11.5": "pūjetvā gandha mālena ",
  "bv5:11.6": "gavapānena tappayiṃ. ",
  "bv5:12.1": "sopi maṃ buddho byākāsi ",
  "bv5:12.2": "maṅgalo dipaduttamo aparimeyye ",
  "bv5:12.3": "ito kappe ",
  "bv5:12.4": "ayaṃ buddho bhavissati. ",
  "bv5:13.1": "ahu kapilavhayā rammā nikkhamitvā tathāgato padhānaṃ padahitvāna ",
  "bv5:13.2": "katvā dukkarakārikaṃ. ajapāla rukkhamūlasmiṃ nisīditvā tathāgato tattha pāyāsaṃ paggayha nerañjaramupehiti. nerañjarāya tīramhi pāyāsaṃ adi so jino paṭiyatta varamaggena bodhimūlamhi ehiti. tato padakkhiṇaṃ katvā bodhimaṇḍaṃ anuttaraṃ assattha rukkhamūlamhi bujjhissati mahāyaso. imassa janikā mātā māyā nāma bhavissati pitā suddhodano nāma ayaṃ hessati gotamo. anāsavā vītarāgā santacittā samāhitā kolito upatisso ca aggā hessanti sāvakā ānando nāmupaṭṭhāko upaṭṭhissati maṃ jinaṃ. khemā uppalavaṇṇā ca aggā hessanti sāvikā anāsavā vītarāgā santacittā samāhitā. bodhi tassa bhagavato assatthoti pavuccati citto ca hatthāḷavako aggā hessantupaṭṭhakā. nandamātā ca uttarā aggā hessantupaṭṭhikā āyu vassa sataṃ tassa gotamassa yasassino. idaṃ sutvāna vacanaṃ asamassa mahesino āmoditā nara marū buddhavījaṅkuro ayaṃ. ukkuṭṭhi saddā vattanti apphoṭenti hasanti ca katañjalī namassanti dasasahassī sadevakā. yadi massa lokanāthassa virajjhissāma sāsanaṃ anāgatamhi addhāne hessāma sammukhā imaṃ. yathā manussā nadiṃ tarantā paṭititthaṃ virajjhiya heṭṭhā titthaṃ gahetvāna uttaranti mahānadiṃ. evameva mayaṃ sabbe yadi muñcāmi maṃ jinaṃ. anāgatamhi addhāne ",
  "bv5:13.3": "hessāma sammukhā imaṃ. ",
  "bv5:14.1": "tassāpi vacanaṃ sutvā ",
  "bv5:14.2": "bhiyyo cittaṃ pasādayiṃ ",
  "bv5:14.3": "uttariṃ vattamadhiṭṭhāsiṃ ",
  "bv5:14.4": "dasa pāramipūriyā. ",
  "bv5:15.1": "tadā pītiṃ nubrūhanto ",
  "bv5:15.2": "sambodhivarapattiyā ",
  "bv5:15.3": "buddhe datvāna maṃ gehaṃ ",
  "bv5:15.4": "pabbajiṃ tassa santike. ",
  "bv5:16.1": "suttantaṃ vinayañcāpi ",
  "bv5:16.2": "navaṅga satthusāsanaṃ ",
  "bv5:16.3": "sabbaṃ pariyāpuṇitvāna ",
  "bv5:16.4": "sobhayiṃ jinasāsanaṃ. ",
  "bv5:17.1": "tatthappamatto viharanto ",
  "bv5:17.2": "brahmaṃ bhāvetvā bhāvanaṃ ",
  "bv5:17.3": "abhiññāsu pāramiṃ gantvā ",
  "bv5:17.4": "brahmalokamagañchihaṃ. nagaraṃ ",
  "bv5:18.1": "uttaraṃ nāma ",
  "bv5:18.2": "uttaro nāma khattiyo ",
  "bv5:18.3": "uttarā nāma janikā ",
  "bv5:18.4": "maṅgalassa mahesino. ",
  "bv5:19.1": "nava vassa sahassāni ",
  "bv5:19.2": "agāraṃ ajjhāvasi so ",
  "bv5:19.3": "yasavā sucimā sirimā ",
  "bv5:19.4": "tayo pāsāda muttamā. ",
  "bv5:20.1": "samatiṃsa sahassāni ",
  "bv5:20.2": "nāriyo samalaṅkatā ",
  "bv5:20.3": "yasavatī nāma nārī ",
  "bv5:20.4": "sīvalo nāma atrajo. ",
  "bv5:21.1": "nimitte caturo disvā ",
  "bv5:21.2": "assa yānena nikkhami ",
  "bv5:21.3": "anūna aṭṭhamāsāni ",
  "bv5:21.4": "padhānaṃ padahī jino. ",
  "bv5:22.1": "brahmunā yācito santo ",
  "bv5:22.2": "maṅgalo lokanāyako ",
  "bv5:22.3": "vattacakko mahāvīro ",
  "bv5:22.4": "caresi dipaduttamo. ",
  "bv5:23.1": "sudevo dhammaseno ca ",
  "bv5:23.2": "ahesuṃ aggasāvakā ",
  "bv5:23.3": "pālito nāmupaṭṭhāko ",
  "bv5:23.4": "maṅgalassa mahesino. ",
  "bv5:24.1": "sīvalā ca asokā ca ",
  "bv5:24.2": "ahesuṃ aggasāvikā ",
  "bv5:24.3": "bodhi tassa bhagavato ",
  "bv5:24.4": "nāgarukkhoti vuccati. ",
  "bv5:25.1": "nando ceva visākho ca ",
  "bv5:25.2": "ahesuṃ aggupaṭṭhakā ",
  "bv5:25.3": "anuḷā ceva sumanā ca ",
  "bv5:25.4": "ahesuṃ aggupaṭṭhikā. ",
  "bv5:26.1": "aṭṭhāsītiratanāni ",
  "bv5:26.2": "accuggato mahāmuni ",
  "bv5:26.3": "tato niddhāvatī raṃsi ",
  "bv5:26.4": "aneka satasahassiyo. ",
  "bv5:27.1": "navuti vassa sahassāni ",
  "bv5:27.2": "āyu vijjati tāvade ",
  "bv5:27.3": "tāvatā tiṭṭhamāno so ",
  "bv5:27.4": "tāresi janataṃ bahuṃ. ",
  "bv5:28.1": "yathāpi sāgare ummi ",
  "bv5:28.2": "na sakkā te gaṇetuye ",
  "bv5:28.3": "tatheva sāvakā tassa ",
  "bv5:28.4": "na sakkā te gaṇetuye. ",
  "bv5:29.1": "yāva aṭṭhāsi sambuddho ",
  "bv5:29.2": "maṅgalo lokanāyako ",
  "bv5:29.3": "na tassa sāsane atthi ",
  "bv5:29.4": "sakilesa maraṇaṃ tadā. ",
  "bv5:30.1": "dhammokkaṃ dhārayitvāna ",
  "bv5:30.2": "santāretvā mahājanaṃ ",
  "bv5:30.3": "jalitvā dhumaketūva ",
  "bv5:30.4": "nibbuto so mahāyaso. ",
  "bv5:31.1": "saṅkhārānaṃ sabhāvattaṃ ",
  "bv5:31.2": "dassayitvā sadevake ",
  "bv5:31.3": "jalitvā aggi kkhandhova ",
  "bv5:31.4": "suriyo atthaṅgato yathā. ",
  "bv5:32.1": "uyyāne vessare nāma ",
  "bv5:32.2": "buddho nibbāyi maṅgalo ",
  "bv5:32.3": "tatthevassa jinathūpo ",
  "bv5:32.4": "tiṃsa yojanamuggatoti. ",
  "bv5:33.1": "maṅgalabuddhavaṃso tatiyo. "
}
