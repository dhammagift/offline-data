{
  "bv19:0.1": "",
  "bv19:0.2": "sattarasamo tissa buddhavaṃso ",
  "bv19:1.1": "siddhatthassa aparena ",
  "bv19:1.2": "asamo appaṭipuggalo ",
  "bv19:1.3": "anantasīlo amitayaso ",
  "bv19:1.4": "tisso lokagganāyako. ",
  "bv19:2.1": "tamandhakāraṃ vidhamitvā ",
  "bv19:2.2": "obhāsetvā sadevakaṃ ",
  "bv19:2.3": "anukampako mahāvīro ",
  "bv19:2.4": "loke uppajji cakkhumā. ",
  "bv19:3.1": "tassāpi atulā iddhi ",
  "bv19:3.2": "atulā sīlasamādhiyo ",
  "bv19:3.3": "sabbattha pāramiṃ gantvā ",
  "bv19:3.4": "dhammacakkaṃ pavattayi. ",
  "bv19:4.1": "so buddho dasasahassamhi ",
  "bv19:4.2": "viññāpesi giraṃ suciṃ ",
  "bv19:4.3": "koṭisatāni abhisamiṃsu ",
  "bv19:4.4": "paṭhame dhammadesane. ",
  "bv19:5.1": "dutiyo navutikoṭīnaṃ ",
  "bv19:5.2": "tatiye saṭṭhikoṭiyo ",
  "bv19:5.3": "bandhanāto pamocesi ",
  "bv19:5.4": "sampatte nara marū tadā. ",
  "bv19:6.1": "sannipātā tayo āsuṃ ",
  "bv19:6.2": "tissassa ca mahesino ",
  "bv19:6.3": "khīṇāsavānaṃ vimalānaṃ ",
  "bv19:6.4": "santacittāna tādinaṃ. ",
  "bv19:7.1": "khīṇāsavasatasahassānaṃ ",
  "bv19:7.2": "paṭhamo āsi samāgamo ",
  "bv19:7.3": "navuti satasahassānaṃ ",
  "bv19:7.4": "dutiyo āsi samāgamo. ",
  "bv19:8.1": "asīti satasahassānaṃ ",
  "bv19:8.2": "tatiyo āsi samāgamo ",
  "bv19:8.3": "khīṇāsavānaṃ vimalānaṃ ",
  "bv19:8.4": "pupphitānaṃ vimuttiyā. ",
  "bv19:9.1": "ahan tena samayena ",
  "bv19:9.2": "sujāto nāma khattiyo ",
  "bv19:9.3": "mahābhogaṃ chaḍḍayitvā ",
  "bv19:9.4": "pabbajiṃ isipabbajjaṃ. ",
  "bv19:10.1": "mayi pabbajite sante ",
  "bv19:10.2": "uppajji lokanāyako ",
  "bv19:10.3": "buddhoti saddaṃ sutvāna ",
  "bv19:10.4": "pīti me upapajjatha. ",
  "bv19:11.1": "dibbaṃ mandāravaṃ pupphaṃ ",
  "bv19:11.2": "padumaṃ pārichattakaṃ ",
  "bv19:11.3": "ubho hatthehi paggayha ",
  "bv19:11.4": "dhunamāno upāgamiṃ. ",
  "bv19:12.1": "pātuvaṇṇaparivutaṃ ",
  "bv19:12.2": "tissaṃ lokagganāyakaṃ ",
  "bv19:12.3": "tamahaṃ pupphaṃ gahetvāna ",
  "bv19:12.4": "matthake dhāraye jinaṃ. ",
  "bv19:13.1": "sopi maṃ tadā byākāsi ",
  "bv19:13.2": "janamajjhe nisīdiya ",
  "bv19:13.3": "dvānavute ito kappe ",
  "bv19:13.4": "ayaṃ buddho bhavissati. ",
  "bv19:14.1": "ahu kapilavhayā rammā nikkhamitvā tathāgato padhānaṃ padahitvāna ",
  "bv19:14.2": "katvā dukkarakārikaṃ. ajapāla rukkhamūlasmiṃ nisīditvā tathāgato tattha pāyāsaṃ paggayha nerañjaramupehiti. nerañjarāya tīramhi pāyāsaṃ adi so jino paṭiyatta varamaggena bodhimūlamhi ehiti. tato padakkhiṇaṃ katvā bodhimaṇḍaṃ anuttaraṃ assattha rukkhamūlamhi bujjhissati mahāyaso. imassa janikā mātā māyā nāma bhavissati pitā suddhodano nāma ayaṃ hessati gotamo. kolito upatisso ca aggā hessanti sāvakā anāsavā vītarāgā santacittā samāhitā ānando nāmupaṭṭhāko upaṭṭhissatimaṃ jinaṃ. khemā uppalavaṇṇā ca aggā hessanti sāvikā anāsavā vītarāgā santacittā samāhitā. bodhi tassa bhagavato assatthoti pavuccati citto ca hatthāḷavako aggā hessantupaṭṭhakā. nandamātā ca uttarā aggā hessantupaṭṭhikā āyu vassa sataṃ tassa gotamassa yasassino. idaṃ sutvāna vacanaṃ asamassa mahesino āmoditā nara marū buddhavījaṅkuro ayaṃ. ukkuṭṭhi saddā vattanti apphoṭenti hasanti ca katañjalī namassanti dasasahassī sadevakā. yadi massa lokanāthassa virajjhissāma sāsanaṃ anāgatamhi addhāne hessāma sammukhā imaṃ. yathā manussā nadiṃ tarantā paṭititthaṃ virajjhiya heṭṭhā titthaṃ gahetvāna uttaranti mahānadiṃ. evameva mayaṃ sabbe yadi muñcāmi maṃ jinaṃ anāgatamhi addhāne ",
  "bv19:14.3": "hessāma sammukhā imaṃ. ",
  "bv19:15.1": "tassāpi vacanaṃ sutvā ",
  "bv19:15.2": "bhiyyo cittaṃ pasādayiṃ ",
  "bv19:15.3": "uttariṃ vattamadhiṭṭhāsiṃ dasa ",
  "bv19:15.4": "pāramipūriyā. ",
  "bv19:16.1": "khemakaṃ nāma nagaraṃ ",
  "bv19:16.2": "janasando nāma khattiyo ",
  "bv19:16.3": "padumā nāma janikā ",
  "bv19:16.4": "tissassa ca mahesino. ",
  "bv19:17.1": "satta vassa sahassāni ",
  "bv19:17.2": "agāraṃ ajjhāvasi so guṇaselā ",
  "bv19:17.3": "nādiya nisabho ",
  "bv19:17.4": "tayo pāsāda muttamā. ",
  "bv19:18.1": "samatiṃsa sahassāni ",
  "bv19:18.2": "nāriyo samalaṅkatā ",
  "bv19:18.3": "subhaddā nāma sā nārī ",
  "bv19:18.4": "ānando nāma atrajo. ",
  "bv19:19.1": "nimitte caturo disvā ",
  "bv19:19.2": "assa yānena nikkhami ",
  "bv19:19.3": "anūnakaṃ aḍḍhamāsaṃ ",
  "bv19:19.4": "padhānaṃ padahī jino. ",
  "bv19:20.1": "brahmunā yācito santo ",
  "bv19:20.2": "tisso lokagganāyako ",
  "bv19:20.3": "vattacakko mahāvīro ",
  "bv19:20.4": "yasavatīdāyamuttame. ",
  "bv19:21.1": "brahmadevo ca udayo ca ",
  "bv19:21.2": "ahesuṃ aggasāvakā ",
  "bv19:21.3": "samago nāmupaṭṭhāko ",
  "bv19:21.4": "tissassa ca mahesino. ",
  "bv19:22.1": "phussā ceva sudattā ca ",
  "bv19:22.2": "ahesuṃ aggasāvikā ",
  "bv19:22.3": "bodhi tassa bhagavato ",
  "bv19:22.4": "asanoti pavuccati. ",
  "bv19:23.1": "sambalo ca siri ceva ",
  "bv19:23.2": "ahesuṃ aggupaṭṭhakā ",
  "bv19:23.3": "kīsāgotamī upasenā ",
  "bv19:23.4": "ahesuṃ aggupaṭṭhikā. ",
  "bv19:24.1": "sopi buddho saṭṭhiratano ",
  "bv19:24.2": "ahu uccattane jino ",
  "bv19:24.3": "anūpamo asadiso ",
  "bv19:24.4": "himavā viya dissati. ",
  "bv19:25.1": "tassāpi atulatejassa ",
  "bv19:25.2": "āyu āsi anuttaro ",
  "bv19:25.3": "vassa satasahassāni ",
  "bv19:25.4": "loke aṭṭhāsi cakkhumā. ",
  "bv19:26.1": "uttamaṃ pavaraṃ seṭṭhaṃ ",
  "bv19:26.2": "anubhotvā mahāyasaṃ ",
  "bv19:26.3": "jalitvā aggi kkhandhova ",
  "bv19:26.4": "nibbuto so sasāvako. ",
  "bv19:27.1": "valāhakova anilena ",
  "bv19:27.2": "suriyena viya ussavo ",
  "bv19:27.3": "andhakārova dīpena ",
  "bv19:27.4": "nibbuto so sasāvako. ",
  "bv19:28.1": "tisso jinavaro buddho ",
  "bv19:28.2": "nandārāmamhi nibbuto ",
  "bv19:28.3": "tattheva tassa jinathūpo ",
  "bv19:28.4": "tīṇi ",
  "bv19:29.1": "yojanasamussitoti. tissa buddhavaṃso sattarasamo. "
}
