{
  "bv23:0.1": "",
  "bv23:0.2": "ekavīsatimo vessabhū buddhavaṃso ",
  "bv23:1.1": "tattheva maṇḍakappamhi ",
  "bv23:1.2": "asamo appaṭipuggalo ",
  "bv23:1.3": "vessabhū nāma nāmena ",
  "bv23:1.4": "loke uppajji so jino. ",
  "bv23:2.1": "ādittaṃ ida rāgaggi ",
  "bv23:2.2": "taṇhānaṃ vijitaṃ jānaṃ ",
  "bv23:2.3": "nāgova bandhanaṃ chetvā ",
  "bv23:2.4": "patto sambodhimuttamaṃ. ",
  "bv23:3.1": "dhammacakkaṃ pavattesi vessabhū ",
  "bv23:3.2": "lokanāyako ",
  "bv23:3.3": "asīti koṭisahassānaṃ ",
  "bv23:3.4": "paṭhamābhisamayo ahu. ",
  "bv23:4.1": "pakkante cārikaṃ raṭṭhe ",
  "bv23:4.2": "lokajeṭṭhe narāsabhe ",
  "bv23:4.3": "sattati koṭisahassānaṃ ",
  "bv23:4.4": "dutiyābhisamayo ahu. ",
  "bv23:5.1": "mahādiṭṭhiṃ vinodento ",
  "bv23:5.2": "pāṭiheraṃ karoti so ",
  "bv23:5.3": "samāgatā nara marū ",
  "bv23:5.4": "dasasahassi sadevake. ",
  "bv23:6.1": "mahāacchariyaṃ disvā ",
  "bv23:6.2": "abbhūtaṃ lomahaṃsanaṃ ",
  "bv23:6.3": "devā ceva manussā ca ",
  "bv23:6.4": "bujjhare saṭṭhikoṭiyo. ",
  "bv23:7.1": "sannipātā tayo āsuṃ ",
  "bv23:7.2": "vessabhussa mahesino ",
  "bv23:7.3": "khīṇāsavānaṃ vimalānaṃ ",
  "bv23:7.4": "santacittāna tādinaṃ. ",
  "bv23:8.1": "asīti koṭisahassānaṃ ",
  "bv23:8.2": "paṭhamo āsi samāgamo ",
  "bv23:8.3": "sattati bhikkhusahassānaṃ ",
  "bv23:8.4": "dutiyo āsi samāgamo. ",
  "bv23:9.1": "saṭṭhi bhikkhusahassānaṃ ",
  "bv23:9.2": "tatiyo āsi samāgamo ",
  "bv23:9.3": "jarādi bhaya bhītānaṃ ",
  "bv23:9.4": "orasānaṃ mahesino. ",
  "bv23:10.1": "",
  "bv23:10.2": "",
  "bv23:10.3": "",
  "bv23:10.4": "",
  "bv23:10.5": "",
  "bv23:10.6": "",
  "bv23:11.1": "tassa buddhassa asamassa ",
  "bv23:11.2": "cakkaṃ vattitamuttamaṃ ",
  "bv23:11.3": "sutvāna paṇītaṃ dhammaṃ ",
  "bv23:11.4": "pabbajjamabhirocayi. ahan tena samayena sudassano nāma khattiyo anna pānena vatthena sasaṅghaṃ jinamapūjayiṃ. ",
  "bv23:12.1": "mahādānaṃ pavattetvā ",
  "bv23:12.2": "rattin divamatandito ",
  "bv23:12.3": "pabbajjaṃ guṇa sampannaṃ ",
  "bv23:12.4": "pabbajiṃ jinasantike. ",
  "bv23:13.1": "ācāra guṇa sampanno ",
  "bv23:13.2": "vatta sīla samāhito ",
  "bv23:13.3": "sabbaññutaṃ gavesanto ",
  "bv23:13.4": "ramāmi jinasāsane. ",
  "bv23:14.1": "saddhā pītiṃ uppādetvā ",
  "bv23:14.2": "buddhaṃ vandāmi sattharaṃ ",
  "bv23:14.3": "pīti uppajjati mayhaṃ ",
  "bv23:14.4": "bodhiyā yeva kāraṇā. ",
  "bv23:15.1": "anivatta mānasaṃ ñatvā ",
  "bv23:15.2": "sambuddho etadabravi ",
  "bv23:15.3": "ekattiṃse ito kappe ",
  "bv23:15.4": "ayaṃ buddho bhavissati. ",
  "bv23:16.1": "ahu kapilavhayā rammā ",
  "bv23:16.2": "nikkhamitvā tathāgato padhānaṃ padahitvāna katvā dukkarakārikaṃ. ajapāla rukkhamūlasmiṃ nisīditvā tathāgato tattha pāyāsaṃ paggayha nerañjaramupehiti. nerañjarāya tīramhi pāyāsaṃ adi so jino paṭiyatta varamaggena bodhimūlamhi ehiti. tato padakkhiṇaṃ katvā bodhimaṇḍaṃ anuttaraṃ assattha rukkhamūlamhi bujjhissati mahāyaso. imassa janikā mātā māyā nāma bhavissati pitā suddhodano nāma ayaṃ hessati gotamo. kolito upatisso ca aggā hessanti sāvakā anāsavā vītarāgā santacittā samāhitā ānando nāmupaṭṭhāko upaṭṭhissatimaṃ jinaṃ. khemā uppalavaṇṇā ca aggā hessanti sāvikā anāsavā vītarāgā santacittā samāhitā. bodhi tassa bhagavato assatthoti pavuccati citto ca hatthāḷavako aggā hessantupaṭṭhakā. nandamātā ca uttarā aggā hessantupaṭṭhikā āyu vassa sataṃ tassa gotamassa yasassino. idaṃ sutvāna vacanaṃ asamassa mahesino āmoditā nara marū buddhavījaṅkuro ayaṃ. ukkuṭṭhi saddā vattanti apphoṭenti hasanti ca katañjalī namassanti dasasahassī sadevakā. yadi massa lokanāthassa virajjhissāma sāsanaṃ anāgatamhi addhāne hessāma sammukhā imaṃ. yathā manussā nadiṃ tarantā paṭititthaṃ virajjhiya heṭṭhā titthaṃ gahetvāna uttaranti mahānadiṃ. evameva mayaṃ sabbe yadi muñcāmi maṃ jinaṃ anāgatamhi addhāne ",
  "bv23:16.3": "hessāma sammukhā imaṃ. ",
  "bv23:17.1": "tassāhaṃ vacanaṃ sutvā ",
  "bv23:17.2": "bhiyyo cittaṃ pasādayiṃ ",
  "bv23:17.3": "uttariṃ vattamadhiṭṭhāsiṃ ",
  "bv23:17.4": "dasa pāramipūriyā. ",
  "bv23:18.1": "anomaṃ nāma nagaraṃ ",
  "bv23:18.2": "suppatito nāma khattiyo ",
  "bv23:18.3": "mātā yasavatī nāma ",
  "bv23:18.4": "vessabhussa mahesino. ",
  "bv23:19.1": "chabbassa sahassāni ",
  "bv23:19.2": "agāraṃ ajjhāvasi so ",
  "bv23:19.3": "ruci surati vaḍḍhakā ",
  "bv23:19.4": "tayo pāsādamuttamā. ",
  "bv23:20.1": "anūna tiṃsa sahassāni ",
  "bv23:20.2": "nāriyo samalaṅkatā ",
  "bv23:20.3": "sucittā nāma sā nārī ",
  "bv23:20.4": "suppabuddho nāma atrajo. ",
  "bv23:21.1": "nimitte caturo disvā ",
  "bv23:21.2": "sivikāyābhinikkhami ",
  "bv23:21.3": "chamāsaṃ padhānacāraṃ ",
  "bv23:21.4": "acari purisuttamo. ",
  "bv23:22.1": "brahmunā yācito santo ",
  "bv23:22.2": "vessabhū lokanāyako ",
  "bv23:22.3": "vattacakko mahāvīro ",
  "bv23:22.4": "aruṇepi naruttamo. ",
  "bv23:23.1": "soṇo ca uttaro ceva ",
  "bv23:23.2": "ahesuṃ aggasāvakā ",
  "bv23:23.3": "upasanto nāmupaṭṭhāko ",
  "bv23:23.4": "vessabhussa mahesino. ",
  "bv23:24.1": "rāmā ceva samālā nāma ",
  "bv23:24.2": "ahesuṃ aggasāvikā ",
  "bv23:24.3": "bodhi tassa bhagavato ",
  "bv23:24.4": "mahāsāloti vuccati. ",
  "bv23:25.1": "sotthiko ceva rammo ca ",
  "bv23:25.2": "ahesuṃ aggupaṭṭhakā ",
  "bv23:25.3": "gotamī ca sirimā ca ",
  "bv23:25.4": "ahesuṃ aggupaṭṭhikā. ",
  "bv23:26.1": "saṭṭhi ratanamubbedho ",
  "bv23:26.2": "hemayūpasamūpamo ",
  "bv23:26.3": "kāyā niccharati raṃsi ",
  "bv23:26.4": "rattiṃva pabbate sikhī. ",
  "bv23:27.1": "saṭṭhi vassasahassāni ",
  "bv23:27.2": "āyu tassa mahesino ",
  "bv23:27.3": "tāvatā tiṭṭhamāno so ",
  "bv23:27.4": "tāresi janataṃ bahuṃ. ",
  "bv23:28.1": "dhammaṃ vitthārikaṃ katvā ",
  "bv23:28.2": "vibhajjitvā mahājanaṃ ",
  "bv23:28.3": "dhammanāvaṃ ṭhapetvāna ",
  "bv23:28.4": "nibbuto so sasāvako. ",
  "bv23:29.1": "dassaneyyaṃ sabbajanaṃ ",
  "bv23:29.2": "vihāraṃ iriyāpathaṃ ",
  "bv23:29.3": "sabbaṃ samantarahitaṃ ",
  "bv23:29.4": "nanu rittā sabbasaṅkhārāti. ",
  "bv23:30.1": "vessabhū jinavaro satthā ",
  "bv23:30.2": "khemārāmamhi nibbuto ",
  "bv23:30.3": "dhātuvitthārakaṃ āsi ",
  "bv23:30.4": "tesu tesu padesatoti. ",
  "bv23:31.1": "vessabhūbuddhavaṃso ekavīsatimo. "
}
