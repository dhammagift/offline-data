{
  "bv7:0.1": "",
  "bv7:0.2": "pañcamo revata buddhavaṃso ",
  "bv7:1.1": "sumanassa aparena ",
  "bv7:1.2": "revato nāma nāyako ",
  "bv7:1.3": "anupamo asadiso ",
  "bv7:1.4": "atulo uttamo jino. ",
  "bv7:2.1": "sopi dhammaṃ pakāsesi ",
  "bv7:2.2": "brahmunā abhiyācito ",
  "bv7:2.3": "khandha dhātu vavatthānaṃ ",
  "bv7:2.4": "appavattaṃ bhavābhave. ",
  "bv7:3.1": "tassābhisamayā tīṇi ",
  "bv7:3.2": "ahesuṃ dhammadesane ",
  "bv7:3.3": "gaṇanāya na vattabbo ",
  "bv7:3.4": "paṭhamābhisamayo ahu. ",
  "bv7:4.1": "yadā arindamaṃ rājaṃ ",
  "bv7:4.2": "vinesi revato muni ",
  "bv7:4.3": "tadā koṭisahassānaṃ ",
  "bv7:4.4": "dutiyābhisamayo ahu. ",
  "bv7:5.1": "sattāhaṃ paṭisallānā ",
  "bv7:5.2": "vuṭṭhahitvā narāsabho ",
  "bv7:5.3": "koṭisataṃ nara marūnaṃ ",
  "bv7:5.4": "vinesi uttame phale. ",
  "bv7:6.1": "sannipātā tayo āsuṃ ",
  "bv7:6.2": "revatassa mahesino ",
  "bv7:6.3": "khīṇāsavānaṃ vimalānaṃ ",
  "bv7:6.4": "suvimuttāna tādinaṃ. ",
  "bv7:7.1": "atikanta gaṇana pathā ",
  "bv7:7.2": "paṭhamā ye samāgatā ",
  "bv7:7.3": "koṭi satasahassānaṃ ",
  "bv7:7.4": "dutiyo āsi samāgamo. ",
  "bv7:8.1": "yo so paññāya asamo ",
  "bv7:8.2": "tassa cakkānuvattako ",
  "bv7:8.3": "so tadā byādhiko āsi ",
  "bv7:8.4": "patto jīvitasaṃsayaṃ. ",
  "bv7:9.1": "tassa gilāna pucchāya ",
  "bv7:9.2": "ye tadā upagatā muniṃ ",
  "bv7:9.3": "koṭi satasahassānaṃ ",
  "bv7:9.4": "tatiyo āsi samāgamo. ",
  "bv7:10.1": "ahaṃ tena samayena ",
  "bv7:10.2": "atidevo nāma brāhmaṇo ",
  "bv7:10.3": "upagantvā revataṃ buddhaṃ ",
  "bv7:10.4": "saraṇaṃ tassa gañchahaṃ. ",
  "bv7:11.1": "tassa sīlaṃ samādhiñca ",
  "bv7:11.2": "paññāguṇamanuttaraṃ ",
  "bv7:11.3": "thomayitvā yathāthāmaṃ ",
  "bv7:11.4": "uttariyaṃ adāsahaṃ. ",
  "bv7:12.1": "sopi maṃ buddho byākāsi ",
  "bv7:12.2": "revato lokanāyako ",
  "bv7:12.3": "aparimeyye ito kappe ",
  "bv7:12.4": "ayaṃ buddho bhavissati. ",
  "bv7:13.1": "ahu kapilavhayā rammā nikkhamitvā tathāgato padhānaṃ padahitvāna ",
  "bv7:13.2": "katvā dukkarakārikaṃ. ajapāla rukkhamūlasmiṃ nisīditvā tathāgato tattha pāyāsaṃ paggayha nerañjaramupehiti. nerañjarāya tīramhi pāyāsaṃ adi so jino paṭiyatta varamaggena bodhimūlamhi ehiti. tato padakkhiṇaṃ katvā bodhimaṇḍaṃ anuttaraṃ assattha rukkhamūlamhi bujjhissati mahāyaso. imassa janikā mātā māyā nāma bhavissati pitā suddhodano nāma ayaṃ hessati gotamo. anāsavā vītarāgā santacittā samāhitā kolito upatisso ca aggā hessanti sāvakā ānando nāmupaṭṭhāko upaṭṭhissatimaṃ jinaṃ. khemā uppalavaṇṇā ca aggā hessanti sāvikā anāsavā vītarāgā santacittā samāhitā. bodhi tassa bhagavato assatthoti pavuccati citto ca hatthāḷavako aggā hessantupaṭṭhakā. nandamātā ca uttarā aggā hessantupaṭṭhikā āyu vassa sataṃ tassa gotamassa yasassino. idaṃ sutvāna vacanaṃ asamassa mahesino āmoditā nara marū buddhavījaṅkuro ayaṃ. ukkuṭṭhi saddā vattanti apphoṭenti hasanti ca katañjalī namassanti dasasahassī sadevakā. yadi massa lokanāthassa virajjhissāma sāsanaṃ anāgatamhi addhāne hessāma sammukhā imaṃ. yathā manussā nadiṃ tarantā paṭititthaṃ virajjhiya heṭṭhā titthaṃ gahetvāna uttaranti mahānadiṃ. evameva mayaṃ sabbe yadi muñcāmi maṃ jinaṃ anāgatamhi addhāne ",
  "bv7:13.3": "hessāma sammukhā imaṃ. ",
  "bv7:14.1": "tassāpi vacanaṃ sutvā ",
  "bv7:14.2": "bhiyyo cittaṃ pasādayiṃ ",
  "bv7:14.3": "uttariṃ vattamadhiṭṭhāsiṃ dasa ",
  "bv7:14.4": "pāramipūriyā. ",
  "bv7:15.1": "tadāpi taṃ buddhadhammaṃ ",
  "bv7:15.2": "saritvā anubrūhayiṃ ",
  "bv7:15.3": "āharissāmi taṃ dhammaṃ ",
  "bv7:15.4": "yaṃ mayhaṃ abhipatthitaṃ. ",
  "bv7:16.1": "nagaraṃ sudhaññakaṃ nāma ",
  "bv7:16.2": "vipulo nāma khattiyo ",
  "bv7:16.3": "vipulā nāma janikā ",
  "bv7:16.4": "revatassa mahesino. ",
  "bv7:17.1": "chab bassasahassāni ",
  "bv7:17.2": "agāraṃ ajjhāvasi so ",
  "bv7:17.3": "sudassano ca ratanagghi ",
  "bv7:17.4": "āveḷo ca vibhūsito ",
  "bv7:17.5": "puñña kammā bhinibbattā ",
  "bv7:17.6": "tayo pāsāda muttamā. ",
  "bv7:18.1": "tettiṃsa satasahassāni ",
  "bv7:18.2": "nāriyo samalaṅkatā ",
  "bv7:18.3": "sudassanā nāma nārī ",
  "bv7:18.4": "varuṇo nāma atrajo. ",
  "bv7:19.1": "nimitte caturo disvā ",
  "bv7:19.2": "ratha yānena nikkhami ",
  "bv7:19.3": "anūna sattamāsāni ",
  "bv7:19.4": "padhānaṃ padahī jino. ",
  "bv7:20.1": "brahmunā yācito santo ",
  "bv7:20.2": "revato lokanāyako ",
  "bv7:20.3": "vattacakko mahāvīro ",
  "bv7:20.4": "varuṇārāme vasī jino. ",
  "bv7:21.1": "varuṇo brahmadevo ca ",
  "bv7:21.2": "ahesuṃ aggasāvakā ",
  "bv7:21.3": "sambhavo nāmupaṭṭhāko ",
  "bv7:21.4": "revatassa mahesino. ",
  "bv7:22.1": "bhaddā ceva subhaddā ca ",
  "bv7:22.2": "ahesuṃ aggasāvikā ",
  "bv7:22.3": "sopi buddho asamasamo ",
  "bv7:22.4": "nāgamūle abujjhatha. ",
  "bv7:23.1": "varuṇo ca sarabho ca ",
  "bv7:23.2": "ahesuṃ aggupaṭṭhakā ",
  "bv7:23.3": "pālā ca upapālā ca ",
  "bv7:23.4": "ahesuṃ aggupaṭṭhikā. ",
  "bv7:24.1": "uccattanena so buddho ",
  "bv7:24.2": "asīti hatthamuggato ",
  "bv7:24.3": "obhāsesi disā sabbā ",
  "bv7:24.4": "indaketuva uggato. ",
  "bv7:25.1": "tassa sarīre nibbattā ",
  "bv7:25.2": "pabhā mālā anuttarā ",
  "bv7:25.3": "divā vā yadivā rattiṃ ",
  "bv7:25.4": "samantā pharati yojanaṃ. ",
  "bv7:26.1": "saṭṭhi vassa sahassāni ",
  "bv7:26.2": "āyu vijjati tāvade ",
  "bv7:26.3": "tāvatā tiṭṭhamāno so ",
  "bv7:26.4": "tāresi janataṃ bahuṃ. ",
  "bv7:27.1": "dassayitvā buddhabalaṃ ",
  "bv7:27.2": "amataṃ loke pakāsayi ",
  "bv7:27.3": "nibbāsi anupādāno ",
  "bv7:27.4": "yathaggupādāna saṅkhayā. ",
  "bv7:28.1": "so ca kāyo ratananibho ",
  "bv7:28.2": "so ca dhammo asādiso ",
  "bv7:28.3": "sabbaṃ samantarahitaṃ ",
  "bv7:28.4": "nanu rittā sabbasaṅkhārāti. ",
  "bv7:29.1": "revato yasadharo buddho ",
  "bv7:29.2": "nibbuto so mahāpuñño ",
  "bv7:29.3": "dhātuvitthārikaṃ āsi ",
  "bv7:29.4": "tesu tesu padesatoti. ",
  "bv7:30.1": "revata buddhavaṃso pañcamo. "
}
