{
  "bv13:0.1": "",
  "bv13:0.2": "ekādasamo sumedha buddhavaṃso ",
  "bv13:1.1": "padumuttarassa aparena ",
  "bv13:1.2": "sumedho nāma nāyako ",
  "bv13:1.3": "durāsado uggatejo ",
  "bv13:1.4": "sabbalokuttamo jino. ",
  "bv13:2.1": "pasannanetto sumukho ",
  "bv13:2.2": "brahā uju patāpavā ",
  "bv13:2.3": "hitesī sabbasattānaṃ ",
  "bv13:2.4": "bahū mocesi bandhanā. ",
  "bv13:3.1": "yadā buddho pāpuṇitvā ",
  "bv13:3.2": "kevalaṃ bodhimuttamaṃ ",
  "bv13:3.3": "sudassanamhi nagare ",
  "bv13:3.4": "dhammacakkaṃ pavattayi. ",
  "bv13:4.1": "tassāpi abhisamayā tīṇi ",
  "bv13:4.2": "ahesuṃ dhammadesane ",
  "bv13:4.3": "koṭi satasahassānaṃ ",
  "bv13:4.4": "paṭhamābhisamayo ahu. ",
  "bv13:5.1": "punāparaṃ kumbhakaṇṇaṃ ",
  "bv13:5.2": "yakkhañca damayī jino ",
  "bv13:5.3": "navuti koṭisahassānaṃ ",
  "bv13:5.4": "dutiyābhisamayo ahu. ",
  "bv13:6.1": "punāparaṃ amitayaso ",
  "bv13:6.2": "catusaccaṃ pakāsayi ",
  "bv13:6.3": "asīti koṭisahassānaṃ ",
  "bv13:6.4": "tatiyābhisamayo ahu. ",
  "bv13:7.1": "sannipātā tayo āsuṃ ",
  "bv13:7.2": "sumedhassa mahesino ",
  "bv13:7.3": "khīṇāsavānaṃ vimalānaṃ ",
  "bv13:7.4": "santacittāna tādinaṃ. ",
  "bv13:8.1": "sudassanamhi nagare ",
  "bv13:8.2": "upagañchi jino yadā ",
  "bv13:8.3": "tadā khīṇāsavā bhikkhū ",
  "bv13:8.4": "samiṃsu satakoṭiyo. ",
  "bv13:9.1": "punāparaṃ devakūṭe ",
  "bv13:9.2": "bhikkhūnaṃ kaṭhinatthate ",
  "bv13:9.3": "tadā navutikoṭīnaṃ ",
  "bv13:9.4": "dutiyo āsi samāgamo. ",
  "bv13:10.1": "punāparaṃ dasabalo ",
  "bv13:10.2": "yadā carati cārikaṃ ",
  "bv13:10.3": "tadā asītikoṭīnaṃ ",
  "bv13:10.4": "tatiyo āsi samāgamo. ",
  "bv13:11.1": "ahan tena samayena ",
  "bv13:11.2": "uttaro nāma māṇavo ",
  "bv13:11.3": "asītikoṭiyo mayhaṃ ",
  "bv13:11.4": "ghare sanniccitaṃ dhanaṃ. ",
  "bv13:12.1": "kevalaṃ sabbaṃ datvāna ",
  "bv13:12.2": "sasaṅghe lokanāyake ",
  "bv13:12.3": "saraṇaṃ tassa upagañchiṃ ",
  "bv13:12.4": "pabbajjaṃ abhirocayiṃ. ",
  "bv13:13.1": "sopi maṃ tadā byākāsi ",
  "bv13:13.2": "karonto anumodanaṃ ",
  "bv13:13.3": "tiṃsa kappa sahassamhi ",
  "bv13:13.4": "ayaṃ buddho bhavissati. ",
  "bv13:14.1": "ahu kapilavhayā rammā nikkhamitvā tathāgato padhānaṃ padahitvāna ",
  "bv13:14.2": "katvā dukkarakārikaṃ. ajapāla rukkhamūlasmiṃ nisīditvā tathāgato tattha pāyāsaṃ paggayha nerañjaramupehiti. nerañjarāya tīramhi pāyāsaṃ adi so jino paṭiyatta varamaggena bodhimūlamhi ehiti. tato padakkhiṇaṃ katvā bodhimaṇḍaṃ anuttaraṃ assattha rukkhamūlamhi bujjhissati mahāyaso. imassa janikā mātā māyā nāma bhavissati pitā suddhodano nāma ayaṃ hessati gotamo. anāsavā vītarāgā santacittā samāhitā kolito upatisso ca aggā hessanti sāvakā ānando nāmupaṭṭhāko upaṭṭhissati maṃ jinaṃ. khemā uppalavaṇṇā ca aggā hessanti sāvikā anāsavā vītarāgā santacittā samāhitā. bodhi tassa bhagavato assat thoti pavuccati citto ca hatthāḷavako aggā hessantupaṭṭhakā. nandamātā ca uttarā aggā hessantupaṭṭhikā āyu vassa sataṃ tassa gotamassa yasassino. idaṃ sutvāna vacanaṃ asamassa mahesino āmoditā nara marū buddhavījaṅkuro ayaṃ. ukkuṭṭhi saddā vattanti apphoṭenti hasanti ca katañjalī namassanti dasasahassī sadevakā. yadi massa lokanāthassa virajjhissāma sāsanaṃ anāgatamhi addhāne hessāma sammukhā imaṃ. yathā manussā nadiṃ tarantā paṭititthaṃ virajjhiya heṭṭhā titthaṃ gahetvāna uttaranti mahānadiṃ. evameva mayaṃ sabbe yadi muñcāmi maṃ jinaṃ anāgatamhi addhāne ",
  "bv13:14.3": "hessāma sammukhā imaṃ. ",
  "bv13:15.1": "tassāpi vacanaṃ sutvā ",
  "bv13:15.2": "bhiyyo cittaṃ pasādayiṃ ",
  "bv13:15.3": "uttariṃ vattamadhiṭṭhāsī ",
  "bv13:15.4": "dasapāramipūriyā. ",
  "bv13:16.1": "suttantaṃ vinayañcāpi ",
  "bv13:16.2": "navaṅga satthusāsanaṃ ",
  "bv13:16.3": "sabbaṃ pariyāpuṇitvāna ",
  "bv13:16.4": "sobhayiṃ jinasāsanaṃ. ",
  "bv13:17.1": "tattha ppamatto viharanto ",
  "bv13:17.2": "nisajjaṭ ṭhāna ",
  "bv13:17.3": "caṅkame abhiññāpāramiṃ patvā ",
  "bv13:17.4": "brahmalokamagañchihaṃ. ",
  "bv13:18.1": "sudassanaṃ nāma nagaraṃ ",
  "bv13:18.2": "sudatto nāma khattiyo ",
  "bv13:18.3": "sudattā nāma janikā ",
  "bv13:18.4": "sumedhassa mahesino. ",
  "bv13:19.1": "nava vassa sahassāni ",
  "bv13:19.2": "agāraṃ ajjhāvasi so sucando kañcano ",
  "bv13:19.3": "sirivaḍḍho ",
  "bv13:19.4": "tayo pāsāda muttamā. ",
  "bv13:20.1": "tisoḷasa sahassāni ",
  "bv13:20.2": "nāriyo samalaṅkatā ",
  "bv13:20.3": "sumanā nāma sā nārī ",
  "bv13:20.4": "punabbo nāma atrajo. ",
  "bv13:21.1": "nimitte caturo disvā ",
  "bv13:21.2": "hatthiyānena nikkhami ",
  "bv13:21.3": "anūnakaṃ aṭṭhamāsaṃ ",
  "bv13:21.4": "padhānaṃ padahī jino. ",
  "bv13:22.1": "brahmunā yācito santo ",
  "bv13:22.2": "sumedho lokanāyako ",
  "bv13:22.3": "vattacakko mahāvīro ",
  "bv13:22.4": "sudassanuyyānamuttame. ",
  "bv13:23.1": "saraṇo ca sabbakāmo ca ",
  "bv13:23.2": "ahesuṃ aggasāvakā ",
  "bv13:23.3": "sāgaro nāmupaṭṭhāko ",
  "bv13:23.4": "sumedhassa mahesino. ",
  "bv13:24.1": "rāmā ceva surāmā ca ",
  "bv13:24.2": "ahesuṃ aggasāvikā ",
  "bv13:24.3": "bodhi tassa bhagavato ",
  "bv13:24.4": "nimbarukkhoti pavuccati. ",
  "bv13:25.1": "uruvelā ceva yasavā ca ",
  "bv13:25.2": "ahesuṃ aggupaṭṭhakā ",
  "bv13:25.3": "yasā nāma sirivā ca ",
  "bv13:25.4": "ahesuṃ aggupaṭṭhikā. ",
  "bv13:26.1": "aṭṭhāsīti ratanāni ",
  "bv13:26.2": "accuggato mahāmuni ",
  "bv13:26.3": "obhāseti disā sabbā ",
  "bv13:26.4": "cando tāragaṇe yathā. ",
  "bv13:27.1": "cakkavattimaṇi nāma ",
  "bv13:27.2": "yathā tapati yojanaṃ ",
  "bv13:27.3": "tatheva tassa ratanaṃ ",
  "bv13:27.4": "samantā pharati yojanaṃ. ",
  "bv13:28.1": "navuti vassa sahassāni ",
  "bv13:28.2": "āyu vijjati tāvade ",
  "bv13:28.3": "tāvatā tiṭṭhamāno so ",
  "bv13:28.4": "tāresi janataṃ bahuṃ. ",
  "bv13:29.1": "tevijjā chaḷabhiññāhi ",
  "bv13:29.2": "balappattehi tādihi ",
  "bv13:29.3": "samākulamidaṃ āsi ",
  "bv13:29.4": "arahantehi sāsanaṃ. ",
  "bv13:30.1": "tepi sabbe amitayasā ",
  "bv13:30.2": "vippamuttā nirūpadhī ",
  "bv13:30.3": "ñāṇālokaṃ dassayitvā ",
  "bv13:30.4": "nibbutā te mahāyasā. ",
  "bv13:31.1": "sumedho jinavaro buddho ",
  "bv13:31.2": "medhārāmamhi nibbuto ",
  "bv13:31.3": "dhātu vitthārikaṃ āsi ",
  "bv13:31.4": "tesu tesu padesatoti. ",
  "bv13:32.1": "sumedha buddhavaṃso ekādasamo. "
}
