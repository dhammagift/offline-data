{
  "bv14:0.1": "",
  "bv14:0.2": "dvādasamo sujāta buddhavaṃso ",
  "bv14:1.1": "tattheva maṇḍakappamhi ",
  "bv14:1.2": "sujāto nāma nāyako ",
  "bv14:1.3": "sīhahanu usabhakkhandho ",
  "bv14:1.4": "appameyyo durāsado. ",
  "bv14:2.1": "candova vimalo suddho ",
  "bv14:2.2": "sataraṃsīva patāpavā ",
  "bv14:2.3": "evaṃ sobhati sambuddho ",
  "bv14:2.4": "jalanto siriyā sadā. ",
  "bv14:3.1": "pāpuṇitvāna sambuddho ",
  "bv14:3.2": "kevalaṃ bodhimuttamaṃ ",
  "bv14:3.3": "sumaṅgalamhi nagare ",
  "bv14:3.4": "dhammacakkaṃ pavattayi. ",
  "bv14:4.1": "desento pavaraṃ dhammaṃ ",
  "bv14:4.2": "sujāto lokanāyako ",
  "bv14:4.3": "asītikoṭī abhisamiṃsuṃ ",
  "bv14:4.4": "paṭhame dhammadesane. ",
  "bv14:5.1": "yadā sujāto amitayaso ",
  "bv14:5.2": "deve vassamupāgami sattattiṃsa ",
  "bv14:5.3": "satasahassānaṃ ",
  "bv14:5.4": "dutiyābhisamayo ahu. ",
  "bv14:6.1": "yadā sujāto asamo upagañchi ",
  "bv14:6.2": "pitu santikaṃ saṭṭhi ",
  "bv14:6.3": "satasahassānaṃ ",
  "bv14:6.4": "tatiyābhisamayo ahu. ",
  "bv14:7.1": "sannipātā tayo āsuṃ ",
  "bv14:7.2": "sujātassa mahesino ",
  "bv14:7.3": "khīṇāsavānaṃ vimalānaṃ ",
  "bv14:7.4": "santacittāna tādinaṃ. ",
  "bv14:8.1": "abhiññābalap pattānaṃ ",
  "bv14:8.2": "appattānaṃ bhavābhave ",
  "bv14:8.3": "saṭṭhi satasahassāni ",
  "bv14:8.4": "paṭhamaṃ sannipatiṃsu te. ",
  "bv14:9.1": "punāparaṃ sannipāte ",
  "bv14:9.2": "tidivorohaṇe jine ",
  "bv14:9.3": "paññāsa satasahassānaṃ ",
  "bv14:9.4": "dutiyo āsi samāgamo. ",
  "bv14:10.1": "upasaṅkamma naravusabhaṃ ",
  "bv14:10.2": "tassa yo aggasāvako ",
  "bv14:10.3": "catūhi satasahassehi ",
  "bv14:10.4": "sambuddhaṃ upasaṅkami. ",
  "bv14:11.1": "ahan tena samayena ",
  "bv14:11.2": "catudīpamhi issaro ",
  "bv14:11.3": "antalikkhacaro āsiṃ ",
  "bv14:11.4": "cakkavatti mahabbalo. ",
  "bv14:12.1": "",
  "bv14:12.2": "",
  "bv14:12.3": "",
  "bv14:12.4": "",
  "bv14:13.1": "catudīpe mahārajjaṃ ",
  "bv14:13.2": "ratane satta uttame ",
  "bv14:13.3": "buddhe niyyādayitvāna ",
  "bv14:13.4": "pabbajiṃ tassa santike. ",
  "bv14:14.1": "ārāmikā janapade ",
  "bv14:14.2": "uṭṭhānaṃ paṭipiṇḍiya ",
  "bv14:14.3": "upanenti bhikkhusaṅghassa ",
  "bv14:14.4": "paccayaṃ sayanāsanaṃ. ",
  "bv14:15.1": "sopi maṃ tadā byākāsi ",
  "bv14:15.2": "dasasahassamhi issaro ",
  "bv14:15.3": "tiṃsa kappa sahassānaṃ ",
  "bv14:15.4": "ayaṃ buddho bhavissati. ",
  "bv14:16.1": "ahu kapilavhayā rammā nikkhamitvā tathāgato padhānaṃ padahitvāna ",
  "bv14:16.2": "katvā dukkarakārikaṃ. ajapāla rukkhamūlasmiṃ nisīditvā tathāgato tattha pāyāsaṃ paggayha nerañjaramupehiti. nerañjarāya tīramhi pāyāsaṃ adi so jino paṭiyatta varamaggena bodhimūlamhi ehiti. tato padakkhiṇaṃ katvā bodhimaṇḍaṃ anuttaraṃ assattha rukkhamūlamhi bujjhissati mahāyaso. imassa janikā mātā māyā nāma bhavissati pitā suddhodano nāma ayaṃ hessati gotamo. anāsavā vītarāgā santacittā samāhitā kolito upatisso ca aggā hessanti sāvakā ānando nāmupaṭṭhāko upaṭṭhissatimaṃ jinaṃ. khemā uppalavaṇṇā ca aggā hessanti sāvikā anāsavā vītarāgā santacittā samāhitā. bodhi tassa bhagavato assatthoti pavuccati citto ca hatthāḷavako aggā hessantupaṭṭhakā. nandamātā ca uttarā aggā hessantupaṭṭhikā āyu vassa sataṃ tassa gotamassa yasassino. idaṃ sutvāna vacanaṃ asamassa mahesino āmoditā nara marū buddhavījaṅkuro ayaṃ. ukkuṭṭhi saddā vattanti apphoṭenti hasanti ca katañjalī namassanti dasasahassī sadevakā. yadi massa lokanāthassa virajjhissāma sāsanaṃ anāgatamhi addhāne hessāma sammukhā imaṃ. yathā manussā nadiṃ tarantā paṭititthaṃ virajjhiya heṭṭhā titthaṃ gahetvāna uttaranti mahānadiṃ. evameva mayaṃ sabbe yadi muñcāmi maṃ jinaṃ anāgatamhi addhāne ",
  "bv14:16.3": "hessāma sammukhā imaṃ. ",
  "bv14:17.1": "tassāpi vacanaṃ sutvā ",
  "bv14:17.2": "bhiyyo hāsaṃ jane ahaṃ ",
  "bv14:17.3": "adhiṭṭhahiṃ vattaṃ uggaṃ ",
  "bv14:17.4": "dasa pāramipūriyā. ",
  "bv14:18.1": "suttantaṃ vinayañcāpi ",
  "bv14:18.2": "navaṅga satthusāsanaṃ ",
  "bv14:18.3": "sabbaṃ pariyāpuṇitvāna ",
  "bv14:18.4": "sobhayiṃ jinasāsanaṃ. ",
  "bv14:19.1": "tattha ppamatto viharanto ",
  "bv14:19.2": "brahmaṃ bhāvetvā bhāvanaṃ ",
  "bv14:19.3": "abhiññāsu pāramiṃ gantvā ",
  "bv14:19.4": "brahmalokamagañchihaṃ. ",
  "bv14:20.1": "sumaṅgalaṃ nāma nagaraṃ ",
  "bv14:20.2": "uggato nāma khattiyo ",
  "bv14:20.3": "mātā pabhāvatī nāma ",
  "bv14:20.4": "sujātassa mahesino. ",
  "bv14:21.1": "nava vassa sahassāni ",
  "bv14:21.2": "agāraṃ ajjhāvasi so ",
  "bv14:21.3": "siri upasiri cando ",
  "bv14:21.4": "tayo pāsādamuttamā. ",
  "bv14:22.1": "tevīsati sahassāni ",
  "bv14:22.2": "nāriyo samalaṅkatā ",
  "bv14:22.3": "sirinandā nāma nārī ",
  "bv14:22.4": "upaseno nāma atrajo. ",
  "bv14:23.1": "nimitte caturo disvā ",
  "bv14:23.2": "assa yānena nikkhami ",
  "bv14:23.3": "anūna navamāsāni ",
  "bv14:23.4": "padhānaṃ padahī jino. ",
  "bv14:24.1": "brahmunā yācito santo ",
  "bv14:24.2": "sujāto lokanāyako ",
  "bv14:24.3": "vattacakko mahāvīro ",
  "bv14:24.4": "sumaṅgaluyyānamuttame. ",
  "bv14:25.1": "sudassano sudevo ca ",
  "bv14:25.2": "ahesuṃ aggasāvakā ",
  "bv14:25.3": "nārado nāmupaṭṭhāko ",
  "bv14:25.4": "sujātassa mahesino. ",
  "bv14:26.1": "nāgā nāgasamānā ca ",
  "bv14:26.2": "ahesuṃ aggasāvikā ",
  "bv14:26.3": "bodhi tassa bhagavato ",
  "bv14:26.4": "mahāveḷūti vuccati. ",
  "bv14:27.1": "so ca rukkho ghanakkhandho ",
  "bv14:27.2": "acchiddo hoti pattiko ",
  "bv14:27.3": "uju vaṃso brahā hoti ",
  "bv14:27.4": "dassaneyyo manoramo. ",
  "bv14:28.1": "ekakkhandho pavaḍḍhitvā ",
  "bv14:28.2": "tato sākhā ca bhijjati ",
  "bv14:28.3": "yathā subandho morahattho ",
  "bv14:28.4": "evaṃ sobhati so dumo. ",
  "bv14:29.1": "na tassa kaṇṭhakā honti ",
  "bv14:29.2": "nāpi chiddaṃ mahā ahu ",
  "bv14:29.3": "vitiṇṇasākho aviraḷo ",
  "bv14:29.4": "sandacchāyo manoramo. ",
  "bv14:30.1": "sudatto ceva citto ca ",
  "bv14:30.2": "ahesuṃ aggupaṭṭhakā ",
  "bv14:30.3": "subhaddā ceva padumā ca ",
  "bv14:30.4": "ahesuṃ aggupaṭṭhikā. ",
  "bv14:31.1": "paññāsa ratano āsi ",
  "bv14:31.2": "uccattanena so jino ",
  "bv14:31.3": "sabbākāravarūpeto ",
  "bv14:31.4": "sabbaguṇamupāgato. ",
  "bv14:32.1": "tassa pabhā asamasamā ",
  "bv14:32.2": "niddhāvati samantato ",
  "bv14:32.3": "appamāṇo atuliyo ",
  "bv14:32.4": "upamehi anūpamo. ",
  "bv14:33.1": "navutivassa sahassāni ",
  "bv14:33.2": "āyu vijjati tāvade ",
  "bv14:33.3": "tāvatā tiṭṭhamāno so ",
  "bv14:33.4": "tāresi janataṃ bahuṃ. ",
  "bv14:34.1": "yathāpi sāgare ummi ",
  "bv14:34.2": "gagane tārakā yathā ",
  "bv14:34.3": "evaṃ tadā pāvacanaṃ ",
  "bv14:34.4": "arahantehi cittakaṃ. [tevijjā chaḷabhiññāhi balappattehi tādihi samākulamidaṃ āsi arahantehi tādibhi]. ",
  "bv14:35.1": "so ca buddho asamasamo ",
  "bv14:35.2": "guṇāni ca tāni atuliyāni ",
  "bv14:35.3": "sabbaṃ samantarahitaṃ ",
  "bv14:35.4": "nanu rittā sabbasaṅkhārāti. ",
  "bv14:36.1": "sujāto jinavaro buddho ",
  "bv14:36.2": "selārāmamhi nibbuto ",
  "bv14:36.3": "tattheva cetiyo ",
  "bv14:36.4": "satthu tīṇi ",
  "bv14:37.1": "gāvutamuggatoti. sujāta buddhavaṃso dvādasamo. "
}
