{
  "bv16:0.1": "",
  "bv16:0.2": "cuddasamo atthadassi buddhavaṃso ",
  "bv16:1.1": "tattheva maṇḍakappamhi ",
  "bv16:1.2": "atthadassī mahāyaso ",
  "bv16:1.3": "mahātamaṃ nihantvāna ",
  "bv16:1.4": "patto sambodhimuttamaṃ. ",
  "bv16:2.1": "brahmunā yācito santo ",
  "bv16:2.2": "dhammacakkaṃ pavattayi ",
  "bv16:2.3": "amatena tappayī lokaṃ ",
  "bv16:2.4": "dasasahassī sadevakā. ",
  "bv16:3.1": "tassāpi lokanāthassa ",
  "bv16:3.2": "ahesuṃ abhisamayā tayo ",
  "bv16:3.3": "koṭi satasahassānaṃ ",
  "bv16:3.4": "paṭhamābhisamayo ahu. ",
  "bv16:4.1": "yadā buddho atthadassī ",
  "bv16:4.2": "carati devacārikaṃ ",
  "bv16:4.3": "koṭi satasahassānaṃ ",
  "bv16:4.4": "dutiyābhisamayo ahu. ",
  "bv16:5.1": "punāparaṃ yadā buddho ",
  "bv16:5.2": "desesi pitu santike ",
  "bv16:5.3": "koṭi satasahassānaṃ ",
  "bv16:5.4": "tatiyābhisamayo ahu. ",
  "bv16:6.1": "sannipātā tayo āsuṃ ",
  "bv16:6.2": "tassāpi ca mahesino ",
  "bv16:6.3": "khīṇāsavānaṃ vimalānaṃ ",
  "bv16:6.4": "santacittāna tādinaṃ. ",
  "bv16:7.1": "aṭṭhanavuti sahassānaṃ ",
  "bv16:7.2": "paṭhamo āsi samāgamo ",
  "bv16:7.3": "aṭṭhāsīti sahassānaṃ ",
  "bv16:7.4": "dutiyo āsi samāgamo. ",
  "bv16:8.1": "aṭṭhasattati sahassānaṃ ",
  "bv16:8.2": "tatiyo āsi samāgamo ",
  "bv16:8.3": "anupādāvimuttānaṃ ",
  "bv16:8.4": "vimalānaṃ mahesinaṃ. ",
  "bv16:9.1": "ahan tena samayena ",
  "bv16:9.2": "jaṭilo uggatāpano ",
  "bv16:9.3": "susimo nāma nāmena ",
  "bv16:9.4": "mahiyā seṭṭhasammato. ",
  "bv16:10.1": "dibbaṃ mandāravaṃ pupphaṃ ",
  "bv16:10.2": "padumaṃ pārichattakaṃ ",
  "bv16:10.3": "devalokā āharitvā ",
  "bv16:10.4": "sambuddhaṃ abhipūjayiṃ. ",
  "bv16:11.1": "sopi maṃ buddho byākāsi ",
  "bv16:11.2": "atthadassī mahāmuni ",
  "bv16:11.3": "aṭṭhārase kappasate ",
  "bv16:11.4": "ayaṃ buddho bhavissati. ",
  "bv16:12.1": "ahu kapilavhayā rammā nikkhamitvā tathāgato padhānaṃ padahitvāna ",
  "bv16:12.2": "katvā dukkarakārikaṃ. ajapāla rukkhamūlasmiṃ nisīditvā tathāgato tattha pāyāsaṃ paggayha nerañjaramupehiti. nerañjarāya tīramhi pāyāsaṃ adi so jino paṭiyatta varamaggena bodhimūlamhi ehiti. tato padakkhiṇaṃ katvā bodhimaṇḍaṃ anuttaraṃ assattha rukkhamūlamhi bujjhissati mahāyaso. imassa janikā mātā māyā nāma bhavissati pitā suddhodano nāma ayaṃ hessati gotamo. anāsavā vītarāgā santacittā samāhitā kolito upatisso ca aggā hessanti sāvakā ānando nāmupaṭṭhāko upaṭṭhissatimaṃ jinaṃ. khemā uppalavaṇṇā ca aggā hessanti sāvikā anāsavā vītarāgā santacittā samāhitā. bodhi tassa bhagavato assatthoti pavuccati citto ca hatthāḷavako aggā hessantupaṭṭhikā. nandamātā ca uttarā aggā hessantupaṭṭhikā āyu vassa sataṃ tassa gotamassa yasassino. idaṃ sutvāna vacanaṃ asamassa mahesino āmoditā naramarū buddhavījaṅkuro ayaṃ. ukkuṭṭhi saddā vattanti apphoṭenti hasanti ca katañjalī namassanti dasasahassī sadevakā. yadi massa lokanāthassa virajjhissāma sāsanaṃ anāgatamhi addhāne hessāma sammukhā imaṃ. yathā manussā nadiṃ tarantā paṭititthaṃ virajjhiya heṭṭhā titthaṃ gahetvāna uttaranti mahānadiṃ. evameva mayaṃ sabbe yadi muñcāmimaṃ jinaṃ anāgatamhi addhāne ",
  "bv16:12.3": "hessāma sammukhā imaṃ. ",
  "bv16:13.1": "tassāpi vacanaṃ sutvā ",
  "bv16:13.2": "tuṭṭho saṃviggamānaso ",
  "bv16:13.3": "uttariṃ vattamadhiṭṭhāsiṃ dasa ",
  "bv16:13.4": "pāramipūriyā. ",
  "bv16:14.1": "sobhaṇaṃ nāma nagaraṃ ",
  "bv16:14.2": "sāgaro nāma khattiyo ",
  "bv16:14.3": "sudassanā nāma janikā ",
  "bv16:14.4": "atthadassissa mahesino. dasa ",
  "bv16:15.1": "vassa sahassāni ",
  "bv16:15.2": "agāraṃ ajjhāvasi so amaragi ",
  "bv16:15.3": "suragi giribāhanā ",
  "bv16:15.4": "tayo pāsādamuttamā. ",
  "bv16:16.1": "tettiṃsati sahassāni ",
  "bv16:16.2": "nāriyo samalaṅkatā ",
  "bv16:16.3": "visākhā nāma sā nārī ",
  "bv16:16.4": "selo nāmāsi atrajo. ",
  "bv16:17.1": "nimitte caturo disvā ",
  "bv16:17.2": "assa yānena nikkhami ",
  "bv16:17.3": "anūna aṭṭhamāsāni ",
  "bv16:17.4": "padhānaṃ padahī jino. ",
  "bv16:18.1": "brahmunā yācito santo ",
  "bv16:18.2": "atthadassī mahāyaso ",
  "bv16:18.3": "vattacakko mahāvīro ",
  "bv16:18.4": "anomuyyāne narāsabho. ",
  "bv16:19.1": "santo ca upasanto ca ",
  "bv16:19.2": "ahesuṃ aggasāvakā ",
  "bv16:19.3": "abhayo nāmupaṭṭhāko ",
  "bv16:19.4": "atthadassissa mahesino. ",
  "bv16:20.1": "dhammā ceva sudhammā ca ",
  "bv16:20.2": "ahesuṃ aggasāvikā ",
  "bv16:20.3": "bodhi tassa bhagavato ",
  "bv16:20.4": "campakoti pavuccati. ",
  "bv16:21.1": "nakulo ceva nisabho ca ",
  "bv16:21.2": "ahesuṃ aggupaṭṭhakā ",
  "bv16:21.3": "makilā ca sunandā ca ",
  "bv16:21.4": "ahesuṃ aggupaṭṭhikā. ",
  "bv16:22.1": "sopi buddho asamasamo ",
  "bv16:22.2": "asītiratanamuggato ",
  "bv16:22.3": "sobhati sālarājāva ",
  "bv16:22.4": "uḷurājāva pūrito. ",
  "bv16:23.1": "tassa pākaṭikā raṃsi ",
  "bv16:23.2": "anekasatakoṭiyo ",
  "bv16:23.3": "uddhaṃ adho dasadisā ",
  "bv16:23.4": "pharanti yojanaṃ sadā. ",
  "bv16:24.1": "sopi buddho naravusabho ",
  "bv16:24.2": "sabbasattuttamo muni ",
  "bv16:24.3": "vassa satasahassāni ",
  "bv16:24.4": "loke aṭṭhāsi cakkhumā. ",
  "bv16:25.1": "atulaṃ dassetvā obhāsaṃ ",
  "bv16:25.2": "virocetvā sadevake ",
  "bv16:25.3": "sopi aniccataṃ patto ",
  "bv16:25.4": "yathaggupādānasaṅkhayā. ",
  "bv16:26.1": "atthadassī jinavaro ",
  "bv16:26.2": "anomārāmamhi nibbuto ",
  "bv16:26.3": "dhātuvitthārakaṃ āsi ",
  "bv16:26.4": "tesu tesu padesatoti. ",
  "bv16:27.1": "atthadassi buddhavaṃso cuddasamo. "
}
