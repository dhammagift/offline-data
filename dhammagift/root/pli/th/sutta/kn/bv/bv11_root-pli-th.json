{
  "bv11:0.1": "",
  "bv11:0.2": "navamo nārada buddhavaṃso ",
  "bv11:1.1": "padumassa aparena ",
  "bv11:1.2": "sambuddho dipaduttamo ",
  "bv11:1.3": "nārado nāma nāmena ",
  "bv11:1.4": "asamo appaṭipuggalo. ",
  "bv11:2.1": "so buddho cakkavattissa ",
  "bv11:2.2": "jeṭṭho dayitaoraso ",
  "bv11:2.3": "āmuttamaṇyābharaṇo ",
  "bv11:2.4": "uyyānaṃ upasaṅkami. ",
  "bv11:3.1": "tatthāsi rukkho vipulo ",
  "bv11:3.2": "abhirūpo brahā suci ",
  "bv11:3.3": "tamajjhapatvā nisīdi ",
  "bv11:3.4": "mahāsoṇassa heṭṭhato. ",
  "bv11:4.1": "tattha ñāṇavaruppajji ",
  "bv11:4.2": "anantaṃ vajirūpamaṃ ",
  "bv11:4.3": "tena vicini saṅkhāre ",
  "bv11:4.4": "ukkujja mavakujjataṃ. ",
  "bv11:5.1": "tattha sabbakilesāni ",
  "bv11:5.2": "asesamabhivāhayi ",
  "bv11:5.3": "pāpuṇi kevalaṃ bodhiṃ ",
  "bv11:5.4": "buddhañāṇe ca cuddasa. ",
  "bv11:6.1": "pāpuṇitvāna sambodhiṃ ",
  "bv11:6.2": "dhammacakkaṃ pavattayi ",
  "bv11:6.3": "koṭi satasahassānaṃ ",
  "bv11:6.4": "paṭhamābhisamayo ahu. ",
  "bv11:7.1": "mahādoṇaṃ nāgarājaṃ ",
  "bv11:7.2": "vinayanto mahāmuni ",
  "bv11:7.3": "pāṭiheraṃ tadākāsi ",
  "bv11:7.4": "dassayanto sadevake. ",
  "bv11:8.1": "tadā deva manussānaṃ ",
  "bv11:8.2": "tamhi dhammappakāsane ",
  "bv11:8.3": "navuti koṭisahassāni ",
  "bv11:8.4": "tariṃsu sabbasaṃsayaṃ. ",
  "bv11:9.1": "yamhi kāle mahāvīro ",
  "bv11:9.2": "ovadi sakamatrajaṃ ",
  "bv11:9.3": "asīti koṭisahassānaṃ ",
  "bv11:9.4": "tatiyābhisamayo ahu. ",
  "bv11:10.1": "sannipātā tayo āsuṃ ",
  "bv11:10.2": "nāradassa mahesino ",
  "bv11:10.3": "koṭi satasahassānaṃ ",
  "bv11:10.4": "paṭhamo āsi samāgamo. ",
  "bv11:11.1": "yadā buddho buddhaguṇaṃ ",
  "bv11:11.2": "sanidānaṃ pakāsayi ",
  "bv11:11.3": "navuti koṭisahassāni ",
  "bv11:11.4": "samiṃsu vimalā tadā. ",
  "bv11:12.1": "yadā verocano nāgo ",
  "bv11:12.2": "dānaṃ dadāti satthuno ",
  "bv11:12.3": "tadā samiṃsu jinaputtā ",
  "bv11:12.4": "asīti satasahassino. ",
  "bv11:13.1": "ahan tena samayena ",
  "bv11:13.2": "jaṭilo uggatāpano ",
  "bv11:13.3": "antalikkhacaro āsiṃ ",
  "bv11:13.4": "pañcābhiññāsu pāragū. ",
  "bv11:14.1": "tadāpāhaṃ asamasamaṃ ",
  "bv11:14.2": "sasaṅghaṃ saparijanaṃ ",
  "bv11:14.3": "anna pānena tappetvā ",
  "bv11:14.4": "candanenābhipūjayiṃ. ",
  "bv11:15.1": "sopi maṃ tadā byākāsi ",
  "bv11:15.2": "nārado lokanāyako ",
  "bv11:15.3": "aparimeyye ito kappe ",
  "bv11:15.4": "buddho loke bhavissati. ",
  "bv11:16.1": "ahu kapilavhayā rammā nikkhamitvā tathāgato padhānaṃ padahitvāna ",
  "bv11:16.2": "katvā dukkarakārikaṃ. ajapāla rukkhamūlasmiṃ nisīditvā tathāgato tattha pāyāsaṃ paggayha nerañjaramupehiti. nerañjarāya tīramhi pāyāsaṃ adi so jino paṭiyatta varamaggena bodhimūlamhi ehiti. tato padakkhiṇaṃ katvā bodhimaṇḍaṃ anuttaraṃ assattha rukkhamūlamhi bujjhissati mahāyaso. imassa janikā mātā māyā nāma bhavissati pitā suddhodano nāma ayaṃ hessati gotamo. anāsavā vītarāgā santacittā samāhitā kolito upatisso ca aggā hessanti sāvakā ānando nāmupaṭṭhāko upaṭṭhissatimaṃ jinaṃ. khemā uppalavaṇṇā ca aggā hessanti sāvikā anāsavā vītarāgā santacittā samāhitā. bodhi tassa bhagavato assatthoti pavuccati citto ca hatthāḷavako aggā hessantupaṭṭhakā. nandamātā ca uttarā aggā hessantupaṭṭhikā āyu vassa sataṃ tassa gotamassa yasassino. idaṃ sutvāna vacanaṃ assamassa sahesino āmoditā nara marū buddhavījaṅkuro ayaṃ. ukkuṭṭhi saddā vattanti apphoṭenti hasanti ca katañjalī namassantiv dasasahassī sadevakā. yadi massa lokanāthassa virajjhissāma sāsanaṃ anāgatamhi addhāne ",
  "bv11:16.3": "hessāma sammukhā imaṃ. ",
  "bv11:17.1": "yathā manussā nadiṃ tarantā paṭititthaṃ virajjhiya heṭṭhā titthaṃ gahetvāna uttaranti mahānadiṃ. evameva mayaṃ sabbe yadi muñcāmi maṃ jinaṃ anāgatamhi addhāne hessāma sammukhā imaṃ. tassāhaṃ vacanaṃ sutvā ",
  "bv11:17.2": "bhiyyo hāsetvāna mānasaṃ ",
  "bv11:17.3": "adhiṭṭhahiṃ vattaṃ uggaṃ ",
  "bv11:17.4": "dasapāramipūriyā. ",
  "bv11:18.1": "nagaraṃ dhaññavatī nāma ",
  "bv11:18.2": "sudevo nāma khattiyo ",
  "bv11:18.3": "anomā nāma janikā ",
  "bv11:18.4": "nāradassa mahesino. ",
  "bv11:19.1": "nava vassa sahassāni ",
  "bv11:19.2": "agāraṃ ajjhāvasi so ",
  "bv11:19.3": "jito vijitābhirāmo ",
  "bv11:19.4": "tayo pāsāda muttamā. ti cattāri ",
  "bv11:20.1": "sahassāni ",
  "bv11:20.2": "nāriyo samalaṅkatā ",
  "bv11:20.3": "vijitasenā nāma sā nārī ",
  "bv11:20.4": "nanduttaro nāma atrajo. ",
  "bv11:21.1": "nimitte caturo disvā ",
  "bv11:21.2": "padasā gamanena nikkhami ",
  "bv11:21.3": "sattāhaṃ padhānacāraṃ ",
  "bv11:21.4": "acari purisuttamo. ",
  "bv11:22.1": "brahmunā yācito santo ",
  "bv11:22.2": "nārado lokanāyako ",
  "bv11:22.3": "vattacakko mahāvīro ",
  "bv11:22.4": "dhanañjuyyānamuttame. ",
  "bv11:23.1": "bhaddasālo jitamitto ",
  "bv11:23.2": "ahesuṃ aggasāvakā ",
  "bv11:23.3": "vāseṭṭho nāmupaṭṭhāko ",
  "bv11:23.4": "nāradassa mahesino. ",
  "bv11:24.1": "uttarā phaggunī ceva ",
  "bv11:24.2": "ahesuṃ aggasāvikā ",
  "bv11:24.3": "bodhi tassa bhagavato ",
  "bv11:24.4": "mahāsoṇoti vuccati. ",
  "bv11:25.1": "uggarindo vasabho ca ",
  "bv11:25.2": "ahesuṃ aggupaṭṭhakā ",
  "bv11:25.3": "indavarī ca gaṇḍī ca ",
  "bv11:25.4": "ahesuṃ aggupaṭṭhikā. ",
  "bv11:26.1": "aṭṭhāsīti ratanāni ",
  "bv11:26.2": "accuggato mahāmuni ",
  "bv11:26.3": "kañcanagghikasaṅkāso ",
  "bv11:26.4": "dasasahassī virocati. ",
  "bv11:27.1": "tassa byāmap pabhākāyo ",
  "bv11:27.2": "niddhāvati disodisaṃ ",
  "bv11:27.3": "nirantaraṃ divā rattiṃ ",
  "bv11:27.4": "yojanaṃ pharate sadā. ",
  "bv11:28.1": "na keci tena samayena ",
  "bv11:28.2": "samantā yojane janā ",
  "bv11:28.3": "ukkā padīpe ujjalenti ",
  "bv11:28.4": "buddharaṃsīhi otthatā. ",
  "bv11:29.1": "navuti vassa sahassāni ",
  "bv11:29.2": "āyu vijjati tāvade ",
  "bv11:29.3": "tāvatā tiṭṭhamāno so ",
  "bv11:29.4": "tāresi janataṃ bahuṃ. ",
  "bv11:30.1": "yathā uḷubhi gaganaṃ ",
  "bv11:30.2": "vicittaṃ upasobhati ",
  "bv11:30.3": "tatheva sāsanaṃ tassa ",
  "bv11:30.4": "arahantehi sobhati. ",
  "bv11:31.1": "saṃsārasotaṃ tāraṇāya ",
  "bv11:31.2": "sesake paṭipannake ",
  "bv11:31.3": "dhammasetuṃ daḷhaṃ katvā ",
  "bv11:31.4": "nibbuto so narāsabho. ",
  "bv11:32.1": "sopi buddho asamasamo ",
  "bv11:32.2": "tepi khīṇāsavā atulatejā ",
  "bv11:32.3": "sabbaṃ samantarahitaṃ ",
  "bv11:32.4": "nanu rittā sabbasaṅkhārāti. ",
  "bv11:33.1": "nārado jinavusabho ",
  "bv11:33.2": "nibbuto sudassane pure ",
  "bv11:33.3": "tatheva thūpavaro ",
  "bv11:33.4": "catuyojanamuggatoti. ",
  "bv11:34.1": "nārada buddhavaṃso navamo. "
}
