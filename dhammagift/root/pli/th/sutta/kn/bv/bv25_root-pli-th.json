{
  "bv25:0.1": "",
  "bv25:0.2": "tevīsatimo konāgamana buddhavaṃso ",
  "bv25:1.1": "kukkusandhassa aparena ",
  "bv25:1.2": "sambuddho dipaduttamo ",
  "bv25:1.3": "konāgamano nāma jino ",
  "bv25:1.4": "lokajeṭṭho narāsabho. ",
  "bv25:2.1": "dasadhamme pūrayitvāna ",
  "bv25:2.2": "kantāraṃ samatikkami ",
  "bv25:2.3": "pavāhāya malaṃ sabbaṃ ",
  "bv25:2.4": "patto sambodhimuttamaṃ. ",
  "bv25:3.1": "dhammacakkaṃ pavattente ",
  "bv25:3.2": "konāgamane vināyake ",
  "bv25:3.3": "tiṃsa koṭisahassānaṃ ",
  "bv25:3.4": "paṭhamābhisamayo ahu. ",
  "bv25:4.1": "pāṭihīraṃ karonte ca ",
  "bv25:4.2": "paravādap pamaddane ",
  "bv25:4.3": "vīsati koṭisahassānaṃ ",
  "bv25:4.4": "dutiyābhisamayo ahu. ",
  "bv25:5.1": "tato vikubbanaṃ katvā ",
  "bv25:5.2": "jino devapuraṃ gato ",
  "bv25:5.3": "vasati tattha sambuddho ",
  "bv25:5.4": "silāya paṇḍukambale. ",
  "bv25:6.1": "pakaraṇe satta desento ",
  "bv25:6.2": "vassaṃ vasati so muni ",
  "bv25:6.3": "dasa koṭisahassānaṃ ",
  "bv25:6.4": "tatiyābhisamayo ahu. ",
  "bv25:7.1": "tassāpi devadevassa ",
  "bv25:7.2": "eko āsi samāgamo ",
  "bv25:7.3": "khīṇāsavānaṃ vimalānaṃ ",
  "bv25:7.4": "santacittāna tādinaṃ. ",
  "bv25:8.1": "tiṃsa bhikkhusahassānaṃ ",
  "bv25:8.2": "tadā āsi samāgamo ",
  "bv25:8.3": "oghāna matikkantānaṃ ",
  "bv25:8.4": "bhijjitānañca maccuyā. ",
  "bv25:9.1": "ahan tena samayena ",
  "bv25:9.2": "pabbato nāma khattiyo ",
  "bv25:9.3": "mittā maccehi sampanno ",
  "bv25:9.4": "bala bāhanamappakaṃ. ",
  "bv25:10.1": "sambuddha dassanaṃ gantvā ",
  "bv25:10.2": "sutvā dhammamanuttaraṃ ",
  "bv25:10.3": "nimantetvā sajinaṃ saṅghaṃ ",
  "bv25:10.4": "dānaṃ datvā yadicchakaṃ. ",
  "bv25:11.1": "pattuṇṇaṃ cīnapaṭañca ",
  "bv25:11.2": "koseyyaṃ kambalaṃpica sovaṇṇa pādukañceva ",
  "bv25:11.3": "adāsi ",
  "bv25:11.4": "satthu sāvake. ",
  "bv25:12.1": "sopi maṃ muni byākāsi ",
  "bv25:12.2": "saṅghamajjhe nisīdiya ",
  "bv25:12.3": "imasmiṃ bhaddake kappe ",
  "bv25:12.4": "ayaṃ buddho bhavissati. ",
  "bv25:13.1": "ahu kapilavhayā rammā ",
  "bv25:13.2": "nikkhamitvā tathāgato padhānaṃ padahitvāna katvā dukkarakārikaṃ. ajapāla rukkhamūlasmiṃ nisīditvā tathāgato tattha pāyāsaṃ paggayha nerañjaramupehiti. nerañjarāya tīramhi pāyāsaṃ adi so jino paṭiyatta varamaggena bodhimaṇḍamhi ehiti. tato padakkhiṇaṃ katvā bodhimaṇḍaṃ anuttaraṃ assattha rukkhamūlamhi bujjhissati mahāyaso. imassa janikā mātā māyā nāma bhavissati pitā suddhodano nāma ayaṃ hessati gotamo. anāsavā vītarāgā santacittā samāhitā kolito upatisso ca aggā hessanti sāvakā ānando nāmupaṭṭhāko upaṭṭhissati maṃ jinaṃ. khemā uppalavaṇṇā ca aggā hessanti sāvikā anāsavā vītarāgā santacittā samāhitā. bodhi tassa bhagavato assatthoti pavuccati citto ca hatthāḷavako aggā hessantupaṭṭhakā. nandamātā ca uttarā aggā hessantupaṭṭhikā āyu vassa sataṃ tassa gotamassa yasassino. idaṃ sutvāna vacanaṃ asamassa mahesino āmoditā nara marū buddhavījaṅkuro ayaṃ. ukkuṭṭhi saddā vattanti apphoṭenti hasanti ca katañjalī namassanti dasasahassī sadevakā. yadi massa lokanāthassa virajjhissāma sāsanaṃ anāgatamhi addhāne hessāma sammukhā imaṃ. yathā manussā nadiṃ tarantā paṭititthaṃ virajjhiya heṭṭhā titthaṃ gahetvāna uttaranti mahānadiṃ. evameva mayaṃ sabbe yadi muñcāmi maṃ jinaṃ anāgatamhi addhāne ",
  "bv25:13.3": "hessāma sammukhā imaṃ. ",
  "bv25:14.1": "tassāpi vacanaṃ sutvā ",
  "bv25:14.2": "bhiyyo cittaṃ pasādayiṃ ",
  "bv25:14.3": "uttariṃ vattamadhiṭṭhāsiṃ dasa ",
  "bv25:14.4": "pāramipūriyā. ",
  "bv25:15.1": "sabbaññutaṃ gavesanto ",
  "bv25:15.2": "dānaṃ datvā naruttamo ",
  "bv25:15.3": "ohāyāhaṃ mahārajjaṃ ",
  "bv25:15.4": "pabbajiṃ jinasantike. ",
  "bv25:16.1": "nagaraṃ sobhavatī nāma ",
  "bv25:16.2": "sobho nāmāsi khattiyo ",
  "bv25:16.3": "vasati tattha nagare ",
  "bv25:16.4": "sambuddhassa mahākulaṃ. ",
  "bv25:17.1": "brāhmaṇo yaññadatto ca ",
  "bv25:17.2": "āsi buddhassa so pitā ",
  "bv25:17.3": "uttarā nāma janikā ",
  "bv25:17.4": "konāgamanassa satthuno. ",
  "bv25:18.1": "tīṇi vassa sahassāni ",
  "bv25:18.2": "agāraṃ ajjhāvasi so tusita santusita ",
  "bv25:18.3": "santuṭṭhā ",
  "bv25:18.4": "tayo pāsāda muttamā. ",
  "bv25:19.1": "anūnasoḷasa sahassāni ",
  "bv25:19.2": "nāriyo samalaṅkatā ",
  "bv25:19.3": "rucigattā nāma nārī ",
  "bv25:19.4": "satthavāho nāma atrajo. ",
  "bv25:20.1": "nimitte caturo disvā ",
  "bv25:20.2": "hatthi yānena nikkhami ",
  "bv25:20.3": "chamāsaṃ padhānacāraṃ ",
  "bv25:20.4": "acari purisuttamo. ",
  "bv25:21.1": "brahmunā yācito santo ",
  "bv25:21.2": "konāgamano ",
  "bv25:21.3": "lokanāyako vattacakko mahāvīro ",
  "bv25:21.4": "migadāye naruttamo. ",
  "bv25:22.1": "bhiyyoso uttaro nāma ",
  "bv25:22.2": "ahesuṃ aggasāvakā ",
  "bv25:22.3": "sotthijo nāmupaṭṭhāko ",
  "bv25:22.4": "konāgamanassa yasassino. ",
  "bv25:23.1": "samuddā uttarā ceva ",
  "bv25:23.2": "ahesuṃ aggasāvikā ",
  "bv25:23.3": "bodhi tassa bhagavato ",
  "bv25:23.4": "udumbaroti vuccati. ",
  "bv25:24.1": "uggo ca somadevo ca ",
  "bv25:24.2": "ahesuṃ aggupaṭṭhakā ",
  "bv25:24.3": "sīvalā ceva sāmā ca ",
  "bv25:24.4": "ahesuṃ aggupaṭṭhikā. ",
  "bv25:25.1": "uccattanena so buddho ",
  "bv25:25.2": "tiṃsa hattha samuggato ",
  "bv25:25.3": "ukkāmukhe yathā tambaṃ ",
  "bv25:25.4": "evaṃ raṃsīhi maṇḍito. ",
  "bv25:26.1": "tiṃsa vassa sahassāni ",
  "bv25:26.2": "āyu buddhassa tāvade ",
  "bv25:26.3": "tāvatā tiṭṭhamāno so ",
  "bv25:26.4": "tāresi janataṃ bahuṃ. ",
  "bv25:27.1": "dhammacetiyaṃ samussitvā dhammadussa ",
  "bv25:27.2": "vibhūsitaṃ ",
  "bv25:27.3": "dhammapupphaguḷaṃ katvā ",
  "bv25:27.4": "nibbuto so sasāvako. ",
  "bv25:28.1": "mahāvilāso tassa jano ",
  "bv25:28.2": "siridhammap pakāsano ",
  "bv25:28.3": "sabbaṃ samantarahitaṃ ",
  "bv25:28.4": "nanu rittā sabbasaṅkhārāti. ",
  "bv25:29.1": "konāgamano sambuddho ",
  "bv25:29.2": "pabbatārāmamhi nibbuto ",
  "bv25:29.3": "dhātuvitthārikaṃ āsi ",
  "bv25:29.4": "tesu tesu padesatoti. ",
  "bv25:30.1": "konāgamana buddhavaṃso tevīsatimo. "
}
