  "ud3.9:2.9": "ekacce evamāhaṃsu ",
  "ud3.9:2.10": "pharusippaṃ sippānaṃ agganti. ",
  "ud3.9:2.11": "ekacce evamāhaṃsu ",
  "ud3.9:2.12": "muddhāsippaṃ sippānaṃ agganti. ",
  "ud3.9:2.13": "ekacce evamāhaṃsu ",
  "ud3.9:2.14": "gaṇanāsippaṃ sippānaṃ agganti. ",
  "ud3.9:2.15": "ekacce evamāhaṃsu ",
  "ud3.9:2.16": "saṅkhānasippaṃ sippānaṃ agganti. ",
  "ud3.9:2.17": "ekacce evamāhaṃsu ",
  "ud3.9:2.18": "lekhāsippaṃ sippānaṃ agganti. ",
  "ud3.9:2.19": "ekacce evamāhaṃsu ",
  "ud3.9:2.20": "kābaysippaṃ sippānaṃ agganti. ",
  "ud3.9:2.21": "ekacce evamāhaṃsu ",
  "ud3.9:2.22": "lokāyatanasippaṃ sippānaṃ agganti. ",
  "ud3.9:2.23": "ekacce evamāhaṃsu ",
  "ud3.9:2.24": "khettavijjāsippaṃ sippānaṃ agganti. ",
  "ud3.9:2.25": "ayañcarahi tesaṃ bhikkhūnaṃ antarākathā hoti vippakatā. ",
  "ud3.9:3.1": "atha kho bhagavā sāyaṇhasamayaṃ paṭisallānā vuṭṭhito yena maṇḍalamāḷo tenupasaṅkami upasaṅkamitvā paññatte āsane nisīdi. ",
  "ud3.9:3.2": "nisajja kho bhagavā bhikkhū āmantesi ",
  "ud3.9:3.3": "kāya nuttha bhikkhave etarahi kathāya sannisinnā kā ca pana vo antarākathā vippakatāti. ",
  "ud3.9:4.1": "idha bhante amhākaṃ pacchābhattaṃ piṇḍapātapatikkantānaṃ maṇḍalamāḷe sannisinnānaṃ sannipatitānaṃ antarākathā udapādi ",
  "ud3.9:4.2": "ko nu kho āvuso sippaṃ jānāti ",
  "ud3.9:4.3": "ko kiṃ sippaṃ sikkhī ",
  "ud3.9:4.4": "kataraṃ sippaṃ sippānaṃ agganti ",
  "ud3.9:5.1": "tatthekacce evamāhaṃsu ",
  "ud3.9:5.2": "hatthisippaṃ sippānaṃ agganti ",
  "ud3.9:5.3": "ekacce evamāhaṃsu ",
