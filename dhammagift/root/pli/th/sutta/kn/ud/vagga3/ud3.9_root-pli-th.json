  "ud3.9:5.20": "kābyasippaṃ sippānaṃ agganti ",
  "ud3.9:5.21": "ekacce evamāhaṃsu ",
  "ud3.9:5.22": "lokāyatanasippaṃ sippānaṃ agganti ",
  "ud3.9:5.23": "ekacce evamāhaṃsu ",
  "ud3.9:5.24": "khettavijjāsippaṃ sippānaṃ agganti ",
  "ud3.9:5.25": "ayaṃ kho no bhante antarākathā vippakatā atha bhagavā anuppattoti. ",
  "ud3.9:6.1": "na khvetaṃ bhikkhave tumhākaṃ paṭirūpaṃ kulaputtānaṃ saddhā agārasmā anagāriyaṃ pabbajitānaṃ yaṃ tumhe evarūpaṃ kathaṃ katheyyātha ",
  "ud3.9:6.2": "sanni patitānaṃ vo bhikkhave dvayaṃ karaṇīyaṃ ",
  "ud3.9:6.3": "dhammī vā kathā ariyo vā tuṇhībhāvoti. ",
  "ud3.9:7.1": "atha kho bhagavā etamatthaṃ viditvā tāyaṃ velāyaṃ imaṃ udānaṃ udānesi ",
  "ud3.9:8.1": "asippajīvī lahu atthakāmo ",
  "ud3.9:8.2": "yatindriyo sabbadhi vippamutto ",
  "ud3.9:8.3": "anokasārī amamo nirāso ",
  "ud3.9:8.4": "hantvā māraṃ ekacaro sa bhikkhūti. ",
  "ud3.9:8.5": "navamaṃ. "
}
