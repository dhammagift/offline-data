{
  "tha-ap530:0.1": "",
  "tha-ap530:0.2": "",
  "tha-ap530:0.3": "",
  "tha-ap530:1.1": "ahaṃ pure bodhipattaṃ ",
  "tha-ap530:1.2": "ujjhitaṃ cetiyaṅgaṇe ",
  "tha-ap530:1.3": "taṃ gahetvāna chaḍḍesiṃ ",
  "tha-ap530:1.4": "alabhiṃ vīsatiṃ guṇe. ",
  "tha-ap530:2.1": "tassa kammassa tejena ",
  "tha-ap530:2.2": "saṃsaranto bhavābhave ",
  "tha-ap530:2.3": "duve bhave saṃsarāmi ",
  "tha-ap530:2.4": "devatte cāpi mānuse. ",
  "tha-ap530:3.1": "devalokā cavitvāna ",
  "tha-ap530:3.2": "āgantvā mānusaṃ bhavaṃ ",
  "tha-ap530:3.3": "duve kule pajāyāmi ",
  "tha-ap530:3.4": "khattiye cāpi brāhmaṇe. ",
  "tha-ap530:4.1": "aṅgapaccaṅgasampanno ",
  "tha-ap530:4.2": "ārohapariṇāhavā ",
  "tha-ap530:4.3": "abhirūpo suci homi ",
  "tha-ap530:4.4": "sampuṇṇako anūnako. ",
  "tha-ap530:5.1": "devaloke manusse vā ",
  "tha-ap530:5.2": "jāto vā yattha katthaci ",
  "tha-ap530:5.3": "bhave suvaṇṇavaṇṇo ca ",
  "tha-ap530:5.4": "uttattakanakūpamo. ",
  "tha-ap530:6.1": "mudu maddavā siniddhā ",
  "tha-ap530:6.2": "sukhumā sukumārikā ",
  "tha-ap530:6.3": "chavi me sabbadā hoti ",
  "tha-ap530:6.4": "bodhipatte suchaḍḍite. ",
  "tha-ap530:7.1": "yato kutoci gatīsu ",
  "tha-ap530:7.2": "sarīre samudāgate ",
  "tha-ap530:7.3": "na limpati rajojallaṃ ",
  "tha-ap530:7.4": "vipāko pattachaḍḍite. ",
  "tha-ap530:8.1": "uṇhe vātātape tassa ",
  "tha-ap530:8.2": "aggitāpena vā pana ",
  "tha-ap530:8.3": "gatte sedā na muñcanti ",
  "tha-ap530:8.4": "vipāko pattachaḍḍite. ",
  "tha-ap530:9.1": "kuṭṭhaṃ gaṇḍo kilāso ca ",
  "tha-ap530:9.2": "tilakā piḷakā tathā ",
  "tha-ap530:9.3": "na honti kāye daddu ca ",
  "tha-ap530:9.4": "vipāko pattachaḍḍite. ",
  "tha-ap530:10.1": "aparampi guṇantassa ",
  "tha-ap530:10.2": "nibbattati bhavābhave ",
  "tha-ap530:10.3": "rogā na honti kāyasmiṃ ",
  "tha-ap530:10.4": "vipāko pattachaḍḍite. ",
  "tha-ap530:11.1": "aparampi guṇantassa ",
  "tha-ap530:11.2": "nibbattati bhavābhave ",
  "tha-ap530:11.3": "na honti cittajā pīḷā ",
  "tha-ap530:11.4": "vipāko pattachaḍḍite. ",
  "tha-ap530:12.1": "aparampi guṇantassa ",
  "tha-ap530:12.2": "nibbattati bhavābhave ",
  "tha-ap530:12.3": "amittā na bhavantassa ",
  "tha-ap530:12.4": "vipāko pattachaḍḍite. ",
  "tha-ap530:13.1": "aparampi guṇantassa ",
  "tha-ap530:13.2": "nibbattati bhavābhave ",
  "tha-ap530:13.3": "anūnabhogo bhavati ",
  "tha-ap530:13.4": "vipāko pattachaḍḍite. ",
  "tha-ap530:14.1": "aparampi guṇantassa ",
  "tha-ap530:14.2": "nibbattati bhavābhave ",
  "tha-ap530:14.3": "aggirājūhi corehi ",
  "tha-ap530:14.4": "na hoti udakā bhayaṃ. ",
  "tha-ap530:15.1": "aparampi guṇantassa ",
  "tha-ap530:15.2": "nibbattati bhavābhave ",
  "tha-ap530:15.3": "dāsī dāsā anucarā ",
  "tha-ap530:15.4": "honti cittānuvattakā. ",
  "tha-ap530:16.1": "yamhi āyuppamāṇamhi ",
  "tha-ap530:16.2": "jāyate mānuse bhave ",
  "tha-ap530:16.3": "tato na hāyate āyu ",
  "tha-ap530:16.4": "tiṭṭhate yāvatāyukaṃ. ",
  "tha-ap530:17.1": "abbhantarā ca bāhirā ",
  "tha-ap530:17.2": "negamā ca saraṭṭhakā ",
  "tha-ap530:17.3": "anuyuttā honti sabbepi ",
  "tha-ap530:17.4": "vuddhikāmā sukhicchakā. ",
  "tha-ap530:18.1": "bhogavā yasavā homi ",
  "tha-ap530:18.2": "sirimā ñātipakkhavā ",
  "tha-ap530:18.3": "avero gatasantāso ",
  "tha-ap530:18.4": "bhavehi sabbadā bhave. ",
  "tha-ap530:19.1": "devā manussā asurā ",
  "tha-ap530:19.2": "gandhabbā yakkharakkhasā ",
  "tha-ap530:19.3": "sabbe te parirakkhanti ",
  "tha-ap530:19.4": "bhave saṃsarato sadā. ",
  "tha-ap530:20.1": "devaloke manusse vā ",
  "tha-ap530:20.2": "anubhotvā ubho yase ",
  "tha-ap530:20.3": "avasāne ca nibbānaṃ ",
  "tha-ap530:20.4": "sivaṃ patto anuttaraṃ. ",
  "tha-ap530:21.1": "sambuddhamuddisitvāna ",
  "tha-ap530:21.2": "bodhiṃ vā tassa satthuno ",
  "tha-ap530:21.3": "yo puññaṃ pasave poso ",
  "tha-ap530:21.4": "tassa kiṃ nāma dullabhaṃ. ",
  "tha-ap530:22.1": "magge phale ca āgame ",
  "tha-ap530:22.2": "jhānābhiññāguṇesu ca ",
  "tha-ap530:22.3": "aññesaṃ adhiko hutvā ",
  "tha-ap530:22.4": "nibbāyati anāsavo. ",
  "tha-ap530:23.1": "purehaṃ bodhiyā pattaṃ ",
  "tha-ap530:23.2": "chaḍḍetvā haṭṭhamānaso ",
  "tha-ap530:23.3": "imehi vīsataṅgehi ",
  "tha-ap530:23.4": "samaṅgī homi sabbadā. ",
  "tha-ap530:24.1": "kilesā jhāpitā mayhaṃ ",
  "tha-ap530:24.2": "bhavā sabbe samūhatā nāgova bandhanaṃ chetvā ",
  "tha-ap530:24.3": "viharāmi anāsavo. ",
  "tha-ap530:25.1": "svāgataṃ vata me āsi ",
  "tha-ap530:25.2": "mama buddhassa santike tisso vijjā anuppattā ",
  "tha-ap530:25.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap530:26.1": "paṭisambhidā catasso ",
  "tha-ap530:26.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap530:26.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap530:27.1": "itthaṃ sudaṃ āyasmā bodhisammajjako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap530:28.1": "bodhisammajjakattherassa apadānaṃ samattaṃ. navamaṃ āmaṇḍaphaladāyakattherāpadānaṃ (529) "
}
