{
  "tha-ap125:0.1": "",
  "tha-ap125:0.2": "",
  "tha-ap125:0.3": "",
  "tha-ap125:1.1": "suvaṇṇavaṇṇaṃ sambuddhaṃ battiṃsavaralakkhaṇaṃ ",
  "tha-ap125:1.2": "",
  "tha-ap125:1.3": "pavanā abhinikkhantaṃ ",
  "tha-ap125:1.4": "bhikkhusaṅghapurakkhataṃ. ",
  "tha-ap125:2.1": "sahatthā kaṃsapāṭiyā ",
  "tha-ap125:2.2": "vaḍḍhetvā pāyāsaṃ ahaṃ ",
  "tha-ap125:2.3": "āhutiṃ yiṭṭhukāmo so ",
  "tha-ap125:2.4": "agamiṃ sambaliṃ ahaṃ. ",
  "tha-ap125:3.1": "bhagavā tamhi samaye ",
  "tha-ap125:3.2": "lokajeṭṭho narāsabho ",
  "tha-ap125:3.3": "caṅkamaṃ susamāruḷho ",
  "tha-ap125:3.4": "ambare anilāyane. ",
  "tha-ap125:4.1": "tañca acchariyaṃ disvā ",
  "tha-ap125:4.2": "abbhūtaṃ lomahaṃsanaṃ ",
  "tha-ap125:4.3": "ṭhapayitvā kaṃsapāṭiṃ ",
  "tha-ap125:4.4": "vipassiṃ abhivādayiṃ. ",
  "tha-ap125:5.1": "tuvaṃ buddhosi sabbaññū ",
  "tha-ap125:5.2": "sadevake samānuse ",
  "tha-ap125:5.3": "anukampaṃ upādāya ",
  "tha-ap125:5.4": "paṭiggaṇha mahāmuni. ",
  "tha-ap125:6.1": "paṭiggaṇhāsi bhagavā ",
  "tha-ap125:6.2": "sabbaññū lokanāyako ",
  "tha-ap125:6.3": "mama saṅkappamaññāya ",
  "tha-ap125:6.4": "satthā loke anuttaro. ekanavute ",
  "tha-ap125:7.1": "ito kappe ",
  "tha-ap125:7.2": "yaṃ dānamadadiṃ tadā ",
  "tha-ap125:7.3": "duggatiṃ nābhijānāmi ",
  "tha-ap125:7.4": "pāyāsassa idaṃ phalaṃ. ",
  "tha-ap125:8.1": "ekatāḷīsito kappe ",
  "tha-ap125:8.2": "buddho nāmāsi khattiyo ",
  "tha-ap125:8.3": "sattaratanasampanno ",
  "tha-ap125:8.4": "cakkavatti mahabbalo. ",
  "tha-ap125:9.1": "paṭisambhidā catasso ",
  "tha-ap125:9.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap125:9.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap125:10.1": "itthaṃ sudaṃ āyasmā pāyāsadāyako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap125:11.1": "pāyāsadāyakattherassa apadānaṃ samattaṃ. catutthaṃ gandhodakiyattherāpadānaṃ (124) "
}
