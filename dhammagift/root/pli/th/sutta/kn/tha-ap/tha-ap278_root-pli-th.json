{
  "tha-ap278:0.1": "",
  "tha-ap278:0.2": "",
  "tha-ap278:0.3": "",
  "tha-ap278:1.1": "satthāraṃ dhammamārabbha ",
  "tha-ap278:1.2": "saṅghañcāpi mahesino ",
  "tha-ap278:1.3": "potthadānaṃ mayā dinnaṃ ",
  "tha-ap278:1.4": "dakkhiṇeyye anuttare. ",
  "tha-ap278:2.1": "ekanavute ito kappe ",
  "tha-ap278:2.2": "yaṃ kammamakariṃ tadā ",
  "tha-ap278:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap278:2.4": "potthadānassidaṃ phalaṃ. ",
  "tha-ap278:3.1": "paṭisambhidā catasso ",
  "tha-ap278:3.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap278:3.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap278:4.1": "itthaṃ sudaṃ āyasmā potthadāyako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap278:5.1": "potthadāyakattherassa apadānaṃ samattaṃ. sattamaṃ citakapūjakattherāpadānaṃ (277) "
}
