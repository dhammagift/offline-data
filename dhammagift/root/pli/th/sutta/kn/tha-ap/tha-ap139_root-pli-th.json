{
  "tha-ap139:0.1": "",
  "tha-ap139:0.2": "",
  "tha-ap139:0.3": "",
  "tha-ap139:1.1": "visālamāḷe āsinno ",
  "tha-ap139:1.2": "addasaṃ lokanāyakaṃ ",
  "tha-ap139:1.3": "khīṇāsavaṃ balappattaṃ ",
  "tha-ap139:1.4": "bhikkhusaṅghapurakkhataṃ. ",
  "tha-ap139:2.1": "satasahassā tevijjā ",
  "tha-ap139:2.2": "chaḷabhiññā mahiddhikā ",
  "tha-ap139:2.3": "parivārenti sambuddhaṃ ",
  "tha-ap139:2.4": "ko disvā nappasīdati. ",
  "tha-ap139:3.1": "ñāṇe upanidhā yassa ",
  "tha-ap139:3.2": "na vijjati sadevake ",
  "tha-ap139:3.3": "anantañāṇaṃ sambuddhaṃ ",
  "tha-ap139:3.4": "ko disvā nappasīdati. ",
  "tha-ap139:4.1": "dhammakāyañca dīpenti ",
  "tha-ap139:4.2": "kevalaṃ ratanākaraṃ ",
  "tha-ap139:4.3": "vikopetuṃ na sakkonti ",
  "tha-ap139:4.4": "ko disvā nappasīdati. ",
  "tha-ap139:5.1": "imāhi tīhi gāthāhi ",
  "tha-ap139:5.2": "nārado puragacchi so ",
  "tha-ap139:5.3": "padumuttaraṃ thavitvāna ",
  "tha-ap139:5.4": "sambuddhaṃ aparājitaṃ. ",
  "tha-ap139:6.1": "tena cittappasādena ",
  "tha-ap139:6.2": "buddhasanthavanena ca ",
  "tha-ap139:6.3": "kappānaṃ satasahassaṃ ",
  "tha-ap139:6.4": "duggatiṃ nūpapajjahaṃ. ",
  "tha-ap139:7.1": "ito tiṃse kappasate ",
  "tha-ap139:7.2": "sumitto nāma khattiyo ",
  "tha-ap139:7.3": "sattaratanasampanno ",
  "tha-ap139:7.4": "cakkavatti mahabbalo. ",
  "tha-ap139:8.1": "paṭisambhidā catasso ",
  "tha-ap139:8.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap139:8.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap139:9.1": "itthaṃ sudaṃ āyasmā atthasandassako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap139:10.1": "atthasandassakattherassa apadānaṃ samattaṃ. aṭṭhamaṃ ekaraṃsaniyattherāpadānaṃ (138) "
}
