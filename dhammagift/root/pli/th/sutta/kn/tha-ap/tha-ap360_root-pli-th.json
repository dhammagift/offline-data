{
  "tha-ap360:0.1": "",
  "tha-ap360:0.2": "",
  "tha-ap360:0.3": "",
  "tha-ap360:1.1": "vipassino bhagavato ",
  "tha-ap360:1.2": "lokajeṭṭhassa tādino ",
  "tha-ap360:1.3": "ekavaccho mayā dinno ",
  "tha-ap360:1.4": "pasannena sapāṇinā. ",
  "tha-ap360:2.1": "hatthiyānaṃ assayānaṃ ",
  "tha-ap360:2.2": "dibbayānaṃ samajjhagaṃ ",
  "tha-ap360:2.3": "tena vacchakadānena ",
  "tha-ap360:2.4": "pattomhi āsavakkhayaṃ. ",
  "tha-ap360:3.1": "ekanavute ito kappe ",
  "tha-ap360:3.2": "yaṃ vacchamadadiṃ tadā ",
  "tha-ap360:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap360:3.4": "vacchadānassidaṃ phalaṃ. ",
  "tha-ap360:4.1": "paṭisambhidā catasso ",
  "tha-ap360:4.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap360:4.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap360:5.1": "itthaṃ sudaṃ āyasmā vacchadāyako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap360:6.1": "vacchadāyakattherassa apadānaṃ samattaṃ. navamaṃ saraṇāgamaniyattherāpadānaṃ (359) "
}
