{
  "tha-ap337:0.1": "",
  "tha-ap337:0.2": "",
  "tha-ap337:0.3": "",
  "tha-ap337:1.1": "vipassī nāma sambuddho ",
  "tha-ap337:1.2": "lokajeṭṭho narāsabho ",
  "tha-ap337:1.3": "khīṇāsavehi sahito ",
  "tha-ap337:1.4": "saṅghārāme vasī tadā. ",
  "tha-ap337:2.1": "ārāmadvārā nikkhamma ",
  "tha-ap337:2.2": "vipassī lokanāyako ",
  "tha-ap337:2.3": "saha satasahassehi ",
  "tha-ap337:2.4": "aṭṭhakhīṇāsavehi so. ",
  "tha-ap337:3.1": "ajinena nivatthohaṃ ",
  "tha-ap337:3.2": "vākacīradharopi ca ",
  "tha-ap337:3.3": "kusumbhodakamādāya ",
  "tha-ap337:3.4": "sambuddhaṃ upasaṅkamiṃ. ",
  "tha-ap337:4.1": "sakaṃ cittaṃ pasādetvā ",
  "tha-ap337:4.2": "vedajāto katañjalī ",
  "tha-ap337:4.3": "kusumbhodakamādāya ",
  "tha-ap337:4.4": "buddhamabbhukiriṃ ahaṃ. ",
  "tha-ap337:5.1": "tena kammena sambuddho ",
  "tha-ap337:5.2": "jalajuttamanāmako ",
  "tha-ap337:5.3": "mama kammaṃ pakittetvā ",
  "tha-ap337:5.4": "agamā yena patthitaṃ. ",
  "tha-ap337:6.1": "phussitā pañcasahassā ",
  "tha-ap337:6.2": "yehi pūjesahaṃ jinaṃ ",
  "tha-ap337:6.3": "aḍḍhateyyasahassehi ",
  "tha-ap337:6.4": "devarajjamakārayiṃ. ",
  "tha-ap337:7.1": "aḍḍhateyyasahassehi ",
  "tha-ap337:7.2": "cakkavatti ahosahaṃ ",
  "tha-ap337:7.3": "avasesena kammena ",
  "tha-ap337:7.4": "arahattaṃ apāpuṇiṃ. ",
  "tha-ap337:8.1": "devarājā yadāhosiṃ ",
  "tha-ap337:8.2": "manujādhipati tadā ",
  "tha-ap337:8.3": "taṃyeva nāmadheyyaṃ me ",
  "tha-ap337:8.4": "phussito nāmahosahaṃ. ",
  "tha-ap337:9.1": "devabhūtassa santassa ",
  "tha-ap337:9.2": "athāpi mānusassa vā ",
  "tha-ap337:9.3": "samantā byāmato mayhaṃ ",
  "tha-ap337:9.4": "phussitaṃpi pavassati. ",
  "tha-ap337:10.1": "bhavā ugghāṭitā mayhaṃ ",
  "tha-ap337:10.2": "kilesā jhāpitā mama ",
  "tha-ap337:10.3": "sabbāsavaparikkhīṇo ",
  "tha-ap337:10.4": "phussitassa idaṃ phalaṃ. ",
  "tha-ap337:11.1": "candanasseva me vasso ",
  "tha-ap337:11.2": "tathā gandho pavāyati ",
  "tha-ap337:11.3": "sārīrako mama gandho ",
  "tha-ap337:11.4": "aḍḍhakose pavāyati. ",
  "tha-ap337:12.1": "dibbagandhaṃ sampavantaṃ ",
  "tha-ap337:12.2": "puññakammasamaṅginaṃ ",
  "tha-ap337:12.3": "gandhaṃ ghatvāna jānanti ",
  "tha-ap337:12.4": "phussito āgato idha. ",
  "tha-ap337:13.1": "sākhā ",
  "tha-ap337:13.2": "palāsakaṭṭhāni tiṇānipica sabbaso ",
  "tha-ap337:13.3": "mama saṅkappamaññāya ",
  "tha-ap337:13.4": "gandho sampajjate khaṇe. ",
  "tha-ap337:14.1": "satasahasse ito kappe ",
  "tha-ap337:14.2": "candanaṃ abhipūjayiṃ ",
  "tha-ap337:14.3": "duggatiṃ nābhijānāmi ",
  "tha-ap337:14.4": "phussitadassidaṃ phalaṃ. ",
  "tha-ap337:15.1": "paṭisambhidā catasso ",
  "tha-ap337:15.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap337:15.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap337:16.1": "itthaṃ sudaṃ āyasmā phussitakammiyo thero imā gāthāyo abhāsitthāti. ",
  "tha-ap337:17.1": "phussitakammiyattherassa apadānaṃ samattaṃ. chaṭṭhaṃ pabhaṅkarattherāpadānaṃ (336) "
}
