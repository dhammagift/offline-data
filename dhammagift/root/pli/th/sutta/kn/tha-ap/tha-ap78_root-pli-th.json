{
  "tha-ap78:0.1": "",
  "tha-ap78:0.2": "",
  "tha-ap78:0.3": "",
  "tha-ap78:1.1": "himavantassa avidūre ",
  "tha-ap78:1.2": "mahājātassaro ahu ",
  "tha-ap78:1.3": "sattapattehi sañchanno ",
  "tha-ap78:1.4": "nānāsakuṇamālayo. ",
  "tha-ap78:2.1": "tamhi nhātvā ca pitvā ca ",
  "tha-ap78:2.2": "avidūre vasāmahaṃ ",
  "tha-ap78:2.3": "addasaṃ samaṇānaggaṃ ",
  "tha-ap78:2.4": "gacchantaṃ anilañjase. ",
  "tha-ap78:3.1": "mama saṅkappamaññāya ",
  "tha-ap78:3.2": "satthā loke anuttaro ",
  "tha-ap78:3.3": "abbhato orohitvāna bhūmiyaṃ ",
  "tha-ap78:3.4": "ṭhāti tāvade. ",
  "tha-ap78:4.1": "lāyanena tiṇaṃ gayha ",
  "tha-ap78:4.2": "nisīdanamadāsahaṃ ",
  "tha-ap78:4.3": "nisīdi bhagavā tattha ",
  "tha-ap78:4.4": "tilokapati nāyako. ",
  "tha-ap78:5.1": "sakaṃ cittaṃ pasādetvā ",
  "tha-ap78:5.2": "avandiṃ lokanāyakaṃ ",
  "tha-ap78:5.3": "ukkuṭiko avasakkhi ",
  "tha-ap78:5.4": "nijjhāyanto mahāmuniṃ. ",
  "tha-ap78:6.1": "tena cittappasādena ",
  "tha-ap78:6.2": "nimmānaṃ upapajjahaṃ ",
  "tha-ap78:6.3": "duggatiṃ nābhijānāmi ",
  "tha-ap78:6.4": "santhārassa idaṃ phalaṃ. ",
  "tha-ap78:7.1": "ito dutiyake kappe ",
  "tha-ap78:7.2": "mittasammatakhattiyo ",
  "tha-ap78:7.3": "sattaratanasampanno ",
  "tha-ap78:7.4": "cakkavatti mahabbalo. ",
  "tha-ap78:8.1": "paṭisambhidā catasso ",
  "tha-ap78:8.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap78:8.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap78:9.1": "itthaṃ sudaṃ āyasmā tiṇasanthāradāyako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap78:10.1": "tiṇasanthāradāyakattherassa apadānaṃ samattaṃ. sattamaṃ sūcidāyakattherāpadānaṃ (77) "
}
