{
  "tha-ap93:0.1": "dasamo sudhāvaggo ",
  "tha-ap93:0.2": "",
  "tha-ap93:0.3": "",
  "tha-ap93:1.1": "paṭhamaṃ sudhāpiṇḍiyattherāpadānaṃ (91) pūjārahe pūjayato ",
  "tha-ap93:1.2": "buddhe yadica sāvake ",
  "tha-ap93:1.3": "papañcasamatikkante ",
  "tha-ap93:1.4": "tiṇṇasokapariddave. ",
  "tha-ap93:2.1": "te tādise pūjayato ",
  "tha-ap93:2.2": "nibbute akutobhaye ",
  "tha-ap93:2.3": "na sakkā puññaṃ saṃkhātuṃ ",
  "tha-ap93:2.4": "imettamapi kenaci. ",
  "tha-ap93:3.1": "catunnampi ca dīpānaṃ ",
  "tha-ap93:3.2": "issaraṃ yodha kāraye ",
  "tha-ap93:3.3": "etissā pūjanāyetaṃ ",
  "tha-ap93:3.4": "kalaṃ nāgghati soḷasiṃ. ",
  "tha-ap93:4.1": "siddhatthassa naraggassa ",
  "tha-ap93:4.2": "cetiye iṭṭhakantare ",
  "tha-ap93:4.3": "sudhāpiṇḍo mayā dinno ",
  "tha-ap93:4.4": "vippasannena cetasā. ",
  "tha-ap93:5.1": "catunavute ito kappe ",
  "tha-ap93:5.2": "yaṃ kammamakariṃ tadā ",
  "tha-ap93:5.3": "duggatiṃ nābhijānāmi ",
  "tha-ap93:5.4": "paṭisaṃkhārassidaṃ phalaṃ. ",
  "tha-ap93:6.1": "ito tiṃsatikappamhi ",
  "tha-ap93:6.2": "paṭisaṃkhārasavhayā ",
  "tha-ap93:6.3": "sattaratanasampannā ",
  "tha-ap93:6.4": "terasa cakkavattino. ",
  "tha-ap93:7.1": "paṭisambhidā catasso ",
  "tha-ap93:7.2": "vimokkhāpica aṭṭhime ",
  "tha-ap93:7.3": "chaḷabhiññā sacchikatā ",
  "tha-ap93:7.4": "kataṃ buddhassa sāsananti. ",
  "tha-ap93:8.1": "itthaṃ sudaṃ āyasmā sudhāpiṇḍiyo thero imā gāthāyo abhāsitthāti. ",
  "tha-ap93:9.1": "sudhāpiṇḍiyattherassa apadānaṃ samattaṃ. dutiyaṃ supīṭhiyattherāpadānaṃ (92) "
}
