{
  "tha-ap44:0.1": "",
  "tha-ap44:0.2": "",
  "tha-ap44:0.3": "",
  "tha-ap44:1.1": "anomadassissa munino ",
  "tha-ap44:1.2": "lokajeṭṭhassa tādino ",
  "tha-ap44:1.3": "sudhāya lepanaṃ katvā ",
  "tha-ap44:1.4": "caṅkamaṃ kārayiṃ ahaṃ. ",
  "tha-ap44:2.1": "nānāvaṇṇehi pupphehi ",
  "tha-ap44:2.2": "caṅkamaṃ santhariṃ ahaṃ ",
  "tha-ap44:2.3": "ākāse vitānaṃ katvā ",
  "tha-ap44:2.4": "bhojayiṃ buddhamuttamaṃ. ",
  "tha-ap44:3.1": "añjaliṃ paggahetvāna ",
  "tha-ap44:3.2": "abhivādetvāna subbataṃ ",
  "tha-ap44:3.3": "dīghasālaṃ bhagavato ",
  "tha-ap44:3.4": "niyyādesimahantadā. ",
  "tha-ap44:4.1": "mama saṅkappamaññāya ",
  "tha-ap44:4.2": "satthā loke anuttaro ",
  "tha-ap44:4.3": "paṭiggahesi bhagavā ",
  "tha-ap44:4.4": "anukampāya cakkhumā. ",
  "tha-ap44:5.1": "paṭiggahetvāna sambuddho ",
  "tha-ap44:5.2": "dakkhiṇeyyo sadevake ",
  "tha-ap44:5.3": "bhikkhusaṅghe nisīditvā ",
  "tha-ap44:5.4": "imā gāthā abhāsatha. ",
  "tha-ap44:6.1": "yo so haṭṭhena cittena ",
  "tha-ap44:6.2": "dīghasālaṃ adāsi me ",
  "tha-ap44:6.3": "tamahaṃ kittayissāmi ",
  "tha-ap44:6.4": "suṇātha mama bhāsato. ",
  "tha-ap44:7.1": "imassa maccukālamhi ",
  "tha-ap44:7.2": "puññakammasamaṅgino ",
  "tha-ap44:7.3": "sahassayuttassaratho ",
  "tha-ap44:7.4": "upaṭṭhissati tāvade. ",
  "tha-ap44:8.1": "tena yānenayaṃ poso ",
  "tha-ap44:8.2": "devalokaṃ gamissati ",
  "tha-ap44:8.3": "anumodissare devā ",
  "tha-ap44:8.4": "sampatte kusale bhave. ",
  "tha-ap44:9.1": "mahārahaṃ byamhaṃ seṭṭhaṃ ",
  "tha-ap44:9.2": "ratanamattikalepanaṃ ",
  "tha-ap44:9.3": "kūṭāgāravarūpetaṃ ",
  "tha-ap44:9.4": "byamhaṃ ajjhāvasissati. ",
  "tha-ap44:10.1": "tiṃsakappasahassāni ",
  "tha-ap44:10.2": "devaloke ramissati ",
  "tha-ap44:10.3": "pañcavīsatikappāni ",
  "tha-ap44:10.4": "devarājā bhavissati. ",
  "tha-ap44:11.1": "sattasattatikhattuñca ",
  "tha-ap44:11.2": "cakkavatti bhavissati ",
  "tha-ap44:11.3": "yasodharasanāmā te ",
  "tha-ap44:11.4": "sabbepi ekanāmakā. ",
  "tha-ap44:12.1": "dve sampattī anubhotvā ",
  "tha-ap44:12.2": "cinitvā puññasañcayaṃ ",
  "tha-ap44:12.3": "aṭṭhavīsatikappamhi ",
  "tha-ap44:12.4": "cakkavatti bhavissati. ",
  "tha-ap44:13.1": "tatthāpi byamhaṃ pavaraṃ ",
  "tha-ap44:13.2": "visukammena māpitaṃ ",
  "tha-ap44:13.3": "dasasaddāvivittantaṃ ",
  "tha-ap44:13.4": "puraṃ ajjhāvasissati. ",
  "tha-ap44:14.1": "aparimeyye ito kappe ",
  "tha-ap44:14.2": "bhūmipālo mahiddhiko ",
  "tha-ap44:14.3": "okkāko nāma nāmena ",
  "tha-ap44:14.4": "rājā raṭṭhe bhavissati. ",
  "tha-ap44:15.1": "soḷasitthisahassānaṃ ",
  "tha-ap44:15.2": "sabbāsaṃ pavarāvayā ",
  "tha-ap44:15.3": "abhijātā khattiyānī ",
  "tha-ap44:15.4": "nava putte janissati. ",
  "tha-ap44:16.1": "nava putte janitvāna ",
  "tha-ap44:16.2": "khattiyānī marissati ",
  "tha-ap44:16.3": "taruṇī ca piyā kaññā ",
  "tha-ap44:16.4": "mahesittaṃ karissati. ",
  "tha-ap44:17.1": "okkākaṃ tosayitvāna ",
  "tha-ap44:17.2": "varaṃ kaññā labhissati ",
  "tha-ap44:17.3": "varaṃ laddhā ca sā kaññā ",
  "tha-ap44:17.4": "putte pabbājayissati. ",
  "tha-ap44:18.1": "pabbājitā ca te sabbe ",
  "tha-ap44:18.2": "gamissanti naguttamaṃ ",
  "tha-ap44:18.3": "jātibhedabhayā sabbe ",
  "tha-ap44:18.4": "bhaginīhi vasissare. ",
  "tha-ap44:19.1": "ekā ca kaññā byādhīhi ",
  "tha-ap44:19.2": "bhavissati purakkhatā ",
  "tha-ap44:19.3": "mā no jāti pabhijjati ",
  "tha-ap44:19.4": "nikhaṇissanti khattiyā. ",
  "tha-ap44:20.1": "khattiyo nīharitvāna ",
  "tha-ap44:20.2": "tāya saddhiṃ vasissati ",
  "tha-ap44:20.3": "bhavissati tadā bhedo ",
  "tha-ap44:20.4": "okkākakulasambhavo. ",
  "tha-ap44:21.1": "tesaṃ pajā bhavissanti ",
  "tha-ap44:21.2": "koliyā nāma jātiyā ",
  "tha-ap44:21.3": "tattha mānusakaṃ bhogaṃ ",
  "tha-ap44:21.4": "anubhossantinappakaṃ. ",
  "tha-ap44:22.1": "tamhā kāyā cavitvāna ",
  "tha-ap44:22.2": "devalokaṃ gamissati ",
  "tha-ap44:22.3": "tatrāpi pavaraṃ byamhaṃ ",
  "tha-ap44:22.4": "labhissati manoramaṃ. ",
  "tha-ap44:23.1": "devalokā cavitvāna ",
  "tha-ap44:23.2": "sukkamūlena codito ",
  "tha-ap44:23.3": "āgantvāna manussattaṃ ",
  "tha-ap44:23.4": "soṇo nāma bhavissati. ",
  "tha-ap44:24.1": "āraddhaviriyo pahitatto ",
  "tha-ap44:24.2": "padahaṃ satthu sāsane ",
  "tha-ap44:24.3": "sabbāsave pariññāya ",
  "tha-ap44:24.4": "nibbāyissatyanāsavo. ",
  "tha-ap44:25.1": "anantadassī bhagavā ",
  "tha-ap44:25.2": "gotamo sakyapuṅgavo ",
  "tha-ap44:25.3": "visesaññū mahāvīro ",
  "tha-ap44:25.4": "aggaṭṭhāne ṭhapessati. ",
  "tha-ap44:26.1": "vuṭṭhamhi deve caturaṅgulamhi ",
  "tha-ap44:26.2": "tiṇe anileritaaṅgulamhi ",
  "tha-ap44:26.3": "ṭhapetvāna yogassa payuttatādino ",
  "tha-ap44:26.4": "tatottari pāramatā na vijjati. ",
  "tha-ap44:27.1": "uttame damathe danto ",
  "tha-ap44:27.2": "cittaṃ me suppaṇīhitaṃ ",
  "tha-ap44:27.3": "bhāro me ohito sabbo ",
  "tha-ap44:27.4": "nibbutomhi anāsavo. ",
  "tha-ap44:28.1": "aṅgīraso mahānāgo ",
  "tha-ap44:28.2": "abhijātova kesarī ",
  "tha-ap44:28.3": "bhikkhusaṅghe nisīditvā ",
  "tha-ap44:28.4": "etadagge ṭhapesi maṃ. ",
  "tha-ap44:29.1": "paṭisambhidā catasso ",
  "tha-ap44:29.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap44:29.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap44:30.1": "itthaṃ sudaṃ āyasmā soṇo koṭiyavesso thero imā gāthāyo abhāsitthāti. ",
  "tha-ap44:31.1": "soṇakoṭiyavessattherassa apadānaṃ samattaṃ. tatiyaṃ bhaddiyakāḷigodhāyaputtattherāpadānaṃ (43) "
}
