{
  "tha-ap145:0.1": "",
  "tha-ap145:0.2": "",
  "tha-ap145:0.3": "",
  "tha-ap145:1.1": "nibbute lokanāthamhi ",
  "tha-ap145:1.2": "piyadassīnaruttame ",
  "tha-ap145:1.3": "pasannacitto sumano ",
  "tha-ap145:1.4": "buddhavedimakāsahaṃ. ",
  "tha-ap145:2.1": "maṇīhi parivāretvā ",
  "tha-ap145:2.2": "akāsimahamuttamaṃ ",
  "tha-ap145:2.3": "vedikāya mahaṃ katvā ",
  "tha-ap145:2.4": "tattha kālaṃ kato ahaṃ. ",
  "tha-ap145:3.1": "yaṃ yaṃ yonūpapajjāmi ",
  "tha-ap145:3.2": "devattaṃ atha mānusaṃ ",
  "tha-ap145:3.3": "maṇiṃ dhārenti ākāse ",
  "tha-ap145:3.4": "puññakammassidaṃ phalaṃ. ",
  "tha-ap145:4.1": "soḷasito kappasate ",
  "tha-ap145:4.2": "maṇippabhāsanāmakā ",
  "tha-ap145:4.3": "battiṃsāsiṃsu rājāno ",
  "tha-ap145:4.4": "cakkavattī mahabbalā. ",
  "tha-ap145:5.1": "paṭisambhidā catasso ",
  "tha-ap145:5.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap145:5.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap145:6.1": "itthaṃ sudaṃ āyasmā vedikārako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap145:7.1": "vedikārakattherassa apadānaṃ samattaṃ. catutthaṃ saparivāriyattherāpadānaṃ (144) "
}
