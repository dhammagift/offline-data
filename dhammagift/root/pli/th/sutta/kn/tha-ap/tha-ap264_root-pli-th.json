  "tha-ap264:0.1": "",
  "tha-ap264:0.2": "",
  "tha-ap264:0.3": "",
  "tha-ap264:1.1": "siddhatthamhi bhagavati ",
  "tha-ap264:1.2": "nibbutamhi narāsabhe ",
  "tha-ap264:1.3": "bodhiyā vedikāyāhaṃ ",
  "tha-ap264:1.4": "telaṃ makkhesi tāvade. ",
  "tha-ap264:2.1": "catunavute ito kappe ",
  "tha-ap264:2.2": "yaṃ telaṃ makkhayiṃ tadā ",
  "tha-ap264:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap264:2.4": "makkhanāya idaṃ phalaṃ. ",
  "tha-ap264:3.1": "catuvīse ito kappe ",
  "tha-ap264:3.2": "succhavi nāma khattiyo ",
  "tha-ap264:3.3": "sattaratanasampanno ",
  "tha-ap264:3.4": "cakkavatti mahabbalo. ",
  "tha-ap264:4.1": "paṭisambhidā catasso ",
  "tha-ap264:4.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap264:4.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap264:5.1": "itthaṃ sudaṃ āyasmā telamakkhiyo thero imā gāthāyo abhāsitthāti. ",
  "tha-ap264:6.1": "telamakkhiyattherassa apadānaṃ samattaṃ. tatiyaṃ aḍḍhacandiyattherāpadānaṃ (263) "
}
