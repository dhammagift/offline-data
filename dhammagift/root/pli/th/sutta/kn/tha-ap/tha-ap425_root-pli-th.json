{
  "tha-ap425:0.1": "",
  "tha-ap425:0.2": "",
  "tha-ap425:0.3": "",
  "tha-ap425:1.1": "himavantassa avidūre ",
  "tha-ap425:1.2": "kasiko nāma pabbato ",
  "tha-ap425:1.3": "assamo sukato mayhaṃ ",
  "tha-ap425:1.4": "paṇṇasālā sumāpitā. ",
  "tha-ap425:2.1": "nārado nāma nāmena ",
  "tha-ap425:2.2": "kassapo iti maṃ vidū ",
  "tha-ap425:2.3": "suddhimaggaṃ gavesanto ",
  "tha-ap425:2.4": "vasāmi kasike tadā. ",
  "tha-ap425:3.1": "padumuttaro nāma jino ",
  "tha-ap425:3.2": "sabbadhammāna pāragū ",
  "tha-ap425:3.3": "vivekakāmo sambuddho ",
  "tha-ap425:3.4": "āgañchi anilañjasā. ",
  "tha-ap425:4.1": "vanagge gacchamānassa ",
  "tha-ap425:4.2": "disvā raṃsiṃ mahesino ",
  "tha-ap425:4.3": "kaṭṭhamañcaṃ paññāpetvā ",
  "tha-ap425:4.4": "ajinañca apatthariṃ. ",
  "tha-ap425:5.1": "āsanaṃ paññāpetvāna ",
  "tha-ap425:5.2": "sīse katvāna añjaliṃ ",
  "tha-ap425:5.3": "somanassaṃ pavedetvā ",
  "tha-ap425:5.4": "idaṃ vacanamabraviṃ. ",
  "tha-ap425:6.1": "sallakatto tuvaṃ dhīra ",
  "tha-ap425:6.2": "āturānaṃ tikicchako ",
  "tha-ap425:6.3": "mama rāgaparetassa ",
  "tha-ap425:6.4": "tikicchaṃ dehi nāyaka. ",
  "tha-ap425:7.1": "puññatthikā ye passanti ",
  "tha-ap425:7.2": "buddhaseṭṭhaṃ tuvaṃ muni ",
  "tha-ap425:7.3": "dhuvatthasiddhiṃ papponti ",
  "tha-ap425:7.4": "etesaṃ ajaro bhave. ",
  "tha-ap425:8.1": "na me deyyaṃ tava atthi ",
  "tha-ap425:8.2": "pavattaphalabhojahaṃ ",
  "tha-ap425:8.3": "idaṃ me āsanaṃ atthi ",
  "tha-ap425:8.4": "nisīda kaṭṭhamañcake. ",
  "tha-ap425:9.1": "nisīdi tattha bhagavā ",
  "tha-ap425:9.2": "achambhitova kesarī ",
  "tha-ap425:9.3": "muhuttaṃ vītināmetvā ",
  "tha-ap425:9.4": "idaṃ vacanamabravi. ",
  "tha-ap425:10.1": "vissaṭṭho hohi mā bhāyi ",
  "tha-ap425:10.2": "laddho jotiraso tayā ",
  "tha-ap425:10.3": "yaṃ tuyhaṃ patthitaṃ sabbaṃ ",
  "tha-ap425:10.4": "paripūressatāsanaṃ. ",
  "tha-ap425:11.1": "na thokaṃ sukataṃ puññaṃ ",
  "tha-ap425:11.2": "puññakkhette anuttare ",
  "tha-ap425:11.3": "sakkā uddharituṃ attā ",
  "tha-ap425:11.4": "yassa cittaṃ sunīhitaṃ. iminā ",
  "tha-ap425:12.1": "āsanadānena ",
  "tha-ap425:12.2": "cetanāpaṇidhīhi ca ",
  "tha-ap425:12.3": "kappasatasahassāni ",
  "tha-ap425:12.4": "vinipātaṃ na gacchati. ",
  "tha-ap425:13.1": "paññāsakkhattuṃ devindo ",
  "tha-ap425:13.2": "devarajjaṃ karissati ",
  "tha-ap425:13.3": "asītikkhattuṃ rājā ca ",
  "tha-ap425:13.4": "cakkavatti bhavissati. ",
  "tha-ap425:14.1": "padesarajjaṃ vipulaṃ ",
  "tha-ap425:14.2": "gaṇanāto asaṅkhayaṃ ",
  "tha-ap425:14.3": "sabbattha sukhito hutvā ",
  "tha-ap425:14.4": "saṃsāre saṃsarissati. ",
  "tha-ap425:15.1": "idaṃ vatvāna sambuddho ",
  "tha-ap425:15.2": "jalajuttamanāmako ",
  "tha-ap425:15.3": "nabhaṃ abbhuggami dhīro ",
  "tha-ap425:15.4": "haṃsarājāva ambare. ",
  "tha-ap425:16.1": "hatthiyānaṃ assayānaṃ ",
  "tha-ap425:16.2": "sarathaṃ sandamānikaṃ ",
  "tha-ap425:16.3": "labhāmi sabbamevetaṃ ",
  "tha-ap425:16.4": "ekāsanassidaṃ phalaṃ. ",
  "tha-ap425:17.1": "kānanaṃ pavisitvāna ",
  "tha-ap425:17.2": "yadā icchāmi āsanaṃ ",
  "tha-ap425:17.3": "mama saṅkappamaññāya ",
  "tha-ap425:17.4": "pallaṅko upatiṭṭhati. ",
  "tha-ap425:18.1": "vārimajjhagato santo ",
  "tha-ap425:18.2": "yadā icchāmi āsanaṃ ",
  "tha-ap425:18.3": "mama saṅkappamaññāya ",
  "tha-ap425:18.4": "pallaṅko upatiṭṭhati. ",
  "tha-ap425:19.1": "yaṃ yaṃ yonūpapajjāmi ",
  "tha-ap425:19.2": "devattaṃ atha mānusaṃ ",
  "tha-ap425:19.3": "pallaṅkasatasahassāni ",
  "tha-ap425:19.4": "parivārenti maṃ sadā. ",
  "tha-ap425:20.1": "duve bhave saṃsarāmi ",
  "tha-ap425:20.2": "devatte atha mānuse ",
  "tha-ap425:20.3": "duve kule ca jāyāmi ",
  "tha-ap425:20.4": "khattiye cāpi brāhmaṇe. ",
  "tha-ap425:21.1": "ekāsanaṃ daditvāna ",
  "tha-ap425:21.2": "puññakkhette anuttare ",
  "tha-ap425:21.3": "dhammapallaṅkamaññāya ",
  "tha-ap425:21.4": "viharāmi anāsavo. ",
  "tha-ap425:22.1": "satasahasse ito kappe ",
  "tha-ap425:22.2": "yaṃ dānamadadiṃ tadā ",
  "tha-ap425:22.3": "duggatiṃ nābhijānāmi ",
  "tha-ap425:22.4": "ekāsanassidaṃ phalaṃ. ",
  "tha-ap425:23.1": "kilesā jhāpitā mayhaṃ ",
  "tha-ap425:23.2": "bhavā sabbe samūhatā nāgova bandhanaṃ chetvā ",
  "tha-ap425:23.3": "viharāmi anāsavo. ",
  "tha-ap425:24.1": "svāgataṃ vata me āsi ",
  "tha-ap425:24.2": "mama buddhassa santike tisso vijjā anuppattā ",
  "tha-ap425:24.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap425:25.1": "paṭisambhidā catasso ",
  "tha-ap425:25.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap425:25.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap425:26.1": "itthaṃ sudaṃ āyasmā ekāsanadāyako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap425:27.1": "ekāsanadāyakattherassa apadānaṃ samattaṃ. catutthaṃ sattakadambapupphiyattherāpadānaṃ (424) "
}
