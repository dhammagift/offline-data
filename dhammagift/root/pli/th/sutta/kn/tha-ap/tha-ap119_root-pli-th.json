{
  "tha-ap119:0.1": "",
  "tha-ap119:0.2": "",
  "tha-ap119:0.3": "",
  "tha-ap119:1.1": "yadā vipassi lokaggo ",
  "tha-ap119:1.2": "āyusaṅkhāramossaji ",
  "tha-ap119:1.3": "paṭhavī sampakampittha ",
  "tha-ap119:1.4": "medanījalamekhalā. ogataṃ ",
  "tha-ap119:2.1": "vitataṃ mayhaṃ ",
  "tha-ap119:2.2": "suci cittaṃ papañcakaṃ ",
  "tha-ap119:2.3": "bhavanaṃpi pakampittha ",
  "tha-ap119:2.4": "buddhassa āyusaṅkhaye. ",
  "tha-ap119:3.1": "tāso mayhaṃ samuppanno ",
  "tha-ap119:3.2": "bhavane sampakampite ",
  "tha-ap119:3.3": "uppādo nu kimatthāya ",
  "tha-ap119:3.4": "āloko vipulo ahu. ",
  "tha-ap119:4.1": "vessavaṇṇo idhāgamma ",
  "tha-ap119:4.2": "nibbāpesi mahājanaṃ ",
  "tha-ap119:4.3": "pāṇabhūtaṃ bhayaṃ natthi ",
  "tha-ap119:4.4": "ekaggā hotha sagāravā. ",
  "tha-ap119:5.1": "aho buddho aho dhammo ",
  "tha-ap119:5.2": "aho no satthusampadā ",
  "tha-ap119:5.3": "yasmiṃ uppajjamānasmiṃ ",
  "tha-ap119:5.4": "paṭhavī sampakampati. ",
  "tha-ap119:6.1": "buddhānubhāvaṃ kittetvā ",
  "tha-ap119:6.2": "kappaṃ saggamhi modahaṃ ",
  "tha-ap119:6.3": "avasesesu kappesu ",
  "tha-ap119:6.4": "kusalaṃ karitaṃ mayā. ",
  "tha-ap119:7.1": "ekanavute ito kappe ",
  "tha-ap119:7.2": "yaṃ saññamalabhiṃ tadā ",
  "tha-ap119:7.3": "duggatiṃ nābhijānāmi ",
  "tha-ap119:7.4": "buddhasaññāyidaṃ phalaṃ. ",
  "tha-ap119:8.1": "ito cuddasakappamhi ",
  "tha-ap119:8.2": "rājā āsiṃ patāpavā ",
  "tha-ap119:8.3": "samito nāma nāmena ",
  "tha-ap119:8.4": "cakkavatti mahabbalo. ",
  "tha-ap119:9.1": "paṭisambhidā catasso ",
  "tha-ap119:9.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap119:9.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap119:10.1": "itthaṃ sudaṃ āyasmā buddhasaññako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap119:11.1": "buddhasaññakattherassa apadānaṃ samattaṃ. aṭṭhamaṃ maggasaññakattherāpadānaṃ (118) "
}
