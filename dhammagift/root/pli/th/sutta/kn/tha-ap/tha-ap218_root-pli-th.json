  "tha-ap218:0.1": "",
  "tha-ap218:0.2": "",
  "tha-ap218:0.3": "",
  "tha-ap218:1.1": "assatthe haritobhāse ",
  "tha-ap218:1.2": "saṃvirūḷhamhi pādape ",
  "tha-ap218:1.3": "ekaṃ buddhagataṃ saññaṃ ",
  "tha-ap218:1.4": "alabhitthaṃ paṭissato. ",
  "tha-ap218:2.1": "ekatiṃse ito kappe ",
  "tha-ap218:2.2": "yaṃ saññamalabhiṃ tadā ",
  "tha-ap218:2.3": "tassā saññāya vāhasā ",
  "tha-ap218:2.4": "patto me āsavakkhayo. ",
  "tha-ap218:3.1": "ito terasakappamhi ",
  "tha-ap218:3.2": "vaniddho nāma khattiyo ",
  "tha-ap218:3.3": "sattaratanasampanno ",
  "tha-ap218:3.4": "cakkavatti mahabbalo. ",
  "tha-ap218:4.1": "paṭisambhidā catasso ",
  "tha-ap218:4.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap218:4.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap218:5.1": "itthaṃ sudaṃ āyasmā sandhito thero imā gāthāyo abhāsitthāti. ",
  "tha-ap218:6.1": "sandhitattherassa apadānaṃ samattaṃ. sattamaṃ tālavaṇṭadāyakattherāpadānaṃ (217) "
}
