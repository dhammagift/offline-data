{
  "tha-ap95:0.1": "",
  "tha-ap95:0.2": "",
  "tha-ap95:0.3": "",
  "tha-ap95:1.1": "tissassāhaṃ bhagavato ",
  "tha-ap95:1.2": "upaḍḍhadussamadāsahaṃ ",
  "tha-ap95:1.3": "paramakāruññapattomhi ",
  "tha-ap95:1.4": "duggatena samappito. ",
  "tha-ap95:2.1": "upaḍḍhadussaṃ datvāna ",
  "tha-ap95:2.2": "kappaṃ saggamhi modahaṃ ",
  "tha-ap95:2.3": "avasesesu kappesu ",
  "tha-ap95:2.4": "kusalañcakarimahaṃ. ",
  "tha-ap95:3.1": "dvenavute ito kappe ",
  "tha-ap95:3.2": "yaṃ dussamadadiṃ tadā ",
  "tha-ap95:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap95:3.4": "dussadānassidaṃ phalaṃ. ",
  "tha-ap95:4.1": "ekapaññāsakappamhi ",
  "tha-ap95:4.2": "rājāno cakkavattino ",
  "tha-ap95:4.3": "samantāodanā nāma ",
  "tha-ap95:4.4": "khattiyāsuṃ janādhipā. ",
  "tha-ap95:5.1": "paṭisambhidā catasso ",
  "tha-ap95:5.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap95:5.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap95:6.1": "itthaṃ sudaṃ āyasmā aḍḍhacelako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap95:7.1": "aḍḍhacelakattherassa apadānaṃ samattaṃ. catutthaṃ sūcidāyakattherāpadānaṃ (94) "
}
