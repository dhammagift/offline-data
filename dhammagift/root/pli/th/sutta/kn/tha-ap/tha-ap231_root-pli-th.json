{
  "tha-ap231:0.1": "",
  "tha-ap231:0.2": "",
  "tha-ap231:0.3": "",
  "tha-ap231:1.1": "asito nāma nāmena ",
  "tha-ap231:1.2": "mālākāro ahaṃ tadā ",
  "tha-ap231:1.3": "āveḷaṃ paggahetvāna ",
  "tha-ap231:1.4": "rañño dātuṃ vajāmahaṃ. ",
  "tha-ap231:2.1": "asampattomhi rājānaṃ ",
  "tha-ap231:2.2": "addasaṃ sikhināyakaṃ ",
  "tha-ap231:2.3": "haṭṭho haṭṭhena cittena ",
  "tha-ap231:2.4": "buddhassa abhiropayiṃ. ",
  "tha-ap231:3.1": "ekatiṃse ito kappe ",
  "tha-ap231:3.2": "yaṃ pupphamabhiropayiṃ ",
  "tha-ap231:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap231:3.4": "buddhapūjāyidaṃ phalaṃ. ",
  "tha-ap231:4.1": "pañcavīse ito kappe ",
  "tha-ap231:4.2": "rājā homi mahabbalo ",
  "tha-ap231:4.3": "vebhāro nāma nāmena ",
  "tha-ap231:4.4": "cakkavatti mahabbalo. ",
  "tha-ap231:5.1": "paṭisambhidā catasso ",
  "tha-ap231:5.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap231:5.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap231:6.1": "itthaṃ sudaṃ āyasmā sukatāveḷiyo thero imā gāthāyo abhāsitthāti. ",
  "tha-ap231:7.1": "sukatāveḷiyattherassa apadānaṃ samattaṃ. dasamaṃ ekavandaniyattherāpadānaṃ (230) "
}
