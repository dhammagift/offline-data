{
  "tha-ap273:0.1": "aṭṭhavīsatimo suvaṇṇabibbohanavaggo ",
  "tha-ap273:0.2": "",
  "tha-ap273:0.3": "",
  "tha-ap273:1.1": "paṭhamaṃ suvaṇṇabibbohaniyattherāpadānaṃ (271) ekāsanaṃ ahamadaṃ ",
  "tha-ap273:1.2": "pasanno sehi pāṇihi ",
  "tha-ap273:1.3": "bibbohanañca pādāsiṃ ",
  "tha-ap273:1.4": "uttamatthassa pattiyā. ",
  "tha-ap273:2.1": "ekanavute ito kappe ",
  "tha-ap273:2.2": "bibbohanamadāsahaṃ ",
  "tha-ap273:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap273:2.4": "bibbohanassidaṃ phalaṃ. ",
  "tha-ap273:3.1": "ito tesaṭṭhime kappe ",
  "tha-ap273:3.2": "asamo nāma khattiyo ",
  "tha-ap273:3.3": "sattaratanasampanno ",
  "tha-ap273:3.4": "cakkavatti mahabbalo. ",
  "tha-ap273:4.1": "paṭisambhidā catasso ",
  "tha-ap273:4.2": "vimokkhāpica aṭṭhime ",
  "tha-ap273:4.3": "chaḷabhiññā sacchikatā ",
  "tha-ap273:4.4": "kataṃ buddhassa sāsananti. ",
  "tha-ap273:5.1": "itthaṃ sudaṃ āyasmā suvaṇṇabibbohaniyo thero imā gāthāyo abhāsitthāti. ",
  "tha-ap273:6.1": "suvaṇṇabibbohaniyattherassa apadānaṃ samattaṃ. dutiyaṃ tilamuṭṭhiyattherāpadānaṃ (272) "
}
