  "tha-ap238:0.1": "",
  "tha-ap238:0.2": "",
  "tha-ap238:0.3": "",
  "tha-ap238:1.1": "nagare aruṇavatiyā ",
  "tha-ap238:1.2": "vaṇṇakāro ahaṃ tadā ",
  "tha-ap238:1.3": "cetiye dussabhaṇḍāni ",
  "tha-ap238:1.4": "nānāvaṇṇaṃ rajemahaṃ. ",
  "tha-ap238:2.1": "ekattiṃse ito kappe ",
  "tha-ap238:2.2": "yaṃ vaṇṇaṃ rajayiṃ tadā ",
  "tha-ap238:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap238:2.4": "vaṇṇadānassidaṃ phalaṃ. ",
  "tha-ap238:3.1": "ito tevīsatikappe ",
  "tha-ap238:3.2": "candasamasanāmako ",
  "tha-ap238:3.3": "sattaratanasampanno ",
  "tha-ap238:3.4": "cakkavatti mahabbalo. ",
  "tha-ap238:4.1": "paṭisambhidā catasso ",
  "tha-ap238:4.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap238:4.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap238:5.1": "itthaṃ sudaṃ āyasmā vaṇṇakārako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap238:6.1": "vaṇṇakārakattherassa apadānaṃ samattaṃ. sattamaṃ piyālapupphiyattherāpadānaṃ (237) "
}
