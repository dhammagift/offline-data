{
  "tha-ap274:0.1": "",
  "tha-ap274:0.2": "",
  "tha-ap274:0.3": "",
  "tha-ap274:1.1": "mama saṅkappamaññāya ",
  "tha-ap274:1.2": "satthā lokagganāyako ",
  "tha-ap274:1.3": "manomayena kāyena ",
  "tha-ap274:1.4": "iddhiyā upasaṅkami. ",
  "tha-ap274:2.1": "satthāraṃ upasaṅkantaṃ ",
  "tha-ap274:2.2": "vanditvā purisuttamaṃ ",
  "tha-ap274:2.3": "pasannacitto sumano ",
  "tha-ap274:2.4": "tilamuṭṭhimadāsahaṃ. ",
  "tha-ap274:3.1": "ekanavute ito kappe ",
  "tha-ap274:3.2": "yaṃ dānamadadiṃ tadā ",
  "tha-ap274:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap274:3.4": "tilamuṭṭhiyidaṃ phalaṃ. ",
  "tha-ap274:4.1": "ito soḷasakappamhi ",
  "tha-ap274:4.2": "gandhiyo nāma khattiyo ",
  "tha-ap274:4.3": "sattaratanasampanno ",
  "tha-ap274:4.4": "cakkavatti mahabbalo. ",
  "tha-ap274:5.1": "paṭisambhidā catasso ",
  "tha-ap274:5.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap274:5.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap274:6.1": "itthaṃ sudaṃ āyasmā tilamuṭṭhiyo thero imā gāthāyo abhāsitthāti. ",
  "tha-ap274:7.1": "tilamuṭṭhiyattherassa apadānaṃ samattaṃ. tatiyaṃ caṅkoṭakiyattherāpadānaṃ (273) "
}
