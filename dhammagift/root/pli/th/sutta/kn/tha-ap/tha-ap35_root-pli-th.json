{
  "tha-ap35:0.1": "",
  "tha-ap35:0.2": "",
  "tha-ap35:0.3": "",
  "tha-ap35:1.1": "padumuttaranāthassa ",
  "tha-ap35:1.2": "padumaṃ nāma cetiyaṃ ",
  "tha-ap35:1.3": "silāpaṭaṃ kārayitvāna ",
  "tha-ap35:1.4": "suvaṇṇenābhilepayiṃ. ",
  "tha-ap35:2.1": "ratanāmayachattañca ",
  "tha-ap35:2.2": "paggayha vālavījaniṃ ",
  "tha-ap35:2.3": "buddhassa abhiropesiṃ ",
  "tha-ap35:2.4": "lokabandhussa tādino. ",
  "tha-ap35:3.1": "yāvatā devatā bhummā ",
  "tha-ap35:3.2": "sabbe sannipatuṃ tadā ",
  "tha-ap35:3.3": "ratanāsanachattānaṃ ",
  "tha-ap35:3.4": "vipākaṃ kathayissati. ",
  "tha-ap35:4.1": "tañca sabbaṃ suṇissāma ",
  "tha-ap35:4.2": "kathayantassa satthuno ",
  "tha-ap35:4.3": "bhiyyo hāsaṃ janeyyāma ",
  "tha-ap35:4.4": "sammā sambuddhasāsane. ",
  "tha-ap35:5.1": "hemāsane nisīditvā ",
  "tha-ap35:5.2": "sayambhū aggapuggalo ",
  "tha-ap35:5.3": "bhikkhusaṅghaparibyuḷho ",
  "tha-ap35:5.4": "imā gāthā abhāsatha. ",
  "tha-ap35:6.1": "yenidaṃ āsanaṃ dinnaṃ ",
  "tha-ap35:6.2": "sovaṇṇaṃ ratanāmayaṃ ",
  "tha-ap35:6.3": "tamahaṃ kittayissāmi ",
  "tha-ap35:6.4": "suṇātha mama bhāsato. ",
  "tha-ap35:7.1": "tiṃsakappāni devindo ",
  "tha-ap35:7.2": "devarajjaṃ karissati ",
  "tha-ap35:7.3": "samantā yojanasataṃ ",
  "tha-ap35:7.4": "ābhāyābhibhavissati. ",
  "tha-ap35:8.1": "manussalokamāgantvā ",
  "tha-ap35:8.2": "cakkavatti bhavissati ",
  "tha-ap35:8.3": "pabhassaroti nāmena ",
  "tha-ap35:8.4": "uggatejo bhavissati. ",
  "tha-ap35:9.1": "divā vā yadivā rattiṃ ",
  "tha-ap35:9.2": "sataraṃsīva uggato ",
  "tha-ap35:9.3": "samantā aṭṭharatanaṃ ",
  "tha-ap35:9.4": "ujjotissati khattiyo. ",
  "tha-ap35:10.1": "kappasatasahassamhi ",
  "tha-ap35:10.2": "okkākakulasambhavo ",
  "tha-ap35:10.3": "gotamo nāma nāmena ",
  "tha-ap35:10.4": "satthā loke bhavissati. ",
  "tha-ap35:11.1": "tusitāhi cavitvāna ",
  "tha-ap35:11.2": "sukkamūlena codito ",
  "tha-ap35:11.3": "kaccāno nāma nāmena ",
  "tha-ap35:11.4": "brahmabandhu bhavissati. ",
  "tha-ap35:12.1": "so pacchā pabbajitvāna ",
  "tha-ap35:12.2": "buddho hessatyanāsavo ",
  "tha-ap35:12.3": "gotamo lokapajjoto ",
  "tha-ap35:12.4": "aggaṭṭhāne ṭhapessati. ",
  "tha-ap35:13.1": "saṅkhittaṃ pucchitaṃ pañhaṃ ",
  "tha-ap35:13.2": "vitthārena kathessati ",
  "tha-ap35:13.3": "kathayanto ca taṃ pañhaṃ ",
  "tha-ap35:13.4": "ajjhāsayaṃ puressati. ",
  "tha-ap35:14.1": "addhakule abhijāto ",
  "tha-ap35:14.2": "brāhmaṇo mantapāragū ",
  "tha-ap35:14.3": "ohāya dhanadhaññāni ",
  "tha-ap35:14.4": "pabbaji anagāriyaṃ. ",
  "tha-ap35:15.1": "saṅkhittenāpi pucchante ",
  "tha-ap35:15.2": "vitthārena kathemahaṃ ",
  "tha-ap35:15.3": "ajjhāsayantesaṃ pūremi ",
  "tha-ap35:15.4": "tosemi dipaduttamaṃ. ",
  "tha-ap35:16.1": "tosito me mahāvīro ",
  "tha-ap35:16.2": "sayambhū aggapuggalo ",
  "tha-ap35:16.3": "bhikkhusaṅghe nisīditvā ",
  "tha-ap35:16.4": "etadagge ṭhapesi maṃ. ",
  "tha-ap35:17.1": "paṭisambhidā catasso ",
  "tha-ap35:17.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap35:17.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap35:18.1": "itthaṃ sudaṃ āyasmā mahākaccāyano thero imā gāthāyo abhāsitthāti. ",
  "tha-ap35:19.1": "mahākaccāyanattherassa apadānaṃ samattaṃ. catutthaṃ kāḷudāyittherāpadānaṃ (34) "
}
