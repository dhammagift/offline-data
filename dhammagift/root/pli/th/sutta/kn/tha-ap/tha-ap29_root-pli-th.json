{
  "tha-ap29:0.1": "",
  "tha-ap29:0.2": "",
  "tha-ap29:0.3": "",
  "tha-ap29:1.1": "vipassissa bhagavato ",
  "tha-ap29:1.2": "bodhiyā pādamuttame purāṇaṃ ",
  "tha-ap29:1.3": "puḷinaṃ chaḍḍetvā suddhaṃ ",
  "tha-ap29:1.4": "puḷinamākiriṃ. ekanavute ",
  "tha-ap29:2.1": "ito kappe ",
  "tha-ap29:2.2": "yaṃ puḷinamadāsahaṃ ",
  "tha-ap29:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap29:2.4": "puḷinadānassidaṃ phalaṃ. ",
  "tha-ap29:3.1": "tipaññāse ito kappe ",
  "tha-ap29:3.2": "rājā āsiṃ janābhibhū mahāpuḷino ",
  "tha-ap29:3.3": "nāmena ",
  "tha-ap29:3.4": "cakkavatti mahabbalo. ",
  "tha-ap29:4.1": "paṭisambhidā catasso ",
  "tha-ap29:4.2": "vimokkhāpica aṭṭhime ",
  "tha-ap29:4.3": "chaḷabhiññā sacchikatā ",
  "tha-ap29:4.4": "kataṃ buddhassa sāsananti. ",
  "tha-ap29:5.1": "itthaṃ sudaṃ āyasmā puḷinapūjako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap29:6.1": "puḷinapūjakattherassa apadānaṃ samattaṃ. aṭṭhamaṃ uttiyattherāpadānaṃ (28) "
}
