{
  "tha-ap15:0.1": "",
  "tha-ap15:0.2": "",
  "tha-ap15:0.3": "",
  "tha-ap15:1.1": "padumuttarassa bhagavato ",
  "tha-ap15:1.2": "lokajeṭṭhassa tādino ",
  "tha-ap15:1.3": "vatthaṃ khomaṃ mayā dinnaṃ ",
  "tha-ap15:1.4": "sayambhussa mahesino. ",
  "tha-ap15:2.1": "tamme buddho viyākāsi ",
  "tha-ap15:2.2": "jalajuttamanāyako ",
  "tha-ap15:2.3": "iminā vatthadānena ",
  "tha-ap15:2.4": "hemavaṇṇo bhavissasi. ",
  "tha-ap15:3.1": "dvesampattiṃ anubhotvā ",
  "tha-ap15:3.2": "sukkamūlena codito ",
  "tha-ap15:3.3": "gotamassa bhagavato ",
  "tha-ap15:3.4": "kaniṭṭho tvaṃ bhavissasi. ",
  "tha-ap15:4.1": "rāgaratto sukhasīlo ",
  "tha-ap15:4.2": "kāmesu gedhamāyuto ",
  "tha-ap15:4.3": "buddhena codito santo ",
  "tha-ap15:4.4": "tato tvaṃ pabbajissasi. ",
  "tha-ap15:5.1": "pabbajitvāna tvaṃ tattha ",
  "tha-ap15:5.2": "kusalamūlena codito ",
  "tha-ap15:5.3": "sabbāsave pariññāya ",
  "tha-ap15:5.4": "nibbāyissatyanāsavo. ",
  "tha-ap15:6.1": "satakappasahassamhi ",
  "tha-ap15:6.2": "caturo celanāmakā ",
  "tha-ap15:6.3": "saṭṭhikappasahassamhi ",
  "tha-ap15:6.4": "upacelā catujjanā. ",
  "tha-ap15:7.1": "pañcakappasahassamhi ",
  "tha-ap15:7.2": "celāva caturo janā ",
  "tha-ap15:7.3": "sattaratanasampannā ",
  "tha-ap15:7.4": "catudīpamhi issarā. ",
  "tha-ap15:8.1": "paṭisambhidā catasso ",
  "tha-ap15:8.2": "vimokkhāpica aṭṭhime ",
  "tha-ap15:8.3": "chaḷabhiññā sacchikatā ",
  "tha-ap15:8.4": "kataṃ buddhassa sāsananti. ",
  "tha-ap15:9.1": "itthaṃ sudaṃ āyasmā nando thero imā gāthāyo abhāsitthāti. ",
  "tha-ap15:10.1": "nandattherassa apadānaṃ samattaṃ. catutthaṃ cullapanthakattherāpadānaṃ (14) "
}
