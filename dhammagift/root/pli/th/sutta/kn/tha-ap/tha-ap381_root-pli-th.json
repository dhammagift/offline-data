{
  "tha-ap381:0.1": "",
  "tha-ap381:0.2": "",
  "tha-ap381:0.3": "",
  "tha-ap381:1.1": "siddhatthassa bhagavato ",
  "tha-ap381:1.2": "nhātakassa tapassino ",
  "tha-ap381:1.3": "katvāna sumanadāmaṃ ",
  "tha-ap381:1.4": "dhārayiṃ purato ṭhito. ",
  "tha-ap381:2.1": "catunavute ito kappe ",
  "tha-ap381:2.2": "yaṃ dāmaṃ abhipūjayiṃ ",
  "tha-ap381:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap381:2.4": "sumanadāmassidaṃ phalaṃ. ",
  "tha-ap381:3.1": "svāgataṃ vata me āsi mama buddhassa santike tisso vijjā anuppattā kataṃ buddhassa sāsanaṃ. kilesā jhāpitā mayhaṃ ",
  "tha-ap381:3.2": "bhavā sabbe samūhatā nāgova bandhanaṃ chetvā ",
  "tha-ap381:3.3": "viharāmi anāsavo. ",
  "tha-ap381:4.1": "",
  "tha-ap381:4.2": "",
  "tha-ap381:4.3": "",
  "tha-ap381:5.1": "paṭisambhidā catasso ",
  "tha-ap381:5.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap381:5.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap381:6.1": "itthaṃ sudaṃ āyasmā sumanadāmiyo thero imā gāthāyo abhāsitthāti. ",
  "tha-ap381:7.1": "sumanadāmiyattherassa apadānaṃ samattaṃ. dasamaṃ kāsumāriphaladāyakattherāpadānaṃ (380) "
}
