{
  "tha-ap3:0.1": "",
  "tha-ap3:0.2": "",
  "tha-ap3:0.3": "",
  "tha-ap3:1.1": "atha therāpadānaṃ suṇātha ",
  "tha-ap3:2.1": "himavantassa avidūre ",
  "tha-ap3:2.2": "lambako nāma pabbato ",
  "tha-ap3:2.3": "assamo sukato mayhaṃ ",
  "tha-ap3:2.4": "paṇṇasālā sumāpitā. ",
  "tha-ap3:3.1": "uttānakūlā nadikā ",
  "tha-ap3:3.2": "supatitthā manoramā ",
  "tha-ap3:3.3": "susuddhapuḷinākiṇṇā ",
  "tha-ap3:3.4": "avidūre mamassamaṃ. ",
  "tha-ap3:4.1": "asakkharā apabbhārā ",
  "tha-ap3:4.2": "sādu appaṭigandhikā ",
  "tha-ap3:4.3": "sandanti nadikā tattha ",
  "tha-ap3:4.4": "sobhayantā mamassamaṃ. ",
  "tha-ap3:5.1": "kumbhīlā makarā cettha ",
  "tha-ap3:5.2": "suṃsumārā ca kacchapā ",
  "tha-ap3:5.3": "sandanti nadiyā tattha ",
  "tha-ap3:5.4": "sobhayantā mamassamaṃ. ",
  "tha-ap3:6.1": "pāṭhīnā pāvusā macchā ",
  "tha-ap3:6.2": "valajā muñjarohitā ",
  "tha-ap3:6.3": "vagguḷā papatāyanti ",
  "tha-ap3:6.4": "sobhayantā mamassamaṃ. ",
  "tha-ap3:7.1": "ubhokūlesu nadiyā ",
  "tha-ap3:7.2": "pupphino phalino dumā ",
  "tha-ap3:7.3": "ubhato atilambanti ",
  "tha-ap3:7.4": "sobhayantā mamassamaṃ. ",
  "tha-ap3:8.1": "ambā sālā ca tilakā ",
  "tha-ap3:8.2": "pāṭalī sinduvāritā dibbā ",
  "tha-ap3:8.3": "gandhā sampavanti ",
  "tha-ap3:8.4": "pupphitā mama assame. ",
  "tha-ap3:9.1": "campakā salaḷā nīpā ",
  "tha-ap3:9.2": "nāgapunnāgaketakā ",
  "tha-ap3:9.3": "dibbā gandhā sampavanti ",
  "tha-ap3:9.4": "pupphitā mama assame. ",
  "tha-ap3:10.1": "atimuttā asokā ca ",
  "tha-ap3:10.2": "bhaginīmālā ca pupphitā ",
  "tha-ap3:10.3": "aṅkolā bimbijālā ca ",
  "tha-ap3:10.4": "pupphitā mama assame. ",
  "tha-ap3:11.1": "ketakā kadalī ceva ",
  "tha-ap3:11.2": "kebukā tiṇasūlikā ",
  "tha-ap3:11.3": "dibbā gandhā sampavanti ",
  "tha-ap3:11.4": "sobhayantā mamassamaṃ. ",
  "tha-ap3:12.1": "kaṇikā kaṇṇikārā ca ",
  "tha-ap3:12.2": "asanā añjanā bahū ",
  "tha-ap3:12.3": "dibbā gandhā sampavanti ",
  "tha-ap3:12.4": "sobhayantā mamassamaṃ. ",
  "tha-ap3:13.1": "puṇṇāvā giripuṇṇāvā ",
  "tha-ap3:13.2": "koviḷārā ca pupphitā ",
  "tha-ap3:13.3": "dibbā gandhā sampavanti ",
  "tha-ap3:13.4": "sobhayantā mamassamaṃ. ",
  "tha-ap3:14.1": "uddālakā ca kuṭajā ",
  "tha-ap3:14.2": "kadambā bakulā bahū ",
  "tha-ap3:14.3": "dibbā gandhā sampavanti ",
  "tha-ap3:14.4": "sobhayantā mamassamaṃ. ",
  "tha-ap3:15.1": "āḷakā isimuggā ca ",
  "tha-ap3:15.2": "kadalī mātuluṅgiyo ",
  "tha-ap3:15.3": "gandhodakena saṃvaḍḍhā ",
  "tha-ap3:15.4": "phalāni dhārayanti te. ",
  "tha-ap3:16.1": "aññe pupphanti padumā ",
  "tha-ap3:16.2": "aññe jāyanti kesarī ",
  "tha-ap3:16.3": "aññe opupphā padumā ",
  "tha-ap3:16.4": "pupphitā taḷake tadā. ",
  "tha-ap3:17.1": "gabbhaṃ gaṇhanti padumā ",
  "tha-ap3:17.2": "niddhāvanti muḷāliyo ",
  "tha-ap3:17.3": "siṅghāṭapattamākiṇṇā ",
  "tha-ap3:17.4": "sobhayanti taḷake tadā. ",
  "tha-ap3:18.1": "nayitā ambagaṇḍī ca ",
  "tha-ap3:18.2": "uttarā hi bandhujīvakā ",
  "tha-ap3:18.3": "dibbā gandhā sampavanti ",
  "tha-ap3:18.4": "pupphitā taḷake tadā. ",
  "tha-ap3:19.1": "pāṭhīnā pāvusā macchā ",
  "tha-ap3:19.2": "valajā muñjarohitā ",
  "tha-ap3:19.3": "saṅkulā maggurā ceva ",
  "tha-ap3:19.4": "vasanti taḷake tadā. ",
  "tha-ap3:20.1": "kumbhīlā suṃsumārā ca ",
  "tha-ap3:20.2": "tantiggāhā ca rakkhasā ",
  "tha-ap3:20.3": "ogāhā ajagarā ca ",
  "tha-ap3:20.4": "vasanti taḷake tadā. ",
  "tha-ap3:21.1": "pārevatā ravihaṃsā ",
  "tha-ap3:21.2": "cakkavākā nadīcarā ",
  "tha-ap3:21.3": "kokilā suvasālikā ",
  "tha-ap3:21.4": "upajīvanti taṃ saraṃ. ",
  "tha-ap3:22.1": "kukkutthakā kuḷīrakā ",
  "tha-ap3:22.2": "vane pokkharasātakā ",
  "tha-ap3:22.3": "dindibhā suvapotā ca ",
  "tha-ap3:22.4": "upajīvanti taṃ saraṃ. ",
  "tha-ap3:23.1": "haṃsā koñcā mayurā ca ",
  "tha-ap3:23.2": "kokilā lambacūḷakā ",
  "tha-ap3:23.3": "campakā jīvajīvā ca ",
  "tha-ap3:23.4": "upajīvanti taṃ saraṃ. ",
  "tha-ap3:24.1": "kosikā poṭṭhasīsā ca ",
  "tha-ap3:24.2": "kurarā senakā bahū ",
  "tha-ap3:24.3": "mahākāḷā ca sakuṇā ",
  "tha-ap3:24.4": "upajīvanti taṃ saraṃ. ",
  "tha-ap3:25.1": "pasadā migā varāhā ca ",
  "tha-ap3:25.2": "vakā bheraṇḍakā bahū ",
  "tha-ap3:25.3": "rohiccā suttapotā ca ",
  "tha-ap3:25.4": "upajīvanti taṃ saraṃ. ",
  "tha-ap3:26.1": "sīhā byagghā ca dīpi ca ",
  "tha-ap3:26.2": "acchakokataracchabhi ",
  "tha-ap3:26.3": "tidhappabhinnā mātaṅgā ",
  "tha-ap3:26.4": "upajīvanti taṃ saraṃ. ",
  "tha-ap3:27.1": "kinnarā vānarā ceva ",
  "tha-ap3:27.2": "athopi vanakammikā ",
  "tha-ap3:27.3": "cetā ca luddakā ceva ",
  "tha-ap3:27.4": "upajīvanti taṃ saraṃ. ",
  "tha-ap3:28.1": "tindukāni piyālāni ",
  "tha-ap3:28.2": "madhukā kāsamāriyo ",
  "tha-ap3:28.3": "dhuvaṃ phalāni dhārenti ",
  "tha-ap3:28.4": "avidūre mamassamaṃ. ",
  "tha-ap3:29.1": "kosumbhā salaḷā nīpā ",
  "tha-ap3:29.2": "sāraphalasamāyutā ",
  "tha-ap3:29.3": "dhuvaṃ phalāni dhārenti ",
  "tha-ap3:29.4": "avidūre mamassamaṃ. ",
  "tha-ap3:30.1": "harītakā āmalakā ",
  "tha-ap3:30.2": "ambā jambū vibhedakā ",
  "tha-ap3:30.3": "kolā bhallātakā billā ",
  "tha-ap3:30.4": "phalāni dhārayanti te. ",
  "tha-ap3:31.1": "āluvā ca kalambā ca ",
  "tha-ap3:31.2": "biḷālitakkaḷāni ca ",
  "tha-ap3:31.3": "jīvakā sambakā ceva ",
  "tha-ap3:31.4": "bahukā mama assame. ",
  "tha-ap3:32.1": "assamassāvidūramhi ",
  "tha-ap3:32.2": "taḷākāsi sunimmitā ",
  "tha-ap3:32.3": "acchodakā sītajalā ",
  "tha-ap3:32.4": "supatitthā manoramā. ",
  "tha-ap3:33.1": "padumuppalasañchannā ",
  "tha-ap3:33.2": "puṇḍarīkasamāyutā ",
  "tha-ap3:33.3": "mandālakehi sañchannā ",
  "tha-ap3:33.4": "dibbo gandho pavāyati. ",
  "tha-ap3:34.1": "evaṃ sabbaṅgasampanne ",
  "tha-ap3:34.2": "pupphite phalite vane ",
  "tha-ap3:34.3": "sukate assame ramme ",
  "tha-ap3:34.4": "viharāmi ahaṃ tadā. ",
  "tha-ap3:35.1": "sīlavā vattasampanno ",
  "tha-ap3:35.2": "jhāyī jhānarato sadā ",
  "tha-ap3:35.3": "pañcābhiññābalappatto ",
  "tha-ap3:35.4": "suruci nāma tāpaso. ",
  "tha-ap3:36.1": "catubbīsasahassāni ",
  "tha-ap3:36.2": "sissā mayhaṃ upaṭṭhahuṃ ",
  "tha-ap3:36.3": "sabbeva brāhmaṇā ete ",
  "tha-ap3:36.4": "jātimanto yasassino. ",
  "tha-ap3:37.1": "lakkhaṇe itihāse ca ",
  "tha-ap3:37.2": "sanighaṇḍusakeṭubhe ",
  "tha-ap3:37.3": "padakā veyyākaraṇā ",
  "tha-ap3:37.4": "saddhamme pāramiṃ gatā. ",
  "tha-ap3:38.1": "uppātesu nimittesu ",
  "tha-ap3:38.2": "lakkhaṇesu ca kovidā ",
  "tha-ap3:38.3": "paṭhabyā bhummantalikkhe ",
  "tha-ap3:38.4": "mama sissā susikkhitā. ",
  "tha-ap3:39.1": "appicchā nipakā ete ",
  "tha-ap3:39.2": "appāhārā alolupā ",
  "tha-ap3:39.3": "lābhālābhena santuṭṭhā ",
  "tha-ap3:39.4": "parivārenti maṃ sadā. ",
  "tha-ap3:40.1": "jhāyī jhānaratā dhīrā ",
  "tha-ap3:40.2": "santacittā samāhitā ",
  "tha-ap3:40.3": "ākiñcaññaṃ patthayantā ",
  "tha-ap3:40.4": "parivārenti maṃ sadā. ",
  "tha-ap3:41.1": "abhiññāpāramippattā ",
  "tha-ap3:41.2": "pettike gocare ratā ",
  "tha-ap3:41.3": "antalikkhacarā dhīrā ",
  "tha-ap3:41.4": "parivārenti maṃ sadā. ",
  "tha-ap3:42.1": "saṃvutā chasu dvāresu ",
  "tha-ap3:42.2": "aneñjā rakkhitindriyā ",
  "tha-ap3:42.3": "asaṃsaṭṭhā ca te dhīrā ",
  "tha-ap3:42.4": "mama sissā durāsadā. ",
  "tha-ap3:43.1": "pallaṅkena nisajjāya ",
  "tha-ap3:43.2": "ṭhānā caṅkamanena ca ",
  "tha-ap3:43.3": "vītināmenti te rattiṃ ",
  "tha-ap3:43.4": "mama sissā durāsadā. ",
  "tha-ap3:44.1": "rajjanīye na rajjanti ",
  "tha-ap3:44.2": "dosanīye na dussare ",
  "tha-ap3:44.3": "mohanīye na muyhanti ",
  "tha-ap3:44.4": "mama sissā durāsadā. ",
  "tha-ap3:45.1": "iddhiṃ vimaṃsamānā te ",
  "tha-ap3:45.2": "vattanti niccakālikaṃ ",
  "tha-ap3:45.3": "paṭhaviṃ te pakampenti ",
  "tha-ap3:45.4": "sārambhena durāsadā. ",
  "tha-ap3:46.1": "kīḷamānāva te sissā ",
  "tha-ap3:46.2": "kīḷanti jhānakīḷitaṃ ",
  "tha-ap3:46.3": "jambuto phalamānenti ",
  "tha-ap3:46.4": "mama sissā durāsadā. ",
  "tha-ap3:47.1": "aññe gacchanti goyānaṃ ",
  "tha-ap3:47.2": "aññe pubbavidehanaṃ ",
  "tha-ap3:47.3": "aññe ca uttarakuruṃ ",
  "tha-ap3:47.4": "mama sissā durāsadā. ",
  "tha-ap3:48.1": "purato pesenti te khāriṃ ",
  "tha-ap3:48.2": "pacchato ca vajanti te ",
  "tha-ap3:48.3": "catubbīsasahassehi ",
  "tha-ap3:48.4": "chāditaṃ hoti ambaraṃ. ",
  "tha-ap3:49.1": "aggipākaṃ anaggiṃ ca ",
  "tha-ap3:49.2": "dantodukkhalikāpica ambanā ",
  "tha-ap3:49.3": "koṭikā keci ",
  "tha-ap3:49.4": "pavattaphalabhojanā. ",
  "tha-ap3:50.1": "udakorohakā keci ",
  "tha-ap3:50.2": "sāyaṃ pāto suciratā ",
  "tha-ap3:50.3": "toyābhisekacaraṇā ",
  "tha-ap3:50.4": "mama sissā durāsadā. ",
  "tha-ap3:51.1": "parūḷhakacchanakhalomā ",
  "tha-ap3:51.2": "paṅkadantā rajassirā ",
  "tha-ap3:51.3": "gandhitā sīlagandhena ",
  "tha-ap3:51.4": "mama sissā durāsadā. ",
  "tha-ap3:52.1": "pātova sannipātetvā ",
  "tha-ap3:52.2": "jaṭilā uggatāpanā ",
  "tha-ap3:52.3": "lābhālābhaṃ pakittetvā ",
  "tha-ap3:52.4": "gacchanti ambare tadā. ",
  "tha-ap3:53.1": "etesaṃ pakkamantānaṃ ",
  "tha-ap3:53.2": "mahāsaddo pavattati ",
  "tha-ap3:53.3": "ajinacammasaddena ",
  "tha-ap3:53.4": "moditā honti devatā. ",
  "tha-ap3:54.1": "disodisā pakkamanti ",
  "tha-ap3:54.2": "antalikkhacarā isī ",
  "tha-ap3:54.3": "sakabalenupatthaddhā ",
  "tha-ap3:54.4": "te gacchanti yathicchakaṃ. ",
  "tha-ap3:55.1": "paṭhavīkampakā ete ",
  "tha-ap3:55.2": "sabbeva nabhacārino ",
  "tha-ap3:55.3": "uggatejā duppasahā ",
  "tha-ap3:55.4": "sāgarova akhobhiyā. ",
  "tha-ap3:56.1": "ṭhānacaṅkamiyā keci ",
  "tha-ap3:56.2": "keci nesajjikā isī ",
  "tha-ap3:56.3": "pavattabhojanā keci ",
  "tha-ap3:56.4": "mama sissā durāsadā. ",
  "tha-ap3:57.1": "mettāvihārino ete ",
  "tha-ap3:57.2": "hitesī sabbapāṇinaṃ ",
  "tha-ap3:57.3": "anattukkaṃsakā sabbe ",
  "tha-ap3:57.4": "na te vambhenti kassaci. ",
  "tha-ap3:58.1": "sīharājāva sambhītā ",
  "tha-ap3:58.2": "gajarājāva thāmavā ",
  "tha-ap3:58.3": "durāsadā byagghāriva ",
  "tha-ap3:58.4": "āgacchanti mamantike. ",
  "tha-ap3:59.1": "vijjādharā devatā ca ",
  "tha-ap3:59.2": "nāgagandhabbarakkhasā ",
  "tha-ap3:59.3": "kumbhaṇḍā dānavā garuḷā ",
  "tha-ap3:59.4": "upajīvanti taṃ saraṃ. ",
  "tha-ap3:60.1": "te jaṭākhāribharitā ",
  "tha-ap3:60.2": "ajinuttaravāsino ",
  "tha-ap3:60.3": "antalikkhacarā sabbe ",
  "tha-ap3:60.4": "upajīvanti taṃ saraṃ. ",
  "tha-ap3:61.1": "tadānucchavikā ete ",
  "tha-ap3:61.2": "aññamaññaṃ sagāravā ",
  "tha-ap3:61.3": "catubbīsasahassānaṃ ",
  "tha-ap3:61.4": "khittasaddo na vijjati. ",
  "tha-ap3:62.1": "pāde pādaṃ nikkhipantā ",
  "tha-ap3:62.2": "appasaddā susaṃvutā ",
  "tha-ap3:62.3": "upasaṅkamma sabbe te ",
  "tha-ap3:62.4": "sirasā vandare mamaṃ. ",
  "tha-ap3:63.1": "tehi sissehi parivuto ",
  "tha-ap3:63.2": "santehi ca tapassibhi ",
  "tha-ap3:63.3": "vasāmi assame tattha ",
  "tha-ap3:63.4": "jhāyī jhānarato ahaṃ. ",
  "tha-ap3:64.1": "isīnaṃ sīlagandhena ",
  "tha-ap3:64.2": "pupphagandhena cūbhayaṃ ",
  "tha-ap3:64.3": "phalīnaṃ phalagandhena ",
  "tha-ap3:64.4": "gandhito hoti assamo. ",
  "tha-ap3:65.1": "rattindivaṃ na jānāmi ",
  "tha-ap3:65.2": "arati me na vijjati ",
  "tha-ap3:65.3": "sake sisse ovadanto ",
  "tha-ap3:65.4": "bhiyyo hāsaṃ labhāmahaṃ. ",
  "tha-ap3:66.1": "pupphānaṃ pupphamānānaṃ ",
  "tha-ap3:66.2": "phalānañca vipaccataṃ ",
  "tha-ap3:66.3": "dibbā gandhā pavāyanti ",
  "tha-ap3:66.4": "sobhayantā mamassamaṃ. ",
  "tha-ap3:67.1": "samādhimhā vuṭṭhahitvā ",
  "tha-ap3:67.2": "ātāpī nipako ahaṃ ",
  "tha-ap3:67.3": "khāribhāraṃ gahetvāna ",
  "tha-ap3:67.4": "vanaṃ ajjhogahiṃ ahaṃ. ",
  "tha-ap3:68.1": "uppāte supine cāpi ",
  "tha-ap3:68.2": "lakkhaṇesu susikkhito ",
  "tha-ap3:68.3": "pavattamānaṃ mantapadaṃ ",
  "tha-ap3:68.4": "dhārayāmi ahaṃ tadā. ",
  "tha-ap3:69.1": "anomadassī bhagavā ",
  "tha-ap3:69.2": "lokajeṭṭho narāsabho ",
  "tha-ap3:69.3": "vivekakāmo sambuddho ",
  "tha-ap3:69.4": "himavantaṃ upāgami. ",
  "tha-ap3:70.1": "ajjhogahetvā himavantaṃ ",
  "tha-ap3:70.2": "aggo kāruṇiko muni ",
  "tha-ap3:70.3": "pallaṅkaṃ ābhujitvāna ",
  "tha-ap3:70.4": "nisīdi purisuttamo. ",
  "tha-ap3:71.1": "tamaddasāhaṃ sambuddhaṃ ",
  "tha-ap3:71.2": "sappabhāsaṃ manoramaṃ ",
  "tha-ap3:71.3": "indīvaraṃva jalitaṃ ",
  "tha-ap3:71.4": "ādittaṃva hutāsanaṃ. ",
  "tha-ap3:72.1": "jalantaṃ dīparukkhaṃva ",
  "tha-ap3:72.2": "vijjajava gagaṇe yathā ",
  "tha-ap3:72.3": "suphullaṃ sālarājaṃva ",
  "tha-ap3:72.4": "addasaṃ lokanāyakaṃ. ",
  "tha-ap3:73.1": "ayaṃ nāgo mahāvīro ",
  "tha-ap3:73.2": "dukkhassantakaro muni ",
  "tha-ap3:73.3": "imaṃ dassanamāgamma ",
  "tha-ap3:73.4": "sabbadukkhā pamuccare. ",
  "tha-ap3:74.1": "disvānāhaṃ devadevaṃ ",
  "tha-ap3:74.2": "lakkhaṇaṃ upadhārayiṃ ",
  "tha-ap3:74.3": "buddho nu kho na vā buddho ",
  "tha-ap3:74.4": "handa passāmi cakkhumaṃ. ",
  "tha-ap3:75.1": "sahassārāni cakkāni ",
  "tha-ap3:75.2": "dissanti caraṇuttame ",
  "tha-ap3:75.3": "lakkhaṇānissa disvāna ",
  "tha-ap3:75.4": "niṭṭhaṃ gañchiṃ tathāgate. ",
  "tha-ap3:76.1": "sammajjaniṃ gahetvā ",
  "tha-ap3:76.2": "sammajjitvānahaṃ tadā ",
  "tha-ap3:76.3": "aṭṭha pupphe samānetvā ",
  "tha-ap3:76.4": "buddhaseṭṭhaṃ apūjayiṃ. ",
  "tha-ap3:77.1": "pūjayitvāna taṃ buddhaṃ ",
  "tha-ap3:77.2": "oghatiṇṇamanāsavaṃ ",
  "tha-ap3:77.3": "ekaṃsaṃ ajinaṃ katvā ",
  "tha-ap3:77.4": "namassiṃ lokanāyakaṃ. ",
  "tha-ap3:78.1": "yena ñāṇena sambuddho ",
  "tha-ap3:78.2": "viharati anāsavo ",
  "tha-ap3:78.3": "taṃ ñāṇaṃ kittayissāmi ",
  "tha-ap3:78.4": "suṇātha mama bhāsato. ",
  "tha-ap3:79.1": "samuddharayimaṃ lokaṃ ",
  "tha-ap3:79.2": "sayambhu amitodaya ",
  "tha-ap3:79.3": "tava dassanamāgamma ",
  "tha-ap3:79.4": "kaṅkhāsotaṃ taranti te. ",
  "tha-ap3:80.1": "tuvaṃ satthā ca ketu ca ",
  "tha-ap3:80.2": "dhajo yūpo ca pāṇinaṃ ",
  "tha-ap3:80.3": "parāyano patiṭṭhā ca ",
  "tha-ap3:80.4": "dīpo ca dipaduttamo. ",
  "tha-ap3:81.1": "sakkā samudde udakaṃ ",
  "tha-ap3:81.2": "pametuṃ āḷhakena vā ",
  "tha-ap3:81.3": "na tveva tava sabbaññu ",
  "tha-ap3:81.4": "ñāṇaṃ sakkā pametave. ",
  "tha-ap3:82.1": "dhāretuṃ paṭhaviṃ sakkā ",
  "tha-ap3:82.2": "ṭhapetvā tulamaṇḍale ",
  "tha-ap3:82.3": "na tveva tava sabbaññu ",
  "tha-ap3:82.4": "ñāṇaṃ sakkā pametave. ",
  "tha-ap3:83.1": "ākāsaṃ minituṃ sakkā ",
  "tha-ap3:83.2": "rajjunā aṅgulena vā ",
  "tha-ap3:83.3": "na tveva tava sabbaññu ",
  "tha-ap3:83.4": "ñāṇaṃ sakkā pametave. ",
  "tha-ap3:84.1": "mahāsamudde udakaṃ ",
  "tha-ap3:84.2": "paṭhaviñcākhilañjahe ",
  "tha-ap3:84.3": "buddhañāṇaṃ upādāya ",
  "tha-ap3:84.4": "upamāto na yujjare. ",
  "tha-ap3:85.1": "sadevakassa lokassa ",
  "tha-ap3:85.2": "cittaṃ yesaṃ pavattati ",
  "tha-ap3:85.3": "antojāligatā ete ",
  "tha-ap3:85.4": "tava ñāṇamhi cakkhuma. ",
  "tha-ap3:86.1": "yena ñāṇena pattosi ",
  "tha-ap3:86.2": "kevalaṃ bodhimuttamaṃ ",
  "tha-ap3:86.3": "tena ñāṇena sabbaññu ",
  "tha-ap3:86.4": "maddasi paratitthiye. ",
  "tha-ap3:87.1": "imā gāthā paṭhetvāna ",
  "tha-ap3:87.2": "suruci nāma tāpaso ",
  "tha-ap3:87.3": "ajinaṃ pattharitvāna ",
  "tha-ap3:87.4": "paṭhaviyaṃ nisīdi so. ",
  "tha-ap3:88.1": "cullāsītisahassāni ",
  "tha-ap3:88.2": "ajjhogāḷho mahaṇṇave ",
  "tha-ap3:88.3": "accuggato tāvadeva ",
  "tha-ap3:88.4": "girirājā pavuccati. ",
  "tha-ap3:89.1": "tāva accuggato neru ",
  "tha-ap3:89.2": "āyato vitthato ca so ",
  "tha-ap3:89.3": "cuṇṇito saṃkhyabhedena ",
  "tha-ap3:89.4": "koṭisatasahassiyo. ",
  "tha-ap3:90.1": "lakkhe ṭhapiyamānamhi ",
  "tha-ap3:90.2": "parikkhayamagacchatha ",
  "tha-ap3:90.3": "na tveva tava sabbaññu ",
  "tha-ap3:90.4": "ñāṇaṃ sakkā pametave. ",
  "tha-ap3:91.1": "sukhumacchikena jālena ",
  "tha-ap3:91.2": "udakaṃ yo parikkhipe ",
  "tha-ap3:91.3": "ye keci udake pāṇā ",
  "tha-ap3:91.4": "antojāligatā siyuṃ. ",
  "tha-ap3:92.1": "tatheva hi mahāvīra ",
  "tha-ap3:92.2": "ye keci puthutitthiyā ",
  "tha-ap3:92.3": "diṭṭhiggahaṇapakkhantā ",
  "tha-ap3:92.4": "parāmāsena mohitā. ",
  "tha-ap3:93.1": "tava suddhena ñāṇena ",
  "tha-ap3:93.2": "anāvaraṇadassinā ",
  "tha-ap3:93.3": "antojāligatā ete ",
  "tha-ap3:93.4": "ñāṇante nātivattare. ",
  "tha-ap3:94.1": "bhagavā ca tamhi samaye ",
  "tha-ap3:94.2": "anomadassī mahāyaso ",
  "tha-ap3:94.3": "vuṭṭhahitvā samādhimhā ",
  "tha-ap3:94.4": "disaṃ olokayī jino. ",
  "tha-ap3:95.1": "anomadassimunino ",
  "tha-ap3:95.2": "nisabho nāma sāvako ",
  "tha-ap3:95.3": "parivuto satasahassehi ",
  "tha-ap3:95.4": "santacittehi tādibhi. ",
  "tha-ap3:96.1": "khīṇāsavehi suddhehi ",
  "tha-ap3:96.2": "chaḷabhiññehi tādihi ",
  "tha-ap3:96.3": "cittamaññāya buddhassa ",
  "tha-ap3:96.4": "upesi lokanāyakaṃ. ",
  "tha-ap3:97.1": "antalikkhe ṭhitā tattha ",
  "tha-ap3:97.2": "padakkhiṇamakaṃsu te ",
  "tha-ap3:97.3": "namassantā pañjalikā ",
  "tha-ap3:97.4": "oruhuṃ buddhasantike. ",
  "tha-ap3:98.1": "amodassī bhagavā ",
  "tha-ap3:98.2": "lokajeṭṭho narāsabho ",
  "tha-ap3:98.3": "bhikkhusaṅghe nisīditvā ",
  "tha-ap3:98.4": "sitaṃ pātuṃ karī jino. ",
  "tha-ap3:99.1": "varuṇo nāmupaṭṭhāko ",
  "tha-ap3:99.2": "anomadassissa satthuno ",
  "tha-ap3:99.3": "ekaṃsaṃ cīvaraṃ katvā ",
  "tha-ap3:99.4": "āpucchi lokanāyakaṃ. ",
  "tha-ap3:100.1": "ko nu kho bhagavā hetu ",
  "tha-ap3:100.2": "sitakammassa satthuno ",
  "tha-ap3:100.3": "na hi buddhā ahetūhi ",
  "tha-ap3:100.4": "sitaṃ pātuṃ karonti te. ",
  "tha-ap3:101.1": "anomadassī bhagavā ",
  "tha-ap3:101.2": "lokajeṭṭho narāsabho ",
  "tha-ap3:101.3": "bhikkhumajjhe nisīditvā ",
  "tha-ap3:101.4": "imaṃ gāthaṃ abhāsatha. ",
  "tha-ap3:102.1": "yo maṃ pupphena pūjesi ",
  "tha-ap3:102.2": "ñāṇañcāpi anutthavi ",
  "tha-ap3:102.3": "tamahaṃ kittayissāmi ",
  "tha-ap3:102.4": "suṇātha mama bhāsato. ",
  "tha-ap3:103.1": "buddhassa giramaññāya ",
  "tha-ap3:103.2": "sabbe devā samānusā ",
  "tha-ap3:103.3": "saddhammaṃ sotukāmā te ",
  "tha-ap3:103.4": "sambuddhaṃ upasaṅkamuṃ. ",
  "tha-ap3:104.1": "dasasu lokadhātūsu ",
  "tha-ap3:104.2": "devakāyā mahiddhikā ",
  "tha-ap3:104.3": "saddhammaṃ sotukāmā te ",
  "tha-ap3:104.4": "sambuddhaṃ upasaṅkamuṃ. ",
  "tha-ap3:105.1": "hatthī assā rathā pattī ",
  "tha-ap3:105.2": "senā ca caturaṅginī ",
  "tha-ap3:105.3": "parivāressantimaṃ niccaṃ ",
  "tha-ap3:105.4": "buddhapūjāyidaṃ phalaṃ. ",
  "tha-ap3:106.1": "saṭṭhī turiyasahassāni ",
  "tha-ap3:106.2": "bheriyo samalaṅkatā ",
  "tha-ap3:106.3": "upaṭṭhissantimaṃ niccaṃ ",
  "tha-ap3:106.4": "buddhapūjāyidaṃ phalaṃ. ",
  "tha-ap3:107.1": "soḷasitthīsahassāni ",
  "tha-ap3:107.2": "nāriyo samalaṅkatā ",
  "tha-ap3:107.3": "vicittavatthābharaṇā ",
  "tha-ap3:107.4": "āmuttamaṇikuṇḍalā. ",
  "tha-ap3:108.1": "āḷāramukhā hasulā ",
  "tha-ap3:108.2": "susaññā tanumajjhimā ",
  "tha-ap3:108.3": "parivāressantimaṃ niccaṃ ",
  "tha-ap3:108.4": "buddhapūjāyidaṃ phalaṃ. ",
  "tha-ap3:109.1": "kappasatasahassāni ",
  "tha-ap3:109.2": "devaloke ramissati ",
  "tha-ap3:109.3": "sahassakkhattuṃ cakkavatti ",
  "tha-ap3:109.4": "rājā raṭṭhe bhavissati. ",
  "tha-ap3:110.1": "sahassakkhattuṃ devindo ",
  "tha-ap3:110.2": "devarajjaṃ karissati ",
  "tha-ap3:110.3": "padesarajjaṃ vipulaṃ ",
  "tha-ap3:110.4": "gaṇanāto asaṅkhayaṃ. ",
  "tha-ap3:111.1": "pacchime bhavasampatte ",
  "tha-ap3:111.2": "manussattaṃ gamissati ",
  "tha-ap3:111.3": "brāhmaṇisāriyā nāma ",
  "tha-ap3:111.4": "dhārayissati kucchinā. ",
  "tha-ap3:112.1": "mātuyā nāmagottena ",
  "tha-ap3:112.2": "paññāyissatiyaṃ naro ",
  "tha-ap3:112.3": "sārīputtoti nāmena ",
  "tha-ap3:112.4": "tikkhapañño bhavissati. ",
  "tha-ap3:113.1": "asītikoṭī chaḍḍetvā ",
  "tha-ap3:113.2": "pabbajissatikiñcano ",
  "tha-ap3:113.3": "gavesanto santipadaṃ ",
  "tha-ap3:113.4": "carissati mahiṃ imaṃ. ",
  "tha-ap3:114.1": "aparimeyye ito kappe ",
  "tha-ap3:114.2": "okkākakulasambhavo ",
  "tha-ap3:114.3": "gotamo nāma gottena ",
  "tha-ap3:114.4": "satthā loke bhavissati. ",
  "tha-ap3:115.1": "tassa dhammesu dāyādo ",
  "tha-ap3:115.2": "oraso dhammanimmito ",
  "tha-ap3:115.3": "sārīputtoti nāmena ",
  "tha-ap3:115.4": "hessati aggasāvako. ",
  "tha-ap3:116.1": "ayaṃ bhāgīrasī gaṅgā ",
  "tha-ap3:116.2": "himavantā pabhāvitā ",
  "tha-ap3:116.3": "mahāsamuddamappeti ",
  "tha-ap3:116.4": "tappayantī mahodadhiṃ. ",
  "tha-ap3:117.1": "tathevāyaṃ sārīputto ",
  "tha-ap3:117.2": "sakko tīsu visārado ",
  "tha-ap3:117.3": "paññāya pāramiṃ gantvā ",
  "tha-ap3:117.4": "tappayissati pāṇino. himavantaṃ ",
  "tha-ap3:118.1": "upādāya ",
  "tha-ap3:118.2": "sāgarañca mahodadhiṃ ",
  "tha-ap3:118.3": "etthantare yaṃ puḷinaṃ ",
  "tha-ap3:118.4": "gaṇanāto asaṅkhayaṃ. ",
  "tha-ap3:119.1": "tampi sakkā asesena ",
  "tha-ap3:119.2": "saṅkhyātuṃ gaṇanā yathā ",
  "tha-ap3:119.3": "na tveva sārīputtassa ",
  "tha-ap3:119.4": "paññāyanto bhavissati. ",
  "tha-ap3:120.1": "lakkhe ṭhapiyamānamhi ",
  "tha-ap3:120.2": "khīye gaṅgāya vālukā ",
  "tha-ap3:120.3": "na tveva sārīputtassa ",
  "tha-ap3:120.4": "paññāyanto bhavissati. ",
  "tha-ap3:121.1": "mahāsamudde ūmiyo ",
  "tha-ap3:121.2": "gaṇanāto asaṅkhayā ",
  "tha-ap3:121.3": "tatheva sārīputtassa ",
  "tha-ap3:121.4": "paññāyanto na hessati. ",
  "tha-ap3:122.1": "ārādhayitvā sambuddhaṃ ",
  "tha-ap3:122.2": "gotamaṃ sakyapuṅgavaṃ ",
  "tha-ap3:122.3": "paññāya pāramiṃ gantvā ",
  "tha-ap3:122.4": "hessati aggasāvako. ",
  "tha-ap3:123.1": "pavattitaṃ dhammacakkaṃ ",
  "tha-ap3:123.2": "sakyaputtena tādinā ",
  "tha-ap3:123.3": "anuvattissati sammā ",
  "tha-ap3:123.4": "vassanto dhammavuṭṭhiyo. ",
  "tha-ap3:124.1": "sabbametaṃ abhiññāya ",
  "tha-ap3:124.2": "gotamo sakyapuṅgavo ",
  "tha-ap3:124.3": "bhikkhusaṅghe nisīditvā ",
  "tha-ap3:124.4": "aggaṭṭhāne ṭhapessati. ",
  "tha-ap3:125.1": "aho me sukataṃ kammaṃ ",
  "tha-ap3:125.2": "anomadassissa satthuno ",
  "tha-ap3:125.3": "yassādhikāraṃ katvāna ",
  "tha-ap3:125.4": "sabbattha pāramiṃ gato. ",
  "tha-ap3:126.1": "aparimeyye kataṃ kammaṃ ",
  "tha-ap3:126.2": "phalaṃ dassesi me idha ",
  "tha-ap3:126.3": "sumutto saravegova ",
  "tha-ap3:126.4": "kilese jhāpayiṃ ahaṃ. ",
  "tha-ap3:127.1": "asaṅkhataṃ gavesanto ",
  "tha-ap3:127.2": "nibbānaṃ acalaṃ padaṃ ",
  "tha-ap3:127.3": "vicinaṃ titthiye sabbe ",
  "tha-ap3:127.4": "esāhaṃ saṃsariṃ bhave. ",
  "tha-ap3:128.1": "yathāpi byādhiko poso ",
  "tha-ap3:128.2": "pariyeseyya osathaṃ ",
  "tha-ap3:128.3": "vicineyya dhanaṃ sabbaṃ ",
  "tha-ap3:128.4": "byādhito parimuttiyā. ",
  "tha-ap3:129.1": "asaṅkhataṃ gavesanto ",
  "tha-ap3:129.2": "nibbānaṃ amataṃ padaṃ ",
  "tha-ap3:129.3": "abbokiṇṇaṃ pañcasataṃ ",
  "tha-ap3:129.4": "pabbajiṃ isipabbajaṃ. ",
  "tha-ap3:130.1": "jaṭāya bhārabharito ",
  "tha-ap3:130.2": "ajinuttaranivāsahaṃ ",
  "tha-ap3:130.3": "abhiññāpāramiṃ gantvā ",
  "tha-ap3:130.4": "brahmalokaṃ agañchahaṃ. ",
  "tha-ap3:131.1": "natthi bāhirake suddhi ",
  "tha-ap3:131.2": "ṭhapetvā jinasāsanaṃ ",
  "tha-ap3:131.3": "ye keci buddhimā sattā ",
  "tha-ap3:131.4": "sujjhanti jinasāsane. ",
  "tha-ap3:132.1": "atthakāmaṃ mamametaṃ na hi ",
  "tha-ap3:132.2": "nisiṃ ahaṃ iti ",
  "tha-ap3:132.3": "asaṅkhataṃ gavesanto ",
  "tha-ap3:132.4": "kutitthaṃ sañcariṃ ahaṃ. ",
  "tha-ap3:133.1": "yathā sāratthiko poso ",
  "tha-ap3:133.2": "kadaliṃ chetvāna phālaye ",
  "tha-ap3:133.3": "na tattha sāraṃ vindeyya ",
  "tha-ap3:133.4": "sārena rittako hi so. ",
  "tha-ap3:134.1": "tatheva titthiyā loke ",
  "tha-ap3:134.2": "nānādiṭṭhī bahū janā ",
  "tha-ap3:134.3": "asaṅkhatena rittā te ",
  "tha-ap3:134.4": "sārena kadalī yathā. ",
  "tha-ap3:135.1": "pacchime bhavasampatte ",
  "tha-ap3:135.2": "brahmabandhu ahosahaṃ ",
  "tha-ap3:135.3": "mahābhogaṃ chaḍḍayitvāna ",
  "tha-ap3:135.4": "pabbajiṃ anagāriyaṃ. ",
  "tha-ap3:136.1": "paṭhamabhāṇavāraṃ. ",
  "tha-ap3:137.1": "ajjhāyako mantadharo ",
  "tha-ap3:137.2": "tiṇṇaṃ vedāna pāragū ",
  "tha-ap3:137.3": "brāhmaṇo sañjayo nāma ",
  "tha-ap3:137.4": "tassa mūle vasāmahaṃ. ",
  "tha-ap3:138.1": "sāvako te mahāvīra ",
  "tha-ap3:138.2": "assaji nāma brāhmaṇo ",
  "tha-ap3:138.3": "durāsado uggatejo ",
  "tha-ap3:138.4": "piṇḍāya caratī tadā. ",
  "tha-ap3:139.1": "tamaddasāsiṃ sappaññaṃ ",
  "tha-ap3:139.2": "muniṃ mone samāhitaṃ ",
  "tha-ap3:139.3": "santacittaṃ mahānāgaṃ ",
  "tha-ap3:139.4": "suphullaṃ padumaṃ yathā. ",
  "tha-ap3:140.1": "disvā me cittamuppajji ",
  "tha-ap3:140.2": "sudantaṃ suddhamānasaṃ ",
  "tha-ap3:140.3": "usabhaṃ pavaraṃ vīraṃ ",
  "tha-ap3:140.4": "arahāyaṃ bhavissati. ",
  "tha-ap3:141.1": "pāsādiko iriyati ",
  "tha-ap3:141.2": "abhirūpo susaṃvuto ",
  "tha-ap3:141.3": "uttame damathe danto ",
  "tha-ap3:141.4": "amatadassī bhavissati. ",
  "tha-ap3:142.1": "yannūnāhaṃ uttamatthaṃ ",
  "tha-ap3:142.2": "puccheyyaṃ tuṭṭhamānasaṃ ",
  "tha-ap3:142.3": "so ce puṭṭho kathissati ",
  "tha-ap3:142.4": "paṭipucchāmahantadā. piṇḍacāraṃ ",
  "tha-ap3:143.1": "carantassa ",
  "tha-ap3:143.2": "pacchato agamāsahaṃ ",
  "tha-ap3:143.3": "okāsaṃ paṭimānento ",
  "tha-ap3:143.4": "pucchituṃ amataṃ padaṃ. ",
  "tha-ap3:144.1": "vīthantare anuppattaṃ ",
  "tha-ap3:144.2": "upagantvāna pucchahaṃ ",
  "tha-ap3:144.3": "kathaṃ gottosi tvaṃ vīra ",
  "tha-ap3:144.4": "kassa sissosi mārisa. ",
  "tha-ap3:145.1": "so me puṭṭho viyākāsi ",
  "tha-ap3:145.2": "asambhītova kesarī ",
  "tha-ap3:145.3": "buddho loke samuppanno ",
  "tha-ap3:145.4": "tassa sissomhi āvuso. ",
  "tha-ap3:146.1": "kidisante mahāvīra ",
  "tha-ap3:146.2": "anujāta mahāyasa ",
  "tha-ap3:146.3": "buddhassa sāsanaṃ dhammaṃ ",
  "tha-ap3:146.4": "sādhu me kathayassu bho. ",
  "tha-ap3:147.1": "so me puṭṭho kathī sabbaṃ ",
  "tha-ap3:147.2": "gambhīraṃ nipuṇaṃ padaṃ ",
  "tha-ap3:147.3": "taṇhāsallassa hantāraṃ ",
  "tha-ap3:147.4": "sabbadukkhāpanūdanaṃ. ",
  "tha-ap3:148.1": "ye dhammā hetupabhavā ",
  "tha-ap3:148.2": "tesaṃ hetuṃ tathāgato āha ",
  "tha-ap3:148.3": "tesañca yo nirodho ",
  "tha-ap3:148.4": "evaṃvādī mahāsamaṇo. ",
  "tha-ap3:149.1": "sohaṃ vissajjite pañhe ",
  "tha-ap3:149.2": "paṭhamaṃ phalamajjhagaṃ ",
  "tha-ap3:149.3": "virajo vimalo āsiṃ ",
  "tha-ap3:149.4": "sutvāna jinasāsanaṃ. ",
  "tha-ap3:150.1": "sutvāna munino vākyaṃ ",
  "tha-ap3:150.2": "passitvā dhammamuttamaṃ ",
  "tha-ap3:150.3": "pariyogāḷhasaddhammo ",
  "tha-ap3:150.4": "imaṃ gāthaṃ abhāsahaṃ. ",
  "tha-ap3:151.1": "eseva dhammo yadi tāvadeva ",
  "tha-ap3:151.2": "paccabyathā padamasokaṃ ",
  "tha-ap3:151.3": "adiṭṭhaṃ abbhatītaṃ ",
  "tha-ap3:151.4": "bahukehi kappanahutehi. ",
  "tha-ap3:152.1": "yohaṃ dhammaṃ gavesanto ",
  "tha-ap3:152.2": "kutitthe sañcariṃ ahaṃ ",
  "tha-ap3:152.3": "so me attho anuppatto ",
  "tha-ap3:152.4": "kālo me nappamajjituṃ. ",
  "tha-ap3:153.1": "tositohaṃ assajinā ",
  "tha-ap3:153.2": "patvāna acalaṃ padaṃ. ",
  "tha-ap3:153.3": "sahāyakaṃ gavesanto ",
  "tha-ap3:153.4": "assamaṃ agamāsahaṃ ",
  "tha-ap3:154.1": "dūratova mamaṃ disvā ",
  "tha-ap3:154.2": "sahāyo me susikkhito ",
  "tha-ap3:154.3": "iriyāpathasampanno ",
  "tha-ap3:154.4": "idaṃ vacanamabravi. ",
  "tha-ap3:155.1": "pasannamukhanettosi ",
  "tha-ap3:155.2": "munibhāvova dissati ",
  "tha-ap3:155.3": "amatādhigato kacci ",
  "tha-ap3:155.4": "nibbānaṃ accutaṃ padaṃ. ",
  "tha-ap3:156.1": "subhānurūpo āyāsi ",
  "tha-ap3:156.2": "āneñjakārito viya ",
  "tha-ap3:156.3": "dantova dantadamathe ",
  "tha-ap3:156.4": "upasantosi brāhmaṇa. ",
  "tha-ap3:157.1": "amataṃ mayā adhigataṃ ",
  "tha-ap3:157.2": "sokasallavinodanaṃ ",
  "tha-ap3:157.3": "tuvaṃpi taṃ adhigacchehi ",
  "tha-ap3:157.4": "gacchāma buddhasantikaṃ. ",
  "tha-ap3:158.1": "sādhūti so paṭissutvā ",
  "tha-ap3:158.2": "sahāyo me susikkhito ",
  "tha-ap3:158.3": "hatthena hatthaṃ gaṇhitvā ",
  "tha-ap3:158.4": "upāgamma tavantikaṃ. ",
  "tha-ap3:159.1": "ubhopi pabbajissāma ",
  "tha-ap3:159.2": "sakyaputta tavantike. ",
  "tha-ap3:159.3": "tava sāsanamāgamma ",
  "tha-ap3:159.4": "viharāma anāsavā. ",
  "tha-ap3:160.1": "kolito iddhiyā seṭṭho ",
  "tha-ap3:160.2": "ahaṃ paññāya pārago ",
  "tha-ap3:160.3": "ubhova ekato hutvā ",
  "tha-ap3:160.4": "sāsanaṃ sobhayāma se. ",
  "tha-ap3:161.1": "apariyositasaṅkappo ",
  "tha-ap3:161.2": "kutitthe sañcariṃ ahaṃ ",
  "tha-ap3:161.3": "tava dassanamāgamma ",
  "tha-ap3:161.4": "saṅkappo pūrito mama. ",
  "tha-ap3:162.1": "paṭhaviyaṃ patiṭṭhāya ",
  "tha-ap3:162.2": "pupphanti samaye dumā ",
  "tha-ap3:162.3": "dibbā gandhā sampavanti ",
  "tha-ap3:162.4": "tosenti sabbapāṇinaṃ. ",
  "tha-ap3:163.1": "tathevāhaṃ mahāvīra ",
  "tha-ap3:163.2": "sakyaputta mahāyasa ",
  "tha-ap3:163.3": "sāsane vo patiṭṭhāya ",
  "tha-ap3:163.4": "samayesāmi pupphituṃ. ",
  "tha-ap3:164.1": "vimuttipupphamesanto ",
  "tha-ap3:164.2": "bhavasaṃsāramocanaṃ ",
  "tha-ap3:164.3": "vimuttipupphalābhena ",
  "tha-ap3:164.4": "tosemi sabbapāṇinaṃ. ",
  "tha-ap3:165.1": "yāvatā buddhakhettamhi ",
  "tha-ap3:165.2": "ṭhapetvāna mahāmuniṃ ",
  "tha-ap3:165.3": "paññāya sadiso natthi ",
  "tha-ap3:165.4": "tava puttassa cakkhuma. ",
  "tha-ap3:166.1": "suvinītā ca te sissā ",
  "tha-ap3:166.2": "parisā ca susikkhitā ",
  "tha-ap3:166.3": "uttame damathe dantā ",
  "tha-ap3:166.4": "parivārenti taṃ sadā. ",
  "tha-ap3:167.1": "jhāyī jhānaratā dhīrā ",
  "tha-ap3:167.2": "santacittā samāhitā ",
  "tha-ap3:167.3": "munī moneyyasampannā ",
  "tha-ap3:167.4": "parivārenti taṃ sadā. ",
  "tha-ap3:168.1": "appicchā nipakā dhīrā ",
  "tha-ap3:168.2": "appāhārā alolupā ",
  "tha-ap3:168.3": "lābhālābhena santuṭṭhā ",
  "tha-ap3:168.4": "parivārenti taṃ sadā. ",
  "tha-ap3:169.1": "āraññikā dhutaratā ",
  "tha-ap3:169.2": "jhāyino lūkhacīvarā ",
  "tha-ap3:169.3": "vivekābhiratā dhīrā ",
  "tha-ap3:169.4": "parivārenti taṃ sadā. ",
  "tha-ap3:170.1": "paṭipannā phalaṭṭhā ca ",
  "tha-ap3:170.2": "sekhā phalasamaṅgino ",
  "tha-ap3:170.3": "āsiṃsakā uttamatthaṃ ",
  "tha-ap3:170.4": "parivārenti taṃ sadā. ",
  "tha-ap3:171.1": "sotāpannā ca vimalā ",
  "tha-ap3:171.2": "sakadāgāmino ca ye ",
  "tha-ap3:171.3": "anāgāmī ca arahā ",
  "tha-ap3:171.4": "parivārenti taṃ sadā. ",
  "tha-ap3:172.1": "satipaṭṭhānakusalā ",
  "tha-ap3:172.2": "bojjhaṅgabhāvanāratā ",
  "tha-ap3:172.3": "sāvakā vo bahū sabbe ",
  "tha-ap3:172.4": "parivārenti taṃ sadā. ",
  "tha-ap3:173.1": "iddhipādesu kusalā ",
  "tha-ap3:173.2": "samādhibhāvanāratā ",
  "tha-ap3:173.3": "sammappadhānamanuyuttā ",
  "tha-ap3:173.4": "parivārenti taṃ sadā. ",
  "tha-ap3:174.1": "tevijjā chaḷabhiññā ca ",
  "tha-ap3:174.2": "iddhiyā pāramiṃ gatā ",
  "tha-ap3:174.3": "paññāya pāramimpattā ",
  "tha-ap3:174.4": "parivārenti taṃ sadā. ",
  "tha-ap3:175.1": "īdisā vo mahāvīra ",
  "tha-ap3:175.2": "tava sissā susikkhitā ",
  "tha-ap3:175.3": "durāsadā uggatejā ",
  "tha-ap3:175.4": "parivārenti taṃ sadā. ",
  "tha-ap3:176.1": "tehi sissehi parivuto ",
  "tha-ap3:176.2": "saññatehi tapassibhi ",
  "tha-ap3:176.3": "migarājāvasambhīto ",
  "tha-ap3:176.4": "uḷurājāva sobhasi. ",
  "tha-ap3:177.1": "paṭhaviyaṃ patiṭṭhāya ",
  "tha-ap3:177.2": "ruhanti kharaṇīruhā ",
  "tha-ap3:177.3": "vepullattaṃ pāpuṇanti ",
  "tha-ap3:177.4": "phalañca dassayanti te. ",
  "tha-ap3:178.1": "paṭhavīsadiso tvaṃsi ",
  "tha-ap3:178.2": "sakyaputta mahāyasa. ",
  "tha-ap3:178.3": "sāsane te patiṭṭhāya ",
  "tha-ap3:178.4": "labhanti amataṃ phalaṃ. ",
  "tha-ap3:179.1": "sindhu sarassatī ceva ",
  "tha-ap3:179.2": "nadiyo candabhāgikā ",
  "tha-ap3:179.3": "gaṅgā ca yamunā ceva ",
  "tha-ap3:179.4": "sarabhū ca atho mahī. ",
  "tha-ap3:180.1": "etāsaṃ sandamānānaṃ ",
  "tha-ap3:180.2": "sāgaro sampaṭicchati ",
  "tha-ap3:180.3": "jahanti purimaṃ nāmaṃ ",
  "tha-ap3:180.4": "sāgarotveva ñāyati. ",
  "tha-ap3:181.1": "tathevime catuvaṇṇā ",
  "tha-ap3:181.2": "pabbajitvā tavantike ",
  "tha-ap3:181.3": "jahanti purimaṃ nāmaṃ ",
  "tha-ap3:181.4": "buddhaputtāti ñāyare. ",
  "tha-ap3:182.1": "yathāpi cando vimalo ",
  "tha-ap3:182.2": "gacchaṃ ākāsadhātuyā ",
  "tha-ap3:182.3": "sabbe tāragaṇe loke ",
  "tha-ap3:182.4": "ābhāya atirocati. ",
  "tha-ap3:183.1": "tatheva tvaṃ mahāvīra ",
  "tha-ap3:183.2": "parivuto devamānuse ",
  "tha-ap3:183.3": "buddhakkhettaṃ atikkamma ",
  "tha-ap3:183.4": "jalasi sabbadā tuvaṃ. ",
  "tha-ap3:184.1": "gambhīre uṭṭhitā ūmi ",
  "tha-ap3:184.2": "na velaṃ ",
  "tha-ap3:184.3": "ativattati sabbavelaṃ paphussanti ",
  "tha-ap3:184.4": "sañcuṇṇā vikiranti tā. ",
  "tha-ap3:185.1": "tatheva titthiyā loke ",
  "tha-ap3:185.2": "nānādiṭṭhī bahū janā ",
  "tha-ap3:185.3": "dhammaṃ taritukāmā te ",
  "tha-ap3:185.4": "nātivattanti taṃ muniṃ. ",
  "tha-ap3:186.1": "sace ca taṃ pāpuṇanti ",
  "tha-ap3:186.2": "paṭivārehi cakkhuma ",
  "tha-ap3:186.3": "tavantikaṃ upāgantvā ",
  "tha-ap3:186.4": "sañcuṇṇāva bhavanti te. ",
  "tha-ap3:187.1": "yathāpi udake jātā ",
  "tha-ap3:187.2": "kumudā mandālakā bahū ",
  "tha-ap3:187.3": "upalimpanti toyena ",
  "tha-ap3:187.4": "kaddamakalalena ca. ",
  "tha-ap3:188.1": "tatheva bahukā sattā ",
  "tha-ap3:188.2": "loke jātā virūhare ",
  "tha-ap3:188.3": "aḍḍitā rāgadosena ",
  "tha-ap3:188.4": "kaddame kumudaṃ yathā. ",
  "tha-ap3:189.1": "yathā padumaṃ jalajaṃ ",
  "tha-ap3:189.2": "jalamajjhe virocati ",
  "tha-ap3:189.3": "na so limpati toyena ",
  "tha-ap3:189.4": "parisuddho hi kesarī. ",
  "tha-ap3:190.1": "tatheva tvaṃ mahāvīra ",
  "tha-ap3:190.2": "loke jāto mahāmuni ",
  "tha-ap3:190.3": "nopalimpasi lokena ",
  "tha-ap3:190.4": "toyena padumaṃ yathā. ",
  "tha-ap3:191.1": "yathā hi rammake māse ",
  "tha-ap3:191.2": "bahū pupphanti vārijā ",
  "tha-ap3:191.3": "nātikkamanti taṃ māsaṃ ",
  "tha-ap3:191.4": "samayo pupphanāya so. ",
  "tha-ap3:192.1": "tatheva tvaṃ sakyaputta ",
  "tha-ap3:192.2": "pupphito te vimuttiyā ",
  "tha-ap3:192.3": "sāsanaṃ nātivattanti ",
  "tha-ap3:192.4": "padumaṃ vārinā yathā. ",
  "tha-ap3:193.1": "supupphito sālarājāva ",
  "tha-ap3:193.2": "dibbagandhaṃ pavāyati ",
  "tha-ap3:193.3": "aññasālehi parivuto ",
  "tha-ap3:193.4": "sālarājātisobhati. ",
  "tha-ap3:194.1": "tatheva tvaṃ mahāvīra ",
  "tha-ap3:194.2": "buddhañāṇena pupphito ",
  "tha-ap3:194.3": "bhikkhusaṅghena parivuto ",
  "tha-ap3:194.4": "sālarājāva sobhasi. ",
  "tha-ap3:195.1": "yathāpi selo himavā ",
  "tha-ap3:195.2": "osatho sabbapāṇinaṃ ",
  "tha-ap3:195.3": "nāgānaṃ asurānañca ",
  "tha-ap3:195.4": "devānaṃ ālayopica. ",
  "tha-ap3:196.1": "tatheva tvaṃ mahāvīra ",
  "tha-ap3:196.2": "osatho viya pāṇinaṃ ",
  "tha-ap3:196.3": "tevijjā chaḷabhiññā ca ",
  "tha-ap3:196.4": "iddhiyā pāramiṃ gatā. ",
  "tha-ap3:197.1": "anusiṭṭhā mahāvīra ",
  "tha-ap3:197.2": "tayā kāruṇikena te ",
  "tha-ap3:197.3": "ramanti dhammaratiyā ",
  "tha-ap3:197.4": "vasanti tava sāsane. ",
  "tha-ap3:198.1": "migarājā yathā sīho ",
  "tha-ap3:198.2": "abhinikkhamma āsayā ",
  "tha-ap3:198.3": "catuddisā viloketvā ",
  "tha-ap3:198.4": "tikkhattuṃ abhinādati. ",
  "tha-ap3:199.1": "sabbe migā uttasanti ",
  "tha-ap3:199.2": "migarājassa gajjato ",
  "tha-ap3:199.3": "tathā hi jātimā eso ",
  "tha-ap3:199.4": "pasuṃ tāseti sabbadā. ",
  "tha-ap3:200.1": "gajjato te mahāvīra ",
  "tha-ap3:200.2": "basudhāyaṃ pakampati bodhaneyyā ",
  "tha-ap3:200.3": "pabujjhanti ",
  "tha-ap3:200.4": "tasanti mārakāyikā. ",
  "tha-ap3:201.1": "tasanti titthiyā sabbe ",
  "tha-ap3:201.2": "nadato te mahāmuni ",
  "tha-ap3:201.3": "kākasenāva vibbhantā ",
  "tha-ap3:201.4": "migaraññā yathā migā. ",
  "tha-ap3:202.1": "ye keci gaṇino loke ",
  "tha-ap3:202.2": "satthāroti pavuccare ",
  "tha-ap3:202.3": "paramparābhataṃ dhammaṃ ",
  "tha-ap3:202.4": "desenti parisāya te. ",
  "tha-ap3:203.1": "na heva tvaṃ mahāvīra ",
  "tha-ap3:203.2": "dhammaṃ desesi pāṇinaṃ ",
  "tha-ap3:203.3": "sāmaṃ saccāni bujjhitvā ",
  "tha-ap3:203.4": "kevalaṃ bodhipakkhikaṃ. ",
  "tha-ap3:204.1": "āsayānusayaṃ ñatvā ",
  "tha-ap3:204.2": "indriyānaṃ balābalaṃ ",
  "tha-ap3:204.3": "bhabbābhabbe viditvāna ",
  "tha-ap3:204.4": "mahāmeghova gajjasi. ",
  "tha-ap3:205.1": "cakkavāḷapariyantā ",
  "tha-ap3:205.2": "nisinnā parisā bhave ",
  "tha-ap3:205.3": "nānādiṭṭhī vicintenti ",
  "tha-ap3:205.4": "vimaticchedanāya taṃ. ",
  "tha-ap3:206.1": "sabbesaṃ cittamaññāya ",
  "tha-ap3:206.2": "opammakusalo muni ",
  "tha-ap3:206.3": "ekaṃ pañhaṃ kathentova ",
  "tha-ap3:206.4": "vimatiṃ chindi pāṇinaṃ. ",
  "tha-ap3:207.1": "upadisāsadiseheva ",
  "tha-ap3:207.2": "vasudhā pūritā bhave ",
  "tha-ap3:207.3": "sabbeva te pañjalikā ",
  "tha-ap3:207.4": "kittayuṃ lokanāyakaṃ. ",
  "tha-ap3:208.1": "kappaṃ vā te kittayantā ",
  "tha-ap3:208.2": "nānāvaṇṇehi kittayuṃ ",
  "tha-ap3:208.3": "parimetuṃ na kappeyyuṃ ",
  "tha-ap3:208.4": "appameyyo tathāgato. ",
  "tha-ap3:209.1": "tathā sakena thāmena ",
  "tha-ap3:209.2": "kittito hi mahājino kappakoṭī ",
  "tha-ap3:209.3": "pakittentā ",
  "tha-ap3:209.4": "evamevaṃ pakittayuṃ. ",
  "tha-ap3:210.1": "sace hi koci devo vā ",
  "tha-ap3:210.2": "manusso vā susikkhito ",
  "tha-ap3:210.3": "pametuṃ parikappeyya ",
  "tha-ap3:210.4": "vighātaṃva labheyya so. ",
  "tha-ap3:211.1": "sāsane te patiṭṭhāya ",
  "tha-ap3:211.2": "sakyaputta mahāyasa ",
  "tha-ap3:211.3": "paññāya pāramiṃ gantvā ",
  "tha-ap3:211.4": "viharāmi anāsavo. ",
  "tha-ap3:212.1": "titthiye sampamaddāmi ",
  "tha-ap3:212.2": "vattemi jinasāsanaṃ ",
  "tha-ap3:212.3": "dhammasenāpati ajja ",
  "tha-ap3:212.4": "sakyaputtassa sāsane. ",
  "tha-ap3:213.1": "aparimeyye kataṃ kammaṃ ",
  "tha-ap3:213.2": "phalaṃ dassesi me idha ",
  "tha-ap3:213.3": "sumutto saravegova ",
  "tha-ap3:213.4": "kilese jhāpayiṃ mamaṃ. ",
  "tha-ap3:214.1": "yo koci manujo bhāraṃ ",
  "tha-ap3:214.2": "dhāreyya matthake sadā ",
  "tha-ap3:214.3": "bhārena dukkhito assa ",
  "tha-ap3:214.4": "bhāro hi bharito tathā. ",
  "tha-ap3:215.1": "ḍayhamāno tihaggīhi ",
  "tha-ap3:215.2": "bhavesu saṃsariṃ ahaṃ ",
  "tha-ap3:215.3": "bharito bhavabhārena ",
  "tha-ap3:215.4": "neru uddharito yathā. ",
  "tha-ap3:216.1": "oropito ca me bhāro ",
  "tha-ap3:216.2": "bhavā ugghāṭitā mayā ",
  "tha-ap3:216.3": "karaṇīyaṃ kataṃ sabbaṃ ",
  "tha-ap3:216.4": "sakyaputtassa sāsane. ",
  "tha-ap3:217.1": "yāvatā buddhakhettamhi ",
  "tha-ap3:217.2": "ṭhapetvā sakyapuṅgavaṃ ",
  "tha-ap3:217.3": "ahaṃ aggomhi paññāya ",
  "tha-ap3:217.4": "sadiso me na vijjati. ",
  "tha-ap3:218.1": "samādhimhi sukusalo ",
  "tha-ap3:218.2": "iddhiyā pāramiṃ gato ",
  "tha-ap3:218.3": "icchamāno ahaṃ ajja ",
  "tha-ap3:218.4": "sahassaṃ abhinimmine. ",
  "tha-ap3:219.1": "anupubbavihārassa ",
  "tha-ap3:219.2": "vasībhūto mahāmuni ",
  "tha-ap3:219.3": "kathesi sāsanaṃ mayhaṃ ",
  "tha-ap3:219.4": "nirodho sayanaṃ mama. ",
  "tha-ap3:220.1": "dibbacakkhuṃ visuddhaṃ me ",
  "tha-ap3:220.2": "samādhikusalo ahaṃ ",
  "tha-ap3:220.3": "sammappadhānamanuyutto ",
  "tha-ap3:220.4": "bojjhaṅgabhāvanārato. ",
  "tha-ap3:221.1": "sāvakena hi pattabbaṃ ",
  "tha-ap3:221.2": "sabbameva kataṃ mama ",
  "tha-ap3:221.3": "lokanāthaṃ ṭhapetvāna ",
  "tha-ap3:221.4": "sadiso me na vijjati. ",
  "tha-ap3:222.1": "samāpattimhi kusalo ",
  "tha-ap3:222.2": "jhānavimokkhānaṃ khippaṃ paṭilābhī ",
  "tha-ap3:222.3": "bojjhaṅgabhāvanārato ",
  "tha-ap3:222.4": "sāvakaguṇapāramiṃ ",
  "tha-ap3:223.1": "gatosmi. sāvakaguṇaphussena ",
  "tha-ap3:223.2": "buddhiyā purisuttamagāravā ",
  "tha-ap3:223.3": "saddhāsaṅgahitaṃ cittaṃ ",
  "tha-ap3:223.4": "sadā sabrahmacārisu. ",
  "tha-ap3:224.1": "uddhaṭadāḍhova sappo ",
  "tha-ap3:224.2": "chinnavisāṇova usabho ",
  "tha-ap3:224.3": "nikkhittamānadappo ",
  "tha-ap3:224.4": "upemi garugāravena gaṇaṃ. ",
  "tha-ap3:225.1": "yadi rūpinī bhaveyya ",
  "tha-ap3:225.2": "paññā me vasu patīnaṃ sameyya ",
  "tha-ap3:225.3": "anomadassissa bhagavato ",
  "tha-ap3:225.4": "phalametaṃ ñāṇathavanāya. ",
  "tha-ap3:226.1": "pavattitaṃ dhammacakkaṃ ",
  "tha-ap3:226.2": "sakyaputtena tādinā ",
  "tha-ap3:226.3": "anuvattemahaṃ sammā ",
  "tha-ap3:226.4": "ñāṇathavanāyidaṃ phalaṃ. ",
  "tha-ap3:227.1": "mā me kadāci pāpiccho ",
  "tha-ap3:227.2": "kusīto hīnavīriyo ",
  "tha-ap3:227.3": "appassuto anācāro ",
  "tha-ap3:227.4": "sameto katthaci ahu. ",
  "tha-ap3:228.1": "bahussuto ca medhāvī ",
  "tha-ap3:228.2": "sīlesu susamāhito ",
  "tha-ap3:228.3": "cetosamathānuyutto ",
  "tha-ap3:228.4": "api muddhani tiṭṭhatu. ",
  "tha-ap3:229.1": "taṃ vo vadāmi bhaddaṃ vo ",
  "tha-ap3:229.2": "yāvantettha samāgatā ",
  "tha-ap3:229.3": "appicchā hotha santuṭṭhā ",
  "tha-ap3:229.4": "dānaṃ datvā sadā ahu. ",
  "tha-ap3:230.1": "yamahaṃ paṭhamaṃ disvā ",
  "tha-ap3:230.2": "virajo vimalo ahu ",
  "tha-ap3:230.3": "so me ācariyo dhīro ",
  "tha-ap3:230.4": "assaji nāma sāvako. ",
  "tha-ap3:231.1": "tassāhaṃ sāvako ajja ",
  "tha-ap3:231.2": "dhammasenāpatī ahu ",
  "tha-ap3:231.3": "sabbattha pāramiṃ patvā ",
  "tha-ap3:231.4": "viharāmi anāsavo. ",
  "tha-ap3:232.1": "yo me ācariyo āsi ",
  "tha-ap3:232.2": "assaji nāma sāvako ",
  "tha-ap3:232.3": "yassaṃ disāyaṃ vasati ",
  "tha-ap3:232.4": "ussīsamhi karomahaṃ. ",
  "tha-ap3:233.1": "mama kammaṃ saritvāna ",
  "tha-ap3:233.2": "gotamo sakyapuṅgavo ",
  "tha-ap3:233.3": "bhikkhusaṅghe nisīditvā ",
  "tha-ap3:233.4": "aggaṭṭhāne ṭhapesi maṃ. ",
  "tha-ap3:234.1": "",
  "tha-ap3:234.2": "",
  "tha-ap3:234.3": "",
  "tha-ap3:234.4": "",
  "tha-ap3:235.1": "",
  "tha-ap3:235.2": "",
  "tha-ap3:235.3": "",
  "tha-ap3:235.4": "",
  "tha-ap3:236.1": "paṭisambhidā catasso ",
  "tha-ap3:236.2": "vimokkhāpica aṭṭhime ",
  "tha-ap3:236.3": "chaḷabhiññā sacchikatā ",
  "tha-ap3:236.4": "kataṃ buddhassa sāsananti. ",
  "tha-ap3:237.1": "itthaṃ sudaṃ āyasmā sārīputto thero imā gāthāyo abhāsitthāti. ",
  "tha-ap3:238.1": "sārīputtattherassa apadānaṃ samattaṃ. catutthaṃ mahāmoggallānattherāpadānaṃ (2) "
}
