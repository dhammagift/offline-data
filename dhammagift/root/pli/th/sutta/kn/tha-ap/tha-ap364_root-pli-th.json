{
  "tha-ap364:0.1": "",
  "tha-ap364:0.2": "",
  "tha-ap364:0.3": "",
  "tha-ap364:1.1": "yāmā devā idhāgantvā ",
  "tha-ap364:1.2": "gotamaṃ sirivacchayaṃ ",
  "tha-ap364:1.3": "kakkārupupphaṃ paggayha ",
  "tha-ap364:1.4": "buddhassa abhiropayiṃ. ",
  "tha-ap364:2.1": "dvenavute ito kappe ",
  "tha-ap364:2.2": "yaṃ pupphaṃ abhipūjayiṃ ",
  "tha-ap364:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap364:2.4": "buddhapūjāyidaṃ phalaṃ. ",
  "tha-ap364:3.1": "paṭisambhidā catasso ",
  "tha-ap364:3.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap364:3.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap364:4.1": "itthaṃ sudaṃ āyasmā kakkārupupphiyo thero imā gāthāyo abhāsitthāti. ",
  "tha-ap364:5.1": "kakkārupupphiyattherassa apadānaṃ samattaṃ. tatiyaṃ bhisamuḷāladāyakattherāpadānaṃ (363) "
}
