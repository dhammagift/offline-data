  "tha-ap281:0.1": "",
  "tha-ap281:0.2": "",
  "tha-ap281:0.3": "",
  "tha-ap281:1.1": "romaso nāma nāmena ",
  "tha-ap281:1.2": "sayambhū sappabho tadā ",
  "tha-ap281:1.3": "puṇḍarīkaṃ mayā dinnaṃ ",
  "tha-ap281:1.4": "vippasannena cetasā. ",
  "tha-ap281:2.1": "catunavute ito kappe ",
  "tha-ap281:2.2": "puṇḍarīkamadadiṃ tadā ",
  "tha-ap281:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap281:2.4": "puṇḍarīkassidaṃ phalaṃ. ",
  "tha-ap281:3.1": "paṭisambhidā catasso ",
  "tha-ap281:3.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap281:3.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap281:4.1": "itthaṃ sudaṃ āyasmā puṇḍarīko thero imā gāthāyo abhāsitthāti. ",
  "tha-ap281:5.1": "puṇḍarīkattherassa apadānaṃ samattaṃ. dasamaṃ taraṇiyattherāpadānaṃ (280) "
}
