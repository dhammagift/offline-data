{
  "tha-ap11:0.1": "",
  "tha-ap11:0.2": "",
  "tha-ap11:0.3": "",
  "tha-ap11:1.1": "gaṅgā bhāgīrasī nāma ",
  "tha-ap11:1.2": "himavantā pabhāvitā ",
  "tha-ap11:1.3": "kutitthe nāviko āsiṃ ",
  "tha-ap11:1.4": "orimaṃ ca tare ahaṃ. ",
  "tha-ap11:2.1": "padumuttaranāyako ",
  "tha-ap11:2.2": "sambuddho dipaduttamo ",
  "tha-ap11:2.3": "vīsasatasahassehi gaṅgāsotaṃ ",
  "tha-ap11:2.4": "tarissati. ",
  "tha-ap11:3.1": "bahū nāvā samānetvā ",
  "tha-ap11:3.2": "vaḍḍhakīhi susaṅkhataṃ ",
  "tha-ap11:3.3": "nāvāya chadanaṃ katvā ",
  "tha-ap11:3.4": "paṭimāniṃ narāsabhaṃ. ",
  "tha-ap11:4.1": "āgantvāna ca sambuddho ",
  "tha-ap11:4.2": "āruyhi nāvalañjakaṃ ",
  "tha-ap11:4.3": "vārimajjhe ṭhito satthā ",
  "tha-ap11:4.4": "imā gāthā abhāsatha. ",
  "tha-ap11:5.1": "yo so tāresi sambuddhaṃ ",
  "tha-ap11:5.2": "saṅghaṃ cāpi anāsavaṃ ",
  "tha-ap11:5.3": "tena cittappasādena ",
  "tha-ap11:5.4": "devaloke ramissati. ",
  "tha-ap11:6.1": "nibbattissati te byamhaṃ ",
  "tha-ap11:6.2": "sukataṃ nāvasaṇṭhitaṃ ",
  "tha-ap11:6.3": "ākāse pupphachadanaṃ ",
  "tha-ap11:6.4": "dhārayissati sabbadā. ",
  "tha-ap11:7.1": "aṭṭhapaññāsakappamhi ",
  "tha-ap11:7.2": "tāraṇo nāma khattiyo ",
  "tha-ap11:7.3": "cāturanto vijitāvī ",
  "tha-ap11:7.4": "cakkavatti bhavissati. ",
  "tha-ap11:8.1": "sattapaññāsakappamhi ",
  "tha-ap11:8.2": "cambako nāma khattiyo ",
  "tha-ap11:8.3": "uggacchantova suriyo ",
  "tha-ap11:8.4": "jotissati mahābalo. ",
  "tha-ap11:9.1": "kappasatasahassamhi ",
  "tha-ap11:9.2": "okkākakulasambhavo ",
  "tha-ap11:9.3": "gotamo nāma gottena ",
  "tha-ap11:9.4": "satthā loke bhavissati. ",
  "tha-ap11:10.1": "tidasāva cavitvāna ",
  "tha-ap11:10.2": "manussattaṃ gamissati ",
  "tha-ap11:10.3": "revato nāma nāmena ",
  "tha-ap11:10.4": "brahmabandhu bhavissati. ",
  "tha-ap11:11.1": "agārā nikkhamitvāna ",
  "tha-ap11:11.2": "sukkamūlena codito ",
  "tha-ap11:11.3": "gotamassa bhagavato ",
  "tha-ap11:11.4": "sāsane pabbajissati. ",
  "tha-ap11:12.1": "so pacchā pabbajitvāna ",
  "tha-ap11:12.2": "yuttayogo vipassako ",
  "tha-ap11:12.3": "sabbāsave pariññāya ",
  "tha-ap11:12.4": "nibbāyissatyanāsavo. ",
  "tha-ap11:13.1": "viriyaṃ me dhuradhorayhaṃ ",
  "tha-ap11:13.2": "yogakkhemādhivāhanaṃ ",
  "tha-ap11:13.3": "dhāremi antimaṃ dehaṃ ",
  "tha-ap11:13.4": "sammāsambuddhasāsane. ",
  "tha-ap11:14.1": "",
  "tha-ap11:14.2": "",
  "tha-ap11:14.3": "",
  "tha-ap11:14.4": "",
  "tha-ap11:15.1": "",
  "tha-ap11:15.2": "",
  "tha-ap11:15.3": "",
  "tha-ap11:15.4": "",
  "tha-ap11:16.1": "paṭisambhidā catasso ",
  "tha-ap11:16.2": "vimokkhāpica aṭṭhime ",
  "tha-ap11:16.3": "chaḷabhiññā sacchikatā ",
  "tha-ap11:16.4": "kataṃ buddhassa sāsananti. ",
  "tha-ap11:17.1": "itthaṃ sudaṃ āyasmā khadiravaniyo revatatthero imā gāthāyo abhāsitthāti. ",
  "tha-ap11:18.1": "khadiravaniyarevatattherassa apadānaṃ samattaṃ. dvādasamaṃ ānandattherāpadānaṃ (10) "
}
