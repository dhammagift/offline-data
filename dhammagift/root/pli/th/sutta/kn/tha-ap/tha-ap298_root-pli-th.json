  "tha-ap298:0.1": "",
  "tha-ap298:0.2": "",
  "tha-ap298:0.3": "",
  "tha-ap298:1.1": "pabbate himavantamhi ",
  "tha-ap298:1.2": "ahosiṃ kinnaro tadā ",
  "tha-ap298:1.3": "addasaṃ virajaṃ buddhaṃ ",
  "tha-ap298:1.4": "pitaraṃsīva bhāṇumaṃ. ",
  "tha-ap298:2.1": "upetopi tadā buddhaṃ ",
  "tha-ap298:2.2": "vipassiṃ lokanāyakaṃ ",
  "tha-ap298:2.3": "candanaṃ tagaraṃ vāpi ",
  "tha-ap298:2.4": "pāde osiñcahaṃ tadā. ",
  "tha-ap298:3.1": "ekanavute ito kappe ",
  "tha-ap298:3.2": "yaṃ padaṃ abhipūjayiṃ ",
  "tha-ap298:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap298:3.4": "padapūjāyidaṃ phalaṃ. ",
  "tha-ap298:4.1": "paṭisambhidā catasso ",
  "tha-ap298:4.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap298:4.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap298:5.1": "itthaṃ sudaṃ āyasmā padapūjako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap298:6.1": "padapūjakattherassa apadānaṃ samattaṃ. sattamaṃ desakittikattherāpadānaṃ (297) "
}
