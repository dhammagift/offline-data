{
  "tha-ap232:0.1": "",
  "tha-ap232:0.2": "",
  "tha-ap232:0.3": "",
  "tha-ap232:1.1": "usabhaṃ pavaraṃ vīraṃ ",
  "tha-ap232:1.2": "vessabhuṃ vijitāvinaṃ ",
  "tha-ap232:1.3": "pasannacitto sumano ",
  "tha-ap232:1.4": "buddhaseṭṭhaṃ avandahaṃ. ",
  "tha-ap232:2.1": "ekatiṃse ito kappe ",
  "tha-ap232:2.2": "yaṃ kammamakariṃ tadā ",
  "tha-ap232:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap232:2.4": "vandanāya idaṃ phalaṃ. ",
  "tha-ap232:3.1": "catuvīsamhi kappamhi ",
  "tha-ap232:3.2": "vigatānandanāmako ",
  "tha-ap232:3.3": "sattaratanasampanno ",
  "tha-ap232:3.4": "cakkavatti mahabbalo. ",
  "tha-ap232:4.1": "paṭisambhidā catasso ",
  "tha-ap232:4.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap232:4.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap232:5.1": "itthaṃ sudaṃ āyasmā ekavandaniyo thero imā gāthāyo abhāsitthāti. ",
  "tha-ap232:6.1": "ekavandaniyattherassa apadānaṃ ",
  "tha-ap232:7.1": "samattaṃ. uddānaṃ ",
  "tha-ap232:8.1": "",
  "tha-ap232:9.1": "ālambanañca ajinaṃ ",
  "tha-ap232:9.2": "maṃsadārakkhadāyako ",
  "tha-ap232:9.3": "abyādhivakulasoṇṇaṃ miñjaṃ āveḷa ",
  "tha-ap232:9.4": "vandanaṃ ",
  "tha-ap232:9.5": "pañcapaññāsa gāthāyo ",
  "tha-ap232:9.6": "gaṇitā atthadassihīti. ālambanadāyakavaggo tevīsatimo. "
}
