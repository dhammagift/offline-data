{
  "tha-ap302:0.1": "",
  "tha-ap302:0.2": "",
  "tha-ap302:0.3": "",
  "tha-ap302:1.1": "piṇḍāya caramānāhaṃ ",
  "tha-ap302:1.2": "vipassiṃ addasaṃ jinaṃ ",
  "tha-ap302:1.3": "uluṅkabhikkhaṃ adāsiṃ ",
  "tha-ap302:1.4": "dipadindassa tādino. ",
  "tha-ap302:2.1": "pasannacitto sumano ",
  "tha-ap302:2.2": "abhivādesahaṃ tadā ",
  "tha-ap302:2.3": "anusaṃsāvayiṃ buddhaṃ ",
  "tha-ap302:2.4": "uttamatthassa pattiyā. ",
  "tha-ap302:3.1": "ekanavute ito kappe ",
  "tha-ap302:3.2": "anusaṃsāvayiṃ ahaṃ ",
  "tha-ap302:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap302:3.4": "anusaṃsāvanāphalaṃ. ",
  "tha-ap302:4.1": "paṭisambhidā catasso ",
  "tha-ap302:4.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap302:4.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap302:5.1": "itthaṃ sudaṃ āyasmā anusaṃsāvako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap302:6.1": "anusaṃsāvakattherassa apadānaṃ ",
  "tha-ap302:6.2": "samattaṃ. uddānaṃ ",
  "tha-ap302:7.1": "",
  "tha-ap302:8.1": "citakaṃ pārichattañca saddaṃ ",
  "tha-ap302:8.2": "gosīsasantharaṃ ",
  "tha-ap302:8.3": "padaṃ padesaṃ saraṇaṃ ",
  "tha-ap302:8.4": "ambo saṃsāvakopica ",
  "tha-ap302:8.5": "sattatāḷīsagāthāyo ",
  "tha-ap302:8.6": "gaṇitāyo vibhāvihi. ",
  "tha-ap302:9.1": "citakapūjakavaggo tiṃso. ",
  "tha-ap302:10.1": "atha vagguddānaṃ kaṇikāro hatthidado ",
  "tha-ap302:10.2": "ālambanudakāsanaṃ ",
  "tha-ap302:10.3": "tuvaraṃ thomako ceva ",
  "tha-ap302:10.4": "ukkhepaṃ sīsupadhānaṃ. ",
  "tha-ap302:11.1": "paṇṇado citapūjī ca ",
  "tha-ap302:11.2": "gāthāyo ceva sabbaso ",
  "tha-ap302:11.3": "cattāri ca satānīha ",
  "tha-ap302:11.4": "ekapaññāsameva ca. ",
  "tha-ap302:12.1": "pañcavīsa satā sabbā ",
  "tha-ap302:12.2": "dvāsattati taduttari ",
  "tha-ap302:12.3": "tiṃsa satānaṃ padānaṃ ",
  "tha-ap302:12.4": "gaṇitā atthadassibhi. ",
  "tha-ap302:13.1": "tatiyaṃ ",
  "tha-ap302:14.1": "satakaṃ samattaṃ. "
}
