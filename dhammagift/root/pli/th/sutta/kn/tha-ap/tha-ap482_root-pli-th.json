{
  "tha-ap482:0.1": "",
  "tha-ap482:0.2": "",
  "tha-ap482:0.3": "",
  "tha-ap482:1.1": "migaluddho pure āsiṃ ",
  "tha-ap482:1.2": "araññe kānane ahaṃ ",
  "tha-ap482:1.3": "vātamigaṃ gavesanto ",
  "tha-ap482:1.4": "caṅkamaṃ addasaṃ ahaṃ. ",
  "tha-ap482:2.1": "ucchaṅgena puḷinaṃ gayha ",
  "tha-ap482:2.2": "caṅkame okiriṃ ahaṃ ",
  "tha-ap482:2.3": "pasannacitto sumano ",
  "tha-ap482:2.4": "sugatassa sirīmato. ",
  "tha-ap482:3.1": "ekatiṃse ito kappe ",
  "tha-ap482:3.2": "puḷinaṃ okiriṃ ahaṃ ",
  "tha-ap482:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap482:3.4": "puḷinassa idaṃ phalaṃ. ",
  "tha-ap482:4.1": "kilesā jhāpitā mayhaṃ ",
  "tha-ap482:4.2": "bhavā sabbe samūhatā nāgova bandhanaṃ chetvā ",
  "tha-ap482:4.3": "viharāmi anāsavo. ",
  "tha-ap482:5.1": "svāgataṃ vata me āsi ",
  "tha-ap482:5.2": "mama buddhassa santike tisso vijjā anuppattā ",
  "tha-ap482:5.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap482:6.1": "paṭisambhidā catasso ",
  "tha-ap482:6.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap482:6.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap482:7.1": "itthaṃ sudaṃ āyasmā puḷinacaṅkamiyo thero imā gāthāyo abhāsitthāti. ",
  "tha-ap482:8.1": "puḷinacaṅkamiyattherassa apadānaṃ ",
  "tha-ap482:9.1": "samattaṃ. uddānaṃ ",
  "tha-ap482:10.1": "",
  "tha-ap482:11.1": "naḷamāli maṇidado ",
  "tha-ap482:11.2": "ukkāsatikavījani ",
  "tha-ap482:11.3": "kummāsañca kusaṭṭhañca ",
  "tha-ap482:11.4": "giripunnāgiyopica ",
  "tha-ap482:12.1": "vallikāro pānadhido ",
  "tha-ap482:12.2": "atho puḷinacaṅkamo ",
  "tha-ap482:12.3": "gāthāyo pañcanavuti ",
  "tha-ap482:12.4": "gaṇitāyo vibhāvibhi. naḷamālivaggo aṭṭhacattāḷīso. "
}
