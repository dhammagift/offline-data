{
  "tha-ap244:0.1": "",
  "tha-ap244:0.2": "",
  "tha-ap244:0.3": "",
  "tha-ap244:1.1": "dhanuṃ avejjhaṃ katvāna ",
  "tha-ap244:1.2": "vanamajjhogahiṃ ahaṃ ",
  "tha-ap244:1.3": "kesaraṃ osaraṃ disvā ",
  "tha-ap244:1.4": "pabbamaggaṃ samuṭṭhitaṃ. ",
  "tha-ap244:2.1": "ubhohatthehi paggayha ",
  "tha-ap244:2.2": "sire katvāna añjaliṃ ",
  "tha-ap244:2.3": "buddhassa abhiropesiṃ ",
  "tha-ap244:2.4": "tissassa lokabandhuno. ",
  "tha-ap244:3.1": "dvenavute ito kappe ",
  "tha-ap244:3.2": "yaṃ pupphamabhiropayiṃ ",
  "tha-ap244:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap244:3.4": "buddhapūjāyidaṃ phalaṃ. ",
  "tha-ap244:4.1": "sattasattatime kappe ",
  "tha-ap244:4.2": "samokkharaṇanāmako sattaratanasampanno ",
  "tha-ap244:4.3": "",
  "tha-ap244:4.4": "cakkavatti mahabbalo. ",
  "tha-ap244:5.1": "paṭisambhidā catasso ",
  "tha-ap244:5.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap244:5.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap244:6.1": "itthaṃ sudaṃ āyasmā nāgakesariyo thero imā gāthāyo abhāsitthāti. ",
  "tha-ap244:7.1": "nāgakesariyattherassa apadānaṃ samattaṃ. tatiyaṃ naḷinakesariyattherāpadānaṃ (243) "
}
