{
  "tha-ap378:0.1": "",
  "tha-ap378:0.2": "",
  "tha-ap378:0.3": "",
  "tha-ap378:1.1": "citake kayiramāne ",
  "tha-ap378:1.2": "nānāgandhe samāgate ",
  "tha-ap378:1.3": "pasannacitto sumano ",
  "tha-ap378:1.4": "gandhamuṭṭhiṃ apūjayiṃ. ",
  "tha-ap378:2.1": "satasahasse ito kappe ",
  "tha-ap378:2.2": "citakaṃ yaṃ apūjayiṃ ",
  "tha-ap378:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap378:2.4": "citapūjāyidaṃ phalaṃ. ",
  "tha-ap378:3.1": "svāgataṃ vata me āsi mama buddhassa santike tisso vijjā anuppattā kataṃ buddhassa sāsanaṃ. kilesā jhāpitā mayhaṃ ",
  "tha-ap378:3.2": "bhavā sabbe samūhatā nāgova bandhanaṃ chetvā ",
  "tha-ap378:3.3": "viharāmi anāsavo. ",
  "tha-ap378:4.1": "",
  "tha-ap378:4.2": "",
  "tha-ap378:4.3": "",
  "tha-ap378:5.1": "paṭisambhidā catasso ",
  "tha-ap378:5.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap378:5.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap378:6.1": "itthaṃ sudaṃ āyasmā gandhamuṭṭhiyo thero imā gāthāyo abhāsitthāti. ",
  "tha-ap378:7.1": "gandhamuṭṭhiyattherassa apadānaṃ samattaṃ. sattamaṃ citakapūjakattherāpadānaṃ (377) "
}
