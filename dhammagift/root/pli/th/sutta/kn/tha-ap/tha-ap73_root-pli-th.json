{
  "tha-ap73:0.1": "aṭṭhamo nāgasamālavaggo ",
  "tha-ap73:0.2": "",
  "tha-ap73:0.3": "",
  "tha-ap73:1.1": "paṭhamaṃ nāgasamālattherāpadānaṃ (71) āpāṭaliṃ ahaṃ pupphaṃ ",
  "tha-ap73:1.2": "ujjhitaṃ sumahāpathe ",
  "tha-ap73:1.3": "thūpamhi abhiropesiṃ ",
  "tha-ap73:1.4": "sikhino lokabandhuno. ",
  "tha-ap73:2.1": "ekatiṃse ito kappe ",
  "tha-ap73:2.2": "yaṃ kammamakariṃ tadā ",
  "tha-ap73:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap73:2.4": "thūpapūjāyidaṃ phalaṃ. ",
  "tha-ap73:3.1": "ito paṇṇarase kappe ",
  "tha-ap73:3.2": "pupphiyo nāma khattiyo ",
  "tha-ap73:3.3": "sattaratanasampanno ",
  "tha-ap73:3.4": "cakkavatti mahabbalo. ",
  "tha-ap73:4.1": "paṭisambhidā catasso ",
  "tha-ap73:4.2": "vimokkhāpica aṭṭhime ",
  "tha-ap73:4.3": "chaḷabhiññā sacchikatā ",
  "tha-ap73:4.4": "kataṃ buddhassa sāsananti. ",
  "tha-ap73:5.1": "itthaṃ sudaṃ āyasmā nāgasamālo thero imā gāthāyo abhāsitthāti. ",
  "tha-ap73:6.1": "nāgasamālattherassa apadānaṃ samattaṃ. dutiyaṃ padasaññakattherāpadānaṃ (72) "
}
