{
  "tha-ap201:0.1": "",
  "tha-ap201:0.2": "",
  "tha-ap201:0.3": "",
  "tha-ap201:1.1": "sumaṅgaloti nāmena ",
  "tha-ap201:1.2": "sayambhū aparājito ",
  "tha-ap201:1.3": "pavanā nikkhamitvāna ",
  "tha-ap201:1.4": "nagaraṃ pāvisi jino. ",
  "tha-ap201:2.1": "piṇḍacāraṃ caritvāna ",
  "tha-ap201:2.2": "nikkhamma nagarā muni ",
  "tha-ap201:2.3": "katakiccova sambuddho ",
  "tha-ap201:2.4": "so vasi vanamantare. ",
  "tha-ap201:3.1": "tikaṇḍipupphaṃ paggayha ",
  "tha-ap201:3.2": "buddhassa abhiropayiṃ ",
  "tha-ap201:3.3": "pasannacitto sumano ",
  "tha-ap201:3.4": "sayambhussa mahesino. ",
  "tha-ap201:4.1": "catunavute ito kappe ",
  "tha-ap201:4.2": "yaṃ pupphamabhiropayiṃ ",
  "tha-ap201:4.3": "duggatiṃ nābhijānāmi ",
  "tha-ap201:4.4": "buddhapūjāyidaṃ phalaṃ. ",
  "tha-ap201:5.1": "chaḷāsītimhito kappe ",
  "tha-ap201:5.2": "apaselāsanāmako ",
  "tha-ap201:5.3": "sattaratanasampanno ",
  "tha-ap201:5.4": "cakkavatti mahabbalo. ",
  "tha-ap201:6.1": "paṭisambhidā catasso ",
  "tha-ap201:6.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap201:6.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap201:7.1": "itthaṃ sudaṃ āyasmā tikaṇḍipupphiyo thero imā gāthāyo abhāsitthāti. ",
  "tha-ap201:8.1": "tikaṇḍipupphiyattherassa apadānaṃ samattaṃ. dasamaṃ yūthikapupphiyattherāpadānaṃ (200) "
}
