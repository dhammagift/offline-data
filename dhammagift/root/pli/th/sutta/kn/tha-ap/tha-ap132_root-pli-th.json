{
  "tha-ap132:0.1": "",
  "tha-ap132:0.2": "",
  "tha-ap132:0.3": "",
  "tha-ap132:1.1": "himavantassavidūre ",
  "tha-ap132:1.2": "gotamo nāma pabbato ",
  "tha-ap132:1.3": "nānārukkhehi sañchanno ",
  "tha-ap132:1.4": "mahābhūtagaṇālayo. ",
  "tha-ap132:2.1": "vemajjhamhi ca tassāsi ",
  "tha-ap132:2.2": "assamo abhinimmito ",
  "tha-ap132:2.3": "purakkhato sasissehi ",
  "tha-ap132:2.4": "vasāmi assame ahaṃ. ",
  "tha-ap132:3.1": "āyantu me sissagaṇā ",
  "tha-ap132:3.2": "padumaṃ āharantu me ",
  "tha-ap132:3.3": "buddhapūjaṃ karissāmi ",
  "tha-ap132:3.4": "dipadindassa tādino. ",
  "tha-ap132:4.1": "evanti te paṭissutvā ",
  "tha-ap132:4.2": "padumaṃ āhariṃsu me ",
  "tha-ap132:4.3": "tathā nimittaṃ katvāhaṃ ",
  "tha-ap132:4.4": "buddhassa abhiropayiṃ. ",
  "tha-ap132:5.1": "sisse tadā samānetvā ",
  "tha-ap132:5.2": "sādhukaṃ anusāsahaṃ ",
  "tha-ap132:5.3": "mā kho tumhe pamajjittha ",
  "tha-ap132:5.4": "appamādo sukhāvaho. ",
  "tha-ap132:6.1": "evaṃ samanusāsitvā ",
  "tha-ap132:6.2": "sa sisse vacanakkhame ",
  "tha-ap132:6.3": "appamādaguṇe yutto ",
  "tha-ap132:6.4": "tadā kālaṃ kato ahaṃ. ",
  "tha-ap132:7.1": "ekanavute ito kappe ",
  "tha-ap132:7.2": "yaṃ pupphamabhiropayiṃ ",
  "tha-ap132:7.3": "duggatiṃ nābhijānāmi ",
  "tha-ap132:7.4": "buddhapūjāyidaṃ phalaṃ. ",
  "tha-ap132:8.1": "ekapaññāsakappamhi ",
  "tha-ap132:8.2": "rājā āsiṃ jaluttamo ",
  "tha-ap132:8.3": "sattaratanasampanno ",
  "tha-ap132:8.4": "cakkavatti mahabbalo. ",
  "tha-ap132:9.1": "paṭisambhidā catasso ",
  "tha-ap132:9.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap132:9.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap132:10.1": "itthaṃ sudaṃ āyasmā padumapūjako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap132:11.1": "padumapūjakattherassa apadānaṃ ",
  "tha-ap132:12.1": "samattaṃ. uddānaṃ ",
  "tha-ap132:13.1": "",
  "tha-ap132:14.1": "sereyyako pupphathūpi ",
  "tha-ap132:14.2": "pāyāsodaki thomako ",
  "tha-ap132:14.3": "āsani phalasaññī ca ",
  "tha-ap132:14.4": "gandhapadumapupphiyo ",
  "tha-ap132:14.5": "pañcuttarasatā gāthā ",
  "tha-ap132:14.6": "gaṇitā atthadassibhi. sereyyavaggo terasamo. "
}
