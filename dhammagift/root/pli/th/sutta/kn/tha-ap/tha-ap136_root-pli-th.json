  "tha-ap136:0.1": "",
  "tha-ap136:0.2": "",
  "tha-ap136:0.3": "",
  "tha-ap136:1.1": "sunando nāma nāmena ",
  "tha-ap136:1.2": "brāhmaṇo mantapāragū ",
  "tha-ap136:1.3": "ajjhāyako yācayogo ",
  "tha-ap136:1.4": "vājapeyyaṃ ayājayi. ",
  "tha-ap136:2.1": "padumuttaro lokavidū ",
  "tha-ap136:2.2": "aggo kāruṇiko isi ",
  "tha-ap136:2.3": "janataṃ anukampanto ",
  "tha-ap136:2.4": "ambare caṅkami tadā. ",
  "tha-ap136:3.1": "caṅkamitvāna sambuddho ",
  "tha-ap136:3.2": "sabbaññū lokanāyako ",
  "tha-ap136:3.3": "mettāya aphari satte ",
  "tha-ap136:3.4": "appamāṇaṃ nirūpadhiṃ. ",
  "tha-ap136:4.1": "vaṇṭe chitvāna pupphāni ",
  "tha-ap136:4.2": "brāhmaṇo mantapāragū ",
  "tha-ap136:4.3": "sabbe sisse samānetvā ",
  "tha-ap136:4.4": "ākāse ukkhipāpayi. ",
  "tha-ap136:5.1": "yāvatā nagaraṃ āsi ",
  "tha-ap136:5.2": "pupphānaṃ chadanaṃ tadā ",
  "tha-ap136:5.3": "buddhassa ānubhāvena ",
  "tha-ap136:5.4": "sattāhaṃ na vigacchatha. ",
  "tha-ap136:6.1": "teneva sukkamūlena ",
  "tha-ap136:6.2": "anubhotvāna sampadā ",
  "tha-ap136:6.3": "sabbāsave pariññāya ",
  "tha-ap136:6.4": "tiṇṇo loke visattikaṃ. ",
  "tha-ap136:7.1": "ekārase kappasate ",
  "tha-ap136:7.2": "pañcattiṃsāsu khattiyā ",
  "tha-ap136:7.3": "ambaraṃsasanāmā te ",
  "tha-ap136:7.4": "cakkavattī mahabbalā. ",
  "tha-ap136:8.1": "paṭisambhidā catasso ",
  "tha-ap136:8.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap136:8.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap136:9.1": "itthaṃ sudaṃ āyasmā pupphachadaniyo thero imā gāthāyo abhāsitthāti. ",
  "tha-ap136:10.1": "pupphachadaniyattherassa apadānaṃ samattaṃ pañcamaṃ rahosaññikattherāpadānaṃ (135) "
}
