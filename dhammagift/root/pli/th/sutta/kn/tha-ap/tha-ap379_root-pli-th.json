{
  "tha-ap379:0.1": "",
  "tha-ap379:0.2": "",
  "tha-ap379:0.3": "",
  "tha-ap379:1.1": "parinibbute bhagavati ",
  "tha-ap379:1.2": "jalajuttamanāmake ",
  "tha-ap379:1.3": "āropitamhi citake ",
  "tha-ap379:1.4": "sālapupphaṃ apūjayiṃ. satasahasse ",
  "tha-ap379:2.1": "ito kappe ",
  "tha-ap379:2.2": "yaṃ pupphaṃ apūjayiṃ ",
  "tha-ap379:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap379:2.4": "citapūjāyidaṃ phalaṃ. ",
  "tha-ap379:3.1": "svāgataṃ vata me āsi mama buddhassa santike tisso vijjā anuppattā kataṃ buddhassa sāsanaṃ. kilesā jhāpitā mayhaṃ ",
  "tha-ap379:3.2": "bhavā sabbe samūhatā nāgova bandhanaṃ chetvā ",
  "tha-ap379:3.3": "viharāmi anāsavo. ",
  "tha-ap379:4.1": "",
  "tha-ap379:4.2": "",
  "tha-ap379:4.3": "",
  "tha-ap379:5.1": "paṭisambhidā catasso ",
  "tha-ap379:5.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap379:5.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap379:6.1": "itthaṃ sudaṃ āyasmā citakapūjako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap379:7.1": "citakapūjakattherassa apadānaṃ samattaṃ. aṭṭhamaṃ sumanatālavaṇṭiyattherāpadānaṃ (378) "
}
