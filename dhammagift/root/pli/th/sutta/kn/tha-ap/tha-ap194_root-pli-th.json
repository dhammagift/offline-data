{
  "tha-ap194:0.1": "",
  "tha-ap194:0.2": "",
  "tha-ap194:0.3": "",
  "tha-ap194:1.1": "yadā vanavāsiko isi ",
  "tha-ap194:1.2": "tiṇaṃ lāyāmi satthuno ",
  "tha-ap194:1.3": "sabbe padakkhiṇāvattā ",
  "tha-ap194:1.4": "paṭhabyā nipatiṃsu te. ",
  "tha-ap194:2.1": "tamahaṃ tiṇamādāya ",
  "tha-ap194:2.2": "santhariṃ dharaṇimuttame ",
  "tha-ap194:2.3": "tīṇeva tālapattāni ",
  "tha-ap194:2.4": "āharitvānahaṃ tadā. ",
  "tha-ap194:3.1": "tidaṇḍe chadanaṃ katvā ",
  "tha-ap194:3.2": "siddhatthassa adāsahaṃ ",
  "tha-ap194:3.3": "sattāhaṃ dhārayuṃ tattha devamanussā ",
  "tha-ap194:3.4": "satthuno. catunavute ",
  "tha-ap194:4.1": "ito kappe ",
  "tha-ap194:4.2": "yaṃ tiṇaṃ adadiṃ tadā ",
  "tha-ap194:4.3": "duggatiṃ nābhijānāmi ",
  "tha-ap194:4.4": "tiṇadānassidaṃ phalaṃ. ",
  "tha-ap194:5.1": "pañcasaṭṭhimhito kappe ",
  "tha-ap194:5.2": "cattārosuṃ mahaddhanā ",
  "tha-ap194:5.3": "sattaratanasampannā ",
  "tha-ap194:5.4": "cakkavattī mahabbalā. ",
  "tha-ap194:6.1": "paṭisambhidā catasso ",
  "tha-ap194:6.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap194:6.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap194:7.1": "itthaṃ sudaṃ āyasmā tiṇasanthāradāyako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap194:8.1": "tiṇasanthāradāyakattherassa apadānaṃ samattaṃ. tatiyaṃ khaṇḍaphulliyattherāpadānaṃ (193) "
}
