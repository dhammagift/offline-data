{
  "tha-ap422:0.1": "",
  "tha-ap422:0.2": "",
  "tha-ap422:0.3": "",
  "tha-ap422:1.1": "parinibbute kāruṇike ",
  "tha-ap422:1.2": "siddhatthe lokanāyake ",
  "tha-ap422:1.3": "vitthārike pāvacane ",
  "tha-ap422:1.4": "devamanussasakkate. ",
  "tha-ap422:2.1": "caṇḍālo āsahaṃ tattha ",
  "tha-ap422:2.2": "āsandipīṭhakārako ",
  "tha-ap422:2.3": "tena kammena jīvāmi ",
  "tha-ap422:2.4": "tena posemi dārake. ",
  "tha-ap422:3.1": "āsandiṃ sukataṃ katvā ",
  "tha-ap422:3.2": "pasanno sehi pāṇibhi ",
  "tha-ap422:3.3": "sayameva upagantvā ",
  "tha-ap422:3.4": "bhikkhusaṅghassadāsahaṃ. ",
  "tha-ap422:4.1": "tena kammena sukatena ",
  "tha-ap422:4.2": "cetanāpaṇidhīhi ca ",
  "tha-ap422:4.3": "jahitvā mānusaṃ dehaṃ ",
  "tha-ap422:4.4": "tāvatiṃsaṃ agañchahaṃ. ",
  "tha-ap422:5.1": "devalokaṃ gato santo ",
  "tha-ap422:5.2": "modāmi tidase gaṇe ",
  "tha-ap422:5.3": "sayanāni mahagghāni ",
  "tha-ap422:5.4": "nibbattanti yathicchakaṃ. ",
  "tha-ap422:6.1": "paññāsakkhattuṃ devindo ",
  "tha-ap422:6.2": "devarajjamakārayiṃ ",
  "tha-ap422:6.3": "asītikkhattuṃ rājā ca ",
  "tha-ap422:6.4": "cakkavatti ahosahaṃ. ",
  "tha-ap422:7.1": "padesarajjaṃ vipulaṃ ",
  "tha-ap422:7.2": "gaṇanāto asaṅkhayaṃ ",
  "tha-ap422:7.3": "sukhito yasavā homi ",
  "tha-ap422:7.4": "mañcadānassidaṃ phalaṃ. ",
  "tha-ap422:8.1": "devalokā cavitvāna ",
  "tha-ap422:8.2": "emi ce mānusaṃ bhavaṃ ",
  "tha-ap422:8.3": "mahārahā susayanā ",
  "tha-ap422:8.4": "sayameva bhavanti me. ",
  "tha-ap422:9.1": "ayaṃ pacchimako mayhaṃ ",
  "tha-ap422:9.2": "carimo vattate bhavo ",
  "tha-ap422:9.3": "ajjāpi sayanakāle ",
  "tha-ap422:9.4": "sayanaṃ upatiṭṭhahi. catunavute ",
  "tha-ap422:10.1": "ito kappe ",
  "tha-ap422:10.2": "yaṃ dānaṃ adadiṃ tadā ",
  "tha-ap422:10.3": "duggatiṃ nābhijānāmi ",
  "tha-ap422:10.4": "mañcadānassidaṃ phalaṃ. ",
  "tha-ap422:11.1": "kilesā jhāpitā mayhaṃ ",
  "tha-ap422:11.2": "bhavā sabbe samūhatā nāgova bandhanaṃ chetvā ",
  "tha-ap422:11.3": "viharāmi anāsavo. ",
  "tha-ap422:12.1": "svāgataṃ vata me āsi ",
  "tha-ap422:12.2": "mama buddhassa santike tisso vijjā anuppattā ",
  "tha-ap422:12.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap422:13.1": "paṭisambhidā catasso ",
  "tha-ap422:13.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap422:13.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap422:14.1": "itthaṃ sudaṃ āyasmā mañcadāyako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap422:15.1": "mañcadāyakattherassa apadānaṃ ",
  "tha-ap422:16.1": "samattaṃ. uddānaṃ ",
  "tha-ap422:17.1": "",
  "tha-ap422:18.1": "bhaddālī ekachatto ca ",
  "tha-ap422:18.2": "tiṇasūlo ca maṃsado ",
  "tha-ap422:18.3": "nāgapallavako dīpaṃ ",
  "tha-ap422:18.4": "ucchaṅgi yāgudāyako. ",
  "tha-ap422:19.1": "patthodani mañcadado ",
  "tha-ap422:19.2": "gāthāyo gaṇitā visā dve ",
  "tha-ap422:19.3": "satāni ca gāthānaṃ ",
  "tha-ap422:19.4": "gāthā cekā taduttari. bhaddālivaggo dvācattāḷīsamo. "
}
