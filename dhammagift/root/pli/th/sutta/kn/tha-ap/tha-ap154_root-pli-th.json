{
  "tha-ap154:0.1": "",
  "tha-ap154:0.2": "",
  "tha-ap154:0.3": "",
  "tha-ap154:1.1": "parakammāyane yutto ",
  "tha-ap154:1.2": "aparādhaṃ akāsahaṃ ",
  "tha-ap154:1.3": "vanantaṃ atidhāvissaṃ ",
  "tha-ap154:1.4": "bhayaverasamappito. ",
  "tha-ap154:2.1": "pupphitaṃ pādapaṃ disvā ",
  "tha-ap154:2.2": "piṇḍibandhaṃ sunimmitaṃ ",
  "tha-ap154:2.3": "tambapupphaṃ gahetvāna ",
  "tha-ap154:2.4": "bodhiyaṃ okiriṃ ahaṃ. ",
  "tha-ap154:3.1": "sammajjitvāna taṃ bodhiṃ ",
  "tha-ap154:3.2": "pāṭaliṃ pādaputtamaṃ ",
  "tha-ap154:3.3": "pallaṅkaṃ ābhujitvāna ",
  "tha-ap154:3.4": "bodhimūlaṃ upāvisiṃ. ",
  "tha-ap154:4.1": "gatamaggaṃ gavesantā ",
  "tha-ap154:4.2": "āgañchuṃ mama santikaṃ ",
  "tha-ap154:4.3": "te ca disvānahaṃ tattha ",
  "tha-ap154:4.4": "āvajjiṃ bodhimuttamaṃ. ",
  "tha-ap154:5.1": "vanditvā ca ahaṃ bodhiṃ ",
  "tha-ap154:5.2": "vippasannena cetasā ",
  "tha-ap154:5.3": "anekatāle papatiṃ ",
  "tha-ap154:5.4": "giridugge bhayānake. ",
  "tha-ap154:6.1": "ekanavute ito kappe ",
  "tha-ap154:6.2": "yaṃ pupphamabhiropayiṃ ",
  "tha-ap154:6.3": "duggatiṃ nābhijānāmi ",
  "tha-ap154:6.4": "bodhipūjāyidaṃ phalaṃ. ",
  "tha-ap154:7.1": "ito ca tatiye kappe ",
  "tha-ap154:7.2": "rājā sammasito ahu ",
  "tha-ap154:7.3": "sattaratanasampanno ",
  "tha-ap154:7.4": "cakkavatti mahabbalo. ",
  "tha-ap154:8.1": "paṭisambhidā catasso ",
  "tha-ap154:8.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap154:8.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap154:9.1": "itthaṃ sudaṃ āyasmā tambapupphiyo thero imā gāthāyo abhāsitthāti. ",
  "tha-ap154:10.1": "tambapupphiyattherassa apadānaṃ samattaṃ. tatiyaṃ vīthisammajjakattherāpadānaṃ (153) "
}
