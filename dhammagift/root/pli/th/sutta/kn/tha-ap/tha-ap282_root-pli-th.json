{
  "tha-ap282:0.1": "",
  "tha-ap282:0.2": "",
  "tha-ap282:0.3": "",
  "tha-ap282:1.1": "mahāpathamhi visame ",
  "tha-ap282:1.2": "setu kārāpitaṃ mayā ",
  "tha-ap282:1.3": "taraṇatthāya lokassa ",
  "tha-ap282:1.4": "pasanno sehi pāṇibhi. ",
  "tha-ap282:2.1": "ekanavute ito kappe ",
  "tha-ap282:2.2": "yaṃ setu kāritaṃ mayā ",
  "tha-ap282:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap282:2.4": "setudānassidaṃ phalaṃ. ",
  "tha-ap282:3.1": "pañcapaññāsito kappe ",
  "tha-ap282:3.2": "eko āsiṃ samogato 4 ",
  "tha-ap282:3.3": "sattaratanasampanno ",
  "tha-ap282:3.4": "cakkavatti mahabbalo. ",
  "tha-ap282:4.1": "paṭisambhidā catasso ",
  "tha-ap282:4.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap282:4.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap282:5.1": "itthaṃ sudaṃ āyasmā taraṇiyo thero imā gāthāyo abhāsitthāti. ",
  "tha-ap282:6.1": "taraṇiyattherassa apadānaṃ ",
  "tha-ap282:6.2": "samattaṃ. uddānaṃ ",
  "tha-ap282:7.1": "sovaṇṇaṃ ",
  "tha-ap282:8.1": "tilamuṭṭhi ca ",
  "tha-ap282:8.2": "caṅkoṭakabbhañjamañjali ",
  "tha-ap282:8.3": "potthako citamāluvo ",
  "tha-ap282:8.4": "ekapuṇḍari setunā ",
  "tha-ap282:8.5": "dvecattāḷīsa gāthāyo ",
  "tha-ap282:8.6": "gaṇitāyo vibhāvihi. suvaṇṇabibbohanavaggo aṭṭhavīsatimo. ",
  "tha-ap282:9.1": "ekādasamaṃ bhāṇavāraṃ "
}
