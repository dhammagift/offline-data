{
  "tha-ap129:0.1": "",
  "tha-ap129:0.2": "",
  "tha-ap129:0.3": "",
  "tha-ap129:1.1": "ajjhāyiko mantadharo ",
  "tha-ap129:1.2": "tiṇṇaṃ vedāna pāragū ",
  "tha-ap129:1.3": "himavantassavidūre ",
  "tha-ap129:1.4": "vasāmi assame ahaṃ. ",
  "tha-ap129:2.1": "aggihuttañca me atthi ",
  "tha-ap129:2.2": "puṇḍarīkaphalāni ca ",
  "tha-ap129:2.3": "puṭake nikkhipitvāna ",
  "tha-ap129:2.4": "dumagge laggitaṃ mayā. ",
  "tha-ap129:3.1": "padumuttaro lokavidū ",
  "tha-ap129:3.2": "āhutīnaṃ paṭiggaho ",
  "tha-ap129:3.3": "mamuddharitukāmo so ",
  "tha-ap129:3.4": "bhikkhanto mamupāgami. ",
  "tha-ap129:4.1": "pasannacitto sumano ",
  "tha-ap129:4.2": "phalaṃ buddhassadāsahaṃ ",
  "tha-ap129:4.3": "pītisañjanano mayhaṃ ",
  "tha-ap129:4.4": "diṭṭhadhamme sukhāvaho. ",
  "tha-ap129:5.1": "suvaṇṇavaṇṇo sambuddho ",
  "tha-ap129:5.2": "āhutīnaṃ paṭiggaho ",
  "tha-ap129:5.3": "antalikkhe ṭhito satthā ",
  "tha-ap129:5.4": "imaṃ gāthaṃ abhāsatha. ",
  "tha-ap129:6.1": "iminā phaladānena ",
  "tha-ap129:6.2": "cetanāpaṇidhīhi ca ",
  "tha-ap129:6.3": "kappānaṃ satasahassaṃ ",
  "tha-ap129:6.4": "duggatiṃ nūpapajjati. ",
  "tha-ap129:7.1": "teneva sukkamūlena ",
  "tha-ap129:7.2": "anubhutvāna sampadā ",
  "tha-ap129:7.3": "pattomhi acalaṃ ṭhānaṃ ",
  "tha-ap129:7.4": "hitvā jayaparājayaṃ. ",
  "tha-ap129:8.1": "ito sattakappasate ",
  "tha-ap129:8.2": "rājā āsiṃ sumaṅgalo ",
  "tha-ap129:8.3": "sattaratanasampanno ",
  "tha-ap129:8.4": "cakkavatti mahabbalo. ",
  "tha-ap129:9.1": "paṭisambhidā catasso ",
  "tha-ap129:9.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap129:9.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap129:10.1": "itthaṃ sudaṃ āyasmā phaladāyako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap129:11.1": "phaladāyakattherassa apadānaṃ samattaṃ. aṭṭhamaṃ ñāṇasaññakattherāpadānaṃ (128) "
}
