{
  "tha-ap502:0.1": "",
  "tha-ap502:0.2": "",
  "tha-ap502:0.3": "",
  "tha-ap502:1.1": "migaluddho pure āsiṃ ",
  "tha-ap502:1.2": "vivane vicaraṃ tadā ",
  "tha-ap502:1.3": "addasaṃ virajaṃ buddhaṃ ",
  "tha-ap502:1.4": "sabbadhammāna pāraguṃ. ",
  "tha-ap502:2.1": "piyālaphalamādāya ",
  "tha-ap502:2.2": "buddhaseṭṭhassadāsahaṃ ",
  "tha-ap502:2.3": "puññakhettassa vīrassa ",
  "tha-ap502:2.4": "pasanno sehi pāṇibhi. ",
  "tha-ap502:3.1": "ekatiṃse ito kappe ",
  "tha-ap502:3.2": "yaṃ phalaṃ adadiṃ tadā ",
  "tha-ap502:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap502:3.4": "phaladānassidaṃ phalaṃ. ",
  "tha-ap502:4.1": "kilesā jhāpitā mayhaṃ ",
  "tha-ap502:4.2": "bhavā sabbe samūhatā nāgova bandhanaṃ chetvā ",
  "tha-ap502:4.3": "viharāmi anāsavo. ",
  "tha-ap502:5.1": "svāgataṃ vata me āsi ",
  "tha-ap502:5.2": "mama buddhassa santike tisso vijjā anuppattā ",
  "tha-ap502:5.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap502:6.1": "paṭisambhidā catasso ",
  "tha-ap502:6.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap502:6.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap502:7.1": "itthaṃ sudaṃ āyasmā piyālaphaladāyako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap502:8.1": "piyālaphaladāyakattherassa apadānaṃ ",
  "tha-ap502:8.2": "samattaṃ. uddānaṃ ",
  "tha-ap502:9.1": "kiṃkaṇi ",
  "tha-ap502:10.1": "paṃsukūlañca ",
  "tha-ap502:10.2": "varakoraṇḍakiṃsukaṃ ",
  "tha-ap502:10.3": "upaḍḍhadussi ghatado ",
  "tha-ap502:10.4": "udakaṃ thūpakārako. ",
  "tha-ap502:11.1": "naḷāgāri ca navamo ",
  "tha-ap502:11.2": "piyālaphaladāyako ",
  "tha-ap502:11.3": "satamekañca gāthānaṃ ",
  "tha-ap502:11.4": "navakañca taduttari. ",
  "tha-ap502:12.1": "kiṃkaṇipupphavaggo paññāsamo. ",
  "tha-ap502:13.1": "atha vagguddānaṃ metteyyavaggo bhaddāli ",
  "tha-ap502:13.2": "sakiṃsammajjakopica ",
  "tha-ap502:13.3": "ekavihārī vibhedako ",
  "tha-ap502:13.4": "jagati sālapupphiyo. ",
  "tha-ap502:14.1": "naḷamāli paṃsukūlaṃ ",
  "tha-ap502:14.2": "kīkaṇipupphiko tathā ",
  "tha-ap502:14.3": "asīti dve ca gāthāyo ",
  "tha-ap502:14.4": "catuddasā satāni ca. ",
  "tha-ap502:15.1": "metteyyavaggadasakaṃ ",
  "tha-ap502:16.1": "pañcamaṃ satakaṃ samattaṃ. "
}
