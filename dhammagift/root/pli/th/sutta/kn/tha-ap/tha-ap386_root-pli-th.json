{
  "tha-ap386:0.1": "",
  "tha-ap386:0.2": "",
  "tha-ap386:0.3": "",
  "tha-ap386:1.1": "vanantare buddhaṃ disvā ",
  "tha-ap386:1.2": "atthadassiṃ mahāyasaṃ ",
  "tha-ap386:1.3": "pasannacitto sumano ",
  "tha-ap386:1.4": "milakkhussa phalaṃ adaṃ. ",
  "tha-ap386:2.1": "aṭṭhārase kappasate ",
  "tha-ap386:2.2": "yaṃ phalaṃ adadiṃ tadā ",
  "tha-ap386:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap386:2.4": "phaladānassidaṃ phalaṃ. ",
  "tha-ap386:3.1": "svāgataṃ vata me āsi mama buddhassa santike tisso vijjā anuppattā kataṃ buddhassa sāsanaṃ. kilesā jhāpitā mayhaṃ ",
  "tha-ap386:3.2": "bhavā sabbe samūhatā nāgova bandhanaṃ chetvā ",
  "tha-ap386:3.3": "viharāmi anāsavo. ",
  "tha-ap386:4.1": "",
  "tha-ap386:4.2": "",
  "tha-ap386:4.3": "",
  "tha-ap386:5.1": "paṭisambhidā catasso ",
  "tha-ap386:5.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap386:5.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap386:6.1": "itthaṃ sudaṃ āyasmā milakkhuphaladāyako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap386:7.1": "milakkhuphaladāyakattherassa apadānaṃ samattaṃ. pañcamaṃ phārusaphaladāyakattherāpadānaṃ (385) "
}
