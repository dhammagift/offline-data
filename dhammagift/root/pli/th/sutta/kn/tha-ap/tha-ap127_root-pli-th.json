{
  "tha-ap127:0.1": "",
  "tha-ap127:0.2": "",
  "tha-ap127:0.3": "",
  "tha-ap127:1.1": "jāyamāne vipassamhi ",
  "tha-ap127:1.2": "nimittaṃ byākariṃ ahaṃ ",
  "tha-ap127:1.3": "nibbāpayaṃ ca janataṃ ",
  "tha-ap127:1.4": "buddho loke bhavissati. ",
  "tha-ap127:2.1": "yasmiṃ ca jāyamānasmiṃ ",
  "tha-ap127:2.2": "dasasahassī pakampati ",
  "tha-ap127:2.3": "sodāni bhagavā satthā ",
  "tha-ap127:2.4": "dhammaṃ deseti cakkhumā. ",
  "tha-ap127:3.1": "yasmiṃ ca jāyamānasmiṃ ",
  "tha-ap127:3.2": "āloko vipulo ahu ",
  "tha-ap127:3.3": "sodāni bhagavā satthā ",
  "tha-ap127:3.4": "dhammaṃ deseti cakkhumā. ",
  "tha-ap127:4.1": "yasmiṃ ca jāyamānasmiṃ ",
  "tha-ap127:4.2": "saritāyo na sandisuṃ ",
  "tha-ap127:4.3": "sodāni bhagavā satthā ",
  "tha-ap127:4.4": "dhammaṃ deseti cakkhumā. ",
  "tha-ap127:5.1": "yasmiṃ ca jāyamānasmiṃ ",
  "tha-ap127:5.2": "avīciggi na pajjali ",
  "tha-ap127:5.3": "sodāni bhagavā satthā ",
  "tha-ap127:5.4": "dhammaṃ deseti cakkhumā. ",
  "tha-ap127:6.1": "yasmiṃ ca jāyamānasmiṃ ",
  "tha-ap127:6.2": "pakkhisaṅgho na sañcari ",
  "tha-ap127:6.3": "sodāni bhagavā satthā ",
  "tha-ap127:6.4": "dhammaṃ deseti cakkhumā. ",
  "tha-ap127:7.1": "yasmiñca jāyamānasmiṃ ",
  "tha-ap127:7.2": "vātakkhandho na vāyati ",
  "tha-ap127:7.3": "sodāni bhagavā satthā ",
  "tha-ap127:7.4": "dhammaṃ deseti cakkhumā. ",
  "tha-ap127:8.1": "yasmiñca jāyamānasmiṃ ",
  "tha-ap127:8.2": "sabbaratanāni jotisuṃ ",
  "tha-ap127:8.3": "sodāni bhagavā satthā ",
  "tha-ap127:8.4": "dhammaṃ deseti cakkhumā. ",
  "tha-ap127:9.1": "yasmiñca jāyamānasmiṃ ",
  "tha-ap127:9.2": "sattāsuṃ padavikkamā ",
  "tha-ap127:9.3": "sodāni bhagavā satthā ",
  "tha-ap127:9.4": "dhammaṃ deseti cakkhumā. ",
  "tha-ap127:10.1": "jātamattova sambuddho ",
  "tha-ap127:10.2": "disā sabbā vilokayi ",
  "tha-ap127:10.3": "vācāsabhimudīresi ",
  "tha-ap127:10.4": "esā buddhāna dhammatā. ",
  "tha-ap127:11.1": "saṃvejayitvā janataṃ ",
  "tha-ap127:11.2": "thavitvā lokanāyakaṃ ",
  "tha-ap127:11.3": "sambuddhaṃ abhivāditvā ",
  "tha-ap127:11.4": "pakkāmiṃ pācināmukho. ",
  "tha-ap127:12.1": "enavute ito kappe ",
  "tha-ap127:12.2": "yaṃ buddhamabhithomayiṃ ",
  "tha-ap127:12.3": "duggatiṃ nābhijānāmi ",
  "tha-ap127:12.4": "thomanāya idaṃ phalaṃ. ",
  "tha-ap127:13.1": "ito navutikappamhi ",
  "tha-ap127:13.2": "sammukhāthavikavhayo ",
  "tha-ap127:13.3": "sattaratanasampanno ",
  "tha-ap127:13.4": "cakkavatti mahabbalo. ",
  "tha-ap127:14.1": "paṭhavīdundubhi nāma ",
  "tha-ap127:14.2": "ekūnanavutimhito ",
  "tha-ap127:14.3": "sattaratanasampanno ",
  "tha-ap127:14.4": "cakkavatti mahabbalo. ",
  "tha-ap127:15.1": "aṭṭhāsītimhito kappe ",
  "tha-ap127:15.2": "obhāso nāma khattiyo ",
  "tha-ap127:15.3": "sattaratanasampanno ",
  "tha-ap127:15.4": "cakkavatti mahabbalo. ",
  "tha-ap127:16.1": "sattāsītimhito kappe ",
  "tha-ap127:16.2": "saritacchedanavhayo ",
  "tha-ap127:16.3": "sattaratanasampanno ",
  "tha-ap127:16.4": "cakkavatti mahabbalo. ",
  "tha-ap127:17.1": "agginibbāpano nāma ",
  "tha-ap127:17.2": "kappānaṃ chaḷasītiyā ",
  "tha-ap127:17.3": "sattaratanasampanno ",
  "tha-ap127:17.4": "cakkavatti mahabbalo. ",
  "tha-ap127:18.1": "rājā vātasamo nāma kappānaṃ pañcasītiyā sattaratanasampanno cakkavatti mahabbalo. gatipacchedano nāma ",
  "tha-ap127:18.2": "kappānaṃ ",
  "tha-ap127:18.3": "",
  "tha-ap127:18.4": "",
  "tha-ap127:19.1": "",
  "tha-ap127:19.2": "cullasītiyā ",
  "tha-ap127:19.3": "sattaratanasampanno ",
  "tha-ap127:19.4": "cakkavatti mahabbalo. ",
  "tha-ap127:20.1": "ratanappajjalo nāma ",
  "tha-ap127:20.2": "kappānaṃ te asītiyā ",
  "tha-ap127:20.3": "sattaratanasampanno ",
  "tha-ap127:20.4": "cakkavatti mahabbalo. ",
  "tha-ap127:21.1": "padavikkamano nāma ",
  "tha-ap127:21.2": "kappānaṃ dve asītiyā ",
  "tha-ap127:21.3": "sattaratanasampanno ",
  "tha-ap127:21.4": "cakkavatti mahabbalo. ",
  "tha-ap127:22.1": "rājā vilokano nāma ",
  "tha-ap127:22.2": "kappānaṃ ekasītiyā ",
  "tha-ap127:22.3": "sattaratanasampanno ",
  "tha-ap127:22.4": "cakkavatti mahabbalo. ",
  "tha-ap127:23.1": "girisāroti nāmena ",
  "tha-ap127:23.2": "kappesītimhi khattiyo ",
  "tha-ap127:23.3": "sattaratanasampanno ",
  "tha-ap127:23.4": "cakkavatti mahabbalo. ",
  "tha-ap127:24.1": "paṭisambhidā catasso ",
  "tha-ap127:24.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap127:24.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap127:25.1": "itthaṃ sudaṃ āyasmā sammukhāthaviko thero imā gāthāyo abhāsitthāti. ",
  "tha-ap127:26.1": "sammukhāthavikattherassa apadānaṃ samattaṃ. chaṭṭhaṃ kusumāsaniyattherāpadānaṃ (126) "
}
