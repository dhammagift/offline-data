  "tha-ap292:0.3": "",
  "tha-ap292:1.1": "cullāsītisahassāni ",
  "tha-ap292:1.2": "pabbajimha akiñcanā ",
  "tha-ap292:1.3": "tesaṃ pubbaṅgamo āsiṃ ",
  "tha-ap292:1.4": "uttamatthassa pattiyā. ",
  "tha-ap292:2.1": "sarāgā samohā cete ",
  "tha-ap292:2.2": "vippasannamanāvilaṃ ",
  "tha-ap292:2.3": "upaṭṭhahiṃsu sakkaccaṃ ",
  "tha-ap292:2.4": "pasannā sehi pāṇihi. ",
  "tha-ap292:3.1": "khīṇāsavā vantadosā ",
  "tha-ap292:3.2": "katakiccā anāsavā ",
  "tha-ap292:3.3": "phariṃsu mettacittena ",
  "tha-ap292:3.4": "sayambhū aparājitā. ",
  "tha-ap292:4.1": "tesaṃ upaṭṭhahitvāna ",
  "tha-ap292:4.2": "sambuddhānaṃ paṭissato ",
  "tha-ap292:4.3": "maraṇañca anuppattā ",
  "tha-ap292:4.4": "devattañca agamhase. ",
  "tha-ap292:5.1": "catunavute ito kappe ",
  "tha-ap292:5.2": "yaṃ sīlamanupālayiṃ ",
  "tha-ap292:5.3": "duggatiṃ nābhijānāmi ",
  "tha-ap292:5.4": "saññamassa idaṃ phalaṃ. ",
  "tha-ap292:6.1": "paṭisambhidā catasso ",
  "tha-ap292:6.2": "vimokkhāpica aṭṭhime. chaḷabhiññā sacchikatā ",
  "tha-ap292:6.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap292:7.1": "itthaṃ sudaṃ āyasmā pubbaṅgamaniyo thero imā gāthāyo abhāsitthāti. ",
  "tha-ap292:8.1": "pubbaṅgamaniyattherassa apadānaṃ samattaṃ. uddānaṃ paṇṇaṃ phalaṃ uggamiyo ekapupphī ca māghavo upaṭṭhākopadānañca pabbajjā ca upaṭṭhitaṃ. pubbaṅgamo ca gāthāyo aṭṭhatāḷīsa kittitā. ",
  "tha-ap292:9.1": "paṇṇadāyakavaggo ekūnatiṃso. ",
