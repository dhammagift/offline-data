{
  "tha-ap76:0.1": "",
  "tha-ap76:0.2": "",
  "tha-ap76:0.3": "",
  "tha-ap76:1.1": "kānanaṃ vanamoggayha ",
  "tha-ap76:1.2": "vasāmi pavane ahaṃ ",
  "tha-ap76:1.3": "vipassiṃ addasaṃ buddhaṃ ",
  "tha-ap76:1.4": "āhutīnaṃ paṭiggahaṃ. ",
  "tha-ap76:2.1": "bhisāluvañca pādāsiṃ ",
  "tha-ap76:2.2": "udakaṃ hatthadhovanaṃ ",
  "tha-ap76:2.3": "vanditvā sirasā pāde ",
  "tha-ap76:2.4": "pakkāmi uttarāmukho. ",
  "tha-ap76:3.1": "ekanavute ito kappe ",
  "tha-ap76:3.2": "bhisāluvaṃ adaṃ tadā ",
  "tha-ap76:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap76:3.4": "puññakammassidaṃ phalaṃ. ",
  "tha-ap76:4.1": "ito ca tatiye kappe ",
  "tha-ap76:4.2": "bhisasammatakhattiyo ",
  "tha-ap76:4.3": "sattaratanasampanno ",
  "tha-ap76:4.4": "cakkavatti mahabbalo. ",
  "tha-ap76:5.1": "paṭisambhidā catasso ",
  "tha-ap76:5.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap76:5.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap76:6.1": "itthaṃ sudaṃ āyasmā bhisāluvadāyako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap76:7.1": "bhisāluvadāyakattherassa apadānaṃ samattaṃ. chaṭṭhamaṃ bhāṇavāraṃ. pañcamaṃ ",
  "tha-ap76:7.2": "ekasaññakattherāpadānaṃ (75) "
}
