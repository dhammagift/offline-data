{
  "tha-ap19:0.1": "",
  "tha-ap19:0.2": "",
  "tha-ap19:0.3": "",
  "tha-ap19:1.1": "padumuttaraṃ bhagavantaṃ ",
  "tha-ap19:1.2": "lokajeṭṭhaṃ narāsabhaṃ ",
  "tha-ap19:1.3": "pabbhāramhi nisinnaṃ taṃ ",
  "tha-ap19:1.4": "upagañchiṃ naruttamaṃ. ",
  "tha-ap19:2.1": "kaṇikāraṃ pupphitaṃ disvā ",
  "tha-ap19:2.2": "vaṇṭe chetvāna taṃ tadā ",
  "tha-ap19:2.3": "alaṅkaritvā chattamhi ",
  "tha-ap19:2.4": "buddhassa abhiropayiṃ. ",
  "tha-ap19:3.1": "piṇḍapātañca pādāsiṃ ",
  "tha-ap19:3.2": "paramannaṃ subhojanaṃ ",
  "tha-ap19:3.3": "buddhena navame tattha ",
  "tha-ap19:3.4": "samaṇe aṭṭha bhojayī. ",
  "tha-ap19:4.1": "anumodi mahāvīro ",
  "tha-ap19:4.2": "sayambhū aggapuggalo ",
  "tha-ap19:4.3": "iminā chattadānena ",
  "tha-ap19:4.4": "paramannapavecchanā. ",
  "tha-ap19:5.1": "tena cittappasādena ",
  "tha-ap19:5.2": "sampattiṃ anubhossasi tiṃsakkhattuṃ ",
  "tha-ap19:5.3": "ca devindo ",
  "tha-ap19:5.4": "devarajjaṃ karissati. ",
  "tha-ap19:6.1": "ekavīsatikkhattuṃ ca ",
  "tha-ap19:6.2": "cakkavatti bhavissati ",
  "tha-ap19:6.3": "padesarajjaṃ vipulaṃ ",
  "tha-ap19:6.4": "gaṇanāto asaṅkhayaṃ. yaṃ vadanti ",
  "tha-ap19:7.1": "sumedhoti bhūripaññaṃ sumedhasaṃ kappeto satasahasse ",
  "tha-ap19:7.2": "okkākakulasambhavo. ",
  "tha-ap19:7.3": "gotamo nāma gottena ",
  "tha-ap19:7.4": "eso buddho bhavissati ",
  "tha-ap19:8.1": "sāsane dippamānamhi ",
  "tha-ap19:8.2": "manussattaṃ gamissati. ",
  "tha-ap19:8.3": "",
  "tha-ap19:8.4": "",
  "tha-ap19:9.1": "upasenoti nāmena ",
  "tha-ap19:9.2": "hessati satthusāvako ",
  "tha-ap19:9.3": "",
  "tha-ap19:9.4": "",
  "tha-ap19:10.1": "carimaṃ vattate mayhaṃ ",
  "tha-ap19:10.2": "bhavā sabbe samūhatā ",
  "tha-ap19:10.3": "dhāremi antimaṃ dehaṃ ",
  "tha-ap19:10.4": "jetvā māraṃ savāhanaṃ. ",
  "tha-ap19:11.1": "paṭisambhidā catasso ",
  "tha-ap19:11.2": "vimokkhāpica aṭṭhime ",
  "tha-ap19:11.3": "chaḷabhiññā sacchikatā ",
  "tha-ap19:11.4": "kataṃ buddhassa sāsananti. ",
  "tha-ap19:12.1": "itthaṃ sudaṃ āyasmā upaseno vaṅgantaputto thero imā gāthāyo abhāsitthāti. ",
  "tha-ap19:13.1": "upasenavaṅgantaputtattherassa apadānaṃ samattaṃ. ",
  "tha-ap19:13.2": "tatiyabhāṇavāraṃ niṭṭhitaṃ. aṭṭhamaṃ raṭṭhapālattherāpadānaṃ (18) "
}
