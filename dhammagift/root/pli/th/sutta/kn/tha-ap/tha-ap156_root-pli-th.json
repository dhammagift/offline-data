  "tha-ap156:0.1": "",
  "tha-ap156:0.2": "",
  "tha-ap156:0.3": "",
  "tha-ap156:1.1": "devaputto ahaṃ santo ",
  "tha-ap156:1.2": "pūjayiṃ sikhināyakaṃ ",
  "tha-ap156:1.3": "kakkārupupphaṃ paggayha ",
  "tha-ap156:1.4": "buddhassa abhiropayiṃ. ",
  "tha-ap156:2.1": "ekatiṃse ito kappe ",
  "tha-ap156:2.2": "yaṃ pupphamabhiropayiṃ ",
  "tha-ap156:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap156:2.4": "buddhapūjāyidaṃ phalaṃ. ",
  "tha-ap156:3.1": "ito ca navame kappe ",
  "tha-ap156:3.2": "rājā sattuttamo ahu ",
  "tha-ap156:3.3": "sattaratanasampanno ",
  "tha-ap156:3.4": "cakkavatti mahabbalo. ",
  "tha-ap156:4.1": "paṭisambhidā catasso ",
  "tha-ap156:4.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap156:4.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap156:5.1": "itthaṃ sudaṃ āyasmā kakkārupūjako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap156:6.1": "kakkārupūjakattherassa apadānaṃ samattaṃ. pañcamaṃ mandāravapupphapūjakattherāpadānaṃ (155) "
}
