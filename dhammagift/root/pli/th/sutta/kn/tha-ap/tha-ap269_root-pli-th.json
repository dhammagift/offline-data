  "tha-ap269:0.1": "",
  "tha-ap269:0.2": "",
  "tha-ap269:0.3": "",
  "tha-ap269:1.1": "candabhāgānadītīre ",
  "tha-ap269:1.2": "āsiṃ vanacaro tadā ",
  "tha-ap269:1.3": "siddhatthaṃ addasaṃ buddhaṃ ",
  "tha-ap269:1.4": "gacchantaṃ anilañjase. ",
  "tha-ap269:2.1": "añjaliṃ paggahetvāna ",
  "tha-ap269:2.2": "olokento mahāmuniṃ ",
  "tha-ap269:2.3": "sakaṃ cittaṃ pasādetvā abhivandiṃ lokanāyakaṃ. catunavute ito kappe yaṃ ",
  "tha-ap269:2.4": "avandiṃ ",
  "tha-ap269:3.1": "",
  "tha-ap269:3.2": "narāsabhaṃ ",
  "tha-ap269:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap269:3.4": "vandanāya idaṃ phalaṃ. ",
  "tha-ap269:4.1": "paṭisambhidā catasso ",
  "tha-ap269:4.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap269:4.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap269:5.1": "itthaṃ sudaṃ āyasmā javahaṃsako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap269:6.1": "javahaṃsakattherassa apadānaṃ samattaṃ. aṭṭhamaṃ salaḷapupphiyattherāpadānaṃ (268) "
}
