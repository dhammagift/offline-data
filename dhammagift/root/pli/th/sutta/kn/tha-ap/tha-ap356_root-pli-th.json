  "tha-ap356:0.1": "",
  "tha-ap356:0.2": "",
  "tha-ap356:0.3": "",
  "tha-ap356:1.1": "akkantañca padaṃ disvā ",
  "tha-ap356:1.2": "sikhino lokabandhuno ",
  "tha-ap356:1.3": "ekaṃsaṃ ajinaṃ katvā ",
  "tha-ap356:1.4": "padaṃ seṭṭhaṃ avandahaṃ. ",
  "tha-ap356:2.1": "koraṇḍaṃ pupphitaṃ disvā ",
  "tha-ap356:2.2": "pādapaṃ dharaṇīruhaṃ ",
  "tha-ap356:2.3": "sakoṭakaṃ gahetvāna ",
  "tha-ap356:2.4": "pade cakkaṃ apūjayiṃ. ",
  "tha-ap356:3.1": "ekatiṃse ito kappe ",
  "tha-ap356:3.2": "yaṃ kammamakariṃ tadā ",
  "tha-ap356:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap356:3.4": "buddhapūjāyidaṃ phalaṃ ",
  "tha-ap356:4.1": "paṭisambhidā catasso ",
  "tha-ap356:4.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap356:4.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap356:5.1": "itthaṃ sudaṃ āyasmā sakoṭakakoraṇḍadāyako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap356:6.1": "sakoṭakakoraṇḍadāyakattherassa apadānaṃ samattaṃ. pañcamaṃ daṇḍadāyakattherāpadānaṃ (355) "
}
