{
  "tha-ap452:0.1": "",
  "tha-ap452:0.2": "",
  "tha-ap452:0.3": "",
  "tha-ap452:1.1": "siddhatthassa bhagavato ",
  "tha-ap452:1.2": "dipadindassa tādino ",
  "tha-ap452:1.3": "pasannacitto sumano ",
  "tha-ap452:1.4": "bodhigharamakārayiṃ. ",
  "tha-ap452:2.1": "tussitaṃ upapannomhi ",
  "tha-ap452:2.2": "vasāmi ratane ghare ",
  "tha-ap452:2.3": "na me sītaṃ va uṇhaṃ vā ",
  "tha-ap452:2.4": "vāto gatte na samphuse. ",
  "tha-ap452:3.1": "pañcasaṭṭhimhito kappe ",
  "tha-ap452:3.2": "cakkavatti ahosahaṃ ",
  "tha-ap452:3.3": "kāsikaṃ nāma nagaraṃ ",
  "tha-ap452:3.4": "visukammena māpitaṃ. ",
  "tha-ap452:4.1": "dasayojanaāyāmaṃ ",
  "tha-ap452:4.2": "aṭṭhayojanavitthataṃ ",
  "tha-ap452:4.3": "na tamhi nagare atthi ",
  "tha-ap452:4.4": "kaṭṭhaṃ vallī ca mattikā. ",
  "tha-ap452:5.1": "tiriyaṃ yojanaṃ āsi ",
  "tha-ap452:5.2": "aḍḍhayojanavitthataṃ ",
  "tha-ap452:5.3": "maṅgalo nāma pāsādo ",
  "tha-ap452:5.4": "visukammena māpito. ",
  "tha-ap452:6.1": "cūḷāsītisahassāni ",
  "tha-ap452:6.2": "thambhā sovaṇṇiyā ahu ",
  "tha-ap452:6.3": "maṇimayā ca niyyūhā ",
  "tha-ap452:6.4": "chadanaṃ rūpiyaṃ ahu. ",
  "tha-ap452:7.1": "sabbasoṇṇamayaṃ gharaṃ ",
  "tha-ap452:7.2": "visukammena māpitaṃ ",
  "tha-ap452:7.3": "ajjhāvutthaṃ mayā etaṃ ",
  "tha-ap452:7.4": "gharadānassidaṃ phalaṃ. ",
  "tha-ap452:8.1": "te sabbe anubhotvāna ",
  "tha-ap452:8.2": "devamānusake bhave ",
  "tha-ap452:8.3": "ajja pattomhi nibbānaṃ ",
  "tha-ap452:8.4": "santipadaṃ anuttaraṃ. ",
  "tha-ap452:9.1": "tiṃsakappasahassamhi ",
  "tha-ap452:9.2": "bodhigharamakārayiṃ ",
  "tha-ap452:9.3": "duggatiṃ nābhijānāmi ",
  "tha-ap452:9.4": "gharadānassidaṃ phalaṃ. ",
  "tha-ap452:10.1": "kilesā jhāpitā mayhaṃ ",
  "tha-ap452:10.2": "bhavā sabbe samūhatā nāgova bandhanaṃ chetvā ",
  "tha-ap452:10.3": "viharāmi anāsavo. ",
  "tha-ap452:11.1": "svāgataṃ vata me āsi ",
  "tha-ap452:11.2": "mama buddhassa santike tisso vijjā anuppattā ",
  "tha-ap452:11.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap452:12.1": "paṭisambhidā catasso ",
  "tha-ap452:12.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap452:12.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap452:13.1": "itthaṃ sudaṃ āyasmā bodhigharakārako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap452:14.1": "bodhigharakārakattherassa apadānaṃ ",
  "tha-ap452:15.1": "samattaṃ. uddānaṃ ",
  "tha-ap452:16.1": "vibhedaki ",
  "tha-ap452:17.1": "kolaphali ",
  "tha-ap452:17.2": "billa bhallātakappado ummā ",
  "tha-ap452:17.3": "ambāṭaki ceva ",
  "tha-ap452:17.4": "āsani pādapīṭhako. ",
  "tha-ap452:18.1": "vedikā bodhighariko ",
  "tha-ap452:18.2": "gāthāyo gaṇitāpica ",
  "tha-ap452:18.3": "ekūnāsītikā sabbā ",
  "tha-ap452:18.4": "asmiṃ vagge pakittitā. vibhedakivaggo pañcacattāḷīso. "
}
