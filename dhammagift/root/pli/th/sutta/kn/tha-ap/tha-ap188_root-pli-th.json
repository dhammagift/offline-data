  "tha-ap188:0.1": "",
  "tha-ap188:0.2": "",
  "tha-ap188:0.3": "",
  "tha-ap188:1.1": "nagare rammavatiyā ",
  "tha-ap188:1.2": "āsiṃ murajavādako ",
  "tha-ap188:1.3": "niccupaṭṭhānayuttomhi ",
  "tha-ap188:1.4": "gatohaṃ bodhimuttamaṃ. ",
  "tha-ap188:2.1": "sāyaṃ pātaṃ upaṭṭhitvā ",
  "tha-ap188:2.2": "sukkamūlena codito ",
  "tha-ap188:2.3": "aṭṭhārase kappasate ",
  "tha-ap188:2.4": "duggatiṃ nūpapajjahaṃ. ",
  "tha-ap188:3.1": "pañcadase kappasate ",
  "tha-ap188:3.2": "itohosiṃ janādhipo ",
  "tha-ap188:3.3": "damatho nāma nāmena ",
  "tha-ap188:3.4": "cakkavatti mahabbalo. ",
  "tha-ap188:4.1": "paṭisambhidā catasso ",
  "tha-ap188:4.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap188:4.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap188:5.1": "itthaṃ sudaṃ āyasmā bodhiupaṭṭhāyako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap188:6.1": "bodhiupaṭṭhāyakattherassa apadānaṃ samattaṃ. sattamaṃ ekacintikattherāpadānaṃ (187) "
}
