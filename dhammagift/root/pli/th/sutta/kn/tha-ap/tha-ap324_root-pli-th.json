{
  "tha-ap324:0.1": "",
  "tha-ap324:0.2": "",
  "tha-ap324:0.3": "",
  "tha-ap324:1.1": "kakudhaṃ vilasantaṃva ",
  "tha-ap324:1.2": "nisabhājāniyaṃ yathā ",
  "tha-ap324:1.3": "osadhīva virocantaṃ ",
  "tha-ap324:1.4": "obhāsantaṃ narāsabhaṃ. ",
  "tha-ap324:2.1": "añjaliṃ paggahetvāna ",
  "tha-ap324:2.2": "avandiṃ satthuno ahaṃ ",
  "tha-ap324:2.3": "satthāraṃ parivaṇṇesiṃ ",
  "tha-ap324:2.4": "sakakammena tosayiṃ. ",
  "tha-ap324:3.1": "susuddhaṃ puḷinaṃ gayhaṃ ",
  "tha-ap324:3.2": "gatamagge samokiriṃ ",
  "tha-ap324:3.3": "ucchaṅgena gahetvāna ",
  "tha-ap324:3.4": "vipassissa mahesino. ",
  "tha-ap324:4.1": "tato upaḍḍhapuḷinaṃ ",
  "tha-ap324:4.2": "vippasannena cetasā ",
  "tha-ap324:4.3": "divāvihāre osiñciṃ ",
  "tha-ap324:4.4": "dipadindassa tādino. ",
  "tha-ap324:5.1": "ekanavute ito kappe ",
  "tha-ap324:5.2": "puḷinaṃ yaṃ asiñcihaṃ ",
  "tha-ap324:5.3": "duggatiṃ nābhijānāmi ",
  "tha-ap324:5.4": "puḷinassa idaṃ phalaṃ. ",
  "tha-ap324:6.1": "paṭisambhidā catasso ",
  "tha-ap324:6.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap324:6.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap324:7.1": "itthaṃ sudaṃ āyasmā puḷinapūjako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap324:8.1": "puḷinapūjakattherassa apadānaṃ samattaṃ. tatiyaṃ hāsajanakattherāpadānaṃ (323) "
}
