{
  "tha-ap486:0.1": "",
  "tha-ap486:0.2": "",
  "tha-ap486:0.3": "",
  "tha-ap486:1.1": "dakkhiṇe himavantassa ",
  "tha-ap486:1.2": "sukato assamo mama ",
  "tha-ap486:1.3": "uttamatthaṃ gavesanto ",
  "tha-ap486:1.4": "vasāmi pavane tadā. ",
  "tha-ap486:2.1": "lābhālābhena santuṭṭho ",
  "tha-ap486:2.2": "mūlena ca phalena ca ",
  "tha-ap486:2.3": "anomasanto acari ",
  "tha-ap486:2.4": "vasāmi ekako ahaṃ. ",
  "tha-ap486:3.1": "sumedho nāma sambuddho ",
  "tha-ap486:3.2": "loke uppajji tāvade ",
  "tha-ap486:3.3": "catusaccaṃ pakāseti ",
  "tha-ap486:3.4": "uddharanto mahājanaṃ. ",
  "tha-ap486:4.1": "nāhaṃ suṇomi sambuddhaṃ ",
  "tha-ap486:4.2": "napi me koci sāsati ",
  "tha-ap486:4.3": "aṭṭhavasse atikkante ",
  "tha-ap486:4.4": "assosiṃ lokanāyakaṃ. ",
  "tha-ap486:5.1": "aggiṃ dāruṃ niharitvā ",
  "tha-ap486:5.2": "sammajjitvāna assamaṃ ",
  "tha-ap486:5.3": "khāribhāraṃ gahetvāna ",
  "tha-ap486:5.4": "nikkhamiṃ pavanā ahaṃ. ",
  "tha-ap486:6.1": "ekarattiṃ vasantohaṃ ",
  "tha-ap486:6.2": "gāmesu nigamesu ca ",
  "tha-ap486:6.3": "anupubbena candavatiṃ ",
  "tha-ap486:6.4": "tadāhaṃ upasaṅkamiṃ. ",
  "tha-ap486:7.1": "bhagavā tamhi samaye ",
  "tha-ap486:7.2": "sumedho lokanāyako ",
  "tha-ap486:7.3": "uddharanto bahū satte ",
  "tha-ap486:7.4": "deseti amataṃpadaṃ. ",
  "tha-ap486:8.1": "janakāyamatikkamma ",
  "tha-ap486:8.2": "vanditvā jinasāgataṃ ",
  "tha-ap486:8.3": "ekaṃsaṃ ajinaṃ katvā ",
  "tha-ap486:8.4": "santhaviṃ lokanāyakaṃ. ",
  "tha-ap486:9.1": "tuvaṃ satthā ca ketuva ",
  "tha-ap486:9.2": "dhajo yūpova pāṇinaṃ ",
  "tha-ap486:9.3": "parāyano patiṭṭhā ca ",
  "tha-ap486:9.4": "dīpo ca dipaduttamo. ",
  "tha-ap486:10.1": "ekavīsatimaṃ bhāṇavāraṃ. ",
  "tha-ap486:11.1": "nepuñño dassane dhīro ",
  "tha-ap486:11.2": "tāresi janataṃ tuvaṃ ",
  "tha-ap486:11.3": "natthañño tārako loke ",
  "tha-ap486:11.4": "tavuttarittaro mune. ",
  "tha-ap486:12.1": "sakkā bhave kusaggena ",
  "tha-ap486:12.2": "pametuṃ sāgaruttamo ",
  "tha-ap486:12.3": "na tveva tava sabbaññu ",
  "tha-ap486:12.4": "ñāṇaṃ sakkā pametave. ",
  "tha-ap486:13.1": "tuladaṇḍe ṭhapetvāna ",
  "tha-ap486:13.2": "mahi sakkā dharetave ",
  "tha-ap486:13.3": "na tveva tava paññāya ",
  "tha-ap486:13.4": "samānaṃ atthi cakkhuma. ",
  "tha-ap486:14.1": "ākāso minituṃ sakkā ",
  "tha-ap486:14.2": "rajjuyā aṅgulena ca ",
  "tha-ap486:14.3": "na tveva tava sabbaññu ",
  "tha-ap486:14.4": "sīlaṃ sakkā pametave. ",
  "tha-ap486:15.1": "mahāsamudde udakaṃ ",
  "tha-ap486:15.2": "ākāso ca vasundharo ",
  "tha-ap486:15.3": "parimeyyāni etāni ",
  "tha-ap486:15.4": "appameyyosi cakkhuma. ",
  "tha-ap486:16.1": "chahi gāthāhi sabbaññuṃ ",
  "tha-ap486:16.2": "kittayitvā mahāyasaṃ ",
  "tha-ap486:16.3": "añjaliṃ paggahetvāna ",
  "tha-ap486:16.4": "tuṇhī aṭṭhāsahaṃ tadā. ",
  "tha-ap486:17.1": "yaṃ vadanti sumedhoti ",
  "tha-ap486:17.2": "bhūmipaññaṃ sumedhasaṃ. ",
  "tha-ap486:17.3": "bhikkhusaṅghe nisīditvā ",
  "tha-ap486:17.4": "imā gāthā abhāsatha ",
  "tha-ap486:18.1": "yo me ñāṇaṃ pakittesi ",
  "tha-ap486:18.2": "vippasasanne cetasā. ",
  "tha-ap486:18.3": "tamahaṃ kittayissāmi ",
  "tha-ap486:18.4": "suṇātha mama bhāsato ",
  "tha-ap486:19.1": "sattasattati kappāni ",
  "tha-ap486:19.2": "devaloke ramissati. ",
  "tha-ap486:19.3": "sahassakkhattuṃ devindo ",
  "tha-ap486:19.4": "devarajjaṃ karissati ",
  "tha-ap486:20.1": "anekasatakkhattuñca ",
  "tha-ap486:20.2": "cakkavatti bhavissati. ",
  "tha-ap486:20.3": "padesarajjaṃ vipulaṃ ",
  "tha-ap486:20.4": "gaṇanāto asaṅkhayaṃ ",
  "tha-ap486:21.1": "devabhūto manusso vā ",
  "tha-ap486:21.2": "puññakammasamāhito. ",
  "tha-ap486:21.3": "anūnamanasaṅkappo ",
  "tha-ap486:21.4": "tikkhapañño bhavissati ",
  "tha-ap486:22.1": "tiṃsakappasahassamhi ",
  "tha-ap486:22.2": "okkākakulasambhavo. ",
  "tha-ap486:22.3": "gotamo nāma nāmena ",
  "tha-ap486:22.4": "satthā loke bhavissati ",
  "tha-ap486:23.1": "agārā abhinikkhamma ",
  "tha-ap486:23.2": "pabbajissatikiñcano. ",
  "tha-ap486:23.3": "jātiyā sattavassena ",
  "tha-ap486:23.4": "arahattaṃ pāpuṇissati ",
  "tha-ap486:24.1": "yato sarāmi attānaṃ ",
  "tha-ap486:24.2": "yato pattosmi sāsanaṃ. ",
  "tha-ap486:24.3": "etthantare na jānāmi ",
  "tha-ap486:24.4": "cetanaṃ amanoramaṃ ",
  "tha-ap486:25.1": "saṃsaritvā bhavābhave ",
  "tha-ap486:25.2": "sampattānubhaviṃ ahaṃ. ",
  "tha-ap486:25.3": "bhoge me ūnatā natthi ",
  "tha-ap486:25.4": "phalaṃ ñāṇassa thomane ",
  "tha-ap486:26.1": "tidhaggī nibbutā mayhaṃ ",
  "tha-ap486:26.2": "bhavā sabbe samūhatā. ",
  "tha-ap486:26.3": "sabbāsavaparikkhīṇo ",
  "tha-ap486:26.4": "natthi dāni punabbhavo ",
  "tha-ap486:27.1": "tiṃsakappasahassamhi ",
  "tha-ap486:27.2": "yaṃ ñāṇamabhithomahaṃ ",
  "tha-ap486:27.3": "duggatiṃ nābhijānāmi ",
  "tha-ap486:27.4": "phalaṃ ñāṇassa thomane. ",
  "tha-ap486:28.1": "kilesā jhāpitā mayhaṃ ",
  "tha-ap486:28.2": "bhavā sabbe samūhatā nāgova bandhanaṃ chetvā ",
  "tha-ap486:28.3": "viharāmi anāsavo. ",
  "tha-ap486:29.1": "svāgataṃ vata me āsi ",
  "tha-ap486:29.2": "mama buddhassa santike tisso vijjā anuppattā ",
  "tha-ap486:29.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap486:30.1": "paṭisambhidā catasso ",
  "tha-ap486:30.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap486:30.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap486:31.1": "itthaṃ sudaṃ āyasmā ñāṇatthaviko thero imā gāthāyo abhāsitthāti. ",
  "tha-ap486:32.1": "ñāṇatthavikattherassa apadānaṃ samattaṃ. pañcamaṃ candanamāliyattherāpadānaṃ (485) "
}
