{
  "tha-ap16:0.1": "",
  "tha-ap16:0.2": "",
  "tha-ap16:0.3": "",
  "tha-ap16:1.1": "padumuttaro nāma jino ",
  "tha-ap16:1.2": "āhutīnaṃ paṭiggaho ",
  "tha-ap16:1.3": "gaṇamhā vūpakaṭṭho so ",
  "tha-ap16:1.4": "himavante vasī tadā. ",
  "tha-ap16:2.1": "ahaṃpi himavantamhi ",
  "tha-ap16:2.2": "vasāmi assame tadā ",
  "tha-ap16:2.3": "acirāgataṃ mahāvīraṃ ",
  "tha-ap16:2.4": "upesiṃ lokanāyakaṃ. ",
  "tha-ap16:3.1": "pupphacchattaṃ gahetvāna ",
  "tha-ap16:3.2": "upagañchiṃ narāsabhaṃ ",
  "tha-ap16:3.3": "samādhiṃ samāpajjantaṃ ",
  "tha-ap16:3.4": "antarāyamakāsahaṃ. ",
  "tha-ap16:4.1": "ubhohatthehi paggayha ",
  "tha-ap16:4.2": "pupphacchattaṃ adāsahaṃ ",
  "tha-ap16:4.3": "paṭiggahesi bhagavā ",
  "tha-ap16:4.4": "padumuttaro mahāmuni. ",
  "tha-ap16:5.1": "sabbe devā attamanā ",
  "tha-ap16:5.2": "himavantaṃ upenti te ",
  "tha-ap16:5.3": "sādhukāraṃ pavattiṃsu ",
  "tha-ap16:5.4": "anumodissati cakkhumā. ",
  "tha-ap16:6.1": "idaṃ vatvāna te devā ",
  "tha-ap16:6.2": "upagañchuṃ naruttamaṃ ",
  "tha-ap16:6.3": "ākāse dhārayantassa ",
  "tha-ap16:6.4": "padumaṃ chattamuttamaṃ. ",
  "tha-ap16:7.1": "sattapattachattaṃ paggayha ",
  "tha-ap16:7.2": "adāsi tāpaso mama ",
  "tha-ap16:7.3": "tamahaṃ kittayissāmi ",
  "tha-ap16:7.4": "suṇātha mama bhāsato. ",
  "tha-ap16:8.1": "pañcavīsatikappāni ",
  "tha-ap16:8.2": "devarajjaṃ karissati ",
  "tha-ap16:8.3": "catuttiṃsatikkhattuñca ",
  "tha-ap16:8.4": "cakkavatti bhavissati. ",
  "tha-ap16:9.1": "yaṃ yaṃ yoniṃ saṃsarati ",
  "tha-ap16:9.2": "devattaṃ atha mānusaṃ ",
  "tha-ap16:9.3": "abbhokāse patiṭṭhantaṃ ",
  "tha-ap16:9.4": "padumaṃ dhārayissati. ",
  "tha-ap16:10.1": "kappasatasahassamhi ",
  "tha-ap16:10.2": "okkākakulasambhavo ",
  "tha-ap16:10.3": "gotamo nāma gottena ",
  "tha-ap16:10.4": "satthā loke bhavissati. ",
  "tha-ap16:11.1": "pakāsite pāvacane ",
  "tha-ap16:11.2": "manussattaṃ labhissati ",
  "tha-ap16:11.3": "manomayamhi kāyamhi ",
  "tha-ap16:11.4": "uttamo so bhavissati. ",
  "tha-ap16:12.1": "dve bhātaro bhavissanti ",
  "tha-ap16:12.2": "ubhopi panthakavhayā ",
  "tha-ap16:12.3": "anubhotvā uttamatthaṃ ",
  "tha-ap16:12.4": "jotayissanti sāsanaṃ. ",
  "tha-ap16:13.1": "so aṭṭhārasavassohaṃ ",
  "tha-ap16:13.2": "pabbajiṃ anagāriyaṃ ",
  "tha-ap16:13.3": "visesāhaṃ na vindāmi ",
  "tha-ap16:13.4": "sakyaputtassa sāsane. ",
  "tha-ap16:14.1": "dandhā mayhaṃ gati āsi ",
  "tha-ap16:14.2": "paribhūto pure ahaṃ ",
  "tha-ap16:14.3": "bhātā ca maṃ paṇāmesi ",
  "tha-ap16:14.4": "gaccha dāni sakaṃ gharaṃ. ",
  "tha-ap16:15.1": "sohaṃ paṇāmito santo ",
  "tha-ap16:15.2": "saṅghārāmassa koṭṭhake ",
  "tha-ap16:15.3": "dummano tattha aṭṭhāsiṃ ",
  "tha-ap16:15.4": "sāmaññasmiṃ apekkhavā. ",
  "tha-ap16:16.1": "athettha satthā āgacchi ",
  "tha-ap16:16.2": "sīsaṃ mayhaṃ parāmasi ",
  "tha-ap16:16.3": "bāhāya maṃ gahetvāna ",
  "tha-ap16:16.4": "saṅghārāmaṃ pavesayi. ",
  "tha-ap16:17.1": "anukampāya me satthā ",
  "tha-ap16:17.2": "adāsi pādapuñchaniṃ ",
  "tha-ap16:17.3": "evaṃ suddhaṃ adhiṭṭhehi ",
  "tha-ap16:17.4": "ekamantaṃ adhiṭṭhitaṃ. ",
  "tha-ap16:18.1": "hatthehi tamahaṃ gayha ",
  "tha-ap16:18.2": "sariṃ kokanadaṃ ahaṃ ",
  "tha-ap16:18.3": "tattha cittaṃ vimuccī me ",
  "tha-ap16:18.4": "arahattaṃ apāpuṇiṃ. ",
  "tha-ap16:19.1": "manomayesu kāyesu ",
  "tha-ap16:19.2": "sabbattha pāramiṃ gato ",
  "tha-ap16:19.3": "sabbāsave pariññāya ",
  "tha-ap16:19.4": "viharāmi anāsavo. ",
  "tha-ap16:20.1": "paṭisambhidā catasso ",
  "tha-ap16:20.2": "vimokkhāpica aṭṭhime ",
  "tha-ap16:20.3": "chaḷabhiññā sacchikatā ",
  "tha-ap16:20.4": "kataṃ buddhassa sāsananti. ",
  "tha-ap16:21.1": "itthaṃ sudaṃ āyasmā cullapanthako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap16:22.1": "cullapanthakattherassa apadānaṃ samattaṃ. pañcamaṃ pilindavacchattherāpadānaṃ (15) "
}
