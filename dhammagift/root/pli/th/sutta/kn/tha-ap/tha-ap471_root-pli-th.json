{
  "tha-ap471:0.1": "",
  "tha-ap471:0.2": "",
  "tha-ap471:0.3": "",
  "tha-ap471:1.1": "kakudhaṃ vilasantaṃva ",
  "tha-ap471:1.2": "devadevaṃ narāsabhaṃ ",
  "tha-ap471:1.3": "rathiyaṃ paṭipajjantaṃ ",
  "tha-ap471:1.4": "ko disvā nappasīdati. ",
  "tha-ap471:2.1": "tamandhakāraṃ nāsetvā ",
  "tha-ap471:2.2": "santāretvā bahuṃ janaṃ ",
  "tha-ap471:2.3": "ñāṇālokena jotantaṃ ",
  "tha-ap471:2.4": "ko disvā nappasīdati. ",
  "tha-ap471:3.1": "vasīsatasahassehi ",
  "tha-ap471:3.2": "niyyantaṃ lokanāyakaṃ ",
  "tha-ap471:3.3": "uddharantaṃ ḷahū satte ",
  "tha-ap471:3.4": "ko disvā nappasīdati. āhanitvā ",
  "tha-ap471:4.1": "dhammabheriṃ ",
  "tha-ap471:4.2": "maddantaṃ titthiye gaṇe ",
  "tha-ap471:4.3": "sīhanādaṃ va nadantaṃ ",
  "tha-ap471:4.4": "ko disvā nappasīdati. ",
  "tha-ap471:5.1": "yāvatā brahmalokamhā ",
  "tha-ap471:5.2": "āgantvāna sabrahmakā ",
  "tha-ap471:5.3": "pucchanti nipuṇe pañhe ",
  "tha-ap471:5.4": "ko disvā nappasīdati. ",
  "tha-ap471:6.1": "yassañjaliṃ karitvāna ",
  "tha-ap471:6.2": "ādhāvanti sadevakā ",
  "tha-ap471:6.3": "tena puññaṃ anubhonti ",
  "tha-ap471:6.4": "ko disvā nappasīdati. ",
  "tha-ap471:7.1": "sabbe janā samāgantvā ",
  "tha-ap471:7.2": "sampavārenti cakkhumaṃ ",
  "tha-ap471:7.3": "na vikampati ajjhiṭṭho ",
  "tha-ap471:7.4": "ko disvā nappasīdati. ",
  "tha-ap471:8.1": "nagaraṃ pavīsato yassa ",
  "tha-ap471:8.2": "nadanti bheriyo bahū ",
  "tha-ap471:8.3": "vinadanti gajā mattā ",
  "tha-ap471:8.4": "ko disvā nappasīdati. ",
  "tha-ap471:9.1": "vīthiyā gacchato yassa ",
  "tha-ap471:9.2": "pabhā vā jotate sadā ",
  "tha-ap471:9.3": "abbhunnatā samā honti ",
  "tha-ap471:9.4": "ko disvā nappasīdati. ",
  "tha-ap471:10.1": "byāharantassa buddhassa ",
  "tha-ap471:10.2": "cakkavāḷamhi suyyati ",
  "tha-ap471:10.3": "sabbe satte viññāpeti ",
  "tha-ap471:10.4": "ko disvā nappasīdati. satasahasse ",
  "tha-ap471:11.1": "ito kappe ",
  "tha-ap471:11.2": "yaṃ buddhamabhikittayiṃ ",
  "tha-ap471:11.3": "duggatiṃ nābhijānāmi ",
  "tha-ap471:11.4": "kittanāya idaṃ phalaṃ. ",
  "tha-ap471:12.1": "kilesā jhāpitā mayhaṃ ",
  "tha-ap471:12.2": "bhavā sabbe samūhatā nāgova bandhanaṃ chetvā ",
  "tha-ap471:12.3": "viharāmi anāsavo. ",
  "tha-ap471:13.1": "svāgataṃ vata me āsi ",
  "tha-ap471:13.2": "mama buddhassa santike tisso vijjā anuppattā ",
  "tha-ap471:13.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap471:14.1": "paṭisambhidā catasso ",
  "tha-ap471:14.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap471:14.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap471:15.1": "itthaṃ sudaṃ āyasmā sayampaṭibhāṇiyo thero imā gāthāyo abhāsitthāti. ",
  "tha-ap471:16.1": "sayampaṭibhāṇiyattherassa apadānaṃ samattaṃ. dasamaṃ nimittabyākaraṇiyattherāpadānaṃ (470) "
}
