{
  "tha-ap377:0.1": "",
  "tha-ap377:0.2": "",
  "tha-ap377:0.3": "",
  "tha-ap377:1.1": "sumano nāma sambuddho ",
  "tha-ap377:1.2": "uppajji lokanāyako ",
  "tha-ap377:1.3": "pasannacitto sumano ",
  "tha-ap377:1.4": "sattapaṇṇimapūjayiṃ. ",
  "tha-ap377:2.1": "satasahasse ito kappe ",
  "tha-ap377:2.2": "sattapaṇṇimapūjayiṃ ",
  "tha-ap377:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap377:2.4": "sattapaṇṇipūjāyidaṃ phalaṃ. ",
  "tha-ap377:3.1": "svāgataṃ vata me āsi mama buddhassa santike tisso vijjā anuppattā kataṃ buddhassa sāsanaṃ. kilesā jhāpitā mayhaṃ ",
  "tha-ap377:3.2": "bhavā sabbe samūhatā nāgova bandhanaṃ chetvā ",
  "tha-ap377:3.3": "viharāmi anāsavo. ",
  "tha-ap377:4.1": "",
  "tha-ap377:4.2": "",
  "tha-ap377:4.3": "",
  "tha-ap377:5.1": "paṭisambhidā catasso ",
  "tha-ap377:5.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap377:5.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap377:6.1": "itthaṃ sudaṃ āyasmā sattapaṇṇiyo thero imā gāthāyo abhāsitthāti. ",
  "tha-ap377:7.1": "sattapaṇṇiyattherassa apadānaṃ samattaṃ. chaṭṭhaṃ gandhamuṭṭhiyattherāpadānaṃ (376) "
}
