{
  "tha-ap91:0.1": "",
  "tha-ap91:0.2": "",
  "tha-ap91:0.3": "",
  "tha-ap91:1.1": "vipassissa bhagavato ",
  "tha-ap91:1.2": "mahābodhimaho ahu ",
  "tha-ap91:1.3": "pabbajjūpagato santo ",
  "tha-ap91:1.4": "upagañchimahaṃ tadā. ",
  "tha-ap91:2.1": "kusumbhodakamādāya ",
  "tha-ap91:2.2": "bodhiyā okiriṃ ahaṃ ",
  "tha-ap91:2.3": "mocayissati no mutto ",
  "tha-ap91:2.4": "nibbāpessati nibbuto. ",
  "tha-ap91:3.1": "ekanavute ito kappe ",
  "tha-ap91:3.2": "yaṃ bodhiṃ abhisiñcahaṃ ",
  "tha-ap91:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap91:3.4": "bodhisiñcassidaṃ phalaṃ. ",
  "tha-ap91:4.1": "tettiṃse vattamānamhi ",
  "tha-ap91:4.2": "kappe āsuṃ janādhipā ",
  "tha-ap91:4.3": "udakāsecanā nāma ",
  "tha-ap91:4.4": "aṭṭhete cakkavattino. ",
  "tha-ap91:5.1": "paṭisambhidā catasso ",
  "tha-ap91:5.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap91:5.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap91:6.1": "itthaṃ sudaṃ āyasmā bodhisiñcako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap91:7.1": "bodhisiñcakattherassa apadānaṃ samattaṃ. dasamaṃ padumapupphiyattherāpadānaṃ (90) "
}
