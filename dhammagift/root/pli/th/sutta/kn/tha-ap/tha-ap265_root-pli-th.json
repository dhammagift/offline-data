{
  "tha-ap265:0.1": "",
  "tha-ap265:0.2": "",
  "tha-ap265:0.3": "",
  "tha-ap265:1.1": "tissassa kho bhagavato ",
  "tha-ap265:1.2": "bodhiyā pādaputtame ",
  "tha-ap265:1.3": "aḍḍhacandaṃ mayā dinnaṃ ",
  "tha-ap265:1.4": "dharaṇīruhapādape. ",
  "tha-ap265:2.1": "dvenavute ito kappe ",
  "tha-ap265:2.2": "yaṃ candamabhiropayiṃ ",
  "tha-ap265:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap265:2.4": "bodhipūjāyidaṃ phalaṃ. ",
  "tha-ap265:3.1": "pañcavīse ito kappe ",
  "tha-ap265:3.2": "devalo nāma khattiyo ",
  "tha-ap265:3.3": "sattaratanasampanno ",
  "tha-ap265:3.4": "cakkavatti mahabbalo. ",
  "tha-ap265:4.1": "paṭisambhidā catasso ",
  "tha-ap265:4.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap265:4.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap265:5.1": "itthaṃ sudaṃ āyasmā aḍḍhacandiyo thero imā gāthāyo abhāsitthāti. ",
  "tha-ap265:6.1": "aḍḍhacandiyattherassa apadānaṃ samattaṃ. catutthaṃ dīpadāyakattherāpadānaṃ (264) "
}
