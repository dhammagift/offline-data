{
  "tha-ap288:0.1": "",
  "tha-ap288:0.2": "",
  "tha-ap288:0.3": "",
  "tha-ap288:1.1": "rathiyaṃ paṭipajjantaṃ ",
  "tha-ap288:1.2": "āhutīnaṃ paṭiggahaṃ ",
  "tha-ap288:1.3": "dipadindaṃ mahānāgaṃ ",
  "tha-ap288:1.4": "lokajeṭṭhaṃ narāsabhaṃ. ",
  "tha-ap288:2.1": "pakkosāpiyatassāhaṃ ",
  "tha-ap288:2.2": "sabbalokahitesino ",
  "tha-ap288:2.3": "upaṭṭhāko mayā dinno ",
  "tha-ap288:2.4": "siddhatthassa mahesino. ",
  "tha-ap288:3.1": "paṭiggahetvāna sambuddho ",
  "tha-ap288:3.2": "niyyātesi mahāmuni ",
  "tha-ap288:3.3": "uṭṭhāya āsanā tamhā ",
  "tha-ap288:3.4": "pakkāmi pācināmukho. ",
  "tha-ap288:4.1": "catunavute ito kappe ",
  "tha-ap288:4.2": "upaṭṭhākamadaṃ tadā ",
  "tha-ap288:4.3": "duggatiṃ nābhijānāmi ",
  "tha-ap288:4.4": "upaṭṭhānassidaṃ phalaṃ. ",
  "tha-ap288:5.1": "sattapaññāsito kappe ",
  "tha-ap288:5.2": "balasenasanāmako ",
  "tha-ap288:5.3": "sattaratanasampanno ",
  "tha-ap288:5.4": "cakkavatti mahabbalo. ",
  "tha-ap288:6.1": "paṭisambhidā catasso ",
  "tha-ap288:6.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap288:6.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap288:7.1": "itthaṃ sudaṃ āyasmā upaṭṭhāyiko thero imā gāthāyo abhāsitthāti. ",
  "tha-ap288:8.1": "upaṭṭhāyikattherassa apadānaṃ samattaṃ. sattamaṃ apadāniyattherāpadānaṃ (287) "
}
