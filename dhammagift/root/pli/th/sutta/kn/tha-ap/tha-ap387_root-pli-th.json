{
  "tha-ap387:0.1": "",
  "tha-ap387:0.2": "",
  "tha-ap387:0.3": "",
  "tha-ap387:1.1": "suvaṇṇavaṇṇaṃ sambuddhaṃ ",
  "tha-ap387:1.2": "āhutīnaṃ paṭiggahaṃ ",
  "tha-ap387:1.3": "rathiyaṃ paṭipajjantaṃ ",
  "tha-ap387:1.4": "phārusaphalaṃ adāsahaṃ. ekanavute ",
  "tha-ap387:2.1": "ito kappe ",
  "tha-ap387:2.2": "yaṃ phalaṃ adadaṃ ahaṃ ",
  "tha-ap387:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap387:2.4": "phaladānassidaṃ phalaṃ. ",
  "tha-ap387:3.1": "svāgataṃ vata me āsi mama buddhassa santike tisso vijjā anuppattā kataṃ buddhassa sāsanaṃ. kilesā jhāpitā mayhaṃ ",
  "tha-ap387:3.2": "bhavā sabbe samūhatā nāgova bandhanaṃ chetvā ",
  "tha-ap387:3.3": "viharāmi anāsavo. ",
  "tha-ap387:4.1": "",
  "tha-ap387:4.2": "",
  "tha-ap387:4.3": "",
  "tha-ap387:5.1": "paṭisambhidā catasso ",
  "tha-ap387:5.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap387:5.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap387:6.1": "itthaṃ sudaṃ āyasmā phārusaphaladāyako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap387:7.1": "phārusaphaladāyakattherassa apadānaṃ samattaṃ. chaṭṭhaṃ valliphaladāyakattherāpadānaṃ (386) "
}
