{
  "tha-ap363:0.1": "sattattiṃso mandāravapupphiyavaggo ",
  "tha-ap363:0.2": "",
  "tha-ap363:0.3": "",
  "tha-ap363:1.1": "paṭhamaṃ mandāraviyattherāpadānaṃ (361) tāvatiṃsā idhāgantvā ",
  "tha-ap363:1.2": "maṅgalo nāma māṇavo ",
  "tha-ap363:1.3": "mandāravaṃ gahetvāna ",
  "tha-ap363:1.4": "vipassissa mahesino. ",
  "tha-ap363:2.1": "samādhinā nisinnassa ",
  "tha-ap363:2.2": "matthake dhārayiṃ ahaṃ ",
  "tha-ap363:2.3": "sattāhaṃ dhārayitvāna ",
  "tha-ap363:2.4": "devalokaṃ punāgamiṃ. ",
  "tha-ap363:3.1": "ekanavute ito kappe ",
  "tha-ap363:3.2": "yaṃ buddhaṃ abhipūjayiṃ ",
  "tha-ap363:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap363:3.4": "buddhapūjāyidaṃ phalaṃ. ",
  "tha-ap363:4.1": "paṭisambhidā catasso ",
  "tha-ap363:4.2": "vimokkhāpica aṭṭhime ",
  "tha-ap363:4.3": "chaḷabhiññā sacchikatā ",
  "tha-ap363:4.4": "kataṃ buddhassa sāsananti. ",
  "tha-ap363:5.1": "itthaṃ sudaṃ āyasmā mandāraviyo thero imā gāthāyo abhāsitthāti. ",
  "tha-ap363:6.1": "mandāraviyattherassa apadānaṃ samattaṃ. dutiyaṃ kakkārupupphiyattherāpadānaṃ (362) "
}
