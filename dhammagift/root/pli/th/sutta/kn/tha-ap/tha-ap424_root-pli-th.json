{
  "tha-ap424:0.1": "",
  "tha-ap424:0.2": "",
  "tha-ap424:0.3": "",
  "tha-ap424:1.1": "nagare haṃsavatiyā ",
  "tha-ap424:1.2": "ahosiṃ tiṇahārako ",
  "tha-ap424:1.3": "tiṇahārena jīvāmi ",
  "tha-ap424:1.4": "tena posemi dārake. ",
  "tha-ap424:2.1": "padumuttaro nāma jino ",
  "tha-ap424:2.2": "sabbadhammāna pāragū ",
  "tha-ap424:2.3": "tamandhakāraṃ nāsetvā ",
  "tha-ap424:2.4": "uppajji lokanāyako. ",
  "tha-ap424:3.1": "sake ghare nisīditvā ",
  "tha-ap424:3.2": "evaṃ cintesi tāvade ",
  "tha-ap424:3.3": "buddho loke samuppanno ",
  "tha-ap424:3.4": "deyyadhammo na vijjati. ",
  "tha-ap424:4.1": "idaṃ me sāṭakaṃ ekaṃ ",
  "tha-ap424:4.2": "natthi me koci dāyako ",
  "tha-ap424:4.3": "dukkho nirayasamphasso ",
  "tha-ap424:4.4": "ropayissāmi dakkhiṇaṃ. ",
  "tha-ap424:5.1": "evāhaṃ cintayitvāna ",
  "tha-ap424:5.2": "sakaṃ cittaṃ pasādayiṃ ",
  "tha-ap424:5.3": "ekaṃ dussaṃ gahetvāna ",
  "tha-ap424:5.4": "buddhaseṭṭhassadāsahaṃ. ",
  "tha-ap424:6.1": "ekaṃ dussaṃ daditvāna ",
  "tha-ap424:6.2": "ukkuṭṭhiṃ sampavattayiṃ ",
  "tha-ap424:6.3": "yadi buddho tuvaṃ vīra ",
  "tha-ap424:6.4": "tārehi maṃ mahāmuni. ",
  "tha-ap424:7.1": "padumuttaro lokavidū ",
  "tha-ap424:7.2": "āhutīnaṃ paṭiggaho ",
  "tha-ap424:7.3": "mamaṃ dānaṃ pakittento ",
  "tha-ap424:7.4": "akā me anumodanaṃ. ",
  "tha-ap424:8.1": "iminā ekadussena ",
  "tha-ap424:8.2": "cetanāpaṇidhīhi ca ",
  "tha-ap424:8.3": "kappasatasahassāni ",
  "tha-ap424:8.4": "vinipātaṃ na gacchati. ",
  "tha-ap424:9.1": "chattiṃsakkhattuṃ devindo ",
  "tha-ap424:9.2": "devarajjaṃ karissati ",
  "tha-ap424:9.3": "tettiṃsakkhattuṃ rājā ca ",
  "tha-ap424:9.4": "cakkavatti bhavissati. ",
  "tha-ap424:10.1": "padesarajjaṃ vipulaṃ ",
  "tha-ap424:10.2": "gaṇanāto asaṅkhayaṃ ",
  "tha-ap424:10.3": "devaloke manusase vā ",
  "tha-ap424:10.4": "saṃsaranto tuvaṃ bhave. ",
  "tha-ap424:11.1": "rūpavā guṇasampanno ",
  "tha-ap424:11.2": "anuvattantadehavā ",
  "tha-ap424:11.3": "akkhobhaṃ amitaṃ dussaṃ ",
  "tha-ap424:11.4": "labhissati yathicchakaṃ. ",
  "tha-ap424:12.1": "idaṃ vatvāna sambuddho ",
  "tha-ap424:12.2": "jalajuttamanāmako ",
  "tha-ap424:12.3": "nabhaṃ abbhuggami dhīro ",
  "tha-ap424:12.4": "haṃsarājāva ambare. ",
  "tha-ap424:13.1": "yaṃ yaṃ yonūpapajjāmi ",
  "tha-ap424:13.2": "devattaṃ atha mānusaṃ ",
  "tha-ap424:13.3": "bhoge me ūnatā natthi ",
  "tha-ap424:13.4": "ekadussassidaṃ phalaṃ. ",
  "tha-ap424:14.1": "paduddhāre paduddhāre ",
  "tha-ap424:14.2": "dussaṃ nibbattate mama ",
  "tha-ap424:14.3": "heṭṭhā dussamhi tiṭṭhāmi ",
  "tha-ap424:14.4": "uparicchadanaṃ mama. ",
  "tha-ap424:15.1": "cakkavāḷaṃ upādāya ",
  "tha-ap424:15.2": "sakānanaṃ sapabbataṃ ",
  "tha-ap424:15.3": "icchamāno ahaṃ ajja ",
  "tha-ap424:15.4": "dussenacchādayeyya taṃ. ",
  "tha-ap424:16.1": "teneva ekadussena ",
  "tha-ap424:16.2": "saṃsaranto bhavābhave ",
  "tha-ap424:16.3": "suvaṇṇavaṇṇo hutvāna ",
  "tha-ap424:16.4": "saṃsarāmi bhavābhave. ",
  "tha-ap424:17.1": "vipākaṃ ekadussassa ",
  "tha-ap424:17.2": "ajjhagaṃ tattha ",
  "tha-ap424:17.3": "bhikkhutaṃ ayaṃpi pacchimā jāti ",
  "tha-ap424:17.4": "vipaccati idhāpi me. ",
  "tha-ap424:18.1": "satasahasse ito kappe ",
  "tha-ap424:18.2": "yaṃ dussamadadiṃ tadā ",
  "tha-ap424:18.3": "duggatiṃ nābhijānāmi ",
  "tha-ap424:18.4": "ekadussassidaṃ phalaṃ. ",
  "tha-ap424:19.1": "kilesā jhāpitā mayhaṃ ",
  "tha-ap424:19.2": "bhavā sabbe samūhatā nāgova bandhanaṃ chetvā ",
  "tha-ap424:19.3": "viharāmi anāsavo. ",
  "tha-ap424:20.1": "svāgataṃ vata me āsi ",
  "tha-ap424:20.2": "mama buddhassa santike tisso vijjā anuppattā ",
  "tha-ap424:20.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap424:21.1": "paṭisambhidā catasso ",
  "tha-ap424:21.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap424:21.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap424:22.1": "itthaṃ sudaṃ āyasmā ekadussadāyako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap424:23.1": "ekadussadāyakattherassa apadānaṃ samattaṃ. tatiyaṃ ekāsanadāyakattherāpadānaṃ (423) "
}
