{
  "tha-ap380:0.1": "",
  "tha-ap380:0.2": "",
  "tha-ap380:0.3": "",
  "tha-ap380:1.1": "siddhatthassa bhagavato ",
  "tha-ap380:1.2": "tālavaṇṭaṃ adāsahaṃ ",
  "tha-ap380:1.3": "sumanehi paṭicchannaṃ ",
  "tha-ap380:1.4": "dhārayāmi mahāyasaṃ. catunavute ",
  "tha-ap380:2.1": "ito kappe ",
  "tha-ap380:2.2": "tālavaṇṭaṃ adāsahaṃ ",
  "tha-ap380:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap380:2.4": "tālavaṇṭassidaṃ phalaṃ. ",
  "tha-ap380:3.1": "svāgataṃ vata me āsi mama buddhassa santike tisso vijjā anuppattā kataṃ buddhassa sāsanaṃ. kilesā jhāpitā mayhaṃ ",
  "tha-ap380:3.2": "bhavā sabbe samūhatā nāgova bandhanaṃ chetvā ",
  "tha-ap380:3.3": "viharāmi anāsavo. ",
  "tha-ap380:4.1": "",
  "tha-ap380:4.2": "",
  "tha-ap380:4.3": "",
  "tha-ap380:5.1": "paṭisambhidā catasso ",
  "tha-ap380:5.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap380:5.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap380:6.1": "itthaṃ sudaṃ āyasmā sumanatālavaṇṭiyo thero imā gāthāyo abhāsitthāti. ",
  "tha-ap380:7.1": "sumanatālavaṇṭiyattherassa apadānaṃ samattaṃ. navamaṃ sumanadāmiyattherāpadānaṃ (379)( "
}
