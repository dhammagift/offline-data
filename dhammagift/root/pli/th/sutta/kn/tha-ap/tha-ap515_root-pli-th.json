{
  "tha-ap515:0.1": "",
  "tha-ap515:0.2": "",
  "tha-ap515:0.3": "",
  "tha-ap515:1.1": "kakudhaṃ vilasantaṃva ",
  "tha-ap515:1.2": "devadevaṃ narāsabhaṃ ",
  "tha-ap515:1.3": "rathiyaṃ paṭipajjantaṃ ",
  "tha-ap515:1.4": "kosumbamadadintadā. ",
  "tha-ap515:2.1": "ekatiṃse ito kappe ",
  "tha-ap515:2.2": "yaṃ phalaṃ adadiṃ tadā ",
  "tha-ap515:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap515:2.4": "phaladānassidaṃ phalaṃ. ",
  "tha-ap515:3.1": "kilesā jhāpitā mayhaṃ ",
  "tha-ap515:3.2": "bhavā sabbe samūhatā nāgova bandhanaṃ chetvā ",
  "tha-ap515:3.3": "viharāmi anāsavo. ",
  "tha-ap515:4.1": "svāgataṃ vata me āsi ",
  "tha-ap515:4.2": "mama buddhassa santike tisso vijjā anuppattā ",
  "tha-ap515:4.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap515:5.1": "paṭisambhidā catasso ",
  "tha-ap515:5.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap515:5.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap515:6.1": "itthaṃ sudaṃ āyasmā kosumbaphaliyo thero imā gāthāyo abhāsitthāti. ",
  "tha-ap515:7.1": "kosumbaphaliyattherassa apadānaṃ samattaṃ. catutthaṃ ketakapupphiyattherāpadānaṃ (514) "
}
