{
  "tha-ap511:0.1": "",
  "tha-ap511:0.2": "",
  "tha-ap511:0.3": "",
  "tha-ap511:1.1": "sataraṃsī nāma bhagavā ",
  "tha-ap511:1.2": "sayambhū aparājito ",
  "tha-ap511:1.3": "vivekā vuṭṭhahitvāna ",
  "tha-ap511:1.4": "gocarāyābhinikkhami. ",
  "tha-ap511:2.1": "phalahattho ahaṃ disvā ",
  "tha-ap511:2.2": "upagañchiṃ narāsabhaṃ ",
  "tha-ap511:2.3": "pasannacitto sumano ",
  "tha-ap511:2.4": "tālaphalamadāsahaṃ. catunavute ",
  "tha-ap511:3.1": "ito kappe ",
  "tha-ap511:3.2": "yaṃ phalaṃ adadiṃ tadā ",
  "tha-ap511:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap511:3.4": "phaladānassidaṃ phalaṃ. ",
  "tha-ap511:4.1": "kilesā jhāpitā mayhaṃ ",
  "tha-ap511:4.2": "bhavā sabbe samūhatā nāgova bandhanaṃ chetvā ",
  "tha-ap511:4.3": "viharāmi anāsavo. ",
  "tha-ap511:5.1": "svāgataṃ vata me āsi ",
  "tha-ap511:5.2": "mama buddhassa santike tisso vijjā anuppattā ",
  "tha-ap511:5.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap511:6.1": "paṭisambhidā catasso ",
  "tha-ap511:6.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap511:6.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap511:7.1": "itthaṃ sudaṃ āyasmā tālaphaliyo thero imā gāthāyo abhāsitthāti. ",
  "tha-ap511:8.1": "tālaphaliyattherassa apadānaṃ samattaṃ. dasamaṃ nālikeraphaladāyakattherāpadānaṃ (510) "
}
