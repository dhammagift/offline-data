{
  "tha-ap372:0.1": "",
  "tha-ap372:0.2": "",
  "tha-ap372:0.3": "",
  "tha-ap372:1.1": "candabhāgānadītīre ",
  "tha-ap372:1.2": "ahosiṃ kinnaro tadā ",
  "tha-ap372:1.3": "athaddasaṃ devadevaṃ ",
  "tha-ap372:1.4": "caṅkamantaṃ narāsabhaṃ. ",
  "tha-ap372:2.1": "ocinitvāna salaḷaṃ ",
  "tha-ap372:2.2": "buddhaseṭṭhassadāsahaṃ ",
  "tha-ap372:2.3": "upasiṅghi mahāvīro ",
  "tha-ap372:2.4": "salaḷaṃ devagandhikaṃ. ",
  "tha-ap372:3.1": "paṭiggahetvā sambuddho ",
  "tha-ap372:3.2": "vipassī lokanāyako ",
  "tha-ap372:3.3": "upasiṅghi mahāvīro ",
  "tha-ap372:3.4": "pekkhamānassa me tadā. ",
  "tha-ap372:4.1": "pasannacitto sumano ",
  "tha-ap372:4.2": "vanditvā dipaduttamaṃ ",
  "tha-ap372:4.3": "añjaliṃ paggahetvāna ",
  "tha-ap372:4.4": "puna pabbatamāruhiṃ. ",
  "tha-ap372:5.1": "ekanavute ito kappe ",
  "tha-ap372:5.2": "yaṃ pupphamabhipūjayiṃ ",
  "tha-ap372:5.3": "duggatiṃ nābhijānāmi ",
  "tha-ap372:5.4": "buddhapūjāyidaṃ phalaṃ. ",
  "tha-ap372:6.1": "paṭisambhidā catasso ",
  "tha-ap372:6.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap372:6.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap372:7.1": "itthaṃ sudaṃ āyasmā salaḷapupphiyo thero imā gāthāyo abhāsitthāti. ",
  "tha-ap372:8.1": "salaḷapupphiyattherassa apadānaṃ ",
  "tha-ap372:9.1": "samattaṃ. uddānaṃ ",
  "tha-ap372:10.1": "",
  "tha-ap372:11.1": "mandāravañca kakkāru ",
  "tha-ap372:11.2": "bhisakesarapupphiyo ",
  "tha-ap372:11.3": "aṅkolako kadambī ca ",
  "tha-ap372:11.4": "uddālaṃ ekacampako ",
  "tha-ap372:11.5": "timiraṃ salaḷañceva ",
  "tha-ap372:11.6": "gāthā tāḷīsameva ca. mandāravapupphiyavaggo sattattiṃso. "
}
