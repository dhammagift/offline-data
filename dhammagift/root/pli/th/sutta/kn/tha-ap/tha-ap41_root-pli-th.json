{
  "tha-ap41:0.1": "",
  "tha-ap41:0.2": "",
  "tha-ap41:0.3": "",
  "tha-ap41:1.1": "siddhatthassa bhagavato ",
  "tha-ap41:1.2": "sīhāsanassa sammukhā ",
  "tha-ap41:1.3": "dhammacakkaṃ mayā ṭhapitaṃ ",
  "tha-ap41:1.4": "sukataṃ viññuvaṇṇitaṃ. ",
  "tha-ap41:2.1": "catuvaṇṇāya sobhāmi ",
  "tha-ap41:2.2": "sayoggabalavāhano ",
  "tha-ap41:2.3": "parivārenti maṃ niccaṃ ",
  "tha-ap41:2.4": "anuyantā bahū janā. ",
  "tha-ap41:3.1": "saṭṭhīturiyasahassehi ",
  "tha-ap41:3.2": "parivāremahaṃ sadā ",
  "tha-ap41:3.3": "parivārena sobhāmi ",
  "tha-ap41:3.4": "puññakammassidaṃ phalaṃ. ",
  "tha-ap41:4.1": "catunavute ito kappe ",
  "tha-ap41:4.2": "yaṃ cakkaṃ ṭhapayiṃ ahaṃ ",
  "tha-ap41:4.3": "duggatiṃ nābhijānāmi ",
  "tha-ap41:4.4": "dhammacakkassidaṃ phalaṃ. ",
  "tha-ap41:5.1": "ito ekādase kappe ",
  "tha-ap41:5.2": "aṭṭhāsiṃsu janādhipā ",
  "tha-ap41:5.3": "sahassarājā nāmena ",
  "tha-ap41:5.4": "cakkavattī mahabbalā. ",
  "tha-ap41:6.1": "paṭisambhidā catasso ",
  "tha-ap41:6.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap41:6.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap41:7.1": "itthaṃ sudaṃ āyasmā dhammacakkiko thero imā gāthāyo abhāsitthāti. ",
  "tha-ap41:8.1": "dhammacakkikattherassa apadānaṃ samattaṃ. dasamaṃ kapparukkhiyattherāpadānaṃ (40) "
}
