  "tha-ap349:0.1": "",
  "tha-ap349:0.2": "",
  "tha-ap349:0.3": "",
  "tha-ap349:1.1": "himavantassavidūre ",
  "tha-ap349:1.2": "romaso nāma pabbato ",
  "tha-ap349:1.3": "buddho ca sobhito nāma ",
  "tha-ap349:1.4": "abbhokāse vasī tadā. ",
  "tha-ap349:2.1": "bhavanā nikkhamitvāna ",
  "tha-ap349:2.2": "padumaṃ dhārayiṃ ahaṃ ",
  "tha-ap349:2.3": "ekāhaṃ dhārayitvāna ",
  "tha-ap349:2.4": "punabbhavaṃ upāgamiṃ. ekanavute ",
  "tha-ap349:3.1": "ito kappe ",
  "tha-ap349:3.2": "yaṃ pupphaṃ abhipūjayiṃ ",
  "tha-ap349:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap349:3.4": "buddhapūjāyidaṃ phalaṃ. ",
  "tha-ap349:4.1": "paṭisambhidā catasso ",
  "tha-ap349:4.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap349:4.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap349:5.1": "itthaṃ sudaṃ āyasmā padumapūjako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap349:6.1": "padumapūjakattherassa apadānaṃ samattaṃ. ",
  "tha-ap349:6.2": "terasamaṃ bhāṇavāraṃ. aṭṭhamaṃ tiṇamuṭṭhidāyakattherāpadānaṃ (348) "
}
