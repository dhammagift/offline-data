{
  "tha-ap63:0.1": "sattamo sakacittaniyavaggo ",
  "tha-ap63:0.2": "",
  "tha-ap63:0.3": "",
  "tha-ap63:1.1": "paṭhamaṃ sakacittaniyattherāpadānaṃ (61) pavanaṃ kānanaṃ disvā ",
  "tha-ap63:1.2": "appasaddaṃ anāvilaṃ ",
  "tha-ap63:1.3": "isīnaṃ anuciṇṇaṃva ",
  "tha-ap63:1.4": "āhutīnaṃ paṭiggahaṃ. ",
  "tha-ap63:2.1": "thūpaṃ katvāna veḷinaṃ ",
  "tha-ap63:2.2": "nānāpupphaṃ samokiriṃ ",
  "tha-ap63:2.3": "sammukhā viya sambuddhaṃ ",
  "tha-ap63:2.4": "nimmitaṃ abhivandahaṃ. ",
  "tha-ap63:3.1": "sattaratanasampanno ",
  "tha-ap63:3.2": "rājā raṭṭhasmi issaro ",
  "tha-ap63:3.3": "sakakammābhiraddhohaṃ ",
  "tha-ap63:3.4": "pupphapūjāyidaṃ phalaṃ. ",
  "tha-ap63:4.1": "ekanavute ito kappe ",
  "tha-ap63:4.2": "yaṃ pupphamabhiropayiṃ ",
  "tha-ap63:4.3": "duggatiṃ nābhijānāmi ",
  "tha-ap63:4.4": "buddhapūjāyidaṃ phalaṃ. ",
  "tha-ap63:5.1": "asītikappenantayaso ",
  "tha-ap63:5.2": "cakkavatti ahosahaṃ ",
  "tha-ap63:5.3": "sattaratanasampanno ",
  "tha-ap63:5.4": "catudīpamhi issaro. ",
  "tha-ap63:6.1": "paṭisambhidā catasso ",
  "tha-ap63:6.2": "vimokkhāpica aṭṭhime ",
  "tha-ap63:6.3": "chaḷabhiññā sacchikatā ",
  "tha-ap63:6.4": "kataṃ buddhassa sāsananti. ",
  "tha-ap63:7.1": "itthaṃ sudaṃ āyasmā sakacittaniyo e tharo imā gāthāyo abhāsitthāti. ",
  "tha-ap63:8.1": "sakacittaniyattherassa apadānaṃ samattaṃ. dutiyaṃ āpopupphiyattherāpadānaṃ (62) "
}
