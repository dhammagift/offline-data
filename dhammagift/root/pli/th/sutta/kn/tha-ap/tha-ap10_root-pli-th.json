{
  "tha-ap10:0.1": "",
  "tha-ap10:0.2": "",
  "tha-ap10:0.3": "",
  "tha-ap10:1.1": "padumuttaro nāma jino ",
  "tha-ap10:1.2": "sayambhū aggapuggalo ",
  "tha-ap10:1.3": "purato himavantassa ",
  "tha-ap10:1.4": "cittakūṭe vasī tadā. ",
  "tha-ap10:2.1": "abhītarūpo tatthāsiṃ ",
  "tha-ap10:2.2": "migarājā catukkamo ",
  "tha-ap10:2.3": "yassa saddaṃ suṇitvāna ",
  "tha-ap10:2.4": "vikkhambhanti bahū janā. ",
  "tha-ap10:3.1": "suphullaṃ padumaṃ gayha ",
  "tha-ap10:3.2": "upagañchiṃ narāsabhaṃ ",
  "tha-ap10:3.3": "vuṭṭhitassa samādhimhā ",
  "tha-ap10:3.4": "buddhassa abhiropayiṃ. ",
  "tha-ap10:4.1": "cātuddisaṃ namassitvā ",
  "tha-ap10:4.2": "buddhaseṭṭhaṃ naruttamaṃ ",
  "tha-ap10:4.3": "sakaṃ cittaṃ pasādetvā ",
  "tha-ap10:4.4": "sīhanādaṃ nadiṃ tadā. ",
  "tha-ap10:5.1": "padumuttaro lokavidū ",
  "tha-ap10:5.2": "āhutīnaṃ paṭiggaho ",
  "tha-ap10:5.3": "sakāsane nisīditvā ",
  "tha-ap10:5.4": "imā gāthā abhāsatha. ",
  "tha-ap10:6.1": "buddhassa giramaññāya ",
  "tha-ap10:6.2": "sabbe devā samāgatā ",
  "tha-ap10:6.3": "āgato vadataṃ seṭṭho ",
  "tha-ap10:6.4": "dhammaṃ sossāma taṃ mayaṃ. ",
  "tha-ap10:7.1": "tesaṃ hāsaparetānaṃ ",
  "tha-ap10:7.2": "purato lokanāyako ",
  "tha-ap10:7.3": "mama saddaṃ pakittesi ",
  "tha-ap10:7.4": "dīghadassī mahāmuni. ",
  "tha-ap10:8.1": "yenidaṃ padumaṃ dinnaṃ ",
  "tha-ap10:8.2": "sīhanādo ca nādito ",
  "tha-ap10:8.3": "tamahaṃ kittayissāmi ",
  "tha-ap10:8.4": "suṇātha mama bhāsato. ",
  "tha-ap10:9.1": "ito aṭṭhamake kappe ",
  "tha-ap10:9.2": "cakkavatti bhavissati ",
  "tha-ap10:9.3": "sattaratanasampanno ",
  "tha-ap10:9.4": "catudīpamhi issaro. ",
  "tha-ap10:10.1": "kārayissati issaraṃ ",
  "tha-ap10:10.2": "mahiyā catusaṭṭhiyā ",
  "tha-ap10:10.3": "padumo nāma nāmena ",
  "tha-ap10:10.4": "cakkavatti mahābalo. ",
  "tha-ap10:11.1": "kappasatasahassamhi ",
  "tha-ap10:11.2": "okkākakulasambhavo ",
  "tha-ap10:11.3": "gotamo nāma gottena ",
  "tha-ap10:11.4": "satthā loke bhavissati. ",
  "tha-ap10:12.1": "pakāsite pāvacane ",
  "tha-ap10:12.2": "brahmabandhu bhavissati ",
  "tha-ap10:12.3": "brahmaññā abhinikkhamma ",
  "tha-ap10:12.4": "pabbajissati tāvade. ",
  "tha-ap10:13.1": "padhānaṃ pahitatto so ",
  "tha-ap10:13.2": "upasanto nirūpadhi ",
  "tha-ap10:13.3": "sabbāsave pariññāya ",
  "tha-ap10:13.4": "nibbāyissatināsavo. ",
  "tha-ap10:14.1": "vijjane pantaseyyamhi ",
  "tha-ap10:14.2": "vāḷamigasamākule ",
  "tha-ap10:14.3": "sabbāsave pariññāya ",
  "tha-ap10:14.4": "nibbāyissatināsavo. ",
  "tha-ap10:15.1": "paṭisambhidā catasso ",
  "tha-ap10:15.2": "vimokkhāpica aṭṭhime ",
  "tha-ap10:15.3": "chaḷabhiññā sacchikatā ",
  "tha-ap10:15.4": "kataṃ buddhassa sāsananti. ",
  "tha-ap10:16.1": "itthaṃ sudaṃ āyasmā piṇḍolabhāradvājo thero imā gāthāyo abhāsitthāti. ",
  "tha-ap10:17.1": "piṇḍolabhāradvājattherassa apadānaṃ samattaṃ. ekādasamaṃ khadiravaniyarevatattherāpadānaṃ (9) "
}
