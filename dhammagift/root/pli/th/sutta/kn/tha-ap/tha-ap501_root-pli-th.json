{
  "tha-ap501:0.1": "",
  "tha-ap501:0.2": "",
  "tha-ap501:0.3": "",
  "tha-ap501:1.1": "himavantassavidūre ",
  "tha-ap501:1.2": "hāriko nāma pabbato ",
  "tha-ap501:1.3": "sayambhū nārado nāma ",
  "tha-ap501:1.4": "rukkhamūle vasi tadā. ",
  "tha-ap501:2.1": "naḷāgāraṃ karitvāna ",
  "tha-ap501:2.2": "tiṇena chādayiṃ ahaṃ ",
  "tha-ap501:2.3": "caṅkamaṃ sodhayitvāna ",
  "tha-ap501:2.4": "sayambhussa adāsahaṃ. ",
  "tha-ap501:3.1": "tena kammena sukatena ",
  "tha-ap501:3.2": "cetanāpaṇidhīhi ca ",
  "tha-ap501:3.3": "jahitvā mānusaṃ dehaṃ ",
  "tha-ap501:3.4": "tāvatiṃsaṃ agacchahaṃ. ",
  "tha-ap501:4.1": "tattha me sukataṃ byamhaṃ ",
  "tha-ap501:4.2": "naḷakuṭikāya nimmitaṃ ",
  "tha-ap501:4.3": "saṭṭhiyojanamubbiddhaṃ ",
  "tha-ap501:4.4": "tiṃsayojanavitthataṃ. ",
  "tha-ap501:5.1": "catuddasesu kappesu ",
  "tha-ap501:5.2": "devaloke ramiṃ ahaṃ ",
  "tha-ap501:5.3": "ekasattatikkhattuñca ",
  "tha-ap501:5.4": "devarajjaṃ akārayiṃ. ",
  "tha-ap501:6.1": "catuttiṃsatikkhattuñca ",
  "tha-ap501:6.2": "cakkavatti ahosahaṃ ",
  "tha-ap501:6.3": "padesarajjaṃ vipulaṃ ",
  "tha-ap501:6.4": "gaṇanāto asaṅkhayaṃ. ",
  "tha-ap501:7.1": "dhammapāsādamāruyha ",
  "tha-ap501:7.2": "suññāgāravarūpagaṃ ",
  "tha-ap501:7.3": "yathicchakāhaṃ vihare ",
  "tha-ap501:7.4": "sakyaputtassa sāsane. ",
  "tha-ap501:8.1": "ekatiṃse ito kappe ",
  "tha-ap501:8.2": "yaṃ kammamakariṃ tadā ",
  "tha-ap501:8.3": "duggatiṃ nābhijānāmi ",
  "tha-ap501:8.4": "naḷakuṭikāyidaṃ phalaṃ. ",
  "tha-ap501:9.1": "kilesā jhāpitā mayhaṃ ",
  "tha-ap501:9.2": "bhavā sabbe samūhatā nāgova bandhanaṃ chetvā ",
  "tha-ap501:9.3": "viharāmi anāsavo. ",
  "tha-ap501:10.1": "svāgataṃ vata me āsi ",
  "tha-ap501:10.2": "mama buddhassa santike tisso vijjā anuppattā ",
  "tha-ap501:10.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap501:11.1": "paṭisambhidā catasso ",
  "tha-ap501:11.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap501:11.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap501:12.1": "itthaṃ sudaṃ āyasmā naḷakuṭikadāyako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap501:13.1": "naḷakuṭikadāyakattherassa apadānaṃ samattaṃ. dasamaṃ piyālaphaladāyakattherāpadānaṃ (500) "
}
