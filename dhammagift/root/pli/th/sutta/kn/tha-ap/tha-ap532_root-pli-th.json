{
  "tha-ap532:0.1": "",
  "tha-ap532:0.2": "",
  "tha-ap532:0.3": "",
  "tha-ap532:1.1": "imamhi bhaddake kappe ",
  "tha-ap532:1.2": "brahmabandhu mahāyaso ",
  "tha-ap532:1.3": "kassapo nāma nāmena ",
  "tha-ap532:1.4": "uppajji vadataṃ varo. ",
  "tha-ap532:2.1": "anubyañjanasampanno ",
  "tha-ap532:2.2": "dvattiṃsavaralakkhaṇo ",
  "tha-ap532:2.3": "byāmappabhāparivuto ",
  "tha-ap532:2.4": "raṃsijālasamutthato. ",
  "tha-ap532:3.1": "assāsetā yathā cando ",
  "tha-ap532:3.2": "suriyo viya pabhaṅkaro ",
  "tha-ap532:3.3": "nibbāpetā yathā megho ",
  "tha-ap532:3.4": "sāgarova guṇākaro. ",
  "tha-ap532:4.1": "dharaṇīriva sīlena ",
  "tha-ap532:4.2": "himavāva samādhinā ",
  "tha-ap532:4.3": "ākāso viya paññāya ",
  "tha-ap532:4.4": "asaṅgo anilo yathā. ",
  "tha-ap532:5.1": "anūno yathāvihāro ",
  "tha-ap532:5.2": "parisāsu visārado ",
  "tha-ap532:5.3": "saccāni sampakāseti ",
  "tha-ap532:5.4": "uddharanto mahājanaṃ. ",
  "tha-ap532:6.1": "tadāhaṃ bārāṇasiyaṃ ",
  "tha-ap532:6.2": "seṭṭhiputto mahāyaso ",
  "tha-ap532:6.3": "āsabhaṃ dhanadhaññassa ",
  "tha-ap532:6.4": "pahutassa bahū mamaṃ. ",
  "tha-ap532:7.1": "jaṅghavihāraṃ vicaraṃ ",
  "tha-ap532:7.2": "migadāyaṃ upeccahaṃ ",
  "tha-ap532:7.3": "addasaṃ nāthasatthāraṃ ",
  "tha-ap532:7.4": "desentaṃ amataṃ padaṃ. ",
  "tha-ap532:8.1": "visaṭṭhakantavacanaṃ ",
  "tha-ap532:8.2": "karavikasamassaraṃ ",
  "tha-ap532:8.3": "haṃsadundubhinigghosaṃ ",
  "tha-ap532:8.4": "viññāpentaṃ mahājanaṃ. ",
  "tha-ap532:9.1": "disvā devātidevantaṃ sutvā ",
  "tha-ap532:9.2": "ca madhuraṃ saraṃ ",
  "tha-ap532:9.3": "pahāyānappake bhoge ",
  "tha-ap532:9.4": "pabbajiṃ anagāriyaṃ. ",
  "tha-ap532:10.1": "evaṃ pabbajitovāhaṃ ",
  "tha-ap532:10.2": "na cirena bahussuto ",
  "tha-ap532:10.3": "ahosiṃ dhammakathiko ",
  "tha-ap532:10.4": "vicittapaṭibhāṇavā. ",
  "tha-ap532:11.1": "mahāparisamajjhehaṃ ",
  "tha-ap532:11.2": "satthunova punappunaṃ ",
  "tha-ap532:11.3": "vaṇṇayiṃ hemavaṇṇassa ",
  "tha-ap532:11.4": "vaṇṇaṃ vaṇṇavisārado. ",
  "tha-ap532:12.1": "esa khīṇāsavo buddho ",
  "tha-ap532:12.2": "anīgho chinnasaṃsayo ",
  "tha-ap532:12.3": "sabbakammakkhayaṃ patto ",
  "tha-ap532:12.4": "vimutto upadhikkhaye ",
  "tha-ap532:13.1": "esa so bhagavā buddho ",
  "tha-ap532:13.2": "esa sīho anuttaro. ",
  "tha-ap532:13.3": "sadevakassa lokassa ",
  "tha-ap532:13.4": "brahmacakkaṃ pavattako ",
  "tha-ap532:14.1": "danto dametā santo ca ",
  "tha-ap532:14.2": "sametā nibbuto isi ",
  "tha-ap532:14.3": "nibbāpetā ca assattho ",
  "tha-ap532:14.4": "assāsetā mahājanaṃ. ",
  "tha-ap532:15.1": "vīro sūro ca vikkanto ",
  "tha-ap532:15.2": "pañño kāruṇiko vasī ",
  "tha-ap532:15.3": "vijitāvī vijito ca appagabbho ",
  "tha-ap532:15.4": "anālayo. ",
  "tha-ap532:16.1": "aneñjo acalo dhīro ",
  "tha-ap532:16.2": "amoho asamo muni ",
  "tha-ap532:16.3": "dhorayho usabho nāgo ",
  "tha-ap532:16.4": "sīho sakko garūsupi. ",
  "tha-ap532:17.1": "virāgo vimalo brahmā ",
  "tha-ap532:17.2": "vādīsūro raṇañjaho ",
  "tha-ap532:17.3": "akhilo ca visallo ca ",
  "tha-ap532:17.4": "asamo vusabho suci. ",
  "tha-ap532:18.1": "brāhmaṇo samaṇo nātho ",
  "tha-ap532:18.2": "bhisakko sallasandhuto ",
  "tha-ap532:18.3": "yodho buddho sutāsuto ",
  "tha-ap532:18.4": "acalo mudito sito. ",
  "tha-ap532:19.1": "katadantā vahattā ca ",
  "tha-ap532:19.2": "kattā netā pakāsitā ",
  "tha-ap532:19.3": "sampahaṃsitā settā ca ",
  "tha-ap532:19.4": "chettā sotā pasaṃsitā. ",
  "tha-ap532:20.1": "avilo ca visallo ca ",
  "tha-ap532:20.2": "anīgho akathaṃkathī ",
  "tha-ap532:20.3": "anejo virajo khattā ",
  "tha-ap532:20.4": "gandhā vattā pakāsitā. ",
  "tha-ap532:21.1": "tāretā atthakāretā ",
  "tha-ap532:21.2": "kāretā sampadāritā ",
  "tha-ap532:21.3": "pāpetā sahitā ",
  "tha-ap532:21.4": "hantā tāpitā ca ",
  "tha-ap532:22.1": "visositā. saccaṭṭhitosamasamo ",
  "tha-ap532:22.2": "asahāyo dayālayo ",
  "tha-ap532:22.3": "accheramanto akuho ",
  "tha-ap532:22.4": "katāvī isi sattamo. ",
  "tha-ap532:23.1": "nitiṇṇakaṅkho nimmāno ",
  "tha-ap532:23.2": "appameyyo anūpamo ",
  "tha-ap532:23.3": "sabbavākyapathātīto ",
  "tha-ap532:23.4": "sabbaneyyantito jino. ",
  "tha-ap532:24.1": "sataraṃsīvare tasmiṃ ",
  "tha-ap532:24.2": "pasādo amatāvaho ",
  "tha-ap532:24.3": "tasmā buddhe ca dhamme ca ",
  "tha-ap532:24.4": "saṅghe saddhā mahatthikā. ",
  "tha-ap532:25.1": "guṇehi evamādīhi ",
  "tha-ap532:25.2": "tilokasaraṇuttamaṃ ",
  "tha-ap532:25.3": "vaṇṇento parisamajjhe ",
  "tha-ap532:25.4": "kathiṃ dhammakathaṃ ahaṃ. ",
  "tha-ap532:26.1": "tato cutohaṃ tusite ",
  "tha-ap532:26.2": "anubhotvā mahāsukhaṃ ",
  "tha-ap532:26.3": "tato cuto manussesu ",
  "tha-ap532:26.4": "jāto homi sugandhiko. ",
  "tha-ap532:27.1": "nissāso mukhagandho ca ",
  "tha-ap532:27.2": "dehagandho tatheva me ",
  "tha-ap532:27.3": "so ca gandhova satataṃ ",
  "tha-ap532:27.4": "sabbagandhova hoti me. ",
  "tha-ap532:28.1": "mukhagandho sadā mayhaṃ ",
  "tha-ap532:28.2": "padumuppalacampako ",
  "tha-ap532:28.3": "atikanto sadā vāti ",
  "tha-ap532:28.4": "sarīro ca tatheva me. ",
  "tha-ap532:29.1": "guṇatthavassa sabbantaṃ ",
  "tha-ap532:29.2": "phalantaṃ paramabbhutaṃ ",
  "tha-ap532:29.3": "ekaggamanasā sabbe ",
  "tha-ap532:29.4": "bhāsitassa suṇātha me. ",
  "tha-ap532:30.1": "guṇaṃ buddhassa vatvāna ",
  "tha-ap532:30.2": "hitāyanaṃ sukhāvahaṃ sucitto ",
  "tha-ap532:30.3": "homi sabbattha ",
  "tha-ap532:30.4": "saṅgho vīrasamāsuto. ",
  "tha-ap532:31.1": "yasassī sukhito kanto ",
  "tha-ap532:31.2": "jutimā piyadassano ",
  "tha-ap532:31.3": "vattā aparibhūto ca ",
  "tha-ap532:31.4": "niddoso paññavā tathā. ",
  "tha-ap532:32.1": "khīṇe pāsusi nibbānaṃ ",
  "tha-ap532:32.2": "sulabhaṃ buddhabhattinaṃ ",
  "tha-ap532:32.3": "tesaṃ hetuṃ pavakkhāmi ",
  "tha-ap532:32.4": "taṃ suṇātha yathātathaṃ. ",
  "tha-ap532:33.1": "santaṃ yasaṃ bhagavato ",
  "tha-ap532:33.2": "vicinā abhivādayaṃ ",
  "tha-ap532:33.3": "yattha yatthupapannopi ",
  "tha-ap532:33.4": "yasassī tena homahaṃ. ",
  "tha-ap532:34.1": "dukkhassantakaraṃ buddhaṃ ",
  "tha-ap532:34.2": "dhammaṃ santaṃ asaṅkhataṃ ",
  "tha-ap532:34.3": "vaṇṇayaṃ sukhito āsiṃ ",
  "tha-ap532:34.4": "sattānaṃ sukhado tato. ",
  "tha-ap532:35.1": "guṇaṃ vadanto buddhassa ",
  "tha-ap532:35.2": "buddhapītisamāyuto ",
  "tha-ap532:35.3": "sakanti parakanti ca ",
  "tha-ap532:35.4": "āsiṃ tena ca kantimā. ",
  "tha-ap532:36.1": "jino yo titthikātiṇṇo ",
  "tha-ap532:36.2": "abhibhuyya kutitthiye ",
  "tha-ap532:36.3": "guṇaṃ vadanto thomesiṃ ",
  "tha-ap532:36.4": "nāyakaṃ jutimā tato. ",
  "tha-ap532:37.1": "piyaṅkāriṃ janassāpi ",
  "tha-ap532:37.2": "sambuddhassa guṇaṃ vadaṃ ",
  "tha-ap532:37.3": "saradīva sasaṅkohaṃ ",
  "tha-ap532:37.4": "tenāsiṃ piyadassano. ",
  "tha-ap532:38.1": "yathāsattivasenāhaṃ ",
  "tha-ap532:38.2": "sabbavācāhi santhaviṃ ",
  "tha-ap532:38.3": "sugataṃ tena vaṅgīso ",
  "tha-ap532:38.4": "vicittapaṭibhāṇavā. ",
  "tha-ap532:39.1": "ye bālā vimatiṃ pattā ",
  "tha-ap532:39.2": "paribhonti mahāmuni ",
  "tha-ap532:39.3": "niggahiṃ te sadhammena ",
  "tha-ap532:39.4": "paribhūtena tenahaṃ. ",
  "tha-ap532:40.1": "buddhavaṇṇehi sattānaṃ ",
  "tha-ap532:40.2": "kilese apanesahaṃ ",
  "tha-ap532:40.3": "nikkilesamano homi ",
  "tha-ap532:40.4": "tassa kammassa vāhasā. ",
  "tha-ap532:41.1": "sotūnaṃ buddhimajaniṃ ",
  "tha-ap532:41.2": "buddhānussatidesako ",
  "tha-ap532:41.3": "tenāpicāsiṃ sappañño ",
  "tha-ap532:41.4": "nipuṇatthavipassako. ",
  "tha-ap532:42.1": "sabbāsavaparikkhīṇo ",
  "tha-ap532:42.2": "tiṇṇasaṅsārasāgaro vasī ",
  "tha-ap532:42.3": "ca anupādāno ",
  "tha-ap532:42.4": "pāpuṇissāmi nibbutiṃ. ",
  "tha-ap532:43.1": "imasmiṃyeva kappasmiṃ ",
  "tha-ap532:43.2": "yamahaṃ santhaviṃ jinaṃ ",
  "tha-ap532:43.3": "duggatiṃ nābhijānāmi ",
  "tha-ap532:43.4": "buddhapūjāyidaṃ phalaṃ. ",
  "tha-ap532:44.1": "kilesā jhāpitā mayhaṃ ",
  "tha-ap532:44.2": "bhavā sabbe samūhatā nāgova bandhanaṃ chetvā ",
  "tha-ap532:44.3": "viharāmi anāsavo. ",
  "tha-ap532:45.1": "svāgataṃ vata me āsi ",
  "tha-ap532:45.2": "mama buddhassa santike tisso vijjā anuppattā ",
  "tha-ap532:45.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap532:46.1": "paṭisambhidā catasso ",
  "tha-ap532:46.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap532:46.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap532:47.1": "itthaṃ sudaṃ āyasmā sugandho thero imā gāthāyo abhāsitthāti. ",
  "tha-ap532:48.1": "sugandhattherassa apadānaṃ ",
  "tha-ap532:49.1": "samattaṃ. uddānaṃ ",
  "tha-ap532:50.1": "",
  "tha-ap532:51.1": "tiṇado veccado ceva ",
  "tha-ap532:51.2": "saraṇabbhañjanampado ",
  "tha-ap532:51.3": "supaṭo daṇḍadāyī ca ",
  "tha-ap532:51.4": "nelapūjī tatheva ca. ",
  "tha-ap532:52.1": "bodhisammajjakomaṇḍo ",
  "tha-ap532:52.2": "sugandho dasamo dijo ",
  "tha-ap532:52.3": "gāthāsataṃ satevīsaṃ ",
  "tha-ap532:52.4": "gaṇitaṃ cettha sabbaso. tiṇadāyakavaggo tepaññāso. "
}
