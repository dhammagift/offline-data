{
  "tha-ap146:0.1": "",
  "tha-ap146:0.2": "",
  "tha-ap146:0.3": "",
  "tha-ap146:1.1": "padumuttaro nāma jino ",
  "tha-ap146:1.2": "lokajeṭṭho narāsabho ",
  "tha-ap146:1.3": "jalitvā aggikkhandhova ",
  "tha-ap146:1.4": "sambuddho parinibbuto. ",
  "tha-ap146:2.1": "nibbute ca mahāvīre ",
  "tha-ap146:2.2": "thūpo vitthāriko ahu ",
  "tha-ap146:2.3": "thūpadattaṃ upaṭṭhenti ",
  "tha-ap146:2.4": "dhātugehe varuttame. ",
  "tha-ap146:3.1": "pasannacitto sumano ",
  "tha-ap146:3.2": "akaṃ candanavedikaṃ ",
  "tha-ap146:3.3": "dīyati dhūpagandho ca ",
  "tha-ap146:3.4": "thūpānucchavikaṃ tadā. ",
  "tha-ap146:4.1": "bhave nibbattamānamhi ",
  "tha-ap146:4.2": "devatte atha mānuse ",
  "tha-ap146:4.3": "omattaṃ me na passāmi ",
  "tha-ap146:4.4": "pubbakammassidaṃ phalaṃ. ",
  "tha-ap146:5.1": "pañcadase kappasate ",
  "tha-ap146:5.2": "ito aṭṭha janā ahuṃ ",
  "tha-ap146:5.3": "sabbe samattanāmā te ",
  "tha-ap146:5.4": "cakkavattī mahabbalā. ",
  "tha-ap146:6.1": "paṭisambhidā catasso ",
  "tha-ap146:6.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap146:6.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap146:7.1": "itthaṃ sudaṃ āyasmā saparivāriyo thero imā gāthāyo abhāsitthāti. ",
  "tha-ap146:8.1": "saparivāriyattherassa apadānaṃ samattaṃ. pañcamaṃ ummāpupphiyattherāpadānaṃ (145) "
}
