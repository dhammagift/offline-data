{
  "tha-ap462:0.1": "",
  "tha-ap462:0.2": "",
  "tha-ap462:0.3": "",
  "tha-ap462:1.1": "citakesu kurumānesu ",
  "tha-ap462:1.2": "nānāgandhe samāhaṭe ",
  "tha-ap462:1.3": "pasannacitto sumano ",
  "tha-ap462:1.4": "gandhamuṭṭhiṃ apūjayiṃ. satasahasse ",
  "tha-ap462:2.1": "ito kappe ",
  "tha-ap462:2.2": "citakaṃ yaṃ apūjayiṃ ",
  "tha-ap462:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap462:2.4": "citapūjāyidaṃ phalaṃ. ",
  "tha-ap462:3.1": "kilesā jhāpitā mayhaṃ ",
  "tha-ap462:3.2": "bhavā sabbe samūhatā nāgova bandhanaṃ chetvā ",
  "tha-ap462:3.3": "viharāmi anāsavo. ",
  "tha-ap462:4.1": "svāgataṃ vata me āsi ",
  "tha-ap462:4.2": "mama buddhassa santike tisso vijjā anuppattā ",
  "tha-ap462:4.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap462:5.1": "paṭisambhidā catasso ",
  "tha-ap462:5.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap462:5.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap462:6.1": "itthaṃ sudaṃ āyasmā gandhapūjako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap462:7.1": "gandhapūjakattherassa apadānaṃ ",
  "tha-ap462:8.1": "samattaṃ. uddānaṃ ",
  "tha-ap462:9.1": "",
  "tha-ap462:10.1": "jagatī morahattho ca ",
  "tha-ap462:10.2": "āsani ukkadhārako ",
  "tha-ap462:10.3": "akkami vanakoraṇḍi ",
  "tha-ap462:10.4": "chattado jātipūjako. ",
  "tha-ap462:11.1": "sattipaṇṇiyo thero ca ",
  "tha-ap462:11.2": "dasamo gandhapūjako ",
  "tha-ap462:11.3": "sattasaṭṭhī ca gāthāyo ",
  "tha-ap462:11.4": "gaṇitāyo vibhāvihi. jagatidāyakavaggo chacattāḷīso. "
}
