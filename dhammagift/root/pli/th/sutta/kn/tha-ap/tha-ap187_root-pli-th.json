{
  "tha-ap187:0.1": "",
  "tha-ap187:0.2": "",
  "tha-ap187:0.3": "",
  "tha-ap187:1.1": "udentaṃ sataraṃsīva ",
  "tha-ap187:1.2": "pītaraṃsīva bhāṇumaṃ ",
  "tha-ap187:1.3": "kakudhaṃ vilasantaṃva ",
  "tha-ap187:1.4": "padumuttaranāyakaṃ. ",
  "tha-ap187:2.1": "isimuggaṃ nimantetvā ",
  "tha-ap187:2.2": "madhukhudde anīlake ",
  "tha-ap187:2.3": "pāsādepi ṭhito santo ",
  "tha-ap187:2.4": "adāsiṃ lokabandhuno. ",
  "tha-ap187:3.1": "aṭṭhasatasahassāni ",
  "tha-ap187:3.2": "ahesuṃ buddhasāvakā ",
  "tha-ap187:3.3": "sabbesaṃ patta pūrentaṃ ",
  "tha-ap187:3.4": "tato vāpi bahūtaraṃ. ",
  "tha-ap187:4.1": "tena cittappasādena ",
  "tha-ap187:4.2": "sukkamūlena codito ",
  "tha-ap187:4.3": "kappānaṃ satasahassaṃ ",
  "tha-ap187:4.4": "duggatiṃ nūpapajjahaṃ. ",
  "tha-ap187:5.1": "cattāḷīsamhi sahasse ",
  "tha-ap187:5.2": "kappānaṃ aṭṭhatiṃsate mahisamantanāmā ",
  "tha-ap187:5.3": "te ",
  "tha-ap187:5.4": "cakkavattī mahabbalā. ",
  "tha-ap187:6.1": "paṭisambhidā catasso ",
  "tha-ap187:6.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap187:6.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap187:7.1": "itthaṃ sudaṃ āyasmā isimuggadāyako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap187:8.1": "isimuggadāyakattherassa apadānaṃ samattaṃ. chaṭṭhaṃ bodhiupaṭṭhāyakattherāpadānaṃ (186) "
}
