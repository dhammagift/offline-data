{
  "tha-ap522:0.1": "",
  "tha-ap522:0.2": "",
  "tha-ap522:0.3": "",
  "tha-ap522:1.1": "himavantassa avidūre ",
  "tha-ap522:1.2": "romaso nāma pabbato ",
  "tha-ap522:1.3": "buddhobhisambhavo nāma ",
  "tha-ap522:1.4": "abbhokāse vasi tadā. ",
  "tha-ap522:2.1": "bhavanā nikkhamitvāna ",
  "tha-ap522:2.2": "padumaṃ dhārayiṃ ahaṃ ",
  "tha-ap522:2.3": "ekāhaṃ dhārayitvāna ",
  "tha-ap522:2.4": "bhavanaṃ punarāgamiṃ. ",
  "tha-ap522:3.1": "ekatiṃse ito kappe ",
  "tha-ap522:3.2": "yaṃ buddhamabhipūjayiṃ ",
  "tha-ap522:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap522:3.4": "buddhapūjāyidaṃ phalaṃ. ",
  "tha-ap522:4.1": "kilesā jhāpitā mayhaṃ ",
  "tha-ap522:4.2": "bhavā sabbe samūhatā nāgova bandhanaṃ chetvā ",
  "tha-ap522:4.3": "viharāmi anāsavo. ",
  "tha-ap522:5.1": "svāgataṃ vata me āsi ",
  "tha-ap522:5.2": "mama buddhassa santike tisso vijjā anuppattā ",
  "tha-ap522:5.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap522:6.1": "paṭisambhidā catasso ",
  "tha-ap522:6.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap522:6.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap522:7.1": "itthaṃ sudaṃ āyasmā padumadhāriyo thero imā gāthāyo abhāsitthāti. ",
  "tha-ap522:8.1": "padumadhāriyattherassa apadānaṃ ",
  "tha-ap522:9.1": "samattaṃ. uddānaṃ ",
  "tha-ap522:10.1": "kurañjiyaṃ ",
  "tha-ap522:11.1": "kapiṭṭhañca ",
  "tha-ap522:11.2": "kosumbaṃ atha ketakaṃ ",
  "tha-ap522:11.3": "nāgapupphajjunañceva ",
  "tha-ap522:11.4": "kuṭaji ghosasaññako. ",
  "tha-ap522:12.1": "thero ca sabbaphalado ",
  "tha-ap522:12.2": "tathā padumadhāriyo ",
  "tha-ap522:12.3": "asīti cetthe gāthāyo ",
  "tha-ap522:12.4": "tisso gāthā taduttari. phaladāyakavaggo dvepaññāso. "
}
