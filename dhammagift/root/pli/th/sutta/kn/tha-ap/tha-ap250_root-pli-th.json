  "tha-ap250:0.3": "",
  "tha-ap250:1.1": "satta sattalipupphāni ",
  "tha-ap250:1.2": "sīse katvānahantadā ",
  "tha-ap250:1.3": "buddhassa abhiropesiṃ ",
  "tha-ap250:1.4": "vessabhumhi naruttame. ",
  "tha-ap250:2.1": "ekatiṃse ito kappe ",
  "tha-ap250:2.2": "yaṃ pupphamabhipūjayiṃ ",
  "tha-ap250:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap250:2.4": "pupphapūjāyidaṃ phalaṃ. ",
  "tha-ap250:3.1": "paṭisambhidā catasso ",
  "tha-ap250:3.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap250:3.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap250:4.1": "itthaṃ sudaṃ āyasmā sattasattalipupphapūjako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap250:5.1": "sattasattalipupphapūjakattherassa apadānaṃ samattaṃ. navamaṃ bimbijālapupphiyattherāpadānaṃ (249) "
}
