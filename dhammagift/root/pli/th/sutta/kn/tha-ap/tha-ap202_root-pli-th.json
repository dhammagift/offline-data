  "tha-ap202:0.1": "",
  "tha-ap202:0.2": "",
  "tha-ap202:0.3": "",
  "tha-ap202:1.1": "padumuttaro nāma jino ",
  "tha-ap202:1.2": "āhutīnaṃ paṭiggaho ",
  "tha-ap202:1.3": "pavanā nikkhamitvāna ",
  "tha-ap202:1.4": "vihāraṃ yāti cakkhumā. ",
  "tha-ap202:2.1": "ubhohatthehi paggayha ",
  "tha-ap202:2.2": "yūthikaṃ pupphamuttamaṃ ",
  "tha-ap202:2.3": "buddhassa abhiropesiṃ ",
  "tha-ap202:2.4": "mettacittassa tādino. ",
  "tha-ap202:3.1": "tena cittappasādena ",
  "tha-ap202:3.2": "anubhotvāna sampadā ",
  "tha-ap202:3.3": "kappānaṃ satasahassaṃ ",
  "tha-ap202:3.4": "duggatiṃ nūpapajjahaṃ. ",
  "tha-ap202:4.1": "ito paññāsakappesu ",
  "tha-ap202:4.2": "eko āsi janādhipo ",
  "tha-ap202:4.3": "samitanandano nāma ",
  "tha-ap202:4.4": "cakkavatti mahabbalo. ",
  "tha-ap202:5.1": "paṭisambhidā catasso ",
  "tha-ap202:5.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap202:5.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap202:6.1": "itthaṃ sudaṃ āyasmā yūthikapupphiyo thero imā gāthāyo abhāsitthāti. ",
  "tha-ap202:7.1": "yūthikapupphiyattherassa apadānaṃ ",
  "tha-ap202:7.2": "samattaṃ. uddānaṃ ",
  "tha-ap202:8.1": "tamāli ",
  "tha-ap202:9.1": "tiṇasanthāro ",
  "tha-ap202:9.2": "khaṇḍaphulli asokiyo ",
  "tha-ap202:9.3": "aṅkolako kisalayo ",
  "tha-ap202:9.4": "tinduko nelapupphiyo ",
  "tha-ap202:9.5": "tikaṇḍiko ca yūthiko ",
  "tha-ap202:9.6": "gāthā paññāsa aṭṭha ca. ",
  "tha-ap202:10.1": "tamālapupphiyavaggo vīsatimo. ",
  "tha-ap202:11.1": "atha vagguddānaṃ bhikkhadāyi parivāro ",
  "tha-ap202:11.2": "sereyyo sobhito tathā ",
  "tha-ap202:11.3": "chatto ca bandhujīvi ca ",
  "tha-ap202:11.4": "supāricariyopica ",
  "tha-ap202:12.1": "kumudo kuṭajo ceva ",
  "tha-ap202:12.2": "tamāli dasamo kato ",
  "tha-ap202:12.3": "cha satāni ca gāthānaṃ ",
  "tha-ap202:12.4": "chasaṭṭhi ca tatuttari. ",
  "tha-ap202:13.1": "bhikkhavaggadasakaṃ ",
  "tha-ap202:14.1": "dutiyasatakaṃ samattaṃ. "
}
