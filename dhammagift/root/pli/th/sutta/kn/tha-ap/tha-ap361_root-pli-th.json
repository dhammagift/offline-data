{
  "tha-ap361:0.1": "",
  "tha-ap361:0.2": "",
  "tha-ap361:0.3": "",
  "tha-ap361:1.1": "āruhimhā tadā nāvaṃ ",
  "tha-ap361:1.2": "bhikkhu cājīvako cahaṃ ",
  "tha-ap361:1.3": "nāvāya bhijjamānāya ",
  "tha-ap361:1.4": "bhikkhu me saraṇaṃ adā. ",
  "tha-ap361:2.1": "ekatiṃse ito kappe ",
  "tha-ap361:2.2": "yañca me saraṇaṃ adā ",
  "tha-ap361:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap361:2.4": "saraṇāgamane phalaṃ. ",
  "tha-ap361:3.1": "paṭisambhidā catasso ",
  "tha-ap361:3.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap361:3.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap361:4.1": "itthaṃ sudaṃ āyasmā saraṇāgamaniyo thero imā gāthāyo abhāsitthāti. ",
  "tha-ap361:5.1": "saraṇāgamaniyattherassa apadānaṃ samattaṃ. dasamaṃ piṇḍapātikattherāpadānaṃ (360) "
}
