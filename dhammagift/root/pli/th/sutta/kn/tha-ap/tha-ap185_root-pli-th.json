{
  "tha-ap185:0.1": "",
  "tha-ap185:0.2": "",
  "tha-ap185:0.3": "",
  "tha-ap185:1.1": "kaṇikāraṃva jotantaṃ ",
  "tha-ap185:1.2": "nisinnaṃ pabbatantare ",
  "tha-ap185:1.3": "appameyyaṃva udadhiṃ ",
  "tha-ap185:1.4": "uddhataṃ dharaṇiṃ yathā. ",
  "tha-ap185:2.1": "puretaṃ devasaṅghena ",
  "tha-ap185:2.2": "nisabhājāniyaṃ yathā ",
  "tha-ap185:2.3": "haṭṭho haṭṭhena cittena ",
  "tha-ap185:2.4": "upagañchiṃ naruttamaṃ. ",
  "tha-ap185:3.1": "satta pupphāni paggayha ",
  "tha-ap185:3.2": "kotumbaraṃ samākulaṃ ",
  "tha-ap185:3.3": "buddhassa abhiropesiṃ ",
  "tha-ap185:3.4": "sikhino lokabandhuno. ",
  "tha-ap185:4.1": "ekatiṃse ito kappe ",
  "tha-ap185:4.2": "yaṃ pupphamabhiropayiṃ ",
  "tha-ap185:4.3": "duggatiṃ nābhijānāmi ",
  "tha-ap185:4.4": "buddhapūjāyidaṃ phalaṃ. ",
  "tha-ap185:5.1": "ito vīsatikappamhi ",
  "tha-ap185:5.2": "mahānelasanāmako ",
  "tha-ap185:5.3": "eko āsiṃ mahātejo ",
  "tha-ap185:5.4": "cakkavatti mahabbalo. ",
  "tha-ap185:6.1": "paṭisambhidā catasso ",
  "tha-ap185:6.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap185:6.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap185:7.1": "itthaṃ sudaṃ āyasmā kotumbariyo thero imā gāthāyo abhāsitthāti. ",
  "tha-ap185:8.1": "kotumbariyattherassa apadānaṃ samattaṃ. catutthaṃ pañcahatthiyattherāpadānaṃ (184) "
}
