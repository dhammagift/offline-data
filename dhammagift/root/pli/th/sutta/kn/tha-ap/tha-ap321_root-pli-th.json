  "tha-ap321:0.1": "",
  "tha-ap321:0.2": "",
  "tha-ap321:0.3": "",
  "tha-ap321:1.1": "sindhuyā nadiyā tīre ",
  "tha-ap321:1.2": "ahosiṃ kassako tadā ",
  "tha-ap321:1.3": "parakammāyane yutto ",
  "tha-ap321:1.4": "parabhattaṃ apassito. ",
  "tha-ap321:2.1": "sindhadha anucarantohaṃ ",
  "tha-ap321:2.2": "siddhatthaṃ jinamaddasaṃ ",
  "tha-ap321:2.3": "samādhinā nisinnaṃ ca ",
  "tha-ap321:2.4": "sattapattaṃva pupphitaṃ. ",
  "tha-ap321:3.1": "sattakaṃ nālipupphāni ",
  "tha-ap321:3.2": "vaṇṭe chetvānahantadā ",
  "tha-ap321:3.3": "matthake abhiropesiṃ ",
  "tha-ap321:3.4": "buddhassādiccabandhuno. ",
  "tha-ap321:4.1": "suvaṇṇavaṇṇaṃ sambuddhaṃ ",
  "tha-ap321:4.2": "anukūle samāhitaṃ ",
  "tha-ap321:4.3": "tidhāppabhinnaṃ mātaṅgaṃ ",
  "tha-ap321:4.4": "kuñjaraṃva durāsadaṃ. ",
  "tha-ap321:5.1": "tamahaṃ upagantvāna ",
  "tha-ap321:5.2": "nipakaṃ bhāvitindriyaṃ ",
  "tha-ap321:5.3": "añjaliṃ paggahetvāna ",
  "tha-ap321:5.4": "avandiṃ satthuno ahaṃ. ",
  "tha-ap321:6.1": "catunavute ito kappe ",
  "tha-ap321:6.2": "yaṃ pupphamabhipūjayiṃ ",
  "tha-ap321:6.3": "duggatiṃ nābhijānāmi ",
  "tha-ap321:6.4": "buddhapūjāyidaṃ phalaṃ. ",
  "tha-ap321:7.1": "paṭisambhidā catasso ",
  "tha-ap321:7.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap321:7.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap321:8.1": "itthaṃ sudaṃ āyasmā nālipupphiyo thero imā gāthāyo abhāsitthāti. ",
  "tha-ap321:9.1": "nālipupphiyattherassa apadānaṃ samattaṃ. dasamaṃ kumudamāliyattherāpadānaṃ (320) "
}
