{
  "tha-ap43:0.1": "pañcamo upālivaggo ",
  "tha-ap43:0.2": "",
  "tha-ap43:0.3": "",
  "tha-ap43:1.1": "paṭhamaṃ upālittherāpadānaṃ (41) khīṇāsavasahassehi ",
  "tha-ap43:1.2": "parivuto lokanāyako ",
  "tha-ap43:1.3": "vivekamanuyutto so ",
  "tha-ap43:1.4": "gacchate paṭisallituṃ. ",
  "tha-ap43:2.1": "ajinena nivatthohaṃ ",
  "tha-ap43:2.2": "tidaṇḍaparicāraṇo ",
  "tha-ap43:2.3": "bhikkhusaṅghaparibyuḷhaṃ ",
  "tha-ap43:2.4": "addasaṃ lokanāyakaṃ. ",
  "tha-ap43:3.1": "ekaṃsaṃ ajinaṃ katvā ",
  "tha-ap43:3.2": "sīse katvāna añjaliṃ ",
  "tha-ap43:3.3": "sambuddhaṃ abhivādetvā ",
  "tha-ap43:3.4": "santhaviṃ lokanāyakaṃ. ",
  "tha-ap43:4.1": "yathāṇḍajā ca saṃsedā ",
  "tha-ap43:4.2": "opapātī jalambujā ",
  "tha-ap43:4.3": "kākādipakkhino sabbe ",
  "tha-ap43:4.4": "antalikkhe sadā carā. ",
  "tha-ap43:5.1": "ye keci pāṇabhūtatthi ",
  "tha-ap43:5.2": "saññino vā asaññino ",
  "tha-ap43:5.3": "sabbe te tava ñāṇamhi ",
  "tha-ap43:5.4": "anto honti samogadhā. ",
  "tha-ap43:6.1": "gandhā ca pabbateyyā ye ",
  "tha-ap43:6.2": "himavante naguttame ",
  "tha-ap43:6.3": "sabbe te tava sīlamhi ",
  "tha-ap43:6.4": "kalāyopi na yujjare. ",
  "tha-ap43:7.1": "mohandhakārapakkhanno ",
  "tha-ap43:7.2": "ayaṃ loko sadevako ",
  "tha-ap43:7.3": "tava ñāṇamhi jotante ",
  "tha-ap43:7.4": "andhakārā vidhaṃsitā. ",
  "tha-ap43:8.1": "yathā atthaṅgate suriye ",
  "tha-ap43:8.2": "honti sattā tamogatā ",
  "tha-ap43:8.3": "evaṃ buddhe anuppanne ",
  "tha-ap43:8.4": "hoti loko tamogato. ",
  "tha-ap43:9.1": "yathodayanto ādicco ",
  "tha-ap43:9.2": "vinodeti tamaṃ sadā ",
  "tha-ap43:9.3": "tatheva tvaṃ buddhaseṭṭha ",
  "tha-ap43:9.4": "viddhaṃsesi tamaṃ sadā. ",
  "tha-ap43:10.1": "padhānaṃ pahitattosi ",
  "tha-ap43:10.2": "buddho loke sadevake ",
  "tha-ap43:10.3": "tava kammābhiraddhena ",
  "tha-ap43:10.4": "tosesi janataṃ bahuṃ. ",
  "tha-ap43:11.1": "taṃ sutvā anumoditvā ",
  "tha-ap43:11.2": "padumuttaro mahāmuni ",
  "tha-ap43:11.3": "nabhe abbhuggami dhīro ",
  "tha-ap43:11.4": "haṃsarājāva ambare. ",
  "tha-ap43:12.1": "abbhuggantvāna sambuddho ",
  "tha-ap43:12.2": "mahesi padumuttaro ",
  "tha-ap43:12.3": "antalikkhe ṭhito satthā ",
  "tha-ap43:12.4": "imā gāthā abhāsatha. ",
  "tha-ap43:13.1": "yenidaṃ thavitaṃ ñāṇaṃ ",
  "tha-ap43:13.2": "upamehi samāyutaṃ ",
  "tha-ap43:13.3": "tamahaṃ kittayissāmi ",
  "tha-ap43:13.4": "suṇātha mama bhāsato. ",
  "tha-ap43:14.1": "aṭṭhārasañca khattuṃ so ",
  "tha-ap43:14.2": "devarājā bhavissati ",
  "tha-ap43:14.3": "paṭhabyā rajjaṃ tisataṃ ",
  "tha-ap43:14.4": "vasudhaṃ āvasissati. ",
  "tha-ap43:15.1": "pañcavīsatikhattuñca ",
  "tha-ap43:15.2": "cakkavatti bhavissati ",
  "tha-ap43:15.3": "padesarajjaṃ vipulaṃ ",
  "tha-ap43:15.4": "gaṇanāto asaṅkhayaṃ. ",
  "tha-ap43:16.1": "kappasatasahassamhi ",
  "tha-ap43:16.2": "okkākakulasambhavo ",
  "tha-ap43:16.3": "gotamo nāma nāmena ",
  "tha-ap43:16.4": "satthā loke bhavissati. ",
  "tha-ap43:17.1": "tusitāhi cavitvāna ",
  "tha-ap43:17.2": "sukkamūlena codito ",
  "tha-ap43:17.3": "hīnova jātiyā santo ",
  "tha-ap43:17.4": "upāli nāma hessati. ",
  "tha-ap43:18.1": "so ca pacchā pabbajitvā ",
  "tha-ap43:18.2": "virājitvāna pāpakaṃ ",
  "tha-ap43:18.3": "sabbāsave pariññāya ",
  "tha-ap43:18.4": "nibbāyissatyanāsavo. ",
  "tha-ap43:19.1": "tuṭṭho ca gotamo buddho ",
  "tha-ap43:19.2": "sakyaputto mahāyasotha ",
  "tha-ap43:19.3": "vinayādhigataṃ tassa ",
  "tha-ap43:19.4": "etadagge ṭhapessati. ",
  "tha-ap43:20.1": "saddhāyahaṃ pabbajito ",
  "tha-ap43:20.2": "katakicco anāsavo ",
  "tha-ap43:20.3": "sabbāsave pariññāya ",
  "tha-ap43:20.4": "viharāmi anāsavo. ",
  "tha-ap43:21.1": "bhagavā cānukampī maṃ ",
  "tha-ap43:21.2": "vinayehaṃ visārado ",
  "tha-ap43:21.3": "sakakammābhiraddho ca ",
  "tha-ap43:21.4": "viharāmi anāsavo. ",
  "tha-ap43:22.1": "saṃvuto pāṭimokkhamhi ",
  "tha-ap43:22.2": "indriyesu ca pañcasu ",
  "tha-ap43:22.3": "dhāremi vinayaṃ sabbaṃ ",
  "tha-ap43:22.4": "kevalaṃ ratanākaraṃ. ",
  "tha-ap43:23.1": "mamañca guṇamaññāya ",
  "tha-ap43:23.2": "satthā loke anuttaro ",
  "tha-ap43:23.3": "bhikkhusaṅghe nisīditvā ",
  "tha-ap43:23.4": "etadagge ṭhapesi maṃ. ",
  "tha-ap43:24.1": "paṭisambhidā catasso ",
  "tha-ap43:24.2": "vimokkhāpica aṭṭhime ",
  "tha-ap43:24.3": "chaḷabhiññā sacchikatā ",
  "tha-ap43:24.4": "kataṃ buddhassa sāsananti. ",
  "tha-ap43:25.1": "itthaṃ sudaṃ āyasmā upāli thero imā gāthāyo abhāsitthāti. ",
  "tha-ap43:26.1": "upālittherassa apadānaṃ samattaṃ. dutiyaṃ soṇakoṭiyavessattherāpadānaṃ (42) "
}
