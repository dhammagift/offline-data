{
  "tha-ap233:0.1": "catubbīso udakāsanadāyivaggo ",
  "tha-ap233:0.2": "",
  "tha-ap233:0.3": "",
  "tha-ap233:1.1": "paṭhamaṃ udakāsanadāyakattherāpadānaṃ (231) ārāmadvārā nikkhamma ",
  "tha-ap233:1.2": "phalakaṃ santhariṃ ahaṃ ",
  "tha-ap233:1.3": "udakañca upaṭṭhāsiṃ ",
  "tha-ap233:1.4": "uttamatthassa pattiyā. ",
  "tha-ap233:2.1": "ekatiṃse ito kappe ",
  "tha-ap233:2.2": "yaṃ kammamakariṃ tadā ",
  "tha-ap233:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap233:2.4": "āsane codake phalaṃ. ",
  "tha-ap233:3.1": "ito paṇṇarase kappe ",
  "tha-ap233:3.2": "abhisāmasamavhayo ",
  "tha-ap233:3.3": "sattaratanasampanno ",
  "tha-ap233:3.4": "cakkavatti mahabbalo. ",
  "tha-ap233:4.1": "paṭisambhidā catasso ",
  "tha-ap233:4.2": "vimokkhāpica aṭṭhime ",
  "tha-ap233:4.3": "chaḷabhiññā sacchikatā ",
  "tha-ap233:4.4": "kataṃ buddhassa sāsananti. ",
  "tha-ap233:5.1": "itthaṃ sudaṃ āyasmā udakāsanadāyabho thero imā gāthāyo abhāsitthāti. ",
  "tha-ap233:6.1": "udakāsanadāyakattherassa apadānaṃ samattaṃ. dutiyaṃ bhājanadāyakattherāpadānaṃ (232) "
}
