  "tha-ap301:0.3": "",
  "tha-ap301:1.1": "romaso nāma nāmena ",
  "tha-ap301:1.2": "dānavo iti vissuto ",
  "tha-ap301:1.3": "ambapiṇḍo mayā dinno ",
  "tha-ap301:1.4": "vipassissa mahesino. ",
  "tha-ap301:2.1": "ekanavute ito kappe ",
  "tha-ap301:2.2": "yaṃ ambamadadiṃ tadā ",
  "tha-ap301:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap301:2.4": "ambadānassidaṃ phalaṃ. ",
  "tha-ap301:3.1": "paṭisambhidā catasso ",
  "tha-ap301:3.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap301:3.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap301:4.1": "itthaṃ sudaṃ āyasmā ambapiṇḍiyo thero imā gāthāyo abhāsitthāti. ",
  "tha-ap301:5.1": "ambapiṇḍiyattherassa apadānaṃ samattaṃ. dasamaṃ anusaṃsāvakattherāpadānaṃ (300) "
}
