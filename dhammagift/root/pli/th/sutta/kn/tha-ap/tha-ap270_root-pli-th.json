  "tha-ap270:0.1": "",
  "tha-ap270:0.2": "",
  "tha-ap270:0.3": "",
  "tha-ap270:1.1": "candabhāgānadītīre ",
  "tha-ap270:1.2": "ahosiṃ kinnaro tadā ",
  "tha-ap270:1.3": "vipassiṃ addasaṃ buddhaṃ ",
  "tha-ap270:1.4": "raṃsijālasamākulaṃ. ",
  "tha-ap270:2.1": "pasannacitto sumano ",
  "tha-ap270:2.2": "paramāya ca pītiyā ",
  "tha-ap270:2.3": "paggayha salaḷaṃ pupphaṃ ",
  "tha-ap270:2.4": "vipassissa okiriṃ ahaṃ. ",
  "tha-ap270:3.1": "ekanavute ito kappe ",
  "tha-ap270:3.2": "yaṃ pupphamabhipūjayiṃ ",
  "tha-ap270:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap270:3.4": "buddhapūjāyidaṃ phalaṃ. ",
  "tha-ap270:4.1": "paṭisambhidā catasso ",
  "tha-ap270:4.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap270:4.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap270:5.1": "itthaṃ sudaṃ āyasmā salaḷapupphiyo thero imā gāthāyo abhāsitthāti. ",
  "tha-ap270:6.1": "salaḷapupphiyattherassa apadānaṃ samattaṃ. navamaṃ upāgatahāsaniyattherāpadānaṃ (269) "
}
