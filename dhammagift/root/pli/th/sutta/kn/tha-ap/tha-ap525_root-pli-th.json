{
  "tha-ap525:0.1": "",
  "tha-ap525:0.2": "",
  "tha-ap525:0.3": "",
  "tha-ap525:1.1": "āruyhamhi tadā nāvaṃ ",
  "tha-ap525:1.2": "bhikkhu cājīviko ahaṃ ",
  "tha-ap525:1.3": "nāvāya bhijjamānāya ",
  "tha-ap525:1.4": "bhikkhu me saraṇaṃ adā. ",
  "tha-ap525:2.1": "ekatiṃse ito kappe ",
  "tha-ap525:2.2": "yaṃ so me saraṇaṃ adā ",
  "tha-ap525:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap525:2.4": "saraṇagamane phalaṃ. ",
  "tha-ap525:3.1": "kilesā jhāpitā mayhaṃ ",
  "tha-ap525:3.2": "bhavā sabbe samūhatā nāgova bandhanaṃ chetvā ",
  "tha-ap525:3.3": "viharāmi anāsavo. ",
  "tha-ap525:4.1": "svāgataṃ vata me āsi ",
  "tha-ap525:4.2": "mama buddhassa santike tisso vijjā anuppattā ",
  "tha-ap525:4.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap525:5.1": "paṭisambhidā catasso ",
  "tha-ap525:5.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap525:5.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap525:6.1": "itthaṃ sudaṃ āyasmā saraṇagamaniyo thero imā gāthāyo abhāsitthāti. ",
  "tha-ap525:7.1": "saraṇagamaniyattherassa apadānaṃ samattaṃ. catutthaṃ abbhañjanadāyakattherāpadānaṃ (524) "
}
