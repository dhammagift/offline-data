{
  "tha-ap443:0.1": "pañcacattāḷīso vibhedakivaggo ",
  "tha-ap443:0.2": "",
  "tha-ap443:0.3": "",
  "tha-ap443:1.1": "paṭhamaṃ vibhedakabījiyattherāpadānaṃ (441) kakusandho mahāvīro ",
  "tha-ap443:1.2": "sabbadhammāna pāragū ",
  "tha-ap443:1.3": "gaṇamhā vūpakaṭṭho so ",
  "tha-ap443:1.4": "agamāsi vanantaraṃ. ",
  "tha-ap443:2.1": "vījavījaṃ gahetvāna ",
  "tha-ap443:2.2": "latāya ācariṃ ahaṃ ",
  "tha-ap443:2.3": "bhagavā tamhi samaye ",
  "tha-ap443:2.4": "jhāyate pabbatantare. ",
  "tha-ap443:3.1": "disvānāhaṃ devadevaṃ ",
  "tha-ap443:3.2": "vippasannena cetasā ",
  "tha-ap443:3.3": "dakkhiṇeyyassa dhīrassa ",
  "tha-ap443:3.4": "vījavījamadāsahaṃ. ",
  "tha-ap443:4.1": "imasmiṃyeva kappasmiṃ ",
  "tha-ap443:4.2": "yaṃ vījamadadiṃ tadā ",
  "tha-ap443:4.3": "duggatiṃ nābhijānāmi ",
  "tha-ap443:4.4": "vījavījassidaṃ phalaṃ. ",
  "tha-ap443:5.1": "kilesā jhāpitā mayhaṃ ",
  "tha-ap443:5.2": "bhavā sabbe samūhatā ",
  "tha-ap443:5.3": "nāgova bandhanaṃ chetvā ",
  "tha-ap443:5.4": "viharāmi anāsavo. ",
  "tha-ap443:6.1": "svāgataṃ vata me āsi ",
  "tha-ap443:6.2": "mama buddhassa santike ",
  "tha-ap443:6.3": "tisso vijjā anuppattā ",
  "tha-ap443:6.4": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap443:7.1": "paṭisambhidā catasso ",
  "tha-ap443:7.2": "vimokkhāpica aṭṭhime ",
  "tha-ap443:7.3": "chaḷabhiññā sacchikatā ",
  "tha-ap443:7.4": "kataṃ buddhassa sāsananti. ",
  "tha-ap443:8.1": "itthaṃ sudaṃ āyasmā vibhedakabījiyo thero imā gāthāyo abhāsitthāti. ",
  "tha-ap443:9.1": "vibhedakabījiyattherassa apadānaṃ samattaṃ. dutiyaṃ koladāyakattherāpadānaṃ (442) "
}
