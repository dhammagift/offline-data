{
  "tha-ap512:0.1": "",
  "tha-ap512:0.2": "",
  "tha-ap512:0.3": "",
  "tha-ap512:1.1": "nagare bandhumatiyā ",
  "tha-ap512:1.2": "ārāmiko ahaṃ tadā ",
  "tha-ap512:1.3": "addasaṃ virajaṃ buddhaṃ ",
  "tha-ap512:1.4": "gacchantaṃ anilañjase. ",
  "tha-ap512:2.1": "nālikeraphalaṃ gayha ",
  "tha-ap512:2.2": "buddhaseṭṭhassadāsahaṃ ",
  "tha-ap512:2.3": "ākāse ṭhitako santo ",
  "tha-ap512:2.4": "paṭiggaṇhi mahāyaso. ",
  "tha-ap512:3.1": "pītisañjanano mayhaṃ ",
  "tha-ap512:3.2": "diṭṭhadhammasukhāvaho ",
  "tha-ap512:3.3": "phalaṃ buddhassa datvāna ",
  "tha-ap512:3.4": "vippasannena cetasā. ",
  "tha-ap512:4.1": "adhigañchiṃ tadā pītiṃ ",
  "tha-ap512:4.2": "vipulañca sukhuttamaṃ ",
  "tha-ap512:4.3": "uppajjateva ratanaṃ ",
  "tha-ap512:4.4": "nibbattassa tahiṃ tahiṃ. ",
  "tha-ap512:5.1": "ekanavute ito kappe ",
  "tha-ap512:5.2": "yaṃ phalaṃ adadiṃ tadā ",
  "tha-ap512:5.3": "duggatiṃ nābhijānāmi ",
  "tha-ap512:5.4": "phaladānassidaṃ phalaṃ. ",
  "tha-ap512:6.1": "dibbacakkhuṃ visuddhaṃ me ",
  "tha-ap512:6.2": "samādhikusalo ahaṃ ",
  "tha-ap512:6.3": "abhiññāpāramippatto ",
  "tha-ap512:6.4": "phaladānassidaṃ phalaṃ. ",
  "tha-ap512:7.1": "kilesā jhāpitā mayhaṃ ",
  "tha-ap512:7.2": "bhavā sabbe samūhatā nāgova bandhanaṃ chetvā ",
  "tha-ap512:7.3": "viharāmi anāsavo. ",
  "tha-ap512:8.1": "svāgataṃ vata me āsi ",
  "tha-ap512:8.2": "mama buddhassa santike tisso ",
  "tha-ap512:8.3": "vijjā anuppattā kat buddhassa sāsanaṃ. ",
  "tha-ap512:9.1": "paṭisambhidā catasso ",
  "tha-ap512:9.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap512:9.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap512:10.1": "itthaṃ sudaṃ āyasmā nālikeraphaladāyako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap512:11.1": "nālikeraphaladāyakattherassa apadānaṃ ",
  "tha-ap512:12.1": "samattaṃ. uddānaṃ ",
  "tha-ap512:13.1": "kaṇikārañca ",
  "tha-ap512:14.1": "patto ca ",
  "tha-ap512:14.2": "kāsumāri tathāvaṭo ",
  "tha-ap512:14.3": "cāraphali mātuluṅgo ",
  "tha-ap512:14.4": "ajjelāmorameva ca. ",
  "tha-ap512:15.1": "tālaṃ tathā nālikeraṃ ",
  "tha-ap512:15.2": "gāthāyo gaṇitāpiha ",
  "tha-ap512:15.3": "ekaṃ gāthāsataṃ hoti ",
  "tha-ap512:15.4": "ūnādhikavivajjitaṃ. kaṇikāravaggo ekapaññāso. "
}
