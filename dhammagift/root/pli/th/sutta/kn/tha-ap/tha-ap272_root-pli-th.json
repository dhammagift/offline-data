{
  "tha-ap272:0.1": "",
  "tha-ap272:0.2": "",
  "tha-ap272:0.3": "",
  "tha-ap272:1.1": "suvaṇṇavaṇṇo sambuddho ",
  "tha-ap272:1.2": "vipassī nāma nāyako ",
  "tha-ap272:1.3": "nadītīre ṭhito satthā ",
  "tha-ap272:1.4": "bhikkhusaṅghapurakkhato. ",
  "tha-ap272:2.1": "nāvā na vijjate tattha ",
  "tha-ap272:2.2": "santāraṇī mahaṇṇave ",
  "tha-ap272:2.3": "nadiyā abhinikkhamma ",
  "tha-ap272:2.4": "tāresiṃ lokanāyakaṃ. ",
  "tha-ap272:3.1": "ekanavute ito kappe ",
  "tha-ap272:3.2": "yaṃ tāresiṃ naruttamaṃ ",
  "tha-ap272:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap272:3.4": "tāraṇāya idaṃ phalaṃ. ",
  "tha-ap272:4.1": "paṭisambhidā catasso ",
  "tha-ap272:4.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap272:4.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap272:5.1": "itthaṃ sudaṃ āyasmā taraṇiyo thero imā gāthāyo abhāsitthāti. ",
  "tha-ap272:6.1": "taraṇiyattherassa apadānaṃ ",
  "tha-ap272:7.1": "samattaṃ. uddānaṃ ",
  "tha-ap272:8.1": "ukkhepī ",
  "tha-ap272:9.1": "telacandī ca ",
  "tha-ap272:9.2": "dīpado ca viḷālido ",
  "tha-ap272:9.3": "maccho javo salaḷado ",
  "tha-ap272:9.4": "rakkhaso taraṇo dasa ",
  "tha-ap272:9.5": "gāthāyo cettha saṅkhātā ",
  "tha-ap272:9.6": "tāḷīsamekameva ca. padumukkhepavaggo sattavīso. "
}
