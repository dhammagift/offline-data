{
  "tha-ap75:0.1": "",
  "tha-ap75:0.2": "",
  "tha-ap75:0.3": "",
  "tha-ap75:1.1": "dumagge paṃsukūlikaṃ ",
  "tha-ap75:1.2": "laggaṃ disvāna satthuno ",
  "tha-ap75:1.3": "tatohaṃ añjaliṃ katvā ",
  "tha-ap75:1.4": "paṃsukūlaṃ avandihaṃ. ",
  "tha-ap75:2.1": "dvenavute ito kappe ",
  "tha-ap75:2.2": "yaṃ kammamakariṃ tadā ",
  "tha-ap75:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap75:2.4": "paṃsusaññāyidaṃ phalaṃ. ",
  "tha-ap75:3.1": "ito catutthake kappe ",
  "tha-ap75:3.2": "dumaharo su khattiyo ",
  "tha-ap75:3.3": "cāturanto vijitāvī ",
  "tha-ap75:3.4": "cakkavatti mahabbalo. ",
  "tha-ap75:4.1": "paṭisambhidā catasso ",
  "tha-ap75:4.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap75:4.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap75:5.1": "itthaṃ sudaṃ āyasmā susaññako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap75:6.1": "susaññakattherassa apadānaṃ samattaṃ. catutthaṃ bhisāluvadāyakattherāpadānaṃ (74) "
}
