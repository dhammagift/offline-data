  "tha-ap239:0.1": "",
  "tha-ap239:0.2": "",
  "tha-ap239:0.3": "",
  "tha-ap239:1.1": "migaluddho pure āsiṃ ",
  "tha-ap239:1.2": "araññe kānane ahaṃ ",
  "tha-ap239:1.3": "piyālaṃ pupphitaṃ disvā ",
  "tha-ap239:1.4": "gatamagge khipiṃ ahaṃ. ",
  "tha-ap239:2.1": "buddhassa pattaṃ paggayha piyālapupphamadāsahaṃ magge gatassa buddhassa vippasannena cetasā. ekanavute ito kappe ",
  "tha-ap239:2.2": "yaṃ pupphamabhipūjayiṃ ",
  "tha-ap239:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap239:2.4": "buddhapūjāyidaṃ phalaṃ. ",
  "tha-ap239:3.1": "paṭisambhidā catasso ",
  "tha-ap239:3.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap239:3.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap239:4.1": "itthaṃ sudaṃ āyasmā piyālapupphiyo thero imā gāthāyo abhāsitthāti. ",
  "tha-ap239:5.1": "piyālapupphiyattherassa apadānaṃ samattaṃ. aṭṭhamaṃ ambayāgadāyakattherāpadānaṃ (238) "
}
