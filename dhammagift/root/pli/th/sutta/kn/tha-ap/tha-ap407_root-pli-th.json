{
  "tha-ap407:0.1": "",
  "tha-ap407:0.2": "",
  "tha-ap407:0.3": "",
  "tha-ap407:1.1": "himavantassa avidūre ",
  "tha-ap407:1.2": "anomo nāma pabbato ",
  "tha-ap407:1.3": "assamo sukato mayhaṃ ",
  "tha-ap407:1.4": "paṇṇasālā sumāpitā. ",
  "tha-ap407:2.1": "nadī ca sandati tattha ",
  "tha-ap407:2.2": "supatitthā manoramā ",
  "tha-ap407:2.3": "anūpatitthe jāyanti ",
  "tha-ap407:2.4": "padumuppalakā bahū. ",
  "tha-ap407:3.1": "pāṭhīnā pāvusā macchā ",
  "tha-ap407:3.2": "balajā muñjarohitā ",
  "tha-ap407:3.3": "macchakacchapasañchannā ",
  "tha-ap407:3.4": "nadikā sandate tadā. ",
  "tha-ap407:4.1": "timirā pupphitā tattha ",
  "tha-ap407:4.2": "asokā khuddamālakā ",
  "tha-ap407:4.3": "puṇṇāvā giripuṇṇā vā ",
  "tha-ap407:4.4": "sampavanti mamassamaṃ. ",
  "tha-ap407:5.1": "kuṭajā pupphitā tattha ",
  "tha-ap407:5.2": "tiṇasūlavanāni ca ",
  "tha-ap407:5.3": "sālā ca salaḷā tattha ",
  "tha-ap407:5.4": "campakā pupphitā bahū. ",
  "tha-ap407:6.1": "ajjunā adhimuttā ca ",
  "tha-ap407:6.2": "mahānāmā ca pupphitā ",
  "tha-ap407:6.3": "asanā madhugandhī ca ",
  "tha-ap407:6.4": "pupphitā te mamassame. ",
  "tha-ap407:7.1": "uddālakā pāṭalikā ",
  "tha-ap407:7.2": "yūthikā ca piyaṅgukā ",
  "tha-ap407:7.3": "bimbijālakasañchannā ",
  "tha-ap407:7.4": "samantā aḍḍhayojanaṃ. ",
  "tha-ap407:8.1": "mātakarā sattaliyo ",
  "tha-ap407:8.2": "pāṭalī sindhuvāritā ",
  "tha-ap407:8.3": "aṅkolakā bahū tattha ",
  "tha-ap407:8.4": "tālakuṭā ca pupphitā. ",
  "tha-ap407:8.5": "seleyyakā bahū tattha ",
  "tha-ap407:8.6": "pupphitā mama assame ",
  "tha-ap407:9.1": "etesu pupphajātesu ",
  "tha-ap407:9.2": "sobhanti pādapā bahū. ",
  "tha-ap407:9.3": "samantā tena gandhena ",
  "tha-ap407:9.4": "vāyate mama assame ",
  "tha-ap407:10.1": "harītakā āmalakā ",
  "tha-ap407:10.2": "ambajambū vibhedakā. ",
  "tha-ap407:10.3": "kolā bhallātakā bellā ",
  "tha-ap407:10.4": "phārusakaphalāni ca ",
  "tha-ap407:11.1": "tindukā ca piyālā ca ",
  "tha-ap407:11.2": "madhukā kāsamāriyo. ",
  "tha-ap407:11.3": "labujā panasā tattha ",
  "tha-ap407:11.4": "kadalī candarīphalā ",
  "tha-ap407:12.1": "ambāṭakā bahū tattha ",
  "tha-ap407:12.2": "vallikāraphalāni ca. ",
  "tha-ap407:12.3": "cirasaṃrasapākā ca ",
  "tha-ap407:12.4": "phalitā mama assame ",
  "tha-ap407:13.1": "āḷakā isimuggā ca ",
  "tha-ap407:13.2": "tato soraphalā bahū. ",
  "tha-ap407:13.3": "avaṭā pakkabharitā ",
  "tha-ap407:13.4": "milakkhudumbarāni ca ",
  "tha-ap407:14.1": "pipphalī maricā tattha ",
  "tha-ap407:14.2": "nigrodhā ca kapiṭṭhanā. ",
  "tha-ap407:14.3": "udumbarakā bahavo ",
  "tha-ap407:14.4": "kaṇḍapakkā ca pāriyo ",
  "tha-ap407:15.1": "ete caññe ca bahavo ",
  "tha-ap407:15.2": "phalitā assame mama. ",
  "tha-ap407:15.3": "puppharukkhāpi bahavo ",
  "tha-ap407:15.4": "pupphitā mama assame ",
  "tha-ap407:16.1": "āluvā ca kadambā ca ",
  "tha-ap407:16.2": "biḷālitakkalāni ca. ",
  "tha-ap407:16.3": "ālakā tālakā ceva ",
  "tha-ap407:16.4": "vijjanti mama assame ",
  "tha-ap407:17.1": "assamassāvidūre me ",
  "tha-ap407:17.2": "mahājātassaro ahu. ",
  "tha-ap407:17.3": "acchodako sītajalo ",
  "tha-ap407:17.4": "supatittho manoramo ",
  "tha-ap407:18.1": "padumuppalā bahū tattha ",
  "tha-ap407:18.2": "puṇḍarikasamāyutā. ",
  "tha-ap407:18.3": "mandālakehi sañchannā ",
  "tha-ap407:18.4": "nānāgandhasamīritā ",
  "tha-ap407:19.1": "gabbhaṃ gaṇhanti padumā ",
  "tha-ap407:19.2": "aññe pupphanti kesarī. ",
  "tha-ap407:19.3": "opupphapattā tiṭṭhanti ",
  "tha-ap407:19.4": "padumā kaṇṇikā bahū ",
  "tha-ap407:20.1": "madhu bhisamhā savati ",
  "tha-ap407:20.2": "khīrasappi muḷālibhi. ",
  "tha-ap407:20.3": "samantā tena gandhena ",
  "tha-ap407:20.4": "nānāgandhasamohitā ",
  "tha-ap407:21.1": "kumudā ambagandhī ca ",
  "tha-ap407:21.2": "nayitā dissare bahū. ",
  "tha-ap407:21.3": "jātassarassānukūlaṃ ",
  "tha-ap407:21.4": "ketakā pupphitā bahū ",
  "tha-ap407:22.1": "suphullā bandhujīvā ca ",
  "tha-ap407:22.2": "setavārī sugandhikā. ",
  "tha-ap407:22.3": "kumbhīlā sasasumārā ca ",
  "tha-ap407:22.4": "gahakā tattha jāyare ",
  "tha-ap407:23.1": "uggāhakā ajagarā ",
  "tha-ap407:23.2": "tattha jātassare bahū. ",
  "tha-ap407:23.3": "pāṭhīnā pāvusā macchā ",
  "tha-ap407:23.4": "balajā muñjarohitā ",
  "tha-ap407:24.1": "macchakacchapasañchannā ",
  "tha-ap407:24.2": "atho sapaṭakehi ca. ",
  "tha-ap407:24.3": "pārevatā ravihaṃsā ",
  "tha-ap407:24.4": "kukkutthakā nadīcarā ",
  "tha-ap407:25.1": "dindibhā cakkavākā ca ",
  "tha-ap407:25.2": "cappakā jīvajīvakā. ",
  "tha-ap407:25.3": "kalandakā ukkusā ca ",
  "tha-ap407:25.4": "senakā uddharā bahū ",
  "tha-ap407:26.1": "kotthakā sukapotā ca ",
  "tha-ap407:26.2": "kuḷīrā camarā bahū. ",
  "tha-ap407:26.3": "kāseniyā ca tilakā ",
  "tha-ap407:26.4": "upajīvanti taṃ saraṃ ",
  "tha-ap407:27.1": "sīhā byagghā ca dīpī ca ",
  "tha-ap407:27.2": "acchakokataracchayo. ",
  "tha-ap407:27.3": "vānarā kinnarā ceva ",
  "tha-ap407:27.4": "dissanti mama assame ",
  "tha-ap407:28.1": "tāni gandhāni ghāyanto ",
  "tha-ap407:28.2": "bhakkhayanto phalānahaṃ. ",
  "tha-ap407:28.3": "gandhodakaṃ pivanto ca ",
  "tha-ap407:28.4": "vasāmi mama assame ",
  "tha-ap407:29.1": "eṇimigā varāhā ca ",
  "tha-ap407:29.2": "pasadā khuddarūpakā. ",
  "tha-ap407:29.3": "aggikā jotikā ceva ",
  "tha-ap407:29.4": "vasanti mama assame ",
  "tha-ap407:30.1": "haṃsā koñcā mayūrā ca ",
  "tha-ap407:30.2": "sahitāpica kokilā. ",
  "tha-ap407:30.3": "mañjarikā bahū tattha ",
  "tha-ap407:30.4": "kosikā potthasīsakā ",
  "tha-ap407:31.1": "pisācā dānavā ceva ",
  "tha-ap407:31.2": "kumbhaṇḍā rakkhasā bahū. ",
  "tha-ap407:31.3": "garuḷā pannagā ceva ",
  "tha-ap407:31.4": "vasanti mama assame ",
  "tha-ap407:32.1": "mahānubhāvā isayo ",
  "tha-ap407:32.2": "santacittā samāhitā. ",
  "tha-ap407:32.3": "kamaṇḍaludharā sabbe ",
  "tha-ap407:32.4": "ajinuttaravāsino jaṭābhārabharitā ",
  "tha-ap407:32.5": "ca ",
  "tha-ap407:32.6": "vasanti mama assame. ",
  "tha-ap407:33.1": "yugamattañca pekkhantā ",
  "tha-ap407:33.2": "nipakā santavuttino ",
  "tha-ap407:33.3": "lābhālābhena santuṭṭhā ",
  "tha-ap407:33.4": "vasanti mama assame. ",
  "tha-ap407:34.1": "vākacīraṃ dhunantā te ",
  "tha-ap407:34.2": "poṭhentā jinacammakaṃ ",
  "tha-ap407:34.3": "sabalehi upatthaddhā ",
  "tha-ap407:34.4": "gacchanti ambare tadā. ",
  "tha-ap407:35.1": "navodakaṃ āharanti ",
  "tha-ap407:35.2": "kaṭṭhaṃ vā aggidārukaṃ ",
  "tha-ap407:35.3": "sayañca upasampannā ",
  "tha-ap407:35.4": "sappāṭihirassidaṃ phalaṃ. ",
  "tha-ap407:36.1": "lohadoṇiṃ gahetvāna ",
  "tha-ap407:36.2": "vanamajjhe vasanti te ",
  "tha-ap407:36.3": "kuñjarāva mahānāgā ",
  "tha-ap407:36.4": "achambhitāva kesarī. ",
  "tha-ap407:37.1": "aññe gacchanti goyānaṃ ",
  "tha-ap407:37.2": "aññe pubbavidehanaṃ ",
  "tha-ap407:37.3": "aññe ca uttarakuruṃ ",
  "tha-ap407:37.4": "sakambalamapassitā. ",
  "tha-ap407:38.1": "tato piṇḍaṃ āharitvā ",
  "tha-ap407:38.2": "paribhuñjanti ekato ",
  "tha-ap407:38.3": "sabbesaṃ pakkamantānaṃ ",
  "tha-ap407:38.4": "uggatejāna tādinaṃ. ",
  "tha-ap407:39.1": "ajinacammasaddena ",
  "tha-ap407:39.2": "vanaṃ saddāyate tadā. ",
  "tha-ap407:39.3": "edisā te mahāvīra ",
  "tha-ap407:39.4": "sissā uggatapā mama ",
  "tha-ap407:40.1": "parivuto ahaṃ tehi ",
  "tha-ap407:40.2": "vasāmi mama assame. ",
  "tha-ap407:40.3": "tositā sakakammena ",
  "tha-ap407:40.4": "vinītāpi samāgatā ",
  "tha-ap407:41.1": "ārādhayiṃsu maṃ ete ",
  "tha-ap407:41.2": "sakakammābhilāsino. ",
  "tha-ap407:41.3": "sīlavanto ca nipakā ",
  "tha-ap407:41.4": "appamaññāsu kovidā ",
  "tha-ap407:42.1": "padumuttaro lokavidū ",
  "tha-ap407:42.2": "āhutīnaṃ paṭiggaho. ",
  "tha-ap407:42.3": "samayaṃ saṃviditvāna ",
  "tha-ap407:42.4": "upagañchi vināyako ",
  "tha-ap407:43.1": "upagantvāna sambuddho ",
  "tha-ap407:43.2": "ātāpī nipako muni. ",
  "tha-ap407:43.3": "pattaṃ paggayha sambuddho ",
  "tha-ap407:43.4": "bhikkhāya samupāgami ",
  "tha-ap407:44.1": "upāgataṃ mahāvīraṃ ",
  "tha-ap407:44.2": "jalajuttamanāmakaṃ. ",
  "tha-ap407:44.3": "tiṇattharaṃ paññāpetvā ",
  "tha-ap407:44.4": "sālapupphehi okiriṃ ",
  "tha-ap407:45.1": "nisīditvāna sambuddhaṃ ",
  "tha-ap407:45.2": "haṭṭho saṃviggamānaso. ",
  "tha-ap407:45.3": "khippaṃ pabbatamāruyha ",
  "tha-ap407:45.4": "agaḷuṃ aggahiṃ ahaṃ ",
  "tha-ap407:46.1": "kumbhamattaṃ gahetvāna ",
  "tha-ap407:46.2": "panasaṃ devagandhikaṃ. ",
  "tha-ap407:46.3": "khandhe āropayitvāna ",
  "tha-ap407:46.4": "upagañchiṃ vināyakaṃ ",
  "tha-ap407:47.1": "phalaṃ buddhassa datvāna ",
  "tha-ap407:47.2": "agaḷuṃ anulimpahaṃ. ",
  "tha-ap407:47.3": "pasannacitto sumano ",
  "tha-ap407:47.4": "buddhaseṭṭhaṃ avandihaṃ ",
  "tha-ap407:48.1": "padumuttaro lokavidū ",
  "tha-ap407:48.2": "āhutīnaṃ paṭiggaho. ",
  "tha-ap407:48.3": "isimajjhe nisīditvā ",
  "tha-ap407:48.4": "imā gāthā abhāsatha ",
  "tha-ap407:49.1": "yo ca me phalamagaḷuṃ ",
  "tha-ap407:49.2": "āsanañca adāsi me. ",
  "tha-ap407:49.3": "tamahaṃ kittayissāmi ",
  "tha-ap407:49.4": "suṇātha mama bhāsato ",
  "tha-ap407:50.1": "gāme vā yadivāraññe ",
  "tha-ap407:50.2": "pabbhāresu guhāsu vā. ",
  "tha-ap407:50.3": "imassa cittamaññāya ",
  "tha-ap407:50.4": "nibbattissati bhojanaṃ ",
  "tha-ap407:51.1": "devaloke manusse vā ",
  "tha-ap407:51.2": "upapanno ayaṃ naro. ",
  "tha-ap407:51.3": "bhojanehi ca vatthehi ",
  "tha-ap407:51.4": "parisantappayissati ",
  "tha-ap407:52.1": "upapajjati yaṃ yoniṃ ",
  "tha-ap407:52.2": "devattaṃ atha mānusaṃ. ",
  "tha-ap407:52.3": "akkhobbhabhogo hutvāna ",
  "tha-ap407:52.4": "saṃsarissatiyaṃ naro ",
  "tha-ap407:53.1": "tiṃsakappasahassāni ",
  "tha-ap407:53.2": "devaloke ramissati. ",
  "tha-ap407:53.3": "sahassakkhattuṃ rājā ca ",
  "tha-ap407:53.4": "cakkavatti bhavissati ",
  "tha-ap407:54.1": "ekasattatikkhattuñca ",
  "tha-ap407:54.2": "devarajjaṃ karissati. ",
  "tha-ap407:54.3": "padesarajjaṃ vipulaṃ ",
  "tha-ap407:54.4": "gaṇanāto asaṅkhayaṃ ",
  "tha-ap407:55.1": "kappasatasahassamhi ",
  "tha-ap407:55.2": "okkākakulasambhavo. ",
  "tha-ap407:55.3": "gotamo nāma nāmena ",
  "tha-ap407:55.4": "satthā loke bhavissati ",
  "tha-ap407:56.1": "tassa dhammesu dāyādo ",
  "tha-ap407:56.2": "oraso dhammanimmito. ",
  "tha-ap407:56.3": "",
  "tha-ap407:56.4": "upasīvo nāma nāmena hessati satthusāvako sabbāsave pariññāya ",
  "tha-ap407:56.5": "viharissatināsavo. ",
  "tha-ap407:57.1": "suladdhalābho laddho me ",
  "tha-ap407:57.2": "yohaṃ addakkhi nāyakaṃ ",
  "tha-ap407:57.3": "tisso vijjā anuppattā ",
  "tha-ap407:57.4": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap407:58.1": "gāme vā yadivāraññe ",
  "tha-ap407:58.2": "pabbhāresu guhāsu vā ",
  "tha-ap407:58.3": "mama saṅkappamaññāya ",
  "tha-ap407:58.4": "bhojanaṃ hoti me sadā. ",
  "tha-ap407:59.1": "kilesā jhāpitā mayhaṃ ",
  "tha-ap407:59.2": "bhavā sabbe samūhatā nāgova bandhanaṃ chetvā ",
  "tha-ap407:59.3": "viharāmi anāsavo. ",
  "tha-ap407:60.1": "svāgataṃ vata me āsi ",
  "tha-ap407:60.2": "mama buddhassa santike tisso vijjā anuppattā ",
  "tha-ap407:60.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap407:61.1": "paṭisambhidā catasso ",
  "tha-ap407:61.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap407:61.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap407:62.1": "itthaṃ sudaṃ āyasmā upasīvo thero imā gāthāyo abhāsitthāti. ",
  "tha-ap407:63.1": "upasīvattherassa apadānaṃ samattaṃ. chaṭṭhaṃ nandakattherāpadānaṃ (406) "
}
