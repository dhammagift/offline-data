{
  "tha-ap527:0.1": "",
  "tha-ap527:0.2": "",
  "tha-ap527:0.3": "",
  "tha-ap527:1.1": "divāvihārā nikkhanto ",
  "tha-ap527:1.2": "vipassī lokanāyako ",
  "tha-ap527:1.3": "lahuṃ supaṭikaṃ datvā ",
  "tha-ap527:1.4": "kappaṃ saggamhi modahaṃ. ",
  "tha-ap527:2.1": "ekanavute ito kappe ",
  "tha-ap527:2.2": "yaṃ supaṭikamadāsahaṃ ",
  "tha-ap527:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap527:2.4": "supaṭassa idaṃ phalaṃ. ",
  "tha-ap527:3.1": "kilesā jhāpitā mayhaṃ ",
  "tha-ap527:3.2": "bhavā sabbe samūhatā nāgova bandhanaṃ chetvā ",
  "tha-ap527:3.3": "viharāmi anāsavo. ",
  "tha-ap527:4.1": "svāgataṃ vata me āsi ",
  "tha-ap527:4.2": "buddhaseṭṭhassa santike tisso vijjā anuppattā ",
  "tha-ap527:4.3": "kataṃ baddhassa sāsanaṃ. ",
  "tha-ap527:5.1": "paṭisambhidā catasso ",
  "tha-ap527:5.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap527:5.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap527:6.1": "itthaṃ sudaṃ āyasmā supaṭadāyako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap527:7.1": "supaṭadāyakattherassa apadānaṃ samattaṃ. chaṭṭhaṃ daṇḍadāyakattherāpadānaṃ (526) "
}
