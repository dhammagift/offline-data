  "tha-ap222:0.1": "",
  "tha-ap222:0.2": "",
  "tha-ap222:0.3": "",
  "tha-ap222:1.1": "piyadassissa bhagavato ",
  "tha-ap222:1.2": "caṅkamaṃ sodhitaṃ mayā ",
  "tha-ap222:1.3": "naḷakehi paṭicchannaṃ ",
  "tha-ap222:1.4": "vātātapanivāraṇaṃ. ",
  "tha-ap222:2.1": "pāpaṃ vivajjanatthāya ",
  "tha-ap222:2.2": "kusalassūpasampadā ",
  "tha-ap222:2.3": "kilesānaṃ pahānāya ",
  "tha-ap222:2.4": "padahiṃ satthusāsane. ",
  "tha-ap222:3.1": "ito ekādase kappe ",
  "tha-ap222:3.2": "aggitejoti vissuto ",
  "tha-ap222:3.3": "sattaratanasampanno ",
  "tha-ap222:3.4": "cakkavatti mahabbalo. ",
  "tha-ap222:4.1": "paṭisambhidā catasso ",
  "tha-ap222:4.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap222:4.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap222:5.1": "itthaṃ sudaṃ āyasmā pāpanivāriyo thero imā gāthāyo abhāsitthāti. ",
  "tha-ap222:6.1": "pāpanivāriyattherassa apadānaṃ samattaṃ. uddānaṃ hatthi pānadhi saccañca ekasaññi ca raṃsiyo sandhito tālavaṇṭi ca tathā akkantasaññako sappi pāpanivārī ca catupaññāsa gāthakāti. ",
  "tha-ap222:7.1": "hatthivaggo bāvīsatimo. ",
