  "tha-ap234:0.1": "",
  "tha-ap234:0.2": "",
  "tha-ap234:0.3": "",
  "tha-ap234:1.1": "nagare bandhumatiyā ",
  "tha-ap234:1.2": "kumbhakāro ahaṃ tadā ",
  "tha-ap234:1.3": "bhājanaṃ anupālesiṃ ",
  "tha-ap234:1.4": "bhikkhusaṅghassa tāvade. ",
  "tha-ap234:2.1": "ekanavutito kappe ",
  "tha-ap234:2.2": "bhājanaṃ anupālayiṃ ",
  "tha-ap234:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap234:2.4": "bhājanassa idaṃ phalaṃ. ",
  "tha-ap234:3.1": "tepaññāse ito kappe ",
  "tha-ap234:3.2": "anantajalināmako ",
  "tha-ap234:3.3": "sattaratanasampanno ",
  "tha-ap234:3.4": "cakkavatti mahabbalo. ",
  "tha-ap234:4.1": "paṭisambhidā catasso ",
  "tha-ap234:4.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap234:4.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap234:5.1": "itthaṃ sudaṃ āyasmā bhājanadāyako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap234:6.1": "bhājanadāyakattherassa apadānaṃ samattaṃ. tatiyaṃ sālapupphiyattherāpadānaṃ (233) "
}
