{
  "tha-ap268:0.1": "",
  "tha-ap268:0.2": "",
  "tha-ap268:0.3": "",
  "tha-ap268:1.1": "candabhāgānadītīre ahosiṃ ",
  "tha-ap268:1.2": "ukkuso tadā ",
  "tha-ap268:1.3": "mahantaṃ macchaṃ paggayha ",
  "tha-ap268:1.4": "siddhatthassa munino adaṃ. ",
  "tha-ap268:2.1": "catunavute ito kappe ",
  "tha-ap268:2.2": "yaṃ macchamadadiṃ tadā ",
  "tha-ap268:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap268:2.4": "macchadānassidaṃ phalaṃ. ",
  "tha-ap268:3.1": "paṭisambhidā catasso ",
  "tha-ap268:3.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap268:3.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap268:4.1": "itthaṃ sudaṃ āyasmā macchadāyako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap268:5.1": "macchadāyakattherassa apadānaṃ samattaṃ. sattamaṃ javahaṃsakattherāpadānaṃ (267) "
}
