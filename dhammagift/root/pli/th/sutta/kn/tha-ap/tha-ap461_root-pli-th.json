{
  "tha-ap461:0.1": "",
  "tha-ap461:0.2": "",
  "tha-ap461:0.3": "",
  "tha-ap461:1.1": "nīharante sarīramhi ",
  "tha-ap461:1.2": "vijjamānāsu bherisu ",
  "tha-ap461:1.3": "pasannacitto sumano ",
  "tha-ap461:1.4": "sattipupphaṃ apūjayiṃ. ",
  "tha-ap461:2.1": "satasahasse ito kappe ",
  "tha-ap461:2.2": "yaṃ pupphaṃ abhipūjayiṃ ",
  "tha-ap461:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap461:2.4": "dehapūjāyidaṃ phalaṃ. ",
  "tha-ap461:3.1": "kilesā jhāpitā mayhaṃ ",
  "tha-ap461:3.2": "bhavā sabbe samūhatā nāgova bandhanaṃ chetvā ",
  "tha-ap461:3.3": "viharāmi anāsavo. ",
  "tha-ap461:4.1": "svāgataṃ vata me āsi ",
  "tha-ap461:4.2": "mama buddhassa santike tisso vijjā anuppattā ",
  "tha-ap461:4.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap461:5.1": "paṭisambhidā catasso ",
  "tha-ap461:5.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap461:5.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap461:6.1": "itthaṃ sudaṃ āyasmā sattipaṇṇiyo thero imā gāthāyo abhāsitthāti. ",
  "tha-ap461:7.1": "sattipaṇṇiyattherassa apadānaṃ samattaṃ. dasamaṃ gandhapūjakattherāpadānaṃ (460) "
}
