{
  "tha-ap205:0.1": "",
  "tha-ap205:0.2": "",
  "tha-ap205:0.3": "",
  "tha-ap205:1.1": "kañcanagghiyasaṅkāso ",
  "tha-ap205:1.2": "sabbaññū lokanāyako ",
  "tha-ap205:1.3": "odakaṃ dahamoggayha ",
  "tha-ap205:1.4": "sināyi lokanāyako. ",
  "tha-ap205:2.1": "paggayha kiṃkaṇipupphaṃ ",
  "tha-ap205:2.2": "vipassissābhiropayiṃ ",
  "tha-ap205:2.3": "udaggacitto sumano ",
  "tha-ap205:2.4": "dipadindassa tādino. ",
  "tha-ap205:3.1": "ekanavute ito kappe ",
  "tha-ap205:3.2": "yaṃ pupphamabhiropayiṃ ",
  "tha-ap205:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap205:3.4": "buddhapūjāyidaṃ phalaṃ. ",
  "tha-ap205:4.1": "sattavīsatikappamhi ",
  "tha-ap205:4.2": "rājā bhimaratho ahu ",
  "tha-ap205:4.3": "sattaratanasampanno ",
  "tha-ap205:4.4": "cakkavatti mahabbalo. ",
  "tha-ap205:5.1": "paṭisambhidā catasso ",
  "tha-ap205:5.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap205:5.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap205:6.1": "itthaṃ sudaṃ āyasmā kiṃkaṇikapupphiyo thero imā gāthāyo abhāsitthāti. ",
  "tha-ap205:7.1": "kiṃkaṇikapupphiyattherassa apadānaṃ samattaṃ. catutthaṃ taraṇiyattherāpadānaṃ (204) "
}
