{
  "tha-ap455:0.1": "",
  "tha-ap455:0.2": "",
  "tha-ap455:0.3": "",
  "tha-ap455:1.1": "tissassāhaṃ bhagavato ",
  "tha-ap455:1.2": "bodhirukkhaṃ avandihaṃ ",
  "tha-ap455:1.3": "paggayha vījaniṃ tattha ",
  "tha-ap455:1.4": "sīhāsanamavijjahaṃ. ",
  "tha-ap455:2.1": "dvenavute ito kappe ",
  "tha-ap455:2.2": "sīhāsanamavijjahaṃ ",
  "tha-ap455:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap455:2.4": "vījanāya idaṃ phalaṃ. ",
  "tha-ap455:3.1": "kilesā jhāpitā mayhaṃ ",
  "tha-ap455:3.2": "bhavā sabbe samūhatā nāgova bandhanaṃ chetvā ",
  "tha-ap455:3.3": "viharāmi anāsavo. ",
  "tha-ap455:4.1": "svāgataṃ vata me āsi ",
  "tha-ap455:4.2": "mama buddhassa santike tisso vijjā anuppattā ",
  "tha-ap455:4.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap455:5.1": "paṭisambhidā catasso ",
  "tha-ap455:5.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap455:5.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap455:6.1": "itthaṃ sudaṃ āyasmā sīhāsanabījiyo thero imā gāthāyo abhāsitthāti. ",
  "tha-ap455:7.1": "sīhāsanabījiyattherassa apadānaṃ samattaṃ. catutthaṃ tiṇukkadhāriyattherāpadānaṃ (454) "
}
