{
  "tha-ap53:0.1": "chaṭṭho vījanīvaggo ",
  "tha-ap53:0.2": "",
  "tha-ap53:0.3": "",
  "tha-ap53:1.1": "paṭhamaṃ vidhūpanadāyakattherāpadānaṃ (51) padumuttarabuddhassa ",
  "tha-ap53:1.2": "lokajeṭṭhassa tādino ",
  "tha-ap53:1.3": "vījanekā mayā dinnā ",
  "tha-ap53:1.4": "dipadindassa tādino. ",
  "tha-ap53:2.1": "sakaṃ cittaṃ pasādetvā ",
  "tha-ap53:2.2": "paggahetvāna añjaliṃ ",
  "tha-ap53:2.3": "sambuddhaṃ abhivāditvā ",
  "tha-ap53:2.4": "pakkāmi uttarāmukho. ",
  "tha-ap53:3.1": "vījaniṃ paggahetvāna ",
  "tha-ap53:3.2": "satthā lokagganāyako ",
  "tha-ap53:3.3": "bhikkhusaṅghe ṭhito santo ",
  "tha-ap53:3.4": "imā gāthā abhāsatha. ",
  "tha-ap53:4.1": "iminā vījanidānena ",
  "tha-ap53:4.2": "cittassa paṇidhīhi ca ",
  "tha-ap53:4.3": "kappānaṃ satasahassaṃ ",
  "tha-ap53:4.4": "vinipātaṃ na gacchati. ",
  "tha-ap53:5.1": "āraddhaviriyo pahitatto ",
  "tha-ap53:5.2": "cetoguṇasamāhito ",
  "tha-ap53:5.3": "jātiyā sattavassohaṃ ",
  "tha-ap53:5.4": "arahattaṃ apāpuṇiṃ. ",
  "tha-ap53:6.1": "saṭṭhikappasahassamhi ",
  "tha-ap53:6.2": "bijjamānasanāmakā ",
  "tha-ap53:6.3": "soḷasāsiṃsu rājāno ",
  "tha-ap53:6.4": "cakkavattī mahabbalā. ",
  "tha-ap53:7.1": "paṭisambhidā catasso ",
  "tha-ap53:7.2": "vimokkhāpica aṭṭhime ",
  "tha-ap53:7.3": "chaḷabhiññā sacchikatā ",
  "tha-ap53:7.4": "kataṃ buddhassa sāsananti. ",
  "tha-ap53:8.1": "itthaṃ sudaṃ āyasmā vidhūpanadāyako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap53:9.1": "vidhūpanadāyakattherassa apadānaṃ samattaṃ. dutiyaṃ sataraṃsiyattherāpadānaṃ (52) "
}
