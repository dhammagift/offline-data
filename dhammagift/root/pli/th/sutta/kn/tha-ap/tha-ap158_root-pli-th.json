  "tha-ap158:0.1": "",
  "tha-ap158:0.2": "",
  "tha-ap158:0.3": "",
  "tha-ap158:1.1": "himavantassavidūre ",
  "tha-ap158:1.2": "kukkuṭo nāma pabbato ",
  "tha-ap158:1.3": "tamhi pabbatapādamhi ",
  "tha-ap158:1.4": "satta buddhā vasanti te. ",
  "tha-ap158:2.1": "kadambaṃ pupphitaṃ disvā ",
  "tha-ap158:2.2": "dīparājaṃva uggataṃ ",
  "tha-ap158:2.3": "ubhohatthehi paggayha ",
  "tha-ap158:2.4": "satta buddhe samokiriṃ. ",
  "tha-ap158:3.1": "catunavute ito kappe ",
  "tha-ap158:3.2": "yaṃ pupphamabhiropayiṃ ",
  "tha-ap158:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap158:3.4": "buddhapūjāyidaṃ phalaṃ. ",
  "tha-ap158:4.1": "dvenavute ito kappe ",
  "tha-ap158:4.2": "sattāsuṃ pupphanāmakā ",
  "tha-ap158:4.3": "sattaratanasampannā ",
  "tha-ap158:4.4": "cakkavattī mahabbalā. ",
  "tha-ap158:5.1": "paṭisambhidā catasso ",
  "tha-ap158:5.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap158:5.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap158:6.1": "itthaṃ sudaṃ āyasmā kadambapupphiyo thero imā gāthāyo abhāsitthāti. ",
  "tha-ap158:7.1": "kadambapupphiyattherassa apadānaṃ samattaṃ. sattamaṃ tiṇasūlakattherāpadānaṃ (157) "
}
