{
  "tha-ap143:0.1": "pannarasamo chattavaggo ",
  "tha-ap143:0.2": "sobhitavaggo cuddasamo ",
  "tha-ap143:0.3": "",
  "tha-ap143:1.1": "paṭhamaṃ adhichattiyattherāpadānaṃ (141) parinibbute bhagavati ",
  "tha-ap143:1.2": "atthadassīnaruttame ",
  "tha-ap143:1.3": "chattātichattaṃ kāretvā ",
  "tha-ap143:1.4": "thūpamhi abhiropayiṃ. ",
  "tha-ap143:2.1": "kālena kālaṃ āgantvā ",
  "tha-ap143:2.2": "namassiṃ lokanāyakaṃ ",
  "tha-ap143:2.3": "pupphacchadanaṃ katvāna ",
  "tha-ap143:2.4": "chattamhi abhiropayiṃ. ",
  "tha-ap143:3.1": "sattarase kappasate ",
  "tha-ap143:3.2": "devarajjamakārayiṃ ",
  "tha-ap143:3.3": "manussattaṃ na gacchāmi ",
  "tha-ap143:3.4": "thūpapūjāyidaṃ phalaṃ. ",
  "tha-ap143:4.1": "paṭisambhidā catasso ",
  "tha-ap143:4.2": "vimokkhāpica aṭṭhime ",
  "tha-ap143:4.3": "chaḷabhiññā sacchikatā ",
  "tha-ap143:4.4": "kataṃ buddhassa sāsananti. ",
  "tha-ap143:5.1": "itthaṃ sudaṃ āyasmā adhichattiyo thero imā gāthāyo abhāsitthāti. ",
  "tha-ap143:6.1": "adhichattiyattherassa apadānaṃ samattaṃ. dutiyaṃ thambhāropakattherāpadānaṃ (142) "
}
