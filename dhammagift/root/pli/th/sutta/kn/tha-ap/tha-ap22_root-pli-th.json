{
  "tha-ap22:0.1": "",
  "tha-ap22:0.2": "",
  "tha-ap22:0.3": "",
  "tha-ap22:1.1": "āhutiṃ yiṭṭhukāmohaṃ ",
  "tha-ap22:1.2": "paṭiyādetvāna bhojanaṃ ",
  "tha-ap22:1.3": "brāhmaṇe paṭimānento ",
  "tha-ap22:1.4": "visāle māḷake ṭhito. ",
  "tha-ap22:2.1": "athaddasāsiṃ sambuddhaṃ ",
  "tha-ap22:2.2": "piyadassiṃ mahāyasaṃ ",
  "tha-ap22:2.3": "sabbalokaṃ vinetāraṃ ",
  "tha-ap22:2.4": "sayambhuṃ aggapuggalaṃ. ",
  "tha-ap22:3.1": "bhagavantaṃ jutimantaṃ ",
  "tha-ap22:3.2": "sāvakehi purakkhataṃ ",
  "tha-ap22:3.3": "ādiccamiva rocantaṃ ",
  "tha-ap22:3.4": "rathiyaṃ paṭipannakaṃ. ",
  "tha-ap22:4.1": "añjaliṃ paggahetvāna ",
  "tha-ap22:4.2": "sakaṃ cittaṃ pasādayiṃ ",
  "tha-ap22:4.3": "manasāva nimantesiṃ ",
  "tha-ap22:4.4": "āgacchatu mahāmuni. ",
  "tha-ap22:5.1": "mama saṅkappamaññāya ",
  "tha-ap22:5.2": "satthā loke anuttaro ",
  "tha-ap22:5.3": "khīṇāsavasahassehi ",
  "tha-ap22:5.4": "mama dvāraṃ upāgami. ",
  "tha-ap22:6.1": "namo te purisājañña ",
  "tha-ap22:6.2": "namo te purisuttama ",
  "tha-ap22:6.3": "pāsādaṃ abhirūhitvā ",
  "tha-ap22:6.4": "sīhāsane nisīdatu. ",
  "tha-ap22:7.1": "danto dantaparivāro ",
  "tha-ap22:7.2": "tiṇṇo tārayataṃ varo ",
  "tha-ap22:7.3": "pāsādaṃ abhirūhitvā ",
  "tha-ap22:7.4": "nisīdi pavarāsane. ",
  "tha-ap22:8.1": "yaṃ me atthi sake gehe ",
  "tha-ap22:8.2": "āmisaṃ paccupaṭṭhitaṃ ",
  "tha-ap22:8.3": "tāhaṃ buddhassa pādāsiṃ ",
  "tha-ap22:8.4": "pasanno sehi pāṇibhi. ",
  "tha-ap22:9.1": "pasannacitto sumano ",
  "tha-ap22:9.2": "vedajāto katañjalī ",
  "tha-ap22:9.3": "buddhaseṭṭhaṃ namassāmi ",
  "tha-ap22:9.4": "aho buddhassuḷāratā. ",
  "tha-ap22:10.1": "aṭṭhannaṃ payirupāsataṃ ",
  "tha-ap22:10.2": "bhuñjaṃ khīṇāsavā bahū ",
  "tha-ap22:10.3": "tuyheveso ānubhāvo ",
  "tha-ap22:10.4": "saraṇantaṃ upemahaṃ. ",
  "tha-ap22:11.1": "piyadassī ca bhagavā ",
  "tha-ap22:11.2": "lokajeṭṭho narāsabho ",
  "tha-ap22:11.3": "bhikkhusaṅghe nisīditvā ",
  "tha-ap22:11.4": "imā gāthā abhāsatha. ",
  "tha-ap22:12.1": "yo so saṅghaṃ abhojesi ",
  "tha-ap22:12.2": "ujubhūtaṃ samāhitaṃ ",
  "tha-ap22:12.3": "tathāgatañca sambuddhaṃ ",
  "tha-ap22:12.4": "suṇātha mama bhāsato. ",
  "tha-ap22:13.1": "sattavīsatikkhattuṃ so ",
  "tha-ap22:13.2": "devarajjaṃ karissati ",
  "tha-ap22:13.3": "sakakammābhiraddho so ",
  "tha-ap22:13.4": "devaloke ramissati. ",
  "tha-ap22:14.1": "dasa ca aṭṭhakkhattuṃ so ",
  "tha-ap22:14.2": "cakkavatti bhavissati ",
  "tha-ap22:14.3": "paṭhabyā rajjaṃ pañcasataṃ ",
  "tha-ap22:14.4": "vasudhaṃ āvasissati. ",
  "tha-ap22:15.1": "araññaṃ vanamoggayha ",
  "tha-ap22:15.2": "kānanaṃ byagghasevitaṃ ",
  "tha-ap22:15.3": "padhānaṃ padahitvāna ",
  "tha-ap22:15.4": "kilesā jhāpitā mayā. ",
  "tha-ap22:16.1": "aṭṭhārase kappasate ",
  "tha-ap22:16.2": "yaṃ dānamadadiṃ tadā ",
  "tha-ap22:16.3": "duggatiṃ nābhijānāmi ",
  "tha-ap22:16.4": "bhattadānassidaṃ phalaṃ. ",
  "tha-ap22:17.1": "paṭisambhidā catasso ",
  "tha-ap22:17.2": "vimokkhāpica aṭṭhime ",
  "tha-ap22:17.3": "chaḷabhiññā sacchikatā ",
  "tha-ap22:17.4": "kataṃ buddhassa sāsananti. ",
  "tha-ap22:18.1": "itthaṃ sudaṃ āyasmā sumaṅgalo thero imā gāthāyo abhāsitthāti. ",
  "tha-ap22:19.1": "sumaṅgalattherassa apadānaṃ samattaṃ. ",
  "tha-ap22:20.1": "uddānaṃ ",
  "tha-ap22:21.1": "sīhāsanī ekatthambhī ",
  "tha-ap22:21.2": "nando ca cullapanthako ",
  "tha-ap22:21.3": "pilindarāhulo ceva ",
  "tha-ap22:21.4": "vaṅganto raṭṭhapālako. ",
  "tha-ap22:22.1": "sopāko maṅgalo ceva ",
  "tha-ap22:22.2": "daseva dutiye vagge ",
  "tha-ap22:22.3": "satañca sattatiṃsā ca ",
  "tha-ap22:22.4": "gāthā cettha pakāsitā. ",
  "tha-ap22:23.1": "sīhāsaniyavaggo dutiyo. "
}
