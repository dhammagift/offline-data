  "tha-ap160:0.1": "",
  "tha-ap160:0.2": "",
  "tha-ap160:0.3": "",
  "tha-ap160:1.1": "suvaccho nāma nāmena ",
  "tha-ap160:1.2": "brāhmaṇo mantapāragū ",
  "tha-ap160:1.3": "purakkhato sasissehi ",
  "tha-ap160:1.4": "vasati pabbatantare. ",
  "tha-ap160:2.1": "padumuttaro nāma jino ",
  "tha-ap160:2.2": "āhutīnaṃ paṭiggaho ",
  "tha-ap160:2.3": "mamuddharitukāmo so ",
  "tha-ap160:2.4": "āgañchi mama santikaṃ. ",
  "tha-ap160:3.1": "vehāyase caṅkamati ",
  "tha-ap160:3.2": "dīpo pajjalite tathā ",
  "tha-ap160:3.3": "hāsaṃ mamaṃ viditvāna ",
  "tha-ap160:3.4": "pakkāmi pācināmukho. ",
  "tha-ap160:4.1": "tañca acchariyaṃ disvā ",
  "tha-ap160:4.2": "abbhūtaṃ lomahaṃsanaṃ ",
  "tha-ap160:4.3": "nāgapupphaṃ gahetvāna ",
  "tha-ap160:4.4": "gatamaggamhi okiriṃ. ",
  "tha-ap160:5.1": "satasahasse ito kappe ",
  "tha-ap160:5.2": "yaṃ pupphaṃ okiriṃ ahaṃ ",
  "tha-ap160:5.3": "tena cittappasādena ",
  "tha-ap160:5.4": "duggatiṃ nūpapajjahaṃ. ",
  "tha-ap160:6.1": "ekatiṃse ito kappe ",
  "tha-ap160:6.2": "rājā āsiṃ mahāratho ",
  "tha-ap160:6.3": "sattaratanasampanno ",
  "tha-ap160:6.4": "cakkavatti mahabbalo. ",
  "tha-ap160:7.1": "paṭisambhidā catasso ",
  "tha-ap160:7.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap160:7.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap160:8.1": "itthaṃ sudaṃ āyasmā nāgapupphiyo thero imā gāthāyo abhāsitthāti. ",
  "tha-ap160:9.1": "nāgapupphiyattherassa apadānaṃ samattaṃ. navamaṃ punnāgapupphiyattherāpadānaṃ (159) "
}
