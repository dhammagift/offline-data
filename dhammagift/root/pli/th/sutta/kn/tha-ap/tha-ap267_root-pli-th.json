{
  "tha-ap267:0.1": "",
  "tha-ap267:0.2": "",
  "tha-ap267:0.3": "",
  "tha-ap267:1.1": "himavantassa avidūre ",
  "tha-ap267:1.2": "romaso nāma pabbato ",
  "tha-ap267:1.3": "tamhi pabbatapādamhi ",
  "tha-ap267:1.4": "samaṇo bhāvitindriyo. ",
  "tha-ap267:2.1": "viḷāliyo gahetvāna ",
  "tha-ap267:2.2": "samaṇassa adāsahaṃ ",
  "tha-ap267:2.3": "anumodi mahāvīro ",
  "tha-ap267:2.4": "sayambhū aparājito. ",
  "tha-ap267:3.1": "viḷāli te mama dinnā ",
  "tha-ap267:3.2": "vippasannena cetasā ",
  "tha-ap267:3.3": "bhave nibbattamānamhi ",
  "tha-ap267:3.4": "phalaṃ nibbattataṃ tava. ",
  "tha-ap267:4.1": "catunavute ito kappe ",
  "tha-ap267:4.2": "yaṃ viḷālimadāsahaṃ ",
  "tha-ap267:4.3": "duggatiṃ nābhijānāmi ",
  "tha-ap267:4.4": "viḷāliyā idaṃ phalaṃ. ",
  "tha-ap267:5.1": "paṭisambhidā catasso ",
  "tha-ap267:5.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap267:5.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap267:6.1": "itthaṃ sudaṃ āyasmā viḷālidāyako thero imā gāthāyocha abhāsitthāti. ",
  "tha-ap267:7.1": "viḷālidāyakattherassa apadānaṃ samattaṃ. chaṭṭhaṃ macchadāyakattherāpadānaṃ (266) "
}
