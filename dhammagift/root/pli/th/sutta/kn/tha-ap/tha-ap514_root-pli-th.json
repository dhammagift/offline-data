{
  "tha-ap514:0.1": "",
  "tha-ap514:0.2": "",
  "tha-ap514:0.3": "",
  "tha-ap514:1.1": "suvaṇṇavaṇṇaṃ sambuddhaṃ ",
  "tha-ap514:1.2": "āhutīnaṃ paṭiggahaṃ ",
  "tha-ap514:1.3": "rathiyaṃ paṭipajjantaṃ ",
  "tha-ap514:1.4": "kapiṭṭhaṃ adadiṃ phalaṃ. ",
  "tha-ap514:2.1": "ekanavute ito kappe ",
  "tha-ap514:2.2": "yaṃ phalaṃ adadiṃ tadā ",
  "tha-ap514:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap514:2.4": "phaladānassidaṃ phalaṃ. ",
  "tha-ap514:3.1": "kilesā jhāpitā mayhaṃ ",
  "tha-ap514:3.2": "bhavā sabbe samūhatā nāgova bandhanaṃ chetvā ",
  "tha-ap514:3.3": "viharāmi anāsavo. ",
  "tha-ap514:4.1": "svāgataṃ vata me āsi ",
  "tha-ap514:4.2": "mama buddhassa santike tisso vijjā anuppattā ",
  "tha-ap514:4.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap514:5.1": "paṭisambhidā catasso ",
  "tha-ap514:5.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap514:5.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap514:6.1": "itthaṃ sudaṃ āyasmā kapiṭṭhaphaladāyako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap514:7.1": "kapiṭṭhaphaladāyakattherassa apadānaṃ samattaṃ. tatiyaṃ kosumbaphaliyattherāpadānaṃ (513) "
}
