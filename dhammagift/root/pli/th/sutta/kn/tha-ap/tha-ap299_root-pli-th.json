{
  "tha-ap299:0.1": "",
  "tha-ap299:0.2": "",
  "tha-ap299:0.3": "",
  "tha-ap299:1.1": "upasālhakanāmohaṃ ",
  "tha-ap299:1.2": "ahosiṃ brāhmaṇo tadā ",
  "tha-ap299:1.3": "kānanaṃ vanamogayha ",
  "tha-ap299:1.4": "lokanāthaṃ narāsabhaṃ. ",
  "tha-ap299:2.1": "disvāna vandi pādesu ",
  "tha-ap299:2.2": "lokāhutipaṭiggahaṃ ",
  "tha-ap299:2.3": "pasannacittaṃ maṃ ñatvā ",
  "tha-ap299:2.4": "buddho antaradhāyatha. ",
  "tha-ap299:3.1": "kānanā abhinikkhamma ",
  "tha-ap299:3.2": "buddhaseṭṭhaṃ ",
  "tha-ap299:3.3": "anussariṃ tandesaṃ kittayitvāna ",
  "tha-ap299:3.4": "kappaṃ saggamhi modahaṃ. ",
  "tha-ap299:4.1": "dvenavute ito kappe ",
  "tha-ap299:4.2": "yaṃ desamabhikittayiṃ ",
  "tha-ap299:4.3": "duggatiṃ nābhijānāmi ",
  "tha-ap299:4.4": "kittanāya idaṃ phalaṃ. ",
  "tha-ap299:5.1": "paṭisambhidā catasso ",
  "tha-ap299:5.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap299:5.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap299:6.1": "itthaṃ sudaṃ āyasmā desakittiko thero imā gāthāyo abhāsitthāti. ",
  "tha-ap299:7.1": "desakittikattherassa apadānaṃ samattaṃ. aṭṭhamaṃ saraṇagamaniyattherāpadānaṃ (298) "
}
