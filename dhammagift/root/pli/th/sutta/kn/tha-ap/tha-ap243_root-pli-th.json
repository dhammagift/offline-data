{
  "tha-ap243:0.1": "pañcavīso tuvaradāyivaggo ",
  "tha-ap243:0.2": "",
  "tha-ap243:0.3": "",
  "tha-ap243:1.1": "paṭhamaṃ tuvaraṭṭhidāyakattherāpadānaṃ (241) migaluddho pure āsiṃ ",
  "tha-ap243:1.2": "araññe kānane mahā taṃ ",
  "tha-ap243:1.3": "disvā rudhiramādāya ",
  "tha-ap243:1.4": "saṅghassa adadiṃ ahaṃ. ",
  "tha-ap243:2.1": "ekanavute ito kappe ",
  "tha-ap243:2.2": "yaṃ dānamadadiṃ tadā ",
  "tha-ap243:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap243:2.4": "tuvaraṭṭhissidaṃ phalaṃ. ",
  "tha-ap243:3.1": "paṭisambhidā catasso ",
  "tha-ap243:3.2": "vimokkhāpica aṭṭhime ",
  "tha-ap243:3.3": "chaḷabhiññā sacchikatā ",
  "tha-ap243:3.4": "kataṃ buddhassa sāsananti. ",
  "tha-ap243:4.1": "itthaṃ sudaṃ āyasmā tuvaraṭṭhidāyako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap243:5.1": "tuvaraṭṭhidāyakattherassa apadānaṃ samattaṃ. dutiyaṃ nāgakesariyattherāpadānaṃ (242) "
}
