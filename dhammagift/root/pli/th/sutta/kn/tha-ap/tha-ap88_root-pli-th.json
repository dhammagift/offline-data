  "tha-ap88:0.2": "",
  "tha-ap88:0.3": "",
  "tha-ap88:1.1": "pabbate himavantamhi ",
  "tha-ap88:1.2": "vākacīradharo ahaṃ ",
  "tha-ap88:1.3": "caṅkamaṃ ca samāruḷho ",
  "tha-ap88:1.4": "nisīdiṃ pācināmukho. ",
  "tha-ap88:2.1": "pabbate sugataṃ disvā ",
  "tha-ap88:2.2": "phussaṃ jhānarataṃ sadā ",
  "tha-ap88:2.3": "añjaliṃ paggahetvāna ",
  "tha-ap88:2.4": "raṃse cittaṃ pasādayiṃ. ",
  "tha-ap88:3.1": "dvenavute ito kappe ",
  "tha-ap88:3.2": "yaṃ kammamakariṃ tadā ",
  "tha-ap88:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap88:3.4": "raṃsisaññāyidaṃ phalaṃ. ",
  "tha-ap88:4.1": "paṭisambhidā catasso ",
  "tha-ap88:4.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap88:4.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap88:5.1": "itthaṃ sudaṃ āyasmā raṃsisaññiko thero imā gāthāyo abhāsitthāti. ",
  "tha-ap88:6.1": "raṃsisaññikattherassa apadānaṃ samattaṃ. sattamaṃ phaladāyakattherāpadānaṃ (87) "
}
