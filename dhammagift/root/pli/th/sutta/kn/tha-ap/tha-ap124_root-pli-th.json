{
  "tha-ap124:0.1": "",
  "tha-ap124:0.2": "",
  "tha-ap124:0.3": "",
  "tha-ap124:1.1": "himavantassa avidūre ",
  "tha-ap124:1.2": "kukkuro nāma pabbato ",
  "tha-ap124:1.3": "vemajjhe tassa vasati ",
  "tha-ap124:1.4": "brāhmaṇo mantapāragū. ",
  "tha-ap124:2.1": "pañca sissasahassāni ",
  "tha-ap124:2.2": "parivārenti maṃ sadā ",
  "tha-ap124:2.3": "pubbuṭṭhāyī ca te āsuṃ ",
  "tha-ap124:2.4": "mantesu ca visāradā. ",
  "tha-ap124:3.1": "buddho loke samuppanno ",
  "tha-ap124:3.2": "taṃ vijānātha no bhavaṃ ",
  "tha-ap124:3.3": "asīti byañjanānassa ",
  "tha-ap124:3.4": "battiṃsa varalakkhaṇā. ",
  "tha-ap124:4.1": "byāmappabho jinavaro ",
  "tha-ap124:4.2": "ādiccova virocati ",
  "tha-ap124:4.3": "sissānaṃ vacanaṃ sutvā ",
  "tha-ap124:4.4": "brāhmaṇo mantapāragū. ",
  "tha-ap124:5.1": "assamā abhinikkhamma ",
  "tha-ap124:5.2": "disaṃ pucchati brāhmaṇo ",
  "tha-ap124:5.3": "yamhi dese mahāvīro ",
  "tha-ap124:5.4": "vasati lokanāyako. ",
  "tha-ap124:6.1": "tāhaṃ disvā namassissaṃ ",
  "tha-ap124:6.2": "jinaṃ appaṭipuggalaṃ ",
  "tha-ap124:6.3": "udaggacitto sumano ",
  "tha-ap124:6.4": "pūjesiṃ taṃ gatathātaṃ. ",
  "tha-ap124:7.1": "etha sissā gamissāma ",
  "tha-ap124:7.2": "dakkhissāma tathāgataṃ ",
  "tha-ap124:7.3": "vanditvā satthuno pāde ",
  "tha-ap124:7.4": "sossāma jinasāsanaṃ. ",
  "tha-ap124:8.1": "ekāhaṃ abhinikkhamma ",
  "tha-ap124:8.2": "byādhiṃ paṭilabhiṃ ahaṃ ",
  "tha-ap124:8.3": "byādhinā pīḷito santo ",
  "tha-ap124:8.4": "sālanto sayituṃ gamiṃ. ",
  "tha-ap124:9.1": "sabbe sisse samānetvā ",
  "tha-ap124:9.2": "apucchiṃ te tathāgataṃ ",
  "tha-ap124:9.3": "kīdisaṃ lokanāthassa ",
  "tha-ap124:9.4": "guṇaṃ paramabuddhino. ",
  "tha-ap124:10.1": "te me puṭṭhā byākariṃsu ",
  "tha-ap124:10.2": "yathā dassāvino tathā ",
  "tha-ap124:10.3": "sakkaccaṃ buddhaseṭṭhaṃ taṃ ",
  "tha-ap124:10.4": "dassesuṃ mama sammukhā. ",
  "tha-ap124:11.1": "tesāhaṃ vacanaṃ sutvā ",
  "tha-ap124:11.2": "sakaṃ cittaṃ pasādayiṃ ",
  "tha-ap124:11.3": "pupphehi thūpaṃ karitvāna ",
  "tha-ap124:11.4": "tattha kālaṃ kato ahaṃ. ",
  "tha-ap124:12.1": "te me sarīraṃ jhāpetvā ",
  "tha-ap124:12.2": "agamama buddhasantike ",
  "tha-ap124:12.3": "añjaliṃ paggahitvāna satthāraṃ ",
  "tha-ap124:12.4": "abhivādayuṃ. ",
  "tha-ap124:13.1": "pupphehi thūpaṃ karitvāna ",
  "tha-ap124:13.2": "sugatassa mahesino ",
  "tha-ap124:13.3": "kappānaṃ satasahassaṃ ",
  "tha-ap124:13.4": "duggatiṃ nūpapajjahaṃ. ",
  "tha-ap124:14.1": "cattāḷīsasahassamhi ",
  "tha-ap124:14.2": "kappe soḷasa khattiyā ",
  "tha-ap124:14.3": "nāmenaggisamā nāma ",
  "tha-ap124:14.4": "cakkavattī mahabbalā. ",
  "tha-ap124:15.1": "vīsakappasahassamhi ",
  "tha-ap124:15.2": "rājāno cakkavattino ",
  "tha-ap124:15.3": "ghaṭāsanasamā nāma ",
  "tha-ap124:15.4": "aṭṭhattiṃsa mahīpatī ",
  "tha-ap124:16.1": "paṭisambhidā catasso ",
  "tha-ap124:16.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap124:16.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap124:17.1": "itthaṃ sudaṃ āyasmā pupphathūpiyo thero imā gāthāyo abhāsitthāti. ",
  "tha-ap124:18.1": "pupphathūpiyattherassa apadānaṃ samattaṃ. tatiyaṃ pāyāsadāyakattherāpadānaṃ (123) "
}
