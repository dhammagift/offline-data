{
  "tha-ap245:0.1": "",
  "tha-ap245:0.2": "",
  "tha-ap245:0.3": "",
  "tha-ap245:1.1": "jātassarassa vemajjhe ",
  "tha-ap245:1.2": "vasāmi jalakukkuṭo ",
  "tha-ap245:1.3": "athaddasaṃ devadevaṃ ",
  "tha-ap245:1.4": "gacchantaṃ anilañjase. ",
  "tha-ap245:2.1": "tuṇḍena kesaraṃ gayha ",
  "tha-ap245:2.2": "vippasannena cetasā ",
  "tha-ap245:2.3": "buddhassa abhiropesiṃ ",
  "tha-ap245:2.4": "tissassa lokabandhuno. ",
  "tha-ap245:3.1": "dvenavute ito kappe ",
  "tha-ap245:3.2": "yaṃ pupphamabhipūjayiṃ ",
  "tha-ap245:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap245:3.4": "buddhapūjāyidaṃ phalaṃ. ",
  "tha-ap245:4.1": "tesattatimhi kappamhi ",
  "tha-ap245:4.2": "sattapattasanāmako sattaratanasampanno ",
  "tha-ap245:4.3": "",
  "tha-ap245:4.4": "cakkavatti mahabbalo. ",
  "tha-ap245:5.1": "paṭisambhidā catasso ",
  "tha-ap245:5.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap245:5.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap245:6.1": "itthaṃ sudaṃ āyasmā naḷinakesariyo thero imā gāthāyo abhāsitthāti. ",
  "tha-ap245:7.1": "naḷinakesariyattherassa apadānaṃ samattaṃ. catutthaṃ viravipupphiyattherāpadānaṃ (244) "
}
