{
  "tha-ap388:0.1": "",
  "tha-ap388:0.2": "",
  "tha-ap388:0.3": "",
  "tha-ap388:1.1": "sabbe janā samāgamma ",
  "tha-ap388:1.2": "āgamiṃsu vanaṃ tadā ",
  "tha-ap388:1.3": "phalamanvesamānā te ",
  "tha-ap388:1.4": "alabhiṃsu phalaṃ tadā. ",
  "tha-ap388:2.1": "tatthaddasāsiṃ sambuddhaṃ ",
  "tha-ap388:2.2": "sayambhuṃ aparājitaṃ ",
  "tha-ap388:2.3": "pasannacitto sumano ",
  "tha-ap388:2.4": "valliphalamadāsahaṃ. ",
  "tha-ap388:3.1": "ekatiṃse ito kappe ",
  "tha-ap388:3.2": "yaṃ phalaṃ adadiṃ tadā ",
  "tha-ap388:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap388:3.4": "phaladānassidaṃ phalaṃ. ",
  "tha-ap388:4.1": "svāgataṃ vata me āsi mama buddhassa santike tisso vijjā anuppattā kataṃ buddhassa sāsanaṃ. kilesā jhāpitā mayhaṃ ",
  "tha-ap388:4.2": "bhavā sabbe samūhatā nāgova bandhanaṃ chetvā ",
  "tha-ap388:4.3": "viharāmi anāsavo. ",
  "tha-ap388:5.1": "",
  "tha-ap388:5.2": "",
  "tha-ap388:5.3": "",
  "tha-ap388:6.1": "paṭisambhidā catasso ",
  "tha-ap388:6.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap388:6.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap388:7.1": "itthaṃ sudaṃ āyasmā valliphaladāyako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap388:8.1": "valliphaladāyakattherassa apadānaṃ samattaṃ. sattamaṃ kadaliphaladāyakattherāpadānaṃ (387) "
}
