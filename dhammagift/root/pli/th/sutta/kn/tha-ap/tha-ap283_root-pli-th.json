{
  "tha-ap283:0.1": "ekūnatiṃso paṇṇadāyakavaggo ",
  "tha-ap283:0.2": "",
  "tha-ap283:0.3": "",
  "tha-ap283:1.1": "paṭhamaṃ paṇṇadāyakattherāpadānaṃ (281) paṇṇasāle nisinnomhi ",
  "tha-ap283:1.2": "paṇṇabhojanabhojano ",
  "tha-ap283:1.3": "upaviṭṭhañca maṃ santaṃ ",
  "tha-ap283:1.4": "upagañchi mahāisi. ",
  "tha-ap283:2.1": "siddhattho lokapajjoto ",
  "tha-ap283:2.2": "sabbalokatikicchako ",
  "tha-ap283:2.3": "tassa paṇṇaṃ mayā dinnaṃ ",
  "tha-ap283:2.4": "nisinnassa paṇṇasanthare. ",
  "tha-ap283:3.1": "catunavute ito kappe ",
  "tha-ap283:3.2": "yaṃ paṇṇamadadiṃ tadā ",
  "tha-ap283:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap283:3.4": "paṇṇadānassidaṃ phalaṃ. ",
  "tha-ap283:4.1": "paṭisambhidā catasso ",
  "tha-ap283:4.2": "vimokkhāpica aṭṭhime ",
  "tha-ap283:4.3": "chaḷabhiññā sacchikatā ",
  "tha-ap283:4.4": "kataṃ buddhassa sāsananti. ",
  "tha-ap283:5.1": "itthaṃ sudaṃ āyasmā paṇṇadāyako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap283:6.1": "paṇṇadāyakattherassa apadānaṃ samattaṃ. dutiyaṃ phaladāyakattherāpadānaṃ (282) "
}
