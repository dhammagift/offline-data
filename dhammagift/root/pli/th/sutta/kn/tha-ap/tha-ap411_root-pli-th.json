{
  "tha-ap411:0.1": "",
  "tha-ap411:0.2": "",
  "tha-ap411:0.3": "",
  "tha-ap411:1.1": "nagare haṃsavatiyā ",
  "tha-ap411:1.2": "seṭṭhiputto ahosahaṃ ",
  "tha-ap411:1.3": "samappito kāmaguṇehi ",
  "tha-ap411:1.4": "parivāremahaṃ tadā. ",
  "tha-ap411:2.1": "tayo pāsādamāruyha ",
  "tha-ap411:2.2": "mahābhoge valañjako ",
  "tha-ap411:2.3": "tattha naccehi gītehi ",
  "tha-ap411:2.4": "parivāremahaṃ tadā. ",
  "tha-ap411:3.1": "turiyā āhatā mayhaṃ ",
  "tha-ap411:3.2": "sammatālasamāhitā ",
  "tha-ap411:3.3": "rañjantī itthiyo sabbā ",
  "tha-ap411:3.4": "harantiyeva me mano. ",
  "tha-ap411:4.1": "celāvakā vāmanikā ",
  "tha-ap411:4.2": "kuñjavā sīhimajjhitā ",
  "tha-ap411:4.3": "laṅghikā sokajjhāyī ca ",
  "tha-ap411:4.4": "parivārenti maṃ sadā. ",
  "tha-ap411:5.1": "vetāḷino kumbhathūni ",
  "tha-ap411:5.2": "naṭā ca naccakā bahū ",
  "tha-ap411:5.3": "naṭakā nāṭakā ceva ",
  "tha-ap411:5.4": "parivārenti maṃ sadā. ",
  "tha-ap411:6.1": "kappakā nhāpakā sūdā ",
  "tha-ap411:6.2": "mālākārā supāsakā ",
  "tha-ap411:6.3": "jallā mallā ca te sabbe ",
  "tha-ap411:6.4": "parivārenti maṃ sadā. ",
  "tha-ap411:7.1": "etesu kīḷamānesu ",
  "tha-ap411:7.2": "sikkhite katupāsane ",
  "tha-ap411:7.3": "rattindivaṃ na jānāmi ",
  "tha-ap411:7.4": "indova tidase pure. ",
  "tha-ap411:8.1": "addhikā kapaṇā 7 sabbe ",
  "tha-ap411:8.2": "yācakā carakā bahū ",
  "tha-ap411:8.3": "upagacchanti te niccaṃ ",
  "tha-ap411:8.4": "bhikkhayantā mamaṃ gharaṃ. ",
  "tha-ap411:9.1": "samaṇā brāhmaṇā ceva ",
  "tha-ap411:9.2": "puññakkhettā anuttarā ",
  "tha-ap411:9.3": "vaḍḍhayantā mamaṃ puññaṃ ",
  "tha-ap411:9.4": "āgacchanti mamaṃ gharaṃ. ",
  "tha-ap411:10.1": "paṭakā laṭukā sabbe ",
  "tha-ap411:10.2": "niganthā pupphasāṭakā ",
  "tha-ap411:10.3": "tedaṇḍikā ekasikhā ",
  "tha-ap411:10.4": "āgacchanti mamaṃ gharaṃ. ",
  "tha-ap411:11.1": "ājīvikā viluttāvī ",
  "tha-ap411:11.2": "gotamā devadhammikā ",
  "tha-ap411:11.3": "rajojalladharā ete ",
  "tha-ap411:11.4": "āgacchanti mamaṃ gharaṃ. ",
  "tha-ap411:12.1": "parivattakā siddhipattā ",
  "tha-ap411:12.2": "kodhapugganikā bahū ",
  "tha-ap411:12.3": "tapasī vanacārī ca ",
  "tha-ap411:12.4": "āgacchanti mamaṃ gharaṃ. ",
  "tha-ap411:13.1": "andhakā damilā ceva ",
  "tha-ap411:13.2": "sākuḷā malayāḷakā ",
  "tha-ap411:13.3": "savarā yonakā ceva ",
  "tha-ap411:13.4": "āgacchanti mamaṃ gharaṃ. ",
  "tha-ap411:14.1": "gandhakā muṇḍakā sabbe ",
  "tha-ap411:14.2": "kuṭṭhalā sānuvindakā ārāva ",
  "tha-ap411:14.3": "cīnaraṭṭhā ca ",
  "tha-ap411:14.4": "āgacchanti mamaṃ gharaṃ. ",
  "tha-ap411:15.1": "alasandakā pallavakā ",
  "tha-ap411:15.2": "pabbatānaggamāruhā bāhikā ",
  "tha-ap411:15.3": "cetaputtā ca ",
  "tha-ap411:15.4": "āgacchanti mamaṃ gharaṃ. ",
  "tha-ap411:16.1": "madhurakā kosalakā ",
  "tha-ap411:16.2": "kāsikā hatthiporikā ",
  "tha-ap411:16.3": "isindā makkalā ceva ",
  "tha-ap411:16.4": "āgacchanti mamaṃ gharaṃ. ",
  "tha-ap411:17.1": "celāvakā ārambā ca ",
  "tha-ap411:17.2": "obhāsā meghalā bahū ",
  "tha-ap411:17.3": "khuddakā suddakā ceva ",
  "tha-ap411:17.4": "āgacchanti mamaṃ gharaṃ. ",
  "tha-ap411:18.1": "rohakā sindhavā ceva ",
  "tha-ap411:18.2": "cittakā ekakaṇṇikā ",
  "tha-ap411:18.3": "suraṭṭhā aparantā ca ",
  "tha-ap411:18.4": "āgacchanti mamaṃ gharaṃ. ",
  "tha-ap411:19.1": "suppārakā kumārā ca ",
  "tha-ap411:19.2": "malayā soṇṇabhūmikā ",
  "tha-ap411:19.3": "vajjihārā ca te sabbe ",
  "tha-ap411:19.4": "āgacchanti mamaṃ gharaṃ. ",
  "tha-ap411:20.1": "naḷakārā pesakārā ",
  "tha-ap411:20.2": "cammakārā ca tacchakā ",
  "tha-ap411:20.3": "kammakārā kumbhakārā ",
  "tha-ap411:20.4": "āgacchanti mamaṃ gharaṃ. ",
  "tha-ap411:21.1": "maṇikārā lohakārā ",
  "tha-ap411:21.2": "soṇṇakārā ca dussikā ",
  "tha-ap411:21.3": "tipukārā ca te sabbe ",
  "tha-ap411:21.4": "āgacchanti mamaṃ gharaṃ. ",
  "tha-ap411:22.1": "usukārā bhamakārā ",
  "tha-ap411:22.2": "pesakārā ca gandhikā ",
  "tha-ap411:22.3": "rajakā tunnavāyā ca ",
  "tha-ap411:22.4": "āgacchanti mamaṃ gharaṃ. ",
  "tha-ap411:23.1": "telikā kaṭṭhahārā ca ",
  "tha-ap411:23.2": "udahārā ca pesikā ",
  "tha-ap411:23.3": "supikā saradakkhā ca ",
  "tha-ap411:23.4": "āgacchanti mamaṃ gharaṃ. ",
  "tha-ap411:24.1": "dovārikā anīkatthā ",
  "tha-ap411:24.2": "ganthikā pupphachaḍḍakā ",
  "tha-ap411:24.3": "hatthārohā hatthipālā ",
  "tha-ap411:24.4": "āgacchanti mamaṃ gharaṃ. ",
  "tha-ap411:25.1": "ānandassa nāma rañño ",
  "tha-ap411:25.2": "samaggassa adāsahaṃ ",
  "tha-ap411:25.3": "sattavaṇṇena ratanena ",
  "tha-ap411:25.4": "ūnattaṃ pūrayāmahaṃ. ",
  "tha-ap411:26.1": "ye mayā kittitā sabbe ",
  "tha-ap411:26.2": "nānāvaṇṇā bahū janā ",
  "tha-ap411:26.3": "tesāhaṃ cittamaññāya ",
  "tha-ap411:26.4": "tappayiṃ ratanenapi. ",
  "tha-ap411:27.1": "vaggūsu bhāsamānesu ",
  "tha-ap411:27.2": "vajjamānāsu bherisu ",
  "tha-ap411:27.3": "saṅkhesu dhamayantesu ",
  "tha-ap411:27.4": "sakagehe ramāmahaṃ. ",
  "tha-ap411:28.1": "bhagavā tamhi samaye ",
  "tha-ap411:28.2": "padumuttaranāmako saha ",
  "tha-ap411:28.3": "satasahassehi ",
  "tha-ap411:28.4": "parikkhīṇāsavehi so. ",
  "tha-ap411:29.1": "bhikkhūhi sahito vīthiṃ ",
  "tha-ap411:29.2": "paṭipajjittha cakkhumā ",
  "tha-ap411:29.3": "obhāsento disā sabbā ",
  "tha-ap411:29.4": "dīparukkhova jotati. ",
  "tha-ap411:30.1": "vajjanti bheriyo sabbā ",
  "tha-ap411:30.2": "gacchante lokanāyake ",
  "tha-ap411:30.3": "pabhā niddhāvate tassa ",
  "tha-ap411:30.4": "sataraṃsīva uggato. ",
  "tha-ap411:31.1": "kavāṭantarikāyāpi ",
  "tha-ap411:31.2": "paviṭṭhena ca rasminā ",
  "tha-ap411:31.3": "antogharesu vipulo ",
  "tha-ap411:31.4": "āloko āsi tāvade. ",
  "tha-ap411:32.1": "pabhaṃ disvāna buddhassa ",
  "tha-ap411:32.2": "pārisajje avocahaṃ ",
  "tha-ap411:32.3": "nissaṃsayaṃ buddhaseṭṭho ",
  "tha-ap411:32.4": "imaṃ vīthimupāgato. ",
  "tha-ap411:33.1": "khippaṃ oruyha pāsādā ",
  "tha-ap411:33.2": "agamiṃ antarāpathaṃ ",
  "tha-ap411:33.3": "sambuddhaṃ abhivādento ",
  "tha-ap411:33.4": "idaṃ vacanamabraviṃ. ",
  "tha-ap411:34.1": "anukampatu me buddho ",
  "tha-ap411:34.2": "jalajuttamanāmako ",
  "tha-ap411:34.3": "vasīsatasahassehi ",
  "tha-ap411:34.4": "adhivāsesi so muni. ",
  "tha-ap411:35.1": "nimantayitvāna sambuddhaṃ ",
  "tha-ap411:35.2": "abhinesiṃ sakaṃ gharaṃ ",
  "tha-ap411:35.3": "tattha annena pānena ",
  "tha-ap411:35.4": "santappesiṃ mahāmuniṃ. ",
  "tha-ap411:36.1": "bhuttāvīkālamaññāya ",
  "tha-ap411:36.2": "buddhaseṭṭhassa tādino ",
  "tha-ap411:36.3": "saṅgītena turiyena ",
  "tha-ap411:36.4": "buddhaseṭṭhaṃ upaṭṭhahiṃ. ",
  "tha-ap411:37.1": "padumuttaro lokavidū ",
  "tha-ap411:37.2": "āhutīnaṃ paṭiggaho ",
  "tha-ap411:37.3": "antoghare nisīditvā ",
  "tha-ap411:37.4": "imā gāthā abhāsatha. ",
  "tha-ap411:38.1": "yo maṃ turiyenupaṭṭhāsi ",
  "tha-ap411:38.2": "annapānañcadāsi me ",
  "tha-ap411:38.3": "tamahaṃ kittayissāmi ",
  "tha-ap411:38.4": "suṇātha mama bhāsato. ",
  "tha-ap411:39.1": "pahūtabhakkho hutvāna ",
  "tha-ap411:39.2": "sahirañño sabhojano ",
  "tha-ap411:39.3": "catuddīpe ekarajjaṃ ",
  "tha-ap411:39.4": "kārayissatiyaṃ naro. ",
  "tha-ap411:40.1": "pañcasīle samādāya ",
  "tha-ap411:40.2": "dasakammapathe rato ",
  "tha-ap411:40.3": "samādāya pavattanto ",
  "tha-ap411:40.4": "parisaṃ sikkhapessati. ",
  "tha-ap411:41.1": "turiyasatasahassāni ",
  "tha-ap411:41.2": "nāriyo samalaṅkatā ",
  "tha-ap411:41.3": "vajjayissantimaṃ niccaṃ ",
  "tha-ap411:41.4": "upaṭṭhānassidaṃ phalaṃ. ",
  "tha-ap411:42.1": "tiṃsakappasahassāni ",
  "tha-ap411:42.2": "devaloke ramissati ",
  "tha-ap411:42.3": "catusaṭṭhikhattuṃ devindo ",
  "tha-ap411:42.4": "devarajjaṃ karissati. ",
  "tha-ap411:43.1": "catusattatikkhattuṃ ca ",
  "tha-ap411:43.2": "cakkavatti bhavissati ",
  "tha-ap411:43.3": "padesarajjaṃ vipulaṃ ",
  "tha-ap411:43.4": "gaṇanāto asaṅkhayaṃ. ",
  "tha-ap411:44.1": "kappasatasahassamhi ",
  "tha-ap411:44.2": "okkākakulasambhavo ",
  "tha-ap411:44.3": "gotamo nāma nāmena ",
  "tha-ap411:44.4": "satthā loke bhavissati. ",
  "tha-ap411:45.1": "upapajjati yaṃ yoniṃ ",
  "tha-ap411:45.2": "devattaṃ atha mānusaṃ ",
  "tha-ap411:45.3": "anūnabhogo hutvāna ",
  "tha-ap411:45.4": "manussattaṃ gamissati. ",
  "tha-ap411:46.1": "ajjhāyako bhavitvāna ",
  "tha-ap411:46.2": "tiṇṇaṃ vedāna pāragū ",
  "tha-ap411:46.3": "uttamatthaṃ gavesanto ",
  "tha-ap411:46.4": "carissati mahiṃ tadā. ",
  "tha-ap411:47.1": "so ca pacchā pabbajitvā ",
  "tha-ap411:47.2": "sukkamūlena codito ",
  "tha-ap411:47.3": "gotamassa bhagavato ",
  "tha-ap411:47.4": "sāsanebhiramissati. ",
  "tha-ap411:48.1": "ārādhayitvāna sambuddhaṃ ",
  "tha-ap411:48.2": "gotamaṃ sakyapuṅgavaṃ ",
  "tha-ap411:48.3": "kilese jhāpayitvāna ",
  "tha-ap411:48.4": "arahāyaṃ bhavissati. ",
  "tha-ap411:49.1": "pavane byaggharājāva ",
  "tha-ap411:49.2": "migarājāva kesarī ",
  "tha-ap411:49.3": "abhīto viharāmajja ",
  "tha-ap411:49.4": "sakyaputtassa sāsane. ",
  "tha-ap411:50.1": "devaloke manusse vā ",
  "tha-ap411:50.2": "dalidde duggatimhi vā ",
  "tha-ap411:50.3": "nibbattiṃ me na passāmi ",
  "tha-ap411:50.4": "upaṭṭhānassidaṃ phalaṃ. ",
  "tha-ap411:51.1": "vivekamanuyuttomhi ",
  "tha-ap411:51.2": "upasanto nirūpadhi ",
  "tha-ap411:51.3": "nāgova bandhanaṃ chetvā ",
  "tha-ap411:51.4": "viharāmi anāsavo. ",
  "tha-ap411:52.1": "kilesā jhāpitā mayhaṃ ",
  "tha-ap411:52.2": "bhavā sabbe samūhatā nāgova bandhanaṃ chetvā ",
  "tha-ap411:52.3": "viharāmi anāsavo. ",
  "tha-ap411:53.1": "svāgataṃ vata me āsi ",
  "tha-ap411:53.2": "mama buddhassa santike tisso vijjā anuppattā ",
  "tha-ap411:53.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap411:54.1": "paṭisambhidā catasso ",
  "tha-ap411:54.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap411:54.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap411:55.1": "itthaṃ sudaṃ āyasmā jatukaṇṇiko thero imā gāthāyo abhāsitthāti. ",
  "tha-ap411:56.1": "jatukaṇṇikattherassa apadānaṃ samattaṃ. dasamaṃ udenattherāpadānaṃ (410) "
}
