{
  "tha-ap176:0.1": "",
  "tha-ap176:0.2": "",
  "tha-ap176:0.3": "",
  "tha-ap176:1.1": "vipassino bhagavato ",
  "tha-ap176:1.2": "udapāno kato mayā ",
  "tha-ap176:1.3": "piṇḍapātaṃ gahetvāna ",
  "tha-ap176:1.4": "niyyādesiṃ ahaṃ tadā. ",
  "tha-ap176:2.1": "ekanavute ito kappe ",
  "tha-ap176:2.2": "yaṃ kammamakariṃ tadā ",
  "tha-ap176:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap176:2.4": "udapānassidaṃ phalaṃ. ",
  "tha-ap176:3.1": "paṭisambhidā catasso ",
  "tha-ap176:3.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap176:3.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap176:4.1": "itthaṃ sudaṃ āyasmā udadānadāyako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap176:5.1": "udapānadāyakattherassa apadānaṃ samattaṃ. pañcamaṃ sīhāsanadāyakattherāpadānaṃ (175) "
}
