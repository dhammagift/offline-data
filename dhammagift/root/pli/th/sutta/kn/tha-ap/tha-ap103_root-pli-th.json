{
  "tha-ap103:0.1": "ekādasamo bhikkhadāyivaggo ",
  "tha-ap103:0.2": "",
  "tha-ap103:0.3": "",
  "tha-ap103:1.1": "paṭhamaṃ bhikkhadāyakattherāpadānaṃ (101) suvaṇṇavaṇṇaṃ sambuddhaṃ ",
  "tha-ap103:1.2": "āhutīnampaṭiggahaṃ ",
  "tha-ap103:1.3": "pavanā abhinikkhantaṃ ",
  "tha-ap103:1.4": "vānā nibbānamāgataṃ. ",
  "tha-ap103:2.1": "kaṭacchubhikkhapādāsiṃ ",
  "tha-ap103:2.2": "siddhatthassa mahesino ",
  "tha-ap103:2.3": "paññassa upasantassa ",
  "tha-ap103:2.4": "mahāvīrassa tādino. ",
  "tha-ap103:3.1": "padenānupadāyanto ",
  "tha-ap103:3.2": "nibbāpentaṃ mahājanaṃ ",
  "tha-ap103:3.3": "vitti me pāhunā tāva ",
  "tha-ap103:3.4": "buddhassādiccabandhuno. catunavute ",
  "tha-ap103:4.1": "ito kappe ",
  "tha-ap103:4.2": "yaṃ dānamadadiṃ tadā ",
  "tha-ap103:4.3": "duggatiṃ nābhijānāmi ",
  "tha-ap103:4.4": "bhikkhadānassidaṃ phalaṃ. ",
  "tha-ap103:5.1": "sattāsītimhito kappe ",
  "tha-ap103:5.2": "mahāreṇussanāmakā ",
  "tha-ap103:5.3": "sattaratanasampannā ",
  "tha-ap103:5.4": "sattete cakkavattino. ",
  "tha-ap103:6.1": "paṭisambhidā catasso ",
  "tha-ap103:6.2": "vimokkhāpica aṭṭhime ",
  "tha-ap103:6.3": "chaḷabhiññā sacchikatā ",
  "tha-ap103:6.4": "kataṃ buddhassa sāsananti. ",
  "tha-ap103:7.1": "itthaṃ sudaṃ āyasmā bhikkhadāyako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap103:8.1": "bhikkhadāyakattherassa apadānaṃ samattaṃ. dutiyaṃ ñāṇasaññikattherāpadānaṃ (102) "
}
