{
  "tha-ap369:0.1": "",
  "tha-ap369:0.2": "",
  "tha-ap369:0.3": "",
  "tha-ap369:1.1": "sujāto nāma sambuddho ",
  "tha-ap369:1.2": "gaṅgākūle vasī tadā ",
  "tha-ap369:1.3": "uddālakaṃ gahetvāna ",
  "tha-ap369:1.4": "pūjayiṃ aparājitaṃ. ",
  "tha-ap369:2.1": "ekatiṃse ito kappe ",
  "tha-ap369:2.2": "yaṃ pupphaṃ abhipūjayiṃ ",
  "tha-ap369:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap369:2.4": "buddhapūjāyidaṃ phalaṃ. ",
  "tha-ap369:3.1": "paṭisambhidā catasso ",
  "tha-ap369:3.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap369:3.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap369:4.1": "itthaṃ sudaṃ āyasmā uddālakapupphiyo thero imā gāthāyo abhāsitthāti. ",
  "tha-ap369:5.1": "uddālakapupphiyattherassa apadānaṃ samattaṃ. aṭṭhamaṃ ekacampakapupphiyattherāpadānaṃ (368) "
}
