{
  "tha-ap198:0.1": "",
  "tha-ap198:0.2": "",
  "tha-ap198:0.3": "",
  "tha-ap198:1.1": "nagare dvāravatiyā ",
  "tha-ap198:1.2": "mālāvaccho mamaṃ ahu ",
  "tha-ap198:1.3": "udapāno ca tattheva ",
  "tha-ap198:1.4": "pādapānaṃ virohano. ",
  "tha-ap198:2.1": "sabalena upatthaddho ",
  "tha-ap198:2.2": "siddhattho aparājito ",
  "tha-ap198:2.3": "mamānukampamāno so ",
  "tha-ap198:2.4": "gacchate anilañjase. ",
  "tha-ap198:3.1": "aññaṃ kiñci na passāmi ",
  "tha-ap198:3.2": "pūjāyoggaṃ mahesino ",
  "tha-ap198:3.3": "asokapallavaṃ disvā ",
  "tha-ap198:3.4": "ākāse ukkhipiṃ ahaṃ. ",
  "tha-ap198:4.1": "buddhassa te kisalayā ",
  "tha-ap198:4.2": "gacchato yanti pacchato ",
  "tha-ap198:4.3": "tāhaṃ disvāna saṃvijiṃ ",
  "tha-ap198:4.4": "aho buddhassuḷāratā. ",
  "tha-ap198:5.1": "catunavute ito kappe ",
  "tha-ap198:5.2": "pallavaṃ abhiropayiṃ ",
  "tha-ap198:5.3": "duggatiṃ nābhijānāmi ",
  "tha-ap198:5.4": "buddhapūjāyidaṃ phalaṃ. ",
  "tha-ap198:6.1": "sattavīse ito kappe ",
  "tha-ap198:6.2": "eko ekissaro ahu ",
  "tha-ap198:6.3": "sattaratanasampanno ",
  "tha-ap198:6.4": "cakkavatti mahabbalo. ",
  "tha-ap198:7.1": "paṭisambhidā catasso ",
  "tha-ap198:7.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap198:7.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap198:8.1": "itthaṃ sudaṃ āyasmā kisalayapūjako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap198:9.1": "kisalayapūjakattherassa apadānaṃ samattaṃ. sattamaṃ tindukadāyakattherāpadānaṃ (197) "
}
