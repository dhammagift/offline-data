{
  "tha-ap252:0.1": "",
  "tha-ap252:0.2": "",
  "tha-ap252:0.3": "",
  "tha-ap252:1.1": "kukkudho nāma nāmena ",
  "tha-ap252:1.2": "sayambhū aparājito ",
  "tha-ap252:1.3": "pavanā nikkhamitvāna ",
  "tha-ap252:1.4": "anuppatto mahānadiṃ. ",
  "tha-ap252:2.1": "uddālakaṃ gahetvāna ",
  "tha-ap252:2.2": "sayambhussa adāsahaṃ ",
  "tha-ap252:2.3": "saṃyatassujubhūtassa ",
  "tha-ap252:2.4": "pasannamanaso tadā. ",
  "tha-ap252:3.1": "ekatiṃse ito kappe ",
  "tha-ap252:3.2": "yaṃ pupphamabhiropayiṃ ",
  "tha-ap252:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap252:3.4": "pupphadānassidaṃ phalaṃ. ",
  "tha-ap252:4.1": "paṭisambhidā catasso ",
  "tha-ap252:4.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap252:4.3": "kataṃ buddhassa sāsanti. ",
  "tha-ap252:5.1": "itthaṃ sudaṃ āyasmā uddāladāyako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap252:6.1": "uddāladāyakattherassa apadānaṃ ",
  "tha-ap252:7.1": "samattaṃ. ",
  "tha-ap252:8.1": "uddānaṃ ",
  "tha-ap252:9.1": "tuvaraṭṭhināgapuḷinā ",
  "tha-ap252:9.2": "viravikuṭidhūpako ",
  "tha-ap252:9.3": "patto dhātusattaliyo ",
  "tha-ap252:9.4": "bimbi uddālakena ca ",
  "tha-ap252:9.5": "sattatiṃsati gāthāyo ",
  "tha-ap252:9.6": "gaṇitāyo vibhāvihīti. tuvaradāyivaggo pañcavīso. "
}
