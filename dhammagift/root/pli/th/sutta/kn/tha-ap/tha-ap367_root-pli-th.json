  "tha-ap367:0.1": "",
  "tha-ap367:0.2": "",
  "tha-ap367:0.3": "",
  "tha-ap367:1.1": "padumo nāma sambuddho ",
  "tha-ap367:1.2": "cittakūṭe vasī tadā ",
  "tha-ap367:1.3": "disvāna tamahaṃ buddhaṃ ",
  "tha-ap367:1.4": "sayambhuṃ upagañchahaṃ. ",
  "tha-ap367:2.1": "aṅkolaṃ pupphitaṃ disvā ",
  "tha-ap367:2.2": "ocinitvānahaṃ tadā ",
  "tha-ap367:2.3": "upagantvāna sambuddhaṃ ",
  "tha-ap367:2.4": "pūjesiṃ padumaṃ jinaṃ. ",
  "tha-ap367:3.1": "ekatiṃse ito kappe ",
  "tha-ap367:3.2": "yaṃ kammamakariṃ tadā ",
  "tha-ap367:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap367:3.4": "buddhapūjāyidaṃ phalaṃ. ",
  "tha-ap367:4.1": "paṭisambhidā catasso ",
  "tha-ap367:4.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap367:4.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap367:5.1": "itthaṃ sudaṃ āyasmā aṅkolapupphiyo thero imā gāthāyo abhāsitthāti. ",
  "tha-ap367:6.1": "aṅkolapupphiyattherassa apadānaṃ samattaṃ. chaṭṭhaṃ kadambapupphiyattherāpadānaṃ (366) "
}
