  "tha-ap357:0.1": "",
  "tha-ap357:0.2": "",
  "tha-ap357:0.3": "",
  "tha-ap357:1.1": "kānanaṃ vanamoggayha ",
  "tha-ap357:1.2": "veḷuṃ chetvānahantadā ",
  "tha-ap357:1.3": "ālambanaṃ gahetvāna ",
  "tha-ap357:1.4": "saṅghassa adadaṃ ahaṃ. ",
  "tha-ap357:2.1": "tena cittappasādena ",
  "tha-ap357:2.2": "subbate abhivādiya ",
  "tha-ap357:2.3": "ālambanampi datvāna ",
  "tha-ap357:2.4": "pakkāmi uttarāmukho. ",
  "tha-ap357:3.1": "catunavute ito kappe ",
  "tha-ap357:3.2": "yaṃ daṇḍamadadintadā ",
  "tha-ap357:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap357:3.4": "daṇḍadānassidaṃ phalaṃ. ",
  "tha-ap357:4.1": "paṭisambhidā catasso ",
  "tha-ap357:4.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap357:4.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap357:5.1": "itthaṃ sudaṃ āyasmā daṇḍadāyako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap357:6.1": "daṇḍadāyakattherassa apadānaṃ samattaṃ. chaṭṭhaṃ ambayāgudāyakattherāpadānaṃ (356) "
}
