{
  "tha-ap463:0.1": "sattacattāḷīso sālapupphivaggo ",
  "tha-ap463:0.2": "",
  "tha-ap463:0.3": "",
  "tha-ap463:1.1": "paṭhamaṃ sālakusumiyattherāpadānaṃ (461) parinibbute bhagavati ",
  "tha-ap463:1.2": "jalajuttamanāmake ",
  "tha-ap463:1.3": "āropitamhi citake ",
  "tha-ap463:1.4": "sālapupphaṃ apūjayiṃ. satasahasse ",
  "tha-ap463:2.1": "ito kappe ",
  "tha-ap463:2.2": "yaṃ pupphamabhipūjayiṃ ",
  "tha-ap463:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap463:2.4": "citapūjāyidaṃ phalaṃ. ",
  "tha-ap463:3.1": "kilesā jhāpitā mayhaṃ ",
  "tha-ap463:3.2": "bhavā sabbe samūhatā ",
  "tha-ap463:3.3": "nāgova bandhanaṃ chetvā ",
  "tha-ap463:3.4": "viharāmi anāsavo. ",
  "tha-ap463:4.1": "svāgataṃ vata me āsi ",
  "tha-ap463:4.2": "mama buddhassa santike ",
  "tha-ap463:4.3": "tisso vijjā anuppattā ",
  "tha-ap463:4.4": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap463:5.1": "paṭisambhidā catasso ",
  "tha-ap463:5.2": "vimokkhāpica aṭṭhime ",
  "tha-ap463:5.3": "chaḷabhiññā sacchikatā ",
  "tha-ap463:5.4": "kataṃ buddhassa sāsananti. ",
  "tha-ap463:6.1": "itthaṃ sudaṃ āyasmā sālakusumiyo thero imā gāthāyo abhāsitthāti. ",
  "tha-ap463:7.1": "sālakusumiyattherassa apadānaṃ samattaṃ. dutiyaṃ citakapūjakattherāpadānaṃ (462) "
}
