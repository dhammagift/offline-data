{
  "tha-ap62:0.1": "",
  "tha-ap62:0.2": "",
  "tha-ap62:0.3": "",
  "tha-ap62:1.1": "jātiyā sattavassohaṃ ",
  "tha-ap62:1.2": "addasaṃ lokanāyakaṃ ",
  "tha-ap62:1.3": "pasannacitto sumano ",
  "tha-ap62:1.4": "upagañchiṃ naruttamaṃ. ",
  "tha-ap62:2.1": "tissassāhaṃ bhagavato ",
  "tha-ap62:2.2": "lokajeṭṭhassa tādino ",
  "tha-ap62:2.3": "haṭṭho haṭṭhena cittena ",
  "tha-ap62:2.4": "ropayiṃ bodhimuttamaṃ. ",
  "tha-ap62:3.1": "asano nāmadheyyena ",
  "tha-ap62:3.2": "dharaṇīrūhapādapo ",
  "tha-ap62:3.3": "pañca vasse paricariṃ ",
  "tha-ap62:3.4": "asanaṃ bodhimuttamaṃ. ",
  "tha-ap62:4.1": "pupphitaṃ pādapaṃ disvā ",
  "tha-ap62:4.2": "abbhūtaṃ lomahaṃsanaṃ ",
  "tha-ap62:4.3": "sakaṃ kammaṃ pakittento ",
  "tha-ap62:4.4": "buddhaseṭṭhaṃ upāgamiṃ. ",
  "tha-ap62:5.1": "tisso tadā so sambuddho ",
  "tha-ap62:5.2": "sayambhū aggapuggalo ",
  "tha-ap62:5.3": "bhikkhusaṅghe nisīditvā ",
  "tha-ap62:5.4": "imā gāthā abhāsatha. ",
  "tha-ap62:6.1": "yenāyaṃ ropitā bodhi ",
  "tha-ap62:6.2": "buddhapūjā ca sakkatā ",
  "tha-ap62:6.3": "tamahaṃ kittayissāmi ",
  "tha-ap62:6.4": "suṇātha mama bhāsato. ",
  "tha-ap62:7.1": "tiṃsakappāni devesu ",
  "tha-ap62:7.2": "devarajjaṃ karissati ",
  "tha-ap62:7.3": "catussaṭṭhiñca khattuṃ so ",
  "tha-ap62:7.4": "cakkavatti bhavissati. ",
  "tha-ap62:8.1": "tusitāhi caritvāna ",
  "tha-ap62:8.2": "sukkamūlena codito ",
  "tha-ap62:8.3": "dve sampattī anubhotvā ",
  "tha-ap62:8.4": "manussatte ramissati. ",
  "tha-ap62:9.1": "padhānaṃ pahitatto so ",
  "tha-ap62:9.2": "upasanto nirūpadhi ",
  "tha-ap62:9.3": "sabbāsave pariññāya ",
  "tha-ap62:9.4": "nibbāyissatyanāsavo. ",
  "tha-ap62:10.1": "vivekamanuyuttohaṃ ",
  "tha-ap62:10.2": "upasanto nirūpadhi ",
  "tha-ap62:10.3": "nāgova bandhanaṃ chetvā ",
  "tha-ap62:10.4": "viharāmi anāsavo. ",
  "tha-ap62:11.1": "dvenavute ito kappe ",
  "tha-ap62:11.2": "bodhiṃ ropesahaṃ tadā ",
  "tha-ap62:11.3": "duggatiṃ nābhijānāmi ",
  "tha-ap62:11.4": "bodhiropassidaṃ phalaṃ. ",
  "tha-ap62:12.1": "catussattatito kappe ",
  "tha-ap62:12.2": "daṇḍasenoti vissuto ",
  "tha-ap62:12.3": "sattaratanasampanno ",
  "tha-ap62:12.4": "cakkavatti tadā ahu. tesattati ",
  "tha-ap62:13.1": "ito kappe ",
  "tha-ap62:13.2": "sattāhesuṃ mahīpatī ",
  "tha-ap62:13.3": "samantanemi nāmena ",
  "tha-ap62:13.4": "rājāno cakkavattino. ",
  "tha-ap62:14.1": "puṇṇavīsatito kappe ",
  "tha-ap62:14.2": "puṇṇako nāma khattiyo ",
  "tha-ap62:14.3": "sattaratanasampanno ",
  "tha-ap62:14.4": "cakkavatti mahabbalo. ",
  "tha-ap62:15.1": "paṭisambhidā catasso ",
  "tha-ap62:15.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap62:15.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap62:16.1": "itthaṃ sudaṃ āyasmā asanabodhiyo thero imā gāthāyo abhāsitthāti. ",
  "tha-ap62:17.1": "asanabodhiyattherassa apadānaṃ ",
  "tha-ap62:18.1": "samattaṃ. uddānaṃ ",
  "tha-ap62:19.1": "vījanī ",
  "tha-ap62:20.1": "sataraṃsī ca ",
  "tha-ap62:20.2": "sayanodaki vāhiso ",
  "tha-ap62:20.3": "parivāro padīpañca ",
  "tha-ap62:20.4": "dhajo padumapūjako ",
  "tha-ap62:20.5": "bodhi ca dasamo vutto ",
  "tha-ap62:20.6": "gāthā dvenavutī tathā. vījanīvaggo chaṭṭho. "
}
