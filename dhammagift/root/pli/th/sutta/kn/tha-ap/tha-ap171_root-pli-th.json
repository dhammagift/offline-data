{
  "tha-ap171:0.1": "",
  "tha-ap171:0.2": "",
  "tha-ap171:0.3": "",
  "tha-ap171:1.1": "bandhumatiyā nagare ",
  "tha-ap171:1.2": "mahāpūgagaṇo ahu ",
  "tha-ap171:1.3": "tesāhaṃ pavaro āsiṃ ",
  "tha-ap171:1.4": "mama paṭṭhacarā va te. te ",
  "tha-ap171:2.1": "sabbe sannipātetvā ",
  "tha-ap171:2.2": "puññakamme samādiyiṃ ",
  "tha-ap171:2.3": "māḷaṃ karissāma saṅghassa ",
  "tha-ap171:2.4": "puññakkhettamanuttaraṃ. ",
  "tha-ap171:3.1": "sādhūti te paṭissutvā ",
  "tha-ap171:3.2": "mama chandavasānugā ",
  "tha-ap171:3.3": "niṭṭhāpetvāva taṃ māḷaṃ ",
  "tha-ap171:3.4": "vipassissa adamhase. ",
  "tha-ap171:4.1": "ekanavute ito kappe ",
  "tha-ap171:4.2": "yaṃ māḷamadadiṃ tadā ",
  "tha-ap171:4.3": "duggatiṃ nābhijānāmi ",
  "tha-ap171:4.4": "māḷadānassidaṃ phalaṃ. ",
  "tha-ap171:5.1": "ekūnasaṭṭhikappamhi ",
  "tha-ap171:5.2": "eko āsi janādhipo ",
  "tha-ap171:5.3": "āvelo nāma nāmena ",
  "tha-ap171:5.4": "cakkavatti mahabbalo. ",
  "tha-ap171:6.1": "paṭisambhidā catasso ",
  "tha-ap171:6.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap171:6.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap171:7.1": "itthaṃ sudaṃ āyasmā samādapako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap171:8.1": "samādapakattherassa apadānaṃ samattaṃ. dasamaṃ pañcaṅguliyattherāpadānaṃ (170) "
}
