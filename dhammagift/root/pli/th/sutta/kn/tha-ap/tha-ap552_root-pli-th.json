{
  "tha-ap552:0.1": "",
  "tha-ap552:0.2": "",
  "tha-ap552:0.3": "",
  "tha-ap552:1.1": "imamhi bhaddake kappe ",
  "tha-ap552:1.2": "brahmabandhu mahāyaso ",
  "tha-ap552:1.3": "kassapo nāma nāmena ",
  "tha-ap552:1.4": "uppajji vadataṃ varo. ",
  "tha-ap552:2.1": "anubyañjanasampanno ",
  "tha-ap552:2.2": "battiṃsavaralakkhaṇo ",
  "tha-ap552:2.3": "byāmappabhāparivuto ",
  "tha-ap552:2.4": "raṃsijālasamogato. ",
  "tha-ap552:3.1": "assāsetā yathā cando ",
  "tha-ap552:3.2": "suriyova pabhaṅkaro ",
  "tha-ap552:3.3": "nibbāpetā yathā megho ",
  "tha-ap552:3.4": "sāgarova guṇākaro. ",
  "tha-ap552:4.1": "dharaṇīriva sīlena ",
  "tha-ap552:4.2": "himavāva samādhinā ",
  "tha-ap552:4.3": "ākāso viya paññāya ",
  "tha-ap552:4.4": "asaṅgo anilo yathā. ",
  "tha-ap552:5.1": "tadāhaṃ bārāṇasiyaṃ ",
  "tha-ap552:5.2": "upapanno mahākule ",
  "tha-ap552:5.3": "pahūtadhanadhaññasmiṃ ",
  "tha-ap552:5.4": "nānāratanasañcaye. ",
  "tha-ap552:6.1": "mahatā parivārena ",
  "tha-ap552:6.2": "nisinnaṃ lokanāyakaṃ ",
  "tha-ap552:6.3": "upecca dhammamassosiṃ ",
  "tha-ap552:6.4": "amataṃva manorahaṃ. ",
  "tha-ap552:7.1": "dvattiṃsalakkhaṇadharo ",
  "tha-ap552:7.2": "sunakkhattova candimā ",
  "tha-ap552:7.3": "anubyañjanasampanno ",
  "tha-ap552:7.4": "sālarājāva phullito. ",
  "tha-ap552:8.1": "raṃsijālaparikkhitto ",
  "tha-ap552:8.2": "dittova kanakācalo ",
  "tha-ap552:8.3": "byāmappabhāparivuto ",
  "tha-ap552:8.4": "sataraṃsīva divākaro. ",
  "tha-ap552:9.1": "soṇṇānano jinavaro ",
  "tha-ap552:9.2": "rammaṇīva siluccayo ",
  "tha-ap552:9.3": "karuṇāpuṇṇahadayo ",
  "tha-ap552:9.4": "guṇena viya sāgaro. ",
  "tha-ap552:10.1": "lokavissutakitti ca ",
  "tha-ap552:10.2": "sineruva naguttamo ",
  "tha-ap552:10.3": "yasasā vitato dhīro ",
  "tha-ap552:10.4": "ākāsasadiso muni. ",
  "tha-ap552:11.1": "asaṅgacitto sabbattha ",
  "tha-ap552:11.2": "anilo viya nāyako ",
  "tha-ap552:11.3": "patiṭṭhā sabbabhūtānaṃ ",
  "tha-ap552:11.4": "mahīva muni sattamo. ",
  "tha-ap552:12.1": "anūpalitto lokena ",
  "tha-ap552:12.2": "toyena padumaṃ yathā ",
  "tha-ap552:12.3": "kuvādagacchadahano ",
  "tha-ap552:12.4": "aggikkhandhova so vasi. ",
  "tha-ap552:13.1": "agado viya sabbattha ",
  "tha-ap552:13.2": "kilesavisanāsako ",
  "tha-ap552:13.3": "gandhamādanaselova ",
  "tha-ap552:13.4": "guṇagandhavibhūsito. ",
  "tha-ap552:14.1": "guṇānaṃ ākaro dhīro ",
  "tha-ap552:14.2": "ratanānaṃva sāgaro ",
  "tha-ap552:14.3": "sindhuva ca narājañño ",
  "tha-ap552:14.4": "kilesamalahārako. ",
  "tha-ap552:15.1": "vijayīva mahāyodho ",
  "tha-ap552:15.2": "mārasenāppamaddano ",
  "tha-ap552:15.3": "cakkavattīva so rājā ",
  "tha-ap552:15.4": "bojjhaṅgaratanissaro. ",
  "tha-ap552:16.1": "mahābhisakkasaṅkāso ",
  "tha-ap552:16.2": "dosabyādhitikicchako ",
  "tha-ap552:16.3": "sallakatto yathā seṭṭho ",
  "tha-ap552:16.4": "diṭṭhigaṇḍaviphālako. ",
  "tha-ap552:17.1": "so tadā lokapajjoto ",
  "tha-ap552:17.2": "sanarāmarasakkato ",
  "tha-ap552:17.3": "parisāsu narādicco ",
  "tha-ap552:17.4": "dhammaṃ desayate jino. ",
  "tha-ap552:18.1": "dānaṃ datvā mahābhogo ",
  "tha-ap552:18.2": "sīlena sugatūpago ",
  "tha-ap552:18.3": "bhāvanāya ca nibbāti ",
  "tha-ap552:18.4": "iccevamanusāsatha. ",
  "tha-ap552:19.1": "desanantaṃ mahassādaṃ ",
  "tha-ap552:19.2": "ādimajjhantasobhanaṃ ",
  "tha-ap552:19.3": "suṇanti parisā sabbā ",
  "tha-ap552:19.4": "amataṃva mahārasaṃ. ",
  "tha-ap552:20.1": "sutvā sumadhuraṃ dhammaṃ ",
  "tha-ap552:20.2": "pasanno jinasāsane ",
  "tha-ap552:20.3": "sugataṃ saraṇaṃ gantvā ",
  "tha-ap552:20.4": "yāvajīvaṃ namassahaṃ. ",
  "tha-ap552:21.1": "munino gandhakuṭiyā ",
  "tha-ap552:21.2": "ubbaṭṭesiṃ tadā mahiṃ ",
  "tha-ap552:21.3": "catujjātena gandhena ",
  "tha-ap552:21.4": "māse aṭṭha dine svahaṃ. ",
  "tha-ap552:22.1": "paṇidhāya sugandhantaṃ sarīrassa ",
  "tha-ap552:22.2": "vigandhino ",
  "tha-ap552:22.3": "tadā jino viyākāsi ",
  "tha-ap552:22.4": "sugandhatanulābhitaṃ. ",
  "tha-ap552:23.1": "yoyaṃ gandhakuṭibhūmiṃ ",
  "tha-ap552:23.2": "gandhena ubbaṭo sakiṃ ",
  "tha-ap552:23.3": "tena kammavipākena ",
  "tha-ap552:23.4": "upapanno yahiṃ tahiṃ. ",
  "tha-ap552:24.1": "sugandhadeho sabbattha ",
  "tha-ap552:24.2": "bhavissati ayaṃ naro ",
  "tha-ap552:24.3": "guṇagandhāyuto hutvā ",
  "tha-ap552:24.4": "nibbāyissatināsavo. ",
  "tha-ap552:25.1": "tena kammena sukatena ",
  "tha-ap552:25.2": "cetanāpaṇidhīhi ca ",
  "tha-ap552:25.3": "jahitvā mānusaṃ dehaṃ ",
  "tha-ap552:25.4": "tāvatiṃsaṃ agañchahaṃ. ",
  "tha-ap552:26.1": "pacchime ca bhave dāni ",
  "tha-ap552:26.2": "jāto vippakule ahaṃ ",
  "tha-ap552:26.3": "gabbhaṃ me vasato mātā ",
  "tha-ap552:26.4": "dehenāsi sugandhikā. ",
  "tha-ap552:27.1": "yadā ca mātukucchimhā ",
  "tha-ap552:27.2": "nikkhamāmi tadā puraṃ sāvatthi ",
  "tha-ap552:27.3": "sabbagandhehi ",
  "tha-ap552:27.4": "vāsitā viya vāyatha. ",
  "tha-ap552:28.1": "pupphavassañca surabhi ",
  "tha-ap552:28.2": "dibbagandhaṃ manoramaṃ ",
  "tha-ap552:28.3": "dhūpāni ca mahagghāni ",
  "tha-ap552:28.4": "upavāyiṃsu tāvade. ",
  "tha-ap552:29.1": "devā ca sabbagandhehi ",
  "tha-ap552:29.2": "dhūpapupphehi taṃ gharaṃ ",
  "tha-ap552:29.3": "vāsayiṃsu sugandhena ",
  "tha-ap552:29.4": "yasmiṃ jāto ahaṃ ghare. ",
  "tha-ap552:30.1": "yadā ca taruṇo bhaddo ",
  "tha-ap552:30.2": "paṭhame yobbane ṭhito ",
  "tha-ap552:30.3": "tadā sesaṃ saparisaṃ ",
  "tha-ap552:30.4": "vinetvā narasārathi. ",
  "tha-ap552:31.1": "tehi sabbehi sahito ",
  "tha-ap552:31.2": "sāvatthipuramāgato ",
  "tha-ap552:31.3": "tadā buddhānubhāvantaṃ ",
  "tha-ap552:31.4": "disvā pabbajito ahaṃ. ",
  "tha-ap552:32.1": "sīlaṃ samādhipaññañca ",
  "tha-ap552:32.2": "vimuttiñca anuttaraṃ ",
  "tha-ap552:32.3": "bhāvetvā caturo dhamme ",
  "tha-ap552:32.4": "pāpuṇiṃ āsavakkhayaṃ. ",
  "tha-ap552:33.1": "yadā pabbajito cāhaṃ ",
  "tha-ap552:33.2": "yadā ca arahaṃ ahaṃ ",
  "tha-ap552:33.3": "nibbāyissaṃ yadā cāhaṃ ",
  "tha-ap552:33.4": "gandhavasso tadā ahu. ",
  "tha-ap552:34.1": "sarīragandho ca seṭṭhotiseti me ",
  "tha-ap552:34.2": "mahārahaṃ candanaṃ campakuppalaṃ ",
  "tha-ap552:34.3": "tatheva gandhe itare ca sabbaso ",
  "tha-ap552:34.4": "pasayha vāyāmi gato yahiṃ tahiṃ. ",
  "tha-ap552:35.1": "kilesā jhāpitā mayhaṃ ",
  "tha-ap552:35.2": "bhavā sabbe samūhatā nāgova bandhanaṃ chetvā ",
  "tha-ap552:35.3": "viharāmi anāsavo. ",
  "tha-ap552:36.1": "svāgataṃ vata me āsi ",
  "tha-ap552:36.2": "buddhaseṭṭhassa santike tisso vijjā anuppattā ",
  "tha-ap552:36.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap552:37.1": "paṭisambhidā catasso ",
  "tha-ap552:37.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap552:37.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap552:38.1": "itthaṃ sudaṃ āyasmā cūḷasugandho thero imā gāthāyo abhāsitthāti. ",
  "tha-ap552:39.1": "cūḷasugandhattherassa apadānaṃ ",
  "tha-ap552:40.1": "samattaṃ. uddānaṃ ",
  "tha-ap552:41.1": "",
  "tha-ap552:42.1": "bhaddiyo revato thero ",
  "tha-ap552:42.2": "mahālābhī ca sīvalī ",
  "tha-ap552:42.3": "vaṅgīso nandako ceva ",
  "tha-ap552:42.4": "kāḷudāyī tathābhayo. ",
  "tha-ap552:43.1": "lomaso vanavaccho ca ",
  "tha-ap552:43.2": "sugandho dasamo kato ",
  "tha-ap552:43.3": "tīṇi gāthāsatā tattha ",
  "tha-ap552:43.4": "soḷasā ca taduttari. ",
  "tha-ap552:44.1": "bhaddiyavaggo pañcapaññāso. ",
  "tha-ap552:45.1": "atha vagguddānaṃ kaṇikāravhayo vaggo ",
  "tha-ap552:45.2": "phalado tiṇadāyako ",
  "tha-ap552:45.3": "kaccāno bhaddiyo vaggo ",
  "tha-ap552:45.4": "gāthāyo gaṇitā visā. ",
  "tha-ap552:46.1": "nava ",
  "tha-ap552:46.2": "gāthāsatāni ca ",
  "tha-ap552:46.3": "caturāsītimeva ca chapaññāsaṃ pañcasatā ",
  "tha-ap552:46.4": "apadānā pakāsitā. ",
  "tha-ap552:47.1": "saha uddānagāthāhi cha ",
  "tha-ap552:47.2": "sahassāni hontimā ",
  "tha-ap552:47.3": "dve satāni ca gāthānaṃ ",
  "tha-ap552:47.4": "aṭṭhārasa taduttari. "
}
