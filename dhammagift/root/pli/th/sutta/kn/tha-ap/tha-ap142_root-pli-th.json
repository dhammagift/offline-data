{
  "tha-ap142:0.1": "",
  "tha-ap142:0.2": "",
  "tha-ap142:0.3": "",
  "tha-ap142:1.1": "parodhako tadā āsiṃ ",
  "tha-ap142:1.2": "paramānuparodhako ",
  "tha-ap142:1.3": "pabbhāre seyyaṃ kappemi ",
  "tha-ap142:1.4": "avidūre sikhisatthuno. ",
  "tha-ap142:2.1": "sāyaṃ pātañca passāmi ",
  "tha-ap142:2.2": "buddhaṃ lokagganāyakaṃ ",
  "tha-ap142:2.3": "deyyadhammo ca me natthi ",
  "tha-ap142:2.4": "dipadindassa tādino. ",
  "tha-ap142:3.1": "piyālaphalamādāya ",
  "tha-ap142:3.2": "agamaṃ buddhasantikaṃ ",
  "tha-ap142:3.3": "paṭiggahesi bhagavā ",
  "tha-ap142:3.4": "lokajeṭṭho narāsabho. ",
  "tha-ap142:4.1": "tato paraṃ upādāya ",
  "tha-ap142:4.2": "pavāri taṃ vināyakaṃ ",
  "tha-ap142:4.3": "tena cittappasādena ",
  "tha-ap142:4.4": "tattha kālaṃ kato ahaṃ. ",
  "tha-ap142:5.1": "ekatiṃse ito kappe ",
  "tha-ap142:5.2": "yaṃ phalaṃ adadiṃ ahaṃ ",
  "tha-ap142:5.3": "duggatiṃ nābhijānāmi ",
  "tha-ap142:5.4": "phaladānassidaṃ phalaṃ. ",
  "tha-ap142:6.1": "ito paṇṇarase kappe ",
  "tha-ap142:6.2": "tayo āsiṃsu mālabhi ",
  "tha-ap142:6.3": "sattaratanasampannā ",
  "tha-ap142:6.4": "cakkavattī mahabbalā. ",
  "tha-ap142:7.1": "paṭisambhidā catasso ",
  "tha-ap142:7.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap142:7.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap142:8.1": "itthaṃ sudaṃ āyasmā phaladāyako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap142:9.1": "phaladāyakattherassa apadānaṃ ",
  "tha-ap142:10.1": "samattaṃ. uddānaṃ ",
  "tha-ap142:11.1": "sobhi ",
  "tha-ap142:12.1": "sudassano ceva ",
  "tha-ap142:12.2": "candano pupphachadano ",
  "tha-ap142:12.3": "raho campakapupphī ca ",
  "tha-ap142:12.4": "atthasandassakena ca. ",
  "tha-ap142:13.1": "ekaraṃsī sāladado ",
  "tha-ap142:13.2": "dasamo phaladāyako ",
  "tha-ap142:13.3": "gāthāyo sattati dve ca ",
  "tha-ap142:13.4": "gaṇitāyo vibhāvihīti. "
}
