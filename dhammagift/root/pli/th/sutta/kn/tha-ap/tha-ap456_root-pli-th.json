{
  "tha-ap456:0.1": "",
  "tha-ap456:0.2": "",
  "tha-ap456:0.3": "",
  "tha-ap456:1.1": "pudumuttarassa buddhassa ",
  "tha-ap456:1.2": "bodhiyā pādaputtame ",
  "tha-ap456:1.3": "pasannacitto sumano ",
  "tha-ap456:1.4": "tayo ukke adhārayiṃ. ",
  "tha-ap456:2.1": "satasahasse ito kappe ",
  "tha-ap456:2.2": "yāhaṃ ukkamadhārayiṃ ",
  "tha-ap456:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap456:2.4": "ukkadānassidaṃ phalaṃ. ",
  "tha-ap456:3.1": "kilesā jhāpitā mayhaṃ ",
  "tha-ap456:3.2": "bhavā sabbe samūhatā nāgova bandhanaṃ chetvā ",
  "tha-ap456:3.3": "viharāmi anāsavo. ",
  "tha-ap456:4.1": "svāgataṃ vata me āsi ",
  "tha-ap456:4.2": "mama buddhassa santike tisso vijjā anuppattā ",
  "tha-ap456:4.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap456:5.1": "paṭisambhidā catasso ",
  "tha-ap456:5.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap456:5.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap456:6.1": "itthaṃ sudaṃ āyasmā tiṇukkadhāriyo thero imā gāthāyo abhāsitthāti. ",
  "tha-ap456:7.1": "tiṇukkadhāriyattherassa apadānaṃ samattaṃ. pañcamaṃ akkamanadāyakattherāpadānaṃ (455) "
}
