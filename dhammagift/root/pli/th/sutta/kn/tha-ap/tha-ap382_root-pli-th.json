{
  "tha-ap382:0.1": "",
  "tha-ap382:0.2": "",
  "tha-ap382:0.3": "",
  "tha-ap382:1.1": "kaṇikāraṃva jotantaṃ ",
  "tha-ap382:1.2": "nisinnaṃ pabbatantare ",
  "tha-ap382:1.3": "addasaṃ virajaṃ buddhaṃ ",
  "tha-ap382:1.4": "lokajeṭṭhaṃ narāsabhaṃ. ",
  "tha-ap382:2.1": "pasannacitto sumano ",
  "tha-ap382:2.2": "sire katvāna añjaliṃ ",
  "tha-ap382:2.3": "kāsumāriphalaṃ gayha ",
  "tha-ap382:2.4": "buddhaseṭṭhassadāsahaṃ. ",
  "tha-ap382:3.1": "ekattiṃse ito kappe ",
  "tha-ap382:3.2": "yaṃ phalaṃ adadiṃ tadā ",
  "tha-ap382:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap382:3.4": "phaladānassidaṃ phalaṃ. ",
  "tha-ap382:4.1": "svāgataṃ vata me āsi mama buddhassa santike tisso vijjā anuppattā kataṃ buddhassa sāsanaṃ. kilesā jhāpitā mayhaṃ ",
  "tha-ap382:4.2": "bhavā sabbe samūhatā nāgova bandhanaṃ chetvā ",
  "tha-ap382:4.3": "viharāmi anāsavo. ",
  "tha-ap382:5.1": "",
  "tha-ap382:5.2": "",
  "tha-ap382:5.3": "",
  "tha-ap382:6.1": "paṭisambhidā catasso ",
  "tha-ap382:6.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap382:6.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap382:7.1": "itthaṃ sudaṃ āyasmā kāsumāriphaladāyako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap382:8.1": "kāsumāriphaladāyakattherassa ",
  "tha-ap382:9.1": "apadānaṃ samattaṃ. ",
  "tha-ap382:10.1": "uddānaṃ ",
  "tha-ap382:11.1": "bodhipāṭaliuppali ",
  "tha-ap382:11.2": "patti ca sattapaṇṇiyo ",
  "tha-ap382:11.3": "gandhamuṭṭhī ca citako ",
  "tha-ap382:11.4": "tālaṃ sumanadāmako ",
  "tha-ap382:11.5": "kāsumāriphalīpica ",
  "tha-ap382:11.6": "gāthā ekūnasaṭṭhiyo. bodhivandanavaggo aṭṭhattiṃso. "
}
