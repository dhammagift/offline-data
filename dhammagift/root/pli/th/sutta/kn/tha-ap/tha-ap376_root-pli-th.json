{
  "tha-ap376:0.1": "",
  "tha-ap376:0.2": "",
  "tha-ap376:0.3": "",
  "tha-ap376:1.1": "yadā nibbāyi sambuddho ",
  "tha-ap376:1.2": "mahesī padumuttaro ",
  "tha-ap376:1.3": "samāgamma janā sabbe ",
  "tha-ap376:1.4": "sarīraṃ nīharanti te. ",
  "tha-ap376:2.1": "nīharante sarīramhi ",
  "tha-ap376:2.2": "vajjamānāsu bherisu ",
  "tha-ap376:2.3": "pasannacitto sumano ",
  "tha-ap376:2.4": "pattipupphamabhipūjayiṃ. satasahasse ",
  "tha-ap376:3.1": "ito kappe ",
  "tha-ap376:3.2": "yaṃ pupphamabhipūjayiṃ ",
  "tha-ap376:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap376:3.4": "sarīre pūjite phalaṃ. ",
  "tha-ap376:4.1": "svāgataṃ vata me āsi mama buddhassa santike tisso vijjā anuppattā kataṃ buddhassa sāsanaṃ. kilesā jhāpitā mayhaṃ ",
  "tha-ap376:4.2": "bhavā sabbe samūhatā ",
  "tha-ap376:4.3": "nāgova bandhanaṃ chetvā ",
  "tha-ap376:4.4": "viharāmi anāsavo. ",
  "tha-ap376:5.1": "",
  "tha-ap376:5.2": "",
  "tha-ap376:5.3": "",
  "tha-ap376:5.4": "",
  "tha-ap376:6.1": "paṭisambhidā catasso ",
  "tha-ap376:6.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap376:6.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap376:7.1": "itthaṃ sudaṃ āyasmā pattipupphiyo thero imā gāthāyo abhāsitthāti. ",
  "tha-ap376:8.1": "pattipupphiyattherassa apadānaṃ samattaṃ. pañcamaṃ sattapaṇṇiyattherāpadānaṃ (375) "
}
