{
  "tha-ap32:0.1": "",
  "tha-ap32:0.2": "",
  "tha-ap32:0.3": "",
  "tha-ap32:1.1": "nagare bandhumatiyā ",
  "tha-ap32:1.2": "ahosiṃ vāṇijo tadā ",
  "tha-ap32:1.3": "teneva dāraṃ posemi ",
  "tha-ap32:1.4": "ropemi bījasampadaṃ. ",
  "tha-ap32:2.1": "vīthiyaṃ paṭipannassa ",
  "tha-ap32:2.2": "vipassissa mahesino ",
  "tha-ap32:2.3": "ekaṃ khomaṃ mayā dinnaṃ ",
  "tha-ap32:2.4": "kusalatthāya satthuno. ",
  "tha-ap32:3.1": "ekanavute ito kappe ",
  "tha-ap32:3.2": "yaṃ khomaṃ adadiṃ tadā ",
  "tha-ap32:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap32:3.4": "khomadānassidaṃ phalaṃ. ",
  "tha-ap32:4.1": "sattavīse ito kappe ",
  "tha-ap32:4.2": "eko sindhavasandano ",
  "tha-ap32:4.3": "sattaratanasampanno ",
  "tha-ap32:4.4": "cātuddīpamhi issaro. ",
  "tha-ap32:5.1": "paṭisambhidā catasso ",
  "tha-ap32:5.2": "vimokkhāpica aṭṭhime ",
  "tha-ap32:5.3": "chaḷabhiññā sacchikatā ",
  "tha-ap32:5.4": "kataṃ buddhassa sāsananti. ",
  "tha-ap32:6.1": "itthaṃ sudaṃ āyasmā khomadāyako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap32:7.1": "khomadāyakattherassa apadānaṃ samattaṃ. ",
  "tha-ap32:8.1": "uddānaṃ ",
  "tha-ap32:9.1": "subhūti upavāṇo ca ",
  "tha-ap32:9.2": "saraṇo sīlagāhako ",
  "tha-ap32:9.3": "annasaṃsāvako dhūpo ",
  "tha-ap32:9.4": "puḷino uttiyena ca. ",
  "tha-ap32:10.1": "añjalī khomadāyī ca ",
  "tha-ap32:10.2": "daseva tatiye gaṇe ",
  "tha-ap32:10.3": "pañcāsītisataṃ vuttā ",
  "tha-ap32:10.4": "gāthāyo sabbapiṇḍitā. ",
  "tha-ap32:11.1": "subhūtivaggo tatiyo. ",
  "tha-ap32:12.1": "catutthaṃ bhāṇavāraṃ. "
}
