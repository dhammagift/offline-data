{
  "tha-ap323:0.1": "tettiṃso ummāpupphiyavaggo ",
  "tha-ap323:0.2": "",
  "tha-ap323:0.3": "",
  "tha-ap323:1.1": "paṭhamaṃ ummāpupphiyattherāpadānaṃ (321) samāhitaṃ samāpannaṃ ",
  "tha-ap323:1.2": "siddhatthamaparājitaṃ ",
  "tha-ap323:1.3": "samādhinā upaviṭṭhaṃ ",
  "tha-ap323:1.4": "addasāsiṃ naruttamaṃ. ",
  "tha-ap323:2.1": "ummāpupphaṃ gahetvāna ",
  "tha-ap323:2.2": "buddhassa abhipūjayiṃ sabbe ",
  "tha-ap323:2.3": "pupphā ekasīsā ",
  "tha-ap323:2.4": "uddhaṃvaṇṭā adhomukhā. ",
  "tha-ap323:3.1": "sucittā viya tiṭṭhante ",
  "tha-ap323:3.2": "ākāse pupphasantharā ",
  "tha-ap323:3.3": "tena cittappasādena ",
  "tha-ap323:3.4": "tusitaṃ upapajjahaṃ. ",
  "tha-ap323:4.1": "catunavute ito kappe ",
  "tha-ap323:4.2": "yaṃ pupphamabhipūjayiṃ ",
  "tha-ap323:4.3": "duggatiṃ nābhijānāmi ",
  "tha-ap323:4.4": "buddhapūjāyidaṃ phalaṃ. ",
  "tha-ap323:5.1": "pañcapaññāsito kappe ",
  "tha-ap323:5.2": "eko āsi mahīpati ",
  "tha-ap323:5.3": "samantachadano nāma ",
  "tha-ap323:5.4": "cakkavatti mahabbalo. ",
  "tha-ap323:6.1": "paṭisambhidā catasso ",
  "tha-ap323:6.2": "vimokkhāpica aṭṭhime ",
  "tha-ap323:6.3": "chaḷabhiññā sacchikatā ",
  "tha-ap323:6.4": "kataṃ buddhassa sāsananti. ",
  "tha-ap323:7.1": "itthaṃ sudaṃ āyasmā ummāpupphiyo thero imā gāthāyo abhāsitthāti. ",
  "tha-ap323:8.1": "ummāpupphiyattherassa apadānaṃ samattaṃ. dutiyaṃ puḷinapūjakattherāpadānaṃ (322) "
}
