  "tha-ap1:64.3": "yattha hatthaṃ pasāremi ",
  "tha-ap1:64.4": "alaṅkārā upenti me. ",
  "tha-ap1:65.1": "paṭhabyā pabbate ceva ",
  "tha-ap1:65.2": "ākāse udake vane ",
  "tha-ap1:65.3": "yattha hatthaṃ pasāremi ",
  "tha-ap1:65.4": "sabbā kaññā upenti me. ",
  "tha-ap1:66.1": "paṭhabyā pabbate ceva ",
  "tha-ap1:66.2": "ākāse udake vane ",
  "tha-ap1:66.3": "yattha hatthaṃ pasāremi ",
  "tha-ap1:66.4": "madhusakkharā upenti me. ",
  "tha-ap1:67.1": "paṭhabyā pabbate ceva ",
  "tha-ap1:67.2": "ākāse udake vane ",
  "tha-ap1:67.3": "yattha hatthaṃ pasāremi ",
  "tha-ap1:67.4": "sabbe khajjā upenti me. ",
  "tha-ap1:68.1": "adhane addhike jane ",
  "tha-ap1:68.2": "yācake ca pathāvino ",
  "tha-ap1:68.3": "dadāmi taṃ dānavaraṃ ",
  "tha-ap1:68.4": "sambodhivarapattiyā. ",
  "tha-ap1:69.1": "nādento pabbataṃ selaṃ ",
  "tha-ap1:69.2": "gajjento bahalaṃ giriṃ ",
  "tha-ap1:69.3": "sadevakaṃ hāsayanto ",
  "tha-ap1:69.4": "buddho loke bhavāmahaṃ. ",
  "tha-ap1:70.1": "disā dasavidhā loke ",
  "tha-ap1:70.2": "yāyato natthi antakaṃ ",
  "tha-ap1:70.3": "tasmiñca disābhāgamhi ",
  "tha-ap1:70.4": "buddhakhettā asaṅkhiyā. ",
  "tha-ap1:71.1": "pabhā pakittitā mayhaṃ ",
  "tha-ap1:71.2": "yamakā raṃsivāhanā ",
  "tha-ap1:71.3": "etthantare raṃsijālaṃ ",
  "tha-ap1:71.4": "āloko vipulo bhave. ",
  "tha-ap1:72.1": "ettake lokadhātumhi ",
  "tha-ap1:72.2": "sabbe passantu maṃ janā sabbeva sumanā hontu ",
  "tha-ap1:72.3": "sabbe maṃ anuvattare. ",
  "tha-ap1:72.4": "visiṭṭhamadhuranādena amataṃ ",
  "tha-ap1:73.1": "bherimāhare ",
  "tha-ap1:73.2": "",
  "tha-ap1:73.3": "etthantare janā sabbe ",
  "tha-ap1:73.4": "suṇantu madhuraṃ giraṃ. ",
  "tha-ap1:74.1": "dhammameghena vassante ",
  "tha-ap1:74.2": "sabbe hontu anāsavā ",
  "tha-ap1:74.3": "ye tattha pacchimakā sattā ",
  "tha-ap1:74.4": "sotāpannā bhavantu te. ",
  "tha-ap1:75.1": "datvā dātabbakaṃ dānaṃ ",
  "tha-ap1:75.2": "sīlaṃ pūre asesato ",
  "tha-ap1:75.3": "nekkhammapāramiṃ gantvā ",
  "tha-ap1:75.4": "patto sambodhimuttamaṃ. ",
  "tha-ap1:76.1": "paṇḍite paripucchitvā ",
  "tha-ap1:76.2": "katvā viriyamuttamaṃ ",
  "tha-ap1:76.3": "khantiyā pāramiṃ gantvā ",
  "tha-ap1:76.4": "patto sambodhimuttamaṃ. ",
  "tha-ap1:77.1": "katvā daḷhamadhiṭṭhānaṃ ",
  "tha-ap1:77.2": "saccapārami pūraye ",
  "tha-ap1:77.3": "mettāya pāramiṃ gantvā ",
  "tha-ap1:77.4": "patto sambodhimuttamaṃ. ",
  "tha-ap1:78.1": "lābhālābhe sukhadukkhe sammānane ",
  "tha-ap1:78.2": "vimānane ",
  "tha-ap1:78.3": "sabbattha samako hutvā ",
  "tha-ap1:78.4": "patto sambodhimuttamaṃ. ",
  "tha-ap1:79.1": "kosajjaṃ bhayato disvā ",
  "tha-ap1:79.2": "viriyañcāpi khemato ",
  "tha-ap1:79.3": "āraddhaviriyā hotha ",
  "tha-ap1:79.4": "esā buddhānusāsanī. ",
  "tha-ap1:80.1": "vivādaṃ bhayato disvā ",
  "tha-ap1:80.2": "avivādañca khemato ",
  "tha-ap1:80.3": "samaggā sakhilā hotha ",
  "tha-ap1:80.4": "esā buddhānusāsanī. ",
  "tha-ap1:81.1": "pamādaṃ bhayato disvā ",
  "tha-ap1:81.2": "appamādañca khemato ",
  "tha-ap1:81.3": "bhāvethaṭṭhaṅgikaṃ maggaṃ ",
  "tha-ap1:81.4": "esā buddhānusāsanī. ",
  "tha-ap1:82.1": "samāgatā bahū buddhā ",
  "tha-ap1:82.2": "arahanto ca sabbaso ",
  "tha-ap1:82.3": "sambuddhe arahante ca ",
  "tha-ap1:82.4": "vandamānā namassatha. ",
  "tha-ap1:83.1": "evaṃ acintiyā buddhā ",
  "tha-ap1:83.2": "buddhadhammā acintiyā ",
  "tha-ap1:83.3": "acintiyesu pasannānaṃ ",
  "tha-ap1:83.4": "vipāko hotyacintiyoti. ",
  "tha-ap1:84.1": "itthaṃ sudaṃ bhagavā attano buddhacaritaṃ sambodhayamāno buddhāpadāniyaṃ nāma dhammapariyāyaṃ abhāsitthāti. ",
  "tha-ap1:85.1": "buddhāpadānaṃ samattaṃ. "
}
