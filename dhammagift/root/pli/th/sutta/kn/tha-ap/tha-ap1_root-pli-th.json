{
  "tha-ap1:0.1": "suttantapiṭake khuddakanikāyassa namo tassa bhagavato arahato sammāsambuddhassa. paṭhamo buddhavaggo ",
  "tha-ap1:0.2": "",
  "tha-ap1:0.3": "apadānaṃ paṭhamaṃ buddhāpadānaṃ ",
  "tha-ap1:1.1": "",
  "tha-ap1:2.1": "tathāgataṃ jetavane vasantaṃ ",
  "tha-ap1:2.2": "apucchi vedehamunī nataṅgo ",
  "tha-ap1:2.3": "sabbaññubuddhā kira nāma honti ",
  "tha-ap1:2.4": "bhavanti te hetuhi kehi dhīrā. ",
  "tha-ap1:3.1": "tadāha sabbaññuvaro mahesī ",
  "tha-ap1:3.2": "ānandabhaddaṃ madhurassarena ",
  "tha-ap1:3.3": "ye sabbabuddhesu katādhikārā ",
  "tha-ap1:3.4": "aladdhamokkhā jinasāsanesu. ",
  "tha-ap1:4.1": "teneva sambodhimukhena dhīrā ",
  "tha-ap1:4.2": "ajjhāsayenāpi mahābalena ",
  "tha-ap1:4.3": "paññāya tejena sutikkhapaññā ",
  "tha-ap1:4.4": "sabbaññubhāvaṃ anupāpuṇanti. ",
  "tha-ap1:5.1": "ahampi pubbabuddhesu ",
  "tha-ap1:5.2": "buddhattaṃ ",
  "tha-ap1:5.3": "abhipatthayiṃ ",
  "tha-ap1:5.4": "tiṃsa ",
  "tha-ap1:6.1": "pārami ",
  "tha-ap1:6.2": "sampuṇṇā ",
  "tha-ap1:6.3": "",
  "tha-ap1:6.4": "dhammarājā asaṅkhiyā. ",
  "tha-ap1:7.1": "sambodhiṃ buddhaseṭṭhānaṃ ",
  "tha-ap1:7.2": "sasaṅghe lokanāyake ",
  "tha-ap1:7.3": "dasaṅgulī namassitvā ",
  "tha-ap1:7.4": "sirasā abhivādaye. ",
  "tha-ap1:8.1": "yāvatā buddhakhettesu ",
  "tha-ap1:8.2": "ratanā vijjantisaṅkhiyā ",
  "tha-ap1:8.3": "ākāsaṭṭhā ca bhummaṭṭhā ",
  "tha-ap1:8.4": "manasā sabbamāhare. ",
  "tha-ap1:9.1": "tattha rūpiyabhūmiyaṃ ",
  "tha-ap1:9.2": "pāsādaṃ māpaye ahaṃ ",
  "tha-ap1:9.3": "nekabhummaṃ ratanamayaṃ ",
  "tha-ap1:9.4": "ubbiddhaṃ nabhamuggataṃ. ",
  "tha-ap1:10.1": "vicittathamabhaṃ sukataṃ ",
  "tha-ap1:10.2": "suvibhattaṃ mahārahaṃ ",
  "tha-ap1:10.3": "kanakāmayasaṅghāṭaṃ ",
  "tha-ap1:10.4": "kontacchattehi maṇḍitaṃ. ",
  "tha-ap1:11.1": "paṭhamā veḷuriyā bhūmi ",
  "tha-ap1:11.2": "vimalabbhasamā subhā ",
  "tha-ap1:11.3": "naḷinājalajākiṇṇā ",
  "tha-ap1:11.4": "varakañcanabhūmiyā. ",
  "tha-ap1:12.1": "pahaṭṭhasākhāpavāḷa- vaṇṇā ",
  "tha-ap1:12.2": "lohitakā subhā ",
  "tha-ap1:12.3": "indagopakavaṇṇābhā ",
  "tha-ap1:12.4": "bhūmi obhāsatī disā. ",
  "tha-ap1:13.1": "suvibhattā gharamukhā ",
  "tha-ap1:13.2": "niyyuhā sīhapañjarā ",
  "tha-ap1:13.3": "caturo vedikā jālā ",
  "tha-ap1:13.4": "gandhāveḷā manoramā. ",
  "tha-ap1:14.1": "nīlā pītā lohitakā ",
  "tha-ap1:14.2": "odātā suddhakāḷakā ",
  "tha-ap1:14.3": "kūṭāgāravarūpetā ",
  "tha-ap1:14.4": "sattaratanabhūsitā. ",
  "tha-ap1:15.1": "olokamayā padumā ",
  "tha-ap1:15.2": "vāḷavihaṅgasobhitā ",
  "tha-ap1:15.3": "nakkhattatārakākiṇṇā ",
  "tha-ap1:15.4": "candasuriyehi maṇḍitā. ",
  "tha-ap1:16.1": "hemajālena sañchannā ",
  "tha-ap1:16.2": "soṇṇakiṃkiṇikāyutā ",
  "tha-ap1:16.3": "vātavegena kujjanti ",
  "tha-ap1:16.4": "soṇṇajālā manoramā. ",
  "tha-ap1:17.1": "mañjeṭṭhakaṃ lohitakaṃ ",
  "tha-ap1:17.2": "pītakaṃ haripañjaraṃ ",
  "tha-ap1:17.3": "nānāraṅgehi saṃcittaṃ ",
  "tha-ap1:17.4": "ussitaddhajamālinī. ",
  "tha-ap1:18.1": "nānā bahūnekasatā ",
  "tha-ap1:18.2": "phalakā rajatāmayā ",
  "tha-ap1:18.3": "maṇimayā lohitaṅkā ",
  "tha-ap1:18.4": "masāragallamayā tathā. ",
  "tha-ap1:18.5": "nānāsayanacittitā ",
  "tha-ap1:18.6": "saṇhakāsikasanthatā ",
  "tha-ap1:19.1": "kambalā dukulā cīnā ",
  "tha-ap1:19.2": "pattuṇṇā paṇḍupāvurā. ",
  "tha-ap1:19.3": "vividhattharaṇaṃ sabbaṃ ",
  "tha-ap1:19.4": "manasā paññapemahaṃ ",
  "tha-ap1:20.1": "tāsu tāsveva bhūmīsu ",
  "tha-ap1:20.2": "ratanakūṭalaṅkatā. ",
  "tha-ap1:20.3": "maṇiverocanā ukkā ",
  "tha-ap1:20.4": "dhārayantā sutiṭṭhare ",
  "tha-ap1:21.1": "sobhanti esikā thambhā ",
  "tha-ap1:21.2": "subhā kañcanatoraṇā. ",
  "tha-ap1:21.3": "jambonadā sāramayā ",
  "tha-ap1:21.4": "atho rajatamayāpica ",
  "tha-ap1:22.1": "nekāsandhī suvibhattā ",
  "tha-ap1:22.2": "kavāṭaggalacittitā. ",
  "tha-ap1:22.3": "ubhato puṇṇaghaṭānekā ",
  "tha-ap1:22.4": "padumuppalasaṃyutā ",
  "tha-ap1:23.1": "atīte sabbabuddhe ca ",
  "tha-ap1:23.2": "sasaṅghe lokanāyake. ",
  "tha-ap1:23.3": "pakativaṇṇarūpena ",
  "tha-ap1:23.4": "nimminitvā sasāvake ",
  "tha-ap1:24.1": "tena dvārena pavīsitvā ",
  "tha-ap1:24.2": "sabbabuddhā sasāvakā. ",
  "tha-ap1:24.3": "sabbasovaṇṇamaye pīṭhe ",
  "tha-ap1:24.4": "nisinnā ariyamaṇḍalā ",
  "tha-ap1:25.1": "ye ca etarahi atthi ",
  "tha-ap1:25.2": "buddhā loke anuttarā. ",
  "tha-ap1:25.3": "atītā vattamānā ca ",
  "tha-ap1:25.4": "bhavanaṃ sabbe samāruhuṃ ",
  "tha-ap1:26.1": "paccekabuddhenekasate ",
  "tha-ap1:26.2": "sayambhū aparājite. ",
  "tha-ap1:26.3": "atīte vattamāne ca ",
  "tha-ap1:26.4": "bhavanaṃ sabbe samāruhuṃ ",
  "tha-ap1:27.1": "kapparukkhā bahū atthi ",
  "tha-ap1:27.2": "ye dibbā ye ca mānusā. ",
  "tha-ap1:27.3": "sabbaṃ dussaṃ samāhantvā ",
  "tha-ap1:27.4": "acchādemi ticīvaraṃ ",
  "tha-ap1:28.1": "khajjabhojjaṃ sāyaniyaṃ ",
  "tha-ap1:28.2": "sampannaṃ pānabhojanaṃ. ",
  "tha-ap1:28.3": "maṇimaye subhe patte ",
  "tha-ap1:28.4": "sampūretvā adāsahaṃ ",
  "tha-ap1:29.1": "dibbavatthā samāhutvā ",
  "tha-ap1:29.2": "maṭṭhā cīvarasaṃyutā. ",
  "tha-ap1:29.3": "madhurā sakkharā ceva ",
  "tha-ap1:29.4": "telā ca madhuphāṇitā ",
  "tha-ap1:30.1": "tappitā paramannena ",
  "tha-ap1:30.2": "sabbe ariyamaṇḍalā. ",
  "tha-ap1:30.3": "ratanagabbhaṃ pavīsitvā ",
  "tha-ap1:30.4": "kesarīva guhāsaye ",
  "tha-ap1:31.1": "mahārahamhi sayane ",
  "tha-ap1:31.2": "sīhaseyyamakappayuṃ. ",
  "tha-ap1:31.3": "sampajānā samuṭṭhāya ",
  "tha-ap1:31.4": "seyye pallaṅkamābhajuṃ ",
  "tha-ap1:32.1": "gocaraṃ sabbabuddhānaṃ ",
  "tha-ap1:32.2": "jhānaratisamappitā. ",
  "tha-ap1:32.3": "aññe dhammāni desenti ",
  "tha-ap1:32.4": "aññe kīḷanti iddhiyā ",
  "tha-ap1:33.1": "appanāyapi kīḷanti ",
  "tha-ap1:33.2": "abhiññāvasibhāvitā. ",
  "tha-ap1:33.3": "vikubbanā vikubbanti ",
  "tha-ap1:33.4": "anekasatasahassiyo ",
  "tha-ap1:34.1": "buddhāpi buddhe pucchanti ",
  "tha-ap1:34.2": "visayaṃ sabbaññumālayaṃ. ",
  "tha-ap1:34.3": "gambhīraṃ nipuṇaṃ ṭhānaṃ ",
  "tha-ap1:34.4": "paññāya vinibujjhare ",
  "tha-ap1:35.1": "sāvakā buddhe pucchanti ",
  "tha-ap1:35.2": "buddhā pucchanti sāvake. ",
  "tha-ap1:35.3": "aññamaññañca pucchanti ",
  "tha-ap1:35.4": "aññamaññaṃ byākaronti te ",
  "tha-ap1:36.1": "buddhā paccekabuddhā ca ",
  "tha-ap1:36.2": "sāvakā paricārakā. ",
  "tha-ap1:36.3": "evaṃ ratīsu ramamānā ",
  "tha-ap1:36.4": "pāsādebhiramanti te ",
  "tha-ap1:37.1": "chattātichattā tiṭṭhanti ratanāveḷusannibhā. suvaṇṇajālasaṃyuttaṃ ",
  "tha-ap1:37.2": "rajatajālakhacitaṃ ",
  "tha-ap1:37.3": "muttājālaparikkhittaṃ ",
  "tha-ap1:37.4": "sabbe dhārentu matthake. ",
  "tha-ap1:38.1": "bhavanti 5 celavitānā ",
  "tha-ap1:38.2": "soṇṇatārakacittitā ",
  "tha-ap1:38.3": "vicittā malayavitatā ",
  "tha-ap1:38.4": "sabbe dhārentu matthake. ",
  "tha-ap1:39.1": "vitatā malayadāmehi ",
  "tha-ap1:39.2": "gandhadāmehi sobhitā ",
  "tha-ap1:39.3": "dussadāmehi parikiṇṇā ",
  "tha-ap1:39.4": "ratanadāmabhūsitā. ",
  "tha-ap1:40.1": "pupphābhikiṇṇā suvicittā ",
  "tha-ap1:40.2": "surabhigandhadhūpitā ",
  "tha-ap1:40.3": "gandhapañcāṅgulaṅkatā ",
  "tha-ap1:40.4": "hemacchadanachāditā. ",
  "tha-ap1:41.1": "catuddisā pokkharañño ",
  "tha-ap1:41.2": "padumuppalasanthatā ",
  "tha-ap1:41.3": "sovaṇṇarūpe khāyantu ",
  "tha-ap1:41.4": "padumareṇurajuggatā. ",
  "tha-ap1:42.1": "pupphantu pādapā sabbe ",
  "tha-ap1:42.2": "pāsādassa samantato ",
  "tha-ap1:42.3": "sayañca pupphā muñcitvā ",
  "tha-ap1:42.4": "gantvā bhavanamokiruṃ. ",
  "tha-ap1:43.1": "sikhino tattha naccantu ",
  "tha-ap1:43.2": "dibbā haṃsā pakujjare ",
  "tha-ap1:43.3": "karavikā ca gāyantu ",
  "tha-ap1:43.4": "dijasaṅghā samantato. ",
  "tha-ap1:44.1": "bheriyo sabbā vajjantu ",
  "tha-ap1:44.2": "vīṇā sabbā ravantu tā ",
  "tha-ap1:44.3": "sabbā saṅgīti vattantu ",
  "tha-ap1:44.4": "pāsāda samantato. ",
  "tha-ap1:45.1": "yāvatā buddhakhettamhi ",
  "tha-ap1:45.2": "cakkavāḷā camūpari ",
  "tha-ap1:45.3": "mahantā jotisampannā ",
  "tha-ap1:45.4": "acchiddā ratanāmayā. ",
  "tha-ap1:46.1": "tiṭṭhantu soṇṇapallaṅkā ",
  "tha-ap1:46.2": "dīparukkhā jalantu te ",
  "tha-ap1:46.3": "bhavantu ekapajjotā ",
  "tha-ap1:46.4": "dasasahassaparamparā. ",
  "tha-ap1:47.1": "gaṇikā lāsikā ceva ",
  "tha-ap1:47.2": "naccantu accharāgaṇā ",
  "tha-ap1:47.3": "nānāraṅgā padissantu ",
  "tha-ap1:47.4": "pāsādassa samantato. ",
  "tha-ap1:48.1": "dumagge pabbatagge vā ",
  "tha-ap1:48.2": "sinerugirimuddhane ",
  "tha-ap1:48.3": "ussāpemi dhajaṃ sabbaṃ ",
  "tha-ap1:48.4": "vicittaṃ pañcavaṇṇikaṃ. ",
  "tha-ap1:49.1": "narā nāgā ca gandhabbā ",
  "tha-ap1:49.2": "sabbe devā upentu te ",
  "tha-ap1:49.3": "namassantā pañjalikā ",
  "tha-ap1:49.4": "pāsādaṃ parivārayuṃ. ",
  "tha-ap1:50.1": "yaṅkiñci kusalaṃ kammaṃ ",
  "tha-ap1:50.2": "kattabbaṃ kiriyaṃ mama ",
  "tha-ap1:50.3": "kāyena vācāmanasā ",
  "tha-ap1:50.4": "tidase sugataṃ kataṃ. ",
  "tha-ap1:51.1": "ye sattā saññino atthi ",
  "tha-ap1:51.2": "ye ca sattā asaññino ",
  "tha-ap1:51.3": "kataṃ puññaphalaṃ mayhaṃ ",
  "tha-ap1:51.4": "sabbe bhāgī bhavantu te. ",
