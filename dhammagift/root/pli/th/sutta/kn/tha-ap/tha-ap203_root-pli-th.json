{
  "tha-ap203:0.1": "ekavīsatimo kaṇikārapupphiyavaggo ",
  "tha-ap203:0.2": "",
  "tha-ap203:0.3": "",
  "tha-ap203:1.1": "paṭhamaṃ kaṇikārapupphiyattherāpadānaṃ (201) kaṇikāraṃ pupphitaṃ disvā ",
  "tha-ap203:1.2": "ocinitvānahaṃ tadā ",
  "tha-ap203:1.3": "tissassa abhiropesiṃ ",
  "tha-ap203:1.4": "oghatiṇṇassa tādino. ",
  "tha-ap203:2.1": "dvenavute ito kappe ",
  "tha-ap203:2.2": "yaṃ pupphamabhiropayiṃ ",
  "tha-ap203:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap203:2.4": "buddhapūjāyidaṃ phalaṃ. ",
  "tha-ap203:3.1": "pañcatiṃse ito kappe ",
  "tha-ap203:3.2": "aruṇapāloti vissuto ",
  "tha-ap203:3.3": "sattaratanasampanno ",
  "tha-ap203:3.4": "cakkavatti mahabbalo. ",
  "tha-ap203:4.1": "paṭisambhidā catasso ",
  "tha-ap203:4.2": "vimokkhāpica aṭṭhime ",
  "tha-ap203:4.3": "chaḷabhiññā sacchikatā ",
  "tha-ap203:4.4": "kataṃ buddhassa sāsananti. ",
  "tha-ap203:5.1": "itthaṃ sudaṃ āyasmā kaṇikārapupphiyo thero imā gāthāyo abhāsitthāti. ",
  "tha-ap203:6.1": "kaṇikārapupphiyattherassa apadānaṃ samattaṃ. dutiyaṃ minelapupphiyattherāpadānaṃ (202) "
}
