{
  "tha-ap509:0.1": "",
  "tha-ap509:0.2": "",
  "tha-ap509:0.3": "",
  "tha-ap509:1.1": "ajino nāma sambuddho ",
  "tha-ap509:1.2": "himavante vasi tadā ",
  "tha-ap509:1.3": "caraṇena ca sampanno ",
  "tha-ap509:1.4": "samādhikusalo muni. ",
  "tha-ap509:2.1": "kumbhamattaṃ gahetvāna ",
  "tha-ap509:2.2": "añjaliṃ jīvajīvakaṃ ",
  "tha-ap509:2.3": "chattapaṇṇaṃ gahetvāna ",
  "tha-ap509:2.4": "adāsiṃ satthuno ahaṃ. ",
  "tha-ap509:3.1": "catunavute ito kappe ",
  "tha-ap509:3.2": "yaṃ phalaṃ adadiṃ tadā ",
  "tha-ap509:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap509:3.4": "phaladānassidaṃ phalaṃ. ",
  "tha-ap509:4.1": "kilesā jhāpitā mayhaṃ ",
  "tha-ap509:4.2": "bhavā sabbe samūhatā nāgova bandhanaṃ chetvā ",
  "tha-ap509:4.3": "viharāmi anāsavo. ",
  "tha-ap509:5.1": "svāgataṃ vata me āsi ",
  "tha-ap509:5.2": "mama buddhassa santike tisso vijjā anuppattā ",
  "tha-ap509:5.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap509:6.1": "paṭisambhidā catasso ",
  "tha-ap509:6.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap509:6.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap509:7.1": "itthaṃ sudaṃ āyasmā ajjelaphaladāyako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap509:8.1": "ajjelaphaladāyakattherassa apadānaṃ samattaṃ. aṭṭhamaṃ amoraphaliyattherāpadānaṃ (508) "
}
