{
  "tha-ap12:0.1": "",
  "tha-ap12:0.2": "",
  "tha-ap12:0.3": "",
  "tha-ap12:1.1": "ārāmadvārā nikkhamma ",
  "tha-ap12:1.2": "padumuttaro mahāmuni ",
  "tha-ap12:1.3": "vassanto amatavuṭṭhiṃ ",
  "tha-ap12:1.4": "nibbāpesi mahājanaṃ. ",
  "tha-ap12:2.1": "satasahassā te dhīrā ",
  "tha-ap12:2.2": "chaḷabhiññā mahiddhikā ",
  "tha-ap12:2.3": "parivārenti sambuddhaṃ ",
  "tha-ap12:2.4": "chāyāva anupāyinī. ",
  "tha-ap12:3.1": "hatthikkhandhagato āsiṃ ",
  "tha-ap12:3.2": "setacchattaṃ varuttamaṃ ",
  "tha-ap12:3.3": "sutānurūpaṃ disvāna ",
  "tha-ap12:3.4": "pīti me upapajjatha. ",
  "tha-ap12:4.1": "oruyha hatthikkhandhamhā ",
  "tha-ap12:4.2": "upagañchiṃ narāsabhaṃ ",
  "tha-ap12:4.3": "ratanamayaṃ chattaṃ me ",
  "tha-ap12:4.4": "buddhaseṭṭhassa dhārayiṃ. ",
  "tha-ap12:5.1": "mama saṅkappamaññāya ",
  "tha-ap12:5.2": "padumuttaro mahāisi ",
  "tha-ap12:5.3": "taṃ kathaṃ ṭhapayitvāna ",
  "tha-ap12:5.4": "imā gāthā abhāsatha. ",
  "tha-ap12:6.1": "yo so chattaṃ adhārayi ",
  "tha-ap12:6.2": "soṇṇalaṅkārabhūsitaṃ ",
  "tha-ap12:6.3": "tamahaṃ kittayissāmi ",
  "tha-ap12:6.4": "suṇātha mama bhāsato. ",
  "tha-ap12:7.1": "ito gantvā ayaṃ poso ",
  "tha-ap12:7.2": "tusitaṃ āvasissati ",
  "tha-ap12:7.3": "anubhossati sampattiṃ ",
  "tha-ap12:7.4": "accharāhi purakkhato. ",
  "tha-ap12:8.1": "catuttiṃsatikkhattuṃ ca ",
  "tha-ap12:8.2": "devarajjaṃ karissati ",
  "tha-ap12:8.3": "narādhipo aṭṭhasataṃ ",
  "tha-ap12:8.4": "vasudhaṃ āvasissati. ",
  "tha-ap12:9.1": "aṭṭhapaññāsakkhattuṃ ca ",
  "tha-ap12:9.2": "cakkavatti bhavissati ",
  "tha-ap12:9.3": "padesarajjaṃ vipulaṃ ",
  "tha-ap12:9.4": "mahiyā kārayissati. ",
  "tha-ap12:10.1": "kappasatasahassamhi ",
  "tha-ap12:10.2": "okkākakulasambhavo ",
  "tha-ap12:10.3": "gotamo nāma gottena ",
  "tha-ap12:10.4": "satthā loke bhavissati. ",
  "tha-ap12:11.1": "sakyānaṃ kulaketussa ",
  "tha-ap12:11.2": "ñātibandhu bhavissati ",
  "tha-ap12:11.3": "ānando nāma nāmena ",
  "tha-ap12:11.4": "upaṭṭhāko mahesino. ",
  "tha-ap12:12.1": "ātāpī nipako cāpi ",
  "tha-ap12:12.2": "bāhusaccesu kovido ",
  "tha-ap12:12.3": "nivātavutti atthaddho ",
  "tha-ap12:12.4": "sabbapāṭhī bhavissati. ",
  "tha-ap12:13.1": "padhānaṃ pahitatto so ",
  "tha-ap12:13.2": "upasanto nirūpadhi ",
  "tha-ap12:13.3": "sabbāsave pariññāya ",
  "tha-ap12:13.4": "nibbāyissatyanāsavo. ",
  "tha-ap12:14.1": "santi āraññakā nāgā ",
  "tha-ap12:14.2": "kuñjarā saṭṭhihāyanā ",
  "tha-ap12:14.3": "tidhappabhinnā mātaṅgā ",
  "tha-ap12:14.4": "īsādantā uruḷhavā. ",
  "tha-ap12:15.1": "anekasatasahassā ",
  "tha-ap12:15.2": "paṇḍitāpi mahiddhikā ",
  "tha-ap12:15.3": "sabbe te buddhanāgassa ",
  "tha-ap12:15.4": "na honti parivimbhitā. ",
  "tha-ap12:16.1": "ādiyāme namassāmi ",
  "tha-ap12:16.2": "majjhime atha pacchime ",
  "tha-ap12:16.3": "pasannacitto sumano ",
  "tha-ap12:16.4": "buddhaseṭṭhaṃ upaṭṭhahiṃ. ",
  "tha-ap12:17.1": "ātāpī nipako cāpi ",
  "tha-ap12:17.2": "sampajāno paṭissato ",
  "tha-ap12:17.3": "sotāpattiphalaṃ patto ",
  "tha-ap12:17.4": "sekhabhūmīsu kovido. ",
  "tha-ap12:18.1": "kappeto satasahasse ",
  "tha-ap12:18.2": "yaṃ kammamabhinīhariṃ ",
  "tha-ap12:18.3": "tāhaṃ bhūmiṃ anuppatto ",
  "tha-ap12:18.4": "ṭhitā saddhā mahapphalā. ",
  "tha-ap12:19.1": "svāgataṃ vata me āsi ",
  "tha-ap12:19.2": "buddhaseṭṭhassa santike ",
  "tha-ap12:19.3": "tisso vijjā anuppattā ",
  "tha-ap12:19.4": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap12:20.1": "paṭisambhidā catasso ",
  "tha-ap12:20.2": "vimokkhāpica aṭṭhime ",
  "tha-ap12:20.3": "chaḷabhiññā sacchikatā ",
  "tha-ap12:20.4": "kataṃ buddhassa sāsananti. ",
  "tha-ap12:21.1": "itthaṃ sudaṃ āyasmā ānando thero imā gāthāyo abhāsitthāti. ",
  "tha-ap12:22.1": "ānandattherassa apadānaṃ samattaṃ. ",
  "tha-ap12:23.1": "uddānaṃ ",
  "tha-ap12:24.1": "buddho paccekasambuddho ",
  "tha-ap12:24.2": "sārīputto ca kolito ",
  "tha-ap12:24.3": "kassapo anuruddho ca ",
  "tha-ap12:24.4": "puṇṇatthero upāli ca. ",
  "tha-ap12:25.1": "koṇḍañño cāpi piṇḍolo ",
  "tha-ap12:25.2": "revatonandapaṇḍito cha ",
  "tha-ap12:25.3": "satāni ca paññāsā ",
  "tha-ap12:25.4": "gāthāyo sabbapiṇḍitā. ",
  "tha-ap12:26.1": "apadāne buddhavaggo paṭhamo. "
}
