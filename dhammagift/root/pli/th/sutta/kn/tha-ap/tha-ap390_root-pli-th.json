{
  "tha-ap390:0.1": "",
  "tha-ap390:0.2": "",
  "tha-ap390:0.3": "",
  "tha-ap390:1.1": "ajjuno nāma sambuddho ",
  "tha-ap390:1.2": "himavante vasī tadā ",
  "tha-ap390:1.3": "caraṇena ca sampanno ",
  "tha-ap390:1.4": "samādhikusalo muni. ",
  "tha-ap390:2.1": "kumbhamattaṃ gahetvāna ",
  "tha-ap390:2.2": "panasaṃ jīvajīvakaṃ ",
  "tha-ap390:2.3": "chattapaṇṇe ṭhapetvāna ",
  "tha-ap390:2.4": "adāsiṃ satthuno ahaṃ. ",
  "tha-ap390:3.1": "ekanavute ito kappe ",
  "tha-ap390:3.2": "yaṃ phalaṃ adadiṃ tadā ",
  "tha-ap390:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap390:3.4": "phaladānassidaṃ phalaṃ. ",
  "tha-ap390:4.1": "svāgataṃ vata me āsi mama buddhassa santike tisso vijjā anuppattā kataṃ buddhassa sāsanaṃ. kilesā jhāpitā mayhaṃ ",
  "tha-ap390:4.2": "bhavā sabbe samūhatā nāgova bandhanaṃ chetvā ",
  "tha-ap390:4.3": "viharāmi anāsavo. ",
  "tha-ap390:5.1": "",
  "tha-ap390:5.2": "",
  "tha-ap390:5.3": "",
  "tha-ap390:6.1": "paṭisambhidā catasso ",
  "tha-ap390:6.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap390:6.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap390:7.1": "itthaṃ sudaṃ āyasmā panasaphaladāyako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap390:8.1": "panasaphaladāyakattherassa apadānaṃ samattaṃ. navamaṃ soṇakoṭivisattherāpadānaṃ (389) "
}
