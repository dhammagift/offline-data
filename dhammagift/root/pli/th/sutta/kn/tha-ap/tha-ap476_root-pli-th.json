{
  "tha-ap476:0.1": "",
  "tha-ap476:0.2": "",
  "tha-ap476:0.3": "",
  "tha-ap476:1.1": "vipassino bhagavato ",
  "tha-ap476:1.2": "bodhiyā pādaputtame ",
  "tha-ap476:1.3": "sumano bījaniṃ gayha ",
  "tha-ap476:1.4": "avījiṃ bodhimuttamaṃ. ",
  "tha-ap476:2.1": "ekanavute ito kappe ",
  "tha-ap476:2.2": "avījiṃ bodhimuttamaṃ ",
  "tha-ap476:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap476:2.4": "bījanāya idaṃ phalaṃ. ",
  "tha-ap476:3.1": "kilesā jhāpitā mayhaṃ ",
  "tha-ap476:3.2": "bhavā sabbe samūhatā nāgova bandhanaṃ chetvā ",
  "tha-ap476:3.3": "viharāmi anāsavo. ",
  "tha-ap476:4.1": "svāgataṃ vata me āsi ",
  "tha-ap476:4.2": "mama buddhassa santike tisso vijjā anuppattā ",
  "tha-ap476:4.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap476:5.1": "paṭisambhidā catasso ",
  "tha-ap476:5.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap476:5.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap476:6.1": "itthaṃ sudaṃ āyasmā sumanavījaniyo thero imā gāthāyo abhāsitthāti. ",
  "tha-ap476:7.1": "sumanavījaniyattherassa apadānaṃ samattaṃ. pañcamaṃ kummāsadāyakattherāpadānaṃ (475) "
}
