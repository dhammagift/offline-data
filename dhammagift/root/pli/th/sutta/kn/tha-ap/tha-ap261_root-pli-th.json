{
  "tha-ap261:0.1": "",
  "tha-ap261:0.2": "",
  "tha-ap261:0.3": "",
  "tha-ap261:1.1": "vipinaṃ cāri sambuddho ",
  "tha-ap261:1.2": "rukkhamūle vasi tadā ",
  "tha-ap261:1.3": "paṇṇasālaṃ karitvāna ",
  "tha-ap261:1.4": "adāsiṃ aparājite. ",
  "tha-ap261:2.1": "ekanavute ito kappe ",
  "tha-ap261:2.2": "yaṃ paṇṇakuṭikaṃ dadā ",
  "tha-ap261:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap261:2.4": "kuṭidānassidaṃ phalaṃ. ",
  "tha-ap261:3.1": "aṭṭhatiṃse ito kappe ",
  "tha-ap261:3.2": "soḷasāsiṃsu rājino ",
  "tha-ap261:3.3": "sabbattha abhivassīti ",
  "tha-ap261:3.4": "vuccare cakkavattino. ",
  "tha-ap261:4.1": "paṭisambhidā catasso ",
  "tha-ap261:4.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap261:4.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap261:5.1": "itthaṃ sudaṃ āyasmā kuṭidāyako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap261:6.1": "kuṭidāyakattherassa apadānaṃ samattaṃ. dasamaṃ aggapupphiyattherāpadānaṃ (260) "
}
