{
  "tha-ap258:0.1": "",
  "tha-ap258:0.2": "",
  "tha-ap258:0.3": "",
  "tha-ap258:1.1": "ahosiṃ candano nāma ",
  "tha-ap258:1.2": "sambuddhassatrajo tadā ",
  "tha-ap258:1.3": "ekopāhano mayā dinno ",
  "tha-ap258:1.4": "bodhi sampajja me tuvaṃ. ",
  "tha-ap258:2.1": "ekanavute ito kappe ",
  "tha-ap258:2.2": "yaṃ pāduṃ adadiṃ tadā ",
  "tha-ap258:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap258:2.4": "upāhanassidaṃ phalaṃ. ",
  "tha-ap258:3.1": "paṭisambhidā catasso ",
  "tha-ap258:3.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap258:3.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap258:4.1": "itthaṃ sudaṃ āyasmā upāhanadāyako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap258:5.1": "upāhanadāyakattherassa apadānaṃ samattaṃ. sattamaṃ mañjaripūjakattherāpadānaṃ (257) "
}
