{
  "tha-ap182:0.1": "",
  "tha-ap182:0.2": "",
  "tha-ap182:0.3": "",
  "tha-ap182:1.1": "vessabhumhi bhagavati ",
  "tha-ap182:1.2": "āsiṃ ārāmiko ahaṃ ",
  "tha-ap182:1.3": "pasannacitto sumano ",
  "tha-ap182:1.4": "upaṭṭhiṃ saṅghamuttamaṃ. ",
  "tha-ap182:2.1": "ekatiṃse ito kappe ",
  "tha-ap182:2.2": "yaṃ kammamakariṃ tadā ",
  "tha-ap182:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap182:2.4": "upaṭṭhānassidaṃ phalaṃ. ",
  "tha-ap182:3.1": "ito te sattame kappe ",
  "tha-ap182:3.2": "sattevāsuṃ samotthakā ",
  "tha-ap182:3.3": "sattaratanasampannā ",
  "tha-ap182:3.4": "cakkavattī mahabbalā. ",
  "tha-ap182:4.1": "paṭisambhidā catasso ",
  "tha-ap182:4.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap182:4.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap182:5.1": "itthaṃ sudaṃ āyasmā saṅghupaṭṭhāko thero imā gāthāyo abhāsitthāti. ",
  "tha-ap182:6.1": "saṅghupaṭṭhākattherassa apadānaṃ ",
  "tha-ap182:7.1": "samattaṃ. uddānaṃ ",
  "tha-ap182:8.1": "",
  "tha-ap182:9.1": "kumudo atha nisseṇī ",
  "tha-ap182:9.2": "rattiko udapānado ",
  "tha-ap182:9.3": "sīhāsanī maggappado ",
  "tha-ap182:9.4": "ekadīpī maṇippado ",
  "tha-ap182:9.5": "tikicchako upaṭṭhāko ",
  "tha-ap182:9.6": "ekūnapaññāsagāthakāti. kumudavaggo aṭṭhārasamo. "
}
