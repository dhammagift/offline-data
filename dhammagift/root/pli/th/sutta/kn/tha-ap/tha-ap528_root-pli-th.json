  "tha-ap528:0.1": "",
  "tha-ap528:0.2": "",
  "tha-ap528:0.3": "",
  "tha-ap528:1.1": "kānanaṃ vanamoggayha ",
  "tha-ap528:1.2": "veḷuṃ chetvānahaṃ tadā ",
  "tha-ap528:1.3": "ālambanaṃ karitvāna ",
  "tha-ap528:1.4": "saṅghassa adadiṃ ahaṃ. ",
  "tha-ap528:2.1": "tena cittappasādena ",
  "tha-ap528:2.2": "subbate abhivādayiṃ ",
  "tha-ap528:2.3": "ālambadaṇḍaṃ datvāna ",
  "tha-ap528:2.4": "pakkāmiṃ uttarāmukho. ",
  "tha-ap528:3.1": "catunavute ito kappe ",
  "tha-ap528:3.2": "yaṃ daṇḍamadadiṃ tadā ",
  "tha-ap528:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap528:3.4": "daṇḍadānassidaṃ phalaṃ. ",
  "tha-ap528:4.1": "kilesā jhāpitā mayhaṃ ",
  "tha-ap528:4.2": "bhavā sabbe samūhatā nāgova bandhanaṃ chetvā ",
  "tha-ap528:4.3": "viharāmi anāsavo. ",
  "tha-ap528:5.1": "svāgataṃ vata me āsi ",
  "tha-ap528:5.2": "mama buddhassa santike tisso vijjā anuppattā ",
  "tha-ap528:5.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap528:6.1": "paṭisambhidā catasso ",
  "tha-ap528:6.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap528:6.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap528:7.1": "itthaṃ sudaṃ āyasmā daṇḍadāyako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap528:8.1": "daṇḍadāyakattherassa apadānaṃ samattaṃ. ",
  "tha-ap528:8.2": "tevīsatimaṃ bhāṇavāraṃ. sattamaṃ girinelapūjakattherāpadānaṃ (527) "
}
