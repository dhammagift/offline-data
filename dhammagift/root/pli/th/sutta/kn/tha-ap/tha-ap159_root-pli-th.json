  "tha-ap159:0.1": "",
  "tha-ap159:0.2": "",
  "tha-ap159:0.3": "",
  "tha-ap159:1.1": "himavantassavidūre ",
  "tha-ap159:1.2": "bhūtagaṇo nāma pabbato ",
  "tha-ap159:1.3": "vasateko jino tattha ",
  "tha-ap159:1.4": "sayambhū lokanissaṭo. ",
  "tha-ap159:2.1": "tiṇasūle gahetvāna ",
  "tha-ap159:2.2": "buddhassa abhiropayiṃ ",
  "tha-ap159:2.3": "ekūnasatasahassa ",
  "tha-ap159:2.4": "kappaṃ na vinipātako. ",
  "tha-ap159:3.1": "ito ekādase kappe ",
  "tha-ap159:3.2": "ekosiṃ dharaṇīruho ",
  "tha-ap159:3.3": "sattaratanasampanno ",
  "tha-ap159:3.4": "cakkavatti mahabbalo. ",
  "tha-ap159:4.1": "paṭisambhidā catasso ",
  "tha-ap159:4.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap159:4.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap159:5.1": "itthaṃ sudaṃ āyasmā tiṇasūlako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap159:6.1": "tiṇasūlakattherassa apadānaṃ samattaṃ. aṭṭhamaṃ nāgapupphiyattherāpadānaṃ (158) "
}
