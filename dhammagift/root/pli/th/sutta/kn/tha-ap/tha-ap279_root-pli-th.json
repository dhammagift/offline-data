  "tha-ap279:0.1": "",
  "tha-ap279:0.2": "",
  "tha-ap279:0.3": "",
  "tha-ap279:1.1": "candabhāgānadītīre ",
  "tha-ap279:1.2": "anusotaṃ vajāmahaṃ ",
  "tha-ap279:1.3": "satta māluvapupphāni ",
  "tha-ap279:1.4": "citakāropayiṃ ahaṃ. ",
  "tha-ap279:2.1": "catunavute ito kappe ",
  "tha-ap279:2.2": "citakaṃ yaṃ apūjayiṃ ",
  "tha-ap279:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap279:2.4": "citapūjāyidaṃ phalaṃ. ",
  "tha-ap279:3.1": "sattasaṭṭhimhito kappe ",
  "tha-ap279:3.2": "paṭijaggasanāmako ",
  "tha-ap279:3.3": "sattaratanasampanno ",
  "tha-ap279:3.4": "cakkavatti mahabbalo. ",
  "tha-ap279:4.1": "paṭisambhidā catasso ",
  "tha-ap279:4.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap279:4.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap279:5.1": "itthaṃ sudaṃ āyasmā citakapūjako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap279:6.1": "citakapūjakattherassa apadānaṃ samattaṃ. aṭṭhamaṃ āluvadāyakattherāpadānaṃ (278) "
}
