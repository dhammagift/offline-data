{
  "tha-ap276:0.1": "",
  "tha-ap276:0.2": "",
  "tha-ap276:0.3": "",
  "tha-ap276:1.1": "koṇḍaññassa bhagavato ",
  "tha-ap276:1.2": "vītarāgassa tādino ",
  "tha-ap276:1.3": "akakkasassa cittassa ",
  "tha-ap276:1.4": "nipapañcassa jhāyino. ",
  "tha-ap276:2.1": "sabbamohātivattassa ",
  "tha-ap276:2.2": "sabbalokahitesino ",
  "tha-ap276:2.3": "abbhañjanaṃ mayā dinnaṃ ",
  "tha-ap276:2.4": "dipadindassa tādino. ",
  "tha-ap276:3.1": "aparimeyye ito kappe ",
  "tha-ap276:3.2": "abbhañjanamadāsahaṃ ",
  "tha-ap276:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap276:3.4": "abbhañjanassidaṃ phalaṃ. ",
  "tha-ap276:4.1": "ito paṇṇarase kappe ",
  "tha-ap276:4.2": "virappo nāma khattiyo ",
  "tha-ap276:4.3": "sattaratanasampanno ",
  "tha-ap276:4.4": "cakkavatti mahabbalo. ",
  "tha-ap276:5.1": "paṭisambhidā catasso ",
  "tha-ap276:5.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap276:5.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap276:6.1": "itthaṃ sudaṃ āyasmā abbhañjanadāyako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap276:7.1": "abbhañjanadāyakattherassa apadānaṃ samattaṃ. pañcamaṃ ekañjaliyattherāpadānaṃ (275) "
}
