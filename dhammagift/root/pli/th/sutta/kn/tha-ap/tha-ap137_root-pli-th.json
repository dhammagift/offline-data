  "tha-ap137:0.1": "",
  "tha-ap137:0.2": "",
  "tha-ap137:0.3": "",
  "tha-ap137:1.1": "himavantassavidūre ",
  "tha-ap137:1.2": "vasabho nāma pabbato ",
  "tha-ap137:1.3": "tasmiṃ pabbatapādamhi ",
  "tha-ap137:1.4": "assamo āsi māpito. ",
  "tha-ap137:2.1": "tīṇi sissasahassāni ",
  "tha-ap137:2.2": "vācesiṃ brāhmaṇo tadā ",
  "tha-ap137:2.3": "saṃsāvitvāna te sisse ",
  "tha-ap137:2.4": "ekamantaṃ upāvisiṃ. ",
  "tha-ap137:3.1": "ekamantaṃ nisīditvā ",
  "tha-ap137:3.2": "brāhmaṇo mantapāragū ",
  "tha-ap137:3.3": "buddhavesaṃ gavesanto ",
  "tha-ap137:3.4": "ñāṇe cittaṃ pasādayi. ",
  "tha-ap137:4.1": "tattha cittaṃ pasādetvā ",
  "tha-ap137:4.2": "nisīdi paṇṇasanthare ",
  "tha-ap137:4.3": "pallaṅkaṃ ābhujitvāna ",
  "tha-ap137:4.4": "tattha kālaṃ kato ahaṃ. ",
  "tha-ap137:5.1": "ekatiṃse ito kappe ",
  "tha-ap137:5.2": "yaṃ saññamalabhiṃ tadā ",
  "tha-ap137:5.3": "duggatiṃ nābhijānāmi ",
  "tha-ap137:5.4": "ñāṇasaññāyidaṃ phalaṃ. ",
  "tha-ap137:6.1": "sattavīsamhi kappamhi ",
  "tha-ap137:6.2": "rājā sirīdharo ahu ",
  "tha-ap137:6.3": "sattaratanasampanno ",
  "tha-ap137:6.4": "cakkavatti mahabbalo. ",
  "tha-ap137:7.1": "paṭisambhidā catasso ",
  "tha-ap137:7.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap137:7.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap137:8.1": "itthaṃ sudaṃ āyasmā rahosaññiko thero imā gāthāyo abhāsitthāti. ",
  "tha-ap137:9.1": "rahosaññikattherassa apadānaṃ samattaṃ. chaṭṭhaṃ campakapupphiyattherāpadānaṃ (136) "
}
