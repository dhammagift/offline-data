{
  "tha-ap432:0.1": "",
  "tha-ap432:0.2": "",
  "tha-ap432:0.3": "",
  "tha-ap432:1.1": "manobhāvaniyaṃ buddhaṃ ",
  "tha-ap432:1.2": "attadantaṃ samāhitaṃ ",
  "tha-ap432:1.3": "iriyamānaṃ brahmapathe ",
  "tha-ap432:1.4": "cittavūpasame rataṃ. ",
  "tha-ap432:2.1": "nitiṇṇaogha sambuddhaṃ ",
  "tha-ap432:2.2": "jhāyiṃ jhānarataṃ muniṃ ",
  "tha-ap432:2.3": "upaviṭṭhaṃ samāpattiṃ ",
  "tha-ap432:2.4": "indriyasaṃvarappahaṃ. ",
  "tha-ap432:3.1": "alāvunodakaṃ gayha ",
  "tha-ap432:3.2": "buddhaseṭṭhaṃ upāgamiṃ ",
  "tha-ap432:3.3": "buddhapāde dhovitvāna alāvukamadāsahaṃ. ",
  "tha-ap432:3.4": "",
  "tha-ap432:4.1": "āṇāpesi ca sambuddho ",
  "tha-ap432:4.2": "padumuttaranāmako ",
  "tha-ap432:4.3": "iminodakamāhatvā ",
  "tha-ap432:4.4": "pādamūle ṭhapehi me. ",
  "tha-ap432:5.1": "sādhūtihaṃ paṭissutvā ",
  "tha-ap432:5.2": "satthu gāravatāyava ",
  "tha-ap432:5.3": "udakaṃ lāvunāhatvā ",
  "tha-ap432:5.4": "buddhaseṭṭhaṃ upānayiṃ. ",
  "tha-ap432:6.1": "anumodi mahāvīro ",
  "tha-ap432:6.2": "cittaṃ nibbāpayaṃ mama ",
  "tha-ap432:6.3": "iminā lāvudānena ",
  "tha-ap432:6.4": "saṅkappo te samijjhatu. ",
  "tha-ap432:7.1": "paṇṇarase ito kappe ",
  "tha-ap432:7.2": "devaloke ramiṃ ahaṃ ",
  "tha-ap432:7.3": "tettiṃsakkhattuṃ rājā ca ",
  "tha-ap432:7.4": "cakkavatti ahosahaṃ. ",
  "tha-ap432:8.1": "divā vā yadivā rattiṃ ",
  "tha-ap432:8.2": "caṅkamantassa tiṭṭhato ",
  "tha-ap432:8.3": "sovaṇṇaṃ kontaraṃ gayha ",
  "tha-ap432:8.4": "tiṭṭhanti purato mama. ",
  "tha-ap432:9.1": "buddhassa datvāna lāvuṃ ",
  "tha-ap432:9.2": "labhāmi soṇṇakontaraṃ ",
  "tha-ap432:9.3": "appakaṃpi karaṃ kāraṃ ",
  "tha-ap432:9.4": "vipulaṃ hoti tādisu. ",
  "tha-ap432:10.1": "satasahasse ito kappe ",
  "tha-ap432:10.2": "yaṃ lāvumadadiṃ tadā ",
  "tha-ap432:10.3": "duggatiṃ nābhijānāmi ",
  "tha-ap432:10.4": "alāvussa idaṃ phalaṃ. ",
  "tha-ap432:11.1": "kilesā jhāpitā mayhaṃ ",
  "tha-ap432:11.2": "bhavā sabbe samūhatā nāgova bandhanaṃ chetvā ",
  "tha-ap432:11.3": "viharāmi anāsavo. ",
  "tha-ap432:12.1": "svāgataṃ vata me āsi ",
  "tha-ap432:12.2": "mama buddhassa santike tisso vijjā anuppattā ",
  "tha-ap432:12.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap432:13.1": "paṭisambhidā catasso ",
  "tha-ap432:13.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap432:13.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap432:14.1": "itthaṃ sudaṃ āyasmā sovaṇṇakontariko thero imā gāthāyo abhāsitthāti. ",
  "tha-ap432:15.1": "sovaṇṇakontarikattherassa apadānaṃ ",
  "tha-ap432:16.1": "samattaṃ. uddānaṃ ",
  "tha-ap432:17.1": "",
  "tha-ap432:18.1": "sakiṃsammajjako thero ",
  "tha-ap432:18.2": "ekadussāsanappadā kadamba ",
  "tha-ap432:18.3": "koraṇḍakadā ",
  "tha-ap432:18.4": "ghaṭa savanikopica ",
  "tha-ap432:19.1": "sucintito kiṃkaṇiko ",
  "tha-ap432:19.2": "soṇṇakontarikopica ",
  "tha-ap432:19.3": "ekagāthāsatañcettha ",
  "tha-ap432:19.4": "ekasattatimeva ca. sakiṃsammajjakavaggo tecattāḷīso. "
}
