{
  "tha-ap507:0.1": "",
  "tha-ap507:0.2": "",
  "tha-ap507:0.3": "",
  "tha-ap507:1.1": "suvaṇṇavaṇṇaṃ sambuddhaṃ ",
  "tha-ap507:1.2": "āhutīnaṃ paṭiggahaṃ ",
  "tha-ap507:1.3": "rathiyaṃ paṭipajjantaṃ ",
  "tha-ap507:1.4": "cāraphalamadāsahaṃ. ekanavute ",
  "tha-ap507:2.1": "ito kappe ",
  "tha-ap507:2.2": "yaṃ phalaṃ adadiṃ tadā ",
  "tha-ap507:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap507:2.4": "phaladānassidaṃ phalaṃ. ",
  "tha-ap507:3.1": "kilesā jhāpitā mayhaṃ ",
  "tha-ap507:3.2": "bhavā sabbe samūhatā nāgova bandhanaṃ chetvā ",
  "tha-ap507:3.3": "viharāmi anāsavo. ",
  "tha-ap507:4.1": "svāgataṃ vata me āsi ",
  "tha-ap507:4.2": "mama buddhassa santike tisso vijjā anuppattā ",
  "tha-ap507:4.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap507:5.1": "paṭisambhidā catasso ",
  "tha-ap507:5.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap507:5.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap507:6.1": "itthaṃ sudaṃ āyasmā cāraphaliyo thero imā gāthāyo abhāsitthāti. ",
  "tha-ap507:7.1": "cāraphaliyattherassa apadānaṃ samattaṃ. chaṭṭhaṃ mātuluṅgaphaladāyakattherāpadānaṃ (506) "
}
