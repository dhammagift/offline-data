  "tha-ap445:0.1": "",
  "tha-ap445:0.2": "",
  "tha-ap445:0.3": "",
  "tha-ap445:1.1": "candabhāgānadītīre ",
  "tha-ap445:1.2": "assamo sukato mama ",
  "tha-ap445:1.3": "veluvarukkhehi ākiṇṇo ",
  "tha-ap445:1.4": "nānādumanisevito. ",
  "tha-ap445:2.1": "sugandhaṃ veluvaṃ disvā ",
  "tha-ap445:2.2": "buddhaseṭṭhaṃ anussariṃ ",
  "tha-ap445:2.3": "khāribhāraṃ pūrayitvā ",
  "tha-ap445:2.4": "tuṭṭho saṃviggamānaso. ",
  "tha-ap445:3.1": "kakusandhaṃ upāgamma ",
  "tha-ap445:3.2": "billapakkamadāsahaṃ ",
  "tha-ap445:3.3": "puññakkhettassa dhīrassa ",
  "tha-ap445:3.4": "vippasannena cetasā. ",
  "tha-ap445:4.1": "imasmiṃyeva kappasmiṃ ",
  "tha-ap445:4.2": "yaṃ phalaṃ adadiṃ tadā ",
  "tha-ap445:4.3": "duggatiṃ nābhijānāmi ",
  "tha-ap445:4.4": "phaladānassidaṃ phalaṃ. ",
  "tha-ap445:5.1": "kilesā jhāpitā mayhaṃ ",
  "tha-ap445:5.2": "bhavā sabbe samūhatā nāgova bandhanaṃ chetvā ",
  "tha-ap445:5.3": "viharāmi anāsavo. ",
  "tha-ap445:6.1": "svāgataṃ vata me āsi ",
  "tha-ap445:6.2": "mama buddhassa santike tisso vijjā anuppattā ",
  "tha-ap445:6.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap445:7.1": "paṭisambhidā catasso ",
  "tha-ap445:7.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap445:7.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap445:8.1": "itthaṃ sudaṃ āyasmā veluvaphaliyo thero imā gāthāyo abhāsitthāti. ",
  "tha-ap445:9.1": "veluvaphaliyattherassa apadānaṃ samattaṃ. catutthaṃ bhallātakadāyakattherāpadānaṃ (444) "
}
