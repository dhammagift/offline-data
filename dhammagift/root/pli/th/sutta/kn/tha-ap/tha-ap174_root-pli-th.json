{
  "tha-ap174:0.1": "",
  "tha-ap174:0.2": "",
  "tha-ap174:0.3": "",
  "tha-ap174:1.1": "koṇḍaññassa bhagavato ",
  "tha-ap174:1.2": "lokanāthassa tādino ",
  "tha-ap174:1.3": "ārohatthāya pāsādaṃ ",
  "tha-ap174:1.4": "nisseṇī kāritā mayā. ",
  "tha-ap174:2.1": "tena cittappasādena ",
  "tha-ap174:2.2": "anubhotvāna sampadā ",
  "tha-ap174:2.3": "dhāremi antimaṃ dehaṃ ",
  "tha-ap174:2.4": "sammāsambuddhasāsane. ",
  "tha-ap174:3.1": "ekatiṃsamhi kappānaṃ ",
  "tha-ap174:3.2": "sahassamhi tayo mahā ",
  "tha-ap174:3.3": "sambahulā nāma rājāno ",
  "tha-ap174:3.4": "cakkavattī mahabbalā. ",
  "tha-ap174:4.1": "paṭisambhidā catasso ",
  "tha-ap174:4.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap174:4.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap174:5.1": "itthaṃ sudaṃ āyasmā nisseṇīdāyako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap174:6.1": "nisseṇīdāyakattherassa apadānaṃ samattaṃ. tatiyaṃ rattiyapupphiyattherāpadānaṃ (173) "
}
