{
  "tha-ap38:0.1": "",
  "tha-ap38:0.2": "",
  "tha-ap38:0.3": "",
  "tha-ap38:1.1": "nibbute lokanāthamhi ",
  "tha-ap38:1.2": "atthadassinaruttame ",
  "tha-ap38:1.3": "nimantetvā bhikkhusaṅghaṃ ",
  "tha-ap38:1.4": "vippasannena cetasā. ",
  "tha-ap38:2.1": "nimantetvā saṅgharatanaṃ ",
  "tha-ap38:2.2": "ujubhūtaṃ samāhitaṃ ",
  "tha-ap38:2.3": "ucchunā maṇḍapaṃ katvā ",
  "tha-ap38:2.4": "bhojesiṃ saṅghamuttamaṃ. ",
  "tha-ap38:3.1": "yaṃ yaṃ yonūpapajjāmi ",
  "tha-ap38:3.2": "devattaṃ atha mānusaṃ ",
  "tha-ap38:3.3": "sabbe satte abhibhomi ",
  "tha-ap38:3.4": "puññakammassidaṃ phalaṃ. ",
  "tha-ap38:4.1": "aṭṭhārase kappasate ",
  "tha-ap38:4.2": "yaṃ dānamadadiṃ tadā ",
  "tha-ap38:4.3": "duggatiṃ nābhijānāmi ",
  "tha-ap38:4.4": "ucchudānassidaṃ phalaṃ. ",
  "tha-ap38:5.1": "paṭisambhidā catasso ",
  "tha-ap38:5.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap38:5.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap38:6.1": "itthaṃ sudaṃ āyasmā adhimuttako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap38:7.1": "adhimuttakattherassa apadānaṃ samattaṃ. sattamaṃ lasuṇadāyakattherāpadānaṃ (37) "
}
