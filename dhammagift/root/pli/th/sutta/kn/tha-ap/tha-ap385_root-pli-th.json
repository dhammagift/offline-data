{
  "tha-ap385:0.1": "",
  "tha-ap385:0.2": "",
  "tha-ap385:0.3": "",
  "tha-ap385:1.1": "ninnagānadiyā tīre ",
  "tha-ap385:1.2": "vihāsi purisuttamo ",
  "tha-ap385:1.3": "addasaṃ virajaṃ buddhaṃ ",
  "tha-ap385:1.4": "ekaggaṃ susamāhitaṃ. ",
  "tha-ap385:2.1": "tasmiṃ pasannamānaso ",
  "tha-ap385:2.2": "kilesamaladhovane ",
  "tha-ap385:2.3": "udumbaraphalaṃ gayha ",
  "tha-ap385:2.4": "buddhaseṭṭhassadāsahaṃ. ",
  "tha-ap385:3.1": "ekanavute ito kappe ",
  "tha-ap385:3.2": "yaṃ phalaṃ adadiṃ tadā ",
  "tha-ap385:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap385:3.4": "phaladānassidaṃ phalaṃ. ",
  "tha-ap385:4.1": "svāgataṃ vata me āsi mama buddhassa santike tisso vijjā anuppattā kataṃ buddhassa sāsanaṃ. kilesā jhāpitā mayhaṃ ",
  "tha-ap385:4.2": "bhavā sabbe samūhatā nāgova bandhanaṃ chetvā ",
  "tha-ap385:4.3": "viharāmi anāsavo. ",
  "tha-ap385:5.1": "",
  "tha-ap385:5.2": "",
  "tha-ap385:5.3": "",
  "tha-ap385:6.1": "paṭisambhidā catasso ",
  "tha-ap385:6.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap385:6.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap385:7.1": "itthaṃ sudaṃ āyasmā udumbaraphaladāyako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap385:8.1": "udumbaraphaladāyakattherassa apadānaṃ samattaṃ. catutthaṃ milakkhuphaladāyakattherāpadānaṃ (384) "
}
