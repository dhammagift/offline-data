{
  "tha-ap242:0.1": "",
  "tha-ap242:0.2": "",
  "tha-ap242:0.3": "",
  "tha-ap242:1.1": "kammārohaṃ pure āsiṃ ",
  "tha-ap242:1.2": "tivarāyaṃ puruttame ",
  "tha-ap242:1.3": "ekā vāsi mayā dinnā ",
  "tha-ap242:1.4": "sayambhuṃ aparājitaṃ. ",
  "tha-ap242:2.1": "catunavute ito kappe ",
  "tha-ap242:2.2": "yaṃ vāsimadadiṃ tadā ",
  "tha-ap242:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap242:2.4": "vāsidānassidaṃ phalaṃ. ",
  "tha-ap242:3.1": "paṭisambhidā catasso ",
  "tha-ap242:3.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap242:3.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap242:4.1": "itthaṃ sudaṃ āyasmā vāsidāyako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap242:5.1": "vāsidāyakattherassa apadānaṃ ",
  "tha-ap242:6.1": "samattaṃ. uddānaṃ ",
  "tha-ap242:7.1": "udakāsani ",
  "tha-ap242:8.1": "bhājaniyo ",
  "tha-ap242:8.2": "sālapupphī kilañjado ",
  "tha-ap242:8.3": "vedikā vaṇṇakāro ca ",
  "tha-ap242:8.4": "piyālaambayāgado ",
  "tha-ap242:8.5": "jagatī vāsidāyī ca ",
  "tha-ap242:8.6": "gāthā tiṃsa ca aṭṭha cāti. udakāsanadāyivaggo catubbīso. "
}
