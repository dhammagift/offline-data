{
  "tha-ap280:0.1": "",
  "tha-ap280:0.2": "",
  "tha-ap280:0.3": "",
  "tha-ap280:1.1": "pabbate himavantamhi ",
  "tha-ap280:1.2": "mahāsindhu sudassano ",
  "tha-ap280:1.3": "tatthaddasaṃ vītarāgaṃ ",
  "tha-ap280:1.4": "sampabhāsaṃ sudassanaṃ. ",
  "tha-ap280:2.1": "paramopasame yuttaṃ ",
  "tha-ap280:2.2": "disvā vimhitamānaso ",
  "tha-ap280:2.3": "āluvaṃ tassa pādāsiṃ ",
  "tha-ap280:2.4": "pasanno sehi pāṇihi. ",
  "tha-ap280:3.1": "ekatiṃse ito kappe ",
  "tha-ap280:3.2": "yaṃ āluvamadāsahaṃ ",
  "tha-ap280:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap280:3.4": "āluvassa idaṃ phalaṃ. ",
  "tha-ap280:4.1": "paṭisambhidā catasso ",
  "tha-ap280:4.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap280:4.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap280:5.1": "itthaṃ sudaṃ āyasmā āluvadāyako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap280:6.1": "āluvadāyakattherassa apadānaṃ samattaṃ. navamaṃ puṇḍarīkattherāpadānaṃ (279) "
}
