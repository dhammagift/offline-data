  "tha-ap307:0.1": "",
  "tha-ap307:0.2": "",
  "tha-ap307:0.3": "",
  "tha-ap307:1.1": "bhāgīrasīnadītīre ",
  "tha-ap307:1.2": "ahosi assamo tadā ",
  "tha-ap307:1.3": "tamahaṃ assamāgañchiṃ ",
  "tha-ap307:1.4": "phalahattho asekkhavā. ",
  "tha-ap307:2.1": "vipassiṃ tattha addakkhiṃ ",
  "tha-ap307:2.2": "pītaraṃsīva bhāṇumaṃ ",
  "tha-ap307:2.3": "yaṃ me atthi phalaṃ sabbaṃ ",
  "tha-ap307:2.4": "adāsiṃ satthuno ahaṃ. ",
  "tha-ap307:3.1": "ekanavute ito kappe ",
  "tha-ap307:3.2": "yaṃ phalaṃ adadiṃ tadā ",
  "tha-ap307:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap307:3.4": "phaladānassidaṃ phalaṃ. ",
  "tha-ap307:4.1": "paṭisambhidā catasso ",
  "tha-ap307:4.2": "vimokkhāpica aṭṭhime chaḷabhiññā sacchikatā ",
  "tha-ap307:4.3": "kataṃ buddhassa sāsananti. ",
  "tha-ap307:5.1": "itthaṃ sudaṃ āyasmā phaladāyako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap307:6.1": "phaladāyakattherassa apadānaṃ samattaṃ. chaṭṭhaṃ sampasādikattherāpadānaṃ (306) "
}
