{
  "an5.15:0.1": "",
  "an5.15:0.2": "",
  "an5.15:0.3": "",
  "an5.15:1.1": "pañcimāni bhikkhave balāni ",
  "an5.15:1.2": "katamāni pañca ",
  "an5.15:1.3": "saddhābalaṃ viriyabalaṃ satibalaṃ samādhibalaṃ paññābalaṃ ",
  "an5.15:1.4": "kattha ca bhikkhave saddhābalaṃ daṭṭhabbaṃ ",
  "an5.15:1.5": "catūsu sotāpattiyaṅgesu ",
  "an5.15:1.6": "ettha saddhābalaṃ daṭṭhabbaṃ. ",
  "an5.15:1.7": "kattha ca bhikkhave viriyabalaṃ daṭṭhabbaṃ ",
  "an5.15:1.8": "catūsu sammappadhānesu ",
  "an5.15:1.9": "ettha viriyabalaṃ daṭṭhabbaṃ ",
  "an5.15:1.10": "kattha ca bhikkhave satibalaṃ daṭṭhabbaṃ ",
  "an5.15:1.11": "catūsu satipaṭṭhānesu ",
  "an5.15:1.12": "ettha satibalaṃ daṭṭhabbaṃ. ",
  "an5.15:1.13": "kattha ca bhikkhave samādhibalaṃ daṭṭhabbaṃ ",
  "an5.15:1.14": "catūsu jhānesu ",
  "an5.15:1.15": "ettha samādhibalaṃ daṭṭhabbaṃ. ",
  "an5.15:1.16": "kattha ca bhikkhave paññābalaṃ daṭṭhabbaṃ ",
  "an5.15:1.17": "catūsu ariyasaccesu ",
  "an5.15:1.18": "ettha paññābalaṃ daṭṭhabbaṃ. ",
  "an5.15:1.19": "imāni kho bhikkhave pañca balānīti. ",
  "an5.15:1.20": ""
}
