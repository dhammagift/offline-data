{
  "an5.35:0.1": "",
  "an5.35:0.2": "",
  "an5.35:0.3": "",
  "an5.35:1.1": "pañcime bhikkhave dāne ānisaṃsā ",
  "an5.35:1.2": "katame pañca ",
  "an5.35:1.3": "bahuno janassa piyo hoti manāpo ",
  "an5.35:1.4": "santo sappurisā bhajanti ",
  "an5.35:1.5": "kalyāṇo kittisaddo abbhuggacchati ",
  "an5.35:1.6": "gihidhammā anapagato hoti ",
  "an5.35:1.7": "kāyassa bhedā parammaraṇā sugatiṃ saggaṃ lokaṃ upapajjati ",
  "an5.35:1.8": "ime kho bhikkhave pañca dāne ānisaṃsāti. ",
  "an5.35:2.1": "dadamāno piyo hoti ",
  "an5.35:2.2": "sataṃ dhammaṃ anukkamaṃ ",
  "an5.35:2.3": "santo naṃ sadā bhajanti ",
  "an5.35:2.4": "saññatā brahmacārayo ",
  "an5.35:3.1": "te tassa dhammaṃ desenti ",
  "an5.35:3.2": "sabbadukkhāpanūdanaṃ ",
  "an5.35:3.3": "yaṃ so dhammaṃ idhaññāya ",
  "an5.35:3.4": "parinibbātanāsavoti. ",
  "an5.35:3.5": ""
}
