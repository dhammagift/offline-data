  "an5.117:1.1": "pañcahi bhikkhave dhammehi samannāgatā bhikkhunī yathābhataṃ nikkhittā evaṃ niraye ",
  "an5.117:1.2": "katamehi pañcahi ",
  "an5.117:1.3": "ananuvicca apariyogāhetvā avaṇṇārahassa vaṇṇaṃ bhāsati ",
  "an5.117:1.4": "ananuvicca apariyogāhetvā vaṇṇārahassa avaṇṇaṃ bhāsati ",
  "an5.117:1.5": "issukinī ca hoti ",
  "an5.117:1.6": "maccharinī ca ",
  "an5.117:1.7": "saddhādeyyañca vinipāteti. ",
  "an5.117:1.8": "imehi kho …pe… ",
  "an5.117:2.1": "pañcahi bhikkhave dhammehi samannāgatā bhikkhunī yathābhataṃ nikkhittā evaṃ sagge ",
  "an5.117:2.2": "katamehi pañcahi ",
  "an5.117:2.3": "anuvicca pariyogāhetvā avaṇṇārahassa avaṇṇaṃ bhāsati ",
  "an5.117:2.4": "anuvicca pariyogāhetvā vaṇṇārahassa vaṇṇaṃ bhāsati ",
  "an5.117:2.5": "anissukinī ca hoti ",
  "an5.117:2.6": "amaccharinī ca ",
  "an5.117:2.7": "saddhādeyyañca na vinipāteti. ",
  "an5.117:2.8": "imehi kho …pe… ",
  "an5.117:2.9": ""
}
