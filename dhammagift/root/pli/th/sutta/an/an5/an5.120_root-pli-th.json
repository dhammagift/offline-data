  "an5.120:0.1": "",
  "an5.120:0.2": "",
  "an5.120:0.3": "",
  "an5.120:1.1": "pañcahi bhikkhave dhammehi samannāgatā bhikkhunī yathābhataṃ nikkhittā evaṃ niraye ",
  "an5.120:1.2": "katamehi pañcahi ",
  "an5.120:1.3": "ananuvicca apariyogāhetvā avaṇṇārahassa vaṇṇaṃ bhāsati ",
  "an5.120:1.4": "ananuvicca apariyogāhetvā vaṇṇārahassa avaṇṇaṃ bhāsati ",
  "an5.120:1.5": "micchāvāyāmā ca hoti ",
  "an5.120:1.6": "micchāsati ca ",
  "an5.120:1.7": "saddhādeyyañca vinipāteti. ",
  "an5.120:1.8": "imehi kho …pe… ",
  "an5.120:2.1": "pañcahi bhikkhave dhammehi samannāgatā bhikkhunī yathābhataṃ nikkhittā evaṃ sagge ",
  "an5.120:2.2": "katamehi pañcahi ",
  "an5.120:2.3": "anuvicca pariyogāhetvā avaṇṇārahassa avaṇṇaṃ bhāsati ",
  "an5.120:2.4": "anuvicca pariyogāhetvā vaṇṇārahassa vaṇṇaṃ bhāsati ",
  "an5.120:2.5": "sammāvāyāmā ca hoti ",
  "an5.120:2.6": "sammāsati ca ",
  "an5.120:2.7": "saddhādeyyañca na vinipāteti. ",
  "an5.120:2.8": "imehi kho …pe… ",
  "an5.120:2.9": "",
  "an5.120:2.10": "andhakavindavaggo dutiyo. ",
  "an5.120:3.0": "tassuddānaṃ ",
  "an5.120:3.1": "kulūpako pacchāsamaṇo ",
  "an5.120:3.2": "samādhi andhakavindaṃ ",
  "an5.120:3.3": "maccharī vaṇṇanā issā ",
  "an5.120:3.4": "diṭṭhi vācāya vāyamoti. "
}
