  "an5.119:0.3": "",
  "an5.119:1.1": "pañcahi bhikkhave dhammehi samannāgatā bhikkhunī yathābhataṃ nikkhittā evaṃ niraye ",
  "an5.119:1.2": "katamehi pañcahi ",
  "an5.119:1.3": "ananuvicca apariyogāhetvā avaṇṇārahassa vaṇṇaṃ bhāsati ",
  "an5.119:1.4": "ananuvicca apariyogāhetvā vaṇṇārahassa avaṇṇaṃ bhāsati ",
  "an5.119:1.5": "micchāvācā ca hoti ",
  "an5.119:1.6": "micchākammantā ca ",
  "an5.119:1.7": "saddhādeyyañca vinipāteti. ",
  "an5.119:1.8": "imehi kho …pe… ",
  "an5.119:2.1": "pañcahi bhikkhave dhammehi samannāgatā bhikkhunī yathābhataṃ nikkhittā evaṃ sagge ",
  "an5.119:2.2": "katamehi pañcahi ",
  "an5.119:2.3": "anuvicca pariyogāhetvā avaṇṇārahassa avaṇṇaṃ bhāsati ",
  "an5.119:2.4": "anuvicca pariyogāhetvā vaṇṇārahassa vaṇṇaṃ bhāsati ",
  "an5.119:2.5": "sammāvācā ca hoti ",
  "an5.119:2.6": "sammākammantā ca ",
  "an5.119:2.7": "saddhādeyyañca na vinipāteti. ",
  "an5.119:2.8": "imehi kho …pe… ",
  "an5.119:2.9": ""
}
