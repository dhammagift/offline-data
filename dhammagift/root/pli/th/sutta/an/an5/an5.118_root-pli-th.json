  "an5.118:0.3": "",
  "an5.118:1.1": "pañcahi bhikkhave dhammehi samannāgatā bhikkhunī yathābhataṃ nikkhittā evaṃ niraye ",
  "an5.118:1.2": "katamehi pañcahi ",
  "an5.118:1.3": "ananuvicca apariyogāhetvā avaṇṇārahassa vaṇṇaṃ bhāsati ",
  "an5.118:1.4": "ananuvicca apariyogāhetvā vaṇṇārahassa avaṇṇaṃ bhāsati ",
  "an5.118:1.5": "micchādiṭṭhikā ca hoti ",
  "an5.118:1.6": "micchāsaṃkappā ca ",
  "an5.118:1.7": "saddhādeyyañca vinipāteti. ",
  "an5.118:1.8": "imehi kho …pe… ",
  "an5.118:2.1": "pañcahi bhikkhave dhammehi samannāgatā bhikkhunī yathābhataṃ nikkhittā evaṃ sagge ",
  "an5.118:2.2": "katamehi pañcahi ",
  "an5.118:2.3": "anuvicca pariyogāhetvā avaṇṇārahassa avaṇṇaṃ bhāsati ",
  "an5.118:2.4": "anuvicca pariyogāhetvā vaṇṇārahassa vaṇṇaṃ bhāsati ",
  "an5.118:2.5": "sammādiṭṭhikā ca hoti ",
  "an5.118:2.6": "sammāsaṃkappā ca ",
  "an5.118:2.7": "saddhādeyyañca na vinipāteti. ",
  "an5.118:2.8": "imehi kho …pe… ",
  "an5.118:2.9": ""
}
