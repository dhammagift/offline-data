  "an5.93:0.1": "",
  "an5.93:0.2": "",
  "an5.93:0.3": "",
  "an5.93:1.1": "pañcimāni bhikkhave aññābyākaraṇāni ",
  "an5.93:1.2": "katamāni pañca ",
  "an5.93:1.3": "mandattā momūhattā aññaṃ byākaroti ",
  "an5.93:1.4": "pāpiccho icchāpakato aññaṃ byākaroti ",
  "an5.93:1.5": "ummādā cittakkhepā aññaṃ byākaroti ",
  "an5.93:1.6": "adhimānena aññaṃ byākaroti ",
  "an5.93:1.7": "sammadeva aññaṃ byākaroti ",
  "an5.93:1.8": "imāni kho bhikkhave pañca aññābyākaraṇānīti. ",
  "an5.93:1.9": ""
}
