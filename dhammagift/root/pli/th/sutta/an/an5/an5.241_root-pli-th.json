{
  "an5.241:0.1": "",
  "an5.241:0.2": "duccaritavaggo pañcamo ",
  "an5.241:0.3": "",
  "an5.241:1.1": "pañcime bhikkhave ādīnavā duccarite ",
  "an5.241:1.2": "katame pañca ",
  "an5.241:1.3": "attāpi attānaṃ upavadati ",
  "an5.241:1.4": "anuvicca viññū garahanti ",
  "an5.241:1.5": "pāpako kittisaddo abbhuggacchati ",
  "an5.241:1.6": "sammūḷho kālaṃ karoti ",
  "an5.241:1.7": "kāyassa bhedā parammaraṇā apāyaṃ duggatiṃ vinipātaṃ nirayaṃ upapajjati ",
  "an5.241:1.8": "ime kho bhikkhave pañca ādīnavā duccarite. ",
  "an5.241:2.1": "pañcime bhikkhave ānisaṃsā sucarite ",
  "an5.241:2.2": "katame pañca ",
  "an5.241:2.3": "attāpi attānaṃ na upavadati ",
  "an5.241:2.4": "anuvicca viññū pasaṃsanti ",
  "an5.241:2.5": "kalyāṇo kittisaddo abbhuggacchati ",
  "an5.241:2.6": "asammūḷho kālaṃ karoti ",
  "an5.241:2.7": "kāyassa bhedā parammaraṇā sugatiṃ saggaṃ lokaṃ upapajjati ",
  "an5.241:2.8": "ime kho bhikkhave pañca ānisaṃsā sucariteti. ",
  "an5.241:2.9": ""
}
