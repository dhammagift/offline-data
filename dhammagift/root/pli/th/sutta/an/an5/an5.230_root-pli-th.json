{
  "an5.230:0.1": "",
  "an5.230:0.2": "",
  "an5.230:0.3": "",
  "an5.230:1.1": "pañcime bhikkhave ādīnavā kaṇhasappe ",
  "an5.230:1.2": "katame pañca ",
  "an5.230:1.3": "kodhano upanāhī ghoraviso dujivho mittadubbhī ",
  "an5.230:1.4": "ime kho bhikkhave pañca ādīnavā kaṇhasappe ",
  "an5.230:2.1": "evameva kho bhikkhave pañcime ādīnavā mātugāme ",
  "an5.230:2.2": "katame pañca ",
  "an5.230:2.3": "kodhano upanāhī ghoraviso dujivho mittadubbhī ",
  "an5.230:2.4": "tatridaṃ bhikkhave mātugāmassa ghoravisatā ",
  "an5.230:2.5": "yebhuyyena bhikkhave mātugāmo tibbarāgo ",
  "an5.230:2.6": "tatridaṃ bhikkhave mātugāmassa dujivhatā ",
  "an5.230:2.7": "yebhuyyena bhikkhave mātugāmo pisuṇavāco ",
  "an5.230:2.8": "tatridaṃ bhikkhave mātugāmassa mittadubbhitā ",
  "an5.230:2.9": "yebhuyyena bhikkhave mātugāmo aticārinī ",
  "an5.230:2.10": "ime kho bhikkhave pañca ādīnavā mātugāmeti. ",
  "an5.230:2.11": "",
  "an5.230:2.12": "dīghacārikavaggo tatiyo. ",
  "an5.230:3.0": "tassuddānaṃ ",
  "an5.230:3.1": "dve dīghacārikā vuttā ",
  "an5.230:3.2": "abhinivāsamaccharaṃ ",
  "an5.230:3.3": "duve kulupakā bhogo ",
  "an5.230:3.4": "bhattaṃ sappāpare duveti. "
}
