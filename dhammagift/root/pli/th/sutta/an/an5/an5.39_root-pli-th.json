{
  "an5.39:0.1": "",
  "an5.39:0.2": "",
  "an5.39:0.3": "",
  "an5.39:1.1": "pañcimāni bhikkhave ṭhānāni sampassantā mātāpitaro puttaṃ icchanti kule jāyamānaṃ ",
  "an5.39:1.2": "katamāni pañca ",
  "an5.39:1.3": "bhato vā no bharissati ",
  "an5.39:1.4": "kiccaṃ vā no karissati ",
  "an5.39:1.5": "kulavaṃso ciraṃ ṭhassati ",
  "an5.39:1.6": "dāyajjaṃ paṭipajjati ",
  "an5.39:1.7": "atha vā pana petānaṃ kālakatānaṃ dakkhiṇaṃ anuppadassati ",
  "an5.39:1.8": "imāni kho bhikkhave pañca ṭhānāni sampassantā mātāpitaro puttaṃ icchanti kule jāyamānanti. ",
  "an5.39:2.1": "pañcaṭṭhānāni sampassaṃ ",
  "an5.39:2.2": "puttaṃ icchanti paṇḍitā ",
  "an5.39:2.3": "bhato vā no bharissati ",
  "an5.39:2.4": "kiccaṃ vā no karissati ",
  "an5.39:3.1": "kulavaṃso ciraṃ tiṭṭhe ",
  "an5.39:3.2": "dāyajjaṃ paṭipajjati ",
  "an5.39:3.3": "atha vā pana petānaṃ ",
  "an5.39:3.4": "dakkhiṇaṃnuppadassati ",
  "an5.39:4.1": "ṭhānānetāni sampassaṃ ",
  "an5.39:4.2": "puttaṃ icchanti paṇḍitā ",
  "an5.39:4.3": "tasmā santo sappurisā ",
  "an5.39:4.4": "kataññū katavedino ",
  "an5.39:5.1": "bharanti mātāpitaro ",
  "an5.39:5.2": "pubbe katamanussaraṃ ",
  "an5.39:5.3": "karonti nesaṃ kiccāni ",
  "an5.39:5.4": "yathātaṃ pubbakārinaṃ ",
  "an5.39:6.1": "ovādakārī bhataposī ",
  "an5.39:6.2": "kulavaṃsaṃ ahāpayaṃ ",
  "an5.39:6.3": "saddho sīlena sampanno ",
  "an5.39:6.4": "putto hoti pasaṃsiyoti. ",
  "an5.39:6.5": ""
}
