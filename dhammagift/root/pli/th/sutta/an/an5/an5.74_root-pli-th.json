  "an5.74:0.3": "",
  "an5.74:1.1": "athakho aññataro bhikkhu yena bhagavā tenupasaṅkami upasaṅkamitvā bhagavantaṃ abhivādetvā ekamantaṃ nisīdi ekamantaṃ nisinno kho so bhikkhu bhagavantaṃ etadavoca ",
  "an5.74:1.2": "dhammavihārī dhammavihārīti bhante vuccati ",
  "an5.74:1.3": "kittāvatā nu kho bhante dhammavihārī hotīti. ",
  "an5.74:2.1": "idha bhikkhu dhammaṃ pariyāpuṇāti ",
  "an5.74:2.2": "suttaṃ … vedallaṃ ",
  "an5.74:2.3": "uttariñcassa paññāya atthaṃ nappajānāti ",
  "an5.74:2.4": "ayaṃ vuccati bhikkhu pariyattibahulo no dhammavihārī. ",
  "an5.74:3.1": "…pe… ",
  "an5.74:3.2": "",
  "an5.74:4.1": "",
  "an5.74:4.2": "",
  "an5.74:5.1": "",
  "an5.74:5.2": "",
  "an5.74:6.1": "idha bhikkhu dhammaṃ pariyāpuṇāti ",
  "an5.74:6.2": "suttaṃ … vedallaṃ ",
  "an5.74:6.3": "uttariñcassa paññāya atthaṃ pajānāti ",
  "an5.74:6.4": "evaṃ kho bhikkhu dhammavihārī hoti. ",
  "an5.74:7.1": "iti kho bhikkhu …pe… ",
  "an5.74:7.2": "",
  "an5.74:7.3": "ayaṃ vo amhākaṃ anusāsanīti. ",
  "an5.74:7.4": ""
}
