  "an5.254:1.1": "pañcimāni bhikkhave macchariyāni ",
  "an5.254:1.2": "katamāni pañca ",
  "an5.254:1.3": "āvāsamacchariyaṃ kulamacchariyaṃ vaṇṇamacchariyaṃ dhammamacchariyaṃ ",
  "an5.254:1.4": "imāni kho bhikkhave pañca macchariyāni ",
  "an5.254:1.5": "imesaṃ kho bhikkhave pañcannaṃ macchariyānaṃ etaṃ patikkiṭṭhaṃ yadidaṃ dhammamacchariyanti. ",
  "an5.254:1.6": ""
}
