{
  "an5.36:0.1": "",
  "an5.36:0.2": "",
  "an5.36:0.3": "",
  "an5.36:1.1": "pañcimāni bhikkhave kāladānāni ",
  "an5.36:1.2": "katamāni pañca ",
  "an5.36:1.3": "āgantukassa dānaṃ deti ",
  "an5.36:1.4": "gamikassa dānaṃ deti ",
  "an5.36:1.5": "",
  "an5.36:1.6": "dubbhikkhe dānaṃ deti ",
  "an5.36:1.7": "yāni tāni navasassāni navaphalāni tāni paṭhamaṃ sīlavantesu patiṭṭhāpeti ",
  "an5.36:1.8": "imāni kho bhikkhave pañca kāladānānīti. ",
  "an5.36:2.1": "kāle dadanti sappaññā ",
  "an5.36:2.2": "vadaññū vītamaccharā ",
  "an5.36:2.3": "kālena dinnaṃ ariyesu ",
  "an5.36:2.4": "ujubhūtesu tādisu ",
  "an5.36:3.1": "vippasannamanā tassa ",
  "an5.36:3.2": "vipulā hoti dakkhiṇā ",
  "an5.36:3.3": "ye tattha anumodanti ",
  "an5.36:3.4": "veyyāvaccaṃ karonti vā ",
  "an5.36:3.5": "na tena dakkhiṇā ūnā ",
  "an5.36:3.6": "tepi puññassa bhāgino ",
  "an5.36:4.1": "tasmā dade appaṭivāṇacitto ",
  "an5.36:4.2": "yattha dinnaṃ mahapphalaṃ ",
  "an5.36:4.3": "puññāni paralokasmiṃ ",
  "an5.36:4.4": "patiṭṭhā honti pāṇinanti. ",
  "an5.36:4.5": ""
}
