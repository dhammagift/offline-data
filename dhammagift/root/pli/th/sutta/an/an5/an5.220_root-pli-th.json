{
  "an5.220:0.1": "",
  "an5.220:0.2": "",
  "an5.220:0.3": "",
  "an5.220:1.1": "pañcime bhikkhave ādīnavā madhurāyaṃ ",
  "an5.220:1.2": "katame pañca ",
  "an5.220:1.3": "visamā bahurajā caṇḍasunakhā vālayakkhā dullabhapiṇḍā ",
  "an5.220:1.4": "ime kho bhikkhave pañca ādīnavā madhurāyanti. ",
  "an5.220:1.5": "",
  "an5.220:1.6": "akkosakavaggo dutiyo. ",
  "an5.220:2.0": "tassuddānaṃ ",
  "an5.220:2.1": "akkosabhaṇḍanasīlaṃ ",
  "an5.220:2.2": "bāhubhāṇī dve akhantiyo ",
  "an5.220:2.3": "apāsādikā dve vuttā ",
  "an5.220:2.4": "aggismiṃ madhurena cāti. "
}
