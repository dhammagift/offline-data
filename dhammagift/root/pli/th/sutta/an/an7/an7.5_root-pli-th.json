{
  "an7.5:0.1": "",
  "an7.5:0.2": "",
  "an7.5:0.3": "",
  "an7.5:1.1": "sattimāni bhikkhave dhanāni. ",
  "an7.5:1.2": "katamāni satta ",
  "an7.5:1.3": "saddhādhanaṃ sīladhanaṃ hirīdhanaṃ ottappadhanaṃ sutadhanaṃ cāgadhanaṃ paññādhanaṃ ",
  "an7.5:1.4": "imāni kho bhikkhave satta dhanānīti. ",
  "an7.5:2.1": "saddhādhanaṃ sīladhanaṃ ",
  "an7.5:2.2": "hirī ottappiyaṃ dhanaṃ ",
  "an7.5:2.3": "sutadhanañca cāgo ca ",
  "an7.5:2.4": "paññā ve sattamaṃ dhanaṃ ",
  "an7.5:3.1": "yassa etā dhanā atthi ",
  "an7.5:3.2": "itthiyā purisassa vā ",
  "an7.5:3.3": "adaḷiddoti taṃ āhu ",
  "an7.5:3.4": "amoghaṃ tassa jīvitaṃ. ",
  "an7.5:4.1": "tasmā saddhañca sīlañca ",
  "an7.5:4.2": "pasādaṃ dhammadassanaṃ ",
  "an7.5:4.3": "anuyuñjetha medhāvī ",
  "an7.5:4.4": "saraṃ buddhānasāsananti. ",
  "an7.5:4.5": ""
}
