{
  "an7.31:0.1": "",
  "an7.31:0.2": "",
  "an7.31:0.3": "",
  "an7.31:1.1": "sattime bhikkhave upāsakassa asambhavā ",
  "an7.31:1.2": "sattime bhikkhave upāsakassa sambhavā ",
  "an7.31:1.3": "katame satta ",
  "an7.31:1.4": "bhikkhudassanaṃ na hāpeti ",
  "an7.31:1.5": "saddhammassavanaṃ nappamajjati ",
  "an7.31:1.6": "adhisīle sikkhati ",
  "an7.31:1.7": "pasādabahulo hoti ",
  "an7.31:1.8": "bhikkhūsu theresu ceva navesu ca majjhimesu ca anupārambhacitto dhammaṃ suṇāti na randhagavesī ",
  "an7.31:1.9": "na ito bahiddhā dakkhiṇeyyaṃ gavesati ",
  "an7.31:1.10": "idha ca pubbakāraṃ karoti ",
  "an7.31:1.11": "ime kho bhikkhave satta upāsakassa sambhavāti. ",
  "an7.31:2.1": "dassanaṃ bhāvitattānaṃ ",
  "an7.31:2.2": "yo hāpeti upāsako ",
  "an7.31:2.3": "savanañca ariyadhammānaṃ ",
  "an7.31:2.4": "adhisīle na sikkhati ",
  "an7.31:3.1": "appasādo ca bhikkhūsu ",
  "an7.31:3.2": "bhiyyo bhiyyo pavaḍḍhati ",
  "an7.31:3.3": "upārambhakacitto ca ",
  "an7.31:3.4": "saddhammaṃ sotumicchati ",
  "an7.31:4.1": "ito ca bahiddhā aññaṃ ",
  "an7.31:4.2": "dakkhiṇeyyaṃ gavesati ",
  "an7.31:4.3": "tattheva ca pubbakāraṃ ",
  "an7.31:4.4": "yo karoti upāsako ",
  "an7.31:5.1": "ete kho parihānīye ",
  "an7.31:5.2": "satta dhamme sudesite ",
  "an7.31:5.3": "upāsako sevamāno ",
  "an7.31:5.4": "saddhammā parihāyati. ",
  "an7.31:6.1": "dassanaṃ bhāvitattānaṃ ",
  "an7.31:6.2": "yo na hāpeti upāsako ",
  "an7.31:6.3": "savanañca ariyadhammānaṃ ",
  "an7.31:6.4": "adhisīle ca sikkhati ",
  "an7.31:7.1": "pasādo cassa bhikkhūsu ",
  "an7.31:7.2": "bhiyyo bhiyyo pavaḍḍhati ",
  "an7.31:7.3": "anupārambhacitto ca ",
  "an7.31:7.4": "saddhammaṃ sotumicchati ",
  "an7.31:8.1": "na ito bahiddhā aññaṃ ",
  "an7.31:8.2": "dakkhiṇeyyaṃ gavesati ",
  "an7.31:8.3": "idheva ca pubbakāraṃ ",
  "an7.31:8.4": "yo karoti upāsako ",
  "an7.31:9.1": "ete kho aparihānīye ",
  "an7.31:9.2": "satta dhamme sudesite ",
  "an7.31:9.3": "upāsako sevamāno ",
  "an7.31:9.4": "saddhammā na ca ",
  "an7.31:9.5": "hāyatīti. ",
  "an7.31:9.6": "vajjīvaggo tatiyo. ",
  "an7.31:10.0": "tassuddānaṃ ",
  "an7.31:10.1": "sārandado vassakāro bhikkhu ",
  "an7.31:10.2": "kammañca saddhiyaṃ ",
  "an7.31:10.3": "bodhiyasaññaṃ sekho ca hāni ",
  "an7.31:10.4": "vipattayasambhavoti. "
}
