{
  "an7.29:0.1": "",
  "an7.29:0.2": "",
  "an7.29:0.3": "",
  "an7.29:1.1": "sattime bhikkhave dhammā upāsakassa parihānāya saṃvattanti ",
  "an7.29:1.2": "katame satta ",
  "an7.29:1.3": "bhikkhudassanaṃ hāpeti ",
  "an7.29:1.4": "saddhammassavanaṃ pamajjati ",
  "an7.29:1.5": "adhisīle na sikkhati ",
  "an7.29:1.6": "appasādabahulo hoti ",
  "an7.29:1.7": "bhikkhūsu theresu ceva navesu ca majjhimesu ca upārambhacitto dhammaṃ suṇāti randhagavesī ",
  "an7.29:1.8": "ito bahiddhā dakkhiṇeyyaṃ gavesati ",
  "an7.29:1.9": "tattha ca pubbakāraṃ karoti ",
  "an7.29:1.10": "ime kho bhikkhave satta dhammā upāsakassa parihānāya saṃvattanti. ",
  "an7.29:2.1": "sattime bhikkhave dhammā upāsakassa aparihānāya saṃvattanti ",
  "an7.29:2.2": "katame satta ",
  "an7.29:2.3": "bhikkhudassanaṃ na hāpeti ",
  "an7.29:2.4": "saddhammassavanaṃ nappamajjati ",
  "an7.29:2.5": "adhisīle sikkhati ",
  "an7.29:2.6": "pasādabahulo hoti ",
  "an7.29:2.7": "bhikkhūsu theresu ceva navesu ca majjhimesu ca anupārambhacitto dhammaṃ suṇāti na randhagavesī ",
  "an7.29:2.8": "na ito bahiddhā dakkhiṇeyyaṃ gavesati ",
  "an7.29:2.9": "idha ca pubbakāraṃ karoti ",
  "an7.29:2.10": "ime kho bhikkhave satta dhammā upāsakassa aparihānāya saṃvattantīti. ",
  "an7.29:2.11": "",
  "an7.29:2.12": "",
  "an7.29:3.1": "dassanaṃ bhāvitattānaṃ ",
  "an7.29:3.2": "yo hāpeti upāsako ",
  "an7.29:3.3": "savanañca ariyadhammānaṃ ",
  "an7.29:3.4": "adhisīle na sikkhati ",
  "an7.29:4.1": "appasādo ca bhikkhūsu ",
  "an7.29:4.2": "bhiyyo bhiyyo pavaḍḍhati ",
  "an7.29:4.3": "upārambhakacitto ca ",
  "an7.29:4.4": "saddhammaṃ sotumicchati ",
  "an7.29:5.1": "ito ca bahiddhā aññaṃ ",
  "an7.29:5.2": "dakkhiṇeyyaṃ gavesati ",
  "an7.29:5.3": "tattheva ca pubbakāraṃ ",
  "an7.29:5.4": "yo karoti upāsako ",
  "an7.29:6.1": "ete kho parihānīye ",
  "an7.29:6.2": "satta dhamme sudesite ",
  "an7.29:6.3": "upāsako sevamāno ",
  "an7.29:6.4": "saddhammā parihāyati. ",
  "an7.29:7.1": "dassanaṃ bhāvitattānaṃ ",
  "an7.29:7.2": "yo na hāpeti upāsako ",
  "an7.29:7.3": "savanañca ariyadhammānaṃ ",
  "an7.29:7.4": "adhisīle ca sikkhati ",
  "an7.29:8.1": "pasādo cassa bhikkhūsu ",
  "an7.29:8.2": "bhiyyo bhiyyo pavaḍḍhati ",
  "an7.29:8.3": "anupārambhacitto ca ",
  "an7.29:8.4": "saddhammaṃ sotumicchati ",
  "an7.29:9.1": "na ito bahiddhā aññaṃ ",
  "an7.29:9.2": "dakkhiṇeyyaṃ gavesati ",
  "an7.29:9.3": "idheva ca pubbakāraṃ ",
  "an7.29:9.4": "yo karoti upāsako ",
  "an7.29:10.1": "ete kho aparihānīye ",
  "an7.29:10.2": "satta dhamme sudesite ",
  "an7.29:10.3": "upāsako sevamāno ",
  "an7.29:10.4": "saddhammā na ca ",
  "an7.29:10.5": "hāyatīti. "
}
