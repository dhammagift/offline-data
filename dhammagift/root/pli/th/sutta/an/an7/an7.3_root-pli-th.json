  "an7.3:1.1": "",
  "an7.3:1.2": "",
  "an7.3:1.3": "sattimāni bhikkhave balāni. ",
  "an7.3:1.4": "katamāni satta ",
  "an7.3:1.5": "saddhābalaṃ viriyabalaṃ hirībalaṃ ottappabalaṃ satibalaṃ samādhibalaṃ paññābalaṃ ",
  "an7.3:1.6": "imāni kho bhikkhave satta balānīti. ",
  "an7.3:2.1": "saddhābalaṃ viriyabalaṃ ",
  "an7.3:2.2": "hirī ottappiyaṃ balaṃ ",
  "an7.3:2.3": "satibalaṃ samādhibalaṃ ",
  "an7.3:2.4": "paññā ve sattamaṃ balaṃ ",
  "an7.3:2.5": "etehi balavā bhikkhu ",
  "an7.3:2.6": "sukhaṃ jīvati paṇḍito ",
  "an7.3:3.1": "yoniso vicine dhammaṃ ",
  "an7.3:3.2": "paññāyatthaṃ vipassati ",
  "an7.3:3.3": "pajotasseva nibbānaṃ ",
  "an7.3:3.4": "vimokkho hoti cetasoti. ",
  "an7.3:3.5": ""
}
