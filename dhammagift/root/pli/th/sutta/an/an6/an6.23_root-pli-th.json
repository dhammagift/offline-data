{
  "an6.23:0.1": "",
  "an6.23:0.2": "",
  "an6.23:0.3": "",
  "an6.23:1.1": "bhayanti bhikkhave kāmānametaṃ adhivacanaṃ ",
  "an6.23:1.2": "dukkhanti bhikkhave kāmānametaṃ adhivacanaṃ ",
  "an6.23:1.3": "rogoti bhikkhave kāmānametaṃ adhivacanaṃ ",
  "an6.23:1.4": "gaṇḍoti bhikkhave kāmānametaṃ adhivacanaṃ ",
  "an6.23:1.5": "saṅgoti bhikkhave kāmānametaṃ adhivacanaṃ ",
  "an6.23:1.6": "paṅkoti bhikkhave kāmānametaṃ adhivacanaṃ ",
  "an6.23:2.1": "kasmā ca bhikkhave bhayanti kāmānametaṃ adhivacanaṃ ",
  "an6.23:2.2": "kāmarāgarattāyaṃ bhikkhave chandarāgavinibaddho diṭṭhadhammikāpi bhayā na parimuccati samparāyikāpi bhayā na parimuccati tasmā bhayanti kāmānametaṃ adhivacanaṃ. ",
  "an6.23:2.3": "kasmā ca bhikkhave dukkhanti … ",
  "an6.23:2.4": "rogoti … ",
  "an6.23:2.5": "gaṇḍoti … ",
  "an6.23:2.6": "saṅgoti … ",
  "an6.23:2.7": "paṅkoti kāmānametaṃ adhivacanaṃ ",
  "an6.23:2.8": "kāmarāgarattāyaṃ bhikkhave chandarāgavinibaddho diṭṭhadhammikāpi paṅkā na parimuccati samparāyikāpi paṅkā na parimuccati tasmā paṅkoti kāmānametaṃ adhivacananti. ",
  "an6.23:3.1": "bhayaṃ dukkhañca rogo ca ",
  "an6.23:3.2": "saṅgo paṅko ca ubhayaṃ ",
  "an6.23:3.3": "ete kāmā pavuccanti ",
  "an6.23:3.4": "yattha satto puthujjano ",
  "an6.23:4.1": "upādāne bhayaṃ disvā ",
  "an6.23:4.2": "jātimaraṇasambhave ",
  "an6.23:4.3": "anupādā vimuccanti ",
  "an6.23:4.4": "jātimaraṇasaṃkhaye ",
  "an6.23:5.1": "te khemappattā sukhino ",
  "an6.23:5.2": "diṭṭhadhammābhinibbutā ",
  "an6.23:5.3": "sabbe verabhayātītā ",
  "an6.23:5.4": "sabbadukkhaṃ upaccagunti. 24 ",
  "an6.23:5.5": ""
}
