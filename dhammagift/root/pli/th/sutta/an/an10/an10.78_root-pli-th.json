  "an10.78:0.1": "",
  "an10.78:0.2": "",
  "an10.78:0.3": "",
  "an10.78:1.1": "dasahi bhikkhave asaddhammehi samannāgatā niganthā ",
  "an10.78:1.2": "katamehi dasahi ",
  "an10.78:1.3": "assaddhā bhikkhave niganthā ",
  "an10.78:1.4": "dussīlā bhikkhave niganthā ",
  "an10.78:1.5": "ahirikā bhikkhave niganthā ",
  "an10.78:1.6": "anottappino bhikkhave niganthā ",
  "an10.78:1.7": "asappurisabhattino bhikkhave niganthā ",
  "an10.78:1.8": "attukkaṃsakaparavambhakā bhikkhave niganthā ",
  "an10.78:1.9": "sandiṭṭhiparāmāsiadhānagāhiduppaṭinissaggino bhikkhave niganthā ",
  "an10.78:1.10": "kuhakā bhikkhave niganthā ",
  "an10.78:1.11": "pāpicchā bhikkhave niganthā ",
  "an10.78:1.12": "micchādiṭṭhikā bhikkhave niganthā ",
  "an10.78:1.13": "imehi kho bhikkhave dasahi asaddhammehi samannāgatā niganthāti. ",
  "an10.78:1.14": ""
}
