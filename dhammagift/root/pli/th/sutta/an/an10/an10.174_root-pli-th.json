{
  "an10.174:0.1": "",
  "an10.174:0.2": "",
  "an10.174:0.3": "",
  "an10.174:1.1": "pāṇātipātaṃpahaṃ bhikkhave tividhaṃ vadāmi ",
  "an10.174:1.2": "lobhahetukampi dosahetukampi mohahetukampi ",
  "an10.174:2.1": "adinnādānaṃpahaṃ bhikkhave tividhaṃ vadāmi ",
  "an10.174:2.2": "lobhahetukampi dosahetukampi mohahetukampi ",
  "an10.174:3.1": "kāmesu micchācāraṃpahaṃ bhikkhave tividhaṃ vadāmi ",
  "an10.174:3.2": "lobhahetukampi dosahetukampi mohahetukampi ",
  "an10.174:4.1": "musāvādaṃpahaṃ bhikkhave tividhaṃ vadāmi ",
  "an10.174:4.2": "lobhahetukampi dosahetukampi mohahetukampi ",
  "an10.174:5.1": "pisuṇāvācaṃpahaṃ bhikkhave tividhaṃ vadāmi ",
  "an10.174:5.2": "lobhahetukampi dosahetukampi mohahetukampi ",
  "an10.174:6.1": "pharusavācaṃpahaṃ bhikkhave tividhaṃ vadāmi ",
  "an10.174:6.2": "lobhahetukampi dosahetukampi mohahetukampi ",
  "an10.174:7.1": "samphappalāpaṃpahaṃ bhikkhave tividhaṃ vadāmi ",
  "an10.174:7.2": "lobhahetukampi dosahetukampi mohahetukampi ",
  "an10.174:8.1": "abhijjhaṃpahaṃ bhikkhave tividhaṃ vadāmi ",
  "an10.174:8.2": "lobhahetukampi dosahetukampi mohahetukampi ",
  "an10.174:9.1": "byāpādaṃpahaṃ bhikkhave tividhaṃ vadāmi ",
  "an10.174:9.2": "lobhahetukampi dosahetukampi mohahetukampi ",
  "an10.174:10.1": "micchādiṭṭhiṃpahaṃ bhikkhave tividhaṃ vadāmi ",
  "an10.174:10.2": "lobhahetukampi dosahetukampi mohahetukampi ",
  "an10.174:10.3": "iti kho bhikkhave lobho kammanidānasambhavo doso kammanidānasambhavo moho kammanidānasambhavo ",
  "an10.174:10.4": "lobhakkhayā kammanidānasaṃkhayo dosakkhayā kammanidānasaṃkhayo mohakkhayā kammanidānasaṃkhayoti. ",
  "an10.174:10.5": ""
}
