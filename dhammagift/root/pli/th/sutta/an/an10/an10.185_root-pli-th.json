  "an10.185:1.1": "tapaniyañca vo bhikkhave dhammaṃ desissāmi atapaniyañca ",
  "an10.185:1.2": "taṃ suṇātha …pe… ",
  "an10.185:1.3": "katamo ca bhikkhave tapaniyo dhammo ",
  "an10.185:1.4": "pāṇātipāto …pe… ",
  "an10.185:1.5": "micchādiṭṭhi ",
  "an10.185:1.6": "ayaṃ vuccati bhikkhave tapaniyo dhammo. ",
  "an10.185:2.1": "katamo ca bhikkhave atapaniyo dhammo ",
  "an10.185:2.2": "pāṇātipātā veramaṇī …pe… ",
  "an10.185:2.3": "sammādiṭṭhi ",
  "an10.185:2.4": "ayaṃ vuccati bhikkhave atapaniyo dhammoti. ",
  "an10.185:2.5": ""
}
