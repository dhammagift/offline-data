{
  "an10.79:0.1": "",
  "an10.79:0.2": "",
  "an10.79:0.3": "",
  "an10.79:1.1": "dasayimāni bhikkhave āghātavatthūni ",
  "an10.79:1.2": "katamāni dasa ",
  "an10.79:1.3": "anatthaṃ me acarīti āghātaṃ bandhati ",
  "an10.79:1.4": "anatthaṃ me caratīti āghātaṃ bandhati ",
  "an10.79:1.5": "anatthaṃ me carissatīti āghātaṃ bandhati ",
  "an10.79:1.6": "piyassa me manāpassa anatthaṃ acari ",
  "an10.79:1.7": "anatthaṃ carati ",
  "an10.79:1.8": "anatthaṃ carissatīti āghātaṃ bandhati ",
  "an10.79:1.9": "appiyassa me amanāpassa atthaṃ acari ",
  "an10.79:1.10": "atthaṃ carati ",
  "an10.79:1.11": "atthaṃ carissatīti āghātaṃ bandhati ",
  "an10.79:1.12": "aṭṭhāne ca kuppati ",
  "an10.79:1.13": "imāni kho bhikkhave dasa āghātavatthūnīti. ",
  "an10.79:1.14": ""
}
