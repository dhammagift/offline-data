  "an10.194:1.1": "āsevitabbañca vo bhikkhave dhammaṃ desissāmi na āsevitabbañca ",
  "an10.194:1.2": "taṃ suṇātha …pe… ",
  "an10.194:1.3": "katamo ca bhikkhave na āsevitabbo dhammo ",
  "an10.194:1.4": "pāṇātipāto …pe… ",
  "an10.194:1.5": "micchādiṭṭhi ",
  "an10.194:1.6": "ayaṃ vuccati bhikkhave āsevitabbo dhammo. ",
  "an10.194:2.1": "katamo ca bhikkhave āsevitabbo dhammo ",
  "an10.194:2.2": "pāṇātipātā veramaṇī …pe… ",
  "an10.194:2.3": "sammādiṭṭhi ",
  "an10.194:2.4": "ayaṃ vuccati bhikkhave āsevitabbo dhammoti. ",
  "an10.194:2.5": ""
}
