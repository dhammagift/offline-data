{
  "an10.189:0.1": "",
  "an10.189:0.2": "seṭṭhavaggo catuttho ",
  "an10.189:0.3": "",
  "an10.189:1.1": "ariyamaggañca vo bhikkhave desissāmi anariyamaggañca ",
  "an10.189:1.2": "taṃ suṇātha …pe… ",
  "an10.189:1.3": "katamo ca bhikkhave anariyo maggo ",
  "an10.189:1.4": "pāṇātipāto …pe… ",
  "an10.189:1.5": "micchādiṭṭhi ",
  "an10.189:1.6": "ayaṃ vuccati bhikkhave anariyo maggo. ",
  "an10.189:2.1": "katamo ca bhikkhave ariyo maggo ",
  "an10.189:2.2": "pāṇātipātā veramaṇī …pe… ",
  "an10.189:2.3": "sammādiṭṭhi ",
  "an10.189:2.4": "ayaṃ vuccati bhikkhave ariyo maggoti. ",
  "an10.189:2.5": ""
}
