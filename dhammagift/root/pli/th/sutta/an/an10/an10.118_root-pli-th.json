  "an10.118:0.1": "",
  "an10.118:0.2": "",
  "an10.118:0.3": "",
  "an10.118:1.1": "orimañca vo bhikkhave tīraṃ desissāmi pārimañca tīraṃ ",
  "an10.118:1.2": "taṃ suṇātha sādhukaṃ manasikarotha bhāsissāmīti. ",
  "an10.118:1.3": "evaṃ bhanteti kho te bhikkhū bhagavato paccassosuṃ. ",
  "an10.118:1.4": "bhagavā etadavoca ",
  "an10.118:2.1": "katamañca bhikkhave orimaṃ tīraṃ katamañca pārimaṃ tīraṃ ",
  "an10.118:2.2": "micchādiṭṭhi bhikkhave orimaṃ tīraṃ sammādiṭṭhi pārimaṃ tīraṃ …pe… ",
  "an10.118:2.3": "micchāvimutti orimaṃ tīraṃ sammāvimutti pārimaṃ tīraṃ ",
  "an10.118:2.4": "idaṃ kho bhikkhave orimaṃ tīraṃ idaṃ pārimaṃ tīranti. ",
  "an10.118:3.1": "appakā te manussesu ",
  "an10.118:3.2": "ye janā pāragāmino ",
  "an10.118:3.3": "athāyaṃ itarā pajā ",
  "an10.118:3.4": "tīramevānudhāvati. ",
  "an10.118:4.1": "ye ca kho sammadakkhāte ",
  "an10.118:4.2": "dhamme dhammānuvattino ",
  "an10.118:4.3": "te janā pāramessanti ",
  "an10.118:4.4": "maccudheyyaṃ suduttaraṃ. ",
  "an10.118:5.1": "kaṇhaṃ dhammaṃ vippahāya ",
  "an10.118:5.2": "sukkaṃ bhāvetha paṇḍito ",
  "an10.118:5.3": "okā anokkamāgamma ",
  "an10.118:5.4": "viveke yattha dūramaṃ. ",
  "an10.118:6.1": "tatrābhiratimiccheyya ",
  "an10.118:6.2": "hitvā kāme akiñcano ",
  "an10.118:6.3": "pariyodapeyya attānaṃ ",
  "an10.118:6.4": "cittaklesehi paṇḍito. ",
  "an10.118:7.1": "yesaṃ sambodhiyaṅgesu ",
  "an10.118:7.2": "sammācittaṃ subhāvitaṃ ",
  "an10.118:7.3": "ādānapaṭinissagge ",
  "an10.118:7.4": "anupādāya ye ratā ",
  "an10.118:7.5": "khīṇāsavā jutimanto ",
  "an10.118:7.6": "te loke parinibbutāti. ",
  "an10.118:7.7": ""
}
