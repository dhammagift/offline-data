  "an10.13:0.3": "",
  "an10.13:1.1": "dasayimāni bhikkhave saṃyojanāni ",
  "an10.13:1.2": "katamāni dasa ",
  "an10.13:1.3": "pañcorambhāgiyāni saṃyojanāni pañcuddhambhāgiyāni saṃyojanāni ",
  "an10.13:1.4": "katamāni pañcorambhāgiyāni saṃyojanāni ",
  "an10.13:1.5": "sakkāyadiṭṭhi vicikicchā sīlabbataparāmāso kāmacchando byāpādo ",
  "an10.13:1.6": "imāni pañcorambhāgiyāni saṃyojanāni ",
  "an10.13:2.1": "katamāni pañcuddhambhāgiyāni saṃyojanāni ",
  "an10.13:2.2": "rūparāgo arūparāgo māno uddhaccaṃ avijjā ",
  "an10.13:2.3": "imāni pañcuddhambhāgiyāni saṃyojanāni ",
  "an10.13:2.4": "imāni kho bhikkhave dasa saṃyojanānīti. ",
  "an10.13:2.5": ""
}
