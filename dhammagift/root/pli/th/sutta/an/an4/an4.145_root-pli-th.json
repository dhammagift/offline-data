  "an4.145:1.1": "cattārome bhikkhave pajjotā ",
  "an4.145:1.2": "katame cattāro ",
  "an4.145:1.3": "candappajjoto suriyappajjoto aggippajjoto paññāppajjoto ",
  "an4.145:1.4": "ime kho bhikkhave cattāro pajjotā ",
  "an4.145:1.5": "etadaggaṃ bhikkhave imesaṃ catunnaṃ pajjotānaṃ yadidaṃ paññāppajjototi. ",
  "an4.145:1.6": ""
}
