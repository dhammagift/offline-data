{
  "an4.151:0.1": "catutthapaṇṇāsako ",
  "an4.151:0.2": "indriyavaggo paṭhamo ",
  "an4.151:0.3": "",
  "an4.151:1.1": "cattārīmāni bhikkhave indriyāni ",
  "an4.151:1.2": "katamāni cattāri ",
  "an4.151:1.3": "saddhindriyaṃ viriyindriyaṃ samādhindriyaṃ paññindriyaṃ ",
  "an4.151:1.4": "imāni kho bhikkhave cattāri indriyānīti. ",
  "an4.151:1.5": ""
}
