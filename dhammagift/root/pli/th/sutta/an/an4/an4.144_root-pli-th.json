  "an4.144:1.1": "cattārome bhikkhave obhāsā ",
  "an4.144:1.2": "katame cattāro ",
  "an4.144:1.3": "candobhāso suriyobhāso aggobhāso paññobhāso ",
  "an4.144:1.4": "ime kho bhikkhave cattāro obhāsā ",
  "an4.144:1.5": "etadaggaṃ bhikkhave imesaṃ catunnaṃ obhāsānaṃ yadidaṃ paññobhāsoti. ",
  "an4.144:1.6": ""
}
