  "an4.248:1.1": "cattārome bhikkhave dhammā paññāvuḍḍhiyā saṃvattanti ",
  "an4.248:1.2": "katame cattāro ",
  "an4.248:1.3": "sappurisasaṃsevo saddhammassavanaṃ yonisomanasikāro dhammānudhammapaṭipatti ",
  "an4.248:1.4": "ime kho bhikkhave cattāro dhammā paññāvuḍḍhiyā saṃvattantīti. ",
  "an4.248:1.5": ""
}
