{
  "an4.221:0.1": "",
  "an4.221:0.2": "duccaritavaggo tatiyo ",
  "an4.221:0.3": "",
  "an4.221:1.1": "cattārīmāni bhikkhave vacīduccaritāni ",
  "an4.221:1.2": "katamāni cattāri ",
  "an4.221:1.3": "musāvādo pisuṇā vācā pharusā vācā samphappalāpo ",
  "an4.221:1.4": "imāni kho bhikkhave cattāri vacīduccaritāni. ",
  "an4.221:1.5": "cattārīmāni bhikkhave vacīsucaritāni ",
  "an4.221:1.6": "katamāni cattāri ",
  "an4.221:1.7": "saccavācā apisuṇā vācā saṇhā vācā mantābhāsā ",
  "an4.221:1.8": "imāni kho bhikkhave cattāri vacīsucaritānīti. ",
  "an4.221:1.9": ""
}
