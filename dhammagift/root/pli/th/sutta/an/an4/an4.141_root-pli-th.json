{
  "an4.141:0.1": "",
  "an4.141:0.2": "ābhāvaggo pañcamo ",
  "an4.141:0.3": "",
  "an4.141:1.1": "catasso imā bhikkhave ābhā ",
  "an4.141:1.2": "katamā catasso ",
  "an4.141:1.3": "candābhā suriyābhā aggābhā paññābhā ",
  "an4.141:1.4": "imā kho bhikkhave catasso ābhā ",
  "an4.141:1.5": "etadaggaṃ bhikkhave imāsaṃ catassannaṃ ābhānaṃ yadidaṃ paññābhāti. ",
  "an4.141:1.6": ""
}
