{
  "an4.47:0.1": "",
  "an4.47:0.2": "",
  "an4.47:0.3": "",
  "an4.47:1.1": "cattārīmāni bhikkhave sudūravidūrāni ",
  "an4.47:1.2": "katamāni cattāri ",
  "an4.47:1.3": "nabhañca bhikkhave paṭhavī ca ",
  "an4.47:1.4": "idaṃ paṭhamaṃ suvidūravidūre ",
  "an4.47:1.5": "orimañca bhikkhave tīraṃ samuddassa pārimañca tīraṃ ",
  "an4.47:1.6": "idaṃ dutiyaṃ suvidūravidūre ",
  "an4.47:1.7": "yato ca bhikkhave verocano abbhudeti yattha ca atthaṅgameti ",
  "an4.47:1.8": "idaṃ tatiyaṃ suvidūravidūre ",
  "an4.47:1.9": "satañca bhikkhave dhammo asatañca dhammo ",
  "an4.47:1.10": "idaṃ catutthaṃ suvidūravidūre ",
  "an4.47:1.11": "imāni kho bhikkhave cattāri suvidūravidūrānīti. ",
  "an4.47:2.1": "nabhañca dūre paṭhavī ca dūre ",
  "an4.47:2.2": "pāraṃ samuddassa tadāhu dūre ",
  "an4.47:2.3": "yato ca verocano abbhudeti ",
  "an4.47:2.4": "pabhaṅkaro yattha ca atthameti ",
  "an4.47:2.5": "tato have dūrataraṃ vadanti ",
  "an4.47:2.6": "satañca dhammaṃ asatañca dhammaṃ. ",
  "an4.47:3.1": "abyāyiko hoti sataṃ samāgamo ",
  "an4.47:3.2": "yāvampi tiṭṭheyya tatheva hoti. ",
  "an4.47:3.3": "khippañhi veti asataṃ samāgamo ",
  "an4.47:3.4": "tasmā sataṃ dhammā asabbhi ārakāti. ",
  "an4.47:3.5": ""
}
