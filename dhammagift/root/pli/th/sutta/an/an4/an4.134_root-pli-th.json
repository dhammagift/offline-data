  "an4.134:0.1": "",
  "an4.134:0.2": "",
  "an4.134:0.3": "",
  "an4.134:1.1": "cattārome bhikkhave puggalā santo saṃvijjamānā lokasmiṃ ",
  "an4.134:1.2": "katame cattāro ",
  "an4.134:1.3": "uṭṭhānaphalupajīvī na kammaphalupajīvī ",
  "an4.134:1.4": "kammaphalupajīvī na uṭṭhānaphalupajīvī ",
  "an4.134:1.5": "uṭṭhānaphalupajīvī ceva kammaphalupajīvī ca ",
  "an4.134:1.6": "neva uṭṭhānaphalupajīvī na kammaphalupajīvī ",
  "an4.134:1.7": "ime kho bhikkhave cattāro puggalā santo saṃvijjamānā lokasminti. ",
  "an4.134:1.8": ""
}
