  "an4.142:1.1": "catasso imā bhikkhave pabhā ",
  "an4.142:1.2": "katamā catasso ",
  "an4.142:1.3": "candappabhā suriyappabhā aggippabhā paññāppabhā ",
  "an4.142:1.4": "imā kho bhikkhave catasso pabhā ",
  "an4.142:1.5": "etadaggaṃ bhikkhave imāsaṃ catassannaṃ pabhānaṃ yadidaṃ paññāppabhāti. ",
  "an4.142:1.6": ""
}
