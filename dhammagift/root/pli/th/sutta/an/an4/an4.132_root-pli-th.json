  "an4.132:0.1": "",
  "an4.132:0.2": "",
  "an4.132:0.3": "",
  "an4.132:1.1": "cattārome bhikkhave puggalā santo saṃvijjamānā lokasmiṃ ",
  "an4.132:1.2": "katame cattāro ",
  "an4.132:1.3": "yuttapaṭibhāṇo na muttapaṭibhāṇo ",
  "an4.132:1.4": "muttapaṭibhāṇo na yuttapaṭibhāṇo ",
  "an4.132:1.5": "yuttapaṭibhāṇo ca muttapaṭibhāṇo ca ",
  "an4.132:1.6": "neva yuttapaṭibhāṇo na muttapaṭibhāṇo ",
  "an4.132:1.7": "ime kho bhikkhave cattāro puggalā santo saṃvijjamānā lokasminti. ",
  "an4.132:1.8": ""
}
