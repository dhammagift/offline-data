{
  "an4.120:0.1": "",
  "an4.120:0.2": "",
  "an4.120:0.3": "",
  "an4.120:1.1": "cattārīmāni bhikkhave bhayāni ",
  "an4.120:1.2": "katamāni cattāri ",
  "an4.120:1.3": "aggibhayaṃ udakabhayaṃ rājabhayaṃ corabhayaṃ ",
  "an4.120:1.4": "imāni kho bhikkhave cattāri bhayānīti. ",
  "an4.120:1.5": "",
  "an4.120:1.6": "kesīvaggo dutiyo. ",
  "an4.120:2.0": "tassuddānaṃ ",
  "an4.120:2.1": "kesī javo patodo ca ",
  "an4.120:2.2": "nāgaṭhānena pañcamaṃ ",
  "an4.120:2.3": "apamādo ca ārakkho ",
  "an4.120:2.4": "vejanīyañca dve bhayāti. "
}
