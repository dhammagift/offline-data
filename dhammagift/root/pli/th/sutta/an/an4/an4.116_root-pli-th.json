{
  "an4.116:0.1": "",
  "an4.116:0.2": "",
  "an4.116:0.3": "",
  "an4.116:1.1": "catūhi bhikkhave ṭhānehi appamādo karaṇīyo ",
  "an4.116:1.2": "katamehi catūhi ",
  "an4.116:1.3": "kāyaduccaritaṃ bhikkhave pajahatha kāyasucaritaṃ bhāvetha ",
  "an4.116:1.4": "tattha ca mā pamādattha ",
  "an4.116:1.5": "vacīduccaritaṃ bhikkhave pajahatha vacīsucaritaṃ bhāvetha ",
  "an4.116:1.6": "tattha ca mā pamādattha ",
  "an4.116:1.7": "manoduccaritaṃ bhikkhave pajahatha manosucaritaṃ bhāvetha ",
  "an4.116:1.8": "tattha ca mā pamādattha ",
  "an4.116:1.9": "micchādiṭṭhiṃ bhikkhave pajahatha sammādiṭṭhiṃ bhāvetha ",
  "an4.116:1.10": "tattha ca mā pamādattha ",
  "an4.116:2.1": "yato kho bhikkhave bhikkhuno kāyaduccaritaṃ pahīnaṃ hoti kāyasucaritaṃ bhāvitaṃ vacīduccaritaṃ pahīnaṃ hoti vacīsucaritaṃ bhāvitaṃ manoduccaritaṃ pahīnaṃ hoti manosucaritaṃ bhāvitaṃ micchādiṭṭhi pahīnā hoti sammādiṭṭhi bhāvitā so na bhāyati samparāyikassa maraṇassāti. ",
  "an4.116:2.2": ""
}
