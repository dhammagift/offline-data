{
  "an11.1:0.1": "suttantapiṭake aṅguttaranikāyassa ekādasakanipāto namo tassa bhagavato arahato sammāsambuddhassa ",
  "an11.1:0.2": "nissāyavaggo paṭhamo ",
  "an11.1:0.3": "",
  "an11.1:1.1": "evamme sutaṃ. ",
  "an11.1:1.2": "ekaṃ samayaṃ bhagavā sāvatthiyaṃ viharati jetavane anāthapiṇḍikassa ārāme. ",
  "an11.1:1.3": "athakho āyasmā ānando yena bhagavā tenupasaṅkami upasaṅkamitvā bhagavantaṃ abhivādetvā ekamantaṃ nisīdi ekamantaṃ nisinno kho āyasmā ānando bhagavantaṃ etadavoca ",
  "an11.1:1.4": "kimatthiyāni bhante kusalāni sīlāni kimānisaṃsānīti. ",
  "an11.1:1.5": "avippaṭisāratthāni kho ānanda kusalāni sīlāni avippaṭisārānisaṃsāni. ",
  "an11.1:2.1": "avippaṭisāro pana bhante kimatthiyo kimānisaṃsoti. ",
  "an11.1:2.2": "avippaṭisāro kho ānanda pāmujjattho pāmujjānisaṃso. ",
  "an11.1:3.1": "pāmujjaṃ pana bhante kimatthiyaṃ kimānisaṃsanti. ",
  "an11.1:3.2": "pāmujjaṃ kho ānanda pītatthaṃ pītānisaṃsaṃ. ",
  "an11.1:4.1": "pīti pana bhante kimatthiyā kimānisaṃsāti. ",
  "an11.1:4.2": "pīti kho ānanda passaddhatthā passaddhānisaṃsā. ",
  "an11.1:5.1": "passaddhi pana bhante kimatthiyā kimānisaṃsāti. ",
  "an11.1:5.2": "passaddhi kho ānanda sukhatthā sukhānisaṃsā. ",
  "an11.1:6.1": "sukhaṃ pana bhante kimatthiyaṃ kimānisaṃsanti. ",
  "an11.1:6.2": "sukhaṃ kho ānanda samādhatthaṃ samādhānisaṃsaṃ. ",
  "an11.1:7.1": "samādhi pana bhante kimatthiyo kimānisaṃsoti. ",
  "an11.1:7.2": "samādhi kho ānanda yathābhūtañāṇadassanattho yathābhūtañāṇadassanānisaṃso. ",
  "an11.1:8.1": "yathābhūtañāṇadassanaṃ pana bhante kimatthiyaṃ kimānisaṃsanti. ",
  "an11.1:8.2": "yathābhūtañāṇadassanaṃ kho ānanda nibbidatthaṃ nibbidānisaṃsaṃ. ",
  "an11.1:9.1": "nibbidā pana bhante kimatthiyā kimānisaṃsāti. ",
  "an11.1:9.2": "nibbidā kho ānanda virāgatthā virāgānisaṃsā. ",
  "an11.1:10.1": "virāgo pana bhante kimatthiyo kimānisaṃsoti. ",
  "an11.1:10.2": "virāgo kho ānanda vimuttiñāṇadassanattho vimuttiñāṇadassanānisaṃsoti ",
  "an11.1:11.1": "iti kho ānanda kusalāni sīlāni avippaṭisāratthāni avippaṭisārānisaṃsāni ",
  "an11.1:11.2": "avippaṭisāro pāmujjattho pāmujjānisaṃso ",
  "an11.1:11.3": "pāmujjaṃ pītatthaṃ pītānisaṃsaṃ ",
  "an11.1:11.4": "pīti passaddhatthā passaddhānisaṃsā ",
  "an11.1:11.5": "passaddhi sukhatthā sukhānisaṃsā ",
  "an11.1:11.6": "sukhaṃ samādhatthaṃ samādhānisaṃsaṃ ",
  "an11.1:11.7": "samādhi yathābhūtañāṇadassanattho yathābhūtañāṇadassanānisaṃso ",
  "an11.1:11.8": "yathābhūtañāṇadassanaṃ nibbidatthaṃ nibbidānisaṃsaṃ ",
  "an11.1:11.9": "nibbidā virāgatthā virāgānisaṃsā ",
  "an11.1:11.10": "virāgo vimuttiñāṇadassanattho vimuttiñāṇadassanānisaṃso ",
  "an11.1:11.11": "iti kho ānanda kusalāni sīlāni anupubbena arahattāya paripūrentīti. 2 ",
  "an11.1:11.12": ""
}
