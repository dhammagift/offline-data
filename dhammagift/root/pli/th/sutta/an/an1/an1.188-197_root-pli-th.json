{
  "an1.188:0.1": "",
  "an1.188:0.2": "etadaggapāli ",
  "an1.188:1.1": "etadaggaṃ bhikkhave mama sāvakānaṃ bhikkhūnaṃ rattaññūnaṃ yadidaṃ aññākoṇḍañño. ",
  "an1.189:1.1": "mahāpaññānaṃ yadidaṃ sāriputto. ",
  "an1.190:1.1": "iddhimantānaṃ yadidaṃ mahāmoggallāno. ",
  "an1.191:1.1": "dhūtavādānaṃ yadidaṃ mahākassapo. ",
  "an1.192:1.1": "dibbacakkhukānaṃ yadidaṃ anuruddho. ",
  "an1.193:1.1": "uccākulikānaṃ yadidaṃ bhaddiyo kāḷigodhāyaputto. ",
  "an1.194:1.1": "mañjussarānaṃ yadidaṃ lakuṇṭakbhaddiyo. ",
  "an1.195:1.1": "sīhanādikānaṃ yadidaṃ piṇḍolabhāradvājo. ",
  "an1.196:1.1": "dhammakathikānaṃ yadidaṃ puṇṇo mantāniputto. ",
  "an1.197:1.1": "saṃkhittena bhāsitassa vitthārena atthaṃ vibhajantānaṃ yadidaṃ mahākaccānoti. ",
  "an1.197:1.2": "vaggo paṭhamo. "
}
