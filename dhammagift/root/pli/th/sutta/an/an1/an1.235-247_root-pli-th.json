{
  "an1.235:0.1": "",
  "an1.235:0.2": "",
  "an1.235:1.1": "etadaggaṃ bhikkhave mama sāvikānaṃ bhikkhunīnaṃ rattaññūnaṃ yadidaṃ mahāpajāpatī gotamī. ",
  "an1.236:1.1": "mahāpaññānaṃ yadidaṃ khemā. ",
  "an1.237:1.1": "iddhimantānaṃ yadidaṃ uppalavaṇṇā. ",
  "an1.238:1.1": "vinayadharānaṃ yadidaṃ paṭācārā. ",
  "an1.239:1.1": "dhammakathikānaṃ yadidaṃ dhammadinnā. ",
  "an1.240:1.1": "jhāyīnaṃ yadidaṃ nandā. ",
  "an1.241:1.1": "āraddhaviriyānaṃ yadidaṃ soṇā. ",
  "an1.242:1.1": "dibbacakkhukānaṃ yadidaṃ sakulā. ",
  "an1.243:1.1": "khippābhiññānaṃ yadidaṃ bhaddā kuṇḍalakesā. ",
  "an1.244:1.1": "pubbenivāsaṃ anussarantīnaṃ yadidaṃ bhaddā kapilānī. ",
  "an1.245:1.1": "mahābhiññāppattānaṃ yadidaṃ bhaddā kaccānā. ",
  "an1.246:1.1": "lūkhacīvaradharānaṃ yadidaṃ kisāgotamī. ",
  "an1.247:1.1": "saddhādhimuttānaṃ yadidaṃ sigālamātāti. ",
  "an1.247:1.2": "vaggo pañcamo. "
}
