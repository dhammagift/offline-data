{
  "an1.198:0.1": "",
  "an1.198:0.2": "",
  "an1.198:1.1": "etadaggaṃ bhikkhave mama sāvakānaṃ bhikkhūnaṃ manomayaṃ kāyaṃ abhinimminantānaṃ yadidaṃ cullapanthako. ",
  "an1.199:1.1": "cetovivaṭṭakusalānaṃ yadidaṃ cullapanthako. ",
  "an1.200:1.1": "paññāvivaṭṭakusalānaṃ yadidaṃ mahāpanthako. ",
  "an1.201:1.1": "araṇavihārīnaṃ yadidaṃ subhūti. ",
  "an1.202:1.1": "dakkhiṇeyyānaṃ yadidaṃ subhūti. ",
  "an1.203:1.1": "āraññakānaṃ yadidaṃ revato khadiravaniyo. ",
  "an1.204:1.1": "jhāyīnaṃ yadidaṃ kaṅkhārevato. ",
  "an1.205:1.1": "āraddhaviriyānaṃ yadidaṃ soṇo koliviso. ",
  "an1.206:1.1": "kalyāṇavākkaraṇānaṃ yadidaṃ soṇo kuṭikaṇṇo. ",
  "an1.207:1.1": "lābhīnaṃ yadidaṃ sīvalī. ",
  "an1.208:1.1": "saddhādhimuttānaṃ yadidaṃ vakkalīti. ",
  "an1.208:1.2": "vaggo dutiyo. "
}
