{
  "an1.219:0.1": "",
  "an1.219:0.2": "",
  "an1.219:1.1": "etadaggaṃ bhikkhave mama sāvakānaṃ bhikkhūnaṃ bahussutānaṃ yadidaṃ ānando. ",
  "an1.220:1.1": "satimantānaṃ yadidaṃ ānando. ",
  "an1.221:1.1": "gatimantānaṃ yadidaṃ ānando. ",
  "an1.222:1.1": "dhitimantānaṃ yadidaṃ ānando. ",
  "an1.223:1.1": "upaṭṭhākānaṃ yadidaṃ ānando. ",
  "an1.224:1.1": "mahāparisānaṃ yadidaṃ uruvelakassapo. ",
  "an1.225:1.1": "kulappasādakānaṃ yadidaṃ kāḷudāyi. ",
  "an1.226:1.1": "appābādhānaṃ yadidaṃ bakkulo. ",
  "an1.227:1.1": "pubbenivāsaṃ anussarantānaṃ yadidaṃ sobhito. ",
  "an1.228:1.1": "vinayadharānaṃ yadidaṃ upāli. ",
  "an1.229:1.1": "bhikkhunovādakānaṃ yadidaṃ nandako. ",
  "an1.230:1.1": "indriyesu guttadvārānaṃ yadidaṃ nando. ",
  "an1.231:1.1": "bhikkhuovādakānaṃ yadidaṃ mahākappino. ",
  "an1.232:1.1": "tejodhātukusalānaṃ yadidaṃ sāgato. ",
  "an1.233:1.1": "paṭibhāṇeyyakānaṃ yadidaṃ rādho. ",
  "an1.234:1.1": "lūkhacīvaradharānaṃ yadidaṃ mogharājāti. ",
  "an1.234:1.2": "vaggo catuttho. "
}
