{
  "an3.31:0.1": "",
  "an3.31:0.2": "devadūtavaggo catuttho ",
  "an3.31:0.3": "",
  "an3.31:1.1": "31 sabrahmakāni bhikkhave tāni kulāni yesaṃ puttānaṃ mātāpitaro ajjhāgāre pūjitā honti ",
  "an3.31:1.2": "sapubbācariyakāni bhikkhave tāni kulāni yesaṃ puttānaṃ mātāpitaro ajjhāgāre pūjitā honti ",
  "an3.31:1.3": "sāhuneyyakāni bhikkhave tāni kulāni yesaṃ puttānaṃ mātāpitaro ajjhāgāre pūjitā honti ",
  "an3.31:1.4": "brahmāti bhikkhave mātāpitunnaṃ etaṃ adhivacanaṃ ",
  "an3.31:1.5": "pubbācariyāti bhikkhave mātāpitunnaṃ etaṃ adhivacanaṃ ",
  "an3.31:1.6": "āhuneyyāti bhikkhave mātāpitunnaṃ etaṃ adhivacanaṃ ",
  "an3.31:1.7": "taṃ kissa hetu ",
  "an3.31:1.8": "bahukārā bhikkhave mātāpitaro puttānaṃ āpādakā posakā imassa lokassa dassetāroti. ",
  "an3.31:2.1": "brahmāti mātāpitaro ",
  "an3.31:2.2": "pubbācariyāti vuccare ",
  "an3.31:2.3": "āhuneyyā ca puttānaṃ ",
  "an3.31:2.4": "pajāya anukampakā. ",
  "an3.31:3.1": "tasmā hi ne namasseyya ",
  "an3.31:3.2": "sakkareyyātha paṇḍito ",
  "an3.31:3.3": "annena atha pānena ",
  "an3.31:3.4": "vatthena sayanena ca ",
  "an3.31:3.5": "ucchādanena nhāpanena ",
  "an3.31:3.6": "pādānaṃ dhovanena ca ",
  "an3.31:4.1": "tāya paricariyāya ",
  "an3.31:4.2": "mātāpitūsu paṇḍitā ",
  "an3.31:4.3": "idheva naṃ pasaṃsanti ",
  "an3.31:4.4": "pecca sagge pamodatīti. ",
  "an3.31:4.5": ""
}
