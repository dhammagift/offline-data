  "an3.90:0.1": "",
  "an3.90:0.2": "",
  "an3.90:0.3": "",
  "an3.90:1.1": "tisso imā bhikkhave sikkhā ",
  "an3.90:1.2": "katamā tisso ",
  "an3.90:1.3": "adhisīlasikkhā adhicittasikkhā adhipaññāsikkhā. ",
  "an3.90:2.1": "katamā ca bhikkhave adhisīlasikkhā ",
  "an3.90:2.2": "idha bhikkhave bhikkhu sīlavā hoti …pe… samādāya sikkhati sikkhāpadesu ",
  "an3.90:2.3": "ayaṃ vuccati bhikkhave adhisīlasikkhā. ",
  "an3.90:3.1": "katamā ca bhikkhave adhicittasikkhā ",
  "an3.90:3.2": "idha bhikkhave bhikkhu vivicceva kāmehi …pe… catutthaṃ jhānaṃ upasampajja viharati ",
  "an3.90:3.3": "ayaṃ vuccati bhikkhave adhicittasikkhā. ",
  "an3.90:4.1": "katamā ca bhikkhave adhipaññāsikkhā ",
  "an3.90:4.2": "idha bhikkhave bhikkhu āsavānaṃ khayā anāsavaṃ cetovimuttiṃ paññāvimuttiṃ diṭṭheva dhamme sayaṃ abhiññā sacchikatvā upasampajja viharati ",
  "an3.90:4.3": "ayaṃ vuccati bhikkhave adhipaññāsikkhā. ",
  "an3.90:4.4": "imā kho bhikkhave tisso sikkhāti. ",
  "an3.90:5.1": "adhisīlaṃ adhicittaṃ ",
  "an3.90:5.2": "adhipaññañca viriyavā ",
  "an3.90:5.3": "thāmavā dhītimā jhāyī ",
  "an3.90:5.4": "sato guttindriyo care ",
  "an3.90:6.1": "yathā pure tathā pacchā ",
  "an3.90:6.2": "yathā pacchā tathā pure ",
  "an3.90:6.3": "yathā adho tathā uddhaṃ ",
  "an3.90:6.4": "yathā uddhaṃ tathā adho ",
  "an3.90:7.1": "yathā divā tathā rattiṃ ",
  "an3.90:7.2": "yathā rattiṃ tathā divā ",
  "an3.90:7.3": "abhibhuyya disā sabbā ",
  "an3.90:7.4": "appamāṇasamādhinā. ",
  "an3.90:8.1": "tamāhu sekkhaṃ paṭipadaṃ ",
  "an3.90:8.2": "atho saṃsuddhacārinaṃ ",
  "an3.90:8.3": "tamāhu loke sambuddhaṃ ",
  "an3.90:8.4": "dhīraṃ paṭipadantaguṃ. ",
  "an3.90:9.1": "viññāṇassa nirodhena ",
  "an3.90:9.2": "taṇhakkhayavimuttino ",
  "an3.90:9.3": "pajjotasseva nibbānaṃ ",
  "an3.90:9.4": "vimokkho hoti cetasoti. 92 ",
  "an3.90:9.5": ""
}
