  "an8.5:0.1": "",
  "an8.5:0.2": "",
  "an8.5:0.3": "",
  "an8.5:1.1": "aṭṭhime bhikkhave lokadhammā lokaṃ anuparivattanti loko ca aṭṭha lokadhamme anuparivattati. ",
  "an8.5:1.2": "katame aṭṭha ",
  "an8.5:1.3": "lābho ca alābho ca yaso ca ayaso ca nindā ca pasaṃsā ca sukhaṃ ca dukkhaṃ ca. ",
  "an8.5:1.4": "ime kho bhikkhave aṭṭha lokadhammā lokaṃ anuparivattanti loko ca ime aṭṭha lokadhamme anuparivattatīti. ",
  "an8.5:2.1": "lābho alābho ca yasāyaso ca ",
  "an8.5:2.2": "nindā pasaṃsā ca sukhaṃ dukkhañca ",
  "an8.5:2.3": "ete aniccā manujesu dhammā ",
  "an8.5:2.4": "asassatā vipariṇāmadhammā ",
  "an8.5:3.1": "ete ca ñatvā satimā sumedho ",
  "an8.5:3.2": "avekkhati vipariṇāmadhamme ",
  "an8.5:3.3": "iṭṭhassa dhammā na mathenti cittaṃ ",
  "an8.5:3.4": "aniṭṭhato no paṭighātameti ",
  "an8.5:4.1": "tassānurodhā atha vā virodhā ",
  "an8.5:4.2": "vidhūpitā atthagatā na santi ",
  "an8.5:4.3": "padañca ñatvā virajaṃ asokaṃ ",
  "an8.5:4.4": "sammappajānāti bhavassa pāragūti. 6 ",
  "an8.5:4.5": ""
}
