{
  "an8.31:0.1": "",
  "an8.31:0.2": "",
  "an8.31:0.3": "",
  "an8.31:1.1": "aṭṭhimāni bhikkhave dānāni. ",
  "an8.31:1.2": "katamāni aṭṭha ",
  "an8.31:1.3": "āsajja dānaṃ deti ",
  "an8.31:1.4": "bhayā dānaṃ deti ",
  "an8.31:1.5": "adāsi meti dānaṃ deti ",
  "an8.31:1.6": "dassati meti dānaṃ deti ",
  "an8.31:1.7": "sāhu dānanti dānaṃ deti ",
  "an8.31:1.8": "ahaṃ pacāmi ime na pacanti nārahāmi pacanto apacantānaṃ dānaṃ na dātunti dānaṃ deti ",
  "an8.31:1.9": "imaṃ me dānaṃ dadato kalyāṇo kittisaddo abbhuggacchatīti dānaṃ deti ",
  "an8.31:1.10": "cittālaṅkāracittaparikkhāratthaṃ dānaṃ deti. ",
  "an8.31:1.11": "imāni kho bhikkhave aṭṭha dānānīti. 32 ",
  "an8.31:1.12": ""
}
