  "an9.70:1.1": "70 pañcimāni bhikkhave uddhambhāgiyāni saṃyojanāni. ",
  "an9.70:1.2": "katamāni pañca ",
  "an9.70:1.3": "rūparāgo arūparāgo māno uddhaccaṃ avijjā. ",
  "an9.70:1.4": "imāni kho bhikkhave pañcuddhambhāgiyāni saṃyojanāni. ",
  "an9.70:2.1": "imesaṃ kho bhikkhave pañcannaṃ uddhambhāgiyānaṃ saṃyojanānaṃ pahānāya ime cattāro satipaṭṭhānā bhāvetabbāti. ",
  "an9.70:2.2": ""
}
