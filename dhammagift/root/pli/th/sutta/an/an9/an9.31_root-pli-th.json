{
  "an9.31:0.1": "",
  "an9.31:0.2": "",
  "an9.31:0.3": "",
  "an9.31:1.1": "bhikkhave anupubbanirodhā. ",
  "an9.31:1.2": "katame nava ",
  "an9.31:1.3": "paṭhamajjhānaṃ samāpannassa āmisasaññā niruddhā hoti ",
  "an9.31:1.4": "dutiyajjhānaṃ samāpannassa vitakkavicārā niruddhā honti ",
  "an9.31:1.5": "tatiyajjhānaṃ samāpannassa pīti niruddhā hoti ",
  "an9.31:1.6": "catutthajjhānaṃ samāpannassa assāsapassāsā niruddhā honti ",
  "an9.31:1.7": "ākāsānañcāyatanaṃ samāpannassa rūpasaññā niruddhā hoti ",
  "an9.31:1.8": "viññāṇañcāyatanaṃ samāpannassa ākāsānañcāyatanasaññā niruddhā hoti ",
  "an9.31:1.9": "ākiñcaññāyatanaṃ samāpannassa viññāṇañcāyatanasaññā niruddhā hoti ",
  "an9.31:1.10": "nevasaññānāsaññāyatanaṃ samāpannassa ākiñcaññāyatanasaññā niruddhā hoti ",
  "an9.31:1.11": "saññāvedayitanirodhaṃ samāpannassa saññā ca vedanā ca niruddhā honti. ",
  "an9.31:1.12": "ime kho bhikkhave nava anupubbanirodhāti. ",
  "an9.31:1.13": "",
  "an9.31:1.14": "sattāvāsavaggo tatiyo. tatruddānaṃ ",
  "an9.31:2.0": "",
  "an9.31:2.1": "bhavati ṭhānakhaḷuṅko taṇhā ",
  "an9.31:2.2": "vavatthasaññā silāyūpo ",
  "an9.31:2.3": "dve therā dve āghātāni ",
  "an9.31:2.4": "anupubbanirodhena cāti. mahāvaggo catuttho 32 nava yime "
}
