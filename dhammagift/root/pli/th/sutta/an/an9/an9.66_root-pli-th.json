  "an9.66:1.1": "66 pañcime bhikkhave upādānakkhandhā. ",
  "an9.66:1.2": "katame pañca ",
  "an9.66:1.3": "rūpūpādānakkhandho vedanūpādānakkhandho saññūpādānakkhandho saṅkhārūpādānakkhandho viññāṇūpādānakkhandho. ",
  "an9.66:1.4": "ime kho bhikkhave pañcupādānakkhandhā. ",
  "an9.66:2.1": "imesaṃ kho bhikkhave pañcannaṃ upādānakkhandhānaṃ pahānāya ime cattāro satipaṭṭhānā bhāvetabbāti. ",
  "an9.66:2.2": ""
}
