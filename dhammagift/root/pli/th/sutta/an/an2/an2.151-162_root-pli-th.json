{
  "an2.151:0.1": "",
  "an2.151:0.2": "",
  "an2.151:1.0": "396. ",
  "an2.151:1.1": "150 dveme bhikkhave santhārā ",
  "an2.151:1.2": "katame dve ",
  "an2.151:1.3": "āmisasanthāro ca dhammasanthāro ca ",
  "an2.151:1.4": "ime kho bhikkhave dve santhārā ",
  "an2.151:1.5": "etadaggaṃ bhikkhave imesaṃ dvinnaṃ santhārānaṃ yadidaṃ dhammasanthāroti. 151 ",
  "an2.152:1.0": "",
  "an2.152:1.1": "dveme bhikkhave paṭisanthārā ",
  "an2.152:1.2": "katame dve ",
  "an2.152:1.3": "āmisapaṭisanthāro ca dhammapaṭisanthāro ca ",
  "an2.152:1.4": "ime kho bhikkhave dve paṭisanthārā ",
  "an2.152:1.5": "etadaggaṃ bhikkhave imesaṃ dvinnaṃ paṭisanthārānaṃ yadidaṃ dhammapaṭisanthāroti. 152 ",
  "an2.153:1.0": "",
  "an2.153:1.1": "dvemā bhikkhave esanā ",
  "an2.153:1.2": "katamā dve ",
  "an2.153:1.3": "āmisesanā ca dhammesanā ca ",
  "an2.153:1.4": "imā kho bhikkhave dve esanā ",
  "an2.153:1.5": "etadaggaṃ bhikkhave imāsaṃ dvinnaṃ esanānaṃ yadidaṃ dhammesanāti. 153 ",
  "an2.154:1.0": "",
  "an2.154:1.1": "dvemā bhikkhave pariyesanā ",
  "an2.154:1.2": "katamā dve ",
  "an2.154:1.3": "āmisapariyesanā ca dhammapariyesanā ca ",
  "an2.154:1.4": "imā kho bhikkhave dve pariyesanā ",
  "an2.154:1.5": "etadaggaṃ bhikkhave imāsaṃ dvinnaṃ pariyesanānaṃ yadidaṃ dhammapariyesanāti. 154 ",
  "an2.155:1.0": "",
  "an2.155:1.1": "dvemā bhikkhave pariyeṭṭhiyo ",
  "an2.155:1.2": "katamā dve ",
  "an2.155:1.3": "āmisapariyeṭṭhi ca dhammapariyeṭṭhi ca ",
  "an2.155:1.4": "imā kho bhikkhave dve pariyeṭṭhiyo ",
  "an2.155:1.5": "etadaggaṃ bhikkhave imāsaṃ dvinnaṃ pariyeṭṭhīnaṃ yadidaṃ dhammapariyeṭṭhīti. 155 ",
  "an2.156:1.0": "",
  "an2.156:1.1": "dvemā bhikkhave pūjā ",
  "an2.156:1.2": "katamā dve ",
  "an2.156:1.3": "āmisapūjā ca dhammapūjā ca ",
  "an2.156:1.4": "imā kho bhikkhave dve pūjā ",
  "an2.156:1.5": "etadaggaṃ bhikkhave imāsaṃ dvinnaṃ pūjānaṃ yadidaṃ dhammapūjāti. 156 ",
  "an2.157:1.0": "",
  "an2.157:1.1": "dvemāni bhikkhave atitheyyāni ",
  "an2.157:1.2": "katamāni dve ",
  "an2.157:1.3": "āmisātitheyyañca dhammātitheyyañca ",
  "an2.157:1.4": "imāni kho bhikkhave dve atitheyyāni ",
  "an2.157:1.5": "etadaggaṃ bhikkhave imesaṃ dvinnaṃ atitheyyānaṃ yadidaṃ dhammātitheyyanti. 157 ",
  "an2.158:1.0": "",
  "an2.158:1.1": "dvemā bhikkhave iddhiyo ",
  "an2.158:1.2": "katamā dve ",
  "an2.158:1.3": "āmisiddhi ca dhammiddhi ca ",
  "an2.158:1.4": "imā kho bhikkhave dve iddhiyo ",
  "an2.158:1.5": "etadaggaṃ bhikkhave imāsaṃ dvinnaṃ iddhīnaṃ yadidaṃ dhammiddhīti. 158 ",
  "an2.159:1.0": "",
  "an2.159:1.1": "dvemā bhikkhave vuḍḍhiyo ",
  "an2.159:1.2": "katamā dve ",
  "an2.159:1.3": "āmisavuḍḍhi ca dhammavuḍḍhi ca ",
  "an2.159:1.4": "imā kho bhikkhave dve vuḍḍhiyo ",
  "an2.159:1.5": "etadaggaṃ bhikkhave imāsaṃ dvinnaṃ vuḍḍhīnaṃ yadidaṃ dhammavuḍḍhīti. 159 ",
  "an2.160:1.0": "",
  "an2.160:1.1": "dvemāni bhikkhave ratanāni ",
  "an2.160:1.2": "katamāni dve ",
  "an2.160:1.3": "āmisaratanañca dhammaratanañca ",
  "an2.160:1.4": "imāni kho bhikkhave dve ratanāni ",
  "an2.160:1.5": "etadaggaṃ bhikkhave imesaṃ dvinnaṃ ratanānaṃ yadidaṃ dhammaratananti. 160 ",
  "an2.161:1.0": "",
  "an2.161:1.1": "dveme bhikkhave sannicayā ",
  "an2.161:1.2": "katame dve ",
  "an2.161:1.3": "āmisasannicayo ca dhammasannicayo ca ",
  "an2.161:1.4": "ime kho bhikkhave dve sannicayā ",
  "an2.161:1.5": "etadaggaṃ bhikkhave imesaṃ dvinnaṃ sannicayānaṃ yadidaṃ dhammasannicayoti. 161 ",
  "an2.162:1.0": "",
  "an2.162:1.1": "dvemāni bhikkhave vepullāni ",
  "an2.162:1.2": "katamāni dve ",
  "an2.162:1.3": "āmisavepullañca dhammavepullañca ",
  "an2.162:1.4": "imāni kho bhikkhave dve vepullāni ",
  "an2.162:1.5": "etadaggaṃ bhikkhave imesaṃ dvinnaṃ vepullānaṃ yadidaṃ dhammavepullanti. ",
  "an2.162:1.6": "santhāravaggo catuttho. "
}
