{
  "an2.141:0.1": "",
  "an2.141:0.2": "",
  "an2.141:1.0": "",
  "an2.141:1.1": "dvemāni bhikkhave dānāni ",
  "an2.141:1.2": "katamāni dve ",
  "an2.141:1.3": "āmisadānañca dhammadānañca ",
  "an2.141:1.4": "imāni kho bhikkhave dve dānāni ",
  "an2.141:1.5": "etadaggaṃ bhikkhave imesaṃ dvinnaṃ dānānaṃ yadidaṃ dhammadānanti. 141 ",
  "an2.142:1.0": "",
  "an2.142:1.1": "dveme bhikkhave yāgā ",
  "an2.142:1.2": "katame dve ",
  "an2.142:1.3": "āmisayāgo ca dhammayāgo ca ",
  "an2.142:1.4": "ime kho bhikkhave dve yāgā ",
  "an2.142:1.5": "etadaggaṃ bhikkhave imesaṃ dvinnaṃ yāgānaṃ yadidaṃ dhammayāgoti. 142 ",
  "an2.143:1.0": "",
  "an2.143:1.1": "dveme bhikkhave cāgā ",
  "an2.143:1.2": "katame dve ",
  "an2.143:1.3": "āmisacāgo ca dhammacāgo ca ",
  "an2.143:1.4": "ime kho bhikkhave dve cāgā ",
  "an2.143:1.5": "etadaggaṃ bhikkhave imesaṃ dvinnaṃ cāgānaṃ yadidaṃ dhammacāgoti. 143 ",
  "an2.144:1.0": "",
  "an2.144:1.1": "dveme bhikkhave pariccāgā ",
  "an2.144:1.2": "katame dve ",
  "an2.144:1.3": "āmisapariccāgo ca dhammapariccāgo ca ",
  "an2.144:1.4": "ime kho bhikkhave dve pariccāgā ",
  "an2.144:1.5": "etadaggaṃ bhikkhave imesaṃ dvinnaṃ pariccāgānaṃ yadidaṃ dhammapariccāgoti. 144 ",
  "an2.145:1.0": "",
  "an2.145:1.1": "dveme bhikkhave bhogā ",
  "an2.145:1.2": "katame dve ",
  "an2.145:1.3": "āmisabhogo ca dhammabhogo ca ",
  "an2.145:1.4": "ime kho bhikkhave dve bhogā ",
  "an2.145:1.5": "etadaggaṃ bhikkhave imesaṃ dvinnaṃ bhogānaṃ yadidaṃ dhammabhogoti. 145 ",
  "an2.146:1.0": "",
  "an2.146:1.1": "dveme bhikkhave sambhogā ",
  "an2.146:1.2": "katame dve ",
  "an2.146:1.3": "āmisasambhogo ca dhammasambhogo ca ",
  "an2.146:1.4": "ime kho bhikkhave dve sambhogā ",
  "an2.146:1.5": "etadaggaṃ bhikkhave imesaṃ dvinnaṃ sambhogānaṃ yadidaṃ dhammasambhogoti. 146 ",
  "an2.147:1.0": "",
  "an2.147:1.1": "dveme bhikkhave saṃvibhāgā ",
  "an2.147:1.2": "katame dve ",
  "an2.147:1.3": "āmisasaṃvibhāgo ca dhammasaṃvibhāgo ca ",
  "an2.147:1.4": "ime kho bhikkhave dve saṃvibhāgā ",
  "an2.147:1.5": "etadaggaṃ bhikkhave imesaṃ dvinnaṃ saṃvibhāgānaṃ yadidaṃ dhammasaṃvibhāgoti. 147 ",
  "an2.148:1.0": "",
  "an2.148:1.1": "dveme bhikkhave saṅgahā ",
  "an2.148:1.2": "katame dve ",
  "an2.148:1.3": "āmisasaṅgaho ca dhammasaṅgaho ca ",
  "an2.148:1.4": "ime kho bhikkhave dve saṅgahā ",
  "an2.148:1.5": "etadaggaṃ bhikkhave imesaṃ dvinnaṃ saṅgahānaṃ yadidaṃ dhammasaṅgahoti. 148 ",
  "an2.149:1.0": "",
  "an2.149:1.1": "dveme bhikkhave anuggahā ",
  "an2.149:1.2": "katame dve ",
  "an2.149:1.3": "āmisānuggaho ca dhammānuggaho ca ",
  "an2.149:1.4": "ime kho bhikkhave dve anuggahā ",
  "an2.149:1.5": "etadaggaṃ bhikkhave imesaṃ dvinnaṃ anuggahānaṃ yadidaṃ dhammānuggahoti. 149 ",
  "an2.150:1.0": "",
  "an2.150:1.1": "dvemā bhikkhave anukampā ",
  "an2.150:1.2": "katamā dve ",
  "an2.150:1.3": "āmisānukampā ca dhammānukampā ca ",
  "an2.150:1.4": "imā kho bhikkhave dve anukampā ",
  "an2.150:1.5": "etadaggaṃ bhikkhave imāsaṃ dvinnaṃ anukampānaṃ yadidaṃ dhammānukampāti. ",
  "an2.150:1.6": "dānavaggo tatiyo. 150 "
}
