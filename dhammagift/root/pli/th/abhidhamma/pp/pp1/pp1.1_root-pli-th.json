{
  "pp1.1:0.1": "abhidhammapiṭake puggalapaññatti namo tassa bhagavato arahato sammāsambuddhassa ",
  "pp1.1:0.2": "",
  "pp1.1:0.3": "uddesavāro ",
  "pp1.1:1.1": "",
  "pp1.1:2.1": "cha paññattiyo ",
  "pp1.1:2.2": "khandhapaññatti āyatanapaññatti dhātupaññatti saccapaññatti indriyapaññatti puggalapaññattīti. ",
  "pp1.1:3.1": "khandhapaññatti kittāvatā khandhānaṃ khandhapaññatti ",
  "pp1.1:3.2": "yāvatā pañcakkhandhā ",
  "pp1.1:3.3": "rūpakkhandho vedanākkhandho saññākkhandho saṅkhārakkhandho viññāṇakkhandho ",
  "pp1.1:3.4": "ettāvatā khandhānaṃ khandhapaññatti. ",
  "pp1.1:4.1": "āyatanapaññatti kittāvatā āyatanānaṃ āyatanapaññatti ",
  "pp1.1:4.2": "yāvatā dvādasāyatanāni ",
  "pp1.1:4.3": "cakkhvāyatanaṃ rūpāyatanaṃ sotāyatanaṃ saddāyatanaṃ ghānāyatanaṃ gandhāyatanaṃ jivhāyatanaṃ rasāyatanaṃ kāyāyatanaṃ phoṭṭhabbāyatanaṃ manāyatanaṃ dhammāyatanaṃ ",
  "pp1.1:4.4": "ettāvatā āyatanānaṃ āyatanapaññatti. ",
  "pp1.1:5.1": "dhātupaññatti kittāvatā dhātūnaṃ dhātupaññatti ",
  "pp1.1:5.2": "yāvatā aṭṭhārasa dhātuyo ",
  "pp1.1:5.3": "cakkhudhātu rūpadhātu cakkhuviññāṇadhātu sotadhātu saddadhātu sotaviññāṇadhātu ghānadhātu gandhadhātu ghānaviññāṇadhātu jivhādhātu rasadhātu jivhāviññāṇadhātu kāyadhātu phoṭṭhabbadhātu kāyaviññāṇadhātu manodhātu dhammadhātu manoviññāṇadhātu ",
  "pp1.1:5.4": "ettāvatā dhātūnaṃ dhātupaññatti. ",
  "pp1.1:6.1": "saccapaññatti kittāvatā saccānaṃ saccapaññatti ",
  "pp1.1:6.2": "yāvatā cattāri saccāni ",
  "pp1.1:6.3": "dukkhasaccaṃ samudayasaccaṃ nirodhasaccaṃ maggasaccaṃ ",
  "pp1.1:6.4": "ettāvatā saccānaṃ saccapaññatti. ",
  "pp1.1:7.1": "indriyapaññatti kittāvatā indriyānaṃ indriyapaññatti ",
  "pp1.1:7.2": "yāvatā bāvīsatindriyāni ",
  "pp1.1:7.3": "cakkhundriyaṃ sotindriyaṃ ghānindriyaṃ jivhindriyaṃ kāyindriyaṃ manindriyaṃ itthindriyaṃ purisindriyaṃ jīvitindriyaṃ sukhindriyaṃ dukkhindriyaṃ somanassindriyaṃ domanassindriyaṃ upekkhindriyaṃ saddhindriyaṃ viriyindriyaṃ satindriyaṃ samādhindriyaṃ paññindriyaṃ anaññataññassāmītindriyaṃ aññindriyaṃ aññātāvindriyaṃ ",
  "pp1.1:7.4": "ettāvatā indriyānaṃ indriyapaññatti. ",
  "pp1.1:8.1": "puggalapaññatti kittāvatā puggalānaṃ puggalapaññatti ",
