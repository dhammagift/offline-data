{
  "dt1.1:0.1": "abhidhammapiṭake dhātukathā ",
  "dt1.1:0.2": "",
  "dt1.1:0.3": "",
  "dt1.1:1.1": "namo tassa bhagavato arahato sammāsambuddhassa mātikā ",
  "dt1.1:2.1": "saṅgaho asaṅgaho ",
  "dt1.1:3.1": "saṅgahitena asaṅgahitaṃ ",
  "dt1.1:4.1": "asaṅgahitena saṅgahitaṃ ",
  "dt1.1:5.1": "saṅgahitena saṅgahitaṃ ",
  "dt1.1:6.1": "asaṅgahitena asaṅgahitaṃ ",
  "dt1.1:7.1": "sampayogo vippayogo ",
  "dt1.1:8.1": "sampayuttena vippayuttaṃ ",
  "dt1.1:9.1": "vippayuttena sampayuttaṃ ",
  "dt1.1:10.1": "sampayuttena sampayuttaṃ ",
  "dt1.1:11.1": "vippayuttena vippayuttaṃ ",
  "dt1.1:12.1": "saṅgahitena sampayuttaṃ vippayuttaṃ ",
  "dt1.1:13.1": "sampayuttena saṅgahitaṃ asaṅgahitaṃ ",
  "dt1.1:14.1": "asaṅgahitena sampayuttaṃ vippayuttaṃ ",
  "dt1.1:15.1": "vippayuttena saṅgahitaṃ asaṅgahitaṃ. "
