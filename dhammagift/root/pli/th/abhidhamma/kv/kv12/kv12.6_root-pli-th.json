  "kv12.6:0.4": "kolaṃkolaekavījīkathā ",
  "kv12.6:1.1": "na vattabbaṃ ",
  "kv12.6:1.2": "kolaṃkolo puggalo kolaṃkolatāniyatoti. ",
  "kv12.6:1.3": "āmantā. ",
  "kv12.6:1.4": "nanu so kolaṃkoloti. ",
  "kv12.6:1.5": "āmantā. ",
  "kv12.6:1.6": "hañci so kolaṃkolo tena vata re vattabbe ",
  "kv12.6:1.7": "kolaṃkolo puggalo kolaṃkolatāniyatoti. ",
