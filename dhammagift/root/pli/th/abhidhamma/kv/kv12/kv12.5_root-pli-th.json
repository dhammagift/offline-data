  "kv12.5:0.4": "sattakkhattuṃparamakathā ",
  "kv12.5:1.1": "sattakkhattuṃparamo puggalo sattakkhattuṃparamatāniyatoti. ",
  "kv12.5:1.2": "āmantā. ",
  "kv12.5:1.3": "mātā jīvitā voropitā ",
  "kv12.5:1.4": "pitā jīvitā voropito ",
  "kv12.5:1.5": "arahā jīvitā voropito ",
  "kv12.5:1.6": "duṭṭhena cittena tathāgatassa lohitaṃ uppāditaṃ ",
  "kv12.5:1.7": "saṅgho bhinnoti. ",
  "kv12.5:1.8": "na hevaṃ vattabbe …pe… ",
  "kv12.5:2.1": "sattakkhattuṃparamo puggalo sattakkhattuṃparamatāniyatoti. ",
  "kv12.5:2.2": "āmantā. ",
  "kv12.5:2.3": "abhabbo antarā dhammaṃ abhisametunti. ",
  "kv12.5:2.4": "na hevaṃ vattabbe …pe… ",
  "kv12.5:2.5": "abhabbo antarā dhammaṃ abhisametunti. ",
  "kv12.5:2.6": "āmantā. ",
  "kv12.5:2.7": "mātā jīvitā voropitā ",
  "kv12.5:2.8": "pitā jīvitā voropito ",
  "kv12.5:2.9": "arahā jīvitā voropito ",
  "kv12.5:2.10": "duṭṭhena cittena tathāgatassa lohitaṃ uppāditaṃ ",
  "kv12.5:2.11": "saṅgho bhinnoti. ",
  "kv12.5:2.12": "na hevaṃ vattabbe …pe… ",
  "kv12.5:3.1": "sattakkhattuṃparamo puggalo sattakkhattuṃparamatāniyatoti. ",
  "kv12.5:3.2": "āmantā. ",
  "kv12.5:3.3": "atthi so niyamo yena niyamena sattakkhattuṃparamo puggalo sattakkhattuṃparamatāniyatoti. ",
  "kv12.5:3.4": "na hevaṃ vattabbe …pe… ",
  "kv12.5:3.5": "atthi te satipaṭṭhānā ",
  "kv12.5:3.6": "sammappadhānā ",
  "kv12.5:3.7": "iddhipādā ",
  "kv12.5:3.8": "indriyā ",
  "kv12.5:3.9": "balā ",
  "kv12.5:3.10": "bojjhaṅgā yehi bojjhaṅgehi sattakkhattuṃparamo puggalo sattakkhattuṃparamatāniyatoti. ",
  "kv12.5:3.11": "na hevaṃ vattabbe …pe… ",
  "kv12.5:4.1": "natthi so niyamo yena niyamena sattakkhattuṃparamo puggalo sattakkhattuṃparamatāniyatoti. ",
  "kv12.5:4.2": "āmantā. ",
  "kv12.5:4.3": "hañci natthi so niyamo yena niyamena sattakkhattuṃparamo puggalo sattakkhattuṃ paramatāniyato no vata re vattabbe ",
  "kv12.5:4.4": "sattakkhattuṃparamo puggalo sattakkhattuṃparamatāniyatoti. ",
  "kv12.5:5.1": "natthi te satipaṭṭhānā …pe… ",
  "kv12.5:5.2": "bojjhaṅgā yehi bojjhaṅgehi sattakkhattuṃparamo puggalo sattakkhattuṃparamatāniyatoti. ",
  "kv12.5:5.3": "āmantā. ",
  "kv12.5:5.4": "hañci natthi te bojjhaṅgā yehi bojjhaṅgehi sattakkhattuṃparamo puggalo sattakkhattuṃparamatāniyato no vata re vattabbe ",
  "kv12.5:5.5": "sattakkhattuṃparamo puggalo sattakkhattuṃparamatāniyatoti. ",
  "kv12.5:6.1": "sattakkhattuṃparamo puggalo sattakkhattuṃparamatāniyatoti. ",
  "kv12.5:6.2": "āmantā. ",
  "kv12.5:6.3": "sakadāgāminiyamenāti. ",
  "kv12.5:6.4": "na hevaṃ vattabbe …pe… ",
  "kv12.5:6.5": "anāgāminiyamenāti. ",
  "kv12.5:6.6": "na hevaṃ vattabbe …pe… ",
  "kv12.5:6.7": "arahattaniyamenāti. ",
  "kv12.5:6.8": "na hevaṃ vattabbe …pe… ",
  "kv12.5:7.1": "katamena niyamenāti. ",
  "kv12.5:7.2": "sotāpattiniyamenāti. ",
  "kv12.5:7.3": "sattakkhattuṃparamo puggalo sattakkhattuṃparamatāniyatoti. ",
  "kv12.5:7.4": "āmantā. ",
  "kv12.5:7.5": "ye keci sotāpattiniyāmaṃ okkamanti sabbe te sattakkhattuṃparamatāniyatāti. ",
  "kv12.5:7.6": "na hevaṃ vattabbe …pe… ",
  "kv12.5:8.1": "na vattabbaṃ ",
  "kv12.5:8.2": "sattakkhattuṃparamo puggalo sattakkhattuṃ paramatāniyatoti. ",
  "kv12.5:8.3": "āmantā. ",
  "kv12.5:8.4": "nanu so sattakkhattuṃparamoti. ",
  "kv12.5:8.5": "āmantā. ",
  "kv12.5:8.6": "hañci so sattakkhattuṃparamo tena vata re vattabbe ",
  "kv12.5:8.7": "sattakkhattuṃparamo puggalo sattakkhattuṃparamatāniyatoti. ",
  "kv12.5:8.8": "sattakkhattuṃparamakathā. "
}
