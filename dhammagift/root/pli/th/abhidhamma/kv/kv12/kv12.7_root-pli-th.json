  "kv12.7:1.1": "na vattabbaṃ ",
  "kv12.7:1.2": "ekavījī puggalo ekavījitāniyatoti. ",
  "kv12.7:1.3": "āmantā. ",
  "kv12.7:1.4": "nanu so ekavījīti. ",
  "kv12.7:1.5": "āmantā. ",
