  "kv17.1:0.3": "",
  "kv17.1:0.4": "atthi arahato puññūpacayotikathā ",
  "kv17.1:1.1": "atthi arahato puññūpacayoti. ",
  "kv17.1:1.2": "āmantā. ",
  "kv17.1:1.3": "atthi arahato apuññūpacayoti. ",
  "kv17.1:1.4": "na hevaṃ vattabbe …pe… ",
  "kv17.1:1.5": "natthi arahato apuññūpacayoti. ",
  "kv17.1:1.6": "āmantā. ",
  "kv17.1:1.7": "natthi arahato puññūpacayoti. ",
  "kv17.1:1.8": "na hevaṃ vattabbe …pe… ",
  "kv17.1:2.1": "atthi arahato puññūpacayoti. ",
  "kv17.1:2.2": "āmantā. ",
  "kv17.1:2.3": "arahā puññābhisaṅkhāraṃ abhisaṅkharoti āneñjābhisaṅkhāraṃ abhisaṅkharoti gatisaṃvattaniyaṃ kammaṃ karoti bhavasaṃvattaniyaṃ kammaṃ karoti issariyasaṃvattaniyaṃ kammaṃ karoti adhipaccasaṃvattaniyaṃ kammaṃ karoti mahābhogasaṃvattaniyaṃ kammaṃ karoti mahāparivārasaṃvattaniyaṃ kammaṃ karoti devasobhagyasaṃvattaniyaṃ kammaṃ karoti manussasobhagyasaṃvattaniyaṃ kammaṃ karotīti. ",
  "kv17.1:2.4": "na hevaṃ vattabbe …pe… ",
  "kv17.1:3.1": "atthi arahato puññūpacayoti. ",
  "kv17.1:3.2": "āmantā. ",
  "kv17.1:3.3": "arahā ācinātīti. ",
  "kv17.1:3.4": "na hevaṃ vattabbe …pe… ",
  "kv17.1:3.5": "arahā apacinātīti. ",
  "kv17.1:3.6": "na hevaṃ vattabbe …pe… ",
  "kv17.1:3.7": "arahā pajahatīti …pe… ",
  "kv17.1:3.8": "arahā upādiyatīti …pe… ",
  "kv17.1:3.9": "arahā visinetīti …pe… ",
  "kv17.1:3.10": "arahā ussinetīti …pe… ",
  "kv17.1:3.11": "arahā vidhūpetīti …pe… ",
  "kv17.1:3.12": "arahā sandhūpetīti. ",
  "kv17.1:3.13": "na hevaṃ vattabbe …pe… ",
  "kv17.1:3.14": "nanu arahā nevācināti na apacināti apacinitvā ṭhitoti. ",
  "kv17.1:3.15": "āmantā. ",
  "kv17.1:3.16": "hañci arahā nevācināti nāpacināti apacinitvā ṭhito no vata re vattabbe ",
  "kv17.1:3.17": "atthi arahato puññūpacayoti. ",
  "kv17.1:4.1": "nanu arahā neva pajahati na upādiyati pajahitvā ṭhito neva visineti na ussineti visinitvā ṭhito neva vidhūpeti na sandhūpeti vidhūpetvā ṭhitoti. ",
  "kv17.1:4.2": "āmantā. ",
  "kv17.1:4.3": "hañci arahā neva vidhūpeti na sandhūpeti vidhūpetvā ṭhito no vata re vattabbe ",
  "kv17.1:4.4": "atthi arahato puññūpacayoti. ",
  "kv17.1:5.1": "natthi arahato puññūpacayoti. ",
  "kv17.1:5.2": "āmantā. ",
  "kv17.1:5.3": "arahā dānaṃ dadeyyāti. ",
  "kv17.1:5.4": "āmantā. ",
  "kv17.1:5.5": "hañci arahā dānaṃ dadeyya no vata re vattabbe ",
  "kv17.1:5.6": "natthi arahato puññūpacayoti. ",
  "kv17.1:6.1": "arahā cīvaraṃ dadeyya …pe… ",
  "kv17.1:6.2": "piṇḍapātaṃ dadeyya ",
  "kv17.1:6.3": "senāsanaṃ dadeyya ",
  "kv17.1:6.4": "gilānapaccayabhesajjaparikkhāraṃ dadeyya ",
  "kv17.1:6.5": "khādanīyaṃ dadeyya ",
  "kv17.1:6.6": "bhojanīyaṃ dadeyya ",
  "kv17.1:6.7": "pānīyaṃ dadeyya ",
  "kv17.1:6.8": "cetiyaṃ vandeyya ",
  "kv17.1:6.9": "cetiye mālaṃ āropeyya ",
  "kv17.1:6.10": "gandhaṃ āropeyya ",
  "kv17.1:6.11": "vilepanaṃ āropeyya …pe… ",
  "kv17.1:6.12": "cetiyaṃ abhidakkhiṇaṃ kareyyāti. ",
  "kv17.1:6.13": "āmantā. ",
  "kv17.1:6.14": "hañci arahā cetiyaṃ abhidakkhiṇaṃ kareyya no vata re vattabbe ",
  "kv17.1:6.15": "natthi arahato puññūpacayoti. ",
  "kv17.1:6.16": "atthi arahato puññūpacayotikathā. "
}
