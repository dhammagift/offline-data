{
  "kv17.6:0.1": "",
  "kv17.6:0.2": "",
  "kv17.6:0.3": "",
  "kv17.6:0.4": "na vattabbaṃ saṅgho dakkhiṇaṃ paṭiggaṇhātītikathā ",
  "kv17.6:1.1": "na vattabbaṃ ",
  "kv17.6:1.2": "saṅgho dakkhiṇaṃ paṭiggaṇhātīti. ",
  "kv17.6:1.3": "āmantā. ",
  "kv17.6:1.4": "nanu saṅgho āhuneyyo pāhuneyyo dakkhiṇeyyo añjalīkaraṇīyo anuttaraṃ puññakkhettaṃ lokassāti. ",
  "kv17.6:1.5": "āmantā. ",
  "kv17.6:1.6": "hañci saṅgho āhuneyyo pāhuneyyo dakkhiṇeyyo añjalīkaraṇīyo anuttaraṃ puññakkhettaṃ lokassa tena vata re vattabbe ",
  "kv17.6:1.7": "saṅgho dakkhiṇaṃ paṭiggaṇhātīti. ",
  "kv17.6:2.1": "na vattabbaṃ ",
  "kv17.6:2.2": "saṅgho dakkhiṇaṃ paṭiggaṇhātīti. ",
  "kv17.6:2.3": "āmantā. ",
  "kv17.6:2.4": "nanu cattāro purisayugā aṭṭha purisapuggalā dakkhiṇeyyā vuttā bhagavatāti. ",
  "kv17.6:2.5": "āmantā. ",
  "kv17.6:2.6": "hañci cattāro purisayugā aṭṭha purisapuggalā dakkhiṇeyyā vuttā bhagavatā tena vata re vattabbe ",
  "kv17.6:2.7": "saṅgho dakkhiṇaṃ paṭiggaṇhātīti. ",
  "kv17.6:3.1": "na vattabbaṃ ",
  "kv17.6:3.2": "saṅgho dakkhiṇaṃ paṭiggaṇhātīti. ",
  "kv17.6:3.3": "āmantā. ",
  "kv17.6:3.4": "nanu atthi keci saṅghassa dānaṃ dentīti. ",
  "kv17.6:3.5": "āmantā. ",
  "kv17.6:3.6": "hañci atthi keci saṅghassa dānaṃ denti tena vata re vattabbe ",
  "kv17.6:3.7": "saṅgho dakkhiṇaṃ paṭiggaṇhātīti. ",
  "kv17.6:3.8": "nanu atthi keci saṅghassa cīvaraṃ denti …pe… ",
  "kv17.6:3.9": "piṇḍapātaṃ denti ",
  "kv17.6:3.10": "senāsanaṃ denti ",
  "kv17.6:3.11": "gilānapaccayabhesajjaparikkhāraṃ denti ",
  "kv17.6:3.12": "khādanīyaṃ denti ",
  "kv17.6:3.13": "bhojanīyaṃ denti …pe… ",
  "kv17.6:3.14": "pānīyaṃ dentīti. ",
  "kv17.6:3.15": "āmantā. ",
  "kv17.6:3.16": "hañci atthi keci saṅghassa pānīyaṃ denti tena vata re vattabbe ",
  "kv17.6:3.17": "saṅgho dakkhiṇaṃ paṭiggaṇhātīti. ",
  "kv17.6:4.1": "na vattabbaṃ ",
  "kv17.6:4.2": "saṅgho dakkhiṇaṃ paṭiggaṇhātīti. ",
  "kv17.6:4.3": "āmantā. ",
  "kv17.6:4.4": "nanu vuttaṃ bhagavatā ",
  "kv17.6:5.1": "āhuti jātavedova ",
  "kv17.6:5.2": "mahāmeghaṃva medanī ",
  "kv17.6:5.3": "saṅgho samādhisampanno ",
  "kv17.6:5.4": "paṭiggaṇhāti dakkhiṇanti ",
  "kv17.6:6.1": "attheva suttantoti. ",
  "kv17.6:6.2": "āmantā. ",
  "kv17.6:6.3": "tena hi saṅgho dakkhiṇaṃ paṭiggaṇhātīti. ",
  "kv17.6:7.1": "saṅgho dakkhiṇaṃ paṭiggaṇhātīti. ",
  "kv17.6:7.2": "āmantā. ",
  "kv17.6:7.3": "maggo paṭiggaṇhāti phalaṃ paṭiggaṇhātīti. ",
  "kv17.6:7.4": "na hevaṃ vattabbe …pe… ",
  "kv17.6:7.5": "na vattabbaṃ saṅgho dakkhiṇaṃ paṭiggaṇhātītikathā. "
}
