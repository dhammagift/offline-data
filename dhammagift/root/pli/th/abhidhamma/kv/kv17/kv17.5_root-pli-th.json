  "kv17.5:0.1": "",
  "kv17.5:0.2": "",
  "kv17.5:0.3": "",
  "kv17.5:0.4": "ṭhapetvā ariyamaggantikathā ",
  "kv17.5:1.1": "ṭhapetvā ariyamaggaṃ avasesā saṅkhārā dukkhāti. ",
  "kv17.5:1.2": "āmantā. ",
  "kv17.5:1.3": "dukkhasamudayopi dukkhoti. ",
  "kv17.5:1.4": "na hevaṃ vattabbe …pe… ",
  "kv17.5:1.5": "dukkhasamudayopi dukkhoti. ",
  "kv17.5:1.6": "āmantā. ",
  "kv17.5:1.7": "tīṇeva ariyasaccānīti. ",
  "kv17.5:1.8": "na hevaṃ vattabbe …pe… ",
  "kv17.5:1.9": "tīṇeva ariyasaccānīti. ",
  "kv17.5:1.10": "āmantā. ",
  "kv17.5:1.11": "nanu cattāri ariyasaccāni vuttāni bhagavatā ",
  "kv17.5:1.12": "dukkhaṃ dukkhasamudayo dukkhanirodho dukkhanirodhagāminī paṭipadāti. ",
  "kv17.5:1.13": "āmantā. ",
  "kv17.5:1.14": "hañci cattāri ariyasaccāni vuttāni bhagavatā ",
  "kv17.5:1.15": "dukkhaṃ dukkhasamudayo dukkhanirodho dukkhanirodhagāminī paṭipadā ",
  "kv17.5:1.16": "no vata re vattabbe ",
  "kv17.5:1.17": "tīṇeva ariyasaccānīti. ",
  "kv17.5:2.1": "dukkhasamudayopi dukkhoti. ",
  "kv17.5:2.2": "āmantā. ",
  "kv17.5:2.3": "kenaṭṭhenāti. ",
  "kv17.5:2.4": "aniccaṭṭhenāti. ",
  "kv17.5:2.5": "ariyamaggo aniccoti. ",
  "kv17.5:2.6": "āmantā. ",
  "kv17.5:2.7": "ariyamaggo dukkhoti. ",
  "kv17.5:2.8": "na hevaṃ vattabbe …pe… ",
  "kv17.5:3.1": "ariyamaggo anicco so ca na dukkhoti. ",
  "kv17.5:3.2": "āmantā. ",
  "kv17.5:3.3": "dukkhasamudayo anicco so ca na dukkhoti. ",
  "kv17.5:3.4": "na hevaṃ vattabbe …pe… ",
  "kv17.5:3.5": "dukkhasamudayo anicco so ca dukkhoti. ",
  "kv17.5:3.6": "āmantā. ",
  "kv17.5:3.7": "ariyamaggo anicco so ca dukkhoti. ",
  "kv17.5:3.8": "na hevaṃ vattabbe …pe… ",
  "kv17.5:4.1": "na vattabbaṃ ",
  "kv17.5:4.2": "ṭhapetvā ariyamaggaṃ avasesā saṅkhārā dukkhāti. ",
  "kv17.5:4.3": "āmantā. ",
  "kv17.5:4.4": "nanu sā dukkhanirodhagāminī paṭipadāti. ",
  "kv17.5:4.5": "āmantā. ",
  "kv17.5:4.6": "hañci sā dukkhanirodhagāminī paṭipadā tena vata re vattabbe ",
  "kv17.5:4.7": "ṭhapetvā ariyamaggaṃ avasesā saṅkhārā dukkhāti. ",
  "kv17.5:4.8": "ṭhapetvā ariyamaggantikathā. "
}
