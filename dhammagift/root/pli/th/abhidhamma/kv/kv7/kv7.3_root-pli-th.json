  "kv7.3:0.3": "",
  "kv7.3:0.4": "cetasikakathā ",
  "kv7.3:1.1": "natthi cetasiko dhammoti. ",
  "kv7.3:1.2": "āmantā. ",
  "kv7.3:1.3": "nanu atthi keci dhammā cittena sahagatā sahajātā saṃsaṭṭhā sampayuttā ekuppādā ekanirodhā ekavatthukā ekārammaṇāti. ",
  "kv7.3:1.4": "āmantā. ",
  "kv7.3:1.5": "hañci atthi keci dhammā cittena sahagatā sahajātā saṃsaṭṭhā sampayuttā ekuppādā ekanirodhā ekavatthukā ekārammaṇā no vata re vattabbe ",
  "kv7.3:1.6": "natthi cetasiko dhammoti. ",
  "kv7.3:2.1": "phasso cittena sahajātoti. ",
  "kv7.3:2.2": "āmantā. ",
  "kv7.3:2.3": "hañci phasso cittena sahajāto tena vata re vattabbe ",
  "kv7.3:2.4": "phasso cetasikoti. ",
  "kv7.3:2.5": "vedanā …pe… ",
  "kv7.3:2.6": "saññā ",
  "kv7.3:2.7": "cetanā …pe… ",
  "kv7.3:2.8": "saddhā ",
  "kv7.3:2.9": "viriyaṃ ",
  "kv7.3:2.10": "sati ",
  "kv7.3:2.11": "samādhi ",
  "kv7.3:2.12": "paññā ",
  "kv7.3:2.13": "rāgo ",
  "kv7.3:2.14": "doso ",
  "kv7.3:2.15": "moho …pe… ",
  "kv7.3:2.16": "anottappaṃ cittena sahajātanti. ",
  "kv7.3:2.17": "āmantā. ",
  "kv7.3:2.18": "hañci anottappaṃ cittena sahajātaṃ tena vata re vattabbe ",
  "kv7.3:2.19": "anottappaṃ cetasikanti. ",
  "kv7.3:3.1": "cittena sahajātāti katvā cetasikāti. ",
  "kv7.3:3.2": "āmantā. ",
  "kv7.3:3.3": "phassena sahajātāti katvā phassasikāti. ",
  "kv7.3:3.4": "āmantā. ",
  "kv7.3:3.5": "cittena sahajātāti katvā cetasikāti. ",
  "kv7.3:3.6": "āmantā. ",
  "kv7.3:3.7": "vedanāya …pe… ",
  "kv7.3:3.8": "saññāya ",
  "kv7.3:3.9": "cetanāya ",
  "kv7.3:3.10": "saddhāya ",
  "kv7.3:3.11": "viriyena ",
  "kv7.3:3.12": "satiyā ",
  "kv7.3:3.13": "samādhinā ",
  "kv7.3:3.14": "paññāya ",
  "kv7.3:3.15": "rāgena ",
  "kv7.3:3.16": "dosena ",
  "kv7.3:3.17": "mohena …pe… ",
  "kv7.3:3.18": "anottappena sahajātāti katvā anottappasikāti. ",
  "kv7.3:3.19": "āmantā. ",
  "kv7.3:4.1": "natthi cetasiko dhammoti. ",
  "kv7.3:4.2": "āmantā. ",
  "kv7.3:4.3": "nanu vuttaṃ bhagavatā ",
  "kv7.3:5.1": "cittamidaṃ cetasikā ca dhammā ",
  "kv7.3:5.2": "anattato saṃviditassa honti ",
  "kv7.3:5.3": "hīnappaṇītaṃ tadubhaye viditvā ",
  "kv7.3:5.4": "sammaddaso vedi palokadhammanti ",
  "kv7.3:6.1": "attheva suttantoti. ",
  "kv7.3:6.2": "āmantā. ",
  "kv7.3:6.3": "tena hi atthi cetasiko dhammoti. ",
  "kv7.3:7.1": "natthi cetasiko dhammoti. ",
  "kv7.3:7.2": "āmantā. ",
  "kv7.3:7.3": "nanu vuttaṃ bhagavatā ",
  "kv7.3:7.4": "idha kevaṭṭa bhikkhu parasattānaṃ parapuggalānaṃ cittampi ādisati cetasikampi ādisati vitakkitampi ādisati vicāritampi ādisati ",
  "kv7.3:7.5": "evampi te mano itthampi te mano itipi te cittanti ",
  "kv7.3:7.6": "attheva suttantoti. ",
  "kv7.3:7.7": "āmantā. ",
  "kv7.3:7.8": "tena hi atthi cetasiko dhammoti. ",
  "kv7.3:7.9": "cetasikakathā. "
}
