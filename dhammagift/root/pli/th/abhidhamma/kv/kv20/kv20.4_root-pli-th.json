  "kv20.4:0.4": "taracchānakathā ",
  "kv20.4:1.1": "atthi devesu tiracchānagatāti. ",
  "kv20.4:1.2": "āmantā. ",
  "kv20.4:1.3": "atthi tiracchānagatesu devāti. ",
  "kv20.4:1.4": "na hevaṃ vattabbe …pe… ",
  "kv20.4:1.5": "atthi devesu tiracchānagatāti. ",
  "kv20.4:1.6": "āmantā. ",
  "kv20.4:1.7": "devaloko tiracchānayonīti. ",
  "kv20.4:1.8": "na hevaṃ vattabbe …pe… ",
  "kv20.4:1.9": "atthi devesu tiracchānagatāti. ",
  "kv20.4:1.10": "āmantā. ",
  "kv20.4:1.11": "atthi tattha kīṭā paṭaṅgā makasā makkhikā ahī vicchikā satapadī gaṇḍupādāti. ",
  "kv20.4:1.12": "na hevaṃ vattabbe …pe… ",
  "kv20.4:2.1": "natthi devesu tiracchānagatāti. ",
  "kv20.4:2.2": "āmantā. ",
  "kv20.4:2.3": "nanu atthi tattha erāvaṇo nāma hatthināgo sahassassayuttaṃ dibbaṃ yānanti. ",
  "kv20.4:2.4": "āmantā. ",
  "kv20.4:2.5": "hañci atthi tattha erāvaṇo nāma hatthināgo sahassassayuttaṃ dibbaṃ yānaṃ tena vata re vattabbe ",
  "kv20.4:2.6": "atthi devesu tiracchānagatāti. ",
  "kv20.4:3.1": "atthi devesu tiracchānagatāti. ",
  "kv20.4:3.2": "āmantā. ",
  "kv20.4:3.3": "atthi tattha hatthibandhā assabandhā yāvasikā kāraṇikā bhattakārakāti. ",
  "kv20.4:3.4": "na hevaṃ vattabbe …pe… ",
  "kv20.4:3.5": "tena hi natthi devesu tiracchānagatāti. ",
  "kv20.4:3.6": "tiracchānakathā. "
}
