  "kv20.2:0.4": "ñāṇakathā ",
  "kv20.2:1.1": "natthi puthujjanassa ñāṇanti. ",
  "kv20.2:1.2": "āmantā. ",
  "kv20.2:1.3": "natthi puthujjanassa paññā pajānanā vicayo pavicayo dhammavicayo sallakkhaṇā upalakkhaṇā paccupalakkhaṇāti. ",
  "kv20.2:1.4": "na hevaṃ vattabbe …pe… ",
  "kv20.2:1.5": "nanu atthi puthujjanassa paññā pajānanā vicayo …pe… ",
  "kv20.2:1.6": "paccupalakkhaṇāti. ",
  "kv20.2:1.7": "āmantā. ",
  "kv20.2:1.8": "hañci atthi puthujjanassa paññā pajānanā vicayo …pe… ",
  "kv20.2:1.9": "paccupalakkhaṇā no vata re vattabbe ",
  "kv20.2:1.10": "natthi puthujjanassa ñāṇanti. ",
  "kv20.2:2.1": "natthi puthujjanassa ñāṇanti. ",
  "kv20.2:2.2": "āmantā. ",
  "kv20.2:2.3": "puthujjano paṭhamaṃ jhānaṃ samāpajjeyyāti. ",
  "kv20.2:2.4": "āmantā. ",
  "kv20.2:2.5": "hañci puthujjano paṭhamaṃ jhānaṃ samāpajjeyya no vata re vattabbe ",
  "kv20.2:2.6": "natthi puthujjanassa ñāṇanti. .. ",
  "kv20.2:3.1": "puthujjano dutiyaṃ jhānaṃ …pe… ",
  "kv20.2:3.2": "tatiyaṃ jhānaṃ .. ",
  "kv20.2:3.3": "catutthaṃ jhānaṃ …pe… ",
  "kv20.2:3.4": "ākāsānañcāyatanaṃ samāpajjeyya ",
  "kv20.2:3.5": "viññāṇañcāyatanaṃ .. ākiñcaññāyatanaṃ .. nevasaññānāsaññāyatanaṃ samāpajjeyya ",
  "kv20.2:3.6": "puthujjano dānaṃ dadeyya …pe… ",
  "kv20.2:3.7": "cīvaraṃ dadeyya …pe… ",
  "kv20.2:3.8": "piṇḍapātaṃ dadeyya ",
  "kv20.2:3.9": "senāsanaṃ dadeyya …pe… ",
  "kv20.2:3.10": "gilānapaccayabhesajjaparikkhāraṃ dadeyyāti. ",
  "kv20.2:3.11": "āmantā. ",
  "kv20.2:3.12": "hañci puthujjano gilānapaccayabhesajjaparikkhāraṃ dadeyya no vata re vattabbe ",
  "kv20.2:3.13": "natthi puthujjanassa ñāṇanti. ",
  "kv20.2:4.1": "atthi puthujjanassa ñāṇanti. ",
  "kv20.2:4.2": "āmantā. ",
  "kv20.2:4.3": "puthujjano tena ñāṇena dukkhaṃ parijānāti samudayaṃ pajahati nirodhaṃ sacchikaroti maggaṃ bhāvetīti. ",
  "kv20.2:4.4": "na hevaṃ vattabbe …pe… ",
  "kv20.2:4.5": "ñāṇakathā. "
}
