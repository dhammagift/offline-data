  "kv20.1:8.1": "saṅghabhedako ānantarikoti. ",
  "kv20.1:8.2": "āmantā. ",
  "kv20.1:8.3": "sabbe saṅghabhedakā ānantarikāti. ",
  "kv20.1:8.4": "na hevaṃ vattabbe …pe… ",
  "kv20.1:8.5": "sabbe saṅghabhedakā ānantarikāti. ",
  "kv20.1:8.6": "āmantā. ",
  "kv20.1:8.7": "dhammasaññī saṅghabhedako ānantarikoti. ",
  "kv20.1:8.8": "na hevaṃ vattabbe …pe… ",
  "kv20.1:9.1": "dhammasaññī saṅghabhedako ānantarikoti. ",
  "kv20.1:9.2": "āmantā. ",
  "kv20.1:9.3": "nanu vuttaṃ bhagavatā ",
  "kv20.1:9.4": "atthupāli saṅghabhedako āpāyiko nerayiko kappaṭṭho atekiccho ",
  "kv20.1:9.5": "atthupāli saṅghabhedako na āpāyiko na nerayiko na kappaṭṭho na atekicchoti ",
  "kv20.1:9.6": "attheva suttantoti. ",
  "kv20.1:9.7": "āmantā. ",
  "kv20.1:9.8": "tena hi na vattabbaṃ ",
  "kv20.1:9.9": "dhammasaññī saṅghabhedako ānantarikoti. ",
  "kv20.1:10.1": "na vattabbaṃ ",
  "kv20.1:10.2": "dhammasaññī saṅghabhedako ānantarikoti. ",
  "kv20.1:10.3": "āmantā. ",
  "kv20.1:10.4": "nanu vuttaṃ bhagavatā ",
  "kv20.1:11.1": "āpāyiko nerayiko ",
  "kv20.1:11.2": "kappaṭṭho saṅghabhedako ",
  "kv20.1:11.3": "vaggarato adhammaṭṭho ",
  "kv20.1:11.4": "yogakkhemā padhaṃsati ",
  "kv20.1:11.5": "saṅghaṃ samaggaṃ bhetvāna ",
  "kv20.1:11.6": "kappaṃ nirayamhi paccatīti ",
  "kv20.1:12.1": "attheva suttantoti. ",
  "kv20.1:12.2": "āmantā. ",
  "kv20.1:12.3": "tena hi saṅghabhedako anantarikoti. ",
  "kv20.1:12.4": "asañciccakathā. "
