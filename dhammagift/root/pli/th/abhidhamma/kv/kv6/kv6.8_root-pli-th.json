  "kv6.8:0.1": "",
  "kv6.8:0.2": "",
  "kv6.8:0.3": "",
  "kv6.8:0.4": "paṭhavīdhātu sanidassanātyādikathā ",
  "kv6.8:1.1": "paṭhavīdhātu sanidassanāti. ",
  "kv6.8:1.2": "āmantā. ",
  "kv6.8:1.3": "rūpaṃ rūpāyatanaṃ rūpadhātu nīlaṃ pītakaṃ lohitakaṃ odātaṃ cakkhuviññeyyaṃ cakkhusmiṃ paṭihaññati cakkhussa āpāthaṃ āgacchatīti. ",
  "kv6.8:1.4": "na hevaṃ vattabbe …pe… ",
  "kv6.8:2.1": "paṭhavīdhātu sanidassanāti. ",
  "kv6.8:2.2": "āmantā. ",
  "kv6.8:2.3": "cakkhuñca paṭicca paṭhavīdhātuñca uppajjati cakkhuviññāṇanti. ",
  "kv6.8:2.4": "na hevaṃ vattabbe …pe… ",
  "kv6.8:3.1": "cakkhuñca paṭicca paṭhavīdhātuñca uppajjati cakkhuviññāṇanti. ",
  "kv6.8:3.2": "āmantā. ",
  "kv6.8:3.3": "cakkhuñca paṭicca paṭhavīdhātuñca uppajjati cakkhuviññāṇanti ",
  "kv6.8:3.4": "attheva suttantoti. ",
  "kv6.8:3.5": "natthi. ",
  "kv6.8:3.6": "cakkhuñca paṭicca rūpe ca uppajjati cakkhuviññāṇanti ",
  "kv6.8:3.7": "attheva suttantoti. ",
  "kv6.8:3.8": "āmantā. ",
  "kv6.8:3.9": "hañci cakkhuñca paṭicca rūpe ca uppajjati cakkhuviññāṇanti ",
  "kv6.8:3.10": "attheva suttanto no vata re vattabbe ",
  "kv6.8:3.11": "cakkhuñca paṭicca paṭhavīdhātuñca uppajjati cakkhuviññāṇanti. ",
  "kv6.8:4.1": "na vattabbaṃ ",
  "kv6.8:4.2": "paṭhavīdhātu sanidassanāti. ",
  "kv6.8:4.3": "āmantā. ",
  "kv6.8:4.4": "nanu passasi bhūmiṃ pāsāṇaṃ pabbatanti. ",
  "kv6.8:4.5": "āmantā. ",
  "kv6.8:4.6": "hañci passasi bhūmiṃ pāsāṇaṃ pabbataṃ tena vata re vattabbe ",
  "kv6.8:4.7": "paṭhavīdhātu sanidassanāti …pe… ",
  "kv6.8:5.1": "na vattabbaṃ ",
  "kv6.8:5.2": "āpodhātu sanidassanāti. ",
  "kv6.8:5.3": "āmantā. ",
  "kv6.8:5.4": "nanu passasi udakanti. ",
  "kv6.8:5.5": "āmantā. ",
  "kv6.8:5.6": "hañci passasi udakaṃ tena vata re vattabbe ",
  "kv6.8:5.7": "āpodhātu sanidassanāti …pe… ",
  "kv6.8:6.1": "na vattabbaṃ ",
  "kv6.8:6.2": "tejodhātu sanidassanāti. ",
  "kv6.8:6.3": "āmantā. ",
  "kv6.8:6.4": "nanu passasi aggiṃ jalantanti. ",
  "kv6.8:6.5": "āmantā. ",
  "kv6.8:6.6": "hañci passasi aggiṃ jalantaṃ tena vata re vattabbe ",
  "kv6.8:6.7": "tejodhātu sanidassanāti …pe… ",
  "kv6.8:7.1": "na vattabbaṃ ",
  "kv6.8:7.2": "vāyodhātu sanidassanāti. ",
  "kv6.8:7.3": "āmantā. ",
  "kv6.8:7.4": "nanu passasi vātena rukkhe sañcāliyamāneti. ",
  "kv6.8:7.5": "āmantā. ",
  "kv6.8:7.6": "hañci passasi vātena rukkhe sañcāliyamāne tena vata re vattabbe ",
  "kv6.8:7.7": "vāyodhātu sanidassanāti …pe… ",
  "kv6.8:7.8": "paṭhavīdhātu sanidassanātyādikathā. "
}
