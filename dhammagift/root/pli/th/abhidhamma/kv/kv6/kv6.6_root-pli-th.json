  "kv6.6:0.3": "",
  "kv6.6:0.4": "ākāsakathā ",
  "kv6.6:1.1": "ākāso asaṅkhatoti. ",
  "kv6.6:1.2": "āmantā. ",
  "kv6.6:1.3": "nibbānaṃ tāṇaṃ leṇaṃ saraṇaṃ parāyanaṃ accutaṃ amatanti. ",
  "kv6.6:1.4": "na hevaṃ vattabbe …pe… ",
  "kv6.6:1.5": "ākāso asaṅkhato nibbānaṃ asaṅkhatanti. ",
  "kv6.6:1.6": "āmantā. ",
  "kv6.6:1.7": "dve asaṅkhatānīti. ",
  "kv6.6:1.8": "na hevaṃ vattabbe …pe… ",
  "kv6.6:1.9": "dve asaṅkhatānīti. ",
  "kv6.6:1.10": "āmantā. ",
  "kv6.6:1.11": "dve tāṇāni …pe… antarikā vāti. ",
  "kv6.6:1.12": "na hevaṃ vattabbe …pe… ",
  "kv6.6:2.1": "ākāso asaṅkhatoti. ",
  "kv6.6:2.2": "āmantā. ",
  "kv6.6:2.3": "atthi keci anākāsaṃ ākāsaṃ karontīti. ",
  "kv6.6:2.4": "āmantā. ",
  "kv6.6:2.5": "atthi keci saṅkhataṃ asaṅkhataṃ karontīti. ",
  "kv6.6:2.6": "na hevaṃ vattabbe …pe… ",
  "kv6.6:2.7": "atthi keci ākāsaṃ anākāsaṃ karontīti. ",
  "kv6.6:2.8": "āmantā. ",
  "kv6.6:2.9": "atthi keci asaṅkhataṃ saṅkhataṃ karontīti. ",
  "kv6.6:2.10": "na hevaṃ vattabbe …pe… ",
  "kv6.6:3.1": "ākāse pakkhino gacchanti candimasuriyā gacchanti tārakarūpāni gacchanti iddhiṃ vikubbanti bāhuṃ cālenti pāṇiṃ cālenti leḍḍuṃ khipanti laguḷaṃ khipanti iddhiṃ khipanti usuṃ khipantīti. ",
  "kv6.6:3.2": "āmantā. ",
  "kv6.6:3.3": "asaṅkhate pakkhino gacchanti candimasuriyā gacchanti tārakarūpāni gacchanti iddhiṃ vikubbanti bāhuṃ cālenti pāṇiṃ cālenti leḍḍuṃ khipanti laguḷaṃ khipanti iddhiṃ khipanti usuṃ khipantīti. ",
  "kv6.6:3.4": "na hevaṃ vattabbe …pe… ",
  "kv6.6:4.1": "ākāsaṃ parivāretvā gharāni karonti koṭṭhāni karontīti. ",
  "kv6.6:4.2": "āmantā. ",
  "kv6.6:4.3": "asaṅkhataṃ parivāretvā gharāni karonti koṭṭhāni karontīti. ",
  "kv6.6:4.4": "na hevaṃ vattabbe …pe… ",
  "kv6.6:5.1": "udapāne khaññamāne anākāso ākāso hotīti. ",
  "kv6.6:5.2": "āmantā. ",
  "kv6.6:5.3": "saṅkhataṃ asaṅkhataṃ hotīti. ",
  "kv6.6:5.4": "na hevaṃ vattabbe …pe… ",
  "kv6.6:6.1": "tucchaudapāne pūriyamāne tucchakoṭṭhe pūriyamāne tucchakumbhiyā pūriyamānāya ākāso antaradhāyatīti. ",
  "kv6.6:6.2": "āmantā. ",
  "kv6.6:6.3": "asaṅkhataṃ antaradhāyatīti. ",
  "kv6.6:6.4": "na hevaṃ vattabbe …pe… ",
  "kv6.6:7.1": "na vattabbaṃ ",
  "kv6.6:7.2": "ākāso asaṅkhatoti. ",
  "kv6.6:7.3": "āmantā. ",
  "kv6.6:7.4": "ākāso saṅkhatoti. ",
  "kv6.6:7.5": "na hevaṃ vattabbe …pe… ",
  "kv6.6:7.6": "tena hi ākāso asaṅkhatoti. ",
  "kv6.6:7.7": "ākāsakathā. "
}
