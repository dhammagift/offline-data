  "kv6.2:0.4": "paṭiccasamuppādakathā ",
  "kv6.2:1.1": "paṭiccasamuppādo asaṅkhatoti. ",
  "kv6.2:1.2": "āmantā. ",
  "kv6.2:1.3": "nibbānaṃ tāṇaṃ leṇaṃ saraṇaṃ parāyanaṃ accutaṃ amatanti. ",
  "kv6.2:1.4": "na hevaṃ vattabbe …pe… ",
  "kv6.2:1.5": "paṭiccasamuppādo asaṅkhato nibbānaṃ asaṅkhatanti. ",
  "kv6.2:1.6": "āmantā. ",
  "kv6.2:1.7": "dve asaṅkhatānīti. ",
  "kv6.2:1.8": "na hevaṃ vattabbe …pe… ",
  "kv6.2:1.9": "dve asaṅkhatānīti. ",
  "kv6.2:1.10": "āmantā. ",
  "kv6.2:1.11": "dve tāṇāni dve leṇāni dve saraṇāni dve parāyanāni dve accutāni dve amatāni dve nibbānānīti. ",
  "kv6.2:1.12": "na hevaṃ vattabbe …pe… ",
  "kv6.2:1.13": "dve nibbānānīti. ",
  "kv6.2:1.14": "āmantā. ",
  "kv6.2:1.15": "atthi dvinnaṃ nibbānānaṃ uccanīcatā hīnappaṇītatā ukkaṃsāvakaṃso sīmā vā bhedo vā rāji vā antarikā vāti. ",
  "kv6.2:1.16": "na hevaṃ vattabbe …pe… ",
  "kv6.2:2.1": "paṭiccasamuppādo asaṅkhatoti. ",
  "kv6.2:2.2": "āmantā. ",
  "kv6.2:2.3": "avijjā asaṅkhatāti. ",
  "kv6.2:2.4": "na hevaṃ vattabbe …pe… ",
  "kv6.2:2.5": "avijjā saṅkhatāti. ",
  "kv6.2:2.6": "āmantā. ",
  "kv6.2:2.7": "paṭiccasamuppādo saṅkhatoti. ",
  "kv6.2:2.8": "na hevaṃ vattabbe …pe… ",
  "kv6.2:2.9": "paṭiccasamuppādo asaṅkhatoti. ",
  "kv6.2:2.10": "āmantā. ",
  "kv6.2:2.11": "avijjāpaccayā saṅkhārā asaṅkhatāti. ",
  "kv6.2:2.12": "na hevaṃ vattabbe …pe… ",
  "kv6.2:2.13": "avijjāpaccayā saṅkhārā saṅkhatāti. ",
  "kv6.2:2.14": "āmantā. ",
  "kv6.2:2.15": "paṭiccasamuppādo saṅkhatoti. ",
  "kv6.2:2.16": "na hevaṃ vattabbe …pe… ",
  "kv6.2:2.17": "paṭiccasamuppādo asaṅkhatoti. ",
  "kv6.2:2.18": "āmantā. ",
  "kv6.2:2.19": "saṅkhārapaccayā viññāṇaṃ asaṅkhatanti. ",
  "kv6.2:2.20": "na hevaṃ vattabbe …pe… ",
  "kv6.2:2.21": "saṅkhārapaccayā viññāṇaṃ saṅkhatanti. ",
  "kv6.2:2.22": "āmantā. ",
  "kv6.2:2.23": "paṭiccasamuppādo saṅkhatoti. ",
  "kv6.2:2.24": "na hevaṃ vattabbe …pe… ",
  "kv6.2:2.25": "paṭiccasamuppādo asaṅkhatoti. ",
  "kv6.2:2.26": "āmantā. ",
  "kv6.2:2.27": "viññāṇapaccayā nāmarūpaṃ asaṅkhatanti. ",
  "kv6.2:2.28": "na hevaṃ vattabbe …pe… ",
  "kv6.2:2.29": "viññāṇapaccayā nāmarūpaṃ saṅkhatanti. ",
  "kv6.2:2.30": "āmantā. ",
  "kv6.2:2.31": "paṭiccasamuppādo saṅkhatoti. ",
  "kv6.2:2.32": "na hevaṃ vattabbe …pe… ",
  "kv6.2:2.33": "paṭiccasamuppādo asaṅkhatoti. ",
  "kv6.2:2.34": "āmantā. ",
  "kv6.2:2.35": "jātipaccayā jarāmaraṇaṃ asaṅkhatanti. ",
  "kv6.2:2.36": "na hevaṃ vattabbe …pe… ",
  "kv6.2:2.37": "jātipaccayā jarāmaraṇaṃ saṅkhatanti. ",
  "kv6.2:2.38": "āmantā. ",
  "kv6.2:2.39": "paṭiccasamuppādo saṅkhatoti. ",
  "kv6.2:2.40": "na hevaṃ vattabbe …pe… ",
  "kv6.2:3.1": "na vattabbaṃ ",
  "kv6.2:3.2": "paṭiccasamuppādo asaṅkhatoti. ",
  "kv6.2:3.3": "āmantā. ",
  "kv6.2:3.4": "nanu vuttaṃ bhagavatā ",
  "kv6.2:3.5": "jātipaccayā bhikkhave jarāmaraṇaṃ ",
  "kv6.2:3.6": "uppādā vā tathāgatānaṃ anuppādā vā tathāgatānaṃ ṭhitāva sā dhātu dhammaṭṭhitatā dhammaniyāmatā idappaccayatā ",
  "kv6.2:3.7": "taṃ tathāgato abhisambujjhati abhisameti ",
  "kv6.2:3.8": "abhisambujjhitvā abhisametvā ācikkhati deseti paññapeti paṭṭhapeti vivarati vibhajati uttānīkaroti ",
  "kv6.2:3.9": "passathāti cāha ",
  "kv6.2:3.10": "jātipaccayā bhikkhave jarāmaraṇaṃ ",
  "kv6.2:3.11": "bhavapaccayā bhikkhave jāti …pe… ",
  "kv6.2:3.12": "avijjāpaccayā bhikkhave saṅkhārā ",
  "kv6.2:3.13": "uppādā vā tathāgatānaṃ anuppādā vā tathāgatānaṃ ṭhitāva sā dhātu …pe… ",
  "kv6.2:3.14": "passathāti cāha ",
  "kv6.2:3.15": "avijjāpaccayā bhikkhave saṅkhārā ",
  "kv6.2:3.16": "iti kho bhikkhave yā tatra tathatā avitathatā anaññathatā idappaccayatā ",
  "kv6.2:3.17": "ayaṃ vuccati bhikkhave paṭiccasamuppādoti ",
  "kv6.2:3.18": "attheva suttantoti. ",
  "kv6.2:3.19": "āmantā. ",
  "kv6.2:3.20": "tena hi paṭiccasamuppādo asaṅkhatoti. ",
  "kv6.2:4.1": "avijjāpaccayā saṅkhārāti yā tattha dhammaṭṭhitatā dhammaniyāmatā asaṅkhatā nibbānaṃ asaṅkhatanti. ",
  "kv6.2:4.2": "āmantā. ",
  "kv6.2:4.3": "dve asaṅkhatānīti. ",
  "kv6.2:4.4": "na hevaṃ vattabbe …pe… ",
  "kv6.2:4.5": "dve asaṅkhatānīti. ",
  "kv6.2:4.6": "āmantā. ",
  "kv6.2:4.7": "dve tāṇāni …pe… ",
  "kv6.2:4.8": "antarikā vāti. ",
  "kv6.2:4.9": "na hevaṃ vattabbe …pe… ",
  "kv6.2:5.1": "avijjāpaccayā saṅkhārāti yā tattha dhammaṭṭhitatā dhammaniyāmatā asaṅkhatā saṅkhārapaccayā viññāṇanti yā tattha dhammaṭṭhitatā dhammaniyāmatā asaṅkhatā nibbānaṃ asaṅkhatanti. ",
  "kv6.2:5.2": "āmantā. ",
  "kv6.2:5.3": "tīṇi asaṅkhatānīti. ",
  "kv6.2:5.4": "na hevaṃ vattabbe …pe… ",
  "kv6.2:5.5": "tīṇi asaṅkhatānīti. ",
  "kv6.2:5.6": "āmantā. ",
  "kv6.2:5.7": "tīṇi tāṇāni …pe… ",
  "kv6.2:5.8": "antarikā vāti. ",
  "kv6.2:5.9": "na hevaṃ vattabbe …pe… ",
  "kv6.2:6.1": "avijjāpaccayā saṅkhārāti yā tattha dhammaṭṭhitatā dhammaniyāmatā asaṅkhatā saṅkhārapaccayā viññāṇanti yā tattha dhammaṭṭhitatā dhammaniyāmatā asaṅkhatā …pe… ",
  "kv6.2:6.2": "jātipaccayā jarāmaraṇanti yā tattha dhammaṭṭhitatā dhammaniyāmatā asaṅkhatā nibbānaṃ asaṅkhatanti. ",
  "kv6.2:6.3": "āmantā. ",
  "kv6.2:6.4": "dvādasa asaṅkhatānīti. ",
  "kv6.2:6.5": "na hevaṃ vattabbe …pe… ",
  "kv6.2:6.6": "dvādasa asaṅkhatānīti. ",
  "kv6.2:6.7": "āmantā. ",
  "kv6.2:6.8": "dvādasa tāṇāni dvādasa leṇāni …pe… ",
  "kv6.2:6.9": "antarikā vāti. ",
  "kv6.2:6.10": "na hevaṃ vattabbe …pe… ",
  "kv6.2:6.11": "paṭiccasamuppādakathā. "
