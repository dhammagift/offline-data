  "kv6.9:0.3": "",
  "kv6.9:0.4": "cakkhundriyaṃ sanidassanantiādikathā ",
  "kv6.9:1.1": "cakkhundriyaṃ sanidassananti. ",
  "kv6.9:1.2": "āmantā. ",
  "kv6.9:1.3": "rūpaṃ rūpāyatanaṃ rūpadhātu …pe… ",
  "kv6.9:1.4": "cakkhussa āpāthaṃ āgacchatīti. ",
  "kv6.9:1.5": "na hevaṃ vattabbe …pe… ",
  "kv6.9:2.1": "cakkhundriyaṃ sanidassananti. ",
  "kv6.9:2.2": "āmantā. ",
  "kv6.9:2.3": "cakkhuñca paṭicca cakkhundriyañca uppajjati cakkhuviññāṇanti. ",
  "kv6.9:2.4": "na hevaṃ vattabbe …pe… ",
  "kv6.9:3.1": "cakkhuñca paṭicca cakkhundriyañca uppajjati cakkhuviññāṇanti. ",
  "kv6.9:3.2": "āmantā. ",
  "kv6.9:3.3": "cakkhuñca paṭicca cakkhundriyañca uppajjati cakkhuviññāṇanti ",
  "kv6.9:3.4": "attheva suttantoti. ",
  "kv6.9:3.5": "natthi. ",
  "kv6.9:3.6": "cakkhuñca paṭicca rūpe ca uppajjati cakkhuviññāṇanti ",
  "kv6.9:3.7": "attheva suttantoti. ",
  "kv6.9:3.8": "āmantā. ",
  "kv6.9:3.9": "hañci cakkhuñca paṭicca rūpe ca uppajjati cakkhuviññāṇanti ",
  "kv6.9:3.10": "attheva suttanto no vata re vattabbe ",
  "kv6.9:3.11": "cakkhuñca paṭicca cakkhundriyañca uppajjati cakkhuviññāṇanti. ",
  "kv6.9:4.1": "na vattabbaṃ ",
  "kv6.9:4.2": "pañcindriyāni sanidassanānīti. ",
  "kv6.9:4.3": "āmantā. ",
  "kv6.9:4.4": "nanu passasi cakkhuṃ sotaṃ ghānaṃ jivhaṃ kāyanti. ",
  "kv6.9:4.5": "āmantā. ",
  "kv6.9:4.6": "hañci passasi cakkhuṃ sotaṃ ghānaṃ jivhaṃ kāyaṃ tena vata re vattabbe ",
  "kv6.9:4.7": "pañcindriyāni sanidassanānīti …pe… ",
  "kv6.9:4.8": "cakkhundriyaṃ sanidassanantiādikathā. "
}
