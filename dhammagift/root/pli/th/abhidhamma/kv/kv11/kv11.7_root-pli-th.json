  "kv11.7:0.4": "dhammaṭṭhitatākathā ",
  "kv11.7:1.1": "dhammaṭṭhittā parinipphannāti. ",
  "kv11.7:1.2": "āmantā. ",
  "kv11.7:1.3": "tāya ṭhitatā parinipphannāti. ",
  "kv11.7:1.4": "na hevaṃ vattabbe …pe… ",
  "kv11.7:1.5": "tāya ṭhitatā parinipphannāti. ",
  "kv11.7:1.6": "āmantā. ",
  "kv11.7:1.7": "tāya tāyeva natthi dukkhassa antakiriyā natthi vaṭṭūpacchedo natthi anupādāparinibbānanti. ",
  "kv11.7:1.8": "na hevaṃ vattabbe …pe… ",
  "kv11.7:2.1": "rūpassa ṭhitatā parinipphannāti. ",
  "kv11.7:2.2": "āmantā. ",
  "kv11.7:2.3": "tāya ṭhitatā parinipphannāti. ",
  "kv11.7:2.4": "na hevaṃ vattabbe …pe… ",
  "kv11.7:2.5": "tāya ṭhitatā parinipphannāti. ",
  "kv11.7:2.6": "āmantā. ",
  "kv11.7:2.7": "tāya tāyeva natthi dukkhassa antakiriyā natthi vaṭṭūpacchedo natthi anupādāparinibbānanti. ",
  "kv11.7:2.8": "na hevaṃ vattabbe …pe… ",
  "kv11.7:3.1": "vedanāya ṭhitatā …pe… ",
  "kv11.7:3.2": "saññāya ṭhitatā …pe… ",
  "kv11.7:3.3": "saṅkhārānaṃ ṭhitatā …pe… ",
  "kv11.7:3.4": "viññāṇassa ṭhitatā parinipphannāti. ",
  "kv11.7:3.5": "āmantā. ",
  "kv11.7:3.6": "tāya ṭhitatā parinipphannāti. ",
  "kv11.7:3.7": "na hevaṃ vattabbe …pe… ",
  "kv11.7:3.8": "tāya ṭhitatā parinipphannāti. ",
