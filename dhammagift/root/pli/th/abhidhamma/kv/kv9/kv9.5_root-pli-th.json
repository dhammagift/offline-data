  "kv9.5:0.1": "",
  "kv9.5:0.2": "",
  "kv9.5:0.3": "",
  "kv9.5:0.4": "ñāṇaṃ anārammaṇantikathā ",
  "kv9.5:1.1": "ñāṇaṃ anārammaṇanti. ",
  "kv9.5:1.2": "āmantā. ",
  "kv9.5:1.3": "rūpaṃ nibbānaṃ cakkhāyatanaṃ …pe… ",
  "kv9.5:1.4": "phoṭṭhabbāyatananti. ",
  "kv9.5:1.5": "na hevaṃ vattabbe …pe… ",
  "kv9.5:1.6": "ñāṇaṃ anārammaṇanti. ",
  "kv9.5:1.7": "āmantā. ",
  "kv9.5:1.8": "paññā paññindriyaṃ paññābalaṃ sammādiṭṭhi dhammavicayasambojjhaṅgo anārammaṇoti. ",
  "kv9.5:1.9": "na hevaṃ vattabbe …pe… ",
  "kv9.5:1.10": "paññā paññindriyaṃ paññābalaṃ sammādiṭṭhi dhammavicayasambojjhaṅgo sārammaṇoti. ",
  "kv9.5:1.11": "āmantā. ",
  "kv9.5:1.12": "ñāṇaṃ sārammaṇanti. ",
  "kv9.5:1.13": "na hevaṃ vattabbe …pe… ",
  "kv9.5:2.1": "ñāṇaṃ anārammaṇanti. ",
  "kv9.5:2.2": "āmantā. ",
  "kv9.5:2.3": "katamakkhandhapariyāpannanti. ",
  "kv9.5:2.4": "saṅkhārakkhandhapariyāpannanti. ",
  "kv9.5:2.5": "saṅkhārakkhandho anāramma ṇoti. ",
  "kv9.5:2.6": "na hevaṃ vattabbe …pe… ",
  "kv9.5:2.7": "saṅkhārakkhandho anārammaṇoti. ",
  "kv9.5:2.8": "āmantā. ",
  "kv9.5:2.9": "vedanākkhandho saññākkhandho viññāṇakkhandho anārammaṇoti. ",
  "kv9.5:2.10": "na hevaṃ vattabbe …pe… ",
  "kv9.5:2.11": "ñāṇaṃ saṅkhārakkhandhapariyāpannaṃ anārammaṇanti. ",
  "kv9.5:2.12": "āmantā. ",
  "kv9.5:2.13": "paññā saṅkhārakkhandhapariyāpannā anārammaṇāti. ",
  "kv9.5:2.14": "na hevaṃ vattabbe …pe… ",
  "kv9.5:2.15": "paññā saṅkhārakkhandhapariyāpannā sārammaṇāti. ",
  "kv9.5:2.16": "āmantā. ",
  "kv9.5:2.17": "ñāṇaṃ saṅkhārakkhandhapariyāpannaṃ sārammaṇanti. ",
  "kv9.5:2.18": "na hevaṃ vattabbe …pe… ",
  "kv9.5:3.1": "ñāṇaṃ saṅkhārakkhandhapariyāpannaṃ anārammaṇaṃ paññā saṅkhārakkhandhapariyāpannā sārammaṇāti. ",
  "kv9.5:3.2": "āmantā. ",
  "kv9.5:3.3": "saṅkhārakkhandho akadeso sārammaṇo ekadeso anārammaṇoti. ",
  "kv9.5:3.4": "na hevaṃ vattabbe …pe… ",
  "kv9.5:3.5": "saṅkhārakkhandho ekadeso sārammaṇo ekadeso anārammaṇoti. ",
  "kv9.5:3.6": "āmantā. ",
  "kv9.5:3.7": "vedanākkhandho saññākkhandho viññāṇakkhandho ekadeso sārammaṇo ekadeso anārammaṇoti. ",
  "kv9.5:3.8": "na hevaṃ vattabbe …pe… ",
  "kv9.5:4.1": "na vattabbaṃ ",
  "kv9.5:4.2": "ñāṇaṃ anārammaṇanti. ",
  "kv9.5:4.3": "āmantā. ",
  "kv9.5:4.4": "arahā cakkhuviññāṇasamaṅgī ñāṇīti vattabboti. ",
  "kv9.5:4.5": "āmantā. ",
  "kv9.5:4.6": "atthi tassa ñāṇassa ārammaṇanti. ",
  "kv9.5:4.7": "na hevaṃ vattabbe …pe… ",
  "kv9.5:4.8": "tena hi ñāṇaṃ anārammaṇanti. ",
  "kv9.5:4.9": "arahā cakkhuviññāṇasamaṅgī paññavāti vattabboti. ",
  "kv9.5:4.10": "āmantā. ",
  "kv9.5:4.11": "atthi tāya paññāya ārammaṇanti. ",
  "kv9.5:4.12": "na hevaṃ vattabbe …pe… ",
  "kv9.5:4.13": "tena hi paññā anārammaṇāti. ",
  "kv9.5:4.14": "ñāṇaṃ anārammaṇantikathā. "
}
