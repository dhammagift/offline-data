  "kv19.7:0.4": "accantaniyāmakathā ",
  "kv19.7:1.1": "atthi puthujjanassa accantaniyāmatāti. ",
  "kv19.7:1.2": "āmantā. ",
  "kv19.7:1.3": "mātughātako accantaniyato pitughātako …pe… ",
  "kv19.7:1.4": "arahantaghātako …pe… ",
  "kv19.7:1.5": "ruhiruppādako …pe… ",
  "kv19.7:1.6": "saṅghabhedako accantaniyatoti. ",
  "kv19.7:1.7": "na hevaṃ vattabbe …pe… ",
  "kv19.7:2.1": "atthi puthujjanassa accantaniyāmatāti. ",
  "kv19.7:2.2": "āmantā. ",
  "kv19.7:2.3": "accantaniyatassa puggalassa vicikicchā uppajjeyyāti. ",
  "kv19.7:2.4": "āmantā. ",
  "kv19.7:2.5": "hañci accantaniyatassa puggalassa vicikicchā uppajjeyya no vata re vattabbe ",
  "kv19.7:2.6": "atthi puthujjanassa accantaniyāmatāti. ",
  "kv19.7:3.1": "accantaniyatassa puggalassa vicikicchā nuppajjeyyāti. ",
  "kv19.7:3.2": "āmantā. ",
  "kv19.7:3.3": "pahīnāti. ",
  "kv19.7:3.4": "na hevaṃ vattabbe …pe… ",
  "kv19.7:3.5": "pahīnāti. ",
  "kv19.7:3.6": "āmantā. ",
  "kv19.7:3.7": "sotāpattimaggenāti. ",
  "kv19.7:3.8": "na hevaṃ vattabbe …pe… ",
  "kv19.7:3.9": "sakadāgāmimaggena …pe… ",
  "kv19.7:3.10": "anāgāmimaggena …pe… ",
  "kv19.7:3.11": "arahattamaggenāti. ",
  "kv19.7:3.12": "na hevaṃ vattabbe …pe… ",
  "kv19.7:4.1": "katamena maggenāti. ",
  "kv19.7:4.2": "akusalena maggenāti. ",
  "kv19.7:4.3": "akusalo maggo niyyāniko khayagāmī bodhagāmī apacayagāmī anāsavo …pe… asaṅkilesikoti. ",
  "kv19.7:4.4": "na hevaṃ vattabbe …pe… ",
  "kv19.7:4.5": "nanu akusalo maggo aniyyāniko …pe… ",
  "kv19.7:4.6": "saṅkilesikoti. ",
  "kv19.7:4.7": "āmantā. ",
  "kv19.7:4.8": "hañci akusalo maggo aniyyāniko …pe… ",
  "kv19.7:4.9": "saṅkilesiko no vata re vattabbe ",
  "kv19.7:4.10": "accantaniyatassa puggalassa vicikicchā akusalena maggena pahīnāti. ",
  "kv19.7:5.1": "sassatadiṭṭhiyā niyatassa puggalassa ucchedadiṭṭhi uppajjeyyāti. ",
  "kv19.7:5.2": "āmantā. ",
  "kv19.7:5.3": "hañci sassatadiṭṭhiyā niyatassa puggalassa ucchedadiṭṭhi uppajjeyya no vata re vattabbe ",
  "kv19.7:5.4": "atthi puthujjanassa accantaniyāmatāti. ",
  "kv19.7:6.1": "sassatadiṭṭhiyā niyatassa puggalassa ucchedadiṭṭhi nuppaja jeyyāti. ",
  "kv19.7:6.2": "āmantā. ",
  "kv19.7:6.3": "pahīnāti. ",
  "kv19.7:6.4": "na hevaṃ vattabbe …pe… ",
  "kv19.7:6.5": "pahīnāti. ",
  "kv19.7:6.6": "āmantā. ",
  "kv19.7:6.7": "sotāpattimaggenāti. ",
  "kv19.7:6.8": "na hevaṃ vattabbe …pe… ",
  "kv19.7:6.9": "sakadāgāmimaggena …pe… ",
  "kv19.7:6.10": "anāgāmimaggena …pe… ",
  "kv19.7:6.11": "arahattamaggenāti. ",
  "kv19.7:6.12": "na hevaṃ vattabbe …pe… ",
  "kv19.7:7.1": "katamena maggenāti. ",
  "kv19.7:7.2": "akusalena maggenāti. ",
  "kv19.7:7.3": "akusalo maggo …pe… no vata re vattabbe ",
  "kv19.7:7.4": "sassatadiṭṭhiyā niyatassa puggalassa ucchedadiṭṭhi akusalena maggena pahīnāti. ",
  "kv19.7:8.1": "ucchedadiṭṭhiyā niyatassa puggalassa sassatadiṭṭhi uppajjeyyāti. ",
  "kv19.7:8.2": "āmantā. ",
  "kv19.7:8.3": "hañci ucchedadiṭṭhiyā niyatassa puggalassa sassatadiṭṭhi uppajjeyya no vata re vattabbe ",
  "kv19.7:8.4": "atthi puthujjanassa accantaniyāmatāti. ",
  "kv19.7:9.1": "ucchedadiṭṭhiyā niyatassa puggalassa sassatadiṭṭhi nuppajjeyyāti. ",
  "kv19.7:9.2": "āmantā. ",
  "kv19.7:9.3": "pahīnāti. ",
  "kv19.7:9.4": "na hevaṃ vattabbe …pe… ",
  "kv19.7:9.5": "pahīnāti. ",
  "kv19.7:9.6": "āmantā. ",
  "kv19.7:9.7": "sotāpattimaggenāti. ",
  "kv19.7:9.8": "na hevaṃ vattabbe …pe… ",
  "kv19.7:9.9": "sakadāgāmimaggena …pe… ",
  "kv19.7:9.10": "",
  "kv19.7:9.11": "arahattamaggenāti. ",
  "kv19.7:9.12": "na hevaṃ vattabbe …pe… ",
  "kv19.7:10.1": "katamena maggenāti. ",
  "kv19.7:10.2": "akusalena maggenāti. ",
  "kv19.7:10.3": "akusalo maggo …pe… no vata re vattabbe ",
  "kv19.7:10.4": "ucchedadiṭṭhiyā niyatassa puggalassa sassatadiṭṭhi akusalena maggena pahīnāti. ",
  "kv19.7:11.1": "na vattabbaṃ ",
  "kv19.7:11.2": "atthi puthujjanassa accantaniyāmatāti. ",
  "kv19.7:11.3": "āmantā. ",
  "kv19.7:11.4": "nanu vuttaṃ bhagavatā ",
  "kv19.7:11.5": "idha bhikkhave ekacco puggalo samannāgato hoti ekantakāḷakehi akusalehi dhammehi so sakiṃ nimuggo nimuggova hotīti ",
  "kv19.7:11.6": "attheva suttantoti. ",
  "kv19.7:11.7": "āmantā. ",
  "kv19.7:11.8": "tena hi atthi puthujjanassa accantaniyāmatāti. ",
  "kv19.7:12.1": "vuttaṃ bhagavatā ",
  "kv19.7:12.2": "idha bhikkhave ekacco puggalo samannāgato hoti ekantakāḷakehi akusalehi dhammehi so sakiṃ nimuggo nimuggova hotīti katvā tena ca kāraṇena atthi puthujjanassa accantaniyāmatāti. ",
  "kv19.7:12.3": "āmantā. ",
  "kv19.7:12.4": "vuttaṃ bhagavatā ",
  "kv19.7:12.5": "idha bhikkhave ekacco puggalo ummujjitvā nimujjatīti ",
  "kv19.7:12.6": "attheva suttantoti. ",
  "kv19.7:12.7": "āmantā. ",
  "kv19.7:12.8": "sabbakālaṃ ummujjitvā nimujjatīti. ",
  "kv19.7:12.9": "na hevaṃ vattabbe …pe… ",
  "kv19.7:13.1": "vuttaṃ bhagavatā ",
  "kv19.7:13.2": "idha bhikkhave ekacco puggalo samannāgato hoti ekantakāḷakehi akusalehi dhammehi so sakiṃ nimuggo nimuggova hotīti ",
  "kv19.7:13.3": "katvā tena ca kāraṇena atthi puthujjanassa accantaniyāmatāti. ",
  "kv19.7:13.4": "āmantā. ",
  "kv19.7:13.5": "vuttaṃ bhagavatā ",
  "kv19.7:13.6": "idha bhikkhave ekacco puggalo ummujjitvā ṭhito hoti ummujjitvā vipassati viloketi ummujjitvā patarati ummujjitvā patigādhappatto hotīti ",
  "kv19.7:13.7": "attheva suttantoti. ",
  "kv19.7:13.8": "āmantā. ",
  "kv19.7:13.9": "sabbakālaṃ ummujjitvā patigādhappatto hotīti. ",
  "kv19.7:13.10": "na hevaṃ vattabbe …pe… ",
  "kv19.7:13.11": "accantaniyāmakathā. "
}
