{
  "kv19.2:0.1": "",
  "kv19.2:0.2": "",
  "kv19.2:0.3": "",
  "kv19.2:0.4": "suññatākathā ",
  "kv19.2:1.1": "suññatā saṅkhārakkhandhapariyāpannāti. ",
  "kv19.2:1.2": "āmantā. ",
  "kv19.2:1.3": "animittaṃ saṅkhārakkhandhapariyāpannanti. ",
  "kv19.2:1.4": "na hevaṃ vattabbe …pe… ",
  "kv19.2:1.5": "suññatā saṅkhārakkhandhapariyāpannāti. ",
  "kv19.2:1.6": "āmantā. ",
  "kv19.2:1.7": "appaṇihito saṅkhārakkhandhapariyāpannoti. ",
  "kv19.2:1.8": "na hevaṃ vattabbe …pe… ",
  "kv19.2:1.9": "animittaṃ na vattabbaṃ ",
  "kv19.2:1.10": "saṅkhārakkhandhapariyāpannanti. ",
  "kv19.2:1.11": "āmantā. ",
  "kv19.2:1.12": "suññatā na vattabbā ",
  "kv19.2:1.13": "saṅkhārakkhandhapariyāpannāti. ",
  "kv19.2:1.14": "na hevaṃ vattabbe …pe… ",
  "kv19.2:1.15": "appaṇihito na vattabbo ",
  "kv19.2:1.16": "saṅkhārakkhandhapariyāpannoti. ",
  "kv19.2:1.17": "āmantā. ",
  "kv19.2:1.18": "suññatā na vattabbā ",
  "kv19.2:1.19": "saṅkhārakkhandhapariyāpannāti. ",
  "kv19.2:1.20": "na hevaṃ vattabbe …pe… ",
  "kv19.2:2.1": "suññatā saṅkhārakkhandhapariyāpannāti. ",
  "kv19.2:2.2": "āmantā. ",
  "kv19.2:2.3": "saṅkhārakkhandho na anicco na saṅkhato na paṭiccasamuppanno na khayadhammo na vayadhammo na virāgadhammo na nirodhadhammo na vipariṇāmadhammoti. ",
  "kv19.2:2.4": "na hevaṃ vattabbe …pe… ",
  "kv19.2:2.5": "nanu saṅkhārakkhandho anicco saṅkhato paṭiccasamuppanno khayadhammo vayadhammo virāgadhammo nirodhadhammo vipariṇāmadhammoti. ",
  "kv19.2:2.6": "āmantā. ",
  "kv19.2:2.7": "hañci saṅkhārakkhandho anicco …pe… ",
  "kv19.2:2.8": "vipariṇāmadhammo no vata re vattabbe ",
  "kv19.2:2.9": "suññatā saṅkhārakkhandhapariyāpannāti. ",
  "kv19.2:3.1": "rūpakkhandhassa suññatā saṅkhārakkhandhapariyāpannāti. ",
  "kv19.2:3.2": "āmantā. ",
  "kv19.2:3.3": "saṅkhārakkhandhassa suññatā rūpakkhandhapariyāpannāti. ",
  "kv19.2:3.4": "na hevaṃ vattabbe …pe… ",
  "kv19.2:3.5": "vedanākkhandhassa …pe… ",
  "kv19.2:3.6": "saññākkhandhassa …pe… ",
  "kv19.2:3.7": "viññāṇakkhandhassa suññatā saṅkhārakkhandhapariyāpannāti. ",
  "kv19.2:3.8": "āmantā. ",
  "kv19.2:3.9": "saṅkhārakkhandhassa suññatā viññāṇakkhandhapariyāpannāti. ",
  "kv19.2:3.10": "na hevaṃ vattabbe …pe… ",
  "kv19.2:4.1": "saṅkhārakkhandhassa suññatā na vattabbā ",
  "kv19.2:4.2": "rūpakkhandha- pariyāpannāti. ",
  "kv19.2:4.3": "āmantā. ",
  "kv19.2:4.4": "rūpakkhandhassa suññatā na vattabbā ",
  "kv19.2:4.5": "saṅkhārakkhandhapariyāpannāti. ",
  "kv19.2:4.6": "na hevaṃ vattabbe …pe… ",
  "kv19.2:4.7": "saṅkhārakkhandhassa suññatā na vattabbā ",
  "kv19.2:4.8": "vedanākkhandhapariyāpannā …pe… ",
  "kv19.2:4.9": "saññākkhandhapariyāpannā …pe… ",
  "kv19.2:4.10": "viññāṇakkhandhapariyāpannāti. ",
  "kv19.2:4.11": "āmantā. ",
  "kv19.2:4.12": "viññāṇakkhandhassa suññatā na vattabbā ",
  "kv19.2:4.13": "saṅkhārakkhandhapariyāpannāti. ",
  "kv19.2:4.14": "na hevaṃ vattabbe …pe… ",
  "kv19.2:5.1": "na vattabbaṃ ",
  "kv19.2:5.2": "suññatā saṅkhārakkhandhapariyāpannāti. ",
  "kv19.2:5.3": "āmantā. ",
  "kv19.2:5.4": "nanu vuttaṃ bhagavatā ",
  "kv19.2:5.5": "suññamidaṃ bhikkhave saṅkhārā attena vā attaniyena vāti ",
  "kv19.2:5.6": "attheva suttantoti. ",
  "kv19.2:5.7": "āmantā. ",
  "kv19.2:5.8": "tena hi suññatā saṅkhārakkhandhapariyāpannāti. ",
  "kv19.2:5.9": "suññatākathā. "
}
