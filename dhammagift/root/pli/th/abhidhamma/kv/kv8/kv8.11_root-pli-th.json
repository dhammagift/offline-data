  "kv8.11:0.3": "",
  "kv8.11:0.4": "kammahetukathā ",
  "kv8.11:1.1": "kammahetu arahā arahattā parihāyatīti. ",
  "kv8.11:1.2": "āmantā. ",
  "kv8.11:1.3": "kammahetu sotāpanno sotāpattiphalā parihāyatīti. ",
  "kv8.11:1.4": "na hevaṃ vattabbe …pe… ",
  "kv8.11:1.5": "kammahetu arahā arahattā parihāyatīti. ",
  "kv8.11:1.6": "āmantā. ",
  "kv8.11:1.7": "kammahetu sakadāgāmī …pe… ",
  "kv8.11:1.8": "anāgāmī anāgāmiphalā parihāyatīti. ",
  "kv8.11:1.9": "na hevaṃ vattabbe …pe… ",
  "kv8.11:2.1": "kammahetu sotāpanno sotāpattiphalā na parihāyatīti. ",
  "kv8.11:2.2": "āmantā. ",
  "kv8.11:2.3": "kammahetu arahā arahattā na parihāyatīti. ",
  "kv8.11:2.4": "na hevaṃ vattabbe …pe… ",
  "kv8.11:2.5": "kammahetu sakadāgāmī …pe… ",
  "kv8.11:2.6": "anāgāmī anāgāmiphalā na parihāyatīti. ",
  "kv8.11:2.7": "āmantā. ",
  "kv8.11:2.8": "kammahetu arahā arahattā na parihāyatīti. ",
  "kv8.11:2.9": "hevaṃ vattabbe …pe… ",
  "kv8.11:3.1": "kammahetu arahā arahattā parihāyatīti. ",
  "kv8.11:3.2": "āmantā. ",
  "kv8.11:3.3": "pāṇātipātakammassa hetūti ",
  "kv8.11:3.4": "na hevaṃ vattabbe …pe… ",
  "kv8.11:3.5": "adinnādānakammassa hetu …pe… ",
  "kv8.11:3.6": "kāmesumicchācārakammassa hetu ",
  "kv8.11:3.7": "musāvāda kammassa hetu ",
  "kv8.11:3.8": "pisuṇāvācākammassa hetu ",
  "kv8.11:3.9": "pharusavācākammassa hetu ",
  "kv8.11:3.10": "samphappalāpakammassa hetu ",
  "kv8.11:3.11": "mātughātakakammassa hetu ",
  "kv8.11:3.12": "pitughātakakammassa hetu ",
  "kv8.11:3.13": "arahantaghātakakammassa hetu ",
  "kv8.11:3.14": "ruhiruppādakammassa hetu ",
  "kv8.11:3.15": "saṅghabhedakammassa hetūti. ",
  "kv8.11:3.16": "na hevaṃ vattabbe …pe… ",
  "kv8.11:4.1": "katamassa kammassa hetūti. ",
  "kv8.11:4.2": "handa hi arahantānaṃ abbhācikkhatīti. ",
  "kv8.11:4.3": "arahantānaṃ abbhācikkhanakammassa hetu arahā arahattā parihāyatīti. ",
  "kv8.11:4.4": "āmantā. ",
  "kv8.11:4.5": "ye keci arahantānaṃ abbhācikkhanti sabbe te arahattaṃ sacchikarontīti. ",
  "kv8.11:4.6": "na hevaṃ vattabbe …pe… ",
  "kv8.11:4.7": "kammahetukathā. ",
  "kv8.11:4.8": "aṭṭhamo vaggo. ",
  "kv8.11:4.9": "tassa uddānaṃ. ",
  "kv8.11:5.1": "cha gatiyo antarābhavo pañceva kāma guṇā kāmadhātu pañceva āyatanā kāmā rūpino dhammā rūpadhātu arūpino dhammā arūpadhātu saḷāyataniko attabhāvo rūpadhātuyā atthi rūpaṃ arūpesu rūpaṃ kammaṃ rūpajīvitindriyaṃ kammahetu parihāyatīti. "
}
