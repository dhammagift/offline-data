  "kv8.5:0.3": "",
  "kv8.5:0.4": "rūpadhātukathā ",
  "kv8.5:1.1": "rūpino dhammā rūpadhātūti. ",
  "kv8.5:1.2": "āmantā. ",
  "kv8.5:1.3": "rūpaṃ bhavo gati sattāvāso saṃsāro yoni viññāṇaṭṭhiti attabhāvapaṭilābhoti. ",
  "kv8.5:1.4": "na hevaṃ vattabbe …pe… ",
  "kv8.5:1.5": "atthi rūpūpagaṃ kammanti. ",
  "kv8.5:1.6": "na hevaṃ vattabbe …pe… ",
  "kv8.5:1.7": "atthi rūpūpagā sattāti. ",
  "kv8.5:1.8": "na hevaṃ vattabbe …pe… ",
  "kv8.5:1.9": "rūpe sattā jāyanti jiyyanti miyyanti cavanti upapajjantīti. ",
  "kv8.5:1.10": "na hevaṃ vattabbe …pe… ",
  "kv8.5:1.11": "rūpe atthi rūpaṃ vedanā saññā saṅkhārā viññāṇanti. ",
  "kv8.5:1.12": "na hevaṃ vattabbe …pe… ",
  "kv8.5:1.13": "rūpaṃ pañcavokārabhavoti. ",
  "kv8.5:1.14": "na hevaṃ vattabbe …pe… ",
  "kv8.5:2.1": "rūpadhātu bhavo gati …pe… ",
  "kv8.5:2.2": "attabhāvapaṭilābhoti. ",
  "kv8.5:2.3": "āmantā. ",
  "kv8.5:2.4": "rūpaṃ bhavo gati …pe… ",
  "kv8.5:2.5": "attabhāvapaṭilābhoti. ",
  "kv8.5:2.6": "na hevaṃ vattabbe …pe… ",
  "kv8.5:2.7": "atthi rūpadhātūpagaṃ kammanti. ",
  "kv8.5:2.8": "āmantā. ",
  "kv8.5:2.9": "atthi rūpūpagaṃ kammanti. ",
  "kv8.5:2.10": "na hevaṃ vattabbe …pe… ",
  "kv8.5:2.11": "atthi rūpadhātūpagā sattāti. ",
  "kv8.5:2.12": "āmantā. ",
  "kv8.5:2.13": "atthi rūpūpagā sattāti. ",
  "kv8.5:2.14": "na hevaṃ vattabbe …pe… ",
  "kv8.5:3.1": "rūpadhātuyā sattā jāyanti jiyyanti miyyanti cavanti upapajjantīti. ",
  "kv8.5:3.2": "āmantā. ",
  "kv8.5:3.3": "rūpe sattā jāyanti jiyyanti miyyanti cavanti upapajjantīti. ",
  "kv8.5:3.4": "na hevaṃ vattabbe …pe… ",
  "kv8.5:3.5": "rūpadhātuyā atthi rūpaṃ vedanā saññā saṅkhārā viññāṇanti. ",
  "kv8.5:3.6": "āmantā. ",
  "kv8.5:3.7": "rūpe atthi rūpaṃ vedanā saññā saṅkhārā viññāṇanti. ",
  "kv8.5:3.8": "na hevaṃ vattabbe …pe… ",
  "kv8.5:3.9": "rūpadhātu pañcavokārabhavoti. ",
  "kv8.5:3.10": "āmantā. ",
  "kv8.5:3.11": "rūpaṃ pañcavokārabhavoti. ",
  "kv8.5:3.12": "na hevaṃ vattabbe …pe… ",
  "kv8.5:4.1": "rūpino dhammā rūpadhātu kāmadhātuyā atthi rūpanti. ",
  "kv8.5:4.2": "āmantā. ",
  "kv8.5:4.3": "sāva kāmadhātu sā rūpadhātūti. ",
  "kv8.5:4.4": "na hevaṃ vattabbe …pe… ",
  "kv8.5:4.5": "sāva kāmadhātu sā rūpadhātūti. ",
  "kv8.5:4.6": "āmantā. ",
  "kv8.5:4.7": "kāmabhavena samannāgato puggalo davīhi bhavehi samannāgato hoti ",
  "kv8.5:4.8": "kāmabhavena ca rūpabhavena cāti. ",
  "kv8.5:4.9": "na hevaṃ vattabbe …pe… ",
  "kv8.5:4.10": "rūpadhātukathā. "
}
