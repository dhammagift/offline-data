  "kv15.2:0.1": "",
  "kv15.2:0.2": "",
  "kv15.2:0.3": "",
  "kv15.2:0.4": "aññamaññapaccayakathā ",
  "kv15.2:1.1": "avijjāpaccayāva saṅkhārā na vattabbaṃ ",
  "kv15.2:1.2": "saṅkhārapaccayāpi avijjāti. ",
  "kv15.2:1.3": "āmantā. ",
  "kv15.2:1.4": "nanu avijjā saṅkhārena sahajātāti. ",
  "kv15.2:1.5": "āmantā. ",
  "kv15.2:1.6": "hañci avijjā saṅkhārena sahajātā tena vata re vattabbe ",
  "kv15.2:1.7": "avijjāpaccayāpi saṅkhārā saṅkhārapaccayāpi avijjāti. ",
  "kv15.2:2.1": "taṇhāpaccayāva upādānaṃ na vattabbaṃ ",
  "kv15.2:2.2": "upādānapaccayāpi taṇhāti. ",
  "kv15.2:2.3": "āmantā. ",
  "kv15.2:2.4": "nanu taṇhā upādānena sahajātāti. ",
  "kv15.2:2.5": "āmantā. ",
  "kv15.2:2.6": "hañci taṇhā upādānena sahajātā tena vata re vattabbe ",
  "kv15.2:2.7": "taṇhāpaccayāpi upādānaṃ upādānapaccayāpi taṇhāti. ",
  "kv15.2:3.1": "jarāmaraṇapaccayā bhikkhave jāti jātipaccayā bhavoti ",
  "kv15.2:3.2": "attheva suttantoti. ",
  "kv15.2:3.3": "natthi. ",
  "kv15.2:3.4": "tena hi avijjāpaccayāva saṅkhārā na vattabbaṃ ",
  "kv15.2:3.5": "saṅkhārapaccayāpi avijjā ",
  "kv15.2:3.6": "taṇhāpaccayāva upādānaṃ na vattabbaṃ ",
  "kv15.2:3.7": "upādānapaccayāpi taṇhāti. ",
  "kv15.2:4.1": "viññāṇapaccayā bhikkhave nāmarūpaṃ nāmarūpapaccayāpi viññāṇanti ",
  "kv15.2:4.2": "attheva suttantoti. ",
  "kv15.2:4.3": "āmantā. ",
  "kv15.2:4.4": "tena hi avijjāpaccayāpi saṅkhārā saṅkhārapaccayāpi avijjā ",
  "kv15.2:4.5": "taṇhāpaccayāpi upādānaṃ upādānapaccayāpi taṇhāti. ",
  "kv15.2:4.6": "aññamaññapaccayakathā. "
}
