  "kv15.5:0.3": "",
  "kv15.5:0.4": "āsavakathā ",
  "kv15.5:1.1": "cattāro āsavā anāsavāti. ",
  "kv15.5:1.2": "āmantā. ",
  "kv15.5:1.3": "maggo phalaṃ nibbānaṃ sotāpattimaggo sotāpattiphalaṃ …pe… bojjhaṅgoti. ",
  "kv15.5:1.4": "na hevaṃ vattabbe …pe… ",
  "kv15.5:2.1": "na vattabbaṃ ",
  "kv15.5:2.2": "cattāro āsavā anāsavāti. ",
  "kv15.5:2.3": "āmantā. ",
  "kv15.5:2.4": "atthaññeva anāsavā yehi āsavehi te āsavā sāsavā hontīti. ",
  "kv15.5:2.5": "na hevaṃ vattabbe. ",
  "kv15.5:2.6": "tena hi cattāro āsavā anāsavāti. ",
  "kv15.5:2.7": "āsavakathā. "
}
