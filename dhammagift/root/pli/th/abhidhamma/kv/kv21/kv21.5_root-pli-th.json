  "kv21.5:0.4": "buddhakathā ",
  "kv21.5:1.1": "atthi buddhānaṃ buddhehi hīnātirekatāti. ",
  "kv21.5:1.2": "āmantā. ",
  "kv21.5:1.3": "satipaṭṭhānatoti. ",
  "kv21.5:1.4": "na hevaṃ vattabbe …pe… ",
  "kv21.5:1.5": "sammappadhānato …pe… ",
  "kv21.5:1.6": "iddhipādato ",
  "kv21.5:1.7": "indriyato ",
  "kv21.5:1.8": "balato ",
  "kv21.5:1.9": "bojjhaṅgato ",
  "kv21.5:1.10": "vasībhāvato …pe… ",
  "kv21.5:1.11": "sabbaññutañāṇadassanatoti. ",
  "kv21.5:1.12": "na hevaṃ vattabbe …pe… ",
  "kv21.5:1.13": "buddhakathā. "
}
