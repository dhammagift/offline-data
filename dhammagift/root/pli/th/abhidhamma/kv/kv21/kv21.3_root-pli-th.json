  "kv21.3:0.1": "",
  "kv21.3:0.2": "",
  "kv21.3:0.3": "",
  "kv21.3:0.4": "saññojanakathā ",
  "kv21.3:1.1": "atthi kiñci saññojanaṃ appahāya arahattappattīti. ",
  "kv21.3:1.2": "āmantā. ",
  "kv21.3:1.3": "atthi kiñci sakkāyadiṭṭhiṃ appahāya …pe… ",
  "kv21.3:1.4": "vicikicchaṃ appahāya …pe… ",
  "kv21.3:1.5": "sīlabbataparāmāsaṃ appahāya ",
  "kv21.3:1.6": "rāgaṃ appahāya ",
  "kv21.3:1.7": "dosaṃ appahāya ",
  "kv21.3:1.8": "mohaṃ appahāya …pe… ",
  "kv21.3:1.9": "anottappaṃ appahāya arahattappattīti. ",
  "kv21.3:1.10": "na hevaṃ vattabbe …pe… ",
  "kv21.3:2.1": "atthi kiñci saññojanaṃ appahāya arahattappatīti. ",
  "kv21.3:2.2": "āmantā. ",
  "kv21.3:2.3": "arahā sarāgo sadoso samoho samāno samakkho sapaḷāso saupāyāso sakilesoti. ",
  "kv21.3:2.4": "na hevaṃ vattabbe …pe… ",
  "kv21.3:2.5": "nanu arahā nīrāgo niddoso nimmoho nimmāno nimmakkho nippaḷāso nirupāyāso nikkilesoti. ",
  "kv21.3:2.6": "āmantā. ",
  "kv21.3:2.7": "hañci arahā nīrāgo …pe… ",
  "kv21.3:2.8": "nikkileso no vata re vattabbe ",
  "kv21.3:2.9": "atthi kiñci saññojanaṃ appahāya arahattappattīti. ",
  "kv21.3:3.1": "na vattabbaṃ atthi ",
  "kv21.3:3.2": "kiñci saññojanaṃ appahāya arahat tappattīti. ",
  "kv21.3:3.3": "āmantā. ",
  "kv21.3:3.4": "arahā sabbaṃ buddhavisayaṃ jānātīti. ",
  "kv21.3:3.5": "na hevaṃ vattabbe …pe… ",
  "kv21.3:3.6": "tena hi atthi kiñci saññojanaṃ appahāya arahattappattīti. ",
  "kv21.3:3.7": "saññojanakathā. "
}
