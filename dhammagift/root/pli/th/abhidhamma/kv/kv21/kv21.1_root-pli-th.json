  "kv21.1:0.4": "sāsanakathā ",
  "kv21.1:1.1": "sāsanaṃ navaṃ katanti. ",
  "kv21.1:1.2": "āmantā. ",
  "kv21.1:1.3": "satipaṭṭhānā navaṃ katāti. ",
  "kv21.1:1.4": "na hevaṃ vattabbe …pe… ",
  "kv21.1:1.5": "sāsanaṃ navaṃ katanti. ",
  "kv21.1:1.6": "āmantā. ",
  "kv21.1:1.7": "sammappadhānā …pe… ",
