  "kv22.5:0.4": "tissopikathā ",
  "kv22.5:1.1": "atthi gabbhaseyyāya arahattappattīti. ",
  "kv22.5:1.2": "āmantā. ",
  "kv22.5:1.3": "suttassa pamattassa muṭṭhassatissa asampajānassa arahattappattīti. ",
