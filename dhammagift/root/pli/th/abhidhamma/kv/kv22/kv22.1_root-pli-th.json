  "kv22.1:0.3": "",
  "kv22.1:0.4": "parinibbānakathā ",
  "kv22.1:1.1": "atthi kiñci saññojanaṃ appahāya parinibbānanti. ",
  "kv22.1:1.2": "āmantā. ",
  "kv22.1:1.3": "atthi kiñci sakkāyadiṭṭhiṃ appahāya …pe… anottappaṃ appahāya parinibbānanti. ",
  "kv22.1:1.4": "na hevaṃ vattabbe …pe… ",
  "kv22.1:2.1": "atthi kiñci saññojanaṃ appahāya parinibbānanti. ",
  "kv22.1:2.2": "āmantā. ",
  "kv22.1:2.3": "arahā sarāgo …pe… sakilesoti. ",
  "kv22.1:2.4": "na hevaṃ vattabbe …pe… ",
  "kv22.1:2.5": "nanu arahā nīrāgo …pe… nikkilesoti. ",
  "kv22.1:2.6": "āmantā. ",
  "kv22.1:2.7": "hañci arahā nīrāgo …pe… nikkileso no vata re vattabbe ",
  "kv22.1:2.8": "atthi kiñci saññojanaṃ appahāya parinibbānanti. ",
  "kv22.1:3.1": "na vattabbaṃ ",
  "kv22.1:3.2": "atthi kiñci saññojanaṃ appahāya parinibbānanti. ",
  "kv22.1:3.3": "āmantā. ",
  "kv22.1:3.4": "arahā sabbaṃ buddhavisayaṃ jānātīti. ",
  "kv22.1:3.5": "na hevaṃ vattabbe …pe… ",
  "kv22.1:3.6": "tena hi atthi kiñci saññojanaṃ appahāya parinibbānanti. ",
  "kv22.1:3.7": "parinibbānakathā. "
}
