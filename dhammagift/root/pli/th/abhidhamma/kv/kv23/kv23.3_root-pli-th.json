  "kv23.3:5.7": "nattheva suttanto no vata re vattabbe ",
  "kv23.3:5.8": "bodhisatto issariyakāmakārikāhetu gabbhaseyyaṃ okkamatīti. ",
  "kv23.3:6.1": "bodhisatto issariyakāmakārikāhetu dukkarakārikaṃ akāsīti. ",
  "kv23.3:6.2": "āmantā. ",
  "kv23.3:6.3": "bodhisatto issariyakāmakārikāhetu sassato lokoti paccāgacchi ",
  "kv23.3:6.4": "asassato lokoti paccāgacchi ",
  "kv23.3:6.5": "antavā lokoti …pe… ",
  "kv23.3:6.6": "anantavā lokoti ",
  "kv23.3:6.7": "taṃ jīvaṃ taṃ sarīranti ",
  "kv23.3:6.8": "aññaṃ jīvaṃ aññaṃ sarīranti ",
  "kv23.3:6.9": "hoti tathāgato parammaraṇāti ",
  "kv23.3:6.10": "na hoti tathāgato parammaraṇāti ",
  "kv23.3:6.11": "hoti ca na ca hoti tathāgato parammaraṇāti …pe… ",
  "kv23.3:6.12": "neva hoti na na hoti tathāgato parammaraṇāti paccāgacchīti. ",
  "kv23.3:6.13": "na hevaṃ vattabbe …pe… ",
  "kv23.3:7.1": "bodhisatto issariyakāmakārikāhetu dukkarakārikaṃ akāsīti. ",
  "kv23.3:7.2": "āmantā. ",
  "kv23.3:7.3": "bodhisatto issariyakāmakārikāhetu dukkarakārikaṃ akāsīti ",
  "kv23.3:7.4": "attheva suttantoti. ",
  "kv23.3:7.5": "natthi. ",
  "kv23.3:7.6": "hañci bodhisatto issariya kāmakārikāhetu dukkarakārikaṃ akāsīti ",
  "kv23.3:7.7": "nattheva suttanto no vata re vattabbe ",
  "kv23.3:7.8": "bodhisatto issariyakāmakārikāhetu dukkarakārikaṃ akāsīti. ",
  "kv23.3:8.1": "bodhisatto issariyakāmakārikāhetu aparantapaṃ akāsi aññaṃ satthāraṃ uddisīti. ",
  "kv23.3:8.2": "āmantā. ",
  "kv23.3:8.3": "bodhisatto issariyakāmakārikāhetu sassato lokoti paccāgacchi …pe… ",
