  "kv23.4:0.3": "",
  "kv23.4:0.4": "rāgapaṭirūpakādikathā ",
  "kv23.4:1.1": "atthi na rāgo rāgapaṭirūpakoti. ",
  "kv23.4:1.2": "āmantā. ",
  "kv23.4:1.3": "atthi na phasso phassapaṭirūpako ",
  "kv23.4:1.4": "atthi na vedanā vedanāpaṭirūpikā ",
  "kv23.4:1.5": "atthi na saññā saññāpaṭirūpikā ",
  "kv23.4:1.6": "atthi na cetanā cetanāpaṭirūpikā ",
  "kv23.4:1.7": "atthi na cittaṃ cittapaṭirūpakaṃ ",
  "kv23.4:1.8": "atthi na saddhā saddhāpaṭirūpikā ",
  "kv23.4:1.9": "atthi na viriyaṃ viriyapaṭirūpakaṃ ",
  "kv23.4:1.10": "atthi na sati satipaṭirūpikā ",
  "kv23.4:1.11": "atthi na samādhi samādhi paṭirūpako ",
  "kv23.4:1.12": "atthi na paññā paññāpaṭirūpikāti. ",
  "kv23.4:1.13": "na hevaṃ vattabbe …pe… ",
  "kv23.4:2.1": "atthi na doso dosapaṭirūpako ",
  "kv23.4:2.2": "atthi na moho mohapaṭirūpako ",
  "kv23.4:2.3": "atthi na kileso kilesapaṭirūpakoti. ",
  "kv23.4:2.4": "āmantā. ",
  "kv23.4:2.5": "atthi na phasso phassapaṭirūpako …pe… ",
  "kv23.4:2.6": "atthi na paññā paññāpaṭirūpikāti. ",
  "kv23.4:2.7": "na hevaṃ vattabbe …pe… ",
  "kv23.4:2.8": "rāgapaṭirūpakādikathā. "
}
