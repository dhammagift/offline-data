  "kv13.10:0.4": "dhammataṇhā na dukkhasamudayotikathā ",
  "kv13.10:1.1": "dhammataṇhā na dukkhasamudayoti. ",
  "kv13.10:1.2": "āmantā. ",
  "kv13.10:1.3": "rūpataṇhā na dukkhasamudayoti. ",
  "kv13.10:1.4": "na hevaṃ vattabbe …pe… ",
  "kv13.10:1.5": "dhammataṇhā na dukkhasamudayoti. ",
  "kv13.10:1.6": "āmantā. ",
  "kv13.10:1.7": "saddataṇhā …pe… ",
  "kv13.10:1.8": "gandhataṇhā ",
  "kv13.10:1.9": "rasataṇhā …pe… ",
  "kv13.10:1.10": "phoṭṭhabbataṇhā na dukkhasamudayoti. ",
  "kv13.10:1.11": "na hevaṃ vattabbe …pe… ",
  "kv13.10:2.1": "rūpataṇhā dukkhasamudayoti. ",
  "kv13.10:2.2": "āmantā. ",
  "kv13.10:2.3": "dhammataṇhā dukkhasamudayoti. ",
  "kv13.10:2.4": "na hevaṃ vattabbe …pe… ",
  "kv13.10:2.5": "saddataṇhā …pe… ",
  "kv13.10:2.6": "gandhataṇhā …pe… ",
  "kv13.10:2.7": "rasataṇhā …pe… ",
  "kv13.10:2.8": "phoṭṭhabbataṇhā dukkhasamudayoti. ",
  "kv13.10:2.9": "āmantā. ",
  "kv13.10:2.10": "dhammataṇhā dukkhasamudayoti. ",
  "kv13.10:2.11": "na hevaṃ vattabbe …pe… ",
  "kv13.10:3.1": "dhammataṇhā na dukkhasamudayoti. ",
  "kv13.10:3.2": "āmantā. ",
  "kv13.10:3.3": "nanu taṇhā dukkhasamudayo vutto bhagavatāti. ",
  "kv13.10:3.4": "āmantā. ",
  "kv13.10:3.5": "hañhi taṇhā dukkhasamudayo vutto bhagavatā no vata re vattabbe ",
  "kv13.10:3.6": "dhammataṇhā na dukkhasamudayoti. ",
  "kv13.10:3.7": "dhammataṇhā na dukkhasamudayoti. ",
  "kv13.10:3.8": "āmantā. ",
  "kv13.10:3.9": "nanu lobho dukkhasamudayo vutto bhagavatā dhammataṇhā lobhoti. ",
  "kv13.10:3.10": "āmantā. ",
  "kv13.10:3.11": "hañci lobho dukkhasamudayo vutto bhagavatā dhammataṇhā lobho no vata re vattabbe ",
  "kv13.10:3.12": "dhammataṇhā na dukkhasamudayoti. ",
  "kv13.10:4.1": "dhammataṇhā lobho na dukkhasamudayoti. ",
  "kv13.10:4.2": "āmantā. ",
  "kv13.10:4.3": "rūpataṇhā lobho na dukkhasamudayoti. ",
  "kv13.10:4.4": "na hevaṃ vattabbe …pe… ",
  "kv13.10:4.5": "dhammataṇhā lobho na dukkhasamudayoti. ",
  "kv13.10:4.6": "āmantā. ",
  "kv13.10:4.7": "saddataṇhā …pe… ",
  "kv13.10:4.8": "gandhataṇhā …pe… ",
  "kv13.10:4.9": "rasataṇhā …pe… ",
  "kv13.10:4.10": "phoṭṭhabbataṇhā lobho na dukkhasamudayoti. ",
  "kv13.10:4.11": "na hevaṃ vattabbe …pe… ",
  "kv13.10:5.1": "rūpataṇhā lobho dukkhasamudayoti. ",
  "kv13.10:5.2": "āmantā. ",
  "kv13.10:5.3": "dhammataṇhā lobho dukkhasamudayoti. ",
  "kv13.10:5.4": "na hevaṃ vattabbe …pe… ",
  "kv13.10:5.5": "saddataṇhā …pe… ",
  "kv13.10:5.6": "phoṭṭhabbataṇhā lobho dukkhasamudayoti. ",
  "kv13.10:5.7": "āmantā. ",
  "kv13.10:5.8": "dhammataṇhā lobho dukkhasamudayoti. ",
  "kv13.10:5.9": "na hevaṃ vattabbe …pe… ",
  "kv13.10:6.1": "dhammataṇhā na dukkhasamudayoti. ",
  "kv13.10:6.2": "āmantā. ",
  "kv13.10:6.3": "nanu vuttaṃ bhagavatā ",
  "kv13.10:6.4": "yāyaṃ taṇhā ponobbhavikā nandirāgasahagatā tatratatrābhinandinī seyyathīdaṃ ",
  "kv13.10:6.5": "kāmataṇhā bhavataṇhā vibhavataṇhāti ",
  "kv13.10:6.6": "attheva suttantoti. ",
  "kv13.10:6.7": "āmantā. ",
  "kv13.10:6.8": "tena hi na vattabbaṃ ",
  "kv13.10:6.9": "dhammataṇhā na dukkhasamudayoti. ",
  "kv13.10:7.1": "na vattabbaṃ ",
  "kv13.10:7.2": "dhammataṇhā na dukkhasamudayoti. ",
  "kv13.10:7.3": "āmantā. ",
  "kv13.10:7.4": "nanu sā dhammataṇhāti. ",
  "kv13.10:7.5": "āmantā. ",
  "kv13.10:7.6": "hañci sā dhammataṇhā no vata re vattabbe ",
  "kv13.10:7.7": "dhammataṇhā na dukkhasamudayoti. ",
  "kv13.10:7.8": "dhammataṇhā na dukkhasamudayotikathā. ",
  "kv13.10:7.9": "terasamo vaggo. ",
  "kv13.10:7.10": "tassa uddānaṃ ",
  "kv13.10:8.1": "kappaṭṭho kappaṃ tiṭṭheyya kappaṭṭho kusalaṃ cittaṃ na paṭilabheyya anantarāpayutto puggalo sammattaniyāmaṃ okkameyya niyato niyāmaṃ okkamati nīvuto nīvaraṇaṃ jahati sammukhībhūto saññojanaṃ jahati jhānanikanti asātarāgo dhammataṇhā abyākatā dhammataṇhā na dukkhasamudayoti. "
}
