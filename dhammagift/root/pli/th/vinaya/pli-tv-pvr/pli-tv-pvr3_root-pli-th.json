  "pli-tv-pvr3:46.4": "dantapoṇenacelakā ",
  "pli-tv-pvr3:47.1": "uyyuttaṃ vase uyyodhi ",
  "pli-tv-pvr3:47.2": "surā orena nhāyanā ",
