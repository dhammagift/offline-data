  "pli-tv-pvr3:45.1": "kaṭhinasamuṭṭhānaṃ niṭṭhitaṃ. ",
  "pli-tv-pvr3:46.0": "",
  "pli-tv-pvr3:46.1": "eḷakalomā dve seyyā ",
  "pli-tv-pvr3:46.2": "āhaccapiṇḍabhojanaṃ gaṇavikāle ",
