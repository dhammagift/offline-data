  "pli-tv-bu-vb-sk3:1.0": "802. ",
  "pli-tv-bu-vb-sk3:1.1": "sāvatthīnidānaṃ. ",
  "pli-tv-bu-vb-sk3:1.2": "tena kho pana samayena chabbaggiyā bhikkhū kāyaṃ vivaritvā antaraghare gacchanti …pe… ",
  "pli-tv-bu-vb-sk3:1.3.0": "",
  "pli-tv-bu-vb-sk3:1.3.1": "supaṭicchanno antaraghare gamissāmīti sikkhā karaṇīyā. ",
  "pli-tv-bu-vb-sk3:1.4": "supaṭicchannena antaraghare gantabbaṃ. ",
  "pli-tv-bu-vb-sk3:1.5": "yo anādariyaṃ paṭicca kāyaṃ vivaritvā antaraghare gacchati āpatti dukkaṭassa. ",
  "pli-tv-bu-vb-sk3:1.6.0": "",
  "pli-tv-bu-vb-sk3:1.6.1": "anāpatti ",
  "pli-tv-bu-vb-sk3:1.7": "asañcicca ",
  "pli-tv-bu-vb-sk3:1.8": "asatiyā ",
  "pli-tv-bu-vb-sk3:1.9": "ajānantassa ",
  "pli-tv-bu-vb-sk3:1.10": "gilānassa ",
  "pli-tv-bu-vb-sk3:1.11": "āpadāsu ",
  "pli-tv-bu-vb-sk3:1.12": "ummattakassa ",
  "pli-tv-bu-vb-sk3:1.13": "ādikammikassāti. ",
