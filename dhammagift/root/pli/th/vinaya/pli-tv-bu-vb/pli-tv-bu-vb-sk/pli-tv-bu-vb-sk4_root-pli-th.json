  "pli-tv-bu-vb-sk4:1.0": "803. ",
  "pli-tv-bu-vb-sk4:1.1": "sāvatthīnidānaṃ. ",
  "pli-tv-bu-vb-sk4:1.2": "tena kho pana samayena chabbaggiyā bhikkhū kāyaṃ vivaritvā antaraghare nisīdanti …pe… ",
  "pli-tv-bu-vb-sk4:1.3.0": "",
  "pli-tv-bu-vb-sk4:1.3.1": "supaṭicchanno antaraghare nisīdissāmīti sikkhā karaṇīyā. ",
  "pli-tv-bu-vb-sk4:1.4": "supaṭicchannena antaraghare nisīditabbaṃ. ",
  "pli-tv-bu-vb-sk4:1.5": "yo anādariyaṃ paṭicca kāyaṃ vivaritvā antaraghare nisīdati āpatti dukkaṭassa. ",
  "pli-tv-bu-vb-sk4:1.6.0": "",
  "pli-tv-bu-vb-sk4:1.6.1": "anāpatti ",
  "pli-tv-bu-vb-sk4:1.7": "asañcicca ",
  "pli-tv-bu-vb-sk4:1.8": "asatiyā ",
  "pli-tv-bu-vb-sk4:1.9": "ajānantassa ",
  "pli-tv-bu-vb-sk4:1.10": "gilānassa ",
  "pli-tv-bu-vb-sk4:1.11": "vāsupagatassa ",
