  "pli-tv-bu-vb-sk50:1.0": "850. ",
  "pli-tv-bu-vb-sk50:1.1": "sāvatthīnidānaṃ. ",
  "pli-tv-bu-vb-sk50:1.2": "tena kho pana samayena chabbaggiyā bhikkhū capucapukārakaṃ bhuñjanti …pe… ",
  "pli-tv-bu-vb-sk50:1.3.0": "",
  "pli-tv-bu-vb-sk50:1.3.1": "na capucapukārakaṃ bhuñjissāmīti sikkhā karaṇīyā. ",
  "pli-tv-bu-vb-sk50:1.4": "na capucapukārakaṃ bhuñjitabbaṃ. ",
  "pli-tv-bu-vb-sk50:1.5": "yo anādariyaṃ paṭicca capucapukārakaṃ bhuñjati āpatti dukkaṭassa. ",
  "pli-tv-bu-vb-sk50:1.6.0": "",
  "pli-tv-bu-vb-sk50:1.6.1": "anāpatti ",
  "pli-tv-bu-vb-sk50:1.7.1": "asañcicca asatiyā ajānantassa gilānassa āpadāsu ummattakassa ",
  "pli-tv-bu-vb-sk50:1.7.2": "",
  "pli-tv-bu-vb-sk50:1.7.3": "",
  "pli-tv-bu-vb-sk50:1.7.4": "",
  "pli-tv-bu-vb-sk50:1.7.5": "",
  "pli-tv-bu-vb-sk50:1.7.6": "",
  "pli-tv-bu-vb-sk50:1.8": "ādikammikassāti. ",
  "pli-tv-bu-vb-sk50:1.9": "",
  "pli-tv-bu-vb-sk50:1.10": "kabaḷavaggo pañcamo. "
}
