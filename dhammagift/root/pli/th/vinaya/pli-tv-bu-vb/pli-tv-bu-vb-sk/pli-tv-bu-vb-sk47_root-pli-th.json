  "pli-tv-bu-vb-sk47:1.0": "847. ",
  "pli-tv-bu-vb-sk47:1.1": "sāvatthīnidānaṃ. ",
  "pli-tv-bu-vb-sk47:1.2": "tena kho pana samayena chabbaggiyā bhikkhū hatthaniddhūnakaṃ bhuñjanti …pe… ",
  "pli-tv-bu-vb-sk47:1.3.0": "",
  "pli-tv-bu-vb-sk47:1.3.1": "na hatthaniddhūnakaṃ bhuñjissāmīti sikkhā karaṇīyā. ",
  "pli-tv-bu-vb-sk47:1.4": "na hatthaniddhūnakaṃ bhuñjitabbaṃ. ",
  "pli-tv-bu-vb-sk47:1.5": "yo anādariyaṃ paṭicca hatthaniddhūnakaṃ bhuñjati āpatti dukkaṭassa. ",
  "pli-tv-bu-vb-sk47:1.6.0": "",
  "pli-tv-bu-vb-sk47:1.6.1": "anāpatti ",
  "pli-tv-bu-vb-sk47:1.7": "asañcicca ",
  "pli-tv-bu-vb-sk47:1.8": "asatiyā ",
  "pli-tv-bu-vb-sk47:1.9": "ajānantassa ",
  "pli-tv-bu-vb-sk47:1.10": "gilānassa ",
  "pli-tv-bu-vb-sk47:1.11": "kacavaraṃ chaḍḍento hatthaṃ niddhūnati ",
  "pli-tv-bu-vb-sk47:1.12": "āpadāsu ",
  "pli-tv-bu-vb-sk47:1.13": "ummattakassa ",
  "pli-tv-bu-vb-sk47:1.14": "ādikammikassāti. ",
  "pli-tv-bu-vb-sk47:1.15": ""
}
