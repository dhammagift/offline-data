  "pli-tv-bu-vb-sk27:1.0": "826. ",
  "pli-tv-bu-vb-sk27:1.1": "sāvatthīnidānaṃ. ",
  "pli-tv-bu-vb-sk27:1.2": "tena kho pana samayena chabbaggiyā bhikkhū asakkaccaṃ piṇḍapātaṃ paṭiggaṇhanti chaḍḍetukāmā viya …pe… ",
  "pli-tv-bu-vb-sk27:1.3.0": "",
  "pli-tv-bu-vb-sk27:1.3.1": "sakkaccaṃ piṇḍapātaṃ paṭiggahessāmīti sikkhā karaṇīyā. ",
  "pli-tv-bu-vb-sk27:1.4": "sakkaccaṃ piṇḍapāto paṭiggahetabbo. ",
  "pli-tv-bu-vb-sk27:1.5": "yo anādariyaṃ paṭicca asakkaccaṃ piṇḍapātaṃ paṭiggaṇhāti chaḍḍetukāmo viya āpatti dukkaṭassa. ",
  "pli-tv-bu-vb-sk27:1.6.0": "",
  "pli-tv-bu-vb-sk27:1.6.1": "anāpatti ",
  "pli-tv-bu-vb-sk27:1.7.1": "asañcicca asatiyā ajānantassa gilānassa āpadāsu ummattakassa ",
  "pli-tv-bu-vb-sk27:1.7.2": "",
  "pli-tv-bu-vb-sk27:1.7.3": "",
  "pli-tv-bu-vb-sk27:1.7.4": "",
