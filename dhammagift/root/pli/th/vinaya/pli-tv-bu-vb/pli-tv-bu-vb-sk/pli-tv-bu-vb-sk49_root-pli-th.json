  "pli-tv-bu-vb-sk49:1.0": "849. ",
  "pli-tv-bu-vb-sk49:1.1": "sāvatthīnidānaṃ. ",
  "pli-tv-bu-vb-sk49:1.2": "tena kho pana samayena chabbaggiyā bhikkhū jivhānicchārakaṃ bhuñjanti …pe… ",
  "pli-tv-bu-vb-sk49:1.3.0": "",
  "pli-tv-bu-vb-sk49:1.3.1": "na jivhānicchārakaṃ bhuñjissāmīti sikkhā karaṇīyā. ",
  "pli-tv-bu-vb-sk49:1.4": "na jivhānicchārakaṃ bhuñjitabbaṃ. ",
  "pli-tv-bu-vb-sk49:1.5": "yo anādariyaṃ paṭicca jivhānicchārakaṃ bhuñjati āpatti dukkaṭassa. ",
  "pli-tv-bu-vb-sk49:1.6.0": "",
  "pli-tv-bu-vb-sk49:1.6.1": "anāpatti ",
  "pli-tv-bu-vb-sk49:1.7.1": "asañcicca asatiyā ajānantassa gilānassa āpadāsu ummattakassa ",
  "pli-tv-bu-vb-sk49:1.7.2": "",
  "pli-tv-bu-vb-sk49:1.7.3": "",
  "pli-tv-bu-vb-sk49:1.7.4": "",
  "pli-tv-bu-vb-sk49:1.7.5": "",
  "pli-tv-bu-vb-sk49:1.7.6": "",
  "pli-tv-bu-vb-sk49:1.8": "ādikammikassāti. ",
  "pli-tv-bu-vb-sk49:1.9": ""
}
