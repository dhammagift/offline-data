  "pli-tv-bu-vb-sk53:1.0": "853. ",
  "pli-tv-bu-vb-sk53:1.1": "sāvatthīnidānaṃ. ",
  "pli-tv-bu-vb-sk53:1.2": "tena kho pana samayena chabbaggiyā bhikkhū pattanillehakaṃ bhuñjanti …pe… ",
  "pli-tv-bu-vb-sk53:1.3.0": "",
  "pli-tv-bu-vb-sk53:1.3.1": "na pattanillehakaṃ bhuñjissāmīti sikkhā karaṇīyā. ",
  "pli-tv-bu-vb-sk53:1.4": "na pattanillehakaṃ bhuñjitabbaṃ. ",
  "pli-tv-bu-vb-sk53:1.5": "yo anādariyaṃ paṭicca pattanillehakaṃ bhuñjati āpatti dukkaṭassa. ",
  "pli-tv-bu-vb-sk53:1.6.0": "",
  "pli-tv-bu-vb-sk53:1.6.1": "anāpatti ",
  "pli-tv-bu-vb-sk53:1.7": "asañcicca ",
  "pli-tv-bu-vb-sk53:1.8": "asatiyā ",
  "pli-tv-bu-vb-sk53:1.9": "ajānantassa ",
  "pli-tv-bu-vb-sk53:1.10": "gilānassa ",
  "pli-tv-bu-vb-sk53:1.11": "parittake sese ekato saṅkaḍḍhitvā nillehitvā bhuñjati ",
  "pli-tv-bu-vb-sk53:1.12": "āpadāsu ",
  "pli-tv-bu-vb-sk53:1.13": "ummattakassa ",
  "pli-tv-bu-vb-sk53:1.14": "ādikammikassāti. ",
  "pli-tv-bu-vb-sk53:1.15": ""
}
