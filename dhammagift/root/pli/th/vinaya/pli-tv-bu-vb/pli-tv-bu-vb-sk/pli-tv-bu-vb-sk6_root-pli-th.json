  "pli-tv-bu-vb-sk6:1.0": "805. ",
  "pli-tv-bu-vb-sk6:1.1": "sāvatthīnidānaṃ. ",
  "pli-tv-bu-vb-sk6:1.2": "tena kho pana samayena chabbaggiyā bhikkhū hatthampi pādampi kīḷāpentā antaraghare nisīdanti …pe… ",
  "pli-tv-bu-vb-sk6:1.3.0": "",
  "pli-tv-bu-vb-sk6:1.3.1": "susaṃvuto antaraghare nisīdissāmīti sikkhā karaṇīyā. ",
  "pli-tv-bu-vb-sk6:1.4": "susaṃvutena antaraghare nisīditabbaṃ. ",
  "pli-tv-bu-vb-sk6:1.5": "yo anādariyaṃ paṭicca hatthaṃ vā pādaṃ vā kīḷāpento antaraghare nisīdati āpatti dukkaṭassa. ",
  "pli-tv-bu-vb-sk6:1.6.0": "",
  "pli-tv-bu-vb-sk6:1.6.1": "anāpatti ",
  "pli-tv-bu-vb-sk6:1.7": "asañcicca ",
  "pli-tv-bu-vb-sk6:1.8": "asatiyā ",
  "pli-tv-bu-vb-sk6:1.9": "ajānantassa ",
  "pli-tv-bu-vb-sk6:1.10": "gilānassa āpadāsu ",
  "pli-tv-bu-vb-sk6:1.11": "ummattakassa ",
  "pli-tv-bu-vb-sk6:1.12": "ādikammikassāti. ",
  "pli-tv-bu-vb-sk6:1.13": ""
}
