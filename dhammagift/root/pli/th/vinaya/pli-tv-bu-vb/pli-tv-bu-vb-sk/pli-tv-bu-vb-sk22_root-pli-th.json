  "pli-tv-bu-vb-sk22:1.0": "821. ",
  "pli-tv-bu-vb-sk22:1.1": "sāvatthīnidānaṃ. ",
  "pli-tv-bu-vb-sk22:1.2": "tena kho pana samayena chabbaggiyā bhikkhū khambhakatā antaraghare nisīdanti …pe… ",
  "pli-tv-bu-vb-sk22:1.3.0": "",
  "pli-tv-bu-vb-sk22:1.3.1": "na khambhakato antaraghare nisīdissāmīti sikkhā karaṇīyā. ",
  "pli-tv-bu-vb-sk22:1.4": "na khambhakatena antaraghare nisīditabbaṃ. ",
  "pli-tv-bu-vb-sk22:1.5": "yo anādariyaṃ paṭicca ekato vā ubhato vā khambhaṃ katvā antaraghare nisīdati āpatti dukkaṭassa. ",
  "pli-tv-bu-vb-sk22:1.6.0": "",
  "pli-tv-bu-vb-sk22:1.6.1": "anāpatti ",
  "pli-tv-bu-vb-sk22:1.7": "asañcicca ",
  "pli-tv-bu-vb-sk22:1.8": "asatiyā ",
  "pli-tv-bu-vb-sk22:1.9": "ajānantassa ",
  "pli-tv-bu-vb-sk22:1.10": "gilānassa ",
  "pli-tv-bu-vb-sk22:1.11": "vāsupagatassa ",
  "pli-tv-bu-vb-sk22:1.12": "āpadāsu ",
  "pli-tv-bu-vb-sk22:1.13": "ummattakassa ",
  "pli-tv-bu-vb-sk22:1.14": "ādikammikassāti. ",
