  "pli-tv-bu-vb-sk24:1.0": "823. ",
  "pli-tv-bu-vb-sk24:1.1": "sāvatthīnidānaṃ. ",
  "pli-tv-bu-vb-sk24:1.2": "tena kho pana samayena chabbaggiyā bhikkhū sasīsaṃ pārupitvā antaraghare nisīdanti …pe… ",
  "pli-tv-bu-vb-sk24:1.3.0": "",
  "pli-tv-bu-vb-sk24:1.3.1": "na oguṇṭhito antaraghare nisīdissāmīti sikkhā karaṇīyā. ",
  "pli-tv-bu-vb-sk24:1.4": "na oguṇṭhitena antaraghare nisīditabbaṃ. ",
  "pli-tv-bu-vb-sk24:1.5": "yo anādariyaṃ paṭicca sasīsaṃ pārupitvā antaraghare nisīdati āpatti dukkaṭassa. ",
  "pli-tv-bu-vb-sk24:1.6.0": "",
  "pli-tv-bu-vb-sk24:1.6.1": "anāpatti ",
  "pli-tv-bu-vb-sk24:1.7": "asañcicca ",
  "pli-tv-bu-vb-sk24:1.8": "asatiyā ",
  "pli-tv-bu-vb-sk24:1.9": "ajānantassa ",
  "pli-tv-bu-vb-sk24:1.10": "gilānassa ",
  "pli-tv-bu-vb-sk24:1.11": "vāsupagatassa ",
  "pli-tv-bu-vb-sk24:1.12": "āpadāsu ",
  "pli-tv-bu-vb-sk24:1.13": "ummattakassa ",
  "pli-tv-bu-vb-sk24:1.14": "ādikammikassāti. ",
