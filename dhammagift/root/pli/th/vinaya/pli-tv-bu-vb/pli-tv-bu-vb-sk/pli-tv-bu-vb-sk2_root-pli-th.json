  "pli-tv-bu-vb-sk2:1.0": "801. ",
  "pli-tv-bu-vb-sk2:1.1": "sāvatthīnidānaṃ. ",
  "pli-tv-bu-vb-sk2:1.2": "tena kho pana samayena chabbaggiyā bhikkhū puratopi pacchatopi olambentā pārupanti …pe… ",
  "pli-tv-bu-vb-sk2:1.3.0": "",
  "pli-tv-bu-vb-sk2:1.3.1": "parimaṇḍalaṃ pārupissāmīti sikkhā karaṇīyā. ",
  "pli-tv-bu-vb-sk2:1.4": "parimaṇḍalaṃ pārupitabbaṃ ubho kaṇṇe samaṃ katvā. ",
  "pli-tv-bu-vb-sk2:1.5": "yo anādariyaṃ paṭicca puratopi pacchatopi olambento pārupati āpatti dukkaṭassa. ",
  "pli-tv-bu-vb-sk2:1.6.0": "",
  "pli-tv-bu-vb-sk2:1.6.1": "anāpatti ",
  "pli-tv-bu-vb-sk2:1.7": "asañcicca ",
  "pli-tv-bu-vb-sk2:1.8": "asatiyā ",
  "pli-tv-bu-vb-sk2:1.9": "ajānantassa ",
  "pli-tv-bu-vb-sk2:1.10": "gilānassa ",
  "pli-tv-bu-vb-sk2:1.11": "āpadāsu ",
  "pli-tv-bu-vb-sk2:1.12": "ummattakassa ",
  "pli-tv-bu-vb-sk2:1.13": "ādikammikassāti. ",
