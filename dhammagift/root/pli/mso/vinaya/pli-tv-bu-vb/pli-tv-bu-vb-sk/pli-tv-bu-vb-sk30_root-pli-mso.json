  "pli-tv-bu-vb-sk30:0.4": "",
  "pli-tv-bu-vb-sk30:0.5": "Samatittikasikkhāpada ",
  "pli-tv-bu-vb-sk30:1.0": "605. ",
  "pli-tv-bu-vb-sk30:1.1": "Tena samayena buddho bhagavā sāvatthiyaṃ viharati jetavane anāthapiṇḍikassa ārāme. ",
  "pli-tv-bu-vb-sk30:1.2": "Tena kho pana samayena chabbaggiyā bhikkhū thūpīkataṃ piṇḍapātaṃ paṭiggaṇhanti…pe… . ",
  "pli-tv-bu-vb-sk30:1.3.0": "",
  "pli-tv-bu-vb-sk30:1.3.1": "“Samatittikaṃ piṇḍapātaṃ paṭiggahessāmīti sikkhā karaṇīyā” ti. ( 30 : 175 ) ",
  "pli-tv-bu-vb-sk30:1.4": "Samatittiko piṇḍapāto paṭiggahetabbo. ",
  "pli-tv-bu-vb-sk30:1.5": "Yo anādariyaṃ paṭicca thūpīkataṃ piṇḍapātaṃ paṭiggaṇhāti, āpatti dukkaṭassa. ",
  "pli-tv-bu-vb-sk30:1.6.0": "",
  "pli-tv-bu-vb-sk30:1.6.1": "Anāpatti— ",
  "pli-tv-bu-vb-sk30:1.7.1": "asañcicca, ",
  "pli-tv-bu-vb-sk30:1.7.2": "assatiyā, ",
  "pli-tv-bu-vb-sk30:1.7.3": "ajānantassa, ",
  "pli-tv-bu-vb-sk30:1.7.4": "āpadāsu, ",
  "pli-tv-bu-vb-sk30:1.8": "ummattakassa, ",
  "pli-tv-bu-vb-sk30:1.9": "ādikammikassāti. ",
  "pli-tv-bu-vb-sk30:1.10": "Dasamasikkhāpadaṃ niṭṭhitaṃ. ",
  "pli-tv-bu-vb-sk30:1.11": "Khambhakatavaggo tatiyo. "
}
