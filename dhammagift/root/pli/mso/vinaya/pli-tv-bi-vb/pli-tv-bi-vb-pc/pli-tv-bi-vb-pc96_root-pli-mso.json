{
  "pli-tv-bi-vb-pc96:0.1": "",
  "pli-tv-bi-vb-pc96:0.2": "",
  "pli-tv-bi-vb-pc96:0.3": "",
  "pli-tv-bi-vb-pc96:0.4": "",
  "pli-tv-bi-vb-pc96:0.5": "Asaṅkaccikasikkhāpada ",
  "pli-tv-bi-vb-pc96:1.0": "1224. ",
  "pli-tv-bi-vb-pc96:1.1": "Tena samayena buddho bhagavā sāvatthiyaṃ viharati jetavane anāthapiṇḍikassa ārāme. ",
  "pli-tv-bi-vb-pc96:1.2": "Tena kho pana samayena aññatarā bhikkhunī asaṅkaccikā gāmaṃ piṇḍāya pāvisi. ",
  "pli-tv-bi-vb-pc96:1.3": "Tassā rathikāya vātamaṇḍalikā saṅghāṭiyo ukkhipiṃsu. ",
  "pli-tv-bi-vb-pc96:1.4": "Manussā ukkuṭṭhiṃ akaṃsu— ",
  "pli-tv-bi-vb-pc96:1.5": "“sundarā ayyāya thanudarā”ti. ",
  "pli-tv-bi-vb-pc96:1.6": "Sā bhikkhunī tehi manussehi uppaṇḍiyamānā maṅku ahosi. ",
  "pli-tv-bi-vb-pc96:1.7": "Atha kho sā bhikkhunī upassayaṃ gantvā bhikkhunīnaṃ etamatthaṃ ārocesi. ",
  "pli-tv-bi-vb-pc96:1.8": "Yā tā bhikkhuniyo appicchā…pe… tā ujjhāyanti khiyyanti vipācenti— ",
  "pli-tv-bi-vb-pc96:1.9": "“kathañhi nāma bhikkhunī asaṅkaccikā gāmaṃ pavisissatī”ti…pe… ",
  "pli-tv-bi-vb-pc96:1.10": "“saccaṃ kira, bhikkhave, bhikkhunī asaṅkaccikā gāmaṃ pāvisī”ti? ",
  "pli-tv-bi-vb-pc96:1.11": "“Saccaṃ, bhagavā”ti. ",
  "pli-tv-bi-vb-pc96:1.12": "Vigarahi buddho bhagavā…pe… ",
  "pli-tv-bi-vb-pc96:1.13": "kathañhi nāma, bhikkhave, bhikkhunī asaṅkaccikā gāmaṃ pavisissati. ",
  "pli-tv-bi-vb-pc96:1.14": "Netaṃ, bhikkhave, appasannānaṃ vā pasādāya…pe… ",
  "pli-tv-bi-vb-pc96:1.15": "evañca pana, bhikkhave, bhikkhuniyo imaṃ sikkhāpadaṃ uddisantu— ",
  "pli-tv-bi-vb-pc96:1.16.0": "",
  "pli-tv-bi-vb-pc96:1.16.1": "“Yā pana bhikkhunī asaṅkaccikā gāmaṃ paviseyya, pācittiyan” ti. ( 196 : 151 ) ",
  "pli-tv-bi-vb-pc96:2.1.0": "",
  "pli-tv-bi-vb-pc96:2.1.1": "Yā panā ti ",
  "pli-tv-bi-vb-pc96:2.1.2": "yā yādisā…pe… ",
  "pli-tv-bi-vb-pc96:2.1.3": "bhikkhunī ti ",
  "pli-tv-bi-vb-pc96:2.1.4": "…pe… ayaṃ imasmiṃ atthe adhippetā bhikkhunīti. ",
  "pli-tv-bi-vb-pc96:2.1.5": "Asaṅkaccikā ti ",
  "pli-tv-bi-vb-pc96:2.1.6": "vinā saṅkaccikaṃ. ",
  "pli-tv-bi-vb-pc96:2.1.7": "Saṅkaccikaṃ nāma ",
  "pli-tv-bi-vb-pc96:2.1.8": "adhakkhakaṃ ubbhanābhi, tassa paṭicchādanatthāya. ",
  "pli-tv-bi-vb-pc96:2.1.9": "Gāmaṃ paviseyyā ti ",
  "pli-tv-bi-vb-pc96:2.1.10": "parikkhittassa gāmassa parikkhepaṃ atikkāmentiyā āpatti pācittiyassa. ",
  "pli-tv-bi-vb-pc96:2.1.11": "Aparikkhittassa gāmassa upacāraṃ okkamantiyā āpatti pācittiyassa. ",
  "pli-tv-bi-vb-pc96:2.2.0": "",
  "pli-tv-bi-vb-pc96:2.2.1": "Anāpatti— ",
  "pli-tv-bi-vb-pc96:2.2.2": "acchinnacīvarikāya, ",
  "pli-tv-bi-vb-pc96:2.2.3": "naṭṭhacīvarikāya, ",
  "pli-tv-bi-vb-pc96:2.2.4": "gilānāya, ",
  "pli-tv-bi-vb-pc96:2.2.5": "assatiyā, ",
  "pli-tv-bi-vb-pc96:2.2.6": "ajānantiyā, ",
  "pli-tv-bi-vb-pc96:2.2.7": "āpadāsu, ",
  "pli-tv-bi-vb-pc96:2.2.8": "ummattikāya, ",
  "pli-tv-bi-vb-pc96:2.2.9": "ādikammikāyāti. ",
  "pli-tv-bi-vb-pc96:2.2.10": "Terasamasikkhāpadaṃ niṭṭhitaṃ. ",
  "pli-tv-bi-vb-pc96:2.2.11": "Chattupāhanavaggo navamo. ",
  "pli-tv-bi-vb-pc96:2.2.12.0": "Dhammikavagga ",
  "pli-tv-bi-vb-pc96:2.2.13.0": "Nandasikkhāpada ",
  "pli-tv-bi-vb-pc96:2.2.14": "Uddiṭṭhā kho, ayyāyo, chasaṭṭhisatā pācittiyā dhammā. ",
  "pli-tv-bi-vb-pc96:2.2.15": "Tatthāyyāyo pucchāmi— ",
  "pli-tv-bi-vb-pc96:2.2.16": "“kaccittha parisuddhā”? ",
  "pli-tv-bi-vb-pc96:2.2.17": "Dutiyampi pucchāmi— ",
  "pli-tv-bi-vb-pc96:2.2.18": "“kaccittha parisuddhā”? ",
  "pli-tv-bi-vb-pc96:2.2.19": "Tatiyampi pucchāmi— ",
  "pli-tv-bi-vb-pc96:2.2.20": "“kaccittha parisuddhā”? ",
  "pli-tv-bi-vb-pc96:2.2.21": "Parisuddhetthāyyāyo, tasmā tuṇhī, evametaṃ dhārayāmīti. ",
  "pli-tv-bi-vb-pc96:2.2.22": "Khuddakaṃ samattaṃ. ",
  "pli-tv-bi-vb-pc96:2.2.23": "Bhikkhunivibhaṅge pācittiyakaṇḍaṃ niṭṭhitaṃ. ( ) ",
  "pli-tv-bi-vb-pc96:2.2.24": ""
}
