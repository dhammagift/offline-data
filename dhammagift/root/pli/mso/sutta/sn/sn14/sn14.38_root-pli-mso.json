{
  "sn14.38:0.1": "",
  "sn14.38:0.2": "",
  "sn14.38:0.3": "Dutiyasamaṇabrāhmaṇasutta ",
  "sn14.38:1.1": "Sāvatthiyaṃ viharati. ",
  "sn14.38:1.2": "“Catasso imā, bhikkhave, dhātuyo. ",
  "sn14.38:1.3": "Katamā catasso? ",
  "sn14.38:1.4": "Pathavīdhātu, āpodhātu, tejodhātu, vāyodhātu. ",
  "sn14.38:1.5": "Ye hi keci, bhikkhave, samaṇā vā brāhmaṇā vā imāsaṃ catunnaṃ dhātūnaṃ samudayañca atthaṅgamañca assādañca ādīnavañca nissaraṇañca yathābhūtaṃ nappajānanti…pe… ",
  "sn14.38:1.6": "(vitthāretabbaṃ) ",
  "sn14.38:1.7": "pajānanti…pe… ",
  "sn14.38:1.8": "sayaṃ abhiññā sacchikatvā upasampajja viharantī”ti. ",
  "sn14.38:1.9": "Navamaṃ. "
}
