  "sn28.8:0.1": "",
  "sn28.8:0.2": "",
  "sn28.8:0.3": "Nevasaññānāsaññāyatanasutta ",
  "sn28.8:1.1": "Sāvatthinidānaṃ. ",
  "sn28.8:1.2": "Atha kho āyasmā sāriputto…pe… ",
  "sn28.8:1.3": "“idhāhaṃ, āvuso, ākiñcaññāyatanaṃ samatikkamma nevasaññānāsaññāyatanaṃ upasampajja viharāmi…pe… ",
  "sn28.8:1.4": "vuṭṭhitoti vā”ti. ",
  "sn28.8:1.5": "Aṭṭhamaṃ. "
}
