{
  "sn50.13-22:0.1": "",
  "sn50.13-22:0.2": "Appamādavagga ",
  "sn50.13-22:0.3": "",
  "sn50.13-22:1.1": "(Appamādavaggo vitthāretabbo.) ",
  "sn50.13-22:2.0": "Tassuddānaṃ ",
  "sn50.13-22:2.1": "Tathāgataṃ padaṃ kūṭaṃ, ",
  "sn50.13-22:2.2": "mūlaṃ sārena vassikaṃ; ",
  "sn50.13-22:2.3": "Rājā candimasūriyā, ",
  "sn50.13-22:2.4": "vatthena dasamaṃ padanti. "
}
