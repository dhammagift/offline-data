  "sn24.13:0.1": "",
  "sn24.13:0.2": "",
  "sn24.13:0.3": "Taṃjīvaṃtaṃsarīraṃsutta ",
  "sn24.13:1.1": "Sāvatthinidānaṃ. ",
  "sn24.13:1.2": "“Kismiṃ nu kho, bhikkhave, sati, kiṃ upādāya, kiṃ abhinivissa evaṃ diṭṭhi uppajjati— ",
  "sn24.13:1.3": "‘taṃ jīvaṃ taṃ sarīran’”ti? ",
  "sn24.13:1.4": "“Bhagavaṃmūlakā no, bhante, dhammā…pe… ",
  "sn24.13:1.5": "niyato sambodhiparāyano”ti. ",
  "sn24.13:1.6": "Terasamaṃ. "
}
