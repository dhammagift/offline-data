{
  "sn17.31:0.1": "",
  "sn17.31:0.2": "Catutthavagga ",
  "sn17.31:0.3": "Bhindisutta ",
  "sn17.31:1.1": "Sāvatthiyaṃ viharati. ",
  "sn17.31:1.2": "“Dāruṇo, bhikkhave, lābhasakkārasiloko. ",
  "sn17.31:1.3": "Lābhasakkārasilokena abhibhūto pariyādiṇṇacitto, bhikkhave, devadatto saṃghaṃ bhindi. ",
  "sn17.31:1.4": "Evaṃ dāruṇo kho, bhikkhave, lābhasakkārasiloko…pe… ",
  "sn17.31:1.5": "sikkhitabban”ti. ",
  "sn17.31:1.6": "Paṭhamaṃ. "
}
