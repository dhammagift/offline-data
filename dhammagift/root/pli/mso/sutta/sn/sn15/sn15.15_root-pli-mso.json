  "sn15.15:0.3": "Pitusutta ",
  "sn15.15:1.1": "Sāvatthiyaṃ viharati. ",
  "sn15.15:1.2": "“Anamataggoyaṃ, bhikkhave, saṃsāro…pe… ",
  "sn15.15:1.3": "na so, bhikkhave, satto sulabharūpo yo napitābhūtapubbo…pe… ",
  "sn15.15:1.4": "alaṃ vimuccitun”ti. ",
  "sn15.15:1.5": "Pañcamaṃ. "
}
