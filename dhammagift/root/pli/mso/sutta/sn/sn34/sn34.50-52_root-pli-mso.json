{
  "sn34.50:0.1": "",
  "sn34.50:0.2": "",
  "sn34.50:0.3": "Abhinīhāramūlakasakkaccasuttāditika ",
  "sn34.50:1.1": "Sāvatthinidānaṃ… ",
  "sn34.50:1.2": "“samādhismiṃ abhinīhārakusalo hoti, na samādhismiṃ sakkaccakārī… ",
  "sn34.50:1.3": "samādhismiṃ sakkaccakārī hoti, na samādhismiṃ abhinīhārakusalo… ",
  "sn34.50:1.4": "neva samādhismiṃ abhinīhārakusalo hoti, na ca samādhismiṃ sakkaccakārī… ",
  "sn34.50:1.5": "samādhismiṃ abhinīhārakusalo ca hoti, samādhismiṃ sakkaccakārī ca. ",
  "sn34.50:1.6": "Tatra, bhikkhave, yvāyaṃ jhāyī…pe… ",
  "sn34.50:1.7": "uttamo ca pavaro cā”ti. ",
  "sn34.50:1.8": "Paññāsamaṃ. ",
  "sn34.51:1.1": "“Samādhismiṃ abhinīhārakusalo hoti, na samādhismiṃ sātaccakārī…pe… . ",
  "sn34.51:1.2": "Ekapaññāsamaṃ. ",
  "sn34.52:1.1": "“Samādhismiṃ abhinīhārakusalo hoti, na samādhismiṃ sappāyakārī…pe… . ",
  "sn34.52:1.2": "Dvepaññāsamaṃ. ",
  "sn34.52:1.3": "(Abhinīhāramūlakaṃ.) "
}
