{
  "sn51.45-54:0.1": "",
  "sn51.45-54:0.2": "Appamādavagga ",
  "sn51.45-54:0.3": "",
  "sn51.45-54:1.1": "(Appamādavaggo vitthāretabbo.) ",
  "sn51.45-54:2.0": "Tassuddānaṃ ",
  "sn51.45-54:2.1": "Tathāgataṃ padaṃ kūṭaṃ, ",
  "sn51.45-54:2.2": "mūlaṃ sāro ca vassikaṃ; ",
  "sn51.45-54:2.3": "Rājā candimasūriyā, ",
  "sn51.45-54:2.4": "vatthena dasamaṃ padanti. "
}
