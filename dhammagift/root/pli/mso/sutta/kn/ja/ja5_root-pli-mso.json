  "ja5:0.4": "Taṇḍulanāḷijātaka ",
  "ja5:1.1": "“Kimagghati taṇḍulanāḷikāyaṃ, ",
  "ja5:1.2": "Assāna mūlāya vadehi rāja; ",
  "ja5:1.3": "Bārāṇasiṃ santarabāhirantaṃ, ",
  "ja5:1.4": "Ayamagghati taṇḍulanāḷikā”ti. ",
  "ja5:2.1": "Taṇḍulanāḷijātakaṃ pañcamaṃ. "
}
