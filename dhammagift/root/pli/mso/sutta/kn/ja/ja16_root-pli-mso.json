  "ja16:0.4": "Tipallatthamigajātaka ",
  "ja16:1.1": "“Migaṃ tipallatthamanekamāyaṃ, ",
  "ja16:1.2": "Aṭṭhakkhuraṃ aḍḍharattāpapāyiṃ; ",
  "ja16:1.3": "Ekena sotena chamāssasanto, ",
  "ja16:1.4": "Chahi kalāhitibhoti bhāgineyyo”ti. ",
  "ja16:2.1": "Tipallatthamigajātakaṃ chaṭṭhaṃ. "
}
