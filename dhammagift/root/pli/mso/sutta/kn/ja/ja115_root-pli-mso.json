  "ja115:0.4": "Anusāsikajātaka ",
  "ja115:1.1": "“Yāyañña manusāsati, ",
  "ja115:1.2": "sayaṃ loluppacārinī; ",
  "ja115:1.3": "Sāyaṃ vipakkhikā seti, ",
  "ja115:1.4": "hatā cakkena sāsikāti. ",
  "ja115:2.1": "Anusāsikajātakaṃ pañcamaṃ. "
}
