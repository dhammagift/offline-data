  "ja62:0.4": "Aṇḍabhūtajātaka ",
  "ja62:1.1": "“Yaṃ brāhmaṇo avādesi, ",
  "ja62:1.2": "vīṇaṃ samukhaveṭhito; ",
  "ja62:1.3": "Aṇḍabhūtā bhatā bhariyā, ",
  "ja62:1.4": "tāsu ko jātu vissase”ti. ",
  "ja62:2.1": "Aṇḍabhūtajātakaṃ dutiyaṃ. "
}
