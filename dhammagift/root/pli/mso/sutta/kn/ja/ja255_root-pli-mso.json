  "ja255:0.3": "",
  "ja255:0.4": "Sukajātaka ",
  "ja255:1.1": "“Yāva so mattamaññāsi, ",
  "ja255:1.2": "bhojanasmiṃ vihaṅgamo; ",
  "ja255:1.3": "Tāva addhānamāpādi, ",
  "ja255:1.4": "mātarañca aposayi. ",
  "ja255:2.1": "Yato ca kho bahutaraṃ, ",
  "ja255:2.2": "bhojanaṃ ajjhavāhari; ",
  "ja255:2.3": "Tato tattheva saṃsīdi, ",
  "ja255:2.4": "amattaññū hi so ahu. ",
  "ja255:3.1": "Tasmā mattaññutā sādhu, ",
  "ja255:3.2": "bhojanasmiṃ agiddhatā; ",
  "ja255:3.3": "Amattaññū hi sīdanti, ",
  "ja255:3.4": "mattaññū ca na sīdare”ti. ",
  "ja255:4.1": "Sukajātakaṃ pañcamaṃ. "
}
