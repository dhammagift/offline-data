  "ja182:0.3": "",
  "ja182:0.4": "Saṅgāmāvacarajātaka ",
  "ja182:1.1": "“Saṅgāmāvacaro sūro, ",
  "ja182:1.2": "balavā iti vissuto; ",
  "ja182:1.3": "Kiṃ nu toraṇamāsajja, ",
  "ja182:1.4": "paṭikkamasi kuñjara. ",
  "ja182:2.1": "Omadda khippaṃ palighaṃ, ",
  "ja182:2.2": "esikāni ca abbaha; ",
  "ja182:2.3": "Toraṇāni ca madditvā, ",
  "ja182:2.4": "khippaṃ pavisa kuñjarā”ti. ",
  "ja182:3.1": "Saṅgāmāvacarajātakaṃ dutiyaṃ. "
}
