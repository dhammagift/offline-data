  "ja131:0.1": "",
  "ja131:0.2": "",
  "ja131:0.3": "Asampadānavagga ",
  "ja131:0.4": "Asampadānajātaka ",
  "ja131:1.1": "“Asampadānenitarītarassa, ",
  "ja131:1.2": "Bālassa mittāni kalī bhavanti; ",
  "ja131:1.3": "Tasmā harāmi bhusaṃ aḍḍhamānaṃ, ",
  "ja131:1.4": "Mā me mitti jīyittha sassatāyan”ti. ",
  "ja131:2.1": "Asampadānajātakaṃ paṭhamaṃ. "
}
