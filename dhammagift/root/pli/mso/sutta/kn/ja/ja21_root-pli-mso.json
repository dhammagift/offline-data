  "ja21:0.1": "",
  "ja21:0.2": "",
  "ja21:0.3": "Kuruṅgavagga ",
  "ja21:0.4": "Kuruṅgamigajātaka ",
  "ja21:1.1": "“Ñātametaṃ kuruṅgassa, ",
  "ja21:1.2": "yaṃ tvaṃ sepaṇṇi siyyasi; ",
  "ja21:1.3": "Aññaṃ sepaṇṇi gacchāmi, ",
  "ja21:1.4": "na me te ruccate phalan”ti. ",
  "ja21:2.1": "Kuruṅgamigajātakaṃ paṭhamaṃ. "
}
