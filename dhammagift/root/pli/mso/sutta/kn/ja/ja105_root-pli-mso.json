  "ja105:0.4": "Dubbalakaṭṭhajātaka ",
  "ja105:1.1": "“Bahumpetaṃ vane kaṭṭhaṃ, ",
  "ja105:1.2": "vāto bhañjati dubbalaṃ; ",
  "ja105:1.3": "Tassa ce bhāyasī nāga, ",
  "ja105:1.4": "kiso nūna bhavissasī”ti. ",
  "ja105:2.1": "Dubbalakaṭṭhajātakaṃ pañcamaṃ. "
}
