  "ja57:0.4": "Vānarindajātaka ",
  "ja57:1.1": "“Yassete caturo dhammā, ",
  "ja57:1.2": "vānarinda yathā tava; ",
  "ja57:1.3": "Saccaṃ dhammo dhiti cāgo, ",
  "ja57:1.4": "diṭṭhaṃ so ativattatī”ti. ",
  "ja57:2.1": "Vānarindajātakaṃ sattamaṃ. "
}
