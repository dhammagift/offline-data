{
  "snp4.15:0.1": "",
  "snp4.15:0.2": "Attadaṇḍasutta ",
  "snp4.15:1.1": "“Attadaṇḍā bhayaṃ jātaṃ, ",
  "snp4.15:1.2": "janaṃ passatha medhagaṃ; ",
  "snp4.15:1.3": "Saṃvegaṃ kittayissāmi, ",
  "snp4.15:1.4": "yathā saṃvijitaṃ mayā. (1) ",
  "snp4.15:2.1": "Phandamānaṃ pajaṃ disvā, ",
  "snp4.15:2.2": "macche appodake yathā; ",
  "snp4.15:2.3": "Aññamaññehi byāruddhe, ",
  "snp4.15:2.4": "disvā maṃ bhayamāvisi. (2) ",
  "snp4.15:3.1": "Samantamasāro loko, ",
  "snp4.15:3.2": "disā sabbā sameritā; ",
  "snp4.15:3.3": "Icchaṃ bhavanamattano, ",
  "snp4.15:3.4": "nāddasāsiṃ anositaṃ. (3) ",
  "snp4.15:4.1": "Osāne tveva byāruddhe, ",
  "snp4.15:4.2": "Disvā me aratī ahu; ",
  "snp4.15:4.3": "Athettha sallamaddakkhiṃ, ",
  "snp4.15:4.4": "Duddasaṃ hadayanissitaṃ. (4) ",
  "snp4.15:5.1": "Yena sallena otiṇṇo, ",
  "snp4.15:5.2": "disā sabbā vidhāvati; ",
  "snp4.15:5.3": "Tameva sallamabbuyha, ",
  "snp4.15:5.4": "na dhāvati na sīdati. (5) ",
  "snp4.15:6.1": "Tattha sikkhānugīyanti, ",
  "snp4.15:6.2": "yāni loke gadhitāni; ",
  "snp4.15:6.3": "Na tesu pasuto siyā, ",
  "snp4.15:6.4": "nibbijjha sabbaso kāme; ",
  "snp4.15:6.5": "Sikkhe nibbānamattano. (6) ",
  "snp4.15:7.1": "Sacco siyā appagabbho, ",
  "snp4.15:7.2": "amāyo rittapesuṇo; ",
  "snp4.15:7.3": "Akkodhano lobhapāpaṃ, ",
  "snp4.15:7.4": "vevicchaṃ vitare muni. (7) ",
  "snp4.15:8.1": "Niddaṃ tandiṃ sahe thīnaṃ, ",
  "snp4.15:8.2": "pamādena na saṃvase; ",
  "snp4.15:8.3": "Atimāne na tiṭṭheyya, ",
  "snp4.15:8.4": "nibbānamanaso naro. (8) ",
  "snp4.15:9.1": "Mosavajje na nīyetha, ",
  "snp4.15:9.2": "rūpe snehaṃ na kubbaye; ",
  "snp4.15:9.3": "Mānañca parijāneyya, ",
  "snp4.15:9.4": "sāhasā virato care. (9) ",
  "snp4.15:10.1": "Purāṇaṃ nābhinandeyya, ",
  "snp4.15:10.2": "Nave khantiṃ na kubbaye; ",
  "snp4.15:10.3": "Hiyyamāne na soceyya, ",
  "snp4.15:10.4": "Ākāsaṃ na sito siyā. (10) ",
  "snp4.15:11.1": "Gedhaṃ brūmi mahoghoti, ",
  "snp4.15:11.2": "Ājavaṃ brūmi jappanaṃ; ",
  "snp4.15:11.3": "Ārammaṇaṃ pakappanaṃ, ",
  "snp4.15:11.4": "Kāmapaṅko duraccayo. (11) ",
  "snp4.15:12.1": "Saccā avokkamma muni, ",
  "snp4.15:12.2": "Thale tiṭṭhati brāhmaṇo; ",
  "snp4.15:12.3": "Sabbaṃ so paṭinissajja, ",
  "snp4.15:12.4": "Sa ve santoti vuccati. (12) ",
  "snp4.15:13.1": "Sa ve vidvā sa vedagū, ",
  "snp4.15:13.2": "Ñatvā dhammaṃ anissito; ",
  "snp4.15:13.3": "Sammā so loke iriyāno, ",
  "snp4.15:13.4": "Na pihetīdha kassaci. (13) ",
  "snp4.15:14.1": "Yodha kāme accatari, ",
  "snp4.15:14.2": "Saṅgaṃ loke duraccayaṃ; ",
  "snp4.15:14.3": "Na so socati nājjheti, ",
  "snp4.15:14.4": "Chinnasoto abandhano. (14) ",
  "snp4.15:15.1": "Yaṃ pubbe taṃ visosehi, ",
  "snp4.15:15.2": "Pacchā te māhu kiñcanaṃ; ",
  "snp4.15:15.3": "Majjhe ce no gahessasi, ",
  "snp4.15:15.4": "Upasanto carissasi. (15) ",
  "snp4.15:16.1": "Sabbaso nāmarūpasmiṃ, ",
  "snp4.15:16.2": "Yassa natthi mamāyitaṃ; ",
  "snp4.15:16.3": "Asatā ca na socati, ",
  "snp4.15:16.4": "Sa ve loke na jīyati. (16) ",
  "snp4.15:17.1": "Yassa natthi idaṃ meti, ",
  "snp4.15:17.2": "Paresaṃ vāpi kiñcanaṃ; ",
  "snp4.15:17.3": "Mamattaṃ so asaṃvindaṃ, ",
  "snp4.15:17.4": "Natthi meti na socati. (17) ",
  "snp4.15:18.1": "Aniṭṭhurī ananugiddho, ",
  "snp4.15:18.2": "Anejo sabbadhī samo; ",
  "snp4.15:18.3": "Tamānisaṃsaṃ pabrūmi, ",
  "snp4.15:18.4": "Pucchito avikampinaṃ. (18) ",
  "snp4.15:19.1": "Anejassa vijānato, ",
  "snp4.15:19.2": "Natthi kāci nisaṅkhati; ",
  "snp4.15:19.3": "Virato so viyārabbhā, ",
  "snp4.15:19.4": "Khemaṃ passati sabbadhi. (19) ",
  "snp4.15:20.1": "Na samesu na omesu, ",
  "snp4.15:20.2": "Na ussesu vadate muni; ",
  "snp4.15:20.3": "Santo so vītamaccharo, ",
  "snp4.15:20.4": "Nādeti na nirassatī”ti. (20) ",
  "snp4.15:20.5": "Attadaṇḍasuttaṃ pannarasamaṃ. "
}
