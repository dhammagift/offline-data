  "an5.13:0.1": "",
  "an5.13:0.2": "",
  "an5.13:0.3": "Saṃkhittasutta ",
  "an5.13:1.1": "“Pañcimāni, bhikkhave, balāni. ",
  "an5.13:1.2": "Katamāni pañca? ",
  "an5.13:1.3": "Saddhābalaṃ, vīriyabalaṃ, satibalaṃ, samādhibalaṃ, paññābalaṃ— ",
  "an5.13:1.4": "imāni kho, bhikkhave, pañca balānī”ti. ",
  "an5.13:1.5": "Tatiyaṃ. "
}
