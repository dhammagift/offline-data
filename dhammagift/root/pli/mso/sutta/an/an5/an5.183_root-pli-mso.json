  "an5.183:0.1": "",
  "an5.183:0.2": "",
  "an5.183:0.3": "Rukkhamūlikasutta ",
  "an5.183:1.1": "“Pañcime, bhikkhave, rukkhamūlikā. ",
  "an5.183:1.2": "Katame pañca? ",
  "an5.183:1.3": "Mandattā momūhattā rukkhamūliko hoti…pe… idamatthitaṃyeva nissāya rukkhamūliko hoti. ",
  "an5.183:1.4": "Ime kho, bhikkhave, pañca rukkhamūlikā”ti. ",
  "an5.183:1.5": "Tatiyaṃ. "
}
