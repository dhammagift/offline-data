{
  "an4.132:0.1": "",
  "an4.132:0.2": "",
  "an4.132:0.3": "Paṭibhānasutta ",
  "an4.132:1.1": "“Cattārome, bhikkhave, puggalā santo saṃvijjamānā lokasmiṃ. ",
  "an4.132:1.2": "Katame cattāro? ",
  "an4.132:1.3": "Yuttappaṭibhāno, no muttappaṭibhāno; ",
  "an4.132:1.4": "muttappaṭibhāno, no yuttappaṭibhāno; ",
  "an4.132:1.5": "yuttappaṭibhāno ca muttappaṭibhāno ca; ",
  "an4.132:1.6": "neva yuttappaṭibhāno na muttappaṭibhāno— ",
  "an4.132:1.7": "ime kho, bhikkhave, cattāro puggalā santo saṃvijjamānā lokasmin”ti. ",
  "an4.132:1.8": "Dutiyaṃ. "
}
