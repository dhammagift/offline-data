  "an9.67:0.1": "",
  "an9.67:0.2": "",
  "an9.67:0.3": "Orambhāgiyasutta ",
  "an9.67:1.1": "“Pañcimāni, bhikkhave, orambhāgiyāni saṃyojanāni. ",
  "an9.67:1.2": "Katamāni pañca? ",
  "an9.67:1.3": "Sakkāyadiṭṭhi, vicikicchā, sīlabbataparāmāso, kāmacchando, byāpādo— ",
  "an9.67:1.4": "imāni kho, bhikkhave, pañcorambhāgiyāni saṃyojanāni. ",
  "an9.67:2.1": "Imesaṃ kho, bhikkhave, pañcannaṃ orambhāgiyānaṃ saṃyojanānaṃ pahānāya…pe… ime cattāro satipaṭṭhānā bhāvetabbā”ti. ",
  "an9.67:2.2": "Pañcamaṃ. "
}
