  "an7.82:0.1": "",
  "an7.82:0.2": "",
  "an7.82:0.3": "Catutthavinayadharasobhanasutta ",
  "an7.82:1.1": "“Sattahi, bhikkhave, dhammehi samannāgato vinayadharo sobhati. ",
  "an7.82:1.2": "Katamehi sattahi? ",
  "an7.82:1.3": "Āpattiṃ jānāti, ",
  "an7.82:1.4": "anāpattiṃ jānāti, ",
  "an7.82:1.5": "lahukaṃ āpattiṃ jānāti, ",
  "an7.82:1.6": "garukaṃ āpattiṃ jānāti, ",
  "an7.82:1.7": "anekavihitaṃ pubbenivāsaṃ anussarati, seyyathidaṃ— ekampi jātiṃ, dvepi jātiyo…pe… iti sākāraṃ sauddesaṃ anekavihitaṃ pubbenivāsaṃ anussarati, ",
  "an7.82:1.8": "dibbena cakkhunā visuddhena atikkantamānusakena…pe… ",
  "an7.82:1.9": "āsavānaṃ khayā…pe… sacchikatvā upasampajja viharati. ",
  "an7.82:1.10": "Imehi kho, bhikkhave, sattahi dhammehi samannāgato vinayadharo sobhatī”ti. ",
  "an7.82:1.11": "Aṭṭhamaṃ. "
}
