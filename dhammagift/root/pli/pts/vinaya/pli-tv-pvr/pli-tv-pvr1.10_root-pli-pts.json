  "pli-tv-pvr1.10:0.5": "",
  "pli-tv-pvr1.10:1.1": "methunaṃ dhammaṃ paṭisevanapaccayā kati āpattiyo āpajjati. ",
  "pli-tv-pvr1.10:1.2": "methunaṃ dhammaṃ paṭisevanapaccayā catasso āpattiyo āpajjati. ",
  "pli-tv-pvr1.10:1.3": "akkhayite . . . (see ",
  "pli-tv-pvr1.10:1.4": "chap.2, Pārāj.1) . . . ",
  "pli-tv-pvr1.10:1.5": "āpatti dukkaṭassa; ",
  "pli-tv-pvr1.10:1.6": "jatumaṭṭhake pācittiyaṃ. ",
  "pli-tv-pvr1.10:1.7": "methunaṃ dhammaṃ paṭisevanapaccayā imā catasso āpattiyo āpajjati. ||1|| ",
  "pli-tv-pvr1.10:2.1": "adinnaṃ ādiyanapaccayā . . . ",
  "pli-tv-pvr1.10:2.2": "tisso āpattiyo āpajjati . . . ",
  "pli-tv-pvr1.10:2.3": "(see chap.2, ",
  "pli-tv-pvr1.10:2.4": "Pārāj.2) . . . ",
  "pli-tv-pvr1.10:2.5": "dukkaṭassa. ",
  "pli-tv-pvr1.10:2.6": "adinnaṃ ādiyanapaccayā imā tisso āpattiyo āpajjati. ||2|| ",
  "pli-tv-pvr1.10:3.1": "sañcicca manussaviggahaṃ jīvitā ",
  "pli-tv-pvr1.10:3.2": "voropanapaccayā . . . tisso āpattiyo āpajjati . . . ",
  "pli-tv-pvr1.10:3.3": "",
  "pli-tv-pvr1.10:3.4": "",
  "pli-tv-pvr1.10:3.5": "pārājikassa. ",
  "pli-tv-pvr1.10:3.6": "sañcicca man. j. voropanapaccayā imā tisso āpattiyo āpajjati. ||3|| ",
  "pli-tv-pvr1.10:4.1": "asantaṃ abhūtaṃ uttarimanussadhammaṃ ",
  "pli-tv-pvr1.10:4.2": "ullapanapaccayā . . . tisso āpattiyo āpajjati . . . ",
  "pli-tv-pvr1.10:4.3": "",
  "pli-tv-pvr1.10:4.4": "",
  "pli-tv-pvr1.10:4.5": "dukkaṭassa. ",
  "pli-tv-pvr1.10:4.6": "asantaṃ . . . ullapanapaccayā imā tisso āpattiyo ",
  "pli-tv-pvr1.10:5.1": "",
  "pli-tv-pvr1.10:6.0": "",
  "pli-tv-pvr1.10:6.1": "āpajjati. ||4|| ",
  "pli-tv-pvr1.10:6.2": "upakkamitvā asuciṃ mocanapaccayā . . . tisso ",
  "pli-tv-pvr1.10:6.3": "",
  "pli-tv-pvr1.10:6.4": "",
  "pli-tv-pvr1.10:6.5": "",
  "pli-tv-pvr1.10:6.6": "",
  "pli-tv-pvr1.10:7.1": "āpattiyo āpajjati . . . ||1|| ",
  "pli-tv-pvr1.10:7.2": "kāyasaṃsaggaṃ samāpajjanapaccayā . . . pañca āpattiyo āpajjati. ",
  "pli-tv-pvr1.10:7.3": "avassutā bhikkhunī avassutassa purisapuggalassa adhakkhakaṃ ubbhajānumaṇḍalaṃ gahaṇaṃ sādiyati, āpatti pārājikassa. ",
  "pli-tv-pvr1.10:7.4": "bhikkhu kāyena kāyaṃ āmasati, āpatti saṃghādisesassa. ",
  "pli-tv-pvr1.10:7.5": "kāyena kāyapaṭibaddhaṃ āmasati, āpatti thullaccayassa. ",
  "pli-tv-pvr1.10:7.6": "kāyapaṭibaddhena kāyapaṭibaddhaṃ āmasati, āpatti dukkaṭassa. ",
  "pli-tv-pvr1.10:7.7": "aṅgulipatodake pācittiyaṃ. ",
  "pli-tv-pvr1.10:7.8": "kāyasaṃsaggaṃ samāpajjanapaccayā imā pañca āpattiyo āpajjati. ||2|| ",
  "pli-tv-pvr1.10:8.1": "mātugāmaṃ duṭṭhullāhi vācāhi obhāsanapaccayā tisso āpattiyo āpajjati . . . ",
  "pli-tv-pvr1.10:8.2": "(see ",
  "pli-tv-pvr1.10:8.3": "chap.2). ||3|| ",
  "pli-tv-pvr1.10:8.4": "",
  "pli-tv-pvr1.10:9.1": "attakāmapāricariyāya vaṇṇaṃ bhāsanapaccayā tisso āpattiyo āpajjati . . . ",
  "pli-tv-pvr1.10:9.2": "",
  "pli-tv-pvr1.10:9.3": "",
  "pli-tv-pvr1.10:9.4": "",
  "pli-tv-pvr1.10:10.1": "sañcarittaṃ samāpajjanapaccayā tisso āpattiyo āpajjati . . . ",
  "pli-tv-pvr1.10:10.2": "(etc., see chap.2. ",
  "pli-tv-pvr1.10:10.3": "Instead of ",
  "pli-tv-pvr1.10:10.4": "kārāpento, anuddhaṃsento, paṭinissajjanto read ",
  "pli-tv-pvr1.10:11.1": "kārāpanapaccayā, ",
  "pli-tv-pvr1.10:11.2": "",
  "pli-tv-pvr1.10:11.3": "",
  "pli-tv-pvr1.10:11.4": "",
  "pli-tv-pvr1.10:12.1": "",
  "pli-tv-pvr1.10:12.2": "",
  "pli-tv-pvr1.10:12.3": "",
  "pli-tv-pvr1.10:12.4": "",
  "pli-tv-pvr1.10:13.1": "anuddhaṃsanapaccayā, ",
  "pli-tv-pvr1.10:13.2": "",
  "pli-tv-pvr1.10:13.3": "",
  "pli-tv-pvr1.10:14.1": "",
  "pli-tv-pvr1.10:14.2": "",
  "pli-tv-pvr1.10:14.3": "",
  "pli-tv-pvr1.10:15.1": "paṭinissajjanapaccayā). ||4-12|| ",
  "pli-tv-pvr1.10:15.2": "",
  "pli-tv-pvr1.10:15.3": "",
  "pli-tv-pvr1.10:15.4": "",
  "pli-tv-pvr1.10:16.1": "",
  "pli-tv-pvr1.10:16.2": "",
  "pli-tv-pvr1.10:16.3": "",
  "pli-tv-pvr1.10:16.4": "",
  "pli-tv-pvr1.10:17.1": "",
  "pli-tv-pvr1.10:17.2": "",
  "pli-tv-pvr1.10:17.3": "",
  "pli-tv-pvr1.10:17.4": "",
  "pli-tv-pvr1.10:18.1": "kuladūsako bhikkhu yāvatatiyaṃ samanubhāsanāya na paṭinissajjanapaccayā tisso āpattiyo āpajjati, ",
  "pli-tv-pvr1.10:18.2": "ñattiyā dukkaṭaṃ, ",
  "pli-tv-pvr1.10:18.3": "dvīhi kammavācāhi thullaccayā, ",
  "pli-tv-pvr1.10:18.4": "kammavācāpariyosāne āpatti saṃghādisesassa. ||13||--la-- ",
  "pli-tv-pvr1.10:19.1": "anādariyaṃ paṭicca udake uccāraṃ vā passāvaṃ vā kheḷaṃ vā karaṇapaccayā kati āpattiyo āpajjati. ",
  "pli-tv-pvr1.10:19.2": "anādariyaṃ . . . karaṇapaccayā ekaṃ āpattiṃ āpajjati ",
  "pli-tv-pvr1.10:19.3": "dukkaṭaṃ. ",
  "pli-tv-pvr1.10:19.4": "anādariyaṃ . . . karaṇapaccayā imaṃ ekaṃ āpattiṃ āpajjati. ||75|| ",
  "pli-tv-pvr1.10:20.1": "katāpattivāraṃ niṭṭhitaṃ dutiyaṃ. ||10|| "
}
