  "pli-tv-pvr11:31.18": "",
  "pli-tv-pvr11:31.19": "",
  "pli-tv-pvr11:31.20": "tiṇavatthārakena ca. ||11|| ",
  "pli-tv-pvr11:32.0": "",
  "pli-tv-pvr11:32.1": "vivādādhikaraṇaṃ hoti anuvādādhikaraṇaṃ, hoti āpattādhikaraṇaṃ, hoti kiccādhikaraṇaṃ. ",
  "pli-tv-pvr11:32.2": "vivādādhikaraṇaṃ na hoti anuvādādhikaraṇaṃ, na hoti āpattādhikaraṇaṃ, na hoti kiccādhikaraṇaṃ. ",
  "pli-tv-pvr11:32.3": "api ca vivādādhikaraṇapaccayā hoti anuvādādhikaraṇaṃ hoti āpattādhikaraṇaṃ hoti kiccādhikaraṇaṃ. ",
  "pli-tv-pvr11:32.4": "yathā kathaṃ viya. ",
  "pli-tv-pvr11:32.5": "idha bhikkhū . . . (see ",
  "pli-tv-pvr11:32.6": "",
  "pli-tv-pvr11:32.7": "",
  "pli-tv-pvr11:32.8": "IV.21) . . . ",
  "pli-tv-pvr11:32.9": "",
  "pli-tv-pvr11:32.10": "",
  "pli-tv-pvr11:32.11": "",
  "pli-tv-pvr11:32.12": "kiccādhikaraṇaṃ. ",
  "pli-tv-pvr11:32.13": "evaṃ vivādādhikaraṇapaccayā hoti anuvādādhikaraṇaṃ, hoti āpattādhikaraṇaṃ, hoti kiccādhikaraṇaṃ. ",
  "pli-tv-pvr11:33.1": "anuvādādhikaraṇaṃ hoti āpattādhikaraṇaṃ, hoti kiccādhikaraṇaṃ, hoti vivādādhikaraṇaṃ. ",
  "pli-tv-pvr11:33.2": "anuvādādhikaraṇaṃ na hoti . . . ",
  "pli-tv-pvr11:33.3": "",
  "pli-tv-pvr11:33.4": "yathā kathaṃ viya. ",
  "pli-tv-pvr11:33.5": "idha bhikkhū bhikkhuṃ . . . (see ",
  "pli-tv-pvr11:33.6": "IV.21) . . . ",
  "pli-tv-pvr11:33.7": "",
  "pli-tv-pvr11:33.8": "",
  "pli-tv-pvr11:33.9": "",
  "pli-tv-pvr11:33.10": "kiccādhikaraṇaṃ. ",
  "pli-tv-pvr11:33.11": "evaṃ anuvādādhikaraṇapaccayā hoti āpattādh., hoti kiccādh., hoti vivādādhikaraṇaṃ. ",
  "pli-tv-pvr11:34.1": "āpattādhikaraṇaṃ hoti kiccādhikaraṇaṃ, hoti vivādādhikaraṇaṃ, hoti anuvādādhikaraṇaṃ. ",
  "pli-tv-pvr11:34.2": "āpattādhikaraṇaṃ na hoti . . . ",
  "pli-tv-pvr11:34.3": "",
  "pli-tv-pvr11:34.4": "yathā kathaṃ viya. ",
  "pli-tv-pvr11:34.5": "pañca pi āpattikkhandhā . . . (see ",
  "pli-tv-pvr11:34.6": "",
  "pli-tv-pvr11:34.7": "IV.21) . . . ",
  "pli-tv-pvr11:34.8": "",
  "pli-tv-pvr11:34.9": "kiccādhikaraṇaṃ. ",
  "pli-tv-pvr11:34.10": "evaṃ āpattādhikaraṇapaccayā hoti kiccādh., hoti vivādādh., hoti anuvādādhikaraṇaṃ. ",
  "pli-tv-pvr11:35.1": "kiccādhikaraṇaṃ hoti vivādādhikaraṇaṃ, hoti anuvādādhikaraṇaṃ, hoti āpattādhikaraṇaṃ. ",
  "pli-tv-pvr11:35.2": "kiccādhikaraṇaṃ na hoti . . . ",
  "pli-tv-pvr11:35.3": "",
  "pli-tv-pvr11:35.4": "yathā kathaṃ viya. ",
  "pli-tv-pvr11:35.5": "yā saṃghassa kiccayatā . . . (see ",
  "pli-tv-pvr11:35.6": "",
  "pli-tv-pvr11:35.7": "IV.21) . . . ",
  "pli-tv-pvr11:35.8": "",
  "pli-tv-pvr11:35.9": "kiccādhikaraṇaṃ. ",
  "pli-tv-pvr11:35.10": "evaṃ kiccādhikaraṇapaccayā hoti vivādādhikaraṇaṃ, hoti anuvādādhikaraṇaṃ, hoti āpattādhikaraṇaṃ. ||12|| ",
  "pli-tv-pvr11:36.0": "",
  "pli-tv-pvr11:36.1": "yattha sativinayo tattha sammukhāvinayo, ",
  "pli-tv-pvr11:36.2": "yattha sammukhāvinayo tattha sativinayo. ",
  "pli-tv-pvr11:36.3": "yattha amūḷhavinayo tattha sammukhāvinayo, ",
  "pli-tv-pvr11:36.4": "yattha sammukhāvinayo tattha amūḷhavinayo. ",
  "pli-tv-pvr11:36.5": "yattha paṭiññātakaraṇaṃ . . . ",
  "pli-tv-pvr11:36.6": "",
  "pli-tv-pvr11:36.7": "yattha yebhuyyasikā . . . ",
  "pli-tv-pvr11:36.8": "yattha tassapāpiyyasikā . . . ",
  "pli-tv-pvr11:36.9": "",
  "pli-tv-pvr11:36.10": "",
  "pli-tv-pvr11:36.11": "yattha tiṇavatthārako tattha sammukhāvinayo, ",
  "pli-tv-pvr11:36.12": "yattha sammukhāvinayo tattha tiṇavatthārako. ||13|| ",
  "pli-tv-pvr11:37.0": "",
  "pli-tv-pvr11:37.1": "yasmiṃ samaye sammukhāvinayena ca sativinayena ca adhikaraṇaṃ vūpasammati, ",
  "pli-tv-pvr11:37.2": "yattha sativinayo tattha sammukhāvinayo, yattha sammukhāvinayo tattha sativinayo, na tattha amūḷhavinayo na tattha paṭiññātakaraṇam na tattha yebhuyyasikā na tattha tassapāpiyyasikā na tattha tiṇavatthārako. ",
  "pli-tv-pvr11:37.3": "yasmiṃ samaye sammukhāvinayena ca amūḷhavinayena ca . . ., . . . ",
  "pli-tv-pvr11:37.4": "",
  "pli-tv-pvr11:37.5": "",
  "pli-tv-pvr11:37.6": "",
  "pli-tv-pvr11:37.7": "sammukhāvinayena ca tiṇavatthārakena ca adhikaraṇaṃ vūpasammati, ",
  "pli-tv-pvr11:37.8": "yattha tiṇavatthārako tattha sammukhāvinayo, yattha sammukhāvinayo tattha tiṇavatthārako, na tattha sativinayo . . . na tattha tassapāpiyyasikā. ||14|| ",
  "pli-tv-pvr11:38.0": "",
  "pli-tv-pvr11:38.1": "sammukhāvinayo 'ti vā sativinayo 'ti vā ime dhammā saṃsaṭṭhā udāhu visaṃsaṭṭhā ",
  "pli-tv-pvr11:38.2": "labbhā ca pan' imesaṃ dhammānaṃ vinibbhujitvā vinibbhujitvā nānākaraṇaṃ paññāpetuṃ. ",
  "pli-tv-pvr11:38.3": "sammukhāvinayo 'ti vā amūḷhavinayo 'ti vā . . ., . . . ",
  "pli-tv-pvr11:38.4": "sammukhavinayo 'ti vā tiṇavatthārako 'ti vā ",
  "pli-tv-pvr11:38.5": "ime ",
  "pli-tv-pvr11:38.6": "",
  "pli-tv-pvr11:38.7": "dhammā saṃsaṭṭhā . . . ",
  "pli-tv-pvr11:38.8": "paññāpetuṃ. ",
  "pli-tv-pvr11:39.1": "sammukhāvinayo 'ti vā sativinayo 'ti vā ",
  "pli-tv-pvr11:39.2": "ime dhammā saṃsaṭṭhā no visaṃsaṭṭhā ",
  "pli-tv-pvr11:39.3": "na ca labbhā imesaṃ dhammānaṃ vin. vin. nānākaraṇaṃ paññāpetuṃ. ",
  "pli-tv-pvr11:39.4": "sammukhāvinayo 'ti vā amūḷhavinayo 'ti vā . . ., . . . ",
  "pli-tv-pvr11:39.5": "sammukhāvinayo 'ti vā ",
  "pli-tv-pvr11:39.6": "",
  "pli-tv-pvr11:39.7": "",
  "pli-tv-pvr11:39.8": "tiṇavatthārako 'ti vā ",
  "pli-tv-pvr11:39.9": "ime dhammā saṃsaṭṭhā no visaṃsaṭṭhā ",
  "pli-tv-pvr11:39.10": "na ca labbhā imesaṃ dhammānaṃ vin. vin. nānākaraṇaṃ paññāpetuṃ. ||15|| ",
  "pli-tv-pvr11:40.0": "",
  "pli-tv-pvr11:40.1": "sammukhāvinayo kiṃnidāno kiṃsamudayo kiṃjātiko kiṃpabhavo kiṃsambhāro kiṃsamuṭṭhāno. ",
  "pli-tv-pvr11:40.2": "sativinayo . . ., . . . ",
  "pli-tv-pvr11:40.3": "",
  "pli-tv-pvr11:40.4": "",
  "pli-tv-pvr11:40.5": "",
  "pli-tv-pvr11:40.6": "",
  "pli-tv-pvr11:40.7": "tiṇavatthārako kiṃnidāno kiṃsamudayo kiṃjātiko kiṃpabhavo kiṃsambhāro kiṃsamuṭṭhāno. ",
  "pli-tv-pvr11:41.1": "sammukhāvinayo nidānanidāno nidānasamudayo nidānajātiko nidānapabhavo nidānasambhāro nidānasamuṭṭhāno. ",
  "pli-tv-pvr11:41.2": "sativinayo . . ., . . . ",
