{
  "pli-tv-pvr11:0.1": "",
  "pli-tv-pvr11:0.2": "",
  "pli-tv-pvr11:0.3": "",
  "pli-tv-pvr11:1.1": "Cattāri adhikaraṇāni ",
  "pli-tv-pvr11:1.2": "vivādādhikaraṇaṃ anuvādādhikaraṇaṃ āpattādhikaraṇaṃ kiccādhikaraṇaṃ. ",
  "pli-tv-pvr11:1.3": "imāni cattāri adhikaraṇāni. ",
  "pli-tv-pvr11:2.1": "imesaṃ catunnaṃ adhikaraṇānaṃ kati ukkoṭā. ",
  "pli-tv-pvr11:2.2": "imesaṃ catunnaṃ adhikaraṇānaṃ dasa ukkoṭā. ",
  "pli-tv-pvr11:2.3": "vivādādhikaraṇassa dve ukkoṭā, anuvādādhikaraṇassa cattāro ukk., āpattādhikaraṇassa tayo ukk., kiccādhikaraṇassa eko ukkoṭo. ",
  "pli-tv-pvr11:2.4": "imesaṃ catunnaṃ adhikaraṇānaṃ ime dasa ukkoṭā. ",
  "pli-tv-pvr11:3.1": "vivādādhikaraṇaṃ ukkoṭento kati samathe ukkoṭeti. ",
  "pli-tv-pvr11:3.2": "anuvādādhikaraṇaṃ . . . ",
  "pli-tv-pvr11:3.3": "āpattādhikaraṇaṃ . . . ",
  "pli-tv-pvr11:3.4": "kiccādhikaraṇaṃ ukkoṭento kati samathe ukkoṭeti. ",
  "pli-tv-pvr11:4.1": "vivādādhikaraṇaṃ ukkoṭento dve samathe ukkoṭeti, ",
  "pli-tv-pvr11:4.2": "anuvādādhikaraṇaṃ . . . cattāro . . ., ",
  "pli-tv-pvr11:4.3": "āpattādhikaraṇaṃ . . . tayo . . ., ",
  "pli-tv-pvr11:4.4": "kiccādhikaraṇaṃ ukkoṭento ekaṃ samathaṃ ukkoṭeti. ||1|| ",
  "pli-tv-pvr11:5.1": "kati ukkoṭā. ",
  "pli-tv-pvr11:5.2": "katīh' ākārehi ukkoṭanaṃ pasavati. ",
  "pli-tv-pvr11:5.3": "katīh' aṅgehi samannāgato puggalo adhikaraṇaṃ ukkoṭeti. ",
  "pli-tv-pvr11:5.4": "kati puggalā adhikaraṇaṃ ukkoṭentā āpattiṃ āpajjanti. ",
  "pli-tv-pvr11:6.1": "dvādasa ukkoṭā. ",
  "pli-tv-pvr11:6.2": "dasah' ākārehi ukkoṭanaṃ pasavati. ",
  "pli-tv-pvr11:6.3": "catūh' aṅgehi samannāgato puggalo adhikaraṇaṃ ukkoṭeti. ",
  "pli-tv-pvr11:6.4": "cattāro puggalā adhikaraṇaṃ ukkoṭentā āpattiṃ āpajjanti. ||2|| ",
  "pli-tv-pvr11:7.1": "katame dvādasa ukkoṭā. ",
  "pli-tv-pvr11:7.2": "akataṃ kammaṃ dukkaṭaṃ kammaṃ puna kātabbaṃ kammaṃ anihataṃ dunnihataṃ puna nihanitabbaṃ avinicchitaṃ duvinicchitaṃ puna vinicchitabbaṃ avūpasantaṃ duvūpasantaṃ puna vūpasametabban ti ",
  "pli-tv-pvr11:7.3": "ime dvādasa ukkoṭā. ",
  "pli-tv-pvr11:8.1": "katamehi dasah' ākārehi ukkoṭanaṃ pasavati. ",
  "pli-tv-pvr11:8.2": "tatthajātakaṃ adhikaraṇaṃ ukkoṭeti, tatthajātakaṃ vūpasantaṃ adh. ukk., antarāmagge adh. ukk., antarāmagge vūpasantaṃ adh. ukk., tatthagataṃ adh. ukk., tatthagataṃ vūpasantaṃ adh. ukk., sativinayaṃ ukk., amūḷhavinayaṃ ukk., tassapāpiyyasikaṃ ukk., tiṇavatthārakaṃ ukkoṭeti. ",
  "pli-tv-pvr11:8.3": "imehi dasah' ākārehi ukkoṭanaṃ pasavati. ",
  "pli-tv-pvr11:9.1": "katamehi catūh' aṅgehi samannāgato puggalo adhikaraṇaṃ ukkoṭeti. ",
  "pli-tv-pvr11:9.2": "chandāgatiṃ gacchanto adhikaraṇaṃ ukkoṭeti, dosāgatiṃ . . . mohāgatiṃ . . . bhayāgatiṃ gacchanto adhikaraṇaṃ ukkoṭeti. ",
  "pli-tv-pvr11:9.3": "imehi catūh' aṅgehi samannāgato puggalo adhikaraṇaṃ ukkoṭeti. ",
  "pli-tv-pvr11:10.1": "katame cattāro puggalā adhikaraṇaṃ ukkoṭentā āpattiṃ āpajjanti. ",
  "pli-tv-pvr11:10.2": "tadahupasampanno ukkoṭeti, ukkoṭanakaṃ pācittiyaṃ. āgantuko . . . kārako . . . chandadāyako ukkoṭeti, ukkoṭanakaṃ pācittiyaṃ. ",
  "pli-tv-pvr11:10.3": "ime cattāro puggalā adhikaraṇaṃ ukkoṭentā āpattiṃ āpajjanti. ||3|| ",
  "pli-tv-pvr11:11.0": "",
  "pli-tv-pvr11:11.1": "vivādādhikaraṇaṃ kiṃnidānaṃ kiṃsamudayaṃ kiṃjātikaṃ kiṃpabhavaṃ kiṃsambhāraṃ kiṃsamuṭṭhānaṃ. ",
  "pli-tv-pvr11:11.2": "anuvādādhikaraṇaṃ . . . ",
  "pli-tv-pvr11:11.3": "āpattādhikaraṇaṃ . . . ",
  "pli-tv-pvr11:11.4": "kiccādhikaraṇaṃ kiṃnidānaṃ . . . kiṃsamuṭṭhānaṃ. ",
  "pli-tv-pvr11:12.1": "vivādādhikaraṇaṃ vivādanidānaṃ vivādasamudayaṃ . . . vivādasamuṭṭhānaṃ; ",
  "pli-tv-pvr11:12.2": "anuvādādhikaraṇaṃ anuvādanidānaṃ . . .; ",
  "pli-tv-pvr11:12.3": "āpattādhikaraṇaṃ āpattinidānaṃ . . .; ",
  "pli-tv-pvr11:12.4": "kiccādhikaraṇaṃ kiccanidānaṃ . . . kiccasamuṭṭhānaṃ. ||4|| ",
  "pli-tv-pvr11:13.1": "vivādādhikaraṇaṃ kiṃnidānaṃ . . . kiṃsamuṭṭhānaṃ. ",
  "pli-tv-pvr11:13.2": "anuvādādhikaraṇaṃ, ",
  "pli-tv-pvr11:13.3": "āpattādhikaraṇaṃ, ",
  "pli-tv-pvr11:13.4": "kiccādhikaraṇaṃ kiṃnidānaṃ . . . kiṃsamuṭṭhānaṃ. ",
  "pli-tv-pvr11:14.1": "vivādādhikaraṇaṃ hetunidānaṃ . . .; ",
  "pli-tv-pvr11:14.2": "anuvādādhikaraṇaṃ, ",
  "pli-tv-pvr11:14.3": "āpattādhikaraṇaṃ, ",
  "pli-tv-pvr11:14.4": "kiccādhikaraṇaṃ hetunidānaṃ . . . hetusamuṭṭhānaṃ. ||5|| ",
  "pli-tv-pvr11:15.1": "vivādādhikaraṇaṃ kiṃnidānaṃ . . . kiṃsamuṭṭhānaṃ. ",
  "pli-tv-pvr11:15.2": "anuvādādh., āpattādh., ",
  "pli-tv-pvr11:15.3": "kiccādh. ",
  "pli-tv-pvr11:15.4": "kiṃnidānaṃ . . . kiṃsamuṭṭhānaṃ. ",
  "pli-tv-pvr11:16.1": "vivādādhikaraṇaṃ paccayanidānaṃ . . .; ",
  "pli-tv-pvr11:16.2": "anuvādādhikaraṇaṃ, ",
  "pli-tv-pvr11:16.3": "āpattādhikaraṇaṃ, ",
  "pli-tv-pvr11:16.4": "kiccādhikaraṇaṃ paccayanidānaṃ . . . paccayasamuṭṭhānaṃ. ||6|| ",
  "pli-tv-pvr11:17.0": "",
  "pli-tv-pvr11:17.1": "catunnaṃ adhikaraṇānaṃ kati mūlāni kati samuṭṭhānā. ",
  "pli-tv-pvr11:17.2": "catunnaṃ adhikaraṇānaṃ tettiṃsa mūlāni tettiṃsa samuṭṭhānā. ",
  "pli-tv-pvr11:18.1": "cat. adh. katamāni tettiṃsa mūlāni. ",
  "pli-tv-pvr11:18.2": "vivādādhikaraṇassa dvādasa mūlāni, anuvādādhikaraṇassa cuddasa mūlāni, āpattādhikaraṇassa cha mūlāni, kiccādhikaraṇassa ekaṃ mūlaṃ saṃgho. ",
  "pli-tv-pvr11:18.3": "catunnaṃ adhikaraṇānaṃ imāni tettiṃsa mūlāni. ",
  "pli-tv-pvr11:19.1": "catunnaṃ adh. katame tettiṃsa samuṭṭhānā. ",
  "pli-tv-pvr11:19.2": "vivādādhikaraṇassa aṭṭhārasa bhedakaravatthūni samuṭṭhānā. anuvādādhikaraṇassa catasso vipattiyo samuṭṭhānā. āpattādhikaraṇassa sattāpattikkhandhā samuṭṭhānā. kiccādhikaraṇassa cattāri kammāni samuṭṭhānā. ",
  "pli-tv-pvr11:19.3": "catunnaṃ adh. ime tettiṃsa samuṭṭhānā. ||7|| ",
  "pli-tv-pvr11:20.0": "",
  "pli-tv-pvr11:20.1": "vivādādhikaraṇaṃ āpattānāpattīti. ",
  "pli-tv-pvr11:20.2": "vivādādhikaraṇaṃ na āpatti, ",
  "pli-tv-pvr11:20.3": "kiṃ pana vivādādhikaraṇapaccayā āpattiṃ āpajjeyyā 'ti. ",
  "pli-tv-pvr11:20.4": "āma vivādādhikaraṇapaccayā āpattiṃ āpajjeyya. ",
  "pli-tv-pvr11:20.5": "vivādādhikaraṇapaccayā kati āpattiyo āpajjati. ",
  "pli-tv-pvr11:20.6": "vivādādhikaraṇapaccayā dve āpattiyo āpajjati: ",
  "pli-tv-pvr11:20.7": "upasampannaṃ omasati, āpatti pācittiyassa; ",
  "pli-tv-pvr11:20.8": "anupasampannaṃ omasati, āpatti dukkaṭassa. ",
  "pli-tv-pvr11:20.9": "vivādādhikaraṇapaccayā imā dve āpattiyo āpajjati. ",
  "pli-tv-pvr11:21.1": "tā āpattiyo catunnaṃ vipattīnaṃ kati vipattiyo bhajanti, ",
  "pli-tv-pvr11:21.2": "catunnaṃ adhikaraṇānaṃ katamaṃ adhikaraṇaṃ, ",
  "pli-tv-pvr11:21.3": "sattannaṃ āpattikkhandhānaṃ katīhi āpattikkhandhehi saṃgahitā, ",
  "pli-tv-pvr11:21.4": "channaṃ āpattisamuṭṭhānānaṃ katīhi samuṭṭhānehi samuṭṭhanti, ",
  "pli-tv-pvr11:21.5": "katīhi adhikaraṇehi katīsu ṭhānesu katīhi samathehi sammanti. ",
  "pli-tv-pvr11:22.1": "tā āpattiyo catunnaṃ vipattīnaṃ ekaṃ vipattiṃ bhajanti ",
  "pli-tv-pvr11:22.2": "ācāravipattiṃ, ",
  "pli-tv-pvr11:22.3": "catunnaṃ adhikaraṇānaṃ āpattādhikaraṇaṃ, ",
  "pli-tv-pvr11:22.4": "sattannaṃ āpattikkhandhānaṃ dvīhi āpattikkhandhehi saṃgahitā ",
  "pli-tv-pvr11:22.5": "siyā pācittiyāpattikkhandhena siyā dukkaṭāpattikkhandhena, ",
  "pli-tv-pvr11:22.6": "channaṃ āpattisamuṭṭhānānaṃ tīhi samuṭṭhānehi samuṭṭhanti, ",
  "pli-tv-pvr11:22.7": "ekena adhikaraṇena ",
  "pli-tv-pvr11:22.8": "kiccādhikaraṇena ",
  "pli-tv-pvr11:22.9": "tīsu ṭhānesu ",
  "pli-tv-pvr11:22.10": "saṃghamajjhe gaṇamajjhe puggalassa santike ",
  "pli-tv-pvr11:22.11": "tīhi samathehi sammanti ",
  "pli-tv-pvr11:22.12": "siyā sammukhāvinayena ca paṭiññātakaraṇena ca siyā sammukhāvinayena ca tiṇavatthārakena ca. ||8|| ",
  "pli-tv-pvr11:23.1": "anuvādādhikaraṇaṃ āpattānāpattīti . . . ",
  "pli-tv-pvr11:23.2": "(see 8) . . . ",
  "pli-tv-pvr11:23.3": "",
  "pli-tv-pvr11:23.4": "",
  "pli-tv-pvr11:23.5": "",
  "pli-tv-pvr11:23.6": "anuvādādhikaraṇapaccayā tisso āpattiyo āpajjati: ",
  "pli-tv-pvr11:23.7": "bhikkhuṃ amūlakena pārājikena dhammena anuddhaṃseti, āpatti saṃghādisesassa; ",
  "pli-tv-pvr11:23.8": "amūlakena saṃghādisesena anuddhaṃseti, āp. pācittiyassa; ",
  "pli-tv-pvr11:23.9": "amūlikāya ācāravipattiyā anuddhaṃseti, āp. dukkaṭassa. ",
  "pli-tv-pvr11:23.10": "anuvādādhikaraṇapaccayā imā tisso āpattiyo āpajjati. ",
  "pli-tv-pvr11:24.1": "tā āpattiyo catunnaṃ vipattīnaṃ kati . . . ",
  "pli-tv-pvr11:24.2": "",
  "pli-tv-pvr11:24.3": "",
  "pli-tv-pvr11:24.4": "",
  "pli-tv-pvr11:24.5": "katīhi samathehi sammanti. ",
  "pli-tv-pvr11:25.1": "tā āpattiyo catunnaṃ vipattīnaṃ dve vipattiyo bhajanti ",
  "pli-tv-pvr11:25.2": "siyā sīlavipattiṃ siyā ācāravipattiṃ, ",
  "pli-tv-pvr11:25.3": "catunnaṃ adhikaraṇānaṃ āpattādhikaraṇaṃ, ",
  "pli-tv-pvr11:25.4": "sattannaṃ āpattikkhandhānaṃ tīhi āpattikkhandhehi saṃgahitā ",
  "pli-tv-pvr11:25.5": "siyā saṃghādisesāpattikkhandhena siyā pācittiyāpattikkhandhena siyā dukkaṭāpattikkhandhena, ",
  "pli-tv-pvr11:25.6": "channaṃ āpattisamuṭṭhānānaṃ tīhi samuṭṭhānehi samuṭṭhanti. ",
  "pli-tv-pvr11:25.7": "yā sā āpatti garukā sā āpatti ekena adhikaraṇena ",
  "pli-tv-pvr11:25.8": "kiccādhikaraṇena ",
  "pli-tv-pvr11:25.9": "ekamhi ṭhāne ",
  "pli-tv-pvr11:25.10": "saṃghamajjhe ",
  "pli-tv-pvr11:25.11": "dvīhi samathehi sammati ",
  "pli-tv-pvr11:25.12": "sammukhāvinayena ca paṭiññātakaraṇena ca, ",
  "pli-tv-pvr11:25.13": "yā tā āpattiyo lahukā tā āpattiyo ekena adhikaraṇena ",
  "pli-tv-pvr11:25.14": "kiccādhikaraṇena ",
  "pli-tv-pvr11:25.15": "tīsu ṭhānesu ",
  "pli-tv-pvr11:25.16": "saṃghamajjhe . . . ( 8) . . . ",
  "pli-tv-pvr11:25.17": "",
  "pli-tv-pvr11:25.18": "tiṇavatthārakena ca. ||9|| ",
  "pli-tv-pvr11:26.1": "āpattādhikaraṇaṃ āpattānāpattīti. ",
  "pli-tv-pvr11:26.2": "āpattādhikaraṇaṃ āpatti. ",
  "pli-tv-pvr11:26.3": "kiṃ pana . . . ",
  "pli-tv-pvr11:26.4": "",
  "pli-tv-pvr11:26.5": "",
  "pli-tv-pvr11:26.6": "āpattādhikaraṇapaccayā catasso āpattiyo āpajjati: ",
  "pli-tv-pvr11:26.7": "bhikkhunī jānaṃ pārājikaṃ dhammaṃ paṭicchādeti, āpatti pārājikassa; ",
  "pli-tv-pvr11:26.8": "vematikā paṭicchādeti, āp. thullaccayassa; ",
  "pli-tv-pvr11:26.9": "bhikkhu saṃghādisesaṃ paṭicchādeti, āp. pācittiyassa; ",
  "pli-tv-pvr11:26.10": "ācāravipattiṃ paṭicchādeti, āp. dukkaṭassa. ",
  "pli-tv-pvr11:26.11": "āpattādhikaraṇapaccayā imā catasso āpattiyo āpajjati. ",
  "pli-tv-pvr11:27.1": "tā āpattiyo catunnaṃ vipattīnaṃ kati . . . ",
  "pli-tv-pvr11:27.2": "",
  "pli-tv-pvr11:27.3": "",
  "pli-tv-pvr11:27.4": "",
  "pli-tv-pvr11:27.5": "katīhi samathehi sammanti. ",
  "pli-tv-pvr11:28.1": "tā āpattiyo catunnaṃ . . . ( 9) . . . ",
  "pli-tv-pvr11:28.2": "",
  "pli-tv-pvr11:28.3": "",
  "pli-tv-pvr11:28.4": "catūhi āpattikkhandhehi saṃgahitā ",
  "pli-tv-pvr11:28.5": "siyā pārājikāpattikkhandhena siyā thullaccayāpattikkhandhena siyā pācittiyāpattikkhandhena siyā dukkaṭāpattikkhandhena, ",
  "pli-tv-pvr11:28.6": "channaṃ āpattisamuṭṭhānānaṃ ekena samuṭṭhānena samuṭṭhanti ",
  "pli-tv-pvr11:28.7": "kāyato ca vācato ca cittato ca samuṭṭhanti. ",
  "pli-tv-pvr11:28.8": "yā sā āpatti anavasesā sā āpatti na katamena adhikaraṇena na katamamhi ṭhāne na katamena samathena sammati. ",
  "pli-tv-pvr11:28.9": "yā tā āpattiyo lahukā tā āpattiyo ekena . . . ( 9) . . . ",
  "pli-tv-pvr11:28.10": "",
  "pli-tv-pvr11:28.11": "",
  "pli-tv-pvr11:28.12": "",
  "pli-tv-pvr11:28.13": "",
  "pli-tv-pvr11:28.14": "tiṇavatthārakena ca. ||10|| ",
  "pli-tv-pvr11:29.1": "kiccādhikaraṇaṃ āpattānāpattīti . . . ( 8) . . . ",
  "pli-tv-pvr11:29.2": "",
  "pli-tv-pvr11:29.3": "",
  "pli-tv-pvr11:29.4": "",
  "pli-tv-pvr11:29.5": "",
  "pli-tv-pvr11:29.6": "kiccādhikaraṇapaccayā pañca āpattiyo āpajjati: ",
  "pli-tv-pvr11:29.7": "ukkhittānuvattikā bhikkhunī yāvatatiyaṃ samanubhāsanāya na paṭinissajjati, ñattiyā dukkaṭaṃ, ",
  "pli-tv-pvr11:29.8": "dvīhi kammavācāhi thullaccayā, ",
  "pli-tv-pvr11:29.9": "kammavācāpariyosāne āp. pārājikassa; ",
  "pli-tv-pvr11:29.10": "bhedakānuvattakā yāvatatiyaṃ samanubhāsanāya na paṭinissajjanti, āpatti saṃghādisesassa; ",
  "pli-tv-pvr11:29.11": "pāpikāya diṭṭhiyā yāvatatiyaṃ samanubhāsanāya na paṭinissajjanti, āp. pācittiyassa. ",
  "pli-tv-pvr11:29.12": "kiccādhikaraṇapaccayā imā pañca āpattiyo āpajjati. ",
  "pli-tv-pvr11:30.1": "tā āpattiyo catunnaṃ vipattīnaṃ kati . . . ",
  "pli-tv-pvr11:30.2": "",
  "pli-tv-pvr11:30.3": "",
  "pli-tv-pvr11:30.4": "",
  "pli-tv-pvr11:30.5": "katīhi samathehi sammanti. ",
  "pli-tv-pvr11:31.1": "tā āpattiyo catunnaṃ . . . ( 9) . . . ",
  "pli-tv-pvr11:31.2": "",
  "pli-tv-pvr11:31.3": "",
  "pli-tv-pvr11:31.4": "pañcahi āpattikkhandhehi saṃgahitā ",
  "pli-tv-pvr11:31.5": "siyā pārājikāpattikkhandhena siyā saṃghādisesāp. siyā thullaccayāp. siyā pācittiyāp. siyā dukkaṭāpattikkhandhena, ",
  "pli-tv-pvr11:31.6": "channaṃ āpattisamuṭṭhānānaṃ ekena s. s. ",
  "pli-tv-pvr11:31.7": "kāyato ca vācato ca cittato ca samuṭṭhanti. ",
  "pli-tv-pvr11:31.8": "yā sā āpatti anavasesā . . . ( 10) . . . ",
  "pli-tv-pvr11:31.9": "yā sā āpatti garukā sā āpatti ekena adhikaraṇena ",
  "pli-tv-pvr11:31.10": "kiccādhikaraṇena ",
  "pli-tv-pvr11:31.11": "ekamhi ṭhāne ",
  "pli-tv-pvr11:31.12": "saṃghamajjhe ",
  "pli-tv-pvr11:31.13": "dvīhi samathehi sammati ",
  "pli-tv-pvr11:31.14": "sammukhāvinayena ca paṭiññātakaraṇena ca. ",
  "pli-tv-pvr11:31.15": "yā tā āpattiyo lahukā tā āpattiyo ekena . . . ( 9) . . . ",
