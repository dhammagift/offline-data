  "pli-tv-pvr11:44.13": "",
  "pli-tv-pvr11:44.14": "tiṇavatthārako paccayanidāno . . . paccayasamuṭṭhāno. ||18|| ",
  "pli-tv-pvr11:45.1": "sattannaṃ samathānaṃ kati mūlāni kati samuṭṭhānā. ",
  "pli-tv-pvr11:45.2": "sattannaṃ samathānaṃ chabbīsa mūlāni chattiṃsa samuṭṭhānā. ",
  "pli-tv-pvr11:45.3": "sattannaṃ samathānaṃ katamāni chabbīsa mūlāni. ",
  "pli-tv-pvr11:45.4": "sammukhāvinayassa cattāri mūlāni ",
  "pli-tv-pvr11:45.5": "saṃghasammukhatā dhammasammukhatā vinayasammukhatā puggalasammukhatā. ",
  "pli-tv-pvr11:45.6": "sativinayassa cattāri mūlāni. ",
  "pli-tv-pvr11:45.7": "amūḷhavinayassa cattāri mūlāni. ",
  "pli-tv-pvr11:45.8": "paṭiññātakaraṇassa dve mūlāni ",
  "pli-tv-pvr11:45.9": "yo ca deseti yassa ca deseti. ",
  "pli-tv-pvr11:45.10": "yebhuyyasikāya cattāri mūlāni. ",
  "pli-tv-pvr11:45.11": "tassapāpiyyasikāya cattāri mūlāni. ",
  "pli-tv-pvr11:45.12": "tiṇavatthārakassa cattāri mūlāni ",
  "pli-tv-pvr11:45.13": "saṃghasammukhatā . . . puggalasammukhatā. ",
  "pli-tv-pvr11:45.14": "sattannaṃ samathānaṃ imāni chabbīsa mūlāni. ",
  "pli-tv-pvr11:46.1": "sattannaṃ samathānaṃ katame chattiṃsa samuṭṭhānā. ",
  "pli-tv-pvr11:46.2": "sativinayassa kammassa kiriyā karaṇaṃ upagamanaṃ ajjhupagamanaṃ adhivāsanā appaṭikkosanā. ",
  "pli-tv-pvr11:46.3": "amūḷhavinayassa kammassa, ",
  "pli-tv-pvr11:46.4": "paṭiññātakaraṇassa kammassa, ",
  "pli-tv-pvr11:46.5": "yebhuyyasikāya kammassa, ",
  "pli-tv-pvr11:46.6": "tassapāpiyyasikāya kammassa, ",
  "pli-tv-pvr11:46.7": "tiṇavatthārakassa kammassa kiriyā karaṇaṃ . . . appaṭikkosanā. ",
  "pli-tv-pvr11:46.8": "sattannaṃ samathānaṃ ime chattiṃsa samuṭṭhānā. ||19|| ",
  "pli-tv-pvr11:47.0": "",
  "pli-tv-pvr11:47.1": "sammukhāvinayo 'ti vā sativinayo 'ti vā ime dhammā nānatthā nānābyañjanā udāhu ekatthā byañjanam eva nānaṃ. ",
