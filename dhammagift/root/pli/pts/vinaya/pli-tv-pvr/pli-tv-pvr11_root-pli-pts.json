  "pli-tv-pvr11:41.5": "",
  "pli-tv-pvr11:41.6": "",
  "pli-tv-pvr11:41.7": "tiṇavatthārako nidānanidāno nidānasamudayo . . . nidānasamuṭṭhāno. ||16|| ",
  "pli-tv-pvr11:42.1": "sammukhāvinayo kiṃnidāno . . . kiṃsamuṭṭhāno. ",
  "pli-tv-pvr11:42.2": "sativinayo . . ., . . . ",
  "pli-tv-pvr11:42.3": "",
  "pli-tv-pvr11:42.4": "",
  "pli-tv-pvr11:42.5": "",
  "pli-tv-pvr11:42.6": "",
  "pli-tv-pvr11:42.7": "tiṇavatthārako kiṃnidāno . . . kiṃsamuṭṭhāno. ",
  "pli-tv-pvr11:43.1": "sammukhāvinayo hetunidāno . . ., . . . ",
