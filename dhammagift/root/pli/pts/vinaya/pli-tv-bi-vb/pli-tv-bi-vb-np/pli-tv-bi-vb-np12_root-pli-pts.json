  "pli-tv-bi-vb-np12:1.20": "uddisantu: ",
  "pli-tv-bi-vb-np12:1.21.0": "",
  "pli-tv-bi-vb-np12:1.21.1": "lahupāvuraṇaṃ pana bhikkhuniyā cetāpentiyā aḍḍhateyyakaṃsaparamaṃ cetāpetabbaṃ. tato ce uttari cetāpeyya, nissaggiyaṃ pācittiyan ti. ||1|| ",
  "pli-tv-bi-vb-np12:2.1.0": "",
  "pli-tv-bi-vb-np12:2.1.1": "lahupāvuraṇaṃ nāma ",
  "pli-tv-bi-vb-np12:2.1.2": "yaṃ kiñci uṇhakāle pāvuraṇaṃ. ",
  "pli-tv-bi-vb-np12:2.1.3": "cetāpentiyā 'ti ",
  "pli-tv-bi-vb-np12:2.1.4": "viññāpentiyā. ",
  "pli-tv-bi-vb-np12:2.1.5": "aḍḍhateyyakaṃsaparamaṃ cetāpetabban ti ",
  "pli-tv-bi-vb-np12:2.1.6": "dasakahāpaṇagghanakaṃ cetāpetabbaṃ. ",
  "pli-tv-bi-vb-np12:2.1.7": "tato ce uttari . . . (see ",
  "pli-tv-bi-vb-np12:2.1.8": "",
  "pli-tv-bi-vb-np12:2.1.9": "XI.2. ",
  "pli-tv-bi-vb-np12:2.1.10": "",
  "pli-tv-bi-vb-np12:2.1.11": "Read ",
  "pli-tv-bi-vb-np12:2.1.12": "",
  "pli-tv-bi-vb-np12:2.1.13": "lahupāvuraṇaṃ atirekāḍḍhateyyakaṃsaparamaṃ; ",
  "pli-tv-bi-vb-np12:2.1.14": "",
  "pli-tv-bi-vb-np12:2.1.15": "",
  "pli-tv-bi-vb-np12:2.1.16": "atirekāḍḍhateyyakaṃse, ",
  "pli-tv-bi-vb-np12:2.1.17.0": "",
  "pli-tv-bi-vb-np12:2.1.17.1": "",
  "pli-tv-bi-vb-np12:2.1.18": "",
  "pli-tv-bi-vb-np12:2.1.19": "ūnakāḍḍhateyyakaṃse) . . . ",
  "pli-tv-bi-vb-np12:2.1.20": "",
  "pli-tv-bi-vb-np12:2.1.21": "",
  "pli-tv-bi-vb-np12:2.1.22": "anāpatti. ||1|| ",
  "pli-tv-bi-vb-np12:2.2.0": "",
  "pli-tv-bi-vb-np12:2.2.1": "anāpatti ",
  "pli-tv-bi-vb-np12:2.2.2": "aḍḍhateyyakaṃsaparamaṃ cetāpeti, ",
  "pli-tv-bi-vb-np12:2.2.3": "ūnakāḍḍhateyyakaṃsaparamaṃ cetāpeti . . . ",
  "pli-tv-bi-vb-np12:2.2.4": "",
  "pli-tv-bi-vb-np12:2.2.5": "",
  "pli-tv-bi-vb-np12:2.2.6": "",
  "pli-tv-bi-vb-np12:2.2.7": "",
  "pli-tv-bi-vb-np12:2.2.8": "",
  "pli-tv-bi-vb-np12:2.2.9": "",
  "pli-tv-bi-vb-np12:2.2.10": "ādikammikāyā 'ti. ||2||2|| ",
  "pli-tv-bi-vb-np12:2.2.11": "",
  "pli-tv-bi-vb-np12:2.2.12.0": "",
  "pli-tv-bi-vb-np12:2.2.13.0": "",
  "pli-tv-bi-vb-np12:2.2.14": "uddiṭṭhā kho ayyāyo tiṃsa nissaggiyā pācittiyā dhammā. ",
  "pli-tv-bi-vb-np12:2.2.15": "tatth' ayyāyo pucchāmi: ",
  "pli-tv-bi-vb-np12:2.2.16": "kacci 'ttha parisuddhā. ",
  "pli-tv-bi-vb-np12:2.2.17": "dutiyam pi pucchāmi: ",
  "pli-tv-bi-vb-np12:2.2.18": "kacci 'ttha parisuddhā. ",
  "pli-tv-bi-vb-np12:2.2.19": "tatiyam pi pucchāmi: ",
  "pli-tv-bi-vb-np12:2.2.20": "kacci 'ttha parisuddhā. ",
  "pli-tv-bi-vb-np12:2.2.21": "parisuddh' etth' ayyāyo, tasmā tuṇhī, evam etaṃ dhārayāmīti. ",
  "pli-tv-bi-vb-np12:2.2.22": "tiṃsanissaggiyaṃ niṭṭhitaṃ. "
}
