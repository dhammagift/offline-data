  "pli-tv-bi-vb-np9:1.1": "Tena samayena buddho bhagavā Sāvatthiyaṃ viharati Jetavane Anāthapiṇḍikassa ārāme. ",
  "pli-tv-bi-vb-np9:1.2": "tena kho pana samayena aññatarassa pūgassa pariveṇavāsikā bhikkhuniyo . . . ",
  "pli-tv-bi-vb-np9:1.3": "",
  "pli-tv-bi-vb-np9:1.4": "",
  "pli-tv-bi-vb-np9:1.5": "(see VIII.1) . . . paribhuñjathā 'ti. ",
  "pli-tv-bi-vb-np9:1.6": "bhikkhuniyo tena ca parikkhārena sayam pi yācitvā bhesajjaṃ cetāpetvā paribhuñjiṃsu. atha kho ",
  "pli-tv-bi-vb-np9:1.7": "so pūgo jānitvā . . . (see ",
  "pli-tv-bi-vb-np9:1.8": "VIII.1. After mahājanikena insert ",
  "pli-tv-bi-vb-np9:1.9": "",
  "pli-tv-bi-vb-np9:1.10": "",
  "pli-tv-bi-vb-np9:1.11": "",
  "pli-tv-bi-vb-np9:1.12": "saṃyācikena) . . . ",
  "pli-tv-bi-vb-np9:1.13": "",
  "pli-tv-bi-vb-np9:1.14": "uddisantu: ",
  "pli-tv-bi-vb-np9:1.15.0": "",
  "pli-tv-bi-vb-np9:1.15.1": "yā pana bhikkhunī aññadatthikena parikkhārena aññuddisikena mahājanikena saṃyācikena aññaṃ cetāpeyya, nissaggiyaṃ pācittiyan ti. ||1|| ",
  "pli-tv-bi-vb-np9:2.0": "",
  "pli-tv-bi-vb-np9:2.1": "yā panā 'ti . . . ",
  "pli-tv-bi-vb-np9:2.2": "",
  "pli-tv-bi-vb-np9:2.3": "",
  "pli-tv-bi-vb-np9:2.4": "adhippetā bhikkhunīti. ",
  "pli-tv-bi-vb-np9:2.5": "aññadatthikena parikkhārena aññuddisikenā 'ti . . . ",
  "pli-tv-bi-vb-np9:2.6": "",
  "pli-tv-bi-vb-np9:2.7": "mahājanikenā 'ti . . . ",
  "pli-tv-bi-vb-np9:2.8": "saṃyācikenā ",
  "pli-tv-bi-vb-np9:2.9": "'ti ",
  "pli-tv-bi-vb-np9:2.10": "sayaṃ yācitvā. ",
  "pli-tv-bi-vb-np9:2.11": "aññaṃ cetāpeyyā 'ti . . . ",
  "pli-tv-bi-vb-np9:2.12": "",
  "pli-tv-bi-vb-np9:2.13": "",
  "pli-tv-bi-vb-np9:2.14": "",
