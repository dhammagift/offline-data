  "pli-tv-bi-vb-pc42:0.4": "",
  "pli-tv-bi-vb-pc42:0.5": "",
  "pli-tv-bi-vb-pc42:1.0": "",
  "pli-tv-bi-vb-pc42:1.1": "Tena samayena buddho bhagavā Sāvatthiyaṃ viharati Jetavane Anāthapiṇḍikassa ārāme. ",
  "pli-tv-bi-vb-pc42:1.2": "tena kho pana samayena bhikkhuniyo āsandiṃ pi pallaṅkaṃ pi paribhuñjanti. ",
  "pli-tv-bi-vb-pc42:1.3": "manussā vihāracārikaṃ āhiṇḍantā passitvā . . . vipācenti: ",
  "pli-tv-bi-vb-pc42:1.4": "kathaṃ hi nāma bhikkhuniyo āsandiṃ pi pallaṅkaṃ pi paribhuñjissanti seyyathāpi gihikāmabhoginiyo 'ti. ",
  "pli-tv-bi-vb-pc42:1.5": "assosuṃ kho bhikkhuniyo tesaṃ manussānaṃ . . . vipācentānaṃ. ",
  "pli-tv-bi-vb-pc42:1.6": "yā tā bhikkhuniyo appicchā . . . vipācenti: ",
  "pli-tv-bi-vb-pc42:1.7": "kathaṃ hi nāma bhikkhuniyo . . . paribhuñjissantīti --pa--. ",
  "pli-tv-bi-vb-pc42:1.8": "saccaṃ kira bhikkhave bhikkhuniyo . . . paribhuñjantīti. ",
  "pli-tv-bi-vb-pc42:1.9": "saccaṃ bhagavā. ",
  "pli-tv-bi-vb-pc42:1.10": "vigarahi buddho bhagavā: kathaṃ ",
  "pli-tv-bi-vb-pc42:1.11": "hi nāma bhikkhave bhikkhuniyo . . . paribhuñjissanti. ",
  "pli-tv-bi-vb-pc42:1.12": "n' etaṃ bhikkhave appasannānaṃ . . . ",
  "pli-tv-bi-vb-pc42:1.13": "uddisantu: ",
  "pli-tv-bi-vb-pc42:1.14.0": "",
  "pli-tv-bi-vb-pc42:1.14.1": "yā pana bhikkhunī āsandiṃ vā pallaṅkaṃ vā paribhuñjeyya, pācittiyan ti. ||1|| ",
  "pli-tv-bi-vb-pc42:2.1.0": "",
  "pli-tv-bi-vb-pc42:2.1.1": "yā panā 'ti . . . ",
  "pli-tv-bi-vb-pc42:2.1.2": "",
  "pli-tv-bi-vb-pc42:2.1.3": "",
  "pli-tv-bi-vb-pc42:2.1.4": "adhippetā bhikkhunīti. ",
  "pli-tv-bi-vb-pc42:2.1.5": "āsandi nāma ",
  "pli-tv-bi-vb-pc42:2.1.6": "atikkantappamāṇā vuccati. ",
  "pli-tv-bi-vb-pc42:2.1.7": "pallaṅko nāma ",
  "pli-tv-bi-vb-pc42:2.1.8": "āharimehi vālehi kato hoti. ",
  "pli-tv-bi-vb-pc42:2.1.9": "paribhuñjeyyā 'ti, ",
  "pli-tv-bi-vb-pc42:2.1.10": "tasmiṃ abhinisīdati vā abhinipajjati vā, āpatti pācittiyassa. ||1|| ",
  "pli-tv-bi-vb-pc42:2.2.0": "",
  "pli-tv-bi-vb-pc42:2.2.1": "anāpatti ",
  "pli-tv-bi-vb-pc42:2.2.2": "āsandiyā pāde chinditvā paribhuñjati, ",
  "pli-tv-bi-vb-pc42:2.2.3": "pallaṅkassa vāle chinditvā paribhuñjati, ",
  "pli-tv-bi-vb-pc42:2.2.4": "ummattikāya, ",
  "pli-tv-bi-vb-pc42:2.2.5": "ādikammikāyā 'ti. ||2||2|| ",
  "pli-tv-bi-vb-pc42:2.2.6": ""
}
