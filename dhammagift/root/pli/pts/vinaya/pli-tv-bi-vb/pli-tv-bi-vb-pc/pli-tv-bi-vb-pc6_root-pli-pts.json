{
  "pli-tv-bi-vb-pc6:0.1": "",
  "pli-tv-bi-vb-pc6:0.2": "",
  "pli-tv-bi-vb-pc6:0.3": "",
  "pli-tv-bi-vb-pc6:0.4": "",
  "pli-tv-bi-vb-pc6:0.5": "",
  "pli-tv-bi-vb-pc6:1.0": "",
  "pli-tv-bi-vb-pc6:1.1": "Tena samayena buddho bhagavā Sāvatthiyaṃ viharati Jetavane Anāthapiṇḍikassa ārāme. ",
  "pli-tv-bi-vb-pc6:1.2": "tena kho pana samayena Ārohanto nāma mahāmatto bhikkhūsu pabbajito hoti, ",
  "pli-tv-bi-vb-pc6:1.3": "tassa purāṇadutiyikā bhikkhunīsu pabbajitā hoti. ",
  "pli-tv-bi-vb-pc6:1.4": "tena kho pana samayena so bhikkhu tassā bhikkhuniyā santike bhattavissaggaṃ karoti. ",
  "pli-tv-bi-vb-pc6:1.5": "atha kho sā bhikkhunī tassa bhikkhuno bhuñjantassa pāniyena ca vidhūpanena ca upatiṭṭhitvā accāvadati. ",
  "pli-tv-bi-vb-pc6:1.6": "atha kho so bhikkhu taṃ bhikkhuniṃ apasādesi: ",
  "pli-tv-bi-vb-pc6:1.7": "mā bhagini evarūpaṃ akāsi, ",
  "pli-tv-bi-vb-pc6:1.8": "n' etaṃ kappatīti. ",
  "pli-tv-bi-vb-pc6:1.9": "pubbe maṃ tvaṃ evañ ca evañ ca karosi, idāni ettakaṃ na sahasīti ",
  "pli-tv-bi-vb-pc6:1.10": "pāniyathālakaṃ matthake āsumbhitvā vidhūpanena pahāraṃ adāsi. ",
  "pli-tv-bi-vb-pc6:1.11": "yā tā bhikkhuniyo appicchā . . . vipācenti: ",
  "pli-tv-bi-vb-pc6:1.12": "kathaṃ hi nāma bhikkhunī bhikkhussa pahāraṃ dassatīti --pa--. ",
  "pli-tv-bi-vb-pc6:1.13": "saccaṃ kira bhikkhave bhikkhunī . . . adāsīti. ",
  "pli-tv-bi-vb-pc6:1.14": "saccaṃ bhagavā. ",
  "pli-tv-bi-vb-pc6:1.15": "vigarahi buddho bhagavā: kathaṃ ",
  "pli-tv-bi-vb-pc6:1.16": "hi nāma bhikkhave bhikkhunī . . . dassati. ",
  "pli-tv-bi-vb-pc6:1.17": "n' etaṃ bhikkhave appasannānaṃ . . . ",
  "pli-tv-bi-vb-pc6:1.18": "uddisantu: ",
  "pli-tv-bi-vb-pc6:1.19.0": "",
  "pli-tv-bi-vb-pc6:1.19.1": "yā pana bhikkhunī bhikkhussa bhuñjantassa pāniyena vā vidhūpanena vā upatiṭṭheyya, pācittiyan ti. ||1|| ",
  "pli-tv-bi-vb-pc6:2.1.0": "",
  "pli-tv-bi-vb-pc6:2.1.1": "yā panā 'ti . . . ",
  "pli-tv-bi-vb-pc6:2.1.2": "",
  "pli-tv-bi-vb-pc6:2.1.3": "",
  "pli-tv-bi-vb-pc6:2.1.4": "adhippetā bhikkhunīti. ",
  "pli-tv-bi-vb-pc6:2.1.5": "bhikkhussā 'ti ",
  "pli-tv-bi-vb-pc6:2.1.6": "upasampannassa. ",
  "pli-tv-bi-vb-pc6:2.1.7": "bhuñjantassā 'ti ",
  "pli-tv-bi-vb-pc6:2.1.8": "pañcannaṃ bhojanānaṃ aññataraṃ bhojanaṃ bhuñjantassa. ",
  "pli-tv-bi-vb-pc6:2.1.9": "pāniyaṃ nāma ",
  "pli-tv-bi-vb-pc6:2.1.10": "yaṃ kiñci pāniyaṃ. ",
  "pli-tv-bi-vb-pc6:2.1.11": "vidhūpanan nāma ",
  "pli-tv-bi-vb-pc6:2.1.12": "yā kāci vījanī. ",
  "pli-tv-bi-vb-pc6:2.1.13": "upatiṭṭheyyā 'ti ",
  "pli-tv-bi-vb-pc6:2.1.14": "hatthapāse tiṭṭhati, āpatti pācittiyassa. ||1|| ",
  "pli-tv-bi-vb-pc6:2.2.0": "",
  "pli-tv-bi-vb-pc6:2.2.1": "upasampanne upasampannasaññā pāniyena vā vidhūpanena vā upatiṭṭhati, āpatti pācittiyassa. ",
  "pli-tv-bi-vb-pc6:2.2.2": "upasampanne vematikā . . . ",
  "pli-tv-bi-vb-pc6:2.2.3": "upasampanne anupasampannasaññā . . . āpatti pācittiyassa. ",
  "pli-tv-bi-vb-pc6:2.2.4": "hatthapāsaṃ vijahitvā upatiṭṭhati, āpatti dukkaṭassa. ",
  "pli-tv-bi-vb-pc6:2.2.5": "khādaniyaṃ khādantassa upatiṭṭhati, āpatti dukkaṭassa. ",
  "pli-tv-bi-vb-pc6:2.2.6": "anupasampannassa upatiṭṭhati, āpatti dukkaṭassa. ",
  "pli-tv-bi-vb-pc6:2.2.7": "anupasampanne upasampannasaññā, āpatti dukkaṭassa. ",
  "pli-tv-bi-vb-pc6:2.2.8": "anupasampanne vematikā, āpatti dukkaṭassa. ",
  "pli-tv-bi-vb-pc6:2.2.9": "anupasampanne anupasampannasaññā, āpatti dukkaṭassa. ||2|| ",
  "pli-tv-bi-vb-pc6:2.3.0": "",
  "pli-tv-bi-vb-pc6:2.3.1": "anāpatti ",
  "pli-tv-bi-vb-pc6:2.3.2": "deti, ",
  "pli-tv-bi-vb-pc6:2.3.3": "dāpeti, ",
  "pli-tv-bi-vb-pc6:2.3.4": "anupasampannaṃ āṇāpeti, ",
  "pli-tv-bi-vb-pc6:2.3.5": "ummattikāya, ",
  "pli-tv-bi-vb-pc6:2.3.6": "ādikammikāyā 'ti. ||3||2|| ",
  "pli-tv-bi-vb-pc6:2.3.7": ""
}
