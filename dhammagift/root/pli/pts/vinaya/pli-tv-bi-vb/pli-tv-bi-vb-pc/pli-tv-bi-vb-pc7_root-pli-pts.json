  "pli-tv-bi-vb-pc7:1.0": "",
  "pli-tv-bi-vb-pc7:1.1": "Tena samayena buddho bhagavā Sāvatthiyaṃ viharati Jetavane Anāthapiṇḍikassa ārāme. ",
  "pli-tv-bi-vb-pc7:1.2": "tena kho pana samayena bhikkhuniyo sassakāle āmakadhaññaṃ viññāpetvā nagaraṃ atiharanti. dvāraṭṭhāne ",
  "pli-tv-bi-vb-pc7:1.3": "deth' ayye bhāgan ti ",
  "pli-tv-bi-vb-pc7:1.4": "palibuddhitvā muñciṃsu. ",
  "pli-tv-bi-vb-pc7:1.5": "atha kho tā bhikkhuniyo upassayaṃ gantvā bhikkhunīnaṃ etam atthaṃ ārocesuṃ. ",
  "pli-tv-bi-vb-pc7:1.6": "yā tā bhikkhuniyo appicchā tā ujjhāyanti --pa--: kathaṃ ",
  "pli-tv-bi-vb-pc7:1.7": "hi nāma bhikkhuniyo āmakadhaññaṃ viññāpessantīti --pa--. ",
  "pli-tv-bi-vb-pc7:1.8": "saccaṃ kira bhikkhave bhikkhuniyo āmakadhaññaṃ viññāpentīti. ",
  "pli-tv-bi-vb-pc7:1.9": "saccaṃ bhagavā. ",
  "pli-tv-bi-vb-pc7:1.10": "vigarahi buddho bhagavā: kathaṃ ",
  "pli-tv-bi-vb-pc7:1.11": "hi nāma bhikkhave bhikkhuniyo āmakadhaññaṃ viññāpessanti. ",
  "pli-tv-bi-vb-pc7:1.12": "n' etaṃ bhikkhave appasannānaṃ . . . ",
  "pli-tv-bi-vb-pc7:1.13": "uddisantu: ",
  "pli-tv-bi-vb-pc7:1.14.0": "",
  "pli-tv-bi-vb-pc7:1.14.1": "yā pana bhikkhunī āmakadhaññaṃ viññitvā vā viññāpetvā vā bhajjitvā vā bhajjāpetvā vā koṭṭitvā vā koṭṭāpetvā vā pacitvā vā pacāpetvā vā bhuñjeyya, pācittiyan ti. ||1|| ",
  "pli-tv-bi-vb-pc7:2.1.0": "",
  "pli-tv-bi-vb-pc7:2.1.1": "yā panā 'ti . . . ",
  "pli-tv-bi-vb-pc7:2.1.2": "",
  "pli-tv-bi-vb-pc7:2.1.3": "",
  "pli-tv-bi-vb-pc7:2.1.4": "adhippetā bhikkhunīti. ",
  "pli-tv-bi-vb-pc7:2.1.5": "āmakadhaññaṃ nāma ",
  "pli-tv-bi-vb-pc7:2.1.6": "sāli vīhi yavo godhūmo kaṅgu varako kudrūsako. ",
  "pli-tv-bi-vb-pc7:2.1.7": "viññitvā 'ti ",
  "pli-tv-bi-vb-pc7:2.1.8": "sayaṃ viññitvā. ",
  "pli-tv-bi-vb-pc7:2.1.9": "viññāpetvā 'ti ",
  "pli-tv-bi-vb-pc7:2.1.10": "aññaṃ viññāpetvā. ",
  "pli-tv-bi-vb-pc7:2.1.11": "bhajjitvā 'ti ",
  "pli-tv-bi-vb-pc7:2.1.12": "sayaṃ bhajjitvā. ",
  "pli-tv-bi-vb-pc7:2.1.13": "bhajjāpetvā 'ti ",
  "pli-tv-bi-vb-pc7:2.1.14": "aññaṃ bhajjāpetvā. ",
  "pli-tv-bi-vb-pc7:2.1.15": "koṭṭitvā ",
  "pli-tv-bi-vb-pc7:2.1.16": "'ti . . . ",
  "pli-tv-bi-vb-pc7:2.1.17": "",
  "pli-tv-bi-vb-pc7:2.1.18": "koṭṭāpetvā ",
  "pli-tv-bi-vb-pc7:2.1.19": "'ti . . . ",
  "pli-tv-bi-vb-pc7:2.1.20": "pacitvā ",
  "pli-tv-bi-vb-pc7:2.1.21": "'ti . . . pacāpetvā 'ti ",
  "pli-tv-bi-vb-pc7:2.1.22": "aññaṃ pacāpetvā. ",
  "pli-tv-bi-vb-pc7:2.1.23": "bhuñjissāmīti paṭigaṇhāti, āpatti dukkaṭassa. ",
  "pli-tv-bi-vb-pc7:2.1.24": "ajjhohāre ajjhohāre āpatti pācittiyassa. ||1|| ",
  "pli-tv-bi-vb-pc7:2.2.0": "",
  "pli-tv-bi-vb-pc7:2.2.1": "anāpatti ",
  "pli-tv-bi-vb-pc7:2.2.2": "ābādhapaccayā, ",
  "pli-tv-bi-vb-pc7:2.2.3": "aparaṇṇaṃ viññāpeti, ",
  "pli-tv-bi-vb-pc7:2.2.4": "ummattikāya, ",
  "pli-tv-bi-vb-pc7:2.2.5": "ādikammikāyā 'ti. ||2||2|| ",
  "pli-tv-bi-vb-pc7:2.2.6": ""
}
