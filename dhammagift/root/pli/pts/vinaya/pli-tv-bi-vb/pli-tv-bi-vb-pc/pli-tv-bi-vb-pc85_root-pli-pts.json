{
  "pli-tv-bi-vb-pc85:0.1": "",
  "pli-tv-bi-vb-pc85:0.2": "",
  "pli-tv-bi-vb-pc85:0.3": "",
  "pli-tv-bi-vb-pc85:0.4": "",
  "pli-tv-bi-vb-pc85:0.5": "",
  "pli-tv-bi-vb-pc85:1.1.0.1": "",
  "pli-tv-bi-vb-pc85:1.1.0.2": "",
  "pli-tv-bi-vb-pc85:1.1.1": "Tena samayena buddho bhagavā Sāvatthiyaṃ viharati Jetavane Anāthapiṇḍikassa ārāme. ",
  "pli-tv-bi-vb-pc85:1.1.2": "tena kho pana samayena chabbaggiyā bhikkhuniyo yānena yāyanti. ",
  "pli-tv-bi-vb-pc85:1.1.3": "manussā . . . vipācenti: ",
  "pli-tv-bi-vb-pc85:1.1.4": "kathaṃ hi nāma bhikkhuniyo yānena yāyissanti seyyathāpi gihikāmabhoginiyo 'ti. ",
  "pli-tv-bi-vb-pc85:1.1.5": "assosuṃ kho bhikkhuniyo tesaṃ manussānaṃ . . . vipācentānaṃ. ",
  "pli-tv-bi-vb-pc85:1.1.6": "yā tā bhikkhuniyo appicchā . . . vipācenti: ",
  "pli-tv-bi-vb-pc85:1.1.7": "kathaṃ hi nāma chabbaggiyā bhikkhuniyo yānena yāyissantīti --pa--. ",
  "pli-tv-bi-vb-pc85:1.1.8": "saccaṃ kira bhikkhave chabbaggiyā . . . yāyantīti. ",
  "pli-tv-bi-vb-pc85:1.1.9": "saccaṃ bhagavā. ",
  "pli-tv-bi-vb-pc85:1.1.10": "vigarahi buddho bhagavā: kathaṃ ",
  "pli-tv-bi-vb-pc85:1.1.11": "hi nāma bhikkhave chabbaggiyā . . . yāyissanti. ",
  "pli-tv-bi-vb-pc85:1.1.12": "n' etaṃ bhikkhave appasannānaṃ . . . ",
  "pli-tv-bi-vb-pc85:1.1.13": "uddisantu: ",
  "pli-tv-bi-vb-pc85:1.1.14.0": "",
  "pli-tv-bi-vb-pc85:1.1.14.1": "yā pana bhikkhunī yānena yāyeyya, pācittiyan ti. ",
  "pli-tv-bi-vb-pc85:1.1.15": "evañ c' idaṃ bhagavatā bhikkhunīnaṃ sikkhāpadaṃ paññattaṃ hoti. ||1|| ",
  "pli-tv-bi-vb-pc85:1.2.0": "",
  "pli-tv-bi-vb-pc85:1.2.1": "tena kho pana samayena aññatarā bhikkhunī gilānā hoti, na sakkoti padasā gantuṃ. ",
  "pli-tv-bi-vb-pc85:1.2.2": "bhagavato . . . ārocesuṃ. ",
  "pli-tv-bi-vb-pc85:1.2.3": "anujānāmi bhikkhave gilānāya bhikkhuniyā yānaṃ. ",
  "pli-tv-bi-vb-pc85:1.2.4": "evañ ca pana . . . uddisantu: ",
  "pli-tv-bi-vb-pc85:1.2.5.0": "",
  "pli-tv-bi-vb-pc85:1.2.5.1": "yā pana bhikkhunī agilānā yānena yāyeyya, pācittiyan ti. ||2||1|| ",
  "pli-tv-bi-vb-pc85:2.1.0": "",
  "pli-tv-bi-vb-pc85:2.1.1": "yā panā 'ti . . . ",
  "pli-tv-bi-vb-pc85:2.1.2": "",
  "pli-tv-bi-vb-pc85:2.1.3": "",
  "pli-tv-bi-vb-pc85:2.1.4": "adhippetā bhikkhunīti. ",
  "pli-tv-bi-vb-pc85:2.1.5": "agilānā nāma ",
  "pli-tv-bi-vb-pc85:2.1.6": "sakkoti padasā gantuṃ. ",
  "pli-tv-bi-vb-pc85:2.1.7": "gilānā nāma ",
  "pli-tv-bi-vb-pc85:2.1.8": "na sakkoti padasā gantuṃ. ",
  "pli-tv-bi-vb-pc85:2.1.9": "yānaṃ nāma ",
  "pli-tv-bi-vb-pc85:2.1.10": "vayhaṃ ratho sakaṭaṃ sandamānikā sivikā pāṭaṅkī. ",
  "pli-tv-bi-vb-pc85:2.1.11": "yāyeyyā 'ti ",
  "pli-tv-bi-vb-pc85:2.1.12": "sakim pi yāyati, āpatti pācittiyassa. ||1|| ",
  "pli-tv-bi-vb-pc85:2.2.0": "",
  "pli-tv-bi-vb-pc85:2.2.1": "agilānā agilānasaññā yānena yāyati, āpatti pācittiyassa. ",
  "pli-tv-bi-vb-pc85:2.2.2": "agilānā vematikā . . . ",
  "pli-tv-bi-vb-pc85:2.2.3": "agilānā gilānasaññā . . . āpatti pācittiyassa. ",
  "pli-tv-bi-vb-pc85:2.2.4": "gilānā agilānasaññā, āpatti dukkaṭassa. ",
  "pli-tv-bi-vb-pc85:2.2.5": "gilānā vematikā, āpatti dukkaṭassa. ",
  "pli-tv-bi-vb-pc85:2.2.6": "gilānā gilānasaññā, anāpatti. ||2|| ",
  "pli-tv-bi-vb-pc85:2.3.0": "",
  "pli-tv-bi-vb-pc85:2.3.1": "anāpatti ",
  "pli-tv-bi-vb-pc85:2.3.2": "gilānāya, ",
  "pli-tv-bi-vb-pc85:2.3.3": "āpadāsu, ",
  "pli-tv-bi-vb-pc85:2.3.4": "ummattikāya, ",
  "pli-tv-bi-vb-pc85:2.3.5": "ādikammikāyā ",
  "pli-tv-bi-vb-pc85:2.3.6": "'ti. ||3||2|| "
}
