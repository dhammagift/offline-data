  "pli-tv-bi-vb-pc32:1.0": "",
  "pli-tv-bi-vb-pc32:1.1": "Tena samayena buddho bhagavā Sāvatthiyaṃ viharati Jetavane Anāthapiṇḍikassa ārāme. ",
  "pli-tv-bi-vb-pc32:1.2": "tena kho pana samayena bhikkhuniyo dve ekattharaṇapāvuraṇā tuvaṭṭenti. ",
  "pli-tv-bi-vb-pc32:1.3": "manussā vihāracārikaṃ āhiṇḍantā . . . (XXXI.1. Instead of ",
  "pli-tv-bi-vb-pc32:1.4": "ekamañce read ekattharaṇapāvuraṇā) . . . ",
  "pli-tv-bi-vb-pc32:1.5": "",
  "pli-tv-bi-vb-pc32:1.6": "",
  "pli-tv-bi-vb-pc32:1.7": "",
  "pli-tv-bi-vb-pc32:1.8": "",
  "pli-tv-bi-vb-pc32:1.9": "",
  "pli-tv-bi-vb-pc32:1.10": "",
  "pli-tv-bi-vb-pc32:1.11": "",
  "pli-tv-bi-vb-pc32:1.12": "",
  "pli-tv-bi-vb-pc32:1.13": "uddisantu: ",
  "pli-tv-bi-vb-pc32:1.14.0": "",
  "pli-tv-bi-vb-pc32:1.14.1": "yā pana bhikkhuniyo dve ekattharaṇapāvuraṇā tuvaṭṭeyyuṃ, pācittiyan ti. ||1|| ",
  "pli-tv-bi-vb-pc32:2.1.0": "",
  "pli-tv-bi-vb-pc32:2.1.1": "yā panā 'ti ",
  "pli-tv-bi-vb-pc32:2.1.2": "yā yādisā --pa--. ",
  "pli-tv-bi-vb-pc32:2.1.3": "bhikkhuniyo 'ti ",
  "pli-tv-bi-vb-pc32:2.1.4": "upasampannāyo vuccanti. ",
  "pli-tv-bi-vb-pc32:2.1.5": "dve ekattharaṇapāvuraṇā tuvaṭṭeyyun ti, ",
  "pli-tv-bi-vb-pc32:2.1.6": "tañ ñeva attharitvā tañ ñeva pārupanti, āpatti pācittiyassa. ||1|| ",
  "pli-tv-bi-vb-pc32:2.2.0": "",
  "pli-tv-bi-vb-pc32:2.2.1": "ekattharaṇapāvuraṇe ekattharaṇapāvuraṇasaññā tuvaṭṭenti, āpatti pācittiyassa. ",
  "pli-tv-bi-vb-pc32:2.2.2": "ekattharaṇapāvuraṇe vematikā . . . ",
  "pli-tv-bi-vb-pc32:2.2.3": "ekattharaṇapāvuraṇe nānattharaṇapāvuraṇasaññā . . . āpatti pācittiyassa. ",
  "pli-tv-bi-vb-pc32:2.2.4": "ekattharaṇe nānāpāvuraṇasaññā, āpatti dukkaṭassa. ",
  "pli-tv-bi-vb-pc32:2.2.5": "nānattharaṇe ekattharaṇapāvuraṇasaññā, āpatti dukkaṭassa. ",
  "pli-tv-bi-vb-pc32:2.2.6": "nānattharaṇapāvuraṇe ekattharaṇapāvuraṇasaññā, āpatti dukkaṭassa, ",
  "pli-tv-bi-vb-pc32:2.2.7": "nānattharaṇapāvuraṇe vematikā, āpatti dukkaṭassa. ",
  "pli-tv-bi-vb-pc32:2.2.8": "nānattharaṇapāvuraṇe nānattharaṇapāvuraṇasaññā, anāpatti. ||2|| ",
  "pli-tv-bi-vb-pc32:2.3.0": "",
  "pli-tv-bi-vb-pc32:2.3.1": "anāpatti ",
  "pli-tv-bi-vb-pc32:2.3.2": "vavatthānaṃ dassetvā nipajjanti, ",
  "pli-tv-bi-vb-pc32:2.3.3": "ummattikānaṃ, ",
  "pli-tv-bi-vb-pc32:2.3.4": "ādikammikānan ti. ||3||2|| ",
  "pli-tv-bi-vb-pc32:2.3.5": ""
}
