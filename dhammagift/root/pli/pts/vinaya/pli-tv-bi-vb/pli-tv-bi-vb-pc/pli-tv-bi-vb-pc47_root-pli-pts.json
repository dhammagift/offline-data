  "pli-tv-bi-vb-pc47:0.4": "",
  "pli-tv-bi-vb-pc47:0.5": "",
  "pli-tv-bi-vb-pc47:1.0": "",
  "pli-tv-bi-vb-pc47:1.1": "Tena samayena buddho bhagavā Sāvatthiyaṃ viharati Jetavane Anāthapiṇḍikassa ārāme. ",
  "pli-tv-bi-vb-pc47:1.2": "tena kho pana samayena Thullanandā bhikkhunī āvasathacīvaraṃ anissajjitvā paribhuñjati. ",
  "pli-tv-bi-vb-pc47:1.3": "aññā utuniyo bhikkhuniyo na labhanti. ",
  "pli-tv-bi-vb-pc47:1.4": "yā tā bhikkhuniyo appicchā . . . vipācenti: ",
  "pli-tv-bi-vb-pc47:1.5": "kathaṃ hi nāma ayyā Thullanandā āvasathacīvaraṃ anissajjitvā paribhuñjissatīti --pa--. ",
  "pli-tv-bi-vb-pc47:1.6": "saccaṃ kira bhikkhave Thullanandā bhikkhunī . . . paribhuñjatīti. ",
  "pli-tv-bi-vb-pc47:1.7": "saccaṃ bhagavā. ",
  "pli-tv-bi-vb-pc47:1.8": "vigarahi buddho bhagavā: kathaṃ ",
  "pli-tv-bi-vb-pc47:1.9": "hi nāma bhikkhave Thullanandā bhikkhunī . . . paribhuñjissati. ",
  "pli-tv-bi-vb-pc47:1.10": "n' etaṃ bhikkhave appasannānaṃ . . . ",
  "pli-tv-bi-vb-pc47:1.11": "uddisantu: ",
  "pli-tv-bi-vb-pc47:1.12.0": "",
  "pli-tv-bi-vb-pc47:1.12.1": "yā pana bhikkhunī āvasathacīvaraṃ anissajjitvā paribhuñjeyya, pācittiyan ti. ||1|| ",
  "pli-tv-bi-vb-pc47:2.1.0": "",
  "pli-tv-bi-vb-pc47:2.1.1": "yā panā 'ti . . . ",
  "pli-tv-bi-vb-pc47:2.1.2": "",
  "pli-tv-bi-vb-pc47:2.1.3": "",
  "pli-tv-bi-vb-pc47:2.1.4": "adhippetā bhikkhunīti. ",
  "pli-tv-bi-vb-pc47:2.1.5": "āvasathacīvaran nāma ",
  "pli-tv-bi-vb-pc47:2.1.6": "utuniyo bhikkhuniyo paribhuñjantū 'ti dinnaṃ hoti. ",
  "pli-tv-bi-vb-pc47:2.1.7": "anissajjitvā paribhuñjeyyā 'ti ",
  "pli-tv-bi-vb-pc47:2.1.8": "dve tisso rattiyo paribhuñjitvā catutthadivase dhovitvā bhikkhuniyā vā sikkhamānāya vā sāmaṇeriyā vā anissajjitvā paribhuñjati, āpatti pācittiyassa. ||1|| ",
  "pli-tv-bi-vb-pc47:2.2.0": "",
  "pli-tv-bi-vb-pc47:2.2.1": "anissajjite anissajjitasaññā paribhuñjati, āpatti pācittiyassa. ",
  "pli-tv-bi-vb-pc47:2.2.2": "anissajjite vematikā . . . ",
  "pli-tv-bi-vb-pc47:2.2.3": "anissajjite nissajjitasaññā . . . āpatti pācittiyassa. ",
  "pli-tv-bi-vb-pc47:2.2.4": "nissajjite anissajjitasaññā, āpatti dukkaṭassa. ",
  "pli-tv-bi-vb-pc47:2.2.5": "nissajjite vematikā, āpatti dukkaṭassa. ",
  "pli-tv-bi-vb-pc47:2.2.6": "nissajjite nissajjitasaññā, anāpatti. ||2|| ",
  "pli-tv-bi-vb-pc47:2.3.0": "",
  "pli-tv-bi-vb-pc47:2.3.1": "anāpatti ",
  "pli-tv-bi-vb-pc47:2.3.2": "nissajjitvā paribhuñjati, ",
  "pli-tv-bi-vb-pc47:2.3.3": "punapariyāyena paribhuñjati, ",
  "pli-tv-bi-vb-pc47:2.3.4": "aññā utuniyo bhikkhuniyo na honti, ",
  "pli-tv-bi-vb-pc47:2.3.5": "acchinnacīvarikāya, ",
  "pli-tv-bi-vb-pc47:2.3.6": "naṭṭhacīvarikāya, ",
  "pli-tv-bi-vb-pc47:2.3.7": "āpadāsu, ",
  "pli-tv-bi-vb-pc47:2.3.8": "ummattikāya, ",
  "pli-tv-bi-vb-pc47:2.3.9": "ādikammikāyā 'ti. ||3||2|| ",
  "pli-tv-bi-vb-pc47:2.3.10": ""
}
