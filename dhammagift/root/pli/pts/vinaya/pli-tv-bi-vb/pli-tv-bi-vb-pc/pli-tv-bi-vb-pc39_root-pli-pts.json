{
  "pli-tv-bi-vb-pc39:0.1": "",
  "pli-tv-bi-vb-pc39:0.2": "",
  "pli-tv-bi-vb-pc39:0.3": "",
  "pli-tv-bi-vb-pc39:0.4": "",
  "pli-tv-bi-vb-pc39:0.5": "",
  "pli-tv-bi-vb-pc39:1.0": "",
  "pli-tv-bi-vb-pc39:1.1": "Tena samayena buddho bhagavā Rājagahe viharati Veḷuvane Kalandakanivāpe. ",
  "pli-tv-bi-vb-pc39:1.2": "tena kho pana samayena bhikkhuniyo antovassaṃ cārikaṃ caranti. ",
  "pli-tv-bi-vb-pc39:1.3": "manussā . . . vipācenti: ",
  "pli-tv-bi-vb-pc39:1.4": "kathaṃ hi nāma bhikkhuniyo . . . carissanti haritāni tiṇāni sammaddantā ekindriyaṃ jīvaṃ viheṭhentā bahū khuddake pāṇe saṃghātaṃ āpādentā 'ti. ",
  "pli-tv-bi-vb-pc39:1.5": "assosuṃ kho bhikkhuniyo tesaṃ manussānaṃ . . . vipācentānaṃ. ",
  "pli-tv-bi-vb-pc39:1.6": "yā tā bhikkhuniyo appicchā . . . vipācenti: ",
  "pli-tv-bi-vb-pc39:1.7": "kathaṃ hi nāma bhikkhuniyo . . . carissantīti --pa--. ",
  "pli-tv-bi-vb-pc39:1.8": "saccaṃ kira bhikkhave bhikkhuniyo . . . carantīti. ",
  "pli-tv-bi-vb-pc39:1.9": "saccaṃ bhagavā. ",
  "pli-tv-bi-vb-pc39:1.10": "vigarahi buddho bhagavā: kathaṃ ",
  "pli-tv-bi-vb-pc39:1.11": "hi nāma bhikkhave bhikkhuniyo . . . carissanti. ",
  "pli-tv-bi-vb-pc39:1.12": "n' etaṃ bhikkhave appasannānaṃ . . . ",
  "pli-tv-bi-vb-pc39:1.13": "uddisantu: ",
  "pli-tv-bi-vb-pc39:1.14.0": "",
  "pli-tv-bi-vb-pc39:1.14.1": "yā pana bhikkhunī antovassaṃ cārikaṃ careyya, pācittiyan ti. ||1|| ",
  "pli-tv-bi-vb-pc39:2.1.0": "",
  "pli-tv-bi-vb-pc39:2.1.1": "yā panā 'ti . . . ",
  "pli-tv-bi-vb-pc39:2.1.2": "",
  "pli-tv-bi-vb-pc39:2.1.3": "",
  "pli-tv-bi-vb-pc39:2.1.4": "adhippetā bhikkhunīti. ",
  "pli-tv-bi-vb-pc39:2.1.5": "antovassan ti ",
  "pli-tv-bi-vb-pc39:2.1.6": "purimaṃ vā temāsaṃ pacchimaṃ vā temāsaṃ avasitvā. ",
  "pli-tv-bi-vb-pc39:2.1.7": "cārikaṃ careyyā 'ti, ",
  "pli-tv-bi-vb-pc39:2.1.8": "kukkuṭasampāte gāme . . . (XXXVII. 2.1) . . . ",
  "pli-tv-bi-vb-pc39:2.1.9": "agāmake araññe . . . pācittiyassa. ||1|| ",
  "pli-tv-bi-vb-pc39:2.2.0": "",
  "pli-tv-bi-vb-pc39:2.2.1": "anāpatti ",
  "pli-tv-bi-vb-pc39:2.2.2": "sattāhakaraṇīyena gacchati, ",
  "pli-tv-bi-vb-pc39:2.2.3": "kenaci ubbāḷhā gacchati, ",
  "pli-tv-bi-vb-pc39:2.2.4": "āpadāsu, ",
  "pli-tv-bi-vb-pc39:2.2.5": "ummattikāya, ",
  "pli-tv-bi-vb-pc39:2.2.6": "ādikammikāyā ",
  "pli-tv-bi-vb-pc39:2.2.7": "'ti. ||2||2|| "
}
