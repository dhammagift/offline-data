  "pli-tv-bi-vb-pc96:0.4": "",
  "pli-tv-bi-vb-pc96:0.5": "",
  "pli-tv-bi-vb-pc96:1.0": "",
  "pli-tv-bi-vb-pc96:1.1": "Tena samayena buddho bhagavā Sāvatthiyaṃ viharati Jetavane Anāthapiṇḍikassa ārāme. ",
  "pli-tv-bi-vb-pc96:1.2": "tena kho pana samayena aññatarā bhikkhunī asaṃkacchikā gāmaṃ piṇḍāya pāvisi. ",
  "pli-tv-bi-vb-pc96:1.3": "tassā rathiyāya vātamaṇḍalikā saṃghāṭiyo ukkhipiṃsu. ",
  "pli-tv-bi-vb-pc96:1.4": "manussā ukkuṭṭhiṃ akaṃsu ",
  "pli-tv-bi-vb-pc96:1.5": "sundaro ayyāya tanutaro 'ti. ",
  "pli-tv-bi-vb-pc96:1.6": "sā bhikkhunī manussehi uppaṇḍiyamānā maṅku ahosi. ",
  "pli-tv-bi-vb-pc96:1.7": "atha kho sā bhikkhunī upassayaṃ gantvā bhikkhunīnaṃ etam atthaṃ ārocesi. ",
  "pli-tv-bi-vb-pc96:1.8": "yā tā bhikkhuniyo appicchā . . . vipācenti: ",
  "pli-tv-bi-vb-pc96:1.9": "kathaṃ hi nāma bhikkhunī asaṃkacchikā gāmaṃ pavisissatīti --pa--. ",
  "pli-tv-bi-vb-pc96:1.10": "saccaṃ kira bhikkhave . . . pāvisīti. ",
  "pli-tv-bi-vb-pc96:1.11": "saccaṃ bhagavā. ",
  "pli-tv-bi-vb-pc96:1.12": "vigarahi buddho bhagavā: kathaṃ ",
  "pli-tv-bi-vb-pc96:1.13": "hi nāma bhikkhave . . . pavisissati. ",
  "pli-tv-bi-vb-pc96:1.14": "n' etaṃ bhikkhave appasannānaṃ . . . ",
  "pli-tv-bi-vb-pc96:1.15": "uddisantu: ",
  "pli-tv-bi-vb-pc96:1.16.0": "",
  "pli-tv-bi-vb-pc96:1.16.1": "yā pana bhikkhunī asaṃkacchikā gāmaṃ paviseyya, pācittiyan ti. ||1|| ",
  "pli-tv-bi-vb-pc96:2.1.0": "",
  "pli-tv-bi-vb-pc96:2.1.1": "yā panā 'ti . . . ",
  "pli-tv-bi-vb-pc96:2.1.2": "",
  "pli-tv-bi-vb-pc96:2.1.3": "",
  "pli-tv-bi-vb-pc96:2.1.4": "adhippetā bhikkhunīti. ",
  "pli-tv-bi-vb-pc96:2.1.5": "asaṃkacchikā 'ti ",
  "pli-tv-bi-vb-pc96:2.1.6": "vinā saṃkacchikaṃ. ",
  "pli-tv-bi-vb-pc96:2.1.7": "saṃkacchikan nāma ",
  "pli-tv-bi-vb-pc96:2.1.8": "adhakkhakaṃ ubbhanābhi tassa paṭicchādanatthāya. ",
  "pli-tv-bi-vb-pc96:2.1.9": "gāmaṃ paviseyyā 'ti ",
  "pli-tv-bi-vb-pc96:2.1.10": "parikkhittassa gāmassa parikkhepaṃ atikkāmentiyā āpatti pācittiyassa. ",
  "pli-tv-bi-vb-pc96:2.1.11": "aparikkhittassa gāmassa upacāraṃ okkamantiyā āpatti pācittiyassa. ||1|| ",
  "pli-tv-bi-vb-pc96:2.2.0": "",
  "pli-tv-bi-vb-pc96:2.2.1": "anāpatti ",
  "pli-tv-bi-vb-pc96:2.2.2": "acchinnacīvarikāya, ",
  "pli-tv-bi-vb-pc96:2.2.3": "naṭṭhacīvarikāya, ",
  "pli-tv-bi-vb-pc96:2.2.4": "gilānāya, ",
  "pli-tv-bi-vb-pc96:2.2.5": "asatiyā, ",
  "pli-tv-bi-vb-pc96:2.2.6": "ajānantiyā, ",
  "pli-tv-bi-vb-pc96:2.2.7": "āpadāsu, ",
  "pli-tv-bi-vb-pc96:2.2.8": "ummattikāya, ",
  "pli-tv-bi-vb-pc96:2.2.9": "ādikammikāyā 'ti. ||2||2|| ",
  "pli-tv-bi-vb-pc96:2.2.10": "",
  "pli-tv-bi-vb-pc96:2.2.11": "",
  "pli-tv-bi-vb-pc96:2.2.12.0": "",
  "pli-tv-bi-vb-pc96:2.2.13.0": "",
  "pli-tv-bi-vb-pc96:2.2.14": "uddiṭṭhā kho ayyāyo chasaṭṭhisatā pācittiyā dhammā. ",
  "pli-tv-bi-vb-pc96:2.2.15": "tatth' ayyāyo pucchāmi: ",
  "pli-tv-bi-vb-pc96:2.2.16": "kacci 'ttha parisuddhā. ",
  "pli-tv-bi-vb-pc96:2.2.17": "dutiyam pi pucchāmi: ",
  "pli-tv-bi-vb-pc96:2.2.18": "kacci 'ttha parisuddhā. ",
  "pli-tv-bi-vb-pc96:2.2.19": "tatiyam pi pucchāmi: ",
  "pli-tv-bi-vb-pc96:2.2.20": "kacci 'ttha parisuddhā. ",
  "pli-tv-bi-vb-pc96:2.2.21": "parisuddh' etth' ayyāyo, tasmā tuṇhī, evam etaṃ dhārayāmīti. ",
  "pli-tv-bi-vb-pc96:2.2.22": "khuddakaṃ ",
  "pli-tv-bi-vb-pc96:2.2.23": "niṭṭhitaṃ. ",
  "pli-tv-bi-vb-pc96:2.2.24": ""
}
