  "pli-tv-bi-vb-pc82:1.0": "",
  "pli-tv-bi-vb-pc82:1.1": "Tena samayena buddho bhagavā Sāvatthiyaṃ viharati Jetavane Anāthapiṇḍikassa ārāme. ",
  "pli-tv-bi-vb-pc82:1.2": "tena kho pana samayena bhikkhuniyo anuvassaṃ vuṭṭhāpenti, upassayo na sammati. ",
  "pli-tv-bi-vb-pc82:1.3": "manussā . . . vipācenti: ",
  "pli-tv-bi-vb-pc82:1.4": "kathaṃ hi nāma bhikkhuniyo anuvassaṃ vuṭṭhāpessanti, upassayo na sammatīti. ",
  "pli-tv-bi-vb-pc82:1.5": "assosuṃ kho bhikkhuniyo tesaṃ manussānaṃ . . . vipācentānaṃ. ",
  "pli-tv-bi-vb-pc82:1.6": "yā tā bhikkhuniyo appicchā . . . vipācenti: ",
  "pli-tv-bi-vb-pc82:1.7": "kathaṃ hi nāma bhikkhuniyo anuvassaṃ vuṭṭhāpessantīti --pa--. ",
  "pli-tv-bi-vb-pc82:1.8": "saccaṃ kira bhikkhave bhikkhuniyo anuvassaṃ vuṭṭhāpentīti. ",
  "pli-tv-bi-vb-pc82:1.9": "saccaṃ bhagavā. ",
  "pli-tv-bi-vb-pc82:1.10": "vigarahi buddho bhagavā: kathaṃ ",
  "pli-tv-bi-vb-pc82:1.11": "hi nāma bhikkhave . . . vuṭṭhāpessanti. ",
  "pli-tv-bi-vb-pc82:1.12": "n' etaṃ bhikkhave appasannānaṃ . . . ",
  "pli-tv-bi-vb-pc82:1.13": "uddisantu: ",
  "pli-tv-bi-vb-pc82:1.14.0": "",
  "pli-tv-bi-vb-pc82:1.14.1": "yā pana bhikkhunī anuvassaṃ vuṭṭhāpeyya, pācittiyan ti. ||1|| ",
  "pli-tv-bi-vb-pc82:2.1.0": "",
  "pli-tv-bi-vb-pc82:2.1.1": "yā panā 'ti . . . ",
  "pli-tv-bi-vb-pc82:2.1.2": "",
  "pli-tv-bi-vb-pc82:2.1.3": "",
  "pli-tv-bi-vb-pc82:2.1.4": "adhippetā bhikkhunīti. ",
  "pli-tv-bi-vb-pc82:2.1.5": "anuvassan ti ",
  "pli-tv-bi-vb-pc82:2.1.6": "anusaṃvaccharaṃ. ",
  "pli-tv-bi-vb-pc82:2.1.7": "vuṭṭhāpeyyā 'ti . . . ",
  "pli-tv-bi-vb-pc82:2.1.8": "",
  "pli-tv-bi-vb-pc82:2.1.9": "",
  "pli-tv-bi-vb-pc82:2.1.10": "",
  "pli-tv-bi-vb-pc82:2.1.11": "",
  "pli-tv-bi-vb-pc82:2.1.12": "",
  "pli-tv-bi-vb-pc82:2.1.13": "ācariniyā ca āpatti dukkaṭassa. ||1|| ",
  "pli-tv-bi-vb-pc82:2.2.0": "",
  "pli-tv-bi-vb-pc82:2.2.1": "anāpatti ",
  "pli-tv-bi-vb-pc82:2.2.2": "ekantarikaṃ vuṭṭhāpeti, ",
  "pli-tv-bi-vb-pc82:2.2.3": "ummattikāya, ",
  "pli-tv-bi-vb-pc82:2.2.4": "ādikammikāyā ",
  "pli-tv-bi-vb-pc82:2.2.5": "'ti. ||2||2|| "
}
