{
  "pli-tv-bi-vb-pc61:0.1": "",
  "pli-tv-bi-vb-pc61:0.2": "",
  "pli-tv-bi-vb-pc61:0.3": "",
  "pli-tv-bi-vb-pc61:0.4": "",
  "pli-tv-bi-vb-pc61:0.5": "",
  "pli-tv-bi-vb-pc61:1.0": "",
  "pli-tv-bi-vb-pc61:1.1": "Tena samayena buddho bhagavā Sāvatthiyaṃ viharati Jetavane Anāthapiṇḍikassa ārāme. ",
  "pli-tv-bi-vb-pc61:1.2": "tena kho pana samayena bhikkhuniyo gabbhiniṃ vuṭṭhāpenti. ",
  "pli-tv-bi-vb-pc61:1.3": "sā piṇḍāya carati. ",
  "pli-tv-bi-vb-pc61:1.4": "manussā evam āhaṃsu: ",
  "pli-tv-bi-vb-pc61:1.5": "deth' ayyāya bhikkhaṃ, garubhārā ayyā 'ti. ",
  "pli-tv-bi-vb-pc61:1.6": "manussā . . . vipācenti: ",
  "pli-tv-bi-vb-pc61:1.7": "kathaṃ hi nāma bhikkhuniyo gabbhiniṃ vuṭṭhāpessantīti. ",
  "pli-tv-bi-vb-pc61:1.8": "assosuṃ kho bhikkhuniyo tesaṃ manussānaṃ . . . vipācentānaṃ. ",
  "pli-tv-bi-vb-pc61:1.9": "yā tā bhikkhuniyo appicchā . . . vipācenti: ",
  "pli-tv-bi-vb-pc61:1.10": "kathaṃ hi nāma bhikkhuniyo gabbhiniṃ vuṭṭhāpessantīti --pa--. ",
  "pli-tv-bi-vb-pc61:1.11": "saccaṃ kira bhikkhave . . . vuṭṭhāpentīti. ",
  "pli-tv-bi-vb-pc61:1.12": "saccaṃ bhagavā. ",
  "pli-tv-bi-vb-pc61:1.13": "vigarahi buddho bhagavā: kathaṃ ",
  "pli-tv-bi-vb-pc61:1.14": "hi nāma bhikkhave . . . vuṭṭhāpessantīti. ",
  "pli-tv-bi-vb-pc61:1.15": "n' etaṃ bhikkhave appasannānaṃ . . . ",
  "pli-tv-bi-vb-pc61:1.16": "uddisantu: ",
  "pli-tv-bi-vb-pc61:1.17.0": "",
  "pli-tv-bi-vb-pc61:1.17.1": "yā pana bhikkhunī gabbhiniṃ vuṭṭhāpeyya, pācittiyan ti. ||1|| ",
  "pli-tv-bi-vb-pc61:2.1.0": "",
  "pli-tv-bi-vb-pc61:2.1.1": "yā panā 'ti . . . ",
  "pli-tv-bi-vb-pc61:2.1.2": "",
  "pli-tv-bi-vb-pc61:2.1.3": "",
  "pli-tv-bi-vb-pc61:2.1.4": "adhippetā bhikkhunīti. ",
  "pli-tv-bi-vb-pc61:2.1.5": "gabbhinī nāma ",
  "pli-tv-bi-vb-pc61:2.1.6": "āpannasattā vuccati. ",
  "pli-tv-bi-vb-pc61:2.1.7": "vuṭṭhāpeyyā 'ti ",
  "pli-tv-bi-vb-pc61:2.1.8": "upasampādeyya. ",
  "pli-tv-bi-vb-pc61:2.1.9": "vuṭṭhāpessāmīti gaṇaṃ vā ācariniṃ vā pattaṃ vā cīvaraṃ vā pariyesati sīmaṃ vā sammannati, āpatti dukkaṭassa. ",
  "pli-tv-bi-vb-pc61:2.1.10": "ñattiyā dukkaṭaṃ, ",
  "pli-tv-bi-vb-pc61:2.1.11": "dvīhi kammavācāhi dukkaṭā, ",
  "pli-tv-bi-vb-pc61:2.1.12": "kammavācāpariyosāne upajjhāyāya āpatti pācittiyassa, ",
  "pli-tv-bi-vb-pc61:2.1.13": "gaṇassa ca ācariniyā ca āpatti dukkaṭassa. ||1|| ",
  "pli-tv-bi-vb-pc61:2.2.0": "",
  "pli-tv-bi-vb-pc61:2.2.1": "gabbhiniyā gabbhinīsaññā vuṭṭhāpeti, āpatti pācittiyassa. ",
  "pli-tv-bi-vb-pc61:2.2.2": "gabbhiniyā vematikā vuṭṭhāpeti, āpatti dukkaṭassa. ",
  "pli-tv-bi-vb-pc61:2.2.3": "gabbhiniyā agabbhinīsaññā vuṭṭhāpeti, anāpatti. ",
  "pli-tv-bi-vb-pc61:2.2.4": "agabbhiniyā gabbhinīsaññā, āpatti dukkaṭassa. ",
  "pli-tv-bi-vb-pc61:2.2.5": "agabbhiniyā vematikā, āpatti dukkaṭassa. ",
  "pli-tv-bi-vb-pc61:2.2.6": "agabbhiniyā agabbhinīsaññā, anāpatti. ||2|| ",
  "pli-tv-bi-vb-pc61:2.3.0": "",
  "pli-tv-bi-vb-pc61:2.3.1": "anāpatti ",
  "pli-tv-bi-vb-pc61:2.3.2": "gabbhiniṃ agabbhinīsaññā vuṭṭhāpeti, ",
  "pli-tv-bi-vb-pc61:2.3.3": "agabbhiniṃ agabbhinīsaññā vuṭṭhāpeti, ",
  "pli-tv-bi-vb-pc61:2.3.4": "ummattikāya, ",
  "pli-tv-bi-vb-pc61:2.3.5": "ādikammikāyā ",
  "pli-tv-bi-vb-pc61:2.3.6": "'ti. ||3||2|| "
}
