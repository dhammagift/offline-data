  "pli-tv-bi-vb-pc73:2.27": "(LXIII.2) . . . ",
  "pli-tv-bi-vb-pc73:2.28.0": "",
  "pli-tv-bi-vb-pc73:2.28.1": "anāpatti ",
  "pli-tv-bi-vb-pc73:2.29": "paripuṇṇavīsativassaṃ kumāribhūtaṃ dve vassāni chasu dhammesu sikkhitasikkhaṃ saṃghena sammataṃ vuṭṭhāpeti, ",
  "pli-tv-bi-vb-pc73:2.30": "ummattikāya, ",
  "pli-tv-bi-vb-pc73:2.31": "ādikammikāyā 'ti. ||2|| ",
