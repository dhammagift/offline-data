  "pli-tv-bi-vb-pc73:1.34": "bhikkhuniyo . . . (LXVII.1. Instead of ",
  "pli-tv-bi-vb-pc73:1.35": "paripuṇṇadvādasavgihig- read paripuṇṇavīsativ- kumāribh-) . . . uddisantu: ",
  "pli-tv-bi-vb-pc73:1.36.0": "",
  "pli-tv-bi-vb-pc73:1.36.1": "yā pana bhikkhunī paripuṇṇavīsativassaṃ kumāribhūtaṃ dve vassāni chasu dhammesu sikkhitasikkhaṃ saṃghena asammataṃ vuṭṭhāpeyya, pācittiyan ti. ||1|| ",
  "pli-tv-bi-vb-pc73:2.0": "",
  "pli-tv-bi-vb-pc73:2.1": "yā panā 'ti . . . ",
  "pli-tv-bi-vb-pc73:2.2": "",
  "pli-tv-bi-vb-pc73:2.3": "",
  "pli-tv-bi-vb-pc73:2.4": "adhippetā bhikkhunīti. ",
  "pli-tv-bi-vb-pc73:2.5": "paripuṇṇavīsativassā nāma ",
  "pli-tv-bi-vb-pc73:2.6": "pattavīsativassā. ",
  "pli-tv-bi-vb-pc73:2.7": "kumāribhūtā nāma ",
  "pli-tv-bi-vb-pc73:2.8": "sāmaṇerī vuccati. ",
  "pli-tv-bi-vb-pc73:2.9": "dve vassānīti ",
  "pli-tv-bi-vb-pc73:2.10": "dve saṃvaccharāni. ",
  "pli-tv-bi-vb-pc73:2.11": "sikkhitasikkhā nāma ",
  "pli-tv-bi-vb-pc73:2.12": "chasu dhammesu sikkhitasikkhā. ",
  "pli-tv-bi-vb-pc73:2.13": "asammatā nāma ",
  "pli-tv-bi-vb-pc73:2.14": "ñattidutiyena kammena vuṭṭhānasammuti na dinnā hoti. ",
  "pli-tv-bi-vb-pc73:2.15": "vuṭṭhāpeyyā 'ti . . . ",
