  "pli-tv-bi-vb-pc79:1.0": "",
  "pli-tv-bi-vb-pc79:1.1": "Tena samayena buddho bhagavā Sāvatthiyaṃ viharati Jetavane Anāthapiṇḍikassa ārāme. ",
  "pli-tv-bi-vb-pc79:1.2": "tena kho pana samayena Thullanandā bhikkhunī purisasaṃsaṭṭhaṃ kumārakasaṃsaṭṭhaṃ caṇḍiṃ sokāvāsaṃ Caṇḍakāliṃ sikkhamānaṃ vuṭṭhāpeti. ",
  "pli-tv-bi-vb-pc79:1.3": "yā tā bhikkhuniyo appicchā . . . vipācenti: ",
  "pli-tv-bi-vb-pc79:1.4": "kathaṃ hi nāma ayyā Thullanandā purisasaṃsaṭṭhaṃ . . . vuṭṭhāpessatīti --pa--. ",
  "pli-tv-bi-vb-pc79:1.5": "saccaṃ kira bhikkhave Thullanandā bhikkhunī purisasaṃsaṭṭhaṃ . . . vuṭṭhāpesīti. ",
  "pli-tv-bi-vb-pc79:1.6": "saccaṃ bhagavā. ",
  "pli-tv-bi-vb-pc79:1.7": "vigarahi buddho bhagavā: kathaṃ ",
  "pli-tv-bi-vb-pc79:1.8": "hi nāma bhikkhave Thullanandā bhikkhunī purisasaṃsaṭṭhaṃ x . . . vuṭṭhāpessati. ",
  "pli-tv-bi-vb-pc79:1.9": "n' etaṃ bhikkhave appasannānaṃ . . . ",
  "pli-tv-bi-vb-pc79:1.10": "uddisantu: ",
  "pli-tv-bi-vb-pc79:1.11.0": "",
  "pli-tv-bi-vb-pc79:1.11.1": "yā pana bhikkhunī purisasaṃsaṭṭhaṃ kumārakasaṃsaṭṭhaṃ caṇḍiṃ sokāvāsaṃ sikkhamānaṃ vuṭṭhāpeyya, pācittiyan ti. ||1|| ",
  "pli-tv-bi-vb-pc79:2.1.0": "",
  "pli-tv-bi-vb-pc79:2.1.1": "yā panā 'ti . . . ",
  "pli-tv-bi-vb-pc79:2.1.2": "",
  "pli-tv-bi-vb-pc79:2.1.3": "",
  "pli-tv-bi-vb-pc79:2.1.4": "adhippetā bhikkhunīti. ",
  "pli-tv-bi-vb-pc79:2.1.5": "puriso nāma ",
  "pli-tv-bi-vb-pc79:2.1.6": "pattavīsativasso. ",
  "pli-tv-bi-vb-pc79:2.1.7": "kumārako nāma ",
  "pli-tv-bi-vb-pc79:2.1.8": "appattavīsativasso. ",
  "pli-tv-bi-vb-pc79:2.1.9": "saṃsaṭṭhā nāma ",
  "pli-tv-bi-vb-pc79:2.1.10": "ananulomikena kāyikavācasikena saṃsaṭṭhā. ",
  "pli-tv-bi-vb-pc79:2.1.11": "caṇḍī nāma ",
  "pli-tv-bi-vb-pc79:2.1.12": "kodhanā vuccati. ",
  "pli-tv-bi-vb-pc79:2.1.13": "sokāvāsā nāma ",
  "pli-tv-bi-vb-pc79:2.1.14": "paresaṃ dukkhaṃ uppādeti sokaṃ āvisati. ",
  "pli-tv-bi-vb-pc79:2.1.15": "sikkhamānā nāma ",
  "pli-tv-bi-vb-pc79:2.1.16": "dve vassāni chasu dhammesu sikkhitasikkhā. ",
  "pli-tv-bi-vb-pc79:2.1.17": "vuṭṭhāpeyyā 'ti . . . ",
  "pli-tv-bi-vb-pc79:2.1.18": "",
  "pli-tv-bi-vb-pc79:2.1.19": "",
  "pli-tv-bi-vb-pc79:2.1.20": "",
  "pli-tv-bi-vb-pc79:2.1.21": "",
  "pli-tv-bi-vb-pc79:2.1.22": "",
  "pli-tv-bi-vb-pc79:2.1.23": "(LXI.2) . . . ācariniyā ca āpatti dukkaṭassa. ||1|| ",
  "pli-tv-bi-vb-pc79:2.2.0": "",
  "pli-tv-bi-vb-pc79:2.2.1": "anāpatti ",
  "pli-tv-bi-vb-pc79:2.2.2": "ajānantī vuṭṭhāpeti, ",
  "pli-tv-bi-vb-pc79:2.2.3": "ummattikāya, ",
  "pli-tv-bi-vb-pc79:2.2.4": "ādikammikāyā ",
  "pli-tv-bi-vb-pc79:2.2.5": "'ti. ||2||2|| "
}
