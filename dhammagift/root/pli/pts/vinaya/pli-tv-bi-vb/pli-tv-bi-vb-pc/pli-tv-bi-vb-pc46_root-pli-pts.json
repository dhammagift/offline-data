  "pli-tv-bi-vb-pc46:1.11": "",
  "pli-tv-bi-vb-pc46:1.12": "[dassati]) . . . ",
  "pli-tv-bi-vb-pc46:1.13": "",
  "pli-tv-bi-vb-pc46:1.14": "uddisantu: ",
  "pli-tv-bi-vb-pc46:1.15.0": "",
  "pli-tv-bi-vb-pc46:1.15.1": "yā pana bhikkhunī agārikassa vā paribbājakassa vā paribbājikāya vā sahatthā khādaniyaṃ vā bhojaniyaṃ vā dadeyya, pācittiyan ti. ||1|| ",
  "pli-tv-bi-vb-pc46:2.1.0": "",
  "pli-tv-bi-vb-pc46:2.1.1": "yā panā 'ti . . . ",
  "pli-tv-bi-vb-pc46:2.1.2": "",
  "pli-tv-bi-vb-pc46:2.1.3": "",
  "pli-tv-bi-vb-pc46:2.1.4": "adhippetā bhikkhunī. ",
  "pli-tv-bi-vb-pc46:2.1.5": "agāriko nāma . . . ",
  "pli-tv-bi-vb-pc46:2.1.6": "(XXVIII.2) . . . ",
  "pli-tv-bi-vb-pc46:2.1.7": "",
  "pli-tv-bi-vb-pc46:2.1.8": "",
  "pli-tv-bi-vb-pc46:2.1.9": "",
  "pli-tv-bi-vb-pc46:2.1.10": "paribbājikasamāpannā. ",
  "pli-tv-bi-vb-pc46:2.1.11": "khādaniyaṃ nāma ",
  "pli-tv-bi-vb-pc46:2.1.12": "pañca bhojanāni ",
  "pli-tv-bi-vb-pc46:2.1.13": "udakadantapoṇaṃ ṭhapetvā avasesaṃ khādaniyaṃ nāma. ",
  "pli-tv-bi-vb-pc46:2.1.14": "bhojaniyaṃ nāma ",
  "pli-tv-bi-vb-pc46:2.1.15": "pañca bhojanāni . . . maṃsaṃ. ",
  "pli-tv-bi-vb-pc46:2.1.16": "dadeyyā 'ti ",
  "pli-tv-bi-vb-pc46:2.1.17": "kāyena vā kāyapaṭibaddhena vā nissaggiyena vā deti, āpatti pācittiyassa. ",
  "pli-tv-bi-vb-pc46:2.1.18": "udakadantapoṇaṃ deti, āpatti dukkaṭassa. ||1|| ",
  "pli-tv-bi-vb-pc46:2.2.0": "",
  "pli-tv-bi-vb-pc46:2.2.1": "anāpatti ",
  "pli-tv-bi-vb-pc46:2.2.2": "dāpeti na deti, ",
  "pli-tv-bi-vb-pc46:2.2.3": "upanikkhipitvā deti, ",
  "pli-tv-bi-vb-pc46:2.2.4": "bāhiralepaṃ deti, ",
  "pli-tv-bi-vb-pc46:2.2.5": "ummattikāya, ",
  "pli-tv-bi-vb-pc46:2.2.6": "ādikammikāyā ",
  "pli-tv-bi-vb-pc46:2.2.7": "'ti. ||2||2|| "
}
