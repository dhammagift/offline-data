  "pli-tv-bi-vb-pc88:1.0": "",
  "pli-tv-bi-vb-pc88:1.1": "Tena samayena buddho bhagavā Sāvatthiyaṃ viharati Jetavane Anāthapiṇḍikassa ārāme. ",
  "pli-tv-bi-vb-pc88:1.2": "tena kho pana samayena chabbaggiyā bhikkhuniyo gandhavaṇṇakena nhāyanti. ",
  "pli-tv-bi-vb-pc88:1.3": "manussā . . . (see LXXXVII.1; ",
  "pli-tv-bi-vb-pc88:1.4": "read gandhavaṇṇakena nhāyissanti, ",
  "pli-tv-bi-vb-pc88:1.5": "",
  "pli-tv-bi-vb-pc88:1.6": "",
  "pli-tv-bi-vb-pc88:1.7": "",
  "pli-tv-bi-vb-pc88:1.8": "etc.) . . . ",
  "pli-tv-bi-vb-pc88:1.9": "",
  "pli-tv-bi-vb-pc88:1.10": "",
  "pli-tv-bi-vb-pc88:1.11": "",
  "pli-tv-bi-vb-pc88:1.12": "",
  "pli-tv-bi-vb-pc88:1.13": "uddisantu: ",
  "pli-tv-bi-vb-pc88:1.14.0": "",
  "pli-tv-bi-vb-pc88:1.14.1": "yā pana bhikkhunī gandhavaṇṇakena nhāyeyya, pācittiyan ti. ||1|| ",
  "pli-tv-bi-vb-pc88:2.1.0": "",
  "pli-tv-bi-vb-pc88:2.1.1": "yā panā 'ti . . . ",
  "pli-tv-bi-vb-pc88:2.1.2": "",
  "pli-tv-bi-vb-pc88:2.1.3": "",
  "pli-tv-bi-vb-pc88:2.1.4": "adhippetā bhikkhunīti. ",
  "pli-tv-bi-vb-pc88:2.1.5": "gandho nāma ",
  "pli-tv-bi-vb-pc88:2.1.6": "yo koci gandho. ",
  "pli-tv-bi-vb-pc88:2.1.7": "vaṇṇakan nāma ",
  "pli-tv-bi-vb-pc88:2.1.8": "yaṃ kiñci vaṇṇakaṃ. ",
  "pli-tv-bi-vb-pc88:2.1.9": "nhāyeyyā 'ti ",
  "pli-tv-bi-vb-pc88:2.1.10": "nhāyati, payoge dukkaṭaṃ, nhānapariyosāne āpatti pācittiyassa. ||1|| ",
  "pli-tv-bi-vb-pc88:2.2.0": "",
  "pli-tv-bi-vb-pc88:2.2.1": "anāpatti ",
  "pli-tv-bi-vb-pc88:2.2.2": "ābādhapaccayā, ",
  "pli-tv-bi-vb-pc88:2.2.3": "ummattikāya, ",
  "pli-tv-bi-vb-pc88:2.2.4": "ādikammikāyā ",
  "pli-tv-bi-vb-pc88:2.2.5": "'ti. ||2||2|| "
}
