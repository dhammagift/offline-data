{
  "pli-tv-bi-vb-pc65:0.1": "",
  "pli-tv-bi-vb-pc65:0.2": "",
  "pli-tv-bi-vb-pc65:0.3": "",
  "pli-tv-bi-vb-pc65:0.4": "",
  "pli-tv-bi-vb-pc65:0.5": "",
  "pli-tv-bi-vb-pc65:1.0": "",
  "pli-tv-bi-vb-pc65:1.1": "Tena samayena buddho bhagavā Sāvatthiyaṃ viharati Jetavane Anāthapiṇḍikassa ārāme. ",
  "pli-tv-bi-vb-pc65:1.2": "tena kho pana samayena bhikkhuniyo ūnadvādasavassaṃ gihigataṃ vuṭṭhāpenti, ",
  "pli-tv-bi-vb-pc65:1.3": "tā akkhamā honti sītassa uṇhassa jighacchāya pipāsāya ḍaṃsamakasavātātapasiriṃsapasamphassānaṃ duruttānaṃ durāgatānaṃ vacanapathānaṃ ",
  "pli-tv-bi-vb-pc65:1.4": "uppannānaṃ sārīrikānaṃ vedanānaṃ dukkhānaṃ tibbānaṃ kharānaṃ kaṭukānaṃ asātānaṃ amanāpānaṃ pāṇaharānaṃ anadhivāsakajātikā honti. ",
  "pli-tv-bi-vb-pc65:1.5": "yā tā bhikkhuniyo appicchā . . . vipācenti: ",
  "pli-tv-bi-vb-pc65:1.6": "kathaṃ hi nāma bhikkhuniyo ūnadvādasavassaṃ gihigataṃ vuṭṭhāpessantīti --pa--. ",
  "pli-tv-bi-vb-pc65:1.7": "saccaṃ kira bhikkhave bhikkhuniyo . . . vuṭṭhāpentīti. ",
  "pli-tv-bi-vb-pc65:1.8": "saccaṃ bhagavā. ",
  "pli-tv-bi-vb-pc65:1.9": "vigarahi buddho bhagavā: kathaṃ ",
  "pli-tv-bi-vb-pc65:1.10": "hi nāma bhikkhave bhikkhuniyo . . . vuṭṭhāpessanti. ",
  "pli-tv-bi-vb-pc65:1.11": "ūnadvādasavassā bhikkhave gihigatā akkhamā hoti sītassa . . . ",
  "pli-tv-bi-vb-pc65:1.12": "anadhivāsakajātikā hoti. ",
  "pli-tv-bi-vb-pc65:1.13": "dvādasavassā ca kho bhikkhave gihigatā khamā hoti sītassa . . . ",
  "pli-tv-bi-vb-pc65:1.14": "adhivāsakajātikā hoti. ",
  "pli-tv-bi-vb-pc65:1.15": "n' etaṃ bhikkhave appasannānaṃ . . . ",
  "pli-tv-bi-vb-pc65:1.16": "uddisantu: ",
  "pli-tv-bi-vb-pc65:1.17.0": "",
  "pli-tv-bi-vb-pc65:1.17.1": "yā pana bhikkhunī ūnadvādasavassaṃ gihigataṃ vuṭṭhāpeyya, pācittiyan ti. ||1|| ",
  "pli-tv-bi-vb-pc65:2.1.0": "",
  "pli-tv-bi-vb-pc65:2.1.1": "yā panā 'ti . . . ",
  "pli-tv-bi-vb-pc65:2.1.2": "",
  "pli-tv-bi-vb-pc65:2.1.3": "",
  "pli-tv-bi-vb-pc65:2.1.4": "adhippetā bhikkhunīti. ",
  "pli-tv-bi-vb-pc65:2.1.5": "ūnadvādasavassā nāma ",
  "pli-tv-bi-vb-pc65:2.1.6": "appattadvādasavassā. ",
  "pli-tv-bi-vb-pc65:2.1.7": "gihigatā nāma ",
  "pli-tv-bi-vb-pc65:2.1.8": "purisantaragatā vuccati. ",
  "pli-tv-bi-vb-pc65:2.1.9": "vuṭṭhāpeyyā 'ti . . . ",
  "pli-tv-bi-vb-pc65:2.1.10": "",
  "pli-tv-bi-vb-pc65:2.1.11": "",
  "pli-tv-bi-vb-pc65:2.1.12": "",
  "pli-tv-bi-vb-pc65:2.1.13": "",
  "pli-tv-bi-vb-pc65:2.1.14": "",
  "pli-tv-bi-vb-pc65:2.1.15": "(LXI.2.1) . . . ācariniyā ca āpatti dukkaṭassa. ||1|| ",
  "pli-tv-bi-vb-pc65:2.2.0": "",
  "pli-tv-bi-vb-pc65:2.2.1": "ūnadvādasavassāya ūnadvādasavassasaññā vuṭṭhāpeti, āpatti pācittiyassa. ",
  "pli-tv-bi-vb-pc65:2.2.2": "ūnovematikā vuṭṭhāpeti, āpatti dukkaṭassa. ",
  "pli-tv-bi-vb-pc65:2.2.3": "ūnoparipuṇṇasaññā vuṭṭhāpeti, anāpatti. ",
  "pli-tv-bi-vb-pc65:2.2.4": "paripuṇṇadvādasavassāya ūnadvādasavassasaññā, āpatti dukkaṭassa. ",
  "pli-tv-bi-vb-pc65:2.2.5": "paro vematikā, āpatti dukkaṭassa. ",
  "pli-tv-bi-vb-pc65:2.2.6": "paro paripuṇṇasaññā, anāpatti. ||2|| ",
  "pli-tv-bi-vb-pc65:2.3.0": "",
  "pli-tv-bi-vb-pc65:2.3.1": "anāpatti ",
  "pli-tv-bi-vb-pc65:2.3.2": "ūnadvādasavassaṃ paripuṇṇasaññā vuṭṭhāpeti, ",
  "pli-tv-bi-vb-pc65:2.3.3": "paripuṇṇadvādasavassaṃ paripuṇṇasaññā vuṭṭhāpeti, ",
  "pli-tv-bi-vb-pc65:2.3.4": "ummattikāya, ",
  "pli-tv-bi-vb-pc65:2.3.5": "ādikammikāyā ",
  "pli-tv-bi-vb-pc65:2.3.6": "'ti. ||3||2|| "
}
