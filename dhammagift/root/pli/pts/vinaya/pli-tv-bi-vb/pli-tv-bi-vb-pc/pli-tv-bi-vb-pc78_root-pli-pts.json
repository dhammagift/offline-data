  "pli-tv-bi-vb-pc78:1.15": "uddisantu: ",
  "pli-tv-bi-vb-pc78:1.16.0": "",
  "pli-tv-bi-vb-pc78:1.16.1": "yā pana bhikkhunī sikkhamānaṃ sace maṃ tvaṃ ayye dve vassāni anubandhissasi evāhan taṃ vuṭṭhāpessāmīti vatvā sā pacchā anantarāyikinī n' eva vuṭṭhāpeyya na vuṭṭhāpanāya ussukkaṃ kareyya, pācittiyan ti. ||1|| ",
  "pli-tv-bi-vb-pc78:2.0": "",
  "pli-tv-bi-vb-pc78:2.1": "yā panā 'ti . . . ",
  "pli-tv-bi-vb-pc78:2.2": "",
  "pli-tv-bi-vb-pc78:2.3": "",
  "pli-tv-bi-vb-pc78:2.4": "adhippetā bhikkhunīti. ",
  "pli-tv-bi-vb-pc78:2.5": "sikkhamānā nāma ",
  "pli-tv-bi-vb-pc78:2.6": "dve vassāni chasu dhammesu sikkhitasikkhā. ",
  "pli-tv-bi-vb-pc78:2.7": "sace maṃ tvaṃ ayye dve vassāni anubandhissasīti ",
  "pli-tv-bi-vb-pc78:2.8": "dve saṃvaccharāni upaṭṭhahissasi. ",
  "pli-tv-bi-vb-pc78:2.9": "evāhan taṃ vuṭṭhāpessāmīti ",
  "pli-tv-bi-vb-pc78:2.10": "evāhan taṃ upasampādessāmi. ",
  "pli-tv-bi-vb-pc78:2.11": "sā pacchā . . . (LXXVII.2) . . . ",
