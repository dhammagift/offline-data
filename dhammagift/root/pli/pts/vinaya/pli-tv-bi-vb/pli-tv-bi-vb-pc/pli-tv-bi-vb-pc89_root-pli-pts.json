  "pli-tv-bi-vb-pc89:1.0": "",
  "pli-tv-bi-vb-pc89:1.1": "Tena samayena buddho bhagavā Sāvatthiyaṃ viharati Jetavane Anāthapiṇḍikassa ārāme. ",
  "pli-tv-bi-vb-pc89:1.2": "tena kho pana samayena chabbaggiyā bhikkhuniyo vāsitakena piññākena nhāyanti. ",
  "pli-tv-bi-vb-pc89:1.3": "manussā . . . (see LXXXVII.1; ",
  "pli-tv-bi-vb-pc89:1.4": "read vāsitakena nhāyissanti, ",
  "pli-tv-bi-vb-pc89:1.5": "",
  "pli-tv-bi-vb-pc89:1.6": "",
  "pli-tv-bi-vb-pc89:1.7": "",
  "pli-tv-bi-vb-pc89:1.8": "etc.) . . . ",
  "pli-tv-bi-vb-pc89:1.9": "",
  "pli-tv-bi-vb-pc89:1.10": "",
  "pli-tv-bi-vb-pc89:1.11": "",
  "pli-tv-bi-vb-pc89:1.12": "",
  "pli-tv-bi-vb-pc89:1.13": "uddisantu: ",
  "pli-tv-bi-vb-pc89:1.14.0": "",
  "pli-tv-bi-vb-pc89:1.14.1": "yā pana bhikkhunī vāsitakena piññākena nhāyeyya, pācittiyan ti. ||1|| ",
  "pli-tv-bi-vb-pc89:2.1.0": "",
  "pli-tv-bi-vb-pc89:2.1.1": "yā panā 'ti . . . ",
  "pli-tv-bi-vb-pc89:2.1.2": "",
  "pli-tv-bi-vb-pc89:2.1.3": "",
  "pli-tv-bi-vb-pc89:2.1.4": "adhippetā bhikkhunīti. vāsitakan nāma yaṃ kiñci ",
  "pli-tv-bi-vb-pc89:2.1.5": "vāsitakaṃ. ",
  "pli-tv-bi-vb-pc89:2.1.6": "",
  "pli-tv-bi-vb-pc89:2.1.7": "piññākaṃ nāma ",
  "pli-tv-bi-vb-pc89:2.1.8": "tilapiṭṭhaṃ vuccati. ",
  "pli-tv-bi-vb-pc89:2.1.9": "nhāyeyyā 'ti ",
  "pli-tv-bi-vb-pc89:2.1.10": "nhāyati, payoge dukkaṭaṃ, nhānapariyosāne āpatti pācittiyassa. ||1|| ",
  "pli-tv-bi-vb-pc89:2.2.0": "",
  "pli-tv-bi-vb-pc89:2.2.1": "anāpatti ",
  "pli-tv-bi-vb-pc89:2.2.2": "ābādhapaccayā, ",
  "pli-tv-bi-vb-pc89:2.2.3": "pakatipiññākena nhāyati, ",
  "pli-tv-bi-vb-pc89:2.2.4": "ummattikāya, ",
  "pli-tv-bi-vb-pc89:2.2.5": "ādikammikāyā ",
  "pli-tv-bi-vb-pc89:2.2.6": "'ti. ||2||2|| "
}
