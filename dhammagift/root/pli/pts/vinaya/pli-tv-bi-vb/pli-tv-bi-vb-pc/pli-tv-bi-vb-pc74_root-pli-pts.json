  "pli-tv-bi-vb-pc74:1.0": "",
  "pli-tv-bi-vb-pc74:1.1": "Tena samayena buddho bhagavā Sāvatthiyaṃ viharati Jetavane Anāthapiṇḍikassa ārāme. ",
  "pli-tv-bi-vb-pc74:1.2": "tena kho pana samayena bhikkhuniyo ūnadvādasavassā vuṭṭhāpenti, ",
  "pli-tv-bi-vb-pc74:1.3": "tā bālā honti abyattā na jānanti kappiyaṃ vā akappiyaṃ vā, ",
  "pli-tv-bi-vb-pc74:1.4": "saddhivihāriniyo pi bālā honti abyattā ",
  "pli-tv-bi-vb-pc74:1.5": "na jānanti kappiyaṃ vā akappiyaṃ vā. ",
  "pli-tv-bi-vb-pc74:1.6": "yā tā bhikkhuniyo appicchā . . . vipācenti: ",
  "pli-tv-bi-vb-pc74:1.7": "kathaṃ hi nāma bhikkhuniyo ūnadvādasavassā vuṭṭhāpessantīti --pa--. ",
  "pli-tv-bi-vb-pc74:1.8": "saccaṃ kira bhikkhave . . . vuṭṭhāpentīti. ",
  "pli-tv-bi-vb-pc74:1.9": "saccaṃ bhagavā. ",
  "pli-tv-bi-vb-pc74:1.10": "vigarahi buddho bhagavā: kathaṃ ",
  "pli-tv-bi-vb-pc74:1.11": "hi nāma . . . vuṭṭhāpessanti. ",
  "pli-tv-bi-vb-pc74:1.12": "n' etaṃ bhikkhave appasannānaṃ . . . ",
  "pli-tv-bi-vb-pc74:1.13": "uddisantu: ",
  "pli-tv-bi-vb-pc74:1.14.0": "",
  "pli-tv-bi-vb-pc74:1.14.1": "yā pana bhikkhunī ūnadvādasavassā vuṭṭhāpeyya, pācittiyan ti. ||1|| ",
  "pli-tv-bi-vb-pc74:2.1.0": "",
  "pli-tv-bi-vb-pc74:2.1.1": "yā panā 'ti . . . ",
  "pli-tv-bi-vb-pc74:2.1.2": "",
  "pli-tv-bi-vb-pc74:2.1.3": "",
  "pli-tv-bi-vb-pc74:2.1.4": "adhippetā bhikkhunīti. ",
  "pli-tv-bi-vb-pc74:2.1.5": "ūnadvādasavassā nāma ",
  "pli-tv-bi-vb-pc74:2.1.6": "appattadvādasavassā. ",
  "pli-tv-bi-vb-pc74:2.1.7": "vuṭṭhāpeyyā 'ti . . . ",
  "pli-tv-bi-vb-pc74:2.1.8": "",
  "pli-tv-bi-vb-pc74:2.1.9": "",
  "pli-tv-bi-vb-pc74:2.1.10": "",
  "pli-tv-bi-vb-pc74:2.1.11": "",
  "pli-tv-bi-vb-pc74:2.1.12": "",
  "pli-tv-bi-vb-pc74:2.1.13": "(LXI.2.1) . . . ācariniyā ca āpatti dukkaṭassa. ||1|| ",
  "pli-tv-bi-vb-pc74:2.2.0": "",
  "pli-tv-bi-vb-pc74:2.2.1": "anāpatti ",
  "pli-tv-bi-vb-pc74:2.2.2": "paripuṇṇadvādasavassā vuṭṭhāpeti, ",
  "pli-tv-bi-vb-pc74:2.2.3": "ummattikāya, ",
  "pli-tv-bi-vb-pc74:2.2.4": "ādikammikāyā ",
  "pli-tv-bi-vb-pc74:2.2.5": "'ti. ||2||2|| "
}
