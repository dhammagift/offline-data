  "pli-tv-bi-vb-pc91:1.1": "Tena samayena buddho bhagavā Sāvatthiyaṃ viharati Jetavane Anāthapiṇḍikassa ārāme. ",
  "pli-tv-bi-vb-pc91:1.2": "tena kho pana samayena bhikkhuniyo sikkhamānāya ummaddāpenti pi parimaddāpenti pi --pa-- ",
  "pli-tv-bi-vb-pc92:1.1": "sāmaṇeriyā ummo pi paro pi --pa-- ",
  "pli-tv-bi-vb-pc93:1.1": "gihiniyā ummo pi paro pi. ",
  "pli-tv-bi-vb-pc93:1.2": "manussā vihāracārikaṃ āhiṇḍantā passitvā ujjhāyanti khīyanti vipācenti: ",
  "pli-tv-bi-vb-pc93:1.3": "kathaṃ hi nāma bhikkhuniyo gihiniyā ummaddāpessanti pi parimaddāpessanti pi, seyyathāpi gihikāmabhoginiyo 'ti. ",
  "pli-tv-bi-vb-pc93:1.4": "assosuṃ kho bhikkhuniyo . . . (see ",
  "pli-tv-bi-vb-pc93:1.5": "",
  "pli-tv-bi-vb-pc93:1.6": "",
  "pli-tv-bi-vb-pc93:1.7": "XC.1) . . . ",
  "pli-tv-bi-vb-pc93:1.8": "",
  "pli-tv-bi-vb-pc93:1.9": "",
  "pli-tv-bi-vb-pc93:1.10": "",
  "pli-tv-bi-vb-pc93:1.11": "",
  "pli-tv-bi-vb-pc93:1.12": "uddisantu: ",
  "pli-tv-bi-vb-pc93:1.13.0": "",
  "pli-tv-bi-vb-pc93:1.13.1": "yā pana bhikkhunī sikkhamānāya (sāmaṇeriyā, gihiniyā) ummaddāpeyya vā parimaddāpeyya vā, pācittiyan ti. ||1|| ",
  "pli-tv-bi-vb-pc93:2.1.0": "",
  "pli-tv-bi-vb-pc93:2.1.1": "yā panā 'ti . . . ",
  "pli-tv-bi-vb-pc93:2.1.2": "",
  "pli-tv-bi-vb-pc93:2.1.3": "",
  "pli-tv-bi-vb-pc93:2.1.4": "adhippetā bhikkhunīti. ",
  "pli-tv-bi-vb-pc93:2.1.5": "sikkhamānā nāma ",
  "pli-tv-bi-vb-pc93:2.1.6": "dve vassāni chasu dhammesu sikkhitasikkhā. ",
  "pli-tv-bi-vb-pc93:2.1.7": "sāmaṇerī nāma ",
  "pli-tv-bi-vb-pc93:2.1.8": "dasasikkhāpadikā. ",
  "pli-tv-bi-vb-pc93:2.1.9": "gihinī nāma ",
  "pli-tv-bi-vb-pc93:2.1.10": "agārinī vuccati. ",
  "pli-tv-bi-vb-pc93:2.1.11": "ummaddāpeyya vā 'ti, ",
  "pli-tv-bi-vb-pc93:2.1.12": "ummaddāpeti, āpatti pācittiyassa. ",
  "pli-tv-bi-vb-pc93:2.1.13": "parimaddāpeyya vā 'ti, ",
  "pli-tv-bi-vb-pc93:2.1.14": "sambāhāpeti, āpatti pācittiyassa. ||1|| ",
  "pli-tv-bi-vb-pc93:2.2.0": "",
  "pli-tv-bi-vb-pc93:2.2.1": "anāpatti ",
  "pli-tv-bi-vb-pc93:2.2.2": "ābādhapaccayā, ",
  "pli-tv-bi-vb-pc93:2.2.3": "āpadāsu, ",
  "pli-tv-bi-vb-pc93:2.2.4": "ummattikāya, ",
  "pli-tv-bi-vb-pc93:2.2.5": "ādikammikāyā ",
  "pli-tv-bi-vb-pc93:2.2.6": "'ti. ||2||2|| "
}
