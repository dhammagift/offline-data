  "pli-tv-bi-vb-pc60:1.0": "",
  "pli-tv-bi-vb-pc60:1.1": "Tena samayena buddho bhagavā Sāvatthiyaṃ viharati Jetavane Anāthapiṇḍikassa ārāme. ",
  "pli-tv-bi-vb-pc60:1.2": "tena kho pana samayena aññatarā bhikkhunī pasākhe jātaṃ gaṇḍaṃ purisena saddhiṃ eken' ekā bhedāpesi. ",
  "pli-tv-bi-vb-pc60:1.3": "atha kho so puriso taṃ bhikkhuniṃ dūsetuṃ upakkami. ",
  "pli-tv-bi-vb-pc60:1.4": "sā vissaram akāsi. ",
  "pli-tv-bi-vb-pc60:1.5": "bhikkhuniyo upadhāvitvā taṃ bhikkhuniṃ etad avocuṃ: ",
  "pli-tv-bi-vb-pc60:1.6": "kissa tvaṃ ayye vissaram akāsīti. ",
  "pli-tv-bi-vb-pc60:1.7": "atha kho sā bhikkhunī bhikkhunīnaṃ etam atthaṃ ārocesi. ",
  "pli-tv-bi-vb-pc60:1.8": "yā tā bhikkhuniyo appicchā . . . vipācenti: ",
  "pli-tv-bi-vb-pc60:1.9": "kathaṃ hi nāma bhikkhunī pasākhe jātaṃ gaṇḍaṃ purisena saddhiṃ eken' ekā bhedāpessatīti --pa--. ",
  "pli-tv-bi-vb-pc60:1.10": "saccaṃ kira bhikkhave bhikkhunī . . . bhedāpesīti. ",
  "pli-tv-bi-vb-pc60:1.11": "saccaṃ bhagavā. ",
  "pli-tv-bi-vb-pc60:1.12": "vigarahi buddho bhagavā: kathaṃ ",
  "pli-tv-bi-vb-pc60:1.13": "hi nāma bhikkhave bhikkhunī . . . bhedāpessati. ",
  "pli-tv-bi-vb-pc60:1.14": "n' etaṃ bhikkhave appasannānaṃ . . . ",
  "pli-tv-bi-vb-pc60:1.15": "uddisantu: ",
  "pli-tv-bi-vb-pc60:1.16.0": "",
  "pli-tv-bi-vb-pc60:1.16.1": "yā pana bhikkhunī pasākhe jātaṃ gaṇḍaṃ vā rūhitaṃ vā anapaloketvā saṃghaṃ vā gaṇaṃ vā purisena saddhiṃ eken' ekā bhedāpeyya vā phālāpeyya vā dhovāpeyya vā ālimpāpeyya vā bandhāpeyya vā mocāpeyya vā, pācittiyan ti. ||1|| ",
  "pli-tv-bi-vb-pc60:2.1.0": "",
  "pli-tv-bi-vb-pc60:2.1.1": "yā panā 'ti . . . ",
  "pli-tv-bi-vb-pc60:2.1.2": "",
  "pli-tv-bi-vb-pc60:2.1.3": "",
  "pli-tv-bi-vb-pc60:2.1.4": "adhippetā bhikkhunīti. ",
  "pli-tv-bi-vb-pc60:2.1.5": "pasākhan nāma ",
  "pli-tv-bi-vb-pc60:2.1.6": "adhonābhi ubbhajānumaṇḍalaṃ. ",
  "pli-tv-bi-vb-pc60:2.1.7": "jātan ti ",
  "pli-tv-bi-vb-pc60:2.1.8": "tattha jātaṃ. ",
  "pli-tv-bi-vb-pc60:2.1.9": "gaṇḍo nāma ",
  "pli-tv-bi-vb-pc60:2.1.10": "yo koci gaṇḍo. ",
  "pli-tv-bi-vb-pc60:2.1.11": "rūhitaṃ nāma ",
  "pli-tv-bi-vb-pc60:2.1.12": "yaṃ kiñci vaṇo. ",
  "pli-tv-bi-vb-pc60:2.1.13": "anapaloketvā 'ti ",
  "pli-tv-bi-vb-pc60:2.1.14": "anāpucchā. ",
  "pli-tv-bi-vb-pc60:2.1.15": "saṃgho nāma ",
  "pli-tv-bi-vb-pc60:2.1.16": "bhikkhunīsaṃgho vuccati. ",
  "pli-tv-bi-vb-pc60:2.1.17": "gaṇo nāma ",
  "pli-tv-bi-vb-pc60:2.1.18": "sambahulā bhikkhuniyo vuccanti. ",
  "pli-tv-bi-vb-pc60:2.1.19": "puriso nāma ",
  "pli-tv-bi-vb-pc60:2.1.20": "manussapuriso na yakkho na peto na tiracchānagato viññū paṭibalo dūsetuṃ. ",
  "pli-tv-bi-vb-pc60:2.1.21": "saddhin ti ",
  "pli-tv-bi-vb-pc60:2.1.22": "ekato. ",
  "pli-tv-bi-vb-pc60:2.1.23": "eken' ekā 'ti ",
  "pli-tv-bi-vb-pc60:2.1.24": "puriso c' eva hoti bhikkhunī ca. ",
  "pli-tv-bi-vb-pc60:2.1.25": "bhindā 'ti āṇāpeti, āpatti dukkaṭassa. ",
  "pli-tv-bi-vb-pc60:2.1.26": "bhinne āpatti pācittiyassa. ",
  "pli-tv-bi-vb-pc60:2.1.27": "phālehīti āṇāpeti, āpatti dukkaṭassa. ",
  "pli-tv-bi-vb-pc60:2.1.28": "phālite āpatti pācittiyassa. ",
  "pli-tv-bi-vb-pc60:2.1.29": "dhovā 'ti (ālimpā 'ti, bandhāhīti, mocehīti) āṇāpeti, āpatti dukkaṭassa. ",
  "pli-tv-bi-vb-pc60:2.1.30": "dhote ",
  "pli-tv-bi-vb-pc60:2.1.31": "",
  "pli-tv-bi-vb-pc60:2.1.32": "(litte, ",
  "pli-tv-bi-vb-pc60:2.1.33": "",
  "pli-tv-bi-vb-pc60:2.1.34": "baddhe, ",
  "pli-tv-bi-vb-pc60:2.1.35": "",
  "pli-tv-bi-vb-pc60:2.1.36": "mutte āpatti pācittiyassa. ||1|| ",
  "pli-tv-bi-vb-pc60:2.2.0": "",
  "pli-tv-bi-vb-pc60:2.2.1": "anāpatti ",
  "pli-tv-bi-vb-pc60:2.2.2": "apaloketvā bhedāpeti vā phālāpeti vā . . . mocāpeti vā, ",
  "pli-tv-bi-vb-pc60:2.2.3": "yo koci viññū dutiyo hoti, ",
  "pli-tv-bi-vb-pc60:2.2.4": "ummattikāya, ",
  "pli-tv-bi-vb-pc60:2.2.5": "ādikammikāyā ",
  "pli-tv-bi-vb-pc60:2.2.6": "'ti. ||2||2|| ",
  "pli-tv-bi-vb-pc60:2.2.7": ""
}
