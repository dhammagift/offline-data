  "pli-tv-bi-vb-pc83:1.0": "",
  "pli-tv-bi-vb-pc83:1.1": "Tena samayena buddho bhagavā Sāvatthiyaṃ viharati Jetavane Anāthapiṇḍikassa ārāme. ",
  "pli-tv-bi-vb-pc83:1.2": "tena kho pana samayena bhikkhuniyo ekavassaṃ dve vuṭṭhāpenti. ",
  "pli-tv-bi-vb-pc83:1.3": "upassayo tath' eva na sammati. ",
  "pli-tv-bi-vb-pc83:1.4": "manussā tath' eva ujjhāyanti khīyanti vipācenti: ",
  "pli-tv-bi-vb-pc83:1.5": "kathaṃ hi nāma bhikkhuniyo ekavassaṃ dve vuṭṭhāpessanti, ",
  "pli-tv-bi-vb-pc83:1.6": "upassayo tath' eva na sammatīti. ",
  "pli-tv-bi-vb-pc83:1.7": "assosuṃ kho bhikkhuniyo tesaṃ manussānaṃ ujjhāyantānaṃ khīyantānaṃ vipācentānaṃ. ",
  "pli-tv-bi-vb-pc83:1.8": "yā tā bhikkhuniyo appicchā . . . vipācenti . . . ",
  "pli-tv-bi-vb-pc83:1.9": "(comp. ",
  "pli-tv-bi-vb-pc83:1.10": "",
  "pli-tv-bi-vb-pc83:1.11": "",
  "pli-tv-bi-vb-pc83:1.12": "LXXXII.1) . . . ",
  "pli-tv-bi-vb-pc83:1.13": "",
  "pli-tv-bi-vb-pc83:1.14": "",
  "pli-tv-bi-vb-pc83:1.15": "uddisantu: ",
  "pli-tv-bi-vb-pc83:1.16.0": "",
  "pli-tv-bi-vb-pc83:1.16.1": "yā pana bhikkhunī ekavassaṃ dve vuṭṭhāpeyya, pācittiyan ti. ||1|| ",
  "pli-tv-bi-vb-pc83:2.1.0": "",
  "pli-tv-bi-vb-pc83:2.1.1": "yā panā 'ti . . . ",
  "pli-tv-bi-vb-pc83:2.1.2": "",
  "pli-tv-bi-vb-pc83:2.1.3": "",
  "pli-tv-bi-vb-pc83:2.1.4": "adhippetā bhikkhunīti. ",
  "pli-tv-bi-vb-pc83:2.1.5": "ekavassan ti ",
  "pli-tv-bi-vb-pc83:2.1.6": "ekaṃ saṃvaccharaṃ. ",
  "pli-tv-bi-vb-pc83:2.1.7": "dve vuṭṭhāpeyyā 'ti ",
  "pli-tv-bi-vb-pc83:2.1.8": "dve upasampādeyya. ",
  "pli-tv-bi-vb-pc83:2.1.9": "dve vuṭṭhāpessāmīti gaṇaṃ vā . . . (LXI.2) . . . ",
  "pli-tv-bi-vb-pc83:2.1.10": "",
  "pli-tv-bi-vb-pc83:2.1.11": "",
  "pli-tv-bi-vb-pc83:2.1.12": "",
  "pli-tv-bi-vb-pc83:2.1.13": "ācariniyā ca āpatti dukkaṭassa. ||1|| ",
  "pli-tv-bi-vb-pc83:2.2.0": "",
  "pli-tv-bi-vb-pc83:2.2.1": "anāpatti ",
  "pli-tv-bi-vb-pc83:2.2.2": "ekantarikaṃ vuṭṭhāpeti, ",
  "pli-tv-bi-vb-pc83:2.2.3": "ummattikāya, ",
  "pli-tv-bi-vb-pc83:2.2.4": "ādikammikāyā 'ti. ||2||2|| ",
  "pli-tv-bi-vb-pc83:2.2.5": "",
  "pli-tv-bi-vb-pc83:2.2.6": ""
}
