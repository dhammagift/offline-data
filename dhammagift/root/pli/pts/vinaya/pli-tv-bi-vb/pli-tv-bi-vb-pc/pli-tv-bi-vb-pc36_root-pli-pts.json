{
  "pli-tv-bi-vb-pc36:0.1": "",
  "pli-tv-bi-vb-pc36:0.2": "",
  "pli-tv-bi-vb-pc36:0.3": "",
  "pli-tv-bi-vb-pc36:0.4": "",
  "pli-tv-bi-vb-pc36:0.5": "",
  "pli-tv-bi-vb-pc36:1.0": "",
  "pli-tv-bi-vb-pc36:1.1": "Tena samayena buddho bhagavā Sāvatthiyaṃ viharati Jetavane Anāthapiṇḍikassa ārāme. ",
  "pli-tv-bi-vb-pc36:1.2": "tena kho pana samayena Caṇḍakālī bhikkhunī saṃsaṭṭhā viharati gahapatināpi gahapatiputtena pi. ",
  "pli-tv-bi-vb-pc36:1.3": "yā tā bhikkhuniyo appicchā . . . vipācenti: ",
  "pli-tv-bi-vb-pc36:1.4": "kathaṃ hi nāma ayyā Caṇḍakālī saṃsaṭṭhā viharissati . . . pīti --pa--. ",
  "pli-tv-bi-vb-pc36:1.5": "saccaṃ kira bhikkhave Caṇḍakālī bhikkhunī saṃsaṭṭhā viharati . . . pīti. ",
  "pli-tv-bi-vb-pc36:1.6": "saccaṃ bhagavā. ",
  "pli-tv-bi-vb-pc36:1.7": "vigarahi buddho bhagavā: kathaṃ ",
  "pli-tv-bi-vb-pc36:1.8": "hi nāma bhikkhave Caṇḍakālī bhikkhunī saṃsaṭṭhā viharissati . . . pi. ",
  "pli-tv-bi-vb-pc36:1.9": "n' etaṃ bhikkhave appasannānaṃ . . . ",
  "pli-tv-bi-vb-pc36:1.10": "uddisantu: ",
  "pli-tv-bi-vb-pc36:1.11.0": "",
  "pli-tv-bi-vb-pc36:1.11.1": "yā pana bhikkhunī saṃsaṭṭhā vihareyya gahapatinā vā gahapatiputtena vā, sā bhikkhunī bhikkhunīhi evam assa vacanīyā: ",
  "pli-tv-bi-vb-pc36:1.12": "māyye saṃsatthā vihari gahapatināpi gahapatiputtena pi. vivicc' ayye, vivekañ ñeva bhaginiyā saṃgho vaṇṇetīti. ",
  "pli-tv-bi-vb-pc36:1.13": "evañ ca pana sā bhikkhunī bhikkhunīhi vuccamānā tath' eva paggaṇheyya, sā bhikkhunī bhikkhunīhi yāvatatiyaṃ samanubhāsitabbā tassa paṭinissaggāya. ",
  "pli-tv-bi-vb-pc36:1.14": "yāvatatiyañ ce samanubhāsiyamānā taṃ paṭinissajjeyya, icc etaṃ kusalaṃ. no ce paṭinissajjeyya, pācittiyan ti. ||1|| ",
  "pli-tv-bi-vb-pc36:2.1.0": "",
  "pli-tv-bi-vb-pc36:2.1.1": "yā panā 'ti . . . ",
  "pli-tv-bi-vb-pc36:2.1.2": "",
  "pli-tv-bi-vb-pc36:2.1.3": "",
  "pli-tv-bi-vb-pc36:2.1.4": "adhippetā bhikkhunīti. ",
  "pli-tv-bi-vb-pc36:2.1.5": "saṃsaṭṭhā nāma ",
  "pli-tv-bi-vb-pc36:2.1.6": "ananulomikena kāyikavācasikena saṃsaṭṭhā. ",
  "pli-tv-bi-vb-pc36:2.1.7": "gahapati nāma ",
  "pli-tv-bi-vb-pc36:2.1.8": "yo koci agāraṃ ajjhāvasati. ",
  "pli-tv-bi-vb-pc36:2.1.9": "gahapatiputto nāma ",
  "pli-tv-bi-vb-pc36:2.1.10": "yo koci puttabhātaro. ",
  "pli-tv-bi-vb-pc36:2.1.11": "sā bhikkhunīti ",
  "pli-tv-bi-vb-pc36:2.1.12": "yā sā saṃsaṭṭhā bhikkhunī. ",
  "pli-tv-bi-vb-pc36:2.1.13": "bhikkhunīhīti ",
  "pli-tv-bi-vb-pc36:2.1.14": "aññāhi bhikkhunīhi yā passanti yā suṇanti tāhi vattabbā: ",
  "pli-tv-bi-vb-pc36:2.1.15": "māyye saṃsaṭṭhā . . . ",
  "pli-tv-bi-vb-pc36:2.1.16": "",
  "pli-tv-bi-vb-pc36:2.1.17": "vaṇṇetīti. ",
  "pli-tv-bi-vb-pc36:2.1.18": "dutiyam pi vattabbā. ",
  "pli-tv-bi-vb-pc36:2.1.19": "tatiyam pi vattabbā. ",
  "pli-tv-bi-vb-pc36:2.1.20": "sace paṭinissajjati, icc etaṃ kusalaṃ. ",
  "pli-tv-bi-vb-pc36:2.1.21": "no ce paṭinissajjati, āpatti dukkaṭassa. ",
  "pli-tv-bi-vb-pc36:2.1.22": "sutvā na vadanti, āpatti dukkaṭassa. ",
  "pli-tv-bi-vb-pc36:2.1.23": "sā bhikkhunī saṃghamajjhaṃ pi ākaḍḍhitvā vattabbā: ",
  "pli-tv-bi-vb-pc36:2.1.24": "māyye saṃsaṭṭhā . . . ",
  "pli-tv-bi-vb-pc36:2.1.25": "",
  "pli-tv-bi-vb-pc36:2.1.26": "vaṇṇetīti. ",
  "pli-tv-bi-vb-pc36:2.1.27": "dutiyam pi vattabbā. ",
  "pli-tv-bi-vb-pc36:2.1.28": "tatiyam pi vattabbā. ",
  "pli-tv-bi-vb-pc36:2.1.29": "sace paṭinissajjati, icc etaṃ kusalaṃ. ",
  "pli-tv-bi-vb-pc36:2.1.30": "no ce paṭinissajjati, āpatti dukkaṭassa. ",
  "pli-tv-bi-vb-pc36:2.1.31": "sā bhikkhunī samanubhāsitabbā. ",
  "pli-tv-bi-vb-pc36:2.1.32": "evañ ca pana bhikkhave samanubhāsitabbā: ",
  "pli-tv-bi-vb-pc36:2.1.33": "byattāya bhikkhuniyā paṭibalāya saṃgho ñāpetabbo: ",
  "pli-tv-bi-vb-pc36:2.1.34": "suṇātu me ayye saṃgho. ",
  "pli-tv-bi-vb-pc36:2.1.35": "ayaṃ itthannāmā bhikkhunī saṃsaṭṭhā viharati gahapatināpi gahapatiputtena pi. ",
  "pli-tv-bi-vb-pc36:2.1.36": "sā taṃ vatthuṃ na paṭinissajjati. ",
  "pli-tv-bi-vb-pc36:2.1.37": "yadi saṃghassa pattakallaṃ, saṃgho itthannāmaṃ bhikkhuniṃ samanubhāseyya tassa vatthussa paṭinissaggāya. ",
  "pli-tv-bi-vb-pc36:2.1.38": "esā ñatti. ",
  "pli-tv-bi-vb-pc36:2.1.39": "suṇātu me ayye saṃgho. ",
  "pli-tv-bi-vb-pc36:2.1.40": "ayaṃ itthannāmā . . . ",
  "pli-tv-bi-vb-pc36:2.1.41": "",
  "pli-tv-bi-vb-pc36:2.1.42": "",
  "pli-tv-bi-vb-pc36:2.1.43": "",
  "pli-tv-bi-vb-pc36:2.1.44": "",
  "pli-tv-bi-vb-pc36:2.1.45": "dutiyam pi etam atthaṃ vadāmi --pa-- ",
  "pli-tv-bi-vb-pc36:2.1.46": "tatiyam pi etam atthaṃ vadāmi --pa--. ",
  "pli-tv-bi-vb-pc36:2.1.47": "samanubhaṭṭhā saṃghena itthannāmā bhikkhunī tassa vatthussa paṭinissaggāya. ",
  "pli-tv-bi-vb-pc36:2.1.48": "khamati . . . dhārayāmīti. ",
  "pli-tv-bi-vb-pc36:2.1.49": "ñattiyā dukkaṭaṃ, ",
  "pli-tv-bi-vb-pc36:2.1.50": "dvīhi kammavācāhi dukkaṭā. ",
  "pli-tv-bi-vb-pc36:2.1.51": "kammavācāpariyosāne āpatti pācittiyassa. ||1|| ",
  "pli-tv-bi-vb-pc36:2.2.0": "",
  "pli-tv-bi-vb-pc36:2.2.1": "dhammakamme dhammakammasaññā na paṭinissajjati, āpatti pācittiyassa. ",
  "pli-tv-bi-vb-pc36:2.2.2": "dhammakamme vematikā . . . ",
  "pli-tv-bi-vb-pc36:2.2.3": "dhammakamme adhammakammasaññā . . . āpatti pācittiyassa. ",
  "pli-tv-bi-vb-pc36:2.2.4": "adhammakamme dhammakammasaññā, āpatti dukkaṭassa. ",
  "pli-tv-bi-vb-pc36:2.2.5": "adhammakamme vematikā, āpatti dukkaṭassa. ",
  "pli-tv-bi-vb-pc36:2.2.6": "adhammakamme adhammakammasaññā, āpatti dukkaṭassa. ||2|| ",
  "pli-tv-bi-vb-pc36:2.3.0": "",
  "pli-tv-bi-vb-pc36:2.3.1": "anāpatti ",
  "pli-tv-bi-vb-pc36:2.3.2": "asamanubhāsantiyā, ",
  "pli-tv-bi-vb-pc36:2.3.3": "paṭinissajjantiyā, ",
  "pli-tv-bi-vb-pc36:2.3.4": "ummattikāya, ",
  "pli-tv-bi-vb-pc36:2.3.5": "ādikammikāyā ",
  "pli-tv-bi-vb-pc36:2.3.6": "'ti. ||3||2|| "
}
