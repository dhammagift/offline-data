  "pli-tv-bi-vb-pc18:0.4": "",
  "pli-tv-bi-vb-pc18:0.5": "",
  "pli-tv-bi-vb-pc18:1.0": "",
  "pli-tv-bi-vb-pc18:1.1": "Tena samayena buddho bhagavā Sāvatthiyaṃ viharati Jetavane Anāthapiṇḍikassa ārāme. ",
  "pli-tv-bi-vb-pc18:1.2": "tena kho pana samayena Bhaddāya Kāpilāniyā antevāsibhikkhunī Bhaddaṃ Kāpilāniṃ sakkaccaṃ upaṭṭheti. ",
  "pli-tv-bi-vb-pc18:1.3": "Bhaddā Kāpilānī bhikkhuniyo etad avoca: ",
  "pli-tv-bi-vb-pc18:1.4": "ayaṃ maṃ ayye bhikkhunī sakkaccaṃ upaṭṭheti, imissāhaṃ cīvaraṃ dassāmīti. ",
  "pli-tv-bi-vb-pc18:1.5": "atha kho sā bhikkhunī duggahitena dūpadhāritena paraṃ ujjhāpesi: ",
  "pli-tv-bi-vb-pc18:1.6": "ahaṃ kir' ayye ayyaṃ na sakkaccaṃ upaṭṭhemi, na kira me ayyā cīvaraṃ dassatīti. ",
  "pli-tv-bi-vb-pc18:1.7": "yā tā bhikkhuniyo appicchā . . . vipācenti: ",
  "pli-tv-bi-vb-pc18:1.8": "kathaṃ hi nāma bhikkhunī duggahitena dūpadhāritena paraṃ ujjhāpessatīti --pa--. ",
  "pli-tv-bi-vb-pc18:1.9": "saccaṃ kira bhikkhave bhikkhunī . . . ujjhāpesīti. ",
  "pli-tv-bi-vb-pc18:1.10": "saccaṃ bhagavā. ",
  "pli-tv-bi-vb-pc18:1.11": "vigarahi buddho bhagavā: kathaṃ ",
  "pli-tv-bi-vb-pc18:1.12": "hi nāma bhikkhave bhikkhunī . . . ujjhāpessati. ",
  "pli-tv-bi-vb-pc18:1.13": "n' etaṃ bhikkhave appasannānaṃ . . . ",
  "pli-tv-bi-vb-pc18:1.14": "uddisantu: ",
  "pli-tv-bi-vb-pc18:1.15.0": "",
  "pli-tv-bi-vb-pc18:1.15.1": "yā pana bhikkhunī duggahitena dūpadhāritena paraṃ ujjhāpeyya, pācittiyan ti. ||1|| ",
  "pli-tv-bi-vb-pc18:2.1.0": "",
  "pli-tv-bi-vb-pc18:2.1.1": "yā panā 'ti . . . ",
  "pli-tv-bi-vb-pc18:2.1.2": "",
  "pli-tv-bi-vb-pc18:2.1.3": "",
  "pli-tv-bi-vb-pc18:2.1.4": "adhippetā bhikkhunīti. ",
  "pli-tv-bi-vb-pc18:2.1.5": "duggahitenā 'ti ",
  "pli-tv-bi-vb-pc18:2.1.6": "aññathā uggahitena. ",
  "pli-tv-bi-vb-pc18:2.1.7": "dūpadhāritenā 'ti ",
  "pli-tv-bi-vb-pc18:2.1.8": "aññathā upadhāritena. ",
  "pli-tv-bi-vb-pc18:2.1.9": "paran ti ",
  "pli-tv-bi-vb-pc18:2.1.10": "upasampannaṃ. ujjhāpeti, āpatti pācittiyassa. ||1|| ",
  "pli-tv-bi-vb-pc18:2.2.0": "",
  "pli-tv-bi-vb-pc18:2.2.1": "upasampannāya upasampannasaññā ujjhāpeti, āpatti pācittiyassa. ",
  "pli-tv-bi-vb-pc18:2.2.2": "upasampannāya vematikā . . . ",
  "pli-tv-bi-vb-pc18:2.2.3": "upasampannāya anupasampannasaññā . . . āpatti pācittiyassa. ",
  "pli-tv-bi-vb-pc18:2.2.4": "anupasampannaṃ ujjhāpeti, āpatti dukkaṭassa. ",
  "pli-tv-bi-vb-pc18:2.2.5": "anupasampannāya upasampannasaññā, āpatti dukkaṭassa. ",
  "pli-tv-bi-vb-pc18:2.2.6": "anupasampannāya vematikā, āpatti dukkaṭassa. ",
  "pli-tv-bi-vb-pc18:2.2.7": "anupasampannāya anupasampannasaññā, āpatti dukkaṭassa. ||2|| ",
  "pli-tv-bi-vb-pc18:2.3.0": "",
  "pli-tv-bi-vb-pc18:2.3.1": "anāpatti ",
  "pli-tv-bi-vb-pc18:2.3.2": "ummattikāya, ",
  "pli-tv-bi-vb-pc18:2.3.3": "ādikammikāyā ",
  "pli-tv-bi-vb-pc18:2.3.4": "'ti. ||3||2|| "
}
