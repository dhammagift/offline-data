  "pli-tv-bi-vb-pc62:1.0": "",
  "pli-tv-bi-vb-pc62:1.1": "Tena samayena buddho bhagavā Sāvatthiyaṃ viharati Jetavane Anāthapiṇḍikassa ārāme. ",
  "pli-tv-bi-vb-pc62:1.2": "tena kho pana samayena bhikkhuniyo pāyantiṃ vuṭṭhāpenti. ",
  "pli-tv-bi-vb-pc62:1.3": "sā piṇḍāya carati. ",
  "pli-tv-bi-vb-pc62:1.4": "manussā evam āhaṃsu: ",
  "pli-tv-bi-vb-pc62:1.5": "deth' ayyāya bhikkhaṃ, sadutiyikā ayyā 'ti. ",
  "pli-tv-bi-vb-pc62:1.6": "manussā . . . vipācenti: ",
  "pli-tv-bi-vb-pc62:1.7": "kathaṃ hi nāma . . . (LXI.1. Instead of gabbhiniṃ read pāyantiṃ) . . . ",
  "pli-tv-bi-vb-pc62:1.8": "",
  "pli-tv-bi-vb-pc62:1.9": "",
  "pli-tv-bi-vb-pc62:1.10": "",
  "pli-tv-bi-vb-pc62:1.11": "",
  "pli-tv-bi-vb-pc62:1.12": "",
  "pli-tv-bi-vb-pc62:1.13": "",
  "pli-tv-bi-vb-pc62:1.14": "",
  "pli-tv-bi-vb-pc62:1.15": "",
  "pli-tv-bi-vb-pc62:1.16": "uddisantu: ",
  "pli-tv-bi-vb-pc62:1.17.0": "",
  "pli-tv-bi-vb-pc62:1.17.1": "yā pana bhikkhunī pāyantiṃ vuṭṭhāpeyya, pācittiyan ti. ||1|| ",
  "pli-tv-bi-vb-pc62:2.0": "",
  "pli-tv-bi-vb-pc62:2.1": "yā panā 'ti . . . ",
  "pli-tv-bi-vb-pc62:2.2": "",
  "pli-tv-bi-vb-pc62:2.3": "",
  "pli-tv-bi-vb-pc62:2.4": "adhippetā bhikkhunīti. ",
  "pli-tv-bi-vb-pc62:2.5": "pāyantī nāmamātā ",
  "pli-tv-bi-vb-pc62:2.6": "vā hoti dhātī vā. ",
  "pli-tv-bi-vb-pc62:2.7": "vuṭṭhāpeyyā 'ti . . . ",
  "pli-tv-bi-vb-pc62:2.8": "",
  "pli-tv-bi-vb-pc62:2.9": "",
  "pli-tv-bi-vb-pc62:2.10": "",
  "pli-tv-bi-vb-pc62:2.11": "",
  "pli-tv-bi-vb-pc62:2.12": "",
  "pli-tv-bi-vb-pc62:2.13": "(LXI.2. Read ",
  "pli-tv-bi-vb-pc62:2.14.0": "",
  "pli-tv-bi-vb-pc62:2.14.1": "pāyantiyā pāyantisaññā, ",
  "pli-tv-bi-vb-pc62:2.15": "",
  "pli-tv-bi-vb-pc62:2.16": "apāyantisaññā, etc.) . . . ",
  "pli-tv-bi-vb-pc62:2.17": "",
