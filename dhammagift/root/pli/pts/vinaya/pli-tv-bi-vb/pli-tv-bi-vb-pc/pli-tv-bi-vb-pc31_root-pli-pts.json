  "pli-tv-bi-vb-pc31:0.4": "",
  "pli-tv-bi-vb-pc31:0.5": "",
  "pli-tv-bi-vb-pc31:1.0": "",
  "pli-tv-bi-vb-pc31:1.1": "Tena samayena buddho bhagavā Sāvatthiyaṃ viharati Jetavane Anāthapiṇḍikassa ārāme. ",
  "pli-tv-bi-vb-pc31:1.2": "tena kho pana samayena bhikkhuniyo dve ekamañce tuvaṭṭenti. ",
  "pli-tv-bi-vb-pc31:1.3": "manussā vihāracārikaṃ āhiṇḍantā passitvā . . . vipācenti: ",
  "pli-tv-bi-vb-pc31:1.4": "kathaṃ hi nāma bhikkhuniyo dve ekamañce tuvaṭṭessanti seyyathāpi gihikāmabhoginiyo 'ti. ",
  "pli-tv-bi-vb-pc31:1.5": "assosuṃ kho bhikkhuniyo tesaṃ manussānaṃ . . . vipācentānaṃ. ",
  "pli-tv-bi-vb-pc31:1.6": "yā tā bhikkhuniyo appicchā . . . vipācenti: ",
  "pli-tv-bi-vb-pc31:1.7": "kathaṃ hi nāma bhikkhuniyo dve ekamañce tuvaṭṭessantīti --pa--. ",
  "pli-tv-bi-vb-pc31:1.8": "saccaṃ kira bhikkhave bhikkhuniyo . . . tuvaṭṭentīti. ",
  "pli-tv-bi-vb-pc31:1.9": "saccaṃ bhagavā. ",
  "pli-tv-bi-vb-pc31:1.10": "vigarahi buddho bhagavā: kathaṃ ",
  "pli-tv-bi-vb-pc31:1.11": "hi nāma bhikkhave bhikkhuniyo . . . tuvaṭṭessanti. ",
  "pli-tv-bi-vb-pc31:1.12": "n' etaṃ bhikkhave appasannānaṃ . . . ",
  "pli-tv-bi-vb-pc31:1.13": "uddisantu: ",
  "pli-tv-bi-vb-pc31:1.14.0": "",
  "pli-tv-bi-vb-pc31:1.14.1": "yā pana bhikkhuniyo dve ekamañce tuvaṭṭeyyuṃ, pācittiyan ti. ||1|| ",
  "pli-tv-bi-vb-pc31:2.1.0": "",
  "pli-tv-bi-vb-pc31:2.1.1": "yā panā 'ti ",
  "pli-tv-bi-vb-pc31:2.1.2": "yā yādisā --pa--. ",
  "pli-tv-bi-vb-pc31:2.1.3": "bhikkhuniyo 'ti ",
  "pli-tv-bi-vb-pc31:2.1.4": "upasampannāyo vuccanti. ",
  "pli-tv-bi-vb-pc31:2.1.5": "dve ekamañce tuvaṭṭeyyun ti, ",
  "pli-tv-bi-vb-pc31:2.1.6": "ekāya nipannāya aparā nipajjati, āpatti pācittiyassa. ",
  "pli-tv-bi-vb-pc31:2.1.7": "ubho vā nipajjanti, āpatti pācittiyassa. ",
  "pli-tv-bi-vb-pc31:2.1.8": "uṭṭhahitvā punappunaṃ nipajjanti, āpatti pācittiyassa. ||1|| ",
  "pli-tv-bi-vb-pc31:2.2.0": "",
  "pli-tv-bi-vb-pc31:2.2.1": "anāpatti ",
  "pli-tv-bi-vb-pc31:2.2.2": "ekāya nipannāya aparā nisīdati, ",
  "pli-tv-bi-vb-pc31:2.2.3": "ubho vā nisīdanti, ",
  "pli-tv-bi-vb-pc31:2.2.4": "ummattikānaṃ, ",
  "pli-tv-bi-vb-pc31:2.2.5": "ādikammikānan ",
  "pli-tv-bi-vb-pc31:2.2.6": "ti. ||2||2|| "
}
