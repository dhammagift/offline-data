  "pli-tv-bi-vb-pc69:0.4": "",
  "pli-tv-bi-vb-pc69:0.5": "",
  "pli-tv-bi-vb-pc69:1.0": "",
  "pli-tv-bi-vb-pc69:1.1": "Tena samayena buddho bhagavā Sāvatthiyaṃ viharati Jetavane Anāthapiṇḍikassa ārāme. ",
  "pli-tv-bi-vb-pc69:1.2": "tena kho pana samayena bhikkhuniyo vuṭṭhāpitaṃ pavattiniṃ dve vassāni nānubandhanti, ",
  "pli-tv-bi-vb-pc69:1.3": "tā bālā honti abyattā ",
  "pli-tv-bi-vb-pc69:1.4": "na jānanti kappiyaṃ vā akappiyaṃ vā. ",
  "pli-tv-bi-vb-pc69:1.5": "yā tā bhikkhuniyo appicchā . . . vipācenti: ",
  "pli-tv-bi-vb-pc69:1.6": "kathaṃ hi nāma bhikkhuniyo vuṭṭhāpitaṃ pavattiniṃ dve vassāni nānubandhissantīti --pa--. ",
  "pli-tv-bi-vb-pc69:1.7": "saccaṃ kira bhikkhave bhikkhuniyo . . . nānubandhantīti. ",
  "pli-tv-bi-vb-pc69:1.8": "saccaṃ bhagavā. ",
  "pli-tv-bi-vb-pc69:1.9": "vigarahi buddho bhagavā: kathaṃ ",
  "pli-tv-bi-vb-pc69:1.10": "hi nāma bhikkhave bhikkhuniyo . . . nānubandhissanti. ",
  "pli-tv-bi-vb-pc69:1.11": "n' etaṃ bhikkhave appasannānaṃ . . . ",
  "pli-tv-bi-vb-pc69:1.12": "uddisantu: ",
  "pli-tv-bi-vb-pc69:1.13.0": "",
  "pli-tv-bi-vb-pc69:1.13.1": "yā pana bhikkhunī vuṭṭhāpitaṃ pavattiniṃ dve vassāni nānubandheyya, pācittiyan ti. ||1|| ",
  "pli-tv-bi-vb-pc69:2.1.0": "",
  "pli-tv-bi-vb-pc69:2.1.1": "yā panā 'ti . . . ",
  "pli-tv-bi-vb-pc69:2.1.2": "",
  "pli-tv-bi-vb-pc69:2.1.3": "",
  "pli-tv-bi-vb-pc69:2.1.4": "adhippetā bhikkhunīti. ",
  "pli-tv-bi-vb-pc69:2.1.5": "vuṭṭhāpitan ti ",
  "pli-tv-bi-vb-pc69:2.1.6": "upasampāditaṃ. ",
  "pli-tv-bi-vb-pc69:2.1.7": "pavattinī nāma ",
  "pli-tv-bi-vb-pc69:2.1.8": "upajjhā vuccati. ",
  "pli-tv-bi-vb-pc69:2.1.9": "dve vassānīti ",
  "pli-tv-bi-vb-pc69:2.1.10": "dve saṃvaccharāni. ",
  "pli-tv-bi-vb-pc69:2.1.11": "nānubandheyyā 'ti ",
  "pli-tv-bi-vb-pc69:2.1.12": "na sayaṃ upaṭṭhaheyya. ",
  "pli-tv-bi-vb-pc69:2.1.13": "dve vassāni nānubandhissāmīti dhuraṃ nikkhittamatte āpatti pācittiyassa. ||1|| ",
  "pli-tv-bi-vb-pc69:2.2.0": "",
  "pli-tv-bi-vb-pc69:2.2.1": "anāpatti ",
  "pli-tv-bi-vb-pc69:2.2.2": "upajjhā bālā vā hoti alajjinī vā, ",
  "pli-tv-bi-vb-pc69:2.2.3": "gilānāya, ",
  "pli-tv-bi-vb-pc69:2.2.4": "āpadāsu, ",
  "pli-tv-bi-vb-pc69:2.2.5": "ummattikāya, ",
  "pli-tv-bi-vb-pc69:2.2.6": "ādikammikāyā ",
  "pli-tv-bi-vb-pc69:2.2.7": "'ti. ||2||2|| "
}
