  "pli-tv-bi-vb-pc38:1.10": "",
  "pli-tv-bi-vb-pc38:1.11": "uddisantu: ",
  "pli-tv-bi-vb-pc38:1.12.0": "",
  "pli-tv-bi-vb-pc38:1.12.1": "yā pana bhikkhunī tiroraṭṭhe sāsaṅkasammate sappaṭibhaye asatthikā cārikaṃ careyya, pācittiyan ti. ||1|| ",
  "pli-tv-bi-vb-pc38:2.0": "",
  "pli-tv-bi-vb-pc38:2.1": "yā panā 'ti . . . ",
