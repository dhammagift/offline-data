  "pli-tv-bi-vb-pc38:2.3": "",
  "pli-tv-bi-vb-pc38:2.4": "adhippetā bhikkhunīti. ",
  "pli-tv-bi-vb-pc38:2.5": "tiroraṭṭhe 'ti ",
  "pli-tv-bi-vb-pc38:2.6": "yassa vijite viharati taṃ ṭhapetvā aññassa raṭṭhe. ",
  "pli-tv-bi-vb-pc38:2.7": "sāsaṅkan nāma . . . ",
