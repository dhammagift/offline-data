  "pli-tv-bi-vb-pc87:1.0": "",
  "pli-tv-bi-vb-pc87:1.1": "Tena samayena buddho bhagavā Sāvatthiyaṃ viharati Jetavane Anāthapiṇḍikassa ārāme. ",
  "pli-tv-bi-vb-pc87:1.2": "tena kho pana samayena chabbaggiyā bhikkhuniyo itthālaṃkāraṃ dhārenti. ",
  "pli-tv-bi-vb-pc87:1.3": "manussā . . . vipācenti: ",
  "pli-tv-bi-vb-pc87:1.4": "kathaṃ hi nāma bhikkhuniyo itthālaṃkāraṃ dhāressanti, seyyathāpi gihikāmabhoginiyo 'ti. ",
  "pli-tv-bi-vb-pc87:1.5": "assosuṃ kho bhikkhuniyo tesaṃ manussānaṃ . . . vipācentānaṃ. ",
  "pli-tv-bi-vb-pc87:1.6": "yā tā bhikkhuniyo appicchā . . . vipācenti: ",
  "pli-tv-bi-vb-pc87:1.7": "kathaṃ hi nāma chabbaggiyā bhikkhuniyo itthālaṃkāraṃ dhāressantīti --pa--. ",
  "pli-tv-bi-vb-pc87:1.8": "saccaṃ kira bhikkhave . . . dhārentīti. ",
  "pli-tv-bi-vb-pc87:1.9": "saccaṃ bhagavā. ",
  "pli-tv-bi-vb-pc87:1.10": "vigarahi buddho bhagavā: kathaṃ ",
  "pli-tv-bi-vb-pc87:1.11": "hi nāma bhikkhave . . . dhāressantīti. ",
  "pli-tv-bi-vb-pc87:1.12": "n' etaṃ bhikkhave appasannānaṃ . . . ",
  "pli-tv-bi-vb-pc87:1.13": "uddisantu: ",
  "pli-tv-bi-vb-pc87:1.14.0": "",
  "pli-tv-bi-vb-pc87:1.14.1": "yā pana bhikkhunī itthālaṃkāraṃ dhāreyya, pācittiyan ti. ||1|| ",
  "pli-tv-bi-vb-pc87:2.1.0": "",
  "pli-tv-bi-vb-pc87:2.1.1": "yā panā 'ti . . . ",
  "pli-tv-bi-vb-pc87:2.1.2": "",
  "pli-tv-bi-vb-pc87:2.1.3": "",
  "pli-tv-bi-vb-pc87:2.1.4": "adhippetā bhikkhunīti. ",
  "pli-tv-bi-vb-pc87:2.1.5": "itthālaṃkāro nāma ",
  "pli-tv-bi-vb-pc87:2.1.6": "sīsūpago gīvūpago hatthūpago pādūpago kaṭūpago. ",
  "pli-tv-bi-vb-pc87:2.1.7": "dhāreyyā 'ti ",
  "pli-tv-bi-vb-pc87:2.1.8": "sakim pi dhāreti, āpatti pācittiyassa. ||1|| ",
  "pli-tv-bi-vb-pc87:2.2.0": "",
  "pli-tv-bi-vb-pc87:2.2.1": "anāpatti ",
  "pli-tv-bi-vb-pc87:2.2.2": "ābādhapaccayā, ",
  "pli-tv-bi-vb-pc87:2.2.3": "ummattikāya, ",
  "pli-tv-bi-vb-pc87:2.2.4": "ādikammikāyā ",
  "pli-tv-bi-vb-pc87:2.2.5": "'ti. ||2||2|| "
}
