  "pli-tv-bi-vb-pc94:0.4": "",
  "pli-tv-bi-vb-pc94:0.5": "",
  "pli-tv-bi-vb-pc94:1.0": "",
  "pli-tv-bi-vb-pc94:1.1": "Tena samayena buddho bhagavā Sāvatthiyaṃ viharati Jetavane Anāthapiṇḍikassa ārāme. ",
  "pli-tv-bi-vb-pc94:1.2": "tena kho pana samayena bhikkhuniyo bhikkhussa purato anāpucchā āsane nisīdanti. ",
  "pli-tv-bi-vb-pc94:1.3": "bhikkhū . . . vipācenti: ",
  "pli-tv-bi-vb-pc94:1.4": "kathaṃ hi nāma bhikkhuniyo bhikkhussa purato anāpucchā āsane nisīdissantīti --pa--. ",
  "pli-tv-bi-vb-pc94:1.5": "saccaṃ kira bhikkhave . . . nisīdantīti. ",
  "pli-tv-bi-vb-pc94:1.6": "saccaṃ bhagavā. ",
  "pli-tv-bi-vb-pc94:1.7": "vigarahi buddho bhagavā: kathaṃ ",
  "pli-tv-bi-vb-pc94:1.8": "hi nāma bhikkhave . . . nisīdissanti. ",
  "pli-tv-bi-vb-pc94:1.9": "n' etaṃ bhikkhave appasannānaṃ . . . ",
  "pli-tv-bi-vb-pc94:1.10": "uddisantu: ",
  "pli-tv-bi-vb-pc94:1.11.0": "",
  "pli-tv-bi-vb-pc94:1.11.1": "yā pana bhikkhunī bhikkhussa purato anāpucchā āsane nisīdeyya, pācittiyan ti. ||1|| ",
  "pli-tv-bi-vb-pc94:2.1.0": "",
  "pli-tv-bi-vb-pc94:2.1.1": "yā panā 'ti . . . ",
  "pli-tv-bi-vb-pc94:2.1.2": "",
  "pli-tv-bi-vb-pc94:2.1.3": "",
  "pli-tv-bi-vb-pc94:2.1.4": "adhippetā bhikkhunīti. ",
  "pli-tv-bi-vb-pc94:2.1.5": "bhikkhussa purato 'ti ",
  "pli-tv-bi-vb-pc94:2.1.6": "upasampannassa purato. ",
  "pli-tv-bi-vb-pc94:2.1.7": "anāpucchā 'ti ",
  "pli-tv-bi-vb-pc94:2.1.8": "anapaloketvā. ",
  "pli-tv-bi-vb-pc94:2.1.9": "āsane nisīdeyyā 'ti ",
  "pli-tv-bi-vb-pc94:2.1.10": "antamaso chamāya pi nisīdati, āpatti pācittiyassa. ||1|| ",
  "pli-tv-bi-vb-pc94:2.2.0": "",
  "pli-tv-bi-vb-pc94:2.2.1": "anāpucchite anāpucchitasaññā āsane nisīdati, āpatti pācittiyassa. ",
  "pli-tv-bi-vb-pc94:2.2.2": "anāpucchite vematikā . . . ",
  "pli-tv-bi-vb-pc94:2.2.3": "anāpucchite āpucchitasaññā . . . āpatti pācittiyassa. ",
  "pli-tv-bi-vb-pc94:2.2.4": "āpucchite anāpucchitasaññā, āpatti dukkaṭassa. ",
  "pli-tv-bi-vb-pc94:2.2.5": "āpucchite vematikā, āpatti dukkaṭassa. ",
  "pli-tv-bi-vb-pc94:2.2.6": "āpucchite āpucchitasaññā, anāpatti. ||2|| ",
  "pli-tv-bi-vb-pc94:2.3.0": "",
  "pli-tv-bi-vb-pc94:2.3.1": "anāpatti ",
  "pli-tv-bi-vb-pc94:2.3.2": "āpucchā āsane nisīdati, ",
  "pli-tv-bi-vb-pc94:2.3.3": "gilānāya, ",
  "pli-tv-bi-vb-pc94:2.3.4": "āpadāsu, ",
  "pli-tv-bi-vb-pc94:2.3.5": "ummattikāya, ",
  "pli-tv-bi-vb-pc94:2.3.6": "ādikammikāyā 'ti. ||3||2|| ",
  "pli-tv-bi-vb-pc94:2.3.7": ""
}
