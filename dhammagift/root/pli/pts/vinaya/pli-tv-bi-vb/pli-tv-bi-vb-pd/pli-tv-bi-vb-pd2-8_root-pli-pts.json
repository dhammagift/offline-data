  "pli-tv-bi-vb-pd8:2.3.10": "ādikammikāyā 'ti. ||2|| ",
  "pli-tv-bi-vb-pd8:2.3.11": "",
  "pli-tv-bi-vb-pd8:2.3.12": "uddiṭṭhā kho ayyāyo aṭṭha pāṭidesaniyā dhammā. ",
  "pli-tv-bi-vb-pd8:2.3.13": "tatth' ayyāyo pucchāmi: ",
  "pli-tv-bi-vb-pd8:2.3.14": "kacci 'ttha parisuddhā. ",
  "pli-tv-bi-vb-pd8:2.3.15": "dutiyam pi pucchāmi: ",
  "pli-tv-bi-vb-pd8:2.3.16": "kacci 'ttha parisuddhā. ",
  "pli-tv-bi-vb-pd8:2.3.17": "tatiyam pi pucchāmi: ",
  "pli-tv-bi-vb-pd8:2.3.18": "kacci 'ttha parisuddhā. ",
  "pli-tv-bi-vb-pd8:2.3.19": "parisuddh' etth' ayyāyo, tasmā tuṇhī, evam etaṃ dhārayāmīti. ",
  "pli-tv-bi-vb-pd8:2.3.20": "pāṭidesaniyaṃ niṭṭhitaṃ. "
