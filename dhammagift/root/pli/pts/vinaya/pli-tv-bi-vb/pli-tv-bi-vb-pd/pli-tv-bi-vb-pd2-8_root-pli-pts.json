  "pli-tv-bi-vb-pd8:1.1.1": "dadhiṃ) viññāpetvā bhuñjeyya, paṭidesetabbaṃ tāya bhikkhuniyā ",
  "pli-tv-bi-vb-pd8:1.1.2": "gārayhaṃ ayye dhammaṃ āpajjiṃ asappāyaṃ pāṭidesaniyaṃ, taṃ paṭidesemīti. ||1|| ",
  "pli-tv-bi-vb-pd8:2.1.0": "",
  "pli-tv-bi-vb-pd8:2.1.1": "yā panā 'ti . . . ",
  "pli-tv-bi-vb-pd8:2.1.2": "",
  "pli-tv-bi-vb-pd8:2.1.3": "",
  "pli-tv-bi-vb-pd8:2.1.4": "adhippetā bhikkhunī. ",
  "pli-tv-bi-vb-pd8:2.1.5": "agilānā nāma ",
  "pli-tv-bi-vb-pd8:2.1.6": "yassā vinā dadhinā phāsu hoti. ",
  "pli-tv-bi-vb-pd8:2.1.7": "gilānā nāma ",
  "pli-tv-bi-vb-pd8:2.1.8": "yassā vinā dadhinā na phāsu hoti. ",
  "pli-tv-bi-vb-pd8:2.1.9": "telaṃ nāma ",
  "pli-tv-bi-vb-pd8:2.1.10": "tilatelaṃ sāsapatelaṃ madhukatelaṃ eraṇḍakatelaṃ vasātelaṃ. ",
  "pli-tv-bi-vb-pd8:2.1.11": "madhu nāma ",
  "pli-tv-bi-vb-pd8:2.1.12": "makkhikāmadhu. ",
  "pli-tv-bi-vb-pd8:2.1.13": "phāṇitaṃ nāma ",
  "pli-tv-bi-vb-pd8:2.1.14": "ucchumhā nibbattaṃ. ",
  "pli-tv-bi-vb-pd8:2.1.15": "maccho nāma ",
  "pli-tv-bi-vb-pd8:2.1.16": "odako vuccati. ",
  "pli-tv-bi-vb-pd8:2.1.17": "maṃsaṃ nāma ",
  "pli-tv-bi-vb-pd8:2.1.18": "yesaṃ maṃsaṃ kappati tesaṃ maṃsaṃ. ",
  "pli-tv-bi-vb-pd8:2.1.19": "khīran nāma ",
  "pli-tv-bi-vb-pd8:2.1.20": "gokhīraṃ vā ajikākhīraṃ vā māhisaṃ vā khīraṃ, yesaṃ maṃsaṃ kappati tesaṃ khīraṃ. ",
  "pli-tv-bi-vb-pd8:2.1.21": "dadhi nāma ",
  "pli-tv-bi-vb-pd8:2.1.22": "tesañ ñeva dadhi. ",
  "pli-tv-bi-vb-pd8:2.1.23": "agilānā attano atthāya . . . (I.2. Instead ",
  "pli-tv-bi-vb-pd8:2.1.24": "of ",
