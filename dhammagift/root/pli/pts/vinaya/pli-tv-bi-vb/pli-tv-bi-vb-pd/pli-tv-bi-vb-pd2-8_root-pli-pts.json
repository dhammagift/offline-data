  "pli-tv-bi-vb-pd2:1.2.9.0": "",
  "pli-tv-bi-vb-pd2:1.2.9.1": "yā pana bhikkhunī agilānā telaṃ ",
  "pli-tv-bi-vb-pd3:1.1.1": "(madhuṃ, ",
  "pli-tv-bi-vb-pd4:1.1.1": "phāṇitaṃ, ",
