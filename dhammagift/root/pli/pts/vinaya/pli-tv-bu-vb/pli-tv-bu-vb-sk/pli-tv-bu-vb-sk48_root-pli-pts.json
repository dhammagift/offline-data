  "pli-tv-bu-vb-sk48:1.0": "",
  "pli-tv-bu-vb-sk48:1.1": "Tena samayena . . . Anāthapiṇḍikassa ārāme. ",
  "pli-tv-bu-vb-sk48:1.2": "tena kho pana samayena chabbaggiyā bhikkhū sitthāvakārakaṃ bhuñjanti --pa--. ",
  "pli-tv-bu-vb-sk48:1.3.0": "",
  "pli-tv-bu-vb-sk48:1.3.1": "na sitthāvakārakaṃ bhuñjissāmīti sikkhā karaṇīyā. ",
  "pli-tv-bu-vb-sk48:1.4": "na sitthāvakārakaṃ bhuñjitabbaṃ. ",
  "pli-tv-bu-vb-sk48:1.5": "yo anādariyaṃ paṭicca sitthāvakārakaṃ bhuñjati, āpatti dukkaṭassa. ",
  "pli-tv-bu-vb-sk48:1.6.0": "",
  "pli-tv-bu-vb-sk48:1.6.1": "anāpatti ",
  "pli-tv-bu-vb-sk48:1.7": "asañcicca, ",
  "pli-tv-bu-vb-sk48:1.8": "asatiyā, ",
  "pli-tv-bu-vb-sk48:1.9": "ajānantassa, ",
  "pli-tv-bu-vb-sk48:1.10": "gilānassa, ",
  "pli-tv-bu-vb-sk48:1.11": "kacavaraṃ chaḍḍento sitthaṃ chaḍḍiyyati, ",
  "pli-tv-bu-vb-sk48:1.12": "āpadāsu, ",
  "pli-tv-bu-vb-sk48:1.13": "ummattakassa, ",
  "pli-tv-bu-vb-sk48:1.14": "ādikammikassā 'ti. ||48|| ",
  "pli-tv-bu-vb-sk48:1.15": ""
}
