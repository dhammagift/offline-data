  "pli-tv-bu-vb-sk25:1.1": "Anāthapiṇḍikassa ārāme. ",
  "pli-tv-bu-vb-sk25:1.2": "tena kho pana samayena chabbaggiyā bhikkhū ukkuṭikāya antaraghare gacchanti --pa--. ",
  "pli-tv-bu-vb-sk25:1.3.0": "",
  "pli-tv-bu-vb-sk25:1.3.1": "na ukkuṭikāya antaraghare gamissāmīti sikkhā karaṇīyā. ",
  "pli-tv-bu-vb-sk25:1.4": "na ukkuṭikāya antaraghare gantabbaṃ. ",
  "pli-tv-bu-vb-sk25:1.5": "yo anādariyaṃ paṭicca ukkuṭikāya antaraghare gacchati, āpatti dukkaṭassa. ",
  "pli-tv-bu-vb-sk25:1.6.0": "",
  "pli-tv-bu-vb-sk25:1.6.1": "anāpatti ",
  "pli-tv-bu-vb-sk25:1.7.1": "asañcicca --pa-- ",
