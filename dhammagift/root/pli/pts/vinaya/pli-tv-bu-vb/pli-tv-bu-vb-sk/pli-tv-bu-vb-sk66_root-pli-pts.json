  "pli-tv-bu-vb-sk66:1.0": "",
  "pli-tv-bu-vb-sk66:1.1": "Tena samayena . . . Anāthapiṇḍikassa ārāme. ",
  "pli-tv-bu-vb-sk66:1.2": "tena kho pana samayena chabbaggiyā bhikkhū veṭṭhitasīsassa dhammaṃ desenti --pa--. ",
  "pli-tv-bu-vb-sk66:1.3.0": "",
  "pli-tv-bu-vb-sk66:1.3.1": "na veṭṭhitasīsassa agilānassa dhammaṃ desessāmīti sikkhā karaṇīyā. ",
  "pli-tv-bu-vb-sk66:1.4.0": "",
  "pli-tv-bu-vb-sk66:1.4.1": "veṭṭhitasīso nāma ",
  "pli-tv-bu-vb-sk66:1.5": "kesantaṃ na dassāpetvā veṭṭhito hoti. ",
  "pli-tv-bu-vb-sk66:1.6": "na veṭṭhitasīsassa agilānassa dhammo desetabbo. ",
  "pli-tv-bu-vb-sk66:1.7": "yo anādariyaṃ paṭicca veṭṭhitasīsassa agilānassa dhammaṃ deseti, āpatti dukkaṭassa. ",
  "pli-tv-bu-vb-sk66:1.8.0": "",
  "pli-tv-bu-vb-sk66:1.8.1": "anāpatti ",
  "pli-tv-bu-vb-sk66:1.9": "asañcicca, ",
  "pli-tv-bu-vb-sk66:1.10": "asatiyā, ",
  "pli-tv-bu-vb-sk66:1.11": "ajānantassa, ",
  "pli-tv-bu-vb-sk66:1.12": "gilānassa, ",
  "pli-tv-bu-vb-sk66:1.13": "kesantaṃ vivarāpetvā deseti, ",
  "pli-tv-bu-vb-sk66:1.14": "āpadāsu, ",
  "pli-tv-bu-vb-sk66:1.15": "ummattakassa, ",
  "pli-tv-bu-vb-sk66:1.16": "ādikammikassā ",
  "pli-tv-bu-vb-sk66:1.17": "'ti. ||66|| "
}
