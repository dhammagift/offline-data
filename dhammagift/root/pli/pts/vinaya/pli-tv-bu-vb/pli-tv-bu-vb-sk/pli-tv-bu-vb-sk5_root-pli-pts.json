  "pli-tv-bu-vb-sk5:1.0": "",
  "pli-tv-bu-vb-sk5:1.1": "Tena samayena . . . Anāthapiṇḍikassa ārāme. ",
  "pli-tv-bu-vb-sk5:1.2": "tena kho pana samayena chabbaggiyā bhikkhū hattham pi pādam pi kīḷāpentā antaraghare gacchanti (nisīdanti) --pa--. ",
  "pli-tv-bu-vb-sk5:1.3.0": "",
  "pli-tv-bu-vb-sk5:1.3.1": "susaṃvuto antaraghare gamissāmīti (nisīdissāmīti) sikkhā karaṇīyā. ",
  "pli-tv-bu-vb-sk5:1.4": "susaṃvutena antaraghare gantabbaṃ (nis-). ",
  "pli-tv-bu-vb-sk5:1.5": "yo anādariyaṃ paṭicca hatthaṃ vā pādaṃ vā kīḷāpento antaraghare gacchati (nis-), āpatti dukkaṭassa. ",
  "pli-tv-bu-vb-sk5:1.6.0": "",
  "pli-tv-bu-vb-sk5:1.6.1": "anāpatti ",
  "pli-tv-bu-vb-sk5:1.7": "asañcicca, ",
  "pli-tv-bu-vb-sk5:1.8": "asatiyā, ",
  "pli-tv-bu-vb-sk5:1.9": "ajānantassa, ",
  "pli-tv-bu-vb-sk5:1.10": "gilānassa, ",
  "pli-tv-bu-vb-sk5:1.11": "ummattakassa, ",
  "pli-tv-bu-vb-sk5:1.12": "ādikammikassā ",
  "pli-tv-bu-vb-sk5:1.13": "'ti. ||5.6|| "
}
