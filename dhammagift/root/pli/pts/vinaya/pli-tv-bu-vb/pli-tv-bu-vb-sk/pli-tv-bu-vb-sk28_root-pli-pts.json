  "pli-tv-bu-vb-sk28:1.0": "",
  "pli-tv-bu-vb-sk28:1.1": "Tena samayena . . . Anāthapiṇḍikassa ārāme. ",
  "pli-tv-bu-vb-sk28:1.2": "tena kho pana samayena chabbaggiyā bhikkhū tahaṃ tahaṃ olokentā piṇḍapātaṃ paṭigaṇhanti ākirante pi atikkante pi na jānanti --pa--. ",
  "pli-tv-bu-vb-sk28:1.3.0": "",
  "pli-tv-bu-vb-sk28:1.3.1": "pattasaññī piṇḍapātaṃ paṭiggahessāmīti sikkhā karaṇīyā. ",
  "pli-tv-bu-vb-sk28:1.4": "pattasaññinā piṇḍapāto paṭiggahetabbo. ",
  "pli-tv-bu-vb-sk28:1.5": "yo anādariyaṃ paṭicca tahaṃ tahaṃ olokento piṇḍapātaṃ paṭigaṇhāti, āpatti dukkaṭassa. ",
  "pli-tv-bu-vb-sk28:1.6.0": "",
  "pli-tv-bu-vb-sk28:1.6.1": "anāpatti ",
  "pli-tv-bu-vb-sk28:1.7.1": "asañcicca --pa-- ",
  "pli-tv-bu-vb-sk28:1.7.2": "",
  "pli-tv-bu-vb-sk28:1.7.3": "",
  "pli-tv-bu-vb-sk28:1.7.4": "",
  "pli-tv-bu-vb-sk28:1.7.5": "",
  "pli-tv-bu-vb-sk28:1.7.6": "",
  "pli-tv-bu-vb-sk28:1.8": "ummattakassa, ",
  "pli-tv-bu-vb-sk28:1.9": "ādikammikassā 'ti. ||28|| "
