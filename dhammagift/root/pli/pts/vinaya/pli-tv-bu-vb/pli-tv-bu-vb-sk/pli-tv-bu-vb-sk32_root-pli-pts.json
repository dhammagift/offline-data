  "pli-tv-bu-vb-sk32:1.0": "",
  "pli-tv-bu-vb-sk32:1.1": "Tena samayena . . . Anāthapiṇḍikassa ārāme. ",
  "pli-tv-bu-vb-sk32:1.2": "tena kho pana samayena chabbaggiyā bhikkhū tahaṃ tahaṃ olokentā piṇḍapātaṃ bhuñjanti ākirante pi atikkante pi na jānanti --pa--. ",
  "pli-tv-bu-vb-sk32:1.3.0": "",
  "pli-tv-bu-vb-sk32:1.3.1": "pattasaññī piṇḍapātaṃ bhuñjissāmīti sikkhā karaṇīyā. ",
  "pli-tv-bu-vb-sk32:1.4": "pattasaññinā piṇḍapāto bhuñjitabbo. ",
  "pli-tv-bu-vb-sk32:1.5": "yo anādariyaṃ paṭicca tahaṃ tahaṃ olokento piṇḍapātaṃ bhuñjati, āpatti dukkaṭassa. ",
  "pli-tv-bu-vb-sk32:1.6.0": "",
  "pli-tv-bu-vb-sk32:1.6.1": "anāpatti ",
  "pli-tv-bu-vb-sk32:1.7.1": "asañcicca --pa-- ",
  "pli-tv-bu-vb-sk32:1.7.2": "",
  "pli-tv-bu-vb-sk32:1.7.3": "",
  "pli-tv-bu-vb-sk32:1.7.4": "",
