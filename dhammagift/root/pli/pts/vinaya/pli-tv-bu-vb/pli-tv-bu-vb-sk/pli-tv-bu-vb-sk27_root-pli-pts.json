  "pli-tv-bu-vb-sk27:1.0": "",
  "pli-tv-bu-vb-sk27:1.1": "Tena samayena . . . Anāthapiṇḍikassa ārāme. ",
  "pli-tv-bu-vb-sk27:1.2": "tena kho pana samayena chabbaggiyā bhikkhū asakkaccaṃ piṇḍapātaṃ paṭigaṇhanti chaḍḍetukāmā viya --pa--. ",
  "pli-tv-bu-vb-sk27:1.3.0": "",
  "pli-tv-bu-vb-sk27:1.3.1": "sakkaccaṃ piṇḍapātaṃ paṭiggahessāmīti sikkhā karaṇīyā. ",
  "pli-tv-bu-vb-sk27:1.4": "sakkaccaṃ piṇḍapāto paṭiggahetabbo. ",
  "pli-tv-bu-vb-sk27:1.5": "yo anādariyaṃ paṭicca asakkaccaṃ piṇḍapātaṃ paṭigaṇhāti chaḍḍetukāmo viya, āpatti dukkaṭassa. ",
  "pli-tv-bu-vb-sk27:1.6.0": "",
  "pli-tv-bu-vb-sk27:1.6.1": "anāpatti ",
  "pli-tv-bu-vb-sk27:1.7.1": "asañcicca --pa-- ",
  "pli-tv-bu-vb-sk27:1.7.2": "",
  "pli-tv-bu-vb-sk27:1.7.3": "",
  "pli-tv-bu-vb-sk27:1.7.4": "",
