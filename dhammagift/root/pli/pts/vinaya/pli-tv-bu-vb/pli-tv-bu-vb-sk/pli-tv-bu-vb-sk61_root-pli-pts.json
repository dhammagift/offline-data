  "pli-tv-bu-vb-sk61:1.0": "",
  "pli-tv-bu-vb-sk61:1.1": "Tena samayena . . . Anāthapiṇḍikassa ārāme. ",
  "pli-tv-bu-vb-sk61:1.2": "tena kho pana samayena chabbaggiyā bhikkhū pādukārūḷhassa dhammaṃ desenti --pa--. ",
  "pli-tv-bu-vb-sk61:1.3.0": "",
  "pli-tv-bu-vb-sk61:1.3.1": "na pādukārūḷhassa agilānassa dhammaṃ desessāmīti sikkhā karaṇīyā. ",
  "pli-tv-bu-vb-sk61:1.4": "na pādukārūḷhassa agilānassa dhammo desetabbo. ",
  "pli-tv-bu-vb-sk61:1.5": "yo anādariyaṃ paṭicca akkantassa vā paṭimukkassa vā omukkassa vā agilānassa dhammaṃ deseti, āpatti dukkaṭassa. ",
  "pli-tv-bu-vb-sk61:1.6.0": "",
  "pli-tv-bu-vb-sk61:1.6.1": "anāpatti ",
  "pli-tv-bu-vb-sk61:1.7.1": "asañcicca --pa-- ",
  "pli-tv-bu-vb-sk61:1.7.2": "",
  "pli-tv-bu-vb-sk61:1.7.3": "",
  "pli-tv-bu-vb-sk61:1.7.4": "",
  "pli-tv-bu-vb-sk61:1.7.5": "",
  "pli-tv-bu-vb-sk61:1.7.6": "",
  "pli-tv-bu-vb-sk61:1.8": "ādikammikassā ",
  "pli-tv-bu-vb-sk61:1.9": "'ti. ||61|| "
}
