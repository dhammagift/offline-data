  "pli-tv-bu-vb-sk26:1.0": "",
  "pli-tv-bu-vb-sk26:1.1": "Tena samayena . . . Anāthapiṇḍikassa ārāme. ",
  "pli-tv-bu-vb-sk26:1.2": "tena kho pana samayena chabbaggiyā bhikkhū pallatthikāya antaraghare nisīdanti --pa--. ",
  "pli-tv-bu-vb-sk26:1.3.0": "",
  "pli-tv-bu-vb-sk26:1.3.1": "na pallatthikāya antaraghare nisīdissāmīti sikkhā karaṇīyā. ",
  "pli-tv-bu-vb-sk26:1.4": "na pallatthikāya antaraghare nisīditabbaṃ. ",
  "pli-tv-bu-vb-sk26:1.5": "yo anādariyaṃ paṭicca hatthapallatthikāya vā dussapallatthikāya vā antaraghare nisīdati, āpatti dukkaṭassa. ",
  "pli-tv-bu-vb-sk26:1.6.0": "",
  "pli-tv-bu-vb-sk26:1.6.1": "anāpatti ",
  "pli-tv-bu-vb-sk26:1.7": "asañcicca, ",
  "pli-tv-bu-vb-sk26:1.8": "asatiyā, ",
  "pli-tv-bu-vb-sk26:1.9": "ajānantassa, ",
  "pli-tv-bu-vb-sk26:1.10": "gilānassa, ",
  "pli-tv-bu-vb-sk26:1.11": "vāsūpagatassa, ",
  "pli-tv-bu-vb-sk26:1.12": "āpadāsu, ",
  "pli-tv-bu-vb-sk26:1.13": "ummattakassa, ",
  "pli-tv-bu-vb-sk26:1.14": "ādikammikassā 'ti. ||26|| ",
  "pli-tv-bu-vb-sk26:1.15": ""
}
