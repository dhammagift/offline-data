  "pli-tv-bu-vb-sk11:1.0": "",
  "pli-tv-bu-vb-sk11:1.1": "Tena samayena . . . Anāthapiṇḍikassa ārāme. ",
  "pli-tv-bu-vb-sk11:1.2": "tena kho pana samayena chabbaggiyā bhikkhū mahāhasitaṃ hasantā antaraghare gacchanti (nisīdanti) --pa--. ",
  "pli-tv-bu-vb-sk11:1.3.0": "",
  "pli-tv-bu-vb-sk11:1.3.1": "na ujjhaggikāya antaraghare gamissāmīti (nisīdissāmīti) sikkhā karaṇīyā. ",
  "pli-tv-bu-vb-sk11:1.4": "na ujjhaggikāya antaraghare gantabbaṃ (nis-). ",
  "pli-tv-bu-vb-sk11:1.5": "yo anādariyaṃ paṭicca mahāhasitaṃ hasanto antaraghare gacchati (nis-), āpatti dukkaṭassa. ",
  "pli-tv-bu-vb-sk11:1.6.0": "",
  "pli-tv-bu-vb-sk11:1.6.1": "anāpatti ",
  "pli-tv-bu-vb-sk11:1.7": "asañcicca, ",
  "pli-tv-bu-vb-sk11:1.8": "asatiyā, ",
  "pli-tv-bu-vb-sk11:1.9": "ajānantassa, ",
  "pli-tv-bu-vb-sk11:1.10": "gilānassa, ",
  "pli-tv-bu-vb-sk11:1.11": "hasanīyasmiṃ vatthusmiṃ mihitamattaṃ karoti, ",
  "pli-tv-bu-vb-sk11:1.12": "āpadāsu, ",
  "pli-tv-bu-vb-sk11:1.13": "ummattakassa, ",
  "pli-tv-bu-vb-sk11:1.14": "ādikammikassā ",
  "pli-tv-bu-vb-sk11:1.15": "'ti. ||11.12|| "
}
