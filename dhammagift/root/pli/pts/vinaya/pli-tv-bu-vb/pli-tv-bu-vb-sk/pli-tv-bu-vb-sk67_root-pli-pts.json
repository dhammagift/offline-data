  "pli-tv-bu-vb-sk67:1.0": "",
  "pli-tv-bu-vb-sk67:1.1": "Tena samayena . . . Anāthapiṇḍikassa ārāme. ",
  "pli-tv-bu-vb-sk67:1.2": "tena kho pana samayena chabbaggiyā bhikkhū oguṇṭhitasīsassa dhammaṃ desenti --pa--. ",
  "pli-tv-bu-vb-sk67:1.3.0": "",
  "pli-tv-bu-vb-sk67:1.3.1": "na oguṇṭhitasīsassa agilānassa dhammaṃ desessāmīti sikkhā karaṇīyā. ",
  "pli-tv-bu-vb-sk67:1.4.0": "",
  "pli-tv-bu-vb-sk67:1.4.1": "oguṇṭhitasīso nāma ",
  "pli-tv-bu-vb-sk67:1.5": "sasīsaṃ pāruto vuccati. ",
  "pli-tv-bu-vb-sk67:1.6": "na oguṇṭhitasīsassa agilānassa dhammo desetabbo. ",
  "pli-tv-bu-vb-sk67:1.7": "yo anādariyaṃ paṭicca oguṇṭhitasīsassa agilānassa dhammaṃ deseti, āpatti dukkaṭassa. ",
  "pli-tv-bu-vb-sk67:1.8.0": "",
  "pli-tv-bu-vb-sk67:1.8.1": "anāpatti ",
  "pli-tv-bu-vb-sk67:1.9": "asañcicca, ",
  "pli-tv-bu-vb-sk67:1.10": "asatiyā, ",
  "pli-tv-bu-vb-sk67:1.11": "ajānantassa, ",
  "pli-tv-bu-vb-sk67:1.12": "gilānassa, ",
  "pli-tv-bu-vb-sk67:1.13": "sīsaṃ vivarāpetvā deseti, ",
  "pli-tv-bu-vb-sk67:1.14": "āpadāsu, ",
  "pli-tv-bu-vb-sk67:1.15": "ummattakassa, ",
  "pli-tv-bu-vb-sk67:1.16": "ādikammikassā 'ti. ||67|| ",
  "pli-tv-bu-vb-sk67:1.17": ""
}
