  "pli-tv-bu-vb-sk30:1.0": "",
  "pli-tv-bu-vb-sk30:1.1": "Tena samayena . . . Anāthapiṇḍikassa ārāme. ",
  "pli-tv-bu-vb-sk30:1.2": "tena kho pana samayena chabbaggiyā bhikkhū thūpikataṃ piṇḍapātaṃ paṭigaṇhanti --pa--. ",
  "pli-tv-bu-vb-sk30:1.3.0": "",
  "pli-tv-bu-vb-sk30:1.3.1": "samatitthikaṃ piṇḍapātaṃ paṭiggahessāmīti sikkhā karaṇīyā. ",
  "pli-tv-bu-vb-sk30:1.4": "samatitthiko piṇḍapāto paṭiggahetabbo. ",
  "pli-tv-bu-vb-sk30:1.5": "yo anādariyaṃ paṭicca thūpikataṃ piṇḍapātaṃ paṭigaṇhāti, āpatti dukkaṭassa. ",
  "pli-tv-bu-vb-sk30:1.6.0": "",
  "pli-tv-bu-vb-sk30:1.6.1": "anāpatti ",
  "pli-tv-bu-vb-sk30:1.7.1": "asañcicca, ",
  "pli-tv-bu-vb-sk30:1.7.2": "asatiyā, ",
  "pli-tv-bu-vb-sk30:1.7.3": "ajānantassa, ",
  "pli-tv-bu-vb-sk30:1.7.4": "āpadāsu, ",
  "pli-tv-bu-vb-sk30:1.8": "ummattakassa, ",
  "pli-tv-bu-vb-sk30:1.9": "ādikammikassā ",
  "pli-tv-bu-vb-sk30:1.10": "'ti. ||30|| ",
