  "pli-tv-bu-vb-sk38:1.0": "",
  "pli-tv-bu-vb-sk38:1.1": "Tena samayena . . . Anāthapiṇḍikassa ārāme. ",
  "pli-tv-bu-vb-sk38:1.2": "tena kho pana samayena chabbaggiyā bhikkhū ujjhānasaññī paresaṃ pattaṃ olokenti --pa--. ",
  "pli-tv-bu-vb-sk38:1.3.0": "",
  "pli-tv-bu-vb-sk38:1.3.1": "na ujjhānasaññī paresaṃ pattaṃ olokessāmīti sikkhā karaṇīyā. ",
  "pli-tv-bu-vb-sk38:1.4": "na ujjhānasaññinā paresaṃ patto oloketabbo. ",
  "pli-tv-bu-vb-sk38:1.5": "yo anādariyaṃ paṭicca ujjhānasaññī paresaṃ pattaṃ oloketi, āpatti dukkaṭassa. ",
  "pli-tv-bu-vb-sk38:1.6.0": "",
  "pli-tv-bu-vb-sk38:1.6.1": "anāpatti ",
  "pli-tv-bu-vb-sk38:1.7.1": "asañcicca, ",
  "pli-tv-bu-vb-sk38:1.7.2": "asatiyā, ",
  "pli-tv-bu-vb-sk38:1.7.3": "ajānantassa, ",
  "pli-tv-bu-vb-sk38:1.7.4": "dassāmīti vā dāpessāmīti vā oloketi, ",
  "pli-tv-bu-vb-sk38:1.7.5": "na ujjhānasaññissa, ",
  "pli-tv-bu-vb-sk38:1.7.6": "āpadāsu, ",
  "pli-tv-bu-vb-sk38:1.8": "ummattakassa, ",
  "pli-tv-bu-vb-sk38:1.9": "ādikammikassā ",
  "pli-tv-bu-vb-sk38:1.10": "'ti. ||38|| "
}
