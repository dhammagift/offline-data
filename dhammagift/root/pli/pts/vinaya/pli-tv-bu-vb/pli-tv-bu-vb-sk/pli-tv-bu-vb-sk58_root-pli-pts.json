  "pli-tv-bu-vb-sk58:1.0": "",
  "pli-tv-bu-vb-sk58:1.1": "Tena samayena . . . Anāthapiṇḍikassa ārāme. ",
  "pli-tv-bu-vb-sk58:1.2": "tena kho pana samayena chabbaggiyā bhikkhū daṇḍapāṇissa dhammaṃ desenti --pa--. ",
  "pli-tv-bu-vb-sk58:1.3.0": "",
  "pli-tv-bu-vb-sk58:1.3.1": "na daṇḍapāṇissa agilānassa dhammaṃ desessāmīti sikkhā karaṇīyā. ",
  "pli-tv-bu-vb-sk58:1.4.0": "",
  "pli-tv-bu-vb-sk58:1.4.1": "daṇḍo nāma ",
  "pli-tv-bu-vb-sk58:1.5": "majjhimassa purisassa catuhattho daṇḍo. ",
  "pli-tv-bu-vb-sk58:1.6": "tato ukkaṭṭho adaṇḍo, omako adaṇḍo. ",
  "pli-tv-bu-vb-sk58:1.7": "na daṇḍapāṇissa agilānassa dhammo desetabbo. ",
  "pli-tv-bu-vb-sk58:1.8": "yo anādariyaṃ paṭicca daṇḍapāṇissa agilānassa dhammaṃ deseti, āpatti dukkaṭassa. ",
  "pli-tv-bu-vb-sk58:1.9.0": "",
  "pli-tv-bu-vb-sk58:1.9.1": "anāpatti ",
  "pli-tv-bu-vb-sk58:1.10.1": "asañcicca --pa-- ",
  "pli-tv-bu-vb-sk58:1.10.2": "",
  "pli-tv-bu-vb-sk58:1.10.3": "",
  "pli-tv-bu-vb-sk58:1.10.4": "",
  "pli-tv-bu-vb-sk58:1.10.5": "",
  "pli-tv-bu-vb-sk58:1.10.6": "",
  "pli-tv-bu-vb-sk58:1.11": "ādikammikassā 'ti. ||58|| ",
  "pli-tv-bu-vb-sk58:1.12": ""
}
