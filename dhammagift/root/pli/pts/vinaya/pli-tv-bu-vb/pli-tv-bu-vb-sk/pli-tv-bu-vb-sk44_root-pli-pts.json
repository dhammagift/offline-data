  "pli-tv-bu-vb-sk44:1.0": "",
  "pli-tv-bu-vb-sk44:1.1": "Tena samayena . . . Anāthapiṇḍikassa ārāme. ",
  "pli-tv-bu-vb-sk44:1.2": "tena kho pana samayena chabbaggiyā bhikkhū piṇḍukkhepakaṃ bhuñjanti --pa--. ",
  "pli-tv-bu-vb-sk44:1.3.0": "",
  "pli-tv-bu-vb-sk44:1.3.1": "na piṇḍukkhepakaṃ bhuñjissāmīti sikkhā karaṇīyā. ",
  "pli-tv-bu-vb-sk44:1.4": "na piṇḍukkhepakaṃ bhuñjitabbaṃ. ",
  "pli-tv-bu-vb-sk44:1.5": "yo anādariyaṃ paṭicca piṇḍukkhepakaṃ bhuñjati, āpatti dukkaṭassa. ",
  "pli-tv-bu-vb-sk44:1.6.0": "",
  "pli-tv-bu-vb-sk44:1.6.1": "anāpatti ",
  "pli-tv-bu-vb-sk44:1.7": "asañcicca, ",
  "pli-tv-bu-vb-sk44:1.8": "asatiyā, ",
  "pli-tv-bu-vb-sk44:1.9": "ajānantassa, ",
  "pli-tv-bu-vb-sk44:1.10": "gilānassa, ",
  "pli-tv-bu-vb-sk44:1.11": "khajjake, ",
  "pli-tv-bu-vb-sk44:1.12": "phalāphale, ",
  "pli-tv-bu-vb-sk44:1.13": "āpadāsu, ",
  "pli-tv-bu-vb-sk44:1.14": "ummattakassa, ",
  "pli-tv-bu-vb-sk44:1.15": "ādikammikassā ",
  "pli-tv-bu-vb-sk44:1.16": "'ti. ||44|| "
}
