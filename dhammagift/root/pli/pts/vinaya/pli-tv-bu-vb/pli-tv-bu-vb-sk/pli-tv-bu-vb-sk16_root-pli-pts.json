  "pli-tv-bu-vb-sk16:1.0": "",
  "pli-tv-bu-vb-sk16:1.1": "",
  "pli-tv-bu-vb-sk16:1.2": "(nisīdanti) kāyaṃ olambentā --pa--. ",
  "pli-tv-bu-vb-sk16:1.3.0": "",
  "pli-tv-bu-vb-sk16:1.3.1": "na kāyappacālakaṃ antaraghare gamissāmīti (nisīdissāmīti) sikkhā karaṇīyā. ",
  "pli-tv-bu-vb-sk16:1.4": "na kāyappacālakaṃ antaraghare gantabbaṃ (nis-). ",
  "pli-tv-bu-vb-sk16:1.5": "kāyaṃ paggahetvā gantabbaṃ (nis-). ",
  "pli-tv-bu-vb-sk16:1.6": "yo anādariyaṃ paṭicca kāyappacālakaṃ antaraghare gacchati (nis-) kāyaṃ olambento, āpatti dukkaṭassa. ",
  "pli-tv-bu-vb-sk16:1.7.0": "",
  "pli-tv-bu-vb-sk16:1.7.1": "anāpatti ",
  "pli-tv-bu-vb-sk16:1.8": "asañcicca, ",
  "pli-tv-bu-vb-sk16:1.9": "asatiyā, ",
  "pli-tv-bu-vb-sk16:1.10": "ajānantassa, ",
  "pli-tv-bu-vb-sk16:1.11": "gilānassa, (in chap.16 it is added here, ",
  "pli-tv-bu-vb-sk16:1.12": "vāsūpagatassa), ",
  "pli-tv-bu-vb-sk16:1.13": "āpadāsu, ",
  "pli-tv-bu-vb-sk16:1.14": "ummattakassa, ",
  "pli-tv-bu-vb-sk16:1.15": "ādikammikassā 'ti. ||15.16|| ",
  "pli-tv-bu-vb-sk16:1.16": ""
}
