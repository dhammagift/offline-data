  "pli-tv-bu-vb-sk41:1.0": "",
  "pli-tv-bu-vb-sk41:1.1": "Tena samayena . . . Anāthapiṇḍikassa ārāme. ",
  "pli-tv-bu-vb-sk41:1.2": "tena kho pana samayena chabbaggiyā bhikkhū anāhaṭe kabaḷe mukhadvāraṃ vivaranti --pa--. ",
  "pli-tv-bu-vb-sk41:1.3.0": "",
  "pli-tv-bu-vb-sk41:1.3.1": "na anāhaṭe kabaḷe mukhadvāraṃ vivarissāmīti sikkhā karaṇīyā. ",
  "pli-tv-bu-vb-sk41:1.4": "na anāhaṭe kabaḷe mukhadvāraṃ vivaritabbaṃ. ",
  "pli-tv-bu-vb-sk41:1.5": "yo anādariyaṃ paṭicca anāhaṭe kabaḷe mukhadvāraṃ vivarati, āpatti dukkaṭassa. ",
  "pli-tv-bu-vb-sk41:1.6.0": "",
  "pli-tv-bu-vb-sk41:1.6.1": "anāpatti ",
  "pli-tv-bu-vb-sk41:1.7.1": "asañcicca, asatiyā ",
  "pli-tv-bu-vb-sk41:1.7.2": "",
  "pli-tv-bu-vb-sk41:1.7.3": "",
  "pli-tv-bu-vb-sk41:1.7.4": "",
  "pli-tv-bu-vb-sk41:1.7.5": "",
  "pli-tv-bu-vb-sk41:1.7.6": "",
  "pli-tv-bu-vb-sk41:1.8": "--pa-- ādikammikassā 'ti. ||41|| ",
