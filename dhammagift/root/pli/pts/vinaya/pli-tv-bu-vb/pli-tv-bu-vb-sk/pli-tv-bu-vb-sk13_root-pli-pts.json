  "pli-tv-bu-vb-sk13:1.0": "",
  "pli-tv-bu-vb-sk13:1.1": "Anāthapiṇḍikassa ārāme. ",
  "pli-tv-bu-vb-sk13:1.2": "tena kho pana samayena chabbaggiyā bhikkhū uccāsaddaṃ mahāsaddaṃ karontā antaraghare gacchanti (nisīdanti) --pa--. ",
  "pli-tv-bu-vb-sk13:1.3.0": "",
  "pli-tv-bu-vb-sk13:1.3.1": "appasaddo antaraghare gamissāmīti (nisīdissāmīti) sikkhā karaṇīyā. ",
  "pli-tv-bu-vb-sk13:1.4": "appasaddena antaraghare gantabbaṃ (nis-). ",
  "pli-tv-bu-vb-sk13:1.5": "yo anādariyaṃ paṭicca uccāsaddaṃ mahāsaddaṃ karonto antaraghare gacchati (nis-), āpatti dukkaṭassa. ",
  "pli-tv-bu-vb-sk13:1.6.0": "",
  "pli-tv-bu-vb-sk13:1.6.1": "anāpatti ",
  "pli-tv-bu-vb-sk13:1.7": "asañcicca, ",
  "pli-tv-bu-vb-sk13:1.8": "asatiyā, ",
  "pli-tv-bu-vb-sk13:1.9": "ajānantassa, ",
  "pli-tv-bu-vb-sk13:1.10": "gilānassa, ",
  "pli-tv-bu-vb-sk13:1.11": "āpadāsu, ",
  "pli-tv-bu-vb-sk13:1.12": "ummattakassa, ",
  "pli-tv-bu-vb-sk13:1.13": "ādikammikassā 'ti. ||13.14|| ",
  "pli-tv-bu-vb-sk13:1.14": ""
}
