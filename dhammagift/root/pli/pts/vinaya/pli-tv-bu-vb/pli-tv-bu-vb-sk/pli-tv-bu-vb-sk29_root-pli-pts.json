  "pli-tv-bu-vb-sk29:1.0": "",
  "pli-tv-bu-vb-sk29:1.1": "Tena samayena . . . Anāthapiṇḍikassa ārāme. ",
  "pli-tv-bu-vb-sk29:1.2": "tena kho pana samayena chabbaggiyā bhikkhū piṇḍapātaṃ paṭigaṇhantā sūpañ ñeva bahuṃ paṭigaṇhanti --pa--. ",
  "pli-tv-bu-vb-sk29:1.3.0": "",
  "pli-tv-bu-vb-sk29:1.3.1": "samasūpakaṃ piṇḍapātaṃ paṭiggahessāmīti sikkhā karaṇīyā. ",
  "pli-tv-bu-vb-sk29:1.4.0": "",
  "pli-tv-bu-vb-sk29:1.4.1": "sūpo nāma ",
  "pli-tv-bu-vb-sk29:1.5": "dve sūpā muggasūpo māsasūpo hatthahāriyo. ",
  "pli-tv-bu-vb-sk29:1.6": "samasūpako piṇḍapāto paṭiggahetabbo. ",
  "pli-tv-bu-vb-sk29:1.7": "yo anādariyaṃ paṭicca sūpañ ñeva bahuṃ paṭigaṇhāti, āpatti dukkaṭassa. ",
  "pli-tv-bu-vb-sk29:1.8.0": "",
  "pli-tv-bu-vb-sk29:1.8.1": "anāpatti ",
  "pli-tv-bu-vb-sk29:1.9": "asañcicca, ",
  "pli-tv-bu-vb-sk29:1.10": "asatiyā, ",
  "pli-tv-bu-vb-sk29:1.11": "ajānantassa, ",
  "pli-tv-bu-vb-sk29:1.12": "gilānassa, ",
  "pli-tv-bu-vb-sk29:1.13": "rasarase, ",
  "pli-tv-bu-vb-sk29:1.14": "ñātakānaṃ, ",
  "pli-tv-bu-vb-sk29:1.15": "pavāritānaṃ, ",
  "pli-tv-bu-vb-sk29:1.16": "aññass' atthāya, ",
  "pli-tv-bu-vb-sk29:1.17": "attano dhanena, ",
  "pli-tv-bu-vb-sk29:1.18": "āpadāsu, ",
  "pli-tv-bu-vb-sk29:1.19": "ummattakassa, ",
  "pli-tv-bu-vb-sk29:1.20": "ādikammikassā ",
  "pli-tv-bu-vb-sk29:1.21": "'ti. ||29|| "
}
