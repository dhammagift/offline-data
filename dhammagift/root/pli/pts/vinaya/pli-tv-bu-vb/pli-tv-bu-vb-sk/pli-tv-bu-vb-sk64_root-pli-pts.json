  "pli-tv-bu-vb-sk64:1.0": "",
  "pli-tv-bu-vb-sk64:1.1": "Tena samayena . . . Anāthapiṇḍikassa ārāme. ",
  "pli-tv-bu-vb-sk64:1.2": "tena kho pana samayena chabbaggiyā bhikkhū sayanagatassa dhammaṃ desenti --pa--. ",
  "pli-tv-bu-vb-sk64:1.3.0": "",
  "pli-tv-bu-vb-sk64:1.3.1": "na sayanagatassa agilānassa dhammaṃ desessāmīti sikkhā karaṇīyā. ",
  "pli-tv-bu-vb-sk64:1.4": "na sayanagatassa agilānassa dhammo desetabbo. ",
  "pli-tv-bu-vb-sk64:1.5": "yo anādariyaṃ paṭicca antamaso chamāya pi nipannassa sayanagatassa agilānassa dhammaṃ deseti, āpatti dukkaṭassa. ",
  "pli-tv-bu-vb-sk64:1.6.0": "",
  "pli-tv-bu-vb-sk64:1.6.1": "anāpatti ",
  "pli-tv-bu-vb-sk64:1.7.1": "asañcicca --pa-- ",
  "pli-tv-bu-vb-sk64:1.7.2": "",
  "pli-tv-bu-vb-sk64:1.7.3": "",
  "pli-tv-bu-vb-sk64:1.7.4": "",
  "pli-tv-bu-vb-sk64:1.7.5": "",
  "pli-tv-bu-vb-sk64:1.7.6": "",
  "pli-tv-bu-vb-sk64:1.8": "ādikammikassā 'ti. ||64|| ",
