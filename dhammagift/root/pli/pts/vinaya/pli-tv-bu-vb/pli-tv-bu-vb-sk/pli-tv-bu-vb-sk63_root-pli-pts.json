  "pli-tv-bu-vb-sk63:1.0": "",
  "pli-tv-bu-vb-sk63:1.1": "Tena samayena . . . Anāthapiṇḍikassa ārāme. ",
  "pli-tv-bu-vb-sk63:1.2": "tena kho pana samayena chabbaggiyā bhikkhū yānagatassa dhammaṃ desenti --pa--. ",
  "pli-tv-bu-vb-sk63:1.3.0": "",
  "pli-tv-bu-vb-sk63:1.3.1": "na yānagatassa agilānassa dhammaṃ desessāmīti sikkhā karaṇīyā. ",
  "pli-tv-bu-vb-sk63:1.4.0": "",
  "pli-tv-bu-vb-sk63:1.4.1": "yānaṃ nāma ",
  "pli-tv-bu-vb-sk63:1.5": "vayhaṃ ratho sakaṭaṃ sandamānikā sivikā pāṭaṅkī. ",
  "pli-tv-bu-vb-sk63:1.6": "na yānagatassa agilānassa dhammo desetabbo. ",
  "pli-tv-bu-vb-sk63:1.7": "yo anādariyaṃ paṭicca yānagatassa agilānassa dhammaṃ deseti, āpatti dukkaṭassa. ",
  "pli-tv-bu-vb-sk63:1.8.0": "",
  "pli-tv-bu-vb-sk63:1.8.1": "anāpatti ",
  "pli-tv-bu-vb-sk63:1.9.1": "asañcicca --pa-- ",
  "pli-tv-bu-vb-sk63:1.9.2": "",
  "pli-tv-bu-vb-sk63:1.9.3": "",
  "pli-tv-bu-vb-sk63:1.9.4": "",
  "pli-tv-bu-vb-sk63:1.9.5": "",
  "pli-tv-bu-vb-sk63:1.9.6": "",
  "pli-tv-bu-vb-sk63:1.10": "ādikammikassā ",
  "pli-tv-bu-vb-sk63:1.11": "'ti. ||63|| "
}
