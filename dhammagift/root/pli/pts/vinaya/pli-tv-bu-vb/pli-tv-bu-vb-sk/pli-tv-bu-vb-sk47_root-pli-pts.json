  "pli-tv-bu-vb-sk47:1.0": "",
  "pli-tv-bu-vb-sk47:1.1": "Tena samayena . . . Anāthapiṇḍikassa ārāme. ",
  "pli-tv-bu-vb-sk47:1.2": "tena kho pana samayena chabbaggiyā bhikkhū hatthaniddhunakaṃ bhuñjanti --pa--. ",
  "pli-tv-bu-vb-sk47:1.3.0": "",
  "pli-tv-bu-vb-sk47:1.3.1": "na hatthaniddhunakaṃ bhuñjissāmīti sikkhā karaṇīyā. ",
  "pli-tv-bu-vb-sk47:1.4": "na hatthaniddhunakaṃ bhuñjitabbaṃ. ",
  "pli-tv-bu-vb-sk47:1.5": "yo anādariyaṃ paṭicca hatthaniddhunakaṃ bhuñjati, āpatti dukkaṭassa. ",
  "pli-tv-bu-vb-sk47:1.6.0": "",
  "pli-tv-bu-vb-sk47:1.6.1": "anāpatti ",
  "pli-tv-bu-vb-sk47:1.7": "asañcicca, ",
  "pli-tv-bu-vb-sk47:1.8": "asatiyā, ",
  "pli-tv-bu-vb-sk47:1.9": "ajānantassa, ",
  "pli-tv-bu-vb-sk47:1.10": "gilānassa, ",
  "pli-tv-bu-vb-sk47:1.11": "kacavaraṃ chaḍḍento hatthaṃ niddhunati, ",
  "pli-tv-bu-vb-sk47:1.12": "āpadāsu, ",
  "pli-tv-bu-vb-sk47:1.13": "ummattakassa, ",
  "pli-tv-bu-vb-sk47:1.14": "ādikammikassā ",
  "pli-tv-bu-vb-sk47:1.15": "'ti. ||47|| "
}
