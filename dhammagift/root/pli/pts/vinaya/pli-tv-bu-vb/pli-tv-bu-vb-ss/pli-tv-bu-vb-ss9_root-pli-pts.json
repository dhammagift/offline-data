  "pli-tv-bu-vb-ss9:3.1.0.1": "",
  "pli-tv-bu-vb-ss9:3.1.0.2": "",
  "pli-tv-bu-vb-ss9:3.1.1": "bhikkhu saṃghādisesaṃ ajjhāpajjanto diṭṭho hoti, saṃghādisese saṃghādisesadiṭṭhi hoti. ",
  "pli-tv-bu-vb-ss9:3.1.2": "tañ ce pārājikena codeti ",
  "pli-tv-bu-vb-ss9:3.1.3": "asamaṇo ",
  "pli-tv-bu-vb-ss9:3.1.4": "'si . . . saṃghakammaṃ vā 'ti, ",
  "pli-tv-bu-vb-ss9:3.1.5": "evaṃ pi āpattaññabhāgiyaṃ hoti leso ca upādinno, āpatti vācāya vācāya saṃghādisesassa. ",
  "pli-tv-bu-vb-ss9:3.1.6": "bhikkhu saṃghādisesaṃ ajjhāpajjanto diṭṭho hoti, saṃghādisese thullaccayadiṭṭhi hoti --pa-- ",
  "pli-tv-bu-vb-ss9:3.1.7": "pācittiyadiṭṭhi hoti --pa-- ",
  "pli-tv-bu-vb-ss9:3.1.8": "pāṭidesaniyadiṭṭhi hoti --pa-- ",
  "pli-tv-bu-vb-ss9:3.1.9": "dukkaṭadiṭṭhi hoti --pa-- ",
  "pli-tv-bu-vb-ss9:3.1.10": "dubbhāsitadiṭṭhi hoti. ",
  "pli-tv-bu-vb-ss9:3.1.11": "tañ ce . . . ",
  "pli-tv-bu-vb-ss9:3.1.12": "",
  "pli-tv-bu-vb-ss9:3.1.13": "vācāya vācāya saṃghādisesassa. ",
  "pli-tv-bu-vb-ss9:3.1.14": "bhikkhu thullaccayaṃ --pa-- ",
  "pli-tv-bu-vb-ss9:3.1.15": "",
  "pli-tv-bu-vb-ss9:3.1.16": "",
  "pli-tv-bu-vb-ss9:3.1.17": "",
  "pli-tv-bu-vb-ss9:3.1.18": "",
  "pli-tv-bu-vb-ss9:3.1.19": "",
  "pli-tv-bu-vb-ss9:3.1.20": "",
  "pli-tv-bu-vb-ss9:3.1.21": "",
  "pli-tv-bu-vb-ss9:3.1.22": "",
  "pli-tv-bu-vb-ss9:3.1.23": "pācittiyaṃ --pa-- ",
  "pli-tv-bu-vb-ss9:3.1.24": "pāṭidesaniyaṃ --pa-- ",
  "pli-tv-bu-vb-ss9:3.1.25": "dukkaṭaṃ --pa-- ",
  "pli-tv-bu-vb-ss9:3.1.26": "dubbhāsitaṃ ajjhāpajjanto diṭṭho hoti, dubbhāsite dubbhāsitadiṭṭhi hoti. ",
  "pli-tv-bu-vb-ss9:3.1.27": "",
  "pli-tv-bu-vb-ss9:3.1.28": "",
  "pli-tv-bu-vb-ss9:3.1.29": "",
  "pli-tv-bu-vb-ss9:3.1.30": "",
  "pli-tv-bu-vb-ss9:3.1.31": "",
  "pli-tv-bu-vb-ss9:3.1.32": "tañ ce . . . ",
  "pli-tv-bu-vb-ss9:3.1.33": "",
  "pli-tv-bu-vb-ss9:3.1.34": "",
  "pli-tv-bu-vb-ss9:3.1.35": "vācāya vācāya saṃghādisesassa. bhikkhu dubbhāsitaṃ ajjhāpajjanto diṭṭho hoti, dubbhāsite saṃghādisesadiṭṭhi hoti, dubbhāsite thullaccayapācittiyapāṭidesaniyadukkaṭadiṭṭhi hoti. tañ ce . . . vācāya vācāya saṃghādisesassa. ",
  "pli-tv-bu-vb-ss9:3.1.36": "ekekaṃ mūlaṃ kātūna cakkaṃ bandhitabbaṃ. ||1|| ",
  "pli-tv-bu-vb-ss9:3.2.0": "",
  "pli-tv-bu-vb-ss9:3.2.1": "bhikkhu saṃghādisesaṃ ajjhāpajjanto diṭṭho hoti, saṃghādisese saṃghādisesadiṭṭhi hoti. ",
  "pli-tv-bu-vb-ss9:3.2.2": "tañ ce pārājikena codāpeti ",
  "pli-tv-bu-vb-ss9:3.2.3": "asamaṇo ",
  "pli-tv-bu-vb-ss9:3.2.4": "'si . . . vācāya vācāya saṃghādisesassa. ",
  "pli-tv-bu-vb-ss9:3.2.5": "bhikkhu saṃghādisesaṃ ajjhāpajjanto diṭṭho hoti, saṃghādisese thullaccayadiṭṭhi hoti --pa-- . . . ",
  "pli-tv-bu-vb-ss9:3.2.6": "",
