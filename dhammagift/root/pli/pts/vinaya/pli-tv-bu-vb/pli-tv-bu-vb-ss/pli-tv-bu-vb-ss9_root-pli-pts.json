  "pli-tv-bu-vb-ss9:1.1.0": "",
  "pli-tv-bu-vb-ss9:1.1.1": "Tena samayena buddho bhagavā Rājagahe viharati Veḷuvane Kalandakanivāpe. ",
  "pli-tv-bu-vb-ss9:1.1.2": "tena kho pana samayena Mettiyabhummajakā bhikkhū Gijjhakūṭā pabbatā orohantā addasaṃsu chakalakaṃ ajikāya vippaṭipajjantaṃ, ",
  "pli-tv-bu-vb-ss9:1.1.3": "disvāna evam āhaṃsu: ",
  "pli-tv-bu-vb-ss9:1.1.4": "handa mayaṃ āvuso imaṃ chakalakaṃ Dabbaṃ Mallaputtaṃ nāma karoma, ",
  "pli-tv-bu-vb-ss9:1.1.5": "imaṃ ajikaṃ Mettiyaṃ nāma bhikkhuniṃ karoma, ",
  "pli-tv-bu-vb-ss9:1.1.6": "evaṃ mayaṃ voharissāma: ",
  "pli-tv-bu-vb-ss9:1.1.7": "pubbe mayaṃ āvuso Dabbaṃ Mallaputtaṃ sutena avocumhā, ",
  "pli-tv-bu-vb-ss9:1.1.8": "idāni pana amhehi sāmaṃ diṭṭho Mettiyāya bhikkhuniyā vippaṭipajjanto 'ti. ",
  "pli-tv-bu-vb-ss9:1.1.9": "te taṃ chakalakaṃ Dabbaṃ Mallaputtaṃ nāma akaṃsu, ",
  "pli-tv-bu-vb-ss9:1.1.10": "taṃ ajikaṃ Mettiyaṃ nāma bhikkhuniṃ akaṃsu. ",
  "pli-tv-bu-vb-ss9:1.1.11": "te bhikkhūnaṃ ārocesuṃ: ",
  "pli-tv-bu-vb-ss9:1.1.12": "pubbe mayaṃ āvuso Dabbaṃ Mallaputtaṃ sutena avocumhā, ",
  "pli-tv-bu-vb-ss9:1.1.13": "idāni pana amhehi sāmaṃ diṭṭho Mettiyāya bhikkhuniyā vippaṭipajjanto 'ti. ",
  "pli-tv-bu-vb-ss9:1.1.14": "bhikkhū evam āhaṃsu: ",
  "pli-tv-bu-vb-ss9:1.1.15": "māvuso evaṃ avacuttha, ",
  "pli-tv-bu-vb-ss9:1.1.16": "nāyasmā Dabbo Mallaputto evaṃ karissatīti. ",
  "pli-tv-bu-vb-ss9:1.1.17": "atha kho te bhikkhū bhagavato etam atthaṃ ārocesuṃ. ",
  "pli-tv-bu-vb-ss9:1.1.18": "atha kho bhagavā etasmiṃ nidāne etasmiṃ pakaraṇe bhikkhusaṃghaṃ sannipātāpetvā āyasmantaṃ Dabbaṃ Mallaputtaṃ paṭipucchi: ",
  "pli-tv-bu-vb-ss9:1.1.19": "sarasi tvaṃ Dabba evarūpaṃ kattā yathā yime bhikkhū āhaṃsū 'ti. ",
  "pli-tv-bu-vb-ss9:1.1.20": "yathā maṃ bhante bhagavā jānātīti. ",
  "pli-tv-bu-vb-ss9:1.1.21": "dutiyam pi kho bhagavā --pa-- ",
  "pli-tv-bu-vb-ss9:1.1.22": "tatiyam pi kho bhagavā āyasmantaṃ Dabbaṃ Mallaputtaṃ etad avoca . . . ",
  "pli-tv-bu-vb-ss9:1.1.23": "",
  "pli-tv-bu-vb-ss9:1.1.24": "jānātīti. ",
  "pli-tv-bu-vb-ss9:1.1.25": "na kho Dabba . . . ",
  "pli-tv-bu-vb-ss9:1.1.26": "",
  "pli-tv-bu-vb-ss9:1.1.27": "",
  "pli-tv-bu-vb-ss9:1.1.28": "jāgaro 'ti. ",
  "pli-tv-bu-vb-ss9:1.1.29": "atha kho bhagavā bhikkhū āmantesi: tena hi bhikkhave ime bhikkhū anuyuñjathā 'ti. ",
  "pli-tv-bu-vb-ss9:1.1.30": "idaṃ vatvā bhagavā uṭṭhāyāsanā vihāraṃ pāvisi. ",
  "pli-tv-bu-vb-ss9:1.2.1": "||1||atha kho te bhikkhū Mettiyabhummajake bhikkhū anuyuñjiṃsu. ",
  "pli-tv-bu-vb-ss9:1.2.2": "te bhikkhūhi anuyuñjiyamānā bhikkhūnaṃ etam atthaṃ ārocesuṃ. ",
  "pli-tv-bu-vb-ss9:1.2.3": "kiṃ pana tumhe āvuso āyasmantaṃ Dabbaṃ Mallaputtaṃ aññabhāgiyassa adhikaraṇassa kiñci desaṃ lesamattaṃ upādāya pārājikena dhammena anuddhaṃsethā 'ti. ",
  "pli-tv-bu-vb-ss9:1.2.4": "evam āvuso 'ti. ",
  "pli-tv-bu-vb-ss9:1.2.5": "ye te bhikkhū appicchā te . . . vipācenti: ",
  "pli-tv-bu-vb-ss9:1.2.6": "kathaṃ hi nāma Mettiyabhummajakā bhikkhū āyasmantaṃ Dabbaṃ Mallaputtaṃ aññabhāgiyassa . . . anuddhaṃsessantīti. ",
  "pli-tv-bu-vb-ss9:1.2.7": "atha kho te bhikkhū bhagavato etam atthaṃ ārocesuṃ. ",
  "pli-tv-bu-vb-ss9:1.2.8": "saccaṃ kira tumhe bhikkhave Dabbaṃ Mallaputtaṃ aññabhāgiyassa . . . anuddhaṃsethā 'ti. ",
  "pli-tv-bu-vb-ss9:1.2.9": "saccaṃ bhagavā. ",
  "pli-tv-bu-vb-ss9:1.2.10": "vigarahi buddho bhagavā: kathaṃ ",
  "pli-tv-bu-vb-ss9:1.2.11": "hi nāma tumhe moghapurisā Dabbaṃ Mallaputtaṃ aññabhāgiyassa . . . anuddhaṃsessatha. ",
  "pli-tv-bu-vb-ss9:1.2.12": "n' etaṃ moghapurisā appasannānaṃ vā pasādāya --pa--, ",
  "pli-tv-bu-vb-ss9:1.2.13": "evañ ca pana bhikkhave imaṃ sikkhāpadaṃ uddiseyyātha: ",
  "pli-tv-bu-vb-ss9:1.2.14.0": "",
  "pli-tv-bu-vb-ss9:1.2.14.1": "yo pana bhikkhu bhikkhuṃ duṭṭho doso appatīto aññabhāgiyassa adhikaraṇassa kiñci desaṃ lesamattaṃ upādāya pārājikena dhammena anuddhaṃseyya app eva nāma naṃ imamhā brahmacariyā cāveyyan ti, ",
  "pli-tv-bu-vb-ss9:1.2.15": "tato aparena samayena samanuggāhiyamāno vā asamanuggāhiyamāno vā aññabhāgiyañ c' eva taṃ adhikaraṇaṃ hoti koci deso lesamatto upādinno bhikkhu ca dosaṃ patiṭṭhāti, saṃghādiseso 'ti. ||2||1|| ",
  "pli-tv-bu-vb-ss9:2.1.0": "",
  "pli-tv-bu-vb-ss9:2.1.1": "yo panā 'ti . . . ",
  "pli-tv-bu-vb-ss9:2.1.2": "",
  "pli-tv-bu-vb-ss9:2.1.3": "",
  "pli-tv-bu-vb-ss9:2.1.4": "",
  "pli-tv-bu-vb-ss9:2.1.5": "",
  "pli-tv-bu-vb-ss9:2.1.6": "",
  "pli-tv-bu-vb-ss9:2.1.7": "",
  "pli-tv-bu-vb-ss9:2.1.8": "",
