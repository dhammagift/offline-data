  "pli-tv-bu-vb-ss9:2.3.83": "",
  "pli-tv-bu-vb-ss9:2.3.84": "vācāya vācāya saṃghādisesassa. ||3|| ",
  "pli-tv-bu-vb-ss9:2.4.1": "pārājikena dhammenā 'ti ",
  "pli-tv-bu-vb-ss9:2.4.2": "catunnaṃ . . . (Saṃghād., ",
