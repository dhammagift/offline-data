  "pli-tv-bu-vb-ss9:3.2.23": "",
  "pli-tv-bu-vb-ss9:3.2.24": "",
  "pli-tv-bu-vb-ss9:3.2.25": "dubbhāsitaṃ ajjhāpajjanto diṭṭho hoti, dubbhāsite ",
  "pli-tv-bu-vb-ss9:3.2.26": "",
  "pli-tv-bu-vb-ss9:3.2.27": "",
  "pli-tv-bu-vb-ss9:3.2.28": "",
  "pli-tv-bu-vb-ss9:3.2.29": "",
  "pli-tv-bu-vb-ss9:3.2.30": "dukkaṭadiṭṭhi hoti. ",
  "pli-tv-bu-vb-ss9:3.2.31": "tañ ce . . . ",
  "pli-tv-bu-vb-ss9:3.2.32": "",
  "pli-tv-bu-vb-ss9:3.2.33": "",
  "pli-tv-bu-vb-ss9:3.2.34": "vācāya vācāya saṃghādisesassa. ||2|| ",
  "pli-tv-bu-vb-ss9:3.3.0": "",
  "pli-tv-bu-vb-ss9:3.3.1": "anāpatti ",
  "pli-tv-bu-vb-ss9:3.3.2": "tathāsaññī codeti vā codāpeti vā, ",
  "pli-tv-bu-vb-ss9:3.3.3": "ummattakassa, ",
  "pli-tv-bu-vb-ss9:3.3.4": "ādikammikassā 'ti. ||3||3|| ",
  "pli-tv-bu-vb-ss9:3.3.5": "navamaṃ saṃghādisesaṃ samattaṃ. "
}
