{
  "pli-tv-bu-vb-pc52:0.1": "",
  "pli-tv-bu-vb-pc52:0.2": "",
  "pli-tv-bu-vb-pc52:0.3": "",
  "pli-tv-bu-vb-pc52:0.4": "",
  "pli-tv-bu-vb-pc52:0.5": "",
  "pli-tv-bu-vb-pc52:1.0": "",
  "pli-tv-bu-vb-pc52:1.1": "Tena samayena buddho bhagavā Sāvatthiyaṃ viharati Jetavane Anāthapiṇḍikassa ārāme. ",
  "pli-tv-bu-vb-pc52:1.2": "tena kho pana samayena chabbaggiyā bhikkhū sattarasavaggiyaṃ bhikkhuṃ aṅgulipatodakena hāsesuṃ. ",
  "pli-tv-bu-vb-pc52:1.3": "so bhikkhu uttanto anassāsako kālam akāsi. ",
  "pli-tv-bu-vb-pc52:1.4": "ye te bhikkhū appicchā . . . vipācenti: ",
  "pli-tv-bu-vb-pc52:1.5": "kathaṃ hi nāma chabbaggiyā bhikkhū bhikkhuṃ aṅgulipatodakena hāsessantīti --pa--. ",
  "pli-tv-bu-vb-pc52:1.6": "saccaṃ kira tumhe bhikkhave . . . hāsethā 'ti. ",
  "pli-tv-bu-vb-pc52:1.7": "saccaṃ bhagavā. ",
  "pli-tv-bu-vb-pc52:1.8": "vigarahi buddho bhagavā: kathaṃ ",
  "pli-tv-bu-vb-pc52:1.9": "hi nāma tumhe moghapurisā . . . hāsessatha. ",
  "pli-tv-bu-vb-pc52:1.10": "n' etaṃ moghapurisā appasannānaṃ vā pasādāya --pa-- ",
  "pli-tv-bu-vb-pc52:1.11": "evañ ca pana bhikkhave imaṃ sikkhāpadaṃ uddiseyyātha: ",
  "pli-tv-bu-vb-pc52:1.12.0": "",
  "pli-tv-bu-vb-pc52:1.12.1": "aṅgulipatodake pācittiyan ti. ||1|| ",
  "pli-tv-bu-vb-pc52:2.1.0": "",
  "pli-tv-bu-vb-pc52:2.1.1": "aṅgulipatodako nāma, ",
  "pli-tv-bu-vb-pc52:2.1.2": "upasampanno upasampannaṃ hāsādhippāyo kāyena kāyaṃ āmasati, āpatti pācittiyassa. ||1|| ",
  "pli-tv-bu-vb-pc52:2.2.0": "",
  "pli-tv-bu-vb-pc52:2.2.1": "upasampanne upasampannasaññī aṅgulipatodakena hāseti, āpatti pācittiyassa. ",
  "pli-tv-bu-vb-pc52:2.2.2": "upasampanne vematiko . . . ",
  "pli-tv-bu-vb-pc52:2.2.3": "upasampanne anupasampannasaññī . . . āpatti pācittiyassa. ",
  "pli-tv-bu-vb-pc52:2.2.4": "kāyena kāyapaṭibaddhaṃ āmasati, āpatti dukkaṭassa. ",
  "pli-tv-bu-vb-pc52:2.2.5": "kāyapaṭibaddhena kāyaṃ āmasati, āpatti dukkaṭassa. ",
  "pli-tv-bu-vb-pc52:2.2.6": "kāyapaṭibaddhena kāyapaṭibaddhaṃ āmasati, āpatti dukkaṭassa. ",
  "pli-tv-bu-vb-pc52:2.2.7": "nissaggiyena kāyaṃ āmasati, āpatti dukkaṭassa. ",
  "pli-tv-bu-vb-pc52:2.2.8": "nissaggiyena kāyapaṭibaddhaṃ āmasati, āpatti dukkaṭassa. ",
  "pli-tv-bu-vb-pc52:2.2.9": "nissaggiyena nissaggiyaṃ āmasati, āpatti dukkaṭassa. ",
  "pli-tv-bu-vb-pc52:2.2.10": "anupasampannaṃ kāyena kāyaṃ āmasati, āpatti dukkaṭassa. ",
  "pli-tv-bu-vb-pc52:2.2.11": "kāyena kāyapaṭibaddhaṃ . . . ",
  "pli-tv-bu-vb-pc52:2.2.12": "kāyapaṭibaddhena kāyaṃ . . . ",
  "pli-tv-bu-vb-pc52:2.2.13": "kāyapaṭibaddhena kāyapaṭibaddhaṃ . . . ",
  "pli-tv-bu-vb-pc52:2.2.14": "nissaggiyena kāyaṃ . . . ",
  "pli-tv-bu-vb-pc52:2.2.15": "nissaggiyena kāyapaṭibaddhaṃ . . . ",
  "pli-tv-bu-vb-pc52:2.2.16": "nissaggiyena nissaggiyaṃ āmasati, āpatti dukkaṭassa. ",
  "pli-tv-bu-vb-pc52:2.2.17": "anupasampanne upasampannasaññī, āpatti dukkaṭassa. ",
  "pli-tv-bu-vb-pc52:2.2.18": "anupasampanne vematiko, āpatti dukkaṭassa. ",
  "pli-tv-bu-vb-pc52:2.2.19": "anupasampanne anupasampannasaññī, āpatti dukkaṭassa. ||2|| ",
  "pli-tv-bu-vb-pc52:2.3.0": "",
  "pli-tv-bu-vb-pc52:2.3.1": "anāpatti ",
  "pli-tv-bu-vb-pc52:2.3.2": "na hāsādhippāyo ",
  "pli-tv-bu-vb-pc52:2.3.3": "sati karaṇīye āmasati, ",
  "pli-tv-bu-vb-pc52:2.3.4": "ummattakassa, ",
  "pli-tv-bu-vb-pc52:2.3.5": "ādikammikassā 'ti. ||3||2|| ",
  "pli-tv-bu-vb-pc52:2.3.6": "dutiyaṃ. "
}
