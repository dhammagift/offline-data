  "pli-tv-bu-vb-pc62:0.4": "",
  "pli-tv-bu-vb-pc62:0.5": "",
  "pli-tv-bu-vb-pc62:1.0": "",
  "pli-tv-bu-vb-pc62:1.1": "Tena samayena buddho bhagavā Sāvatthiyaṃ viharati Jetavane Anāthapiṇḍikassa ārāme. ",
  "pli-tv-bu-vb-pc62:1.2": "tena kho pana samayena chabbaggiyā bhikkhū jānaṃ sappāṇakaṃ udakaṃ paribhuñjanti. ",
  "pli-tv-bu-vb-pc62:1.3": "ye te bhikkhū appicchā . . . vipācenti: ",
  "pli-tv-bu-vb-pc62:1.4": "kathaṃ hi nāma chabbaggiyā bhikkhū jānaṃ sappāṇakaṃ udakaṃ paribhuñjissantīti --pa--. ",
  "pli-tv-bu-vb-pc62:1.5": "saccaṃ kira tumhe bhikkhave . . . paribhuñjathā 'ti. ",
  "pli-tv-bu-vb-pc62:1.6": "saccaṃ bhagavā. ",
  "pli-tv-bu-vb-pc62:1.7": "vigarahi buddho bhagavā: kathaṃ ",
  "pli-tv-bu-vb-pc62:1.8": "hi nāma tumhe moghapurisā . . . paribhuñjissatha. ",
  "pli-tv-bu-vb-pc62:1.9": "n' etaṃ moghapurisā appasannānaṃ vā pasādāya --pa-- ",
  "pli-tv-bu-vb-pc62:1.10": "evañ ca pana bhikkhave imaṃ sikkhāpadaṃ uddiseyyātha: ",
  "pli-tv-bu-vb-pc62:1.11.0": "",
  "pli-tv-bu-vb-pc62:1.11.1": "yo pana bhikkhu jānaṃ sappāṇakaṃ udakaṃ paribhuñjeyya, pācittiyan ti. ||1|| ",
  "pli-tv-bu-vb-pc62:2.1.0": "",
  "pli-tv-bu-vb-pc62:2.1.1": "yo panā 'ti . . . ",
  "pli-tv-bu-vb-pc62:2.1.2": "",
  "pli-tv-bu-vb-pc62:2.1.3": "",
  "pli-tv-bu-vb-pc62:2.1.4": "adhippeto bhikkhū 'ti. ",
  "pli-tv-bu-vb-pc62:2.1.5": "jānāti nāma ",
  "pli-tv-bu-vb-pc62:2.1.6": "sāmaṃ vā jānāti aññe vā tassa ārocenti. ",
  "pli-tv-bu-vb-pc62:2.1.7": "sappāṇakan ti jānanto paribhogena marissantīti jānanto paribhuñjati, āpatti pācittiyassa. ||1|| ",
  "pli-tv-bu-vb-pc62:2.2.0": "",
  "pli-tv-bu-vb-pc62:2.2.1": "sappāṇake sappāṇakasaññī paribhuñjati, āpatti pācittiyassa. ",
  "pli-tv-bu-vb-pc62:2.2.2": "sappāṇake vematiko paribhuñjati, āpatti dukkaṭassa. ",
  "pli-tv-bu-vb-pc62:2.2.3": "sappāṇake asappāṇakasaññī paribhuñjati, anāpatti. ",
  "pli-tv-bu-vb-pc62:2.2.4": "apāṇake sappāṇakasaññī, āpatti dukkaṭassa. ",
  "pli-tv-bu-vb-pc62:2.2.5": "apāṇake vematiko, āpatti dukkaṭassa. ",
  "pli-tv-bu-vb-pc62:2.2.6": "apāṇake apāṇakasaññī, anāpatti. ||2|| ",
  "pli-tv-bu-vb-pc62:2.3.0": "",
  "pli-tv-bu-vb-pc62:2.3.1": "anāpatti ",
  "pli-tv-bu-vb-pc62:2.3.2": "sappāṇakan ti ajānanto, ",
  "pli-tv-bu-vb-pc62:2.3.3": "apāṇakan ti jānanto, ",
  "pli-tv-bu-vb-pc62:2.3.4": "paribhogena na marissantīti jānanto paribhuñjati; ",
  "pli-tv-bu-vb-pc62:2.3.5": "ummattakassa, ",
  "pli-tv-bu-vb-pc62:2.3.6": "ādikammikassā 'ti. ||3||2|| ",
  "pli-tv-bu-vb-pc62:2.3.7": "dutiyaṃ. "
}
