{
  "pli-tv-bu-vb-as1:0.1": "",
  "pli-tv-bu-vb-as1:0.2": "",
  "pli-tv-bu-vb-as1:0.3": "",
  "pli-tv-bu-vb-as1:1.1": "Ime kho panāyasmanto satta adhikaraṇasamathā dhammā uddesaṃ āgacchanti: ",
  "pli-tv-bu-vb-as1:2.1": "uppannuppannānaṃ adhikaraṇānaṃ samathāya vūpasamāya ",
  "pli-tv-bu-vb-as1:2.2": "sammukhāvinayo dātabbo, ",
  "pli-tv-bu-vb-as2:1.1": "sativinayo dātabbo, ",
  "pli-tv-bu-vb-as3:1.1": "amūḷhavinayo dātabbo, ",
  "pli-tv-bu-vb-as4:1.1": "paṭiññāya kāretabbaṃ, ",
  "pli-tv-bu-vb-as5:1.1": "yebhuyyasikā, tassapāpiyyasikā, tiṇavatthārako 'ti. ",
  "pli-tv-bu-vb-as6:1.1": "",
  "pli-tv-bu-vb-as7:1.1": "",
  "pli-tv-bu-vb-as7:2.1": "uddiṭṭhā kho āyasmanto satta adhikaraṇasamathā dhammā. ",
  "pli-tv-bu-vb-as7:2.2": "tatthāyasmante pucchāmi: ",
  "pli-tv-bu-vb-as7:2.3": "kacci 'ttha parisuddhā. ",
  "pli-tv-bu-vb-as7:2.4": "dutiyam pi pucchāmi: ",
  "pli-tv-bu-vb-as7:2.5": "kacci 'ttha parisuddhā. ",
  "pli-tv-bu-vb-as7:2.6": "tatiyam pi pucchāmi: ",
  "pli-tv-bu-vb-as7:2.7": "kacci 'ttha parisuddhā. ",
  "pli-tv-bu-vb-as7:2.8": "parisuddh' etthāyasmanto, tasmā tuṇhī. evam etaṃ dhārayāmīti. ",
  "pli-tv-bu-vb-as7:3.1": "",
  "pli-tv-bu-vb-as7:4.1": "uddiṭṭhaṃ kho āyasmanto nidānaṃ, ",
  "pli-tv-bu-vb-as7:4.2": "uddiṭṭhā cattāro pārājikā dhammā, ",
  "pli-tv-bu-vb-as7:4.3": "uddiṭṭhā terasa saṃghādisesā dhammā, ",
  "pli-tv-bu-vb-as7:4.4": "uddiṭṭhā dve aniyatā dhammā, ",
  "pli-tv-bu-vb-as7:4.5": "uddiṭṭhā tiṃsa nissaggiyā pācittiyā dhammā, ",
  "pli-tv-bu-vb-as7:4.6": "uddiṭṭhā dvenavuti pācittiyā dhammā, ",
  "pli-tv-bu-vb-as7:4.7": "uddiṭṭhā cattāro pāṭidesaniyā dhammā, ",
  "pli-tv-bu-vb-as7:4.8": "uddiṭṭhā sekhiyā dhammā, ",
  "pli-tv-bu-vb-as7:4.9": "uddiṭṭhā satta adhikaraṇasamathā dhammā. ",
  "pli-tv-bu-vb-as7:4.10": "ettakaṃ tassa bhagavato suttāgataṃ suttapariyāpannaṃ anvaddhamāsaṃ uddesaṃ āgacchati. ",
  "pli-tv-bu-vb-as7:4.11": "tattha sabbeh' eva samaggehi sammodamānehi avivadamānehi sikkhitabban ti. ",
  "pli-tv-bu-vb-as7:5.1": "Mahāvibhaṅgaṃ niṭṭhitaṃ. "
}
