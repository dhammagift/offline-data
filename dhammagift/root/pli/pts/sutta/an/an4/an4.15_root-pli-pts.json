{
  "an4.15:0.1": "",
  "an4.15:0.2": "",
  "an4.15:0.3": "",
  "an4.15:1.1": "Catasso imā bhikkhave aggapaññattiyo. ",
  "an4.15:1.2": "Katamā catasso? ",
  "an4.15:1.3": "Etadaggaṃ bhikkhave attabhāvīnaṃ yadidaṃ ",
  "an4.15:1.4": "Rāhu asurindo, ",
  "an4.15:1.5": "etadaggaṃ bhikkhave kāmabhogīnaṃ yadidaṃ ",
  "an4.15:1.6": "rājā Mandhātā, ",
  "an4.15:1.7": "etadaggaṃ bhikkhave ādhipateyyānaṃ yadidaṃ ",
  "an4.15:1.8": "Māro pāpimā, ",
  "an4.15:1.9": "sadevake bhikkhave loke samārake sabrahmake sassamaṇabrāhmaṇiyā pajāya sadevamanussāya Tathāgato aggam akkhāyati arahaṃ sammāsambuddho. ",
  "an4.15:1.10": "Imā kho bhikkhave catasso aggapaññattiyo ti. Rāh' ",
  "an4.15:2.1": "aggaṃ attabhāvīnaṃ ",
  "an4.15:2.2": "Mandhātā kāmabhogīnaṃ ",
  "an4.15:2.3": "Māro ādhipateyyānaṃ ",
  "an4.15:2.4": "iddhiyā yasasā jalaṃ ",
  "an4.15:3.1": "Uddhaṃ tiriyaṃ apācīnaṃ ",
  "an4.15:3.2": "yāvatā jagato gati ",
  "an4.15:3.3": "Sadevakassa lokassa ",
  "an4.15:3.4": "Buddho aggaṃ pavuccatīti. 16. ",
  "an4.15:3.5": "Cattār' imāni "
}
