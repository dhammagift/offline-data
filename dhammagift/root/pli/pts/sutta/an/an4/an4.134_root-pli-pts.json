  "an4.134:1.1": "bhikkhave puggalā santo saṃvijjamānā lokasmiṃ. ",
  "an4.134:1.2": "Katame cattāro? ",
  "an4.134:1.3": "Uṭṭhānaphalūpajīvī na kammaphalūpajīvī, ",
  "an4.134:1.4": "kammaphalūpajīvī na uṭṭhānaphalūpajīvī, ",
  "an4.134:1.5": "uṭṭhānaphalūpajīvī ca kammaphalūpajīvī ca, ",
  "an4.134:1.6": "n' eva uṭṭhānaphalūpajīvī na kammaphalūpajīvī. ",
  "an4.134:1.7": "Ime kho bhikkhave cattāro puggalā . . . lokasmin ti. 135. 1. Cattāro ",
  "an4.134:1.8": "'me "
}
