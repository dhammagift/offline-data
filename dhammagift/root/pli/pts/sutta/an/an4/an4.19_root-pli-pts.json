  "an4.19:1.1": "bhikkhave agatigamanāni. ",
  "an4.19:1.2": "Katamāni cattāri? ",
  "an4.19:1.3": "Chandāgatiṃ gacchati . . . bhayāgatiṃ gacchati. ",
  "an4.19:1.4": "Imāni kho bhikkhave cattāri agatigamanānīti. ",
  "an4.19:2.1": "Cattār' imani bhikkhave nāgatigamanāni. ",
  "an4.19:2.2": "Katamāni cattāri? ",
  "an4.19:2.3": "Na chandāgatiṃ gacchati . . . na bhayāgatiṃ gacchati. ",
  "an4.19:2.4": "Imāni kho bhikkhave cattāri nāgatigamaṇānīti. ",
  "an4.19:3.1": "Chandā dosā bhayā mohā ",
  "an4.19:3.2": "yo dhammaṃ ativattati ",
  "an4.19:3.3": "Nihīyati tassa yaso ",
  "an4.19:3.4": "kālapakkhe va candimā ",
  "an4.19:4.1": "Chandā dosā bhayā mohā ",
  "an4.19:4.2": "yo dhammaṃ nātivattati ",
  "an4.19:4.3": "Āpūrati tassa yaso ",
  "an4.19:4.4": "sukkapakkhe va candimāti 20. ",
  "an4.19:4.5": ""
}
