{
  "an4.42:0.1": "",
  "an4.42:0.2": "",
  "an4.42:0.3": "",
  "an4.42:1.1": "bhikkhave pañhavyākaraṇāni. ",
  "an4.42:1.2": "Katamāni cattāri? ",
  "an4.42:1.3": "Atthi bhikkhave pañho ekaṃsavyākaraṇīyo, ",
  "an4.42:1.4": "atthi bhikkhave pañho paṭipucchā- ",
  "an4.42:1.5": "vyākaraṇīyo, ",
  "an4.42:1.6": "atthi bhikkhave pañho ṭhapanīyo, atthi bhikkhave pañho vibhajjavyākaraṇīyo. ",
  "an4.42:1.7": "Imāni kho bhikkhave cattāri pañhavyākaraṇānīti. 2. ",
  "an4.42:2.1": "Ekaṃsa-vacanaṃ ekaṃ ",
  "an4.42:2.2": "vibhajja-vacanaṃ paraṃ ",
  "an4.42:2.3": "Tatiyaṃ paṭipuccheyya ",
  "an4.42:2.4": "catuttham pana ṭhāpaye ",
  "an4.42:3.1": "Yo ca tesaṃ tattha tattha ",
  "an4.42:3.2": "jānāti anudhammataṃ ",
  "an4.42:3.3": "Catu pañhassa kusalo ",
  "an4.42:3.4": "āhu bhikkhuṃ tathāvidhaṃ ",
  "an4.42:4.1": "Durāsado duppasaho ",
  "an4.42:4.2": "gambhīro duppadhaṃsiyo ",
  "an4.42:4.3": "Atho atthe anatthe ca ",
  "an4.42:4.4": "ubhayassa hoti kovido ",
  "an4.42:5.1": "Anatthaṃ parivajjeti ",
  "an4.42:5.2": "atthaṃ gaṇhāti paṇḍito ",
  "an4.42:5.3": "Atthābhisamayā dhūro ",
  "an4.42:5.4": "paṇḍito ti pavuccatīti. 43. 1. ",
  "an4.42:5.5": "Cattāro 'me "
}
