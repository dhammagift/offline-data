  "an4.211:0.3": "",
  "an4.211:1.1": "bhikkhave parisadussanā. ",
  "an4.211:1.2": "Katame cattāro? Idha bhikkhave ",
  "an4.211:1.3": "bhikkhu dussīlo pāpadhammo parisadussano, ",
  "an4.211:1.4": "bhikkhunī bhikkhave dussīlā pāpadhammā parisadussanā, ",
  "an4.211:1.5": "upāsako bhikkhave dussīlo pāpadhammo parisadussano, ",
  "an4.211:1.6": "upāsikā bhikkhave dussīlā pāpadhammā parisadussanā. ",
  "an4.211:1.7": "Ime kho bhikkhave cattāro parisadussanā. 2. ",
  "an4.211:2.1": "Cattāro 'me bhikkhave parisasobhaṇā. ",
  "an4.211:2.2": "Katame cattāro? Idha bhikkhave ",
  "an4.211:2.3": "bhikkhu sīlavā kalyāṇadhammo parisasobhano, ",
  "an4.211:2.4": "bhikkhunī bhikkhave sīlavatī kalyāṇadhammā parisasobhaṇā, ",
  "an4.211:2.5": "upāsako bhikkhave sīlavā kalyāṇadhammo parisasobhaṇo, ",
  "an4.211:2.6": "upāsikā bhikkhave sīlavatī kalyāṇadhammā parisobhaṇā. ",
  "an4.211:2.7": "Ime kho bhikkhave cattāro parisobhaṇā ",
  "an4.211:2.8": "ti. 212. 1. "
}
