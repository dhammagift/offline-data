  "an4.32:0.1": "",
  "an4.32:0.2": "",
  "an4.32:0.3": "",
  "an4.32:1.1": "bhikkhave saṅgahavatthūni. ",
  "an4.32:1.2": "Katamāni cattāri? ",
  "an4.32:1.3": "Dānaṃ, peyyavajjaṃ, atthacariyā, samānattatā. ",
  "an4.32:1.4": "Imāni kho bhikkhave cattāri saṅgahavatthūnīti. 2. ",
  "an4.32:2.1": "Dānañ ca peyyavajjañ ca ",
  "an4.32:2.2": "atthacariyā ca yā idha ",
  "an4.32:2.3": "Samānattatā dhammesu ",
  "an4.32:2.4": "tattha tattha yathārahaṃ ",
  "an4.32:2.5": "Ete kho saṅgahā loke ",
  "an4.32:2.6": "rathass' āṇī va yāyato ",
  "an4.32:3.1": "Ete ca saṅgahā nāssu ",
  "an4.32:3.2": "na mātā puttakāranā ",
  "an4.32:3.3": "Labetha mānaṃ pūjam vā ",
  "an4.32:3.4": "pitā vā puttakāranā. ",
  "an4.32:4.1": "Yasmā ca saṅgahā ete ",
  "an4.32:4.2": "samavekkhanti paṇḍitā ",
  "an4.32:4.3": "Tasmā mahantaṃ papponti ",
  "an4.32:4.4": "pāsaṃsā ca bhavanti te ",
  "an4.32:4.5": "ti. 33. "
}
