  "an4.253:1.1": "bhikkhave ariyavohārā. ",
  "an4.253:1.2": "Katame cattāro? ",
  "an4.253:1.3": "Diṭṭhe diṭṭhavāditā, sute sutavāditā, mute mutavāditā, viññāte viññātavāditā. ",
  "an4.253:1.4": "Ime kho bhikkhave cattāro ariyavohārā ti. ",
  "an4.253:1.5": "",
  "an4.253:1.6": "[Tass' uddānaṃ:-- ",
  "an4.253:2.0": "",
  "an4.253:2.1": "Dve āpatti sikkhānisaṃso|| ",
  "an4.253:2.2": "seyyā thūpārahena ca|| ",
  "an4.253:2.3": "Paññābuddhi bahukārā|| cattāro ",
  "an4.253:2.4": "vohāra ubhayenavagge] ti|| . ",
  "an4.253:2.5": "Cattāro 'me "
}
