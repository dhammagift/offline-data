  "an4.221:1.1": "bhikkhave vacīduccaritāni. ",
  "an4.221:1.2": "Katamāni cattari? ",
  "an4.221:1.3": "Musāvādo, pisuṇāvācā, pharusāvācā, samphappalāpo. ",
  "an4.221:1.4": "Imāni kho bhikkhave cattāri vacīduccaritāni. 2. ",
  "an4.221:1.5": "Cattār' imāni bhikkhave vacīsucaritāni. ",
  "an4.221:1.6": "Katamāni cattāri? ",
  "an4.221:1.7": "Saccavācā, apisūṇāvācā, saṇhavācā, mantāvācā. ",
  "an4.221:1.8": "Imāni kho bhikkhave cattāri vacīsucaritāni. 222. 1. ",
  "an4.221:1.9": ""
}
