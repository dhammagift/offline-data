  "an4.56:0.1": "",
  "an4.56:0.2": "",
  "an4.56:0.3": "",
  "an4.56:1.1": "bhikkhave ubho jānipatayo diṭṭh' eva dhamme aññamaññaṃ passituṃ abhisamparāyañ ca aññamaññaṃ passituṃ ubho ca assu samasaddhā samasīlā samacāgā samapaññā te diṭṭh' eva dhamme aññamaññaṃ passanti abhisamparāyañ ca aññamaññaṃ passantīti. 2. ",
  "an4.56:2.1": "Ubho saddhā vadaññū ca ",
  "an4.56:2.2": "saññatā dhammajīvino ",
  "an4.56:2.3": "Te honti jānipatayo ",
  "an4.56:2.4": "aññamaññaṃ piyamvadā ",
  "an4.56:3.1": "Atthā sampacurā honti ",
  "an4.56:3.2": "vāsatthaṃ upajāyati ",
  "an4.56:3.3": "Amittā dummanā honti ",
  "an4.56:3.4": "ubhinnaṃ samasīlinaṃ ",
  "an4.56:4.1": "Idha dhammaṃ caritvāna ",
  "an4.56:4.2": "samasīlabbatā ubho ",
  "an4.56:4.3": "Nandino devalokasmiṃ ",
  "an4.56:4.4": "modanti kāmakāmino ",
  "an4.56:4.5": "ti. 57. 1. "
}
