{
  "an4.23:0.1": "",
  "an4.23:0.2": "",
  "an4.23:0.3": "",
  "an4.23:1.1": "Loko bhikkhave Tathāgatena abhisambuddho ",
  "an4.23:1.2": "lokasmā Tathāgato visaṃyutto, ",
  "an4.23:1.3": "lokasamudayobhikkhaveTathāgatena abhisambuddho ",
  "an4.23:1.4": "lokasamudayo Tathāgatassa pahīno, ",
  "an4.23:1.5": "lokanirodho bhikkhave Tathāgatena abhisambuddho ",
  "an4.23:1.6": "lokanirodho Tathāgatassa sacchikato, ",
  "an4.23:1.7": "lokanirodhagāminī paṭipadā bhikkhave Tathāgatena abhisambuddho ",
  "an4.23:1.8": "lokanirodhagāminī paṭipadā Tathāgatassa bhāvitā. 2. ",
  "an4.23:2.1": "Yaṃ bhikkhave sadevakassa lokassa. samārakassa sabrahmakassa sassamaṇabrāhmaṇiyā pajāya sadevamanussāya diṭṭhaṃ sutaṃ mutaṃ viññātaṃ pattaṃ pariyesitaṃ anuvicaritaṃ manasā sabbaṃ taṃ Tathāgatena abhisambuddhaṃ, ",
  "an4.23:2.2": "tasmā Tathāgato ti vuccati. ",
  "an4.23:3.1": "Yañ ca bhikkhave rattiṃ Tathāgato abhisambujjhati yañ ca rattiṃ parinibbāyati yaṃ etasmiṃ antare bhāsati lapati niddisati sabbaṃ taṃ tatth' eva hoti no aññathā, ",
  "an4.23:3.2": "tasmā Tathāgato ti vuccati. 3. ",
  "an4.23:4.1": "Yathāvādī bhikkhave Tathāgato tathākārī yathākārī tathāvādī ",
  "an4.23:4.2": "iti yathāvādī tathākārī yathākārī tathāvādī, ",
  "an4.23:4.3": "tasmā Tathāgato ti vuccatīti. ",
  "an4.23:5.1": "Sadevake bhikkhave loke samārake sabrahmake sassamaṇabrāhmaṇiyā pajāya sadevamanussāya Tathāgato abhibhū anabhibhūto aññadatthudaso vasavattī, ",
  "an4.23:5.2": "tasmā Tathāgato ti vuccati. ",
  "an4.23:6.1": "Sabbaṃ lokaṃ abhiññāya ",
  "an4.23:6.2": "sabbaloke yathā tathā ",
  "an4.23:6.3": "Sabbaloka-visaṃyutto ",
  "an4.23:6.4": "sabbaloke anūpayo ",
  "an4.23:7.1": "Sa ve sabbābhibhū dhīro ",
  "an4.23:7.2": "sabbagantha-pamocano ",
  "an4.23:7.3": "Puṭṭhassa paramā santi ",
  "an4.23:7.4": "nibbānaṃ akutobhayaṃ ",
  "an4.23:8.1": "Esa khīṇāsavo Buddho ",
  "an4.23:8.2": "anīgho chinnasaṃsayo ",
  "an4.23:8.3": "Sabbakammakkhayaṃ patto ",
  "an4.23:8.4": "vimutto upadhisaṅkhaye ",
  "an4.23:9.1": "Esa so Bhagavā Buddho ",
  "an4.23:9.2": "esa sīho anuttaro ",
  "an4.23:9.3": "Sadevakassa lokassa ",
  "an4.23:9.4": "brahmacakkaṃ pavattayī ",
  "an4.23:10.1": "Iti devamanussā ca ",
  "an4.23:10.2": "ye Buddhaṃ saraṇaṃ gatā ",
  "an4.23:10.3": "Saṅgamma taṃ namassanti ",
  "an4.23:10.4": "mahantaṃ vītasāradaṃ ",
  "an4.23:11.1": "Danto damayataṃ seṭṭho ",
  "an4.23:11.2": "santo samayataṃ isi ",
  "an4.23:11.3": "Mutto mocayataṃ aggo ",
  "an4.23:11.4": "tiṇṇo tārayataṃ varo ",
  "an4.23:12.1": "Iti h' etaṃ namassanti ",
  "an4.23:12.2": "mahantaṃ vītasāradaṃ ",
  "an4.23:12.3": "Sadevakasmiṃ lokasmiṃ ",
  "an4.23:12.4": "n' atthi te paṭipuggalo ",
  "an4.23:12.5": "ti. 24. "
}
