  "an4.189:0.1": "",
  "an4.189:0.2": "",
  "an4.189:0.3": "",
  "an4.189:1.1": "bhikkhave sacchikaraṇīyā dhammā. ",
  "an4.189:1.2": "Katame cattāro? ",
  "an4.189:1.3": "Atthi bhikkhave dhammā kāyena sacchikaraṇīyā, ",
  "an4.189:1.4": "atthi bhikkhave dhammā satiyā sacchikaraṇīyā, ",
  "an4.189:1.5": "atthi bhikkhave dhammā cakkhunā sacchikaraṇīyā, ",
  "an4.189:1.6": "atthi bhikkhave dhammā paññāya sacchikaraṇīyā. 2. ",
  "an4.189:1.7": "Katame ca bhikkhave dhammā kāyena sacchikaraṇīyā? ",
  "an4.189:1.8": "Aṭṭha vimokhā bhikkhave kāyena sacchikaraṇīyā. 3. ",
  "an4.189:2.1": "Katame ca bhikkhave dhammā satiyā sacchikaraṇīyā? ",
  "an4.189:2.2": "Pubbenivāso bhikkhave satiyā sacchikaraṇīyo. 4. ",
  "an4.189:3.1": "Katame ca bhikkhave dhammā cakkhunā sacchikaraṇīyā? ",
  "an4.189:3.2": "Sattānaṃ cutuppāto bhikkhave cakkhunā sacchikaraṇīyo. 5. ",
  "an4.189:4.1": "Katame ca bhikkhave dhammā paññāya sacchikaranīyā? ",
  "an4.189:4.2": "Āsavānaṃ khayo bhikkhave paññāya sacchikaraṇīyo. ",
  "an4.189:4.3": "Ime kho bhikkhave cattāro sacchikaraṇīyā dhammā ",
  "an4.189:4.4": "ti. 190. 1. "
}
