  "an4.116:0.1": "",
  "an4.116:0.2": "",
  "an4.116:0.3": "",
  "an4.116:1.1": "Catuhi bhikkhave ṭhānehi appamādo karaṇīyo. ",
  "an4.116:1.2": "Katamehi catuhi? ",
  "an4.116:1.3": "Kāyaduccaritaṃ bhikkhave pajahatha kāyasucaritaṃ bhāvetha ",
  "an4.116:1.4": "tattha ca mā pamādattha. ",
  "an4.116:1.5": "Vacīduccaritaṃ bhikkhave pajahatha vacīsucaritaṃ bhāvetha ",
  "an4.116:1.6": "tattha ca mā pamādattha. ",
  "an4.116:1.7": "Manoduccaritaṃ bhikkhave pajahatha manosucaritaṃ bhāvetha ",
  "an4.116:1.8": "tattha ca mā pamādattha. ",
  "an4.116:1.9": "Micchādiṭṭhiṃ bhikkhave pajahatha sammādiṭṭhiṃ bhāvetha ",
  "an4.116:1.10": "tattha ca mā pamādattha. 2. ",
  "an4.116:2.1": "Yato kho bhikkhave bhikkhuno kāyaduccaritaṃ pahīnaṃ hoti kāyasucaritaṃ bhāvitam, . . . pe . . . manoduccaritaṃ pahīnaṃ hoti manosucaritaṃ bhāvitaṃ, micchādiṭṭhi pahīnā hoti sammādiṭṭhi bhāvitā so na bhāyati samparāyikassa maraṇassāti. 117. 1. ",
  "an4.116:2.2": ""
}
