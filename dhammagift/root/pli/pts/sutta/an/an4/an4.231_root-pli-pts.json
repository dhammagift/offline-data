  "an4.231:1.1": "bhikkhave kavī. ",
  "an4.231:1.2": "Katame cattāro? ",
  "an4.231:1.3": "Cintākavi, sutakavi, atthakavi, paṭibhānakavi. ",
  "an4.231:1.4": "Ime kho bhikkhave cattāro kavīti. ",
  "an4.231:1.5": "[Uddānaṃ: ",
  "an4.231:1.6": "",
  "an4.231:2.0": "",
  "an4.231:2.1": "Duccaritaṃ diṭṭhi akataññū ca|| ",
  "an4.231:2.2": "pāṇātipātā pi dve maggā ",
  "an4.231:2.3": "Dve vohārapathā vuttā|| ",
  "an4.231:2.4": "ahīrikaṃ duppañña-kavinā cāti.] 231. 1. Cattār' imāni "
}
