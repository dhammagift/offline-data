  "an4.18:0.3": "",
  "an4.18:1.1": "bhikkhave nāgatigamanāni. ",
  "an4.18:1.2": "Katamāni cattāri? ",
  "an4.18:1.3": "Na chandāgatiṃ gacchati, na dosāgatiṃ gacchati, na mohāgatiṃ gacchati, na bhayāgatiṃ gacchati. ",
  "an4.18:1.4": "Imāni kho bhikkhave cattāri nāgatigamanāni. ",
  "an4.18:2.1": "Chandā dosā bhayā mohā ",
  "an4.18:2.2": "yo dhammaṃ nātivattati ",
  "an4.18:2.3": "Āpūrati tassa yaso ",
  "an4.18:2.4": "sukkapakkhe va candimāti 19. ",
  "an4.18:2.5": "Cattār' imāni "
}
