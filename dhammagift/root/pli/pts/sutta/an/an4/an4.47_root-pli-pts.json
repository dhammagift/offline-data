  "an4.47:0.1": "",
  "an4.47:0.2": "",
  "an4.47:0.3": "",
  "an4.47:1.1": "bhikkhave suvidūra-vidūrāni. ",
  "an4.47:1.2": "Katamāni cattāri? ",
  "an4.47:1.3": "Nabhā ca bhikkhave paṭhavī ca ",
  "an4.47:1.4": "idaṃ paṭhamaṃ suvidūravidūraṃ, ",
  "an4.47:1.5": "orimañ ca bhikkhave tīraṃ samuddassa pārimañ ca tīraṃ ",
  "an4.47:1.6": "idaṃ dutiyaṃ suvidūravidūraṃ, ",
  "an4.47:1.7": "yato ca bhikkhave verocano abbhudeti yattha ca attham eti ",
  "an4.47:1.8": "idaṃ tatiyaṃ suvidūravidūraṃ, ",
  "an4.47:1.9": "satañ ca bhikkhave dhammo asatañ ca dhammo ",
  "an4.47:1.10": "idaṃ catutthaṃ suvidūravidūraṃ. ",
  "an4.47:1.11": "Imāni kho bhikkhave cattāri suvidūravidūrānīti. 2. ",
  "an4.47:2.1": "Nabhā ca dūre paṭhavī ca dūre ",
  "an4.47:2.2": "pāraṃ samuddassa tadāhu dūre ",
  "an4.47:2.3": "Yato ca verocano abbhudeti ",
  "an4.47:2.4": "pabhaṅkaro yattha ca attham eti ",
  "an4.47:2.5": "Tato have dūrataraṃ vadanti ",
  "an4.47:2.6": "satañ ca dhammaṃ asatañ ca dhammaṃ ",
  "an4.47:3.1": "Avyāyiko hoti sataṃ samāgamo ",
  "an4.47:3.2": "yāvam pi tiṭṭheyya tath' eva hoti ",
  "an4.47:3.3": "Khippaṃ hi veti asataṃ samāgamo ",
  "an4.47:3.4": "tasmā sataṃ dhammo asabbhi ārakāti. 48. 1. ",
  "an4.47:3.5": ""
}
