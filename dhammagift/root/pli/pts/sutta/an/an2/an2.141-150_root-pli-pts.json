  "an2.141:0.1": "",
  "an2.141:0.2": "",
  "an2.141:1.0": "",
  "an2.141:1.1": "Dve 'māni bhikkhave dānāni. ",
  "an2.141:1.2": "Katamāni dve? ",
  "an2.141:1.3": "Āmisa-dānañ ca dhamma-dānañ ca. ",
  "an2.141:1.4": "Imāni kho bhikkhave dānāni. ",
  "an2.141:1.5": "Etad aggaṃ bhikkhave imesaṃ dvinnaṃ dānānaṃ yadidaṃ dhamma-dānan ti. 2. Dve 'me ",
  "an2.142:1.0": "",
  "an2.142:1.1": "bhikkhave yāgā. ",
  "an2.142:1.2": "Katame dve? ",
  "an2.142:1.3": "Āmisa-yāgo ca dhamma-yāgo ca. ",
  "an2.142:1.4": "Ime kho . . . pe . . . dhamma-yāgo ti. 3. Dve 'me ",
  "an2.142:1.5": "",
  "an2.143:1.0": "",
  "an2.143:1.1": "bhikkhave cāgā. ",
  "an2.143:1.2": "Katame dve? ",
  "an2.143:1.3": "Āmisa-cāgo ca dhamma-cāgo ca. ",
  "an2.143:1.4": "Ime kho . . . pe . . . dhamma-cāgo ti. 4. Dve 'me ",
  "an2.143:1.5": "",
  "an2.144:1.0": "",
  "an2.144:1.1": "bhikkhave pariccāgā. ",
  "an2.144:1.2": "Katame dve? ",
  "an2.144:1.3": "Āmisa-pariccāgo ca dhamma-pariccāgo ca. ",
  "an2.144:1.4": "Ime kho . . . pe . . . dhamma-pariccāgo. 5. Dve 'me ",
  "an2.144:1.5": "",
  "an2.145:1.0": "",
  "an2.145:1.1": "bhikkhave bhogā. ",
  "an2.145:1.2": "Katame dve? ",
  "an2.145:1.3": "Āmisa-bhogo ca dhamma-bhogo ca. ",
  "an2.145:1.4": "Ime kho . . . pe . . . dhamma-bhogo ti. 6. Dve 'me ",
  "an2.145:1.5": "",
  "an2.146:1.0": "",
  "an2.146:1.1": "bhikkhave sambhogā. ",
  "an2.146:1.2": "Katame dve? ",
  "an2.146:1.3": "Āmisa-sambhogo ca dhamma-sambhogo ca. ",
  "an2.146:1.4": "Ime kho . . . pe . . . dhamma-sambhogo ti. 7. Dve 'me ",
  "an2.146:1.5": "",
  "an2.147:1.0": "",
  "an2.147:1.1": "bhikkhave saṃvibhāgā. ",
  "an2.147:1.2": "Katame dve? ",
  "an2.147:1.3": "Āmisa-saṃvibhāgo ca dhamma-saṃvibhāgo ca. ",
  "an2.147:1.4": "Ime kho . . . pe . . . dhamma-saṃvibhāgo ti. 8. Dve 'me ",
  "an2.147:1.5": "",
  "an2.148:1.0": "",
  "an2.148:1.1": "bhikkhave saṅgahā. ",
  "an2.148:1.2": "Katame dve? ",
  "an2.148:1.3": "Āmisa-saṅgaho ca dhamma-saṅgaho ca. ",
  "an2.148:1.4": "Ime kho . . . pe . . . dhamma-saṅgaho ti. 9. Dve 'me ",
  "an2.148:1.5": "",
  "an2.149:1.0": "",
  "an2.149:1.1": "bhikkhave anuggahā. ",
  "an2.149:1.2": "Katame dve? ",
  "an2.149:1.3": "Āmisānuggaho ca dhammānuggaho ca. ",
  "an2.149:1.4": "Ime kho . . . pe . . . dhammānuggaho ti. 10. Dve 'me ",
  "an2.149:1.5": "",
  "an2.150:1.0": "",
  "an2.150:1.1": "bhikkhave anukampā. ",
  "an2.150:1.2": "Katamā dve? ",
  "an2.150:1.3": "Āmisānukampā ca dhammānukampā ca. ",
  "an2.150:1.4": "Imā kho . . . pe . . . dhammānukampā ti. 1. Dve 'me ",
  "an2.150:1.5": "",
  "an2.150:1.6": ""
}
