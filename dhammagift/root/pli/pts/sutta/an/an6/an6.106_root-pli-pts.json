  "an6.106:0.3": "",
  "an6.106:1.1": "Tisso imā bhikkhave taṇhā pahātabbā tayo ca mānā. ",
  "an6.106:1.2": "Katamā tisso taṇhā pahātabbā? 2. ",
  "an6.106:1.3": "Kāmataṇhā, bhavataṇhā, vibhavataṇhā. ",
  "an6.106:1.4": "Imā tisso taṇhā pahātabbā. ",
  "an6.106:1.5": "Katame tayo mānā pahātabbā? 3. ",
  "an6.106:1.6": "Māno, omāno, atimāno. ",
  "an6.106:1.7": "Ime tayo mānā pahātabbā. 4. ",
  "an6.106:1.8": "Yato kho bhikkhave bhikkhuno imā tisso taṇhā pahīnā honti ime ca tayo mānā: ",
  "an6.106:1.9": "ayaṃ vuccati bhikkhave bhikkhu acchejji taṇhaṃ, vivattayi saṃyojanaṃ, sammā mānābhisamayā antam akāsi dukkhassā ti. ",
  "an6.106:1.10": "",
  "an6.106:1.11": "",
  "an6.106:2.0": "",
  "an6.106:2.1": "Pātubhāvo ānisaṃso ",
  "an6.106:2.2": "aniccaṃ dukkham anattato ",
  "an6.106:2.3": "Nibbānaṃ tayo ",
  "an6.106:2.4": "anodhi saṃvuttā ",
  "an6.106:2.5": "bhavataṇhāya te dasā ",
  "an6.106:2.6": "ti. 1. Tayo 'me "
}
