  "an5.248:1.1": "manoduccarite . . . manosucarite. ",
  "an5.248:1.2": "Katame pañca? 2. ",
  "an5.248:1.3": "Attā pi attānaṃ na upavadati, ",
  "an5.248:1.4": "anuvicca viññū pasaṃsanti, ",
  "an5.248:1.5": "kalyāṇo kittisaddo abbhuggacchati, ",
  "an5.248:1.6": "asaddhammā vuṭṭhāti, ",
  "an5.248:1.7": "saddhamme patiṭṭhāti. ",
  "an5.248:1.8": "Ime kho bhikkhave pañca ānisaṃsā manosucarite ",
  "an5.248:1.9": "ti. 1. "
}
