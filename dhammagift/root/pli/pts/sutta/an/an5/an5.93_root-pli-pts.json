  "an5.93:1.1": "bhikkhave aññāvyākaraṇāni. ",
  "an5.93:1.2": "Katamāni pañca? 2. ",
  "an5.93:1.3": "Mandattā momūhattā aññaṃ vyākaroti, ",
  "an5.93:1.4": "pāpiccho icchāpakato aññaṃ vyākaroti, ",
  "an5.93:1.5": "ummādā cittakkhepā aññaṃ vyākaroti, ",
  "an5.93:1.6": "adhimānena aññaṃ vyākaroti, ",
  "an5.93:1.7": "samma-d-eva aññaṃ vyākaroti. ",
  "an5.93:1.8": "Imāni kho bhikkhave pañca aññāvyākaraṇānī ",
  "an5.93:1.9": "ti. 1. "
}
