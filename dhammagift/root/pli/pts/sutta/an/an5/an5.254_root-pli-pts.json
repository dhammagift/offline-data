  "an5.254:1.1": "bhikkhave macchariyāni. ",
  "an5.254:1.2": "Katamāni pañca? 2. ",
  "an5.254:1.3": "Āvāsamacchariyaṃ, kulamacchariyaṃ, lābhamacchariyaṃ, vaṇṇamacchariyaṃ, dhammamacchariyaṃ. ",
  "an5.254:1.4": "Imāni kho bhikkhave pañca macchariyāni. ",
  "an5.254:1.5": "Imesaṃ kho bhikkhave pañcannaṃ macchariyānaṃ etaṃ patikiṭṭhaṃ, yad idaṃ dhammamacchariyan ",
  "an5.254:1.6": "ti. 1. "
}
