{
  "an5.40:0.1": "",
  "an5.40:0.2": "",
  "an5.40:0.3": "",
  "an5.40:1.1": "Himavantaṃ bhikkhave pabbatarājaṃ nissāya mahāsālā pañcahi vaḍḍhīhi vaḍḍhanti. ",
  "an5.40:1.2": "Katamāhi pañcahi? 2. ",
  "an5.40:1.3": "Sākhāpattapalāsena vaḍḍhanti, ",
  "an5.40:1.4": "tacena vaḍḍhanti, ",
  "an5.40:1.5": "papaṭikāya vaḍḍanti, ",
  "an5.40:1.6": "pheggunā vaḍḍhanti, ",
  "an5.40:1.7": "sārena vaḍḍhanti. ",
  "an5.40:1.8": "Himavantaṃ bhikkhave pabbatarājaṃ nissāya mahāsālā imāhi pañcahi vaḍḍhīhi vaḍḍhanti. ",
  "an5.40:1.9": "Evam eva kho bhikkhave saddhaṃ kulapatiṃ nissāya antojano pañcahi vaḍḍhīhi vaḍḍhati. ",
  "an5.40:1.10": "Katamāhi pañcahi? 3. ",
  "an5.40:1.11": "Saddhāya vaḍḍhati, ",
  "an5.40:1.12": "sīlena vaḍḍhati, ",
  "an5.40:1.13": "sutena vaḍḍhati, ",
  "an5.40:1.14": "cāgena vaḍḍhati, ",
  "an5.40:1.15": "paññāya vaḍḍhati. ",
  "an5.40:1.16": "Saddhaṃ bhikkhave kulapatiṃ nissāya antojano imāhi pañcahi vaḍḍhīhi vaḍḍhatī ti. ",
  "an5.40:2.1": "Yathā hi pabbato selo ",
  "an5.40:2.2": "araññasmiṃ brahāvane ",
  "an5.40:2.3": "taṃ rukkhā upanissāya ",
  "an5.40:2.4": "vaḍḍhante te vanappatī, ",
  "an5.40:3.1": "tath'eva sīlasampannaṃ ",
  "an5.40:3.2": "saddhaṃ kulapatim idha ",
  "an5.40:3.3": "upanissāya vaḍḍhanti ",
  "an5.40:3.4": "puttadārā ca bandhavā ",
  "an5.40:3.5": "amaccā ñātisaṅghā ca ",
  "an5.40:3.6": "ye c'assa anujīvino, ",
  "an5.40:4.1": "tyāssa sīlavato sīlaṃ ",
  "an5.40:4.2": "cāgaṃ sucaritāni ca ",
  "an5.40:4.3": "passamānānukubbanti ",
  "an5.40:4.4": "ye bhavanti vicakkhaṇā; ",
  "an5.40:5.1": "idha dhammaṇ caritvāna ",
  "an5.40:5.2": "maggaṃ sugatigāminaṃ ",
  "an5.40:5.3": "nandino devalokasmiṃ ",
  "an5.40:5.4": "modanti kāmakāmino ti. ",
  "an5.40:5.5": "",
  "an5.40:5.6": "Udānaṃ: ",
  "an5.40:6.0": "",
  "an5.40:6.1": "Sumanā Cundi Uggaho ",
  "an5.40:6.2": "Sīho dānānisaṃsayo ",
  "an5.40:6.3": "Kālabhojanasaddhā ca ",
  "an5.40:6.4": "ṭhānaputtena te dasā ti. 1. "
}
