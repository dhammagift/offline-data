  "an5.15:0.3": "",
  "an5.15:1.1": "bhikkhave balāni. ",
  "an5.15:1.2": "Katamāni pañca? 2. ",
  "an5.15:1.3": "Saddhābalaṃ, viriyabalaṃ, satibalaṃ, samādhibalaṃ, paññābalaṃ. ",
  "an5.15:1.4": "Kattha ca bhikkhave saddhābalaṃ daṭṭhabbaṃ? 3. ",
  "an5.15:1.5": "Catūsu sotāpattiyaṅgesu. ",
  "an5.15:1.6": "Ettha saddhābalaṃ daṭṭhabbam. ",
  "an5.15:1.7": "Kattha ca bhikkhave viriyabalaṃ daṭṭhabbaṃ? 4. ",
  "an5.15:1.8": "Catūsu sammappadhānesu. ",
  "an5.15:1.9": "Ettha viriyabalaṃ daṭṭhabbaṃ. ",
  "an5.15:1.10": "Kattha ca bhikkhave satibalaṃ daṭṭhabbaṃ? 5. ",
  "an5.15:1.11": "Catūsu satipaṭṭhānesu. ",
  "an5.15:1.12": "Ettha satibalaṃ daṭṭhabbaṃ. ",
  "an5.15:1.13": "Kattha ca bhikkhave samādhibalaṃ daṭṭhabbaṃ? 6. ",
  "an5.15:1.14": "Catūsu jhānesu. ",
  "an5.15:1.15": "Ettha samādhibalaṃ daṭṭhabbaṃ. ",
  "an5.15:1.16": "Kattha ca bhikkhave paññābalaṃ daṭṭhabbaṃ? 7. ",
  "an5.15:1.17": "Catūsu ariyasaccesu. ",
  "an5.15:1.18": "Ettha paññābalaṃ daṭṭhabbaṃ. ",
  "an5.15:1.19": "Imāni kho bhikkhave pañca balānī ti. 1. ",
  "an5.15:1.20": "Pañc' imāni "
}
