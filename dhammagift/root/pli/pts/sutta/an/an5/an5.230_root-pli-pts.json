  "an5.230:0.1": "",
  "an5.230:0.2": "",
  "an5.230:0.3": "",
  "an5.230:1.1": "Pañc'ime bhikkhave ādīnavā kaṇhasappe. ",
  "an5.230:1.2": "Katame pañca? 2. ",
  "an5.230:1.3": "Kodhano, upanāhī, ghoraviso, dujjivho, mittadubbhī. ",
  "an5.230:1.4": "Ime kho bhikkhave pañca ādīnavā kaṇhasappe. 3. ",
  "an5.230:2.1": "Evam eva kho bhikkhave pañc'ime ādīnavā mātugāme ",
  "an5.230:2.2": "Katame pañca? 4. ",
  "an5.230:2.3": "Kodhano, upanāhī, ghoraviso, dujjivho, mittadubbhī. 5. ",
  "an5.230:2.4": "Tatr' idaṃ bhikkhave mātugāmassa ghoravisatā: ",
  "an5.230:2.5": "yebhuyyena bhikkhave mātugāmo tibbarāgo. ",
  "an5.230:2.6": "Tatr' idaṃ bhikkhave mātugāmassa dujjivhatā: ",
  "an5.230:2.7": "yebhuyyena bhikkhave mātugāmo pisunavāco. ",
  "an5.230:2.8": "Tatr' idaṃ bhikkhave mātugāmassa mittadubbhitā: ",
  "an5.230:2.9": "yebhuyyena bhikkhave mātugāmo aticārinī. ",
  "an5.230:2.10": "Ime kho bhikkhave pañca ādīnavā mātugāme ti. ",
  "an5.230:2.11": "",
  "an5.230:2.12": "",
  "an5.230:3.0": "",
  "an5.230:3.1": "Dīghacārikā dve vuttā ",
  "an5.230:3.2": "atinivāsamacchare ",
  "an5.230:3.3": "Dve ca kulupakā bhogo ",
  "an5.230:3.4": "bhattaṃ sappāpare duve ti. 1. "
}
