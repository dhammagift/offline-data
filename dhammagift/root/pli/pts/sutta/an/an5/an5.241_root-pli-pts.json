  "an5.241:0.1": "",
  "an5.241:0.2": "",
  "an5.241:0.3": "",
  "an5.241:1.1": "Pañc'ime bhikkhave ādīnavā duccarite. ",
  "an5.241:1.2": "Katame pañca? 2. ",
  "an5.241:1.3": "Attā pi attānaṃ upavadati, ",
  "an5.241:1.4": "anuvicca viññū garahanti, ",
  "an5.241:1.5": "pāpako kittisaddo abbhuggacchati, ",
  "an5.241:1.6": "sammūḷho kālaṃ karoti, ",
  "an5.241:1.7": "kāyassa bhedā parammaraṇā apāyaṃ duggatiṃ vinipātaṃ nirayaṃ upapajjati. ",
  "an5.241:1.8": "Ime kho bhikkhave pañca ādīnavā duccarite. 3. ",
  "an5.241:2.1": "Pañc'ime bhikkhave ānisaṃsā sucarite. ",
  "an5.241:2.2": "Katame pañca? 4. ",
  "an5.241:2.3": "Attā pi attānaṃ na upavadati, ",
  "an5.241:2.4": "anuvicca viññū pasaṃsanti, ",
  "an5.241:2.5": "kalyāṇo kittisaddo abbhuggacchati, ",
  "an5.241:2.6": "asammūḷho kālaṃ karoti, ",
  "an5.241:2.7": "kāyassa bhedā parammaraṇā sugatiṃ saggaṃ lokaṃ upapajjati. ",
  "an5.241:2.8": "Ime kho bhikkhave pañca ānisaṃsā sucarite ",
  "an5.241:2.9": "ti. 1. "
}
