  "an5.245:0.1": "",
  "an5.245:0.2": "",
  "an5.245:0.3": "",
  "an5.245:1.1": "Pañc'ime bhikkhave ādīnavā duccarite. ",
  "an5.245:1.2": "Katame pañca? 2. ",
  "an5.245:1.3": "Attā pi attānaṃ upavadati, ",
  "an5.245:1.4": "anuvicca viññū garahanti, ",
  "an5.245:1.5": "pāpako kittisaddo abbhuggacchati, ",
  "an5.245:1.6": "saddhammā vuṭṭhāti, ",
  "an5.245:1.7": "asaddhamme patiṭṭhāti. ",
  "an5.245:1.8": "Ime kho bhikkhave pañca ādīnavā duccarite. 3. ",
  "an5.245:2.1": "Pañc'ime bhikkhave ānisaṃsā sucarite. ",
  "an5.245:2.2": "Katame pañca? 4. ",
  "an5.245:2.3": "Attā pi attānaṃ na upavadati, ",
  "an5.245:2.4": "anuvicca viññū pasaṃsanti, ",
  "an5.245:2.5": "kalyāṇo kittisaddo abbhuggacchati, ",
  "an5.245:2.6": "asaddhammā vuṭṭhāti, ",
  "an5.245:2.7": "saddhamme patiṭṭhāti. ",
  "an5.245:2.8": "Ime kho bhikkhave pañca ānisaṃsā sucarite ",
  "an5.245:2.9": "ti. 1. "
}
