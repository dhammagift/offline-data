  "an5.220:1.1": "Pañc'ime bhikkhave ādīnavā Madhurāyaṃ. ",
  "an5.220:1.2": "Katame pañca? 2. ",
  "an5.220:1.3": "Visamā, bahurajā, caṇḍā sunakhā, vāḷā yakkhā, dullabhapiṇḍā. ",
  "an5.220:1.4": "Ime kho bhikkhave pañca ādīnavā Madhurāyan ti. ",
  "an5.220:1.5": "",
  "an5.220:1.6": "",
  "an5.220:2.0": "",
  "an5.220:2.1": "Akkosabhaṇḍanasīlaṃ ",
  "an5.220:2.2": "bahubhāṇī dve akhantiyo ",
  "an5.220:2.3": "Apāsādikā dve vuttā ",
  "an5.220:2.4": "aggismiṃ Madhurenā cā ti. 1. "
}
