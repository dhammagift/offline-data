  "an7.29:0.3": "",
  "an7.29:1.1": "bhikkhave dhammā upāsakassa parihānāya saṃvattanti. ",
  "an7.29:1.2": "Katame satta? 2. ",
  "an7.29:1.3": "Bhikkhudassanaṃ hāpeti, ",
  "an7.29:1.4": "saddhammasavanaṃ pamajjati, ",
  "an7.29:1.5": "adhisīle na sikkhati, ",
  "an7.29:1.6": "appasādabahulo hoti ",
  "an7.29:1.7": "bhikkhūsu theresu c' eva navesu ca majjhimesu ca, upārambhacitto dhammaṃ suṇāti randhagavesī, ",
  "an7.29:1.8": "ito bahiddhā dakkhineyyaṃ gavesati, ",
  "an7.29:1.9": "tattha ca pubbakāraṃ karoti. ",
  "an7.29:1.10": "Ime kho bhikkhave satta dhammā upāsakassa parihānāya saṃvattanti. 3. ",
  "an7.29:2.1": "Satt' ime bhikkhave dhammā upāsakassa aparihānāya saṃvattanti. ",
  "an7.29:2.2": "Katame satta? 4. ",
  "an7.29:2.3": "Bhikkhudassanaṃ na hāpeti, ",
  "an7.29:2.4": "saddhammasavanaṃ na ppamajjati, ",
  "an7.29:2.5": "adhisīle sikkhati, ",
  "an7.29:2.6": "pasādabahulo hoti ",
  "an7.29:2.7": "bhikkhūsu theresu c' eva navesu ca majjhimesu ca, anupārambhacitto dhammaṃ suṇāti na randhagavesī, ",
  "an7.29:2.8": "na ito bahiddhā dakkhiṇeyyaṃ gavesati, ",
  "an7.29:2.9": "idha ca pubbakāraṃ karoti. ",
  "an7.29:2.10": "Ime kho bhikkhave satta dhammā upāsakassa aparihānāya saṃvattantī ti. ",
  "an7.29:2.11": "",
  "an7.29:2.12": "",
  "an7.29:3.1": "Dassanaṃ bhāvitattānaṃ ",
  "an7.29:3.2": "yo hāpeti upāsako ",
  "an7.29:3.3": "savanañ ca ariyadhammānaṃ ",
  "an7.29:3.4": "adhisīle na sikkhati ",
  "an7.29:4.1": "appasādo ca bhikkhūsu ",
  "an7.29:4.2": "bhīyo bhīyo pavaḍḍhati ",
  "an7.29:4.3": "upārambhakacitto ca ",
  "an7.29:4.4": "saddhammaṃ sotum icchati ",
  "an7.29:5.1": "ito ca bahiddhā aññaṃ ",
  "an7.29:5.2": "dakkhiṇeyyaṃ gavesati ",
  "an7.29:5.3": "tatth' eva ca pubbakāraṃ ",
  "an7.29:5.4": "yo karoti upāsako: ",
  "an7.29:6.1": "ete kho parihānīye ",
  "an7.29:6.2": "satta dhamme sudesite ",
  "an7.29:6.3": "upāsako sevamāno ",
  "an7.29:6.4": "saddhammā parihāyati. ",
  "an7.29:7.1": "Dassanaṃ bhāvitattānaṃ ",
  "an7.29:7.2": "yo na hāpeti upāsako ",
  "an7.29:7.3": "savanañ ca ariyadhammānaṃ ",
  "an7.29:7.4": "adhisīle ca sikkhati ",
  "an7.29:8.1": "pasādo c' assa bhikkhūsu ",
  "an7.29:8.2": "bhīyo bhīyo pavaḍḍhati ",
  "an7.29:8.3": "anupārambhacitto ca ",
  "an7.29:8.4": "saddhammaṃ sotum icchati ",
  "an7.29:9.1": "na ito bahiddhā aññaṃ ",
  "an7.29:9.2": "dakkhiṇeyyaṃ gavesati ",
  "an7.29:9.3": "idh' eva ca pubbakāraṃ ",
  "an7.29:9.4": "yo karoti upāsako: ",
  "an7.29:10.1": "ete kho aparihānīye ",
  "an7.29:10.2": "satta dhamme sudesite ",
  "an7.29:10.3": "upāsako sevamāno ",
  "an7.29:10.4": "saddhammā na parihāyatī ti. 1. ",
  "an7.29:10.5": "Satt' imā "
}
