{
  "an7.31:0.1": "",
  "an7.31:0.2": "",
  "an7.31:0.3": "",
  "an7.31:1.1": "bhikkhave upāsakassa parābhavā . . . ",
  "an7.31:1.2": "satt' ime bhikkhave upāsakassa sambhavā. ",
  "an7.31:1.3": "Katame satta? 2. ",
  "an7.31:1.4": "Bhikkhudassanaṃ na hāpeti, ",
  "an7.31:1.5": "saddhammasavanaṃ na ppamajjati, ",
  "an7.31:1.6": "adhisīle sikkati, ",
  "an7.31:1.7": "pasādabahulo hoti ",
  "an7.31:1.8": "bhikkhūsu theresu c' eva navesu ca majjhimesu ca, anupārambhacitto dhammaṃ suṇāti na randhagavesī, ",
  "an7.31:1.9": "na ito bahiddhā dakkhiṇeyyaṃ gavesati, ",
  "an7.31:1.10": "idha ca pubbakāraṃ karoti. ",
  "an7.31:1.11": "Ime kho bhikkhave satta upāsakassa sambhavā ti. ",
  "an7.31:2.1": "Dassanaṃ bhāvitattānaṃ ",
  "an7.31:2.2": "yo hāpeti upāsako ",
  "an7.31:2.3": "savanañ ca ariyadhammānaṃ ",
  "an7.31:2.4": "adhisīle na sikkhati ",
  "an7.31:3.1": "appasādo ca bhikkhūsu ",
  "an7.31:3.2": "bhīyo bhīyo pavaḍḍhati ",
  "an7.31:3.3": "upārambhakacitto ca ",
  "an7.31:3.4": "saddhammaṃ sotum icchati ",
  "an7.31:4.1": "ito ca bahiddhā aññaṃ ",
  "an7.31:4.2": "dakkhiṇeyyaṃ gavesati ",
  "an7.31:4.3": "tatth' eva ca pubbakāraṃ ",
  "an7.31:4.4": "yo karoti upāsako: ",
  "an7.31:5.1": "ete kho parihānīye ",
  "an7.31:5.2": "satta dhamme sudesite ",
  "an7.31:5.3": "upāsako sevamāno ",
  "an7.31:5.4": "saddhammā parihāyati. ",
  "an7.31:6.1": "Dassanaṃ bhāvitattānaṃ ",
  "an7.31:6.2": "yo na hāpeti upāsako ",
  "an7.31:6.3": "savanañ ca ariyadhammānaṃ ",
  "an7.31:6.4": "adhisīle ca sikkhati ",
  "an7.31:7.1": "pasādo c' assa bhikkhūsu ",
  "an7.31:7.2": "bhīyo bhīyo pavaḍḍhati ",
  "an7.31:7.3": "anupārambhacitto ca ",
  "an7.31:7.4": "saddhammaṃ sotum icchati ",
  "an7.31:8.1": "na ito bahiddhā aññaṃ ",
  "an7.31:8.2": "dakkhiṇeyyaṃ gavesati ",
  "an7.31:8.3": "idh' eva ca pubbakāraṃ ",
  "an7.31:8.4": "yo karoti upāsako: ",
  "an7.31:9.1": "ete kho aparihānīye ",
  "an7.31:9.2": "satta dhamme sudesite ",
  "an7.31:9.3": "upāsako sevamāno ",
  "an7.31:9.4": "saddhammā na parihāyatī ti. ",
  "an7.31:9.5": "",
  "an7.31:9.6": "",
  "an7.31:10.0": "",
  "an7.31:10.1": "Sārandado Vassakāro bhikkhu kammañ ca ",
  "an7.31:10.2": "saddhiyaṃ Bodhisaññaṃ ",
  "an7.31:10.3": "sekho ca hāni ",
  "an7.31:10.4": "vipatti ca parābhavo ti. 1. "
}
