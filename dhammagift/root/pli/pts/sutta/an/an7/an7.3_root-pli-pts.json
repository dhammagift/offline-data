  "an7.3:1.2": "",
  "an7.3:1.3": "bhikkhave balāni. ",
  "an7.3:1.4": "Katamāni satta? 2. ",
  "an7.3:1.5": "Saddhābalaṃ, viriyabalaṃ, hiribalaṃ, ottappabalaṃ, satibalaṃ, samādhibalaṃ, paññābalaṃ. ",
  "an7.3:1.6": "Imāni kho bhikkhave satta balānī ti. ",
  "an7.3:2.1": "Saddhābalaṃ viriyañ ca ",
  "an7.3:2.2": "hiri ottappiyaṃ balaṃ ",
  "an7.3:2.3": "satibalaṃ samādhiñ ca ",
  "an7.3:2.4": "paññā ve sattamaṃ balaṃ. ",
  "an7.3:2.5": "Etehi balavā bhikkhu ",
  "an7.3:2.6": "sukhaṃ jīvati paṇḍito, ",
  "an7.3:3.1": "yoniso vicine dhammaṃ, ",
  "an7.3:3.2": "paññāyatthaṃ vipassati, ",
  "an7.3:3.3": "pajjotass' eva nibbānaṃ, ",
  "an7.3:3.4": "vimokho hoti cetaso ti. 1. ",
  "an7.3:3.5": "Satt' imāni "
}
