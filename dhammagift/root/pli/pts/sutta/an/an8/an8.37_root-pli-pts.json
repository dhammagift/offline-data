  "an8.37:0.3": "",
  "an8.37:1.1": "bhikkhave sappurisadānāni. ",
  "an8.37:1.2": "Katamāni aṭṭha? 2. ",
  "an8.37:1.3": "Suciṃ deti, paṇītaṃ deti, kālena deti, kappiyaṃ deti, viceyya deti, abhiṇhaṃ deti, dadaṃ cittaṃ pasādeti, datvā attamano hoti. ",
  "an8.37:1.4": "Imāni kho bhikkhave aṭṭha sappurisadānānī ti. ",
  "an8.37:2.1": "Suciṃ paṇītaṃ kālena ",
  "an8.37:2.2": "kappiyaṃ pānabhojanaṃ ",
  "an8.37:2.3": "abhiṇhaṃ dadāti dānāni ",
  "an8.37:2.4": "sukhette brahmacārisu ",
  "an8.37:3.1": "na ca vippaṭisāri 'ssa ",
  "an8.37:3.2": "cajitvā āmisaṃ bahuṃ. ",
  "an8.37:3.3": "Evaṃ dinnāni dānāni ",
  "an8.37:3.4": "vaṇṇayanti vipassino, ",
  "an8.37:4.1": "evaṃ yajitvā medhāvi ",
  "an8.37:4.2": "saddho muttena cetasā ",
  "an8.37:4.3": "avyāpajjhaṃ sukhaṃ lokaṃ ",
  "an8.37:4.4": "paṇḍito upapajjatī ",
  "an8.37:4.5": "ti. 1. "
}
