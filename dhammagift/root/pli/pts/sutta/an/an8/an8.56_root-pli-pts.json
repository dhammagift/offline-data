{
  "an8.56:0.1": "",
  "an8.56:0.2": "",
  "an8.56:0.3": "",
  "an8.56:1.1": "bhikkhave kāmānam etaṃ adhivacanaṃ, ",
  "an8.56:1.2": "‘dukkhan' ti bhikkhave kāmānam etaṃ adhivacanaṃ, ",
  "an8.56:1.3": "‘rogo' ti bhikkhave kāmānam etaṃ adhivacanaṃ, ",
  "an8.56:1.4": "‘gaṇḍo' ti bhikkhave kāmānam etaṃ adhivacanaṃ, ",
  "an8.56:1.5": "‘sallan' ti bhikkhave kāmānam etaṃ adhivacanaṃ, ",
  "an8.56:1.6": "‘saṅgo' ti bhikkhave kāmānam etaṃ adhivacanaṃ, ",
  "an8.56:1.7": "‘paṅko' ti bhikkhave kāmānam etaṃ adhivacanaṃ, ",
  "an8.56:1.8": "‘gabbho' ti bhikkhave kāmānam etaṃ adhivacanaṃ. 2. ",
  "an8.56:1.9": "Kasmā ca bhikkhave ‘bhayan' ti kāmānam etaṃ adhivacanaṃ? ",
  "an8.56:1.10": "Yasmā ca kāmarāgarattāyaṃ bhikkhave chandarāgavinibaddho diṭṭhadhammikā pi bhayā na parimuccati, samparāyikā pi bhayā na parimuccati, tasmā ‘bhayan' ti kāmānam etaṃ adhivacanaṃ. 3. ",
  "an8.56:1.11": "Kasmā ca bhikkhave ‘dukkhan' ti . . . ",
  "an8.56:1.12": "‘rogo' ti . . . ",
  "an8.56:1.13": "‘gaṇḍo' ti . . . ",
  "an8.56:1.14": "‘sallan' ti . . . ",
  "an8.56:1.15": "‘saṅgo' ti . . . ",
  "an8.56:1.16": "‘paṅko' ti . . . ",
  "an8.56:1.17": "‘gabbho' ti kāmānam etaṃ adhivacanaṃ? ",
  "an8.56:1.18": "Yasmā ca kāmarāgarattāyaṃ bhikkhave chandarāgavinibaddho diṭṭhadhammikā pi gabbhā na parimuccati, samparāyikā pi gabbhā na parimuccati, tasmā ‘gabbho' ti kāmānam etaṃ adhivacanan ti. ",
  "an8.56:2.1": "Bhayaṃ dukkhañ ca rogo ca ",
  "an8.56:2.2": "gaṇḍo sallañ ca saṅgo ca ",
  "an8.56:2.3": "paṅko gabbho ca ubhayaṃ. ",
  "an8.56:2.4": "Ete kāmā pavuccanti ",
  "an8.56:2.5": "yattha satto puthujjano ",
  "an8.56:3.1": "otiṇṇo sātarūpena ",
  "an8.56:3.2": "puna gabbhāya gacchati ",
  "an8.56:3.3": "yato ca bhikkhu ātāpi ",
  "an8.56:3.4": "sampajaññaṃ na riñcati. ",
  "an8.56:4.1": "So imaṃ palipathaṃ duggaṃ ",
  "an8.56:4.2": "atikkamma tathāvidho ",
  "an8.56:4.3": "pajaṃ jātijarūpetaṃ ",
  "an8.56:4.4": "phandamānaṃ avekkhatī ",
  "an8.56:4.5": "ti. 1. "
}
