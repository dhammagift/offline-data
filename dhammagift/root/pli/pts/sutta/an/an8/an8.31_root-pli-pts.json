  "an8.31:0.3": "",
  "an8.31:1.1": "bhikkhave dānāni. ",
  "an8.31:1.2": "Katamāni aṭṭha? 2. ",
  "an8.31:1.3": "Āsajja dānaṃ deti, ",
  "an8.31:1.4": "bhayā dānaṃ deti, ",
  "an8.31:1.5": "‘adāsi me' ti dānaṃ deti, ",
  "an8.31:1.6": "‘dassati me' ti dānaṃ deti, ",
  "an8.31:1.7": "‘sāhu dānan' ti dānaṃ deti, ",
  "an8.31:1.8": "‘ahaṃ pacāmi, ime na pacanti, na arahāmi pacanto apacantānaṃ adātun' ti dānaṃ deti, ",
  "an8.31:1.9": "‘imaṃ me dānaṃ dadato kalyāṇo kittisaddo abbhuggacchatī' ti dānaṃ deti, ",
  "an8.31:1.10": "cittālaṅkāracittaparikkhāratthaṃ dānaṃ deti. ",
  "an8.31:1.11": "Imāni kho bhikkhave aṭṭha dānānī ",
  "an8.31:1.12": "ti. "
}
