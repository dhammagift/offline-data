  "an3.134:1.1": "Tisso imā bhikkhave parisā. ",
  "an3.134:1.2": "Katamā tisso? ",
  "an3.134:1.3": "Ukkācitavinītā parisā, paripucchāvinītā parisā, yāvatajjhāvinītā parisā. ",
  "an3.134:1.4": "Imā kho bhikkhave tisso parisā ",
  "an3.134:1.5": "ti. 133. "
}
