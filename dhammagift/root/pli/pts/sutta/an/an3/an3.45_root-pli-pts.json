  "an3.45:0.1": "",
  "an3.45:0.2": "",
  "an3.45:0.3": "",
  "an3.45:1.1": "bhikkhave paṇḍitapaññattāni sappurisapaññattāni. ",
  "an3.45:1.2": "Katamāni tīṇi? ",
  "an3.45:1.3": "Dānaṃ bhikkhave paṇḍitapaññattaṃ sappurisapaññattaṃ, ",
  "an3.45:1.4": "pabbajjā bhikkhave paṇḍitapaññattā sappurisapaññattā, ",
  "an3.45:1.5": "mātāpitunnaṃ bhikkhave upaṭṭhānaṃ paṇḍitapaññattaṃ sappurisapaññattaṃ. ",
  "an3.45:1.6": "Imāni kho bhikkhave tīṇi paṇḍitapaññattāni sappurisapaññattāni. ",
  "an3.45:2.1": "Sabbhi dānaṃ upaññattaṃ ",
  "an3.45:2.2": "ahiṃsā saññamo damo ",
  "an3.45:2.3": "Mātāpitu upaṭṭhānaṃ ",
  "an3.45:2.4": "santānaṃ brahmacārinaṃ ",
  "an3.45:3.1": "Satam etāni ṭhānāni ",
  "an3.45:3.2": "yāni sevetha paṇḍito ",
  "an3.45:3.3": "Ariyo dassanasampanno ",
  "an3.45:3.4": "sa lokaṃ bhajate sivan ",
  "an3.45:3.5": "ti. 46. "
}
