{
  "an1.248:0.1": "",
  "an1.248:0.2": "",
  "an1.248:1.1": "Etad aggaṃ bhikkhave mama sāvakānaṃ upāsakānaṃ paṭhamaṃ saraṇaṃ gacchantānaṃ yadidaṃ Tapassu-Bhallikā vāṇijā. ",
  "an1.249:1.1": "dāyakānaṃ yadidaṃ Sudatto gahapati Anāthapiṇḍiko. ",
  "an1.250:1.1": "dhammakathikānaṃ yadidaṃ Citto gahapati Macchikasaṇḍiko. ",
  "an1.251:1.1": "catūhi saṅgaha-vatthūhi parisaṃ saṅgaṇhantānaṃ yadidaṃ Haṭṭhako Āḷavako. ",
  "an1.252:1.1": "paṇītadāyakānaṃ yadidaṃ Mahānāmo Sakko. ",
  "an1.253:1.1": "manāpadāyakānaṃ yadidaṃ Uggo gahapati Vesāliko. ",
  "an1.254:1.1": "saṅghupaṭṭhākānaṃ yadidaṃ Uggato gahapati. ",
  "an1.255:1.1": "aveccappasannānaṃ yadidaṃ Sūro Ambaṭṭho. ",
  "an1.256:1.1": "puggalappasannānaṃ yadidaṃ Jīvako Komārabhacco. ",
  "an1.257:1.1": "vissāsakānaṃ yadidaṃ Nakulapitā gahapati ti. 7. ",
  "an1.257:1.2": ""
}
