{
  "an1.219:0.1": "",
  "an1.219:0.2": "",
  "an1.219:1.1": "bhikkhave mama sāvakānaṃ bhikkhūnaṃ bahussutānaṃ yadidaṃ Ānando. ",
  "an1.220:1.1": "satimantānaṃ yadidaṃ Ānando. ",
  "an1.221:1.1": "gatimantānaṃ yadidaṃ Ānando. ",
  "an1.222:1.1": "dhitimantānaṃ yadidaṃ Ānando. ",
  "an1.223:1.1": "upaṭṭhākānaṃ yadidaṃ Ānando. ",
  "an1.224:1.1": "mahāparisānaṃ yadidaṃ Uruvela-kassapo. ",
  "an1.225:1.1": "kulappasādakānaṃ yadidaṃ Kāḷudāyī. ",
  "an1.226:1.1": "appābādhānaṃ yadidaṃ Bakkulo. ",
  "an1.227:1.1": "pubbenivāsaṃ anussarantānaṃ yadidaṃ Sobhito. ",
  "an1.228:1.1": "vinayadharānaṃ yadidaṃ Upāli. bhikkhun' ovādakānaṃ ",
  "an1.229:1.1": "yadidaṃ Nandako. ",
  "an1.230:1.1": "indriyesu-gutta-dvārānaṃ yadidaṃ Nando. bhikkhu-ovādakānaṃ ",
  "an1.231:1.1": "yadidaṃ Mahā-kappino. tejo-dhātukusalānaṃ ",
  "an1.232:1.1": "yadidaṃ Sāgato. ",
  "an1.233:1.1": "paṭibhāneyyakānaṃ yadidaṃ Rādho. lūkhacīvara-dharānaṃ ",
  "an1.234:1.1": "yadidaṃ Mogharājā ti. 5. ",
  "an1.234:1.2": "Etad aggaṃ "
}
