{
  "an1.188:0.1": "",
  "an1.188:0.2": "",
  "an1.188:1.1": "Etad aggaṃ bhikkhave mama sāvakānaṃ bhikkhūnaṃ rattaññūnaṃ yadidaṃ Aññākoṇḍañño. ",
  "an1.189:1.1": "mahāpaññānaṃ yadidaṃ Sāriputto. ",
  "an1.190:1.1": "iddhimantānaṃ yadidaṃ MahāMoggallāno. ",
  "an1.191:1.1": "dhutavādānaṃ yadidaṃ Mahā Kassapo. ",
  "an1.192:1.1": "dibbacakkhukānaṃ yadidaṃ Anuruddho. ",
  "an1.193:1.1": "uccākulikānaṃ yadidaṃ Bhaddiyo Kāligodhā-yaputto. ",
  "an1.194:1.1": "mañjussarānaṃ yadidaṃ Lakuṇṭaka-bhaddiyo. ",
  "an1.195:1.1": "sīhanādikānaṃ yadidaṃ Piṇḍola-Bhāradvājo. ",
  "an1.196:1.1": "dhammakathikānaṃ yadidaṃ Puṇṇo Mantāni-putto. ",
  "an1.197:1.1": "saṅkhittena bhāsitas- savitthārena atthaṃ vibhajantānaṃ yadidaṃ Mahā Kaccāno ti. 2. Etad aggaṃ ",
  "an1.197:1.2": ""
}
