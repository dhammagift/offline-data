{
  "an1.198:0.1": "",
  "an1.198:0.2": "",
  "an1.198:1.1": "bhikkhave mama sāvakānaṃ bhikkhūnaṃ manomayaṃ kāyaṃ abhinimminantānaṃ yadidaṃ Culla-panthako. ceto-vivaṭṭa-kusalānam ",
  "an1.199:1.1": "yadidaṃ Cullapanthako. saññā-vivaṭṭa-kusalānaṃ ",
  "an1.200:1.1": "yadidaṃ Mahāpanthako. ",
  "an1.201:1.1": "araṇavihārīnaṃ yadidaṃ Subhūti. ",
  "an1.202:1.1": "dakkhiṇeyyānaṃ yadidaṃ Subhūti. āraññikānaṃ ",
  "an1.203:1.1": "yadidaṃ Revato Khadiravaniyo. ",
  "an1.204:1.1": "jhāyīnaṃ yadidaṃ Kaṅkhā-revato. āraddha-viriyānaṃ ",
  "an1.205:1.1": "yadidaṃ Soṇo Kolivīso. ",
  "an1.206:1.1": "kalyāṇavākkaraṇānaṃ yadidaṃ Soṇo Kuṭikaṇṇo. ",
  "an1.207:1.1": "lābhīnaṃ yadidaṃ Sīvali. ",
  "an1.208:1.1": "saddhādhimuttānaṃ yadidaṃ Vakkalī ti. 3. ",
  "an1.208:1.2": "Etad aggaṃ "
}
