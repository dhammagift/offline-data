{
  "an1.258:0.1": "",
  "an1.258:0.2": "",
  "an1.258:1.1": "Etad aggaṃ bh- mama sāvikānaṃ upāsikānaṃ paṭhamaṃ saraṇaṃ gacchantīnaṃ yadidaṃ Sujātā Senānidhītā. ",
  "an1.259:1.1": "dāyikānaṃ yadidaṃ Visākhā Migāramātā. ",
  "an1.260:1.1": "bahussutānaṃ yadidaṃ Khujjuttarā. ",
  "an1.261:1.1": "mettāvihārīnaṃ yadidaṃ Sāmāvatī. ",
  "an1.262:1.1": "jhāyīnaṃ yadidaṃ Uttarā Nandamātā. ",
  "an1.263:1.1": "paṇītadāyikānaṃ yadidaṃ Suppavāsā Koḷiyadhītā. ",
  "an1.264:1.1": "gilānūpaṭṭhākīnaṃ yadidaṃ Suppiyā upāsikā. ",
  "an1.265:1.1": "aveccappasannānaṃ yadidaṃ Kātiyānī. ",
  "an1.266:1.1": "vissāsikānaṃ yadidaṃ Nakulamātā gahapatānī. ",
  "an1.267:1.1": "anussavappasannānaṃ yadidaṃ Kāḷī upāsikā Kurara- gharikā ti. 1. ",
  "an1.267:1.2": "",
  "an1.267:1.3": ""
}
