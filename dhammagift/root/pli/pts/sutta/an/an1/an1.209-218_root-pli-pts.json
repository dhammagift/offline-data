{
  "an1.209:0.1": "",
  "an1.209:0.2": "",
  "an1.209:1.1": "bhikkhave mama sāvakānaṃ bhikkhūnaṃ sikkhākāmānaṃ yadidaṃ Rāhulo. ",
  "an1.210:1.1": "saddhāpabbajitānaṃ yadidaṃ Raṭṭhapālo. ",
  "an1.211:1.1": "paṭhamaṃ salākaṃ gaṇhantānaṃ yadidam Kuṇḍadhāno. ",
  "an1.212:1.1": "paṭibhānavantānaṃ yadidaṃ Vaṅgīso. ",
  "an1.213:1.1": "samantapāsādikānaṃ yadidaṃ Upaseno Vaṅgantaputto. ",
  "an1.214:1.1": "senāsanapaññāpakānaṃ yadidaṃ Dabbo Mallaputto. ",
  "an1.215:1.1": "devatānaṃ piyamanāpānaṃ yadidaṃ Pilinda-vaccho. ",
  "an1.216:1.1": "khippābhiññānaṃ yadidaṃ Bāhiyo Dārucīriyo. ",
  "an1.217:1.1": "cittakathikānaṃ yadidaṃ Kumāra-kassapo. paṭisambhidappattā- naṃ ",
  "an1.218:1.1": "yadidaṃ Mahākoṭṭhito ti. 4. ",
  "an1.218:1.2": "Etad aggaṃ "
}
