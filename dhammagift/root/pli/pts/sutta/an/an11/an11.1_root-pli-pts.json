{
  "an11.1:0.1": "",
  "an11.1:0.2": "",
  "an11.1:0.3": "",
  "an11.1:1.1": "",
  "an11.1:1.2": "",
  "an11.1:1.3": "Atha kho āyasmā Ānando yena Bhagavā ten' upasaṅkami, upasaṅkamitvā Bhagavantaṃ abhivādetvā ekamantaṃ nisīdi. Ekamantaṃ nisinno kho āyasmā Ānando Bhagavantaṃ etad avoca ",
  "an11.1:1.4": "‘kim-atthiyāni bhante kusalāni sīlāni kim-ānisaṃsānī' ti? ",
  "an11.1:1.5": "‘Avippaṭisāratthāni kho Ānanda kusalāni sīlāni avippaṭisārānisaṃsāni' . ",
  "an11.1:2.1": "‘Avippaṭisāro pana bhante kim-atthiyo kim-ānisaṃso' ti? ",
  "an11.1:2.2": "‘Avippaṭisāro kho Ānanda pāmujjattho pāmujjānisaṃso' . ",
  "an11.1:3.1": "‘Pāmujjaṃ pana bhante kim-atthiyaṃ kim-ānisaṃsan' ti? ",
  "an11.1:3.2": "‘Pāmujjaṃ kho Ānanda pītatthaṃ pītānisaṃsaṃ' . ",
  "an11.1:4.1": "‘Pīti pana bhante kimatthiyā kim-ānisaṃsā' ti? ",
  "an11.1:4.2": "‘Pīti kho Ānanda passaddhatthā passaddhānisaṃsā' . ",
  "an11.1:5.1": "‘Passaddhi pana bhante kim-atthiyā kim-ānisaṃsā' ti? ",
  "an11.1:5.2": "‘Passaddhi kho Ānanda sukhatthā sukhānisaṃsā' . ",
  "an11.1:6.1": "‘Sukhaṃ pana bhante kim-atthiyaṃ kimānisaṃsan' ti? ",
  "an11.1:6.2": "‘Sukhaṃ kho Ānanda samādhatthaṃ samādhānisaṃsaṃ' . ",
  "an11.1:7.1": "‘Samādhi pana bhante kim-atthiyo kim-ānisaṃso' ti? ",
  "an11.1:7.2": "‘Samādhi kho Ānanda yathābhūtañāṇadassanattho yathābhūtañāṇadassanānisaṃso' . ",
  "an11.1:8.1": "‘Yathābhūtañāṇadassanaṃ pana bhante kim-atthiyaṃ kim-ānisaṃsan' ti? ",
  "an11.1:8.2": "‘Yathābhūtañāṇadassanaṃ kho Ānanda nibbidatthaṃ nibbidānisaṃsaṃ' . ",
  "an11.1:9.1": "‘Nibbidā pana bhante kim-atthiyā kim-ānisaṃsā' ti? ",
  "an11.1:9.2": "‘Nibbidā kho Ānanda virāgatthā virāgānisaṃsā'. ",
  "an11.1:10.1": "‘Virāgo pana bhante kim-atthiyo kim-ānisaṃso' ti? ",
  "an11.1:10.2": "‘Virāgo kho Ānanda vimuttiñāṇadassanattho vimuttiñāṇadassanānisaṃso' ti. 2. ",
  "an11.1:11.1": "Iti kho Ānanda kusalāni sīlāni avippaṭisāratthāni avippaṭisārānisaṃsāni, ",
  "an11.1:11.2": "avippaṭisāro pāmujjattho pāmujjānisaṃso, ",
  "an11.1:11.3": "pāmujjaṃ pītatthaṃ pīṭānisaṃsaṃ, ",
  "an11.1:11.4": "pīti passaddhatthā passaddhānisaṃsā, ",
  "an11.1:11.5": "passaddhi sukhatthā sukhānisaṃsā, ",
  "an11.1:11.6": "sukhaṃ samādatthaṃ samādhānisaṃsaṃ, ",
  "an11.1:11.7": "samādhi yathābhūtañāṇadassanattho yathābhūtañāṇadassanānisaṃso, ",
  "an11.1:11.8": "yathābhūtañāṇadassanaṃ nibbidatthaṃ nibbidānisaṃsam. ",
  "an11.1:11.9": "nibbidā virāgatthā virāgānisaṃsā, ",
  "an11.1:11.10": "virāgo vimuttiñāṇadassanattho vimuttiñāṇadassanānisaṃso. ",
  "an11.1:11.11": "Iti kho Ānanda kusalāni sīlāni anupubbena aggāya parentī ",
  "an11.1:11.12": "ti. 1. "
}
