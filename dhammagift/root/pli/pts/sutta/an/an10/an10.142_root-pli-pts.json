  "an10.142:1.1": "vo bhikkhave dhammaṃ desissāmi apacayagāmiñ ca, ",
  "an10.142:1.2": "taṃ suṇātha . . . pe . . . 2. ",
  "an10.142:1.3": "Katamo ca bhikkhave ācayagāmī dhammo? ",
  "an10.142:1.4": "Micchādiṭṭhi . . . pe . . . micchāvimutti. ",
  "an10.142:1.5": "Ayaṃ vuccati bhikkhave ācayagāmī dhammo. 3. ",
  "an10.142:1.6": "Katamo ca bhikkhave apacayagāmī dhammo? ",
  "an10.142:1.7": "Sammādiṭṭhi . . . pe . . . sammāvimutti. ",
  "an10.142:1.8": "Ayaṃ vuccati bhikkhave apacayagāmī dhammo ti. 1. ",
  "an10.142:1.9": "Dukkhudrayañ ca "
}
