  "an10.145:1.1": "Ariyamaggañ ca vo bhikkhave dhammaṃ desissāmi anariyamaggañ ca, ",
  "an10.145:1.2": "taṃ suṇātha . . . pe . . . 2. ",
  "an10.145:1.3": "Katamo ca bhikkhave anariyo maggo? ",
  "an10.145:1.4": "Micchādiṭṭhi . . . pe . . . micchāvimutti. ",
  "an10.145:1.5": "Ayaṃ vuccati bhikkhave anariyo maggo. 3. ",
  "an10.145:1.6": "Katamo ca bhikkhave ariyo maggo? ",
  "an10.145:1.7": "Sammādiṭṭhi . . . pe . . . sammāvimutti. ",
  "an10.145:1.8": "Ayaṃ vuccati bhikkhave ariyo maggo ti. 1. ",
  "an10.145:1.9": "Sukkamaggañ ca "
}
