  "an10.186:1.1": "vo bhikkhave dhammaṃ desissāmi apacayagāmiñ ca, ",
  "an10.186:1.2": "taṃ suṇātha . . . pe . . . 2. ",
  "an10.186:1.3": "Katamo ca bhikkhave ācayagāmī dhammo? ",
  "an10.186:1.4": "Pāṇātipāto . . . pe . . . ",
  "an10.186:1.5": "micchādiṭṭhi. ",
  "an10.186:1.6": "Ayaṃ vuccati bhikkhave ācayagāmī dhammo. 3. ",
  "an10.186:2.1": "Katamo ca bhikkhave apacayagāmī dhammo? ",
  "an10.186:2.2": "Pāṇātipātā veramaṇī . . . pe . . . ",
  "an10.186:2.3": "sammādiṭṭhi. ",
  "an10.186:2.4": "Ayaṃ vuccati bhikkhave apacayagāmī dhammo ti. 1. ",
  "an10.186:2.5": "Dukkhudrayañ ca "
}
