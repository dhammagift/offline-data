  "an10.146:1.1": "vo bhikkhave dhammaṃ desissāmi kaṇhamaggañ ca, ",
  "an10.146:1.2": "taṃ suṇātha . . . pe . . . 2. ",
  "an10.146:1.3": "Katamo ca bhikkhave kaṇhamaggo? ",
  "an10.146:1.4": "Micchādiṭṭhi . . . pe . . . micchāvimutti. ",
  "an10.146:1.5": "Ayaṃ vuccati bhikkhave kaṇhamaggo? 3. ",
  "an10.146:1.6": "Katamo ca bhikkhave sukkamaggo? ",
  "an10.146:1.7": "Sammādiṭṭhi . . . pe . . . sammāvimutti. ",
  "an10.146:1.8": "Ayaṃ vuccati bhikkhave sukkamaggo ti. 1. ",
  "an10.146:1.9": "Saddhammañ ca "
}
