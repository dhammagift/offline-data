  "an10.135:1.1": "vo bhikkhave desissāmi anariyadhammañ ca, ",
  "an10.135:1.2": "taṃ suṇātha sādhukaṃ manasikarotha . . . pe . . . 2. ",
  "an10.135:1.3": "Katamo ca bhikkhave anariyo dhammo? ",
  "an10.135:1.4": "Micchādiṭṭhi . . . pe . . . micchāvimutti. ",
  "an10.135:1.5": "Ayaṃ vuccati bhikkhave anariyo dhammo. 3. ",
  "an10.135:1.6": "Katamo ca bhikkhave ariyo dhammo? 4. ",
  "an10.135:1.7": "Sammādiṭṭhi . . . pe . . . sammāvimutti. ",
  "an10.135:1.8": "Ayaṃ vuccati bhikkhave ariyo dhammo ti. 1. ",
  "an10.135:1.9": "Kusalañ ca "
}
