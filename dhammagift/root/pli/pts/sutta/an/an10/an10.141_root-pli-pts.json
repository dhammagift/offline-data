  "an10.141:1.1": "vo bhikkhave dhammaṃ desissāmi atapanīyañ ca, ",
  "an10.141:1.2": "taṃ suṇātha . . . pe . . . 2. ",
  "an10.141:1.3": "Katamo ca bhikkhave tapanīyo dhammo? ",
  "an10.141:1.4": "Micchādiṭṭhi . . . pe . . . micchāvimutti. ",
  "an10.141:1.5": "Ayaṃ vuccati bhikkhave tapanīyo dhammo. 3. ",
  "an10.141:1.6": "Katamo ca bhikkhave atapanīyo dhammo? ",
  "an10.141:1.7": "Sammādiṭṭhi . . . pe . . . sammāvimutti. ",
  "an10.141:1.8": "Ayaṃ vuccati bhikkhave atapanīyo dhammo ti. 1. ",
  "an10.141:1.9": "Ācayagāmiñ ca "
}
