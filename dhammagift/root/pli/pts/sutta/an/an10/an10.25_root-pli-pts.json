  "an10.25:1.1": "bhikkhave kasiṇāyatanāni. ",
  "an10.25:1.2": "Katamāni dasa? 2. ",
  "an10.25:1.3": "Paṭhavīkasiṇam eko sañjānāti uddhaṃ adho tiriyaṃ advayaṃ appamāṇaṃ, ",
  "an10.25:1.4": "āpokasiṇam eko sañjānāti . . . ",
  "an10.25:1.5": "tejokasiṇam eko sañjānāti . . . ",
  "an10.25:1.6": "vāyokasiṇam eko sañjānāti . . . ",
  "an10.25:1.7": "nīlakasiṇam eko sañjānāti . . . ",
  "an10.25:1.8": "pītakasiṇam eko sañjānāti . . . ",
  "an10.25:1.9": "lohitakasiṇam eko sañjānāti . . . ",
  "an10.25:1.10": "odātakasiṇam eko sañjānāti . . . ",
  "an10.25:1.11": "ākāsakasiṇam eko sañjānāti . . . ",
  "an10.25:1.12": "viññāṇakasiṇam eko sañjānāti uddhaṃ adho tiriyaṃ advayaṃ appamāṇaṃ. ",
  "an10.25:1.13": "Imāni kho bhikkhave dasa kasiṇāyatanānī ",
  "an10.25:1.14": "ti. 1. "
}
