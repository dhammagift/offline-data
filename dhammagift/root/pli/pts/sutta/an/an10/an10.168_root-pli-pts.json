  "an10.168:1.1": "Ariyaṃ vo bhikkhave paccorohaṇiṃ desissāmi, ",
  "an10.168:1.2": "taṃ suṇātha . . . pe . . . ",
  "an10.168:1.3": "",
  "an10.168:1.4": "Bhagavā etad avoca: ",
  "an10.168:2.1": "Katamā ca bhikkhave ariyā paccorohaṇī? 2. ",
  "an10.168:2.2": "Idha bhikkhave ariyasāvako iti paṭisañcikkhati ",
  "an10.168:2.3": "‘pāṇātipātassa kho pāpako vipāko ",
  "an10.168:2.4": "diṭṭhe c' eva dhamme abhisamparāyañ cā' ti. ",
  "an10.168:2.5": "So iti paṭisaṃkhāya pāṇātipātaṃ pajahati, ",
  "an10.168:2.6": "pāṇātipātā paccorohati . . . ",
  "an10.168:3.1": "",
  "an10.168:3.2": "",
  "an10.168:3.3": "",
  "an10.168:3.4": "",
  "an10.168:4.1": "pe . . . ",
  "an10.168:4.2": "",
  "an10.168:5.1": "",
  "an10.168:5.2": "",
  "an10.168:6.1": "",
  "an10.168:6.2": "",
  "an10.168:7.1": "",
  "an10.168:7.2": "",
  "an10.168:8.1": "",
  "an10.168:8.2": "",
  "an10.168:9.1": "",
  "an10.168:9.2": "",
  "an10.168:10.1": "",
  "an10.168:10.2": "",
  "an10.168:11.1": "‘Micchādiṭṭhiyā kho pāpako vipāko diṭṭhe c' eva dhamme abhisamparāyañ cā' ti. ",
  "an10.168:11.2": "So iti paṭisaṃkhāya micchādiṭṭhiṃ pajahati, ",
  "an10.168:11.3": "micchādiṭṭhiyā paccorohati. ",
  "an10.168:11.4": "Ayaṃ vuccati bhikkhave ariyā paccorohaṇī ",
  "an10.168:11.5": "ti. 1. "
}
