  "an10.13:1.1": "bhikkhave saṃyojanāni. ",
  "an10.13:1.2": "Katamāni dasa? 2. ",
  "an10.13:1.3": "Pañc' orambhāgiyāni saṃyojanāni pañc' uddhambhāgiyāni saṃyojanāni. ",
  "an10.13:1.4": "Katamāni pañc' orambhāgiyāni saṃyojanāni? 3. ",
  "an10.13:1.5": "Sakkāyadiṭṭhi vicikicchā sīlabbataparāmāso kāmacchando vyāpādo. ",
  "an10.13:1.6": "Imāni pañc' orambhāgiyāni saṃyojanāni. ",
  "an10.13:2.1": "Katamāni pañc' uddhambhāgiyāni saṃyojanāni? 4. ",
  "an10.13:2.2": "Rūparāgo arūparāgo māno uddhaccaṃ avijjā. ",
  "an10.13:2.3": "Imāni pañc' uddhambhāgiyāni saṃyojanāni. ",
  "an10.13:2.4": "Imāni kho bhikkhave dasa saṃyojanānī ",
  "an10.13:2.5": "ti. 1. "
}
