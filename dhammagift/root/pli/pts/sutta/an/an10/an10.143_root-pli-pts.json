  "an10.143:1.1": "vo bhikkhave dhammaṃ desissāmi sukhudrayañ ca, ",
  "an10.143:1.2": "taṃ suṇātha . . . pe . . . 2. ",
  "an10.143:1.3": "Katamo ca bhikkhave dukkhudrayo dhammo? ",
  "an10.143:1.4": "Micchādiṭṭhi . . . pe . . . micchāvimutti. ",
  "an10.143:1.5": "Ayaṃ vuccati bhikkhave dukkhudrayo dhammo. 3. ",
  "an10.143:1.6": "Katamo ca bhikkhave sukhudrayo dhammo? ",
  "an10.143:1.7": "Sammādiṭṭhi . . . pe . . . sammāvimutti. ",
  "an10.143:1.8": "Ayaṃ vuccati bhikkhave sukhudrayo dhammo ti. 1. ",
  "an10.143:1.9": "Dukkhavipākañ ca "
}
