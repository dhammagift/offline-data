  "an10.156-166:1.1": "Dasahi bhikkhave dhammehi samannāgato puggalo na bhajitabbo . . . pe . . . ",
  "an10.156-166:1.2": "bhajitabbo . . . pe . . . ",
  "an10.156-166:1.3": "na payirupāsitabbo . . . ",
  "an10.156-166:1.4": "payirupāsitabbo . . . pe . . . ",
  "an10.156-166:1.5": "na pujjo hoti . . . pe . . . ",
  "an10.156-166:1.6": "pujjo hoti . . . ",
  "an10.156-166:1.7": "na pāsaṃso hoti . . . pe . . . ",
  "an10.156-166:1.8": "pāsaṃso hoti . . . ",
  "an10.156-166:1.9": "agāravo hoti . . . ",
  "an10.156-166:1.10": "sagāravo hoti . . . pe . . . ",
  "an10.156-166:1.11": "appatikkho ",
  "an10.156-166:1.12": "hoti . . . pe . . . sappatikkho hoti . . . ",
  "an10.156-166:1.13": "na ārādhako hoti . . . pe . . . ",
  "an10.156-166:1.14": "ārādhako hoti . . . ",
  "an10.156-166:1.15": "na visujjhati . . . pe . . . ",
  "an10.156-166:1.16": "visujjhati . . . ",
  "an10.156-166:1.17": "mānaṃ nādhibhoti . . . pe . . . ",
  "an10.156-166:1.18": "mānaṃ adhibhoti . . .1 ",
  "an10.156-166:1.19": "paññāya na vaḍḍhati . . .pe . . . ",
  "an10.156-166:1.20": "paññāya vaḍḍhati . . .1 ",
  "an10.156-166:2.1": "bahuṃ apuññaṃ pasavati . . . ",
  "an10.156-166:2.2": "bahuṃ puññaṃ pasa- vati. ",
  "an10.156-166:2.3": "Katamehi dasahi? 2. ",
  "an10.156-166:2.4": "Sammādiṭṭhiko hoti, sammāsaṅkappo hoti, sammāvāco hoti, sammākammanto hoti, sammā-ājīvo hoti, sammāvāyāmo hoti, sammāsati hoti, sammāsamādhi hoti, sammāñāṇī hoti, sammāvimutti hoti. ",
  "an10.156-166:2.5": "Imehi kho bhikkhave dasahi dhammehi samannāgato puggalo bahuṃ puññaṃ pasavatī ti. 1. ",
  "an10.156-166:2.6": ""
}
