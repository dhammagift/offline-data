  "an10.79:1.1": "bhikkhave āghātavatthūni. ",
  "an10.79:1.2": "Katamāni dasa? 2. ",
  "an10.79:1.3": "‘Anatthaṃ me acarī' ti āghātaṃ bandhati, ",
  "an10.79:1.4": "‘anatthaṃ me caratī' ti āghātaṃ bandhati, ",
  "an10.79:1.5": "‘anatthaṃ me carissatī' ti āghātaṃ bandhati, ",
  "an10.79:1.6": "‘piyassa me manāpassa anatthaṃ acari . . . ",
  "an10.79:1.7": "anatthaṃ carati . . . ",
  "an10.79:1.8": "anatthaṃ carissatī' ti āghātaṃ bandhati, ",
  "an10.79:1.9": "‘appiyassa me amanāpassa atthaṃ acari . . . ",
  "an10.79:1.10": "atthaṃ carati . . . ",
  "an10.79:1.11": "atthaṃ carissatī' ti āghātaṃ bandhati, ",
  "an10.79:1.12": "aṭṭhāne ca kuppati. ",
  "an10.79:1.13": "Imāni kho bhikkhave dasa āghātavatthūnī ti. 1. ",
  "an10.79:1.14": "Dasa yime "
}
