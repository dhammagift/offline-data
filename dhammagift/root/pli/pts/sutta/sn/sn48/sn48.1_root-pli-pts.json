  "sn48.1:1.1": "",
  "sn48.1:1.2": "Tatra kho Bhagavā etad avoca || || 3. ",
  "sn48.1:1.3": "Pañcimāni bhikkhave indriyāni || ",
  "sn48.1:1.4": "katamāni pañca || || ",
  "sn48.1:1.5": "Saddhindriyaṃ viriyindriyaṃ satindriyaṃ samādhindriyaṃ paññindriyam || || ",
  "sn48.1:1.6": "Imāni kho bhikkhave pañcindriyānī ",
  "sn48.1:1.7": "ti || || 3. "
}
