  "sn48.20:0.3": "",
  "sn48.20:1.1": "Pañcimāni bhikkhave indriyāni || ",
  "sn48.20:1.2": "katamāni pañca || || ",
  "sn48.20:1.3": "Saddhindriyaṃ || la-pe || paññindriyām || || ",
  "sn48.20:1.4": "Imāni kho bhikkhave pañcindriyāni || || 3. ",
  "sn48.20:1.5": "Imesaṃ kho bhikkhave pañcannam indriyānam bhavitattā bahulīkatattā bhikkhu āsavānaṃ khayā anāsavaṃ cetovimuttim paññāvimuttiṃ diṭṭheva dhamme sayam abhiññā sacchikatvā upasampajja viharatī ti || || ",
  "sn48.20:1.6": "",
  "sn48.20:1.7": "",
  "sn48.20:2.0": "",
  "sn48.20:2.1": "Paṭilābho ca tayo Saṅkhittā || || ",
  "sn48.20:2.2": "Vitthārā apare tayo || ",
  "sn48.20:2.3": "Paṭipanno cupasamo || Āsavānaṃ khayo ",
  "sn48.20:2.4": "cime ti || || 2. "
}
