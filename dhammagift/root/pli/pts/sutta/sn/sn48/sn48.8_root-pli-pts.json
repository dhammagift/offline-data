  "sn48.8:0.1": "",
  "sn48.8:0.2": "",
  "sn48.8:0.3": "",
  "sn48.8:1.1": "Pañcimāni bhikkhave indriyāni || ",
  "sn48.8:1.2": "katamāni pañca || || ",
  "sn48.8:1.3": "Saddhindriyaṃ || la-pe || paññindriyam || || 3. ",
  "sn48.8:1.4": "Kattha ca bhikkhave saddhindriyaṃ daṭṭhabbaṃ || || ",
  "sn48.8:1.5": "Catusu sotāpattiyaṅgesu || ",
  "sn48.8:1.6": "ettha saddhindriyaṃ daṭṭhabbaṃ || || 4. ",
  "sn48.8:1.7": "Kattha ca bhikkhave viriyindriyaṃ daṭṭhabbaṃ || || ",
  "sn48.8:1.8": "Catusu sammapadhānesu || ",
  "sn48.8:1.9": "ettha viriyindriyaṃ daṭṭhabbaṃ || || 5. ",
  "sn48.8:1.10": "Kattha ca bhikkhave satindriyaṃ daṭṭhabbaṃ || || ",
  "sn48.8:1.11": "Catusu satipaṭṭhānesu || ",
  "sn48.8:1.12": "ettha satindriyaṃ daṭṭhabbaṃ || || 6. ",
  "sn48.8:1.13": "Kattha ca bhikkhave samādhindriyaṃ daṭṭhabbaṃ || || ",
  "sn48.8:1.14": "Catusu jhānesu || ",
  "sn48.8:1.15": "ettha samādhindriyaṃ daṭṭhabbam || || 7. ",
  "sn48.8:1.16": "Kattha ca bhikkhave paññindriyaṃ daṭṭhabbaṃ || || ",
  "sn48.8:1.17": "Catusu ariyasaccesu || ",
  "sn48.8:1.18": "ettha paññindriyaṃ daṭṭhabbaṃ || || 8. ",
  "sn48.8:1.19": "Imāni kho bhikkhave pañcindriyānī ",
  "sn48.8:1.20": "ti || || 2. "
}
