  "sn48.35:1.1": "Pañcimāni bhikkhave indriyāni- ",
  "sn48.35:1.2": "-upekhindriyaṃ || || 3. ",
  "sn48.35:1.3": "",
  "sn48.35:1.4": "ye hi keci bhikkhave samaṇā vā brāhmaṇā vā sukhindriyaṃ nappajānanti sukhindriyasamudayaṃ nappajānanti || sukhindriyanirodham nappajānanti || sukhindriyanirodhagāminipaṭipadaṃ ",
  "sn48.35:1.5": "nappajānanti || [pe] || ",
  "sn48.35:1.6": "upekhindriyaṃ nappajānanti || upekhindriyasamudayaṃ ",
  "sn48.35:1.7": "nappajānanti || upekhindriyanirodhagāminipatipadaṃ ",
  "sn48.35:1.8": "nappajānanti || ",
  "sn48.35:1.9": "na me te- viharanti || || 4. ",
  "sn48.35:2.1": "Ye ca keci || -pajānananti- ",
  "sn48.35:2.2": "",
  "sn48.35:2.3": "",
  "sn48.35:2.4": "",
  "sn48.35:2.5": "",
  "sn48.35:2.6": "te ca kho- -sayam abhiññā sacchikatvā upasampajja viharantī ",
  "sn48.35:2.7": "ti || || 2. "
}
