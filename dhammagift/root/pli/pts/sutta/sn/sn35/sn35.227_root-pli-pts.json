  "sn35.227:0.3": "",
  "sn35.227:1.1": "Rūpā bhikkhave anattā || || Saddā || || Gandhā || || Rasā || || Phoṭṭhabbā || || Dhammā aniccā || || 9 ",
  "sn35.227:1.2": "Evam passam || pa || ",
  "sn35.227:1.3": "nāparam itthattāyāti pajānātīti || || ",
  "sn35.227:1.4": "Saṭṭhi-peyyālaṃ samattaṃ || || ",
  "sn35.227:2.0": "",
  "sn35.227:2.1": "Chandenaṭṭhārasā honti || ",
  "sn35.227:2.2": "Atītena ca dve nava || ",
  "sn35.227:2.3": "Yadaniccāṭṭhārasā vuttā || ",
  "sn35.227:2.4": "Tayo ajjhatta-bāhirā || ",
  "sn35.227:2.5": "Peyyālo saṭṭhiko vutto || ",
  "sn35.227:2.6": "Buddhenādiccabandhunā ti || || ",
  "sn35.227:2.7": "Suttantāni saṭṭhi || || 2 "
}
