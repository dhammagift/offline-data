  "sn35.145:1.1": "Rūpā bhikkhave anattā || ",
  "sn35.145:1.2": "yo pi hetu yo pi paccayo rupānam uppādāya so pi anattā || ",
  "sn35.145:1.3": "anattasambhūtā bhikkhave rūpā kuto attā bhavissanti || || 4-7 ",
  "sn35.145:1.4": "Saddā || || ",
  "sn35.145:1.5": "Gandhā || || ",
  "sn35.145:1.6": "Rasā || || ",
  "sn35.145:1.7": "Phoṭṭhabbā || || 8 ",
  "sn35.145:1.8": "Dhammā anattā || ",
  "sn35.145:1.9": "yo pi hetu yo pi paccayo dhammānam uppādāya so pi anattā || ",
  "sn35.145:1.10": "anattasambhūtā bhikkhave dhammā kuto attā bhavissanti || || 9 ",
  "sn35.145:1.11": "Evam passam || pe || ",
  "sn35.145:1.12": "",
  "sn35.145:1.13": "nāparam itthattāyāti pajānātīti || || ",
  "sn35.145:1.14": "Devadahakhaṇo Saṅgayha || ",
  "sn35.145:1.15": "",
  "sn35.145:2.0": "",
  "sn35.145:2.1": "Agayha ",
  "sn35.145:2.2": "dve honti Palāsinā || ",
  "sn35.145:2.3": "Hetunā pi tayo vuttā || || ",
  "sn35.145:2.4": "Duve ajjhatta-bāhirāti || || 2 "
}
