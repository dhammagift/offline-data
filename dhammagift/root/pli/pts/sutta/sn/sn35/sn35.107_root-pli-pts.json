  "sn35.107:0.2": "",
  "sn35.107:0.3": "",
  "sn35.107:1.1": "Lokassa bhikkhave samudayañca atthagamañ ca desissāmi || ",
  "sn35.107:1.2": "taṃ suṇātha || || 3 ",
  "sn35.107:1.3": "Katamo ca bhikkhave lokassa samudayo || || 4 ",
  "sn35.107:1.4": "Cakkhuñca paṭicca rūpe ca uppajjati cakkhuviññāṇaṃ || tiṇṇam saṅgati phasso || ",
  "sn35.107:1.5": "phassapaccayā vedanā || ",
  "sn35.107:1.6": "vedanāpaccayā taṇhā || ",
  "sn35.107:1.7": "taṇhāpaccayā upādānaṃ || ",
  "sn35.107:1.8": "upādānapaccayā bhavo || ",
  "sn35.107:1.9": "bhavapaccayā jāti || ",
  "sn35.107:1.10": "jātipaccayā jarāmaraṇaṃ sokaparidevadukkhadomanassupāyāsā sambhavanti || ",
  "sn35.107:1.11": "ayam lokassa samudayo || 4-7 Sotañ ",
  "sn35.107:1.12": "ca paṭicca || || Ghānañ ca paṭicca || || Jivhañ ca paṭicca || || Kāyañ ca paṭicca || || 8 ",
  "sn35.107:1.13": "Manañ ca paṭicca dhamme ca uppajjati manoviññāṇaṃ || tiṇṇaṃ saṅgatiphasso || ",
  "sn35.107:1.14": "phassapaccayā vedanā || ",
  "sn35.107:1.15": "vedanāpaccayā taṇhā || ",
  "sn35.107:1.16": "tanhāpaccayā upādānaṃ || ",
  "sn35.107:1.17": "upādānapaccayā bhavo || ",
  "sn35.107:1.18": "bhavapaccayājāti || ",
  "sn35.107:1.19": "jātipaccayā jarāmaraṇaṃ sokaparidevadukkhadomanassupāyāsā sambhavanti || ",
  "sn35.107:1.20": "ayaṃ kho bhikkhave lokassa samudayo || || 9 ",
  "sn35.107:2.1": "Katamo ca bhikkhave lokassa atthagamo || || 10-15 ",
  "sn35.107:2.2": "Cakkhuñca paṭicca rūpe ca upajjati cakkhuviññānaṃ || tiṇṇaṃ saṅgatiphasso || ",
  "sn35.107:2.3": "phassapaccayā vedanā || ",
  "sn35.107:2.4": "vedanāpaccayā taṇhā || ",
  "sn35.107:2.5": "tassāyeva taṇhāya asesavirāganirodhā upādānanirodho || ",
  "sn35.107:2.6": "",
  "sn35.107:2.7": "",
  "sn35.107:2.8": "pe || || ",
  "sn35.107:2.9": "Evam etassa kevalassa dukkhakkhandhassa nirodho hoti || || 16 ",
  "sn35.107:2.10": "Ayaṃ kho bhikkhave lokassa atthagamoti || || 2 ",
