  "sn35.137:0.3": "",
  "sn35.137:1.1": "Rūpārāmā bhikkhave devamanussā rūparatā rūpasamuditā || ",
  "sn35.137:1.2": "rūpaviparināmavirāganirodhā dukkhā bhikkhave devamanussā viharanti || || ",
  "sn35.137:1.3": "Saddārāmā || || ",
  "sn35.137:1.4": "Gandhārāmā || || ",
  "sn35.137:1.5": "Rasārāmā || || ",
  "sn35.137:1.6": "Phoṭṭhabbārāmā || || ",
  "sn35.137:1.7": "Dhammārāmā bhikkhave devamanussā dhammaratā dhammasamuditā || ",
  "sn35.137:1.8": "dhammapariṇāmavirāganirodhā dukkhā bhikkhave devamanussā viharanti || || 6 ",
  "sn35.137:1.9": "Tathāgato ca bhikkhave arahaṃ sammāsambuddho rūpānaṃ samudayañca atthagamañca assādañca ādinavañca nissaraṇañca yathābhūtaṃ viditvā na rūpārāmo na rūparato na rūpasamudito || ",
  "sn35.137:1.10": "rūpavipariṇāmavirāganirodhā sukho bhikkhave tathāgato viharati || || ",
  "sn35.137:1.11": "Saddānaṃ || || ",
  "sn35.137:1.12": "Gandhānam || || ",
  "sn35.137:1.13": "Rasānaṃ || || ",
  "sn35.137:1.14": "Phoṭṭhabbānaṃ || || ",
  "sn35.137:1.15": "Dhammānaṃ samudayañca atthagamañca assādañca ādīnavañca nissaraṇañca yathābhūtaṃ viditvā na dhammārāmo na dhammarato na dhammasamudito || ",
  "sn35.137:1.16": "dhammavipariṇāmavirāganirodhā sukho bhikkhave Tathāgato viharatīti || || 2 ",
  "sn35.137:1.17": ""
}
