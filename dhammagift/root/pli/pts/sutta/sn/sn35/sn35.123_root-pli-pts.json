  "sn35.123:1.1": "Upādāniye ca bhikkhave dhamme desissāmi upādānañ ca || ",
  "sn35.123:1.2": "tam suṇātha || || 2 ",
  "sn35.123:1.3": "Katame ca bhikkhave upādāniyā dhammā katamam upādānaṃ || || 3-8 ",
  "sn35.123:1.4": "Santi bhikkhave- ",
  "sn35.123:1.5": "-ime vuccanti bhikkhave upādāniyā dhammā || || ",
  "sn35.123:1.6": "Yo tattha chandarāgo taṃ tattha ",
  "sn35.123:1.7": "",
  "sn35.123:1.8": "",
  "sn35.123:1.9": "",
  "sn35.123:1.10": "upādānan ti || || ",
  "sn35.123:1.11": "",
  "sn35.123:1.12": "",
  "sn35.123:2.0": "",
  "sn35.123:2.1": "Mārapāsena dve vuttā || || ",
  "sn35.123:2.2": "Lokakāmaguṇena ca || || ",
  "sn35.123:2.3": "Sakko Pañcasikho ceva || ",
  "sn35.123:2.4": "Sāriputto ca Rāhulo || ",
  "sn35.123:2.5": "Saṃyojanaṃ Upādānaṃ || || 1 ",
  "sn35.123:2.6": ""
}
