  "sn35.100:1.1": "bhikkhave yogam āpajjatha || ",
  "sn35.100:1.2": "patisallīṇo bhikkhave bhikkhu yathābhūtam pajānāti || || 3 ",
  "sn35.100:1.3": "Kiñca yathābhūtam pajānāti || || 4-9 ",
  "sn35.100:1.4": "Cakkhum aniccanti yathābhūtam pajānāti || || ",
  "sn35.100:1.5": "Rūpā aniccāti yathābhūtam pajānāti || || ",
  "sn35.100:1.6": "Cakkhuviññāṇam aniccanti yathābhūtam pajānāti || || ",
  "sn35.100:1.7": "Cakkhusamphasso anicco ti yathābhūtam pajānāti || || ",
  "sn35.100:1.8": "Yam pidam manosamphassapaccayā uppajjati vedayitaṃ sukhaṃ vā dukkhaṃ vā adukkham asukhaṃ vā || tam pi aniccan ti yathābhūtam pajānāti || || 10 ",
  "sn35.100:1.9": "Paṭisallāṇam bhikkhave yogam āpajjatha || ",
  "sn35.100:1.10": "paṭisallāno bhikkhave bhikkhu yathābhūtam pajānātīti || || 2 ",
  "sn35.100:1.11": ""
}
