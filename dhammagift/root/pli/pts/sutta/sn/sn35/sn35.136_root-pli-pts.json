  "sn35.136:0.3": "",
  "sn35.136:1.1": "Rūpārāmā bhikkhave devamanussā rūpasamuditā || ",
  "sn35.136:1.2": "rūpavipariṇāmavirāganirodhā dukkhaṃ bhikkhave devamanussā viharanti || || ",
  "sn35.136:1.3": "Saddārāmā || || ",
  "sn35.136:1.4": "",
  "sn35.136:1.5": "Gandhārāmā || || ",
  "sn35.136:1.6": "Rasārāmā || || ",
  "sn35.136:1.7": "Phoṭṭhabbārāmā || ",
  "sn35.136:1.8": "Dhammārāmā bhikkhave devamanussā dhammaratā dhammasamuditā || ",
  "sn35.136:1.9": "dhammavipariṇāmavirāganirodhā dukkhaṃ bhikkhave devamanussā viharanti || || 3 ",
  "sn35.136:1.10": "Tathāgato ca kho bhikkhave arahaṃ sammāsambuddho rūpānaṃ samudayañca atthagamañca assādañca ādīnavañca nissaraṇañca yathābhūtaṃ viditvā na rūpārāmo na rūparato na rūpasamudito || ",
  "sn35.136:1.11": "rūpavipariṇāmavirāganirodhā sukhaṃ bhikkhave Tathāgato viharati || || ",
  "sn35.136:1.12": "Saddānaṃ || || ",
  "sn35.136:1.13": "Gandhānaṃ || || ",
  "sn35.136:1.14": "Rasānaṃ || || ",
  "sn35.136:1.15": "Phoṭṭhabbānaṃ || || ",
  "sn35.136:1.16": "Dhammānaṃ samudayañca atthagamañca assādañca ādīnavañca nissaraṇañca yathābhūtaṃ viditvā na dhammārāmo na dhammarato na dhammasamudito ",
  "sn35.136:1.17": "dhammavipariṇāmavirāganirodhā sukhobhikkhave tathāgato viharatīti || || 4 ",
  "sn35.136:1.18": "Idam avoca Bhagavā || ",
  "sn35.136:1.19": "idaṃ vatvā Sugato athāparam pi etad avoca satthā || || ",
  "sn35.136:2.1": "Rūpā saddā gandhā rasā || ",
  "sn35.136:2.2": "phassā dhammā ca kevalā || || ",
  "sn35.136:2.3": "iṭṭhā kantā manāpā ca || ",
  "sn35.136:2.4": "yāvatatthīti vuccati || || ",
  "sn35.136:3.1": "Sadevakassa lokassa || ",
  "sn35.136:3.2": "ete vo sukhasammatā || ",
  "sn35.136:3.3": "Yattha cete nirujjhanti || ",
  "sn35.136:3.4": "taṃ tesaṃ dukkhasammataṃ || || ",
  "sn35.136:4.1": "Sukhaṃ diṭṭham ariyehi || ",
  "sn35.136:4.2": "sakkā yassa nirodhanaṃ || ",
  "sn35.136:4.3": "paccanīkam idaṃ hoti || ",
  "sn35.136:4.4": "sabbalokena dassanam || || ",
  "sn35.136:5.1": "Yam pare sukhato āhu || ",
  "sn35.136:5.2": "tad ariyā āhu dukkhato || ",
  "sn35.136:5.3": "yam pare dukkhato āhu || ",
  "sn35.136:5.4": "tad ariyā sukhato vidū || || ",
  "sn35.136:6.1": "Phassadhammaṃ durājānaṃ || ",
  "sn35.136:6.2": "sammuḷhettha aviddasu || ",
  "sn35.136:6.3": "nivutānaṃ tamo hoti || ",
  "sn35.136:6.4": "andhakāro apassataṃ || || ",
  "sn35.136:7.1": "Satañca vivaṭaṃ hoti || ",
  "sn35.136:7.2": "āloko passatam idha || ",
  "sn35.136:7.3": "santikena vijānanti || ",
  "sn35.136:7.4": "mahādhammassa kovidā || || Bhavarāgaparetehi || ",
  "sn35.136:8.1": "bhavasotānusāribhi || ",
  "sn35.136:8.2": "",
  "sn35.136:8.3": "Māradheyyānupannehi || ",
  "sn35.136:8.4": "nāyam dhammo susambud dho || || ",
  "sn35.136:9.1": "Ko nu aññatra-m-ariyehi || ",
  "sn35.136:9.2": "padaṃ sambuddham arahati || ",
  "sn35.136:9.3": "Yam padaṃ sammadaññāya || ",
  "sn35.136:9.4": "parinibbanti anāsavāti ||8 || 5 ",
  "sn35.136:9.5": ""
}
