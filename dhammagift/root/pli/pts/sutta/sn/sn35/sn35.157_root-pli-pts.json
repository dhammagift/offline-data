  "sn35.157:1.1": "bhikkhave bhikkhu rūpe Aniccā ti passati || sāyaṃ hoti sammādiṭṭhi || ",
  "sn35.157:1.2": "sammāpassaṃ nibbindati || ",
  "sn35.157:1.3": "nandikkhayā rāgakkhayo ",
  "sn35.157:1.4": "rāgakkhayā nandikkhayo || || ",
  "sn35.157:1.5": "Nandirāgakkhayā cittaṃ suvimuttanti vuccati || || 4-8 ",
  "sn35.157:1.6": "Anicce yeva bhikkhave sadde || ",
  "sn35.157:1.7": "gandhe || ",
  "sn35.157:1.8": "rase || ",
  "sn35.157:1.9": "phoṭṭhabbe || ",
  "sn35.157:1.10": "dhamme Aniccā ti passati || sāyaṃ hoti sammādiṭṭhi || ",
  "sn35.157:1.11": "sammāpassaṃ nibbindati ",
  "sn35.157:1.12": "nandikkhayā rāgakkhayo ",
  "sn35.157:1.13": "rāgakkhayā nandikkhayo || || ",
  "sn35.157:1.14": "Nandirāgakkhayā cittaṃ suvimuttanti vuccatīti || || 3 ",
