  "sn35.33:1.1": "",
  "sn35.33:1.2": "Tatra kho || || 2 ",
  "sn35.33:1.3": "Sabbam bhikkhave jātidhammaṃ || ",
  "sn35.33:1.4": "kiñca bhikkhave sabbaṃ jātidhammaṃ || || 3-5 ",
  "sn35.33:1.5": "Cakkhum bhikkhave jātidhammaṃ || || ",
  "sn35.33:1.6": "Rūpā jātidhammā || || ",
  "sn35.33:1.7": "Cakkhuviññāṇam jātidhammaṃ || || ",
  "sn35.33:1.8": "Cakkhusamphasso jātidhammo || || ",
  "sn35.33:1.9": "Yam pidaṃ cakkhusamphassapaccayā uppajjati vedayitaṃ sukhaṃ vā dukkhaṃ vā adukkham asukhaṃ vā || tam pi jātidhammam ||pe|| || 6 ",
  "sn35.33:1.10": "Jivhā || || ",
  "sn35.33:1.11": "Rasā || || ",
  "sn35.33:1.12": "Jivhāviññāṇaṃ || || ",
  "sn35.33:1.13": "Jivhāsamphasso || || ",
  "sn35.33:1.14": "Yaṃ pidaṃ jivhāsamphassapaccayā uppajjati vedayitaṃ sukhaṃ vā dukkhaṃ vā adukkham asukhaṃ vā || tam pi jātidhammaṃ || || pe || || 7 ",
  "sn35.33:1.15": "Kāyo ||pe|| || 8 ",
  "sn35.33:1.16": "Mano jātidhammo || || Dhammā jātidhammā || || Manoviññāṇaṃ jātidhammaṃ || || Manosamphasso jātidhammo || || ",
  "sn35.33:1.17": "Yam pidam manosamphassapaccayā uppajjati vedayitaṃ sukhaṃ vā dukkhaṃ va adukkham asukhaṃ vā || tam pi jātidhammaṃ || || 9 ",
  "sn35.33:1.18": "Evam passam bhikkhave sutavā ariyasāvako cakkhusmim pi nibbindati || pe || ",
  "sn35.33:1.19": "nāparam itthattāyati pajānātī ",
  "sn35.33:1.20": "ti || || ",
  "sn35.34:1.1": "Sabbam bhikkhave jarādhammaṃ || || ",
  "sn35.34:1.2": "",
  "sn35.34:1.3": "",
  "sn35.35:1.1": "Sabbam bhikkhave vyādhidhammaṃ || || ",
  "sn35.35:1.2": "",
  "sn35.35:1.3": "",
  "sn35.36:1.1": "Sabbam bhikkhave maraṇadhammaṃ || || ",
  "sn35.36:1.2": "",
  "sn35.36:1.3": "",
  "sn35.37:1.1": "Sabbam bhikkhave sokadhammaṃ || || ",
  "sn35.37:1.2": "",
  "sn35.37:1.3": "",
  "sn35.38:1.1": "Sabbam bhikkhave saṃkilesadhammaṃ || || ",
  "sn35.38:1.2": "",
  "sn35.38:1.3": "",
  "sn35.39:1.1": "Sabbam bhikkhave khayadhammaṃ || || ",
  "sn35.39:1.2": "",
  "sn35.39:1.3": "",
  "sn35.40:1.1": "Sabbam bhikkhave vayadhammaṃ || || ",
  "sn35.40:1.2": "",
  "sn35.40:1.3": "",
  "sn35.41:1.1": "Sabbam bhikkhave samudayadhammaṃ || || ",
  "sn35.41:1.2": "",
  "sn35.41:1.3": "",
  "sn35.42:1.1": "Sabbam bhikkhave nirodhadhammaṃ || || ",
  "sn35.42:1.2": "",
  "sn35.42:1.3": "",
  "sn35.42:1.4": "Jātidhammavaggo catuttho || || Jāti Jarā ",
  "sn35.42:2.0": "",
  "sn35.42:2.1": "Vyādhi Maraṇaṃ || ",
  "sn35.42:2.2": "Soko ca Saṅkileso ca || ",
  "sn35.42:2.3": "Khaya -- Vaya -- Samudayam || ",
  "sn35.42:2.4": "Nirodhadhammena te dasā ti || || Sāvatthi || "
}
