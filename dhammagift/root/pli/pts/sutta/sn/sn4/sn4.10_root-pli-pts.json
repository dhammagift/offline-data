  "sn4.10:0.3": "",
  "sn4.10:1.1": "",
  "sn4.10:1.2": "Rājagahe || || ",
  "sn4.10:1.3": "Tatra kho Bhagavā etad avoca || ",
  "sn4.10:2.1": "appam idaṃ bhikkhave manussānam āyu || ",
  "sn4.10:2.2": "gamanīyo samparāyo || || kattabbaṃ kusalaṃ caritabbaṃ brahmacariyaṃ || ",
  "sn4.10:2.3": "natthi jātassa amaraṇam || ",
  "sn4.10:2.4": "yo bhikkhave ciraṃ jīvati so vassasatam appaṃ vā bhīyo ti || || 2. ",
  "sn4.10:3.1": "Atha kho Māro pāpimā yena Bhagavā ten-upasaṅkami || upasaṅkamitvā Bhagavantaṃ gāthāya ajjhabhāsi || || ",
  "sn4.10:4.1": "Nāccayanti ahorattā || ",
  "sn4.10:4.2": "jīvitaṃ n-uparujjhati || ",
  "sn4.10:4.3": "āyu anupariyāti maccānaṃ || ",
  "sn4.10:4.4": "nemi va ratha-kubbaran ti || 3. ",
  "sn4.10:5.1": "Accayanti ahorattā || ",
  "sn4.10:5.2": "jīvitam uparujjhati || ",
  "sn4.10:5.3": "āyu khīyati maccānam || ",
  "sn4.10:5.4": "kunnadīnam va odakan ti || || 4. ",
  "sn4.10:6.1": "Atha kho Māro pāpimā jānāti maṃ Bhagavā jānāti maṃ Sugato ti dukkhī dummano tath- ",
  "sn4.10:6.2": "ev-antaradhāyī ti || || ",
  "sn4.10:7.0": "",
  "sn4.10:7.1": "Tapo-kammañ ca Nāgo ca || ",
  "sn4.10:7.2": "Subhaṃ Pāsena te duve || ",
  "sn4.10:7.3": "Sappo Suppati Nandanaṃ || ",
  "sn4.10:7.4": "Āyunā apare duve ti || || ___________________________________________ 1. "
}
