  "sn47.42:0.3": "",
  "sn47.42:1.1": "Catunnam bhikkhave satipaṭṭhānānam samudayañca atthagamañca desissāmi || ",
  "sn47.42:1.2": "taṃ suṇātha || || 3. ",
  "sn47.42:1.3": "Ko ca bhikkhave kāyassa samudayo || || ",
  "sn47.42:1.4": "Āhārasamudayā kāyassa samudayo || ",
  "sn47.42:1.5": "āhāranirodhā kāyassa atthagamo || || 4. ",
  "sn47.42:1.6": "Phassasamudayā vedanānaṃ samudayo || ",
  "sn47.42:1.7": "phassanirodhā vedanānam atthagamo || || 5. ",
  "sn47.42:1.8": "Nāmarūpasamudayā cittassa samudayo || ",
  "sn47.42:1.9": "nāmarūpanirodhā cittassa atthagamo || || 6. ",
  "sn47.42:1.10": "Manasikārasamudayā dhammānam samudayo || ",
  "sn47.42:1.11": "manasikāranirodhā dhammānam atthagamo ti || || 1. ",
  "sn47.42:1.12": "Sāvatthi || || 2. "
}
