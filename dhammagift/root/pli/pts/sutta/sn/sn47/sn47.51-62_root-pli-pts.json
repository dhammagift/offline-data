  "sn47.51-62:0.1": "",
  "sn47.51-62:0.2": "",
  "sn47.51-62:0.3": "",
  "sn47.51-62:1.1": "Seyyathāpi bhikkhave Gaṅgā nadī pācīnaninnā- ",
  "sn47.51-62:1.2": "-evam eva kho bhikkhave bhikkhu cattaro satipaṭṭhāne bhāvento-nibbānapubbhāro || || 3. ",
  "sn47.51-62:2.1": "Kathañca bhikkhave bhikkhu- -nibbānapabbhāro || || 4. ",
  "sn47.51-62:2.2": "Idha bhikkhave bhikkhu kāye kāyānupassī- -abhijjhādomanassam || ",
  "sn47.51-62:2.3": "vedanāsu || ",
  "sn47.51-62:2.4": "citte || ",
  "sn47.51-62:2.5": "dhammesu- || || ",
  "sn47.51-62:2.6": "Evam eva kho bhikkhave bhikkhu- -nibbānapabbhāro ti || || ",
  "sn47.51-62:2.7": "",
  "sn47.51-62:3.0": "",
  "sn47.51-62:3.1": "Cha pācīnato ninnā || ",
  "sn47.51-62:3.2": "cha ninnā ca samuddato || ",
  "sn47.51-62:3.3": "Ete dve cha dvādasa honti || ",
  "sn47.51-62:3.4": "vaggo tena pavuccati || || Gaṅgapeyyāla satipaṭṭhānavasena "
}
