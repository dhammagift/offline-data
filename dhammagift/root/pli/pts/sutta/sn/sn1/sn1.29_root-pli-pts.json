{
  "sn1.29:0.1": "",
  "sn1.29:0.2": "",
  "sn1.29:0.3": "",
  "sn1.29:1.1": "Catucakkam navadvāraṃ || ",
  "sn1.29:1.2": "puṇṇam lobhena saṃyutaṃ || ",
  "sn1.29:1.3": "paṅkajātaṃ mahāvīra || ",
  "sn1.29:1.4": "kathaṃ yātrā bhavissatīti || || ",
  "sn1.29:2.1": "Chetvā nandiṃ varattañca || ",
  "sn1.29:2.2": "icchālobhañca pāpakaṃ || ",
  "sn1.29:2.3": "samūlaṃ taṇham abbuyha || ",
  "sn1.29:2.4": "evaṃ yātrā bhavissatīti || || "
}
