  "sn1.30:0.1": "",
  "sn1.30:0.2": "",
  "sn1.30:0.3": "",
  "sn1.30:1.1": "Enijaṅghaṃ kisaṃ vīraṃ || ",
  "sn1.30:1.2": "appāhāram alolupaṃ || ",
  "sn1.30:1.3": "sīhaṃ v-ekacaraṃ nāgam ",
  "sn1.30:1.4": "||kāmesu anapekkhinaṃ || ",
  "sn1.30:1.5": "upasaṅkamma pucchāma || ",
  "sn1.30:1.6": "kathaṃ dukkhā pamuccatīti || || ",
  "sn1.30:2.1": "Pañcakāmaguṇā loke || ",
  "sn1.30:2.2": "mano chaṭṭhā paveditā || ",
  "sn1.30:2.3": "ettha chandaṃ virājetvā || ",
  "sn1.30:2.4": "evaṃ dukkhā pamuccatīti || || ",
  "sn1.30:2.5": "",
  "sn1.30:3.0": "",
  "sn1.30:3.1": "Sattiyā Phusati c-eva || ",
  "sn1.30:3.2": "Jaṭā Manonivāraṇā || ",
  "sn1.30:3.3": "Arahantena Pajjoto || ",
  "sn1.30:3.4": "Sarā Mahaddhanena ca || ",
  "sn1.30:3.5": "Catucakkena navamaṃ || ",
  "sn1.30:3.6": "Enijaṅghena te dasāti || || ___________________________________________ 1. "
}
