  "sn1.55:1.1": "Kiṃsu janeti purisaṃ || ",
  "sn1.55:1.2": "kiṃsu tassa vidhāvati || ",
  "sn1.55:1.3": "kiṃsu saṃsāram āpādi || ",
  "sn1.55:1.4": "kiṃsu tassa mahabbhayan ti || || ",
  "sn1.55:2.1": "Taṇhā janeti purisaṃ || ",
  "sn1.55:2.2": "cittam assa vidhāvati || ",
  "sn1.55:2.3": "satto saṃsāram āpādi || ",
  "sn1.55:2.4": "dukkham assa mahabbhayan ti || || "
}
