  "sn1.50:0.2": "",
  "sn1.50:0.3": "",
  "sn1.50:1.1": "Avihaṃ upapannāse || ",
  "sn1.50:1.2": "vimuttā satta bhikkhavo || ",
  "sn1.50:1.3": "rāgadosaparikkhīṇā || ",
  "sn1.50:1.4": "tiṇṇā loke visattikan ti || || ",
  "sn1.50:2.1": "Ke ca te ataruṃ paṅkaṃ || ",
  "sn1.50:2.2": "maccudheyyaṃ suduttaraṃ || ",
  "sn1.50:2.3": "te hitvā mānusaṃ dehaṃ || ",
  "sn1.50:2.4": "dibbayogam upaccagun ti || || ",
  "sn1.50:3.1": "Upako Phalagaṇḍo ca || ",
  "sn1.50:3.2": "Pukkusāti ca te tayo || ",
  "sn1.50:3.3": "Bhaddiyo Khaṇḍadevo ca || ",
  "sn1.50:3.4": "Bāhuraggi ca Piṅgiyo || ",
  "sn1.50:3.5": "te hitvā mānusaṃ dehaṃ || ",
  "sn1.50:3.6": "dibbayogam upaccagun ti || || ",
  "sn1.50:4.1": "Kusalaṃ bhāsasi tesaṃ || ",
  "sn1.50:4.2": "mārapāsappahāyinaṃ || ",
  "sn1.50:4.3": "kassa te dhammam aññāya || ",
  "sn1.50:4.4": "acchiduṃ bhavabhandhanan ti || || ",
  "sn1.50:5.1": "Na aññatra Bhagavatā || ",
  "sn1.50:5.2": "naññatra tava sāsanā || ",
  "sn1.50:5.3": "yassa te dhammam aññāya || ",
  "sn1.50:5.4": "acchiduṃ bhavabandhanaṃ || || ",
  "sn1.50:6.1": "yattha nāmañca rupañca || ",
  "sn1.50:6.2": "asesam uparujjhati || ",
  "sn1.50:6.3": "taṃ te dhammam idha ñāya || ",
  "sn1.50:6.4": "acchiduṃ bhavabandhanan ti || || ",
  "sn1.50:7.1": "Gambhīraṃ bhāsasi vācaṃ || ",
  "sn1.50:7.2": "dubbijānam sudubbudhaṃ || ",
  "sn1.50:7.3": "kassa tvaṃ dhammam aññaya || ",
  "sn1.50:7.4": "vācam bhāsasi īdisanti || || ",
  "sn1.50:8.1": "Kumbhakāro pure āsiṃ || ",
  "sn1.50:8.2": "Vehaḷiṅge ghaṭīkaro || ",
  "sn1.50:8.3": "mātāpettibharo āsiṃ || ",
  "sn1.50:8.4": "Kassapassa upāsako || ",
  "sn1.50:9.1": "virato methunā dhammā || ",
  "sn1.50:9.2": "brahmacārī nirāmiso || ",
  "sn1.50:9.3": "ahuvā te sagāmeyyo || ",
  "sn1.50:9.4": "ahuvā te pure sakhā || ",
  "sn1.50:10.1": "so-ham ete pajānāmi || ",
  "sn1.50:10.2": "vimutte satta bhikkhave || ",
  "sn1.50:10.3": "rāgadosaparikkhīṇe || ",
  "sn1.50:10.4": "tiṇṇe loke visattikan ti || || ",
  "sn1.50:11.1": "Evam etaṃ tadā āsi || ",
  "sn1.50:11.2": "yathā bhāsasi Bhaggava || ",
  "sn1.50:11.3": "kumbhakāro pure āsi || ",
  "sn1.50:11.4": "Vehaḷiṅge ghaṭikāro || ",
  "sn1.50:11.5": "mātāpettibharo āsi || ",
  "sn1.50:11.6": "Kassapassa upāsako || ",
  "sn1.50:12.1": "virato methunā dhammā || ",
  "sn1.50:12.2": "brahmacārī nirāmiso || ",
  "sn1.50:12.3": "ahuvā me sagāmeyyo || ",
  "sn1.50:12.4": "ahuvā me pure sakhā ti || || ",
  "sn1.50:13.1": "evam etaṃ purāṇānaṃ || ",
  "sn1.50:13.2": "sahāyānam ahu saṅgamo || ",
  "sn1.50:13.3": "ubhinnaṃ bhāvitattānaṃ || ",
  "sn1.50:13.4": "sarīrantimadhārinan ti || || ",
  "sn1.50:13.5": "",
  "sn1.50:14.0": "",
  "sn1.50:14.1": "Ādittaṃ Kiṃdadam Annaṃ || ",
  "sn1.50:14.2": "Ekamūla Anomiyaṃ || ",
  "sn1.50:14.3": "Accharā Vanaropetaṃ || ",
  "sn1.50:14.4": "Maccherena Ahaṭīkaro ti || || ___________________________________________ "
}
