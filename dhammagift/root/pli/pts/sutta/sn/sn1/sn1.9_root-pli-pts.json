  "sn1.9:0.3": "",
  "sn1.9:1.1": "",
  "sn1.9:1.2": "ṭhitā kho sā devatā Bhagavato santike imaṃ gātham abhāsi || || ",
  "sn1.9:2.1": "Na mānakāmassa damo idh-atthi || ",
  "sn1.9:2.2": "na monam atthi asamāhitassa || ",
  "sn1.9:2.3": "eko araññe viharaṃ pamatto || ",
  "sn1.9:2.4": "na maccudheyyassa tareyya pāran ti || || ",
  "sn1.9:3.1": "Mānam pahāya susamāhitatto || ",
  "sn1.9:3.2": "sucetaso sabbadhi vippamutto || ",
  "sn1.9:3.3": "eko araññe viharaṃ appamatto || ",
  "sn1.9:3.4": "sa maccudheyyassa tareyya pāran ti || || Ekam antaṃ "
}
