  "sn1.6:0.3": "",
  "sn1.6:1.1": "",
  "sn1.6:1.2": "ṭhitā kho sā devatā Bhagavato santike imaṃ gātham abhāsi || || ",
  "sn1.6:2.1": "Kati jāgarataṃ suttā || ",
  "sn1.6:2.2": "kati suttesu jāgarā || ",
  "sn1.6:2.3": "katīhi rajaṃ ādeti || ",
  "sn1.6:2.4": "katīhi parisujjhatīti || || ",
  "sn1.6:3.1": "Pañca jāgarataṃ suttā || ",
  "sn1.6:3.2": "pañca-suttesu jāgarā || ",
  "sn1.6:3.3": "pañcahi rajam ādeti || pañcahi ",
  "sn1.6:3.4": "parisujjhatī ti || || Ekam antaṃ "
}
