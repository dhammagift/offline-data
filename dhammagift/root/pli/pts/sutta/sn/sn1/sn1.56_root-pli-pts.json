  "sn1.56:0.3": "",
  "sn1.56:1.1": "Kiṃsu janeti purisaṃ || ",
  "sn1.56:1.2": "kiṃsu tassa vidhāvati || ",
  "sn1.56:1.3": "kiṃsu saṃsāram āpādi || ",
  "sn1.56:1.4": "kismā na parimuccatīti || || ",
  "sn1.56:2.1": "Taṇhā janeti purisaṃ || ",
  "sn1.56:2.2": "cittam assa vidhāvati || ",
  "sn1.56:2.3": "satto saṃsāram āpādi || ",
  "sn1.56:2.4": "dukkhā na parimuccatī ti || || "
}
