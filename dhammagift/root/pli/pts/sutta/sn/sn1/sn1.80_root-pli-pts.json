  "sn1.80:0.1": "",
  "sn1.80:0.2": "",
  "sn1.80:0.3": "",
  "sn1.80:1.1": "Kiṃsu lokasmiṃ pajjoto || ",
  "sn1.80:1.2": "kiṃsu lokasmiṃ jāgaro || ",
  "sn1.80:1.3": "kiṃsu kamme sajīvānaṃ || ",
  "sn1.80:1.4": "kim assa iriyāpatho. || || ",
  "sn1.80:2.1": "kiṃsu alasam analasañca || ",
  "sn1.80:2.2": "mātā puttaṃ va posati || ",
  "sn1.80:2.3": "kiṃsu bhūtā upajīvanti || ",
  "sn1.80:2.4": "ye pāṇā pathaviṃ sītāti || || ",
  "sn1.80:3.1": "Paññā lokasmiṃ pajjoto || ",
  "sn1.80:3.2": "sati lokasmiṃ jāgaro || ",
  "sn1.80:3.3": "gāvo kamme sajīvānaṃ || ",
  "sn1.80:3.4": "sītassa iriyāpatho || ",
  "sn1.80:4.1": "vuṭṭhi alasam analasañca || ",
  "sn1.80:4.2": "mātā puttaṃ va posati || ",
  "sn1.80:4.3": "vuṭṭhibhūtā upajīvanti || ",
  "sn1.80:4.4": "ye pāṇā pathaviṃ sitā ti || || Kesu-dha "
}
