  "sn1.71:0.3": "",
  "sn1.71:1.1": "",
  "sn1.71:1.2": "ṭhitā kho sā devatā Bhagavantaṃ gāthāya ajjhabhāsi || || ",
  "sn1.71:2.1": "Kiṃsu chetvā sukhaṃ seti || ",
  "sn1.71:2.2": "kiṃsu chetvā na socati || ",
  "sn1.71:2.3": "kissassa ekadhammassa || ",
  "sn1.71:2.4": "vadhaṃ rocesi Gotamā ti || || ",
  "sn1.71:3.1": "Kodhaṃ chetvā sukhaṃ seti || ",
  "sn1.71:3.2": "kodhaṃ chetvā na socāti || ",
  "sn1.71:3.3": "kodhassa vīsamūlassa || ",
  "sn1.71:3.4": "madhuraggassa devate || ",
  "sn1.71:3.5": "vadham ariyā pasaṃsanti || ",
  "sn1.71:3.6": "taṃ hi chetvā na socatīti || || "
}
