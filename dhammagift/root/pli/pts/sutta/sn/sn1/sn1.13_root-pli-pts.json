{
  "sn1.13:0.1": "",
  "sn1.13:0.2": "",
  "sn1.13:0.3": "",
  "sn1.13:1.1": "",
  "sn1.13:1.2": "ṭhitā kho sā devatā Bhagavato santike imaṃ gātham abhāsi. || || ",
  "sn1.13:2.1": "Natthi puttasamaṃ pemaṃ || ",
  "sn1.13:2.2": "natthi gosamitam dhanaṃ || ",
  "sn1.13:2.3": "natthi suriyasamā ābhā. || ",
  "sn1.13:2.4": "samudda paramā sarāti || || ",
  "sn1.13:3.1": "Natthi attasamaṃ pemaṃ || ",
  "sn1.13:3.2": "natthi dhaññasamaṃ dhanaṃ || ",
  "sn1.13:3.3": "natthi paññāsamā ābhā || ",
  "sn1.13:3.4": "vuṭṭhi ve paramā sarā ti || || "
}
