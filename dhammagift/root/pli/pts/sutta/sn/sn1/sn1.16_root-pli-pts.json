  "sn1.16:0.3": "",
  "sn1.16:1.1": "Niddā tandī vijambhikā || ",
  "sn1.16:1.2": "aratī bhattasammado || ",
  "sn1.16:1.3": "etena nappakāsati || ",
  "sn1.16:1.4": "ariyamaggo idha pāṇinan ti || || ",
  "sn1.16:2.1": "Niddaṃ tandiṃ vijambhikaṃ || ",
  "sn1.16:2.2": "aratiṃ bhattasammadaṃ || ",
  "sn1.16:2.3": "viriyena naṃ paṇāmetvā || ",
  "sn1.16:2.4": "ariyamaggo visujjhatīti || || "
}
