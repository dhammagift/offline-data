  "sn1.78:1.1": "na dade || ",
  "sn1.78:1.2": "kiṃ macco na pariccaje || ",
  "sn1.78:1.3": "kiṃsu mucceyya kalyāṇam || ",
  "sn1.78:1.4": "pāpiyaṃ ca na mocayeti || || ",
  "sn1.78:2.1": "Attānaṃ na dade poso || ",
  "sn1.78:2.2": "attānam na pariccaje || ",
  "sn1.78:2.3": "vācaṃ muñceyya kalyāṇiṃ || pāpikaṃ ",
  "sn1.78:2.4": "ca na mocaye ti || || "
}
