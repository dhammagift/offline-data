  "sn1.22:0.1": "",
  "sn1.22:0.2": "",
  "sn1.22:0.3": "",
  "sn1.22:1.1": "Nāphusantam phusati ca || ",
  "sn1.22:1.2": "phusantaṃ ca tato phuse || ",
  "sn1.22:1.3": "tasmā phusantam phusati || ",
  "sn1.22:1.4": "appaduṭṭhapadosinan ti || || ",
  "sn1.22:2.1": "Yo appaduṭṭhassa narassa dussati || ",
  "sn1.22:2.2": "suddhassa posassa anaṅgaṇassa || ",
  "sn1.22:2.3": "tam eva bālaṃ pacceti pāpaṃ || ",
  "sn1.22:2.4": "sukhumo rajo paṭivātaṃ va khitto ti || || "
}
