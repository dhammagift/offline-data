  "sn1.27:0.1": "",
  "sn1.27:0.2": "",
  "sn1.27:0.3": "",
  "sn1.27:1.1": "Kuto sarā nivattanti || ",
  "sn1.27:1.2": "kattha vaṭṭam na vaṭṭati || ",
  "sn1.27:1.3": "kattha nāmañca rūpañca || ",
  "sn1.27:1.4": "asesam uparujjhatīti || || ",
  "sn1.27:2.1": "Yattha āpo ca pathavī || ",
  "sn1.27:2.2": "tejo vāyo na gādhati || ",
  "sn1.27:2.3": "ato sarā nivattanti || ",
  "sn1.27:2.4": "ettha vaṭṭam na vaṭṭati || ",
  "sn1.27:2.5": "ettha nāmañca rupañca || ",
  "sn1.27:2.6": "asesam uparujjhatīti || || "
}
