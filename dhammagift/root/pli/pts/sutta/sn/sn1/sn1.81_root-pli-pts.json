  "sn1.81:0.3": "",
  "sn1.81:1.1": "araṇā loke || ",
  "sn1.81:1.2": "kesaṃ vusiṭaṃ na nassati || ",
  "sn1.81:1.3": "ke-dha icchaṃ parijānanti || ",
  "sn1.81:1.4": "kesaṃ bhojisiyaṃ sadā || || ",
  "sn1.81:2.1": "kiṃsu mātā pitā bhātā || ",
  "sn1.81:2.2": "vandanti naṃ patiṭṭhitaṃ || ",
  "sn1.81:2.3": "kaṃsu idha jātihīnaṃ || ",
  "sn1.81:2.4": "abhivādenti khattiyā ti || || ",
  "sn1.81:3.1": "Samaṇīdha araṇā loke || ",
  "sn1.81:3.2": "samaṇānaṃ vusitaṃ na nassati || ",
  "sn1.81:3.3": "samaṇā icchaṃ parijānanti || ",
  "sn1.81:3.4": "samaṇānaṃ bhojisiyaṃ sadā || || ",
  "sn1.81:4.1": "Samaṇaṃ mātā pitā bhātā || ",
  "sn1.81:4.2": "vandanti naṃ patiṭṭhitaṃ || ",
  "sn1.81:4.3": "samaṇīdha jātihīnaṃ || ",
  "sn1.81:4.4": "abhivādenti khattiyā ti || || ",
  "sn1.81:4.5": "",
  "sn1.81:5.0": "",
  "sn1.81:5.1": "Chetvā Rathaṃ ca Vittaṃ ca || ",
  "sn1.81:5.2": "Vuṭṭhi Bhītā Na-jīrati || ",
  "sn1.81:5.3": "Issaraṃ Kāmaṃ Pātheyyaṃ || ",
  "sn1.81:5.4": "Pajjoto Araṇena cā ti || || ",
  "sn1.81:5.5": "Devatā-Samyuttaṃ samattaṃ || || ******************************************** ___________________________________________ 1. "
}
