{
  "sn1.17:0.1": "",
  "sn1.17:0.2": "",
  "sn1.17:0.3": "",
  "sn1.17:1.1": "Dukkaraṃ duttitikkhañca || ",
  "sn1.17:1.2": "avyattena ca sāmaññaṃ || ",
  "sn1.17:1.3": "bahū hi tattha sambādhā || ",
  "sn1.17:1.4": "yattha bālo visīdatīti || || ",
  "sn1.17:2.1": "Kati-haṃ careyya sāmaññaṃ || ",
  "sn1.17:2.2": "cittaṃ ce na nivāreyya || ",
  "sn1.17:2.3": "pade pade visīdeyya || ",
  "sn1.17:2.4": "saṅkappānaṃ vasānugo || || ",
  "sn1.17:3.1": "Kummo va aṅgāni sake kapāle || ",
  "sn1.17:3.2": "samodahaṃ bhikkhu mano-vitakke || ",
  "sn1.17:3.3": "anissito aññam aheṭhayāno || ",
  "sn1.17:3.4": "parinibbuto na upavadeyya kañcīti || || "
}
