  "sn1.5:0.3": "",
  "sn1.5:1.1": "",
  "sn1.5:1.2": "ṭhitā kho sā devatā Bhagavato santike imaṃ gātham abhāsi || || ",
  "sn1.5:2.1": "Kati chinde kati jahe || ",
  "sn1.5:2.2": "kati vuttari bhāvaye || ",
  "sn1.5:2.3": "katisaṅgātigo bhikkhu || ",
  "sn1.5:2.4": "oghatiṇṇo ti viccatīti || || ",
  "sn1.5:3.1": "Pañca chinde pañca jahe || ",
  "sn1.5:3.2": "pañca vuttari bhāvaye || ",
  "sn1.5:3.3": "pañcasaṅgātigo bhikkhu || ",
  "sn1.5:3.4": "oghatiṇṇo ti vuccatīti || || Ekam antaṃ "
}
