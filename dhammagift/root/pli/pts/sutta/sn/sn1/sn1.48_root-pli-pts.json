  "sn1.48:0.1": "",
  "sn1.48:0.2": "",
  "sn1.48:0.3": "",
  "sn1.48:1.1": "Jetavanaṃ || ",
  "sn1.48:1.2": "isisaṅghanisevitaṃ || ",
  "sn1.48:1.3": "āvutthaṃ dhammarājena || ",
  "sn1.48:1.4": "pītisañjananam mama || || ",
  "sn1.48:2.1": "kammaṃ vijjā ca dhammo ca || ",
  "sn1.48:2.2": "sīlaṃ jīvitam uttamaṃ || ",
  "sn1.48:2.3": "etena maccā sujjhanti || ",
  "sn1.48:2.4": "na gottena dhanena vā || || ",
  "sn1.48:3.1": "Tasmā hi paṇḍito poso || ",
  "sn1.48:3.2": "sampassaṃ attham attano || ",
  "sn1.48:3.3": "yoniso vicine dhammaṃ || ",
  "sn1.48:3.4": "evaṃ tattha visujjhati || || ",
  "sn1.48:4.1": "Sāriputto va paññāya || ",
  "sn1.48:4.2": "sīlena upasamena ca || ",
  "sn1.48:4.3": "yo pi pāragato bhikkhu || ",
  "sn1.48:4.4": "etāva paramo siyāti || || Ye dha "
}
