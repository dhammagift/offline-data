{
  "sn1.77:0.1": "",
  "sn1.77:0.2": "",
  "sn1.77:0.3": "",
  "sn1.77:1.1": "Kiṃsu issariyaṃ loke || ",
  "sn1.77:1.2": "kiṃsu bhaṇḍānam uttamaṃ || ",
  "sn1.77:1.3": "kiṃsu satthamalaṃ loke || ",
  "sn1.77:1.4": "kiṃsu lokasmim abbudaṃ || || ",
  "sn1.77:2.1": "kiṃsu harantaṃ vārenti || ",
  "sn1.77:2.2": "haranto pana ko piyo || ",
  "sn1.77:2.3": "kiṃsu punappanāyantaṃ || ",
  "sn1.77:2.4": "abhinandanti paṇḍitāti || || ",
  "sn1.77:3.1": "Vaso issariyaṃ loke || ",
  "sn1.77:3.2": "itthi bhaṇḍānam uttamaṃ || ",
  "sn1.77:3.3": "kodho satthamalam loke || ",
  "sn1.77:3.4": "corā lokasmim abbudā || || ",
  "sn1.77:4.1": "coram harantaṃ vārenti || ",
  "sn1.77:4.2": "haranto samaṇo piyo || ",
  "sn1.77:4.3": "samaṇam punappunāyantaṃ || ",
  "sn1.77:4.4": "abhinandanti paṇḍitāti || || Kiṃ atthakāmo "
}
