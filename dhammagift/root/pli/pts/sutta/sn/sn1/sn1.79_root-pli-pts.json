  "sn1.79:0.3": "",
  "sn1.79:1.1": "Kiṃsu bandhati pātheyyaṃ || ",
  "sn1.79:1.2": "kiṃsu bhogānam āsayo || ",
  "sn1.79:1.3": "kiṃsu naraṃ parikassati || ",
  "sn1.79:1.4": "kiṃsu lokasmiṃ dujjahaṃ || ",
  "sn1.79:1.5": "kismiṃ baddhā puthusattā || ",
  "sn1.79:1.6": "pāsena sakunī yathā ti || || ",
  "sn1.79:2.1": "Saddhā bandhati pātheyyam || ",
  "sn1.79:2.2": "siri bhogānam āsayo || ",
  "sn1.79:2.3": "icchā naram parikassati || ",
  "sn1.79:2.4": "icchā lokasmiṃ dujjahā || ",
  "sn1.79:2.5": "icchābaddhā puthusattā || ",
  "sn1.79:2.6": "pāsena sakuṇī yathā ti || || "
}
