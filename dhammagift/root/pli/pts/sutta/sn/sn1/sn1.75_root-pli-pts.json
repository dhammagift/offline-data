  "sn1.75:0.1": "",
  "sn1.75:0.2": "",
  "sn1.75:0.3": "",
  "sn1.75:1.1": "Kiṃsūdha bhīrā janatā anekā || ",
  "sn1.75:1.2": "maggo v-anekāyatanaṃ pavutto || ",
  "sn1.75:1.3": "pucchāmi taṃ Gotama bhūripañña || ",
  "sn1.75:1.4": "kismiṃ ṭhito paralokaṃ na bhāye ti || || ",
  "sn1.75:2.1": "Vācaṃ manañca paṇidhāya sammā || ",
  "sn1.75:2.2": "kāyena pāpāni akubbamāno || ",
  "sn1.75:2.3": "bahvannapānaṃ gharam āvasanto || ",
  "sn1.75:2.4": "saddho mudū saṃvibhāgī vadaññū || ",
  "sn1.75:2.5": "etesu dhammesu ṭhito catusu || ",
  "sn1.75:2.6": "paralokaṃ na bhāye ti || || "
}
