  "sn1.3:1.1": "",
  "sn1.3:1.2": "ṭhitā kho sā devatā Bhagavato santike imaṃ gātham abhāsi || || ",
  "sn1.3:2.1": "Upanīyati jīvitam appam āyu || ",
  "sn1.3:2.2": "jarūpanītassa na santi tāṇā || ",
  "sn1.3:2.3": "etaṃ bhayaṃ marane pekkhamāno || ",
  "sn1.3:2.4": "puññāni kayirātha sukhāvahānī ti || || ",
  "sn1.3:3.1": "Upanīyati jīvitam appam āyu || ",
  "sn1.3:3.2": "jarūpanītassa na santi tāṇā || ",
  "sn1.3:3.3": "etaṃ bhayaṃ maraṇe pekkhamāno || ",
  "sn1.3:3.4": "lokāmisaṃ pajahe santipekkho ti || || Ekam antaṃ "
}
