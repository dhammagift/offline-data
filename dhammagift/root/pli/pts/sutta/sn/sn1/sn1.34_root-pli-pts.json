{
  "sn1.34:0.1": "",
  "sn1.34:0.2": "",
  "sn1.34:0.3": "",
  "sn1.34:1.1": "Ekaṃ samayaṃ Bhagavā Sāvatthiyaṃ viharati Jetavane Anāthapiṇḍikassa ārāme || 2. ",
  "sn1.34:1.2": "Atha kho sambahulā Satullapakāyikā devatāyo abhikkantāya rattiyā abhikkantavaṇṇā kevalakappaṃ Jetavanam obhāsetvā yena Bhagavā ten-upasaṅkamiṃsu || upasaṅkamitvā Bhagavantam abhivādetvā ekam antam aṭṭhaṃsu || 3. ",
  "sn1.34:1.3": "Ekam antaṃ ṭhitā kho ekā devatā Bhagavato santike imaṃ gātham abhāsi || || ",
  "sn1.34:2.1": "Na santi kāmā manujesu niccā || ",
  "sn1.34:2.2": "santīdha kamanīyāni yesu baddho || ",
  "sn1.34:2.3": "yesu pamatto apunāgamanaṃ || ",
  "sn1.34:2.4": "anāgantvā puriso maccudheyyā ti || || ",
  "sn1.34:3.1": "Chandajam aghaṃ || chandajaṃ dukkhaṃ || ",
  "sn1.34:3.2": "chandavinayā aghavinayo || ",
  "sn1.34:3.3": "aghavinayā dukkhavinayo ti || || ",
  "sn1.34:4.1": "Na te kāmā yāni citrāni loke || ",
  "sn1.34:4.2": "saṅkapparāgo purisassa kāmo || ",
  "sn1.34:4.3": "tiṭṭhanti citrāni tath-eva loke || ",
  "sn1.34:4.4": "ath-ettha dhīrā vinayanti chandam || || ",
  "sn1.34:5.1": "Kodhaṃ jahe vippajaheyya mānaṃ || ",
  "sn1.34:5.2": "saṃyojanaṃ sabbam atikkameyya || ",
  "sn1.34:5.3": "taṃ nāmarūpasmim asajjamānaṃ || ",
  "sn1.34:5.4": "akiñcanaṃ nānupatanti dukkhā || || ",
  "sn1.34:6.1": "Pahāsi saṅkhaṃ na vimānam ajjhagā || ",
  "sn1.34:6.2": "acchecchi taṇham idha nāmarūpe || ",
  "sn1.34:6.3": "taṃ chinnagantham anighaṃ nirāsaṃ || ",
  "sn1.34:6.4": "pariyesamānā na ca ajjhagamuṃ || ",
  "sn1.34:6.5": "devā manussā idha vā huraṃ vā || ",
  "sn1.34:6.6": "saggesu vā sabbanivesanesū ti || || Taṃ ",
  "sn1.34:7.1": "ce hi nāddakkhuṃ tathā vimuttaṃ || ",
  "sn1.34:7.2": "iccāyasmā Mogharājā || ",
  "sn1.34:7.3": "deva manussā idha vā huraṃ vā || ",
  "sn1.34:7.4": "naruttamaṃ atthacaraṃ narānaṃ || ",
  "sn1.34:7.5": "ye taṃ namassanti pasaṃsiyā te ti || || ",
  "sn1.34:8.1": "Pasaṃsiyā te pi bhavanti bhikkhu || ",
  "sn1.34:8.2": "Mogharājā ti Bhagavā || ",
  "sn1.34:8.3": "ye taṃ namassanti tathā vimuttam || ",
  "sn1.34:8.4": "aññāya dhammaṃ vicikicchaṃ pahāya || ",
  "sn1.34:8.5": "saṅgātigā te pi bhavanti bhikkhū ti || || 1. "
}
