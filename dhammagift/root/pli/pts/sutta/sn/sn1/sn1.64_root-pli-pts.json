  "sn1.64:1.1": "Kiṃsu saṃyojano loko || ",
  "sn1.64:1.2": "kiṃsu tassa vicāraṇam || ",
  "sn1.64:1.3": "kissassa vippahānena || ",
  "sn1.64:1.4": "nibbānam iti vuccatīti || || ",
  "sn1.64:2.1": "Nandī saṃyojano loko || ",
  "sn1.64:2.2": "vitakk-assa vicāraṇam || ",
  "sn1.64:2.3": "taṇhāya vippahānena || ",
  "sn1.64:2.4": "nibbānam iti vuccatīti || || "
}
