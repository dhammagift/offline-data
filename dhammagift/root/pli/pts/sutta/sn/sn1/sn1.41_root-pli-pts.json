  "sn1.41:0.1": "",
  "sn1.41:0.2": "",
  "sn1.41:0.3": "",
  "sn1.41:1.1": "Evam me sutam ",
  "sn1.41:1.2": "ekaṃ samayaṃ Bhagavā Sāvatthiyaṃ viharati Jetavane Anāthapiṇḍikassa ārame || || ",
  "sn1.41:1.3": "Atha kho aññatarā devatā abhikkantāya rattiyā abhikkantavaṇṇā kevalakappaṃ Jetavanam obhāsetvā yena Bhagavā ten-upasaṅkami || upasaṅkamitvā Bhagavantam abhivādetvā ekam antam aṭṭhāsi || ",
  "sn1.41:1.4": "Ekam antam ṭhitā kho sā devatā Bhagavato santike imā gāthāyo abhāsi || || ",
  "sn1.41:2.1": "Ādittasmim agārasmiṃ || ",
  "sn1.41:2.2": "yaṃ nīharati bhājanaṃ || ",
  "sn1.41:2.3": "taṃ tassa hoti atthāya || ",
  "sn1.41:2.4": "no ca yaṃ tattha ḍayhatīti || || ",
  "sn1.41:3.1": "Evam ādīpito loko || ",
  "sn1.41:3.2": "jarāya maraṇena ca || ",
  "sn1.41:3.3": "nīhareth-eva dānena || ",
  "sn1.41:3.4": "dinnaṃ hoti sunīhataṃ || || ",
  "sn1.41:4.1": "dinnaṃ sukhaphalaṃ hoti || ",
  "sn1.41:4.2": "nādinnam hoti taṃ tathā || ",
  "sn1.41:4.3": "corā haranti rājāno || ",
  "sn1.41:4.4": "aggī ḍayhati nassati || || ",
  "sn1.41:5.1": "Atha antena jahāti || ",
  "sn1.41:5.2": "sarīraṃ sapariggahaṃ || ",
  "sn1.41:5.3": "etad aññāya medhāvi || ",
  "sn1.41:5.4": "bhuñjetha ca dadetha ca || ",
  "sn1.41:5.5": "datvā bhutvā ca yathānubhāvaṃ || ",
  "sn1.41:5.6": "anindito saggam upeti ṭhānan ti || || "
}
