  "sn1.72:0.1": "",
  "sn1.72:0.2": "",
  "sn1.72:0.3": "",
  "sn1.72:1.1": "Kiṃsu rathassa paññāṇaṃ || ",
  "sn1.72:1.2": "kiṃsu paññāṇam aggino || ",
  "sn1.72:1.3": "kiṃsu raṭṭhassa paññāṇaṃ || ",
  "sn1.72:1.4": "kiṃsu paññāṇam itthiyā ti || || ",
  "sn1.72:2.1": "Dhajo rathassa paññāṇam || ",
  "sn1.72:2.2": "dhūmo paññāṇam aggino || ",
  "sn1.72:2.3": "rājā raṭṭhassa paññāṇam || ",
  "sn1.72:2.4": "bhattā paññāṇam itthiyāti || || "
}
