  "sn1.61:1.1": "Kiṃsu sabbaṃ addhabhavi || ",
  "sn1.61:1.2": "kismā bhīyo na vijjati || ",
  "sn1.61:1.3": "kissassa ekadhammassa || ",
  "sn1.61:1.4": "sabbeva vasam anvagū ti || || ",
  "sn1.61:2.1": "Nāmam sabbam addhabhavi || ",
  "sn1.61:2.2": "nāmā bhīyo na vijjati || ",
  "sn1.61:2.3": "nāmassa ekadhammassa || ",
  "sn1.61:2.4": "sabbeva vasam anvagū ti || || "
}
