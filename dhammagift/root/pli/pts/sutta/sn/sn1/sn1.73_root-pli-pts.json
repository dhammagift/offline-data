{
  "sn1.73:0.1": "",
  "sn1.73:0.2": "",
  "sn1.73:0.3": "",
  "sn1.73:1.1": "Kiṃsūdha vittaṃ purisassa seṭṭhaṃ || ",
  "sn1.73:1.2": "kiṃsu suciṇṇo sukham āvahāti || ",
  "sn1.73:1.3": "kiṃsu have sādutaraṃ rasānaṃ || ",
  "sn1.73:1.4": "kathaṃ jīviṃ jūvitam āhu seṭṭhan ti || || ",
  "sn1.73:2.1": "Saddhīdha vittaṃ purisassa seṭṭham || ",
  "sn1.73:2.2": "dhammo suciṇṇo sukham āvahāti || ",
  "sn1.73:2.3": "saccam have sādutaram rasānam || ",
  "sn1.73:2.4": "paññājīviṃ jīvitaṃ āhu setthaṇ ti || || "
}
