  "sn1.58:0.1": "",
  "sn1.58:0.2": "",
  "sn1.58:0.3": "",
  "sn1.58:1.1": "Kiṃsu uppatho akkhāti || ",
  "sn1.58:1.2": "kiṃsu rattindivakkhayo || ",
  "sn1.58:1.3": "kiṃ malaṃ brahmacariyassa || ",
  "sn1.58:1.4": "kim sinānam anodakanti || || ",
  "sn1.58:2.1": "Rāgo uppatho akkhāti || ",
  "sn1.58:2.2": "vayo rattindivakkhayo || ",
  "sn1.58:2.3": "itthi malaṃ brahmacariyassa || ",
  "sn1.58:2.4": "etthāyaṃ sajjate pajā || ",
  "sn1.58:2.5": "tapo brahmacariyañca || ",
  "sn1.58:2.6": "taṃ sinānam anodakan ti || || "
}
