  "sn1.70:1.1": "Kismiṃ loko samuppanno || ",
  "sn1.70:1.2": "kismiṃ kubbati santhavaṃ || ",
  "sn1.70:1.3": "kissā loko upādāya || ",
  "sn1.70:1.4": "kismiṃ loko vihaññatīti || || ",
  "sn1.70:2.1": "Chasu loko samuppanno || ",
  "sn1.70:2.2": "chasu kubbati santhavaṃ || ",
  "sn1.70:2.3": "channam eva upādāya || ",
  "sn1.70:2.4": "chasu loko vihaññatīti || || ",
  "sn1.70:2.5": "",
  "sn1.70:3.0": "",
  "sn1.70:3.1": "Nāmam Cittaṃ ca Taṇhā ca || ",
  "sn1.70:3.2": "Saṃyojanaṃ ca Bandhanā || ",
  "sn1.70:3.3": "Abbhāhat-Uḍḍito Pihito || ",
  "sn1.70:3.4": "Icchā Lokena te dasā ti || || ___________________________________________ Ekam antaṃ "
}
