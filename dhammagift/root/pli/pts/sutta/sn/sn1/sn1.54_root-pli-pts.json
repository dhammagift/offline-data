  "sn1.54:0.3": "",
  "sn1.54:1.1": "Kiṃsu vatthu manussānaṃ || ",
  "sn1.54:1.2": "kiṃsu-dha paramā sakhā || ",
  "sn1.54:1.3": "kiṃsu bhūtā upajīvanti || ",
  "sn1.54:1.4": "ye pāṇā pathaviṃ sitā ti || || ",
  "sn1.54:2.1": "Puttā vatthu manussānaṃ || ",
  "sn1.54:2.2": "bhariyā ca paramā sakhā || ",
  "sn1.54:2.3": "vuṭṭhibhūtā upajīvanti || ",
  "sn1.54:2.4": "ye pāṇā pathaviṃ sitā ti || || "
}
