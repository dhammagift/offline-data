{
  "sn1.26:0.1": "",
  "sn1.26:0.2": "",
  "sn1.26:0.3": "",
  "sn1.26:1.1": "Kati lokasmiṃ pajjotā || ",
  "sn1.26:1.2": "yehi loko pakāsati. || ",
  "sn1.26:1.3": "bhavantaṃ puṭṭhum āgamma || ",
  "sn1.26:1.4": "kathaṃ jānemu taṃ mayan ti || || ",
  "sn1.26:2.1": "Cattāro loke pajjotā || ",
  "sn1.26:2.2": "pañcam-etthana vijjati || ",
  "sn1.26:2.3": "divā tapati ādicco || ",
  "sn1.26:2.4": "rattim ābhāti candimā || || ",
  "sn1.26:3.1": "atha aggi divārattiṃ || ",
  "sn1.26:3.2": "tattha tattha pabhāsati || ",
  "sn1.26:3.3": "sambuddho tapataṃ seṭṭho || ",
  "sn1.26:3.4": "esā ābhā anuttarā ti || || "
}
