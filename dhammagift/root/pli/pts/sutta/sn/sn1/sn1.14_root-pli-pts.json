{
  "sn1.14:0.1": "",
  "sn1.14:0.2": "",
  "sn1.14:0.3": "",
  "sn1.14:1.1": "Khattiyo dvipadaṃ seṭṭho || ",
  "sn1.14:1.2": "balivaddo catuppadaṃ || ",
  "sn1.14:1.3": "kumārī seṭṭhā bhariyānaṃ || ",
  "sn1.14:1.4": "yo ca puttānaṃ pubbajoti || || ",
  "sn1.14:2.1": "Sambuddho dvipadaṃ seṭṭho || ",
  "sn1.14:2.2": "ājānīyo catuppadaṃ || ",
  "sn1.14:2.3": "sussūsā seṭṭhā bhariyānaṃ || ",
  "sn1.14:2.4": "yo ca puttānam assavo ti || || "
}
