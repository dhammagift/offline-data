  "sn9.14:0.1": "",
  "sn9.14:0.2": "",
  "sn9.14:0.3": "",
  "sn9.14:1.1": "Ekaṃ samayam aññataro bhikkhu Kosalesu viharati aññatarasmiṃ vanasaṇḍe || || 2. ",
  "sn9.14:1.2": "Tena kho pana samayena so bhikkhu pacchābhattaṃ piṇḍapātapatikkanto pokkharaṇim ogahetvā padumam upasiṅghati || 3. ",
  "sn9.14:1.3": "Atha kho yā tasmiṃ vanasaṇḍe adhivatthā devatā tassa bhikkhuno anukampikā atthakāmā taṃ bhikkhuṃ saṃvejetukāmā yena so bhikkhu ten-upasaṅkami || || 4. Upasaṅkamitvā taṃ bhikkhuṃ gāthāya ajjhabhāsi || || ",
  "sn9.14:2.1": "Yam etaṃ vārijaṃ pupphaṃ || ",
  "sn9.14:2.2": "adinnam upasiṅghasi || ",
  "sn9.14:2.3": "ekaṅgam etaṃ theyyānaṃ || ",
  "sn9.14:2.4": "gandhattheno si mārisā ti || || 5. ",
  "sn9.14:3.1": "Na harāmi na bhañjāmi || ",
  "sn9.14:3.2": "ārā siṅghāmi vārijaṃ || ",
  "sn9.14:3.3": "atha kena nu vaṇṇena || ",
  "sn9.14:3.4": "gandhattheno ti vuccati || || ",
  "sn9.14:4.1": "yvāyaṃ bhisāni khaṇati || ",
  "sn9.14:4.2": "puṇḍarīkāni bhuñjati || ",
  "sn9.14:4.3": "evam ākiṇṇakammanto || ",
  "sn9.14:4.4": "kasmā eso na vuccati || || 6. ",
  "sn9.14:5.1": "ākiṇṇaluddo puriso || ",
  "sn9.14:5.2": "dhāti celaṃ va makkhito || ",
  "sn9.14:5.3": "tasmiṃ me vacanaṃ natthi || ",
  "sn9.14:5.4": "tañ cārahāmi vattave || || ",
  "sn9.14:6.1": "anaṅgaṇassa posassa || ",
  "sn9.14:6.2": "niccaṃ sucigavesino || ",
  "sn9.14:6.3": "vāḷaggamattam pāpassa || ",
  "sn9.14:6.4": "abbhāmattaṃ va khāyati || || 7. ",
  "sn9.14:7.1": "addhā maṃ yakkha jānāsi || ",
  "sn9.14:7.2": "atho mam anukampasi || ",
  "sn9.14:7.3": "puna pi yakkha vajjesi || ",
  "sn9.14:7.4": "yadā passasi edisaṃ || || 8. ",
  "sn9.14:8.1": "neva taṃ upājīvāmi || ",
  "sn9.14:8.2": "na pi te katakammase || ",
  "sn9.14:8.3": "tvam eva bhikkhu jāneyya || ",
  "sn9.14:8.4": "yena gaccheyya suggatin ti || || 9. ",
  "sn9.14:9.1": "Atha kho so bhikkhu tāya devatāya saṃvejito saṃvegam āpādīti || || Vana- ",
  "sn9.14:9.2": "saṃyuttaṃ samattaṃ || || Viveka ",
  "sn9.14:10.0": "",
  "sn9.14:10.1": "Uppaṭṭhānañ ca || ",
  "sn9.14:10.2": "Kassapagottena ca || Sambahulā ",
  "sn9.14:10.3": "Ānando || Anuruddho Nāgadattañ ca || ",
  "sn9.14:10.4": "Kulagharanī ",
  "sn9.14:11.1": "Vajjīputto || Vesalī ",
  "sn9.14:11.2": "Sajjhāyena ca || Ayoniso ",
  "sn9.14:11.3": "Majjhantikālamhi ca || Pākatindriya- ",
  "sn9.14:11.4": "padumapupphena cuddasa bhaveti || || ******************************************** 1. ",
  "sn9.14:11.5": ""
}
