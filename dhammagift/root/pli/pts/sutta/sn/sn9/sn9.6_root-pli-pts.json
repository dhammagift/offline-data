  "sn9.6:0.1": "",
  "sn9.6:0.2": "",
  "sn9.6:0.3": "",
  "sn9.6:1.1": "Ekaṃ samayam āyasmā Anuruddho Kosalesu viharati aññatarasmiṃ vanasaṇḍe || || 2. ",
  "sn9.6:1.2": "Atha kho aññatarā Tāvatiṃsa-kāyikā devatā Jālinī nāma āyasmato Anuruddhassa purāṇa-dutiyikā yenāyasmā Anuruddho ten-upasaṅkami || || 3. Upasaṅkamitvā āyasmantam Anuruddhaṃ gāthāya ajjhabhāsi || || ",
  "sn9.6:2.1": "Tattha cittam paṇidhehi || ",
  "sn9.6:2.2": "yattha te vusitaṃ pure || ",
  "sn9.6:2.3": "Tāvatiṃsesu devesu || ",
  "sn9.6:2.4": "sabbakāmasamiddhisu || ",
  "sn9.6:2.5": "purakkhato parivuto || ",
  "sn9.6:2.6": "devakaññāhi sobhasi || || 4. ",
  "sn9.6:3.1": "Duggatā devakaññāyo || ",
  "sn9.6:3.2": "sakkāyasmiṃ patiṭṭhitā || ",
  "sn9.6:3.3": "te cāpi duggatā sattā || ",
  "sn9.6:3.4": "devakaññābhipattikā || || 5. ",
  "sn9.6:4.1": "Na te sukham pajānanti || ",
  "sn9.6:4.2": "ye na passanti Nandanaṃ || ",
  "sn9.6:4.3": "āvāsaṃ naradevānaṃ || ",
  "sn9.6:4.4": "tidasānam yasassinan ti || || 6. ",
  "sn9.6:5.1": "Na tvam bāle vijānāsi || ",
  "sn9.6:5.2": "yathā arahataṃ vaco || ",
  "sn9.6:5.3": "aniccā sabbe saṅkhārā || ",
  "sn9.6:5.4": "uppadavayadhammino || ",
  "sn9.6:5.5": "uppajjitvā nirujjhanti || ",
  "sn9.6:5.6": "tesaṃ vūpasamo sukho || || ",
  "sn9.6:6.1": "natthidāni punāvāso || ",
  "sn9.6:6.2": "devakāyasmiṃ Jālinī || ",
  "sn9.6:6.3": "vikkhīṇo jātisaṃsāro || ",
  "sn9.6:6.4": "natthi dāni punabbhavo ti || || 1. "
}
