  "sn34.15:1.1": "",
  "sn34.15:1.2": "bhikkhave jhāyī || || ",
  "sn34.15:1.3": "Katame cattāro || || 4-7 ",
  "sn34.15:1.4": "Idha bhikkhave ekacco jhāyī samādhismiṃ samāpattikusalo hoti na samādhismiṃ gocarakusalo || ",
  "sn34.15:1.5": "catukoṭikaṃ ",
  "sn34.15:1.6": "vitthāretabbaṃ || || ",
  "sn34.15:1.7": "-samāpattikusalo ca hoti samādhismiṃ gocarakusalo ca || || 8-9 ",
  "sn34.15:1.8": "Tatra || pa || ",
  "sn34.15:1.9": "pavaro cāti || || 1-3 ",
  "sn34.15:1.10": "Sāvatthi || || Cattāro me "
}
