  "sn34.17:1.1": "",
  "sn34.17:1.2": "bhikkhave jhāyī || || ",
  "sn34.17:1.3": "Katame cattāro || || 4-7 ",
  "sn34.17:1.4": "Idha bhikkhave ekacco jhāyī samādhismiṃ samāpattikusalo hoti na samādhismiṃ sakkaccakārī || || ",
  "sn34.17:1.5": "[catukoṭikaṃ vitthāritabbaṃ] -samādhismiṃ samāpattikusalo ",
  "sn34.17:1.6": "",
  "sn34.17:1.7": "hoti samādhismiṃ sakkaccakārī ca || || 8-9 ",
  "sn34.17:1.8": "Tatra || pa || ",
  "sn34.17:1.9": "pavaro cāti || || 1-3 ",
  "sn34.17:1.10": "Sāvatthi || || Cattāro me "
}
