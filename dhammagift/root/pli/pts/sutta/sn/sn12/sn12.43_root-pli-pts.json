  "sn12.43:0.3": "",
  "sn12.43:1.1": "Sāvatthiyaṃ viharati || || 2 ",
  "sn12.43:1.2": "Dukkhassa bhikkhave samudayañca atthaṅgamañca desissāmi || ",
  "sn12.43:1.3": "taṃ suṇātha || pe|| || ",
  "sn12.43:1.4": "I 3 ",
  "sn12.43:1.5": "",
  "sn12.43:2.1": "Katamo ca bhikkhave dukkhassa samudayo || 4 ",
  "sn12.43:2.2": "Cakkhuṃ ca paticca rūpe ca uppajjati cakkhuviññāṇaṃ || tiṇṇaṃ saṅgatiphasso || ",
  "sn12.43:2.3": "phassapaccayā vedanā || ",
  "sn12.43:2.4": "vedanāpaccayā taṇhā || ",
  "sn12.43:2.5": "Ayaṃ kho bhikkhave dukkhassa samudayo || || 5 ",
  "sn12.43:3.1": "Sotaṃ ca paṭicca sadde ca || 6 Ghānaṃ ca ",
  "sn12.43:3.2": "paṭicca gandhe ca || 7 Jivhaṃ ",
  "sn12.43:3.3": "ca paṭicca rase ca || 8 ",
  "sn12.43:3.4": "Kāyañca paṭicca phoṭṭhabbe ca || 9 ",
  "sn12.43:3.5": "Manañca paṭicca dhamme ca uppajjati manoviññāṇaṃ || tiṇṇaṃ saṅgatiphasso || ",
  "sn12.43:3.6": "phassapaccayā vedanā || ",
  "sn12.43:3.7": "vedanāpaccayā taṇhā || ",
  "sn12.43:3.8": "Ayaṃ kho bhikkhave dukkhassa samudayo || || 10 ",
  "sn12.43:4.1": "Katamo ca bhikkhave dukkhassa atthaṅgamo || || 11 ",
  "sn12.43:4.2": "Cakkhuṃ ca paṭicca rūpe ca uppajjati cakkhuviññāṇam || tiṇṇaṃ saṅgatiphasso || ",
  "sn12.43:4.3": "phassapaccayā vedanā || ",
  "sn12.43:4.4": "vedanāpaccayā taṇhā || || ",
  "sn12.43:4.5": "Tassāyeva taṇhāya asesavirāganirodhā upādānanirodho || ",
  "sn12.43:4.6": "upādānanirodhā bhavanirodho || ",
  "sn12.43:4.7": "bhavanirodhā jātinirodho || ",
  "sn12.43:4.8": "jātinirodhā jatāmaraṇam sokaparidevadukkhadomanassupāyāsā nirujjhanti || || ",
  "sn12.43:4.9": "Evam etassa kevalassa dukkhakkhandhassa nirodho hoti || || ",
  "sn12.43:4.10": "Ayaṃ kho bhikkhave dukkhassa atthaṅgamo || || 12 ",
  "sn12.43:5.1": "Sotañca paṭicca sadde ca uppajjati sotaviññāṇaṃ || || 13 ",
  "sn12.43:5.2": "Ghānañ ca paṭicca gandhe ca uppajjati ",
  "sn12.43:5.3": "ghānaviññāṇaṃ || 14 Jivhaṃ ca ",
  "sn12.43:5.4": "paṭicca || pe|| 15 ",
  "sn12.43:5.5": "Kāyaṃ ca paṭicca || pe|| 16 Manaṃ ca paṭicca dhamme ca uppajjati manoviññāṇaṃ || tiṇṇam saṅgatiphasso || ",
  "sn12.43:5.6": "phassapaccayā vedanā || ",
  "sn12.43:5.7": "vedanāpaccayā taṇhā || ",
  "sn12.43:5.8": "tassāyeva taṇhāya asesavirāganirodhā upādānanirodho || ",
  "sn12.43:5.9": "upādānanirodhā bhavanirodho || ",
  "sn12.43:5.10": "bhavanirodhā jātinirodho || ",
  "sn12.43:5.11": "jātinirodhā jarāmaraṇaṃ sokaparidevadukkhadomanassupāyāsā nirujjhanti || || ",
  "sn12.43:5.12": "Evam etassa kevalassa dukkhakhandhassa nirodho hoti || || 17 ",
  "sn12.43:5.13": "Ayaṃ kho bhikkhave dukkhassa atthaṅgamo ti || || ",
  "sn12.43:5.14": "Tatiyaṃ || || 1 "
}
