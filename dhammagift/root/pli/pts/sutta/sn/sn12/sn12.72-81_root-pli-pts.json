{
  "sn12.72-81:0.1": "",
  "sn12.72-81:0.2": "",
  "sn12.72-81:0.3": "",
  "sn12.72-81:1.1": "",
  "sn12.72-81:1.2": "Jātiṃ na pajānanti || pe|| || ",
  "sn12.72-81:2.1": "Bhavaṃ na pajānanti || pe|| || ",
  "sn12.72-81:3.1": "Upādānaṃ na pajānanti || pe|| || ",
  "sn12.72-81:4.1": "Taṇhaṃ na pajānanti || pe|| || ",
  "sn12.72-81:5.1": "Vedanaṃ na pajānanti || pe|| || ",
  "sn12.72-81:6.1": "Phassaṃ na pajānanti || pe|| || ",
  "sn12.72-81:7.1": "Saḷāyatanaṃ na pajānanti || pe|| || ",
  "sn12.72-81:8.1": "Nāmarūpaṃ na pajānanti || pe|| || ",
  "sn12.72-81:9.1": "Viññāṇaṃ na pajānanti || pe|| || ",
  "sn12.72-81:10.1": "Saṅkhāre na pajānanti || saṅkhārasamudayam na pajānanti || saṅkhāranirodhaṃ na pajānanti || saṅkhāranirodhagāminiṃ paṭipadaṃ na pajānanti || pe|| || ",
  "sn12.72-81:10.2": "Pajānanti || pe|| || ",
  "sn12.72-81:10.3": "sayam abhiññā sacchikatvā upasampajja viharantīti || || ",
  "sn12.72-81:10.4": "Ekādasamam || || Samaṇabrāhmaṇa-vaggo aṭṭhamo || || ",
  "sn12.72-81:10.5": "",
  "sn12.72-81:11.0": "Tassuddānaṃ || || ",
  "sn12.72-81:11.1": "Paccayekādasā vuttā || ",
  "sn12.72-81:11.2": "catusaccavibhajjanā || ",
  "sn12.72-81:11.3": "Samaṇabrāhmaṇavaggo || nidāne bhavati aṭṭhamaṃ || || Ayaṃ vaggassa uddānaṃ || || ",
  "sn12.72-81:11.4": "",
  "sn12.72-81:12.0": "",
  "sn12.72-81:12.1": "Buddho Āhāra Dasabalaṃ || Kaḷāraṃ ",
  "sn12.72-81:12.2": "Gahapati pañcamam || ",
  "sn12.72-81:12.3": "Rukkhavaggo Mahāvaggo || ",
  "sn12.72-81:12.4": "Aṭṭhamam Samaṇa-brāhmaṇanti || || "
}
