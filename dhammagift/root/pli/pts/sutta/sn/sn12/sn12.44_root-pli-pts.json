  "sn12.44:1.1": "Sāvatthiyaṃ viharati || || 2 ",
  "sn12.44:1.2": "Lokassa bhikkhave samudayañca atthaṅgamañca desissāmi || ",
  "sn12.44:1.3": "Tam suṇātha || pe|| || ",
  "sn12.44:1.4": "I 3 ",
  "sn12.44:1.5": "",
  "sn12.44:2.1": "Katamo ca bhikkhave lokassa samudayo || || 4 ",
  "sn12.44:2.2": "Cakkhuṃ ca paṭicca rūpe ca uppajjati cakkhuviññāṇaṃ || tiṇṇam saṅgatiphasso || ",
  "sn12.44:2.3": "phassapaccayā vedanā || ",
  "sn12.44:2.4": "vedanāpaccayā taṇhā || ",
  "sn12.44:2.5": "taṇhapaccayā upādānaṃ || ",
  "sn12.44:2.6": "upādānapaccayā bhavo || ",
  "sn12.44:2.7": "bhavapaccayā jāti || ",
  "sn12.44:2.8": "jātipaccayā jarāmaraṇaṃ sokaparidevadukkhadomanassupāyāsā sambhavanti || ",
  "sn12.44:2.9": "Ayaṃ lokassa samudayo || || 5 ",
  "sn12.44:3.1": "Sotañca paṭicca sadde ca || pe|| || 6 ",
  "sn12.44:3.2": "Ghānaṃ ca paṭicca gandhe ca || ",
  "sn12.44:3.3": "pe|| || 7 Jivhaṃ ca paṭicca rase ca || ",
  "sn12.44:3.4": "pe|| || 8 Kāyaṃ ca paṭicca poṭṭhabbe ca || || 9 ",
  "sn12.44:3.5": "Manaṃ ca paṭicca dhamme ca uppajjati manoviññāṇam || tiṇṇam saṅgatiphasso || ",
  "sn12.44:3.6": "phassapaccayā vedanā || pe|| ",
  "sn12.44:3.7": "jātipaccayā jarāmaraṇaṃ sokaparidevadukkhadomanassupāyāsā sambhavanti || || ",
  "sn12.44:3.8": "Ayaṃ kho bhikkhave lokassa samudayo || || 10 ",
  "sn12.44:4.1": "Katamo ca bhikkhave lokassa atthaṅgamo || || 11 ",
  "sn12.44:4.2": "Cakkhuṃ ca paṭicca rūpe ca uppajjati cakkhuviññāṇam || tiṇṇaṃ saṅgatiphasso || ",
  "sn12.44:4.3": "phassapaccayā vedanā || ",
  "sn12.44:4.4": "vedanāpaccayā taṇhā || ",
  "sn12.44:4.5": "tassā yeva taṇhāya asesavirāganirodhā upādānanirodho || ",
  "sn12.44:4.6": "upādānanirodhā bhavanirodho || pe || || ",
  "sn12.44:4.7": "evam etassa kevalassa dukkhakkhandhassa nirodho hoti || || ",
  "sn12.44:4.8": "Ayaṃ lokassa atthaṅgamo || || 12 ",
  "sn12.44:5.1": "Sotaṃ ca paṭicca sadde ca || pe|| || 13 ",
  "sn12.44:5.2": "Ghānaṃ ca paṭicca gandhe ca || ",
  "sn12.44:5.3": "pe|| || 14 Jivhaṃ ca paṭicca rase ca || ",
  "sn12.44:5.4": "pe|| || 15 Kāyaṃ ca paṭicca poṭṭhabbe ca || ",
  "sn12.44:5.5": "pe|| || 16 Manaṃ ca paṭicca dhamme ca uppajjati manoviññāṇaṃ || tiṇṇam saṅgatiphasso || ",
  "sn12.44:5.6": "phassapaccayā vedanā || ",
  "sn12.44:5.7": "vedanāpaccayā taṇhā || || ",
  "sn12.44:5.8": "tassāyeva taṇhāya asesavirāganirodhā upādānanirodho || ",
  "sn12.44:5.9": "upādānanirodhā bhavanirodho || pe || || ",
  "sn12.44:5.10": "Evam etassa kevalassa dukkhakkhandhassa nirodho hoti || || 17 ",
  "sn12.44:5.11": "Ayaṃ kho bhikkhave lokassa atthaṅgamoti || || ",
  "sn12.44:5.12": "Catutthaṃ || || 1 "
}
