  "sn12.3:1.1": "Sāvatthiyam viharati || la || 2 ",
  "sn12.3:1.2": "Micchāpaṭipadañca vo bhikkhave desissāmi sammāpaṭipadañca || ",
  "sn12.3:1.3": "taṃ suṇātha sādhukaṃ manasikarotha bhāsissāmīti || || ",
  "sn12.3:1.4": "Evam bhante ti kho te bhikkhū Bhagavato paccassosuṃ || || ",
  "sn12.3:1.5": "Bhagavā etad avoca || 3 ",
  "sn12.3:2.1": "Katamā ca bhikkhave micchapāṭipadā || || ",
  "sn12.3:2.2": "Avijjāpaccayā bhikkhave saṅkhārā || ",
  "sn12.3:2.3": "saṅkhārapaccayā viññāṇaṃ || pe || || ",
  "sn12.3:2.4": "Evam etassa kevalassa dukkhakkhandhassa samudayo hotīti || ",
  "sn12.3:2.5": "ayaṃ vuccati bhikkhave micchāpaṭipadā || || 4 ",
  "sn12.3:3.1": "Katamā ca bhikkhave sammāpaṭipadā || ",
  "sn12.3:3.2": "Avijjāya tveva asesavirāganirodhā saṅkhāranirodho || ",
  "sn12.3:3.3": "saṅkhāranirodhā viññāṇanirodho || la || || ",
  "sn12.3:3.4": "Evam etassa kevalassa dukkhakkhandhassa nirodho hoti || ",
  "sn12.3:3.5": "ayaṃ vuccati bhikkhave sammāpaṭipādā ti || || ",
  "sn12.3:3.6": "Tatiyaṃ || || I 1 "
}
