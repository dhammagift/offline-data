  "sn12.1:0.2": "",
  "sn12.1:0.3": "",
  "sn12.1:1.1": "Samyutta-Nikāya Namo tassa bhagavato arahato sammāsambuddhassa || || 1 Evam me sutaṃ || ",
  "sn12.1:1.2": "ekaṃ samayaṃ Bhagavā Sāvatthiyaṃ viharati Jetavane Anāthapiṇḍikassa ārāme || || 2 ",
  "sn12.1:1.3": "Tatra kho Bhagavā bhikkhū āmantesi ",
  "sn12.1:1.4": "Bhikkhavo ti || ",
  "sn12.1:1.5": "Bhadante ti te bhikkhū Bhagavato paccassosuṃ || || ",
  "sn12.1:1.6": "Bhagavā etad avoca || ",
  "sn12.1:1.7": "Paṭiccasamuppādam vo bhikkhave desissāmi || ",
  "sn12.1:1.8": "tam suṇātha sādhukam manasikarotha bhāsissāmīti || ",
  "sn12.1:1.9": "Evam bhanteti kho te bhikkhū Bhagavato paccassosuṃ || || 3 ",
  "sn12.1:1.10": "Bhagavā etad avoca || ",
  "sn12.1:2.1": "Katamo ca bhikkhave paṭiccasamuppādo || ",
  "sn12.1:2.2": "Avijjāpaccayā bhikkhave saṅkhārā || ",
  "sn12.1:2.3": "saṅkhārapaccayā viññānaṃ || ",
  "sn12.1:2.4": "viññāṇapaccayā nāmarūpaṃ || ",
  "sn12.1:2.5": "nāmarūpapaccayā saḷāyatanaṃ || ",
  "sn12.1:2.6": "saḷāyatanapaccayā phasso || ",
  "sn12.1:2.7": "phassapaccayā vedanā || ",
  "sn12.1:2.8": "vedanāpaccayā taṇhā || ",
  "sn12.1:2.9": "taṇhapaccayā upādānaṃ || ",
  "sn12.1:2.10": "upādānapaccayā bhavo || ",
  "sn12.1:2.11": "bhavapaccayā jāti || ",
  "sn12.1:2.12": "jātipaccayā jarāmaraṇaṃ soka-parideva-dukkhadomanassupāyāsā sambhavanti || ",
  "sn12.1:2.13": "Evam etassa kevalassa dukkhakkhandhassa samudayo hoti || ",
  "sn12.1:2.14": "Ayaṃ vuccati bhikkhave samuppādo || || 4 ",
  "sn12.1:3.1": "Avijjāya tveva asesavirāganirodhā saṅkhāranirodho || ",
  "sn12.1:3.2": "saṅkhāranirodhā viññāṇanirodho || ",
  "sn12.1:3.3": "viññāṇanirodhā nāmarūpanirodho || ",
  "sn12.1:3.4": "nāmarūpanirodhā saḷāyatananirodho || ",
  "sn12.1:3.5": "saḷāyatananirodhā phassanirodho || ",
  "sn12.1:3.6": "phassanirodhā vedanānirodho || ",
  "sn12.1:3.7": "vedanānirodhā taṇhānirodho || ",
  "sn12.1:3.8": "taṇhānirodhā upādānanirodho || ",
  "sn12.1:3.9": "upādānanirodhā bhavanirodho || ",
  "sn12.1:3.10": "bhavanirodhā jātinirodho || ",
  "sn12.1:3.11": "jātinirodhā jarāmaraṇaṃ soka-parideva-dukkha-domanāssupāyāsā nirujjhanti || ",
  "sn12.1:3.12": "Evam etassa kevalassa dukkhakkhandhassa nirodho hotīti || || 5 ",
  "sn12.1:3.13": "Idam avoca Bhagavā || ",
  "sn12.1:3.14": "attamanā te bhikkhū Bhagavato bhāsitam abhinandunti || || ",
  "sn12.1:3.15": "Pathamaṃ || || 1 "
}
