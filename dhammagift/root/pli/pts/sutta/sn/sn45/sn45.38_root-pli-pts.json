  "sn45.38:1.2": "vo bhikkhave desissāmi brahmāññatthañ ca || ",
  "sn45.38:1.3": "taṃ suṇātha || || 4. ",
  "sn45.38:1.4": "Katamañ ca bhikkhave brahmaññaṃ || ",
  "sn45.38:1.5": "ayam eva ariyo aṭṭhaṅgiko maggo || seyyathīdaṃ || ",
  "sn45.38:1.6": "sammāsamādhi || la || sammāsamādhi || || ",
  "sn45.38:1.7": "Idaṃ vuccati bhikkhave brahmaññaṃ || || 5. ",
  "sn45.38:1.8": "Katamo ca bhikkhave brahmaññattho || || ",
  "sn45.38:1.9": "Yo kho bhikkhave rāgakkhayo dosakkhayo mohakkhayo || ",
  "sn45.38:1.10": "ayaṃ vuccati bhikkhave brahmaññattho ti || || 1.2. Sāvatthi || || 3. ",
  "sn45.38:1.11": "Brahmacariyañ ca "
}
