{
  "sn45.98-102:0.1": "",
  "sn45.98-102:0.2": "",
  "sn45.98-102:0.3": "",
  "sn45.98-102:1.1": "Seyyathāpi bhikkhave Yamunā nadī- || 2. ",
  "sn45.98-102:1.2": "",
  "sn45.98-102:1.3": "Seyyāthāpi bhikkhave Acīravatī nadī- || 2. ",
  "sn45.98-102:1.4": "",
  "sn45.98-102:1.5": "Seyyathāpi bhikkhave Sarabhū nadī- || 2. ",
  "sn45.98-102:1.6": "",
  "sn45.98-102:1.7": "Seyyathāpi bhikkhave Mahī nadī- || 2. ",
  "sn45.98-102:1.8": "",
  "sn45.98-102:1.9": "Seyyathāpi bhikkhave yā kāci mahānadiyo || seyyatthīdaṃ ",
  "sn45.98-102:1.10": "Gaṅgā Yamunā Acīravatī Sarabhū Mahī || sabbā tā samuddaninnā samuddapoṇā samuddapabbhārā || ",
  "sn45.98-102:1.11": "evam eva kho bhikkhave bhikkhu- ",
  "sn45.98-102:1.12": "-nibbānapabbhāro || || 3. ",
  "sn45.98-102:1.13": "Idha bhikkhave bhikkhu- a- a- ",
  "sn45.98-102:1.14": "maggam bahulīkaronto nibbānapoṇo nibbānaninno hoti nibbānapabbhāro ti || || ",
  "sn45.98-102:1.15": "",
  "sn45.98-102:1.16": "Gaṅgāpeyyālo || || ",
  "sn45.98-102:2.0": "",
  "sn45.98-102:2.1": "Cha pācīnato ninnā || ",
  "sn45.98-102:2.2": "Cha ninnā ca samuddato || ",
  "sn45.98-102:2.3": "Ete dve cha dvādasa honti || ",
  "sn45.98-102:2.4": "peyyālī tena vuccatī ti || || ",
  "sn45.98-102:2.5": "Gaṅgāpeyyalī pācīnaninnā pācīnamaggi || ",
  "sn45.98-102:2.6": "Vivekanissitaṃ dvādasakī paṭhamakī || || 3. "
}
