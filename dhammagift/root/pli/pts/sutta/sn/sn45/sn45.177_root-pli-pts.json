  "sn45.177:0.3": "",
  "sn45.177:1.1": "Pañcimāni bhikkhave nivaraṇāni || ",
  "sn45.177:1.2": "katamānipañca || || ",
  "sn45.177:1.3": "Kāmacchandanīvaraṇaṃ vyāpādanīvaraṇaṃ thīnamiddhanīvaraṇam addhaccakukkuccanīvaraṇaṃ vicikicchānīvaraṇaṃ || ",
  "sn45.177:1.4": "imāni kho bhikkhave pañca nīvaraṇāni || || ",
  "sn45.177:1.5": "Imesaṃ kho bhikkhave pañcannaṃ nīvaraṇānam abhiññāya pariññāya parikkhayāya pahānāya || la || ayam ariyo aṭṭhaṅgiko maggo bhāvetabbo ",
  "sn45.177:1.6": "ti || || 2--33. "
}
