  "sn45.35:0.3": "",
  "sn45.35:1.1": "",
  "sn45.35:1.2": "Sāmaññañca vo bhikkhave desissāmi sāmaññaphalāni ca || ",
  "sn45.35:1.3": "taṃ suṇātha || || 4. ",
  "sn45.35:1.4": "Katamañca bhikkhave sāmaññaṃ || || ",
  "sn45.35:1.5": "Ayam eva ariyo aṭṭhaṅgiko maggo || || Seyyathīdaṃ || ",
  "sn45.35:1.6": "sammādiṭṭhi || la || sammāsamādhi || || ",
  "sn45.35:1.7": "Idaṃ vuccati bhikkhave sāmaññaṃ || || 5. ",
  "sn45.35:1.8": "Katamāni ca bhikkhave sāmaññaphalāni || || ",
  "sn45.35:1.9": "Sotāpattiphalaṃ sakadāgāmiphalam anāgāmiphalam arahattaphalaṃ || || ",
  "sn45.35:1.10": "Imāni vuccanti bhikkhave sāmaññaphalānī ti || || 1.2. ",
  "sn45.35:1.11": "Sāvatthi || || 3. "
}
