  "sn45.64-68:1.1": "Ekadhammo bhikkhave bahupakāro ariyassa aṭṭhaṅgikassa uppādāya || || ",
  "sn45.64-68:1.2": "Katamo ca ekadhammo || ",
  "sn45.64-68:1.3": "yad idaṃ sīlasampadā || la || || 2. -yad ",
  "sn45.64-68:1.4": "idaṃ chandasampadā || la || || 2. -yad ",
  "sn45.64-68:1.5": "idam attasampadā || la || || 2. -yad ",
  "sn45.64-68:1.6": "idaṃ diṭṭhisampadā || la || || 2. -yad ",
  "sn45.64-68:1.7": "idam appamādasampadā || la || || 2. -yad ",
  "sn45.64-68:1.8": "idaṃ yonisomanasikārasampadā || || 3. "
}
