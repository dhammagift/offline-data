  "sn45.22:1.1": "",
  "sn45.22:1.2": "Akusale ca vo bhikkhave dhamme desissāmi kusale ca dhamme || ",
  "sn45.22:1.3": "tam suṇātha || || 4. ",
  "sn45.22:1.4": "Katame ca bhikkhave akusalā dhammā || ",
  "sn45.22:1.5": "seyyathīdaṃ || Micchādiṭṭhi || pa || micchāsamādhi || || ",
  "sn45.22:1.6": "Ime vuccanti bhikkhave kusalā dhammā ti || || 5. ",
  "sn45.22:1.7": "Katame- -kusalā dhammā- ",
  "sn45.22:1.8": "-Sammādiṭṭhi || pa || sammāsamādhi || || ",
  "sn45.22:1.9": "Ime- -kusalā dhammā ti || || 1.2. ",
  "sn45.22:1.10": "Sāvatthi || || Tatravoca || || 3. "
}
