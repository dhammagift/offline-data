  "sn45.32:1.2": "vo bhikkhave desissāmi sammāpaṭipannañ ca || ",
  "sn45.32:1.3": "taṃ suṇātha || || 3. ",
  "sn45.32:1.4": "Katamo ca bhikkhave micchāpaṭipanno || || ",
  "sn45.32:1.5": "Idha bhikkhave ekacco micchādiṭṭhiko hoti || la [||pe ||] micchāsamādhi || || ",
  "sn45.32:1.6": "Ayam vuccati micchāpaṭipanno || || 4. ",
  "sn45.32:1.7": "Katamo ca bhikkhave sammāpaṭipanno || || ",
  "sn45.32:1.8": "Idha bhikkhave ekacco sammādiṭṭhiko hoti || la || sammāsamādhi || || ",
  "sn45.32:1.9": "Ayaṃ vuccati bhikkhave sammāpaṭipanno ti || || 1.2. ",
