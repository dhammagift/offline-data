  "sn45.37:1.1": "",
  "sn45.37:1.2": "vo bhikkhave desissāmi brahmaññaphalāni ca || ",
  "sn45.37:1.3": "taṃ suṇātha || || 4. ",
  "sn45.37:1.4": "Katamañca kho bhikkhave brahmaññaṃ || ",
  "sn45.37:1.5": "ayam eva ariyo aṭṭhaṅgiko maggo || seyyathīdam || ",
  "sn45.37:1.6": "sammādiṭṭhi || la || sammāsamādhi || || ",
  "sn45.37:1.7": "Idam vuccati bhikkhave brahmaññaṃ || || 5. ",
  "sn45.37:1.8": "Katamāni ca bhikkhave brahmaññaphalāni || || ",
  "sn45.37:1.9": "Sotāpattiphalaṃ sakadāgamiphalam anāgāmiphalam arahattaphalaṃ || || ",
  "sn45.37:1.10": "Imāni vuccanti bhikkhave brahmaññaphalānī ti || || 1.2. Sāvatthi || || 3. ",
  "sn45.37:1.11": "Brahmaññañ ca "
}
