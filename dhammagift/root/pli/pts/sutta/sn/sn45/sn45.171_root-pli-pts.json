  "sn45.171:1.1": "Sāvatthinidānam || || 2. ",
  "sn45.171:1.2": "Cattāro me bhikkhave oghā || ",
  "sn45.171:1.3": "katame cattāro || || ",
  "sn45.171:1.4": "Kāmogho bhavogho diṭṭhogho avijjogho || || ",
  "sn45.171:1.5": "ime kho bhikkhave cattāro oghā || || ",
  "sn45.171:1.6": "Imesaṃ kho bhikkhave catunnam oghānam abhiññāya pariññaya parikkhayāya pahānāya || la || ayam ariyo aṭṭhaṅgiko maggo bhāvetabbo ti || || 3--33. ",
  "sn45.171:1.7": "Yathā esanā evaṃ vitthāretabbaṃ || || 2--33. ",
  "sn45.171:1.8": "Cattāro me "
}
