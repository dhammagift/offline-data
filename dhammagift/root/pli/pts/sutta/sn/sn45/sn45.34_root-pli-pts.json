{
  "sn45.34:0.1": "",
  "sn45.34:0.2": "",
  "sn45.34:0.3": "",
  "sn45.34:1.1": "",
  "sn45.34:1.2": "Aṭṭhime bhikkhave dhammā bhāvitā bahulīkatā apārāpāraṅgamanāya saṃvattanti || || ",
  "sn45.34:1.3": "Katame aṭṭha || || ",
  "sn45.34:1.4": "Seyyathīdaṃ || sammādiṭṭhi || la || sammāsamādhi || || ",
  "sn45.34:1.5": "Ime kho bhikkhave aṭṭha dhammā bhāvitā bahulīkatā apārāpāraṃ gamanāya saṃvattantī ti || || 4. ",
  "sn45.34:2.1": "Idam avoca Bhagavā || ",
  "sn45.34:2.2": "idaṃ vatvā Sugato athāparaṃ etad avoca satthā || || ",
  "sn45.34:3.1": "Appakā te manussesu || ",
  "sn45.34:3.2": "ye janā pāragāmino || ",
  "sn45.34:3.3": "athāyam itarā pajā || ",
  "sn45.34:3.4": "tīram evānudhāvati || || () ",
  "sn45.34:4.1": "Ye ca kho sammadakkhāte || ",
  "sn45.34:4.2": "dhamme dhammānuvattino || ",
  "sn45.34:4.3": "te janā pāram essanti || ",
  "sn45.34:4.4": "maccudheyyaṃ suduttaraṃ || || (2) ",
  "sn45.34:5.1": "Kaṇhaṃ dhammam vippahāya || ",
  "sn45.34:5.2": "kaṇham bhāvetha paṇḍito || ",
  "sn45.34:5.3": "Okā anokam āgamma || ",
  "sn45.34:5.4": "viveke yattha dūramam || || (3) ",
  "sn45.34:6.1": "Tatrābhiratiṃ iccheyya || ",
  "sn45.34:6.2": "hitvā kāme akiñcano || ",
  "sn45.34:6.3": "pariyodapeyya attānaṃ || ",
  "sn45.34:6.4": "cittakilesehi 10 paṇḍito || || (4) ",
  "sn45.34:7.1": "Yesaṃ sambodhiyaṅgesu || ",
  "sn45.34:7.2": "sammācittaṃ subhāvitaṃ || ",
  "sn45.34:7.3": "ādānapaṭinissagge || ",
  "sn45.34:7.4": "anupādāya ye ratā || || ",
  "sn45.34:7.5": "Khīṇāsavā jutimanto || ",
  "sn45.34:7.6": "te loke parinibbutā ti || () || 1.2. ",
  "sn45.34:7.7": "Sāvatthi || || 3. "
}
