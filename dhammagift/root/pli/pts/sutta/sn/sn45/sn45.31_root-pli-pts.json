  "sn45.31:1.1": "Sāvatthinidānaṃ || || Tatravoca || || 3. ",
  "sn45.31:1.2": "Micchāpaṭipattiñca vo bhikkhave desissāmi sammāpaṭipattiñca || ",
  "sn45.31:1.3": "taṃ suṇātha || || ",
  "sn45.31:1.4": "Katamā ca bhikkhave micchāpaṭipatti || || ",
  "sn45.31:1.5": "Seyyathīdaṃ || micchādiṭṭhi || la [pe] || micchāsamādhi || || ",
  "sn45.31:1.6": "Ayam vuccati bhikkhave micchāpaṭipatti || || 4. ",
  "sn45.31:1.7": "Katamā ca bhikkhave sammāpaṭipatti || || ",
  "sn45.31:1.8": "Seyyathīdaṃ || sammādiṭṭhi || la [pe] || sammāsamādhi || || ",
  "sn45.31:1.9": "Ayam vuccati bhikkhave sammāpaṭipattī ti || || 1.2. Sāvatthi || || ",
  "sn45.31:1.10": "Tatravoca || || 3. Micchāpaṭipannañ ca "
}
