  "sn45.40:1.1": "",
  "sn45.40:1.2": "vo bhikkhave desissāmi brahmacariyatthañ ca || || ",
  "sn45.40:1.3": "taṃ suṇātha || || 4. ",
  "sn45.40:1.4": "Katamañ ca bhikkhave brahmacariyaṃ || ",
  "sn45.40:1.5": "ayam eva ariyo aṭṭhaṅgiko maggo || seyyathīdaṃ || ",
  "sn45.40:1.6": "sammādiṭṭhi || la || sammāsamādhi || || ",
  "sn45.40:1.7": "Idaṃ vuccati bhikkhave brahmacariyaṃ || || 5. ",
  "sn45.40:1.8": "Katamo ca bhikkhave brahmacariyattho || ",
  "sn45.40:1.9": "Yo kho bhikkhave rāgakkhayo dosakkhayo mohakkhayo || || ",
  "sn45.40:1.10": "Ayaṃ vuccati bhikkhave brahmacariyatthoti || || ",
  "sn45.40:1.11": "Sabbam eva Sāvatthinidānaṃ || || ",
  "sn45.40:1.12": "",
  "sn45.40:2.0": "",
  "sn45.40:2.1": "Paṭipatti Patipanno ca || || ",
  "sn45.40:2.2": "Viraddhañ ca Pāraṅgamā || ",
  "sn45.40:2.3": "Sāmaññena dve vuttā || ",
  "sn45.40:2.4": "Brahmaññā aparo duve || ",
  "sn45.40:2.5": "Brahmacariyena dve vuttā || ",
  "sn45.40:2.6": "Vaggo tena pavuccatī ti || || 1. "
}
