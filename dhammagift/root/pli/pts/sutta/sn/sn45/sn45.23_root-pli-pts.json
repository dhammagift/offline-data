  "sn45.23:1.1": "",
  "sn45.23:1.2": "Micchāpaṭipadañca vo bhikkhave desissāmi sammāpaṭipadañca || ",
  "sn45.23:1.3": "taṃ suṇātha || || 4. ",
  "sn45.23:1.4": "Katamā ca bhikkhave micchāpaṭipadā || || ",
  "sn45.23:1.5": "Seyyathīdaṃ || micchādiṭṭhi || pa [pe] || micchāsamādhi || || ",
  "sn45.23:1.6": "Ayaṃ vuccati bhikkhave micchāpaṭipadā || || 5. ",
  "sn45.23:1.7": "Katamā ca bhikkhave sammāpaṭipadā || || ",
  "sn45.23:1.8": "Seyyathīdam || sammādiṭṭhi || pa [pe] || sammāsamādhi || || ",
  "sn45.23:1.9": "Ayaṃ vuccati bhikkhave sammāpaṭipadā ti || || 1.2. ",
  "sn45.23:1.10": "Sāvatthi || || Tatravoca || || 3. "
}
