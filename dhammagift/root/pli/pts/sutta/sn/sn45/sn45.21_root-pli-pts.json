  "sn45.21:1.1": "Sāvatthinidānaṃ || || 3. ",
  "sn45.21:1.2": "Micchatañ ca vo bhikkhave desissāmi sammattañ ca || ",
  "sn45.21:1.3": "taṃ suṇātha || || 4. ",
  "sn45.21:1.4": "Katamañ ca bhikkhave micchattaṃ || || ",
  "sn45.21:1.5": "Seyyathīdaṃ || micchādiṭṭhi || pa || micchāsamādhi || || ",
  "sn45.21:1.6": "Idaṃ vuccati bhikkhave micchattaṃ || || 5. ",
  "sn45.21:1.7": "Katamañca bhikkhave sammattam || || ",
  "sn45.21:1.8": "Seyyathīdaṃ || sammādiṭṭhi || pa || sammāsamādhi || || ",
  "sn45.21:1.9": "Idaṃ vuccati bhikkhave sammattan ti || || 1.2. ",
  "sn45.21:1.10": "Sāvatthi || || Tatravoca || || 3. "
}
