  "sn6.13:0.2": "",
  "sn6.13:0.3": "",
  "sn6.13:1.1": "Ekaṃ samayaṃ Bhagavā Magadhesu viharati Andhakavinde || || 2. ",
  "sn6.13:1.2": "Tena kho pana samayena Bhagavā rattandhakāratimisāyam ajjhokāse nisinno hoti devo ca ekam ekaṃ phusāyati || || 3. ",
  "sn6.13:1.3": "Atha kho Brahmā sahampati abhikkantāya rattiyā abhikkantavaṇṇo kevalakappaṃ Andhakavindam obhāsetvā yena Bhagavā ten-upasaṅkami || upasaṅkamitvā Bhagavantam abhivādetvā ekam antam aṭṭhāsi || || 4. ",
  "sn6.13:1.4": "Ekam antaṃ ṭhito kho Brahmā sahampati Bhagavato santike imā gāthayo abhāsi || || ",
  "sn6.13:2.1": "Sevetha pantāni senāsanāni || ",
  "sn6.13:2.2": "careyya saṃyojanavippamokkhā || ",
  "sn6.13:2.3": "sa ce ratiṃ nādhigacchaye tattha || ",
  "sn6.13:2.4": "saṅghe vase rakkhitatto satimā || || ",
  "sn6.13:3.1": "Kulā kulaṃ piṇḍikāya caranto || ",
  "sn6.13:3.2": "indriyagutto nipako satimā || ",
  "sn6.13:3.3": "sevetha pantāni senāsanāni || ",
  "sn6.13:3.4": "bhayā pamutto abhaye vimutto || || ",
  "sn6.13:4.1": "Yattha bheravā siriṃsapā || ",
  "sn6.13:4.2": "vijju sañcarati thaneti devo || ",
  "sn6.13:4.3": "andhakāra-timisāya rattiyā || ",
  "sn6.13:4.4": "nisīdi tattha bhikkhu vigatalomahaṃso || || ",
  "sn6.13:5.1": "Idaṃ hi jātu me diṭṭham || ",
  "sn6.13:5.2": "na yidam iti hītihaṃ || ",
  "sn6.13:5.3": "ekasmiṃ brahmacariyasmiṃ || ",
  "sn6.13:5.4": "sahassam maccuhāyinam || || ",
  "sn6.13:6.1": "Bhīyo pañcasatā sekhā || ",
  "sn6.13:6.2": "dasā ca dasadhā sataṃ || || ",
  "sn6.13:6.3": "sabbe sotasamāpannā || ",
  "sn6.13:6.4": "atiracchānagāmino || ",
  "sn6.13:7.1": "Athāyam itarā pajā || ",
  "sn6.13:7.2": "puññabhāgā ti me mano || ",
  "sn6.13:7.3": "saṅkhātuṃ no pi sakkomi || ",
  "sn6.13:7.4": "musāvādassa ottappeti || || 1. "
}
