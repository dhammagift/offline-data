  "sn43.2:1.1": "vo bhikkhave desissāmi asaṅkhatagāmiñca maggaṃ || ",
  "sn43.2:1.2": "taṃ suṇātha || || 2 ",
  "sn43.2:1.3": "Katamañca bhikkhave asaṅkhataṃ || || ",
  "sn43.2:1.4": "Yo bhikkhave rāgakkhayo dosakkhayo mohakkhayo || ",
  "sn43.2:1.5": "idaṃ vuccati bhikkhave asaṅkhataṃ || || 3 ",
  "sn43.2:1.6": "Katamo ca bhikkhave asaṅkhatagāmi maggo || || ",
  "sn43.2:1.7": "Samatho vipassanā ca || ",
  "sn43.2:1.8": "ayam vuccati bhikkhave asaṅkhatagāmi maggo || ",
  "sn43.2:1.9": "la || || 3 1 "
}
