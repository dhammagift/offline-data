  "sn43.44:0.1": "",
  "sn43.44:0.2": "",
  "sn43.44:0.3": "",
  "sn43.44:1.1": "Parāyanañca vo bhikkhave desissāmi parāyanagāmiñca maggaṃ || ",
  "sn43.44:1.2": "tam suṇātha || || 2 ",
  "sn43.44:1.3": "Katamañca bhikkhave parāyanaṃ || || ",
  "sn43.44:1.4": "Yo bhikkhave rāgakkhayo dosakkhayo mohakkhayo || ",
  "sn43.44:1.5": "idaṃ vuccati bhikkhave parāyaṇaṃ || || 3 ",
  "sn43.44:1.6": "Katamo ca bhikkhave parāyanagāmi maggo || || ",
  "sn43.44:1.7": "Kāyagatā sati || ",
  "sn43.44:1.8": "ayaṃ vuccati bhikkhave parāyanagāmi maggo || || 4 ",
  "sn43.44:1.9": "Iti kho bhikkhave desitaṃ vo mayā parāyanaṃ desito parāyanagāmi maggo || || 5 ",
  "sn43.44:1.10": "Yam bhikkhave satthārā karaṇiyaṃ sāvakānaṃ hitesinā anukampena anukampam upādāya kataṃ vo tam mayā || || 6 ",
  "sn43.44:1.11": "Etāni bhikkhave rukkhamulāni etāni suññāgārāni jāyatha bhikkhave mā pamādattha mā pacchāvippatisārino ahuvattha || ayaṃ vo amhākam anusāsanīti || || ",
  "sn43.44:1.12": "Yathā asaṅkhataṃ tathā vitthāretabbaṃ || || ",
  "sn43.44:1.13": "",
  "sn43.44:1.14": "",
  "sn43.44:2.0": "",
  "sn43.44:2.1": "Asaṅkhatam Antam Anāsavaṃ || ",
  "sn43.44:2.2": "Saccañca Pāraṃ Nipuṇaṃ Sududdasaṃ || ",
  "sn43.44:2.3": "Ajajjarantaṃ Dhuvam Apalokitaṃ || || ",
  "sn43.44:2.4": "Anidassanaṃ Nippapañca Santaṃ || || ",
  "sn43.44:3.1": "Amataṃ Paṇītañca Sivañca Khemam || ",
  "sn43.44:3.2": "Taṇhakkhayo Acchariyañca Abbhutam || ",
  "sn43.44:3.3": "Anītikam Anītikadhammaṃ ",
  "sn43.44:3.4": "Nibbānam etaṃ Sugatena desitaṃ || || ",
  "sn43.44:4.1": "Avyāpajjo Virāgoca || ",
  "sn43.44:4.2": "Suddhi Mutti Anālayo || ",
  "sn43.44:4.3": "Dīpaṃ Leṇañca Tāṇañca || ",
  "sn43.44:4.4": "Saraṇañca Parāyanan ti- || || ",
  "sn43.44:4.5": "Asaṅkhatasaṃyuttaṃ samattaṃ || || 1 "
}
