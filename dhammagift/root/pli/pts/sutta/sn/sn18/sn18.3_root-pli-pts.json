  "sn18.3:1.1": "",
  "sn18.3:1.2": "Taṃ kiṃ maññasi Rāhula || || ",
  "sn18.3:1.3": "Cakkhuviññāṇaṃ niccaṃ vā aniccaṃ vāti || || ",
  "sn18.3:1.4": "Aniccam bhante || || 3-6 ",
  "sn18.3:1.5": "Sotaviññāṇam || ",
  "sn18.3:1.6": "Ghānaviññāṇam || ",
  "sn18.3:1.7": "Jivhāviññāṇam || ",
  "sn18.3:1.8": "Kāyaviññāṇaṃ || 7 ",
  "sn18.3:1.9": "Manoviññāṇam niccaṃ vā aniccaṃ vāti || || ",
  "sn18.3:1.10": "Aniccaṃ bhante || || 8 ",
  "sn18.3:1.11": "Evam passaṃ Rāhula sutavā ariyasāvako cakkhuviññāṇasmim pi nibbindati || Sotaviññāṇasmim pi nibbindati || Ghānaviññāṇasmim pi || || Jivhāviññāṇasmim pi || || Kāyaviññāṇasmim pi || || Manoviññāṇasmim pi nibbindati || || 9 ",
  "sn18.3:1.12": "Nibbindaṃ virajjati || pe|| ",
  "sn18.3:1.13": "pajānātīti || || ",
  "sn18.3:1.14": "Tatiyaṃ || || 1 Sāvatthi || || 2 "
}
