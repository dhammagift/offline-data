  "sn18.6:1.2": "Taṃ kim maññasi Rāhula || || ",
  "sn18.6:1.3": "Rūpasaññā niccā vā aniccā vāti || || ",
  "sn18.6:1.4": "Aniccā bhante || || 3-7 ",
  "sn18.6:1.5": "Saddasaññā || ",
  "sn18.6:1.6": "Gandhasaññā || ",
  "sn18.6:1.7": "Rasasaññā || ",
  "sn18.6:1.8": "Poṭṭhabbasaññā || ",
  "sn18.6:1.9": "Dhammasaññā niccā vā aniccā vāti || || ",
  "sn18.6:1.10": "Aniccā bhante || || 8-9 ",
  "sn18.6:1.11": "Evam passaṃ Rāhula sutavā ariyasāvako rūpasaññāya pi nibbindati || saddasaññāya pi || gandhasaññāya pi || rasasaññāya pi || poṭṭhabbasaññāya pi || dhammasaññāya pi nibbindati || pe|| ",
  "sn18.6:1.12": "pajānātīti || || ",
  "sn18.6:1.13": "Chaṭṭhaṃ || || 1 Sāvatthi || || 2 "
