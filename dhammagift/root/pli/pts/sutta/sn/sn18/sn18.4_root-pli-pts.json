  "sn18.4:1.2": "Taṃ kiṃ maññasī Rāhula || || ",
  "sn18.4:1.3": "Cakkhusamphasso nicco vā anicco vāti || ",
  "sn18.4:1.4": "Anicco bhante || || 3-7 ",
  "sn18.4:1.5": "Sotasamphasso || ",
  "sn18.4:1.6": "Ghānasamphasso || ",
  "sn18.4:1.7": "Jivhāsamphasso || ",
  "sn18.4:1.8": "kāyasamphasso || ",
  "sn18.4:1.9": "Manosamphasso nicco vā anicco vāti || || ",
  "sn18.4:1.10": "Anicco bhante || || 8 ",
  "sn18.4:1.11": "Evam passaṃ Rāhula sutavā ariyasāvako cakkhusamphassasmim pi nibbindati || sotasamphassasmim pi || ghānasamphassasmim pi || jivhāsamphassasmiṃ pi || kāyasamphassasmim pi || manosamphassasmim pi nibbindati || || 9 ",
  "sn18.4:1.12": "Nibbindaṃ virajati || pe|| || ",
  "sn18.4:1.13": "pajānātīti || || ",
  "sn18.4:1.14": "Catutthaṃ || || 1 Sāvatthi || || 2 "
