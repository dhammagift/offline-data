  "sn10.2:0.1": "",
  "sn10.2:0.2": "",
  "sn10.2:0.3": "",
  "sn10.2:1.1": "Ekaṃ samayaṃ Bhagavā Rājagahe viharati Gijjhakūṭe pabbate || 2. ",
  "sn10.2:1.2": "Atha kho Sakka-nāmako yakkho yena Bhagavā tenupasaṅkami || upasaṅkamitvā Bhagavantaṃ gāthāya ajjhabhāsi || || ",
  "sn10.2:2.1": "Sabbaganthapahīnassa || ",
  "sn10.2:2.2": "vippamuttassa te sato || ",
  "sn10.2:2.3": "samaṇassa na taṃ sādhu || ",
  "sn10.2:2.4": "yad aññam anusāsatī ti || || 3. ",
  "sn10.2:3.1": "Yena kenaci vaṇṇena || ",
  "sn10.2:3.2": "saṃvāso Sakka jāyati || ",
  "sn10.2:3.3": "na tam arahati sappañño || ",
  "sn10.2:3.4": "manasā anukampituṃ || || ",
  "sn10.2:4.1": "manasā ce pasannena || ",
  "sn10.2:4.2": "yad aññam anusāsati || ",
  "sn10.2:4.3": "na tena hoti saṃyutto || ",
  "sn10.2:4.4": "sānukampā anuddayā ti || || 1. "
}
