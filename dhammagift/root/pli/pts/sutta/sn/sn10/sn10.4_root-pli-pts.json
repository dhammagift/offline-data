  "sn10.4:0.3": "",
  "sn10.4:1.1": "Ekaṃ samayam Bhagavā Magadhesu viharati Maṇimālake cetiye Maṇibhaddassa yakkhassa bhavane || || 2. ",
  "sn10.4:1.2": "Atha kho Maṇibhaddo yakkho yena Bhagavā ten-upasaṅkami || upasaṅkamitvā Bhagavato santike imaṃ gātham abhāsi || || ",
  "sn10.4:2.1": "[Satimato sadā bhaddaṃ || ",
  "sn10.4:2.2": "satimā sukham edhati || ",
  "sn10.4:2.3": "satimato su ve seyyo || ",
  "sn10.4:2.4": "verā ca parimuccatī ti] || || 3. ",
  "sn10.4:3.1": "Satimato sadā bhaddaṃ || ",
  "sn10.4:3.2": "satimā sukham edhati || ",
  "sn10.4:3.3": "satimato su ve seyyo || ",
  "sn10.4:3.4": "verā na parimuccati || || ",
  "sn10.4:4.1": "yassa sabbam ahorattam || ",
  "sn10.4:4.2": "ahiṃsāya rato mano || ",
  "sn10.4:4.3": "mettaṃ so sabbabhūtesu || ",
  "sn10.4:4.4": "veraṃ tassa na kenacī ti || || 1. "
}
