  "sn10.12:1.1": "Evam me sutam ",
  "sn10.12:1.2": "ekaṃ samayam Bhagavā Āḷaviyam viharati Āḷavakassa yakkhassa bhavane || || 2. ",
  "sn10.12:1.3": "Atha kho Āḷavako yakkho Bhagavantam etad avoca || || ",
  "sn10.12:1.4": "Nikkhama samaṇā ti || || ",
  "sn10.12:1.5": "Sādhāvuso ti Bhagavā nikkhami || || ",
  "sn10.12:1.6": "Pavisa samaṇā ti || ",
  "sn10.12:1.7": "Sādhāvuso ti Bhagavā pāvisi || || 3. ",
  "sn10.12:1.8": "Dutiyam pi kho Āḷavako yakkho Bhagavantam etad avoca || || ",
  "sn10.12:1.9": "Nikkhama samaṇā ti || || ",
  "sn10.12:1.10": "Sādhāvusoti Bhagavā nikkhami || || ",
  "sn10.12:1.11": "Pavisa samaṇā ti || || ",
  "sn10.12:1.12": "Sādhāvusoti Bhagavā pāvisi || || 4. ",
  "sn10.12:1.13": "Tatiyam pi kho Āḷavako yakkho Bhagavantam etad avoca || || ",
  "sn10.12:1.14": "Nikkhama samaṇā ti || || ",
  "sn10.12:1.15": "Sādhāvuso ti Bhagavā nikkhami || || ",
  "sn10.12:1.16": "Pavisa samaṇāti || || ",
  "sn10.12:1.17": "Sādhāvuso ti Bhagavā pāvisi || || 5. ",
  "sn10.12:1.18": "Catuttham pi kho Āḷavako yakkho Bhagavantam etad avoca || || ",
  "sn10.12:1.19": "Nikkhama samaṇā ti || || 6. ",
  "sn10.12:1.20": "Na kho panāham āvuso nikkhamissāmi || ",
  "sn10.12:1.21": "yan-te karaṇīyaṃ taṃ karohīti || || 7. ",
  "sn10.12:1.22": "Pañhaṃ taṃ samaṇa pucchissāmi || ",
  "sn10.12:1.23": "sace me na karissasi cittam vā te khipissāmi hadayaṃ vā te phālessāmi pādesu vā gahetvā pāraganāya khipissāmīti || || 8. ",
  "sn10.12:1.24": "Na khvāhan-tam āvuso passāmi sadevake loke samārake sabrahmake sassamaṇa-brāhmaṇiyā pajāya sadevamanussāya yo me cittam vā khipeyya hadayaṃ vā phāleyya pādesu vā gahetvā pāragaṅgāya khippeya || ",
  "sn10.12:1.25": "api ca tvam āvuso puccha yad ākaṅkhasīti || || 9. ",
  "sn10.12:2.1": "Kiṃsūdha vittam purisassa seṭṭhaṃ || ",
  "sn10.12:2.2": "kiṃsu suciṇṇam sukham āvahāti || ",
  "sn10.12:2.3": "kiṃsu have sādutaraṃ rasānam || ",
  "sn10.12:2.4": "kathaṃ jīviṃ jīvitam āhu seṭṭhan ti || || 10. ",
  "sn10.12:3.1": "Saddhidha vittam purisassa seṭṭhaṃ || ",
  "sn10.12:3.2": "dhammo suciṇṇo sukham āvahāti || ",
  "sn10.12:3.3": "saccam have sādutaraṃ rasānaṃ || ",
  "sn10.12:3.4": "paññājīviṃ jīvitam āhu seṭṭhanti || || 11. ",
  "sn10.12:4.1": "Kathaṃ su tarati oghaṃ || ",
  "sn10.12:4.2": "kathaṃ su tarati aṇṇavaṃ || ",
  "sn10.12:4.3": "kathaṃ su dukkham acceti || ",
  "sn10.12:4.4": "kathaṃ su parisujjhatī ti || || 12. ",
  "sn10.12:5.1": "Saddhāya tarati oghaṃ || ",
  "sn10.12:5.2": "appamādena aṇṇavaṃ || ",
  "sn10.12:5.3": "viriyena dukkham acceti || ",
  "sn10.12:5.4": "paññāya parisujjhati || || 13. ",
  "sn10.12:6.1": "Kathaṃ su labhate paññaṃ || ",
  "sn10.12:6.2": "kathaṃ su vindate dhanaṃ || || ",
  "sn10.12:6.3": "kathaṃ su kittim pappoti || ",
  "sn10.12:6.4": "katham mittāni ganthati || ",
  "sn10.12:6.5": "asmā lokā paraṃ lokaṃ || ",
  "sn10.12:6.6": "katham pecca na socatīti || || 14. ",
  "sn10.12:7.1": "Saddahāno arahataṃ || ",
  "sn10.12:7.2": "dhammaṃ nibbānapattiyā || ",
  "sn10.12:7.3": "sussūsā labhate paññaṃ || ",
  "sn10.12:7.4": "appamatto vicakkhaṇo || || ",
  "sn10.12:8.1": "Paṭirūpakārī dhuravā || ",
  "sn10.12:8.2": "uṭṭhātā vindate dhanaṃ || ",
  "sn10.12:8.3": "saccena kittim pappoti || ",
  "sn10.12:8.4": "dadaṃ mittāni ganthati || || ",
  "sn10.12:8.5": "asmā lokā paraṃ lokaṃ || ",
  "sn10.12:8.6": "evam pecca na socati || || ",
  "sn10.12:9.1": "Yass-ete caturo dhammā || ",
  "sn10.12:9.2": "saddhassa gharam esino || ",
  "sn10.12:9.3": "saccam damo dhiti cāgo || ",
  "sn10.12:9.4": "sa ve pecca na socati || ",
  "sn10.12:10.1": "asmā lokā paraṃ lokaṃ || evam pecca na socati || || Iṅgha aññe pi pucchassa || ",
  "sn10.12:10.2": "puthu-samaṇa-brāhmaṇe || ",
  "sn10.12:10.3": "yadi saccā damā cāgā || ",
  "sn10.12:10.4": "khantyā bhiyyo dha vijjatīti || || 15. ",
  "sn10.12:11.1": "Kathaṃ nu dāni puccheyyaṃ || ",
  "sn10.12:11.2": "puthu-samaṇa-brāhmaṇe || ",
  "sn10.12:11.3": "yo haṃ ajja pajānāmi || ",
  "sn10.12:11.4": "yo attho samparāyiko || || ",
  "sn10.12:12.1": "atthāya vata me buddho || ",
  "sn10.12:12.2": "vāsāyāḷavim āgato || ",
  "sn10.12:12.3": "yo ham ajja pajānāmi || ",
  "sn10.12:12.4": "yattha dinnam mahapphalaṃ || || ",
  "sn10.12:13.1": "so ahaṃ vicarissāmi || ",
  "sn10.12:13.2": "gāmā gāmaṃ purā puraṃ || ",
  "sn10.12:13.3": "namassamāno sambuddham || ",
  "sn10.12:13.4": "dhammassa ca sudhammatan ti || || ",
  "sn10.12:13.5": "",
  "sn10.12:14.0": "",
  "sn10.12:14.1": "Indako Sakka-Lomo ca || ",
  "sn10.12:14.2": "Maṇibhaddo ca Sānu ca || ",
  "sn10.12:14.3": "Piyaṅkara-Punabbasu || Sudatto ca ",
  "sn10.12:14.4": "dve Sukkā Cīrā Alavan ti || || ",
  "sn10.12:14.5": "Yakkha-saṃyuttam samattaṃ || || ******************************************** ___________________________________________ 1. "
}
