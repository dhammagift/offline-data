{
  "sn10.7:0.1": "",
  "sn10.7:0.2": "",
  "sn10.7:0.3": "",
  "sn10.7:1.1": "Ekaṃ samayaṃ Bhagavā Sāvatthiyaṃ viharati Jetavane Anāthapiṇḍikassa ārāme || || 2. ",
  "sn10.7:1.2": "Tena kho pana samayena Bhagavā bhikkhū nibbānapaṭisaṃyuttāya dhammiyā kathāya sandasseti samādapeti samuttejeti sampahaṃseti || ",
  "sn10.7:1.3": "te ca bhikkhū aṭṭhi-katvā manasi katvā sabbaṃ cetasā samannāharitvā ohitasotā dhammaṃ suṇanti || || 3. ",
  "sn10.7:1.4": "Atha kho Punabbasu-mātā yakkhinī puttake evam toseti || || ",
  "sn10.7:2.1": "Tuṇhī Uttarike hohi || ",
  "sn10.7:2.2": "tuṇhi hohi Punabbasu || ",
  "sn10.7:2.3": "yāvāhaṃ buddhaseṭṭhassa || ",
  "sn10.7:2.4": "dhammaṃ sossāmi satthuno || || ",
  "sn10.7:3.1": "nibbānaṃ Bhagavā āhu || ",
  "sn10.7:3.2": "sabbaganthappamocanaṃ || ",
  "sn10.7:3.3": "ativelā ca me hoti || ",
  "sn10.7:3.4": "asmiṃ dhamme piyāyanā || || ",
  "sn10.7:4.1": "Piyo loke sako putto || ",
  "sn10.7:4.2": "piyo loke sako pati || ",
  "sn10.7:4.3": "tato piyatarā mayhaṃ || ",
  "sn10.7:4.4": "assa dhammassa magganā || || ",
  "sn10.7:5.1": "na hi putto pati vā pi || ",
  "sn10.7:5.2": "piyo dukkhā pamocaye || ",
  "sn10.7:5.3": "yathā saddhammasavanaṃ || ",
  "sn10.7:5.4": "dukkhā moceti pāṇinaṃ || || ",
  "sn10.7:6.1": "Loke dukkhapare tasmiṃ || ",
  "sn10.7:6.2": "jarāmaraṇasaṃyutte || ",
  "sn10.7:6.3": "jarāmaraṇamokkhāya || ",
  "sn10.7:6.4": "yaṃ dhammam abhisambuddhaṃ || ",
  "sn10.7:6.5": "taṃ dhammaṃ sotum icchāmi || ",
  "sn10.7:6.6": "tuṇhī hohi Punabbasū ti || || 4. ",
  "sn10.7:7.1": "Amma na vyāharissāmi || ",
  "sn10.7:7.2": "tuṇhībhūtāyam Uttarā || ",
  "sn10.7:7.3": "dhammam eva nisāmehi || ",
  "sn10.7:7.4": "saddhamasavanaṃ sukhaṃ || ",
  "sn10.7:7.5": "saddhammassa anaññāya || ",
  "sn10.7:7.6": "amma dukkhaṃ carāmase || || ",
  "sn10.7:8.1": "Esa devamanussānaṃ || ",
  "sn10.7:8.2": "sammūḷhānam pabhaṅkaro || ",
  "sn10.7:8.3": "buddho antimasarīro || ",
  "sn10.7:8.4": "dhammaṃ deseti cakkhumā || || 5. ",
  "sn10.7:9.1": "Sādhu kho paṇḍito nāma || ",
  "sn10.7:9.2": "putto jāto ure seyyo || ",
  "sn10.7:9.3": "putto me buddhaseṭṭhassa || ",
  "sn10.7:9.4": "dhammaṃ suddham piyāyati || || ",
  "sn10.7:10.1": "Punabbasu sukhī hohi || ",
  "sn10.7:10.2": "ajjāhamhi samuggatā || ",
  "sn10.7:10.3": "diṭṭhāni ariyasaccāni || ",
  "sn10.7:10.4": "Uttarā pi suṇatu me ti || || 1. "
}
