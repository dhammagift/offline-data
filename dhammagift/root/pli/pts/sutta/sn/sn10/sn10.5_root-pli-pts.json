  "sn10.5:0.3": "",
  "sn10.5:1.1": "Ekaṃ samayam Bhagavā Sāvatthiyam viharati Jetavane Anāthapiṇḍikassa ārāme || || 2. ",
  "sn10.5:1.2": "Tena kho pana samayena aññatarissā upāsikāya Sānu nāma putto yakkhena gahito hoti || || 3. ",
  "sn10.5:1.3": "Atha kho sā upasikā paridevamānā tāyaṃ velāyam imā gāthāyo abhāsi || || ",
  "sn10.5:2.1": "[Sā hūti me arahataṃ || iti me arahataṃ sutaṃ || sā dāni ajja passāmi || yakkhā kīḷanti Sānunā ti] || || Cātuddasiṃ pañcaddasiṃ || ",
  "sn10.5:2.2": "yāva pakkhassa aṭṭhamī || ",
  "sn10.5:2.3": "pāṭihāriyapakkhañca || ",
  "sn10.5:2.4": "aṭṭhaṅga-susamāhitaṃ || || uposatham upavasanti || iti me arahataṃ sutaṃ || sā dāni ajja passāmi || yakkhā kīḷanti Sānunā ti || || Cātuddasim pañcaddasiṃ || yāva pakkhassa aṭṭhamī || pātihāriyapakkhañca || aṭṭhaṅga-susamāhitaṃ || || ",
  "sn10.5:3.1": "uposatham upavasanti || ",
  "sn10.5:3.2": "brahmacariyaṃ caranti ye || ",
  "sn10.5:3.3": "na tehi yakkhā kīḷanti || ",
  "sn10.5:3.4": "iti me ",
  "sn10.5:3.5": "",
  "sn10.5:3.6": "",
  "sn10.5:4.1": "",
  "sn10.5:4.2": "",
  "sn10.5:4.3": "",
  "sn10.5:4.4": "",
  "sn10.5:5.1": "",
  "sn10.5:5.2": "",
  "sn10.5:5.3": "",
  "sn10.5:5.4": "arahataṃ sutaṃ || || ",
  "sn10.5:6.1": "Sāṇuṃ pabuddhaṃ vajjāsi || ",
  "sn10.5:6.2": "yakkhānaṃ vacanam idam || ",
  "sn10.5:6.3": "mā kāsi pāpakam kammam || ",
  "sn10.5:6.4": "āviṃ vā yadivā raho || || ",
  "sn10.5:7.1": "saceva pāpakaṃ kammaṃ || ",
  "sn10.5:7.2": "karissasi karosi vā || ",
  "sn10.5:7.3": "na te dukkhā pamuty-atthi || ",
  "sn10.5:7.4": "uppaccāpi palāyato ti || || 4. ",
  "sn10.5:8.1": "Mataṃ va amma rodanti || ",
  "sn10.5:8.2": "yo vā jīvaṃ na dissati || ",
  "sn10.5:8.3": "jīvantam amma passantī || ",
  "sn10.5:8.4": "kasmā mam amma rodasīti || || 5. ",
  "sn10.5:9.1": "Mataṃ va puttam rodanti || ",
  "sn10.5:9.2": "yo vā jīvam na dissati || ",
  "sn10.5:9.3": "yo ca kāmeva jitvāna || ",
  "sn10.5:9.4": "punar āgacchate idha || ",
  "sn10.5:9.5": "taṃ vāpi putta rodanti || ",
  "sn10.5:9.6": "puna jīvaṃ mato hi so || || ",
  "sn10.5:10.1": "kukkuḷā ubbhato tāta || ",
  "sn10.5:10.2": "kukkuḷam patitum icchasi || || ",
  "sn10.5:10.3": "narakā ubbhato tāta || ",
  "sn10.5:10.4": "narakam patitum icchasi || ",
  "sn10.5:11.1": "abhidhāvatha bhaddan-te || ",
  "sn10.5:11.2": "kassa ujjhāpayāmase || ",
  "sn10.5:11.3": "ādittā nibhataṃ bhaṇḍaṃ || ",
  "sn10.5:11.4": "puna ḍayhitum icchasīti || || 1. "
}
