  "sn10.1:0.3": "",
  "sn10.1:1.1": "",
  "sn10.1:1.2": "Ekaṃ samayaṃ Bhagavā Rājagahe viharati Indakūṭe pabbate Indakassa yakkhassa bhavane || || 2. ",
  "sn10.1:1.3": "Atha kho Indako yakkho yena Bhagavā ten-upasaṅkami || upasaṅkamitvā Bhagavantaṃ gāthāya ajjhabhāsi || || ",
  "sn10.1:2.1": "Rūpaṃ na jīvan ti vadanti buddhā || ",
  "sn10.1:2.2": "kathaṃ nvayaṃ vindat-imaṃ sarīraṃ || ",
  "sn10.1:2.3": "kut-assa aṭṭhīyakapiṇḍam eti || ",
  "sn10.1:2.4": "kathaṃ nvayaṃ sajjati gabbharasmin ti || || 3. ",
  "sn10.1:3.1": "Pathamaṃ kalalaṃ hoti || ",
  "sn10.1:3.2": "kalalā hoti abbudaṃ || ",
  "sn10.1:3.3": "abbudā jāyate pesī || ",
  "sn10.1:3.4": "pesī nibbattati ghano || ",
  "sn10.1:3.5": "ghanā pasākhā jāyanti || ",
  "sn10.1:3.6": "kesā lomā nakhāni ca || || ",
  "sn10.1:4.1": "yañ c-assa bhuñjati māta || ",
  "sn10.1:4.2": "annam pānañ ca bhojanaṃ || ",
  "sn10.1:4.3": "tena so tattha yāpeti || ",
  "sn10.1:4.4": "mātukucchigato naro ti || || 1. "
}
