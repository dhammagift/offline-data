  "sn32.1:1.1": "",
  "sn32.1:1.2": "Valāhakakāyike bhikkhave deve desissāmi || ",
  "sn32.1:1.3": "taṃ suṇātha || || 4 ",
  "sn32.1:1.4": "Katame ca bhikkhave valāhakakāyikā devā || || ",
  "sn32.1:1.5": "Santi bhikkhave sītavalāhakādevā || ",
  "sn32.1:1.6": "santi uṇhavalāhakā devā || ",
  "sn32.1:1.7": "santi abbhavalāhakā devā || ",
  "sn32.1:1.8": "santi vātavalāhakā devā || ",
  "sn32.1:1.9": "santi vassavalāhakā devā || || 5 ",
  "sn32.1:1.10": "Ime vuccanti bhikkhave valāhakakāyikā devā ti || || 1-3 Sāvatthi || || ",
  "sn32.1:1.11": "Ekam antaṃ "
}
