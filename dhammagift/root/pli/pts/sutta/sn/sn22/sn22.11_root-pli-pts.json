  "sn22.11:1.1": "",
  "sn22.11:1.2": "Rūpam bhikkhave anattā atītānāgataṃ || ",
  "sn22.11:1.3": "ko pana vādo paccuppannassa || ",
  "sn22.11:1.4": "Evam passam bhikkhave sutavā ariyasāvako atītasmiṃ rūpasmim anapekho hoti || ",
  "sn22.11:1.5": "anāgataṃ rūpaṃ nābhinandati || ",
  "sn22.11:1.6": "paccuppannassa rūpassa nibbidāya virāgāya nirodhāya paṭipanno hoti || 3 ",
  "sn22.11:1.7": "Vedanā anattā || || 4 ",
  "sn22.11:1.8": "Saññā anattā || || 5 ",
  "sn22.11:1.9": "Saṅkhārā anattā || || 6 ",
  "sn22.11:1.10": "Viññāṇam anattā atītānāgataṃ || ",
  "sn22.11:1.11": "ko pana vādo paccuppannassa || || ",
  "sn22.11:1.12": "Evam passam bhikkhave sutavā ariyasāvako atītasmiṃ viññāṇasmim anapekho hoti || ",
  "sn22.11:1.13": "anāgataṃ viññāṇaṃ nābhinandati || ",
  "sn22.11:1.14": "paccuppannassa viññāṇassa nibbidāya virāgāya nirodhāya paṭipanno hotī ti || || ",
  "sn22.11:1.15": "",
  "sn22.11:1.16": "",
  "sn22.11:2.0": "",
  "sn22.11:2.1": "Nakulapitā Devadahā || ",
  "sn22.11:2.2": "Dve pi Hāliddikāni ca || ",
  "sn22.11:2.3": "Samādhi Patisallāṇā || ",
  "sn22.11:2.4": "Upādā paritassanā duve || ",
  "sn22.11:2.5": "Atītānāgatapaccuppannā || 1 ",
  "sn22.11:2.6": ""
}
