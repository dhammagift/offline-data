  "sn22.106:1.1": "",
  "sn22.106:1.2": "ca bhikkhave dhamme desissāmi pariññā ca pariññātāviñca puggalaṃ || ",
  "sn22.106:1.3": "taṃ suṇātha || || 4 ",
  "sn22.106:1.4": "Katame ca bhikkhave pariññeyyā dhammā || || ",
  "sn22.106:1.5": "Rūpam bhikkhave pariññeyyo dhammo || ",
  "sn22.106:1.6": "Vedanā || pa || ",
  "sn22.106:1.7": "Saññā || ",
  "sn22.106:1.8": "Saṅkhārā || ",
  "sn22.106:1.9": "Viññāṇam pariññeyyo dhammo || || ",
  "sn22.106:1.10": "Ime vuccanti bhikkhave pariññeyyā dhammā || || 5 ",
  "sn22.106:1.11": "Katamā ca bhikkhave pariññā || || ",
  "sn22.106:1.12": "Rāgakkhayo dosakkhayo mohakkhayo || || ",
  "sn22.106:1.13": "Ayaṃ vuccati bhikkhave pariññā || || 6 ",
  "sn22.106:1.14": "Katamo ca bhikkhave pariññātāvī puggalo || || ",
  "sn22.106:1.15": "Arahātissa vacanīyaṃ || ",
  "sn22.106:1.16": "Yo yam āyasmā evaṃnāmo evaṃgotto || ",
  "sn22.106:1.17": "ayam vuccati bhikkhave pariññātāvī puggalo ti || || 1-2 Sāvatthi || || ",
  "sn22.106:1.18": "Tatra || voca || || 3 "
}
