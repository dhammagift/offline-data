  "sn22.114:1.1": "",
  "sn22.114:1.2": "nisinno kho so bhikkhu Bhagavantam etad avoca || || 4 ",
  "sn22.114:1.3": "Vijjā vijjāti bhante vuccati || || ",
  "sn22.114:1.4": "Katamā nu kho bhante vijjā ",
  "sn22.114:1.5": "kittāvatā ca vijjāgato hotīti || || 4 ",
  "sn22.114:1.6": "Idha bhikkhu sutavā ariyasāvako rūpam pajānāti || rūpasamudayaṃ || rūpanirodhaṃ || rūpanirodhagāminim paṭipadam pajānāti || || 5-8 ",
  "sn22.114:1.7": "Vedanaṃ || ",
  "sn22.114:1.8": "Saññaṃ || ",
  "sn22.114:1.9": "Saṅkhāre pajānāti || la || ",
  "sn22.114:1.10": "Viññāṇanirodhagāminim paṭipadaṃ pajānāti || || 9 ",
  "sn22.114:1.11": "Ayaṃ vuccati bhikkhu vijjā ",
  "sn22.114:1.12": "ettāvatā ca vijjāgato hotīti || || 1-2 ",
  "sn22.114:1.13": "Sāvatthi || || 3 Ekam antaṃ "
}
