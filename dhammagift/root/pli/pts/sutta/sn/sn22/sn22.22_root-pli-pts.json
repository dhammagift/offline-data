  "sn22.22:0.3": "",
  "sn22.22:1.1": "Sāvatthiyaṃ || || Tatra kho || || 3 ",
  "sn22.22:1.2": "Bhāraṃ ca vo bhikkhave desissāmi || bhārahāraṃ ca bhārādānaṃ ca bhāranikkhepanañca || ",
  "sn22.22:1.3": "tam suṇātha || || 4 ",
  "sn22.22:1.4": "Katamo bhikkhave bhāro || || ",
  "sn22.22:1.5": "Pañcupādānakkhandhā tissa vacanīyaṃ || ",
  "sn22.22:1.6": "katame pañca || || Seyyathīdaṃ ",
  "sn22.22:1.7": "rūpupādānakkhandho vedanupādānakkhāndho saññupādānakkhandho saṅkhārupādānakkhandho viññāṇupādānakkhandho || ",
  "sn22.22:1.8": "ayaṃ vuccati bhikkhave bhāro || || 5 ",
  "sn22.22:2.1": "Katamo ca bhikkhave bhārahāro || ",
  "sn22.22:2.2": "Puggalo tissa vacanīyaṃ || ",
  "sn22.22:2.3": "yoyaṃ āyasmā evaṃnāmo evaṃgotto || ",
  "sn22.22:2.4": "ayaṃ vuccati bhikkhave bhārahāro || || 6 ",
  "sn22.22:3.1": "Katamaṃ ca bhikkhave bhārādānaṃ || ",
  "sn22.22:3.2": "Yāyam taṇhā ponobhavikā nandirāgasahagatā tatra tatrābhinandinī || seyyathīdaṃ ",
  "sn22.22:3.3": "kāmataṇhā bhavataṇhā vibhavataṇhā || ",
  "sn22.22:3.4": "idaṃ vuccati bhikkhave bhārādānaṃ || || 7 ",
  "sn22.22:4.1": "Katamañca bhikkhave bhāranikkhepanaṃ || ",
  "sn22.22:4.2": "yo tassāyeva taṇhāya asesavirāganirodho cāgo paṭinissaggo mutti anālayo || ",
  "sn22.22:4.3": "idaṃ vuccati bhikkhave bhāranikkhepaṇan ti || || 8 ",
  "sn22.22:5.1": "Idam avoca Bhagavā || ",
  "sn22.22:5.2": "idam vatvāna Sugato athāparam etad avoca satthā || || ",
  "sn22.22:6.1": "Bhārā have pañcakkhandhā || ",
  "sn22.22:6.2": "bhārahāro ca puggalo || ",
  "sn22.22:6.3": "bhārādānaṃ dukkhaṃ loke || ",
  "sn22.22:6.4": "bhāranikkhepanaṃ sukhaṃ ||1|| ",
  "sn22.22:7.1": "Nikkhipitvā garuṃ bhāram || ",
  "sn22.22:7.2": "aññaṃ bhāram ānādīya || ",
  "sn22.22:7.3": "samūlaṃ taṇham abbhuyha || ",
  "sn22.22:7.4": "nicchāto parinibbuto ti ||2|| 1-2 Sāvatthi || || ",
  "sn22.22:7.5": "Tatra || voca || || 3 "
}
