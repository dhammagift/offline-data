  "sn22.76:0.3": "",
  "sn22.76:1.1": "",
  "sn22.76:1.2": "Rūpam bhikkhave aniccaṃ || ",
  "sn22.76:1.3": "yad aniccaṃ taṃ dukkhaṃ || ",
  "sn22.76:1.4": "yaṃ dukkham tad anattā || ",
  "sn22.76:1.5": "Yad anattā taṃ netaṃ mama neso ham asmi na meso attā ti || evam etaṃ yathābhūtaṃ sammappaññāya daṭṭhabbaṃ || || 4-6 ",
  "sn22.76:1.6": "Vedanā || pe || ",
  "sn22.76:1.7": "Saññā || || ",
  "sn22.76:1.8": "Saṅkhārā || || 7 ",
  "sn22.76:1.9": "Viññāṇam aniccaṃ || ",
  "sn22.76:1.10": "yad aniccaṃ taṃ dukkhaṃ || ",
  "sn22.76:1.11": "yaṃ dukkhaṃ tad anattā || ",
  "sn22.76:1.12": "yad anattā taṃ netaṃ mama neso ham asmi na meso attā ti || evam etaṃ yathābhūtaṃ sammappaññāya daṭṭhabbam || || 8 ",
  "sn22.76:2.1": "Evam passaṃ bhikkhave sutavā ariyasāvako rūpasmim pi nibbindati || vedanāya pi || saññāya pi || saṅkhāresu pi || viññāṇasmiṃ pi nibbindati || || 9 ",
  "sn22.76:2.2": "Nibbindaṃ virajjati || virāgā vimuccati vimuttasmim vimuttamiti ñāṇaṃ hoti || || ",
  "sn22.76:2.3": "Khīnā jāti vusitaṃ brahmacariyam kataṃ karaṇīyaṃ nāparam itthattāyāti pajānāti || || 10 ",
  "sn22.76:2.4": "Yāvatā bhikkhave sattāvāsā yāvatā bhavaggaṃ ete aggā ete seṭṭhā lokasmiṃ yad idam arahanto ti || || 11 ",
  "sn22.76:3.1": "Idam avoca Bhagavā || ",
  "sn22.76:3.2": "idaṃ vatvā Sugato athāparam etad avoca satthā || || 12 ",
  "sn22.76:4.1": "Sukhino vata arahanto || ",
  "sn22.76:4.2": "taṇhā tesaṃ na vijjati || || ",
  "sn22.76:4.3": "Asmimāno samucchinno || ",
  "sn22.76:4.4": "mohajālaṃ padālitam ||1|| ",
  "sn22.76:5.1": "Anejanto anuppattā || ",
  "sn22.76:5.2": "cittaṃ tesaṃ anāvilaṃ || ",
  "sn22.76:5.3": "loke anupalittā te || ",
  "sn22.76:5.4": "brahmabhūtā anāsavā ||2|| ",
  "sn22.76:6.1": "Pañcakkhandhe pariññāya || ",
  "sn22.76:6.2": "sattasaddhammagocarā || ",
  "sn22.76:6.3": "pasaṃsiyā sappurisā || ",
  "sn22.76:6.4": "puttā buddhassa orasā ||3|| ",
  "sn22.76:7.1": "Sattaratanasampannā || ",
  "sn22.76:7.2": "tīsu sikkhāsu sikkhitā || ",
  "sn22.76:7.3": "Anuvicaranti mahāvīrā || ",
  "sn22.76:7.4": "pahīnabhayabheravā ||4|| ",
  "sn22.76:8.1": "Dasahaṅgehi sampannā || ",
  "sn22.76:8.2": "mahānāgā samāhitā || ",
  "sn22.76:8.3": "ete kho seṭṭhā lokasmiṃ || ",
  "sn22.76:8.4": "taṇhā tesaṃ na vijjati ||5|| ",
  "sn22.76:9.1": "Asekhañāṇam uppannaṃ || ",
  "sn22.76:9.2": "antimo yam samussayo || ",
  "sn22.76:9.3": "Yo sāro brahmacariyassa || ",
  "sn22.76:9.4": "tasmim aparapaccayā ||6|| ",
  "sn22.76:10.1": "Vidhāsu na vikampanti || ",
  "sn22.76:10.2": "vippamuttā punabbhavā || ",
  "sn22.76:10.3": "dantabhūmim anuppattā || ",
  "sn22.76:10.4": "te loke vijitāvino ||7|| ",
  "sn22.76:11.1": "Uddhaṃ tiriyaṃ apācīnaṃ || ",
  "sn22.76:11.2": "nandi tesaṃ na vijjati || ",
  "sn22.76:11.3": "nandanti te sīhanādaṃ || ",
  "sn22.76:11.4": "Buddhā loke anuttarāti ||8|| 1-2 ",
  "sn22.76:11.5": "Sāvatthi || || Tatra || voca || || 3 "
}
