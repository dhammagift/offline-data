  "sn22.104:1.1": "",
  "sn22.104:1.2": "vo bhikkhave desissāmi dukkhasamudayañ cā dukkhanirodhañ ca dukkhanirodhagāminipaṭipadañ ca || ",
  "sn22.104:1.3": "tam sunātha || || 4 ",
  "sn22.104:1.4": "Katamañ ca bhikkhave dukkham || || ",
  "sn22.104:1.5": "Pañcupādanakkhandhātissa vacanīyaṃ || || ",
  "sn22.104:1.6": "Katame pañca || ",
  "sn22.104:1.7": "seyyathīdaṃ rūpupādānakkhandho || pe || viññāṇupādānakkhandho || || ",
  "sn22.104:1.8": "Idaṃ vuccati bhikkhave dukkhaṃ || || 5 ",
  "sn22.104:1.9": "Katamo ca bhikkhave dukkhasamudayo || || ",
  "sn22.104:1.10": "Yāyam taṇhā ponabbhavikā || pa || vibhavataṇhā || || ",
  "sn22.104:1.11": "Ayaṃ vuccati bhikkhave dukkhasamudayo || || 6 ",
  "sn22.104:1.12": "Katamo ca bhikkhave dukkhanirodho || || ",
  "sn22.104:1.13": "Yo tassāyeva taṇhāya asesavirāganirodho cāgo paṭinissaggo mutti anālayo || || ",
  "sn22.104:1.14": "Ayaṃ vuccati bhikkhave dukkhanirodho || || 7 ",
  "sn22.104:1.15": "Katamā ca bhikkhave dukkhanirodhagāminipatipadā || || ",
  "sn22.104:1.16": "Ayam eva ariyo aṭṭhaṅgiko maggo || ",
  "sn22.104:1.17": "seyyathīdam sammādiṭṭhi || pe || sammāsamādhi || || ",
  "sn22.104:1.18": "Ayaṃ vuccati bhikkhave dukkhanirodhagāminipaṭipadā ti || || 1-2 Sāvatthi || || Tatra -- voca || || 3 ",
  "sn22.104:1.19": "Sakkāyañ ca "
}
