  "sn22.103:1.1": "",
  "sn22.103:1.2": "bhikkhave antā || || ",
  "sn22.103:1.3": "Katame cattāro || ",
  "sn22.103:1.4": "Sakkāyanto sakkāyasamudayanto sakkāyanirodhanto sakkāyanirodhagāminipatipadanto || || 4 ",
  "sn22.103:1.5": "Katamo bhikkhave sakkāyanto || || ",
  "sn22.103:1.6": "Pañcupādānakkhandhātissa vacanīyaṃ || || ",
  "sn22.103:1.7": "Katame pañca || ",
  "sn22.103:1.8": "seyyathīdaṃ rūpupādānakkhandho vedanupādānakkhandho saññupādānakkhandho saṅkhārupādānakkhandho viññāṇupādānakkhandho || ",
  "sn22.103:1.9": "ayaṃ vuccati bhikkhave sakkāyanto || || 5 ",
  "sn22.103:2.1": "Katamo ca bhikkhave sakkāyasamudayanto || || ",
  "sn22.103:2.2": "Yāyam taṇhā ponabbhavikā nandi rāgasahagatā tatra tatrābhinandinī || seyyathīdaṃ ",
  "sn22.103:2.3": "kāmataṇhā bhavataṇhā vibhavataṇhā ",
  "sn22.103:2.4": "ayaṃ vuccati bhikkhave sakkāyasamudayanto || || 6 ",
  "sn22.103:3.1": "Katamo ca bhikkhave sakkāyanirodhanto || || ",
  "sn22.103:3.2": "Yo tassāyeva taṇhāya asesavirāganirodho cāgo paṭinissaggo mutti anālayo || ",
  "sn22.103:3.3": "ayaṃ vuccati bhikkhave sakkāyanirodhanto || || 7 ",
  "sn22.103:4.1": "Katamo ca bhikkhave sakkāyanirodhagāminipaṭipadanto || || ",
  "sn22.103:4.2": "Ayam eva ariyo aṭṭhaṅgiko maggo || ",
  "sn22.103:4.3": "seyyathīdam sammādiṭṭhi || pa || sammāsamādhi || || ",
  "sn22.103:4.4": "Ayaṃ vuccati bhikkhave sakkāyanirodhagāminipaṭipadanto || || 8 ",
  "sn22.103:4.5": "Ime kho bhikkhave cattāro antā ti || || 1-2 Sāvatthi || || Tatra || ",
  "sn22.103:4.6": "voca || || 3 Dukkhañ ca "
}
