  "sn22.32:1.1": "",
  "sn22.32:1.2": "bhikkhave desissāmi apabhaṅguṃ ca || || ",
  "sn22.32:1.3": "Taṃ suṇātha || || 4 ",
  "sn22.32:1.4": "Kiñca bhikkhave pabhaṅgu kiñca apabhaṅgu || || 5 ",
  "sn22.32:1.5": "Rūpam bhikkhave pabhaṅgu || ",
  "sn22.32:1.6": "yo tassa nirodho vūpasamo atthagamo idam apabhaṅgu || || 6 ",
  "sn22.32:1.7": "Vedanā pabhaṅgu || ",
  "sn22.32:1.8": "yo tassā nirodho vūpasamo atthagamo idam apabhaṅgu || || 7 ",
  "sn22.32:1.9": "Saññā pabhaṅgu || || 8 ",
  "sn22.32:1.10": "Saṅkhārā pabhaṅgu || ",
  "sn22.32:1.11": "yo tesaṃ nirodho vūpasamo atthagamo idam apabhaṅgu || || 9 ",
  "sn22.32:1.12": "Viññāṇam pabhaṅgu || ",
  "sn22.32:1.13": "yo tassa nirodho vūpasamo atthagamo idam apabhaṅgūti || || ",
  "sn22.32:1.14": "",
  "sn22.32:1.15": "",
  "sn22.32:2.0": "",
  "sn22.32:2.1": "Bhāram Pariññaṃ Parijānaṃ || ",
  "sn22.32:2.2": "Chandarāgaṃ ca catutthakam || ",
  "sn22.32:2.3": "Assādā ca tayo vuttā || ",
  "sn22.32:2.4": "Abhinandanam aṭṭhamam || ",
  "sn22.32:2.5": "Uppādam Aghamūlañ ca || ",
  "sn22.32:2.6": "Ekādasamo Pabhaṅgūti || || 1-2 Sāvatthi || || Tatra || voca || || 3 "
}
