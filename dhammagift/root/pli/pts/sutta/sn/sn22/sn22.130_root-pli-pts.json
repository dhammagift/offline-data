  "sn22.130:1.1": "Bārāṇasiyaṃ Isipatane Migadāye || || 3 ",
  "sn22.130:1.2": "Vijjā vijjāti āvuso Sāriputta vuccati || || ",
  "sn22.130:1.3": "Katamā nu kho āvuso vijjā ",
  "sn22.130:1.4": "kittāvatā ca vijjāgato hotīti || || 4 ",
  "sn22.130:2.1": "Idhāvuso sutavā ariyasāvako rūpassa assādañca ādīnavañca nissaraṇañca yathābhūtam pajānāti || 5-7 ",
  "sn22.130:2.2": "Vedanāya || || pe || ",
  "sn22.130:2.3": "Saññāya || || ",
  "sn22.130:2.4": "Saṅkhārānaṃ || || 8 ",
  "sn22.130:2.5": "Viññāṇassa assādañca ādīnavañca nissaraṇañca yathābhūtam pajānāti || 9 ",
  "sn22.130:2.6": "Ayam vuccatāvuso vijjā ",
  "sn22.130:2.7": "ettāvatā ca vijjāgato hotīti || || 1-2 ",
  "sn22.130:2.8": ""
}
