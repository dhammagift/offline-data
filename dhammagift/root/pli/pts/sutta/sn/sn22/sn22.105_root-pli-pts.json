  "sn22.105:1.1": "",
  "sn22.105:1.2": "vo bhikkhave desissāmi sakkāyasamudayañ ca sakkāyanirodhañca sakkāyanirodhagāminiñ ca paṭipadaṃ ",
  "sn22.105:1.3": "taṃ suṇātha || || 4 ",
  "sn22.105:1.4": "Katamo ca bhikkhave sakkāyo || || ",
  "sn22.105:1.5": "Pañcupādānakkhandhā tissa vacanīyaṃ || || ",
  "sn22.105:1.6": "Katame pañca || || ",
  "sn22.105:1.7": "Seyyathidaṃ rūpupādānakkhandho || pe || viññāṇupādānakkhandho || || ",
  "sn22.105:1.8": "Ayaṃ vuccati bhikkhave sakkāyo || || 5 ",
  "sn22.105:1.9": "Katamo ca bhikkhave sakkāyasamudayo || || ",
  "sn22.105:1.10": "Yāyaṃ taṇhā ponabbhavikā || pa || ",
  "sn22.105:1.11": "Ayaṃ vuccati bhikkhave sakkāyasamudayo || || 6 ",
  "sn22.105:1.12": "Katamo ca sakkāyanirodho || || ",
  "sn22.105:1.13": "Yo tassāyeva taṇhāya || pa || || ",
  "sn22.105:1.14": "Ayaṃ vuccati bhikkhave sakkāyanirodho || || 7 ",
  "sn22.105:1.15": "Katamā ca bhikkhave sakkāyanirodhagāminī paṭipadā || || ",
  "sn22.105:1.16": "Ayam eva ariyo aṭṭhaṅgiko maggo || ",
  "sn22.105:1.17": "seyyathīdaṃ sammādiṭṭhi || pa || sammāsamādhi || || 8 ",
  "sn22.105:1.18": "Ayaṃ vuccati bhikkhave sakkāyanirodhagāminī paṭipadā ti || || 1-2 Sāvatthi || || ",
  "sn22.105:1.19": "Tatra || voca || || 3 Pariññeye "
}
