  "sn46.77-88:0.3": "",
  "sn46.77-88:1.1": "bhikkhave Gaṅgā nadī pacīnaninnā- ",
  "sn46.77-88:1.2": "evam eva kho bhikkhave bhikkhu sattabojjhaṅge bhāvento- ",
  "sn46.77-88:1.3": "bahulīkaronto nibbānaninno hoti nibbānapoṇo nibbānapabbhāro || || 3. ",
  "sn46.77-88:1.4": "Idha bhikkhave bhikkhu satisambojjhaṅgam upekhāsambojjhaṅgam bhāveti viveka- ",
  "sn46.77-88:1.5": "virāga- nirodhanissitam vossaggaparināmiṃ || ",
  "sn46.77-88:1.6": "Evaṃ kho bhikkhave bhikkhu- -nibbānaninno hoti nibbānapoṇo nibbānapabbāro ",
  "sn46.77-88:1.7": "ti || || ",
  "sn46.77-88:1.8": "",
  "sn46.77-88:2.0": "",
  "sn46.77-88:2.1": "Cha Pācīnato ninnā || ",
  "sn46.77-88:2.2": "Cha ninnā ca Samuddato || ",
  "sn46.77-88:2.3": "Dve te cha dvādasa honti || ",
  "sn46.77-88:2.4": "Gaṅgāpeyyālo navamo || || "
}
