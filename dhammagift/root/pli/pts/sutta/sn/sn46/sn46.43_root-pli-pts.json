  "sn46.43:1.1": "vo bhikkhave maggaṃ desissāmi || ",
  "sn46.43:1.2": "taṃ suṇātha || || 3. ",
  "sn46.43:1.3": "Katamo ca bhikkhave mārasenapamaddano maggo || ",
  "sn46.43:1.4": "yadidam ",
  "sn46.43:1.5": "satta bojjhaṅgā || || ",
  "sn46.43:1.6": "Katame satta || || ",
  "sn46.43:1.7": "Satisambojjhaṅgo || pa-pe || || Upekhāsambojjhaṅgo || || ",
  "sn46.43:1.8": "Ayaṃ kho bhikkhave mārasenapamaddano maggo ",
  "sn46.43:1.9": "ti || || 2. "
