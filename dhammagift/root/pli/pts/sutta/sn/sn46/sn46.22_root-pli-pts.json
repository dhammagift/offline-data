  "sn46.22:1.1": "Satta vo bhikkhave bojjhaṅge desissāmi ",
  "sn46.22:1.2": "tam suṇātha || || ",
  "sn46.22:1.3": "Katame ca bhikkhave satta bojjhaṅgā || || ",
  "sn46.22:1.4": "Satisambojjhaṅgo || la [pe] || Upekhāsambojjhaṅgo || || ",
  "sn46.22:1.5": "Ime kho bhikkhave satta bojjhaṅgā ",
  "sn46.22:1.6": "ti || || 2. "
}
