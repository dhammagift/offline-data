  "sn8.12:0.3": "",
  "sn8.12:1.1": "Ekaṃ samayam Bhagavā Sāvatthiyaṃ viharati Jetavane Anāthapiṇḍikassa ārāme || || 2. ",
  "sn8.12:1.2": "Tena kho pana samayena āyasmā Vaṅgīso aciraarahattappatto hutvā vimutti-sukha- paṭisaṃvedī tāyaṃ velāyaṃ imā gāthāyo abhāsi || || ",
  "sn8.12:2.1": "Kāveyyamattā vicarimha pubbe || ",
  "sn8.12:2.2": "gāmāgamam purāpuraṃ || || ",
  "sn8.12:2.3": "ath-addasāma sambuddhaṃ ",
  "sn8.12:2.4": "||saddhā no udapajjatha || || ",
  "sn8.12:3.1": "So me dhammam adesesi || khandhe āyatānāni || dhātuyo ",
  "sn8.12:3.2": "ca || ",
  "sn8.12:3.3": "tassāhaṃ dhammaṃ sutvāna || ",
  "sn8.12:3.4": "pabbajiṃ anagāriyaṃ || || ",
  "sn8.12:4.1": "Bahunnam vata atthāya || ",
  "sn8.12:4.2": "bodhim ajjhagamā muni || ",
  "sn8.12:4.3": "bhikkhūnaṃ bhikkhunīnañ ca || ",
  "sn8.12:4.4": "ye niyāmagataddasā || || ",
  "sn8.12:5.1": "Svāgataṃ vata me asi || ",
  "sn8.12:5.2": "mama buddhassa santike || ",
  "sn8.12:5.3": "tisso vijjā anuppattā || ",
  "sn8.12:5.4": "kataṃ buddhassa sāsanan ti || || ",
  "sn8.12:6.1": "Pubbe-nivāsaṃ jānāmi || ",
  "sn8.12:6.2": "dibbacakkhuṃ visodhitaṃ || ",
  "sn8.12:6.3": "tevijjo iddhippattomhi || ",
  "sn8.12:6.4": "cetopariyāya-kovido ti || || Vaṅgīsa-thera-saṃyuttaṃ || || ",
  "sn8.12:7.0": "",
  "sn8.12:7.1": "Nikkhantam Arati c-eva || ",
  "sn8.12:7.2": "Pesalā-atimaññanā || ",
  "sn8.12:7.3": "Ānandena Subhāsitā || ",
  "sn8.12:7.4": "Sāriputta Pavāraṇā || ",
  "sn8.12:7.5": "Parosahassaṃ Kondañño || ",
  "sn8.12:7.6": "Moggalānena Gaggarā || ",
  "sn8.12:7.7": "Vaṅgīsena dvādasāti || || ******************************************** 1. ",
  "sn8.12:7.8": ""
}
