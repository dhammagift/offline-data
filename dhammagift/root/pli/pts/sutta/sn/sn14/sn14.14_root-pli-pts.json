  "sn14.14:0.1": "",
  "sn14.14:0.2": "",
  "sn14.14:0.3": "",
  "sn14.14:1.1": "Sāvatthiyaṃ viharati || 2 ",
  "sn14.14:1.2": "Dhātuso bhikkhave sattā saṃsandanti samenti || || ",
  "sn14.14:1.3": "Hīnādhimuttikā sattā hīnādhimuttikehi saddhiṃ saṃsandanti samenti || || ",
  "sn14.14:1.4": "Kalyānādhimuttikā kalyāṇādhimuttikehi saddhiṃ saṃsandanti samenti || || 3 ",
  "sn14.14:2.1": "Atītam pi bhikkhave addhānam dhātuso va sattā saṃsandiṃsu samiṃsu || || ",
  "sn14.14:2.2": "Hīnādhimuttikā hīnādhimuttikehi saddhiṃ saṃsandiṃsu samiṃsu || || ",
  "sn14.14:2.3": "Kalyāṇādhimuttikā kalyāṇādhimuttikehi saṃsandiṃsu samiṃsu || || 4 ",
  "sn14.14:3.1": "Anāgatam pi bhikkhave addhānaṃ dhātuso va sattā saṃsandissanti samessanti || ",
  "sn14.14:3.2": "Hīnādhimuttikā hīnādhimuttikehi saddhiṃ saṃsandissanti samessanti || || ",
  "sn14.14:3.3": "Kalyāṇādhimuttikā kalyāṇādhimuttikehi saddhiṃ saṃsandissanti samessanti || || 5 ",
  "sn14.14:4.1": "Etarahi bhikkhave paccuppannam addhānaṃ dhātuso va sattā saṃsandanti samenti || || ",
  "sn14.14:4.2": "Hīnādhimuttikā hīnādhimuttikehi saddhiṃ saṃsandanti samenti || || ",
  "sn14.14:4.3": "Kalyāṇādhimuttikā kalyāṇādhimuttikehi saddhiṃ saṃsandanti samentīti || || ",
  "sn14.14:4.4": "Catutthaṃ || || 1 "
}
