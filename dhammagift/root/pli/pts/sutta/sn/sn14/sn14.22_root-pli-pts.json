  "sn14.22:0.3": "",
  "sn14.22:1.1": "",
  "sn14.22:1.2": "bhikkhave sattā saṃsandanti samenti || || ",
  "sn14.22:1.3": "Kusītā kusītehi saddhiṃ saṃsandanti samenti || ",
  "sn14.22:1.4": "muṭṭhasatino muṭṭhasatīhi saddhiṃ- || ",
  "sn14.22:1.5": "duppaññā duppaññehi saddhimo || || ",
  "sn14.22:1.6": "Āraddhaviriyā āraddhaviriyehi saddhiṃ || upaṭṭhitasatino ",
  "sn14.22:1.7": "upaṭṭhitasatīhi saddhimo || paññavanto paññavantehi saddhiṃ saṃsandanti samentīti || || 3-5 Atītam pi || || Anāgatam pi || || Etarahi paccuppannam addhānaṃ samentīti || || Ekaṃ || || ",
  "sn14.22:1.8": "Dvādasamaṃ || || ",
  "sn14.22:1.9": "Dutiyo vaggo || || [Sabbattha atītānāgatapaccuppannaṃ kātabbam || || ",
  "sn14.22:1.10": "Tassa uddānam || || ",
  "sn14.22:2.0": "",
  "sn14.22:2.1": "Sattimā Sanidānañca || ",
  "sn14.22:2.2": "Giñjakāvasathena ca || ",
  "sn14.22:2.3": "Hinādhimutti ca Kammaṃ || ",
  "sn14.22:2.4": "Sagātha Asaddha sattamaṃ || ",
  "sn14.22:3.1": "Asaddhamūlakā pañca || ",
  "sn14.22:3.2": "Cattāro ahirikamūlakā || ",
  "sn14.22:3.3": "Anottappamūlakātīṇi || ",
  "sn14.22:3.4": "Dve Appassutena ca ",
  "sn14.22:4.1": "Kusītaṃ || Ekakā vuttā ",
  "sn14.22:4.2": "suttantā || tīni pañcavakā suttaṃ || ",
  "sn14.22:4.3": "bāvīsati vuttā suttā || ",
  "sn14.22:4.4": "Dutiyo vaggo pavuccatīti || || 1 "
}
