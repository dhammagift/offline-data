  "sn14.6:1.1": "Sāvatthiyaṃ viharati || || 2 ",
  "sn14.6:1.2": "Dhātunānattam vo bhikkhave desissāmi || ",
  "sn14.6:1.3": "tam suṇātha || pe|| || 3 ",
  "sn14.6:1.4": "Katamañca bhikkhave dhātunānattaṃ || || ",
  "sn14.6:1.5": "Rūpadhātu saddadhātu gandhadhātu rasadhātu phoṭṭhabbadhātu dhammadhātu || || 4 ",
  "sn14.6:1.6": "Idaṃ vuccati bhikkhave dhātunānattanti || || ",
  "sn14.6:1.7": "Chaṭṭhaṃ || || 1 Sāvatthi || || 2 "
}
