  "sn14.23:1.1": "Sāvatthiyaṃ viharati || || 2 ",
  "sn14.23:1.2": "Dhātuso bhikkhave sattā saṃsandanti samenti || || 3 ",
  "sn14.23:1.3": "Asaddhā asaddhehi saddhiṃ saṃsandanti samenti || ",
  "sn14.23:1.4": "ahirikā ahirikehi saddhiṃ- || anottāpino ",
  "sn14.23:1.5": "anottāpīhi saddhiṃ- || ",
  "sn14.23:1.6": "asamāhitā asamāhitehi saddhiṃ- || ",
  "sn14.23:1.7": "duppaññā duppaññehi saddhiṃ saṃsandanti samenti || || 4 ",
  "sn14.23:2.1": "Saddhā saddhehi saddhiṃ saṃsandanti samenti || ",
  "sn14.23:2.2": "hirimanā hirimanehi saddhiṃ- || ottāpino ",
  "sn14.23:2.3": "ottāpīhi saddhiṃ- || ",
  "sn14.23:2.4": "samāhitā samāhitehi saddhiṃ- || ",
  "sn14.23:2.5": "paññavanto paññavantehi saddhiṃ saṃsandanti samentīti || || ",
  "sn14.23:2.6": "Pathamaṃ || || 1 "
}
