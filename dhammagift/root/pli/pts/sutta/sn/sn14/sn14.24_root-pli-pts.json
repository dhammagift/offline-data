  "sn14.24:0.3": "",
  "sn14.24:1.1": "Sāvatthiyaṃ viharati || || 2 ",
  "sn14.24:1.2": "Dhātuso bhikkhave sattā saṃsandanti samenti || || 3 ",
  "sn14.24:1.3": "Asaddhā asaddhehi saddhiṃ saṃsandanti samenti || ",
  "sn14.24:1.4": "ahirikā ahirikehi saddhiṃ- || anottāpino ",
  "sn14.24:1.5": "anottāpīhi saddhiṃ- || ",
  "sn14.24:1.6": "dussīlā dussīlehi saddhiṃ- || ",
  "sn14.24:1.7": "duppaññā duppaññehi saddhiṃ saṃsandanti samenti || || 4 ",
  "sn14.24:2.1": "Saddhā saddhehi saddhiṃ saṃsandanti samenti || ",
  "sn14.24:2.2": "hirimanā hirimanehi saddhiṃ- || ottāpino ",
  "sn14.24:2.3": "ottāpīhi saddhimo || ",
  "sn14.24:2.4": "sīlavanto sīlavantehi saddhiṃ- || ",
  "sn14.24:2.5": "paññavanto paññavantehi saddhiṃ saṃsandanti samentīti || || ",
  "sn14.24:2.6": "Dutiyaṃ || || 1 "
}
