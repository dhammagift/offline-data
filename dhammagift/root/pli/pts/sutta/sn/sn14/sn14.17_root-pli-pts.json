  "sn14.17:1.1": "Sāvatthiyaṃ viharati || || ",
  "sn14.17:1.2": "I 2 Dhātuso bhikkhave sattā saṃsandanti samenti || || 3 ",
  "sn14.17:1.3": "Asaddhā asaddhehi saddhiṃ saṃsandanti samenti || ",
  "sn14.17:1.4": "ahirikā ahirikehi saddhim saddhiṃ saṃsandanti samenti || ",
  "sn14.17:1.5": "anottāpino anottāpīhi saddhiṃ saṃsandanti samenti || ",
  "sn14.17:1.6": "appassutā appassutehi saddhiṃ saṃsandanti samenti || ",
  "sn14.17:1.7": "kusītā kusītehi saddhiṃ saṃsandanti samenti || ",
  "sn14.17:1.8": "muṭṭhasatino muṭṭhasatīhi saddhiṃ saṃsandanti samenti || ",
  "sn14.17:1.9": "duppaññā duppaññehi saddhiṃ saṃsandanti samenti || || 4 ",
  "sn14.17:2.1": "[Saddhā saddhehi saddhim saṃsandanti samenti || hirimanā hirimanehi saddhiṃ saṃsandanti damenti || ottāpino ottāpīhi saddhiṃ- || bahussutā bahussutehi saddhimo || āraddhaviriyā āraddhaviriyehi saddhiṃ- || upaṭṭhitasatino upaṭṭhitasatīhi saddhimo || paññavanto paññavantehi saddhiṃ saṃsandanti samenti || || 5 Atītaṃ pi bhikkhave addhānaṃ dhātuso va sattā saṃsandiṃsu samiṃsu || || 6 ",
  "sn14.17:2.2": "Asaddhā asaddhehi saddhiṃ saṃsandiṃsu samiṃsu || ",
  "sn14.17:2.3": "ahirikā ahirikehi saddhiṃ saṃsandiṃsu samiṃsu || ",
  "sn14.17:2.4": "anottāpino anottāpīhi saddhiṃ- || ",
  "sn14.17:2.5": "appassutā appassutehi saddhiṃ- || ",
  "sn14.17:2.6": "kusītā kusītehi saddhiṃ- || muṭṭhasatino ",
  "sn14.17:2.7": "muṭṭhasatīhi saddhiṃ- || ",
  "sn14.17:2.8": "duppaññā duppaññehi saddhiṃ saṃsandhiṃsu samiṃsu || || 6 ",
  "sn14.17:3.1": "Anāgatam pi bhikkhave addhānam dhātuso va sattā saṃsandissanti samessanti || || ",
  "sn14.17:3.2": "Asaddhā asaddhehi saddhiṃ saṃsandissanti samessanti || ",
  "sn14.17:3.3": "ahirikā ahirikehi saddhiṃ- || anottāpino ",
  "sn14.17:3.4": "anottāpīhi saddhiṃ || pe || ",
  "sn14.17:3.5": "appassutā appassutehi saddhiṃ || pe|| ",
  "sn14.17:3.6": "kusītā kusītehi saddhiṃ || pe|| ",
  "sn14.17:3.7": "muṭṭhasatino muṭṭhasatīhi saddhiṃ || pe|| ",
  "sn14.17:3.8": "duppaññā duppaññehi saddhiṃ saṃsandissanti samessanti || || 7 ",
  "sn14.17:4.1": "Etarahi pi bhikkhave paccuppannam addhānam dhātuso va sattā saṃsandanti samenti || || ",
  "sn14.17:4.2": "Asaddhā asaddhehi saddhim saṃsandanti samenti || ",
  "sn14.17:4.3": "ahirikā ahirikehi saddhiṃ || pe|| ",
  "sn14.17:4.4": "anottāpino anottāpīhi saddhim || pe|| ",
  "sn14.17:4.5": "appassutā appassutehi saddhim || pe|| ",
  "sn14.17:4.6": "kusītā kusītehi saddhim || pe|| ",
  "sn14.17:4.7": "muṭṭhasatino muṭṭhasatīhi saddhiṃ saṃsandanti samenti || ",
  "sn14.17:4.8": "duppaññā duppaññehi saddhiṃ saṃsandanti samenti || || 8 ",
  "sn14.17:5.1": "Dhātuso va bhikkhave sattā saṃsandanti samenti || || ",
  "sn14.17:5.2": "Saddhā saddhehi saddhiṃ saṃsandanti samenti || ",
  "sn14.17:5.3": "hirimanā hirimanehi saddhiṃ saṃsandanti samenti || ",
  "sn14.17:5.4": "ottāpino ottāpīhi saddhiṃ saṃsandanti samenti || ",
  "sn14.17:5.5": "bahussutā bahussutehi saddhiṃ saṃsandanti samenti || ",
  "sn14.17:5.6": "āraddhaviriyā āraddhaviriyehi saddhiṃ saṃsandanti samenti || ",
  "sn14.17:5.7": "upaṭṭhitasatino upaṭṭhitasatīhi saddhiṃ samandanti samenti || ",
  "sn14.17:5.8": "paññavanto paññavantehi saddhiṃ saṃsandanti samenti || || 9 ",
  "sn14.17:5.9": "Atītaṃ pi bhikkhave addhānaṃ || pe|| 10 ",
  "sn14.17:5.10": "Anāgatam pi bhikkhave addhānaṃ || pe|| 11 ",
  "sn14.17:5.11": "Etarahi pi bhikkhave paccuppannam addhānaṃ dhātuso va sattā saṃsandanti samenti || ",
  "sn14.17:5.12": "Saddhā saddhehi saddhim || pe|| ",
  "sn14.17:5.13": "paññavanto paññavantehi saddhiṃ saṃsandanti samentīti || || ",
  "sn14.17:5.14": "Sattamaṃ || || 1 Sāvatthi || || I 2 Dhātuso va "
}
