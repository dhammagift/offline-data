  "sn14.38:1.1": "",
  "sn14.38:1.2": "Catasso imā bhikkhave dhātuyo || || ",
  "sn14.38:1.3": "Katamā catasso || || ",
  "sn14.38:1.4": "Pathavīdhātu || āpodhātu || tejodhātu || vāyodhātu || || 3 ",
  "sn14.38:1.5": "Ye hi keci bhikkhave samaṇā vā brāhmaṇā vā imāsaṃ catunnaṃ dhātunaṃ samudayañ ca atthagamān ca assādañ ca ādīnavañ ca nissaraṇañ ca yathābhūtaṃ na pajānantī ti ",
  "sn14.38:1.6": "vitthāretabbam || 4 ",
  "sn14.38:1.7": "Pajānanti || pe|| ",
  "sn14.38:1.8": "sayam abhiññā sacchikatvā upasampajja viharantīti || || ",
  "sn14.38:1.9": "Navamaṃ || || 1 Sāvatthi || || 2 "
}
