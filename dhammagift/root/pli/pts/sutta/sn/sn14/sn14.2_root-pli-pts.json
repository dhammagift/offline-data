  "sn14.2:0.3": "",
  "sn14.2:1.1": "Sāvatthiyaṃ viharati || || 2 ",
  "sn14.2:1.2": "Dhātunānattaṃ bhikkhave paṭicca uppajjati phassanānattaṃ || || 3 ",
  "sn14.2:1.3": "Katamañca bhikkhave dhātunānattaṃ || || 4 ",
  "sn14.2:1.4": "Cakkhudhātu sotadhātu ghānadhātu jivhādhātu kāyadhātu manodhātu || || ",
  "sn14.2:1.5": "Idaṃ vuccati bhikkhave dhātunānattaṃ || || 5 ",
  "sn14.2:2.1": "Katamañ ca bhikkhave dhātunānattam paṭicca uppajjati phassanānattam || 6 ",
  "sn14.2:2.2": "Cakkhudhātum bhikkhave paṭicca uppajjati cakkhusamphasso || ",
  "sn14.2:2.3": "Sotadhātum paṭicca || || ",
  "sn14.2:2.4": "Ghānadhātum paṭicca || || ",
  "sn14.2:2.5": "Jivhādhātuṃ paṭicca || || ",
  "sn14.2:2.6": "Kāyadhātuṃ paṭicca || || ",
  "sn14.2:2.7": "Manodhātum paṭicca uppajjati manosamphasso || || 7 ",
  "sn14.2:2.8": "Evaṃ kho bhikkhave dhātunānattaṃ paṭicca uppajjati phassanānattanti || || ",
  "sn14.2:2.9": "Dutiyaṃ || || 1 "
}
