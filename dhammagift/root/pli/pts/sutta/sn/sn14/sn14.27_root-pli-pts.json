  "sn14.27:0.3": "",
  "sn14.27:1.1": "Sāvatthiyaṃ viharati || || 2 ",
  "sn14.27:1.2": "Dhātuso bhikkhave sattā saṃsandanti samenti || || 3 ",
  "sn14.27:1.3": "Pāṇātipātino pāṇātipātihi saddhiṃ saṃsandanti samenti || ",
  "sn14.27:1.4": "ādinnādāyino || pe|| ",
  "sn14.27:1.5": "kāmesu micchācārino || ",
  "sn14.27:1.6": "musāvādino || ",
  "sn14.27:1.7": "pisuṇavācā || ",
  "sn14.27:1.8": "pharusavācā || ",
  "sn14.27:1.9": "samphappalāpino samphappalāpīhi saddhiṃ saṃsandanti samenti || ",
  "sn14.27:1.10": "abhijjhāluno abhijjhālūhi saddhiṃ saṃsandanti samenti || ",
  "sn14.27:1.11": "vyāpannacittā vyāpannacittehi saddhiṃ || ",
  "sn14.27:1.12": "micchādiṭṭhikā micchādiṭṭhikehi saddhiṃ saṃsandanti samenti || || 4 ",
  "sn14.27:2.1": "Paṇātipātā paṭiviratā pāṇātipātāpaṭiviratehi saddhiṃ saṃsandanti samenti || ",
  "sn14.27:2.2": "adinnādānā paṭiviratā || ",
  "sn14.27:2.3": "kāmesu micchācārā paṭiviratā || ",
  "sn14.27:2.4": "musāvādā paṭiviratā || ",
  "sn14.27:2.5": "pisuṇavācāya paṭiviratā || ",
  "sn14.27:2.6": "pharusavācāya paṭiviratā || ",
  "sn14.27:2.7": "samphappalāpā paṭiviratā samphappalāpā paṭiviratehi saddhiṃ saṃsandanti samenti || ",
  "sn14.27:2.8": "anabhijjhāluno anabhijjhālūhi saddhiṃ saṃsandanti samenti || ",
  "sn14.27:2.9": "avyāpannacittā avyāpannacittehi saddhiṃ saṃsandanti samenti || ",
  "sn14.27:2.10": "sammādiṭṭhikā sammādiṭṭhikehi saddhiṃ saṃsandanti samenti || ",
  "sn14.27:2.11": "||Pañcamaṃ || || 1 "
}
