{
  "sn14.26:0.1": "",
  "sn14.26:0.2": "",
  "sn14.26:0.3": "",
  "sn14.26:1.1": "Sāvatthiyaṃ viharati || || 2 ",
  "sn14.26:1.2": "Dhātuso bhikkhave sattā saṃsandanti samenti || || 3 ",
  "sn14.26:1.3": "Pāṇātipātino pāṇātipātīhi saddhiṃ saṃsandanti samenti || ",
  "sn14.26:1.4": "adinnādāyino adinnadāyīhi saddhiṃ- || ",
  "sn14.26:1.5": "kāmesu micchācārino kāmesu micchācārīhi saddhiṃ- || ",
  "sn14.26:1.6": "musāvādino musāvādīhi saddhiṃ- || ",
  "sn14.26:1.7": "pisuṇavācā pisuṇavācehi saddhiṃ- || ",
  "sn14.26:1.8": "",
  "sn14.26:1.9": "samphappalāpino samphappalāpīhi saddhiṃ saṃsandanti samenti || || 4 ",
  "sn14.26:2.1": "Pāṇātipātā paṭiviratā || ",
  "sn14.26:2.2": "adinnādānā paṭiviratā || ",
  "sn14.26:2.3": "kāmesu micchācārā paṭiviratā || ",
  "sn14.26:2.4": "musāvādā paṭiviratā || ",
  "sn14.26:2.5": "pisuṇavācāya paṭiviratā pisuṇavācāya paṭiviratehi saddhiṃ saṃsandanti samenti || ",
  "sn14.26:2.6": "pharusavācāya paṭiviratā pharusavācāya paṭiviratehi saddhiṃ saṃsandanti samenti || ",
  "sn14.26:2.7": "samphappalāpā paṭiviratā samphappalāpā paṭiviratehi saddhiṃ saṃsandanti samenti || || ",
  "sn14.26:2.8": "Catutthaṃ || || 1 "
}
