  "sn15.10:0.3": "",
  "sn15.10:1.1": "Bhagavā Rājagahe Gijjhakūṭe pabbate || || 2 ",
  "sn15.10:1.2": "Tatra || || voca || || 3 ",
  "sn15.10:1.3": "",
  "sn15.10:1.4": "Anamataggāyam ",
  "sn15.10:1.5": "",
  "sn15.10:2.1": "bhikkhave saṃsāro || pe|| || 4 ",
  "sn15.10:2.2": "Ekapuggalassa bhikkhave kappaṃ sandhāvato saṃsarato siyā evam mahā aṭṭhikaṅkalo aṭṭhipuñjo aṭṭhirāsi || yathāyam Vepullo pabbato sace saṃhārako assa sambhatañca na vinasseyya || || 5 ",
  "sn15.10:2.3": "Taṃ kissa hetu || || ",
  "sn15.10:2.4": "Anamataggāyam bhikkhave saṃsāro || pe|| || ",
  "sn15.10:2.5": "alaṃ vimuccitunti || || 6 ",
  "sn15.10:3.1": "Idam avoca Bhagavā || ",
  "sn15.10:3.2": "idaṃ vatvāna Sugato athāparam etad avoca satthā || || ",
  "sn15.10:4.1": "Ekassekena kappena || ",
  "sn15.10:4.2": "puggalassaṭṭhisañcayo || ",
  "sn15.10:4.3": "siyā pabbatasamo rāsi || ",
  "sn15.10:4.4": "iti vuttam mahesinā ||1|| ",
  "sn15.10:5.1": "So kho panāyam akkhāto || ",
  "sn15.10:5.2": "Vepullo pabbato mahā || ",
  "sn15.10:5.3": "uttaro Gijjhakūṭassa || ",
  "sn15.10:5.4": "Magadhānam giribbajo ||2|| ",
  "sn15.10:6.1": "Yato ariyasaccāni || ",
  "sn15.10:6.2": "sammappaññāya passati || ",
  "sn15.10:6.3": "dukkhaṃ dukkhasamuppādaṃ || ",
  "sn15.10:6.4": "dukkhassaca atikkamaṃ ||3|| ",
  "sn15.10:6.5": "Ariyaṭṭhaṅgikam maggaṃ || ",
  "sn15.10:6.6": "dukkhūpasamagāminaṃ || ",
  "sn15.10:7.1": "sasattakkhattuṃ paramaṃ || ",
  "sn15.10:7.2": "sandhāvitvāna puggalo || ",
  "sn15.10:7.3": "dukkhassantakaro hoti || ",
  "sn15.10:7.4": "sabbasaṃyojanakkhayā ti ||4|| ",
  "sn15.10:7.5": "Dasamaṃ || || ",
  "sn15.10:7.6": "Pathamo vaggo || || Tassa uddānaṃ || || ",
  "sn15.10:8.0": "",
  "sn15.10:8.1": "Tiṇakaṭṭhaṃ ca Pathavī || ",
  "sn15.10:8.2": "Assa Khīraṃ ca Pabbataṃ || ",
  "sn15.10:8.3": "Sāsapā Sāvakā Gaṅgā || ",
  "sn15.10:8.4": "Daṇḍo ca Puggalenā ti || || 1 "
}
