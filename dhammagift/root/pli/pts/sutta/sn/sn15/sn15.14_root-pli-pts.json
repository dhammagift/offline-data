  "sn15.14:1.1": "Sāvatthiyaṃ viharati || || 2 ",
  "sn15.14:1.2": "Anamataggāyam bhikkhave saṃsāro || pe|| || 3 ",
  "sn15.14:1.3": "Na so bhikkhave satto sulabharūpo || yo na mātābhūtapubbo iminā dīghena addhunā || || 4 ",
  "sn15.14:1.4": "Taṃ kissa hetu || || ",
  "sn15.14:1.5": "Anamataggāyam bhikkhave saṃsāro || pe|| ",
  "sn15.14:1.6": "alam vimuccitunti || || ",
  "sn15.14:1.7": "Catutthaṃ || || 1 "
}
