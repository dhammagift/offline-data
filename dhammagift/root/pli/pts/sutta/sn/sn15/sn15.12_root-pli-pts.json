  "sn15.12:1.1": "Sāvatthiyaṃ viharati || || 2 ",
  "sn15.12:1.2": "Anamataggāyam bhikkhave saṃsāro || pe|| || 3 ",
  "sn15.12:1.3": "Yam bhikkhave passeyyātha sukhitaṃ sajjitaṃ niṭṭham ettha gantabbaṃ ",
  "sn15.12:1.4": "Amhehi pi evarūpam paccanubhūtaṃ iminā dīghena addhunāti || || 4 ",
  "sn15.12:1.5": "Tam kissa hetu || || ",
  "sn15.12:1.6": "Anamataggāyam bhikkhave saṃsāro ",
  "sn15.12:1.7": "pubbākoṭi na paññāyati || pe || || ",
  "sn15.12:1.8": "alām vimuccitunti || || ",
  "sn15.12:1.9": "Dutiyaṃ || || 1 "
}
