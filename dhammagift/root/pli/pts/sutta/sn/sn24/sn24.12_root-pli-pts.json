  "sn24.12:1.3": "Anantavā loko ti || || 3-15 ",
  "sn24.12:1.4": "Bhagavammūlakā no bhante dhammā || || la || ",
  "sn24.12:1.5": "niyato samparāyano ti || || 1-2 ",
  "sn24.12:1.6": "Sāvatthi || || "
