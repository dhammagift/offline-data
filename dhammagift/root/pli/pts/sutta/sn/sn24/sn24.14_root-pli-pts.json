  "sn24.14:1.1": "",
  "sn24.14:1.2": "Kismiṃ nu kho bhikkhave sati kim upādāya kim abhinivissa evaṃ diṭṭhi uppajjati ",
  "sn24.14:1.3": "Aññaṃ jīvaṃ aññaṃ sarīranti || || 3-15 ",
  "sn24.14:1.4": "Bhagavammūlakā no bhante dhammā || la || ",
  "sn24.14:1.5": "niyato sambodhiparāyano ti || || 1-2 ",
  "sn24.14:1.6": "Sāvatthi || || "
}
