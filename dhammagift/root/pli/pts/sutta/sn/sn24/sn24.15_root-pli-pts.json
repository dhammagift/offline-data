  "sn24.15:1.1": "",
  "sn24.15:1.2": "Kismiṃ nu kho bhikkhave sati kim upādāya kim abhinivissa evaṃdiṭṭhi uppajjati ",
  "sn24.15:1.3": "Hoti Tathāgato param maranā ti || || 3-15 ",
  "sn24.15:1.4": "Bhagavammūlakā no bhante dhammā || pa || ",
  "sn24.15:1.5": "niyato sambodhiparāyano ti || || 1-2 ",
  "sn24.15:1.6": "Sāvatthi || || "
}
