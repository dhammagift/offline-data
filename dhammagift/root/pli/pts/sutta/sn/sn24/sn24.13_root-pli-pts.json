  "sn24.13:1.1": "",
  "sn24.13:1.2": "Kismiṃ nu kho bhikkhave sati kim upādāya kim abhinivissa evaṃ diṭṭhi uppajjati || ",
  "sn24.13:1.3": "Taṃ jīvaṃ taṃ sariranti || || 3-15 ",
  "sn24.13:1.4": "Bhagavammūlakā no bhante dhammā || || pa || ",
  "sn24.13:1.5": "niyato sambodhiparāyano ti || || 1-2 ",
  "sn24.13:1.6": "Sāvatthi || || "
}
