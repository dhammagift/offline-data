  "sn38.16:0.3": "",
  "sn38.16:1.1": "Kiṃ nu kho āvuso Sāriputta imasmiṃ dhammavinaye dukkaranti || || ",
  "sn38.16:1.2": "Pabbajjā kho āvuso imasmiṃ dhammavinaye dukkaranti || || 4 ",
  "sn38.16:1.3": "Pabbajjitena panāvuso kiṃ dukkaranti || || ",
  "sn38.16:1.4": "Pabbajjitena kho āvuso abhirati dukkarāti || 5 ",
  "sn38.16:1.5": "Abhiratena panāvuso Sāriputta kiṃ dukkaranti || || ",
  "sn38.16:1.6": "Abhiratena kho āvuso dhammānudhammapaṭipatti dukkarāti || || 6 ",
  "sn38.16:1.7": "Kiṃ va ciram panāvuso dhammānudhammapaṭipanno bhikkhu arahaṃ assāti || || ",
  "sn38.16:1.8": "Na ciram āvusoti || || ",
  "sn38.16:1.9": "",
  "sn38.16:1.10": "Jambukhādaka-saṃyuttaṃ || || ",
  "sn38.16:2.0": "",
  "sn38.16:2.1": "Nibbānam Arahattañca || ",
  "sn38.16:2.2": "Dhammavādī Kimatthiyam || ",
  "sn38.16:2.3": "Assāso Paramassāso || ",
  "sn38.16:2.4": "Vedanā Āsavāvijjā || ",
  "sn38.16:2.5": "Taṇhā Oghā Upādānam || ",
  "sn38.16:2.6": "Bhavo Dukkhañca Sakkāyo || ",
  "sn38.16:2.7": "Imasmiṃ dhammavinaye Dukkaranti || || 1 "
}
