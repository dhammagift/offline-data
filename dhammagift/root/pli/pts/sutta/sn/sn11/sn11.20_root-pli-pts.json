  "sn11.20:0.1": "",
  "sn11.20:0.2": "",
  "sn11.20:0.3": "",
  "sn11.20:1.1": "Sāvatthiyaṃ Jetavane || || 2. ",
  "sn11.20:1.2": "Tatra kho || la || avoca || || 3. ",
  "sn11.20:1.3": "Bhūtapubbaṃ bhikkhave Sakko devānam indo Mātalisaṅgāhakam āmantesi || || ",
  "sn11.20:1.4": "Yojehi samma Mātali sahassayuttam ājaññarathaṃ || uyyānabhūmim gacchāma subhumiṃ dassanāyā ti || || 4. ",
  "sn11.20:1.5": "Evaṃ bhadanta vā ti kho bhikkhave Mātali-saṅgāhako Sakkassa devānam indassa paṭissutvā sahassayuttam ajaññarathaṃ yojetvā Sakkassa devānam indassa paṭivedesi || || ",
  "sn11.20:1.6": "Yutto kho te mārisa sahassayutto ājaññaratho ",
  "sn11.20:1.7": "yassa dāni kālam maññasīti || || 5. ",
  "sn11.20:1.8": "Atha kho bhikkhave Sakko devānam indo Vejayantapāsādā orohanto pañjaliko sudam bhikkhu-saṅghaṃ namassati || || 6. ",
  "sn11.20:1.9": "Atha kho bhikkhave Mātali-saṅgāhako Sakkaṃ devānam indaṃ gāthāya ajjhabhāsi || || 7. ",
  "sn11.20:2.1": "Taṃ hi ete namasseyyuṃ || ",
  "sn11.20:2.2": "pūtidehasayā narā || ",
  "sn11.20:2.3": "nimuggā kuṇapesvete || ",
  "sn11.20:2.4": "khuppipāsā samappitā || || ",
  "sn11.20:3.1": "Kiṃ nu tesam pihayasi || ",
  "sn11.20:3.2": "anāgārāna Vasava || ",
  "sn11.20:3.3": "ācāram isīnaṃ brūhi || ",
  "sn11.20:3.4": "taṃ suṇoma vaco tavā ti || || 8. ",
  "sn11.20:4.1": "Etaṃ tesaṃ pihayāmi || ",
  "sn11.20:4.2": "anāgārāna Mātali || ",
  "sn11.20:4.3": "yamhā gāmā pakkamanti || ",
  "sn11.20:4.4": "anapekhā vajanti te || ",
  "sn11.20:5.1": "na tesaṃ koṭṭhe openti || ",
  "sn11.20:5.2": "na kumbhā na kaḷopiyaṃ || ",
  "sn11.20:5.3": "paraniṭṭhitam esānā || ",
  "sn11.20:5.4": "tena yāpenti subbatā || || ",
  "sn11.20:6.1": "sumantamantīno dhīrā || ",
  "sn11.20:6.2": "tuṇhībhūtā samañcarā || ",
  "sn11.20:6.3": "devā viruddhā asurehi || ",
  "sn11.20:6.4": "puthumaccā ca Mātali || || ",
  "sn11.20:7.1": "Aviruddhā viruddhesu || ",
  "sn11.20:7.2": "attadaṇḍesu nibbutā || ",
  "sn11.20:7.3": "sādānesu anādānā || ",
  "sn11.20:7.4": "te namassāmi Mātalī ti || 9. ",
  "sn11.20:8.1": "Seṭṭhā hi kira lokasmiṃ || ",
  "sn11.20:8.2": "ye tvaṃ Sakka namassasi || ",
  "sn11.20:8.3": "aham pi te namassāmi || ",
  "sn11.20:8.4": "ye namassasi Vāsava || || 10. ",
  "sn11.20:9.1": "Idaṃ vatvāna Maghavā || ",
  "sn11.20:9.2": "devarājā Sujampati || ",
  "sn11.20:9.3": "bhikkhusaṅghaṃ namassitvā || ",
  "sn11.20:9.4": "pamukho ratham āruhī ti || || ",
  "sn11.20:9.5": "",
  "sn11.20:10.0": "",
  "sn11.20:10.1": "Devā pana tayo vuttā || ",
  "sn11.20:10.2": "Daliddañ ca Rāmaṇeyyakaṃ || ",
  "sn11.20:10.3": "Yajamānañ ca Vandanā || ",
  "sn11.20:10.4": "tayo Sakkanamassanā ti || || ___________________________________________ 1. "
}
