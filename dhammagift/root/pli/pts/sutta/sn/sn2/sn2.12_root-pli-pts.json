  "sn2.12:0.3": "",
  "sn2.12:1.1": "ṭhito kho Veṇḍu devaputto Bhagavato santike imaṃ gātham abhāsi || || 2. ",
  "sn2.12:2.1": "Sukhitā va te manujā || ",
  "sn2.12:2.2": "Sugataṃ payirūpāsiya || ",
  "sn2.12:2.3": "yuñja Gotamasāsane || ",
  "sn2.12:2.4": "appamattānusikkhare ti || || ",
  "sn2.12:3.1": "Ye me pavutte satthipade || ",
  "sn2.12:3.2": "(Veṇḍūti Bhagavā) ",
  "sn2.12:3.3": "anusikkhanti jhāyino || ",
  "sn2.12:3.4": "kāle te appamajjantā || ",
  "sn2.12:3.5": "na maccuvasaṅgā siyun ti || || 1. "
}
