  "sn2.18:0.3": "",
  "sn2.18:1.1": "Evaṃ me sutam ",
  "sn2.18:1.2": "ekam samayaṃ Bhagavā Sākete viharati Añjanavane Migadāye || || ",
  "sn2.18:1.3": "Atha kho Kakudho devaputto abhikkantāya rattiyā abhikkantavaṇṇo kevalakappaṃ Añjanavanam obhāsetvā yena Bhagavā ten-upasaṅkami upasaṅkamitvā Bhagavantam abhivādetvā ekam antam aṭṭhāsi || || 2. Ekam antaṃ ṭhito kho Kakudho devaputto Bhagavantam etad avoca || || ",
  "sn2.18:1.4": "Nandasi samanā ti || || ",
  "sn2.18:1.5": "Kiṃ laddhā āvuso ti || || ",
  "sn2.18:1.6": "Tena hi samaṇa socasī ti || || ",
  "sn2.18:1.7": "Kiṃ jīyittha āvusoti || || ",
  "sn2.18:1.8": "Tena hi samaṇa n-eva nandasi na ca socasīti || || ",
  "sn2.18:1.9": "Evam āvuso ti || || 3. ",
  "sn2.18:2.1": "Kacci tvam anigho bhikkhu || ",
  "sn2.18:2.2": "atho nandī na vijjati || ",
  "sn2.18:2.3": "kacci tam ekam āsīnaṃ || ",
  "sn2.18:2.4": "aratī nābhikīratīti || || 4. ",
  "sn2.18:3.1": "Anigho ve ahaṃ yakkha || ",
  "sn2.18:3.2": "atho nandī na vijjati || ",
  "sn2.18:3.3": "atho mam ekam āsīnaṃ || ",
  "sn2.18:3.4": "aratī nābhikīratīti || || 5. ",
  "sn2.18:4.1": "Kathaṃ tvam anigho bhikkhu || ",
  "sn2.18:4.2": "kathaṃ nandi na vijjati || ",
  "sn2.18:4.3": "kathaṃ tam ekaṃ āsīnaṃ || ",
  "sn2.18:4.4": "aratī nābhikīratīti || || 6. ",
  "sn2.18:5.1": "Aghajātassa ve nandī || ",
  "sn2.18:5.2": "nandījātassa ve aghaṃ || ",
  "sn2.18:5.3": "anandī anigho bhikkhu || ",
  "sn2.18:5.4": "evaṃ jānāhi āvuso ti || || 7. ",
  "sn2.18:6.1": "Cirassaṃ vata passāmi || ",
  "sn2.18:6.2": "brāhmaṇaṃ parinibbutaṃ || ",
  "sn2.18:6.3": "anandim anighaṃ bhikkhuṃ || ",
  "sn2.18:6.4": "tiṇṇaṃ loke visattikanti || || 1. Rājagaha nidānam || || Ekam antaṃ "
}
