  "sn2.28:0.3": "",
  "sn2.28:1.1": "ṭhito kho Nandivisālo devaputto Bhagavantaṃ gāthāya ajjhabhāsi || || ",
  "sn2.28:2.1": "Catucakkaṃ navadvāraṃ || ",
  "sn2.28:2.2": "puṇṇam lobhena saṃyutaṃ || ",
  "sn2.28:2.3": "paṅkajātaṃ mahāvīra || ",
  "sn2.28:2.4": "kathaṃ yātrā bhavissatīti || 2. ",
  "sn2.28:3.1": "Chetvā nandiṃ varattañ ca || ",
  "sn2.28:3.2": "icchālobhañ ca pāpakaṃ || ",
  "sn2.28:3.3": "samūlaṃ taṇham abbuyha || ",
  "sn2.28:3.4": "evaṃ yātrā bhavissatīti || || 1. Sāvatthi nidānaṃ || || 2. "
}
