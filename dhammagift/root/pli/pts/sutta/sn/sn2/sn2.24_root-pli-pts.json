  "sn2.24:0.1": "",
  "sn2.24:0.2": "",
  "sn2.24:0.3": "",
  "sn2.24:1.1": "ṭhito kho Ghaṭīkāro devaputto Bhagavato santike imaṃ gātham abhāsi || || ",
  "sn2.24:2.1": "Avihaṃ upapannāse ",
  "sn2.24:2.2": "vimuttā satta bhikkhavo || ",
  "sn2.24:2.3": "rāga-dosa-parikkhīṇā || ",
  "sn2.24:2.4": "tiṇṇā loke visattikan ti || || 2. ",
  "sn2.24:3.1": "Ke ca te ataruṃ paṅkaṃ || ",
  "sn2.24:3.2": "maccudheyyaṃ suduttaraṃ || ",
  "sn2.24:3.3": "ke hitvā mānusaṃ dehaṃ || ",
  "sn2.24:3.4": "dibbayogam upaccagunti || || 3. ",
  "sn2.24:4.1": "Upako Phalagaṇḍo ca || ",
  "sn2.24:4.2": "Pukkusāti ca te tayo || ",
  "sn2.24:4.3": "Bhaddiyo Khaṇḍadeva ca || ",
  "sn2.24:4.4": "Bāhuraggi ca Piṅgiyo || ",
  "sn2.24:4.5": "te hitvā mānusaṃ dehaṃ || ",
  "sn2.24:4.6": "dibbayogam upaccagun ti || || 4. ",
  "sn2.24:5.1": "Kusalaṃ bhāsasi tesaṃ || ",
  "sn2.24:5.2": "Mārapāsappahāyinaṃ || ",
  "sn2.24:5.3": "kassa te dhammam aññāya || ",
  "sn2.24:5.4": "acchiduṃ bhava-bandhanan ti || || 5. ",
  "sn2.24:6.1": "Na aññatra Bhagavatā || ",
  "sn2.24:6.2": "nāññatra tava sāsanā || ",
  "sn2.24:6.3": "yassa te dhammam aññāya ",
  "sn2.24:6.4": "acchiduṃ bhavabhandanaṃ || || ",
  "sn2.24:7.1": "yattha nāmaṃ ca rūpaṃ ca || ",
  "sn2.24:7.2": "asesam uparujjhati || ",
  "sn2.24:7.3": "taṃ te dhammam idha ñāya || ",
  "sn2.24:7.4": "acchiduṃ bhavabandhanan ti || || 6. ",
  "sn2.24:8.1": "Gambhīraṃ bhāsasi vācaṃ || ",
  "sn2.24:8.2": "dubbijānaṃsudubbuddhaṃ || ",
  "sn2.24:8.3": "kassa tvaṃ dhammam aññāya || ",
  "sn2.24:8.4": "vācaṃ bhāsasi īdisanti || || 7. ",
  "sn2.24:9.1": "Kumbhakāro pure āsiṃ || ",
  "sn2.24:9.2": "Vehaḷiṅge ghaṭīkaro || ",
  "sn2.24:9.3": "mātā-petti-bharo āsiṃ || ",
  "sn2.24:9.4": "Kassapassa upāsako || || ",
  "sn2.24:10.1": "virato methunā dhammā || ",
  "sn2.24:10.2": "brahmacārī nirāmiso || ",
  "sn2.24:10.3": "Ahuvā te sajāmeyyo || ",
  "sn2.24:10.4": "ahuvā te pure sakhā || ",
  "sn2.24:11.1": "so-ham ete pajānāmi || ",
  "sn2.24:11.2": "vimutte satta bhikkhavo || ",
  "sn2.24:11.3": "rāgadosaparikkhīṇe || ",
  "sn2.24:11.4": "tiṇṇe loke visattikan ti || || 8. ",
  "sn2.24:12.1": "Evam etaṃ tadā āsi || ",
  "sn2.24:12.2": "yathā bhāsasi Bhagavā || ",
  "sn2.24:12.3": "kumbhakāro pure āsi || ",
  "sn2.24:12.4": "Vehaḷiṅge ghaṭikāro || ",
  "sn2.24:13.1": "mātāpetti-bharo āsi || ",
  "sn2.24:13.2": "Kassapassa upāsako || || ",
  "sn2.24:13.3": "virato methunā dhammā || ",
  "sn2.24:13.4": "brahmacārī nirāmiso || ",
  "sn2.24:13.5": "ahuvā me sagāmeyyo || ",
  "sn2.24:13.6": "ahuvā me pure sakhāti || || 9. ",
  "sn2.24:14.1": "Evam evaṃ purāṇānaṃ || ",
  "sn2.24:14.2": "sahāyānaṃ ahu saṅgamo || ",
  "sn2.24:14.3": "ubhinnaṃ bhāvitattānaṃ || ",
  "sn2.24:14.4": "sarīrantimadhārinan ti || || 1. "
}
