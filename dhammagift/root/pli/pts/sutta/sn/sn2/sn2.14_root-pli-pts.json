  "sn2.14:0.3": "",
  "sn2.14:1.1": "ṭhito kho Nandano devaputto Bhagavantaṃ gāthāya ajjhabhāsi || || ",
  "sn2.14:2.1": "Pucchāmi taṃ Gotama bhūripaññaṃ || ",
  "sn2.14:2.2": "anāvaṭaṃ Bhagavato ñāṇadassanaṃ || ",
  "sn2.14:2.3": "Kathaṃ vidhaṃ sīlavantaṃ vadanti || ",
  "sn2.14:2.4": "kathaṃ vidhaṃ paññāvantam vadanti || ",
  "sn2.14:2.5": "kathaṃ vidhaṃ dukkham aticca iriyati || ",
  "sn2.14:2.6": "kathaṃ vidhaṃ devatā pūjayantīti || || 2. ",
  "sn2.14:3.1": "Yo sīlavā paññavā bhāvitatto || ",
  "sn2.14:3.2": "samāhito jhānarato satimā || ",
  "sn2.14:3.3": "sabb-assa sokā vigatā pahīnā || ",
  "sn2.14:3.4": "khīṇāsavo antimadehadhārī || || ",
  "sn2.14:4.1": "Tathāvidhaṃ sīlavantam vadanti || ",
  "sn2.14:4.2": "tathāvidhaṃ paññāvantaṃ vadanti || ",
  "sn2.14:4.3": "tathāvidho dukkhaṃ aticca iriyati || ",
  "sn2.14:4.4": "tathāvidhaṃ devatā pūjayantīti || || 1. Ekam antaṃ "
}
