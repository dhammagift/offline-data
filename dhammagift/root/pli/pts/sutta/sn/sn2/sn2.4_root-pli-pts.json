  "sn2.4:0.3": "",
  "sn2.4:1.1": "",
  "sn2.4:1.2": "ṭhito kho Māgadho devaputto Bhagavantaṃ gāthāya ajjhabhāsi || || ",
  "sn2.4:2.1": "Kati lokasmiṃ pajjotā || ",
  "sn2.4:2.2": "yehi loko pakāsati || ",
  "sn2.4:2.3": "bhavantaṃ puṭṭhum āgamma || ",
  "sn2.4:2.4": "kathaṃ janemu taṃ mayan ti || || 2. ",
  "sn2.4:3.1": "Cattāro loke pajjotā || ",
  "sn2.4:3.2": "pañcam-ettha na vajjati || ",
  "sn2.4:3.3": "divā tapati ādicco || ",
  "sn2.4:3.4": "rattim ābhāti candimā || ",
  "sn2.4:4.1": "atha aggi divārattiṃ || ",
  "sn2.4:4.2": "tattha tattha pakāsati || ",
  "sn2.4:4.3": "sambuddho tapataṃ seṭṭho || ",
  "sn2.4:4.4": "esā ābhā anuttarā ti || || 1. Sāvatthiyam ārāme || || 2. "
}
