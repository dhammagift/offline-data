  "sn2.22:0.1": "",
  "sn2.22:0.2": "",
  "sn2.22:0.3": "",
  "sn2.22:1.1": "ṭhito kho Khemo devaputto Bhagavato santike imā gāthāyo abhāsi || || ",
  "sn2.22:2.1": "Caranti bālā dummedhā || ",
  "sn2.22:2.2": "amitten-eva attanā || ",
  "sn2.22:2.3": "karontā pāpakaṃ kammaṃ || ",
  "sn2.22:2.4": "yaṃ hoti kaṭukapphalaṃ || || ",
  "sn2.22:3.1": "na taṃ kammaṃ kataṃ sādhu || ",
  "sn2.22:3.2": "yaṃ katvā anutappati || ",
  "sn2.22:3.3": "yassa assumukho rodaṃ || ",
  "sn2.22:3.4": "vipākaṃ paṭisevati || || ",
  "sn2.22:4.1": "taṃ ca kammaṃ kataṃ sādhu || ",
  "sn2.22:4.2": "yam katvā nānutappati || ",
  "sn2.22:4.3": "yassa patīto sumano || ",
  "sn2.22:4.4": "vipākaṃ paṭisevati || || ",
  "sn2.22:5.1": "Paṭikacceva taṃ kayirā || ",
  "sn2.22:5.2": "yaṃ jaññā hitam attano || ",
  "sn2.22:5.3": "na sākaṭikaṃ cintāya || ",
  "sn2.22:5.4": "mantādhīro parakkame || || ",
  "sn2.22:6.1": "yathā sākaṭiko panthaṃ || ",
  "sn2.22:6.2": "samaṃ hitvā mahāpathaṃ || ",
  "sn2.22:6.3": "visamaṃ maggam āruyha || ",
  "sn2.22:6.4": "akkhacchinno vajhāyati || || ",
  "sn2.22:7.1": "evaṃ dhammā apakkamma || ",
  "sn2.22:7.2": "adhammam anuvattiya || ",
  "sn2.22:7.3": "mando maccumukhaṃ patto || ",
  "sn2.22:7.4": "akkhachinno va jhāyatīti || || 1. Ekam antaṃ "
}
