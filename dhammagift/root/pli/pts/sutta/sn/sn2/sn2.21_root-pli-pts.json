  "sn2.21:0.3": "",
  "sn2.21:1.1": "Evaṃ me sutaṃ ",
  "sn2.21:1.2": "ekam samayaṃ Bhagavā Sāvatthiyaṃ viharati Jetavane Anāthapiṇḍikassa ārāme || || ",
  "sn2.21:1.3": "Atha kho Sivo devaputto abhikkantāya rattiyā abhikkantavaṇṇo kevalakappaṃ Jetavanam obhāsetvā yena Bhagavā ten-upasaṅkami || upasaṅkamitvā Bhagavantam abhivādetvā ekam antam aṭṭhāsi || || ",
  "sn2.21:1.4": "Ekam antaṃ ṭhito kho Sivo devaputto Bhagavato santike imā gāthāyo abhāsi || || 2. ",
  "sn2.21:2.1": "Sabbhir eva samāsetha || ",
  "sn2.21:2.2": "sabbhi kubbetha santhavaṃ || ",
  "sn2.21:2.3": "sataṃ saddhammam aññāya || ",
  "sn2.21:2.4": "seyyo hoti na pāpiyo || || ",
  "sn2.21:3.1": "Sabbhir eva samāsetha || ",
  "sn2.21:3.2": "sabbhi kubbetha santhavaṃ || ",
  "sn2.21:3.3": "sataṃ saddhammam aññāya || ",
  "sn2.21:3.4": "paññā labbhati nāññato || ",
  "sn2.21:4.1": "Sabbhir eva samāsetha || ",
  "sn2.21:4.2": "sabbhi kubbetha santhavaṃ || ",
  "sn2.21:4.3": "sataṃ saddhammam aññāya || ",
  "sn2.21:4.4": "soka-majjhe na socati || || ",
  "sn2.21:5.1": "Sabbhir eva samāsetha || ",
  "sn2.21:5.2": "sabbhi kubbetha santhavaṃ || ",
  "sn2.21:5.3": "sataṃ saddhammam aññāya || ",
  "sn2.21:5.4": "ñāti-majjhe virocati || || ",
  "sn2.21:6.1": "Sabbhir eva samāsetha || ",
  "sn2.21:6.2": "sabbhi kubbetha santhavaṃ || ",
  "sn2.21:6.3": "sataṃ saddhammam aññāya || ",
  "sn2.21:6.4": "sattā hacchanti suggatiṃ || || ",
  "sn2.21:7.1": "Sabbhir eva samāsetha || ",
  "sn2.21:7.2": "sabbhi kubbetha santhavaṃ || ",
  "sn2.21:7.3": "sataṃ saddhammam aññāya || ",
  "sn2.21:7.4": "sattā tiṭṭhanti sātatan ti || || 3. ",
  "sn2.21:8.1": "Atha kho Bhagavā Sivaṃ devaputtaṃ gāthāya pacchābhāsi || || ",
  "sn2.21:9.1": "Sabbhir eva samāsetha || ",
  "sn2.21:9.2": "sabbhi kubbetha santhavaṃ || ",
  "sn2.21:9.3": "sataṃ saddhammam aññāya || ",
  "sn2.21:9.4": "sabbadukkhā pamuccatīti || || Ekam antaṃ "
}
