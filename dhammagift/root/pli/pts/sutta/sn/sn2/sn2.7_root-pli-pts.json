  "sn2.7:0.3": "",
  "sn2.7:1.1": "",
  "sn2.7:1.2": "ṭhito kho Pañcālacaṇḍo devaputto Bhagavato santike imaṃ gātham abhāsi || || ",
  "sn2.7:2.1": "Sambādhe vata okāsaṃ || ",
  "sn2.7:2.2": "avindi bhūrimedhaso || ",
  "sn2.7:2.3": "yo jhānam abuddhi buddho || ",
  "sn2.7:2.4": "patilīnanisabho munīti || || 2. ",
  "sn2.7:3.1": "Sambādhe vāpi vindanti || ",
  "sn2.7:3.2": "(Pañcālacaṇḍāti Bhagavā) || ",
  "sn2.7:3.3": "dhammaṃ nibbānapattiyā || ",
  "sn2.7:3.4": "ye satiṃ paccalatthaṃsu || ",
  "sn2.7:3.5": "sammā te susamāhitā ti || || 1. "
}
