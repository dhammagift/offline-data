  "sn2.17:0.1": "",
  "sn2.17:0.2": "",
  "sn2.17:0.3": "",
  "sn2.17:1.1": "ṭhito kho Subrahmā devaputto Bhagavantaṃ gāthāya ajjhabhāsi || || ",
  "sn2.17:2.1": "Niccam utrastam idaṃ cittaṃ || ",
  "sn2.17:2.2": "niccam ubiggam idaṃ mano || ",
  "sn2.17:2.3": "anuppannesu kiccesu || ",
  "sn2.17:2.4": "atho uppattitesu ca || ",
  "sn2.17:2.5": "sace atthi anutrastaṃ || ",
  "sn2.17:2.6": "taṃ me akkhāhi pucchito ti || || 2. Na aññatra bojjhaṅgatapasā|| ",
  "sn2.17:3.1": "na aññatra indriyasaṃvarā|| ",
  "sn2.17:3.2": "na ",
  "sn2.17:3.3": "aññatra sabbanissaggā || ",
  "sn2.17:3.4": "sotthiṃ passāmi pāṇinanti || || 3. ",
  "sn2.17:4.1": "Tatth-ev- ",
  "sn2.17:4.2": "antaradhāyīti || || 1. "
}
