  "sn2.6:1.1": "",
  "sn2.6:1.2": "ṭhito kho Kāmado devaputto Bhagavantam etad avoca || || 2. ",
  "sn2.6:1.3": "Dukkaram Bhagavā sudukkaraṃ Bhagavāti || || ",
  "sn2.6:2.1": "Dukkaram vā pi karonti || ",
  "sn2.6:2.2": "(Kāmadā ti Bhagavā) || ",
  "sn2.6:2.3": "sekhasīlasamāhitā ",
  "sn2.6:2.4": "ṭhitattā || anagāriyupetassa || ",
  "sn2.6:2.5": "tuṭṭhi hoti sukhāvahā ti || || 3. ",
  "sn2.6:3.1": "Dullabhā Bhagavā yadidaṃ tuṭṭhī ti || || ",
  "sn2.6:4.1": "Dullabhaṃ vā pi labhanti || ",
  "sn2.6:4.2": "(Kāmadāti Bhagavā) ",
  "sn2.6:4.3": "cittavūpasame ratā || ",
  "sn2.6:4.4": "yesaṃ divā ca ratto ca || ",
  "sn2.6:4.5": "bhāvanāya rato mano ti || || 4. ",
  "sn2.6:5.1": "Dussamādahaṃ Bhagavā yad idaṃ cittan ti || || ",
  "sn2.6:6.1": "Dussamādahaṃ vāpi samādahanti || ",
  "sn2.6:6.2": "(Kāmadāti Bhagavā) || ",
  "sn2.6:6.3": "indriyūpasame ratā || ",
  "sn2.6:6.4": "te chetvā maccuno jālaṃ || ",
  "sn2.6:6.5": "ariyā gacchanti Kāmadāti || || 5. ",
  "sn2.6:7.1": "Duggamo Bhagavā visamo maggo ti || || ",
  "sn2.6:8.1": "Duggame visame vā pi || ",
  "sn2.6:8.2": "ariyā gacchanti Kāmada || ",
  "sn2.6:8.3": "anariyā visame magge || ",
  "sn2.6:8.4": "papatanti avaṃsirā || ",
  "sn2.6:8.5": "ariyānaṃ samo maggo || ",
  "sn2.6:8.6": "ariyā hi visame samā ti || || 1. Ekam antaṃ "
}
