  "sn55.50:1.1": "Cattārimāni bhikkhave sotāpattiyaṅgāni || ",
  "sn55.50:1.2": "katamāni cattari || || 3. ",
  "sn55.50:1.3": "Sappurisasaṃsevo saddhammasavanaṃ yonisomanasikāro dhammānudhammapaṭipatti || || 4. ",
  "sn55.50:1.4": "Imāni kho bhikkhave cattāri sotāpattiyaṅgāni || || ",
  "sn55.50:1.5": "",
  "sn55.50:1.6": "Sagāthakapuññābhisandavaggo pañcamo || || Abhisandena ",
  "sn55.50:2.0": "",
  "sn55.50:2.1": "tayo vuttā || ",
  "sn55.50:2.2": "Duve Mahaddhanena ca || ",
  "sn55.50:2.3": "Bhikkhu Nandiya Bhaddhiyam || ",
  "sn55.50:2.4": "Mahānām-Aṅgena te dasā ti || || 2. "
}
