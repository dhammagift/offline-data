  "sn55.43:0.3": "",
  "sn55.43:1.1": "puññabhisandā- ",
  "sn55.43:1.2": "katame cattāro || || 3. ",
  "sn55.43:1.3": "Idha bhikkhave ariyasāvako Buddhe- ",
  "sn55.43:1.4": "",
  "sn55.43:1.5": "",
  "sn55.43:2.1": "-Dhamme || pe [pa] || ",
  "sn55.43:2.2": "Saṅghe || || ",
  "sn55.43:3.1": "Paññavā hoti udayatthagāminiyā paññāya samannāgato ariyāya nibbedhikāya sammādukkhakkhaya gāminiyā || ",
  "sn55.43:3.2": "ayaṃ catuttho puññābhisando kusalābhisando sukhassāhāro || || ",
  "sn55.43:3.3": "Ime kho bhikkhave cattāro- -sukhassāhārā || || 4. ",
  "sn55.43:4.1": "Imehi kho bhikkhave- -na sukaraṃ gaṇetuṃ- ",
  "sn55.43:4.2": "",
  "sn55.43:4.3": "-mahapuññakkhandho teva saṅkhaṃ gacchatī ti || || 5. ",
  "sn55.43:4.4": "Idam avoca Bhagavā || || ",
  "sn55.43:4.5": "",
  "sn55.43:5.1": "Yo puññakāmo kusale patiṭṭhito || ",
  "sn55.43:5.2": "bhāveti maggam amatassa pattiyā || ",
  "sn55.43:5.3": "so dhammasārādhigamo khaye rato || ",
  "sn55.43:5.4": "na vedhati maccurāja gamissatī ",
  "sn55.43:5.5": "ti || || 2. "
}
