  "sn55.33:1.1": "bhikkhave puññābhisandā kusalābhisandā sukhassāhārā || ",
  "sn55.33:1.2": "katame cattāro || || 3--5. ",
  "sn55.33:1.3": "Idha bhikkhave ariyasāvako Buddhe- ",
  "sn55.33:1.4": "-Iti pi so Bhagavā || la-pe || satthā- -bhagavāti || ",
  "sn55.33:1.5": "",
  "sn55.33:2.1": "Dhamme || ",
  "sn55.33:2.2": "Saṅghe || || 6. ",
  "sn55.33:3.1": "Paññavā hoti udayatthagāminiyā paññāya samannāgato hoti ariyāya nibbedhikāya sammādukkhakkhayagāminiyā || || ",
  "sn55.33:3.2": "Ayam catuttho puññābhisando kusalābhisando sukhassāhāro || || 7. ",
  "sn55.33:3.3": "Ime kho bhikkhave cattāro puññābhisandā kusalābhisandā sukhassāhārā ",
  "sn55.33:3.4": "ti || || 1. "
}
