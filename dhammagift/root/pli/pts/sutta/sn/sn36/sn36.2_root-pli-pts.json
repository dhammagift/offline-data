  "sn36.2:0.3": "",
  "sn36.2:1.1": "Tisso imā bhikkhave vedanā || ",
  "sn36.2:1.2": "katamā tisso || || ",
  "sn36.2:1.3": "Sukhā vedanā dukkhā vedanā adukkhamasukhā vedanā || || ",
  "sn36.2:1.4": "Imā kho bhikkhave tisso vedanā ti || || 4 ",
  "sn36.2:2.1": "Sukhaṃ vā yadi vā dukkhaṃ || ",
  "sn36.2:2.2": "adukkhamasukhaṃ saha || ",
  "sn36.2:2.3": "Ajjhattañca bahiddhā ca || ",
  "sn36.2:2.4": "Yaṃ kiñci atthi veditaṃ || || ",
  "sn36.2:3.1": "Etaṃ dukkhan ti ñatvāna || ",
  "sn36.2:3.2": "mosadhammam palokinaṃ || ",
  "sn36.2:3.3": "Phussaphussavayam passaṃ || ",
  "sn36.2:3.4": "evaṃ tattha virajjatīti || || 3 ",
  "sn36.2:3.5": ""
}
