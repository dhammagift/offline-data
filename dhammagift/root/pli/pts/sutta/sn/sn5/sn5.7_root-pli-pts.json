  "sn5.7:0.3": "",
  "sn5.7:1.1": "",
  "sn5.7:1.2": "Atha kho Uppacālā bhikkhunī bhikkhunī pubbaṇhasamayaṃ nivāsetvā || la || ",
  "sn5.7:1.3": "aññatarasmiṃ rukkhamūle divāvihāraṃ nisīdi || ",
  "sn5.7:1.4": "pa || Upacālam bhikkhunim etad avoca || || ",
  "sn5.7:1.5": "Kattha nu tvaṃ bhikkhuni uppajjitu-kāmā ti || || 3. ",
  "sn5.7:1.6": "Na khvāham āvuso katthaci uppajjitu-kāmā ti || || 4. ",
  "sn5.7:2.1": "Tāvatiṃsā ca Yāmā ca || ",
  "sn5.7:2.2": "Tusitā cāpi devatā || ",
  "sn5.7:2.3": "Nimmānaratino devā || ",
  "sn5.7:2.4": "ye devā Vasavattino || || ",
  "sn5.7:2.5": "tattha cittaṃ paṇidhehi || ",
  "sn5.7:2.6": "ratiṃ paccanubhossasīti || || 5. ",
  "sn5.7:3.1": "Tāvatiṃsā ca Yāmāca || ",
  "sn5.7:3.2": "Tusitā cāpi devatā || ",
  "sn5.7:3.3": "Nimmānaratino devā || ",
  "sn5.7:3.4": "ye devā Vasavattino || || ",
  "sn5.7:3.5": "kāmabandhanabaddhā te || ",
  "sn5.7:3.6": "enti Māra-vasaṃ puna || || ",
  "sn5.7:4.1": "Sabbo ādipito loko || ",
  "sn5.7:4.2": "sabbo loko padhūpito || ",
  "sn5.7:4.3": "sabbo pajjalito loko || ",
  "sn5.7:4.4": "sabbo loko pakampito || || ",
  "sn5.7:5.1": "akampitam acalitaṃ || ",
  "sn5.7:5.2": "aputthujjanasevitaṃ || ",
  "sn5.7:5.3": "agati yattha Mārassa || ",
  "sn5.7:5.4": "tattha me nirato mano ti || || 6. ",
  "sn5.7:6.1": "Atha kho Māro pāpimā || || 1. Sāvatthiyaṃ || || "
}
