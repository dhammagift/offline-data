{
  "sn5.8:0.1": "",
  "sn5.8:0.2": "",
  "sn5.8:0.3": "",
  "sn5.8:1.1": "",
  "sn5.8:1.2": "Atha kho Sīsupacālā bhikkhunī pubbaṇhasamayaṃ nivāsetvā || pa || ",
  "sn5.8:1.3": "aññatarasmiṃ rukkhumūle divāvihāraṃ nisīdi || || 2. ",
  "sn5.8:1.4": "Atha kho Māro pāpimā yena Sīsupacālā bhikkhunī tenupasaṅkami || upasaṅkamitvā Sīsupacālam bhikkhunim etad avoca || || ",
  "sn5.8:1.5": "Kassa nu tvaṃ bhikkhuni pāsaṇḍaṃ rocesīti || || 3. ",
  "sn5.8:1.6": "Na khvāham āvuso kassaci pāsaṇḍaṃ rocemī ti || || 4. ",
  "sn5.8:2.1": "Kiṃ nu uddissa muṇḍāsi || ",
  "sn5.8:2.2": "samaṇī viya dissasi || ",
  "sn5.8:2.3": "na ca rocesi pāsaṇḍaṃ || ",
  "sn5.8:2.4": "kim-iva carasi momuhā ti || || 5. ",
  "sn5.8:3.1": "Ito bahiddhā pāsaṇḍā || ",
  "sn5.8:3.2": "diṭṭhīsu pasīdanti ye || ",
  "sn5.8:3.3": "na tesaṃ dhammam rocemi || na ",
  "sn5.8:3.4": "te dhammassa kovidā || || ",
  "sn5.8:4.1": "Atthi sakya-kule jāto || ",
  "sn5.8:4.2": "buddho appaṭipuggalo || ",
  "sn5.8:4.3": "sabbābhibhū māranudo || ",
  "sn5.8:4.4": "sabbattham aparājito || ",
  "sn5.8:5.1": "sabbatthamutto asito || ",
  "sn5.8:5.2": "sabbam passati cakkhumā || || ",
  "sn5.8:5.3": "sabbakammakkhayaṃ patto || ",
  "sn5.8:5.4": "vimutto upadhisaṅkhaye || ",
  "sn5.8:5.5": "so mayhaṃ Bhagavā satthā || ",
  "sn5.8:5.6": "tassa rocemi sāsanan ti || || 6. ",
  "sn5.8:6.1": "Atha kho Māro pāpimā || pe || 1. Sāvatthiyaṃ || || "
}
