{
  "dn20:0.1": "",
  "dn20:0.2": "",
  "dn20:1.1": "Evam me sutaṃ. ",
  "dn20:1.2": "Ekaṃ samayaṃ Bhagavā Sakkesu viharati Kapilavatthusmiṃ Mahāvane mahatā bhikkhu-saṃghena saddhiṃ pañca-mattehi bhikkhu-satehi sabbeh' eva arahantehi, ",
  "dn20:1.3": "dasahi ca loka-dhātūhi devatā yebhuyyena sannipatitā honti Bhagavantaṃ dassanāya bhikkhu-saṃghañ ca. 2. ",
  "dn20:2.1": "Atha kho catunnaṃ Suddhāvāsakāyikānaṃ devānaṃ etad ahosi: ",
  "dn20:2.2": "‘Ayaṃ kho Bhagavā Sakkesu viharati Kapila-vatthusmiṃ Mahāvane mahatā bhikkhu-saṃghena saddhiṃ pañca-mattehi bhikkhu-satehi sabbeh' eva arahantehi, ",
  "dn20:2.3": "dasahi ca loka-dhātūhi devatā yebhuyyena sannipatitā honti Bhagavantaṃ dassanāya bhikkhu-saṃghañ ca. ",
  "dn20:2.4": "Yan nūna mayam pi yena Bhagavā ten' upasaṃkameyyāma, upasaṃkamitvā Bhagavato santike pacceka-gāthaṃ bhāseyyāmāti.' 3. ",
  "dn20:3.1": "Atha kho tā devatā seyyathā pi nāma balavā puriso sammiñjitaṃ vā bāhaṃ pasāreyya, pasāritaṃ vā bāhaṃ sammiñjeyya, evam evaṃ Suddhāvāsesu devesu antarahitā Bhagavato purato pātur ahaṃsu. ",
  "dn20:3.2": "Atha kho tā devatā Bhagavantaṃ abhivādetvā ekamantaṃ aṭṭhaṃsu , ",
  "dn20:3.3": "ekamantaṃ ṭhitā kho ekā devatā Bhagavato santike imaṃ gāthaṃ abhāsi:-- ",
  "dn20:3.4": "‘Mahā-samayo pavanasmiṃ, ",
  "dn20:3.5": "deva-kāyā samāgatā, ",
  "dn20:3.6": "Āgat' amha imaṃ dhamma-samayaṃ ",
  "dn20:3.7": "dakkhitāye aparājita-saṃghan ti.' ",
  "dn20:3.8": "Atha kho aparā devatā Bhagavato santike imaṃ gāthaṃ abhāsi:-- ",
  "dn20:3.9": "‘Tatra bhikkhavo samādahaṃsu ",
  "dn20:3.10": "cittaṃ attano ujukam akaṃsu, ",
  "dn20:3.11": "Sārathi va nettāni gahetvā ",
  "dn20:3.12": "indriyāni rakkhanti paṇḍitā ti.' ",
  "dn20:3.13": "Atha kho aparā devatā Bhagavato santike imaṃ gāthaṃ abhāsi:-- ",
  "dn20:3.14": "‘Chetvā khilaṃ chetvā palighaṃ ",
  "dn20:3.15": "inda-khīlaṃ ūhacca-m-anejā, ",
  "dn20:3.16": "Te caranti suddhā vimalā ",
  "dn20:3.17": "cakkhumatā sudantā susunāgā ti.' ",
  "dn20:3.18": "Atha kho aparā devatā Bhagavato santike imaṃ gāthaṃ abhāsi:-- ",
  "dn20:3.19": "‘Ye keci Buddhaṃ saraṇaṃ gatāse ",
  "dn20:3.20": "na te gamissanti apāyaṃ , ",
  "dn20:3.21": "Pahāya mānusaṃ dehaṃ ",
  "dn20:3.22": "deva-kāyaṃ paripūressantīti.' 4. ",
  "dn20:4.0": "",
  "dn20:4.1": "Atha kho Bhagavā bhikkhū āmantesi:-- ",
  "dn20:4.2": "‘Yebhuyyena bhikkhave dasasu loka-dhātusu devatā sannipatitā Tathāgatam dassanāya bhikkhu-saṃghañ ca. ",
  "dn20:4.3": "Ye pi te bhikkhave ahesuṃ atītam addhānaṃ arahanto sammā-sambuddhā, tesam pi Bhagavantānaṃ eta-paramā yeva devatā sannipatitā ahesuṃ seyyathā pi mayhaṃ etarahi. ",
  "dn20:4.4": "Ye pi te bhikkhave bhavissanti anāgatam addhānaṃ arahanto sammāsambuddhā, tesam pi Bhagavantānaṃ eta-paramā yeva devatā sannipatitā bhavissanti seyyathā pi mayhaṃ etarahi. ",
  "dn20:4.5": "Ācikkhissāmi bhikkhave devakāyānaṃ nāmāni, ",
  "dn20:4.6": "kittayissāmi bhikkhave devakāyānaṃ nāmāni, ",
  "dn20:4.7": "desissāmi bhikkhave devakāyānaṃ nāmāni. ",
  "dn20:4.8": "Taṃ suṇātha sādhukaṃ manasikarotha, bhāsissāmīti.' ",
  "dn20:4.9": "‘Evaṃ bhante ti' kho te bhikkhū Bhagavato paccassosuṃ. ",
  "dn20:4.10": "Bhagavā etad avoca:-- 5. ",
  "dn20:5.1": "‘Silokam anukassāmi; ",
  "dn20:5.2": "yattha bhummā tad assitā, ",
  "dn20:5.3": "Ye sitā giri-gabbharaṃ ",
  "dn20:5.4": "pahitattā samāhitā ",
  "dn20:5.5": "Puthū sīhā va sallīnā ",
  "dn20:5.6": "lomahaṃsābhisambhuno ",
  "dn20:5.7": "Odāta-manasā suddhā ",
  "dn20:5.8": "vippasannā-m-anāvilā ",
  "dn20:5.9": "Bhīyyo pañca-sate ñatvā ",
  "dn20:5.10": "vane Kāpilavatthave.' ",
  "dn20:5.11": "Tato āmantayi Satthā ",
  "dn20:5.12": "sāvake sāsane rate: ",
  "dn20:5.13": "‘Deva-kāyā abhikkantā ",
  "dn20:5.14": "te vijānātha bhikkhavo.' ",
  "dn20:5.15": "Te ca ātappam akaruṃ ",
  "dn20:5.16": "sutvā Buddhassa sāsanaṃ. 6. ",
  "dn20:6.1": "Tesaṃ pātur ahū ñāṇaṃ ",
  "dn20:6.2": "amanussāna dassanaṃ ",
  "dn20:6.3": "App eke satam addakkhuṃ ",
  "dn20:6.4": "sahassaṃ atha sattatiṃ ",
  "dn20:6.5": "Sataṃ eke sahassānaṃ ",
  "dn20:6.6": "amanussānam addasuṃ App eke 'nantam ",
  "dn20:6.7": "addakkhuṃ, ",
  "dn20:6.8": "disā sabbā phuṭā ahū. ",
  "dn20:6.9": "Tañ ca sabbaṃ abhiññāya ",
  "dn20:6.10": "vavakkhitvāna cakkhumā ",
  "dn20:6.11": "Tato āmantayi Satthā ",
  "dn20:6.12": "sāvake sāsane rate: ",
  "dn20:6.13": "‘Deva-kāyā abhikkantā ",
  "dn20:6.14": "te vijānātha bhikkhavo, ",
  "dn20:6.15": "Ye vo 'haṃ kittayissāmi ",
  "dn20:6.16": "girāhi anupubbaso. 7. ",
  "dn20:7.1": "Satta sahassā va yakkhā ",
  "dn20:7.2": "bhummā Kāpilavatthavā ",
  "dn20:7.3": "Iddhimanto jutīmanto ",
  "dn20:7.4": "vaṇṇavanto yasassino ",
  "dn20:7.5": "Modamānā abhikkāmuṃ ",
  "dn20:7.6": "bhikkhūnaṃ samitiṃ vanaṃ. ",
  "dn20:7.7": "Cha-sahassā Hemavatā ",
  "dn20:7.8": "yakkhā nānatta-vaṇṇino, ",
  "dn20:7.9": "Iddhimanto jutīmanto ",
  "dn20:7.10": "vaṇṇavanto yasassino, ",
  "dn20:7.11": "Modamānā abhikkāmuṃ ",
  "dn20:7.12": "bhikkhūnaṃ samitiṃ vanaṃ. ",
  "dn20:7.13": "Sātāgirā ti-sahassā ",
  "dn20:7.14": "yakkhā nānatta-vaṇṇino, ",
  "dn20:7.15": "Iddhimanto jutīmanto ",
  "dn20:7.16": "vaṇṇavanto yasassino, ",
  "dn20:7.17": "Modamānā abhikkāmuṃ ",
  "dn20:7.18": "bhikkhūnaṃ samitiṃ vanaṃ. ",
  "dn20:7.19": "Icc ete soḷasa-sahassā ",
  "dn20:7.20": "yakkhā nānatta-vaṇṇino, ",
  "dn20:7.21": "Iddhimanto jutīmanto ",
  "dn20:7.22": "vaṇṇavanto yasassino ",
  "dn20:7.23": "Modamānā abhikkāmuṃ ",
  "dn20:7.24": "bhikkhūnaṃ samitiṃ vanaṃ. 8. ",
  "dn20:8.1": "Vessāmittā pañca-satā ",
  "dn20:8.2": "yakkhā nānatta-vaṇṇino, ",
  "dn20:8.3": "Iddhimanto jutīmanto ",
  "dn20:8.4": "vaṇṇavanto yasassino, ",
  "dn20:8.5": "Modamānā abhikkāmuṃ ",
  "dn20:8.6": "bhikkhūnaṃ samitiṃ vanaṃ. ",
  "dn20:8.7": "Kumbhīro Rājagahiko ",
  "dn20:8.8": "Vepullassa nivesanaṃ, ",
  "dn20:8.9": "Bhiyyo naṃ sata-sahassaṃ ",
  "dn20:8.10": "yakkhānaṃ payirupāsati, ",
  "dn20:8.11": "Kumbhīro Rājagahiko ",
  "dn20:8.12": "so p' āga samitiṃ vanaṃ. 9. ",
  "dn20:9.1": "Purimañ ca disaṃ rājā ",
  "dn20:9.2": "Dhataraṭṭho pasāsati, ",
  "dn20:9.3": "Gandhabbānaṃ ādhipati ",
  "dn20:9.4": "Mahārājā yasassi so. ",
  "dn20:9.5": "Puttā pi tassa bahavo ",
  "dn20:9.6": "Inda-nāmā mahabbalā, ",
  "dn20:9.7": "Iddhimanto jutīmanto ",
  "dn20:9.8": "vaṇṇavanto yasassino, ",
  "dn20:9.9": "Modamānā abhikkāmuṃ ",
  "dn20:9.10": "bhikkhūnaṃ samitiṃ vanaṃ. ",
  "dn20:9.11": "Dakkhiṇañ ca disaṃ rājā ",
  "dn20:9.12": "Virūḷho taṃ pasāsati, ",
  "dn20:9.13": "Kumbhaṇḍānaṃ ādhipati ",
  "dn20:9.14": "Mahārājā yasassi so. ",
  "dn20:9.15": "Puttā pi tassa bahavo ",
  "dn20:9.16": "Inda-nāmā mahabbalā, ",
  "dn20:9.17": "Iddhimanto jutīmanto ",
  "dn20:9.18": "vaṇṇavanto yasassino, ",
  "dn20:9.19": "Modamānā abhikkāmuṃ ",
  "dn20:9.20": "bhikkhūnaṃ samitiṃ vanaṃ. ",
  "dn20:9.21": "Pacchimañ ca disaṃ rājā ",
  "dn20:9.22": "Virūpakkho pasāsati, ",
  "dn20:9.23": "Nāgānaṃ va ādhipati ",
  "dn20:9.24": "Mahārājā yasassi so. ",
  "dn20:9.25": "Puttā pi tassa bahavo ",
  "dn20:9.26": "Inda-nāmā mahabbalā, ",
  "dn20:9.27": "Iddhimanto jutīmanto ",
  "dn20:9.28": "vaṇṇavanto yasassino, ",
  "dn20:9.29": "Modamānā abhikkāmuṃ ",
  "dn20:9.30": "bhikkhūnaṃ samitiṃ vanaṃ. ",
  "dn20:9.31": "Uttarañ ca disaṃ rājā ",
  "dn20:9.32": "Kuvero taṃ pasāsati ",
  "dn20:9.33": "Yakkhānaṃ va ādhipati ",
  "dn20:9.34": "Mahārājā yasassi so. ",
  "dn20:9.35": "Puttā pi tassa bahavo ",
  "dn20:9.36": "Inda-nāmā mahabbalā, ",
  "dn20:9.37": "Iddhimanto jutīmanto ",
  "dn20:9.38": "vaṇṇavanto yasassino, ",
  "dn20:9.39": "Modamānā abhikkāmuṃ ",
  "dn20:9.40": "bhikkhūnaṃ samitiṃ vanaṃ. ",
  "dn20:9.41": "Purimaṃ disaṃ Dhataraṭṭho ",
  "dn20:9.42": "dakkhiṇena Virūḷhako ",
  "dn20:9.43": "Pacchimena Virūpakkho ",
  "dn20:9.44": "Kuvero uttaraṃ disaṃ. ",
  "dn20:9.45": "Cattāro te Mahārājā ",
  "dn20:9.46": "samantā caturo disā, ",
  "dn20:9.47": "Daddallamānā aṭṭhaṃsu ",
  "dn20:9.48": "vane Kāpilavatthave. 10. ",
  "dn20:10.1": "Tesaṃ māyāvino dāsā ",
  "dn20:10.2": "āgu vañcanikā saṭhā ",
  "dn20:10.3": "Māyā Kuṭeṇḍu Veṭeṇḍu ",
  "dn20:10.4": "Viṭuc ca Viṭucco saha ",
  "dn20:10.5": "Candano Kāmaseṭṭho ca ",
  "dn20:10.6": "Kinnughaṇḍu Nighaṇḍu ca ",
  "dn20:10.7": "Panādo Opamañño ca ",
  "dn20:10.8": "devasūto ca Mātali. ",
  "dn20:10.9": "Cittaseno ca gandhabbo ",
  "dn20:10.10": "Nalo rājā Janesabho ",
  "dn20:10.11": "Āgu Pañcasikho c' eva ",
  "dn20:10.12": "Timbarū Suriyavaccasā. ",
  "dn20:10.13": "Ete c' aññe ca rājāno ",
  "dn20:10.14": "gandhabbā saha rājubhi ",
  "dn20:10.15": "Modamānā abhikkāmuṃ ",
  "dn20:10.16": "bhikkhūnaṃ samitiṃ vanaṃ. 11. ",
  "dn20:11.1": "Ath' āgu Nābhasā nāgā ",
  "dn20:11.2": "Vesālā saha Tacchakā, ",
  "dn20:11.3": "Kambalassatarā āgu ",
  "dn20:11.4": "Pāyāgā saha ñātibhi. ",
  "dn20:11.5": "Yāmunā Dhataraṭṭhā ca ",
  "dn20:11.6": "āgu nāgā yasassino, ",
  "dn20:11.7": "Erāvaṇo mahā-nāgo ",
  "dn20:11.8": "so p' āga samitiṃ vanaṃ. ",
  "dn20:11.9": "Ye nāga-rāje sahasā haranti ",
  "dn20:11.10": "Dibbā dijā pakkhi visuddha-cakkhū ",
  "dn20:11.11": "Vehāsayā te vana-majjha-pattā ",
  "dn20:11.12": "Citrā Supaṇṇā iti tesaṃ nāmaṃ. ",
  "dn20:11.13": "Abhayan tadā nāga-rājānam āsi, ",
  "dn20:11.14": "Supaṇṇato khemam akāsi Buddho. ",
  "dn20:11.15": "Saṇhāhi vācāhi upavhayantā ",
  "dn20:11.16": "Nāgā Supaṇṇā saraṇaṃ agaṃsu Buddhaṃ. 12. ",
  "dn20:12.1": "Jitā Vajira-hatthena ",
  "dn20:12.2": "samuddaṃ Asurā sitā ",
  "dn20:12.3": "Bhātaro Vāsavass' ete ",
  "dn20:12.4": "iddhimanto yasassino ",
  "dn20:12.5": "Kālakañjā mahābhiṃsā ",
  "dn20:12.6": "asurā Dānaveghasā ",
  "dn20:12.7": "Vepacitti Sucitti ca ",
  "dn20:12.8": "Pahārādo Namucī saha ",
  "dn20:12.9": "Satañ ca Bali-puttānaṃ ",
  "dn20:12.10": "sabbe Veroca-nāmakā ",
  "dn20:12.11": "Sannayhitvā baliṃ senaṃ ",
  "dn20:12.12": "Rāhubhaddam upāgamuṃ: ",
  "dn20:12.13": "‘Samayo dāni bhaddan te ",
  "dn20:12.14": "bhikkhūnaṃ samitiṃ vanaṃ.' 13. ",
  "dn20:13.1": "Āpo ca devā Paṭhavī ",
  "dn20:13.2": "Tejo Vāyo tad āgamuṃ, ",
  "dn20:13.3": "Varuṇā Vāruṇā devā ",
  "dn20:13.4": "Somo ca Yasasā saha, ",
  "dn20:13.5": "Mettā-karuṇā-kāyikā ",
  "dn20:13.6": "āgu devā yasassino. ",
  "dn20:13.7": "Das' ete dasadhā kāyā ",
  "dn20:13.8": "sabbe nānatta-vaṇṇino ",
  "dn20:13.9": "Iddhimanto jutīmanto ",
  "dn20:13.10": "vaṇṇavanto yasassino ",
  "dn20:13.11": "Modamānā abhikkāmuṃ ",
  "dn20:13.12": "bhikkhūnaṃ samitiṃ vanaṃ. 14. ",
  "dn20:14.1": "Veṇhū ca devā Sahaḷī ca ",
  "dn20:14.2": "Asamā ca duve Yamā, ",
  "dn20:14.3": "Candassūpanisā devā ",
  "dn20:14.4": "Candam āgu purakkhatvā, ",
  "dn20:14.5": "Suriyassūpanisā devā ",
  "dn20:14.6": "Suriyam āgu purakkhatvā, ",
  "dn20:14.7": "Nakkhattāni purakkhatvā ",
  "dn20:14.8": "āgu Manda-valāhakā, ",
  "dn20:14.9": "Vasūnaṃ Vāsavo seṭṭho ",
  "dn20:14.10": "Sakko p' āga purindado. ",
  "dn20:14.11": "Das' ete dasadhā kāyā ",
  "dn20:14.12": "sabbe nānatta-vaṇṇino ",
  "dn20:14.13": "Iddhimanto jutīmanto ",
  "dn20:14.14": "vaṇṇavanto yasassino ",
  "dn20:14.15": "Modamānā abhikkāmuṃ ",
  "dn20:14.16": "bhikkhūnaṃ samitiṃ vanaṃ. 15. ",
  "dn20:15.1": "Ath' āgu Sahabhū devā ",
  "dn20:15.2": "jalam aggi-sikhā-r-iva, ",
  "dn20:15.3": "Ariṭṭhakā ca Rojā ca ",
  "dn20:15.4": "ummā-puppha-nibhāsino, ",
  "dn20:15.5": "Varuṇā Saha-dhammā ca ",
  "dn20:15.6": "Accutā ca Anejakā, ",
  "dn20:15.7": "Sūleyya-rucirā āgu, ",
  "dn20:15.8": "āgu Vāsavanesino. ",
  "dn20:15.9": "Das' ete dasadhā kāyā ",
  "dn20:15.10": "sabbe nānatta-vaṇṇino ",
  "dn20:15.11": "Iddhimanto jutīmanto ",
  "dn20:15.12": "vaṇṇavanto yasassino ",
  "dn20:15.13": "Modamānā abhikkāmuṃ ",
  "dn20:15.14": "bhikkhūnaṃ samitiṃ vanaṃ. 16. ",
  "dn20:16.1": "Samānā Mahā-samānā ",
  "dn20:16.2": "Mānusā Mānusuttamā ",
  "dn20:16.3": "Khiḍḍā-padūsikā āgu, āgu ",
  "dn20:16.4": "Mano-padūsikā, Ath' ",
  "dn20:16.5": "āgu Harayo devā ",
  "dn20:16.6": "ye ca Lohita-vāsino ",
  "dn20:16.7": "Pāragā Mahā-pāragā ",
  "dn20:16.8": "āgu devā yasassino. ",
  "dn20:16.9": "Das' ete dasadhā kāyā ",
  "dn20:16.10": "sabbe nānatta-vaṇṇino ",
  "dn20:16.11": "Iddhimanto jutīmanto ",
  "dn20:16.12": "vaṇṇavanto yasassino ",
  "dn20:16.13": "Modamānā abhikkāmuṃ ",
  "dn20:16.14": "bhikkhūnaṃ samitiṃ vanaṃ. 17. ",
  "dn20:17.1": "Sukkā Karumhā Aruṇā ",
  "dn20:17.2": "āgu Veghanasā saha, ",
  "dn20:17.3": "Odāta-gayhā pāmokkhā ",
  "dn20:17.4": "āgu devā Vicakkhaṇā, ",
  "dn20:17.5": "Sadāmattā Hāragajā ",
  "dn20:17.6": "Missakā ca yasassino, ",
  "dn20:17.7": "Thanayaṃ āga Pajjunno ",
  "dn20:17.8": "yo disā abhivassati. ",
  "dn20:17.9": "Das' ete dasadhā kāyā ",
  "dn20:17.10": "sabbe nānatta-vaṇṇino ",
  "dn20:17.11": "Iddhimanto jutīmanto ",
  "dn20:17.12": "vaṇṇavanto yasassino ",
  "dn20:17.13": "Modamānā abhikkāmuṃ ",
  "dn20:17.14": "bhikkhūnaṃ samitiṃ vanaṃ. 18. ",
  "dn20:18.1": "Khemiyā Tusitā Yāmā ",
  "dn20:18.2": "Kaṭṭhakā ca yasassino, ",
  "dn20:18.3": "Lambītakā Lāma-seṭṭhā ",
  "dn20:18.4": "Joti-nāmā ca Āsavā, ",
  "dn20:18.5": "Nimmāna-ratino āgu, ath' ",
  "dn20:18.6": "āgu Paranimmitā. ",
  "dn20:18.7": "Das' ete dasadhā kāyā ",
  "dn20:18.8": "sabbe nānatta-vaṇṇino ",
  "dn20:18.9": "Iddhimanto jutīmanto ",
  "dn20:18.10": "vaṇṇavanto yasassino ",
  "dn20:18.11": "Modamānā abhikkāmuṃ ",
  "dn20:18.12": "bhikkhūnaṃ samitiṃ vanaṃ. 19. ",
  "dn20:19.1": "Saṭṭh' ete deva-nikāyā ",
  "dn20:19.2": "sabbe nānatta-vaṇṇino, ",
  "dn20:19.3": "Nāmanvayena āgañchuṃ ",
  "dn20:19.4": "ye c' aññe sadisā saha. ",
  "dn20:19.5": "‘Pavuttha-jātiṃ akhilaṃ ",
  "dn20:19.6": "ogha-tiṇṇaṃ anāsavaṃ ",
  "dn20:19.7": "Dakkhem' ogha-taraṃ nāgaṃ ",
  "dn20:19.8": "candaṃ va asitātigaṃ.' 20. ",
  "dn20:20.1": "Subrahmā Paramatto ca ",
  "dn20:20.2": "puttā iddhimato saha ",
  "dn20:20.3": "Sanaṃ-kumāro Tisso ca ",
  "dn20:20.4": "so p' āga samitiṃ vanaṃ. ",
  "dn20:20.5": "Sahassa-Brahmalokānaṃ ",
  "dn20:20.6": "Mahā-Brahmā 'bhitiṭṭhati, ",
  "dn20:20.7": "Upapanno jutīmanto ",
  "dn20:20.8": "bhismā-kāyo yasassi so. ",
  "dn20:20.9": "Das' ettha issarā āgu ",
  "dn20:20.10": "pacceka-vasavattino, ",
  "dn20:20.11": "Tesañ ca majjhato āga ",
  "dn20:20.12": "Hārito parivārito. 21. ",
  "dn20:21.1": "Te ca sabbe abhikkante ",
  "dn20:21.2": "sa-Inda-deve sa-Brahmake, ",
  "dn20:21.3": "Māra-senā abhikkāmi, ",
  "dn20:21.4": "passa Kaṇhassa mandiyaṃ. ",
  "dn20:21.5": "‘Etha gaṇhatha bandhatha ",
  "dn20:21.6": "rāgena baddham atthu ve ",
  "dn20:21.7": "Samantā parivāretha ",
  "dn20:21.8": "mā vo muñcittha koci naṃ.' ",
  "dn20:21.9": "Iti tattha Mahā-seno ",
  "dn20:21.10": "Kaṇha-senaṃ apesayi, ",
  "dn20:21.11": "Pāṇinā talam āhacca ",
  "dn20:21.12": "saraṃ katvāna bheravaṃ. ",
  "dn20:21.13": "Yathā pāvussako megho ",
  "dn20:21.14": "thanayanto savijjuko, ",
  "dn20:21.15": "Tadā so paccudāvatti ",
  "dn20:21.16": "saṃkuddho asayaṃvasī. 22. ",
  "dn20:22.1": "Tañ ca sabbaṃ abhiññāya ",
  "dn20:22.2": "vavakkhitvāna cakkhumā ",
  "dn20:22.3": "Tato āmantayi Satthā ",
  "dn20:22.4": "sāvake sāsane rate: ",
  "dn20:22.5": "‘Māra-senā abhikkantā, ",
  "dn20:22.6": "te vijānātha bhikkhavo.' ",
  "dn20:22.7": "Te ca ātappam akaruṃ ",
  "dn20:22.8": "sutvā Buddhassa sāsanaṃ. ",
  "dn20:22.9": "Vīta-rāgehi pakkāmuṃ ",
  "dn20:22.10": "na saṃ lomaṃ pi iñjayuṃ. ",
  "dn20:22.11": "Sabbe vijita-saṃgāmā ",
  "dn20:22.12": "bhayātītā yasassino ",
  "dn20:22.13": "Modanti saha bhūtehi ",
  "dn20:22.14": "sāvakā te jane sutā ti. ",
  "dn20:22.15": "NIṬṬHITAṂ. 1.1. "
}
