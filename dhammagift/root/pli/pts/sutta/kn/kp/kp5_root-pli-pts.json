{
  "kp5:0.1": "",
  "kp5:0.2": "",
  "kp5:1.1": "Evam me sutaṃ: ",
  "kp5:1.2": "Ekaṃ samayaṃ Bhagavā Sāvatthiyaṃ viharati Jetavane Anāthapiṇḍikassa ārāme. ",
  "kp5:1.3": "Atha kho aññatarā devatā abhikkantāya rattiyā abhikkantavaṇṇā kevalakappaṃ Jetavanaṃ obhāsetvā yena Bhagavā ten' upasaṃkami, upasaṃkamitvā Bhagavantaṃ abhivādetvā ekamantaṃ aṭṭhāsi. ",
  "kp5:1.4": "Ekamantaṃ ṭhitā kho sā devatā Bhagavantam gāthāya ajjhabhāsi: ",
  "kp5:2.1": "\"Bahū devā manussā ca ",
  "kp5:2.2": "maṅgalāni acintayuṃ ",
  "kp5:2.3": "ākaṃkhamānā sotthānaṃ, ",
  "kp5:2.4": "brūhi maṅgalam uttamaṃ.\" 1. ",
  "kp5:3.1": "\"Asevanā ca bālānaṃ ",
  "kp5:3.2": "paṇḍitānañ ca sevanā ",
  "kp5:3.3": "pūjā ca pūjaneyyānaṃ, ",
  "kp5:3.4": "etam maṅgalam uttamaṃ. 2. ",
  "kp5:4.1": "Patirūpadesavāso ca ",
  "kp5:4.2": "pubbe ca katapuññatā ",
  "kp5:4.3": "attasammāpaṇidhi ca, ",
  "kp5:4.4": "etam maṅgalam uttamaṃ. 3. ",
  "kp5:5.1": "Bāhusaccañ ca sippañ ca ",
  "kp5:5.2": "vinayo ca susikkhito ",
  "kp5:5.3": "subhāsitā ca yā vācā, ",
  "kp5:5.4": "etam maṅgalam uttamaṃ. 4. ",
  "kp5:6.1": "Mātāpitūpaṭṭhānaṃ ",
  "kp5:6.2": "puttadārassa saṅgaho ",
  "kp5:6.3": "anākulā ca kammantā, ",
  "kp5:6.4": "etam maṅgalam uttamaṃ. 5. ",
  "kp5:7.1": "Dānañ ca dhammacariyā ca ",
  "kp5:7.2": "ñātakānañ ca saṅgaho ",
  "kp5:7.3": "anavajjāni kammāni, ",
  "kp5:7.4": "etam maṅgalam uttamaṃ. 6. ",
  "kp5:8.1": "Āratī viratī pāpā ",
  "kp5:8.2": "majjapānā ca saññamo ",
  "kp5:8.3": "appamādo ca dhammesu, ",
  "kp5:8.4": "etam maṅgalam uttamaṃ. 7. ",
  "kp5:9.1": "Gāravo ca nivāto ca ",
  "kp5:9.2": "santuṭṭhī ca kataññutā ",
  "kp5:9.3": "kālena dhammasavanaṃ, ",
  "kp5:9.4": "etam maṅgalam uttamaṃ. 8. ",
  "kp5:10.1": "Khantī ca sovacassatā ",
  "kp5:10.2": "samaṇānañ ca dassanaṃ ",
  "kp5:10.3": "kālena dhammasākacchā, ",
  "kp5:10.4": "etam maṅgalam uttamaṃ. 9. ",
  "kp5:11.1": "Tapo ca brahmacariyañ ca ",
  "kp5:11.2": "ariyasaccānā dassanaṃ ",
  "kp5:11.3": "nibbānasacchikiriyā ca, ",
  "kp5:11.4": "etam maṅgalam uttamaṃ. 10. ",
  "kp5:12.1": "Phuṭṭhassa lokadhammehi ",
  "kp5:12.2": "cittaṃ yassa na kampati ",
  "kp5:12.3": "asokaṃ virajaṃ khemaṃ, ",
  "kp5:12.4": "etam maṅgalam uttamaṃ. 11. ",
  "kp5:13.1": "Etādisāni katvāna ",
  "kp5:13.2": "sabbattha-m-aparājitā ",
  "kp5:13.3": "sabbattha sotthiṃ gacchanti, ",
  "kp5:13.4": "taṃ tesaṃ maṅgalam uttamaṃ.\" 12. ",
  "kp5:14.1": "MAṄGALASUTTAṂ NIṬṬHITAṂ. "
}
