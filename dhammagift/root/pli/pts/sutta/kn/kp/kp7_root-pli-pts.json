{
  "kp7:0.1": "",
  "kp7:0.2": "",
  "kp7:1.1": "tiṭṭhanti ",
  "kp7:1.2": "sandhisiṃghāṭakesu ca ",
  "kp7:1.3": "dvārabāhāsu tiṭṭhanti ",
  "kp7:1.4": "āgantvāna sakaṃ gharaṃ, 1. ",
  "kp7:2.1": "pahūte annapānamhi ",
  "kp7:2.2": "khajjabhojje upaṭṭhite ",
  "kp7:2.3": "na tesaṃ koci sarati ",
  "kp7:2.4": "sattānaṃ kammapaccayā. 2. ",
  "kp7:3.1": "Evaṃ dadanti ñātīnaṃ ",
  "kp7:3.2": "ye honti anukampakā ",
  "kp7:3.3": "suciṃ paṇītaṃ kālena ",
  "kp7:3.4": "kappiyaṃ pānabhojanaṃ: 3. ",
  "kp7:4.1": "'idaṃ vo ñātinaṃ hotu, ",
  "kp7:4.2": "sukhitā hontu ñātayo.' ",
  "kp7:4.3": "Te ca tattha samāgantvā ",
  "kp7:4.4": "ñātipetā samāgatā 4. ",
  "kp7:5.1": "pahūte annapānamhi ",
  "kp7:5.2": "sakkaccaṃ anumodare: ",
  "kp7:5.3": "'ciraṃ jīvantu no ñātī, ",
  "kp7:5.4": "yesaṃ hetu labhāmase; 5. ",
  "kp7:6.1": "amhākañ ca katā pūjā ",
  "kp7:6.2": "dāyakā ca anipphalā.' ",
  "kp7:6.3": "Na hi tattha kasī atthi, ",
  "kp7:6.4": "gorakkh' ettha na vijjati, 6. ",
  "kp7:7.1": "vaṇijjā tādisī n' atthi ",
  "kp7:7.2": "hiraññena kayakkayaṃ, ",
  "kp7:7.3": "ito dinnena yāpenti ",
  "kp7:7.4": "petā kālagatā tahiṃ. 7. ",
  "kp7:8.1": "Unname udakaṃ vaṭṭaṃ ",
  "kp7:8.2": "yathā ninnaṃ pavattati, ",
  "kp7:8.3": "evam eva ito dinnaṃ ",
  "kp7:8.4": "petānaṃ upakappati. 8. ",
  "kp7:9.1": "Yathā vārivahā pūrā ",
  "kp7:9.2": "paripūrenti sāgaraṃ, ",
  "kp7:9.3": "evam eva ito dinnaṃ ",
  "kp7:9.4": "petānaṃ upakappati. 9. ",
  "kp7:10.1": "'Adāsi me, akāsi me, ",
  "kp7:10.2": "ñātimittā sakhā ca me' ",
  "kp7:10.3": "petānaṃ dakkhiṇaṃ dajjā ",
  "kp7:10.4": "pubbe katam anussaraṃ. 10. ",
  "kp7:11.1": "Na hi ruṇṇaṃ vā soko vā ",
  "kp7:11.2": "yā c' aññā paridevanā, ",
  "kp7:11.3": "na taṃ petānaṃ atthāya: ",
  "kp7:11.4": "evaṃ tiṭṭhanti ñātayo. 11. ",
  "kp7:12.1": "Ayañ ca kho dakkhiṇā dinnā ",
  "kp7:12.2": "saṃghamhi suppatiṭṭhitā ",
  "kp7:12.3": "dīgharattaṃ hitāy' assa ",
  "kp7:12.4": "ṭhānaso upakappati. 12. ",
  "kp7:13.1": "So ñātidhammo ca ayaṃ nidassito, ",
  "kp7:13.2": "petānaṃ pūjā ca katā uḷārā, ",
  "kp7:13.3": "balañ ca bhikkhūnam anuppadinnaṃ, ",
  "kp7:13.4": "tumhehi puññaṃ pasutaṃ anappakaṃ. 13. TIROKUḌḌASUTTAṂ ",
  "kp7:14.1": "NIṬṬHITAṂ. "
}
