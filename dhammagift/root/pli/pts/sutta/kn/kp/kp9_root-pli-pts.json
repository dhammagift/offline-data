  "kp9:0.1": "",
  "kp9:0.2": "",
  "kp9:1.1": "",
  "kp9:1.2": "santaṃ padaṃ abhisamecca ",
  "kp9:1.3": "sakko ujū ca sūjū ca ",
  "kp9:1.4": "suvaco c' assa mudu anatimānī 1. ",
  "kp9:2.1": "santussako ca subharo ca ",
  "kp9:2.2": "appakicco ca sallahukavutti ",
  "kp9:2.3": "santindriyo ca nipako ca ",
  "kp9:2.4": "appagabbho kulesu ananugiddho, 2. ",
  "kp9:3.1": "na ca khuddaṃ samācare kiñci ",
  "kp9:3.2": "yena viññū pare upavadeyyuṃ. ",
  "kp9:3.3": "Sukhino vā khemino hontu ",
  "kp9:3.4": "sabbe sattā bhavantu sukhitattā: 3. ",
  "kp9:4.1": "ye keci pāṇabhūt' atthi ",
  "kp9:4.2": "tasā vā thāvarā vā anavasesā ",
  "kp9:4.3": "dīghā vā ye mahantā vā ",
  "kp9:4.4": "majjhimā rassakā aṇukathūlā, 4. ",
  "kp9:5.1": "diṭṭhā vā ye vā addiṭṭhā ",
  "kp9:5.2": "ye ca dūre vasanti avidūre, ",
  "kp9:5.3": "bhūtā vā sambhavesī vā; ",
  "kp9:5.4": "sabbe sattā bhavantu sukhitattā. 5. ",
  "kp9:6.1": "Na paro paraṃ nikubbetha ",
  "kp9:6.2": "nātimaññetha katthacinaṃ kañci, ",
  "kp9:6.3": "vyārosanā paṭighasaññā ",
  "kp9:6.4": "nāññamaññassa dukkham iccheyya. 6. ",
  "kp9:7.1": "Mātā yathā niyaṃ puttaṃ ",
  "kp9:7.2": "āyusā ekaputtam anurakkhe, ",
  "kp9:7.3": "evam pi sabbabhūtesu ",
  "kp9:7.4": "mānasam bhāvaye aparimāṇaṃ. 7. ",
  "kp9:8.1": "Mettañ ca sabbalokasmiṃ ",
  "kp9:8.2": "mānasam bhāvaye aparimāṇaṃ ",
  "kp9:8.3": "uddhaṃ adho ca tiriyañ ca ",
  "kp9:8.4": "asambādhaṃ averaṃ asapattaṃ. 8. ",
  "kp9:9.1": "Tiṭṭhaṃ caraṃ nisinno vā ",
  "kp9:9.2": "sayāno vā yāvat' assa vigatamiddho, ",
  "kp9:9.3": "etaṃ satiṃ adhiṭṭheyya; ",
  "kp9:9.4": "brahmam etaṃ vihāraṃ idha-m-āhu. 9. ",
  "kp9:10.1": "Diṭṭhiñ ca anupagamma ",
  "kp9:10.2": "sīlavā dassanena sampanno ",
  "kp9:10.3": "kāmesu vineyya gedhaṃ ",
  "kp9:10.4": "na hi jātu gabbhaseyyaṃ punar eti. 10. ",
  "kp9:11.1": "METTASUTTAṂ NIṬṬHITAṂ. KHUDDAKAPĀṬHAPPAKARAṆAṂ NIṬṬHITAṂ. ",
  "kp9:12.1": ""
}
