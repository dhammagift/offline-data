{
  "kp6:0.1": "",
  "kp6:0.2": "",
  "kp6:1.1": "Yānīdha bhūtāni samāgatāni ",
  "kp6:1.2": "bhummāni vā yāni va antalikkhe, ",
  "kp6:1.3": "sabbe va bhūtā sumanā bhavantu ",
  "kp6:1.4": "atho pi sakkacca suṇantu bhāsitaṃ. 1. ",
  "kp6:2.1": "Tasmā hi bhūtā nisāmetha sabbe ",
  "kp6:2.2": "mettaṃ karotha mānusiyā pajāya, ",
  "kp6:2.3": "divā ca ratto ca haranti ye baliṃ, ",
  "kp6:2.4": "tasmā hi ne rakkhatha appamattā. 2. ",
  "kp6:3.1": "Yaṃ kiñci vittam idha vā huraṃ vā ",
  "kp6:3.2": "saggesu vā yaṃ ratanaṃ paṇītaṃ ",
  "kp6:3.3": "na no samaṃ atthi Tathāgatena, -- ",
  "kp6:3.4": "idam pi Buddhe ratanaṃ paṇītaṃ, ",
  "kp6:3.5": "etena saccena suvatthi hotu. 3. ",
  "kp6:4.1": "Khayaṃ virāgaṃ amataṃ paṇītaṃ ",
  "kp6:4.2": "yad ajjhagā Sakyamunī samāhito, ",
  "kp6:4.3": "na tena dhammena sam' atthi kiñci, -- ",
  "kp6:4.4": "idam pi Dhamme ratanaṃ paṇītaṃ, ",
  "kp6:4.5": "etena saccena suvatthi hotu. 4. ",
  "kp6:5.1": "Yam buddhaseṭṭho parivaṇṇayī suciṃ ",
  "kp6:5.2": "samādhim ānantarikañ ñam āhu, ",
  "kp6:5.3": "samādhinā tena samo na vijjati, -- ",
  "kp6:5.4": "idam pi Dhamme ratanam paṇītaṃ, ",
  "kp6:5.5": "etena saccena suvatthi hotu. 5. ",
  "kp6:6.1": "Ye puggalā aṭṭha satam pasatthā, ",
  "kp6:6.2": "cattāri etāni yugāni honti, ",
  "kp6:6.3": "te dakkhiṇeyyā Sugatassa sāvakā, ",
  "kp6:6.4": "etesu dinnāni mahapphalāni, -- ",
  "kp6:6.5": "idam pi Saṃghe ratanaṃ paṇītaṃ, ",
  "kp6:6.6": "etena saccena suvatthi hotu. 6. ",
  "kp6:7.1": "Ye suppayuttā manasā daḷhena ",
  "kp6:7.2": "nikkāmino Gotamasāsanamhi, ",
  "kp6:7.3": "te pattipattā amataṃ vigayha ",
  "kp6:7.4": "laddhā mudhā nibbutiṃ bhuñjamānā, -- ",
  "kp6:7.5": "idam pi Saṃghe ratanaṃ paṇītaṃ, ",
  "kp6:7.6": "etena saccena suvatthi hotu. 7. ",
  "kp6:8.1": "Yath' indakhīlo paṭhaviṃ sito siyā ",
  "kp6:8.2": "catubbhi vātehi asampakampiyo, ",
  "kp6:8.3": "tathūpamaṃ sappurisaṃ vadāmi, ",
  "kp6:8.4": "yo ariyasaccāni avecca passati, -- ",
  "kp6:8.5": "idam pi Saṃghe ratanaṃ paṇītaṃ, ",
  "kp6:8.6": "etena saccena suvatthi hotu. 8. ",
  "kp6:9.1": "Ye ariyasaccāni vibhāvayanti ",
  "kp6:9.2": "gambhīrapaññena sudesitāni, ",
  "kp6:9.3": "kiñcāpi te honti bhusappamattā, ",
  "kp6:9.4": "na te bhavaṃ aṭṭhamaṃ ādiyanti, -- ",
  "kp6:9.5": "idam pi Saṃghe ratanaṃ paṇītaṃ, ",
  "kp6:9.6": "etena saccena suvatthi hotu. 9. ",
  "kp6:10.1": "Sahā v' assa dassanasampadāya ",
  "kp6:10.2": "tayas su dhammā jahitā bhavanti: ",
  "kp6:10.3": "sakkāyadiṭṭhi vicikicchitañ ca ",
  "kp6:10.4": "sīlabbataṃ vā pi yad atthi kiñci ",
  "kp6:11.1": "catūh' apāyehi ca vippamutto ",
  "kp6:11.2": "cha cābhiṭhānāni abhabbo kātuṃ, -- ",
  "kp6:11.3": "idam pi Saṃghe ratanaṃ paṇītaṃ, ",
  "kp6:11.4": "etena saccena suvatthi hotu. 10. ",
  "kp6:12.1": "Kiñcāpi so kammaṃ karoti pāpakaṃ ",
  "kp6:12.2": "kāyena vācā uda cetasā vā, ",
  "kp6:12.3": "abhabbo so tassa paṭicchādāya, ",
  "kp6:12.4": "abhabbatā diṭṭhapadassa vuttā, -- ",
  "kp6:12.5": "idam pi Saṃghe ratanaṃ paṇītaṃ, ",
  "kp6:12.6": "etena saccena suvatthi hotu. 11. ",
  "kp6:13.1": "Vanappagumbe yathā phussitagge ",
  "kp6:13.2": "gimhāna māse paṭhamasmiṃ gimhe, ",
  "kp6:13.3": "tathūpamaṃ dhammavaraṃ adesayi ",
  "kp6:13.4": "nibbānagāmiṃ paramaṃhitāya, -- ",
  "kp6:13.5": "idam pi Buddhe ratanam paṇītaṃ, ",
  "kp6:13.6": "etena saccena suvatthi hotu. 12. ",
  "kp6:14.1": "Varo varaññū varado varāharo ",
  "kp6:14.2": "anuttaro dhammavaraṃ adesayi, -- ",
  "kp6:14.3": "idam pi Buddhe ratanaṃ paṇītaṃ, ",
  "kp6:14.4": "etena saccena suvatthi hotu. 13. ",
  "kp6:15.1": "'Khīṇaṃ purāṇaṃ, navaṃ n' atthi-sambhavaṃ' ",
  "kp6:15.2": "virattacittā āyatike bhavasmiṃ ",
  "kp6:15.3": "te khīṇabījā avirūḷhichandā ",
  "kp6:15.4": "nibbanti dhīrā yathāyam padīpo, -- ",
  "kp6:15.5": "idam pi Saṃghe ratanaṃ paṇītaṃ, ",
  "kp6:15.6": "etena saccena suvatthi hotu. 14. ",
  "kp6:16.1": "Yānīdha bhūtāni samāgatāni ",
  "kp6:16.2": "bhummāni vā yāni va antalikkhe, ",
  "kp6:16.3": "tathāgataṃ devamanussapūjitaṃ ",
  "kp6:16.4": "Buddhaṃ namassāma, suvatthi hotu. 15. ",
  "kp6:17.1": "Yānīdha bhūtāni samāgatāni ",
  "kp6:17.2": "bhummāni vā yāni va antalikkhe, ",
  "kp6:17.3": "tathāgataṃ devamanussapūjitaṃ ",
  "kp6:17.4": "Dhammaṃ namassāma, suvatthi hotu. 16. ",
  "kp6:18.1": "Yānīdha bhūtāni samāgatāni ",
  "kp6:18.2": "bhummāni vā yāni va antalikkhe, ",
  "kp6:18.3": "tathāgataṃ devamanussapūjitaṃ ",
  "kp6:18.4": "Saṃghaṃ namassāma, suvatthi hotu. 17. ",
  "kp6:19.1": "RATANASUTTAṂ NIṬṬHITAṂ. Tiro-kuḍḍesu "
}
