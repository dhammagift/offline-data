  "kp8:0.1": "",
  "kp8:0.2": "",
  "kp8:1.1": "Nidhiṃ nidheti puriso ",
  "kp8:1.2": "gambhīre odakantike: ",
  "kp8:1.3": "'atthe kicce samuppanne ",
  "kp8:1.4": "atthāya me bhavissati 1. ",
  "kp8:2.1": "rājato vā duruttassa ",
  "kp8:2.2": "corato pīḷitassa vā, ",
  "kp8:2.3": "iṇassa vā pamokkhāya, ",
  "kp8:2.4": "dubbhikkhe āpadāsu vā' ",
  "kp8:2.5": "etadatthāya lokasmiṃ ",
  "kp8:2.6": "nidhi nāma nidhīyate. 2. Tāva- ",
  "kp8:3.1": "sunihito santo ",
  "kp8:3.2": "gambhīre odakantike ",
  "kp8:3.3": "na sabbo sabbadā eva ",
  "kp8:3.4": "tassa taṃ upakappati: 3. ",
  "kp8:4.1": "nidhī vā ṭhānā cavati, ",
  "kp8:4.2": "saññā vāssa vimuyhati, ",
  "kp8:4.3": "nāgā vā apanāmenti ",
  "kp8:4.4": "yakkhā vā pi haranti naṃ 4. ",
  "kp8:5.1": "appiyā vā pi dāyādā ",
  "kp8:5.2": "uddharanti apassato; ",
  "kp8:5.3": "yadā puññakkhayo hoti, ",
  "kp8:5.4": "sabbam etaṃ vinassati. 5. ",
  "kp8:6.1": "Yassa dānena sīlena ",
  "kp8:6.2": "saṃyamena damena ca ",
  "kp8:6.3": "nidhī sunihito hoti ",
  "kp8:6.4": "itthiyā purisassa vā 6. ",
  "kp8:7.1": "cetiyamhi va saṃghe vā ",
  "kp8:7.2": "puggale atithīsu vā ",
  "kp8:7.3": "mātari pitari vā pi ",
  "kp8:7.4": "atho jeṭṭhamhi bhātari, 7. ",
  "kp8:8.1": "eso nidhi sunihito ",
  "kp8:8.2": "ajeyyo anugāmiko, ",
  "kp8:8.3": "pahāya gamanīyesu ",
  "kp8:8.4": "etaṃ ādāya gacchati 8. ",
  "kp8:9.1": "asādhāraṇam aññesaṃ: ",
  "kp8:9.2": "acorāharaṇo nidhi; ",
  "kp8:9.3": "kayirātha dhīro puññāni, ",
  "kp8:9.4": "yo nidhi anugāmiko. 9. ",
  "kp8:10.1": "Esa devamanussānaṃ ",
  "kp8:10.2": "sabbakāmadado nidhi, ",
  "kp8:10.3": "yaṃ yad evābhipatthenti, ",
  "kp8:10.4": "sabbam etena labbhati: 10. ",
  "kp8:11.1": "suvaṇṇatā sussaratā ",
  "kp8:11.2": "susaṇṭhānasurūpatā ",
  "kp8:11.3": "ādhipaccaparivāro, ",
  "kp8:11.4": "sabbam etena labbhati, 11. ",
  "kp8:12.1": "padesarajjaṃ issariyaṃ ",
  "kp8:12.2": "cakkavattisukham pi yaṃ ",
  "kp8:12.3": "devarajjam pi dibbesu, ",
  "kp8:12.4": "sabbam etena labbhati, 12. ",
  "kp8:13.1": "mānusikā ca sampatti ",
  "kp8:13.2": "devaloke ca yā rati ",
  "kp8:13.3": "yā ca nibbānasampatti, ",
  "kp8:13.4": "sabbam etena labbhati, 13. ",
  "kp8:14.1": "mittasampadam āgamma yoniso ",
  "kp8:14.2": "ve payuñjato ",
  "kp8:14.3": "vijjā vimutti vasībhāvo, ",
  "kp8:14.4": "sabbam etena labbhati, 14. ",
  "kp8:15.1": "paṭisambhidā vimokkhā ca ",
  "kp8:15.2": "yā ca sāvakapāramī ",
  "kp8:15.3": "paccekabodhi buddhabhūmi, ",
  "kp8:15.4": "sabbam etena labbhati; 15. ",
  "kp8:16.1": "evaṃ mahatthikā esā ",
  "kp8:16.2": "yadidaṃ puññasampadā, ",
  "kp8:16.3": "tasmā dhīrā pasaṃsanti ",
  "kp8:16.4": "paṇḍitā katapuññataṃ. 16. ",
  "kp8:17.1": "NIDHIKAṆḌASUTTAṂ NIṬṬHITAṂ. Karaṇīyam atthakusalena yan taṃ "
}
