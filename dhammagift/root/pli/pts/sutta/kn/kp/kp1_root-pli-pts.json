  "kp1:1.1": "",
  "kp1:2.1": "Khuddaka-Pāṭha. I. Buddhaṃ saraṇaṃ gacchāmi ",
  "kp1:2.2": "dhammaṃ saraṇaṃ gacchāmi ",
  "kp1:2.3": "saṃghaṃ saraṇaṃ gacchāmi. ",
  "kp1:3.1": "Dutiyam pi buddhaṃ saraṇaṃ gacchāmi ",
  "kp1:3.2": "dutiyam pi dhammaṃ saraṇaṃ gacchāmi ",
  "kp1:3.3": "dutiyam pi saṃghaṃ saraṇaṃ gacchāmi. ",
  "kp1:4.1": "Tatiyam pi buddhaṃ saraṇaṃ gacchāmi ",
  "kp1:4.2": "tatiyam pi dhammaṃ saraṇaṃ gacchāmi ",
  "kp1:4.3": "tatiyam pi saṃghaṃ saraṇaṃ gacchāmi. 1. ",
  "kp1:5.1": ""
}
