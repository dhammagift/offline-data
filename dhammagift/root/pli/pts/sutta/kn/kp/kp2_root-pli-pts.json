  "kp2:1.1": "Pāṇātipātā veramaṇī-sikkhāpadaṃ samādiyāmi, 2. ",
  "kp2:2.1": "adinnādānā veramaṇī-sikkhāpadaṃ samādiyāmi, 3. ",
  "kp2:3.1": "abrahmacariyā veramaṇī-sikkhāpadaṃ samādiyāmi, 4. ",
  "kp2:4.1": "musāvādā veramaṇī-sikkhāpadaṃ samādiyāmi, 5. ",
  "kp2:5.1": "surāmerayamajjapamādaṭṭhānā veramaṇī-sikkhāpa- daṃ samādiyāmi, 6. ",
  "kp2:6.1": "vikālabhojanā veramaṇī-sikkhāpadaṃ samādiyāmi, 7. ",
  "kp2:7.1": "naccagītavāditavisūkadassanā veramaṇī-sikkhāpadaṃ samādiyāmi, 8. ",
  "kp2:8.1": "mālāgandhavilepanadhāraṇa-maṇḍanavibhūsanaṭṭhā- nā veramaṇī-sikkhāpadaṃ samādiyāmi, 9. ",
  "kp2:9.1": "uccāsayanamahāsayanā veramaṇī-sikkhāpadaṃ sa- mādiyāmi, 10. ",
  "kp2:10.1": "jātarūparajatapaṭiggahaṇā veramaṇī-sikkhāpadaṃ samādiyāmi. ",
  "kp2:11.1": ""
}
