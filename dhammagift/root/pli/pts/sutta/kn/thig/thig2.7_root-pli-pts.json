  "thig2.7:0.3": "",
  "thig2.7:1.1": "",
  "thig2.7:1.2": "yā ca pakkhassa aṭṭhamī | ",
  "thig2.7:1.3": "pārihārikapakkhañ ca ",
  "thig2.7:1.4": "aṭṭhaṅgasusamāgataṃ | ",
  "thig2.7:2.1": "uposathaṃ upagacchiṃ ",
  "thig2.7:2.2": "devakāyābhinandinī. ",
  "thig2.7:2.3": "sājja ekena bhattena ",
  "thig2.7:2.4": "muṇḍā saṃghāṭipārutā | ",
  "thig2.7:2.5": "devakāyaṃ na patthe 'haṃ ",
  "thig2.7:2.6": "vineyya hadaye daraṃ. ",
  "thig2.7:3.1": "Mittā. || "
}
