{
  "thig5.7:0.1": "",
  "thig5.7:0.2": "",
  "thig5.7:0.3": "",
  "thig5.7:1.1": "agārasmiṃ vasantī 'haṃ ",
  "thig5.7:1.2": "dhammaṃ sutvāna bhikkhuno | ",
  "thig5.7:1.3": "addasaṃ virajaṃ dhammaṃ ",
  "thig5.7:1.4": "nibbānaṃ padam accutaṃ. ",
  "thig5.7:2.1": "sāhaṃ puttadhītarañ ca ",
  "thig5.7:2.2": "dhanadhaññañ ca chaḍḍiya | ",
  "thig5.7:2.3": "kese chedāpayitvāna ",
  "thig5.7:2.4": "pabbajiṃ anagāriyaṃ. ",
  "thig5.7:3.1": "sikkhamānā ahaṃ santiṃ ",
  "thig5.7:3.2": "bhāventī maggam añjasaṃ | ",
  "thig5.7:3.3": "pahāsiṃ rāgadosañ ca ",
  "thig5.7:3.4": "tadekaṭṭhe ca āsave. ",
  "thig5.7:4.1": "bhikkhunī upasampajja ",
  "thig5.7:4.2": "pubbajātim anussariṃ | ",
  "thig5.7:4.3": "dibbacakkhuṃ visodhitaṃ ",
  "thig5.7:4.4": "vimalaṃ sādhu bhāvitaṃ. ",
  "thig5.7:5.1": "saṅkhāre parato disvā ",
  "thig5.7:5.2": "hetujāte palokine | ",
  "thig5.7:5.3": "pahāsiṃ āsave sabbe ",
  "thig5.7:5.4": "sītibhūta mhi nibbutā. ",
  "thig5.7:6.1": "Sakulā. || "
}
