  "thig4.1:0.1": "",
  "thig4.1:0.2": "",
  "thig4.1:0.3": "",
  "thig4.1:1.1": "putto buddhassa dāyādo ",
  "thig4.1:1.2": "Kassapo susamāhito | ",
  "thig4.1:1.3": "pubbenivāsaṃ yo vedī ",
  "thig4.1:1.4": "saggāpāyañ ca passati. ",
  "thig4.1:2.1": "atho jātikkhayaṃ patto ",
  "thig4.1:2.2": "abhiññāvosito muni | ",
  "thig4.1:2.3": "etāhi tīhi vijjāhi ",
  "thig4.1:2.4": "tevijjo hoti brāhmaṇo. ",
  "thig4.1:3.1": "tatheva Bhaddā Kapilānī ",
  "thig4.1:3.2": "tevijjā maccuhāyinī | ",
  "thig4.1:3.3": "dhāreti antimaṃ dehaṃ ",
  "thig4.1:3.4": "jetvā Māraṃ savāhanaṃ. ",
  "thig4.1:4.1": "disvā ādīnavaṃ loke ",
  "thig4.1:4.2": "ubho pabbajitā mayaṃ | ",
  "thig4.1:4.3": "ty amha khīṇāsavā dantā ",
  "thig4.1:4.4": "sītibhūta mha nibbutā ti. ",
  "thig4.1:5.1": "Bhaddā kapilānī. || catukkanipāto niṭṭhito. || paṇṇavīsati vassāni ",
  "thig4.1:6.1": ""
}
