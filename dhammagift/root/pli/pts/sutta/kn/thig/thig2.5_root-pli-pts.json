  "thig2.5:1.1": "kisikā ",
  "thig2.5:1.2": "gilānā bāḷhadubbalā | ",
  "thig2.5:1.3": "daṇḍam olubbha gacchāmi ",
  "thig2.5:1.4": "pabbataṃ abhirūhiya. ",
  "thig2.5:2.1": "saṃghāṭiṃ nikkhipitvāna ",
  "thig2.5:2.2": "pattakaṃ ca nikujjiya | ",
  "thig2.5:2.3": "sele khambhesiṃ attānaṃ ",
  "thig2.5:2.4": "tamokkhandhaṃ padāliya. ",
  "thig2.5:3.1": "Cittā. || kiñ cāpi kho mhi "
}
