  "thig2.1:0.1": "",
  "thig2.1:0.2": "",
  "thig2.1:0.3": "",
  "thig2.1:1.1": "āturaṃ asuciṃ pūtiṃ ",
  "thig2.1:1.2": "passa Nande samussayaṃ | ",
  "thig2.1:1.3": "asubhāya cittaṃ bhāvehi ",
  "thig2.1:1.4": "ekaggaṃ susamāhitaṃ ",
  "thig2.1:2.1": "animittañ ca bhāvehi ",
  "thig2.1:2.2": "mānānusayam ujjaha | ",
  "thig2.1:2.3": "tato mānābhisamayā ",
  "thig2.1:2.4": "upasantā carissasi. ",
  "thig2.1:3.1": "itthaṃ sudaṃ bhagavā Nandaṃ sikkhamānaṃ imāhi gāthāhi abhiṇhaṃ ovadati. || "
}
