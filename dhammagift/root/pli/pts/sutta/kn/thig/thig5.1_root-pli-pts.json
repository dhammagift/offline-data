{
  "thig5.1:0.1": "",
  "thig5.1:0.2": "",
  "thig5.1:0.3": "",
  "thig5.1:1.1": "",
  "thig5.1:1.2": "yato pabbajitā ahaṃ | ",
  "thig5.1:1.3": "accharāsaṃghātamattaṃ pi citass' ",
  "thig5.1:1.4": "upasam' ajjhagaṃ. ",
  "thig5.1:2.1": "aladdhā cetaso santiṃ ",
  "thig5.1:2.2": "kāmarāgen' avassutā | ",
  "thig5.1:2.3": "bāhā paggayha kandantī ",
  "thig5.1:2.4": "vihāraṃ pāvisiṃ ahaṃ. ",
  "thig5.1:3.1": "sā bhikkhuniṃ upāgacchiṃ ",
  "thig5.1:3.2": "yā me saddhāyikā ahu | ",
  "thig5.1:3.3": "sā me dhammaṃ adesesi ",
  "thig5.1:3.4": "khandhāyatanadhātuyo. ",
  "thig5.1:4.1": "tassā dhammaṃ suṇitvāna ",
  "thig5.1:4.2": "ekamante upāvisiṃ | ",
  "thig5.1:4.3": "pubbenivāsaṃ jānāmi ",
  "thig5.1:4.4": "dibbacakkhuṃ visodhitaṃ. ",
  "thig5.1:5.1": "ceto paricca ñāṇañ ca ",
  "thig5.1:5.2": "sotadhātu visodhitā | ",
  "thig5.1:5.3": "iddhi pi me sacchikatā ",
  "thig5.1:5.4": "patto me āsavakkhayo | ",
  "thig5.1:5.5": "cha me 'bhiññā sacchikatā ",
  "thig5.1:5.6": "kataṃ buddhassa sāsanaṃ. ",
  "thig5.1:6.1": "aññatarā bhikkhunī apaññātā. || "
}
