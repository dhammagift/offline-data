  "thig2.4:0.3": "",
  "thig2.4:1.1": "yāva Kāsijanapado ",
  "thig2.4:1.2": "suṅko me tattako ahu | ",
  "thig2.4:1.3": "taṃ katvā nigamo agghaṃ ",
  "thig2.4:1.4": "agghe 'naggahaṃ ṭhapesi maṃ. ",
  "thig2.4:2.1": "atha nibbind' ahaṃ rūpe ",
  "thig2.4:2.2": "nibbindañ ca virajj' ahaṃ | ",
  "thig2.4:2.3": "mā puna jātisaṃsāraṃ ",
  "thig2.4:2.4": "sandhāveyyaṃ punappunaṃ | ",
  "thig2.4:2.5": "tisso vijjā sacchikatā ",
  "thig2.4:2.6": "kataṃ buddhassa sāsanaṃ. ",
  "thig2.4:3.1": "Aḍḍhakāsī. || kiñ cāpi kho mhi "
}
