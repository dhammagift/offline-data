  "thig2.3:0.3": "",
  "thig2.3:1.1": "sumuttikā ",
  "thig2.3:1.2": "sādhu muttika mhi musalassa | ",
  "thig2.3:1.3": "ahiriko me chattakaṃ vā pi ",
  "thig2.3:1.4": "ukkhalikā me daḷiddabhāvā ti. ",
  "thig2.3:2.1": "rāgañ ca ahaṃ dosañ ca ",
  "thig2.3:2.2": "vicchindantī viharāmi | ",
  "thig2.3:2.3": "sā rukkhamūlam upagamma ",
  "thig2.3:2.4": "aho sukhan ti sukhato jhāyāmi. aññatarā ",
  "thig2.3:3.1": "therībhikkhunī apaññātā. || "
}
