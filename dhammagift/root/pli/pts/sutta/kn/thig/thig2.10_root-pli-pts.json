  "thig2.10:0.3": "",
  "thig2.10:1.1": "catukkhattuṃ pañcakkhattuṃ ",
  "thig2.10:1.2": "vihārā upanikkhamiṃ | ",
  "thig2.10:1.3": "aladdhā cetaso santiṃ ",
  "thig2.10:1.4": "citte avasavattini. ",
  "thig2.10:1.5": "tassā me aṭṭhamī ratti ",
  "thig2.10:1.6": "taṇhā mayhaṃ samūhatā | ",
  "thig2.10:2.1": "bahūhi dukkhadhammehi ",
  "thig2.10:2.2": "appamādaratāya me | ",
  "thig2.10:2.3": "taṇhakkhayo anuppatto ",
  "thig2.10:2.4": "kataṃ buddhassa sāsanaṃ. ",
  "thig2.10:3.1": "Sāmā. || paṇṇavīsati vassāni ",
  "thig2.10:4.1": ""
}
