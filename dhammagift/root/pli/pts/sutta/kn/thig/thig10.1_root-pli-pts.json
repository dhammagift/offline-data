{
  "thig10.1:0.1": "",
  "thig10.1:0.2": "",
  "thig10.1:0.3": "",
  "thig10.1:1.1": "kalyāṇamittatā muninā ",
  "thig10.1:1.2": "lokaṃ ādissa vaṇṇitā | ",
  "thig10.1:1.3": "kalyāṇamitte bhajamāno ",
  "thig10.1:1.4": "api bālo paṇḍito assa. ",
  "thig10.1:2.1": "bhajitabbā sappurisā ",
  "thig10.1:2.2": "paññā tathā pavaḍḍhati bhajantānaṃ | ",
  "thig10.1:2.3": "bhajamāno sappurise ",
  "thig10.1:2.4": "sabbehi pi dukkhehi mucceyya. ",
  "thig10.1:3.1": "dukkhañ ca vijāneyya ",
  "thig10.1:3.2": "dukkhassa ca samudayaṃ | nirodhañ ca ",
  "thig10.1:3.3": "aṭṭhaṅgikaṃ maggaṃ ",
  "thig10.1:3.4": "cattāri ariyasaccāni. ",
  "thig10.1:4.1": "dukkho itthibhāvo ",
  "thig10.1:4.2": "akkhāto purisadammasārathinā | ",
  "thig10.1:4.3": "sapattikaṃ pi dukkhaṃ ",
  "thig10.1:4.4": "appekaccā sakiṃ vijātāyo ",
  "thig10.1:5.1": "gale apakantanti ",
  "thig10.1:5.2": "sukhumāliniyo visāni khādanti | ",
  "thig10.1:5.3": "janamārakamajjhagatā ",
  "thig10.1:5.4": "ubho pi byasanāni anubhonti. ",
  "thig10.1:6.1": "upavijaññā gacchantī ",
  "thig10.1:6.2": "addasāhaṃ patiṃ mataṃ ",
  "thig10.1:6.3": "panthe | vijāyitvāna ",
  "thig10.1:6.4": "appattāhaṃ sakaṃ gehaṃ. ",
  "thig10.1:7.1": "dve puttā kālaṅkatā ",
  "thig10.1:7.2": "pati ca panthe mato kapaṇikāya | ",
  "thig10.1:7.3": "mātā pitā ca bhātā ca ",
  "thig10.1:7.4": "ḍayhanti ekacitakāyaṃ. ",
  "thig10.1:8.1": "khīṇakulīne kapaṇe ",
  "thig10.1:8.2": "anubhūtaṃ te dukkhaṃ aparimāṇaṃ | ",
  "thig10.1:8.3": "assu ca te pavattaṃ ",
  "thig10.1:8.4": "bahūni jātisahassāni. ",
  "thig10.1:9.1": "passiṃ taṃ susānamajjhe ",
  "thig10.1:9.2": "atho pi khāditāni puttamaṃsāni | ",
  "thig10.1:9.3": "hatakulikā sabbagarahitā ",
  "thig10.1:9.4": "matapatikā amatam adhigacchiṃ. ",
  "thig10.1:10.1": "bhāvito me maggo ",
  "thig10.1:10.2": "ariyo aṭṭhaṅgiko amatagāmī | ",
  "thig10.1:10.3": "nibbānaṃ sacchikataṃ ",
  "thig10.1:10.4": "dhammādāsaṃ apekkhi 'haṃ. ",
  "thig10.1:11.1": "ahaṃ amhi kantasallā ",
  "thig10.1:11.2": "ohitabhārā kataṃ me karaṇīyaṃ | ",
  "thig10.1:11.3": "Kisāgotamī therī ",
  "thig10.1:11.4": "suvimuttacittā imaṃ bhaṇī ",
  "thig10.1:12.1": "ti. Kisāgotamī. || ekādasanipāto samatto. || ",
  "thig10.1:13.1": ""
}
