{
  "thig14.1:0.1": "",
  "thig14.1:0.2": "",
  "thig14.1:0.3": "",
  "thig14.1:1.1": "Jīvakambavanaṃ rammaṃ ",
  "thig14.1:1.2": "gacchantiṃ bhikkhuniṃ Subhaṃ | ",
  "thig14.1:1.3": "dhuttako saṃnivāresi ",
  "thig14.1:1.4": "tam enaṃ abravī Subhā. ",
  "thig14.1:2.1": "kiṃ te aparādhitaṃ mayā ",
  "thig14.1:2.2": "yaṃ maṃ ovariyāna tiṭṭhasi | ",
  "thig14.1:2.3": "na hi pabbajitāya āvuso ",
  "thig14.1:2.4": "puriso saṃphusanāya kappati. ",
  "thig14.1:3.1": "garuke mama satthu sāsane ",
  "thig14.1:3.2": "yā sikkhā sugatena desitā | ",
  "thig14.1:3.3": "parisuddhapadaṃ anaṅgaṇaṃ ",
  "thig14.1:3.4": "kiṃ maṃ ovariyāna tiṭṭhasi. ",
  "thig14.1:4.1": "āvilacitto anāvilaṃ ",
  "thig14.1:4.2": "sarajo vītarajaṃ anaṅgaṇaṃ | ",
  "thig14.1:4.3": "sabbattha vimuttamānasaṃ ",
  "thig14.1:4.4": "kiṃ maṃ ovariyāna tiṭṭhasi. ",
  "thig14.1:5.1": "daharā ca apāpikā c' asi ",
  "thig14.1:5.2": "kiṃ te pabbajjā karissati | ",
  "thig14.1:5.3": "nikkhipa kāsāyacīvaraṃ ",
  "thig14.1:5.4": "ehi ramāmase pupphite vane. ",
  "thig14.1:6.1": "madhurañ ca pavanti sabbaso ",
  "thig14.1:6.2": "kusumarajena samuddhatā dumā | ",
  "thig14.1:6.3": "paṭhamavasanto sukho utu ",
  "thig14.1:6.4": "ehi ramāmase pupphite vane. ",
  "thig14.1:7.1": "kusumitasikharā ca pādapā ",
  "thig14.1:7.2": "abhigajjanti va māluteritā | ",
  "thig14.1:7.3": "kā tuyhaṃ rati bhavissati ",
  "thig14.1:7.4": "yadi ekā vanam ogāhissasi. ",
  "thig14.1:8.1": "vāḷamigasaṅghasevitaṃ ",
  "thig14.1:8.2": "kuñjaramattakareṇuloḷitaṃ | ",
  "thig14.1:8.3": "asahāyikā gantum icchasi ",
  "thig14.1:8.4": "rahitaṃ bhīsanakaṃ mahāvanaṃ. ",
  "thig14.1:9.1": "tapanīyakatā va dhītikā ",
  "thig14.1:9.2": "vicarasi Cittarathe va accharā | ",
  "thig14.1:9.3": "kāsikasukhumehi vagguhi ",
  "thig14.1:9.4": "sobhasi vasanehi 'nūpame. ",
  "thig14.1:10.1": "ahaṃ tava vasānugo siyaṃ ",
  "thig14.1:10.2": "yadi viharemasi kānanantare | ",
  "thig14.1:10.3": "na hi m' atthi tayā piyataro ",
  "thig14.1:10.4": "pāṇo kinnarimandalocane. ",
  "thig14.1:11.1": "yadi me vacanaṃ karissasi ",
  "thig14.1:11.2": "sukhitā ehi agāram āvasa | ",
  "thig14.1:11.3": "pāsādanivātavāsinā ",
  "thig14.1:11.4": "parikamman te karontu nāriyo. ",
  "thig14.1:12.1": "kāsikasukhumāni dhāraya ",
  "thig14.1:12.2": "abhiropehi ca mālavaṇṇakaṃ | ",
  "thig14.1:12.3": "kañcanamaṇimuttakaṃ bahuṃ ",
  "thig14.1:12.4": "vividhaṃ ābharaṇaṃ karomi te. ",
  "thig14.1:13.1": "sudhotarajapacchadaṃ subhaṃ ",
  "thig14.1:13.2": "gonakatūlikasantataṃ navaṃ | ",
  "thig14.1:13.3": "abhirūha sayanaṃ mahārahaṃ ",
  "thig14.1:13.4": "candanamaṇḍitaṃ sāragandhikaṃ. ",
  "thig14.1:14.1": "uppalaṃ ca udakato ubbhataṃ ",
  "thig14.1:14.2": "yathā yaṃ amanussasevitaṃ | ",
  "thig14.1:14.3": "evaṃ tuvaṃ brahmacārini ",
  "thig14.1:14.4": "sakesu aṅgesu jaraṃ gamissasi. ",
  "thig14.1:15.1": "kin te idha sārasammataṃ ",
  "thig14.1:15.2": "kuṇapapūramhi susānavaḍḍhane | ",
  "thig14.1:15.3": "bhedanadhamme kaḷevare ",
  "thig14.1:15.4": "yaṃ disvā vimano dikkhasi. ",
  "thig14.1:16.1": "akkhīni ca turiyā-r-iva ",
  "thig14.1:16.2": "kinnariyā-r-iva pabbatantare | ",
  "thig14.1:16.3": "tava me nayanāni dakkhiya ",
  "thig14.1:16.4": "bhiyyo kāmarati pavaḍḍhati. ",
  "thig14.1:17.1": "uppalasikharopamānite ",
  "thig14.1:17.2": "vimale hāṭakasannibhe mukhe | ",
  "thig14.1:17.3": "tava me nayanāni dakkhiya ",
  "thig14.1:17.4": "bhiyyo kāmaguṇo pavaḍḍhati. ",
  "thig14.1:18.1": "api dūragatā saremhase ",
  "thig14.1:18.2": "āyatapamhe visuddhadassane | ",
  "thig14.1:18.3": "na hi m' atthi tayā piyatarā ",
  "thig14.1:18.4": "nayanā kinnarimandalocane. ",
  "thig14.1:19.1": "apathena payātum icchasi ",
  "thig14.1:19.2": "candaṃ kīḷanakaṃ gavesasi | ",
  "thig14.1:19.3": "Meruṃ laṅghetum icchasi ",
  "thig14.1:19.4": "yo tvaṃ buddhasutaṃ maggayasi. ",
  "thig14.1:20.1": "n' atthi hi loke sadevake ",
  "thig14.1:20.2": "rāgo yattha pi dāni me siyā | ",
  "thig14.1:20.3": "na pi naṃ jānāmi kīriso ",
  "thig14.1:20.4": "atha maggena hato samūlako. ",
  "thig14.1:21.1": "iṅghāḷakhuyā va ujjhito ",
  "thig14.1:21.2": "visapatto-r-iva aggato kato | ",
  "thig14.1:21.3": "na pi naṃ passāmi kīriso ",
  "thig14.1:21.4": "atha maggena hato samūlako. ",
  "thig14.1:22.1": "yassā siyā apaccavekkhitaṃ ",
  "thig14.1:22.2": "satthā vā anusāsito siyā | ",
  "thig14.1:22.3": "tvaṃ tādisikaṃ palobhaya ",
  "thig14.1:22.4": "jānantiṃ so imaṃ vihaññasi. ",
  "thig14.1:23.1": "mayhaṃ hi akkuṭṭhavandite ",
  "thig14.1:23.2": "sukhadukkhe ca sati upaṭṭhitā | ",
  "thig14.1:23.3": "saṅkhatam asubhan ti jāniya ",
  "thig14.1:23.4": "sabbatth' eva mano na limpati. ",
  "thig14.1:24.1": "sāhaṃ sugatassa sāvikā ",
  "thig14.1:24.2": "maggaṭṭhaṅgikayānayāyinī | ",
  "thig14.1:24.3": "uddhaṭasallā anāsavā ",
  "thig14.1:24.4": "suññāgāragatā ramām' ahaṃ. ",
  "thig14.1:25.1": "diṭṭhā hi mayā sucittitā ",
  "thig14.1:25.2": "sombhā dārukacillakā navā | ",
  "thig14.1:25.3": "tantihi ca khīlakehi ca ",
  "thig14.1:25.4": "vinibaddhā vividhaṃ panaccitā. ",
  "thig14.1:26.1": "tamh' uddhaṭe tantikhīlake ",
  "thig14.1:26.2": "visaṭṭhe vikale paripakkate | ",
  "thig14.1:26.3": "avinde khaṇḍaso kate ",
  "thig14.1:26.4": "kimhi tattha manaṃ nivesaye. ",
  "thig14.1:27.1": "tathūpamaṃ dehakāni maṃ ",
  "thig14.1:27.2": "tehi dhammehi vinā na vattanti | ",
  "thig14.1:27.3": "dhammehi vinā na vattanti ",
  "thig14.1:27.4": "kimhi tattha manaṃ nivesaye. ",
  "thig14.1:28.1": "yathā haritālena makkhitaṃ ",
  "thig14.1:28.2": "addasa cittikaṃ bhittiyā kataṃ | ",
  "thig14.1:28.3": "tamhi te viparītadassanaṃ ",
  "thig14.1:28.4": "paññā mānusikā niratthikā. ",
  "thig14.1:29.1": "māyaṃ viya aggato kataṃ ",
  "thig14.1:29.2": "supinante vasuvaṇṇapādapaṃ | ",
  "thig14.1:29.3": "upadhāvasi andha rittakaṃ ",
  "thig14.1:29.4": "janamajjhe-r-iva rupparūpakaṃ. ",
  "thig14.1:30.1": "vaṭṭani-r-iva koṭar' ohitā ",
  "thig14.1:30.2": "majjhebubbuḷakā sāssukā | ",
  "thig14.1:30.3": "pīḷikoḷikā c' ettha jāyati ",
  "thig14.1:30.4": "vividhā cakkhuvidhā 'va piṇḍitā. ",
  "thig14.1:31.1": "uppāṭiya cārudassanā ",
  "thig14.1:31.2": "na ca pajjittha asaṅgamānasā | ",
  "thig14.1:31.3": "handa te cakkhuṃ harassu taṃ ",
  "thig14.1:31.4": "tassa narassa adāsi tāvade. ",
  "thig14.1:32.1": "tassa ca viramāsi tāvade ",
  "thig14.1:32.2": "rāgo tattha khamāpayi ca naṃ | ",
  "thig14.1:32.3": "sotthi siyā brahmacārini ",
  "thig14.1:32.4": "na puno edisakaṃ bhavissati. ",
  "thig14.1:33.1": "āhaniya edisaṃ janaṃ ",
  "thig14.1:33.2": "aggiṃ pajjalitaṃ va liṅgiya | ",
  "thig14.1:33.3": "gaṇhissaṃ āsīvisaṃ viya ",
  "thig14.1:33.4": "api nu sotthi siyā khamehi no. ",
  "thig14.1:34.1": "muttā ca tato sā bhikkhunī ",
  "thig14.1:34.2": "agami buddhavarassa santikaṃ | ",
  "thig14.1:34.3": "passiya varapuññalakkhaṇaṃ ",
  "thig14.1:34.4": "cakkhu āsi yathāpurāṇakan ti. ",
  "thig14.1:35.1": "Subhā Jīvakambavanikā. || ",
  "thig14.1:36.1": "tiṃsanipāto samatto. || "
}
