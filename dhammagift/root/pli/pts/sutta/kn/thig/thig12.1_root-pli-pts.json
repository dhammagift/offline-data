  "thig12.1:0.1": "",
  "thig12.1:0.2": "",
  "thig12.1:0.3": "",
  "thig12.1:1.1": "ahaṃ sīte ",
  "thig12.1:1.2": "sadā udakam otariṃ | ",
  "thig12.1:1.3": "ayyānaṃ daṇḍabhayabhītā ",
  "thig12.1:1.4": "vācādosabhayadditā. ",
  "thig12.1:2.1": "kassa brāhmaṇa tvaṃ bhīto ",
  "thig12.1:2.2": "sadā udakam otari | ",
  "thig12.1:2.3": "vedhamānehi gattehi ",
  "thig12.1:2.4": "sītaṃ vedayase bhusaṃ. ",
  "thig12.1:3.1": "jānantī ca tuvaṃ bhoti ",
  "thig12.1:3.2": "Puṇṇike paripucchasi | ",
  "thig12.1:3.3": "karontaṃ kusalaṃ kammaṃ ",
  "thig12.1:3.4": "rudhantaṃ kamma pāpakaṃ. ",
  "thig12.1:4.1": "yo ca vuḍḍho vā dabaro vā ",
  "thig12.1:4.2": "pāpakammaṃ pakubbati | ",
  "thig12.1:4.3": "udakābhisecanā so pi ",
  "thig12.1:4.4": "pāpakammā pamuccati. ",
  "thig12.1:5.1": "ko nu te idam akkhāsi ",
  "thig12.1:5.2": "ajānantassa ajānato | ",
  "thig12.1:5.3": "udakābhisecanā nāma ",
  "thig12.1:5.4": "pāpakammā pamuccati ",
  "thig12.1:6.1": "saggaṃ nūna gamissanti ",
  "thig12.1:6.2": "sabbe maṇḍūkakacchapā | ",
  "thig12.1:6.3": "nāgā ca suṃsumārā ca ",
  "thig12.1:6.4": "ye c' aññe udakecarā. ",
  "thig12.1:7.1": "orabbhikā sūkarikā ",
  "thig12.1:7.2": "macchikā migabandhakā | ",
  "thig12.1:7.3": "corā ca vajjhaghātā ca ",
  "thig12.1:7.4": "ye c' aññe pāpakammino | ",
  "thig12.1:7.5": "udakābhisecanā te pi ",
  "thig12.1:7.6": "pāpakammā pamuccare. ",
  "thig12.1:8.1": "sace imā nadiyo te ",
  "thig12.1:8.2": "pāpaṃ pubbekataṃ ",
  "thig12.1:8.3": "vaheyyuṃ | puññaṃ p' imā vaheyyuṃ ",
  "thig12.1:8.4": "tena tvaṃ paribāhiro assa. ",
  "thig12.1:9.1": "yassa brāhmaṇa tvaṃ bhīto ",
  "thig12.1:9.2": "sadā udakam otari | ",
  "thig12.1:9.3": "tam eva brahme mā kāsi ",
  "thig12.1:9.4": "mā te sītaṃ chaviṃ hane. ",
  "thig12.1:10.1": "kumaggaṃ paṭipannaṃ maṃ ",
  "thig12.1:10.2": "ariyamaggaṃ samānayi | ",
  "thig12.1:10.3": "udakābhisecanaṃ bhoti ",
  "thig12.1:10.4": "imaṃ sāṭaṃ dadāmi te. ",
  "thig12.1:11.1": "tuyh' eva sāṭako hotu ",
  "thig12.1:11.2": "nāham icchāmi sāṭakaṃ. | ",
  "thig12.1:11.3": "sace bhāyasi dukkhassa ",
  "thig12.1:11.4": "sace te dukkhaṃ appiyaṃ ",
  "thig12.1:12.1": "mā kāsi pāpakaṃ kammaṃ ",
  "thig12.1:12.2": "āvi vā yadi vā raho. | ",
  "thig12.1:12.3": "sace ca pāpakaṃ kammaṃ ",
  "thig12.1:12.4": "karissasi karosi vā ",
  "thig12.1:13.1": "na te dukkhā pamuty atthi ",
  "thig12.1:13.2": "upeccāpi palāyato. | ",
  "thig12.1:13.3": "sace bhāyasi dukkhassa ",
  "thig12.1:13.4": "sace te dukkham appiyaṃ ",
  "thig12.1:14.1": "upehi buddhaṃ saraṇaṃ ",
  "thig12.1:14.2": "dhammaṃ saṅghañ ca tādinaṃ | ",
  "thig12.1:14.3": "samādiyāhi sīlāni ",
  "thig12.1:14.4": "tan te atthāya hehiti. ",
  "thig12.1:15.1": "upemi buddhaṃ saraṇaṃ ",
  "thig12.1:15.2": "dhammaṃ saṅghañ ca tādinaṃ | ",
  "thig12.1:15.3": "samādiyāmi sīlāni ",
  "thig12.1:15.4": "taṃ me atthāya hehiti. ",
  "thig12.1:16.1": "brahmabandhu pure āsiṃ ",
  "thig12.1:16.2": "ajj' amhi saccaṃ brāhmaṇo | ",
  "thig12.1:16.3": "tevijjo vedasampanno ",
  "thig12.1:16.4": "sotthiyo c' amhi ",
  "thig12.1:17.1": "nhātako. Puṇṇikā. || soḷasanipāto samatto. || ",
  "thig12.1:18.1": ""
}
