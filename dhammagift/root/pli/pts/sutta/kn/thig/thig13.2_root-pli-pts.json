{
  "thig13.2:0.1": "",
  "thig13.2:0.2": "",
  "thig13.2:0.3": "",
  "thig13.2:1.1": "bhoti maṃ vipassi ",
  "thig13.2:1.2": "samaṇā ti paṭibujjhasi | samaṇānam ",
  "thig13.2:1.3": "eva kittesi ",
  "thig13.2:1.4": "samaṇī nūna bhavissasi. ",
  "thig13.2:2.1": "vipulaṃ annañ ca pānañ ca ",
  "thig13.2:2.2": "samaṇānaṃ pavecchasi | ",
  "thig13.2:2.3": "Rohiṇi dāni pucchāmi ",
  "thig13.2:2.4": "kena te samaṇā piyā. ",
  "thig13.2:3.1": "akammakāmā alasā ",
  "thig13.2:3.2": "paradattopajīvino | ",
  "thig13.2:3.3": "āsaṃsukā sādukāmā ",
  "thig13.2:3.4": "kena te samaṇā piyā. ",
  "thig13.2:4.1": "cirassaṃ vata man tāta ",
  "thig13.2:4.2": "samaṇānaṃ paripucchasi | ",
  "thig13.2:4.3": "tesaṃ te kittayissāmi ",
  "thig13.2:4.4": "paññāsīlaparakkamaṃ. ",
  "thig13.2:5.1": "kammakāmā analasā ",
  "thig13.2:5.2": "kammaseṭṭhassa kārakā | ",
  "thig13.2:5.3": "rāgaṃ dosaṃ pajahanti ",
  "thig13.2:5.4": "tena me samaṇā piyā. ",
  "thig13.2:6.1": "tīṇi pāpassa mūlāni ",
  "thig13.2:6.2": "dhunanti sucikārino | ",
  "thig13.2:6.3": "sabbapāpaṃ pahīn' esaṃ ",
  "thig13.2:6.4": "tena me samaṇā piyā. ",
  "thig13.2:7.1": "kāyakammaṃ suci nesaṃ ",
  "thig13.2:7.2": "vacīkammañ ca tādisaṃ | ",
  "thig13.2:7.3": "manokammaṃ suci nesaṃ ",
  "thig13.2:7.4": "tena me samaṇā piyā. ",
  "thig13.2:8.1": "vimalā saṃkhamuttā 'va ",
  "thig13.2:8.2": "suddhā santarabāhirā | ",
  "thig13.2:8.3": "puṇṇā sukkāna dhammānaṃ ",
  "thig13.2:8.4": "tena me samaṇā piyā. ",
  "thig13.2:9.1": "bahussutā dhammaddharā ",
  "thig13.2:9.2": "ariyā dhammajīvino | ",
  "thig13.2:9.3": "atthaṃ dhammañ ca desenti ",
  "thig13.2:9.4": "tena me samaṇā piyā. ",
  "thig13.2:10.1": "bahussutā dhammaddharā ",
  "thig13.2:10.2": "ariyā dhammajīvino | ",
  "thig13.2:10.3": "ekaggacittā satimanto ",
  "thig13.2:10.4": "tena me samaṇā piyā. ",
  "thig13.2:11.1": "dūraṅgamā satimanto ",
  "thig13.2:11.2": "mantabhāṇī anuddhatā | ",
  "thig13.2:11.3": "dukkhass' antaṃ pajānanti ",
  "thig13.2:11.4": "tena me samaṇā piyā. ",
  "thig13.2:12.1": "yamhā gāmā pakkamanti ",
  "thig13.2:12.2": "na vilokenti kiñcanaṃ | ",
  "thig13.2:12.3": "anapekkhā' va gacchanti ",
  "thig13.2:12.4": "tena me samaṇā piyā. ",
  "thig13.2:13.1": "na te saṃ koṭṭhe osenti ",
  "thig13.2:13.2": "na kumbhiṃ na kaḷopiyaṃ | ",
  "thig13.2:13.3": "pariniṭṭhitam esānā ",
  "thig13.2:13.4": "tena me samaṇā piyā. ",
  "thig13.2:14.1": "na te hiraññaṃ gaṇhanti ",
  "thig13.2:14.2": "na suvaṇṇaṃ na rūpiyaṃ | ",
  "thig13.2:14.3": "paccuppannena yāpenti ",
  "thig13.2:14.4": "tena me samaṇā piyā. ",
  "thig13.2:15.1": "nānākulā pabbajitā ",
  "thig13.2:15.2": "nānājanapadehi ca | ",
  "thig13.2:15.3": "aññamaññaṃ piyāyanti ",
  "thig13.2:15.4": "tena me samaṇā piyā. ",
  "thig13.2:16.1": "atthāya vata no bhoti ",
  "thig13.2:16.2": "kule jātā si Rohiṇi | ",
  "thig13.2:16.3": "saddhā buddhe ca dhamme ca ",
  "thig13.2:16.4": "saṅghe ca tibbagāravā. ",
  "thig13.2:17.1": "tuvaṃ h' etaṃ pajānāsi ",
  "thig13.2:17.2": "puññakkhettaṃ anuttaraṃ | ",
  "thig13.2:17.3": "amhaṃ pi ete samaṇā ",
  "thig13.2:17.4": "paṭigaṇhanti dakkhiṇaṃ | ",
  "thig13.2:18.1": "paṭiṭṭhito h' ettha yañño ",
  "thig13.2:18.2": "vipulo no bhavissati. ",
  "thig13.2:18.3": "sace bhāyasi dukkhassa ",
  "thig13.2:18.4": "sace te dukkham appiyaṃ | ",
  "thig13.2:19.1": "upehi buddhaṃ saraṇaṃ ",
  "thig13.2:19.2": "dhammaṃ saṅghañ ca tādinaṃ | ",
  "thig13.2:19.3": "samādiyāhi sīlāni ",
  "thig13.2:19.4": "tan te atthāya hehiti. ",
  "thig13.2:20.1": "upemi buddhaṃ saraṇaṃ ",
  "thig13.2:20.2": "dhammaṃ saṅghañ ca tādinaṃ | ",
  "thig13.2:20.3": "samādiyāmi sīlāni ",
  "thig13.2:20.4": "taṃ me atthāya hehiti. ",
  "thig13.2:21.1": "brahmabandhu pure āsiṃ ",
  "thig13.2:21.2": "so idāni 'mhi brāhmaṇo | ",
  "thig13.2:21.3": "tevijjo sotthiyo c' amhi ",
  "thig13.2:21.4": "vedagū c' amhi nhātako. ",
  "thig13.2:22.1": "Rohiṇī. || "
}
