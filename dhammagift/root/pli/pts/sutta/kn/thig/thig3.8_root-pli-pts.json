{
  "thig3.8:0.1": "",
  "thig3.8:0.2": "",
  "thig3.8:0.3": "",
  "thig3.8:1.1": "yaṃ taṃ isīhi pattabbaṃ ",
  "thig3.8:1.2": "ṭhānaṃ durabhisaṃbhavaṃ | ",
  "thig3.8:1.3": "na taṃ dvaṅgulipaññāya ",
  "thig3.8:1.4": "sakkā pappotum itthiyā. ",
  "thig3.8:2.1": "itthibhāvo no kiṃ kayirā ",
  "thig3.8:2.2": "cittamhi susamāhite | ",
  "thig3.8:2.3": "ñāṇamhi vattamānamhi ",
  "thig3.8:2.4": "sammā dhammaṃ vipassato. ",
  "thig3.8:3.1": "sabbattha vihatā nandi ",
  "thig3.8:3.2": "tamokkhandho padālito | ",
  "thig3.8:3.3": "evaṃ jānāhi pāpima ",
  "thig3.8:3.4": "nihato tvam asi antaka. ",
  "thig3.8:4.1": "Somā. || ",
  "thig3.8:5.1": "tikanipāto niṭṭhito. || "
}
