  "thig2.6:0.1": "",
  "thig2.6:0.2": "",
  "thig2.6:0.3": "",
  "thig2.6:1.1": "dukkhitā ",
  "thig2.6:1.2": "dubbalā gatayobbanā | ",
  "thig2.6:1.3": "daṇḍam olubbha gacchāmi ",
  "thig2.6:1.4": "pabbataṃ abhirūhiya. ",
  "thig2.6:2.1": "nikkhipitvāna saṃghāṭiṃ pattakaṃ ",
  "thig2.6:2.2": "ca nikujjiya | ",
  "thig2.6:2.3": "nisinnā c' amhi selamhi ",
  "thig2.6:2.4": "atha cittaṃ vimucci me | ",
  "thig2.6:2.5": "tisso vijjā anuppattā ",
  "thig2.6:2.6": "kataṃ buddhassa sāsanaṃ. ",
  "thig2.6:3.1": "Mettikā. || cātuddasī pañcaddasī "
}
