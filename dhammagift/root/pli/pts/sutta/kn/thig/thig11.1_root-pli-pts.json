{
  "thig11.1:0.1": "",
  "thig11.1:0.2": "",
  "thig11.1:0.3": "",
  "thig11.1:1.1": "ubho mātā ca dhītā ca ",
  "thig11.1:1.2": "mayaṃ āsuṃ sapattiyo | ",
  "thig11.1:1.3": "tassā me ahu saṃvego ",
  "thig11.1:1.4": "abbhuto lomahaṃsano. ",
  "thig11.1:2.1": "dhi-r-atthu kāmā asucī ",
  "thig11.1:2.2": "duggandhā bahukaṇṭakā | ",
  "thig11.1:2.3": "yattha mātā ca dhītā ca ",
  "thig11.1:2.4": "sabhariyā mayaṃ ahuṃ. ",
  "thig11.1:3.1": "kāmesv ādīnavaṃ disvā ",
  "thig11.1:3.2": "nekkhammaṃ daḷhakhemato | ",
  "thig11.1:3.3": "sā pabbajiṃ Rājagahe ",
  "thig11.1:3.4": "agārasmā anagāriyaṃ. ",
  "thig11.1:4.1": "pubbenivāsaṃ jānāmi ",
  "thig11.1:4.2": "dibbacakkhuṃ visodhitaṃ | ",
  "thig11.1:4.3": "ceto paricca ñāṇañ ca ",
  "thig11.1:4.4": "sotadhātu visodhitā. ",
  "thig11.1:5.1": "iddhi pi me sacchikatā ",
  "thig11.1:5.2": "patto me āsavakkhayo | ",
  "thig11.1:5.3": "cha me abhiññā sacchikatā ",
  "thig11.1:5.4": "kataṃ buddhassa sāsanaṃ ",
  "thig11.1:6.1": "iddhiyā abhinimmitvā ",
  "thig11.1:6.2": "caturassaṃ rathaṃ ahaṃ | ",
  "thig11.1:6.3": "buddhassa pāde vanditvā ",
  "thig11.1:6.4": "lokanāthassa sirīmato. ",
  "thig11.1:7.1": "supupphitaggaṃ upagamma pādapaṃ ",
  "thig11.1:7.2": "ekā tuvaṃ tiṭṭhasi rukkhamūle | ",
  "thig11.1:7.3": "na cāpi te dutiyo atthi koci na tvaṃ ",
  "thig11.1:7.4": "bāle bhāyasi dhuttakānaṃ. ",
  "thig11.1:8.1": "sataṃ sahassānaṃ pi dhuttakānaṃ ",
  "thig11.1:8.2": "samāgatā edisakā bhaveyyuṃ | ",
  "thig11.1:8.3": "lomaṃ na iñje na pi sampavedhe ",
  "thig11.1:8.4": "kiṃ me tuvaṃ Māra karissas' eko ",
  "thig11.1:9.1": "esā antaradhāyāmi ",
  "thig11.1:9.2": "kucchiṃ vā pavisāmi te | ",
  "thig11.1:9.3": "bhamukantare tiṭṭhāmi ",
  "thig11.1:9.4": "tiṭṭhantiṃ maṃ na dakkhisi. ",
  "thig11.1:10.1": "cittamhi vasībhūtāhaṃ ",
  "thig11.1:10.2": "iddhipādā subhāvitā | ",
  "thig11.1:10.3": "cha me abhiññā sacchikatā ",
  "thig11.1:10.4": "kataṃ buddhassa sāsanaṃ. ",
  "thig11.1:11.1": "sattisūlūpamā kāmā ",
  "thig11.1:11.2": "khandhānaṃ adhikuṭṭanā | ",
  "thig11.1:11.3": "yaṃ tvaṃ kāmaratiṃ brūsi ",
  "thig11.1:11.4": "arati dāni sā mama. ",
  "thig11.1:12.1": "sabbattha vihatā nandi ",
  "thig11.1:12.2": "tamokkhandho padālito | ",
  "thig11.1:12.3": "evaṃ jānāhi pāpima ",
  "thig11.1:12.4": "nihato tvam asi antakā ti. ",
  "thig11.1:13.1": "Uppalavaṇṇā. || dvādasanipāto ",
  "thig11.1:14.1": "samatto. || udakahārī "
}
