{
  "thig13.5:0.1": "",
  "thig13.5:0.2": "",
  "thig13.5:0.3": "",
  "thig13.5:1.1": "daharāhaṃ suddhavasanā ",
  "thig13.5:1.2": "yaṃ pure dhammam asuṇiṃ | ",
  "thig13.5:1.3": "tassā me appamattāya ",
  "thig13.5:1.4": "saccābhisamayo ahu. ",
  "thig13.5:2.1": "tato 'haṃ sabbakāmesu ",
  "thig13.5:2.2": "bhūsaṃ aratim ajjhagaṃ | ",
  "thig13.5:2.3": "sakkāyasmiṃ bhayaṃ disvā ",
  "thig13.5:2.4": "nekkhammaṃ yeva pihaye. ",
  "thig13.5:3.1": "hitvān' ahaṃ ñātigaṇaṃ ",
  "thig13.5:3.2": "dāsakammakarāni ca | ",
  "thig13.5:3.3": "gāmakhettāni bhītāni ",
  "thig13.5:3.4": "ramaṇīye pamodite | ",
  "thig13.5:4.1": "pahāy' ahaṃ pabbajitā ",
  "thig13.5:4.2": "sāpateyyam anappakaṃ. ",
  "thig13.5:4.3": "evaṃ saddhāya nikkhamma ",
  "thig13.5:4.4": "saddhamme suppavedite | ",
  "thig13.5:5.1": "na me taṃ assa patirūpaṃ ",
  "thig13.5:5.2": "ākiñcaññaṃ hi patthaye | ",
  "thig13.5:5.3": "yā jātarūparajataṃ ",
  "thig13.5:5.4": "ṭhapetvā punar āgame. ",
  "thig13.5:6.1": "rajataṃ jātarūpaṃ vā ",
  "thig13.5:6.2": "na bodhāya na santaye | na ",
  "thig13.5:6.3": "etaṃ samaṇasāruppaṃ ",
  "thig13.5:6.4": "na etaṃ ariyavaḍḍhanaṃ ",
  "thig13.5:7.1": "lobhanaṃ madanaṃ c' etaṃ ",
  "thig13.5:7.2": "mohanaṃ rajavaḍḍhanaṃ | ",
  "thig13.5:7.3": "sāsaṅkaṃ bahuāyāsaṃ ",
  "thig13.5:7.4": "n' atthi c' ettha dhavaṃ ṭhiti. ",
  "thig13.5:8.1": "ettha rattā pamattā ca ",
  "thig13.5:8.2": "saṃkiliṭṭhamanā narā | ",
  "thig13.5:8.3": "aññamaññena byāruddhā ",
  "thig13.5:8.4": "puthukubbanti medhagaṃ. ",
  "thig13.5:9.1": "vadho bandho parikeso ",
  "thig13.5:9.2": "jāni sokapariddavo | ",
  "thig13.5:9.3": "kāmesu adhipannānaṃ ",
  "thig13.5:9.4": "dissate byasanaṃ bahuṃ. ",
  "thig13.5:10.1": "taṃ mañ ñātī amittā va ",
  "thig13.5:10.2": "kiṃ maṃ kāmesu yuñjatha | ",
  "thig13.5:10.3": "jānātha maṃ babbajitaṃ ",
  "thig13.5:10.4": "kāmesu bhayadassina. ",
  "thig13.5:11.1": "na hiraññasuvaṇṇena ",
  "thig13.5:11.2": "parikkhīyanti āsavā | ",
  "thig13.5:11.3": "amittā vadhakā kāmā ",
  "thig13.5:11.4": "sapattā sallabandhanā. ",
  "thig13.5:12.1": "taṃ mañ ñātī amittā va ",
  "thig13.5:12.2": "kiṃ maṃ kāmesu yuñjatha | ",
  "thig13.5:12.3": "jānātha maṃ pabbajitaṃ ",
  "thig13.5:12.4": "muṇḍaṃ saṃghāṭipārutaṃ. ",
  "thig13.5:13.1": "uttiṭṭhapiṇḍo uñcho ca ",
  "thig13.5:13.2": "paṃsukūlañ ca cīvaraṃ | ",
  "thig13.5:13.3": "etaṃ kho kho mama sāruppaṃ ",
  "thig13.5:13.4": "anagārūpanissayo. ",
  "thig13.5:14.1": "vantā mahesinā kāmā ",
  "thig13.5:14.2": "ye dibbā ye ca mānusā | ",
  "thig13.5:14.3": "khemaṭṭhāne vimuttā te ",
  "thig13.5:14.4": "pattā te acalaṃ sukhaṃ. ",
  "thig13.5:15.1": "māhaṃ kāmehi saṃgacchiṃ ",
  "thig13.5:15.2": "yesu tāṇaṃ na vijjati | ",
  "thig13.5:15.3": "amittā vadhakā kāmā ",
  "thig13.5:15.4": "aggikhandhūpamā dukhā. ",
  "thig13.5:16.1": "paripantho eso sabhayo ",
  "thig13.5:16.2": "savighāto sakaṇṭako | ",
  "thig13.5:16.3": "gedho suvisamo c' eso ",
  "thig13.5:16.4": "mahanto mohanāmukho. ",
  "thig13.5:17.1": "upasaggo bhīmarūpo ",
  "thig13.5:17.2": "cakāmā sappasirūpamā | ",
  "thig13.5:17.3": "ye bālā abhinandanti ",
  "thig13.5:17.4": "andhabhūtā puthujjanā. ",
  "thig13.5:18.1": "kāmapaṅkasattā hi janā ",
  "thig13.5:18.2": "bahū loke aviddasū | ",
  "thig13.5:18.3": "pariyantaṃ nābhijānanti ",
  "thig13.5:18.4": "jātiyā maraṇassa ca. ",
  "thig13.5:19.1": "duggatigamanaṃ maggaṃ ",
  "thig13.5:19.2": "manussā kāmahetukaṃ | ",
  "thig13.5:19.3": "bahuṃ ve paṭipajjanti ",
  "thig13.5:19.4": "attano roga-m-āvahaṃ. ",
  "thig13.5:20.1": "evaṃ amittajananā ",
  "thig13.5:20.2": "tāpanā saṃkilesikā | ",
  "thig13.5:20.3": "lokāmisā bandhanīyā ",
  "thig13.5:20.4": "kāmā maraṇabandhanā. ",
  "thig13.5:21.1": "ummādanā ullapanā ",
  "thig13.5:21.2": "kāmā cittapamāthino | ",
  "thig13.5:21.3": "sattānaṃ saṃkilesāya ",
  "thig13.5:21.4": "khippaṃ Mārena oḍḍitaṃ. ",
  "thig13.5:22.1": "anantādīnavā kāmā ",
  "thig13.5:22.2": "bahudukkhā mahāvisā | ",
  "thig13.5:22.3": "appassādā raṇakarā ",
  "thig13.5:22.4": "sukkapakkhavisosanā. ",
  "thig13.5:23.1": "sāhaṃ etādisaṃ katvā ",
  "thig13.5:23.2": "byasanaṃ kāmahetukaṃ | ",
  "thig13.5:23.3": "na taṃ paccāgamissāmi ",
  "thig13.5:23.4": "nibbānābhiratā sadā. ",
  "thig13.5:24.1": "raṇaṃ karitvā kāmānaṃ ",
  "thig13.5:24.2": "sītibhāvābhikaṅkhinī | ",
  "thig13.5:24.3": "appamattā vihissāmi tesaṃ ",
  "thig13.5:24.4": "saṃyojanakkhaye. ",
  "thig13.5:25.1": "asokaṃ virajaṃ khemaṃ ",
  "thig13.5:25.2": "ariyaṭṭhaṅgikaṃ ujuṃ | ",
  "thig13.5:25.3": "taṃ maggaṃ anugacchāmi ",
  "thig13.5:25.4": "yena tiṇṇā mahesino. ",
  "thig13.5:26.1": "imaṃ passatha dhammaṭṭhaṃ ",
  "thig13.5:26.2": "Subbaṃ kammāradhītaraṃ | ",
  "thig13.5:26.3": "anejaṃ upasampajja ",
  "thig13.5:26.4": "rukkhamūlamhi jhāyati. ",
  "thig13.5:27.1": "ajj' aṭṭhamī pabbajitā ",
  "thig13.5:27.2": "saddhā saddhammasobhaṇā | ",
  "thig13.5:27.3": "vinītā Uppalavaṇṇāya ",
  "thig13.5:27.4": "tevijjā maccuhāyini. ",
  "thig13.5:28.1": "sāyaṃ bhujissā anaṇā ",
  "thig13.5:28.2": "bhikkhunī bhāvitindriyā | ",
  "thig13.5:28.3": "sabbayogavisaṃyuttā ",
  "thig13.5:28.4": "katakiccā anāsavā. ",
  "thig13.5:29.1": "taṃ Sakko devasaṅghena ",
  "thig13.5:29.2": "upasaṃgamma iddhiyā | ",
  "thig13.5:29.3": "namassati bhūtapati ",
  "thig13.5:29.4": "Subhaṃ kammāradhītaran ti. ",
  "thig13.5:30.1": "Subhā kammāradhītā. || ",
  "thig13.5:31.1": "vīsatinipāto samatto. || "
}
