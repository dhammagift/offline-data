{
  "thig5.9:0.1": "",
  "thig5.9:0.2": "",
  "thig5.9:0.3": "",
  "thig5.9:1.1": "lūnakesī paṅkadharī ",
  "thig5.9:1.2": "ekasāṭī pure cariṃ | ",
  "thig5.9:1.3": "avajje vajjamatinī ",
  "thig5.9:1.4": "vajje cāvajjadassinī. ",
  "thig5.9:2.1": "divāvihārā nikkhamma ",
  "thig5.9:2.2": "Gijjhakūṭamhi pabbate | ",
  "thig5.9:2.3": "addasaṃ virajaṃ buddhaṃ ",
  "thig5.9:2.4": "bhikkhusaṅghapurakkhataṃ. ",
  "thig5.9:3.1": "nihacca jānuṃ vanditvā ",
  "thig5.9:3.2": "saṃmukhā pañjali ahaṃ | ",
  "thig5.9:3.3": "ehi Bhadde ti avaca ",
  "thig5.9:3.4": "sā me ās' ūpasampadā. ",
  "thig5.9:4.1": "ciṇṇā Aṅgā ca Magadhā ",
  "thig5.9:4.2": "Vajjī Kāsī ca Kosalā | ",
  "thig5.9:4.3": "anaṇā paṇṇāsavassāni ",
  "thig5.9:4.4": "raṭṭhapiṇḍaṃ abhuñji 'haṃ. ",
  "thig5.9:5.1": "puññaṃ ca pasaviṃ bahuṃ ",
  "thig5.9:5.2": "sappañño vat' āyam upāsako | ",
  "thig5.9:5.3": "yo Bhaddāya cīvaram adāsi ",
  "thig5.9:5.4": "muttāya sabbagandhehi. ",
  "thig5.9:6.1": "Bhaddā purāṇanigaṇṭhī. || "
}
