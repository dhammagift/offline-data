  "thig1.1:0.1": "",
  "thig1.1:0.2": "",
  "thig1.1:0.3": "",
  "thig1.1:1.0": "Namo tassa bhagavato arahato sammāsambuddhassa. ",
  "thig1.1:1.1": "sukhaṃ supāhi therīke ",
  "thig1.1:1.2": "katvā coḷena pārutā | ",
  "thig1.1:1.3": "upasanto hi te rāgo ",
  "thig1.1:1.4": "sukkhaḍākaṃ va kumbhiyaṃ. ",
  "thig1.1:2.1": "itthaṃ sudaṃ aññatarā therī apaññātā bhikkhunī gāthaṃ abhāsitthā ti. || "
}
