  "thig1.11:1.1": "sumuttā sādhu mutta mhi ",
  "thig1.11:1.2": "tīhi khujjehi muttiyā | ",
  "thig1.11:1.3": "udukkhalena musalena ",
  "thig1.11:1.4": "patinā khujjakena ca | ",
  "thig1.11:1.5": "mutta mhi jātimaraṇā ",
  "thig1.11:1.6": "bhavanetti samūhatā. ",
  "thig1.11:2.1": "Muttā. || "
}
