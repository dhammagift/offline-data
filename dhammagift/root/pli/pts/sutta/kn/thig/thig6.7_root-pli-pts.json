  "thig6.7:0.1": "",
  "thig6.7:0.2": "",
  "thig6.7:0.3": "",
  "thig6.7:1.1": "Gutte yadatthaṃ pabbajjā ",
  "thig6.7:1.2": "hitvā puttaṃ samussayaṃ | ",
  "thig6.7:1.3": "tam eva anubrūhehi ",
  "thig6.7:1.4": "mā cittassa vasaṃ gami. ",
  "thig6.7:2.1": "cittena vañcitā sattā ",
  "thig6.7:2.2": "Mārassa visaye ratā | ",
  "thig6.7:2.3": "anekajātisaṃsāraṃ ",
  "thig6.7:2.4": "sandhāvanti aviddasū. ",
  "thig6.7:3.1": "kāmacchandañ ca byāpādaṃ ",
  "thig6.7:3.2": "sakkāyadiṭṭhim eva ca | ",
  "thig6.7:3.3": "sīlabbataparāmāsaṃ ",
  "thig6.7:3.4": "vicikicchañ ca pañcamaṃ. ",
  "thig6.7:4.1": "saṃyojanāni etāni ",
  "thig6.7:4.2": "pajahitvāna bhikkhuni | ",
  "thig6.7:4.3": "orambhāgamanīyāni ",
  "thig6.7:4.4": "na-y-idaṃ punar ehisi. ",
  "thig6.7:5.1": "rāgaṃ mānaṃ avijjañ ca ",
  "thig6.7:5.2": "uddhaccañ ca vivajjiya | ",
  "thig6.7:5.3": "saṃyojanāni chetvāna ",
  "thig6.7:5.4": "dukkhass' antaṃ karissasi. ",
  "thig6.7:6.1": "khepetvā jātisaṃsāraṃ ",
  "thig6.7:6.2": "pariññāya punabbhavaṃ | ",
  "thig6.7:6.3": "diṭṭh' eva dhamme nicchātā ",
  "thig6.7:6.4": "upasantā carissasi. ",
  "thig6.7:7.1": "Guttā. || catukkhatuṃ "
}
