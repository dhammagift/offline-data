{
  "thig13.1:0.1": "",
  "thig13.1:0.2": "",
  "thig13.1:0.3": "",
  "thig13.1:1.1": "kāḷakā bhamaravaṇṇasadisā ",
  "thig13.1:1.2": "vellitaggā mama muddhajā ahuṃ | ",
  "thig13.1:1.3": "te jarāya sāṇavākasadisā ",
  "thig13.1:1.4": "saccavādivacanaṃ anaññathā. ",
  "thig13.1:2.1": "vāsito va surabhikaraṇḍako ",
  "thig13.1:2.2": "pupphapūraṃ mama uttamaṅgabhu | ",
  "thig13.1:2.3": "taṃ jarāya sasalomagandhikaṃ ",
  "thig13.1:2.4": "saccavādivacanaṃ anaññathā. ",
  "thig13.1:3.1": "kānanaṃ va sahitaṃ suropitaṃ ",
  "thig13.1:3.2": "kocchasūcivicitaggasobhitaṃ | ",
  "thig13.1:3.3": "taṃ jarāya viraḷaṃ tahiṃ tahiṃ ",
  "thig13.1:3.4": "saccavādivacanaṃ anaññathā. ",
  "thig13.1:4.1": "saṇhagandhakasuvaṇṇamaṇḍitaṃ ",
  "thig13.1:4.2": "sobhate su veṇihi alaṅkataṃ | ",
  "thig13.1:4.3": "taṃ jarāya khalati siraṃ kataṃ ",
  "thig13.1:4.4": "saccavādivacanaṃ anaññathā. ",
  "thig13.1:5.1": "cittakārasukatā va lekhitā ",
  "thig13.1:5.2": "sobhate su bhamukā pure mama | ",
  "thig13.1:5.3": "tā jarāya valihi palambitā ",
  "thig13.1:5.4": "saccavādivacanaṃ anaññathā. ",
  "thig13.1:6.1": "bhassarā surucirā yathā maṇi ",
  "thig13.1:6.2": "nettāhesuṃ abhinīla-m-āyatā | ",
  "thig13.1:6.3": "te jarāy' abhihatā na sobhate ",
  "thig13.1:6.4": "saccavādivacanaṃ anaññathā. ",
  "thig13.1:7.1": "saṇhatuṅgasadisī ca nāsikā ",
  "thig13.1:7.2": "sobhate su abhiyobbanaṃ paṭi | ",
  "thig13.1:7.3": "sā jarāya upakūlitā viya ",
  "thig13.1:7.4": "saccavādivacanaṃ anaññathā. ",
  "thig13.1:8.1": "kaṅkaṇaṃ va sukataṃ suniṭṭhitaṃ ",
  "thig13.1:8.2": "sobhate su mama kaṇṇapāḷiyo pure | ",
  "thig13.1:8.3": "tā jarāya valihi palambitā ",
  "thig13.1:8.4": "saccavādivacanaṃ anaññathā. ",
  "thig13.1:9.1": "pattalimakulavaṇṇasadisā ",
  "thig13.1:9.2": "sobhate su dantā pure mama | ",
  "thig13.1:9.3": "te jarāya khaṇḍā yavapītakā ",
  "thig13.1:9.4": "saccavādivacanaṃ anaññathā. ",
  "thig13.1:10.1": "kānanasmiṃ vanasaṇḍacāriṇī ",
  "thig13.1:10.2": "kokilā va madhuraṃ nikūjitaṃ | ",
  "thig13.1:10.3": "taṃ jarāya khalitaṃ tahiṃ tahiṃ ",
  "thig13.1:10.4": "saccavādivacanaṃ anaññathā. ",
  "thig13.1:11.1": "saṇhakampurī va suppamajjitā ",
  "thig13.1:11.2": "sobhate su gīvā pure mama | ",
  "thig13.1:11.3": "sā jarāya bhaggā vināsitā ",
  "thig13.1:11.4": "saccavādivacanaṃ anaññathā. ",
  "thig13.1:12.1": "vaṭṭapalighasadisopamā ubho ",
  "thig13.1:12.2": "sobhate su bāhā pure mama | ",
  "thig13.1:12.3": "tā jarāya yathā pāṭalī dubbalikā ",
  "thig13.1:12.4": "saccavādivacanaṃ anaññathā. ",
  "thig13.1:13.1": "saṇhamuddikāsuvaṇṇamaṇḍitā ",
  "thig13.1:13.2": "sobhate su hatthā pure mama | ",
  "thig13.1:13.3": "te jarāya yathā mūlamūlikā ",
  "thig13.1:13.4": "saccavādivacanaṃ anaññathā. ",
  "thig13.1:14.1": "pīnavaṭṭapahituggatā ubho ",
  "thig13.1:14.2": "sobhate su thanakā pure mama | ",
  "thig13.1:14.3": "te rindī va lambante 'nodakā ",
  "thig13.1:14.4": "saccavādivacanaṃ anaññathā. ",
  "thig13.1:15.1": "kañcanassa phalakaṃ va sumaṭṭhaṃ ",
  "thig13.1:15.2": "sobhate su kāyo pure mama | ",
  "thig13.1:15.3": "so valini sukhumāhi otato ",
  "thig13.1:15.4": "saccavādivacanaṃ anaññathā. ",
  "thig13.1:16.1": "nāgabhogasadisopamā ubho ",
  "thig13.1:16.2": "sobhate su ūrū pure mama | ",
  "thig13.1:16.3": "te jarāya yathā veḷunāḷiyo ",
  "thig13.1:16.4": "saccavādivacanaṃ anaññathā. ",
  "thig13.1:17.1": "saṇhanūpurasuvaṇṇamaṇḍitā ",
  "thig13.1:17.2": "sobhate su jaṅghā pure mama | ",
  "thig13.1:17.3": "tā jarāya tiladaṇḍakā-r-iva ",
  "thig13.1:17.4": "saccavādivacanaṃ anaññathā. ",
  "thig13.1:18.1": "tūlapuṇṇasadisopamā ubho ",
  "thig13.1:18.2": "sobhate su pādā pure mama | ",
  "thig13.1:18.3": "te jarāya phuṭikā valīmatā ",
  "thig13.1:18.4": "saccavādivacanaṃ anaññathā. ",
  "thig13.1:19.1": "ediso ahu ayaṃ samussayo ",
  "thig13.1:19.2": "jajjaro bahudukkhānam ālayo | ",
  "thig13.1:19.3": "so 'palepapatito jarāgharo ",
  "thig13.1:19.4": "saccavādivacanaṃ anaññathā. ",
  "thig13.1:20.1": "Ambapālī. || samaṇā ti "
}
