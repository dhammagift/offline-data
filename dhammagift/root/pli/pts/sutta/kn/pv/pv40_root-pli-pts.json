  "pv40:0.1": "",
  "pv40:0.2": "",
  "pv40:0.3": "",
  "pv40:1.1": "Idaṃ mama ucchuvanaṃ mahantaṃ ",
  "pv40:1.2": "nibbattati puññaphalaṃ anappakaṃ ",
  "pv40:1.3": "taṃ dāni me paribhogaṃ na upeti ",
  "pv40:1.4": "ācikkha bhante kissa ayaṃ vipāko. [=40].2 ",
  "pv40:2.1": "Haññāmi khajjāmi ca vāyamāmi ",
  "pv40:2.2": "parisakkāmi paribhuñjituṃ kiñci ",
  "pv40:2.3": "svāhaṃ chinnathāmo kapaṇo lālapāmi ",
  "pv40:2.4": "kissa kammassa ayaṃ vipāko. [=40].3 ",
  "pv40:3.1": "Vighāto cāhaṃ paripatāmi chamāyaṃ ",
  "pv40:3.2": "parivattāmi vāricaro va ghamme ",
  "pv40:3.3": "rudato ca me assukā niggalanti ",
  "pv40:3.4": "ācikkha bhante kissa ayaṃ vipāko. [=40].4 ",
  "pv40:4.1": "Chāto kilanto ca pipāsito ca ",
  "pv40:4.2": "santasito sātasukhaṃ na vinde ",
  "pv40:4.3": "pucchāmi taṃ etam atthaṃ bhadante ",
  "pv40:4.4": "kathan nu ucchuparibhogaṃ labheyyaṃ. [=40].5 ",
  "pv40:5.1": "Pure tuvaṃ kammam akāsi attanā ",
  "pv40:5.2": "manussabhūto purimāya jātiyā ",
  "pv40:5.3": "ahañ ca taṃ etam atthaṃ vadāmi ",
  "pv40:5.4": "sutvāna tvaṃ etam atthaṃ vijāna. [=40].6 ",
  "pv40:6.1": "Ucchuṃ tvaṃ khādamāno payāto ",
  "pv40:6.2": "puriso ca te piṭṭhito anvagacchi ",
  "pv40:6.3": "so ca taṃ paccāsanto kathesi ",
  "pv40:6.4": "tassa tuvaṃ na kiñ ci ālapittha. [=40].7 ",
  "pv40:7.1": "So ca taṃ abhaṇantaṃ ayāci ",
  "pv40:7.2": "deh' ayya ucchun ti ca taṃ avoca ",
  "pv40:7.3": "tassa tuvaṃ piṭṭhito ucchuṃ adāsi ",
  "pv40:7.4": "tass' etaṃ kammassa ayaṃ vipāko. [=40].8 ",
  "pv40:8.1": "Iṅgha tuvaṃ piṭṭhito gaṇha ucchuṃ ",
  "pv40:8.2": "gahetvāna khādassu yāvad atthaṃ ",
  "pv40:8.3": "ten' eva tvaṃ attamano bhavissasi ",
  "pv40:8.4": "haṭṭho udaggo ca pamodito ca. [=40].9 ",
  "pv40:9.1": "Gantvāna so piṭṭhito aggahesi ",
  "pv40:9.2": "gahetvāna taṃ khādi yāvad atthaṃ ",
  "pv40:9.3": "ten' eva so attamano ahosi ",
  "pv40:9.4": "haṭṭho udaggo ca pamodito cā ti. ",
  "pv40:10.1": "Ucchupetavatthu pañcamaṃ [=41].1 "
}
