  "pv8:1.1": "nu ummattarūpo va ",
  "pv8:1.2": "lāyitvā haritaṃ tiṇaṃ, ",
  "pv8:1.3": "khāda khādā ti lapasi ",
  "pv8:1.4": "gatasattaṃ jaraggavaṃ. [=8].2 ",
  "pv8:2.1": "Na hi annena pānena ",
  "pv8:2.2": "mato goṇo samuṭṭhahe ",
  "pv8:2.3": "tvaṃ si bālo ca dummedho ",
  "pv8:2.4": "yathā t' añño va dummatī ti. [=8].3 ",
  "pv8:3.1": "Ime pādā idaṃ sīsaṃ ",
  "pv8:3.2": "ayaṃ kāyo savāladhi ",
  "pv8:3.3": "nettā tath' eva tiṭṭhanti ",
  "pv8:3.4": "ayaṃ goṇo samuṭṭhahe. [=8].4 ",
  "pv8:4.1": "Nāyyakassa hatthapādā ",
  "pv8:4.2": "kāyo sīsañ ca dissati ",
  "pv8:4.3": "rudaṃ mattikathūpasmiṃ ",
  "pv8:4.4": "nanu tvañ ñeva dummatī ti. [=8].5 ",
  "pv8:5.1": "Ādittaṃ vata maṃ santaṃ ",
  "pv8:5.2": "ghatasittaṃ va pāvakaṃ ",
  "pv8:5.3": "vārinā viya osiñcaṃ ",
  "pv8:5.4": "sabbaṃ nibbāpaye daraṃ. [=8].6 ",
  "pv8:6.1": "Abbūḷhaṃ vata me sallaṃ ",
  "pv8:6.2": "sokaṃ hadayanissitaṃ ",
  "pv8:6.3": "yo me sokaparetassa ",
  "pv8:6.4": "pitusokaṃ apānudi. [=8].7 ",
  "pv8:7.1": "Svāhaṃ abbūḷhasallo 'smi ",
  "pv8:7.2": "sītibhūto 'smi nibbuto ",
  "pv8:7.3": "na socāmi na rodāmi ",
  "pv8:7.4": "tava sutvāna māṇava. [=8].8 ",
  "pv8:8.1": "Evaṃ karonti sappaññā ",
  "pv8:8.2": "ye honti anukampakā ",
  "pv8:8.3": "vinivattayanti sokamhā ",
  "pv8:8.4": "Sujāto pitaraṃ yathā ti. ",
  "pv8:9.1": "Goṇapetavatthu aṭṭhamaṃ [=9].1 Gūthañ ca "
}
