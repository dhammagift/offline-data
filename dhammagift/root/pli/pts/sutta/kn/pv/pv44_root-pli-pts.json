  "pv44:0.1": "",
  "pv44:0.2": "",
  "pv44:0.3": "",
  "pv44:1.1": "Gūthakūpato uggantvā ",
  "pv44:1.2": "kā nu dīnā patiṭṭhasi ",
  "pv44:1.3": "nissaṃsayaṃ pāpakammantā ",
  "pv44:1.4": "kin nu saddahase tuvaṃ. [=44].2 ",
  "pv44:2.1": "Ahaṃ bhadante petī 'mhi ",
  "pv44:2.2": "duggatā Yamalokikā ",
  "pv44:2.3": "pāpakammaṃ karitvāna ",
  "pv44:2.4": "petalokam ito gatā. [=44].3 ",
  "pv44:3.1": "Kin nu kāyena vācāya ",
  "pv44:3.2": "manasā dukkaṭaṃ kaṭaṃ ",
  "pv44:3.3": "kissa kammavipākena ",
  "pv44:3.4": "idaṃ dukkhaṃ nigacchasi. [=44].4 ",
  "pv44:4.1": "Ahu āvāsiko mayhaṃ ",
  "pv44:4.2": "issukī kulamaccharī ",
  "pv44:4.3": "ajjhosito mayhaṃ ghare ",
  "pv44:4.4": "kadariyo paribhāsako. [=44].5 ",
  "pv44:5.1": "Tassāhaṃ vacanaṃ sutvā ",
  "pv44:5.2": "bhikkhavo paribhāsisaṃ ",
  "pv44:5.3": "tassa kammavipākena ",
  "pv44:5.4": "petalokam ito gatā. [=44].6 ",
  "pv44:6.1": "Amitto mittavaṇṇena ",
  "pv44:6.2": "yo te āsi kulūpako ",
  "pv44:6.3": "kāyassa bhedā duppañño ",
  "pv44:6.4": "kin nu pecca gatiṃ gato. [=44].7 ",
  "pv44:7.1": "Tass' evāhaṃ pāpakammassa ",
  "pv44:7.2": "sīse tiṭṭhāmi matthake ",
  "pv44:7.3": "so ca paravisayaṃ patto ",
  "pv44:7.4": "mam' eva paricārako. [=44].8 ",
  "pv44:8.1": "Yaṃ bhadante hadant' aññe ",
  "pv44:8.2": "etaṃ me hoti bhojanaṃ ",
  "pv44:8.3": "ahañ ca kho yaṃ hadāmi ",
  "pv44:8.4": "etaṃ so upajīvati. ",
  "pv44:9.1": "Gūthakhādakapetavatthu navamaṃ [=45].1 "
}
