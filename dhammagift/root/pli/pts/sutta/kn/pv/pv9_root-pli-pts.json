  "pv9:1.1": "muttaṃ ruhirañ ca pubbaṃ ",
  "pv9:1.2": "paribhuñjati kissa ayaṃ vipāko ",
  "pv9:1.3": "ayan nu kim kammam akāsi nārī ",
  "pv9:1.4": "yā sabbadā lohitapubbabhakkhā. [=9].2 ",
  "pv9:2.1": "Navāni vatthāni subhāni c' eva ",
  "pv9:2.2": "mudūni suddhāni ca lomasāni ",
  "pv9:2.3": "dinnān' imissā kiṭakā bhavanti ",
  "pv9:2.4": "ayaṃ nu kiṃ kammam akāsi nārī ti. [=9].3 ",
  "pv9:3.1": "Bhariyā mam' esā ahū bhadante ",
  "pv9:3.2": "adāyikā maccharinī kadariyā ",
  "pv9:3.3": "sā maṃ dadantaṃ samaṇabrāhmaṇānaṃ ",
  "pv9:3.4": "akkosati paribhāsatī ca: [=9].4 ",
  "pv9:4.1": "Gūthañ ca muttaṃ ruhirañ ca pubbaṃ ",
  "pv9:4.2": "paribhuñja tvaṃ asuciṃ sabbakālaṃ ",
  "pv9:4.3": "etaṃ te paralokasmiṃ hotu ",
  "pv9:4.4": "vatthā ca te kiṭakasamā bhavantu ",
  "pv9:4.5": "etādisaṃ duccaritaṃ caritvā ",
  "pv9:4.6": "idhāgatā cirarattāya khādatī ti. ",
  "pv9:5.1": "Mahāpesakārapetavatthu navamaṃ [=10].1 "
}
