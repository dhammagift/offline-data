  "pv46:0.3": "",
  "pv46:1.1": "Diṭṭhā tayā nirayā tiracchānayonī ",
  "pv46:1.2": "petā asurā athavā pi manussā devā ",
  "pv46:1.3": "sayam addasa kammavipākam attano ",
  "pv46:1.4": "nessāmi taṃ Pāṭaliputtam akkhataṃ. [=46].2 ",
  "pv46:1.5": "",
  "pv46:2.1": "Atthakāmo 'si me yakkha ",
  "pv46:2.2": "hitakāmo 'si devate ",
  "pv46:2.3": "karomi tuyhaṃ vacanaṃ ",
  "pv46:2.4": "tvam asi ācariyo mama [=46].3 ",
  "pv46:3.1": "Diṭṭhā mayā nirayā tiracchānayonī ",
  "pv46:3.2": "petā asurā athavā pi manussā devā ",
  "pv46:3.3": "sayam addasaṃ kammavipākam attano ",
  "pv46:3.4": "kāhāmi puññāni anappakānī ti. ",
  "pv46:4.1": "Pāṭaliputtapetavatthu ekādasamaṃ [=47].1 Ayañ ca "
}
