  "pv51:1.1": "nu ummattarūpo va ",
  "pv51:1.2": "migo bhanto va dhāvasi ",
  "pv51:1.3": "nissaṃsayaṃ pāpakammanto ",
  "pv51:1.4": "kin nu saddāyase tuvaṃ. [=51].2 ",
  "pv51:2.1": "Ahaṃ bhadante peto 'mhi ",
  "pv51:2.2": "duggato Yamalokiko ",
  "pv51:2.3": "pāpakammaṃ karitvāna ",
  "pv51:2.4": "petalokam ito gato. [=51].3 ",
  "pv51:3.1": "Saṭṭhikūṭasahassāni ",
  "pv51:3.2": "paripuṇṇāni sabbaso ",
  "pv51:3.3": "sīse mayhaṃ nipatanti ",
  "pv51:3.4": "te bhindanti ca matthakaṃ. [=51].4 ",
  "pv51:4.1": "Kin nu kāyena vācāya ",
  "pv51:4.2": "manasā dukkaṭaṃ kaṭaṃ ",
  "pv51:4.3": "kissa kammacipākena ",
  "pv51:4.4": "idaṃ dukkhaṃ nigacchasi. [=51].5 ",
  "pv51:5.1": "Saṭṭhikūṭasahassāni ",
  "pv51:5.2": "paripuṇṇāni sabbaso ",
  "pv51:5.3": "sīse tuyhaṃ nipatanti ",
  "pv51:5.4": "te bhindanti ca matthakaṃ. [=51].6 ",
  "pv51:6.1": "Ath' addasāsim sambuddhaṃ ",
  "pv51:6.2": "Sunettaṃ bhāvitindriyaṃ ",
  "pv51:6.3": "nisinnaṃ rukkhamūlasmiṃ ",
  "pv51:6.4": "jhāyantam akutobhayaṃ. [=51].7 ",
  "pv51:7.1": "Sālittakappahārena ",
  "pv51:7.2": "bhindissaṃ tassa matthakaṃ ",
  "pv51:7.3": "tassa kammavipākena ",
  "pv51:7.4": "idaṃ dukkhaṃ nigacchisaṃ. [=51].8 ",
  "pv51:8.1": "Saṭṭhikūṭasahassāni ",
  "pv51:8.2": "paripuṇṇāni sabbaso ",
  "pv51:8.3": "sīse mayhaṃ nipatanti ",
  "pv51:8.4": "te bhindanti ca matthakaṃ. [=51].9 ",
  "pv51:9.1": "Dhammena te kāpurisa, ",
  "pv51:9.2": "saṭṭhikūṭasahassāni ",
  "pv51:9.3": "paripuṇṇāni sabbaso ",
  "pv51:9.4": "sīse tuyham nipatanti ",
  "pv51:9.5": "te bhindanti ca matthakan ti. ",
  "pv51:10.1": "Saṭṭhikūṭasahassapetavatthu soḷasamaṃ ",
  "pv51:11.1": "",
  "pv51:12.1": "Tass' uddānaṃ: ",
  "pv51:13.1": "Ambasakkharo Serīsako ",
  "pv51:13.2": "Piṅgalo Revati-ucchukhādakā ",
  "pv51:13.3": "dve kumārā dve gūthā ",
  "pv51:13.4": "gaṇa-Pāṭali-pokkharañ ca ",
  "pv51:14.1": "akkharukkha-bhogasaṃharā seṭṭhiputta- ",
  "pv51:14.2": "sālittakā ",
  "pv51:14.3": "iti soḷasavatthūni ",
  "pv51:14.4": "vaggo tena pavaccatī ",
  "pv51:15.1": "",
  "pv51:16.1": "ti. ",
  "pv51:16.2": "Petavatthu ",
  "pv51:16.3": "",
  "pv51:16.4": "samattaṃ ",
  "pv51:17.1": ""
}
