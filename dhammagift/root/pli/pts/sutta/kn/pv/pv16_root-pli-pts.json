  "pv16:0.3": "",
  "pv16:1.1": "Kāḷī dubbaṇṇarūpāsi ",
  "pv16:1.2": "pharusā bhīrudassanā ",
  "pv16:1.3": "piṅgalāsi kaḷārāsi ",
  "pv16:1.4": "na taṃ maññāmi mānusin ti. [=16].2 ",
  "pv16:2.1": "Ahaṃ Nandā Nandasena ",
  "pv16:2.2": "bhariyā te pure ahuṃ ",
  "pv16:2.3": "pāpakammaṃ karitvāna ",
  "pv16:2.4": "petalokam ito gatā ti. . [=16].3 ",
  "pv16:3.1": "Kin nu kāyena vācāya ",
  "pv16:3.2": "manasā dukkaṭaṃ kataṃ ",
  "pv16:3.3": "kissa kammavipākena ",
  "pv16:3.4": "petalokam ito gatā ti. [=16].4 ",
  "pv16:4.1": "Caṇḍī pharusavācā ca ",
  "pv16:4.2": "tayi c' āsiṃ agāravā ",
  "pv16:4.3": "tāhaṃ duruttaṃ vatvāna ",
  "pv16:4.4": "petalokam ito gatā ti. [=16].5 ",
  "pv16:5.1": "Hand' uttarīyaṃ dadāmi te ",
  "pv16:5.2": "idaṃ dussaṃ nivāsaya ",
  "pv16:5.3": "imaṃ dussaṃ nivāsetvā ",
  "pv16:5.4": "ehi nessāmi taṃ gharaṃ. [=16].6 ",
  "pv16:6.1": "Vatthañ ca annapānañ ca ",
  "pv16:6.2": "lacchasi tvaṃ gharaṃ gatā ",
  "pv16:6.3": "putte ca te passissasi ",
  "pv16:6.4": "suṇisāyo ca dakkhasi. [=16].7 ",
  "pv16:7.1": "Hatthena hatthe te dinnaṃ ",
  "pv16:7.2": "na mayhaṃ upakappati ",
  "pv16:7.3": "bhikkhū ca sīlasampanne ",
  "pv16:7.4": "vītarāge bahussute, [=16].8 ",
  "pv16:8.1": "Tappehi annapānena ",
  "pv16:8.2": "mama dakkhiṇam ādisa ",
  "pv16:8.3": "tadāhaṃ sukhitā hessaṃ ",
  "pv16:8.4": "sabbakāmasamiddhinī. [=16].9 ",
  "pv16:9.1": "Sādhū ti so paṭissutvā ",
  "pv16:9.2": "dānaṃ vipulam ākiri ",
  "pv16:9.3": "annaṃ pānaṃ khādanīyaṃ ",
  "pv16:9.4": "vatthā-senāsanāni ca, ",
  "pv16:9.5": "chattaṃ gandhañ ca mālañ ca ",
  "pv16:9.6": "vividhā ca upāhanā. [=16].10 ",
  "pv16:10.1": "Bhikkhū ca sīlasampanne ",
  "pv16:10.2": "vītarāge bahussute ",
  "pv16:10.3": "tappetvā annapānena ",
  "pv16:10.4": "tassā dakkhiṇam ādisi. [=16].11 ",
  "pv16:11.1": "Samanantarānuddiṭṭhe ",
  "pv16:11.2": "vipāko upapajjatha ",
  "pv16:11.3": "bhojanacchādanapānīyaṃ ",
  "pv16:11.4": "dakkhiṇāya idaṃ phalaṃ. [=16].12 ",
  "pv16:12.1": "Tato suddhā sucivasanā ",
  "pv16:12.2": "kāsikuttamadhārinī ",
  "pv16:12.3": "vicittavatthābharaṇā ",
  "pv16:12.4": "sāmikaṃ upasaṅkami. [=16].13 ",
  "pv16:13.1": "Abhikkantena vaṇṇena ",
  "pv16:13.2": "yā tvaṃ tiṭṭhasi devate ",
  "pv16:13.3": "obhāsentī disā sabbā ",
  "pv16:13.4": "osadhī viya tārakā, [=16].14 ",
  "pv16:14.1": "Kena t' etādiso vaṇṇo ",
  "pv16:14.2": "kena te idha-m-ijjhati ",
  "pv16:14.3": "uppajjanti ca te bhogā ",
  "pv16:14.4": "ye keci manaso piyā. [=16].15 ",
  "pv16:15.1": "Pucchāmi taṃ devi mahānubhāve ",
  "pv16:15.2": "manussabhūtā kim akāsi puññaṃ ",
  "pv16:15.3": "kenāsi evaṃ jalitānubhāvā ",
  "pv16:15.4": "vaṇṇo ca te sabbadisā pabhāsatī ti. [=16].16 ",
  "pv16:16.1": "Ahaṃ Nandā Nandasena ",
  "pv16:16.2": "bhariyā te pure ahuṃ ",
  "pv16:16.3": "pāpakammaṃ karitvāna ",
  "pv16:16.4": "petalokam ito gatā. [=16].17 ",
  "pv16:17.1": "Tava dinnena dānena ",
  "pv16:17.2": "modāmi akutobhayā ",
  "pv16:17.3": "ciraṃ jīva gahapati ",
  "pv16:17.4": "saha sabbehi ñātibhi, ",
  "pv16:17.5": "asokaṃ virajaṃ ṭhānaṃ ",
  "pv16:17.6": "āvāsaṃ vasavattinaṃ. [=16].18 ",
  "pv16:18.1": "Idha dhammaṃ caritvāna ",
  "pv16:18.2": "dānaṃ datvāna gahapati ",
  "pv16:18.3": "vineyya maccheramalaṃ samūlaṃ ",
  "pv16:18.4": "anindito saggam upehi ṭhānan ti. Nandāpetavatthu tatiyaṃ [=17].1-21 See Vimānavatthu ",
  "pv16:19.1": ""
}
