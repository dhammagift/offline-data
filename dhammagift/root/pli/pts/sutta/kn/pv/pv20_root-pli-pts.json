  "pv20:1.1": "Naggo kiso pabbajito 'si bhante ",
  "pv20:1.2": "rattiṃ kuhiṃ gacchasi kissa hetu ",
  "pv20:1.3": "ācikkha me taṃ api sakkuṇemu ",
  "pv20:1.4": "sabbena vittaṃ paṭipādaye tuvan ti. [=20].2 ",
  "pv20:2.1": "Bārāṇasī nagaraṃ dūraghuṭṭhaṃ ",
  "pv20:2.2": "tatthāhaṃ gahapati aḍḍhako dīno ",
  "pv20:2.3": "adātā gedhitamano āmisasmiṃ ",
  "pv20:2.4": "dussīlyena Yamavisayamhi patto. [=20].3 ",
  "pv20:3.1": "So sūcikāya kilamito tehi ",
  "pv20:3.2": "ten' eva ñātisu yāmi āmisakiñcihetu ",
  "pv20:3.3": "adānasīlā na ca saddahanti: ",
  "pv20:3.4": "dānaphalaṃ hoti paramhi loke. [=20].4 ",
  "pv20:4.1": "Dhītā ca mayhaṃ lapate abhikkhaṇaṃ; ",
  "pv20:4.2": "dassāmi dānaṃ pitunnaṃ pitāmahānaṃ ",
  "pv20:4.3": "upakkhaṭaṃ parivisayanti brāhmaṇe ",
  "pv20:4.4": "yāmy' ahaṃ Andhakavindaṃ bhottuṃ. [=20].5 ",
  "pv20:5.1": "Tam avoca rājā: anubhaviyāna tam pi ",
  "pv20:5.2": "eyyāsi khippaṃ aham pi karissaṃ pūjaṃ ",
  "pv20:5.3": "ācikkha me taṃ yadi atthi hetu ",
  "pv20:5.4": "saddhāyitaṃ hetuvaco suṇomi. [=20].6 ",
  "pv20:6.1": "Tathā ti vatvā agamāsi tattha ",
  "pv20:6.2": "bhuñjiṃsu bhattaṃ na ca pana dakkhiṇārahā ",
  "pv20:6.3": "paccāgami Rājagahaṃ punāparaṃ ",
  "pv20:6.4": "pātur ahosi purato janādhipassa. [=20].7 ",
  "pv20:7.1": "Disvāna petaṃ. punar eva āgataṃ ",
  "pv20:7.2": "rājā avoca: aham api kiṃ dadāmi ",
  "pv20:7.3": "ācikkha me taṃ yadi atthi hetu ",
  "pv20:7.4": "yena tuvaṃ cirataraṃ pīṇito siyā. [=20].8 ",
  "pv20:8.1": "Buddhañ ca saṅghaṃ parivisiyāna rāja ",
  "pv20:8.2": "annena pānena pi cīvarena ",
  "pv20:8.3": "taṃ dakkhiṇaṃ ādisā me hitāya ",
  "pv20:8.4": "evaṃ ahaṃ cirataraṃ pīṇito siyā. [=20].9 ",
  "pv20:9.1": "Tato ca rājā nipatitva tāvade ",
  "pv20:9.2": "dānaṃ sahatthā atulaṃ daditvā saṅghe ",
  "pv20:9.3": "ārocayī pakatiṃ tathāgatassa ",
  "pv20:9.4": "tassa ca petassa dakkhiṇaṃ ādisittha. [=20].10 ",
  "pv20:10.1": "So pūjito ativiya sobhamāno ",
  "pv20:10.2": "pātur ahosi purato janādhipassa: ",
  "pv20:10.3": "yakkho 'ham asmi paramiddhipatto ",
  "pv20:10.4": "na mayham iddhi samasadisā mānusā. [=20].11 ",
  "pv20:11.1": "Passānubhāvaṃ aparimitaṃ mamedaṃ ",
  "pv20:11.2": "tayānuddiṭṭhaṃ atulaṃ daditvā saṅghe ",
  "pv20:11.3": "santappito satataṃ sadā bahūhi ",
  "pv20:11.4": "yāmi ahaṃ sukhito manussadevā ti. ",
  "pv20:12.1": "Cūḷaseṭṭhipetavatthu aṭṭhamaṃ [=21].1 ",
  "pv20:12.2": ""
}
