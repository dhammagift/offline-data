  "pv11:1.1": "setena paleti hatthinā ",
  "pv11:1.2": "majjhe pana assatarīrathena ",
  "pv11:1.3": "pacchā ca kaññā sivikāya niyyati ",
  "pv11:1.4": "obhāsayantī dasa sabbaso disā. [=11].2 ",
  "pv11:2.1": "Tumhe pana muggarahatthapāṇino ",
  "pv11:2.2": "rudammukhā bhinnapabhinnagattā ",
  "pv11:2.3": "manussabhūtā kim akattha pāpaṃ ",
  "pv11:2.4": "yen' aññamaññassa pivātha lohitan ti. [=11].3 ",
  "pv11:3.1": "Purato va yo gacchati kuñjarena ",
  "pv11:3.2": "setena nāgena catukkamena ",
  "pv11:3.3": "amhāka putto ahu jeṭṭhako so ",
  "pv11:3.4": "dānāni datvāna sukhī pamodati. [=11].4 ",
  "pv11:4.1": "Yo so majjhe assatarīrathena ",
  "pv11:4.2": "catubbhi yuttena suvaggitena ",
  "pv11:4.3": "amhāka putto ahu majjhimo so ",
  "pv11:4.4": "amaccharī dānapatī virocati. [=11].5 ",
  "pv11:5.1": "Yā sā ca pacchā sivikāya niyyati ",
  "pv11:5.2": "nārī sapaññā migamandalocanā ",
  "pv11:5.3": "amhāka dhītā ahu sā kaniṭṭhā ",
  "pv11:5.4": "bhāgaḍḍhabhāgena sukhī pamodati. [=11].6 ",
  "pv11:6.1": "Ete ca dānāni adaṃsu pubbe ",
  "pv11:6.2": "pasannacittā samaṇabrāhmaṇānaṃ ",
  "pv11:6.3": "mayaṃ pana maccharino ahumhā ",
  "pv11:6.4": "paribhāsakā samaṇabrāhmaṇānaṃ ",
  "pv11:6.5": "ete padatvā paricārayanti mayañ ca ",
  "pv11:6.6": "sussāma naḷo va chinno ti. [=11].7 ",
  "pv11:7.1": "Kiṃ tumhākaṃ bhojanaṃ kiṃ sayānaṃ ",
  "pv11:7.2": "kathaṃ su yāpetha supāpadhammino ",
  "pv11:7.3": "pahūtabhogesu anappakesu ",
  "pv11:7.4": "sukhaṃ virādhāya dukh' ajja pattā ti. [=11].8 ",
  "pv11:8.1": "Aññamaññaṃ vadhitvāna ",
  "pv11:8.2": "pivāma pubbalohitaṃ ",
  "pv11:8.3": "bahum pītvā na dhātā homa ",
  "pv11:8.4": "na cchādimhase mayaṃ. [=11].9 ",
  "pv11:9.1": "Icc eva maccā paridevayanti ",
  "pv11:9.2": "adāyakā pecca Yamassa ṭhāyino ",
  "pv11:9.3": "ye te viditvā adhigamma bhoge ",
  "pv11:9.4": "na bhuñjare nā pi karonti puññaṃ. [=11].10 ",
  "pv11:10.1": "Te khuppipāsūpagatā parattha ",
  "pv11:10.2": "petā ciraṃ jhāyare ḍayhamānā ",
  "pv11:10.3": "kammāni katvāna dukhudrayāni ",
  "pv11:10.4": "anubhonti dukkhaṃ kaṭukapphalāni. [=11].11 ",
  "pv11:11.1": "Ittaraṃ hi dhanaṃ dhaññaṃ ",
  "pv11:11.2": "ittaraṃ idha jīvitaṃ ",
  "pv11:11.3": "ittaraṃ ittarato ñatvā ",
  "pv11:11.4": "dīpaṃ kayirātha paṇḍito. [=11].12 ",
  "pv11:12.1": "Ye te evaṃ pajānanti ",
  "pv11:12.2": "narā dhammassa kovidā ",
  "pv11:12.3": "te dāne na ppamajjanti ",
  "pv11:12.4": "sutvā arahataṃ vaco ti. ",
  "pv11:13.1": "Nāgapetavatthu ekādasamaṃ [=12].1 Urago va "
}
