  "pv43:0.1": "",
  "pv43:0.2": "",
  "pv43:0.3": "",
  "pv43:1.1": "Gūthakūpato uggantvā ",
  "pv43:1.2": "ko nu dīno patiṭṭhasi ",
  "pv43:1.3": "nissaṃsayaṃ pāpakammanto ",
  "pv43:1.4": "kin nu saddahase tuvaṃ. [=43].2 ",
  "pv43:2.1": "Ahaṃ bhadente peto 'mhi ",
  "pv43:2.2": "duggato Yamalokiko ",
  "pv43:2.3": "pāpakammaṃ karitvāna ",
  "pv43:2.4": "petalokam ito gato. [=43].3 ",
  "pv43:3.1": "Kin nu kāyena vācāya ",
  "pv43:3.2": "manasā dukkaṭaṃ kaṭaṃ ",
  "pv43:3.3": "kissa kammavipākena ",
  "pv43:3.4": "idaṃ dukkhaṃ nigacchasi. [=43].4 ",
  "pv43:4.1": "Ahu āvāsiko mayhaṃ ",
  "pv43:4.2": "issukī kulamaccharī ",
  "pv43:4.3": "ajjhosito mayhaṃ ghare ",
  "pv43:4.4": "kadariyo paribhāsako. [=43].5 ",
  "pv43:5.1": "Tassāhaṃ vacanaṃ sutvā ",
  "pv43:5.2": "bhikkhavo paribhāsisaṃ ",
  "pv43:5.3": "tassa kammavipākena ",
  "pv43:5.4": "petalokam ito gato. [=43].6 ",
  "pv43:6.1": "Amitto mittavaṇṇena ",
  "pv43:6.2": "yo te āsi kulūpako ",
  "pv43:6.3": "kāyassa bhedā duppañño ",
  "pv43:6.4": "kin nu pecca gatiṃ gato. [=43].7 ",
  "pv43:7.1": "Tass' evāhaṃ pāpakammassa ",
  "pv43:7.2": "sīse tiṭṭhāmi matthake ",
  "pv43:7.3": "so ca paravisayaṃ patto ",
  "pv43:7.4": "mam' eva paricārako. [=43].8 ",
  "pv43:8.1": "Yaṃ bhadante hadant' aññe ",
  "pv43:8.2": "etaṃ me hoti bhojanaṃ ",
  "pv43:8.3": "ahañ ca kho yaṃ hadāmi ",
  "pv43:8.4": "etaṃ so upajīvati. ",
  "pv43:9.1": "Gūthakhādakapetavatthu aṭṭhamaṃ [=44].1 "
}
