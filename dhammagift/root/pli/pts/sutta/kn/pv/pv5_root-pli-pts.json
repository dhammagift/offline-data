  "pv5:1.1": "tiṭṭhanti ",
  "pv5:1.2": "sandhisiṅghāṭakesu ca ",
  "pv5:1.3": "dvārabāhāsu tiṭṭhanti ",
  "pv5:1.4": "āgantvāna sakaṃ gharaṃ. [=5].2 ",
  "pv5:2.1": "Pahūte annapānamhi ",
  "pv5:2.2": "khajjabhojje upaṭṭhite ",
  "pv5:2.3": "na tesaṃ koci sarati ",
  "pv5:2.4": "sattānaṃ kammapaccayā. [=5].3 ",
  "pv5:3.1": "Evaṃ dadanti ñātīnaṃ ",
  "pv5:3.2": "ye honti anukampakā ",
  "pv5:3.3": "suciṃ paṇītaṃ kālena ",
  "pv5:3.4": "kappiyaṃ pānabhojanaṃ: ",
  "pv5:3.5": "idaṃ vo ñātīnaṃ hotu ",
  "pv5:3.6": "sukhitā hontu ñātayo. [=5].4 ",
  "pv5:4.1": "Te ca tattha samāgantvā ",
  "pv5:4.2": "ñātipetā samāgatā ",
  "pv5:4.3": "pahūte annapānamhi ",
  "pv5:4.4": "sakkaccaṃ anumodare: [=5].5 ",
  "pv5:5.1": "Ciraṃ jīvantu no ñātī ",
  "pv5:5.2": "yesaṃ hetu labhāmase ",
  "pv5:5.3": "amhākañ ca katā pūjā ",
  "pv5:5.4": "dāyakā ca anipphalā. [=5].6 ",
  "pv5:6.1": "Na hi tattha kasī atthi ",
  "pv5:6.2": "gorakkh' ettha na vijjati ",
  "pv5:6.3": "vaṇijjā tādisī natthi ",
  "pv5:6.4": "hiraññena kayakkayaṃ, ",
  "pv5:6.5": "ito dinnena yāpenti ",
  "pv5:6.6": "petā kālakatā tahiṃ. [=5].7 ",
  "pv5:7.1": "Unname udakaṃ vuṭṭhaṃ ",
  "pv5:7.2": "yathā ninnaṃ pavattati ",
  "pv5:7.3": "evam eva ito dinnaṃ ",
  "pv5:7.4": "petānaṃ upakappati. [=5].8 ",
  "pv5:8.1": "Yathā vārivahā pūrā ",
  "pv5:8.2": "paripūrenti sāgaraṃ ",
  "pv5:8.3": "evam eva ito dinnaṃ ",
  "pv5:8.4": "petānaṃ upakappati. [=5].9 ",
  "pv5:9.1": "Adāsi me akāsi me ",
  "pv5:9.2": "ñātimittā sakhā ca me ",
  "pv5:9.3": "petānaṃ dakkhiṇaṃ dajjā ",
  "pv5:9.4": "pubbe katam anussaraṃ. [=5].10 ",
  "pv5:10.1": "Na hi ruṇṇaṃ va soko vā ",
  "pv5:10.2": "yā c' aññā paridevanā ",
  "pv5:10.3": "na taṃ petānam atthāya ",
  "pv5:10.4": "evaṃ tiṭṭhanti ñātayo. [=5].11 ",
  "pv5:11.1": "Ayañ ca kho dakkhiṇā dinnā ",
  "pv5:11.2": "saṅghamhi suppatiṭṭhitā ",
  "pv5:11.3": "dīgharattaṃ hitāy' assa ",
  "pv5:11.4": "ṭhānaso upakappati. [=5].12 ",
  "pv5:12.1": "So ñātidhammo ca ayaṃ nidassito ",
  "pv5:12.2": "petānaṃ pūjā ca katā uḷārā ",
  "pv5:12.3": "balañ ca bhikkhūnam anuppadinnaṃ ",
  "pv5:12.4": "tumhehi puññaṃ pasutaṃ anappakan ti. ",
  "pv5:13.1": "Tirokuḍḍapetavatthu pañcamaṃ [=6].1 "
}
