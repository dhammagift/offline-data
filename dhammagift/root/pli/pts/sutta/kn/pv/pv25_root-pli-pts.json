  "pv25:1.1": "Ahu rājā Brahmadatto ",
  "pv25:1.2": "Pañcālānaṃ rathesabho ",
  "pv25:1.3": "ahorattānam accayā ",
  "pv25:1.4": "rājā kālaṅkarī tadā. [=25].2 ",
  "pv25:2.1": "Tassa āḷāhanaṃ gantvā ",
  "pv25:2.2": "bhariyā kandati Ubbarī ",
  "pv25:2.3": "Brahmadattaṃ apassantī ",
  "pv25:2.4": "Brahmadattā ti kandati. [=25].3 ",
  "pv25:3.1": "Isi ca tattha āgacchi ",
  "pv25:3.2": "sampannacaraṇo muni ",
  "pv25:3.3": "so ca tattha apucchittha ",
  "pv25:3.4": "ye tattha su samāgatā: [=25].4 ",
  "pv25:4.1": "Kassa c' idaṃ āḷāhanaṃ ",
  "pv25:4.2": "nānāgandhasameritaṃ ",
  "pv25:4.3": "kassāyaṃ kandati bhariyā ",
  "pv25:4.4": "ito dūragataṃ patiṃ, ",
  "pv25:4.5": "Brahmadattaṃ apassantī ",
  "pv25:4.6": "Brahmadattā ti kandati. [=25].5 ",
  "pv25:5.1": "Te ca tattha viyākaṃsu ",
  "pv25:5.2": "ye tattha su samāgatā: ",
  "pv25:5.3": "Brahmadattassa bhaddan te, ",
  "pv25:5.4": "Brahmadattassa mārisa. [=25].6 ",
  "pv25:6.1": "Tassa idaṃ āḷāhanaṃ ",
  "pv25:6.2": "nānāgandhasameritaṃ ",
  "pv25:6.3": "tassāyaṃ kandati bhariyā ",
  "pv25:6.4": "ito dūragataṃ patiṃ, ",
  "pv25:6.5": "Brahmadattaṃ apassantī ",
  "pv25:6.6": "Brahmadattā ti kandatī ",
  "pv25:7.1": "ti. [=25].7 Chaḷāsīti sahassāni ",
  "pv25:7.2": "Brahmadatta ssanāmakā ",
  "pv25:7.3": "imasmiṃ āḷāhane daḍḍhā ",
  "pv25:7.4": "tesaṃ kam anusocasī ti. [=25].8 ",
  "pv25:8.1": "Yo rājā Cūḷanīputto ",
  "pv25:8.2": "Pañcālānaṃ rathesabho ",
  "pv25:8.3": "taṃ bhante anusocāmi ",
  "pv25:8.4": "bhattāraṃ sabbakāmadaṃ. [=25].9 ",
  "pv25:9.1": "Sabbe v' ahesuṃ rājāno ",
  "pv25:9.2": "Brahmadatta ssanāmakā ",
  "pv25:9.3": "sabbe va Cūḷanīputtā ",
  "pv25:9.4": "Pañcālānaṃ rathesabhā. [=25].10 ",
  "pv25:10.1": "Sabbesaṃ anupubbena ",
  "pv25:10.2": "mahesittam akārayi ",
  "pv25:10.3": "kasmā purimake hitvā ",
  "pv25:10.4": "pacchimaṃ anusocasī ti. [=25].11 ",
  "pv25:11.1": "Ātume itthibhūtāya ",
  "pv25:11.2": "dīgharattāya mārisa ",
  "pv25:11.3": "yassā me itthibhūtāya ",
  "pv25:11.4": "saṃsāre bahu bhāsasī ti. [=25].12 ",
  "pv25:12.1": "Ahu itthi ahu puriso ",
  "pv25:12.2": "pasuyonim pi āgamā ",
  "pv25:12.3": "evam etaṃ atītānaṃ ",
  "pv25:12.4": "pariyanto na dissatī ti. [=25].13 ",
  "pv25:13.1": "Ādittaṃ vata maṃ santaṃ ",
  "pv25:13.2": "ghatasittaṃ va pāvakaṃ ",
  "pv25:13.3": "vārinā viya osiñcaṃ ",
  "pv25:13.4": "sabbaṃ nibbāpaye daraṃ. [=25].14 ",
  "pv25:14.1": "Abbūḷhaṃ vata me sallaṃ ",
  "pv25:14.2": "sokaṃ hadayanissitaṃ ",
  "pv25:14.3": "yo me sokaparetāya ",
  "pv25:14.4": "patisokaṃ apānudi. [=25].15 ",
  "pv25:15.1": "Sāhaṃ abbūḷhasallāsmi ",
  "pv25:15.2": "sītibhūtāsmi nibbutā ",
  "pv25:15.3": "na socāmi na rodāmi ",
  "pv25:15.4": "tava sutvā mahāmunī ti. [=25].16 ",
  "pv25:16.1": "Tassa taṃ vacanaṃ sutvā ",
  "pv25:16.2": "samaṇassa subhāsitaṃ ",
  "pv25:16.3": "pattacīvaram ādāya ",
  "pv25:16.4": "pabbaji anagāriyaṃ. [=25].17 ",
  "pv25:17.1": "Sā ca pabbajitā santā ",
  "pv25:17.2": "agārasmā anagāriyaṃ ",
  "pv25:17.3": "mettaṃ cittaṃ abhāvesi ",
  "pv25:17.4": "brahmalokūpapattiyā. [=25].18 ",
  "pv25:18.1": "Gāmā gāmaṃ vicarantī ",
  "pv25:18.2": "nigame rājadhāniyo ",
  "pv25:18.3": "Uruvelā nāma so gāmo ",
  "pv25:18.4": "yattha kālam akubbatha. [=25].19 ",
  "pv25:19.1": "Mettacittam ābhāvetvā ",
  "pv25:19.2": "brahmalokūpapattiyā ",
  "pv25:19.3": "itthicittaṃ virājetvā ",
  "pv25:19.4": "brahmalokūpagā ahū ti. ",
  "pv25:20.1": "Ubbaripetavatthu terasamaṃ ",
  "pv25:21.1": "",
  "pv25:22.1": "Tass' uddānaṃ: ",
  "pv25:23.1": "Paṇḍu mātā patiyā ca ",
  "pv25:23.2": "Nandā kuṇḍalinā Ghato ",
  "pv25:23.3": "dve seṭṭhī tunnavāyo ca ",
  "pv25:23.4": "vihāra-sutta-sopānaUbbarī ti. [=26].1 "
}
