{
  "pv24:0.1": "",
  "pv24:0.2": "",
  "pv24:0.3": "",
  "pv24:1.1": "Soṇṇasopānaphalakā ",
  "pv24:1.2": "soṇṇavālukasanthatā ",
  "pv24:1.3": "tattha sogandhiyā vaggu ",
  "pv24:1.4": "sucigandhā manoramā. [=24].2 ",
  "pv24:2.1": "Nānārukkhehi sañchannā ",
  "pv24:2.2": "nānāgandhasameritā ",
  "pv24:2.3": "nānāpadumasañchannā ",
  "pv24:2.4": "puṇḍarīkasamotatā. [=24].3 ",
  "pv24:3.1": "Surabhī sampavāyanti ",
  "pv24:3.2": "manuññā māluteritā ",
  "pv24:3.3": "haṃsakoñcābhirudā cakkavākābhikūjitā. [=24].4 ",
  "pv24:3.4": "",
  "pv24:4.1": "Nānādijagaṇākiṇṇā ",
  "pv24:4.2": "nānāsaragaṇāyutā ",
  "pv24:4.3": "nānāphaladharā rukkhā ",
  "pv24:4.4": "nānāpupphadharā vanā. [=24].5 ",
  "pv24:5.1": "Na manussesu īdisaṃ ",
  "pv24:5.2": "nagaraṃ yādisaṃ idaṃ ",
  "pv24:5.3": "pāsādā bahukā tuyhaṃ ",
  "pv24:5.4": "sovaṇṇarūpiyāmayā, ",
  "pv24:5.5": "daddallamānā ābhenti ",
  "pv24:5.6": "samantā caturo disā. [=24].6 ",
  "pv24:6.1": "Pañca dāsisatā tuyhaṃ ",
  "pv24:6.2": "yā te 'mā paricārikā ",
  "pv24:6.3": "tā kambukāyūradharā ",
  "pv24:6.4": "kañcanāveḷabhūsitā. [=24].7 ",
  "pv24:7.1": "Pallaṅkā bahukā tuyhaṃ ",
  "pv24:7.2": "sovannarūpiyāmāyā ",
  "pv24:7.3": "kadalimigasañchannā ",
  "pv24:7.4": "sajjā goṇakasanthatā, [=24].8 ",
  "pv24:8.1": "Yattha tvaṃ vāsūpagatā ",
  "pv24:8.2": "sabbakāmasamiddhinī. ",
  "pv24:8.3": "sampattāy' aḍḍharattāya ",
  "pv24:8.4": "tato uṭṭhāya gacchasi. [=24].9 ",
  "pv24:9.1": "Uyyānabhūmiṃ gantvāna ",
  "pv24:9.2": "pokkharaññā samantato, ",
  "pv24:9.3": "tassā tīre tuvaṃ ṭhāsi ",
  "pv24:9.4": "harite saddale subhe. [=24].10 ",
  "pv24:10.1": "Tato te kaṇṇamuṇḍo sunakho ",
  "pv24:10.2": "aṅga-m-aṅgāni khādati; ",
  "pv24:10.3": "yadā ca khāyitā āsi ",
  "pv24:10.4": "aṭṭhisaṅkhalikā katā ",
  "pv24:10.5": "ogāhasi pokkharaṇiṃ ",
  "pv24:10.6": "hoti kāyo yathā pure. [=24].11 ",
  "pv24:11.1": "Tato tuvaṃ aṅgapaccaṅgā ",
  "pv24:11.2": "sucārū piyadassanā ",
  "pv24:11.3": "vatthena pārupitvāna ",
  "pv24:11.4": "āyāsi mama santikaṃ. [=24].12 ",
  "pv24:12.1": "Kin nu kāyena vācāya ",
  "pv24:12.2": "manasā dukkaṭaṃ kataṃ ",
  "pv24:12.3": "kissa kammavipākena ",
  "pv24:12.4": "kaṇṇamuṇḍo ca sunakho ",
  "pv24:12.5": "aṅga-m-aṅgāni khādatī ti. [=24].13 ",
  "pv24:13.1": "Kimbilāyaṃ gahapati ",
  "pv24:13.2": "saddho āsi upāsako ",
  "pv24:13.3": "tassāhaṃ bhariyā āsiṃ ",
  "pv24:13.4": "dussīlā aticārinī. [=24].14 ",
  "pv24:14.1": "Evaṃ aticaramānāya ",
  "pv24:14.2": "sāmiko etad abravi: ",
  "pv24:14.3": "n' etaṃ channaṃ, na ppaṭirūpaṃ ",
  "pv24:14.4": "yaṃ tvaṃ aticarāsi maṃ. [=24].15 ",
  "pv24:15.1": "Sāhaṃ ghorañ ca sapathaṃ ",
  "pv24:15.2": "musāvādaṃ abhāsisaṃ: ",
  "pv24:15.3": "nāhaṃ taṃ aticarāmi ",
  "pv24:15.4": "kāyena uda cetasā. [=24].16 ",
  "pv24:16.1": "Sacāhaṃ taṃ aticarāmi ",
  "pv24:16.2": "kāyena uda cetasā ",
  "pv24:16.3": "kaṇṇamuṇḍo 'yaṃ sunakho ",
  "pv24:16.4": "aṅga-m-aṅgāni khādatu. [=24].17 ",
  "pv24:17.1": "Tassa kammassa vipākaṃ ",
  "pv24:17.2": "musāvādassa cūbhayaṃ ",
  "pv24:17.3": "satt' eva vassasatāni ",
  "pv24:17.4": "anubhūtaṃ yato pi me ",
  "pv24:17.5": "kaṇṇamuṇḍo ca sunakho ",
  "pv24:17.6": "aṅga-m-aṅgāni khādati. [=24].18 ",
  "pv24:18.1": "Tvañ ca deva bahukāro ",
  "pv24:18.2": "atthāya me idhāgato ",
  "pv24:18.3": "sumuttāhaṃ kaṇṇamuṇḍassa ",
  "pv24:18.4": "asokā akutobhayā. [=24].19 ",
  "pv24:19.1": "Tāhaṃ deva namassāmi ",
  "pv24:19.2": "yācāmi pañjalīkatā ",
  "pv24:19.3": "bhuñja amānuse kāme ",
  "pv24:19.4": "rama deva mayā sahā ti. [=24].20 ",
  "pv24:20.1": "Bhuttā amānusā kāmā ",
  "pv24:20.2": "ramito 'mhi tayā saha ",
  "pv24:20.3": "tāhaṃ subhage yācāmi ",
  "pv24:20.4": "khippaṃ paṭinayāhi man ti. ",
  "pv24:21.1": "Kaṇṇamuṇḍapetavatthu dvādasamaṃ [=25].1 "
}
