{
  "pv26:0.1": "",
  "pv26:0.2": "",
  "pv26:0.3": "",
  "pv26:1.1": "Abhijjamāne vārimhi ",
  "pv26:1.2": "Gaṅgaya idha gacchasi ",
  "pv26:1.3": "naggo pubbaddhapeto va ",
  "pv26:1.4": "mālādhārī alaṅkato, ",
  "pv26:1.5": "kuhiṃ gamissasi peta ",
  "pv26:1.6": "kattha vāso bhavissatī ti. [=26].2 ",
  "pv26:2.1": "Cundatthikaṃ gamissāmi ",
  "pv26:2.2": "peto so iti bhāsati ",
  "pv26:2.3": "antare Vāsabhagāmaṃ ",
  "pv26:2.4": "Bārāṇasiyā ca santike. [=26].3 ",
  "pv26:3.1": "Tañ ca disvā mahāmatto ",
  "pv26:3.2": "Koliyo iti vissuto ",
  "pv26:3.3": "sattubhattañ ca petassa ",
  "pv26:3.4": "pītakañ ca yugaṃ adā. [=26].4 ",
  "pv26:4.1": "Nāvāya tiṭṭhamānāya ",
  "pv26:4.2": "kappakassa adapāyi ",
  "pv26:4.3": "kappakassa padinnamhi ",
  "pv26:4.4": "ṭhāne petass' udissatha. [=26].5 ",
  "pv26:5.1": "Tato suvatthavasano ",
  "pv26:5.2": "mālādhārī alaṅkato ",
  "pv26:5.3": "ṭhāne ṭhit' assa petassa ",
  "pv26:5.4": "dakkhiṇā upakappatha; ",
  "pv26:5.5": "tasmā dajjetha petānaṃ ",
  "pv26:5.6": "anukampāya punappunan ti. [=26].6 ",
  "pv26:6.1": "Sāhunnavasanā eke ",
  "pv26:6.2": "aññe kesanivāsanā ",
  "pv26:6.3": "petā bhattāya gacchanti ",
  "pv26:6.4": "pakkamanti disodisaṃ. [=26].7 ",
  "pv26:7.1": "Dūre eke padhāvitvā ",
  "pv26:7.2": "aladdhā ca nivattare ",
  "pv26:7.3": "chātā pamucchitā bhantā ",
  "pv26:7.4": "bhūmiyaṃ paṭisumbhitā. [=26].8 ",
  "pv26:8.1": "Keci tattha papatitā ",
  "pv26:8.2": "bhūmiyaṃ paṭisumbhitā ",
  "pv26:8.3": "pubbe akatakalyāṇā ",
  "pv26:8.4": "aggidaḍḍhā va ātape. [=26].9 ",
  "pv26:9.1": "Mayaṃ pubbe pāpadhammā ",
  "pv26:9.2": "gharaṇī kulamātaro ",
  "pv26:9.3": "santesu deyyadhammesu ",
  "pv26:9.4": "dīpaṃ nākamha attano. [=26].10 ",
  "pv26:10.1": "Pahūtaṃ annapānam pi ",
  "pv26:10.2": "api ssu avakirīyati ",
  "pv26:10.3": "sammaggate pabbajite ",
  "pv26:10.4": "na ca kiñ ci adamhase. [=26].11 ",
  "pv26:11.1": "Akammakāmā alasā ",
  "pv26:11.2": "sādukāmā mahagghasā ",
  "pv26:11.3": "ālopapiṇḍadātāro ",
  "pv26:11.4": "pāṭiggahe paribhāsimhase. [=26].12 ",
  "pv26:12.1": "Te gharā tā ca dāsiyo ",
  "pv26:12.2": "tān' evābharaṇāni no ",
  "pv26:12.3": "te aññe paricārenti ",
  "pv26:12.4": "mayaṃ dukkhassa bhāgino. [=26].13 ",
  "pv26:13.1": "Veṇī vā avaññā honti ",
  "pv26:13.2": "rathakārī ca dubbhikā ",
  "pv26:13.3": "caṇḍālī kapaṇā honti ",
  "pv26:13.4": "nhāminī ca punappunaṃ. [=26].14 ",
  "pv26:14.1": "Yāni yāni nihīnāni ",
  "pv26:14.2": "kulāni kapaṇāni ca ",
  "pv26:14.3": "tesu tesv eva jāyanti ",
  "pv26:14.4": "esā maccharino gati. [=26].15 ",
  "pv26:15.1": "Pubbe ca katakalyāṇā ",
  "pv26:15.2": "dāyakā vītamaccharā ",
  "pv26:15.3": "saggaṃ te paripūrenti ",
  "pv26:15.4": "obhāsenti ca Nandanaṃ. [=26].16 ",
  "pv26:16.1": "Vejayante ca pāsāde ",
  "pv26:16.2": "ramitvā kāmakāmino ",
  "pv26:16.3": "uccākulesu jāyanti ",
  "pv26:16.4": "sabhogesu tato cutā. [=26].17 ",
  "pv26:17.1": "Kūṭāgāre ca pāsāde ",
  "pv26:17.2": "pallaṅke goṇakatthate ",
  "pv26:17.3": "vījitaṅgā morahatthehi ",
  "pv26:17.4": "kule jātā yasassino. [=26].18 ",
  "pv26:18.1": "Aṅkato aṅkaṃ gacchanti ",
  "pv26:18.2": "mālādhārī alaṅkatā ",
  "pv26:18.3": "dhātiyo upatiṭṭhanti ",
  "pv26:18.4": "sāyaṃ pātaṃ sukhesino. [=26].19 ",
  "pv26:19.1": "Na-y-idaṃ akatapuññānaṃ ",
  "pv26:19.2": "katapuññānam ev' idaṃ ",
  "pv26:19.3": "asokaṃ Nandanaṃ rammaṃ ",
  "pv26:19.4": "Tidasānaṃ mahāvanaṃ. [=26].20 ",
  "pv26:20.1": "Sukhaṃ akatapuññānaṃ ",
  "pv26:20.2": "idha natthi parattha ca ",
  "pv26:20.3": "sukhañ ca katapuññānaṃ ",
  "pv26:20.4": "idha c' eva parattha ca. [=26].21 ",
  "pv26:21.1": "Tesaṃ sahavyakāmānaṃ ",
  "pv26:21.2": "kattabbaṃ kusalaṃ bahuṃ ",
  "pv26:21.3": "Katapuññā hi modanti ",
  "pv26:21.4": "sagge bhogasamaṅgino ti. ",
  "pv26:22.1": "Abhijjamānapetavatthu paṭhamaṃ [=27].1 "
}
