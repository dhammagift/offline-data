{
  "pv14:0.1": "",
  "pv14:0.2": "",
  "pv14:0.3": "",
  "pv14:1.1": "Naggā dubbaṇṇarūpāsi ",
  "pv14:1.2": "kisā dhamanisanthatā ",
  "pv14:1.3": "upphāsulike kisike ",
  "pv14:1.4": "kā nu tvaṃ idha tiṭṭhasī ti. [=14].2 ",
  "pv14:2.1": "Ahaṃ te sakiyā mātā ",
  "pv14:2.2": "pubbe aññāsu jātisu ",
  "pv14:2.3": "upapannā pettivisayaṃ ",
  "pv14:2.4": "khuppipāsasamappitā. [=14].3 ",
  "pv14:3.1": "Chaḍḍitaṃ khipitaṃ kheḷaṃ ",
  "pv14:3.2": "siṅghāṇikaṃ silesumaṃ ",
  "pv14:3.3": "vasañ ca ḍayhamānānaṃ ",
  "pv14:3.4": "vijātānañ ca lohitaṃ, [=14].4 ",
  "pv14:4.1": "Vaṇitānañ ca yaṃ ghānasīsacchinnāna ",
  "pv14:4.2": "lohitaṃ ",
  "pv14:4.3": "khudāparetā bhuñjāmi ",
  "pv14:4.4": "itthipurisanissitaṃ. [=14].5 ",
  "pv14:5.1": "Pubbalohitaṃ bhakkhāmi ",
  "pv14:5.2": "pasūnaṃ mānusāna ca ",
  "pv14:5.3": "alenā anagārā ca ",
  "pv14:5.4": "nīlamañcaparāyanā. [=14].6 ",
  "pv14:6.1": "Dehi puttaka me dānaṃ ",
  "pv14:6.2": "datvāna uddisāhi me ",
  "pv14:6.3": "app eva nāma muñceyyaṃ ",
  "pv14:6.4": "pubbalohitabhojanā. [=14].7 ",
  "pv14:7.1": "Mātuyā vacanaṃ sutvā ",
  "pv14:7.2": "Upatisso 'nukampako ",
  "pv14:7.3": "āmantayī Moggallānaṃ ",
  "pv14:7.4": "Anuruddhañ ca Kappinaṃ. [=14].8 ",
  "pv14:8.1": "Catasso kuṭiyo katvā ",
  "pv14:8.2": "saṅghe cātuddise adā ",
  "pv14:8.3": "kuṭiyo annapānañ ca ",
  "pv14:8.4": "mātu dakkhiṇam ādisi. [=14].9 ",
  "pv14:9.1": "Samanantarānuddiṭṭhe ",
  "pv14:9.2": "vipāko upapajjatha ",
  "pv14:9.3": "bhojanaṃ pānīyaṃ vatthaṃ ",
  "pv14:9.4": "dakkhiṇāya idaṃ phalaṃ. [=14].10 ",
  "pv14:10.1": "Tato suddhā sucivasanā ",
  "pv14:10.2": "kāsikuttamadhārinī ",
  "pv14:10.3": "vicittavatthābharaṇā ",
  "pv14:10.4": "Kolitaṃ upasaṅkamī ti. [=14].11 ",
  "pv14:11.1": "Abhikkantena vaṇṇena ",
  "pv14:11.2": "yā tvaṃ tiṭṭhasi devate ",
  "pv14:11.3": "obhāsentī disā sabbā ",
  "pv14:11.4": "osadhī viya tārakā, [=14].12 ",
  "pv14:12.1": "Kena t' etādiso vaṇṇo ",
  "pv14:12.2": "kena te idha-m-ijjhati ",
  "pv14:12.3": "uppajjanti ca te bhogā ",
  "pv14:12.4": "ye keci manaso piyā. [=14].13 ",
  "pv14:13.1": "Pucchāmi taṃ devi mahānubhāve ",
  "pv14:13.2": "manussabhūtā kim akāsi puññaṃ ",
  "pv14:13.3": "kenāsi evaṃ jalitānubhāvā ",
  "pv14:13.4": "vaṇṇo ca te sabbadisā pabhāsatī ti. [=14].14 ",
  "pv14:14.1": "Sāriputtass' ahaṃ mātā ",
  "pv14:14.2": "pubbe aññāsu jātisu ",
  "pv14:14.3": "upapannā pettivisayaṃ ",
  "pv14:14.4": "khuppipāsasamappitā. [=14].15 ",
  "pv14:15.1": "Chaḍḍitaṃ khipitaṃ kheḷaṃ ",
  "pv14:15.2": "siṅghānikaṃ silesumaṃ ",
  "pv14:15.3": "vasañ ca ḍayhamānānaṃ ",
  "pv14:15.4": "vijātānañ ca lohitaṃ, [=14].16 ",
  "pv14:16.1": "Vaṇitānañ ca yaṃ ghānasīsacchinnāna ",
  "pv14:16.2": "lohitaṃ ",
  "pv14:16.3": "khudāparetā bhuñjāmi ",
  "pv14:16.4": "itthipurisanissitaṃ. [=14].17 ",
  "pv14:17.1": "Pubbalohitaṃ bhakkhāmi ",
  "pv14:17.2": "pasūnaṃ mānusāna ca ",
  "pv14:17.3": "alenā anagārā ca ",
  "pv14:17.4": "nīlamañcaparāyanā. [=14].18 ",
  "pv14:18.1": "Sāriputtassa dānena ",
  "pv14:18.2": "modāmi akutobhayā ",
  "pv14:18.3": "muniṃ kāruṇikaṃ loke ",
  "pv14:18.4": "bhante vanditum āgatā ti. ",
  "pv14:19.1": "Sāriputtatherassa mātupetavatthu dutiyaṃ [=15].1 "
}
