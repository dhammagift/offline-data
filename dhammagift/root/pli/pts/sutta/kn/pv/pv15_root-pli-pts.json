{
  "pv15:0.1": "",
  "pv15:0.2": "",
  "pv15:0.3": "",
  "pv15:1.1": "Naggā dubbaṇṇarūpāsi ",
  "pv15:1.2": "kisā dhamanisanthatā ",
  "pv15:1.3": "upphāsulike kisike ",
  "pv15:1.4": "kā nu tvaṃ idha tiṭṭhasī ti. [=15].2 ",
  "pv15:2.1": "Ahaṃ Mattā tuvaṃ Tissā ",
  "pv15:2.2": "sapattī te pure ahuṃ ",
  "pv15:2.3": "pāpakammaṃ karitvāna ",
  "pv15:2.4": "petalokam ito gatā ti. [=15].3 ",
  "pv15:3.1": "Kin nu kāyena vācāya ",
  "pv15:3.2": "manasā dukkaṭaṃ kataṃ ",
  "pv15:3.3": "kissa kammavipākena ",
  "pv15:3.4": "petalokam ito gatā ti. [=15].4 ",
  "pv15:4.1": "Caṇḍī ca pharusā c' āsiṃ ",
  "pv15:4.2": "issukī maccharī saṭhī ",
  "pv15:4.3": "tāhaṃ durattuṃ vatvāna ",
  "pv15:4.4": "petalokam ito gatā ti. [=15].5 ",
  "pv15:5.1": "Sabbaṃ aham pi jānāmi ",
  "pv15:5.2": "yathā tvaṃ caṇḍikā ahu ",
  "pv15:5.3": "aññañ ca kho taṃ pucchāmi ",
  "pv15:5.4": "kenāsi paṃsukuṇṭhitā. [=15].6 Sīsaṃ ",
  "pv15:6.1": "nahātā tvaṃ āsi ",
  "pv15:6.2": "sucivatthā alaṅkatā ",
  "pv15:6.3": "ahañ ca kho taṃ adhimattaṃ ",
  "pv15:6.4": "samalaṅkatatarā tayā. [=15].7 ",
  "pv15:7.1": "Tassā me pekkhamānāya ",
  "pv15:7.2": "sāmikena samantayi ",
  "pv15:7.3": "tato me issā vipulā ",
  "pv15:7.4": "kodho me samajāyatha. [=15].8 ",
  "pv15:8.1": "Tato paṃsuṃ gahetvāna ",
  "pv15:8.2": "paṃsunā taṃ hi okiriṃ ",
  "pv15:8.3": "tassa kammavipākena ",
  "pv15:8.4": "ten' amhi paṃsukuṇṭhitā. [=15].9 ",
  "pv15:9.1": "Sabbaṃ aham pi jānāmi ",
  "pv15:9.2": "paṃsunā maṃ tvam okiri ",
  "pv15:9.3": "aññañ ca kho taṃ pucchāmi ",
  "pv15:9.4": "kena khajjasi kacchuyā. [=15].10 ",
  "pv15:10.1": "Bhesajjahārī ubhayo ",
  "pv15:10.2": "vanantaṃ agamimhase ",
  "pv15:10.3": "tvañ ca bhesajjam āhari aham ",
  "pv15:10.4": "pi kapikacchuno. [=15].11 ",
  "pv15:11.1": "Tassā tyājānamānaya ",
  "pv15:11.2": "seyyaṃ tyāhaṃ samokiriṃ ",
  "pv15:11.3": "tassa kammavipākena ",
  "pv15:11.4": "tena khajjāmi kacchuyā. [=15].12 ",
  "pv15:12.1": "Sabbaṃ aham pi jānāmi ",
  "pv15:12.2": "seyyaṃ me tvaṃ samokiri ",
  "pv15:12.3": "aññañ ca kho taṃ pucchāmi ",
  "pv15:12.4": "kenāsi naggiyā tuvaṃ. [=15].13 ",
  "pv15:13.1": "Sahāyānaṃ samayo āsi ",
  "pv15:13.2": "ñātīnaṃ samitī ahu ",
  "pv15:13.3": "tvañ ca āmantitā āsi ",
  "pv15:13.4": "sasāminī no ca kho ahaṃ. [=15].14 ",
  "pv15:14.1": "Tassā tyājānamānāya ",
  "pv15:14.2": "dussaṃ tyāhaṃ apānudiṃ ",
  "pv15:14.3": "tassa kammavipākena ",
  "pv15:14.4": "ten' amhi naggiyā ahaṃ. [=15].15 ",
  "pv15:15.1": "Sabbaṃ aham pi jānāmi ",
  "pv15:15.2": "dussaṃ me tvaṃ apānudi ",
  "pv15:15.3": "aññañ ca kho taṃ pucchāmi ",
  "pv15:15.4": "kenāsi gūthagandhinī. [=15].16 ",
  "pv15:16.1": "Tava gandhañ ca mālañ ca ",
  "pv15:16.2": "paccagghañ ca vilepanaṃ ",
  "pv15:16.3": "gūthakūpe atāresiṃ ",
  "pv15:16.4": "taṃ pāpaṃ pakataṃ mayā. ",
  "pv15:16.5": "tassa kammavipākena ",
  "pv15:16.6": "ten' amhi gūthagandhinī. [=15].17 ",
  "pv15:17.1": "Sabbaṃ aham pi jānāmi ",
  "pv15:17.2": "taṃ pāpaṃ pakataṃ tayā ",
  "pv15:17.3": "aññañ ca kho taṃ pucchāmi ",
  "pv15:17.4": "kenāsi duggatā tuvaṃ. [=15].18 ",
  "pv15:18.1": "Ubhinnaṃ samakaṃ āsi ",
  "pv15:18.2": "yaṃ gehe vijjate dhanaṃ ",
  "pv15:18.3": "santesu deyyadhammesu ",
  "pv15:18.4": "dīpaṃ nākasim attano, ",
  "pv15:18.5": "tassa kammavipākena ",
  "pv15:18.6": "ten' amhi duggatā ahaṃ. [=15].19 ",
  "pv15:19.1": "Tad eva maṃ tvaṃ avaca ",
  "pv15:19.2": "pāpakammaṃ nisevasi ",
  "pv15:19.3": "na hi pāpehi kammehi ",
  "pv15:19.4": "sulabhāhosi suggati. [=15].20 ",
  "pv15:20.1": "Vāmato maṃ tvaṃ paccesi ",
  "pv15:20.2": "atho pi maṃ usuyyasi ",
  "pv15:20.3": "passa pāpānaṃ kammānaṃ ",
  "pv15:20.4": "vipāko hoti yādiso. [=15].21 ",
  "pv15:21.1": "Te gharadāsiyo āsuṃ ",
  "pv15:21.2": "tān' evābharaṇān' ime ",
  "pv15:21.3": "te c' aññe paricārenti ",
  "pv15:21.4": "na bhogā honti sassatā. [=15].22 ",
  "pv15:22.1": "Idāni Bhūtassa pitā ",
  "pv15:22.2": "āpaṇā geham ehiti ",
  "pv15:22.3": "app eva te dade kiñci ",
  "pv15:22.4": "mā su tāva ito agā. [=15].23 ",
  "pv15:23.1": "Naggā dubbaṇṇarūpāmhi ",
  "pv15:23.2": "kisā dhamanisanthatā ",
  "pv15:23.3": "kopīnam etaṃ itthīnaṃ ",
  "pv15:23.4": "mā maṃ Bhūtapitāddasa. [=15].24 ",
  "pv15:24.1": "Handa Kiṃ tāhaṃ dammi ",
  "pv15:24.2": "kiṃ vā ca te karom' ahaṃ ",
  "pv15:24.3": "yena tvaṃ sukhitā assa ",
  "pv15:24.4": "sabbakāmasamiddhinī. [=15].25 ",
  "pv15:25.1": "Cattāro bhikkhū saṅghato ",
  "pv15:25.2": "cattāro puna puggalā ",
  "pv15:25.3": "aṭṭha bhikkhū bhojayitvā ",
  "pv15:25.4": "mama dakkhiṇam ādisa ",
  "pv15:25.5": "tadāhaṃ sukhitā hessaṃ ",
  "pv15:25.6": "sabbakāmasamiddhinī. [=15].26 ",
  "pv15:26.1": "Sādhū ti sā paṭissutvā ",
  "pv15:26.2": "bhojayitvāṭṭha bhikkhavo ",
  "pv15:26.3": "vattheh' acchādayitvāna ",
  "pv15:26.4": "tassā dakkhiṇam ādisi. [=15].27 ",
  "pv15:27.1": "Samanantarānuddiṭṭhe ",
  "pv15:27.2": "vipāko upapajjatha ",
  "pv15:27.3": "bhojanacchādanapāṇīyaṃ, ",
  "pv15:27.4": "dakkhiṇāya idaṃ phalaṃ. [=15].28 ",
  "pv15:28.1": "Tato suddhā sucivasanā ",
  "pv15:28.2": "kāsikuttamadhārinī ",
  "pv15:28.3": "vicittavatthābharaṇā ",
  "pv15:28.4": "sapattiṃ upasaṅkami. [=15].29 ",
  "pv15:29.1": "Abhikkantena vaṇṇena ",
  "pv15:29.2": "yā tvaṃ tiṭṭhasi devate ",
  "pv15:29.3": "obhāsentī disā sabbā ",
  "pv15:29.4": "osadhī viya tārakā, [=15].30 ",
  "pv15:30.1": "Kena t' etādiso vaṇṇo ",
  "pv15:30.2": "kena te idha-m-ijjhati ",
  "pv15:30.3": "uppajjanti ca te bhogā ",
  "pv15:30.4": "ye keci manaso piyā. [=15].31 ",
  "pv15:31.1": "Pucchāmi taṃ devi mahānubhāve ",
  "pv15:31.2": "manussabhūtā kim akāsi puññaṃ ",
  "pv15:31.3": "kenāsi evaṃ jalitānubhāvā ",
  "pv15:31.4": "vaṇṇo ca te sabbadisā pabhāsatī ti. [=15].32 ",
  "pv15:32.1": "Ahaṃ Mattā tuvaṃ Tissā ",
  "pv15:32.2": "sapattī te pure ahuṃ ",
  "pv15:32.3": "pāpakammaṃ karitvāna ",
  "pv15:32.4": "petalokam ito gatā. [=15].33 ",
  "pv15:33.1": "Tava dānena dinnena ",
  "pv15:33.2": "modāmi akutobhayā ",
  "pv15:33.3": "ciraṃ jīvāhi bhaginī ",
  "pv15:33.4": "saha sabbehi ñātibhi ",
  "pv15:33.5": "asokaṃ virajaṃ ṭhānaṃ ",
  "pv15:33.6": "āvāsaṃ vasavattinaṃ. [=15].34 ",
  "pv15:34.1": "Idha dhammaṃ caritvāna ",
  "pv15:34.2": "dānaṃ datvāna sobhane ",
  "pv15:34.3": "vineyya maccheramalaṃ sumūlaṃ ",
  "pv15:34.4": "aninditā saggam upehi ṭhānan ti. ",
  "pv15:35.1": "Mattāpetavatthu tatiyaṃ [=16].1 "
}
