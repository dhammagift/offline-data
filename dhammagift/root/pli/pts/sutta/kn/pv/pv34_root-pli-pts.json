{
  "pv34:0.1": "",
  "pv34:0.2": "",
  "pv34:0.3": "",
  "pv34:1.1": "Mālī kirīṭī kāyūrī ",
  "pv34:1.2": "gattā te candanussadā ",
  "pv34:1.3": "pasannamukhavaṇṇo 'si ",
  "pv34:1.4": "suriyavaṇṇo va sobhasi. [=34].2 ",
  "pv34:2.1": "Amānusā pārisajjā ",
  "pv34:2.2": "ye te 'me paricārakā ",
  "pv34:2.3": "dasa kaññāsahassāni ",
  "pv34:2.4": "yā te 'mā paricārikā, ",
  "pv34:2.5": "tā kambukāyūradharā ",
  "pv34:2.6": "kañcanāveḷabhūsitā. [=34].3 ",
  "pv34:3.1": "Mahānubhāvo 'si tuvaṃ ",
  "pv34:3.2": "lomahaṃsanarūpavā, ",
  "pv34:3.3": "piṭṭhimaṃsāni attano ",
  "pv34:3.4": "sāmaṃ ukkacca khādasi. [=34].4 ",
  "pv34:4.1": "Kin nu kāyena vācāya ",
  "pv34:4.2": "manasā dukkaṭaṃ kataṃ ",
  "pv34:4.3": "kissa kammavipākena ",
  "pv34:4.4": "piṭṭhimaṃsāni attano ",
  "pv34:4.5": "sāmaṃ ukkacca khādasi. [=34].5 ",
  "pv34:5.1": "Attano 'haṃ anatthāya ",
  "pv34:5.2": "jīvaloke acārisaṃ ",
  "pv34:5.3": "pesuññamusāvādena ",
  "pv34:5.4": "nikativañcanāya ca. [=34].6 ",
  "pv34:6.1": "Tatthāhaṃ parisaṃ gantvā ",
  "pv34:6.2": "saccakāle upaṭṭhite ",
  "pv34:6.3": "atthaṃ dhammaṃ niraṃkatvā ",
  "pv34:6.4": "adhammaṃ anuvattisaṃ. [=34].7 ",
  "pv34:7.1": "Evaṃ so khādat' attānaṃ ",
  "pv34:7.2": "yo hoti piṭṭhimaṃsiko ",
  "pv34:7.3": "yathāhaṃ ajja khādāmi ",
  "pv34:7.4": "piṭṭhimaṃsāni attano. [=34].8 ",
  "pv34:8.1": "Ta-y-idaṃ tayā Nārada sāmaṃ diṭṭhaṃ ",
  "pv34:8.2": "anukampakā ye kusalā vadeyyuṃ ",
  "pv34:8.3": "mā pesuṇaṃ mā ca musā abhāṇi ",
  "pv34:8.4": "mā kho 'si piṭṭhimaṃsiko tuvan ti. ",
  "pv34:9.1": "Kūṭavinicchayika-petavatthu navamaṃ [=35].1 "
}
