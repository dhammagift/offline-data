  "pv2:0.3": "",
  "pv2:1.1": "Kāyo te sabbasovaṇṇo ",
  "pv2:1.2": "sabbā obhāsate disā ",
  "pv2:1.3": "mukhaṃ te sūkarass' eva ",
  "pv2:1.4": "kiṃ kammam akarī pure ti. [=2].2 ",
  "pv2:2.1": "Kāyena saññato āsiṃ ",
  "pv2:2.2": "vācāyāsim asaññato ",
  "pv2:2.3": "tena me tādiso vaṇṇo ",
  "pv2:2.4": "yathā passasi Nārada. [=2].3 ",
  "pv2:3.1": "Taṃ tyāhaṃ Nārada brūmi ",
  "pv2:3.2": "sāmaṃ diṭṭham idaṃ tayā ",
  "pv2:3.3": "mākāsi mukhasā pāpaṃ ",
  "pv2:3.4": "mā kho sūkaramukho ahū ti. ",
  "pv2:4.1": "Sūkaramukhapetavatthu dutiyaṃ [=3].1 "
}
