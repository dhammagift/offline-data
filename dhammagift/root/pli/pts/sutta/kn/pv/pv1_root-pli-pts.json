{
  "pv1:0.1": "",
  "pv1:0.2": "",
  "pv1:0.3": "",
  "pv1:1.1": "Namo tassa bhagavato arahato sammāsambuddhassa. [=1].1 ",
  "pv1:2.1": "Khettūpamā arahanto ",
  "pv1:2.2": "dāyakā kassakūpamā ",
  "pv1:2.3": "bījūpamaṃ deyyadhammaṃ ",
  "pv1:2.4": "etto nibbattate phalaṃ. [=1].2 ",
  "pv1:3.1": "Etaṃ bījaṃ kasī khettaṃ ",
  "pv1:3.2": "petānaṃ dāyakassa ca, ",
  "pv1:3.3": "taṃ petā paribhuñjanti ",
  "pv1:3.4": "dātā puññena vaḍḍhati. [=1].3 ",
  "pv1:4.1": "Idh' eva kusalaṃ katvā ",
  "pv1:4.2": "pete ca paṭipūjiya ",
  "pv1:4.3": "saggañ ca kamati ṭṭhānaṃ ",
  "pv1:4.4": "kammaṃ katvāna bhaddakan ti. ",
  "pv1:5.1": "khettūpamapetavatthu paṭhamaṃ [=2].1 "
}
