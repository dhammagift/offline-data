{
  "pv18:0.1": "",
  "pv18:0.2": "",
  "pv18:0.3": "",
  "pv18:1.1": "Uṭṭhehi Kaṇha kiṃ sesi ",
  "pv18:1.2": "ko attho supanena te ",
  "pv18:1.3": "yo ca tuyhaṃ sako bhātā ",
  "pv18:1.4": "hadayaṃ cakkhuṃ va dakkhiṇaṃ, ",
  "pv18:1.5": "tassa vātā balīyanti ",
  "pv18:1.6": "Ghato jappati Kesavā ti. [=18].2 ",
  "pv18:2.1": "Tassa taṃ vacanaṃ sutvā ",
  "pv18:2.2": "Rohiṇeyyassa Kesavo ",
  "pv18:2.3": "taramānarūpo vuṭṭhāsi ",
  "pv18:2.4": "bhātusokena aṭṭito. [=18].3 ",
  "pv18:3.1": "Kin nu ummattarūpo va ",
  "pv18:3.2": "kevalaṃ Dvārakaṃ imaṃ ",
  "pv18:3.3": "saso saso ti lapasi ",
  "pv18:3.4": "kīdisaṃ sasam icchasi. [=18].4 ",
  "pv18:4.1": "Sovaṇṇamayaṃ maṇimayaṃ ",
  "pv18:4.2": "lohamayaṃ atha rūpiyāmayaṃ ",
  "pv18:4.3": "saṅkhasilāpavāḷamayaṃ ",
  "pv18:4.4": "kārayissāmi te sasaṃ. [=18].5 ",
  "pv18:5.1": "Santi aññe pi sasakā ",
  "pv18:5.2": "araññe vanagocarā ",
  "pv18:5.3": "te pi te ānayissāmi ",
  "pv18:5.4": "kīdisaṃ sasam icchasī ti. [=18].6 ",
  "pv18:6.1": "Nāham ete sase icche ",
  "pv18:6.2": "ye sasā paṭhavissitā ",
  "pv18:6.3": "candato sasam icchāmi ",
  "pv18:6.4": "taṃ me ohara Kesavā ti. [=18].7 ",
  "pv18:7.1": "So nūna madhuraṃ ñāti ",
  "pv18:7.2": "jīvitaṃ vijahissasi ",
  "pv18:7.3": "apatthiyaṃ patthayasi ",
  "pv18:7.4": "candato sasam icchasī ti. [=18].8 ",
  "pv18:8.1": "Evañ ce Kaṇha jānāsi ",
  "pv18:8.2": "yath' aññam anusāsasi ",
  "pv18:8.3": "kasmā pure mataṃ puttaṃ ",
  "pv18:8.4": "ajjāpi-m-anusocasī ti. [=18].9 Ye ",
  "pv18:9.1": "na labbhā manussena ",
  "pv18:9.2": "amanussena vā pana: ",
  "pv18:9.3": "jāto me mā marī putto ",
  "pv18:9.4": "kuto labbhā alabbhiyaṃ. [=18].10 ",
  "pv18:10.1": "Na mantā mūlabhesajjā ",
  "pv18:10.2": "osadhehi dhanena vā ",
  "pv18:10.3": "sakkā ānayituṃ Kaṇha ",
  "pv18:10.4": "yaṃ petam anusocasi. [=18].11 ",
  "pv18:11.1": "Mahaddhanā mahābhogā ",
  "pv18:11.2": "raṭṭhavanto pi khattiyā ",
  "pv18:11.3": "pahūtadhanadhaññāse ",
  "pv18:11.4": "te pi no ajarāmarā. [=18].12 ",
  "pv18:12.1": "Khattiyā brāhmaṇā vessā ",
  "pv18:12.2": "suddā caṇḍālapukkusā ",
  "pv18:12.3": "ete c' aññe ca jātiyā ",
  "pv18:12.4": "te pi no ajarāmarā. [=18].13 ",
  "pv18:13.1": "Ye mantaṃ parivattenti ",
  "pv18:13.2": "chaḷaṅgaṃ brahmacintitaṃ ",
  "pv18:13.3": "ete c' aññe ca vijjāya ",
  "pv18:13.4": "te pi no ajarāmarā. [=18].14 ",
  "pv18:14.1": "Isayo vā pi ye santā ",
  "pv18:14.2": "saññatattā tapassino ",
  "pv18:14.3": "sarīram te pi kālena ",
  "pv18:14.4": "vijahanti tapassino. [=18].15 ",
  "pv18:15.1": "Bhāvitattā arahanto ",
  "pv18:15.2": "katakiccā anāsavā ",
  "pv18:15.3": "nikkhipanti imaṃ dehaṃ ",
  "pv18:15.4": "puññapāpaparikkhayā ti. [=18].16 ",
  "pv18:16.1": "Ādittaṃ vata maṃ santaṃ ",
  "pv18:16.2": "ghatasittaṃ va pāvakaṃ ",
  "pv18:16.3": "vārinā viya osiñcaṃ ",
  "pv18:16.4": "sabbaṃ nibbāpaye daraṃ. [=18].17 ",
  "pv18:17.1": "Abbūḷhaṃ vata me sallaṃ ",
  "pv18:17.2": "sokaṃ badayanissitaṃ ",
  "pv18:17.3": "yo me sokaparetassa ",
  "pv18:17.4": "puttasokaṃ apānudi. [=18].18 ",
  "pv18:18.1": "So 'haṃ abhuḷhasallo 'smi ",
  "pv18:18.2": "sītibhūto 'smi nibbuto ",
  "pv18:18.3": "na socāmi na rodāmi ",
  "pv18:18.4": "tava sutvāna bhāsitaṃ. [=18].19 ",
  "pv18:19.1": "Evaṃ karonti sappaññā ",
  "pv18:19.2": "ye honti anukampakā ",
  "pv18:19.3": "vinivattayanti sokamhā ",
  "pv18:19.4": "Ghato jeṭṭhaṃ va bhātaraṃ. [=18].20 ",
  "pv18:20.1": "Yassa etādisā honti ",
  "pv18:20.2": "amaccā paricārakā ",
  "pv18:20.3": "subhāsitena anvesi ",
  "pv18:20.4": "Ghato jeṭṭhaṃ va bhātaran ti. ",
  "pv18:21.1": "Kaṇhapetavatthu chaṭṭhaṃ [=19].1 "
}
