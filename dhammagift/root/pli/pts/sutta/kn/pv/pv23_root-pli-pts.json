  "pv23:0.1": "",
  "pv23:0.2": "",
  "pv23:0.3": "",
  "pv23:1.1": "Ahaṃ pure pabbajitassa bhikkhuno ",
  "pv23:1.2": "suttaṃ adāsiṃ upagamma yācitā ",
  "pv23:1.3": "tassa vipāko vipula-phalūpalabbhati ",
  "pv23:1.4": "bahū ca me uppajjare vatthakotiyo. [=23].2 ",
  "pv23:2.1": "Pupphābhikiṇṇaṃ ramitaṃ vimānaṃ ",
  "pv23:2.2": "anekacittaṃ naranārisevitaṃ ",
  "pv23:2.3": "sāhaṃ bhuñjāmi ca pārupāmi ca ",
  "pv23:2.4": "pahūtavittā na ca tāva khīyati. [=23].3 ",
  "pv23:3.1": "Tass' eva kammassa vipākam anvayā ",
  "pv23:3.2": "sukhañ ca sātañ ca idhūpalabbhati ",
  "pv23:3.3": "sāhaṃ gantvā punad eva mānusaṃ ",
  "pv23:3.4": "kāhāmi puññāni nay' ayyaputta man ti. [=23].4 ",
  "pv23:4.1": "Satta tuvaṃ vassasatā idhāgatā ",
  "pv23:4.2": "jiṇṇā ca vuddhā ca tahiṃ bhavissasi ",
  "pv23:4.3": "sabbe va te kālakatā ca ñātakā ",
  "pv23:4.4": "Kiṃ tattha gantvāna ito karissasī ti. [=23].5 ",
  "pv23:5.1": "Satt' eva vassāni idhāgatāya me ",
  "pv23:5.2": "dibbañ ca sukhañ ca samappitāya ",
  "pv23:5.3": "sāhaṃ gantvā punar eva mānusaṃ ",
  "pv23:5.4": "kāhāmi puññāni nay' ayyaputta man ti. [=23].6 ",
  "pv23:6.1": "So taṃ gahetvāna pasayha bāhāyaṃ ",
  "pv23:6.2": "paccānayitvāna theriṃ sudubbalaṃ ",
  "pv23:6.3": "vajjesi aññam pi janaṃ idhāgataṃ: ",
  "pv23:6.4": "karotha puññāni sukhūpalabbhatī ti. [=23].7 ",
  "pv23:7.1": "Diṭṭhā mayā akatena sādhunā ",
  "pv23:7.2": "petā vihaññanti tath' eva mānusā ",
  "pv23:7.3": "kammañ ca katvā sukhavedanīyaṃ ",
  "pv23:7.4": "devā manussā ca sukhe ṭhitā pajā ti. ",
  "pv23:8.1": "Suttapetavatthu ekādasamaṃ [=24].1 "
}
