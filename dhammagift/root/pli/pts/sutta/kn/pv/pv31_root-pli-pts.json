{
  "pv31:0.1": "",
  "pv31:0.2": "",
  "pv31:0.3": "",
  "pv31:1.1": "Naggā dubbaṇṇarūpāsi ",
  "pv31:1.2": "kisā dhamanisanthatā ",
  "pv31:1.3": "upphāsulike kisike ",
  "pv31:1.4": "kā nu tvaṃ idha tiṭṭhasī ti. [=31].2 ",
  "pv31:2.1": "Ahaṃ bhadante petī 'mhi ",
  "pv31:2.2": "duggatā Yamalokikā ",
  "pv31:2.3": "pāpakammaṃ karitvāna ",
  "pv31:2.4": "petalokam ito gatā. [=31].3 ",
  "pv31:3.1": "Kin nu kāyena vācāya ",
  "pv31:3.2": "manasā dukkaṭaṃ kataṃ ",
  "pv31:3.3": "kissa kammavipākena ",
  "pv31:3.4": "petalokam ito gatā ti. [=31].4 ",
  "pv31:4.1": "Anāvaṭesu titthesu ",
  "pv31:4.2": "viciniṃ addhamāsakaṃ ",
  "pv31:4.3": "santesu deyyadhammesu ",
  "pv31:4.4": "dīpaṃ nākāsim attano. [=31].5 ",
  "pv31:5.1": "Nadiṃ upemi tasitā ",
  "pv31:5.2": "rittakā parivattati ",
  "pv31:5.3": "chāyaṃ upemi uṇhesu ",
  "pv31:5.4": "ātapo parivattati. [=31].6 ",
  "pv31:6.1": "Aggivaṇṇo ca me vāto ",
  "pv31:6.2": "dahanto upavāyati ",
  "pv31:6.3": "etañ ca bhante arahāmi ",
  "pv31:6.4": "aññañ ca pāpakaṃ tato. [=31].7 ",
  "pv31:7.1": "Gantvāna Hatthinipuraṃ ",
  "pv31:7.2": "vajjesi mayha mātaraṃ ",
  "pv31:7.3": "dhītā ca te mayā diṭṭhā ",
  "pv31:7.4": "duggatā Yamalokikā, ",
  "pv31:7.5": "pāpakammaṃ karitvāna ",
  "pv31:7.6": "petalokaṃ ito gatā. [=31].8 ",
  "pv31:8.1": "Atthi ca me ettha nikkhittaṃ ",
  "pv31:8.2": "anakkhātañ ca taṃ mayā ",
  "pv31:8.3": "cattāri satasahassāni ",
  "pv31:8.4": "pallaṅkassa ca heṭṭhato. [=31].9 ",
  "pv31:9.1": "Tato me dānaṃ dadatu ",
  "pv31:9.2": "tassā ca hotu jīvikā ",
  "pv31:9.3": "dānaṃ datvā ca me mātā ",
  "pv31:9.4": "dakkhiṇaṃ anvādissatu, ",
  "pv31:9.5": "tadāhaṃ sukhitā hessaṃ ",
  "pv31:9.6": "sabbakāmasamiddhinī ti. [=31].10 ",
  "pv31:10.1": "Sādhū ti so paṭissutvā ",
  "pv31:10.2": "gantvāna Hatthiniṃ puraṃ -- ",
  "pv31:10.3": "avoca tassā mātaraṃ: ",
  "pv31:11.1": "dhītā ca te mayā diṭṭhā ",
  "pv31:11.2": "duggatā Yamalokikā ",
  "pv31:11.3": "pāpakammaṃ paritvāna ",
  "pv31:11.4": "petalokaṃ ito gatā. [=31].11 ",
  "pv31:12.1": "Sā maṃ tattha samādapesi gantvāna Hatthiniṃ puraṃ -- ",
  "pv31:12.2": "vajjesi mayha mātaraṃ: ",
  "pv31:12.3": "dhītā ca te mayā diṭṭhā ",
  "pv31:12.4": "duggatā Yamalokikā ",
  "pv31:12.5": "pāpakammaṃ karitvāna ",
  "pv31:12.6": "petalokaṃ ito gatā. [=31].12 ",
  "pv31:13.1": "Atthi ca me ettha nikkhittaṃ ",
  "pv31:13.2": "anakkhātañ ca taṃ mayā ",
  "pv31:13.3": "cattārī satasahassāni ",
  "pv31:13.4": "pallaṅkassa ca heṭṭhato. [=31].13 ",
  "pv31:14.1": "Tato me dānaṃ dadatu ",
  "pv31:14.2": "tassā ca hotu jīvikā ",
  "pv31:14.3": "dānaṃ datvā ca me mātā ",
  "pv31:14.4": "dakkhiṇaṃ anvādissatu, ",
  "pv31:14.5": "tadāhaṃ sukhitā hessaṃ ",
  "pv31:14.6": "sabbakāmasamiddhinī ti. [=31].14 ",
  "pv31:15.1": "Tato hi sā dānam adā ",
  "pv31:15.2": "tassā ca dakkhiṇam ādisi ",
  "pv31:15.3": "petī ca sukhitā āsi ",
  "pv31:15.4": "sarīraṃ cārudassanan ti. ",
  "pv31:16.1": "Seriṇīpetavatthu chaṭṭhaṃ [=32].1 "
}
