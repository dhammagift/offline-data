  "pv4:0.3": "",
  "pv4:1.1": "Yaṃ kiñc' ārammaṇaṃ katvā ",
  "pv4:1.2": "dajjā dānaṃ amaccharī ",
  "pv4:1.3": "pubbapete ca ārabbha ",
  "pv4:1.4": "atha vā vatthudevatā; [=4].2 ",
  "pv4:2.1": "Cattāro ca mahārāje ",
  "pv4:2.2": "lokapāle yasassino ",
  "pv4:2.3": "Kuveraṃ Dhataraṭṭhañ ca ",
  "pv4:2.4": "Virūpakkhaṃ Virūḷhakaṃ- ",
  "pv4:2.5": "te c' eva pūjitā honti ",
  "pv4:2.6": "dāyakā ca anipphalā. [=4].3 ",
  "pv4:3.1": "Na hi ruṇṇaṃ va soko vā ",
  "pv4:3.2": "yā c' aññā paridevanā ",
  "pv4:3.3": "na taṃ petassa atthāya ",
  "pv4:3.4": "evaṃ tiṭṭhanti ñātayo. [=4].4 ",
  "pv4:4.1": "Ayañ ca kho dakkhiṇā dinnā ",
  "pv4:4.2": "saṅghamhi suppatiṭṭhitā ",
  "pv4:4.3": "dīgharattaṃ hitāy' assa ",
  "pv4:4.4": "ṭhānaso upakappatī ti. Piṭṭhadhītalikapetavatthu catutthaṃ [=5].1 Tirokuḍḍesu ",
  "pv4:5.1": ""
}
