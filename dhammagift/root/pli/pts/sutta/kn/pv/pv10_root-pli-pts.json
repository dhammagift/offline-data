  "pv10:0.1": "",
  "pv10:0.2": "",
  "pv10:0.3": "",
  "pv10:1.1": "Kā nu antovimānasmiṃ ",
  "pv10:1.2": "tiṭṭhantī n' upanikkhami ",
  "pv10:1.3": "upanikkhamassu bhadde tvaṃ ",
  "pv10:1.4": "passāma taṃ mahiddhikan ti. [=10].2 ",
  "pv10:2.1": "Aṭṭiyāmi harāyāmi ",
  "pv10:2.2": "naggā nikkhamituṃ bahi ",
  "pv10:2.3": "keseh' amhi paṭicchannā ",
  "pv10:2.4": "puññaṃ me appakaṃ katan ti. [=10].3 ",
  "pv10:3.1": "Hand' uttarīyaṃ dadāmi te ",
  "pv10:3.2": "imaṃ dussaṃ nivāsaya ",
  "pv10:3.3": "imaṃ dussaṃ nivasetvā ",
  "pv10:3.4": "bahi nikkhama sobhane, ",
  "pv10:3.5": "upanikkhamassu bhadde tvaṃ ",
  "pv10:3.6": "passāma tam bahiṭṭhitan ti. [=10].4 ",
  "pv10:4.1": "Hatthena hatthe te dinnaṃ ",
  "pv10:4.2": "na mayhaṃ upakappati ",
  "pv10:4.3": "es' etth' upāsako saddho ",
  "pv10:4.4": "sammāsambuddhasāvako, [=10].5 ",
  "pv10:5.1": "Etaṃ acchādayitvāna ",
  "pv10:5.2": "mama dakkhiṇam ādisa ",
  "pv10:5.3": "tathāhaṃ sukhitā hessaṃ ",
  "pv10:5.4": "sabbakāmasamiddhinī ti. [=10].6 ",
  "pv10:6.1": "Tañ ca te nhāpayitvāna ",
  "pv10:6.2": "vilimpetvāna vāṇijā ",
  "pv10:6.3": "vattheh' acchādayitvāna ",
  "pv10:6.4": "tassā dakkhiṇam ādisuṃ. [=10].7 ",
  "pv10:7.1": "Samanantarānuddiṭṭhe ",
  "pv10:7.2": "vipāko upapajjatha ",
  "pv10:7.3": "bhojanacchādanapānīyaṃ, ",
  "pv10:7.4": "dakkhiṇāya idaṃ phalaṃ. [=10].8 ",
  "pv10:8.1": "Tato suddhā sucivasanā ",
  "pv10:8.2": "kāsikuttamadhārinī ",
  "pv10:8.3": "hasantī vimānā nikkhami ",
  "pv10:8.4": "dakkhiṇāya idaṃ phalan ti. [=10].9 ",
  "pv10:9.1": "Sucittarūpaṃ ruciraṃ ",
  "pv10:9.2": "vimānaṃ te pabhāsati ",
  "pv10:9.3": "devate pucchitācikkha ",
  "pv10:9.4": "kissa kammass' idaṃ phalan ti. [=10].10 ",
  "pv10:10.1": "Bhikkhuno caramānassa ",
  "pv10:10.2": "doṇinimmajjanaṃ ahaṃ ",
  "pv10:10.3": "adāsiṃ ujubhūtassa ",
  "pv10:10.4": "vippasannena cetasā. [=10].11 ",
  "pv10:11.1": "Tassa kammassa kusalassa ",
  "pv10:11.2": "vipākaṃ dīgham antaraṃ ",
  "pv10:11.3": "anubhomi vimānasmiṃ ",
  "pv10:11.4": "tañ ca dāni parittakaṃ. [=10].12 ",
  "pv10:12.1": "Uddhaṃ catūhi māsehi ",
  "pv10:12.2": "kālakiriyā bhavissati ",
  "pv10:12.3": "ekantaṃ kaṭukaṃ ghoraṃ ",
  "pv10:12.4": "nirayaṃ papatiss' ahaṃ. [=10].13 ",
  "pv10:13.1": "Catukkaṇṇaṃ catudvāraṃ ",
  "pv10:13.2": "vibhattaṃ bhāgaso mitaṃ ",
  "pv10:13.3": "ayopākārapariyantaṃ ",
  "pv10:13.4": "ayasā paṭikujjitaṃ. [=10].14 ",
  "pv10:14.1": "Tassa ayomayā bhūmi ",
  "pv10:14.2": "jalitā tejasā yutā ",
  "pv10:14.3": "samantā yojanasataṃ ",
  "pv10:14.4": "pharitvā tiṭṭhati sabbadā. [=10].15 ",
  "pv10:15.1": "Tatthāhaṃ dīgham addhānam ",
  "pv10:15.2": "dukkham vedissa vedanaṃ ",
  "pv10:15.3": "phalañ ca pāpakammassa ",
  "pv10:15.4": "tasmā socām' ahaṃ bhusan ti. ",
  "pv10:16.1": "Khallāṭiyapetavatthu dasamaṃ [=11].1 Purato va "
}
