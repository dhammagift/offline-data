{
  "pv42:0.1": "",
  "pv42:0.2": "",
  "pv42:0.3": "",
  "pv42:1.1": "Pubbe katānaṃ kammānaṃ ",
  "pv42:1.2": "vipāko mathaye manaṃ; ",
  "pv42:1.3": "rūpe sadde rase gandhe ",
  "pv42:1.4": "phoṭṭhabbe ca manorame, [=42].2 ",
  "pv42:2.1": "Naccaṃ gītaṃ ratiṃ khiḍḍaṃ ",
  "pv42:2.2": "anubhutvā anappakaṃ ",
  "pv42:2.3": "uyyāne paricaritvā ",
  "pv42:2.4": "pavisanto Giribbajaṃ, [=42].3 ",
  "pv42:3.1": "Isiṃ Sunettam addakkhi ",
  "pv42:3.2": "attadantaṃ samāhitaṃ ",
  "pv42:3.3": "appicchaṃ hirisampannaṃ ",
  "pv42:3.4": "uñche pattagate rataṃ. [=42].4 ",
  "pv42:4.1": "Hatthikkhandhato oruyha ",
  "pv42:4.2": "laddhā bhante ti c' abravi; ",
  "pv42:4.3": "tassa pattaṃ gahetvāna ",
  "pv42:4.4": "uccaṃ paggayha khattiyo, [=42].5 ",
  "pv42:5.1": "Thaṇḍile pattaṃ bhinditvā ",
  "pv42:5.2": "hasamāno apakkami, ",
  "pv42:5.3": "rañño Kitavass' ahaṃ putto ",
  "pv42:5.4": "kiṃ maṃ bhikkhu karissasi. [=42].6 ",
  "pv42:6.1": "Tassa kammassa pharusassa ",
  "pv42:6.2": "vipāko kaṭuko ahu ",
  "pv42:6.3": "yaṃ rājaputto vedesi ",
  "pv42:6.4": "nirayamhi samappito. [=42].7 ",
  "pv42:7.1": "Chaḷ' eva caturāsīti ",
  "pv42:7.2": "vassāni nahutāni ca ",
  "pv42:7.3": "bhusaṃ dukkhaṃ nigacchittho ",
  "pv42:7.4": "niraye katakibbiso. [=42].8 ",
  "pv42:8.1": "Uttāno pi ca paccittha ",
  "pv42:8.2": "nikujjo vāmadakkhiṇo ",
  "pv42:8.3": "uddhaṃpādo ṭhito c' eva ",
  "pv42:8.4": "ciraṃ bālo apaccatha. [=42].9 ",
  "pv42:9.1": "Bahūni vassasahassāni ",
  "pv42:9.2": "pūgāni nahutāni ca ",
  "pv42:9.3": "bhusaṃ dukkhaṃ nigacchittho ",
  "pv42:9.4": "niraye katakibbiso. [=42].10 ",
  "pv42:10.1": "Etādisaṃ kho kaṭukaṃ ",
  "pv42:10.2": "appaduṭṭhapadosinaṃ ",
  "pv42:10.3": "paccanti pāpakammantā ",
  "pv42:10.4": "isim āsajja subbataṃ. [=42].11 ",
  "pv42:11.1": "So tattha bahudukkhāni ",
  "pv42:11.2": "vedayitvā bahuṃ dukhaṃ ",
  "pv42:11.3": "khuppipāsāhato nāma ",
  "pv42:11.4": "peto āsi tato cuto. [=42].12 ",
  "pv42:12.1": "Etaṃ ādīnavaṃ disvā ",
  "pv42:12.2": "issaramadasambhavaṃ ",
  "pv42:12.3": "pahāya issaramadaṃ ",
  "pv42:12.4": "nivātam anuvattaye. [=42].13 ",
  "pv42:13.1": "Diṭṭhe va dhamme pāsaṃso ",
  "pv42:13.2": "yo buddhesu sagāravo ",
  "pv42:13.3": "kāyassa bhedā sappañño ",
  "pv42:13.4": "saggaṃ so upapajjatī ti. ",
  "pv42:14.1": "Rājaputtapetavatthu sattamaṃ [=43].1 "
}
