  "pv6:1.1": "Naggā dubbaṇṇarūpāsi ",
  "pv6:1.2": "duggandhā pūti vāyasi ",
  "pv6:1.3": "makkhikāparikiṇṇā va ",
  "pv6:1.4": "kā nu tvaṃ idha tiṭṭhasī ti. [=6].2 ",
  "pv6:2.1": "Ahaṃ bhadante petī 'mhi ",
  "pv6:2.2": "duggatā Yamalokikā ",
  "pv6:2.3": "pāpakammaṃ karitvāna ",
  "pv6:2.4": "petalokaṃ ito gatā. [=6].3 ",
  "pv6:3.1": "Kālena pañca puttāni ",
  "pv6:3.2": "sāyaṃ pañca punāpare ",
  "pv6:3.3": "vijāyitvāna khādāmi ",
  "pv6:3.4": "te pi nā honti me alaṃ. [=6].4 ",
  "pv6:4.1": "Pariḍayhati dhūmāyati ",
  "pv6:4.2": "khudāya hadayaṃ mama ",
  "pv6:4.3": "pānīyaṃ na labhe pātum ",
  "pv6:4.4": "passa mam vyasanam gatan ti. [=6].5 ",
  "pv6:5.1": "Kin nu kāyena vācāya ",
  "pv6:5.2": "manasā dukkaṭaṃ kataṃ ",
  "pv6:5.3": "kissa kammavipākena ",
  "pv6:5.4": "puttamaṃsāni khādasī ti. [=6].6 ",
  "pv6:6.1": "Sapattī me gabbhinī āsi ",
  "pv6:6.2": "tassā pāpaṃ acetayiṃ ",
  "pv6:6.3": "sāhaṃ paduṭṭhamanasā ",
  "pv6:6.4": "akariṃ gabbhapātanaṃ. [=6].7 ",
  "pv6:7.1": "Tassā dvemāsiko gabbho ",
  "pv6:7.2": "lohitañ ñeva paggharī ",
  "pv6:7.3": "tad' assā mātā kupitā ",
  "pv6:7.4": "mayhaṃ ñātī samānayi, ",
  "pv6:7.5": "sapathañ ca maṃ kāresi ",
  "pv6:7.6": "paribhāsāpayī ca maṃ. [=6].8 ",
  "pv6:8.1": "Sāhaṃ ghorañ ca sapathaṃ ",
  "pv6:8.2": "musāvādaṃ abhāsisaṃ: ",
  "pv6:8.3": "puttamaṃsāni khādāmi ",
  "pv6:8.4": "sace taṃ pakataṃ mayā. [=6].9 ",
  "pv6:9.1": "Tassa kammavipākena ",
  "pv6:9.2": "musāvādassa cūbhayaṃ ",
  "pv6:9.3": "puttamaṃsāni khādāmi ",
  "pv6:9.4": "pubbalohitamakkhitā ti. Pañcaputtakhādakapetavatthu chattaṃ [=7].1 ",
  "pv6:10.1": ""
}
