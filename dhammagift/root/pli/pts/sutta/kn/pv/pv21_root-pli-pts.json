  "pv21:0.2": "",
  "pv21:0.3": "",
  "pv21:1.1": "Yassa atthāya gacchāma ",
  "pv21:1.2": "Kambojaṃ dhanahārakā ",
  "pv21:1.3": "ayaṃ kāmadado yakkho ",
  "pv21:1.4": "imaṃ yakkhaṃ nīyāmase. [=21].2 ",
  "pv21:2.1": "Imaṃ yakkhaṃ gahetvāna ",
  "pv21:2.2": "sādhukena pasayha vā ",
  "pv21:2.3": "yānaṃ āropayitvāna ",
  "pv21:2.4": "khippaṃ gacchāma Dvāraka ti. [=21].3 ",
  "pv21:3.1": "Yassa rukkhassa chāyaya ",
  "pv21:3.2": "nisīdeyya sayeyya vā ",
  "pv21:3.3": "na tassa sākhaṃ bhindeyya ",
  "pv21:3.4": "mittadubbho hi pāpako ti. [=21].4 ",
  "pv21:4.1": "Yassa rukkhassa chāyāya ",
  "pv21:4.2": "nisīdeyya sayeyya vā ",
  "pv21:4.3": "khandham pi tassa chindeyya ",
  "pv21:4.4": "attho ce tādiso siyā ti. [=21].5 ",
  "pv21:5.1": "Yassa rukkhassa chāyāya ",
  "pv21:5.2": "nisīdeyya sayeyya vā ",
  "pv21:5.3": "na tassa pattaṃ bhindeyya ",
  "pv21:5.4": "mittadubbho hi pāpako ti. [=21].6 ",
  "pv21:6.1": "Yassa rukkhassa chāyāya ",
  "pv21:6.2": "nisīdeyya sayeyya vā ",
  "pv21:6.3": "samūlam pi taṃ abhuyha ",
  "pv21:6.4": "attho ce tādiso siyā ti. [=21].7 ",
  "pv21:7.1": "Yass' ekarattim pi ghare vaseyya ",
  "pv21:7.2": "Yatth' annapānaṃ puriso labhetha ",
  "pv21:7.3": "na tassa pāpaṃ manasā pi cetaye ",
  "pv21:7.4": "kataññutā sappurisehi vaṇṇitā. [=21].8 ",
  "pv21:8.1": "Yass' ekarattim pi ghare vaseyya ",
  "pv21:8.2": "annena pānena upaṭṭhito siyā ",
  "pv21:8.3": "na tassa pāpaṃ manasā pi cetaye ",
  "pv21:8.4": "adubbhapāṇī dahate mittadubbhiṃ. [=21].9 ",
  "pv21:9.1": "Yo pubbe katakalyāṇo ",
  "pv21:9.2": "pacchā pāpena hiṃsati ",
  "pv21:9.3": "allapāṇihato poso ",
  "pv21:9.4": "na so bhadrāni passatī ti. [=21].10 ",
  "pv21:10.1": "Nāhaṃ devena vā manussena vā ",
  "pv21:10.2": "issariyena vāhaṃ suppasayho ",
  "pv21:10.3": "yakkho 'ham asmi paramiddhipatto ",
  "pv21:10.4": "dūraṅgamo vaṇṇabalūpapanno ti. [=21].11 ",
  "pv21:11.1": "Pāṇi te sabbasovaṇṇo ",
  "pv21:11.2": "pañcadhāro madhussavo ",
  "pv21:11.3": "nānā rasā paggharanti ",
  "pv21:11.4": "maññe 'haṃ taṃ purindadaṃ. [=21].12 ",
  "pv21:12.1": "N' amhi devo na gandhabbo ",
  "pv21:12.2": "nāpi Sakko purindado ",
  "pv21:12.3": "petaṃ maṃ Aṅkura jānāhi ",
  "pv21:12.4": "Bheruvamhā idhāgatan ti. [=21].13 ",
  "pv21:13.1": "Kiṃsīlo kiṃsamācāro ",
  "pv21:13.2": "Bheruvasmiṃ pure tuvaṃ ",
  "pv21:13.3": "kena te brahmacariyena ",
  "pv21:13.4": "puññaṃ pāṇimhi ijjhati. [=21].14 ",
  "pv21:14.1": "Tunnavāyo pure āsiṃ ",
  "pv21:14.2": "Bheruvasmiṃ tadā ahaṃ ",
  "pv21:14.3": "sukicchavutti kapaṇo ",
  "pv21:14.4": "na me vijjati dātave. [=21].15 ",
  "pv21:15.1": "Āvesanañ ca me āsi ",
  "pv21:15.2": "Asayhassa upantike ",
  "pv21:15.3": "saddhassa dānapatino ",
  "pv21:15.4": "katapuññassa lajjino. [=21].16 ",
  "pv21:16.1": "Tattha yācanakā yanti ",
  "pv21:16.2": "nānāgottā vanibbakā ",
  "pv21:16.3": "te ca maṃ tattha pucchanti ",
  "pv21:16.4": "Asayhassa nivesanaṃ: [=21].17 ",
  "pv21:17.1": "Kattha gacchāma bhaddaṃ vo ",
  "pv21:17.2": "kattha dānaṃ padīyati. ",
  "pv21:17.3": "Tesāhaṃ puṭṭho vakkhāmi ",
  "pv21:17.4": "Asayhassa nivesanaṃ, [=21].18 ",
  "pv21:18.1": "Paggayha dakkhiṇaṃ bāhuṃ: ",
  "pv21:18.2": "ettha gacchatha bhaddaṃ vo ",
  "pv21:18.3": "ettha dānaṃ padīyati ",
  "pv21:18.4": "Asayhassa nivesane. [=21].19 ",
  "pv21:19.1": "Tena pāṇi kāmadado ",
  "pv21:19.2": "tena pāṇi madhussavo ",
  "pv21:19.3": "tena me brahmacariyena ",
  "pv21:19.4": "puññaṃ pāṇimhi ijjhatī ti. [=21].20 ",
  "pv21:20.1": "Na kira tvaṃ adā dānaṃ ",
  "pv21:20.2": "sakapāṇīhi kassaci ",
  "pv21:20.3": "parassa dānaṃ anumodamāno ",
  "pv21:20.4": "pāṇiṃ paggayha pāvadi. [=21].21 ",
  "pv21:21.1": "Tena pāni kāmadado ",
  "pv21:21.2": "tena pāṇi madhussavo ",
  "pv21:21.3": "tena te brahmacariyena ",
  "pv21:21.4": "puññaṃ pāṇimhi ijjhati. [=21].22 ",
  "pv21:22.1": "Yo so dānam adā bhante ",
  "pv21:22.2": "pasanno sakapāṇihi ",
  "pv21:22.3": "so hitvā mānusaṃ dehaṃ ",
  "pv21:22.4": "kin nu so disetaṃ gato. [=21].23 ",
  "pv21:23.1": "Nāhaṃ pajānāmi asayhasāhino ",
  "pv21:23.2": "aṅgīrasassa gatim āgatiṃ vā ",
  "pv21:23.3": "sutañ ca me Vessavaṇassa santike ",
  "pv21:23.4": "sakkassa sahavyataṃ gato Asayho. [=21].24 ",
  "pv21:24.1": "Alam eva kātuṃ kalyāṇaṃ ",
  "pv21:24.2": "dānaṃ dātuṃ yathārahaṃ ",
  "pv21:24.3": "pāṇiṃ kāmadadaṃ disvā ",
  "pv21:24.4": "ko puññaṃ na karissati. [=21].25 ",
  "pv21:25.1": "So hi nūna ito gantvā ",
  "pv21:25.2": "anuppatvāna Dvārakaṃ ",
  "pv21:25.3": "dānaṃ paṭṭhāpayissāmi ",
  "pv21:25.4": "yaṃ mam' assa sukhāvahaṃ. [=21].26 ",
  "pv21:26.1": "Dassām' annañ ca pānañ ca ",
  "pv21:26.2": "vatthasenāsanāni ca ",
  "pv21:26.3": "papañ ca udapānañ ca ",
  "pv21:26.4": "dugge saṅkamanāni cā ti. [=21].27 ",
  "pv21:27.1": "Kena te aṅgulī kuṇṭhā ",
  "pv21:27.2": "mukhañ ca kuṇḍalīkataṃ ",
  "pv21:27.3": "akkhīni ca paggharanti ",
  "pv21:27.4": "kiṃ pāpaṃ pakataṃ tayā ti. [=21].28 ",
  "pv21:28.1": "Aṅgīrarasassa gahapatino ",
  "pv21:28.2": "saddhassa gharam esino ",
  "pv21:28.3": "tassāhaṃ dānavissagge ",
  "pv21:28.4": "dāne adhikato ahuṃ. [=21].29 ",
  "pv21:29.1": "Tattha yācanake disvā ",
  "pv21:29.2": "āgate bhojanatthike ",
  "pv21:29.3": "ekam antaṃ apakkamma ",
  "pv21:29.4": "akāsiṃ kuṇḍalīmukhaṃ. [=21].30 ",
  "pv21:30.1": "Tena me aṅgulī kuṇṭhā ",
  "pv21:30.2": "mukhañ ca kuṇḍalīkataṃ ",
  "pv21:30.3": "akkhīni ca paggharanti ",
  "pv21:30.4": "taṃ pāpaṃ pakataṃmayā ti. [=21].31 ",
  "pv21:31.1": "Dhammena te kāpurisa ",
  "pv21:31.2": "mukhañ ca kuṇḍalīkataṃ ",
  "pv21:31.3": "akkhīni ca paggharanti ",
  "pv21:31.4": "yaṃ tvaṃ parassa dānassa ",
  "pv21:31.5": "akāsi kuṇḍalīmukhan ti. [=21].32 ",
  "pv21:32.1": "Kathaṃ hi dānaṃ dadamāno ",
  "pv21:32.2": "kareyya parapattiyaṃ ",
  "pv21:32.3": "annapānaṃ khādanīyaṃ ",
  "pv21:32.4": "vatthasenāsanāni ca ti. [=21].33 ",
  "pv21:33.1": "So hi nūna ito gantvā ",
  "pv21:33.2": "anuppatvāna Dvārakaṃ ",
  "pv21:33.3": "dānaṃ paṭṭhāpayissāmi ",
  "pv21:33.4": "yaṃ mam' assa sukhāvahaṃ. [=21].34 ",
  "pv21:34.1": "Dassām' annañ ca pānañ ca ",
  "pv21:34.2": "vatthasenāsanāni ca ",
  "pv21:34.3": "papañ ca udapānañ ca ",
  "pv21:34.4": "dugge saṅkamanāni ca. [=21].35 ",
  "pv21:35.1": "Tato hi so nivattitvā ",
  "pv21:35.2": "anuppatvāna Dvārakaṃ ",
  "pv21:35.3": "dānaṃ paṭṭhayi Aṅkuro ",
  "pv21:35.4": "yaṃ tumassa sukhāvahaṃ. [=21].36 ",
  "pv21:36.1": "Adā annañ ca pānañ ca ",
  "pv21:36.2": "vatthasenāsanāni ca ",
  "pv21:36.3": "papañ ca udapānañ ca ",
  "pv21:36.4": "vippasannena cetasā: [=21].37 ",
  "pv21:37.1": "Ko chāto ko ca tasito ",
  "pv21:37.2": "ko vatthaṃ parivassati ",
  "pv21:37.3": "kassa santāni yoggāni ",
  "pv21:37.4": "ito yojentu vāhanaṃ. [=21].38 ",
  "pv21:38.1": "Ko chatt' icchati gandhañ ca ",
  "pv21:38.2": "ko mālaṃ ko upāhanaṃ ",
  "pv21:38.3": "iti ssu tattha ghosenti ",
  "pv21:38.4": "kappakā sūda-māgadhā ",
  "pv21:38.5": "sadā sayañ ca pāto ca ",
  "pv21:38.6": "Aṅkurassa nivesane ti. [=21].39 ",
  "pv21:39.1": "Sukhaṃ supati Aṅkuro ",
  "pv21:39.2": "iti jānāti maṃ jano ",
  "pv21:39.3": "dukkhaṃ supāmi Sindhaka ",
  "pv21:39.4": "yaṃ na passāmi yācake. [=21].40 ",
  "pv21:40.1": "Sukhaṃ supati Aṅkuro ",
  "pv21:40.2": "iti jānāti maṃ jano ",
  "pv21:40.3": "dukkhaṃ supāmi Sindhaka ",
  "pv21:40.4": "appake su vanibbake ti. [=21].41 ",
  "pv21:41.1": "Sakko ce te varaṃ dajjā ",
  "pv21:41.2": "Tāvatiṃsānam issaro ",
  "pv21:41.3": "Kissa sabbassa lokassa ",
  "pv21:41.4": "varamāno varaṃ vare ti. [=21].42 ",
  "pv21:42.1": "Sakko ce me varaṃ dajjā ",
  "pv21:42.2": "Tāvatiṃsānam issaro ",
  "pv21:42.3": "kāluṭṭhitassa me sato ",
  "pv21:42.4": "suriyass' uggamanaṃ pati ",
  "pv21:42.5": "dibbā bhakkhā pātubhaveyyuṃ ",
  "pv21:42.6": "sīlavanto ca yācakā. [=21].43 . ",
  "pv21:43.1": "Dadato me na khīyetha ",
  "pv21:43.2": "datvā nānutappeyy' ahaṃ ",
  "pv21:43.3": "dadaṃ cittaṃ pasādeyyaṃ ",
  "pv21:43.4": "evaṃ Sakkaṃ varaṃ vare ti. [=21].44 ",
  "pv21:44.1": "Na sabbavittāni pare pavecche ",
  "pv21:44.2": "dadeyya dānañ ca dhanañ ca rakkhe ",
  "pv21:44.3": "tasmā hi dānā dhanam eva seyyo ",
  "pv21:44.4": "atippadānena kulā na honti. [=21].45 ",
  "pv21:45.1": "Adānaṃ atidānañ ca ",
  "pv21:45.2": "nappasaṃsanti paṇḍitā ",
  "pv21:45.3": "tasmā hi dānā dhanam eva seyyo ",
  "pv21:45.4": "samena vatteyya sa dhīradhammo ti. [=21].46 ",
  "pv21:46.1": "Aho vatā re aham eva dajjaṃ ",
  "pv21:46.2": "santo hi maṃ sappurisā bhajeyyuṃ ",
  "pv21:46.3": "megho va ninnān' abhipūrayanto ",
  "pv21:46.4": "santappaye sabbavanibbakānaṃ. [=21].47 ",
  "pv21:47.1": "Yassa yācanake disvā ",
  "pv21:47.2": "mukhavaṇṇo pasīdati ",
  "pv21:47.3": "datvā attamano hoti ",
  "pv21:47.4": "taṃ gharaṃ vasato sukhaṃ. [=21].48 ",
  "pv21:48.1": "Yassa yācanake disvā ",
  "pv21:48.2": "mukhavaṇṇo pasīdati ",
  "pv21:48.3": "datvā attamano hoti ",
  "pv21:48.4": "esā puññassa sampadā. [=21].49 ",
  "pv21:49.1": "Pubbe va dānā sumano ",
  "pv21:49.2": "dadaṃ cittaṃ pasādaye ",
  "pv21:49.3": "datvā attamano hoti ",
  "pv21:49.4": "eso puññassa sampadā ti. [=21].50 ",
  "pv21:50.1": "Saṭṭhivāhasahassāni ",
  "pv21:50.2": "Aṅkurassa nivesane ",
  "pv21:50.3": "bhojanaṃ dīyate niccaṃ ",
  "pv21:50.4": "puññapekkhassa jantuno. [=21].51 ",
  "pv21:51.1": "Tisahassāni sūdā hi ",
  "pv21:51.2": "āmuttamaṇikuṇḍalā ",
  "pv21:51.3": "Aṅkuraṃ upajūvanti ",
  "pv21:51.4": "dāne yaññassa vyāvaṭā. [=21].52 ",
  "pv21:52.1": "Saṭṭhipurisasahassāni ",
  "pv21:52.2": "āmuttamaṇikuṇḍalā ",
  "pv21:52.3": "Aṅkurassa mahādāne ",
  "pv21:52.4": "kaṭṭhaṃ phālenti māṇavā. [=21].53 ",
  "pv21:53.1": "Soḷasitthisahassāni ",
  "pv21:53.2": "sabbālaṅkārabhūsitā ",
  "pv21:53.3": "Aṅkurassa mahādāne ",
  "pv21:53.4": "vidhā piṇḍenti nāriyo. [=21].54 ",
  "pv21:54.1": "Soḷasitthisahassāni ",
  "pv21:54.2": "sabbālaṅkārabhūsitā ",
  "pv21:54.3": "Aṅkurassa mahādāne ",
  "pv21:54.4": "dabbigāhā upaṭṭhitā. [=21].55 ",
  "pv21:55.1": "Bahuṃ bahunnaṃ pādāsi ",
  "pv21:55.2": "ciraṃ pādāsi khattiyo ",
  "pv21:55.3": "sakkaccañ ca sahatthā ca ",
  "pv21:55.4": "cittīkatvā punappunaṃ. [=21].56 ",
  "pv21:56.1": "Bahū māse ca pakkhe ca ",
  "pv21:56.2": "utu-saṃvaccharāni ca ",
  "pv21:56.3": "mahādānaṃ pavattesi ",
  "pv21:56.4": "Aṅkuro dīgham antaraṃ. [=21].57 ",
  "pv21:57.1": "Evaṃ datvā yajitvā ca ",
  "pv21:57.2": "Aṅkuro dīgham antaraṃ ",
  "pv21:57.3": "so hitvā mānusaṃ deham ",
  "pv21:57.4": "Tāvatiṃsūpago ahū ti. [=21].58 ",
  "pv21:58.1": "Kaṭacchubhikkhaṃ datvāna ",
  "pv21:58.2": "Anuruddhassa Indako ",
  "pv21:58.3": "so hitvā mānusaṃ dehaṃ ",
  "pv21:58.4": "Tāvatiṃsūpago ahū. [=21].59 ",
  "pv21:59.1": "Dasahi ṭhānehi Aṅkuraṃ ",
  "pv21:59.2": "Indako atirocati ",
  "pv21:59.3": "rūpe sadde rase gandhe ",
  "pv21:59.4": "phoṭṭhabbe ca manorame, [=21].60 ",
  "pv21:60.1": "Āyunā yasasā c' eva ",
  "pv21:60.2": "vaṇṇena ca sukhena ca ",
  "pv21:60.3": "ādhipaccena Aṅkuraṃ ",
  "pv21:60.4": "Indako atirocatī ti. [=21].61 ",
  "pv21:61.1": "",
  "pv21:62.1": "Tāvatiṃse yadā buddho ",
  "pv21:62.2": "sīlāyaṃ paṇḍukambale ",
  "pv21:62.3": "pāricchattakamūlamhi ",
  "pv21:62.4": "vihāsi purisuttamo, [=21].62 ",
  "pv21:63.1": "Dasasu lokadhātūsu ",
  "pv21:63.2": "sannipatitvāna devatā ",
  "pv21:63.3": "payirupāsanti sambuddhaṃ ",
  "pv21:63.4": "vasantaṃ nagamuddhani. [=21].63 ",
  "pv21:64.1": "Na koci devo vaṇṇena ",
  "pv21:64.2": "sambuddhaṃ atirocati ",
  "pv21:64.3": "sabbe deve adhigayha ",
  "pv21:64.4": "sambuddho va virocati. [=21].64 ",
  "pv21:65.1": "Yojanāni dasa dve ca ",
  "pv21:65.2": "Aṅkuro 'yaṃ tadā ahu ",
  "pv21:65.3": "avidūre sambuddhassa ",
  "pv21:65.4": "Indako atirocati. [=21].65 ",
  "pv21:66.1": "Oloketvāna sambuddho ",
  "pv21:66.2": "Aṅkurañ cāpi Indakaṃ ",
  "pv21:66.3": "dakkhiṇeyyaṃ pabhāvento ",
  "pv21:66.4": "idaṃ vacanam abravi: [=21].66 ",
  "pv21:67.1": "Mahādānaṃ tayā dinnaṃ ",
  "pv21:67.2": "Aṅkura dīgham antaraṃ ",
  "pv21:67.3": "atidūre nisinno 'si ",
  "pv21:67.4": "āgaccha mama santike. [=21].67 ",
  "pv21:68.1": "Codito bhāvitattena ",
  "pv21:68.2": "Aṅkuro idam abravi: ",
  "pv21:68.3": "kiṃ mayhaṃ tena dānena ",
  "pv21:68.4": "dakkhiṇeyyena suññataṃ. [=21].68 ",
  "pv21:69.1": "Ayaṃ so Indako yakkho ",
  "pv21:69.2": "dajjā dānaṃ parittakaṃ ",
  "pv21:69.3": "atirocati amhe hi ",
  "pv21:69.4": "cando tāragaṇe yathā. [=21].69 ",
  "pv21:70.1": "Ujjaṅgale yathā khette ",
  "pv21:70.2": "bījaṃ bahukam pi ropitaṃ ",
  "pv21:70.3": "na vipulaṃ phalaṃ hoti ",
  "pv21:70.4": "na pi toseti kassakaṃ. [=21].70 ",
  "pv21:71.1": "Tath' eva dānaṃ bahukaṃ ",
  "pv21:71.2": "dussīlesu patiṭṭhitaṃ ",
  "pv21:71.3": "na vipulaṃ phalaṃ hoti ",
  "pv21:71.4": "na pi toseti dāyakaṃ. [=21].71 ",
  "pv21:72.1": "Yathā pi bhaddake khette ",
  "pv21:72.2": "bījaṃ appam pi ropitaṃ ",
  "pv21:72.3": "sammādhāraṃ pavecchante ",
  "pv21:72.4": "phalaṃ toseti kassakaṃ, [=21].72 ",
  "pv21:73.1": "Tath' eva sīlavantesu ",
  "pv21:73.2": "guṇavantesu tādisu ",
  "pv21:73.3": "appakam pi kataṃ kāraṃ ",
  "pv21:73.4": "puññaṃ hoti mahaphalan ti. [=21].73 ",
  "pv21:74.1": "Viceyya dānam dātabbaṃ ",
  "pv21:74.2": "yattha dinnaṃ mahapphalaṃ ",
  "pv21:74.3": "viceyya dānaṃ datvāna ",
  "pv21:74.4": "saggaṃ gacchanti dāyakā. [=21].74 ",
  "pv21:75.1": "Viceyya dānaṃ sugatappasatthaṃ ",
  "pv21:75.2": "ye dakkhiṇeyyā idha jīvaloke ",
  "pv21:75.3": "etesu dinnāni mahapphalāni ",
  "pv21:75.4": "bījāni vuttāni yathā sukhette ti. ",
  "pv21:76.1": "Aṅkurapetavatthu navamaṃ [=22].1 "
}
