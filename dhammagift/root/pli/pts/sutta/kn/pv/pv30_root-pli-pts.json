  "pv30:0.1": "",
  "pv30:0.2": "",
  "pv30:0.3": "",
  "pv30:1.1": "Accherarūpam sugatassa ñāṇaṃ ",
  "pv30:1.2": "satthā yathā puggalaṃ vyākāsi ",
  "pv30:1.3": "ussannapuññā pi bhavanti h' eke ",
  "pv30:1.4": "parittapuññā pi bhavanti h' eke. [=30].2 ",
  "pv30:2.1": "Ayaṃ kumāro sīvathikāya chaḍḍito ",
  "pv30:2.2": "aṅguṭṭhasnehena yāpeti rattiṃ ",
  "pv30:2.3": "na yakkhabhūtā na siriṃsapā vā ",
  "pv30:2.4": "viheṭhayeyyuṃ katapuññakumāraṃ. [=30].3 ",
  "pv30:3.1": "Sunakhā p' imassa palihiṃsu pāde ",
  "pv30:3.2": "dhaṅkā sigālā parivattayanti ",
  "pv30:3.3": "gabbhāsayaṃ pakkhigaṇā haranti ",
  "pv30:3.4": "kākā pana akkhimalaṃ haranti. [=30].4 ",
  "pv30:4.1": "Na-y-imassa rakkhaṃ vidahiṃsu keci ",
  "pv30:4.2": "na osadhaṃ sāsapadhūpanaṃ vā ",
  "pv30:4.3": "nakkhattayogam pi na aggahesuṃ ",
  "pv30:4.4": "na sabbadhaññāni pi ākiriṃsu. [=30].5 ",
  "pv30:5.1": "Etādisaṃ uttamakicchapattaṃ ",
  "pv30:5.2": "rattābhataṃ sīvathikāya chaḍḍitaṃ ",
  "pv30:5.3": "nonītapiṇḍaṃ va pavedhamānaṃ ",
  "pv30:5.4": "sasaṃsayaṃ jīvitasāvasesaṃ. [=30].6 ",
  "pv30:6.1": "Tam addasā devamanussapūjito ",
  "pv30:6.2": "disvā va taṃ vyākari bhūripañño: ",
  "pv30:6.3": "ayaṃ kumāro nagarass' imassa ",
  "pv30:6.4": "aggakuliko bhavissati bhogato ca. [=30].7 ",
  "pv30:7.1": "Ki 'ssa vataṃ kiṃ pana brahmacariyaṃ ",
  "pv30:7.2": "kissa suciṇṇassa ayaṃ vipāko ",
  "pv30:7.3": "etādisaṃ vyasanaṃ pāpuṇitvā ",
  "pv30:7.4": "taṃ tādisaṃ paccanubhossat' iddhiṃ. [=30].8 ",
  "pv30:8.1": "Buddhapamukhassa bhikkhusaṅghassa ",
  "pv30:8.2": "pūjaṃ akāsi janatā uḷāraṃ ",
  "pv30:8.3": "tatr' assa cittass' ahu aññathattaṃ ",
  "pv30:8.4": "vācaṃ abhāsi pharusaṃ asabbhaṃ. [=30].9 ",
  "pv30:9.1": "So taṃ vitakkaṃ pavinodayitvā ",
  "pv30:9.2": "pītiṃ pasādaṃ paṭiladdhā pacchā ",
  "pv30:9.3": "tathāgataṃ Jetavane vasantaṃ ",
  "pv30:9.4": "yāguyā upaṭṭhāsi sattarattaṃ. [=30].10 ",
  "pv30:10.1": "Tassa vataṃ taṃ pana brahmacariyaṃ ",
  "pv30:10.2": "tassa suciṇṇassa ayaṃ vipāko ",
  "pv30:10.3": "etādisaṃ vyasanaṃ pāpuṇitvā ",
  "pv30:10.4": "taṃ tādisaṃ paccanubhossat' iddhiṃ. [=30].11 ",
  "pv30:11.1": "Ṭhatvāna so vassasataṃ idh' eva ",
  "pv30:11.2": "sabbehi kāmehi samaṅgibhūto ",
  "pv30:11.3": "kāyassa bhedā abhisamparāyaṃ ",
  "pv30:11.4": "sahavyataṃ gacchati Vāsavassā ti. ",
  "pv30:12.1": "Kumārapetavatthu pañcamaṃ [=31].1 "
}
