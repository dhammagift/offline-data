{
  "pv28:0.1": "",
  "pv28:0.2": "",
  "pv28:0.3": "",
  "pv28:1.1": "ruciraṃ pabhassaraṃ ",
  "pv28:1.2": "vimānam āruyha anekacittaṃ ",
  "pv28:1.3": "tatth' acchasi devi mahānubhāve ",
  "pv28:1.4": "pathaddhani paṇṇarase va cando. [=28].2 ",
  "pv28:2.1": "Vaṇṇo ca te kanakassa sannibho ",
  "pv28:2.2": "uttattarūpo bhusa dassanīyo ",
  "pv28:2.3": "pallaṅkaseṭṭhe atule nisinnā ",
  "pv28:2.4": "ekā tuvaṃ natthi ca tuyha sāmiko. [=28].3 ",
  "pv28:3.1": "Imā ca te pokkharañño samantā ",
  "pv28:3.2": "pahūtamalyā bahupuṇḍarīkā ",
  "pv28:3.3": "suvaṇṇacuṇṇehi samantam otthatā ",
  "pv28:3.4": "na tattha paṅko paṇako ca vijjati. [=28].4 ",
  "pv28:4.1": "Haṃsā c' ime dassanīyā manoramā ",
  "pv28:4.2": "udakasmiṃ anupariyanti sabbadā ",
  "pv28:4.3": "samayya vaggūpanadanti sabbe ",
  "pv28:4.4": "bindussarā dundubhīnaṃ va ghoso. [=28].5 ",
  "pv28:5.1": "Daddallamānā yasasā yasassinī ",
  "pv28:5.2": "nāvāya ca tvaṃ avalamba tiṭṭhasi ",
  "pv28:5.3": "āḷārapamhe hasite piyaṃvade ",
  "pv28:5.4": "sabbaṅgakalyāṇi bhusaṃ virocasi. [=28].6 ",
  "pv28:6.1": "Idaṃ vimānaṃ virajaṃ same ṭhitaṃ ",
  "pv28:6.2": "uyyānavantaṃ ratinandivaḍḍhanaṃ ",
  "pv28:6.3": "icchām' ahaṃ nāri anomadassane ",
  "pv28:6.4": "tayā saha Nandane idha moditun ti. [=28].7 ",
  "pv28:7.1": "Karohi kammaṃ idha vedanīyaṃ ",
  "pv28:7.2": "cittañ ca te idha nihitaṃ bhavatu ",
  "pv28:7.3": "katvāna kammaṃ idha vedanīyaṃ ",
  "pv28:7.4": "evaṃ mamaṃ lacchasi kāmakāminiṃ. [=28].8 ",
  "pv28:8.1": "Sādhū ti so tassā paṭissuṇitvā ",
  "pv28:8.2": "akāsi kammaṃ sahavedanīyaṃ ",
  "pv28:8.3": "katvāna kammaṃ tahiṃ vedanīyaṃ ",
  "pv28:8.4": "uppajji māṇavo tassā sahavyatan ti. ",
  "pv28:9.1": "Rathakārapetavatthu tatiyaṃ [=29].1 ",
  "pv28:9.2": ""
}
