{
  "pv45:0.1": "",
  "pv45:0.2": "",
  "pv45:0.3": "",
  "pv45:1.1": "Naggā dubbaṇṇarūpāttha ",
  "pv45:1.2": "kisā dhamanisanthatā ",
  "pv45:1.3": "upphāsulikā kisikā ",
  "pv45:1.4": "ke nu tumhe 'ttha mārisā. [=45].2 ",
  "pv45:2.1": "Mayaṃ bhadante pet' amhā ",
  "pv45:2.2": "duggatā Yamalokikā ",
  "pv45:2.3": "pāpakammaṃ karitvāna ",
  "pv45:2.4": "petalokam ito gatā. [=45].3 ",
  "pv45:3.1": "Kin nu kāyena vācāya ",
  "pv45:3.2": "manasā dukkaṭaṃ kataṃ ",
  "pv45:3.3": "kissa kammavipākena ",
  "pv45:3.4": "idaṃ dukkhaṃ nigacchasi. [=45].4 ",
  "pv45:4.1": "Anāvaṭesu titthesu ",
  "pv45:4.2": "vicinimh' addhamāsakaṃ ",
  "pv45:4.3": "santesu deyyadhammesu ",
  "pv45:4.4": "dīpaṃ nākamha attano. [=45].5 ",
  "pv45:5.1": "Nadiṃ upema tasitā ",
  "pv45:5.2": "rittakā parivattati ",
  "pv45:5.3": "chāyaṃ upema uṇhesu ",
  "pv45:5.4": "ātapo parivattati. [=45].6 ",
  "pv45:6.1": "Aggivaṇṇo ca no vāto ",
  "pv45:6.2": "dahanto upavāyati ",
  "pv45:6.3": "etañ ca bhante arahāma ",
  "pv45:6.4": "aññañ ca pāpakaṃ tato. [=45].7 ",
  "pv45:7.1": "Api yojanāni gacchāma ",
  "pv45:7.2": "chātā āhāragedhino ",
  "pv45:7.3": "aladdhā va nivattāma ",
  "pv45:7.4": "aho no appapuññatā. [=45].8 ",
  "pv45:8.1": "Chātā pamucchitā bhantā ",
  "pv45:8.2": "bhūmiyaṃ paṭisumbhitā ",
  "pv45:8.3": "uttānā patikirāma ",
  "pv45:8.4": "avakujjā patāmase. [=45].9 ",
  "pv45:9.1": "Te ca tatth' eva patitā ",
  "pv45:9.2": "bhūmiyaṃ paṭisumbhitā ",
  "pv45:9.3": "uraṃ sīsañ ca ghaṭṭema ",
  "pv45:9.4": "aho no appapuññatā. [=45].10 ",
  "pv45:10.1": "Etañ ca bhante arahāma ",
  "pv45:10.2": "aññañ ca pāpakaṃ tato ",
  "pv45:10.3": "santesu deyyadhammesu ",
  "pv45:10.4": "dīpaṃ nākamha attano. [=45].11 ",
  "pv45:11.1": "Te hi nūna ito gantvā ",
  "pv45:11.2": "yoniṃ laddhāna mānusiṃ ",
  "pv45:11.3": "vadaññū sīlasampannā ",
  "pv45:11.4": "kāhāma kusalaṃ bahun ti. ",
  "pv45:12.1": "Gaṇapetavatthu dasamaṃ [=46].1 "
}
