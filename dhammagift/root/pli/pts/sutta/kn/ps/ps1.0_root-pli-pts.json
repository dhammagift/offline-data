{
  "ps1.0:0.1": "",
  "ps1.0:0.2": "",
  "ps1.0:0.3": "",
  "ps1.0:0.4": "",
  "ps1.0:1.1": "SOTĀVADHĀNE paññā sutamaye ñāṇaṃ: ",
  "ps1.0:2.1": "Sutvāna saṃvare paññā sīlamaye ñāṇaṃ; ",
  "ps1.0:3.1": "Saṃvaritvā samādahane paññā samādhibhāvanāmaye ñāṇaṃ; ",
  "ps1.0:4.1": "Paccayapariggahe paññā dhammaṭṭhitiñāṇaṃ; ",
  "ps1.0:5.1": "Atītānāgatapaccuppannānaṃ dhammānaṃ saṅkhipitvā vavatthāne paññā sammasane ñāṇaṃ; ",
  "ps1.0:6.1": "Paccuppannānaṃ dhammānaṃ vipariṇāmānupassane paññā udayabbayānupassane ñāṇaṃ; ",
  "ps1.0:7.1": "Ārammaṇaṃ paṭisaṅkhā bhaṅgānupassane paññā vipassane ñāṇaṃ; ",
  "ps1.0:8.1": "Bhayatupaṭṭhāne paññā ādīnave ñāṇaṃ; ",
  "ps1.0:9.1": "Muñcitukamyatā paṭisaṅkhā santiṭṭhanā paññā saṅkhārupekkhāsu ñāṇaṃ; ",
  "ps1.0:10.1": "Bahiddhāvuṭṭhānavivaṭṭane paññā gotrabhuñāṇaṃ; ",
  "ps1.0:11.1": "Dubhatovuṭṭhānavivaṭṭane paññā magge ñāṇaṃ; ",
  "ps1.0:12.1": "Payogapaṭipassaddhipaññā phale ñāṇaṃ; ",
  "ps1.0:13.1": "Chinnamanupassane paññā vimuttiñāṇaṃ; ",
  "ps1.0:14.1": "Tadā samudāgate dhamme vipassane paññā paccavekkhaṇe ñāṇaṃ; ",
  "ps1.0:15.1": "Ajjhattavavatthāne paññā vatthunānatte ñāṇaṃ; ",
  "ps1.0:16.1": "Bahiddhāvavatthāne paññā gocaranānatte ñāṇaṃ; ",
  "ps1.0:17.1": "Cariyāvavatthāne paññā cariyānānatte ñāṇaṃ; ",
  "ps1.0:18.1": "Catudhammavavatthāne paññā bhūminānatte ñāṇaṃ; ",
  "ps1.0:19.1": "Navadhammavavatthāne paññā dhammanānatte ñāṇaṃ; ",
  "ps1.0:20.1": "Abhiññāpaññā ñātaṭṭhe ñāṇaṃ; ",
  "ps1.0:21.1": "Pariññāpaññā tīranaṭṭhe ñāṇaṃ; ",
  "ps1.0:22.1": "Pahānapaññā pariccāgaṭṭhe ñāṇaṃ; ",
  "ps1.0:23.1": "Bhāvanāpaññā ekarasaṭṭhe ñāṇaṃ; ",
  "ps1.0:24.1": "Sacchikiriyāpaññā phussanaṭṭhe ñāṇaṃ; ",
  "ps1.0:25.1": "Atthanānatte paññā atthapaṭisambhide ñāṇaṃ; ",
  "ps1.0:26.1": "Dhammanānatte paññā dhammapaṭisambhide ñāṇaṃ; ",
  "ps1.0:27.1": "Niruttinānatte paññā niruttipaṭisambhide ñāṇaṃ; ",
  "ps1.0:28.1": "Paṭibhānanānatte paññā paṭibhānapaṭisambhide ñāṇaṃ; ",
  "ps1.0:29.1": "Vihāranānatte paññā vihāraṭṭhe ñāṇaṃ; ",
  "ps1.0:30.1": "Samāpattinānatte paññā samāpattaṭṭhe ñāṇaṃ; ",
  "ps1.0:31.1": "Vihārasamāpattinānatte paññā vihārasamāpattaṭṭhe ñāṇaṃ; ",
  "ps1.0:32.1": "Avikkhepaparisuddhattā āsavasamucchede paññā ānantarikasamādhismiṃ ñāṇaṃ; ",
  "ps1.0:33.1": "Dassanādhipateyyaṃ santo ca vihārādhigamo paṇītādhimuttatāpaññā araṇavihāre ñāṇaṃ; ",
  "ps1.0:34.1": "Dvīhi balehi samannāgatattā tayo ca saṅkhārānaṃ paṭippassaddhiyā soḷasahi ñāṇacariyāhi navahi samādhicariyāhi vasībhāvatāpaññā nirodhasamāpattiyā ñāṇaṃ; ",
  "ps1.0:35.1": "Sampajānassa pavattapariyādāne paññā parinibbāne ñāṇaṃ; ",
  "ps1.0:36.1": "Sabbadhammānaṃ sammāsamucchede nirodhe ca anupaṭṭhānatāpaññā samasīsaṭṭhe ñāṇaṃ; ",
  "ps1.0:37.1": "Puthunānattekattatejapariyādāne paññā sallekaṭṭhe ñāṇaṃ; ",
  "ps1.0:38.1": "Asallīnattapahitattapaggahaṭṭhe paññā viriyārambhe ñāṇaṃ; ",
  "ps1.0:39.1": "Nānādhammappakāsanatā paññā atthasandassane ñāṇaṃ; ",
  "ps1.0:40.1": "Sabbadhammānaṃ ekasaṅgahatānānattekattapaṭivedhe paññā dassanavisuddhiñāṇaṃ; ",
  "ps1.0:41.1": "Viditattā paññā khantiñāṇaṃ; ",
  "ps1.0:42.1": "Phuṭṭhattā paññā pariyogāhane ñāṇaṃ; ",
  "ps1.0:43.1": "Samodahane paññā padesavihāre ñāṇaṃ; ",
  "ps1.0:44.1": "Adhipatattā paññā saññāvivaṭṭe ñāṇaṃ; ",
  "ps1.0:45.1": "Nānatte paññā cetovivaṭṭe ñāṇaṃ; ",
  "ps1.0:46.1": "Adhiṭṭhāne paññā cittavivaṭṭe ñāṇaṃ; ",
  "ps1.0:47.1": "Suññate paññā ñāṇavivaṭṭe ñāṇaṃ; ",
  "ps1.0:48.1": "Vossagge paññā vimokkhavivaṭṭe ñāṇaṃ; ",
  "ps1.0:49.1": "Tathaṭṭhe paññā saccavivaṭṭe ñāṇaṃ; ",
  "ps1.0:50.1": "Kāyaṃ pi cittaṃ pi ekavavatthānatā sukhasaññañ ca lahusaññañ ca adhiṭṭhānavasena ijjhanaṭṭhe paññā iddhividhe ñāṇaṃ; ",
  "ps1.0:51.1": "Vitakkavipphāravasena nānattekattasaddanimittānaṃ pariyogāhane paññā sotadhātuvisuddhiñāṇaṃ; ",
  "ps1.0:52.1": "Tiṇṇaṃ cittānaṃ vipphārattā indriyānaṃ pasādavasena nānattekattaviññāṇacariyāpariyogāhaṇe paññā cetopariyañāṇaṃ; ",
  "ps1.0:53.1": "Paccayappavattānaṃ dhammānaṃ nānattekattakammavipphāravasena pariyogāhane paññā pubbenivāsānussatiñāṇaṃ; ",
  "ps1.0:54.1": "Obhāsavasena nānattekattarūpanimittānaṃ dassanaṭṭhe paññā dibbacakkhuñāṇaṃ; ",
  "ps1.0:55.1": "Catusaṭṭhiyā ākārehi tiṇṇaṃ indriyānaṃ vasībhāvatā paññā āsavānaṃ khaye ñāṇaṃ; ",
  "ps1.0:56.1": "Pariññaṭṭhe paññā dukkhe ñāṇaṃ; ",
  "ps1.0:57.1": "Pahānaṭṭhe pañña samudaye ñāṇaṃ; ",
  "ps1.0:58.1": "Sacchikiriyaṭṭhe paññā nirodhe ñāṇaṃ; ",
  "ps1.0:59.1": "Bhāvanaṭṭhe paññā magge ñāṇaṃ, ",
  "ps1.0:60.1": "dukkhe ñāṇaṃ, ",
  "ps1.0:61.1": "dukkhasamudaye ñāṇaṃ, ",
  "ps1.0:62.1": "dukkhanirodhe ñāṇaṃ, ",
  "ps1.0:63.1": "dukkhanirodhagāminiyā paṭipadāya ñāṇaṃ, ",
  "ps1.0:64.1": "atthapaṭisambhide ñāṇaṃ, ",
  "ps1.0:65.1": "dhammapaṭisambhide ñāṇaṃ; ",
  "ps1.0:66.1": "niruttipaṭisambhide ñāṇaṃ, ",
  "ps1.0:67.1": "paṭibhānapaṭisambhide ñāṇaṃ, ",
  "ps1.0:68.1": "indriyaparopariyatte ñāṇaṃ, ",
  "ps1.0:69.1": "sattānaṃ āsayānusaye ñāṇaṃ, ",
  "ps1.0:70.1": "yamakapāṭihīre ñāṇaṃ, ",
  "ps1.0:71.1": "mahākaruṇāsamāpattiyā ñāṇaṃ, ",
  "ps1.0:72.1": "sabbaññutañāṇaṃ, ",
  "ps1.0:73.1": "anāvaraṇañāṇaṃ. ",
  "ps1.0:74.1": "Imāni tesattati ñāṇāni, ",
  "ps1.0:74.2": "imesaṃ tesattatīnaṃ ñāṇānaṃ sattasatthī ñāṇāni sāvakasādhāraṇāni, ",
  "ps1.0:74.3": "cha ñāṇāni asādhāraṇāni sāvakehīti. ",
  "ps1.0:74.4": "MĀTIKĀ NIṬṬHITĀ. Paṭis_I,I.1.1: "
}
