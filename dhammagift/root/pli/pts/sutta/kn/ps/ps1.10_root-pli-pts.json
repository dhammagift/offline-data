{
  "ps1.10:0.1": "",
  "ps1.10:0.2": "",
  "ps1.10:0.3": "",
  "ps1.10:1.1": "Bhikkhave brahmacariyaṃ ",
  "ps1.10:1.2": "",
  "ps1.10:1.3": "satthari sammukhībhūte. Tividho maṇḍo satthari sammukhībhūtā -- desanāmaṇḍo paṭiggahamaṇḍo brahmacariyamaṇḍo. ",
  "ps1.10:2.1": "Katamo desanāmaṇḍo? ",
  "ps1.10:2.2": "Catunnaṃ ariyasaccānaṃ ācikkhanā desanā paññapanā paṭṭhapanā vivaraṇā vibhajanā uttānikammaṃ, catunnaṃ satipaṭṭhānānaṃ . . . pe . . . ",
  "ps1.10:2.3": "catunnaṃ sammappadhānānaṃ, ",
  "ps1.10:2.4": "catunnaṃ iddhipādānaṃ, ",
  "ps1.10:2.5": "pañcannaṃ indriyānaṃ, ",
  "ps1.10:2.6": "pañcannaṃ balānaṃ, ",
  "ps1.10:2.7": "sattannaṃ bojjhaṅgānaṃ, ",
  "ps1.10:2.8": "ariyassa aṭṭhaṅgikassa maggassa ācikkhanā desanā paññapanā paṭṭhapanā vivaraṇā vibhajanā uttānikammaṃ. ",
  "ps1.10:2.9": "Ayaṃ desanāmaṇḍo. ",
  "ps1.10:3.1": "Katamo paṭiggahamaṇḍo? ",
  "ps1.10:3.2": "Bhikkhū bhikkhuniyo upāsakā upāsikāyo devā manussā, ye va pan' aññe pi keci viññātāro. ",
  "ps1.10:3.3": "Ayaṃ paṭiggahamaṇḍo. ",
  "ps1.10:4.1": "Katamo brahmacariyamaṇḍo? ",
  "ps1.10:4.2": "Ayaṃ eva ariyo aṭṭhaṅgiko maggo, seyyathīdaṃ -- ",
  "ps1.10:4.3": "sammādiṭṭhi sammāsaṅkappo sammāvacā sammākammanto sammā- ājīvo sammāvāyāmo sammāsati sammāsamādhi. ",
  "ps1.10:4.4": "Ayaṃ brahmacariyamaṇḍo. Paṭis_I,X.2: ",
  "ps1.10:5.1": "‘Adhimokkhamaṇḍo saddhindriyaṃ assaddhiyaṃ kasaṭo, ",
  "ps1.10:5.2": "assaddhiyaṃ kasaṭaṃ chaḍḍetvā saddhindriyassa adhimokkhamaṇḍaṃ pivatīti' ",
  "ps1.10:5.3": "maṇḍapeyyaṃ; ",
  "ps1.10:5.4": "‘paggahamaṇḍo viriyindriyaṃ kosajjaṃ kasaṭo, ",
  "ps1.10:5.5": "kosajjaṃ kasaṭaṃ chaḍḍetvā viriyindriyassa paggahamaṇḍaṃ pivatīti' ",
  "ps1.10:5.6": "maṇḍapeyyaṃ; ",
  "ps1.10:5.7": "‘upaṭṭhānamaṇḍo satindriyaṃ pamādo kasaṭo, ",
  "ps1.10:5.8": "pamādaṃ kasaṭaṃ chaḍḍetvā satindriyassa upaṭṭhānamaṇḍaṃ pivatīti' ",
  "ps1.10:5.9": "maṇḍapeyyaṃ; ",
  "ps1.10:5.10": "‘avikkhepamaṇḍo samādhindriyaṃ uddhaccaṃ kasaṭo, ",
  "ps1.10:5.11": "uddhaccaṃ kasaṭaṃ chaḍḍetvā samādhindriyassa avikkhepamaṇḍaṃ pivatīti' ",
  "ps1.10:5.12": "maṇḍapeyyaṃ; ",
  "ps1.10:5.13": "‘dassanamaṇḍo paññindriyaṃ avijjā kasaṭo, ",
  "ps1.10:5.14": "avijjaṃ kasaṭaṃ chaḍḍetvā paññindriyassa dassanamaṇḍaṃ pivatīti' ",
  "ps1.10:5.15": "maṇḍapeyyaṃ. ",
  "ps1.10:6.1": "‘Assaddhiye akampiyamaṇḍo saddhābalaṃ assaddhiyaṃ kasaṭo, ",
  "ps1.10:6.2": "assaddhiyaṃ kasaṭaṃ chaḍḍetvā saddhābalassa assaddhiye akampiyamaṇḍaṃ pivatīti' ",
  "ps1.10:6.3": "maṇḍapeyyaṃ; ",
  "ps1.10:6.4": "‘kosajje akampiyamaṇḍo viriyabalaṃ kosajjaṃ kasaṭo, ",
  "ps1.10:6.5": "kosajjaṃ kasaṭaṃ chaḍḍetvā viriyabalassa kosajje akampiyamaṇḍaṃ pivatīti' ",
  "ps1.10:6.6": "maṇḍapeyyaṃ; ",
  "ps1.10:6.7": "‘pamāde akampiyamaṇḍo satibalaṃ pamādo kasaṭo, ",
  "ps1.10:6.8": "pamādaṃ kasaṭaṃ chaḍḍetvā satibalassa pamāde akampiyamaṇḍaṃ pivatīti' ",
  "ps1.10:6.9": "maṇḍapeyyaṃ; ",
  "ps1.10:6.10": "‘uddhacce akampiyamaṇḍo samādhibalaṃ uddhaccaṃ kasato, ",
  "ps1.10:6.11": "uddhaccaṃ kasaṭaṃ chaḍḍetvā samādhibalassa uddhacce akampiyamaṇḍaṃ pivatīti' ",
  "ps1.10:6.12": "maṇḍapeyyaṃ; ",
  "ps1.10:6.13": "‘avijjāya akampiyamaṇḍo paññābalaṃ avijjā kasaṭo, ",
  "ps1.10:6.14": "avijjaṃ kasaṭaṃ chaḍḍetvā paññābalassa avijjāya akampiyamaṇḍaṃ pivatīti' ",
  "ps1.10:6.15": "maṇḍapeyyaṃ ",
  "ps1.10:7.1": "‘Upaṭṭhānamaṇḍo satisambojjhaṅgo pamādo kasaṭo, ",
  "ps1.10:7.2": "pamādaṃ kasataṃ chaḍḍetvā satisambojjhaṅgassa upaṭṭhānamaṇḍaṃ pivatīti' ",
  "ps1.10:7.3": "maṇḍapeyyaṃ; ",
  "ps1.10:7.4": "pavicayamaṇḍo dhammavicayasambojjhaṅgo avijjā kasaṭo, ",
  "ps1.10:7.5": "avijjaṃ kasaṭaṃ chaddetvā dhammavicayasambojjhaṅgassa pavicayamaṇḍaṃ pivatīti' ",
  "ps1.10:7.6": "maṇḍapeyyaṃ; ",
  "ps1.10:7.7": "‘paggahamaṇḍo viriyasambojjhaṅgo kosajjaṃ kasaṭo, ",
  "ps1.10:7.8": "kosajjaṃ kasaṭaṃ chaḍḍetvā viriyasambojjhaṅgassa paggahamaṇḍaṃ pivatīti' ",
  "ps1.10:7.9": "maṇḍapeyyaṃ; ",
  "ps1.10:7.10": "‘pharaṇamaṇḍo pītisambojjhaṅgo pariḷāho kasaṭo, ",
  "ps1.10:7.11": "pariḷāhaṃ kasaṭaṃ chaḍḍetvā pītisambojjhaṅgassa pharaṇamaṇḍaṃ pivatīti' ",
  "ps1.10:7.12": "maṇḍapeyyaṃ; ",
  "ps1.10:7.13": "‘upasamamaṇḍo passaddhisambojjhaṅgo duṭṭhullaṃ kasaṭo, ",
  "ps1.10:7.14": "duṭṭhullaṃ kasaṭaṃ chaḍḍetvā passaddhisambojjhaṅgassa upasamamaṇḍaṃ pivatīti' ",
  "ps1.10:7.15": "maṇḍapeyyaṃ; ",
  "ps1.10:7.16": "‘avikkhepamaṇḍo samādhisambojjhaṅgo uddhaccaṃ kasaṭo, ",
  "ps1.10:7.17": "uddhaccaṃ kasaṭaṃ chaḍḍetvā samādhisambojjhaṅgassa avikkhepamaṇḍaṃ pivatīti' ",
  "ps1.10:7.18": "maṇḍapeyyaṃ; ",
  "ps1.10:7.19": "‘paṭisaṅkhānamaṇḍo upekkhāsambojjhaṅgo appaṭisaṅkhānaṃ kasaṭo, ",
  "ps1.10:7.20": "appaṭisaṅkhānaṃ kasaṭaṃ chaḍḍetvā upekkhāsambojjhaṅgassa paṭisaṅkhānamaṇḍaṃ pivatīti' ",
  "ps1.10:7.21": "maṇḍapeyyaṃ; ",
  "ps1.10:8.1": "‘dassanamaṇḍo sammādiṭṭhi micchādiṭṭhi kasaṭo, ",
  "ps1.10:8.2": "micchādiṭṭhiṃ kasaṭaṃ chaḍḍetvā sammādiṭṭhiyā dassanamaṇḍaṃ pivatīti' ",
  "ps1.10:8.3": "maṇḍapeyyaṃ; ",
  "ps1.10:8.4": "‘abhiropanamaṇḍo sammāsaṅkappo micchāsaṅkappo kasaṭo, ",
  "ps1.10:8.5": "micchāsaṅkappaṃ kasaṭaṃ chaḍḍetvā sammāsaṅkappassa abhiropanamaṇḍaṃ pivatīti' ",
  "ps1.10:8.6": "maṇḍapeyyaṃ; ",
  "ps1.10:8.7": "‘pariggahamaṇḍo sammāvācā micchāvācā kasaṭo, ",
  "ps1.10:8.8": "micchāvācaṃ kasaṭaṃ chaḍḍetvā sammāvācāya pariggahamaṇḍaṃ pivatīti' ",
  "ps1.10:8.9": "maṇḍapeyyaṃ; ",
  "ps1.10:8.10": "‘samuṭṭhānamaṇḍo sammākammanto micchākammanto kasaṭo, ",
  "ps1.10:8.11": "micchākammantaṃ kasaṭaṃ chaḍḍetvā sammākammantassa samuṭṭhānamaṇḍaṃ pivatīti' ",
  "ps1.10:8.12": "maṇḍapeyyaṃ; ",
  "ps1.10:8.13": "‘vodānamaṇḍo sammā-ājīvo micchā-ājīvo kasaṭo, ",
  "ps1.10:8.14": "micchā-ājīvaṃ kasaṭaṃ chaḍḍetvā sammā-ājīvassa vodānamaṇḍaṃ pivatīti' ",
  "ps1.10:8.15": "maṇḍapeyyaṃ; ",
  "ps1.10:8.16": "‘paggahamaṇḍo sammāvāyāmo micchāvāyāmo kasaṭo, ",
  "ps1.10:8.17": "micchāvāyāmaṃ kasaṭaṃ chaḍḍetvā sammāvāyāmassa paggahamaṇḍaṃ pivatīti' ",
  "ps1.10:8.18": "maṇḍapeyyaṃ; ",
  "ps1.10:8.19": "‘upaṭṭhānamaṇḍo sammāsati micchāsati kasaṭo, ",
  "ps1.10:8.20": "micchāsatiṃ kasataṃ chaḍḍetvā sammāsatiyā upaṭṭhānamaṇḍaṃ pivatīti' ",
  "ps1.10:8.21": "maṇḍapeyyaṃ; ",
  "ps1.10:8.22": "‘avikkhepamaṇḍo sammāsamādhi micchāsamādhi kasaṭo, ",
  "ps1.10:8.23": "micchāsamādhiṃ kasaṭaṃ chaḍḍetvā sammāsamādhissa avikkhepamaṇḍaṃ pivatīti' ",
  "ps1.10:8.24": "maṇḍapeyyaṃ. Paṭis_I,X.3: ",
  "ps1.10:9.1": "Atthi maṇḍo, atthi peyyaṃ, atthi kasaṭo. ",
  "ps1.10:9.2": "Adhimokkhamaṇḍo saddhindriyaṃ assaddhiyaṃ kasaṭo, ",
  "ps1.10:9.3": "yo tattha attharaso dhammaraso vimuttiraso, ",
  "ps1.10:9.4": "idaṃ peyyaṃ; ",
  "ps1.10:9.5": "paggahamaṇḍo viriyindriyaṃ kosajjaṃ kasaṭo, ",
  "ps1.10:9.6": "yo tattha attharaso dhammaraso vimuttiraso, ",
  "ps1.10:9.7": "idaṃ peyyaṃ; ",
  "ps1.10:9.8": "upaṭṭhānamaṇḍo satindriyaṃ pamādo kasaṭo, ",
  "ps1.10:9.9": "yo tattha attharaso dhammaraso vimuttiraso, ",
  "ps1.10:9.10": "idaṃ peyyaṃ; ",
  "ps1.10:9.11": "avikkhepamaṇḍo samādhindriyaṃ uddhaccaṃ kasaṭo, ",
  "ps1.10:9.12": "yo tattha attharaso dhammaraso vimuttiraso, ",
  "ps1.10:9.13": "idaṃ peyyaṃ; ",
  "ps1.10:9.14": "dassanamaṇḍo paññindriyaṃ avijjā kasaṭo, ",
  "ps1.10:9.15": "yo tattha attharaso dhammaraso vimuttiraso, ",
  "ps1.10:9.16": "idaṃ peyyaṃ. ",
  "ps1.10:10.1": "Assaddhiye akampiyamaṇḍo saddhābalaṃ assaddhiyaṃ kasaṭo, ",
  "ps1.10:10.2": "yo tattha attharaso dhammaraso vimuttiraso, ",
  "ps1.10:10.3": "idaṃ peyyaṃ; ",
  "ps1.10:10.4": "kosajje akampiyamaṇḍo viriyabalaṃ kosajjaṃ kasaṭo, ",
  "ps1.10:10.5": "yo tattha attharaso dhammaraso vimuttiraso, ",
  "ps1.10:10.6": "idaṃ peyyaṃ; ",
  "ps1.10:10.7": "pamāde akampiyamaṇḍo satibalaṃ pamādo kasaṭo, ",
  "ps1.10:10.8": "yo tattha attharaso dhammaraso vimuttiraso, ",
  "ps1.10:10.9": "idaṃ peyyaṃ; ",
  "ps1.10:10.10": "uddhacce akampiyamaṇḍo samādhibalaṃ uddhaccaṃ kasaṭo, ",
  "ps1.10:10.11": "yo tattha attharaso dhammaraso vimuttiraso, ",
  "ps1.10:10.12": "idaṃ peyyaṃ; ",
  "ps1.10:10.13": "avijjāya akampiyamaṇḍo paññābalaṃ avijjā kasaṭo, ",
  "ps1.10:10.14": "yo tattha attharaso dhammaraso vimuttiraso, ",
  "ps1.10:10.15": "idaṃ peyyaṃ. ",
  "ps1.10:11.1": "Upaṭṭhānamaṇḍo satisambojjhaṅgo pamādo kasaṭo, ",
  "ps1.10:11.2": "yo tattha attharaso dhammaraso vimuttiraso, ",
  "ps1.10:11.3": "idaṃ peyyaṃ; ",
  "ps1.10:11.4": "pavicayamaṇḍo dhammavicayasambojjhaṅgo avijjā kasaṭo, ",
  "ps1.10:11.5": "yo tattha attharaso dhammaraso vimuttiraso, ",
  "ps1.10:11.6": "idaṃ peyyaṃ; ",
  "ps1.10:11.7": "paggahamaṇḍo viriyasambojjhaṅgo kosajjaṃ kasaṭo, ",
  "ps1.10:11.8": "yo tattha attharaso dhammaraso vimuttiraso, ",
  "ps1.10:11.9": "idaṃ peyyaṃ; ",
  "ps1.10:11.10": "pharaṇamaṇḍo pītisambojjhaṅgo pariḷāho kasaṭo, ",
  "ps1.10:11.11": "yo tattha attharaso dhammaraso vimuttiraso, ",
  "ps1.10:11.12": "idaṃ peyyaṃ; ",
  "ps1.10:11.13": "upasamamaṇḍo passaddhisambojjhaṅgo duṭhullaṃ kasaṭo, ",
  "ps1.10:11.14": "yo tattha attharaso dhammaraso vimuttiraso, ",
  "ps1.10:11.15": "idaṃ peyyaṃ; ",
  "ps1.10:11.16": "avikkhepamaṇḍo samādhisambojjhaṅgo uddhaccaṃ kasaṭo, ",
  "ps1.10:11.17": "yo tattha attharaso dhammaraso vimuttiraso, ",
  "ps1.10:11.18": "idaṃ peyyaṃ; ",
  "ps1.10:11.19": "paṭisaṅkhānamaṇḍo upekkhāsambojjhaṅgo appaṭisaṅkhānaṃ kasaṭo, ",
  "ps1.10:11.20": "yo tattha attharaso dhammaraso vimuttiraso, ",
  "ps1.10:11.21": "idaṃ peyyaṃ. ",
  "ps1.10:12.1": "Dassanamaṇḍo sammādiṭṭhi micchādiṭṭhi kasaṭo, ",
  "ps1.10:12.2": "yo tattha attharaso dhammaraso vimuttiraso, ",
  "ps1.10:12.3": "idaṃ peyyaṃ; ",
  "ps1.10:12.4": "abhiropanamaṇḍo sammāsaṅkappo micchāsaṅkappo kasaṭo, ",
  "ps1.10:12.5": "yo tattha attharaso dhammaraso vimuttiraso, ",
  "ps1.10:12.6": "idaṃ peyyaṃ; ",
  "ps1.10:12.7": "pariggahamaṇḍo sammāvācā micchāvācā kasaṭo, ",
  "ps1.10:12.8": "yo tattha attharaso dhammaraso vimuttiraso, ",
  "ps1.10:12.9": "idaṃ peyyaṃ; ",
  "ps1.10:12.10": "samuṭṭhānamaṇḍo sammākammanto micchākammanto kasaṭo, ",
  "ps1.10:12.11": "yo tattha attharaso dhammaraso vimuttiraso, ",
  "ps1.10:12.12": "idaṃ peyyaṃ; ",
  "ps1.10:12.13": "vodānamaṇḍo sammā-ājīvo micchā-ājīvo kasaṭo, ",
  "ps1.10:12.14": "yo tattha attharaso dhammaraso vimuttiraso, ",
  "ps1.10:12.15": "idaṃ peyyaṃ; ",
  "ps1.10:12.16": "paggahamaṇḍo sammāvāyāmo micchāvāyāmo kasaṭo, ",
  "ps1.10:12.17": "yo tattha attharaso dhammaraso vimuttiraso, ",
  "ps1.10:12.18": "idaṃ peyyaṃ; ",
  "ps1.10:12.19": "upaṭṭhānamaṇḍo sammāsati micchāsati kasaṭo, ",
  "ps1.10:12.20": "yo tattha attharaso dhammaraso vimuttiraso, ",
  "ps1.10:12.21": "idaṃ peyyaṃ; ",
  "ps1.10:12.22": "avikkhepamaṇḍo sammāsamādhi micchāsamādhi kasaṭo, ",
  "ps1.10:12.23": "yo tattha attharaso dhammaraso vimuttiraso, ",
  "ps1.10:12.24": "idaṃ peyyaṃ. Paṭis_I,X.4: ",
  "ps1.10:13.1": "Dassanamaṇḍo sammādiṭṭhi, ",
  "ps1.10:13.2": "abhiropanamaṇḍo sammāsaṅkappo, ",
  "ps1.10:13.3": "pariggahamaṇḍo sammāvācā, ",
  "ps1.10:13.4": "samuṭṭhānamaṇḍo sammākammanto, ",
  "ps1.10:13.5": "vodānamaṇḍo sammā-ājīvo, ",
  "ps1.10:13.6": "paggahamaṇḍo sammāvāyāmo, ",
  "ps1.10:13.7": "upaṭṭhānamaṇḍo sammāsati, ",
  "ps1.10:13.8": "avikkhepamaṇḍo sammāsamādhi; ",
  "ps1.10:14.1": "upaṭṭhānamaṇḍo satisambojjhaṅgo, ",
  "ps1.10:14.2": "pavicayamaṇḍo dhammavicayasambojjhaṅgo, ",
  "ps1.10:14.3": "paggahamaṇḍo viriyasambojjhaṅgo, ",
  "ps1.10:14.4": "pharaṇamaṇḍo pītisambojjhaṅgo, ",
  "ps1.10:14.5": "upasamamaṇḍo passaddhisambojjhaṅgo, ",
  "ps1.10:14.6": "avikkhepamaṇḍo samādhisambojjhaṅgo, ",
  "ps1.10:14.7": "paṭisaṅkhānamaṇḍo upekkhāsambojjhaṅgo; ",
  "ps1.10:15.1": "assaddhiye akampiyamaṇḍo saddhābalaṃ, ",
  "ps1.10:15.2": "kosajje akampiyamaṇḍo viriyabalaṃ, ",
  "ps1.10:15.3": "pamāde akampiyamaṇḍo satibalaṃ, ",
  "ps1.10:15.4": "uddhacce akampiyamaṇḍo samādhibalaṃ, ",
  "ps1.10:15.5": "avijjāya akampiyamaṇḍo paññābalaṃ; ",
  "ps1.10:16.1": "adhimokkhamaṇḍo saddhindriyaṃ, ",
  "ps1.10:16.2": "paggahamaṇḍo viriyindriyaṃ, ",
  "ps1.10:16.3": "upaṭṭhānamaṇḍo satindriyaṃ, ",
  "ps1.10:16.4": "avikkhepamaṇḍo samādhindriyaṃ, ",
  "ps1.10:16.5": "dassanamaṇḍo paññindriyaṃ. ",
  "ps1.10:17.1": "Ādhipateyyaṭṭhena indriyaṃ maṇḍo, akampiyaṭṭhena balaṃ maṇḍo, niyyānaṭṭhena bojjhaṅgo maṇḍo, hetuṭṭhena maggo maṇḍo, upaṭṭhānaṭṭhena satipaṭṭhānā maṇḍo, padahanaṭṭhena sammappadhānā maṇḍo, ijjhanaṭṭhena iddhipādā maṇḍo; avikkhepaṭṭhena samatho maṇḍo, anupassanaṭṭhena vipassanā maṇḍo, ekarasaṭṭhena samathavipassanā maṇḍo, anativattanaṭṭhena yuganandhā maṇḍo; saṃvaraṭṭhena sīlavisuddhi maṇḍo, avikkhepaṭṭhena cittavisuddhi maṇḍo, dassanaṭṭhena diṭṭhivisuddhi maṇḍo; muttaṭṭhena vimokkho maṇḍo, paṭivedhaṭṭhena vijjā maṇḍo, pariccāgaṭṭhena vimutti maṇḍo, samucchedaṭṭhena khaye ñāṇaṃ maṇḍo, paṭipassaddhaṭṭhena anuppāde ñāṇaṃ maṇḍo. Chando mūlaṭṭhena maṇḍo, manasikāro samuṭṭhānaṭṭhena maṇḍo, phasso samodhānaṭṭhena maṇḍo, vedanā samosaraṇaṭṭhena maṇḍo, samādhi pamukhaṭṭhena maṇḍo, sati ādhipateyyaṭṭhena naṇḍo, paññā taduttaraṭṭhena maṇḍo, vimutti sāraṭṭhena maṇḍo, amatogadhaṃ nibbānaṃ pariyosānaṭṭhena maṇḍo ti. ",
  "ps1.10:17.2": "Maṇḍapeyyakathā niṭṭhitā. ",
  "ps1.10:17.3": "Tassa vaggassa udānaṃ ",
  "ps1.10:17.4": "",
  "ps1.10:17.5": "bhavati. ",
  "ps1.10:18.1": "Ñāṇa diṭṭhi ca assāsā ",
  "ps1.10:18.2": "Indriya vimokkha pañcamā ",
  "ps1.10:18.3": "Gati kamma vipallāsā ",
  "ps1.10:18.4": "Maggo maṇḍena te dasā ti. ",
  "ps1.10:18.5": "Esanikāyavaro ṭhapito asamo paṭhamo pavaro varo ca vaggo ti. Paṭis_II,I.1: "
}
