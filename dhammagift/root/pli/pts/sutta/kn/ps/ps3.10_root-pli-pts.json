{
  "ps3.10:0.1": "",
  "ps3.10:0.2": "",
  "ps3.10:0.3": "",
  "ps3.10:1.1": "NICCHĀTO muccatīti vimokkho, vijjāvimutti, adhisīlaṃ adhicittaṃ adhipaññā, passaddhi, ñāṇaṃ, dassanaṃ, visuddhi, nekkhammaṃ, nissaraṇaṃ,paviveko, vossaggo, cariyā, jhānavimokkho, bhāvanā, adhiṭṭhānaṃ, jīvitaṃ. ",
  "ps3.10:2.1": "‘Nicchāto' ti. Nekkhammena kāmacchandato nicchāto, abyāpādena byāpādato nicchāto . . . pe . . . ",
  "ps3.10:2.2": "paṭhamajjhānena nīvaraṇehi nicchāto . . . pe . . . ",
  "ps3.10:2.3": "Arahattamaggena sabbakilesehi nicchāto ",
  "ps3.10:3.1": "muccati. ‘Vimokkho' ti. ‘Nekhammena kāmacchandato muccatīti' ",
  "ps3.10:3.2": "vimokkho, ",
  "ps3.10:3.3": "‘abyāpādena byāpādato muccatīti' ",
  "ps3.10:3.4": "vimokkho . . . pe . . . ",
  "ps3.10:3.5": "‘paṭhamajjhānena nīvaraṇehi muccatīti' ",
  "ps3.10:3.6": "vimokkho . . . pe . . . ",
  "ps3.10:3.7": "‘Arahattamaggena sabbakilesehi muccatīti' ",
  "ps3.10:3.8": "vimokkho. ",
  "ps3.10:4.1": "‘Vijjāvimuttīti'. ‘Nekhammaṃ vijjatīti' vijjā, ‘kāmacchandato muccatīti' vimutti, ",
  "ps3.10:4.2": "‘vijjanto muccati muccanto vijjatīti' ",
  "ps3.10:4.3": "vijjāvimutti; ",
  "ps3.10:4.4": "‘abyāpādo vijjatīti' vijjā, ‘byāpādato muccatīti' vimutti, ",
  "ps3.10:4.5": "‘vijjanto muccati muccanto vijjatīti' ",
  "ps3.10:4.6": "Vijjāvimutti . . . pe . . . ",
  "ps3.10:4.7": "‘Arahattamaggo vijjatīti' vijjā, ‘sabbakilesehi muccatīti' vimutti, ",
  "ps3.10:4.8": "‘vijjanto muccati muccanto vijjatīti' ",
  "ps3.10:4.9": "vijjāvimutti. Paṭis_III,X.2: ",
  "ps3.10:5.1": "‘Adhisīlaṃ adhicittaṃ adhipaññā' ti. Nekhammena kāmacchandaṃ saṃvaraṭṭhena sīlavisuddhi, avikkhepaṭṭhena cittavisuddhi, dassanaṭṭhena diṭṭhivisuddhi. ",
  "ps3.10:5.2": "Yo tattha saṃvaraṭṭho, ayaṃ adhisīlasikkhā; ",
  "ps3.10:5.3": "yo tattha avikkhepaṭṭho, ayaṃ adhicittasikkhā; ",
  "ps3.10:5.4": "yo tattha dassanaṭṭho, ayaṃ adhipaññāsikkhā. ",
  "ps3.10:5.5": "Abyāpādena byāpādaṃ saṃvaraṭṭhena sīlavisuddhi . . . pe . . . ",
  "ps3.10:5.6": "Arahattamaggena sabbakilese saṃvaraṭṭhena sīlavisuddhi, avikkhepaṭṭhena cittavisuddhi, ",
  "ps3.10:5.7": "dassanaṭṭhena diṭṭhivisuddhi. ",
  "ps3.10:5.8": "Yo tattha saṃvaraṭṭho, ayaṃ adhisīlasikkhā; ",
  "ps3.10:5.9": "yo tattha avikkhepaṭṭho, ayaṃ adhicittasikkhā; ",
  "ps3.10:5.10": "yo tattha dassanaṭṭho, ayaṃ adhipaññāsikkhā. Paṭis_III,X.3: ",
  "ps3.10:6.1": "‘Passaddhīti'. Nekhammena kāmacchandaṃ paṭippassambheti, abyāpādena byāpādaṃ paṭippassambheti . . . pe . . . ",
  "ps3.10:6.2": "Arahattamaggena sabbakilese paṭippassambheti. ",
  "ps3.10:7.1": "‘Ñāṇan' ti. Kāmacchandassa pahīnattā nekkhammaṃ ñātaṭṭhena ñāṇaṃ, ",
  "ps3.10:7.2": "byāpādassa pahīnattā abyāpādo ñātaṭṭhena ñāṇaṃ . . . pe . . . ",
  "ps3.10:7.3": "sabbakilesānaṃ pahīnattā Arahattamaggo ñātaṭṭhena ñāṇaṃ . ",
  "ps3.10:8.1": "‘Dassanan' ti. Kāmacchandassa pahīnattā nekkhammaṃ diṭṭhattā dassanaṃ, ",
  "ps3.10:8.2": "byāpādassa pahīnattā abyāpādo diṭṭhattā dassanaṃ . . . pe . . . ",
  "ps3.10:8.3": "sabbakilesānaṃ pahīnattā Arahattamaggo diṭṭhattā dassanaṃ. ",
  "ps3.10:9.1": "‘Visuddhīti'. Kāmacchandaṃ pajahanto nekkhammena visujjhati, ",
  "ps3.10:9.2": "byāpādaṃ pajahanto abyāpādena visujjhati . . . pe . . . ",
  "ps3.10:9.3": "sabbakilese pajahanto Arahattamaggena visujjhati. ",
  "ps3.10:10.1": "Paṭis_III,X.4: ‘Nekkhamman' ti, Kāmānaṃ etaṃ nissaraṇaṃ, yadidaṃ nekkhammaṃ; ",
  "ps3.10:10.2": "rūpānaṃ etaṃ nissaraṇaṃ, yadidaṃ āruppaṃ: ",
  "ps3.10:10.3": "yaṃ kho pana kiñci bhūtaṃ saṅkhataṃ paṭiccasamuppannaṃ nirodho tassa nekkhammaṃ. ",
  "ps3.10:10.4": "Byāpādassa abyāpādo nekkhammaṃ, ",
  "ps3.10:10.5": "thīnamiddhassa ālokasaññā nekkhammaṃ . . . pe . . . ",
  "ps3.10:10.6": "sabbakilesānaṃ Arahattamaggo nekkhammaṃ. ",
  "ps3.10:11.1": "‘Nissaraṇan' ti. Kāmānaṃ etaṃ nissaraṇaṃ, yadidaṃ nekkhammaṃ: ",
  "ps3.10:11.2": "rūpānaṃ etaṃ nissaraṇaṃ, yadidaṃ āruppaṃ: ",
  "ps3.10:11.3": "yaṃ kho pana kiñci bhūtaṃ saṅkhataṃ paṭiccasamuppannaṃ nirodho tassa nissaraṇaṃ. ",
  "ps3.10:11.4": "Kāmacchandassa nekkhammaṃ nissaraṇaṃ, ",
  "ps3.10:11.5": "byāpādassa abyāpādo nissaraṇaṃ . . . pe . . . ",
  "ps3.10:11.6": "sabbakilesānaṃ Arahattamaggo nissaraṇaṃ. ",
  "ps3.10:12.1": "‘Paviveko' ti. Kāmacchandassa nekkhammaṃ paviveko, byāpādassa abyāpādo paviveko . . . pe . . . ",
  "ps3.10:12.2": "sabbakilesānaṃ Arahattamaggo paviveko. ",
  "ps3.10:13.1": "‘Vossaggo' ti. Nekkhammena kāmacchandaṃ vossajjati, ",
  "ps3.10:13.2": "",
  "ps3.10:13.3": "abyāpādena byāpādaṃ vossajjati . . . ",
  "ps3.10:13.4": "pe . . . ",
  "ps3.10:13.5": "Arahattamaggena sabbakilese ",
  "ps3.10:13.6": "vossajjati. ",
  "ps3.10:14.1": "‘Cariyā' ti. Kāmacchandaṃ pajahanto nekkhammena carati, ",
  "ps3.10:14.2": "byāpādaṃ pajahanto abyāpādena carati . . . pe . . . ",
  "ps3.10:14.3": "sabbakilese pajahanto Arahattamaggena carati. ",
  "ps3.10:15.1": "‘Jhānavimokkho' ti. ‘Nekkhammaṃ jhāyatīti' ",
  "ps3.10:15.2": "jhānaṃ, ",
  "ps3.10:15.3": "‘kāmacchandaṃ jhāpetīti' ",
  "ps3.10:15.4": "jhānaṃ; ",
  "ps3.10:15.5": "‘jhāyanto muccatīti' ",
  "ps3.10:15.6": "jhānavimokkho, ",
  "ps3.10:15.7": "‘jhāpento muccatīti' ",
  "ps3.10:15.8": "jhānavimokkho; ",
  "ps3.10:15.9": "‘jhāyantīti dhammā ",
  "ps3.10:15.10": "jhāpentīti kilese ",
  "ps3.10:15.11": "jhāte ca jhāpe ca jānātīti' ",
  "ps3.10:15.12": "jhānavimokkho. ",
  "ps3.10:15.13": "‘Abyāpādo jhāyatīti' jhānaṃ, ",
  "ps3.10:15.14": "‘byāpādaṃ jhāpetīti' ",
  "ps3.10:15.15": "jhānaṃ; ‘ ",
  "ps3.10:15.16": "ālokasaññā jhāyatīti' ",
  "ps3.10:15.17": "jhānaṃ, ",
  "ps3.10:15.18": "thīmamiddhaṃ jhāpetīti' ",
  "ps3.10:15.19": "jhānaṃ . . . pe . . . ",
  "ps3.10:15.20": "‘Arahattamaggo jhāyatīti' ",
  "ps3.10:15.21": "jhānaṃ, ",
  "ps3.10:15.22": "‘sabbakilese jhāpetīti' ",
  "ps3.10:15.23": "jhānaṃ; ",
  "ps3.10:15.24": "‘jhāyanto muccatīti' ",
  "ps3.10:15.25": "jhānavimokkho, ",
  "ps3.10:15.26": "‘jhāpento muccatīti' ",
  "ps3.10:15.27": "jhānavimokkho; ",
  "ps3.10:15.28": "‘jhāyantīti ",
  "ps3.10:15.29": "dhammā ",
  "ps3.10:15.30": "jhāpentīti ",
  "ps3.10:15.31": "kilese ",
  "ps3.10:15.32": "jhāte ca jhāpe ca jānātīti' ",
  "ps3.10:15.33": "jhānavimokkho Paṭis_III,X.5: ",
  "ps3.10:16.1": "‘Bhāvanā adhiṭṭhānaṃ jīvitan' ti. ‘Kāmacchandaṃ pajahanto nekkhammaṃ bhāvetīti' ",
  "ps3.10:16.2": "bhāvanāsampanno, ",
  "ps3.10:16.3": "‘nekkhammavasena cittaṃ adhiṭṭhātīti' ",
  "ps3.10:16.4": "adhiṭṭhānasampanno, ",
  "ps3.10:16.5": "‘svāyaṃ evaṃ bhāvanāsampanno adhiṭṭhānasampanno samaṃ jīvati no visamaṃ, ",
  "ps3.10:16.6": "sammā jīvati no micchā, ",
  "ps3.10:16.7": "visuddhaṃ jīvati no kiliṭṭhan' ti ",
  "ps3.10:16.8": "ājīvasampanno. ",
  "ps3.10:16.9": "Svāyaṃ evaṃ bhāvanāsampanno adhiṭṭhānasampanno ājīvasampanno yañ ñad eva parisaṃ upasaṅkamati, ",
  "ps3.10:16.10": "yadi khattiyaparisaṃ yadi brāhmaṇaparisaṃ yadi gahapatiparisaṃ yadi samaṇaparisaṃ, ",
  "ps3.10:16.11": "visārado upasaṅkamati amaṅkubhūto. ",
  "ps3.10:16.12": "Taṃ kissa hetu? ",
  "ps3.10:16.13": "Tathā hi so bhāvanāsampanno adhiṭṭhānasampanno ājīvasampanno. ",
  "ps3.10:17.1": "‘Byāpādaṃ pajahanto abyāpādaṃ bhāvetīti' ",
  "ps3.10:17.2": "bhāvanāsampanno, ",
  "ps3.10:17.3": "‘thīnamiddhaṃ pajahanto ālokasaññaṃ bhāvetīti' ",
  "ps3.10:17.4": "bhāvanāsampanno, ",
  "ps3.10:17.5": "‘uddhaccaṃ pajahanto avikkhepaṃ bhāvetīti' ",
  "ps3.10:17.6": "bhāvanāsampanno, ",
  "ps3.10:17.7": "vicikicchaṃ pajahanto dhammavavatthānaṃ bhāvetīti' ",
  "ps3.10:17.8": "bhāvanāsampanno, ",
  "ps3.10:17.9": "‘avijjaṃ pajahanto ñāṇaṃ bhāvetīti' ",
  "ps3.10:17.10": "bhāvanāsampanno, ",
  "ps3.10:17.11": "‘aratiṃ pajahanto pāmojjaṃ bhāvetīti' ",
  "ps3.10:17.12": "bhāvanāsampanno, ‘nīvaraṇaṃ ",
  "ps3.10:17.13": "pajahanto paṭhamajjhānaṃ bhāvetīti' ",
  "ps3.10:17.14": "bhāvanāsampanno . . . pe . . . ",
  "ps3.10:17.15": "‘sabbakilese pajahanto Arahattamaggaṃ bhāvetīti' ",
  "ps3.10:17.16": "bhāvanāsampanno, ",
  "ps3.10:17.17": "‘Arahattamaggavasena cittaṃ adhiṭṭhātīti' ",
  "ps3.10:17.18": "adhiṭṭhānasampanno, ",
  "ps3.10:17.19": "‘svāyaṃ evaṃ bhāvanāsampanno adhiṭṭhānasampanno samaṃ jīvati no visamaṃ, ",
  "ps3.10:17.20": "sammā jīvati no micchā, ",
  "ps3.10:17.21": "visuddhaṃ jīvati no kiliṭṭhan' ti ",
  "ps3.10:17.22": "ājīvasampanno. ",
  "ps3.10:17.23": "Svāyaṃ evaṃ bhāvanāsampanno adhiṭṭhānasampanno ājīvasampanno yañ ñad eva parisaṃ upasaṅkamati, ",
  "ps3.10:17.24": "yadi khattiyaparisaṃ yadi brāhmaṇaparisaṃ yadi gahapatiparisaṃ yadi samaṇaparisaṃ, ",
  "ps3.10:17.25": "visārado upasaṅkamati amaṅkubhūto. ",
  "ps3.10:17.26": "Tam kissa hetu? ",
  "ps3.10:17.27": "Tathā hi so bhāvanāsampanno adhiṭṭhānasampanno ājīvasampanno ti. ",
  "ps3.10:17.28": "Matikakathā niṭṭhitā. Tatr' uddānaṃ bhavati: Ñāṇaṃ diṭṭhi ānāpānaṃ indriyaṃ vimokkhapañcamaṃ gatikammaṃ vipallāso maggo maṇḍo ti te ",
  "ps3.10:17.29": "",
  "ps3.10:17.30": "dasa, yuganadhasaccabojjhaṅgā mettā virāgapañcamā paṭisambhidā dhammacakkaṃ lokuttarabalasuññato, ",
  "ps3.10:18.1": "paññā iddhi abhisamayo ",
  "ps3.10:18.2": "viveko cariyapañcamo ",
  "ps3.10:18.3": "pātihāriyañ ",
  "ps3.10:18.4": "",
  "ps3.10:18.5": "",
  "ps3.10:18.6": "ca samasīsañ ",
  "ps3.10:19.1": "",
  "ps3.10:19.2": "ca sati ",
  "ps3.10:19.3": "vipassanamātikā ",
  "ps3.10:19.4": "",
  "ps3.10:20.1": "",
  "ps3.10:20.2": "ti. ",
  "ps3.10:20.3": "",
  "ps3.10:20.4": "Paṭisambhidāpakaraṇaṃ ",
  "ps3.10:20.5": "",
  "ps3.10:20.6": "samattaṃ. ",
  "ps3.10:20.7": ""
}
