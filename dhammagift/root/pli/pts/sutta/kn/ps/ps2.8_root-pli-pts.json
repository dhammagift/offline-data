  "ps2.8:1.1": "KATAME dhammā lokuttarā? ",
  "ps2.8:1.2": "Cattāro satipaṭṭhānā, cattāro sammappadhānā, cattāro iddhipādā, pañc' indriyāni, pañca balāni, satta bojjhaṅgā, aṭṭhaṅgiko maggo, cattāro ariyamaggā, cattāri ca sāmaññaphalāni, nibbānañ ca; ",
  "ps2.8:1.3": "ime dhammā lokuttarā. ",
  "ps2.8:2.1": "‘Lokuttarā' ti. Ken' aṭṭhena lokuttarā? ",
  "ps2.8:2.2": "‘Lokaṃ tarantīti' lokuttarā, ",
  "ps2.8:2.3": "‘lokā uttarantīti' lokuttarā, ",
  "ps2.8:2.4": "‘lokato uttarantīti' lokuttarā, ",
  "ps2.8:2.5": "‘lokamhā uttarantīti' lokuttarā; ",
  "ps2.8:2.6": "‘lokaṃ atikkamantīti' lokuttarā, ",
  "ps2.8:2.7": "‘lokaṃ samatikkamantīti' lokuttarā, ",
  "ps2.8:2.8": "‘lokaṃ samatikkantā' ti lokuttarā, ",
  "ps2.8:2.9": "‘loke atirekā' ti lokuttarā; ",
  "ps2.8:2.10": "‘lokantaṃ tarantīti' lokuttarā, ",
  "ps2.8:2.11": "‘lokā nissarantīti' lokuttarā, ",
  "ps2.8:2.12": "‘lokato nissarantīti' lokuttarā, ",
  "ps2.8:2.13": "‘lokamhā nissarantīti' lokuttarā; ",
  "ps2.8:2.14": "‘lokā nissaṭā' ti lokuttarā, ",
  "ps2.8:2.15": "‘lokena nissaṭā' lokuttarā, ",
  "ps2.8:2.16": "‘lokamhā nissaṭā' ti lokuttarā; ",
  "ps2.8:2.17": "‘loke na tiṭṭhantīti' lokuttarā, ",
  "ps2.8:2.18": "‘lokamhi na tiṭṭhantīti' lokuttarā, ",
  "ps2.8:2.19": "‘loke na limpantīti' lokuttarā, ",
  "ps2.8:2.20": "‘lokena na limpantīti' lokuttarā, ",
  "ps2.8:2.21": "‘loke asaṅkilittā' ti lokuttarā, ",
  "ps2.8:2.22": "‘lokena asaṅkilittā' ti lokuttarā, ",
  "ps2.8:2.23": "‘loke anupalittā' ti lokuttarā, ",
  "ps2.8:2.24": "‘lokena anupalittā' ti lokuttarā; ",
  "ps2.8:2.25": "‘loke vippamuttā' ti lokuttarā, ",
  "ps2.8:2.26": "‘lokena vippamuttā' ti lokuttarā, ",
  "ps2.8:2.27": "‘lokā vippamuttā' ti lokuttarā, ",
  "ps2.8:2.28": "‘lokato vippamuttā' ti lokuttarā, ",
  "ps2.8:2.29": "‘lokamhā vippamuttā' ti lokuttarā; ",
  "ps2.8:2.30": "‘loke visaññuttā' ti lokuttarā, ",
  "ps2.8:2.31": "‘lokena visaññuttā' ti lokuttarā, ",
  "ps2.8:2.32": "‘lokā ",
  "ps2.8:2.33": "visaññuttā' ti lokuttarā, ",
  "ps2.8:2.34": "‘lokato visaññuttā' ti lokuttarā, ",
  "ps2.8:2.35": "‘lokamhā visaññuttā' ti lokuttarā; ",
  "ps2.8:2.36": "‘lokā sujjhantīti' lokuttarā, ",
  "ps2.8:2.37": "‘lokato sujjhantīti' lokuttarā, ",
  "ps2.8:2.38": "‘lokamhā sujjhantīti' lokuttarā; ",
  "ps2.8:2.39": "‘lokā visujjhantīti' lokuttarā, ",
  "ps2.8:2.40": "‘lokato visujjhantīti' lokuttarā, ",
  "ps2.8:2.41": "‘lokamhā visujjhantīti' lokuttarā; ",
  "ps2.8:2.42": "‘lokā vuṭṭhahantīti' lokuttarā, ",
  "ps2.8:2.43": "‘lokato vuṭṭhahantīti' lokuttarā, ",
  "ps2.8:2.44": "‘lokamhā vuṭṭhahantīti' lokuttarā; ",
  "ps2.8:2.45": "‘lokā vivaṭṭantīti' lokuttarā, ",
  "ps2.8:2.46": "‘lokato vivaṭṭantīti' lokuttarā, ",
  "ps2.8:2.47": "‘lokamhā vivaṭṭantīti' lokuttarā; ",
  "ps2.8:2.48": "‘loke na sajjantīti' lokuttarā, ",
  "ps2.8:2.49": "‘loke na gayhantīti' lokuttarā, ",
  "ps2.8:2.50": "‘loke na bajjhantīti' lokuttarā; ",
  "ps2.8:2.51": "‘lokaṃ samucchindantīti' lokuttarā, ",
  "ps2.8:2.52": "‘lokaṃ samucchinnattā' ti lokuttarā; ",
  "ps2.8:2.53": "‘lokaṃ paṭipassambhentīti' lokuttarā, ",
  "ps2.8:2.54": "‘lokaṃ paṭipassambhitattā' ti lokuttarā; ",
  "ps2.8:2.55": "‘lokassa atītā' ti lokuttarā, ",
  "ps2.8:2.56": "‘lokassa agatīti' lokuttarā, ",
  "ps2.8:2.57": "‘lokassa avisayā' ti lokuttarā, ",
  "ps2.8:2.58": "‘lokassa asādhāraṇā' ti lokuttarā; ",
  "ps2.8:2.59": "‘lokaṃ vamantīti' lokuttarā, ",
  "ps2.8:2.60": "‘lokaṃ na paccāgamantīti' lokuttarā, ",
  "ps2.8:2.61": "‘lokaṃ pajahantīti' lokuttarā, ",
  "ps2.8:2.62": "‘lokaṃ na upādiyantīti' lokuttarā, ",
  "ps2.8:2.63": "‘lokaṃ visinentīti' lokuttarā, ",
  "ps2.8:2.64": "‘lokaṃ na ussinentīti' lokuttarā, ",
  "ps2.8:2.65": "‘lokaṃ vidhūpentīti' lokuttarā, ",
  "ps2.8:2.66": "‘lokaṃ na sandhūpentīti' lokuttarā, ",
  "ps2.8:2.67": "‘lokaṃ samatikkamma abhibhuyya tiṭṭhantīti' lokuttarā ti. Lokuttarakathā. Paṭis_II,IX.1: PAÑC' imāni ",
  "ps2.8:2.68": ""
}
