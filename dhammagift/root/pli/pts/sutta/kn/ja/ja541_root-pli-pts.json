  "ja541:1.1": "Accheraṃ vata lokasmiṃ ",
  "ja541:1.2": "uppajjanti vicakkhaṇā ",
  "ja541:1.3": "yadā ahū Nimīrājā ",
  "ja541:1.4": "paṇḍito kusalatthiko. ",
  "ja541:2.1": "Rājā sabba-Videhānaṃ ",
  "ja541:2.2": "adā dānaṃ arindamo, ",
  "ja541:2.3": "tassa taṃ dadato dānaṃ ",
  "ja541:2.4": "saṃkappo udapajjatha: ",
  "ja541:2.5": "dānaṃ vā brahmacariyaṃ vā ",
  "ja541:2.6": "katamaṃ su mahapphalanti. ",
  "ja541:3.1": "Tassa saṃkappam aññāya ",
  "ja541:3.2": "Maghavā devakuñjaro ",
  "ja541:3.3": "sahassanetto pātur ahu ",
  "ja541:3.4": "vaṇṇena nihanaṃ tamaṃ. ",
  "ja541:4.1": "Salomahaṭṭho manujindo ",
  "ja541:4.2": "Vāsavaṃ avacā Nimi: ",
  "ja541:4.3": "devatā nu si gandhabbo ",
  "ja541:4.4": "ādu Sakko purindado, ",
  "ja541:5.1": "na ca me tādiso vaṇṇo ",
  "ja541:5.2": "diṭṭho vā yadivā suto. ",
  "ja541:5.3": "",
  "ja541:5.4": "",
  "ja541:6.1": "Salomahaṭṭhaṃ ñatvāna ",
  "ja541:6.2": "Vāsavo avacā Nimiṃ: ",
  "ja541:6.3": "Sakko 'ham asmi devindo, ",
  "ja541:6.4": "āgato 'smi tav' antike, ",
  "ja541:6.5": "alomahaṭṭho manujinda ",
  "ja541:6.6": "puccha pañhaṃ yad icchasi. ",
  "ja541:7.1": "So ca tena katokāso ",
  "ja541:7.2": "Vāsavaṃ avacā Nimi: ",
  "ja541:7.3": "pucchāmi taṃ mahābāhu ",
  "ja541:7.4": "sabbabhūtānam issara: ",
  "ja541:7.5": "dānaṃ vā brahmacariyaṃ vā ",
  "ja541:7.6": "katamaṃ su mahapphalaṃ. ",
  "ja541:8.1": "So puṭṭho naradevena ",
  "ja541:8.2": "Vāsavo avacā Nimiṃ, ",
  "ja541:8.3": "vipākaṃ brahmacariyassa ",
  "ja541:8.4": "jānaṃ akkhās' ajānato: ",
  "ja541:9.1": "Hīnena brahmacariyena ",
  "ja541:9.2": "khattiye upapajjati ",
  "ja541:9.3": "majjhimena ca devattaṃ ",
  "ja541:9.4": "uttamena visujjhati. ",
  "ja541:10.1": "Na h' ete sulabhā kāyā ",
  "ja541:10.2": "yācayogena kenaci ",
  "ja541:10.3": "ye kāye upapajjanti ",
  "ja541:10.4": "anāgārā tapassinoti. ",
  "ja541:11.1": "Dudīpo Sāgaro Selo ",
  "ja541:11.2": "Mucalindo Bhagīraso ",
  "ja541:11.3": "Usīnaro Aṭṭhako ca ",
  "ja541:11.4": "Assako ca Puthujjano. ",
  "ja541:12.1": "Ete c' aññe ca rājāno ",
  "ja541:12.2": "khattiyā brāhmaṇā bahū ",
  "ja541:12.3": "puthuyaññaṃ yajitvāna ",
  "ja541:12.4": "Petan te nātivattisunti. ",
  "ja541:13.1": "",
  "ja541:14.1": "Addhā ime avattiṃsu ",
  "ja541:14.2": "anāgārā tapassino ",
  "ja541:14.3": "satt' isayo Yāmahanu ",
  "ja541:14.4": "Somayāgo Manojavo. ",
  "ja541:15.1": "Samuddo Māgho Bharato [ca] ",
  "ja541:15.2": "isi Kālikarakkhiyo ",
  "ja541:15.3": "Aṅgīraso Kassapo ca ",
  "ja541:15.4": "Kisavaccho Akitti cāti. ",
  "ja541:16.1": "Uttarena nadī Sīdā ",
  "ja541:16.2": "gambhīrā duratikkamā, ",
  "ja541:16.3": "naḷaggivaṇṇā jotanti ",
  "ja541:16.4": "sadā kañcanapabbatā ",
  "ja541:17.1": "Parūḷhakacchā tagarā ",
  "ja541:17.2": "rūḷhakacchā vanā nagā, ",
  "ja541:17.3": "tatrāsuṃ dasasahassā ",
  "ja541:17.4": "porāṇaisayo pure. ",
  "ja541:18.1": "Ahaṃ seṭṭho 'smi dānena ",
  "ja541:18.2": "saṃyamena damena ca ",
  "ja541:18.3": "anuttaraṃ vataṃ katvā ",
  "ja541:18.4": "pakiracārī samāhite. ",
  "ja541:19.1": "Jātivantaṃ ajaccañ ca ",
  "ja541:19.2": "aham ujjugataṃ naraṃ ",
  "ja541:19.3": "ativelaṃ namassissaṃ ",
  "ja541:19.4": "kammabandhū hi mātiyā. ",
  "ja541:20.1": "Sabbe vaṇṇā adhammaṭṭhā ",
  "ja541:20.2": "patanti nirayaṃ adho, ",
  "ja541:20.3": "sabbe vaṇṇā visujjhanti ",
  "ja541:20.4": "caritvā dhammam uttamanti. ",
  "ja541:21.1": "Idaṃ vatvāna Maghavā ",
  "ja541:21.2": "devarājā Sujampati ",
  "ja541:21.3": "Vedehaṃ anusāsetvā ",
  "ja541:21.4": "saggakāyaṃ apakkamīti. ",
  "ja541:22.1": "Imaṃ bhonto nisāmetha ",
  "ja541:22.2": "yāvant' ettha samāgatā ",
  "ja541:22.3": "dhammikānaṃ manussānaṃ ",
  "ja541:22.4": "vaṇṇaṃ uccāvacaṃ bahuṃ. ",
  "ja541:23.1": "Yathā ayaṃ Nimirājā ",
  "ja541:23.2": "paṇḍito kusalatthiko ",
  "ja541:23.3": "rājā sabba-Videhānaṃ ",
  "ja541:23.4": "adā dānaṃ arindamo ",
  "ja541:24.1": "Tassa taṃ dadato dānaṃ ",
  "ja541:24.2": "saṃkappo upapajjatha: ",
  "ja541:24.3": "dānaṃ vā brahmacariyaṃ vā ",
  "ja541:24.4": "katamaṃ su mahappalanti. ",
  "ja541:25.1": "Abbhuto vata lokasmiṃ ",
  "ja541:25.2": "uppajji lomahaṃsano, ",
  "ja541:25.3": "dibbo ratho pātur ahu ",
  "ja541:25.4": "Vedehassa yasassinoti. ",
  "ja541:26.1": "Devaputto mahiddhiko ",
  "ja541:26.2": "Mātali devasārathi ",
  "ja541:26.3": "nimantayittha rājānaṃ ",
  "ja541:26.4": "Vedehaṃ Mithilaggahaṃ: ",
  "ja541:27.1": "Eh' imaṃ ratham āruyha ",
  "ja541:27.2": "rājaseṭṭha disampati, ",
  "ja541:27.3": "devā dassanakāmā te ",
  "ja541:27.4": "Tāvatiṃsā saindakā, ",
  "ja541:27.5": "saramānā hi te devā ",
  "ja541:27.6": "Sudhammāyaṃ samacchareti. ",
  "ja541:28.1": "Tato [ca] rājā taramāno ",
  "ja541:28.2": "Vedeho Mithilaggaho ",
  "ja541:28.3": "āsanā vuṭṭhahitvāna ",
  "ja541:28.4": "pamukho ratham āruhi. ",
  "ja541:29.1": "Abhirūḷhaṃ rathaṃ dibbaṃ ",
  "ja541:29.2": "Mātali etad abravi: ",
  "ja541:29.3": "kena taṃ nemi maggena ",
  "ja541:29.4": "rājaseṭṭha disampati ",
  "ja541:29.5": "yena vā pāpakammantā ",
  "ja541:29.6": "puññakammā ca ye narāti. ",
  "ja541:30.1": "Ubhayen' eva maṃ nehi ",
  "ja541:30.2": "Mātali devasārathi ",
  "ja541:30.3": "yena vā pāpakammantā ",
  "ja541:30.4": "puññakammā ca ye narāti. ",
  "ja541:31.1": "Kena taṃ paṭhamaṃ nemi ",
  "ja541:31.2": "rājaseṭṭha disampati ",
  "ja541:31.3": "yena vā pāpakammantā ",
  "ja541:31.4": "puññakammā ca ye narāti. ",
  "ja541:32.1": "Niraye tāva passāmi ",
  "ja541:32.2": "āvāse pāpakamminaṃ ",
  "ja541:32.3": "ṭhānāni luddakammānaṃ ",
  "ja541:32.4": "dussīlānañ ca yā gatīti. ",
  "ja541:33.1": "Dassesi Mātali rañño ",
  "ja541:33.2": "duggaṃ Vetaraṇiṃ nadiṃ ",
  "ja541:33.3": "kuthantiṃ khārasaṃyuttaṃ ",
  "ja541:33.4": "tattaṃ aggisikhūpamanti. ",
  "ja541:34.1": "Nimi have Mātalim ajjhabhāsatha ",
  "ja541:34.2": "disvā janaṃ patamānaṃ vidugge, ",
  "ja541:34.3": "",
  "ja541:34.4": "",
  "ja541:34.5": "",
  "ja541:34.6": "",
  "ja541:35.1": "Tassa puṭṭho vyākāsi ",
  "ja541:35.2": "Mātali devasārathi, ",
  "ja541:35.3": "vipākaṃ pāpakammānaṃ ",
  "ja541:35.4": "jānaṃ akkhās' ajānato: ",
  "ja541:36.1": "Ye dubbale balavanto jīvaloke ",
  "ja541:36.2": "hiṃsanti rosenti supāpadhammā ",
  "ja541:36.3": "te luddakammā pasavetvā pāpaṃ ",
  "ja541:36.4": "te 'me janā Vetaraṇiṃ patantīti. ",
  "ja541:37.1": "Sāmā ca soṇā sabalā ca gijjhā ",
  "ja541:37.2": "kākolasaṃghā ca adenti bheravā, ",
  "ja541:37.3": "bhayam hi maṃ vindati sūta disvā, ",
  "ja541:37.4": "pucchāmi taṃ Mātali devasārathi: ",
  "ja541:37.5": "ime nu maccā kim akaṃsu pāpam ",
  "ja541:37.6": "yay-ime jane kākolā adenti. ",
  "ja541:38.1": "Tassa puṭṭho vyākāsi ",
  "ja541:38.2": "Mātali devasārathi, ",
  "ja541:38.3": "vipākaṃ pāpakammānaṃ ",
  "ja541:38.4": "jānaṃ akkhās' ajānato: ",
  "ja541:39.1": "Ye kec' ime maccharino kadariyā ",
  "ja541:39.2": "paribhāsakā samaṇabrāhmaṇānaṃ ",
  "ja541:39.3": "hiṃsanti rosenti supāpadhammā ",
  "ja541:39.4": "te luddakammā pasavetvā pāpaṃ ",
  "ja541:39.5": "tay-ime jane kākolā adentīti. ",
  "ja541:40.1": "Sajotibhūtā paṭhaviṃ kamanti, ",
  "ja541:40.2": "tattehi khandhehi ca pothayanti, ",
  "ja541:40.3": "bhayaṃ hi maṃ vindati sūta disvā, ",
  "ja541:40.4": "pucchāmi taṃ Mātali devasārathi: ",
  "ja541:40.5": "ime nu maccā kim akaṃsu pāpaṃ ",
  "ja541:40.6": "ye 'me janā khandhahatā sayanti. ",
  "ja541:41.1": "Tassa puṭṭho vyākāsi ",
  "ja541:41.2": "Mātali devasārathi, ",
  "ja541:41.3": "vipākaṃ pāpakammānaṃ ",
  "ja541:41.4": "jānaṃ akkhās' ajānato: ",
  "ja541:42.1": "Ye jīvalokasmiṃ supāpadhammino ",
  "ja541:42.2": "narañ ca nāriñ ca apāpadhammaṃ ",
  "ja541:42.3": "hiṃsanti rosenti supāpadhammā ",
  "ja541:42.4": "te luddakammā pasavetvā pāpaṃ ",
  "ja541:42.5": "te 'me janā khandhahatā sayantīti. ",
  "ja541:43.1": "Aṅgārakāsuṃ apare phunanti ",
  "ja541:43.2": "narā rudantā paridaḍḍhagattā, ",
  "ja541:43.3": "",
  "ja541:43.4": "",
  "ja541:43.5": "",
  "ja541:43.6": "",
  "ja541:44.1": "Tassa puṭṭho vyākāsi ",
  "ja541:44.2": "Mātali devasārathi, ",
  "ja541:44.3": "vipākaṃ pāpakammānaṃ ",
  "ja541:44.4": "jānaṃ akkhās' ajānato: ",
  "ja541:45.1": "Ye keci pūgāyatanassa hetu ",
  "ja541:45.2": "sakkhiṃ karitvā iṇaṃ jāpayanti ",
  "ja541:45.3": "te jāpayitvā janataṃ janinda ",
  "ja541:45.4": "te luddakammā pasavetva pāpaṃ ",
  "ja541:45.5": "te 'me janā aṃgārakāsuṃ phunantīti. ",
  "ja541:46.1": "Sajotibhūtā jalitā padittā ",
  "ja541:46.2": "padissatī mahatī lohakumbhī, ",
  "ja541:46.3": "bhayaṃ hi maṃ vindati sūta disvā, ",
  "ja541:46.4": "pucchāmi taṃ Mātali devasārathi: ",
  "ja541:46.5": "ime nu maccā kim akaṃsu pāpaṃ ",
  "ja541:46.6": "ye 'me janā [avaṃsirā] lohakumbhiṃ patanti. ",
  "ja541:47.1": "Tassa puṭṭho vyākāsi ",
  "ja541:47.2": "Mātali devasārathi, ",
  "ja541:47.3": "vipākaṃ pāpakammānaṃ ",
  "ja541:47.4": "jānaṃ akkhās' ajānato: ",
  "ja541:48.1": "Ye sīlavaṃ samaṇaṃ brāhmaṇaṃ vā ",
  "ja541:48.2": "hiṃsanti rosenti supāpadhammino ",
  "ja541:48.3": "te luddakammā pasavetvā pāpaṃ ",
  "ja541:48.4": "te 'me janā [avaṃsirā] lohakumbhiṃ patantīti. ",
  "ja541:49.1": "Luñcanti gīvaṃ atha veṭhayitvā ",
  "ja541:49.2": "uṇhodakasmiṃ pakiledayitvā, ",
  "ja541:49.3": "bhayaṃ hi maṃ vindati sūta disvā, ",
  "ja541:49.4": "pucchāmi taṃ Mātali devasārathi : ",
  "ja541:49.5": "ime nu maccā kim akaṃsu pāpaṃ ",
  "ja541:49.6": "ye 'me janā luttasirā sayanti. ",
  "ja541:50.1": "Tassa puṭṭho vyākāsi ",
  "ja541:50.2": "Mātali devasārathi, ",
  "ja541:50.3": "vipākaṃ pāpakammānaṃ ",
  "ja541:50.4": "jānaṃ akkhās' ajānato: ",
  "ja541:51.1": "Ye jīvalokasmiṃ supāpadhammino ",
  "ja541:51.2": "pakkhī gahetvāna viheṭhayanti te ",
  "ja541:51.3": "heṭhayitvā janataṃ janinda ",
  "ja541:51.4": "te luddakammā pasavetvā pāpaṃ ",
  "ja541:51.5": "te 'me janā luttasirā sayantīti. ",
  "ja541:52.1": "Pahūtatoyā anikhātakūlā ",
  "ja541:52.2": "nadī ayaṃ sandati suppatitthā, ",
  "ja541:52.3": "ghammābhitattā manujā pivanti ",
  "ja541:52.4": "pivatañ ca tesaṃ bhusaṃ hoti pāni. ",
  "ja541:53.1": "Bhayaṃ hi maṃ vindati sūta disvā, ",
  "ja541:53.2": "pucchāmi taṃ Mātali devasārathi: ",
  "ja541:53.3": "ime nu maccā kim akaṃsu pāpaṃ ",
  "ja541:53.4": "pivatañ ca tesaṃ bhusaṃ hoti pāni. ",
  "ja541:54.1": "Tassa puṭṭho vyākāsi ",
  "ja541:54.2": "Mātali devasārathi, ",
  "ja541:54.3": "vipākaṃ pāpakammānaṃ ",
  "ja541:54.4": "jānaṃ akkhāss' ajānato: ",
  "ja541:55.1": "Ye suddhadhaññaṃ palāpena missaṃ ",
  "ja541:55.2": "asuddhakammā kayino dadanti ",
  "ja541:55.3": "ghammābhitattānaṃ pipāsitānaṃ ",
  "ja541:55.4": "pivatañ ca tesaṃ bhusaṃ hoti pānīti. ",
  "ja541:56.1": "Usūhi sattīhi ca tomarehi ",
  "ja541:56.2": "dubhayāni passāni tudanti kandataṃ, ",
  "ja541:56.3": "bhayaṃ hi maṃ vindati sūta disvā, ",
  "ja541:56.4": "pucchāmi taṃ Mātali devasārathi: ",
  "ja541:56.5": "ime nu maccā kim akaṃsu pāpaṃ ",
  "ja541:56.6": "ye 'me janā sattihatā sayanti. ",
  "ja541:57.1": "Tassa puṭṭho vyākāsi ",
  "ja541:57.2": "Mātali devasārathi, ",
  "ja541:57.3": "vipākaṃ pāpakammānaṃ ",
  "ja541:57.4": "jānaṃ akkhās' ajānato: ",
  "ja541:58.1": "Ye jīvalokasmiṃ asādhukammino ",
  "ja541:58.2": "adinnam ādāya karonti jīvikaṃ ",
  "ja541:58.3": "dhaññaṃ dhanaṃ rajataṃ jātarūpaṃ ",
  "ja541:58.4": "ajeḷakañ cāpi pasuṃ mahīsaṃ ",
  "ja541:58.5": "te luddakammā pasavetva pāpaṃ ",
  "ja541:58.6": "te 'me janā sattihatā sayantīti. ",
  "ja541:59.1": "Gīvāya baddhā kissa ime pun' eke, ",
  "ja541:59.2": "aññe vikattā bilakatā pun' eke, ",
  "ja541:59.3": "bhayaṃ hi maṃ vindati sūta disvā, ",
  "ja541:59.4": "pucchāmi taṃ Mātali devasārathi: ",
  "ja541:59.5": "ime nu maccā kim akaṃsu pāpaṃ ",
  "ja541:59.6": "ye 'me janā bilakatā sayanti. ",
  "ja541:60.1": "Tassa puṭṭho vyākāsi ",
  "ja541:60.2": "Mātali devasārathi, ",
  "ja541:60.3": "vipākaṃ pāpakammānaṃ ",
  "ja541:60.4": "jānaṃ akkhās' ajānato: ",
  "ja541:61.1": "Orabbhikā sūkarikā ca macchikā (V 270|3) ",
  "ja541:61.2": "pasuṃ mahīsañ ca ajeḷakañ ca ",
  "ja541:61.3": "hantvāna sūnesu pasārayiṃsu, ",
  "ja541:61.4": "te luddakammā pasavetva pāpaṃ ",
  "ja541:61.5": "te 'me janā bilakatā sayantīti. ",
  "ja541:62.1": "Rahado ayaṃ muttakarīsapūro ",
  "ja541:62.2": "duggandharūpo asuciṃ pūti vāyati, ",
  "ja541:62.3": "khudāparetā manujā adenti, bhayaṃ ",
  "ja541:62.4": "hi maṃ vindati sūta disvā, ",
  "ja541:62.5": "pucchāmi taṃ Mātali devasārathi: ",
  "ja541:62.6": "ime nu maccā kim akaṃsu pāpaṃ ",
  "ja541:62.7": "ye 'me janā muttakarīsabhakkhā. ",
  "ja541:63.1": "Tassa puṭṭho vyākāsi ",
  "ja541:63.2": "Mātali devasārathi, ",
  "ja541:63.3": "vipākaṃ pāpakammānaṃ ",
  "ja541:63.4": "jānaṃ akkhās' ajānato: ",
  "ja541:64.1": "Ye kec' ime kāraṇikā virosakā ",
  "ja541:64.2": "paresaṃ hiṃsāya sadā niviṭṭhā ",
  "ja541:64.3": "",
  "ja541:64.4": "",
  "ja541:65.1": "Rahado ayaṃ lohitapubbapūro ",
  "ja541:65.2": "duggandharūpo asuciṃ pūti vāyati, ",
  "ja541:65.3": "ghammābhitattā manujā pivanti, ",
  "ja541:65.4": "bhayaṃ hi maṃ vindati sūta disvā, ",
  "ja541:65.5": "pucchāmi taṃ Mātali devasārathi: ",
  "ja541:65.6": "ime nu maccā kim akaṃsu pāpaṃ ",
  "ja541:65.7": "ye 'me janā lohitapubbabhakkhā. ",
  "ja541:66.1": "Tassa puṭṭho vyākāsi ",
  "ja541:66.2": "Mātali devasārathi, ",
  "ja541:66.3": "vipākaṃ pāpakammānaṃ ",
  "ja541:66.4": "jānaṃ akkhās' ajānato: ",
  "ja541:67.1": "Ye mātaraṃ vā pitaraṃ va loke ",
  "ja541:67.2": "pārājikā arahante hananti ",
  "ja541:67.3": "te luddakammā pasavetva pāpaṃ ",
  "ja541:67.4": "te 'me janā lohitapubbabhakkhāti. ",
  "ja541:68.1": "Jivhañ ca passa balisena viddhaṃ ",
  "ja541:68.2": "vihataṃ yathā saṃkusatena cammaṃ, ",
  "ja541:68.3": "Bhayaṃ ",
  "ja541:68.4": "hi ",
  "ja541:69.1": "maṃ vindati sūta disvā, ",
  "ja541:69.2": "pucchāmi taṃ Mātali devasārathi: ",
  "ja541:69.3": "ime nu maccā kim akaṃsu pāpaṃ ",
  "ja541:69.4": "ye 'me janā vaṃkaghastā sayanti. ",
  "ja541:70.1": "Tassa puṭṭho vyākāsi ",
  "ja541:70.2": "Mātali devasārathi, ",
  "ja541:70.3": "vipākaṃ pāpakammānaṃ ",
  "ja541:70.4": "jānaṃ akkhās' ajānato: ",
  "ja541:71.1": "Ye keci saṇṭhānagatā manussā ",
  "ja541:71.2": "agghena agghaṃ kayaṃ hāpayanti ",
  "ja541:71.3": "kūṭena kūṭaṃ dhanalobhahetu ",
  "ja541:71.4": "channaṃ yathā vāricaraṃ vadhāya. ",
  "ja541:72.1": "Na hi kūṭakārissa bhavanti tāṇā ",
  "ja541:72.2": "sakehi kammehi purakkhatassa ",
  "ja541:72.3": "te luddakammā pasavetva pāpaṃ ",
  "ja541:72.4": "te 'me janā vaṃkaghastā sayantīti. ",
  "ja541:73.1": "Nariyo imā samparibhinnagattā ",
  "ja541:73.2": "paggayha kandanti bhujo dujaccā ",
  "ja541:73.3": "sammakkhitā lohitapubbalittā ",
  "ja541:73.4": "gāvo yathā āghātane vikattā ",
  "ja541:73.5": "tā bhūmibhāgasmiṃ sadā nikhātā ",
  "ja541:73.6": "khandhātivattanti sajotibhūtā. ",
  "ja541:74.1": "Bhayaṃ hi maṃ vindati sūtā disvā, ",
  "ja541:74.2": "pucchāmi taṃ Mātali devasārathi: ",
  "ja541:74.3": "imā nu nariyo kim akaṃsu pāpaṃ ",
  "ja541:74.4": "yā bhūmibhāgasmiṃ sadā nikhātā ",
  "ja541:74.5": "khandhātivattanti sajotibhūtā. ",
  "ja541:75.1": "Tassa puṭṭho vyākāsi ",
  "ja541:75.2": "Mātali devasārathi, ",
  "ja541:75.3": "vipākaṃ pāpakammānaṃ ",
  "ja541:75.4": "jānaṃ akkhās' ajānato: ",
  "ja541:76.1": "Kolīniyāyo idha jīvaloke ",
  "ja541:76.2": "asuddhakammā asataṃ acāruṃ, ",
  "ja541:76.3": "tā dittarūpā pati vippahāya ",
  "ja541:76.4": "aññaṃ acāruṃ ratikhiḍḍahetu, ",
  "ja541:76.5": "tā jīvalokasmiṃ ramāpayitvā ",
  "ja541:76.6": "khandhātivattanti sajotibhūtāti. ",
  "ja541:77.1": "Pāde gahetvā kissa ime pun' eke ",
  "ja541:77.2": "avaṃsirā Narake pātayanti, ",
  "ja541:77.3": "bhayaṃ hi maṃ vindati sūta disvā, ",
  "ja541:77.4": "pucchāmi taṃ Mātali devasārathi: ",
  "ja541:77.5": "",
  "ja541:77.6": "",
  "ja541:78.1": "Tassa puṭṭho vyākāsi ",
  "ja541:78.2": "Mātali devasārathi, ",
  "ja541:78.3": "vipākaṃ pāpakammānaṃ ",
  "ja541:78.4": "jānaṃ akkhās' ajānato: ",
  "ja541:79.1": "Ye jīvalokasmiṃ asādhukammino ",
  "ja541:79.2": "parassa dārāni atikkamanti ",
  "ja541:79.3": "te tādisā uttamabhaṇḍathenā ",
  "ja541:79.4": "te 'me janā [avaṃsirā] Narake pātayanti. ",
  "ja541:80.1": "Te vassapūgāni bahūni tattha ",
  "ja541:80.2": "Niraye dukkhaṃ vedanaṃ vediyanti, ",
  "ja541:80.3": "na hi pāpakārissa bhavanti tāṇā ",
  "ja541:80.4": "sakehi kammehi purakkhatassa, ",
  "ja541:80.5": "te luddakammā pasavetva pāpaṃ ",
  "ja541:80.6": "te 'me janā [avaṃsirā] Narake pātayantīti. ",
  "ja541:81.1": "Uccāvacā 'me vividhā upakkamā ",
  "ja541:81.2": "nirayesu dissanti sughorarūpā, ",
  "ja541:81.3": "bhayaṃ hi maṃ vindati sūta disvā, ",
  "ja541:81.4": "pucchāmi taṃ Mātali devasārathi: ",
  "ja541:81.5": "ime nu maccā kim akaṃsu pāpaṃ ",
  "ja541:81.6": "ye 'me janā adhimattā dukkhā tibbā ",
  "ja541:81.7": "kharā kaṭukā vedanā vediyanti. ",
  "ja541:82.1": "Tassā puṭṭho vyākāsi ",
  "ja541:82.2": "Mātali devasārathi, ",
  "ja541:82.3": "vipākaṃ pāpakammānaṃ ",
  "ja541:82.4": "jānaṃ akkhās' ajānato: ",
  "ja541:83.1": "Ye jīvalokasmiṃ supāpadiṭṭhino ",
  "ja541:83.2": "vissāsakammāni karonti mohā ",
  "ja541:83.3": "parañ ca diṭṭhīsu samādapenti ",
  "ja541:83.4": "",
  "ja541:83.5": "",
  "ja541:83.6": "",
  "ja541:84.1": "Viditāni te mahārāja ",
  "ja541:84.2": "āvāsaṃ pāpakamminaṃ ",
  "ja541:84.3": "ṭhānāni luddakammānaṃ ",
  "ja541:84.4": "dussīlānañ ca yā gati, ",
  "ja541:84.5": "uyyāhi dāni rājīsi ",
  "ja541:84.6": "devarājassa santiketi. ",
  "ja541:85.1": "",
  "ja541:86.1": "Pañcaṭhūpaṃ dissat' idaṃ vimānaṃ, ",
  "ja541:86.2": "mālāpilandhā sayanassa majjhe ",
  "ja541:86.3": "tatth' acchatī nārī mahānubhāvā ",
  "ja541:86.4": "uccāvacaṃ iddhiṃ vikubbamānā. ",
  "ja541:87.1": "Vittī hi maṃ vindati sūta disvā, ",
  "ja541:87.2": "pucchāmi taṃ Mātali devasārathi: ",
  "ja541:87.3": "ayaṃ nu nārī kim akāsi sādhuṃ, ",
  "ja541:87.4": "sā modatī saggapattā vimāne. ",
  "ja541:88.1": "Tassa puṭṭho vyākāsi ",
  "ja541:88.2": "Mātali devasārathi, ",
  "ja541:88.3": "vipākaṃ puññakammānaṃ ",
  "ja541:88.4": "jānaṃ akkhās' ajānato: ",
  "ja541:89.1": "Yadi te sutā Bīraṇī jīvaloke ",
  "ja541:89.2": "āmāyadāsī ahu brāhmaṇassa, ",
  "ja541:89.3": "sā pattakālaṃ atithiṃ viditvā ",
  "ja541:89.4": "mātā va puttaṃ sakim ābhinandi ",
  "ja541:89.5": "saṃyamā saṃvibhāgā ca ",
  "ja541:89.6": "sā vimānasmi modatīti. ",
  "ja541:90.1": "Daddallamānā ābhenti ",
  "ja541:90.2": "vimānā satta nimmitā, ",
  "ja541:90.3": "tattha yakkho mahiddhiko ",
  "ja541:90.4": "sabbābharaṇabhūsito ",
  "ja541:90.5": "samantā anupariyāti ",
  "ja541:90.6": "nārigaṇapurakkhato. ",
  "ja541:91.1": "Vittī hi maṃ vindati sūta disvā, ",
  "ja541:91.2": "pucchāmi taṃ Mātali devasārathi: ",
  "ja541:91.3": "ayan nu macco kim akāsi sādhuṃ, ",
  "ja541:91.4": "so modatī saggapatto vimāne. ",
  "ja541:92.1": "Tassa puṭṭho vyākāsi ",
  "ja541:92.2": "Mātali devasārathi, ",
  "ja541:92.3": "vipākaṃ puññakammānaṃ ",
  "ja541:92.4": "jānaṃ akkhās' ajānato: ",
  "ja541:93.1": "Soṇadinno gahapati ",
  "ja541:93.2": "esa dānapatī ahu, ",
  "ja541:93.3": "esa pabbajit' uddissa ",
  "ja541:93.4": "vihāre satta kārayi. ",
  "ja541:94.1": "Sakkaccaṃ ne upaṭṭhāsi ",
  "ja541:94.2": "bhikkhavo tatthavāsike, ",
  "ja541:94.3": "acchādanañ ca bhattañ ca ",
  "ja541:94.4": "senāsanapadīpiyaṃ ",
  "ja541:94.5": "adāsi ujubhūtesu ",
  "ja541:94.6": "vippasannena cetasā. ",
  "ja541:95.1": "Cātuddasiṃ pañcadasiṃ ",
  "ja541:95.2": "yāva pakkhassa aṭṭhamiṃ (IV 320|19) ",
  "ja541:95.3": "pāṭihāriyapakkhañ ca atthaṅgasusamāgataṃ ",
  "ja541:95.4": "Uposathañ ",
  "ja541:96.1": "ca upavasi ",
  "ja541:96.2": "sadā sīlesu saṃvuto, ",
  "ja541:96.3": "saṃyamo saṃvibhāgo ca ",
  "ja541:96.4": "so vimānasmi modatīti. ",
  "ja541:97.1": "Pabhāsati idaṃ vyamhaṃ ",
  "ja541:97.2": "phalikāsu sunimmitaṃ ",
  "ja541:97.3": "nārivaragaṇākiṇṇaṃ ",
  "ja541:97.4": "kūṭāgāravarocitaṃ ",
  "ja541:97.5": "upetaṃ annapānehi ",
  "ja541:97.6": "naccagītehi c' ūbhayaṃ. ",
  "ja541:98.1": "Vittī hi maṃ vindati sūta disvā, ",
  "ja541:98.2": "pucchāmi taṃ Mātali devasārathi: ",
  "ja541:98.3": "imā nu nariyo kim akaṃsu sādhuṃ ",
  "ja541:98.4": "yā modare saggapattā vimāne. ",
  "ja541:99.1": "Tassa puṭṭho vyākāsi ",
  "ja541:99.2": "Mātali devasārathi, ",
  "ja541:99.3": "vipākaṃ puññakammānaṃ ",
  "ja541:99.4": "jānaṃ akkhās' ajānato: ",
  "ja541:100.1": "Yā kāci nariyo idha jīvaloke ",
  "ja541:100.2": "[sīlavatiyo] upāsikā ",
  "ja541:100.3": "[dāne ratā] niccapasannacittā ",
  "ja541:100.4": "sacce ṭhitā uposathe appamattā ",
  "ja541:100.5": "saṃyamā saṃvibhāgā ca ",
  "ja541:100.6": "tā vimānasmi modareti. ",
  "ja541:101.1": "Pabhāsati idaṃ vyamhaṃ ",
  "ja541:101.2": "veḷuriyāsu nimmitaṃ ",
  "ja541:101.3": "upetaṃ bhūmibhāgehi ",
  "ja541:101.4": "vibhattaṃ bhāgaso mitaṃ. ",
  "ja541:102.1": "Ālambarā mutiṅgā ca ",
  "ja541:102.2": "naccagītā suvāditā ",
  "ja541:102.3": "dibbā saddā niccharanti ",
  "ja541:102.4": "savaneyyā manoramā. ",
  "ja541:103.1": "Nāhaṃ evaṃgataṃ jātu ",
  "ja541:103.2": "evaṃsuruciraṃ pure ",
  "ja541:103.3": "saddaṃ samabhijānāmi ",
  "ja541:103.4": "diṭṭhaṃ vā yadivā sutaṃ, ",
  "ja541:104.1": "Vittī hi maṃ vindati sūta disvā, ",
  "ja541:104.2": "pucchāmi taṃ Mātali devasārathi: ",
  "ja541:104.3": "ime nu maccā kim akaṃsu sādhuṃ ",
  "ja541:104.4": "ye modare saggapattā vimāne. ",
  "ja541:105.1": "Tassa puṭṭho vyākāsi ",
  "ja541:105.2": "Mātali devasārathi, ",
  "ja541:105.3": "vipākaṃ puññakammānaṃ ",
  "ja541:105.4": "jānaṃ akkhās' ajānato: ",
  "ja541:106.1": "Ye keci maccā idha jīvaloke ",
  "ja541:106.2": "sīlavanto upāsakā ",
  "ja541:106.3": "ārāme udapāne ca ",
  "ja541:106.4": "papāsaṃkamanāni ca ",
  "ja541:106.5": "Arahante sītibhūte ",
  "ja541:106.6": "sakkaccaṃ paṭipādayuṃ ",
  "ja541:107.1": "cīvaraṃ piṇḍapātañ ca ",
  "ja541:107.2": "paccayaṃ sayanāsanaṃ ",
  "ja541:107.3": "Adaṃsu ujubhūtesu ",
  "ja541:107.4": "vippasannena cetasā ",
  "ja541:108.1": "cātuddasiṃ pañcadasiṃ ",
  "ja541:108.2": "yāva pakkhassa aṭṭhamiṃ ",
  "ja541:108.3": "Pāṭihāriyapakkhañ ca aṭṭhaṅgasusamāgataṃ ",
  "ja541:108.4": "uposathañ ",
  "ja541:109.1": "ca upavasuṃ ",
  "ja541:109.2": "sadā sīlesu saṃvutā, ",
  "ja541:109.3": "saññamā saṃvibhāgā ca ",
  "ja541:109.4": "te vimānasmi modareti. ",
  "ja541:110.1": "Pabhāsati idaṃ vyamhaṃ ",
  "ja541:110.2": "phaḷikāsu sunimmitaṃ ",
  "ja541:110.3": "nārivaragaṇākiṇṇaṃ ",
  "ja541:110.4": "kūṭāgāravarocitaṃ ",
  "ja541:111.1": "Upetaṃ annapānehi ",
  "ja541:111.2": "naccagītehi c' ūbhayaṃ, ",
  "ja541:111.3": "najjo ca anupariyāti ",
  "ja541:111.4": "nānāpupphadumāyutā. ",
  "ja541:112.1": "Vittī hi maṃ vindati sūta disvā, ",
  "ja541:112.2": "pucchāmi taṃ Mātali devasārathi: ",
  "ja541:112.3": "ayan nu macco kim akāsi sādhuṃ ",
  "ja541:112.4": "yo modati saggapatto vimāne. ",
  "ja541:113.1": "Tassa puṭṭho vyākāsi ",
  "ja541:113.2": "Mātali devasārathi, ",
  "ja541:113.3": "vipākaṃ puññakammānaṃ ",
  "ja541:113.4": "jānaṃ akkhās' ajānato: ",
  "ja541:114.1": "Kimbilāyaṃ gahapati ",
  "ja541:114.2": "esa dānapatī ahu, ",
  "ja541:114.3": "ārāme udapāne ca ",
  "ja541:114.4": "papāsaṃkamanāni ca ",
  "ja541:114.5": "Arahante sītibhūte ",
  "ja541:114.6": "sakkaccaṃ paṭipādayi, ",
  "ja541:115.1": "cīvaraṃ piṇḍapātañ ca ",
  "ja541:115.2": "paccayaṃ sayanāsanaṃ ",
  "ja541:115.3": "Adāsi ujubhūtesu ",
  "ja541:115.4": "vippasannena cetasā, ",
  "ja541:116.1": "cātuddasiṃ pañcadasiṃ ",
