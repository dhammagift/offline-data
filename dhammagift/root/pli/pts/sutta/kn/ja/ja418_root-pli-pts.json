  "ja418:0.4": "",
  "ja418:1.1": "Idaṃ pure ninnam āhu ",
  "ja418:1.2": "bahumacchaṃ mahodikaṃ, ",
  "ja418:1.3": "āvāso bakarājassa ",
  "ja418:1.4": "pettikaṃ bhavanaṃ mama, ",
  "ja418:1.5": "ty-ajja bhekena yāpema, ",
  "ja418:1.6": "okaṃ na vijahāmaseti. ",
  "ja418:2.1": "Ko dutiyaṃ asīlassa Bandhurass' ",
  "ja418:2.2": "akkhi bhejjati, ",
  "ja418:2.3": "ko me putte kulāvañ ca ",
  "ja418:2.4": "mañ ca sotthiṃ karissatīti ",
  "ja418:3.1": "Sabbā parikkhatā pheggu ",
  "ja418:3.2": "yāva tassā gati ahu, ",
  "ja418:3.3": "khīṇabhakkho mahārāja ",
  "ja418:3.4": "sāre na ramatī guṇoti. ",
  "ja418:4.1": "Sā nūnāhaṃ ito gantvā ",
  "ja418:4.2": "rañño muttā nivesanā ",
  "ja418:4.3": "attānaṃ ramayissāmi ",
  "ja418:4.4": "dumasākhāniketinīti. ",
  "ja418:5.1": "So nūnāhaṃ ito gantvā ",
  "ja418:5.2": "rañño mutto nivesanā ",
  "ja418:5.3": "aggodakāni pissāmi ",
  "ja418:5.4": "yūthassa purato vajanti. ",
  "ja418:6.1": "Taṃ maṃ kāmehi sampannaṃ ",
  "ja418:6.2": "rattaṃ kāmesu mucchitaṃ ",
  "ja418:6.3": "ānayi Bharato luddo ",
  "ja418:6.4": "bāhiyo, bhaddam atthu teti. ",
  "ja418:7.1": "Andhakāratimissāya ",
  "ja418:7.2": "tuṅge upari pabbate ",
  "ja418:7.3": "sā maṃ saṇhena mudunā ",
  "ja418:7.4": "mā pādaṃ khaṇi-y-asmanīti. ",
  "ja418:8.1": "Asaṃsayaṃ jātikhayantadassī ",
  "ja418:8.2": "na gabbhaseyyaṃ punar āvajissaṃ, ayaṃ hi ",
  "ja418:8.3": "me antimā gabbhaseyyā, ",
  "ja418:8.4": "khīṇo me saṃsāro punabbhavāyāti. ",
  "ja418:9.1": ""
}
