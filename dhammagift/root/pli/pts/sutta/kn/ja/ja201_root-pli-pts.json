  "ja201:1.1": "Na taṃ daḷhaṃ bandhanam āhu dhīrā ",
  "ja201:1.2": "(Dhp. v.345-46.) yad āyasaṃ dārujaṃ pabbajañ ca, ",
  "ja201:1.3": "sārattarattā maṇikuṇḍalesu ",
  "ja201:1.4": "puttesu dāresu ca yā apekhā. ",
  "ja201:2.1": "Etaṃ daḷhaṃ bandhanam āhu dhīrā ",
  "ja201:2.2": "ohārinaṃ sithilaṃ duppamuñcaṃ, ",
  "ja201:2.3": "etam pi chetvāna vajanti dhīrā ",
  "ja201:2.4": "anapekhino kāmasukhaṃ pahāyāti. ",
  "ja201:3.1": ""
}
