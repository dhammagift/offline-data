  "ja457:1.1": "Yasokaro puññakaro 'ham asmi ",
  "ja457:1.2": "sadatthuto samaṇabrāhmaṇānaṃ, ",
  "ja457:1.3": "maggāraho devamanussapūjito ",
  "ja457:1.4": "Dhammo ahaṃ, dehi Adhamma magganti. ",
  "ja457:2.1": "Adhammayānaṃ daḷham āruhitvā ",
  "ja457:2.2": "asantasanto balavāham asmi, ",
  "ja457:2.3": "sa kissa hetumhi tav' ajja dajjaṃ ",
  "ja457:2.4": "maggaṃ ahaṃ Dhamma adinnapubbaṃ. ",
  "ja457:3.1": "Dhammo have pātur ahosi pubbe, (III,29|4.) ",
  "ja457:3.2": "pacchā Adhammo udapādi loke, ",
  "ja457:3.3": "jeṭṭho ca seṭṭho ca sanantano ca, ",
  "ja457:3.4": "uyyāhi jeṭṭhassa kaniṭṭha maggā. ",
  "ja457:4.1": "Na yācanāya na pi pātirūpā ",
  "ja457:4.2": "na arahati vo 'haṃ dadeyya maggaṃ, ",
  "ja457:4.3": "",
  "ja457:4.4": "",
  "ja457:5.1": "Sabbā disā anuvisaṭo 'ham asmi ",
  "ja457:5.2": "mahabbalo amitayaso atullo, ",
  "ja457:5.3": "guṇehi sabbehi upetarūpo ",
  "ja457:5.4": "Dhammo, Adhamma tvaṃ kathaṃ vijessasi. ",
  "ja457:6.1": "Lohena ve haññati jātarūpaṃ, ",
  "ja457:6.2": "na jātarūpena hananti lohaṃ, ",
  "ja457:6.3": "sace Adhammo hañchati Dhammam ajja ",
  "ja457:6.4": "ayo suvaṇṇaṃ viya dassaneyyaṃ. ",
  "ja457:7.1": "Sace tuvaṃ yuddhabalo s' Adhamma ",
  "ja457:7.2": "na tuyha vaddhā ca garū ca atthi, ",
  "ja457:7.3": "maggañ ca te dammi piyāppiyena ",
  "ja457:7.4": "vācāduruttāni pi te khamāmīti ",
  "ja457:8.1": "Idañ ca sutvā vacanaṃ Adhammo ",
  "ja457:8.2": "avaṃsiro patito uddhapādo: ",
  "ja457:8.3": "yuddhatthiko ce na labhāmi yuddhaṃ, ",
  "ja457:8.4": "ettāvatā hoti hato Adhammo. ",
  "ja457:9.1": "Khantībalo yuddhabalaṃ vijetvā ",
  "ja457:9.2": "hantvā Adhammaṃ nihanitva bhumyā ",
  "ja457:9.3": "pāyāsi vitto abhiruyha sandanaṃ ",
  "ja457:9.4": "maggen' eva atibalo saccanikkamo. ",
  "ja457:10.1": "Mātāpitā samaṇabrāhmaṇā ca ",
  "ja457:10.2": "asammānitā yassa sake agāre ",
  "ja457:10.3": "idh' eva nikkhippa sarīradehaṃ ",
  "ja457:10.4": "kāyassa bhedā nirayaṃ vajanti ",
  "ja457:10.5": "yathā Adhammo patito avaṃsiro. ",
  "ja457:11.1": "Mātāpitā samaṇabrāhmaṇā ca ",
  "ja457:11.2": "susammānitā yassa sake agāre ",
  "ja457:11.3": "idh' eva nikkhippa sarīradehaṃ ",
  "ja457:11.4": "kāyassa bhedā sugatiṃ vajanti ",
  "ja457:11.5": "yathāpi Dhammo abhiruyha sandananti. ",
  "ja457:12.1": ""
}
