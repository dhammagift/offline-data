  "ja412:0.4": "",
  "ja412:1.1": "Ahaṃ dasasataṃvyāmaṃ ",
  "ja412:1.2": "uragam ādāya-m-āgato, ",
  "ja412:1.3": "tañ ca mañ ca mahākāyaṃ ",
  "ja412:1.4": "dhārayaṃ na-ppavedhasi. Atha ",
  "ja412:2.1": "imaṃ khuddakaṃ pakkhiṃ ",
  "ja412:2.2": "appamaṃsataraṃ mayā ",
  "ja412:2.3": "dhārayaṃ vyadhase bhīto ",
  "ja412:2.4": "kam atthaṃ koṭisimbalīti. ",
  "ja412:3.1": "Maṃsabhakkho tuvaṃ rāja, ",
  "ja412:3.2": "phalabhakkho ayaṃ dijo, ",
  "ja412:3.3": "ayaṃ nigrodhabījāni ",
  "ja412:3.4": "pilakkhadumbarāni ca ",
  "ja412:3.5": "assatthāni ca bhakkhetvā ",
  "ja412:3.6": "khandhe me odahissati. ",
  "ja412:4.1": "Te rukkhā saṃvirūhanti ",
  "ja412:4.2": "mama passe nivātajā, ",
  "ja412:4.3": "te maṃ pariyonandhissanti, ",
  "ja412:4.4": "arukkham maṃ karissare. ",
  "ja412:5.1": "Santi aññe pi rukkhāse ",
  "ja412:5.2": "mūlino khandhino dumā ",
  "ja412:5.3": "iminā sakuṇajātena ",
  "ja412:5.4": "bījam āharitā hatā. ",
  "ja412:6.1": "Ajjhārūḷhābhivaḍḍhanti ",
  "ja412:6.2": "brahantam pi vanaspatiṃ, ",
  "ja412:6.3": "tasmā rāja pavedhāmi ",
  "ja412:6.4": "sampassaṃ nāgataṃ bhayanti. ",
  "ja412:7.1": "Saṃkeyya saṃkitabbāni ",
  "ja412:7.2": "rakkheyya nāgataṃ bhayaṃ, ",
  "ja412:7.3": "anāgatabhayā dhīro ",
  "ja412:7.4": "ubho loke avekkhatīti. ",
  "ja412:8.1": ""
}
