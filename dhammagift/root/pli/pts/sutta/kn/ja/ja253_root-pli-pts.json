  "ja253:0.4": "",
  "ja253:1.1": "Mam' annapānaṃ vipulaṃ uḷāraṃ ",
  "ja253:1.2": "uppajjatīmassa maṇissa hetu, ",
  "ja253:1.3": "tan te na dassaṃ, atiyācako si, ",
  "ja253:1.4": "na cāpi te assamaṃ āgamissaṃ. ",
  "ja253:2.1": "Susū yathā sakkharadhotapāṇi ",
  "ja253:2.2": "tāses' imaṃ selaṃ yācamāno, ",
  "ja253:2.3": "tan te na dassaṃ, atiyācako si, ",
  "ja253:2.4": "na cāpi te assamaṃ āgamissanti. ",
  "ja253:3.1": "Na taṃ yāce yassa piyaṃ jigiṃse, ",
  "ja253:3.2": "desso hoti atiyācanāya, ",
  "ja253:3.3": "nāgo maṇiṃ yācito brāhmaṇena ",
  "ja253:3.4": "adassanaṃ yeva tad' ajjhagamāti. ",
  "ja253:4.1": ""
}
