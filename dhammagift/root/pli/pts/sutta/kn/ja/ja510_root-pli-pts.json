  "ja510:0.2": "",
  "ja510:0.3": "",
  "ja510:0.4": "",
  "ja510:1.1": "Yam ekarattiṃ paṭhamaṃ ",
  "ja510:1.2": "gabbhe vasati mānavo ",
  "ja510:1.3": "abbh' uṭṭhito va sayati ",
  "ja510:1.4": "sa gacchaṃ na nivattati. ",
  "ja510:2.1": "Na yujjhamānā na balena vassitā ",
  "ja510:2.2": "narā na jīranti na cīpi mīyare, ",
  "ja510:2.3": "sabbaṃ hi taṃ jātijarāy' upaddutaṃ, ",
  "ja510:2.4": "tam me matī hoti: carāmi dhammaṃ. ",
  "ja510:3.1": "Caturaṅginiṃ senaṃ subhiṃsarūpaṃ ",
  "ja510:3.2": "jayanti raṭṭhādhipatī pasayha, ",
  "ja510:3.3": "na maccuno jayituṃ ussahanti, ",
  "ja510:3.4": "tam me etc. ",
  "ja510:4.1": "Hatthīhi assehi rathehi pattihi ",
  "ja510:4.2": "parivāritā muccare ekaceyyā, ",
  "ja510:4.3": "na maccuno muccituṃ ussahanti, ",
  "ja510:4.4": "etc. ",
  "ja510:5.1": "Hatthīhi assehi rathehi pattihi ",
  "ja510:5.2": "sūrā pabhañjanti padhaṃsayanti, ",
  "ja510:5.3": "na maccuno bhuñjituṃ ",
  "ja510:5.4": "ussahanti, etc. ",
  "ja510:6.1": "Mattā gajā bhinnagaḷā pabhinnā ",
  "ja510:6.2": "nagarāni maddanti janaṃ hananti, ",
  "ja510:6.3": "na maccuno maddituṃ ussahanti, ",
  "ja510:6.4": "etc. ",
  "ja510:7.1": "Issāsino katahatthāpi dhīrā ",
  "ja510:7.2": "dūrepātī akkhaṇavedhino pi ",
  "ja510:7.3": "na maccuno vijjhituṃ ussahanti, ",
  "ja510:7.4": "etc. ",
  "ja510:8.1": "Sarāni khīyanti saselakānanā, ",
  "ja510:8.2": "sabbaṃ hi taṃ khīyati dīgham antaraṃ, ",
  "ja510:8.3": "sabbaṃ hi taṃ bhañjare kālapariyāyaṃ, ",
  "ja510:8.4": "etc. Sabbesam evaṃ ",
  "ja510:9.1": "hi narānarīnaṃ ",
  "ja510:9.2": "calācalaṃ pāṇabhuno 'dha jīvitaṃ ",
  "ja510:9.3": "paṭo va dhuttassa dumo va kūlajo, ",
  "ja510:9.4": "etc. ",
  "ja510:10.1": "Dumapphalāneva patanti mānavā ",
  "ja510:10.2": "daharā ca vuddhā ca sarīrabhedā ",
  "ja510:10.3": "nariyo narā majjhimaporisā ca, ",
  "ja510:10.4": "etc. ",
  "ja510:11.1": "Nāyaṃ vayo tārakarājasannibho, ",
  "ja510:11.2": "yad abbhatītaṃ gatam eva dāni taṃ, ",
  "ja510:11.3": "jiṇṇassa hī n' atthi ratī kuto sukhaṃ, ",
  "ja510:11.4": "etc. ",
  "ja510:12.1": "Yakkhā pisācā athavāpi petā ",
  "ja510:12.2": "kupitāpi te assasantī manusse, ",
  "ja510:12.3": "na maccuno assasit' ussahanti, ",
  "ja510:12.4": "etc. ",
  "ja510:13.1": "Yakkhe pisāce athavāpi pete ",
  "ja510:13.2": "kupite pi te nijjhapanaṃ karonti, ",
  "ja510:13.3": "na maccuno nijjhapanaṃ karonti, ",
  "ja510:13.4": "etc. ",
  "ja510:14.1": "Aparādhake dūsake heṭhake ca ",
  "ja510:14.2": "rājāno daṇḍenti viditva dosaṃ, ",
  "ja510:14.3": "na maccuno daṇḍayit' ussahanti, ",
  "ja510:14.4": "etc. ",
  "ja510:15.1": "Aparādhakā dūsakā heṭhakā ca ",
  "ja510:15.2": "labhanti te rājino nijjhapetuṃ, ",
  "ja510:15.3": "na maccuno nijjhapanaṃ karonti, ",
  "ja510:15.4": "etc. ",
  "ja510:16.1": "Na khattiyoti na pi brāhmaṇoti, ",
  "ja510:16.2": "na aḍḍhakā balavā tejavāpi, -- ",
  "ja510:16.3": "na maccurājassa apekha- ",
  "ja510:16.4": "m-atthi, etc. ",
  "ja510:17.1": "Sīhā ca vyagghā ca atho pi dīpiyo ",
  "ja510:17.2": "pasayha khādanti vipphandamānaṃ, ",
  "ja510:17.3": "na maccuno khāditum ussahanti, ",
  "ja510:17.4": "etc. ",
  "ja510:18.1": "Māyākārā raṅgamajjhe karontā ",
  "ja510:18.2": "mohenti cakkhūni janassa tāvade, ",
  "ja510:18.3": "na maccuno mohayit' ussahanti, ",
  "ja510:18.4": "etc. ",
  "ja510:19.1": "Āsīvisā kupitā uggatejā ",
  "ja510:19.2": "ḍasanti mārenti pi te manusse, ",
  "ja510:19.3": "na maccuno ḍasituṃ ",
  "ja510:19.4": "ussahanti, etc. ",
  "ja510:20.1": "Āsīvisā kupitā yaṃ ḍasanti ",
  "ja510:20.2": "tikicchakā tesaṃ visaṃ hananti, ",
  "ja510:20.3": "na maccuno daṭṭhavisaṃ hananti, ",
  "ja510:20.4": "etc. ",
  "ja510:21.1": "Dhammantarī Vetaraṇī ca Bhojo ",
  "ja510:21.2": "visāni hantvāna bhujaṅgamānaṃ ",
  "ja510:21.3": "sūyanti te kālakatā tath' eva, ",
  "ja510:21.4": "etc. ",
  "ja510:22.1": "Vijjādharā ghoram adhīyamānā ",
  "ja510:22.2": "adassanaṃ osadhehi vajanti, ",
  "ja510:22.3": "na maccurājassa vajant' adassanaṃ, ",
  "ja510:22.4": "etc. ",
  "ja510:23.1": "Dhammo have rakkhati dhammacāriṃ, ",
  "ja510:23.2": "dhammo suciṇṇo sukham āvahāti, ",
  "ja510:23.3": "esānisaṃso dhamme suciṇṇe: ",
  "ja510:23.4": "na duggatiṃ gacchati dhammacārī. ",
  "ja510:24.1": "Na hi dhammo adhammo ca ",
  "ja510:24.2": "ubho samavipākino, (Dhp. 90,3.) ",
  "ja510:24.3": "adhammo nirayaṃ neti, ",
  "ja510:24.4": "dhammo pāpeti suggatinti. ",
