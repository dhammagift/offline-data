  "ja449:1.1": "",
  "ja449:1.2": "haricandanussado ",
  "ja449:1.3": "bāhā paggayha kandasi, ",
  "ja449:1.4": "vanamajjhe kiṃ dukkhito tuvanti. ",
  "ja449:2.1": "Sovaṇṇamayo pabhassaro ",
  "ja449:2.2": "uppanno rathapañjaro mama, ",
  "ja449:2.3": "tassa cakkayugaṃ na vindami, ",
  "ja449:2.4": "tena dukkhena jahāmi jīvitanti. ",
  "ja449:3.1": "Sovaṇṇamayaṃ maṇīmayaṃ ",
  "ja449:3.2": "lohamayaṃ atha rūpiyāmayaṃ [atha] ",
  "ja449:3.3": "pāvada, rathaṃ kārayāmi te, ",
  "ja449:3.4": "cakkayugaṃ paṭipādayāmi tanti ",
  "ja449:4.1": "So māṇavo tassa pāvadīti ",
  "ja449:4.2": "Candasuriyā ubhay' ettha bhātaro, ",
  "ja449:4.3": "sovaṇṇamayo ratho mama ",
  "ja449:4.4": "tena cakkayugena sobhatīti ",
  "ja449:5.1": "Bālo kho tvaṃ si māṇava ",
  "ja449:5.2": "yo tvaṃ patthayase apatthiyaṃ, ",
  "ja449:5.3": "maññāmi tuvaṃ marissasi ",
  "ja449:5.4": "na hi tuvaṃ lacchasi candasūriyeti ",
  "ja449:6.1": "Gamanāgamanam pi dissati ",
  "ja449:6.2": "vaṇṇadhātū ubhay' ettha vīthiyo, ",
  "ja449:6.3": "peto pana n' eva dissati, ",
  "ja449:6.4": "ko nu kho kandataṃ balyataroti ",
  "ja449:7.1": "Saccaṃ kho vadesi māṇava, ",
  "ja449:7.2": "aham eva kandataṃ balyataro, ",
  "ja449:7.3": "candaṃ viya dārako rudaṃ ",
  "ja449:7.4": "petaṃ kālakat' ābhipatthayeti ",
  "ja449:8.1": "Ādittaṃ vata maṃ santaṃ ",
  "ja449:8.2": "ghatasittaṃ va pāvakaṃ ",
  "ja449:8.3": "vārinā viya osiñci, ",
  "ja449:8.4": "sabbaṃ nibbāpaye daraṃ. ",
  "ja449:9.1": "Abbahi vata me sallaṃ ",
  "ja449:9.2": "yam āsi hadayanissitaṃ ",
  "ja449:9.3": "yo me sokaparetassa ",
  "ja449:9.4": "puttasokaṃ apānudi. ",
  "ja449:10.1": "So 'haṃ abbūḷhasallo 'smi ",
  "ja449:10.2": "vītasoko anāvilo, (III. 390,215.) ",
  "ja449:10.3": "na socāmi na rodāmi ",
  "ja449:10.4": "tava sutvāna māṇavāti. ",
  "ja449:11.1": ""
}
