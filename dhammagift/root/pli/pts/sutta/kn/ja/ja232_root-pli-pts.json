  "ja232:1.1": "Ekacintito va ayam attho, ",
  "ja232:1.2": "bālo aparināyako, ",
  "ja232:1.3": "na hi khujjena vāmena ",
  "ja232:1.4": "bhoti saṃgantum arahasīti. ",
  "ja232:2.1": "Purisūsabhaṃ maññamānā ",
  "ja232:2.2": "ahaṃ khujjam akāmayiṃ, ",
  "ja232:2.3": "so 'yaṃ saṃkuṭito seti ",
  "ja232:2.4": "chinnatanti yathā viṇāti. ",
  "ja232:3.1": ""
}
