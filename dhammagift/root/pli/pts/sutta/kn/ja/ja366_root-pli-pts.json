  "ja366:0.4": "",
  "ja366:1.1": "Madhuvaṇṇaṃ madhurasaṃ ",
  "ja366:1.2": "madhugandhaṃ visaṃ ahu, ",
  "ja366:1.3": "Gumbiyo ghāsam esāno ",
  "ja366:1.4": "araññe odahī visam. ",
  "ja366:2.1": "Madhūti maññamānā ",
  "ja366:2.2": "ye taṃ visaṃ samāsāsisuṃ ",
  "ja366:2.3": "tesaṃ taṃ kaṭukaṃ āsi, ",
  "ja366:2.4": "maraṇaṃ ten' upāgamuṃ. ",
  "ja366:3.1": "Ye ca kho paṭisaṃkhāya ",
  "ja366:3.2": "visaṃ taṃ parivajjayuṃ ",
  "ja366:3.3": "te āturesu sukhitā ",
  "ja366:3.4": "ḍayhamānesu nibbutā. ",
  "ja366:4.1": "Evam eva manussesu ",
  "ja366:4.2": "visaṃ kāmā samohitā ",
  "ja366:4.3": "āmisaṃ bandhanaṃ c' etaṃ ",
  "ja366:4.4": "maccuveso guhāsayo. ",
  "ja366:5.1": "Evam eva ime kāme ",
  "ja366:5.2": "āturā paricārake ",
  "ja366:5.3": "ye sadā parivajjenti ",
  "ja366:5.4": "saṃgaṃ loke upaccagunti. Yo 'yaṃ ",
  "ja366:6.1": ""
}
