  "ja442:0.1": "",
  "ja442:0.2": "",
  "ja442:0.3": "",
  "ja442:0.4": "",
  "ja442:1.1": "Bahussuto sutadhammo si Saṃkha, ",
  "ja442:1.2": "diṭṭhā tayā samaṇabrāhmaṇā ca, ",
  "ja442:1.3": "",
  "ja442:1.4": "",
  "ja442:2.1": "Subbhu subhā suppaṭimuttakambu ",
  "ja442:2.2": "paggayha sovaṇṇamayāya pātiyā ",
  "ja442:2.3": "bhuñjassu bhattaṃ iti maṃ vadeti, ",
  "ja442:2.4": "saddhā cittā ",
  "ja442:2.5": "tam ahaṃ noti brūmīti. ",
  "ja442:3.1": "Etādisaṃ brāhmaṇa disva yakkhaṃ ",
  "ja442:3.2": "puccheyya poso sukham āsasāno, ",
  "ja442:3.3": "uṭṭhehi, naṃ pañjalik' ābhipuccha: ",
  "ja442:3.4": "devī nu si tvaṃ uda mānusī nūti. ",
  "ja442:4.1": "Yaṃ tvaṃ sukhenābhisamekkhase maṃ ",
  "ja442:4.2": "bhuñjassu bhattaṃ iti maṃ vadesi ",
  "ja442:4.3": "pucchāmi taṃ nāri mahānubhāve: ",
  "ja442:4.4": "devī nu si tvaṃ uda mānusī nūti. ",
  "ja442:5.1": "Devī ahaṃ Saṃkha mahānubhāvā ",
  "ja442:5.2": "idhāgatā sāgaravārimajjhe ",
  "ja442:5.3": "anukampikā no ca paduṭṭhacittā, ",
  "ja442:5.4": "tav' eva atthāya idhāgatāsmi. ",
  "ja442:6.1": "Idh' annapānaṃ sayanāsanañ ca ",
  "ja442:6.2": "yānāni nānā vividhāni Saṃkha ",
  "ja442:6.3": "sabbassa ty-āhaṃ paṭipādayāmi ",
  "ja442:6.4": "yaṃ kiñci tuyhaṃ manasābhipatthitanti. ",
  "ja442:7.1": "Yaṃ kiñci yiṭṭhaṃ va hutaṃ va mayhaṃ ",
  "ja442:7.2": "sabbassa no issarā tvaṃ sugatte, ",
  "ja442:7.3": "sussoṇi subbhuru vilākamajjhe ",
  "ja442:7.4": "kissa me kammassa ayaṃ vipākoti. ",
  "ja442:8.1": "Ghamme pathe brāhmaṇa ekabhikkhuṃ ",
  "ja442:8.2": "ugghaṭṭhapādaṃ tasitam kilantaṃ ",
  "ja442:8.3": "paṭipādayi Saṃkha upāhanāhi, ",
  "ja442:8.4": "sā dakkhiṇā kāmaduhā tav' ajjāti. ",
  "ja442:9.1": "Sā hotu nāvā phalakūpapannā ",
  "ja442:9.2": "anavassutā erakavātayuttā, ",
  "ja442:9.3": "aññassa yānassa na h' atthi bhūmi, ",
  "ja442:9.4": "ajj' eva maṃ Moliniṃ pāpayassūti. ",
  "ja442:10.1": "Sā tattha vittā sumanā patītā ",
  "ja442:10.2": "nāvaṃ sucittaṃ abhinimminitvā ",
  "ja442:10.3": "ādāya Saṃkhaṃ purisena saddhiṃ ",
  "ja442:10.4": "upānayī nagaraṃ sādhurammanti ",
  "ja442:11.1": ""
}
