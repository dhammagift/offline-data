  "ja359:0.4": "",
  "ja359:1.1": "vikkama re haripada, ",
  "ja359:1.2": "",
  "ja359:1.3": "chinda vārattikaṃ pāsaṃ, ",
  "ja359:1.4": "nāhaṃ ekā vane rameti. ",
  "ja359:2.1": "Vikkamāmi na pāremi ",
  "ja359:2.2": "bhūmiṃ sumhāmi vegasā, ",
  "ja359:2.3": "daḷho vārattiko pāso ",
  "ja359:2.4": "pādam me parikantatīti. ",
  "ja359:3.1": "Attharassu palāsāni, ",
  "ja359:3.2": "asiṃ nibbaha luddaka, ",
  "ja359:3.3": "paṭhamaṃ maṃ hanitvāna ",
  "ja359:3.4": "hana pacchā mahāmiganti. ",
  "ja359:4.1": "Na me sutaṃ vā diṭṭhaṃ vā ",
  "ja359:4.2": "bhāsantiṃ mānusiṃ migiṃ, ",
  "ja359:4.3": "tvañ ca bhadde sukhī hohi ",
  "ja359:4.4": "eso cāpi mahāmigoti. ",
  "ja359:5.1": "Evaṃ luddaka nandassu ",
  "ja359:5.2": "saha sabbehi ñātihi ",
  "ja359:5.3": "yathāham ajja nandāmi ",
  "ja359:5.4": "muttaṃ disvā mahāmiganti. ",
  "ja359:6.1": ""
}
