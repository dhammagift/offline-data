  "ja456:0.4": "",
  "ja456:1.1": "Suṇohi mayhaṃ vacanam janinda, ",
  "ja456:1.2": "atthena Juṇh' amhi idhānupatto, ",
  "ja456:1.3": "na brāhmaṇe addhike tiṭṭhamāne ",
  "ja456:1.4": "gantabbam āhu dipadāna seṭṭhāti. ",
  "ja456:2.1": "Suṇomi tiṭṭhāmi, vadehi brahme ",
  "ja456:2.2": "yenāsi atthena idhānupatto, ",
  "ja456:2.3": "kaṃ vā tvam atthaṃ mayi patthayāno ",
  "ja456:2.4": "idhāgamo brahme tad iṃgha brūhīti. ",
  "ja456:3.1": "Dadāhi me gāmavarāni pañca ",
  "ja456:3.2": "dāsīsataṃ satta gavaṃ satāni ",
  "ja456:3.3": "parosahassañ ca suvaṇṇanikkhe ",
  "ja456:3.4": "bhariyā ca me sādisī dve dadāhi. ",
  "ja456:4.1": "Tapo nu te brāhmaṇa bhiṃsarūpo, ",
  "ja456:4.2": "mantā nu te brāhmaṇa cittarūpā, ",
  "ja456:4.3": "yakkhā va te assavā santi keci, ",
  "ja456:4.4": "atthaṃ vā me abhijānāsi kattaṃ. ",
  "ja456:5.1": "Na me tapo atthi na cāpi mantā, ",
  "ja456:5.2": "yakkhā ca me assavā n' atthi keci, ",
  "ja456:5.3": "attham pi te nābhijānāmi kattaṃ, ",
  "ja456:5.4": "pubbe ca kho saṅgati mattam āsi. ",
  "ja456:6.1": "Paṭhamaṃ imaṃ dassanaṃ jānato me, ",
  "ja456:6.2": "na t' ābhijānāmi ito puratthā, ",
  "ja456:6.3": "akkhāhi me pucchito etam atthaṃ, ",
  "ja456:6.4": "kadā kuhiṃ vā ahu saṅgamo no. ",
  "ja456:7.1": "Gandhārarājassa puramhi ramme ",
  "ja456:7.2": "avasimhase Takkasilāya deva, ",
  "ja456:7.3": "tatth' andhakāramhi timīsikāyaṃ ",
  "ja456:7.4": "aṃsena aṃsaṃ samaghaṭṭayimha. ",
  "ja456:8.1": "Te tattha ṭhatvāna ubho janinda ",
  "ja456:8.2": "sārāṇiyaṃ vītisārimha tattha, ",
  "ja456:8.3": "sā yeva no saṅgati mattam āsi ",
  "ja456:8.4": "tato na pacchā na pure kadāci. ",
  "ja456:9.1": "Yadā kadāci manujesu brahme ",
  "ja456:9.2": "samāgamo sappurisena hoti ",
  "ja456:9.3": "na paṇḍitā saṅgatisanthavāni ",
  "ja456:9.4": "pubbe kataṃ vāpi vināsayanti. ",
  "ja456:10.1": "Bālā ca kho saṅgatisanthavāni ",
  "ja456:10.2": "pubbe kataṃ vāpi vināsayanti, ",
  "ja456:10.3": "bahum pi bālesu kataṃ vinassati, ",
  "ja456:10.4": "tathā hi bālā akataññurūpā. ",
  "ja456:11.1": "Dhīrā ca kho saṅgatisanthavāni ",
  "ja456:11.2": "pubbe kataṃ vāpi na nāsayanti, ",
  "ja456:11.3": "",
  "ja456:11.4": "",
  "ja456:12.1": "Dadāmi te gāmavarāni pañca ",
  "ja456:12.2": "dāsīsataṃ satta gavaṃ satāni, ",
  "ja456:12.3": "parosahassañ ca suvaṇṇanikkhe ",
  "ja456:12.4": "bhariyā ca te sādisī dve dadāmi. ",
  "ja456:13.1": "Evaṃ sataṃ hoti samecca rāja, ",
  "ja456:13.2": "nakkhattarājā-r-iva tārakānaṃ ",
  "ja456:13.3": "āpūratī Kāsipatī yathā ahaṃ, ",
  "ja456:13.4": "tayā hi me saṅgamo ajja laddhoti. ",
  "ja456:14.1": ""
}
