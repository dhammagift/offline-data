  "ja347:0.4": "",
  "ja347:1.1": "Sabbāyasaṃ kūṭam atippamāṇaṃ ",
  "ja347:1.2": "paggayha so tiṭṭhati antalikkhe, ",
  "ja347:1.3": "rakkhāya me tvaṃ vihito nu 's' ajja ",
  "ja347:1.4": "udāhu me cetayase vadhāyāti. ",
  "ja347:2.1": "Dūto 'haṃ rājā idha rakkhasānaṃ, ",
  "ja347:2.2": "vadhāya tuyhaṃ pahito 'ham asmi, ",
  "ja347:2.3": "Indo ca taṃ rakkhati devarājā, ",
  "ja347:2.4": "ten' uttamaṅgaṃ na hi phālayāmīti. ",
  "ja347:3.1": "Sace ca maṃ rakkhati devarājā ",
  "ja347:3.2": "devānam indo Maghavā Sujampati ",
  "ja347:3.3": "",
  "ja347:3.4": "",
  "ja347:4.1": "Kāmaṃ kandantu kumbhaṇḍā ",
  "ja347:4.2": "sabbe paṃsupisācakā, ",
  "ja347:4.3": "nālaṃ pisācā yuddhāya, ",
  "ja347:4.4": "mahatī sā vihesikāti. ",
  "ja347:5.1": ""
}
