  "ja440:0.4": "",
  "ja440:1.1": "Kaṇho vatāyaṃ puriso, ",
  "ja440:1.2": "kaṇhaṃ bhuñjati bhojanaṃ ",
  "ja440:1.3": "kaṇhe bhūmipadesasmiṃ, ",
  "ja440:1.4": "na mayhaṃ manaso piyoti. ",
  "ja440:2.1": "Na kaṇho tacasā hoti, ",
  "ja440:2.2": "antosāro hi brāhmaṇo, ",
  "ja440:2.3": "yasmiṃ pāpāni kammāni ",
  "ja440:2.4": "sa ve kaṇho Sujampatīti. ",
  "ja440:3.1": "Etasmiṃ te sulapite ",
  "ja440:3.2": "patirūpe subhāsite ",
  "ja440:3.3": "varaṃ brāhmaṇa te dammi ",
  "ja440:3.4": "yaṃ kiñci manas' icchasīti. ",
  "ja440:4.1": "Varañ ce me ado Sakka ",
  "ja440:4.2": "sabbabhūtānam issara ",
  "ja440:4.3": "sunikkodhaṃ suniddosaṃ ",
  "ja440:4.4": "nillobhaṃ vattiṃ attano ",
  "ja440:4.5": "nisneham abhikaṃkhāmi, ",
  "ja440:4.6": "ete me caturo vareti. ",
  "ja440:5.1": "Kin nu kodhe va dose vā ",
  "ja440:5.2": "lobhe snehe va brāhmaṇa ",
  "ja440:5.3": "ādīnavaṃ sampassasi, ",
  "ja440:5.4": "tam me akkhāhi pucchitoti. ",
  "ja440:6.1": "Appo hutvā bahu hoti ",
  "ja440:6.2": "vaḍḍhat' eso akhantijo, ",
  "ja440:6.3": "āsaṅgi bahupāyāso, ",
  "ja440:6.4": "tasmā kodhaṃ na rocaye. ",
  "ja440:7.1": "Duṭṭhassa paṭhamā vācā ",
  "ja440:7.2": "parāmāso anantarā ",
  "ja440:7.3": "tato pāṇi tato daṇḍo ",
  "ja440:7.4": "satthassa paramā gati, ",
  "ja440:7.5": "doso kodhasamuṭṭhāno, ",
  "ja440:7.6": "tasmā dosaṃ na rocaye. ",
  "ja440:8.1": "Ālopasahasākārā ",
  "ja440:8.2": "nikatī vañcanāni ca ",
  "ja440:8.3": "dissanti lobhadhammesu, ",
  "ja440:8.4": "tasmā lobhaṃ na rocaye. ",
  "ja440:9.1": "Snehasaṃgathitā ganthā ",
  "ja440:9.2": "senti manomayā puthu, ",
  "ja440:9.3": "te bhusaṃ upatāpenti, ",
  "ja440:9.4": "tasmā snehaṃ na rocayeti. ",
  "ja440:10.1": "Etasmin te sulapite ",
  "ja440:10.2": "patirūpe subhāsite ",
  "ja440:10.3": "varaṃ brāhmaṇa te dammi ",
  "ja440:10.4": "yaṃ kiñci manas' icchasīti. ",
  "ja440:11.1": "Varaṃ ce ma ado Sakka ",
  "ja440:11.2": "sabbabhūtānam issara ",
  "ja440:11.3": "araññe me viharato ",
  "ja440:11.4": "niccaṃ ekavihārino ",
  "ja440:11.5": "ābādhā na uppajjeyyuṃ ",
  "ja440:11.6": "antarāyakarā bhusāti. ",
  "ja440:12.1": "Etasmiṃ te sulapite ",
  "ja440:12.2": "patirūpe subhāsite ",
  "ja440:12.3": "varaṃ brāhmaṇa te dammi ",
  "ja440:12.4": "yaṃ kiñci manas' icchasīti. ",
  "ja440:13.1": "Varaṃ ce me ado Sakkasabbabhūtānam issara ",
  "ja440:13.2": "(Milindap. p. 384.) ",
  "ja440:13.3": "na mano vā sarīraṃ vā ",
  "ja440:13.4": "maṃkate Sakka kassaci ",
  "ja440:13.5": "kadāci upahaññetha, ",
  "ja440:13.6": "etaṃ Sakka varaṃ vareti. ",
  "ja440:14.1": ""
}
