  "ja294:1.1": "Ko 'yaṃ bindussaro vaggu ",
  "ja294:1.2": "pavadantānam uttamo, ",
  "ja294:1.3": "accuto jambusākhāya ",
  "ja294:1.4": "moracchāpo va kūjatīti. ",
  "ja294:2.1": "Kulaputto va jānāti ",
  "ja294:2.2": "kulaputte pasaṃsituṃ, ",
  "ja294:2.3": "vyagghacchāpasarīvaṇṇa ",
  "ja294:2.4": "bhuñja samma dadāmi teti. ",
  "ja294:3.1": "Cirassaṃ vata passāmi ",
  "ja294:3.2": "musāvādī samāgate ",
  "ja294:3.3": "vantādaṃ kuṇapādañ ca ",
  "ja294:3.4": "aññamaññaṃ pasaṃsaketi. ",
  "ja294:4.1": ""
}
