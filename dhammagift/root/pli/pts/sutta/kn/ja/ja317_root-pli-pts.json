  "ja317:1.1": "rodatha, ",
  "ja317:1.2": "na hi taṃ rodathā yo marissati, ",
  "ja317:1.3": "sabbe va sarīradhārino ",
  "ja317:1.4": "anupubbena jahanti jīvitaṃ. ",
  "ja317:2.1": "Devamanussā catuppadā ",
  "ja317:2.2": "pakkhigaṇā uragā ca bhogino ",
  "ja317:2.3": "asmiṃ sarīre anissarā ",
  "ja317:2.4": "ramamānā va jahanti jīvitaṃ. ",
  "ja317:3.1": "Evañ calitaṃ asaṇṭhitaṃ ",
  "ja317:3.2": "sukhadukkhaṃ manujesu apekkhiya ",
  "ja317:3.3": "kanditaruditaṃ niratthakaṃ, ",
  "ja317:3.4": "kiṃ vo sokagaṇābhikīrare. ",
  "ja317:4.1": "Dhuttā soṇḍā akatā ",
  "ja317:4.2": "bālā sūrā vīrā ayogino ",
  "ja317:4.3": "dhīraṃ maññanti bāloti ",
  "ja317:4.4": "ye dhammassa akovidāti. Yan ",
  "ja317:5.1": ""
}
