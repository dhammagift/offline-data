  "ja489:0.4": "",
  "ja489:1.1": "Mahesī Rucino bhariyā ",
  "ja489:1.2": "ānītā paṭhamaṃ ahaṃ, ",
  "ja489:1.3": "dasavassasahassāni ",
  "ja489:1.4": "yaṃ maṃ Suruci-m-ānayi. ",
  "ja489:2.1": "Sāhaṃ brāhmaṇa rājānaṃ ",
  "ja489:2.2": "Vedehaṃ Mithilaggahaṃ ",
  "ja489:2.3": "nābhijānāmi kāyena ",
  "ja489:2.4": "vācāya uda cetasā, ",
  "ja489:2.5": "Suruciṃ atimaññittha ",
  "ja489:2.6": "āviṃ vā yadi vā raho. ",
  "ja489:3.1": "Etena saccavajjena ",
  "ja489:3.2": "putto uppajjataṃ ise, ",
  "ja489:3.3": "musā me bhaṇamānāya ",
  "ja489:3.4": "muddhā phalatu sattadhā. ",
  "ja489:4.1": "Bhattu manāpassa pitā mātā ",
  "ja489:4.2": "cāpi suvāmino ",
  "ja489:4.3": "te maṃ brahma vinetāro ",
  "ja489:4.4": "yāva aṭṭhaṃsu jīvite. ",
  "ja489:5.1": "Sāhaṃ ahiṃsāratinī ",
  "ja489:5.2": "kāmasā dhammacārinī ",
  "ja489:5.3": "sakkaccaṃ te upaṭṭhāsiṃ ",
  "ja489:5.4": "rattindivam atanditā. ",
  "ja489:6.1": "Etena saccavajjena ",
  "ja489:6.2": "--pe--. ",
  "ja489:6.3": "Loḷasitthisahassāni ",
  "ja489:6.4": "",
  "ja489:7.1": "",
  "ja489:7.2": "sahabhariyāni brāhmaṇa ",
  "ja489:7.3": "tāsu issā vā kodho vā ",
  "ja489:7.4": "nāhu mayhaṃ kudācanaṃ. ",
  "ja489:8.1": "Hitena tāsaṃ nandāmi, ",
  "ja489:8.2": "na ca me kāci appiyā, ",
  "ja489:8.3": "attānaṃ vānukampāmi ",
  "ja489:8.4": "sadā sabbā sapattiyo. ",
  "ja489:9.1": "Etena saccavajjena ",
  "ja489:9.2": "--pe--. ",
  "ja489:9.3": "",
  "ja489:9.4": "",
  "ja489:10.1": "Dāse kammakare pesse ",
  "ja489:10.2": "ye c' aññe anujīvino ",
  "ja489:10.3": "posemi saha dhammena ",
  "ja489:10.4": "sadā pamuditindriyā. ",
  "ja489:11.1": "Etena saccavajjena ",
  "ja489:11.2": "--pe--. ",
  "ja489:11.3": "",
  "ja489:11.4": "",
  "ja489:12.1": "Samaṇe brāhmaṇe cāpi ",
  "ja489:12.2": "aññe cāpi vanibbake ",
  "ja489:12.3": "tappemi annapānena ",
  "ja489:12.4": "sadā payatapāṇinī. ",
  "ja489:13.1": "Etena saccavajjena ",
  "ja489:13.2": "--pe--. ",
  "ja489:13.3": "",
  "ja489:13.4": "",
  "ja489:14.1": "Cātuddasiṃ pannarasiṃ yāva pakkhassa ",
  "ja489:14.2": "aṭṭhamiṃ* pāṭihāriyapakkhañ ca aṭṭhaṅgasusamāhitaṃ ",
  "ja489:14.3": "",
  "ja489:14.4": "",
  "ja489:14.5": "uposathaṃ upavasāmi ",
  "ja489:14.6": "sadā sīlesu saṃvutā. ",
  "ja489:15.1": "Etena saccavajjena ",
  "ja489:15.2": "putto uppajjataṃ ise, ",
  "ja489:15.3": "musā me bhaṇamānāya ",
  "ja489:15.4": "muddhā phalatu sattadhāti. ",
  "ja489:16.1": "Sabbe va te dhammaguṇā ",
  "ja489:16.2": "rājaputti yasassini ",
  "ja489:16.3": "saṃvijjanti tayi bhadde ",
  "ja489:16.4": "ye tvaṃ kittesi attani. ",
  "ja489:17.1": "Khattiyo jātisampanno ",
  "ja489:17.2": "abhijāto yasassimā ",
  "ja489:17.3": "dhammarājā Videhānaṃ ",
  "ja489:17.4": "putto uppajjate tavanti. ",
  "ja489:18.1": "Rummī rajojalladharo ",
  "ja489:18.2": "aghe vehāsayaṇ ṭhito ",
  "ja489:18.3": "manuññaṃ bhāsasī vācaṃ ",
  "ja489:18.4": "yaṃ mayhaṃ hadayaṃgamaṃ. ",
  "ja489:19.1": "Devatā nu si saggamhā ",
  "ja489:19.2": "isi vāsi mahiddhiko, ",
  "ja489:19.3": "ko vāsi tvaṃ anuppatto, ",
  "ja489:19.4": "attānam me pavedayāti. ",
  "ja489:20.1": "Yaṃ devasaṃghā vadanti ",
  "ja489:20.2": "Sudhammāyaṃ samāgatā ",
  "ja489:20.3": "so 'haṃ Sakko sahassakkho ",
  "ja489:20.4": "āgato 'smi tav' antike. Itthi ",
  "ja489:21.1": "yā jīvalokasmiṃ ",
  "ja489:21.2": "yā hoti samacārinī ",
  "ja489:21.3": "medhāvinī sīlavatī ",
  "ja489:21.4": "sassudevāpatibbatā. ",
  "ja489:22.1": "Tādisāya sumedhāya ",
  "ja489:22.2": "sucikammāya nāriyā ",
  "ja489:22.3": "devā dassanam āyanti ",
  "ja489:22.4": "mānusiyā amānusā. ",
  "ja489:23.1": "Tvaṃ bhadde suciṇṇena ",
  "ja489:23.2": "pubbesucaritena ca ",
  "ja489:23.3": "idha rājakule jātā ",
  "ja489:23.4": "sabbakāmasamiddhinī. ",
  "ja489:24.1": "Ayañ ca te rājaputti ",
  "ja489:24.2": "ubhayattha kaṭaggaho ",
  "ja489:24.3": "devalokūpapattī ca ",
  "ja489:24.4": "kittī ca idha jīvite. ",
  "ja489:25.1": "Ciraṃ sumedhe sukhinī ",
  "ja489:25.2": "dhammam attani pālaya, ",
  "ja489:25.3": "esāhaṃ Tidivaṃ yāmi, ",
  "ja489:25.4": "piyam me tava dassananti. ",
  "ja489:26.1": ""
}
