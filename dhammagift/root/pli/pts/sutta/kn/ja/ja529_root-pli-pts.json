  "ja529:0.4": "",
  "ja529:1.1": "sutvā sataṃ dammi ",
  "ja529:1.2": "sabassaṃ daṭṭhu Sonakaṃ, ",
  "ja529:1.3": "ko me Sonakam akkhāti ",
  "ja529:1.4": "sahāyaṃ paṃsukīlitanti g. ā. ",
  "ja529:2.1": "Atha bravī māṇavako ",
  "ja529:2.2": "daharo pañcacūḷako: ",
  "ja529:2.3": "mayhaṃ sutvā sataṃ dehi ",
  "ja529:2.4": "sahassaṃ daṭṭhu Sonakaṃ. ",
  "ja529:2.5": "ahaṃ Sonakam akkhissaṃ ",
  "ja529:2.6": "sahāyaṃ paṃsukīḷitanti. ",
  "ja529:3.1": "Katarasmiṃ [so] janapade ",
  "ja529:3.2": "raṭṭhesu nigamesu ca ",
  "ja529:3.3": "kattha te Sonako diṭṭho ",
  "ja529:3.4": "tam me akkhāhi pucchito. ",
  "ja529:4.1": "Tav' eva deva vijite ",
  "ja529:4.2": "tav' ev' uyyānabhūmiyā ",
  "ja529:4.3": "ujuvaṃsā mahāsālā ",
  "ja529:4.4": "nīlobhāsā manoramā ",
  "ja529:5.1": "Tiṭṭhanti meghasamonā ",
  "ja529:5.2": "rammā aññoññanissitā, ",
  "ja529:5.3": "tesaṃ mūlasmiṃ Sonako ",
  "ja529:5.4": "jhāyati anupādāno ",
  "ja529:5.5": "upādānesu lokesu ",
  "ja529:5.6": "ḍayhamānesu nibbuto. ",
  "ja529:6.1": "Tato ca rājā pāyāsi ",
  "ja529:6.2": "senāya caturaṅgiyā, ",
  "ja529:6.3": "kārāpetvā samaṃ maggaṃ ",
  "ja529:6.4": "agamā yena Sonako. ",
  "ja529:7.1": "Uyyānabhūmiṃ gantvāna ",
  "ja529:7.2": "vicaranto brahāvane ",
  "ja529:7.3": "āsīnaṃ Sonakaṃ dakkhi ",
  "ja529:7.4": "ḍayhamānesu nibbutanti. ",
  "ja529:8.1": "Kapaṇo vatāyaṃ bhikkhu ",
  "ja529:8.2": "muṇḍo saṃghāṭipāruto ",
  "ja529:8.3": "amātiko apītiko ",
  "ja529:8.4": "rukkhamūlasmiṃ jhāyatīti. ",
  "ja529:9.1": "Imaṃ vākyaṃ nisāmetvā ",
  "ja529:9.2": "Sonako etad abravi: ",
  "ja529:9.3": "na rāja kapaṇo hoti ",
  "ja529:9.4": "dhammaṃ kāyena phassayaṃ. ",
  "ja529:10.1": "Yo ca dhammaṃ niraṃkatvā ",
  "ja529:10.2": "adhammaṃ anuvattati ",
  "ja529:10.3": "sa rājā kapaṇo hoti ",
  "ja529:10.4": "pāpo pāpaparāyanoti. ",
  "ja529:11.1": "Arindamoti me nāmaṃ, ",
  "ja529:11.2": "Kāsirājāti maṃ vidū, ",
  "ja529:11.3": "kacci bhoto sukhā seyyā ",
  "ja529:11.4": "idha pattassa Sonakāti g. ā. ",
  "ja529:12.1": "Sadāpi bhadram adhanassa ",
  "ja529:12.2": "anāgārassa bhikkhuno: ",
  "ja529:12.3": "na tesaṃ koṭṭhe upenti ",
  "ja529:12.4": "na kumbhe na kaḷopiyā, ",
  "ja529:12.5": "paraniṭṭhitam esānā ",
  "ja529:12.6": "tena yāpenti subbatā. ",
  "ja529:13.1": "Dutiyam pi bhadram adhanassa ",
  "ja529:13.2": "anāgārassa bhikkhuno: ",
  "ja529:13.3": "anavajjo piṇḍo bhottabbo ",
  "ja529:13.4": "na ca koc' ūparodhati. ",
  "ja529:14.1": "Tatiyam pi bhadram adhanassa ",
  "ja529:14.2": "anāgārassa bhikkhuno: ",
  "ja529:14.3": "nibbuto piṇḍo bhottabbo ",
  "ja529:14.4": "na ca koc' ūparodhati. ",
  "ja529:15.1": "Catuttham bhadram adhanassa ",
  "ja529:15.2": "anāgārassa bhikkhuno: ",
  "ja529:15.3": "muttassa raṭṭhe carato ",
  "ja529:15.4": "saṅgo yassa na vijjati. ",
  "ja529:16.1": "Pañcamaṃ bhadram adhanassa ",
  "ja529:16.2": "anāgārassa bhikkhuno: ",
  "ja529:16.3": "nagaramhi ḍayhamānamhi ",
  "ja529:16.4": "nāssa kiñci aḍayhatha. ",
  "ja529:17.1": "Chaṭṭhaṃ bhadram adhanassa ",
  "ja529:17.2": "anāgārassa bhikkhuno: ",
  "ja529:17.3": "raṭṭhe vilumpamānamhi ",
  "ja529:17.4": "nāssa kiñci ahīratha. ",
  "ja529:18.1": "Sattamaṃ bhadram adhanassa ",
  "ja529:18.2": "anāgārassa bhikkhuno: ",
  "ja529:18.3": "corehi rakkhitaṃ maggaṃ ",
  "ja529:18.4": "ye c' aññe pāripanthikā ",
  "ja529:18.5": "pattacīvaram ādāya ",
  "ja529:18.6": "sotthiṃ gacchanti subbatā. ",
  "ja529:19.1": "Aṭṭhamaṃ bhadram adhanassa ",
  "ja529:19.2": "anāgārassa bhikkhuno: ",
  "ja529:19.3": "yaṃ yaṃ disaṃ pakkamati ",
  "ja529:19.4": "anapekho va gacchatīti. Bahū ",
  "ja529:20.1": "pi bhadrakā ete ",
  "ja529:20.2": "yo tvaṃ bhikkhu pasaṃsasi, ",
  "ja529:20.3": "ahañ ca giddho kāmesu ",
  "ja529:20.4": "kathaṃ kāhāmi Sonaka. ",
  "ja529:21.1": "Piyā me mānusā kāmā ",
  "ja529:21.2": "atho divyāpi me piyā, ",
  "ja529:21.3": "atha kena nu vaṇṇena ",
  "ja529:21.4": "ubho loke labhāmaseti. ",
  "ja529:22.1": "Kāme [su] giddhā kāmaratā ",
  "ja529:22.2": "kāmesu adhimucchitā ",
  "ja529:22.3": "narā pāpāni katvāna ",
  "ja529:22.4": "upapajjanti duggatiṃ. ",
  "ja529:23.1": "Ye ca kāme pahatvāna ",
  "ja529:23.2": "nikkhantā akutobhayā ",
  "ja529:23.3": "ekodibhāvādhigatā ",
  "ja529:23.4": "na te gacchanti duggatiṃ. ",
  "ja529:24.1": "Upaman te karissāmi, ",
  "ja529:24.2": "taṃ suṇohi Arindama, ",
  "ja529:24.3": "upamāya p' idh' ekacce ",
  "ja529:24.4": "atthaṃ jānanti paṇḍitā: ",
  "ja529:25.1": "Gaṅgāya kuṇapaṃ disvā ",
  "ja529:25.2": "vuyhamānaṃ mahaṇṇave ",
  "ja529:25.3": "vāyaso samacintesi ",
  "ja529:25.4": "appapañño acetaso: ",
  "ja529:26.1": "Yānañ ca vat' idaṃ laddhaṃ ",
  "ja529:26.2": "bhakkho cāyaṃ anappako, ",
  "ja529:26.3": "tattha rattiṃ tattha divā ",
  "ja529:26.4": "tatth' eva nirato mano. ",
  "ja529:27.1": "Khādaṃ nāgassa maṃsāni ",
  "ja529:27.2": "pipaṃ Bhāgīrasodakaṃ ",
  "ja529:27.3": "sampassaṃ vanacetyāni ",
  "ja529:27.4": "na palittha vihaṅgamo. ",
  "ja529:28.1": "Taṃ va otaraṇī Gaṅgā ",
  "ja529:28.2": "pamattaṃ kuṇape rataṃ ",
  "ja529:28.3": "samuddaṃ ajjhagāhayi ",
  "ja529:28.4": "agati yattha pakkhinaṃ. ",
  "ja529:29.1": "So ca bhakkhaparikkhīṇo ",
  "ja529:29.2": "udāpatvā vihaṅgamo ",
  "ja529:29.3": "na pacchato na purato ",
  "ja529:29.4": "n' uttaraṃ no pi dakkhiṇaṃ ",
  "ja529:30.1": "Dīpaṃ so na ajjhagacchi ",
  "ja529:30.2": "agati yattha pakkhinaṃ, ",
  "ja529:30.3": "so ca tatth' eva pāpattha ",
  "ja529:30.4": "yathā dubbalako tathā. ",
  "ja529:31.1": "Tañ ca sāmuddikā macchā ",
  "ja529:31.2": "kumbhīlā makarā susū ",
  "ja529:31.3": "pasayhakārā khādiṃsu ",
  "ja529:31.4": "phandamānaṃ vipakkhinaṃ. ",
  "ja529:32.1": "Evam eva tuvaṃ rāja ",
  "ja529:32.2": "ye c' aññe kāmabhogino ",
  "ja529:32.3": "giddhā ce na vamissanti ",
  "ja529:32.4": "kākapaññāya te vidū. ",
  "ja529:33.1": "Esā te upamā rāja ",
  "ja529:33.2": "atthasandassanī katā, ",
  "ja529:33.3": "tvañ ca paññāyase tena ",
  "ja529:33.4": "yadi kāhasi vā na vāti. ",
  "ja529:34.1": "Ekavācam pi dvevācaṃ ",
  "ja529:34.2": "bhaṇeyya anukampako ",
  "ja529:34.3": "taduttariṃ na bhāseyya ",
  "ja529:34.4": "dāso ayirassa santiketi. ",
  "ja529:35.1": "Idaṃ vatvāna pakkāmi ",
  "ja529:35.2": "Sonako amitabuddhimā ",
  "ja529:35.3": "vehāse antalikkhasmiṃ ",
  "ja529:35.4": "anusāsitvāna khattiyanti ",
  "ja529:36.1": "Ko nu 'me rājakattāro ",
  "ja529:36.2": "sūtā veyyattim āgatā, ",
  "ja529:36.3": "rajjaṃ niyyādayissāmi, ",
  "ja529:36.4": "nāhaṃ rajjena-m-atthiko. ",
  "ja529:37.1": "Ajj' eva pabbajissāmi, ",
  "ja529:37.2": "ko jaññā maraṇaṃ suve, ",
  "ja529:37.3": "māhaṃ kāko va dummedho ",
  "ja529:37.4": "kāmānaṃ vasam annagāti. ",
  "ja529:38.1": "Atthi te daharo putto ",
  "ja529:38.2": "Dīghāvu raṭṭhavaddhano, ",
  "ja529:38.3": "Taṃ rajje abhisiñcassu, ",
  "ja529:38.4": "so no rājā bhavissatīti. ",
  "ja529:39.1": "Khippaṃ kumāraṃ ānetha ",
  "ja529:39.2": "Dīghāvuṃ raṭṭhavaddhanaṃ, ",
  "ja529:39.3": "taṃ rajje abhisiñcassu, ",
  "ja529:39.4": "so vo rājā bhavissati. ",
  "ja529:40.1": "Tato kumāraṃ ānesuṃ ",
  "ja529:40.2": "Dīghāvuṃ raṭṭhavaddhanaṃ, ",
  "ja529:40.3": "taṃ disvā ālapi rājā ",
  "ja529:40.4": "ekaputtaṃ manoramaṃ: ",
  "ja529:41.1": "Saṭṭhi gāmasahassāni ",
  "ja529:41.2": "paripuññāni sabbaso -- ",
  "ja529:41.3": "te putta paṭipajjassu, ",
  "ja529:41.4": "rajjaṃ niyyādayāmi te. ",
  "ja529:42.1": "Ajj' eva pabbajissāmi, ",
  "ja529:42.2": "ko jaññā maraṇaṃ suve, ",
  "ja529:42.3": "māhaṃ kāko va dummedho ",
  "ja529:42.4": "kāmānaṃ vasam annagā. ",
  "ja529:43.1": "Saṭṭhi nāgasahassāni ",
  "ja529:43.2": "sabbālaṃkārabhūsitā ",
  "ja529:43.3": "suvaṇṇakacchā mātaṅgā ",
  "ja529:43.4": "hemakappanavāsasā ",
  "ja529:44.1": "Ārūḷhā gāmaṇīyehi ",
  "ja529:44.2": "tomaraṃkusapāṇihi -- ",
  "ja529:44.3": "te putta paṭipajjassu, ",
  "ja529:44.4": "rajjaṃ niyyādayāmi te. ",
  "ja529:45.1": "Ajj' eva ",
  "ja529:45.2": "",
  "ja529:45.3": "",
  "ja529:45.4": "etc. ",
  "ja529:46.1": "Saṭṭhi assasahassāni ",
  "ja529:46.2": "sabbālaṃkārabhūsitā ",
  "ja529:46.3": "ajānīyā va jātiyā ",
  "ja529:46.4": "sindhavā sīghavāhino ",
  "ja529:47.1": "Ārūḷhā gāmaṇīyehi ",
  "ja529:47.2": "illiyācāpadhārihi -- ",
  "ja529:47.3": "te putta paṭipajjassu , ",
  "ja529:47.4": "rajjaṃ niyyādayāmi te. ",
  "ja529:48.1": "Ajj' eva ",
  "ja529:48.2": "",
  "ja529:48.3": "",
  "ja529:48.4": "etc. ",
  "ja529:49.1": "Saṭṭhi rathasahassāni ",
  "ja529:49.2": "sannaddhā ussitaddhajā ",
  "ja529:49.3": "dīpā atho pi veyyagghā ",
  "ja529:49.4": "sabbālaṃkārabhūsitā ",
  "ja529:50.1": "Ārūḷhā gāmaṇīyehi ",
  "ja529:50.2": "cāpahatthehi vammihi -- ",
  "ja529:50.3": "te putta paṭipajjassu, ",
  "ja529:50.4": "rajjaṃ niyyādayāmi te. ",
  "ja529:51.1": "Ajj' eva ",
  "ja529:51.2": "",
  "ja529:51.3": "",
  "ja529:51.4": "etc. ",
  "ja529:52.1": "Saṭṭhi dhenusahassāni ",
  "ja529:52.2": "rohaññā puṅgavūsabhā -- ",
  "ja529:52.3": "tā putta paṭipajjassu, ",
  "ja529:52.4": "rajjaṃ niyyādayāmi te. ",
  "ja529:53.1": "Ajj' eva ",
  "ja529:53.2": "",
  "ja529:53.3": "",
  "ja529:53.4": "etc. ",
  "ja529:54.1": "Soḷasitthisahassāni ",
  "ja529:54.2": "sabbālaṃkārabhūsitā ",
  "ja529:54.3": "vicitrahatthābharaṇā ",
  "ja529:54.4": "āmuttamaṇikuṇḍalā -- ",
  "ja529:54.5": "tā putta paṭipajjassu, ",
  "ja529:54.6": "rajjaṃ niyyādayāmi te. ",
  "ja529:55.1": "Ajj' eva ",
  "ja529:55.2": "",
  "ja529:55.3": "",
  "ja529:55.4": "etc. ",
  "ja529:56.1": "Daharass' eva me tāta ",
  "ja529:56.2": "mātā matāti me sutaṃ, ",
  "ja529:56.3": "tayā vinā ahaṃ tāta ",
  "ja529:56.4": "jīvitum hi na ussahe. ",
  "ja529:57.1": "Yathā āraññakaṃ nāgaṃ ",
  "ja529:57.2": "poto anveti pacchato ",
  "ja529:57.3": "jessantaṃ giriduggesu ",
  "ja529:57.4": "samesu visamesu ca ",
  "ja529:58.1": "Evaṃ taṃ anugacchāmi ",
  "ja529:58.2": "pattam ādāya pacchato, ",
  "ja529:58.3": "subharo te bhavissāmi, ",
  "ja529:58.4": "na te hessāmi dubbharo. ",
  "ja529:59.1": "Yathā sāmuddikaṃ nāvaṃ ",
  "ja529:59.2": "vāṇijānaṃ dhanesinaṃ ",
  "ja529:59.3": "vohāro tattha gaṇheyya ",
  "ja529:59.4": "vāṇijā vyasanī siyā ",
  "ja529:60.1": "Evam evāyaṃ puttakali ",
  "ja529:60.2": "antarāyakaro mamaṃ, ",
  "ja529:60.3": "imaṃ kumāraṃ pāpetha ",
  "ja529:60.4": "pāsādaṃ rativaddhanaṃ. ",
  "ja529:61.1": "Tattha kambussahatthāyo ",
  "ja529:61.2": "yathā Sakkaṃ va accharā ",
  "ja529:61.3": "tā naṃ tattha ramessanti, ",
  "ja529:61.4": "tāhi-m-eso ramissati. ",
  "ja529:62.1": "Tato kumāraṃ pāpesuṃ ",
  "ja529:62.2": "pāsādaṃ rativaddhanaṃ, ",
  "ja529:62.3": "taṃ disvā avacuṃ kaññā ",
  "ja529:62.4": "Dīghāvuṃ raṭṭhaddhanaṃ: ",
  "ja529:63.1": "Devatā nu si gandhabbo ",
  "ja529:63.2": "ādu Sakko purindado, ",
  "ja529:63.3": "ko vā tvaṃ kassa vā putto, ",
  "ja529:63.4": "kathaṃ jānemu taṃ mayaṃ. ",
  "ja529:64.1": "N' amhi devo na gandhabbo ",
  "ja529:64.2": "na pi Sakko purindado, ",
  "ja529:64.3": "Kāsirañño ahaṃ putto ",
  "ja529:64.4": "Dīghāvu raṭṭhavaddhano. ",
  "ja529:64.5": "Mama bharatha, bhaddaṃ vo, ",
  "ja529:64.6": "ahaṃ bhattā bhavāmi vo. ",
  "ja529:65.1": "Taṃ tattha avacuṃ kaññā ",
  "ja529:65.2": "Dīghāvuṃ raṭṭhavaddhanaṃ: ",
  "ja529:65.3": "kuhiṃ rājā anuppatto, ",
  "ja529:65.4": "ito rājā kuhiṃ gato. ",
  "ja529:66.1": "Paṃkaṃ rājā atikkanto ",
  "ja529:66.2": "thale rājā patiṭṭhito ",
  "ja529:66.3": "akaṇṭakaṃ agahanaṃ ",
  "ja529:66.4": "paṭipanno mahāpathaṃ. ",
  "ja529:67.1": "Ahañ ca paṭipanno 'smi ",
  "ja529:67.2": "maggaṃ duggatigāminaṃ ",
  "ja529:67.3": "sakaṇṭakaṃ sagahanaṃ ",
  "ja529:67.4": "yena gacchāmi duggatiṃ. ",
  "ja529:68.1": "Tassa te sāgataṃ rāja ",
  "ja529:68.2": "sīhasseva giribbajaṃ, ",
  "ja529:68.3": "anusāsa mahārāja, ",
  "ja529:68.4": "tvaṃ no sabbāsaṃ issaroti. ",
  "ja529:69.1": ""
}
