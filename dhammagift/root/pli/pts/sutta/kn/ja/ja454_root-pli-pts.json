  "ja454:0.1": "",
  "ja454:0.2": "",
  "ja454:0.3": "",
  "ja454:0.4": "",
  "ja454:1.1": "Uṭṭhehi Kaṇha, kiṃ sesi, ",
  "ja454:1.2": "ko attho supinena te, ",
  "ja454:1.3": "yo pi t' āyaṃ sako bhātā ",
  "ja454:1.4": "hadayaṃ cakkhuṃ va dakkhiṇaṃ ",
  "ja454:1.5": "tassa vātā balīyanti, ",
  "ja454:1.6": "Ghato jappati Kesavāti. ",
  "ja454:2.1": "Tassa taṃ vacanaṃ sutvā ",
  "ja454:2.2": "Rohiṇeyyassa Kesavo ",
  "ja454:2.3": "taramānarūpo vuṭṭhāsi ",
  "ja454:2.4": "bhātu sokena aṭṭitoti. ",
  "ja454:3.1": "Kin nu ummattarūpo va ",
  "ja454:3.2": "kevalaṃ Dvārakaṃ imaṃ ",
  "ja454:3.3": "saso sasoti lapasi, ",
  "ja454:3.4": "ko nu te sasam āharīti. ",
  "ja454:4.1": "Sovaṇṇamayaṃ maṇīmayaṃ (cfr. supra p. 60.) ",
  "ja454:4.2": "lohamayaṃ atha rūpiyāmayaṃ ",
  "ja454:4.3": "saṃkhasilāpavāḷamayaṃ ",
  "ja454:4.4": "kārayissāmi te sasaṃ. ",
  "ja454:5.1": "Santi aññe pi sasakā ",
  "ja454:5.2": "araññe vanagocarā, ",
  "ja454:5.3": "te pi te ānayissāmi, ",
  "ja454:5.4": "kīdisaṃ sasam icchasīti. ",
  "ja454:6.1": "Na vāham etaṃ icchāmi ",
  "ja454:6.2": "ye sasā paṭhaviṃ sitā, ",
  "ja454:6.3": "candato sasam icchāmi, ",
  "ja454:6.4": "tam me ohara Kesavāti. ",
  "ja454:7.1": "So nūna madhuraṃ ñāti ",
  "ja454:7.2": "jīvitaṃ vijahissasi ",
  "ja454:7.3": "apatthiyaṃ yo patthayasi ",
  "ja454:7.4": "candato sasam icchasīti. ",
  "ja454:8.1": "Evaṃ ce Kaṇha jānāsi ",
  "ja454:8.2": "yad' aññam anusāsasi ",
  "ja454:8.3": "kasmā pure mataṃ puttaṃ ",
  "ja454:8.4": "ajjāpi-m-anusocasīti. ",
  "ja454:9.1": "Yaṃ na labbhā manussena ",
  "ja454:9.2": "amanussena vā puna ",
  "ja454:9.3": "jāto me mā marī putto ",
  "ja454:9.4": "kuto labbhā alabbhiyaṃ. ",
  "ja454:10.1": "Na mantā mūlabhesajjā ",
  "ja454:10.2": "osadhehi dhanena vā ",
  "ja454:10.3": "sakkā ānayituṃ Kaṇha ",
  "ja454:10.4": "yaṃ petam anusocasīti. ",
  "ja454:11.1": "Yassa etādisā assu ",
  "ja454:11.2": "amaccā purisapaṇḍitā ",
  "ja454:11.3": "yathā nijjhāpaye ajja ",
  "ja454:11.4": "Ghato purisapaṇḍito --. ",
  "ja454:12.1": "Ādittaṃ vata maṃ santaṃ ",
  "ja454:12.2": "--pe-- ",
  "ja454:12.3": "(cfr. supra ",
  "ja454:12.4": "p. 61.) ",
  "ja454:13.1": "Abbahi vata me sallaṃ ",
  "ja454:13.2": "",
  "ja454:13.3": "",
  "ja454:13.4": "--pe-- ",
  "ja454:14.1": "So 'haṃ abbūḷhasallo 'smi ",
  "ja454:14.2": "vītasoko anāvilo ",
  "ja454:14.3": "na socāmi na rodāmi ",
  "ja454:14.4": "tava sutvāna māṇavāti ",
  "ja454:15.1": "Evaṃ karonti sappaññā ",
  "ja454:15.2": "ye honti anukampakā ",
  "ja454:15.3": "vinivattayanti sokamhā ",
  "ja454:15.4": "Ghato jeṭṭhaṃ va bhātaranti ",
  "ja454:16.1": "",
  "ja454:17.1": "",
  "ja454:18.1": "",
  "ja454:19.1": "",
  "ja454:19.2": "",
  "ja454:19.3": "",
  "ja454:19.4": ""
}
