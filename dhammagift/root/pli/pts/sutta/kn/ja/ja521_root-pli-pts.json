  "ja521:1.1": "",
  "ja521:2.1": "taṃ pucchāmi, ",
  "ja521:2.2": "sakuṇa bhaddam atthu te, ",
  "ja521:2.3": "rajjaṃ kāretukāmena ",
  "ja521:2.4": "kiṃ su kiccaṃ kataṃ varanti. ",
  "ja521:3.1": "Cirassaṃ vata maṃ tāto ",
  "ja521:3.2": "Kaṃso Bārāṇasiggaho ",
  "ja521:3.3": "pamatto appamattaṃ maṃ ",
  "ja521:3.4": "pitā puttaṃ acodayīti. ",
  "ja521:4.1": "Paṭhamen' eva vitathaṃ ",
  "ja521:4.2": "kodhaṃ hāsaṃ nivāraye, ",
  "ja521:4.3": "tato kiccāni kāreyya, ",
  "ja521:4.4": "taṃ vataṃ āhu khattiya. ",
  "ja521:5.1": "Yaṃ tvaṃ tāta tape kammaṃ ",
  "ja521:5.2": "pubbe katam asaṃsayaṃ ",
  "ja521:5.3": "ratto duṭṭho ca yaṃ kayirā ",
  "ja521:5.4": "na taṃ kayirā tato punaṃ. ",
  "ja521:6.1": "Khattiyassa pamattassa ",
  "ja521:6.2": "raṭṭhasmiṃ raṭṭhavaddhana ",
  "ja521:6.3": "sabbe bhogā vinassanti, ",
  "ja521:6.4": "rañño taṃ vuccate aghaṃ. ",
  "ja521:7.1": "Sirī ca tāta Lakkhī ca ",
  "ja521:7.2": "pucchitā etad abravuṃ: ",
  "ja521:7.3": "uṭṭhānaviriye pose ",
  "ja521:7.4": "ram' āhaṃ anusuyyake. ",
  "ja521:8.1": "Ussuyyake duhadaye ",
  "ja521:8.2": "purise kammadussake ",
  "ja521:8.3": "kālakaṇṇī mahārāja ",
  "ja521:8.4": "ramati cakkabhañjanī. ",
  "ja521:9.1": "So [tvaṃ] sabbesaṃ suhadayo ",
  "ja521:9.2": "sabbesaṃ rakkhito bhava, ",
  "ja521:9.3": "alakkhiṃ nuda mahārāja ",
  "ja521:9.4": "lakkhī bhava nivesanaṃ. ",
  "ja521:10.1": "Salakkhi dhitisampanno ",
  "ja521:10.2": "puriso hi mahaggato ",
  "ja521:10.3": "amittānaṃ Kāsipati ",
  "ja521:10.4": "mūlaṃ aggañ ca chindati. ",
  "ja521:11.1": "Sakko pi hi bhūtapati ",
  "ja521:11.2": "uṭṭhāne na-ppamajjati ",
  "ja521:11.3": "sa kalyāṇe dhitiṃ katvā ",
  "ja521:11.4": "uṭṭhāne kurute mano. ",
  "ja521:12.1": "Gandhabbā pitaro devā ",
  "ja521:12.2": "sañjīvā honti tādino, ",
  "ja521:12.3": "uṭṭhahato appamajjato ",
  "ja521:12.4": "anutiṭṭhanti devatā. ",
  "ja521:13.1": "So appamatto akkuṭṭho ",
  "ja521:13.2": "tāta kiccāni kāraye ",
  "ja521:13.3": "vāyamassu ca kiccesu, ",
  "ja521:13.4": "nālaso vindate sukhaṃ. ",
  "ja521:14.1": "Tatth' eva te vattapadā ",
  "ja521:14.2": "esā ca anusāsanī ",
  "ja521:14.3": "alaṃ mitte sukhāpetuṃ ",
  "ja521:14.4": "amittānaṃ dukkhāya cāti. ",
  "ja521:15.1": "Sakkhī tuvaṃ Kuṇḍalini ",
  "ja521:15.2": "maññasi khattiyabandhunī: ",
  "ja521:15.3": "rajjaṃ kāretukāmena ",
  "ja521:15.4": "kiṃ su kiccaṃ kataṃ varanti g. ā. ",
  "ja521:16.1": "Dve va tāta padakāni ",
  "ja521:16.2": "yesu sabbaṃ patiṭṭhitaṃ ",
  "ja521:16.3": "aladhassa ca yo lābho ",
  "ja521:16.4": "laddhassa anurakkhanā. ",
  "ja521:17.1": "Amacce tāta jānāhi ",
  "ja521:17.2": "dhīre atthassa kovide ",
  "ja521:17.3": "anakkh' ākitave tāta ",
  "ja521:17.4": "asoṇḍe avināsake. ",
  "ja521:18.1": "Yo ca taṃ tāta rakkheyya ",
  "ja521:18.2": "dhanaṃ yañ c' eva te siyā ",
  "ja521:18.3": "sūto va rathaṃ saṃgaṇhe ",
  "ja521:18.4": "so te kiccāni kāraye. ",
  "ja521:19.1": "Susaṃgahītantajano ",
  "ja521:19.2": "sayaṃ cittaṃ avekkhiya ",
  "ja521:19.3": "nidhiñ ca iṇadānañ ca ",
  "ja521:19.4": "na kare parapattiyā. ",
  "ja521:20.1": "Sayaṃ āyavayaṃ jaññā, ",
  "ja521:20.2": "sayaṃ jaññā katākataṃ, ",
  "ja521:20.3": "niggaṇhe niggahārahaṃ, ",
  "ja521:20.4": "paggaṇhe paggahārahaṃ. ",
  "ja521:21.1": "Sayaṃ jānapadaṃ atthaṃ ",
  "ja521:21.2": "anusāsa rathesabha, ",
  "ja521:21.3": "mā te adhammikā yuttā ",
  "ja521:21.4": "dhanaṃ raṭṭhañ ca nāsayuṃ. ",
  "ja521:22.1": "Mā ca vegena kiccāni ",
  "ja521:22.2": "kāresi kārayesi vā, ",
  "ja521:22.3": "vegasā hi kataṃ kammaṃ ",
  "ja521:22.4": "mando pacchānutappati. ",
  "ja521:23.1": "Mā te avisare muñca ",
  "ja521:23.2": "subāḷham adhikodhitaṃ, ",
  "ja521:23.3": "kodhasā hi bahū pi tā ",
  "ja521:23.4": "kulā akulataṃ gatā. ",
  "ja521:24.1": "Mā tāta issaro 'mhīti ",
  "ja521:24.2": "anatthāya patārayi, ",
  "ja521:24.3": "itthīnaṃ purisānañ ca ",
  "ja521:24.4": "mā te āsi dukhudrayo. ",
  "ja521:25.1": "Apetalomahaṃsassa ",
  "ja521:25.2": "rañño kāmānusārino ",
  "ja521:25.3": "sabbe bhogā vinassanti, ",
  "ja521:25.4": "rañño taṃ vuccate aghaṃ. ",
  "ja521:26.1": "Tatth' eva te vattapadā ",
  "ja521:26.2": "esā ca anusāsanī, ",
  "ja521:26.3": "dakkh' assu dāni puññakaro ",
  "ja521:26.4": "asoṇḍo avināsako, ",
  "ja521:26.5": "sīlav' assu mahārāja, ",
  "ja521:26.6": "dussīlo vinipātakoti. ",
  "ja521:27.1": "Apucchamhāpi kosikaṃ ",
  "ja521:27.2": "Kuṇḍaliniñ ca tath' eva, Jambuka ",
  "ja521:27.3": "tvaṃ dāni vadehi ",
  "ja521:27.4": "balānaṃ balam uttamanti g. ā. ",
  "ja521:28.1": "Balaṃ pañcavidhaṃ loke ",
  "ja521:28.2": "purisasmiṃ mahaggate, ",
  "ja521:28.3": "tattha bāhābalaṃ nāma ",
  "ja521:28.4": "carimaṃ vuccate balaṃ, ",
  "ja521:29.1": "bhogabalañ ca dīghāvu ",
  "ja521:29.2": "dutiyaṃ vuccate balaṃ, ",
  "ja521:29.3": "Amaccabalañ ca dīghāvu ",
  "ja521:29.4": "tatiyaṃ vuccate balaṃ, ",
  "ja521:30.1": "abhijaccabalañ c' eva ",
  "ja521:30.2": "taṃ catutthaṃ asaṃsayaṃ, ",
  "ja521:30.3": "yāni c' etāni sabbāni ",
  "ja521:30.4": "adhigaṇhāti paṇḍito ",
  "ja521:31.1": "Taṃ balānaṃ balaṃ seṭṭhaṃ ",
  "ja521:31.2": "aggaṃ paññābalaṃ balaṃ, ",
  "ja521:31.3": "paññābalen' upatthaddho ",
  "ja521:31.4": "atthaṃ vindati paṇḍito. ",
  "ja521:32.1": "Api ce labhati mando ",
  "ja521:32.2": "phītaṃ dharaṇim uttamaṃ ",
  "ja521:32.3": "akāmassa pasayhaṃ vā ",
  "ja521:32.4": "añño taṃ paṭipajjati. ",
  "ja521:33.1": "Abhijāto pi ce hoti ",
  "ja521:33.2": "rajjaṃ laddhāna khattiyo ",
  "ja521:33.3": "duppañño hi Kāsipati ",
  "ja521:33.4": "sabbena pi na jīvati. ",
  "ja521:34.1": "Paññā sutavinicchinī ",
  "ja521:34.2": "paññā [kitti] silokavaddhanī, ",
  "ja521:34.3": "paññāsahito naro idha ",
  "ja521:34.4": "[api] dukkhe sukhāni vindati. ",
  "ja521:35.1": "Paññañ ca kho asussūsaṃ ",
  "ja521:35.2": "na koci adhigacchati ",
  "ja521:35.3": "bahussutaṃ anāgamma ",
  "ja521:35.4": "dhammaṭṭhaṃ avinibbhujaṃ. ",
  "ja521:36.1": "Yo dhammañ ca vibhāgaññū ",
  "ja521:36.2": "kāluṭṭhāyī atandito ",
  "ja521:36.3": "anuṭṭhahati kālena ",
  "ja521:36.4": "kammaphalaṃ tassa ijjhati. ",
  "ja521:37.1": "Nānāyatanasīlassa ",
  "ja521:37.2": "nānāyatanasevino ",
  "ja521:37.3": "na nibbindiyakārissa ",
  "ja521:37.4": "samma-d-attho vipaccati. ",
  "ja521:38.1": "Ajjhattañ ca payuttassa ",
  "ja521:38.2": "tathāyatanasevino ",
  "ja521:38.3": "anibbindiyakārissa ",
  "ja521:38.4": "samma-d-attho vipaccati. ",
  "ja521:39.1": "Yogappayogasaṃkhātaṃ ",
  "ja521:39.2": "sambhatassānurakkhanaṃ ",
  "ja521:39.3": "tāni tvaṃ tāta sevassu, ",
  "ja521:39.4": "mā akammāya randhayi, ",
  "ja521:39.5": "akammanā hi dummedho ",
  "ja521:39.6": "naḷāgāraṃ va sīdatīti. ",
  "ja521:40.1": "Dhammañ cara mahārāja ",
  "ja521:40.2": "mātāpitusu khattiya, (IV p. 421.) (cfr. Mahāvastu I p.282) ",
  "ja521:40.3": "idha dhammaṃ caritvāna ",
  "ja521:40.4": "rāja saggaṃ gamissasi. ",
  "ja521:41.1": "Dhammañ cara mahārāja ",
  "ja521:41.2": "puttadāresu khattiya ",
  "ja521:41.3": "--pe--. ",
  "ja521:41.4": "Dhammañ ",
  "ja521:42.1": "cara mahārāja ",
  "ja521:42.2": "mittāmaccesu khattiya ",
  "ja521:42.3": "--pe--. ",
  "ja521:42.4": "Dhammañ ",
  "ja521:43.1": "cara mahārāja ",
  "ja521:43.2": "vahanesu balesu ca ",
  "ja521:43.3": "--pe--. ",
  "ja521:43.4": "Dhammañ ",
  "ja521:44.1": "cara mahārāja ",
  "ja521:44.2": "gāmesu nigamesu ca ",
  "ja521:44.3": "--pe--. ",
  "ja521:45.1": "Dhammañ cara mahārāja ",
  "ja521:45.2": "raṭṭhe janapadesu ca ",
  "ja521:45.3": "--pe--. ",
  "ja521:46.1": "Dhammañ cara mahārāja ",
  "ja521:46.2": "samaṇabrāhmaṇesu ca ",
  "ja521:46.3": "--pe--. ",
  "ja521:47.1": "Dhammañ cara mahāraja ",
  "ja521:47.2": "migapakkhisu khattiya ",
  "ja521:47.3": "--pe--. ",
  "ja521:47.4": "Dhammañ ",
  "ja521:48.1": "cara mahārāja, ",
  "ja521:48.2": "dhammo ciṇṇo sukhāvaho, ",
  "ja521:48.3": "idha dhammaṃ caritvāna ",
  "ja521:48.4": "rāja saggaṃ gamissasi. ",
  "ja521:49.1": "Dhammañ cara mahārāja ",
  "ja521:49.2": "Indo devā sabrahmakā ",
  "ja521:49.3": "suciṇṇena divaṃ pattā, ",
  "ja521:49.4": "mā dhammaṃ rāja pamādoti. Tatth' ",
  "ja521:50.1": "ev' ete vattapadā ",
  "ja521:50.2": "esā ca anusāsanī ",
  "ja521:50.3": "sappaññe sevi kalyāṇi ",
  "ja521:50.4": "samattaṃ sāmataṃ vidūti. Alaṃkatā ",
  "ja521:51.1": ""
}
