  "ja155:1.1": "Jīva vassasataṃ Gagga ",
  "ja155:1.2": "aparāni ca vīsatiṃ, ",
  "ja155:1.3": "mā maṃ pisācā khādantu, ",
  "ja155:1.4": "jīva tvaṃ sarado satanti. ",
  "ja155:2.1": "Tvam pi vassasataṃ jīva ",
  "ja155:2.2": "aparāni ca vīsatiṃ, ",
  "ja155:2.3": "visaṃ pisācā khādantu, ",
  "ja155:2.4": "jīva tvaṃ sarado satanti. ",
  "ja155:3.1": ""
}
