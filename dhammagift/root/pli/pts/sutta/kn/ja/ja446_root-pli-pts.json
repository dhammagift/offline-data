  "ja446:0.3": "",
  "ja446:0.4": "",
  "ja446:1.1": "Na takkaḷā santi na ālupāni ",
  "ja446:1.2": "na biḷāliyo na kalambāni tāta, ",
  "ja446:1.3": "eko araññamhi susānamajjhe ",
  "ja446:1.4": "kimatthiko tāta khaṇāsi kāsunti. ",
  "ja446:2.1": "Pitāmaho tāta sudubbalo te ",
  "ja446:2.2": "anekavyādhīhi dukhena phuṭṭho, ",
  "ja446:2.3": "tam ajj' ahaṃ nikhaṇissāmi sobbhe, ",
  "ja446:2.4": "na hi 'ssa taṃ jīvitaṃ rocayāmīti. Saṃkappam ",
  "ja446:3.1": "etaṃ paṭiladdha pāpaṃ ",
  "ja446:3.2": "accāhitaṃ kamma karosi luddanti. ",
  "ja446:3.3": "Mayāpi tāta paṭilacchase tuvaṃ ",
  "ja446:3.4": "etādisaṃ kamma jarūpanīto, ",
  "ja446:3.5": "taṃ kullavattaṃ anuvattamāno ",
  "ja446:3.6": "aham pi taṃ nikhaṇissāmi sobbheti. ",
  "ja446:4.1": "Pharusāhi vācāhi pakubbamāno ",
  "ja446:4.2": "āsajja maṃ tvaṃ vadase kumārā, ",
  "ja446:4.3": "putto mama orasako samāno ",
  "ja446:4.4": "ahitānukampi me tvaṃ si puttāti. ",
  "ja446:5.1": "Na t' āhaṃ tāta ahitānukampi ",
  "ja446:5.2": "hitānukampi te aham pi tāta, ",
  "ja446:5.3": "pāpañ ca taṃ kamma pakubbamānaṃ ",
  "ja446:5.4": "arahāmi no vārayituṃ tato hi. ",
  "ja446:6.1": "Yo mātaraṃ pitaraṃ vā Vasiṭṭha ",
  "ja446:6.2": "adūsake hiṃsati pāpadhammo ",
  "ja446:6.3": "kāyassa bhedā abhisamparāyaṃ ",
  "ja446:6.4": "asaṃsayaṃ so nirayaṃ pareti. ",
  "ja446:7.1": "Yo mātaraṃ pitaraṃ vā Vasiṭṭha ",
  "ja446:7.2": "annena pānena upaṭṭhahāti ",
  "ja446:7.3": "",
  "ja446:7.4": "",
  "ja446:8.1": "Na me tvaṃ putta ahitānukampī ",
  "ja446:8.2": "hitānukampi me tvaṃ si putta, ",
  "ja446:8.3": "ahañ ca taṃmātarā vuccamāno ",
  "ja446:8.4": "etādisaṃ kamma karomi luddanti. ",
  "ja446:9.1": "Yā te sā bhariyā anariyārūpā ",
  "ja446:9.2": "mātā mam' esā sakiyā janettī ",
  "ja446:9.3": "niddhāpaye taṃ sakā agārā, ",
  "ja446:9.4": "(cfr. 41|26, III 99|8) aññam pi te sā dukkham āvaheyyāti. ",
  "ja446:10.1": "Yā te sā bhariyā anariyarūpā ",
  "ja446:10.2": "mātā mam' esā sakiyā janettī ",
  "ja446:10.3": "dantā kaṇerū va vasūpanītā ",
  "ja446:10.4": "sā pāpadhammā punar' āvajātūti. ",
  "ja446:11.1": ""
}
