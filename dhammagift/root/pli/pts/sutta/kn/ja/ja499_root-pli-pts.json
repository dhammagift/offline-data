{
  "ja499:0.1": "",
  "ja499:0.2": "",
  "ja499:0.3": "",
  "ja499:0.4": "",
  "ja499:1.1": "Dūre apassan thero va ",
  "ja499:1.2": "cakkhuṃ yācitum āgato, ",
  "ja499:1.3": "ekanettā bhavissāma, ",
  "ja499:1.4": "cakkhum me dehi yācito to. ",
  "ja499:2.1": "Kenānusiṭṭho idha-m-āgato si ",
  "ja499:2.2": "vanibbaka cakkhupathāni yācituṃ, ",
  "ja499:2.3": "suduccajaṃ yācasi uttamaṅgaṃ ",
  "ja499:2.4": "yam āhu nettaṃ purisena duccajanti. ",
  "ja499:3.1": "Yaṃ āhu devesu Sujampatīti ",
  "ja499:3.2": "Maghavāti naṃ āhu manussaloke, ",
  "ja499:3.3": "",
  "ja499:3.4": "Vanibbako ",
  "ja499:4.1": "mayha vaṇiṃ anuttaraṃ: ",
  "ja499:4.2": "dadāhi me cakkhupathāni yācito, ",
  "ja499:4.3": "dadāhi me cakkhupathaṃ anuttaraṃ ",
  "ja499:4.4": "yam āhu nettaṃ purisena duccayaṃ. ",
  "ja499:5.1": "Yena atthena āgañchi ",
  "ja499:5.2": "yam attham abhipatthayaṃ ",
  "ja499:5.3": "te te ijjhantu saṃkappā: ",
  "ja499:5.4": "labha cakkhūni brāhmaṇa. ",
  "ja499:6.1": "Ekan te yācamānassa ",
  "ja499:6.2": "ubhayāni dadām' ahaṃ, ",
  "ja499:6.3": "sa cakkhumā gaccha janassa pekkhato, ",
  "ja499:6.4": "yad icchase tvaṃ tan te samijjhatūti. ",
  "ja499:7.1": "Mā no deva adā cakkhuṃ, ",
  "ja499:7.2": "mā no sabbe parākari, ",
  "ja499:7.3": "dhanaṃ dehi mahārāja ",
  "ja499:7.4": "muttā veḷuriyā bahū. ",
  "ja499:8.1": "Yutte deva rathe dehi ",
  "ja499:8.2": "ājānīye c' alaṃkate, ",
  "ja499:8.3": "nāge dehi mahārāja ",
  "ja499:8.4": "hemakappanavāsase. ",
  "ja499:9.1": "Yathā taṃ Sivayo sabbe ",
  "ja499:9.2": "sayoggā sarathā sadā ",
  "ja499:9.3": "samantā parikareyyuṃ ",
  "ja499:9.4": "evaṃ dehi rathesabhāti. ",
  "ja499:10.1": "Yo ve dassanti vatvāna ",
  "ja499:10.2": "adāne kurute mano ",
  "ja499:10.3": "bhumyā so patitaṃ pāsaṃ ",
  "ja499:10.4": "gīvāya paṭimuñcati. ",
  "ja499:11.1": "Yo ve dassanti vatvāna ",
  "ja499:11.2": "adāne kurute mano ",
  "ja499:11.3": "pāpā pāpataro hoti ",
  "ja499:11.4": "sampatto Yamasādanaṃ. Yaṃ ",
  "ja499:12.1": "hi yāce taṃ hi dade, ",
  "ja499:12.2": "yaṃ na yāce na taṃ dade, ",
  "ja499:12.3": "sv-āhaṃ tam eva dassāmi ",
  "ja499:12.4": "yaṃ maṃ yācati brāhmaṇoti. ",
  "ja499:13.1": "Āyun nu vaṇṇan nu sukhaṃ balan nu ",
  "ja499:13.2": "kiṃ patthayāno nu janinda desi, ",
  "ja499:13.3": "kathaṃ hi rājā Sivinaṃ anuttaro ",
  "ja499:13.4": "cakkhūni dajjā parolokahetūti gātham āhaṃsu. ",
  "ja499:14.1": "Na v' āham etaṃ yasasā dadāmi, ",
  "ja499:14.2": "na puttam icche na dhanaṃ na raṭṭhaṃ, ",
  "ja499:14.3": "satañ ca dhammo carito purāṇo, ",
  "ja499:14.4": "icc-eva dāne ramate mano mamanti. ",
  "ja499:14.5": "",
  "ja499:15.1": "Sakhā ca mitto ca mamāsi Sīvaka ",
  "ja499:15.2": "susikkhito, sādhukarohi me vaco, ",
  "ja499:15.3": "laddhatvañ cakkhūni mamaṃ jigiṃsato ",
  "ja499:15.4": "hatthesu ṭhapehi vanibbakassāti. ",
  "ja499:16.1": "Codito Sivirājena ",
  "ja499:16.2": "Sivako vacanaṃkaro ",
  "ja499:16.3": "rañño cakkhūni uddhatvā ",
  "ja499:16.4": "brāhmaṇass' upanāmaye, ",
  "ja499:16.5": "sacakkhu brāhmaṇo āsi, ",
  "ja499:16.6": "andho rājā upāvisīti. ",
  "ja499:17.1": "Tato so katipāhassa ",
  "ja499:17.2": "uparūḷhesu cakkhusu ",
  "ja499:17.3": "sūtaṃ āmantayi rājā ",
  "ja499:17.4": "Sivīnaṃ raṭṭhavaddhano: ",
  "ja499:18.1": "Yojehi sārathi yānaṃ, ",
  "ja499:18.2": "yuttañ ca paṭivedaya, ",
  "ja499:18.3": "uyyānabhūmiṃ gacchāma ",
  "ja499:18.4": "pokkharaññe vanāni ca. ",
  "ja499:19.1": "So ca pokkharaṇiyā tīre ",
  "ja499:19.2": "pallaṃkena upāvisi, ",
  "ja499:19.3": "tassa Sakko pātur ahu ",
  "ja499:19.4": "devarājā Sujampatīti ",
  "ja499:20.1": "Sakko 'ham asmi devindo, ",
  "ja499:20.2": "āgato 'smi tav' antike, ",
  "ja499:20.3": "varaṃ varassu rājīsi ",
  "ja499:20.4": "yaṃ kiñci manas' icchasūti ",
  "ja499:21.1": "Pahūtam me dhanaṃ Sakka ",
  "ja499:21.2": "balaṃ koso c' anappako, ",
  "ja499:21.3": "andhassa me sato dāni ",
  "ja499:21.4": "maraṇaṃ ñeva ruccatīti. ",
  "ja499:22.1": "Yāni saccāni dipadinda ",
  "ja499:22.2": "tāni bhāsassu khattiya, ",
  "ja499:22.3": "saccan te bhaṇamānassa ",
  "ja499:22.4": "puna cakkhuṃ bhavissatīti āha. ",
  "ja499:23.1": "Ye maṃ yācitum āyanti ",
  "ja499:23.2": "nānāgottā vanibbakā ",
  "ja499:23.3": "yo pi maṃ yācate tattha ",
  "ja499:23.4": "so pi me manaso piyo, ",
  "ja499:23.5": "etena saccavajjena ",
  "ja499:23.6": "cakkhuṃ me upapajjathāti ",
  "ja499:24.1": "Yaṃ maṃ so yācituṃ āgā ",
  "ja499:24.2": "dehi cakkhunti brāhmaṇo ",
  "ja499:24.3": "tassa cakkhūni pādāsiṃ ",
  "ja499:24.4": "brāhmaṇassa vanibbino. ",
  "ja499:25.1": "Bhiyyo maṃ āvisi pīti ",
  "ja499:25.2": "somanassañ c' anappakaṃ, ",
  "ja499:25.3": "etena saccavajjena ",
  "ja499:25.4": "dutiyaṃ me upapajjathāti ",
  "ja499:26.1": "Dhammena bhāsitā gāthā ",
  "ja499:26.2": "Sivīnaṃ raṭṭhavaddhana, ",
  "ja499:26.3": "etāni tava nettāni ",
  "ja499:26.4": "dibbāni paṭidiyyare. ",
  "ja499:27.1": "Tirokuḍḍaṃ tiroselaṃ ",
  "ja499:27.2": "samatiggayha pabbataṃ ",
  "ja499:27.3": "samantā yojanasataṃ ",
  "ja499:27.4": "dassanaṃ anubhontu teti ",
  "ja499:28.1": "Ko n' īdha vittaṃ na dadeyya yācito ",
  "ja499:28.2": "api visiṭṭhaṃ supiyam pi attano. ",
  "ja499:28.3": "tad iṃgha sabbe Sivayo samāgatā ",
  "ja499:28.4": "dibbāni nettāni mam' ajja passatha. ",
  "ja499:29.1": "Tirokuḍḍaṃ tiroselaṃ ",
  "ja499:29.2": "samatiggayha pabbataṃ ",
  "ja499:29.3": "samantā yojanasataṃ ",
  "ja499:29.4": "dassanaṃ anubhonti me. ",
  "ja499:30.1": "Na cāgamattā param atthi kiñci ",
  "ja499:30.2": "maccānaṃ idha jīvite, ",
  "ja499:30.3": "datvāna mānusaṃ cakkhuṃ ",
  "ja499:30.4": "laddham [me] cakkhuṃ amānusaṃ. ",
  "ja499:31.1": "Etam pi disvā Sivayo ",
  "ja499:31.2": "detha dānāni bhuñjatha, ",
  "ja499:31.3": "datvā ca bhutvā ca yathānubhāvaṃ ",
  "ja499:31.4": "aninditā saggam upetha ṭhānanti. ",
  "ja499:32.1": ""
}
