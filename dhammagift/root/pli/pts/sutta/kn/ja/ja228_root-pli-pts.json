  "ja228:1.1": "Tayo giriṃ antaraṃ kāmayāmi: ",
  "ja228:1.2": "Pañcālā Kuruyo Kekake ca, ",
  "ja228:1.3": "tatuttariṃ brāhmaṇa kāmayāmi , ",
  "ja228:1.4": "tikiccha maṃ brāhmaṇa kāmanītanti. ",
  "ja228:2.1": "Kaṇhāhi daṭṭhassa karonti h' eke, ",
  "ja228:2.2": "amanussavaddhassa karonti paṇḍitā, ",
  "ja228:2.3": "na kāmanītassa karoti koci, ",
  "ja228:2.4": "okkantasukkassa hi kā tikicchāti. ",
  "ja228:3.1": ""
}
