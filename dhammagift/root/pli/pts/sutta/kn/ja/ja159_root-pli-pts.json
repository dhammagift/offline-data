  "ja159:1.1": "cakkhumā ekarājā ",
  "ja159:1.2": "harissavaṇṇo paṭhavippabhāso; ",
  "ja159:1.3": "taṃ taṃ namassāmi harissavaṇṇaṃ paṭhavippabhāsaṃ, ",
  "ja159:1.4": "tay' ajja guttā viharemu divasanti. ",
  "ja159:2.1": "Ye brāhmaṇā vedagū sabbadhamme ",
  "ja159:2.2": "te me namo te ca maṃ pālayantu; ",
  "ja159:2.3": "nam' atthu Buddhānaṃ, nam' atthu bodhiyā, ",
  "ja159:2.4": "namo vimuttānaṃ, namo vimuttiyā. ",
  "ja159:2.5": "",
  "ja159:2.6": "",
  "ja159:3.1": "Apet' ayaṃ cakkhumā ekarājā ",
  "ja159:3.2": "harissavaṇṇo paṭhavippabhāso; ",
  "ja159:3.3": "taṃ taṃ namassāmi harissavaṇṇaṃ paṭhavippabhāsaṃ, ",
  "ja159:3.4": "tay' ajja guttā viharemu rattiṃ. ",
  "ja159:4.1": "Ye brāhmaṇā vedagū sabbadhamme ",
  "ja159:4.2": "te me nāmo te ca maṃ pālayantu; ",
  "ja159:4.3": "nam' atthu buddhānaṃ, nam' atthu bodhiyā, ",
  "ja159:4.4": "namo vimuttānaṃ, namo vimuttiyā. ",
  "ja159:4.5": "Evam ",
  "ja159:4.6": "eva ",
  "ja159:5.1": ""
}
