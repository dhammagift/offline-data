  "ja157:0.4": "",
  "ja157:1.1": "Yenakāmaṃ paṇāmeti, ",
  "ja157:1.2": "dhammo balavataṃ, migī ",
  "ja157:1.3": "unnadanti, vijānāhi, ",
  "ja157:1.4": "jātaṃ saraṇato bhayanti. ",
  "ja157:2.1": "Api ce pi dubbalo mitto ",
  "ja157:2.2": "mittadhammesu tiṭṭhati ",
  "ja157:2.3": "so ñātako ca bandhu ca ",
  "ja157:2.4": "so mitto so ca me sakhā; ",
  "ja157:2.5": "dāṭhini, mātimaññittho, ",
  "ja157:2.6": "sigālo mama pāṇadoti. ",
  "ja157:3.1": ""
}
