  "ja287:0.4": "",
  "ja287:1.1": "Nānummatto nāpisuṇo ",
  "ja287:1.2": "nānaṭo nākutūhalo ",
  "ja287:1.3": "mūḷhesu labhate lābhaṃ, ",
  "ja287:1.4": "esā te anusāsanīti. ",
  "ja287:2.1": "Dhi-r-atthu taṃ yasalābhaṃ ",
  "ja287:2.2": "dhanalābhañ ca brāhmaṇa ",
  "ja287:2.3": "yā vutti vinipātena ",
  "ja287:2.4": "adhammacaraṇena vā. ",
  "ja287:3.1": "Api ce pattam ādāya ",
  "ja287:3.2": "anāgāro paribbaje ",
  "ja287:3.3": "esā va jīvikā seyyā ",
  "ja287:3.4": "yā cādhammena esanāti ",
  "ja287:4.1": ""
}
