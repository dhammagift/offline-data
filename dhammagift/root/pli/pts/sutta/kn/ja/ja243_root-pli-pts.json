  "ja243:0.4": "",
  "ja243:1.1": "Sattatantiṃ sumadhuraṃ ",
  "ja243:1.2": "rāmaṇeyyaṃ avācayiṃ, ",
  "ja243:1.3": "so maṃ raṅgamhi avheti, ",
  "ja243:1.4": "saraṇaṃ me hohi Kosiyāti. ",
  "ja243:2.1": "Ahaṃ taṃsaraṇaṃ samma, ",
  "ja243:2.2": "aham ācariyapūjako, ",
  "ja243:2.3": "na taṃ jayissati sisso, ",
  "ja243:2.4": "sissam ācariya jessasīti. ",
  "ja243:3.1": ""
}
