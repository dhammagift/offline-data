  "ja297:0.4": "",
  "ja297:1.1": "Ucce sakuṇa omāna ",
  "ja297:1.2": "pattayāna vihaṅgama ",
  "ja297:1.3": "vajjāsi kho tvaṃ vāmuruṃ, ",
  "ja297:1.4": "ciraṃ kho sā karissati. ",
  "ja297:2.1": "Idaṃ kho sā na jānāti ",
  "ja297:2.2": "asiṃ sattiñ ca oḍḍitaṃ, ",
  "ja297:2.3": "sā caṇḍī kāhati kodhaṃ, ",
  "ja297:2.4": "tam me tapati no idha. ",
  "ja297:3.1": "Esa uppalasannāho ",
  "ja297:3.2": "nikkham ussīsake kataṃ ",
  "ja297:3.3": "kāsiyañ ca muduṃ vatthaṃ, ",
  "ja297:3.4": "tappatu dhanakāmiyāti. ",
  "ja297:4.1": ""
}
