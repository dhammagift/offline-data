  "ja256:1.1": "Jarudapānaṃ khaṇamānā ",
  "ja256:1.2": "vāṇijā udakatthikā ",
  "ja256:1.3": "ajjhagaṃsu ayo lohaṃ ",
  "ja256:1.4": "tipu sīsañ ca vāṇijā ",
  "ja256:1.5": "Rajataṃ jātarūpañ ca ",
  "ja256:1.6": "muttā veḷuriyā bahū; ",
  "ja256:2.1": "te ca tena asantuṭṭhā ",
  "ja256:2.2": "bhiyyo bhiyyo akhāṇisuṃ. ",
  "ja256:2.3": "Te tatthāsīviso ghoro ",
  "ja256:2.4": "tejasī tejasā hani, ",
  "ja256:3.1": "tasmā khaṇe nātikhaṇe, ",
  "ja256:3.2": "atikhātaṃ hi pāpakaṃ, ",
  "ja256:3.3": "khātena ca dhanaṃ laddhaṃ ",
  "ja256:3.4": "atikhātena nāsitanti, ",
  "ja256:4.1": ""
}
