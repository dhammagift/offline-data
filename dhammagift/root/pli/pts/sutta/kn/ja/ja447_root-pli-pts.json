{
  "ja447:0.1": "",
  "ja447:0.2": "",
  "ja447:0.3": "",
  "ja447:0.4": "",
  "ja447:1.1": "Kiṃ te vataṃ kiṃ pana brahmacariyaṃ, ",
  "ja447:1.2": "kissa suciṇṇassa ayaṃ vipāko, ",
  "ja447:1.3": "akkhāhi me brāhmaṇa etam atthaṃ, ",
  "ja447:1.4": "kasmā hi tuyhaṃ daharā na mīyareti. ",
  "ja447:2.1": "Dhammaṃ carāma, na musā bhaṇāma, ",
  "ja447:2.2": "pāpāni kammāni vivajjayāma, ",
  "ja447:2.3": "anariyaṃ parivajjemu sabbaṃ, ",
  "ja447:2.4": "tasmāti amhaṃ daharā na mīyare. ",
  "ja447:3.1": "Suṇoma dhammaṃ asataṃ satañ ca, ",
  "ja447:3.2": "na cāpi dhammaṃ asataṃ rocayāma, ",
  "ja447:3.3": "hitvā asante na jahāma sante, ",
  "ja447:3.4": "tasmā --pe--. ",
  "ja447:4.1": "Pubbe va dānā sumanā bhavāma, ",
  "ja447:4.2": "(J. III p. 300.) dadam pi ce attamanā bhavāma, ",
  "ja447:4.3": "datvāpi ce nānutappāma pacchā ",
  "ja447:4.4": "--pe--. ",
  "ja447:5.1": "Samaṇe mayaṃ brāhmaṇe addhike ca ",
  "ja447:5.2": "vanibbake yācanake dalidde ",
  "ja447:5.3": "annena pānen' abhitappayāma ",
  "ja447:5.4": "--pe--. ",
  "ja447:6.1": "Mayañ ca bhariyaṃ nātikkamāma, ",
  "ja447:6.2": "amhe ca bhariyā nātikkamanti, ",
  "ja447:6.3": "aññatra tāhi brahmacariyaṃ carāma ",
  "ja447:6.4": "--pe--. ",
  "ja447:7.1": "",
  "ja447:7.2": "",
  "ja447:7.3": "",
  "ja447:7.4": "",
  "ja447:8.1": "Etāsu ve jāyare suggavāsu ",
  "ja447:8.2": "medhāvino honti pahūtapaññā ",
  "ja447:8.3": "bahussutā vedaguno ca honti ",
  "ja447:8.4": "--pe--. ",
  "ja447:9.1": "Mātā pitā ca bhaginī bhātaro ca ",
  "ja447:9.2": "puttā ca dārā ca mayañ ca sabbe ",
  "ja447:9.3": "dhammaṃ carāma paralokahetu ",
  "ja447:9.4": "--pe--. ",
  "ja447:10.1": "Dāsā ca dasso anujīvino ca ",
  "ja447:10.2": "paricārikā kammakarā ca sabbe ",
  "ja447:10.3": "",
  "ja447:10.4": "",
  "ja447:11.1": "Dhammo have rakkhati dhammacāriṃ, ",
  "ja447:11.2": "dhammo suciṇṇo sukham āvahāti, ",
  "ja447:11.3": "esānisaṃso dhamme suciṇṇe: ",
  "ja447:11.4": "na duggatiṃ gacchati dhammacārī. ",
  "ja447:12.1": "Dhammo have rakkhati dhammacāriṃ ",
  "ja447:12.2": "chattaṃ mahantaṃ viya vassakāle, ",
  "ja447:12.3": "dhammena gutto mama Dhammapālo, ",
  "ja447:12.4": "aññassa aṭṭhīni, sukhī kumāroti ",
  "ja447:13.1": ""
}
