  "ja177:1.1": "Dhanuhatthakalāpehi ",
  "ja177:1.2": "nettiṃsavaradhāribhi ",
  "ja177:1.3": "samantaparikiṇṇ' amhā, ",
  "ja177:1.4": "kathaṃ mokkho bhavissatīti. ",
  "ja177:2.1": "App-eva bahukiccānaṃ ",
  "ja177:2.2": "attho jāyetha koci naṃ, ",
  "ja177:2.3": "atthi rukkhassa acchinnaṃ, ",
  "ja177:2.4": "khajjataṃ ñeva tiṇḍukanti. ",
  "ja177:3.1": ""
}
