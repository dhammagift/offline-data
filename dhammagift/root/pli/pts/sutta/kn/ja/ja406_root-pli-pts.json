  "ja406:0.4": "",
  "ja406:1.1": "Hitvā gāmasahassāni ",
  "ja406:1.2": "paripuṇṇāni soḷasa ",
  "ja406:1.3": "koṭṭhāgārāni phītāni ",
  "ja406:1.4": "sannidhiṃ dāni kubbasīti. ",
  "ja406:2.1": "Hitvā Gandhāravisayaṃ ",
  "ja406:2.2": "pahūtadhanadhāniyaṃ ",
  "ja406:2.3": "pasāsanāto nikkhanto ",
  "ja406:2.4": "idha dāni pasāsasīti. ",
  "ja406:3.1": "Dhammaṃ bhaṇāmi Vedeha, ",
  "ja406:3.2": "adhammo me na ruccati, ",
  "ja406:3.3": "dhammaṃ me bhaṇamānassa ",
  "ja406:3.4": "na pāpam upalippatīti. ",
  "ja406:4.1": "Yena kenaci vaṇṇena ",
  "ja406:4.2": "paro labhati ruppanaṃ ",
  "ja406:4.3": "mahatthiyampi ce vācaṃ ",
  "ja406:4.4": "na taṃ bhāseyya paṇḍitoti. ",
  "ja406:5.1": "Kāmaṃ ruppatu vā mā vā ",
  "ja406:5.2": "bhusaṃ vā vikiriyyatu, ",
  "ja406:5.3": "dhammaṃ me bhaṇamāssa ",
  "ja406:5.4": "na pāpam upalippatīti. ",
  "ja406:6.1": "Noce assa sakā buddhi ",
  "ja406:6.2": "vinayo vā susikkhito ",
  "ja406:6.3": "vane andhamahiso va ",
  "ja406:6.4": "careyya bahuko jano. ",
  "ja406:7.1": "Yasmā ca pan' idh' ekacce ",
  "ja406:7.2": "ācāramhi susikkhitā ",
  "ja406:7.3": "tasmā vinītavinayā ",
  "ja406:7.4": "caranti susamāhitāti ",
  "ja406:8.1": ""
}
