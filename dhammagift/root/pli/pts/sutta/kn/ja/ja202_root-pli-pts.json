  "ja202:1.1": "Haṃsā koñcā mayūrā ca ",
  "ja202:1.2": "hatthiyo pasadā migā ",
  "ja202:1.3": "sabbe sīhassa bhāyanti, ",
  "ja202:1.4": "n' atthi kāyasmi tulyatā. ",
  "ja202:2.1": "Evam evaṃ manussesu ",
  "ja202:2.2": "daharo ce pi paññavā, ",
  "ja202:2.3": "so hi tattha mahā hoti, ",
  "ja202:2.4": "n' eva bālo sarīravāti. ",
  "ja202:3.1": ""
}
