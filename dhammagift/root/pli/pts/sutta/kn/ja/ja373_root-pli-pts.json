  "ja373:0.4": "",
  "ja373:1.1": "Kuhiṃ gatā kattha gatā ",
  "ja373:1.2": "iti lālappatī jano, ",
  "ja373:1.3": "aham eva eko jānāmi: ",
  "ja373:1.4": "udapāne Mūsikā hatāti Yath' ",
  "ja373:2.1": "etaṃ iti c' īti ca ",
  "ja373:2.2": "gadrabho va nivattasi, ",
  "ja373:2.3": "udapāne Mūsikaṃ hantvā ",
  "ja373:2.4": "yavaṃ bhakkhetum icchasīti ",
  "ja373:3.1": "Daharo c' asi dummedha ",
  "ja373:3.2": "paṭhamuppattito susu, ",
  "ja373:3.3": "dīgham etaṃ samāsajja ",
  "ja373:3.4": "na te dassāmi jīvitanti ",
  "ja373:4.1": "Nāntalikkhabhavanena ",
  "ja373:4.2": "n' aṅgaputtasirena vā ",
  "ja373:4.3": "puttena hi patthayito ",
  "ja373:4.4": "silokehi pamocito. ",
  "ja373:5.1": "Sabbaṃ sutam adhīyetha ",
  "ja373:5.2": "hīnamukkhaṭṭamajjhimaṃ, ",
  "ja373:5.3": "sabbassa attham jāneyya, ",
  "ja373:5.4": "na ca sabbaṃ payojaye, ",
  "ja373:5.5": "hoti tādisako kālo ",
  "ja373:5.6": "yattha atthāvahaṃ sutanti. ",
  "ja373:6.1": ""
}
