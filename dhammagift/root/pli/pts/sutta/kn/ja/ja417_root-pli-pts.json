  "ja417:0.4": "",
  "ja417:1.1": "Odātavatthā suci allakesā ",
  "ja417:1.2": "Kaccāni kiṃ kumbhim apassayitvā ",
  "ja417:1.3": "piṭṭhā tilā dhovasi taṇḍulāni, ",
  "ja417:1.4": "tilodano hohiti kissa hetūti. ",
  "ja417:2.1": "Na kho ayaṃ brāhmaṇa bhojanatthā ",
  "ja417:2.2": "tilodano hohiti sādhupakko, ",
  "ja417:2.3": "dhammo mato, tassa bahūtamajjā ",
  "ja417:2.4": "ahaṃ karissāmi susānamajjheti. ",
  "ja417:3.1": "Anuvicca Kaccāni karohi kiccaṃ, ",
  "ja417:3.2": "dhammo mato, ko nu tav' et' asaṃsi, ",
  "ja417:3.3": "Sahassanetto atulānubhāvo, ",
  "ja417:3.4": "na miyyati dhammavaro kadācīti. ",
  "ja417:4.1": "Daḷhappamāṇaṃ mama ettha brahme, ",
  "ja417:4.2": "dhammo mato, n' atthi mam' ettha kaṃkhā, ",
  "ja417:4.3": "ye ye va dāni pāpā bhavanti ",
  "ja417:4.4": "te te va dāni sukhitā bhavanti. ",
  "ja417:5.1": "Suṇisā hi mayhaṃ vaṃjhā ahosi, ",
  "ja417:5.2": "sā maṃ vadhitvāna vijāyi puttaṃ, ",
  "ja417:5.3": "sā dāni sabbassa kulassa issarā, ",
  "ja417:5.4": "ahaṃ pan' amhi apaviddhā ekikāti. ",
  "ja417:6.1": "Jīvāmi vo 'haṃ, nāhaṃ mato 'smi, ",
  "ja417:6.2": "tav' eva atthāya idhāgato 'smi, ",
  "ja417:6.3": "yā taṃ vadhitvāna vijāyi puttaṃ ",
  "ja417:6.4": "sahā va puttena karomi bhasmanti. Etañ ",
  "ja417:7.1": "ca te ruccati devarāja, ",
  "ja417:7.2": "mam' eva atthāya idhāgato si, ",
  "ja417:7.3": "ahañ ca putto suṇisā ca nattā ",
  "ja417:7.4": "sammodamānā gharam āvasemāti. ",
  "ja417:8.1": "Etañ ca te ruccati Kātiyāni, ",
  "ja417:8.2": "hatāpi santā na jahāsi dhammaṃ, ",
  "ja417:8.3": "tvañ ca putto suṇisā ca nattā ",
  "ja417:8.4": "sammodamānā gharam āvasāthāti. ",
  "ja417:9.1": "Sā Kātiyānī suṇisāya saddhiṃ ",
  "ja417:9.2": "sammodamānā gharam āvasittha, ",
  "ja417:9.3": "putto ca nattā ca upaṭṭhahiṃsu ",
  "ja417:9.4": "devānam indena adhiggahītāti ",
  "ja417:10.1": ""
}
