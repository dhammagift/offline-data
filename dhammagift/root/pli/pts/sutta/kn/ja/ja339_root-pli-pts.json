  "ja339:1.1": "Adassanena morassa ",
  "ja339:1.2": "sikhino mañjubhāṇino ",
  "ja339:1.3": "kākaṃ tattha apūjesuṃ ",
  "ja339:1.4": "maṃsena ca phalena ca. ",
  "ja339:2.1": "Yadā ca sarasampanno ",
  "ja339:2.2": "moro Bāverum āgamā ",
  "ja339:2.3": "atha lābho ca sakkāro ",
  "ja339:2.4": "vāyasassa ahāyatha. ",
  "ja339:3.1": "Yāva n' uppajjati Buddho ",
  "ja339:3.2": "dhammarājā pabhaṃkaro ",
  "ja339:3.3": "tāva aññe apūjesuṃ ",
  "ja339:3.4": "puthū samaṇabrāhmaṇe. ",
  "ja339:4.1": "Yadā ca sarasampanno ",
  "ja339:4.2": "Buddho dhammam adesayi ",
  "ja339:4.3": "atha lābho ca sakkāro ",
  "ja339:4.4": "titthiyānaṃ ahāyathāti. ",
  "ja339:5.1": ""
}
