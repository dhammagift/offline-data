  "ja209:1.1": "Diṭṭhā mayā vane rukkhā ",
  "ja209:1.2": "assakaṇṇavibhīṭakā, ",
  "ja209:1.3": "na tāni evaṃ sakkanti ",
  "ja209:1.4": "yathā tvaṃ rukkha sakkasīti. ",
  "ja209:2.1": "Purāṇakakkaro ayaṃ ",
  "ja209:2.2": "bhetvā pañjaram āgato, ",
  "ja209:2.3": "kusalo vālapāsānaṃ ",
  "ja209:2.4": "apakkamati bhāsatīti. ",
  "ja209:3.1": ""
}
