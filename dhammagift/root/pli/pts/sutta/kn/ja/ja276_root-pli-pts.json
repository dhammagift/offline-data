  "ja276:0.4": "",
  "ja276:1.1": "Tava saddhañ ca sīlañ ca ",
  "ja276:1.2": "viditvāna janādhipa (Dhp. p.417.) ",
  "ja276:1.3": "vaṇṇaṃ añjanavaṇṇeṇa ",
  "ja276:1.4": "Kāliṅgasmiṃ nimimhaseti. ",
  "ja276:2.1": "Annabhaccā c' abhaccā ca ",
  "ja276:2.2": "yo dha uddissa gacchati ",
  "ja276:2.3": "sabbe te appaṭikkhippā, ",
  "ja276:2.4": "pubbācariyavaco idaṃ. ",
  "ja276:3.1": "Dadāmi vo brāhmaṇā nāgam etaṃ ",
  "ja276:3.2": "rājārahaṃ rājabhoggaṃ yasassinaṃ ",
  "ja276:3.3": "alaṃkataṃ hemajālābhichannaṃ ",
  "ja276:3.4": "sasārathiṃ, gacchatha yenakāmanti. ",
  "ja276:4.1": ""
}
