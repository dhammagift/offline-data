{
  "ja511:0.1": "",
  "ja511:0.2": "",
  "ja511:0.3": "",
  "ja511:0.4": "",
  "ja511:1.1": "Kiṃchando kimadhippāyo ",
  "ja511:1.2": "eko sammasi ghammani, ",
  "ja511:1.3": "kiṃ patthayāno kiṃ esaṃ ",
  "ja511:1.4": "kena atthena brāhmaṇāti. ",
  "ja511:2.1": "Yathā mahā vāridharo ",
  "ja511:2.2": "kumbho supariṇāmavā ",
  "ja511:2.3": "tathūpamaṃ ambapakkam ",
  "ja511:2.4": "vaṇṇagandharasuttamaṃ. ",
  "ja511:3.1": "Taṃ vuyhamānaṃ sotena ",
  "ja511:3.2": "disvān' amalamajjhime ",
  "ja511:3.3": "pāṇīhi naṃ gahetvāna ",
  "ja511:3.4": "agyāyatanam āhariṃ. ",
  "ja511:4.1": "Tato kadalipattesu ",
  "ja511:4.2": "nikkhipitvā sayaṃ ahaṃ ",
  "ja511:4.3": "satthena naṃ vikappetvā ",
  "ja511:4.4": "khuppipāsaṃ ahāsi me. ",
  "ja511:5.1": "So 'haṃ apetadaratho ",
  "ja511:5.2": "vyantibhūto dukhakkhamo ",
  "ja511:5.3": "assādaṃ nādhigacchāmi ",
  "ja511:5.4": "phalesv-aññesu kesuci. ",
  "ja511:6.1": "Sosetvā nūna maraṇaṃ ",
  "ja511:6.2": "taṃ mamaṃ āvahissati ",
  "ja511:6.3": "ambaṃ y' assa phalaṃ ",
  "ja511:6.4": "sāduṃ ",
  "ja511:6.5": "[yam uddhariṃ] vuyhamānaṃ ",
  "ja511:6.6": "[udadhismā] mahaṇṇave. ",
  "ja511:7.1": "Akkhātan te mayā sabbaṃ ",
  "ja511:7.2": "yasmā upavasām' aham, ",
  "ja511:7.3": "rammaṃ pati nisinno 'smi, ",
  "ja511:7.4": "puthulomāyutā puthū. ",
  "ja511:8.1": "Tvañ ca kho me va akkhāhi ",
  "ja511:8.2": "attānam apalāyini, ",
  "ja511:8.3": "kā vā tvam asi kalyāni, ",
  "ja511:8.4": "kissa vā tvaṃ sumajjhime. ",
  "ja511:9.1": "Ruppapaṭṭapalimaṭṭhīva ",
  "ja511:9.2": "vyagghīva girisānujā ",
  "ja511:9.3": "yā santi nariyo devesu ",
  "ja511:9.4": "devānaṃ paricārikā ",
  "ja511:10.1": "Yā ca manussalokasmiṃ ",
  "ja511:10.2": "rūpen' anvāgatitthiyo -- ",
  "ja511:10.3": "rūpe te sadisī n' atthi ",
  "ja511:10.4": "devesu gandhabbamanussaloke, ",
  "ja511:10.5": "puṭṭhāsi me, cārupubbaṅgi ",
  "ja511:10.6": "brūhi, akkhāhi me nāmañ ca bandhave cāti. ",
  "ja511:11.1": "Yaṃ tvaṃ pati nisinno si ",
  "ja511:11.2": "rammaṃ brāhmaṇa Kosikiṃ ",
  "ja511:11.3": "sāhaṃ bhusālayā vutthā ",
  "ja511:11.4": "varavārivahoghasā. ",
  "ja511:12.1": "Nānādumagaṇākiṇṇā ",
  "ja511:12.2": "bahukā girikandarā ",
  "ja511:12.3": "mam' eva pamukhā honti, ",
  "ja511:12.4": "abhisandanti pāvuso. ",
  "ja511:13.1": "Atho bahū vanato 'dā ",
  "ja511:13.2": "nīlavārivahindharā ",
  "ja511:13.3": "bahukā nāgavittodā ",
  "ja511:13.4": "abhisandanti vārinā. ",
  "ja511:14.1": "Tā ambajambulabujā ",
  "ja511:14.2": "nipā tālā c' udumbarā ",
  "ja511:14.3": "bahūni phalajātāni ",
  "ja511:14.4": "āvahanti abhiṇhaso. ",
  "ja511:15.1": "Yaṃ kiñci ubhatotīre ",
  "ja511:15.2": "phalaṃ patati ambuhi ",
  "ja511:15.3": "asaṃsayaṃ taṃ sotassa ",
  "ja511:15.4": "phalaṃ hoti vasānugaṃ. ",
  "ja511:16.1": "Etad aññāya medhavi ",
  "ja511:16.2": "puthupañña suṇohi me, ",
  "ja511:16.3": "mā rocaya-m-abhisaṅgam ",
  "ja511:16.4": "paṭisedha janādhipa. ",
  "ja511:17.1": "Na vāhaṃ vaddhavaṃ maññe ",
  "ja511:17.2": "yaṃ tvaṃ raṭṭhābhivaddhana ",
  "ja511:17.3": "āceyyamāno rājisi ",
  "ja511:17.4": "maraṇaṃ abhikaṃkhasi. ",
  "ja511:18.1": "Tassa jānanti pitaro ",
  "ja511:18.2": "gandhabbā ca sadevakā ",
  "ja511:18.3": "ye cāpi isayo loke ",
  "ja511:18.4": "saññatattā yasassino, ",
  "ja511:18.5": "asaṃsayan te jānanti ",
  "ja511:18.6": "vaddhabhūtā yasassinoti. ",
  "ja511:19.1": "Evaṃ viditvā vidū sabbadhammaṃ ",
  "ja511:19.2": "viddhaṃsanaṃ cavanaṃ jīvitassa ",
  "ja511:19.3": "na cīyatī tassa narassa pāpam ",
  "ja511:19.4": "sace na ceteti vadhāya tassa. ",
  "ja511:20.1": "Isipūgasamaññāte ",
  "ja511:20.2": "evaṃ lokyā viditā sati ",
  "ja511:20.3": "anariyaparisaṃbhāse ",
  "ja511:20.4": "pāpakammaṃ jigiṃsasi. ",
  "ja511:21.1": "Sace ahaṃ marissāmi ",
  "ja511:21.2": "tīre te puthusussoṇi ",
  "ja511:21.3": "asaṃsayaṃ asiloko ",
  "ja511:21.4": "mayi pete āgamissati. ",
  "ja511:22.1": "Tasmā hi pāpakaṃ kammaṃ ",
  "ja511:22.2": "rakkhass' eva sumajjhime ",
  "ja511:22.3": "mā taṃ sabbo jano pacchā ",
  "ja511:22.4": "pakatthāsi mayi mateti. ",
  "ja511:23.1": "Aññātam etaṃ avisayhasāhi, ",
  "ja511:23.2": "attānaṃ ambañ ca dadāmi te taṃ ",
  "ja511:23.3": "yo duccaje kāmaguṇe pahāya ",
  "ja511:23.4": "santiñ ca dhammañ ca adhiṭṭhito si. ",
  "ja511:24.1": "Yo hitvā pubbasaṃyogaṃ ",
  "ja511:24.2": "pacchā saṃyojane ṭhito ",
  "ja511:24.3": "adhammañ c' eva carati ",
  "ja511:24.4": "pāpañ c' assa pavaḍḍhati. ",
  "ja511:25.1": "Ehi, taṃ pāpayissāmi, ",
  "ja511:25.2": "kāmaṃ appossuko bhava, ",
  "ja511:25.3": "upanayāmi sītasmiṃ, ",
  "ja511:25.4": "viharāhi anussuko. ",
  "ja511:26.1": "Taṃ puppharasamattehi ",
  "ja511:26.2": "vakkaṅgehi arindama, ",
  "ja511:26.3": "koñcā mayūrā diviyā ",
  "ja511:26.4": "koyaṭṭhimadhusāliyā ",
  "ja511:26.5": "kūjitā haṃsapūgehi ",
  "ja511:26.6": "kokil' ettha pabodhare. ",
  "ja511:27.1": "Amb' ettha vippasūnaggā ",
  "ja511:27.2": "palālakhalasannibhā ",
  "ja511:27.3": "kosumbhasalaḷānīpā pakkatālavilambinoti. ",
  "ja511:27.4": "",
  "ja511:28.1": "Mālī tirīṭī kāyūrī ",
  "ja511:28.2": "aṅgadī candanussado ",
  "ja511:28.3": "rattiṃ tvaṃ paricāresi ",
  "ja511:28.4": "divā vedesi vedanaṃ. ",
  "ja511:29.1": "Soḷas' itthisahassāni ",
  "ja511:29.2": "yā te 'mā paricārikā, ",
  "ja511:29.3": "evaṃ mahānubhāvo si ",
  "ja511:29.4": "abbhuto lomahaṃsano. ",
  "ja511:30.1": "Kiṃ kammaṃ akarī pubbe ",
  "ja511:30.2": "pāpaṃ attadukhāvahaṃ ",
  "ja511:30.3": "yaṃ karitvā manussesu ",
  "ja511:30.4": "piṭṭhimaṃsāni khādasīti. ",
  "ja511:31.1": "Ajjhenāni patiggayha ",
  "ja511:31.2": "kāmesu gathito ahaṃ, ",
  "ja511:31.3": "acariṃ dīgham addhānaṃ ",
  "ja511:31.4": "paresaṃ ahitāy' ahaṃ. ",
  "ja511:32.1": "Yo piṭṭhimaṃsiyo hoti ",
  "ja511:32.2": "evaṃ ukkacca khādati ",
  "ja511:32.3": "yathāham ajja khādāmi ",
  "ja511:32.4": "piṭṭhimaṃsāni attanoti. ",
  "ja511:33.1": ""
}
