  "ja491:0.4": "",
  "ja491:1.1": "Sace hi ty-āhaṃ dhanahetu gāhito ",
  "ja491:1.2": "mā maṃ vadhī, jīvagāhaṃ gahetvā ",
  "ja491:1.3": "rañño va maṃ samma upanti nehi, ",
  "ja491:1.4": "maññe dhanaṃ lacchasi napparūpanti. ",
  "ja491:2.1": "Na me ayaṃ tuyha vadhāya ajja ",
  "ja491:2.2": "samāhito cāpavare khurappo, ",
  "ja491:2.3": "pāsañ ca ty-āhaṃ adhipātayissaṃ, ",
  "ja491:2.4": "yathāsukhaṃ gacchatu morarājāti. ",
  "ja491:3.1": "Yaṃ sattavassāni mam ānubandhi ",
  "ja491:3.2": "rattiṃdivaṃ khuppipāsaṃ sahanto ",
  "ja491:3.3": "atha kissa maṃ pāsavas' ūpanītaṃ ",
  "ja491:3.4": "pamuttave icchasi bandhanasmā. ",
  "ja491:4.1": "Pāṇātipātā virato nu s' ajja, ",
  "ja491:4.2": "abhayan nu te sabbabhūtesu dinnaṃ, ",
  "ja491:4.3": "yaṃ maṃ tuvaṃ pāsavas' ūpanītaṃ ",
  "ja491:4.4": "pamuttave icchasi bandhanasmāti. ",
  "ja491:5.1": "Pāṇātipātā viratassa brūhi ",
  "ja491:5.2": "abhayañ ca yo sabbabhūtesu deti: ",
  "ja491:5.3": "-pucchāmi taṃ morarāja tam attham- ",
  "ja491:5.4": "ito cuto kiṃ labhate sukhaṃ so. ",
  "ja491:6.1": "Pāṇātipātā viratassa brūmi ",
  "ja491:6.2": "abhayañ ca yo sabbabhūtesu deti: ",
  "ja491:6.3": "diṭṭhe va dhamme labhate pasaṃsaṃ ",
  "ja491:6.4": "saggañ ca so yāti sarīrabhedā. ",
  "ja491:7.1": "Na santi devā icc-āhu eke, ",
  "ja491:7.2": "idh' eva jīvo vibhavaṃ upeti, ",
  "ja491:7.3": "tathā phalaṃ sukatadukkatānaṃ, ",
  "ja491:7.4": "dattupaññattañ ca vadanti dānaṃ, ",
  "ja491:7.5": "tesaṃ vaco arahataṃ saddahāno ",
  "ja491:7.6": "tasmā ahaṃ sakuṇe bādhayāmīti. ",
  "ja491:8.1": "Cando ca suriyo ca ubho sudassanā ",
  "ja491:8.2": "gacchanti obhāsayam antalikkhe, ",
  "ja491:8.3": "imassa lokassa parassa vā te, ",
  "ja491:8.4": "kathaṃ nu te āhu manussaloketi gātham āha. ",
  "ja491:9.1": "Cando ca suriyo ca ubho sudassanā ",
  "ja491:9.2": "gacchanti obhāsayam antalikkhe, ",
  "ja491:9.3": "parassa lokassa na te imassa, ",
  "ja491:9.4": "devāti te āhu manussaloke. ",
  "ja491:10.1": "Etth' eva te nihatā hīnavādā ",
  "ja491:10.2": "ahetukā ye na vadanti kammaṃ ",
  "ja491:10.3": "tathā phalaṃ sukatadukkatānaṃ ",
  "ja491:10.4": "dattupaññattaṃ ye ca vadanti dānanti. ",
  "ja491:11.1": "Addhā hi saccaṃ vacanaṃ tav' etaṃ, ",
  "ja491:11.2": "kathaṃ hi dānaṃ aphalaṃ vadeyya, ",
  "ja491:11.3": "tathā phalaṃ sukatadukkatānaṃ, ",
  "ja491:11.4": "dattupaññattañ ca kathaṃ bhaveyya. ",
  "ja491:12.1": "Kathaṃkaro kintikaro kim ācaraṃ ",
  "ja491:12.2": "kiṃ sevamāno kena tapoguṇena, ",
  "ja491:12.3": "akkhāhi me morarāja tam atthaṃ ",
  "ja491:12.4": "yathā ahaṃ no nirayaṃ pateyyanti. ",
  "ja491:13.1": "Ye keci atthi samaṇā pathavyā ",
  "ja491:13.2": "kāsāvavatthā anagāriyā te, ",
  "ja491:13.3": "pāto va piṇḍāya caranti kāle, ",
  "ja491:13.4": "vikālacariyāviratā hi santo. ",
  "ja491:14.1": "Te tattha kālen' upasaṃkamitvā pucchehi ",
  "ja491:14.2": "sante manaso pi yaṃ siyā, ",
  "ja491:14.3": "te te pavakkhanti yathāpajānaṃ ",
  "ja491:14.4": "imassa lokassa parassa c' atthanti. ",
  "ja491:15.1": "Tacaṃ va jiṇṇaṃ urago purānaṃ ",
  "ja491:15.2": "paṇḍūpalāsaṃ harito dumo va ",
  "ja491:15.3": "esa-ppahīno mama luddabhāvo, ",
  "ja491:15.4": "pajahām' ahaṃ luddakabhāvam ajjāti ",
  "ja491:16.1": "Ye cāpi me sakuṇā atthi baddhā ",
  "ja491:16.2": "satāni nekāni nivesanasmiṃ ",
  "ja491:16.3": "tesam p' ahaṃ jīvitaṃ ajja dammi ",
  "ja491:16.4": "mokkhañ ca, te pattā sakaṃ niketanti ",
  "ja491:17.1": "Luddo carī pāsahattho araññe ",
  "ja491:17.2": "bādhetuṃ morādhipatiṃ yasassiṃ, ",
  "ja491:17.3": "bandhitva morādhipatiṃ yasasiṃ ",
  "ja491:17.4": "dukkhā pamuñcī yathāhaṃ pamuttoti. ",
  "ja491:18.1": ""
}
