  "ja478:0.1": "",
  "ja478:0.2": "",
  "ja478:0.3": "",
  "ja478:0.4": "",
  "ja478:1.1": "Dūte te brahme pāhesiṃ ",
  "ja478:1.2": "Gaṅgātīrasmiṃ jhāyato, ",
  "ja478:1.3": "tesaṃ puṭṭho na vyāhāsi, ",
  "ja478:1.4": "dukkhaṃ guyha mataṃ nu te. ",
  "ja478:2.1": "Sace te dukkhaṃ uppajji ",
  "ja478:2.2": "Kāsīnaṃ raṭṭhavaddhana ",
  "ja478:2.3": "mā kho no tassa akkhāhi ",
  "ja478:2.4": "yo taṃ dukkhā na mocaye. ",
  "ja478:3.1": "Yo ca tathā dukkhajātassa ",
  "ja478:3.2": "ekantam api bhāsato ",
  "ja478:3.3": "vippamoceyya dhammena ",
  "ja478:3.4": "kāmaṃ tassa pavedaya. ",
  "ja478:4.1": "Suvijānaṃ sigālānaṃ sakuntānaṅ ",
  "ja478:4.2": "ca vassitaṃ (= supra 217|6) ",
  "ja478:4.3": "manussavassitaṃ rāja ",
  "ja478:4.4": "dubbijānataraṃ tato. ",
  "ja478:5.1": "Api ce maññatī poso ",
  "ja478:5.2": "‘ñātimitto' ‘sakhāti vā (= supra 217|8) ",
  "ja478:5.3": "yo pubbe sumano hutvā ",
  "ja478:5.4": "pacchā sampajjate diso. ",
  "ja478:6.1": "Yo attano dukkham anānupuṭṭho ",
  "ja478:6.2": "pavedaye jantu akālarūpe ",
  "ja478:6.3": "ānandino tassa bhavant' amittā ",
  "ja478:6.4": "hitesino tassa dukhī bhavanti. ",
  "ja478:7.1": "Kālañ ca ñatvāna tathāvidhassa ",
  "ja478:7.2": "medhāvinaṃ ekamanaṃ viditvā ",
  "ja478:7.3": "akkheyya tippāni parassa dhīro, ",
  "ja478:7.4": "saṇhaṃ giraṃ atthavatiṃ pamuñce. ",
  "ja478:8.1": "Sace ca jaññā avisayhaṃ attano ",
  "ja478:8.2": "‘nāyaṃ nīti mayha sukhāgamāya' ",
  "ja478:8.3": "eko va tippāni sahetha dhīro ",
  "ja478:8.4": "saccaṃ hirottappam apekkhamānoti. ",
  "ja478:9.1": "Ahaṃ raṭṭhāni vicaranto ",
  "ja478:9.2": "nigame rājadhāniyo ",
  "ja478:9.3": "bhikkhamāno mahārāja ",
  "ja478:9.4": "ācariyassa dhanatthiko ",
  "ja478:10.1": "Gahapatī rājapurise ",
  "ja478:10.2": "mahāsāle ca brāhmaṇe ",
  "ja478:10.3": "alatthaṃ satta nikkhāni ",
  "ja478:10.4": "suvaṇṇassa janādhipa, ",
  "ja478:10.5": "te me naṭṭhā mahārāja, ",
  "ja478:10.6": "tasmā socām' ahaṃ bhusaṃ. ",
  "ja478:11.1": "Purisā te mahārāja ",
  "ja478:11.2": "manasānuvicintitā ",
  "ja478:11.3": "nālaṃ dukkhā pamocetuṃ, ",
  "ja478:11.4": "tasmā tesaṃ na vyāhariṃ. ",
  "ja478:12.1": "Tvañ ca kho me mahārāja ",
  "ja478:12.2": "manasānuvicintito ",
  "ja478:12.3": "alaṃ dukkhā pamocetuṃ, ",
  "ja478:12.4": "tasmā tuyhaṃ pavedayinti. ",
  "ja478:13.1": "Tassādāsi pasannatto ",
  "ja478:13.2": "Kāsīnaṃ raṭṭhavaddhano ",
  "ja478:13.3": "jātarūpamaye nikkhe ",
  "ja478:13.4": "suvaṇṇassa catuddasāti. ",
  "ja478:14.1": ""
}
