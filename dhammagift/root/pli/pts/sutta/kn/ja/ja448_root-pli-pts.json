  "ja448:0.4": "",
  "ja448:1.1": "Nāsmase katapāpamhi, ",
  "ja448:1.2": "nāsmase alikavādine, ",
  "ja448:1.3": "nāsmas' attaṭṭhapaññamhi, ",
  "ja448:1.4": "atisante pi nāsmase. ",
  "ja448:2.1": "Bhavanti h' eke purisā ",
  "ja448:2.2": "gopipāsakajātikā, ",
  "ja448:2.3": "ghaṃsanti maññe mittāni ",
  "ja448:2.4": "vācāya na ca kammanā. ",
  "ja448:3.1": "Sukkhañjalīpaggahītā ",
  "ja448:3.2": "vācāya paliguṇṭhitā ",
  "ja448:3.3": "manussapheggū -- nāsīde ",
  "ja448:3.4": "yasmiṃ n' atthi kataññutā. ",
  "ja448:4.1": "Na hi aññasacittānaṃ ",
  "ja448:4.2": "itthīnaṃ purisānaṃ vā- ",
  "ja448:4.3": "nānā va katvā saṃsaggaṃ ",
  "ja448:4.4": "tādisam pi na asmase . ",
  "ja448:5.1": "Anariyakammaṃ okkantaṃ ",
  "ja448:5.2": "atthetaṃ sabbaghātinaṃ ",
  "ja448:5.3": "nisitaṃ va paṭicchannaṃ ",
  "ja448:5.4": "tādisam pi nāsmase. ",
  "ja448:6.1": "Mittarūpen' idh' ekacce ",
  "ja448:6.2": "sākhallena acetasā ",
  "ja448:6.3": "vividehi upāyehi -- ",
  "ja448:6.4": "tādisam pi nāsmase. ",
  "ja448:7.1": "Āmisaṃ vā dhanaṃ vāpi ",
  "ja448:7.2": "yatha passati tādiso ",
  "ja448:7.3": "dūphiṃ karoti dummedho ",
  "ja448:7.4": "tañ ca jhatvāna gacchatīti ",
  "ja448:8.1": "Mittarūpena bahavo ",
  "ja448:8.2": "channā sevanti sattavo, ",
  "ja448:8.3": "jahe kāpurise h' ete ",
  "ja448:8.4": "kukkuṭo viya senakaṃ. ",
  "ja448:9.1": "Yo ca uppatitaṃ atthaṃ ",
  "ja448:9.2": "na khippam anubujjhati (III. p. 438.) ",
  "ja448:9.3": "amittavasam anveti ",
  "ja448:9.4": "pacchā ca-m-anutappati. ",
  "ja448:10.1": "Yo ca uppatitaṃ atthaṃ ",
  "ja448:10.2": "khippam eva nibodhati ",
  "ja448:10.3": "muccate sattusambādhā ",
  "ja448:10.4": "kukkuṭo viya senakā. ",
  "ja448:11.1": "Taṃ tādisaṃ kūṭam iv' oḍḍitaṃ vane ",
  "ja448:11.2": "adhammikaṃ niccavidhaṃsakārinaṃ ",
  "ja448:11.3": "ārā vivajjeyya naro vicakkhaṇo ",
  "ja448:11.4": "senaṃ yathā kukkuṭo vaṃsakānaneti Alaṃkato maṭṭakuṇḍalī (Dhp. p. 95.) mālabhārī ",
  "ja448:12.1": ""
}
