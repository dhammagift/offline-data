  "ja216:1.1": "Na m' āyaṃ aggi tapati ",
  "ja216:1.2": "na sūlo sādhu tacchito, ",
  "ja216:1.3": "yañ ca maṃ maññatī macchī ",
  "ja216:1.4": "‘aññaṃ so ratiyā gato' ",
  "ja216:2.1": "So maṃ dahati rāgaggi ",
  "ja216:2.2": "cittaṃ c' ūpatapeti maṃ, ",
  "ja216:2.3": "jālino muñcath' ayirā maṃ, ",
  "ja216:2.4": "na kāme haññate kvacīti. ",
  "ja216:3.1": ""
}
