  "ja501:1.1": "Ete yūthā patīyanti ",
  "ja501:1.2": "bhītā maraṇā Cittaka, ",
  "ja501:1.3": "gaccha tuvam pi, mā,kaṃkhi. ",
  "ja501:1.4": "jīvissanti tayā sahāti. ",
  "ja501:2.1": "Nāhaṃ Rohanta gacchāmi, ",
  "ja501:2.2": "hadayam me avakaḍḍhati, ",
  "ja501:2.3": "na taṃ aham jahissāmi, ",
  "ja501:2.4": "idha hessāmi jīvitaṃ. ",
  "ja501:3.1": "Te hi nūna marissanti ",
  "ja501:3.2": "andhā aparināyikā, ",
  "ja501:3.3": "gaccha tuvam pi, mā kaṃkhi, ",
  "ja501:3.4": "jīvissanti tayā saha. ",
  "ja501:4.1": "Nāhaṃ Rohanta gacchāmi, ",
  "ja501:4.2": "hadayam me avakaḍḍhati, ",
  "ja501:4.3": "na taṃ baddhaṃ jahissāmi, ",
  "ja501:4.4": "idha hessāmi jīvitanti. ",
  "ja501:5.1": "Gaccha bhīru palāyassu, ",
  "ja501:5.2": "kūṭe baddho 'smi āyase, ",
  "ja501:5.3": "gaccha tuvam pi, mā kaṃkhi, ",
  "ja501:5.4": "jīvissanti tayā sahāti. ",
  "ja501:6.1": "Nāhaṃ Rohanta gacchāmi, ",
  "ja501:6.2": "hadayam me avakaḍḍhati, ",
  "ja501:6.3": "na taṃ ahaṃ jahissāmi, ",
  "ja501:6.4": "idha hessāmi jīvitaṃ. ",
  "ja501:7.1": "Te hi nūna marissanti ",
  "ja501:7.2": "andhā aparināyikā, ",
  "ja501:7.3": "gaccha tuvam pi, mā kaṃkhi, ",
  "ja501:7.4": "jīvissanti tayā saha. ",
  "ja501:8.1": "Nāhaṃ Rohanta gacchāmi, ",
  "ja501:8.2": "hadayam me avakaḍḍhati, ",
  "ja501:8.3": "na taṃ baddhaṃ jahissāmi, ",
  "ja501:8.4": "idha hessāmi jīvitanti. ",
  "ja501:9.1": "Ayaṃ so luddako eti ",
  "ja501:9.2": "ruddarūpo sahāvudho, ",
  "ja501:9.3": "so no vadhissati ajja ",
  "ja501:9.4": "usunā sattiyā-m-apīti. ",
  "ja501:10.1": "Sā muhuttaṃ palāyitvā ",
  "ja501:10.2": "bhayaṭṭhā bhayatajjitā ",
  "ja501:10.3": "sudukkaraṃ akarā bhīru ",
  "ja501:10.4": "maraṇāy' ūpanivattathāti. ",
  "ja501:11.1": "Kin nu te 'me migā honti, ",
  "ja501:11.2": "muttā baddhaṃ upāsare, ",
  "ja501:11.3": "na taṃ cajitum icchanti ",
  "ja501:11.4": "jīvitassa pi kāraṇāti ",
  "ja501:12.1": "Bhātaro honti me ludda ",
  "ja501:12.2": "saudariyā ekamātukā, ",
  "ja501:12.3": "na mañ cajitum icchanti ",
  "ja501:12.4": "jīvitassa pi kāraṇāti. ",
  "ja501:13.1": "Te hi nūna marissanti ",
  "ja501:13.2": "andhā aparināyikā, ",
  "ja501:13.3": "pañcannaṃ jīvitaṃ dehi, ",
  "ja501:13.4": "bhātaraṃ muñca luddakāti ",
  "ja501:14.1": "So vo ahaṃ pamokkhāmi ",
  "ja501:14.2": "mātāpettibharaṃ migaṃ, ",
  "ja501:14.3": "nandantu mātāpitaro ",
  "ja501:14.4": "muttaṃ disvā mahāmiganti. ",
  "ja501:15.1": "Evaṃ luddaka nandassu ",
  "ja501:15.2": "saha sabbehi ñātibhi ",
  "ja501:15.3": "yathāham ajja nandāmi ",
  "ja501:15.4": "muttaṃ disvā mahāmiganti ",
  "ja501:16.1": "Kathaṃ pamokkho āsi ",
  "ja501:16.2": "upanītasmiṃ jīvite, ",
  "ja501:16.3": "kathaṃ putta amocesi ",
  "ja501:16.4": "kūṭapāsamha luddakoti ",
  "ja501:17.1": "Bhaṇaṃ kaṇṇasukhaṃ vācaṃ ",
  "ja501:17.2": "hadayaṅgaṃ hadayanissitaṃ ",
  "ja501:17.3": "subhāsitāhi vācāhi ",
  "ja501:17.4": "Cittako maṃ amocayi. ",
  "ja501:18.1": "Bhaṇaṃ kaṇṇasukhaṃ vācaṃ ",
  "ja501:18.2": "hadayaṅgaṃ hadayanissitaṃ ",
  "ja501:18.3": "subhāsitāhi vācāhi ",
  "ja501:18.4": "Sutanā maṃ amocayi. ",
  "ja501:19.1": "Sutvā kaṇṇasukhaṃ vācaṃ ",
  "ja501:19.2": "hadayaṅgaṃ hadayanissitaṃ ",
  "ja501:19.3": "subhāsitāni sutvāna ",
  "ja501:19.4": "luddako maṃ amocayīti. ",
  "ja501:20.1": "Evaṃ ānandito hotu ",
  "ja501:20.2": "saha dārehi luddako ",
  "ja501:20.3": "yathā may' ajja nandāma ",
  "ja501:20.4": "disvā Rohantam āgatanti. ",
  "ja501:21.1": "Nanu tvaṃ avacā ludda: ",
  "ja501:21.2": "migacammāni āhariṃ, ",
  "ja501:21.3": "atha kena nu vaṇṇena ",
  "ja501:21.4": "migacammāni nāharīti. ",
  "ja501:22.1": "Āgamā c' eva hatthatthaṃ ",
  "ja501:22.2": "kūṭapāsañ ca so migo, ",
  "ja501:22.3": "abajjhi, tañ ca migarājaṃ ",
  "ja501:22.4": "tañ ca muttā upāsare. ",
  "ja501:23.1": "Tassa me āhu saṃvego ",
  "ja501:23.2": "abbhuto lomahaṃsano, ",
  "ja501:23.3": "imañ c' āhaṃ migaṃ haññe ",
  "ja501:23.4": "ajja hassāmi jīvitanti āha. ",
  "ja501:24.1": "Kīdisā te migā ludda, ",
  "ja501:24.2": "kīdisā dhammikā migā, ",
  "ja501:24.3": "kathaṃvannā kathaṃsīlā, ",
  "ja501:24.4": "bāḷham kho te pasaṃsasīti. ",
  "ja501:25.1": "Odātasiṅgā sucivālā ",
  "ja501:25.2": "jātarūpatacūpamā, ",
  "ja501:25.3": "pādālohitakātesaṃ, ",
  "ja501:25.4": "añjitakkhā manoramāti gātham āha. ",
  "ja501:26.1": "Edisā te migā deva, ",
  "ja501:26.2": "edisā dhammikā migā, ",
  "ja501:26.3": "mātāpettibharā devā, ",
  "ja501:26.4": "na te so abhihārayanti ",
  "ja501:27.1": "Dammi nikkhasataṃ ludda ",
  "ja501:27.2": "thullañ ca maṇikuṇḍalaṃ ",
  "ja501:27.3": "catussadañ ca pallaṃkaṃ ",
  "ja501:27.4": "ummāpupphasirinnibhaṃ ",
  "ja501:28.1": "Dve ca sādisiyo bhariyā ",
  "ja501:28.2": "usabhañ ca gavaṃ sataṃ, ",
  "ja501:28.3": "dhammena rajjaṃ kāressaṃ, ",
  "ja501:28.4": "bahukāro me si luddaka. ",
  "ja501:29.1": "Kasī vaṇijjā iṇadānaṃ ",
  "ja501:29.2": "uñchācariyāya luddaka- ",
  "ja501:29.3": "etehi dāraṃ posehi. ",
  "ja501:29.4": "mā pāpaṃ akarā punanti ",
  "ja501:30.1": ""
}
