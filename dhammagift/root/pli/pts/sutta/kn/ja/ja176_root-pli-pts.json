  "ja176:1.1": "Bālo vatāyaṃ dumasākhagocaro, ",
  "ja176:1.2": "paññā janinda na imassa vijjati, ",
  "ja176:1.3": "kalāyamuṭṭhiṃ avakiriya kevalaṃ ",
  "ja176:1.4": "ekaṃ kalāyaṃ patitaṃ gavessatīti. ",
  "ja176:2.1": "Evam eva mayaṃ rāja ",
  "ja176:2.2": "ye c' aññe atilobhino ",
  "ja176:2.3": "appena bahuṃ jiyyāma ",
  "ja176:2.4": "kalāyeneva vānaroti. ",
  "ja176:3.1": ""
}
