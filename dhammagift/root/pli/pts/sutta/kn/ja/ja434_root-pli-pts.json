  "ja434:0.4": "",
  "ja434:1.1": "Kāsāyavatthe sakuṇe vadāmi ",
  "ja434:1.2": "duve duve nandimane carante, ",
  "ja434:1.3": "kaṃ aṇḍajaṃ aṇḍajā mānusesu ",
  "ja434:1.4": "jātiṃ pasaṃsanti, tad iṃgha brūthāti. ",
  "ja434:2.1": "Amhe manussesu manussahiṃsa ",
  "ja434:2.2": "anubbate cakkavāke vadanti, ",
  "ja434:2.3": "kalyāṇabhāv' amha dijesu sammatā, ",
  "ja434:2.4": "abhītarūpā vicarāma aṇṇaveti. ",
  "ja434:2.5": "",
  "ja434:3.1": "Kiṃ, aṇṇave kāni phalāni bhuñje ",
  "ja434:3.2": "maṃsaṃ kuto khādatha cakkavākā, ",
  "ja434:3.3": "kiṃ bhojanaṃ bhuñjatha vo anamā, ",
  "ja434:3.4": "balañ ca vaṇṇo ca anapparūpoti. ",
  "ja434:4.1": "Na aṇṇave santi phalāni vaṃka ",
  "ja434:4.2": "maṃsaṃ kuto khādituṃ cakkavāke, ",
  "ja434:4.3": "sevālabhakkh' amha avākabhojanā, ",
  "ja434:4.4": "na ghāsahetū pakaroma pāpanti. ",
  "ja434:5.1": "Na me idaṃ ruccati cakkavākā, ",
  "ja434:5.2": "asmiṃ bhave bhojanasannikāso ",
  "ja434:5.3": "ahosi me pubbe, tato me aññathā, ",
  "ja434:5.4": "icc-eva me vimati ettha jātā. ",
  "ja434:6.1": "Aham pi maṃsāni phalāni bhuñje ",
  "ja434:6.2": "annāni ca loṇiyateliyāni, ",
  "ja434:6.3": "rasaṃ manussesu labhāmi bhottuṃ ",
  "ja434:6.4": "sūro va saṃgāmamukhaṃ vijetvā, ",
  "ja434:6.5": "na ca me tādiso vaṇṇo ",
  "ja434:6.6": "cakkavāka yathā tavanti. ",
  "ja434:7.1": "Asuddhabhakkho si khaṇānupātī, ",
  "ja434:7.2": "kicchena te labbhati annapānaṃ, ",
  "ja434:7.3": "na tussasi rukkhaphalehi vaṃka ",
  "ja434:7.4": "maṃsāni vā yāni susānamajjhe. ",
  "ja434:8.1": "Yo sāhasena adhigamma bhoge ",
  "ja434:8.2": "paribhuñjati vaṃka khaṇānupātī ",
  "ja434:8.3": "tato upakkosati naṃ sabhāvo, ",
  "ja434:8.4": "upakkuṭṭho vaṇṇabalaṃ jahāti. ",
  "ja434:9.1": "Appam pi ce nibbutiṃ bhuñjatī yadi ",
  "ja434:9.2": "asāhasena aparūpaghātī ",
  "ja434:9.3": "balañ ca vaṇṇo ca tad' assa hoti, ",
  "ja434:9.4": "na hi sabbo āhāramayena vaṇṇoti. ",
  "ja434:10.1": ""
}
