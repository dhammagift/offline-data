{
  "ja524:0.1": "",
  "ja524:0.2": "",
  "ja524:0.3": "",
  "ja524:0.4": "",
  "ja524:1.1": "Ariyāvakāso si pasannanetto ",
  "ja524:1.2": "maññe bhavaṃ pabbajito kulamhā, ",
  "ja524:1.3": "kathan nu vittāni pahāya bhoge ",
  "ja524:1.4": "pabbaji nikkhamma gharā sapaññāti. ",
  "ja524:2.1": "Sayaṃ vimānaṃ naradeva disvā ",
  "ja524:2.2": "mahānubhāvassa mahoragassa ",
  "ja524:2.3": "disvāna puññānaṃ mahāvipākaṃ ",
  "ja524:2.4": "saddhāyāhaṃ pabbajito 'mhi rāja. ",
  "ja524:3.1": "Na kāmakāmā na bhayā na dosā ",
  "ja524:3.2": "vācaṃ musā pabbajitā bhaṇanti, ",
  "ja524:3.3": "akkhāhi me pucchito etam atthaṃ, ",
  "ja524:3.4": "sutvāna me jāyihiti-ppasādo. ",
  "ja524:4.1": "Vaṇijja raṭṭhādhipa gacchamāno ",
  "ja524:4.2": "pathe addasāsim hi milācaputte ",
  "ja524:4.3": "pavaṭṭakāyaṃ uragaṃ mahantaṃ ",
  "ja524:4.4": "ādāya gacchante pamodamāne. ",
  "ja524:5.1": "So 'haṃ samāgamma janinda tehi ",
  "ja524:5.2": "saṃhaṭṭhalomo avacasmi bhīto: ",
  "ja524:5.3": "kuhiṃ ayaṃ nīyati bhīmakāyo, ",
  "ja524:5.4": "nāgena kiṃ kāhathā bhojaputtā. ",
  "ja524:6.1": "Nāgo ayaṃ nīyati bhojanatthaṃ ",
  "ja524:6.2": "pavaṭṭakāyo urago mahanto, ",
  "ja524:6.3": "sāduñ ca thūlañ ca muduñ ca maṃsaṃ ",
  "ja524:6.4": "na tvaṃ ras' aññāsi Videhaputta. ",
  "ja524:7.1": "Ito mayaṃ gantvā sakaṃ niketanaṃ ",
  "ja524:7.2": "ādāya satthāni vikopayitvā ",
  "ja524:7.3": "maṃsaṃ thokkhāma pamodamānā, ",
  "ja524:7.4": "mayaṃ hi vo sattavo pannagānaṃ. ",
  "ja524:8.1": "Sace ayaṃ nīyati bhojanatthaṃ ",
  "ja524:8.2": "pavaṭṭakāyo urago mahanto ",
  "ja524:8.3": "dadāmi vo balivaddāni soḷasa, ",
  "ja524:8.4": "nāgaṃ imaṃ muñcatha bandhanasmā. ",
  "ja524:9.1": "Addhā hi no bhakkho ayaṃ manāpo ",
  "ja524:9.2": "bahū ca no uragā bhuttapubbā, ",
  "ja524:9.3": "karoma te taṃ vacanaṃ Aḷāra, ",
  "ja524:9.4": "mittañ ca no hohi Videhaputta. ",
  "ja524:10.1": "Tad assu te bandhanā mocayiṃsu ",
  "ja524:10.2": "yaṃ natthuto paṭimokkh' assa pāse, ",
  "ja524:10.3": "mutto ca so bandhanā nāgarājā ",
  "ja524:10.4": "pakkāmi pācīnamukho muhuttaṃ. ",
  "ja524:11.1": "Gantvāna pācīnamukho muhuttaṃ ",
  "ja524:11.2": "puṇṇehi nettehi palokayī maṃ, ",
  "ja524:11.3": "tad ass' ahaṃ piṭṭhito anvagañchiṃ ",
  "ja524:11.4": "dasaṅguliṃ añjaliṃ paggahetvā. ",
  "ja524:12.1": "Gacch' eva kho tvaṃ taramānarūpo, ",
  "ja524:12.2": "mā taṃ amittā punar aggahesuṃ, ",
  "ja524:12.3": "dukkho hi luddehi punā samāgamo, ",
  "ja524:12.4": "adassanaṃ bhojaputtāna gaccha. ",
  "ja524:13.1": "Agamāsi so rahadaṃ vippasannaṃ ",
  "ja524:13.2": "nīlobhāsaṃ ramaṇīyaṃ sutitthaṃ ",
  "ja524:13.3": "",
  "ja524:13.4": "",
  "ja524:14.1": "So taṃ pavissa nacirassa nāgo ",
  "ja524:14.2": "dibbena me pātur ahū janinda, ",
  "ja524:14.3": "upaṭṭhahī maṃ pitaraṃ va putto ",
  "ja524:14.4": "hadayaṅgamaṃ kaṇṇasukhaṃ bhaṇanto. ",
  "ja524:15.1": "Tvaṃ me si mātā ca pitā ca Aḷāra ",
  "ja524:15.2": "abbhantaro pāṇadado sahāyo, ",
  "ja524:15.3": "sakañ ca iddhiṃ paṭilābhito smi, ",
  "ja524:15.4": "Aḷāra passa me nivesanāni ",
  "ja524:15.5": "pahūtabhakkhaṃ bahuannapānaṃ ",
  "ja524:15.6": "Masakkasāraṃ viya Vāsavassāti. ",
  "ja524:16.1": "Taṃ bhūmibhāgehi upetarūpaṃ, ",
  "ja524:16.2": "asakkharā c' eva mudū subhā ca ",
  "ja524:16.3": "nīcātiṇā apparajā ca bhūmi ",
  "ja524:16.4": "pāsādikā yattha jahanti sokaṃ ",
  "ja524:17.1": "Anāvakulā veḷuriyūpanīlā, ",
  "ja524:17.2": "catuddisaṃ ambavanaṃ surammaṃ, ",
  "ja524:17.3": "pakkā ca pesī ca phalā suphullā, ",
  "ja524:17.4": "niccotukā dhārayantī phalānīti. ",
  "ja524:18.1": "Tesaṃ vanānaṃ naradeva majjhe ",
  "ja524:18.2": "nivesanaṃ bhassarasannikāsaṃ ",
  "ja524:18.3": "rajataggaḷaṃ sovaṇṇamayaṃ uḷāraṃ ",
  "ja524:18.4": "obhāsatī vijjur iv' antalikkhe ",
  "ja524:19.1": "Maṇimayā sovaṇṇamayā uḷārā ",
  "ja524:19.2": "anekacittā satataṃ sunimmitā ",
  "ja524:19.3": "paripūra kaññāhi alaṃkatāhi ",
  "ja524:19.4": "suvaṇṇakāyūradharāhi rāja. ",
  "ja524:20.1": "So Saṃkhapālo taramānarūpo ",
  "ja524:20.2": "pāsādam āruyha anomavaṇṇo ",
  "ja524:20.3": "sahassathambhaṃ atulānubhāvaṃ ",
  "ja524:20.4": "yatth' assa bhariyā mahesī ahosi. ",
  "ja524:21.1": "Ekā ca nārī taramānarūpā ",
  "ja524:21.2": "ādāya veḷuriyamayaṃ mahagghaṃ ",
  "ja524:21.3": "subhaṃ maṇiṃ jātimantūpapannaṃ ",
  "ja524:21.4": "acoditā āsanam abbhihāsi. ",
  "ja524:22.1": "Tato maṃ urago hatthe gahetvā ",
  "ja524:22.2": "nisīdayī pamukhamāsanasmiṃ: ",
  "ja524:22.3": "idam āsanaṃ atrabhavaṃ nisīdatu, bhavaṃ hi ",
  "ja524:22.4": "me aññataro garūnaṃ. ",
  "ja524:23.1": "Aññā ca nārī taramānarūpā ",
  "ja524:23.2": "ādāya vāriṃ upasaṃkamitvā ",
  "ja524:23.3": "pādāni pakkhālayi me janinda ",
  "ja524:23.4": "bhariyā ca bhattū patino piyassa. ",
  "ja524:24.1": "Aparā ca nārī taramānarūpā ",
  "ja524:24.2": "paggayha sovaṇṇamayā pātiyā ",
  "ja524:24.3": "anekasūpaṃ vividhaṃ viyañjanaṃ ",
  "ja524:24.4": "upanāmayī bhatta manuññarūpaṃ. ",
  "ja524:25.1": "Turiyehi maṃ Bhārata bhuttavantaṃ ",
  "ja524:25.2": "upaṭṭhahuṃ bhattu mano viditvā ",
  "ja524:25.3": "tatuttariṃ maṃ nipati mahantaṃ ",
  "ja524:25.4": "dibbehi kāmehi anappakehīti. ",
  "ja524:26.1": "Bhariyā mam' etā tisatā Aḷāra ",
  "ja524:26.2": "sabb' atthamajjhā padumuttarābhā, ",
  "ja524:26.3": "Aḷāra etā su te kāmakāro ",
  "ja524:26.4": "dadāmi te tā paricārayassūti gātham āha. ",
  "ja524:27.1": "Saṃvaccharaṃ dibbaras' ānubhutvā tadass' ahaṃ ",
  "ja524:27.2": "uttariṃ paccabhāsiṃ: ",
  "ja524:27.3": "nāgass' idaṃ kinti kathañ ca laddhaṃ ",
  "ja524:27.4": "kath' ajjhagamāsi vimānaseṭṭhaṃ. ",
  "ja524:28.1": "Adhicca laddhaṃ pariṇāmajan te ",
  "ja524:28.2": "sayaṃkataṃ udāhu devehi dinnaṃ, ",
  "ja524:28.3": "pucchāmi te nāgarāja tam atthaṃ, ",
  "ja524:28.4": "kath' ajjhagamāsi vimānaseṭṭhanti. ",
  "ja524:29.1": "Nādhicca laddhaṃ na pariṇāmajam me ",
  "ja524:29.2": "na sayaṃkataṃ na pi devehi dinnaṃ, ",
  "ja524:29.3": "sakehi kammehi apāpakehi ",
  "ja524:29.4": "puññehi me laddham idaṃ vimānaṃ. ",
  "ja524:30.1": "Kin te vataṃ kiṃ pana brahmacariyaṃ ",
  "ja524:30.2": "kissa suciṇṇassa ayaṃ vipāko, ",
  "ja524:30.3": "akkhāhi me nāgarāje tam atthaṃ: ",
  "ja524:30.4": "kathan nu te laddhaṃ idaṃ vimānaṃ. ",
  "ja524:31.1": "Rājā ahosiṃ Magadhānam issaro ",
  "ja524:31.2": "Duyyodhano nāma mahānubhāvo, ",
  "ja524:31.3": "",
  "ja524:31.4": "",
  "ja524:32.1": "Annañ ca pānañ ca pasannacitto ",
  "ja524:32.2": "sakkacca dānaṃ vipulaṃ adāsi, ",
  "ja524:32.3": "opānabhūtaṃ me gharaṃ tadāsi, ",
  "ja524:32.4": "santappitā samaṇabrāhmaṇā ca. ",
  "ja524:33.1": "",
  "ja524:33.2": "",
  "ja524:33.3": "",
  "ja524:33.4": "",
  "ja524:34.1": "Tam me vataṃ taṃ pana brahmacariyaṃ ",
  "ja524:34.2": "tassa suciṇṇassa ayaṃ vipāko, ",
  "ja524:34.3": "ten' eva me laddham idaṃ vimānaṃ ",
  "ja524:34.4": "pahūtabhakkhaṃ bahuannapānaṃ ",
  "ja524:34.5": "Naccehi gītehi upetarūpaṃ ",
  "ja524:34.6": "ciraṭṭhitikaṃ, na ca sassat'āyaṃ, ",
  "ja524:35.1": "appānubhāvā taṃ mahānubhāvaṃ ",
  "ja524:35.2": "tejassinaṃ hanti atejavanto, ",
  "ja524:35.3": "kim eva dāṭhāvudha kiṃ paṭicca ",
  "ja524:35.4": "hatthattham āgañchi vanibbakānaṃ. ",
  "ja524:36.1": "Bhayan nu te anvagataṃ mahantaṃ ",
  "ja524:36.2": "tejo nu te nānvagaṃ dantamūlam, ",
  "ja524:36.3": "kim eva dāṭhāvudha kiṃ paṭicca ",
  "ja524:36.4": "kilesam āpajji vanibbakānaṃ. ",
  "ja524:37.1": "Na me bhayaṃ anvagataṃ mahantaṃ ",
  "ja524:37.2": "tejo na sakkā mama tehi hantuṃ, ",
  "ja524:37.3": "satañ ca dhammāni sukittitāni ",
  "ja524:37.4": "samuddavelā va duraccayāni. ",
  "ja524:38.1": "Cātuddasiṃ pannarasiñ c' Aḷāra ",
  "ja524:38.2": "uposathaṃ niccam upāvasāmi, ",
  "ja524:38.3": "athāgamuṃ soḷasa bhojaputtā ",
  "ja524:38.4": "rajjuṃ gahetvāna daḷhañ ca pāsaṃ. ",
  "ja524:39.1": "Bhetvāna nāsaṃ atikassa rajjuṃ ",
  "ja524:39.2": "nayiṃsu maṃ sampaṭiggayha luddā, ",
  "ja524:39.3": "etādisaṃ dukkham ahan titikkhiṃ ",
  "ja524:39.4": "uposathaṃ appaṭikopayanto. ",
  "ja524:40.1": "Ekāyane taṃ pathe addasāsiṃ ",
  "ja524:40.2": "balena vaṇṇena upetarūpaṃ, ",
  "ja524:40.3": "siriyā ca paññāya ca bhāvito si, ",
  "ja524:40.4": "kimatthiyaṃ nāga tapo karosi. ",
  "ja524:41.1": "Na puttahetu na dhanassa hetu (= IV 466|11) ",
  "ja524:41.2": "na āyuno cāpi Aḷāra hetu, ",
  "ja524:41.3": "manussayoniṃ abhipatthayāno ",
  "ja524:41.4": "tasmā parakkamma tato karomi. ",
  "ja524:42.1": "Tvaṃ lohitakkho vihatantaraṃso ",
  "ja524:42.2": "alaṃkato kappitakesamassu ",
  "ja524:42.3": "surosito lohitacandanena ",
  "ja524:42.4": "gandhabbarājā va disā pabhāsasi. ",
  "ja524:43.1": "Deviddhipatto si mahānubhāvo ",
  "ja524:43.2": "sabbehi kāmehi samaṅgibhūto, ",
  "ja524:43.3": "pucchāmi taṃ nāgarāje tam atthaṃ: ",
  "ja524:43.4": "seyyo ito kena manussaloko. ",
  "ja524:44.1": "Aḷāra nāññatra manussalokā ",
  "ja524:44.2": "suddhī ca saṃvijjati saññamo vā, ",
  "ja524:44.3": "ahañ ca laddhāna manussayoniṃ ",
  "ja524:44.4": "kāhāmi jātīmaraṇassa antaṃ. ",
  "ja524:45.1": "Saṃvaccharo me vusito tav' antike, ",
  "ja524:45.2": "annena pānena upaṭṭhito 'smi, ",
  "ja524:45.3": "āmantayitvāna palemi nāga, ",
  "ja524:45.4": "cirappavuttho 'smi ahaṃ janinda. ",
  "ja524:46.1": "Puttā ca dārā c' anujīvino ca ",
  "ja524:46.2": "niccānusiṭṭhā upatiṭṭhate ",
  "ja524:46.3": "taṃ, Yathā ",
  "ja524:46.4": "",
  "ja524:47.1": "ca mātā ca pitā c' agāre ",
  "ja524:47.2": "putto piyo paṭivihito va seyyo ",
  "ja524:47.3": "tato pi mayhaṃ idha-m-eva seyyo ",
  "ja524:47.4": "cittaṃ hi te nāga mayī pasannaṃ. ",
  "ja524:48.1": "Maṇī mama vijjati lohitaṃko ",
  "ja524:48.2": "dhanāhāro maṇiratanaṃ uḷāraṃ, ",
  "ja524:48.3": "ādāya taṃ gaccha sakaṃ niketaṃ ",
  "ja524:48.4": "laddhā dhanaṃ taṃ maṇim ussajassūti. ",
  "ja524:49.1": "Diṭṭhā mayā mānusikāpi kāmā ",
  "ja524:49.2": "asassatā vipariṇāmadhammā, ",
  "ja524:49.3": "ādīnavaṃ kāmaguṇesu disvā ",
  "ja524:49.4": "saddhāy' ahaṃ pabbajito 'mhi rāja. ",
  "ja524:50.1": "Dumapphalān' eva patanti mānavā ",
  "ja524:50.2": "daharā ca vuddhā ca sarīrabhedā, ",
  "ja524:50.3": "etam pi disvā pabbajito 'mhi rāja ",
  "ja524:50.4": "apaṇṇakaṃ sāmaññam eva seyyo. ",
  "ja524:51.1": "Addhā have sevitabbā sapaññā ",
  "ja524:51.2": "bahussutā ye bahuṭhānacintino, ",
  "ja524:51.3": "nāgañ ca sutvāna tavañ c' Aḷāra ",
  "ja524:51.4": "karomi puññāni anappakānīti. ",
  "ja524:52.1": "Addhā have sevitabbā sapaññā ",
  "ja524:52.2": "bahussutā ye bahuṭhānacintino, ",
  "ja524:52.3": "nāgañ ca sutvāna mamañ ca rāja ",
  "ja524:52.4": "karohi puññāni anappakānīti. ",
  "ja524:53.1": ""
}
