  "ja293:1.1": "me aññatarena vyādhinā ",
  "ja293:1.2": "rogena bāḷhaṃ dukkhitassa ruppato ",
  "ja293:1.3": "parisussati khippam idaṃ kalebaraṃ ",
  "ja293:1.4": "pupphaṃ yathā paṃsuni ātape kataṃ. ",
  "ja293:2.1": "Ajaññaṃ jaññasaṃkhātaṃ ",
  "ja293:2.2": "asuciṃ sucisammataṃ ",
  "ja293:2.3": "nānākuṇapaparipūraṃ ",
  "ja293:2.4": "jaññarūpaṃ apassato. ",
  "ja293:3.1": "Dhi-r-atthu taṃ āturaṃ pūtikāyaṃ ",
  "ja293:3.2": "jegucchiyaṃ asuciṃ vyādhidhammaṃ ",
  "ja293:3.3": "yattha-ppamattā adhimucchitā pajā ",
  "ja293:3.4": "hāpenti maggaṃ sugatūpapattiyāti ",
  "ja293:4.1": ""
}
