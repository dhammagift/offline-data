  "ja482:0.3": "",
  "ja482:0.4": "",
  "ja482:1.1": "gāmavaraṃ dammi ",
  "ja482:1.2": "nāriyo ca alaṃkatā, ",
  "ja482:1.3": "ko me taṃ migaṃ akkhāti ",
  "ja482:1.4": "migānaṃ migam uttamanti. ",
  "ja482:2.1": "Mayhaṃ gāmavaraṃ dehi ",
  "ja482:2.2": "nāriyo ca alaṃkatā, ",
  "ja482:2.3": "ahaṃ te migam akkhissaṃ ",
  "ja482:2.4": "migānaṃ migam uttamanti. ",
  "ja482:3.1": "Etasmiṃ vanasaṇḍasmiṃ ",
  "ja482:3.2": "ambā sālā ca pupphitā ",
  "ja482:3.3": "indagopakasañchannā, ",
  "ja482:3.4": "etth' eso tiṭṭhati migoti. ",
  "ja482:4.1": "Dhanuṃ adejjhaṃ katvāna ",
  "ja482:4.2": "usuṃ sandhāy' upāgami, (III274 |12) ",
  "ja482:4.3": "migo ca disvā rājānaṃ ",
  "ja482:4.4": "dūrato ajjhabhāsatha: ",
  "ja482:5.1": "Āgamehi mahārāja, ",
  "ja482:5.2": "mā me vijjhi rathesabha, ",
  "ja482:5.3": "ko nu te idham akkhāsi: ",
  "ja482:5.4": "etth' eso tiṭṭhatī migoti. ",
  "ja482:6.1": "Esa pāpacaro poso ",
  "ja482:6.2": "samma tiṭṭhati ārakā, ",
  "ja482:6.3": "so hi me idham akkhāsi: ",
  "ja482:6.4": "etth' eso tiṭṭhate migoti. ",
  "ja482:7.1": "Saccaṃ kir' evam āhaṃsu: ",
  "ja482:7.2": "narā ekacciyā idha, (I,326) ",
  "ja482:7.3": "kaṭṭhaṃ viplāvitaṃ seyyo ",
  "ja482:7.4": "na tv-ev' ekacciyo naroti. ",
  "ja482:8.1": "Kin nu rurū garahasī migānaṃ ",
  "ja482:8.2": "kiṃ pakkhinaṃ kiṃ pana mānusānaṃ, ",
  "ja482:8.3": "",
  "ja482:8.4": "",
  "ja482:9.1": "Yam uddhariṃ vahane vuyhamānaṃ ",
  "ja482:9.2": "mahodake salile sīghasote ",
  "ja482:9.3": "tatonidānaṃ bhayam āgataṃ mama. ",
  "ja482:9.4": "dukkho have rāja asabbhi saṅgamoti. ",
  "ja482:10.1": "So 'haṃ catuppattam idaṃ vihaṅgamaṃ ",
  "ja482:10.2": "tanucchidaṃ hadaye ossajāmi, ",
  "ja482:10.3": "hanāmi mittadduṃ akiccakāriṃ ",
  "ja482:10.4": "yo tādisaṃ kammakataṃ na jānātīti. ",
  "ja482:11.1": "Dhī-r-assa bālassa have janinda, ",
  "ja482:11.2": "santo vadhaṃ na-ppasaṃsanti jātu, ",
  "ja482:11.3": "kāmaṃ gharaṃ gacchatu pāpadhammo, ",
  "ja482:11.4": "yañ c' assa bhaṭṭhaṃ tad etassa dehi, ",
  "ja482:11.5": "ahañ ca te kāmakaro bhavāmīti. ",
  "ja482:12.1": "Addhā rurū aññataro sataṃ so ",
  "ja482:12.2": "yo dūbhato mānusassa na dubbhi, ",
  "ja482:12.3": "kāmaṃ gharaṃ gacchatu pāpadhammo, ",
  "ja482:12.4": "yañ c' assa bhaṭṭhaṃ tad etassa dammi, ",
  "ja482:12.5": "ahañ ca te kāmacāraṃ dadāmīti. ",
  "ja482:13.1": "Suvijānaṃ sigālānaṃ sakuntānañ ",
  "ja482:13.2": "ca vassitaṃ, (supra 225|27) ",
  "ja482:13.3": "manussavassitaṃ rāja ",
  "ja482:13.4": "dubbijānataraṃ tato. ",
  "ja482:14.1": "Api ce maññatī poso ",
  "ja482:14.2": "‘ñātimitto' ‘sakhāti vā (supra 226|1) ",
  "ja482:14.3": "yo pubbe sumano hutvā ",
  "ja482:14.4": "pacchā sampajjate disoti. ",
  "ja482:15.1": "Samāgatā jānapadā ",
  "ja482:15.2": "negamā ca samāgatā: ",
  "ja482:15.3": "migā dhaññāni khādanti, ",
  "ja482:15.4": "taṃ devo paṭisedhatūti. ",
  "ja482:16.1": "Kāmaṃ janapado māsi, ",
  "ja482:16.2": "raṭṭhañ cāpi vinassatu, ",
  "ja482:16.3": "na tv-evāhaṃ ruruṃ dubbhe ",
  "ja482:16.4": "datvā abhayadakkhiṇaṃ. ",
  "ja482:17.1": "Mā me janapado āsi, ",
  "ja482:17.2": "raṭṭhañ cāpi vinassatu, ",
  "ja482:17.3": "na tv-evāhaṃ migarājassa ",
  "ja482:17.4": "varaṃ datvā musā bhaṇeti. Āsiṃseth' eva ",
  "ja482:18.1": ""
}
