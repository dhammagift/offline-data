  "ja212:1.1": "Añño uparimo vaṇṇo ",
  "ja212:1.2": "añño vaṇṇo ca heṭṭhimo, ",
  "ja212:1.3": "brāhmaṇi tv-eva pucchāmi: ",
  "ja212:1.4": "kiṃ heṭṭhā kiñ ca ūpariti. ",
  "ja212:2.1": "Ahaṃ naṭo 'smi bhaddante, ",
  "ja212:2.2": "bhikkhako 'smi idhāgato, ",
  "ja212:2.3": "ayaṃ hi koṭṭham otiṇṇo ",
  "ja212:2.4": "ayaṃ so yaṃ gavesasīti. ",
  "ja212:3.1": ""
}
