  "ja327:0.4": "",
  "ja327:1.1": "Vāti cāyaṃ tato gandho ",
  "ja327:1.2": "yattha me vasatī piyā, ",
  "ja327:1.3": "dūre ito hi Kākāti ",
  "ja327:1.4": "yattha me nirato manoti. ",
  "ja327:2.1": "Kathaṃ samuddaṃ patari, ",
  "ja327:2.2": "kathaṃ patari Kebukaṃ, ",
  "ja327:2.3": "kathaṃ satta samuddāni ",
  "ja327:2.4": "kathaṃ simbalim āruhīti. ",
  "ja327:3.1": "Tayā samuddam atariṃ, ",
  "ja327:3.2": "tayā atari Kebukaṃ, ",
  "ja327:3.3": "tayā satta samuddāni, ",
  "ja327:3.4": "tayā simbalim āruhinti. Dhi- ",
  "ja327:4.1": "r-atthu maṃ mahākāyaṃ, ",
  "ja327:4.2": "dhi-r-atthu maṃ acetanaṃ, ",
  "ja327:4.3": "yattha jāyāy' ahaṃ jāraṃ ",
  "ja327:4.4": "āvahāmi vahāmi vāti. Bahunnaṃ ",
  "ja327:5.1": ""
}
