  "ja533:0.4": "",
  "ja533:1.1": "Sumukha anupacinantā ",
  "ja533:1.2": "pakkamanti vihaṅgamā, ",
  "ja533:1.3": "gaccha tuvam pi, mā kaṃkhi, ",
  "ja533:1.4": "n' atthi baddhe sahāyatāti. ",
  "ja533:2.1": "Gacch' evāhaṃ na vā gacche ",
  "ja533:2.2": "na tena amaro siyaṃ, ",
  "ja533:2.3": "sukhitaṃ taṃ upāsitvā ",
  "ja533:2.4": "dukkhitaṃ taṃ kathaṃ jahe. ",
  "ja533:3.1": "Maraṇaṃ vā tayā saddhiṃ ",
  "ja533:3.2": "jīvitaṃ vā tayā vinā ",
  "ja533:3.3": "tath' eva maraṇaṃ seyyo ",
  "ja533:3.4": "yañce jīve tayā vinā. ",
  "ja533:4.1": "N' esa dhammo mahārāja ",
  "ja533:4.2": "yaṃ taṃ evaṃgataṃ jahe, ",
  "ja533:4.3": "yā gati tuyhaṃ sā mayhaṃ ",
  "ja533:4.4": "ruccate vihaṅgādhipa. ",
  "ja533:5.1": "Kā nu pāsena baddhassa ",
  "ja533:5.2": "gati aññā mahānasā, ",
  "ja533:5.3": "sā kathaṃ cetayānassa ",
  "ja533:5.4": "muttassa tava ruccati. ",
  "ja533:6.1": "Kaṃ vā tvaṃ passase atthaṃ ",
  "ja533:6.2": "mama tuyhañ ca pakkhima ",
  "ja533:6.3": "ñātīnaṃ vāvasiṭṭhānaṃ ",
  "ja533:6.4": "ubhinnaṃ jīvitakkhaye. ",
  "ja533:7.1": "Yan na kañcanadepiccha ",
  "ja533:7.2": "andhena tamasā gataṃ ",
  "ja533:7.3": "tādise sañcajaṃ pāṇaṃ ",
  "ja533:7.4": "kam attham abhijotaye. ",
  "ja533:8.1": "Kathan nu patataṃ seṭṭha ",
  "ja533:8.2": "dhamme atthaṃ na bujjhasi, ",
  "ja533:8.3": "dhammo apacito santo ",
  "ja533:8.4": "atthaṃ dasseti pāṇinaṃ. ",
  "ja533:9.1": "So 'haṃ dhammaṃ apekkhāno ",
  "ja533:9.2": "dhammā c' atthaṃ samuṭṭhitaṃ ",
  "ja533:9.3": "bhattiñ ca tayi sampassaṃ ",
  "ja533:9.4": "nāvakaṃkhāmi jīvitaṃ. ",
  "ja533:10.1": "Addhā eso sataṃ dhammo ",
  "ja533:10.2": "yo mitto mittam āpade ",
  "ja533:10.3": "na-ccaje jīvitassāpi ",
  "ja533:10.4": "hetu dhammam anussaraṃ. ",
  "ja533:11.1": "Sv-āyaṃ dhammo ca te ciṇṇo ",
  "ja533:11.2": "bhattī ca viditā mayi, ",
  "ja533:11.3": "kāmaṃ karassu mayh' etaṃ, ",
  "ja533:11.4": "gacch' evānumato mayā. ",
  "ja533:12.1": "Api tv-evaṃ gate kāle ",
  "ja533:12.2": "yaṃ bandhaṃ ñātinaṃ mayā ",
  "ja533:12.3": "tayā taṃ buddhisampannam ",
  "ja533:12.4": "assa paramasaṃvutaṃ. ",
  "ja533:13.1": "Icc-eva mantayantānaṃ ",
  "ja533:13.2": "ariyānaṃ ariyavuttinaṃ ",
  "ja533:13.3": "paccadissatha nesādo ",
  "ja533:13.4": "āturānaṃ iv' antako. ",
  "ja533:14.1": "Te sattum abhisamikkha ",
  "ja533:14.2": "dīgharattaṃ hitā dijā ",
  "ja533:14.3": "tuṇhīm āsittha ubhayo ",
  "ja533:14.4": "na ca sañcesum āsanā. ",
  "ja533:15.1": "Dhataraṭṭhe ca disvāna ",
  "ja533:15.2": "samuḍḍente tato tato ",
  "ja533:15.3": "abhikkamatha vegena ",
  "ja533:15.4": "dijasattu dijādhipe. ",
  "ja533:16.1": "So ca vegen' abhikkamma ",
  "ja533:16.2": "āsajja parame dije ",
  "ja533:16.3": "paccakampittha nesādo ",
  "ja533:16.4": "baddhā iti vicintayaṃ ",
  "ja533:17.1": "Ekañ ca baddhaṃ āsīnaṃ ",
  "ja533:17.2": "abaddhañ ca punāparaṃ ",
  "ja533:17.3": "āsajja baddham āsīnaṃ ",
  "ja533:17.4": "pekkhamānam adīnavaṃ. ",
  "ja533:18.1": "Tato so vimato yeva ",
  "ja533:18.2": "paṇḍare ajjhabhāsatha ",
  "ja533:18.3": "pavaddhakāye āsīne ",
  "ja533:18.4": "dijasaṃghagaṇādhipe: ",
  "ja533:19.1": "Yan nu pāsena mahatā ",
  "ja533:19.2": "baddho na kurute desaṃ -- ",
  "ja533:19.3": "atha kasmā abaddho tvaṃ ",
  "ja533:19.4": "balī pakkhī na gacchasi. ",
  "ja533:20.1": "Kin nu t'āyaṃ dijo hoti, ",
  "ja533:20.2": "mutto baddham upāsasi, (IV 426|10) ",
  "ja533:20.3": "ohāya sakuṇā yanti, ",
  "ja533:20.4": "kiṃ eko avahīyasi. ",
  "ja533:21.1": "Rājā me so dijāmitta ",
  "ja533:21.2": "sakhā pāṇasamo ca me, ",
  "ja533:21.3": "n' eva naṃ vijahissāmi ",
  "ja533:21.4": "yāva kālassa pariyāyaṃ. ",
  "ja533:22.1": "Kathaṃ panāyaṃ vihago ",
  "ja533:22.2": "nāddasa pāsam oḍḍitaṃ, padaṃ h' ",
  "ja533:22.3": "etaṃ mahantānaṃ, ",
  "ja533:22.4": "bodhum arahanti āpadaṃ. ",
  "ja533:23.1": "Yadā parābhavo hoti ",
  "ja533:23.2": "poso jīvitasaṃkhaye (IV 425|27) ",
  "ja533:23.3": "atha jālañ ca pāsañ ca ",
  "ja533:23.4": "āsajjāpi na bujjhati. ",
  "ja533:24.1": "Api tv-eva mahāpuñña ",
  "ja533:24.2": "pāsā bahuvidhā tatā ",
  "ja533:24.3": "gūḷham āsajja bajjhanti ",
  "ja533:24.4": "ath' evaṃ jīvitakkhayeti. ",
  "ja533:25.1": "Api n' āyaṃ tayā saddhiṃ ",
  "ja533:25.2": "sambhāsassa sukhudrayo, ",
  "ja533:25.3": "api no anumaññasi, ",
  "ja533:25.4": "api no jīvitaṃ dadeti g. ā. ",
  "ja533:26.1": "Na c' eva me tvaṃ baddho si, ",
  "ja533:26.2": "na pi icchāmi te vadhaṃ, ",
  "ja533:26.3": "kāmaṃ khippam ito gantvā ",
  "ja533:26.4": "jīva tvaṃ anigho ciranti g. ā. N' evāham etaṃ ",
  "ja533:27.1": "icchāmi ",
  "ja533:27.2": "aññatr' etassa jīvitā, ",
  "ja533:27.3": "sace ekena tuṭṭho si ",
  "ja533:27.4": "muñc' etaṃ mañ ca bhakkhaya. ",
  "ja533:28.1": "Ārohapariṇāhena ",
  "ja533:28.2": "tuly' asmā vayasā ubho, ",
  "ja533:28.3": "na te lābhena jīn' atthi, ",
  "ja533:28.4": "etena niminā tuvaṃ. ",
  "ja533:29.1": "Tad iṃgha samavekkhassu, ",
  "ja533:29.2": "hotu giddhi tavāsmasu, ",
  "ja533:29.3": "maṃ pubbe bandha pāsena ",
  "ja533:29.4": "pacchā muñca dijādhipaṃ. ",
  "ja533:30.1": "Tāvad eva ca te lābho ",
  "ja533:30.2": "katassā yācanāya ca ",
  "ja533:30.3": "mettī ca dhataraṭṭhehi ",
  "ja533:30.4": "yāvajīvāya te siyāti. ",
  "ja533:31.1": "Passantu no mahāsaṃghā ",
  "ja533:31.2": "tayā muttam ito gataṃ ",
  "ja533:31.3": "mittāmaccā ca bhaccā ca ",
  "ja533:31.4": "puttadārā ca bandhavā. ",
  "ja533:32.1": "Na ca te tādisā mittā ",
  "ja533:32.2": "bahunnaṃ idha vijjati ",
  "ja533:32.3": "yathā tvaṃ dhataraṭṭhassa ",
  "ja533:32.4": "pāṇasādhāraṇo sakhā. ",
  "ja533:33.1": "So te sahāyaṃ muñcāmi, ",
  "ja533:33.2": "hotu rājā tavānugo, ",
  "ja533:33.3": "kāmaṃ khippam ito gantvā ",
  "ja533:33.4": "ñātimajjhe virocathāti. ",
  "ja533:34.1": "So patīto pamuttena ",
  "ja533:34.2": "bhattunā bhattugāravo ",
  "ja533:34.3": "ajjhabhāsatha vakkaṅgo ",
  "ja533:34.4": "vācaṃ kaṇṇasukhaṃ bhaṇaṃ: ",
  "ja533:35.1": "Evaṃ luddaka nandassu ",
  "ja533:35.2": "saha sabbehi ñātibhi ",
  "ja533:35.3": "yathāham ajja nandāmi ",
  "ja533:35.4": "muttaṃ disvā dijādhipanti. ",
  "ja533:36.1": "Ehi taṃ anusikkhāmi ",
  "ja533:36.2": "yathā tvam api lacchase ",
  "ja533:36.3": "lābhaṃ yathāyaṃ dhataraṭṭho ",
  "ja533:36.4": "pāpaṃ kiñci na dakkhati. ",
  "ja533:37.1": "Khippam antepuraṃ netvā ",
  "ja533:37.2": "rañño dassehi no ubho ",
  "ja533:37.3": "abaddhe pakatibhūte ",
  "ja533:37.4": "kāce ubhayato ṭhite ",
  "ja533:38.1": "Dhataraṭṭhā mahārāja ",
  "ja533:38.2": "haṃsādhipatino ime, ",
  "ja533:38.3": "ayaṃ hi rājā haṃsānaṃ, ",
  "ja533:38.4": "ayaṃ senāpatītaro. ",
  "ja533:39.1": "Asaṃsayaṃ imaṃ disvā ",
  "ja533:39.2": "haṃsarājaṃ narādhipo ",
  "ja533:39.3": "patīto sumano vitto ",
  "ja533:39.4": "bahuṃ dassati te dhananti. ",
  "ja533:40.1": "Tassa taṃ vacanaṃ sutvā ",
  "ja533:40.2": "kammanā upapādayi, ",
  "ja533:40.3": "khippam antepuraṃ gantvā ",
  "ja533:40.4": "rañño haṃse adassayi ",
  "ja533:40.5": "abaddhe pakatibhūte ",
  "ja533:40.6": "kāce ubhayato ṭhite. ",
  "ja533:41.1": "Dhataraṭṭhā mahārāja ",
  "ja533:41.2": "haṃsādhipatino ime, ",
  "ja533:41.3": "ayaṃ hi rājā haṃsānaṃ, ",
  "ja533:41.4": "ayaṃ senāpatītaro ",
  "ja533:42.1": "Kathaṃ pan' ime vihagā ",
  "ja533:42.2": "tava hatthattham āgatā, ",
  "ja533:42.3": "kathaṃ luddo mahantānaṃ ",
  "ja533:42.4": "issare-m-idha-m-ajjhagā. ",
  "ja533:43.1": "Vihitā sant' ime pāsā ",
  "ja533:43.2": "pallalesu janādhipa ",
  "ja533:43.3": "yaṃ yadā yatanaṃ maññe ",
  "ja533:43.4": "dijānaṃ pāṇarodhanaṃ. ",
  "ja533:44.1": "Tādisaṃ pāsam āsajja ",
  "ja533:44.2": "haṃsarājā abajjhatha, ",
  "ja533:44.3": "taṃ abaddho upāsīno ",
  "ja533:44.4": "mamāyaṃ ajjhabhāsatha: ",
  "ja533:45.1": "Sudukkaraṃ anariyehi ",
  "ja533:45.2": "dahate bhāvam uttamaṃ ",
  "ja533:45.3": "bhattur atthe parakkanto ",
  "ja533:45.4": "dhamme yutto vihaṅgamo. ",
  "ja533:46.1": "Attan' āyaṃ cajitvāna ",
  "ja533:46.2": "jīvitaṃ jīvitāraho ",
  "ja533:46.3": "anutthunanto āsīno ",
  "ja533:46.4": "bhattu yācittha jīvitaṃ. ",
  "ja533:47.1": "Tassa taṃ. vacanaṃ sutvā ",
  "ja533:47.2": "pasādam aham ajjhagaṃ. ",
  "ja533:47.3": "tato taṃ pāmuñciṃ pāsā ",
  "ja533:47.4": "anuññāsiṃ sukhena ca. ",
  "ja533:48.1": "So patīto pamuttena ",
  "ja533:48.2": "bhattunā bhattugāravo ",
  "ja533:48.3": "ajjhabhāsatha vakkaṅgo ",
  "ja533:48.4": "vācaṃ kaṇṇasukkhaṃ bhaṇaṃ. ",
  "ja533:49.1": "Evaṃ luddaka nandassu ",
  "ja533:49.2": "saha sabbehi ñātibhi ",
  "ja533:49.3": "yathāham ajja nandāmi ",
  "ja533:49.4": "muttaṃ disvā dijādhipaṃ. ",
  "ja533:50.1": "Ehi taṃ anusikkhāmi ",
  "ja533:50.2": "yathā tvam api lacchase ",
  "ja533:50.3": "lābhaṃ yathāyaṃ dhataraṭṭho ",
  "ja533:50.4": "pāpaṃ kiñci na dakkhati. ",
  "ja533:51.1": "Khippam antepuraṃ gantvā ",
  "ja533:51.2": "rañño dassehi no ubho ",
  "ja533:51.3": "abaddhe pakatibhūte ",
  "ja533:51.4": "kāce ubhayato ṭhite. ",
  "ja533:52.1": "Dhataraṭṭhā mahārāja ",
  "ja533:52.2": "haṃsādhipatino ime, ",
  "ja533:52.3": "ayaṃ hi rājā haṃsānaṃ , ",
  "ja533:52.4": "ayaṃ senāpatītaro. ",
  "ja533:53.1": "Asaṃsayaṃ imaṃ disvā ",
  "ja533:53.2": "haṃsarājaṃ narādhipo ",
  "ja533:53.3": "patīto sumano vitto ",
  "ja533:53.4": "bahuṃ dassati te dhanaṃ. ",
  "ja533:54.1": "Evam etassa vacanā ",
  "ja533:54.2": "ānītā 'me ubho mayā, ",
  "ja533:54.3": "etth' eva hi ime assu ",
  "ja533:54.4": "ubho anumatā mayā. ",
  "ja533:55.1": "So 'yaṃ evaṃgato pakkhī ",
  "ja533:55.2": "dijo paramadhammiko. ",
  "ja533:55.3": "mādisassa hi luddassa ",
  "ja533:55.4": "janayeyyātha maddavaṃ. ",
  "ja533:56.1": "Upāyanaṃ hi te deva ",
  "ja533:56.2": "nāññaṃ passāmi edisaṃ ",
  "ja533:56.3": "sabbasākuṇikagāme, ",
  "ja533:56.4": "taṃ passa manujādhipāti. ",
  "ja533:57.1": "Disvā nisinnaṃ rājānaṃ ",
  "ja533:57.2": "pīṭhe sovaṇṇaye subhe ",
  "ja533:57.3": "ajjhabhāsatha vakkaṅgo ",
  "ja533:57.4": "vācaṃ kaṇṇasukhaṃ bhaṇaṃ: ",
  "ja533:58.1": "Kacci nu bhoto kusalaṃ, ",
  "ja533:58.2": "kacci bhoto anāmayaṃ, ",
  "ja533:58.3": "kacci raṭṭham idaṃ phītaṃ ",
  "ja533:58.4": "dhammena-m-anusissati. ",
  "ja533:59.1": "Kusalañ c' eva me haṃsa, ",
  "ja533:59.2": "atho haṃsa anāmayaṃ, ",
  "ja533:59.3": "atho raṭṭham idaṃ phītaṃ ",
  "ja533:59.4": "dhammena-m-anusissati. ",
  "ja533:60.1": "Kacci bhoto amaccesu ",
  "ja533:60.2": "doso koci na vijjati, ",
  "ja533:60.3": "kaccin nu te tav' atthesu ",
  "ja533:60.4": "nāvakaṃkhanti jīvitaṃ. ",
  "ja533:61.1": "Atho pi me amaccesu ",
  "ja533:61.2": "doso koci na vijjati, ",
  "ja533:61.3": "atho p' ime mam' atthesu ",
  "ja533:61.4": "nāvakaṃkhanti jīvitaṃ. ",
  "ja533:62.1": "Kacci te sādisī bhariyā ",
  "ja533:62.2": "assavā piyabhāṇinī ",
  "ja533:62.3": "puttarūpayasūpetā ",
  "ja533:62.4": "tava-cchandavasānugā. ",
  "ja533:63.1": "Atho pi me sādisī bhariyā ",
  "ja533:63.2": "assavā piyabhāṇinī ",
  "ja533:63.3": "puttarūpayasūpetā ",
  "ja533:63.4": "mama-cchandavasānugāti. Bhavan ",
  "ja533:64.1": "tu kacci nu mahāsattuhatthatthataṃ ",
  "ja533:64.2": "gato ",
  "ja533:64.3": "dukkham āpajji vipulaṃ ",
  "ja533:64.4": "tasmiṃ paṭhamamāpade. ",
  "ja533:65.1": "Kacci yan n' āpatitvāna ",
  "ja533:65.2": "daṇḍena samapothayi, ",
  "ja533:65.3": "evam etesaṃ jammānaṃ ",
  "ja533:65.4": "pākatikaṃ bhavati tāvade. ",
  "ja533:66.1": "Khemam āsi mahārāja ",
  "ja533:66.2": "evam āpadi saṃsati ",
  "ja533:66.3": "na cāyaṃ kiñci-r-asmāsu ",
  "ja533:66.4": "sattū va samapajjatha. ",
  "ja533:67.1": "Paccakampittha nesādo, ",
  "ja533:67.2": "pubbe va ajjhabhāsatha, ",
  "ja533:67.3": "tadāyaṃ Sumukho yeva ",
  "ja533:67.4": "paṇḍito paccabhāsatha. ",
  "ja533:68.1": "Tassa taṃ vacanaṃ sutvā ",
  "ja533:68.2": "pasādam ayam ajjhagā, ",
  "ja533:68.3": "tato maṃ pāmuñci pāsā ",
  "ja533:68.4": "anuññāsi sukhena ca. ",
  "ja533:69.1": "Idam pi Sumukhen' eva ",
  "ja533:69.2": "etadatthāya cintitaṃ ",
  "ja533:69.3": "bhoto sakāse āgamanaṃ ",
  "ja533:69.4": "etassa dhanaṃ icchatā Svāgatañ c' ev' ",
  "ja533:70.1": "idaṃ bhavataṃ ",
  "ja533:70.2": "patīto c' asmi dassanā, ",
  "ja533:70.3": "eso api bahuṃ vittaṃ ",
  "ja533:70.4": "labhataṃ yāvat' icchīti. ",
  "ja533:71.1": "Santappayitvā nesādaṃ ",
  "ja533:71.2": "bhogehi manujādhipo ",
  "ja533:71.3": "ajjhabhāsatha vakkaṅgaṃ ",
  "ja533:71.4": "vācaṃ kaṇṇasukhaṃ bhaṇanti g. ā. ",
  "ja533:72.1": "Yaṃ khalu dhammam ādhīnaṃ ",
  "ja533:72.2": "vaso vattati kiñcanaṃ ",
  "ja533:72.3": "sabb' atth' issariyaṃ ",
  "ja533:72.4": "bhavataṃ pasāsatha yad icchatha. ",
  "ja533:73.1": "Dānatthaṃ upabhotthuṃ vā ",
  "ja533:73.2": "yaṃ c' aññaṃ upakappati ",
  "ja533:73.3": "etaṃ dadāmi vo vittaṃ ",
  "ja533:73.4": "issaraṃ issajāmi voti āha. ",
  "ja533:74.1": "Yathā ca my-āyaṃ Sumukho ",
  "ja533:74.2": "ajjhabhāseyya paṇḍito ",
  "ja533:74.3": "kāmasā buddhisampanno ",
  "ja533:74.4": "tam my-āssa paramappiyanti. ",
  "ja533:75.1": "Ahaṃ khalu mahārāja ",
  "ja533:75.2": "nāgarājā-r-iv' antaraṃ ",
  "ja533:75.3": "pativattuṃ na sakkomi, ",
  "ja533:75.4": "na me so vinayo siyā. ",
  "ja533:76.1": "Amhākam eva yo seṭṭho ",
  "ja533:76.2": "tvañ ca uttamasattavo ",
  "ja533:76.3": "bhūmipālo manussindo ",
  "ja533:76.4": "pūjā bahūhi hetubhi. ",
  "ja533:77.1": "Tesaṃ ubhinnaṃ bhaṇataṃ ",
  "ja533:77.2": "vattamāne vinicchaye ",
  "ja533:77.3": "nāntaraṃ pativattabbaṃ ",
  "ja533:77.4": "pessena manujādhipāti. ",
  "ja533:78.1": "Dhammena kira nesādo: ",
  "ja533:78.2": "paṇḍito aṇḍajo iti, ",
  "ja533:78.3": "na h' eva akatattassa ",
  "ja533:78.4": "nayo etādiso siyāti. ",
  "ja533:79.1": "Evaṃ aggapakatimā ",
  "ja533:79.2": "evaṃ uttamasattavo ",
  "ja533:79.3": "yāvat' atthi mayā diṭṭhā ",
  "ja533:79.4": "nāññaṃ passāmi edisaṃ ",
  "ja533:80.1": "Tuṭṭho 'smi vo pakatiyā ",
  "ja533:80.2": "vākyena madhurena ca, ",
  "ja533:80.3": "eso cāpi mama chando: ",
  "ja533:80.4": "ciraṃ passeyya vo ubhoti. ",
  "ja533:81.1": "Yaṃ kiñci parame mitte ",
  "ja533:81.2": "katar asmāsu taṃ tayā, ",
  "ja533:81.3": "pattā nissaṃsayaṃ ty-āmhā ",
  "ja533:81.4": "bhattir asmāsu yā tava. ",
  "ja533:82.1": "Aduñ ca nūna sumahā ",
  "ja533:82.2": "ñātisaṃghassa-m-antaraṃ, ",
  "ja533:82.3": "adassanena amhākaṃ ",
  "ja533:82.4": "dukkhaṃ bahūsu pakkhisu. ",
  "ja533:83.1": "Tesaṃ sokavighātāya ",
  "ja533:83.2": "tayā anumatā mayaṃ ",
  "ja533:83.3": "taṃ padakkhiṇato katvā ",
  "ja533:83.4": "ñātī passem' arindama. ",
  "ja533:84.1": "Addhāhaṃ vipulaṃ pītiṃ ",
  "ja533:84.2": "bhavataṃ vindāmi dassanā, ",
  "ja533:84.3": "eso cāpi mahā attho ",
  "ja533:84.4": "ñātivissāsanā siyāti. ",
  "ja533:85.1": "Idaṃ vatvā dhataraṭṭho ",
  "ja533:85.2": "haṃsarājā narādhipaṃ ",
  "ja533:85.3": "uttamajavamattāya ñātisaṃgham ",
  "ja533:85.4": "upāgamuṃ. ",
  "ja533:86.1": "Te aroge anuppatte ",
  "ja533:86.2": "disvāna parame dije ",
  "ja533:86.3": "kekāti-m-akaruṃ haṃsā, ",
  "ja533:86.4": "puthusaddo ajāyatha. ",
  "ja533:87.1": "Te patītā pamuttena ",
  "ja533:87.2": "bhattunā bhattugāravā ",
  "ja533:87.3": "samantā parikariṃsu ",
  "ja533:87.4": "aṇḍajā laddhapaccayāti. ",
  "ja533:88.1": "Evam mittavataṃ atthā ",
  "ja533:88.2": "sabbe honti padakkhiṇā ",
  "ja533:88.3": "haṃsā yathā dhataraṭṭhā ",
  "ja533:88.4": "ñātisaṃgham upāgamunti. ",
  "ja533:89.1": ""
}
