  "ja473:0.4": "",
  "ja473:1.1": "Kāni kammāni kubbānaṃ ",
  "ja473:1.2": "kathaṃ viññū parakkame ",
  "ja473:1.3": "amittaṃ jāneyya medhāvī ",
  "ja473:1.4": "disvā sutvā va paṇḍitoti. ",
  "ja473:2.1": "Na naṃ umhayate disvā ",
  "ja473:2.2": "na ca naṃ paṭinandati (vol.III 31|22) ",
  "ja473:2.3": "cakkhūni c' assa na dadāti ",
  "ja473:2.4": "paṭilomañ ca vattati. ",
  "ja473:3.1": "Amitte tassa bhajati ",
  "ja473:3.2": "mitte tassa na sevati ",
  "ja473:3.3": "vaṇṇakāme nivāreti ",
  "ja473:3.4": "akkosante pasaṃsati. ",
  "ja473:4.1": "Guyhañ ca tassa n' akkhāti ",
  "ja473:4.2": "tassa guyhaṃ na gūhati ",
  "ja473:4.3": "kammaṃ tassa na vaṇṇeti ",
  "ja473:4.4": "paññ' assa na-ppasaṃsati. ",
  "ja473:5.1": "Abhave nandati tassa ",
  "ja473:5.2": "bhave tassa na nandati ",
  "ja473:5.3": "acchariyaṃ bhojanaṃ laddhā ",
  "ja473:5.4": "tassa n' uppajjate sati, ",
  "ja473:5.5": "",
  "ja473:5.6": "",
  "ja473:6.1": "Icc-ete soḷasākārā ",
  "ja473:6.2": "amittasmiṃ patiṭṭhitā (vol. II 131|24) ",
  "ja473:6.3": "yehi amittaṃ jāneyya ",
  "ja473:6.4": "disvā sutvā va paṇḍitoti ",
  "ja473:7.1": "Kāni kammāni kubbānaṃ ",
  "ja473:7.2": "kathaṃ viññū parakkame ",
  "ja473:7.3": "mittaṃ jāneyya medhāvī ",
  "ja473:7.4": "disvā sutvā va paṇḍitoti ",
  "ja473:8.1": "Pavutthaṃ taṃ taṃ sarati ",
  "ja473:8.2": "āgataṃ abhinandati ",
  "ja473:8.3": "tato kelāyito hoti ",
  "ja473:8.4": "vācāya paṭinandati. ",
  "ja473:9.1": "Mitte tass' eva bhajati ",
  "ja473:9.2": "amitte tassa na sevati ",
  "ja473:9.3": "akkosante nivāreti ",
  "ja473:9.4": "vaṇṇakāme pasaṃsati. ",
  "ja473:10.1": "Guyhañ ca tassa akkhāti ",
  "ja473:10.2": "tassa guyhañ ca gūhati ",
  "ja473:10.3": "kammañ ca tassa vaṇṇeti ",
  "ja473:10.4": "paññaṃ tassa pasaṃsati. ",
  "ja473:11.1": "Bhave ca nandati tassa ",
  "ja473:11.2": "abhave tassa na nandati, ",
  "ja473:11.3": "acchariyaṃ bhojanaṃ laddhā ",
  "ja473:11.4": "tassa uppajjate sati, ",
  "ja473:11.5": "tato naṃ anukampati, ",
  "ja473:11.6": "aho so pi labheyy' ito. ",
  "ja473:12.1": "Icc-ete soḷasākārā ",
  "ja473:12.2": "mittasmiṃ suppatiṭṭhitā ",
  "ja473:12.3": "yehi mittaṃ su jāneyya ",
  "ja473:12.4": "disvā sutvā va paṇḍitoti. ",
