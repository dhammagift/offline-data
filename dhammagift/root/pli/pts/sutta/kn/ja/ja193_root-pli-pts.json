  "ja193:1.1": "so anañño, ",
  "ja193:1.2": "ayam eva so hatthacchinno anañño ",
  "ja193:1.3": "yam āha ‘komārapatī mamanti, ",
  "ja193:1.4": "vajjh' itthiyo, n' atthi itthīsu saccaṃ. ",
  "ja193:2.1": "Imañ ca jammaṃ musalena hantvā ",
  "ja193:2.2": "luddaṃ chavaṃ paradārūpaseviṃ ",
  "ja193:2.3": "imissā ca naṃ pāpapatibbatāya ",
  "ja193:2.4": "jīvantiyā chindatha kaṇṇanāsanti. ",
  "ja193:3.1": ""
}
