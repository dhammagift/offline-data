  "ja285:1.1": "Dariyā sattavassāni ",
  "ja285:1.2": "tiṃsamattā vasāmase, ",
  "ja285:1.3": "‘hañchema maṇino ābhaṃ' ",
  "ja285:1.4": "iti no mantitaṃ ahu. ",
  "ja285:2.1": "Yāva yāva nighaṃsāma ",
  "ja285:2.2": "bhiyyo vodāyate maṇi, ",
  "ja285:2.3": "brāhmaṇaṃ tv-eva pucchāma: ",
  "ja285:2.4": "‘kiṃ kiccaṃ idha maññasīti'. ",
  "ja285:3.1": "Ayaṃ maṇī veḷuriyo ",
  "ja285:3.2": "akāco vimalo subho, ",
  "ja285:3.3": "nāssa sakkā siriṃ hantuṃ, ",
  "ja285:3.4": "apakkamatha sūkarāti. ",
  "ja285:4.1": ""
}
