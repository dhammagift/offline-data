  "ja246:1.1": "Hantvā jhatvā vadhitvā ca ",
  "ja246:1.2": "deti dānaṃ asaññato, ",
  "ja246:1.3": "edisaṃ bhattaṃ bhuñjamāno ",
  "ja246:1.4": "so pāpena upalippatīti. ",
  "ja246:2.1": "Puttadāram pi ce hantvā ",
  "ja246:2.2": "deti dānaṃ asaññato ",
  "ja246:2.3": "bhuñjamāno pi sappañño ",
  "ja246:2.4": "na pāpena upalippatīti. ",
  "ja246:3.1": ""
}
