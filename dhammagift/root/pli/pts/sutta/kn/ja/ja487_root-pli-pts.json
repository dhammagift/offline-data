  "ja487:0.4": "",
  "ja487:1.1": "Kharājinā jaṭilā paṃkadantā (Jāt. III. ",
  "ja487:1.2": "p. 236-37.) dummukharūpā ye 'me japanti kacciṃ ",
  "ja487:1.3": "nu te mānusake payoge ",
  "ja487:1.4": "idaṃ vidū parimuttā apāyāti. ",
  "ja487:2.1": "Pāpāni kammāni karotha rāja ",
  "ja487:2.2": "bahussuto ce na careyya dhammaṃ, ",
  "ja487:2.3": "sahassavedo pi na taṃ paṭicca ",
  "ja487:2.4": "dukkhā pamuñce caraṇaṃ apatvāti. ",
  "ja487:3.1": "Sahassavedo pi na taṃ paṭicca ",
  "ja487:3.2": "dukkhā pamuñce caraṇaṃ apatvā, ",
  "ja487:3.3": "maññāmi: vedā aphalā bhavanti, ",
  "ja487:3.4": "sasaṃyamaṃ caraṇaṃ ñeva saccanti. ",
  "ja487:4.1": "Na h' eva vedā aphalā bhavanti, ",
  "ja487:4.2": "sasaṃyamaṃ caraṇaṃ ñeva saccaṃ, ",
  "ja487:4.3": "kittiṃ hi pappoti adhicca vede, ",
  "ja487:4.4": "santiṃ pun' eti caraṇena dantoti. ",
  "ja487:5.1": "Bhaccā mātāpitā bandhū, ",
  "ja487:5.2": "yena jāto sa yeva so, ",
  "ja487:5.3": "Uddālako ahaṃ bhoto ",
  "ja487:5.4": "sotthiyākulavaṃsakoti. ",
  "ja487:6.1": "Kathaṃ bho brāhmaṇo hoti, ",
  "ja487:6.2": "katham bhavati kevalī, ",
  "ja487:6.3": "kathañ ca parinibbānaṃ ",
  "ja487:6.4": "dhammaṭṭho kinti vuccatīti. ",
  "ja487:7.1": "Niraṃkatvā aggim ādāya brāhmaṇo ",
  "ja487:7.2": "āpo sijaṃ yajaṃ usseti yūpaṃ, ",
  "ja487:7.3": "evaṃkaro brāhmaṇo hoti khemī, ",
  "ja487:7.4": "dhamme ṭhitaṃ tena amāpayiṃsūti. ",
  "ja487:8.1": "Na suddhī secanen' atthi ",
  "ja487:8.2": "na pi kevali brāhmaṇo ",
  "ja487:8.3": "na khanti na pi soraccaṃ, ",
  "ja487:8.4": "na pi so parinibbutoti. ",
  "ja487:9.1": "Kathaṃ so brāhmaṇo hoti, ",
  "ja487:9.2": "kathaṃ bhavati kevalī, ",
  "ja487:9.3": "kathañ ca parinibbānaṃ ",
  "ja487:9.4": "dhammaṭṭho kinti vuccatīti. ",
  "ja487:10.1": "Akhettabandhū amamo nirāso ",
  "ja487:10.2": "nillobhapāpo bhavalobhakhīṇo ",
  "ja487:10.3": "evaṃkaro brāhmaṇo hoti khemī, ",
  "ja487:10.4": "dhamme ṭhitaṃ tena amāpayiṃsūti. ",
  "ja487:11.1": "Khattiyā brāhmaṇā vessā ",
  "ja487:11.2": "suddā caṇḍālapukkusā ",
  "ja487:11.3": "sabbe va soratā dantā ",
  "ja487:11.4": "sabbe va parinibbutā, ",
  "ja487:11.5": "sabbesaṃ sītibhūtānaṃ ",
  "ja487:11.6": "atthi seyyo va pāpiyoti. ",
  "ja487:12.1": "Khattiyā brāhmaṇā vessā ",
  "ja487:12.2": "suddā caṇḍālapukkusā ",
  "ja487:12.3": "sabbe va soratā dantā ",
  "ja487:12.4": "sabbe va parinibbutā, ",
  "ja487:12.5": "sabbesaṃ sītibhūtānaṃ ",
  "ja487:12.6": "n' atthi seyyo va pāpiyoti. ",
  "ja487:13.1": "Khattiyā brāhmaṇā vessā ",
  "ja487:13.2": "suddā caṇḍālapukkusā ",
  "ja487:13.3": "sabbe va soratā dantā ",
  "ja487:13.4": "sabbe va parinibbutā, ",
  "ja487:14.1": "sabbesaṃ sītibhūtānaṃ ",
  "ja487:14.2": "n' atthi seyyo va pāpiyo. ",
  "ja487:14.3": "panaṭṭhaṃ carasi brāhmaññaṃ ",
  "ja487:14.4": "sotthiyākulavaṃsatanti. ",
  "ja487:15.1": "Nānārattehi vatthehi ",
  "ja487:15.2": "vimānam bhavati chāditaṃ, ",
  "ja487:15.3": "na tesaṃ chāyā vatthānaṃ, ",
  "ja487:15.4": "so rāgo anupajjatha. ",
  "ja487:16.1": "Evamevaṃ manussesu ",
  "ja487:16.2": "sadā sujjhanti mānavā, ",
  "ja487:16.3": "na tesaṃ jātiṃ pucchanti ",
  "ja487:16.4": "dhammam aññāya subbatāti. ",
  "ja487:17.1": ""
}
