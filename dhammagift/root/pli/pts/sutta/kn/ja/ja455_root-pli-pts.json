  "ja455:0.4": "",
  "ja455:1.1": "Tassa nāgassa vippavāsena ",
  "ja455:1.2": "virūḷhā sallakī ca kuṭajā ca ",
  "ja455:1.3": "kuruvindakaravīrā bhisasāmā ca ",
  "ja455:1.4": "nivāte pupphitā kaṇikārā. ",
  "ja455:2.1": "Kocid eva suvaṇṇakāyūrā ",
  "ja455:2.2": "nāgarājaṃ bharanti piṇḍena ",
  "ja455:2.3": "yattha rājā rājakumāro vā ",
  "ja455:2.4": "kavacam abhihessati asambhītoti. ",
  "ja455:3.1": "Gaṇhāhi nāga kabalaṃ, ",
  "ja455:3.2": "mā nāga kisako bhava, ",
  "ja455:3.3": "bahūni rājakiccāni ",
  "ja455:3.4": "yāni nāga karissasīti. ",
  "ja455:4.1": "Sā nūna sā kapaṇiyā ",
  "ja455:4.2": "andhā aparināyikā ",
  "ja455:4.3": "khāṇuṃ pādena ghaṭṭeti ",
  "ja455:4.4": "giriṃ Caṇḍoraṇam patīti. ",
  "ja455:5.1": "Kā nu te sā mahānāga ",
  "ja455:5.2": "andhā aparināyikā ",
  "ja455:5.3": "khāṇuṃ pādena ghaṭṭeti ",
  "ja455:5.4": "giriṃ Caṇḍoraṇam patīti ",
  "ja455:6.1": "Mātā me sā mahārāja ",
  "ja455:6.2": "andhā aparināyikā ",
  "ja455:6.3": "khāṇuṃ pādena ghaṭṭeti ",
  "ja455:6.4": "giriṃ Caṇḍoraṇam patīti ",
  "ja455:7.1": "Muñcath' etaṃ mahānāgaṃ ",
  "ja455:7.2": "yo 'yaṃ bharati mātaraṃ, ",
  "ja455:7.3": "sametu mātarā nāgo ",
  "ja455:7.4": "saha sabbehi ñātibhīti. ",
  "ja455:8.1": "Mutto ca bandhanā nāgo ",
  "ja455:8.2": "mutto dāmāto kuñjaro ",
  "ja455:8.3": "muhuttaṃ assasitvāna ",
  "ja455:8.4": "agamā yena pabbato. ",
  "ja455:9.1": "Tato so naḷiniṃ gantvā ",
  "ja455:9.2": "sītaṃ kuñjarasevitaṃ ",
  "ja455:9.3": "soṇḍāya udakam āhatvā ",
  "ja455:9.4": "mātaraṃ abhisiñcathāti. ",
  "ja455:10.1": "Ko 'yaṃ anariyo devo ",
  "ja455:10.2": "akālen ativassati, ",
  "ja455:10.3": "gato me atrajo putto ",
  "ja455:10.4": "yo mayhaṃ paricārakoti. ",
  "ja455:11.1": "Uṭṭhehi amma, kiṃ sesi, ",
  "ja455:11.2": "āgato ty-āham atrajo, ",
  "ja455:11.3": "mutto 'mhi Kāsirājena ",
  "ja455:11.4": "Vedehena yasassināti. ",
  "ja455:12.1": "Ciraṃ jīvatu so rājā ",
  "ja455:12.2": "Kāsīnaṃ raṭṭhavaddhano ",
  "ja455:12.3": "yo me puttaṃ amocesi ",
  "ja455:12.4": "sadā vaddhāpacāyikanti. ",
  "ja455:13.1": ""
}
