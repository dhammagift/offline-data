  "ja349:0.4": "",
  "ja349:1.1": "N' eva itthīsu sāmaññaṃ ",
  "ja349:1.2": "na pi bhakkhesu sārathi, ",
  "ja349:1.3": "ath' assa sandhibhedassa ",
  "ja349:1.4": "passa yāva sucintitaṃ. ",
  "ja349:2.1": "Asi tikkho va maṃsamhi ",
  "ja349:2.2": "pesuññaṃ parivattati ",
  "ja349:2.3": "yatth' ūsabhañ ca sīhañ ca ",
  "ja349:2.4": "bhakkhayanti migādhamā. ",
  "ja349:3.1": "Imaṃ so sayanaṃ seti ",
  "ja349:3.2": "ya-y-imaṃ passasi sārathi ",
  "ja349:3.3": "yo vācaṃ sandhibhedassa ",
  "ja349:3.4": "pisunassa nibodhati. ",
  "ja349:4.1": "Te janā sukham edhanti ",
  "ja349:4.2": "narā saggagatā-r-iva ",
  "ja349:4.3": "ye vācaṃ sandhibhedassa ",
  "ja349:4.4": "nāvabodhanti sārathīti. ",
  "ja349:5.1": ""
}
