  "ja408:0.4": "",
  "ja408:1.1": "Amb' āham addaṃ vanamantarasmiṃ ",
  "ja408:1.2": "nīlobhāsaṃ phalinaṃ saṃvirūḷhaṃ, ",
  "ja408:1.3": "tam addasaṃ phalahetū vibhaggaṃ, ",
  "ja408:1.4": "taṃ disvā bhikkhācariyaṃ carāmi. ",
  "ja408:2.1": "Selaṃ sumaṭṭaṃ naravīraniṭṭhitaṃ ",
  "ja408:2.2": "nārī yugaṃ dhārayi appasaddaṃ, ",
  "ja408:2.3": "dutiyañ ca āgamma ahosi saddo, ",
  "ja408:2.4": "taṃ disvā bhikkhācariyaṃ carāmi. ",
  "ja408:3.1": "Dijā dijaṃ kuṇapam āharantaṃ ",
  "ja408:3.2": "ekaṃ samānaṃ bahukā samecca ",
  "ja408:3.3": "āhārahetū paripātayiṃsu, ",
  "ja408:3.4": "taṃ disvā bhikkhācariyaṃ carāmi. ",
  "ja408:4.1": "Usabh' āham addaṃ yūthassa majjhe ",
  "ja408:4.2": "calakkakuṃ vaṇṇabalūpapannaṃ, ",
  "ja408:4.3": "tam addasaṃ kāmahetū vitunnaṃ, ",
  "ja408:4.4": "taṃ disvā bhikkhācariyaṃ carāmīti. Karaṇḍu ",
  "ja408:5.1": "nāma Kaliṅgānaṃ ",
  "ja408:5.2": "Gandhārānañ ca Naggaji ",
  "ja408:5.3": "Nimirājā Videhānaṃ ",
  "ja408:5.4": "Pañcālānañ ca Dummukho, ",
  "ja408:5.5": "ete raṭṭhāni hitvāna ",
  "ja408:5.6": "pabbajiṃsu akiñcanā. ",
  "ja408:6.1": "Sabb' ev' ime devasamā samāgatā ",
  "ja408:6.2": "aggī yathā pajjalito tath' ev' ime, ",
  "ja408:6.3": "aham pi eko carissāmi Bhaggavi ",
  "ja408:6.4": "hitvāna kāmāni yathodhikānīti. ",
  "ja408:7.1": "Ayam eva kālo, na hi añño atthi, ",
  "ja408:7.2": "anusāsitā me na bhaveyya pacchā, ",
  "ja408:7.3": "aham pi ekā carissāmi bhaggava ",
  "ja408:7.4": "sakuṇī va muttā purisassa hatthāti ",
  "ja408:8.1": "Āmaṃ pakkañ ca jānanti ",
  "ja408:8.2": "atho loṇaṃ aloṇikaṃ, ",
  "ja408:8.3": "tam ahaṃ disvā pabbajiṃ, ",
  "ja408:8.4": "car' eva tvaṃ carām' ahanti. Ahañ ce Daḷhadhammāya ",
  "ja408:9.1": ""
}
