  "ja351:0.4": "",
  "ja351:1.1": "Jīno rathassamaṇikuṇḍalā ca, ",
  "ja351:1.2": "putte ca dāre ca tath' eva jīno, ",
  "ja351:1.3": "sabbesu bhogesu asesitesu ",
  "ja351:1.4": "kasmā na santappasi sokakāleti. ",
  "ja351:2.1": "Pubbe va maccaṃ vijahanti bhogā ",
  "ja351:2.2": "macco ca ne pubbataraṃ jahāti, ",
  "ja351:2.3": "asassatā bhogino kāmakāmi, ",
  "ja351:2.4": "tasmā na socām' ahaṃ sokakāle. ",
  "ja351:3.1": "Udeti āpūrati veti cando, ",
  "ja351:3.2": "atthaṃ tapetvāna paleti suriyo, ",
  "ja351:3.3": "viditā mayā sattuka lokadhammā, ",
  "ja351:3.4": "tasmā na socām' ahaṃ sokakāleti. ",
  "ja351:4.1": "Alaso gihī kāmabhogī nā sādhu, (Cfr. supra p.105.) ",
  "ja351:4.2": "asaññato pabbajito na sādhu, ",
  "ja351:4.3": "rājā na sādhu anisammakārī, ",
  "ja351:4.4": "yo paṇḍito kodhano taṃ na sādhu. ",
  "ja351:5.1": "Nisamma khattiyo kayirā ",
  "ja351:5.2": "nānisamma disampati, ",
  "ja351:5.3": "nisammakārino rāja ",
  "ja351:5.4": "yaso kitti ca vaḍḍhatīti āha. ",
  "ja351:6.1": ""
}
