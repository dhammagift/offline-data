  "ja262:0.4": "",
  "ja262:1.1": "Pāṇi ce muduko c' assa ",
  "ja262:1.2": "nāgo c' assa sukārito ",
  "ja262:1.3": "andhakāro ca vasseyya ",
  "ja262:1.4": "atha nūna tadā siyāti. ",
  "ja262:2.1": "Analā mudusambhāsā ",
  "ja262:2.2": "duppūrā tā nadīsamā, ",
  "ja262:2.3": "sīdanti, naṃ viditvāna ",
  "ja262:2.4": "ārakā parivajjaye. ",
  "ja262:3.1": "Yaṃ etā upasevanti ",
  "ja262:3.2": "chandasā vā dhanena vā ",
  "ja262:3.3": "jātavedo va saṇṭhānaṃ ",
  "ja262:3.4": "khippaṃ anuḍahanti nanti. ",
  "ja262:4.1": ""
}
