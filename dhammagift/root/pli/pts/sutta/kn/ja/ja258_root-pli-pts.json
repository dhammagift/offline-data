  "ja258:1.1": "Yāvatā candimasuriyā ",
  "ja258:1.2": "[pariharanti] disā bhanti virocamānā ",
  "ja258:1.3": "sabbe va dāsā Mandhātu ",
  "ja258:1.4": "[ye] pāṇā paṭhavinissitā. ",
  "ja258:2.1": "Na kahāpaṇavassena ",
  "ja258:2.2": "titti kāmesu vijjati, (Dhp. p.34.) ",
  "ja258:2.3": "appassādā dukhā kāmā ",
  "ja258:2.4": "iti viññāya paṇḍito ",
  "ja258:3.1": "Api dibbesu kāmesu ",
  "ja258:3.2": "ratiṃ so nādhigacchati, ",
  "ja258:3.3": "taṇhakkhayarato hoti ",
  "ja258:3.4": "Sammāsambuddhasāvakoti. ",
  "ja258:4.1": ""
}
