  "ja203:0.1": "",
  "ja203:0.2": "",
  "ja203:0.3": "",
  "ja203:0.4": "",
  "ja203:1.1": "Virūpakkhehi me mettaṃ, ",
  "ja203:1.2": "mettaṃ erāpathehi me, ",
  "ja203:1.3": "chabbyāputtehi me mettaṃ, ",
  "ja203:1.4": "[mettaṃ14] kaṇhāgotamakehi cāti. ",
  "ja203:2.1": "Apādakehi me mettaṃ, ",
  "ja203:2.2": "mettaṃ dipādakehi me, ",
  "ja203:2.3": "catuppadehi me mettaṃ, ",
  "ja203:2.4": "mettaṃ bahuppadehi meti. ",
  "ja203:3.1": "Mā maṃ apādako hiṃsi, ",
  "ja203:3.2": "mā maṃ hiṃsi dipādako, ",
  "ja203:3.3": "mā maṃ catuppado hiṃsi, ",
  "ja203:3.4": "mā maṃ hiṃsi bahuppadoti. ",
  "ja203:4.1": "Sabbe sattā sabbe pāṇā ",
  "ja203:4.2": "sabbe bhūtā ca kevalā ",
  "ja203:4.3": "sabbe bhadrāni passantu, ",
  "ja203:4.4": "mā kañci pāpam ",
  "ja203:5.1": "",
  "ja203:5.2": "",
  "ja203:5.3": "āgamāti. ",
  "ja203:5.4": "",
  "ja203:5.5": "",
  "ja203:5.6": "",
  "ja203:6.1": "Katā me rakkhā, katā me parittā, ",
  "ja203:6.2": "paṭikkamantu bhūtāni, ",
  "ja203:6.3": "so 'haṃ namo Bhagavato ",
  "ja203:6.4": "namo sattannaṃ Sammāsambuddhānanti. ",
  "ja203:7.1": ""
}
