  "ja226:0.3": "",
  "ja226:0.4": "",
  "ja226:1.1": "Kāle nikkhamanā sādhu, ",
  "ja226:1.2": "nākāle sādhu nikkhamo, ",
  "ja226:1.3": "akālena hi nikkhamma ",
  "ja226:1.4": "ekakaṃ pi bahūjano ",
  "ja226:1.5": "na kiñci atthaṃ joteti ",
  "ja226:1.6": "dhaṃkasenā va kosiyaṃ. ",
  "ja226:2.1": "Dhīro ca vidhividhānaññū ",
  "ja226:2.2": "paresaṃ vivarantagū ",
  "ja226:2.3": "sabbāmitte vasīkatvā ",
  "ja226:2.4": "kosiyo va sukhī siyāti. ",
  "ja226:3.1": ""
}
