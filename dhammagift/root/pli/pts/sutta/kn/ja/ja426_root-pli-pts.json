  "ja426:0.4": "",
  "ja426:1.1": "Khamanīyaṃ yāpanīyaṃ ",
  "ja426:1.2": "kacci mātula te sukhaṃ, ",
  "ja426:1.3": "sukhaṃ te ammā avaca, ",
  "ja426:1.4": "sukhakāmā hi te mayanti. ",
  "ja426:2.1": "Naṅguṭṭham me avakkamma ",
  "ja426:2.2": "heṭhayitvāna eḷiki ",
  "ja426:2.3": "s' ajja mātulavādena ",
  "ja426:2.4": "muñcitabbā nu maññasīti. ",
  "ja426:3.1": "Puratthāmukho nisinno si, ",
  "ja426:3.2": "ahaṃ te mukham āgatā, ",
  "ja426:3.3": "pacchato tuyha naṅguṭṭhaṃ, ",
  "ja426:3.4": "kathaṃ kho 'haṃ avakkaminti. ",
  "ja426:4.1": "Yāvatā caturo dīpā ",
  "ja426:4.2": "sasamuddā sapabbatā ",
  "ja426:4.3": "tāvatā mayha naṅguṭṭhaṃ ",
  "ja426:4.4": "kathaṃ kho tvaṃ vivajjayīti. ",
  "ja426:5.1": "Pubbe va m' etaṃ akkhaṃsu ",
  "ja426:5.2": "mātā pitā ca bhātaro: ",
  "ja426:5.3": "dīghaṃ duṭṭhassa naṅguṭṭhaṃ, ",
  "ja426:5.4": "s' amhi vehāyasāgatāti. ",
  "ja426:6.1": "Tañca disvāna āyantiṃ ",
  "ja426:6.2": "antalikkhasmim eḷiki ",
  "ja426:6.3": "migasaṃgho palāyittha, ",
  "ja426:6.4": "bhakkho me nāsito tayāti. Icc- ",
  "ja426:7.1": "eva vilapantiyā ",
  "ja426:7.2": "eḷikiyā ruhaṃghaso ",
  "ja426:7.3": "galakaṃ anvāmaddi ",
  "ja426:7.4": "n' atthi duṭṭhe subhāsitaṃ. ",
  "ja426:8.1": "N' eva duṭṭhe nayo atthi ",
  "ja426:8.2": "na dhammo na subhāsitaṃ, ",
  "ja426:8.3": "nikkamaṃ duṭṭhe yujjetha, ",
  "ja426:8.4": "so ca sabbhi na rajjatīti ",
  "ja426:9.1": "",
  "ja426:10.1": "",
  "ja426:11.1": "",
  "ja426:12.1": "",
  "ja426:12.2": "Parisaṃkupatho ",
  "ja426:12.3": "",
  "ja426:12.4": ""
}
