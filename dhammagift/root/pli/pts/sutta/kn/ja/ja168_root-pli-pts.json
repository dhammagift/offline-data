  "ja168:1.1": "Seno balasā patamāno ",
  "ja168:1.2": "lāpaṃ gocaraṭṭhāyinaṃ ",
  "ja168:1.3": "sahasā ajjhappatto va, ",
  "ja168:1.4": "maraṇaṃ ten' upāgamīti. ",
  "ja168:2.1": "So 'haṃ nayena sampanno ",
  "ja168:2.2": "pettike gocare rato ",
  "ja168:2.3": "apetasattu modāmi ",
  "ja168:2.4": "sampassaṃ attham attanoti. ",
  "ja168:3.1": ""
}
