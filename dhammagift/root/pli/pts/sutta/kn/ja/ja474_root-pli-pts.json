  "ja474:0.1": "",
  "ja474:0.2": "",
  "ja474:0.3": "",
  "ja474:0.4": "",
  "ja474:1.1": "Ahāsi me ambaphalāni pubbe ",
  "ja474:1.2": "aṇūni thūlāni ca brahmacārī, ",
  "ja474:1.3": "teh' eva mantehi na dāni tuyhaṃ ",
  "ja474:1.4": "dumaphalā pātubhavanti brahmeti. ",
  "ja474:2.1": "Nakkhattayogaṃ; patimānayāmi, ",
  "ja474:2.2": "khaṇaṃ muhuttaṃ na maṃ ",
  "ja474:2.3": "tosayanti, ",
  "ja474:2.4": "",
  "ja474:3.1": "Nakkhattayogaṃ na pure abhāṇi, ",
  "ja474:3.2": "khaṇaṃ muhuttaṃ na pure asaṃsi, ",
  "ja474:3.3": "athāhari ambaphalaṃ pahūtaṃ ",
  "ja474:3.4": "vaṇṇena gandhena rasen' upetaṃ. ",
  "ja474:4.1": "Mantābhijappena pur' assa tuyhaṃ ",
  "ja474:4.2": "dumapphalā pātubhavanti brahme, ",
  "ja474:4.3": "sv-ājja na pārese japam pi mante ",
  "ja474:4.4": "ayaṃ so ko nāma tav' ajja dhammoti. ",
  "ja474:5.1": "Caṇḍālaputto mama sampadāsi, ",
  "ja474:5.2": "dhammena mante pakatiñ ca saṃsi: ",
  "ja474:5.3": "mā c' assu 'me pucchito nāma gottaṃ ",
  "ja474:5.4": "guyhittho mā taṃ vijaheyya manto. ",
  "ja474:6.1": "So 'haṃ janindena janam pi puṭṭho ",
  "ja474:6.2": "makkhābhibhūto alikaṃ abhāṇiṃ, ",
  "ja474:6.3": "mantā ime brāhmaṇassāti micchā ",
  "ja474:6.4": "pahīnamanto kapaṇaṃ rudāmīti. ",
  "ja474:7.1": "Eraṇḍā pucimandā vā ",
  "ja474:7.2": "atha vā pālibhaddakā ",
  "ja474:7.3": "madhuṃ madhutthiko vinde, ",
  "ja474:7.4": "so hi tassa dumuttamo. ",
  "ja474:8.1": "Khattiyā brāhmaṇā vessā ",
  "ja474:8.2": "suddā caṇḍāla pukkusā ",
  "ja474:8.3": "yasmā dhammaṃ vijāneyya ",
  "ja474:8.4": "so hi tassa naruttamo. ",
  "ja474:9.1": "Imassa daṇḍañ ca vadhañ ca datvā ",
  "ja474:9.2": "gale gahetvā khalayātha jammaṃ ",
  "ja474:9.3": "yo uttamatthaṃ kasirena laddhaṃ ",
  "ja474:9.4": "mānātimānena vināsayitthāti ",
  "ja474:10.1": "Yathā samaṃ maññamāno pateyya ",
  "ja474:10.2": "sobbhaṃ guhaṃ narakaṃ pūtipādaṃ ",
  "ja474:10.3": "rajjūti vā akkame kaṇhasappaṃ ",
  "ja474:10.4": "andho yathā jotim adhiṭṭhaheyya ",
  "ja474:10.5": "evam pi maṃ tvaṃ khalitaṃ sapaññā ",
  "ja474:10.6": "pahīnamantassa puna-ppasīdāti ",
  "ja474:11.1": "Dhammena mante tava sampadāsiṃ, ",
  "ja474:11.2": "tvam pi dhammena paṭiggahese, ",
  "ja474:11.3": "pakatim pi te attamano asaṃsiṃ: ",
  "ja474:11.4": "dhamme ṭhitaṃ taṃ na jaheyya manto. ",
  "ja474:12.1": "Yo bāla mantaṃ kasirena laddhaṃ ",
  "ja474:12.2": "yaṃ dullabhaṃ ajja manussaloke ",
  "ja474:12.3": "kicchāpi laddhā jīvikam appañña ",
  "ja474:12.4": "vināsayī alikaṃ bhāsamāno ",
  "ja474:13.1": "Bālassa mūḷhassa akataññuno ca ",
  "ja474:13.2": "musā bhaṇantassa asaññatassa ",
  "ja474:13.3": "mante mayaṃ tādisake na dema, ",
  "ja474:13.4": "kuto mantā, gaccha na mayha ruccasīti ",
  "ja474:14.1": ""
}
