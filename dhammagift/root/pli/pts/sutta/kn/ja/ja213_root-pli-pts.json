  "ja213:1.1": "Isīnam antaraṃ katvā ",
  "ja213:1.2": "Bharurājāti me sutaṃ ",
  "ja213:1.3": "ucchinno, saha raṭṭhena ",
  "ja213:1.4": "sa rājā vibhavaṃ gato. ",
  "ja213:2.1": "Tasmā hi chandāgamanaṃ ",
  "ja213:2.2": "na-ppasaṃsanti paṇḍitā, ",
  "ja213:2.3": "aduṭṭhacitto bhāseyya ",
  "ja213:2.4": "giraṃ saccūpasaṃhitanti. ",
  "ja213:3.1": ""
}
