  "ja450:0.4": "",
  "ja450:1.1": "Apacantāpi dicchanti ",
  "ja450:1.2": "santo laddhāna bhojanaṃ, ",
  "ja450:1.3": "kim eva tvaṃ pacamāno ",
  "ja450:1.4": "yaṃ na dajjā na taṃ samaṃ. ",
  "ja450:2.1": "Maccherā ca pamādā ca ",
  "ja450:2.2": "evaṃ dānaṃ na diyyati, (cfr. Feer, Saṃyutta- I p. 18 sq.) ",
  "ja450:2.3": "puññaṃ ākaṃkhamānena ",
  "ja450:2.4": "deyyaṃ hoti vijānatāti. ",
  "ja450:3.1": "[Yass' eva bhīto na dadāti maccharī ",
  "ja450:3.2": "tad eva adadato bhayaṃ] ",
  "ja450:3.3": "dighacchā ca pipāsā ca ",
  "ja450:3.4": "yassa bhāyati maccharī ",
  "ja450:3.5": "tam eva bālaṃ phusati ",
  "ja450:3.6": "asmiṃ loke paramhi ca. ",
  "ja450:4.1": "Tasmā vineyya maccheraṃ ",
  "ja450:4.2": "dajjā dānaṃ malābhibhū, ",
  "ja450:4.3": "puññāni paralokasmiṃ ",
  "ja450:4.4": "patiṭṭhā honti pāṇinanti. ",
  "ja450:5.1": "Duddadaṃ dadamānānaṃ ",
  "ja450:5.2": "dukkaraṃ kamma kubbataṃ ",
  "ja450:5.3": "asanto nānukubbanti, ",
  "ja450:5.4": "sataṃ dhammo durannayo. ",
  "ja450:6.1": "Tasmā satañ ca asatañ ca ",
  "ja450:6.2": "nānā hoti itogati: (II 86 | 1.) ",
  "ja450:6.3": "asanto nirayaṃ yanti, ",
  "ja450:6.4": "santo saggaparāyanāti. ",
  "ja450:7.1": "Appasm' eke pavecchanti, ",
  "ja450:7.2": "bahunā eke na dicchare, ",
  "ja450:7.3": "appasmā dakkhiṇā dinnā ",
  "ja450:7.4": "sahassena samaṃ mitāti. ",
  "ja450:8.1": "Dhammaṃ care yo pi samuñchakaṃ care ",
  "ja450:8.2": "dārañ ca posaṃ dadaṃ appakasmi pi, ",
  "ja450:8.3": "sataṃ sahassānaṃ sahassayāginaṃ ",
  "ja450:8.4": "kalaṃ pi nāgghanti tathāvidhassa teti. ",
  "ja450:9.1": "Ken' esa yañño vipulo mahagghato ",
  "ja450:9.2": "samena dinnassa na aggham eti, ",
  "ja450:9.3": "kathaṃ sahassānaṃ sahassayāginaṃ ",
  "ja450:9.4": "kalam pi nāgghanti tathāvidhassa teti. ",
  "ja450:10.1": "Dadanti h' eke visame niviṭṭhā ",
  "ja450:10.2": "jhatvā vadhitvā atha socayitvā, ",
  "ja450:10.3": "sā dakkhiṇā assumukhā sadaṇḍā ",
  "ja450:10.4": "samena dinnassa na aggham eti, ",
  "ja450:10.5": "evaṃ sahassānaṃ sahassayāginaṃ ",
  "ja450:10.6": "kalam pi nāgghanti tathāvidhassa teti. ",
  "ja450:11.1": ""
}
