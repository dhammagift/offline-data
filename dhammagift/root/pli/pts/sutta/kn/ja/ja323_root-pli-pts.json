  "ja323:1.1": "Dvayaṃ yācanako rāja ",
  "ja323:1.2": "Brahmadatta nigacchati: (Vol.II 167|6.) ",
  "ja323:1.3": "alābhaṃ dhanalābhaṃ vā, ",
  "ja323:1.4": "evaṃdhammā hi yācanā. ḥ ",
  "ja323:2.1": "Yācanaṃ rodanaṃ āhu ",
  "ja323:2.2": "Pañcālānaṃ rathesabha, ",
  "ja323:2.3": "yo ca naṃ paccakkhāti ",
  "ja323:2.4": "tam āhu paṭirodanaṃ. ",
  "ja323:3.1": "Mā m' addasaṃsu rodantaṃ ",
  "ja323:3.2": "Pañcālā susamāgatā ",
  "ja323:3.3": "tavaṃ vā paṭirodantaṃ, ",
  "ja323:3.4": "tasmā icchām' ahaṃ rahoti. ",
  "ja323:4.1": "Dadāmi te brāhmaṇa rohiṇīnaṃ (Cfr.vol.II.320|16) ",
  "ja323:4.2": "gavaṃ sahassaṃ saha puṅgavena, ",
  "ja323:4.3": "ariyo hi ariyassa kathaṃ na dajjā ",
  "ja323:4.4": "sutvāna gāthā tava dhammayuttāti. ",
  "ja323:5.1": ""
}
