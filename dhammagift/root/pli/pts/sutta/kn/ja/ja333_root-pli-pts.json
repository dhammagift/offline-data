  "ja333:0.4": "",
  "ja333:1.1": "Tadeva me tvaṃ vidito ",
  "ja333:1.2": "vanamajjhe rathesabha ",
  "ja333:1.3": "yassa te khaggabaddhassa ",
  "ja333:1.4": "sannaddhassa tirīṭino ",
  "ja333:1.5": "assatthadumasākhāya ",
  "ja333:1.6": "pakkagodhā palāyathāti. ",
  "ja333:2.1": "Name namantassa, bhaje bhajantaṃ, (vol.II p.205, Minayef, ",
  "ja333:2.2": "kiccānukubbassa kareyya kiccaṃ, Gr.Palie p.XXVIII.) ",
  "ja333:2.3": "nānatthakāmassa kareyya atthaṃ, ",
  "ja333:2.4": "asambhajantam pi na sambhajeyya. ",
  "ja333:3.1": "Caje cajantaṃ, vanathaṃ na kayirā, ",
  "ja333:3.2": "apetacittena na sambhajeyya, ",
  "ja333:3.3": "dijo dumaṃ khīṇaphalanti ñatvā ",
  "ja333:3.4": "aññaṃ samekkheyya, mahā hi lokoti. ",
  "ja333:4.1": "So te karissāmi yathānubhāvaṃ (cfr. supra p. 24 l. 22) ",
  "ja333:4.2": "kataññutaṃ khattiye pekkhamāno, ",
  "ja333:4.3": "sabbañ ca te issariyaṃ dadāmi, ",
  "ja333:4.4": "yass' icchasī tassa tuvam dadāhīti. ",
  "ja333:5.1": ""
}
