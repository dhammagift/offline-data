  "ja188:0.4": "",
  "ja188:1.1": "Sīhaṅgulī sīhanakho ",
  "ja188:1.2": "sīhapādapatiṭṭhito ",
  "ja188:1.3": "so sīho sīhasaṃghamhi ",
  "ja188:1.4": "eko nadati aññathāti. ",
  "ja188:2.1": "Mā tvaṃ nadi rājaputta, ",
  "ja188:2.2": "appasaddo vane vasa, ",
  "ja188:2.3": "sarena kho taṃ jāneyyuṃ, ",
  "ja188:2.4": "na hi te pettiko saroti. ",
  "ja188:3.1": ""
}
