  "ja225:1.1": "Atthi me puriso deva ",
  "ja225:1.2": "sabbakiccesu vyāvaṭo, ",
  "ja225:1.3": "tassa c' eko 'parādh' atthi, ",
  "ja225:1.4": "tattha tvaṃ kinti maññasīti. Amhākaṃ ",
  "ja225:2.1": "c' atthi puriso ",
  "ja225:2.2": "ediso, idha vijjati, ",
  "ja225:2.3": "dullabho aṅgasampanno, ",
  "ja225:2.4": "khantir asmāka ruccatīti. ",
  "ja225:3.1": ""
}
