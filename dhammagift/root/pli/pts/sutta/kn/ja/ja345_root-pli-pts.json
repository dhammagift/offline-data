  "ja345:0.4": "",
  "ja345:1.1": "Vanaṃ yad' aggi dahati ",
  "ja345:1.2": "pāvako kaṇhavattanī ",
  "ja345:1.3": "kathaṃ karosi pacalaka ",
  "ja345:1.4": "evaṃ dandhaparakkamoti. ",
  "ja345:2.1": "Bahūni rukkhacchiddāni ",
  "ja345:2.2": "pathavyā vivarāni ca, ",
  "ja345:2.3": "tāni ce nābhisambhoma ",
  "ja345:2.4": "hoti no kālapariyāyoti. ",
  "ja345:3.1": "Yo dandhakāle tarati ",
  "ja345:3.2": "taraṇīye ca dandhati ",
  "ja345:3.3": "sukkhapaṇṇaṃ va akkamma ",
  "ja345:3.4": "atthaṃ bhañjati attano. ",
  "ja345:4.1": "Yo dandhakāle dandhati ",
  "ja345:4.2": "taraṇīye ca tārayi ",
  "ja345:4.3": "sasīva rattiṃ vibhajaṃ ",
  "ja345:4.4": "tass' attho paripūratīti. ",
  "ja345:5.1": ""
}
