  "ja476:0.4": "",
  "ja476:1.1": "haṃsa nipata, ",
  "ja476:1.2": "piyaṃ me tava dassanaṃ, ",
  "ja476:1.3": "issaro si anuppatto: ",
  "ja476:1.4": "yaṃ idh' atthi pavedayāti. ",
  "ja476:2.1": "Savanena c' ekassa piyā bhavanti, ",
  "ja476:2.2": "disvā pan' ekassa viheti chando, ",
  "ja476:2.3": "disvā ca sutvā ca piyā bhavanti, ",
  "ja476:2.4": "kaccin nu me piyyasi dassanena. ",
  "ja476:3.1": "Savanena piyo me si ",
  "ja476:3.2": "bhiyyo cāgamma dassanaṃ, ",
  "ja476:3.3": "evaṃ piyadassano samāno ",
  "ja476:3.4": "vasa haṃsa mama santiketi. ",
  "ja476:4.1": "Vaseyyāma tavāgāre ",
  "ja476:4.2": "niccaṃ sakkatapūjitā, ",
  "ja476:4.3": "matto va ekadā vajjā ",
  "ja476:4.4": "‘haṃsarājaṃ pacantu me'. ",
  "ja476:5.1": "Dhi-r-atthu taṃ annapānaṃ ",
  "ja476:5.2": "yaṃ me piyataraṃ tayā, ",
  "ja476:5.3": "na cāpi majjaṃ pāyāmi ",
  "ja476:5.4": "yāva me vacchasī ghareti ",
  "ja476:6.1": "Suvijānaṃ sigālānaṃ sakuntānañ ",
  "ja476:6.2": "ca vassitaṃ, ",
  "ja476:6.3": "manussavassitaṃ rāja ",
  "ja476:6.4": "dubbijānataraṃ tato. ",
  "ja476:7.1": "Api ce maññatī poso ",
  "ja476:7.2": "‘ñātimitto' ‘sakhāti vā ",
  "ja476:7.3": "yo pubbe sumano hutvā ",
  "ja476:7.4": "pacchā sampajjate diso. ",
  "ja476:8.1": "Yasmiṃ mano nivisati ",
  "ja476:8.2": "avidūre sahāpi so, ",
  "ja476:8.3": "santike hi pi so dūre ",
  "ja476:8.4": "yasmā vivasate mano. ",
  "ja476:9.1": "Anto pi yo hoti pasannacitto ",
  "ja476:9.2": "pāraṃ samuddassa pasannacitto, ",
  "ja476:9.3": "anto pi yo hoti paduṭṭhacitto ",
  "ja476:9.4": "pāraṃ samuddassa paduṭṭhacitto. ",
  "ja476:10.1": "Saṃvasanto vivasanti ",
  "ja476:10.2": "ye disā te rathesabha, ",
  "ja476:10.3": "ārā santo saṃvasanti ",
  "ja476:10.4": "manasā raṭṭhavaḍḍhana. ",
  "ja476:11.1": "Aticiraṃnivāsena ",
  "ja476:11.2": "piyo bhavati appiyo, ",
  "ja476:11.3": "āmanta kho taṃ gacchāma ",
  "ja476:11.4": "pura te homa appiyāti. Evaṃ ",
  "ja476:12.1": "ce yācamānānaṃ ",
  "ja476:12.2": "añjaliṃ nāvabujjhasi ",
  "ja476:12.3": "paricārakānaṃ sattānaṃ ",
  "ja476:12.4": "vacanaṃ na karosi no ",
  "ja476:12.5": "evaṃ taṃ abhiyācāma: ",
  "ja476:12.6": "puna kayirāsi pariyāyanti. Evaṃ ",
  "ja476:13.1": "ce no viharataṃ ",
  "ja476:13.2": "antarāyo na hessati ",
  "ja476:13.3": "tuyhaṃ vāpi mahārāja ",
  "ja476:13.4": "mayhaṃ vā raṭṭhavaddhana ",
  "ja476:13.5": "app-eva nāma passema ",
  "ja476:13.6": "ahorattānaṃ accayeti. ",
  "ja476:14.1": ""
}
