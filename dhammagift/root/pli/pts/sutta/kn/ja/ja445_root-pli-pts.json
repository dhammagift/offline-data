  "ja445:0.4": "",
  "ja445:1.1": "Na vāham etaṃ jānāmi ",
  "ja445:1.2": "ko vāyaṃ kassa vāti vā ",
  "ja445:1.3": "yathā Sākho vadī evaṃ ",
  "ja445:1.4": "Nigrodha kinti maññasi. ",
  "ja445:2.1": "Tato galavinītena ",
  "ja445:2.2": "purisā niddhāpayiṃsu maṃ ",
  "ja445:2.3": "datvā mukhapahārāni ",
  "ja445:2.4": "Sākhassa vacanaṃkarā. ",
  "ja445:3.1": "Etādisaṃ dummatinā ",
  "ja445:3.2": "akataññuna dubbhinā ",
  "ja445:3.3": "kataṃ anariyaṃ Sākhena ",
  "ja445:3.4": "sakhinā te janādhipāti. ",
  "ja445:4.1": "Na vāham etaṃ jānāmi ",
  "ja445:4.2": "na pi me koci saṃsati ",
  "ja445:4.3": "yam me tvaṃ samma akkhāsi ",
  "ja445:4.4": "Sākhena katanaṃ kataṃ. ",
  "ja445:5.1": "Sakhīnaṃ sājīvakaro ",
  "ja445:5.2": "mama Sākhassa c' ūbhayaṃ, ",
  "ja445:5.3": "tvaṃ no 's' issariyaṃ dātā ",
  "ja445:5.4": "manussesu mahantataṃ, ",
  "ja445:5.5": "tay' amhā labbhitā iddhi, ",
  "ja445:5.6": "ettha me n' atthi saṃsayo. ",
  "ja445:6.1": "Yathāpi bījaṃ aggismiṃ ",
  "ja445:6.2": "ḍayhati na virūhati ",
  "ja445:6.3": "evaṃ kataṃ asappurise ",
  "ja445:6.4": "nassati na virūhati. ",
  "ja445:7.1": "Kataññumhi ca posamhi ",
  "ja445:7.2": "sīlavante ariyavuttine ",
  "ja445:7.3": "sukhette viya bījāni ",
  "ja445:7.4": "kataṃ tamhi na nassatīti. Imañ ",
  "ja445:8.1": "ca jammaṃ nekatikaṃ ",
  "ja445:8.2": "asappurisacintakaṃ ",
  "ja445:8.3": "hanantu Sākhaṃ sattīhi, ",
  "ja445:8.4": "nāssa icchāmi jīvitanti. Khamyat' ",
  "ja445:9.1": "assa mahārāja, ",
  "ja445:9.2": "pāṇā duppaṭiānayā, ",
  "ja445:9.3": "khama deva asappurisassa, ",
  "ja445:9.4": "nāssa icchām' ahaṃ vadhanti. ",
  "ja445:10.1": "Nigrodham eva seveyya, ",
  "ja445:10.2": "na Sākham upasaṃvase, (J. I. p. 152. Māhavastu I. p. 366. Dhp. p. 329.) ",
  "ja445:10.3": "Nigrodhasmiṃ mataṃ seyyo ",
  "ja445:10.4": "yañce Sākhasmi jīvitanti. ",
  "ja445:11.1": ""
}
