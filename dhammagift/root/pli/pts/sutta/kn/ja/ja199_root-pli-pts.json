  "ja199:1.1": "Ubhayam me na khamati, ",
  "ja199:1.2": "ubhayam me na ruccati: ",
  "ja199:1.3": "yā cāyaṃ koṭṭham otiṇṇā ‘na ",
  "ja199:1.4": "dassaṃ' iti bhāsati. ",
  "ja199:2.1": "Taṃ taṃ gāmapati brūmi: ",
  "ja199:2.2": "kadare appasmiṃ jīvite ",
  "ja199:2.3": "dve māse kāraṃ katvāna ",
  "ja199:2.4": "maṃsaṃ jaraggavaṃ kisaṃ ",
  "ja199:2.5": "appattakāle codesi, ",
  "ja199:2.6": "tam pi mayhaṃ na ruccatīti. Sarīradavyaṃ vaddhavyaṃ ",
  "ja199:3.1": ""
}
