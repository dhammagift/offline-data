  "ja513:0.4": "",
  "ja513:1.1": "Cirassaṃ vata me udapādi ajja ",
  "ja513:1.2": "bhakkho mahā sattamibhattakāle, ",
  "ja513:1.3": "kuto si ko vāsi tad iṃgha brūhi, ",
  "ja513:1.4": "ācikkha jātiṃ vidito yathāsīti. ",
  "ja513:2.1": "Pañcālarājā migavaṃ pavuttho ",
  "ja513:2.2": "Jayaddiso nāma yadi-ssuto te ",
  "ja513:2.3": "carāmi kacchāni vanāni cāhaṃ, ",
  "ja513:2.4": "pasadaṃ imaṃ khāda, mam ajja muñcāti. ",
  "ja513:3.1": "Sen' eva tvaṃ paṇasī sassamāno, ",
  "ja513:3.2": "mam' esa bhakkho pasad' āyaṃ vadesi, ",
  "ja513:3.3": "taṃ khādiyānaṃ pasadaṃ dighaññaṃ ",
  "ja513:3.4": "khādissaṃ pacchā, na vilāpakāloti. ",
  "ja513:4.1": "Na c' atthi mokkho mama nikkayena ",
  "ja513:4.2": "gantvāna paccāgamanāya paṇhe ",
  "ja513:4.3": "taṃ saṃgaraṃ brāhmaṇassa-ppadāya ",
  "ja513:4.4": "saccānurakkhī punar āvajissanti. ",
  "ja513:5.1": "Kiṃ kammajātaṃ anutappatī taṃ ",
  "ja513:5.2": "pattaṃ samīpaṃ maraṇassa rāja, ",
  "ja513:5.3": "ācikkha me taṃ, api sakkuṇemu ",
  "ja513:5.4": "anujānituṃ āgamanāya paṇheti. ",
  "ja513:6.1": "Katā mayā brāhmaṇassa dhanāsā, ",
  "ja513:6.2": "taṃ saṃgaraṃ paṭimokkhaṃ na muttaṃ, ",
  "ja513:6.3": "taṃ saṃgaraṃ brāhmaṇassa-ppadāya ",
  "ja513:6.4": "saccānurakkhī punar āvajissanti. ",
  "ja513:7.1": "Yā te katā brāhmaṇassa dhanāsā ",
  "ja513:7.2": "taṃ saṃgaraṃ paṭimokkhaṃ na muttaṃ, ",
  "ja513:7.3": "taṃ saṃgaraṃ brāhmaṇassa-ppadāya ",
  "ja513:7.4": "saccānurakkhī punar āvajassūti. ",
  "ja513:8.1": "Mutto ca so purisādassa hatthā ",
  "ja513:8.2": "gantvā sakaṃ mandiraṃ kāmakāmī ",
  "ja513:8.3": "",
  "ja513:8.4": "",
  "ja513:9.1": "Ajj' eva rajjaṃ abhisecayassu. ",
  "ja513:9.2": "dhammañ cara sesu paresu cāpi. ",
  "ja513:9.3": "adhammakāro te māhu raṭṭhe, ",
  "ja513:9.4": "gacchām' ahaṃ porisādassa ñatteti. ",
  "ja513:10.1": "Kiṃ kamma kubbaṃ tava deva ",
  "ja513:10.2": "pāde nārādhayim, tad icchāmi sotuṃ ",
  "ja513:10.3": "yam ajja rajjamhi udassaye tuvaṃ, ",
  "ja513:10.4": "rajjam pi n' iccheyyaṃ tayā vinā ahanti. ",
  "ja513:11.1": "Na kammanā vā vacasā va tāta ",
  "ja513:11.2": "aparādh' ito 'haṃ tuyhaṃ sarāmi, ",
  "ja513:11.3": "sandhiñ ca katvā purisādakena ",
  "ja513:11.4": "saccānurakkhī pun' ahaṃ gamissanti. ",
  "ja513:12.1": "Ahaṃ gamissāmi, idh' eva hohi, ",
  "ja513:12.2": "n' atthi tato jīvato vippamokkho, ",
  "ja513:12.3": "sace tuvaṃ gacchasi yeva rāja ",
  "ja513:12.4": "aham pi gacchāmi, ubho na homāti. ",
  "ja513:13.1": "Addhā hi tāta satān' esa dhammo, ",
  "ja513:13.2": "maraṇā ca me dukkhataraṃ tad assa ",
  "ja513:13.3": "kammāsapādo taṃ yadā pacitvā ",
  "ja513:13.4": "pasayha khāde hitarukkhasūleti. ",
  "ja513:14.1": "Pāṇena te pāṇam ahaṃ nimissaṃ, ",
  "ja513:14.2": "mā tvaṃ agā porisādassa ñatte, ",
  "ja513:14.3": "evañ ca te pāṇam ahaṃ nimissaṃ, ",
  "ja513:14.4": "tasmā mataṃ jīvitassa vaṇṇemīti. ",
  "ja513:15.1": "tato have dhitimā rājaputto ",
  "ja513:15.2": "vandittha mātuc ca pituc ca pādeti. ",
  "ja513:15.3": "Dukhini 'ssa mātā nipatī pathavyā, ",
  "ja513:15.4": "pit' assa paggayha bhujāni kandatīti ",
  "ja513:16.1": "Taṃ gacchataṃ tāva pitā viditvā ",
  "ja513:16.2": "parammukho vandati pañjalī so: ",
  "ja513:16.3": "Somo ca rājā Varuṇo ca rājā ",
  "ja513:16.4": "Pajāpatī candimā sūriyo ca -- ",
  "ja513:16.5": "etehi gutto purisādakamhā ",
  "ja513:16.6": "anuññāto sotthi paccehi tāta. ",
  "ja513:17.1": "Yaṃ Daṇḍakāraññagatassa mātā ",
  "ja513:17.2": "Rāmass' akā sotthānaṃ sugattā ",
  "ja513:17.3": "tan te ahaṃ sotthānaṃ karomi, ",
  "ja513:17.4": "etena saccena sarantu devā, ",
  "ja513:17.5": "anuññāto sotthi paccehi putta. ",
  "ja513:18.1": "Āvī raho pi manopadosaṃ ",
  "ja513:18.2": "nāhaṃ sare jātum Ālīnasatte, ",
  "ja513:18.3": "etena saccena sarantu devā, ",
  "ja513:18.4": "anuññato sotthi paccehi bhātā. ",
  "ja513:19.1": "Yasmā ca me anadhimano si sāmi ",
  "ja513:19.2": "na cāpi me manasā appiyo si, ",
  "ja513:19.3": "etena saccena sarantu devā, ",
  "ja513:19.4": "anuññāto sotthi paccehi sāmīti. ",
  "ja513:20.1": "Brahā ujū cārumukho kuto si, ",
  "ja513:20.2": "na maṃ pajānāsi vane vasantaṃ, ",
  "ja513:20.3": "luddaṃ maṃ ñatvā purisādakoti ",
  "ja513:20.4": "ko sotthim ājānam idhāvajeyyāti. ",
  "ja513:21.1": "Jānāmi ludda: purisādako tvaṃ, ",
  "ja513:21.2": "na taṃ na jānāmi vane vasantaṃ, ",
  "ja513:21.3": "aham pi putto 'smi Jayaddisassa, ",
  "ja513:21.4": "mam ajja khāda pituno pamokkhāti. ",
  "ja513:22.1": "Jānāmi: puttoti Jayaddisassa, ",
  "ja513:22.2": "tathā hi vo mukhavaṇṇo ubhinnaṃ, ",
  "ja513:22.3": "",
  "ja513:22.4": "",
  "ja513:23.1": "Na dukkaraṃ kiñci-m-ah' ettha maññe ",
  "ja513:23.2": "Yo maccum icche pituno pamokkhā ",
  "ja513:23.3": "mātu ca hetū paraloka gamya ",
  "ja513:23.4": "sukhena saggena ca sampayuttoti. ",
  "ja513:24.1": "Ahañ ca kho attano pāpakiriyaṃ ",
  "ja513:24.2": "āvī raho vāpi sare na jātu, ",
  "ja513:24.3": "saṃkhātajātīmaraṇo 'ham asmi, ",
  "ja513:24.4": "yath' eva me idha tathā parattha. ",
  "ja513:25.1": "Khād' ajja man dāni mahānubhāva, ",
  "ja513:25.2": "karassu kiccāni imaṃ sarīraṃ, ",
  "ja513:25.3": "rukkhassa vā te papatāmi aggā, ",
  "ja513:25.4": "chādayamāno me yan tvam adesi maṃsanti. ",
  "ja513:26.1": "Idañ ca te ruccati rājaputta: ",
  "ja513:26.2": "cajāsi pāṇaṃ pituno pamokkhā, ",
  "ja513:26.3": "tasmā hi so tvaṃ taramānarūpo ",
  "ja513:26.4": "sambhañja kaṭṭhāni jalehi agginti ā. ",
  "ja513:27.1": "Tato have dhitimā rājaputto ",
  "ja513:27.2": "dārū samāhatva mahantam aggiṃ ",
  "ja513:27.3": "sandīpayitvā paṭivedayittha: ",
  "ja513:27.4": "ādīpito dāni mahāyam aggīti. ",
  "ja513:28.1": "Khād' ajja man dāni pasayhakārī, ",
  "ja513:28.2": "kiṃ maṃ muhuṃ pekkhasi haṭṭhalomo, ",
  "ja513:28.3": "N' ",
  "ja513:28.4": "etādisaṃ ",
  "ja513:29.1": "arahati khāditāye ",
  "ja513:29.2": "dhamme ṭhitaṃ saccavādiṃ vadaññuṃ, ",
  "ja513:29.3": "muddhāpi tassa vipphaleyya sattadhā ",
  "ja513:29.4": "yo tādisaṃ saccavādiṃ adeyyāti. Indaṃ ",
  "ja513:30.1": "hi so brāhmaṇaṃ maññamāno (vol. III p. 51.) ",
  "ja513:30.2": "saso avāsesi sake sarīre, ",
  "ja513:30.3": "ten' eva so candimā devaputto ",
  "ja513:30.4": "sasatthuto kāmaduh' ajja yakkhoti ā. ",
  "ja513:31.1": "Cando yathā Rāhumukhā pamutto ",
  "ja513:31.2": "virocate pannarase va bhānumā ",
  "ja513:31.3": "evaṃ tuvaṃ porisādā pamutto ",
  "ja513:31.4": "viroca Kampilla mahānubhāva ",
  "ja513:31.5": "āmodavaṃ pitaraṃ mātarañ ca, ",
  "ja513:31.6": "sabbo ca te nandatu ñātipakkhoti ā. ",
  "ja513:32.1": "Tato have dhitimā rājaputto ",
  "ja513:32.2": "katañjalī paggayha porisādaṃ ",
  "ja513:32.3": "anuññāto sotthi sukhī arogo ",
  "ja513:32.4": "paccāga Kampillam Alīnasattoti ",
  "ja513:33.1": "Taṃ negamā jānapadā ca sabhe ",
  "ja513:33.2": "hatthārohā rathikā pattikā ca ",
  "ja513:33.3": "namassamānā pañjalikā-m-upāgamuṃ: ",
  "ja513:33.4": "nam' atthu te, dukkarakārako sīti. Kin ",
  "ja513:34.1": ""
}
