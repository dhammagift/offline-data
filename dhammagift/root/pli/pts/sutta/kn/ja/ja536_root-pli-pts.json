  "ja536:28.1": "Nakulo Bhīmaseno ",
  "ja536:28.2": "Yudhiṭṭhilo Sahadevo ca rājā ",
  "ja536:28.3": "ete patī pañca-m-aticca nārī ",
  "ja536:28.4": "akāsi khujjavāmanena pāpanti. ",
  "ja536:29.1": "",
  "ja536:30.1": "",
  "ja536:31.1": "",
  "ja536:32.1": "",
  "ja536:32.2": "",
