  "ja536:34.1": "Sīho yathā lohitamaṃsabhojano ",
  "ja536:34.2": "vāḷāmigo pañcahattho suruddho ",
  "ja536:34.3": "pasayhakhādī parahiṃsane rato ",
  "ja536:34.4": "tath' itthiyo, tāyo na vissase naro. ",
  "ja536:35.1": "Yathā ",
  "ja536:36.1": "coro yathā diddho vāṇijo va ",
  "ja536:36.2": "",
  "ja536:37.1": "",
  "ja536:37.2": "vikatthanī ",
  "ja536:37.3": "issasiṅgam ",
  "ja536:37.4": "ivāvattā dujjivhaurago yathā. ",
  "ja536:38.1": "Sobbham iva paṭicchannā ",
  "ja536:38.2": "pātālam iva duppurā ",
  "ja536:38.3": "rakkhasī viya duttosā ",
  "ja536:38.4": "Yamo v' ekantahāriyo. ",
  "ja536:39.1": "Yathā sikhī nadī vāto ",
  "ja536:39.2": "Neru nāvasamākatā ",
  "ja536:39.3": "visarukkho viya pañcadhā ",
  "ja536:39.4": "nāsayanti ghare bhogaṃ ",
  "ja536:39.5": "ratanān' ",
  "ja536:40.1": "antakaritthiyo, ti. ",
  "ja536:40.2": "",
  "ja536:40.3": "Goṇaṃ dhenuṃ ",
  "ja536:40.4": "",
  "ja536:41.1": "ca yānañ ca ",
  "ja536:41.2": "bhariyaṃ ñātikule na vāsaye ",
  "ja536:41.3": "bhajanti rathaṃ ajānakā, ",
  "ja536:41.4": "ativāhena hananti puṅgavaṃ. ",
  "ja536:41.5": "Dohena hananti vacchakaṃ. ",
  "ja536:41.6": "bhariyā ñātikule padussatīti. ",
  "ja536:42.1": "",
  "ja536:43.1": "",
  "ja536:43.2": "",
  "ja536:43.3": "",
  "ja536:43.4": "",
  "ja536:44.1": "",
  "ja536:44.2": "",
  "ja536:44.3": "",
  "ja536:44.4": "",
  "ja536:45.1": "Daliddaṃ āturañ cāpi ",
  "ja536:45.2": "jiṇṇakaṃ surasoṇḍakaṃ ",
  "ja536:45.3": "pamattaṃ muddhapattañ ca rattaṃ ",
  "ja536:45.4": "kiccesu hāpanaṃ ",
  "ja536:45.5": "sabbakāmapadānena ",
  "ja536:45.6": "avajānanti sāmikanti. ",
  "ja536:46.1": "",
  "ja536:46.2": "",
  "ja536:46.3": "",
  "ja536:46.4": "",
  "ja536:47.1": "Arāmasīlā uyyānaṃ ",
  "ja536:47.2": "nadī ñātiparakulaṃ dussamaṇḍanam ",
  "ja536:47.3": "anuyuttā ",
  "ja536:47.4": "yā c' itthi majjapāyinī. ",
  "ja536:48.1": "yā ca nillokanasīlā ",
  "ja536:48.2": "yā ca padvāraṭhāyinī navahi ",
  "ja536:48.3": "etehi ṭhānehi ",
  "ja536:48.4": "padosam ",
  "ja536:49.1": "",
  "ja536:49.2": "āharat' itthiyo. ",
  "ja536:49.3": "",
  "ja536:50.1": "",
  "ja536:50.2": "Pavāsam assa [vaṇṇeti] gataṃ nānusocati. disvā patiṃ āgataṃ nābhinandati. bhattāra vaṇṇaṃ na kadāci bhāsati, ete paduṭṭhāya bhavanti lakkhaṇā. Anatthaṃ tassa caratī asaññatā, atthañ ca hāpeti akiccakārinī. paridahitvā sayatī paraṃmukhī, ete paduṭṭhāya bhavanti lakkhaṇā. Parivattakājatā ca bhavati kuṃkumī. dīghañ ca assasati dukkha vediti. uccārapassāvaṃ abhiṇha ",
  "ja536:50.3": "",
  "ja536:50.4": "",
  "ja536:51.1": "",
  "ja536:51.2": "",
  "ja536:51.3": "",
  "ja536:51.4": "",
  "ja536:51.5": "",
  "ja536:52.1": "",
  "ja536:52.2": "",
  "ja536:52.3": "",
  "ja536:52.4": "",
  "ja536:53.1": "",
  "ja536:53.2": "",
  "ja536:53.3": "gacchati. ",
  "ja536:53.4": "ete etc. ",
  "ja536:54.1": "Vilomam ācarati akiccakārinī. ",
  "ja536:54.2": "saddaṃ nisāmeti parassa bhāsato. ",
  "ja536:54.3": "nihatabhogā ca karoti santhavam, ",
  "ja536:54.4": "ete etc. ",
  "ja536:55.1": "Kicchena laddhaṃ kasirābhataṃ dhanaṃ ",
  "ja536:55.2": "vittaṃ vināseti dukkhena sambhataṃ. ",
  "ja536:55.3": "paṭivisakehi ca karoti santhavaṃ, ",
  "ja536:55.4": "ete etc. ",
  "ja536:56.1": "Nikkhantapādā visikhānucārinī ",
  "ja536:56.2": "niccaṃ sasāmimhi paduṭṭhamānasā ",
  "ja536:56.3": "aticārinī hoti tath' ev' agāravā ",
  "ja536:56.4": "ete etc. ",
  "ja536:57.1": "Abhikkhaṇaṃ tiṭṭhati dvāramūle ",
  "ja536:57.2": "thanāni kacchāni ca dassayantī. ",
  "ja536:57.3": "disodisaṃ pekkhati bhantacittā, ",
  "ja536:57.4": "ete etc. ",
  "ja536:58.1": "Sabbā nadī vaṃkagatī ",
  "ja536:58.2": "sabbe kaṭṭhamayā vanā ",
  "ja536:58.3": "sabbitthiyo kare pāpaṃ ",
  "ja536:58.4": "labhamāne nivātake. ",
  "ja536:59.1": "Sace labhetha khaṇaṃ vā raho vā ",
  "ja536:59.2": "nivātakaṃ vāpi labhetha tādisaṃ ",
  "ja536:59.3": "sabbā ca itthī kareyyuṃ no pāpaṃ ",
  "ja536:59.4": "aññaṃ aladdhā pīṭhasappināpi [saddhiṃ]. ",
  "ja536:60.1": "Narānam ārāmakarāsu nārisu ",
  "ja536:60.2": "anekacittāsu aniggahāsu ca, ",
  "ja536:60.3": "sabb' attanā pītikarāpi vesiyā, ",
  "ja536:60.4": "na vissase, titthasamā hi nāriyoti. ",
  "ja536:61.1": "Yaṃ ve disvā Kaṇḍari-Kinnarānaṃ ",
  "ja536:61.2": "sabbitthiyo na ramantī agāre ",
  "ja536:61.3": "taṃ tādisaṃ maccaṃ cajitvā bhariyā ",
  "ja536:61.4": "aññaṃ disvā purisaṃ pīṭhasappinti g. ā. ",
  "ja536:62.1": "Bakassa ca Pāvārikassa rañño ",
  "ja536:62.2": "accantakāmānugatassa bhariyā ",
  "ja536:62.3": "avācarī baddhavasānugassa ",
  "ja536:62.4": "kaṃ vā itthī nāticare tadaññanti. ",
  "ja536:63.1": "Piṅgiyānī sabbalokissarassa ",
  "ja536:63.2": "rañño piyā Brahmadattassa bhariyā ",
  "ja536:63.3": "avācarī baddhavasānugassa, ",
  "ja536:63.4": "taṃ vāpi sā nājjhaga kāmakāminīti g. ",
  "ja536:64.1": "ā. Khuddānaṃ lahucittānaṃ ",
  "ja536:64.2": "akataññuna dūbhinaṃ ",
  "ja536:64.3": "nādevasatto puriso ",
  "ja536:64.4": "thīnaṃ saddhātum arahati. ",
  "ja536:65.1": "Na tā pajānanti kataṃ na kiccaṃ ",
  "ja536:65.2": "na mātaraṃ pitaraṃ bhātaraṃ vā, ",
  "ja536:65.3": "anariyā samatikkantadhammā ",
  "ja536:65.4": "sass' eva cittassa vasaṃ vajanti. ",
  "ja536:66.1": "Cirānuvuttham pi piyaṃ manāpaṃ ",
  "ja536:66.2": "anukampakaṃ pāṇasamam pi santaṃ ",
  "ja536:66.3": "āvāsu kiccesu ca naṃ jahanti, ",
  "ja536:66.4": "tasmāham itthīnaṃ na vissasāmi. ",
  "ja536:67.1": "Thīnaṃ hi cittaṃ yathā vānarassa ",
  "ja536:67.2": "kannappakannaṃ yathā rukkhachāyā, ",
  "ja536:67.3": "calācalaṃ hadayaṃ itthiyānaṃ ",
  "ja536:67.4": "cakkassa nemi viya parivattati. ",
  "ja536:68.1": "Yadā tā passanti samekkhamānā ",
  "ja536:68.2": "ādeyyarūpaṃ purisassa vittaṃ ",
  "ja536:68.3": "saṇhāhi vācāhi nayanti-m-etaṃ ",
  "ja536:68.4": "kambojakā jalajeneva assaṃ. ",
  "ja536:69.1": "Yadā na passanti samekkhamānā ",
  "ja536:69.2": "ādeyyarūpaṃ purisassa vittaṃ ",
  "ja536:69.3": "samantato naṃ parivajjayanti ",
  "ja536:69.4": "tiṇṇo nadīpāragato va kullaṃ. ",
  "ja536:70.1": "Silesūpamā sikhi-r-iva sabbabbhakkhā ",
  "ja536:70.2": "tikkhāmayā nadi-r-iva sīghasotā ",
  "ja536:70.3": "sevanti h' etā piyam appiyañ ca ",
  "ja536:70.4": "nāvā yathā orakūlaṃ parañ ca. ",
  "ja536:71.1": "Na tā ekassa na dvinnaṃ ",
  "ja536:71.2": "āpaṇo va pasārito, ",
  "ja536:71.3": "yo tā mayhanti maññeyya ",
  "ja536:71.4": "vātaṃ jālena bādhaye. ",
  "ja536:72.1": "Yathā nadī ca pantho ca ",
  "ja536:72.2": "pānāgāraṃ sabhā papā ",
  "ja536:72.3": "evaṃ lokitthiyo nāma. ",
  "ja536:72.4": "velā tāsaṃ na vijjati. ",
  "ja536:73.1": "Ghatāsanasamā h' etā ",
  "ja536:73.2": "kaṇhasappasirūpamā, ",
  "ja536:73.3": "gāvo bahitiṇasseva ",
  "ja536:73.4": "omasanti varaṃ varaṃ. ",
  "ja536:74.1": "Ghatāsanaṃ kuñjaraṃ kaṇhasappaṃ ",
  "ja536:74.2": "muddhābhisittaṃ pamadā ca sabbā ",
  "ja536:74.3": "ete na so niccayatto bhajetha, ",
  "ja536:74.4": "tesaṃ bhave dubbidu sabbabhāvo. ",
  "ja536:75.1": "Nāccantavaṇṇā na bahūna kantā ",
  "ja536:75.2": "na dakkhiṇā pamadā sevitabbā, ",
  "ja536:75.3": "na parassa bhariyā na dhanassa hetu ",
  "ja536:75.4": "et' itthiyo pañca na ",
  "ja536:76.1": "sevitabbāti. ",
  "ja536:77.1": "Puṇṇam pi ce 'maṃ paṭhaviṃ dhanena ",
  "ja536:77.2": "dajj' itthiyā puriso sammatāya ",
  "ja536:77.3": "laddhā khaṇaṃ atimaññeyya tam pi, ",
  "ja536:77.4": "tāsaṃ vasaṃ asatīnaṃ na gacche. ",
  "ja536:78.1": "Uṭṭhāhakañ ce pi alīnavuttiṃ ",
  "ja536:78.2": "komārabhattāraṃ piyaṃ manāpaṃ ",
  "ja536:78.3": "āvāsu kiccesu ca naṃ jahanti, ",
  "ja536:78.4": "tasmā hi itthīnaṃ na vissasāmi. ",
  "ja536:79.1": "Na vissase icchati manti poso, ",
  "ja536:79.2": "na vissase rodati me sakāse, ",
  "ja536:79.3": "sevanti h' etā piyam appiyañ ca ",
  "ja536:79.4": "nāvā yathā orakūlaṃ parañ ca. ",
  "ja536:80.1": "Na vissase sākhapurāṇasanthataṃ, ",
  "ja536:80.2": "na vissase mittapurāṇacoraṃ, ",
  "ja536:80.3": "na vissase rājā sakhā mamanti, ",
  "ja536:80.4": "na vissase itthi dasanna mātaraṃ. ",
  "ja536:81.1": "Na vissase rāmakarāsu nārisu ",
  "ja536:81.2": "accantasīlāsu asaññatāsu, ",
  "ja536:81.3": "accantapemānugat' assa bhariyā ",
  "ja536:81.4": "na vissase, titthasamā hi nāriyo. ",
  "ja536:82.1": "Haneyyu chindeyyum pi chedayeyyuṃ ",
  "ja536:82.2": "kaṇṭham pi chetvā rudhiraṃ pipeyyuṃ, ",
  "ja536:82.3": "mā dīnakāmāsu asaññatāsu ",
  "ja536:82.4": "bhāvaṃ kare Gaṅgatitthūpamāsu. ",
  "ja536:83.1": "Musā tāsaṃ yathā saccaṃ ",
  "ja536:83.2": "saccaṃ tāsaṃ tathā musā, ",
  "ja536:83.3": "gāvo bahitiṇasseva ",
  "ja536:83.4": "omasanti varaṃ varaṃ. ",
  "ja536:84.1": "Gaten' etā palobhenti ",
  "ja536:84.2": "pekkhitena mihitena ca ",
  "ja536:84.3": "atho pi dunnivatthena ",
  "ja536:84.4": "mañjunā bhaṇitena ca. ",
  "ja536:85.1": "Coriyo kaṭhinā h' etā ",
  "ja536:85.2": "vāḷā ca lapasakkharā, ",
  "ja536:85.3": "na tā kiñci na jānanti ",
  "ja536:85.4": "yaṃ manussesu vañcanaṃ. ",
  "ja536:86.1": "Asā lokitthiyo nāma, ",
  "ja536:86.2": "velā tāsaṃ na vijjati, ",
  "ja536:86.3": "sārattā ca pagabbhā ca ",
  "ja536:86.4": "sikhī sabbaghaso yathā. ",
  "ja536:87.1": "N' atth' itthīnaṃ piyo nāma ",
  "ja536:87.2": "appiyo pi na vijjati, ",
  "ja536:87.3": "sevanti h' etā piyam appiyañ ca ",
  "ja536:87.4": "nāvā yathā orakūlaṃ parañ ca. ",
  "ja536:88.1": "N' atth' itthīnaṃ piyo nāma ",
  "ja536:88.2": "appiyo pi na vijjati, ",
  "ja536:88.3": "dhanattā pativellanti ",
  "ja536:88.4": "latā va dumanissitā. ",
  "ja536:89.1": "Hatthibandhaṃ assabandhaṃ ",
  "ja536:89.2": "gopurisañ ca caṇḍālaṃ ",
  "ja536:89.3": "chavaḍāhakaṃ [pupphachaḍḍakaṃ] ",
  "ja536:89.4": "sadhanam anupatanti nāriyo. ",
  "ja536:90.1": "Kulaputtam pi jahanti akiñcanaṃ ",
  "ja536:90.2": "chavakasamaṃ sadisam ",
  "ja536:90.3": "api gacchanti [anupatanti] ",
  "ja536:90.4": "dhanahetu nāriyoti. ",
  "ja536:91.1": "",
  "ja536:92.1": "Cattāro 'me na pūrenti, ",
  "ja536:92.2": "te me suṇātha bhāsato: ",
  "ja536:92.3": "samuddo brāhmaṇo rājā ",
  "ja536:92.4": "itthi cāpi dijampati. ",
  "ja536:93.1": "Saritā sāgaraṃ yanti ",
  "ja536:93.2": "yā kāci pathaviṃ sitā ",
  "ja536:93.3": "tā samuddaṃ na pūrenti, ",
  "ja536:93.4": "ūnattā hi na pūrati. ",
  "ja536:94.1": "Brāhmaṇo ca adhiyānaṃ ",
  "ja536:94.2": "vedam akkhānapañcamaṃ ",
  "ja536:94.3": "bhiyyo pi sutam iccheyya, ",
  "ja536:94.4": "ūnattā hi na pūrati. ",
  "ja536:95.1": "Rājā ca paṭhaviṃ sabbaṃ ",
  "ja536:95.2": "sasamuddaṃ sapabbataṃ ",
  "ja536:95.3": "ajjhāvase vijinitvā ",
  "ja536:95.4": "anantaratanocitaṃ. ",
  "ja536:95.5": "pāraṃ samuddaṃ pattheti, ",
  "ja536:95.6": "ūnattā hi na pūrati. ",
  "ja536:96.1": "Ekamekāya itthiyā ",
  "ja536:96.2": "aṭṭhaṭṭha patino siyā ",
  "ja536:96.3": "sūrā ca balavantā ca ",
  "ja536:96.4": "sabbakāmarasāharā, ",
  "ja536:96.5": "kareyya navame chandaṃ, ",
  "ja536:96.6": "ūnattā hi na pūrati. ",
  "ja536:97.1": "Sabbitthiyo sikhi-r-iva sabbabhakkhā, ",
  "ja536:97.2": "sabbitthiyo nadi-r-iva sabbavāhī, ",
  "ja536:97.3": "sabbitthiyo kaṇṭhakānaṃ pasākhā, ",
  "ja536:97.4": "sabbitthiyo dhanahetū vajanti. ",
  "ja536:98.1": "Vātaṃ jalena paro parāmase ",
  "ja536:98.2": "osiñciyā sāgaraṃ ekapāṇinā ",
  "ja536:98.3": "sakena tālena haneyya ghosanaṃ ",
  "ja536:98.4": "yo sabbabhāvaṃ pamadāsu ossajeyya. ",
  "ja536:99.1": "Corīnaṃ bahubuddhīnaṃ ",
  "ja536:99.2": "yāsu saccaṃ sudullabhaṃ (94|23) ",
  "ja536:99.3": "thīnaṃ bhāvo durājāno ",
  "ja536:99.4": "macchassevodake gataṃ. ",
  "ja536:100.1": "Analā mudusambhāsā ",
  "ja536:100.2": "duppūrā tā madīsamā (II 326|13, IV 471|21) ",
  "ja536:100.3": "sīdanti, naṃ viditvāna ",
  "ja536:100.4": "ārakā parivajjaye. ",
  "ja536:101.1": "Āvaṭṭanī mahāmāyā ",
  "ja536:101.2": "brahmacariyavikopanā (II 330|10, IV 471|19) ",
  "ja536:101.3": "sīdanti, naṃ viditvāna ",
  "ja536:101.4": "ārakā parivajjaye. ",
  "ja536:102.1": "Yaṃ etā upasevanti ",
  "ja536:102.2": "chandasā vā dhanena vā ",
  "ja536:102.3": "jātavedo va saṇ ṭhānaṃ ",
  "ja536:102.4": "khippaṃ anuḍahanti nanti. ",
  "ja536:103.1": "",
  "ja536:104.1": "Sallape nisitakhaggapāṇinā ",
  "ja536:104.2": "paṇḍito api pisācadosinā. ",
  "ja536:104.3": "uggatejauragam pi āside, ",
  "ja536:104.4": "eko ekapamadaṃ hi nālape. ",
  "ja536:105.1": "Lokacittamathanā hi nāriyo ",
  "ja536:105.2": "naccagītabhaṇitamihitāvudhā, ",
  "ja536:105.3": "bādhayanti anupaṭṭhitāsatī ",
  "ja536:105.4": "dīpe rakkhasigaṇo va vāṇije. ",
  "ja536:106.1": "N' atthi tāsaṃ vinayo na saṃvaro. ",
  "ja536:106.2": "majjamaṃsaniratā asaññatā ",
  "ja536:106.3": "tā gilanti purisassa pābhataṃ ",
  "ja536:106.4": "sāgare va makaran timiṅgilo. ",
  "ja536:107.1": "Pañcakāmaguṇasātagocarā ",
  "ja536:107.2": "uddhatā aniyatā asaññatā ",
  "ja536:107.3": "osaranti pamadā pamādinaṃ ",
  "ja536:107.4": "loṇatoyavatiyaṃ va āpakā. ",
  "ja536:108.1": "Yaṃ naraṃ uparamanti nāriyo ",
  "ja536:108.2": "chandasā ca ratiyā dhanena vā ",
  "ja536:108.3": "jātavedasadisam pi tādisaṃ ",
  "ja536:108.4": "rāgadosavatiyo ḍahanti naṃ. ",
  "ja536:109.1": "Aḍḍhaṃ ñatvā purisaṃ mahaddhanaṃ ",
  "ja536:109.2": "osaranti sadhanaṃ sah' attanā, ",
  "ja536:109.3": "rattacittaṃ ativeṭhayanti naṃ ",
  "ja536:109.4": "sāla māluvalatā kānane. ",
  "ja536:110.1": "Tā upenti vividhena chandasā ",
  "ja536:110.2": "citrabimbamukhiyo alaṃkatā, ",
  "ja536:110.3": "ūhasanti pahasanti nāriyo ",
  "ja536:110.4": "Saṃvaro va sati māyakovidā. ",
  "ja536:111.1": "Jātarūpamaṇimuttabhūsitā ",
  "ja536:111.2": "sakkatā patikulesu nāriyo ",
  "ja536:111.3": "",
  "ja536:111.4": "",
  "ja536:112.1": "Tejavāpi hi naro vicakkhaṇo ",
  "ja536:112.2": "sakkato bahujanassa pūjito ",
  "ja536:112.3": "nārinaṃ vasagato na bhāsati ",
  "ja536:112.4": "Rāhunā upagato va candimā, ",
  "ja536:113.1": "Yaṃ kareyya kupito diso disaṃ ",
  "ja536:113.2": "duṭṭhacitto vasam āgataṃ ari ",
  "ja536:113.3": "tena bhiyyo vyasanaṃ nigacchati ",
  "ja536:113.4": "nārinaṃ vasagato apekkhavā. ",
  "ja536:114.1": "Kesalūnanakhachinnatajjitā ",
  "ja536:114.2": "pādapāṇikasadaṇḍatāḷitā ",
  "ja536:114.3": "hīnam eva upagatā hi nāriyo ",
  "ja536:114.4": "tā ramanti kuṇape va makkhikā. ",
  "ja536:115.1": "Tā kulesu visikhantaresu vā ",
  "ja536:115.2": "rājadhāninigamesu vā puna ",
  "ja536:115.3": "oḍḍitaṃ Namucipāsavākaraṃ ",
  "ja536:115.4": "cakkhumā parivajje sukhatthiyo. ",
  "ja536:116.1": "Ossajitva kusalaṃ tapoguṇaṃ ",
  "ja536:116.2": "yo anariyacaritāni-m-ācari ",
  "ja536:116.3": "devatāhi nirayaṃ nimissati ",
  "ja536:116.4": "chedagāmimaṇiyaṃ va vāṇijo. ",
  "ja536:117.1": "So idha garahito parattha ca ",
  "ja536:117.2": "dummatī upagato sakammunā ",
  "ja536:117.3": "gacchatī aniyato gaḷāgaḷaṃ ",
  "ja536:117.4": "duṭṭhagadrabharatho va uppathe. ",
  "ja536:118.1": "So upeti nirayaṃ Patāpanaṃ ",
  "ja536:118.2": "sattisimbalivanañ ca-m-āyasaṃ ",
  "ja536:118.3": "āvasitvā [na] tiracchānayoniyaṃ ",
  "ja536:118.4": "petarājavisayaṃ na muñcati. ",
  "ja536:119.1": "Dibbakhiḍḍaratiyo ca Nandane ",
  "ja536:119.2": "cakkavatticaritañ ca mānuse ",
  "ja536:119.3": "nāsayanti pamadā pamādinaṃ ",
  "ja536:119.4": "duggatiñ ca paṭipādayanti naṃ. ",
  "ja536:120.1": "Dibbakhiḍḍaratiyo na dullabhā ",
  "ja536:120.2": "cakkavatticaritañ ca mānuse ",
  "ja536:120.3": "sovaṇṇavyamhanilayā va accharā ",
  "ja536:120.4": "ye caranti pamadāh' anatthikā. ",
  "ja536:121.1": "Kāmadhātusamatikkamā gati ",
  "ja536:121.2": "rūpadhātuyā bhāvo na dullabho ",
  "ja536:121.3": "vītarāgavisayūpapattiyā ",
  "ja536:121.4": "ye caranti pamadāh' anatthikā. ",
  "ja536:122.1": "Sabbadukkhasamatikkamaṃ sivam ",
  "ja536:122.2": "accantaṃ acalitaṃ asaṃkhataṃ ",
  "ja536:122.3": "nibbutehi sucihī na dullabhaṃ ",
  "ja536:122.4": "ye caranti pamadāh' anatthikāti. ",
  "ja536:123.1": "Kuṇālo 'haṃ tadā āsiṃ, ",
  "ja536:123.2": "Udāyi phussakokilo, ",
  "ja536:123.3": "Ānando gijjharājāsi, ",
  "ja536:123.4": "Sāriputto ca Nārado, ",
  "ja536:123.5": "",
  "ja536:123.6": "evaṃ dhāretha jātakanti. ",
  "ja536:124.1": ""
}
