  "ja298:1.1": "Udumbarā c' ime pakkā ",
  "ja298:1.2": "nigrodhā ca kapitthanā, ",
  "ja298:1.3": "ehi nikkhama bhuñjassu, ",
  "ja298:1.4": "kiṃ jighacchāya mīyasīti. ",
  "ja298:2.1": "Evaṃ so sukhito hoti ",
  "ja298:2.2": "yo vaddham apacāyati ",
  "ja298:2.3": "yathāham ajja suhito ",
  "ja298:2.4": "dumapakkāni-m-āsitoti. ",
  "ja298:3.1": "Yaṃ vanejo vanejassa ",
  "ja298:3.2": "vañceyya kapino kapi ",
  "ja298:3.3": "daharo pi taṃ na saddheyya ",
  "ja298:3.4": "na hi jiṇṇo jarākapīti. ",
  "ja298:4.1": ""
}
