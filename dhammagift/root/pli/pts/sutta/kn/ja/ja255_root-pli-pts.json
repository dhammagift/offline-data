  "ja255:1.1": "so mattam aññāsi ",
  "ja255:1.2": "bhojanasmiṃ vihaṅgamo ",
  "ja255:1.3": "tāva addhānam āpādi ",
  "ja255:1.4": "mātarañ ca aposayi. ",
  "ja255:2.1": "Yato ca so bahutaraṃ ",
  "ja255:2.2": "bhojanaṃ ajjhupāhari ",
  "ja255:2.3": "tato tatth' eva saṃsīdi, ",
  "ja255:2.4": "amattaññū hi so ahu. ",
  "ja255:3.1": "Tasmā mattaññutā sādhu ",
  "ja255:3.2": "bhojanasmiṃ agiddhitā, ",
  "ja255:3.3": "amattaññū hi sīdanti, ",
  "ja255:3.4": "mattaññū ca na sīdareti. ",
  "ja255:4.1": ""
}
