  "ja211:1.1": "Akāsi yoggaṃ dhuvam appamatto ",
  "ja211:1.2": "saṃvaccharaṃ bīraṇatthambhakasmiṃ, ",
  "ja211:1.3": "vyākāsi saññaṃ parisaṃ vigayha, ",
  "ja211:1.4": "na niyyamo tāyati appapaññanti. ",
  "ja211:2.1": "Dvayaṃ yācanako tāta ",
  "ja211:2.2": "Somadatta nigacchati: ",
  "ja211:2.3": "alābhaṃ dhanalābhañ ca, ",
  "ja211:2.4": "evaṃdhammā hi yācanāti. ",
  "ja211:3.1": ""
}
