  "ja537:0.3": "",
  "ja537:0.4": "",
  "ja537:1.1": "Kasmā tuvaṃ rasaka edisāni ",
  "ja537:1.2": "karosi kammāni sudāruṇāni, ",
  "ja537:1.3": "hanāsi itthī purise ca mūḷho ",
  "ja537:1.4": "maṃsassa hetu adu dhanassa kāraṇāti. ",
  "ja537:2.1": "Na attahetu na dhanassa kāraṇā ",
  "ja537:2.2": "na puttadārassa sahāyañātinaṃ, ",
  "ja537:2.3": "bhattā ca me bhagavā bhūmipālo ",
  "ja537:2.4": "so khādatī maṃsaṃ bhadante edisaṃ. ",
  "ja537:3.1": "Sace tuvaṃ bhattur atthe payutto ",
  "ja537:3.2": "karosi kammāni sudāruṇāni ",
  "ja537:3.3": "",
  "ja537:3.4": "",
  "ja537:4.1": "Tathā karissāmi ahaṃ bhadante ",
  "ja537:4.2": "yathā tuvaṃ bhāsasi Kālahatthi, ",
  "ja537:4.3": "pāto va antepuraṃ pāpuṇitvā ",
  "ja537:4.4": "vakkhāmi te rājino sammukhe tanti. ",
  "ja537:5.1": "Tato ratyā vivasane ",
  "ja537:5.2": "suriyass' uggamanam pati ",
  "ja537:5.3": "Kālo rasakam ādāya ",
  "ja537:5.4": "rājānaṃ upasaṃkami. ",
  "ja537:5.5": "upasaṃkamitvā rājānaṃ ",
  "ja537:5.6": "idaṃ vacanam abravi: ",
  "ja537:6.1": "Saccaṃ kira mahārāja ",
  "ja537:6.2": "rasako pesito tayā ",
  "ja537:6.3": "hanāti itthī purise ",
  "ja537:6.4": "tuvaṃ maṃsāni khādasi. ",
  "ja537:7.1": "Evam evaṃ tathā Kāḷa ",
  "ja537:7.2": "rasako pesito mayā. ",
  "ja537:7.3": "mama atthaṃ karontassa ",
  "ja537:7.4": "kim etaṃ paribhāsasīti. ",
  "ja537:8.1": "Ānando sabbamacchānaṃ ",
  "ja537:8.2": "khāditvā rasagiddhimā ",
  "ja537:8.3": "parikkhīṇāya parisāya ",
  "ja537:8.4": "attānaṃ khādiyā mato. ",
  "ja537:9.1": "Evaṃ pamatto rasagārave rato ",
  "ja537:9.2": "bālo yadī āyatiṃ nāvabujjhati ",
  "ja537:9.3": "vidhamma putte caji ñātake ca ",
  "ja537:9.4": "parivattiyā attānam eva khādati. ",
  "ja537:10.1": "Idan te sutvāna vihetu chando, ",
  "ja537:10.2": "mā bhakkhasī rāja manussamaṃsaṃ, ",
  "ja537:10.3": "mā tvaṃ imaṃ kevalaṃ vārijo va ",
  "ja537:10.4": "dipadādhipa suññam akāsi raṭṭhanti. ",
  "ja537:11.1": "Sujāto nāma nāmena ",
  "ja537:11.2": "tassa atrajaoraso ",
  "ja537:11.3": "jambupesiṃ aladdhāna ",
  "ja537:11.4": "mato so tassa saṃkhaye. ",
  "ja537:12.1": "Evam eva ahaṃ Kāḷa ",
  "ja537:12.2": "bhuttā bhakkhaṃ rasuttamaṃ ",
  "ja537:12.3": "aladdhā mānusaṃ maṃsaṃ ",
  "ja537:12.4": "maññe hassāmi jīvitanti. ",
  "ja537:13.1": "Māṇava abhirūpo si, ",
  "ja537:13.2": "kule jāto si sotthiye, ",
  "ja537:13.3": "na tvam arahasi tāta ",
  "ja537:13.4": "abhakkhaṃ bhakkhayetaveti g. ā. ",
  "ja537:14.1": "Rasānaṃ aññataraṃ etaṃ ",
  "ja537:14.2": "yasmā maṃ tvaṃ nivāraye, ",
  "ja537:14.3": "so 'haṃ tattha gamissāmi ",
  "ja537:14.4": "yattha lacchāmi edisaṃ. ",
  "ja537:15.1": "So vāhaṃ nippatissāmi, ",
  "ja537:15.2": "na te vacchāmi santike ",
  "ja537:15.3": "yassa me dassanena tvaṃ ",
  "ja537:15.4": "nābhinandasi brāhmaṇāti. ",
  "ja537:16.1": "Addhā aññe pi dāyāde ",
  "ja537:16.2": "putte lacchāma māṇava, ",
  "ja537:16.3": "tvañ ca jamma vinassasu ",
  "ja537:16.4": "yattha pattaṃ na [taṃ] suṇomāti g. ā. ",
  "ja537:17.1": "Evam eva tuvaṃ rāja ",
  "ja537:17.2": "dipadinda suṇohi me: ",
  "ja537:17.3": "pabbājessanti taṃ raṭṭhā ",
  "ja537:17.4": "soṇḍamāṇavakaṃ yathāti. ",
  "ja537:18.1": "Sujāto nāma nāmena ",
  "ja537:18.2": "bhāvitattāna sāvako ",
  "ja537:18.3": "accharaṃ kāmayanto va ",
  "ja537:18.4": "na so bhuñji na so pivi. ",
  "ja537:19.1": "Kusagge udakam ādāya ",
  "ja537:19.2": "samudde udakaṃ mine ",
  "ja537:19.3": "evaṃ mānusakā kāmā ",
  "ja537:19.4": "dibbakāmāna santike. ",
  "ja537:20.1": "Evam eva ahaṃ Kāḷa ",
  "ja537:20.2": "bhutvā bhakkhaṃ rasuttamaṃ ",
  "ja537:20.3": "aladdhā mānusaṃ maṃsaṃ ",
  "ja537:20.4": "maññe hessāmi jīvitanti. ",
  "ja537:21.1": "Yathāpi te dhataraṭṭhā ",
  "ja537:21.2": "haṃsā vehāsayaṃgamā ",
  "ja537:21.3": "avuttiparibhogena ",
  "ja537:21.4": "sabbe abbhatthataṃ gatā ",
  "ja537:22.1": "Evam eva tuvaṃ rāja ",
  "ja537:22.2": "dipadinda suṇohi me: ",
  "ja537:22.3": "abhakkhaṃ rāja bhakkhesi ",
  "ja537:22.4": "tasmā pabbājayanti tanti. ",
  "ja537:23.1": "Tiṭṭhāhīti mayā vutto ",
  "ja537:23.2": "so tvaṃ gacchasi ",
  "ja537:23.3": "yammukho, aṭhito ṭhito 'mhīti ",
  "ja537:23.4": "lapasi brahmacāri ",
  "ja537:23.5": "idaṃ te samaṇa ayuttaṃ, ",
  "ja537:23.6": "asiñ ca me maññasi kaṃkapattanti. ",
  "ja537:24.1": "Ṭhito 'ham asmi saddhammesu rāja, ",
  "ja537:24.2": "na nāmagottaṃ parivattayāmi, ",
  "ja537:24.3": "corañ ca loke aṭhitaṃ vadanti ",
  "ja537:24.4": "apāyikaṃ nerayikaṃ ito cutaṃ. ",
  "ja537:25.1": "Sace pi sahasi rāja ",
  "ja537:25.2": "sutaṃ gaṇhāhi khattiya, ",
  "ja537:25.3": "tena yaññaṃ yajitvāna ",
  "ja537:25.4": "evaṃ saggaṃ gamissasīti. ",
  "ja537:26.1": "Kasmin nu raṭṭhe tava jātibhūmi, ",
  "ja537:26.2": "atha kena atthena idhānupatto, ",
  "ja537:26.3": "",
  "ja537:26.4": "",
  "ja537:27.1": "Gāthā catasso dharaṇīmahessara ",
  "ja537:27.2": "sugambhiratthā varasāgarūpamā, ",
  "ja537:27.3": "tav' eva atthāya idhāgato 'smi, ",
  "ja537:27.4": "suṇohi gāthā paramatthasaṃhitāti. ",
  "ja537:28.1": "Na ve rudanti matimanto sapaññā ",
  "ja537:28.2": "bahussutā ye bahuṭhānacintino, ",
  "ja537:28.3": "(Cfr. IV 467|12) dīpaṃ hi etaṃ paramaṃ narānaṃ ",
  "ja537:28.4": "yaṃ paṇḍitā sokanudā bhavanti. ",
  "ja537:29.1": "Attānaṃ ñāti uda puttadāraṃ ",
  "ja537:29.2": "dhaññaṃ dhanaṃ rajataṃ jātarūpaṃ ",
  "ja537:29.3": "Na vāham ",
  "ja537:29.4": "attānam anutthunāmi ",
  "ja537:30.1": "",
  "ja537:30.2": "na puttadāraṃ na dhanaṃ na raṭṭhaṃ, ",
  "ja537:30.3": "satañ ca dhammo carito purāṇo, ",
  "ja537:30.4": "taṃ saṃgaraṃ brāhmaṇassāṇutappe. ",
  "ja537:31.1": "Kato mayā saṃgaro brāhmaṇena ",
  "ja537:31.2": "raṭṭhe sake issariye ṭhitena, ",
  "ja537:31.3": "taṃ saṃgaraṃ brāhmaṇassa-ppadāya (supra p. 24, 15.) ",
  "ja537:31.4": "saccānurakkhī punar āvajissanti. Na ",
  "ja537:32.1": "vāhaṃ etaṃ abhisaddahāmi: ",
  "ja537:32.2": "sukhī naro maccumukhā pamutto ",
  "ja537:32.3": "amittahatthaṃ punar āvajeyya, ",
  "ja537:32.4": "Koravyaseṭṭha na hi maṃ upehi. ",
  "ja537:33.1": "Mutto tuvaṃ porisādassa hatthā (cfr. supra p. 25, 27.) ",
  "ja537:33.2": "gantvā sakaṃ mandiraṃ kāmakāmi ",
  "ja537:33.3": "madhuraṃ piyam jīvitaṃ laddha rāja ",
  "ja537:33.4": "kuto tuvaṃ ehisi me sakāsanti. ",
  "ja537:34.1": "Mataṃ vareyya parisuddhasīlo ",
  "ja537:34.2": "na jīvitaṃ garahito pāpadhammo, ",
  "ja537:34.3": "na hi taṃ naraṃ tāyate duggatīhi ",
  "ja537:34.4": "yassāpi hetū alikaṃ bhaṇeyya. ",
  "ja537:35.1": "Sace pi vāto giriṃ āvaheyya (IV 462|16) ",
  "ja537:35.2": "cando ca suriyo ca chamā pateyyuṃ ",
  "ja537:35.3": "sabbā va najjo paṭisotaṃ vajeyyuṃ ",
  "ja537:35.4": "na tv-ev' ahaṃ rāja musā ",
  "ja537:36.1": "",
  "ja537:36.2": "",
  "ja537:36.3": "",
  "ja537:36.4": "bhaṇeyyanti. ",
  "ja537:37.1": "Asiñ ca sattiñ ca parāmasāmi, ",
  "ja537:37.2": "sapatham pi te samma ahaṃ karomi, ",
  "ja537:37.3": "tayā pamutto anaṇo bhavitvā ",
  "ja537:37.4": "saccānurakkhī punar āvajissanti. ",
  "ja537:38.1": "Yo te kato saṅgaro brāhmaṇena ",
  "ja537:38.2": "raṭṭhe sake issariye ṭhitena ",
  "ja537:38.3": "taṃ saṃgaraṃ brāhmaṇassa-ppadāya ",
  "ja537:38.4": "saccānurakkhī punar āvajassūti g. ā. ",
  "ja537:39.1": "Yo me kato saṅgaro brāhmaṇena ",
  "ja537:39.2": "raṭṭhe sake issariye ṭhitena ",
  "ja537:39.3": "taṃ saṅgaraṃ brāhmaṇassa-ppadāya ",
  "ja537:39.4": "saccānurakkhī punar āvajissanti. ",
  "ja537:40.1": "Mutto ca so porisādassa hatthā ",
  "ja537:40.2": "gantvāna taṃ brāhmaṇaṃ etad avoca: ",
  "ja537:40.3": "",
  "ja537:40.4": "",
  "ja537:41.1": "Sakid eva Sutasoma ",
  "ja537:41.2": "sabbhi hotu samāgamo, ",
  "ja537:41.3": "sā naṃ saṃgati pāleti ",
  "ja537:41.4": "nāsabbhi bahusaṃgamo. ",
  "ja537:42.1": "Sabbhir eva samāsetha ",
  "ja537:42.2": "sabbhi kubbetha santhavaṃ, (Saṃyuta-N. I. p. 17.) ",
  "ja537:42.3": "sataṃ saddhammam aññāya ",
  "ja537:42.4": "seyyo hoti na pāpiyo. ",
  "ja537:43.1": "Jīranti ve rājarathā sucittā, (Dhp. v. 151, Saṃyutta-N. I. p. 71.) ",
  "ja537:43.2": "atho sarīram pi jaraṃ upeti, ",
  "ja537:43.3": "satañ ca dhammo na jaraṃ upeti, ",
  "ja537:43.4": "santo have sabbhi pavedayanti. ",
  "ja537:44.1": "Nabhā ca dūre paṭhavī ca dūre, ",
  "ja537:44.2": "pāraṃ samuddassa tad āhu dūre, ",
  "ja537:44.3": "tato have dūrataraṃ vadanti ",
  "ja537:44.4": "satañ ca dhammaṃ asatañ ca rājāti. ",
  "ja537:45.1": "Sahassiyo imā gāthā ",
  "ja537:45.2": "na imā gāthā satārahā, ",
  "ja537:45.3": "cattāri tvaṃ sahassāni ",
  "ja537:45.4": "khippaṃ gaṇhāhi brāhmaṇāti. ",
  "ja537:46.1": "Asītiyā navutiyā ca gāthā, ",
  "ja537:46.2": "satārahā cāpi bhaveyyu gāthā, ",
  "ja537:46.3": "paccattam eva Suttasoma jānāhi ",
  "ja537:46.4": "sahassiyo nāma kuth' atthi gāthāti āha. ",
  "ja537:47.1": "Icchāmi vo 'haṃ sutavuddhim attano, santo ",
  "ja537:47.2": "ca maṃ suppurisā bhajeyyuṃ, ",
  "ja537:47.3": "ahaṃ savantīhi mahodadhīva ",
  "ja537:47.4": "na hi tāta tappāmi subhāsitena. ",
  "ja537:48.1": "Aggi yathā tiṇakaṭṭhaṃ ḍahanto ",
  "ja537:48.2": "na tappatī sāgaro vā nadīhi ",
  "ja537:48.3": "evam pi te paṇḍitā rājaseṭṭha ",
  "ja537:48.4": "sutvā na tappanti subhāsitena ",
  "ja537:49.1": "Sakassa dāsassa yadā suṇomi ",
  "ja537:49.2": "gāthā ahaṃ atthavatī janinda ",
  "ja537:49.3": "",
  "ja537:49.4": "",
  "ja537:50.1": "Idaṃ te raṭṭhaṃ sadhanaṃ sayoggam (289|19) ",
  "ja537:50.2": "sakāyuraṃ sabbakāmūpapannaṃ, ",
  "ja537:50.3": "kiṃ kāmahetu paribhāsase maṃ, ",
  "ja537:50.4": "gacchām' ahaṃ porisādassa kanteti g. ā. ",
  "ja537:51.1": "Attānurakkhāya bhavanti h' ete ",
  "ja537:51.2": "hatthārohā rathikā pattikā ca ",
  "ja537:51.3": "assārohā yeva dhanuggahāse, ",
  "ja537:51.4": "senaṃ payuñjāma, hanāma sattunti. ",
  "ja537:52.1": "Sudukkaraṃ porisādo akāsi: ",
  "ja537:52.2": "jīvaṃ gahetvāna avassajī maṃ, ",
  "ja537:52.3": "taṃ tādisaṃ pubbakiccaṃ saranto ",
  "ja537:52.4": "dubbhe ahaṃ tassa kathaṃ janindāti g. ā. ",
  "ja537:53.1": "Vanditvā so pitaraṃ mātarañ ca ",
  "ja537:53.2": "anusāsetvā negamañ [ca] balañ ca ",
  "ja537:53.3": "saccavādī saccānurakkhamāno ",
  "ja537:53.4": "agamāsi so yena so porisādoti. ",
  "ja537:54.1": "Kato mayā saṃgaro brāhmaṇena ",
  "ja537:54.2": "raṭṭhe sake issariye ṭhitena, ",
  "ja537:54.3": "taṃ saṃgaraṃ brāhmaṇassa-ppadāya ",
  "ja537:54.4": "saccānurakkhī punar āgato 'smi, ",
  "ja537:54.5": "yajassu yaññaṃ hantvāna mama maṃsaṃ khādāhi vā maṃ samma porisādāti. ",
  "ja537:55.1": "Na hāyate khādituṃ mayhaṃ pacchā, ",
  "ja537:55.2": "citakā ayaṃ tāva sadhūmikā va, ",
  "ja537:55.3": "niddhūmake pacitaṃ sādhu pakkaṃ, ",
  "ja537:55.4": "suṇāma gāthāyo satārahāyoti. ",
  "ja537:56.1": "Adhammiko tvaṃ porisādak' āsi ",
  "ja537:56.2": "raṭṭhāto bhaṭṭho udarassa hetu, ",
  "ja537:56.3": "dhammañ c' imā abhivadanti gāthā, ",
  "ja537:56.4": "dhammo adhammo ca kuhiṃ sameti. ",
  "ja537:57.1": "Adhammikassa luddassa ",
  "ja537:57.2": "niccaṃ lohitapāṇino ",
  "ja537:57.3": "n' atthi saccaṃ kuto dhammaṃ, ",
  "ja537:57.4": "kiṃ sutena karissasīti. ",
  "ja537:58.1": "Yo maṃsahetu migavaṃ careyya ",
  "ja537:58.2": "yo cāhane purisaṃ attahetu ",
  "ja537:58.3": "ubho pi te pecca samā bhavanti, ",
  "ja537:58.4": "kasmā no adhammikaṃ brūsi maṃ tvanti. ",
  "ja537:59.1": "Pañca pañca na khā bhakkhā ",
  "ja537:59.2": "khattiyena pajānatā, ",
  "ja537:59.3": "abhakkhaṃ rāja bhakkhesi, ",
  "ja537:59.4": "tasmā adhammiko tuvanti. ",
  "ja537:60.1": "Mutto tuvaṃ porisādassa hatthā ",
  "ja537:60.2": "gantvā sakaṃ mandiraṃ kāmakāmī ",
  "ja537:60.3": "amittahatthaṃ punar āgato si, ",
  "ja537:60.4": "nakkhattadhamme kusalo si rājāti. ",
  "ja537:61.1": "Ye khattadhamme kusalā bhavanti ",
  "ja537:61.2": "pāyena te nerayikā bhavanti, ",
  "ja537:61.3": "tasmā ahaṃ khattadhammaṃ pahāya ",
  "ja537:61.4": "saccānurakkhī punar āgato 'smi, ",
  "ja537:61.5": "yajassu yaññaṃ khāda maṃ porisādāti. ",
  "ja537:62.1": "Pāsādavāsā paṭhavīgavāssaṃ ",
  "ja537:62.2": "kāmitthiyo kāsikacandanañ ca ",
  "ja537:62.3": "sabbaṃ tahiṃ labbhati sāmitāya, ",
  "ja537:62.4": "saccena kiṃ passasi ānisaṃsanti. ",
  "ja537:63.1": "Ye kec' ime atthi rasā pathavyā ",
  "ja537:63.2": "saccaṃ tesaṃ sādhutaraṃ rasānaṃ, ",
  "ja537:63.3": "sacce ṭhitā samaṇabrāhmaṇā ca ",
  "ja537:63.4": "taranti jātimaraṇassa pāranti. ",
  "ja537:64.1": "Mutto tuvaṃ porisādassa hatthā ",
  "ja537:64.2": "gantvā sakaṃ mandiraṃ kāmakāmī ",
  "ja537:64.3": "amittahatthaṃ punar āgato si, ",
  "ja537:64.4": "na ha nūna te maraṇabhayaṃ janinda, ",
  "ja537:64.5": "alinacitto c' asi saccavādīti. ",
  "ja537:65.1": "Katā me kalyāṇā anekarūpā, ",
  "ja537:65.2": "yaññā yiṭṭhā ye vipulā pasatthā, ",
  "ja537:65.3": "visodhito paralokassa maggo, ",
  "ja537:65.4": "dhamme ṭhito ko maraṇassa bhāye. ",
  "ja537:66.1": "Katā me kalyāṇā anekarūpā, ",
  "ja537:66.2": "yaññā yiṭṭhā ye vipulā pasatthā, ",
  "ja537:66.3": "",
  "ja537:66.4": "",
  "ja537:67.1": "Pitā ca mātā ca upaṭṭhitā me, ",
  "ja537:67.2": "dhammena me issariyaṃ pasatthaṃ, ",
  "ja537:67.3": "visodhito paralokassa maggo, ",
  "ja537:67.4": "dhamme ṭhito ko maraṇassa bhāye. ",
  "ja537:68.1": "Pitā ca mātā ca upaṭṭhitā me, ",
  "ja537:68.2": "dhammena me issariyaṃ pasatthaṃ, ",
  "ja537:68.3": "anānutappaṃ paralokaṃ gamissaṃ, ",
  "ja537:68.4": "yajassu yaññaṃ khāda maṃ porisādo. ",
  "ja537:69.1": "Ñātīsu mittesu katā me kārā, ",
  "ja537:69.2": "dhammena me issariyaṃ pasatthaṃ ",
  "ja537:69.3": "--pe--. ",
  "ja537:69.4": "",
  "ja537:70.1": "Ñātīsu mittesu katā me kārā, ",
  "ja537:70.2": "dhammena me issariyaṃ pasatthaṃ, ",
  "ja537:70.3": "anānutappaṃ --pe--. ",
  "ja537:70.4": "",
  "ja537:71.1": "Dinnaṃ me dānaṃ bahudhā bahunnaṃ, ",
  "ja537:71.2": "santappitā samaṇā brāhmaṇā ca, ",
  "ja537:71.3": "visodhito paralokassa maggo ",
  "ja537:71.4": "--pe--. ",
  "ja537:72.1": "Dinnaṃ me dānaṃ bahudhā bahunnaṃ, ",
  "ja537:72.2": "santappitā samaṇā brāhmanā ca, ",
  "ja537:72.3": "anānutappaṃ paralokaṃ gamissaṃ, ",
  "ja537:72.4": "yajassu yaññaṃ khāda maṃ porisādāti. ",
  "ja537:73.1": "Visaṃ pajānaṃ puriso adeyya ",
  "ja537:73.2": "āsīvisaṃ jalitaṃ uggatejaṃ, ",
  "ja537:73.3": "muddhāpi tassa vipateyya sattadhā ",
  "ja537:73.4": "yo tādisaṃ saccavādiṃ adeyyāti. ",
  "ja537:74.1": "Sutvā dhammaṃ vijānanti ",
  "ja537:74.2": "narā kalyāṇapāpakaṃ, ",
  "ja537:74.3": "api gāthā suṇitvāna ",
  "ja537:74.4": "dhamme me ramatī manoti. ",
  "ja537:75.1": "Sakideva Sutasoma ",
  "ja537:75.2": "sabbhi hotu samāgamo, ",
  "ja537:75.3": "sā naṃ saṃgati pāleti ",
  "ja537:75.4": "nāsabbhi bahusaṃgamo. ",
  "ja537:76.1": "Sabbhir eva samāsetha ",
  "ja537:76.2": "sabbhi kubbetha santhavaṃ, ",
  "ja537:76.3": "sataṃ saddhammam aññāya ",
  "ja537:76.4": "seyyo hoti na pāpiyo. ",
  "ja537:77.1": "Jīranti ve rājarathā sucittā, ",
  "ja537:77.2": "atho sarīram pi jaraṃ upeti, ",
  "ja537:77.3": "satañ ca dhammo na jaraṃ upeti, ",
  "ja537:77.4": "santo have sabbhi pavedayanti. ",
  "ja537:78.1": "Nabhā ca dūre paṭhavī ca dūre, ",
  "ja537:78.2": "pāraṃ samuddassa tad āhu dūre, ",
  "ja537:78.3": "tato have dūrataraṃ vadanti ",
  "ja537:78.4": "satañ ca dhammaṃ asatañ ca rājāti. ",
  "ja537:79.1": "Gāthā imā atthavatī suvyañjanā (151|10) ",
  "ja537:79.2": "subhāsitā tuyhaṃ janinda sutvā ",
  "ja537:79.3": "ānandicitto sumano patīto, ",
  "ja537:79.4": "cattāri te samma vare dadāmīti. ",
  "ja537:80.1": "Yo n' attano maraṇaṃ bujjhasi tvaṃ ",
  "ja537:80.2": "hitāhitaṃ vinipātañ ca saggaṃ ",
  "ja537:80.3": "giddho rase duccarite niviṭṭho ",
  "ja537:80.4": "kiṃ tvaṃ varaṃ passasi pāpadhamma. ",
  "ja537:81.1": "Ahañ ca taṃ dehi varanti vajjaṃ ",
  "ja537:81.2": "tvañ cāpi datvāna avākareyya, ",
  "ja537:81.3": "sandiṭṭhikaṃ kalaham imaṃ vivādaṃ ",
  "ja537:81.4": "ko paṇḍito jānam upabbajeyyāti. ",
  "ja537:82.1": "Na taṃ varaṃ arahati jantu dātuṃ ",
  "ja537:82.2": "yaṃ vāpi datvāna avākareyya, ",
  "ja537:82.3": "varassu samma avikampamāno, ",
  "ja537:82.4": "pāṇaṃ cajitvāna pi dassam evāti. ",
  "ja537:83.1": "Ariyassa ariyena sameti sakkhi ",
  "ja537:83.2": "paññassa paññāṇavatā sameti, ",
  "ja537:83.3": "passeyya taṃ vassasataṃ arogaṃ, ",
  "ja537:83.4": "etaṃ varānaṃ paṭhamaṃ varāmīti. ",
  "ja537:84.1": "Ariyassa ariyena sameti sakkhi ",
  "ja537:84.2": "paññassa paññāṇavatā sameti, ",
  "ja537:84.3": "passe pi maṃ vassasataṃ arogaṃ, ",
  "ja537:84.4": "etaṃ varānaṃ paṭhamaṃ dadāmīti. ",
  "ja537:85.1": "Ye khattiyā ye idha bhūmipālā ",
  "ja537:85.2": "muddhābhisittā katanāmadheyyā ",
  "ja537:85.3": "na tādise bhūmipatī adesi, ",
  "ja537:85.4": "etaṃ varānaṃ dutiyaṃ varāmīti. ",
  "ja537:86.1": "Ye khattiyā ye idha bhūmipālā ",
  "ja537:86.2": "muddhābisittā katanāmadheyyā ",
  "ja537:86.3": "na tādise bhūmipatī ademi, ",
  "ja537:86.4": "etaṃ varānaṃ dutiyaṃ dadāmīti. ",
  "ja537:87.1": "Parosataṃ khattiyā te gahītā ",
  "ja537:87.2": "talāvutā assumukhā rudantā, ",
  "ja537:87.3": "sake te raṭṭhe paṭipādayāhi, ",
  "ja537:87.4": "etaṃ varānaṃ tatiyaṃ varāmīti. ",
  "ja537:88.1": "Parosataṃ khattiyā me gahītā ",
  "ja537:88.2": "talāvutā assumukhā rudantā, ",
  "ja537:88.3": "sake te raṭṭhe paṭipādayāmi, ",
  "ja537:88.4": "etaṃ varānaṃ tatiyaṃ dadāmīti. ",
  "ja537:89.1": "Chiddan te raṭṭhaṃ vyādhitaṃ bhayāhi, ",
  "ja537:89.2": "puthū narā lenam anuppaviṭṭhā, ",
  "ja537:89.3": "manussamaṃsaṃ viramehi rāja, ",
  "ja537:89.4": "etaṃ varānaṃ catutthaṃ varāmīti. ",
  "ja537:90.1": "Addhā hi so bhakkho mamaṃ manāpo, ",
  "ja537:90.2": "etassa hetum pi vanaṃ paviṭṭho, ",
  "ja537:90.3": "so 'haṃ kathaṃ etto upārameyyaṃ, ",
  "ja537:90.4": "aññaṃ varānaṃ catutthaṃ varassūti. ",
  "ja537:91.1": "Na ve piyaṃ meti janinda tādiso (III 280|3) ",
  "ja537:91.2": "attaṃ niraṃkatvā piyāni sevati, ",
  "ja537:91.3": "attā va seyyo paramā va seyyo, ",
  "ja537:91.4": "labbhā piyā ocitatthena pacchāti. ",
  "ja537:92.1": "Piyaṃ me mānusaṃ maṃsaṃ ",
  "ja537:92.2": "Sutasoma vijānahi, ",
  "ja537:92.3": "n' amhi sakko nivāretuṃ ",
  "ja537:92.4": "aññaṃ tuvaṃ samma varaṃ varassūti. ",
  "ja537:93.1": "Yo ve piyaṃ meti piyānukaṃkhī ",
  "ja537:93.2": "attaṃ niraṃkatvā piyāni sevati ",
  "ja537:93.3": "soṇḍo va pītvāna visassa thālaṃ ",
  "ja537:93.4": "ten' eva so hoti dukkhī parattha. ",
  "ja537:94.1": "Yo c' īdha saṃkhāya piyāni hitvā ",
  "ja537:94.2": "kicchena pi sevati ariyadhammaṃ ",
  "ja537:94.3": "dukkhito va pītvāna yathosadhāni ",
  "ja537:94.4": "ten' eva so hoti sukhī paratthāti. ",
  "ja537:95.1": "Ohāy' ahaṃ pitaraṃ mātarañ ca ",
  "ja537:95.2": "manāpike kāmaguṇe ca pañca ",
  "ja537:95.3": "etassa hetumhi vanaṃ paviṭṭho, ",
  "ja537:95.4": "tan te varaṃ kinti-m-ahaṃ dadāmīti. ",
  "ja537:96.1": "Na paṇḍitā diguṇaṃ āhu vākyaṃ, ",
  "ja537:96.2": "saccappaṭiññā ca bhavanti santo, ",
  "ja537:96.3": "",
  "ja537:96.4": "",
  "ja537:97.1": "Apuññalābhaṃ ayasaṃ akittiṃ ",
  "ja537:97.2": "pāpaṃ bahuṃ duccaritaṃ kilesaṃ ",
  "ja537:97.3": "manussamaṃsassa kate upāgā, ",
  "ja537:97.4": "tan te varaṃ kinti-m-ahaṃ dadeyyanti. ",
  "ja537:98.1": "Na taṃ varaṃ arahati jantu dātuṃ ",
  "ja537:98.2": "yaṃ vāpi datvāna avākareyya, ",
  "ja537:98.3": "varassu samma avikampamāno, ",
  "ja537:98.4": "pāṇaṃ jahitvāna pi dassam evāti. ",
  "ja537:99.1": "Pāṇañ cajanti santo nāpi dhammaṃ, ",
  "ja537:99.2": "saccappaṭiññā ca bhavanti santo, ",
  "ja537:99.3": "datvā varaṃ khippam avākarohi ",
  "ja537:99.4": "etena sampajja surājaseṭṭha. ",
  "ja537:100.1": "Caje dhanaṃ yo pana aṅgahetu ",
  "ja537:100.2": "aṅgaṃ caje jīvitaṃ rakkhamāno, ",
  "ja537:100.3": "Yassāpi ",
  "ja537:100.4": "",
  "ja537:101.1": "dhammaṃ puriso vijaññā ",
  "ja537:101.2": "ye c' assa kaṃkhaṃ vinayanti santo ",
  "ja537:101.3": "taṃ hi 'ssa dīpañ ca parāyanañ ca ",
  "ja537:101.4": "na tena mittiṃ jarayetha paññoti gātham āha. ",
  "ja537:102.1": "Addhā hi so bhakkho mamaṃ manāpo, ",
  "ja537:102.2": "etassa hetum pi vanaṃ paviṭṭho, ",
  "ja537:102.3": "sace va maṃ yācasi etam atthaṃ ",
  "ja537:102.4": "etam pi te samma varaṃ dadāmīti. ",
  "ja537:103.1": "Satthā ca me hosi sakkhā ca me si, ",
  "ja537:103.2": "vacanam pi te samma ahaṃ akāsiṃ, ",
  "ja537:103.3": "tuvaṃ pi me samma karohi vākyaṃ, ",
  "ja537:103.4": "ubho pi gantvāna pamocayāmāti. ",
  "ja537:104.1": "Satthā ca te homi sakhā ca ty-amhi, ",
  "ja537:104.2": "vacanam pi me samma tuvaṃ akāsi, ",
  "ja537:104.3": "aham pi te samma karomi vākyaṃ, ",
  "ja537:104.4": "ubho pi gantvāna pamocayāmāti vatvā ",
  "ja537:105.1": "Kammāsapādena viheṭhitattā ",
  "ja537:105.2": "talāvutā assumukhā rudantā, ",
  "ja537:105.3": "na jātu dubbhetha imassa rañño, ",
  "ja537:105.4": "saccappaṭiññaṃ me paṭissuṇāthāti. ",
  "ja537:106.1": "Kammāsapādena viheṭhit' amhā ",
  "ja537:106.2": "talāvutā assumukhā rudantā, ",
  "ja537:106.3": "na jātu dubbhema imassa rañño, ",
  "ja537:106.4": "saccappaṭiññan te paṭissuṇāmāti. ",
  "ja537:107.1": "Yathā pitā vā athavāpi mātā ",
  "ja537:107.2": "anukampakā atthakāmā pajānaṃ ",
  "ja537:107.3": "evam eva no hotu ayañ ca rājā, ",
  "ja537:107.4": "tumhe ca vo hotha yath' eva puttāti. ",
  "ja537:108.1": "Yathā pitā vā athavāpi mātā ",
  "ja537:108.2": "anukampakā atthakāmā pajānaṃ ",
  "ja537:108.3": "evam eva no hotu ayañ ca rājā, ",
  "ja537:108.4": "mayam pi hessāma tath' eva puttāti. ",
  "ja537:109.1": "Catuppadaṃ sakuṇañ cāpi maṃsaṃ ",
  "ja537:109.2": "sūdehi randhaṃ sukataṃ suniṭṭhitaṃ ",
  "ja537:109.3": "sudhaṃ va Indo paribhuñjiyāna ",
  "ja537:109.4": "hitvā kath' eko ramasī araññe. ",
  "ja537:110.1": "Tā khattiyā vellivilākamajjhā ",
  "ja537:110.2": "alaṃkatā samparivārayitvā ",
  "ja537:110.3": "Indaṃ va devesu pamodayiṃsu ",
  "ja537:110.4": "hitvā kath' eko ramasī araññe. ",
  "ja537:111.1": "Tambūpadhāne bahugoṇakamhi ",
  "ja537:111.2": "sucimhi sabbasayanamhi saññate ",
  "ja537:111.3": "sayanassa majjhamhi sukhaṃ sayitvā ",
  "ja537:111.4": "hitvā kath' eko ramasī araññe. ",
  "ja537:112.1": "Pāṇissaraṃ kumbhathūnaṃ nisīthe ",
  "ja537:112.2": "atho pi ve nippurisam hi turiyaṃ ",
  "ja537:112.3": "bahuṃ sugītañ ca suvāditañ ca ",
  "ja537:112.4": "hitvā kath' eko ramasī araññe. ",
  "ja537:113.1": "Uyyānasampannaṃ pahūtamalyaṃ ",
  "ja537:113.2": "migācirūpetapuraṃ surammaṃ ",
  "ja537:113.3": "hayehi nāgehi ratheh' upetaṃ ",
  "ja537:113.4": "hitvā kath' eko ramasī araññe. ",
  "ja537:114.1": "Kāḷapakkhe yathā cando ",
  "ja537:114.2": "hāyat' eva suve seve ",
  "ja537:114.3": "kāḷapakkhūpamo rāja ",
  "ja537:114.4": "asataṃ hoti samāgamo. ",
  "ja537:115.1": "Yathāhaṃ rasakam āgamma ",
  "ja537:115.2": "sūdakaṃ purisādhamaṃ ",
  "ja537:115.3": "akāsiṃ pāpakaṃ kammaṃ ",
  "ja537:115.4": "yena gacchāmi duggatiṃ. ",
  "ja537:116.1": "Sukkapakkhe yathā cando ",
  "ja537:116.2": "vaḍḍhat' eva suve suve ",
  "ja537:116.3": "sukkapakkhūpamo rāja ",
  "ja537:116.4": "sataṃ hoti samāgamo. ",
  "ja537:117.1": "Yathāhaṃ tavam āgamma ",
  "ja537:117.2": "Sutasoma vijānahi ",
  "ja537:117.3": "kāhāmi kusalaṃ kammaṃ ",
  "ja537:117.4": "yena gacchāmi suggatiṃ. ",
  "ja537:118.1": "Thale yathā vārijanindavaṭṭaṃ ",
  "ja537:118.2": "anaddhaneyyaṃ aciraṭṭhitīkaṃ ",
  "ja537:118.3": "",
  "ja537:118.4": "",
  "ja537:119.1": "Sare yathā vārijanindavaṭṭaṃ ",
  "ja537:119.2": "ciraṭṭhitīkaṃ naraviriyaseṭṭha ",
  "ja537:119.3": "evam pi ce hoti sataṃ samāgamo ",
  "ja537:119.4": "ciraṭṭhitīko udakaṃ sare va. ",
  "ja537:120.1": "Avyāyiko hoti sataṃ samāgamo, ",
  "ja537:120.2": "yāvam pi tiṭṭheyya tath' eva hoti, ",
  "ja537:120.3": "khippaṃ hi veti asataṃ samāgamo, ",
  "ja537:120.4": "tasmā sataṃ dhammo asabbhi ārakāti. ",
  "ja537:121.1": "Na so rājā yo ajeyyaṃ jināti, ",
  "ja537:121.2": "na so sakhā yo sakhāraṃ jināti, ",
  "ja537:121.3": "na sā bhariyā yā patino vibheti, ",
  "ja537:121.4": "na te puttā ye na bharanti jiṇṇaṃ. ",
  "ja537:122.1": "Na sā sabhā yattha na santi santo, ",
  "ja537:122.2": "na te santo ye na bhaṇanti dhammaṃ, ",
  "ja537:122.3": "rāgañ ca dosañ ca pahāya mohaṃ ",
  "ja537:122.4": "dhammaṃ bhaṇantā va bhavanti santo. ",
  "ja537:123.1": "Nābhāsamānaṃ jānanti ",
  "ja537:123.2": "missaṃ bālehi paṇḍitaṃ, ",
  "ja537:123.3": "bhāsamānañ ca jānanti ",
  "ja537:123.4": "desentaṃ amataṃ padaṃ. ",
  "ja537:124.1": "Bhāsaye jotaye dhammaṃ, ",
  "ja537:124.2": "paggaṇhe isinaṃ dhajaṃ, ",
  "ja537:124.3": "subhāsitadhajā isayo, ",
  "ja537:124.4": "dhammo hi isinaṃ dhajoti. ",
  "ja537:125.1": "",
  "ja537:126.1": "",
  "ja537:127.1": "",
  "ja537:128.1": "",
