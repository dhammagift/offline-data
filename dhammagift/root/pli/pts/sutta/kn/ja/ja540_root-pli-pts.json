  "ja540:1.1": "Ko nu maṃ usunā vijjhi ",
  "ja540:1.2": "pamattaṃ udahārakaṃ, ",
  "ja540:1.3": "khattiyo brāhmaṇo vesso ",
  "ja540:1.4": "ko maṃ viddhā nilīyasīti. ",
  "ja540:2.1": "Na me maṃsāni khajjāni, ",
  "ja540:2.2": "cammen' attho na vijjati, ",
  "ja540:2.3": "atha kena nu vaṇṇena ",
  "ja540:2.4": "viddheyyaṃ maṃ amaññathāti ",
  "ja540:3.1": "Ko vā tvaṃ kassa vā putto, ",
  "ja540:3.2": "kathaṃ jānemu taṃ mayaṃ, ",
  "ja540:3.3": "puṭṭho me samma akkhāhi, ",
  "ja540:3.4": "kiṃ maṃ viddhā nilīyasīti āha. ",
  "ja540:4.1": "Rājāhaṃ asmi Kāsīnaṃ, ",
  "ja540:4.2": "Piliyakkhoti maṃ vidū, ",
  "ja540:4.3": "lobhā raṭṭhaṃ pahatvāna migam ",
  "ja540:4.4": "esañ carām' ahaṃ. ",
  "ja540:5.1": "Issatthe c' asmi kusalo ",
  "ja540:5.2": "daḷhadhammoti vissuto, ",
  "ja540:5.3": "nāgo pi me na muñceyya ",
  "ja540:5.4": "āgato usupātananti. ",
  "ja540:6.1": "Tvañ ca kassa vā putto si, ",
  "ja540:6.2": "kathaṃ jānemu taṃ mayaṃ, ",
  "ja540:6.3": "pituno attano cāpi ",
  "ja540:6.4": "nāmagottaṃ pavedayāti. ",
  "ja540:7.1": "Nesādaputto, bhaddan te, ",
  "ja540:7.2": "Sāmo iti maṃ ñātayo ",
  "ja540:7.3": "āmantayiṃsu jīvantaṃ, ",
  "ja540:7.4": "sv-ājj' ev' ahaṃ gato saye. ",
  "ja540:8.1": "Viddho 'smi puthusallena ",
  "ja540:8.2": "savisena yathā migo, ",
  "ja540:8.3": "sakamhi lohite rāja ",
  "ja540:8.4": "passa semi paripluto. ",
  "ja540:9.1": "Paṭicamma gataṃ sallaṃ ",
  "ja540:9.2": "passa vihāmi lohitaṃ, ",
  "ja540:9.3": "āturo ty-ānupucchāmi: ",
  "ja540:9.4": "kiṃ maṃ viddhā nilīyasi. ",
  "ja540:10.1": "Ajinamhi haññate dīpī, ",
  "ja540:10.2": "nāgo dantehi haññati, ",
  "ja540:10.3": "atha kena nu vaṇṇena ",
  "ja540:10.4": "viddheyyaṃ mam amaññathāti. ",
  "ja540:11.1": "Migo upaṭṭhito āsi ",
  "ja540:11.2": "āgato usupātanaṃ, ",
  "ja540:11.3": "taṃ disvā ubbijji Sāma, ",
  "ja540:11.4": "na te kodho mam āvisīti. ",
  "ja540:12.1": "Yato sarāmi attānaṃ ",
  "ja540:12.2": "yato patto 'smi viññutaṃ ",
  "ja540:12.3": "na maṃ migā uttasānti ",
  "ja540:12.4": "araññe sāpadāni pi. ",
  "ja540:13.1": "Yato nidhiṃ parihariṃ ",
  "ja540:13.2": "yato patto 'smi yobbanaṃ ",
  "ja540:13.3": "na maṃ migā uttasanti ",
  "ja540:13.4": "araññe sāpadāni pi. ",
  "ja540:14.1": "Bhīrū kimpurisā rāja ",
  "ja540:14.2": "pabbate Gandhamādane ",
  "ja540:14.3": "sammodamānā gacchāma ",
  "ja540:14.4": "pabbatāni vanāni ca, ",
  "ja540:15.1": "",
  "ja540:15.2": "",
  "ja540:15.3": "atha kena nu vaṇṇena ",
  "ja540:15.4": "utrase so migo mamanti. ",
  "ja540:16.1": "Na t' addasā migo Sāma ",
  "ja540:16.2": "kin t' āham alikaṃ bhaṇe, ",
  "ja540:16.3": "kodhalobhābhibhūto 'haṃ, ",
  "ja540:16.4": "usuṃ te taṃ avissajīti. ",
  "ja540:17.1": "Kuto nu samma āgamma ",
  "ja540:17.2": "kassa vā pahito tuvaṃ ",
  "ja540:17.3": "udahāro nadiṃ gaccha ",
  "ja540:17.4": "āgato Migasammatanti. ",
  "ja540:18.1": "Andhā mātāpitā mayhaṃ, ",
  "ja540:18.2": "te bharāmi brahāvane, ",
  "ja540:18.3": "tes' āham udahārako ",
  "ja540:18.4": "āgato Migasammatanti. ",
  "ja540:19.1": "Atthi nesaṃ usāmattaṃ ",
  "ja540:19.2": "atha sāhassa jīvitaṃ, ",
  "ja540:19.3": "udakassa cālābhena ",
  "ja540:19.4": "maññe andhā marissare. ",
  "ja540:20.1": "Na me idaṃ tathā dukkhaṃ, ",
  "ja540:20.2": "labbhā pi pumunā idaṃ, ",
  "ja540:20.3": "yañ ca ammaṃ na passāmi, ",
  "ja540:20.4": "tam me dukkhataraṃ ito. ",
  "ja540:21.1": "Na me idaṃ tathā dukkhaṃ, ",
  "ja540:21.2": "labbhā hi pumunā idaṃ, ",
  "ja540:21.3": "yañ ca tātaṃ na passāmi, ",
  "ja540:21.4": "tam me dukkhataraṃ ito. ",
  "ja540:22.1": "Sā nūna kapaṇā ammā ",
  "ja540:22.2": "cirarattāya rucchiti ",
  "ja540:22.3": "addharatte va ratte vā ",
  "ja540:22.4": "nadīva avasucchati. ",
  "ja540:23.1": "So nūna kapaṇo tāto ",
  "ja540:23.2": "cirarattāya rucchiti ",
  "ja540:23.3": "aḍḍharatte va ratte vā ",
  "ja540:23.4": "nadīva avasucchati. ",
  "ja540:24.1": "Uṭṭhānapāricariyāya ",
  "ja540:24.2": "pādasambāhanassa ca ",
  "ja540:24.3": "Sāma tāta vilapantā ",
  "ja540:24.4": "hiṇḍissanti brahāvane. ",
  "ja540:25.1": "Idaṃ dutiyakaṃ sallaṃ ",
  "ja540:25.2": "kampeti hadayaṃ mama ",
  "ja540:25.3": "yañ ca andhe na passāmi ",
  "ja540:25.4": "yañ ca hessāmi jīvitanti. ",
  "ja540:26.1": "Mā bāḷhaṃ paridevesi ",
  "ja540:26.2": "Sāma kalyāṇadassana, ",
  "ja540:26.3": "ahaṃ kammakaro hutvā ",
  "ja540:26.4": "bhariyassan te brahāvane. ",
  "ja540:27.1": "Issatthe c' asmi kusalo ",
  "ja540:27.2": "daḷhadhammoti vissuto ",
  "ja540:27.3": "ahaṃ kammakaro hutvā ",
  "ja540:27.4": "bhariyassan te brahāvane. ",
  "ja540:28.1": "Migānaṃ vighāsam anvesaṃ ",
  "ja540:28.2": "vanamūlaphalāni ca ",
  "ja540:28.3": "ahaṃ kammakaro hutvā ",
  "ja540:28.4": "bhariyassan te brahāvane. ",
  "ja540:29.1": "Kataman taṃ vanaṃ Sāma ",
  "ja540:29.2": "yattha mātāpitā tava, ",
  "ja540:29.3": "ahan te tathā bharissaṃ ",
  "ja540:29.4": "yathā te abhari tuvanti. ",
  "ja540:30.1": "Ayaṃ ekapadī rāja ",
  "ja540:30.2": "yo 'yaṃ ussīsake mama, ",
  "ja540:30.3": "ito gantvā aḍḍhakosaṃ ",
  "ja540:30.4": "tattha tesaṃ agārakaṃ, ",
  "ja540:30.5": "tattha mātāpitā mayhaṃ, ",
  "ja540:30.6": "te bharassu ito gatoti. ",
  "ja540:31.1": "Namo te Kāsirāj' atthu, ",
  "ja540:31.2": "namo te Kāsivaddhana, ",
  "ja540:31.3": "andhā mātāpitā mayhaṃ, ",
  "ja540:31.4": "te bharassu brahāvane. ",
  "ja540:32.1": "Añjalin te pagaṇhāmi, ",
  "ja540:32.2": "Kāsirāja nam' atthu te, ",
  "ja540:32.3": "mātaraṃ pitaraṃ mayhaṃ ",
  "ja540:32.4": "vutto vajjāsi vandananti. ",
  "ja540:33.1": "Idaṃ vatvāna so Sāmo ",
  "ja540:33.2": "yuvā kalyāṇadassano ",
  "ja540:33.3": "mucchito visavegena ",
  "ja540:33.4": "visaññī samapajjathāti. ",
  "ja540:34.1": "Sa rājā parideyesi ",
  "ja540:34.2": "bahuṃ kāruññasaṃhitaṃ: ",
  "ja540:34.3": "ajarāmaro 'haṃ āsiṃ, ",
  "ja540:34.4": "ajj' etaṃ ñāmi no pure. ",
  "ja540:34.5": "Sāmaṃ kālakataṃ disvā ",
  "ja540:34.6": "n' atthi maccussa nāgamo, ",
  "ja540:35.1": "y' assu maṃ patimanteti ",
  "ja540:35.2": "sa visena samappito ",
  "ja540:35.3": "Sv-ājj' evaṃ gate kāle ",
  "ja540:35.4": "na kiñci-m-abhibhāsati, ",
  "ja540:36.1": "nirayaṃ nūna gacchāmi, ",
  "ja540:36.2": "ettha me n' atthi saṃsayo, ",
  "ja540:36.3": "Tadā hi pakataṃ pāpaṃ ",
  "ja540:36.4": "cirarattāya kibbisaṃ ",
  "ja540:37.1": "bhavanti tassa vattāro, ",
  "ja540:37.2": "gāme kibbisakarakaṃ ",
  "ja540:37.3": "araññe nimmanussamhi ",
  "ja540:37.4": "ko maṃ vattum arahati. ",
  "ja540:38.1": "Sārayanti hi kammāni ",
  "ja540:38.2": "gāme saṃgaccha māṇavā, ",
  "ja540:38.3": "araññe nimmanussamhi ",
  "ja540:38.4": "ko maṃ sārayissatīti. ",
  "ja540:39.1": "Sā devatā antarahitā ",
  "ja540:39.2": "pabbate Gandhamādane ",
  "ja540:39.3": "rañño va anukampāya ",
  "ja540:39.4": "imā gāthā abhāsatha: ",
  "ja540:40.1": "Āguṃ kari mahārāja ",
  "ja540:40.2": "akari kamma dukkaṭaṃ, ",
  "ja540:40.3": "adūsakā pitāputtā ",
  "ja540:40.4": "tayo ekūsunā hatā. ",
  "ja540:41.1": "Ehi taṃ anusikkhāmi ",
  "ja540:41.2": "yathā te sugati siyā: ",
  "ja540:41.3": "dhammen' andhe vane posa ",
  "ja540:41.4": "maññe 'haṃ sugatiṃ tayāti. ",
  "ja540:42.1": "Sa rājā paridevitvā ",
  "ja540:42.2": "bahuṃ kāruññasaṃhitaṃ ",
  "ja540:42.3": "udakakumbham ādāya ",
  "ja540:42.4": "pakkāmi dakkhiṇāmukhoti. ",
  "ja540:43.1": "Kassa [nu] eso padasaddo ",
  "ja540:43.2": "manussass' eva āgato, ",
  "ja540:43.3": "n' eso Sāmassa nigghoso, ",
  "ja540:43.4": "ko nu tvam asi mārisa. ",
  "ja540:44.1": "Santaṃ hi Sāmo vajati, ",
  "ja540:44.2": "santaṃ pādāni neyati, ",
  "ja540:44.3": "n' eso Sāmassa nigghoso, ",
  "ja540:44.4": "ko nu tvam asi mārisāti. ",
  "ja540:45.1": "Rājāham asmi Kāsīnaṃ ",
  "ja540:45.2": "Piliyakkhoti maṃ vidū, ",
  "ja540:45.3": "lobhā raṭṭhaṃ pahatvāna ",
  "ja540:45.4": "migam esaṃ carām' ahaṃ. ",
  "ja540:46.1": "Issatthe c' asmi kusalo ",
  "ja540:46.2": "daḷhadhammoti vissuto, ",
  "ja540:46.3": "nāgo pi me na muñceyya ",
  "ja540:46.4": "āgato usupātananti. ",
  "ja540:47.1": "Svāgatan te mahārāja ",
  "ja540:47.2": "atho te adurāgataṃ, ",
  "ja540:47.3": "(V 323|29) issaro pi anuppatto ",
  "ja540:47.4": "yam idh' atthi pavedaya. ",
  "ja540:48.1": "Tiṇḍukāni piyālāni ",
  "ja540:48.2": "madhuke kāsumāriyo ",
  "ja540:48.3": "phalāni khuddakappāni ",
  "ja540:48.4": "bhuñja rāja varaṃ varaṃ. ",
  "ja540:49.1": "Idam pi pānīyaṃ sītaṃ ",
  "ja540:49.2": "ābhataṃ girigabbharā, ",
  "ja540:49.3": "tato piva mahārāja ",
  "ja540:49.4": "sace tvaṃ abhikaṃkhasīti. ",
  "ja540:50.1": "Nālam andhā vane daṭṭhuṃ, ",
  "ja540:50.2": "ko nu vo phalam āhari, ",
  "ja540:50.3": "anandhass' evāyaṃ sammā ",
  "ja540:50.4": "nivāpo mayhaṃ khāyatīti. ",
  "ja540:51.1": "Daharo yuvā nātibrahā ",
  "ja540:51.2": "Sāmo kalyāṇadassano, ",
  "ja540:51.3": "dīgh' assa kesā asitā ",
  "ja540:51.4": "atho sunaggavellitā, ",
  "ja540:52.1": "So have phalam āhatvā ",
  "ja540:52.2": "ito ādā kamaṇḍaluṃ ",
  "ja540:52.3": "nadiṃ gato udahāro, ",
  "ja540:52.4": "maññe na dūram āgatoti. ",
  "ja540:53.1": "Ahan taṃ avadhiṃ Sāmaṃ ",
  "ja540:53.2": "yo tuyhaṃ paricārako ",
  "ja540:53.3": "yaṃ kumāraṃ pavedetha ",
  "ja540:53.4": "Sāmaṃ kalyāṇadassanaṃ. ",
  "ja540:54.1": "Dīgh' assa kesā asitā ",
  "ja540:54.2": "atho sunaggavellitā, ",
  "ja540:54.3": "tesu lohitalittesu ",
  "ja540:54.4": "seti Sāmo mayā hatoti. ",
  "ja540:55.1": "Kena Dukūla mantesi ",
  "ja540:55.2": "hato Sāmoti vādinā, ",
  "ja540:55.3": "hato Sāmoti sutvāna ",
  "ja540:55.4": "hadayaṃ me pavedhati. ",
  "ja540:56.1": "Assatthasseva taruṇaṃ ",
  "ja540:56.2": "pavālaṃ māluteritaṃ ",
  "ja540:56.3": "hato Sāmoti sutvāna ",
  "ja540:56.4": "hadayam me pavedhatīti. ",
  "ja540:57.1": "Pārike Kāsirājāyaṃ ",
  "ja540:57.2": "so Sāmaṃ Migasammate ",
  "ja540:57.3": "kodhasā usunā vijjhi, ",
  "ja540:57.4": "tassa mā pāpam icchimhāti. ",
  "ja540:58.1": "Kicchā laddho piyo putto ",
  "ja540:58.2": "yo andhe abharī vane ",
  "ja540:58.3": "taṃ ekaputtaṃ ghātimhi ",
  "ja540:58.4": "kathaṃ cittaṃ na kopayeti. ",
  "ja540:59.1": "Kicchā laddho piyo putto ",
  "ja540:59.2": "yo andhe abharī vane ",
  "ja540:59.3": "taṃ ekaputtaṃ ghātimhi ",
  "ja540:59.4": "akkodhaṃ āhu paṇḍitāti. ",
  "ja540:60.1": "Mā bālhaṃ paridevetha ",
  "ja540:60.2": "hato Sāmoti vādinā, ",
  "ja540:60.3": "ahaṃ kammakaro hutvā ",
  "ja540:60.4": "bharissāmi brahāvane. ",
  "ja540:61.1": "Issatthe c' asmi kusalo ",
  "ja540:61.2": "daḷhadhammoti vissuto, ",
  "ja540:61.3": "ahaṃ kammakaro hutvā ",
  "ja540:61.4": "bharissāmi brahāvane. ",
  "ja540:62.1": "Migānaṃ vighāsam anvesaṃ ",
  "ja540:62.2": "vanamūlaphalāni ca ",
  "ja540:62.3": "ahaṃ kammakaro hutvā ",
  "ja540:62.4": "bharissāmi brahāvaneti. N' ",
  "ja540:63.1": "eso dhammo mahārāja, ",
  "ja540:63.2": "n' etaṃ amhesu kappati, ",
  "ja540:63.3": "rājā tvam asi amhākaṃ, ",
  "ja540:63.4": "pāde vandāma te mayanti. ",
  "ja540:64.1": "Dhammaṃ nesādā bhaṇatha, ",
  "ja540:64.2": "kato apacitī tayā, ",
  "ja540:64.3": "pitā tvam asi asmākaṃ, ",
  "ja540:64.4": "mātā tvam asi Pāriketi. ",
  "ja540:65.1": "Namo te Kāsirāj' atthu, ",
  "ja540:65.2": "namo te Kāsivaddhana, ",
  "ja540:65.3": "añjalin te paggaṇhāma ",
  "ja540:65.4": "yāva Sām' ānupāpaya. ",
  "ja540:66.1": "Tassa pāde pavaṭṭantā ",
  "ja540:66.2": "mukhañ ca bhujadassanaṃ ",
  "ja540:66.3": "saṃsumbhamānā attānaṃ ",
  "ja540:66.4": "kālam āgamayāmaseti. ",
  "ja540:67.1": "Brahāvāḷamigākiṇṇaṃ ",
  "ja540:67.2": "ākāsantaṃ padissati ",
  "ja540:67.3": "yattha Sāmo hato seti ",
  "ja540:67.4": "Cando va patito chamā. ",
  "ja540:68.1": "Brahāvāḷamigākiṇṇaṃ ",
  "ja540:68.2": "ākāsantaṃ padissati ",
  "ja540:68.3": "yattha Sāmo hato seti ",
  "ja540:68.4": "Suriyo va patito chamā. ",
  "ja540:69.1": "Brahāvāḷamigākiṇṇaṃ ",
  "ja540:69.2": "ākāsantaṃ padissati ",
  "ja540:69.3": "yattha Sāmo hato seti ",
  "ja540:69.4": "paṃsunā patikuṇṭhito. ",
  "ja540:70.1": "Brahāvāḷamigākiṇṇaṃ ",
  "ja540:70.2": "ākāsantaṃ padissati ",
  "ja540:70.3": "yattha Sāmo hato seti ",
  "ja540:70.4": "idh' eva vasath' assame it. ",
  "ja540:71.1": "Yadi tattha sahassāni ",
  "ja540:71.2": "satāni nahutāni ca ",
  "ja540:71.3": "n' ev' amhākaṃ bhayaṃ koci ",
  "ja540:71.4": "vane vāḷesu vijjatīti. ",
  "ja540:72.1": "Tato andhānam ādāya ",
  "ja540:72.2": "Kāsirājā brahāvane ",
  "ja540:72.3": "hatthe gahetvā pakkāmi ",
  "ja540:72.4": "yattha Sāmo hato ahūti. ",
  "ja540:73.1": "Disvāna patitaṃ Sāmaṃ ",
  "ja540:73.2": "puttakaṃ paṃsukuṇḍitaṃ ",
  "ja540:73.3": "apaviddhaṃ brahāraññe ",
  "ja540:73.4": "Candaṃ va patitaṃ chamā ",
  "ja540:74.1": "Disvāna patitaṃ Sāmaṃ ",
  "ja540:74.2": "puttakaṃ paṃsukuṇḍitaṃ ",
  "ja540:74.3": "apaviddhaṃ brahāraññe ",
  "ja540:74.4": "Suriyaṃ va patitaṃ chamā ",
  "ja540:75.1": "Disvāna patitaṃ Sāmaṃ ",
  "ja540:75.2": "puttakaṃ paṃsukuṇḍitaṃ ",
  "ja540:75.3": "apaviddhaṃ brahāraññe ",
  "ja540:75.4": "karuṇaṃ paridevayuṃ. ",
  "ja540:76.1": "Disvāna patitaṃ Sāmaṃ ",
  "ja540:76.2": "puttakaṃ paṃsukuṇḍitaṃ ",
  "ja540:76.3": "bāhā paggayha pakkanduṃ: ",
  "ja540:76.4": "adhammo kira bho iti. ",
  "ja540:77.1": "Bāḷhaṃ kho si sutto ",
  "ja540:77.2": "Sāma kalyāṇadassana ",
  "ja540:77.3": "yo ajj' evaṃ gate kāle ",
  "ja540:77.4": "na kiñci-m-abhibhāsasi. ",
  "ja540:78.1": "Bāḷhaṃ kho si matto ",
  "ja540:78.2": "Sāma kalyāṇadassana ",
  "ja540:78.3": "yo ajj' evaṃ gate kāle ",
  "ja540:78.4": "na kiñci-m-abhibhāsasi. ",
  "ja540:79.1": "Bāḷhaṃ kho si pamatto ",
  "ja540:79.2": "Sāma kalyāṇadassana ",
  "ja540:79.3": "yo ajj' evaṃ gate kāle ",
  "ja540:79.4": "na kiñci-m-abhibhāsasi. ",
  "ja540:80.1": "Bāḷhaṃ kho si kuddho ",
  "ja540:80.2": "Sāma kalyāṇadassana ",
  "ja540:80.3": "yo ajj' evaṃ gate kāle ",
  "ja540:80.4": "na kiñci-m-abhibhāsasi. ",
  "ja540:81.1": "Bāḷhaṃ kho si ditto ",
  "ja540:81.2": "Sāma kalyāṇadassana ",
  "ja540:81.3": "yo ajj' evaṃ gate kāle ",
  "ja540:81.4": "na kiñci-m-abhibhāsasi. Bāḷhaṃ kho si vimano Sāma kalyāṇadassana yo ajj' evaṃ gate kāle na kiñci-m-abhibhāsasi. ",
  "ja540:82.1": "Jaṭaṃ vaḷīnaṃ paṃkagataṃ ",
  "ja540:82.2": "ko dāni saṇṭhapessati, ",
  "ja540:82.3": "Sāmo ayaṃ kālakato ",
  "ja540:82.4": "andhānaṃ paricārako. ",
  "ja540:83.1": "Ko ve sammajjan' ādāya ",
  "ja540:83.2": "sammajjissati assamaṃ, ",
  "ja540:83.3": "Sāmo ayaṃ kālakato ",
  "ja540:83.4": "andhānaṃ paricārako. ",
  "ja540:84.1": "Ko dāni nahāpayissati ",
  "ja540:84.2": "sīten' uṇhodakena ca, ",
  "ja540:84.3": "Sāmo ayaṃ kālakato ",
  "ja540:84.4": "andhānaṃ paricārako. ",
  "ja540:85.1": "Ko dāni bhuñjayissati ",
  "ja540:85.2": "vanamūlaphalāni ca, ",
  "ja540:85.3": "Sāmo ayaṃ kālakato ",
  "ja540:85.4": "andhānaṃ paricārakoti. ",
  "ja540:86.1": "Disvāna patitaṃ Sāmaṃ ",
  "ja540:86.2": "puttakaṃ paṃsukuṇṭhitaṃ ",
  "ja540:86.3": "aṭṭitā puttasokena ",
  "ja540:86.4": "mātā saccam abhāsatha: ",
  "ja540:87.1": "Yena saccen' ayaṃ Sāmo ",
  "ja540:87.2": "dhammacārī pure ahu ",
  "ja540:87.3": "etena saccavajjena ",
  "ja540:87.4": "visaṃ Sāmassa haññatu. ",
  "ja540:88.1": "Yena saccen' ayaṃ Sāmo ",
  "ja540:88.2": "brahmacārī pure ahu ",
  "ja540:88.3": "etena saccavajjena ",
  "ja540:88.4": "visaṃ Sāmassa haññatu. ",
  "ja540:89.1": "Yena saccen' ayaṃ Sāmo ",
  "ja540:89.2": "saccavādī pure ahu ",
  "ja540:89.3": "etena saccavajjena ",
  "ja540:89.4": "visaṃ Sāmassa haññatu. ",
  "ja540:90.1": "Yena saccen' ayaṃ Sāmo ",
  "ja540:90.2": "mātāpettibharo ahu ",
  "ja540:90.3": "etena saccavajjena ",
  "ja540:90.4": "visaṃ Sāmassa haññatu. ",
  "ja540:91.1": "Yena saccen' ayaṃ Sāmo ",
  "ja540:91.2": "kule jeṭṭhāpacāyiko ",
  "ja540:91.3": "etena saccavajjena ",
  "ja540:91.4": "visaṃ Sāmassa haññatu. ",
  "ja540:92.1": "Yena saccen' ayaṃ Sāmo ",
  "ja540:92.2": "pāṇā piyataro mama ",
  "ja540:92.3": "etena saccavajjena ",
  "ja540:92.4": "visaṃ Sāmassa haññatu. ",
  "ja540:93.1": "Yaṃ kiñc' atthi kataṃ puññaṃ ",
  "ja540:93.2": "mayhañ c' eva pitu-cca te ",
  "ja540:93.3": "sabbena tena kusalena ",
  "ja540:93.4": "visaṃ Sāmassa haññatūti. ",
  "ja540:94.1": "Disvāna patitaṃ Sāmaṃ ",
  "ja540:94.2": "puttakaṃ paṃsukuṇṭhitaṃ ",
  "ja540:94.3": "aṭṭito puttasokena ",
  "ja540:94.4": "pitā saccam abhāsatha: ",
  "ja540:95.1": "Yena saccen' ayaṃ Sāmo ",
  "ja540:95.2": "dhammacārī pure ahu ",
  "ja540:95.3": "etena saccavajjena ",
  "ja540:95.4": "visaṃ Sāmassa haññatu. = 88-92 || ",
  "ja540:96.1": "[above] || ",
  "ja540:96.2": "",
  "ja540:96.3": "",
  "ja540:96.4": "",
  "ja540:97.1": "",
  "ja540:97.2": "",
  "ja540:97.3": "",
  "ja540:97.4": "",
  "ja540:98.1": "",
  "ja540:98.2": "",
  "ja540:98.3": "",
  "ja540:98.4": "",
  "ja540:99.1": "",
  "ja540:99.2": "",
  "ja540:99.3": "",
  "ja540:99.4": "",
  "ja540:100.1": "",
  "ja540:100.2": "",
  "ja540:100.3": "",
  "ja540:100.4": "",
  "ja540:101.1": "Yaṃ kiñc' atthi kataṃ puññaṃ ",
  "ja540:101.2": "mayhañ ca mātuyā ca te ",
  "ja540:101.3": "sabbena tena kusalena ",
  "ja540:101.4": "visaṃ Sāmassa haññatūti. ",
  "ja540:102.1": "Sā devatā antarahitā ",
  "ja540:102.2": "pabbate Gandhamādane ",
  "ja540:102.3": "Sāmassa anukampāya ",
  "ja540:102.4": "imaṃ saccam abhāsatha: ",
  "ja540:103.1": "Pabbaty-āhaṃ Gandhamādane ",
  "ja540:103.2": "cirarattanivāsinī, ",
  "ja540:103.3": "na me piyataro koci ",
  "ja540:103.4": "añño Sāmā na vijjati, ",
  "ja540:103.5": "etena saccavajjena ",
  "ja540:103.6": "visaṃ Sāmassa haññatu. ",
  "ja540:104.1": "Sabbe vanā gandhamayā ",
  "ja540:104.2": "pabbate Gandhamādane, ",
  "ja540:104.3": "etena saccavajjena ",
  "ja540:104.4": "visaṃ Sāmassa haññatu. ",
  "ja540:105.1": "Tesaṃ lālappamānānaṃ ",
  "ja540:105.2": "bahuṃ kāruññasaṃhitaṃ ",
  "ja540:105.3": "khippaṃ Sāmo samuṭṭhāsi ",
  "ja540:105.4": "yuvā kalyāṇadassanoti. ",
  "ja540:106.1": "Sāmo 'ham asmi, bhaddaṃ vo, ",
  "ja540:106.2": "sotthin' amhi samuṭṭhito, ",
  "ja540:106.3": "mā bāḷhaṃ paridevetha, ",
  "ja540:106.4": "mañjunābhivadetha manti. ",
  "ja540:107.1": "Svāgatan te mahārāja ",
  "ja540:107.2": "atho te adurāgataṃ , ",
  "ja540:107.3": "(V 323|29) issaro si anuppatto, ",
  "ja540:107.4": "yaṃ idh' atthi pavedaya: ",
  "ja540:108.1": "Tiṇḍukāni piyālāni ",
  "ja540:108.2": "madhuke kāsumāriyo (= 85|26) ",
  "ja540:108.3": "phalāni khuddakappāni ",
  "ja540:108.4": "bhuñja rāja varaṃ varaṃ. ",
  "ja540:109.1": "Atthi me pānīyaṃ sītaṃ ",
  "ja540:109.2": "ābhataṃ girigabbharā ",
  "ja540:109.3": "tato piva mahārāja ",
  "ja540:109.4": "sace tvaṃ abhikaṃkhasīti . ",
  "ja540:110.1": "Sammuyhāmi pamuyhāmi, ",
  "ja540:110.2": "sabbā muyhanti medisā, ",
  "ja540:110.3": "petaṃ taṃ Sāma addakkhiṃ, ",
  "ja540:110.4": "ko nu tvaṃ Sāma jīvasīti. ",
  "ja540:111.1": "Api jīvaṃ mahārāja ",
  "ja540:111.2": "purisaṃ gāḷhavedanaṃ ",
  "ja540:111.3": "upanītamanasakappaṃ ",
  "ja540:111.4": "jīvantaṃ maññate mataṃ. ",
  "ja540:112.1": "Api jīvaṃ maharāja ",
  "ja540:112.2": "purisaṃ gāḷhavedanaṃ ",
  "ja540:112.3": "taṃ nirodhagataṃ santaṃ ",
  "ja540:112.4": "jīvantaṃ maññate matanti. ",
  "ja540:113.1": "Yo mātaraṃ pitaraṃ vā ",
  "ja540:113.2": "macco dhammena posati ",
  "ja540:113.3": "devāpi naṃ tikicchanti ",
  "ja540:113.4": "mātāpettibharaṃ janaṃ. ",
  "ja540:114.1": "Yo mātaraṃ pitaraṃ vā ",
  "ja540:114.2": "macco dhammena posati ",
  "ja540:114.3": "idh' eva naṃ pasaṃsanti, ",
  "ja540:114.4": "pecca sagge ca modatīti. ",
  "ja540:115.1": "Esa bhiyyo pamuyhāmi, ",
  "ja540:115.2": "sabbā muyhanti medisā, ",
  "ja540:115.3": "saraṇaṃ taṃ Sāma gacchāmi, ",
  "ja540:115.4": "tvañ ca me saraṇaṃ bhavāti. ",
  "ja540:116.1": "Dhammaṃ cara mahārāja ",
  "ja540:116.2": "mātāpitusu khattiya, (V. p. 123.) ",
  "ja540:116.3": "idha dhammaṃ caritvāna ",
  "ja540:116.4": "rāja saggaṃ gamissasi. ",
  "ja540:117.1": "Dhammaṃ cara mahārāja ",
  "ja540:117.2": "puttadāresu khattiya, (Sen. Mahāv. I p. 281) ",
  "ja540:117.3": "idha dhammaṃ caritvāna ",
  "ja540:117.4": "rāja saggaṃ gamissasi. ",
  "ja540:118.1": "Dhammaṃ cara mahārāja ",
  "ja540:118.2": "mittāmaccesu khattiya ",
  "ja540:118.3": "etc. ",
  "ja540:118.4": "",
  "ja540:119.1": "Dhammaṃ cara mahārāja ",
  "ja540:119.2": "vāhanesu balesu ca ",
  "ja540:119.3": "etc. ",
  "ja540:119.4": "",
  "ja540:120.1": "Dhammaṃ cara mahārāja ",
  "ja540:120.2": "gāmesu nigamesu ca ",
  "ja540:120.3": "etc. ",
  "ja540:120.4": "",
  "ja540:121.1": "Dhammaṃ cara mahārāja ",
  "ja540:121.2": "raṭṭhe janapadesu ca ",
  "ja540:121.3": "etc. ",
  "ja540:121.4": "",
  "ja540:122.1": "Dhammaṃ cara mahārāja ",
  "ja540:122.2": "samaṇabrāhmaṇesu ca ",
  "ja540:122.3": "etc. ",
  "ja540:122.4": "",
  "ja540:123.1": "Dhammaṃ cara mahārāja ",
  "ja540:123.2": "migapakkhisu khattiya ",
  "ja540:123.3": "etc. ",
  "ja540:123.4": "",
  "ja540:124.1": "Dhammaṃ cara mahārāja, ",
  "ja540:124.2": "dhammo ciṇṇo sukhāvaho ",
  "ja540:124.3": "etc. ",
  "ja540:124.4": "",
  "ja540:125.1": "Dhammaṃ cara mahārāja ",
  "ja540:125.2": "saindadevā sabrahmakā ",
  "ja540:125.3": "suciṇṇena divaṃ pattā, ",
  "ja540:125.4": "mā dhammaṃ rāja pamādoti. ",
  "ja540:126.1": ""
}
