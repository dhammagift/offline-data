  "ja277:0.4": "",
  "ja277:1.1": "Vassāni paññāsa samādhikāni ",
  "ja277:1.2": "vasimha selassa guhāya romaka, ",
  "ja277:1.3": "asaṃkamānā abhinibbutattā ",
  "ja277:1.4": "hatthattam āyanti mam' aṇḍajā pure. ",
  "ja277:2.1": "Te dāni vakkaṅga kimattham ussukā ",
  "ja277:2.2": "vajanti aññaṃ girikandaraṃ dijā, nanū ",
  "ja277:2.3": "na maññanti mamaṃ yathā pure ",
  "ja277:2.4": "cirappavutthā athavā na te imeti. ",
  "ja277:3.1": "Jānāma taṃ, na mayam asma mūḷhā, ",
  "ja277:3.2": "so yeva tvan, te mayam asma nāññe, ",
  "ja277:3.3": "cittañ ca te asmiṃ jane paduṭṭhaṃ, ",
  "ja277:3.4": "ājīvika tena taṃ uttasāmāti. Kam attham abhisandhāya ",
  "ja277:4.1": ""
}
