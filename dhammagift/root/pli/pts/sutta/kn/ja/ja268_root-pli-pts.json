  "ja268:0.4": "",
  "ja268:1.1": "Yo ve sabbasametānaṃ ",
  "ja268:1.2": "ahuvā seṭṭhasammato ",
  "ja268:1.3": "tassāyaṃ edisī paññā, ",
  "ja268:1.4": "kim eva itarā pajāti. ",
  "ja268:2.1": "Evam eva tuvaṃ brahme ",
  "ja268:2.2": "anaññāya vinindasi, ",
  "ja268:2.3": "kathaṃ hi mūlaṃ adisvā ",
  "ja268:2.4": "rukkhaṃ jaññā patiṭṭhitanti. ",
  "ja268:3.1": "Nāhaṃ tumhe vinindāmi ",
  "ja268:3.2": "ye c' aññe vānarā vane, ",
  "ja268:3.3": "Vissaseno va gārayho ",
  "ja268:3.4": "yass' atthā rukkharopakāti. ",
  "ja268:4.1": ""
}
