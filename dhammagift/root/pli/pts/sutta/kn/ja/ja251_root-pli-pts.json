  "ja251:1.1": "",
  "ja251:1.2": "vitakkanisitena ca ",
  "ja251:1.3": "nālaṃkatena bhaddena na ",
  "ja251:1.4": "usukārakatena ca ",
  "ja251:2.1": "Na kaṇṇāyatamuttena ",
  "ja251:2.2": "nāpi morūpasevinā ",
  "ja251:2.3": "ten' amhi hadaye viddho ",
  "ja251:2.4": "sabbaṅgaparidāhinā. ",
  "ja251:3.1": "Āvedhañ ca na passāmi ",
  "ja251:3.2": "yato ruhiram assave, ",
  "ja251:3.3": "yāva ayonisocittaṃ, ",
  "ja251:3.4": "sayaṃ me dukkham ābhatanti. ",
  "ja251:4.1": ""
}
