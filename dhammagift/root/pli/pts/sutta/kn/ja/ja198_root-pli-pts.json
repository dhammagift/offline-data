  "ja198:1.1": "Pavāsā āgato tāta ",
  "ja198:1.2": "idāni na cirāgato, ",
  "ja198:1.3": "kaccin nu tāta te mātā ",
  "ja198:1.4": "na aññam upasevatīti. ",
  "ja198:2.1": "Na kho pan' etaṃ subhaṇaṃ ",
  "ja198:2.2": "giraṃ saccupasaṃhitaṃ , ",
  "ja198:2.3": "sayetha Poṭṭhapādo va ",
  "ja198:2.4": "mummure upakūsito. ",
  "ja198:3.1": ""
}
