  "ja383:1.1": "",
  "ja383:1.2": "",
  "ja383:1.3": "oroha dumasākhāya, ",
  "ja383:1.4": "mudhā bhariyā bhavāmi teti. ",
  "ja383:2.1": "Catuppadā tvaṃ kalyāṇi, ",
  "ja383:2.2": "dipad' āhaṃ manorame, ",
  "ja383:2.3": "migī pakkhī asaññuttā, ",
  "ja383:2.4": "aññaṃ pariyesa sāmikanti. ",
  "ja383:3.1": "Komārikā te hessāmi ",
  "ja383:3.2": "mañjukā piyabhāṇinī, ",
  "ja383:3.3": "vinda maṃ ariyena vedena, ",
  "ja383:3.4": "sāvayā maṃ yad icchasīti. ",
  "ja383:4.1": "Sakuṇakhādini lohitape ",
  "ja383:4.2": "cori kukkuṭapothini ",
  "ja383:4.3": "na tvaṃ ariyena vedena ",
  "ja383:4.4": "mamaṃ bhattāraṃ icchasīti. ",
  "ja383:5.1": "Evam pi caturā nārī ",
  "ja383:5.2": "disvāna pavaraṃ naraṃ ",
  "ja383:5.3": "nenti saṇhāhi vācāhi ",
  "ja383:5.4": "biḷārī viya kukkuṭaṃ. ",
  "ja383:6.1": "Yo ve uppatitaṃ atthaṃ ",
  "ja383:6.2": "na khippam anubujjhati (= supra p.133.) ",
  "ja383:6.3": "amittavasaṃ anveti ",
  "ja383:6.4": "pacchā ca-m-anutappati. ",
  "ja383:7.1": "Yo ve uppatitaṃ atthaṃ ",
  "ja383:7.2": "khippam eva nibodhati ",
  "ja383:7.3": "muccate sattusambādhā ",
  "ja383:7.4": "kukkuṭo va biḷāriyāti. ",
  "ja383:8.1": ""
}
