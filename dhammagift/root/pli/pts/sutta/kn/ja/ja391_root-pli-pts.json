  "ja391:1.1": "Dubbaṇṇarūpaṃ tvam ariyavaṇṇī ",
  "ja391:1.2": "purakkhatvā pañjaliko namassasi, ",
  "ja391:1.3": "seyyo nu te so udavā sarikkho, ",
  "ja391:1.4": "nāmaṃ parass' attano cāpi brūhīti. ",
  "ja391:2.1": "Na nāmagottaṃ gaṇhanti rāja ",
  "ja391:2.2": "sammaggatān' ujjugatāna devā, ",
  "ja391:2.3": "(cfr. Saṃyutta p. 204-205) ahañ ca te nāmadheyyaṃ vadāmi: ",
  "ja391:2.4": "Sakko 'ham asmī tidasānam indoti. Yo disvā bhikkhuṃ caraṇūpapannaṃ purakkhatvā añjaliko namassati ",
  "ja391:3.1": "Yo disvā bhikkhuṃ caraṇūpapannaṃ ",
  "ja391:3.2": "purakkhatvā pañjaliko namassati ",
  "ja391:3.3": "",
  "ja391:3.4": "",
  "ja391:4.1": "",
  "ja391:4.2": "",
  "ja391:4.3": "diṭṭhe va dhamme labhate pasaṃsaṃ ",
  "ja391:4.4": "saggañ ca so yāti sarīrabhedāti. ",
  "ja391:5.1": "Lakkhī vatā me udapādi ajja ",
  "ja391:5.2": "yaṃ Vāsavaṃ bhūtapat' addasāma, ",
  "ja391:5.3": "bhikkhuñ ca disvāna tav' ajja Sakka ",
  "ja391:5.4": "kāhāmi puññāni anappakānīti. ",
  "ja391:6.1": "Addhā have sevitabbā sapaññā ",
  "ja391:6.2": "bahussutā ye bahuṭṭhānacintino, ",
  "ja391:6.3": "bhikkhuñ ca disvāna mamañ ca rāja ",
  "ja391:6.4": "karohi puññani anappakānīti. ",
  "ja391:7.1": "Akkodhano niccapasannacitto ",
  "ja391:7.2": "sabbātithīyācayogo bhavitvā ",
  "ja391:7.3": "nihacca mānaṃ abhivādayissaṃ ",
  "ja391:7.4": "sutvāna devinda subhāsitānīti. Yam ekaṃ ",
  "ja391:8.1": ""
}
