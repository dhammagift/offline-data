  "ja497:0.4": "",
  "ja497:1.1": "Kuto nu āgacchasi rummavāsi ",
  "ja497:1.2": "otallako paṃsupisācako va ",
  "ja497:1.3": "saṃkāracolaṃ paṭimucca kaṇṭhe, ",
  "ja497:1.4": "ko re tuvaṃ hohisi adakkhiṇeyyoti. ",
  "ja497:2.1": "Annaṃ tava idaṃ pakataṃ yasassi, ",
  "ja497:2.2": "taṃ khajjare bhuñjare piyyare ca, ",
  "ja497:2.3": "jānāsi tvaṃ paradattūpajīviṃ, ",
  "ja497:2.4": "uttiṭṭha, piṇḍaṃ labhataṃ sapākoti. ",
  "ja497:3.1": "Annaṃ mama idaṃ pakataṃ brāhmaṇānaṃ ",
  "ja497:3.2": "attatthāya saddahato mama idaṃ, ",
  "ja497:3.3": "apehi ettho, kim idhaṭṭhito si, ",
  "ja497:3.4": "na mādisā tuyhaṃ dadanti jammāti. ",
  "ja497:4.1": "Thale ca ninne ca vapanti bījaṃ ",
  "ja497:4.2": "anūpakhette phalam āsasāna, ",
  "ja497:4.3": "etāya saddhāya dadāhi dānaṃ, ",
  "ja497:4.4": "app-eva ārādhaye dakkhiṇeyyeti. ",
  "ja497:5.1": "Khettāni mayhaṃ viditāni loke ",
  "ja497:5.2": "yes' āhaṃ bījāni patiṭṭhapemi, ",
  "ja497:5.3": "ye brāhmaṇā jātimantūpapannā ",
  "ja497:5.4": "tānīdha khettāni supesalānīti. ",
  "ja497:6.1": "Jātīmado ca atimānitā ca ",
  "ja497:6.2": "lobho ca doso ca mado ca moho ",
  "ja497:6.3": "ete aguṇā yesu va santi sabbe ",
  "ja497:6.4": "tānīdha khettāni apesalāni. ",
  "ja497:7.1": "Jātīmado ca atimanitā ca ",
  "ja497:7.2": "lobho ca doso ca mado ca moho ",
  "ja497:7.3": "Katth' eva ",
  "ja497:7.4": "bhaṭṭhā ",
  "ja497:8.1": "Upajotiyo ca ",
  "ja497:8.2": "Upajjhāyo athavā Bhaṇḍakucchi, ",
  "ja497:8.3": "imassa daṇḍañ ca vadhañ ca datvā (= supra p. 205.) ",
  "ja497:8.4": "gale gahetvā khalayātha jammanti. ",
  "ja497:9.1": "Girin nakhena khaṇasi ",
  "ja497:9.2": "ayo dantena khādasi ",
  "ja497:9.3": "jātavedaṃ padahasi ",
  "ja497:9.4": "yo isiṃ paribhāsasīti. ",
  "ja497:10.1": "Idaṃ vatvāna Mātaṅgo ",
  "ja497:10.2": "isi saccaparakkamo ",
  "ja497:10.3": "antalikkhasmiṃ pakkāmi ",
  "ja497:10.4": "brāhmaṇānaṃ udikkhatanti. ",
  "ja497:11.1": "Āveṭhitaṃ piṭṭhito uttamaṅgaṃ, ",
  "ja497:11.2": "bāhaṃ pasāreti akammaneyyaṃ, ",
  "ja497:11.3": "setāni akkhīni yathā matassa, ",
  "ja497:11.4": "ko me imaṃ puttam akāsi evanti. ",
  "ja497:12.1": "Idhāgamā samaṇo rummavāsī ",
  "ja497:12.2": "otallako paṃsupisācako va ",
  "ja497:12.3": "saṃkāracolaṃ paṭimucca kaṇṭhe, ",
  "ja497:12.4": "so te imaṃ puttam akāsi evanti. ",
  "ja497:13.1": "Katamaṃ disaṃ agamā bhūripañño, ",
  "ja497:13.2": "akkhātha me māṇavā etam atthaṃ, ",
  "ja497:13.3": "gantvāna taṃ paṭikaremu accayaṃ, ",
  "ja497:13.4": "app-eva naṃ puttaṃ labhemu jīvitanti. ",
  "ja497:14.1": "Vehāsayaṃ agamā bhūripañño ",
  "ja497:14.2": "pathaddhuno pannarase va cando, ",
  "ja497:14.3": "api cāpi so purimaṃ disaṃ agañchi ",
  "ja497:14.4": "saccappaṭiñño isi sādhurūpoti. ",
  "ja497:15.1": "Āveṭhitaṃ piṭṭhito uttamaṅgaṃ, ",
  "ja497:15.2": "bāhaṃ pasāreti akammaneyyaṃ, ",
  "ja497:15.3": "setāni akkhīni yathā matassa, ",
  "ja497:15.4": "ko me imaṃ puttam akāsi evanti. ",
  "ja497:16.1": "Yakkhā have santi mahānubhāvā ",
  "ja497:16.2": "anvāgatā isayo sādhurūpā, ",
  "ja497:16.3": "te duṭṭhacittaṃ kupitaṃ viditvā ",
  "ja497:16.4": "yakkhā hi te puttam akaṃsu evaṃ. ",
  "ja497:17.1": "Yakkhā ca me puttam akaṃsu evaṃ, ",
  "ja497:17.2": "tvaṃ ñeva me mā kuddho brahmacāri, ",
  "ja497:17.3": "tumhe va pāde saraṇaṃ gatāsmi ",
  "ja497:17.4": "anvāgatā puttasokena bhikkhu. ",
  "ja497:18.1": "Tad eva hī etarahī ca mayhaṃ ",
  "ja497:18.2": "manopadoso mama n' atthi koci, ",
  "ja497:18.3": "putto ca te vedamadena matto ",
  "ja497:18.4": "atthaṃ na jānāti adhicca vede. ",
  "ja497:19.1": "Addhā have bhikkhu muhuttakena ",
  "ja497:19.2": "sammuyhat' eva purisassa saññā, ",
  "ja497:19.3": "ekāparādhaṃ khama bhūripañña, (supra p. 313.) ",
  "ja497:19.4": "na paṇḍitā kodhabalā bhavantīti. ",
  "ja497:20.1": "Idañ ca mayhaṃ uttiṭṭhapiṇḍaṃ ",
  "ja497:20.2": "Maṇḍavyo bhuñjatu appapañño, ",
  "ja497:20.3": "yakkhā ca te naṃ na viheṭhayeyyuṃ, ",
  "ja497:20.4": "putto ca te hohiti so arogoti. ",
  "ja497:21.1": "Maṇḍavya bālo si parittapañño ",
  "ja497:21.2": "yo puññakhettānaṃ akovido si, ",
  "ja497:21.3": "mahakkasāvesu dadāsi dānaṃ ",
  "ja497:21.4": "kiliṭṭhakammesu asaññatesu. ",
  "ja497:22.1": "Jaṭā ca kesā ajināni vatthā ",
  "ja497:22.2": "jarūdapānaṃ va mukhaṃ parūḷhaṃ, ",
  "ja497:22.3": "pajaṃ imaṃ passatha rummarūpiṃ, ",
  "ja497:22.4": "na jaṭājinan tāyati appapaññaṃ. ",
  "ja497:23.1": "Yesaṃ rāgo ca doso ca ",
  "ja497:23.2": "avijjā ca virājitā ",
  "ja497:23.3": "khīṇāsavā arahanto ",
  "ja497:23.4": "tesu dinnaṃ mahapphalan Upahaññamāne Mejjhā Mātaṅgasmiṃ yasassine sapārisajjo ucchinno Mejjharaññaṃ tadā ahūti. ",
  "ja497:24.1": ""
}
