  "ja504:0.1": "",
  "ja504:0.2": "",
  "ja504:0.3": "",
  "ja504:0.4": "",
  "ja504:1.1": "Bhallāṭiyo nāma ahosi rājā, ",
  "ja504:1.2": "rajjaṃ pahāya migavaṃ acāri so, ",
  "ja504:1.3": "agamā girivaraṃ Gandhamādanaṃ ",
  "ja504:1.4": "sampupphitaṃ kimpurisānuciṇṇaṃ. ",
  "ja504:2.1": "Sālūrasaṃghañ ca nisedhayitvā ",
  "ja504:2.2": "dhanukalāpañ ca so nikkhipitvā ",
  "ja504:2.3": "upāgamī vacanaṃ vattukāmo ",
  "ja504:2.4": "yatthaṭṭhitā kimpurisā ahesuṃ. ",
  "ja504:3.1": "Himaccaye Hemavatāya tīre ",
  "ja504:3.2": "kim idhaṭṭhitā mantayavho abhiṇhaṃ, ",
  "ja504:3.3": "pucchāmi vo mānusadenavaṇṇe: ",
  "ja504:3.4": "kathaṃ vo jānanti manussaloketi. ",
  "ja504:4.1": "Mallaṃgiriṃ Paṇḍarakaṃ Tikūṭaṃ ",
  "ja504:4.2": "sītodiyā anuvicarāma najjo. ",
  "ja504:4.3": "",
  "ja504:4.4": "",
  "ja504:5.1": "Sukiccharūpaṃ paridevayavho, ",
  "ja504:5.2": "āliṅgito cāsi piyo piyāya, ",
  "ja504:5.3": "pucchāmi vo mānusadehavaṇṇe: ",
  "ja504:5.4": "kim idha vane rodatha appatītā. ",
  "ja504:6.1": "Sukiccharūpaṃ paridevayavho, ",
  "ja504:6.2": "āliṅgito cāsi piyo piyāya, ",
  "ja504:6.3": "pucchāmi vo mānusadehavaṇṇe: ",
  "ja504:6.4": "kim idha vane vilapatha appatītā. ",
  "ja504:7.1": "Sukiccharūpaṃ paridevayavho, ",
  "ja504:7.2": "āliṅgito cāsi piyo piyāya, ",
  "ja504:7.3": "pucchāmi vo mānusadehavaṇṇe: ",
  "ja504:7.4": "kim idha vane socatha appatītāti. May' ",
  "ja504:8.1": "ekarattiṃ [vip]pavasimha ludda ",
  "ja504:8.2": "akāmakā aññamaññaṃ sarantā, ",
  "ja504:8.3": "tam ekarattiṃ anutappamānā ",
  "ja504:8.4": "socāma, sā ratti punaṃ na hessati. ",
  "ja504:9.1": "Yam ekarattiṃ anutappath' etaṃ ",
  "ja504:9.2": "dhanaṃ va naṭṭhaṃ pitaraṃ va pitaṃ -- [page 440] 440 XV. Vīsatinipāta. ",
  "ja504:9.3": "pucchāmi vo mānusadehavaṇṇe: ",
  "ja504:9.4": "kathaṃ vināvāsam akappayittha. ",
  "ja504:10.1": "Yam imaṃ nadiṃ passasi sīghasotaṃ ",
  "ja504:10.2": "nānādumacchadanaṃ selakūṭaṃ ",
  "ja504:10.3": "tam me piyo uttari vassakāle ",
  "ja504:10.4": "mamañ ca maññaṃ anubhadhatīti. ",
  "ja504:11.1": "Ahañ ca aṃkolakaṃ ocināmi ",
  "ja504:11.2": "atimuttakaṃ sattaliyothikañ ca, ",
  "ja504:11.3": "piyo ca me hohiti mālabhārī ",
  "ja504:11.4": "ahañ ca naṃ mālinī ajjhupessaṃ. ",
  "ja504:12.1": "Ahañ c' idaṃ kuravakaṃ ocināmi ",
  "ja504:12.2": "uddālakā pāṭalisinduvāritā, ",
  "ja504:12.3": "piyo ca me hohiti mālabhārī ",
  "ja504:12.4": "ahañ ca naṃ mālinī ajjhupessaṃ. ",
  "ja504:13.1": "Ahañ ca sālissa supupphitassa ",
  "ja504:13.2": "oceyya pupphāni karomi mālaṃ, ",
  "ja504:13.3": "piyo ca me hohiti mālabhārī ",
  "ja504:13.4": "ahañ ca naṃ mālinī ajjhupessaṃ. ",
  "ja504:14.1": "Ahañ ca sālassa supupphitassa ",
  "ja504:14.2": "oceyya pupphāni karomi bhāraṃ, ",
  "ja504:14.3": "idañ ca no hohiti santharatthaṃ ",
  "ja504:14.4": "yatth' ajja 'maṃ viharissāmu rattiṃ. ",
  "ja504:15.1": "Ahañ ca kho akaluṃ candanañ ca ",
  "ja504:15.2": "silāya piṃsāmi pamattarūpā, ",
  "ja504:15.3": "piyo ca me hohiti rositaṅgo ",
  "ja504:15.4": "ahañ ca naṃ rositā ajjhupessaṃ. ",
  "ja504:16.1": "Athāgamā salilaṃ sīghasotaṃ ",
  "ja504:16.2": "nudaṃ sāle salaḷe kaṇṇikāre, ",
  "ja504:16.3": "",
  "ja504:16.4": "",
  "ja504:17.1": "Ubhosu tīresu mayaṃ tadā ṭhitā ",
  "ja504:17.2": "sampassantā ubhayo aññamaññaṃ, ",
  "ja504:17.3": "sakim pi rodāma sakiṃ hasāma, ",
  "ja504:17.4": "kicchena no agamā saṃvarī sā. ",
  "ja504:18.1": "Pāto ca kho uggate sūriyamhi ",
  "ja504:18.2": "catukkaṃ nadiṃ uttariyāna ludda ",
  "ja504:18.3": "āliṅgiyā aññamaññaṃ mayaṃ ubho ",
  "ja504:18.4": "sakim pi rodāma sakiṃ hasāma. ",
  "ja504:19.1": "Tīh' ūnakaṃ satta satāni ludda ",
  "ja504:19.2": "yam idha mayaṃ vippavasimha pubbe, ",
  "ja504:19.3": "vās' ek' imaṃ jīvitaṃ bhūmipāla, ",
  "ja504:19.4": "ko n' īdha kantāya vinā vaseyya. ",
  "ja504:20.1": "Āyuñ ca vo kīvatako nu samma, ",
  "ja504:20.2": "sace pi jānātha vadetha āyuṃ, ",
  "ja504:20.3": "anussavā vaddhato āgamā vā ",
  "ja504:20.4": "akkhātha me taṃ avikampamānā. ",
  "ja504:21.1": "Āyuñ ca no vassasahassa ludda, ",
  "ja504:21.2": "na c' antarā pāpako atthi rogo, ",
  "ja504:21.3": "appañ ca dukkhaṃ sukham eva bhiyyo, ",
  "ja504:21.4": "avītarāgā vijahāma jīvitanti. ",
  "ja504:22.1": "Idañ ca sutvāna amānusānaṃ ",
  "ja504:22.2": "Bhallāṭiyo ittaraṃ jīvitanti ",
  "ja504:22.3": "nivattatha na migavaṃ acāri ",
  "ja504:22.4": "adāsi dānāni abhuñji bhogeti ",
  "ja504:23.1": "Idañ ca sutvāna amānusānaṃ ",
  "ja504:23.2": "sammodatha mā kalahaṃ akattha ",
  "ja504:23.3": "mā vo tapī attakammāparādho ",
  "ja504:23.4": "yathāpi te kimpuris' ekarattiṃ. ",
  "ja504:24.1": "Idañ ca sutvāna amāṇusānaṃ ",
  "ja504:24.2": "sammodatha mā vivādaṃ akattha ",
  "ja504:24.3": "mā vo tapī attakammāparādho ",
  "ja504:24.4": "yathāpi te kimpuris' ekarattinti. ",
  "ja504:25.1": "Vividhaṃ adhimanā suṇom' ahaṃ ",
  "ja504:25.2": "vacanapathaṃ tava-m-atthasaṃhitaṃ, ",
  "ja504:25.3": "muñca giraṃ nudas' eva me daraṃ, ",
  "ja504:25.4": "samaṇa sukhāvaha jīva me ciranti. ",
  "ja504:26.1": ""
}
