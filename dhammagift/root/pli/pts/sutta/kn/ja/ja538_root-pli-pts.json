  "ja538:0.4": "",
  "ja538:1.1": "Mā paṇḍicciyaṃ vibhāvaya, ",
  "ja538:1.2": "bālamato bhava sabbapāṇinaṃ. ",
  "ja538:1.3": "sabbo taṃ jano ocināyatu, ",
  "ja538:1.4": "evaṃ tava attho bhavissatīti. ",
  "ja538:2.1": "Karomi te taṃ vacanaṃ ",
  "ja538:2.2": "yaṃ maṃ bhaṇasi devate, ",
  "ja538:2.3": "atthakāmāsi me amma ",
  "ja538:2.4": "hitakāmāsi devateti imaṃ g. ",
  "ja538:3.1": "vatvā Kin nu santaramāno va ",
  "ja538:3.2": "kāsuṃ khaṇasi sārathi, ",
  "ja538:3.3": "puṭṭho me samma akkhāhi, ",
  "ja538:3.4": "kiṃ kāsuyā karissasīti. ",
  "ja538:4.1": "Rañño mūgo ca pakkho ca ",
  "ja538:4.2": "putto jāto acetaso, ",
  "ja538:4.3": "so 'mhi raññā samijjhiṭṭho ",
  "ja538:4.4": "puttaṃ me nikhaṇaṃ vaneti. ",
  "ja538:5.1": "Na badhiro na mūgo 'smi ",
  "ja538:5.2": "na pakkho na pi paṅgulo, ",
  "ja538:5.3": "adhammaṃ sārathi kayirā ",
  "ja538:5.4": "maṃ ce tvaṃ nikhaṇaṃ vane. ",
  "ja538:6.1": "Ūruṃ bāhuñ ca me passa, ",
  "ja538:6.2": "bhāsitañ ca suṇohi me, ",
  "ja538:6.3": "adhammaṃ sārathi kayirā ",
  "ja538:6.4": "maṃ ce tvaṃ nikhaṇaṃ vaneti. ",
  "ja538:7.1": "Devatā nu si gandhabbo ",
  "ja538:7.2": "adu Sakko purindado, ",
  "ja538:7.3": "ko vā tvaṃ kassa vā putto, ",
  "ja538:7.4": "kathaṃ jānemu taṃ mayanti. ",
  "ja538:8.1": "N' amhi devo na gandhabbo ",
  "ja538:8.2": "na pi Sakko purindado, (Petavatthu p. 24.) ",
  "ja538:8.3": "Kāsirañño ahaṃ putto ",
  "ja538:8.4": "yaṃ kāsuyā nighaññasi. ",
  "ja538:9.1": "Tassa rañño ahaṃ putto ",
  "ja538:9.2": "yaṃ tvaṃ samupajīvasi, ",
  "ja538:9.3": "adhammaṃ sārathi kayirā ",
  "ja538:9.4": "maṃ ce tvaṃ nikhaṇaṃ vane. ",
  "ja538:10.1": "Yassa rukkhassa chāyāya ",
  "ja538:10.2": "nisīdeyya sayeyya vā (= J. vol. V. 340|21, Petavatthu p. 23.) ",
  "ja538:10.3": "na tassa sākhaṃ bhañjeyya, ",
  "ja538:10.4": "mittadūbho hi pāpako. ",
  "ja538:11.1": "Yathā rukkho tathā rājā, ",
  "ja538:11.2": "yathā sākhā tathā ahaṃ, ",
  "ja538:11.3": "yathā chāyūpago poso ",
  "ja538:11.4": "evaṃ tvam asi sārathi, ",
  "ja538:11.5": "adhammaṃ sārathi kayirā ",
  "ja538:11.6": "maṃ ce tvaṃ nikhaṇaṃ vaneti. ",
  "ja538:12.1": "Pahūtabhakkho bhavati ",
  "ja538:12.2": "vippavuttho sakā gharā, (Cfr. Feer in Journal Asiatique 1871 Tome 18 p. 248.) ",
  "ja538:12.3": "bahū naṃ upajīvanti ",
  "ja538:12.4": "yo mittānaṃ na dūbhati. ",
  "ja538:13.1": "Yaṃ yaṃ janapadaṃ yāti ",
  "ja538:13.2": "nigame rājadhāniyo ",
  "ja538:13.3": "sabbattha pūjito hoti ",
  "ja538:13.4": "yo mittānaṃ na dūbhati. ",
  "ja538:14.1": "Nāssa corā pasahanti ",
  "ja538:14.2": "nātimaññeti khattiyo ",
  "ja538:14.3": "sabbe amitte tarati ",
  "ja538:14.4": "yo mittānaṃ na dūbhati. ",
  "ja538:15.1": "Akuddho sagharaṃ eti ",
  "ja538:15.2": "sabhāya paṭinandito ",
  "ja538:15.3": "ñātīnaṃ uttamo hoti ",
  "ja538:15.4": "yo mittānaṃ na dūbhati. ",
  "ja538:16.1": "Sakkatvā sakkato hoti ",
  "ja538:16.2": "garu hoti sagāravo ",
  "ja538:16.3": "vaṇṇakittibhato hoti ",
  "ja538:16.4": "yo mittānaṃ na dūbhati. ",
  "ja538:17.1": "Pūjako labhate pūjaṃ ",
  "ja538:17.2": "vandako paṭivandanaṃ ",
  "ja538:17.3": "yaso kittiñ ca pappoti ",
  "ja538:17.4": "yo mittānaṃ na dūbhati. ",
  "ja538:18.1": "Aggi yathā pajjalati ",
  "ja538:18.2": "devatā va virocati ",
  "ja538:18.3": "siriyā ajahito hoti ",
  "ja538:18.4": "yo mittānam na dūbhati. ",
  "ja538:19.1": "Gāvo tassa pajāyanti ",
  "ja538:19.2": "khette vuttaṃ virūhati ",
  "ja538:19.3": "vuttānaṃ phalam asanāti ",
  "ja538:19.4": "yo mittānaṃ na dūbhati. ",
  "ja538:20.1": "Darito pabbatāto vā ",
  "ja538:20.2": "rukkhato patito naro ",
  "ja538:20.3": "cuto patiṭṭhaṃ labhati ",
  "ja538:20.4": "yo mittānaṃ na dūbhati . ",
  "ja538:21.1": "Virūḷhamūlasantānaṃ ",
  "ja538:21.2": "nigrodham iva māḷuto ",
  "ja538:21.3": "amittā na-ppasahanti ",
  "ja538:21.4": "yo mittānaṃ na dūbhati. ",
  "ja538:22.1": "Ehi taṃ paṭinessāmi ",
  "ja538:22.2": "rājaputta sakaṃ gharaṃ, ",
  "ja538:22.3": "rajjaṃ kārehi, bhaddan te, ",
  "ja538:22.4": "kiṃ araññe karissasīti. ",
  "ja538:23.1": "Alam me tena rajjena ",
  "ja538:23.2": "ñātakehi dhanena vā ",
  "ja538:23.3": "yam me adhammacariyāya ",
  "ja538:23.4": "rajjaṃ labbhetha sārathīti. ",
  "ja538:24.1": "Puṇṇapattaṃ palabbhehi ",
  "ja538:24.2": "rājaputta ito gato, ",
  "ja538:24.3": "pitā mātā ca me dajjuṃ ",
  "ja538:24.4": "rājaputta tayi gate. ",
  "ja538:25.1": "Orodhā ca kumārā ca ",
  "ja538:25.2": "vesiyānā ca brāhmaṇā ",
  "ja538:25.3": "te pi attamanā dajjuṃ ",
  "ja538:25.4": "rājaputta tayi gate. ",
  "ja538:26.1": "Hatthārūhā anīkaṭṭhā ",
  "ja538:26.2": "rathikā pattikārikā ",
  "ja538:26.3": "te pi dajjuṃ patītā me ",
  "ja538:26.4": "rājaputta tayi gate. ",
  "ja538:27.1": "Bahū janapadā c' aññe ",
  "ja538:27.2": "negamā ca samagatā ",
  "ja538:27.3": "upāyanāni me dajjuṃ ",
  "ja538:27.4": "rājaputta tayi gate. ",
  "ja538:28.1": "Pitu mātuc c' ahaṃ catto ",
  "ja538:28.2": "rathassa nigamassa ca ",
  "ja538:28.3": "atho sabbakumārānaṃ, ",
  "ja538:28.4": "n' atthi mayhaṃ sakaṃ gharaṃ. ",
  "ja538:29.1": "Anuññāto ahaṃ matyā, ",
  "ja538:29.2": "saṃcatto pitarā ahaṃ, eko ",
  "ja538:29.3": "araññe pabbajito, ",
  "ja538:29.4": "na kāme abhipatthayeti. ",
  "ja538:30.1": "Api ataramānānaṃ ",
  "ja538:30.2": "phalāsā va samijjhati, ",
  "ja538:30.3": "(J. vol. I p. 136) vipakkabrahmacariyo 'smi, ",
  "ja538:30.4": "evaṃ jānāhi sārathi. ",
  "ja538:31.1": "Api ataramānānaṃ ",
  "ja538:31.2": "sammadattho vipaccati, ",
  "ja538:31.3": "vipakkabrahmacariyo 'smi ",
  "ja538:31.4": "nikkhanto akutobhayoti. ",
  "ja538:32.1": "Evaṃ vaggukatho santo ",
  "ja538:32.2": "vissatthavacano c' asi, ",
  "ja538:32.3": "kasmā pituc ca mātuc ca ",
  "ja538:32.4": "santike na bhaṇī tadāti. ",
  "ja538:33.1": "Nāham asandhitā pakkho ",
  "ja538:33.2": "na badhiro asotatā, ",
  "ja538:33.3": "nāhaṃ ajivhatā mūgo, ",
  "ja538:33.4": "mā maṃ mūgam. adhārayi. ",
  "ja538:34.1": "Purimaṃ sarām' ahaṃ jātiṃ ",
  "ja538:34.2": "yattha rajjam akārayiṃ, ",
  "ja538:34.3": "kārayitvā tahiṃ rajjaṃ ",
  "ja538:34.4": "pāpatthaṃ nirayaṃ bhusaṃ. ",
  "ja538:35.1": "Vīsatiṃ c' eva vassāni ",
  "ja538:35.2": "tahiṃ rajjam akārayiṃ, ",
  "ja538:35.3": "asītivassasahassāni ",
  "ja538:35.4": "nirayamhi apaccayiṃ. ",
  "ja538:36.1": "Tassa rajjass' aham bhīto ",
  "ja538:36.2": "mā maṃ rajj' abhisecayuṃ, ",
  "ja538:36.3": "tasmā pituc ca mātuc ca ",
  "ja538:36.4": "santike na bhaṇiṃ tadā. ",
  "ja538:37.1": "Ucchaṅge maṃ nisīdetvā ",
  "ja538:37.2": "pitā atth' ānusāsati: ",
  "ja538:37.3": "ekaṃ hanatha, bandhatha ",
  "ja538:37.4": "ekaṃ khārāpatacchikaṃ ",
  "ja538:37.5": "ekaṃ sūlasmiṃ accetha, ",
  "ja538:37.6": "icc-assa-m-anusāsati. ",
  "ja538:38.1": "Tassāhaṃ pharusaṃ sutvā ",
  "ja538:38.2": "vācāyo samudīritā ",
  "ja538:38.3": "amūgo mūgavaṇṇena ",
  "ja538:38.4": "apakkho pakkhasammato ",
  "ja538:38.5": "sake muttakarīsasmiṃ ",
  "ja538:38.6": "acch' āhaṃ samparipluto. ",
  "ja538:39.1": "Kasirañ ca parittañ ca ",
  "ja538:39.2": "tañ ca dukkhena saṃyutaṃ ",
  "ja538:39.3": "ko taṃ jīvitam āgamma ",
  "ja538:39.4": "veraṃ kayirātha kenaci. ",
  "ja538:40.1": "Paññāya ca alābhena ",
  "ja538:40.2": "dhammassa ca adassanā ",
  "ja538:40.3": "ko taṃ jīvitam āgamma ",
  "ja538:40.4": "veraṃ kayirātha kenaci. ",
  "ja538:41.1": "Api ataramānānaṃ ",
  "ja538:41.2": "phalāsā va samijjhati, ",
  "ja538:41.3": "vipakkabrahmacariyo smi, ",
  "ja538:41.4": "evaṃ jānāhi sārathi. ",
  "ja538:42.1": "Api ataramānānaṃ ",
  "ja538:42.2": "sammadattho vipaccati, ",
  "ja538:42.3": "vipakkabrahmacariyo 'smi ",
  "ja538:42.4": "nikkhanto akutobhayoti. ",
  "ja538:43.1": "Aham pi pabbajissāmi ",
  "ja538:43.2": "rājaputta tav' antike, ",
  "ja538:43.3": "avhayassu maṃ, bhaddan te, ",
  "ja538:43.4": "pabbajjā mama ruccatīti. ",
  "ja538:44.1": "Rathaṃ niyyādayitvāna ",
  "ja538:44.2": "anaṇo ehi sārathi, ",
  "ja538:44.3": "anaṇassa hi pabbajjā, ",
  "ja538:44.4": "etaṃ isīhi vaṇṇitanti. ",
  "ja538:45.1": "Yad eva ty-āhaṃ vacanaṃ ",
  "ja538:45.2": "akaraṃ, bhaddam atthu te, ",
  "ja538:45.3": "tad eva me tvaṃ vacanaṃ ",
  "ja538:45.4": "yācito kattum arahasi. ",
  "ja538:46.1": "Idh' eva tāva acchassu ",
  "ja538:46.2": "yāva rājānam ānaye, ",
  "ja538:46.3": "app-eva te pitā disvā ",
  "ja538:46.4": "patīto sumano siyāti. ",
  "ja538:47.1": "Karomi te taṃ vacanaṃ ",
  "ja538:47.2": "yaṃ maṃ bhaṇasi sārathi, ",
  "ja538:47.3": "aham pi daṭṭhukāmo 'smi ",
  "ja538:47.4": "pitaraṃ me idhāgataṃ. ",
  "ja538:48.1": "Ehi samma nivattassu, ",
  "ja538:48.2": "kusalaṃ vajjāsi ñātinaṃ, ",
  "ja538:48.3": "mātaraṃ pitaraṃ mayhaṃ ",
  "ja538:48.4": "vutto vajjāsi vandananti. ",
  "ja538:49.1": "Tassa pāde gahetvāna ",
  "ja538:49.2": "katvā ca naṃ padakkhiṇaṃ ",
  "ja538:49.3": "sārathi ratham āruyha ",
  "ja538:49.4": "rājadvāraṃ upāgamīti. ",
  "ja538:50.1": "Suññaṃ mātā rathaṃ disvā ",
  "ja538:50.2": "ekaṃ sārathim āgataṃ ",
  "ja538:50.3": "assupuṇṇehi nettehi ",
  "ja538:50.4": "rodantī naṃ udikkhati. ",
  "ja538:51.1": "Ayaṃ so sārathi eti ",
  "ja538:51.2": "nihantvāna mam' atrajaṃ, ",
  "ja538:51.3": "nihato nūna me putto ",
  "ja538:51.4": "pathavyā bhūmivaddhano. ",
  "ja538:52.1": "Amittā nūna nandanti ",
  "ja538:52.2": "patītā nūna verino ",
  "ja538:52.3": "āgataṃ sārathiṃ disvā ",
  "ja538:52.4": "nihantvāna mam' atrajaṃ. ",
  "ja538:53.1": "Suññaṃ mātā rathaṃ disvā ",
  "ja538:53.2": "ekam sārathim āgataṃ ",
  "ja538:53.3": "assupuṇṇehi nettehi ",
  "ja538:53.4": "rodantī paripucchati: Kin ",
  "ja538:54.1": "nu mūgo kin nu pakkho ",
  "ja538:54.2": "kin nu so vilapi tadā ",
  "ja538:54.3": "nihaññamāno bhūmiyā, ",
  "ja538:54.4": "tam me akkhāhi sārathi. ",
  "ja538:55.1": "Kathaṃ hatthehi pādehi ",
  "ja538:55.2": "mūgapakkho vivajjayi ",
  "ja538:55.3": "nihaññamāno bhūmiyā, ",
  "ja538:55.4": "tam me akkhāhi pucchitoti. ",
  "ja538:56.1": "Akkhissan te ahaṃ ayye ",
  "ja538:56.2": "dajjāsi abhayaṃ mama ",
  "ja538:56.3": "yam me sutaṃ vā diṭṭhaṃ vā ",
  "ja538:56.4": "rājaputtassa santiketi. ",
  "ja538:57.1": "Abhayaṃ samma te dammi ",
  "ja538:57.2": "abhīto bhaṇa sārathi ",
  "ja538:57.3": "yan te sutaṃ vā diṭṭhaṃ vā ",
  "ja538:57.4": "rājaputtassa santiketi. ",
  "ja538:58.1": "Na so mūgo na so pakkho ",
  "ja538:58.2": "vissaṭṭhavacano ca so, ",
  "ja538:58.3": "rajjassa kira so bhīto ",
  "ja538:58.4": "akarī ālaye bahū. ",
  "ja538:59.1": "Purimaṃ so sarati jātiṃ ",
  "ja538:59.2": "yattha rajjam akārayi ",
  "ja538:59.3": "kārayitvā tahiṃ rajjaṃ ",
  "ja538:59.4": "pāpattha nirayaṃ bhusaṃ. ",
  "ja538:60.1": "Vīsatiñ c' eva vassāni ",
  "ja538:60.2": "tahiṃ rajjam akārayi, ",
  "ja538:60.3": "asītivassasahassāni ",
  "ja538:60.4": "nirayamhi apacci so. ",
  "ja538:61.1": "Tassa rajjassa so bhīto ",
  "ja538:61.2": "mā maṃ rajj' abhisecayuṃ, ",
  "ja538:61.3": "tasmā pituc ca mātuc ca ",
  "ja538:61.4": "santike na bhaṇi tadā. ",
  "ja538:62.1": "Aṅgapaccaṅgasampanno ",
  "ja538:62.2": "ārohapariṇāhavā ",
  "ja538:62.3": "vissaṭṭhavacano pañño ",
  "ja538:62.4": "magge saggassa tiṭṭhati. ",
  "ja538:63.1": "Sace tvaṃ daṭṭhukāmāsi ",
  "ja538:63.2": "rājaputtaṃ tav' atrajaṃ ",
  "ja538:63.3": "ehi taṃ pāpayissāmi ",
  "ja538:63.4": "yattha sammati Temiyoti. ",
  "ja538:64.1": "Yojayantu rathe asse, ",
  "ja538:64.2": "kacchaṃ nāgāna bandhatha, ",
  "ja538:64.3": "udīrayantu saṃkhapaṇavā ",
  "ja538:64.4": "vadataṃ ekapokkharā. ",
  "ja538:65.1": "Nadantu bherī sannaddhā ",
  "ja538:65.2": "vaggū vadatu dundubhi, ",
  "ja538:65.3": "negamā ca maṃ anventu, ",
  "ja538:65.4": "gacchaṃ puttanivedako. ",
  "ja538:66.1": "Orodhā ca kumārā ca ",
  "ja538:66.2": "vesiyānā ca brāhmaṇā ",
  "ja538:66.3": "khippaṃ yānāni yojentu, ",
  "ja538:66.4": "gacchaṃ puttanivedako. ",
  "ja538:67.1": "Hatthārohā anīkaṭṭhā ",
  "ja538:67.2": "rathikā pattikārikā ",
  "ja538:67.3": "khippaṃ yānāni yojentu, ",
  "ja538:67.4": "gacchaṃ puttanivedako. ",
  "ja538:68.1": "Samāgatā janapadā ",
  "ja538:68.2": "negamā ca samāgatā, ",
  "ja538:68.3": "khippaṃ yānāni yojentu, ",
  "ja538:68.4": "gacchaṃ puttanivedakoti. ",
  "ja538:69.1": "Asse ca sārathī yutte ",
  "ja538:69.2": "sindhave sīghavāhane ",
  "ja538:69.3": "rājadvāraṃ upagañchuṃ: ",
  "ja538:69.4": "yuttā deva ime hayāti. ",
  "ja538:70.1": "Thūlā javena hāyanti ",
  "ja538:70.2": "kisā hāyanti thāmunāti \"Evarūpe asse mā gaṇhathā\" 'ti sārathiṃ vadiṃsu. ",
  "ja538:70.3": "Kise thūle vivajjetvā ",
  "ja538:70.4": "saṃsaṭṭhā yojitā hayāti Deva javena vaṇṇena balena ca sādisā hayā yojitāti ā. ",
  "ja538:71.1": "Tato rājā taramāno ",
  "ja538:71.2": "yuttamāruyha sandanaṃ. ",
  "ja538:71.3": "itthāgāraṃ ajjhabhāsi: ",
  "ja538:71.4": "sabbā va anuyātha maṃ. ",
  "ja538:72.1": "Vāḷavījanim uṇhīsaṃ ",
  "ja538:72.2": "khaggaṃ chattañ ca paṇḍaraṃ ",
  "ja538:72.3": "upādhiratham āruyha ",
  "ja538:72.4": "suvaṇṇena alaṃkato. ",
  "ja538:73.1": "Tato ca rājā pāyāsi ",
  "ja538:73.2": "purakkhatvāna sārathiṃ, ",
  "ja538:73.3": "khippam eva upāgacchi ",
  "ja538:73.4": "yattha sammati Temiyo. ",
  "ja538:74.1": "Tañ ca disvāna āyantaṃ ",
  "ja538:74.2": "jalantam iva tejasā ",
  "ja538:74.3": "khattasaṃghaparibbūḷhaṃ ",
  "ja538:74.4": "Temiyo etad abravi: ",
  "ja538:75.1": "Kaccin nu tāta kusalaṃ, ",
  "ja538:75.2": "kacci tāta anāmayaṃ, ",
  "ja538:75.3": "kaccin nu rājakaññāyo ",
  "ja538:75.4": "ārogā mayha mātaro. ",
  "ja538:76.1": "Kusalaṃ c' eva me putta, ",
  "ja538:76.2": "atho putta anāmayaṃ, ",
  "ja538:76.3": "sabbā va rājakaññāyo ",
  "ja538:76.4": "ārogā tuyha mātaro. ",
  "ja538:77.1": "Kacci-ss-amajjapo tāta, ",
  "ja538:77.2": "kacci te suram appiyaṃ, ",
  "ja538:77.3": "kacci sacce ca dhamme ca ",
  "ja538:77.4": "dāne te ramatī mano. ",
  "ja538:78.1": "Amajjapo ahaṃ putta, ",
  "ja538:78.2": "atho me suram appiyaṃ, ",
  "ja538:78.3": "atho sacce ca dhamme ca ",
  "ja538:78.4": "dāne me ramatī mano. ",
  "ja538:79.1": "Kacci ārogaṃ yoggan te, ",
  "ja538:79.2": "kacci vahati vāhanaṃ, ",
  "ja538:79.3": "kacci te vyādhiyo n' atthi, ",
  "ja538:79.4": "sarīrass' upatāpanā. ",
  "ja538:80.1": "Atho ārogaṃ yoggam me, ",
  "ja538:80.2": "atho vahati vāhanaṃ, ",
  "ja538:80.3": "atho vyādhiyo n' atthi, ",
  "ja538:80.4": "sarīrass' upatāpanā. ",
  "ja538:81.1": "Kacci antā ca te phītā ",
  "ja538:81.2": "majjhe va bahalā tava, ",
  "ja538:81.3": "koṭṭhāgārañ ca kosañ ca ",
  "ja538:81.4": "kacci te paṭisanthataṃ. ",
  "ja538:82.1": "Svāgatan ",
  "ja538:82.2": "",
  "ja538:82.3": "",
  "ja538:82.4": "",
  "ja538:83.1": "te mahārāja, ",
  "ja538:83.2": "atho te adurāgataṃ, ",
  "ja538:83.3": "patiṭṭhāpentu pallaṃkaṃ ",
  "ja538:83.4": "yattha rājā nisakkatīti. ",
  "ja538:84.1": "Idh' eva te nisinnassa ",
  "ja538:84.2": "niyate paṇṇasanthate ",
  "ja538:84.3": "etto udakam ādāya ",
  "ja538:84.4": "pāde pakkhālayanti teti. ",
  "ja538:85.1": "Idam pi paṇṇakaṃ mayhaṃ ",
  "ja538:85.2": "randham rāja aloṇikaṃ ",
  "ja538:85.3": "paribhuñja mahārāja, ",
  "ja538:85.4": "pāhuno me si āgatoti. ",
  "ja538:86.1": "Na cāhaṃ paṇṇakaṃ bhuñje, ",
  "ja538:86.2": "na h' etaṃ mayha bhojanaṃ, ",
  "ja538:86.3": "sālīnaṃ odanaṃ bhuñje ",
  "ja538:86.4": "suciṃ maṃsūpasecananti. ",
  "ja538:87.1": "Accherakammaṃ paṭibhāti ",
  "ja538:87.2": "ekakam pi rahogataṃ, ",
  "ja538:87.3": "edisaṃ bhuñjamānānaṃ ",
  "ja538:87.4": "kena vaṇṇo pasīdatīti. ",
  "ja538:88.1": "Eko rāja nipajjāmi ",
  "ja538:88.2": "niyate paṇṇasanthate, ",
  "ja538:88.3": "tāya me ekaseyyāya ",
  "ja538:88.4": "rāja vaṇṇo pasīdati. ",
  "ja538:89.1": "Na ve nettiṃsabaddhā me ",
  "ja538:89.2": "rājarakkhā upaṭṭhitā, ",
  "ja538:89.3": "tāya me sukhaseyyāya ",
  "ja538:89.4": "rāja vaṇṇo pasīdati. ",
  "ja538:90.1": "Atītaṃ nānusocāmi, ",
  "ja538:90.2": "na-ppajappām' anāgataṃ, ",
  "ja538:90.3": "paccuppannena yāpemi, ",
  "ja538:90.4": "tena vaṇṇo pasīdati. ",
  "ja538:91.1": "Anāgatappajappāya ",
  "ja538:91.2": "atītassānusocanā ",
  "ja538:91.3": "etena bālā sussanti ",
  "ja538:91.4": "nalo va harito lutoti. ",
  "ja538:92.1": "Hatthānīkaṃ rathānīkaṃ ",
  "ja538:92.2": "asse pattī ca vammino ",
  "ja538:92.3": "nivesanāni rammāni ",
  "ja538:92.4": "ahaṃ putta dadāmi te. ",
  "ja538:93.1": "Itthāgāram pi te dammi ",
  "ja538:93.2": "sabbālaṃkārabhūsitaṃ, ",
  "ja538:93.3": "tā putta paṭipajjassu, ",
  "ja538:93.4": "tvaṃ no rājā bhavissasi. ",
  "ja538:94.1": "Kusalā naccagītassa ",
  "ja538:94.2": "sikkhitā caturitthiyo ",
  "ja538:94.3": "kāme taṃ ramayissanti, ",
  "ja538:94.4": "kiṃ araññe karissasi. ",
  "ja538:95.1": "Paṭirājūhi te kaññā ",
  "ja538:95.2": "ānayissaṃ alaṃkatā, ",
  "ja538:95.3": "tāsu putte janetvāna ",
  "ja538:95.4": "atha pacchā pabbajissasi. ",
  "ja538:96.1": "Yuvā ca daharo cāsi ",
  "ja538:96.2": "paṭhamuppattito susu, ",
  "ja538:96.3": "rajjaṃ kārehi, bhaddan te, ",
  "ja538:96.4": "kiṃ araññe karissasīti. ",
  "ja538:97.1": "Yuvā care brahmacariyaṃ, ",
  "ja538:97.2": "brahmacārī yuvā siyā, ",
  "ja538:97.3": "daharassa hi pabbajjā, ",
  "ja538:97.4": "etaṃ isīhi vaṇṇitaṃ. ",
  "ja538:98.1": "Yuvā care brahmacariyaṃ, ",
  "ja538:98.2": "brahmacārī yuvā siyā, ",
  "ja538:98.3": "brahmacariyaṃ carissāmi, ",
  "ja538:98.4": "nāhaṃ rajjena-m-atthiko. ",
  "ja538:99.1": "Passāmi vo 'haṃ daharaṃ ",
  "ja538:99.2": "‘amma tāta' vadantaraṃ ",
  "ja538:99.3": "kicchā laddhaṃ piyaṃ puttaṃ ",
  "ja538:99.4": "appatvā va jaraṃ mataṃ. ",
  "ja538:100.1": "Passāmi vo 'haṃ dahariṃ ",
  "ja538:100.2": "kumāriṃ cārudassaniṃ ",
  "ja538:100.3": "naḷavaṃsakaḷīraṃ va ",
  "ja538:100.4": "paluggaṃ jīvitakkhaye. ",
  "ja538:101.1": "Daharāpi hi mīyanti ",
  "ja538:101.2": "narā ca atha nāriyo, ",
  "ja538:101.3": "tattha ko vissase poso ",
  "ja538:101.4": "daharo 'mhīti jīvite. ",
  "ja538:102.1": "Yassa ratyā vivasane ",
  "ja538:102.2": "āyuṃ appataraṃ siyā ",
  "ja538:102.3": "appodake va macchānaṃ ",
  "ja538:102.4": "kin nu komārakaṃ tahiṃ. ",
  "ja538:103.1": "Niccam abbhāhato loko ",
  "ja538:103.2": "niccañ ca parivārito, ",
  "ja538:103.3": "amoghāsu vajantīsu ",
  "ja538:103.4": "kiṃ maṃ rajjena siñcasi. ",
  "ja538:104.1": "Kena-m-abbhāhato loko ",
  "ja538:104.2": "kena ca parivārito, ",
  "ja538:104.3": "kāyo amoghā gacchanti, ",
  "ja538:104.4": "tam me akkhāhi pucchito. ",
  "ja538:105.1": "Maccun' abbhāhato loko ",
  "ja538:105.2": "jarāya parivārito. ",
  "ja538:105.3": "ratyā amoghā gacchanti, ",
  "ja538:105.4": "evaṃ jānāhi khattiya. ",
  "ja538:106.1": "Yathāpi tante vitate ",
  "ja538:106.2": "yaṃ yaṃ dev' ūpavīyati ",
  "ja538:106.3": "appakaṃ hoti vetabbaṃ ",
  "ja538:106.4": "evaṃ maccāna jīvitaṃ. ",
  "ja538:107.1": "Yathā vārivaho pūro ",
  "ja538:107.2": "gacchan n' ūpanivattati ",
  "ja538:107.3": "evam āyu manussānaṃ ",
  "ja538:107.4": "gacchan n' ūpanivattati. ",
  "ja538:108.1": "Yathā vārivaho pūro ",
  "ja538:108.2": "vahe rukkh' ūpakūlaje ",
  "ja538:108.3": "evaṃ jarāya maraṇena ",
  "ja538:108.4": "vuyhante vata pāṇinoti. ",
  "ja538:109.1": "Hatthānīkaṃ rathānīkaṃ ",
  "ja538:109.2": "asse pattī ca vammino ",
  "ja538:109.3": "nivesanāni rammāni ",
  "ja538:109.4": "ahaṃ putta dadāmi te. ",
  "ja538:110.1": "Itthāgāram pi te dammi ",
  "ja538:110.2": "sabbālaṃkārabhūsitaṃ. ",
  "ja538:110.3": "tā putta paṭipajjassu, ",
  "ja538:110.4": "tvaṃ no rājā bhavissasi. ",
  "ja538:111.1": "Kusalā naccagītassa ",
  "ja538:111.2": "sikkhitā caturitthiyo ",
  "ja538:111.3": "kāme taṃ ramayissanti, ",
  "ja538:111.4": "kiṃ araññe karissasi. ",
  "ja538:112.1": "Paṭirājūhi te kaññā ",
  "ja538:112.2": "ānayissaṃ alaṃkatā, ",
  "ja538:112.3": "tāsu putte janetvāna ",
  "ja538:112.4": "atha pacchā pabbajissasi. ",
  "ja538:113.1": "Koṭṭhāgārañ ca ",
  "ja538:113.2": "",
  "ja538:113.3": "",
  "ja538:113.4": "",
  "ja538:114.1": "kosañ ca ",
  "ja538:114.2": "vāhanāni balāni ca ",
  "ja538:114.3": "nivesanāni rammāni ",
  "ja538:114.4": "ahaṃ putta dadāmi te. ",
  "ja538:115.1": "Gomaṇḍalaparibbūḷho ",
  "ja538:115.2": "dāsasaṃghapurakkhato ",
  "ja538:115.3": "rajjaṃ kārehi, bhaddan te, ",
  "ja538:115.4": "kim araññe karissasīti. ",
  "ja538:116.1": "Kiṃ dhanena yaṃ jiyyetha, ",
  "ja538:116.2": "kiṃ bhariyāya marissati, ",
  "ja538:116.3": "kiṃ yobbanena ciṇṇena ",
  "ja538:116.4": "yaṃ jarā abhihessati. ",
  "ja538:117.1": "Tattha kā nandi kā khiḍḍā ",
  "ja538:117.2": "kā rati kā dhanesanā, ",
  "ja538:117.3": "kim me puttehi dārehi, ",
  "ja538:117.4": "rāja mutto 'smi bandhanā. ",
  "ja538:118.1": "So 'haṃ evaṃ pajānāmi: ",
  "ja538:118.2": "maccu me na-ppamajjati, ",
  "ja538:118.3": "antakenādhipannassa ",
  "ja538:118.4": "kā rati kā dhanesanā. ",
  "ja538:119.1": "Phalānam iva pakkānaṃ ",
  "ja538:119.2": "niccaṃ papatanā bhayaṃ (vol. IV p. 127.) ",
  "ja538:119.3": "evaṃ jātānaṃ maccānaṃ ",
  "ja538:119.4": "niccaṃ maraṇato bhayaṃ. ",
  "ja538:120.1": "Sāyam eke na dissanti, ",
  "ja538:120.2": "pāto diṭṭhā bahujjanā, ",
  "ja538:120.3": "pāto eke na dissanti, ",
  "ja538:120.4": "sāyaṃ diṭṭhā bahujjanā. ",
  "ja538:121.1": "Ajj' eva kiccaṃ ātappaṃ, ",
  "ja538:121.2": "ko jaññā maraṇaṃ suve, ",
  "ja538:121.3": "na hi no saṃgaran tena ",
  "ja538:121.4": "mahāsenena maccunā. ",
  "ja538:122.1": "Corā dhanassa patthenti, ",
  "ja538:122.2": "rāja mutto smi bandhanā, ",
  "ja538:122.3": "ehi rāja nivattassu, ",
  "ja538:122.4": "nāhaṃ rajjena-m-atthikoti. ",
  "ja538:123.1": ""
}
