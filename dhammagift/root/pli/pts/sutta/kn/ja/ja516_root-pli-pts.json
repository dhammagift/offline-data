{
  "ja516:0.1": "",
  "ja516:0.2": "",
  "ja516:0.3": "",
  "ja516:0.4": "",
  "ja516:1.1": "ahū rājā ",
  "ja516:1.2": "Kāsīnaṃ raṭṭhavaḍḍhano, ",
  "ja516:1.3": "mittāmaccaparibbūḷho ",
  "ja516:1.4": "agamāsi Migāciraṃ. ",
  "ja516:2.1": "Tattha brāhmaṇam addakkhi ",
  "ja516:2.2": "setaṃ citraṃ kilāsinaṃ ",
  "ja516:2.3": "viddhastaṃ kuviḷāram va ",
  "ja516:2.4": "kisaṃ dhamanisanthataṃ. ",
  "ja516:3.1": "Paramakāruññataṃ pattaṃ ",
  "ja516:3.2": "disvā kicchagataṃ naraṃ ",
  "ja516:3.3": "avaca vyamhito rājā: ",
  "ja516:3.4": "yakkhānaṃ katamo nu si, ",
  "ja516:4.1": "Hatthapādā ca te setā, ",
  "ja516:4.2": "tato setataro siro, ",
  "ja516:4.3": "gattaṃ kammāsavaṇṇan te. ",
  "ja516:4.4": "kilāsabahulo c' asi. ",
  "ja516:5.1": "Vaṭṭhanāvalisaṃkāsā ",
  "ja516:5.2": "piṭṭhi te ninnatunnatā, ",
  "ja516:5.3": "kāḷā pabbā ca te aṅgā, ",
  "ja516:5.4": "nāññaṃ passāmi edisaṃ, ",
  "ja516:6.1": "Ugghaṭṭapādo tasito ",
  "ja516:6.2": "kiso dhamanisanthato ",
  "ja516:6.3": "chāto ātattarūpo si, kuto ",
  "ja516:6.4": "nu tvaṃ agacchasi, ",
  "ja516:7.1": "Duddasī appakāro si ",
  "ja516:7.2": "dubbaṇṇo bhīmadassano, ",
  "ja516:7.3": "janetti yāpi te mātā ",
  "ja516:7.4": "na taṃ iccheyya passituṃ, ",
  "ja516:8.1": "Kiṃ kammaṃ akarā pubbe, ",
  "ja516:8.2": "kaṃ avajjhaṃ aghātayi, ",
  "ja516:8.3": "kibbisaṃ yaṃ karitvāna ",
  "ja516:8.4": "idaṃ dukkhaṃ upāgamīti. ",
  "ja516:9.1": "Taggha te aham akkhissaṃ ",
  "ja516:9.2": "yathāpi kusalo tathā, ",
  "ja516:9.3": "saccavādiṃ hi lokasmiṃ ",
  "ja516:9.4": "pasaṃsant' idha paṇḍitā. ",
  "ja516:10.1": "Eko caraṃ gogaveso ",
  "ja516:10.2": "mūḷho accasariṃ vane ",
  "ja516:10.3": "araññe īriṇe vane ",
  "ja516:10.4": "nānākuñjarasevite. ",
  "ja516:11.1": "Vāḷamigānucarite ",
  "ja516:11.2": "vippanaṭṭho 'smi kānane, ",
  "ja516:11.3": "acariṃ tattha sattāhaṃ ",
  "ja516:11.4": "khuppipāsāsamappito. ",
  "ja516:12.1": "Tattha tindukaṃ addakkhiṃ ",
  "ja516:12.2": "visamatthabubhukkhito ",
  "ja516:12.3": "papātam abhilambantaṃ ",
  "ja516:12.4": "sampannaphaladhārinaṃ. ",
  "ja516:13.1": "Vātasītāni bhakkhesiṃ, ",
  "ja516:13.2": "tāni rucciṃsu me bhusaṃ, ",
  "ja516:13.3": "atitto rukkham āruhiṃ, ",
  "ja516:13.4": "‘tattha hessāmi āsito'. ",
  "ja516:14.1": "Ekaṃ me bhakkhitaṃ āsi ",
  "ja516:14.2": "dutiyaṃ abhipatthitaṃ, ",
  "ja516:14.3": "tato sā bhañjatha sākhā ",
  "ja516:14.4": "chinnā pharasunā viya. ",
  "ja516:15.1": "So 'haṃ sahā va sākhāhi ",
  "ja516:15.2": "uddhapādo avaṃsiro ",
  "ja516:15.3": "appatiṭṭhe anālambe ",
  "ja516:15.4": "giriduggasmi pāpataṃ. ",
  "ja516:16.1": "Yasmā ca vāri gambhīraṃ ",
  "ja516:16.2": "tasmā na samabhajjisaṃ, ",
  "ja516:16.3": "tattha sesiṃ nirānando ",
  "ja516:16.4": "anūnā dasa rattiyo. ",
  "ja516:17.1": "Ath' ettha kapi-m-āgañchi ",
  "ja516:17.2": "gonāgulo darīcaro ",
  "ja516:17.3": "sākhā [hi] sākhaṃ vicaranto ",
  "ja516:17.4": "khādamāno dumapphalaṃ. ",
  "ja516:18.1": "so maṃ disvā kisaṃ paṇḍuṃ ",
  "ja516:18.2": "kāruññam akaraṃ mayi: ",
  "ja516:18.3": "Ambho ko nāma so ettha ",
  "ja516:18.4": "evaṃ dukkhena aṭṭito, ",
  "ja516:19.1": "manusso amanusso vā ",
  "ja516:19.2": "attānaṃ me pavedaya. ",
  "ja516:19.3": "Tass' añjalim paṇāmetvā ",
  "ja516:19.4": "idaṃ vacanam abraviṃ: ",
  "ja516:20.1": "manusso 'haṃ vasaṃ patto, ",
  "ja516:20.2": "sā me n' atthi ito gati, ",
  "ja516:20.3": "taṃ vo vadāmi: bhaddaṃ vo ",
  "ja516:20.4": "tvañ ca me saraṇaṃ bhava. ",
  "ja516:21.1": "Garusilaṃ gahetvāna ",
  "ja516:21.2": "vicari pabbate kapi, ",
  "ja516:21.3": "silāya yoggaṃ katvāna ",
  "ja516:21.4": "nisabho etad abravi: ",
  "ja516:22.1": "Ehi me piṭṭhim āruyha ",
  "ja516:22.2": "gīvaṃ gaṇhāhi bāhuhi, ",
  "ja516:22.3": "ahan taṃ uddharissāmi ",
  "ja516:22.4": "giriduggato vegasā. ",
  "ja516:23.1": "Tassa taṃ vacanaṃ sutvā ",
  "ja516:23.2": "vānarindassa sirīmato ",
  "ja516:23.3": "piṭṭhiṃ āruyha dhīrassa ",
  "ja516:23.4": "gīvaṃ bāhāhi aggahiṃ. ",
  "ja516:24.1": "So maṃ tato samuṭṭhāsi ",
  "ja516:24.2": "tejasī balavā kapi ",
  "ja516:24.3": "vihaññamāno kicchena ",
  "ja516:24.4": "giriduggato vegasā. ",
  "ja516:25.1": "Uddharitvāna maṃ santo ",
  "ja516:25.2": "nisabho etad abravi: ",
  "ja516:25.3": "iṃgha maṃ samma rakkhassu, ",
  "ja516:25.4": "passupissaṃ muhuttakaṃ. ",
  "ja516:26.1": "Sīhavyagghā ca dīpī ca ",
  "ja516:26.2": "acchako kataracchayo ",
  "ja516:26.3": "te maṃ pamattaṃ hiṃseyyuṃ, ",
  "ja516:26.4": "te tvaṃ disvānā vāraya. ",
  "ja516:27.1": "Evam me paritātūna ",
  "ja516:27.2": "passupi so muhuttakaṃ; ",
  "ja516:27.3": "tadāhaṃ pāpikaṃ diṭṭhiṃ ",
  "ja516:27.4": "paṭilacchiṃ ayoniso: ",
  "ja516:28.1": "Bhakkho ayaṃ manussānaṃ ",
  "ja516:28.2": "yathā c' aññe vane migā, ",
  "ja516:28.3": "yan nūn' imaṃ vadhitvāna ",
  "ja516:28.4": "chāto khādeyya vānaraṃ. ",
  "ja516:29.1": "Āsito ca gamissāmi ",
  "ja516:29.2": "maṃsam ādāya sambalaṃ, ",
  "ja516:29.3": "kantāraṃ nittharissāmi, ",
  "ja516:29.4": "pātheyyam me bhavissati. ",
  "ja516:30.1": "Tato silaṃ gahetvāna ",
  "ja516:30.2": "matthakaṃ sannitāḷayiṃ, ",
  "ja516:30.3": "mama hatthakilantassa ",
  "ja516:30.4": "pahāro dubbalo ahu. ",
  "ja516:31.1": "So ca vegen' udappatto ",
  "ja516:31.2": "kapi rubiramakkhito ",
  "ja516:31.3": "assupuṇṇehi nettehi ",
  "ja516:31.4": "rodanto maṃ udikkhati: ",
  "ja516:32.1": "Māyyo maṃ kari, bhaddan te, tvaṃ ",
  "ja516:32.2": "ca nām' edisaṃ kari, ",
  "ja516:32.3": "tvaṃ ca kho nāma dīghāyu ",
  "ja516:32.4": "aññaṃ vāretuṃ arahasi. ",
  "ja516:33.1": "Aho vata re purisa ",
  "ja516:33.2": "tāva dukkarakāraka ",
  "ja516:33.3": "edisā visamā duggā ",
  "ja516:33.4": "papātā uddhaṭo mayā. ",
  "ja516:34.1": "Anīto paralokā va ",
  "ja516:34.2": "dubbheyyaṃ maṃ amaññatha, ",
  "ja516:34.3": "taṃ tena pāpadhammena ",
  "ja516:34.4": "pāpaṃ pāpena cintitaṃ. ",
  "ja516:35.1": "Mā h' eva tvaṃ adhammaṭṭha ",
  "ja516:35.2": "vedanaṃ kaṭukaṃ phusi, ",
  "ja516:35.3": "mā h' eva pāpaṃ kammantaṃ ",
  "ja516:35.4": "phalaṃ veḷuṃ va taṃ vadhi. ",
  "ja516:36.1": "Tayi me n' atthi vissāso, ",
  "ja516:36.2": "pāpadhammaṃ amaññatha, ",
  "ja516:36.3": "ehi me piṭṭhito gaccha ",
  "ja516:36.4": "dissamāno va santike. ",
  "ja516:37.1": "Mutto si hatthā vāḷānaṃ, ",
  "ja516:37.2": "patto si mānusiṃ padaṃ, ",
  "ja516:37.3": "esa maggo adhammaṭṭha, ",
  "ja516:37.4": "tena gaccha yathāsukhaṃ. ",
  "ja516:38.1": "Idaṃ vatvā giricaro ",
  "ja516:38.2": "rahade pakkhalya matthakaṃ ",
  "ja516:38.3": "assūni sampamajjitvā ",
  "ja516:38.4": "tato pabbatam āruhi. ",
  "ja516:39.1": "So 'haṃ tenābhisatto ' smi ",
  "ja516:39.2": "pariḷāhena aṭṭito, ",
  "ja516:39.3": "ḍayhamānena gattena ",
  "ja516:39.4": "vāriṃ pātum upāgamiṃ. ",
  "ja516:40.1": "Agginā viya santatto ",
  "ja516:40.2": "rahado ruhiramakkhito ",
  "ja516:40.3": "pubbalohitasaṃkāso ",
  "ja516:40.4": "sabbo me samapajjatha. ",
  "ja516:41.1": "Yāvanto udabindūni ",
  "ja516:41.2": "kāyasmiṃ nipatiṃsu me ",
  "ja516:41.3": "tāvanto gaṇḍū jāyetha ",
  "ja516:41.4": "addhabeluvasādisā. ",
  "ja516:42.1": "Pabhinnā pagghariṃsu me ",
  "ja516:42.2": "kuṇapā pubbalohitā, ",
  "ja516:42.3": "yena yen' eva gacchāmi ",
  "ja516:42.4": "gāmesu nigamesu ca ",
  "ja516:43.1": "Daṇḍahatthā nivārenti ",
  "ja516:43.2": "itthiyo purisā ca maṃ: ",
  "ja516:43.3": "okkitā pūtigandhena ",
  "ja516:43.4": "māssu orena-m-āgamā. ",
  "ja516:44.1": "Etādisaṃ idaṃ dukkhaṃ ",
  "ja516:44.2": "sattavassāni dāni me ",
  "ja516:44.3": "anubhomi sakaṃ kammaṃ ",
  "ja516:44.4": "pubbe dukkatam attano. ",
  "ja516:45.1": "Taṃ vo vadami bhaddaṃ vo ",
  "ja516:45.2": "yāvant' ettha samāgatā: (Dhp. v. 337.) ",
  "ja516:45.3": "māssu mittānaṃ dubbhittho, ",
  "ja516:45.4": "mittadubbho hi pāpako. ",
  "ja516:46.1": "Kuṭṭhī kilāsī bhavati ",
  "ja516:46.2": "yo mittānaṃ idha dubbhati. ",
  "ja516:46.3": "kāyassa bhedā mittaddu ",
  "ja516:46.4": "nirayaṃ ",
  "ja516:47.1": ""
}
