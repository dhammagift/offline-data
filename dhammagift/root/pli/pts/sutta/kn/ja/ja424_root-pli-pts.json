  "ja424:0.4": "",
  "ja424:1.1": "Ādittasmiṃ agārasmiṃ ",
  "ja424:1.2": "yaṃ nīharati bhājanaṃ (cfr. Saṃyutta p.31) ",
  "ja424:1.3": "taṃ tassa hoti atthāya ",
  "ja424:1.4": "no ca yaṃ tattha ḍayhati. ",
  "ja424:2.1": "Evaṃ ādīpito loko ",
  "ja424:2.2": "jarāya maraṇena ca, ",
  "ja424:2.3": "nīhareth' eva dānena, ",
  "ja424:2.4": "dinnaṃ hi hoti nībhatanti. ",
  "ja424:3.1": "Yo dhammaladdhassa dadāti dānaṃ (cfr. Saṃyutta p. 20-22) ",
  "ja424:3.2": "uṭṭhānaviriyādhigatassa jantu (no) ",
  "ja424:3.3": "atikkamma so Vetaraṇiṃ Yamassa ",
  "ja424:3.4": "dibbāni ṭhānāni upeti macco. ",
  "ja424:4.1": "Dānañ ca yuddhañ ca samānam āhu: ",
  "ja424:4.2": "appāpi santā bahuke jinanti, ",
  "ja424:4.3": "appam pi ce saddahāno dadāti ",
  "ja424:4.4": "ten' eva so hoti sukhī parattha. ",
  "ja424:5.1": "Viceyya dānaṃ Sugata-ppasatthaṃ, ",
  "ja424:5.2": "ye dakkhiṇeyyā idha jīvaloke ",
  "ja424:5.3": "etesu dinnāni mahapphalāni ",
  "ja424:5.4": "bījāni vuttāni yathā sukhette. ",
  "ja424:6.1": "Yo pāṇabhūtāni aheṭhayañ caraṃ ",
  "ja424:6.2": "parūpavādā na karoti pāpaṃ ",
  "ja424:6.3": "bhīruṃ pasaṃsanti, na hi tattha sūraṃ, ",
  "ja424:6.4": "bhayā hi santo na karoti pāpaṃ. ",
  "ja424:7.1": "Hīnena brahmacariyena ",
  "ja424:7.2": "khattiye upapajjati ",
  "ja424:7.3": "majjhimena ca devattaṃ, ",
  "ja424:7.4": "uttamena visujjhati. ",
  "ja424:8.1": "Addhā hi dānaṃ bahudhā pasatthaṃ ",
  "ja424:8.2": "dānā ca kho dhammapadaṃ va seyyo, ",
  "ja424:8.3": "",
  "ja424:8.4": "",
  "ja424:9.1": ""
}
