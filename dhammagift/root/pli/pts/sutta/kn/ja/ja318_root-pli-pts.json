  "ja318:1.1": "taṃ vasantasamaye ",
  "ja318:1.2": "kaṇaveresu bhānusu ",
  "ja318:1.3": "Sāmaṃ bāhāya pīḷesi ",
  "ja318:1.4": "sā taṃ ārogyam abruvīti. ",
  "ja318:2.1": "Ambho na kira saddheyyaṃ ",
  "ja318:2.2": "yaṃ vāto pabbataṃ vahe, ",
  "ja318:2.3": "pabbataṃ ce vahe vāto ",
  "ja318:2.4": "sabbam pi paṭhaviṃ vahe, ",
  "ja318:2.5": "yattha Sāmā kālakatā ",
  "ja318:2.6": "sāmaṃ ārogyam abruvīti. ",
  "ja318:3.1": "Na c' eva sā kālakatā, ",
  "ja318:3.2": "na ca sā aññam icchati, ",
  "ja318:3.3": "ekabhattakinī Sāmā ",
  "ja318:3.4": "tam evam abhikaṃkhatīti. ",
  "ja318:4.1": "Asanthutaṃ maṃ cirasanthutena ",
  "ja318:4.2": "niminni Sāmā adhuvaṃ dhuvena, (cfr. p. 221) ",
  "ja318:4.3": "mayāpi Sāmā nimineyya aññaṃ, ",
  "ja318:4.4": "ito ahaṃ dūrataraṃ gamissanti. ",
  "ja318:5.1": ""
}
