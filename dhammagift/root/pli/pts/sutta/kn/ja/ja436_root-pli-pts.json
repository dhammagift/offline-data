  "ja436:0.3": "",
  "ja436:0.4": "",
  "ja436:1.1": "Kuto nu āgacchatha bho tayo janā, ",
  "ja436:1.2": "svāgataṃ ettha nisīdathāsane, ",
  "ja436:1.3": "kacci 'ttha bhonto kusalaṃ anāmayaṃ, ",
  "ja436:1.4": "cirassam abbhāgamanaṃ hi vo idhāti. ",
  "ja436:2.1": "Aham eva eko idha-m-ajja patto ",
  "ja436:2.2": "na cāpi me dutiyo koci vijjati, ",
  "ja436:2.3": "kim eva sandhāya te bhāsitaṃ ise: ",
  "ja436:2.4": "kuto nu āgacchatha bho tayo janāti. ",
  "ja436:3.1": "Tuvañ ca eko bhariyā ca te piyā ",
  "ja436:3.2": "samuggapakkhittanikiṇṇa-m-antare, ",
  "ja436:3.3": "sā rakkhitā kucchigatā va te sadā ",
  "ja436:3.4": "Vāyussa puttena sahā tahiṃ ratāti. ",
  "ja436:4.1": "Saṃviggarūpo asinā vyākato ",
  "ja436:4.2": "so dānavo tattha samuggam uggili, ",
  "ja436:4.3": "",
  "ja436:4.4": "Suddiṭṭharūp' ",
  "ja436:5.1": "uggatapānuvattinā: ",
  "ja436:5.2": "hīnā narā ye pamadāvasaṃ gatā, ",
  "ja436:5.3": "yathā have pāṇa-r-iv' ettha rakkhitā ",
  "ja436:5.4": "duṭṭhā mayī aññam abhippamodati. ",
  "ja436:6.1": "Divā ca ratto ca mayā upaṭṭhitā ",
  "ja436:6.2": "tapassinā jotir ivā vane vasaṃ, ",
  "ja436:6.3": "sā dhammam okkamma adhammam ācari, ",
  "ja436:6.4": "akiriyarūpo pamadāhi santhavo. ",
  "ja436:7.1": "‘Sarīramajjhamhi ṭhitāti maññi 'haṃ ",
  "ja436:7.2": "‘mayhaṃ ayanti asatiṃ asaññataṃ, ",
  "ja436:7.3": "sā dhammam okkamma adhammam ācari, ",
  "ja436:7.4": "akiriyarūpo pamadāhi santhavo. ",
  "ja436:8.1": "‘Surakkhitam meti kathan nu vissase, ",
  "ja436:8.2": "anekacittāsu na h' atthi rakkhanā, ",
  "ja436:8.3": "etā hi pātālapapātasannibhā, ",
  "ja436:8.4": "ettha-ppamatto vyasanaṃ nigacchati. ",
  "ja436:9.1": "Tasmā hi te sukhino vītasokā ",
  "ja436:9.2": "ye mātugāmāhi caranti nissaṭā, ",
  "ja436:9.3": "etaṃ sivaṃ uttamam ābhipatthayaṃ ",
  "ja436:9.4": "na mātugāmāhi kareyya santhavanti. ",
  "ja436:10.1": ""
}
