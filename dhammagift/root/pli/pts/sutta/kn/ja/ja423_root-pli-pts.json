  "ja423:0.4": "",
  "ja423:1.1": "Yo indriyānaṃ kāmena ",
  "ja423:1.2": "vasaṃ Nārada gacchati ",
  "ja423:1.3": "so pariccajj' ubho loke ",
  "ja423:1.4": "jīvar eva visussatīti. ",
  "ja423:2.1": "Sukhassānantaraṃ dukkhaṃ ",
  "ja423:2.2": "dukkhassānantaraṃ sukhaṃ, ",
  "ja423:2.3": "sopi patto sukhā dukkhaṃ ",
  "ja423:2.4": "paṭikaṃkha varaṃ sukhanti. ",
  "ja423:3.1": "Kicchakāle kicchasaho ",
  "ja423:3.2": "yo kicchaṃ nātivattati ",
  "ja423:3.3": "sa kicchantaṃ sukhaṃ dhīro ",
  "ja423:3.4": "yogaṃ samadhigacchatīti. ",
  "ja423:4.1": "Na h' eva kāmāna kāmā ",
  "ja423:4.2": "nānatthā n' atthakāraṇā ",
  "ja423:4.3": "na katañ ca nikatvāna ",
  "ja423:4.4": "dhammā cavitum arahasīti. ",
  "ja423:5.1": "Dukkhaṃ gahapataṃ sādhu, ",
  "ja423:5.2": "saṃvibhajjañ ca bhojanaṃ, ",
  "ja423:5.3": "ahāso atthalābhesu, ",
  "ja423:5.4": "atthavyāpatti avyathoti. Ettāvatā ",
  "ja423:6.1": "te paṇḍiccaṃ ",
  "ja423:6.2": "Asito Devalo bravī, ",
  "ja423:6.3": "na-y-ito kiñcana pāpiyo ",
  "ja423:6.4": "yo indriyānaṃ vasaṃ vajeti. ",
  "ja423:7.1": "Amittānaṃ va hatthatthaṃ ",
  "ja423:7.2": "Siva pappoti mām iva, ",
  "ja423:7.3": "kammaṃ vijjañ ca dakkheyyaṃ ",
  "ja423:7.4": "vivāhaṃ sīlamaddavaṃ ",
  "ja423:7.5": "ete ca yase hāpetvā ",
  "ja423:7.6": "nibbatto sehi kammehi. ",
  "ja423:8.1": "So 'haṃ sahassajīno va ",
  "ja423:8.2": "abandhu aparāyano ",
  "ja423:8.3": "ariyadhammā apakkanto ",
  "ja423:8.4": "yathā peto tath' ev' ahaṃ. ",
  "ja423:9.1": "Sukhakāme dukkhāpetvā ",
  "ja423:9.2": "āpanno 'smi padaṃ imaṃ, ",
  "ja423:9.3": "so sukhaṃ nādhigacchāmi ",
  "ja423:9.4": "cito bhānumatā- m-ivāti. ",
  "ja423:10.1": ""
}
