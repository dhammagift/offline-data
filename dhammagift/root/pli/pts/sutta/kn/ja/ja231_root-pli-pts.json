  "ja231:1.1": "Yathāpi kītā purisass' upāhanā ",
  "ja231:1.2": "sukhassa atthāya dukhaṃ udabbahe ",
  "ja231:1.3": "ghammābhitattā talasā papīḷitā ",
  "ja231:1.4": "pāde tass' eva purisassa khādare ",
  "ja231:2.1": "Evam eva yo dukkulino anariyo ",
  "ja231:2.2": "tumhāka vijjañ ca sutañ ca-m-ādiya ",
  "ja231:2.3": "tam eva so tattha sutena khādati ",
  "ja231:2.4": "anariyo vuccati pānadūpamoti. ",
  "ja231:3.1": ""
}
