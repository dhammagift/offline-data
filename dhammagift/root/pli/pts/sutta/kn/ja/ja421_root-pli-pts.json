  "ja421:1.1": "Aṅgārajātā paṭhavī, ",
  "ja421:1.2": "kukkuḷānugatā mahī, ",
  "ja421:1.3": "atha gāyasi vattāni, ",
  "ja421:1.4": "na taṃ tapati ātapo. ",
  "ja421:2.1": "Uddhaṃ tapati ādicco, ",
  "ja421:2.2": "adho tapati vālukā, ",
  "ja421:2.3": "atha gāyasi vattāni, ",
  "ja421:2.4": "na taṃ tapati ātapoti. ",
  "ja421:3.1": "Na maṃ tapati ātapo, ",
  "ja421:3.2": "ātappā tapayanti maṃ, ",
  "ja421:3.3": "atthā hi vividhā rāja, ",
  "ja421:3.4": "te tapanti, na ātapoti. ",
  "ja421:4.1": "Addasaṃ kāma te mūlaṃ, ",
  "ja421:4.2": "saṃkappā kāma jāyasi, ",
  "ja421:4.3": "na taṃ saṃkappayissāmi, ",
  "ja421:4.4": "evaṃ kāma na hohisīti. ",
  "ja421:5.1": "Appāpi kāmā na alaṃ, ",
  "ja421:5.2": "bahūhi pi na tappati, ",
  "ja421:5.3": "ahahā bālalapanā, ",
  "ja421:5.4": "paṭivijjhetha jaggatoti. ",
  "ja421:6.1": "Appassa kammassa phalaṃ mamā -y-idaṃ, ",
  "ja421:6.2": "Udayo ajjhagamā mahattapattaṃ, ",
  "ja421:6.3": "suladdhalābhā vata māṇavassa ",
  "ja421:6.4": "yo pabbaji kāmarāgaṃ pahāyāti. ",
  "ja421:7.1": "Tapasā pajahanti pāpakammaṃ, ",
  "ja421:7.2": "tapasā nahāpitakumbhakārabhāvaṃ, ",
  "ja421:7.3": "tapasā abhibhuyya Gaṅgamāla ",
  "ja421:7.4": "nāmenālapas' ajja Brahmadattāti. ",
  "ja421:8.1": "Sandiṭṭhikam eva passatha ",
  "ja421:8.2": "khantisoracciyassa yo vipāko, ",
  "ja421:8.3": "yo sabbajanassa vanditā ahū ",
  "ja421:8.4": "taṃ vandāma sarājikā samaccāti. ",
  "ja421:9.1": "Mā kiñci avacuttha Gaṅgamālaṃ ",
  "ja421:9.2": "muninaṃ monapathesu sikkhamānam, ",
  "ja421:9.3": "eso hi atarī aṇṇavaṃ ",
  "ja421:9.4": "yaṃ taritvā vicaranti vītasokāti. ",
  "ja421:10.1": ""
}
