  "ja509:0.4": "",
  "ja509:1.1": "Cirassaṃ vata passāma (Cfr. Saṃyutta-N. ed. by L. Feer p. 1.) ",
  "ja509:1.2": "brāhmaṇaṃ devavaṇṇinaṃ ",
  "ja509:1.3": "mahājaṭaṃ bhāradharaṃ ",
  "ja509:1.4": "paṃkadantaṃ rajassiraṃ. ",
  "ja509:2.1": "Cirassaṃ vata passāma ",
  "ja509:2.2": "isiṃ dhammaguṇe rataṃ ",
  "ja509:2.3": "kāsāyavatthavasanaṃ ",
  "ja509:2.4": "vākacīraṃ paṭicchadaṃ. ",
  "ja509:3.1": "Āsanaṃ udakaṃ pajjaṃ ",
  "ja509:3.2": "patigaṇhātu no bhavaṃ, (396|7) ",
  "ja509:3.3": "agghe bhavantaṃ pucchāma, ",
  "ja509:3.4": "agghaṃkurutu no bhavanti. ",
  "ja509:4.1": "Adhicca vede pariyesa vittaṃ, ",
  "ja509:4.2": "putte gehe tāta patiṭṭhapetvā ",
  "ja509:4.3": "gandhe rase paccanubhutva sabbaṃ ",
  "ja509:4.4": "araññaṃ sādhu, muni so pasatthoti. ",
  "ja509:5.1": "Vedā na saccā na ca vittalābho, ",
  "ja509:5.2": "na puttalābhena jaraṃ vihanti, ",
  "ja509:5.3": "",
  "ja509:5.4": "",
  "ja509:6.1": "Addhā hi saccaṃ vacanaṃ tav' etaṃ: ",
  "ja509:6.2": "sakammanā hoti phalūpapatti, ",
  "ja509:6.3": "jiṇṇā ca mātāpitaro ca tava-y- ",
  "ja509:6.4": "ime, passeyyu taṃ vassasataṃ aroganti. ",
  "ja509:7.1": "Yass' assa sakkhī maraṇena rāja ",
  "ja509:7.2": "jarāya mettī naraviriyaseṭṭha ",
  "ja509:7.3": "yo cāpi jaññā [na] marissaṃ kadāci ",
  "ja509:7.4": "passeyyu taṃ vassasataṃ arogaṃ. ",
  "ja509:8.1": "Yathāpi nāvaṃ puriso dakamhi ",
  "ja509:8.2": "ereti ce naṃ upaneti tīraṃ ",
  "ja509:8.3": "evam pi vyādhī satataṃ jarā ca ",
  "ja509:8.4": "upanenti maccaṃ vasaṃ antakassāti. ",
  "ja509:9.1": "Paṃko ca kāmā palipo ca kāmā (vol. III 241|4) ",
  "ja509:9.2": "manoharā duttarā maccudheyyā, ",
  "ja509:9.3": "etasmiṃ paṃke palipe vyasannā ",
  "ja509:9.4": "hīnattarūpā na taranti pāraṃ. ",
  "ja509:10.1": "Ayaṃ pure luddam akāsi kammaṃ, ",
  "ja509:10.2": "sv-āyaṃ gahīto, na hi mokkh' ito me, ",
  "ja509:10.3": "orundhiyā naṃ parirakkhissāmi, ",
  "ja509:10.4": "māyaṃ puna luddam akāsi kammanti. ",
  "ja509:11.1": "Gavaṃ va naṭṭhaṃ puriso yathā vane ",
  "ja509:11.2": "pariyesatī rāja apassamāno ",
  "ja509:11.3": "evaṃ naṭṭho Esukārī mam' attho, ",
  "ja509:11.4": "so 'haṃ kathaṃ na gaveseyya rājāti gātham āha. ",
  "ja509:12.1": "Hiyyoti hiyyoti poso ",
  "ja509:12.2": "pareti [parihāyati], ",
  "ja509:12.3": "anāgataṃ n' etam atthīti ñatvā ",
  "ja509:12.4": "uppannachandaṃ [ko] panudeyya dhīroti. ",
  "ja509:13.1": "Passāmi vo 'haṃ dahariṃ kumāriṃ (III 395|1) ",
  "ja509:13.2": "mattūpamaṃ ketakapupphanettaṃ, ",
  "ja509:13.3": "abhutvā bhoge paṭhame vayasmiṃ ",
  "ja509:13.4": "ādāya maccu vajate kumāriṃ. ",
  "ja509:14.1": "Yuvā sujāto sumukho sudassano ",
  "ja509:14.2": "sāmo kusumbhaparikiṇṇamassu, -- ",
  "ja509:14.3": "hitvāna kāme paṭigaccha gehaṃ, ",
  "ja509:14.4": "anujāna maṃ, pabbajissāmi devāti. ",
  "ja509:15.1": "Sākhāhi rukkho labhate samaññaṃ, ",
  "ja509:15.2": "pahīnasākhaṃ pana khānuṃ āhu, ",
  "ja509:15.3": "pahīnaputtassa mam' ajja hoti ",
  "ja509:15.4": "Vāseṭṭhi bhikkhācariyāya kāloti gātham āha. ",
  "ja509:16.1": "Aghasmi koñcā va yathā himaccaye ",
  "ja509:16.2": "tantāni jālāni padāliya haṃsā ",
  "ja509:16.3": "gacchanti puttā ca patī ca mayhaṃ, ",
  "ja509:16.4": "sāhaṃ kathaṃ nānuvaje pajānanti. ",
  "ja509:17.1": "Ete bhutvā vamitvā ca ",
  "ja509:17.2": "pakkamanti vihaṅgamā ",
  "ja509:17.3": "ye ca bhutvā na vamiṃsu ",
  "ja509:17.4": "te me hatthattham āgatā. ",
  "ja509:18.1": "Avamī brāhmaṇo kāme, ",
  "ja509:18.2": "te tvaṃ paccāvamissasi, ",
  "ja509:18.3": "vantādo puriso rāja ",
  "ja509:18.4": "na so hoti pasaṃsiyoti. ",
  "ja509:19.1": "Paṃke va posaṃ palipe vyasannaṃ ",
  "ja509:19.2": "balī yathā dubbalaṃ uddhareyya ",
  "ja509:19.3": "evam pi maṃ tvaṃ udatāri bhoti ",
  "ja509:19.4": "Pañcāli gāthāhi subhāsitāhīti. ",
  "ja509:20.1": "Idaṃ vatvā mahārājā ",
  "ja509:20.2": "Esukārī disampati ",
  "ja509:20.3": "raṭṭhaṃ hitvāna pabbaji ",
  "ja509:20.4": "nāgo chetvā va bandhananti ",
  "ja509:21.1": "Rājā ca pabbajjam arocayittha ",
  "ja509:21.2": "raṭṭhaṃ pahāya naraviriyaseṭṭho, ",
  "ja509:21.3": "tuvam pi no hohi yath' eva rājā, ",
  "ja509:21.4": "amhehi guttā anusāsa rajjanti gātham āha. ",
  "ja509:22.1": "Rājā ca pabbajjam arocayittha ",
  "ja509:22.2": "raṭṭhaṃ pahāya naraviriyaseṭṭho, ",
  "ja509:22.3": "aham pi ekā carissāmi loke ",
  "ja509:22.4": "hitvāna kāmāni manoramāni. ",
  "ja509:23.1": "Rājā ca pabbajjam arocayittha ",
  "ja509:23.2": "raṭṭhaṃ pahāya naraviriyaseṭṭho, ",
  "ja509:23.3": "aham pi ekā carissāmi loke ",
  "ja509:23.4": "hitvāna kāmāni yathodhikāni. ",
  "ja509:24.1": "Accenti kālā tarayanti rattiyo, (cfr. Saṃyutta Nikāya I. p. 3.) ",
  "ja509:24.2": "vayoguṇā anupubbaṃ jahanti, ",
  "ja509:24.3": "aham pi ekā carissāmi loke ",
  "ja509:24.4": "hitvāna kāmāni manoramāni. ",
  "ja509:25.1": "Accenti kālā tarayanti rattiyo, ",
  "ja509:25.2": "vayoguṇā anupubbaṃ jahanti, ",
  "ja509:25.3": "aham pi ekā carissāmi loke ",
  "ja509:25.4": "hitvāna kāmāni yathodhikāni. ",
  "ja509:26.1": "Accenti kālā tarayanti rattiyo ",
  "ja509:26.2": "vayoguṇā anupubbaṃ jahanti, ",
  "ja509:26.3": "aham pi ekā carissāmi loke ",
  "ja509:26.4": "sītibhūtā sabbam aticca saṅganti. ",
  "ja509:27.1": ""
}
