  "ja239:1.1": "santaṃ ",
  "ja239:1.2": "paviṭṭhaṃ kumināmukhaṃ ",
  "ja239:1.3": "ruccate haritāmātā ",
  "ja239:1.4": "yaṃ maṃ khādanti macchakāti. ",
  "ja239:2.1": "Vilumpat' eva puriso ",
  "ja239:2.2": "yāv' assa upakappati, ",
  "ja239:2.3": "yadā c' aññe vilumpanti ",
  "ja239:2.4": "so vilutto vilumpatīti. ",
  "ja239:3.1": ""
}
