  "ja267:1.1": "Siṅgī migo āyatacakkhunetto ",
  "ja267:1.2": "aṭṭhittaco vārisayo alomo, ",
  "ja267:1.3": "tenābhibhūto kapaṇaṃ rudāmi, ",
  "ja267:1.4": "mā heva maṃ pāṇasamaṃ jaheyyāti. ",
  "ja267:2.1": "Ayya na taṃ jahissāmi ",
  "ja267:2.2": "kuñjara saṭṭhihāyana, ",
  "ja267:2.3": "pathavyā cāturantāya ",
  "ja267:2.4": "suppiyo hosi me tuvanti. ",
  "ja267:3.1": "Ye kulīrā samuddasmiṃ ",
  "ja267:3.2": "Gaṅgāya Nammadāya ca ",
  "ja267:3.3": "tesaṃ tvaṃ vārijo seṭṭho, ",
  "ja267:3.4": "muñca rodantiyā patinti. ",
  "ja267:4.1": ""
}
