  "ja179:0.4": "",
  "ja179:1.1": "Tañ ca appañ ca ucchiṭṭhaṃ ",
  "ja179:1.2": "tañ ca kicchena no adā, ",
  "ja179:1.3": "so 'haṃ brāhmaṇajātiko, ",
  "ja179:1.4": "yaṃ bhuttaṃ tam pi uggatanti. ",
  "ja179:2.1": "Evaṃ dhammaṃ niraṃkatvā ",
  "ja179:2.2": "yo adhammena jīvati ",
  "ja179:2.3": "Satadhammo va lābhena ",
  "ja179:2.4": "laddhena pi na nandatīti. ",
  "ja179:3.1": ""
}
