  "ja154:0.4": "",
  "ja154:1.1": "Idh' ūragānaṃ pavaro paviṭṭho ",
  "ja154:1.2": "selassa vaṇṇena pamokkham icchaṃ, ",
  "ja154:1.3": "brahmañ ca vaṇṇaṃ apacāyamāno ",
  "ja154:1.4": "bubhukkhito no visahāmi bhottunti. ",
  "ja154:2.1": "So Brahma-gutto ciram eva jīva, ",
  "ja154:2.2": "dibbā ca te pātubhavantu bhakkhā, ",
  "ja154:2.3": "so brahmavaṇṇaṃ apacāyamāno ",
  "ja154:2.4": "bubhukkhito no vitarāsi bhottunti. ",
  "ja154:3.1": ""
}
