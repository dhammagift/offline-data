  "ja244:0.4": "",
  "ja244:1.1": "Yaṃ passati na taṃ icchati, ",
  "ja244:1.2": "yañ ca na passati taṃ kira icchati, ",
  "ja244:1.3": "maññāmi ciraṃ carissati, ",
  "ja244:1.4": "na hi taṃ lacchati yaṃ so icchati. ",
  "ja244:2.1": "Yaṃ labhati na tena tussati, ",
  "ja244:2.2": "yaṃ pattheti laddhaṃ hīḷeti, ",
  "ja244:2.3": "icchā hi anantagocarā, ",
  "ja244:2.4": "vīticchānaṃ namo karomaseti. ",
  "ja244:3.1": ""
}
