  "ja415:1.1": "Na kir' atthi anomadassisu ",
  "ja415:1.2": "pāricariyā Buddhesu appikā, (= vol.I.228|14) ",
  "ja415:1.3": "sukkhāya aloṇikāya ca ",
  "ja415:1.4": "passa phalaṃ kummāsapiṇḍiyā. ",
  "ja415:2.1": "Hatthī gavāssā ca me bahū ",
  "ja415:2.2": "dhanadhaññaṃ paṭhavī ca kevalā ",
  "ja415:2.3": "nāriyo c' imā accharūpamā, ",
  "ja415:2.4": "passa phalaṃ kummāsapiṇḍiyāti. ",
  "ja415:3.1": "Abhikkhaṇaṃ rājakuñjara ",
  "ja415:3.2": "gāthā bhāsasi kosalādhipa, ",
  "ja415:3.3": "pucchāmi taṃ raṭṭhavaddhana ",
  "ja415:3.4": "bāḷhaṃ pītimano pabhāsasīti. Imasmiṃ ",
  "ja415:4.1": "yeva nagare ",
  "ja415:4.2": "kule aññatare ahuṃ, ",
  "ja415:4.3": "parakammakaro āsiṃ ",
  "ja415:4.4": "bhatako sīlasaṃvuto. ",
  "ja415:5.1": "kammāya nikkhamant' āhaṃ ",
  "ja415:5.2": "caturo samaṇe addasaṃ ",
  "ja415:5.3": "ācārasīlasampanne ",
  "ja415:5.4": "sītibhūte anāsave. ",
  "ja415:6.1": "Tesu cittaṃ pasādetvā ",
  "ja415:6.2": "nisīditvā paṇṇasanthate ",
  "ja415:6.3": "adaṃ Buddhānaṃ kummāsaṃ ",
  "ja415:6.4": "pasanno sakehi pāṇihi. ",
  "ja415:7.1": "Tassa kammassa kusalassa ",
  "ja415:7.2": "idaṃ me edisaṃ phalaṃ. ",
  "ja415:7.3": "anubhomi idaṃ rajjaṃ ",
  "ja415:7.4": "phītaṃ dharaṇim uttamanti. ",
  "ja415:8.1": "Dada bhuñja ca mā ca pamādo ",
  "ja415:8.2": "cakkaṃ vattaya kosalādhipa, ",
  "ja415:8.3": "mā rāja adhammiko ahū, ",
  "ja415:8.4": "dhammaṃ pālaya kosalādhipāti ",
  "ja415:9.1": "So 'haṃ tad eva punappunaṃ ",
  "ja415:9.2": "vaṭumaṃ ācarissāmi sobhane ",
  "ja415:9.3": "ariyācaritaṃ sukosale, ",
  "ja415:9.4": "arahanto me manāpā va passitunti ",
  "ja415:10.1": "Devī viya accharūpamā ",
  "ja415:10.2": "majjhe nārigaṇassa sobhasi, ",
  "ja415:10.3": "kiṃ kammam akāsi bhaddakaṃ, ",
  "ja415:10.4": "kenāsi vaṇṇavatī sukosaleti. ",
  "ja415:11.1": "Ambaṭṭhakulassa khattiya ",
  "ja415:11.2": "dass-āhaṃ parapessiyā ahuṃ ",
  "ja415:11.3": "saññatā dhammajīvinī ",
  "ja415:11.4": "sīlavatī ca apāpadassanā. ",
  "ja415:12.1": "Uddhaṭabhattaṃ ahaṃ tadā ",
  "ja415:12.2": "caramānassa adāsi bhikkhuno ",
  "ja415:12.3": "vittā sumanā sayaṃ ahaṃ, ",
  "ja415:12.4": "tassa kammassa phalaṃ mam' edisanti. ",
  "ja415:13.1": ""
}
