  "ja158:1.1": "Na-y-idaṃ visamasīlena ",
  "ja158:1.2": "Soṇena Suhanus sahā, Suhanu ",
  "ja158:1.3": "pi tādiso yeva ",
  "ja158:1.4": "yo Soṇassa sagocaro. ",
  "ja158:2.1": "Pakkhandinā pagabbhena ",
  "ja158:2.2": "niccaṃ sandānakhādinā ",
  "ja158:2.3": "sameti pāpaṃ pāpena ",
  "ja158:2.4": "sameti asatā asanti. Udet' ayaṃ ",
  "ja158:3.1": ""
}
