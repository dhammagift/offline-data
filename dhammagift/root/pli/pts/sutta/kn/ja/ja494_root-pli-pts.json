  "ja494:0.1": "",
  "ja494:0.2": "",
  "ja494:0.3": "",
  "ja494:0.4": "",
  "ja494:1.1": "Abbhuto vata lokasmiṃ ",
  "ja494:1.2": "uppajji lomahaṃsano: ",
  "ja494:1.3": "dibbo ratho pātur ahu ",
  "ja494:1.4": "Vedehassa yasassinoti. ",
  "ja494:2.1": "Devaputto mahiddhiko ",
  "ja494:2.2": "Mātali devasārathi ",
  "ja494:2.3": "nimantayittha rājānaṃ ",
  "ja494:2.4": "Vedehaṃ Mithilaggahaṃ: ",
  "ja494:3.1": "Eh' imaṃ ratham āruyha ",
  "ja494:3.2": "rājaseṭṭha disampati, ",
  "ja494:3.3": "devā dassanakāmā te ",
  "ja494:3.4": "tāvatiṃsā saindakā, ",
  "ja494:3.5": "saramānā hi te devā ",
  "ja494:3.6": "Sudhammāyaṃ samacchare. ",
  "ja494:4.1": "Tato ca rājā Sādhīno ",
  "ja494:4.2": "pamukho ratham āruhi, ",
  "ja494:4.3": "sahassayuttaṃ āruyha ",
  "ja494:4.4": "agā devāna sanike. ",
  "ja494:4.5": "Taṃ devā paṭinandiṃsu ",
  "ja494:4.6": "disvā rājānam āgataṃ: ",
  "ja494:5.1": "svāgatan te mahārāja ",
  "ja494:5.2": "atho te adurāgataṃ, ",
  "ja494:5.3": "nisīda dāni rājisi ",
  "ja494:5.4": "devarājassa santike. ",
  "ja494:6.1": "Sakko pi paṭinandittha ",
  "ja494:6.2": "Vedehaṃ Mithilaggahaṃ, ",
  "ja494:6.3": "nimantayī ca kāmehi ",
  "ja494:6.4": "āsanena ca Vāsavo. ",
  "ja494:7.1": "Sādhu kho si anuppatto ",
  "ja494:7.2": "āvāsaṃ vasavattinaṃ, ",
  "ja494:7.3": "vasa devesu rājisi ",
  "ja494:7.4": "sabbakāmasamiddhisu, ",
  "ja494:7.5": "tāvatiṃsesu devesu ",
  "ja494:7.6": "bhuñja kāme amānuseti. ",
  "ja494:8.1": "Ahaṃ pure saggagato ramāmi ",
  "ja494:8.2": "naccehi gītehi ca vāditehi, ",
  "ja494:8.3": "so dāni ajja na ramāmi sagge, ",
  "ja494:8.4": "āyun nu khīṇo, maraṇan nu santike ",
  "ja494:8.5": "udāhu mūḷho 'smi janindaseṭṭhāti gātham āha. ",
  "ja494:9.1": "Na cāyu khīṇaṃ, maraṇan te dūre, ",
  "ja494:9.2": "na cāpi mūḷho naraviriyaseṭṭha, tavañ ",
  "ja494:9.3": "ca puññāni parittakāni ",
  "ja494:9.4": "sesaṃ vipākaṃ idha vedayittho . ",
  "ja494:10.1": "Vasa devānubhāvena ",
  "ja494:10.2": "rājaseṭṭha disampati, ",
  "ja494:10.3": "tāvatiṃsesu devesu ",
  "ja494:10.4": "bhuñja kāme amānuseti. ",
  "ja494:11.1": "Yathā yācitakaṃ yānaṃ ",
  "ja494:11.2": "yathā yācitakaṃ dhanaṃ ",
  "ja494:11.3": "evaṃsampadam ev' etaṃ ",
  "ja494:11.4": "yam parato dānapaccayā. ",
  "ja494:12.1": "Na cāham etaṃ icchāmi ",
  "ja494:12.2": "yam parato dānapaccayā, ",
  "ja494:12.3": "sayaṃkatāni puññāni ",
  "ja494:12.4": "tam me āveṇiyaṃ dhanaṃ. ",
  "ja494:13.1": "So 'haṃ gantvā manussesu ",
  "ja494:13.2": "kāhāmi kusalaṃ bahuṃ ",
  "ja494:13.3": "dānena samacariyāya ",
  "ja494:13.4": "saṃyamena damena ca ",
  "ja494:13.5": "yaṃ katvā sukhito hoti ",
  "ja494:13.6": "na ca pacchānutappatīti. ",
  "ja494:14.1": "Imāni tāni khettāni ",
  "ja494:14.2": "imaṃ nikkhaṃ sukuṇḍalaṃ ",
  "ja494:14.3": "imā tā haritānopā ",
  "ja494:14.4": "imā najjo savantiyo ",
  "ja494:15.1": "Imā [tā] pokkharaṇiyo rammā ",
  "ja494:15.2": "cakkavākūpakūjitā ",
  "ja494:15.3": "mandālakehi sañchannā ",
  "ja494:15.4": "padumuppalakehi ca -- ",
  "ja494:15.5": "y' ass' imāni mamāyiṃsu ",
  "ja494:15.6": "kin nu te disataṃ gatā. ",
  "ja494:16.1": "Tānīdha khettāni so bhūmibhāgo ",
  "ja494:16.2": "te ārāmā te vana 'me pacārā -- ",
  "ja494:16.3": "tam eva mayhaṃ janataṃ apassato ",
  "ja494:16.4": "suññaṃ va me Nārada khāyate disāti. ",
  "ja494:17.1": "Diṭṭhā mayā vimānā ",
  "ja494:17.2": "obhāsentā catuddisā ",
  "ja494:17.3": "sammukhā devarājassa ",
  "ja494:17.4": "tidasānañ ca sammukhā. ",
  "ja494:18.1": "Vuttham me bhavanaṃ dibbaṃ ",
  "ja494:18.2": "bhuttā kāmā amānusā ",
  "ja494:18.3": "tavatiṃsesu devesu ",
  "ja494:18.4": "sabbakāmasamiddhisu. ",
  "ja494:19.1": "So 'haṃ etadisaṃ disvā ",
  "ja494:19.2": "puññāy' amhi idhāgato, ",
  "ja494:19.3": "dhammam eva carissāmi, ",
  "ja494:19.4": "nāhaṃ rajjena atthiko. ",
  "ja494:20.1": "Adaṇḍāvacaraṃ maggaṃ ",
  "ja494:20.2": "Sammāsambuddha-desitaṃ ",
  "ja494:20.3": "taṃ maggaṃ paṭipajjissaṃ ",
  "ja494:20.4": "yena gacchantisubbatāti āha. ",
  "ja494:21.1": ""
}
