  "ja385:1.1": "Sace brāhmaṇa gacchasi ",
  "ja385:1.2": "Sākete Añjanaṃvanaṃ ",
  "ja385:1.3": "vajjāsi Nandiyaṃ nāma ",
  "ja385:1.4": "puttaṃ asmākam orasaṃ: ",
  "ja385:1.5": "mātāpitā ca te vuddhā, ",
  "ja385:1.6": "te taṃ icchanti passitunti. ",
  "ja385:2.1": "Bhuttā mayā nivāpā ",
  "ja385:2.2": "rājino pānabhojanaṃ, ",
  "ja385:2.3": "taṃ rājapiṇḍaṃ avabhottuṃ ",
  "ja385:2.4": "nāhaṃ brāhmaṇa-m-ussahe. ",
  "ja385:3.1": "Odahissām' ahaṃ passaṃ ",
  "ja385:3.2": "khurapāṇissa rājino, ",
  "ja385:3.3": "tadāhaṃ sukhito mutto ",
  "ja385:3.4": "api passeyya mātaranti. Dānaṃ sīlaṃ pariccāgaṃ ajjavaṃ maddavaṃ tapaṃ akkodhaṃ avihiṃsā ca khantī ca avirodhanaṃ, Icc-ete kusale dhamme ṭhite passāmi attani, tato me jāyate pīti somanassañ c' anappakanti. ",
  "ja385:4.1": "Migarājā pure āsiṃ ",
  "ja385:4.2": "Kosalassa niketave ",
  "ja385:4.3": "Nandiyo nāma nāmena ",
  "ja385:4.4": "abhirūpo catuppado. ",
  "ja385:5.1": "Taṃ maṃ vadhituṃ āgañchi ",
  "ja385:5.2": "dāyasmiṃ Añjanāvane ",
  "ja385:5.3": "dhanuṃ adejjhaṃ katvāna ",
  "ja385:5.4": "usuṃ sandhāya Kosalo. ",
  "ja385:6.1": "Tassāhaṃ odahiṃ passaṃ ",
  "ja385:6.2": "khurapāṇissa rājino, ",
  "ja385:6.3": "tadāhaṃ sukhito mutto ",
  "ja385:6.4": "mātaraṃ daṭṭhum ",
  "ja385:7.1": "",
  "ja385:7.2": "",
  "ja385:8.1": "",
  "ja385:9.1": "",
  "ja385:9.2": "āgatoti ",
  "ja385:9.3": "",
  "ja385:9.4": ""
}
