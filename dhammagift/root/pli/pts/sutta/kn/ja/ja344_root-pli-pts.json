  "ja344:0.3": "",
  "ja344:0.4": "",
  "ja344:1.1": "Yo nīliyaṃ maṇḍayati ",
  "ja344:1.2": "saṇḍāsena vihaññati ",
  "ja344:1.3": "tassa sā vasam anvetu ",
  "ja344:1.4": "yā te ambe avāharīti. ",
  "ja344:2.1": "Vīsaṃ vā paṇṇuvīsaṃ vā ",
  "ja344:2.2": "ūnatiṃsaṃ va jātiyā ",
  "ja344:2.3": "tādisā patiṃ mā laddhā ",
  "ja344:2.4": "yā te ambe avāharīti. ",
  "ja344:3.1": "Dīghaṃ gacchatu addhānaṃ ",
  "ja344:3.2": "ekikā abhisāriyā ",
  "ja344:3.3": "saṃkete patiṃ mā addasa ",
  "ja344:3.4": "yā te ambe avāharīti. ",
  "ja344:4.1": "Alaṃkatā suvasanā ",
  "ja344:4.2": "mālinī candanussadā ",
  "ja344:4.3": "ekikā sayane sayatu ",
  "ja344:4.4": "yā te ambe avāharīti. ",
  "ja344:5.1": ""
}
