  "ja354:1.1": "Urago va tacam jiṇṇaṃ (Dhp. p.360; Thiessen, Kisāg. p.41.) ",
  "ja354:1.2": "hitvā gacchati san tanuṃ ",
  "ja354:1.3": "evaṃ sarīre nibbhoge ",
  "ja354:1.4": "pete kālakate sati. ",
  "ja354:2.1": "Ḍayhamāno na jānāti ",
  "ja354:2.2": "ñātīnaṃ paridevitaṃ, ",
  "ja354:2.3": "tasmā etaṃ na socāmi, ",
  "ja354:2.4": "gato so tassa yā gatīti. ",
  "ja354:3.1": "Anavhāto tato āgā, ",
  "ja354:3.2": "ananuññāto ito gato, ",
  "ja354:3.3": "yathāgato tathā gato, ",
  "ja354:3.4": "tattha kā paridevanā. ",
  "ja354:4.1": "Ḍayhamāno na jānāti ",
  "ja354:4.2": "ñātīnaṃ paridevitaṃ, ",
  "ja354:4.3": "tasmā etaṃ na socāmi, ",
  "ja354:4.4": "gato so tassa yā gatīti ",
  "ja354:5.1": "Sace rode kisī assaṃ, ",
  "ja354:5.2": "tassā me kiṃ phalaṃ siyā, ",
  "ja354:5.3": "ñātimittāsuhajjānaṃ ",
  "ja354:5.4": "bhiyyo no aratī siyā. ",
  "ja354:6.1": "Ḍayhamāno na jānāti ",
  "ja354:6.2": "ñātīnaṃ paridevitaṃ, ",
  "ja354:6.3": "tasmā etaṃ na socāmi, ",
  "ja354:6.4": "gato so tassa yā gatīti ",
  "ja354:7.1": "Yathāpi dārako candaṃ ",
  "ja354:7.2": "gacchantam anurodati ",
  "ja354:7.3": "evaṃsampadam ev' etaṃ ",
  "ja354:7.4": "yo petam anusocati. ",
  "ja354:8.1": "Ḍayhamāno na jānāti ",
  "ja354:8.2": "ñātīnaṃ paridevitaṃ, ",
  "ja354:8.3": "tasmā etaṃ na socāmi, ",
  "ja354:8.4": "gato so tassa yā gatīti ",
  "ja354:9.1": "Yathāpi [brahme9] udakakumbho ",
  "ja354:9.2": "bhinno appaṭisandhiyo ",
  "ja354:9.3": "evaṃsampadam ev' etaṃ ",
  "ja354:9.4": "yo petam anusocati. ",
  "ja354:10.1": "Ḍayhamāno na jānāti ",
  "ja354:10.2": "ñātīnaṃ paridevitaṃ, ",
  "ja354:10.3": "tasmā etaṃ na socāmi, ",
  "ja354:10.4": "gato so tassa yā gatīti ",
  "ja354:11.1": ""
}
