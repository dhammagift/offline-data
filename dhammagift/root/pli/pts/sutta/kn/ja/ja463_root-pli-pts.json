  "ja463:1.1": "Ummujjanti nimujjanti ",
  "ja463:1.2": "manussā khuranāsikā, ",
  "ja463:1.3": "Suppārakan taṃ pucchāma: ",
  "ja463:1.4": "samuddo katamo ayanti. ",
  "ja463:2.1": "Bharukacchā payātānaṃ ",
  "ja463:2.2": "vāṇijānaṃ dhanesinaṃ ",
  "ja463:2.3": "nāvāya vippanaṭṭhāya ",
  "ja463:2.4": "Khuramālīti vuccatīti. ",
  "ja463:3.1": "Yathā aggīva suriyo va ",
  "ja463:3.2": "samuddo patidissati, ",
  "ja463:3.3": "Suppārakan taṃ pucchāma: ",
  "ja463:3.4": "samuddo katamo ayanti ",
  "ja463:4.1": "Bharukacchā payātānaṃ ",
  "ja463:4.2": "vāṇijānaṃ dhanesinaṃ ",
  "ja463:4.3": "nāvāya vippanaṭṭhāya ",
  "ja463:4.4": "Aggimālīti vuccatīti. ",
  "ja463:5.1": "Yathā dadhiṃ va khīraṃ va ",
  "ja463:5.2": "samuddo patidissati, ",
  "ja463:5.3": "Suppārakan taṃ pucchāma: ",
  "ja463:5.4": "samuddo katamo ayanti ",
  "ja463:6.1": "Bharukacchā payātānaṃ ",
  "ja463:6.2": "vāṇijānaṃ dhanesinaṃ ",
  "ja463:6.3": "nāvāya vippanaṭṭhāya ",
  "ja463:6.4": "Dadhimālīti vuccatīti. ",
  "ja463:7.1": "Yathā kuso va sasso va ",
  "ja463:7.2": "samuddo patidissati, ",
  "ja463:7.3": "Suppārakan taṃ pucchāma, ",
  "ja463:7.4": "samuddo katamo ayanti ",
  "ja463:8.1": "Bharukacchā payātānaṃ ",
  "ja463:8.2": "vāṇijānaṃ dhanesinaṃ ",
  "ja463:8.3": "nāvāya vippanaṭṭhāya ",
  "ja463:8.4": "Kusamālīti vuccatīti. ",
  "ja463:9.1": "Yathā nalo va veḷuṃ va ",
  "ja463:9.2": "samuddo patidissati, ",
  "ja463:9.3": "Suppārakan taṃ pucchāma: ",
  "ja463:9.4": "samuddo katamo ayanti ",
  "ja463:10.1": "Bharukacchā payātānaṃ ",
  "ja463:10.2": "vāṇijānaṃ dhanesinaṃ ",
  "ja463:10.3": "navāya vippanaṭṭhaya ",
  "ja463:10.4": "Nalamālīti vuccatīti. ",
  "ja463:11.1": "Mahābhayo bhiṃsanako ",
  "ja463:11.2": "samuddo suyyat' amānuso, ",
  "ja463:11.3": "yathā sobbho papāto ca ",
  "ja463:11.4": "samuddo patidissati, ",
  "ja463:11.5": "Suppārakan taṃ pucchāma: ",
  "ja463:11.6": "samuddo katamo ayanti ",
  "ja463:12.1": "Bharukacchā payātānaṃ ",
  "ja463:12.2": "--pe-- ",
  "ja463:12.3": "Vaḷabhāmukhīti ",
  "ja463:12.4": "vuccatīti ",
  "ja463:13.1": "Yato sarāmi attānaṃ ",
  "ja463:13.2": "yato patto 'smi viññutaṃ ",
  "ja463:13.3": "nābhijānāmi saṃcicca ",
  "ja463:13.4": "ekapāṇam pi hiṃsitaṃ, ",
  "ja463:13.5": "etena saccavajjena ",
  "ja463:13.6": "sotthiṃ nāvā nivattatūti. ",
