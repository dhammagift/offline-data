  "ja324:0.4": "",
  "ja324:1.1": "Kalyāṇarūpo vatāyaṃ catuppado ",
  "ja324:1.2": "subhaddako c' eva supesalo ca ",
  "ja324:1.3": "yo brāhmanaṃ jātimantūpapannaṃ ",
  "ja324:1.4": "apacāyati meṇḍavaro yasassīti. ",
  "ja324:2.1": "Mā brāhmaṇa ittaradassanena ",
  "ja324:2.2": "vissāsam āpajji catuppadassa, ",
  "ja324:2.3": "daḷhappahāraṃ abhikaṃkhamāno ",
  "ja324:2.4": "avasakkatī dassati suppahāranti. ",
  "ja324:3.1": "Satthi bhaggā, pavaṭṭito khāribhāro, ",
  "ja324:3.2": "sabbaṃ bhaṇḍaṃ brāhmaṇass' īdha bhinnaṃ, ",
  "ja324:3.3": "bāhā paggayha kandati: ",
  "ja324:3.4": "abhidhāvatha, haññate brahmacārīti. ",
  "ja324:4.1": "Evaṃ so nihato seti ",
  "ja324:4.2": "yo apūjaṃ namassati ",
  "ja324:4.3": "yathāham ajja pahato ",
  "ja324:4.4": "hato meṇḍena dummatīti. ",
  "ja324:5.1": ""
}
