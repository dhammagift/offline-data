  "ja503:0.4": "",
  "ja503:1.1": "Migaluddo mahārājā ",
  "ja503:1.2": "Pañcālānaṃ rathesabho ",
  "ja503:1.3": "nikkhanto saha senāya ",
  "ja503:1.4": "ogaṇo vanam āgamā. ",
  "ja503:2.1": "Tatth' addasā araññasmiṃ ",
  "ja503:2.2": "takkarānaṃ kuṭiṃ kataṃ, ",
  "ja503:2.3": "tassā kuṭiyā nikkhamma ",
  "ja503:2.4": "suvo luddāni bhāsati: ",
  "ja503:3.1": "Sampannavāhano poso ",
  "ja503:3.2": "yuvā sammaṭṭhakuṇḍalo ",
  "ja503:3.3": "sobhati lohituṇhīso ",
  "ja503:3.4": "divā suriyo va bhāsati. ",
  "ja503:4.1": "Majjhantike sampaṭike ",
  "ja503:4.2": "sutto rājā sasārathi, ",
  "ja503:4.3": "hand' assābharaṇaṃ sabbaṃ ",
  "ja503:4.4": "gaṇhāma sahasā mayaṃ. ",
  "ja503:5.1": "Nisīthe pi raho dāni ",
  "ja503:5.2": "sutto rājā sasārathi, ",
  "ja503:5.3": "ādāya vatthaṃ maṇikuṇḍalañ ca ",
  "ja503:5.4": "hantvāna sākhāhi avattharāmāti. ",
  "ja503:6.1": "Kin nu ummattarūpo va ",
  "ja503:6.2": "Sattigumba pabhāsasi, ",
  "ja503:6.3": "durāsadā hi rājāno ",
  "ja503:6.4": "aggi pajjalito yathāti gātham āha. ",
  "ja503:7.1": "Atha tvaṃ Patikolamba ",
  "ja503:7.2": "matto thullāni gajjasi, ",
  "ja503:7.3": "mātari mayha naggāya ",
  "ja503:7.4": "kin nu tvaṃ vijigucchaseti. ",
  "ja503:8.1": "Uṭṭhehi samma taramāno, ",
  "ja503:8.2": "rathaṃ yojehi sārathi, ",
  "ja503:8.3": "sakuṇo me na ruccati, ",
  "ja503:8.4": "aññaṃ gacchāma assamanti. ",
  "ja503:9.1": "Yutto ratho mahārājā, ",
  "ja503:9.2": "yutto ca balavāhano, ",
  "ja503:9.3": "adhitiṭṭha mahārājā, ",
  "ja503:9.4": "aññaṃ gacchāma assamanti ",
  "ja503:10.1": "Ko nu 'me va gatā sabbe ",
  "ja503:10.2": "ye asmiṃ paricārakā, ",
  "ja503:10.3": "esa gacchati Pañcālo ",
  "ja503:10.4": "mutto tesaṃ adassanā. ",
  "ja503:11.1": "Kodaṇḍakāni gaṇhatha ",
  "ja503:11.2": "sattiyo tomarāni ca, ",
  "ja503:11.3": "esa gacchati Pañcālo, ",
  "ja503:11.4": "mā vo muñcittha jīvitanti. ",
  "ja503:12.1": "Athāparo paṭinandittha ",
  "ja503:12.2": "suvo lohitatuṇḍako: ",
  "ja503:12.3": "svāgatan te mahārāja, ",
  "ja503:12.4": "atho te adurāgataṃ, ",
  "ja503:12.5": "issaro si anuppatto, ",
  "ja503:12.6": "yaṃ idh' atthi pavedaya: ",
  "ja503:13.1": "Tiṇḍukāni piyālāni ",
  "ja503:13.2": "madhuke kāsumāriyo ",
  "ja503:13.3": "phalāni khuddakappāni, ",
  "ja503:13.4": "bhuñja rāja varaṃ varaṃ. ",
  "ja503:14.1": "Idam pi pānīyaṃ sītaṃ ",
  "ja503:14.2": "ābhataṃ girigabbharā, ",
  "ja503:14.3": "tato piva mahārāja ",
  "ja503:14.4": "sace tvaṃ abhikaṃkhasi. ",
  "ja503:15.1": "Araññe uñchāya gatā ",
  "ja503:15.2": "ye asmiṃ paricārakā, ",
  "ja503:15.3": "sayaṃ uṭṭhāya gaṇhavho, ",
  "ja503:15.4": "hatthā me n' atthi dātaveti. ",
  "ja503:16.1": "Bhadrako vat' ayaṃ pakkhī ",
  "ja503:16.2": "dijo paramadhammiko, ",
  "ja503:16.3": "ath' eso itaro pakkhī ",
  "ja503:16.4": "suvo luddāni bhāsati. ",
  "ja503:17.1": "Etaṃ hanatha bandhatha, ",
  "ja503:17.2": "mā vo muñcittha jīvitaṃ, ",
  "ja503:17.3": "icc-evaṃ vilapantassa ",
  "ja503:17.4": "sotthiṃ patto 'smi assamanti ",
  "ja503:18.1": "Bhātaro 'sma mahārāja ",
  "ja503:18.2": "sodariyā ekamātukā ",
  "ja503:18.3": "ekarukkhasmiṃ saṃvaddhā ",
  "ja503:18.4": "nānākhettagatā ubho. ",
  "ja503:19.1": "Sattigumbo ca corānaṃ ",
  "ja503:19.2": "ahañ ca isinaṃ idha, ",
  "ja503:19.3": "asataṃ so sataṃ ahaṃ ",
  "ja503:19.4": "tena dhammena no vināti. ",
  "ja503:20.1": "Tattha vadho ca bandho ca ",
  "ja503:20.2": "nikatī vañcanāni ca ",
  "ja503:20.3": "ālopā sahasākārā, ",
  "ja503:20.4": "tāni so tattha sikkhati. ",
  "ja503:21.1": "Idha saccañ ca dhammo ca ",
  "ja503:21.2": "ahiṃsā saññamo damo, ",
  "ja503:21.3": "āsanūdakadāyīnaṃ ",
  "ja503:21.4": "aṃke vaddho 'smi Bhāratāti ",
  "ja503:22.1": "Yaṃ yaṃ hi rāja bhajati ",
  "ja503:22.2": "sataṃ vā yadivā asaṃ ",
  "ja503:22.3": "sīlavantaṃ visīlaṃ vā ",
  "ja503:22.4": "vasaṃ tass' eva gacchati. ",
  "ja503:23.1": "Yādisaṃ kurute mittaṃ ",
  "ja503:23.2": "yādisañ c' ūpasevati ",
  "ja503:23.3": "so pi tādisako hoti ",
  "ja503:23.4": "sahavāso hi tādiso. ",
  "ja503:24.1": "Sevamāno sevamānaṃ ",
  "ja503:24.2": "saphuṭṭho samphusaṃ paraṃ ",
  "ja503:24.3": "saro diddho kalāpaṃ va ",
  "ja503:24.4": "alittam upalimpati. ",
  "ja503:24.5": "Upalepabhayā dhīro ",
  "ja503:24.6": "n' eva pāpasakhā siyā, ",
  "ja503:25.1": "pūtimacchaṃ kusaggena ",
  "ja503:25.2": "yo naro upanayhati ",
  "ja503:25.3": "kusāpi pūtī vāyanti, ",
  "ja503:25.4": "evaṃ bālūpasevanā. ",
  "ja503:26.1": "Tagarañ ca palāsena ",
  "ja503:26.2": "yo naro upanayhati ",
  "ja503:26.3": "pattāpi surabhī vāyanti, ",
  "ja503:26.4": "evaṃ dhīrūpasevanā. ",
  "ja503:27.1": "Tasmā phalapuṭasseva ",
  "ja503:27.2": "ñatvā sampākam attano ",
  "ja503:27.3": "asante n' ūpaseveyya ",
  "ja503:27.4": "sante seveyya paṇḍito, ",
  "ja503:27.5": "asanto nirayaṃ nenti ",
  "ja503:27.6": "santo pāpenti suggatinti. ",
  "ja503:28.1": ""
}
