  "ja498:0.4": "",
  "ja498:1.1": "Sabbaṃ narānaṃ saphalaṃ suciṇṇaṃ, ",
  "ja498:1.2": "na kammanā kiñcana mogham atthi, ",
  "ja498:1.3": "passāmi Sambhūtaṃ mahānubhāvaṃ ",
  "ja498:1.4": "sakammanā puññaphalūpapannaṃ. ",
  "ja498:2.1": "Sabbaṃ narānaṃ saphalaṃ suciṇṇaṃ, ",
  "ja498:2.2": "na kammanā kiñcana moghaṃ atthi, ",
  "ja498:2.3": "kaccin nu Cittassa pi evam eva ",
  "ja498:2.4": "iddho mano tassa yathāpi mayhanti ",
  "ja498:3.1": "Sabbaṃ narānaṃ saphalaṃ suciṇṇaṃ, ",
  "ja498:3.2": "na kammanā kiñcana mogham atthi, ",
  "ja498:3.3": "Cittaṃ vijānāhi tath' eva deva, ",
  "ja498:3.4": "iddho mano tassa yathāpi tuyhanti. ",
  "ja498:4.1": "Bhavan nu Citto, sutam aññato te, ",
  "ja498:4.2": "udāhu te koci naṃ etad akkhā, ",
  "ja498:4.3": "gāthā sugītā, na mam' atthi kaṃkhā, ",
  "ja498:4.4": "dadāmi te gāmavaraṃ satañ cāti. ",
  "ja498:5.1": "Na cāhaṃ Citto, sutaṃ aññato me, ",
  "ja498:5.2": "isī ca me etam atthaṃ asaṃsi, ",
  "ja498:5.3": "gantvāna rañño paṭigāhi gāthaṃ, ",
  "ja498:5.4": "api te varaṃ attamano dadeyyāti. ",
  "ja498:6.1": "Yojentu ve rājarathe ",
  "ja498:6.2": "sukate cittasibbane, ",
  "ja498:6.3": "kacchaṃ nāgānaṃ bandhatha, ",
  "ja498:6.4": "gīveyyaṃ paṭimuñcatha. ",
  "ja498:7.1": "Āhaññaruṃ bherimudiṅgasaṃkhe, ",
  "ja498:7.2": "sīghāni yānāni ca yojayantu, ",
  "ja498:7.3": "ajj' ev' ahaṃ assamaṃ taṃ gamissaṃ ",
  "ja498:7.4": "yatth' eva dakkhissaṃ isiṃ nisinnanti. ",
  "ja498:8.1": "Suladdhalābhā vata me ahosi ",
  "ja498:8.2": "gāthā sugītā parisāya majjhe, ",
  "ja498:8.3": "so 'haṃ isiṃ sīlavatūpapannaṃ ",
  "ja498:8.4": "disvā patīto sumano 'ham asmīti. ",
  "ja498:9.1": "Āsanaṃ udakaṃ pajjaṃ ",
  "ja498:9.2": "patigaṇhātu no bhavaṃ, ",
  "ja498:9.3": "agghe bhavantaṃ pucchāma, ",
  "ja498:9.4": "agghaṃ kurutu no bhavanti. ",
  "ja498:10.1": "Rammañ ca te āvasathaṃ karontu, ",
  "ja498:10.2": "nārīgaṇehi paricārayassu, ",
  "ja498:10.3": "karohi okāsam anuggahāya, ",
  "ja498:10.4": "ubho p' imaṃ issariyaṃ karomāti. ",
  "ja498:11.1": "Disvā phalaṃ duccaritassa rāja ",
  "ja498:11.2": "atho suciṇṇassa mahāvipākaṃ ",
  "ja498:11.3": "attānam eva paṭisaññamissaṃ, ",
  "ja498:11.4": "na patthaye puttaṃ pasuṃ dhanaṃ vā. ",
  "ja498:12.1": "Das' ev' imā vassadasā ",
  "ja498:12.2": "maccānaṃ idha jīvitaṃ, ",
  "ja498:12.3": "appattaṃ ñeva taṃ odhiṃ ",
  "ja498:12.4": "nalo chinno va sussati. ",
  "ja498:13.1": "Tattha kā nandikā khiḍḍā ",
  "ja498:13.2": "kā rati kā dhanesanā, ",
  "ja498:13.3": "kim me puttehi dārehi, ",
  "ja498:13.4": "rāja mutto 'smi bandhanā. ",
  "ja498:14.1": "So ahaṃ su-ppajānāmi, ",
  "ja498:14.2": "maccu me na-ppamajjati, ",
  "ja498:14.3": "antakenādhipannassa ",
  "ja498:14.4": "kā rati kā dhanesanā. ",
  "ja498:15.1": "Jātī narānaṃ adhamā janinda ",
  "ja498:15.2": "caṇḍālayonī dipadākaniṭṭhā, ",
  "ja498:15.3": "sakehi kammehi supāpakehi ",
  "ja498:15.4": "caṇḍālagabbhe avasimha pubbe. ",
  "ja498:16.1": "Caṇḍālāhumha Avantīsu ",
  "ja498:16.2": "migā Nerañjaraṃ pati ",
  "ja498:16.3": "ukkusā Nammadātīre, ",
  "ja498:16.4": "ty-ajja brāhmaṇakhattiyā. ",
  "ja498:17.1": "Upanīyatī jīvitaṃ appamāyu, (cfr. Saṃyutta- I p.2) ",
  "ja498:17.2": "jarūpanītassa na santi tāṇā, ",
  "ja498:17.3": "karohi Pañcāla mam' eta vākyaṃ, ",
  "ja498:17.4": "mā kāsi kammāni dukkhudrayāni. ",
  "ja498:18.1": "Upanīyatī jīvitam appamāyu, ",
  "ja498:18.2": "jarūpanītassa na santi tāṇā, ",
  "ja498:18.3": "karohi Pañcāla mam' ete vākyaṃ, ",
  "ja498:18.4": "mā kāsi kammāni dukkhapphalāni. ",
  "ja498:19.1": "Upanīyatī jīvitam appamāyu, ",
  "ja498:19.2": "jarūpanītassa na santi tāṇā, ",
  "ja498:19.3": "karohi Pañcāla mam' eta vākyaṃ, ",
  "ja498:19.4": "mā kāsi kammāni rajassirāni. ",
  "ja498:20.1": "Upanīyatī jīvitam appamāyu, ",
  "ja498:20.2": "vaṇṇaṃ jarā hanti narassa jīyato ",
  "ja498:20.3": "karohi Pañcāla mam' eta vākyaṃ, ",
  "ja498:20.4": "mā kāsi kammaṃ nirayūpapattiyāti. ",
  "ja498:21.1": "Addhā hi saccaṃ vacanaṃ tav' etaṃ, ",
  "ja498:21.2": "yathā isī bhāsasi evam etaṃ, ",
  "ja498:21.3": "kāmā ca me santi anapparūpā, ",
  "ja498:21.4": "te duccajā mādisakena bhikkhu. ",
  "ja498:22.1": "Nāgo yathā paṃkamajjhe vyasanno ",
  "ja498:22.2": "passaṃ thalaṃ nābhisambhoti gantuṃ ",
  "ja498:22.3": "evam p' ahaṃ kāmapaṃke vyasanno ",
  "ja498:22.4": "na bhikkhuno maggam anubbajāmi. ",
  "ja498:23.1": "Yathāpi mātā ca pitā ca puttam ",
  "ja498:23.2": "anusāsare kinti sukhī bhaveyya ",
  "ja498:23.3": "evam pi maṃ tvaṃ anusāsa bhante ",
  "ja498:23.4": "yam ācaraṃ pecca sukhī bhaveyyanti. ",
  "ja498:24.1": "No ce tuvaṃ ussahase janinda ",
  "ja498:24.2": "kāme ime mānusake pahātuṃ ",
  "ja498:24.3": "dhammaṃ baliṃ paṭṭhapayassu rāja ",
  "ja498:24.4": "adhammakāro ca te mā hu raṭṭhe. ",
  "ja498:25.1": "Dūtā vidhāvantu disā catasso ",
  "ja498:25.2": "nimantakā samaṇabrāhmaṇānaṃ, ",
  "ja498:25.3": "te annapānena upaṭṭhahassu ",
  "ja498:25.4": "vatthena senāsanapaccayena ca. ",
  "ja498:26.1": "Annena pānena pasannacitto ",
  "ja498:26.2": "santappaya samaṇabrāhmaṇe ca, ",
  "ja498:26.3": "datvā ca bhutvā ca yathānubhāvaṃ ",
  "ja498:26.4": "anindito saggam upeti ṭhānaṃ. ",
  "ja498:27.1": "Sace ca taṃ rāja mado saheyya ",
  "ja498:27.2": "nārīgaṇehi paricārayantaṃ ",
  "ja498:27.3": "imam eva gāthaṃ manasīkarohi ",
  "ja498:27.4": "bhāsehi c' enaṃ parisāya majjhe: ",
  "ja498:28.1": "Abbhokāsasayo jantu ",
  "ja498:28.2": "vajantyā khīrapāyito ",
  "ja498:28.3": "parikiṇṇo supānehi ",
  "ja498:28.4": "sv-ājja rājāti vuccatīti. ",
  "ja498:29.1": ""
}
