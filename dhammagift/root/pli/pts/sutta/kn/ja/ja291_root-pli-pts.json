  "ja291:0.4": "",
  "ja291:1.1": "Sabbakāmadadaṃ kumbhaṃ ",
  "ja291:1.2": "kuṭaṃ laddhāna dhuttako ",
  "ja291:1.3": "yāva so anupāleti ",
  "ja291:1.4": "tāva so sukham edhati. ",
  "ja291:2.1": "Yadā matto ca ditto ca ",
  "ja291:2.2": "pamādā kumbham abbhidā ",
  "ja291:2.3": "tadā naggo ca pottho ca ",
  "ja291:2.4": "pacchā bālo vihaññati. ",
  "ja291:3.1": "Evam eva yo dhanaṃ laddhā ",
  "ja291:3.2": "amatto paribhuñjati ",
  "ja291:3.3": "pacchā tappati dummedho ",
  "ja291:3.4": "kuṭaṃ bhinno va dhuttakoti Bārāṇassaṃ ",
  "ja291:4.1": ""
}
