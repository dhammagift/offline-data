  "ja459:0.4": "",
  "ja459:1.1": "Mitto mittassa pānīyaṃ ",
  "ja459:1.2": "adinnaṃ paribhuñjisaṃ, ",
  "ja459:1.3": "tena pacchā vijigucchiṃ ",
  "ja459:1.4": "taṃ pāpaṃ pakatam mayā, ",
  "ja459:1.5": "mā puna akaraṃ pāpaṃ ",
  "ja459:1.6": "tasmā pabbajito ahaṃ. ",
  "ja459:2.1": "Paradārañ ca disvāna ",
  "ja459:2.2": "chando me udapajjatha, ",
  "ja459:2.3": "tena pacchā vijigucchiṃ ",
  "ja459:2.4": "taṃ pāpaṃ pakatam mayā, ",
  "ja459:2.5": "mā puna akaraṃ pāpaṃ ",
  "ja459:2.6": "tasmā pabbajito ahaṃ. ",
  "ja459:3.1": "Pitaraṃ me mahārāja ",
  "ja459:3.2": "corā agaṇhuṃ kānane, ",
  "ja459:3.3": "tes' āhaṃ pucchito jānaṃ ",
  "ja459:3.4": "aññathā naṃ viyākariṃ, ",
  "ja459:4.1": "tena pacchā ",
  "ja459:4.2": "",
  "ja459:4.3": "",
  "ja459:4.4": "--pe--. ",
  "ja459:5.1": "Pāṇātipātam akaruṃ ",
  "ja459:5.2": "somayāge upaṭṭhite, ",
  "ja459:5.3": "tes' āhaṃ samanuññāsiṃ, ",
  "ja459:6.1": "tena pacchā vijigucchiṃ ",
  "ja459:6.2": "--pe--. ",
  "ja459:6.3": "",
  "ja459:6.4": "",
  "ja459:7.1": "Surāmerayamadhukā ",
  "ja459:7.2": "ye janā paṭham' āsu no ",
  "ja459:7.3": "bahunnaṃ te anatthāya ",
  "ja459:7.4": "majjapānam akappayuṃ, ",
  "ja459:7.5": "",
  "ja459:8.1": "",
  "ja459:8.2": "",
  "ja459:8.3": "",
  "ja459:8.4": "",
  "ja459:9.1": "Dhi-r-atthu subahū kāme ",
  "ja459:9.2": "duggandhe bahukaṇṭake ",
  "ja459:9.3": "ye aham patisevanto ",
  "ja459:9.4": "na labhiṃ tādisaṃ sukhamti ",
  "ja459:10.1": "Mahassādā sukhā kāmā, ",
  "ja459:10.2": "n' atthi kāmaparaṃ sukhaṃ, ",
  "ja459:10.3": "ye kāme patisevanti ",
  "ja459:10.4": "saggan te upapajjareti. ",
  "ja459:11.1": "Appassādā dukkhā kāmā, ",
  "ja459:11.2": "n' atthi kāmaparaṃ dukhaṃ, ",
  "ja459:11.3": "ye kāme patisevanti ",
  "ja459:11.4": "nirayan te upapajjare. ",
  "ja459:12.1": "Asi yathā sunisito ",
  "ja459:12.2": "nettiṃso va supāyiko ",
  "ja459:12.3": "sattīva urasī khitto -- ",
  "ja459:12.4": "kāmā dukkhatarā tato. ",
  "ja459:13.1": "Aṅgārānaṃ va jalitaṃ ",
  "ja459:13.2": "kāsuṃ sādhikaporisaṃ ",
  "ja459:13.3": "phālaṃ va divasaṃtattaṃ -- ",
  "ja459:13.4": "kāmā dukkhatarā tato. ",
  "ja459:14.1": "Visaṃ yathā halāhalaṃ ",
  "ja459:14.2": "telam ukkaṭṭhitaṃ yathā ",
  "ja459:14.3": "tambalohavilīnaṃ va -- ",
  "ja459:14.4": "kāmā dukkhatarā tatoti. Mittāmaccaparibbūḷhaṃ ",
  "ja459:15.1": ""
}
