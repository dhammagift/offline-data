  "ja309:1.1": "",
  "ja309:1.2": "ubho dhammaṃ na passati, ",
  "ja309:1.3": "ubho pakatiyā cutā ",
  "ja309:1.4": "yo cāyaṃ sajjhāpayati ",
  "ja309:1.5": "yo ca dhammaṃ adhīyatīti. (cfr. Vinaya IV p.204; Dhp. p. 215,28) ",
  "ja309:2.1": "Sālīnaṃ bhojanaṃ bhuñje ",
  "ja309:2.2": "suciṃ maṃsūpasecanaṃ, ",
  "ja309:2.3": "tasmā etaṃ na sevāmi ",
  "ja309:2.4": "dhammaṃ isibhi sevitanti. ",
  "ja309:3.1": "Paribbaja, mahā loko, ",
  "ja309:3.2": "pacant' aññe pi pāṇino, ",
  "ja309:3.3": "mā tvaṃ adhammo ācarito ",
  "ja309:3.4": "asmā kumbham ivībhida. ",
  "ja309:4.1": "Dhi-r-atthu taṃ yasalābhaṃ ",
  "ja309:4.2": "dhanalābhañ ca brāhmaṇa ",
  "ja309:4.3": "yā vutti vinipātena ",
  "ja309:4.4": "adhammacaraṇena vāti. ",
  "ja309:5.1": ""
}
