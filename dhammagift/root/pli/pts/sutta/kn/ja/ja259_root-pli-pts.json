  "ja259:0.4": "",
  "ja259:1.1": "Na-y-imassa vijjāmayam atthi kiñci ",
  "ja259:1.2": "na bandhavo no pana te sahāyo, ",
  "ja259:1.3": "atha kena vaṇṇena Tirīṭavaccho ",
  "ja259:1.4": "tedaṇḍiko bhuñjati aggapiṇḍanti. ",
  "ja259:2.1": "Āpāsu me yuddhaparājitassa ",
  "ja259:2.2": "ekassa katvā vivanasmi ghore ",
  "ja259:2.3": "pasārayi kicchagatassa pāṇim, ",
  "ja259:2.4": "ten' ūdatāriṃ dukhasampareto. ",
  "ja259:3.1": "Etassa kiccena idhānupatto ",
  "ja259:3.2": "Vesāyino visayā jīvaloke, ",
  "ja259:3.3": "lābhāraho tāta Tirīṭavaccho, ",
  "ja259:3.4": "deth' assa bhogaṃ yajatañ ca yaññanti. Yass' atthā dūram āyanti amittam api ",
  "ja259:4.1": ""
}
