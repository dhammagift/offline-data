{
  "ja522:0.1": "",
  "ja522:0.2": "",
  "ja522:0.3": "",
  "ja522:0.4": "",
  "ja522:1.1": "kuṇḍalino suvatthā ",
  "ja522:1.2": "veluriyamuttā tharukhaggabaddhā ",
  "ja522:1.3": "rathesabhā tiṭṭhatha, ke nu tumhe, ",
  "ja522:1.4": "kathaṃ vo jānanti manussaloketi. ",
  "ja522:2.1": "Aham Aṭṭhako, Bhīmaratho panāyaṃ, ",
  "ja522:2.2": "Kāliṅgarājā pana uggato ayaṃ, ",
  "ja522:2.3": "susaññatān' isinaṃ dassanāya ",
  "ja522:2.4": "idhāgatā pucchitāyemha pañheti. ",
  "ja522:3.1": "Vehāsayaṃ tiṭṭhati antalikkhe ",
  "ja522:3.2": "pathaddhuno paṇṇarase va cando, (IV 384|20) ",
  "ja522:3.3": "pucchāmi taṃ yakkha mahānubhāva: ",
  "ja522:3.4": "kathaṃ naṃ jānanti manussaloketi. ",
  "ja522:4.1": "Yam āhu devesu Sujampatīti (IV 403|27) ",
  "ja522:4.2": "Maghavāti naṃ āhu manussaloke, ",
  "ja522:4.3": "sa devarājā idam ajja patto ",
  "ja522:4.4": "susaññatān' isinaṃ dassanāyāti. ",
  "ja522:5.1": "Dūre sutā no isayo samāgatā ",
  "ja522:5.2": "mahiddhikā iddhiguṇūpapannā, ",
  "ja522:5.3": "vandāmi te ayire pasannacitto ",
  "ja522:5.4": "ye jīvalok' ettha manussaseṭṭhāti. ",
  "ja522:6.1": "Gandho isīnaṃ ciradakkhitānaṃ ",
  "ja522:6.2": "kāyā cuto gacchati mālutena, ",
  "ja522:6.3": "ito parakkamma sahassanetta ",
  "ja522:6.4": "gandho isīnaṃ asuci devarājāti. ",
  "ja522:7.1": "Gandho isīnaṃ ciradakkhitānaṃ ",
  "ja522:7.2": "kāyā cuto gacchatu mālutena, ",
  "ja522:7.3": "vicitrapupphaṃ surabhiṃ va mālaṃ ",
  "ja522:7.4": "gandhaṃ etaṃ pāṭikaṃkhāma bhante, ",
  "ja522:7.5": "na h' ettha devā paṭikkūlasaññinoti. ",
  "ja522:8.1": "Purindado bhūtapatī yasassī ",
  "ja522:8.2": "devānaṃ indo Maghavā Sujampati ",
  "ja522:8.3": "sa devarājā Asura[gaṇa]ppamaddano okāsam ",
  "ja522:8.4": "ākaṃkhati pañha pucchituṃ. ",
  "ja522:9.1": "Ko n' ev' imesaṃ idha paṇḍitānaṃ ",
  "ja522:9.2": "pañhe puṭho nipuṇe vyākarissati, tiṇṇaṃ ",
  "ja522:9.3": "ca raññaṃ manujādhipānaṃ ",
  "ja522:9.4": "devānam indassa ca Vāsavassāti. ",
  "ja522:10.1": "Ayaṃ isī Sarabhaṅgo tapassī ",
  "ja522:10.2": "yato jāto virato methunasmā ",
  "ja522:10.3": "ācariyaputto suvinītarūpo ",
  "ja522:10.4": "so nesaṃ pañhāni viyākarissatīti g. ā. ",
  "ja522:11.1": "Koṇḍañña pañhāni viyākarohi,(cfr. Sumaṅgala - I155|17) ",
  "ja522:11.2": "yācanti taṃ isayo sādhurūpā, ",
  "ja522:11.3": "Koṇḍañña eso manujesu dhammo ",
  "ja522:11.4": "yaṃ vaddham āgacchati esa bhāroti. ",
  "ja522:12.1": "Katāvakāsā pucchantu bhonto ",
  "ja522:12.2": "yaṃ kiñci pañhaṃ manasābhipatthitaṃ, ",
  "ja522:12.3": "ahaṃ hi taṃ taṃ vo viyākarissaṃ ",
  "ja522:12.4": "ñatvā sayaṃ lokaṃ imaṃ parañ cāti. ",
  "ja522:13.1": "Tato ca Maghavā Sakko ",
  "ja522:13.2": "atthaddassī purindado ",
  "ja522:13.3": "apucchi paṭhamaṃ pañhaṃ ",
  "ja522:13.4": "yañcāsi abhipatthitaṃ: ",
  "ja522:14.1": "Kiṃ sū vadhitvā na kadāci socati, ",
  "ja522:14.2": "kissa-ppahānaṃ isayo vaṇṇayanti, ",
  "ja522:14.3": "kass' īdha vuttaṃ pharusaṃ khametha, ",
  "ja522:14.4": "akkhāhi me Koṇḍañña etam atthanti. ",
  "ja522:15.1": "Kodhaṃ vadhitvā na kadāci socati, ",
  "ja522:15.2": "makkhappahānaṃ isayo vaṇṇayanti, ",
  "ja522:15.3": "sabbesaṃ vuttaṃ pharusaṃ khametha, ",
  "ja522:15.4": "etaṃ khantiṃ uttamam āhu santoti āha. ",
  "ja522:16.1": "Sakkā hi dvinnaṃ vacanaṃ titikkhituṃ ",
  "ja522:16.2": "sadisassa vā seṭṭhanarassa vāpi, ",
  "ja522:16.3": "kathan nu hīnassa vaco khametha, ",
  "ja522:16.4": "akkhāhi me Koṇḍañña etam atthaṃ. ",
  "ja522:17.1": "Bhayā hi seṭṭhassa vaco khametha ",
  "ja522:17.2": "sārambhahetu pana sādisassa, ",
  "ja522:17.3": "",
  "ja522:17.4": "",
  "ja522:18.1": "Kathaṃ vijaññā catumaṭṭharūpaṃ ",
  "ja522:18.2": "seṭṭhaṃ sarikkhaṃ athavāpi hīnaṃ, ",
  "ja522:18.3": "virūparūpena caranti santo, ",
  "ja522:18.4": "tasmā hi sabbesaṃ vaco khamethāti g. ā. ",
  "ja522:19.1": "Na h' etam atthaṃ mahatī hi senā ",
  "ja522:19.2": "sarājikā yujjhamānā labhetha ",
  "ja522:19.3": "Subhāsitan ",
  "ja522:19.4": "",
  "ja522:20.1": "te anumodiyānaṃ ",
  "ja522:20.2": "aññaṃ taṃ pucchāmi, tad iṃgha brūhi, ",
  "ja522:20.3": "yathā ahū Daṇḍakī Nāḷikīro ",
  "ja522:20.4": "ath'Ajjuno Kalābu cāpi rājā ",
  "ja522:20.5": "tesaṃ gatiṃ brūhi supāpakamminaṃ ",
  "ja522:20.6": "katth' ūpapannā isinaṃ viheṭhakāti g. ā. ",
  "ja522:21.1": "Kisam pi Vacchaṃ avakiriya Daṇḍakī ",
  "ja522:21.2": "ucchinnamūlo sajano saraṭṭho ",
  "ja522:21.3": "Kukkulanāme nirayamhi paccati, ",
  "ja522:21.4": "tassa pulliṅgāni patanti kāye. ",
  "ja522:22.1": "Yo saññate pabbajite avañcasi ",
  "ja522:22.2": "dhammaṃ bhaṇante samaṇe adūsake ",
  "ja522:22.3": "taṃ Nāḷikīraṃ sunakhā parattha ",
  "ja522:22.4": "saṃgamma khādanti viphandamānaṃ. ",
  "ja522:23.1": "Ath' Ajjuno niraye sattisūle ",
  "ja522:23.2": "avaṃsiro patito addhapādo ",
  "ja522:23.3": "",
  "ja522:23.4": "",
  "ja522:24.1": "Yo khaṇḍaso pabbajitaṃ achedayi ",
  "ja522:24.2": "khantiṃ vadantaṃ samaṇaṃ adūsakaṃ ",
  "ja522:24.3": "Kalābu vīcim upapajja paccati ",
  "ja522:24.4": "mahābhitāpaṃ kaṭukaṃ bhayānakaṃ. ",
  "ja522:25.1": "Etāni sutvā nirayāni paṇḍito ",
  "ja522:25.2": "aññāni pāpiṭṭhatarāni c' ettha ",
  "ja522:25.3": "dhammaṃ care samaṇabrāhmaṇesu, ",
  "ja522:25.4": "evaṃkaro saggam upeti ṭhānanti. ",
  "ja522:26.1": "Subhāsitan te anumodiyānaṃ ",
  "ja522:26.2": "aññaṃ taṃ pucchāmi, tad iṃgha brūhi, ",
  "ja522:26.3": "kathaṃvidhaṃ sīlavantaṃ vadanti, ",
  "ja522:26.4": "kathaṃvidhaṃ paññāvantaṃ vadanti, ",
  "ja522:26.5": "kathaṃvidhaṃ sappurisaṃ vadanti, ",
  "ja522:26.6": "kathaṃvidhaṃ no siri no jahātīti. ",
  "ja522:27.1": "Kāyena vācāya ca yo ca saññato ",
  "ja522:27.2": "manasā ca kiñci na karoti pāpaṃ ",
  "ja522:27.3": "na attahetu alikaṃ bhaṇāti ",
  "ja522:27.4": "tathāvidhaṃ sīlavantaṃ vadanti. ",
  "ja522:28.1": "Gambhīrapañhaṃ manasābhicintayaṃ ",
  "ja522:28.2": "nāccāhitaṃ kamma karoti luddaṃ ",
  "ja522:28.3": "(IV 46|24) kālābhataṃ atthapadaṃ na riñcati ",
  "ja522:28.4": "tathāvidhaṃ paññavantaṃ vadanti. ",
  "ja522:29.1": "Yo ve kataññū katavedi dhīro ",
  "ja522:29.2": "kalyāṇamitto daḷhabhatti ca hoti ",
  "ja522:29.3": "dukhitassa sakkacca karoti kiccaṃ ",
  "ja522:29.4": "tathāvidhaṃ sappurisaṃ vadanti. ",
  "ja522:30.1": "Etehi sabbehi guṇeh' upeto ",
  "ja522:30.2": "saddho mudū saṃvibhāgī vadaññū -- ",
  "ja522:30.3": "saṃgāhakaṃ sakhilaṃ saṇhavācaṃ (IV 110|19) ",
  "ja522:30.4": "tathāvidhaṃ no siri no jahātīti. ",
  "ja522:31.1": "Subhāsitan te anumodiyānaṃ ",
  "ja522:31.2": "aññaṃ taṃ pucchāmi, tad iṃgha brūhi, ",
  "ja522:31.3": "sīlaṃ sirī cāpi satañ ca dhammā paññā ",
  "ja522:31.4": "ca -- kaṃ seṭṭhataraṃ vadanti. ",
  "ja522:32.1": "Paññā hi seṭṭhā kusalā vadanti ",
  "ja522:32.2": "(III 348|18) nakkhattarājā-r-iva tārakānaṃ, ",
  "ja522:32.3": "sīlaṃ sirī cāpi satañ ca dhammā ",
  "ja522:32.4": "anvāyikā paññavato bhavanti. ",
  "ja522:33.1": "Subhāsitan te anumodiyānaṃ ",
  "ja522:33.2": "aññaṃ taṃ pucchāmi, tad iṃgha brūhi, ",
  "ja522:33.3": "kathaṃkaro kintikaro kiṃ ācaraṃ (IV 339|25) ",
  "ja522:33.4": "kiṃ sevamāno labhatīdha paññaṃ, ",
  "ja522:33.5": "paññayā dāni paṭipadaṃ vadehi, ",
  "ja522:33.6": "kathaṃkaro paññavā hoti macco. ",
  "ja522:34.1": "Sevetha vaddhe nipuṇe bahussute, ",
  "ja522:34.2": "uggāhako vā paripucchako siyā, ",
  "ja522:34.3": "suṇeyya sakkacca sabhāsitāni, ",
  "ja522:34.4": "evaṃkaro paññavā hoti macco. ",
  "ja522:35.1": "Sa paññavā kāmaguṇe avekkhati ",
  "ja522:35.2": "aniccato dukkhato rogato ca, ",
  "ja522:35.3": "evaṃvipassī pajahāti chandaṃ ",
  "ja522:35.4": "dukkhesu kāmesu mahabbhayesu. ",
  "ja522:36.1": "Sa vītarāgo pavineyya dosaṃ, ",
  "ja522:36.2": "mettaṃ cittaṃ bhāvaye appamāṇaṃ, ",
  "ja522:36.3": "sabbesu bhūtesu nidhāya daṇḍaṃ (IV 452|23) ",
  "ja522:36.4": "anindito Brahmam upeti ṭhānanti. ",
  "ja522:37.1": "Mahiddhiyaṃ āgamanaṃ ahosi ",
  "ja522:37.2": "tava-m-Aṭṭhakā Bhīmarathassa cāpi ",
  "ja522:37.3": "Kāliṅgarājassa ca uggatassa, ",
  "ja522:37.4": "sabbesaṃ vo kāmarāgo pahīnoti g. ā. ",
  "ja522:38.1": "Evam etaṃ paracittavedi: ",
  "ja522:38.2": "sabbesaṃ no kāmarāgo pahīno, ",
  "ja522:38.3": "karohi okāsam anuggahāya ",
  "ja522:38.4": "yathā gatiṃ te abhisambhavemāti g. āhaṃsu. ",
  "ja522:39.1": "Karohi okāsam anuggahāya ",
  "ja522:39.2": "tathā hi vo kāmarāgo pahīno, ",
  "ja522:39.3": "pharātha kāyaṃ vipulāya pītiyā ",
  "ja522:39.4": "yathā gatiṃ me abhisambhavethāti. ",
  "ja522:40.1": "Sabbaṃ karissāma tavānusāsaniṃ ",
  "ja522:40.2": "yaṃ yaṃ tuvaṃ vakkhasi bhūripañña, ",
  "ja522:40.3": "pharāma kāyaṃ vipulāyā pītiyā ",
  "ja522:40.4": "yathā gatiṃ te abhisambhavemāti g. ",
  "ja522:41.1": "āhaṃsu. Katāyaṃ Vacchassa Kisassa pūjā, ",
  "ja522:41.2": "gacchantu bhonto isayo sādhurūpā, ",
  "ja522:41.3": "jhāne ratā bhotha sadā samāhitā, ",
  "ja522:41.4": "esā ratī pabbajitassa seṭṭhāti g. ā. ",
  "ja522:42.1": "Sutvāna gāthā paramatthasaṃhitā ",
  "ja522:42.2": "subhāsitā isinā paṇḍitena ",
  "ja522:42.3": "te vedajātā anumodamānā ",
  "ja522:42.4": "pakkāmu devā devapuraṃ yasassino. ",
  "ja522:43.1": "Gāthā imā atthavatī suvyañjanā ",
  "ja522:43.2": "subhāsitā isinā paṇḍitena, ",
  "ja522:43.3": "yo koc' imā aṭṭhikatvā suṇeyya ",
  "ja522:43.4": "labhetha pubbāpariyaṃ visesaṃ, ",
  "ja522:43.5": "laddhāna pubbāpariyaṃ visesaṃ ",
  "ja522:43.6": "adassanaṃ maccurājassa gaccheti. ",
  "ja522:44.1": "Sālissaro Sāriputto ",
  "ja522:44.2": "Meṇḍissaro ca Kassapo ",
  "ja522:44.3": "Pabbato Anuruddho ca ",
  "ja522:44.4": "Kaccāyano ca Devalo ",
  "ja522:45.1": "Anusisso ca Anando ",
  "ja522:45.2": "Kisavaccho ca Kolito ",
  "ja522:45.3": "",
  "ja522:45.4": "",
  "ja522:45.5": "Sarabhaṅgo Bodhisatto, ",
  "ja522:45.6": "evaṃ dhāretha jātakanti āha. Ath' abravī ",
  "ja522:46.1": ""
}
