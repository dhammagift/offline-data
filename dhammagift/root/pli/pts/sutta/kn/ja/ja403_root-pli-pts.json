  "ja403:0.4": "",
  "ja403:1.1": "Ye 'me ahaṃ na jānāmi ",
  "ja403:1.2": "Aṭṭhisena vanibbake ",
  "ja403:1.3": "te maṃ saṃgamma yācanti, ",
  "ja403:1.4": "kasmā maṃ tvaṃ na yācasīti. ",
  "ja403:2.1": "Yācako appiyo hoti, ",
  "ja403:2.2": "yācaṃ adadam appiyo, ",
  "ja403:2.3": "tasmāhaṃ taṃ na yācāmi, ",
  "ja403:2.4": "mā me viddesanā ahūti. ",
  "ja403:3.1": "Yo ca yācanajīvāno ",
  "ja403:3.2": "kāle yācaṃ na yācati ",
  "ja403:3.3": "parañ ca puññā dhaṃseti ",
  "ja403:3.4": "attanāpi na jīvati. ",
  "ja403:4.1": "Yo ca yācanajīvāno ",
  "ja403:4.2": "kāle yācāni yācati ",
  "ja403:4.3": "parañ ca puññaṃ labbheti ",
  "ja403:4.4": "attanāpi ca jīvati. ",
  "ja403:5.1": "Na ve dissanti sappaññā ",
  "ja403:5.2": "disvā yācakamāgate, ",
  "ja403:5.3": "brahmacāri piyo me si, ",
  "ja403:5.4": "vara tvaṃ bhaññam icchasīti. ",
  "ja403:6.1": "Na ve yācanti sappaññā, ",
  "ja403:6.2": "dhīro ca viditum arahati, ",
  "ja403:6.3": "uddissa ariyā tiṭṭhanti, ",
  "ja403:6.4": "esā ariyānaṃ yācanāti. ",
  "ja403:7.1": "Dadāmi te brāhmaṇa rohiṇīnaṃ (Cfr. supra p.81.) ",
  "ja403:7.2": "gavaṃ sahassaṃ saha puṅgavena, ",
  "ja403:7.3": "ariyo hi ariyassa kathaṃ na dajjā ",
  "ja403:7.4": "sutvāna gāthā tava dhammayuttāti. ",
  "ja403:8.1": ""
}
