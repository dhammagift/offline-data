  "ja305:0.4": "",
  "ja305:1.1": "N' atthi loke raho nāma ",
  "ja305:1.2": "pāpakammaṃ pakubbato, ",
  "ja305:1.3": "passanti vanabhūtāni, ",
  "ja305:1.4": "taṃ bālo maññatī raho. ",
  "ja305:2.1": "Ahaṃ raho na passāmi, ",
  "ja305:2.2": "suññaṃ vāpi na vijjati, ",
  "ja305:2.3": "yattha aññaṃ na passāmi ",
  "ja305:2.4": "asuññaṃ hoti tam mayāti. ",
  "ja305:3.1": "Dujjacco ca ajacco ca ",
  "ja305:3.2": "nando ca sukhavacchano ",
  "ja305:3.3": "vajjho addhuvasīlo ca ",
  "ja305:3.4": "te dhammaṃ jahum atthikā. ",
  "ja305:4.1": "Brāhmaṇo ca kathaṃ jahe ",
  "ja305:4.2": "sabbadhammāna pāragū ",
  "ja305:4.3": "yo dhammam anupāleti ",
  "ja305:4.4": "dhitimā saccanikkamoti. ",
  "ja305:5.1": ""
}
