  "ja479:0.4": "",
  "ja479:1.1": "Rājā Kāliṅgo cakkavattī ",
  "ja479:1.2": "dhammena paṭhavim anusāsaṃ ",
  "ja479:1.3": "agamā Bodhisamīpam ",
  "ja479:1.4": "nāgena mahānubhāvenāti. ",
  "ja479:2.1": "Kāliṅgabhāradvājo ",
  "ja479:2.2": "rājānaṃ Kāliṅgaṃ samaṇakolaññaṃ ",
  "ja479:2.3": "cakkaṃ vattayato pariṇetvā ",
  "ja479:2.4": "pañjalī idam avoca: ",
  "ja479:3.1": "Paccoroha mahārāja, ",
  "ja479:3.2": "bhūmibhāgo yathā samanugīto, ",
  "ja479:3.3": "idha anadhivarā Buddhā ",
  "ja479:3.4": "abhisambuddhā virocanti. ",
  "ja479:4.1": "Padakkhiṇato āvattā ",
  "ja479:4.2": "tiṇalatā asmiṃ bhūmibhāgasmiṃ, ",
  "ja479:4.3": "puthaviyāyaṃ maṇḍo, ",
  "ja479:4.4": "iti no sutaṃ mahārāja. ",
  "ja479:5.1": "Sāgarapariyantāya ",
  "ja479:5.2": "mediniyā sabbabhūtadharaṇiyā ",
  "ja479:5.3": "puthaviyāyaṃ maṇḍo, ",
  "ja479:5.4": "orohitvā namo karohi. ",
  "ja479:6.1": "Ye te bhavanti nāgā ",
  "ja479:6.2": "abhijātā mātito ca pitito ca ",
  "ja479:6.3": "ettāvatā padesaṃ te ",
  "ja479:6.4": "nāgā n' eva-m-upayanti. ",
  "ja479:7.1": "Abhijāto te nāgo, kāmaṃ ",
  "ja479:7.2": "pesehi kuñjaraṃ dantiṃ ",
  "ja479:7.3": "ettāvatā padeso ",
  "ja479:7.4": "sakkā nāgena-m-upagantuṃ. ",
  "ja479:8.1": "Taṃ sutvā rājā Kāliṅgo ",
  "ja479:8.2": "veyyañjaniyavaco nisāmetvā ",
  "ja479:8.3": "sampesesi nāgaṃ, ñassāma ",
  "ja479:8.4": "mayaṃ yathā idaṃ vacanaṃ. ",
  "ja479:9.1": "Sampesito va rañña ",
  "ja479:9.2": "ñāgo koñco va ānaditvā ",
  "ja479:9.3": "paṭisakkitvā nisīdi ",
  "ja479:9.4": "garubhāram asahamānoti. ",
  "ja479:10.1": "Kāliṅgabhāradvājo ",
  "ja479:10.2": "nāgaṃ khīṇāyukaṃ viditvā ",
  "ja479:10.3": "rājānaṃ Kāliṅgaṃ ",
  "ja479:10.4": "taramāno ajjhabhāsittha: ",
  "ja479:10.5": "aññaṃ saṃkama nāgaṃ, ",
  "ja479:10.6": "nāgo khīṇāyuko mahārājāti. ",
  "ja479:11.1": "Taṃ sutvā Kāliṅgo ",
  "ja479:11.2": "taramāno saṃkami nāgaṃ, ",
  "ja479:11.3": "saṃkante ca rañño ",
  "ja479:11.4": "nāgo tatth' eva pati bhumyā, ",
  "ja479:11.5": "veyyañjaniyavaco ",
  "ja479:11.6": "yathā tathā ahu nāgoti. Kāliṅgabhāradvājaṃ ",
  "ja479:12.1": "Kāliṅgo ",
  "ja479:12.2": "brāhmaṇaṃ idam avoca: ",
  "ja479:12.3": "tvam evāsi sambuddho ",
  "ja479:12.4": "sabbaññū sabbadassāvīti. ",
  "ja479:13.1": "Taṃ vacanaṃ anadhivāsento ",
  "ja479:13.2": "Kāliṅgabrāhmaṇo idam avoca: ",
  "ja479:13.3": "veyyañjaniyā mayaṃ, ",
  "ja479:13.4": "buddhā sabbaññuno va mahārāja. ",
  "ja479:14.1": "Sabbaññū sabbavidū ca ",
  "ja479:14.2": "buddhā lakkhaṇe na jānanti, ",
  "ja479:14.3": "āgamapurisā mayaṃ, ",
  "ja479:14.4": "buddhā sabbaṃ pajānantīti. ",
  "ja479:15.1": "Mahāyitvāna sambodhiṃ ",
  "ja479:15.2": "nānāturiyehi vajjamānehi ",
  "ja479:15.3": "mālāgandhavilepanaṃ āharitvā pākāraparikkhepaṃ kāresi, ",
  "ja479:15.4": "atha rājā pāyāsi. ",
  "ja479:16.1": "Saṭṭhivāhasahassānaṃ ",
  "ja479:16.2": "pupphānaṃ sannipātayi ",
  "ja479:16.3": "pūjesi rājā Kāliṅgo ",
  "ja479:16.4": "Bodhimaṇḍam anuttaranti. ",
  "ja479:17.1": ""
}
