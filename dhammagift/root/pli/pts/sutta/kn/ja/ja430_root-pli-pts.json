  "ja430:1.1": "Santi rukkhā haritapattā ",
  "ja430:1.2": "dumā nekaphalā bahū, ",
  "ja430:1.3": "kasmā nu sukkhe koḷāpe ",
  "ja430:1.4": "sukassa nirato mano. ",
  "ja430:2.1": "Phal' assa upabhuñjimha ",
  "ja430:2.2": "nekavassagaṇe bahū, ",
  "ja430:2.3": "aphalam pi viditvāna ",
  "ja430:2.4": "sā va metti yathā pure. ",
  "ja430:3.1": "Sukkhañ ca rukkhaṃ koḷāpaṃ ",
  "ja430:3.2": "opattam aphalaṃ dumaṃ ",
  "ja430:3.3": "ohāya sakuṇā yanti, ",
  "ja430:3.4": "kiṃ dosaṃ passase dija. ",
  "ja430:4.1": "Ye phalaṭṭhā saṃbhajanti ",
  "ja430:4.2": "aphaloti jahanti naṃ, ",
  "ja430:4.3": "attaṭṭhapaññā dummedhā ",
  "ja430:4.4": "te honti pakkhapātino. ",
  "ja430:5.1": "Sādhu sakkhi kataṃ hoti ",
  "ja430:5.2": "mittaṃ saṃsati santhavo, ",
  "ja430:5.3": "sac' etaṃ dhammaṃ rocesi ",
  "ja430:5.4": "pāsaṃso si vijānataṃ. ",
  "ja430:6.1": "So te suva varaṃ dammi ",
  "ja430:6.2": "pattayāna vihaṅgama, ",
  "ja430:6.3": "varaṃ varassu vakkaṅga ",
  "ja430:6.4": "yaṃ kiñci manas' icchasi. ",
  "ja430:7.1": "Api nāma naṃ passemu ",
  "ja430:7.2": "sapattaṃ saphalaṃ dumaṃ, ",
  "ja430:7.3": "daliddo va nidhiṃ laddhā ",
  "ja430:7.4": "nandeyy' āhaṃ punappunaṃ. ",
  "ja430:8.1": "Tato amatam ādāya ",
  "ja430:8.2": "abhisiñci mahīruhaṃ, ",
  "ja430:8.3": "tassa sākhā virūhiṃsu ",
  "ja430:8.4": "sītacchāyā manoramā. ",
  "ja430:9.1": "Evaṃ Sakka sakhī hohi ",
  "ja430:9.2": "saha sabbehi ñātibhi ",
  "ja430:9.3": "yathāham ajja sukhito ",
  "ja430:9.4": "disvāna saphalaṃ dumaṃ. ",
  "ja430:10.1": "Suvassa ca varaṃ datvā ",
  "ja430:10.2": "katvāna saphalaṃ dumaṃ ",
  "ja430:10.3": "pakkāmi saha bhariyāya ",
  "ja430:10.4": "devānaṃ Nandanaṃ vananti. ",
  "ja430:11.1": ""
}
