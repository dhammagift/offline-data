  "ja386:0.4": "",
  "ja386:1.1": "Saccaṃ kir' evam āhaṃsu ",
  "ja386:1.2": "bhastaṃ bāloti paṇḍitā, ",
  "ja386:1.3": "passa: bālo rahokammaṃ ",
  "ja386:1.4": "āvikubbaṃ na bujjhatīti. ",
  "ja386:2.1": "Tvaṃ ca kho samma bālo si, ",
  "ja386:2.2": "kharaputta vijānahi: ",
  "ja386:2.3": "rajjuyāsi parikkhitto ",
  "ja386:2.4": "vaṃkoṭṭho ohitomukho. ",
  "ja386:3.1": "Aparam pi samma te balyaṃ ",
  "ja386:3.2": "yo mutto na palāyasi, ",
  "ja386:3.3": "so ca bālātaro samma ",
  "ja386:3.4": "yaṃ tvaṃ vahasi Senakanti. ",
  "ja386:4.1": "Yan nu samma ahaṃ bālo ",
  "ja386:4.2": "ajarāja vijānahi, ",
  "ja386:4.3": "atha kena Senako bālo ",
  "ja386:4.4": "taṃ me akkhāhi pucchitoti. ",
  "ja386:5.1": "Uttamatthaṃ labhitvāna ",
  "ja386:5.2": "bhariyā yo padassati ",
  "ja386:5.3": "tena jahissat' attānaṃ ",
  "ja386:5.4": "sā c' ev' assa na hessatīti. ",
  "ja386:6.1": "Na ve ‘piyaṃ meti janinda tādiso ",
  "ja386:6.2": "attaṃ niraṃkatvā piyāni sevati, ",
  "ja386:6.3": "attā va seyyo paramā va seyyo ",
  "ja386:6.4": "labbhā piyā ocitatthena pacchāti. ",
  "ja386:7.1": ""
}
