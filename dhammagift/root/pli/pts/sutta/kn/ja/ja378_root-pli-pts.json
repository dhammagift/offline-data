  "ja378:1.1": "ca kāmā palipā ca kāmā ",
  "ja378:1.2": "bhayañ ca m-etaṃ timūlaṃ pavuttaṃ, ",
  "ja378:1.3": "rajo ca dhūmo ca mayā pakāsitā, ",
  "ja378:1.4": "hitvā tuvaṃ pabbaja Brahmadattāti. ",
  "ja378:2.1": "Gatito ca ratto ca adhimucchito ca ",
  "ja378:2.2": "kāmesv-āhaṃ brāhmaṇa, bhiṃsarūpaṃ ",
  "ja378:2.3": "taṃ n' ussahe jīvikattho pahātuṃ, ",
  "ja378:2.4": "kāhāmi puññani anappakānīti. ",
  "ja378:3.1": "Yo atthakāmassa hitānukampino ",
  "ja378:3.2": "ovajjamāno na karoti sāsanaṃ ",
  "ja378:3.3": "idam eva seyyo iti maññamāno ",
  "ja378:3.4": "punappunaṃ gabbham upeti mando. (Dhp. v. 325.) Ja_6.16 || ",
  "ja378:4.1": "So ghorarūpaṃ nirayaṃ upeti ",
  "ja378:4.2": "subhāsubhaṃ muttakarīsapūraṃ, ",
  "ja378:4.3": "sattā sakāye na jahanti giddhā ",
  "ja378:4.4": "ye honti kāmesu avītarāgāti ",
  "ja378:5.1": "Mīḷhena littā ruhirena makkhitā ",
  "ja378:5.2": "semhena littā upanikkhamanti, ",
  "ja378:5.3": "yaṃ yaṃ hi kāyena phusanti tāvade ",
  "ja378:5.4": "sabbaṃ asātaṃ dukkham eva kevalaṃ. ",
  "ja378:6.1": "Ḍisvā vadāmi na hi aññato savaṃ ",
  "ja378:6.2": "pubbenivāsaṃ bahukaṃ sarāmīti ",
  "ja378:6.3": "Citrāhi gāthāhi subhāsitāhi ",
  "ja378:6.4": "Darīmukho nijjhapayī Sumedhanti. ",
  "ja378:7.1": ""
}
