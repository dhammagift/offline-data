  "ja249:1.1": "Ekaputtako bhavissasi ",
  "ja249:1.2": "tvañ ca no hessasi issaro kule, ",
  "ja249:1.3": "",
  "ja249:1.4": "",
  "ja249:2.1": "Nanu maṃ hadaye 'timaññasi ",
  "ja249:2.2": "yañ ca hanasi maṃ veḷuyaṭṭhiyā, ",
  "ja249:2.3": "pakkambavane ramāmase, ",
  "ja249:2.4": "gaccha tvaṃ gharakaṃ yathāsukhanti. ",
  "ja249:3.1": ""
}
