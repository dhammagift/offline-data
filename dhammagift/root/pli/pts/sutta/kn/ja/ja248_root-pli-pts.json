  "ja248:0.4": "",
  "ja248:1.1": "Sabbehi kiṃsuko diṭṭho, ",
  "ja248:1.2": "kin n' ettha vicikicchatha, ",
  "ja248:1.3": "na hi sabbesu ṭhānesu ",
  "ja248:1.4": "sārathī paripucchitoti. ",
  "ja248:2.1": "Evaṃ sabbehi ñāṇehi ",
  "ja248:2.2": "yesaṃ dhammā ajānitā ",
  "ja248:2.3": "te ve dhammesu kaṃkhanti ",
  "ja248:2.4": "kiṃsukasmiṃ va bhātaroti. ",
  "ja248:3.1": ""
}
