  "ja187:1.1": "Ucce viṭabhiṃ āruyha ",
  "ja187:1.2": "mantayavho rahogatā, ",
  "ja187:1.3": "nīce oruyha mantavho, ",
  "ja187:1.4": "migarājāpi sossatīti. ",
  "ja187:2.1": "Yaṃ supaṇṇo supaṇṇena ",
  "ja187:2.2": "devo devena mantaye ",
  "ja187:2.3": "kiṃ tattha catumaṭṭassa, ",
  "ja187:2.4": "bilaṃ pavisa jambukāti. ",
  "ja187:3.1": ""
}
