  "ja204:1.1": "Api Vīraka passesi ",
  "ja204:1.2": "sakuṇaṃ mañjubhāṇakaṃ ",
  "ja204:1.3": "(Dhp. p.146.) mayūragīvasaṃkāsaṃ ",
  "ja204:1.4": "patiṃ mayhaṃ Saviṭṭhakanti. ",
  "ja204:2.1": "Udakathalacarassa pakkhino ",
  "ja204:2.2": "niccaṃ āmakamacchakabhojino ",
  "ja204:2.3": "tassānukaraṃ Saviṭṭhako ",
  "ja204:2.4": "sevāle paliguṇṭhito matoti. Sobhanti macchā gaṅgeyyā, ",
  "ja204:3.1": ""
}
