  "ja390:0.4": "",
  "ja390:1.1": "Sakuṇo Mayhako nāma ",
  "ja390:1.2": "girīsānudarīcaro ",
  "ja390:1.3": "pakkaṃ pipphalam āruyha ",
  "ja390:1.4": "mayha mayhanti kandati. ",
  "ja390:2.1": "Tass' eva vilapantassa ",
  "ja390:2.2": "dijasaṃghā samāgatā, ",
  "ja390:2.3": "bhutvāna pipphaliṃ yanti, ",
  "ja390:2.4": "vilapi tv-eva so dijo. ",
  "ja390:3.1": "Evam eva idh' ekacco ",
  "ja390:3.2": "saṃgharitvā bahuṃ dhanaṃ ",
  "ja390:3.3": "n' ev' attano na ñātīnaṃ ",
  "ja390:3.4": "yathodhiṃ paṭipajjati. ",
  "ja390:4.1": "Na so acchādanaṃ bhattaṃ ",
  "ja390:4.2": "na mālaṃ na vilepanaṃ ",
  "ja390:4.3": "anubhoti sakiṃ kiñci ",
  "ja390:4.4": "na saṃgaṇhāti ñātake. ",
  "ja390:5.1": "Tass' eva vilapantassa ",
  "ja390:5.2": "mayha mayhanti rakkhato ",
  "ja390:5.3": "rājāno atha vā corā ",
  "ja390:5.4": "dāyādā yeva appiyā ",
  "ja390:5.5": "dhanam ādāya gacchanti, ",
  "ja390:5.6": "vilapi tv-eva so naro. ",
  "ja390:6.1": "Dhīro bhoge adhigamma ",
  "ja390:6.2": "saṃgaṇhāti ca ñātake, ",
  "ja390:6.3": "tena so kittiṃ pappoti ",
  "ja390:6.4": "pecca sagge ca modatīti. ",
  "ja390:7.1": ""
}
