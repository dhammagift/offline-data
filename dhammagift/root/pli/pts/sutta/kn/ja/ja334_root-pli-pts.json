  "ja334:1.1": "Gavañ ce taramānānaṃ ",
  "ja334:1.2": "jimhaṃ gacchati puṅgavo ",
  "ja334:1.3": "sabbā tā jimhaṃ gacchanti ",
  "ja334:1.4": "nette jimhagate sati. ",
  "ja334:2.1": "Evam eva manussesu ",
  "ja334:2.2": "yo hoti seṭṭhasammato ",
  "ja334:2.3": "so ce adhammaṃ carati ",
  "ja334:2.4": "pag eva itarā pajā, ",
  "ja334:2.5": "sabbaṃ raṭṭhaṃ dukkhaṃ seti ",
  "ja334:2.6": "rājā ce hoti adhammiko. ",
  "ja334:3.1": "Gavañ ce taramānānaṃ ",
  "ja334:3.2": "ujuṃ gacchati puṅgavo ",
  "ja334:3.3": "sabbā tā ujuṃ gacchanti ",
  "ja334:3.4": "nette ujuṃgate sati. ",
  "ja334:4.1": "Evam eva manussesu ",
  "ja334:4.2": "yo hoti seṭṭhasammato ",
  "ja334:4.3": "so ce pi dhammaṃ carati ",
  "ja334:4.4": "pag eva itarā pajā, ",
  "ja334:4.5": "sabbaṃ raṭṭhaṃ sukhaṃ seti ",
  "ja334:4.6": "rājā ce hoti dhammikoti. ",
  "ja334:5.1": ""
}
