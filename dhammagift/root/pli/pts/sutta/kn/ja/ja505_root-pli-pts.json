{
  "ja505:0.1": "",
  "ja505:0.2": "",
  "ja505:0.3": "",
  "ja505:0.4": "",
  "ja505:1.1": "Ko taṃ hiṃsati heṭheti, ",
  "ja505:1.2": "kin nu dummano socasi [appatīto], ",
  "ja505:1.3": "kass' ajja mātāpitaro rudantu, ",
  "ja505:1.4": "kv-ajja setu nihato paṭhavyāti. ",
  "ja505:2.1": "Tuṭṭho 'smi deva tava dassanena, ",
  "ja505:2.2": "cirass' apassāmi taṃ bhūmipāla, ",
  "ja505:2.3": "",
  "ja505:2.4": "",
  "ja505:3.1": "Āyantu dovārikā khaggabaddhā, ",
  "ja505:3.2": "kāsāviyā yantu antepuran taṃ, ",
  "ja505:3.3": "hantvāna taṃ Somanassaṃ kumāraṃ ",
  "ja505:3.4": "chetvānā sīsaṃ varaṃ āharantu. ",
  "ja505:4.1": "Pesitā rājino dūtā ",
  "ja505:4.2": "kumāraṃ etad abravuṃ: ",
  "ja505:4.3": "issarena vitiṇṇo si, ",
  "ja505:4.4": "vadhappatto si khattiya. ",
  "ja505:5.1": "Sa rājaputto paridevayanto ",
  "ja505:5.2": "dasaṅguliṃ añjalim paggahetvā: ",
  "ja505:5.3": "aham pi icchāmi janinda daṭṭhuṃ, ",
  "ja505:5.4": "jīvaṃ panetvā paṭidassayetha. ",
  "ja505:6.1": "Tassa taṃ vacanaṃ sutvā ",
  "ja505:6.2": "rañño puttaṃ adassayuṃ, ",
  "ja505:6.3": "putto ca pitaraṃ disvā ",
  "ja505:6.4": "dūrato v' ajjhabhāsatha: ",
  "ja505:7.1": "Āgañchu dovārikā khaggabhaddhā ",
  "ja505:7.2": "kāsāviyā hantu mamaṃ janinda, ",
  "ja505:7.3": "akkhāhi me pucchito etam atthaṃ: ",
  "ja505:7.4": "aparādho ko n' īdha mam' ajja atthīti. ",
  "ja505:8.1": "Sāyañ ca pāto udakaṃ sajāti ",
  "ja505:8.2": "aggiṃ sadā paricaraṇappamatto, ",
  "ja505:8.3": "taṃ tādisaṃ saṃyataṃ brahmacāriṃ ",
  "ja505:8.4": "kasmā tuvaṃ brūsi gahapatīti gatham āha. ",
  "ja505:9.1": "Tālā ca mūlā ca phalā ca deva ",
  "ja505:9.2": "pariggahā vividhā santi-m-assa, ",
  "ja505:9.3": "te rakkhati gopayat' appamatto, brāhmaṇo gahapati ",
  "ja505:9.4": "tena hotīti gātham āha. ",
  "ja505:10.1": "Saccaṃ kho etaṃ vadasī kumāra, ",
  "ja505:10.2": "pariggahā vividhā santi-m-assa, ",
  "ja505:10.3": "te rakkhati gopayat' appamatto, ",
  "ja505:10.4": "brāhmaṇo gahapati tena hotīti gātham āha. ",
  "ja505:11.1": "Suṇantu mayhaṃ parisā samāgatā ",
  "ja505:11.2": "sanegamā jānapadā ca sabbe: ",
  "ja505:11.3": "bāl' āyaṃ, bālassa vaco nisamma ",
  "ja505:11.4": "ahetunā ghātayate janindoti. ",
  "ja505:12.1": "Daḷhasmi mūle visate virūḷhe ",
  "ja505:12.2": "dunnikkhayo veḷu pasākhajāto, ",
  "ja505:12.3": "vandāmi pādāni tavaṃ janinda, ",
  "ja505:12.4": "anujāna maṃ, pabbajissāmi devāti. ",
  "ja505:13.1": "Bhuñjassu bhoge vipule kumāra, ",
  "ja505:13.2": "sabbañ ca te issariyam dadāmi, ",
  "ja505:13.3": "ajj' eva tvaṃ Kuranaṃ hohi rājā, ",
  "ja505:13.4": "mā pabbajī, pabbajjā hi dukkhā. ",
  "ja505:14.1": "Kin nū 'dha deva tavam atthi bhogā, ",
  "ja505:14.2": "pubbe v' ahaṃ devaloke ramissaṃ ",
  "ja505:14.3": "rūpehi saddehi atho rasehi ",
  "ja505:14.4": "gandhehi passehi manoramehi. ",
  "ja505:15.1": "Bhuttā me bhogā tidivasmi deva ",
  "ja505:15.2": "parivāritā accharāsaṃ gaṇena, ",
  "ja505:15.3": "tavañ ca bālaṃ paraneyyaṃ viditvā ",
  "ja505:15.4": "na tādise rājakule vaseyyaṃ. ",
  "ja505:16.1": "Sacc' āhaṃ bālo paraneyy' āham asmi, ",
  "ja505:16.2": "ekāparādhaṃ khama putta mayhaṃ, ",
  "ja505:16.3": "puna pi ce edisakaṃ bhaveyya ",
  "ja505:16.4": "yathāmatiṃ somanassaṃ karohīti. ",
  "ja505:17.1": "Anisamma kataṃ kammaṃ ",
  "ja505:17.2": "anavatthāya cintitaṃ -- ",
  "ja505:17.3": "bhesajjasseva vebhaṅgo ",
  "ja505:17.4": "vipāko hoti pāpako. ",
  "ja505:18.1": "Nisamma ca kataṃ kammaṃ ",
  "ja505:18.2": "sammāvatthāya cintitaṃ -- ",
  "ja505:18.3": "bhesajjasseva sampatti ",
  "ja505:18.4": "vipāko hoti bhadrako. ",
  "ja505:19.1": "Alaso gihī kāmabhogī na sādhu, (III154|23) ",
  "ja505:19.2": "asaññato pabbajito na sādhu, ",
  "ja505:19.3": "rājā na sādhu anisammakārī, ",
  "ja505:19.4": "yo paṇḍito kodhano taṃ na sādhu. ",
  "ja505:20.1": "Nisamma khattiyo kayirā ",
  "ja505:20.2": "nānisamma disampati, ",
  "ja505:20.3": "nisammakārino rāja ",
  "ja505:20.4": "yaso kittī ca viḍḍhati. ",
  "ja505:21.1": "Nisamma daṇḍaṃ paṇayeyya issaro, ",
  "ja505:21.2": "vegā kataṃ tapate bhūmipāla, ",
  "ja505:21.3": "sammāpaṇidhi ca narassa atthā ",
  "ja505:21.4": "anānutappā te bhavanti pacchā. ",
  "ja505:22.1": "Anānutappāni hi ye karonti ",
  "ja505:22.2": "vibhajja kammāyatanāmi loke ",
  "ja505:22.3": "viññūpasatthāni sukhudrayāni ",
  "ja505:22.4": "bhavanti vaddhānumatāni tāni. ",
  "ja505:23.1": "Āgañchu dovārikā khaggabaddhā ",
  "ja505:23.2": "kāsāviyā hantu mamaṃ janinda, ",
  "ja505:23.3": "mātuc-ca aṃkasmi ahaṃ nisino ",
  "ja505:23.4": "ākaḍḍhito sāhasā tehi deva. ",
  "ja505:24.1": "Kaṭukaṃ hi sambādham sukiccha patto, ",
  "ja505:24.2": "madhuraṃ piyaṃ jīvitaṃ laddha rāja ",
  "ja505:24.3": "kicchen' ahaṃ ajja vadhā pamutto, ",
  "ja505:24.4": "pabbajjam evābhimano 'ham asmīti. ",
  "ja505:25.1": "Putto vatāyaṃ taruṇo Sudhamme ",
  "ja505:25.2": "anukampako Somanasso kumāro ",
  "ja505:25.3": "taṃ yācamāno na labhāmi s' ajja, ",
  "ja505:25.4": "arahāsi naṃ yācitave tuvam pīti gāthaṃ āha. ",
  "ja505:26.1": "Ramassu bhikkhācariyāya putta, ",
  "ja505:26.2": "nisamma dhammesu paribbajassu, ",
  "ja505:26.3": "sabbesu bhūtesu nidhāya daṇḍaṃ ",
  "ja505:26.4": "anindito Brahmam upeti ṭhānanti ",
  "ja505:27.1": "gātham āha. Acchariyarūpaṃ vata yādisañ ca, ",
  "ja505:27.2": "dukkhitaṃ maṃ dukkhāpayase Sudhamme, ",
  "ja505:27.3": "",
  "ja505:27.4": "",
  "ja505:28.1": "Ye vippamuttā anavajjabhojino ",
  "ja505:28.2": "parinibbutā lokam imaṃ caranti ",
  "ja505:28.3": "tam ariyamaggaṃ paṭipajjamānaṃ ",
  "ja505:28.4": "na ussahe vārayituṃ kumāranti. ",
  "ja505:29.1": "Addhā have sevitabbā sapaññā (III306|22) ",
  "ja505:29.2": "bahussutā ye bahuṭhānacintino ",
  "ja505:29.3": "yes' āyaṃ sutvāna subhāsitāni ",
  "ja505:29.4": "appossukkā vītasokā Sudhammāti. ",
  "ja505:30.1": ""
}
