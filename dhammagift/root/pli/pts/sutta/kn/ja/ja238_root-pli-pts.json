  "ja238:1.1": "ekapadaṃ tāta ",
  "ja238:1.2": "anekatthapadanissitaṃ ",
  "ja238:1.3": "kiñci saṃgāhikaṃ brūsi ",
  "ja238:1.4": "yen' atthe sādhayemaseti. ",
  "ja238:2.1": "Dakkheyyekapadaṃ tāta ",
  "ja238:2.2": "anekatthapadanissitaṃ ",
  "ja238:2.3": "tañ ca sīlena saṃyuttaṃ ",
  "ja238:2.4": "khantiyā upapāditaṃ ",
  "ja238:2.5": "alaṃ mitte sukhāpetuṃ ",
  "ja238:2.6": "amittānaṃ dukhāya cāti. Āsīvisaṃ mamaṃ ",
  "ja238:3.1": ""
}
