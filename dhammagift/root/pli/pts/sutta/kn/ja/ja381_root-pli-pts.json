  "ja381:0.4": "",
  "ja381:1.1": "Na me ruccaṃ Migālopa ",
  "ja381:1.2": "yassa te tādisā gati, ",
  "ja381:1.3": "atuccaṃ tāta patasi, ",
  "ja381:1.4": "abhūmiṃ tāta sevasi. ",
  "ja381:2.1": "Catukkaṇṇaṃ va kedāraṃ ",
  "ja381:2.2": "yadā te paṭhavī siyā ",
  "ja381:2.3": "tato tāta nivattassu, ",
  "ja381:2.4": "māssu etto paraṃ gami. ",
  "ja381:3.1": "Santi aññe pi sakuṇā ",
  "ja381:3.2": "pattayānā vihaṅgamā, ",
  "ja381:3.3": "akkhittā vātavegena ",
  "ja381:3.4": "naṭṭhā te sassatīsamāti. ",
  "ja381:4.1": "Akatvā Aparaṇṇassa ",
  "ja381:4.2": "pitu vaddhassa bhāsanaṃ ",
  "ja381:4.3": "kālavāte atikkamma ",
  "ja381:4.4": "verambānaṃ vasaṃ agā. ",
  "ja381:5.1": "Tassa puttā ca dārā ca ",
  "ja381:5.2": "ye c' aññe anujīvino ",
  "ja381:5.3": "sabbe vyasanam āpāduṃ ",
  "ja381:5.4": "anovādakare dije. ",
  "ja381:6.1": "Evam pi idha vaddhānaṃ ",
  "ja381:6.2": "yo vākyaṃ nāvabujjhati ",
  "ja381:6.3": "atisīmacaro ditto ",
  "ja381:6.4": "gijjho vātītasāsano, ",
  "ja381:6.5": "sabbe vyasanaṃ papponti ",
  "ja381:6.6": "akatvā vaddhasāsananti ",
  "ja381:7.1": ""
}
