  "ja315:0.4": "",
  "ja315:1.1": "Pharusā vata te vācā ",
  "ja315:1.2": "samma yācanako c' asi, ",
  "ja315:1.3": "kilomassa sadisī vācā, ",
  "ja315:1.4": "kilomaṃ samma dadāmi teti. ",
  "ja315:2.1": "Aṅgam etaṃ manussānaṃ ",
  "ja315:2.2": "bhātā loke pavuccati, ",
  "ja315:2.3": "aṅgassa sadisī vācā, ",
  "ja315:2.4": "aṅgaṃ samma dadāmi teti. ",
  "ja315:3.1": "Tātāti putto vadamāno ",
  "ja315:3.2": "kampeti hadayaṃ pitu, ",
  "ja315:3.3": "hadayassa sadisī vācā, ",
  "ja315:3.4": "hadayaṃ samma dadāmi teti. ",
  "ja315:4.1": "Yassa gāme sakhā n' atthi ",
  "ja315:4.2": "yathāraññaṃ tath' eva taṃ, ",
  "ja315:4.3": "sabbassa sadisī vācā, ",
  "ja315:4.4": "sabbaṃ samma dadāmi teti. ",
  "ja315:5.1": ""
}
