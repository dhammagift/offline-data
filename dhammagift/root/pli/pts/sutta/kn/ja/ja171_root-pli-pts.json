  "ja171:1.1": "Kalyāṇadhammoti yadā janinda ",
  "ja171:1.2": "loke samaññaṃ anupāpuṇāti ",
  "ja171:1.3": "tasmā na hiyyetha naro sapañño, ",
  "ja171:1.4": "hiriyāpi santo dhuram ādiyanti. ",
  "ja171:2.1": "Sāyaṃ samaññā idha m' ajja pattā: ",
  "ja171:2.2": "kalyāṇadhammoti janinda loke, ",
  "ja171:2.3": "t' āhaṃ samekkhaṃ idha pabbajissaṃ, ",
  "ja171:2.4": "na hi m' atthi chando idha kāmabhogeti. ",
  "ja171:3.1": ""
}
