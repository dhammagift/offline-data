  "ja422:0.4": "",
  "ja422:1.1": "Dhammo have hato hanti, ",
  "ja422:1.2": "nāhato hanti kañcinaṃ, ",
  "ja422:1.3": "tasmā hi dhammaṃ na hane ",
  "ja422:1.4": "mā taṃ dhammo hato hanīti. ",
  "ja422:2.1": "Alikaṃ bhāsamānassa ",
  "ja422:2.2": "apakkamanti devatā, ",
  "ja422:2.3": "pūtikañ ca mukhaṃ vāti ",
  "ja422:2.4": "saggaṭṭhānā ca dhaṃsati ",
  "ja422:2.5": "yo jānaṃ pucchiro pañhaṃ ",
  "ja422:2.6": "aññathā naṃ viyākareti. ",
  "ja422:3.1": "Sace hi saccaṃ bhaṇasi ",
  "ja422:3.2": "hohi rāja yathā pure, ",
  "ja422:3.3": "musā ce bhāsase rāja ",
  "ja422:3.4": "bhūmiyaṃ tiṭṭha Cetiyāti. ",
  "ja422:4.1": "Akāle vassatī tassa ",
  "ja422:4.2": "kāle tassa na vassati ",
  "ja422:4.3": "yo jānaṃ pucchito pañhaṃ ",
  "ja422:4.4": "aññathā naṃ viyākareti. ",
  "ja422:5.1": "Sace hi saccaṃ bhaṇasi ",
  "ja422:5.2": "hohi rāja yathā pure, ",
  "ja422:5.3": "musā ce bhāsase rāja ",
  "ja422:5.4": "bhūmiṃ pavisa Cetiyāti. ",
  "ja422:6.1": "Jivhā tassa dvidhā hoti ",
  "ja422:6.2": "uragasseva disampati ",
  "ja422:6.3": "yo jānaṃ pucchito pañhaṃ ",
  "ja422:6.4": "aññathā naṃ viyākare. ",
  "ja422:7.1": "Sace hi saccaṃ bhaṇasi ",
  "ja422:7.2": "hohi rāja yathā pure, ",
  "ja422:7.3": "musā ce bhāsase rāja ",
  "ja422:7.4": "bhiyyo pavisa Cetiyāti ",
  "ja422:8.1": "Jivhā tassa na bhavati ",
  "ja422:8.2": "macchasseva disampati ",
  "ja422:8.3": "yo jānaṃ pucchito pañhaṃ ",
  "ja422:8.4": "aññathā naṃ viyākare. ",
  "ja422:9.1": "Sace hi saccaṃ bhaṇasi ",
  "ja422:9.2": "hohi rāja yathā pure, ",
  "ja422:9.3": "musā ce bhāsase rāja ",
  "ja422:9.4": "bhiyyo pavisa Cetiyāti. ",
  "ja422:10.1": "Thiyo tassa pajāyanti ",
  "ja422:10.2": "na pumā jāyare kule ",
  "ja422:10.3": "yo jānaṃ pucchito pañhaṃ ",
  "ja422:10.4": "aññathā naṃ viyākare. ",
  "ja422:11.1": "Sace hi saccaṃ bhaṇasi ",
  "ja422:11.2": "hohi rāja yathā pure, ",
  "ja422:11.3": "musā ce bhāsase rāja ",
  "ja422:11.4": "bhiyyo pavisa Cetiyāti. ",
  "ja422:12.1": "Puttā tassa na bhavanti ",
  "ja422:12.2": "pakkamanti disodisaṃ ",
  "ja422:12.3": "yo jānaṃ pucchito pañhaṃ ",
  "ja422:12.4": "aññathā naṃ viyākare. ",
  "ja422:13.1": "Sace hi saccaṃ bhaṇasi ",
  "ja422:13.2": "hohi rāja yathā pure, ",
  "ja422:13.3": "musā ce bhāsase rāja ",
  "ja422:13.4": "bhiyyo pavisa Cetiyāti. ",
  "ja422:14.1": "Sa rājā isinā satto ",
  "ja422:14.2": "antalikkhecaro pure ",
  "ja422:14.3": "pāvekkhi paṭhaviṃ c' eso ",
  "ja422:14.4": "hīnatto patvā pariyāyaṃ. ",
  "ja422:15.1": "Tasmā hi chandāgamanaṃ ",
  "ja422:15.2": "na-ppasaṃsanti paṇḍitā, (= vol.II 172|20.) ",
  "ja422:15.3": "aduṭṭhacitto bhāseyya ",
  "ja422:15.4": "giraṃ saccūpasaṃhitanti ",
  "ja422:16.1": ""
}
