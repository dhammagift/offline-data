  "ja83:1.1": "Mitto have sattapadena hoti, ",
  "ja83:1.2": "sahāyo pana dvādasakena hoti, ",
  "ja83:1.3": "māsaddhamāsena ca ñāti hoti, ",
  "ja83:1.4": "tatuttariṃ attasamo pi hoti, ",
  "ja83:1.5": "so 'haṃ kathaṃ attasukhassa hetu ",
  "ja83:1.6": "cirasatthunaṃ Kāḷakaṇṇiṃ jaheyyanti. ",
  "ja83:2.1": ""
}
