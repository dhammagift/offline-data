  "ja398:0.4": "",
  "ja398:1.1": "Rājā te bhattaṃ pāhesi ",
  "ja398:1.2": "suciṃ maṃsūpasecanaṃ, ",
  "ja398:1.3": "makhādevasmiṃ adhivatthe ",
  "ja398:1.4": "ehi nikkhama bhuñjassūti. ",
  "ja398:2.1": "Ehi māṇava orena ",
  "ja398:2.2": "bhikkham ādāya sūpinaṃ, ",
  "ja398:2.3": "tvañ ca māṇava bhikkhā ca ",
  "ja398:2.4": "ubho bhakkhā bhavissathāti. ",
  "ja398:3.1": "Appakena tuvaṃ yakkha ",
  "ja398:3.2": "thullam atthaṃ jahissasi, ",
  "ja398:3.3": "bhikkhaṃ te nāharissanti ",
  "ja398:3.4": "janā maraṇasaññino. ",
  "ja398:4.1": "Laddhāyaṃ yakkha tava niccabhikkhaṃ ",
  "ja398:4.2": "suciṃ paṇītaṃ rasasā upetaṃ, ",
  "ja398:4.3": "bhikkhañ ca te āhariyo naro idha ",
  "ja398:4.4": "sudullabho hohiti khādite mayīti. Mam' ",
  "ja398:5.1": "esa Sutano attho ",
  "ja398:5.2": "yathā bhāsasi māṇava, ",
  "ja398:5.3": "mayā tvaṃ samanuññāto ",
  "ja398:5.4": "sotthiṃ passāhi mātaraṃ. ",
  "ja398:6.1": "Khaggaṃ chattañ ca pātiñ ca gacch' ",
  "ja398:6.2": "evādāya māṇava, ",
  "ja398:6.3": "sotthiṃ passatu te mātā ",
  "ja398:6.4": "tvañ ca passāhi mātaranti. ",
  "ja398:7.1": "Evaṃ yakkha sukhī hohi ",
  "ja398:7.2": "saha sabbehi ñātibhi, ",
  "ja398:7.3": "dhanañ ca me adhigataṃ, ",
  "ja398:7.4": "rañño ca vacanaṃ katanti. ",
  "ja398:8.1": ""
}
