  "ja380:0.4": "",
  "ja380:1.1": "Āsāvatī nāma latā ",
  "ja380:1.2": "jātā Cittalatāvane, ",
  "ja380:1.3": "tassā vassasahassena ",
  "ja380:1.4": "ekaṃ nibbattate phalaṃ, ",
  "ja380:2.1": "taṃ devā payirupāsanti ",
  "ja380:2.2": "tāva dūraphalaṃ satiṃ. ",
  "ja380:2.3": "Āsiṃs' eva tuvaṃ rāja, ",
  "ja380:2.4": "āsā phalavatī sukhā, ",
  "ja380:3.1": "āsiṃseth' eva so pakkhī, ",
  "ja380:3.2": "āsiṃseth eva so dijo. ",
  "ja380:3.3": "Tassa cāsā samijjhittha ",
  "ja380:3.4": "tāva dūragatā satī, ",
  "ja380:3.5": "āsiṃs' eva tuvaṃ rāja, ",
  "ja380:3.6": "āsā phalavatī sukhāti. ",
  "ja380:4.1": "Sampesi kho maṃ vācāya, ",
  "ja380:4.2": "na ca sampesi kammanā, ",
  "ja380:4.3": "mālā sereyyakass' eva ",
  "ja380:4.4": "vaṇṇavantā agandhikā. ",
  "ja380:5.1": "Aphalaṃ madhuraṃ vācaṃ ",
  "ja380:5.2": "yo mittesu pakubbati ",
  "ja380:5.3": "adadaṃ avissajaṃ bhogaṃ ",
  "ja380:5.4": "sandhi ten' assa jīrati. ",
  "ja380:6.1": "Yaṃ hi kayirā taṃ hi vade, ",
  "ja380:6.2": "yaṃ na kayirā na taṃ vade, ",
  "ja380:6.3": "akarontaṃ bhāsamānaṃ ",
  "ja380:6.4": "parijānanti paṇḍitā. ",
  "ja380:7.1": "(J. 363 v. 2.) Balañ ca vata me khīṇaṃ, ",
  "ja380:7.2": "pātheyyañ ca na vijjati, ",
  "ja380:7.3": "saṃke pāṇuparodhāya, ",
  "ja380:7.4": "handa dāni vajām' ahanti ",
  "ja380:8.1": "Etad eva hi me nāmaṃ ",
  "ja380:8.2": "yaṃnām' asmi rathesabha, ",
  "ja380:8.3": "āgamehi mahārāja, ",
  "ja380:8.4": "pitaraṃ āmantayām' ahanti ",
  "ja380:9.1": ""
}
