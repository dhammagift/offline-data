{
  "ja512:0.1": "",
  "ja512:0.2": "",
  "ja512:0.3": "",
  "ja512:0.4": "",
  "ja512:1.1": "Ko pātur āsī tidivā nabhamhi ",
  "ja512:1.2": "obhāsayaṃ saṃvariṃ candimā va, ",
  "ja512:1.3": "gattehi te rasmiyo niccharanti ",
  "ja512:1.4": "sateratā vijju-r-iv' antalikkhe. ",
  "ja512:2.1": "So chinnavātaṃ kamasī aghamhi, ",
  "ja512:2.2": "vehāsayaṃ gacchasi tiṭṭhasī ca, ",
  "ja512:2.3": "iddhī nu te vatthukatā subhāvitā ",
  "ja512:2.4": "anaddhagūnām api devatānaṃ. ",
  "ja512:3.1": "Vehāsayaṃ saṃkammāgamma tiṭṭhasi ",
  "ja512:3.2": "‘kumbham kiṇāthāti ",
  "ja512:3.3": "",
  "ja512:3.4": "yam etam atthaṃ ",
  "ja512:4.1": "Na sappikumbho na pi telakumbho ",
  "ja512:4.2": "na phāṇitassa na madhussa kumbho, ",
  "ja512:4.3": "kumbhassa vajjāni anappakāni, ",
  "ja512:4.4": "dose bahū kumbhagate suṇātha. ",
  "ja512:5.1": "Gaḷeyya yaṃ pītvā pate papātaṃ ",
  "ja512:5.2": "sobbhaṃ guhaṃ candaniyoligallaṃ ",
  "ja512:5.3": "bahum pi bhuñjeyya abhojaneyyaṃ ",
  "ja512:5.4": "tassā puṇṇaṃ kumbham imaṃ kiṇātha. ",
  "ja512:6.1": "Yaṃ pītvā cittasmi anesamāno ",
  "ja512:6.2": "āhiṇḍatī go-r-iva ",
  "ja512:6.3": "",
  "ja512:6.4": "bhakkhasārī ",
  "ja512:7.1": "Yaṃ ve pivitvā acelo va naggo ",
  "ja512:7.2": "careyya gāme visikhantarāni ",
  "ja512:7.3": "sammūḷharitto ativelasāyī ",
  "ja512:7.4": "tassā puṇṇaṃ kumbham imaṃ kiṇātha. ",
  "ja512:8.1": "Yaṃ pītvā uṭṭhāya pavedhamāno ",
  "ja512:8.2": "sīsañ ca bāhañ ca pacālayanto ",
  "ja512:8.3": "so naccatī dārukaṭallako va ",
  "ja512:8.4": "etc. ",
  "ja512:9.1": "Yaṃ ve pivitvā aggidaḍḍhā sayanti ",
  "ja512:9.2": "atho sigālehi pi khāditāse ",
  "ja512:9.3": "bandhaṃ vadhaṃ bhogajāniṃ ",
  "ja512:9.4": "c' upenti etc. ",
  "ja512:10.1": "Yaṃ pītvā bhāseyya abhāsaneyyaṃ ",
  "ja512:10.2": "sabhāyam āsīno apetavattho ",
  "ja512:10.3": "sammakkhito vantagato vyasanno ",
  "ja512:10.4": "etc. ",
  "ja512:11.1": "Yaṃ pītvā ukkaṭṭho āvilakkho ",
  "ja512:11.2": "mam' eva sabbā puthavīti maññe ",
  "ja512:11.3": "na me samo cāturanto pi rājā ",
  "ja512:11.4": "etc. ",
  "ja512:12.1": "Mānātimānā kalahāni pesuṇāni ",
  "ja512:12.2": "dubbaṇṇinī naggayinī palāyinī ",
  "ja512:12.3": "corāna dhuttānaṃ gatī niketo ",
  "ja512:12.4": "etc. ",
  "ja512:13.1": "Iddhāni phītāni kulāni assu ",
  "ja512:13.2": "anekasāhassadhanāni loke ",
  "ja512:13.3": "ucchinnadāyajjakatān' imāya ",
  "ja512:13.4": "etc. ",
  "ja512:14.1": "Dhaññam dhanaṃ rajataṃ jātarūpaṃ ",
  "ja512:14.2": "khettaṃ gavaṃ yattha vināsayanti ",
  "ja512:14.3": "ucchedanī vittavataṃ kulānaṃ ",
  "ja512:14.4": "etc. Yañ ",
  "ja512:15.1": "ce pītvā dittarūpo va poso ",
  "ja512:15.2": "akkosatī pitaraṃ mātarañ ca ",
  "ja512:15.3": "sassum pi gaṇheyya atho pi suṇhaṃ ",
  "ja512:15.4": "etc. Yañ ",
  "ja512:16.1": "ce pītvā dittarūpā va nārī ",
  "ja512:16.2": "akkosatī sasuraṃ sāmikañ ca ",
  "ja512:16.3": "dāsam pi gaṇhe paricārakam pi ",
  "ja512:16.4": "etc. ",
  "ja512:17.1": "Yañ ce pītvāna haneyya poso ",
  "ja512:17.2": "dhamme ṭhitaṃ samaṇaṃ brāhmaṇaṃ vā ",
  "ja512:17.3": "gacche apāyam pi tatonidānaṃ ",
  "ja512:17.4": "etc. Yañ ce ",
  "ja512:18.1": "pītvā duccaritaṃ caranti ",
  "ja512:18.2": "kāyena vācāya ca cetasā ca ",
  "ja512:18.3": "nirayaṃ vajanti duccaritaṃ caritvā ",
  "ja512:18.4": "etc. ",
  "ja512:19.1": "Yaṃ yācamānā na labhanti pubbe ",
  "ja512:19.2": "bahuṃ hiraññam pi pariccajantā ",
  "ja512:19.3": "so taṃ pivitvā alikaṃ bhaṇāti ",
  "ja512:19.4": "etc. ",
  "ja512:20.1": "Yaṃ pivitvā pesane pesiyanto ",
  "ja512:20.2": "accāyike karaṇīyamhi jāto ",
  "ja512:20.3": "attham pi so na-ppajānāti vutto ",
  "ja512:20.4": "etc. ",
  "ja512:21.1": "Hirīmanāpi ahirīkabhāvaṃ ",
  "ja512:21.2": "pātuṃkaronti madirāya mattā, ",
  "ja512:21.3": "dhīrāpi santā bahukaṃ bhaṇanti ",
  "ja512:21.4": "etc. Yañ ",
  "ja512:22.1": "ce pītvā ekathūpā sayanti ",
  "ja512:22.2": "anāsakā thaṇḍiladukkhaseyyā ",
  "ja512:22.3": "dubbaṇṇiyaṃ āyasakkañ ",
  "ja512:22.4": "c' upenti etc. Yañ ",
  "ja512:23.1": "ce pītvā pattakkhandhā [sayanti] ",
  "ja512:23.2": "gāvo kūṭahatā-r- ",
  "ja512:23.3": "",
  "ja512:23.4": "iva ",
  "ja512:24.1": "Yaṃ manussā vivajjenti ",
  "ja512:24.2": "sappaṃ ghoravisaṃ iva ",
  "ja512:24.3": "taṃ loke visasamānaṃ ",
  "ja512:24.4": "ko naro pātum arahati. ",
  "ja512:25.1": "Yañ ce pivitvā Andhakaveṇhuputtā ",
  "ja512:25.2": "samuddatīre paricārayantā ",
  "ja512:25.3": "upakkamuṃ musalehi ",
  "ja512:25.4": "aññamaññaṃ etc. Yañ ",
  "ja512:26.1": "ce pītvā pubbadevā pamattā ",
  "ja512:26.2": "tidivā cutā sassatiyā samāyā ",
  "ja512:26.3": "taṃ tādisaṃ majjam imaṃ niratthakaṃ ",
  "ja512:26.4": "jānaṃ mahārāja kathaṃ pipeyya. Na ",
  "ja512:27.1": "imasmi kumbhasmiṃ dadhi vā madhuṃ vā ",
  "ja512:27.2": "evaṃ abhiññāya kiṇāhi rāja, ",
  "ja512:27.3": "evaṃ hi maṃkumbhagatā mayā te, ",
  "ja512:27.4": "akkhātarūpaṃ tava Sabbamittāti. ",
  "ja512:28.1": "Na me pitā vā athavāpi mātā ",
  "ja512:28.2": "etādisā yādisako tuvaṃ si, ",
  "ja512:28.3": "hitānukampī paramatthakāmo ",
  "ja512:28.4": "So 'haṃ karissaṃ vacanaṃ tav' ajja. ",
  "ja512:29.1": "Dadāmi te gāmavarāni pañca ",
  "ja512:29.2": "dāsīsataṃ satta gavaṃ satāni ",
  "ja512:29.3": "ājaññayutte ca rathe dasā ime, ",
  "ja512:29.4": "ācariyo hosi mam' atthakāmoti. ",
  "ja512:30.1": "Tav' eva dāsīsatam atthu rāja, ",
  "ja512:30.2": "gāmā ca gāvo ca tav' eva hontu, ",
  "ja512:30.3": "ājaññayuttā ca rathā tav' eva, ",
  "ja512:30.4": "Sakko 'ham asmī tidasānam indo. ",
  "ja512:31.1": "Maṃsodanaṃ sappipāyāsaṃ bhuñja, ",
  "ja512:31.2": "khādassu ce tvaṃ madhunā apūpe, ",
  "ja512:31.3": "evaṃ tuvaṃ dhammarato janinda ",
  "ja512:31.4": "anindito saggam upehi ṭhānanti. ",
  "ja512:32.1": ""
}
