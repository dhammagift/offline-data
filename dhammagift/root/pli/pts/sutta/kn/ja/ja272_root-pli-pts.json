  "ja272:1.1": "Yena mittena saṃsaggā ",
  "ja272:1.2": "yogakkhemo vihiṃsati pubbe ",
  "ja272:1.3": "v' ajjhābhavan tassa ",
  "ja272:1.4": "rakkhe akkhīva paṇḍito. ",
  "ja272:2.1": "Yena mittena saṃsaggā ",
  "ja272:2.2": "yogakkhemo pavaḍḍhati ",
  "ja272:2.3": "kareyy' attasamaṃ vuttiṃ ",
  "ja272:2.4": "sabbakiccesu paṇḍitoti. ",
  "ja272:3.1": "Etha vyagghā nivattavho ",
  "ja272:3.2": "paccametha mahāvanaṃ, ",
  "ja272:3.3": "mā vanaṃ chindi nivyagghaṃ, ",
  "ja272:3.4": "vyagghā mā hesu nibbanāti. ",
  "ja272:4.1": ""
}
