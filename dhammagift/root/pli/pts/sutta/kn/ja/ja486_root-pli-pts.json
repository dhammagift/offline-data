  "ja486:0.1": "",
  "ja486:0.2": "",
  "ja486:0.3": "",
  "ja486:0.4": "",
  "ja486:1.1": "Ukkā milācā bandhanti dīpe, ",
  "ja486:1.2": "pajā mamaṃ khādituṃ patthayanti, ",
  "ja486:1.3": "mittaṃ sahāyañ ca vadehi senaka, ",
  "ja486:1.4": "ācikkha ñātivyasanaṃ dijānanti. ",
  "ja486:2.1": "Dijo dijānaṃ pavaro si pakkhi, ",
  "ja486:2.2": "ukkusarāja saraṇan taṃ upemi, ",
  "ja486:2.3": "pajā mamaṃ khādituṃ patthayanti ",
  "ja486:2.4": "luddā milācā, bhava me sukhāyāti. ",
  "ja486:3.1": "Mittaṃ sahāyañ ca karonti paṇḍitā ",
  "ja486:3.2": "kāle akāle sukham āsayānā, ",
  "ja486:3.3": "karomi te senaka etam atthaṃ, ",
  "ja486:3.4": "ariyo hi ariyassa karoti kiccanti. ",
  "ja486:4.1": "Yaṃ hoti kiccaṃ anukampakena ",
  "ja486:4.2": "ariyassa ariyena kataṃ tava-y-idaṃ, ",
  "ja486:4.3": "attānurakkhī bhava mā aḍayha, ",
  "ja486:4.4": "lacchāma putte tayi jīvamāneti. ",
  "ja486:5.1": "Tav' eva rakkhāvaraṇaṃ karonto ",
  "ja486:5.2": "sarīrabhedāpi na santasāmi, ",
  "ja486:5.3": "karonti h' ete sakhinaṃ sakhāro: ",
  "ja486:5.4": "pāṇaṃ cajanti, satān' esa dhammoti. ",
  "ja486:6.1": "Sudukkaraṃ kammam akā ",
  "ja486:6.2": "aṇḍaj' āyaṃ vihaṅgamo ",
  "ja486:6.3": "atthāya kuraro putte ",
  "ja486:6.4": "aḍḍharatte anāgateti. ",
  "ja486:7.1": "Cutāpi eke khalita-ssakammunā ",
  "ja486:7.2": "mittānukampāya patiṭṭhahanti, ",
  "ja486:7.3": "puttā mam' aṭṭā, gatiṃ āgato 'smi, ",
  "ja486:7.4": "atthaṃ caretha mama vārichannāti. ",
  "ja486:8.1": "Dhanena dhaññena ca attanā va mittaṃ sahāyañ ca ",
  "ja486:8.2": "karonti paṇḍitā, ",
  "ja486:8.3": "karomi te senaka etam atthaṃ, ",
  "ja486:8.4": "ariyo hi ariyassa karoti kiccanti. ",
  "ja486:9.1": "Appossukko tāta tuvaṃ nisīda, ",
  "ja486:9.2": "putto pitu caratī atthacariyaṃ, ",
  "ja486:9.3": "",
  "ja486:9.4": "",
  "ja486:10.1": "Addhā hi tāta satān' esa dhammo ",
  "ja486:10.2": "putto pitu yaṃ caretha atthacariyaṃ, ",
  "ja486:10.3": "app-eva maṃ disvā pavaddhakāyaṃ ",
  "ja486:10.4": "senassa puttā na viheṭhayeyyunti. ",
  "ja486:11.1": "Pasū manussā mīgaviriyaseṭṭha ",
  "ja486:11.2": "bhayadditā seṭṭham upabbajanti, ",
  "ja486:11.3": "puttā mam' aṭṭā, gatim āgato 'smi, ",
  "ja486:11.4": "tvan no si rājā, bhave me sukhāyāti. ",
  "ja486:12.1": "Karomi te senaka etam atthaṃ, ",
  "ja486:12.2": "āyāma te taṃ disataṃ vadhāya, ",
  "ja486:12.3": "kathaṃ hi viññū bahu sampajāno ",
  "ja486:12.4": "na vāyame attajanassa guttiyāti. ",
  "ja486:13.1": "Mittañ ca kayirātha sakhāgharañ ca, ",
  "ja486:13.2": "ayirañ ca kayirātha sukhehi ayiro, nivatthakojo ",
  "ja486:13.3": "va sare 'bhihantvā ",
  "ja486:13.4": "modāma puttehi samaṅgibhūtā. ",
  "ja486:14.1": "Sakamittassa kammena ",
  "ja486:14.2": "sahāyassāpalāyino ",
  "ja486:14.3": "kūjantaṃ upakūjanti ",
  "ja486:14.4": "lomasā hadayaṅgamaṃ. ",
  "ja486:15.1": "Mittaṃ sahāyaṃ adhigamma paṇḍito ",
  "ja486:15.2": "so bhuñjatī puttapasuṃ dhanaṃ vā, ",
  "ja486:15.3": "ahañ ca puttā ca patī ca mayhaṃ ",
  "ja486:15.4": "mittānukampāya samaṅgibhūtā. ",
  "ja486:16.1": "Rājāvatā sūravatā ca attho, ",
  "ja486:16.2": "sampannasakkhissa bhavanti h' ete, ",
  "ja486:16.3": "yo mittavā yasavā uggatatto ",
  "ja486:16.4": "asmiñ ca loke modati kāmakāmi. ",
  "ja486:17.1": "Karaṇīyāni mittāni ",
  "ja486:17.2": "daliddenāpi senaka, ",
  "ja486:17.3": "passa mittānukampāya ",
  "ja486:17.4": "samagg' amhā sa ñātake. ",
  "ja486:18.1": "Sūrena balavantena ",
  "ja486:18.2": "yo mettiṃ kurute dijo ",
  "ja486:18.3": "evaṃ so sukhito hoti ",
  "ja486:18.4": "yathāham tvaṃ ca senakāti. ",
  "ja486:19.1": ""
}
