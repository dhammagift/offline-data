  "ja414:0.3": "",
  "ja414:0.4": "",
  "ja414:1.1": "Ko 'dha jāgarataṃ sutto, ",
  "ja414:1.2": "ko 'dha suttesu jāgaro, ",
  "ja414:1.3": "ko mam' etaṃ vijānāti, ",
  "ja414:1.4": "ko taṃ paṭibhaṇāti meti. ",
  "ja414:2.1": "Ahaṃ jāgarataṃ sutto, ",
  "ja414:2.2": "ahaṃ suttesu jāgaro, ",
  "ja414:2.3": "aham etaṃ vijānāmi, ",
  "ja414:2.4": "ahaṃ paṭibhaṇāmi teti ",
  "ja414:3.1": "Kathaṃ jāgarataṃ sutto, ",
  "ja414:3.2": "kathaṃ suttesu jāgaro, ",
  "ja414:3.3": "kathaṃ etaṃ vijānāsi, ",
  "ja414:3.4": "kathaṃ paṭibhaṇāsi meti ",
  "ja414:4.1": "Ye dhammaṃ na-ppajānanti ",
  "ja414:4.2": "saññamoti damoti ca ",
  "ja414:4.3": "tesu suppamānesu ",
  "ja414:4.4": "ahaṃ jaggāmi devate. ",
  "ja414:5.1": "Yesaṃ rāgo ca doso ca ",
  "ja414:5.2": "avijjā ca virājitā ",
  "ja414:5.3": "tesu jāgaramānesu ",
  "ja414:5.4": "ahaṃ sutto 'smi devate. ",
  "ja414:6.1": "Evaṃ jāgarataṃ sutto ",
  "ja414:6.2": "evaṃ suttesu jāgaro, ",
  "ja414:6.3": "evam etaṃ vijānāmi, ",
  "ja414:6.4": "evaṃ paṭibhaṇāmi teti. ",
  "ja414:7.1": "Sādhu jāgarataṃ sutto, ",
  "ja414:7.2": "sādhu suttesu jāgaro, ",
  "ja414:7.3": "sādhu metaṃ vijānāsi, ",
  "ja414:7.4": "sādhu paṭibhaṇāsi meti. ",
  "ja414:8.1": ""
}
