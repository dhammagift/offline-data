  "ja389:1.1": "Siṅgī migo āyatacakkhunetto (Cfr. II p.343.) ",
  "ja389:1.2": "aṭṭhittaco vārisayo alomo, ",
  "ja389:1.3": "tenābhibhūto kapaṇaṃ rudāmi, ",
  "ja389:1.4": "hare sakhā kissa nu maṃ jahāsīti. ",
  "ja389:2.1": "So passasanto mahatā phaṇena ",
  "ja389:2.2": "bhujaṅgamo kakkaṭaṃ ajjhapatto ",
  "ja389:2.3": "sakhā sakhāraṃ paritāyamāno, ",
  "ja389:2.4": "bhujaṅgamaṃ kakkaṭako gahesīti. ",
  "ja389:3.1": "Na vāyasaṃ no pana sapparājaṃ ",
  "ja389:3.2": "ghāsatthiko kakkaṭako adeyya, ",
  "ja389:3.3": "pucchāmi taṃ āyatanettacakkhu ",
  "ja389:3.4": "atha kissa hetu 'mha ubho gahītāti. ",
  "ja389:4.1": "Ayaṃ puriso mama atthakāmo, ",
  "ja389:4.2": "yo maṃ gahetvāna dakāya neti, ",
  "ja389:4.3": "tasmiṃ mate dukkham anappakam me, ",
  "ja389:4.4": "ahañ ca eso ca ubho na homa. ",
  "ja389:5.1": "Mamañ ca disvāna pavaddhakāyaṃ ",
  "ja389:5.2": "sabbo jano hiṃsitum eva-m-icche, ",
  "ja389:5.3": "sāduñ ca thullañ ca muduñ ca maṃsaṃ ",
  "ja389:5.4": "kākāpi maṃ disva viheṭhayeyyunti. ",
  "ja389:6.1": "Sac' etassa hetu 'mha ubho gahītā ",
  "ja389:6.2": "uṭṭhātu poso visam ācamāmi, ",
  "ja389:6.3": "mamañ ca kākañ ca pamuñca khippaṃ, ",
  "ja389:6.4": "pure visaṃ gāḷham upeti maccanti. ",
  "ja389:7.1": "Sappaṃ pamokkhāmi na tāva kākaṃ, ",
  "ja389:7.2": "paṭibaddhako hohiti tāva kāko, ",
  "ja389:7.3": "purisañ ca disvāna sukhiṃ arogaṃ ",
  "ja389:7.4": "kākaṃ pamokkhāmi yath' eva sappanti. ",
  "ja389:8.1": "Kāko tadā Devadatto ahosi, ",
  "ja389:8.2": "Māro pana kaṇhasappo ahosi, ",
  "ja389:8.3": "Ānando bhaddo kakkaṭako ahosi, ",
  "ja389:8.4": "ahaṃ tadā brāhmaṇo homi tatthāti. ",
  "ja389:9.1": ""
}
