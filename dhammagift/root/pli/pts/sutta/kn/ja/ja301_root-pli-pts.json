  "ja301:0.4": "",
  "ja301:1.1": "dvāraṃ, ",
  "ja301:1.2": "nagaraṃ pavisantu Aruṇarājassa ",
  "ja301:1.3": "sīhena susatthena ",
  "ja301:1.4": "surakkhitaṃ Nandisenenāti. ",
  "ja301:2.1": "‘Jayo Kaliṅgānaṃ asayhasāhinaṃ, ",
  "ja301:2.2": "parājayo anayo Assakānaṃ', ",
  "ja301:2.3": "",
  "ja301:2.4": "",
  "ja301:3.1": "Devā musāvādaṃ upātivattā, ",
  "ja301:3.2": "saccan dhanaṃ paraman tesu Sakka, ",
  "ja301:3.3": "tan te musā bhāsitaṃ devarāja ",
  "ja301:3.4": "kiṃ vā paṭicca Maghavā mahindāti. ",
  "ja301:4.1": "Nanu te sutaṃ brāhmaṇa bhaññamāne: ",
  "ja301:4.2": "devā na issanti purisaparakkamassa, ",
  "ja301:4.3": "damo samādhi manaso adejjho ",
  "ja301:4.4": "avyaggatā nikkamanañ ca kāle ",
  "ja301:4.5": "daḷhañ ca viriyaṃ purisaparakkamo ca ",
  "ja301:4.6": "ten' eva āsi vijayo Assakānanti. ",
  "ja301:5.1": ""
}
