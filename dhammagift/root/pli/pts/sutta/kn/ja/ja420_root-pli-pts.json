  "ja420:1.1": "kuddhoti avekkhiyāna ",
  "ja420:1.2": "na tāva daṇḍaṃ panayeyya issaro, ",
  "ja420:1.3": "aṭṭhānaso appatirūpam attano ",
  "ja420:1.4": "parassa dukkhāni bhusaṃ udīraye. ",
  "ja420:2.1": "Yato ca jāneyya pasādam attano ",
  "ja420:2.2": "atthaṃ niyuñjeyya parassa dukkataṃ, ",
  "ja420:2.3": "tadāyam atthoti sayaṃ avekkhiya ",
  "ja420:2.4": "ath' assa daṇḍaṃ sadisaṃ nivesaye. ",
  "ja420:3.1": "Na cāpi jhāpeti paraṃ na attanaṃ ",
  "ja420:3.2": "amucchito yo nayate nayānayaṃ ",
  "ja420:3.3": "yo daṇḍadhāro bhavatīdha issaro ",
  "ja420:3.4": "sa vaṇṇagutto siriyā na dhaṃsati. ",
  "ja420:4.1": "Ye khattiyāse anisammakārino ",
  "ja420:4.2": "paṇenti daṇḍaṃ sahasā pamucchitā ",
  "ja420:4.3": "avaṇṇasaṃyuttā jahanti jīvitaṃ, ",
  "ja420:4.4": "ito vimuttāpi ca yanti duggatiṃ. ",
  "ja420:5.1": "Dhamme ca ye ariyapavedite ratā (Cfr. Dhp. v. 79. ",
  "ja420:5.2": "anuttarā te vacasā manasā kammanā ca, ",
  "ja420:5.3": "te santisoraccasamādhisaṇṭhitā ",
  "ja420:5.4": "vajanti lokaṃ dubhayaṃ tathāvidhā. ",
  "ja420:6.1": "Rājāham asmi narapamadānam issaro, ",
  "ja420:6.2": "sace pi kujjhāmi ṭhapemi attanaṃ, ",
  "ja420:6.3": "nisedhayanto janataṃ tathāvidhaṃ ",
  "ja420:6.4": "paṇemi daṇḍaṃ anukampa yonisoti ",
  "ja420:7.1": "Siriñ ca lakkhiñ ca tam eva khattiya ",
  "ja420:7.2": "janādhipa mā vijahi kudācanaṃ, ",
  "ja420:7.3": "akkodhano niccapasannacitto ",
  "ja420:7.4": "anīgho tuvaṃ vassasatāni pālaya. ",
  "ja420:8.1": "Guṇehi etehi upeta khattiya ",
  "ja420:8.2": "ṭhitamariyavattī suvaco akodhano ",
  "ja420:8.3": "sukhī anuppīḷa pasāsa mediniṃ, ",
  "ja420:8.4": "ito vimutto pi ca yāhi suggatiṃ. ",
  "ja420:9.1": "Evaṃ suvinītena subhāsitena ",
  "ja420:9.2": "dhammena ñāyena upāyaso nayaṃ ",
  "ja420:9.3": "nibbāpaye saṃkhubhitaṃ mahājanaṃ ",
  "ja420:9.4": "mahā va megho salilena medininti. ",
  "ja420:10.1": ""
}
