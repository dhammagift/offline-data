  "ja387:0.4": "",
  "ja387:1.1": "Akakkasaṃ apharusaṃ ",
  "ja387:1.2": "kharadhotaṃ supāsiyaṃ ",
  "ja387:1.3": "sukhumaṃ tikhiṇaggañ ca ",
  "ja387:1.4": "ko sūciṃ ketum icchatīti. ",
  "ja387:2.1": "Sumajjañ ca supāsañ ca ",
  "ja387:2.2": "anupubbaṃ suvaṭṭitaṃ ",
  "ja387:2.3": "ghanaghātimaṃ paṭitthaddhaṃ ",
  "ja387:2.4": "ko sūciṃ ketum icchatīti. ",
  "ja387:3.1": "Ito dāni patāyanti ",
  "ja387:3.2": "sūciyo balisāni ca, ",
  "ja387:3.3": "ko 'yaṃ kammāragāmasmiṃ ",
  "ja387:3.4": "sūcī vikketum icchati. ",
  "ja387:4.1": "Ito satthāni gacchanti ",
  "ja387:4.2": "kammantā vividhā puthū, ",
  "ja387:4.3": "ko 'yaṃ kammāragāmasmiṃ ",
  "ja387:4.4": "sūcī vikketum arahatīti. ",
  "ja387:5.1": "Sūciṃ kammāragāmasmiṃ ",
  "ja387:5.2": "vikketabbā pajānatā, ",
  "ja387:5.3": "ācariyā va sañjānanti ",
  "ja387:5.4": "kammaṃ sukatadukkataṃ. ",
  "ja387:6.1": "Imañ ca te pitā bhadde ",
  "ja387:6.2": "sūciṃ jaññā mayā kataṃ ",
  "ja387:6.3": "tayā ca maṃ nimanteyya ",
  "ja387:6.4": "yañ c' atth' aññaṃ ghare dhananti. Navachandake ",
  "ja387:7.1": ""
}
