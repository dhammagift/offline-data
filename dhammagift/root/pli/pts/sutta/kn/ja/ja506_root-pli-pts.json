  "ja506:0.4": "",
  "ja506:1.1": "Kā nu vijju-r-ivābhāsi ",
  "ja506:1.2": "osadhī viya tārakā, ",
  "ja506:1.3": "devatā nu si gandhabbī, ",
  "ja506:1.4": "na taṃ maññāmi mānusinti. ",
  "ja506:2.1": "N' amhi devī na gandhabbī ",
  "ja506:2.2": "na mahārāja mānusī, ",
  "ja506:2.3": "nāgakaññ' amhi bhadante, ",
  "ja506:2.4": "atthen' amhi idhāgatā. ",
  "ja506:3.1": "Vibbhantacittā kupitindriyāsi, ",
  "ja506:3.2": "nettehi te vārigaṇā savanti, ",
  "ja506:3.3": "kin te naṭṭhaṃ, kim pana patthayānā ",
  "ja506:3.4": "idhāgatā nāri, tad iṃgha brūhi. ",
  "ja506:4.1": "Yam uggatejo uragoti cāhu ",
  "ja506:4.2": "nāgoti taṃ āhu jano janinda ",
  "ja506:4.3": "tam aggahī puriso jīvikattho, ",
  "ja506:4.4": "taṃ bandhanā muñca. patī mam' eso. ",
  "ja506:5.1": "Kathaṃ nv-ayaṃ balaviriyūpapanno ",
  "ja506:5.2": "hatthattham āgañchi vanibbakassa, ",
  "ja506:5.3": "akkhāhi me nāgakaññe tam atthaṃ, ",
  "ja506:5.4": "kathaṃ vijānemu gahītanāgaṃ. ",
  "ja506:6.1": "Nagaram pi nāgo bhasmaṃ kareyya, ",
  "ja506:6.2": "tathā hi so balaviriyūpapanno, ",
  "ja506:6.3": "dhammañ ca nāgo apacāyamāno, ",
  "ja506:6.4": "tasmā parakkamma tapo karotīti. ",
  "ja506:7.1": "Cātuddasiṃ pannarasiñ ca rāja ",
  "ja506:7.2": "catuppathe sammati nāgarājā, ",
  "ja506:7.3": "tam aggahī puriso jīvikattho, ",
  "ja506:7.4": "taṃ bandhanā muñca. patī mam' esoti gātham āha. ",
  "ja506:8.1": "Soḷas' itthisahassāni ",
  "ja506:8.2": "āmuttamaṇikuṇḍalā ",
  "ja506:8.3": "vārigehāsayā nāriyo ",
  "ja506:8.4": "tāpi taṃ saraṇaṃ gatā. ",
  "ja506:9.1": "Dhammena mocehi asāhasena ",
  "ja506:9.2": "gāmena nikkhena gavaṃ satena, ",
  "ja506:9.3": "ossaṭṭhakāyo urago carātu, ",
  "ja506:9.4": "puññatthiko muñcatu bandhanasmāti. ",
  "ja506:10.1": "Dhammena mocemi asāhasena ",
  "ja506:10.2": "gāmena nikkhena gavaṃ satena. ",
  "ja506:10.3": "ossaṭṭhakāyo urago carātu, ",
  "ja506:10.4": "puññatthiko muññcatu bandhanasmā. ",
  "ja506:11.1": "Dammi nikkhasataṃ ludda ",
  "ja506:11.2": "thullañ ca maṇikuṇḍalaṃ ",
  "ja506:11.3": "catussadañ ca pallaṃkaṃ ",
  "ja506:11.4": "ummāpupphasirinnibhaṃ. ",
  "ja506:12.1": "Dve ca sādisiyo bhariyā ",
  "ja506:12.2": "usabhañ ca gavaṃ sataṃ, ",
  "ja506:12.3": "ossaṭṭhakāyo urago carātu, ",
  "ja506:12.4": "puññatthiko muñcatu bandhanasmāti. ",
  "ja506:13.1": "Vināpi dānā tava vacanaṃ janinda, ",
  "ja506:13.2": "muñcemu naṃ uragaṃ bandhanasmā, ",
  "ja506:13.3": "ossaṭṭhakāyo urago carātu, ",
  "ja506:13.4": "puññatthiko muñcatu bandhanasmāti. ",
  "ja506:14.1": "Mutto Campeyyako nāgo ",
  "ja506:14.2": "rājānaṃ etad abravi: ",
  "ja506:14.3": "namo te Kāsirāj' atthu ",
  "ja506:14.4": "namo te Kāsivaddhana, ",
  "ja506:14.5": "añjalin te pagaṇhāmi, ",
  "ja506:14.6": "paseyyam me nivesanaṃ. ",
  "ja506:15.1": "Addhā hi dubbissasam etam āhu ",
  "ja506:15.2": "yaṃ mānuso vissase amānusamhi, ",
  "ja506:15.3": "sace ca maṃ yācasi etam atthaṃ ",
  "ja506:15.4": "dakkhemu te nāga nivesanānīti. Sace ",
  "ja506:16.1": "hi vāto girim āvaheyya ",
  "ja506:16.2": "cando ca suriyo ca chamā pateyyuṃ ",
  "ja506:16.3": "subbā ca najjo paṭisotaṃ vajeyyuṃ ",
  "ja506:16.4": "na tv-ev' ahaṃ rāja musā bhaṇeyyaṃ. ",
  "ja506:17.1": "Nabhaṃ phaleyya udadhī pi susse ",
  "ja506:17.2": "saṃvaṭṭayaṃ bhūtadharā vasundharā ",
  "ja506:17.3": "siluccayo Meru samūlam ubbahe ",
  "ja506:17.4": "na tv-ev' ahaṃ rāja musā bhaṇeyyanti. ",
  "ja506:18.1": "Addhā hi dubbissasam etam āhu ",
  "ja506:18.2": "yaṃ mānuso vissase amānusamhi, ",
  "ja506:18.3": "",
  "ja506:18.4": "",
  "ja506:19.1": "Tumhe kho 'ttha ghoravisā uḷārā, ",
  "ja506:19.2": "mahātejā khippakopī ca hotha, ",
  "ja506:19.3": "mama kāraṇā bandhanasmā pamutto ",
  "ja506:19.4": "arahasi no jānitaye katānīti. ",
  "ja506:20.1": "So paccataṃ niraye ghorarūpe ",
  "ja506:20.2": "mā kāyikaṃ sātam alattha kiñci ",
  "ja506:20.3": "peḷāya baddho maraṇaṃ upetu ",
  "ja506:20.4": "yo tādisaṃ kamma kataṃ na jāneti gātham āha. ",
  "ja506:21.1": "Saccappaṭiññā tavam esa hotu, ",
  "ja506:21.2": "akkodhano hohi anūpanāhī, ",
  "ja506:21.3": "sabbañ ca te nāgakulaṃ supaṇṇā ",
  "ja506:21.4": "aggiṃ va gimhāsu vivajjayantūti. ",
  "ja506:22.1": "Anukampasī nāgakulaṃ janinda ",
  "ja506:22.2": "mātā yathā suppiyaṃ ekaputtaṃ, ",
  "ja506:22.3": "ahañ ca te nāgakulena saddhiṃ ",
  "ja506:22.4": "kāhāmi veyyāvaṭikaṃ uḷāranti. ",
  "ja506:23.1": "Yojentu ve rājarathe sucitte ",
  "ja506:23.2": "kambojake assatare sudante, ",
  "ja506:23.3": "nāge ca yojentu suvaṇṇakappane, ",
  "ja506:23.4": "dakkhemu nāgassa nivesanānīti gātham ",
  "ja506:24.1": "āha. Bherīmutiṅgā paṇavā ca saṃkhā ",
  "ja506:24.2": "āvajjayiṃsu Uggasenassa rañño, ",
  "ja506:24.3": "pāyāsi rājā bahu sobhamāno ",
  "ja506:24.4": "purakkhato nārigaṇassa majjheti. ",
  "ja506:25.1": "Suvaṇṇacitakaṃ bhūmiṃ ",
  "ja506:25.2": "addakkhi Kāsivaddhano ",
  "ja506:25.3": "sovaṇṇaye ca pāsāde ",
  "ja506:25.4": "veluriyaphalakatthate. ",
  "ja506:26.1": "Sa rājā pāvisī vyamhaṃ ",
  "ja506:26.2": "Campeyyassa nivesanaṃ ",
  "ja506:26.3": "ādiccavaṇṇupanibhaṃ ",
  "ja506:26.4": "kaṃsavijjupabhassaraṃ. ",
  "ja506:27.1": "Nānārukkhehi sañchannaṃ ",
  "ja506:27.2": "nānāgandhasameritaṃ ",
  "ja506:27.3": "so pāvekkhi Kāsirājā ",
  "ja506:27.4": "Campeyyassa nivesanaṃ. ",
  "ja506:28.1": "Paviṭṭhamhi Kāsirañño ",
  "ja506:28.2": "Campeyyassa nivesane ",
  "ja506:28.3": "dibbā turiyā vajjiṃsu ",
  "ja506:28.4": "nāgakaññā ca naccayuṃ. ",
  "ja506:29.1": "Taṃ nāgakaññā caritaṃ gaṇena ",
  "ja506:29.2": "anvāruhi Kāsirājā pasanno. ",
  "ja506:29.3": "nisīdi sovaṇṇamayamhi pīṭhe ",
  "ja506:29.4": "sāpassaye candanasāralitteti āha. ",
  "ja506:30.1": "So tattha bhutvā ca atho ramitvā ",
  "ja506:30.2": "Campeyyakaṃ Kāsirājā avoca: ",
  "ja506:30.3": "vimānaseṭṭhāni imāni tuyhaṃ ",
  "ja506:30.4": "ādiccavaṇṇāni pabhassarāni, ",
  "ja506:30.5": "n' etādisaṃ atthi manussaloke, ",
  "ja506:30.6": "kimatthiyaṃ nāga tapo karosi. ",
  "ja506:31.1": "Tā kambukāyūradharā suvatthā ",
  "ja506:31.2": "vaṭṭaṅgulī tambatalūpapannā ",
  "ja506:31.3": "paggayha pāyenti anomavaṇṇā, ",
  "ja506:31.4": "n' etādisaṃ atthi manussaloke, ",
  "ja506:31.5": "kimatthiyaṃ nāga tapo karosi. ",
  "ja506:32.1": "Najjo ca khemā puthulomamacchā ",
  "ja506:32.2": "adāsakuntābhirudā sutitthā, ",
  "ja506:32.3": "n' etādisaṃ ",
  "ja506:32.4": "etc. ",
  "ja506:33.1": "Koñcā mayūrā diviyā ca haṃsā ",
  "ja506:33.2": "vaggussarā kokilā sampatanti, ",
  "ja506:33.3": "etc. ",
  "ja506:33.4": "",
  "ja506:34.1": "Ambā ca sālā tilakā ca jambuyo ",
  "ja506:34.2": "uddālakā pāṭaliyo ca phullā, ",
  "ja506:34.3": "etc. ",
  "ja506:34.4": "",
  "ja506:35.1": "Imā ca te pokkharañño samantato ",
  "ja506:35.2": "diviyā ca gandhā satataṃ sampatanti. ",
  "ja506:35.3": "n' etadisaṃ atthi manussaloke, ",
  "ja506:35.4": "kimatthiyaṃ nāga tapo karosi. ",
  "ja506:36.1": "Na puttahetu na dhanassa hetu ",
  "ja506:36.2": "na āyuno vāpi janinda hetu, ",
  "ja506:36.3": "manussayoniṃ abhipatthayāno ",
  "ja506:36.4": "tasmā parakkamma tapo karomīti. ",
  "ja506:37.1": "Tvaṃ lohitakkho vihatantaraṃso ",
  "ja506:37.2": "alaṃkato kappitakesamassu ",
  "ja506:37.3": "surosito lohitacandanena ",
  "ja506:37.4": "gandhabbarājā va disā pabhāsasi. ",
  "ja506:38.1": "Deviddhipatto si mahānubhāvo ",
  "ja506:38.2": "sabbehi kāmehi samaṅgibhūto, ",
  "ja506:38.3": "pucchāmi taṃ nāgarāje tam atthaṃ: ",
  "ja506:38.4": "seyyo ito kena manussalokoti āha. ",
  "ja506:39.1": "Janinda nāññatra manussalokā ",
  "ja506:39.2": "suddhī ca saṃvijjati saṃyamo ca, ",
  "ja506:39.3": "ahañ ca laddhāna manussayoniṃ ",
  "ja506:39.4": "kāhāmi jātimaraṇassa antanti. ",
  "ja506:40.1": "Addhā have sevitabbā sapaññā (supra 453|15) ",
  "ja506:40.2": "bahussutā ye bahuṭhānacintino, ",
  "ja506:40.3": "nariyo ca disvāna tavañ ca nāga ",
  "ja506:40.4": "kāhāmi puññani anappakānīti. ",
  "ja506:41.1": "Addhā have sevitabbā sapaññā ",
  "ja506:41.2": "bahussutā ye bahuṭhānacintino, ",
  "ja506:41.3": "nariyo ca disvāna mamañ ca rāja ",
  "ja506:41.4": "karohi puṇṇāni anappakānīti āha. ",
  "ja506:42.1": "Idañ ca me jātarūpaṃ pahūtaṃ ",
  "ja506:42.2": "rāsī suvaṇṇassa ca tālamattā, ",
  "ja506:42.3": "ito haritvā sovaṇṇagharāni. [kāraya] ",
  "ja506:42.4": "rūpiyassa ca pākāraṃ karontu. ",
  "ja506:43.1": "Muttā ca vāhasahassāni pañca ",
  "ja506:43.2": "veḷuriyamissāni ito haritvā ",
  "ja506:43.3": "antepure bhūmiyaṃ santharantu, ",
  "ja506:43.4": "nikkaddamā hohiti nīrajā ca. ",
  "ja506:44.1": "Etādisaṃ āvasa rājaseṭṭha ",
  "ja506:44.2": "vimānaseṭṭhaṃ bahu sobhamānaṃ ",
  "ja506:44.3": "Bārāṇasiṃ nagaraṃ iddhaphītaṃ ",
  "ja506:44.4": "rajjañ ca kārehi anomapaññāti. ",
  "ja506:45.1": ""
}
