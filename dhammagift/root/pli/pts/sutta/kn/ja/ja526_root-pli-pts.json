{
  "ja526:0.1": "",
  "ja526:0.2": "",
  "ja526:0.3": "",
  "ja526:0.4": "",
  "ja526:1.1": "Uḍḍayhate janapado ",
  "ja526:1.2": "raṭṭhañ cāpi vinassati, ",
  "ja526:1.3": "ehi Naḷinike gaccha, ",
  "ja526:1.4": "tam me brāhmaṇam ānayāti. ",
  "ja526:2.1": "Nāhaṃ dukkhakkhamā rāja, ",
  "ja526:2.2": "nāhaṃ addhānakovidā, ",
  "ja526:2.3": "kathaṃ ahaṃ gamissāmi ",
  "ja526:2.4": "vanaṃ kuñjarasevitanti. ",
  "ja526:3.1": "Phītaṃ janapadaṃ gantvā ",
  "ja526:3.2": "hatthinā ca rathena ca ",
  "ja526:3.3": "dārusaṃghāṭayānena ",
  "ja526:3.4": "evaṃ gaccha Naḷīniye. Hatthī ",
  "ja526:4.1": "assarathā patti -- ",
  "ja526:4.2": "gacch' evādāya khattiye ",
  "ja526:4.3": "tav' eva vaṇṇarūpena ",
  "ja526:4.4": "vasaṃ taṃ ānayissasīti. ",
  "ja526:5.1": "Kadalidhajapaññāṇo ",
  "ja526:5.2": "ābhujīparivāraṇo ",
  "ja526:5.3": "eso padissati rammo ",
  "ja526:5.4": "Isisiṅgassa assamo. ",
  "ja526:6.1": "Eso aggi 'ssa saṃkhāto, ",
  "ja526:6.2": "eso dhūmo padissati, ",
  "ja526:6.3": "maññe no aggiṃ hāpeti ",
  "ja526:6.4": "Isisiṅgo mahiddhikoti. ",
  "ja526:7.1": "Tañ ca disvāna āyantiṃ ",
  "ja526:7.2": "āmuttamaṇikuṇḍalaṃ ",
  "ja526:7.3": "Isisiṅgo pāvisi bhīto ",
  "ja526:7.4": "assamaṃ paṇṇachādanaṃ. ",
  "ja526:8.1": "Assamassa ca sā dvāre ",
  "ja526:8.2": "bheṇḍuken' assa kīḷati ",
  "ja526:8.3": "vidaṃsayantī aṅgāni ",
  "ja526:8.4": "guyhaṃ pakāsitāni ca. ",
  "ja526:9.1": "Tañ ca disvāna kīḷantiṃ ",
  "ja526:9.2": "paṇṇasālaṃ gato jaṭī, ",
  "ja526:9.3": "assamā nikkhamitvāna ",
  "ja526:9.4": "idaṃ vacanam abravīti. ",
  "ja526:10.1": "Ambho ko nāma so rukkho ",
  "ja526:10.2": "yassa tevaṃgataṃ phalaṃ, ",
  "ja526:10.3": "dūre pi khittaṃ pacceti, ",
  "ja526:10.4": "na taṃ ohāya gacchatīti kathesi. ",
  "ja526:11.1": "Assamassa mama brahme ",
  "ja526:11.2": "samīpe Gandhamādane ",
  "ja526:11.3": "bahavo tādisā rukkhā ",
  "ja526:11.4": "yassa tevaṃgataṃ phalaṃ, ",
  "ja526:11.5": "dūre pi khittaṃ pacceti, ",
  "ja526:11.6": "na maṃ ohāya gacchatīti g. ā. ",
  "ja526:12.1": "Etū bhavaṃ assam' imaṃ adetu, ",
  "ja526:12.2": "pajjañ ca bhakkhañ ca paṭiccha dammi, ",
  "ja526:12.3": "idam āsanaṃ atrabhavaṃ nisīdatu, ",
  "ja526:12.4": "ito bhavaṃ mūlaphalāni bhuñjatūti g. ",
  "ja526:13.1": "ā. Kin te idaṃ ūrunam antarasmiṃ ",
  "ja526:13.2": "supicchitaṃ kaṇha-r-iva-ppakāsati, ",
  "ja526:13.3": "akkhāhi me pucchito etam atthaṃ, ",
  "ja526:13.4": "kose nu te uttamaṅgam paviṭṭhanti. ",
  "ja526:14.1": "Ahaṃ vane mūlaphalesanam caraṃ ",
  "ja526:14.2": "āsādayiṃ acchaṃ sughorarūpaṃ, ",
  "ja526:14.3": "",
  "ja526:14.4": "",
  "ja526:15.1": "Sv-āyaṃ vaṇo khajjati kaṇḍuvāyati, ",
  "ja526:15.2": "sabbañ ca kālaṃ na labhāmi sātaṃ, ",
  "ja526:15.3": "paho bhavaṃ kaṇḍum imaṃ vinetuṃ, ",
  "ja526:15.4": "kurute bhavaṃ yācito brāhmaṇatthanti. ",
  "ja526:16.1": "Gambhīrarūpo te vaṇo salohito ",
  "ja526:16.2": "apūtiko pannagandho mahā ca, ",
  "ja526:16.3": "karomi te kiñci kasāyayogaṃ ",
  "ja526:16.4": "yathā bhavaṃ paramasukhī bhaveyyāti. ",
  "ja526:17.1": "Na mantayogā na kasāvayogā ",
  "ja526:17.2": "na osadhā brahmacārī kamanti, ",
  "ja526:17.3": "yam te mudū tena vinehi kaṇḍukaṃ ",
  "ja526:17.4": "yathā ahaṃ paramasukhī bhaveyyanti. ",
  "ja526:18.1": "Ito nu bhoto katamena assamo, ",
  "ja526:18.2": "kacci bhavaṃ abhiramasī araññe, ",
  "ja526:18.3": "kacci te mūlaphalaṃ pahūtaṃ, ",
  "ja526:18.4": "kacci bhavantaṃ na vihiṃsanti vāḷāti g. ā. ",
  "ja526:19.1": "Ito ujuṃ uttarāyaṃ disāyaṃ ",
  "ja526:19.2": "Khemā nadī Himavantā pabhāti, ",
  "ja526:19.3": "tassā tīre assamo mayha rammo, ",
  "ja526:19.4": "aho bhavaṃ assamaṃ mayhaṃ passe. ",
  "ja526:20.1": "Ambā ca sālā tilakā ca jambuyo (IV 466|6) ",
  "ja526:20.2": "uddālakā pāṭaliyo ca phullā, ",
  "ja526:20.3": "samantato kimpurisābhigītaṃ ",
  "ja526:20.4": "aho bhavaṃ assamaṃ mayha passe. ",
  "ja526:21.1": "Tālā ca mūlā ca phalā ca mettha, ",
  "ja526:21.2": "vaṇṇena gandhena upetarūpaṃ ",
  "ja526:21.3": "",
  "ja526:21.4": "",
  "ja526:22.1": "Phalā ca mūlā ca pahūta mettha ",
  "ja526:22.2": "vaṇṇena gandhena rasen' upetā, ",
  "ja526:22.3": "āyanti ca luddakā taṃ padesaṃ, ",
  "ja526:22.4": "mā me tato mūlaphalaṃ ahaṃsūti. ",
  "ja526:23.1": "Pitā mamaṃ mūlaphalesanaṃ gato ",
  "ja526:23.2": "idāni āgacchati sāyakāle, ",
  "ja526:23.3": "ubho va gacchāmase assamaṃ taṃ ",
  "ja526:23.4": "yāva pitā mūlaphalato etūti. ",
  "ja526:24.1": "Aññe bahū isayo sādhurūpā ",
  "ja526:24.2": "rājīsayo anumagge vasanti, ",
  "ja526:24.3": "te yeva pucchesi mam' assaman taṃ ",
  "ja526:24.4": "te taṃ nayissanti mamaṃ sakāseti. ",
  "ja526:25.1": "Na te kaṭṭhāni bhinnāni, ",
  "ja526:25.2": "na te udakam ābhataṃ, (IV 221|19) ",
  "ja526:25.3": "aggi pi te na hāpito, ",
  "ja526:25.4": "kin nu mando va jhāyasi. ",
  "ja526:26.1": "Bhinnāni kaṭṭhāni huto ca aggi ",
  "ja526:26.2": "tapanī pi te samitā brahmacārī ",
  "ja526:26.3": "pīṭhañ ca mayhaṃ udakañ ca hoti ",
  "ja526:26.4": "ramasi tuvaṃ brahmabhūto puratthā. ",
  "ja526:27.1": "Abhinnakaṭṭho si anābhatodako ",
  "ja526:27.2": "ahāpitaggī si asiddhabhojano ",
  "ja526:27.3": "na me tuvaṃ ālapasī mam' ajja, ",
  "ja526:27.4": "naṭṭhan nu kiṃ cetasikañci dukkhanti. ",
  "ja526:28.1": "Idhāgamā jaṭilo brahmacārī ",
  "ja526:28.2": "sudassaneyyo sutanū vineti ",
  "ja526:28.3": "n' evātidīgho na punātirasso ",
  "ja526:28.4": "sukaṇhakaṇhacchadanehi bhoto. ",
  "ja526:29.1": "Amassu jāto apurāṇavaṇṇī, ",
  "ja526:29.2": "ādhārarūpañ ca pan' assa kaṇṭhe, ",
  "ja526:29.3": "dv' āssa gaṇḍā ure sujātā ",
  "ja526:29.4": "sovaṇṇapiṇḍūpanibhā pabhassarā. ",
  "ja526:30.1": "Mukhañ ca tassa bhusadassaneyyaṃ, ",
  "ja526:30.2": "kaṇṇesu lambanti ca kuñcitaggā, ",
  "ja526:30.3": "te jotare carato māṇavassa ",
  "ja526:30.4": "suttañ ca yaṃ saṃyamanaṃ jaṭānaṃ. ",
  "ja526:31.1": "Aññā ca tassa saññamanī catasso ",
  "ja526:31.2": "nīlāpi tā lohitakā ca satā ",
  "ja526:31.3": "tā piṃsare carato māṇavassa ",
  "ja526:31.4": "cirīṭisaṃghā-r-iva pāvusamhi. ",
  "ja526:32.1": "Na mekhalaṃ muñjamayaṃ dhareti, ",
  "ja526:32.2": "na santacaṃ no pana pabbaj' assa, ",
  "ja526:32.3": "",
  "ja526:32.4": "",
  "ja526:33.1": "Akhīlakāni ca avaṇṭakāni ",
  "ja526:33.2": "heṭṭhā nabhyā kaṭisamohitāni ",
  "ja526:33.3": "avighaṭṭitā niccaṃ kiliṃ karonti, ",
  "ja526:33.4": "han tāta kiṃ rukkhaphalāni tāni. ",
  "ja526:34.1": "Jaṭā ca tassa bhusadassaneyyā ",
  "ja526:34.2": "parosataṃ vellitaggā sugandhā, ",
  "ja526:34.3": "dvedhāsiro sādhuvibhattarūpo, ",
  "ja526:34.4": "aho nu kho mayha tathā jaṭāssu. ",
  "ja526:35.1": "Yadā ca so parikati tā jaṭāyo ",
  "ja526:35.2": "vaṇṇena gandhena upetarūpā ",
  "ja526:35.3": "nīluppalaṃ vātasameritam va ",
  "ja526:35.4": "tath eva saṃkhāti vanassamo ayaṃ. ",
  "ja526:36.1": "Paṃko ca tassa bhusadassaneyyo ",
  "ja526:36.2": "n' etādiso yādiso mayha kāyo, ",
  "ja526:36.3": "so vāyatī erito mālutena ",
  "ja526:36.4": "vanaṃ yathā aggagimhesu phullaṃ. ",
  "ja526:37.1": "Nihanti so rukkhaphalaṃ pathavyā ",
  "ja526:37.2": "sucittarūpaṃ ruciraṃ dassaneyyaṃ ",
  "ja526:37.3": "khittañ ca nassa punar eti hatthaṃ, ",
  "ja526:37.4": "han tāta kiṃ rukkhaphalan nu kho taṃ. ",
  "ja526:38.1": "Dantā ca tassa bhusadassaneyyā ",
  "ja526:38.2": "suddhā samā saṃkhavarūpapannā ",
  "ja526:38.3": "mano pasādenti vivariyamānā, ",
  "ja526:38.4": "na ha nūna so sākam akhādi tehi. ",
  "ja526:39.1": "Akakkasaṃ agaḷitaṃ muhuṃ muduṃ ",
  "ja526:39.2": "(ujuṃ) anuddhataṃ acapalam assa bhāsitaṃ, ",
  "ja526:39.3": "",
  "ja526:39.4": "",
  "ja526:40.1": "Bindussaro nātivissaṭṭhavākyo ",
  "ja526:40.2": "na nūna sajjhāyamatippayutto, ",
  "ja526:40.3": "icchāmi kho taṃ punar eva daṭṭhuṃ ",
  "ja526:40.4": "mittaṃ hi me māṇav' āhū puratthā. ",
  "ja526:41.1": "Susandhi sabbattha vimaṭṭh' imaṃ vaṇaṃ ",
  "ja526:41.2": "puthuṃ sujātaṃ kharapattasannibhaṃ -- ",
  "ja526:41.3": "ten' eva maṃ uttariyāna māṇavo ",
  "ja526:41.4": "vivariya ūruṃ jaghanena pīḷayi. ",
  "ja526:42.1": "Tapanti ābhanti virocare va ",
  "ja526:42.2": "sateratā vijjur-iv' antalikkhe ",
  "ja526:42.3": "bāhā mudū añjanalomasādisā ",
  "ja526:42.4": "vicitravaṭṭaṅgulikāssa sobhare. ",
  "ja526:43.1": "Akakkasaṅgo na ca dīghalomo ",
  "ja526:43.2": "nakhāssa dūghā api lohitaggā, ",
  "ja526:43.3": "mudūhi bāhāhi palissajanto ",
  "ja526:43.4": "kalyāṇarūpo ramayaṃ upaṭṭhahi. ",
  "ja526:44.1": "Dumassa tūlūpanibhā pabhassarā ",
  "ja526:44.2": "suvaṇṇakambūtalavaṭṭasucchavī ",
  "ja526:44.3": "hatthā mudū, tehi maṃ saṃphusitvā ",
  "ja526:44.4": "ito gato, te maṃ dahanti tāta. ",
  "ja526:45.1": "Na ha nūna so khārividhaṃ ahāsi, ",
  "ja526:45.2": "na nūna kaṭṭhāni sayaṃ abhañji, ",
  "ja526:45.3": "na nūna so hanti dume kuṭhāriyā, ",
  "ja526:45.4": "na pi 'ssa hatthesu khīḷāni atthi. ",
  "ja526:46.1": "Accho ca kho tassa vaṇaṃ akāsi, ",
  "ja526:46.2": "so maṃ bravi: sukhitaṃ maṃ karohi, ",
  "ja526:46.3": "",
  "ja526:46.4": "",
  "ja526:47.1": "Ayañ ca te māluvapaṇṇasanthatā ",
  "ja526:47.2": "vikiṇṇarūpā va mayā ca tena ca, ",
  "ja526:47.3": "kilantarūpā udake ramitvā ",
  "ja526:47.4": "punappunaṃ c' assa kuṭiṃ vajāma. ",
  "ja526:48.1": "Na m' ajja mantā paṭibhanti tāta ",
  "ja526:48.2": "na aggihuttaṃ na pi yañña tatra, ",
  "ja526:48.3": "na cāpi te mūlaphalāni bhuñje ",
  "ja526:48.4": "yāva na passāmi taṃ brahmacāriṃ. ",
  "ja526:49.1": "Addhā pajānāsi tuvam pi tāta ",
  "ja526:49.2": "yassaṃ disāyaṃ vasate brahmacārī, ",
  "ja526:49.3": "taṃ maṃ disaṃ pāpaya tāta khippaṃ ",
  "ja526:49.4": "mā te ahaṃ amariṃ assamamhi. ",
  "ja526:50.1": "Vicitrapupphaṃ hi vanaṃ sutaṃ mayā ",
  "ja526:50.2": "dijābhighuṭṭhaṃ dijasaṃghasevitaṃ, ",
  "ja526:50.3": "taṃ maṃ disaṃ pāpaya tāta khippaṃ ",
  "ja526:50.4": "purā te pāṇaṃ vijahāmi assameti. ",
  "ja526:51.1": "Imasmā haṃ jotirase vanamhi ",
  "ja526:51.2": "gandhabbadevaccharasaṃghasevite ",
  "ja526:51.3": "",
  "ja526:51.4": "",
  "ja526:52.1": "Bhavanti mittāni atha na honti, ",
  "ja526:52.2": "ñātīsu mittesu karonti pemaṃ, ",
  "ja526:52.3": "ayañ ca jammo kissa vā niviṭṭho ",
  "ja526:52.4": "yo n' eva jānāti; kuto 'mhi āgato. ",
  "ja526:53.1": "Saṃvāsena hi mittāni ",
  "ja526:53.2": "sandhīyanti punappunaṃ, ",
  "ja526:53.3": "sā ca metti asaṅgantu ",
  "ja526:53.4": "asaṃvāsena jīrati. ",
  "ja526:54.1": "Sace tuvaṃ dakkhasi brahmacāriṃ ",
  "ja526:54.2": "sace tuvaṃ sallape brahmacārinā ",
  "ja526:54.3": "sampannasassaṃ va mahodakena ",
  "ja526:54.4": "tapoguṇaṃ khippam imaṃ pahassasi. Punap- ",
  "ja526:55.1": "pi ce dakkhasi brahmacāriṃ ",
  "ja526:55.2": "punap-pi ce sallape brahmacārinā ",
  "ja526:55.3": "sampannasassaṃ va mahodakena ",
  "ja526:55.4": "usmāgataṃ khippam imaṃ pahassasi. ",
  "ja526:56.1": "Bhūtāni etāni caranti tāta ",
  "ja526:56.2": "virūparūpena manussaloke. ",
  "ja526:56.3": "na tāni sevetha naro sapañño, ",
  "ja526:56.4": "āsajjanaṃ tassati brahmacārīti. ",
  "ja526:57.1": ""
}
