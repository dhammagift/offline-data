  "ja382:0.4": "",
  "ja382:1.1": "Kā nu kāḷena vaṇṇena ",
  "ja382:1.2": "na cāpi piyadassanā, ",
  "ja382:1.3": "kā vā tvaṃ kassa vā dhītā, ",
  "ja382:1.4": "kathaṃ jānemu taṃ mayanti. ",
  "ja382:2.1": "Mahārājass' ahaṃ dhītā ",
  "ja382:2.2": "Virūpakkhassa caṇḍiyā, ",
  "ja382:2.3": "ahaṃ Kālī alakkhikā, ",
  "ja382:2.4": "Kālakaṇṇīti maṃ vidū, ",
  "ja382:2.5": "okāsaṃ yācito dehi, ",
  "ja382:2.6": "vasemu tava santiketi. ",
  "ja382:3.1": "Kiṃsīle kiṃsamācāre ",
  "ja382:3.2": "purise nivase tuvaṃ, ",
  "ja382:3.3": "puṭṭhā me Kāli akkhāhi ",
  "ja382:3.4": "yathā jānemu taṃ mayanti. ",
  "ja382:4.1": "Makkhī palāsī sārambhī ",
  "ja382:4.2": "issukī maccharī saṭho ",
  "ja382:4.3": "so mayhaṃ puriso kanto ",
  "ja382:4.4": "laddhaṃ yassa vinassatīti. ",
  "ja382:5.1": "Kodhano upanāhī ca ",
  "ja382:5.2": "pisuno hi vibhedako ",
  "ja382:5.3": "aṇḍakavāco pharuso ",
  "ja382:5.4": "so me kantataro tato. ",
  "ja382:6.1": "Ajja-ssuveti puriso ",
  "ja382:6.2": "sadatthaṃ nāvabujjhati, ",
  "ja382:6.3": "ovajjamāno kuppati, ",
  "ja382:6.4": "seyyaṃ so atimaññati. ",
  "ja382:7.1": "Davappaladdho puriso ",
  "ja382:7.2": "sabbamittehi dhaṃsati, ",
  "ja382:7.3": "so mayhaṃ puriso kanto, ",
  "ja382:7.4": "tasmiṃ homi anāmayāti. ",
  "ja382:8.1": "Apehi etto tvaṃ Kāli, ",
  "ja382:8.2": "n' etaṃ amhesu vijjati, ",
  "ja382:8.3": "aññaṃ janapadaṃ gaccha ",
  "ja382:8.4": "nigame rājadhāniyoti. ",
  "ja382:9.1": "Aham pi kho taṃ jānāmi: ",
  "ja382:9.2": "n' etaṃ tumhesu vijjati, ",
  "ja382:9.3": "santi loke alakkhikā, ",
  "ja382:9.4": "saṃgharanti bahuṃ dhanaṃ, ",
  "ja382:9.5": "ahaṃ Devo ca me bhātā ",
  "ja382:9.6": "ubho naṃ vidhamemasīti. ",
  "ja382:10.1": "Kā nu dibbena vaṇṇena ",
  "ja382:10.2": "pathavyā suppatiṭṭhitā, ",
  "ja382:10.3": "kā vā tvaṃ kassa vā dhītā, ",
  "ja382:10.4": "kathaṃ jānemu taṃ mayanti. ",
  "ja382:11.1": "Mahārājass' ahaṃ dhītā ",
  "ja382:11.2": "Dhataraṭṭhassa sirīmato, ",
  "ja382:11.3": "ahaṃ Sirī ca Lakkhī ca, ",
  "ja382:11.4": "bhūripaññāti maṃ vidū, ",
  "ja382:11.5": "okāsaṃ yācito dehi, ",
  "ja382:11.6": "vasemu tava santiketi. ",
  "ja382:12.1": "Kiṃsīle kiṃsamācāre ",
  "ja382:12.2": "purise nivase tuvaṃ, ",
  "ja382:12.3": "puṭṭhā me Lakkhi akkhāhi ",
  "ja382:12.4": "yathā jānemu taṃ mayaṃ. ",
  "ja382:13.1": "Yo vāpi sīte athavāpi uṇhe ",
  "ja382:13.2": "vātātape ḍaṃsasiriṃsape ca ",
  "ja382:13.3": "khudaṃ pipāsaṃ abhibhuyya sabbaṃ ",
  "ja382:13.4": "rattiṃdivaṃ yo satataṃ niyutto ",
  "ja382:14.1": "kālābhatañ ca na hāpeti atthaṃ ",
  "ja382:14.2": "so me manāpo nivase ca tamhi. ",
  "ja382:14.3": "Akkodhano mittavā cāgavā ca ",
  "ja382:14.4": "sīlūpapanno asaṭho ujjubhūto ",
  "ja382:15.1": "saṃgāhako sakhilo saṇhavāco ",
  "ja382:15.2": "mahattapatto pi nivātavutti ",
  "ja382:15.3": "tasm' āhaṃ pose vipulā bhavāmi ",
  "ja382:15.4": "ūmī samuddassa yathāpi vaṇṇaṃ. ",
  "ja382:16.1": "Yo vāpi mitte athavā amitte ",
  "ja382:16.2": "seṭṭhe sarikkhe athavāpi hīne ",
  "ja382:16.3": "atthaṃ carantaṃ athavā anatthaṃ ",
  "ja382:16.4": "āvī raho saṃgaham eva vatte ",
  "ja382:17.1": "",
  "ja382:17.2": "",
  "ja382:17.3": "Etesaṃ yo aññataraṃ labhitvā ",
  "ja382:17.4": "kantā sirī majjati appapañño ",
  "ja382:17.5": "taṃ dittarūpaṃ visamaṃ carantaṃ ",
  "ja382:17.6": "karīsavācaṃ va vivajjayāmi. ",
  "ja382:18.1": "Attanā kurute lakkhiṃ ",
  "ja382:18.2": "alakkhiṃ kurut' attanā, ",
  "ja382:18.3": "na hi lakkhiṃ alakkhiṃ vā ",
  "ja382:18.4": "añño aññassa kārakoti Sucittapattacchadana lambacūlavihaṅgama ",
  "ja382:19.1": ""
}
