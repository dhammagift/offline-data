{
  "ja374:0.1": "",
  "ja374:0.2": "",
  "ja374:0.3": "",
  "ja374:0.4": "",
  "ja374:1.1": "Sabbaṃ bhaṇḍaṃ samādāya ",
  "ja374:1.2": "pāraṃ tiṇṇo si brāhmaṇa, ",
  "ja374:1.3": "pacchā gaccha lahuṃ, khippaṃ ",
  "ja374:1.4": "mam pi tārehi dān' itoti. ",
  "ja374:2.1": "Asanthutaṃ maṃ cirasanthutena ",
  "ja374:2.2": "(Cfr. supra p. 63.) niminni bhotī adhuvaṃ dhuvena, ",
  "ja374:2.3": "",
  "ja374:2.4": "",
  "ja374:3.1": "Kāyaṃ eḷagalāgumbe ",
  "ja374:3.2": "karoti ahuhāliyaṃ, ",
  "ja374:3.3": "na-y-idha naccaṃ vā gītaṃ vā ",
  "ja374:3.4": "tālaṃ vā susamāhitaṃ, ",
  "ja374:3.5": "anamhakāle sussoṇi ",
  "ja374:3.6": "kin nu jagghasi sobhaṇeti. ",
  "ja374:4.1": "Sigāla bāla dummedha ",
  "ja374:4.2": "appapañño si jambuka, ",
  "ja374:4.3": "jīno macchañ ca pesiñ ca ",
  "ja374:4.4": "kapaṇo viya jhāyasīti. ",
  "ja374:5.1": "Sudassaṃ vajjaṃ aññesaṃ ",
  "ja374:5.2": "attano pana duddasaṃ, ",
  "ja374:5.3": "jīnā patiñ ca jārañ ca tvam pi ",
  "ja374:5.4": "maññe va jhāyasīti. ",
  "ja374:6.1": "Evam etaṃ migarāja ",
  "ja374:6.2": "yathā bhāsasi jambuka, ",
  "ja374:6.3": "sā nūnāhaṃ ito gantvā ",
  "ja374:6.4": "bhattu hessaṃ vasānugāti ",
  "ja374:7.1": "Yo hare mattikāthālaṃ ",
  "ja374:7.2": "kaṃsathālam pi so hare, ",
  "ja374:7.3": "kataṃ yeva tayā pāpaṃ ",
  "ja374:7.4": "puna p' evaṃ karissasīti. ",
  "ja374:8.1": ""
}
