  "ja164:1.1": "Yan nu gijjho yojanasataṃ ",
  "ja164:1.2": "kuṇapāni avekkhati ",
  "ja164:1.3": "kasmā jālañ ca pāsañ ca ",
  "ja164:1.4": "āsajjāpi na bujjhasīti. ",
  "ja164:2.1": "Yadā parābhavo hoti ",
  "ja164:2.2": "poso jīvitasaṃkhaye ",
  "ja164:2.3": "atha jālañ ca pāsañ ca ",
  "ja164:2.4": "āsajjāpi na bujjhatīti. ",
  "ja164:3.1": ""
}
