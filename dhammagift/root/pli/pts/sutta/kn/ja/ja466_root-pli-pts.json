  "ja466:0.3": "",
  "ja466:0.4": "",
  "ja466:1.1": "Kasanti vapanti te janā ",
  "ja466:1.2": "manujā kammaphalūpajīvino, ",
  "ja466:1.3": "na-y-imassa raṭṭhassa bhāgino, ",
  "ja466:1.4": "Jambudīpā idam eva no varanti. ",
  "ja466:2.1": "Tipañcarattūpagamamhi cando, ",
  "ja466:2.2": "vego mahā hohiti sāgarassa ",
  "ja466:2.3": "uplāpayaṃ dīpam imaṃ uḷāraṃ, ",
  "ja466:2.4": "mā vo vadhī, gacchatha lenam aññanti. ",
  "ja466:3.1": "Na jāt' ayaṃ sāgaravārivego ",
  "ja466:3.2": "uppāṭaye dīpam imaṃ uḷāraṃ, ",
  "ja466:3.3": "taṃ me nimittehi bahūhi diṭṭhaṃ, ",
  "ja466:3.4": "mā bhetha, kiṃ socatha, modathavho. ",
  "ja466:4.1": "Pahūtabhakkhaṃ bahuannapānaṃ ",
  "ja466:4.2": "patattha āvāsam imaṃ uḷāraṃ, ",
  "ja466:4.3": "na vo bhayaṃ paṭipassāmi kiñci, ",
  "ja466:4.4": "āputtaputtehi pamodathavhoti. ",
  "ja466:5.1": "Yo tv-ev' ayaṃ dakkhiṇāyaṃ disāyaṃ ",
  "ja466:5.2": "khemaṃ paṭikkosati tassa saccaṃ, ",
  "ja466:5.3": "na uttaro vedi bhayābhayassa, ",
  "ja466:5.4": "mā bhetha, kiṃ socatha modathavhoti. ",
  "ja466:6.1": "Yathā ime vippavadanti yakkhā ",
  "ja466:6.2": "eko bhayam saṃsati khemam eko, tad ",
  "ja466:6.3": "iṃgha mayhaṃ vacanaṃ suṇātha: ",
  "ja466:6.4": "khippaṃ lahuṃ mā vinasimha sabbe. ",
  "ja466:7.1": "Sabbe samāgamma karoma nāvaṃ ",
  "ja466:7.2": "doṇiṃ daḷhaṃ sabbayantūpapannaṃ, ",
  "ja466:7.3": "sace ayaṃ dakkhiṇo saccam āha ",
  "ja466:7.4": "moghaṃ paṭikkosati uttar' āyaṃ. ",
  "ja466:7.5": "Sā c' eva no hohiti āpadatthā ",
  "ja466:7.6": "imañ ca dīpaṃ na pariccajema, ",
  "ja466:8.1": "sace va kho uttaro saccam āha ",
  "ja466:8.2": "moghaṃ paṭikkosati dakkhiṇ' ",
  "ja466:8.3": "",
  "ja466:8.4": "āyaṃ, ",
  "ja466:9.1": "Na ve sugaṇhaṃ paṭhamena seṭṭhaṃ ",
  "ja466:9.2": "kaniṭṭham, āpāthagataṃ gahetvā ",
  "ja466:9.3": "yo c' īdha majjhaṃ paviceyya gaṇhati ",
  "ja466:9.4": "sa ve naro seṭṭham upeti ṭhānanti. ",
  "ja466:10.1": "Yathāpi te sāgaravārimajjhe ",
  "ja466:10.2": "sakammanā sotthi vahiṃsu vāṇijā ",
  "ja466:10.3": "anāgatatthaṃ paṭivijjhiyānaṃ ",
  "ja466:10.4": "appam pi nācceti sa bhūripañño. ",
  "ja466:11.1": "Bālā ca mohena rasānugiddhā ",
  "ja466:11.2": "anāgataṃ appaṭivijjhiy' atthaṃ ",
  "ja466:11.3": "paccuppanne sīdanti atthe jāte ",
  "ja466:11.4": "samuddamajjhe yathā te manussā. ",
  "ja466:12.1": "Anāgataṃ paṭikayirātha kiccaṃ: (cfr. Milindap. p. 422) ",
  "ja466:12.2": "mā maṃ kiccaṃ kiccakāle vyadhesi, ",
  "ja466:12.3": "taṃ tādisaṃ paṭikatakiccakāriṃ ",
  "ja466:12.4": "na taṃ kiccaṃ kiccakāle vyadhetīti. ",
  "ja466:13.1": ""
}
