  "ja184:0.4": "",
  "ja184:1.1": "Dūsito Giridantena ",
  "ja184:1.2": "hayo Sāmassa Paṇḍavo ",
  "ja184:1.3": "porāṇaṃ pakatiṃ hitvā ",
  "ja184:1.4": "tass' eva anuvidhīyatīti. ",
  "ja184:2.1": "Sace va t' anujo poso ",
  "ja184:2.2": "sikharākārakappito ",
  "ja184:2.3": "ānane taṃ gahetvāna ",
  "ja184:2.4": "maṇḍale parivattaye ",
  "ja184:2.5": "khippam eva pahatvāna ",
  "ja184:2.6": "tass' eva anuvidhīyatīti. ",
  "ja184:3.1": ""
}
