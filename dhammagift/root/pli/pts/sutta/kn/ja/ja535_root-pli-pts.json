  "ja535:0.4": "",
  "ja535:1.1": "N' eva kiṇāmi na pi vikkiṇāmi,(cfr. Mahāvastu II p.49 sq) ",
  "ja535:1.2": "na cāpi me sannicayo ca atthi, ",
  "ja535:1.3": "sukiccharūpaṃ vat' idaṃ parittaṃ, ",
  "ja535:1.4": "patthodano nālam ayaṃ duvindanti g. ā. ",
  "ja535:2.1": "Appamhā appakaṃ dajjā ",
  "ja535:2.2": "anumajjhato majjhakaṃ, ",
  "ja535:2.3": "bahumhā bahukaṃ dajjā, ",
  "ja535:2.4": "adānaṃ na upapajjati. ",
  "ja535:3.1": "Taṃ taṃ vadāmi Kosiya: ",
  "ja535:3.2": "dehi dānāni bhuñja ca ",
  "ja535:3.3": "ariyaṃ maggaṃ samāruha, ",
  "ja535:3.4": "n' ekāsī labhate sukhanti ",
  "ja535:4.1": "Moghañ c' assa hutaṃ hoti ",
  "ja535:4.2": "moghañ cāpi samīhitaṃ ",
  "ja535:4.3": "atithismiṃ yo nisinnasmiṃ ",
  "ja535:4.4": "eko bhuñjati bhojanaṃ. ",
  "ja535:5.1": "Taṃ taṃ vadāmi Kosiya: ",
  "ja535:5.2": "dehi dānāni bhuñja ca, ",
  "ja535:5.3": "ariyamaggaṃ samārūha, ",
  "ja535:5.4": "n' ekāsī labhate sukhanti g. ā. ",
  "ja535:6.1": "Saccaṃ tassa hutaṃ hoti ",
  "ja535:6.2": "saccañ cāpi samīhitaṃ ",
  "ja535:6.3": "atithismiṃ yo nisinnasmiṃ ",
  "ja535:6.4": "n' eko bhuñjati bhojanaṃ. ",
  "ja535:7.1": "Taṃ taṃ vadāmi etc. ",
  "ja535:7.2": "gāthadvayam āha. Sarasañ ca ",
  "ja535:7.3": "yo ",
  "ja535:7.4": "",
  "ja535:8.1": "juhati ",
  "ja535:8.2": "bahukāya Gayāya ca ",
  "ja535:8.3": "Doṇe Timbarutitthasmiṃ ",
  "ja535:8.4": "sīghasote mahāvahe ",
  "ja535:9.1": "Atra c' assa hutaṃ hoti ",
  "ja535:9.2": "atra c' assa samīhitaṃ ",
  "ja535:9.3": "atithismiṃ yo-- sukhanti ",
  "ja535:9.4": "imā ",
  "ja535:10.1": "gāthā ",
  "ja535:10.2": "abhāsi. ",
  "ja535:10.3": "Balisaṃ ",
  "ja535:10.4": "hi ",
  "ja535:11.1": "so niggilati ",
  "ja535:11.2": "dīghasuttaṃ sabandhanaṃ ",
  "ja535:11.3": "atithismiṃ yo nisinnasmiṃ ",
  "ja535:11.4": "eko-- sukhanti ",
  "ja535:12.1": "",
  "ja535:12.2": "",
  "ja535:12.3": "",
  "ja535:12.4": "",
  "ja535:13.1": "Uḷāravaṇṇā vata brāhmaṇā ime, ",
  "ja535:13.2": "ayaṃ ca vo sunakho kissa hetu ",
  "ja535:13.3": "uccāavacaṃ vaṇṇanibhaṃ vikubbati, ",
  "ja535:13.4": "akkhātha no brāhmaṇā: ko nu tumheti. ",
  "ja535:14.1": "Cando ca Suriyo ca ubho idhāgatā, ",
  "ja535:14.2": "ayaṃ pana Mātali devasārathi, ",
  "ja535:14.3": "Sakko 'ham asmi tidasānam indo, ",
  "ja535:14.4": "eso ca kho Pañcasikhoti vuccatīti g. vatvā ",
  "ja535:15.1": "Pāṇissarā mutiṅgā ca ",
  "ja535:15.2": "murajālambarāni ca ",
  "ja535:15.3": "suttam etaṃ pabodhenti, ",
  "ja535:15.4": "paṭibuddho ca nandatīti g. ā. ",
  "ja535:16.1": "Ye kec' ime maccharino kadariyā ",
  "ja535:16.2": "paribhāsakā samaṇabrāhmaṇānaṃ ",
  "ja535:16.3": "idh' eva nikkhippa sarīradehaṃ ",
  "ja535:16.4": "kāyassa bhedā nirayaṃ vajantīti ",
  "ja535:17.1": "Ye kic' ime suggatim āsasānā ",
  "ja535:17.2": "dhamme ṭhitā saṃyame saṃvibhāge ",
  "ja535:17.3": "idh' eva nikkhippa sarīradehaṃ ",
  "ja535:17.4": "kāyassa bhedā sugatiṃ vajantīti g. ā. ",
  "ja535:18.1": "Tvaṃ no si ñātī purimāsu jātisu ",
  "ja535:18.2": "so maccharī rosako pāpadhammo, ",
  "ja535:18.3": "tav' eva atthāya idhāgat' amhā ",
  "ja535:18.4": "mā pāpadhammo nirayaṃ apatthāti āha. ",
  "ja535:19.1": "Addhā [hi] maṃ vo hitakāmā ",
  "ja535:19.2": "yaṃ maṃ samanusāsatha, ",
  "ja535:19.3": "so 'haṃ tathā karissāmi ",
  "ja535:19.4": "sabbaṃ vuttaṃ hitesihi. ",
  "ja535:20.1": "Esāham ajj' eva upāramāmi, ",
  "ja535:20.2": "na cāp' ahaṃ kiñci kareyya pāpam ",
  "ja535:20.3": "",
  "ja535:20.4": "",
  "ja535:21.1": "Evañ ca me dadato sabbakālaṃ ",
  "ja535:21.2": "bhogā ime Vāsava khīyissanti, ",
  "ja535:21.3": "tato ahaṃ pabbajissāmi Sakka ",
  "ja535:21.4": "hitvāna kāmāni yathodhikānīti āha. ",
  "ja535:22.1": "Naguttame girivare Gandhamādane ",
  "ja535:22.2": "modanti tā devavarābhipālitā, ",
  "ja535:22.3": "athāgamā isivaro sabbalokagū ",
  "ja535:22.4": "supupphitaṃ dumavarasākham ādiya ",
  "ja535:23.1": "Suciṃ sugandhaṃ tidasehi sakkataṃ ",
  "ja535:23.2": "pupphuttamaṃ amaravarehi sevitaṃ ",
  "ja535:23.3": "aladdha maccehi vā dānavehi vā ",
  "ja535:23.4": "aññatra devehi tadārahaṃ h' idaṃ. ",
  "ja535:24.1": "Tato catasso kanakattacūpamā ",
  "ja535:24.2": "uṭṭhāya nariyo pamadādhipā muniṃ ",
  "ja535:24.3": "Asā ca Saddhā ca tato Sirī Hirī ",
  "ja535:24.4": "icc-abravuṃ Nāradadevabrāhmaṇaṃ: ",
  "ja535:25.1": "Sace anuddiṭṭhaṃ tayā mahāmuni ",
  "ja535:25.2": "pupphaṃ imaṃ pāricchattassa brahme ",
  "ja535:25.3": "dadāhi no, sabbagatī te ijjhantu, tvam ",
  "ja535:25.4": "pi no hohi yath' eva Vāsavo. ",
  "ja535:26.1": "Taṃ yācamānābhisamekkha Nārado ",
  "ja535:26.2": "icc-abravī saṃkalahaṃ udīrayi: ",
  "ja535:26.3": "na mayham atth' atthi imehi koci naṃ. ",
  "ja535:26.4": "yā yeva vo seyyasi sā piḷayhathāti. ",
  "ja535:27.1": "Tvaṃ no 'ttamo vābhisamekkha Nārada ",
  "ja535:27.2": "yass' icchasi tassam anuppavecchasu, ",
  "ja535:27.3": "yassā hi no Nāradā tvaṃ padassasi ",
  "ja535:27.4": "sā yeva no hohiti seṭṭhasammatāti. ",
  "ja535:28.1": "Akallam etaṃ vacanaṃ sugatte, ",
  "ja535:28.2": "ko brāhmaṇo ko kalahaṃ udīraye, ",
  "ja535:28.3": "gantvāna bhūtādhipam eva pucchatha ",
  "ja535:28.4": "sace na jānātha idh' uttamādhamanti g. a. ",
  "ja535:29.1": "Tā Nāradena paramappakopitā ",
  "ja535:29.2": "udīritā vaṇṇamadena mattā ",
  "ja535:29.3": "sakāse gantvāna Sahassacakkhuno ",
  "ja535:29.4": "pucchiṃsu bhūtādhipaṃ: kā nu seyyasīti g. ā. ",
  "ja535:30.1": "Tā disvā āyattamanā Purindado ",
  "ja535:30.2": "icc-abravī devavaro katañjali: ",
  "ja535:30.3": "sabbā va vo hotha sugatte sādisī, ",
  "ja535:30.4": "ko n' eva bhadde kalahaṃ udīrayīti. ",
  "ja535:31.1": "Yo sabbalokaṃ carako mahāmuni ",
  "ja535:31.2": "dhamme ṭhito Nārado saccanikkamo ",
  "ja535:31.3": "so no bravī girivare Gandhamādane: ",
  "ja535:31.4": "gantvāna bhūtādhipam eva pucchatha ",
  "ja535:31.5": "sace na jānātha idh' uttamādhamanti g. āhaṃsu. ",
  "ja535:32.1": "Asu brahāraññacaro mahāmuni ",
  "ja535:32.2": "nādatvā bhattaṃ varagatte bhuñjati, ",
  "ja535:32.3": "viceyya dānāni dadāti Kosiyo, ",
  "ja535:32.4": "vassā hi so dassati sā va seyyasīti g. ā. ",
  "ja535:33.1": "Asū hi yo sammati dakkhiṇaṃ disaṃ ",
  "ja535:33.2": "Gaṅgāya tīre Himavantapasmani ",
  "ja535:33.3": "sa Kosiyo dullabhapānabhojano, ",
  "ja535:33.4": "tassa sudham pāpaya devasārathīti. ",
  "ja535:34.1": "Sa Mātali devavarena pesito ",
  "ja535:34.2": "sahassayuttaṃ abhirūyha sandanaṃ ",
  "ja535:34.3": "sa khippam eva upagamma assamaṃ ",
  "ja535:34.4": "adissamāno munino sudhaṃ adāti. ",
  "ja535:35.1": "Udaggihuttam upatiṭṭhato hi me ",
  "ja535:35.2": "pabhaṃkaraṃ lokatamonud' uttamaṃ ",
  "ja535:35.3": "sabbāni bhūtāni aticca Vāsavo, ",
  "ja535:35.4": "ko n' eva me pāṇisu kiṃsudh' odahi. ",
  "ja535:36.1": "Saṃkhūpamaṃ setam atulyadassanaṃ ",
  "ja535:36.2": "suciṃ sugandhaṃ piyarūpaṃ abbhutaṃ ",
  "ja535:36.3": "adiṭṭhapubbaṃ mama jātacakkhuhi ",
  "ja535:36.4": "kā devatā pāṇisu kiṃsudh' odahīti. ",
  "ja535:37.1": "Ahaṃ Mahindena mahesi pesito ",
  "ja535:37.2": "sudh'ābhihāsim turito mahāmuni, ",
  "ja535:37.3": "jānāsi maṃ Mātali devasārathi, ",
  "ja535:37.4": "bhuñjassu bhattuttamaṃ, mā vicārayi. ",
  "ja535:38.1": "Bhuttā ca sā dvādasa hanti pāpake: ",
  "ja535:38.2": "khudaṃ pipāsaṃ aratiṃ duraklamaṃ ",
  "ja535:38.3": "kodhūpanāhañ ca vivādapesuṇaṃ ",
  "ja535:38.4": "sītuṇhatandiñ ca rasuttamaṃ idanti. ",
  "ja535:39.1": "Na kappatī Mātali mayha bhuñjitum ",
  "ja535:39.2": "pubbe adatvā iti me vatuttamaṃ, ",
  "ja535:39.3": "na cāpi ekāsanam ariyapūjitaṃ, ",
  "ja535:39.4": "asaṃvibhāgī ca sukhaṃ na vindatīti g. vatvā ",
  "ja535:40.1": "Thīghātakā ye c' ime pāradārikā ",
  "ja535:40.2": "mittadduno ye ca sapanti subbate ",
  "ja535:40.3": "sabbe ca te maccharipañcamādhamā, ",
  "ja535:40.4": "tasmā adatvā udakam pi nāsmiye. ",
  "ja535:41.1": "So 'h' itthiyā vā purisassa vā pana ",
  "ja535:41.2": "dassāmi dānaṃ vidusam pavaṇṇitaṃ, ",
  "ja535:41.3": "sabbā vadaññū idha vītamaccharā ",
  "ja535:41.4": "bhavanti h' ete sucisaccasammatāti. ",
  "ja535:42.1": "Ato mutā devavarena pesitā ",
  "ja535:42.2": "kaññā catasso kanakattacūpamā: ",
  "ja535:42.3": "Asā ca Saddhā ca Sirī Hirī tato ",
  "ja535:42.4": "taṃ assamaṃ āgamuṃ yattha Kosiyo. ",
  "ja535:43.1": "Tā disvā sabbo paramappamodito ",
  "ja535:43.2": "subhena vaṇṇena sikhā-r-iv' aggino ",
  "ja535:43.3": "kaññā catasso caturo catuddisā ",
  "ja535:43.4": "icc-abravī Mātalino ca sammukhā: ",
  "ja535:44.1": "Purimaṃ disaṃ kā tvaṃ pabhāsi devate ",
  "ja535:44.2": "alaṃkatā tāravarā osadhī, ",
  "ja535:44.3": "pucchāmi taṃ kañcanavelliviggahe, ",
  "ja535:44.4": "ācikkha me tvaṃ katamāsi devatā. ",
  "ja535:45.1": "Sir'āhaṃ devī manujesu pūjitā ",
  "ja535:45.2": "apāpasattūpanisevinī sadā ",
  "ja535:45.3": "sudhāvivādena tav' antim āgatā, ",
  "ja535:45.4": "taṃ maṃ sudhāya varapañña bhājaya. ",
  "ja535:46.1": "Yassāhaṃ icchāmi sukhaṃ mahāmuni ",
  "ja535:46.2": "sa sabbakāmehi naro pamodati, ",
  "ja535:46.3": "Sirīti maṃ jānahi jūhat' uttama, ",
  "ja535:46.4": "tam maṃ sudhāya varapañña bhājayāti. ",
  "ja535:47.1": "Sippena vijjācaraṇena buddhiyā ",
  "ja535:47.2": "narā upetā paguṇā sakammanā ",
  "ja535:47.3": "tayā vihīnā na labhanti kiñcanaṃ, ",
  "ja535:47.4": "tay-idaṃ na sādhu yadidaṃ tayā kataṃ. ",
  "ja535:48.1": "Passāmi posaṃ alasaṃ mahagghasaṃ ",
  "ja535:48.2": "sudukkulīnaṃ pi arūpimaṃ naraṃ, ",
  "ja535:48.3": "tayānugutto Siri jātimām api ",
  "ja535:48.4": "peseti dāsaṃ viya bhogavā sukhī. ",
  "ja535:49.1": "Tan taṃ asaccaṃ avibhajjaseviniṃ ",
  "ja535:49.2": "jānāmi mūḷhaṃ vidurānupātiniṃ, ",
  "ja535:49.3": "na tādisī arahati āsanūdakaṃ ",
  "ja535:49.4": "kuto sudhā, gaccha na mayha ruccasīti. ",
  "ja535:50.1": "Kā sukkadāṭhā paṭimuttakuṇḍalā ",
  "ja535:50.2": "cittaṅgadā kambuvimaṭṭhadhārinī, ",
  "ja535:50.3": "osittavaṇṇaṃ paridayha sobhasi ",
  "ja535:50.4": "kusaggirattaṃ apiḷayha mañjariṃ. ",
  "ja535:51.1": "Migīva bhantā saracāpadhārinā ",
  "ja535:51.2": "virādhitā mandam iva udikkhasi. ",
  "ja535:51.3": "ko te dutīyo idha mandalocane, ",
  "ja535:51.4": "na bhāyasi ekikā kānane vaneti. ",
  "ja535:52.1": "Na me dutīyo idha-m-atthi Kosiya, ",
  "ja535:52.2": "Masakkasārappabhav' amhi devatā, ",
  "ja535:52.3": "Āsā sudhāsāya tav' antim āgatā, ",
  "ja535:52.4": "taṃ maṃ sudhāya varapañña bhājayāti g. ā. ",
  "ja535:53.1": "Āsāya yanti vāṇijā dhanesino, ",
  "ja535:53.2": "nāvaṃ samāruyha parenti aṇṇave, ",
  "ja535:53.3": "te tattha sīdanti atho pi ekadā ",
  "ja535:53.4": "jīnādhanā enti vinaṭṭhapābhatā. ",
  "ja535:54.1": "Āsāya khettāni kasanti kassakā, ",
  "ja535:54.2": "vapanti bījāni, karonti 'pāyaso, ",
  "ja535:54.3": "ītīnipātena avuṭṭhikāya vā ",
  "ja535:54.4": "na kiñci vindanti tato phalāgamaṃ. ",
  "ja535:55.1": "Ath' attakārāni karonti bhattusu ",
  "ja535:55.2": "āsaṃ purakkhatvā narā sukhesino, ",
  "ja535:55.3": "te bhattur atthā atigāḷhitā puna ",
  "ja535:55.4": "disā panassanti aladdha kiñcanaṃ. ",
  "ja535:56.1": "Jahitva dhaññañ ca dhanañ ca ñātake ",
  "ja535:56.2": "āsāya saggādhimanā sukhesino ",
  "ja535:56.3": "tapanti lūkham pi tapaṃ cirantaraṃ, ",
  "ja535:56.4": "kummaggam āruyha parenti duggatiṃ. ",
  "ja535:57.1": "Āsāvisaṃvādikasammatā ime, ",
  "ja535:57.2": "Āse sudhāya vinayassu attani, ",
  "ja535:57.3": "na tādisī arahati āsanūdakaṃ ",
  "ja535:57.4": "kuto sudhā, gaccha na mayha ruccasīti. ",
  "ja535:58.1": "Daddallamānā yasasā yasassinī ",
  "ja535:58.2": "dighaññanāmavhayanaṃ disaṃ pati, ",
  "ja535:58.3": "pucchāmi taṃ kañcanavelliviggahe ",
  "ja535:58.4": "ācikkha me tvaṃ katamāsi devatāti. ",
  "ja535:59.1": "Saddhāhaṃ devī manujesu pūjitā ",
  "ja535:59.2": "apāpasattūpanisevinī sadā ",
  "ja535:59.3": "sudhāvivādena tav' antim āgatā, ",
  "ja535:59.4": "taṃ maṃ sudhāya varapañña bhājayāti. ",
  "ja535:60.1": "Dānaṃ damañ cāgam atho pi saṃyamaṃ ",
  "ja535:60.2": "ādāya saddhāya karonti h' ekadā, ",
  "ja535:60.3": "",
  "ja535:60.4": "",
  "ja535:61.1": "Bhariyāsu poso sadisīsu pekhavā ",
  "ja535:61.2": "sīlūpapannāsu patibbatāsu pi ",
  "ja535:61.3": "vinetvā chandaṃ kuladhītiyāsu pi ",
  "ja535:61.4": "karoti saddhaṃ pana kumbhadāsiyā. ",
  "ja535:62.1": "Tvam eva Saddhe paradārasevinī ",
  "ja535:62.2": "pāpaṃ karosi kusalam pi riñcasi, ",
  "ja535:62.3": "na tādisī arahasi āsanūdakaṃ ",
  "ja535:62.4": "kuto sudhā, gaccha na mayha ruccasīti. Dighaññarattiṃ ",
  "ja535:63.1": "aruṇasmi ūhate ",
  "ja535:63.2": "yā dissati uttamarūpavaṇṇinī ",
  "ja535:63.3": "",
  "ja535:63.4": "",
  "ja535:64.1": "Kālā nidāghe-r-iva aggijāt' iva ",
  "ja535:64.2": "anileritā lohitapattamālinī ",
  "ja535:64.3": "kā tiṭṭhasi mandam ivāvalokayaṃ, ",
  "ja535:64.4": "bhāsesamānā va giraṃ na muñcasīti. ",
  "ja535:65.1": "Hir' āha devī manujesu pūjitā ",
  "ja535:65.2": "apāpasattūpanisevinī sadā ",
  "ja535:65.3": "sudhāvivādena tav' antim āgatā, sā ",
  "ja535:65.4": "taṃ na sakkomi sudham pi yācituṃ, ",
  "ja535:65.5": "kopīnarūpā viya yācan' itthiyāti. ",
  "ja535:66.1": "Dhammena ñāyena sugatte lacchasi, ",
  "ja535:66.2": "eso hi dhammo na hi yācanā sudhā, ",
  "ja535:66.3": "taṃ taṃ ayācantim ahan nimantaye, ",
  "ja535:66.4": "sudhāya yam p' icchasi tam pi dammi te. ",
  "ja535:67.1": "Sā tvaṃ mayā ajja sakamhi assame ",
  "ja535:67.2": "nimantitā kañcanavelliviggahe, ",
  "ja535:67.3": "tvaṃ hi me sabbarasehi pūjiyā, ",
  "ja535:67.4": "taṃ pūjayitvāna sudham pi asmiyeti. ",
  "ja535:68.1": "Sā Kosiyenānumatā jutīmatā ",
  "ja535:68.2": "addhā Hirī rammaṃ pāvisi-y-assamaṃ ",
  "ja535:68.3": "udaññavantaṃ phalam ariyapūjitaṃ ",
  "ja535:68.4": "apāpasattūpanisevitaṃ sadā. ",
  "ja535:69.1": "Rukkhaggahāṇā bahuk' ettha pupphitā ",
  "ja535:69.2": "ambā piyālā panasā ca kiṃsukā ",
  "ja535:69.3": "sobhañjanā lodda-m-atho pi padmakā ",
  "ja535:69.4": "kekā ca bhaṅgā tilakā ca pupphitā. ",
  "ja535:70.1": "Sālā kareri bahuk' ettha jambuyo ",
  "ja535:70.2": "assatthanigrodhamadhukā ca vedisā ",
  "ja535:70.3": "uddālakā pāṭali sindhuvāritā ",
  "ja535:70.4": "supuññagandhā mucalindaketakā. ",
  "ja535:71.1": "Hareṇukā veḷukā veṇutindukā sāmākanīvāra-m-atho ",
  "ja535:71.2": "pi cīnakā ",
  "ja535:71.3": "mocā kadalī bahuk' ettha sāliyo ",
  "ja535:71.4": "pavīhayo ābhujino pi taṇḍulā. Tassa ca uttare ",
  "ja535:72.1": "passe ",
  "ja535:72.2": "jātā pokkharaṇī sivā ",
  "ja535:72.3": "akakkasā apabbharā ",
  "ja535:72.4": "sādu appaṭigandhikā. ",
  "ja535:73.1": "Tattha macchā sanniratā ",
  "ja535:73.2": "khemino bahubhojanā ",
  "ja535:73.3": "siṅgusavaṃkā sakulā satavaṃkā ",
  "ja535:73.4": "ca rohitā ",
  "ja535:73.5": "āligaggarakākiṇṇā ",
  "ja535:73.6": "pāthīnā kākamacchakā. ",
  "ja535:74.1": "Tattha pakkhī sanniratā ",
  "ja535:74.2": "khemino bahubhojanā ",
  "ja535:74.3": "haṃsā koñcā mayūrā ca ",
  "ja535:74.4": "cakkavākā ca kukkuhā ",
  "ja535:74.5": "kuṇālakā bahucitrā ",
  "ja535:74.6": "sikhaṇḍijīvajīvakā. ",
  "ja535:75.1": "Tattha pānāya-m-āyanti ",
  "ja535:75.2": "nānāmigagaṇā bahū ",
  "ja535:75.3": "sīhā vyagghā varāhā ca ",
  "ja535:75.4": "acchakokataracchayo. ",
  "ja535:76.1": "Palāsādā ca gavajā mahisā ",
  "ja535:76.2": "rohitā rurū ",
  "ja535:76.3": "eṇeyyā varāhā c' eva ",
  "ja535:76.4": "gaṇino nīkasūkarā ",
  "ja535:76.5": "kadalimigā bahū c' ettha ",
  "ja535:76.6": "biḷārā sasakaṇṇikā. ",
  "ja535:77.1": "Chamāgirī pupphavicitrasanthatā ",
  "ja535:77.2": "dijābhighuṭṭhā dijasaṃghasevitāti. ",
  "ja535:78.1": "Sā suttacā nīladumābhilambitā ",
  "ja535:78.2": "vijjumahāmegha-r-ivānupajjatha ",
  "ja535:78.3": "tassā susambandhasiraṃ kusāmayaṃ ",
  "ja535:78.4": "suciṃ sugandhaṃ ajinūpasevitaṃ ",
  "ja535:78.5": "atricchakocchaṃ, Hirim etad abravi: ",
  "ja535:78.6": "nisīda kalyāṇi sukha-y-idam āsanaṃ. ",
  "ja535:79.1": "Tassā tadā kocchagatāyā Kosiyo ",
  "ja535:79.2": "yad icchamānāya jaṭājinaṃdharo ",
  "ja535:79.3": "navehi pattehi sayaṃ sahūdakaṃ ",
  "ja535:79.4": "sudh' ābhihāsi turito mahāmuni. ",
  "ja535:80.1": "Sā taṃ patiggayha ubhohi pāṇihi ",
  "ja535:80.2": "icc-abravi attamanā jaṭādharaṃ: ",
  "ja535:80.3": "handāham etarahi pūjitā tayā ",
  "ja535:80.4": "gaccheyya brahme tidivaṃ jitāvinī. ",
  "ja535:81.1": "Sā Kosiyenānumatā jutīmatā ",
  "ja535:81.2": "udīritā vaṇṇamadena mattā ",
  "ja535:81.3": "sakāse gantvāna sahassacakkhuno: ",
  "ja535:81.4": "ayaṃ sudhā Vāsava, dehi me jayaṃ. ",
  "ja535:82.1": "Tam ena Sakko pi tadā apūjayi ",
  "ja535:82.2": "sahindā ca devā surakaññam uttamaṃ ",
  "ja535:82.3": "sā pañjalī devamanussapūjitā ",
  "ja535:82.4": "navamhi kocchamhi yadā upāvisīti. ",
  "ja535:83.1": "Tam eva saṃsī punar eva Mātaliṃ ",
  "ja535:83.2": "sahassanetto tidasānam indo: ",
  "ja535:83.3": "gantvāna vākyaṃ mama brūhi Kosiyaṃ ",
  "ja535:83.4": "[Āsāya Saddha-Siriyā ca Kosiyaṃ] (cfr. v. 89) ",
  "ja535:83.5": "Hirī sudhaṃ kena-m-alattha hetunāti g. ā. ",
  "ja535:84.1": "Taṃ suplavatthaṃ udatārayī rathaṃ ",
  "ja535:84.2": "daddallamānaṃ upakiriyasādisaṃ ",
  "ja535:84.3": "jambonadīsaṃ tapaneyyasannibhaṃ ",
  "ja535:84.4": "alaṃkataṃ kañcanacittasantikaṃ. ",
  "ja535:85.1": "Suvaṇṇacand' ettha bahū nipātitā ",
  "ja535:85.2": "hatthigavassā kikivyagghadīpiyo ",
  "ja535:85.3": "eṇeyyakā laṃghamay' ettha pakkhiyo ",
  "ja535:85.4": "mig' ettha veḷuriyamayā yudhāyutā. ",
  "ja535:86.1": "Tatth' assarājaharayo ayojayuṃ ",
  "ja535:86.2": "dasasatāni susunāgasādise ",
  "ja535:86.3": "",
  "ja535:86.4": "",
  "ja535:87.1": "Taṃ yānaseṭṭhaṃ abhiruyha Mātali dasa ",
  "ja535:87.2": "disā imā abhinādayittha ",
  "ja535:87.3": "nabhañ ca selañ ca vanaspatīni ca ",
  "ja535:87.4": "sasāgaraṃ pavyathayittha mediniṃ. ",
  "ja535:88.1": "Sa khippam eva upagamma assamaṃ ",
  "ja535:88.2": "pāvāramekaṃsakato katañjali ",
  "ja535:88.3": "bahussutaṃ vaddhaṃ vinītavantaṃ ",
  "ja535:88.4": "icc-abravī Mātaḷi devabrāhmaṇaṃ: ",
  "ja535:89.1": "Indassa vākyaṃ nisāmehi Kosiya, ",
  "ja535:89.2": "dūto ahaṃ, pucchati taṃ purindado: ",
  "ja535:89.3": "Asāya Saddhā-Siriyā ca Kosiya ",
  "ja535:89.4": "Hirī sudhaṃ kena-m-alattha hetunāti. ",
  "ja535:90.1": "Addhā Sirī maṃ paṭibhāti Mātali ",
  "ja535:90.2": "Saddhā aniccā pana devasārathi ",
  "ja535:90.3": "Āsā visaṃvādikasammatā hi me ",
  "ja535:90.4": "Hirī ca ariyamhi guṇe patiṭṭhitāti g. ā. ",
  "ja535:91.1": "Kumāriyo yā c' imā gottarakkhitā ",
  "ja535:91.2": "jiṇṇā ca yā yā ca sabhattuitthiyo ",
  "ja535:91.3": "tā chandarāgaṃ purisesu uggataṃ ",
  "ja535:91.4": "hiriyā nivārenti sacittam attano. ",
  "ja535:92.1": "Saṃgāmasīse sarasattisaṃyutte ",
  "ja535:92.2": "parājitānaṃ patataṃ palāyinaṃ ",
  "ja535:92.3": "hiriyā nivattanti jahitva jīvitaṃ ",
  "ja535:92.4": "te sampaṭicchanti punā hirīmanā. ",
  "ja535:93.1": "Velā yathā sāgaravegavārini ",
  "ja535:93.2": "hir' āyaṃ hi pāpajanaṃ nivāraṇī. ",
  "ja535:93.3": "taṃ sabbaloke Hirim ariyapūjitaṃ ",
  "ja535:93.4": "Indassa taṃ vedaya devasārathīti. ",
  "ja535:94.1": "Ko te imaṃ Kosiya diṭṭhim odahi ",
  "ja535:94.2": "Brahmā Mahindo atha vā Pajāpati. ",
  "ja535:94.3": "Hir' āyaṃ devesu hi seṭṭhasammatā ",
  "ja535:94.4": "dhītā Mahindassa mahesi jāyathāti g. ā. ",
  "ja535:95.1": "Hand' ehi dāni tidivaṃ samakkama ",
  "ja535:95.2": "rathaṃ samāruyha mamāyitaṃ imaṃ. ",
  "ja535:95.3": "Indo ca taṃ Inda-sagotta kaṃkhati, ",
  "ja535:95.4": "ajj' eva tvaṃ Indasahavyataṃ vajāti g. ā. ",
  "ja535:96.1": "Evaṃ samijjhanti apāpakammino, ",
  "ja535:96.2": "atho suciṇṇassa phalaṃ na nassati, ",
  "ja535:96.3": "Ath' ",
  "ja535:96.4": "",
  "ja535:97.1": "",
  "ja535:97.2": "",
  "ja535:97.3": "Ajjuno ",
  "ja535:97.4": "",
  "ja535:98.1": "",
  "ja535:98.2": "",
  "ja535:98.3": "",
  "ja535:98.4": "",
  "ja535:99.1": ""
}
