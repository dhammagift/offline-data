  "ja303:0.4": "",
  "ja303:1.1": "Anuttare kāmaguṇe samiddhe ",
  "ja303:1.2": "bhutvāna pubbe vasi ekarājā, ",
  "ja303:1.3": "so dāni dugge narakamhi khitto ",
  "ja303:1.4": "na-ppajahe vaṇṇabalaṃ purāṇanti. ",
  "ja303:2.1": "Pubbe va khantī ca tapo ca mayhaṃ ",
  "ja303:2.2": "sampatthitā Dabbasenā ahosi, ",
  "ja303:2.3": "taṃ dāni laddhāna kathan nu rāja ",
  "ja303:2.4": "jahe ahaṃ vaṇṇabalaṃ purāṇaṃ. ",
  "ja303:3.1": "Sabbaṃ kir' evaṃ pariniṭṭhitāni ",
  "ja303:3.2": "yasassinaṃ paññavataṃ visayha, ",
  "ja303:3.3": "yaso ca laddhā purimaṃ uḷāraṃ ",
  "ja303:3.4": "na-ppajahe vaṇṇabalaṃ purāṇaṃ. ",
  "ja303:4.1": "Panujja dukkhena sukhaṃ janinda ",
  "ja303:4.2": "sukhena vā dukkham asayhasāhi ",
  "ja303:4.3": "ubhayattha sattā abhinibbutattā ",
  "ja303:4.4": "sukhe ca dukkhe ca bhavanti tulyāti. ",
  "ja303:5.1": ""
}
