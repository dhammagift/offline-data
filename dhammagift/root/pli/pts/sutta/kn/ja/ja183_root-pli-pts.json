  "ja183:0.4": "",
  "ja183:1.1": "Vālodakaṃ apparasaṃ nihīnaṃ (Dhp.p.275). ",
  "ja183:1.2": "pītvā mado jāyati gadrabhānaṃ, ",
  "ja183:1.3": "imañ ca pītvāna rasaṃ paṇītaṃ ",
  "ja183:1.4": "mado na sañjāyati sindhavānanti. ",
  "ja183:2.1": "Appam pivitvāna nihīnajacco ",
  "ja183:2.2": "so majjatī tena janinda puṭṭho, ",
  "ja183:2.3": "dhorayhasīlī ca kulamhi jāto ",
  "ja183:2.4": "na majjatī aggarasaṃ pivitvāti. ",
  "ja183:3.1": ""
}
