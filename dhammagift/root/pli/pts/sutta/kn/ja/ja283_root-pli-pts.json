  "ja283:0.4": "",
  "ja283:1.1": "Varaṃ varaṃ tvaṃ nihanaṃ pure cari ",
  "ja283:1.2": "asmiṃ padese abhibhuyya sūkare, ",
  "ja283:1.3": "so dāni eko vyapagamma jhāyasi, ",
  "ja283:1.4": "balaṃ nu te vyaggha na c' ajja vijjatīti. ",
  "ja283:2.1": "Ime sudaṃ yanti disodisaṃ pure ",
  "ja283:2.2": "bhayadditā lenagavesino puthu, ",
  "ja283:2.3": "te dāni saṃgamma rasanti ekato, ",
  "ja283:2.4": "yatthaṭṭhitā duppasah' ajja 'me mayāti. ",
  "ja283:3.1": "Nam' atthu saṃghānaṃ samāgatānaṃ, ",
  "ja283:3.2": "disvā sayaṃ sakhya vadāmi abbhutaṃ ",
  "ja283:3.3": "vyagghaṃ migā yattha jiniṃsu dāṭhino ",
  "ja283:3.4": "sāmaggiyā dāṭhabalesu muccareti. ",
  "ja283:4.1": ""
}
