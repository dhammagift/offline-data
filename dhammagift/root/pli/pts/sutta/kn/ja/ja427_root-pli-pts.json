  "ja427:1.1": "nāma ",
  "ja427:1.2": "gijjhapantho sanantano, ",
  "ja427:1.3": "tatrāsi mātāpitaro ",
  "ja427:1.4": "gijjho posesi jiṇṇake. ",
  "ja427:1.5": "Tesaṃ ajakaraṃ medaṃ ",
  "ja427:1.6": "accahāsi bahūtaso, ",
  "ja427:2.1": "pitā ca puttaṃ avaca ",
  "ja427:2.2": "jānaṃ uccāpapātinaṃ ",
  "ja427:2.3": "supattaṃ pakkhasampannaṃ ",
  "ja427:2.4": "tejasiṃ dūragāminaṃ. ",
  "ja427:3.1": "Pariplavantaṃ paṭhaviṃ: ",
  "ja427:3.2": "yadā tāta vijānahi ",
  "ja427:3.3": "sāgarena parikkhittaṃ ",
  "ja427:3.4": "cakkaṃ va parimaṇḍalaṃ ",
  "ja427:3.5": "tato tāta nivattassu, ",
  "ja427:3.6": "māssu etto paraṃ gami. ",
  "ja427:4.1": "Udapatto si vegena ",
  "ja427:4.2": "balī pakkhī dijuttamo ",
  "ja427:4.3": "olokayanto vakkaṅgo ",
  "ja427:4.4": "pabbatāni vanāni ca. ",
  "ja427:5.1": "Addasa paṭhaviṃ gijjho ",
  "ja427:5.2": "yathāsāsī pitus sutaṃ ",
  "ja427:5.3": "sāgarena parikkhittaṃ ",
  "ja427:5.4": "cakkaṃ va parimaṇḍalaṃ ",
  "ja427:6.1": "[tato tāta nivattassu, māssu etto paraṃ gami]. (Cfr. p.255, 30.) Tañ ca so samatikkamma ",
  "ja427:6.2": "param ev' accavattatha ",
  "ja427:6.3": "tañ ca vātasikhā tikkhā ",
  "ja427:6.4": "accahāsi baliṃ dijaṃ. ",
  "ja427:7.1": "Nāsakkh' ātigato poso ",
  "ja427:7.2": "punar eva nivattituṃ, ",
  "ja427:7.3": "dijo vyasanam āpādi ",
  "ja427:7.4": "verambānaṃ vasaṃ gato. ",
  "ja427:8.1": "Tassa puttā ca dārā ca ",
  "ja427:8.2": "ye c' aññe anujīvino (Cfr. p.256, 14.) ",
  "ja427:8.3": "sabbe vyasanaṃ āpāduṃ ",
  "ja427:8.4": "anovādakare dije. ",
  "ja427:9.1": "Evam pi idha vaddhānaṃ ",
  "ja427:9.2": "yo vākyaṃ nāvabujjhati ",
  "ja427:9.3": "atisīmacaro ditto ",
  "ja427:9.4": "gijjho vātītasāsano ",
  "ja427:9.5": "sa ve vyasanaṃ pappoti ",
  "ja427:9.6": "akatvā vaddhasāsananti. ",
  "ja427:10.1": ""
}
