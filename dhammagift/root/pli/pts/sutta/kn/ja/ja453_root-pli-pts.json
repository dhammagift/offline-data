  "ja453:0.1": "",
  "ja453:0.2": "",
  "ja453:0.3": "",
  "ja453:0.4": "",
  "ja453:1.1": "naro jappam adhicca kāle ",
  "ja453:1.2": "kaṃ vā vijjaṃ katamaṃ vā sutānaṃ ",
  "ja453:1.3": "so macco asmiṃ va paramhi loke ",
  "ja453:1.4": "kathaṃkaro sotthānena guttoti. ",
  "ja453:2.1": "Yassa devā pitaro ca sabbe ",
  "ja453:2.2": "siriṃsapā sabbabhūtāni cāpi ",
  "ja453:2.3": "mettāya niccaṃ apacitāni honti ",
  "ja453:2.4": "bhūtesu ve sotthānaṃ tad āhūti āha. ",
  "ja453:3.1": "Yo sabbalokassa nivātavutti ",
  "ja453:3.2": "itthīpumānaṃ sahadārakānaṃ ",
  "ja453:3.3": "khantā duruttānaṃ apaṭikkūlavādī -- ",
  "ja453:3.4": "adhivāsanaṃ sotthānaṃ tad āhu. ",
  "ja453:4.1": "Yo nāvajānāti sahāyamatte ",
  "ja453:4.2": "sippena kulyābhi dhanena jaccā ",
  "ja453:4.3": "rucipañño atthakāle mutīmā -- ",
  "ja453:4.4": "sahāyesu ve sotthānaṃ tad āhu. ",
  "ja453:5.1": "Mittāni ve yassa bhavanti santo ",
  "ja453:5.2": "saṃvissatthā avisaṃvādakassa ",
  "ja453:5.3": "na mittadūbhī saṃvibhāgī dhanena -- ",
  "ja453:5.4": "mittesu ve sotthānaṃ tad āhu. ",
  "ja453:6.1": "Yassa bhariyā tulyavayā samaggā ",
  "ja453:6.2": "anubbatā dhammakāmā pajātā ",
  "ja453:6.3": "koliniyā sīlavatī patibbatā -- ",
  "ja453:6.4": "dāresu ve sotthānaṃ tad āhu. ",
  "ja453:7.1": "Yassa rājā bhūtapatī yasassī ",
  "ja453:7.2": "jānāti soceyyaṃ parakkamañ ca ",
  "ja453:7.3": "advejjhatā suhad ayaṃ mamanti -- ",
  "ja453:7.4": "rājūsu ve sotthānaṃ tad āhu. ",
  "ja453:8.1": "Annañ ca pānañ ca dadāti saddho ",
  "ja453:8.2": "mālañ ca gandhañ ca vilepanañ ca ",
  "ja453:8.3": "pasannacitto anumodamāno -- ",
  "ja453:8.4": "saggesu ve sotthānaṃ tad āhu. ",
  "ja453:9.1": "Yam ariyadhammena punanti vaddhā ",
  "ja453:9.2": "ārādhitā samacariyāya santo ",
  "ja453:9.3": "",
  "ja453:9.4": "",
  "ja453:10.1": "Etāni kho sotthānāni loke ",
  "ja453:10.2": "viññūpasatthāni sukhindriyāni, ",
  "ja453:10.3": "tānīdha sevetha naro sapañño, ",
  "ja453:10.4": "na hi maṅgale kiñcanam atthi saccanti. ",
  "ja453:11.1": ""
}
