  "ja451:0.4": "",
  "ja451:1.1": "Vaṇṇavā abhirūpo si ",
  "ja451:1.2": "ghano sañjātarohito ",
  "ja451:1.3": "cakkavāka surūpo si ",
  "ja451:1.4": "vippasannamukhindriyo. ",
  "ja451:2.1": "Pāṭhīnaṃ pāvusaṃ macchaṃ ",
  "ja451:2.2": "vālajaṃ muñjarohitaṃ ",
  "ja451:2.3": "Gaṅgātīresu nisinno ",
  "ja451:2.4": "evaṃ bhuñjasi bhojananti. ",
  "ja451:3.1": "Na vāham etaṃ bhuñjāmi ",
  "ja451:3.2": "jaṅgalān' odakāni vā ",
  "ja451:3.3": "aññatra sevālapaṇakā, ",
  "ja451:3.4": "etam me samma bhojananti. ",
  "ja451:4.1": "Na vāhaṃ etaṃ saddahāmi ",
  "ja451:4.2": "cakkavākassa bhojanaṃ, ",
  "ja451:4.3": "ahaṃ hi samma bhuñjāmi ",
  "ja451:4.4": "gāme loṇiyateliyaṃ, ",
  "ja451:5.1": "Manussesu kataṃ bhattaṃ ",
  "ja451:5.2": "suciṃ maṃsūpasecanaṃ, ",
  "ja451:5.3": "na ca me tādiso vaṇṇo ",
  "ja451:5.4": "cakkavāka yathā tavanti. ",
  "ja451:6.1": "Sampassaṃ attani veraṃ ",
  "ja451:6.2": "hiṃsāya mānusiṃ pajaṃ ",
  "ja451:6.3": "utrasto ghasasī bhīto, ",
  "ja451:6.4": "tena vaṇṇo te ediso. ",
  "ja451:7.1": "Sabbalokaviraddho si ",
  "ja451:7.2": "dhaṃka pāpena kammanā, (cfr. III 313|10-11) ",
  "ja451:7.3": "laddho piṇḍo na pīṇeti, ",
  "ja451:7.4": "tena vaṇṇo te ediso. ",
  "ja451:8.1": "Aham pi samma bhuñjāmi ",
  "ja451:8.2": "ahiṃsā sabbapāṇinaṃ ",
  "ja451:8.3": "appossukko nirāsaṃkī ",
  "ja451:8.4": "asoko akutobhayo. ",
  "ja451:9.1": "So karassu ānubhāvaṃ, ",
  "ja451:9.2": "vītivattassu sīliyaṃ, ",
  "ja451:9.3": "ahiṃsāya cara loke, ",
  "ja451:9.4": "piyo hohisi mammiva. ",
  "ja451:10.1": "Yo na hanti na ghāteti ",
  "ja451:10.2": "na jināti na jāpaye (cfr. Milindap. p.402) ",
  "ja451:10.3": "mettaṃso sabbabhūtesu ",
  "ja451:10.4": "veraṃ tassa na kenacīti. Kiṃ su ",
  "ja451:11.1": ""
}
