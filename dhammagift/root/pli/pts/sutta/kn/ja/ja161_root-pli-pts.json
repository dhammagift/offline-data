  "ja161:1.1": "Na santhavaṃ kāpurisena kayirā ",
  "ja161:1.2": "ariyo anariyena pajānam atthaṃ ",
  "ja161:1.3": "cirānuvuttho pi karoti pāpaṃ ",
  "ja161:1.4": "gajo yathā Indasamānagottaṃ. ",
  "ja161:2.1": "Yaṃ tv-eva jaññā sadiso mamanti ",
  "ja161:2.2": "sīlena paññāya sutena cāpi ",
  "ja161:2.3": "ten' eva mettiṃ kayirātha saddhiṃ, ",
  "ja161:2.4": "sakhāvaho sappurisena saṅgamoti. ",
  "ja161:3.1": ""
}
