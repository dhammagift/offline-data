  "ja410:0.4": "",
  "ja410:1.1": "Yo maṃ pure paccudeti ",
  "ja410:1.2": "araññe dūram āyato ",
  "ja410:1.3": "so na dissati mātaṅgo, ",
  "ja410:1.4": "Somadatto kuhiṃ gatoti. ",
  "ja410:2.1": "Ayaṃ va so mato seti ",
  "ja410:2.2": "allapiṃkaṃ va chijjito, ",
  "ja410:2.3": "bhumyā nipatito seti, ",
  "ja410:2.4": "amarā vata kuñjaroti. ",
  "ja410:3.1": "Anāgāriyupetassa ",
  "ja410:3.2": "vippamuttassa cetaso (Cfr. supra p.214.) ",
  "ja410:3.3": "samaṇassa na taṃ sādhu ",
  "ja410:3.4": "yaṃ petam anusocasīti. ",
  "ja410:4.1": "Saṃvāsena have Sakka ",
  "ja410:4.2": "manussassa migassa vā ",
  "ja410:4.3": "hadaye jāyatī pemaṃ, ",
  "ja410:4.4": "taṃ na sakkā asocitunti. ",
  "ja410:5.1": "Mataṃ marissaṃ rodanti ",
  "ja410:5.2": "ye rudanti lapanti ca, ",
  "ja410:5.3": "isi mā rudi, ",
  "ja410:5.4": "roditaṃ mogham āhu santo... ",
  "ja410:6.1": "Kanditena have brahme ",
  "ja410:6.2": "mato peto samuṭṭhahe, ",
  "ja410:6.3": "sabbe saṃgamma rodāma ",
  "ja410:6.4": "aññamaññassa ñātaketi. ",
  "ja410:7.1": "Ādittaṃ vata maṃ santaṃ ",
  "ja410:7.2": "ghatasittaṃ va pāvakaṃ ",
  "ja410:7.3": "vārinā viya osiñcaṃ ",
  "ja410:7.4": "sabbaṃ nibbāpaye daraṃ. ",
  "ja410:8.1": "Abbahī vata me sallaṃ ",
  "ja410:8.2": "yam āsi hadayanissitaṃ ",
  "ja410:8.3": "yo me sokaparetassa ",
  "ja410:8.4": "puttasokaṃ apānudi. ",
  "ja410:9.1": "So 'haṃ abbūḷhasallo 'smi ",
  "ja410:9.2": "vītasoko anāvilo, ",
  "ja410:9.3": "na socāmi na rodāmi ",
  "ja410:9.4": "tava sutvāna Vāsavāti. ",
  "ja410:10.1": ""
}
