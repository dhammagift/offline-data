  "ja195:1.1": "Pabbatūpatthare ramme ",
  "ja195:1.2": "jātā pokkharaṇī sivā, ",
  "ja195:1.3": "taṃ sigālo apāpāsi ",
  "ja195:1.4": "jānaṃ sīhena rakkhitanti. ",
  "ja195:2.1": "Pivanti va mahārāja ",
  "ja195:2.2": "sāpadāni mahānadiṃ, ",
  "ja195:2.3": "na tena anadī hoti, ",
  "ja195:2.4": "khamassu yadi te piyāti. ",
  "ja195:3.1": ""
}
