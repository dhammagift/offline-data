  "ja250:1.1": "Ayaṃ isī upasamasaṃyame rato ",
  "ja250:1.2": "santiṭṭhati sisirabhayena aṭṭito, ",
  "ja250:1.3": "handa ayaṃ pavisatu 'maṃ agārakaṃ, ",
  "ja250:1.4": "vinetu sītaṃ darathañ ca kevalanti. ",
  "ja250:2.1": "Nāyaṃ isī upasamasaṃyame rato, ",
  "ja250:2.2": "kapī ayaṃ dumavarasākhagocaro, ",
  "ja250:2.3": "so dūsako rosako cāpi jammo, ",
  "ja250:2.4": "sace vaje ",
  "ja250:3.1": "",
  "ja250:3.2": "",
  "ja250:4.1": "",
  "ja250:5.1": "imam ",
  "ja250:5.2": "",
  "ja250:5.3": "pi ",
  "ja250:5.4": "",
  "ja250:6.1": "dūsaye ",
  "ja250:7.1": "",
  "ja250:7.2": "gharanti. ",
  "ja250:7.3": "Saṃkapparāgadhotena ",
