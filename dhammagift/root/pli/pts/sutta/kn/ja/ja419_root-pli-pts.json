  "ja419:0.4": "",
  "ja419:1.1": "Idaṃ suvaṇṇakāyūraṃ ",
  "ja419:1.2": "muttā veḷuriyā bahū ",
  "ja419:1.3": "sabbaṃ harassu bhaddaṃ te ",
  "ja419:1.4": "mañ ca dāsīti sāvayāti. ",
  "ja419:2.1": "Oropayassu kalyāṇi, ",
  "ja419:2.2": "mā bahuṃ paridevasi, ",
  "ja419:2.3": "na cāhaṃ abhijānāmi ",
  "ja419:2.4": "ahantvā dhanam ābhatanti ",
  "ja419:3.1": "Yato sarāmi attānaṃ ",
  "ja419:3.2": "yato patto 'smi viññutaṃ ",
  "ja419:3.3": "na cāhaṃ abhijānāmi ",
  "ja419:3.4": "aññaṃ piyataraṃ tayā. ",
  "ja419:4.1": "Ehi taṃ upagūhissaṃ ",
  "ja419:4.2": "karissañ ca padakkhiṇaṃ, ",
  "ja419:4.3": "na hi dāni punā atthi ",
  "ja419:4.4": "mama tuyhañ ca saṃgamoti. ",
  "ja419:5.1": "Na hi sabbesu ṭhānesu ",
  "ja419:5.2": "puriso hoti paṇḍito, ",
  "ja419:5.3": "itthī pi paṇḍitā hoti ",
  "ja419:5.4": "tattha tattha vicakkhaṇā. ",
  "ja419:6.1": "Na hi sabbesu ṭhānesu ",
  "ja419:6.2": "puriso hoti paṇḍito, ",
  "ja419:6.3": "itthī pi paṇḍitā hoti ",
  "ja419:6.4": "lahum atthavicintikā. ",
  "ja419:7.1": "Lahuñ ca vata khippañ ca ",
  "ja419:7.2": "nikaṭṭhe samacetayi, ",
  "ja419:7.3": "migaṃ puṇṇāyateneva ",
  "ja419:7.4": "Sulasā Sattukaṃ vadhi. ",
  "ja419:8.1": "Yo 'dha uppatitaṃ atthaṃ ",
  "ja419:8.2": "na khippam anubujjhati (Cfr. p.266,24.) ",
  "ja419:8.3": "so haññati mandamati ",
  "ja419:8.4": "coro va girigabbhare. ",
  "ja419:9.1": "Yo ca uppatitaṃ atthaṃ ",
  "ja419:9.2": "khippam eva nibodhati ",
  "ja419:9.3": "muccate sattusambādhā ",
  "ja419:9.4": "Sulasā Sattukā-m- ivāti. Bhus' amhi ",
  "ja419:10.1": ""
}
