  "ja493:0.1": "",
  "ja493:0.2": "",
  "ja493:0.3": "",
  "ja493:0.4": "",
  "ja493:1.1": "Vāṇijā samitiṃ katvā ",
  "ja493:1.2": "nānāraṭṭhāto āgatā ",
  "ja493:1.3": "dhanahārāya pakkamiṃsu ",
  "ja493:1.4": "ekaṃ katvāna gāmaṇiṃ. ",
  "ja493:2.1": "Te taṃ kantāram āgamma ",
  "ja493:2.2": "appabhakkhaṃ anodakaṃ ",
  "ja493:2.3": "mahānigrodham addakkhuṃ ",
  "ja493:2.4": "sītacchāyaṃ manoramaṃ. ",
  "ja493:3.1": "Te ca tattha nisīditvā ",
  "ja493:3.2": "tassa rukkhassa chādiyā ",
  "ja493:3.3": "vāṇijā samacintesuṃ ",
  "ja493:3.4": "bālā mohena pārutā: ",
  "ja493:4.1": "Addāyate ayaṃ rukkho ",
  "ja493:4.2": "api vāri ca sandati, ",
  "ja493:4.3": "iṃgh' assa purimaṃ sākhaṃ ",
  "ja493:4.4": "mayaṃ chindāma vāṇijā. ",
  "ja493:5.1": "Sā ca chinnā va pagghari ",
  "ja493:5.2": "acchaṃ vāriṃ anāvilaṃ, ",
  "ja493:5.3": "te tattha nahātvā ca pivitvā ",
  "ja493:5.4": "ca yāvat' icchiṃsu vāṇijā ",
  "ja493:6.1": "Dutiyaṃ samacintesuṃ ",
  "ja493:6.2": "bālā mohena pārutā: ",
  "ja493:6.3": "iṃgh' assa dakkhiṇaṃ sākhaṃ ",
  "ja493:6.4": "mayaṃ chindāma vānijā. ",
  "ja493:7.1": "Sā ca chinnā va pagghari ",
  "ja493:7.2": "sālimaṃsodanaṃ bahuṃ ",
  "ja493:7.3": "appodavaṇṇe kummāse ",
  "ja493:7.4": "singiṃ bidalasūpiyo. ",
  "ja493:8.1": "Te tattha bhutvā ca pivitvā ca ",
  "ja493:8.2": "yāvat' icchiṃsu vāṇijā ",
  "ja493:8.3": "tatiyaṃ samacintesuṃ ",
  "ja493:8.4": "bālā mohena pārutā: ",
  "ja493:8.5": "Iṃgh' assa pacchimaṃ sākhaṃ ",
  "ja493:8.6": "mayaṃ chindāma vāṇijā. ",
  "ja493:9.1": "sā ca chinnā va pagghari ",
  "ja493:9.2": "nāriyo samalaṃkatā ",
  "ja493:9.3": "Vicitravatthābharaṇā ",
  "ja493:9.4": "āmuttamaṇikuṇḍalā ",
  "ja493:10.1": "api su vāṇijā ekā ",
  "ja493:10.2": "nāriyo paṇṇavīsati. ",
  "ja493:10.3": "Samantā parikariṃsu ",
  "ja493:10.4": "tassa rukkhassa chādiyā; ",
  "ja493:11.1": "te tāhi parivāretvā ",
  "ja493:11.2": "yāvat' icchiṃsu vāṇijā ",
  "ja493:11.3": "Catutthaṃ samacintesuṃ ",
  "ja493:11.4": "bālā mohena pārutā: ",
  "ja493:11.5": "iṃgh' assa uttaraṃ sākhaṃ ",
  "ja493:11.6": "mayaṃ chindāma vāṇijā. ",
  "ja493:12.1": "Sā ca chinnā va pagghari ",
  "ja493:12.2": "muttā veḷuriyā bahū ",
  "ja493:12.3": "rajataṃ jātarūpañ ca ",
  "ja493:12.4": "kuttiyo paṭiyāni ca ",
  "ja493:13.1": "Kāsikāni ca vatthāni ",
  "ja493:13.2": "uddiyāne ca kambale; ",
  "ja493:13.3": "te tattha bhāre bandhitvā ",
  "ja493:13.4": "yāvat' icchiṃsu vāṇijā ",
  "ja493:14.1": "pañcamaṃ samacintesuṃ ",
  "ja493:14.2": "bālā mohena pārutā: ",
  "ja493:14.3": "iṃgh' assa mūlaṃ chindāma, ",
  "ja493:14.4": "api bhiyyo labhāmase. ",
  "ja493:15.1": "Ath' uṭṭhahi satthavāho ",
  "ja493:15.2": "yācamāno katañjalī: ",
  "ja493:15.3": "nigrodho kiṃ aparajjhati ",
  "ja493:15.4": "vāṇijā, bhaddam atthu te. ",
  "ja493:16.1": "Vāridā purimā sākhā, ",
  "ja493:16.2": "annapānañ ca dakkhiṇā, ",
  "ja493:16.3": "nāridā pacchimā sākhā, ",
  "ja493:16.4": "sabbakāme ca uttarā, ",
  "ja493:16.5": "nigrodho kiṃ aparajjhati ",
  "ja493:16.6": "vāṇijā, bhaddam atthu te. ",
  "ja493:17.1": "Yassa rukkhassa chāyāya ",
  "ja493:17.2": "nisīdeyya sayeyya vā ",
  "ja493:17.3": "na tassa sākhaṃ bhañjeyya, ",
  "ja493:17.4": "mittadūbho hi pāpako. ",
  "ja493:18.1": "Te ca tassa anādiyitvā ",
  "ja493:18.2": "ekassa vacanaṃ bahū ",
  "ja493:18.3": "nisitāhi kuṭhārīhi ",
  "ja493:18.4": "mūlato taṃ upakkamunti. ",
  "ja493:19.1": "Tato nāgā nikkhamiṃsu ",
  "ja493:19.2": "sannaddhā paṇṇavīsati ",
  "ja493:19.3": "dhanuggahānaṃ tisatā ",
  "ja493:19.4": "cha sahassā ca vamminoti ",
  "ja493:20.1": "Ete hanatha bandhatha, ",
  "ja493:20.2": "mā vo muccittha jīvitaṃ, ",
  "ja493:20.3": "ṭhapetvā satthavāhaṃ ",
  "ja493:20.4": "sabbe bhasmaṃ karotha neti ",
  "ja493:21.1": "Tasmā hi paṇḍito poso ",
  "ja493:21.2": "sampassaṃ attham attano ",
  "ja493:21.3": "lobhassa na vasaṃ gacche ",
  "ja493:21.4": "haneyyārisakaṃ manaṃ. ",
  "ja493:22.1": "Etam ādīnavaṃ ñatvā ",
  "ja493:22.2": "taṇhā dukkhassa sambhavaṃ ",
  "ja493:22.3": "vītataṇho anādāno ",
  "ja493:22.4": "sato bhikkhu paribbaje. ",
  "ja493:23.1": ""
}
