  "ja488:0.1": "",
  "ja488:0.2": "",
  "ja488:0.3": "",
  "ja488:0.4": "",
  "ja488:1.1": "Assaṃ gavaṃ rajataṃ jātarūpaṃ ",
  "ja488:1.2": "bhariyañ ca so idha labhataṃ manāpaṃ ",
  "ja488:1.3": "puttehi dārehi samaṅgi hotu ",
  "ja488:1.4": "bhisāni te brāhmaṇa yo ahāsīti. ",
  "ja488:2.1": "Mālañ ca so kāsiyaṃ candanañ ca ",
  "ja488:2.2": "dhāretu putt' assa bahū bhavanti ",
  "ja488:2.3": "kāmesu tibbaṃ kurutaṃ apekkhaṃ ",
  "ja488:2.4": "bhisāni te brāhmaṇa yo ahāsīti. ",
  "ja488:3.1": "Pahūtadhañño kasimā yasassī ",
  "ja488:3.2": "putte gihī dhanimā sabbakāme ",
  "ja488:3.3": "vayaṃ apassaṃ gharam āvasātu ",
  "ja488:3.4": "bhisāni te brāhmaṇa yo ahāsi. ",
  "ja488:4.1": "So khattiyo hotu pasayhakārī ",
  "ja488:4.2": "rājābhirājā balavā yasassī ",
  "ja488:4.3": "sa cāturantaṃ mahim āvasātu ",
  "ja488:4.4": "bhisāni te brāhmaṇa yo ahāsi. ",
  "ja488:5.1": "So brāhmaṇo hotu avītarāgo ",
  "ja488:5.2": "muhuttanakkhattapathesu yutto ",
  "ja488:5.3": "pūjetu naṃ raṭṭhapatī yasassī ",
  "ja488:5.4": "bhisāni te brāhmaṇa yo ahāsi. ",
  "ja488:6.1": "Ajjhāyakaṃ sabbasamattavedanaṃ ",
  "ja488:6.2": "tapassinaṃ maññatu sabbaloko ",
  "ja488:6.3": "pūjetu naṃ jānapadā samecca ",
  "ja488:6.4": "bhisāni te brāhmaṇa yo ahāsi. ",
  "ja488:7.1": "Catussadaṃ gāmavaraṃ samiddhaṃ ",
  "ja488:7.2": "dinnaṃ hi so bhuñjatu Vāsavena ",
  "ja488:7.3": "avītarāgo maraṇaṃ upetu ",
  "ja488:7.4": "bhisāni te brāhmaṇa yo ahāsi. ",
  "ja488:8.1": "So gāmaṇī hotu sahāyamajjhe ",
  "ja488:8.2": "naccehi gītehi pamodamāno ",
  "ja488:8.3": "mā rājato vyasanam alattha kiñci ",
  "ja488:8.4": "bhisāni te brāhmaṇa yo ahāsi. ",
  "ja488:9.1": "Yaṃ ekarājā paṭhaviṃ vijetvā ",
  "ja488:9.2": "itthīsahassassa ṭhapetu aggaṃ ",
  "ja488:9.3": "sīmantinīnaṃ pavarā bhavātu ",
  "ja488:9.4": "bhisāni te brāhmaṇa yo ahāsi. ",
  "ja488:10.1": "Dāsīnaṃ hi sā sabbasamāgatānaṃ ",
  "ja488:10.2": "bhuñjeyya sāduṃ avikampamānā ",
  "ja488:10.3": "carātu lābhena vikatthamānā ",
  "ja488:10.4": "bhisāni te brāhmaṇa yo ahāsi. ",
  "ja488:11.1": "Āvāsiko hotu mahāvihāre ",
  "ja488:11.2": "navakammiko hotu Kajaṅgalāyaṃ ",
  "ja488:11.3": "ālokasandhiṃ divasā karotu ",
  "ja488:11.4": "bhisāni te brāhmaṇa yo ahāsi. ",
  "ja488:12.1": "So bajjhatū pāsasatehi chambhī ",
  "ja488:12.2": "rammā vanā niyyatu rājadhāniṃ ",
  "ja488:12.3": "tuttehi so haññatu pācanehi ",
  "ja488:12.4": "bhisāni te brāhmaṇa yo ahāsi. ",
  "ja488:13.1": "Alakkamālī tipukaṇṇaviddho ",
  "ja488:13.2": "laṭṭhīhato sappamukhaṃ upetu ",
  "ja488:13.3": "sakkacca baddho visikhaṃ carātu ",
  "ja488:13.4": "bhisāni te brāhmaṇa yo ahāsīti. ",
  "ja488:14.1": "Yo ve anaṭṭhaṃ naṭṭhanti cāha ",
  "ja488:14.2": "kāme va so labhataṃ bhuñjatañ ca ",
  "ja488:14.3": "agāramajjhe maraṇaṃ upetu ",
  "ja488:14.4": "yo vā bhonto saṃkati kañcid evāti. ",
  "ja488:15.1": "Yad esamānā vicaranti loke ",
  "ja488:15.2": "iṭṭhañ ca kantañ ca bahunnam etaṃ ",
  "ja488:15.3": "piyaṃ manuññaṃ idha jīvaloke, ",
  "ja488:15.4": "kasmā isayo na-ppasaṃsanti kāmeti. ",
  "ja488:16.1": "Kāmesu ve haññare bajjhare ca, ",
  "ja488:16.2": "kāmesu dukkhañ ca bhayañ ca jātaṃ, ",
  "ja488:16.3": "kāmesu bhūtādhipātī pamattā ",
  "ja488:16.4": "pāpāni kammāni karonti mohā. ",
  "ja488:17.1": "Te pāpadhammā pasavetva pāpaṃ ",
  "ja488:17.2": "kāyassa bhedā nirayaṃ vajanti, ",
  "ja488:17.3": "",
  "ja488:17.4": "",
  "ja488:18.1": "Vīmaṃsamāno isino bhisāni ",
  "ja488:18.2": "tīre gahetvāna thale nidhesiṃ, ",
  "ja488:18.3": "suddhā apāpā isayo vasanti, ",
  "ja488:18.4": "etāni te brahmacārī bhisānīti. ",
  "ja488:19.1": "Na te naṭā no pana kīḷaneyyā ",
  "ja488:19.2": "na bandhavā no pana te sahāyā, ",
  "ja488:19.3": "kismiṃ paratthambha sahassanetta ",
  "ja488:19.4": "isīhi tvaṃ kīḷasi devarājāti. ",
  "ja488:20.1": "Ācariyo me si pitā va mayhaṃ, ",
  "ja488:20.2": "esā patiṭṭhā khalitassa brahme, ",
  "ja488:20.3": "ekāparādhaṃ khama bhūripañña, ",
  "ja488:20.4": "na paṇḍitā kodhabalā bhavantīti. ",
  "ja488:21.1": "Suvositaṃ isinaṃ ekarattaṃ ",
  "ja488:21.2": "yaṃ Vāsavaṃ bhūtapat' addasāma, ",
  "ja488:21.3": "sabbe va bhonto sumanā bhavantu ",
  "ja488:21.4": "yaṃ brāhmaṇo paccapādi bhisānīti. ",
  "ja488:22.1": "Ahañ ca Sāriputto ca ",
  "ja488:22.2": "Moggallāno ca Kassapo ",
  "ja488:22.3": "Anuruddho Puṇṇo Ānando ",
  "ja488:22.4": "tadāsuṃ satta bhātaro. ",
  "ja488:23.1": "Bhaginī Uppalavaṇṇa, ",
  "ja488:23.2": "dāsī Khujjuttarā tadā, ",
  "ja488:23.3": "Citto gahapati dāso, ",
  "ja488:23.4": "yakkho Sātāgiro tadā. ",
  "ja488:24.1": "Pārileyyo tadā nāgo, ",
  "ja488:24.2": "Madhuvāseṭṭhavānaro, ",
  "ja488:24.3": "Kāḷudāyi tadā Sakko, ",
  "ja488:24.4": "evaṃ dhāretha jātakanti ",
  "ja488:25.1": ""
}
