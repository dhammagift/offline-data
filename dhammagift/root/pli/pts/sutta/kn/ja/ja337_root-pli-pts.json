  "ja337:0.3": "",
  "ja337:0.4": "",
  "ja337:1.1": "Na te pīṭham adāsimha ",
  "ja337:1.2": "na pānaṃ na pi bhojanaṃ, ",
  "ja337:1.3": "brahmacāri khamassu me, ",
  "ja337:1.4": "etaṃ passāmi accayanti. ",
  "ja337:2.1": "N' evābhisajjāmi na cāpi kuppe, ",
  "ja337:2.2": "na cāpi me appiyam āsi kiñci, ",
  "ja337:2.3": "atho pi me āsi manovitakko: ",
  "ja337:2.4": "etādiso nūna kulassa dhammoti. ",
  "ja337:3.1": "Es' asmākaṃ kule dhammo ",
  "ja337:3.2": "pitupitāmaho sadā: (cfr. II 356|6) ",
  "ja337:3.3": "āsanaṃ udakaṃ pajjaṃ ",
  "ja337:3.4": "sabb' etaṃ nipadāmase. ",
  "ja337:4.1": "Es' asmākaṃ kule dhammo ",
  "ja337:4.2": "pitupitāmaho sadā, ",
  "ja337:4.3": "sakkacca taṃ upaṭṭhahāma ",
  "ja337:4.4": "uttamaṃ viya ñātakanti. ",
  "ja337:5.1": ""
}
