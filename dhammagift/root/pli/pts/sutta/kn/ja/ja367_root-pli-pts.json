  "ja367:1.1": "sāliyachāpoti ",
  "ja367:1.2": "kaṇhasappaṃ agāhayi ",
  "ja367:1.3": "tena sappen' ayaṃ daṭṭho ",
  "ja367:1.4": "hato pāpānusāsako. ",
  "ja367:2.1": "Ahanantam ahantāraṃ ",
  "ja367:2.2": "yo naro hantum icchati ",
  "ja367:2.3": "evaṃ so nihato seti ",
  "ja367:2.4": "yathāyaṃ puriso hato. ",
  "ja367:3.1": "Ahanantaṃ aghātentaṃ ",
  "ja367:3.2": "yo naro hantum icchati ",
  "ja367:3.3": "evaṃ so nihato seti ",
  "ja367:3.4": "yathāyaṃ puriso hato. ",
  "ja367:4.1": "Yathā paṃsumuṭṭhiṃ puriso ",
  "ja367:4.2": "paṭivātaṃ paṭikkhipe ",
  "ja367:4.3": "tam eva so rajo hanti ",
  "ja367:4.4": "yathāyaṃ puriso hato. ",
  "ja367:5.1": "Yo appaduṭṭhassa narassa dussati (Dhp. v. 125.) ",
  "ja367:5.2": "suddhassa posassa anaṅgaṇassa ",
  "ja367:5.3": "tam eva bālaṃ pacceti pāpaṃ ",
  "ja367:5.4": "sukhumo rajo paṭivātaṃ va khittoti ",
  "ja367:6.1": ""
}
