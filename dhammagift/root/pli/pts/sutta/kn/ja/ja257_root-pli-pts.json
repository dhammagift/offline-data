  "ja257:0.4": "",
  "ja257:1.1": "Nāyaṃ gharānaṃ kusalo, ",
  "ja257:1.2": "lolo ayaṃ valīmukho, ",
  "ja257:1.3": "kataṃ kataṃ kho dūseyya, ",
  "ja257:1.4": "evaṃdhammam idaṃ kulanti. Na ",
  "ja257:2.1": "idaṃ cittavato lomaṃ, ",
  "ja257:2.2": "nāyaṃ assāsiko migo, ",
  "ja257:2.3": "satthaṃ me Janasandhena: ",
  "ja257:2.4": "nāyaṃ kiñci vijānatīti. ",
  "ja257:3.1": "Na mātaraṃ pitaraṃ vā ",
  "ja257:3.2": "bhātaraṃ bhaginiṃ sakhaṃ ",
  "ja257:3.3": "bhareyya tādiso poso, ",
  "ja257:3.4": "satthaṃ Dasarathena meti. ",
  "ja257:4.1": ""
}
