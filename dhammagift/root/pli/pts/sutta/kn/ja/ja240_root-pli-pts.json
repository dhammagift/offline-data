  "ja240:1.1": "Sabbo jano hiṃsito Piṅgalena, (Cfr. Dhp. p.149.) ",
  "ja240:1.2": "tasmiṃ mate paccayaṃ vedayanti, ",
  "ja240:1.3": "piyo nu te āsi akaṇhanetto, ",
  "ja240:1.4": "kasmā nu tvaṃ rodasi dvārapālāti. ",
  "ja240:2.1": "Na me piyo āsi akaṇhanetto, ",
  "ja240:2.2": "bhāyāmi paccāgamanāya tassa, ",
  "ja240:2.3": "ito gato hiṃseyya maccurājaṃ, ",
  "ja240:2.4": "so hiṃsito āneyya puna idhāti. ",
  "ja240:3.1": "",
  "ja240:3.2": "",
  "ja240:3.3": "Sigālo mānatthaddho ",
  "ja240:3.4": "",
  "ja240:4.1": "",
  "ja240:4.2": "",
  "ja240:5.1": "",
  "ja240:6.1": "",
  "ja240:6.2": "va ",
  "ja240:6.3": "",
  "ja240:6.4": ""
}
