{
  "ja527:0.1": "",
  "ja527:0.2": "",
  "ja527:0.3": "",
  "ja527:0.4": "",
  "ja527:1.1": "Nivesanaṃ kassa nu 'daṃ Sunanda ",
  "ja527:1.2": "pākārena paṇḍumayena guttaṃ, ",
  "ja527:1.3": "kā dissati aggisikhā va dūre ",
  "ja527:1.4": "vehāsayaṃ pabbatagge va acci. ",
  "ja527:2.1": "Dhītā n' ayaṃ kassa Sunanda hoti, ",
  "ja527:2.2": "suṇisā n' ayaṃ kassa atho pi bhariyā, ",
  "ja527:2.3": "akkhāhi me khippam id' eva puṭṭho: ",
  "ja527:2.4": "avāvaṭā, yadivā atthi bhattāti. Ahaṃ ",
  "ja527:3.1": "hi jānāmi janinda etaṃ ",
  "ja527:3.2": "matyā ca petyā ca atho pi assā, ",
  "ja527:3.3": "tath' eva so puriso bhūmipāla ",
  "ja527:3.4": "rattiṃdivaṃ appamatto tav' atthe. ",
  "ja527:4.1": "Iddho ca phīto ca subāḷhiko ca ",
  "ja527:4.2": "amacco te aññataro janinda, ",
  "ja527:4.3": "tass' esā bhariyā Ahipārakassa ",
  "ja527:4.4": "Ummadantī nāmadheyyena rājāti. ",
  "ja527:5.1": "Ambho ambho nāmam idaṃ imissā ",
  "ja527:5.2": "matyā ca petyā ca kataṃ susādhu, ",
  "ja527:5.3": "tathā hi mayhaṃ apalokayantī ",
  "ja527:5.4": "ummattakaṃ Ummadantī akāsīti. ",
  "ja527:6.1": "Sā puṇṇamāse migamandalocanā ",
  "ja527:6.2": "upāvisī puṇḍarīkattacaṅgī, ",
  "ja527:6.3": "dve puṇṇamāyo tadahū amaññaṃ ",
  "ja527:6.4": "disvāna pārāpatarattavāsiniṃ. ",
  "ja527:7.1": "Aḷārapamhehi subhehi vagguhi ",
  "ja527:7.2": "palobhayantī maṃ yadā udikkhati ",
  "ja527:7.3": "vijambhamānā harat' eva me mano ",
  "ja527:7.4": "jātā vane kimpurisīva pabbate. ",
  "ja527:8.1": "Tadā hi brahatī sāmā ",
  "ja527:8.2": "āmuttamaṇikuṇḍalā ",
  "ja527:8.3": "ekaccavasanā nārī ",
  "ja527:8.4": "migī bhantā v' udikkhati. ",
  "ja527:9.1": "Kadāssu maṃ tambanakhā sulomā ",
  "ja527:9.2": "bāhāmudū candanasāralittā ",
  "ja527:9.3": "vaṭṭaṅgulī sannatavīrakuttiyā ",
  "ja527:9.4": "nārī upaññissati sīsato subhā. ",
  "ja527:10.1": "Kadāssu maṃ kañcanamāluracchadā ",
  "ja527:10.2": "dhītā Tirīṭissa vilākamajjhā ",
  "ja527:10.3": "mudūhi bāhāhi palissajissati ",
  "ja527:10.4": "brahāvane jātadumaṃ va māluvā. ",
  "ja527:11.1": "Kadāssu lākhārasarattasucchavī ",
  "ja527:11.2": "bindutthanī puṇḍarīkattacaṅgī ",
  "ja527:11.3": "mukhaṃ mukhena upanāmayissati ",
  "ja527:11.4": "soṇḍo va soṇḍassa surāya thālaṃ. ",
  "ja527:12.1": "Yathāddasaṃ naṃ tiṭṭhantiṃ ",
  "ja527:12.2": "sabbagattaṃ manoramaṃ ",
  "ja527:12.3": "tato sakassa cittassa ",
  "ja527:12.4": "nāvabodhāmi kiñcanaṃ. Ummadantī ",
  "ja527:13.1": "mayā diṭṭhā ",
  "ja527:13.2": "āmuttamaṇikuṇḍalā, ",
  "ja527:13.3": "na supāmi divārattiṃ ",
  "ja527:13.4": "sahassaṃ va parājito. ",
  "ja527:14.1": "Sakko ca me varaṃ dajjā, ",
  "ja527:14.2": "so ca labbhetha me varo: ",
  "ja527:14.3": "ekarattiṃ dirattiṃ vā ",
  "ja527:14.4": "bhaveyyaṃ Ahipārako ",
  "ja527:14.5": "Ummadantyā ramitvāna, ",
  "ja527:14.6": "Sivirājā tato siyāti. ",
  "ja527:15.1": "Bhūtāni me bhūtapatī namassato ",
  "ja527:15.2": "āgamma yakkho idam evam abravi: ",
  "ja527:15.3": "rañño mano Ummadantyā niviṭṭho, ",
  "ja527:15.4": "dadāmi te taṃ, parivārayassūti. ",
  "ja527:16.1": "Puññā ca dhaṃse amaro na c' amhi, ",
  "ja527:16.2": "jano ca no pāpam idanti jaññā, ",
  "ja527:16.3": "bhuso ca ty-āssa manaso vighāto ",
  "ja527:16.4": "datvā piyaṃ Ummadantiṃ adiṭṭhāti. ",
  "ja527:17.1": "Janinda nāññatra tayā mayā vā ",
  "ja527:17.2": "sabb' āpi kammassa katassa jaññā ",
  "ja527:17.3": "yan te mayā Ummadantī padinnā, ",
  "ja527:17.4": "bhusehi rājā vanathaṃ sajāhi. ",
  "ja527:18.1": "Yo pāpakaṃ kamma karaṃ manusso ",
  "ja527:18.2": "so maññatī: mā-y-idha maññiṃsu aññe, ",
  "ja527:18.3": "",
  "ja527:18.4": "",
  "ja527:19.1": "Añño nu te ko 'dha naro pathavyā ",
  "ja527:19.2": "saddheyya lokasmi: na sā piyāti, ",
  "ja527:19.3": "bhuso ca ty-āssa manaso vighāto ",
  "ja527:19.4": "datvā piyaṃ Ummadantiṃ adiṭṭhā. ",
  "ja527:20.1": "Addhā piyā mayha janinda esā, ",
  "ja527:20.2": "na sā mamaṃ appiyā bhūmipāla, ",
  "ja527:20.3": "gacch' eva tvaṃ Ummadantiṃ bhadante ",
  "ja527:20.4": "sīho va selassa guhaṃ upeti. ",
  "ja527:21.1": "Na pīḷitā attadukkhena dhīrā ",
  "ja527:21.2": "sukhapphalaṃ kamma pariccajanti, ",
  "ja527:21.3": "sammohitā cāpi sukhena mattā ",
  "ja527:21.4": "na pāpakaṃ kamma samācaranti. ",
  "ja527:22.1": "Tuvaṃ hi mātā ca pitā ca mayhaṃ ",
  "ja527:22.2": "bhattā patī posako devatā ca, ",
  "ja527:22.3": "dāso ahaṃ tuyha saputtadāro, ",
  "ja527:22.4": "yathāsukhaṃ Sibba karohi kāmaṃ. ",
  "ja527:23.1": "Yo issaro 'mhīti karoti pāpaṃ ",
  "ja527:23.2": "katvā ca so n' uttapate paresaṃ ",
  "ja527:23.3": "na tena so jīvati dīgham āyu, ",
  "ja527:23.4": "devāpi pāpena samekkhare na. ",
  "ja527:24.1": "Aññātakaṃ sāmikehi padinnaṃ ",
  "ja527:24.2": "dhamme ṭhitā ye paṭicchanti dānaṃ ",
  "ja527:24.3": "paṭicchakā dāyakā cāpi tattha ",
  "ja527:24.4": "sukhapphalaṃ ñeva karonti kammaṃ. ",
  "ja527:25.1": "Añño nu te ko 'dha naro pathavyā ",
  "ja527:25.2": "saddheyya lokasmi: na sā piyāti ",
  "ja527:25.3": "",
  "ja527:25.4": "",
  "ja527:26.1": "Addhā piyā mayha janinda esā, ",
  "ja527:26.2": "na sā mamaṃ appiyā bhūmipāla ",
  "ja527:26.3": "yan te mayā Ummadantī padinnā, ",
  "ja527:26.4": "bhusehi rājā vanathaṃ sajāhi. ",
  "ja527:27.1": "Yo attadukkhena parassa dukkhaṃ ",
  "ja527:27.2": "sukhena vā attasukhaṃ dahāti ",
  "ja527:27.3": "yath' ev' idaṃ mayha tathā paresaṃ ",
  "ja527:27.4": "so evaṃ jānāti sa vedi dhammaṃ. ",
  "ja527:28.1": "Añño nu te ko dha naro pathavyā ",
  "ja527:28.2": "saddheyya etc. ",
  "ja527:28.3": "",
  "ja527:28.4": "",
  "ja527:29.1": "Janinda jānāsi piyā mam' esā, ",
  "ja527:29.2": "na sā mamaṃ appiyā bhūmipāla, ",
  "ja527:29.3": "piyena te dammi piyaṃ janinda, ",
  "ja527:29.4": "piyadāyino deva piyaṃ labhanti. ",
  "ja527:30.1": "So nūn' ahaṃ vadhissāmi ",
  "ja527:30.2": "attānaṃ kāmahetukaṃ, ",
  "ja527:30.3": "na hi dhammaṃ adhammena ",
  "ja527:30.4": "ahaṃ vadhituṃ ussahe. ",
  "ja527:31.1": "Sace tuvaṃ mayha satiṃ janinda ",
  "ja527:31.2": "na kāmayāsi naraviriyaseṭṭha ",
  "ja527:31.3": "cajāmi naṃ sabbajanassa Sibba, ",
  "ja527:31.4": "mayā pamuttaṃ tato nam avhayesi. ",
  "ja527:32.1": "Adūsiyañ ce Ahipāraka tvaṃ ",
  "ja527:32.2": "cajāsi katte ahitāya ty-āssa ",
  "ja527:32.3": "mahā ca te upavādo pi assa ",
  "ja527:32.4": "na cāpi ty-āssa nagaramhi pakkho. ",
  "ja527:33.1": "Ahaṃ sahissaṃ upavādam etaṃ ",
  "ja527:33.2": "nindaṃ pasaṃsaṃ garaham pi sabbaṃ, ",
  "ja527:33.3": "mam etam āgacchatu bhūmipāla, ",
  "ja527:33.4": "yathāsukhaṃ Sibba karohi kāmaṃ. ",
  "ja527:34.1": "Yo n' eva nindaṃ na puna-ppasaṃsaṃ ",
  "ja527:34.2": "ādiyatī garahaṃ no pi pūjaṃ ",
  "ja527:34.3": "sirī ca lakkhī ca apeti tamhā ",
  "ja527:34.4": "āpo suvuṭṭhī va yathā thalamhā. ",
  "ja527:35.1": "Yaṃ kiñci dukkhaṃ ca sukhañ ca etto ",
  "ja527:35.2": "dhammātisāraṃ va manovighātaṃ ",
  "ja527:35.3": "urasā ahaṃ paccupadissāmi sabbaṃ ",
  "ja527:35.4": "pathavī yathā thāvarānaṃ tasānaṃ. ",
  "ja527:36.1": "Dhammātisāraṃ va manovighātaṃ ",
  "ja527:36.2": "dukkhañ ca n' icchāmi ahaṃ paresaṃ, ",
  "ja527:36.3": "eko p' imaṃ hārayissāmi bhāraṃ ",
  "ja527:36.4": "dhamme ṭhito kañci na tāpayanto. ",
  "ja527:37.1": "Saggūpagaṃ puññakammaṃ janinda, ",
  "ja527:37.2": "mā me tuvaṃ antarāyaṃ akāsi, ",
  "ja527:37.3": "dadāmi te Ummadantiṃ pasanno ",
  "ja527:37.4": "rājā va yaññe dhanaṃ brāhmaṇānaṃ. ",
  "ja527:38.1": "Addhā tuvaṃ katte hitesi mayhaṃ, ",
  "ja527:38.2": "sakhā mamaṃ Ummadantī tuvañ ca, ",
  "ja527:38.3": "nindeyyuṃ devā pitaro ca sabbe, ",
  "ja527:38.4": "pāpañ ca passa abhisamparāyaṃ. ",
  "ja527:39.1": "Na h' et' adhammaṃ Sivirāja vajjuṃ ",
  "ja527:39.2": "sanegamā jānapadā ca sabbe ",
  "ja527:39.3": "yan te mayā Ummadantī padinnā, ",
  "ja527:39.4": "bhusehi rāja vanathaṃ sajāhi. ",
  "ja527:40.1": "Addhā tuvaṃ katte hitesi mayhaṃ ",
  "ja527:40.2": "sakhā mamaṃ Ummadantī tuvañ ca, ",
  "ja527:40.3": "satañ ca dhammāni sukittitāni ",
  "ja527:40.4": "samuddavelā va duraccayāni. ",
  "ja527:41.1": "Āhūniyo me si hitānukampī ",
  "ja527:41.2": "dhātā vidhātā c' asi kāmapālo, ",
  "ja527:41.3": "",
  "ja527:41.4": "",
  "ja527:42.1": "Addhā hi sabbaṃ Ahipārakā tuvaṃ ",
  "ja527:42.2": "dhammaṃ acārī mama kattaputta, ",
  "ja527:42.3": "añño nu te ko idha sotthikattā ",
  "ja527:42.4": "dipado naro aruṇe jīvaloke. ",
  "ja527:43.1": "Tuvan nu seṭṭho, ",
  "ja527:43.2": "tvam anuttaro si, tvaṃ dhammagū dhammavidū sumedho, ",
  "ja527:43.3": "so dhammagutto ciram eva jīva, ",
  "ja527:43.4": "dhammañ ca me desaya dhammapāla. ",
  "ja527:44.1": "Tad iṃgha Ahipāraka ",
  "ja527:44.2": "suṇohi vacanam mama, ",
  "ja527:44.3": "dhammaṃ te desayissāmi ",
  "ja527:44.4": "sataṃ āsevitaṃ ahaṃ. ",
  "ja527:45.1": "Sādhu dhammaruci rājā, ",
  "ja527:45.2": "sādhu paññāṇavā naro, ",
  "ja527:45.3": "sādhu mittānaṃ adubbho, ",
  "ja527:45.4": "pāpass' akaraṇaṃ sukhaṃ. ",
  "ja527:46.1": "Akkodhanassa vijite ",
  "ja527:46.2": "ṭhitadhammassa rājino ",
  "ja527:46.3": "sukhaṃ manussā āsetha ",
  "ja527:46.4": "sītacchāyāya saṃghare. ",
  "ja527:47.1": "Na vāham etaṃ abhirocayāmi ",
  "ja527:47.2": "kammaṃ asamekkha kataṃ asādhuṃ, ",
  "ja527:47.3": "ye vāpi ñatvā na sayaṃ karonti, ",
  "ja527:47.4": "upamā imā mayhaṃ tuvaṃ suṇohi: ",
  "ja527:48.1": "Gavañ ce taramānānaṃ ",
  "ja527:48.2": "jimhaṃ gacchati puṅgavo (III 111|17) ",
  "ja527:48.3": "sabbā tā jimhaṃ gacchanti ",
  "ja527:48.4": "nette jimhagate sati. ",
  "ja527:49.1": "Evam evaṃ manussesu ",
  "ja527:49.2": "yo hoti seṭṭhasammato ",
  "ja527:49.3": "so ce adhammaṃ carati ",
  "ja527:49.4": "pag eva itarā pajā, ",
  "ja527:49.5": "sabbaṃ raṭṭhaṃ dukkhaṃ seti ",
  "ja527:49.6": "rājā ce hoti adhammiko. ",
  "ja527:50.1": "Gavañ ce taramānānaṃ ",
  "ja527:50.2": "ujuṃ gacchati puṅgavo ",
  "ja527:50.3": "sabbā tā ujuṃ gacchanti ",
  "ja527:50.4": "nette ujugate sati. ",
  "ja527:51.1": "Evam eva manussesu ",
  "ja527:51.2": "yo hoti seṭṭhasammato ",
  "ja527:51.3": "so ce pi dhammaṃ carati ",
  "ja527:51.4": "pag eva itarā pajā, ",
  "ja527:51.5": "sabbaṃ raṭṭhaṃ sukhaṃ seti ",
  "ja527:51.6": "rājā ce hoti dhammiko. ",
  "ja527:52.1": "Na cāp' ahaṃ adhammena ",
  "ja527:52.2": "amarattam pi patthaye ",
  "ja527:52.3": "imaṃ vā paṭhaviṃ sabbaṃ ",
  "ja527:52.4": "vijetuṃ Ahipāraka. Yaṃ ",
  "ja527:53.1": "hi kiñci manussesu ",
  "ja527:53.2": "ratanaṃ idha vijjati ",
  "ja527:53.3": "gāvo dāso hiraññañ ca ",
  "ja527:53.4": "vatthiyaṃ haricandanaṃ ",
  "ja527:54.1": "[Assitthiyo ratanaṃ maṇikañca ",
  "ja527:54.2": "yañ cāp' ime candimasuriyā abhipālayanti] ",
  "ja527:54.3": "na tassa hetu visamaṃ careyya, ",
  "ja527:54.4": "majjhe Sivīnaṃ usabho 'mhi jāto. ",
  "ja527:55.1": "Netā pitā uggato raṭṭhapālo ",
  "ja527:55.2": "dhammaṃ Sivīnaṃ apacāyamāno ",
  "ja527:55.3": "so dhammam evānuvicintayanto ",
  "ja527:55.4": "tasmā sake cittavase na vatto. ",
  "ja527:56.1": "Addhā tuvaṃ mahārāja ",
  "ja527:56.2": "niccaṃ avyasanaṃ sivaṃ ",
  "ja527:56.3": "karissasi ciraṃ rajjaṃ, ",
  "ja527:56.4": "paññā hi tava tādisī. ",
  "ja527:57.1": "Etaṃ te anumodāma ",
  "ja527:57.2": "yaṃ dhammaṃ na-ppamajjasi, ",
  "ja527:57.3": "dhammaṃ pamajja khattiyo ",
  "ja527:57.4": "raṭṭhā cavati issaro. ",
  "ja527:58.1": "Dhammañ cara mahārāja ",
  "ja527:58.2": "mātāpitusu khattiya (supra p. 123) ",
  "ja527:58.3": "idha dhammaṃ caritvāna ",
  "ja527:58.4": "rāja saggaṃ gamissasi. ",
  "ja527:59.1": "Dhammañ cara mahārāja ",
  "ja527:59.2": "puttadāresu khattiya, ",
  "ja527:59.3": "etc. ",
  "ja527:60.1": "Dhammañ cara mahārāja ",
  "ja527:60.2": "mittāmaccesu khattiya, ",
  "ja527:60.3": "etc. ",
  "ja527:61.1": "Dhammañ cara mahārāja ",
  "ja527:61.2": "vāhanesu balesu ca, ",
  "ja527:61.3": "etc. ",
  "ja527:62.1": "Dhammañ cara mahārāja ",
  "ja527:62.2": "gāmesu nigamesu ca, ",
  "ja527:62.3": "etc. ",
  "ja527:63.1": "Dhammañ cara mahārāja ",
  "ja527:63.2": "raṭṭhe janapadesu ca, ",
  "ja527:63.3": "etc. ",
  "ja527:64.1": "Dhammañ cara mahārāja ",
  "ja527:64.2": "samaṇe brāhmaṇesu ca, ",
  "ja527:64.3": "etc. ",
  "ja527:65.1": "Dhammañ cara mahārāja ",
  "ja527:65.2": "migapakkhīsu khattiya, ",
  "ja527:65.3": "etc. ",
  "ja527:66.1": "Dhammañ cara mahārāja, ",
  "ja527:66.2": "dhammo ciṇṇo sukhāvaho, ",
  "ja527:66.3": "idha dhammaṃ caritvāna ",
  "ja527:66.4": "rāja saggaṃ gamissasi. Idha ",
  "ja527:67.1": "dhammaṃ caritvāna ",
  "ja527:67.2": "saindadevā sabrahmakā ",
  "ja527:67.3": "suciṇṇena divam pattā, ",
  "ja527:67.4": "mā dhammaṃ rāja pamādoti. Kin ",
  "ja527:68.1": ""
}
