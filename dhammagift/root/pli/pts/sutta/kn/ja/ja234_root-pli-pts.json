  "ja234:1.1": "Tvam eva dānim akara ",
  "ja234:1.2": "yaṃ kāmo vyapagamā tayi, ",
  "ja234:1.3": "so 'yaṃ appaṭisandhiko ",
  "ja234:1.4": "kharā chinnaṃ va ",
  "ja234:2.1": "rerukanti. Atricchāatilobhena ",
  "ja234:2.2": "atilobhamadena ca ",
  "ja234:2.3": "evaṃ hāyati atthamhā ",
  "ja234:2.4": "ahaṃ va Asitābhuyāti. ",
  "ja234:3.1": ""
}
