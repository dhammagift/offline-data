  "ja214:0.4": "",
  "ja214:1.1": "Puṇṇaṃ nadiṃ yena ca peyyam āhu ",
  "ja214:1.2": "jātaṃ yavaṃ yena ca guyham āhu ",
  "ja214:1.3": "dūraṃ gataṃ yena ca avhayanti ",
  "ja214:1.4": "so ty-āgato handa ca bhuñja brāhmaṇāti. ",
  "ja214:2.1": "Yato maṃ saratī rājā ",
  "ja214:2.2": "vāyasam pi pahetave ",
  "ja214:2.3": "haṃsā koñcā mayūrā ca ",
  "ja214:2.4": "asatī yeva pāpiyāti. ",
  "ja214:3.1": ""
}
