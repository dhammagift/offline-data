  "ja484:0.4": "",
  "ja484:1.1": "Sampannaṃ sālikedāraṃ, ",
  "ja484:1.2": "suvā bhuñjanti Kosiya, ",
  "ja484:1.3": "paṭivedemi te brahme: ",
  "ja484:1.4": "na naṃ vāretum ussahe. ",
  "ja484:2.1": "Eko va tattha sakuṇo, ",
  "ja484:2.2": "so tesaṃ sabbasundaro ",
  "ja484:2.3": "bhutvā sāliṃ yathākāmaṃ ",
  "ja484:2.4": "tuṇḍenādāya gacchatīti. ",
  "ja484:3.1": "Oḍḍentu vālapāsāni ",
  "ja484:3.2": "yathā bajjhetha so dijo, ",
  "ja484:3.3": "jivañ ca naṃ gahetvāna ",
  "ja484:3.4": "ānayetha mam' antiketi. ",
  "ja484:4.1": "Ete bhutvā ca pītvā ca ",
  "ja484:4.2": "pakkamanti vihaṅgamā, ",
  "ja484:4.3": "eko baddho 'smi pāsena, ",
  "ja484:4.4": "kiṃ pāpaṃ pakatam mayāti ",
  "ja484:5.1": "Udaraṃ nūna aññesaṃ ",
  "ja484:5.2": "suva accodaraṃ tava, ",
  "ja484:5.3": "bhutvā sāliṃ yathākāmaṃ ",
  "ja484:5.4": "tuṇḍenādāya gacchasi. ",
  "ja484:6.1": "Koṭṭhan nu tattha pūresi, ",
  "ja484:6.2": "suva veran nu te mayā, ",
  "ja484:6.3": "puṭṭho me samma akkhāhi: ",
  "ja484:6.4": "kuhiṃ sāliṃ nidhīyasīti. ",
  "ja484:7.1": "Na me veraṃ tayā saddhiṃ, ",
  "ja484:7.2": "koṭṭho mayhaṃ na vijjati, ",
  "ja484:7.3": "inaṃ muñcām' iṇaṃ dammi ",
  "ja484:7.4": "sampatto koṭisimbaliṃ, ",
  "ja484:7.5": "nidhim pi tattha nidahāmi, ",
  "ja484:7.6": "evaṃ jānāhi Kosiyāti. ",
  "ja484:8.1": "Kīdisan te iṇadānaṃ, ",
  "ja484:8.2": "iṇamokkho te kīdiso, ",
  "ja484:8.3": "nidhiṃnidhānaṃ akkhāhi ",
  "ja484:8.4": "atha pāsā pamokkhasīti. ",
  "ja484:9.1": "Ajātapakkhā taruṇā ",
  "ja484:9.2": "puttakā mayha Kosiya, ",
  "ja484:9.3": "te maṃ tathā bharissanti, ",
  "ja484:9.4": "tasmā tesaṃ iṇaṃ dade. ",
  "ja484:10.1": "Mātāpitā ca me vuddhā ",
  "ja484:10.2": "jiṇṇakā gatayobbanā, ",
  "ja484:10.3": "tesaṃ tuṇḍena hātūna ",
  "ja484:10.4": "muñce pubbakataṃ iṇaṃ. ",
  "ja484:11.1": "Aññe pi tattha sakuṇā ",
  "ja484:11.2": "khīṇapakkhā sudubbalā, ",
  "ja484:11.3": "tesaṃ puññatthiko dammi, ",
  "ja484:11.4": "taṃ nidhiṃ āhu paṇḍitā. ",
  "ja484:12.1": "Edisam me iṇadānaṃ, ",
  "ja484:12.2": "iṇamokkho me ediso, nidhiṃnidhānaṃ ",
  "ja484:12.3": "akkhātaṃ, ",
  "ja484:12.4": "evaṃ jānāhi Kosiyāti. ",
  "ja484:13.1": "Bhaddako vat' ayaṃ pakkhī ",
  "ja484:13.2": "dijo paramadhammiko, ",
  "ja484:13.3": "ekaccesu manussesu ",
  "ja484:13.4": "ayaṃ dhammo na vijjati. ",
  "ja484:14.1": "Bhuñja sāliṃ yathākāmaṃ ",
  "ja484:14.2": "saha sabbehi ñātibhi ",
  "ja484:14.3": "puna pi suva passemu, ",
  "ja484:14.4": "piyaṃ me tava dassananti. ",
  "ja484:15.1": "Bhuttañ ca pītañ ca tav' assamamhi ",
  "ja484:15.2": "ratī ca no Kosiya te sakāse, ",
  "ja484:15.3": "nikkhittadaṇḍesu dadāhi dānaṃ, ",
  "ja484:15.4": "jiṇṇe ca mātāpitaro bharassūti gātham āha. ",
  "ja484:16.1": "Lakkhī vata me udapādi ajja ",
  "ja484:16.2": "yo addasāsiṃ pavaraṃ dijānaṃ, ",
  "ja484:16.3": "suvassa sutvāna subhāsitāni ",
  "ja484:16.4": "kāhāmi puññāni anappakānīti gātham āha. ",
  "ja484:17.1": "So Kosiyo attamano udaggo ",
  "ja484:17.2": "annañ ca pānañ ca bhisaṃ karitvā ",
  "ja484:17.3": "annena pānena pasannacitto ",
  "ja484:17.4": "santappayī samaṇe brāhmaṇe cāti. ",
  "ja484:18.1": ""
}
