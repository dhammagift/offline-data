  "ja288:1.1": "Agghanti macchā adhikaṃ sahassaṃ, ",
  "ja288:1.2": "na so atthi yo ima saddaheyya, ",
  "ja288:1.3": "mayhañ ca assū idha satta māsā, ",
  "ja288:1.4": "aham pi taṃ macchuddānaṃ kiṇeyyanti. ",
  "ja288:2.1": "Macchānaṃ bhojanaṃ datvā ",
  "ja288:2.2": "mama dakkhiṇam ādisi, ",
  "ja288:2.3": "taṃ dakkhiṇaṃ sarantiyā ",
  "ja288:2.4": "kataṃ apacitiṃ tayāti ",
  "ja288:3.1": "Paduṭṭhacittassa na phāti hoti, ",
  "ja288:3.2": "na cāpi taṃ devatā pūjayanti ",
  "ja288:3.3": "yo bhātaraṃ pettikaṃ sāpateyyaṃ ",
  "ja288:3.4": "avañcayī dukkatakammakārīti. Nānacchandā ",
  "ja288:4.1": ""
}
