  "ja431:0.4": "",
  "ja431:1.1": "Sutaṃ m' etaṃ mahābrahme: ",
  "ja431:1.2": "kāme bhuñjati Hārito, ",
  "ja431:1.3": "kacc' etaṃ vacanaṃ tucchaṃ, ",
  "ja431:1.4": "kacci suddho irīyasīti. ",
  "ja431:2.1": "Evam etaṃ mahārāja ",
  "ja431:2.2": "yathā te vacanaṃ sutaṃ, ",
  "ja431:2.3": "kummagge paṭipanno 'smi ",
  "ja431:2.4": "mohaneyyesu mucchitoti. ",
  "ja431:3.1": "Ādu paññā kimatthikā ",
  "ja431:3.2": "nipuṇā sādhucintanī ",
  "ja431:3.3": "yāva uppatitaṃ rāgaṃ ",
  "ja431:3.4": "kiṃmano na vinodayeti. ",
  "ja431:4.1": "Cattāro 'me mahārāja ",
  "ja431:4.2": "loke atibalā bhusā ",
  "ja431:4.3": "rāgo doso mado moho ",
  "ja431:4.4": "yattha paññā na gādhatīti. ",
  "ja431:5.1": "Arahaṃ sīlasampanno ",
  "ja431:5.2": "suddho carati Hārito ",
  "ja431:5.3": "medhāvī paṇḍito c' eva, ",
  "ja431:5.4": "iti no sammato bhavanti. ",
  "ja431:6.1": "Medhāvinam pi hiṃsanti ",
  "ja431:6.2": "isiṃ dhammaguṇe ratam ",
  "ja431:6.3": "vitakkā pāpakā rāja ",
  "ja431:6.4": "subhā rāgūpasaṃhitāti. ",
  "ja431:7.1": "Uppann' āyaṃ sarīrajo ",
  "ja431:7.2": "rāgo vaṇṇavidūsano tava, ",
  "ja431:7.3": "taṃ pajaha, bhaddam atthu te, ",
  "ja431:7.4": "bahunn' āsi medhāvi sammatoti. ",
  "ja431:8.1": "Te andhakaraṇe kāme ",
  "ja431:8.2": "bahudukkhe mahāvise ",
  "ja431:8.3": "tesaṃ mūlaṃ gavesissaṃ, ",
  "ja431:8.4": "checchaṃ rāgaṃ sabandhananti. ",
  "ja431:9.1": "Idaṃ vatvāna Hārito ",
  "ja431:9.2": "isi saccaparakkamo (Alwis, Nirvāna 121.) ",
  "ja431:9.3": "kāmarāgaṃ virājetvā ",
  "ja431:9.4": "brahmalokūpago ahūti ",
  "ja431:10.1": ""
}
