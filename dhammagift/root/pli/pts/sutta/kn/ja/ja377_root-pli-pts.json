  "ja377:0.4": "",
  "ja377:1.1": "Mā tāta kujjhi, na hi sādhu kodho, ",
  "ja377:1.2": "bahum pi te adiṭṭhaṃ assutañ ca, ",
  "ja377:1.3": "",
  "ja377:1.4": "",
  "ja377:2.1": "Agārino annadapānavatthadā (= vol.I. p.401.) ",
  "ja377:2.2": "avhāyikā tam pi disaṃ vadanti, ",
  "ja377:2.3": "esā disā paramā Setaketu ",
  "ja377:2.4": "yaṃ patvā dukkhī sukhino bhavantīti. ",
  "ja377:3.1": "Kharājinā jaṭilā paṃkadantā ",
  "ja377:3.2": "dummukkharūpā ye 'me japanti ",
  "ja377:3.3": "kacci nu te mānusake payoge ",
  "ja377:3.4": "idaṃ vidū parimuttā apāyāti. ",
  "ja377:4.1": "Pāpāni kammāni karitvāna rāja ",
  "ja377:4.2": "bahussuto ce na careyya dhammaṃ ",
  "ja377:4.3": "sahassavedo pi na taṃ paṭicca ",
  "ja377:4.4": "dukkhā pamuñce caraṇaṃ apatvāti. ",
  "ja377:5.1": "Sahassavedo pi na taṃ paṭicca ",
  "ja377:5.2": "dukkhā pamuñce caraṇaṃ apatvā, ",
  "ja377:5.3": "maññāmi vedā aphalā bhavanti, ",
  "ja377:5.4": "sasaññamaṃ caraṇaṃ ñeva saccanti. ",
  "ja377:6.1": "Na h' eva vedā aphalā bhavanti ",
  "ja377:6.2": "sasaṃyamaṃ caraṇaṃ yeva saccaṃ, ",
  "ja377:6.3": "kittiṃ hi pappoti adhicca vede ",
  "ja377:6.4": "santiṃ pun' eti caraṇena dantoti. Paṃko ",
  "ja377:7.1": ""
}
