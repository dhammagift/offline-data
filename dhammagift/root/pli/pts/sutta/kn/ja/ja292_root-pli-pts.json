  "ja292:1.1": "mahārāja ",
  "ja292:1.2": "kākarājā nivāsiko ",
  "ja292:1.3": "asītiyā sahassehi ",
  "ja292:1.4": "Supatto parivārito. ",
  "ja292:2.1": "Tassa dohaḷinī bhariyā ",
  "ja292:2.2": "Suphassā maccham icchati ",
  "ja292:2.3": "rañño mahānase pakkaṃ ",
  "ja292:2.4": "paccagghaṃ rājabhojanaṃ. ",
  "ja292:3.1": "Tes' āhaṃ pahito dūto ",
  "ja292:3.2": "rañño c' amhi idhāgato, ",
  "ja292:3.3": "bhattu apacitiṃ kummi, ",
  "ja292:3.4": "nāsāyam akaraṃ vaṇanti. Puṭṭhassa ",
  "ja292:4.1": ""
}
