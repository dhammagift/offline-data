  "ja325:0.1": "",
  "ja325:0.2": "",
  "ja325:0.3": "",
  "ja325:0.4": "",
  "ja325:1.1": "Samaṇaṃ taṃ maññamāno ",
  "ja325:1.2": "upagañchiṃ asaññataṃ, ",
  "ja325:1.3": "so maṃ daṇḍena pahāsi ",
  "ja325:1.4": "yathā assamaṇo tathā. ",
  "ja325:2.1": "Kin te jaṭāhi dummedha, ",
  "ja325:2.2": "kin te ajinasāṭiyā, ",
  "ja325:2.3": "(Dhp. v. 394.) abhantaran te gahanaṃ, ",
  "ja325:2.4": "bāhiraṃ parimajjasīti. ",
  "ja325:3.1": "Ehi godha nivattassu, ",
  "ja325:3.2": "bhuñja sālīnaṃ odanaṃ, ",
  "ja325:3.3": "telaṃ loṇañ ca me atthi ",
  "ja325:3.4": "pahūtaṃ mayha pipphalinti. ",
  "ja325:4.1": "Esa bhiyyo pavekkhāmi ",
  "ja325:4.2": "vammīkaṃ sataporisaṃ, ",
  "ja325:4.3": "telaṃ loṇañ ca kin te si ",
  "ja325:4.4": "ahitaṃ mayha pipphalinti. ",
  "ja325:5.1": ""
}
