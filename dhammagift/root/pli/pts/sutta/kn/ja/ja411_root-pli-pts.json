  "ja411:1.1": "Kāḷāni kesāni pure ahesuṃ ",
  "ja411:1.2": "jātāni sīsamhi yathāpadese, ",
  "ja411:1.3": "tān' ajja setāni Susīma disvā ",
  "ja411:1.4": "dhammaṃ carā, brahmacariyassa kāloti. ",
  "ja411:2.1": "Mam' eva deva palitaṃ na tuyhaṃ, ",
  "ja411:2.2": "mam' eva sīsaṃ mama uttamaṅgaṃ, ",
  "ja411:2.3": "atthaṃ karissanti musā abhāṇiṃ, ",
  "ja411:2.4": "ekāparādhaṃ khama rājaseṭṭha. ",
  "ja411:3.1": "Daharo tuvaṃ dassanīyo si rāja, ",
  "ja411:3.2": "paṭhamuggato hosi yathā kaḷīro, ",
  "ja411:3.3": "rajjañ ca kārehi mamañ ca passa, ",
  "ja411:3.4": "mā kālikaṃ anudhāvi janindāti. ",
  "ja411:4.1": "Passāmi vo 'haṃ dahariṃ kumāriṃ ",
  "ja411:4.2": "sāmaṭṭhapassaṃ sutanuṃ sumajjhaṃ, ",
  "ja411:4.3": "kāḷāpavāḷā va pavellamānā ",
  "ja411:4.4": "sā lobhayantī va naresu gacchati. ",
  "ja411:5.1": "Tam ena passāmi parena nāriṃ ",
  "ja411:5.2": "āsītikaṃ nāvutikaṃ va jaccā ",
  "ja411:5.3": "daṇḍaṃ gahetvā va pavedhamānaṃ ",
  "ja411:5.4": "gopānasībhoggasamaṃ carantinti ",
  "ja411:6.1": "So 'haṃ tam evānuvicintayanto ",
  "ja411:6.2": "eko sayāmi sayanassa majjhe, ",
  "ja411:6.3": "aham pi evaṃ iti pekkhamāno ",
  "ja411:6.4": "na gahe rame, brahmacariyassa kālo. ",
  "ja411:7.1": "Rajju vālambanī c' esā ",
  "ja411:7.2": "yā gehe vasato rati ",
  "ja411:7.3": "etam pi chetvāna vajanti dhīrā ",
  "ja411:7.4": "anapekkhino kāmasukhaṃ pahāyāti. ",
  "ja411:8.1": ""
}
