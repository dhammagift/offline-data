  "ja519:0.1": "",
  "ja519:0.2": "",
  "ja519:0.3": "",
  "ja519:0.4": "",
  "ja519:1.1": "Kā vedhamānā girikandarāyaṃ ",
  "ja519:1.2": "ekā tuvaṃ tiṭṭhasi saññatūru, ",
  "ja519:1.3": "puṭṭhāsi me pāṇipameyyamajjhe, ",
  "ja519:1.4": "akkhāhi me nāmañ ca bandhave ca. ",
  "ja519:2.1": "Obhāsayaṃ vanaṃ rammaṃ ",
  "ja519:2.2": "sīhavyagghanisevitaṃ ",
  "ja519:2.3": "kā vā tvam asi kalyāṇi, ",
  "ja519:2.4": "kassa vā tvaṃ sumajjhime, ",
  "ja519:2.5": "abhivādemi taṃ bhadde, ",
  "ja519:2.6": "dānav' āhaṃ, nam' atthu teti. ",
  "ja519:3.1": "Yo putto Kāsirājassa ",
  "ja519:3.2": "Sotthisenoti taṃ vidū ",
  "ja519:3.3": "tassāhaṃ Sambulā bhariyā, ",
  "ja519:3.4": "evaṃ jānāhi dānava, ",
  "ja519:3.5": "[abhivādemi taṃ bhante, ",
  "ja519:3.6": "Sambulāhaṃ, nam' atthu teti]. ",
  "ja519:4.1": "Vedehaputto bhaddan te ",
  "ja519:4.2": "vane vasati āturo, ",
  "ja519:4.3": "tam ahaṃ rogasammattaṃ ",
  "ja519:4.4": "ekā ekaṃ upaṭṭh' ahaṃ. ",
  "ja519:5.1": "Ahañ ca vanam uñchāya ",
  "ja519:5.2": "madhumaṃsaṃ migābilaṃ. ",
  "ja519:5.3": "yadā harāmi taṃ bhakkho, ",
  "ja519:5.4": "tassa nūn' ajja nādhatīti. ",
  "ja519:6.1": "Kiṃ vane rājaputtena ",
  "ja519:6.2": "āturena karissasi ",
  "ja519:6.3": "Sambule pariciṇṇena, ",
  "ja519:6.4": "ahaṃ bhattā bhavāmi te. ",
  "ja519:7.1": "Sokaṭṭāya durattāya ",
  "ja519:7.2": "kiṃ rūpaṃ vijjate mama, ",
  "ja519:7.3": "aññaṃ pariyesa bhaddan te ",
  "ja519:7.4": "abhirūpataraṃ mayā. ",
  "ja519:8.1": "Ehi maṃgirim āruyha, ",
  "ja519:8.2": "bhariyā mayhaṃ catussatā, ",
  "ja519:8.3": "tāsaṃ tvaṃ pavarā hohi ",
  "ja519:8.4": "sabbakāmasamiddhinī. ",
  "ja519:9.1": "Nanu hāṭakavaṇṇābhe ",
  "ja519:9.2": "yaṃ kiñci manas' icchasi ",
  "ja519:9.3": "sabban taṃ pacuraṃ mayhaṃ, ",
  "ja519:9.4": "ramasv-ajja mayā saha. ",
  "ja519:10.1": "No ce tuvaṃ maheseyyaṃ ",
  "ja519:10.2": "Sambule kārayissasi ",
  "ja519:10.3": "alaṃ tvaṃ pātarāsāya ",
  "ja519:10.4": "maññe bhakkhā bhavissasi. ",
  "ja519:11.1": "Tañ ca sattajaṭo luddo ",
  "ja519:11.2": "kaḷāro purisādako ",
  "ja519:11.3": "vane nāthaṃ apassantiṃ ",
  "ja519:11.4": "Sambulaṃ aggahī bhuje. ",
  "ja519:12.1": "Adhipannā pisācena ",
  "ja519:12.2": "luddenāmisacakkhunā ",
  "ja519:12.3": "sā ca sattuvasam pattā ",
  "ja519:12.4": "patim evānusocati. ",
  "ja519:13.1": "Na me idaṃ tathā dukkhaṃ ",
  "ja519:13.2": "yaṃ maṃ khādeyya rakkhaso ",
  "ja519:13.3": "yañ ce me ayyaputtassa ",
  "ja519:13.4": "mano hessati aññathā. ",
  "ja519:14.1": "Na santi devā, pavasanti nūna, (II 123|15) ",
  "ja519:14.2": "na ha nūna santi idha lokapālā, ",
  "ja519:14.3": "sahasā karontānaṃ asaññatānaṃ ",
  "ja519:14.4": "na ha nūna santi paṭisedhitāroti. ",
  "ja519:15.1": "Itthīnam esā pavarā yasassinī ",
  "ja519:15.2": "santā samā aggi-r-iv' uggatejā, ",
  "ja519:15.3": "tañ ce tuvaṃ rakkhasādesi kaññaṃ ",
  "ja519:15.4": "muddhā va hi sattadhā te phaleyya, ",
  "ja519:15.5": "mā tvaṃ jahī muñca patibbatā yāti. ",
  "ja519:16.1": "Sā ca assamam āgañchi ",
  "ja519:16.2": "pamuttā purisādakā ",
  "ja519:16.3": "nīḷaṃ phalinasakuṇīva gatasiṃgaṃ ",
  "ja519:16.4": "va ālayaṃ. ",
  "ja519:17.1": "Sā tattha paridevesi ",
  "ja519:17.2": "rājaputtī yasassinī ",
  "ja519:17.3": "Sambulā utumattakkhā ",
  "ja519:17.4": "vane nāthaṃ apassantī: ",
  "ja519:18.1": "Samaṇe brāhmaṇe vande ",
  "ja519:18.2": "sampannacaraṇe ise. ",
  "ja519:18.3": "rājaputtaṃ apassantī ",
  "ja519:18.4": "tumhaṃ hi saraṇaṃ gatā. ",
  "ja519:19.1": "Vande sīhe ca vyagghe ca ",
  "ja519:19.2": "ye ca aññe vane migā ",
  "ja519:19.3": "rājaputtaṃ ",
  "ja519:19.4": "etc. ",
  "ja519:20.1": "Tiṇalatāni osadhyo ",
  "ja519:20.2": "pabbatāni vanāni ca ",
  "ja519:20.3": "etc. ",
  "ja519:20.4": "",
  "ja519:21.1": "Vande indīvarīsāmaṃ ",
  "ja519:21.2": "rattiṃ nakkhattamāliniṃ ",
  "ja519:21.3": "etc. ",
  "ja519:21.4": "",
  "ja519:22.1": "Vande Bhāgīrathiṃ gaṅgaṃ ",
  "ja519:22.2": "savantīnaṃ paṭiggahaṃ ",
  "ja519:22.3": "etc. ",
  "ja519:22.4": "",
  "ja519:23.1": "Vande ahaṃ [pabbata]-rājaseṭṭhaṃ ",
  "ja519:23.2": "Himavantaṃ siluccayaṃ ",
  "ja519:23.3": "etc, ",
  "ja519:23.4": "",
  "ja519:24.1": "Atisāyaṃ vatāgañchi ",
  "ja519:24.2": "rājaputti yasassini, ",
  "ja519:24.3": "kena nu jja samāgañchi, ",
  "ja519:24.4": "ko te piyataro mayāti. ",
  "ja519:25.1": "Idaṃ kho 'haṃ tadāvocaṃ ",
  "ja519:25.2": "gahitā tena sattunā, ",
  "ja519:25.3": "na me idaṃ tathā dukkhaṃ ",
  "ja519:25.4": "yaṃ maṃ khadeyya rakkhaso ",
  "ja519:25.5": "yañ ce me ayyaputtassa ",
  "ja519:25.6": "mano hessati aññathāti g. ā. ",
  "ja519:26.1": "Corīnaṃ bahubuddhīnaṃ ",
  "ja519:26.2": "yāsu saccaṃ sudullabhaṃ ",
  "ja519:26.3": "thīnaṃ bhāvo durājāno ",
  "ja519:26.4": "macchassevodake gatanti. ",
  "ja519:27.1": "Tathā maṃ saccaṃ pāletu ",
  "ja519:27.2": "pālayissati ce mamaṃ ",
  "ja519:27.3": "yathāhaṃ nābhijānāmi ",
  "ja519:27.4": "aññaṃ piyataraṃ tayā, ",
  "ja519:27.5": "etena saccavajjena ",
  "ja519:27.6": "vyādhi te vūpasammatūti g. ā. ",
  "ja519:28.1": "Ye kuñjarā sattasatā uḷārā ",
  "ja519:28.2": "rakkhanti rattindivam uyyutāvudhā ",
  "ja519:28.3": "dhanuggahānañ ca satāni soḷasa ",
  "ja519:28.4": "kathaṃvidhe passati bhadde sattavoti g. ",
  "ja519:29.1": "ā. Alaṃkatāyo padumuttarattacā ",
  "ja519:29.2": "virāgitā passati haṃsagaggarā, ",
  "ja519:29.3": "tāsaṃ suṇitvā mitagītavādinaṃ ",
  "ja519:29.4": "na 'dāni me tāta tathā yathā pure. ",
  "ja519:30.1": "Suvaṇṇasaṃkaccadharā suviggahā ",
  "ja519:30.2": "alaṃkatā mānusiy' accharūpamā ",
  "ja519:30.3": "senūpiyā tāta aninditaṅgiyo ",
  "ja519:30.4": "khattiyakaññā paṭilābhayanti naṃ. ",
  "ja519:31.1": "Sace ahaṃ tāta tathā yathā pure ",
  "ja519:31.2": "patīta uñchāya punā vane bhare ",
  "ja519:31.3": "sammānaye maṃ na ca maṃ vimānaye ",
  "ja519:31.4": "ito pi me tāta tato varaṃ siyā. ",
  "ja519:32.1": "Yaṃ annapāne vipulasmi ohite ",
  "ja519:32.2": "nārī vimaṭṭhābharaṇā alaṃkatā ",
  "ja519:32.3": "sabbaṅgupetā patino va appiyā ",
  "ja519:32.4": "ābajjha tassā maraṇaṃ tato varaṃ. ",
  "ja519:33.1": "Api ce daḷiddā kapaṇā anāḷhiyā ",
  "ja519:33.2": "kālādutīyā patino ca sā piyā ",
  "ja519:33.3": "sabbaṅgupetāya pi appiyāya ",
  "ja519:33.4": "ayam eva seyyā kapaṇāpi yā piyāti. ",
  "ja519:34.1": "Sudullabh' itthī purisassa yā hitā, ",
  "ja519:34.2": "bhatt' itthiyā dullabho yo hito ca, ",
  "ja519:34.3": "hitā ca te sīlavatī ca bhāriyā, ",
  "ja519:34.4": "janinda dhammañ cara Sambulāyāti gātham āha. ",
  "ja519:35.1": "Sace tuvaṃ vipule laddhabhoge ",
  "ja519:35.2": "issāvatiṇṇā maraṇaṃ upesi ",
  "ja519:35.3": "ahañ ca te bhadde imā ca kaññā ",
  "ja519:35.4": "sabbe va te vacanakarā bhavāmāti. ",
  "ja519:36.1": ""
}
