  "ja362:0.4": "",
  "ja362:1.1": "Sīlaṃ seyyo sutaṃ seyyo ",
  "ja362:1.2": "iti me saṃsayo ahū, ",
  "ja362:1.3": "sīlam eva sutā seyyo ",
  "ja362:1.4": "iti me n' atthi saṃsayo. ",
  "ja362:2.1": "Moghā jāti ca vaṇṇo ca, ",
  "ja362:2.2": "sīlam eva kir' uttamaṃ, ",
  "ja362:2.3": "sīlena anupetassa ",
  "ja362:2.4": "suten' attho na vijjati. ",
  "ja362:3.1": "Khattiyo ca adhammaṭṭho ",
  "ja362:3.2": "vesso cādhammanissito ",
  "ja362:3.3": "te pariccajj' ubho loke ",
  "ja362:3.4": "upapajjanti duggatiṃ. ",
  "ja362:4.1": "Khattiyā brāhmaṇā vessā ",
  "ja362:4.2": "suddā caṇḍālapukkusā ",
  "ja362:4.3": "idha dhammaṃ caritvāna ",
  "ja362:4.4": "bhavanti tidive samā. ",
  "ja362:5.1": "Na vedā samparāyāya ",
  "ja362:5.2": "na jāti no pi bandhavā ",
  "ja362:5.3": "sakañ ca sīlaṃ saṃsuddhaṃ ",
  "ja362:5.4": "samparāyasukhāya cāti. Hirin ",
  "ja362:6.1": ""
}
