  "ja336:0.3": "",
  "ja336:0.4": "",
  "ja336:1.1": "Tiṇaṃ tiṇanti lapasi, ",
  "ja336:1.2": "ko nu te tiṇam āhari, ",
  "ja336:1.3": "kin nu te tiṇakicc' atthi, ",
  "ja336:1.4": "tiṇam eva pabhāsasīti. ",
  "ja336:2.1": "Idhāgamā brahmacārī ",
  "ja336:2.2": "brahā Chatto bahussuto, ",
  "ja336:2.3": "so me sabbaṃ samādāya ",
  "ja336:2.4": "tiṇaṃ nikkhippa gacchatīti. ",
  "ja336:3.1": "Ev' etaṃ hoti kattabbaṃ ",
  "ja336:3.2": "appena bahum icchatā: ",
  "ja336:3.3": "sabbaṃ sakassa ādānaṃ ",
  "ja336:3.4": "anādānaṃ tiṇassa cāti. ",
  "ja336:3.5": "",
  "ja336:4.1": "Sīlavanto na kubbanti, ",
  "ja336:4.2": "bālo sīlāni kubbati, ",
  "ja336:4.3": "aniccasīlaṃ dussīlaṃ, ",
  "ja336:4.4": "kiṃ paṇḍiccaṃ karissatīti. ",
  "ja336:5.1": ""
}
