  "ja264:1.1": "Panādo nāma so rājā ",
  "ja264:1.2": "yassa yūpo suvaṇṇayo ",
  "ja264:1.3": "tiriyaṃ soḷasapabbedho uccam ",
  "ja264:1.4": "āhu sahassadhā ",
  "ja264:2.1": "Sahassakaṇḍū satabhedo ",
  "ja264:2.2": "dhajālu haritāmayo, ",
  "ja264:2.3": "Anaccuṃ tattha gandhabbā ",
  "ja264:2.4": "cha sahassāni sattadhā, ",
  "ja264:3.1": "Evam etaṃ tadā āsi ",
  "ja264:3.2": "yathā bhāsasi Bhaddaji. ",
  "ja264:3.3": "Sakko ahaṃ tadā āsiṃ ",
  "ja264:3.4": "veyyāvaccakaro tavanti. ",
  "ja264:4.1": ""
}
