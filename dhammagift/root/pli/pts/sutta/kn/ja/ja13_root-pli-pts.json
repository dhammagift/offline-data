  "ja13:1.1": "Dhi-r-atthu kaṇḍinaṃ sallaṃ ",
  "ja13:1.2": "purisaṃ gāḷhavedhinaṃ, ",
  "ja13:1.3": "dhi-r-atthu taṃ janapadaṃ ",
  "ja13:1.4": "yatth' itthī parināyikā, ",
  "ja13:1.5": "te cāpi dhikkitā sattā ",
  "ja13:1.6": "ye itthīnaṃ vasaṃ gatāti. ",
  "ja13:2.1": ""
}
