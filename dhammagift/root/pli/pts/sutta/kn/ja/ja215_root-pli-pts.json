  "ja215:1.1": "Avadhī vata attānaṃ ",
  "ja215:1.2": "kacchapo vyāharaṃ giraṃ, ",
  "ja215:1.3": "suggahītasmiṃ kaṭṭhasmiṃ ",
  "ja215:1.4": "vācāya sakiyā vadhi. ",
  "ja215:2.1": "Etam pi disvā naraviriyaseṭṭha ",
  "ja215:2.2": "vācaṃ pamuñce kusalaṃ nātivelaṃ, ",
  "ja215:2.3": "passasi bahubhāṇena ",
  "ja215:2.4": "kacchapaṃ vyasanaṃ gatanti. ",
  "ja215:3.1": ""
}
