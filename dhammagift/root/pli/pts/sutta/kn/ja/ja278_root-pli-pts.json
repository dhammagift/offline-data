  "ja278:1.1": "",
  "ja278:1.2": "lahucittassa dūbhino ",
  "ja278:1.3": "sabbakāmaduhassevā ",
  "ja278:1.4": "imaṃ dukkhaṃ titikkhasi. ",
  "ja278:2.1": "Siṅgena nihanāh' etaṃ ",
  "ja278:2.2": "padasā ca adhiṭṭhaha, ",
  "ja278:2.3": "bhiyyo bālā pakujjheyyuṃ ",
  "ja278:2.4": "no c' assa paṭisedhakoti. ",
  "ja278:3.1": "Mam evāyaṃ maññamāno ",
  "ja278:3.2": "aññam p' eva karissati, ",
  "ja278:3.3": "te taṃ tattha vadhissanti, ",
  "ja278:3.4": "sā me mutti bhavissatīti. ",
  "ja278:4.1": ""
}
