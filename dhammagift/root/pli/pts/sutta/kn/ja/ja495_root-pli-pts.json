  "ja495:1.1": "Rājā avoca Vidhūraṃ ",
  "ja495:1.2": "dhammakāmo Yudhiṭṭhilo: [III,401.] ",
  "ja495:1.3": "brāhmaṇe Vidhūra pariyesa ",
  "ja495:1.4": "sīlavante bahussute ",
  "ja495:2.1": "Virate methunā dhammā ",
  "ja495:2.2": "ye me bhuñjeyyu bhojanaṃ, ",
  "ja495:2.3": "dakkhiṇaṃ samma dassāma ",
  "ja495:2.4": "yattha dinnaṃ mahapphalaṃ. ",
  "ja495:3.1": "Dullabhā brāhmaṇā deva ",
  "ja495:3.2": "sīlavanto bahussutā ",
  "ja495:3.3": "viratā methunā dhammā ",
  "ja495:3.4": "ye te bhuñjeyyu bhojanaṃ. ",
  "ja495:4.1": "Dasa khalu mahārāja ",
  "ja495:4.2": "yā tā brāhmaṇajātiyo, ",
  "ja495:4.3": "tesaṃ vibhaṅgaṃ vicayaṃ ",
  "ja495:4.4": "vitthārena suṇohi me. ",
  "ja495:5.1": "Pasibbake gahetvāna ",
  "ja495:5.2": "puṇṇe mūlassa saṃvute ",
  "ja495:5.3": "osadhikāyo ganthenti ",
  "ja495:5.4": "nahāyanti japanti ca ",
  "ja495:6.1": "Tikicchakasamā rāja, ",
  "ja495:6.2": "te pi vuccanti brāhmaṇā, ",
  "ja495:6.3": "akkhātā te mahārāja, ",
  "ja495:6.4": "tādise nipatāmase. ",
  "ja495:7.1": "Apetā te brāhmañña, ",
  "ja495:7.2": "[iti rājā Koravyo] ",
  "ja495:7.3": "na te vuccanti brāhmaṇā, ",
  "ja495:7.4": "aññe Vidhūra pariyesa ",
  "ja495:7.5": "sīlavante bahussute ",
  "ja495:8.1": "Virate methunā dhammā ",
  "ja495:8.2": "ye me bhuñjeyyu bhojanaṃ, ",
  "ja495:8.3": "dakkhiṇaṃ samma dassāma ",
  "ja495:8.4": "yattha dinnaṃ mahapphalaṃ. ",
  "ja495:9.1": "Kiṃkaṇikāyo gahetvāna ",
  "ja495:9.2": "ghosenti purato pi te, ",
  "ja495:9.3": "pesanāni te gacchanti, ",
  "ja495:9.4": "rathacariyāsu sikkhare, ",
  "ja495:10.1": "Paricārakasamā rāja, ",
  "ja495:10.2": "te pi vuccanti brāhmaṇā, ",
  "ja495:10.3": "akkhātā te mahārāja, ",
  "ja495:10.4": "tādise nipatāmase. ",
  "ja495:11.1": "Apetā tā brāhmaññā ",
  "ja495:11.2": "[iti rājā Koravyo] ",
  "ja495:11.3": "na te vuccanti brāhmaṇā, ",
  "ja495:11.4": "aññe Vidhūra pariyesa ",
  "ja495:11.5": "sīlavante bahussute ",
  "ja495:12.1": "Virate methunā dhammā ",
  "ja495:12.2": "ye me bhuñjeyyu bhojanaṃ, ",
  "ja495:12.3": "dakkhiṇaṃ samma dassāma ",
  "ja495:12.4": "yattha dinnaṃ mahapphalaṃ. ",
  "ja495:13.1": "Kamaṇḍaluṃ gahetvāna ",
  "ja495:13.2": "vaṃkadaṇḍañ ca brāhmaṇā ",
  "ja495:13.3": "paccupessanti rājāno ",
  "ja495:13.4": "gāmesu nigamesu ca, ",
  "ja495:13.5": "‘Nādinne vuṭṭhahissāma ",
  "ja495:13.6": "gāmamhi ca vanamhi ca', ",
  "ja495:14.1": "niggāhakasamā rāja, ",
  "ja495:14.2": "te pi vuccanti brāhmaṇā, ",
  "ja495:14.3": "akkhātā te mahārāja, ",
  "ja495:14.4": "tādise nipatāmase. ",
  "ja495:15.1": "Apetā te brāhmaññā, ",
  "ja495:15.2": "[iti rājā Koravyo] ",
  "ja495:15.3": "na te vuccanti brāhmaṇā, ",
  "ja495:15.4": "aññe Vidhūra pariyesa ",
  "ja495:15.5": "sīlavante bahussute ",
  "ja495:16.1": "Virate methunā dhammā ",
  "ja495:16.2": "ye me bhuñjeyyu bhojanaṃ, ",
  "ja495:16.3": "dakkhiṇaṃ samma dassāma ",
  "ja495:16.4": "yattha dinnaṃ mahapphalaṃ. ",
  "ja495:17.1": "Parūḷhakacchanakhalomā ",
  "ja495:17.2": "paṃkadantā rajassirā ",
  "ja495:17.3": "okiṇṇā rajaraṇūhi ",
  "ja495:17.4": "yācakā vicaranti te, ",
  "ja495:18.1": "Khāṇughātasamā rāja, ",
  "ja495:18.2": "te pi vuccanti brāhmaṇā, ",
  "ja495:18.3": "akkhātā te mahārāja, ",
  "ja495:18.4": "tādise nipatāmase. ",
  "ja495:19.1": "Apetā te brāhmaññā, ",
  "ja495:19.2": "[iti rājā Koravyo] ",
  "ja495:19.3": "na te vuccanti brāhmaṇā, ",
  "ja495:19.4": "aññe Vidhūra pariyesa ",
  "ja495:19.5": "sīlavante bahussute ",
  "ja495:20.1": "Virate methunā dhammā ",
  "ja495:20.2": "ye me bhuñjeyyu bhojanaṃ, ",
  "ja495:20.3": "dakkhiṇaṃ samma dassāma ",
  "ja495:20.4": "yattha dinnaṃ mahapphalaṃ. ",
  "ja495:21.1": "Harīṭakaṃ āmalakaṃ ",
  "ja495:21.2": "ambajambuvibhīṭakaṃ ",
  "ja495:21.3": "labujaṃ dantapoṇāni ",
  "ja495:21.4": "beluvā padarāni ca ",
  "ja495:22.1": "Rājāyatanaṃ ucchupuṭaṃ ",
  "ja495:22.2": "dhūmanettaṃ madhuañjanaṃ ",
  "ja495:22.3": "uccāvacāni paṇiyāni ",
  "ja495:22.4": "vipaṇenti janādhipa, ",
  "ja495:23.1": "Vāṇijakasamā rāja, ",
  "ja495:23.2": "te pi vuccanti trāhmaṇā, ",
  "ja495:23.3": "akkhātā te mahārāja, ",
  "ja495:23.4": "tādise nipatānase. ",
  "ja495:24.1": "Apetā te bāhmaññā, ",
  "ja495:24.2": "[iti rājā Koravyo] ",
  "ja495:24.3": "na te vuccanti brāhmaṇā, ",
  "ja495:24.4": "aññe Vidhūra pariyesa ",
  "ja495:24.5": "sīlavante bahussute ",
  "ja495:25.1": "Virate methunā dhammā ",
  "ja495:25.2": "ye me bhuñjeyyu bhojanaṃ, ",
  "ja495:25.3": "dakkhiṇaṃ samma dassāma ",
  "ja495:25.4": "yattha dinnaṃ mahapphalaṃ. ",
  "ja495:26.1": "Kasiṃ vāṇijjaṃ kārenti, ",
  "ja495:26.2": "posayanti ajaḷake, ",
  "ja495:26.3": "kumāriyo pavecchanti, ",
  "ja495:26.4": "vivāhant' āvahanti ca, ",
  "ja495:27.1": "Samā Ambaṭṭhavessehi, ",
  "ja495:27.2": "te pi vuccanti brāhmaṇā, ",
  "ja495:27.3": "akkhātā te mahārāja, ",
  "ja495:27.4": "tādise nipatāmase. ",
  "ja495:28.1": "Apetā te brāhmaññā, ",
  "ja495:28.2": "[iti rājā Koravyo] ",
  "ja495:28.3": "na te vuccanti brāhmaṇā, ",
  "ja495:28.4": "aññe Vidhūra pariyesa ",
  "ja495:28.5": "sīlavante bahussute ",
  "ja495:29.1": "Virate methunā dhammā ",
  "ja495:29.2": "ye me bhuñjeyyu bhojanaṃ, ",
  "ja495:29.3": "dakkhiṇaṃ samma dassāma ",
  "ja495:29.4": "yattha dinnaṃ mahapphalaṃ. ",
  "ja495:30.1": "Nikkhantabhikkhaṃ bhuñjanti ",
  "ja495:30.2": "gāmesv-eke purohitā, ",
  "ja495:30.3": "bahū te paṭipucchanti ",
  "ja495:30.4": "aṇḍacchedā tilañchakā, ",
  "ja495:31.1": "Pasū pi tattha haññanti ",
  "ja495:31.2": "mahisā sūkarā ajā, ",
  "ja495:31.3": "goghātakasamā rāja, ",
  "ja495:31.4": "te pi vuccanti brāhmaṇā, ",
  "ja495:31.5": "akkhātā te mahārāja, ",
  "ja495:31.6": "tādise nipatāmase. ",
  "ja495:32.1": "Apetā te brāhmaññā, ",
  "ja495:32.2": "[iti rājā Koravyo] ",
  "ja495:32.3": "na te vuccanti brāhmaṇā, ",
  "ja495:32.4": "aññe Vidhūra pariyesa ",
  "ja495:32.5": "sīlavante bahussute ",
  "ja495:33.1": "Virate methunā dhammā ",
  "ja495:33.2": "ye me bhuñjeyyu bhojanaṃ, ",
  "ja495:33.3": "dakkhiṇaṃ samma dassāma ",
  "ja495:33.4": "yattha dinnaṃ mahapphalaṃ. ",
  "ja495:34.1": "Asicammaṃ gahetvāna ",
  "ja495:34.2": "khaggaṃ paggayha brāhmaṇā ",
  "ja495:34.3": "vessapathesu tiṭṭhanti, ",
  "ja495:34.4": "satthaṃ abbāhayanti pi, ",
  "ja495:35.1": "Samā gopanisādehi, ",
  "ja495:35.2": "te pi vuccanti brāhmaṇā, ",
  "ja495:35.3": "akkhātā te mahārāja, ",
  "ja495:35.4": "tādise nipatāmase. ",
  "ja495:36.1": "Apetā te brāhmaññā, ",
  "ja495:36.2": "[iti rājā Koravyo] ",
  "ja495:36.3": "na te vuccanti brāhmaṇā, ",
  "ja495:36.4": "aññe Vidhūra pariyesa ",
  "ja495:36.5": "sīlavante bahussute ",
  "ja495:37.1": "Virate methunā dhammā ",
  "ja495:37.2": "ye me bhuñjeyyu bhojanaṃ, ",
  "ja495:37.3": "dakkhiṇaṃ samma dassāma ",
  "ja495:37.4": "yattha dinnaṃ mahapphalaṃ. ",
  "ja495:38.1": "Araññe kuṭikaṃ katvā ",
  "ja495:38.2": "kuṭāni kārayanti te, ",
  "ja495:38.3": "sasabiḷāre bādhenti ",
  "ja495:38.4": "āgodhā macchakacchapaṃ, Luddakā ",
  "ja495:39.1": "te mahārāja, ",
  "ja495:39.2": "te pi vuccanti brāhmaṇā, ",
  "ja495:39.3": "akkhātā te mahārāja, ",
  "ja495:39.4": "tādise nipatāmase. ",
  "ja495:40.1": "Apetā te brāhmaññā, ",
  "ja495:40.2": "[iti rājā Koravyo] ",
  "ja495:40.3": "na te vuccanti brāhmaṇā, ",
  "ja495:40.4": "aññe Vidhūra pariyesa ",
  "ja495:40.5": "sīlavante bahussute ",
  "ja495:41.1": "Virate methunā dhammā ",
  "ja495:41.2": "ye me bhuñjeyyu bhojanaṃ, ",
  "ja495:41.3": "dakkhiṇaṃ samma dassāma ",
  "ja495:41.4": "yattha dinnaṃ mahapphalaṃ. ",
  "ja495:42.1": "Aññe dhanassa kāmāhi ",
  "ja495:42.2": "heṭṭhā mañce pasakkhitā, ",
  "ja495:42.3": "rājāno upari nahāyanti ",
  "ja495:42.4": "somayāge upaṭṭhite, ",
  "ja495:43.1": "Malamajjanasamā rāja, ",
  "ja495:43.2": "te pi vuccanti brāhmaṇā, ",
  "ja495:43.3": "akkhātā te mahārāja, ",
  "ja495:43.4": "tādise nipatāmase. ",
  "ja495:44.1": "Apetā te brāhmaññā, ",
  "ja495:44.2": "[iti rājā Koravyo] ",
  "ja495:44.3": "na te vuccanti brāhmaṇā, ",
  "ja495:44.4": "aññe Vidhūra pariyesa ",
  "ja495:44.5": "sīlavante bahussute ",
  "ja495:45.1": "Virate methunā dhammā ",
  "ja495:45.2": "ye me bhuñjeyyu bhojanaṃ, ",
  "ja495:45.3": "dakkhiṇaṃ samma dassāma ",
  "ja495:45.4": "yattha dinnaṃ mahapphalanti. ",
  "ja495:46.1": "Atthi kho brāhmaṇā deva ",
  "ja495:46.2": "sīlavanto bahussutā ",
  "ja495:46.3": "viratā methunā dhammā ",
  "ja495:46.4": "ye te bhuñjeyyu bhojanaṃ. ",
  "ja495:47.1": "Ekañ ca bhattaṃ bhuñjanti ",
  "ja495:47.2": "na ca majjaṃ pivanti te. ",
  "ja495:47.3": "akkhātā te mahāraja, ",
  "ja495:47.4": "tādise nipatāmaseti. ",
  "ja495:48.1": "Ete [kho] brāhmaṇā Vidhūrā ",
  "ja495:48.2": "sīlavanto bahussutā, ",
  "ja495:48.3": "ete Vidhūra pariyesa, ",
  "ja495:48.4": "khippañ ca te nimantayāti ",
