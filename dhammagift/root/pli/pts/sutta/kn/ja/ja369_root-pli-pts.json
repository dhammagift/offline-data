  "ja369:0.4": "",
  "ja369:1.1": "Ky-āhaṃ devānam akaraṃ ",
  "ja369:1.2": "kiṃ pāpaṃ pakataṃ mayā ",
  "ja369:1.3": "yaṃ me sirasmiṃ ūhacca ",
  "ja369:1.4": "cakkaṃ bhamati matthaketi. ",
  "ja369:2.1": "Atikkamma ramaṇakaṃ ",
  "ja369:2.2": "sadāmattañ ca dūbhakaṃ ",
  "ja369:2.3": "brahmattarañ ca pāsādaṃ ",
  "ja369:2.4": "ken' atthena idhāgatoti. ",
  "ja369:3.1": "Ito bahutarā bhogā ",
  "ja369:3.2": "atra maññe bhavissare, ",
  "ja369:3.3": "iti etāya saññāya ",
  "ja369:3.4": "passa maṃ vyasanaṃ gatanti. ",
  "ja369:4.1": "Catubbhi aṭṭh' ajjhagamā ",
  "ja369:4.2": "aṭṭhāhi pi ca soḷasa (vol.I p.414.) ",
  "ja369:4.3": "soḷasāhi ca battiṃsa, ",
  "ja369:4.4": "atricchaṃ cakkam āsado, ",
  "ja369:4.5": "icchāhatassa posassa ",
  "ja369:4.6": "cakkaṃ bhamati matthake. ",
  "ja369:5.1": "Uparivisālaṃ duppūraṃ ",
  "ja369:5.2": "icchāvisaṭagāminiṃ ",
  "ja369:5.3": "ye ca taṃ anugijjhanti ",
  "ja369:5.4": "te honti cakkadhārinoti. ",
  "ja369:6.1": ""
}
