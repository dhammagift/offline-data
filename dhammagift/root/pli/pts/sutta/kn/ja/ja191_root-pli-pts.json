  "ja191:1.1": "Api Ruhaka-cchinnāpi ",
  "ja191:1.2": "jiyā sandhiyyate puna, ",
  "ja191:1.3": "sandhiyyassu purāṇiyā, ",
  "ja191:1.4": "mā kodhassa vasaṃ gamīti. ",
  "ja191:2.1": "Vijjamānāsu marūdvāsu ",
  "ja191:2.2": "vijjamānesu kārisu ",
  "ja191:2.3": "aññaṃ jiyaṃ karissāma, alaṃ ",
  "ja191:2.4": "ñeva purāṇiyāti. Ayam eva ",
  "ja191:3.1": ""
}
