  "ja173:1.1": "Tāta māṇavako eso ",
  "ja173:1.2": "tālamūlaṃ apassito, ",
  "ja173:1.3": "agārakañ c' idaṃ atthi, ",
  "ja173:1.4": "handa dem' ass' agārakanti. ",
  "ja173:2.1": "Mā kho taṃ tāta pakkosi, ",
  "ja173:2.2": "dūseyya no agārakaṃ, ",
  "ja173:2.3": "n' etādisaṃ mukhaṃ hoti ",
  "ja173:2.4": "brāhmaṇassa susīlinoti. ",
  "ja173:3.1": ""
}
