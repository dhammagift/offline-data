  "ja358:1.1": "Aham eva dūsiyā bhūnahatā ",
  "ja358:1.2": "rañño Mahāpatāpassa, ",
  "ja358:1.3": "pamuñcantu Dhammapālaṃ, ",
  "ja358:1.4": "hatthe me deva chedehīti. ",
  "ja358:2.1": "Aham eva dūsiyā bhūnahatā ",
  "ja358:2.2": "rañño Mahāpatāpassa, ",
  "ja358:2.3": "pamuñcantu Dhammapālaṃ, ",
  "ja358:2.4": "pāde me deva chedehīti. ",
  "ja358:3.1": "Aham eva dūsiyā bhūnahatā ",
  "ja358:3.2": "rañño Mahāpatāpassa, ",
  "ja358:3.3": "pamuñcantu Dhammapālaṃ, ",
  "ja358:3.4": "sīsam me deva chedehīti ",
  "ja358:4.1": "Na ha nūn' imassa rañño ",
  "ja358:4.2": "mittāmaccā ca vijjare suhadā ",
  "ja358:4.3": "ye na vadanti rājānaṃ: ",
  "ja358:4.4": "mā ghātayi orasaṃ puttaṃ: ",
  "ja358:5.1": "Na ha nūn' imassa rañño mittā ",
  "ja358:5.2": "ñātī ca vijjare suhadā ",
  "ja358:5.3": "ye na vadanti rājānaṃ: ",
  "ja358:5.4": "mā ghātayi atrajaṃ puttanti ",
  "ja358:6.1": "Candanasārānulittā ",
  "ja358:6.2": "bāhā chijjanti Dhammapālassa ",
  "ja358:6.3": "dāyādassa pathavyā, ",
  "ja358:6.4": "pāṇā me deva rujjhantīti. Vikkama re mahāmiga, ",
  "ja358:7.1": ""
}
