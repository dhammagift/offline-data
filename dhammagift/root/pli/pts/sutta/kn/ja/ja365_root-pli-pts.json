  "ja365:1.1": "samma sumukha ",
  "ja365:1.2": "jūte akkhaparājito, ",
  "ja365:1.3": "sevehi ambapakkāni, ",
  "ja365:1.4": "viriyan te bhakkhayāmaseti. ",
  "ja365:2.1": "Alikaṃ vata maṃ samma ",
  "ja365:2.2": "abhūtena pasaṃsayi, ",
  "ja365:2.3": "ko te suto vā diṭṭho vā ",
  "ja365:2.4": "sumukho nāma makkaṭo. ",
  "ja365:3.1": "Ajjāpi me taṃ manasi ",
  "ja365:3.2": "yaṃ maṃ tvaṃ ahiguṇḍika ",
  "ja365:3.3": "dhaññāpaṇaṃ pavisitvā ",
  "ja365:3.4": "matto chātaṃ hanāsi maṃ. ",
  "ja365:4.1": "T' āhaṃ saraṃ dukkhaseyyaṃ ",
  "ja365:4.2": "api rajjam pi kāraye ",
  "ja365:4.3": "n' eva taṃ yācito dajjaṃ, ",
  "ja365:4.4": "tathā hi bhayatajjito. ",
  "ja365:5.1": "Yañ ca jaññā kule jātaṃ ",
  "ja365:5.2": "gabbhe tittaṃ amacchariṃ ",
  "ja365:5.3": "tena sakkhiñ ca mittañ ca ",
  "ja365:5.4": "dhīro sandhātum arahatīti. ",
  "ja365:6.1": ""
}
