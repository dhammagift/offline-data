  "ja274:0.4": "",
  "ja274:1.1": "Kāyaṃ balākā sikhinī ",
  "ja274:1.2": "corī laṃghīpitāmahā, ",
  "ja274:1.3": "oraṃ balāke āgaccha, ",
  "ja274:1.4": "caṇḍo me vāyaso sakhāti. ",
  "ja274:2.1": "Nāhaṃ balākā sikhinī, ",
  "ja274:2.2": "ahaṃ lolo 'smi vāyaso, ",
  "ja274:2.3": "akatvā vacanaṃ tuyhaṃ ",
  "ja274:2.4": "passa lūno 'smi āgatoti. ",
  "ja274:3.1": "Puna p' āpajjasī samma, ",
  "ja274:3.2": "sīlaṃ hi tava tādisaṃ, ",
  "ja274:3.3": "na hi mānusakā bhogā ",
  "ja274:3.4": "subhuñjā honti pakkhināti. ",
  "ja274:4.1": ""
}
