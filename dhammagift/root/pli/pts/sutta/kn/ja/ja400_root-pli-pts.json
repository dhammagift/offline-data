  "ja400:0.4": "",
  "ja400:1.1": "Anutīracāri bhaddan te, ",
  "ja400:1.2": "sahāya-m-anudhāva maṃ, ",
  "ja400:1.3": "mahā me gahito maccho, ",
  "ja400:1.4": "so maṃ harati vegasāti. ",
  "ja400:2.1": "Gambhīracāri bhaddan te, ",
  "ja400:2.2": "daḷhaṃ gaṇhāhi thāmasā, ",
  "ja400:2.3": "ahan taṃ uddharissāmi ",
  "ja400:2.4": "supaṇṇo uragam-m-ivāti. ",
  "ja400:3.1": "Vivādo no samuppanno, ",
  "ja400:3.2": "dabbhapuppha suṇohi me, ",
  "ja400:3.3": "samehi medhakaṃ samma, ",
  "ja400:3.4": "vivādo vūpasammatanti. ",
  "ja400:4.1": "Dhammaṭṭho 'haṃ pure āsiṃ, ",
  "ja400:4.2": "bahu atthaṃ me tīritaṃ, ",
  "ja400:4.3": "samemi medhakaṃ sammā, ",
  "ja400:4.4": "vivādo vūpasammatanti ",
  "ja400:5.1": "Anutīrācārī naṅguṭṭhaṃ, ",
  "ja400:5.2": "sīsaṃ Gambhīracārino, ",
  "ja400:5.3": "athāyaṃ majjhimo khaṇḍo ",
  "ja400:5.4": "dhammaṭṭhassa bhavissatīti ",
  "ja400:6.1": "Ciram pi bhakkho abhavissa ",
  "ja400:6.2": "sace na vivademase, ",
  "ja400:6.3": "asīsakaṃ anaṅguṭṭhaṃ ",
  "ja400:6.4": "sigālo harati rohitanti. ",
  "ja400:7.1": "Yathāpi rājā nandeyya ",
  "ja400:7.2": "rajjaṃ laddhāna khattiyo ",
  "ja400:7.3": "ev' āham ajja nandāmi ",
  "ja400:7.4": "disvā puṇṇamukhaṃ patinti ",
  "ja400:8.1": "Kathan nu thalajo santo ",
  "ja400:8.2": "udake macchaṃ parāmasi, ",
  "ja400:8.3": "puṭṭho me samma akkhāhi ",
  "ja400:8.4": "kathaṃ adhigataṃ tayāti ",
  "ja400:9.1": "Vivādena kisā honti, ",
  "ja400:9.2": "vivādena dhanakkhayā, ",
  "ja400:9.3": "jīnā uddā vivādena, ",
  "ja400:9.4": "bhuñja Māyāvi rohitanti. Evam ",
  "ja400:10.1": "evaṃ manussesu ",
  "ja400:10.2": "vivādo yattha jāyati ",
  "ja400:10.3": "dhammaṭṭhaṃ paṭi dhāvanti, ",
  "ja400:10.4": "so hi nesaṃ vināyako, ",
  "ja400:10.5": "dhanāpi tattha jīyanti ",
  "ja400:10.6": "rājakoso ca vaḍḍhatīti. Dasaṇṇakaṃ ",
  "ja400:11.1": ""
}
