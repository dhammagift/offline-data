{
  "ja514:0.1": "",
  "ja514:0.2": "",
  "ja514:0.3": "",
  "ja514:0.4": "",
  "ja514:1.1": "nu socasi anujjaṅgi, ",
  "ja514:1.2": "paṇḍu sī varavaṇṇini, ",
  "ja514:1.3": "milāyasi visālakkhi, ",
  "ja514:1.4": "mālā va parimadditāti. ",
  "ja514:2.1": "Dohaḷo me mahārāja ",
  "ja514:2.2": "supinanten' upaccagā, ",
  "ja514:2.3": "na so sulabharūpo va ",
  "ja514:2.4": "yādiso mama dohaḷoti. ",
  "ja514:3.1": "Ye keci mānusā kāmā ",
  "ja514:3.2": "idhalokasmiṃ nandane ",
  "ja514:3.3": "sabbe te pacurā mayhaṃ, ",
  "ja514:3.4": "ahan te dammi dohaḷanti. ",
  "ja514:4.1": "Luddā deva samāyantu ",
  "ja514:4.2": "ye keci vijite tava, ",
  "ja514:4.3": "etesaṃ aham akkhissaṃ ",
  "ja514:4.4": "yādiso mama dohaḷoti. ",
  "ja514:5.1": "Ime te luddakā devi ",
  "ja514:5.2": "katahatthā visāradā ",
  "ja514:5.3": "vanaññū ca migaññū ca, ",
  "ja514:5.4": "mama te cattajīvitāti ā. ",
  "ja514:6.1": "Luddaputtā nisāmetha ",
  "ja514:6.2": "yāvant' ettha samāgatā: ",
  "ja514:6.3": "chabbisāṇaṃ gajaṃ setaṃ ",
  "ja514:6.4": "addasaṃ supinen' ahaṃ, ",
  "ja514:6.5": "tassa dantehi me attho, ",
  "ja514:6.6": "alābhe n' atthi jīvitanti. ",
  "ja514:7.1": "Na no pitunnaṃ na pitāmahānaṃ ",
  "ja514:7.2": "dittho suto kuñjaro chabbisāṇo ",
  "ja514:7.3": "",
  "ja514:7.4": "",
  "ja514:8.1": "Disā catasso vidisā catasso (vol. I p. 401) ",
  "ja514:8.2": "uddhaṃ adho, dasa disā imāyo, ",
  "ja514:8.3": "katamaṃ disaṃ tiṭṭhati nāgarājā ",
  "ja514:8.4": "yam addasā supine chabbisāṇanti. ",
  "ja514:9.1": "Ito ujuṃ uttariyaṃ disāyaṃ ",
  "ja514:9.2": "atikamma so satta girī brahante ",
  "ja514:9.3": "Suvaṇṇapasso nāma girī uḷāro ",
  "ja514:9.4": "supupphito kimpurisānuciṇṇo. ",
  "ja514:10.1": "Āruyha selaṃ bhavanaṃ kinnarānaṃ ",
  "ja514:10.2": "olokaya pabbatapādamūlaṃ, ",
  "ja514:10.3": "Tath' ",
  "ja514:10.4": "acchatī ",
  "ja514:11.1": "kuñjaro chabbisāṇo ",
  "ja514:11.2": "sabbaseto duppasaho parehi, ",
  "ja514:11.3": "rakkhanti naṃ aṭṭhasahassanāgā ",
  "ja514:11.4": "īsādantā vātajavappahārino. ",
  "ja514:12.1": "Tiṭṭhanti te bhimūla passasantā, ",
  "ja514:12.2": "kuppanti vātassa pi eritassa, ",
  "ja514:12.3": "manussabhūtaṃ pana tattha disvā ",
  "ja514:12.4": "bhasmaṃ kareyyaṃ, nāssa rajo pi tassāti. ",
  "ja514:13.1": "Bahū h' ime rājakulamhi santi ",
  "ja514:13.2": "pilandhanā jātarūpassa devi ",
  "ja514:13.3": "",
  "ja514:13.4": "",
  "ja514:13.5": "",
  "ja514:13.6": "",
  "ja514:14.1": "Sā issitā dukkhitā c' asmi ludda, ",
  "ja514:14.2": "uddhañ ca sussāmi anussarantī, ",
  "ja514:14.3": "karohi me luddaka etam atthaṃ, ",
  "ja514:14.4": "dassāmi te gāmavarāni pañcāti. ",
  "ja514:15.1": "Katth' acchatī kattha-m-upeti ṭhānaṃ, ",
  "ja514:15.2": "vīthi 'ssa kā nahānagatassa hoti, ",
  "ja514:15.3": "kathaṃ hi so nahāyati nāgarājā, ",
  "ja514:15.4": "kathaṃ vijānemu gatiṃ gajassāti ā. ",
  "ja514:16.1": "Tatth' eva sā pokkharaṇī adūre ",
  "ja514:16.2": "rammā sutitthā ca mahodikā ca ",
  "ja514:16.3": "sampupphitā bhamaragaṇānuciṇṇā, ",
  "ja514:16.4": "ettha hi so nahāyati nāgarājā. ",
  "ja514:17.1": "Sīsaṃ nahāto uppalamālabhārī ",
  "ja514:17.2": "sabbaseto puṇḍarīkattacaṃgī ",
  "ja514:17.3": "āmmodamāno gacchatī [san] niketaṃ ",
  "ja514:17.4": "purakkhatvā mahesiṃ sabbabhaddanti. ",
  "ja514:18.1": "Tatth' eva so uggahetvāna vākyaṃ ",
  "ja514:18.2": "ādāya tūṇiñ ca dhanuñ ca luddo ",
  "ja514:18.3": "vitureyyati satta girī brahante ",
  "ja514:18.4": "Suvaṇṇapassaṃ nāma giriṃ uḷāraṃ. ",
  "ja514:19.1": "Āruyha selaṃ bhavanaṃ kinnarānaṃ ",
  "ja514:19.2": "olokayī pabbatapādamūlaṃ. ",
  "ja514:19.3": "tatth' addasā meghasamānavaṇṇaṃ ",
  "ja514:19.4": "nigrodharājaṃ aṭṭhasahassapādaṃ. ",
  "ja514:20.1": "Tatth' addasā kuñjaraṃ chabbisāṇaṃ ",
  "ja514:20.2": "sabbasetaṃ duppasahaṃ parehi, ",
  "ja514:20.3": "rakkhanti naṃ aṭṭhasahassanāga ",
  "ja514:20.4": "isādantā vātajavappahārino. ",
  "ja514:21.1": "Tatth' addasā pokkharaṇiṃ adūre ",
  "ja514:21.2": "rammaṃ sutitthañ ca mahodikañ ca ",
  "ja514:21.3": "sampupphitaṃ bhamaragaṇānuciṇṇaṃ ",
  "ja514:21.4": "yattha hi so nahāyati nāgarājā. ",
  "ja514:22.1": "Disvāna nāgassa gatiṃ ṭhitiñ ca ",
  "ja514:22.2": "vīthi 'ssa yā nahānagatassa hoti ",
  "ja514:22.3": "opātam āgañchi anariyarūpo ",
  "ja514:22.4": "payojito cittavasānugāyāti. ",
  "ja514:23.1": "Katvāna kāsuṃ phalakehi chādayi ",
  "ja514:23.2": "attānam odhāya dhanuñ ca luddo, ",
  "ja514:23.3": "passāgataṃ puthusallena nāgaṃ ",
  "ja514:23.4": "samappayī dukkatakammakārīti vatvā ",
  "ja514:24.1": "Viddho ca nāgo koñcam anādi ghoraṃ, ",
  "ja514:24.2": "sabbe va nāgā ninnaduṃ ghorarūpaṃ. ",
  "ja514:24.3": "tiṇañ ca kaṭṭhañ ca cuṇṇaṃ karontā ",
  "ja514:24.4": "dhāviṃsu te aṭṭhadisā samantato. ",
  "ja514:25.1": "Vadhissam etanti parāmasanto ",
  "ja514:25.2": "kāsāvam addakkhi dhajaṃ isīnaṃ, ",
  "ja514:25.3": "dukkhena phuṭṭass' udapādi saññā: ",
  "ja514:25.4": "arahaddhajo sabbhi avajjharūpoti ā. ",
  "ja514:26.1": "Anikkasāvo kāsāvaṃ ",
  "ja514:26.2": "yo vatthaṃ paridahessati ",
  "ja514:26.3": "apeto damasaccena ",
  "ja514:26.4": "na so kāsāvam arahati. ",
  "ja514:27.1": "Yo ca vantakāsāv' assa ",
  "ja514:27.2": "sīlesu susamāhito ",
  "ja514:27.3": "upeto damasaccena ",
  "ja514:27.4": "sa ve kāsāvam arahahīti. ",
  "ja514:28.1": "Samappito puthusallena nāgo ",
  "ja514:28.2": "aduṭṭhacitto luddakaṃ ajjhabhāsi: ",
  "ja514:28.3": "kimatthiyaṃ kissa vā samma hetu ",
  "ja514:28.4": "mamaṃ vadhī kassa vāyaṃ payogoti. ",
  "ja514:29.1": "Kāsissa rañño mahesī bhadante, ",
  "ja514:29.2": "sā pūjitā rājakule Subhaddā [sā] ",
  "ja514:29.3": "taṃ addasā sā ca mamaṃ asaṃsi, ",
  "ja514:29.4": "dantehi atthoti ca maṃ avocāti. ",
  "ja514:30.1": "Bahū hi me dantayugā uḷārā ",
  "ja514:30.2": "ye me pitunnam pi pitāmahānaṃ, ",
  "ja514:30.3": "jānāti sā kodhanā rājaputtī, ",
  "ja514:30.4": "vadhatthikā veram akāsi bālā. ",
  "ja514:31.1": "Uṭṭhehi tvaṃ ludda, khuraṃ gahetvā ",
  "ja514:31.2": "dante ime chinda purā marāmi, ",
  "ja514:31.3": "vajjāsi taṃ kodhanaṃ rājaputtiṃ: ",
  "ja514:31.4": "nāgo hato, handa im' assa dantāti. ",
  "ja514:32.1": "Uṭṭhāya so luddo khuraṃ gahetvā ",
  "ja514:32.2": "chetvāna dantāni gajuttamassa ",
  "ja514:32.3": "vaggū subhe appaṭime pathavyā ",
  "ja514:32.4": "ādāya pakkāmi tato hi khippanti āha ",
  "ja514:33.1": "Bhayadditā nāgavadhena aṭṭā ",
  "ja514:33.2": "ye te nāgā aṭṭha disā vidhāvuṃ ",
  "ja514:33.3": "adisva posaṃ gajapaccamittaṃ ",
  "ja514:33.4": "paccāgamuṃ yena so nāgarājāti āha. ",
  "ja514:34.1": "Te tattha kanditvā roditva nāgā ",
  "ja514:34.2": "sīse sake paṃsukaṃ okiritvā ",
  "ja514:34.3": "agamaṃsu te sabbe sakaṃ niketaṃ ",
  "ja514:34.4": "purakkhatvā mahesiṃ sabbabhaddanti ā. ",
  "ja514:35.1": "Ādāya dantāni gajuttamassa ",
  "ja514:35.2": "vaggū subhe appaṭime pathavyā ",
  "ja514:35.3": "suvaṇṇarājāhi samantamodare ",
  "ja514:35.4": "so luddako Kāsipuraṃ upāgami, ",
  "ja514:35.5": "upanesi so rājakaññāya dante: ",
  "ja514:35.6": "nāgo hato, handa im' assa dantāti. ",
  "ja514:36.1": "Disvāna dantāni gajuttamassa ",
  "ja514:36.2": "bhattu-ppiyassa purimāya jātiyā ",
  "ja514:36.3": "tatth' eva tassā hadayaṃ aphāli, ",
  "ja514:36.4": "ten' eva sā kālam akāsi bālāti āha. ",
  "ja514:37.1": "Sambodhipatto va mahānubhāvo ",
  "ja514:37.2": "sitaṃ akāsi parisāya majjhe, ",
  "ja514:37.3": "pucchiṃsu bhikkhū suvimuttacittā, ",
  "ja514:37.4": "nākāraṇe pātukaronti buddhā. ",
  "ja514:38.1": "Yam addasātha dahariṃ kumāriṃ ",
  "ja514:38.2": "kāsāya vatthaṃ anagāriyañ carantiṃ ",
  "ja514:38.3": "sā kho tadā rājakaññā ahosi, ",
  "ja514:38.4": "ahaṃ tadā nāgarājā ahosiṃ. ",
  "ja514:39.1": "Ādāya dantāni gajuttamassa ",
  "ja514:39.2": "vaggū subhe appaṭime pathavyā ",
  "ja514:39.3": "",
  "ja514:39.4": "",
  "ja514:40.1": "Anāvasūraṃ cirarattasaṃsitaṃ ",
  "ja514:40.2": "uccāvacaṃ caritam idaṃ purāṇaṃ ",
  "ja514:40.3": "vītaddaro vītasoko visallo ",
  "ja514:40.4": "sayaṃ abhiññāya abhāsi Buddho. ",
  "ja514:41.1": "Ahaṃ vo tena kālena ",
  "ja514:41.2": "ahosiṃ tattha bhikkhavo ",
  "ja514:41.3": "nāgarājā tadāhosiṃ, ",
  "ja514:41.4": "evaṃ dhāretha jātakanti Rajjañ ca paṭipann' asmā adhipacca. ",
  "ja514:42.1": ""
}
