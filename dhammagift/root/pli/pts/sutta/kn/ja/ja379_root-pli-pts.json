  "ja379:0.3": "",
  "ja379:0.4": "",
  "ja379:1.1": "Kākolā kākasaṃghā ca ",
  "ja379:1.2": "mayañ ca patataṃ varā ",
  "ja379:1.3": "sabbe va sadisā homa ",
  "ja379:1.4": "imaṃ āgamma pabbataṃ. ",
  "ja379:2.1": "Idha sīhā ca vyagghā ca ",
  "ja379:2.2": "sigālā ca migādhamā ",
  "ja379:2.3": "sabbe va sadisā honti, ",
  "ja379:2.4": "ayaṃ ko nāma pabbatoti. ",
  "ja379:3.1": "Imaṃ Nerūti jānanti ",
  "ja379:3.2": "manussā pabbatuttamaṃ, ",
  "ja379:3.3": "idha vaṇṇena sampannā ",
  "ja379:3.4": "vasanti sabbapāṇinoti. ",
  "ja379:4.1": "Amānanā yattha siyā ",
  "ja379:4.2": "santāna vā vimānanā ",
  "ja379:4.3": "hīnasammānanā vāpi ",
  "ja379:4.4": "na tattha vasa divase. ",
  "ja379:5.1": "Yattha alaso dakkho ca ",
  "ja379:5.2": "sūro bhīru ca pūjiyā ",
  "ja379:5.3": "na tattha santo nivasanti ",
  "ja379:5.4": "avisesakare nage. ",
  "ja379:6.1": "Nāyaṃ Neru vibhajati ",
  "ja379:6.2": "hīnamukkaṭṭhamajjhime, ",
  "ja379:6.3": "avisesakaro Neru, ",
  "ja379:6.4": "handa Neruṃ jahāmaseti. ",
  "ja379:7.1": ""
}
