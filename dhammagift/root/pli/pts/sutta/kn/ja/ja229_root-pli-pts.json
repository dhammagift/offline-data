  "ja229:1.1": "Gajaggameghehi hayaggamālihi ",
  "ja229:1.2": "rathūmijātehi sarābhivassehi ",
  "ja229:1.3": "tharuggahāvaṭṭadaḷhappahārihi ",
  "ja229:1.4": "parivāritā Takkasilā samantato. ",
  "ja229:2.1": "Abhidhāvathā ca ",
  "ja229:2.2": "patathā ca vividhavinaditā ca dantihi, ",
  "ja229:2.3": "vattat' ajja tumulo ghoso yathā ",
  "ja229:2.4": "vijjutā jaladharassa gajjatoti. ",
  "ja229:3.1": ""
}
