  "ja328:1.1": "vijjati bhotī, ",
  "ja328:1.2": "tehi kim me bhavissati, ",
  "ja328:1.3": "tasmā etaṃ na socāmi ",
  "ja328:1.4": "piyaṃ Sammillabhāsiniṃ. ",
  "ja328:2.1": "Tan tañ ce anusoceyya ",
  "ja328:2.2": "yaṃ yaṃ tassa na vijjati ",
  "ja328:2.3": "attānam anusoceyya ",
  "ja328:2.4": "sadā maccuvasaṃ gataṃ. ",
  "ja328:3.1": "Na h' eva ṭhitaṃ nāsīnaṃ ",
  "ja328:3.2": "na sayānaṃ na p' addhaguṃ ",
  "ja328:3.3": "yāva pāti nimisati ",
  "ja328:3.4": "tatrāpi sarati-bbayo. ",
  "ja328:4.1": "Tatth' attani vata-ppaddhe ",
  "ja328:4.2": "vinābhāve asaṃsaye ",
  "ja328:4.3": "sesaṃ sesaṃ dayitabbaṃ ",
  "ja328:4.4": "vītaṃ ananusocitanti. ",
  "ja328:5.1": ""
}
