  "ja393:1.1": "Susukhaṃ vata jīvanti ",
  "ja393:1.2": "ye janā vighāsādino, ",
  "ja393:1.3": "diṭṭhe va dhamme pāsaṃsā, ",
  "ja393:1.4": "samparāye ca suggatīti. ",
  "ja393:2.1": "Suvassa bhāsamānassa ",
  "ja393:2.2": "na nisāmetha paṇḍitā, ",
  "ja393:2.3": "idaṃ suṇotha sodariyā: ",
  "ja393:2.4": "amhe vāyaṃ pasaṃsatīti. ",
  "ja393:3.1": "Nāhaṃ tumhe pasaṃsāmi, ",
  "ja393:3.2": "kuṇapādā suṇotha me: ",
  "ja393:3.3": "ucchiṭṭhabhojino tumhe, ",
  "ja393:3.4": "na tumhe vighāsādinoti. ",
  "ja393:4.1": "Sattavassā pabbajitvā ",
  "ja393:4.2": "Mejjhāraññe sikhaṇḍino ",
  "ja393:4.3": "vighāsen' eva yāpentā ",
  "ja393:4.4": "mayañ ce bhoto gārayhā ",
  "ja393:4.5": "ke nu bhoto pasaṃsiyāti. ",
  "ja393:5.1": "Tumhe sīhānaṃ vyagghānaṃ ",
  "ja393:5.2": "vāḷānañ cāvasiṭṭhakaṃ ",
  "ja393:5.3": "ucchiṭṭhen' eva yāpentā ",
  "ja393:5.4": "maññivho vighāsādinoti. ",
  "ja393:6.1": "Ye brāhmaṇassa samaṇassa ",
  "ja393:6.2": "aññass' eva vanibbino ",
  "ja393:6.3": "datvāna sesaṃ bhuñjanti ",
  "ja393:6.4": "te janā vighāsādinoti. ",
  "ja393:7.1": ""
}
