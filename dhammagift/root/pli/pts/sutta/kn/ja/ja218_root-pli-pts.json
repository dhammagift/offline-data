  "ja218:0.4": "",
  "ja218:1.1": "Saṭhassa sāṭheyyam idaṃ sucintitaṃ, ",
  "ja218:1.2": "paccoḍḍitaṃ paṭikūṭassa kūṭaṃ: ",
  "ja218:1.3": "phālañ ce adeyyuṃ mūsikā ",
  "ja218:1.4": "kasmā kumāraṃ kulalā no hareyyuṃ. ",
  "ja218:2.1": "Kūṭassa hi santi kūṭakūṭā, ",
  "ja218:2.2": "bhavati cāpi nikatino nikatyā, ",
  "ja218:2.3": "dehi puttanaṭṭha phālanaṭṭhassa phālaṃ, ",
  "ja218:2.4": "mā te puttam ahāsi phālanaṭṭhoti. ",
  "ja218:3.1": ""
}
