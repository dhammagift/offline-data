  "ja370:1.1": "Haṃso palāsam avaca: ",
  "ja370:1.2": "nigrodho samma jāyati, ",
  "ja370:1.3": "aṃkasmiṃ te nisinno va ",
  "ja370:1.4": "so te mammāni checchatīti. ",
  "ja370:2.1": "Vaḍḍhatām eva nigrodho, ",
  "ja370:2.2": "patiṭṭh' assa bhavām' ahaṃ ",
  "ja370:2.3": "yathā pitā vā mātā vā, ",
  "ja370:2.4": "evam eso bhavissatīti. ",
  "ja370:3.1": "Yaṃ tvaṃ aṃkasmiṃ vaḍḍhesi ",
  "ja370:3.2": "khīrarukkhaṃ bhayānakaṃ ",
  "ja370:3.3": "āmanta kho taṃ gacchāma ",
  "ja370:3.4": "vaḍḍhi-m-assa na ruccatīti. ",
  "ja370:4.1": "Idāni kho maṃ bhāyati ",
  "ja370:4.2": "Mahāneru-nidassanaṃ, ",
  "ja370:4.3": "haṃsassa anabhiññāya ",
  "ja370:4.4": "mahā me bhayam āgatanti. ",
  "ja370:5.1": "Na tassa vaḍḍhi kusalappasatthā ",
  "ja370:5.2": "yo vaḍḍhamāno ghasate patiṭṭhaṃ, ",
  "ja370:5.3": "tass' ūparodhaṃ parisaṃkamāno ",
  "ja370:5.4": "patārayī mūlavadhāya dhīroti ",
  "ja370:6.1": "",
  "ja370:6.2": ""
}
