  "ja539:1.1": "Ko 'yaṃ majjhe samuddasmiṃ ",
  "ja539:1.2": "apassan tīram āyuhe, ",
  "ja539:1.3": "kaṃ tvaṃ atthavasaṃ ñatvā ",
  "ja539:1.4": "evaṃ vāyāmase bhusanti. ",
  "ja539:2.1": "Nisamma vattaṃ lokassa ",
  "ja539:2.2": "vāyāmassa ca devate ",
  "ja539:2.3": "tasmā majjhe samuddasmiṃ ",
  "ja539:2.4": "apassan tīram āyuheti. ",
  "ja539:3.1": "Gambhīre appameyyasmiṃ ",
  "ja539:3.2": "tīraṃ yassa na dissati ",
  "ja539:3.3": "mogho te purisavāyāmo ",
  "ja539:3.4": "appatvā va marissasīti. ",
  "ja539:4.1": "Anaṇo ñātinaṃ hoti ",
  "ja539:4.2": "devānaṃ pituno ca so ",
  "ja539:4.3": "karaṃ purisakiccāni ",
  "ja539:4.4": "na ca pacchānutappatīti. ",
  "ja539:5.1": "Apāraṇeyyaṃ yaṃ kammaṃ ",
  "ja539:5.2": "aphalaṃ kilamathuddayaṃ ",
  "ja539:5.3": "tattha ko vāyāmen' attho ",
  "ja539:5.4": "maccu yassābhinippatanti. ",
  "ja539:6.1": "Apāraṇeyyaṃ accantaṃ ",
  "ja539:6.2": "yo viditvāna devate ",
  "ja539:6.3": "na rakkhe attano pāṇaṃ ",
  "ja539:6.4": "jaññā so yadi hāpaye. ",
  "ja539:7.1": "Adhippāyaphalaṃ eke ",
  "ja539:7.2": "asmiṃ lokasmi devate ",
  "ja539:7.3": "payojayanti kammāni, ",
  "ja539:7.4": "tāni ijjhanti vā na vā. ",
  "ja539:8.1": "Sandiṭṭhikaṃ kammaphalaṃ ",
  "ja539:8.2": "nanu passasi devate ",
  "ja539:8.3": "sannā aññe tarām' ahaṃ ",
  "ja539:8.4": "tañ ca passāmi santike. ",
  "ja539:9.1": "So ahaṃ vāyamissāmi ",
  "ja539:9.2": "yathāsattiṃ yathābalaṃ ",
  "ja539:9.3": "gacchaṃ pāraṃ samuddassa ",
  "ja539:9.4": "kāsaṃ purisakāriyanti. ",
  "ja539:10.1": "Yo vaṃ evaṃgate oghe ",
  "ja539:10.2": "appameyye mahaṇṇave ",
  "ja539:10.3": "dhammavāyāmasampanno ",
  "ja539:10.4": "kammanā nāvasīdasi ",
  "ja539:10.5": "so tvaṃ tatth' eva gacchāhi ",
  "ja539:10.6": "yattha te nirato manoti. ",
  "ja539:11.1": "Suriyuggamane nidhi, ",
  "ja539:11.2": "atho okkamane nidhi, ",
  "ja539:11.3": "anto nidhi bahi nidhi, ",
  "ja539:11.4": "na anto na bahi nidhi. ",
  "ja539:12.1": "Ārohaṇe mahānidhi, ",
  "ja539:12.2": "atho orohaṇe nidhi, ",
  "ja539:12.3": "caturo ca mahāsālā ",
  "ja539:12.4": "samantā yojane nidhi. ",
  "ja539:13.1": "Dantaggesu mahānidhi ",
  "ja539:13.2": "vālaggesu ca kebuke ",
  "ja539:13.3": "rukkhaggesu mahānidhi, ",
  "ja539:13.4": "soḷas' ete mahānidhī, ",
  "ja539:13.5": "sahassatthāmo pallaṃko ",
  "ja539:13.6": "Sīvalārādhanena cāti Āsiṃseth' ",
  "ja539:14.1": "eva puriso, ",
  "ja539:14.2": "na nibbindeyya paṇḍito, (IV 269|21) ",
  "ja539:14.3": "passāmi vo 'haṃ attānaṃ, ",
  "ja539:14.4": "yathā icchiṃ tathā ahu. ",
  "ja539:15.1": "Āsiṃseth' eva puriso, ",
  "ja539:15.2": "na nibbindeyya paṇḍito, ",
  "ja539:15.3": "passāmi vo 'haṃ attānaṃ ",
  "ja539:15.4": "udakā thalam ubbhataṃ. ",
  "ja539:16.1": "Vāyameth' eva puriso, ",
  "ja539:16.2": "na nibbindeyya paṇḍito, ",
  "ja539:16.3": "passāmi vo 'haṃ attānaṃ, ",
  "ja539:16.4": "yathā icchiṃ tathā ahu. ",
  "ja539:17.1": "Vāyameth' eva puriso, ",
  "ja539:17.2": "na nibbindeyya paṇḍito, ",
  "ja539:17.3": "passāmi vo 'haṃ attānaṃ ",
  "ja539:17.4": "udakā thalam ubbhataṃ. ",
  "ja539:18.1": "Dukkhūpanīto pi naro sapañño ",
  "ja539:18.2": "āsaṃ na chindeyya sukhāgamāya, ",
  "ja539:18.3": "bahū hi phassā ahitā hitā ca, ",
  "ja539:18.4": "avitakkitā maccum upabbajanti. ",
  "ja539:19.1": "Acintitam pi bhavati, ",
  "ja539:19.2": "cintitam pi vinassati, ",
  "ja539:19.3": "na hi cintāmayā bhogā ",
  "ja539:19.4": "itthiyā purisassa vāti. ",
  "ja539:20.1": "Apurāṇaṃ vata bho rājā ",
  "ja539:20.2": "sabbabhummo disampati ",
  "ja539:20.3": "nājja nacce nisāmeti ",
  "ja539:20.4": "na gīte kurute mano. ",
  "ja539:21.1": "Na mige na pi uyyāne ",
  "ja539:21.2": "na pi haṃse udikkhati, ",
  "ja539:21.3": "mūgo va tuṇhīm āsīno ",
  "ja539:21.4": "na attham anusāsatīti. ",
  "ja539:22.1": "Sukhakāmā rahosīlā ",
  "ja539:22.2": "vadhabandhā upāratā ",
  "ja539:22.3": "kesan nu ajja ārāme ",
  "ja539:22.4": "daharā vuddhā ca acchare. ",
  "ja539:23.1": "Atikkantavanathā dhīrā ",
  "ja539:23.2": "namo tesaṃ mahesinaṃ ",
  "ja539:23.3": "ye ussukkamhi lokamhi ",
  "ja539:23.4": "viharanti anussukā. ",
  "ja539:24.1": "Te chetvā maccuno jālaṃ ",
  "ja539:24.2": "tantaṃ māyāvino daḷhaṃ ",
  "ja539:24.3": "chinnālayattā gacchanti, ",
  "ja539:24.4": "ko tesaṃ gatim ",
  "ja539:25.1": "",
  "ja539:25.2": "āpayeti. ",
  "ja539:25.3": "",
  "ja539:25.4": "",
  "ja539:26.1": "Kadāhaṃ Mithilaṃ phītaṃ ",
  "ja539:26.2": "visālaṃ sabbatopabhaṃ ",
  "ja539:26.3": "pahāya pabbajissāmi, ",
  "ja539:26.4": "taṃ kadāssu bhavissati. Kadāhaṃ Mithilaṃ phītaṃ vibhattaṃ bhāgaso mitaṃ pahāya pabbajissāmi, taṃ kadāssu bhavissati. ",
