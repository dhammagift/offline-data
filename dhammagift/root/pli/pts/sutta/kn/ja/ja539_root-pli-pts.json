  "ja539:86.4": "sabbālaṃkārabhūsitā ",
  "ja539:87.1": "Ārūḷhā gāmaṇīyehi ",
  "ja539:87.2": "cāpahatthehi vammihi ",
  "ja539:87.3": "yantaṃ maṃ nānuyissanti, ",
  "ja539:87.4": "taṃ kadāssu bhavissati. ",
  "ja539:88.1": "Kadāssu maṃ sovaṇṇarathā ",
  "ja539:88.2": "sannaddhā ussitaddhajā ",
  "ja539:88.3": "dīpā atho pi veyyagghā ",
  "ja539:88.4": "sabbālaṃkārabhūsitā ",
  "ja539:89.1": "Ārūḷhā gāmaṇīyehi ",
  "ja539:89.2": "cāpahatthehi vammihi ",
  "ja539:89.3": "yantaṃ maṃ nānuyissanti, ",
  "ja539:89.4": "taṃ kadāssu bhavissati. ",
  "ja539:90.1": "Kadāssu maṃ sajjhurathā ",
  "ja539:90.2": "sannaddhā ussitaddhajā ",
  "ja539:90.3": "dīpā atho pi veyyagghā ",
  "ja539:90.4": "sabbālaṃkārabhūsitā ",
