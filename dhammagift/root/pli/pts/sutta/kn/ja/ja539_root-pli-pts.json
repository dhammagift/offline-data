  "ja539:103.4": "",
  "ja539:104.1": "Kadāssu maṃ hatthārūhā ",
  "ja539:104.2": "sabbālaṃkārabhūsitā ",
  "ja539:104.3": "nīlavammadharā sūrā ",
  "ja539:104.4": "tomaraṃkusapāṇino ",
  "ja539:104.5": "yantaṃ maṃ nānuyissanti, ",
  "ja539:104.6": "taṃ kadāssu bhavissati. ",
  "ja539:105.1": "Kadāssu maṃ assārūhā ",
  "ja539:105.2": "sabbālaṃkārabhūsitā ",
  "ja539:105.3": "nīlavammadharā sūrā ",
  "ja539:105.4": "illiyācāpadhārino ",
  "ja539:105.5": "yantaṃ maṃ nānuyissanti, ",
  "ja539:105.6": "taṃ ",
  "ja539:106.1": "kadāssu ",
  "ja539:106.2": "",
  "ja539:106.3": "",
  "ja539:106.4": "",
  "ja539:106.5": "",
  "ja539:106.6": "bhavissati. ",
  "ja539:107.1": "Kadāssu maṃ dhanuggahā ",
  "ja539:107.2": "sabbālaṃkārabhūsitā ",
  "ja539:107.3": "nīlavammadharā sūrā ",
  "ja539:107.4": "cāpahatthā kalāpino ",
  "ja539:107.5": "etc. ",
  "ja539:107.6": "",
  "ja539:108.1": "Kadāssu maṃ rājaputtā ",
  "ja539:108.2": "sabbālaṃkārabhūsitā ",
  "ja539:108.3": "cittavammadharā sūrā ",
  "ja539:108.4": "kañcanāveḷadhārino ",
  "ja539:108.5": "etc. ",
  "ja539:108.6": "",
  "ja539:109.1": "Kadāssu maṃ ariyagaṇā ",
  "ja539:109.2": "vatthavantā alaṃkatā ",
  "ja539:109.3": "haricandanalittaṅgā ",
  "ja539:109.4": "Kāsi-kuttamadhārino ",
  "ja539:109.5": "",
  "ja539:109.6": "",
  "ja539:110.1": "",
  "ja539:110.2": "",
  "ja539:110.3": "",
  "ja539:110.4": "",
  "ja539:110.5": "",
  "ja539:110.6": "etc. ",
  "ja539:111.1": "Kadāssu maṃ sattasatā bhariyā ",
  "ja539:111.2": "sabbālaṃkārabhūsitā ",
  "ja539:111.3": "yantaṃ maṃ nānuyissanti, ",
  "ja539:111.4": "taṃ kadāssu bhavissati. ",
  "ja539:112.1": "Kadā sattasatā bhariyā ",
  "ja539:112.2": "susaññā tanumajjhimā ",
  "ja539:112.3": "yantaṃ maṃ nānuyissanti, ",
  "ja539:112.4": "taṃ kadāssu bhavissati. ",
  "ja539:113.1": "Kadā sattasatā bhariyā ",
  "ja539:113.2": "assavā piyabhāṇinī ",
  "ja539:113.3": "etc. ",
  "ja539:113.4": "Kadā ",
  "ja539:114.1": "pattaṃ gahetvāna ",
  "ja539:114.2": "muṇḍo saṃghāṭipāruto ",
  "ja539:114.3": "piṇḍikāya carissāmi, ",
  "ja539:114.4": "taṃ kadāssu bhavissati. ",
  "ja539:115.1": "Kadāhaṃ paṃsukūlānaṃ ",
  "ja539:115.2": "ujjhitānaṃ mahāpathe ",
  "ja539:115.3": "saṃghāṭiṃ dhārayissāmi, ",
  "ja539:115.4": "taṃ kadāssu bhavissati. ",
  "ja539:116.1": "Kadā sattāhasammeghe ",
  "ja539:116.2": "ovaṭṭe allacīvaro ",
  "ja539:116.3": "piṇḍikāya carissāmi, ",
  "ja539:116.4": "taṃ kadāssu bhavissati. ",
  "ja539:117.1": "Kadāhaṃ sabbāhaṃ ṭhānaṃ ",
  "ja539:117.2": "rukkhārukkhaṃ vanāvanaṃ ",
  "ja539:117.3": "anapekho viharissāmi, ",
  "ja539:117.4": "taṃ kadāssu bhavissati. ",
  "ja539:118.1": "Kadāhaṃ giriduggesu ",
  "ja539:118.2": "pahīnabhayabheravo ",
  "ja539:118.3": "adutiyo viharissāmi, ",
  "ja539:118.4": "taṃ kadāssu bhavissati. ",
  "ja539:119.1": "Kadā vīṇaṃ virujako ",
  "ja539:119.2": "sattatantimanoramaṃ ",
  "ja539:119.3": "cittaṃ ujuṃ karissāmi, ",
  "ja539:119.4": "taṃ kadāssu bhavissati. ",
  "ja539:120.1": "Kadāhaṃ rathakāro va ",
  "ja539:120.2": "parikantaṃ upāhanaṃ ",
  "ja539:120.3": "kāmasaṃyojane checchaṃ ",
  "ja539:120.4": "ye dibbe ye ca mānuseti. ",
  "ja539:121.1": "Tā ca sattasatā bhariyā ",
  "ja539:121.2": "sabbālaṃkārabhūsitā ",
  "ja539:121.3": "bāhā paggayha pakkanduṃ: ",
  "ja539:121.4": "kasmā no vijahissasi. ",
  "ja539:122.1": "Tā ca sattasatā bhariyā ",
  "ja539:122.2": "susaññā tanumajjhimā ",
  "ja539:122.3": "bāhā paggayha pakkanduṃ: ",
  "ja539:122.4": "kasmā no vijahissasi. ",
  "ja539:123.1": "Tā ca sattasatā bhariyā ",
  "ja539:123.2": "assavā piyabhāṇinī ",
  "ja539:123.3": "etc. ",
  "ja539:123.4": "",
  "ja539:124.1": "Tā ca sattasatā bhariyā ",
  "ja539:124.2": "sabbālaṃkārabhūsitā ",
  "ja539:124.3": "hitvā sampaddavī rājā ",
  "ja539:124.4": "pabbajjāya purakkhato. ",
  "ja539:125.1": "Tā ca sattasatā bhariyā ",
  "ja539:125.2": "susaññā tanumajjhimā ",
  "ja539:125.3": "hitvā sampaddavī rājā ",
  "ja539:125.4": "pabbajjāya purakkhato. ",
  "ja539:126.1": "Tā ca sattasatā bhariyā ",
  "ja539:126.2": "assavā piyabhāṇinī ",
  "ja539:126.3": "hitvā sampaddavī rājā ",
  "ja539:126.4": "pabbajjāya purakkhatoti. ",
  "ja539:127.1": "Hitvā sataphalaṃ kaṃsaṃ ",
  "ja539:127.2": "sovaṇṇaṃ satarājikaṃ ",
  "ja539:127.3": "aggahi mattikāpattaṃ ",
  "ja539:127.4": "taṃ dutiyābhisecanaṃ. ",
  "ja539:128.1": "Bhiṃsā aggisamājālā, ",
  "ja539:128.2": "kosā ḍayhanti bhāgaso ",
  "ja539:128.3": "rajataṃ jātarūpañ ca ",
  "ja539:128.4": "muttā veluriyā bahū. ",
  "ja539:129.1": "Maṇayo saṃkhamuttā ca ",
  "ja539:129.2": "vatthikaṃ haricandanaṃ ",
  "ja539:129.3": "ajinaṃ dantabhaṇḍañ ca ",
  "ja539:129.4": "lohaṃ kālāyasaṃ bahuṃ, ",
  "ja539:129.5": "ehi rāja nivattassu, ",
  "ja539:129.6": "mā te taṃ vinasā dhananti. ",
  "ja539:130.1": "Susukhaṃ vata jīvāma ",
  "ja539:130.2": "yesaṃ no n' atthi kiñcanaṃ, ",
  "ja539:130.3": "(Dhp. v. 200. Mahābh. 12, 9917 529.6641. Bibl. Indica vol. 2, p. 3, p. 128) Mithilāya ḍayhamānāya ",
  "ja539:130.4": "na me kiñci aḍayhathāti. ",
  "ja539:131.1": "Aṭaviyo samuppannā, ",
  "ja539:131.2": "raṭṭhaṃ viddhaṃsayanti taṃ, ",
  "ja539:131.3": "ehi rāja nivattassu, ",
  "ja539:131.4": "mā raṭṭhaṃ vinasā idanti. ",
  "ja539:132.1": "Susukhaṃ vata jīvāma ",
  "ja539:132.2": "yesan no n' atthi kiñcanaṃ, ",
  "ja539:132.3": "raṭṭhe vilumpamānamhi ",
  "ja539:132.4": "na me kiñci ajīratha. ",
  "ja539:133.1": "Susukhaṃ vata jīvāma ",
  "ja539:133.2": "yesan no n' atthi kiñcanaṃ, ",
  "ja539:133.3": "pītibhakkhā bhavissāma ",
  "ja539:133.4": "devā Ābhassarā yathāti. ",
  "ja539:134.1": "Kimh' eso mahato ghoso, ",
  "ja539:134.2": "kā nu gāme va kīḷiyā, ",
  "ja539:134.3": "samaṇaṃ ñeva pucchāma: ",
  "ja539:134.4": "katth' eso abhisaṭo janoti. ",
  "ja539:135.1": "Mamaṃ ohāya gacchantaṃ ",
  "ja539:135.2": "etth' eso abhisaṭo jano ",
  "ja539:135.3": "sīmātikkamanaṃ yantaṃ ",
  "ja539:135.4": "munimonassa pattiyā ",
  "ja539:135.5": "missaṃ nandīhi gacchantaṃ ",
  "ja539:135.6": "kiṃ jānam anupucchasīti. ",
  "ja539:136.1": "Māssu tiṇṇo amaññittho ",
  "ja539:136.2": "sarīraṃ dhārayaṃ imaṃ, ",
  "ja539:136.3": "atīraṇeyyam idaṃ kammaṃ, ",
  "ja539:136.4": "bahū hi paripanthayoti. ",
  "ja539:137.1": "Ko nu me paripanth' assa ",
  "ja539:137.2": "mama evaṃvihārino, ",
  "ja539:137.3": "so n' eva diṭṭhe nādiṭṭhe ",
  "ja539:137.4": "kāmānam abhipatthayeti. ",
  "ja539:138.1": "Niddā tandī vijambhikā ",
  "ja539:138.2": "aratī bhattasammado (Saṃyutta by Feer I p. 7) ",
  "ja539:138.3": "āvasanti sarīraṭṭhā, ",
  "ja539:138.4": "bahū hi paripanthayoti. ",
  "ja539:139.1": "Kalyāṇaṃ vata maṃ bhavaṃ ",
  "ja539:139.2": "brāhmaṇa-m-anusāsati, ",
  "ja539:139.3": "brāhmaṇam eva pucchāmi: ",
  "ja539:139.4": "ko nu tvam asi mārisāti. ",
  "ja539:140.1": "Nārado iti me nāmaṃ, ",
  "ja539:140.2": "Kassapo iti maṃ vidū, ",
  "ja539:140.3": "bhoto sakāse āgañchiṃ, ",
  "ja539:140.4": "sādhu sabbhi samāgamo. ",
  "ja539:141.1": "Tassa te sabbo ānando ",
  "ja539:141.2": "vihāro upavattatu, ",
  "ja539:141.3": "yad ūnaṃ taṃ paripūrehi ",
  "ja539:141.4": "khantiyā upasamena ca. ",
  "ja539:142.1": "Pasāraya sannatañ ca ",
  "ja539:142.2": "unnatañ ca pasāraya, ",
  "ja539:142.3": "kammaṃ vijjañ ca dhammañ ca ",
  "ja539:142.4": "sakkatvāna paribbajāti. ",
  "ja539:143.1": "Bahū hatthī ca asse ca ",
  "ja539:143.2": "nagare janapadāni ca ",
  "ja539:143.3": "hitvā Janaka pabbajito ",
  "ja539:143.4": "kapalle ratim ajjhagā. ",
  "ja539:144.1": "Kacci nu te janapadā ",
  "ja539:144.2": "mittāmaccā ca ñātakā ",
  "ja539:144.3": "dūbhiṃ akaṃsu Janaka, ",
  "ja539:144.4": "kasmā c' etaṃ aruccathāti. ",
  "ja539:145.1": "Na Migājina jātucca ",
  "ja539:145.2": "ahaṃ kañci kudācanaṃ ",
  "ja539:145.3": "adhammena jine ñātiṃ ",
  "ja539:145.4": "na cāpi ñātayo mamanti. ",
  "ja539:146.1": "Disvāna lokavattantaṃ ",
  "ja539:146.2": "khajjantaṃ kaddamīkataṃ ",
  "ja539:146.3": "haññare bajjhare c' ettha ",
  "ja539:146.4": "yattha sanno puthujjano ",
  "ja539:146.5": "et' āhaṃ upamaṃ katvā ",
  "ja539:146.6": "bhikkhako 'smi Migājināti ",
  "ja539:147.1": "Ko nu te Bhagavā Satthā, ",
  "ja539:147.2": "kass' etaṃ vacanaṃ suciṃ, ",
  "ja539:147.3": "na hi kappaṃ vā vijjaṃ vā ",
  "ja539:147.4": "paccakkhāya rathesabha ",
  "ja539:147.5": "samaṇaṃ āhu vattantaṃ ",
  "ja539:147.6": "yathā dukkhass' atikkamoti. ",
  "ja539:148.1": "Na Migājina jātucca ",
  "ja539:148.2": "ahaṃ kañci kudācanaṃ ",
  "ja539:148.3": "samaṇaṃ brāhmaṇaṃ vāpi ",
  "ja539:148.4": "sakkatvā anupāvisinti. ",
  "ja539:149.1": "Mahatā cānubhāvena ",
  "ja539:149.2": "gacchanto siriyā jalaṃ ",
  "ja539:149.3": "gīyamānesu gītesu ",
  "ja539:149.4": "vajjamānesu vaggusu ",
  "ja539:150.1": "turiyatāḷitasaṃghuṭṭhe ",
  "ja539:150.2": "sammatāḷasamāhite ",
  "ja539:150.3": "Sa Migājina-m-addakkhiṃ ",
  "ja539:150.4": "phalaṃ amban tirochadaṃ ",
  "ja539:150.5": "taddamānaṃ manussehi ",
  "ja539:150.6": "phalakāmehi jantuhi. ",
  "ja539:151.1": "So kho 'haṃ taṃ sirim hitvā ",
  "ja539:151.2": "orohitvā Migājina ",
  "ja539:151.3": "mūlaṃ ambass' upagañchiṃ ",
  "ja539:151.4": "phalino nipphalassa ca. ",
  "ja539:152.1": "Phalaṃ ambaṃ hataṃ disvā ",
  "ja539:152.2": "viddhastaṃ vinaḷīkataṃ ",
  "ja539:152.3": "ath' etaṃ itaraṃ ambaṃ ",
  "ja539:152.4": "nīlobhāsaṃ manoramaṃ. ",
  "ja539:153.1": "Evam eva nūna amhe ",
  "ja539:153.2": "issare bahukaṇṭake ",
  "ja539:153.3": "amittā no vadhissanti ",
  "ja539:153.4": "yathā ambo phalī hato. ",
  "ja539:154.1": "Ajinamhi haññate dīpī, ",
  "ja539:154.2": "nāgo dantehi haññati, ",
  "ja539:154.3": "dhanamhi dhanino hanti ",
  "ja539:154.4": "aniketam asanthavaṃ, ",
  "ja539:154.5": "phalī ambo aphalo ca ",
  "ja539:154.6": "te satthāro ubho mamanti. ",
  "ja539:155.1": "Sabbo jano pavyadhito: ",
  "ja539:155.2": "rājā pabbajito iti, ",
  "ja539:155.3": "hatthārūhā anīkaṭṭhā ",
  "ja539:155.4": "rathikā pattikārikā. ",
  "ja539:156.1": "Assāsayitvā janataṃ ",
  "ja539:156.2": "ṭhapayitvā paṭicchadaṃ ",
  "ja539:156.3": "puttaṃ rajje ṭhapetvāna ",
  "ja539:156.4": "atha pacchā pabbajissasīti. ",
  "ja539:157.1": "Cattā mayā janapadā ",
  "ja539:157.2": "mittāmaccā ca ñātakā, ",
  "ja539:157.3": "",
  "ja539:157.4": "",
  "ja539:157.5": "",
  "ja539:157.6": "",
  "ja539:158.1": "Ehi taṃ anusikkhāmi ",
  "ja539:158.2": "yaṃ vākyaṃ mama ruccati ",
  "ja539:158.3": "rajjaṃ tuvaṃ kārayantī ",
  "ja539:158.4": "pāpaduccaritaṃ bahuṃ ",
  "ja539:158.5": "kāyena vācā manasā ",
  "ja539:158.6": "yena gañchisi duggatiṃ. ",
  "ja539:159.1": "Paradinnakena paraniṭṭhitena ",
  "ja539:159.2": "piṇḍena yāpehi, sa dhīradhammoti. ",
  "ja539:160.1": "Yo pi catutthe bhattakāle na bhuñje ",
  "ja539:160.2": "ajaddhumāriva khudāya mīye, ",
  "ja539:160.3": "na tv-eva piṇḍaṃ luḷitaṃ anariyaṃ ",
  "ja539:160.4": "kulaputtarūpo sappuriso na seve, ",
  "ja539:160.5": "ta-y-idaṃ na sādhu, ta-y-idaṃ na suṭṭhu, ",
  "ja539:160.6": "sunakhucchiṭṭhakaṃ bhuñjase tvanti. ",
  "ja539:161.1": "Na cāpi me Sīvalī so abhakkho ",
  "ja539:161.2": "yaṃ hoti cattaṃ gihino sunakhassa vā, ",
  "ja539:161.3": "Kumāriye ",
  "ja539:161.4": "",
  "ja539:162.1": "upaseniye ",
  "ja539:162.2": "niccaṃ nigaḷamaṇḍike ",
  "ja539:162.3": "[kasmā] te eko bhujo janati ",
  "ja539:162.4": "eko na janatī bhujoti. ",
  "ja539:163.1": "Imasmiṃ [me] samaṇa hatthe ",
  "ja539:163.2": "paṭimukkā dunīdhurā, ",
  "ja539:163.3": "saṃghātā jāyate saddo, ",
  "ja539:163.4": "dutiyass' eva sā gati. ",
  "ja539:164.1": "Imasmiṃ [me] samaṇa hatthe ",
  "ja539:164.2": "paṭimukko ekanīdhuro, ",
  "ja539:164.3": "so adutiyo na janati, ",
  "ja539:164.4": "munibhūto va tiṭṭhati. ",
  "ja539:165.1": "Vivādamanto dutiyo, ",
  "ja539:165.2": "ken' eko vivadissati, ",
  "ja539:165.3": "tassa te saggakāmassa ",
  "ja539:165.4": "ekattam uparocatanti. ",
  "ja539:166.1": "Suṇasī Sīvali gāthā ",
  "ja539:166.2": "kumāriyā paveditā, ",
  "ja539:166.3": "pessikā maṃ garahittho, ",
  "ja539:166.4": "dutiyass' eva sā gati. ",
  "ja539:167.1": "Ayaṃ dvedhāpatho bhadde ",
  "ja539:167.2": "anuciṇṇo pathāvihi, ",
  "ja539:167.3": "tesaṃ tvaṃ ekaṃ gaṇhāhi, ",
  "ja539:167.4": "aham ekaṃ punāparaṃ, ",
  "ja539:168.1": "n' eva maṃ tvaṃ pati meti ",
  "ja539:168.2": "māhaṃ bhariyāti vā punāti. ",
  "ja539:168.3": "Imam eva kathaṃ kathentā Thūṇan ",
  "ja539:168.4": "nagaraṃ upāgamunti. ",
  "ja539:169.1": "Koṭṭhake usukārassa ",
  "ja539:169.2": "bhattakāle upaṭṭhite ",
  "ja539:169.3": "tatra ca so usukāro ",
  "ja539:169.4": "",
  "ja539:169.5": "ekañ ca cakkhu niggayha ",
  "ja539:169.6": "jimham ekena pekkhatīti. ",
  "ja539:170.1": "Evan no sādhu passasi, ",
  "ja539:170.2": "usukāra suṇohi me, ",
  "ja539:170.3": "yad ekaṃ cakkhuṃ niggayha ",
  "ja539:170.4": "jimham ekena pekkhasīti. ",
  "ja539:171.1": "Dvīhi samaṇa cakkhūhi ",
  "ja539:171.2": "visālaṃ viya khāyati, ",
  "ja539:171.3": "asampatvā paraṃ liṅgaṃ ",
  "ja539:171.4": "n' ujjubhāvāya kappati. ",
  "ja539:172.1": "Ekañ ca cakkhuṃ niggayha ",
  "ja539:172.2": "jimham ekena pekkhato ",
  "ja539:172.3": "sampatvā paramaṃ liṅgaṃ ",
  "ja539:172.4": "ujjubhāvāya kappati. ",
  "ja539:173.1": "Vivādamatto dutiyo, ",
  "ja539:173.2": "ken' eko vivadissati, ",
  "ja539:173.3": "tassa te saggakāmassa ",
  "ja539:173.4": "ekattam uparocatanti. ",
  "ja539:174.1": "Suṇasī Sīvali gāthā ",
  "ja539:174.2": "usakārena paveditā, ",
  "ja539:174.3": "pessiyā maṃ garahittho, ",
  "ja539:174.4": "dutiyass' eva sā gati. ",
  "ja539:175.1": "Ayaṃ dvedhāpatho bhadde ",
  "ja539:175.2": "anuciṇṇo pathāvihi, ",
  "ja539:175.3": "tesaṃ tvaṃ ekaṃ gaṇhāhi, ",
  "ja539:175.4": "aham ekaṃ punāparaṃ, ",
  "ja539:176.1": "n' eva maṃ tvaṃ pati meti ",
  "ja539:176.2": "māhaṃ bhariyāti vā punāti. Muñjā ",
  "ja539:176.3": "v' isikā pavaḷhā ",
  "ja539:176.4": "ekā vihara Sīvalīti. ",
  "ja539:177.1": ""
}
