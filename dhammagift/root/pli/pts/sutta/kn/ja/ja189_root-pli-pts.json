  "ja189:1.1": "N' etaṃ sīhassa naditaṃ ",
  "ja189:1.2": "na vyagghassa na dīpino, ",
  "ja189:1.3": "pāruto sīhacammena ",
  "ja189:1.4": "jammo nadati gadrabhoti. ",
  "ja189:2.1": "Ciram pi kho taṃ khādeyya ",
  "ja189:2.2": "gadrabho haritaṃ yavaṃ ",
  "ja189:2.3": "pāruto sīhacammena, ",
  "ja189:2.4": "ravamāno ca dūsayīti. ",
  "ja189:3.1": ""
}
