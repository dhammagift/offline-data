  "ja392:0.4": "",
  "ja392:1.1": "vārijaṃ pupphaṃ ",
  "ja392:1.2": "adinnaṃ upasiṃghasi ",
  "ja392:1.3": "ekaṅgam etaṃ theyyānaṃ, ",
  "ja392:1.4": "gandhatheno si mārisāti. ",
  "ja392:2.1": "Na harāmi, na bhañjāmi, ",
  "ja392:2.2": "ārā siṃghāmi vārijaṃ, ",
  "ja392:2.3": "atha kena nu vaṇṇena ",
  "ja392:2.4": "gandhatthenoti vuccatīti. ",
  "ja392:3.1": "Yo 'yaṃ bhisāni khaṇati ",
  "ja392:3.2": "puṇḍarīkāni bhañjati ",
  "ja392:3.3": "evaṃ ākiṇṇakammanto ",
  "ja392:3.4": "kasmā eso na vuccatīti. ",
  "ja392:4.1": "Ākiṇṇaluddo puriso ",
  "ja392:4.2": "dhāticelaṃ va makkhito, ",
  "ja392:4.3": "tasmiṃ me vacanaṃ n' atthi, tañ ca ",
  "ja392:4.4": "arahāmi vattave. ",
  "ja392:5.1": "Anaṅgaṇassa posassa ",
  "ja392:5.2": "niccaṃ sucigavesino ",
  "ja392:5.3": "vālaggamattaṃ pāpassa ",
  "ja392:5.4": "abbhāmattaṃ va khāyatīti. ",
  "ja392:6.1": "Addhā maṃ yakkha jānāsi ",
  "ja392:6.2": "atho maṃ anukampasi, ",
  "ja392:6.3": "puna pi yakkha vajjāsi ",
  "ja392:6.4": "yadā passasi edisanti. ",
  "ja392:7.1": "N' eva taṃ upajīvāmi ",
  "ja392:7.2": "na pi te bhatak' amhase, ",
  "ja392:7.3": "tvam eva bhikkhu jāneyya ",
  "ja392:7.4": "yena gaccheyya suggatinti. ",
  "ja392:8.1": ""
}
