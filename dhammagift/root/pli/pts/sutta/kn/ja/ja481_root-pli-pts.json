  "ja481:0.1": "",
  "ja481:0.2": "",
  "ja481:0.3": "",
  "ja481:0.4": "",
  "ja481:1.1": "Aham eva dubbhāsitaṃ bhāsi bālo ",
  "ja481:1.2": "bheko v' araññe ahim avhayāno, ",
  "ja481:1.3": "Takkāriye sobbham imaṃ patāmi, ",
  "ja481:1.4": "na kir' eva sādhu ativelabhāṇīti. ",
  "ja481:2.1": "Pappoti macco ativelabhāṇī ",
  "ja481:2.2": "evaṃ vadhaṃ sokapariddavañ ca, attānaṃ ",
  "ja481:2.3": "yeva garahāsi ettha ",
  "ja481:2.4": "ācera yan taṃ nikhaṇanti sobbheti. ",
  "ja481:3.1": "Kim ev' ahaṃ Tuṇḍilam ānupuccheyyaṃ ",
  "ja481:3.2": "Kareyya saṃ bhātaraṃ Kālikā yaṃ, ",
  "ja481:3.3": "naggo v' ahaṃ vatthayugañ ca jīno, ",
  "ja481:3.4": "ayam pi attho bahu tādiso vāti. ",
  "ja481:4.1": "Yo yujjhamānānaṃ ayujjhamāno ",
  "ja481:4.2": "meṇḍantaraṃ accupatī kuliṃko ",
  "ja481:4.3": "so piṃsito meṇḍasirehi tattha, ",
  "ja481:4.4": "ayam pi attho bahu tādiso vāti. ",
  "ja481:5.1": "Caturo janā potthakaṃ aggahesuṃ, ",
  "ja481:5.2": "ekañ ca posaṃ anurakkhamānā ",
  "ja481:5.3": "sabbe va te bhinnasirā sayiṃsu, ",
  "ja481:5.4": "ayam pi attho bahu tādiso vāti. ",
  "ja481:6.1": "Ajā yathā veḷugumbasmiṃ baddhā ",
  "ja481:6.2": "avekkhipantī asik' ajjhagañchi ",
  "ja481:6.3": "ten' eva tassā galak' āvakantaṃ, ",
  "ja481:6.4": "ayam pi attho bahu tādiso vāti. Na-y- ",
  "ja481:7.1": "ime devā na pi gandhabbaputtā, ",
  "ja481:7.2": "migā ime atthavasābhatā ime, ",
  "ja481:7.3": "ekañ ca naṃ sāyamāse pacantu ",
  "ja481:7.4": "ekañ ca naṃ pātarāse pacantūti. ",
  "ja481:8.1": "Sataṃ sahassaṃ dubbhāsitānaṃ ",
  "ja481:8.2": "kalam pi nāgghanti subhāsitassa, ",
  "ja481:8.3": "dubbhāsitaṃ saṃkamāno kileso, ",
  "ja481:8.4": "tasmā tuṇhī kimpurisā, na balyāti. ",
  "ja481:9.1": "Yā mesā vyāhāsi pamuñcath' etaṃ, ",
  "ja481:9.2": "giriñ ca naṃ Himavantaṃ nayantu, ",
  "ja481:9.3": "imañ ca kho dentu mahānasāya ",
  "ja481:9.4": "pāto ca naṃ pātarāse pacantūti. ",
  "ja481:10.1": "Pajjunnanāthā pasavo, ",
  "ja481:10.2": "pasunāthā ayaṃ pajā, ",
  "ja481:10.3": "tvaṃnātho 'smi mahārāja, ",
  "ja481:10.4": "nātho 'haṃ bhariyāya ca, ",
  "ja481:10.5": "dvinnam aññataraṃ ñatvā ",
  "ja481:10.6": "mutto gaccheyya pabbatanti. ",
  "ja481:11.1": "Na ve nindā suparivajjayā ce ",
  "ja481:11.2": "nānā janā sevitabbā janinda, ",
  "ja481:11.3": "",
  "ja481:11.4": "",
  "ja481:12.1": "Sabbo loko paracitto acitto, ",
  "ja481:12.2": "sabbo loko cittavasamhi citto, ",
  "ja481:12.3": "paccekacittā puthu sabbasattā, ",
  "ja481:12.4": "kass' īdha cittassa vase na vatteti. ",
  "ja481:13.1": "Tuṇhī ahū kimpuriso sabhariyo, ",
  "ja481:13.2": "yo dāni vyāhāsi bhayassa bhīto ",
  "ja481:13.3": "so dāni mutto sukhito arogo, ",
  "ja481:13.4": "vācā kir' ev' atthavatī narānanti. Kassa ",
  "ja481:14.1": ""
}
