  "ja438:0.4": "",
  "ja438:1.1": "Yo te puttake akhādi ",
  "ja438:1.2": "dinnabhatto adūsake ",
  "ja438:1.3": "tasmiṃ dāṭhaṃ nipātehi, ",
  "ja438:1.4": "mā te muccittha jīvatoti. ",
  "ja438:2.1": "Ākiṇṇaluddo puriso ",
  "ja438:2.2": "dhāticelaṃ va makkhito, ",
  "ja438:2.3": "padesan taṃ na passāmi ",
  "ja438:2.4": "yattha dāṭhaṃ nipātaye. ",
  "ja438:3.1": "Akataññussa posassa ",
  "ja438:3.2": "niccaṃ vivaradassino ",
  "ja438:3.3": "(I, 322; Dhp. p.149.) sabbaṃ ce paṭhaviṃ dajjā ",
  "ja438:3.4": "n' eva naṃ abhirādhayeti. ",
  "ja438:4.1": "Kin nu Subāhu taramānarūpo ",
  "ja438:4.2": "paccāgato si saha māṇavena, ",
  "ja438:4.3": "kiṃ kiccam atthaṃ idha-m-atthi tuyhaṃ, ",
  "ja438:4.4": "akkhāhi me pucchito etam atthanti. ",
  "ja438:5.1": "Yo te sakhā daddaro sādhurūpo ",
  "ja438:5.2": "tassa vadhaṃ parisaṃkāmi ajja, ",
  "ja438:5.3": "purisassa kammāyatanāni sutvā ",
  "ja438:5.4": "nāhaṃ sukhiṃ daddaraṃ ajja maññeti. ",
  "ja438:6.1": "Kāni 'ssa kammāyatanāni assu ",
  "ja438:6.2": "purisassa vattisamodhānatāya, ",
  "ja438:6.3": "kaṃ vā paṭiññaṃ purisassa sutvā ",
  "ja438:6.4": "parisaṃkasi daddaraṃ māṇavenāti. ",
  "ja438:7.1": "Ciṇṇā Kāliṅgā, caritā vaṇijjā, ",
  "ja438:7.2": "vettācāro saṃkupatho pi ciṇṇo, ",
  "ja438:7.3": "naṭehi ciṇṇaṃ saha vākarehi, ",
  "ja438:7.4": "daṇḍehi yuddham pi samajjamajjhe. ",
  "ja438:8.1": "Baddhā kuliṃkā, mitam āḷhakena, ",
  "ja438:8.2": "akkhā jitā, saṃyamo abbhatīto, ",
  "ja438:8.3": "abbūhitaṃ pupphakaṃ aḍḍharattaṃ, ",
  "ja438:8.4": "hatthā daḍḍhā piṇḍapaṭiggahena. ",
  "ja438:9.1": "Tāni 'ssa kammāyatanāni assuṃ ",
  "ja438:9.2": "purisassa vattisamodhānatāya, ",
  "ja438:9.3": "yathā ayaṃ dissati lomapiṇḍo ",
  "ja438:9.4": "gāvo hatā, kiṃ pana daddarassāti. Catudvāram ",
  "ja438:10.1": "",
  "ja438:11.1": "",
  "ja438:12.1": "",
  "ja438:13.1": "",
  "ja438:13.2": "idaṃ ",
  "ja438:13.3": "",
  "ja438:13.4": ""
}
