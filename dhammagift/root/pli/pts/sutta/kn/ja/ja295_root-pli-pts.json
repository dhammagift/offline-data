  "ja295:1.1": "Usabhasseva te khandho ",
  "ja295:1.2": "sīhasseva vijambhitaṃ, ",
  "ja295:1.3": "migarāja namo ty-atthu, ",
  "ja295:1.4": "api kiñci labhāmaseti. ",
  "ja295:2.1": "Kulaputto va jānāti ",
  "ja295:2.2": "kulaputte pasaṃsituṃ, ",
  "ja295:2.3": "mayūragīvasaṃkāsa ",
  "ja295:2.4": "ito pariyāhi vāyasāti. ",
  "ja295:3.1": "Migānaṃ kotthuko anto ",
  "ja295:3.2": "pakkhīnaṃ pana vāyaso ",
  "ja295:3.3": "eraṇḍo anto rukkhānaṃ, ",
  "ja295:3.4": "tayo antā samāgatāti. ",
  "ja295:4.1": ""
}
