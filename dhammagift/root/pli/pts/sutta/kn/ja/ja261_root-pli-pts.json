  "ja261:1.1": "Yathā kesā ca massu ca ",
  "ja261:1.2": "chinnaṃ chinnaṃ virūhati ",
  "ja261:1.3": "evaṃ rūhati te nāsā, ",
  "ja261:1.4": "padumaṃ dehi yācitoti. ",
  "ja261:2.1": "Yathā sāradikaṃ bījaṃ ",
  "ja261:2.2": "khette vuttaṃ virūhati ",
  "ja261:2.3": "evaṃ rūhatu te nāsā, ",
  "ja261:2.4": "padumaṃ dehi yācitoti. ",
  "ja261:3.1": "Ubho pi palapante te ",
  "ja261:3.2": "‘api padumāni dassati', ",
  "ja261:3.3": "vajju vā te na vā vajju ",
  "ja261:3.4": "n' atthi nāsāya rūhanā, ",
  "ja261:3.5": "dehi samma padumāni ",
  "ja261:3.6": "amhehi pi yācitoti. ",
  "ja261:4.1": ""
}
