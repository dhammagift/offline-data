  "ja402:0.4": "",
  "ja402:1.1": "Vibbhantacitto kupitindriyo si, ",
  "ja402:1.2": "nettehi te vārigaṇā savanti, ",
  "ja402:1.3": "kin te naṭṭhaṃ kiṃ pana patthayāno ",
  "ja402:1.4": "idhāgamā brahme tad iṃgha brūhīti. ",
  "ja402:2.1": "Mīyetha bhariyā vajato mam' ajja, ",
  "ja402:2.2": "agacchato maraṇaṃ āha yakkho, ",
  "ja402:2.3": "etena dukkhena pavedhito 'smi, ",
  "ja402:2.4": "akkhāhi me Senaka etam atthanti. ",
  "ja402:3.1": "Bahūni ṭhānāni vicintayitvā ",
  "ja402:3.2": "yam ettha vakkhāmi tad eva saccaṃ, ",
  "ja402:3.3": "maññāmi te brāhmaṇa sattubhastaṃ ",
  "ja402:3.4": "ajānato kaṇhasappo paviṭṭhoti. ",
  "ja402:4.1": "Ādāya daṇḍaṃ parisumbha bhastaṃ, ",
  "ja402:4.2": "pass' eḷamūgaṃ uragaṃ dijivhaṃ, ",
  "ja402:4.3": "chind' ajja kaṃkhaṃ vicikicchitāni, ",
  "ja402:4.4": "bhujaṅgamaṃ passa, pamuñca bhastanti. ",
  "ja402:5.1": "Saṃviggarūpo parisāya majjhe ",
  "ja402:5.2": "so brāhmaṇo sattubhastaṃ pamuñci, ",
  "ja402:5.3": "atha nikkhami urago uggatejo ",
  "ja402:5.4": "āsīviso sappo phaṇaṃ karitvāti. ",
  "ja402:6.1": "Suladdhalābhā Janakassa rañño ",
  "ja402:6.2": "yo passatī Senakaṃ sādhupaññanti. ",
  "ja402:6.3": "",
  "ja402:6.4": "",
  "ja402:7.1": "imāni me sattasatāni atthi, ",
  "ja402:7.2": "gaṇhāhi sabbāni dadāmi tuyhaṃ. ",
  "ja402:7.3": "Tayā hi me jīvitaṃ ajja laddhaṃ, ",
  "ja402:7.4": "atho pi bhariyāya-m-akāsi sotthinti. ",
  "ja402:8.1": "Na paṇḍitā vedanam ādiyanti ",
  "ja402:8.2": "citrāhi gāthāhi subhāsitāhi, ",
  "ja402:8.3": "ito pi te brahme dadantu vittaṃ, ",
  "ja402:8.4": "ādāya tvaṃ gaccha sakaṃ niketanti. ",
  "ja402:9.1": ""
}
