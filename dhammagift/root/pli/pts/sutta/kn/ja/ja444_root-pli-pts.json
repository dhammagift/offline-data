  "ja444:0.4": "",
  "ja444:1.1": "Sattāham evāhaṃ pasannacitto (= Morris, Cariyāp. p. 100) ",
  "ja444:1.2": "puññatthiko acariṃ brahmacariyaṃ, ",
  "ja444:1.3": "athāparaṃ yaṃ caritaṃ mamā-y-idaṃ ",
  "ja444:1.4": "vassāni paññāsa samādhikāni ",
  "ja444:1.5": "akāmako vā hi ahaṃ carāmi, ",
  "ja444:1.6": "etena saccena suvatthi hotu, ",
  "ja444:1.7": "hataṃ visaṃ, jīvatu Yaññadattoti. ",
  "ja444:2.1": "Yasmā dānaṃ n' abhinandiṃ kadāci ",
  "ja444:2.2": "disvānāhaṃ atithiṃ vāsakāle ",
  "ja444:2.3": "",
  "ja444:2.4": "",
  "ja444:2.5": "",
  "ja444:2.6": "",
  "ja444:2.7": "",
  "ja444:3.1": "Āsīviso tāta pahūtatejo ",
  "ja444:3.2": "yo taṃ aḍatthi patarā udicca, ",
  "ja444:3.3": "tasmiñ ca me appiyatāya ajja ",
  "ja444:3.4": "pitari ca te n' atthi koci viseso, ",
  "ja444:3.5": "etena --pe-- ",
  "ja444:3.6": "Yaññadattoti. ",
  "ja444:4.1": "Santā dantā yeva paribbajanti ",
  "ja444:4.2": "aññatra Kaṇhā anakāmarūpā, ",
  "ja444:4.3": "Dīpāyana kissa jigucchamāno ",
  "ja444:4.4": "akāmako carasi brahmacariyanti. ",
  "ja444:5.1": "‘Saddhāya nikkhamma punaṃ nivatto, ",
  "ja444:5.2": "so elamūgo va bālo vatāyaṃ', ",
  "ja444:5.3": "etassa vādassa jigucchamāno ",
  "ja444:5.4": "akāmako carāmi brahmacariyaṃ ",
  "ja444:5.5": "viññūpasatthañ ca satañ ca ṭhānaṃ, ",
  "ja444:5.6": "evaṃ p' ahaṃ puññakaro bhavāmīti. ",
  "ja444:6.1": "Samaṇe tuvaṃ brāhmaṇe addhike ca ",
  "ja444:6.2": "santappayāsi annapānena bhikkhuṃ, ",
  "ja444:6.3": "opānabhūtaṃ va gharaṃ tavā-y-idaṃ ",
  "ja444:6.4": "annena pānena upetarūpaṃ, ",
  "ja444:6.5": "atha kissa vādassa jigucchamāno ",
  "ja444:6.6": "akāmako dānam imaṃ dadāsīti. ",
  "ja444:7.1": "Pitaro ca me āsu pitāmahā ca ",
  "ja444:7.2": "saddhā, ahū dānapatī vadaññū, ",
  "ja444:7.3": "taṃ kullavattaṃ anuvattamāno ",
  "ja444:7.4": "‘māhaṃ kule antimagandhino ahuṃ ",
  "ja444:7.5": "etassa vādassa jigucchamāno ",
  "ja444:7.6": "akāmako dānam imaṃ dadāmīti. ",
  "ja444:8.1": "Dahariṃ kumāriṃ asamatthapaññaṃ ",
  "ja444:8.2": "yan t' ānayiṃ ñātikulā sugatte ",
  "ja444:8.3": "na vāpi me appiyataṃ avedi ",
  "ja444:8.4": "aññatra kāmā paricārayantī, ",
  "ja444:8.5": "atha kena vaṇṇena mayā te bhoti ",
  "ja444:8.6": "saṃvāsadhammo ahu evarūpoti. ",
  "ja444:9.1": "Ārā dūre na idha kadāci atthi ",
  "ja444:9.2": "paramparā nāma kule imasmiṃ, ",
  "ja444:9.3": "taṃ kullavattaṃ anuvattamānā ",
  "ja444:9.4": "‘māhaṃ kule antimagandhinī ahuṃ' ",
  "ja444:9.5": "etassa vādassa jigucchamānā ",
  "ja444:9.6": "akāmikā baddha carāmi tuyhanti. ",
  "ja444:10.1": "Maṇḍavya bhāsissaṃ abhāsaneyyaṃ, ",
  "ja444:10.2": "taṃ khamyataṃ puttahetu mam' ajja, ",
  "ja444:10.3": "puttapemā na idha par' atthi kiñci, ",
  "ja444:10.4": "so no ayaṃ jīvati Yaññadattoti. ",
  "ja444:11.1": ""
}
