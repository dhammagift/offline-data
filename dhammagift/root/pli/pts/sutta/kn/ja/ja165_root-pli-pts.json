  "ja165:1.1": "Sandhiṃ katvā amittena ",
  "ja165:1.2": "aṇḍajena jalābuja ",
  "ja165:1.3": "vivariya dāṭhaṃ sayasi, ",
  "ja165:1.4": "kuto te bhayam āgatanti. ",
  "ja165:2.1": "Saṃketh' eva amittasmiṃ, ",
  "ja165:2.2": "mittasmim pi na vissase. ",
  "ja165:2.3": "abhayā bhayam uppannaṃ ",
  "ja165:2.4": "api mūlāni kantatīti. Upasāḷhakanāmānaṃ ",
  "ja165:3.1": ""
}
