  "ja523:1.1": "brahā Indo ",
  "ja523:1.2": "Vatrabhū jayatam pitā ",
  "ja523:1.3": "devakaññaṃ parābhetvā ",
  "ja523:1.4": "Sudhammāyaṃ Alambusan: ti. ",
  "ja523:2.1": "Misse devā taṃ yācanti ",
  "ja523:2.2": "Tāvatiṃsā saindakā: ",
  "ja523:2.3": "isiṃ palobhike gaccha ",
  "ja523:2.4": "Isisiṅgaṃ Alambuseti. ",
  "ja523:3.1": "Purāyaṃ amhe acceti ",
  "ja523:3.2": "vatavā brahmacariyavā ",
  "ja523:3.3": "nibbānābhirato vaddho ",
  "ja523:3.4": "tassa maggāni ācara iti vacanaṃ ā. ",
  "ja523:4.1": "Devarāja kim eva tvam, ",
  "ja523:4.2": "mam' eva tuvaṃ s' ikkhasi: ‘isiṃ ",
  "ja523:4.3": "palobhike gaccha', ",
  "ja523:4.4": "santi aññāpi accharā ",
  "ja523:5.1": "Mādisiyo pavarā c' eva ",
  "ja523:5.2": "asoke Nandane vane, ",
  "ja523:5.3": "tāsam pi hotu pariyāyo, ",
  "ja523:5.4": "tāpi yantu palobhikāti. ",
  "ja523:6.1": "Addhā hi saccaṃ bhaṇasi, ",
  "ja523:6.2": "santi aññāpi accharā, ",
  "ja523:6.3": "tādisiyo pavarā c' eva ",
  "ja523:6.4": "asoke Nandane vane. ",
  "ja523:7.1": "Na tā evaṃ pajānanti ",
  "ja523:7.2": "pāricariyaṃ pumaṃ gatā ",
  "ja523:7.3": "yādisaṃ tvaṃ pajānāsi ",
  "ja523:7.4": "nāri sabbaṅgasobhane. ",
  "ja523:8.1": "Tvam eva gaccha kalyāṇi, ",
  "ja523:8.2": "itthīnaṃ pavarā c' asi, tam ",
  "ja523:8.3": "eva vaṇṇarūpena ",
  "ja523:8.4": "vasam ānāmayissasīti. ",
  "ja523:9.1": "Na v'āhaṃ na gamissāmi ",
  "ja523:9.2": "devarājena pesitā, ",
  "ja523:9.3": "vihemi c' etaṃ āsāduṃ, ",
  "ja523:9.4": "uggatejo hi brāhmaṇo. ",
  "ja523:10.1": "Aneke nirayaṃ pattā ",
  "ja523:10.2": "isiṃ āsādiyā janā ",
  "ja523:10.3": "āpannā mohasaṃsāraṃ, ",
  "ja523:10.4": "tasmā lomāni haṃsayeti. ",
  "ja523:11.1": "Idaṃ vatvāna pakkāmi ",
  "ja523:11.2": "accharā nāma vaṇṇinī ",
  "ja523:11.3": "missā missetum icchantī ",
  "ja523:11.4": "Isisiṅgaṃ Alambusā. ",
  "ja523:12.1": "Sā ca naṃ vanam ogayha ",
  "ja523:12.2": "Isisiṅgena rakkhitaṃ ",
  "ja523:12.3": "bimbijālakasañchannaṃ ",
  "ja523:12.4": "samantā aḍḍhayojanaṃ ",
  "ja523:13.1": "Pāto va pātarāsamhi ",
  "ja523:13.2": "udaṇhasamayaṃ pati. ",
  "ja523:13.3": "aggiṭṭhaṃ parimajjantaṃ ",
  "ja523:13.4": "Isisiṅgaṃ upāgamīti ",
  "ja523:14.1": "Kā nu vijju-r-ivābhāsi ",
  "ja523:14.2": "osadhī viya tārakā ",
  "ja523:14.3": "vicitrahatthābharaṇā ",
  "ja523:14.4": "āmuttamaṇikuṇḍalā ",
  "ja523:15.1": "Ādiccavaṇṇasaṃkāsā ",
  "ja523:15.2": "hemacandanagandhanī ",
  "ja523:15.3": "saññatūrū mahāmāyā ",
  "ja523:15.4": "kumārī cārudassanā ",
  "ja523:16.1": "Vilākā mudukā suddhā, ",
  "ja523:16.2": "pādā te suppatiṭṭhitā, ",
  "ja523:16.3": "kamanā kamanīyā te ",
  "ja523:16.4": "harantī ñeva me mano. ",
  "ja523:17.1": "Anupubbā va te ūrū ",
  "ja523:17.2": "nāganāsasamūpamā, ",
  "ja523:17.3": "vimaṭṭhā tuyhaṃ sussoṇī ",
  "ja523:17.4": "akkhassa phalakaṃ yathā. ",
  "ja523:18.1": "Uppalasseva kiñjakkhā ",
  "ja523:18.2": "nābhi te sādhusaṇṭhitā ",
  "ja523:18.3": "purā kaṇhañjanasseva ",
  "ja523:18.4": "dūrato patidissati. ",
  "ja523:19.1": "Duvidhā jātā urajā ",
  "ja523:19.2": "avaṇṭā sādhupaccudā ",
  "ja523:19.3": "payodharā appatītā ",
  "ja523:19.4": "addhalābusamā thanā. ",
  "ja523:20.1": "Dīghā kambutalābhāsā ",
  "ja523:20.2": "gīvā eṇeyyakā yathā ",
  "ja523:20.3": "paṇḍarāvaraṇā vaggu ",
  "ja523:20.4": "catutthamanasannibhā. ",
  "ja523:21.1": "Uddhaggā ca adhaggā ca ",
  "ja523:21.2": "dumaggaparimajjitā ",
  "ja523:21.3": "duvijā nelasambhūtā ",
  "ja523:21.4": "dantā tava sudassanā. ",
  "ja523:22.1": "Apaṇḍarā lohitantā ",
  "ja523:22.2": "jiñjukaphalasannibhā ",
  "ja523:22.3": "āyatā ca visālā ca ",
  "ja523:22.4": "nettā tava sudassanā. ",
  "ja523:23.1": "Nātidīghā susammaṭṭhā ",
  "ja523:23.2": "kanakaggāsamocitā ",
  "ja523:23.3": "uttamaṅgaruhā tuyhaṃ ",
  "ja523:23.4": "kesā candanagandhikā. ",
  "ja523:24.1": "Yāvatā kasigorakkhā ",
  "ja523:24.2": "vaṇijānañ ca yā gati ",
  "ja523:24.3": "isīnañ ca parakkantaṃ ",
  "ja523:24.4": "saññatānaṃ tapassinaṃ -- ",
  "ja523:25.1": "Na te samasamaṃ passe ",
  "ja523:25.2": "asmiṃ puthuvimaṇḍale, ",
  "ja523:25.3": "ko vā tvaṃ kassa vā putto, ",
  "ja523:25.4": "kathaṃ jānenu taṃ mayanti. ",
  "ja523:26.1": "Na pañhakālo bhaddan te ",
  "ja523:26.2": "Kassap' evaṃ gate sati, ",
  "ja523:26.3": "ehi samma ramissāma ",
  "ja523:26.4": "ubho amhākaṃ assame, ",
  "ja523:26.5": "ehi taṃ upagūhissaṃ ",
  "ja523:26.6": "ratīnaṃ kusalo bhavāti g. ā. ",
  "ja523:27.1": "Idaṃ vatvāna pakkāmi ",
  "ja523:27.2": "accharā kāmavaṇṇinī ",
  "ja523:27.3": "missā missetum icchantī ",
  "ja523:27.4": "Isisiṅgaṃ Alambusāti g. ā. ",
  "ja523:28.1": "So ca vegena nikkhamma ",
  "ja523:28.2": "chetvā dandhaparakkamaṃ ",
  "ja523:28.3": "tam uttamāsu veṇīsu ",
  "ja523:28.4": "ajjhāpatto parāmasi. ",
  "ja523:29.1": "Tam udāvattaṃ kalyāṇī ",
  "ja523:29.2": "palissaji susobhanā ",
  "ja523:29.3": "cavi tamhi brahmacariyā ",
  "ja523:29.4": "yathā taṃ atha tositā. ",
  "ja523:30.1": "Manasā āgamā Indaṃ ",
  "ja523:30.2": "vasantaṃ Nandane vane, ",
  "ja523:30.3": "tassā saṃkappam aññāya ",
  "ja523:30.4": "Maghavā devakuñjaro ",
  "ja523:31.1": "pallaṃkaṃ pahiṇī khippaṃ ",
  "ja523:31.2": "sovaṇṇaṃ sopavāhanaṃ ",
  "ja523:31.3": "Sauttaracchadapaññāsaṃ ",
  "ja523:31.4": "sahassapaṭiyatthataṃ, ",
  "ja523:32.1": "taṃ enaṃ tattha dhāresi ",
  "ja523:32.2": "ure katvāna sobhanā. ",
  "ja523:32.3": "Yathā ekamuhuttaṃ va ",
  "ja523:32.4": "tīṇi vassāni dhārayi ",
  "ja523:33.1": "vimado tīhi vassehi ",
  "ja523:33.2": "paṭibujjhitvāna brāhmaṇo. ",
  "ja523:33.3": "Addasāsi harīrukkhe ",
  "ja523:33.4": "samantā aggiyāyanaṃ ",
  "ja523:34.1": "navapattavanaṃ phullaṃ ",
  "ja523:34.2": "kokilagaṇaghositaṃ. ",
  "ja523:34.3": "Samantā paviloketvā ",
  "ja523:34.4": "rudaṃ assūni vattayi, ",
  "ja523:35.1": "na juhe na jape mante, ",
  "ja523:35.2": "aggihuttaṃ pahāpitaṃ . ",
  "ja523:35.3": "Ko nu me pāricariyāya ",
  "ja523:35.4": "pubbe cittaṃ palobhayi ",
  "ja523:36.1": "araññe me viharato ",
  "ja523:36.2": "yo me tejā ha sambhataṃ ",
  "ja523:36.3": "nānāratanaparipūraṃ ",
  "ja523:36.4": "nāvaṃ va gaṇhi aṇṇaveti. ",
  "ja523:37.1": "Ahan te pāricariyāya ",
  "ja523:37.2": "devarājena pesitā ",
  "ja523:37.3": "avadhī cittaṃ cittena, ",
  "ja523:37.4": "pamādā tvaṃ na bujjhasīti g. ā. ",
  "ja523:38.1": "Imāni kira maṃ tāto ",
  "ja523:38.2": "Kassapo anusāsate: kamalāsaris' ",
  "ja523:38.3": "itthiyo, ",
  "ja523:38.4": "tāyo bujjhesi māṇava, ",
  "ja523:39.1": "Ure gaṇḍāyo bujjhesi, ",
  "ja523:39.2": "tāyo bujjhesi māṇava, ",
  "ja523:39.3": "icc-ānusāsi man tāto ",
  "ja523:39.4": "yathā maṃ anukampako. ",
  "ja523:40.1": "Tassāhaṃ vacanaṃ nākaṃ ",
  "ja523:40.2": "pitu vaddhassa sāsanaṃ, ",
  "ja523:40.3": "araññe nimmanussamhi ",
  "ja523:40.4": "sv-ājja-jjhāyāmi ekako. ",
  "ja523:41.1": "So 'haṃ tathā karissāmi, ",
  "ja523:41.2": "dhi-r-atthu jīvitena me, ",
  "ja523:41.3": "puna vā tādiso hessaṃ, ",
  "ja523:41.4": "maraṇaṃ me bhavissatīti. ",
  "ja523:42.1": "Tassa tejañ ca viriyañ ca dhitiñ ",
  "ja523:42.2": "ca ñatvā avatthitaṃ ",
  "ja523:42.3": "sirasā aggahi pāde ",
  "ja523:42.4": "Isisiṅgaṃ Alambusā. ",
  "ja523:43.1": "Mā me kujjhi mahāvīra, ",
  "ja523:43.2": "mā me kujjhi mahāisi, ",
  "ja523:43.3": "mahā attho mayā ciṇṇo ",
  "ja523:43.4": "tidasānaṃ yasassinaṃ, ",
  "ja523:43.5": "tayā pakampitaṃ āsi ",
  "ja523:43.6": "sabbaṃ devapuraṃ tadāti. ",
  "ja523:44.1": "Tāvatiṃsā ca ye devā ",
  "ja523:44.2": "tidasānañ ca Vāsavo ",
  "ja523:44.3": "tvañ ca bhadde sukhī hohi, ",
  "ja523:44.4": "gaccha kaññe yathāsukhanti g. ā. ",
  "ja523:45.1": "Tassa pāde gahetvāna ",
  "ja523:45.2": "katvā ca naṃ padakkhiṇaṃ ",
  "ja523:45.3": "añjaliṃ paggahetvāna ",
  "ja523:45.4": "tamhā ṭhānā apakkami. ",
  "ja523:46.1": "Yo ca tassāsi pallaṃko ",
  "ja523:46.2": "sovaṇṇasopavāhano ",
  "ja523:46.3": "sauttaracchadapaññāso ",
  "ja523:46.4": "sahassapaṭiyatthato ",
  "ja523:46.5": "taṃ eva pallaṃkam āruyha ",
  "ja523:46.6": "agā devāna santike. ",
  "ja523:47.1": "Tam okkam iva āyantiṃ ",
  "ja523:47.2": "jalantaṃ vijjutaṃ yathā ",
  "ja523:47.3": "patīto sumano vitto ",
  "ja523:47.4": "devindo adadā varanti. ",
  "ja523:48.1": "Varañ ce me ado Sakka ",
  "ja523:48.2": "sabbabhūtānam issara na ",
  "ja523:48.3": "isipalobhiyaṃ gacche, ",
  "ja523:48.4": "etaṃ Sakka varaṃ vareti. ",
  "ja523:49.1": ""
}
