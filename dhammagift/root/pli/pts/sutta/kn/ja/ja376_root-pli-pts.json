  "ja376:1.1": "bhūmipati, ",
  "ja376:1.2": "māssu kujjhi rathesabha, ",
  "ja376:1.3": "kuddhaṃ appaṭikujjhanto ",
  "ja376:1.4": "rājā raṭṭhassa pūjito. ",
  "ja376:2.1": "Gāme vā yadivāraññe ",
  "ja376:2.2": "ninne va yadivā thale (Dhp. v. 98.) ",
  "ja376:2.3": "sabbattha-m-anusāsāmi: ",
  "ja376:2.4": "māssu kujjhi rathesabhāti ",
  "ja376:3.1": "Avāriyapitā nāma ",
  "ja376:3.2": "ahū Gaṃgāya nāviko, ",
  "ja376:3.3": "pubbe janaṃ tāretvāna ",
  "ja376:3.4": "pacchā yācati vetanaṃ, ",
  "ja376:3.5": "ten' assa bhaṇḍanaṃ hoti, ",
  "ja376:3.6": "na ca bhogehi vaḍḍhatīti. ",
  "ja376:4.1": "Atiṇṇaṃ yeva yācassu ",
  "ja376:4.2": "apāraṃ tāta nāvika, ",
  "ja376:4.3": "añño hi tiṇṇassa mano, ",
  "ja376:4.4": "añño hoti taresinoti ",
  "ja376:5.1": "Gāme vā yadi vāraṇṇe ",
  "ja376:5.2": "ninne vā yadi vā thale ",
  "ja376:5.3": "sabbattha-m-anusāsāmi: ",
  "ja376:5.4": "māssu kujjhi nāvikāti Yāy' eva ",
  "ja376:6.1": "anusāsaniyā ",
  "ja376:6.2": "rājā gāmavaraṃ adā ",
  "ja376:6.3": "tāy' eva anusāsaniyā ",
  "ja376:6.4": "nāviko pahari mukheti. ",
  "ja376:7.1": "Bhattaṃ bhinnaṃ hatā bhariyā, ",
  "ja376:7.2": "gabbho va patito chamā, ",
  "ja376:7.3": "migo va jātarūpena ",
  "ja376:7.4": "na ten' atthaṃ abandhi sūti. ",
  "ja376:8.1": ""
}
