  "ja429:0.4": "",
  "ja429:1.1": "Dumo yadā hoti phalūpapanno ",
  "ja429:1.2": "bhuñjanti naṃ vihagā sampatantā, ",
  "ja429:1.3": "khīṇanti ñatvāna dumaṃ phalaccaye ",
  "ja429:1.4": "disodisaṃ yanti tato vihaṅgamāti. ",
  "ja429:2.1": "Cara cārikaṃ lohitatuṇḍa mā cari, ",
  "ja429:2.2": "kiṃ tvaṃ suva sukkhadumamhi jhāyasi, ",
  "ja429:2.3": "tad iṃgha maṃ brūhi vasantasannibha: ",
  "ja429:2.4": "kasmā suva sukkhadumaṃ na riñcasīti. ",
  "ja429:3.1": "Ye ve sakhīnaṃ sakhāro bhavanti ",
  "ja429:3.2": "pāṇaccaye sukhadukkhesu haṃsa ",
  "ja429:3.3": "khīṇaṃ akhīṇanti na taṃ jahanti ",
  "ja429:3.4": "santo sataṃ dhammam anussarantā. ",
  "ja429:4.1": "So 'haṃ sataṃ aññataro 'smi haṃsa, ",
  "ja429:4.2": "ñātī ca me hoti sakhā ca rukkho, ",
  "ja429:4.3": "taṃ n' ussahe jīvikattho pahātuṃ ",
  "ja429:4.4": "khīṇanti ñatvāna, na h' esa dhammoti. ",
  "ja429:5.1": "Sādhu sakkhi kataṃ hoti ",
  "ja429:5.2": "metti saṃsati santhavo, ",
  "ja429:5.3": "sac' etaṃ dhammaṃ rocesi ",
  "ja429:5.4": "pāsaṃso si vijānataṃ. ",
  "ja429:6.1": "So te suva varaṃ dammi ",
  "ja429:6.2": "pattayāna vihaṅgama, (Cfr. p.495.) ",
  "ja429:6.3": "varaṃ varassu vakkaṅga ",
  "ja429:6.4": "yaṃ kiñci manas' icchasīti. ",
  "ja429:7.1": "Varaṃ ce me haṃsa tuvaṃ dadeyya ",
  "ja429:7.2": "ayaṃ rukkho punar āyuṃ labhetha, ",
  "ja429:7.3": "so sākhavā phalimā saṃvirūḷho ",
  "ja429:7.4": "madhatthiko tiṭṭhatu sobhamānoti. ",
  "ja429:8.1": "Taṃ passa samma phalimaṃ uḷāraṃ, ",
  "ja429:8.2": "sabhā va te hotu udumbarena, ",
  "ja429:8.3": "so sākhavā phalimā saṃvirūḷho ",
  "ja429:8.4": "madhatthiko tiṭṭhatu sobhamānoti. ",
  "ja429:9.1": "Evaṃ Sakka sukhī hohi ",
  "ja429:9.2": "saha sabbehi ñātibhi ",
  "ja429:9.3": "(Cfr. p. 495.) yathāham ajja sukhito ",
  "ja429:9.4": "disvāna phalitaṃ dumanti. ",
  "ja429:10.1": "Suvassa ca varaṃ datvā ",
  "ja429:10.2": "katvāna saphalaṃ dumaṃ (Cfr. p.495.) ",
  "ja429:10.3": "pakkāmi saha bhariyāya ",
  "ja429:10.4": "devānaṃ Nandanaṃ vananti. ",
  "ja429:11.1": ""
}
