  "ja335:0.4": "",
  "ja335:1.1": "Brahā pavaddhakāyo so ",
  "ja335:1.2": "dīghadāṭho hi jambuka, ",
  "ja335:1.3": "na tvaṃ tamhi kule jāto ",
  "ja335:1.4": "yattha gaṇhanti kuñjaranti. ",
  "ja335:2.1": "Asīho sīhamānena ",
  "ja335:2.2": "yo attānaṃ vikubbati ",
  "ja335:2.3": "kutthuṃ va gajam āsajja ",
  "ja335:2.4": "seti bhumyā anutthunaṃ. ",
  "ja335:3.1": "Yasassino uttamapuggalassa ",
  "ja335:3.2": "sañjātakkhandhassa mahabbalassa ",
  "ja335:3.3": "asamekkhiya thāmabalūpapattiṃ ",
  "ja335:3.4": "sa seti nāgena hato va jambuko. ",
  "ja335:4.1": "Yo c' īdha kammaṃ kurute pamāya ",
  "ja335:4.2": "thāmabalaṃ attani saṃviditvā ",
  "ja335:4.3": "japena mantena subhāsitena ",
  "ja335:4.4": "parikkhavā so vipulaṃ jinātīti. ",
  "ja335:5.1": ""
}
