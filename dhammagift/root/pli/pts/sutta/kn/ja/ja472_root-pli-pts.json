  "ja472:0.4": "",
  "ja472:1.1": "Nādaṭṭhā parato dosaṃ ",
  "ja472:1.2": "anuṃthūlāni sabbaso (Dhp. p. 341) ",
  "ja472:1.3": "issaro panaye daṇḍaṃ ",
  "ja472:1.4": "sāmaṃ appaṭivekkhiya. ",
  "ja472:2.1": "Yo ca appaṭivekkhitvā ",
  "ja472:2.2": "daṇḍaṃ kubbati khattiyo ",
  "ja472:2.3": "sakaṇṭakaṃ so gilati ",
  "ja472:2.4": "jaccandho va samakkhikaṃ. ",
  "ja472:3.1": "Adaṇḍiyaṃ daṇḍiyati ",
  "ja472:3.2": "daṇḍiyañ ca adaṇḍiyaṃ ",
  "ja472:3.3": "andho va visamaṃ maggaṃ ",
  "ja472:3.4": "na jānāti samāsamaṃ. ",
  "ja472:4.1": "Yo ca etāni ṭhānāni ",
  "ja472:4.2": "anuṃthūlāni sabbaso ",
  "ja472:4.3": "suddiṭṭhaṃ anusāseyya ",
  "ja472:4.4": "sa ve vohātum arahati. ",
  "ja472:5.1": "N' ekantamudunā sakkā ",
  "ja472:5.2": "ekantatikhiṇena vā ",
  "ja472:5.3": "attaṃ mahante ṭhāpetuṃ, ",
  "ja472:5.4": "tasmā ubhayam ācare. ",
  "ja472:6.1": "Paribhūto mudu hoti ",
  "ja472:6.2": "atitikkho ca veravā, ",
  "ja472:6.3": "etañ ca ubhayaṃ ñatvā ",
  "ja472:6.4": "anumajjhaṃ samācare. ",
  "ja472:7.1": "Bahum pi ratto bhāseyya ",
  "ja472:7.2": "duṭṭho pi bahu bhāsati, ",
  "ja472:7.3": "na itthikāraṇā rāja ",
  "ja472:7.4": "puttaṃ ghātetum arahasīti. ",
  "ja472:8.1": "Sabbo ca loko ekanto ",
  "ja472:8.2": "itthī ca ayam ekikā, ",
  "ja472:8.3": "tenāhaṃ paṭipajjissaṃ, ",
  "ja472:8.4": "gaccha pakkhipath' eva nanti. ",
  "ja472:9.1": "Anekatāle narake ",
  "ja472:9.2": "gambhīre suduruttare ",
  "ja472:9.3": "pātito giriduggasmiṃ ",
  "ja472:9.4": "kena tvaṃ tattha nāmarīti. ",
  "ja472:10.1": "Nāgo jātabalo tattha ",
  "ja472:10.2": "thāmavā girisānujo ",
  "ja472:10.3": "paccaggahī maṃ bhogehi ",
  "ja472:10.4": "tenāhaṃ tattha nāmariṃ. ",
  "ja472:11.1": "Ehi taṃ paṭinessāmi ",
  "ja472:11.2": "rājaputta sakaṃ gharaṃ, ",
  "ja472:11.3": "rajjaṃ kārehi, bhaddan te, ",
  "ja472:11.4": "kiṃ araññe karissasi. ",
  "ja472:12.1": "Yathā gilitvā balisaṃ ",
  "ja472:12.2": "uddhareyya salohitaṃ ",
  "ja472:12.3": "uddharitvā sukhī assa ",
  "ja472:12.4": "sukhaṃ passāmi attani. ",
  "ja472:13.1": "Kin nu tvaṃ balisaṃ brūsi, ",
  "ja472:13.2": "kiṃ tvaṃ brūsi salohitaṃ, ",
  "ja472:13.3": "kin nu tvaṃ ubbhataṃ brūsi, ",
  "ja472:13.4": "tam me akkhāhi pucchito. ",
  "ja472:14.1": "Kām' āhaṃ balisaṃ brūmi, ",
  "ja472:14.2": "hatthiassaṃ salohitaṃ, ",
  "ja472:14.3": "catt' āhaṃ ubbhataṃ brūmi, ",
  "ja472:14.4": "evaṃ jānāhi khattiyāti. ",
  "ja472:15.1": "Ciñcamāṇavikā mātā ",
  "ja472:15.2": "Devadatto ca me pitā ",
  "ja472:15.3": "Ānando paṇḍito nāgo ",
  "ja472:15.4": "Sāriputto ca devatā ahaṃ tadā ",
  "ja472:15.5": "rājaputto, ",
  "ja472:15.6": "evaṃ dhāretha jātakanti ",
  "ja472:16.1": ""
}
