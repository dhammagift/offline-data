  "ja306:0.4": "",
  "ja306:1.1": "Kiṃ aṇḍakā ime deva ",
  "ja306:1.2": "nikkhittā kaṃsamallake ",
  "ja306:1.3": "upalohitakā vaggū, ",
  "ja306:1.4": "te me akkhāhi pucchitoti. ",
  "ja306:2.1": "Yāni pure tuvaṃ devi ",
  "ja306:2.2": "bhaṇḍu nantakavāsinī ",
  "ja306:2.3": "ucchaṅgahatthā pacināsi ",
  "ja306:2.4": "tassā te koliyaṃ phalaṃ. ",
  "ja306:3.1": "Uḍayhate na ramati, ",
  "ja306:3.2": "bhogā vippajahanti taṃ, ",
  "ja306:3.3": "tatth' ev' imaṃ paṭinetha ",
  "ja306:3.4": "yattha kolaṃ pacissatīti. ",
  "ja306:4.1": "Honti h' ete mahārāja ",
  "ja306:4.2": "iddhippattāya nāriyā, ",
  "ja306:4.3": "khama deva Sujātāya, ",
  "ja306:4.4": "māssā kujjhi rathesabhāti. ",
  "ja306:5.1": ""
}
