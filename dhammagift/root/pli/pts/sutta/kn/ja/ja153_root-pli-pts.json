  "ja153:1.1": "Catuppado ahaṃ samma, ",
  "ja153:1.2": "tvam pi samma catuppado; ",
  "ja153:1.3": "ehi sīha nivattassu, ",
  "ja153:1.4": "kin nu bhīto palāyasīti. ",
  "ja153:2.1": "Asūci pūtilomo si, ",
  "ja153:2.2": "duggandho vāsi sūkara; ",
  "ja153:2.3": "sace yujjhitukāmo si ",
  "ja153:2.4": "jayaṃ samma dadāmi teti. ",
  "ja153:3.1": ""
}
