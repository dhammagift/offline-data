  "ja531:1.1": "te raṭṭhaṃ sadhanaṃ sayoggaṃ ",
  "ja531:1.2": "sakāyuraṃ sabbakāmūpapannaṃ ",
  "ja531:1.3": "idan te rajjaṃ anusāsa amma, ",
  "ja531:1.4": "gacchām' ahaṃ yattha piyā Pabhāvatīti. ",
  "ja531:2.1": "Anujjubhūtena haraṃ mahantaṃ ",
  "ja531:2.2": "divā ca ratto ca nisīthakāle ",
  "ja531:2.3": "paṭigaccha tvaṃ khipaṃ Kusāvatiṃ Kusa ",
  "ja531:2.4": "na icchāmi dubbaṇṇaṃ ahaṃ vasantanti. ",
  "ja531:3.1": "Nāhaṃ gamissāmi ito Kusāvatiṃ, ",
  "ja531:3.2": "Pabhāvatī vaṇṇapalobhito tava ",
  "ja531:3.3": "ramāmi Maddassa niketaramme ",
  "ja531:3.4": "hitvāna raṭṭhaṃ tava dassane rato. ",
  "ja531:4.1": "Pabhāvatī vaṇṇapalobhito tava ",
  "ja531:4.2": "sammūḷharūpo vicarāmi mediniṃ, ",
  "ja531:4.3": "disaṃ jānāmi kuto 'mhi āgato, ",
  "ja531:4.4": "tay' amhi matto migamandalocane. ",
  "ja531:5.1": "Suvaṇṇacīravasane ",
  "ja531:5.2": "jātarūpasumekhale ",
  "ja531:5.3": "sussoṇi tava kāmāhi ",
  "ja531:5.4": "nāhaṃ rajjena-m-atthikoti. ",
  "ja531:6.1": "Abbhu hi tassa bho hoti ",
  "ja531:6.2": "yo anicchantam icchati, ",
  "ja531:6.3": "akāmaṃ rāja kāmehi akanto ",
  "ja531:6.4": "kantam icchasīti g. ā. ",
  "ja531:7.1": "Akāmaṃ vā sakāmaṃ vā ",
  "ja531:7.2": "yo naro labhate piyaṃ ",
  "ja531:7.3": "lābham ettha pasaṃsāma ",
  "ja531:7.4": "alābho tattha pāpakoti. ",
  "ja531:8.1": "Pāsāṇasāraṃ khaṇasi ",
  "ja531:8.2": "kaṇikārassa dārunā ",
  "ja531:8.3": "vātaṃ jālena bādhesi ",
  "ja531:8.4": "yo anicchantam icchasīti. ",
  "ja531:9.1": "Pāsāṇo nūna te hadaye ",
  "ja531:9.2": "ohito mudulakkhaṇe, ",
  "ja531:9.3": "yo te sātaṃ na vindāmi ",
  "ja531:9.4": "tiro janapadaṃ gato. ",
  "ja531:10.1": "Yadā maṃ bhūkuṭiṃ katvā ",
  "ja531:10.2": "rājaputti udikkhasi ",
  "ja531:10.3": "āḷāriko tadā homi ",
  "ja531:10.4": "rañño Maddassa thīpure. ",
  "ja531:11.1": "Yadā umhayamānā maṃ ",
  "ja531:11.2": "rājaputti udikkhasi ",
  "ja531:11.3": "nāḷāriko tadā homi ",
  "ja531:11.4": "rājā homi tadā Kusoti. ",
  "ja531:12.1": "Sace hi vacanaṃ saccaṃ ",
  "ja531:12.2": "nemittānaṃ bhavissati ",
  "ja531:12.3": "n' eva me tvaṃ pati assa ",
  "ja531:12.4": "kāmaṃ chindantu sattadhāti. ",
  "ja531:13.1": "Sace hi vacanaṃ saccaṃ ",
  "ja531:13.2": "aññesaṃ yadi vā mamaṃ ",
  "ja531:13.3": "na c' eva te pati atthi ",
  "ja531:13.4": "añño sīhassarā Kusāti. ",
  "ja531:14.1": "Nekkhaṃ gīvan te kāressaṃ ",
  "ja531:14.2": "patvā khujje Kusāvatiṃ ",
  "ja531:14.3": "sace maṃ nāganāsūru ",
  "ja531:14.4": "olokeyya Pabhāvatī. ",
  "ja531:15.1": "Nekkhaṃ gīvan te kāressaṃ ",
  "ja531:15.2": "--pe-- ",
  "ja531:15.3": "",
  "ja531:15.4": "ālapeyya Pabhāvatī. ",
  "ja531:16.1": "Nekkhaṃ gīvan te kāressaṃ ",
  "ja531:16.2": "--pe-- ",
  "ja531:16.3": "umhāpeyya ",
  "ja531:16.4": "Pabhāvatī. ",
  "ja531:17.1": "Nekkhaṃ gīvan te kāressaṃ ",
  "ja531:17.2": "--pe-- ",
  "ja531:17.3": "pamhāpeyya ",
  "ja531:17.4": "Pabhāvatī. ",
  "ja531:18.1": "Nekkhaṃ gīvan te kāressaṃ ",
  "ja531:18.2": "patvā khujje Kusāvatiṃ ",
  "ja531:18.3": "sace maṃ nāganāsūru ",
  "ja531:18.4": "pāṇihi upasamphaseti. ",
  "ja531:19.1": "Na hi nūnāyaṃ rājaputtī ",
  "ja531:19.2": "Kuse sātam pi vindati ",
  "ja531:19.3": "āḷārike bhate pose ",
  "ja531:19.4": "vetanena anatthiketi g. ā. ",
  "ja531:20.1": "Na hi nūnāyaṃ sā khujjā ",
  "ja531:20.2": "labhati jivhāya chedanaṃ ",
  "ja531:20.3": "sunisitena satthena ",
  "ja531:20.4": "evaṃ dubbhāsitaṃ bhaṇanti. ",
  "ja531:21.1": "Mā naṃ rūpena pāmesi ",
  "ja531:21.2": "ārohena Pabhāvati, ",
  "ja531:21.3": "mahāyasoti katvāna ",
  "ja531:21.4": "karassu rucire piyaṃ. ",
  "ja531:22.1": "Mā naṃ rūpena pāmesi ",
  "ja531:22.2": "ārohena Pabhāvati, ",
  "ja531:22.3": "mahaddhanoti katvāna ",
  "ja531:22.4": "--pe-- ",
  "ja531:23.1": "Mā -- ",
  "ja531:23.2": "",
  "ja531:23.3": "mahabbaloti katvāna ",
  "ja531:23.4": "--pe-- ",
  "ja531:24.1": "Mā -- ",
  "ja531:24.2": "",
  "ja531:24.3": "mahāraṭṭhoti katvāna ",
  "ja531:24.4": "--pe-- ",
  "ja531:25.1": "Mā -- ",
  "ja531:25.2": "",
  "ja531:25.3": "mahārājāti katvāna ",
  "ja531:25.4": "--pe-- ",
  "ja531:26.1": "Mā -- ",
  "ja531:26.2": "",
  "ja531:26.3": "sīhassaroti katvāna ",
  "ja531:26.4": "--pe-- ",
  "ja531:27.1": "Mā -- ",
  "ja531:27.2": "",
  "ja531:27.3": "vaggussaroti katvāna ",
  "ja531:27.4": "--pe-- || Ja_XX:27 || ",
  "ja531:28.1": "Mā -- ",
  "ja531:28.2": "",
  "ja531:28.3": "bindussaroti katvāna ",
  "ja531:28.4": "--pe-- ",
  "ja531:29.1": "Mā -- ",
  "ja531:29.2": "",
  "ja531:29.3": "mañjussaroti katvāna ",
  "ja531:29.4": "--pe-- ",
  "ja531:30.1": "Mā -- ",
  "ja531:30.2": "",
  "ja531:30.3": "madhussaroti katvāna ",
  "ja531:30.4": "--pe-- ",
  "ja531:31.1": "Mā -- ",
  "ja531:31.2": "",
  "ja531:31.3": "satasippoti katvāna ",
  "ja531:31.4": "--pe-- ",
  "ja531:32.1": "Mā -- ",
  "ja531:32.2": "",
  "ja531:32.3": "khattiyoti pi katvāna ",
  "ja531:32.4": "--pe-- ",
  "ja531:33.1": "Mā naṃ rūpena pāmesi ",
  "ja531:33.2": "ārohena Pabhāvati, ",
  "ja531:33.3": "Kusarājāti katvāna ",
  "ja531:33.4": "karassu rucire piyanti. ",
  "ja531:34.1": "Ete nāgā upatthaddhā ",
  "ja531:34.2": "sabbe tiṭṭhanti vammitā, ",
  "ja531:34.3": "purā maddanti pākāraṃ ",
  "ja531:34.4": "ānent' etaṃ Pabhāvatinti ",
  "ja531:35.1": "Satta khaṇḍe karitvāna ",
  "ja531:35.2": "aham etaṃ Pabhāvatiṃ ",
  "ja531:35.3": "khattiyānaṃ padassāmi ",
  "ja531:35.4": "ye maṃ hantum idhāgatāti. ",
  "ja531:36.1": "Apuṭṭhahi rājaputtī ",
  "ja531:36.2": "sāmā koseyyavāsinī ",
  "ja531:36.3": "assupuṇṇehi nettehi ",
  "ja531:36.4": "dāsigaṇapurakkhatāti. ",
  "ja531:37.1": "Tan nūna kakkūpanisevitaṃ mukhaṃ ",
  "ja531:37.2": "ādāsadantātharupaccavekkhitaṃ ",
  "ja531:37.3": "subhaṃ sunettaṃ virajaṃ anaṅgaṇaṃ ",
  "ja531:37.4": "chuddhaṃ vane ṭhassati khattiyehi. ",
  "ja531:38.1": "Te nūna me asite vellitagge ",
  "ja531:38.2": "kese mudū candanasāralitte ",
  "ja531:38.3": "samākule sīvathikāya majjhe ",
  "ja531:38.4": "pādehi gijjhā parikaḍḍhayanti. ",
  "ja531:39.1": "Tā nūna me tambanakhā sulomā ",
  "ja531:39.2": "bāhā mudū candanasāralittā ",
  "ja531:39.3": "chinnā vane ujjhitā khattiyehi ",
  "ja531:39.4": "gayha vako gacchati yenakāmaṃ ",
  "ja531:40.1": "Te nūna tālūpanibhe alambe ",
  "ja531:40.2": "nisevite kāsikacandanena ",
  "ja531:40.3": "thanesu me lambahīti sigālo ",
  "ja531:40.4": "mātū va putto taruṇo tanūjo. ",
  "ja531:41.1": "Tan nūna soṇiṃ puthulaṃ sukoṭṭhitaṃ ",
  "ja531:41.2": "nisevitaṃ kañcanamekhalāhi ",
  "ja531:41.3": "chinnaṃ vane khattiyehi avatthaṃ ",
  "ja531:41.4": "gayhā vako gacchati yenakāmaṃ ",
  "ja531:42.1": "Soṇā vakā sigālā ca ",
  "ja531:42.2": "ye c' aññe santi dāṭhino ",
  "ja531:42.3": "ajarā nūna hessanti ",
  "ja531:42.4": "bhakkhayitvā Pabhāvatiṃ. ",
  "ja531:43.1": "Sace maṃsā harīyiṃsu ",
  "ja531:43.2": "khattiyā dūragāmino ",
  "ja531:43.3": "aṭṭhīni amma yācitvā ",
  "ja531:43.4": "anupathe dahātha naṃ ",
  "ja531:44.1": "Khettāni amma kāretvā ",
  "ja531:44.2": "kaṇikār' ettha ropaya, ",
  "ja531:44.3": "yadā te pupphitā assu ",
  "ja531:44.4": "hemantānaṃ himaccaye ",
  "ja531:44.5": "sareyyātha mama amma: ",
  "ja531:44.6": "evaṃvaṇṇā Pabhāvatīti. ",
  "ja531:45.1": "Tassā mātā udaṭṭhāsi ",
  "ja531:45.2": "khattiyā devavaṇṇinī ",
  "ja531:45.3": "disvā asiñ ca sūṇañ ca ",
  "ja531:45.4": "rañño Maddassa thīpureti. ",
  "ja531:46.1": "Iminā nūna asinā ",
  "ja531:46.2": "susaññaṃ tanumajjhimaṃ ",
  "ja531:46.3": "dhītaraṃ Maddo hantvāna ",
  "ja531:46.4": "khattiyānaṃ padassatīti g. ā. ",
  "ja531:47.1": "Na me akāsi vacanaṃ ",
  "ja531:47.2": "atthakāmāya puttaki, ",
  "ja531:47.3": "sājja lohitasañchannā ",
  "ja531:47.4": "gañchisi Yamasādanaṃ. ",
  "ja531:48.1": "Evam āpajjatī poso ",
  "ja531:48.2": "pāpiyañ ca nigacchati (III 323|24) ",
  "ja531:48.3": "yo ve hitānaṃ vacanaṃ ",
  "ja531:48.4": "na karoti atthadassinaṃ. ",
  "ja531:49.1": "Sace tvaṃ ajja vāresi ",
  "ja531:49.2": "kumāraṃ cārudassanaṃ ",
  "ja531:49.3": "Kusena jātaṃ khattiyaṃ ",
  "ja531:49.4": "suvaṇṇamaṇimekhalaṃ ",
  "ja531:49.5": "pūjitā ñātisaṃghehi ",
  "ja531:49.6": "na gañchisi Yamakkhayaṃ. ",
  "ja531:50.1": "Yatth' assu bheri nadati ",
  "ja531:50.2": "kuñjaro ca nikuñjati ",
  "ja531:50.3": "khattiyānaṃ kule bhadde, ",
  "ja531:50.4": "kin nu sukhataraṃ tato. ",
  "ja531:51.1": "Asso ca siṃsati dvāre ",
  "ja531:51.2": "kumāro c' uparodati ",
  "ja531:51.3": "khattiyānaṃ kule bhadde, ",
  "ja531:51.4": "kin nu sukhataraṃ tato. ",
  "ja531:52.1": "Mayūrakoñcābhirude ",
  "ja531:52.2": "kokilābhinikuñjite ",
  "ja531:52.3": "etc. Kahan ",
  "ja531:52.4": "nu sattudamano ",
  "ja531:53.1": "",
  "ja531:53.2": "pararaṭṭhappamaddano ",
  "ja531:53.3": "Kuso soḷārapaññāṇo, ",
  "ja531:53.4": "so no dukkhā pamocayeti g. ā. ",
  "ja531:54.1": "Idh' eva no sattudamano ",
  "ja531:54.2": "pararaṭṭhappamaddano ",
  "ja531:54.3": "Kuso soḷārapaññāṇo, ",
  "ja531:54.4": "so no sabbe vadhissatīti g. ā. ",
  "ja531:55.1": "Ummattikā nu bhaṇasi ",
  "ja531:55.2": "ādu bālā va bhāsasi, ",
  "ja531:55.3": "Kuso ce āgato assa ",
  "ja531:55.4": "kiṃ na jānemu taṃ mayanti g. ā. ",
  "ja531:56.1": "Eso āḷāriko poso ",
  "ja531:56.2": "kumārīpuramantare ",
  "ja531:56.3": "daḷhaṃ katvāna saṃvelliṃ ",
  "ja531:56.4": "kumbhī dhovati onatoti g. ",
  "ja531:57.1": "Veṇī tvam asi caṇḍālī ",
  "ja531:57.2": "adū si kulagatthinī, ",
  "ja531:57.3": "kathaṃ Maddakule jātā ",
  "ja531:57.4": "dāsaṃ kayirāsi kāmukanti g. ā. ",
  "ja531:58.1": "N' amhi veṇī na caṇḍālī, ",
  "ja531:58.2": "na c' amhi kulagatthinī, ",
  "ja531:58.3": "Okkākaputto bhaddan te ",
  "ja531:58.4": "tvaṃ nu dāsoti maññasīti. ",
  "ja531:59.1": "Yo brāhmaṇasahassāni ",
  "ja531:59.2": "sadā bhojeti vīsatiṃ ",
  "ja531:59.3": "Okkākaputto bhaddan te ",
  "ja531:59.4": "tvaṃ nu dāsoti maññasi. ",
  "ja531:60.1": "Yassa nāgasahassāni ",
  "ja531:60.2": "sadā yojenti vīsatiṃ ",
  "ja531:60.3": "Okkākaputto bhaddan te ",
  "ja531:60.4": "tvaṃ nu dāsoti maññasi. ",
  "ja531:61.1": "Yassa assasahassāni ",
  "ja531:61.2": "sadā yojenti vīsatiṃ ",
  "ja531:61.3": "etc. ",
  "ja531:61.4": "",
  "ja531:62.1": "Yassa rathasahassāni ",
  "ja531:62.2": "sadā yojenti vīsatiṃ ",
  "ja531:62.3": "etc. ",
  "ja531:62.4": "",
  "ja531:63.1": "Yassa usabhasahassāni ",
  "ja531:63.2": "sadā yojenti vīsatiṃ ",
  "ja531:63.3": "etc. ",
  "ja531:63.4": "",
  "ja531:64.1": "Yassa dhenusahassāni ",
  "ja531:64.2": "sadā duyhanti ",
  "ja531:64.3": "vīsati ",
  "ja531:64.4": "etc. ",
  "ja531:65.1": "Taggha te dukkataṃ bāle ",
  "ja531:65.2": "yaṃ khattiyaṃ mahabbalaṃ ",
  "ja531:65.3": "nāgaṃ maṇḍūkavaṇṇena ",
  "ja531:65.4": "na taṃ akkhās' idhāgatanti g. ā. ",
  "ja531:66.1": "Aparādhaṃ mahārāja ",
  "ja531:66.2": "tvaṃ no khama rathesabha ",
  "ja531:66.3": "yaṃ taṃ aññātavesena ",
  "ja531:66.4": "na ñāsimhā idhāgatanti g. ā. ",
  "ja531:67.1": "Mādisassa na taṃ channaṃ ",
  "ja531:67.2": "yo 'haṃ āḷāriko bhave, ",
  "ja531:67.3": "tvañ ñeva me pasīdassu, ",
  "ja531:67.4": "n' atthi te deva dukkatanti g. ā. ",
  "ja531:68.1": "Gaccha bāle khamāpehi ",
  "ja531:68.2": "Kusarājaṃ mahabbalaṃ, ",
  "ja531:68.3": "khamāpito Kusarājā ",
  "ja531:68.4": "so te dassati jīvitanti g. ā. ",
  "ja531:69.1": "Pitussa vacanaṃ sutvā ",
  "ja531:69.2": "devavaṇṇī Pabhāvatī ",
  "ja531:69.3": "sirasā aggahi pāde ",
  "ja531:69.4": "Kusarājaṃ mahabbalanti g. ",
  "ja531:70.1": "ā. Yā imā ratyā atikkantā ",
  "ja531:70.2": "imā deva tayā vinā, ",
  "ja531:70.3": "vande te sirasā pāde, ",
  "ja531:70.4": "mā me kujjhi rathesabha. ",
  "ja531:71.1": "Saccaṃ te paṭijānāmi, ",
  "ja531:71.2": "mahārāja suṇohi me, ",
  "ja531:71.3": "na cāpi appiyaṃ tuyhaṃ ",
  "ja531:71.4": "kareyyāmi ahaṃ puna. ",
  "ja531:72.1": "Evañ ca yācamānāya ",
  "ja531:72.2": "vacanaṃ me na kāhasi ",
  "ja531:72.3": "idāni maṃ tato hantvā ",
  "ja531:72.4": "khattiyānaṃ padassatīti. ",
  "ja531:73.1": "Evaṃ te yācamānāya ",
  "ja531:73.2": "kiṃ na kāhāmi te vaco, ",
  "ja531:73.3": "vikuddho ty-asmi kalyāṇi, ",
  "ja531:73.4": "mā tvaṃ bhāyi Pabhāvati. ",
  "ja531:74.1": "Saccaṃ te paṭijānāmi ",
  "ja531:74.2": "rājaputti suṇohi me: ",
  "ja531:74.3": "na cāpi appiyaṃ tuyhaṃ ",
  "ja531:74.4": "kareyyāmi ahaṃ puna. ",
  "ja531:75.1": "Tava kāmāhi sussoṇi ",
  "ja531:75.2": "bahuṃ dukkhaṃ titikkhissaṃ ",
  "ja531:75.3": "bahū Maddakule hantvā ",
  "ja531:75.4": "nayituṃ taṃ Pabhāvatīti. ",
  "ja531:76.1": "Yojayantu rathe asse ",
  "ja531:76.2": "nānācitre samāhite, ",
  "ja531:76.3": "atha dakkhatha me vegaṃ ",
  "ja531:76.4": "vidhamentassa sattavoti. ",
  "ja531:77.1": "Tañ ca tattha udikkhiṃsu ",
  "ja531:77.2": "rañño Maddassa thīpure ",
  "ja531:77.3": "vijambhamānaṃ sīhaṃ va ",
  "ja531:77.4": "pothentaṃ diguṇaṃ bhūjanti. ",
  "ja531:78.1": "Hatthikkhandhañ ca āruyha ",
  "ja531:78.2": "āropetvā Pabhāvatiṃ ",
  "ja531:78.3": "saṅgāmaṃ otaritvāna ",
  "ja531:78.4": "sīhanādaṃ nadī Kuso. ",
  "ja531:79.1": "Tassa taṃ nadato sutvā ",
  "ja531:79.2": "sīhassev' itare migā ",
  "ja531:79.3": "khattiyāpi palāyiṃsu ",
  "ja531:79.4": "Kusasaddabhayaṭṭhitā. ",
  "ja531:80.1": "Hatthāruhā anīkaṭṭhā ",
  "ja531:80.2": "rathikā pattikārikā ",
  "ja531:80.3": "aññamaññassa khundanti ",
  "ja531:80.4": "Kusasaddabhayaṭṭhitā. ",
  "ja531:81.1": "Tasmiṃ saṅgāmasīsasmiṃ ",
  "ja531:81.2": "passitvā haṭṭhamānaso ",
  "ja531:81.3": "Kusassa rañño devindo ",
  "ja531:81.4": "adā Verocanaṃ maṇiṃ ",
  "ja531:82.1": "So taṃ vijitvā saṅgāmaṃ ",
  "ja531:82.2": "laddhā verocannaṃ maṇiṃ ",
  "ja531:82.3": "hatthikkhandhagato rājā ",
  "ja531:82.4": "pāvekkhi Nagaraṃ puraṃ. ",
  "ja531:83.1": "Jīvagāhaṃ gahetvāna ",
  "ja531:83.2": "bandhitvā sattukhattiye ",
  "ja531:83.3": "sasurass' upanāmesi: ",
  "ja531:83.4": "ime te deva sattavo. ",
  "ja531:84.1": "Sabbe va te vasaṃ gatā ",
  "ja531:84.2": "amittā vihatā tava, ",
  "ja531:84.3": "kāmaṃ karohi te tayā, ",
  "ja531:84.4": "muñca vā te hanassu vāti. ",
  "ja531:85.1": "Tuyh' eva sattavo ete, ",
  "ja531:85.2": "na h' ete mayhaṃ sattavo, ",
  "ja531:85.3": "tvañ ñeva no mahārājā, ",
  "ja531:85.4": "muñca vā te hannasu vāti. ",
  "ja531:86.1": "Imā te dhītaro satta ",
  "ja531:86.2": "devakaññāsmā subhā, ",
  "ja531:86.3": "dadāhi tesaṃ ekekaṃ, ",
  "ja531:86.4": "hontu jāmātaro tavanti g. ā. ",
  "ja531:87.1": "Amhākañ c' eva tāsañ ca ",
  "ja531:87.2": "tvaṃ no sabbesam issaro, ",
  "ja531:87.3": "tvañ ñeva no mahārājā, ",
  "ja531:87.4": "dehi nesaṃ yad icchasīti. ",
  "ja531:88.1": "Ekamekassa ekekaṃ ",
  "ja531:88.2": "adā sīhassaro Kuso ",
  "ja531:88.3": "khattiyānaṃ tadā tesaṃ ",
  "ja531:88.4": "rañño Maddassa dhītaro. ",
  "ja531:89.1": "Pīṇitā tena lābhena ",
  "ja531:89.2": "tuṭṭhā sīhassare Kuse ",
  "ja531:89.3": "sakaraṭṭhāni pāyiṃsu ",
  "ja531:89.4": "khattiyā satta tāvade. ",
  "ja531:90.1": "Pabhāvatiñ ca ādāya ",
  "ja531:90.2": "maniṃ Verocanaṃ tadā ",
  "ja531:90.3": "Kusāvatiṃ Kuso rājā ",
  "ja531:90.4": "agamāsi mahabbalo. ",
  "ja531:91.1": "Ty-assu ekarathe yantā ",
  "ja531:91.2": "pavisantā Kusāvatiṃ ",
  "ja531:91.3": "samānavaṇṇarūpena ",
  "ja531:91.4": "n' aññamaññātirocisuṃ. ",
  "ja531:92.1": "Mātā puttena saṃgañchi, ",
  "ja531:92.2": "ubhayo ca jayampatī ",
  "ja531:92.3": "samaggā te tadā āsuṃ, ",
  "ja531:92.4": "phītaṃ dharaṇim āvasunti. ",
  "ja531:93.1": ""
}
