  "ja299:0.4": "",
  "ja299:1.1": "Pure tuvaṃ sīlavataṃ sakāse ",
  "ja299:1.2": "okkandikaṃ kīḷasi assamamhi, ",
  "ja299:1.3": "karoh' are makkaṭiyāni makkaṭa, ",
  "ja299:1.4": "na taṃ mayaṃ sīlavataṃ ramāmāti. ",
  "ja299:2.1": "Sutā hi mayhaṃ paramā visuddhi ",
  "ja299:2.2": "Komāyaputtassa bahussutassa, ",
  "ja299:2.3": "mā dāni maṃ maññi tuvaṃ yathā pure, ",
  "ja299:2.4": "jhānāniyuttā viharāma āvusoti. ",
  "ja299:3.1": "Sace pi selasmiṃ vapeyyu bījaṃ ",
  "ja299:3.2": "devo ca vasse n' eva hi taṃ ruheyya, ",
  "ja299:3.3": "sutā hi tayā paramā visuddhi, ",
  "ja299:3.4": "ārā tuvaṃ makkaṭa jhānabhūmiyāti. ",
  "ja299:4.1": ""
}
