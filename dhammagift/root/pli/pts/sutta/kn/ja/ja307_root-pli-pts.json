  "ja307:0.4": "",
  "ja307:1.1": "Acetanaṃ brāhmaṇa assuṇantaṃ (cfr. Milinda p. 172) ",
  "ja307:1.2": "jāno ajānantam imaṃ palāsaṃ ",
  "ja307:1.3": "āraddhaviriyo dhuvaṃ appamatto ",
  "ja307:1.4": "sukhaseyyaṃ pucchasi kissa hetūti. ",
  "ja307:2.1": "Dūre suto c' eva brahā ca rukkho ",
  "ja307:2.2": "dese ṭhito bhūtanivāsarūpo, ",
  "ja307:2.3": "tasmā namassāmi imaṃ palāsaṃ ",
  "ja307:2.4": "ye c' ettha bhūtā te ca dhanassa hetūti. ",
  "ja307:3.1": "So te karissāmi yathānubhāvaṃ ",
  "ja307:3.2": "kataññutaṃ brāhmaṇa pekkhamāno, ",
  "ja307:3.3": "kathaṃ hi āgamma sataṃ sakāse ",
  "ja307:3.4": "moghā te assu pariphanditāni. ",
  "ja307:4.1": "Yo tindurukkhassa paro pilakkhu ",
  "ja307:4.2": "parivārito pubbayañño uḷāro ",
  "ja307:4.3": "tass' esa mūlasmiṃ nidhī nikhāto ",
  "ja307:4.4": "adāyādo, gaccha, taṃ uddharāhīti. Akaramhase ",
  "ja307:5.1": ""
}
