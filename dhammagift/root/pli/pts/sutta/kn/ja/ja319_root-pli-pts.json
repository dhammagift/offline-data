  "ja319:0.4": "",
  "ja319:1.1": "Susukhaṃ vata jīvāmi, ",
  "ja319:1.2": "labhāmi c' eva bhuñjituṃ ",
  "ja319:1.3": "paripanthe ca tiṭṭhāmi, ",
  "ja319:1.4": "kā su bhante gatī mamanti. ",
  "ja319:2.1": "Mano ce te na-ppaṇamati ",
  "ja319:2.2": "pakkhi pāpassa kammuno ",
  "ja319:2.3": "avyāvaṭassa bhadrassa ",
  "ja319:2.4": "na pāpam upalippatīti. ",
  "ja319:3.1": "Ñātako no nisinnoti ",
  "ja319:3.2": "bahu āgacchate jano, ",
  "ja319:3.3": "paṭiccakammaṃ phusati, ",
  "ja319:3.4": "tasmim me saṃkate manoti. Paṭiccakammaṃ ",
  "ja319:4.1": "na phusati ",
  "ja319:4.2": "mano ce na-ppadussati, ",
  "ja319:4.3": "appossukkassa bhadrassa ",
  "ja319:4.4": "na pāpam upalippatīti. ",
  "ja319:5.1": ""
}
