  "ja281:1.1": "nāma dumo ",
  "ja281:1.2": "yassa dibbam idaṃ phalaṃ ",
  "ja281:1.3": "bhutvā dohaḷinī nārī ",
  "ja281:1.4": "cakkavattiṃ vijāyati. ",
  "ja281:2.1": "Tvañ ca bhadde mahesī si ",
  "ja281:2.2": "sā cāsi patino piyā, ",
  "ja281:2.3": "āharissati te rājā ",
  "ja281:2.4": "idaṃ abbhantaraṃ phalanti. ",
  "ja281:3.1": "Bhattur atthe parakkanto ",
  "ja281:3.2": "yaṃ ṭhānam adhigacchati ",
  "ja281:3.3": "sūro attapariccāgī ",
  "ja281:3.4": "labhamāno bhavām' ahanti. ",
  "ja281:4.1": ""
}
