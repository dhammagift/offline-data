  "ja355:0.3": "",
  "ja355:0.4": "",
  "ja355:1.1": "Aññe socanti rodanti, ",
  "ja355:1.2": "añño assumukho jano, ",
  "ja355:1.3": "pasannamukhavaṇṇo si, ",
  "ja355:1.4": "kasmā Ghata na socasīti. ",
  "ja355:2.1": "Nābbhatītaharo soko ",
  "ja355:2.2": "nānāgatasukhāvaho, ",
  "ja355:2.3": "tasmā Vaṃka na socāmi, ",
  "ja355:2.4": "n' atthi soke dutiyyatā. ",
  "ja355:3.1": "Socaṃ paṇḍukisīhoti, ",
  "ja355:3.2": "bhattañ c' assa na ruccati, ",
  "ja355:3.3": "amittā sumanā honti ",
  "ja355:3.4": "sallaviddhassa ruppato. ",
  "ja355:4.1": "Gāme vā yadi vāraññe ",
  "ja355:4.2": "ninne vā yadi vā thale ",
  "ja355:4.3": "(Dhp.v. 98,121.) na man taṃ āgamissati, ",
  "ja355:4.4": "evaṃ diṭṭhapado ahaṃ. ",
  "ja355:5.1": "Yass' attā nālam eko ",
  "ja355:5.2": "sabbakāmarasāharo ",
  "ja355:5.3": "sabbāpi paṭhavī tassa ",
  "ja355:5.4": "na sukhaṃ āvahissatīti. ",
  "ja355:6.1": ""
}
