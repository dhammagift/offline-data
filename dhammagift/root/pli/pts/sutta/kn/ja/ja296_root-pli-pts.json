  "ja296:1.1": "Ko n' āyaṃ loṇatoyasmiṃ ",
  "ja296:1.2": "samantā paridhāvati, ",
  "ja296:1.3": "macche makare ca vāreti ",
  "ja296:1.4": "ūmīsu ca vihaññatīti. ",
  "ja296:2.1": "Anantapāyī sakuṇo ",
  "ja296:2.2": "atitto tidisāsuto ",
  "ja296:2.3": "samuddaṃ pātum icchāmi ",
  "ja296:2.4": "sāgaraṃ saritaṃ patinti. ",
  "ja296:3.1": "So ayaṃ hāyati c' eva ",
  "ja296:3.2": "pūrat' eva mahodadhi, ",
  "ja296:3.3": "nāssa nāyati pītatto, ",
  "ja296:3.4": "apeyyo kira sāgaroti. ",
  "ja296:4.1": ""
}
