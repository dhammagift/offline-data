  "ja525:1.1": "Āmantayāmi nigamaṃ ",
  "ja525:1.2": "mittāmacce parīsaje: ",
  "ja525:1.3": "sirasmiṃ phalitaṃ jātaṃ, ",
  "ja525:1.4": "pabbajjaṃ dāni roc' ahanti. ",
  "ja525:2.1": "Abhumme kathan nu bhaṇasi ",
  "ja525:2.2": "sallam me deva urasi kampesi, ",
  "ja525:2.3": "sattasatā te bhariyā ",
  "ja525:2.4": "kathan nu te tā bhavissantīti g. ā. ",
  "ja525:3.1": "Paññāyihinti etā, ",
  "ja525:3.2": "daharā, aññam pi tā gamissanti, ",
  "ja525:3.3": "saggañ ca patthayāno ",
  "ja525:3.4": "tena-m-ahaṃ pabbajissāmīti. ",
  "ja525:4.1": "Dulladdham me āsi Sutasoma ",
  "ja525:4.2": "yassa te ahaṃ mātā ",
  "ja525:4.3": "yaṃ me vilapantiyā ",
  "ja525:4.4": "anapekho pabbajasi deva. ",
  "ja525:5.1": "Dulladdham me āsi Sutasoma ",
  "ja525:5.2": "yaṃ taṃ ahaṃ vijāyissam ",
  "ja525:5.3": "yaṃ me vilapantiyā ",
  "ja525:5.4": "anapekho pabbajasi deva. ",
  "ja525:6.1": "Ko nām' eso dhammo ",
  "ja525:6.2": "Sutasoma kā nāma pabbajjā ",
  "ja525:6.3": "yaṃ no amhe jiṇṇe ",
  "ja525:6.4": "anapekho pabbajasi devāti. ",
  "ja525:7.1": "Puttāpi tuyhaṃ bahavo ",
  "ja525:7.2": "daharā appattayobbanā, ",
  "ja525:7.3": "mañjū te taṃ apassantā ",
  "ja525:7.4": "maññe dukkhaṃ nigacchantīti. ",
  "ja525:8.1": "Puttehi ca me etehi ",
  "ja525:8.2": "daharehi appattayobbanehi ",
  "ja525:8.3": "mañjūhi sabbehi pi tumhehi ",
  "ja525:8.4": "ciram pi katvā vinābhāvoti. ",
  "ja525:9.1": "Chinnaṃ nu tuyhaṃ hadayaṃ ",
  "ja525:9.2": "ādu karuṇā ca n' atthi amhesu ",
  "ja525:9.3": "yaṃ no pi kandantiyo ",
  "ja525:9.4": "anapekho pabbajasi devāti g. ā. ",
  "ja525:10.1": "Na ca mayhaṃ chinnaṃ hadayaṃ ",
  "ja525:10.2": "atthi karuṇāpi mayhaṃ tumhesu, ",
  "ja525:10.3": "saggañ ca patthayāno ",
  "ja525:10.4": "tena-m-ahaṃ pabbajissāmīti. ",
  "ja525:11.1": "Dulladdham me āsi ",
  "ja525:11.2": "Sutasoma yassa te ahaṃ bhariyā ",
  "ja525:11.3": "yam me vilapantiyā ",
  "ja525:11.4": "anapekho pabbajasi deva. ",
  "ja525:12.1": "Dulladdham me āsi ",
  "ja525:12.2": "Sutasoma yassa te ahaṃ bhariyā ",
  "ja525:12.3": "yam maṃ kucchimatiṃ santiṃ ",
  "ja525:12.4": "anapekho pabbajasi deva. ",
  "ja525:13.1": "Paripakko me gabbho ",
  "ja525:13.2": "kucchigato, yāva naṃ vijāyāmi ",
  "ja525:13.3": "māhaṃ ekā vidhavā ",
  "ja525:13.4": "pacchā dukkhāni addakkhinti. ",
  "ja525:14.1": "Paripakko te gabbho ",
  "ja525:14.2": "kucchigato, iṃgha naṃ vijāyassu ",
  "ja525:14.3": "",
  "ja525:14.4": "",
  "ja525:15.1": "Mā tvaṃ Cande rudi ",
  "ja525:15.2": "mā soci vanatimiramattakkhi, (IV 285|24) ",
  "ja525:15.3": "āroha ca pāsādaṃ, ",
  "ja525:15.4": "anapekho ahaṃ gamissāmīti g. ā. ",
  "ja525:16.1": "Ko taṃ amma kopesi, ",
  "ja525:16.2": "kim rodasi pekkhasi ca maṃ bāḷhaṃ, ",
  "ja525:16.3": "ghātemi kaṃ avajjhaṃ ",
  "ja525:16.4": "ñātīnaṃ udikkhamānānanti g. ā. ",
  "ja525:17.1": "Na hi so sakkā hantuṃ ",
  "ja525:17.2": "Jīvitāvī yo maṃ [tātā] kopesi, ",
  "ja525:17.3": "",
  "ja525:17.4": "",
  "ja525:18.1": "Yo 'haṃ pubbe niyyāmi ",
  "ja525:18.2": "uyyānaṃ mattakuñjare ca yodhemi ",
  "ja525:18.3": "Sutasome pabbajite ",
  "ja525:18.4": "kathan nu dāni karissāmīti g. ā. ",
  "ja525:19.1": "Mātucca me rudatyā ",
  "ja525:19.2": "jeṭṭhassa ca bhātuno akāmassa ",
  "ja525:19.3": "hatthe pi te gahessaṃ, ",
  "ja525:19.4": "na hi gañchisi no akāmānanti g. ā. ",
  "ja525:20.1": "Uṭṭhehi tvaṃ dhāti, ",
  "ja525:20.2": "imaṃ kumāraṃ ramehi aññattha, ",
  "ja525:20.3": "mā me paripantham akā ",
  "ja525:20.4": "saggaṃ mama patthayānassāti g. ",
  "ja525:21.1": "ā. Yan nūn' imaṃ jaheyyaṃ pabhaṃkaraṃ, ",
  "ja525:21.2": "ko nu me n' attho, ",
  "ja525:21.3": "Sutasome pabbajite ",
  "ja525:21.4": "kin nu me naṃ karissāmīti g. ā. ",
  "ja525:22.1": "Koso ca tuyhaṃ vipulo, ",
  "ja525:22.2": "koṭṭhāgārañ ca tuyhaṃ paripūraṃ, ",
  "ja525:22.3": "paṭhavī ca tuyhaṃ vijitā, ",
  "ja525:22.4": "ramassu mā pabbaja devāti g. ā. ",
  "ja525:23.1": "Koso mayhaṃ vipulo, ",
  "ja525:23.2": "koṭṭhāgārañ ca mayhaṃ paripūraṃ, ",
  "ja525:23.3": "paṭhavī ca mayhaṃ vijitā, ",
  "ja525:23.4": "naṃ hitvā pabbajissāmīti. ",
  "ja525:24.1": "Mayham pi dhanaṃ pahūtaṃ ",
  "ja525:24.2": "saṃkhātuṃ no pi deva sakkomi, ",
  "ja525:24.3": "tan te dadāmi sabbaṃ, ",
  "ja525:24.4": "ramassu mā pabbaja devāti. ",
  "ja525:25.1": "Jānāmi dhanaṃ pahūtaṃ ",
  "ja525:25.2": "Kulavaddhana pūjito tayā c' asmi, ",
  "ja525:25.3": "saggañ ca patthayāno ",
  "ja525:25.4": "tena ahaṃ pabbajissāmīti. ",
  "ja525:26.1": "Ukkaṇṭhito smi bāḷhaṃ, ",
  "ja525:26.2": "arati maṃ Somadatta āvisati, ",
  "ja525:26.3": "bahukāpi antarāyā, ",
  "ja525:26.4": "ajj' ev' ahaṃ pabbajissāmīti g. ā. ",
  "ja525:27.1": "Idañ ca tuyhaṃ rucitaṃ ",
  "ja525:27.2": "Sutasoma ajj' evā dāni tvaṃ pabbaja, ",
  "ja525:27.3": "aham pi pabbajissāmi, ",
  "ja525:27.4": "na ussahe tayā vinā ahaṃ ṭhātunti. ",
  "ja525:28.1": "Na hi sakkā pabbajituṃ, ",
  "ja525:28.2": "nagare na hi paccati janapade vāti. ",
  "ja525:28.3": "Sutasome pabbajite ",
  "ja525:28.4": "kathan nu dāni karissāmāti āha. ",
  "ja525:29.1": "Upanīyat' idaṃ maññe (IV 284|9) ",
  "ja525:29.2": "parittaṃ udakaṃ va caṃgavāramhi, ",
  "ja525:29.3": "evaṃ suparittake jīvite ",
  "ja525:29.4": "na-ppamajjitukālo. ",
  "ja525:30.1": "Upanīyat' idaṃ maññe ",
  "ja525:30.2": "parittaṃ udakaṃ va caṃgavāramhi, ",
  "ja525:30.3": "evaṃ suparittake jīvite ",
  "ja525:30.4": "atha bālā pamajjanti. ",
  "ja525:31.1": "Te vaḍḍhayanti nirayaṃ ",
  "ja525:31.2": "tiracchānayoniñ ca pettivisayañ ca, ",
  "ja525:31.3": "taṇhābandhanabaddhā ",
  "ja525:31.4": "vaḍḍhenti asurakāyanti āha. ",
  "ja525:32.1": "Ūhaññate rajaggaṃ ",
  "ja525:32.2": "avidūre Pupphakamhi pāsāde, ",
  "ja525:32.3": "maññe no kesā chinnā ",
  "ja525:32.4": "yasassino dhammarājassāti g. ā. ",
  "ja525:33.1": "Ayam assa pāsādo ",
  "ja525:33.2": "suvaṇṇo pupphamalyavītikiṇṇo yamhi- ",
  "ja525:33.3": "m-anuvicari rājā ",
  "ja525:33.4": "parikiṇṇo itthāgārehi. ",
  "ja525:34.1": "Ayam assa pāsādo ",
  "ja525:34.2": "sovaṇṇo pupphamalyavītikiṇṇo yamhi- ",
  "ja525:34.3": "m-anuvicari rājā ",
  "ja525:34.4": "parikiṇṇo ñātisaṃghena. ",
  "ja525:35.1": "Idam assa kūṭāgāraṃ ",
  "ja525:35.2": "sovaṇṇaṃ pupphamalyavītikiṇṇaṃ yamhi- ",
  "ja525:35.3": "m-anuvicari rājā ",
  "ja525:35.4": "parikiṇṇo itthāgārehi. ",
  "ja525:36.1": "Idam assa kūṭāgāraṃ ",
  "ja525:36.2": "sovaṇṇaṃ pupphamalyavītikiṇṇaṃ yamhi- ",
  "ja525:36.3": "m-anuvicari rājā ",
  "ja525:36.4": "parikiṇṇo ñātisaṃghena. ",
  "ja525:37.1": "Ayam assa asokavanikā ",
  "ja525:37.2": "supupphitā sabbakālikā rammā ",
  "ja525:37.3": "yamhi-m-anuvicari rājā ",
  "ja525:37.4": "parikiṇṇo itthāgārehi. ",
  "ja525:38.1": "Ayam assa asokavanikā ",
  "ja525:38.2": "supupphitā sabbakālikā rammā ",
  "ja525:38.3": "yamhi-m-anuvicari rājā ",
  "ja525:38.4": "parikiṇṇo ñātisaṃghena. ",
  "ja525:39.1": "Idam assa uyyānaṃ ",
  "ja525:39.2": "supupphitaṃ sabbakālikaṃ rammaṃ ",
  "ja525:39.3": "",
  "ja525:39.4": "",
  "ja525:40.1": "Idam assa uyyānaṃ ",
  "ja525:40.2": "supphitaṃ sabbakālikaṃ rammaṃ ",
  "ja525:40.3": "yamhi-m-anuvicari rājā ",
  "ja525:40.4": "parikiṇṇo ñātisaṃghena. ",
  "ja525:41.1": "Idam assa kaṇikāravanaṃ ",
  "ja525:41.2": "supupphitaṃ sabbakālikaṃ rammaṃ ",
  "ja525:41.3": "yamhi-m-anuvicari rājā ",
  "ja525:41.4": "parikiṇṇo itthāgārehi. ",
  "ja525:42.1": "Idaṃ assa kaṇikāravanaṃ ",
  "ja525:42.2": "supupphitaṃ sabbakālikaṃ rammaṃ ",
  "ja525:42.3": "yamhi-m-anuvicari rājā ",
  "ja525:42.4": "parikiṇṇo ñātisaṃghena. ",
  "ja525:43.1": "Idam assa pāṭalivanaṃ ",
  "ja525:43.2": "supupphitaṃ sabbakālikaṃ rammaṃ ",
  "ja525:43.3": "yamhi-m-anuvicari rājā ",
  "ja525:43.4": "parikiṇṇo itthāgārehi. ",
  "ja525:44.1": "Idam assa pāṭalivanaṃ ",
  "ja525:44.2": "supupphitaṃ sabbakālikaṃ rammaṃ ",
  "ja525:44.3": "yamhi-m-anuvicari rājā ",
  "ja525:44.4": "parikiṇṇo ñātisaṃghena. ",
  "ja525:45.1": "Idam assa ambavanaṃ ",
  "ja525:45.2": "supupphitaṃ sabbakālikaṃ rammaṃ ",
  "ja525:45.3": "yamhi-m-anuvicari rājā ",
  "ja525:45.4": "parikiṇṇo itthāgārehi. ",
  "ja525:46.1": "Idam assa ambavanaṃ ",
  "ja525:46.2": "supupphitaṃ sabbakālikaṃ rammaṃ ",
  "ja525:46.3": "yamhi-m-anuvicari rājā ",
  "ja525:46.4": "parikiṇṇo ñātisaṃghena. ",
  "ja525:47.1": "Ayam assa pokkharaṇī ",
  "ja525:47.2": "sañchannā aṇḍajehi vītikiṇṇā ",
  "ja525:47.3": "",
  "ja525:47.4": "",
  "ja525:48.1": "Ayam assa pokkharaṇī ",
  "ja525:48.2": "sañchannā aṇḍajehi vītikiṇṇā ",
  "ja525:48.3": "yamhi-m-anuvicari rājā ",
  "ja525:48.4": "parikiṇṇo ñātisaṃghenāti ",
  "ja525:49.1": "Rājā kho pabbajito ",
  "ja525:49.2": "Sutasomo rajjaṃ imaṃ pahatvāna ",
  "ja525:49.3": "kāsāyavatthavasano ",
  "ja525:49.4": "nāgo va ekako caratīti ",
  "ja525:50.1": "Māssu pubbe ratikīḷitāni ",
  "ja525:50.2": "hasitāni anussarittho, ",
  "ja525:50.3": "mā vo kāmā haniṃsu ",
  "ja525:50.4": "rammaṃ hi Sudassanaṃ nagaraṃ. ",
  "ja525:51.1": "Mettañ ca cittañ ca bhāvetha ",
  "ja525:51.2": "appamāṇaṃ divā ca ratto ca, ",
  "ja525:51.3": "atha gañchittha devaṃ puraṃ ",
  "ja525:51.4": "āvāsaṃ puññakammānanti. ",
