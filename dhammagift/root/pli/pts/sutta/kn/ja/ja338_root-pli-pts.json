  "ja338:0.1": "",
  "ja338:0.2": "",
  "ja338:0.3": "",
  "ja338:0.4": "",
  "ja338:1.1": "Viditaṃ thusaṃ undurānaṃ, ",
  "ja338:1.2": "viditaṃ pana taṇḍulaṃ, ",
  "ja338:1.3": "thusaṃ thusaṃ vivajjetvā ",
  "ja338:1.4": "taṇḍulaṃ pana khādareti. ",
  "ja338:2.1": "Yā mantaṇā araññasmiṃ ",
  "ja338:2.2": "yā ca gāme nikaṇṇikā ",
  "ja338:2.3": "yañ c' etaṃ iti c' īti ca ",
  "ja338:2.4": "etam pi viditaṃ mayāti. ",
  "ja338:3.1": "Dhammena kira jātassa ",
  "ja338:3.2": "pitā puttassa makkaṭo ",
  "ja338:3.3": "daharass' eva santassa ",
  "ja338:3.4": "dantehi phalam acchidāti. ",
  "ja338:4.1": "Yam etaṃ parisappasi ",
  "ja338:4.2": "ajā kāṇā va sāsape ",
  "ja338:4.3": "yo p' āyaṃ heṭṭhato seti ",
  "ja338:4.4": "etam pi viditaṃ mayāti. ",
  "ja338:5.1": ""
}
