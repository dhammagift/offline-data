  "ja394:0.4": "",
  "ja394:1.1": "Paṇītaṃ bhuñjase bhattaṃ ",
  "ja394:1.2": "sappitelañ ca mātula, ",
  "ja394:1.3": "atha kena nu vaṇṇena ",
  "ja394:1.4": "kiso tvam asi vāyasāti. ",
  "ja394:2.1": "Amittamajjhe vasato ",
  "ja394:2.2": "tesu āmisam esato ",
  "ja394:2.3": "niccaṃ ubbiggahadayassa ",
  "ja394:2.4": "kuto kākassa daḷhiyaṃ. ",
  "ja394:3.1": "Niccaṃ ubbegino kākā ",
  "ja394:3.2": "vaṃkā pāpena kammunā, ",
  "ja394:3.3": "laddho piṇḍo na pīṇeti, ",
  "ja394:3.4": "kiso ten' asmi vaṭṭaka. ",
  "ja394:4.1": "Lūkhāni tiṇabījāni ",
  "ja394:4.2": "appasinehāni bhuñjasi, ",
  "ja394:4.3": "atha kena nu vaṇṇena ",
  "ja394:4.4": "thūlo tvam asi vaṭṭakāti. ",
  "ja394:5.1": "Appicchā appacintāya ",
  "ja394:5.2": "avidūragamanena ca ",
  "ja394:5.3": "laddhāladdhena yāpento ",
  "ja394:5.4": "thūlo ten' asmi vāyasa. ",
  "ja394:6.1": "Appicchassa hi posassa ",
  "ja394:6.2": "appacintisukhassa ca ",
  "ja394:6.3": "susaṃgahitapamāṇassa ",
  "ja394:6.4": "vuttī susamudānayāti ",
  "ja394:7.1": ""
}
