  "ja356:0.4": "",
  "ja356:1.1": "Eko araññe girikandarāya ",
  "ja356:1.2": "paggayha paggayha silaṃ pavecchasi ",
  "ja356:1.3": "punappunaṃ santaramānarūpo, ",
  "ja356:1.4": "Kāraṇḍiya ko nu tava idh' atthoti. Ahaṃ h' ",
  "ja356:2.1": "imaṃ sāgarasevitantaṃ ",
  "ja356:2.2": "samaṃ karissāmi yathāpi pāṇiṃ ",
  "ja356:2.3": "vikiriya sānūni ca pabbatāni ca, ",
  "ja356:2.4": "tasmā silaṃ dariyā pakkhipāmīti. Na ",
  "ja356:3.1": "imaṃ mahiṃ arahati pāṇikappaṃ ",
  "ja356:3.2": "samaṃ manusso karaṇāya-m-eko, ",
  "ja356:3.3": "maññām': imañ ñeva dariṃ jigiṃsaṃ ",
  "ja356:3.4": "Kārandiya hāhasi jīvalokanti. ",
  "ja356:4.1": "Sace ayam bhūtadharaṃ na sattho ",
  "ja356:4.2": "samaṃ manusso karaṇāya-m-eko ",
  "ja356:4.3": "evam eva tvaṃ brahme ime manusse ",
  "ja356:4.4": "nānādiṭṭhike nānāyissasi teti. ",
  "ja356:5.1": "Saṃkhittarūpena bhavaṃ mam' atthaṃ ",
  "ja356:5.2": "akkhāsi Kāraṇḍiya evam etaṃ: ",
  "ja356:5.3": "yathā na sakkā paṭhavī samāyaṃ ",
  "ja356:5.4": "kātuṃ manussena tathā manussāti. ",
  "ja356:6.1": ""
}
