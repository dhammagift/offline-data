  "ja273:1.1": "Ko nu uddhitabhatto va ",
  "ja273:1.2": "pūrahattho va brāhmaṇo, ",
  "ja273:1.3": "kahan nu bhikkhaṃ acari, ",
  "ja273:1.4": "kaṃ saddhaṃ upasaṃkamīti. ",
  "ja273:2.1": "Ahaṃ kapi 'smi dummedho, ",
  "ja273:2.2": "anāmāsāni āmasiṃ, ",
  "ja273:2.3": "tvaṃ maṃ mocaya, bhaddan te, ",
  "ja273:2.4": "mutto gaccheyya pabbatanti. ",
  "ja273:3.1": "Kacchapā kassapā honti, ",
  "ja273:3.2": "koṇḍaññā honti makkaṭā, ",
  "ja273:3.3": "muñca kassapa koṇḍaññaṃ, ",
  "ja273:3.4": "kataṃ methunakaṃ tayāti. ",
  "ja273:4.1": ""
}
