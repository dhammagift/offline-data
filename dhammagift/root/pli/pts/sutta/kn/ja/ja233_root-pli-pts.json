  "ja233:1.1": "Kāmaṃ yahiṃ icchasi tena gaccha, ",
  "ja233:1.2": "viddho si mammamhi vikaṇṇakena, ",
  "ja233:1.3": "hato si bhattena savāditena ",
  "ja233:1.4": "lolo ca macche anubandhamānoti. ",
  "ja233:2.1": "Evam pi lokāmisam opatanto ",
  "ja233:2.2": "vihaññatī cittavasānuvattī, ",
  "ja233:2.3": "so haññati ñātisakhāna majjhe ",
  "ja233:2.4": "macchānugo so-r-iva suṃsumāroti. ",
  "ja233:3.1": ""
}
