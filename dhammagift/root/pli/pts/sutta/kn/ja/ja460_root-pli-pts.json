  "ja460:1.1": "",
  "ja460:1.2": "ahaṃ vande rathesabhaṃ, ",
  "ja460:1.3": "pabbajissaṃ mahārāja, ",
  "ja460:1.4": "taṃ devo anumaññatūti ",
  "ja460:2.1": "Sace te ūnaṃ kāmehi ",
  "ja460:2.2": "ahaṃ paripūrayāmi te ",
  "ja460:2.3": "yo taṃ hiṃsati vāremi, ",
  "ja460:2.4": "mā pabbaji Yuvañjayāti ",
  "ja460:3.1": "Na m' atthi ūnaṃ kāmehi, ",
  "ja460:3.2": "hiṃsitā me na vijjati, ",
  "ja460:3.3": "dīpañ ca kātum icchāmi ",
  "ja460:3.4": "yaṃ jarā nābhikīratīti. ",
  "ja460:4.1": "Putto vā pitaraṃ yāce ",
  "ja460:4.2": "pitā vā puttam orasanti. ",
  "ja460:4.3": "Negamo yācate tāta: ",
  "ja460:4.4": "mā pabbaja Yuvañjayāti. ",
  "ja460:5.1": "Mā maṃ deva nivāresi ",
  "ja460:5.2": "pabbajantaṃ rathesabha, ",
  "ja460:5.3": "māhaṃ kāmehi sammatto ",
  "ja460:5.4": "jarāya vasam anvagūti ",
  "ja460:6.1": "Ahaṃ taṃ tāta yācāmi, ",
  "ja460:6.2": "ahaṃ putta nivāraye, ",
  "ja460:6.3": "ciran taṃ daṭṭhum icchāmi, ",
  "ja460:6.4": "mā pabbaji Yuvañjayāti. ",
  "ja460:7.1": "Ussāvo va tiṇaggamhi ",
  "ja460:7.2": "suriyass' uggamanam pati ",
  "ja460:7.3": "evam āyu manussānaṃ, ",
  "ja460:7.4": "mā maṃ amma nivārayeti. ",
  "ja460:8.1": "Taramānā imaṃ yānaṃ ",
  "ja460:8.2": "āropentu rathesabha, ",
  "ja460:8.3": "mā me mātā tarantassa ",
  "ja460:8.4": "antarāyakarā ahūti. ",
  "ja460:9.1": "Abhidhāvatha, bhaddan te, ",
  "ja460:9.2": "suññaṃ hessati Rammakaṃ ",
  "ja460:9.3": "Yuvañjayo anuññāto ",
  "ja460:9.4": "Sabbadattena rājinā. ",
  "ja460:10.1": "Y' āhu seṭṭho sahassassa ",
  "ja460:10.2": "yuvā kañcanasannibho ",
  "ja460:10.3": "so 'yaṃ kumāro pabbajito ",
  "ja460:10.4": "kāsāyavasano balīti. ",
  "ja460:11.1": "Ubho kumārā pabbajitā ",
  "ja460:11.2": "Yuvañjayo ca Yudhiṭṭhilo ",
  "ja460:11.3": "pahāya mātāpitaro ",
  "ja460:11.4": "saṅgaṃ chetvāna maccunoti. ",
  "ja460:12.1": ""
}
