  "ja490:0.3": "",
  "ja490:0.4": "",
  "ja490:1.1": "Appossukko dāni tuvaṃ kapoṭa, ",
  "ja490:1.2": "vihaṅgama na tava bhojanattho, ",
  "ja490:1.3": "khudaṃ pipāsaṃ adhivāsayanto ",
  "ja490:1.4": "kasmā bhavaṃ posathiko kapoṭoti. ",
  "ja490:2.1": "Ahaṃ pure giddhigato kapoṭiyā ",
  "ja490:2.2": "asmiṃ pakesasmiṃ ubho ramāma, ",
  "ja490:2.3": "ath' aggahī sākuṇiko kapoṭiṃ, ",
  "ja490:2.4": "akāmako tāya vinā ahosiṃ. ",
  "ja490:3.1": "Nānābhavā vippayogena tassā ",
  "ja490:3.2": "manomayaṃ vedanaṃ vediyāmi, ",
  "ja490:3.3": "tasmā ahaṃ posathaṃ pālayāmi, ",
  "ja490:3.4": "rāgo mamaṃ mā punar āgamāsīti. ",
  "ja490:4.1": "Anujjugāmi uraga-ddujivha ",
  "ja490:4.2": "dāṭhāvudho ghoraviso si sappa, ",
  "ja490:4.3": "khudaṃ pipāsaṃ adhivāsayanto ",
  "ja490:4.4": "kasmā bhavaṃ posathiko nu dīgho. ",
  "ja490:5.1": "Usabho ahū balavā gāmikassa ",
  "ja490:5.2": "calakkakū vaṇṇabalūpapanno, ",
  "ja490:5.3": "[so] maṃ akkamī, taṃ kupito aḍassiṃ, ",
  "ja490:5.4": "dukkhābhitunno maraṇaṃ upāgami. ",
  "ja490:6.1": "Tato janā nikkhamitvāna gāmā ",
  "ja490:6.2": "kanditvā roditva upakkamiṃsu, ",
  "ja490:6.3": "tasmā ahaṃ posathaṃ pālayāmi, ",
  "ja490:6.4": "kodho mamaṃ mā punar āgamāsi. ",
  "ja490:7.1": "Matāna maṃsāni bahū susāne, ",
  "ja490:7.2": "manuññarūpaṃ tava bhojan' etaṃ, ",
  "ja490:7.3": "khudaṃ pipāsaṃ adhivāsayanto ",
  "ja490:7.4": "kasmā bhavaṃ posathiko sigālo. ",
  "ja490:8.1": "Pavissaṃ kucchiṃ mahato gajassa ",
  "ja490:8.2": "kuṇape rato hatthimaṃse pagiddho, ",
  "ja490:8.3": "uṇho ca vāto tikhiṇā ca rasmiyo ",
  "ja490:8.4": "te sosayuṃ tassa karīsamaggaṃ. ",
  "ja490:9.1": "Kiso ca paṇḍū ca ahaṃ bhadante, ",
  "ja490:9.2": "na me ahuṃ nikkhamanāya maggo, ",
  "ja490:9.3": "mahā ca megho sahasā pavassi, ",
  "ja490:9.4": "so temayi tassa karīsamaggaṃ. ",
  "ja490:10.1": "Tato ahaṃ nikkhamissaṃ bhadante ",
  "ja490:10.2": "Cando yathā Rāhumukhā pamutto, ",
  "ja490:10.3": "",
  "ja490:10.4": "",
  "ja490:11.1": "Vammīkathūpasmiṃ kipillikāni ",
  "ja490:11.2": "nippothayanto tuvaṃ pure carāsi, ",
  "ja490:11.3": "khudaṃ pipāsaṃ adhivāsayanto ",
  "ja490:11.4": "kasmā bhavaṃ posathiko nu accho. ",
  "ja490:12.1": "Sakan niketaṃ atihīḷayano ",
  "ja490:12.2": "atricchatāya malataṃ agañchiṃ, ",
  "ja490:12.3": "tato janā nikkhamitvāna gāmā ",
  "ja490:12.4": "kodaṇḍakena paripothayiṃsu maṃ. ",
  "ja490:13.1": "So bhinnasīso ruhirakkhitaṅgo ",
  "ja490:13.2": "paccāgamāsiṃ sakaṃ niketaṃ, ",
  "ja490:13.3": "tasmā ahaṃ posathaṃ pālayāmi, ",
  "ja490:13.4": "atricchatā mā punar āgamāsīti. ",
  "ja490:14.1": "Yan no apucchittha tuvaṃ bhadante ",
  "ja490:14.2": "sabbe va vyākarimhā yathāpajānaṃ, ",
  "ja490:14.3": "mayam pi pucchāma tuvaṃ bhadante: ",
  "ja490:14.4": "kasmā bhavaṃ posathiko va brahmeti. ",
  "ja490:15.1": "Anūpalitto mama assamamhi ",
  "ja490:15.2": "paccekabuddho muhuttaṃ nisīdi, ",
  "ja490:15.3": "so maṃ avedī gatiṃ āgatiñ ca ",
  "ja490:15.4": "nāmañ ca gottañ caraṇañ ca sabbaṃ. ",
  "ja490:16.1": "Evam p' ahaṃ na-ggahe tassa pāde, ",
  "ja490:16.2": "na cāpi naṃ mānagatena pucchiṃ, ",
  "ja490:16.3": "tasmā ahaṃ posathaṃ pālayāmi, ",
  "ja490:16.4": "māno mamaṃ mā punar āgamāsīti. ",
  "ja490:17.1": ""
}
