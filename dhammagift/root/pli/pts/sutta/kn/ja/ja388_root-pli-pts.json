  "ja388:1.1": "dāni diyyati, ",
  "ja388:1.2": "puṇṇāyaṃ doṇī, suvāminī ṭhitā, ",
  "ja388:1.3": "bahuke jane pāsapāṇike, ",
  "ja388:1.4": "no ca kho me paṭibhāti bhuñjitunti. ",
  "ja388:2.1": "Tasasi bhamasi lenam icchasi ",
  "ja388:2.2": "attāṇo si kuhiṃ gamissasi, ",
  "ja388:2.3": "appossukko bhuñja Tuṇḍila, ",
  "ja388:2.4": "maṃsatthāya hi posiyāmase. ",
  "ja388:3.1": "Ogaha rahadaṃ akaddamaṃ, ",
  "ja388:3.2": "sabbaṃ sedamalaṃ pavāhaya, ",
  "ja388:3.3": "gaṇhāhi navaṃ vilepanaṃ ",
  "ja388:3.4": "yassa gandho na kadāci chijjatīti. ",
  "ja388:4.1": "Katamo rahado akaddamo, ",
  "ja388:4.2": "kiṃ su sedamalanti vuccati, ",
  "ja388:4.3": "katamañ ca navaṃ vilepanaṃ ",
  "ja388:4.4": "yassa gandho na kadāci chijjatīti. ",
  "ja388:5.1": "Dhammo rahado akaddamo, ",
  "ja388:5.2": "pāpaṃ sedamalanti vuccati, ",
  "ja388:5.3": "sīlañ ca navaṃ vilepanaṃ, ",
  "ja388:5.4": "tassa gandho na kadāci chijjati. ",
  "ja388:6.1": "Nandanti sarīraghātino, ",
  "ja388:6.2": "na ca nandanti sarīradhārino, ",
  "ja388:6.3": "puṇṇāya ca puṇṇamāsiyā ",
  "ja388:6.4": "ramamānā va jahanti jīvitanti ",
  "ja388:7.1": ""
}
