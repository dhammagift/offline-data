  "ja270:1.1": "Sabbehi kira ñātīhi ",
  "ja270:1.2": "kosiyo issaro kato, ",
  "ja270:1.3": "sace ñātīh' anuññāto ",
  "ja270:1.4": "bhaṇeyy' āhaṃ ekavāciyanti. ",
  "ja270:2.1": "Bhaṇa samma anuññāto ",
  "ja270:2.2": "atthaṃ dhammañ ca kevalaṃ, ",
  "ja270:2.3": "santi hi daharā pakkhī ",
  "ja270:2.4": "paññāvanto jutindharāti. ",
  "ja270:3.1": "Na me ruccati bhaddaṃ vo ",
  "ja270:3.2": "ulūkassābhisecanaṃ, ",
  "ja270:3.3": "akuddhassa mukhaṃ passa, ",
  "ja270:3.4": "kathaṃ kuddho karissatīti. Āraññakassa ",
  "ja270:4.1": "",
  "ja270:4.2": "",
  "ja270:5.1": "",
  "ja270:6.1": "",
  "ja270:6.2": "",
  "ja270:6.3": "",
