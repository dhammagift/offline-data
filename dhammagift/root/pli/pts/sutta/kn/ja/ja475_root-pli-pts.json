  "ja475:0.4": "",
  "ja475:1.1": "Kuṭhārihattho puriso ",
  "ja475:1.2": "vanam ogayha tiṭṭhasi, ",
  "ja475:1.3": "puṭṭho me samma akkhāhi, ",
  "ja475:1.4": "kiṃ dāruṃ chetum icchasīti. ",
  "ja475:2.1": "Iso vanāni carasi ",
  "ja475:2.2": "samāni visamāni ca, ",
  "ja475:2.3": "puṭṭho me samma akkhāhi, ",
  "ja475:2.4": "kiṃ dāruṃ nemiyā daḷhanti. ",
  "ja475:3.1": "N' eva sālo na khadiro ",
  "ja475:3.2": "n' assakaṇṇo kuto dhavo, ",
  "ja475:3.3": "rukkho va phandano nāma, ",
  "ja475:3.4": "taṃ dāruṃ nemiyā daḷhanti. ",
  "ja475:4.1": "Kīdisāni 'ssa pattāni, ",
  "ja475:4.2": "khandho vā pana kīdiso, ",
  "ja475:4.3": "puṭṭho me samma akkhāhi, ",
  "ja475:4.4": "yathā jānemu phandananti. ",
  "ja475:5.1": "Yassa sākhā palambanti ",
  "ja475:5.2": "namanti na ca bhañjare ",
  "ja475:5.3": "so rukkho phandano nāma ",
  "ja475:5.4": "yassa mūle ahaṃ ṭhito. ",
  "ja475:6.1": "Arānaṃ cakkanābhīnaṃ ",
  "ja475:6.2": "īsanemirathassa ca ",
  "ja475:6.3": "sabbassa te kammaniyo ",
  "ja475:6.4": "ayaṃ hessati phandanoti. ",
  "ja475:7.1": "Iti phandanarukkho pi ",
  "ja475:7.2": "tāvade ajjhabhāsatha: ",
  "ja475:7.3": "mayham pi vacanaṃ atthi, ",
  "ja475:7.4": "Bhāradvāja suṇohi me. ",
  "ja475:8.1": "Issassa upakhandhamhā ",
  "ja475:8.2": "okkacca caturaṅgulaṃ ",
  "ja475:8.3": "tena nemiṃ pariharesi, ",
  "ja475:8.4": "evaṃ daḷhataraṃ siyā. ",
  "ja475:9.1": "Iti phandanarukkho pi ",
  "ja475:9.2": "veraṃ appesi tāvade ",
  "ja475:9.3": "jātānañ ca ajātānaṃ ",
  "ja475:9.4": "īsānaṃ dukkham āvahīti. Icc- ",
  "ja475:10.1": "eva phandano īsaṃ ",
  "ja475:10.2": "īso ca pana phandanaṃ ",
  "ja475:10.3": "aññamaññaṃ vivādena ",
  "ja475:10.4": "aññamaññaṃ aghātayuṃ. ",
  "ja475:11.1": "Evam eva manussesu ",
  "ja475:11.2": "vivādo yattha jāyati ",
  "ja475:11.3": "mayūranaccaṃ naccanti ",
  "ja475:11.4": "yathā ne īsaphandanā. ",
  "ja475:12.1": "Taṃ vo vadāmi, bhaddaṃ vo, ",
  "ja475:12.2": "yāvant' ettha samāgatā: ",
  "ja475:12.3": "sammodatha mā vivadittha, ",
  "ja475:12.4": "mā hotha īsaphandanā. ",
  "ja475:13.1": "Sāmaggim eva sikkhetha, ",
  "ja475:13.2": "buddheh' etaṃ pasaṃsitaṃ, ",
  "ja475:13.3": "sāmaggirato dhammaṭṭho ",
  "ja475:13.4": "yogakkhemā na dhaṃsatīti āha. Idh' eva ",
  "ja475:14.1": ""
}
