  "ja543:0.4": "",
  "ja543:1.1": "Yaṃ kiñci ratanaṃ atthi ",
  "ja543:1.2": "Dhataraṭṭhassa nivesane ",
  "ja543:1.3": "sabbāni te upāyanti, ",
  "ja543:1.4": "dhītaraṃ dehi rājinoti. ",
  "ja543:2.1": "Na no vivāho nāgehi ",
  "ja543:2.2": "katapubbo kudācanaṃ, ",
  "ja543:2.3": "taṃ vivāhaṃ asaṃyuttaṃ ",
  "ja543:2.4": "kathaṃ amhe karomaseti. ",
  "ja543:3.1": "Jīvitaṃ nūna te cattaṃ ",
  "ja543:3.2": "raṭṭhaṃ vā manujādhipa, ",
  "ja543:3.3": "na hi nāge kupitamhi ",
  "ja543:3.4": "ciraṃ jīvanti tādisā. ",
  "ja543:4.1": "Yo tvaṃ deva manusso 'si ",
  "ja543:4.2": "iddhimantaṃ aniddhimā ",
  "ja543:4.3": "Varuṇassa niyaṃ puttaṃ ",
  "ja543:4.4": "Yamunaṃ atimaññasīti. ",
  "ja543:5.1": "Nātimaññāmi rājānaṃ ",
  "ja543:5.2": "Dhataraṭṭhaṃ yasassinaṃ, ",
  "ja543:5.3": "Dhataraṭṭho hi nāgānaṃ ",
  "ja543:5.4": "bahunnam api issaro. ",
  "ja543:6.1": "Ahi mahānubhāvo pi ",
  "ja543:6.2": "na me dhītaram āraho, ",
  "ja543:6.3": "khattiyo ca Videhānaṃ, ",
  "ja543:6.4": "abhijātā Samuddajāti. ",
  "ja543:7.1": "Kambalassatarā uṭṭhentu, ",
  "ja543:7.2": "sabbe nāge nivedaya: ",
  "ja543:7.3": "Bārāṇasiṃ pavajjantu ",
  "ja543:7.4": "mā ca kiñci viheṭhayunti. ",
  "ja543:8.1": "Nivesanesu sobbhesu ",
  "ja543:8.2": "rathiyā caccaresu ca ",
  "ja543:8.3": "rukkhaggesu ca lambantu ",
  "ja543:8.4": "vitatā toraṇesu ca. ",
  "ja543:9.1": "Aham pi sabbasetena ",
  "ja543:9.2": "mahatā sumahaṃ puraṃ ",
  "ja543:9.3": "parikkhipissaṃ bhogehi ",
  "ja543:9.4": "Kāsīnaṃ janayaṃ bhayanti. ",
  "ja543:10.1": "Tassa taṃ vacanaṃ sutvā ",
  "ja543:10.2": "uragā nekavaṇṇino ",
  "ja543:10.3": "Bārāṇasiṃ pavajjiṃsu ",
  "ja543:10.4": "na ca kañci viheṭhayuṃ. ",
  "ja543:11.1": "Nivesanesu sobbhesu ",
  "ja543:11.2": "rathiyā caccaresu ca ",
  "ja543:11.3": "rukkhaggesu ca lambiṃsu ",
  "ja543:11.4": "vitatā toraṇesu ca. ",
  "ja543:12.1": "Te su disvāna lambante ",
  "ja543:12.2": "puthu kandiṃsu nāriyo ",
  "ja543:12.3": "nāge soṇḍikate disvā ",
  "ja543:12.4": "passasante muhuṃ muhuṃ. ",
  "ja543:13.1": "Bārāṇasī pavyadhitā ",
  "ja543:13.2": "āturā samapajjatha, ",
  "ja543:13.3": "bāhā paggayha pakkanduṃ: ",
  "ja543:13.4": "dhītaraṃ dehi rājinoti. ",
  "ja543:14.1": "",
  "ja543:15.1": "Pupphābhihārassa vanassa majjhe ",
  "ja543:15.2": "ko lohitakkho vihatantaraṃso, ",
  "ja543:15.3": "kā kambukāyūradharā suvatthā ",
  "ja543:15.4": "tiṭṭhanti nariyo dasa vandamānā. ",
  "ja543:16.1": "Ko tvaṃ brahābāhu vanassa majjhe ",
  "ja543:16.2": "virocasi ghaṭasitto va aggi, ",
  "ja543:16.3": "mahesakkho aññataro si yakkho, ",
  "ja543:16.4": "udāhu nāgo si mahānubhāvoti. ",
  "ja543:17.1": "Nāgo 'ham asmi iddhimā ",
  "ja543:17.2": "tejasī duratikkamo ",
  "ja543:17.3": "ḍaseyyaṃ tejasā kuddho ",
  "ja543:17.4": "phītaṃ janapadam api. ",
  "ja543:18.1": "Samuddajā hi me mātā, ",
  "ja543:18.2": "Dhataraṭṭho ca me pitā, ",
  "ja543:18.3": "Sudassanakaniṭṭho 'smi, ",
  "ja543:18.4": "Bhūridattoti maṃ vidūti. ",
  "ja543:19.1": "Yaṃ gambhīraṃ sadāvaṭṭaṃ ",
  "ja543:19.2": "rahadaṃ bhesmaṃ avekkhasi ",
  "ja543:19.3": "esa divyo mamāvāso ",
  "ja543:19.4": "anekasataporiso. ",
  "ja543:20.1": "Mayūrakoñcābhirudaṃ ",
  "ja543:20.2": "nīlodaṃ vanamajjhato ",
  "ja543:20.3": "Yamunaṃ pavisa mābhīto ",
  "ja543:20.4": "khemaṃ vattavataṃ sivanti. ",
  "ja543:21.1": "Tattha patto sānucaro ",
  "ja543:21.2": "saha puttena brāhmaṇa ",
  "ja543:21.3": "pūjito mayhaṃ kāmehi ",
  "ja543:21.4": "sukhaṃ brāhmaṇa vacchasīti. ",
  "ja543:22.1": "Samā samantā parito ",
  "ja543:22.2": "bahūtatagarā mahī ",
  "ja543:22.3": "indagopakasañchannā ",
  "ja543:22.4": "sobhati harituttamā. ",
  "ja543:23.1": "Rammāni vanacetyāni ",
  "ja543:23.2": "rammā haṃsūpakūjitā ",
  "ja543:23.3": "opupphapadumā tiṭṭhanti ",
  "ja543:23.4": "pokkharaññā sunimmitā. ",
  "ja543:24.1": "Aṭṭhaṃsā sukatā thambhā ",
  "ja543:24.2": "sabbe veluriyāmayā, ",
  "ja543:24.3": "sahassathambhā pāsādā ",
  "ja543:24.4": "pūrā kaññāhi jotare. ",
  "ja543:25.1": "Vimānaṃ upapanno si ",
  "ja543:25.2": "dibbapuññehi attano ",
  "ja543:25.3": "asambādhaṃ sivaṃ rammaṃ ",
  "ja543:25.4": "accantasukhasaṃhitaṃ. ",
  "ja543:26.1": "Maññe Sahassanettassa ",
  "ja543:26.2": "vimānaṃ nābhikaṃkhasi, ",
  "ja543:26.3": "iddhī hi t' āyaṃ vipulā ",
  "ja543:26.4": "Sakkass' eva jutīmatoti. ",
  "ja543:27.1": "Manasāpi na pattabbo ",
  "ja543:27.2": "ānubhāvo jutīmato ",
  "ja543:27.3": "paricārayamānānaṃ ",
  "ja543:27.4": "saindānaṃ vasavattinanti. ",
  "ja543:28.1": "Taṃ vimāṇaṃ abhijjhāya ",
  "ja543:28.2": "amarānaṃ sukhesinaṃ ",
  "ja543:28.3": "uposathaṃ upavasanto ",
  "ja543:28.4": "semi vammikamuddhanīti. ",
  "ja543:29.1": "Ahañ ca migam esāno ",
  "ja543:29.2": "saputto pāvisiṃ vanaṃ, ",
  "ja543:29.3": "taṃ maṃ mataṃ vā jīvaṃ vā ",
  "ja543:29.4": "nābhivedenti ñātakā. ",
  "ja543:30.1": "Āmantaye Bhūridattaṃ ",
  "ja543:30.2": "Kāsiputtaṃ yasassinaṃ: ",
  "ja543:30.3": "tayā vo samanuññātā ",
  "ja543:30.4": "api passemu ñātaketi. ",
  "ja543:31.1": "Eso hi vata me chando ",
  "ja543:31.2": "yaṃ va sesi mam' antike, ",
  "ja543:31.3": "na hi etādisā kāmā ",
  "ja543:31.4": "sulabhā honti mānuse. ",
  "ja543:32.1": "Sace tvaṃ icchase vatthuṃ ",
  "ja543:32.2": "mama kāmehi pūjito ",
  "ja543:32.3": "mayā tvaṃ samanuññāto ",
  "ja543:32.4": "sotthiṃ passāhi ñātaketi ",
  "ja543:33.1": "Dhāray' imaṃ maṇiṃ divyaṃ ",
  "ja543:33.2": "pasuṃ putte ca vindati ",
  "ja543:33.3": "arogo sukhito hoti, ",
  "ja543:33.4": "gacch' evādāya brāhmaṇāti. ",
  "ja543:34.1": "Kusalaṃ paṭinandāmi ",
  "ja543:34.2": "Bhūridatta vaco tava, ",
  "ja543:34.3": "pabbajissāmi jiṇṇo 'smi, ",
  "ja543:34.4": "na kāme abhipatthayeti. ",
  "ja543:35.1": "Brahmacariyassa ce bhaṅgo ",
  "ja543:35.2": "hoti bhogehi kāriyaṃ, ",
  "ja543:35.3": "avikampamāno eyyāsi ",
  "ja543:35.4": "bahuṃ dassāmi te dhananti. ",
  "ja543:36.1": "Kusalaṃ paṭinandāmi ",
  "ja543:36.2": "Bhūridatta vaco tava, ",
  "ja543:36.3": "puna pi āgamissāmi ",
  "ja543:36.4": "sace attho bhavissatīti. ",
  "ja543:37.1": "Idaṃ vatvā Bhūridatto ",
  "ja543:37.2": "pesesi caturo jane: ",
  "ja543:37.3": "etha gacchatha uṭṭhetha ",
  "ja543:37.4": "khippaṃ pāpetha brāhmaṇaṃ. ",
  "ja543:38.1": "Tassa taṃ vacanaṃ sutvā ",
  "ja543:38.2": "uṭṭhāya caturo janā ",
  "ja543:38.3": "pesitā Bhūridattena ",
  "ja543:38.4": "khippaṃ pāpesuṃ brāhmaṇanti. ",
  "ja543:39.1": "",
  "ja543:40.1": "Maṇiṃ paggayha maṅgalyaṃ ",
  "ja543:40.2": "sādhucittaṃ manoramaṃ ",
  "ja543:40.3": "selaṃ vyañjanasampannaṃ ",
  "ja543:40.4": "ko imaṃ maṇiṃ ajjhagāti. ",
  "ja543:41.1": "Lohitakkhasahassāhi ",
  "ja543:41.2": "samantā parivāritaṃ ",
  "ja543:41.3": "ajjakālaṃ padaṃ gacchaṃ ",
  "ja543:41.4": "ajjhagāhaṃ maṇiṃ imanti. ",
  "ja543:42.1": "Sūpaciṇṇo ayaṃ selo ",
  "ja543:42.2": "accito mahito sadā ",
  "ja543:42.3": "sudhārito sunikkhitto ",
  "ja543:42.4": "sabbattham abhisādhaye. ",
  "ja543:43.1": "Upacāravipannassa ",
  "ja543:43.2": "nikkhepe dhāraṇāya vā ",
  "ja543:43.3": "ayaṃ selo vināsāya ",
  "ja543:43.4": "pariciṇṇo ayoniso. ",
  "ja543:44.1": "Na imaṃ akusalo divyaṃ ",
  "ja543:44.2": "maṇiṃ dhāretum āraho, ",
  "ja543:44.3": "paṭipajja satan nikkhaṃ ",
  "ja543:44.4": "deh' imaṃ ratanaṃ mamanti. ",
  "ja543:45.1": "Na vā m' āyaṃ maṇī keyyo ",
  "ja543:45.2": "gohi vā ratanena vā, ",
  "ja543:45.3": "selo vyañjanasampanno, ",
  "ja543:45.4": "n' eva keyyo maṇī mamanti. ",
  "ja543:46.1": "No ce tayā maṇī keyyo ",
  "ja543:46.2": "gohi vā ratanena vā, ",
  "ja543:46.3": "atha kena maṇī keyyo, ",
  "ja543:46.4": "tam me akkhāhi pucchitoti. ",
  "ja543:47.1": "Yo me saṃse mahānāgaṃ ",
  "ja543:47.2": "tejasiṃ duratikkamaṃ ",
  "ja543:47.3": "tassa dajjaṃ imaṃ selaṃ ",
  "ja543:47.4": "jalanta-r-iva tejasāti. ",
  "ja543:48.1": "Ko nu brāhmaṇavaṇṇena ",
  "ja543:48.2": "supaṇṇo patataṃ varo ",
  "ja543:48.3": "nāgaṃ jigiṃsam anvesi ",
  "ja543:48.4": "anvesaṃ bhakkham attanoti. ",
  "ja543:49.1": "Nāhaṃ dijādhipo homi, ",
  "ja543:49.2": "na diṭṭho garuḷo mayā, ",
  "ja543:49.3": "āsīvisena vittoti ",
  "ja543:49.4": "vejjo maṃ brāhmaṇaṃ vidūti. ",
  "ja543:50.1": "Kin nu tuyhaṃ balaṃ atthi, ",
  "ja543:50.2": "kiṃ sippaṃ vijjate tava, ",
  "ja543:50.3": "kismiṃ vā tvaṃ paratthaddho ",
  "ja543:50.4": "uragaṃ nāpacāyasīti. ",
  "ja543:51.1": "Araññakassa isino ",
  "ja543:51.2": "cirarattatapassino ",
  "ja543:51.3": "supaṇṇo Kosiyass' akkhā ",
  "ja543:51.4": "visavijjaṃ anuttaraṃ. ",
  "ja543:52.1": "Taṃ bhāvitatt' aññataraṃ ",
  "ja543:52.2": "sammantaṃ pabbatantare ",
  "ja543:52.3": "sakkaccaṃ taṃ upaṭṭhāsi ",
  "ja543:52.4": "rattindivam atandito. ",
  "ja543:53.1": "So tadā pariciṇṇo me ",
  "ja543:53.2": "vatavā brahmacariyavā ",
  "ja543:53.3": "dibbaṃ pātukarī mantaṃ ",
  "ja543:53.4": "kāmasā bhagavā mamaṃ. ",
  "ja543:54.1": "-āhaṃ mante paratthaddho, ",
  "ja543:54.2": "nāhaṃ bhāyāmi bhoginaṃ, ",
  "ja543:54.3": "ācariyo visaghātānaṃ ",
  "ja543:54.4": "Ālambānoti maṃ vidūti. ",
  "ja543:55.1": "Gaṇhāmase maṇiṃ tāta, ",
  "ja543:55.2": "Somadatta vijānahi, ",
  "ja543:55.3": "mā daṇḍena siriṃ pattaṃ ",
  "ja543:55.4": "kāmasā pajahimhaseti. ",
  "ja543:56.1": "Sakaṃ nivesanaṃ pattaṃ ",
  "ja543:56.2": "yo taṃ brāhmaṇa pūjayi ",
  "ja543:56.3": "evaṃkalyāṇakārissa ",
  "ja543:56.4": "kiṃ mohā dūbhim icchasi. ",
  "ja543:57.1": "Sace hi dhanakāmo si ",
  "ja543:57.2": "Bhūridatto padassati, ",
  "ja543:57.3": "tam eva gantvā yācassu ",
  "ja543:57.4": "bahuṃ dassati te dhananti. ",
  "ja543:58.1": "Hatthagataṃ pattagataṃ ",
  "ja543:58.2": "nikkiṇṇaṃ khādituṃ varaṃ, ",
  "ja543:58.3": "mā no sandiṭṭhiko attho ",
  "ja543:58.4": "Somadatta upaccagāti. ",
  "ja543:59.1": "Paccati Niraye ghore ",
  "ja543:59.2": "mahissam avadīyati ",
  "ja543:59.3": "mittadūbhī hitaccāgī ",
  "ja543:59.4": "jīvare cāpi sussare. ",
  "ja543:60.1": "Sace hi dhanakāmo si ",
  "ja543:60.2": "Bhūridatto padassati, ",
  "ja543:60.3": "maññe attakataṃ veraṃ ",
  "ja543:60.4": "naciraṃ vedayissasīti. ",
  "ja543:61.1": "Mahāyaññaṃ yajitvāna ",
  "ja543:61.2": "evaṃ sujjhanti brāhmaṇā, ",
  "ja543:61.3": "mahāyaññaṃ yajissāma, ",
  "ja543:61.4": "evaṃ mokkhāma pāpakāti. ",
  "ja543:62.1": "Handa dāni apāyāmi ",
  "ja543:62.2": "nāhaṃ ajja tayā saha ",
  "ja543:62.3": "padam p' ekaṃ na gaccheyyaṃ ",
  "ja543:62.4": "evaṃkibbisakārināti. ",
  "ja543:63.1": "Idaṃ vatvāna pitaraṃ ",
  "ja543:63.2": "Somadatto bahussuto ",
  "ja543:63.3": "ujjhāpetvāna bhūtāni ",
  "ja543:63.4": "tamhā ṭhānā apakkamīti. ",
  "ja543:64.1": "Gaṇhāh' etaṃ mahānāgaṃ ",
  "ja543:64.2": "āhar' etaṃ maṇiṃ mama ",
  "ja543:64.3": "indagopakavaṇṇābhā ",
  "ja543:64.4": "yassa lohitako siro. ",
  "ja543:65.1": "Kappāsapicurāsīva ",
  "ja543:65.2": "eso kāy' assa dissati, ",
  "ja543:65.3": "vammikaggagato seti, ",
  "ja543:65.4": "taṃ tvaṃ gaṇhāhi brāhmaṇāti. ",
  "ja543:66.1": "Ath' osadhehi dibbehi ",
  "ja543:66.2": "japaṃ mantapadāni ca ",
  "ja543:66.3": "evan taṃ asakkhi saṭṭhuṃ ",
  "ja543:66.4": "katvā parittam attanoti. ",
  "ja543:67.1": "",
  "ja543:68.1": "Mamaṃ disvāna āyantaṃ ",
  "ja543:68.2": "sabbakāmasamiddhinaṃ ",
  "ja543:68.3": "indriyāni ahaṭṭhāni ",
  "ja543:68.4": "sāmaṃ jātaṃ mukhan tava, ",
  "ja543:69.1": "Padumaṃ yathā hatthagataṃ ",
  "ja543:69.2": "pāṇinā parimadditaṃ ",
  "ja543:69.3": "sāmaṃ jātaṃ mukhaṃ tuyhaṃ ",
  "ja543:69.4": "mamaṃ disvāna edisanti. ",
  "ja543:70.1": "Kaccin nu te nābhisasi, ",
  "ja543:70.2": "kacci te n' atthi vedanā, ",
  "ja543:70.3": "yan te sāmaṃ mukhaṃ tuyhaṃ ",
  "ja543:70.4": "mamaṃ disvāna āgatanti. ",
  "ja543:71.1": "Supinan tāta addakkhiṃ ",
  "ja543:71.2": "ito māsaṃ adhogataṃ: ",
  "ja543:71.3": "",
  "ja543:71.4": "",
  "ja543:71.5": "",
  "ja543:71.6": "",
  "ja543:72.1": "Yato supinam addakkhiṃ ",
  "ja543:72.2": "Sudassana vijānahi ",
  "ja543:72.3": "tato divā vā rattiṃ vā ",
  "ja543:72.4": "sukham me nopalabbhatīti. ",
  "ja543:73.1": "Yaṃ pubbe paricāriṃsu ",
  "ja543:73.2": "kaññā ruciraviggahā ",
  "ja543:73.3": "hemajālapaṭicchannā ",
  "ja543:73.4": "Bhūridatto na dissati. ",
  "ja543:74.1": "Yaṃ pubbe paricāriṃsu ",
  "ja543:74.2": "nettiṃsavaradhārino ",
  "ja543:74.3": "kaṇikārā va samphullā ",
  "ja543:74.4": "Bhūridatto na dissati. ",
  "ja543:75.1": "Handa dāni gamissāmi ",
  "ja543:75.2": "Bhūridattanivesanaṃ, ",
  "ja543:75.3": "dhammaṭṭhaṃ sīlasampannaṃ ",
  "ja543:75.4": "passāma tava bhātaranti. ",
  "ja543:76.1": "Tañ ca disvāna āyantiṃ ",
  "ja543:76.2": "Bhūridattassa mātaraṃ ",
  "ja543:76.3": "bāhā paggayha pakkanduṃ ",
  "ja543:76.4": "Bhūridattassa nāriyo. ",
  "ja543:77.1": "Puttaṃ t' ayye na jānāma ",
  "ja543:77.2": "ito māsaṃ adhogataṃ ",
  "ja543:77.3": "mataṃ vā yadivā jīvaṃ ",
  "ja543:77.4": "Bhūridattaṃ yasassinanti. ",
  "ja543:78.1": "Sakuṇī hataputtā va ",
  "ja543:78.2": "suññaṃ disvā kulāvakaṃ ",
  "ja543:78.3": "ciraṃ dukkhena jhāyissaṃ ",
  "ja543:78.4": "Bhūridattaṃ apassatī. Sakuṇī hataputtā va suññaṃ disvā kulāvakaṃ tena tena padhāvissaṃ piyaputtaṃ apassatī. ",
  "ja543:79.1": "Kurarī hatachāpā va ",
  "ja543:79.2": "suññaṃ disvā kulāvakaṃ ",
  "ja543:79.3": "ciraṃ dukkhena jhāyissaṃ ",
  "ja543:79.4": "Bhūridattaṃ apassatī. ",
  "ja543:80.1": "Sā nūna cakkavākīva ",
  "ja543:80.2": "pallalasmiṃ anūdake ",
  "ja543:80.3": "ciraṃ dukkhena jhāyissaṃ ",
  "ja543:80.4": "Bhūridattaṃ apassatī. ",
  "ja543:81.1": "Kammārānaṃ yathā ukkā ",
  "ja543:81.2": "anto jhāyati no bahi ",
  "ja543:81.3": "evaṃ jhāyāmi sokena ",
  "ja543:81.4": "Bhūridattaṃ appassatī. ",
  "ja543:82.1": "Sālā va sampamathitā ",
  "ja543:82.2": "mālutena pamadditā ",
  "ja543:82.3": "senti puttā ca dārā ca ",
  "ja543:82.4": "Bhūridattanivesaneti. ",
  "ja543:83.1": "Idaṃ sutvāna nigghosaṃ ",
  "ja543:83.2": "Bhūridattanivesane ",
  "ja543:83.3": "Ariṭṭho ca Subhago ca ",
  "ja543:83.4": "upadhāviṃsu anantarā. ",
  "ja543:84.1": "Amma assāsa mā soci, ",
  "ja543:84.2": "evaṃdhammā hi pāṇino ",
  "ja543:84.3": "cavanti upapajjanti, ",
  "ja543:84.4": "es' assa pariṇāmitāti. ",
  "ja543:85.1": "Aham pi tāta jānāmi: ",
  "ja543:85.2": "evaṃdhammā hi pāṇino, ",
  "ja543:85.3": "Sokena ca paret' asmi ",
  "ja543:85.4": "Bhūridattaṃ apassatī. ",
  "ja543:86.1": "Ajja ce me imaṃ rattiṃ -- ",
  "ja543:86.2": "Sudassana vijānahi -- ",
  "ja543:86.3": "Bhūridattaṃ apassantī ",
  "ja543:86.4": "maññe hessāmi jīvitanti. ",
  "ja543:87.1": "Amma assāsa mā soci, ",
  "ja543:87.2": "ānayissāma bhātaraṃ, ",
  "ja543:87.3": "disodisaṃ gamissāma ",
  "ja543:87.4": "bhātu pariyesanañ caraṃ ",
  "ja543:88.1": "Pabbate giriduggesu ",
  "ja543:88.2": "gāmesu nigamesu ca, ",
  "ja543:88.3": "orena dasarattassa ",
  "ja543:88.4": "bhātaraṃ passa āgatanti. ",
  "ja543:89.1": "Hatthā pamutto urago ",
  "ja543:89.2": "pāde te nipatī bhusaṃ, ",
  "ja543:89.3": "kacci t' ānuḍasī tāta, ",
  "ja543:89.4": "mā bhāyi sukhito bhavāti. ",
  "ja543:90.1": "N' eva mayhaṃ ayaṃ nāgo ",
  "ja543:90.2": "alan dukkhāya kāyaci, ",
  "ja543:90.3": "yāvat' atthi ahiggāho ",
  "ja543:90.4": "mayā bhiyyo na vijjatīti. ",
  "ja543:91.1": "Ko nu brāhmaṇavaṇṇena ",
  "ja543:91.2": "datto parisam āgamā ",
  "ja543:91.3": "avhayantu suyuddhena, ",
  "ja543:91.4": "suṇātu parisā mamanti. ",
  "ja543:92.1": "Tvaṃ maṃ nāgena ālamba ",
  "ja543:92.2": "ahaṃ maṇḍūkachāpiyā, ",
  "ja543:92.3": "hotu no abbhutaṃ tattha ",
  "ja543:92.4": "ā. sahassehi pañcahīti. Ahaṃ ",
  "ja543:93.1": "hi vasumā aḍḍho, ",
  "ja543:93.2": "tvaṃ daliddo si māṇava, ",
  "ja543:93.3": "ko nu te pāṭibhog' atthi, ",
  "ja543:93.4": "upajūtañ ca kiṃ siyā. ",
  "ja543:94.1": "Upajūtañ ca me assa ",
  "ja543:94.2": "pāṭibhogo ca tādiso, ",
  "ja543:94.3": "assa no abbhutaṃ tattha ",
  "ja543:94.4": "ā. sahassehi pañcahīti. ",
  "ja543:95.1": "Suṇohi me mahārāja ",
  "ja543:95.2": "vacanaṃ, bhaddam atthu te, ",
  "ja543:95.3": "pañcannaṃ me sahassānaṃ ",
  "ja543:95.4": "pāṭibhogo hi kittimāti. ",
  "ja543:96.1": "Pettikaṃ vā iṇaṃ hoti ",
  "ja543:96.2": "yaṃ vā hoti sayaṃkataṃ, ",
  "ja543:96.3": "kiṃ tvaṃ evaṃ bahuṃ mayhaṃ ",
  "ja543:96.4": "dhanaṃ yācasi brāhmaṇāti. ",
  "ja543:97.1": "Ālambāno hi nāgena ",
  "ja543:97.2": "mamaṃ abhijigiṃsati, ",
  "ja543:97.3": "ahaṃ maṇḍūkachāpiyā ",
  "ja543:97.4": "ḍaṃsayissāmi brāhmaṇaṃ. ",
  "ja543:98.1": "Taṃ tvaṃ daṭṭhuṃ mahārāja ",
  "ja543:98.2": "ajja raṭṭhābhivaḍḍhana ",
  "ja543:98.3": "khattasaṃghaparibbūḷho ",
  "ja543:98.4": "niyyāhi abhidassananti. ",
  "ja543:99.1": "N' eva taṃ atimaññāmi ",
  "ja543:99.2": "sippavādena māṇava, ",
  "ja543:99.3": "atimatt' āsi sippena, ",
  "ja543:99.4": "uragaṃ nāpacāyasīti. Mayam ",
  "ja543:100.1": "pi nātimaññāma ",
  "ja543:100.2": "sippavādena brāhmaṇaṃ, ",
  "ja543:100.3": "avisena ca nāgena ",
  "ja543:100.4": "bhusaṃ vañcayase janaṃ. ",
  "ja543:101.1": "Evaṃ ce taṃ jano jaññā ",
  "ja543:101.2": "yathā jānāmi taṃ ahaṃ ",
  "ja543:101.3": "na tvaṃ labhasi Ālamba ",
  "ja543:101.4": "sattumuṭṭhiṃ kuto dhananti. ",
  "ja543:102.1": "Kharājino jaṭī rummī ",
  "ja543:102.2": "datto parisam āgato, ",
  "ja543:102.3": "so tvaṃ evaṃgataṃ nāgaṃ ",
  "ja543:102.4": "‘aviso' atimaññasi. ",
  "ja543:103.1": "Āsajja kho naṃ jaññāsi ",
  "ja543:103.2": "puṇṇaṃ uggassa tejasā, ",
  "ja543:103.3": "maññe taṃ bhasmarāsiṃ va ",
  "ja543:103.4": "khippaṃ eso karissatīti. ",
  "ja543:104.1": "Siyā visaṃ siluttassa ",
  "ja543:104.2": "deḍḍubhassa silābhuno ",
  "ja543:104.3": "n' eva lohitasīsassa ",
  "ja543:104.4": "visaṃ nāgassa vijjatīti. Sutaṃ ",
  "ja543:105.1": "me taṃ arahataṃ ",
  "ja543:105.2": "saññatānaṃ tapassinaṃ: ",
  "ja543:105.3": "idha dānāni datvāna ",
  "ja543:105.4": "saggaṃ gacchanti dāyakā, ",
  "ja543:105.5": "jīvanto dehi dānāni ",
  "ja543:105.6": "yadi te atthi dātave. ",
  "ja543:106.1": "Ayaṃ nāgo mahiddhiko ",
  "ja543:106.2": "tejasī duratikkamo, ",
  "ja543:106.3": "tena taṃ ḍaṃsayissāmi, ",
  "ja543:106.4": "so taṃ bhasmaṃ karissati. ",
  "ja543:107.1": "Mayāp' etaṃ sutaṃ samma ",
  "ja543:107.2": "saññatānaṃ tapassinaṃ: ",
  "ja543:107.3": "idha dānāni datvāna ",
  "ja543:107.4": "saggaṃ gacchanti dāyakā, ",
  "ja543:107.5": "tvam eva dehi jīvanto ",
  "ja543:107.6": "yadi te atthi dātave. ",
  "ja543:108.1": "Ayaṃ Accimukhī nāma ",
  "ja543:108.2": "puṇṇā uggassa tejasā, ",
  "ja543:108.3": "tāya taṃ ḍaṃsayissāmi, ",
  "ja543:108.4": "sā taṃ bhasmaṃ karissati. ",
  "ja543:109.1": "Yā dhītā Dhataraṭṭhassa ",
  "ja543:109.2": "vemātābhaginī mama ",
  "ja543:109.3": "sā dissatu Accīmukhī ",
  "ja543:109.4": "puṇṇī uggassa tejasāti. Chamāyaṃ ",
  "ja543:110.1": "ce nisiñcissaṃ -- ",
  "ja543:110.2": "Brahmadatta vijānahi -- ",
  "ja543:110.3": "tiṇalatāni osajjho ",
  "ja543:110.4": "ussusseyyuṃ asaṃsayanti. ",
  "ja543:111.1": "Uddhañ ce pātayissāmi -- ",
  "ja543:111.2": "Brahmadatta vijānahi -- ",
  "ja543:111.3": "sattavassān' ayaṃ devo ",
  "ja543:111.4": "na vasse na himaṃ pateti. ",
  "ja543:112.1": "Udakañ ce nisiñcissaṃ -- ",
  "ja543:112.2": "Brahmadatta vijānahi -- ",
  "ja543:112.3": "yāvatā udakajā pāṇā ",
  "ja543:112.4": "mareyyuṃ macchakacchapāti. ",
  "ja543:113.1": "",
  "ja543:114.1": "Lokyaṃ sajantaṃ udakaṃ ",
  "ja543:114.2": "Payāgasmim patiṭṭhitaṃ ",
  "ja543:114.3": "ko maṃ ajjhoharī bhūto ",
  "ja543:114.4": "ogāḷhaṃ Yamunaṃ nadinti. ",
  "ja543:115.1": "Ya-d-esa lokādhipatī yasassī ",
  "ja543:115.2": "Bārāṇasiṃ pakiraparī samantato ",
  "ja543:115.3": "tassāhaṃ putto uragūsabhassa, ",
  "ja543:115.4": "Subhagoti maṃ brāhmaṇa vedayantīti. ",
  "ja543:116.1": "Sace hi putto uragūsabhassa ",
  "ja543:116.2": "Kaṃsassa rañño amarādhipassa ",
  "ja543:116.3": "mahesakkho aññataro pitā te ",
  "ja543:116.4": "maccesu mātā pana te atulyā ",
  "ja543:116.5": "na tādiso arahati brāhmaṇassa ",
  "ja543:116.6": "dāsam pi ohātuṃ mahānubhāvoti. ",
  "ja543:117.1": "Rukkhaṃ nissāya vijjhittho ",
  "ja543:117.2": "eṇeyyaṃ pātum āgataṃ, ",
  "ja543:117.3": "so viddho dūram asarā ",
  "ja543:117.4": "saravegena sekhavā. ",
  "ja543:118.1": "Taṃ tvaṃ patitam addakkhi ",
  "ja543:118.2": "araññasmiṃ brahāvane ",
  "ja543:118.3": "sa maṃsakācam ādāya ",
  "ja543:118.4": "sāyaṃ nigrodh' upāgami ",
  "ja543:119.1": "Suvasāliyasaṃghuṭṭhaṃ ",
  "ja543:119.2": "piṅgiyaṃ santhatāyutaṃ ",
  "ja543:119.3": "kokilābhirudaṃ rammaṃ ",
  "ja543:119.4": "dhuvaṃ haritasaddalaṃ. ",
  "ja543:120.1": "Tattha te so pāturahu ",
  "ja543:120.2": "iddhiyā yasasā jalaṃ ",
  "ja543:120.3": "mahānubhāvo bhātā me ",
  "ja543:120.4": "kaññāhi parivārito. ",
  "ja543:121.1": "So tena pariciṇṇo tvaṃ ",
  "ja543:121.2": "sabbakāmehi tappito ",
  "ja543:121.3": "adūbhassa tuvaṃ dūbhi, ",
  "ja543:121.4": "tan te veraṃ idhāgataṃ. ",
  "ja543:122.1": "Khippaṃ gīvaṃ pasārehi, ",
  "ja543:122.2": "na te dassāmi jīvitaṃ, ",
  "ja543:122.3": "bhātu parisaraṃ veraṃ ",
  "ja543:122.4": "chedayissāmi te siranti. ",
  "ja543:123.1": "Ajjhāyako yācayogo ",
  "ja543:123.2": "āhutaggi ca brāhmaṇo, ",
  "ja543:123.3": "etehi tīhi ṭhānehi ",
  "ja543:123.4": "avajjho bhavati brāhmaṇoti. ",
  "ja543:124.1": "Yaṃ puraṃ Dhataraṭṭhassa ",
  "ja543:124.2": "ogāḷhaṃ Yamunaṃ nadiṃ ",
  "ja543:124.3": "jotate sabbasovaṇṇaṃ ",
  "ja543:124.4": "girim āhacca Yāmunaṃ. ",
  "ja543:125.1": "Tattha te purisavyagghā ",
  "ja543:125.2": "sodariyā mama bhātaro, ",
  "ja543:125.3": "yathā te tattha vakkhanti ",
  "ja543:125.4": "tathā hessasi brāhmaṇāti. ",
  "ja543:126.1": "",
  "ja543:127.1": "Anittarā ittarasampayuttā ",
  "ja543:127.2": "yaññā ca vedā ca subhoga loke, ",
  "ja543:127.3": "tad aggarayhaṃ hi vinindamāno ",
  "ja543:127.4": "jahāti vittañ ca satañ ca dhammanti. ",
  "ja543:128.1": "Ajjhenam ariyā paṭhaviṃ janindā ",
  "ja543:128.2": "vessā kasiṃ pāricariyañ ca suddā ",
  "ja543:128.3": "upāgu paccekaṃ yathā padesaṃ ",
  "ja543:128.4": "katāhu ete Vasināti āhūti. ",
  "ja543:129.1": "Dhātā Vidhātā Varuṇo Kuvero ",
  "ja543:129.2": "Somo Yamo Candimā y' āpi Suriyo ",
  "ja543:129.3": "ete hi yaññaṃ puthuso yajitvā ",
  "ja543:129.4": "ajjhāyakānaṃ atha sabbakāme. ",
  "ja543:130.1": "Vikāsitā cāpasatāni pañca ",
  "ja543:130.2": "yo Ajjuno balavā bhīmaseno ",
  "ja543:130.3": "sahassabāhu asamo pathavyā ",
  "ja543:130.4": "so pi tadā ādahi jātavedanti. ",
  "ja543:131.1": "Yo brāhmaṇe bhojayi dīgharattaṃ ",
  "ja543:131.2": "annena pānena yathānubhāvaṃ ",
  "ja543:131.3": "pasannacitto anumodamāno ",
  "ja543:131.4": "subhoga devaññataro ahosīti. ",
  "ja543:132.1": "Mahāsanaṃ devam anomavaṇṇam ",
  "ja543:132.2": "yo sappinā asakkhi jetum Aggiṃ ",
  "ja543:132.3": "so yaññatan taṃ varato yajitvā ",
  "ja543:132.4": "dibbaṃ gatiṃ Mujalind' ajjhagañchīti. ",
  "ja543:133.1": "Mahānubhāvo vassasahassajīvī ",
  "ja543:133.2": "yo pabbaji dassaneyyo uḷāro ",
  "ja543:133.3": "",
  "ja543:133.4": "",
  "ja543:134.1": "Yo sāgarantaṃ Sāgaro vijitvā ",
  "ja543:134.2": "yūpaṃ subhaṃ soṇṇamayaṃ uḷāraṃ ",
  "ja543:134.3": "ussesi Vessānaram ādahāno ",
  "ja543:134.4": "subhoga devaññataro ahosi. ",
  "ja543:135.1": "Yassānubhāvena subhoga Gaṅgā ",
  "ja543:135.2": "pavattatha dadhisannam samuddaṃ ",
  "ja543:135.3": "sa lomapādo paricariya-m-aggiṃ ",
  "ja543:135.4": "Aṅgo sahassakkhapur' ajjhagañchīti. ",
  "ja543:136.1": "Mahiddhiko devavaro yasassī ",
  "ja543:136.2": "senāpatī tidive Vāsavassa ",
  "ja543:136.3": "",
  "ja543:136.4": "Akāri ",
  "ja543:137.1": "yo lokam imaṃ parañ ca ",
  "ja543:137.2": "Bhāgīrasiṃ Himavantañ ca Gijjhaṃ ",
  "ja543:137.3": "yo iddhimā devavaro yasassī ",
  "ja543:137.4": "so pi tadā ādahi jātavedaṃ. ",
  "ja543:138.1": "Mālāgirī Himavā yo ca Gijjho ",
  "ja543:138.2": "Sudassano Nisabho Kākaneru ",
  "ja543:138.3": "ete ca aññe ca nagā mahantā ",
  "ja543:138.4": "cityā katā yaññakarehi-m-āhūti. ",
  "ja543:139.1": "Ajjhāyakaṃ mantaguṇūpapannaṃ ",
  "ja543:139.2": "tapassinaṃ yācayogoti ",
  "ja543:139.3": "cāha, ",
  "ja543:139.4": "",
  "ja543:140.1": "Āyāgavatthūni puthū pathavyā ",
  "ja543:140.2": "saṃvijjanti brāhmaṇā Vāsavassa, ",
  "ja543:140.3": "purimaṃ disaṃ pacchimaṃ dakkhiṇuttaraṃ ",
  "ja543:140.4": "saṃvijjamānā janayanti vedanti. ",
  "ja543:141.1": "Kalī hi dhīrānaṃ kaṭaṃ magānaṃ ",
  "ja543:141.2": "bhavanti vedajjhagatān' Ariṭṭha ",
  "ja543:141.3": "marīcidhammaṃ asamekkhitattā, ",
  "ja543:141.4": "māyāguṇā nātivahanti paññaṃ. ",
  "ja543:142.1": "Vedā na tāṇāya bhavanti-r-assa ",
  "ja543:142.2": "mittadduno bhūnahuno narassa, ",
  "ja543:142.3": "na tāyate pariciṇṇo ca aggi ",
  "ja543:142.4": "dosantaraṃ maccaṃ anariyakammaṃ. ",
  "ja543:143.1": "Sabbañ ca maccā sadhanā sabhogā ",
  "ja543:143.2": "ādīpitaṃ dāru tiṇena missaṃ ",
  "ja543:143.3": "dahan na tappe asamatthatejo, ",
  "ja543:143.4": "ko taṃ subhikkhaṃ dirasaññu kuriyā. ",
  "ja543:144.1": "Yathāpi khīraṃ viparināmadhammaṃ ",
  "ja543:144.2": "dadhi bhavitvā navanītam pi hoti ",
  "ja543:144.3": "evam pi aggi viparināmadhammo ",
  "ja543:144.4": "tejo samorohatī yogayutto. ",
  "ja543:145.1": "Na dissate aggi-m-anuppaviṭṭho ",
  "ja543:145.2": "sukkhesu kaṭṭhesu navesu cāpi, ",
  "ja543:145.3": "nāmanthamāno araṇīnarena ",
  "ja543:145.4": "nākammanā jāyati jātavedo. ",
  "ja543:146.1": "Sace hi aggi antarato vaseyya ",
  "ja543:146.2": "sukkhesu kaṭṭhesu navesu cāpi ",
  "ja543:146.3": "sabbāni susseyyuṃ vanāni loke ",
  "ja543:146.4": "sukkhāni kaṭṭhāni ca pajjaleyyuṃ. ",
  "ja543:147.1": "Karoti ce dārutiṇena puññaṃ ",
  "ja543:147.2": "bhojaṃ naro dhūmasikhiṃ patāpavaṃ ",
  "ja543:147.3": "aṅgārikā loṇakarā ca sūdā ",
  "ja543:147.4": "sarīradāhāpi kareyyuṃ puññaṃ. ",
  "ja543:148.1": "Atha ce hi ete na karonti puññaṃ ",
  "ja543:148.2": "ajjhenamaggiṃ idha tappayitvā ",
  "ja543:148.3": "na koci lokasmiṃ karoti puññaṃ ",
  "ja543:148.4": "bhojaṃ naro dhūmasikhiṃ patāpavaṃ. ",
  "ja543:149.1": "Kathaṃ hi lokāpacito samāno ",
  "ja543:149.2": "amanuññagandhaṃ bahunnaṃ akantaṃ ",
  "ja543:149.3": "yad eva maccā parivajjayanti ",
  "ja543:149.4": "tad appasatthaṃ dirasaññu bhuñje. ",
  "ja543:150.1": "Sikhiṃ hi devesu vadanti h' eke, ",
  "ja543:150.2": "āpaṃ milakkhā pana devam āhu, ",
  "ja543:150.3": "sabbe va ete vitathaṃ bhaṇanti, ",
  "ja543:150.4": "aggī na devaññataro na cāpo. ",
  "ja543:151.1": "Nirindriyaṃ santaṃ asaññakāyaṃ ",
  "ja543:151.2": "vessānaraṃ kammakaraṃ pajānaṃ ",
  "ja543:151.3": "paricariya-m-aggiṃ sugatiṃ kathaṃ vaje ",
  "ja543:151.4": "pāpāni kammāni pakubbamāno. ",
  "ja543:152.1": "Sabbābhibhū t' āhu 'dha jīvikatthā ",
  "ja543:152.2": "aggissa Brahmā paricārikoti, ",
  "ja543:152.3": "sabbānubhāvī ca vasī kimatthaṃ ",
  "ja543:152.4": "animmito nimmitaṃ vandit' assa. ",
  "ja543:153.1": "Hassaṃ anijjhānakhamaṃ atacchaṃ ",
  "ja543:153.2": "sakkārahetu pakiriṃsu pubbe, ",
  "ja543:153.3": "te lābhasakkāre apātubhonte ",
  "ja543:153.4": "santhambhitā jantuhi santidhammaṃ. ",
  "ja543:154.1": "Ajjhenam ariyā paṭhaviṃ janindā ",
  "ja543:154.2": "vessā kasiṃ pāricariyañ ca suddā ",
  "ja543:154.3": "upāgu paccekaṃ yathā padesaṃ, ",
  "ja543:154.4": "katāhu ete Vasināti āhu. ",
  "ja543:155.1": "Etañ ca saccaṃ vacanaṃ bhaveyya ",
  "ja543:155.2": "yathā idaṃ bhāsitaṃ brāhmaṇehi ",
  "ja543:155.3": "nākhattiyo jātu labhetha rajjaṃ ",
  "ja543:155.4": "nābrāhmaṇo mantapadāni sikkhe ",
  "ja543:155.5": "nāññatra vessehi kasiṃ kareyya ",
  "ja543:155.6": "suddo na muñce parapessitāya. ",
  "ja543:156.1": "Yasmā ca etaṃ vacanaṃ abhūtaṃ ",
  "ja543:156.2": "musā c' ime odariyā bhaṇanti ",
  "ja543:156.3": "tad appapaññā abhisaddahanti ",
  "ja543:156.4": "passanti taṃ paṇḍitā attanā va. Khattā ",
  "ja543:157.1": "na vessā na baliṃ haranti, ",
  "ja543:157.2": "ādāya satthāni caranti brāhmaṇā, ",
  "ja543:157.3": "tan tādisaṃ saṃkhubhitaṃ vibhinnaṃ ",
  "ja543:157.4": "kasmā Brahmā n' ujjukaroti lokaṃ. ",
  "ja543:158.1": "Sace hi so issaro sabbaloke ",
  "ja543:158.2": "Brahmā bahūbhūtapatī pajānaṃ ",
  "ja543:158.3": "kiṃ sabbaloke vidahī alakkhiṃ ",
  "ja543:158.4": "kiṃ sabbalokaṃ na sukhiṃ akāsi. ",
  "ja543:159.1": "Sace hi so issaro sabbaloke ",
  "ja543:159.2": "Brahmā bahūbhūtapatī pajānaṃ ",
  "ja543:159.3": "māyāmusāvajjamadena cāpi ",
  "ja543:159.4": "lokaṃ adhammena kimatth' akāsi. ",
  "ja543:160.1": "Sace hi so issaro sabbaloke ",
  "ja543:160.2": "Brahmā bahūbhūtapatī pajānaṃ ",
  "ja543:160.3": "adhammiyo bhūtapatī Ariṭṭha ",
  "ja543:160.4": "dhamme satī yo vidahī adhammaṃ. ",
  "ja543:161.1": "Kīṭā paṭaṅgā uragā ca bhekā ",
  "ja543:161.2": "hantvā kimiṃ sujjhati makkhikā ca, ",
  "ja543:161.3": "ete hi dhammā anariyarūpā ",
  "ja543:161.4": "Kambojakānaṃ vitathā bahunnanti. ",
  "ja543:162.1": "Sace hi so sujjhati yo hanāti ",
  "ja543:162.2": "hato pi so saggam upeti ṭhānaṃ ",
  "ja543:162.3": "",
  "ja543:162.4": "",
  "ja543:163.1": "N' evā migā na-ppasu no pi gāvo ",
  "ja543:163.2": "āyācanti attavadhāya keci ",
  "ja543:163.3": "vipphandamānā idha jīvikatthā, ",
  "ja543:163.4": "yaññesu pāṇe pasum āharanti. ",
  "ja543:164.1": "Yūpassa ne pasubandhe ca bālā ",
  "ja543:164.2": "cittehi vaṇṇehi mukhan nayanti: ",
  "ja543:164.3": "ayan te yūpo kāmaduho parattha ",
  "ja543:164.4": "bhavissati sassato samparāye. ",
  "ja543:165.1": "Sace ca yūpe maṇisaṃkhamuttaṃ ",
  "ja543:165.2": "dhaññaṃ dhanaṃ rajataṃ jātarūpaṃ ",
  "ja543:165.3": "sukkhesu kaṭṭhesu navesu cāpi ",
  "ja543:165.4": "sace duhe tidive sabbakāme ",
  "ja543:165.5": "tevijjasaṃghā ca puthū yajeyyuṃ ",
  "ja543:165.6": "na brāhmaṇaṃ kañci taṃ yājayeyyuṃ. ",
  "ja543:166.1": "Kuto ca yūpe maṇisaṃkhamuttaṃ ",
  "ja543:166.2": "dhaññaṃ dhanaṃ rajataṃ jātarūpaṃ ",
  "ja543:166.3": "sukkhesu kaṭṭhesu navesu cāpi, ",
  "ja543:166.4": "kuto duhe tidive sabbakāme. ",
  "ja543:167.1": "Saṭhā ca luddā upaladdhabālā ",
  "ja543:167.2": "cittehi vaṇṇehi mukhan nayanti: ",
  "ja543:167.3": "ādāya aggiṃ mama dehi vittaṃ ",
  "ja543:167.4": "tato sukhī hohisi sabbakāme. ",
  "ja543:168.1": "Tam aggihuttaṃ saraṇaṃ pavissa ",
  "ja543:168.2": "cittehi vaṇṇehi mukhan nayanti, ",
  "ja543:168.3": "oropayitvā kesamassuṃ nakhañ ca ",
  "ja543:168.4": "vedehi vittaṃ atigāḷayanti. ",
  "ja543:169.1": "Kākā ulūkaṃ va raho labhitvā ",
  "ja543:169.2": "ekaṃ samānaṃ bahukā samecca ",
  "ja543:169.3": "Evaṃ ",
  "ja543:169.4": "hi ",
  "ja543:170.1": "so vañcito brāhmaṇehi ",
  "ja543:170.2": "eko samāno, bahukā samecca ",
  "ja543:170.3": "te yogayogena vilumpamānā ",
  "ja543:170.4": "diṭṭhaṃ adiṭṭhena dhanaṃ haranti. ",
  "ja543:171.1": "Akāsiyā rājuhi vānusiṭṭhā ",
  "ja543:171.2": "tad assa ādāya dhanaṃ haranti, ",
  "ja543:171.3": "te tādisā corasamā asantā ",
  "ja543:171.4": "vajjhā na haññanti Ariṭṭha loke. ",
  "ja543:172.1": "Indassa bāhā-r-asi dakkhiṇāti ",
  "ja543:172.2": "yaññesu chindanti palāsayaṭṭhiṃ, ",
  "ja543:172.3": "taṃ ce pi saccaṃ Maghavā chinnabāhu ",
  "ja543:172.4": "ken' assa Indo asure jināti. ",
  "ja543:173.1": "Tañ c' eva tucchaṃ, Maghavā samaṅgī ",
  "ja543:173.2": "hantā avajjho paramo sa devo, ",
  "ja543:173.3": "mantā ime brāhmaṇā tuccharūpā ",
  "ja543:173.4": "sandiṭṭhiyā vañcanā esa loke. ",
  "ja543:174.1": "Mālāgiri Himavā yo ca Gijjho (= p. 204,13) ",
  "ja543:174.2": "Sudassano Nisabho Kākaneru ",
  "ja543:174.3": "ete ca aññe ca nagā mahantā ",
  "ja543:174.4": "cityā katā yaññakarehi-m-āhu. ",
  "ja543:175.1": "Yathappakārāni hi iṭṭhakāni ",
  "ja543:175.2": "cityā katā yaññakarehi-m-āhu ",
  "ja543:175.3": "na pabbatā honti tathappakārā ",
  "ja543:175.4": "aññādisā acalā tiṭṭhaselā. ",
  "ja543:176.1": "Na iṭṭhakā honti silā cirena pi, ",
  "ja543:176.2": "na tattha sañjāyati ayo na lohaṃ, ",
  "ja543:176.3": "",
  "ja543:176.4": "",
  "ja543:177.1": "Ajjhāyakaṃ mantaguṇūpapannaṃ ",
  "ja543:177.2": "tapassinaṃ yācayogoti-m-āhu, ",
  "ja543:177.3": "tīre samuddass' udakaṃ sajantaṃ ",
  "ja543:177.4": "taṃ sāgar' ajjhohari ten' apeyyo. ",
  "ja543:178.1": "Parosahassam pi samantavede ",
  "ja543:178.2": "mantūpapanne nadiyo vahanti, ",
  "ja543:178.3": "na tena vyāpannarasūdakā naṃ, ",
  "ja543:178.4": "kasmā samuddo atulo apeyyo. ",
  "ja543:179.1": "Ye keci kūpā idha jīvaloke ",
  "ja543:179.2": "loṇūdakā kūpakhaṇehi khātā ",
  "ja543:179.3": "na brāhmaṇajjhoharanena tesu ",
  "ja543:179.4": "āpo apeyyo dirasaññu-r-āhu. ",
  "ja543:180.1": "Pure puratthā kā kassa bhariyā, ",
  "ja543:180.2": "mano manussam ajanesi pubbe, ",
  "ja543:180.3": "tenāpi dhammena na koci hīno, ",
  "ja543:180.4": "evam pi vossaggavibhaṅgam āhu. ",
  "ja543:181.1": "Caṇḍālaputto pi adhicca vede ",
  "ja543:181.2": "bhāseyya mante kusalo mutīmā, ",
  "ja543:181.3": "na tassa muddhāpi phaleyya sattadhā, ",
  "ja543:181.4": "mantā ime attavadhāya kattā. Vācā katā ",
  "ja543:182.1": "giddhikatā gahītā ",
  "ja543:182.2": "dummocayā kavyāpathānupannā, ",
  "ja543:182.3": "bālāna cittaṃ visame niviṭṭhaṃ ",
  "ja543:182.4": "tad appapaññā abhisaddahanti. ",
  "ja543:183.1": "Sīhassa vyagghassa ca dīpino ca ",
  "ja543:183.2": "na vijjatī porisiyaṃ balena, ",
  "ja543:183.3": "manussabhāvo ca gavaṃ va pekkho ",
  "ja543:183.4": "jāti hi tesaṃ asamā samānā. ",
  "ja543:184.1": "Sace ca rājā paṭhaviṃ vijitvā ",
  "ja543:184.2": "sajīvavā assavo pārisajjo ",
  "ja543:184.3": "sayam eva so sattusaṃghaṃ vijeyya ",
  "ja543:184.4": "tassa pajā niccasukhā bhaveyya. ",
  "ja543:185.1": "Khattiyamantā ca tayo ca vedā ",
  "ja543:185.2": "atthena ete samakā bhavanti, ",
  "ja543:185.3": "tesañ ca atthaṃ avinicchinitvā ",
  "ja543:185.4": "na bujjhatī oghapathaṃ va channaṃ. ",
  "ja543:186.1": "Khattiyamantā ca tayo ca vedā ",
  "ja543:186.2": "atthena ete samakā bhavanti, ",
  "ja543:186.3": "lābho alābho ayaso yaso ca ",
  "ja543:186.4": "sabbe te sabbesaṃ catunna dhammā. ",
  "ja543:187.1": "Yathāpi ibbhā dhanadhaññahetu ",
  "ja543:187.2": "kammāni kārenti puthū ",
  "ja543:187.3": "pathavyā tevijjasaṃghāpi tath' eva ajja ",
  "ja543:187.4": "kammāni kārenti puthū pathavyā. ",
  "ja543:188.1": "Ibbhā hi ete samakā bhavanti, ",
  "ja543:188.2": "niccossukā kāmaguṇesu yuttā ",
  "ja543:188.3": "kammāni kārenti puthū pathavyā, ",
  "ja543:188.4": "tad appapaññā dirasaññu ārāti. ",
  "ja543:189.1": "",
  "ja543:190.1": "Kassa bherī mutiṅgā ca ",
  "ja543:190.2": "saṃkhā paṇavadeṇḍimā (V 322|4) ",
  "ja543:190.3": "purato paṭipannāni ",
  "ja543:190.4": "hāsayantā rathesabhaṃ. ",
  "ja543:191.1": "Kassa kañcanapaṭṭena ",
  "ja543:191.2": "puthunā vijjuvaṇṇinā ",
  "ja543:191.3": "yuvā kalāpasannaddho, ",
  "ja543:191.4": "ko eti siriyā jalaṃ. ",
  "ja543:192.1": "Ukkāmukhe pahaṭṭhaṃ va ",
  "ja543:192.2": "khadiraṅgārasannibhaṃ ",
  "ja543:192.3": "mukhaṃ cāru-r-ivābhāti, ",
  "ja543:192.4": "ko eti siriyā jalaṃ. ",
  "ja543:193.1": "Kassa jambonadaṃ chattaṃ ",
  "ja543:193.2": "sasalākaṃ manoramaṃ ",
  "ja543:193.3": "ādiccaraṃsāvaraṇaṃ, ",
  "ja543:193.4": "ko eti siriyā jalaṃ. ",
  "ja543:194.1": "Kassa aṃkaṃ pariggayha ",
  "ja543:194.2": "vālavījanim uttamaṃ ",
  "ja543:194.3": "carate varapaññassa ",
  "ja543:194.4": "muddhani uparūpari. ",
  "ja543:195.1": "Kassa pekhuṇahatthāni ",
  "ja543:195.2": "vicitrāni mudūni ca ",
  "ja543:195.3": "tapaññamaṇidaṇḍāni ",
  "ja543:195.4": "caranti ubhatomukhaṃ. ",
  "ja543:196.1": "Khadiraṅgāravaṇṇābhā ",
  "ja543:196.2": "ukkāmukhapahaṃsitā ",
  "ja543:196.3": "kass' ete kuṇḍalā vaggū ",
  "ja543:196.4": "sobhanti ubhatomukhaṃ. ",
  "ja543:197.1": "Kassa vātena chupitā ",
  "ja543:197.2": "niddhantā mudukāḷakā ",
  "ja543:197.3": "sobhayanti nalāṭantaṃ ",
  "ja543:197.4": "nabhā vijju-r-iv' uggatā. ",
  "ja543:198.1": "Kassa etāni akkhīni ",
  "ja543:198.2": "āyatāni puthūni ca, ",
  "ja543:198.3": "ko sobhati visālakkho, ",
  "ja543:198.4": "kass' etaṃ uṇṇajaṃ mukhaṃ. ",
  "ja543:199.1": "Kassa te lapanajā ",
  "ja543:199.2": "suddhā suddhasaṃkhavarūpamā ",
  "ja543:199.3": "bhāsamānassa sobhanti ",
  "ja543:199.4": "dantā kuppilasādisā. ",
  "ja543:200.1": "Kassa lākhārasasamā ",
  "ja543:200.2": "hatthapādā sukhe ṭhitā, ",
  "ja543:200.3": "ko so bimboṭṭhasampanno ",
  "ja543:200.4": "divā suriyo va bhāsati. ",
  "ja543:201.1": "Himaccaye hemavato brahāsālo ",
  "ja543:201.2": "va pupphito ",
  "ja543:201.3": "ko so odātapāvāro ",
  "ja543:201.4": "jayaṃ Indo va sobhati. ",
  "ja543:202.1": "Suvaṇṇapilakākiṇṇaṃ ",
  "ja543:202.2": "maṇidaṇḍavicittitaṃ ",
  "ja543:202.3": "ko so parisam ogayha ",
  "ja543:202.4": "īso khaggaṃ va muñcati ",
  "ja543:203.1": "Suvaṇṇacitakā citrā ",
  "ja543:203.2": "sukatā citrasibbanā ",
  "ja543:203.3": "ko so omuñcate pādā ",
  "ja543:203.4": "namo katvā mahesinoti. ",
  "ja543:204.1": "Dhātaraṭṭhā hi te nāgā ",
  "ja543:204.2": "iddhimanto yasassino ",
  "ja543:204.3": "Samuddajāya uppannā ",
  "ja543:204.4": "nāgā ete mahiddhikāti. ",
  "ja543:205.1": ""
}
