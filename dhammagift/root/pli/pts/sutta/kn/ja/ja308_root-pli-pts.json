  "ja308:1.1": "te kiccaṃ ",
  "ja308:1.2": "yaṃ balaṃ ahuvamhase, (cfr. Dhp. p. 147,1) ",
  "ja308:1.3": "migarāja namo ty-atthu, ",
  "ja308:1.4": "api kiñci labhāmase. ",
  "ja308:2.1": "Mama lohitabhakkhassa ",
  "ja308:2.2": "niccaṃ luddāni kubbato ",
  "ja308:2.3": "dantantaragato santo ",
  "ja308:2.4": "taṃ bahuṃ yaṃ hi jīvasīti. ",
  "ja308:3.1": "Akataññuṃ akattāraṃ ",
  "ja308:3.2": "katassa appatikārakaṃ ",
  "ja308:3.3": "yasmiṃ kataññutā n' atthi ",
  "ja308:3.4": "niratthā tassa sevanā. ",
  "ja308:4.1": "Yassa sammukhaciṇṇena ",
  "ja308:4.2": "mittadhammo na labbhati ",
  "ja308:4.3": "anusuyyam anakkosaṃ ",
  "ja308:4.4": "sanikaṃ tamhā apakkameti. Sabbam idaṃ carimavataṃ, ",
  "ja308:5.1": ""
}
