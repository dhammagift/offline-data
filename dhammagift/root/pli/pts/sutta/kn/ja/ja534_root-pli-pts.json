{
  "ja534:0.1": "",
  "ja534:0.2": "",
  "ja534:0.3": "",
  "ja534:0.4": "",
  "ja534:1.1": "Ete haṃsā pakkamanti ",
  "ja534:1.2": "vakkaṅgā bhayameritā, (IV 424|16) ",
  "ja534:1.3": "harittaca hemavaṇṇa ",
  "ja534:1.4": "kāmaṃ Sumukha pakkama. ",
  "ja534:2.1": "Ohāya maṃ ñātigaṇā ",
  "ja534:2.2": "ekaṃ pāsavasaṃ gataṃ ",
  "ja534:2.3": "anapekkhamānā gacchanti, ",
  "ja534:2.4": "kiṃ eko avahiyyasi. ",
  "ja534:3.1": "Pat' eva patataṃ seṭṭha, ",
  "ja534:3.2": "n' atthi baddhe sahāyatā, ",
  "ja534:3.3": "mā anīghāya hāpesi, ",
  "ja534:3.4": "kāmaṃ Sumukha pakkamāti. ",
  "ja534:4.1": "Nāhaṃ dukkhapareto pi ",
  "ja534:4.2": "dhataraṭṭha tavaṃ jahe, ",
  "ja534:4.3": "jīvitaṃ maraṇaṃ vā me ",
  "ja534:4.4": "tayā saddhiṃ bhavissati. ",
  "ja534:5.1": "Nāhaṃ dukkhapareto pi ",
  "ja534:5.2": "dhataraṭṭha tavaṃ jahe. ",
  "ja534:5.3": "na maṃ anariyasaṃyutte ",
  "ja534:5.4": "kamme yojetum arahasi. ",
  "ja534:6.1": "Sakumāro sakhā ty-asmi ",
  "ja534:6.2": "sacitte samite ṭhito, ",
  "ja534:6.3": "ñāto senāpati ty-āhaṃ ",
  "ja534:6.4": "haṃsānaṃ pavaruttama. ",
  "ja534:7.1": "Kathaṃ ahaṃ vikattissaṃ ",
  "ja534:7.2": "ñātimajjhe ito gato, ",
  "ja534:7.3": "taṃ hitvā patataṃ seṭṭha ",
  "ja534:7.4": "kin te vakkhām' ito gato. ",
  "ja534:7.5": "idha pāṇaṃ cajissāmi, ",
  "ja534:7.6": "na anariyaṃ kattum ussaheti. ",
  "ja534:8.1": "Eso hi dhammo Sumukha ",
  "ja534:8.2": "yaṃ tvaṃ ariyapathe ṭhito ",
  "ja534:8.3": "yo bhattāraṃ sakhāram maṃ ",
  "ja534:8.4": "na paricattum ussahe. ",
  "ja534:9.1": "Taṃ hi me pekkhamānassa ",
  "ja534:9.2": "bhayaṃ na tv-eva jāyati, ",
  "ja534:9.3": "adhigacchasi tvaṃ mayhaṃ ",
  "ja534:9.4": "evaṃbhūtassa jīvitanti. Icc- ",
  "ja534:10.1": "eva mantayantānaṃ ",
  "ja534:10.2": "ariyānaṃ ariyavattinaṃ ",
  "ja534:10.3": "daṇḍam ādāya nesādo ",
  "ja534:10.4": "āpadī turito bhusaṃ. ",
  "ja534:11.1": "Tam āpatantaṃ disvāna ",
  "ja534:11.2": "Sumukho aparibrūhayi, ",
  "ja534:11.3": "aṭṭhāsi purato rañño ",
  "ja534:11.4": "haṃso vissāsayaṃ vyathaṃ. ",
  "ja534:12.1": "Mā bhāyi patataṃ seṭṭha, ",
  "ja534:12.2": "na hi bhāyanti tādisā. ",
  "ja534:12.3": "ahaṃ yogaṃ payuñjissaṃ ",
  "ja534:12.4": "yuttaṃ dhammūpasaṃhitaṃ ",
  "ja534:12.5": "tena pariyāpadānena ",
  "ja534:12.6": "khippaṃ pāsā pamokkhasīti. ",
  "ja534:13.1": "Tassa taṃ vacanaṃ sutvā ",
  "ja534:13.2": "Sumukhassa subhāsitaṃ ",
  "ja534:13.3": "pahaṭṭhalomo nesādo ",
  "ja534:13.4": "añjali 'ssa paṇāmayi. ",
  "ja534:14.1": "Na me sutaṃ vā diṭṭhaṃ vā ",
  "ja534:14.2": "bhāsanto mānusiṃ dijo ",
  "ja534:14.3": "ariyaṃ bruvāno vakkaṅgo ",
  "ja534:14.4": "cajanto mānusiṃ giraṃ. ",
  "ja534:15.1": "Kin nu t' āyaṃ dijo hoti. ",
  "ja534:15.2": "mutto baddhaṃ upāsayi, ",
  "ja534:15.3": "ohāya sakuṇā yanti, ",
  "ja534:15.4": "kiṃ eko avahiyyasīti. ",
  "ja534:16.1": "Rājā me so dijāmittā, ",
  "ja534:16.2": "sanāpacc' assa kārayiṃ, ",
  "ja534:16.3": "tam āpade pariccattuṃ ",
  "ja534:16.4": "n' ussahe vihagādhipaṃ. ",
  "ja534:17.1": "Mahāgaṇāya bhattā me ",
  "ja534:17.2": "mā eko vyasanaṃ agā, ",
  "ja534:17.3": "tathā taṃ samma nesāda: ",
  "ja534:17.4": "bhattāyaṃ, abhito rameti. ",
  "ja534:18.1": "Ariyavatt' asi vakkaṅga ",
  "ja534:18.2": "yo piṇḍam apacāyasi, ",
  "ja534:18.3": "cajāmite taṃ bhattāraṃ, ",
  "ja534:18.4": "gacchatu bho yathāsukhanti. ",
  "ja534:19.1": "Sace attappayogena ",
  "ja534:19.2": "ohito haṃsapakkhinaṃ ",
  "ja534:19.3": "patigaṇhāma te samma ",
  "ja534:19.4": "etaṃ abhayadakkhiṇaṃ. ",
  "ja534:20.1": "Noce attappayogena ",
  "ja534:20.2": "ohito haṃsapakkhinaṃ ",
  "ja534:20.3": "anissaro muñcaṃ amhe ",
  "ja534:20.4": "theyyaṃ kayirāsi luddakāti. ",
  "ja534:21.1": "Yassa tvaṃ bhatako rañño ",
  "ja534:21.2": "kāmaṃ tass' eva pāpaya. ",
  "ja534:21.3": "tattha saṃyamāno rājā ",
  "ja534:21.4": "yathābhiññaṃ karissatīti g. ā. ",
  "ja534:22.1": "Icc-eva vutto nesādo ",
  "ja534:22.2": "hemavaṇṇe harittace ",
  "ja534:22.3": "ubhohatthehi saṃgayha ",
  "ja534:22.4": "pañjare ajjhavodahi. ",
  "ja534:23.1": "Te pañjaragate pakkhī ",
  "ja534:23.2": "ubho bhassaravaṇṇine ",
  "ja534:23.3": "Sumukhaṃ dhataratthañ ca ",
  "ja534:23.4": "luddo ādāya pakkamīti. ",
  "ja534:24.1": "Hariyyamāno dhataraṭṭho ",
  "ja534:24.2": "Sumukhaṃ etad abravi: ",
  "ja534:24.3": "bāḷhaṃ bhāyāmi Sumukha ",
  "ja534:24.4": "sāmāya lakkhaṇūruyā ",
  "ja534:24.5": "asmākaṃ vadham aññāya ",
  "ja534:24.6": "ath' attānaṃ vadhissati. ",
  "ja534:25.1": "Pākahaṃsā ca Sumukha ",
  "ja534:25.2": "Suhemā hemasuttacā ",
  "ja534:25.3": "koñcī samuddatīre va ",
  "ja534:25.4": "kapaṇā nūna rucchatīti. ",
  "ja534:26.1": "Evaṃmahanto lokassa ",
  "ja534:26.2": "appameyyo mahāgaṇī ",
  "ja534:26.3": "ekitthim anusoceyya, na idaṃ paññavato- ",
  "ja534:26.4": "m-iva. ",
  "ja534:27.1": "Vāto va gandham ādeti ",
  "ja534:27.2": "ubhayaṃ chekapāpakaṃ ",
  "ja534:27.3": "bālo āmakapakkaṃ va ",
  "ja534:27.4": "lolo andho va āmisaṃ. ",
  "ja534:28.1": "Avinicchayaññū atthesu ",
  "ja534:28.2": "mando va paṭibhāsi maṃ, ",
  "ja534:28.3": "kiccākiccaṃ na jānāsi ",
  "ja534:28.4": "sampatto kālapariyāyaṃ ",
  "ja534:29.1": "Aḍḍhummatto udīresi ",
  "ja534:29.2": "yo seyyā maññas' itthiyo, ",
  "ja534:29.3": "bahū sādhāraṇā h' etā ",
  "ja534:29.4": "soṇḍānaṃ va surāgharaṃ. ",
  "ja534:30.1": "Māyā c' esā marīci ca ",
  "ja534:30.2": "soko rogo c' upaddavo, (II 330|19) ",
  "ja534:30.3": "kharā ca bandhanā c' etā ",
  "ja534:30.4": "maccupāso guhāsayo, ",
  "ja534:30.5": "tāsu yo vissase poso ",
  "ja534:30.6": "so naresu narādhamoti. ",
  "ja534:31.1": "Yaṃ vuddhehi upaññātaṃ ",
  "ja534:31.2": "ko taṃ ninditum arahati, ",
  "ja534:31.3": "mahābhūt' itthiyo nāma ",
  "ja534:31.4": "lokasmiṃ upapajjisuṃ. ",
  "ja534:32.1": "Khiḍḍā paṇihitā tyāsu, ",
  "ja534:32.2": "ratī tyāsu patiṭṭhitā, ",
  "ja534:32.3": "bījāni tyāsu rūhanti ",
  "ja534:32.4": "yadidaṃ sattā pajāyare, ",
  "ja534:32.5": "tāsu ko nibbide poso ",
  "ja534:32.6": "pāṇaṃ āsajja pāṇibhi. ",
  "ja534:33.1": "Tvam eva n' añño Sumukha ",
  "ja534:33.2": "thīnaṃ atthesu yuñjasi, ",
  "ja534:33.3": "tassa ty-ajja bhaye jāte ",
  "ja534:33.4": "bhītena jāyate mati. ",
  "ja534:34.1": "Sabbo hi saṃsayaṃ patto ",
  "ja534:34.2": "bhayaṃ bhīru titikkhati, ",
  "ja534:34.3": "paṇḍitā ca mahantā no ",
  "ja534:34.4": "atthe yuñjanti duyyuje. ",
  "ja534:35.1": "Etadatthāya rājāno ",
  "ja534:35.2": "sūram icchanti mantinaṃ ",
  "ja534:35.3": "paṭibāhati yaṃ sūro ",
  "ja534:35.4": "āpadaṃ attapariyāyaṃ. ",
  "ja534:36.1": "Mā no ajja vikantiṃsu ",
  "ja534:36.2": "rañño sūdā mahānase, ",
  "ja534:36.3": "tathā hi vaṇṇo paṭṭānaṃ ",
  "ja534:36.4": "phalaṃ veḷuṃ va taṃ vadhi. ",
  "ja534:37.1": "Mutto pi na icchi uḍḍetuṃ, ",
  "ja534:37.2": "sayaṃ bandhaṃ upāgami, ",
  "ja534:37.3": "so p' ajja saṃsayaṃ patto ",
  "ja534:37.4": "atthaṃ gaṇhāhi mā mukhanti. ",
  "ja534:38.1": "So tvaṃ yogaṃ payuñjassu ",
  "ja534:38.2": "yuttaṃ dhammūpasaṃhitaṃ, ",
  "ja534:38.3": "tava pariyāpadānena ",
  "ja534:38.4": "mama pāṇesanaṃ carāti. ",
  "ja534:39.1": "Mā bhāyi patataṃ seṭṭha, ",
  "ja534:39.2": "na hi bhāyanti tādisā, ",
  "ja534:39.3": "ahaṃ yogaṃ payuñjissaṃ ",
  "ja534:39.4": "yuttaṃ dhammūpasaṃhitaṃ, ",
  "ja534:39.5": "mama pariyāpapadānena ",
  "ja534:39.6": "khippaṃ pāsā pamokkhasīti. ",
  "ja534:40.1": "So luddo haṃsakācena ",
  "ja534:40.2": "rājadvāraṃ upāgami, ",
  "ja534:40.3": "paṭivedetha maṃ rañño: ",
  "ja534:40.4": "dhataraṭṭh' āyam āgatoti. ",
  "ja534:41.1": "Te disvā puññasaṃkāse ",
  "ja534:41.2": "ubho lakkhaññasammate ",
  "ja534:41.3": "khalu saññamāno rājā ",
  "ja534:41.4": "amacce ajjhabhāsatha: ",
  "ja534:42.1": "Dettha luddassa vatthāni ",
  "ja534:42.2": "annapānañ ca bhojanaṃ, ",
  "ja534:42.3": "kāmaṃkaro hiraññ' assa ",
  "ja534:42.4": "yāvanto eva icchatīti. ",
  "ja534:43.1": "Disvā luddaṃ pasannattaṃ ",
  "ja534:43.2": "Kāsirājā tadābravī: ",
  "ja534:43.3": "yad'āyaṃ samma Khemaka ",
  "ja534:43.4": "puṇṇā haṃsehi tiṭṭhati ",
  "ja534:44.1": "Kathaṃ ruciṃ majjhagataṃ ",
  "ja534:44.2": "pāsahattho upāgami. ",
  "ja534:44.3": "okiṇṇaṃ ñātisaṃghehi ",
  "ja534:44.4": "nimajjhimaṃ kathaṃ gahīti. ",
  "ja534:45.1": "Ajja me sattamā ratti ",
  "ja534:45.2": "ādānāni upāsato, ",
  "ja534:45.3": "padam etassa anvesaṃ ",
  "ja534:45.4": "appamatto bhavassito. ",
  "ja534:46.1": "Ath' assa padaṃ addakkhiṃ ",
  "ja534:46.2": "carato ādanesanaṃ, ",
  "ja534:46.3": "tatthāhaṃ odahiṃ pāsaṃ, ",
  "ja534:46.4": "ev' etaṃ dijam aggahinti. ",
  "ja534:47.1": "Ludda dve ime sakuṇā, ",
  "ja534:47.2": "atha ekoti bhāsasi, ",
  "ja534:47.3": "cittan nu te vipariyatthaṃ ",
  "ja534:47.4": "ādu kin nu jigiṃsasīti. ",
  "ja534:48.1": "Yassa lohitakā tālā ",
  "ja534:48.2": "tapaneyyanibhā subhā ",
  "ja534:48.3": "uraṃ saṃhacca tiṭṭhanti ",
  "ja534:48.4": "so me bandhaṃ upāgami. ",
  "ja534:49.1": "Athāyaṃ bhassaro pakkhī ",
  "ja534:49.2": "abaddho baddham āturaṃ ",
  "ja534:49.3": "ariyaṃ bruvāno aṭṭhāsi ",
  "ja534:49.4": "cajanto mānusiṃ giranti. ",
  "ja534:50.1": "Atha kin nu dāni Sumukha ",
  "ja534:50.2": "hanū saṃhacca tiṭṭhasi ",
  "ja534:50.3": "adu me parisaṃ patto ",
  "ja534:50.4": "bhayā bhīto no bhāsasīti. ",
  "ja534:51.1": "Nāhaṃ Kāsipati bhīto ",
  "ja534:51.2": "ogayha parisan tava, ",
  "ja534:51.3": "nāhaṃ bhayā na bhāsissaṃ ",
  "ja534:51.4": "vākyaṃ atthasmiṃ tādiseti. ",
  "ja534:52.1": "Na te abhisaraṃ passe ",
  "ja534:52.2": "na rathe nāpi pattike ",
  "ja534:52.3": "nāssa cammaṃ vā kīṭaṃ vā ",
  "ja534:52.4": "vammine ca dhanuggahe ",
  "ja534:53.1": "Na hiraññaṃ suvaṇṇaṃ vā ",
  "ja534:53.2": "nagaraṃ vā sumāpitaṃ ",
  "ja534:53.3": "otiṇṇaṃ parikhaṃ duggaṃ ",
  "ja534:53.4": "daḷham aṭṭālakkoṭṭhakaṃ ",
  "ja534:53.5": "yattha paviṭṭho Sumukha ",
  "ja534:53.6": "bhāyitabbaṃ na bhāyasīti. ",
  "ja534:54.1": "Na me abhisaren' attho ",
  "ja534:54.2": "nagarena dhanena vā, ",
  "ja534:54.3": "apathena pathaṃ yāma ",
  "ja534:54.4": "antalikkhecarā mayaṃ. ",
  "ja534:55.1": "Sutā ca paṇḍitā ty-amhā ",
  "ja534:55.2": "nipuṇā atthacintakā, ",
  "ja534:55.3": "bhāsem' atthavatiṃ vācaṃ ",
  "ja534:55.4": "sacce c' assa patiṭṭhito. ",
  "ja534:56.1": "Kiñ ca tuyhaṃ asaccassa ",
  "ja534:56.2": "anariyassa karissati ",
  "ja534:56.3": "musāvadissa luddassa ",
  "ja534:56.4": "bhaṇitam pi subhāsitanti. ",
  "ja534:57.1": "Taṃ brāhmaṇānaṃ vācanā ",
  "ja534:57.2": "imaṃ Khemiṃ akārayi, ",
  "ja534:57.3": "abhayañ ca tayā ghuṭṭhaṃ ",
  "ja534:57.4": "imāyo dasadhā disā. ",
  "ja534:58.1": "Ogayha te pokkharaṇiṃ ",
  "ja534:58.2": "vippasannodakaṃ suciṃ ",
  "ja534:58.3": "pahūtaṃ cādanam tattha ",
  "ja534:58.4": "ahiṃsā c' ettha pakkhinaṃ. ",
  "ja534:59.1": "Idaṃ sutvāna nigghosaṃ ",
  "ja534:59.2": "āgat' asmā tav' antike, ",
  "ja534:59.3": "te te baddh' asmā pāsena, ",
  "ja534:59.4": "etaṃ te bhāsitaṃ musā. ",
  "ja534:60.1": "Musāvādaṃ purakkhatvā ",
  "ja534:60.2": "icchālobhañ ca pāpakaṃ ",
  "ja534:60.3": "ubho sandhiṃ atikkamma ",
  "ja534:60.4": "asātaṃ upapajjatīti. ",
  "ja534:61.1": "Nāparajjhāma Sumukha, ",
  "ja534:61.2": "na pi lobhā vam aggahiṃ, ",
  "ja534:61.3": "sutā ca paṇḍitā ty-attha ",
  "ja534:61.4": "nipuṇā atthacintakā. ",
  "ja534:62.1": "Appev' atthavatiṃ vācaṃ ",
  "ja534:62.2": "vyākareyyuṃ idhāgatā, ",
  "ja534:62.3": "tathā taṃ samma nesādo ",
  "ja534:62.4": "vutto Sumukha-m-aggahīti. ",
  "ja534:63.1": "N' eva bhītā Kāsipati ",
  "ja534:63.2": "upanītasmiṃ jīvite, ",
  "ja534:63.3": "bhāsem' atthavatiṃ vācaṃ ",
  "ja534:63.4": "sampattā kālapariyāyaṃ. ",
  "ja534:64.1": "Yo migena migaṃ hanti ",
  "ja534:64.2": "pakkhiṃ vā pana pakkhinā ",
  "ja534:64.3": "sutena vā sutaṃ kiṇe ",
  "ja534:64.4": "ki anariyataraṃ tato. ",
  "ja534:65.1": "Yo ca ariyarudaṃ bhāse ",
  "ja534:65.2": "anariyadhamm' avassito ",
  "ja534:65.3": "ubho so dhaṃsate lokā ",
  "ja534:65.4": "idha c' eva parattha ca. ",
  "ja534:66.1": "Na majjetha yasaṃ patto, ",
  "ja534:66.2": "na vyathe pattasaṃsayaṃ, ",
  "ja534:66.3": "vāyameth' eva kiccesu, ",
  "ja534:66.4": "saṃvare vivarāni ca. ",
  "ja534:67.1": "Ye vaddhā abbhatikkantā ",
  "ja534:67.2": "sampattā kālapariyāyan ",
  "ja534:67.3": "idha dhammaṃ caritvāna ",
  "ja534:67.4": "ev' ete tidivaṃ gatā. ",
  "ja534:68.1": "Idaṃ sutvā Kāsipati ",
  "ja534:68.2": "dhammam attani pālaya ",
  "ja534:68.3": "dhataraṭṭhañ ca muñcāhi ",
  "ja534:68.4": "haṃsānaṃ pavaruttamanti. ",
  "ja534:69.1": "Āharant' udakaṃ pajjaṃ ",
  "ja534:69.2": "āsanañ ca mahārahaṃ ",
  "ja534:69.3": "pañjarato pamokkhāmi ",
  "ja534:69.4": "dhataraṭṭhaṃ yasassinaṃ ",
  "ja534:70.1": "Tañ ca senāpatiṃ dhiraṃ ",
  "ja534:70.2": "nipuṇaṃ atthacintakaṃ ",
  "ja534:70.3": "yo sukhe sukhito rañño ",
  "ja534:70.4": "dukkhite hoti dukkhito. ",
  "ja534:71.1": "Etādiso kho arahati ",
  "ja534:71.2": "piṇḍam asnātu bhattuno ",
  "ja534:71.3": "yathāyaṃ Sumukho rañño ",
  "ja534:71.4": "pāṇasādhāraṇo sakhāti. Piṭṭhañ ",
  "ja534:72.1": "ca sabbasovaṇṇaṃ ",
  "ja534:72.2": "aṭṭhapādaṃ manoramaṃ ",
  "ja534:72.3": "maṭṭhaṃ kāsikavatthinaṃ ",
  "ja534:72.4": "dhataraṭṭho upāvisi. ",
  "ja534:73.1": "Kocchañ ca sabbasovaṇṇaṃ ",
  "ja534:73.2": "veyyagghaparisibbitaṃ ",
  "ja534:73.3": "Sumukho ajja pāvekkhi ",
  "ja534:73.4": "dhataraṭṭhass' anantarā. ",
  "ja534:74.1": "Tesaṃ kañcanapattehi ",
  "ja534:74.2": "puthū ādāya Kāsiyo ",
  "ja534:74.3": "haṃsānaṃ abhihāreyyuṃ ",
  "ja534:74.4": "aggarañño pavāsitanti. ",
  "ja534:75.1": "Disvā abhihaṭaṃ aggaṃ ",
  "ja534:75.2": "Kāsirājena pesitaṃ ",
  "ja534:75.3": "kusalo khattadhammānaṃ ",
  "ja534:75.4": "tato pucchi anantarā: ",
  "ja534:76.1": "Kaccin nu bhoto kusalaṃ ",
  "ja534:76.2": "kacci bhoto anāmayaṃ, (IV 427|269 V 348|13) ",
  "ja534:76.3": "kacci raṭṭham idaṃ phītaṃ ",
  "ja534:76.4": "dhammena-m-anusissati. Kusalaṃ ",
  "ja534:77.1": "c' eva me haṃsa ",
  "ja534:77.2": "atho haṃsa anāmayaṃ. ",
  "ja534:77.3": "atho raṭṭham idaṃ phītaṃ ",
  "ja534:77.4": "dhammena-m-anusissati. ",
  "ja534:78.1": "Kacci bhoto amaccesu ",
  "ja534:78.2": "doso koci na vijjati, ",
  "ja534:78.3": "kaccin nu te tav' atthesu ",
  "ja534:78.4": "nāvakaṃkhanti jīvitaṃ. ",
  "ja534:79.1": "Atho pi me amaccesu ",
  "ja534:79.2": "doso koci na vijjati, ",
  "ja534:79.3": "atho pi te mam' atthesu ",
  "ja534:79.4": "nāvakaṃkhanti jīvitaṃ. ",
  "ja534:80.1": "Kacci te sādisī bhariyā ",
  "ja534:80.2": "assavā piyabhāṇinī ",
  "ja534:80.3": "puttarūpayasūpetā ",
  "ja534:80.4": "tava chandavasānugā. ",
  "ja534:81.1": "Atho me sādisī bhariyā ",
  "ja534:81.2": "assavā piyabhāṇinī ",
  "ja534:81.3": "puttarūpayasūpetā ",
  "ja534:81.4": "mama chandavāsānugā. ",
  "ja534:82.1": "Kacci raṭṭhaṃ anuppīḷaṃ ",
  "ja534:82.2": "akutociupaddavaṃ ",
  "ja534:82.3": "asāhasena dhammena ",
  "ja534:82.4": "samena-m-anusissati. ",
  "ja534:83.1": "Atho raṭṭhaṃ anuppīḷaṃ ",
  "ja534:83.2": "akutociupaddavaṃ ",
  "ja534:83.3": "asāhasena dhammena ",
  "ja534:83.4": "samena-m-anusissati. ",
  "ja534:84.1": "Kacci santo apacitā ",
  "ja534:84.2": "asanto parivajjitā, ",
  "ja534:84.3": "noce dhammaṃ niraṃkatvā ",
  "ja534:84.4": "adhammam anuvattasi. ",
  "ja534:85.1": "Santo ca me apacitā ",
  "ja534:85.2": "asanto parivajjitā ",
  "ja534:85.3": "dhamme c' evānuvattāmi, ",
  "ja534:85.4": "adhammo me niraṃkato. ",
  "ja534:86.1": "Kacci nānāgataṃ dīghaṃ ",
  "ja534:86.2": "samavekkhasi khattiya, ",
  "ja534:86.3": "kacci matto madanīye ",
  "ja534:86.4": "paralokaṃ na santasi. ",
  "ja534:87.1": "N' ahaṃ anāgataṃ dīghaṃ ",
  "ja534:87.2": "samavekkhāmi pakkhima. ",
  "ja534:87.3": "ṭhito dasasu dhammesu ",
  "ja534:87.4": "paralokaṃ na santase: ",
  "ja534:88.1": "Dānaṃ sīlaṃ pariccāgaṃ ",
  "ja534:88.2": "ajjavaṃ maddavaṃ tapaṃ ",
  "ja534:88.3": "akkodhaṃ avihiṃsañ ca ",
  "ja534:88.4": "khantiñ ca avirodhanaṃ ",
  "ja534:89.1": "Icc-ete kusale dhamme ",
  "ja534:89.2": "ṭhite passāmi attani. ",
  "ja534:89.3": "tato me jāyate pīti ",
  "ja534:89.4": "somanassañ c' anappakaṃ. ",
  "ja534:90.1": "Sumukho ca acintetvā ",
  "ja534:90.2": "vissaji pharusaṃ giraṃ ",
  "ja534:90.3": "bhāvadosam anaññāya ",
  "ja534:90.4": "asmāk'āyaṃ vihaṅgamo. ",
  "ja534:91.1": "So kuddho pharusaṃ vācaṃ ",
  "ja534:91.2": "nicchāresi ayoniso ",
  "ja534:91.3": "yān' asmāsu na vijjanti, ",
  "ja534:91.4": "na idaṃ paññavatām ivāti. ",
  "ja534:92.1": "Atthi me taṃ atisāraṃ ",
  "ja534:92.2": "vegena manujādhipa ",
  "ja534:92.3": "dhataraṭṭhe ca baddhasmiṃ ",
  "ja534:92.4": "dukkham me vipulaṃ ahu. ",
  "ja534:93.1": "Tvam pitā viya puttānaṃ ",
  "ja534:93.2": "bhūtānaṃ dharaṇī-r-iva ",
  "ja534:93.3": "asmākaṃ adhipannānaṃ ",
  "ja534:93.4": "khamassu rājakuñjarāti. ",
  "ja534:94.1": "Etan te anumodāma ",
  "ja534:94.2": "yaṃ bhāvaṃ na nigūhasi, ",
  "ja534:94.3": "khilaṃ pabhindasi pakkhi, ",
  "ja534:94.4": "ujuko si vihaṅgamāti. ",
  "ja534:95.1": "Yaṃ kiñci ratanaṃ atthi ",
  "ja534:95.2": "Kāsirājanivesane ",
  "ja534:95.3": "rajataṃ jātarūpañ ca ",
  "ja534:95.4": "muttā veḷuriyā bahū ",
  "ja534:96.1": "Maṇayo saṃkhamuttañ ca ",
  "ja534:96.2": "vatthakaṃ haricandanaṃ ",
  "ja534:96.3": "ajinaṃ dantabhaṇḍañ ca ",
  "ja534:96.4": "lohaṃ kāḷāyasaṃ bahuṃ, ",
  "ja534:96.5": "etaṃ dadāmi vo vittaṃ, ",
  "ja534:96.6": "issaraṃ vissajāmi voti. ",
  "ja534:97.1": "Addhā apacitā ty-amhā ",
  "ja534:97.2": "sakkatā ca rathesabha, ",
  "ja534:97.3": "dhammesu vattamānānaṃ ",
  "ja534:97.4": "tvaṃ no ācariyo bhava. ",
  "ja534:98.1": "Ācariya samanuññātā ",
  "ja534:98.2": "tayā anumatā mayaṃ, ",
  "ja534:98.3": "taṃ padakkhiṇato katvā ",
  "ja534:98.4": "ñātī passem' Arindamāti. ",
  "ja534:99.1": "Sabbarattiṃ cintayitvā ",
  "ja534:99.2": "mantayitvā yathātathaṃ ",
  "ja534:99.3": "Kāsirājā anuññāsi ",
  "ja534:99.4": "haṃsānaṃ pavaruttamanti g. ā. ",
  "ja534:100.1": "Tato ratyā vivasane ",
  "ja534:100.2": "suriyuggamanam pati ",
  "ja534:100.3": "pekkhato Kāsirājassa ",
  "ja534:100.4": "bhavanā te vigāhisunti g. ā. ",
  "ja534:101.1": "Te aroge anuppatte ",
  "ja534:101.2": "disvāna parame dije ",
  "ja534:101.3": "keketi-m-akaruṃ haṃsā, ",
  "ja534:101.4": "puthusaddo ajāyatha. ",
  "ja534:102.1": "Te patītā pamuttena ",
  "ja534:102.2": "bhattunā bhattugāravā ",
  "ja534:102.3": "samantā parikariṃsu ",
  "ja534:102.4": "aṇḍajā laddhapaccayā. ",
  "ja534:103.1": "Evaṃ mittavataṃ atthā ",
  "ja534:103.2": "sabbe honti padakkhiṇā ",
  "ja534:103.3": "haṃsā yathā dhataraṭṭhā ",
  "ja534:103.4": "ñātisaṃgham upāgamunti. ",
  "ja534:104.1": ""
}
