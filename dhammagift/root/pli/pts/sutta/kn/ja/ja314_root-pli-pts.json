  "ja314:0.3": "",
  "ja314:0.4": "",
  "ja314:1.1": "Dujjīvitaṃ ajīvimha ",
  "ja314:1.2": "ye sante na dadamhase, ",
  "ja314:1.3": "vijjamānesu bhogesu ",
  "ja314:1.4": "dīpaṃ nākamha attanoti, ",
  "ja314:2.1": "Saṭṭhivassasahassāni ",
  "ja314:2.2": "paripuṇṇāni sabbaso, ",
  "ja314:2.3": "niraye paccamānānaṃ ",
  "ja314:2.4": "kadā anto bhavissatīti. ",
  "ja314:3.1": "N' atthi anto kuto anto ",
  "ja314:3.2": "na anto patidissati, ",
  "ja314:3.3": "tadā hi pakataṃ pāpaṃ ",
  "ja314:3.4": "mama tuyhañ ca mārisāti. So ",
  "ja314:4.1": "hi nūna ito gantvā ",
  "ja314:4.2": "yoniṃ laddhāna mānusiṃ ",
  "ja314:4.3": "vadaññū sīlasampanno ",
  "ja314:4.4": "kābāmi kusalaṃ bahunti. ",
  "ja314:5.1": ""
}
