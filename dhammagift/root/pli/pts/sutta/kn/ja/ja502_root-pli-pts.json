  "ja502:1.1": "Ete haṃsā pakkamanti ",
  "ja502:1.2": "vakkaṅgā bhayameritā, ",
  "ja502:1.3": "harittaca hemavaṇṇa ",
  "ja502:1.4": "kāmaṃ Sumukha pakkama. ",
  "ja502:2.1": "Ohāya maṃ ñātigaṇā ",
  "ja502:2.2": "ekaṃ pāsavasaṃ gataṃ ",
  "ja502:2.3": "anapekkhamānā gacchanti, ",
  "ja502:2.4": "kiṃ eko avahīyasi. ",
  "ja502:3.1": "Pat' eva patataṃ seṭṭha, ",
  "ja502:3.2": "n' atthi baddhe sahāyatā, ",
  "ja502:3.3": "mā anīghāya hāpesi, ",
  "ja502:3.4": "Kāmaṃ Sumukha pakkamāti. ",
  "ja502:4.1": "Nāhaṃ dukkhaparetoti ",
  "ja502:4.2": "Dhataraṭṭha tavaṃ jahe, ",
  "ja502:4.3": "jīvitaṃ maraṇaṃ vā me ",
  "ja502:4.4": "tayā saddhiṃ bhavissatīti ",
  "ja502:5.1": "Etad ariyassa kalyāṇaṃ ",
  "ja502:5.2": "yan tvaṃ Sumukha bhāsasi, ",
  "ja502:5.3": "tañ ca vīmaṃsamāno 'haṃ ",
  "ja502:5.4": "pata te taṃ avassajinti ",
  "ja502:6.1": "Apadena padaṃ yāti ",
  "ja502:6.2": "antalikkhe caro dijo, ",
  "ja502:6.3": "ārā pāsaṃ na bujjhi tvaṃ ",
  "ja502:6.4": "haṃsānaṃ pavaruttamoti. ",
  "ja502:7.1": "Yadā parābhavo hoti ",
  "ja502:7.2": "poso jīvitasaṃkhaye [II 52|6, III 331|8] ",
  "ja502:7.3": "atha jālañ ca pāsañ ca ",
  "ja502:7.4": "āsajjāpi na bujjhatīti. ",
  "ja502:8.1": "Ete haṃsā pakkamanti ",
  "ja502:8.2": "vakkaṅgā bhayameritā, ",
  "ja502:8.3": "harittaca hemavaṇṇa ",
  "ja502:8.4": "tvañ ca naṃ avahīyasi. ",
  "ja502:9.1": "Ete bhutvā pivitvā ca ",
  "ja502:9.2": "pakkamanti vihaṅgamā ",
  "ja502:9.3": "anapekkhamānā vakkaṅgā, ",
  "ja502:9.4": "tvaṃ ñev' eko upāsasi. ",
  "ja502:10.1": "Kin nu t' āyaṃ dijo hoti, ",
  "ja502:10.2": "mutto baddhaṃ upāsasi, ",
  "ja502:10.3": "ohāya sakuṇā yanti, ",
  "ja502:10.4": "kiṃ eko avahīyasīti. ",
  "ja502:11.1": "Rājā me so dijo mitto ",
  "ja502:11.2": "sakhā pāṇasamo ca me, ",
  "ja502:11.3": "n' eva naṃ vijahissāmi ",
  "ja502:11.4": "yāva kālassa pariyāyanti. ",
  "ja502:12.1": "Yo ca tvaṃ sakhino hotu ",
  "ja502:12.2": "pāṇaṃ cajitum icchasi ",
  "ja502:12.3": "so te sahāyaṃ muñcāmi, ",
  "ja502:12.4": "hotu rājā tavānugoti ",
  "ja502:13.1": "Evaṃ luddaka nandassu ",
  "ja502:13.2": "saha sabbehi ñātibhi ",
  "ja502:13.3": "(III 331|12) yathāham ajja nandāmi ",
  "ja502:13.4": "muttaṃ disvā dijādhipanti. ",
  "ja502:14.1": "Kaccin nu bhoto kusalaṃ, ",
  "ja502:14.2": "kacci bhoto anāmayaṃ, ",
  "ja502:14.3": "kacci raṭṭham idam phītaṃ ",
  "ja502:14.4": "dhammena-m-anusāsati. Kusalaṃ ",
  "ja502:15.1": "c' eva me haṃsa, ",
  "ja502:15.2": "atho haṃsa anāmayaṃ, ",
  "ja502:15.3": "atho raṭṭham idaṃ phītaṃ ",
  "ja502:15.4": "dhammena-m-anusāsati. ",
  "ja502:16.1": "Kacci bhoto amaccesu ",
  "ja502:16.2": "doso koci na vijjati, ",
  "ja502:16.3": "kacci ārā amittā te ",
  "ja502:16.4": "chāyā dakkhiṇato-r-iva. ",
  "ja502:17.1": "Atho pi me amaccesu ",
  "ja502:17.2": "doso koci na vijjati, ",
  "ja502:17.3": "atho ārā amittā me ",
  "ja502:17.4": "chāyā dakkhiṇato-r-iva. ",
  "ja502:18.1": "Kacci te sādisī bhariyā ",
  "ja502:18.2": "assavā piyabhāṇinī ",
  "ja502:18.3": "puttarūpayasūpetā ",
  "ja502:18.4": "tava chandavasānugā. ",
  "ja502:19.1": "Atho me sādisī bhariyā ",
  "ja502:19.2": "assavā piyabhāṇinī ",
  "ja502:19.3": "puttarūpayasūpetā ",
  "ja502:19.4": "mama chandavasānugā. ",
  "ja502:20.1": "Kacci te bahavo puttā ",
  "ja502:20.2": "sujātā raṭṭhavaḍḍhana ",
  "ja502:20.3": "paññājavena sampannā, ",
  "ja502:20.4": "sammodanti tato tato. ",
  "ja502:21.1": "Sataṃ eko ca me puttā ",
  "ja502:21.2": "Dhataraṭṭha mayā sutā, ",
  "ja502:21.3": "tesaṃ tvaṃ kiccam akkhāhi, ",
  "ja502:21.4": "nāvarajjhanti te vacoti. ",
  "ja502:22.1": "Upapanno pi ce hoti ",
  "ja502:22.2": "jātiyā vinayena vā ",
  "ja502:22.3": "atha pacchā kurute yogaṃ ",
  "ja502:22.4": "kicce āpāsu sīdati. ",
  "ja502:23.1": "Tassa saṃhīrapaññassa ",
  "ja502:23.2": "vivaro jāyate mahā, ",
  "ja502:23.3": "nattamandho va rūpāni ",
  "ja502:23.4": "phullāni-m-anupassati. ",
  "ja502:24.1": "Asāre sārayogaññū ",
  "ja502:24.2": "matiṃ na tv-eva vindati, ",
  "ja502:24.3": "sarabho va giriduggasmiṃ ",
  "ja502:24.4": "antarā yeva sīdati. ",
  "ja502:25.1": "Hīnajacco pi ce hoti ",
  "ja502:25.2": "uṭṭhātā dhitimā naro ",
  "ja502:25.3": "ācārasīlasampanno ",
  "ja502:25.4": "nise aggīva bhāsati. ",
  "ja502:26.1": "Etaṃ ve upamaṃ katvā ",
  "ja502:26.2": "putte vijjāsu vācaya, ",
  "ja502:26.3": "saṃvirūhetha medhāvī ",
  "ja502:26.4": "khettabījaṃ va vuṭṭhiyāti. ",
  "ja502:27.1": ""
}
