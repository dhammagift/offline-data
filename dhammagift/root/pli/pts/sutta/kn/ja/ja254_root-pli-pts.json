  "ja254:0.4": "",
  "ja254:1.1": "Bhutvā tiṇaparighāsaṃ ",
  "ja254:1.2": "bhutvā ācāmakuṇḍakaṃ ",
  "ja254:1.3": "etaṃ te bhojanaṃ āsi, ",
  "ja254:1.4": "kasmā dāni na bhuñjasīti. ",
  "ja254:2.1": "Yattha posaṃ na jānanti ",
  "ja254:2.2": "jātiyā vinayena vā ",
  "ja254:2.3": "pahūt' attha mahābrahme ",
  "ja254:2.4": "api ācāmakuṇḍakaṃ. ",
  "ja254:3.1": "Tvañ ca kho maṃ pajānāsi ",
  "ja254:3.2": "yādis' āyaṃ hayuttamo, ",
  "ja254:3.3": "jānanto jānam āgamma ",
  "ja254:3.4": "na te bhakkhāmi kuṇḍadakanti. Yāvaṃ ",
  "ja254:4.1": ""
}
