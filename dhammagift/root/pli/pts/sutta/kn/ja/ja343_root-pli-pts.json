  "ja343:1.1": "Avasimha tavāgāre ",
  "ja343:1.2": "niccaṃ sakkatapūjitā, ",
  "ja343:1.3": "tvam eva dānim akara, ",
  "ja343:1.4": "handa rāja vajām' ahanti. ",
  "ja343:2.1": "Yo ve kate patikate ",
  "ja343:2.2": "kibbise patikibbise ",
  "ja343:2.3": "evaṃ taṃ sammatī veraṃ ",
  "ja343:2.4": "vasakuntani mā gamāti. ",
  "ja343:3.1": "Na katassa ca kattā ca ",
  "ja343:3.2": "mettī sandhīyate puna, ",
  "ja343:3.3": "hadayaṃ nānujānāti, ",
  "ja343:3.4": "gacchañ ñeva rathesabhāti. ",
  "ja343:4.1": "Katassa c' eva kattā ca ",
  "ja343:4.2": "mettī sandhīyate puna ",
  "ja343:4.3": "dhīrānaṃ no ca bālānaṃ, ",
  "ja343:4.4": "vasa kuntani mā gamāti. ",
  "ja343:5.1": ""
}
