  "ja316:0.4": "",
  "ja316:1.1": "Satta me rohitā macchā ",
  "ja316:1.2": "udakā thalam ubbhatā, ",
  "ja316:1.3": "idaṃ brāhmaṇa me atthi, ",
  "ja316:1.4": "etaṃ bhutvā vane vasāti. ",
  "ja316:2.1": "Dussa me khettapālassa ",
  "ja316:2.2": "rattibhattaṃ apābhataṃ ",
  "ja316:2.3": "maṃsasūlā ca dve godhā ",
  "ja316:2.4": "ekañ ca dadhivārakaṃ, ",
  "ja316:2.5": "idaṃ brāhmaṇa me atthi, ",
  "ja316:2.6": "etaṃ bhutvā vane vasāti. ",
  "ja316:3.1": "Ambapakk', odakaṃ sītaṃ ",
  "ja316:3.2": "sītacchāyaṃ manoramaṃ, ",
  "ja316:3.3": "idaṃ brāhmaṇa me atthi, ",
  "ja316:3.4": "etaṃ bhutvā vane vasāti. ",
  "ja316:4.1": "Na sasassa tilā atthi ",
  "ja316:4.2": "na muggā nāpi taṇḍulā, ",
  "ja316:4.3": "iminā agginā pakkaṃ ",
  "ja316:4.4": "mamaṃ bhutvā vane vasāti. Matamatam eva ",
  "ja316:5.1": ""
}
