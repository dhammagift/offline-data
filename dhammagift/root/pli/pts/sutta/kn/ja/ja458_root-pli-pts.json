  "ja458:0.4": "",
  "ja458:1.1": "Ekā nisinnā suci saññatūrū ",
  "ja458:1.2": "pāsādam āruyha aninditaṅgī, ",
  "ja458:1.3": "yācāmi taṃ kinnaranettacakkhu: ",
  "ja458:1.4": "im' ekarattiṃ ubhayo vasemāti. ",
  "ja458:2.1": "Ukkiṇṇantaraparikhaṃ ",
  "ja458:2.2": "daḷhamaṭṭālakoṭṭhakaṃ ",
  "ja458:2.3": "rakkhitaṃ khaggahatthehi ",
  "ja458:2.4": "duppavesam idaṃ puraṃ. ",
  "ja458:3.1": "Daharassa yuvino cāpi ",
  "ja458:3.2": "āgamo ca na vijjati, ",
  "ja458:3.3": "atha kena nu vaṇṇena ",
  "ja458:3.4": "saṅgamaṃ icchase mayāti. ",
  "ja458:4.1": "Yakkho 'ham asmi kalyāṇi, ",
  "ja458:4.2": "āgato 'smi tamantikaṃ, ",
  "ja458:4.3": "tvaṃ maṃ nandaya bhaddan te, ",
  "ja458:4.4": "puṇṇakaṃsaṃ dadāmi te. ",
  "ja458:5.1": "Devaṃ va yakkhaṃ atha vā manussaṃ ",
  "ja458:5.2": "na patthaye Udayam aticca-m-aññaṃ, ",
  "ja458:5.3": "gacch' eva tvaṃ yakkha mahānubhāva, ",
  "ja458:5.4": "mā c' assu gantvā punar āvajitthāti. ",
  "ja458:6.1": "Yā sā ratī uttamā kāmabhoginaṃ ",
  "ja458:6.2": "yaṃhetu sattā visamaṃ caranti ",
  "ja458:6.3": "mā taṃ ratiṃ jīyi tuvaṃ sucimhite, ",
  "ja458:6.4": "dadāmi te rūpiyaṃ kaṃsapūranti. ",
  "ja458:7.1": "Nārī naro nijjhapayaṃ dhanena ",
  "ja458:7.2": "ukkaṃsatī yattha karoti chandaṃ, ",
  "ja458:7.3": "vipaccanīko tava devadhammo ",
  "ja458:7.4": "paccakkhato thodatarena esīti. ",
  "ja458:8.1": "Āyuñ ca vaṇṇañ ca manussaloke ",
  "ja458:8.2": "nihiyyati manujānaṃ sugatte, ",
  "ja458:8.3": "ten' eva vaṇṇena dhanam pi tuyhaṃ ",
  "ja458:8.4": "nihiyyati, jiṇṇatarāsi ajja. ",
  "ja458:9.1": "Evaṃ me pekkhamānassa ",
  "ja458:9.2": "rājaputti yasassini ",
  "ja458:9.3": "hāyat' eva tato vaṇṇo ",
  "ja458:9.4": "ahorattānam accaye. Iminā ",
  "ja458:10.1": "ca tvaṃ vayasā ",
  "ja458:10.2": "rājaputti sumedhase ",
  "ja458:10.3": "brahmacariyaṃ careyyāsi, ",
  "ja458:10.4": "bhiyyo vaṇṇavatī siyāti. ",
  "ja458:11.1": "Devā na jīranti yathā manussā, ",
  "ja458:11.2": "gattesu tesaṃ valiyo na honti, ",
  "ja458:11.3": "pucchāmi taṃ yakkhā mahānubhāva: ",
  "ja458:11.4": "kathaṃ na devānaṃ sarūradehoti. ",
  "ja458:12.1": "Devā na jīranti yathā manussā, ",
  "ja458:12.2": "gattesu tesaṃ valiyo na honti, ",
  "ja458:12.3": "suve suve bhiyyataro va tesaṃ ",
  "ja458:12.4": "dibbo ca vaṇṇo vipulā ca bhogāti. ",
  "ja458:13.1": "Kiṃ sū 'dha bhītā janatā anekā, ",
  "ja458:13.2": "maggo ca nekāyatanaṃ pavutto, ",
  "ja458:13.3": "pucchāmi taṃ yakkha mahānubhāva: ",
  "ja458:13.4": "katthaṭṭhito paralokaṃ na bhāyeti. ",
  "ja458:14.1": "Vācaṃ manañ ca paṇidhāya sammā ",
  "ja458:14.2": "kāyena pāpāni akubbamāno ",
  "ja458:14.3": "bavhannapānaṃ gharam āvasanto ",
  "ja458:14.4": "saddho mudū saṃvibhāgī vadaññū ",
  "ja458:14.5": "saṅgāhako sakhilo saṇhavāco (III. 262|21) ",
  "ja458:14.6": "etthaṭṭhito paralokaṃ na bhāyeti. ",
  "ja458:15.1": "Anusāsasi maṃ yakkha ",
  "ja458:15.2": "yathā mātā yathā pitā, ",
  "ja458:15.3": "uḷāravaṇṇa pucchāmi: ",
  "ja458:15.4": "ko nu tvam asi subrahāti. ",
  "ja458:16.1": "Udayo 'ham asmi kālyāṇi ",
  "ja458:16.2": "saṅgaratthā idhāgato, ",
  "ja458:16.3": "āmanta kho taṃ gacchāmi, ",
  "ja458:16.4": "mutto 'smi tava saṅgarāti. ",
  "ja458:17.1": "Sace kho tvaṃ Udayo si ",
  "ja458:17.2": "saṃgaratthā idhāgato ",
  "ja458:17.3": "anusāsa maṃ rājaputta ",
  "ja458:17.4": "yathāssu puna saṅgamoti. ",
  "ja458:18.1": "Adhipatatī vayo khaṇo tath' eva, ",
  "ja458:18.2": "ṭhānaṃ n' atthi dhuvaṃ, cavanti sattā, ",
  "ja458:18.3": "parijīyati addhuvaṃ sarīraṃ, ",
  "ja458:18.4": "Udaye mā pamāda, carassu dhammaṃ. ",
  "ja458:19.1": "Kasiṇā paṭhavī dhanassa pūrā ",
  "ja458:19.2": "ekass' eva siyā anaññadheyyā, ",
  "ja458:19.3": "tañ cāpi jahāti avītarāgo, ",
  "ja458:19.4": "Udaye mā pamāda, carassu dhammaṃ. ",
  "ja458:20.1": "Mātā ca pitā ca bhātaro ca ",
  "ja458:20.2": "bhariyā yāpi dhanena hoti kītā ",
  "ja458:20.3": "te cāpi jahanti aññamaññaṃ, ",
  "ja458:20.4": "Udaye mā pamāda, carassu dhammaṃ. ",
  "ja458:21.1": "Kāyo parabhojananti ñatvā ",
  "ja458:21.2": "saṃsāre sugatī ca duggatī ca ",
  "ja458:21.3": "ittaravāsoti jāniyā, ",
  "ja458:21.4": "Udaye mā pamāda, carassu dhammanti. ",
  "ja458:22.1": "Sādhu bhāsat' ayaṃ yakkho: ",
  "ja458:22.2": "appaṃ maccāna jīvitaṃ, ",
  "ja458:22.3": "kasirañ ca parittañ ca ",
  "ja458:22.4": "tañ ca dukkhena saṃyutaṃ, ",
  "ja458:22.5": "sāhaṃ ekā pabbajissāmi ",
  "ja458:22.6": "hitvā Kāsiṃ Surundhananti. ",
  "ja458:23.1": ""
}
