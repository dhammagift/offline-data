  "ja396:1.1": "Diyaḍḍhakukku udayena kaṇṇikā, ",
  "ja396:1.2": "vidatthiyo aṭṭha parikkhipanti naṃ ",
  "ja396:1.3": "sasiṃsapā sāramayā apheggukā ",
  "ja396:1.4": "kuhiṃ ṭhitā uparito na dhaṃsatīti. ",
  "ja396:2.1": "Yā tiṃsati sāramayā anujjukā ",
  "ja396:2.2": "parikiriya gopānasiyo samaṃ ṭhitā ",
  "ja396:2.3": "tāhi saṃgahītā balasā papīḷitā ",
  "ja396:2.4": "samaṃ ṭhitā uparito na dhaṃsati. ",
  "ja396:3.1": "Evam pi mittehi daḷhehi paṇḍito ",
  "ja396:3.2": "abhejjarūpehi sucīhi mantihi ",
  "ja396:3.3": "susaṃgahīto siriyā na dhaṃsati ",
  "ja396:3.4": "gopānasībhāravahā va kaṇṇikāti. ",
  "ja396:4.1": "Kharattacaṃ mellaṃ yathāpi satthavā ",
  "ja396:4.2": "anāmasanto pi karoti tittakaṃ ",
  "ja396:4.3": "samāharaṃ sādukaroti patthiva ",
  "ja396:4.4": "asādukayirā tanuvaṭṭam uddharaṃ. ",
  "ja396:5.1": "Evam pi gāmanigamesu paṇḍito ",
  "ja396:5.2": "asāhasaṃ rājadhanāni saṃgharaṃ ",
  "ja396:5.3": "dhammānuvattī paṭipajjamāno ",
  "ja396:5.4": "sa phātiṃ kayirā aviheṭhayaṃ paranti. ",
  "ja396:6.1": "Odātamūlaṃ sucivārisambhavaṃ ",
  "ja396:6.2": "jātaṃ yathā pokkharaṇīsu ambujaṃ ",
  "ja396:6.3": "padumaṃ yathā agginikāsiphālimaṃ ",
  "ja396:6.4": "na kadamo na rajo na vāri limpati. ",
  "ja396:7.1": "Evam pi vohārasuciṃ asāhasaṃ ",
  "ja396:7.2": "visuddhakammantam apetapāpakaṃ ",
  "ja396:7.3": "na limpati kammakilesa, tādiso ",
  "ja396:7.4": "jātaṃ yathā pokkharaṇīsu ambujanti ",
  "ja396:8.1": ""
}
