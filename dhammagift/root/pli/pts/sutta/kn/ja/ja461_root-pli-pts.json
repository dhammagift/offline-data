  "ja461:0.4": "",
  "ja461:1.1": "Etha Lakkhaṇa Sītā ca ",
  "ja461:1.2": "ubho otarathodakanti. ",
  "ja461:1.3": "Evāyaṃ Bharato āha: ",
  "ja461:1.4": "rājā Dasaratho matoti. ",
  "ja461:2.1": "Kena Rāma ppabhāvena ",
  "ja461:2.2": "socitabbaṃ na socasi, ",
  "ja461:2.3": "pitaraṃ kālakataṃ sutvā ",
  "ja461:2.4": "na taṃ pasahate dukhanti. ",
  "ja461:3.1": "Yaṃ na sakkā pāletuṃ ",
  "ja461:3.2": "posena lapataṃ bahuṃ ",
  "ja461:3.3": "sa kissa viññū medhāvī ",
  "ja461:3.4": "attānam upatāpaye. ",
  "ja461:4.1": "Daharā ca hi vuddhā ca ",
  "ja461:4.2": "ye bālā ye ca paṇḍitā ",
  "ja461:4.3": "aḍḍhā c' eva daliddā ca ",
  "ja461:4.4": "sabbe maccuparāyanā. ",
  "ja461:5.1": "Phalānam iva pakkānaṃ ",
  "ja461:5.2": "niccaṃ papatanā bhayaṃ ",
  "ja461:5.3": "evaṃ jātānaṃ maccānaṃ ",
  "ja461:5.4": "niccaṃ maraṇato bhayaṃ. ",
  "ja461:6.1": "Sāyam eke na dissanti ",
  "ja461:6.2": "pāto diṭṭhā bahujjanā, ",
  "ja461:6.3": "pāto eke na dissanti ",
  "ja461:6.4": "sāyaṃ diṭṭhā bahujjanā. ",
  "ja461:7.1": "Paridevayamāno ce ",
  "ja461:7.2": "kañcid atthaṃ udabbahe ",
  "ja461:7.3": "sammūḷho hiṃsam attānaṃ ",
  "ja461:7.4": "kayira c' enaṃ vicakkhaṇo. ",
  "ja461:8.1": "Kiso vivaṇṇo bhavati ",
  "ja461:8.2": "hiṃsam attānam attano, ",
  "ja461:8.3": "na tena petā pālenti, ",
  "ja461:8.4": "niratthā paridevanā. ",
  "ja461:9.1": "Yathā saranam ādittam ",
  "ja461:9.2": "vārinā parinibbaye ",
  "ja461:9.3": "evam pi dhīro sutavā ",
  "ja461:9.4": "medhavī paṇḍito naro ",
  "ja461:9.5": "khippam uppatitaṃ sokaṃ ",
  "ja461:9.6": "vāto tūlaṃ va dhaṃsaye. Eko va ",
  "ja461:10.1": "macco acceti, ",
  "ja461:10.2": "eko va jāyate kule, ",
  "ja461:10.3": "saññogaparamā tv-eva ",
  "ja461:10.4": "sambhogā sabbapāṇinaṃ. ",
  "ja461:11.1": "Tasmā hi dhīrassa bahussutassa ",
  "ja461:11.2": "sampassato lokam imaṃ parañ ca ",
  "ja461:11.3": "aññāya dhammaṃ hadayaṃ manañ ca ",
  "ja461:11.4": "sokā mahantāpi na tāpayanti. ",
  "ja461:12.1": "So 'haṃ dassañ ca bhokkhañ ca ",
  "ja461:12.2": "bharissāmi ca ñātake, ",
  "ja461:12.3": "sesaṃ sampālayissāmi, kiccam ",
  "ja461:12.4": "evaṃ vijānatoti. ",
  "ja461:13.1": "Dasa vassasahassāni ",
  "ja461:13.2": "saṭṭhi vassasatāni ca ",
  "ja461:13.3": "kambugīvo mahābāhu ",
  "ja461:13.4": "Rāmo rajjam akārayīti ",
  "ja461:14.1": ""
}
