  "ja322:1.1": "",
  "ja322:1.2": "yasmiṃ dese vasām' ahaṃ, ",
  "ja322:1.3": "aham p' etaṃ na jānāmi, ",
  "ja322:1.4": "kiṃ etaṃ daddabhāyatīti. ",
  "ja322:2.1": "Bellaṃ nipatitaṃ sutvā ",
  "ja322:2.2": "dabhakkanti saso javi, ",
  "ja322:2.3": "sasassa vacanaṃ sutvā ",
  "ja322:2.4": "santattā migavāhinī. ",
  "ja322:3.1": "Appattā padaviññāṇaṃ ",
  "ja322:3.2": "paraghosānusārino ",
  "ja322:3.3": "pamādaparamā bālā ",
  "ja322:3.4": "te honti parapattiyā. ",
  "ja322:4.1": "Ye ca sīlena sampannā ",
  "ja322:4.2": "paññāy' ūpasame ratā ",
  "ja322:4.3": "āratā viratā dhīrā ",
  "ja322:4.4": "na honti parapattiyāti ",
  "ja322:5.1": ""
}
