{
  "ja545:0.1": "",
  "ja545:0.2": "",
  "ja545:0.3": "",
  "ja545:0.4": "",
  "ja545:1.1": "Ahu rājā Videhānaṃ ",
  "ja545:1.2": "Aṃgati nāma khattiyo ",
  "ja545:1.3": "pahūtayoggo dhanimā ",
  "ja545:1.4": "anantabalaporiso. ",
  "ja545:2.1": "So ca pannarasiṃ rattiṃ ",
  "ja545:2.2": "purime yāme anāgate ",
  "ja545:2.3": "cātumassakomudiyā ",
  "ja545:2.4": "amacce sannipātayi: ",
  "ja545:3.1": "Paṇḍite sutasampanne ",
  "ja545:3.2": "mihitapubbe vicakkhaṇe ",
  "ja545:3.3": "Vijayañ ca Sunāmañ ca ",
  "ja545:3.4": "senāpatim Alātakaṃ. ",
  "ja545:4.1": "Tam anupucchi Vedeho: ",
  "ja545:4.2": "paccekaṃ brūtha saṃ ruciṃ, ",
  "ja545:4.3": "cātumassakomud' ajja, ",
  "ja545:4.4": "juṇhaṃ, vyapagataṃ tamaṃ, ",
  "ja545:4.5": "kāy' ajja ratiyā rattiṃ ",
  "ja545:4.6": "viharemu imaṃ utunti. ",
  "ja545:5.1": "Tato senāpatī rañño ",
  "ja545:5.2": "Alāto etad abravī: ",
  "ja545:5.3": "haṭṭhaṃ yoggaṃ balaṃ sabbaṃ ",
  "ja545:5.4": "senaṃ sannāhayāmase. ",
  "ja545:6.1": "Niyyāma deva yuddhāya ",
  "ja545:6.2": "anantabalaporisā, ",
  "ja545:6.3": "ye te vasaṃ na āyanti ",
  "ja545:6.4": "vasaṃ upanayāmase, ",
  "ja545:6.5": "esā mayhaṃ sakā diṭṭhi: ",
  "ja545:6.6": "ajitaṃ ojināmase. ",
  "ja545:7.1": "Alātassa vaco sutvā ",
  "ja545:7.2": "Sunāmo etad abravī: ",
  "ja545:7.3": "sabbe tuyhaṃ mahārāja ",
  "ja545:7.4": "amittā va samāgatā, ",
  "ja545:8.1": "Nikkhittasatthā paccattā ",
  "ja545:8.2": "nivātam anuvattare, ",
  "ja545:8.3": "uttamo ussavo ajja, ",
  "ja545:8.4": "na yuddhaṃ mama ruccati. ",
  "ja545:9.1": "Annaṃ pānañ ca khajjañ ca ",
  "ja545:9.2": "khippaṃ abhiharantu te, ",
  "ja545:9.3": "ramassu deva kāmehi ",
  "ja545:9.4": "naccagītesu vādite. ",
  "ja545:10.1": "Sunāmassa vaco sutvā ",
  "ja545:10.2": "Vijayo etad abravī: ",
  "ja545:10.3": "sabbe kāmā mahārāja ",
  "ja545:10.4": "niccaṃ tava-m-upaṭṭhitā, ",
  "ja545:11.1": "Na h' ete dullabhā deva ",
  "ja545:11.2": "tava kāmehi modituṃ, ",
  "ja545:11.3": "sadāpi kāmā labbhanti ",
  "ja545:11.4": "n' etaṃ cittaṃ mataṃ mama. ",
  "ja545:12.1": "Samaṇaṃ brāhmaṇaṃ vāpi ",
  "ja545:12.2": "upāsemu bahussutaṃ ",
  "ja545:12.3": "yo n' ajja vinaye kaṃkhaṃ ",
  "ja545:12.4": "atthadhammavidū ise. ",
  "ja545:13.1": "Vijayassa vaco sutvā ",
  "ja545:13.2": "rājā Aṃgati-m-abravī: ",
  "ja545:13.3": "yathā Vijayo bhaṇati ",
  "ja545:13.4": "mayham p' et' eva ruccati. ",
  "ja545:14.1": "Samaṇaṃ brāhmaṇaṃ vāpi ",
  "ja545:14.2": "upāsemu bahussutaṃ ",
  "ja545:14.3": "yo n' ajja vinaye kaṃkhaṃ ",
  "ja545:14.4": "atthadhammavidū ise. ",
  "ja545:15.1": "Sabbe va [santā] karotha matiṃ: ",
  "ja545:15.2": "kaṃ upāsemu paṇḍitaṃ, ",
  "ja545:15.3": "ko n' ajja vinaye kaṃkhaṃ ",
  "ja545:15.4": "atthadhammavidū ise. ",
  "ja545:16.1": "Vedehassa vaco sutvā ",
  "ja545:16.2": "Alāto etad abravī: ",
  "ja545:16.3": "atth' āyaṃ migadāyasmiṃ ",
  "ja545:16.4": "acelo dhīrasammato ",
  "ja545:17.1": "Guṇo Kassapagott' āyaṃ ",
  "ja545:17.2": "suto citrakathī gaṇī, ",
  "ja545:17.3": "taṃ deva payirupāsaya, ",
  "ja545:17.4": "so no kaṃkhaṃ vinessati. ",
  "ja545:18.1": "Alātassa vaco sutvā ",
  "ja545:18.2": "rājā codesi sārathiṃ: ",
  "ja545:18.3": "migadāyaṃ gamissāma, ",
  "ja545:18.4": "yuttaṃ yānaṃ idhānayāti. ",
  "ja545:19.1": "Tassa yānaṃ ayojesuṃ ",
  "ja545:19.2": "dantaṃ rūpiyapakkharaṃ ",
  "ja545:19.3": "sukkamaṭṭhaparivāraṃ ",
  "ja545:19.4": "paṇḍaraṃ dosināmukhaṃ. ",
  "ja545:20.1": "Tatrāsuṃ kumudā yuttā ",
  "ja545:20.2": "cattāro sindhavā hayā ",
  "ja545:20.3": "anilūpamasamuppādā ",
  "ja545:20.4": "sudantā soṇṇamālino ",
  "ja545:21.1": "Setacchattaṃ setaratho ",
  "ja545:21.2": "setassā setavījanī, ",
  "ja545:21.3": "Vedeho sah' amaccehi ",
  "ja545:21.4": "niyyaṃ Cando va sobhatha. Tam ",
  "ja545:22.1": "annuyāyuṃ bahavo ",
  "ja545:22.2": "iṭṭhikhaggadharā balī ",
  "ja545:22.3": "assapiṭṭhigatā dhīrā ",
  "ja545:22.4": "narā naravarādhipaṃ. ",
  "ja545:23.1": "So muhuttaṃ va yāyitvā ",
  "ja545:23.2": "yānā oruyha khattiyo ",
  "ja545:23.3": "Vedeho sah' amaccehi ",
  "ja545:23.4": "patti Guṇam upāgami. ",
  "ja545:24.1": "Ye pi tattha tadā āsuṃ ",
  "ja545:24.2": "brāhmaṇibbhā samāgatā ",
  "ja545:24.3": "na te apanayī rājā ",
  "ja545:24.4": "akataṃ bhūmim āgateti. ",
  "ja545:25.1": "Tato [so] mudukābhisiyā ",
  "ja545:25.2": "muducittakaḷandake ",
  "ja545:25.3": "mudupaccatthate rājā ",
  "ja545:25.4": "ekamantaṃ upāvisi. ",
  "ja545:26.1": "Nisajja rājā sammodi ",
  "ja545:26.2": "kathaṃ sārāṇiyaṃ tato: ",
  "ja545:26.3": "kacci yāpanīyam bhante ",
  "ja545:26.4": "vātānam avisaggatā, ",
  "ja545:27.1": "Kacci akasirā vutti, ",
  "ja545:27.2": "labbhati piṇḍayāpanaṃ, ",
  "ja545:27.3": "appābādho v' asī kacci ",
  "ja545:27.4": "cakkhuṃ na parihāyati. ",
  "ja545:28.1": "Taṃ Guṇo paṭisammodi ",
  "ja545:28.2": "Vedehaṃ vinaye rataṃ: ",
  "ja545:28.3": "yāpanīyaṃ mahārāja ",
  "ja545:28.4": "sabbam etaṃ tad ūbhayaṃ. ",
  "ja545:29.1": "Kacci tuyham pi Vedeha ",
  "ja545:29.2": "paccantā na balīyare, ",
  "ja545:29.3": "kacci ārogaṃ yoggan te, ",
  "ja545:29.4": "kacci vahati vāhanaṃ, ",
  "ja545:29.5": "kacci te vyādhayo n' atthi sarīrass' ",
  "ja545:29.6": "upatāpikā. ",
  "ja545:30.1": "Paṭisammodito rājā ",
  "ja545:30.2": "tato pucchi anantarā ",
  "ja545:30.3": "atthaṃ dhammaṃ ca ñāyañ ca ",
  "ja545:30.4": "dhammakāmo rathesabho. ",
  "ja545:31.1": "Kathaṃ dhammaṃ care macco ",
  "ja545:31.2": "mātāpitūsu Kassapa, ",
  "ja545:31.3": "kathaṃ care ācariye ",
  "ja545:31.4": "puttadāre kathaṃ care. ",
  "ja545:32.1": "Kathaṃ careyya vaddhesu ",
  "ja545:32.2": "kathaṃ samaṇabrāhmaṇe, ",
  "ja545:32.3": "kathañ ca balakāyasmiṃ ",
  "ja545:32.4": "kathaṃ jānapade care. ",
  "ja545:33.1": "Kathaṃ dhammaṃ caritvāna ",
  "ja545:33.2": "pecca gacchati suggatiṃ, ",
  "ja545:33.3": "kathaṃ c' eke adhammaṭṭhā ",
  "ja545:33.4": "patanti nirayaṃ adhoti. ",
  "ja545:34.1": "Vedehassa vaco sutvā ",
  "ja545:34.2": "Kassapo etad abravī: ",
  "ja545:34.3": "suṇohi me mahārāja ",
  "ja545:34.4": "saccaṃ avitathaṃ padaṃ, ",
  "ja545:35.1": "N' atthi dhammacaritassa ",
  "ja545:35.2": "phalaṃ kalyāṇapāpakaṃ, ",
  "ja545:35.3": "n' atthi deva paro loko, ",
  "ja545:35.4": "ko tato hi idhāgato, ",
  "ja545:36.1": "N' atthi deva pitaro vā, ",
  "ja545:36.2": "kuto mātā kuto pitā, ",
  "ja545:36.3": "n' atthi ācariyo nāma, ",
  "ja545:36.4": "adantaṃ ko damissati, ",
  "ja545:37.1": "Samatulyāni bhūtāni, ",
  "ja545:37.2": "n' atthi jeṭṭhāpacāyino, ",
  "ja545:37.3": "n' atthi balaṃ vā viriyaṃ vā, ",
  "ja545:37.4": "kuto uṭṭhānaporisaṃ, ",
  "ja545:37.5": "niyatāni hi bhūtāni, ",
  "ja545:37.6": "yathā goṭaviso tathā, ",
  "ja545:38.1": "Laddheyyaṃ labhate macco, ",
  "ja545:38.2": "tattha dānaphalaṃ kuto, ",
  "ja545:38.3": "n' atthi dānaphalaṃ deva, ",
  "ja545:38.4": "avaso dev' avīriyo, ",
  "ja545:39.1": "Bālehi dānaṃ paññattaṃ ",
  "ja545:39.2": "paṇḍitehi paṭicchitaṃ, ",
  "ja545:39.3": "avasā denti dhīrānaṃ ",
  "ja545:39.4": "bālā paṇḍitamāninoti. ",
  "ja545:40.1": "Satt' ime sassatā kāyā ",
  "ja545:40.2": "acchejjā avikopino: ",
  "ja545:40.3": "tejo paṭhavī āpo ca ",
  "ja545:40.4": "vāyo sukhadukhañ c' ime ",
  "ja545:40.5": "jīvo ca, satt' ime kāyā ",
  "ja545:40.6": "yesaṃ chettā na vijjati, ",
  "ja545:41.1": "N' atthi hantā vā chettā vā ",
  "ja545:41.2": "haññare vāpi koci naṃ, ",
  "ja545:41.3": "antaren' eva kāyānaṃ ",
  "ja545:41.4": "satthāni vītivattare. ",
  "ja545:42.1": "Yo p' āyaṃ siraṃ ādāya ",
  "ja545:42.2": "paresaṃ nisitāsinā ",
  "ja545:42.3": "na so chindati te kāye, ",
  "ja545:42.4": "tattha pāpaphalaṃ kuto. ",
  "ja545:43.1": "Cullāsītimahākappe ",
  "ja545:43.2": "sabbe sujjhanti saṃsaraṃ, ",
  "ja545:43.3": "anāgate tamhi kāle ",
  "ja545:43.4": "saññato pi na sujjhati. ",
  "ja545:44.1": "Caritvāpi bahuṃ bhadraṃ ",
  "ja545:44.2": "n' eva sujjhanti nāgate, ",
  "ja545:44.3": "pāpañ ce pi bahuṃ katvā ",
  "ja545:44.4": "taṃ khaṇaṃ nātivattare. ",
  "ja545:45.1": "Anupubbena no suddhi ",
  "ja545:45.2": "kappānaṃ cullasītiyā, ",
  "ja545:45.3": "niyatiṃ nātivattāma ",
  "ja545:45.4": "velantam iva sāgaroti. ",
  "ja545:46.1": "Kassapassa vaco sutvā ",
  "ja545:46.2": "Alāto etad abravī: ",
  "ja545:46.3": "yathā bhadanto bhaṇati ",
  "ja545:46.4": "mayhaṃ p' etaṃ ca ruccati. ",
  "ja545:47.1": "Aham pi purimaṃ jātiṃ ",
  "ja545:47.2": "sare saṃsarit' attano, ",
  "ja545:47.3": "Piṅgalo nām' ahaṃ āsiṃ ",
  "ja545:47.4": "luddo goghātako pure. ",
  "ja545:48.1": "Bārāṇasiyaṃ phītāya ",
  "ja545:48.2": "bahuṃ pāpaṃ kataṃ mayā, ",
  "ja545:48.3": "bahū mayhaṃ hatā pāṇā: ",
  "ja545:48.4": "mahisā sūkarā ajā. ",
  "ja545:49.1": "Tato cuto idha jāto ",
  "ja545:49.2": "iddhe senāpatīkule ",
  "ja545:49.3": "n' atthi nūna phalaṃ pāpe so ",
  "ja545:49.4": "'haṃ na nirayaṃ gatoti. ",
  "ja545:50.1": "Ath' ettha Bījako nāma ",
  "ja545:50.2": "dāso āsi paḷaccarī, ",
  "ja545:50.3": "uposathaṃ upavasanto ",
  "ja545:50.4": "Guṇasantikam upāgami. ",
  "ja545:51.1": "Kassapassa vaco sutvā ",
  "ja545:51.2": "Alātassa ca bhāsitaṃ ",
  "ja545:51.3": "passasanto muhuṃ uṇhaṃ ",
  "ja545:51.4": "rudaṃ assūni vattayīti. Tam ",
  "ja545:52.1": "annupucchi Vedeho: ",
  "ja545:52.2": "kimatthaṃ samma rodasi, ",
  "ja545:52.3": "kin te sutaṃ vā diṭṭhaṃ vā, ",
  "ja545:52.4": "kiṃ maṃ vedesi vedananti. ",
  "ja545:53.1": "Vedehassa vaco sutvā ",
  "ja545:53.2": "Bījako etad abravī: ",
  "ja545:53.3": "n' atthi me vedanā dukkhā, ",
  "ja545:53.4": "mahārāja suṇohi me. ",
  "ja545:54.1": "Aham pi purimaṃ jātiṃ ",
  "ja545:54.2": "sarāmi sukham attano: ",
  "ja545:54.3": "Sāketāyaṃ pure āsiṃ ",
  "ja545:54.4": "Bhāvaseṭṭhi guṇe rato ",
  "ja545:55.1": "Sammato brāhmaṇibbhānaṃ ",
  "ja545:55.2": "saṃvibhāgarato suci, ",
  "ja545:55.3": "na cāpi pāpakaṃ kammaṃ ",
  "ja545:55.4": "sarāmi katam attano. ",
  "ja545:56.1": "Tato cut' āhaṃ Vedeha ",
  "ja545:56.2": "idha jāto duritthiyā ",
  "ja545:56.3": "gabbhamhi kumbhadāsiyā ",
  "ja545:56.4": "yato jāto suduggato. ",
  "ja545:57.1": "Evam pi duggato santo ",
  "ja545:57.2": "samacariyaṃ adhiṭṭhito ",
  "ja545:57.3": "upaḍḍhabhāgaṃ bhattassa ",
  "ja545:57.4": "dadāmi yo me icchati. ",
  "ja545:58.1": "Cātuddasiṃ pañcadasiṃ ",
  "ja545:58.2": "sadā upavasām' ahaṃ, ",
  "ja545:58.3": "na cāpi bhūte hiṃsāmi ",
  "ja545:58.4": "theyyañ cāpi vivajjayiṃ. ",
  "ja545:59.1": "Sabbam eva hi nūn' etaṃ ",
  "ja545:59.2": "suciṇṇaṃ bhavati nipphalaṃ, ",
  "ja545:59.3": "niratthaṃ maññ' idaṃ sīlaṃ ",
  "ja545:59.4": "Alāto bhāsatī yathā. ",
  "ja545:60.1": "Kalim eva nūna gaṇhāmi ",
  "ja545:60.2": "asippo dhuttako yathā, ",
  "ja545:60.3": "kaṭaṃ Alāto gaṇhāti ",
  "ja545:60.4": "kitavā sikkhito yathā. ",
  "ja545:61.1": "Dvāraṃ na-ppatipassāmi ",
  "ja545:61.2": "yena gacchāmi suggatiṃ, ",
  "ja545:61.3": "tasmā rāja parodāmi ",
  "ja545:61.4": "sutvā Kassapabhāsitanti. ",
  "ja545:62.1": "Bījakassa vaco sutvā ",
  "ja545:62.2": "rājā Aṅgati-m-abravī: ",
  "ja545:62.3": "n' atthi dvāraṃ sugatiyā ",
  "ja545:62.4": "niyatiṃ kaṃkha Bījaka. ",
  "ja545:63.1": "Sukhaṃ vā yadivā dukkhaṃ ",
  "ja545:63.2": "niyatiyā kira labbhati ",
  "ja545:63.3": "saṃsārasuddhi sabbesaṃ, ",
  "ja545:63.4": "mā turittho anāgate. ",
  "ja545:64.1": "Aham pi pubbe kalyāṇo ",
  "ja545:64.2": "brāhmaṇibbhesu vyāvaṭo ",
  "ja545:64.3": "vohāraṃ anusāsanto ",
  "ja545:64.4": "ratihīno tadantarāti. ",
  "ja545:65.1": "Puna pi bhante dakkhemu ",
  "ja545:65.2": "saṅgati ce bhavissatīti. ",
  "ja545:65.3": "Idaṃ vatvāna Vedeho ",
  "ja545:65.4": "paccagā sanivesananti. ",
  "ja545:66.1": "Tato ratyā vivasane ",
  "ja545:66.2": "upaṭṭhānamhi Aṅgati ",
  "ja545:66.3": "amacce sannipātetvā ",
  "ja545:66.4": "idaṃ vacanam abravi: ",
  "ja545:67.1": "Candake me vimānasmiṃ ",
  "ja545:67.2": "sadā kāme vidhentu me, ",
  "ja545:67.3": "mā m' ūpagañchuṃ atthesu ",
  "ja545:67.4": "guyhappākāsiyesu ca. ",
  "ja545:68.1": "Vijayo ca Sunāmo ca ",
  "ja545:68.2": "senāpati Alātako ",
  "ja545:68.3": "ete atthe nisīdantu ",
  "ja545:68.4": "vohārakusalā tayo. ",
  "ja545:69.1": "Idaṃ vatvāna Vedeho ",
  "ja545:69.2": "kāme ca bahumaññatha, ",
  "ja545:69.3": "na cāpi brāhmaṇibbhesu ",
  "ja545:69.4": "atthe kismiñci vyāvaṭoti. ",
  "ja545:70.1": "Tato dvesattarattassa ",
  "ja545:70.2": "Vedehass' atrajā piyā ",
  "ja545:70.3": "rājakaññā Rujā nāma ",
  "ja545:70.4": "dhātimātaram abravi: ",
  "ja545:71.1": "Alaṃkarotha maṃ khippaṃ, ",
  "ja545:71.2": "sakhiyo ca karontu me, ",
  "ja545:71.3": "suve pannaraso dibbo, ",
  "ja545:71.4": "gacchaṃ issarasantike. ",
  "ja545:72.1": "Tassā malyaṃ abhihariṃsu ",
  "ja545:72.2": "candanañ ca mahārahaṃ ",
  "ja545:72.3": "maṇisaṃkhamuttāratanaṃ ",
  "ja545:72.4": "nānāratte ca ambare. ",
  "ja545:73.1": "Tañ ca sovaṇṇaye pīṭhe ",
  "ja545:73.2": "nisinnaṃ bahukitthiyo ",
  "ja545:73.3": "parikiriya asobhiṃsu ",
  "ja545:73.4": "Rujaṃ ruciravaṇṇininti. ",
  "ja545:74.1": "Sā ca sakhīmajjhagatā ",
  "ja545:74.2": "sabbābharaṇabhūsitā ",
  "ja545:74.3": "sateratā abbham iva ",
  "ja545:74.4": "Candakaṃ pāvisī Rujā. ",
  "ja545:75.1": "Upasaṃkamitvā Vedehaṃ ",
  "ja545:75.2": "vanditvā vinaye rataṃ ",
  "ja545:75.3": "suvaṇṇavikate pīṭhe ",
  "ja545:75.4": "ekamantaṃ upāvisīti. ",
  "ja545:76.1": "Tañ ca disvāna Vedeho ",
  "ja545:76.2": "accharānaṃ va saṅgamaṃ ",
  "ja545:76.3": "Rujaṃ sakhīmajjhagataṃ ",
  "ja545:76.4": "idaṃ vacanam abravī: ",
  "ja545:77.1": "Kacci ramasi pāsāde ",
  "ja545:77.2": "antopokkharaṇiṃ pati, ",
  "ja545:77.3": "kacci bahuvidhaṃ khajjaṃ ",
  "ja545:77.4": "sadā abhiharanti te. ",
  "ja545:78.1": "Kacci bahuvidhaṃ malyaṃ ",
  "ja545:78.2": "ocinitvā kumāriyo ",
  "ja545:78.3": "gharake karotha paccekaṃ ",
  "ja545:78.4": "khiḍḍāratiratā muhuṃ. ",
  "ja545:79.1": "Kena vā vikalaṃ tuyhaṃ ",
  "ja545:79.2": "khippaṃ abhiharantu te, ",
  "ja545:79.3": "mano karassu kuḍḍamukhī ",
  "ja545:79.4": "api candasamamhi pīti. ",
  "ja545:80.1": "Vedehassa vaco sutvā ",
  "ja545:80.2": "Rujā pitaram abravi: ",
  "ja545:80.3": "sabbam etaṃ mahārāja ",
  "ja545:80.4": "labbhat' issarasantike. ",
  "ja545:81.1": "Suve pannaraso dibbo, ",
  "ja545:81.2": "sahassaṃ āharantu me, ",
  "ja545:81.3": "yathā dinnañ ca dassāmi ",
  "ja545:81.4": "dānaṃ sabbavanīsu 'hanti. ",
  "ja545:82.1": "Rujāya vacanaṃ sutvā ",
  "ja545:82.2": "rājā Aṅgati-m-abravi: ",
  "ja545:82.3": "bahuṃ vināsitaṃ vittaṃ ",
  "ja545:82.4": "niratthaṃ aphalan tayā. ",
  "ja545:83.1": "Uposathe vasaṃ niccaṃ ",
  "ja545:83.2": "annapānaṃ na bhuñjasi, ",
  "ja545:83.3": "niyat' etaṃ abhuttabbaṃ, ",
  "ja545:83.4": "n' atthi puññaṃ abhuñjatoti. ",
  "ja545:84.1": "Bījako pi hi sutvāna ",
  "ja545:84.2": "tadā Kassapabhāsitaṃ ",
  "ja545:84.3": "passasanto muhuṃ uṇhaṃ ",
  "ja545:84.4": "rudaṃ assūni vattayi. ",
  "ja545:85.1": "Yāva Ruje jīvasi no ",
  "ja545:85.2": "mā bhattam apanāmayi, ",
  "ja545:85.3": "n' atthi bhadde paro loko, ",
  "ja545:85.4": "kiṃ niratthaṃ vihaññasīti. ",
  "ja545:86.1": "Vedehassa vaco sutvā ",
  "ja545:86.2": "Rujā ruciravaṇṇinī ",
  "ja545:86.3": "jānaṃ pubbāparaṃ dhammaṃ ",
  "ja545:86.4": "pitaraṃ etad abravi: ",
  "ja545:87.1": "Sutaṃ eva pure āsi ",
  "ja545:87.2": "sakkhi diṭṭham idaṃ mayā: ",
  "ja545:87.3": "bālūpasevī yo hoti ",
  "ja545:87.4": "bālo va samapajjatha. ",
  "ja545:88.1": "Mūḷho hi mūḷham āgamma ",
  "ja545:88.2": "bhiyyo mohaṃ nigacchati, ",
  "ja545:88.3": "patirūpaṃ Alātena ",
  "ja545:88.4": "Bījakena ca muyhitunti. ",
  "ja545:89.1": "Tvañ ca devāsi sappañño ",
  "ja545:89.2": "dhīro atthassa kovido, ",
  "ja545:89.3": "kathaṃ bālehi sadisaṃ ",
  "ja545:89.4": "hīnaṃ diṭṭhim upāgamī. ",
  "ja545:90.1": "Sace hi saṃsārapathena sujjhati ",
  "ja545:90.2": "niratthiyā pabbajjā Guṇassa, ",
  "ja545:90.3": "kīṭo va aggiṃ jalitaṃ apāpataṃ ",
  "ja545:90.4": "upapajjatī momuho naggabhāvaṃ. ",
  "ja545:91.1": "Saṃsārasuddhīti pure niviṭṭhā ",
  "ja545:91.2": "kammaṃ vidūsenti bahū ajānaṃ ",
  "ja545:91.3": "pubbe kalī duggahito va atthā ",
  "ja545:91.4": "dummocayā balisā ambujo vāti. ",
  "ja545:92.1": "Upaman te karissāmi ",
  "ja545:92.2": "mahārāja tav' atthiyā, ",
  "ja545:92.3": "upamāya pi ekacce ",
  "ja545:92.4": "atthaṃ jānanti paṇḍitā. ",
  "ja545:93.1": "Vānijānaṃ yathā nāvā ",
  "ja545:93.2": "appamāṇaharā garu ",
  "ja545:93.3": "atibhāraṃ samādāya ",
  "ja545:93.4": "aṇṇave avasīdati ",
  "ja545:94.1": "Evam eva naro pāpaṃ ",
  "ja545:94.2": "thokathokaṃ pi ācinaṃ ",
  "ja545:94.3": "atibhāraṃ samādāya ",
  "ja545:94.4": "niraye avasīdati. ",
  "ja545:95.1": "Na tāva bhāro paripūro ",
  "ja545:95.2": "Alātassa mahīpati ",
  "ja545:95.3": "ācināti etaṃ pāpaṃ ",
  "ja545:95.4": "yena gacchati duggatiṃ. ",
  "ja545:96.1": "Pubbe c' assa kataṃ puññaṃ ",
  "ja545:96.2": "Alātassa mahīpati, ",
  "ja545:96.3": "tass' eva deva nissando ",
  "ja545:96.4": "yañ c' eso labhate sukhaṃ. ",
  "ja545:97.1": "Khiyyate c' assa taṃ puññaṃ ",
  "ja545:97.2": "tathā hi aguṇe rato, ",
  "ja545:97.3": "ujumaggaṃ avahāya ",
  "ja545:97.4": "kummaggam anudhāvati. ",
  "ja545:98.1": "Tulā yathā paggahitā ",
  "ja545:98.2": "ohite tulamaṇḍale ",
  "ja545:98.3": "unnameti tulāsīsaṃ ",
  "ja545:98.4": "bhāre oropite sati ",
  "ja545:99.1": "Evam eva naro puññaṃ ",
  "ja545:99.2": "thokathokam pi ācinaṃ ",
  "ja545:99.3": "saggātimāno dāso va ",
  "ja545:99.4": "Bījako sātave ratoti. ",
  "ja545:100.1": "Yam ajja Bījako dāso ",
  "ja545:100.2": "dukkhaṃ passati attani ",
  "ja545:100.3": "pubbe tassa kataṃ pāpaṃ ",
  "ja545:100.4": "tam eso paṭisevati. ",
  "ja545:101.1": "Khīyate c' assa taṃ pāpaṃ ",
  "ja545:101.2": "tathā hi vinaye rato ",
  "ja545:101.3": "Kassapañ ca samāpajja ",
  "ja545:101.4": "mā h' ev' uppatham āgamāti. ",
  "ja545:102.1": "Yaṃ yaṃ hi rājā bhajati ",
  "ja545:102.2": "sataṃ vā yadivā asaṃ (IV 435|21) ",
  "ja545:102.3": "sīlavantaṃ visīlaṃ vā ",
  "ja545:102.4": "vasaṃ tass' eva gacchati. ",
  "ja545:103.1": "Yādisaṃ kurute mittaṃ ",
  "ja545:103.2": "yādisaṃ c' ūpasevati ",
  "ja545:103.3": "so pi tādisako hoti ",
  "ja545:103.4": "sahavāso hi tādiso. ",
  "ja545:104.1": "Sevamāno sevamānaṃ ",
  "ja545:104.2": "samphuṭṭho samphusaṃ paraṃ ",
  "ja545:104.3": "saro diddho kalāpaṃ va ",
  "ja545:104.4": "alittaṃ upalimpati, ",
  "ja545:104.5": "upalepabhayā dhīro ",
  "ja545:104.6": "n' eva pāpasakhā siyā. ",
  "ja545:105.1": "Pūtimacchaṃ kusaggena ",
  "ja545:105.2": "yo naro upanayhati ",
  "ja545:105.3": "kusāpi pūtī vāyanti, ",
  "ja545:105.4": "evaṃ bālūpasevanā. ",
  "ja545:106.1": "Tagarañ ca palāsena ",
  "ja545:106.2": "yo naro upanayhati ",
  "ja545:106.3": "pattāpi surabhī vāyanti, ",
  "ja545:106.4": "evaṃ dhīrūpasevanā. ",
  "ja545:107.1": "Tasmā phalapuṭasseva ",
  "ja545:107.2": "ñatvā sampākam attano ",
  "ja545:107.3": "asante n' ūpaseveyya ",
  "ja545:107.4": "sante seveyya paṇḍito, ",
  "ja545:107.5": "asanto nirayaṃ nenti, ",
  "ja545:107.6": "santo pāpenti suggatinti. ",
  "ja545:108.1": "Aham pi jātiyo satta ",
  "ja545:108.2": "sare saṃsarit' attano ",
  "ja545:108.3": "anāgatāpi satt' eva ",
  "ja545:108.4": "yā gamissaṃ ito cutā. ",
  "ja545:109.1": "Yā me sā sattamī jāti ",
  "ja545:109.2": "ahu pubbe janādhipa ",
  "ja545:109.3": "kammāraputto Magadhe [su] ",
  "ja545:109.4": "ahu Rājagahe pure. ",
  "ja545:110.1": "Pāpaṃ sahāyaṃ āgamma ",
  "ja545:110.2": "bahuṃ pāpaṃ kataṃ mayā ",
  "ja545:110.3": "paradārassa heṭhento ",
  "ja545:110.4": "carimha amarā viya. ",
  "ja545:111.1": "Taṃ kammaṃ nihitaṃ aṭṭhā ",
  "ja545:111.2": "bhasmācchanno va pāvako, ",
  "ja545:111.3": "atha aññehi kammehi ",
  "ja545:111.4": "ajāyiṃ Vaṃsabhūmiyaṃ ",
  "ja545:112.1": "Kosambiyaṃ seṭṭhikule ",
  "ja545:112.2": "iddhe phīte mahaddhane ",
  "ja545:112.3": "ekaputto mahārāja ",
  "ja545:112.4": "niccaṃ sakkatapūjito. ",
  "ja545:113.1": "Tattha mittaṃ asevissaṃ ",
  "ja545:113.2": "sahāyaṃ sātave rataṃ ",
  "ja545:113.3": "paṇḍitaṃ sutasampannaṃ, ",
  "ja545:113.4": "so maṃ atthe nivesayi. ",
  "ja545:114.1": "Cātuddasiṃ pañcadasiṃ ",
  "ja545:114.2": "bahuṃ rattim upāvasiṃ, ",
  "ja545:114.3": "taṃ kammaṃ nihitaṃ aṭṭhā, ",
  "ja545:114.4": "nidhīva udakantike. ",
  "ja545:115.1": "Atha pāpānaṃ kammānaṃ ",
  "ja545:115.2": "yam etaṃ Magadhe kataṃ ",
  "ja545:115.3": "phalaṃ pariyāgataṃ pacchā ",
  "ja545:115.4": "bhutvā duṭṭhavisaṃ yathā ",
  "ja545:116.1": "Tato cut' āhaṃ Vedeha ",
  "ja545:116.2": "Roruve niraye ciraṃ, ",
  "ja545:116.3": "sakammanā apaccisaṃ, ",
  "ja545:116.4": "taṃ saraṃ na sukhaṃ labhe. ",
  "ja545:117.1": "Bahuvassagaṇe tattha ",
  "ja545:117.2": "khepayitvā bahuṃ dukhaṃ ",
  "ja545:117.3": "Bheṇṇākaṭe ahuṃ rāja ",
  "ja545:117.4": "chakalo uddhitapphaloti. ",
  "ja545:118.1": "Sātaputtā mayā vūḷhā ",
  "ja545:118.2": "piṭṭhiyā ca rathena ca, ",
  "ja545:118.3": "tassa kammassa nissando ",
  "ja545:118.4": "paradāragamanassa meti. ",
  "ja545:119.1": "Tato cut' āhaṃ Vedeha ",
  "ja545:119.2": "kapi āsiṃ brahāvane ",
  "ja545:119.3": "nilicchitaphalo yeva ",
  "ja545:119.4": "yūthapena pagabbhinā, ",
  "ja545:119.5": "tassa kammassa nissando ",
  "ja545:119.6": "paradāragamanassa meti. ",
  "ja545:120.1": "Tato cut' āhaṃ Vedeha ",
  "ja545:120.2": "Dasaṇṇesu pasū ahuṃ ",
  "ja545:120.3": "nilicchito javo bhadro, ",
  "ja545:120.4": "yoggaṃ vūḷhaṃ ciraṃ mayā, ",
  "ja545:120.5": "tassa kammassa nissando ",
  "ja545:120.6": "paradāragamanassa me. ",
  "ja545:121.1": "Tato cut' āhaṃ Vedeha ",
  "ja545:121.2": "Vajjīsu kulam āgamaṃ, ",
  "ja545:121.3": "n' ev' itthī na pumā āsiṃ ",
  "ja545:121.4": "manussatte sudullabhe, ",
  "ja545:121.5": "tassa kammassa nissando ",
  "ja545:121.6": "paradāragamanassa me. ",
  "ja545:122.1": "Tato cut' āhaṃ Vedeha ",
  "ja545:122.2": "ajāyiṃ Nandane vane, ",
  "ja545:122.3": "bhavane Tāvatiṃs' ahaṃ ",
  "ja545:122.4": "accharā kāmavaṇṇinī ",
  "ja545:123.1": "Vicittavatthābharaṇā ",
  "ja545:123.2": "āmuttamaṇikuṇḍalā ",
  "ja545:123.3": "kusalā naccagītassa ",
  "ja545:123.4": "Sakkassa paricārikā. ",
  "ja545:124.1": "Tattha ṭhitāhaṃ Vedeha ",
  "ja545:124.2": "sarāmi jātiyo imā ",
  "ja545:124.3": "anāgatāpi satt' eva ",
  "ja545:124.4": "yā gamissaṃ ito cutā. ",
  "ja545:125.1": "Pariyāgatan taṃ kusalaṃ ",
  "ja545:125.2": "yam me Kosambiyaṃ kataṃ ",
  "ja545:125.3": "deve c' eva manusse ca ",
  "ja545:125.4": "sandhāvissaṃ ito cutā. ",
  "ja545:126.1": "Sattajaccā mahārāja ",
  "ja545:126.2": "niccaṃ sakkatapūjitā, ",
  "ja545:126.3": "thībhāvāpi na muccissaṃ ",
  "ja545:126.4": "chaṭṭhā nigatiyo imā. ",
  "ja545:127.1": "Sattamī ca gati deva: ",
  "ja545:127.2": "devaputto mahiddhiko ",
  "ja545:127.3": "pumadevo bhavissāmi ",
  "ja545:127.4": "devakāyasmim uttamo. ",
  "ja545:128.1": "Ajjāpi santānamayaṃ ",
  "ja545:128.2": "mālaṃ ganthenti Nandane ",
  "ja545:128.3": "devaputto Javo nāma ",
  "ja545:128.4": "yo me mālaṃ paṭicchati. ",
  "ja545:129.1": "Muhutto viya so dibbo ",
  "ja545:129.2": "imāni vassāni soḷasa, ",
  "ja545:129.3": "rattindivo ca so dibbo ",
  "ja545:129.4": "mānusī sarado sataṃ. ",
  "ja545:130.1": "Iti kammāni anventi ",
  "ja545:130.2": "asaṃkheyyāpi jātiyo ",
  "ja545:130.3": "kalyāṇaṃ yadivā pāpaṃ, ",
  "ja545:130.4": "na hi kammaṃ panassatīti. ",
  "ja545:131.1": "Yo icche puriso hotuṃ ",
  "ja545:131.2": "jātijātiṃ punappunaṃ ",
  "ja545:131.3": "paradāraṃ vivajjeyya ",
  "ja545:131.4": "dhotapādo va kaddamaṃ. ",
  "ja545:132.1": "Yo icche puriso hotuṃ ",
  "ja545:132.2": "jātijātiṃ punappunaṃ ",
  "ja545:132.3": "sāmikaṃ apacāyeyya ",
  "ja545:132.4": "Indaṃ va paricārikā. ",
  "ja545:133.1": "Yo icche dibbabhogañ ca ",
  "ja545:133.2": "dibbaṃ āyu yasaṃ sukhaṃ ",
  "ja545:133.3": "pāpāni parivajjetvā ",
  "ja545:133.4": "tividhaṃ dhammam ācare. ",
  "ja545:134.1": "Kāyena vācā manasā ",
  "ja545:134.2": "appamatto vicakkhaṇo ",
  "ja545:134.3": "attano hoti atthāya ",
  "ja545:134.4": "itthi vā yadivā pumā. ",
  "ja545:135.1": "Ye kec' ime manujā jīvaloke ",
  "ja545:135.2": "yasassino sabbasamantabhogā ",
  "ja545:135.3": "asaṃsayaṃ tehi pure suciṇṇaṃ ",
  "ja545:135.4": "kammassakā ye puthu sabbasattā. ",
  "ja545:136.1": "Iṃghānucintesi sayam pi deva ",
  "ja545:136.2": "kutonidānā te imā janinda ",
  "ja545:136.3": "yā te imā accharāsannikāsā ",
  "ja545:136.4": "alaṃkatā kañcanajālachannāti. ",
  "ja545:137.1": "Icc-evaṃ pitaraṃ kaññā ",
  "ja545:137.2": "Rujā tosesi Aṅgatiṃ, ",
  "ja545:137.3": "mūḷhassa maggam ācikkhi, ",
  "ja545:137.4": "dhammam akkhāsi subbatāti. ",
  "ja545:138.1": "Athāgamā Brahmalokā ",
  "ja545:138.2": "Nārado mānusiṃ pajaṃ, ",
  "ja545:138.3": "Jambudīpaṃ avekkhanto ",
  "ja545:138.4": "adda rājānam Aṅgatiṃ. ",
  "ja545:139.1": "Tato patiṭṭhā pāsāde ",
  "ja545:139.2": "Vedehassa puratthato ",
  "ja545:139.3": "tañ ca disvā anuppattaṃ Rujā ",
  "ja545:139.4": "isim avandathāti. ",
  "ja545:140.1": "Athāsanamhā oruyha ",
  "ja545:140.2": "rājā vyamhitamānaso ",
  "ja545:140.3": "Nāradaṃ paripucchanto ",
  "ja545:140.4": "idaṃ vacanam abravi: ",
  "ja545:141.1": "Kuto nu āgacchasi devavaṇṇī ",
  "ja545:141.2": "obhāsayaṃ saṃvariṃ Candimā va. ",
  "ja545:141.3": "akkhāhi me pucchito nāmagottaṃ ",
  "ja545:141.4": "kathaṃ taṃ jānanti manussaloketi. Ahaṃ ",
  "ja545:142.1": "hi devato idāni emi ",
  "ja545:142.2": "obhāsayaṃ saṃvariṃ Candimā va, ",
  "ja545:142.3": "akkhāmi te pucchito nāmagottaṃ ",
  "ja545:142.4": "jānanti maṃ Nārado Kassapo cāti. Acchariyarūpaṃ vata yādisañ ca ",
  "ja545:143.1": "vehāsayaṃ ",
  "ja545:143.2": "gacchasi tiṭṭhasī ca, ",
  "ja545:143.3": "pucchāmi taṃ Nārada etam atthaṃ: ",
  "ja545:143.4": "atha kena vaṇṇena tavāyam iddhīti. ",
  "ja545:144.1": "Saccañ ca dhammo ca damo ca cāgo ",
  "ja545:144.2": "guṇā mam' ete pakatā purāṇā, ",
  "ja545:144.3": "teh' eva dhammehi susevitehi ",
  "ja545:144.4": "manojavo yenakāmaṃ gato 'smīti. Acchariyam ",
  "ja545:145.1": "ācikkhasi puññasiddhiṃ, ",
  "ja545:145.2": "sace hi ete tvaṃ yathā vadesi ",
  "ja545:145.3": "pucchāmi taṃ Nārada etam atthaṃ, ",
  "ja545:145.4": "puṭṭho ca me sādhu viyākarohīti. ",
  "ja545:146.1": "Pucchassu maṃ rāja, tav' esa attho, ",
  "ja545:146.2": "yaṃ saṃsayaṃ kuruse bhūmipāla, ",
  "ja545:146.3": "ahaṃ taṃ nissaṃsayataṃ gamemi ",
  "ja545:146.4": "nayehi ñāyehi ca hetubhī cāti. ",
  "ja545:147.1": "Pucchāmi taṃ Nārada etam atthaṃ ",
  "ja545:147.2": "puṭṭho ca me Nārada mā musā bhaṇi: ",
  "ja545:147.3": "atthi nu devā pitaro nu atthi ",
  "ja545:147.4": "loko paro atthi jano yam āhūti. ",
  "ja545:148.1": "Atth' eva devā pitaro ca atthi ",
  "ja545:148.2": "loko paro atthi jano yam āhu, ",
  "ja545:148.3": "kāmesu giddhā ca narā pamūḷhā ",
  "ja545:148.4": "lokaṃ paraṃ na vidū mohayuttāti. ",
  "ja545:149.1": "Atthīti ce Nārada saddahāsi ",
  "ja545:149.2": "nivesanaṃ paraloke matānaṃ ",
  "ja545:149.3": "idh' eva me pañca satāni dehi ",
  "ja545:149.4": "dassāmi te paraloke sahassanti. ",
  "ja545:150.1": "Dajjemu kho pañca satāni bhoto ",
  "ja545:150.2": "jaññāma ce sīlavantaṃ vadaññuṃ, ",
  "ja545:150.3": "luddan taṃ bhontaṃ niraye vasantaṃ ",
  "ja545:150.4": "ko codaye paraloke sahassaṃ. ",
  "ja545:151.1": "Idh' eva yo hoti akammasīlo ",
  "ja545:151.2": "pāpācāro alaso luddakammo ",
  "ja545:151.3": "na paṇḍitā tasmiṃ iṇaṃ dadanti, ",
  "ja545:151.4": "na hi āgamo hoti tathāvidhamhā. ",
  "ja545:152.1": "Dakkhañ ca posaṃ manujā viditvā ",
  "ja545:152.2": "uṭṭhānakaṃ sīlavantaṃ vadaññuṃ ",
  "ja545:152.3": "sayam bhogehi nimantayanti, ",
  "ja545:152.4": "kammaṃ karitvā punam āharesīti. ",
  "ja545:153.1": "Ito gato dakkhasi tattha rājā ",
  "ja545:153.2": "kākolasaṅghehi pi kaḍḍhamānaṃ ",
  "ja545:153.3": "taṃ khajjamānaṃ niraye vasantaṃ, ",
  "ja545:153.4": "kākehi gijjhehi ca senakehi ",
  "ja545:153.5": "saṃchinnagattaṃ ruhiraṃ savantaṃ, ",
  "ja545:153.6": "ko codaye paraloke sahassanti. ",
  "ja545:154.1": "Andhaṃ tamaṃ tattha na Canda-Suriyā, ",
  "ja545:154.2": "nirayo sadā tumulo ghorarūpo, ",
  "ja545:154.3": "sā n' eva rattī na divāti paññāyati, ",
  "ja545:154.4": "tathāvidhe ko vicare dhanatthikoti. ",
  "ja545:155.1": "Sabalo ca Sāmo ca duve suvānā ",
  "ja545:155.2": "pavaddhakāyā balino mahantā ",
  "ja545:155.3": "khādanti dantehi ayomayehi ",
  "ja545:155.4": "ito panuṇṇaṃ paralokapattanti. ",
  "ja545:156.1": "Taṃ khajjamānaṃ niraye vasantaṃ ",
  "ja545:156.2": "luddehi vālehi aghammigehi ca ",
  "ja545:156.3": "saṃchinnagattaṃ ruhiraṃ savantaṃ ",
  "ja545:156.4": "ko codaye paroloke sahassanti. ",
  "ja545:157.1": "Usūhi sattīhi sunissitāhi ",
  "ja545:157.2": "hananti vijjhanti ca paccamittā ",
  "ja545:157.3": "Kāḷūpakāḷā nirayamhi ghore ",
  "ja545:157.4": "pubbe naraṃ dukkaṭakammakārinti. ",
  "ja545:158.1": "Taṃ haññamānaṃ niraye vajantaṃ ",
  "ja545:158.2": "kucchismiṃ passasmiṃ viphālitūdaraṃ ",
  "ja545:158.3": "saṃchinnagattaṃ ruhiraṃ savantaṃ ",
  "ja545:158.4": "ko codaye paraloke sahassanti. ",
  "ja545:159.1": "Sattīusūtomarabhindivālā ",
  "ja545:159.2": "vividhāvudhā vassati tattha devo ",
  "ja545:159.3": "patanti aṅgāra-m-iv' accimanto, ",
  "ja545:159.4": "silāsanī vassati luddakammeti. ",
  "ja545:160.1": "Uṇho ca vāto nirayamhi dussaho, ",
  "ja545:160.2": "na tahiṃ sukhaṃ labbhati ittaram pi, ",
  "ja545:160.3": "taṃ taṃ vidhāvantam alenam āturaṃ ",
  "ja545:160.4": "ko codaye paraloke sahassanti. Sandhāvamānaṃ ",
  "ja545:161.1": "taṃ rathesu yuttaṃ ",
  "ja545:161.2": "sajotibhūtaṃ paṭhaviṃ kamantaṃ ",
  "ja545:161.3": "",
  "ja545:161.4": "",
  "ja545:162.1": "Tam āruhantaṃ khurasaṃcitaṃ giriṃ ",
  "ja545:162.2": "vibhiṃsanaṃ pajjalitaṃ bhayānakaṃ ",
  "ja545:162.3": "sañchinnagattaṃ ruhiraṃ savantaṃ ",
  "ja545:162.4": "ko codaye paraloke sahassanti. ",
  "ja545:163.1": "Tam āruhantaṃ pabbatasannikāsaṃ ",
  "ja545:163.2": "aṅgārarāsiṃ jalitaṃ bhayānakaṃ ",
  "ja545:163.3": "sandaḍḍhagattaṃ kapaṇaṃ rudantaṃ ",
  "ja545:163.4": "ko codaye paraloke sahassanti. ",
  "ja545:164.1": "Abbhakūṭasamā uccā ",
  "ja545:164.2": "kaṇṭakāpacitā dumā ",
  "ja545:164.3": "ayomayehi tikkhehi ",
  "ja545:164.4": "naralohitapāyihīti. ",
  "ja545:165.1": "Tam āruhanti nāriyo ",
  "ja545:165.2": "narā ca paradāragū ",
  "ja545:165.3": "coditā sattihatthehi ",
  "ja545:165.4": "Yamaniddesakārihīti. ",
  "ja545:166.1": "Tam āruhantaṃ nirayaṃ ",
  "ja545:166.2": "simbaliṃ ruhiramakkhitaṃ ",
  "ja545:166.3": "viduṭṭhakāyaṃ vitacaṃ ",
  "ja545:166.4": "āturaṃ gāḷhavedanaṃ ",
  "ja545:167.1": "Passasantaṃ muhuṃ uṇhaṃ ",
  "ja545:167.2": "pubbakammāparādhikaṃ ",
  "ja545:167.3": "dumagge vitacagattaṃ ",
  "ja545:167.4": "ko taṃ yāceyya taṃ dhananti. ",
  "ja545:168.1": "Abbhakūṭasamā uccā ",
  "ja545:168.2": "asipattācitā dumā ",
  "ja545:168.3": "ayomayehi tikkhehi ",
  "ja545:168.4": "naralohitapāyihīti. Tam ",
  "ja545:169.1": "ānupattaṃ asipattapādapaṃ ",
  "ja545:169.2": "asīhi tikkhehi ca chijjamānaṃ ",
  "ja545:169.3": "sañchinnagattaṃ ruhiraṃ savantaṃ ",
  "ja545:169.4": "ko codaye paraloke sahassanti. ",
  "ja545:170.1": "Tato nikkhantamattan taṃ ",
  "ja545:170.2": "asipattanirayā dukhā ",
  "ja545:170.3": "sampatitaṃ Vetaraṇiṃ ",
  "ja545:170.4": "ko taṃ yāceyya taṃ dhananti. ",
  "ja545:171.1": "Kharā kharodikā tattā ",
  "ja545:171.2": "duggā Vetaraṇī nadī ",
  "ja545:171.3": "ayopokkharasañchannā ",
  "ja545:171.4": "tikkhapattehi sandatīti. ",
  "ja545:172.1": "Tattha sañchinnagattaṃ taṃ ",
  "ja545:172.2": "vuyhantaṃ ruhiramakkhitaṃ ",
  "ja545:172.3": "Vetaraññe anālambe ",
  "ja545:172.4": "ko taṃ yāceyya taṃ dhananti. ",
  "ja545:173.1": "Vedhāmi rukkho viya chijjamāno, ",
  "ja545:173.2": "disaṃ na jānāmi pamūḷhasaññī, ",
  "ja545:173.3": "bhayasānutappāmi mahā ca me bhayā ",
  "ja545:173.4": "sutvāna gāthā tava bhāsitā ise. ",
  "ja545:174.1": "Āditte vārimajjhaṃ va ",
  "ja545:174.2": "dīpaṃ v' oghe-r-iv' aṇṇave ",
  "ja545:174.3": "andhakāre va pajjoto ",
  "ja545:174.4": "tvaṃ no si saraṇaṃ ise. ",
  "ja545:175.1": "Atthañ ca dhammañ ca anusāsa maṃ ise, ",
  "ja545:175.2": "atītam addhā aparādhitaṃ mayā, ",
  "ja545:175.3": "ācikkha me Nārada suddhimaggaṃ ",
  "ja545:175.4": "yathā ahaṃ no niraye pateyyanti. ",
  "ja545:176.1": "Yathā ahū Dhataraṭṭho ",
  "ja545:176.2": "Vessāmitto ca Aṭṭhako Yāmataggi . . . ",
  "ja545:176.3": "Usinnaro cāpi Sivī ca rājā ",
  "ja545:176.4": "parivārakā samaṇabrāhmaṇānaṃ ",
  "ja545:177.1": "Ete c' aññe ca rājāno ",
  "ja545:177.2": "ye Sakkavisayaṃ gatā ",
  "ja545:177.3": "adhammaṃ parivajjetvā ",
  "ja545:177.4": "dhammaṃ cara mahīpati. ",
  "ja545:178.1": "Annahatthā ca te vyamhe ",
  "ja545:178.2": "ghosayantu pure tava: ",
  "ja545:178.3": "ko chāto ko ca tasito ",
  "ja545:178.4": "ko mālaṃ ko vilepanaṃ ",
  "ja545:178.5": "nānārattānaṃ vatthānaṃ ",
  "ja545:178.6": "ko naggo paridahessati, ",
  "ja545:179.1": "Ko panthe chattam ādeti ",
  "ja545:179.2": "pādukā ca mudū subhā, ",
  "ja545:179.3": "iti sāyañ ca pāto ca ",
  "ja545:179.4": "ghosayantu pure tava. ",
  "ja545:180.1": "Jiṇṇaṃ posaṃ gavassañ ca ",
  "ja545:180.2": "mā-ssu yuñji yathā pure, ",
  "ja545:180.3": "parihārañ ca dajjāsi, ",
  "ja545:180.4": "adhikārakato balīti. ",
  "ja545:181.1": "Kāyo te rathasaññāto ",
  "ja545:181.2": "manosārathiko lahu ",
  "ja545:181.3": "avihiṃsāsāritakkho ",
  "ja545:181.4": "saṃvibhāgapaṭicchado ",
  "ja545:182.1": "Pādasaññamanemiyo ",
  "ja545:182.2": "hatthasaññamapakkharo ",
  "ja545:182.3": "kucchisaññamanabbhanto ",
  "ja545:182.4": "vācāsaññamakūjano ",
  "ja545:183.1": "Saccavākyasamattaṅgo ",
  "ja545:183.2": "apesuññasusaññato ",
  "ja545:183.3": "girāsakhilanelaṅgo ",
  "ja545:183.4": "mitabhāṇisilāsito ",
  "ja545:184.1": "Saddhālobhasusaṃkhāro ",
  "ja545:184.2": "nivātañjalikubbaro ",
  "ja545:184.3": "atthaddhatānatīsāko ",
  "ja545:184.4": "sīlasaṃvaranandhano ",
  "ja545:185.1": "Akkodhanamanugghātī ",
  "ja545:185.2": "dhammapaṇḍarachattako ",
  "ja545:185.3": "bāhusaccamapālambo ",
  "ja545:185.4": "ṭhitacittamupādhiyo ",
  "ja545:186.1": "Kālaññutācittasāro ",
  "ja545:186.2": "vesārajjatidaṇḍako ",
  "ja545:186.3": "nivātavuttiyottako ",
  "ja545:186.4": "anatimānayugo lahu ",
  "ja545:187.1": "Alīnacittasanthāro ",
  "ja545:187.2": "vaddhasevī rajohato, ",
  "ja545:187.3": "sati patodo dhīrassa, ",
  "ja545:187.4": "dhiti yogo ca rasmiyo, ",
  "ja545:188.1": "Mano dantaṃ path' anveti ",
  "ja545:188.2": "samadantehi vāhihi ",
  "ja545:188.3": "icchā lobho ca kummaggo, ",
  "ja545:188.4": "ujumaggo ca saññamo. ",
  "ja545:189.1": "Rūpe sadde rase gandhe ",
  "ja545:189.2": "vāhanassa padhāvato ",
  "ja545:189.3": "paññā ākoṭanī rāja ",
  "ja545:189.4": "tattha attā va sārathi. ",
  "ja545:190.1": "Sace etena yānena ",
  "ja545:190.2": "samacariyā daḷhā dhiti ",
  "ja545:190.3": "sabbakāmaduho rāja ",
  "ja545:190.4": "na jātu nirayaṃ vajeti. ",
  "ja545:191.1": "Alāto Devadatto 'si, ",
  "ja545:191.2": "Sunāmo āsi Bhaddaji, ",
  "ja545:191.3": "Vijayo Sāriputto 'si, Mogallāno ",
  "ja545:191.4": "'si Bījako. ",
  "ja545:192.1": "Sunakkhatto Licchavīputto ",
  "ja545:192.2": "Guṇo āsi acelako, ",
  "ja545:192.3": "Ānando ca Rujā āsi ",
  "ja545:192.4": "yā rājānaṃ pasādayi. ",
  "ja545:193.1": "Uruvelakassapo rājā ",
  "ja545:193.2": "pāpadiṭṭhi tadā ahu, ",
  "ja545:193.3": "Mahābrahmā Bodhisatto, ",
  "ja545:193.4": "evaṃ dhāretha jātakanti. ",
  "ja545:194.1": ""
}
