  "ja492:0.4": "",
  "ja492:1.1": "Yad esamānā vicarimha ",
  "ja492:1.2": "pabbatāni vanāni ca ",
  "ja492:1.3": "anvesaṃ vicariṃ ñātī ",
  "ja492:1.4": "te 'me adhigatā mayā. ",
  "ja492:2.1": "Bahum idaṃ mūlaphalaṃ, ",
  "ja492:2.2": "bhakkho cāyaṃ anappako, ",
  "ja492:2.3": "rammā c' imā girinadiyo, ",
  "ja492:2.4": "phāsu vāso bhavissati. ",
  "ja492:3.1": "Idh' evāhaṃ vasissāmi ",
  "ja492:3.2": "saha sabbehi ñātibhi ",
  "ja492:3.3": "appossukko nirāsaṃkī ",
  "ja492:3.4": "asoko akutobhayoti. (= p. 71 |21.) ",
  "ja492:4.1": "Aññaṃ hi lenaṃ pariyesa, ",
  "ja492:4.2": "sattu no idha vijjati, ",
  "ja492:4.3": "so taccha sūkare hanti ",
  "ja492:4.4": "idhāgantvā varaṃ varanti. ",
  "ja492:5.1": "Ko n' amhākaṃ idha sattu, ",
  "ja492:5.2": "ko ñātī susamāgate ",
  "ja492:5.3": "appadhaṃse padhaṃseti, ",
  "ja492:5.4": "tam me akkhātha pucchitā. ",
  "ja492:6.1": "Uddhaggarāji migarājā ",
  "ja492:6.2": "balī dāṭhāvudho migo, ",
  "ja492:6.3": "so taccha sūkaraṃ hanti ",
  "ja492:6.4": "idhāgantvā varaṃ varaṃ. ",
  "ja492:7.1": "Na no dāṭhā na vijjanti, ",
  "ja492:7.2": "balaṃ kāye samūhataṃ, ",
  "ja492:7.3": "sabbe samaggā hutvāna ",
  "ja492:7.4": "vasaṃ kāhāma ekakaṃ. ",
  "ja492:8.1": "Hadayaṃgamaṃ kaṇṇasukhaṃ ",
  "ja492:8.2": "vācaṃ bhāsasi tacchaka, ",
  "ja492:8.3": "yo pi yuddhe palāyetha ",
  "ja492:8.4": "tam pi pacchā hanāmaseti. ",
  "ja492:9.1": "Pāṇātipātā virato nu ajja, ",
  "ja492:9.2": "abhayan nu te sabbabhūtesu dinnaṃ, ",
  "ja492:9.3": "dāṭhā nu te miga viriyaṃ na santi ",
  "ja492:9.4": "yo saṃghapatto kapaṇo va jhāyasīti. ",
  "ja492:10.1": "Na me dāṭhā na vijjhanti, ",
  "ja492:10.2": "balaṃ kāye samūhataṃ ",
  "ja492:10.3": "ñātī ca disvāna samaṅgi ekato ",
  "ja492:10.4": "tasmā jhāyāmi vanamhi ekako. ",
  "ja492:11.1": "Im' assudaṃ yanti disodisaṃ pure (= ",
  "ja492:11.2": "II407 |12) bhayadditā lenagavesino puthu, ",
  "ja492:11.3": "te dāni saṃgamma rasanti ekato, ",
  "ja492:11.4": "yatthaṭṭhitā duppasah' ajja te mayā. ",
  "ja492:12.1": "Pariṇāyakasampannā ",
  "ja492:12.2": "sahitā ekavādino ",
  "ja492:12.3": "te maṃ samaggā hiṃseyyuṃ, ",
  "ja492:12.4": "tasmā nesaṃ apatthaveti. ",
  "ja492:13.1": "Eko va Indo asure jināti, ",
  "ja492:13.2": "eko va seno hanti dije pasayha, ",
  "ja492:13.3": "eko va vyaggho migasaṃghapatto ",
  "ja492:13.4": "varaṃ varaṃ hanti, balaṃ hi tādisanti ",
  "ja492:14.1": "Na h' eva Indo na seno ",
  "ja492:14.2": "na pi vyaggho migādhipo ",
  "ja492:14.3": "samagge sahite ñātī ",
  "ja492:14.4": "vyagghe ca kurute vaseti ",
  "ja492:15.1": "Kumbhīlakā sakuṇakā ",
  "ja492:15.2": "saṃghino gaṇacārino ",
  "ja492:15.3": "sammodamānā ekajjham ",
  "ja492:15.4": "uppatanti dayanti ca. ",
  "ja492:16.1": "Tesañ ca ḍayamānānaṃ ",
  "ja492:16.2": "ek' ettha apavattati ",
  "ja492:16.3": "taṃ seno nitāḷeti, ",
  "ja492:16.4": "veyyagghi yeva sā gatīti. ",
  "ja492:17.1": "Ussāhito jaṭilena ",
  "ja492:17.2": "luddenāmisacakkhunā ",
  "ja492:17.3": "dāṭhī dāṭhisu pakkhandi ",
  "ja492:17.4": "maññamāno yathā pureti ",
  "ja492:18.1": "Sādhu sambahulā ñātī ",
  "ja492:18.2": "api rukkhā araññajā ",
  "ja492:18.3": "sūkarehi samaggehi ",
  "ja492:18.4": "vyaggho ekāyane hatoti ",
  "ja492:19.1": "Brāhmaṇañ c' eva vyagghañ ca ",
  "ja492:19.2": "ubho hantvāna sūkarā ",
  "ja492:19.3": "ānandino pamuditā ",
  "ja492:19.4": "mahānādam anādisunti. ",
  "ja492:20.1": "Te su udumbaramūlasmiṃ ",
  "ja492:20.2": "sūkarā susamāgatā ",
  "ja492:20.3": "tacchakaṃ abhisiñciṃsu: ",
  "ja492:20.4": "tvan no rājāsi issaroti. ",
  "ja492:21.1": ""
}
