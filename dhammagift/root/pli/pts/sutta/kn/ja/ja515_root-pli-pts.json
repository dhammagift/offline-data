  "ja515:1.1": "",
  "ja515:1.2": "Sucīrata, ",
  "ja515:1.3": "mahattaṃ pattum icchāmi ",
  "ja515:1.4": "vijetuṃ paṭhaviṃ imaṃ ",
  "ja515:2.1": "Dhammena no adhammena, ",
  "ja515:2.2": "adhammo me na ruccati, ",
  "ja515:2.3": "kicco va dhammo carito ",
  "ja515:2.4": "rañño hoti Sucīrata, ",
  "ja515:3.1": "Idha c' evāninditā yena ",
  "ja515:3.2": "pecca yena aninditā ",
  "ja515:3.3": "Yasaṃ devamanussesu ",
  "ja515:3.4": "yena pappomu brāhmaṇa. ",
  "ja515:4.1": "Yo 'ham atthañ ca dhammañ ca ",
  "ja515:4.2": "kattum icchāmi brāhmaṇa ",
  "ja515:4.3": "taṃ tvaṃ atthaṃ ca dhammañ ca ",
  "ja515:4.4": "brāhmaṇ' akkhāhi pucchitoti. ",
  "ja515:5.1": "Nāññatra Vidhurā rāja ",
  "ja515:5.2": "etad akkhātum arahati ",
  "ja515:5.3": "yaṃ tvaṃ atthañ ca dhammañ ca ",
  "ja515:5.4": "kattum icchasi khattiyāti g. ā. ",
  "ja515:6.1": "Ehi kho pahito gaccha ",
  "ja515:6.2": "Vidhurassa upantikaṃ, ",
  "ja515:6.3": "nikkham imaṃ suvaṇṇassa ",
  "ja515:6.4": "haraṃ gaccha Sucīrata, ",
  "ja515:6.5": "abhihāraṃ imaṃ dajjā ",
  "ja515:6.6": "atthadhammānusatthiyāti g. ā. ",
  "ja515:7.1": "Sv-ādhippāgā Bhāradvājo ",
  "ja515:7.2": "Vidhurassa upantikaṃ. ",
  "ja515:7.3": "tam addasa mahābrahmā ",
  "ja515:7.4": "asamānaṃ sake ghareti. ",
  "ja515:8.1": "Rañño 'haṃ pahito dūto ",
  "ja515:8.2": "Korabyassa yasassino, ",
  "ja515:8.3": "‘atthaṃ dhammañ ca pucchesi' ",
  "ja515:8.4": "icc-abravi Yudhiṭṭhilo, ",
  "ja515:8.5": "taṃ tvaṃ atthañ ca dhammañ ca ",
  "ja515:8.6": "Vidhur' akkhāhi pucchitoti. ",
  "ja515:9.1": "Gaṃgaṃ me pidahissanti, ",
  "ja515:9.2": "na naṃ sakkomi brāhmaṇa ",
  "ja515:9.3": "apidhetuṃ mahāsindhuṃ, ",
  "ja515:9.4": "taṃ kathaṃ so bhavissati, ",
  "ja515:9.5": "na te sakkomi akkhātuṃ ",
  "ja515:9.6": "atthaṃ dhammaṃ ca pucchitoti. ",
  "ja515:10.1": "Bhadrakāro ca me putto ",
  "ja515:10.2": "oraso mama atrajo, ",
  "ja515:10.3": "taṃ tvaṃ atthañ ca dhammañ ca ",
  "ja515:10.4": "gantvā pucchassu brāhmaṇāti. ",
  "ja515:11.1": "Sv-ādhippāgā Bhāradvājo ",
  "ja515:11.2": "Bhadrakārass' upantikaṃ, ",
  "ja515:11.3": "tam addasa mahābrahmā ",
  "ja515:11.4": "nisinnaṃ samhi vesmanīti. ",
  "ja515:12.1": "Rañño 'haṃ pahito dūto ",
  "ja515:12.2": "Koravyassa yasassino, ",
  "ja515:12.3": "‘atthaṃ dhammañ ca pucchesi' ",
  "ja515:12.4": "icc-abravi Yudhiṭṭhilo, ",
  "ja515:12.5": "taṃ tvaṃ atthañ ca dhammañ ca ",
  "ja515:12.6": "Bhadrakāra brāvīhi meti. ",
  "ja515:13.1": "Maṃsakācaṃ avahāya ",
  "ja515:13.2": "godhaṃ anupatām' ahaṃ, ",
  "ja515:13.3": "na te sakkomi akkhātuṃ ",
  "ja515:13.4": "atthaṃ dhammañ ca pucchito. ",
  "ja515:14.1": "Sañjayo nāma me bhātā ",
  "ja515:14.2": "kaniṭṭho me Sucīrata, ",
  "ja515:14.3": "taṃ tvaṃ atthañ ca dhammañ ca ",
  "ja515:14.4": "gantvā pucchassu brāhmaṇāti. ",
  "ja515:15.1": "Sv-adhippāgā Bhāradvājo ",
  "ja515:15.2": "Sañjayassa upantikaṃ, ",
  "ja515:15.3": "tam addassa mahābrāhmā ",
  "ja515:15.4": "nisinnaṃ sa [mhi] parīsati. ",
  "ja515:16.1": "Rañño 'haṃ pahito dūto ",
  "ja515:16.2": "Koravyassa yasassino, ",
  "ja515:16.3": "‘atthaṃ dhammañ ca pucchesi' ",
  "ja515:16.4": "icc-abravi Yudhiṭṭhilo. ",
  "ja515:16.5": "taṃ tvaṃ atthañ ca dhammañ ca Sañjay' ",
  "ja515:16.6": "akkhāhi pucchitoti. ",
  "ja515:17.1": "Sadā maṃ gilati maccu ",
  "ja515:17.2": "sāyaṃ pāto Sucīrata, ",
  "ja515:17.3": "na te sakkomi akkhātuṃ ",
  "ja515:17.4": "atthaṃ dhammañ ca pucchito. ",
  "ja515:18.1": "Sambhavo nāma me bhātā ",
  "ja515:18.2": "kaniṭṭho me Sucīrato. ",
  "ja515:18.3": "taṃ tvaṃ atthañ ca dhammañ ca ",
  "ja515:18.4": "gantvā pucchassu brāhmaṇāti. ",
  "ja515:19.1": "Abbhuto vata bho dhammo, ",
  "ja515:19.2": "nāyaṃ asmāka ruccati, ",
  "ja515:19.3": "tayo janā pitā puttā ",
  "ja515:19.4": "te su paññāya no vidu. ",
  "ja515:20.1": "Na taṃ sakkotha akkhātuṃ ",
  "ja515:20.2": "atthaṃ dhammañ ca pucchitā, ",
  "ja515:20.3": "kathan nu daharo jaññā ",
  "ja515:20.4": "atthaṃ dhammañ ca pucchitoti. ",
  "ja515:21.1": "Mā naṃ daharo [ti] uññāsi ",
  "ja515:21.2": "apucchitvāna Sambhavaṃ, ",
  "ja515:21.3": "pucchitvā Sambhavaṃ jaññā ",
  "ja515:21.4": "atthaṃ dhammañ ca brāhmaṇa. ",
  "ja515:22.1": "Yathāpi cando vimalo ",
  "ja515:22.2": "gacchaṃ ākāsadhātuyā ",
  "ja515:22.3": "sabbe tārāgaṇe loke ",
  "ja515:22.4": "ābhāya atirocati ",
  "ja515:23.1": "Evam pi dahar' ūpeto ",
  "ja515:23.2": "paññāyogena Sambhavo, ",
  "ja515:23.3": "mā naṃ daharo [ti] uññāsi ",
  "ja515:23.4": "apucchitvāna Sambhavaṃ, ",
  "ja515:23.5": "pucchitvā Sambhavaṃ jaññā ",
  "ja515:23.6": "athaṃ dhammañ ca brāhmaṇa. ",
  "ja515:24.1": "Yathāpi rammako māso ",
  "ja515:24.2": "gimhānaṃ hoti brāhmaṇa ",
  "ja515:24.3": "at' ev' aññehi māsehi ",
  "ja515:24.4": "dumapupphehi sobhati ",
  "ja515:25.1": "Evam pi dahar' ūpeto ",
  "ja515:25.2": "",
  "ja515:25.3": "",
  "ja515:25.4": "",
  "ja515:25.5": "",
  "ja515:25.6": "--pe--. ",
  "ja515:26.1": "Yathāpi himavā brahme ",
  "ja515:26.2": "pabbato Gandhamādano ",
  "ja515:26.3": "nānārukkhehi sañchanno ",
  "ja515:26.4": "mahābhūtagaṇālayo ",
  "ja515:26.5": "osadhehi ca dibbehi ",
  "ja515:26.6": "disā bhāti pavāti ca ",
  "ja515:27.1": "Evam pi dahar' ūpeto ",
  "ja515:27.2": "",
  "ja515:27.3": "",
  "ja515:27.4": "",
  "ja515:27.5": "",
  "ja515:27.6": "--pe--. || Ja_XVI:164 || ",
  "ja515:28.1": "Yathāpi pāvako brahme ",
  "ja515:28.2": "accimālī yasassimā ",
  "ja515:28.3": "jalamāno caraṃ kacchi ",
  "ja515:28.4": "analo kaṇhavattanī ",
  "ja515:29.1": "Ghatāsano dhumaketu ",
  "ja515:29.2": "uttamāhevanandaho ",
  "ja515:29.3": "nisīthe pabbataggasmiṃ ",
  "ja515:29.4": "pahūtedho virocati ",
  "ja515:30.1": "Evam pi dahar' ūpeto ",
  "ja515:30.2": "",
  "ja515:30.3": "",
  "ja515:30.4": "",
  "ja515:30.5": "",
  "ja515:30.6": "--pe--. ",
  "ja515:31.1": "Javena bhadraṃ jānanti ",
  "ja515:31.2": "balivaddañ ca vāhiye ",
  "ja515:31.3": "dohena dhenuṃ jānanti ",
  "ja515:31.4": "bhāsamānañ ca paṇḍitaṃ, ",
  "ja515:32.1": "Evam pi dahar' ūpeto ",
  "ja515:32.2": "paññāyogena Sambhavo, ",
  "ja515:32.3": "mā naṃ daharo [ti] uññāsi ",
  "ja515:32.4": "apucchitvāna Sambhavaṃ, ",
  "ja515:32.5": "pucchitvā Sambhavaṃ jaññā ",
  "ja515:32.6": "atthaṃ dhammañ ca brāhmaṇāti. ",
  "ja515:33.1": "Sv-ādhippāgā Bhāradvājo ",
  "ja515:33.2": "Sambhavassa upantikaṃ, ",
  "ja515:33.3": "tam addasa mahābrahmā ",
  "ja515:33.4": "kīḷamānaṃ bahī pureti g. ā. ",
  "ja515:34.1": "Rañño 'haṃ pahito dūto ",
  "ja515:34.2": "Koravyassa yasassino, ",
  "ja515:34.3": "‘atthaṃ dhammañ ca pucchassu' ",
  "ja515:34.4": "icc-abravi Yudhiṭṭhilo, ",
  "ja515:34.5": "taṃ tvaṃ atthañ ca dhammañ ca ",
  "ja515:34.6": "Sambhav' akkhāhi pucchitoti ",
  "ja515:35.1": "Taggha te aham akkhissaṃ ",
  "ja515:35.2": "yathāpi kusalo tathā,(=Sumaṅgala I 156,1) ",
  "ja515:35.3": "rājā ca kho naṃ jānāti ",
  "ja515:35.4": "yadi kāhati vā na vāti g. ā. ",
  "ja515:36.1": "Ajja suveti saṃseyya ",
  "ja515:36.2": "raññā puṭṭho Sucīrata ",
  "ja515:36.3": "mā katvā avasī rājā ",
  "ja515:36.4": "atthe jāte Yudhiṭṭhilo. ",
  "ja515:37.1": "Ajjhattaṃ ñeva saṃseyya ",
  "ja515:37.2": "raññā puṭṭho Sucīrata, ",
  "ja515:37.3": "kummaggaṃ na niveseyya ",
  "ja515:37.4": "yathā mūḷho acetaso. ",
  "ja515:38.1": "Attānaṃ nātivatteyya, ",
  "ja515:38.2": "adhammaṃ na samācare, ",
  "ja515:38.3": "atitthe na-ppātareyya, ",
  "ja515:38.4": "anatthe na yuto siyā. ",
  "ja515:39.1": "Yo ca etāni ṭhānāni ",
  "ja515:39.2": "kattuṃ jānāti khattiyo ",
  "ja515:39.3": "sadā so vaḍḍhate rājā ",
  "ja515:39.4": "sukkapakkhe va candimā. ",
  "ja515:40.1": "Ñatīnañ ca piyo hoti ",
  "ja515:40.2": "mittesu ca virocati, ",
  "ja515:40.3": "kāyassa bhedā sappañño ",
  "ja515:40.4": "saggaṃ so upapajjātīti āha. Bārāṇassaṃ ",
  "ja515:41.1": ""
}
