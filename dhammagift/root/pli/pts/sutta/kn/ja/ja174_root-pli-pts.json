  "ja174:1.1": "Adamha te vāri bahūtarūpaṃ ",
  "ja174:1.2": "ghammābhitattassa pipāsitassa, ",
  "ja174:1.3": "so dāni pītvāna kikiṃ karosi. ",
  "ja174:1.4": "asaṃgamo pāpajanena seyyoti. ",
  "ja174:2.1": "Ko te suto vā diṭṭho vā ",
  "ja174:2.2": "sīlavā nāma makkaṭo, ",
  "ja174:2.3": "idāni kho taṃ ūhacca, ",
  "ja174:2.4": "esā amhāka dhammatāti. ",
  "ja174:3.1": ""
}
