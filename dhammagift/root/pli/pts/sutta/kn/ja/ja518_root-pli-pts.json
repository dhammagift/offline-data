{
  "ja518:0.1": "",
  "ja518:0.2": "",
  "ja518:0.3": "",
  "ja518:0.4": "",
  "ja518:1.1": "Vikiṇṇavācaṃ anigūḷhamantaṃ ",
  "ja518:1.2": "asaññataṃ aparicakkhitāraṃ ",
  "ja518:1.3": "bhayaṃ tam anveti sayaṃ abodhaṃ ",
  "ja518:1.4": "nāgaṃ yathā Paṇḍarakaṃ supaṇṇo. ",
  "ja518:2.1": "Yo guyhamantaṃ parirakkhaneyyaṃ ",
  "ja518:2.2": "mohā naro saṃsati bhāsamāno ",
  "ja518:2.3": "taṃ bhinnamantaṃ bhayam anveti khippaṃ ",
  "ja518:2.4": "nāgaṃ yathā Paṇḍarakaṃ supaṇṇo. ",
  "ja518:3.1": "Nānumitto garuṃ atthaṃ ",
  "ja518:3.2": "guyhaṃ vedetum arahati ",
  "ja518:3.3": "sumitto ca asambuddhaṃ ",
  "ja518:3.4": "sambuddhaṃ vā anatthavā. ",
  "ja518:4.1": "Vissāsam āpajjim ahaṃ: acelo ",
  "ja518:4.2": "samaṇo ayaṃ sammato bhāvitatto, ",
  "ja518:4.3": "tassāham akkhiṃ vivariṃ guyhaṃ atthaṃ, ",
  "ja518:4.4": "ātītamattho kapaṇo rudāmi. ",
  "ja518:5.1": "Tassāhaṃ paramaṃ brahme guyhaṃ ",
  "ja518:5.2": "vācaṃ h' imaṃ nāsakkhi saṃyametuṃ, ",
  "ja518:5.3": "tappakkhato hi bhayam āgataṃ mama, ",
  "ja518:5.4": "atītamattho kapaṇo rudāmi, ",
  "ja518:6.1": "Yo ve naro suhadaṃ maññamāno ",
  "ja518:6.2": "guyhaṃ atthaṃ saṃsati dukkulīne ",
  "ja518:6.3": "dosā bhayā athavā rāgaratto ",
  "ja518:6.4": "pallittho bālo asaṃsayaṃ so. ",
  "ja518:7.1": "Tirokkhavāco asataṃ paviṭṭho ",
  "ja518:7.2": "yo saṃgatīsu-m-udīreti vākyaṃ ",
  "ja518:7.3": "āsīviso dummukho ty-āhu taṃ naraṃ, ",
  "ja518:7.4": "ārā arā saṃyame tādisamhā. ",
  "ja518:8.1": "Annaṃ pānaṃ kāsikaṃ candanañ ca ",
  "ja518:8.2": "manāpiṭṭhiyo mālamucchādanañ ca ",
  "ja518:8.3": "ohāya gacchāmase sabbakāme, ",
  "ja518:8.4": "supaṇṇa pāṇupagatā va ty-amhāti. ",
  "ja518:9.1": "Ko n' idha tiṇṇaṃ garahaṃ upeti ",
  "ja518:9.2": "asmin dha loke pāṇabhū nāgarāja: ",
  "ja518:9.3": "samaṇo supaṇṇo athavā tav' eva, ",
  "ja518:9.4": "kiṃkāraṇā Paṇḍaraka-ggahītoti gātham āha. ",
  "ja518:10.1": "Samaṇoti me sammatatto ahosi ",
  "ja518:10.2": "piyo ca me manasā bhāvitatto, ",
  "ja518:10.3": "",
  "ja518:10.4": "",
  "ja518:11.1": "Na c' atthi satto amaro pathavyā, ",
  "ja518:11.2": "paññāvidhā n' atthi na ninditabbā, ",
  "ja518:11.3": "saccena dhammena dhiyā damena ",
  "ja518:11.4": "alabbham avyāharatī naro idha. ",
  "ja518:12.1": "Mātāpitā paramā bandhavānaṃ, ",
  "ja518:12.2": "nāssa tatiyo anukampak' atthi, ",
  "ja518:12.3": "tesam pi guyhaṃ paramaṃ na saṃse ",
  "ja518:12.4": "mantassa bhedaṃ parisaṃkamāno. ",
  "ja518:13.1": "Mātāpitā bhaginī bhātaro ca ",
  "ja518:13.2": "sabhāya vā yassa hontī sapakkhā ",
  "ja518:13.3": "tesam pi guyhaṃ paramaṃ na saṃse ",
  "ja518:13.4": "mantassa bhedaṃ parisaṃkamāno. ",
  "ja518:14.1": "Bhariyā ce purisaṃ vajjā ",
  "ja518:14.2": "komārī piyabhāṇinī ",
  "ja518:14.3": "puttarūpayasūpetā ",
  "ja518:14.4": "ñātisaṃghapurakkhatā ",
  "ja518:14.5": "tassāpi guyhaṃ paramaṃ na saṃse ",
  "ja518:14.6": "mantassa bhedaṃ parisaṃkamānoti. ",
  "ja518:15.1": "Na guyham atthaṃ vivareyya ",
  "ja518:15.2": "rakkheyya naṃ yathā nidhiṃ, ",
  "ja518:15.3": "na hi pātukato sādhu ",
  "ja518:15.4": "guyho attho pajānatā. ",
  "ja518:16.1": "Thiyā guyhaṃ na saṃseyya ",
  "ja518:16.2": "amittassa ca paṇḍito ",
  "ja518:16.3": "yo cāmisena saṃhīro ",
  "ja518:16.4": "hadayatthe no ca yo naro. ",
  "ja518:17.1": "Guyham attham asambuddhaṃ ",
  "ja518:17.2": "sambodhayati yo naro ",
  "ja518:17.3": "mantabhedabhayā tassa ",
  "ja518:17.4": "dāsabhūto tikkhati. ",
  "ja518:18.1": "Yāvanto purisass' atthaṃ ",
  "ja518:18.2": "guyhaṃ jānanti mantinaṃ ",
  "ja518:18.3": "tāvanto tassa ubbegā, ",
  "ja518:18.4": "tasmā guyhaṃ na vissaje. ",
  "ja518:19.1": "Vivicca bhāseyya divā rahassaṃ, ",
  "ja518:19.2": "rattiṃ giraṃ nātivelaṃ pamuñce, ",
  "ja518:19.3": "upassutikā hi suṇanti mantaṃ, ",
  "ja518:19.4": "tasmā manto khippam upeti bhedanti ",
  "ja518:20.1": "Yathāpi assa nagaraṃ mahantaṃ ",
  "ja518:20.2": "āḷārakaṃ āyasaṃ Bhaddasālaṃ ",
  "ja518:20.3": "",
  "ja518:20.4": "",
  "ja518:21.1": "Ye guyhamantā avikiṇṇavācā ",
  "ja518:21.2": "deḷhā sadatthesu narā dujivhā ",
  "ja518:21.3": "ārā amittā vyavajanti tehi ",
  "ja518:21.4": "āsīvisā vā-r-iva sattusaṃghāti dvīsu gāthāsu. ",
  "ja518:22.1": "Hitvā gharaṃ pabbajito acelo ",
  "ja518:22.2": "naggo muṇḍo carati ghāsahetu, ",
  "ja518:22.3": "tamhī nu kho vivariṃ guyham atthaṃ, ",
  "ja518:22.4": "atthā ca dhammā ca avāgat' amhā. ",
  "ja518:23.1": "Kathaṃkaro cā hi supaṇṇarāja ",
  "ja518:23.2": "kiṃsīlo kena vatena vattaṃ ",
  "ja518:23.3": "samaṇo caraṃ hitvā mamāyitāni ",
  "ja518:23.4": "kathaṃkaro saggam upeti ṭhānanti āha. ",
  "ja518:24.1": "Hiriyā titikkhāya damena khantiyā ",
  "ja518:24.2": "akkodhano pesuṇiyaṃ pahāya ",
  "ja518:24.3": "samaṇo caraṃ hitvā mamāyitāni ",
  "ja518:24.4": "evaṃkaro saggam upeti ṭhānanti. ",
  "ja518:25.1": "Mātā va puttaṃ taruṇaṃ tanujjaṃ ",
  "ja518:25.2": "sampassa taṃ sabbagattaṃ phareti ",
  "ja518:25.3": "evam pi me tvaṃ pātur ahu dijinda ",
  "ja518:25.4": "mātā va puttaṃ anukampamānoti gātham āha. ",
  "ja518:26.1": "Hand' ajja tvaṃ muñca vadhā dujivha ",
  "ja518:26.2": "tayo hi puttā na hi añño atthi: ",
  "ja518:26.3": "",
  "ja518:26.4": "",
  "ja518:27.1": "Icc-eva vākyaṃ visajī supaṇṇo ",
  "ja518:27.2": "bhumyā patiṭṭhāya dijo dujivhaṃ: ",
  "ja518:27.3": "mutt' ajja tvaṃ sabbabhayātivatto ",
  "ja518:27.4": "thalūdake bohi mayābhigutto. ",
  "ja518:28.1": "Ātaṃkinaṃ yathā kusalo bhisakko ",
  "ja518:28.2": "pipāsitānaṃ [udaka] rahado va sīto ",
  "ja518:28.3": "vesmaṃ yathā himasisiraṭṭitānaṃ ",
  "ja518:28.4": "evam pi te saraṇam ahaṃ bhavāmīti. ",
  "ja518:29.1": "Sandhiṃ katvā amittena ",
  "ja518:29.2": "aṇḍajena jalābuja (= II 53|15) ",
  "ja518:29.3": "vivariya dāṭhaṃ sayasi, ",
  "ja518:29.4": "kuto taṃ bhayaṃ āgatanti. ",
  "ja518:30.1": "Saṃketh eva amittasmiṃ, ",
  "ja518:30.2": "mittasmim pi na vissase, (II 53|22) ",
  "ja518:30.3": "abhayā bhayam uppannaṃ ",
  "ja518:30.4": "api mūlāni kantati. ",
  "ja518:31.1": "Kathan nu vissase tyamhi ",
  "ja518:31.2": "yenāsi kalaho kato, ",
  "ja518:31.3": "niccayattena ṭhātabbaṃ, ",
  "ja518:31.4": "so disamhi na rajjati ",
  "ja518:32.1": "Vissāsaye na ca naṃ vissaseyya, ",
  "ja518:32.2": "asaṃkito ca saṃkito bhaveyya, ",
  "ja518:32.3": "tathā tathā viññū parakkameyya ",
  "ja518:32.4": "yathā yathā bhāvaṃ paro na jaññāti. ",
  "ja518:33.1": "Te devavaṇṇī sukhumālarūpā ",
  "ja518:33.2": "ubho samā sujayo ",
  "ja518:33.3": "puññagandhā ",
  "ja518:33.4": "",
  "ja518:34.1": "Tato have Paṇḍarako acelaṃ ",
  "ja518:34.2": "sayam [evaṃ] upāgamma idaṃ avoca: ",
  "ja518:34.3": "mutt' ajj' ahaṃ sabbabhayātivatto, ",
  "ja518:34.4": "na ha nūna tuyhaṃ manaso piy' amhāti. ",
  "ja518:35.1": "Piyo hi me āsi supaṇṇarājā ",
  "ja518:35.2": "asaṃsayaṃ Paṇḍarakena saccaṃ, ",
  "ja518:35.3": "so rāgaratto va akāsim etaṃ pāpaṃ ",
  "ja518:35.4": "kammaṃ sampajāno na mohāti. ",
  "ja518:36.1": "Na me piyaṃ appiyaṃ vāpi hoti ",
  "ja518:36.2": "sampassato lokam imaṃ parañ ca, (IV 127|17) susaññatānaṃ ",
  "ja518:36.3": "hi viyañjanena ",
  "ja518:36.4": "asaññato lokam imaṃ carāsi. ",
  "ja518:37.1": "Ariyāvakāso si anariyo cāsi ",
  "ja518:37.2": "asaññato saññatasannikāso, ",
  "ja518:37.3": "kaṇhābhijātiko si anariyarūpo, ",
  "ja518:37.4": "pāpaṃ bahuṃ duccaritaṃ acārīti. ",
  "ja518:38.1": "Aduṭṭhassa tuvaṃ dūbhi ",
  "ja518:38.2": "dūbhī ca pisuṇo c' asi, ",
  "ja518:38.3": "etena saccavajjena ",
  "ja518:38.4": "muddhā [te] phalatu sattadhāti. ",
  "ja518:39.1": "Tasmā hi mittānaṃ na dubbhitabbaṃ. ",
  "ja518:39.2": "mittaddubhā pāpiyo n' atthi añño, ",
  "ja518:39.3": "āsittasatto nihato pathavyā, ",
  "ja518:39.4": "Indassa vākyena hi Saṃvaro hatoti. ",
  "ja518:40.1": ""
}
