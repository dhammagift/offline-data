{
  "ja443:0.1": "",
  "ja443:0.2": "",
  "ja443:0.3": "",
  "ja443:0.4": "",
  "ja443:1.1": "Yo te imaṃ visālakkhiṃ ",
  "ja443:1.2": "piyaṃ sammillabhāsiniṃ ",
  "ja443:1.3": "ādāya balā gaccheyya ",
  "ja443:1.4": "kin nu kayirāsi brāhmaṇāti. ",
  "ja443:2.1": "Uppajja me na mucceyya ",
  "ja443:2.2": "na me mucceyya jīvato ",
  "ja443:2.3": "rajaṃ va vipulā vuṭṭhi ",
  "ja443:2.4": "khippam eva nivārayeti. ",
  "ja443:3.1": "Yan nu pubbe vikatthittho ",
  "ja443:3.2": "balamhi va apassito ",
  "ja443:3.3": "sv-ājja tuṇhikkhako dāni ",
  "ja443:3.4": "saṃghāṭiṃ sibbam acchasīti. ",
  "ja443:4.1": "Uppajji me, na muccittha, ",
  "ja443:4.2": "na me mucceyya jīvato, ",
  "ja443:4.3": "rajaṃ va vipulā vuṭṭhi ",
  "ja443:4.4": "khippaṃ eva nivārayinti. ",
  "ja443:5.1": "Kin te uppajji no mucci, ",
  "ja443:5.2": "kin te no mucci jīvato, ",
  "ja443:5.3": "rajaṃ va vipulā vuṭṭhi ",
  "ja443:5.4": "katamaṃ tvaṃ nivārayīti. ",
  "ja443:6.1": "Yamhi jāte na passati ",
  "ja443:6.2": "ajāte sādhu passati ",
  "ja443:6.3": "so me uppajji no mucci ",
  "ja443:6.4": "kodho dummedhagocaro. ",
  "ja443:7.1": "Yena jātena nandanti ",
  "ja443:7.2": "amittā dukkhamesino ",
  "ja443:7.3": "so me uppajji no mucci ",
  "ja443:7.4": "kodho dummedhagocaro. ",
  "ja443:8.1": "Yasmiñ ca jāyamānasmiṃ ",
  "ja443:8.2": "sadatthaṃ nāvabujjhati ",
  "ja443:8.3": "so me uppajji no mucci ",
  "ja443:8.4": "kodho dummedhagocaro. ",
  "ja443:9.1": "Yenābhibhūto kusalaṃ jahāti ",
  "ja443:9.2": "parakkare vipulañ cāpi atthaṃ ",
  "ja443:9.3": "sa bhīmaseno balavā pamaddī ",
  "ja443:9.4": "kodho mahārāja na me amuccatha. ",
  "ja443:10.1": "Kaṭṭhasmiṃ manthamānasmiṃ ",
  "ja443:10.2": "pāvako nāma jāyati, ",
  "ja443:10.3": "tam eva kaṭṭhaṃ ḍahati ",
  "ja443:10.4": "yasmā so jāyate gini. ",
  "ja443:11.1": "Evaṃ mandassa posassa ",
  "ja443:11.2": "bālassa-m-avijānato ",
  "ja443:11.3": "sārambhā jāyate kodho, ",
  "ja443:11.4": "so pi ten' eva ḍayhati. [S. P. p. 299.) ",
  "ja443:12.1": "Aggīva tiṇakaṭṭhasmiṃ ",
  "ja443:12.2": "kodho yassa pavaḍḍhati (Grimblot, 7) ",
  "ja443:12.3": "nihīyati tassa yaso ",
  "ja443:12.4": "kāḷapakkhe va candimā. ",
  "ja443:13.1": "Anedho dhūmaketu va ",
  "ja443:13.2": "kodho yass' upassammati ",
  "ja443:13.3": "āpūrati tassa yaso ",
  "ja443:13.4": "sukkapakkhe va candimāti ",
  "ja443:14.1": ""
}
