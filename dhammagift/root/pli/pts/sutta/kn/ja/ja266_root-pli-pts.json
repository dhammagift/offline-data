  "ja266:1.1": "Yenāsi kisiyā paṇḍu ",
  "ja266:1.2": "yena bhattaṃ na ruccati ",
  "ja266:1.3": "ayaṃ so āgato tāto, ",
  "ja266:1.4": "kasmā dāni palāyasīti. ",
  "ja266:2.1": "Sace panādiken' eva ",
  "ja266:2.2": "santhavo nāma jāyati ",
  "ja266:2.3": "yaso hāyati itthīnaṃ, ",
  "ja266:2.4": "tasmā tāta palāy' ahanti. ",
  "ja266:3.1": "Yasassinaṃ kule jātaṃ ",
  "ja266:3.2": "āgataṃ yā na icchati ",
  "ja266:3.3": "socati cirarattāya ",
  "ja266:3.4": "Vātaggam iva Kundalīti . ",
  "ja266:4.1": ""
}
