  "ja465:0.4": "",
  "ja465:1.1": "Kā tvaṃ uddhehi vatthehi ",
  "ja465:1.2": "aghe vehāsayaṇ ṭhitā, ",
  "ja465:1.3": "kena ty-assūni vattanti ",
  "ja465:1.4": "kuto taṃ bhayam āgatanti. ",
  "ja465:2.1": "Tav' eva deva vijite ",
  "ja465:2.2": "Bhaddasāloti maṃ vidū ",
  "ja465:2.3": "saṭṭhiṃ vassasahassāni ",
  "ja465:2.4": "tiṭṭhato pūjitassa me ",
  "ja465:3.1": "Kārayantā nagarāni ",
  "ja465:3.2": "agāre ca disampati ",
  "ja465:3.3": "vividhe cāpi pāsāde ",
  "ja465:3.4": "na man te accamaññisuṃ, ",
  "ja465:3.5": "yath' eva man te pūjesuṃ ",
  "ja465:3.6": "tath' eva tvam pi pūjayāti. Tañ ",
  "ja465:4.1": "ca ahaṃ na passāmi ",
  "ja465:4.2": "thullam kāyena te dumaṃ, ",
  "ja465:4.3": "ārohapariṇāhena ",
  "ja465:4.4": "abhirūpo si jātiyā. ",
  "ja465:5.1": "Pāsādaṃ kārayissāmi ",
  "ja465:5.2": "ekatthambhaṃ manoramaṃ, ",
  "ja465:5.3": "tattha taṃ upanessāmi, ",
  "ja465:5.4": "ciran te yakkha jīvitanti. ",
  "ja465:6.1": "Evaṃ h' etaṃ udapādi ",
  "ja465:6.2": "sarīrena vinābhāvo ",
  "ja465:6.3": "puthuso maṃ vikantetvā ",
  "ja465:6.4": "khaṇḍaso avakantatha. ",
  "ja465:7.1": "Agge ca chetvā majjhe ca ",
  "ja465:7.2": "pacchā mūlaṃ vichindatha, ",
  "ja465:7.3": "evaṃ me chijjamānassa ",
  "ja465:7.4": "na dukkhaṃ maraṇaṃ siyāti. ",
  "ja465:8.1": "Hatthapādaṃ yathā chinde ",
  "ja465:8.2": "kaṇṇanāsañ ca jīvite ",
  "ja465:8.3": "tato pacchā siro chinde, ",
  "ja465:8.4": "taṃ dukkhaṃ maraṇaṃ siyā. ",
  "ja465:9.1": "Sukhaṃ nu khaṇḍaso chinnam ",
  "ja465:9.2": "bhaddasāla vanaspati, ",
  "ja465:9.3": "kiṃ hetu kaṃ upādāya ",
  "ja465:9.4": "khaṇḍaso chinnam icchasīti. ",
  "ja465:10.1": "Yañ ca hetuṃ upādāya ",
  "ja465:10.2": "hetuṃ dhammūpasaṃhitaṃ ",
  "ja465:10.3": "khaṇḍaso chinnam icchāmi ",
  "ja465:10.4": "mahārāja suṇohi me: ",
  "ja465:11.1": "Nāti me sukhasaṃvaddhā ",
  "ja465:11.2": "mama passe nivātajā ",
  "ja465:11.3": "te pi 'haṃ upahiṃseyyaṃ, ",
  "ja465:11.4": "paresaṃ assa dumocitanti. ",
  "ja465:12.1": "Cetabbarūpaṃ cetasi ",
  "ja465:12.2": "bhaddasāla vanaspati, hitakāmo ",
  "ja465:12.3": "so ñātīnaṃ, ",
  "ja465:12.4": "abhayaṃ samma dadāmi teti. ",
  "ja465:13.1": ""
}
