  "ja353:0.3": "",
  "ja353:0.4": "",
  "ja353:1.1": "Na-y-idaṃ niccaṃ bhavitabbaṃ Brahmadatta ",
  "ja353:1.2": "khemaṃ subhikkhaṃ suhatā va kāye, ",
  "ja353:1.3": "atthaccaye mā hu sammūḷho ",
  "ja353:1.4": "bhinnaplavo sāgarasseva majjhe. ",
  "ja353:2.1": "Yāni karoti puriso ",
  "ja353:2.2": "tāni attani passati (Cfrṣupra vol.II p.202.) ",
  "ja353:2.3": "kalyāṇakāri kalyāṇaṃ ",
  "ja353:2.4": "pāpakāri ca pāpakaṃ, ",
  "ja353:2.5": "yādisaṃ vapate bījaṃ ",
  "ja353:2.6": "tādisaṃ harate phalanti. ",
  "ja353:3.1": "Idaṃ tad ācariyavaco ",
  "ja353:3.2": "Pārāsariyo yad abravi: (Cfrṣupra vol.II. ",
  "ja353:3.3": "p.202.) māssu tvaṃ akarā pāpaṃ ",
  "ja353:3.4": "yaṃ taṃ pacchā kataṃ tape. ",
  "ja353:4.1": "Ayam eva so Piṅgiya dhonasākho ",
  "ja353:4.2": "yahiṃ ghātayiṃ khattiyānaṃ sahassaṃ ",
  "ja353:4.3": "alaṃkate candanasāralitte, ",
  "ja353:4.4": "tam eva dukkhaṃ paccāgataṃ mamāti. ",
  "ja353:5.1": "Sāmā ca kho candanalittagattī ",
  "ja353:5.2": "laṭṭhīva sobhañjanakassa uggatā, ",
  "ja353:5.3": "adisvā kālaṃ karissāmi Ubbariṃ, ",
  "ja353:5.4": "taṃ me tato dukkhataraṃ bhavissatīti ",
  "ja353:6.1": ""
}
