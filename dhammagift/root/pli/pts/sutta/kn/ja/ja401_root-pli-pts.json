  "ja401:0.4": "",
  "ja401:1.1": "tikhiṇadhāraṃ ",
  "ja401:1.2": "asiṃ sampanna pāyinaṃ ",
  "ja401:1.3": "parisāyaṃ puriso gilati ",
  "ja401:1.4": "kiṃ dukkarataraṃ tato, ",
  "ja401:1.5": "yad aññaṃ dukkaraṃ ṭhānaṃ ",
  "ja401:1.6": "tam me akkhāhi pucchitoti. ",
  "ja401:2.1": "Gileyya puriso lobhā ",
  "ja401:2.2": "asiṃ sampanna pāyinaṃ, ",
  "ja401:2.3": "yo ca vajjā dadāmīti ",
  "ja401:2.4": "taṃ dukkarataram tato, ",
  "ja401:2.5": "sabb' aññaṃ sukaraṃ ṭhānaṃ, ",
  "ja401:2.6": "evaṃ jānāhi Māgadhāti. ",
  "ja401:3.1": "Vyākāsi Āyuro pañhaṃ ",
  "ja401:3.2": "atthadhammassa kovido, ",
  "ja401:3.3": "Pukkusaṃ dāni pucchāmi: ",
  "ja401:3.4": "kiṃ dukkarataraṃ tato, ",
  "ja401:3.5": "yad aññaṃ dukkaraṃ ṭhānaṃ ",
  "ja401:3.6": "tam me akkhāhi pucchitoti. ",
  "ja401:4.1": "Na vācam upajīvanti ",
  "ja401:4.2": "aphalaṃ giram udīritaṃ, ",
  "ja401:4.3": "yo ca datvā avākayirā ",
  "ja401:4.4": "taṃ dukkarataraṃ tato, ",
  "ja401:4.5": "sabb' aññaṃ sukaraṃ ṭhānaṃ, ",
  "ja401:4.6": "evaṃ jānāhi Māgadhāti. ",
  "ja401:5.1": "Vyākāsi Pukkuso pañhaṃ ",
  "ja401:5.2": "atthadhammassa kovido, ",
  "ja401:5.3": "Senakaṃ dāni pucchāmi: ",
  "ja401:5.4": "kiṃ dukkarataraṃ tato, ",
  "ja401:5.5": "yad aññaṃ dukkaraṃ ṭhānam ",
  "ja401:5.6": "tam me akkhāhi pucchitoti. ",
  "ja401:6.1": "Dadeyya puriso dānaṃ ",
  "ja401:6.2": "appaṃ vā yadivā bahuṃ, ",
  "ja401:6.3": "yo ca datvā nānutape ",
  "ja401:6.4": "taṃ dukkarataraṃ tato, ",
  "ja401:6.5": "sabb' aññam sukaraṃ ṭhānaṃ, ",
  "ja401:6.6": "evaṃ jānāhi Māgadhāti. ",
  "ja401:7.1": "Vyākāsi Āyuro pañhaṃ ",
  "ja401:7.2": "atha Pukkusa-poriso, ",
  "ja401:7.3": "sabbe pañhe atihoti ",
  "ja401:7.4": "yathā bhāsati Senakoti. ",
  "ja401:8.1": ""
}
