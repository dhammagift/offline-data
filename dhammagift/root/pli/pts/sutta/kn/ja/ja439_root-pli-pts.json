  "ja439:1.1": "nagaraṃ ",
  "ja439:1.2": "āyasaṃ daḷhapākāraṃ, ",
  "ja439:1.3": "oruddhapatiruddho 'smi ",
  "ja439:1.4": "kiṃ pāpaṃ pakatam mayā. ",
  "ja439:2.1": "Sabbe apihitā dvārā, ",
  "ja439:2.2": "oruddho 'smi yathā dvijo, ",
  "ja439:2.3": "kimādhikaraṇaṃ yakkha ",
  "ja439:2.4": "cakkābhinihato ahanti. ",
  "ja439:3.1": "Laddhā satasahassāni ",
  "ja439:3.2": "atirekāni vīsati ",
  "ja439:3.3": "anukampakānaṃ ñātīnaṃ ",
  "ja439:3.4": "vacanaṃ samma nākari. ",
  "ja439:4.1": "Laṃghī samuddaṃ pakkhandi ",
  "ja439:4.2": "sāgaraṃ appasiddhikaṃ, ",
  "ja439:4.3": "catūhi aṭṭh' ajjhagamā ",
  "ja439:4.4": "aṭṭhāhi pi ca soḷasa (=III p. 207.) ",
  "ja439:5.1": "Soḷasāhi ca battiṃsa, ",
  "ja439:5.2": "atriccho cakkam āsado, ",
  "ja439:5.3": "icchāhatassa posassa ",
  "ja439:5.4": "cakkaṃ bhamati matthake. ",
  "ja439:6.1": "Uparivisālaṃ duppūraṃ ",
  "ja439:6.2": "icchāvisaṭagāminiṃ ",
  "ja439:6.3": "ye va taṃ anugijjhanti ",
  "ja439:6.4": "te honti cakkadhārino. ",
  "ja439:7.1": "Bahuṃ bhaṇḍaṃ apahāya ",
  "ja439:7.2": "maggaṃ appaṭivekkhiya ",
  "ja439:7.3": "yesaṃ c' etaṃ asaṃkhātaṃ ",
  "ja439:7.4": "te honti cakkadhārino. ",
  "ja439:8.1": "Kammaṃ samekkhe vipulañ ca bhogaṃ, ",
  "ja439:8.2": "icchaṃ na seveyya anatthasaṃhitaṃ, ",
  "ja439:8.3": "kareyya vākyaṃ anukampakānaṃ, ",
  "ja439:8.4": "taṃ tādisaṃ nātivatteyya cakkanti. ",
  "ja439:9.1": "Kīva ciraṃ nu me yakkha ",
  "ja439:9.2": "cakkaṃ sirasi ṭhassati, ",
  "ja439:9.3": "kati vassasahassāni, ",
  "ja439:9.4": "tam me akkhāhi pucchitoti. ",
  "ja439:10.1": "Atisaro accasaro ",
  "ja439:10.2": "Mittavinda, suṇohi me: ",
  "ja439:10.3": "cakkaṃ te sirasi-m- āviddhaṃ, ",
  "ja439:10.4": "na taṃ jīvaṃ pamokkhasīti. ",
  "ja439:11.1": ""
}
