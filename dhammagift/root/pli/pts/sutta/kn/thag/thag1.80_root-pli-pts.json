{
  "thag1.80:0.1": "",
  "thag1.80:0.2": "",
  "thag1.80:0.3": "",
  "thag1.80:0.4": "",
  "thag1.80:1.1": "Yaṃ mayā pakataṃ kammaṃ ",
  "thag1.80:1.2": "appaṃ vā yadi vā bahu ",
  "thag1.80:1.3": "sabbam etaṃ parikkhīṇaṃ, ",
  "thag1.80:1.4": "n' atthi dāni punabbhavo 'ti. ",
  "thag1.80:1.5": "",
  "thag1.80:1.6": "",
  "thag1.80:2.0": "",
  "thag1.80:2.1": "Vacchapālo ca yo thero ",
  "thag1.80:2.2": "Ātumo Māṇavo isi ",
  "thag1.80:2.3": "Suyāmano Susārado ",
  "thag1.80:2.4": "thero yo ca Piyañjaho ",
  "thag1.80:2.5": "Ārohaputto Meṇḍasiro ",
  "thag1.80:2.6": "Rakkhito Uggasavhayo 'ti. "
}
