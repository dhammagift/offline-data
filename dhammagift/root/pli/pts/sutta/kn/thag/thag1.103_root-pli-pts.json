  "thag1.103:1.1": "Nāhaṃ etena atthiko ",
  "thag1.103:1.2": "sukhito dhammarasena tappito, ",
  "thag1.103:1.3": "pītvāna rasaggam uttamaṃ ",
  "thag1.103:1.4": "na ca kāhāmi visena santhavan ",
  "thag1.103:1.5": "ti. "
}
