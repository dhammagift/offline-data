{
  "thag16.10:0.1": "",
  "thag16.10:0.2": "",
  "thag16.10:0.3": "",
  "thag16.10:0.4": "",
  "thag16.10:1.1": "Samaṇassa ahū cintā ",
  "thag16.10:1.2": "pupphitamhi mahāvane ",
  "thag16.10:1.3": "ekaggassa nisinnassa ",
  "thag16.10:1.4": "pavivittassa jhāyino: ",
  "thag16.10:2.1": "aññathā lokanāthamhi ",
  "thag16.10:2.2": "tiṭṭhante purisuttame ",
  "thag16.10:2.3": "iriyaṃ āsi bhikkhūnaṃ, ",
  "thag16.10:2.4": "aññathā dāni dissate. ",
  "thag16.10:3.1": "sītavātaparittānaṃ, ",
  "thag16.10:3.2": "hirikopīnachādanaṃ, ",
  "thag16.10:3.3": "mattaṭṭhiyaṃ abhuñjiṃsu ",
  "thag16.10:3.4": "santuṭṭhā itarītare. ",
  "thag16.10:4.1": "paṇītaṃ yadi vā lūkhaṃ ",
  "thag16.10:4.2": "appaṃ vā yadi vā bahuṃ ",
  "thag16.10:4.3": "yāpanatthaṃ abhuñjiṃsu ",
  "thag16.10:4.4": "agiddhā nādhimucchitā. ",
  "thag16.10:5.1": "jīvitānaṃ parikkhāre ",
  "thag16.10:5.2": "bhesajje atha paccaye ",
  "thag16.10:5.3": "na bāḷhaṃ ussukā āsuṃ ",
  "thag16.10:5.4": "yathā te āsavakkhaye. ",
  "thag16.10:6.1": "araññe rukkhamūlesu ",
  "thag16.10:6.2": "kandarāsu guhāsu ca ",
  "thag16.10:6.3": "vivekaṃ anubrūhantā ",
  "thag16.10:6.4": "vihiṃsu tapparāyanā, ",
  "thag16.10:7.1": "nīcaniviṭṭhā subharā ",
  "thag16.10:7.2": "mudū atthaddhamānasā ",
  "thag16.10:7.3": "abyāsekā amukharā ",
  "thag16.10:7.4": "atthacintāvasānugā. ",
  "thag16.10:8.1": "tato pāsādikaṃ āsi ",
  "thag16.10:8.2": "gataṃ bhuttaṃ nisevitaṃ, ",
  "thag16.10:8.3": "siniddhā teladhārā va ",
  "thag16.10:8.4": "ahosi iriyāpatho. ",
  "thag16.10:9.1": "sabbāsavaparikkhīṇā ",
  "thag16.10:9.2": "mahājhāyī mahāhitā ",
  "thag16.10:9.3": "nibbutā dāni te therā, ",
  "thag16.10:9.4": "parittā dāni tādisā. ",
  "thag16.10:10.1": "kusalānañ ca dhammānaṃ ",
  "thag16.10:10.2": "paññāya ca parikkhayā ",
  "thag16.10:10.3": "sabbākāravarūpetaṃ ",
  "thag16.10:10.4": "lujjate jinasāsanaṃ. ",
  "thag16.10:11.1": "pāpakānañ ca dhammānaṃ ",
  "thag16.10:11.2": "kilesānañ ca yo utu ",
  "thag16.10:11.3": "upaṭṭhitāvivekāya ",
  "thag16.10:11.4": "ye ca saddhammasesakā ",
  "thag16.10:12.1": "te kilesā pavaḍḍhantā ",
  "thag16.10:12.2": "āvisanti bahuṃ janaṃ, ",
  "thag16.10:12.3": "kīḷanti maññe bālehi ",
  "thag16.10:12.4": "ummattehi va rakkhasā. ",
  "thag16.10:13.1": "kileseh' ābhibhūtā te ",
  "thag16.10:13.2": "tena tena vidhāvitā ",
  "thag16.10:13.3": "narā kilesavatthūsu ",
  "thag16.10:13.4": "sayaṃgāhe va ghosite, ",
  "thag16.10:14.1": "pariccajitvā saddhammaṃ ",
  "thag16.10:14.2": "aññamaññehi bhaṇḍare, ",
  "thag16.10:14.3": "diṭṭhigatāni anventā ",
  "thag16.10:14.4": "idaṃ seyyo 'ti maññare. ",
  "thag16.10:15.1": "dhanañ ca puttaṃ bhariyañ ca ",
  "thag16.10:15.2": "chaḍḍayitvāna niggatā ",
  "thag16.10:15.3": "kaṭacchubhikkhahetū pi ",
  "thag16.10:15.4": "akiccāni nisevare. ",
  "thag16.10:16.1": "udarāvadehakaṃ bhutvā ",
  "thag16.10:16.2": "sayant' uttānaseyyakā, ",
  "thag16.10:16.3": "kathā vadenti paṭibuddhā ",
  "thag16.10:16.4": "yā kathā satthu garahitā. ",
  "thag16.10:17.1": "sabbakārukasippāni ",
  "thag16.10:17.2": "cittikatvāna sikkhare, ",
  "thag16.10:17.3": "avūpasantā ajjhattaṃ ",
  "thag16.10:17.4": "sāmaññattho 'ti acchati. ",
  "thag16.10:18.1": "mattikaṃ telaṃ cuṇṇañ ca ",
  "thag16.10:18.2": "udakāsanabhojanaṃ ",
  "thag16.10:18.3": "gihīnaṃ upanāmenti ",
  "thag16.10:18.4": "ākaṅkhantā bahuttaraṃ. ",
  "thag16.10:19.1": "dantapoṇaṃ kapiṭṭhañ ca ",
  "thag16.10:19.2": "pupphakhādaniyāni ca ",
  "thag16.10:19.3": "piṇḍapāte ca sampanne ",
  "thag16.10:19.4": "ambe āmalakāni ca, ",
  "thag16.10:20.1": "bhesajjesu yathā vejjā, ",
  "thag16.10:20.2": "kiccākicce yathā gihī, ",
  "thag16.10:20.3": "gaṇikā va vibhūsāyaṃ, ",
  "thag16.10:20.4": "issare khattiyā yathā, ",
  "thag16.10:21.1": "nekatikā vañcanikā ",
  "thag16.10:21.2": "kūṭasakkhī avāṭukā ",
  "thag16.10:21.3": "bahūhi parikappehi ",
  "thag16.10:21.4": "āmisaṃ paribhuñjare. ",
  "thag16.10:22.1": "lesakappe pariyāye ",
  "thag16.10:22.2": "parikappe 'nudhāvitā ",
  "thag16.10:22.3": "jīvikatthā upāyena ",
  "thag16.10:22.4": "saṃkaḍḍhanti bahuṃ dhanaṃ. ",
  "thag16.10:23.1": "upaṭṭhapenti parisaṃ ",
  "thag16.10:23.2": "kammato no ca dhammato, ",
  "thag16.10:23.3": "dhammaṃ paresaṃ desenti ",
  "thag16.10:23.4": "lābhato no ca atthato. ",
  "thag16.10:24.1": "saṃghalābhassa bhaṇḍanti ",
  "thag16.10:24.2": "saṃghato paribāhirā, ",
  "thag16.10:24.3": "paralābhopajīvantā ",
  "thag16.10:24.4": "ahirikā 'va na lajjare. ",
  "thag16.10:25.1": "nānuyuttā tathā eke ",
  "thag16.10:25.2": "muṇḍā saṃghāṭipārutā ",
  "thag16.10:25.3": "sambhāvanaṃ yev' icchanti ",
  "thag16.10:25.4": "lābhasakkāramucchitā. ",
  "thag16.10:26.1": "evaṃ nānappayātamhi ",
  "thag16.10:26.2": "ni dāni sukaraṃ tathā ",
  "thag16.10:26.3": "aphusitaṃ vā phusituṃ ",
  "thag16.10:26.4": "phusitaṃ vānurakkhituṃ. ",
  "thag16.10:27.1": "yathā kaṇṭakaṭṭhānamhi ",
  "thag16.10:27.2": "careyya anupāhano ",
  "thag16.10:27.3": "satiṃ upaṭṭhapetvāna, ",
  "thag16.10:27.4": "evaṃ gāme munī care. ",
  "thag16.10:28.1": "saritvā pubbake yogī ",
  "thag16.10:28.2": "tesaṃ vattam anussaraṃ ",
  "thag16.10:28.3": "kiñcāpi pacchimo kālo ",
  "thag16.10:28.4": "phuseyya amataṃ padaṃ. ",
  "thag16.10:29.1": "idaṃ vatvā sālavane ",
  "thag16.10:29.2": "samaṇo bhāvitindriyo ",
  "thag16.10:29.3": "brāhmaṇo parinibbāyi ",
  "thag16.10:29.4": "isi khīṇapunabbhavo 'ti. ",
  "thag16.10:29.5": "",
  "thag16.10:29.6": "",
  "thag16.10:30.0": "",
  "thag16.10:30.1": "Adhimutto Pārāpariyo ",
  "thag16.10:30.2": "Telakāni Raṭṭhapālo ",
  "thag16.10:30.3": "Māluṅkya-Selo Bhaddiyo ",
  "thag16.10:30.4": "Aṅguli dibbacakkhuko | ",
  "thag16.10:30.5": "Pārāpariyo, das' ete ",
  "thag16.10:30.6": "Vīsamhi suparikittitā, ",
  "thag16.10:30.7": "gāthāyo dve satā honti ",
  "thag16.10:30.8": "pañcatālīsa uttarin ti. "
}
