  "thag1.101:0.4": "",
  "thag1.101:1.1": "Hitvā gihitvaṃ anavositatto ",
  "thag1.101:1.2": "mukhanaṅgalī odariko kusīto ",
  "thag1.101:1.3": "mahāvarāho va nivāpapuṭṭho ",
  "thag1.101:1.4": "punappunaṃ gabbham upeti ",
  "thag1.101:1.5": "mando 'ti. "
}
