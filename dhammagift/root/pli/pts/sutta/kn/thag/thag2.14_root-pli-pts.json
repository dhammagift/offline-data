  "thag2.14:0.3": "",
  "thag2.14:0.4": "",
  "thag2.14:1.1": "Parittaṃ dārum āruyha ",
  "thag2.14:1.2": "yathā sīde mahaṇṇave, ",
  "thag2.14:1.3": "evaṃ kusītam āgamma ",
  "thag2.14:1.4": "sādhujīvī pi sīdati; ",
  "thag2.14:1.5": "tasmā taṃ parivajjeyya ",
  "thag2.14:1.6": "kusītaṃ hīnavīriyaṃ. ",
  "thag2.14:2.1": "pavivittehi ariyehi ",
  "thag2.14:2.2": "pahitattehi jhāyihi ",
  "thag2.14:2.3": "niccaṃ āraddhaviriyehi ",
  "thag2.14:2.4": "paṇḍitehi sahāvase ",
  "thag2.14:2.5": "'ti. "
}
