  "thag2.26:0.3": "",
  "thag2.26:0.4": "",
  "thag2.26:1.1": "Pañca nīvaraṇe hitvā ",
  "thag2.26:1.2": "yogakkhemassa pattiyā ",
  "thag2.26:1.3": "dhammādāsaṃ gahetvāna ",
  "thag2.26:1.4": "ñāṇadassanam attano ",
  "thag2.26:2.1": "paccavekkhiṃ imaṃ kāyaṃ ",
  "thag2.26:2.2": "sabbaṃ santarabāhiraṃ, ",
  "thag2.26:2.3": "ajjhattañ ca bahiddhā ca ",
  "thag2.26:2.4": "tuccho kāyo adissathā ",
  "thag2.26:2.5": "'ti. "
}
