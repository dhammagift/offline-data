  "thag1.17:0.4": "",
  "thag1.17:1.1": "Middhī yadā hoti mahagghaso ca ",
  "thag1.17:1.2": "niddāyitā samparivattasāyī ",
  "thag1.17:1.3": "mahāvarāho va nivāpapuṭṭho ",
  "thag1.17:1.4": "punappunaṃ gabbham upeti ",
  "thag1.17:1.5": "mando 'ti. "
}
