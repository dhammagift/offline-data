  "thag1.62:1.1": "Ekakā mayaṃ araññe viharāma ",
  "thag1.62:1.2": "apaviddhaṃ va vanasmi dārukaṃ; ",
  "thag1.62:1.3": "tassa me bahukā pihayanti ",
  "thag1.62:1.4": "nerayikā viya saggagāminan ",
  "thag1.62:1.5": "ti. "
}
