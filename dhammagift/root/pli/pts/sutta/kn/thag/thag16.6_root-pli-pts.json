{
  "thag16.6:0.1": "",
  "thag16.6:0.2": "",
  "thag16.6:0.3": "",
  "thag16.6:0.4": "",
  "thag16.6:1.1": "Paripuṇṇakāyo suruci ",
  "thag16.6:1.2": "sujāto cārudassano ",
  "thag16.6:1.3": "suvaṇṇavaṇṇo 'si bhagavā, ",
  "thag16.6:1.4": "susukkadāṭho 'si viriyavā. ",
  "thag16.6:2.1": "narassa hi sujātassa ",
  "thag16.6:2.2": "ye bhavanti viyañjanā ",
  "thag16.6:2.3": "sabbe te tava kāyasmiṃ ",
  "thag16.6:2.4": "mahāpurisalakkhaṇā. ",
  "thag16.6:3.1": "pasannanetto sumukho ",
  "thag16.6:3.2": "brahā uju patāpavā ",
  "thag16.6:3.3": "majjhe samaṇasaṃghassa ",
  "thag16.6:3.4": "ādicco va virocasi. ",
  "thag16.6:4.1": "kalyāṇadassano bhikkhu ",
  "thag16.6:4.2": "kañcanasannibhattaco: ",
  "thag16.6:4.3": "kin te samaṇabhāvena ",
  "thag16.6:4.4": "evaṃ uttamavaṇṇino. ",
  "thag16.6:5.1": "rājā arahasi bhavituṃ ",
  "thag16.6:5.2": "cakkavattirathesabho ",
  "thag16.6:5.3": "cāturanto vijitāvī ",
  "thag16.6:5.4": "Jambusaṇḍassa issaro. ",
  "thag16.6:6.1": "khattiyā bhojarājāno ",
  "thag16.6:6.2": "anuyantā bhavanti te; ",
  "thag16.6:6.3": "rājābhirājā manujindo ",
  "thag16.6:6.4": "rajjaṃ kārehi Gotama. ",
  "thag16.6:7.1": "rājāham asmi Selā ",
  "thag16.6:7.2": "'ti bhagavā ",
  "thag16.6:7.3": "dhammarājā anuttaro, ",
  "thag16.6:7.4": "dhammena cakkaṃ vattemi ",
  "thag16.6:7.5": "cakkaṃ appaṭivattiyaṃ. ",
  "thag16.6:8.1": "sambuddho paṭijānāsi ",
  "thag16.6:8.2": "iti Selo brāhmaṇo ",
  "thag16.6:8.3": "dhammarājā anuttaro, ",
  "thag16.6:8.4": "dhammena cakkaṃ vattemi ",
  "thag16.6:8.5": "iti bhāsasi Gotama. ",
  "thag16.6:9.1": "ko nu senāpatī bhoto ",
  "thag16.6:9.2": "sāvako satthur anvayo, ",
  "thag16.6:9.3": "ko imaṃ ",
  "thag16.6:9.4": "",
  "thag16.6:10.1": "",
  "thag16.6:10.2": "",
  "thag16.6:10.3": "",
  "thag16.6:10.4": "anuvatteti dhammacakkaṃ pavattitaṃ. mayā pavattitaṃ cakkaṃ Selā 'ti bhagavā dhammacakkam anuttaraṃ Sāriputto 'nuvatteti ",
  "thag16.6:10.5": "anujāto tathāgataṃ. ",
  "thag16.6:11.1": "abhiññeyyaṃ abhiññātaṃ, ",
  "thag16.6:11.2": "bhāvetabbañ ca bhāvitaṃ, ",
  "thag16.6:11.3": "pahātabbaṃ pahīnaṃ me, ",
  "thag16.6:11.4": "tasmā buddho 'smi brāhmaṇa. ",
  "thag16.6:12.1": "vinayassu mayī kaṅkhaṃ. ",
  "thag16.6:12.2": "adhimuccassu brāhmaṇa. ",
  "thag16.6:12.3": "dullabhaṃ dassanaṃ hoti ",
  "thag16.6:12.4": "sambuddhānaṃ abhiṇhaso. ",
  "thag16.6:13.1": "yesaṃ ve dullabho loke ",
  "thag16.6:13.2": "pātubhāvo abhiṇhaso, ",
  "thag16.6:13.3": "so 'haṃ brāhmaṇa buddho 'smi ",
  "thag16.6:13.4": "sallakatto anuttaro. ",
  "thag16.6:14.1": "Brahmabhūto atitulo ",
  "thag16.6:14.2": "Mārasenappamaddano ",
  "thag16.6:14.3": "sabbāmitte vasīkatvā ",
  "thag16.6:14.4": "modāmi akutobhayo. ",
  "thag16.6:15.1": "idaṃ bhonto nisāmetha ",
  "thag16.6:15.2": "yathā bhāsati cakkhumā ",
  "thag16.6:15.3": "sallakatto mahāvīro, ",
  "thag16.6:15.4": "sīho va nadatī vane. ",
  "thag16.6:16.1": "Brahmabhūtaṃ atitulaṃ ",
  "thag16.6:16.2": "Mārasenappamaddanaṃ ",
  "thag16.6:16.3": "ko disvā na ppasīdeyya ",
  "thag16.6:16.4": "api kaṇhābhijātiko. ",
  "thag16.6:17.1": "yo maṃ icchati anvetu ",
  "thag16.6:17.2": "yo vā n' icchati gacchatu: ",
  "thag16.6:17.3": "idhāhaṃ pabbajissāmi ",
  "thag16.6:17.4": "varapaññassa santike. ",
  "thag16.6:18.1": "etañ ce ruccatī bhoto ",
  "thag16.6:18.2": "sammāsambuddhasāsanaṃ, ",
  "thag16.6:18.3": "mayam pi pabbajissāma ",
  "thag16.6:18.4": "varapaññassa santike. ",
  "thag16.6:19.1": "brāhmaṇā tisatā ime ",
  "thag16.6:19.2": "yācanti pañjalīkatā: ",
  "thag16.6:19.3": "brahmacariyaṃ carissāma ",
  "thag16.6:19.4": "bhagavā tava santike. ",
  "thag16.6:20.1": "svākkhātaṃ brahmacariyaṃ ",
  "thag16.6:20.2": "Selā 'ti bhagavā ",
  "thag16.6:20.3": "sandiṭṭhikam akālikaṃ ",
  "thag16.6:20.4": "yattha amoghā pabbajjā ",
  "thag16.6:20.5": "appamattassa sikkhato. ",
  "thag16.6:21.1": "yan taṃ saraṇam āgamma ",
  "thag16.6:21.2": "ito aṭṭhami cakkhuma, ",
  "thag16.6:21.3": "sattarattena bhagavā ",
  "thag16.6:21.4": "dant' amha tava sāsane. ",
  "thag16.6:22.1": "tuvaṃ buddho, tuvaṃ satthā, ",
  "thag16.6:22.2": "tuvaṃ Mārābhibhū muni, ",
  "thag16.6:22.3": "tuvaṃ anusaye chetvā ",
  "thag16.6:22.4": "tiṇṇo tāres' imaṃ pajaṃ. ",
  "thag16.6:23.1": "upadhī te samatikkantā, ",
  "thag16.6:23.2": "āsavā te padālitā, ",
  "thag16.6:23.3": "sīho va anupādāno ",
  "thag16.6:23.4": "pahīnabhayabheravo. ",
  "thag16.6:24.1": "bhikkhavo tisatā ime ",
  "thag16.6:24.2": "tiṭṭhantī pañjalīkatā; ",
  "thag16.6:24.3": "pāde vīra pasārehi, ",
  "thag16.6:24.4": "nāgā vandantu satthuno 'ti. ",
  "thag16.6:24.5": "Yā taṃ "
}
