  "thag3.13:0.3": "",
  "thag3.13:0.4": "",
  "thag3.13:1.1": "Suṇātha ñātayo sabbe ",
  "thag3.13:1.2": "yāvant' ettha samāgatā, ",
  "thag3.13:1.3": "dhammaṃ vo desayissāmi; ",
  "thag3.13:1.4": "dukkhā jāti punappunaṃ. ",
  "thag3.13:2.1": "ārabhatha nikkhamatha ",
  "thag3.13:2.2": "yañjatha buddhasāsane ",
  "thag3.13:2.3": "dhunātha Maccuno senaṃ ",
  "thag3.13:2.4": "naḷāgāraṃ va kuñjaro. ",
  "thag3.13:3.1": "yo imasmiṃ dhammavinaye ",
  "thag3.13:3.2": "appamatto vihessati, ",
  "thag3.13:3.3": "pahāya jātisaṃsāraṃ ",
  "thag3.13:3.4": "dukkhass' antaṃ karissatīti. ",
  "thag3.13:3.5": ""
}
