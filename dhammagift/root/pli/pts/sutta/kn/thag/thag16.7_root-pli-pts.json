  "thag16.7:1.1": "me hatthigīvāya ",
  "thag16.7:1.2": "sukhumā vatthā padhāritā, ",
  "thag16.7:1.3": "sālīnaṃ odano bhutto ",
  "thag16.7:1.4": "sucimaṃsūpasecano, ",
  "thag16.7:2.1": "so 'jja bhaddo sātatiko ",
  "thag16.7:2.2": "uñchāpattāgate rato ",
  "thag16.7:2.3": "jhāyati anupādāno ",
  "thag16.7:2.4": "putto Godhāya Bhaddiyo. ",
  "thag16.7:3.1": "paṃsukūlī sātatiko ",
  "thag16.7:3.2": "uñchāpattāgate rato ",
  "thag16.7:3.3": "jhāyati anupādāno ",
  "thag16.7:3.4": "putto Godhāya Bhaddiyo. ",
  "thag16.7:4.1": "piṇḍapātī sātatiko ",
  "thag16.7:4.2": "",
  "thag16.7:4.3": "--pa-- ",
  "thag16.7:4.4": "",
  "thag16.7:5.1": "tecīvarī sātatiko ",
  "thag16.7:5.2": "",
  "thag16.7:5.3": "--pa-- ",
  "thag16.7:5.4": "",
  "thag16.7:6.1": "sapa -dānacārī s- ",
  "thag16.7:6.2": "",
  "thag16.7:6.3": "--pa-- ",
  "thag16.7:6.4": "",
  "thag16.7:7.1": "ekāsanī s- ",
  "thag16.7:7.2": "",
  "thag16.7:7.3": "--pa-- ",
  "thag16.7:7.4": "",
  "thag16.7:8.1": "pattapiṇḍī s- ",
  "thag16.7:8.2": "",
  "thag16.7:8.3": "--pa-- ",
  "thag16.7:8.4": "",
  "thag16.7:9.1": "khalupacchābhattī s- ",
  "thag16.7:9.2": "",
  "thag16.7:9.3": "--pa-- ",
  "thag16.7:9.4": "",
  "thag16.7:10.1": "āraññiko s--pa-- ",
  "thag16.7:10.2": "",
  "thag16.7:10.3": "",
  "thag16.7:10.4": "",
  "thag16.7:11.1": "rukkhamūliko s- ",
  "thag16.7:11.2": "",
  "thag16.7:11.3": "--pa-- ",
  "thag16.7:11.4": "",
  "thag16.7:12.1": "abbhokāsī s--pa-- ",
  "thag16.7:12.2": "",
  "thag16.7:12.3": "s- ",
  "thag16.7:12.4": "",
  "thag16.7:13.1": "sāniko s- ",
  "thag16.7:13.2": "",
  "thag16.7:13.3": "--pa-- ",
  "thag16.7:13.4": "",
  "thag16.7:14.1": "yathāsanthatiko s--pa-- ",
  "thag16.7:14.2": "",
  "thag16.7:14.3": "",
  "thag16.7:14.4": "",
  "thag16.7:15.1": "nesajjiko s- ",
  "thag16.7:15.2": "",
  "thag16.7:15.3": "--pa-- ",
  "thag16.7:15.4": "",
  "thag16.7:16.1": "appiccho s- ",
  "thag16.7:16.2": "",
  "thag16.7:16.3": "--pa- ",
  "thag16.7:16.4": "",
  "thag16.7:17.1": "santuṭṭho s- ",
  "thag16.7:17.2": "",
  "thag16.7:17.3": "--pa-- ",
  "thag16.7:17.4": "",
  "thag16.7:18.1": "pavivitto s- ",
  "thag16.7:18.2": "",
  "thag16.7:18.3": "--pa-- ",
  "thag16.7:18.4": "",
  "thag16.7:19.1": "asaṃsaṭṭho s--pa-- ",
  "thag16.7:19.2": "",
  "thag16.7:19.3": "",
  "thag16.7:19.4": "",
  "thag16.7:20.1": "āraddhaviriyo sātatiko ",
  "thag16.7:20.2": "",
  "thag16.7:20.3": "--pa-- ",
  "thag16.7:20.4": "",
  "thag16.7:21.1": "hitvā satapalaṃ kaṃsaṃ ",
  "thag16.7:21.2": "sovaṇṇaṃ satarājikaṃ ",
  "thag16.7:21.3": "aggahiṃ mattikāpattaṃ, ",
  "thag16.7:21.4": "idaṃ dutiyābhisecanaṃ. ",
  "thag16.7:22.1": "ucce maṇḍalipākāre ",
  "thag16.7:22.2": "daḷhamaṭṭālakoṭṭhake ",
  "thag16.7:22.3": "rakkhito khaggahatthehi ",
  "thag16.7:22.4": "uttasaṃ vihariṃ pure. ",
  "thag16.7:23.1": "so 'jja bhaddo anutrāsī ",
  "thag16.7:23.2": "pahīnabhayabheravo ",
  "thag16.7:23.3": "jhāyati vanam ogayha ",
  "thag16.7:23.4": "putto Godhāya Bhaddiyo. ",
  "thag16.7:24.1": "sīlakkhandhe patiṭṭhāya ",
  "thag16.7:24.2": "satiṃ paññañ ca bhāvayaṃ ",
  "thag16.7:24.3": "pāpuṇiṃ anupubbena ",
  "thag16.7:24.4": "sabbasaṃyojanakkhayan ti. ",
  "thag16.7:24.5": "Bhaddiyo Kāligodhāya putto. "
}
