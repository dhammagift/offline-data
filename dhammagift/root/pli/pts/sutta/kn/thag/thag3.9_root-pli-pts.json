{
  "thag3.9:0.1": "",
  "thag3.9:0.2": "",
  "thag3.9:0.3": "",
  "thag3.9:0.4": "",
  "thag3.9:1.1": "",
  "thag3.9:1.2": "kiso dhamanisantato ",
  "thag3.9:1.3": "mattaññu annapānamhi ",
  "thag3.9:1.4": "adīnamanaso naro ",
  "thag3.9:2.1": "phuṭṭho ḍaṃsehi makasehi ",
  "thag3.9:2.2": "araññasmiṃ brahāvane ",
  "thag3.9:2.3": "nāgo saṃgāmasīse va ",
  "thag3.9:2.4": "sato tatrādhivāsaye. ",
  "thag3.9:3.1": "yathā Brahmā tathā eko, ",
  "thag3.9:3.2": "yathā devo tathā duve, ",
  "thag3.9:3.3": "yathā gāmo tathā tayo, ",
  "thag3.9:3.4": "kolāhalaṃ tat' ",
  "thag3.9:3.5": "uttarin ti. "
}
