  "thag1.37:0.4": "",
  "thag1.37:1.1": "Nānājanapadaṃ yanti ",
  "thag1.37:1.2": "vicarantā asaññatā ",
  "thag1.37:1.3": "samādhiñ ca virādhenti, ",
  "thag1.37:1.4": "kiṃ su raṭṭhaṃcariyā karissati. ",
  "thag1.37:1.5": "tasmā vineyya sārambhaṃ ",
  "thag1.37:1.6": "jhāyeyya apurakkhato 'ti. Kumāputtassa ",
  "thag1.37:1.7": "therassa sahāyako thero. "
}
