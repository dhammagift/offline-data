  "thag1.75:1.1": "Sādhu suvihitāna dassanaṃ, ",
  "thag1.75:1.2": "kaṅkhā chijjati, buddhi vaḍḍhati, ",
  "thag1.75:1.3": "bālam pi karonti paṇḍitaṃ, ",
  "thag1.75:1.4": "tasmā sādhu sataṃ samāgamo ",
  "thag1.75:1.5": "'ti. "
}
