{
  "thag2.49:0.1": "",
  "thag2.49:0.2": "",
  "thag2.49:0.3": "",
  "thag2.49:0.4": "",
  "thag2.49:1.1": "Assatthe haritobhāse ",
  "thag2.49:1.2": "saṃvirūḷhamhi pādape ",
  "thag2.49:1.3": "ekaṃ buddhagataṃ saññaṃ ",
  "thag2.49:1.4": "alabhitthaṃ patissato. ",
  "thag2.49:2.1": "ekatiṃse ito kappe ",
  "thag2.49:2.2": "yaṃ saññaṃ alabhin tadā, ",
  "thag2.49:2.3": "tassā saññāya vāhasā ",
  "thag2.49:2.4": "patto me āsavakkhayo 'ti. ",
  "thag2.49:2.5": "",
  "thag2.49:2.6": "",
  "thag2.49:3.0": "",
  "thag2.49:3.1": "Kumārakassapo thero ",
  "thag2.49:3.2": "Dhammapālo ca Brahmāli ",
  "thag2.49:3.3": "Mogharājā Visākho ca ",
  "thag2.49:3.4": "Cūḷako ca Anūpamo ",
  "thag2.49:3.5": "Vajjito Sandhito thero ",
  "thag2.49:3.6": "kilesarajavāhano 'ti. | ",
  "thag2.49:3.7": "",
  "thag2.49:4.0": "",
  "thag2.49:4.1": "gāthā Dukanipātamhi ",
  "thag2.49:4.2": "navuti c' eva aṭṭha ca, ",
  "thag2.49:4.3": "therā ekūnapaññāsaṃ ",
  "thag2.49:4.4": "bhāsitā nayakovidā. | Ayonisuddhiṃ anvesaṃ "
}
