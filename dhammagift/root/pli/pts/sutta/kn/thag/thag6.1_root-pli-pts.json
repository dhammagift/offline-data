  "thag6.1:0.1": "",
  "thag6.1:0.2": "",
  "thag6.1:0.3": "",
  "thag6.1:0.4": "",
  "thag6.1:1.1": "Disvāna pāṭihīrāni ",
  "thag6.1:1.2": "Gotamassa yasassino ",
  "thag6.1:1.3": "na tāvāhaṃ paṇipatiṃ ",
  "thag6.1:1.4": "issāmānena vañcito. ",
  "thag6.1:2.1": "mama saṃkappam aññāya ",
  "thag6.1:2.2": "codesi narasārathi, ",
  "thag6.1:2.3": "tato me āsi saṃvego ",
  "thag6.1:2.4": "abbhuto lomahaṃsano. ",
  "thag6.1:3.1": "pubbe jaṭilabhūtassa ",
  "thag6.1:3.2": "yā me iddhi parittikā, ",
  "thag6.1:3.3": "tāhaṃ tadā niraṃkatvā ",
  "thag6.1:3.4": "pabbajiṃ jinasāsane. ",
  "thag6.1:4.1": "pubbe yaññena santuṭṭho ",
  "thag6.1:4.2": "kāmadhātupurakkhato, ",
  "thag6.1:4.3": "pacchā rāgañ ca dosañ ca ",
  "thag6.1:4.4": "mohañ cāpi samūhaniṃ. ",
  "thag6.1:5.1": "pubbenivāsaṃ jānāmi, ",
  "thag6.1:5.2": "dibbacakkhuṃ visodhitaṃ, ",
  "thag6.1:5.3": "iddhimā paracittaññū ",
  "thag6.1:5.4": "dibbasotañ ca pāpuṇiṃ. ",
  "thag6.1:6.1": "yassa c' atthāya pabbajito ",
  "thag6.1:6.2": "agārasmā anagāriyaṃ, ",
  "thag6.1:6.3": "so me attho anuppatto ",
  "thag6.1:6.4": "sabbasaṃyojanakkhayo ",
  "thag6.1:6.5": "'ti. "
}
