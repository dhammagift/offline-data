{
  "thag1.20:0.1": "",
  "thag1.20:0.2": "",
  "thag1.20:0.3": "",
  "thag1.20:0.4": "",
  "thag1.20:1.1": "Maraṇe me bhayaṃ n' atthi, ",
  "thag1.20:1.2": "nikantī n' atthi jīvite, ",
  "thag1.20:1.3": "sandehaṃ nikkhipissāmi ",
  "thag1.20:1.4": "sampajāno patissato 'ti. ",
  "thag1.20:1.5": "",
  "thag1.20:1.6": "",
  "thag1.20:2.0": "",
  "thag1.20:2.1": "Cūlavaccho Mahāvaccho ",
  "thag1.20:2.2": "Vanavaccho ca Sīvako ",
  "thag1.20:2.3": "Kuṇḍadhāno ca Belaṭṭhi ",
  "thag1.20:2.4": "Dāsako ca tato paraṃ ",
  "thag1.20:2.5": "Siṅgālapitiko thero ",
  "thag1.20:2.6": "Kuḷo ca Ajito dasā 'ti. | "
}
