{
  "thag13.1:0.1": "",
  "thag13.1:0.2": "",
  "thag13.1:0.3": "",
  "thag13.1:0.4": "",
  "thag13.1:1.1": "Yāhu raṭṭhe samukkaṭṭho ",
  "thag13.1:1.2": "rañño Aṅgassa paddhagu ",
  "thag13.1:1.3": "sv ājja dhammesu ukkaṭṭho ",
  "thag13.1:1.4": "Soṇo dukkhassa pāragu. ",
  "thag13.1:2.1": "pañca chinde pañca jahe ",
  "thag13.1:2.2": "pañca c' uttari bhāvaye; ",
  "thag13.1:2.3": "pañcasaṅgātigo bhikkhu ",
  "thag13.1:2.4": "oghatiṇṇo 'ti vuccati. ",
  "thag13.1:3.1": "unnaḷassa pamattassa ",
  "thag13.1:3.2": "bāhirāsassa bhikkhuno ",
  "thag13.1:3.3": "sīlaṃ samādhi paññā ca ",
  "thag13.1:3.4": "pāripūriṃ na gacchati. ",
  "thag13.1:4.1": "yaṃ hi kiccaṃ tad apaviddhaṃ, ",
  "thag13.1:4.2": "akiccaṃ pana kayirati; ",
  "thag13.1:4.3": "unnaḷānaṃ pamattānaṃ ",
  "thag13.1:4.4": "tesaṃ vaḍḍhanti āsavā. ",
  "thag13.1:5.1": "yesañ ca susamāraddhā ",
  "thag13.1:5.2": "niccaṃ kāyagatā sati, ",
  "thag13.1:5.3": "akiccan te na sevanti ",
  "thag13.1:5.4": "kicce sātaccakārino. ",
  "thag13.1:5.5": "satānaṃ sampajānānaṃ ",
  "thag13.1:5.6": "atthaṃ gacchanti āsavā. ",
  "thag13.1:6.1": "ujumaggamhi akkhāte ",
  "thag13.1:6.2": "gacchatha mā nivattatha; ",
  "thag13.1:6.3": "attanā coday' attānaṃ, ",
  "thag13.1:6.4": "nibbānaṃ abhihāraye. ",
  "thag13.1:7.1": "accāraddhamhi viriyamhi ",
  "thag13.1:7.2": "satthā loke anuttaro ",
  "thag13.1:7.3": "vīṇopamaṃ karitvā me ",
  "thag13.1:7.4": "dhammaṃ desesi cakkhumā. ",
  "thag13.1:7.5": "tassāhaṃ vacanaṃ sutvā ",
  "thag13.1:7.6": "vihāsiṃ sāsane rato, ",
  "thag13.1:8.1": "samataṃ paṭipādesiṃ ",
  "thag13.1:8.2": "uttamatthassa pattiyā; ",
  "thag13.1:8.3": "tisso vijjā anuppattā, ",
  "thag13.1:8.4": "kataṃ buddhassa sāsanaṃ. ",
  "thag13.1:9.1": "nekkhamme adhimuttassa ",
  "thag13.1:9.2": "pavivekañ ca cetaso, ",
  "thag13.1:9.3": "abyāpajjhādhimuttassa ",
  "thag13.1:9.4": "upādānakkhayassa ca, ",
  "thag13.1:10.1": "taṇhakkhayādhimuttassa ",
  "thag13.1:10.2": "asammohañ ca cetaso ",
  "thag13.1:10.3": "disvā āyatanuppādaṃ ",
  "thag13.1:10.4": "sammā cittaṃ vimuccati. ",
  "thag13.1:11.1": "tassa sammāvimuttassa ",
  "thag13.1:11.2": "santacittassa bhikkhuno ",
  "thag13.1:11.3": "katassa paṭicayo n' atthi, ",
  "thag13.1:11.4": "karaṇīyaṃ na vijjati. ",
  "thag13.1:12.1": "selo yathā ekaghano ",
  "thag13.1:12.2": "vātena na samīrati, ",
  "thag13.1:12.3": "evaṃ rūpā rasā saddā ",
  "thag13.1:12.4": "gandhā phassā ca kevalā ",
  "thag13.1:13.1": "iṭṭhā dhammā aniṭṭhā ca ",
  "thag13.1:13.2": "na ppavedhenti tādino; ",
  "thag13.1:13.3": "ṭhitaṃ cittaṃ visaññuttaṃ ",
  "thag13.1:13.4": "vayañ c' assānupassatīti. ",
  "thag13.1:13.5": "Soṇo Koḷiviso thero ",
  "thag13.1:13.6": "",
  "thag13.1:14.0": "",
  "thag13.1:14.1": "",
  "thag13.1:14.2": "eko yeva mahiddhiko ",
  "thag13.1:14.3": "Terasamhi nipātamhi, ",
  "thag13.1:14.4": "gāthāyo c' ettha terasā 'ti. Terasanipāto niṭṭhito. "
}
