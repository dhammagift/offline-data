  "thag5.2:1.1": "Ayoge yuñjam attānaṃ ",
  "thag5.2:1.2": "puriso kiccam icchato ",
  "thag5.2:1.3": "caraṃ ce nādhigaccheyya, ",
  "thag5.2:1.4": "taṃ me dubbhagalakkhaṇaṃ. ",
  "thag5.2:2.1": "abbūḷhaṃ aghataṃ vijitaṃ ",
  "thag5.2:2.2": "ekañ ce ossajjeyya kalī va siyā; ",
  "thag5.2:2.3": "sabbāni pi ce ossajjeyya andho va siyā ",
  "thag5.2:2.4": "samavisamassa adassanato. ",
  "thag5.2:3.1": "yañ hi kayirā . . . (= 226) ",
  "thag5.2:3.2": "",
  "thag5.2:3.3": "",
  "thag5.2:3.4": "",
  "thag5.2:4.1": "yathāpi ruciraṃ pupphaṃ ",
  "thag5.2:4.2": "vaṇṇavantaṃ agandhakaṃ, ",
  "thag5.2:4.3": "evaṃ subhāsitā vācā ",
  "thag5.2:4.4": "aphalā hoti akubbato. ",
  "thag5.2:5.1": "yathāpi ruciraṃ pupphaṃ ",
  "thag5.2:5.2": "vaṇṇavantaṃ sagandhakaṃ ",
  "thag5.2:5.3": "evaṃ subhāsitā vācā ",
  "thag5.2:5.4": "saphalā hoti sakubbato ",
  "thag5.2:5.5": "'ti. "
}
