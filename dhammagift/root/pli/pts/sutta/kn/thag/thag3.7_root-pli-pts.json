  "thag3.7:0.3": "",
  "thag3.7:0.4": "",
  "thag3.7:1.1": "koci manussesu ",
  "thag3.7:1.2": "parapāṇāni hiṃsati, ",
  "thag3.7:1.3": "asmā lokā paramhā ca ",
  "thag3.7:1.4": "ubhayā dhaṃsate naro. ",
  "thag3.7:2.1": "yo ca mettena cittena ",
  "thag3.7:2.2": "sabbapāṇ' ānukampati, bahuṃ ",
  "thag3.7:2.3": "hi so pasavati ",
  "thag3.7:2.4": "puññaṃ tādisako naro. ",
  "thag3.7:3.1": "subhāsitassa sikkhetha ",
  "thag3.7:3.2": "samaṇupāsanassa ca ",
  "thag3.7:3.3": "ekāsanassa ca raho ",
  "thag3.7:3.4": "cittavūpasamassa cā 'ti. ",
  "thag3.7:3.5": "Eko pi "
}
