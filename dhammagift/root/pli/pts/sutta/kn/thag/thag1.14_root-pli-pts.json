  "thag1.14:0.3": "",
  "thag1.14:0.4": "",
  "thag1.14:1.1": "Upajjhāyo maṃ avacāsi ",
  "thag1.14:1.2": "ito gacchāmi Sīvaka. ",
  "thag1.14:1.3": "gāme me vasati kāyo ",
  "thag1.14:1.4": "araññaṃ me gato mano ",
  "thag1.14:1.5": "semānako pi gacchāmi; ",
  "thag1.14:1.6": "n' atthi saṅgo vijānatan ti. ",
  "thag1.14:1.7": "Vanavacchassa therassa sāmaṇero. "
}
