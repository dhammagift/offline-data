{
  "thag5.5:0.1": "",
  "thag5.5:0.2": "",
  "thag5.5:0.3": "",
  "thag5.5:0.4": "",
  "thag5.5:1.1": "Sādhu hi kira me mātā ",
  "thag5.5:1.2": "patodaṃ upadaṃsayi, ",
  "thag5.5:1.3": "yassāhaṃ vacanaṃ sutvā ",
  "thag5.5:1.4": "anusiṭṭho janettiyā ",
  "thag5.5:1.5": "āraddhaviriyo pahitatto ",
  "thag5.5:1.6": "patto sambodhim uttamaṃ. ",
  "thag5.5:2.1": "arahā dakkhiṇeyyo 'mhi ",
  "thag5.5:2.2": "tevijjo amataddaso; ",
  "thag5.5:2.3": "jitvā Namucino senaṃ ",
  "thag5.5:2.4": "viharāmi anāsavo. ",
  "thag5.5:3.1": "ajjhattañ ca bahiddhā ca ",
  "thag5.5:3.2": "ye me vijjiṃsu āsavā ",
  "thag5.5:3.3": "sabbe asesā ucchinnā ",
  "thag5.5:3.4": "na ca uppajjare puna. ",
  "thag5.5:4.1": "visāradā kho bhaginī ",
  "thag5.5:4.2": "etaṃ atthaṃ abhāsayi: ",
  "thag5.5:4.3": "api hā nūna mayi pi ",
  "thag5.5:4.4": "vanatho te na vijjati. ",
  "thag5.5:5.1": "pariyantakataṃ dukkhaṃ, ",
  "thag5.5:5.2": "antimo 'yaṃ samussayo ",
  "thag5.5:5.3": "jātimaraṇasaṃsāro, ",
  "thag5.5:5.4": "n' atthi dāni punabbhavo ",
  "thag5.5:5.5": "'ti. "
}
