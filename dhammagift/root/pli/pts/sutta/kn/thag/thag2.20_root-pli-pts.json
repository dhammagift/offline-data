  "thag2.20:0.3": "",
  "thag2.20:0.4": "",
  "thag2.20:1.1": "Pare ca naṃ pasaṃsanti ",
  "thag2.20:1.2": "attā ce asamāhito: ",
  "thag2.20:1.3": "moghaṃ pare pasaṃsanti, ",
  "thag2.20:1.4": "attā hi asamāhito. ",
  "thag2.20:2.1": "pare ca naṃ garahanti ",
  "thag2.20:2.2": "attā ce susamāhito: ",
  "thag2.20:2.3": "moghaṃ pare garahanti, ",
  "thag2.20:2.4": "attā hi susamāhito. ",
  "thag2.20:2.5": "",
  "thag2.20:2.6": "",
  "thag2.20:3.0": "",
  "thag2.20:3.1": "Cundo ca Jotidāso ca ",
  "thag2.20:3.2": "thero Heraññakāni yo ",
  "thag2.20:3.3": "Somamitto Sabbamitto ",
  "thag2.20:3.4": "Kālo Tisso ca Kimbilo ",
  "thag2.20:3.5": "Nando ca Sirimā c' eva ",
  "thag2.20:3.6": "dasa therā mahiddhikā 'ti. "
}
