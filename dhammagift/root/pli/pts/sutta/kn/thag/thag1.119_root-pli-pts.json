  "thag1.119:1.1": "Rukkhamūlagahanaṃ pasakkiya ",
  "thag1.119:1.2": "nibbānaṃ hadayasmiṃ osiya ",
  "thag1.119:1.3": "jhāya Gotama mā ca pamādo; ",
  "thag1.119:1.4": "kin te biḷibiḷikā karissatīti. ",
  "thag1.119:1.5": "Pañca kkhandhā "
}
