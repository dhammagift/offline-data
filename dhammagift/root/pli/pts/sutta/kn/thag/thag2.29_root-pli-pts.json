  "thag2.29:0.3": "",
  "thag2.29:0.4": "",
  "thag2.29:1.1": "Nadanti evaṃ sappaññā ",
  "thag2.29:1.2": "sīhā va girigabbhare ",
  "thag2.29:1.3": "vīrā vijitasaṃgāmā ",
  "thag2.29:1.4": "jetvā Māraṃ savāhanaṃ. ",
  "thag2.29:2.1": "satthā ca pariciṇṇo me, ",
  "thag2.29:2.2": "dhammo saṃgho ca pūjito, ",
  "thag2.29:2.3": "ahañ ca vitto sumano ",
  "thag2.29:2.4": "puttaṃ disvā anāsavan ",
  "thag2.29:2.5": "ti. "
}
