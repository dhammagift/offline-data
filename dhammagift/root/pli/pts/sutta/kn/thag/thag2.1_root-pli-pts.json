  "thag2.1:0.3": "",
  "thag2.1:0.4": "",
  "thag2.1:1.1": "koci bhavo nicco ",
  "thag2.1:1.2": "saṃkhārā vāpi sassatā, ",
  "thag2.1:1.3": "uppajjanti ca te khandhā ",
  "thag2.1:1.4": "cavanti aparāparaṃ. ",
  "thag2.1:2.1": "etaṃ ādīnavaṃ ñatvā ",
  "thag2.1:2.2": "bhaven' amhi anatthiko, ",
  "thag2.1:2.3": "nissaṭo sabbakāmehi, ",
  "thag2.1:2.4": "patto me āsavakkhayo 'ti. ",
  "thag2.1:2.5": "itthaṃ sudaṃ āyasmā Uttaro thero gāthāyo abhāsitthā 'ti. Na idaṃ "
}
