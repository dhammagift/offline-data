  "thag1.43:1.1": "Sumuttiko sumuttiko ",
  "thag1.43:1.2": "sāhu sumuttiko mhi tīhi khujjakehi, ",
  "thag1.43:1.3": "asitāsu mayā naṅgalāsu mayā ",
  "thag1.43:1.4": "khuddakuddālāsu mayā. ",
  "thag1.43:1.5": "yadi pi idham eva idham eva ",
  "thag1.43:1.6": "athavāpi alam eva alam eva; ",
  "thag1.43:1.7": "jhāya Sumaṅgala jhāya Sumaṅgala, ",
  "thag1.43:1.8": "appamatto vihara Sumaṅgalā ",
  "thag1.43:1.9": "'ti. "
}
