  "thag1.46:1.1": "Saddhāyāhaṃ pabbajito ",
  "thag1.46:1.2": "agārasmā anagāriyaṃ, ",
  "thag1.46:1.3": "sati paññā ca me vuḍḍhā ",
  "thag1.46:1.4": "cittañ ca susamāhitaṃ. ",
  "thag1.46:1.5": "kāmaṃ karassu rūpāni, ",
  "thag1.46:1.6": "n' eva maṃ byādhayissasīti. ",
  "thag1.46:1.7": ""
}
