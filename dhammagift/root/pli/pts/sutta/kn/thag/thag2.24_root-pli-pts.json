  "thag2.24:0.1": "",
  "thag2.24:0.2": "",
  "thag2.24:0.3": "",
  "thag2.24:0.4": "",
  "thag2.24:1.1": "Yaṃ kiccaṃ daḷhaviriyena ",
  "thag2.24:1.2": "yaṃ kiccaṃ boddhum icchatā ",
  "thag2.24:1.3": "karissaṃ nāvarajjhissaṃ, ",
  "thag2.24:1.4": "passa viriyaparakkamaṃ. ",
  "thag2.24:2.1": "tvañ ca me maggam akkhāhi ",
  "thag2.24:2.2": "añjasaṃ amatogadhaṃ; ",
  "thag2.24:2.3": "ahaṃ monena monissaṃ ",
  "thag2.24:2.4": "Gaṅgāsoto va ",
  "thag2.24:2.5": "sāgaran ti. "
}
