  "thag1.34:1.1": "Anāsannavarā etā ",
  "thag1.34:1.2": "niccam eva vijānatā. ",
  "thag1.34:1.3": "gāmā araññam āgamma ",
  "thag1.34:1.4": "tato gehaṃ upāvisiṃ ",
  "thag1.34:1.5": "tato uṭṭhāya pakkāmiṃ ",
  "thag1.34:1.6": "anāmantetvā ",
  "thag1.34:1.7": "Posiyo 'ti. "
}
