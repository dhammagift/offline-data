  "thag1.51:1.1": "Vassati devo yathā sugītaṃ, ",
  "thag1.51:1.2": "channā me kuṭikā sukhā nivātā, ",
  "thag1.51:1.3": "cittaṃ susamāhitañ ca mayhaṃ, ",
  "thag1.51:1.4": "atha ce patthayasi pavassa devā ",
  "thag1.51:1.5": "'ti. "
}
