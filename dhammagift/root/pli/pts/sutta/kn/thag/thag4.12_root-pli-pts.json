{
  "thag4.12:0.1": "",
  "thag4.12:0.2": "",
  "thag4.12:0.3": "",
  "thag4.12:0.4": "",
  "thag4.12:1.1": "Pabbajiṃ jīvikattho 'haṃ, ",
  "thag4.12:1.2": "laddhāna upasampadaṃ ",
  "thag4.12:1.3": "tato saddhaṃ paṭilabhiṃ, ",
  "thag4.12:1.4": "daḷhaviriyo parakkamiṃ. ",
  "thag4.12:2.1": "kāmaṃ bhijjatu 'yaṃ kāyo ",
  "thag4.12:2.2": "maṃsapesī visīyaruṃ, ",
  "thag4.12:2.3": "ubhojannukasandhīhi ",
  "thag4.12:2.4": "jaṅghāyo papatantu me; ",
  "thag4.12:3.1": "nāsissaṃ na pivissāmi ",
  "thag4.12:3.2": "vihārā ca na nikkhame ",
  "thag4.12:3.3": "na pi passaṃ nipātessaṃ ",
  "thag4.12:3.4": "taṇhāsalle anūhate. ",
  "thag4.12:4.1": "tassa mevaṃ . . . (= 224) ",
  "thag4.12:4.2": "",
  "thag4.12:4.3": "",
  "thag4.12:4.4": "",
  "thag4.12:4.5": "",
  "thag4.12:4.6": "",
  "thag4.12:5.0": "",
  "thag4.12:5.1": "Nāgasamālo Bhagu ca ",
  "thag4.12:5.2": "Sabhiyo Nandako pi ca ",
  "thag4.12:5.3": "Jambuko Senako thero ",
  "thag4.12:5.4": "Sambhūto Rāhulo pi ca ",
  "thag4.12:6.1": "bhavati Candano thero, ",
  "thag4.12:6.2": "das' ete buddhasāvakā. | ",
  "thag4.12:6.3": "Dhammiko Sappako thero ",
  "thag4.12:6.4": "Mudito cāpi te tayo. ",
  "thag4.12:6.5": "gāthāyo dve ca paññāsa ",
  "thag4.12:6.6": "therā sabbe pi terasā 'ti. Catukkanipāto niṭṭhito. "
}
