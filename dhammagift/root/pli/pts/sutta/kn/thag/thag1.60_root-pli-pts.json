  "thag1.60:0.1": "",
  "thag1.60:0.2": "",
  "thag1.60:0.3": "",
  "thag1.60:0.4": "",
  "thag1.60:1.1": "Te me ijjhiṃsu saṃkappā ",
  "thag1.60:1.2": "yadattho pāvisiṃ kuṭiṃ, ",
  "thag1.60:1.3": "vijjā vimuttiṃ paccessaṃ ",
  "thag1.60:1.4": "mānānusayam ujjahan ti. ",
  "thag1.60:1.5": "",
  "thag1.60:1.6": "",
  "thag1.60:2.0": "",
  "thag1.60:2.1": "Godhiko ca Subāhu ca ",
  "thag1.60:2.2": "Valliyo Uttiyo isi ",
  "thag1.60:2.3": "Añjanāvaniyo thero ",
  "thag1.60:2.4": "duve Kuṭivihārino ",
  "thag1.60:2.5": "Ramaṇīyakuṭiko ca ",
  "thag1.60:2.6": "Kosallavhaya-Sīvalīti. "
}
