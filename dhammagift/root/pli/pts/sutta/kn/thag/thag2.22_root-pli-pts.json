  "thag2.22:0.3": "",
  "thag2.22:0.4": "",
  "thag2.22:1.1": "Panādo nāma so rājā ",
  "thag2.22:1.2": "yassa yūpo suvaṇṇayo ",
  "thag2.22:1.3": "tiriyaṃ soḷasapabbedho ",
  "thag2.22:1.4": "ubbham āhu sahassadhā. ",
  "thag2.22:2.1": "sahassakaṇḍu satabheṇḍu ",
  "thag2.22:2.2": "dhajālu haritāmayo; ",
  "thag2.22:2.3": "anaccuṃ tattha gandhabbā ",
  "thag2.22:2.4": "cha sahassāni sattadhā ",
  "thag2.22:2.5": "'ti. "
}
