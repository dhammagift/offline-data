  "thag2.32:0.3": "",
  "thag2.32:0.4": "",
  "thag2.32:1.1": "Aniccāni gahakāni ",
  "thag2.32:1.2": "tattha tattha punappunaṃ, ",
  "thag2.32:1.3": "gahakāraṃ gavesanto ",
  "thag2.32:1.4": "dukkhā jāti punappunaṃ. ",
  "thag2.32:2.1": "gahakāraka diṭṭho 'si, ",
  "thag2.32:2.2": "puna gehaṃ na kāhasi; ",
  "thag2.32:2.3": "sabbā te pāsukā bhaggā ",
  "thag2.32:2.4": "thūṇirā ca vidālitā; ",
  "thag2.32:2.5": "vipariyādikataṃ cittaṃ ",
  "thag2.32:2.6": "idh' eva vidhamissatīti. ",
  "thag2.32:2.7": ""
}
