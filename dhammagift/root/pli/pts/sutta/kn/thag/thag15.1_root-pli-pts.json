{
  "thag15.1:0.1": "",
  "thag15.1:0.2": "",
  "thag15.1:0.3": "",
  "thag15.1:0.4": "",
  "thag15.1:1.1": "Esa bhiyyo pasīdāmi ",
  "thag15.1:1.2": "sutvā dhammaṃ mahārasaṃ; ",
  "thag15.1:1.3": "virāgo desito dhammo ",
  "thag15.1:1.4": "anupādāya sabbaso. ",
  "thag15.1:2.1": "bahūni loke citrāni ",
  "thag15.1:2.2": "asmiṃ puthuvimaṇḍale ",
  "thag15.1:2.3": "mathenti maññesaṃkappaṃ ",
  "thag15.1:2.4": "subhaṃ rāgūpasaṃhitaṃ. ",
  "thag15.1:3.1": "rajam upātaṃ vātena ",
  "thag15.1:3.2": "yathā megho pasāmaye, ",
  "thag15.1:3.3": "evaṃ sammanti saṃkappā ",
  "thag15.1:3.4": "yadā paññāya passati. ",
  "thag15.1:4.1": "sabbe saṃkhārā aniccā 'ti ",
  "thag15.1:4.2": "yadā paññāya passati, ",
  "thag15.1:4.3": "atha nibbindatī dukkhe: ",
  "thag15.1:4.4": "esa maggo visuddhiyā. ",
  "thag15.1:5.1": "sabbe saṃkhārā dukkhā 'ti -- ",
  "thag15.1:5.2": "",
  "thag15.1:5.3": "",
  "thag15.1:5.4": "",
  "thag15.1:6.1": "sabbe dhammā anattā 'ti ",
  "thag15.1:6.2": "yadā paññāya passati, ",
  "thag15.1:6.3": "atha nibbindatī dukkhe: ",
  "thag15.1:6.4": "esa maggo visuddhiyā. ",
  "thag15.1:7.1": "buddhānubuddho yo thero ",
  "thag15.1:7.2": "Koṇḍañño tibbanikkhamo ",
  "thag15.1:7.3": "pahīnajātimaraṇo ",
  "thag15.1:7.4": "brahmacariyassa kevalī. ",
  "thag15.1:8.1": "oghāpāso daḷho khīlo, ",
  "thag15.1:8.2": "pabbato duppadāliyo: ",
  "thag15.1:8.3": "chetvā khīlañ ca pāsañ ca ",
  "thag15.1:8.4": "selaṃ chetvāna dubbhidaṃ ",
  "thag15.1:8.5": "tiṇṇo pāraṃgato jhāyī ",
  "thag15.1:8.6": "mutto so Mārabandhanā. ",
  "thag15.1:9.1": "uddhato capalo bhikkhu ",
  "thag15.1:9.2": "mitte āgamma pāpake ",
  "thag15.1:9.3": "saṃsīdati mahoghasmiṃ ",
  "thag15.1:9.4": "ummiyā paṭikujjito. ",
  "thag15.1:10.1": "anuddhato acapalo ",
  "thag15.1:10.2": "nipako saṃvutindriyo ",
  "thag15.1:10.3": "kalyāṇamitto medhāvī ",
  "thag15.1:10.4": "dukkhass' antakaro siyā. ",
  "thag15.1:11.1": "kālāpabbaṅgasaṃkāso . . . (= 243,244) ",
  "thag15.1:11.2": "",
  "thag15.1:11.3": "",
  "thag15.1:11.4": "",
  "thag15.1:12.1": "",
  "thag15.1:12.2": "",
  "thag15.1:12.3": "",
  "thag15.1:12.4": "",
  "thag15.1:13.1": "nābhinandāmi . . . (= 606,607) ",
  "thag15.1:13.2": "",
  "thag15.1:13.3": "",
  "thag15.1:13.4": "",
  "thag15.1:14.1": "",
  "thag15.1:14.2": "",
  "thag15.1:14.3": "",
  "thag15.1:14.4": "",
  "thag15.1:15.1": "pariciṇṇo . . . (= 604) ",
  "thag15.1:15.2": "",
  "thag15.1:15.3": "",
  "thag15.1:15.4": "",
  "thag15.1:16.1": "yassa c' atthāya pabbajito ",
  "thag15.1:16.2": "agārasmā anagāriyaṃ, ",
  "thag15.1:16.3": "so me attho anuppatto, ",
  "thag15.1:16.4": "kiṃ me sandavihārenā ",
  "thag15.1:16.5": "'ti. "
}
