  "thag1.109:1.1": "Na nūnāyaṃ paramahitānukampino ",
  "thag1.109:1.2": "rahogato anuvigaṇeti sāsanaṃ; ",
  "thag1.109:1.3": "tathā h' ayaṃ viharati pākatindriyo ",
  "thag1.109:1.4": "migī yathā taruṇajātikā vane ",
  "thag1.109:1.5": "'ti. "
}
