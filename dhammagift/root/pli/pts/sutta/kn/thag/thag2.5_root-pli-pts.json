  "thag2.5:0.4": "",
  "thag2.5:1.1": "Api ce hoti tevijjo ",
  "thag2.5:1.2": "maccuhāyī anāsavo, ",
  "thag2.5:1.3": "appaññāto 'ti naṃ bālā ",
  "thag2.5:1.4": "avajānanti ajānatā. ",
  "thag2.5:2.1": "yo ca kho annapānassa ",
  "thag2.5:2.2": "lābhī hoti 'dha puggalo, ",
  "thag2.5:2.3": "pāpadhammo pi ce hoti, ",
  "thag2.5:2.4": "so nesaṃ hoti sakkato ",
  "thag2.5:2.5": "'ti. "
}
