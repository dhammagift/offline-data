  "thag1.66:0.4": "",
  "thag1.66:1.1": "Anusāsi mahāvīro ",
  "thag1.66:1.2": "sabbadhammāna pāragu; ",
  "thag1.66:1.3": "tassāhaṃ dhammaṃ sutvāna ",
  "thag1.66:1.4": "vihāsiṃ santike rato; ",
  "thag1.66:1.5": "tisso vijjā anuppattā, ",
  "thag1.66:1.6": "kataṃ buddhassa sāsanan ",
  "thag1.66:1.7": "ti. "
}
