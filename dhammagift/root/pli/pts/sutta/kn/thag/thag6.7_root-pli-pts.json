{
  "thag6.7:0.1": "",
  "thag6.7:0.2": "",
  "thag6.7:0.3": "",
  "thag6.7:0.4": "",
  "thag6.7:1.1": "nisīda Kātiyāna ",
  "thag6.7:1.2": "mā niddābahulo ahu jāgarassu, ",
  "thag6.7:1.3": "mā taṃ alasaṃ pamattabandhu ",
  "thag6.7:1.4": "kūṭeneva jinātu maccurājā. ",
  "thag6.7:2.1": "sayathāpi mahāsamuddavego ",
  "thag6.7:2.2": "evaṃ jātijarātivattate taṃ, ",
  "thag6.7:2.3": "so karohi sudīpam attano tvaṃ, ",
  "thag6.7:2.4": "na hi tāṇaṃ tava vijjateva aññaṃ. ",
  "thag6.7:3.1": "satthā hi vijesi maggam etaṃ ",
  "thag6.7:3.2": "saṅgā jātijarābhayā atītaṃ; ",
  "thag6.7:3.3": "pubbāpararattam appamatto ",
  "thag6.7:3.4": "anuyuñjassu daḷhaṃ karohi yogaṃ. ",
  "thag6.7:4.1": "purimāni pamuñca bandhanāni ",
  "thag6.7:4.2": "saṃghāṭīkhuramuṇḍabhikkhabhojī, ",
  "thag6.7:4.3": "mā khiḍḍāratiñ ca mā niddaṃ ",
  "thag6.7:4.4": "anuyuñjittha jhiyāya Kātiyāna. ",
  "thag6.7:5.1": "jhāyāhi jināhi Kātiyāna, ",
  "thag6.7:5.2": "yogakkhemapathe sukovido 'si; ",
  "thag6.7:5.3": "pappuyya anuttaraṃ visuddhiṃ ",
  "thag6.7:5.4": "parinibbāhisi vārinā va joti. ",
  "thag6.7:6.1": "pajjotakaro paritaraṃso ",
  "thag6.7:6.2": "vātena vinamyate latā va; ",
  "thag6.7:6.3": "evam pi tuvaṃ anādiyāno ",
  "thag6.7:6.4": "Māraṃ Indasagotta niddhunāhi. ",
  "thag6.7:6.5": "so vedayitāsu vītarāgo ",
  "thag6.7:6.6": "kālaṃ kaṅkha idh' eva ",
  "thag6.7:6.7": "sītibhūto 'ti. "
}
