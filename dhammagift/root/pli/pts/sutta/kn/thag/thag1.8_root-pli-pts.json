  "thag1.8:1.1": "Yo duddamayo damena danto ",
  "thag1.8:1.2": "vīro santusito vitiṇṇakaṅkho ",
  "thag1.8:1.3": "vijitāvi apetalomahaṃso ",
  "thag1.8:1.4": "Vīro so parinibbuto ṭhitatto ",
  "thag1.8:1.5": "'ti. "
}
