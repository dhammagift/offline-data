  "thag2.15:0.3": "",
  "thag2.15:0.4": "",
  "thag2.15:1.1": "Jano janamhi sambaddho, ",
  "thag2.15:1.2": "janam ev' assito jano, ",
  "thag2.15:1.3": "jano janena heṭhiyati, ",
  "thag2.15:1.4": "heṭheti ca jano janaṃ. ",
  "thag2.15:2.1": "ko hi tassa janen' attho ",
  "thag2.15:2.2": "janena janitena vā. ",
  "thag2.15:2.3": "janaṃ ohāya gacchan taṃ ",
  "thag2.15:2.4": "heṭhayitvā bahuṃ janan ",
  "thag2.15:2.5": "ti. "
}
