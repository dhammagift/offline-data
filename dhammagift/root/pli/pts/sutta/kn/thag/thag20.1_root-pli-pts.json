  "thag20.1:0.4": "",
  "thag20.1:1.1": "piṇḍapātikā ",
  "thag20.1:1.2": "uñchāpattāgate ratā ",
  "thag20.1:1.3": "dālemu Maccuno senaṃ ",
  "thag20.1:1.4": "ajjhattaṃ susamāhitā. ",
  "thag20.1:2.1": "āraññakā piṇḍapātikā ",
  "thag20.1:2.2": "uñchāpattāgate ratā ",
  "thag20.1:2.3": "dhunāma Maccuno senaṃ ",
  "thag20.1:2.4": "naḷāgāraṃ va kuñjaro. ",
  "thag20.1:3.1": "rukkhamūlikā sātatikā ",
  "thag20.1:3.2": "uñchāpattāgate ratā ",
  "thag20.1:3.3": "dālemu . . . ",
  "thag20.1:3.4": "susamāhitā. ",
  "thag20.1:4.1": "rukkhamūlikā sāt. ",
  "thag20.1:4.2": "uñch. r. ",
  "thag20.1:4.3": "dhunāma . . . ",
  "thag20.1:4.4": "kuñjaro. ",
  "thag20.1:5.1": "aṭṭhikaṅkalakuṭike ",
  "thag20.1:5.2": "maṃsanhāruppasibbite ",
  "thag20.1:5.3": "dhir atthu pūre duggandhe ",
  "thag20.1:5.4": "paragatte mamāyase ",
  "thag20.1:6.1": "gūthabhaste taconaddhe ",
  "thag20.1:6.2": "uragaṇḍapisācini ",
  "thag20.1:6.3": "nava sotāni te kāye ",
  "thag20.1:6.4": "yāni sandanti sabbadā. ",
  "thag20.1:7.1": "tava sarīraṃ navasotaṃ ",
  "thag20.1:7.2": "duggandhaṃ kariparibandha, ",
  "thag20.1:7.3": "bhikkhu parivajjayate taṃ ",
  "thag20.1:7.4": "mīḷhaṃ va yathā sucikāmo. ",
  "thag20.1:8.1": "evañ ce taṃ jano jaññā ",
  "thag20.1:8.2": "yathā jānāmi taṃ ahaṃ, ",
  "thag20.1:8.3": "ārakā parivajjeyya ",
  "thag20.1:8.4": "gūthaṭṭhānaṃ va pāvuse. ",
  "thag20.1:9.1": "evam etaṃ mahāvīra ",
  "thag20.1:9.2": "yathā samaṇa bhāsasi, ",
  "thag20.1:9.3": "ettha c' eke visīdanti ",
  "thag20.1:9.4": "paṅkamhi va jaraggavo. ",
  "thag20.1:10.1": "ākāsamhi haliddāya ",
  "thag20.1:10.2": "yo maññetha rajetave ",
  "thag20.1:10.3": "aññena vāpi raṅgena, ",
  "thag20.1:10.4": "vighātudayam eva taṃ. ",
  "thag20.1:11.1": "tadākāsasamaṃ cittaṃ ",
  "thag20.1:11.2": "ajjhattaṃ susamāhitaṃ; ",
  "thag20.1:11.3": "mā pāpacitte āhari aggikkhandhaṃ ",
  "thag20.1:11.4": "va pakkhimā. ",
  "thag20.1:12.1": "passa cittakataṃ bimbam ",
  "thag20.1:12.2": "--pa-- ",
  "thag20.1:12.3": "",
  "thag20.1:12.4": "",
  "thag20.1:13.1": "",
  "thag20.1:13.2": "",
  "thag20.1:13.3": "",
  "thag20.1:13.4": "",
  "thag20.1:14.1": "",
  "thag20.1:14.2": "",
  "thag20.1:14.3": "",
  "thag20.1:14.4": "",
  "thag20.1:15.1": "",
  "thag20.1:15.2": "",
  "thag20.1:15.3": "",
  "thag20.1:15.4": "",
  "thag20.1:16.1": "",
  "thag20.1:16.2": "",
  "thag20.1:16.3": "",
  "thag20.1:16.4": "",
  "thag20.1:17.1": "",
  "thag20.1:17.2": "",
  "thag20.1:17.3": "",
  "thag20.1:17.4": "",
  "thag20.1:18.1": "",
  "thag20.1:18.2": "",
  "thag20.1:18.3": "",
  "thag20.1:18.4": "",
  "thag20.1:19.1": "tadāsi yaṃ bhiṃsanakaṃ, ",
  "thag20.1:19.2": "tadāsi lomahaṃsanaṃ ",
  "thag20.1:19.3": "anekākārasampanne ",
  "thag20.1:19.4": "Sāriputtamhi nibbute. ",
  "thag20.1:20.1": "aniccā vata saṃkhārā ",
  "thag20.1:20.2": "",
  "thag20.1:20.3": "--pa-- ",
  "thag20.1:20.4": "",
  "thag20.1:21.1": "sukhumaṃ paṭivijjhanti ",
  "thag20.1:21.2": "vālaggam usunā yathā ",
  "thag20.1:21.3": "ye pañca khandhe passanti ",
  "thag20.1:21.4": "parato no ca attato. ",
  "thag20.1:22.1": "ye ca passanti saṃkhāre ",
  "thag20.1:22.2": "parato no ca attato, ",
  "thag20.1:22.3": "paccabyādhiṃsu nipuṇaṃ ",
  "thag20.1:22.4": "vālaggaṃ usunā yathā. ",
  "thag20.1:23.1": "sattiyā viya omaṭṭho . . . (= 39,40.) ",
  "thag20.1:23.2": "",
  "thag20.1:23.3": "",
  "thag20.1:23.4": "",
  "thag20.1:24.1": "",
  "thag20.1:24.2": "",
  "thag20.1:24.3": "",
  "thag20.1:24.4": "",
  "thag20.1:25.1": "codito bhāvitattena ",
  "thag20.1:25.2": "sarīrantimadhārinā ",
  "thag20.1:25.3": "Migāramātu pāsādaṃ ",
  "thag20.1:25.4": "pādaṅguṭṭhena kampayiṃ. ",
  "thag20.1:26.1": "na yidaṃ sithilam ārabbha ",
  "thag20.1:26.2": "na yidaṃ appena thāmasā ",
  "thag20.1:26.3": "nibbānam adhigantabbaṃ ",
  "thag20.1:26.4": "sabbaganthapamocanaṃ. ",
  "thag20.1:27.1": "ayañ ca daharo bhikkhu, ",
  "thag20.1:27.2": "ayam uttamaporiso ",
  "thag20.1:27.3": "dhāreti antimaṃ dehaṃ ",
  "thag20.1:27.4": "jetvā Māraṃ savāhanaṃ. vivaram ",
  "thag20.1:28.1": "anupatanti vijjutā ",
  "thag20.1:28.2": "Vebhārassa ca Paṇḍavassa ca, ",
  "thag20.1:28.3": "nagavivaragato ca jhāyati ",
  "thag20.1:28.4": "putto appaṭimassa tādino. ",
  "thag20.1:29.1": "upasanto uparato ",
  "thag20.1:29.2": "pantasenāsano muni ",
  "thag20.1:29.3": "dāyādo buddhaseṭṭhassa ",
  "thag20.1:29.4": "Brahmunā abhivandito. ",
  "thag20.1:30.1": "upasantaṃ uparataṃ ",
  "thag20.1:30.2": "pantasenāsanaṃ muniṃ ",
  "thag20.1:30.3": "dāyādaṃ buddhaseṭṭhassa ",
  "thag20.1:30.4": "vanda brāhmaṇa Kassapaṃ. ",
  "thag20.1:31.1": "yo ca jātisataṃ gacche ",
  "thag20.1:31.2": "sabbā brāhmaṇajātiyo ",
  "thag20.1:31.3": "sotthiyo vedasampanno ",
  "thag20.1:31.4": "manussesu punappunaṃ, ",
  "thag20.1:32.1": "ajjhāyako pi ce assa ",
  "thag20.1:32.2": "tiṇṇaṃ vedāna pāragū, ",
  "thag20.1:32.3": "etassa vandanāy' ekaṃ ",
  "thag20.1:32.4": "kalaṃ n' agghati soḷasiṃ. ",
  "thag20.1:33.1": "yo so aṭṭha vimokkhāni ",
  "thag20.1:33.2": "purebhattaṃ apassayi ",
  "thag20.1:33.3": "anulomaṃ paṭilomaṃ, ",
  "thag20.1:33.4": "tato piṇḍāya gacchati: ",
  "thag20.1:34.1": "tādisaṃ bhikkhuṃ māhari, ",
  "thag20.1:34.2": "māttānaṃ khaṇi brāhmaṇa, ",
  "thag20.1:34.3": "abhippasādehi manaṃ ",
  "thag20.1:34.4": "arahantamhi tādine, ",
  "thag20.1:34.5": "khippaṃ pañjaliko vanda ",
  "thag20.1:34.6": "mā te vijaṭi matthakaṃ. ",
  "thag20.1:35.1": "na so passati saddhammaṃ ",
  "thag20.1:35.2": "saṃsārena purakkhato, ",
  "thag20.1:35.3": "acaṅkamaṃ jimhapathaṃ ",
  "thag20.1:35.4": "kumaggam anudhāvati. ",
  "thag20.1:36.1": "kimī va mīḷhasallitto ",
  "thag20.1:36.2": "saṃkhāre adhimucchito ",
  "thag20.1:36.3": "pagāḷho lābhasakkāre ",
  "thag20.1:36.4": "tuccho gacchati Poṭṭhilo. ",
  "thag20.1:37.1": "imañ ca passa āyantaṃ ",
  "thag20.1:37.2": "Sāriputtaṃ sudassanaṃ ",
  "thag20.1:37.3": "vimuttaṃ ubhatobhāge ",
  "thag20.1:37.4": "ajjhattaṃ susamāhitaṃ.' ",
  "thag20.1:38.1": "visallaṃ khīṇasaṃyogaṃ ",
  "thag20.1:38.2": "tevijjaṃ maccuhāyinaṃ ",
  "thag20.1:38.3": "dakkhiṇeyyaṃ manussānaṃ ",
  "thag20.1:38.4": "puññakhettam anuttaraṃ. ",
  "thag20.1:39.1": "ete sambahulā devā ",
  "thag20.1:39.2": "iddhimanto yasassino ",
  "thag20.1:39.3": "dasa devasahassāni ",
  "thag20.1:39.4": "sabbe brahmapurohitā ",
  "thag20.1:39.5": "Moggallānaṃ namassantā ",
  "thag20.1:39.6": "tiṭṭhantī pañjalīkatā: ",
  "thag20.1:40.1": "namo te purisājañña, ",
  "thag20.1:40.2": "namo te purisuttama, ",
  "thag20.1:40.3": "yassa te āsavā khīṇā, ",
  "thag20.1:40.4": "dakkhiṇeyyo 'si mārisa. ",
  "thag20.1:41.1": "pūjito naradevena ",
  "thag20.1:41.2": "uppanno maraṇābhibhū ",
  "thag20.1:41.3": "puṇḍarīkaṃ va toyena ",
  "thag20.1:41.4": "saṃkhāre nopalippati. ",
  "thag20.1:42.1": "yasse muhutte sahassadhā loko ",
  "thag20.1:42.2": "saṃvidito, sa Brahmakappo vasī ",
  "thag20.1:42.3": "iddhiguṇe cutūpapāte kāle ",
  "thag20.1:42.4": "passati devatā sa bhikkhu. ",
  "thag20.1:43.1": "Sāriputto va paññāya ",
  "thag20.1:43.2": "sīlena upasamena ca, ",
  "thag20.1:43.3": "yo pi pāraṃgato bhikkhu ",
  "thag20.1:43.4": "etāvaparamo siyā. ",
  "thag20.1:44.1": "koṭisatasahassassa ",
  "thag20.1:44.2": "attabhāvaṃ khaṇena nimmine, ",
  "thag20.1:44.3": "ahaṃ vikubbanāsu kusalo ",
  "thag20.1:44.4": "vasībhūto 'mhi iddhiyā. ",
  "thag20.1:45.1": "samādhivijjāvasi pāramīgato ",
  "thag20.1:45.2": "Moggallānagotto asitassa sāsane ",
  "thag20.1:45.3": "dhīro samucchindi samāhitindriyo ",
  "thag20.1:45.4": "nāgo yathā pūtilataṃ va bandhanaṃ. ",
  "thag20.1:46.1": "pariciṇṇo . . . (= 604,605) ",
  "thag20.1:46.2": "",
  "thag20.1:46.3": "",
  "thag20.1:46.4": "",
  "thag20.1:47.1": "",
  "thag20.1:47.2": "",
  "thag20.1:47.3": "",
  "thag20.1:47.4": "",
  "thag20.1:48.1": "kīdiso nirayo āsi ",
  "thag20.1:48.2": "yattha Dussī apaccatha ",
  "thag20.1:48.3": "Vidhuraṃ sāvakam āsajja ",
  "thag20.1:48.4": "Kakusandhañ ca brāhmaṇaṃ. ",
  "thag20.1:49.1": "satam āsi ayosaṅkū ",
  "thag20.1:49.2": "sabbe paccattavedanā: ",
  "thag20.1:49.3": "īdiso nirayo āsi ",
  "thag20.1:49.4": "yattha Dussī apaccatha ",
  "thag20.1:49.5": "Vidhuraṃ sāvakam āsajja ",
  "thag20.1:49.6": "Kakusandhañ ca brāhmaṇaṃ. ",
  "thag20.1:50.1": "yo etam abhijānāti ",
  "thag20.1:50.2": "bhikkhu buddhassa sāvako, ",
  "thag20.1:50.3": "tādisaṃ bhikkhum āsajja ",
  "thag20.1:50.4": "Kaṇha dukkhaṃ nigacchasi. ",
  "thag20.1:51.1": "majjhe sāgarasmiṃ tiṭṭhanti ",
  "thag20.1:51.2": "vimānā kappaṭṭhāyino ",
  "thag20.1:51.3": "veḷuriyavaṇṇā rucirā ",
  "thag20.1:51.4": "accimanto pabhassarā, ",
  "thag20.1:51.5": "accharā tattha naccanti ",
  "thag20.1:51.6": "puthū nānattavaṇṇiyo, ",
  "thag20.1:52.1": "yo etam abhi- ",
  "thag20.1:52.2": "--pa-- ",
  "thag20.1:52.3": "",
  "thag20.1:52.4": "Kaṇha dukkhaṃ nigacchasi. ",
  "thag20.1:53.1": "yo ve buddhena codito ",
  "thag20.1:53.2": "bhikkhusaṃghassa pekkhato ",
  "thag20.1:53.3": "Migāramātu pāsādaṃ ",
  "thag20.1:53.4": "pādaṅguṭṭhena kampayi, ",
  "thag20.1:54.1": "yo etam ",
  "thag20.1:54.2": "",
  "thag20.1:54.3": "",
  "thag20.1:54.4": "abhi- . . . ",
  "thag20.1:55.1": "yo Vejayantapāsādaṃ ",
  "thag20.1:55.2": "pādaṅguṭṭhena kampayi ",
  "thag20.1:55.3": "iddhibalen' upatthaddho ",
  "thag20.1:55.4": "saṃvejesi ca devatā, ",
  "thag20.1:56.1": "yo etam ",
  "thag20.1:56.2": "",
  "thag20.1:56.3": "",
  "thag20.1:56.4": "abhi- . . . ",
  "thag20.1:57.1": "yo Vejayantapāsāde ",
  "thag20.1:57.2": "Sakkaṃ so paripucchati: ",
  "thag20.1:57.3": "api āvuso jānāsi ",
  "thag20.1:57.4": "taṇhakkhayavimuttiyo;-- ",
  "thag20.1:57.5": "tassa Sakko viyākāsi ",
  "thag20.1:57.6": "pañhaṃ puṭṭho yathātathaṃ, ",
  "thag20.1:58.1": "yo etam ",
  "thag20.1:58.2": "",
  "thag20.1:58.3": "",
  "thag20.1:58.4": "abhi- . . . ",
  "thag20.1:59.1": "yo Brahmānaṃ paripucchati ",
  "thag20.1:59.2": "Sudhammāyaṃ abhitosabhaṃ: ",
  "thag20.1:59.3": "ajjāpi te āvuso sā diṭṭhi ",
  "thag20.1:59.4": "yā te diṭṭhi pure ahū; ",
  "thag20.1:59.5": "passasi vītivattantaṃ ",
  "thag20.1:59.6": "Brahmaloke pabhassaraṃ;-- ",
  "thag20.1:60.1": "tassa Brahmā viyākāsi ",
  "thag20.1:60.2": "pañhaṃ puṭṭho yathātathaṃ: ",
  "thag20.1:60.3": "na me mārisa sā diṭṭhi ",
  "thag20.1:60.4": "yā me diṭṭhi pure ahū; ",
  "thag20.1:61.1": "passāmi vītivattantaṃ ",
  "thag20.1:61.2": "Brahmaloke pabhassaraṃ; ",
  "thag20.1:61.3": "so 'ham ajja kathaṃ vajjaṃ: ",
  "thag20.1:61.4": "ahaṃ nicco 'mhi sassato;-- ",
  "thag20.1:62.1": "yo etam ",
  "thag20.1:62.2": "",
  "thag20.1:62.3": "",
  "thag20.1:62.4": "abhi- . . . ",
  "thag20.1:63.1": "yo Mahāneruno kūṭaṃ ",
  "thag20.1:63.2": "vimokkhena apassayi, ",
  "thag20.1:63.3": "vanaṃ Pubbavidehānaṃ ",
  "thag20.1:63.4": "ye ca bhūmisayā narā, -- ",
  "thag20.1:64.1": "yo etam ",
  "thag20.1:64.2": "",
  "thag20.1:64.3": "abhi- . . . ",
  "thag20.1:64.4": "",
  "thag20.1:65.1": "na ve aggi cetayati ",
  "thag20.1:65.2": "ahaṃ bālaṃ dahāmīti, ",
  "thag20.1:65.3": "bālo ca jalitam aggiṃ ",
  "thag20.1:65.4": "āsajja naṃ paḍayhati; ",
  "thag20.1:66.1": "evam eva tuvaṃ Māra ",
  "thag20.1:66.2": "āsajja naṃ tathāgataṃ ",
  "thag20.1:66.3": "sayaṃ dahissam attānaṃ ",
  "thag20.1:66.4": "bālo aggiṃ va samphusaṃ. ",
  "thag20.1:67.1": "apuññaṃ pasavī Māro ",
  "thag20.1:67.2": "āsajja naṃ tathāgataṃ; ",
  "thag20.1:67.3": "kiṃ nu maññasi pāpima ",
  "thag20.1:67.4": "na me pāpaṃ vipaccati. ",
  "thag20.1:68.1": "karato te miyyate pāpaṃ ",
  "thag20.1:68.2": "cirarattāya Antaka; ",
  "thag20.1:68.3": "Māra nibbinda buddhamhā, ",
  "thag20.1:68.4": "āsaṃ mā kāsi bhikkhusu. ",
  "thag20.1:69.1": "iti Māraṃ atajjesi ",
  "thag20.1:69.2": "bhikkhu Bhesakaḷāvane, ",
  "thag20.1:69.3": "tato so dummano yakkho ",
  "thag20.1:69.4": "tatth' ev' antaradhāyatīti. ",
  "thag20.1:69.5": "itthaṃ sudaṃ āyasmā Mahāmoggallāno thero gāthāyo abhāsitthā 'ti. ",
  "thag20.1:69.6": "",
  "thag20.1:70.0": "",
  "thag20.1:70.1": "Saṭṭhikamhi nipātamhi ",
  "thag20.1:70.2": "Moggallāno mahiddhiko ",
  "thag20.1:70.3": "eko 'va thero, gāthāyo ",
  "thag20.1:70.4": "aṭṭhasaṭṭhi bhavanti tā 'ti. "
}
