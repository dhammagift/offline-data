  "thag1.77:1.1": "Idaṃ pure cittam acāri cārikaṃ ",
  "thag1.77:1.2": "yen'-icchakaṃ yatthakāmaṃ yathāsukhaṃ; ",
  "thag1.77:1.3": "tad ajj' ahaṃ niggahissāmi yoniso ",
  "thag1.77:1.4": "hatthippabhinnaṃ viya aṅkusaggaho ",
  "thag1.77:1.5": "'ti. "
}
