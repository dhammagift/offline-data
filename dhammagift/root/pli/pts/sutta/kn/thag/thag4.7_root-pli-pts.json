  "thag4.7:0.1": "",
  "thag4.7:0.2": "",
  "thag4.7:0.3": "",
  "thag4.7:0.4": "",
  "thag4.7:1.1": "Yo dandhakāle tarati ",
  "thag4.7:1.2": "taraṇīye ca dandhaye, ",
  "thag4.7:1.3": "ayonisosaṃvidhānena ",
  "thag4.7:1.4": "bālo dukkhaṃ nigacchati, ",
  "thag4.7:2.1": "tass' atthā parihāyanti ",
  "thag4.7:2.2": "kālapakkhe va candimā, ",
  "thag4.7:2.3": "āyasakyañ ca pappoti ",
  "thag4.7:2.4": "mittehi ca virujjhatīti. ",
  "thag4.7:3.1": "yo dandhakāle dandheti ",
  "thag4.7:3.2": "taraṇīye ca tāraye, ",
  "thag4.7:3.3": "yonisosaṃ vidhānena ",
  "thag4.7:3.4": "sukhaṃ pappoti paṇḍito, ",
  "thag4.7:4.1": "tass' atthā paripūranti ",
  "thag4.7:4.2": "sukkapakkhe va candimā, ",
  "thag4.7:4.3": "yaso kittiñ ca pappoti, ",
  "thag4.7:4.4": "mittehi na virujjhatīti. ",
  "thag4.7:4.5": "Ubhayen' eva "
}
