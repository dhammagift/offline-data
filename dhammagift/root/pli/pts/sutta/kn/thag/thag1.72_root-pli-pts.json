  "thag1.72:1.1": "Yathā kalīro susu vaḍḍhitaggo ",
  "thag1.72:1.2": "dunnikkhamo hoti pasākhajāto, ",
  "thag1.72:1.3": "evaṃ ahaṃ bhariyāyānītāya; ",
  "thag1.72:1.4": "anumañña maṃ pabbajito 'mhi dānīti. ",
  "thag1.72:1.5": "Jiṇṇañ ca "
}
