  "thag1.120:0.3": "",
  "thag1.120:0.4": "",
  "thag1.120:1.1": "pariññātā ",
  "thag1.120:1.2": "tiṭṭhanti chinnamūlakā; ",
  "thag1.120:1.3": "dukkhakkhayo anuppatto, ",
  "thag1.120:1.4": "patto me āsavakkhayo 'ti. ",
  "thag1.120:1.5": "",
  "thag1.120:1.6": "Dvādasamo vaggo. tatr' uddānaṃ bhavati: ",
  "thag1.120:2.0": "",
  "thag1.120:2.1": "Jento ca Vacchagotto ca ",
  "thag1.120:2.2": "Vaccho ca Vanapavhayo ",
  "thag1.120:2.3": "Adhimutto Mahānāmo ",
  "thag1.120:2.4": "Pārāpariyo Yaso pi ca ",
  "thag1.120:2.5": "Kimbilo Vajjiputto ca ",
  "thag1.120:2.6": "Isidatto mahāyaso 'ti. | ",
  "thag1.120:2.7": "",
  "thag1.120:3.0": "",
  "thag1.120:3.1": "vīsuttarasataṃ therā ",
  "thag1.120:3.2": "katakiccā anāsavā ",
  "thag1.120:3.3": "Ekake 'va nipātamhi ",
  "thag1.120:3.4": "susaṃgītā mahesibhīti. | N' atthi "
}
