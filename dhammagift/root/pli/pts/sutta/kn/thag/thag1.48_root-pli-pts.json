  "thag1.48:1.1": "Yato ahaṃ pabbajito ",
  "thag1.48:1.2": "agārasmā anagāriyaṃ ",
  "thag1.48:1.3": "nābhijānāmi saṃkappaṃ ",
  "thag1.48:1.4": "anariyaṃ dosasaṃhitan ",
  "thag1.48:1.5": "ti. Vihavihābhinadite "
}
