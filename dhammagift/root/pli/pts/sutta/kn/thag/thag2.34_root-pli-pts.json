  "thag2.34:0.1": "",
  "thag2.34:0.2": "",
  "thag2.34:0.3": "",
  "thag2.34:0.4": "",
  "thag2.34:1.1": "Diṭṭhā mayā dhammadharā upāsakā ",
  "thag2.34:1.2": "kāmā aniccā iti bhāsamānā ",
  "thag2.34:1.3": "sārattarattā maṇikuṇḍalesu ",
  "thag2.34:1.4": "puttesu dāresu ca te apekkhā. ",
  "thag2.34:2.1": "addhā na jānanti yathā va dhammaṃ, ",
  "thag2.34:2.2": "kāmā aniccā iti cāpi āhu, ",
  "thag2.34:2.3": "rāgañ ca tesaṃ na bal' atthi chettuṃ, ",
  "thag2.34:2.4": "tasmā sitā puttadāraṃ dhanañ ",
  "thag2.34:2.5": "cā 'ti. "
}
