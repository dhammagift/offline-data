  "thag5.9:0.3": "",
  "thag5.9:0.4": "",
  "thag5.9:1.1": "Olaggessāmi te citta ",
  "thag5.9:1.2": "āṇidvāre va hatthinaṃ, ",
  "thag5.9:1.3": "na taṃ pāpe niyojessaṃ ",
  "thag5.9:1.4": "kāmajāla sarīraja. ",
  "thag5.9:2.1": "tvaṃ olaggo na gacchisi ",
  "thag5.9:2.2": "dvāravivaraṃ gajo va alabhanto, ",
  "thag5.9:2.3": "na ca cittakali punappunaṃ ",
  "thag5.9:2.4": "pasahan pāparato carissasi. ",
  "thag5.9:3.1": "yathā kuñjaraṃ adantaṃ ",
  "thag5.9:3.2": "navaggaham aṅkusaggaho ",
  "thag5.9:3.3": "balavā āvatteti akāmaṃ, ",
  "thag5.9:3.4": "evaṃ āvattayissan taṃ. ",
  "thag5.9:4.1": "yathā varahayadamakusalo ",
  "thag5.9:4.2": "sārathi pavaro dameti ājaññaṃ, ",
  "thag5.9:4.3": "evaṃ damayissan taṃ ",
  "thag5.9:4.4": "patiṭṭhito pañcasu balesu. ",
  "thag5.9:5.1": "satiyā taṃ nibandhissaṃ, ",
  "thag5.9:5.2": "payatatto vo damessāmi; ",
  "thag5.9:5.3": "viriyadhuraniggahīto ",
  "thag5.9:5.4": "na yito dūraṃ gamissase cittā ",
  "thag5.9:5.5": "'ti. "
}
