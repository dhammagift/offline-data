{
  "thag6.13:0.1": "",
  "thag6.13:0.2": "",
  "thag6.13:0.3": "",
  "thag6.13:0.4": "",
  "thag6.13:1.1": "",
  "thag6.13:1.2": "vivaṭaṃ nātivassati: ",
  "thag6.13:1.3": "tasmā channaṃ vivaretha, ",
  "thag6.13:1.4": "evan taṃ nātivassati. ",
  "thag6.13:2.1": "maccun' abbhāhato loko, ",
  "thag6.13:2.2": "jarāya parivārito, ",
  "thag6.13:2.3": "taṇhāsallena otiṇṇo, ",
  "thag6.13:2.4": "icchādhūpāyito sadā. ",
  "thag6.13:3.1": "maccun' abbhāhato loko ",
  "thag6.13:3.2": "parikkhitto jarāya ca, ",
  "thag6.13:3.3": "haññati niccam attāṇo ",
  "thag6.13:3.4": "pattadaṇḍo va takkaro. ",
  "thag6.13:4.1": "āgacchant' aggikhandhā va ",
  "thag6.13:4.2": "maccubyādhijarā tayo, ",
  "thag6.13:4.3": "paccuggantuṃ balaṃ n' atthi, ",
  "thag6.13:4.4": "javo n' atthi palāyituṃ. ",
  "thag6.13:5.1": "amoghaṃ divasaṃ kayirā ",
  "thag6.13:5.2": "appena bahukena vā; ",
  "thag6.13:5.3": "yaṃ yaṃ vijahate rattiṃ ",
  "thag6.13:5.4": "tadūnan tassa jīvitaṃ. ",
  "thag6.13:6.1": "carato tiṭṭhato vāpi ",
  "thag6.13:6.2": "āsīnasayanassa vā ",
  "thag6.13:6.3": "upeti carimā ratti, ",
  "thag6.13:6.4": "na te kālo pamajjitun ti. ",
  "thag6.13:6.5": "Dipādako 'yam "
}
