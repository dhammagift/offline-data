  "thag4.8:0.3": "",
  "thag4.8:0.4": "",
  "thag4.8:1.1": "sampanno ",
  "thag4.8:1.2": "Rāhulabhaddo 'ti maṃ vidu, ",
  "thag4.8:1.3": "yañ c' amhi putto buddhassa, ",
  "thag4.8:1.4": "yañ ca dhammesu cakkhumā, ",
  "thag4.8:2.1": "yañ ca me āsavā khīṇā, ",
  "thag4.8:2.2": "yañ ca n' atthi punabbhavo. ",
  "thag4.8:2.3": "arahā dakkhiṇeyyo 'mhi ",
  "thag4.8:2.4": "teyijjo amataddaso. ",
  "thag4.8:3.1": "kāmandhā jālasañchannā ",
  "thag4.8:3.2": "taṇhāchadanachāditā ",
  "thag4.8:3.3": "pamattabandhunā baddhā ",
  "thag4.8:3.4": "macchā va kumināmakhe. ",
  "thag4.8:4.1": "taṃ kāmam aham ujjhitvā ",
  "thag4.8:4.2": "chetvā Mārassa bandhanaṃ ",
  "thag4.8:4.3": "samūlaṃ taṇham abbuyha ",
  "thag4.8:4.4": "sītibhūto 'smi ",
  "thag4.8:4.5": "nibbuto 'ti. "
}
