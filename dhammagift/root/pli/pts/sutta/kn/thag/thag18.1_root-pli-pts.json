{
  "thag18.1:0.1": "",
  "thag18.1:0.2": "",
  "thag18.1:0.3": "",
  "thag18.1:0.4": "",
  "thag18.1:1.1": "Na gaṇena purakkhato care, ",
  "thag18.1:1.2": "vimano hoti, samādhi dullabho; ",
  "thag18.1:1.3": "nānājanasaṃgaho dukkho ",
  "thag18.1:1.4": "iti disvāna gaṇaṃ na rocaye. ",
  "thag18.1:2.1": "na kulāni upabbaje muni, ",
  "thag18.1:2.2": "vimano hoti, samādhi dullabho; ",
  "thag18.1:2.3": "so ussuko rasānugiddho ",
  "thag18.1:2.4": "atthaṃ riñcati yo sukhāvaho. ",
  "thag18.1:3.1": "paṅko 'ti hi naṃ avedayuṃ ",
  "thag18.1:3.2": "yāyaṃ vandanapūjanā kulesu, ",
  "thag18.1:3.3": "sukhumaṃ sallaṃ durubbahaṃ, ",
  "thag18.1:3.4": "sakkāro kāpurisena dujjaho. ",
  "thag18.1:4.1": "senāsanamhā oruyha ",
  "thag18.1:4.2": "nagaraṃ piṇḍāya pāvisiṃ, ",
  "thag18.1:4.3": "bhuñjantaṃ purisaṃ kuṭṭhiṃ ",
  "thag18.1:4.4": "sakkaccaṃ taṃ upaṭṭhahiṃ. ",
  "thag18.1:5.1": "so taṃ pakkena hattena ",
  "thag18.1:5.2": "ālopaṃ upanāmayi; ",
  "thag18.1:5.3": "ālopaṃ pakkhipantassa ",
  "thag18.1:5.4": "aṅgulī p' ettha chijjatha. ",
  "thag18.1:6.1": "kuḍḍamūlañ ca nissāya ",
  "thag18.1:6.2": "ālopan taṃ abhuñjisaṃ, ",
  "thag18.1:6.3": "bhuñjamāne ca bhutte vā ",
  "thag18.1:6.4": "jegucchaṃ me na vijjati. ",
  "thag18.1:7.1": "uttiṭṭhapiṇḍo āhāro ",
  "thag18.1:7.2": "pūtimuttañ ca osadhaṃ ",
  "thag18.1:7.3": "senāsanaṃ rukkhamūlaṃ ",
  "thag18.1:7.4": "paṃsukūlañ ca cīvaraṃ: ",
  "thag18.1:7.5": "yass' ete abhisambhutvā, ",
  "thag18.1:7.6": "sa ve cātuddiso naro. ",
  "thag18.1:8.1": "yattha eke vihaññanti ",
  "thag18.1:8.2": "āruhanto siluccayaṃ, ",
  "thag18.1:8.3": "tassa buddhassa dāyādo ",
  "thag18.1:8.4": "sampajāno patissato ",
  "thag18.1:8.5": "iddhibalen' upatthaddho ",
  "thag18.1:8.6": "Kassapo abhirūhati. ",
  "thag18.1:9.1": "piṇḍapātapaṭikkanto ",
  "thag18.1:9.2": "selam āruyha Kassapo ",
  "thag18.1:9.3": "jhāyati anupādāno ",
  "thag18.1:9.4": "pahīnabhayabheravo. ",
  "thag18.1:10.1": "piṇḍapātapaṭikkanto ",
  "thag18.1:10.2": "selam āruyha Kassapo ",
  "thag18.1:10.3": "jhāyati anupādāno ",
  "thag18.1:10.4": "ḍayhamānesu nibbuto. ",
  "thag18.1:11.1": "piṇḍapātapaṭikkanto ",
  "thag18.1:11.2": "selam āruyha Kassapo ",
  "thag18.1:11.3": "jhāyati anupādāno ",
  "thag18.1:11.4": "katakicco anāsavo. ",
  "thag18.1:12.1": "karerimālāvitatā ",
  "thag18.1:12.2": "bhūmibhāgā manoramā ",
  "thag18.1:12.3": "kuñjarābhirudā rammā ",
  "thag18.1:12.4": "te selā ramayanti maṃ. ",
  "thag18.1:13.1": "nīlabbhavaṇṇā rucirā ",
  "thag18.1:13.2": "vārisītā sucindharā ",
  "thag18.1:13.3": "indagopakasañchannā ",
  "thag18.1:13.4": "te selā ramayanti maṃ. ",
  "thag18.1:14.1": "nīlabbhakūṭasadisā ",
  "thag18.1:14.2": "kūṭāgāravarūpamā ",
  "thag18.1:14.3": "vāraṇābhirudā rammā ",
  "thag18.1:14.4": "te selā ramayanti maṃ. ",
  "thag18.1:15.1": "abhivuṭṭhā rammatalā ",
  "thag18.1:15.2": "nagā isibhi sevitā ",
  "thag18.1:15.3": "abbhunnaditā sikhīhi ",
  "thag18.1:15.4": "te selā ramayanti maṃ. ",
  "thag18.1:16.1": "alaṃ jhāyitukāmassa ",
  "thag18.1:16.2": "pahitattassa me sato; ",
  "thag18.1:16.3": "alaṃ me atthakāmassa ",
  "thag18.1:16.4": "pahitattassa bhikkhuno; ",
  "thag18.1:17.1": "alaṃ me phāsukāmassa ",
  "thag18.1:17.2": "pahitattassa bhikkhuno; ",
  "thag18.1:17.3": "alaṃ me yogakāmassa ",
  "thag18.1:17.4": "pahitattassa tādino. ",
  "thag18.1:18.1": "ummāpupphavasamānā ",
  "thag18.1:18.2": "gaganā v' abbhachāditā ",
  "thag18.1:18.3": "nānādijagaṇākiṇṇā ",
  "thag18.1:18.4": "te selā ramayanti maṃ. ",
  "thag18.1:19.1": "anākiṇṇā gahaṭṭhehi ",
  "thag18.1:19.2": "migasaṃghanisevitā ",
  "thag18.1:19.3": "nānādijagaṇākiṇṇā ",
  "thag18.1:19.4": "te selā ramayanti maṃ. ",
  "thag18.1:20.1": "acchodikā . . . (= 113,601) ",
  "thag18.1:20.2": "",
  "thag18.1:20.3": "",
  "thag18.1:20.4": "",
  "thag18.1:21.1": "na pañcaṅgikena turiyena ",
  "thag18.1:21.2": "rati me hoti tādisī ",
  "thag18.1:21.3": "yathā ekaggacittassa ",
  "thag18.1:21.4": "sammā dhammaṃ vipassato. ",
  "thag18.1:22.1": "kammaṃ bahukaṃ . . . (= 494) ",
  "thag18.1:22.2": "",
  "thag18.1:22.3": "",
  "thag18.1:22.4": "",
  "thag18.1:23.1": "kammaṃ bahukaṃ na kāraye, ",
  "thag18.1:23.2": "parivajjeyya anatthaneyyam etaṃ, ",
  "thag18.1:23.3": "kicchati kāyo kilamati, ",
  "thag18.1:23.4": "dukkhito so samathaṃ na vindati. ",
  "thag18.1:24.1": "oṭṭhapahatamattena ",
  "thag18.1:24.2": "attānaṃ pi na passati, ",
  "thag18.1:24.3": "patthaddhagīvo carati, ",
  "thag18.1:24.4": "ahaṃ seyyo 'ti maññati. ",
  "thag18.1:25.1": "aseyyo seyyasamānaṃ ",
  "thag18.1:25.2": "bālo maññati attānaṃ, ",
  "thag18.1:25.3": "na taṃ viññū pasaṃsanti ",
  "thag18.1:25.4": "patthaddhamanasaṃ naraṃ. ",
  "thag18.1:26.1": "yo ca seyyo 'ham asmīti, ",
  "thag18.1:26.2": "nāhaṃ seyyo 'ti vā puna, ",
  "thag18.1:26.3": "hīno 'haṃ sadiso vā ti ",
  "thag18.1:26.4": "vidhāsu na vikampati, ",
  "thag18.1:27.1": "paññavantaṃ tathāvādiṃ ",
  "thag18.1:27.2": "sīlesu susamāhitaṃ ",
  "thag18.1:27.3": "cetosamathasaṃyuttaṃ tañ ",
  "thag18.1:27.4": "ca viññū pasaṃsare. ",
  "thag18.1:28.1": "yassa sabrahmacārīsu ",
  "thag18.1:28.2": "gāravo n' ūpalabbhati, ",
  "thag18.1:28.3": "ārakā hoti saddhammā ",
  "thag18.1:28.4": "nabhaso puthavī yathā. ",
  "thag18.1:29.1": "yesañ ca hiriottappaṃ ",
  "thag18.1:29.2": "sadā sammā upaṭṭhitaṃ, ",
  "thag18.1:29.3": "virūḷhabrahmacariyā, ",
  "thag18.1:29.4": "tesaṃ khīṇā punabbhavā. ",
  "thag18.1:30.1": "uddhato capalo bhikkhu ",
  "thag18.1:30.2": "paṃsukūlena pāruto ",
  "thag18.1:30.3": "kapi va sīhacammena ",
  "thag18.1:30.4": "na so ten' upasobhati. ",
  "thag18.1:31.1": "anuddhato acapalo ",
  "thag18.1:31.2": "nipako saṃvutindriyo ",
  "thag18.1:31.3": "sobhati paṃsukūlena ",
  "thag18.1:31.4": "sīho va girigabbhare. ",
  "thag18.1:32.1": "ete sambahulā devā ",
  "thag18.1:32.2": "iddhimanto yasassino ",
  "thag18.1:32.3": "dasa devasahassāni ",
  "thag18.1:32.4": "sabbe te brahmakāyikā ",
  "thag18.1:33.1": "dhammasenāpatiṃ dhīraṃ ",
  "thag18.1:33.2": "mahājhāyiṃ samāhitaṃ ",
  "thag18.1:33.3": "Sāriputtaṃ namassantā ",
  "thag18.1:33.4": "tiṭṭhantī pañjalīkatā: ",
  "thag18.1:34.1": "namo te purisājañña, ",
  "thag18.1:34.2": "namo te purisuttama, ",
  "thag18.1:34.3": "yassa te nāhijānāma ",
  "thag18.1:34.4": "yaṃ pi nissāya jhāyati. ",
  "thag18.1:35.1": "accheraṃ vata buddhānaṃ ",
  "thag18.1:35.2": "gambhīro gocaro sako, ",
  "thag18.1:35.3": "ye mayaṃ nābhijānāma ",
  "thag18.1:35.4": "vālavedhī samāgatā. ",
  "thag18.1:36.1": "taṃ tathā devakāyehi ",
  "thag18.1:36.2": "pūjitaṃ pūjanārahaṃ ",
  "thag18.1:36.3": "Sāriputtaṃ tadā disvā ",
  "thag18.1:36.4": "Kappinassa sitaṃ ahū. ",
  "thag18.1:37.1": "yāvatā buddhakhettamhi ",
  "thag18.1:37.2": "ṭhapayitvā mahāmuniṃ ",
  "thag18.1:37.3": "dhutaguṇe visiṭṭho 'haṃ, ",
  "thag18.1:37.4": "sadiso me na vijjati. ",
  "thag18.1:38.1": "pariciṇṇo mayā satthā ",
  "thag18.1:38.2": "--pa--. ",
  "thag18.1:38.3": "",
  "thag18.1:38.4": "",
  "thag18.1:39.1": "na cīvare na sayane ",
  "thag18.1:39.2": "bhojane n' upalippati ",
  "thag18.1:39.3": "Gotamo anappameyyo ",
  "thag18.1:39.4": "maḷālipupphaṃ vimalaṃ va ",
  "thag18.1:39.5": "ambunā nikkhammaninno ",
  "thag18.1:39.6": "tibhavābhinissaṭo. ",
  "thag18.1:40.1": "satipaṭṭhānagīvo so ",
  "thag18.1:40.2": "saddhāhattho mahāmuni ",
  "thag18.1:40.3": "paññāsīso mahāñāṇī ",
  "thag18.1:40.4": "sadā carati nibbuto 'ti. ",
  "thag18.1:40.5": "",
  "thag18.1:40.6": "",
  "thag18.1:41.0": "",
  "thag18.1:41.1": "Cattālīsanipātamhi ",
  "thag18.1:41.2": "Mahākassapasvhayo ",
  "thag18.1:41.3": "eko 'va thero, gāthāyo ",
  "thag18.1:41.4": "cattālīsa duve 'pi cā 'ti. Cattālīsanipāto samatto. "
}
