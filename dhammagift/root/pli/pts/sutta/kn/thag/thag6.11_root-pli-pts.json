{
  "thag6.11:0.1": "",
  "thag6.11:0.2": "",
  "thag6.11:0.3": "",
  "thag6.11:0.4": "",
  "thag6.11:1.1": "Vātarogābhinīto tvaṃ ",
  "thag6.11:1.2": "viharaṃ kānane vane ",
  "thag6.11:1.3": "paviddhagocare lūkhe ",
  "thag6.11:1.4": "kathaṃ bhikkhu karissasi. ",
  "thag6.11:2.1": "pūtisukhena vipulena ",
  "thag6.11:2.2": "pharitvāna samussayaṃ ",
  "thag6.11:2.3": "lūkham pi abhisambhonto ",
  "thag6.11:2.4": "viharissāmi kānane. ",
  "thag6.11:3.1": "bhāvento satta bojjhaṅge ",
  "thag6.11:3.2": "indriyāni balāni ca ",
  "thag6.11:3.3": "jhānasokhummasamupanno ",
  "thag6.11:3.4": "viharissaṃ anāsavo. ",
  "thag6.11:4.1": "vippamuttaṃ kilesehi ",
  "thag6.11:4.2": "suddhacittaṃ anāvilaṃ ",
  "thag6.11:4.3": "abhiṇhaṃ paccavekkhanto ",
  "thag6.11:4.4": "viharissaṃ anāsavo. ",
  "thag6.11:5.1": "ajjhattañ ca bahiddhā ca ",
  "thag6.11:5.2": "ye me vijjiṃsu āsavā ",
  "thag6.11:5.3": "sabbe asesā ucchinnā ",
  "thag6.11:5.4": "na ca uppajjare puna. ",
  "thag6.11:6.1": "pañca kkhandhā pariññātā ",
  "thag6.11:6.2": "tiṭṭhanti chinnamūlakā, ",
  "thag6.11:6.3": "dukkhakkhayo anuppatto, ",
  "thag6.11:6.4": "n' atthi dāni punabbhavo ",
  "thag6.11:6.5": "'ti. "
}
