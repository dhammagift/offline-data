  "thag1.10:0.3": "",
  "thag1.10:0.4": "",
  "thag1.10:1.1": "Vihari apekkhaṃ idha vā huraṃ vā ",
  "thag1.10:1.2": "yo vedagū samito yatatto ",
  "thag1.10:1.3": "sabbesu dhammesu anupalitto ",
  "thag1.10:1.4": "lokassa jaññā udayabbayañ cā 'ti. ",
  "thag1.10:1.5": "",
  "thag1.10:1.6": "",
  "thag1.10:2.0": "",
  "thag1.10:2.1": "Subhūti Koṭṭhiko thero ",
  "thag1.10:2.2": "Kaṅkhārevatasubbato ",
  "thag1.10:2.3": "Mantāniputto Dabbo ca ",
  "thag1.10:2.4": "Sītavaniyo ca Bhalliyo ",
  "thag1.10:2.5": "Vīro Pilindavaccho ca ",
  "thag1.10:2.6": "Puṇṇamāso tamonudo 'ti. | Pāmujjabahulo "
}
