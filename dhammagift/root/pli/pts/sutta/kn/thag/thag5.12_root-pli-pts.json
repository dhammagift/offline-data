{
  "thag5.12:0.1": "",
  "thag5.12:0.2": "",
  "thag5.12:0.3": "",
  "thag5.12:0.4": "",
  "thag5.12:1.1": "Yo ve garūnaṃ vacanaññu dhīro ",
  "thag5.12:1.2": "vase ca tamhi janayetha pemaṃ, ",
  "thag5.12:1.3": "so bhattimā nāma ca hoti paṇḍito ",
  "thag5.12:1.4": "ñatvā ca dhammesu visesi assa. ",
  "thag5.12:2.1": "yaṃ āpadā uppatitā uḷārā ",
  "thag5.12:2.2": "na kkhambhayante paṭisaṃkhayantaṃ, ",
  "thag5.12:2.3": "so thāmavā nāma ca hoti paṇḍito ",
  "thag5.12:2.4": "ñatvā ca dhammesu visesi assa. ",
  "thag5.12:3.1": "yo ve samuddo va ṭhito anejo ",
  "thag5.12:3.2": "gambhīrapañño nipuṇatthadassī, ",
  "thag5.12:3.3": "asaṃhāriyo nāma ca hoti . . . ",
  "thag5.12:3.4": "",
  "thag5.12:4.1": "bahussuto dhammadharo ca hoti, ",
  "thag5.12:4.2": "dhammassa hoti anudhammacārī, ",
  "thag5.12:4.3": "so tādiso nāma ca hoti . . . atthañ ",
  "thag5.12:4.4": "ca ",
  "thag5.12:5.1": "yo jānāti bhāsitassa ",
  "thag5.12:5.2": "atthañ ca ñatvāna tathā karoti, ",
  "thag5.12:5.3": "atthantaro nāma sa hoti paṇḍito ",
  "thag5.12:5.4": "ñatvā ca dhammesu visesi assā 'ti. ",
  "thag5.12:5.5": "",
  "thag5.12:5.6": "",
  "thag5.12:6.0": "",
  "thag5.12:6.1": "Rājadatto Subhūto ca ",
  "thag5.12:6.2": "Girimānanda-Sumano ",
  "thag5.12:6.3": "Vaḍḍho ca Kassapo thero ",
  "thag5.12:6.4": "Gayākassapa-Vakkali | ",
  "thag5.12:7.1": "Vijito Yasadatto ca ",
  "thag5.12:7.2": "Soṇo Kosiyasavhayo: ",
  "thag5.12:7.3": "saṭṭhi ca pañcagāthāyo, ",
  "thag5.12:7.4": "therā ca ettha dvādasā 'ti. "
}
