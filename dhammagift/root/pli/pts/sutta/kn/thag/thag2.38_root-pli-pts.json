  "thag2.38:0.3": "",
  "thag2.38:0.4": "",
  "thag2.38:1.1": "Pañca kāmaguṇe hitvā ",
  "thag2.38:1.2": "piyarūpe manorame ",
  "thag2.38:1.3": "saddhāya abhinikkhamma ",
  "thag2.38:1.4": "dukkhass' antakaro bhave. ",
  "thag2.38:2.1": "nābhinandāmi maraṇaṃ ",
  "thag2.38:2.2": "nābhinandāmi jīvitaṃ ",
  "thag2.38:2.3": "kālañ ca paṭikaṅkhāmi ",
  "thag2.38:2.4": "sampajāno patissato ",
  "thag2.38:2.5": "'ti. Ambapallavasaṃkāsaṃ "
}
