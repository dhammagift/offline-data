  "thag1.87:1.1": "Khandhā diṭṭhā yathābhūtaṃ, ",
  "thag1.87:1.2": "bhavā sabbe padālitā, ",
  "thag1.87:1.3": "vikkhīṇo jātisaṃsāro, ",
  "thag1.87:1.4": "n' atthi dāni punabbhavo ",
  "thag1.87:1.5": "'ti. "
}
