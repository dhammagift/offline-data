  "thag2.18:0.4": "",
  "thag2.18:1.1": "Pācīnavaṃsadāyamhi ",
  "thag2.18:1.2": "Sakyaputtā sahāyakā ",
  "thag2.18:1.3": "pahāy' anappake bhoge ",
  "thag2.18:1.4": "uñchāpattāgate ratā ",
  "thag2.18:2.1": "āraddhaviriyā pahitattā ",
  "thag2.18:2.2": "niccaṃ daḷhaparakkamā ",
  "thag2.18:2.3": "ramanti dhammaratiyā ",
  "thag2.18:2.4": "hitvāna lokikaṃ ratin ",
  "thag2.18:2.5": "ti. Ayonisomanasīkārā "
}
