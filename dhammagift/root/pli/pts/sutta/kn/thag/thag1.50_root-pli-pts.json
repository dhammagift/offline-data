  "thag1.50:0.3": "",
  "thag1.50:0.4": "",
  "thag1.50:1.1": "Dharaṇī ca siccati vāti ",
  "thag1.50:1.2": "māluto vijjutā carati nabhe, ",
  "thag1.50:1.3": "upasammanti vitakkā, ",
  "thag1.50:1.4": "cittaṃ susamāhitaṃ mamā 'ti. ",
  "thag1.50:1.5": "",
  "thag1.50:1.6": "",
  "thag1.50:2.0": "",
  "thag1.50:2.1": "Sirivaḍḍho Revato thero ",
  "thag1.50:2.2": "Sumaṅgalo Sānusavhayo ",
  "thag1.50:2.3": "Ramaṇīyavihārī ca ",
  "thag1.50:2.4": "Samiddh' -Ujjaya-Sañjayo ",
  "thag1.50:2.5": "Rāmaṇeyyo ca so thero ",
  "thag1.50:2.6": "Vimalo ca raṇañjayo 'ti. "
}
