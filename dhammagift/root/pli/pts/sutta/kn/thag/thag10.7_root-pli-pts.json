{
  "thag10.7:0.1": "",
  "thag10.7:0.2": "",
  "thag10.7:0.3": "",
  "thag10.7:0.4": "",
  "thag10.7:1.1": "Vijāneyya sakaṃ atthaṃ, ",
  "thag10.7:1.2": "avalokeyyātha pāvacanaṃ, ",
  "thag10.7:1.3": "yañ c' ettha assa paṭirūpaṃ ",
  "thag10.7:1.4": "sāmaññaṃ ajjhupagatassa. ",
  "thag10.7:2.1": "mittaṃ idha kalyāṇaṃ ",
  "thag10.7:2.2": "sikkhāvipulaṃ samādānaṃ ",
  "thag10.7:2.3": "sussūsā ca garūnaṃ: ",
  "thag10.7:2.4": "etaṃ samaṇassa paṭirūpaṃ. ",
  "thag10.7:3.1": "buddhesu sagāravatā ",
  "thag10.7:3.2": "dhamme apaciti yathābhūtaṃ ",
  "thag10.7:3.3": "saṃghe ca cittikāro: ",
  "thag10.7:3.4": "etaṃ samaṇassa paṭirūpaṃ. ",
  "thag10.7:4.1": "ācāragocare yutto ",
  "thag10.7:4.2": "ājīvo sodhito agārayho ",
  "thag10.7:4.3": "cittassa saṇṭhapanaṃ: ",
  "thag10.7:4.4": "etaṃ samaṇassa paṭirūpaṃ. ",
  "thag10.7:5.1": "cārittaṃ atha vārittaṃ ",
  "thag10.7:5.2": "iriyāpathiyaṃ pasādaniyaṃ ",
  "thag10.7:5.3": "adhicitte ca āyogo: ",
  "thag10.7:5.4": "etaṃ . . . ",
  "thag10.7:6.1": "āraññakāni senāsanāni ",
  "thag10.7:6.2": "pantāni appasaddāni ",
  "thag10.7:6.3": "bhajitabbāni muninā: ",
  "thag10.7:6.4": "etaṃ . . . ",
  "thag10.7:7.1": "sīlañ ca bāhusaccañ ca ",
  "thag10.7:7.2": "dhammānaṃ pavicayo yathābhūtaṃ ",
  "thag10.7:7.3": "saccānaṃ abhisamayo: ",
  "thag10.7:7.4": "etaṃ . . . ",
  "thag10.7:8.1": "bhāveyya aniccan ti ",
  "thag10.7:8.2": "anattasaññaṃ asubhasaññañ ca ",
  "thag10.7:8.3": "lokamhi ca anabhiratiṃ: ",
  "thag10.7:8.4": "etaṃ . . . ",
  "thag10.7:9.1": "bhāveyya ca bojjhaṅge ",
  "thag10.7:9.2": "iddhipādāni indriyabalāni ",
  "thag10.7:9.3": "aṭṭhaṅgamaggam ariyaṃ: ",
  "thag10.7:9.4": "etaṃ . . . ",
  "thag10.7:10.1": "taṇhaṃ pajaheyya munī, ",
  "thag10.7:10.2": "samūlake āsave padāleyya, ",
  "thag10.7:10.3": "vihareyya vimutto: ",
  "thag10.7:10.4": "etaṃ samaṇassa paṭirūpan ti. ",
  "thag10.7:10.5": "",
  "thag10.7:10.6": "",
  "thag10.7:11.0": "",
  "thag10.7:11.1": "Kāḷudāyī ca so thero ",
  "thag10.7:11.2": "Ekavihārī ca Kappino ",
  "thag10.7:11.3": "Cūḷapanthako Kappo ca ",
  "thag10.7:11.4": "Upaseno ca Gotamo ",
  "thag10.7:11.5": "satt' ime Dasake therā, ",
  "thag10.7:11.6": "gāthāyo c' ettha sattatīti. Dasanipāto niṭṭhito. Kin tav' attho "
}
