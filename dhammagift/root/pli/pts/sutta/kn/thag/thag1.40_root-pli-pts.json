  "thag1.40:0.3": "",
  "thag1.40:0.4": "",
  "thag1.40:1.1": "Sattiyā viya omaṭṭho ",
  "thag1.40:1.2": "ḍayhamāne va matthake ",
  "thag1.40:1.3": "bhavarāgapahānāya ",
  "thag1.40:1.4": "satto bhikkhu paribbaje 'ti. ",
  "thag1.40:1.5": "",
  "thag1.40:1.6": "",
  "thag1.40:2.0": "",
  "thag1.40:2.1": "Gahvaratīriyo Suppiyo ",
  "thag1.40:2.2": "Sopāko ca Posiyo ca ",
  "thag1.40:2.3": "Sāmaññakāni Kumāputto ",
  "thag1.40:2.4": "Kumāputtasahāyako ",
  "thag1.40:2.5": "Gavampati Tissatthero ",
  "thag1.40:2.6": "Vaḍḍhamāno mahāyaso 'ti. Vivaram anupatanti "
}
