{
  "thag7.5:0.1": "",
  "thag7.5:0.2": "",
  "thag7.5:0.3": "",
  "thag7.5:0.4": "",
  "thag7.5:1.1": "Sare hatthehi bhañjitvā ",
  "thag7.5:1.2": "katvāna kuṭim acchisaṃ, ",
  "thag7.5:1.3": "tena me Sarabhaṅgo 'ti ",
  "thag7.5:1.4": "nāmaṃ sammutiyā ahū. ",
  "thag7.5:2.1": "na mayhaṃ kappate ajja ",
  "thag7.5:2.2": "sare hatthehi bhañjituṃ, ",
  "thag7.5:2.3": "sikkhāpadā no paññattā ",
  "thag7.5:2.4": "Gotamena yasassinā. ",
  "thag7.5:3.1": "sakalaṃ samattaṃ rogaṃ ",
  "thag7.5:3.2": "Sarabhaṅgo nāddasaṃ pubbe, ",
  "thag7.5:3.3": "so 'yaṃ rogo diṭṭho ",
  "thag7.5:3.4": "vacanakarenātidevassa. ",
  "thag7.5:4.1": "yen' eva maggena gato Vipassī ",
  "thag7.5:4.2": "yen' eva maggena Sikhī ca Vessabhū ",
  "thag7.5:4.3": "Kakusandhakoṇāgamano ca Kassapo ",
  "thag7.5:4.4": "ten' añjasena agamāsi Gotamo. ",
  "thag7.5:5.1": "vītataṇhā anādānā ",
  "thag7.5:5.2": "satta buddhā khayogadhā, ",
  "thag7.5:5.3": "yeh' ayaṃ desito dhammo ",
  "thag7.5:5.4": "dhamabhūtehi tādihi ",
  "thag7.5:6.1": "cattāri ariyasaccāni ",
  "thag7.5:6.2": "anukampāya pāṇinaṃ, ",
  "thag7.5:6.3": "dukkhaṃ samudayo maggo ",
  "thag7.5:6.4": "nirodho dukkhasaṃkhayo. ",
  "thag7.5:7.1": "yasmiṃ nibbattate dukkhaṃ ",
  "thag7.5:7.2": "saṃsārasmiṃ anantakaṃ ",
  "thag7.5:7.3": "bhedā imassa kāyassa ",
  "thag7.5:7.4": "jīvitassa ca saṃkhayā ",
  "thag7.5:7.5": "añño punabbavo n' atthi, ",
  "thag7.5:7.6": "suvimutto 'mhi sabbadhīti. ",
  "thag7.5:7.7": "",
  "thag7.5:7.8": "",
  "thag7.5:8.0": "",
  "thag7.5:8.1": "Sundarasamuddo thero ",
  "thag7.5:8.2": "thero Lakuṇṭabhaddiyo ",
  "thag7.5:8.3": "Bhaddo thero ca Sopāko ",
  "thag7.5:8.4": "Sarabhaṅgo mahā isi: ",
  "thag7.5:8.5": "Sattake pañcakā therā, ",
  "thag7.5:8.6": "gāthāyo pañcatiṃsatīti. "
}
