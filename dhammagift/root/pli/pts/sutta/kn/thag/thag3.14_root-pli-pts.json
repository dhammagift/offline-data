{
  "thag3.14:0.1": "",
  "thag3.14:0.2": "",
  "thag3.14:0.3": "",
  "thag3.14:0.4": "",
  "thag3.14:1.1": "Saṃsaraṃ hi nirayaṃ agacchisaṃ, ",
  "thag3.14:1.2": "petalokam agamaṃ punappunaṃ, ",
  "thag3.14:1.3": "dukkhamamhi pi tiracchānayoniyā ",
  "thag3.14:1.4": "nekadhā hi vusitaṃ ciraṃ mayā. ",
  "thag3.14:2.1": "mānuso pi ca bhavo 'bhirādhito, ",
  "thag3.14:2.2": "saggakāyam agamaṃ sakiṃ sakiṃ, ",
  "thag3.14:2.3": "rūpadhātusu arūpadhātusu ",
  "thag3.14:2.4": "n' evasaññisu asaññisu ṭṭhitaṃ. ",
  "thag3.14:3.1": "sambhavā suviditā asārakā ",
  "thag3.14:3.2": "saṃkhatā pacalitā sad' eritā; ",
  "thag3.14:3.3": "taṃ viditvā maham attasambhavaṃ ",
  "thag3.14:3.4": "santim eva satimā samajjhagan ",
  "thag3.14:3.5": "ti. "
}
