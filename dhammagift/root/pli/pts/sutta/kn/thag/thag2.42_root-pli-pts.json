  "thag2.42:0.4": "",
  "thag2.42:1.1": "Yo have daharo bhikkhu ",
  "thag2.42:1.2": "yañjati buddhasāsane, ",
  "thag2.42:1.3": "jāgaro patisuttesu, amoghan ",
  "thag2.42:1.4": "tassa jīvitaṃ. ",
  "thag2.42:2.1": "tasmā saddhañ ca sīlañ ca ",
  "thag2.42:2.2": "pasādaṃ dhammadassanaṃ ",
  "thag2.42:2.3": "anuyuñjetha medhāvī ",
  "thag2.42:2.4": "saraṃ buddhāna sāsanan ti. ",
  "thag2.42:2.5": "Kass' indriyāni samathaṃ gatāni "
}
