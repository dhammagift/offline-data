{
  "thag2.16:0.1": "",
  "thag2.16:0.2": "",
  "thag2.16:0.3": "",
  "thag2.16:0.4": "",
  "thag2.16:1.1": "Kāḷī itthi brahatī dhaṅkarūpā ",
  "thag2.16:1.2": "satthiñ ca bhetvā aparañ ca satthiñ ",
  "thag2.16:1.3": "bāhañ ca bhetvā aparañ ca bāhuṃ ",
  "thag2.16:1.4": "sīsañ ca bhetvā dadhithālakaṃ va ",
  "thag2.16:1.5": "esā nisinnā abhisaddahitvā. ",
  "thag2.16:2.1": "yo ve avidvā upadhiṃ karoti ",
  "thag2.16:2.2": "punappunaṃ dukkham upeti mando. ",
  "thag2.16:2.3": "tasmā pajānaṃ upadhiṃ na kayirā ",
  "thag2.16:2.4": "māhaṃ puna bhinnasiro sayissan ",
  "thag2.16:2.5": "ti. "
}
