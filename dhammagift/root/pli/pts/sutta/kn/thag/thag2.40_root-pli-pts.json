  "thag2.40:0.3": "",
  "thag2.40:0.4": "",
  "thag2.40:1.1": "kappaṭo Kappaṭakuro. ",
  "thag2.40:1.2": "acchāya atibharitāya ",
  "thag2.40:1.3": "amataghaṭikāyaṃ dhammakatamatto, ",
  "thag2.40:1.4": "katapadaṃ jhānāni ocetuṃ. ",
  "thag2.40:2.1": "mā kho tvaṃ Kappaṭa pacālesi ",
  "thag2.40:2.2": "mā taṃ upakaṇṇakamhi tāḷessaṃ; ",
  "thag2.40:2.3": "na ha tvaṃ Kappaṭa mattam aññāsi ",
  "thag2.40:2.4": "saṃghamajjhamhi pacalāyamāno 'ti. ",
  "thag2.40:2.5": "",
  "thag2.40:2.6": "",
  "thag2.40:3.0": "",
  "thag2.40:3.1": "Migasiro Sivako ca ",
  "thag2.40:3.2": "Upavāno ca paṇḍito ",
  "thag2.40:3.3": "Isidinno ca Kaccāno ",
  "thag2.40:3.4": "Khitako ca mahāvasī ",
  "thag2.40:3.5": "Poṭiriyaputto Nisabho ",
  "thag2.40:3.6": "Usabho Kappaṭakuro 'ti. "
}
