{
  "thag6.14:0.1": "",
  "thag6.14:0.2": "",
  "thag6.14:0.3": "",
  "thag6.14:0.4": "",
  "thag6.14:1.1": "asuci ",
  "thag6.14:1.2": "duggandho parihīrati ",
  "thag6.14:1.3": "nānākuṇapaparipūro ",
  "thag6.14:1.4": "vissavanto tato tato. ",
  "thag6.14:2.1": "migaṃ nilīnaṃ kūṭena ",
  "thag6.14:2.2": "baliseneva ambujaṃ ",
  "thag6.14:2.3": "vānaraṃ viya lepena ",
  "thag6.14:2.4": "bādhayanti puthujjanaṃ ",
  "thag6.14:3.1": "rūpā saddā rasā gandhā ",
  "thag6.14:3.2": "phoṭṭhabbā ca manoramā: ",
  "thag6.14:3.3": "pañca kāmaguṇā ete ",
  "thag6.14:3.4": "itthirūpasmiṃ dissare. ",
  "thag6.14:4.1": "ye etā upasevanti ",
  "thag6.14:4.2": "rattacittā puthujjanā, ",
  "thag6.14:4.3": "vaḍḍhenti kaṭasiṃ ghoraṃ ",
  "thag6.14:4.4": "ācinanti punabbhavaṃ. ",
  "thag6.14:5.1": "yo vetā parivajjeti ",
  "thag6.14:5.2": "sappasseva padā siro, ",
  "thag6.14:5.3": "so 'maṃ visattikaṃ loke ",
  "thag6.14:5.4": "sato samativattati. ",
  "thag6.14:6.1": "kāmesv ādīnavaṃ disvā ",
  "thag6.14:6.2": "nekkhammaṃ daṭṭhu khemato ",
  "thag6.14:6.3": "nissaṭo sabbakāmehi, ",
  "thag6.14:6.4": "patto me āsavakkhayo 'ti. ",
  "thag6.14:6.5": "",
  "thag6.14:6.6": "",
  "thag6.14:7.0": "",
  "thag6.14:7.1": "Uruveḷakassapo ca ",
  "thag6.14:7.2": "thero Tekicchakāni ca ",
  "thag6.14:7.3": "Mahānāgo ca Kullo ca ",
  "thag6.14:7.4": "Māluto Sappadāsako | ",
  "thag6.14:7.5": "Kātiyāno ca Migajālo ",
  "thag6.14:7.6": "Jento Sumanasavhayo ",
  "thag6.14:7.7": "Nhātamuni Brahmadatto ",
  "thag6.14:7.8": "Sirimaṇḍo Sabbakāmako. ",
  "thag6.14:7.9": "gāthāyo caturāsīti, ",
  "thag6.14:7.10": "therā c' ettha catuddasā 'ti. Chanipāto niṭṭhito. Alaṃkatā "
}
