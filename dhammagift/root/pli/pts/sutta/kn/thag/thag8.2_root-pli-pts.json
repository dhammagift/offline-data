{
  "thag8.2:0.1": "",
  "thag8.2:0.2": "",
  "thag8.2:0.3": "",
  "thag8.2:0.4": "",
  "thag8.2:1.1": "",
  "thag8.2:1.2": "amāyo rittapesuṇo ",
  "thag8.2:1.3": "sa ve tādisako bhikkhu ",
  "thag8.2:1.4": "evaṃ pecca na socati. ",
  "thag8.2:2.1": "akkodhano anupanāhī ",
  "thag8.2:2.2": "amāyo rittapesuṇo ",
  "thag8.2:2.3": "guttadvāro sadā bhikkhu ",
  "thag8.2:2.4": "evaṃ pecca na socati. ",
  "thag8.2:3.1": "akkodhano . . . ",
  "thag8.2:3.2": "",
  "thag8.2:3.3": "kalyāṇasīlo yo bhikkhu ",
  "thag8.2:3.4": "evaṃ pecca na socati. ",
  "thag8.2:4.1": "akkodhano . . . ",
  "thag8.2:4.2": "",
  "thag8.2:4.3": "kalyāṇamitto yo bhikkhu ",
  "thag8.2:4.4": "evaṃ pecca na socati. ",
  "thag8.2:5.1": "akkodhano . . . ",
  "thag8.2:5.2": "",
  "thag8.2:5.3": "kalyāṇapañño yo bhikkhu ",
  "thag8.2:5.4": "evaṃ pecca na socati. ",
  "thag8.2:6.1": "yassa saddhā tathāgate ",
  "thag8.2:6.2": "acalā supatiṭṭhitā, ",
  "thag8.2:6.3": "sīlañ ca yassa kalyāṇaṃ ",
  "thag8.2:6.4": "ariyakantaṃ pasaṃsitaṃ, ",
  "thag8.2:7.1": "saṃghe pasādo yass' atthi ",
  "thag8.2:7.2": "ujubhūtañ ca dassanaṃ, ",
  "thag8.2:7.3": "adaḷiddo 'ti taṃ āhu, ",
  "thag8.2:7.4": "amoghan tassa jīvitaṃ. ",
  "thag8.2:8.1": "tasmā saddhañ ca sīlañ ca ",
  "thag8.2:8.2": "pasādaṃ dhammadassanaṃ ",
  "thag8.2:8.3": "anuyuñjetha medhāvī ",
  "thag8.2:8.4": "saraṃ buddhāna sāsanan ",
  "thag8.2:8.5": "ti. "
}
