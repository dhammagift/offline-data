  "cp18:1.1": "Punāparaṃ yadā homi ",
  "cp18:1.2": "mahesakkho mah' iddhiko ",
  "cp18:1.3": "Dhammo nāma mahāyakkho ",
  "cp18:1.4": "sabbalokānukampako, ",
  "cp18:2.1": "Dasakusalakammapathe ",
  "cp18:2.2": "samādapento mahājanaṃ ",
  "cp18:2.3": "carāmi gāmanigamaṃ ",
  "cp18:2.4": "samitto saparijjano. ",
  "cp18:3.1": "Papo kadariyo yakkho ",
  "cp18:3.2": "dīpento dasapāpake ",
  "cp18:3.3": "so p' ettha mahiyā carati ",
  "cp18:3.4": "samitto saparijjano. ",
  "cp18:4.1": "Dhammavādī Adhammo ca ",
  "cp18:4.2": "ubho paccanikā mayaṃ ",
  "cp18:4.3": "dhure dhuraṃ ghaṭṭayantā ",
  "cp18:4.4": "samimhā paṭipathe ubho ",
  "cp18:5.1": "Kalaho vattatī bhesmā ",
  "cp18:5.2": "kalyāṇapāpakassa ca ",
  "cp18:5.3": "maggā okkamanatthāya ",
  "cp18:5.4": "mahāyuddho upaṭṭhito. ",
  "cp18:6.1": "Yadi' haṃ tassa pakuppeyyaṃ ",
  "cp18:6.2": "yadi bhinde tapoguṇaṃ ",
  "cp18:6.3": "saha parijanaṃ tassa ",
  "cp18:6.4": "rajabhūtaṃ kareyya' haṃ. ",
  "cp18:7.1": "Api cāhaṃ sīlarakkhāya ",
  "cp18:7.2": "nibbāpetvāna mānasaṃ ",
  "cp18:7.3": "saha janen' okkamitvā ",
  "cp18:7.4": "pathaṃ pāpassa' dās' ahaṃ. ",
  "cp18:8.1": "Saha pathato okkante ",
  "cp18:8.2": "katvā cittassa nibbutiṃ ",
  "cp18:8.3": "vivaraṃ adāsi paṭhavī ",
  "cp18:8.4": "pāpayakkhassa tāvade 'ti. ",
  "cp18:9.1": "Dhammadevaputtacariyaṃ aṭṭhamaṃ "
}
