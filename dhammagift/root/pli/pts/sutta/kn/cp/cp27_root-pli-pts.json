  "cp27:0.4": "",
  "cp27:1.1": "Yadā ahaṃ kapi āsiṃ ",
  "cp27:1.2": "nadīkūle darīsaye ",
  "cp27:1.3": "pīḷito suṃsumārena ",
  "cp27:1.4": "gamanaṃ na labhām' ahaṃ. ",
  "cp27:2.1": "Yamh' okāse ahaṃ ṭhatvā ",
  "cp27:2.2": "orapāraṃ patām' ahaṃ ",
  "cp27:2.3": "tattha' cchi sattu vadhako ",
  "cp27:2.4": "kumbhīlo luddadassano. ",
  "cp27:3.1": "So maṃ asaṃsi: ehīti, ",
  "cp27:3.2": "aham-emīti taṃ vadim ",
  "cp27:3.3": "tassa matthakam-akkamma ",
  "cp27:3.4": "parakūle patiṭṭhahiṃ. ",
  "cp27:4.1": "Na tassa alikaṃ bhaṇitaṃ ",
  "cp27:4.2": "yathā vācaṃ akās' ahaṃ; ",
  "cp27:4.3": "saccena me samo natthi ",
  "cp27:4.4": "esā me saccapāramīti. ",
  "cp27:4.5": "Kapirājacariyaṃ sattamaṃ "
}
