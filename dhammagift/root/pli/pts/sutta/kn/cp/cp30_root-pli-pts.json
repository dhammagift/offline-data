  "cp30:0.1": "",
  "cp30:0.2": "",
  "cp30:0.3": "",
  "cp30:0.4": "",
  "cp30:1.1": "Punāparaṃ yadā homi ",
  "cp30:1.2": "maccharājā mahāsare ",
  "cp30:1.3": "uṇhe suriyasantāpe ",
  "cp30:1.4": "sare udakaṃ khīyatha. ",
  "cp30:2.1": "Tato kākā ca gijjhā ca ",
  "cp30:2.2": "bakā kulalasenakā ",
  "cp30:2.3": "bhakkhayanti divārattiṃ ",
  "cp30:2.4": "macche upanisīdiya. ",
  "cp30:3.1": "Evaṃ cintes' ahaṃ tattha ",
  "cp30:3.2": "saha ñātīhi pīḷito: ",
  "cp30:3.3": "kena nu kho upāyena ",
  "cp30:3.4": "ñātī dukkhā pamocaye. ",
  "cp30:4.1": "Vicintayitvā dhammatthaṃ ",
  "cp30:4.2": "saccaṃ addasa' passayaṃ ",
  "cp30:4.3": "sacce ṭhatvā pamocesiṃ ",
  "cp30:4.4": "ñātīnaṃ taṃ atikkhayaṃ. ",
  "cp30:5.1": "Anussaritvā saddhammaṃ ",
  "cp30:5.2": "paramatthaṃ vicintayaṃ ",
  "cp30:5.3": "akāsiṃ saccakiriyaṃ ",
  "cp30:5.4": "yaṃ loke dhuvasassataṃ: ",
  "cp30:6.1": "Yato sarāmi attānaṃ ",
  "cp30:6.2": "yato patto 'smi viññutaṃ ",
  "cp30:6.3": "nābhijānāmi sañcicca ",
  "cp30:6.4": "ekapāṇam-pi hiṃsitaṃ ",
  "cp30:7.1": "etena saccavajjena ",
  "cp30:7.2": "Pajjunno abhivassatu. ",
  "cp30:7.3": "Abhitthanaya Pajjunna ",
  "cp30:7.4": "nidhiṃ kākassa nāsaya ",
  "cp30:7.5": "kākaṃ sokāya rundhehi ",
  "cp30:7.6": "macche sokā pamocaya. ",
  "cp30:8.1": "Saha kate saccavare ",
  "cp30:8.2": "Pajjunno abhigajjiya ",
  "cp30:8.3": "thalaṃ ninnañca pūrento ",
  "cp30:8.4": "khaṇena abhivassatha. ",
  "cp30:9.1": "Evarūpaṃ saccavaraṃ ",
  "cp30:9.2": "katvā viriyam-uttamaṃ ",
  "cp30:9.3": "vassāpesiṃ mahāmeghaṃ ",
  "cp30:9.4": "saccatejabala 'ssito; ",
  "cp30:9.5": "saccena me samo natthi ",
  "cp30:9.6": "esā me saccapāramīti. ",
  "cp30:10.1": "Maccharājacariyaṃ dasamaṃ "
}
