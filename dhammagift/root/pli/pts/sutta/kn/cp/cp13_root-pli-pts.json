  "cp13:0.3": "",
  "cp13:0.4": "",
  "cp13:1.1": "Punāparaṃ yadā homi ",
  "cp13:1.2": "Campeyyako mah' iddhiko ",
  "cp13:1.3": "tadā pi dhammiko āsiṃ ",
  "cp13:1.4": "sīlabbatasamappito. ",
  "cp13:2.1": "Tadā pi maṃ dhammacāriṃ ",
  "cp13:2.2": "upavutthaṃ uposathaṃ ",
  "cp13:2.3": "ahiguṇṭhiko gahetvāna ",
  "cp13:2.4": "rājadvāramhi kīḷati. ",
  "cp13:3.1": "Yaṃ so vaṇṇaṃ cintayati ",
  "cp13:3.2": "nīlañca pītalohitaṃ ",
  "cp13:3.3": "tassa cittānuvattento ",
  "cp13:3.4": "homi cintitasannibho. ",
  "cp13:4.1": "Thalaṃ kareyyam-udakaṃ ",
  "cp13:4.2": "udakam-pi thalaṃ kare ",
  "cp13:4.3": "yadi' haṃ tassa pakuppeyyaṃ ",
  "cp13:4.4": "khaṇena chārikaṃ kare. ",
  "cp13:5.1": "Yadi cittavasī hessaṃ ",
  "cp13:5.2": "parihāyissāmi sīlato ",
  "cp13:5.3": "sīlena parihīnassa ",
  "cp13:5.4": "uttama 'ttho na sijjhati. ",
  "cp13:6.1": "Kāmaṃ bhijjatu 'yaṃ kāyo ",
  "cp13:6.2": "idh' eva vikirīyatu ",
  "cp13:6.3": "n' eva sīlam-pabhindeyyaṃ ",
  "cp13:6.4": "vikirante bhusaṃ viyā 'ti. ",
  "cp13:7.1": "Campeyyanāgacariyaṃ tatiyaṃ "
}
