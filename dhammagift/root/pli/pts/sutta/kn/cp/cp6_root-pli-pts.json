  "cp6:0.4": "",
  "cp6:1.1": "Punāparaṃ yadā homi ",
  "cp6:1.2": "Mithilāyaṃ pur' uttame ",
  "cp6:1.3": "Nimi nāma mahārājā ",
  "cp6:1.4": "paṇḍito kusala 'tthiko, ",
  "cp6:2.1": "Tadā' haṃ māpayitvāna ",
  "cp6:2.2": "catusālaṃ catummukhaṃ ",
  "cp6:2.3": "tattha dānaṃ pavattesiṃ ",
  "cp6:2.4": "migapakkhinarādinaṃ. ",
  "cp6:3.1": "Acchādanañca sayanañca ",
  "cp6:3.2": "annaṃ pānañca bhojanaṃ ",
  "cp6:3.3": "abbocchinnaṃ karitvāna ",
  "cp6:3.4": "mahādānaṃ pavattayiṃ. ",
  "cp6:4.1": "Yathā pi sevako sāmiṃ ",
  "cp6:4.2": "dhanahetu-m-upāgato ",
  "cp6:4.3": "kāyena vācā manasā ",
  "cp6:4.4": "ārādhaniyam- esati, ",
  "cp6:5.1": "Tath' evāhaṃ sabbabhave ",
  "cp6:5.2": "pariyesissāmi bodhijaṃ ",
  "cp6:5.3": "dānena satte tappetvā ",
  "cp6:5.4": "icchāmi bodhim-uttaman-ti. ",
  "cp6:6.1": "Nimirājacariyaṃ chaṭṭhamaṃ "
}
