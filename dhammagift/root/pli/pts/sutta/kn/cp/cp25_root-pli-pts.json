  "cp25:0.4": "",
  "cp25:1.1": "Punāparaṃ yadā homi ",
  "cp25:1.2": "nagare Brahmavaḍḍhane ",
  "cp25:1.3": "tattha kulavare seṭṭhe ",
  "cp25:1.4": "mahāsāle ajāy' ahaṃ. ",
  "cp25:2.1": "Tadā pi lokaṃ disvāna ",
  "cp25:2.2": "andhabhutaṃ tam' otthaṭaṃ ",
  "cp25:2.3": "cittaṃ bhavato patikuṭati ",
  "cp25:2.4": "tuttavegahataṃ viya. ",
  "cp25:3.1": "Disvāna vividhaṃ pāpaṃ ",
  "cp25:3.2": "evaṃ cintes' ahaṃ tadā: ",
  "cp25:3.3": "kadā' haṃ gehā nikkhamma ",
  "cp25:3.4": "pavisissāmi kānanaṃ. ",
  "cp25:4.1": "Tadā pi maṃ nimantiṃsu ",
  "cp25:4.2": "kāmabhogehi ñātayo ",
  "cp25:4.3": "tesam-pi chandam-ācikkhiṃ: ",
  "cp25:4.4": "mā nimantetha tehi maṃ. ",
  "cp25:5.1": "Yo me kaniṭṭhako bhātā ",
  "cp25:5.2": "Nando namāsi paṇḍito ",
  "cp25:5.3": "so pi maṃ anusikkhanto ",
  "cp25:5.4": "pabbajjaṃ samarocayi. ",
  "cp25:6.1": "Ahaṃ Soṇo ca Nando ca ",
  "cp25:6.2": "ubho mātā pitā mama ",
  "cp25:6.3": "tadā pi bhoge chaḍḍetvā ",
  "cp25:6.4": "pāvisimha mahāvanan-ti. ",
  "cp25:7.1": "Soṇapaṇḍitacariyaṃ pañcamaṃ Nekkhammapāraminiddeso niṭṭhito. "
}
