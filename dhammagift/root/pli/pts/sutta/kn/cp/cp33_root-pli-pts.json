  "cp33:0.4": "",
  "cp33:1.1": "Sāmo yadā vane āsiṃ ",
  "cp33:1.2": "Sakkena abhinimmito ",
  "cp33:1.3": "pavane sīhavyagghe ca ",
  "cp33:1.4": "mettāya-m-upanāmayiṃ. ",
  "cp33:2.1": "Sīhavyagghehi dīpīhi ",
  "cp33:2.2": "acchehi mahisehi ca ",
  "cp33:2.3": "pasadamigavarāhehi ",
  "cp33:2.4": "parivāretvā vane vasiṃ. ",
  "cp33:3.1": "Na maṃ koci uttasati ",
  "cp33:3.2": "na pi' haṃ bhāyāmi kassaci ",
  "cp33:3.3": "mettābalen' upatthaddho ",
  "cp33:3.4": "ramāmi pavane tadā 'ti. ",
  "cp33:4.1": "Suvaṇṇasāmacariyaṃ terasamaṃ "
}
