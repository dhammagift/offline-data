  "cp35:0.1": "",
  "cp35:0.2": "",
  "cp35:0.3": "",
  "cp35:0.4": "",
  "cp35:1.1": "Susāne seyyaṃ kappemi ",
  "cp35:1.2": "chavaṭṭhiṃ upadhāya' haṃ ",
  "cp35:1.3": "gomaṇḍalā upāgantvā ",
  "cp35:1.4": "rūpaṃ dassenti' nappakaṃ. ",
  "cp35:2.1": "Apare gandhañca mālañca ",
  "cp35:2.2": "bhojanaṃ vividhaṃ bahuṃ ",
  "cp35:2.3": "upāyanānyupanenti ",
  "cp35:2.4": "haṭṭhā saṃviggamānasā. ",
  "cp35:3.1": "Ye me dukkhaṃ upadahanti ",
  "cp35:3.2": "ye ca denti sukhaṃ mama ",
  "cp35:3.3": "sabbesaṃ samako homi ",
  "cp35:3.4": "dayā kopo na vijjati. ",
  "cp35:4.1": "Sukhadukkhe tulābhūto ",
  "cp35:4.2": "yasesu ayasesu ca ",
  "cp35:4.3": "sabbattha samako homi ",
  "cp35:4.4": "esā me upekkhāpāramīti. ",
  "cp35:5.1": "Mahālomahaṃsacariyaṃ paṇṇarasamaṃ Upekkhāpāraminiddeso niṭṭhito. ",
  "cp35:6.1": "",
  "cp35:7.1": "Nigamanagāthā ",
  "cp35:8.1": "Yudhañjayo Somanasso ",
  "cp35:8.2": "Ayoghara-Bhisena ca ",
  "cp35:8.3": "Soṇanando Mūgapakkho ",
  "cp35:8.4": "kapirājā Saccasa' vhayo, ",
  "cp35:9.1": "Vaṭṭako maccharājā ca ",
  "cp35:9.2": "Kaṇhadīpāyano isi ",
  "cp35:9.3": "Sutasomo puna āsiṃ ",
  "cp35:9.4": "Sāmo ca Ekarāja' hu, ",
  "cp35:9.5": "upekkhāpāramī āsi ",
  "cp35:9.6": "iti vutthaṃ mahesinā. ",
  "cp35:10.1": "Evaṃ bahuvidhaṃ dukkhaṃ ",
  "cp35:10.2": "sampattī ca bahū vidhā ",
  "cp35:10.3": "bhavābhave anubhavitvā ",
  "cp35:10.4": "patto sambodhim-uttamaṃ. ",
  "cp35:11.1": "Datvā dātabbakaṃ dānaṃ ",
  "cp35:11.2": "sīlaṃ pūretvā asesato ",
  "cp35:11.3": "nekkhamme pāramiṃ gantvā ",
  "cp35:11.4": "patto sambodhim-uttamaṃ ",
  "cp35:12.1": "Paṇḍite paripucchitvā ",
  "cp35:12.2": "viriyaṃ katvāna uttamaṃ ",
  "cp35:12.3": "khantiyā pāramiṃ gantvā ",
  "cp35:12.4": "patto sambodhim-uttamaṃ ",
  "cp35:13.1": "Katvā daḷham-adhiṭṭhānaṃ ",
  "cp35:13.2": "saccavacā' nurakkhiya ",
  "cp35:13.3": "mettāya pāramiṃ gantvā ",
  "cp35:13.4": "patto sambodhim-uttamaṃ. ",
  "cp35:14.1": "Lābhālābhe yasāyase ",
  "cp35:14.2": "sammānanāvamānane ",
  "cp35:14.3": "sabbattha samako hutvā ",
  "cp35:14.4": "patto sambodhim-uttamaṃ. ",
  "cp35:15.1": "Kosajjaṃ bhayato disvā ",
  "cp35:15.2": "viriyārambhañca khemato ",
  "cp35:15.3": "āraddhaviriyā hotha ",
  "cp35:15.4": "esā buddhānusāsanī. ",
  "cp35:16.1": "Vivādaṃ bhayato disvā ",
  "cp35:16.2": "avivādañca khemato ",
  "cp35:16.3": "samaggā sakhilā hotha ",
  "cp35:16.4": "esā buddhānusāsanī. ",
  "cp35:17.1": "Pamādaṃ bhayato disvā ",
  "cp35:17.2": "appamādañca khenato ",
  "cp35:17.3": "bhāvetha' ṭṭhaṅgikaṃ maggaṃ ",
  "cp35:17.4": "esā buddhānusāsanī. ",
  "cp35:18.1": "Itthaṃ sudaṃ bhagavā attano pubbacariyaṃ sambhāvayamāno Buddhāpadāniyaṃ nāma dhammapariyāyaṃ abhāsitthā 'ti. Cariyāpiṭakapāḷi samattā. ",
  "cp35:19.1": ""
}
