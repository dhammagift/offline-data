  "cp14:0.3": "",
  "cp14:0.4": "",
  "cp14:1.1": "Punāparaṃ yadā homi ",
  "cp14:1.2": "Cūḷabodhi Susīlavā ",
  "cp14:1.3": "bhavaṃ disvāna bhayato ",
  "cp14:1.4": "nekkhammaṃ abhinikkhamiṃ. ",
  "cp14:2.1": "Yā me dutiyikā āsi ",
  "cp14:2.2": "brāhmaṇī kanakasannibhā ",
  "cp14:2.3": "sā pi vaṭṭe anapekkhā ",
  "cp14:2.4": "nekkhammaṃ abhinikkhami. ",
  "cp14:3.1": "Nirālayā chinnabandhū ",
  "cp14:3.2": "anapekkhā kule gaṇe ",
  "cp14:3.3": "carantā gāmanigamaṃ ",
  "cp14:3.4": "Bārāṇasim-upāgamuṃ. ",
  "cp14:4.1": "Tattha vasāma nipakā ",
  "cp14:4.2": "asaṃsaṭṭhā kule gaṇe ",
  "cp14:4.3": "nirākule appasadde ",
  "cp14:4.4": "rāj' uyyāne vasām' ubho. ",
  "cp14:5.1": "Uyyānadassanaṃ gantvā ",
  "cp14:5.2": "rājā addasa brāhmaṇiṃ ",
  "cp14:5.3": "upagamma mamaṃ pucchi: ",
  "cp14:5.4": "tuyh' esā, kassa bhāriyā. ",
  "cp14:6.1": "Evaṃ vutte ahaṃ tassa ",
  "cp14:6.2": "idaṃ vacanam-abraviṃ: ",
  "cp14:6.3": "na mayhaṃ bhariyā esā ",
  "cp14:6.4": "sahadhammā ekasāsanī. ",
  "cp14:7.1": "Tassā Sārattagadhito ",
  "cp14:7.2": "gāhāpetvāna ceṭake ",
  "cp14:7.3": "nippīḷayanto balasā ",
  "cp14:7.4": "antepuram-pavesayi. ",
  "cp14:8.1": "Odapattakiyā mayhaṃ ",
  "cp14:8.2": "sahajā ekasāsanī ",
  "cp14:8.3": "ākaḍḍhitvā nayantiyā ",
  "cp14:8.4": "kopo me upapajjatha. ",
  "cp14:9.1": "Saha kope samuppanne ",
  "cp14:9.2": "sīlabbatam-anussariṃ ",
  "cp14:9.3": "tatth' eva kopaṃ niggaṇhiṃ ",
  "cp14:9.4": "nādāsiṃ vaḍḍhit' ūpari. ",
  "cp14:10.1": "Yadi naṃ brāhmaṇiṃ koci ",
  "cp14:10.2": "koṭṭeyya tiṇhasattiyā ",
  "cp14:10.3": "n' eva sīlaṃ pabhindeyyaṃ ",
  "cp14:10.4": "bodhiyā-yeva kāraṇā. ",
  "cp14:11.1": "Na me sā brāhmaṇī dessā ",
  "cp14:11.2": "na pi me balaṃ na vijjati, ",
  "cp14:11.3": "sabbaññutaṃ piyaṃ mayhaṃ ",
  "cp14:11.4": "tasmā sīlānurakkhissan-ti. ",
  "cp14:12.1": "Cūḷabodhicariyaṃ catutthaṃ "
}
