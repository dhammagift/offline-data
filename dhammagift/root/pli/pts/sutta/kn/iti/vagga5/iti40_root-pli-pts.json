  "iti40:1.1": "bhagavatā vuttamarahatā ti me sutaṃ. ",
  "iti40:2.1": "Avijjā bhikkhave pubbaṅgamā akusalānaṃ dhammānaṃ samāpattiyā, anvad-eva ahirikaṃ anottappaṃ. ",
  "iti40:2.2": "Vijjā ca kho bhikkhave pubbaṅgamā kusalānaṃ dhammānaṃ samāpattiyā, anvad-eva hirottappan-ti. ",
  "iti40:2.3": "Etam-atthaṃ bhagavā avoca, ",
  "iti40:2.4": "tatthetaṃ iti vuccati: ",
  "iti40:3.1": "Yā kāci-mā duggatiyo ",
  "iti40:3.2": "asmiṃ loke paramhi ca | ",
  "iti40:3.3": "avijjāmūlakā sabbā ",
  "iti40:3.4": "icchālobhasamussayā || ",
  "iti40:4.1": "Yato ca hoti pāpiccho ",
  "iti40:4.2": "ahirīko anādaro | ",
  "iti40:4.3": "tato pāpaṃ pasavati ",
  "iti40:4.4": "apāyaṃ tena gacchati || ",
  "iti40:5.1": "Tasmā chandañca lobhañca ",
  "iti40:5.2": "avijjañca virājayaṃ | ",
  "iti40:5.3": "vijjaṃ uppādayaṃ bhikkhu ",
  "iti40:5.4": "sabbā duggatiyo jahe ti || ",
  "iti40:6.1": "Ayam-pi attho vutto bhagavatā iti me sutan-ti ||3|| 41. ",
  "iti40:6.2": "(Duk. II.4) ",
  "iti40:6.3": "Vuttaṃ hetaṃ "
}
