  "iti25:1.1": "bhagavatā vuttamarahatā ti me sutaṃ. ",
  "iti25:2.1": "Ekadhammaṃ atītassa bhikkhave purisapuggalassa nāhaṃ tassa kiñci pāpakammaṃ akaraṇīyan-ti vadāmi. ",
  "iti25:2.2": "Katamaṃ ekadhammaṃ? ",
  "iti25:2.3": "Yathayidaṃ bhikkhave sampajānamusāvādo ti. ",
  "iti25:2.4": "Etam-atthaṃ bhagavā avoca, ",
  "iti25:2.5": "tatthetaṃ iti vuccati: ",
  "iti25:3.1": "Ekadhammaṃ atītassa ",
  "iti25:3.2": "musāvādissa jantuno | ",
  "iti25:3.3": "vitiṇṇaparalokassa ",
  "iti25:3.4": "natthi pāpaṃ akāriyan-ti || ",
  "iti25:4.1": "Ayam-pi attho vutto bhagavatā iti me sutan-ti ||5|| 26. (Ek. ",
  "iti25:4.2": "III.6) Vuttaṃ hetaṃ "
}
