  "iti21:0.4": "",
  "iti21:1.1": "bhagavatā vuttam-arahatā ti me sutaṃ. ",
  "iti21:2.1": "Idhāhaṃ bhikkhave ekaccam puggalaṃ pasannacittaṃ evaṃ cetasā ceto paricca pajānāmi, ",
  "iti21:2.2": "imamhi cāyaṃ samaye puggalo kālaṃ kareyya yathābhataṃ nikkhitto evaṃ sagge. ",
  "iti21:2.3": "Taṃ kissa hetu? ",
  "iti21:2.4": "Cittañhi-ssa bhikkhave pasannaṃ. ",
  "iti21:2.5": "Cetopasādahetu kho pana bhikkhave evam-idhekacce sattā kāyassa bhedā param-maraṇā sugatiṃ saggaṃ lokaṃ upapajjantīti. ",
  "iti21:2.6": "Etam-atthaṃ bhagavā avoca, ",
  "iti21:2.7": "tatthetaṃ iti vuccati: ",
  "iti21:3.1": "Pasannacittaṃ ñatvāna ",
  "iti21:3.2": "ekaccaṃ idha puggalaṃ | ",
  "iti21:3.3": "etam-atthañca byākāsi ",
  "iti21:3.4": "buddho bhikkhūnaṃ santike || ",
  "iti21:4.1": "Imamhi cāyaṃ samaye ",
  "iti21:4.2": "kālaṃ kayirātha puggalo | ",
  "iti21:4.3": "sugatiṃ upapajjeyya ",
  "iti21:4.4": "cittañ-hi-ssa pasādikaṃ || ",
  "iti21:5.1": "Yathā haritvā nikkhipeyya ",
  "iti21:5.2": "evam-eva tathāvidho | ",
  "iti21:5.3": "cetopasādahetū hi ",
  "iti21:5.4": "sattā gacchanti sugatin-ti || ",
  "iti21:6.1": "Ayam-pi attho vutto bhagavatā iti me sutan-ti ||1|| 22. (Ek. ",
  "iti21:6.2": "III.2) Vuttaṃ hetaṃ "
}
