  "iti98:1.1": "",
  "iti98:2.1": "bhikkhave dānāni ",
  "iti98:2.2": "āmisadānañca dhammadānañca, ",
  "iti98:2.3": "etad-aggaṃ bhikkhave imesaṃ dvinnaṃ dānānaṃ yad-idaṃ dhammadānaṃ. ",
  "iti98:3.1": "Dve-me bhikkhave saṃvibhāgā ",
  "iti98:3.2": "āmisasaṃvibhāgo ca dhammasaṃvibhāgo ca, ",
  "iti98:3.3": "etad-aggaṃ bhikkhave imesaṃ dvinnaṃ saṃvibhāgānaṃ yad-idaṃ dhammasaṃvibhāgo. ",
  "iti98:4.1": "Dve-me bhikkhave anuggahā ",
  "iti98:4.2": "āmisānuggaho ca dhammānuggaho ca, ",
  "iti98:4.3": "etad-aggaṃ bhikkhave imesaṃ dvinnaṃ anuggahānaṃ yad-idaṃ dhammānuggaho ti. ",
  "iti98:4.4": "",
  "iti98:4.5": "",
  "iti98:5.1": "Yam-āhu dānaṃ paramaṃ anuttaraṃ ",
  "iti98:5.2": "yaṃ saṃvibhāgaṃ bhagavā avaṇṇayi | ",
  "iti98:5.3": "aggamhi khettamhi pasannacitto ",
  "iti98:5.4": "viññū pajānaṃ ko na yajetha kāle || ",
  "iti98:6.1": "Ye ceva bhāsanti suṇanti cūbhayaṃ ",
  "iti98:6.2": "pasannacittā sugatassa sāsane | ",
  "iti98:6.3": "tesaṃ so attho paramo visujjhati ",
  "iti98:6.4": "ye appamattā sugatassa sāsane ti ||9|| 99 (Tik. ",
  "iti98:7.1": "V.10) Vuttaṃ hetaṃ bhagavatā vuttam-arahatā ti ",
  "iti98:7.2": ""
}
