  "iti96:1.1": "",
  "iti96:2.1": "Kāmayogayutto bhikkhave bhavayogayutto āgāmī hoti āgantā itthattaṃ; ",
  "iti96:2.2": "kāmayogavisaññutto bhikkhave bhavayogayutto anāgāmī hoti anāgantā itthattaṃ; ",
  "iti96:2.3": "kāmayogavisaññutto bhikkhave bhavayogavisaññutto arahā hoti khīṇāsavo ti. ",
  "iti96:2.4": "",
  "iti96:2.5": "",
  "iti96:3.1": "Kāmayogena saññuttā ",
  "iti96:3.2": "bhavayogena cūbhayaṃ | ",
  "iti96:3.3": "sattā gacchanti saṃsāraṃ ",
  "iti96:3.4": "jātimaraṇagāmino || ",
  "iti96:4.1": "Ye ca kāme pahantvāna ",
  "iti96:4.2": "appattā āsavakkhayaṃ | ",
  "iti96:4.3": "bhavayogena saññuttā ",
  "iti96:4.4": "anāgāmīti vuccare || ",
  "iti96:5.1": "Ye ca kho chinnasaṃsayā ",
  "iti96:5.2": "khīṇamānapunabbhavā | ",
  "iti96:5.3": "te ve pāraṃgatā loke ",
  "iti96:5.4": "ye pattā āsavakkhayan- ",
  "iti96:6.1": "ti ||7|| 97. (Tik. V.8) ",
  "iti96:6.2": "",
  "iti96:6.3": ""
}
