  "iti61:1.1": "bhagavatā vuttam-arahatā ti me sutaṃ. ",
  "iti61:2.1": "Tīṇ'imāni bhikkhave cakkhūni. ",
  "iti61:2.2": "Katamāni tīṇi? ",
  "iti61:2.3": "Maṃsacakkhu dibbacakkhu paññācakkhu, ",
  "iti61:2.4": "imāni kho bhikkhave tīṇi cakkhūnīti. ",
  "iti61:2.5": "Etam-atthaṃ bhagavā avoca, ",
  "iti61:2.6": "tatthetaṃ iti vuccati: ",
  "iti61:3.1": "Maṃsacakkhu dibbacakkhu ",
  "iti61:3.2": "paññācakkhu anuttaraṃ | ",
  "iti61:3.3": "etāni tīṇi cakkhūni ",
  "iti61:3.4": "akkhāsi purisuttamo || ",
  "iti61:4.1": "Maṃsacakkhussa uppādo ",
  "iti61:4.2": "maggo dibbassa cakkhuno | ",
  "iti61:4.3": "yato ñāṇaṃ udapādi ",
  "iti61:4.4": "paññācakkhu anuttaraṃ | ",
  "iti61:4.5": "yassa cakkhussa paṭilābhā ",
  "iti61:4.6": "sabbadukkhā pamuccatīti || ",
  "iti61:5.1": "Ayam-pi attho vutto bhagavatā iti me sutan-ti ||2|| 62. (Tik. ",
  "iti61:5.2": "II.3) Vuttaṃ hetaṃ "
}
