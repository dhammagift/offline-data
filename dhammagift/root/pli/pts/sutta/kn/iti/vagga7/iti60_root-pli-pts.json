  "iti60:1.1": "bhagavatā vuttam-arahatā ti me sutaṃ. ",
  "iti60:2.1": "Tīṇi-māni bhikkhave puññakiriyavatthūni. ",
  "iti60:2.2": "Katamāni tīṇi? ",
  "iti60:2.3": "Dānamayaṃ puññakiriyavatthu sīlamayaṃ puññakiriyavatthu bhāvanāmayaṃ puññakiriyavatthu, ",
  "iti60:2.4": "imāni kho bhikkhave tīṇi puññakiriyavatthūnīti. ",
  "iti60:2.5": "Etam-atthaṃ bhagavā avoca, ",
  "iti60:2.6": "tatthetaṃ iti vuccati: ",
  "iti60:3.1": "Puññam-eva so sikkheyya ",
  "iti60:3.2": "āyataggaṃ sukhindriyaṃ | ",
  "iti60:3.3": "dānañca samacariyañca ",
  "iti60:3.4": "mettacittañca bhāvaye || ",
  "iti60:4.1": "Ete dhamme bhāvayitvā ",
  "iti60:4.2": "tayo sukhasamuddaye | ",
  "iti60:4.3": "abyāpajjhaṃ sukhaṃ lokaṃ ",
  "iti60:4.4": "paṇḍito upapajjatīti || ",
  "iti60:5.1": "Ayam-pi attho vutto bhagavatā iti me sutan-ti ||1|| 61. (Tik. ",
  "iti60:5.2": "II.2) Vuttaṃ hetaṃ "
}
