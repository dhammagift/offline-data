  "iti67:1.1": "bhagavatā vuttam-arahatā ti me sutaṃ. ",
  "iti67:2.1": "Tīṇi-māni bhikkhave moneyyāni. ",
  "iti67:2.2": "Katamāni tīṇi? ",
  "iti67:2.3": "Kāyamoneyyaṃ vacīmoneyyaṃ manomoneyyaṃ, ",
  "iti67:2.4": "imāni kho bhikkhave tīṇi moneyyānīti. ",
  "iti67:2.5": "Etam-atthaṃ bhagavā avoca, ",
  "iti67:2.6": "tatthetaṃ iti vuccati: ",
  "iti67:3.1": "Kāyamuniṃ vācāmuniṃ ",
  "iti67:3.2": "manomunim-anāsavaṃ | ",
  "iti67:3.3": "munimoneyyasampannaṃ ",
  "iti67:3.4": "āhu niṇhātapāpakan-ti || ",
  "iti67:4.1": "Ayam-pi attho vutto bhagavatā iti me sutan-ti ||8|| 68. (Tik. ",
  "iti67:4.2": "II.9) Vuttaṃ hetaṃ "
}
