  "iti63:0.4": "",
  "iti63:1.1": "bhagavatā vuttam-arahatā ti me sutaṃ. ",
  "iti63:2.1": "Tayo me bhikkhave addhā. ",
  "iti63:2.2": "Katame tayo? ",
  "iti63:2.3": "Atīto addhā anāgato addhā paccuppanno addhā, ",
  "iti63:2.4": "ime kho bhikkhave tayo addhā ti. ",
  "iti63:2.5": "Etam-atthaṃ bhagavā avoca, ",
  "iti63:2.6": "tatthetaṃ iti vuccati: ",
  "iti63:3.1": "Akkheyyasaññino sattā ",
  "iti63:3.2": "akkheyyasmiṃ patiṭṭhitā | ",
  "iti63:3.3": "akkheyyaṃ apariññāya ",
  "iti63:3.4": "yogam-āyanti maccuno || ",
  "iti63:4.1": "Akkheyyañca pariññāya ",
  "iti63:4.2": "akkhātāraṃ na maññati | ",
  "iti63:4.3": "phuṭṭho vimokkho manasā ",
  "iti63:4.4": "santipadam-anuttaraṃ || ",
  "iti63:5.1": "Sa ve akkheyyasampanno ",
  "iti63:5.2": "santo santipade rato | ",
  "iti63:5.3": "saṅkhāya sevī dhammaṭṭho ",
  "iti63:5.4": "saṅkhaṃ nopeti vedagū-ti || ",
  "iti63:6.1": "Ayam-pi attho vutto bhagavatā iti me sutan-ti ||4|| 64. (Tik. ",
  "iti63:6.2": "II.5) Vuttaṃ hetaṃ "
}
