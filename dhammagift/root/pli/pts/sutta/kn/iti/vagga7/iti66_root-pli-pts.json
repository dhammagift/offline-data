  "iti66:1.1": "bhagavatā vuttam-arahatā ti me sutaṃ. ",
  "iti66:2.1": "Tīṇi-māni bhikkhave soceyyāni. ",
  "iti66:2.2": "Katamāni tīṇi? ",
  "iti66:2.3": "Kāyasoceyyaṃ vacīsoceyyaṃ manosoceyyaṃ, ",
  "iti66:2.4": "imāni kho bhikkhave tīṇi soceyyānīti. ",
  "iti66:2.5": "Etam-atthaṃ bhagavā avoca, ",
  "iti66:2.6": "tatthetaṃ iti vuccati: ",
  "iti66:3.1": "Kāyasuciṃ vācāsuciṃ ",
  "iti66:3.2": "cetosuciṃ-anāsavaṃ | ",
  "iti66:3.3": "sucisoceyyasampannaṃ ",
  "iti66:3.4": "āhu sabbapahāyinan-ti || ",
  "iti66:4.1": "Ayam-pi attho vutto bhagavatā iti me sutan-ti ||7|| 67. (Tik. ",
  "iti66:4.2": "II.8) Vuttaṃ hetaṃ "
}
