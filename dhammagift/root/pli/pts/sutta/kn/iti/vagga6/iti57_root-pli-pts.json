  "iti57:1.1": "bhagavatā vuttam-arahatā ti me sutaṃ. ",
  "iti57:2.1": "Tayo me bhikkhave āsavā. ",
  "iti57:2.2": "Katame tayo? ",
  "iti57:2.3": "Kāmāsavo bhavāsavo avijjāsavo, ",
  "iti57:2.4": "ime kho bhikkhave tayo āsavā ti. ",
  "iti57:2.5": "Etam-atthaṃ bhagavā avoca, ",
  "iti57:2.6": "tatthetaṃ iti vuccati: ",
  "iti57:3.1": "Yassa kāmāsavo khīṇo ",
  "iti57:3.2": "avijjā ca virājitā | ",
  "iti57:3.3": "bhavāsavo parikkhīṇo ",
  "iti57:3.4": "vippamutto nirūpadhi | ",
  "iti57:3.5": "dhāreti antimaṃ dehaṃ ",
  "iti57:3.6": "jetvā māraṃ savāhanan-ti || ",
  "iti57:4.1": "Ayam-pi attho vutto bhagavatā iti me sutan-ti ||8|| 58. (Tik. ",
  "iti57:4.2": "I.9) Vuttaṃ hetaṃ "
}
