  "iti50:1.1": "bhagavatā vuttam-arahatā ti me sutaṃ. ",
  "iti50:2.1": "Tīṇi-māni bhikkhave akusalamūlāni. ",
  "iti50:2.2": "Katamāni tīṇi? ",
  "iti50:2.3": "Lobho akusalamūlaṃ, doso akusalamūlaṃ, moho akusalamūlaṃ, ",
  "iti50:2.4": "imāni kho bhikkhave tīṇi akusalamūlānīti. ",
  "iti50:2.5": "Etam-atthaṃ bhagavā avoca, ",
  "iti50:2.6": "tatthetaṃ iti vuccati: ",
  "iti50:3.1": "Lobho doso ca moho ca ",
  "iti50:3.2": "purisaṃ pāpacetasaṃ | ",
  "iti50:3.3": "hiṃsanti attasambhūtā ",
  "iti50:3.4": "tacasāraṃ va samphalan-ti || ",
  "iti50:4.1": "Ayam-pi attho vutto bhagavatā iti me sutan-ti ||1|| 51. (Tik. ",
  "iti50:4.2": "I.2) Vuttaṃ hetaṃ "
}
