  "iti86:1.1": "",
  "iti86:2.1": "Dhammānudhammapaṭipannassa bhikkhuno ayam-anudhammo hoti, veyyākaraṇāya ",
  "iti86:2.2": "dhammānudhammapaṭipanno 'yan-ti, bhāsamāno dhammaññeva bhāsati no adhammaṃ, vitakkayamāno vā dhammavitakkaññeva vitakketi no adhammavitakkaṃ, tad-ubhayaṃ abhinivajjetvā upekkhako viharati sato sampajāno ti. ",
  "iti86:2.3": "",
  "iti86:2.4": "",
  "iti86:3.1": "Dhammārāmo dhammarato ",
  "iti86:3.2": "dhammaṃ anuvicintayaṃ | ",
  "iti86:3.3": "dhammaṃ anussaraṃ bhikkhu ",
  "iti86:3.4": "saddhammā na parihāyati || ",
  "iti86:4.1": "Caraṃ vā yadi vā tiṭṭhaṃ ",
  "iti86:4.2": "nisinno udavā sayaṃ | ",
  "iti86:4.3": "ajjhattaṃ samayaṃ cittaṃ ",
  "iti86:4.4": "santim-evādhigacchatīti ||7|| 87. ",
  "iti86:5.1": "(Tik. IV.8) Tayo-me ",
  "iti86:5.2": ""
}
