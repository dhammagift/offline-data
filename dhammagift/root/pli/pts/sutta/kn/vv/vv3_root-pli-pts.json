  "vv3:0.1": "",
  "vv3:0.2": "",
  "vv3:0.3": "",
  "vv3:0.4": "",
  "vv3:1.1": "Pīṭhaṃ te sovaṇṇamayaṃ uḷāraṃ ",
  "vv3:1.2": "manojavaṃ gacchati yena kāmaṃ ",
  "vv3:1.3": "alaṅkate malyadhare suvatthe ",
  "vv3:1.4": "obhāsasi vijju-r-iv' abbhakūṭaṃ. [=3].2 ",
  "vv3:2.1": "Kena t' etādiso vaṇṇo ",
  "vv3:2.2": "kena te idha-m-ijjhati ",
  "vv3:2.3": "uppajjanti ca te bhogā ",
  "vv3:2.4": "ye keci manaso piyā. [=3].3 ",
  "vv3:3.1": "Pucchāmi taṃ devi mahānubhāve ",
  "vv3:3.2": "manussabhūtā kim akāsi puññaṃ ",
  "vv3:3.3": "kenāsi evaṃ jalitānubhāvā ",
  "vv3:3.4": "vaṇṇo ca te sabbadisā pabhāsatī ti. [=3].4 ",
  "vv3:4.1": "Sā devatā attamanā ",
  "vv3:4.2": "Moggallānena pucchitā ",
  "vv3:4.3": "pañhaṃ puṭṭhā viyākāsi ",
  "vv3:4.4": "yassa kammass' idaṃ phalaṃ: [=3].5 ",
  "vv3:5.1": "Appassa kammassa phalaṃ mamedaṃ ",
  "vv3:5.2": "yen' amhi evaṃ jalitānubhāvā. [=3].6 ",
  "vv3:5.3": "Ahaṃ manussesu manussabhūtā ",
  "vv3:5.4": "purimāya jātiyā manussaloke, ",
  "vv3:6.1": "addasaṃ virajaṃ bhikkhuṃ ",
  "vv3:6.2": "vippasannam anāvilaṃ ",
  "vv3:6.3": "tassa adās' ahaṃ pīṭhaṃ ",
  "vv3:6.4": "pasannā sehi pāṇihi. [=3].7 ",
  "vv3:7.1": "Tena m' etādiso vaṇṇo ",
  "vv3:7.2": "tena me idha-m-ijjhati ",
  "vv3:7.3": "uppajjanti ca me bhogā ",
  "vv3:7.4": "ye keci manaso piyā. [=3].8 ",
  "vv3:8.1": "Akkhāmi te bhikkhu mahānubhāva ",
  "vv3:8.2": "manussabhūtā yam akāsi puññaṃ ",
  "vv3:8.3": "ten' amhi evaṃ jalitānubhāvā ",
  "vv3:8.4": "vaṇṇo ca me sabbadisā pabhāsatī ti. ",
  "vv3:9.1": "Tatiyapīṭhavimānaṃ [=4].1 "
}
