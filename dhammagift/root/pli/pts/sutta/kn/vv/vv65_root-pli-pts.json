  "vv65:0.4": "",
  "vv65:1.1": "Yathā vanaṃ Cittalataṃ pabhāsati ",
  "vv65:1.2": "uyyānaseṭṭhaṃ Tidasānam uttamaṃ ",
  "vv65:1.3": "tathūpamaṃ tuyham idaṃ vimānaṃ ",
  "vv65:1.4": "obhāsayaṃ tiṭṭhati antalikkhe. [=65].2 ",
  "vv65:2.1": "Deviddhipatto 'si mahānubhāvo ",
  "vv65:2.2": "manussabhūto kim akāsi puññaṃ ",
  "vv65:2.3": "kenāsi evaṃ jalitānubhāvo ",
  "vv65:2.4": "vaṇṇo ca te sabbadisā pabhāsatī ti. [=65].3 ",
  "vv65:3.1": "So devaputto attamano ",
  "vv65:3.2": "Moggallānena pucchito ",
  "vv65:3.3": "pañhaṃ puṭṭho viyākāsi ",
  "vv65:3.4": "yassa kammass' idaṃ phalaṃ. [=65].4 ",
  "vv65:4.1": "Ahañ ca bhariyā ca manussaloke ",
  "vv65:4.2": "opānabhūtā gharam āvasimha ",
  "vv65:4.3": "annañ ca pānañ ca pasannacittā ",
  "vv65:4.4": "sakkacca dānaṃ vipulaṃ adamha. [=65].5 ",
  "vv65:5.1": "Tena m' etādiso vaṇṇo ",
  "vv65:5.2": "tena me idha-m-ijjhati uppajjanti ca me bhogā ye keci manaso piyā. [=65].6 Akkhāmi te bhikkhu mahānubhāva manussabhūto yam akāsi puññaṃ ten' amhi evaṃ jalitānubhāvo ",
  "vv65:5.3": "vaṇṇo ca me sabbadisā pabhāsatīti. ",
  "vv65:6.1": "Agāriyavimānaṃ [=66].1 "
}
