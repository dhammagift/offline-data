  "vv6:0.1": "",
  "vv6:0.2": "",
  "vv6:0.3": "",
  "vv6:0.4": "",
  "vv6:1.1": "Suvaṇṇacchadanaṃ nāvaṃ ",
  "vv6:1.2": "nāri āruyha tiṭṭhasi ",
  "vv6:1.3": "ogāhasi pokkharaṇiṃ ",
  "vv6:1.4": "padmaṃ chindasi pāṇinā. [=6].2 ",
  "vv6:2.1": "Kena t' etādiso vaṇṇo ",
  "vv6:2.2": "kena te idha-m-ijjhati ",
  "vv6:2.3": "uppajjanti ca te bhogā ",
  "vv6:2.4": "ye keci manaso piyā. [=6].3 ",
  "vv6:3.1": "Pucchāmi taṃ devi mahānubhāve ",
  "vv6:3.2": "manussabhūtā kim akāsi puññaṃ ",
  "vv6:3.3": "kenāsi evaṃ jalitānubhāvā ",
  "vv6:3.4": "vaṇṇo ca te sabbadisā pabhāsatī ti. [=6].4 ",
  "vv6:4.1": "Sā devatā attamanā ",
  "vv6:4.2": "Moggallānena pucchitā ",
  "vv6:4.3": "pañhaṃ puṭṭhā viyākāsi ",
  "vv6:4.4": "yassa kammass' idaṃ phalaṃ: [=6].5 ",
  "vv6:5.1": "Ahaṃ manussesu manussabhūtā ",
  "vv6:5.2": "purimāya jātiyā manussaloke ",
  "vv6:5.3": "disvāna bhikkhū tasite kilante ",
  "vv6:5.4": "uṭṭhāya pātuṃ udakaṃ adāsiṃ. [=6].6 ",
  "vv6:6.1": "Yo ve kilantāna pipāsitānaṃ ",
  "vv6:6.2": "uṭṭhāya pātuṃ udakaṃ dadāti ",
  "vv6:6.3": "sītodakā tassa bhavanti najjo ",
  "vv6:6.4": "pahūtamalyā bahupuṇḍarīkā. [=6].7 ",
  "vv6:7.1": "Tam āpagā anupariyanti sabbadā ",
  "vv6:7.2": "sītodakā vālukasanthatā nadī ",
  "vv6:7.3": "ambā ca sālā tilakā ca jambuyo ",
  "vv6:7.4": "uddālakā pāṭaliyo ca phullā. [=6].8 ",
  "vv6:8.1": "Taṃ bhūmibhāgehi upetarūpaṃ ",
  "vv6:8.2": "vimānaseṭṭhaṃ bhusa sobhamānaṃ ",
  "vv6:8.3": "tassīdha kammassa ayaṃ vipāko ",
  "vv6:8.4": "etādisaṃ puññakatā labhanti. [=6].9 ",
  "vv6:9.1": "Tena m' etādiso vaṇṇo ",
  "vv6:9.2": "tena me idha-m-ijjhati ",
  "vv6:9.3": "uppajjanti ca me bhogā ",
  "vv6:9.4": "ye keci manaso piyā. [=6].10 ",
  "vv6:10.1": "Akkhāmi te bhikkhu mahānubhāva ",
  "vv6:10.2": "manussabhūtā yam akāsi puññaṃ ",
  "vv6:10.3": "ten' amhi evaṃ jalitānubhāvā ",
  "vv6:10.4": "vaṇṇo ca me sabbadisā pabhāsatī ti. ",
  "vv6:11.1": "Paṭhamanāvāvimānaṃ [=7].1 "
}
