{
  "vv29:0.1": "",
  "vv29:0.2": "",
  "vv29:0.3": "",
  "vv29:0.4": "",
  "vv29:1.1": "Uḷāro te yaso vaṇṇo ",
  "vv29:1.2": "sabbā obhāsate disā ",
  "vv29:1.3": "nāriyo naccanti gāyanti ",
  "vv29:1.4": "devaputtā alaṅkatā. [=29].2 ",
  "vv29:2.1": "Modenti parivārenti ",
  "vv29:2.2": "tava pūjāya devate ",
  "vv29:2.3": "sovaṇṇāni vimānāni ",
  "vv29:2.4": "tav' imāni sudassane. [=29].3 ",
  "vv29:3.1": "Tuvaṃ si issarā tesaṃ ",
  "vv29:3.2": "sabbakāmasamiddhinī ",
  "vv29:3.3": "abhijātā mahantāsi ",
  "vv29:3.4": "devakāye pamodasi, ",
  "vv29:3.5": "devate pucchitācikkha ",
  "vv29:3.6": "kissa kammass' idaṃ phalaṃ. [=29].4 Kena t' etādiso vaṇṇo kena te idha-m-ijjhati uppajjanti ca te bhogā ye keci manaso piyā. [=29].5 Pucchāmi taṃ devi mahānubhāve manussabhūtā kim akāsi puññaṃ kenāsi evaṃ jalitānubhāvā vaṇṇo ca te sabbadisā pabhāsatī ti. [=29].6 Sā devatā attamanā Moggallānena pucchitā pañhaṃ puṭṭhā viyākāsi yassa kammass' idaṃ phalaṃ: [=29].7 ",
  "vv29:4.1": "Ahaṃ manussesu manussabhūtā ",
  "vv29:4.2": "purimāya jātiyā manussaloke ",
  "vv29:4.3": "dussīlakule suṇisā ahosiṃ ",
  "vv29:4.4": "assaddhesu kadariyesu ahaṃ. [=29].8 ",
  "vv29:5.1": "Saddhā sīlena sampannā ",
  "vv29:5.2": "saṃvibhāgaratā sadā ",
  "vv29:5.3": "piṇḍāya caramānassa ",
  "vv29:5.4": "apūvaṃ te adās' ahaṃ. [=29].9 ",
  "vv29:6.1": "Tadāhaṃ sassuyācikkhiṃ: ",
  "vv29:6.2": "samaṇo āgato idha ",
  "vv29:6.3": "tassa adās' ahaṃ pūvaṃ ",
  "vv29:6.4": "pasannā sehi pāṇihi. [=29].10 ",
  "vv29:7.1": "Iti ssā sassu paribhāsi: ",
  "vv29:7.2": "avinītā tuvaṃ vadhū ",
  "vv29:7.3": "na maṃ sampucchituṃ icchi: ",
  "vv29:7.4": "samaṇassa dadām' ahaṃ. [=29].11 ",
  "vv29:8.1": "Tato me sassu kupitā ",
  "vv29:8.2": "pahāsi musalena maṃ ",
  "vv29:8.3": "kūṭaṅg' acchi avadhi maṃ ",
  "vv29:8.4": "nāsakkhim jīvituṃ ciraṃ. [=29].12 ",
  "vv29:9.1": "Sā ahaṃ kāyassa bhedā ",
  "vv29:9.2": "vippamuttā tato cutā ",
  "vv29:9.3": "devānaṃ Tāvatiṃsānaṃ ",
  "vv29:9.4": "upapannā sahavyataṃ. [=29].13 ",
  "vv29:10.1": "Tena m' etādiso vaṇṇo ",
  "vv29:10.2": "tena me idha-m-ijjhati uppajjanti ca me bhogā ye keci manaso piyā. [=29].14 Akkhāmi te bhikkhu mahānubhāva manussabhūtā yam ahaṃ akāsiṃ ten' amhi evaṃ jalitānubhāvā ",
  "vv29:10.3": "vaṇṇo ca me sabbadisā pabhāsatī ti. ",
  "vv29:11.1": "Uḷāravimānaṃ [=30].1 "
}
