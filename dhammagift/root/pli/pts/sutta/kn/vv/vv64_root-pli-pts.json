{
  "vv64:0.1": "",
  "vv64:0.2": "",
  "vv64:0.3": "",
  "vv64:0.4": "",
  "vv64:1.1": "Sahassayuttaṃ hayavāhanaṃ subhaṃ ",
  "vv64:1.2": "āruyh' imaṃ sandanaṃ nekacittaṃ ",
  "vv64:1.3": "uyyānabhūmiṃ abhito anukkamaṃ ",
  "vv64:1.4": "purindado bhūtapatīva Vāsavo. [=64].2 ",
  "vv64:2.1": "Sovaṇṇamayā te rathakubbarā ubho ",
  "vv64:2.2": "thalehi aṃsehi atīva saṅgatā ",
  "vv64:2.3": "sujātagumbā naravīraniṭṭhitā ",
  "vv64:2.4": "virocatī paṇṇarase va cando. [=64].3 ",
  "vv64:3.1": "Suvaṇṇajālāvatato ratho ayaṃ ",
  "vv64:3.2": "bahūhi nānāratanehi cittito ",
  "vv64:3.3": "sunandighoso ca subhassaro ca ",
  "vv64:3.4": "virocatī cāmarahatthabāhuhi. [=64].4 ",
  "vv64:4.1": "Imā ca nābhyo manasābhinimmitā ",
  "vv64:4.2": "rathassa pādantaramajjhabhūsitā ",
  "vv64:4.3": "imā ca nābhyo satarājicittitā ",
  "vv64:4.4": "sateratā vijju-r-iva ppabhāsare. [=64].5 ",
  "vv64:5.1": "Anekacittāvatato ratho ayaṃ ",
  "vv64:5.2": "puthū ca nemī ca sahassaraṃsiko ",
  "vv64:5.3": "tesaṃ saro suyyati vaggurūpo ",
  "vv64:5.4": "pañcaṅgikaṃ turiyam iva ppavāditaṃ. [=64].6 ",
  "vv64:6.1": "Sirasmiṃ cittaṃ maṇicandakappitaṃ ",
  "vv64:6.2": "sadā visuddhaṃ ruciraṃ pabhassaraṃ ",
  "vv64:6.3": "suvaṇṇarājīhi atīva saṅgataṃ ",
  "vv64:6.4": "veḷuriyarājiva atīva sobhati. [=64].7 ",
  "vv64:7.1": "Ime ca vāḷī maṇicandakappitā ",
  "vv64:7.2": "ārohakambū sujavā brahūpamā ",
  "vv64:7.3": "brahā mahantā balino mahājavā ",
  "vv64:7.4": "mano tav' aññāya tath' eva siṃsare. [=64].8 ",
  "vv64:8.1": "Ime ca sabbe sahitā catukkamā ",
  "vv64:8.2": "mano tav' aññāya tath' eva siṃsare ",
  "vv64:8.3": "samaṃ vahantā mudukā anuddhatā ",
  "vv64:8.4": "āmodamānā turagānam uttamā. [=64].9 ",
  "vv64:9.1": "Dhunanti vagganti patanti c' ambare ",
  "vv64:9.2": "abbhuddhunantā sukate pilandhane ",
  "vv64:9.3": "tesaṃ saro suyyati vaggurūpo ",
  "vv64:9.4": "pañcaṅgikaṃ turiyam iva ppavāditaṃ. [=64].10 ",
  "vv64:10.1": "Rathassa ghoso apilandhanāna ca ",
  "vv64:10.2": "khurassa nādo abhihiṃsanāya ca ",
  "vv64:10.3": "ghoso suvaggū samitassa suyyati ",
  "vv64:10.4": "gandhabbaturiyāni vicitrasaṃvane. [=64].11 ",
  "vv64:11.1": "Rathe ṭhitā tā migamandalocanā ",
  "vv64:11.2": "āḷārapamhā hasitā piyaṃvadā ",
  "vv64:11.3": "veḷuriyajālāvatatā tanucchavā ",
  "vv64:11.4": "sad' eva gandhabbasuraggapūjitā. [=64].12 ",
  "vv64:12.1": "Tā rattarattambarapītavāsasā ",
  "vv64:12.2": "visālanettā abhirattalocanā ",
  "vv64:12.3": "kule sujātā sutanū sucimhitā ",
  "vv64:12.4": "rathe ṭhitā pañjalikā upaṭṭhitā. [=64].13 ",
  "vv64:13.1": "Tā kambukāyuradharā suvāsasā ",
  "vv64:13.2": "sumajjhimā ūruthan' ūpapannā ",
  "vv64:13.3": "vaṭṭ' aṅgulīyo sumukhā sudassanā ",
  "vv64:13.4": "rathe ṭhitā pañjalikā upaṭṭhitā. [=64].14 ",
  "vv64:14.1": "Aññā suveṇī susu missakesiyo ",
  "vv64:14.2": "samaṃ vibhattāhi pabhassarāhi ca ",
  "vv64:14.3": "anubbatā tā tava mānase ratā ",
  "vv64:14.4": "rathe ṭhitā pañjalikā upaṭṭhitā. [=64].15 ",
  "vv64:15.1": "Āveḷiniyo padumuppalacchadā ",
  "vv64:15.2": "alaṅkatā candanasāravāsitā ",
  "vv64:15.3": "anubbatā tā tava mānase ratā ",
  "vv64:15.4": "rathe ṭhitā pañjalikā upaṭṭhitā. [=64].16 ",
  "vv64:16.1": "Tā māliniyo padumuppalacchadā ",
  "vv64:16.2": "alaṅkatā candanasāravāsitā ",
  "vv64:16.3": "anubbatā tā tava mānase ratā ",
  "vv64:16.4": "rathe ṭhitā pañjalikā upaṭṭhitā. [=64].17 ",
  "vv64:17.1": "Kaṇṭhesu te yāni pilandhanāni ",
  "vv64:17.2": "hatthesu pādesu tath' eva sīse ",
  "vv64:17.3": "obhāsayantī dasa sabbaso disā ",
  "vv64:17.4": "abbhuddayaṃ sāradiko va bhānumā. [=64].18 ",
  "vv64:18.1": "Vātassa vegena ca sampakampitā ",
  "vv64:18.2": "bhujesu mālā apilandhanāni ca ",
  "vv64:18.3": "muñcanti ghosaṃ ruciraṃ suciṃ subhaṃ ",
  "vv64:18.4": "sabbehi viññūhi sutabbarūpaṃ. [=64].19 ",
  "vv64:19.1": "Uyyānabhūmyā ca duvaddhato ṭhitā ",
  "vv64:19.2": "rathā ca nāgā turiyāni ca ssaro ",
  "vv64:19.3": "tam eva devinda pamodayanti ",
  "vv64:19.4": "vīṇā yathā pokkharapattabāhuhi. [=64].20 ",
  "vv64:20.1": "Imāsu vīṇāsu bahūsu vaggusu ",
  "vv64:20.2": "manuññarūpāsu hadayeritaṃ pati ",
  "vv64:20.3": "pavajjamānāsu atīva accharā ",
  "vv64:20.4": "bhamanti kaññā padumesu sikkhitā. [=64].21 ",
  "vv64:21.1": "Yadā ca gītāni ca vāditāni ca ",
  "vv64:21.2": "naccāni cemāni samenti ekato ",
  "vv64:21.3": "ath' ettha naccanti ath' ettha accharā ",
  "vv64:21.4": "obhāsayantī dubhato varitthiyo. [=64].22 ",
  "vv64:22.1": "So modasi turiyagaṇappabodhano ",
  "vv64:22.2": "mahīyamāno vajirāvudho-r-iva ",
  "vv64:22.3": "imāsu vīṇāsu bahūsu vaggusu ",
  "vv64:22.4": "manuññarūpāsu hadayeritaṃ pati. [=64].23 ",
  "vv64:23.1": "Kiṃ tvaṃ pure kammam akāsi attanā ",
  "vv64:23.2": "manussabhūto purimāya jātiyā ",
  "vv64:23.3": "uposathaṃ kaṃ vā tuvaṃ upāvasi ",
  "vv64:23.4": "kaṃ dhammacariyaṃ vatam ābhirocayi. [=64].24 Na-y-idaṃ ",
  "vv64:24.1": "appassa katassa kammuno ",
  "vv64:24.2": "pubbe suciṇṇassa uposathassa vā ",
  "vv64:24.3": "iddhānubhāvo vipulo ayaṃ tava ",
  "vv64:24.4": "yaṃ devasaṅghaṃ abhirocase bhusaṃ. [=64].25 ",
  "vv64:25.1": "Dānassa te idaṃ phalaṃ ",
  "vv64:25.2": "atho sīlassa vā pana ",
  "vv64:25.3": "atho añjalikammassa ",
  "vv64:25.4": "taṃ me akkhāhi pucchito ti. [=64].26 ",
  "vv64:26.1": "So devaputto attamano ",
  "vv64:26.2": "Moggallānena pucchito ",
  "vv64:26.3": "pañhaṃ puṭṭho viyākāsi ",
  "vv64:26.4": "yassa kammass' idaṃ phalan ti. [=64].27 ",
  "vv64:27.1": "Jitindriyaṃ buddham anomanikkamaṃ ",
  "vv64:27.2": "naruttamaṃ Kassapam aggapuggalaṃ ",
  "vv64:27.3": "avāpurantaṃ amatassa dvāraṃ ",
  "vv64:27.4": "devātidevaṃ satapuññalakkhaṇaṃ, [=64].28 ",
  "vv64:28.1": "Tam addasaṃ kuñjaram oghatiṇṇaṃ ",
  "vv64:28.2": "suvaṇṇasiṅgīnadabimbasādisaṃ ",
  "vv64:28.3": "disvāna taṃ khippam ahuṃ sucīmano ",
  "vv64:28.4": "tam eva disvāna subhāsitaddhajaṃ. [=64].29 ",
  "vv64:29.1": "Tamh' annapānaṃ athavā pi cīvaraṃ ",
  "vv64:29.2": "suciṃ paṇitaṃ rasasā upetaṃ ",
  "vv64:29.3": "pupphābhikiṇṇamhi sake nivesane ",
  "vv64:29.4": "patiṭṭhapesiṃ sa asaṅgamānaso. [=64].30 ",
  "vv64:30.1": "Tam annapānena ca cīvarena ca ",
  "vv64:30.2": "khajjena bhojjena ca sāyanena ca ",
  "vv64:30.3": "santappayitvā dvipadānam uttamaṃ. ",
  "vv64:30.4": "so saggaso devapure ramām' ahaṃ. [=64].31 ",
  "vv64:31.1": "Eten' upāyena imaṃ niraggaḷaṃ ",
  "vv64:31.2": "yaññaṃ yajitvā tividhaṃ visuddhaṃ ",
  "vv64:31.3": "pahāy' ahaṃ mānusakaṃ samussayaṃ ",
  "vv64:31.4": "Indūpamo devapure ramām' ahaṃ. [=64].32 ",
  "vv64:32.1": "Āyuñ ca vaṇṇañ ca sukhaṃ balañ ca ",
  "vv64:32.2": "paṇītarūpaṃ abhikaṅkhatā muni ",
  "vv64:32.3": "annañ ca pānañ ca bahuṃ susaṅkhataṃ ",
  "vv64:32.4": "patiṭṭhapetabbam asaṅgamānase. [=64].33 ",
  "vv64:33.1": "Na-y-imasmim loke parasmiṃ vā pana ",
  "vv64:33.2": "buddhena seṭṭho va samo va vijjati ",
  "vv64:33.3": "āhuneyyānaṃ paramāhutiṃ gato ",
  "vv64:33.4": "puññatthikānaṃ vipulapphalesinan ti. ",
  "vv64:34.1": "Mahārathavimānaṃ ",
  "vv64:34.2": "",
  "vv64:35.1": "Tass' uddānaṃ: ",
  "vv64:36.1": "Maṇḍūko Revatī Chatto ",
  "vv64:36.2": "kakkaṭo dvārapālako ",
  "vv64:36.3": "dve karaṇīyā dve sūcī ",
  "vv64:36.4": "tayo nāgā ca dve rathā; ",
  "vv64:36.5": "purisānaṃ paṭhamo vaggo pavuccatī ti. [=65].1 ",
  "vv64:37.1": ""
}
