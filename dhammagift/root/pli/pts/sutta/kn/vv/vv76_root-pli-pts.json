  "vv76:0.4": "",
  "vv76:1.1": "Yathā vanaṃ Nandanaṃ Cittalataṃ ",
  "vv76:1.2": "uyyānaseṭṭhaṃ Tidasānam uttamaṃ ",
  "vv76:1.3": "tathūpamaṃ tuyham idaṃ vimānaṃ ",
  "vv76:1.4": "obhāsayaṃ tiṭṭhati antalikkhe. [=76].2 ",
  "vv76:2.1": "Deviddhipatto 'si mahānubhāvo ",
  "vv76:2.2": "manussabhūto kim akāsi puññaṃ ",
  "vv76:2.3": "kenāsi evaṃ jalitānubhāvo ",
  "vv76:2.4": "vaṇṇo ca te sabbadisā pabhāsatī ti. [=76].3 ",
  "vv76:3.1": "So devaputto attamano ",
  "vv76:3.2": "Moggallānena pucchito pañhaṃ puṭṭho viyākāsi ",
  "vv76:3.3": "yassa kammass' idaṃ phalaṃ. [=76].4 ",
  "vv76:4.1": "Ahaṃ manussesu manussabhūto ",
  "vv76:4.2": "daliddo atāṇo kapaṇo kammakaro ahosiṃ ",
  "vv76:4.3": "jiṇṇe ca mātāpitaro abhāriṃ ",
  "vv76:4.4": "piyā ca me sīlavanto ahesuṃ ",
  "vv76:4.5": "annañ ca pānañ ca pasannacitto ",
  "vv76:4.6": "sakkacca dānaṃ vipulaṃ adāsiṃ. [=76].5 ",
  "vv76:5.1": "Tena m' etādiso vaṇṇo ",
  "vv76:5.2": "tena me idha-m-ijjhati uppajjanti ca me bhogā ye keci manaso piyā. [=76].6 Akkhāmi te bhikkhu mahānubhāva manussabhūto yam akāsi puññaṃ ten' amhi evaṃ jalitānubhāvo ",
  "vv76:5.3": "vaṇṇo ca me sabbadisā pabhāsatī ti. Nandanavimānaṃ [=77].1 Uccam idaṃ ",
  "vv76:6.1": ""
}
