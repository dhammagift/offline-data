  "vv7:0.1": "",
  "vv7:0.2": "",
  "vv7:0.3": "",
  "vv7:0.4": "",
  "vv7:1.1": "Suvaṇṇacchadanaṃ nāvaṃ ",
  "vv7:1.2": "nāri āruyha tiṭṭhasi ",
  "vv7:1.3": "ogāhasi pokkharaṇiṃ ",
  "vv7:1.4": "padmaṃ chindasi pāṇinā. [=7].2 ",
  "vv7:2.1": "kena t' etādiso vaṇṇo ",
  "vv7:2.2": "kena te idha-m-ijjhati ",
  "vv7:2.3": "uppajjanti ca te bhogā ",
  "vv7:2.4": "ye keci manaso piyā. [=7].3 ",
  "vv7:3.1": "Pucchāmi taṃ devi mahānubhāve ",
  "vv7:3.2": "manussabhūtā kim akāsi puññaṃ ",
  "vv7:3.3": "kenāsi evaṃ jahitānubhāvā ",
  "vv7:3.4": "vaṇṇo ca te sabbadisā pabhāsatī ti. [=7].4 ",
  "vv7:4.1": "Sā devatā attamanā ",
  "vv7:4.2": "Moggallānena pucchitā ",
  "vv7:4.3": "pañhaṃ puṭṭhā viyākāsi ",
  "vv7:4.4": "yassa kammass' idaṃ phalaṃ: [=7].5 ",
  "vv7:5.1": "Ahaṃ manussesu manussabhūtā ",
  "vv7:5.2": "purimāya jātiyā manussaloke ",
  "vv7:5.3": "disvāna bhikkhuṃ tasitaṃ kilantaṃ ",
  "vv7:5.4": "uṭṭhāya pātuṃ udakaṃ adāsiṃ. [=7].6 ",
  "vv7:6.1": "Yo ve kilantassa pipāsitassa ",
  "vv7:6.2": "uṭṭhāya pātuṃ udakaṃ dadāti ",
  "vv7:6.3": "sītodakā tassa bhavanti najjo ",
  "vv7:6.4": "pahūtamalyā bahupuṇḍarīkā . [=7].7 ",
  "vv7:7.1": "Tam āpagā anupariyanti sabbadā ",
  "vv7:7.2": "sītodakā vālukasanthatā nadī ",
  "vv7:7.3": "ambā ca sālā tilakā ca jambuyo ",
  "vv7:7.4": "uddālakā pāṭaliyo ca phullā. [=7].8 ",
  "vv7:8.1": "Taṃ bhūmibhāgehi upetarūpaṃ ",
  "vv7:8.2": "vimānaseṭṭhaṃ bhusa sobhamānaṃ ",
  "vv7:8.3": "tassīdha kammassa ayaṃ vipāko ",
  "vv7:8.4": "etādisaṃ puññakatā labhanti. [=7].9 ",
  "vv7:9.1": "Tena m' etādiso vaṇṇo ",
  "vv7:9.2": "tena me idha-m-ijjhati ",
  "vv7:9.3": "uppajjanti ca me bhogā ",
  "vv7:9.4": "ye keci manaso piyā. [=7].10 ",
  "vv7:10.1": "Akkhāmi te bhikkhu mahānubhāva ",
  "vv7:10.2": "manussabhūtā yam akāsi puññaṃ ",
  "vv7:10.3": "ten' amhi evaṃ jalitānubhāvā ",
  "vv7:10.4": "vaṇṇo ca me sabbadisā pabhāsatī ti. ",
  "vv7:11.1": "Dutiyanāvāvimānaṃ [=8].1 "
}
