  "vv13:0.1": "",
  "vv13:0.2": "",
  "vv13:0.3": "",
  "vv13:0.4": "",
  "vv13:1.1": "Abhikkantena vaṇṇena ",
  "vv13:1.2": "yā tvaṃ tiṭṭhasi devate ",
  "vv13:1.3": "obhāsentī disā sabbā ",
  "vv13:1.4": "osadhī viya tārakā, [=13].2 ",
  "vv13:2.1": "Kena t' etādiso vaṇṇo ",
  "vv13:2.2": "kena te idha-m-ijjhati ",
  "vv13:2.3": "uppajjanti ca te bhogā ",
  "vv13:2.4": "ye keci manaso piyā. [=13].3 ",
  "vv13:3.1": "Pucchāmi taṃ devi mahānubhāve ",
  "vv13:3.2": "manussabhūtā kim akāsi puññaṃ ",
  "vv13:3.3": "kenāsi evaṃ jalitānubhāvā ",
  "vv13:3.4": "vaṇṇo ca te sabbadisā pabhāsatī ti. [=13].4 ",
  "vv13:4.1": "Sā devatā attamanā ",
  "vv13:4.2": "Moggallānena pucchitā ",
  "vv13:4.3": "pañhaṃ puṭṭhā viyākāsi ",
  "vv13:4.4": "yassa kammass' idaṃ phalaṃ: [=13].5 ",
  "vv13:5.1": "Ahaṃ manussesu manussabhūtā ",
  "vv13:5.2": "suṇisā ahosiṃ sasurassa gehe ",
  "vv13:6.1": "addasaṃ virajaṃ bhikkhuṃ ",
  "vv13:6.2": "vippasannam anāvilaṃ. [=13].6 ",
  "vv13:6.3": "Tassa adās' ahaṃ pūvaṃ ",
  "vv13:6.4": "pasannā sehi pāṇihi ",
  "vv13:6.5": "bhāgaḍḍhabhāgaṃ datvāna ",
  "vv13:6.6": "modāmi Nandane vane. [=13].7 ",
  "vv13:7.1": "Tena m' etādiso vaṇṇo ",
  "vv13:7.2": "tena me idha-m-ijjhati ",
  "vv13:7.3": "uppajjanti ca me bhogā ",
  "vv13:7.4": "ye keci manaso piyā. [=13].8 ",
  "vv13:8.1": "Akkhāmi te bhikkhu mahānubhāva ",
  "vv13:8.2": "manussabhūtā yam akāsi puññaṃ ",
  "vv13:8.3": "ten' amhi evaṃ jalitānubhāvā ",
  "vv13:8.4": "vaṇṇo ca me sabbadisā pabhāsatī ti. ",
  "vv13:9.1": "Paṭhamasuṇisāvimānaṃ [=14].1 "
}
