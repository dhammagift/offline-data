  "vv51:0.1": "",
  "vv51:0.2": "",
  "vv51:0.3": "",
  "vv51:0.4": "",
  "vv51:1.1": "Ko me vandati pādāni ",
  "vv51:1.2": "iddhiyā yasasā jalaṃ ",
  "vv51:1.3": "abhikkantena vaṇṇena ",
  "vv51:1.4": "sabbā obhāsayaṃ disā ti. [=51].2 ",
  "vv51:2.1": "Maṇḍūko 'haṃ pure āsiṃ ",
  "vv51:2.2": "udake vārigocaro ",
  "vv51:2.3": "tava dhammaṃ suṇantassa ",
  "vv51:2.4": "avadhī vacchapālako. [=51].3 ",
  "vv51:3.1": "Muhuttaṃ cittappasādassa ",
  "vv51:3.2": "iddhiṃ passa yasañ ca me ",
  "vv51:3.3": "ānubhāvañ ca me passa ",
  "vv51:3.4": "vaṇṇaṃ passa jutiñ ca me: [=51].4 ",
  "vv51:4.1": "Ye ca te dīgham addhānaṃ ",
  "vv51:4.2": "dhammaṃ assosuṃ Gotama ",
  "vv51:4.3": "pattā te acalaṭṭhānaṃ ",
  "vv51:4.4": "yattha gantvā na socare ti. ",
  "vv51:5.1": "Maṇḍūkadevaputtavimānaṃ [=52].1 "
}
