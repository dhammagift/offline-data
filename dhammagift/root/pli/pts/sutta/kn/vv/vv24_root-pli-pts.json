{
  "vv24:0.1": "",
  "vv24:0.2": "",
  "vv24:0.3": "",
  "vv24:0.4": "",
  "vv24:1.1": "Abhikkantena vaṇṇena ",
  "vv24:1.2": "yā tvaṃ tiṭṭhasi devate ",
  "vv24:1.3": "obhāsentī disā sabbā ",
  "vv24:1.4": "osadhī viya tārakā, [=24].2 ",
  "vv24:2.1": "Kena t' etādiso vaṇṇo ",
  "vv24:2.2": "kena te idha-m-ijjhati uppajjanti ca te bhogā ye keci manaso piyā. [=24].3 Pucchāmi taṃ devi mahānubhāve manussabhūtā kim akāsi puññaṃ kenāsi evaṃ jalitānubhāvā ",
  "vv24:2.3": "vaṇṇo ca te sabbadisā pabhāsatī ti. [=24].4 ",
  "vv24:3.1": "Sā devatā attamanā ",
  "vv24:3.2": "Moggallānena pucchitā pañhaṃ puṭṭhā viyākāsi ",
  "vv24:3.3": "yassa kammass' idaṃ phalam: [=24].5 ",
  "vv24:4.1": "Uposathā ti maṃ aññiṃsu ",
  "vv24:4.2": "Sāketāyaṃ upāsikā ",
  "vv24:4.3": "saddhā sīlena sampannā ",
  "vv24:4.4": "saṃvibhāgaratā sadā. [=24].6 ",
  "vv24:5.1": "Acchādanañ ca bhattañ ca ",
  "vv24:5.2": "senāsanaṃ padīpiyaṃ ",
  "vv24:5.3": "adāsiṃ ujubhūtesu ",
  "vv24:5.4": "vippasannena cetasā. [=24].7 ",
  "vv24:6.1": "Cātuddasiṃ pañcadasiṃ ",
  "vv24:6.2": "yā ca pakkhassa aṭṭhamī ",
  "vv24:6.3": "pāṭihāriyapakkhañ ca ",
  "vv24:6.4": "aṭṭhaṅgasusamāgataṃ ",
  "vv24:7.1": "uposathaṃ upavasissaṃ ",
  "vv24:7.2": "sadā sīlesu saṃvutā. [=24].8 ",
  "vv24:7.3": "",
  "vv24:7.4": "",
  "vv24:8.1": "Pāṇātipātā viratā ",
  "vv24:8.2": "musāvādā ca saññatā ",
  "vv24:8.3": "theyyā ca aticārā ca ",
  "vv24:8.4": "majjapānā ca ārakā [=24].9 ",
  "vv24:9.1": "Pañcasikkhāpade ratā ",
  "vv24:9.2": "ariyasaccāna kovidā ",
  "vv24:9.3": "upāsikā cakkhumato ",
  "vv24:9.4": "Gotamassa yasassino. [=24].10 ",
  "vv24:10.1": "Tena m' etādiso vaṇṇo ",
  "vv24:10.2": "tena me idha-m-ijjhati uppajjanti ca me bhogā ye keci manaso piyā. [=24].11 Akkhāmi te bhikkhu mahānubhāva manussabhūtā yam ahaṃ akāsiṃ ten' amhi evaṃ jalitānubhāvā ",
  "vv24:10.3": "vaṇṇo ca me sabbadisā pabhāsatī ti. [=24].12 ",
  "vv24:11.1": "Abhikkhaṇaṃ Nandanaṃ sutvā ",
  "vv24:11.2": "chando me upapajjatha ",
  "vv24:11.3": "tattha cittaṃ paṇidhāya ",
  "vv24:11.4": "upapanna 'mhi Nandanaṃ. [=24].13 ",
  "vv24:12.1": "Nākāsiṃ satthu vacanaṃ ",
  "vv24:12.2": "buddhass' ādiccabandhuno ",
  "vv24:12.3": "hīne cittaṃ paṇidhāya ",
  "vv24:12.4": "sāmhi pacchānutāpinī. [=24].14 ",
  "vv24:13.1": "Kīva ciraṃ vimānasmiṃ ",
  "vv24:13.2": "idha vassas' Uposathe ",
  "vv24:13.3": "devate pucchitācikkha ",
  "vv24:13.4": "yadi jānāsi āyuno. [=24].15 ",
  "vv24:14.1": "Saṭṭhivassasahassāni ",
  "vv24:14.2": "tisso ca vassakoṭiyo ",
  "vv24:14.3": "idha ṭhatvā mahāmuni ",
  "vv24:14.4": "ito cutā gamissāmi ",
  "vv24:14.5": "manussānaṃ sahavyatanti. [=24].16 ",
  "vv24:15.1": "Mā tvaṃ Uposathe bhāyi ",
  "vv24:15.2": "sambuddhenāsi vyākatā ",
  "vv24:15.3": "sotāpannā visesayi ",
  "vv24:15.4": "pahīnā tava duggatī ti. ",
  "vv24:16.1": "Uposathāvimānaṃ [=25].1 "
}
