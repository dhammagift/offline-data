  "vv14:0.1": "",
  "vv14:0.2": "",
  "vv14:0.3": "",
  "vv14:0.4": "",
  "vv14:1.1": "Abhikkantena vaṇṇena ",
  "vv14:1.2": "yā tvaṃ tiṭṭhasi devate ",
  "vv14:1.3": "obhāsentī disā sabbā ",
  "vv14:1.4": "osadhī viya tārakā, [=14].2 ",
  "vv14:2.1": "Kena t' etādiso vaṇṇo ",
  "vv14:2.2": "kena te idha-m-ijjhati ",
  "vv14:2.3": "uppajjanti ca te bhogā ",
  "vv14:2.4": "ye keci manaso piyā. [=14].3 ",
  "vv14:3.1": "Pucchāmi taṃ devi mahānubhāve ",
  "vv14:3.2": "manussabhūtā kim akāsi puññaṃ ",
  "vv14:3.3": "kenāsi evaṃ jalitānubhāvā ",
  "vv14:3.4": "vaṇṇo ca te sabbadisā pabhāsatī ti. [=14].4 ",
  "vv14:4.1": "Sā devatā attamanā ",
  "vv14:4.2": "Moggallānena pucchitā ",
  "vv14:4.3": "pañhaṃ puṭṭhā viyākāsi ",
  "vv14:4.4": "yassa kammass' idam phalaṃ: [=14].5 ",
  "vv14:5.1": "Ahaṃ manussesu manussabhūtā ",
  "vv14:5.2": "suṇisā ahosiṃ sasurassa gehe ",
  "vv14:6.1": "addasaṃ virajaṃ bhikkhuṃ ",
  "vv14:6.2": "vippasannam anāvilaṃ. [=14].6 ",
  "vv14:6.3": "Tassa adās' ahaṃ bhāgaṃ ",
  "vv14:6.4": "pasannā sehi pāṇihi ",
  "vv14:6.5": "kummāsapiṇḍaṃ datvāna ",
  "vv14:6.6": "modāmi Nandane vane. [=14].7 ",
  "vv14:7.1": "Tena m' etādiso vaṇṇo ",
  "vv14:7.2": "tena me idha-m-ijjhati ",
  "vv14:7.3": "uppajjanti ca me bhogā ",
  "vv14:7.4": "ye keci manaso piyā. [=14].8 ",
  "vv14:8.1": "Akkhāmi te bhikkhu mahānubhāva ",
  "vv14:8.2": "manussabhūtā yam akāsi puññaṃ ",
  "vv14:8.3": "ten' amhi evaṃ jalitānubhāvā ",
  "vv14:8.4": "vaṇṇo ca me sabbadisā pabhāsatī ti. ",
  "vv14:9.1": "Dutiyasuṇisāvimānaṃ [=15].1 "
}
