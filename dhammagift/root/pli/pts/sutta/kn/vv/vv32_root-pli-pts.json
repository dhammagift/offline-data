{
  "vv32:0.1": "",
  "vv32:0.2": "",
  "vv32:0.3": "",
  "vv32:0.4": "",
  "vv32:1.1": "Latā ca Sajjā Pavarā ca devatā ",
  "vv32:1.2": "Accimatī rājavarassa sirīmato ",
  "vv32:1.3": "Sutā ca rañño Vessavaṇassa dhītā ",
  "vv32:1.4": "rājīmatī dhammaguṇehi sobhatha. [=32].2 ",
  "vv32:2.1": "Pañc' ettha nāriyo agamaṃsu nhāyituṃ ",
  "vv32:2.2": "sītodakaṃ uppaliniṃ sivaṃ nadiṃ ",
  "vv32:2.3": "tā tattha nhāyitvā rametva devatā ",
  "vv32:2.4": "naccitva gāyitva Sutā Lataṃ bravi: [=32].3 ",
  "vv32:3.1": "Pucchāmi taṃ uppalamāladhārinī ",
  "vv32:3.2": "āveḷinī kañcanasannibhattace ",
  "vv32:3.3": "timīratambakkhi nabheva sobhane ",
  "vv32:3.4": "dīghāyukī kena kato yaso tava. [=32].4 ",
  "vv32:4.1": "Kenāsi bhadde patino piyatarā ",
  "vv32:4.2": "visiṭṭhakalyāṇitar' assu rūpato ",
  "vv32:4.3": "padakkhiṇā naccagītavādite ",
  "vv32:4.4": "ācikkha no tvaṃ naranāripucchitā ti. [=32].5 ",
  "vv32:5.1": "Ahaṃ manussesu manussabhūtā ",
  "vv32:5.2": "uḷārabhoge kule suṇisā ahosiṃ ",
  "vv32:5.3": "akkodhanā bhattu vasānuvattinī appamattā ",
  "vv32:5.4": "uposathe[ahosiṃ]. [=32].6 ",
  "vv32:6.1": "Manussabhūtā daharā apāpikā ",
  "vv32:6.2": "pasannacittā patim ābhirādhayiṃ ",
  "vv32:6.3": "sadevaraṃ sassasuraṃ sadāsakaṃ ",
  "vv32:6.4": "abhirādhayiṃ tamhi kato yaso mama. [=32].7 ",
  "vv32:7.1": "Sāhaṃ tena kusalena kammunā ",
  "vv32:7.2": "catubbhi ṭhānehi visesam ajjhagā ",
  "vv32:7.3": "āyuñ ca vaṇṇañ ca sukhaṃ balañ ca ",
  "vv32:7.4": "khiḍḍāratiṃ paccanubhom' anappakaṃ. [=32].8 ",
  "vv32:8.1": "Sutaṃ nu taṃ bhāsati yaṃ ayaṃ Latā ",
  "vv32:8.2": "yaṃ no apucchimha akittayī no ",
  "vv32:8.3": "patino kir' amhākaṃ visiṭṭhanārinaṃ ",
  "vv32:8.4": "gatī ca tāsaṃ pavarā ca devatā. [=32].9 ",
  "vv32:9.1": "Patīsu dhammaṃ pacarāma sabbā ",
  "vv32:9.2": "patibbatā yattha bhavanti itthiyo ",
  "vv32:9.3": "patīsu dhammam pacaritva sabbā ",
  "vv32:9.4": "lacchāmase bhāsati yaṃ ayaṃ Latā. [=32].10 ",
  "vv32:10.1": "Sīho yathā pabbatasānugocaro ",
  "vv32:10.2": "mahiṃdharaṃ pabbatam āvasitvā ",
  "vv32:10.3": "pasayha hantvā itare catuppade ",
  "vv32:10.4": "khudde mige khādati maṃsabhojano, [=32].11 ",
  "vv32:11.1": "Tath' eva saddhā idha ariyasāvikā ",
  "vv32:11.2": "bhattāraṃ nissāya patiṃ anubbatā ",
  "vv32:11.3": "kodhaṃ vadhitvā abhibhuyya maccharaṃ ",
  "vv32:11.4": "saggamhi sā modati dhammacārinī ti. ",
  "vv32:12.1": "Latāvimānaṃ [=33].1 "
}
