  "vv21:0.4": "",
  "vv21:1.1": "Caṇḍālī vanda pādāni ",
  "vv21:1.2": "Gotamassa yasassino ",
  "vv21:1.3": "tam eva anukampāya ",
  "vv21:1.4": "aṭṭhāsi isisattamo. [=21].2 ",
  "vv21:2.1": "Abhippasādehi manaṃ ",
  "vv21:2.2": "arahantamhi tādini ",
  "vv21:2.3": "khippaṃ pañjalikā vanda ",
  "vv21:2.4": "parittaṃ tava jīvitan ti. [=21].3 ",
  "vv21:3.1": "Coditā bhāvitattena ",
  "vv21:3.2": "sarīrantimadhārinā: ",
  "vv21:3.3": "caṇḍālī vanda pādāni ",
  "vv21:3.4": "Gotamassa yasassino. [=21].4 ",
  "vv21:4.1": "Tam enaṃ avadhī gāvī ",
  "vv21:4.2": "caṇḍāliṃ pañjaliṃ ṭhitaṃ ",
  "vv21:4.3": "namassamānaṃ sambuddhaṃ ",
  "vv21:4.4": "andhakāre pabhaṅkaraṃ. [=21].5 ",
  "vv21:5.1": "Khīṇāsavaṃ vigatarajaṃ anejaṃ ",
  "vv21:5.2": "ekaṃ araññamhi raho nisinnaṃ ",
  "vv21:5.3": "deviddhipattā upasaṅkamitvā ",
  "vv21:5.4": "vandāmi taṃ vīra mahānubhāvā ti. [=21].6 ",
  "vv21:6.1": "Suvaṇṇavaṇṇā jalitā mahāyasā ",
  "vv21:6.2": "vimāna-m-oruyha anekacittā ",
  "vv21:6.3": "parivāritā accharāsaṅgaṇena ",
  "vv21:6.4": "kā tvaṃ subhe devate vandase mamam ti. [=21].7 ",
  "vv21:7.1": "Ahaṃ bhadante caṇḍālī ",
  "vv21:7.2": "tayā vīrena pesitā ",
  "vv21:7.3": "vandiṃ arahato pāde ",
  "vv21:7.4": "Gotamassa yasassino. [=21].8 ",
  "vv21:8.1": "Sāhaṃ vanditva pādāni ",
  "vv21:8.2": "cutā caṇḍālayoniyā ",
  "vv21:8.3": "vimānaṃ sabbaso bhaddaṃ ",
  "vv21:8.4": "upapanna 'mhi Nandane. [=21].9 ",
  "vv21:9.1": "Accharānaṃ satasahassaṃ ",
  "vv21:9.2": "purakkhatvāna tiṭṭhati ",
  "vv21:9.3": "tās' āhaṃ pavarā seṭṭhā ",
  "vv21:9.4": "vaṇṇena yasasāyunā. [=21].10 ",
  "vv21:10.1": "Pahūtakatakalyāṇā ",
  "vv21:10.2": "sampajānā patissatā ",
  "vv21:10.3": "muniṃ kāruṇikaṃ loke ",
  "vv21:10.4": "bhante vanditum āgatā. [=21].11 ",
  "vv21:11.1": "Idaṃ vatvāna caṇḍālī ",
  "vv21:11.2": "kataññū katavedinī ",
  "vv21:11.3": "vanditvā arahato pāde ",
  "vv21:11.4": "tatth' ev' antaradhāyathā ti. ",
  "vv21:12.1": "Caṇḍālivimānaṃ [=22].1 "
}
