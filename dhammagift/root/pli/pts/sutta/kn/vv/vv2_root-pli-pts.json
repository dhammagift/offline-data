  "vv2:0.1": "",
  "vv2:0.2": "",
  "vv2:0.3": "",
  "vv2:0.4": "",
  "vv2:1.1": "Pīṭhaṃ te veḷuriyamayaṃ uḷāraṃ ",
  "vv2:1.2": "manojavaṃ gacchati yena kāmaṃ ",
  "vv2:1.3": "alaṅkate malyadhare suvatthe ",
  "vv2:1.4": "obhāsasi vijju-r-iv' abbhakūṭaṃ. [=2].2 ",
  "vv2:2.1": "Kena t' etādiso vaṇṇo ",
  "vv2:2.2": "kena te idha-m-ijjhati ",
  "vv2:2.3": "uppajjanti ca te bhogā ",
  "vv2:2.4": "ye keci manaso piyā. [=2].3 ",
  "vv2:3.1": "Pucchāmi taṃ devi mahānubhāve ",
  "vv2:3.2": "manussabhūtā kim akāsi puññaṃ ",
  "vv2:3.3": "kenāsi evaṃ jalitānubhāvā ",
  "vv2:3.4": "vaṇṇo ca te sabbadisā pabhāsatī ti. [=2].4 ",
  "vv2:4.1": "Sā devatā attamanā ",
  "vv2:4.2": "Moggallānena pucchitā ",
  "vv2:4.3": "pañhaṃ puṭṭhā viyākāsi ",
  "vv2:4.4": "yassa kammass' idaṃ phalaṃ: [=2].5 ",
  "vv2:5.1": "Ahaṃ manussesu manussabhūtā ",
  "vv2:5.2": "abbhāgatān' āsanakaṃ adāsiṃ ",
  "vv2:5.3": "abhivādayiṃ añjalikaṃ akāsiṃ ",
  "vv2:5.4": "yathānubhāvañ ca adāsi dānaṃ. [=2].6 ",
  "vv2:6.1": "Tena m' etādiso vaṇṇo ",
  "vv2:6.2": "tena me idha-m-ijjhati ",
  "vv2:6.3": "uppajjanti ca me bhogā ",
  "vv2:6.4": "ye keci manaso piyā. [=2].7 ",
  "vv2:7.1": "Akkhāmi te bhikkhu mahānubhāva ",
  "vv2:7.2": "manussabhūtā yam akāsi puññaṃ ",
  "vv2:7.3": "ten' amhi evaṃ jalitānubhāvā ",
  "vv2:7.4": "vaṇṇo ca me sabbadisā pabhāsatī ti. ",
  "vv2:8.1": "Dutiyapīṭhavimānaṃ [=3].1 "
}
