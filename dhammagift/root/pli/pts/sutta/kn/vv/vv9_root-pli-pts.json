  "vv9:0.1": "",
  "vv9:0.2": "",
  "vv9:0.3": "",
  "vv9:0.4": "",
  "vv9:1.1": "Abhikkantena vaṇṇena ",
  "vv9:1.2": "yā tvaṃ tiṭṭhasi devate ",
  "vv9:1.3": "obhāsentī disā sabbā ",
  "vv9:1.4": "osadhī viya tārakā, [=9].2 ",
  "vv9:2.1": "Kena t' etādiso vaṇṇo ",
  "vv9:2.2": "kena te idha-m-ijjhati ",
  "vv9:2.3": "uppajjanti ca te bhogā ",
  "vv9:2.4": "ye keci manaso piyā. [=9].3 ",
  "vv9:3.1": "Kena tvaṃ vimalobhāsā ",
  "vv9:3.2": "atirocasi devate ",
  "vv9:3.3": "kena te sabbagattehi ",
  "vv9:3.4": "sabbā obhāsate disā. [=9].4 ",
  "vv9:4.1": "Pucchāmi taṃ devi mahānubhāve ",
  "vv9:4.2": "manussabhūtā kim akāsi puññaṃ ",
  "vv9:4.3": "kenāsi evaṃ jalitānubhāvā ",
  "vv9:4.4": "vaṇṇo ca te sabbadisā pabhāsatī ti. [=9].5 ",
  "vv9:5.1": "Sā devatā attamanā ",
  "vv9:5.2": "Moggallānena pucchitā ",
  "vv9:5.3": "pañhaṃ puṭṭhā viyākāsi ",
  "vv9:5.4": "yassa kammass' idaṃ phalaṃ: [=9].6 ",
  "vv9:6.1": "Ahaṃ manussesu manussabhūtā ",
  "vv9:6.2": "purimāya jātiyā manussaloke ",
  "vv9:6.3": "tamandhakāramhi timīsikāyaṃ ",
  "vv9:6.4": "padīpakālamhi adaṃ padīpaṃ. [=9].7 ",
  "vv9:7.1": "Yo andhakāramhi timīsikāyaṃ ",
  "vv9:7.2": "padīpakālamhi dadāti dīpaṃ ",
  "vv9:7.3": "uppajjati jotirasaṃ vimānaṃ ",
  "vv9:7.4": "pahūtamalyaṃ bahupuṇḍarīkaṃ. [=9].8 ",
  "vv9:8.1": "Tena m' etādiso vaṇṇo ",
  "vv9:8.2": "tena me idha-m-ijjhati ",
  "vv9:8.3": "uppajjanti ca me bhogā ",
  "vv9:8.4": "ye keci manaso piyā. [=9].9 ",
  "vv9:9.1": "Tenāhaṃ vimalobhāsā ",
  "vv9:9.2": "atirocāmi devatā ",
  "vv9:9.3": "tena me sabbagattehi ",
  "vv9:9.4": "sabbā obhāsate disā. [=9].10 ",
  "vv9:10.1": "Akkhāmi te bhikkhu mahānubhāva ",
  "vv9:10.2": "manussabhūtā yam akāsi puññaṃ ",
  "vv9:10.3": "ten' amhi evaṃ jalitānubhāvā ",
  "vv9:10.4": "vaṇṇo ca me sabbadisā pabhāsatī ti. ",
  "vv9:11.1": "Dīpavimānaṃ [=10].1 "
}
