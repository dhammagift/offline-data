  "vv50:0.4": "",
  "vv50:1.1": "Abhikkantena vaṇṇena ",
  "vv50:1.2": "yā tvaṃ tiṭṭhasi devate ",
  "vv50:1.3": "hatthe pāde ca viggayha ",
  "vv50:1.4": "naccasi suppavādite. [=50].2 ",
  "vv50:2.1": "Tassā te naccamānāya ",
  "vv50:2.2": "aṅga-m-aṅgehi sabbaso ",
  "vv50:2.3": "dibbā saddā niccharanti ",
  "vv50:2.4": "savanīyā manoramā. [=50].3 ",
  "vv50:3.1": "Tassā te naccamānāya ",
  "vv50:3.2": "aṅga-m-aṅgehi sabbaso ",
  "vv50:3.3": "dibbā gandhā pavāyanti ",
  "vv50:3.4": "sucigandhā manoramā. [=50].4 ",
  "vv50:4.1": "Vivattamānā kāyena ",
  "vv50:4.2": "yā veṇīsu pilandhanā ",
  "vv50:4.3": "tesaṃ suyyati nigghoso ",
  "vv50:4.4": "turiye pañcaṅgike yathā. [=50].5 ",
  "vv50:5.1": "Vaṭamsakā vātadhutā ",
  "vv50:5.2": "vātena sampakampitā ",
  "vv50:5.3": "tesaṃ suyyati nigghoso ",
  "vv50:5.4": "turiye pañcaṅgike yathā. [=50].6 ",
  "vv50:6.1": "Yā pi te sirasmiṃ mālā ",
  "vv50:6.2": "sucigandhā manoramā ",
  "vv50:6.3": "vāti gandho disā sabbā ",
  "vv50:6.4": "rukkho mañjūsako yathā. [=50].7 ",
  "vv50:7.1": "Ghāyase taṃ sucigandhaṃ ",
  "vv50:7.2": "rūpaṃ passasi amānusaṃ ",
  "vv50:7.3": "devate pucchitācikkha ",
  "vv50:7.4": "kissa kammass' idaṃ phalan ti. [=50].8 ",
  "vv50:8.1": "Dāsī ahaṃ pure āsiṃ ",
  "vv50:8.2": "Gayāyaṃ brāhmaṇass' ahaṃ ",
  "vv50:8.3": "appapuññā alakkhikā ",
  "vv50:8.4": "Rajjumālā ti maṃ vidū. [=50].9 ",
  "vv50:9.1": "Akkosānaṃ vadhānañ ca ",
  "vv50:9.2": "tajjanāya ca ukkatā ",
  "vv50:9.3": "kuṭaṃ gahetvā nikkhamma ",
  "vv50:9.4": "gacchiṃ udakahāriyā. [=50].10 ",
  "vv50:10.1": "Vipathe kuṭaṃ nikkhipitvā ",
  "vv50:10.2": "vanasaṇḍaṃ upāgamiṃ: ",
  "vv50:10.3": "idh' evāhaṃ marissāmi ",
  "vv50:10.4": "kvattho pi jīvitena me. [=50].11 ",
  "vv50:11.1": "Daḷhaṃ pāsaṃ karitvāna ",
  "vv50:11.2": "āsumbhitvāna pādape ",
  "vv50:11.3": "tato disā vilokesiṃ: ",
  "vv50:11.4": "ko nu kho vanam assito. [=50].12 ",
  "vv50:12.1": "Tatth' addasāsiṃ sambuddhaṃ ",
  "vv50:12.2": "sabbalokahitaṃ muniṃ ",
  "vv50:12.3": "nisinnaṃ rukkhamūlasmiṃ ",
  "vv50:12.4": "jhāyantaṃ akutobhayaṃ. [=50].13 ",
  "vv50:13.1": "Tassā me ahu saṃvego ",
  "vv50:13.2": "abbhuto lomahaṃsano: ",
  "vv50:13.3": "ko nu kho vanam assito ",
  "vv50:13.4": "manusso udāhu devatā. [=50].14 ",
  "vv50:14.1": "Pāsādikaṃ pasādanīyaṃ ",
  "vv50:14.2": "vanā nibbanam āgataṃ ",
  "vv50:14.3": "disvā mano me pasīdi, ",
  "vv50:14.4": "nāyaṃ yādisak' īdiso. [=50].15 ",
  "vv50:15.1": "Guttindriyo jhānarato ",
  "vv50:15.2": "abahiggatamānaso ",
  "vv50:15.3": "hito sabbassa lokassa ",
  "vv50:15.4": "buddho so 'yaṃ bhavissati. [=50].16 ",
  "vv50:16.1": "Bhayabheravo durāsado ",
  "vv50:16.2": "sīho va guham assito ",
  "vv50:16.3": "dullabhāyaṃ dassanāya ",
  "vv50:16.4": "pupphaṃ odumbaraṃ yathā. [=50].17 ",
  "vv50:17.1": "So maṃ mudūhi vācāhi ",
  "vv50:17.2": "ālapitvā tathāgato ",
  "vv50:17.3": "Rajjumāle ti maṃ voca ",
  "vv50:17.4": "saraṇaṃ gaccha tathāgataṃ. [=50].18 ",
  "vv50:18.1": "Tāhaṃ giraṃ suṇitvāna ",
  "vv50:18.2": "nelaṃ atthavatiṃ suciṃ ",
  "vv50:18.3": "saṇhaṃ muduñ ca vagguñ ca ",
  "vv50:18.4": "sabbasokāpanūdanaṃ. [=50].19 ",
  "vv50:19.1": "Kallacittañ ca maṃ ñatvā ",
  "vv50:19.2": "pasannaṃ suddhamānasaṃ ",
  "vv50:19.3": "hito sabbassa lokassa ",
  "vv50:19.4": "anusāsi tathāgato. [=50].20 ",
  "vv50:20.1": "Idaṃ dukkhan ti maṃ voca ",
  "vv50:20.2": "ayaṃ dukkhassa sambhavo ",
  "vv50:20.3": "ayaṃ nirodho maggo ca ",
  "vv50:20.4": "añjaso amatogadho. [=50].21 ",
  "vv50:21.1": "Anukampakassa kusalassa ",
  "vv50:21.2": "ovādamhi ahaṃ ṭhitā ",
  "vv50:21.3": "ajjhagā amataṃ santiṃ ",
  "vv50:21.4": "nibbānaṃ padam accutaṃ. [=50].22 ",
  "vv50:22.1": "Sāhaṃ avaṭṭhitā pemā ",
  "vv50:22.2": "dassane avikampinī ",
  "vv50:22.3": "mūlajātāya saddhāya ",
  "vv50:22.4": "dhītā buddhassa orasā. [=50].23 ",
  "vv50:23.1": "Sāhaṃ ramāmi kīḷāmi ",
  "vv50:23.2": "modāmi akutobhayā ",
  "vv50:23.3": "dibbaṃ mālaṃ dhārayāmi ",
  "vv50:23.4": "pivāmi madhu maddavaṃ. [=50].24 ",
  "vv50:24.1": "Saṭṭhi turiyasahassāni ",
  "vv50:24.2": "paṭibodhaṃ karonti me: ",
  "vv50:24.3": "Ālambo Gaggaro Bhīmo ",
  "vv50:24.4": "Sadhuvādī ca Saṃsayo [=50].25 ",
  "vv50:25.1": "Pokkharo ca Suphasso ca ",
  "vv50:25.2": "Vīṇāmokkhā ca nāriyo ",
  "vv50:25.3": "Nandā c' eva Sunandā ca ",
  "vv50:25.4": "Soṇadinnā Sucimhitā [=50].26 ",
  "vv50:26.1": "Alambusā Missakesī ca ",
  "vv50:26.2": "Puṇḍarīkātidāruṇī ",
  "vv50:26.3": "Eṇiphassā Suphassā ca ",
  "vv50:26.4": "Subhaddā Muduvādinī [=50].27 ",
  "vv50:27.1": "Etā c' aññā ca seyyāse ",
  "vv50:27.2": "accharānaṃ pabodhikā ",
  "vv50:27.3": "tā maṃ kālen' upāgantvā ",
  "vv50:27.4": "abhibhāsanti devatā: [=50].28 ",
  "vv50:28.1": "Handa naccāma gāyāma ",
  "vv50:28.2": "handa taṃ ramayāmase ",
  "vv50:28.3": "na-y-idaṃ akatapuññānaṃ ",
  "vv50:28.4": "katapuññānam ev' idaṃ. [=50].29 ",
  "vv50:29.1": "Asokaṃ Nandanaṃ rammaṃ ",
  "vv50:29.2": "Tidasānaṃ mahāvanaṃ ",
  "vv50:29.3": "sukhaṃ akatapuññānaṃ ",
  "vv50:29.4": "idha natthi parattha ca ",
  "vv50:30.1": "sukhañ ca katapuññānaṃ ",
  "vv50:30.2": "idha c' eva parattha ca. [=50].30 ",
  "vv50:30.3": "Tesaṃ sahavyakāmānaṃ ",
  "vv50:30.4": "kattabbaṃ kusalaṃ bahuṃ ",
  "vv50:30.5": "katapuññā hi modanti ",
  "vv50:30.6": "sagge bhogasamaṅgino. [=50].31 ",
  "vv50:31.1": "Bahunnaṃ vata atthāya ",
  "vv50:31.2": "uppajjanti tathāgatā ",
  "vv50:31.3": "dakkhiṇeyyā manussānaṃ ",
  "vv50:31.4": "puññakkhettānam ākarā ",
  "vv50:31.5": "yattha kāraṃ karitvāna ",
  "vv50:31.6": "sagge modanti dāyakā ti. ",
  "vv50:32.1": "Rajjumālāvimānaṃ ",
  "vv50:33.1": "Tass' uddānaṃ: ",
  "vv50:34.1": "Mañjeṭṭhā Pabhassarā nāgā ",
  "vv50:34.2": "Alomā kañjikadāyikā ",
  "vv50:34.3": "vihāra-caturitthambā ",
  "vv50:34.4": "pītā ucchu-vandana-Rajjumālā; ",
  "vv50:34.5": "vaggo tena pavuccatī ti. [=51].1 ",
  "vv50:35.1": "",
  "vv50:36.1": ""
}
