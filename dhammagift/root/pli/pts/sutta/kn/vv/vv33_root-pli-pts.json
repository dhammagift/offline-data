  "vv33:1.1": "Sattatantiṃ sumadhuraṃ ",
  "vv33:1.2": "rāmaṇeyyaṃ avācayiṃ ",
  "vv33:1.3": "so maṃ raṅgamhi avheti ",
  "vv33:1.4": "saraṇaṃ me hohi Kosiyā ti. [=33].2 ",
  "vv33:2.1": "Ahaṃ te saraṇaṃ homi ",
  "vv33:2.2": "aham ācariyapūjako ",
  "vv33:2.3": "na taṃ jayissati sisso ",
  "vv33:2.4": "sissam ācariya jessasī ti. [=33].3 ",
  "vv33:3.1": "Abhikkantena vaṇṇena ",
  "vv33:3.2": "yā tvaṃ tiṭṭhasi devate ",
  "vv33:3.3": "obhāsentī disā sabbā ",
  "vv33:3.4": "osadhī viya tārakā, [=33].4 ",
  "vv33:4.1": "Kena t' etādiso vaṇṇo ",
  "vv33:4.2": "kena te idha-m-ijjhati ",
  "vv33:4.3": "uppajjanti ca te bhogā ",
  "vv33:4.4": "ye keci manaso piyā. [=33].5 ",
  "vv33:5.1": "Pucchāmi taṃ devi mahānubhāve ",
  "vv33:5.2": "manussabhūtā kim akāsi puññaṃ ",
  "vv33:5.3": "kenāsi evaṃ jalitānubhāvā ",
  "vv33:5.4": "vaṇṇo ca te sabbadisā pabhāsatī ti. [=33].6 ",
  "vv33:6.1": "Sā devatā attamanā ",
  "vv33:6.2": "Moggallānena pucchitā ",
  "vv33:6.3": "pañhaṃ puṭṭhā viyākāsi ",
  "vv33:6.4": "yassa kammass' idaṃ phalaṃ: [=33].7 ",
  "vv33:7.1": "Vatthuttamadāyikā nārī ",
  "vv33:7.2": "pavarā hoti naresu nārisu ",
  "vv33:7.3": "evaṃ piyarūpadāyikā manāpaṃ ",
  "vv33:7.4": "dibbaṃ sā labhate upecca ṭhānaṃ. [=33].8 ",
  "vv33:8.1": "Tassā me passa vimānaṃ ",
  "vv33:8.2": "accharā kāmavaṇṇinī 'ham asmi ",
  "vv33:8.3": "accharāsahassassāhaṃ ",
  "vv33:8.4": "pavarā passa puññānaṃ vipākaṃ. [=33].9 ",
  "vv33:9.1": "Tena m' etādiso vaṇṇo ",
  "vv33:9.2": "tena me idha-m-ijjhati ",
  "vv33:9.3": "uppajjanti ca me bhogā ",
  "vv33:9.4": "ye keci manaso piyā. [=33].10 ",
  "vv33:10.1": "Akkhāmi te bhikkhu mahānubhāva ",
  "vv33:10.2": "manussabhūtā yam akāsi puññaṃ ",
  "vv33:10.3": "ten' amhi evaṃ jalitānubhāvā ",
  "vv33:10.4": "vaṇṇo ca me sabbadisā pabhāsatī ti. ",
  "vv33:11.1": "Anantaraṃ caturavimānaṃ yathā Vatthadāyikāvimānaṃ tathā vitthāretabbaṃ. [=33].15 a ",
