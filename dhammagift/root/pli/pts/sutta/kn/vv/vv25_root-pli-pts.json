{
  "vv25:0.1": "",
  "vv25:0.2": "",
  "vv25:0.3": "",
  "vv25:0.4": "",
  "vv25:1.1": "Abhikkantena vaṇṇena ",
  "vv25:1.2": "yā tvaṃ tiṭṭhasi devate ",
  "vv25:1.3": "obhāsentī disā sabbā ",
  "vv25:1.4": "osadhī viya tārakā, [=25].2 ",
  "vv25:2.1": "Kena t' etādiso vaṇṇo ",
  "vv25:2.2": "kena te idha-m-ijjhati uppajjanti ca te bhogā ye keci manaso piyā. [=25].3 Pucchāmi taṃ devi mahānubhāve manussabhūtā kim akāsi puññaṃ kenāsi evaṃ jalitānubhāvā ",
  "vv25:2.3": "vaṇṇo ca te sabbadisā pabhāsatī ti. [=25].4 ",
  "vv25:3.1": "Sā devatā attamanā ",
  "vv25:3.2": "Moggallānena pucchitā pañhaṃ puṭṭhā viyākāsi ",
  "vv25:3.3": "yassa kammass' idaṃ phalaṃ: [=25].5 ",
  "vv25:4.1": "Niddā ti maṃ aññiṃsu ",
  "vv25:4.2": "Rājagahasmiṃ upāsikā ",
  "vv25:4.3": "saddhā sīlena sampannā ",
  "vv25:4.4": "saṃvibhāgaratā sadā. [=25].6 ",
  "vv25:5.1": "Acchādanañ ca bhattañ ca ",
  "vv25:5.2": "senāsanaṃ padīpiyaṃ ",
  "vv25:5.3": "adāsiṃ ujubhūtesu ",
  "vv25:5.4": "vippasannena cetasā. [=25].7 ",
  "vv25:6.1": "Cātuddasiṃ pañcadasiṃ ",
  "vv25:6.2": "yā ca pakkhassa aṭṭhamī ",
  "vv25:6.3": "pāṭihāriyapakkhañ ca ",
  "vv25:6.4": "aṭṭhaṅgasusamāgataṃ ",
  "vv25:7.1": "uposathaṃ upavasissaṃ ",
  "vv25:7.2": "sadā sīlesu saṃvutā. [=25].8 ",
  "vv25:7.3": "",
  "vv25:7.4": "",
  "vv25:8.1": "Pāṇātipātā viratā ",
  "vv25:8.2": "musāvādā ca saññatā ",
  "vv25:8.3": "theyyā ca aticārā ca ",
  "vv25:8.4": "majjapānā ca ārakā [=25].9 ",
  "vv25:9.1": "Pañcasikkhāpade ratā ",
  "vv25:9.2": "ariyasaccāna kovidā ",
  "vv25:9.3": "upāsikā cakkhumato ",
  "vv25:9.4": "Gotamassa yasassino. [=25].10 ",
  "vv25:10.1": "Tena m' etādiso vaṇṇo ",
  "vv25:10.2": "tena me idha-m-ijjhati uppajjanti ca me bhogā ye keci manaso piyā. [=25].11 Akkhāmi te bhikkhu mahānubhāva manussabhūtā yam ahaṃ akāsiṃ ten' amhi evaṃ jalitānubhāvā ",
  "vv25:10.3": "vaṇṇo ca me sabbadisā pabhāsatī ti. ",
  "vv25:11.1": "Niddāvimānaṃ [=26].1 "
}
