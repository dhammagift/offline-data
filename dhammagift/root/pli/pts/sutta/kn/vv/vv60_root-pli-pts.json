  "vv60:0.4": "",
  "vv60:1.1": "Susukkakhandhaṃ abhiruyha nāgaṃ ",
  "vv60:1.2": "ākācinaṃ dantiṃ baliṃ mahājavaṃ ",
  "vv60:1.3": "āruyha gajavaraṃ sukappitaṃ ",
  "vv60:1.4": "idhāgamā vehāsayam antalikkhe. [=60].2 ",
  "vv60:2.1": "Nāgassa dantesu duvesu nimmitā ",
  "vv60:2.2": "acchodikā paduminiyo suphullā ",
  "vv60:2.3": "padumesu ca turiyagaṇā pavajjare ",
  "vv60:2.4": "imā ca naccanti manoharāyo. [=60].3 ",
  "vv60:3.1": "Deviddhipatto 'si mahānubhāvo ",
  "vv60:3.2": "manussabhūto kim akāsi puññaṃ ",
  "vv60:3.3": "kenāsi evaṃ jalitānubhāvo ",
  "vv60:3.4": "vaṇṇo ca te sabbadisā pabhāsatī ti. [=60].4 ",
  "vv60:4.1": "So devaputto attamano ",
  "vv60:4.2": "Moggallānena pucchito ",
  "vv60:4.3": "pañhaṃ puṭṭho viyākāsi ",
  "vv60:4.4": "yassa kammass' idaṃ phalaṃ. [=60].5 ",
  "vv60:5.1": "Aṭṭh' eva muttapupphāni ",
  "vv60:5.2": "Kassapassa mahesino ",
  "vv60:5.3": "thūpasmiṃ abhiropesiṃ ",
  "vv60:5.4": "pasanno sehi pāṇihi. [=60].6 ",
  "vv60:6.1": "Tena m' etādiso vaṇṇo ",
  "vv60:6.2": "tena me idha-m-ijjhati uppajjanti ca me bhogā ye keci manaso piyā. [=60].7 Akkhāmi te bhikkhu mahānubhāva manussabhūto yam akāsi puññaṃ ten' amhi evaṃ jalitānubhāvo ",
  "vv60:6.3": "vaṇṇo ca me sabbadisā pabhāsatī ti. Nāgavimānaṃ [=61].1 ",
  "vv60:7.1": ""
}
