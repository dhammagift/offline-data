  "vv73:0.4": "",
  "vv73:1.1": "Alaṅkato malyadharo suvattho ",
  "vv73:1.2": "sukuṇḍalī kappitakesamassu ",
  "vv73:1.3": "āmuttahatthābharaṇo yasassī ",
  "vv73:1.4": "dibbe vimānamhi yathāsi candimā. [=73].2 ",
  "vv73:2.1": "Dibbā ca vīṇā pavadanti vaggū ",
  "vv73:2.2": "aṭṭhaṭṭhakā sikkhitā sādhurūpā ",
  "vv73:2.3": "dibbā ca kaññā Tidasacarā uḷārā ",
  "vv73:2.4": "naccanti gāyanti pamodayanti. [=73].3 ",
  "vv73:3.1": "Deviddhipatto 'si mahānubhāvo ",
  "vv73:3.2": "manussabhūto kim akāsi puññaṃ ",
  "vv73:3.3": "kenāsi evaṃ jalitānubhāvo ",
  "vv73:3.4": "vaṇṇo ca te sabbadisā pabhāsatī ti. [=73].4 ",
  "vv73:4.1": "So devaputto attamano ",
  "vv73:4.2": "Moggallānena pucchito pañhaṃ puṭṭho viyākāsi ",
  "vv73:4.3": "yassa kammass' idaṃ phalaṃ. [=73].5 ",
  "vv73:5.1": "Ahaṃ manussesu manussabhūto ",
  "vv73:5.2": "disvāna samaṇe sādhurūpe ",
  "vv73:5.3": "sampannavijjācaraṇe yasassī ",
  "vv73:5.4": "bahussute sīlavante pasanne ",
  "vv73:5.5": "annañ ca pānañ ca pasannacitto ",
  "vv73:5.6": "sakkacca dānaṃ vipulaṃ adāsiṃ. [=73].6 ",
  "vv73:6.1": "Tena m' etādiso vaṇṇo ",
  "vv73:6.2": "tena me idha-m-ijjhati uppajjanti ca me bhogā ye keci manaso piyā. [=73].7 Akkhāmi te bhikkhu mahānubhāva manussabhūto yam akāsi puññaṃ ten' amhi evaṃ jalitānubhāvo ",
  "vv73:6.3": "vaṇṇo ca me sabbadisā pabhāsatī ti. ",
  "vv73:7.1": "Dutiyakuṇḍalīvimānaṃ [=74].1 "
}
