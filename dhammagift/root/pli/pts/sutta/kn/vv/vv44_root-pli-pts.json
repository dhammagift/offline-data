{
  "vv44:0.1": "",
  "vv44:0.2": "",
  "vv44:0.3": "",
  "vv44:0.4": "",
  "vv44:1.1": "Abhikkantena vaṇṇena ",
  "vv44:1.2": "yā tvaṃ tiṭṭhasi devate obhāsentī disā sabbā ",
  "vv44:1.3": "osadhī viya tārakā, [=44].2 ",
  "vv44:2.1": "Tassā te naccamānāya ",
  "vv44:2.2": "aṅga-m-aṅgehi sabbaso ",
  "vv44:2.3": "dibbā saddā niccharanti ",
  "vv44:2.4": "savanīyā manoramā. [=44].3 ",
  "vv44:3.1": "Tassā te naccamānāya ",
  "vv44:3.2": "aṅga-m-aṅgehi sabbaso ",
  "vv44:3.3": "dibbā gandhā pavāyanti ",
  "vv44:3.4": "sucigandhā manoramā. [=44].4 ",
  "vv44:4.1": "Vivattamānā kāyena ",
  "vv44:4.2": "yā veṇīsu pilandhanā ",
  "vv44:4.3": "tesaṃ suyyati nigghoso ",
  "vv44:4.4": "turiye pañcaṅgike yathā. [=44].5 ",
  "vv44:5.1": "Vaṭamsakā vātadhutā ",
  "vv44:5.2": "vātena sampakampitā ",
  "vv44:5.3": "tesaṃ suyyati nigghoso ",
  "vv44:5.4": "turiye pañcaṅgike yathā. [=44].6 ",
  "vv44:6.1": "Yā pi te sirasmiṃ mālā ",
  "vv44:6.2": "sucigandhā manoramā ",
  "vv44:6.3": "vāti gandho disā sabbā ",
  "vv44:6.4": "rukkho mañjūsako yathā. [=44].7 ",
  "vv44:7.1": "Ghāyase taṃ sucigandhaṃ ",
  "vv44:7.2": "rūpaṃ passasi amānusaṃ ",
  "vv44:7.3": "devate pucchitācikkha ",
  "vv44:7.4": "kissa kammass' idaṃ phalan ti. [=44].8 ",
  "vv44:8.1": "Sāvatthiyaṃ mayha sakhī bhadante ",
  "vv44:8.2": "saṅghassa kāresi mahāvihāraṃ ",
  "vv44:8.3": "tattha ppasannā aham ānumodiṃ ",
  "vv44:8.4": "disvā agārañ ca piyañ ca me taṃ. [=44].9 ",
  "vv44:9.1": "Tāy' eva me suddhanumodanāya ",
  "vv44:9.2": "laddhaṃ vimānabbhutadassaneyyaṃ ",
  "vv44:9.3": "samantato soḷasa yojanāni ",
  "vv44:9.4": "vehāsayaṃ gacchati iddhiyā mama. [=44].10 ",
  "vv44:10.1": "Kuṭāgārā nivesā me ",
  "vv44:10.2": "vibhattā bhāgaso mitā ",
  "vv44:10.3": "daddallamānā ābhanti ",
  "vv44:10.4": "samantā satayojanaṃ. [=44].11 ",
  "vv44:11.1": "Pokkharañño ca me ettha ",
  "vv44:11.2": "puthulomanisevitā ",
  "vv44:11.3": "acchodikā vippasannā ",
  "vv44:11.4": "soṇṇavālukasanthatā. [=44].12 ",
  "vv44:12.1": "Nānāpadumasañchannā ",
  "vv44:12.2": "puṇḍarīkasamotatā ",
  "vv44:12.3": "surabhī sampavāyanti ",
  "vv44:12.4": "manuññā māluteritā. [=44].13 ",
  "vv44:13.1": "Jambuyo panasā tālā ",
  "vv44:13.2": "nāḷikeravanāni ca ",
  "vv44:13.3": "antonivesane jātā ",
  "vv44:13.4": "nānārukkhā aropimā. [=44].14 ",
  "vv44:14.1": "Nānāturiyasaṅghuṭṭham ",
  "vv44:14.2": "accharāgaṇaghositaṃ ",
  "vv44:14.3": "yo pi maṃ supine passe ",
  "vv44:14.4": "so pi vitto siyā naro. [=44].15 ",
  "vv44:15.1": "Etādisaṃ abbhutadassaneyyaṃ ",
  "vv44:15.2": "vimānam sabbato pabhaṃ ",
  "vv44:15.3": "mama kammehi nibbattaṃ ",
  "vv44:15.4": "alaṃ puññāni kātave ti. [=44].16 ",
  "vv44:16.1": "Tāy' eva te suddhanumodanāya ",
  "vv44:16.2": "laddhaṃ vimānabbhutadassaneyyaṃ ",
  "vv44:16.3": "yā c' eva sā dānam adāsi nārī ",
  "vv44:16.4": "tassā gatiṃ brūhi kuhiṃ upapannā sā ti. [=44].17 ",
  "vv44:17.1": "Yā sā ahu mayha sakhī bhadante ",
  "vv44:17.2": "saṅghassa kāresi mahāvihāraṃ ",
  "vv44:17.3": "viññātadhammā sā adāsi dānaṃ ",
  "vv44:17.4": "upapannā Nimmānaratīsu devesu. [=44].18 ",
  "vv44:18.1": "Pajāpatī tassa Sunimmitassa ",
  "vv44:18.2": "acintiyo kammavipāka tassā ",
  "vv44:18.3": "yam etaṃ pucchasi kuhiṃ upapannā sā ",
  "vv44:18.4": "tan te viyākāsim anaññathā ahan ti. [=44].19 Tena ",
  "vv44:19.1": "h' aññe pi samādapetha ",
  "vv44:19.2": "saṅghassa dānāni dadātha vittā ",
  "vv44:19.3": "dhammañ ca suṇātha pasannamānasā ",
  "vv44:19.4": "sudullabho laddho manussalābho. [=44].20 ",
  "vv44:20.1": "Yaṃ maggaṃ maggādhipatī adesayi ",
  "vv44:20.2": "brahmassaro kañcanasannibhattaco ",
  "vv44:20.3": "saṅghassa dānāni dadātha vittā ",
  "vv44:20.4": "mahapphalā yattha bhavanti dakkhiṇā. [=44].21 ",
  "vv44:21.1": "Ye puggalā aṭṭha sataṃ pasatthā ",
  "vv44:21.2": "cattāri etāni yugāni honti ",
  "vv44:21.3": "te dakkhiṇeyyā sugatassa sāvakā ",
  "vv44:21.4": "etesu dinnāni mahapphalāni. [=44].22 ",
  "vv44:22.1": "Cattāro ca paṭipannā ",
  "vv44:22.2": "cattāro ca phale ṭhitā ",
  "vv44:22.3": "esa saṅgho ujubhūto ",
  "vv44:22.4": "paññāsīlasamāhito. [=44].23 ",
  "vv44:23.1": "Yajamānānaṃ manussānaṃ ",
  "vv44:23.2": "puññapekkhāna pāṇinaṃ ",
  "vv44:23.3": "karotaṃ opadhikaṃ puññaṃ ",
  "vv44:23.4": "saṅghe dinnaṃ mahapphalaṃ. [=44].24 ",
  "vv44:24.1": "Eso hi saṅgho vipulo mahaggato ",
  "vv44:24.2": "es' appameyyo udadhīva sāgaro ",
  "vv44:24.3": "ete hi seṭṭhā naravīrasāvakā ",
  "vv44:24.4": "pabhaṅkarā dhammam udīrayanti. [=44].25 ",
  "vv44:25.1": "Tesaṃ sudinnaṃ suhutaṃ suyiṭṭhaṃ ",
  "vv44:25.2": "ye saṅgham uddissa dadanti dānaṃ ",
  "vv44:25.3": "sā dakkhiṇā saṅghagatā patiṭṭhitā ",
  "vv44:25.4": "mahapphalā lokavidūna vaṇṇitā. [=44].26 ",
  "vv44:26.1": "Etādisaṃ yaññam anussarantā ",
  "vv44:26.2": "ye vedajātā vicaranti loke ",
  "vv44:26.3": "vineyya maccheramalaṃ samūlaṃ ",
  "vv44:26.4": "aninditā saggam upenti ṭhānan ti. ",
  "vv44:27.1": "Vihāravimānaṃ [=45].1 ",
  "vv44:27.2": ""
}
