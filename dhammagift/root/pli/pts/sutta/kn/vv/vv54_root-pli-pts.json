  "vv54:0.1": "",
  "vv54:0.2": "",
  "vv54:0.3": "",
  "vv54:0.4": "",
  "vv54:1.1": "maṇithūṇaṃ vimānaṃ ",
  "vv54:1.2": "samantato dvāvasayojanāni ",
  "vv54:1.3": "kūṭāgārā sattasatā uḷārā ",
  "vv54:1.4": "veḷuriyatthambhā rucakatthatā subhā. [=54].2 ",
  "vv54:2.1": "Tatth' acchasi pivasi khādasī ca ",
  "vv54:2.2": "dibbā ca vīṇā pavadanti vaggū ",
  "vv54:2.3": "dibbā rasā kāmaguṇ' ettha pañca ",
  "vv54:2.4": "nāriyo ca naccanti suvaṇṇachannā. [=54].3 ",
  "vv54:3.1": "Kena t' etādiso vaṇṇo ",
  "vv54:3.2": "kena te idha-m-ijjhati ",
  "vv54:3.3": "uppajjanti ca te bhogā ",
  "vv54:3.4": "ye keci manaso piyā. [=54].4 ",
  "vv54:4.1": "Pucchāmi taṃ deva mahānubhāva ",
  "vv54:4.2": "manussabhūto kim akāsi puññaṃ ",
  "vv54:4.3": "kenāsi evaṃ jalitānubhāvo ",
  "vv54:4.4": "vaṇṇo ca te sabbadisā pabhāsatī ti. [=54].5 ",
  "vv54:5.1": "So devaputto attamano ",
  "vv54:5.2": "Moggallānena pucchito ",
  "vv54:5.3": "pañhaṃ puṭṭho viyākāsi ",
  "vv54:5.4": "yassa kammass' idaṃ phalaṃ. [=54].6 ",
  "vv54:6.1": "Satisamuppādakaro ",
  "vv54:6.2": "dvāre kakkaṭako ṭhito ",
  "vv54:6.3": "niṭṭhito jātarūpassa ",
  "vv54:6.4": "sobhati dasapādako. [=54].7 ",
  "vv54:7.1": "Tena m' etādiso vaṇṇo ",
  "vv54:7.2": "tena me idha-m-ijjhati ",
  "vv54:7.3": "uppajjanti ca me bhogā ",
  "vv54:7.4": "ye keci manaso piyā. [=54].8 ",
  "vv54:8.1": "Akkhāmi te bhikkhu mahānubhāva ",
  "vv54:8.2": "manussabhūto yam akāsi puññaṃ ",
  "vv54:8.3": "ten' amhi evaṃ jalitānubhāvo ",
  "vv54:8.4": "vaṇṇo ca me sabbadisā pabhāsatī ti. Kakkaṭarasadāyaka-vimānaṃ ",
  "vv54:9.1": "",
  "vv54:10.1": "Anantaraṃ pañcavimānaṃ yathā Kakkaṭarasadāyakavimānaṃ tathā vitthāretabbaṃ. [=55].1-5 As in No. 54 [=55].6 "
}
