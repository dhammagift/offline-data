  "vv84:0.1": "",
  "vv84:0.2": "",
  "vv84:0.3": "",
  "vv84:0.4": "",
  "vv84:1.1": "Suṇotha yakkhassa ca vāṇijāna ca ",
  "vv84:1.2": "samāgamo yattha tadā ahosi ",
  "vv84:1.3": "yathā kathaṃ itarītarena cāpi ",
  "vv84:1.4": "subhāsitaṃ tañ ca suṇātha sabbe. [=84].2 ",
  "vv84:2.1": "Yo so ahu rājā Pāyāsi nāma ",
  "vv84:2.2": "Bhummānaṃ sahavyagato yasassī ",
  "vv84:2.3": "so modamāno va sake vimāne ",
  "vv84:2.4": "amānuso mānuse ajjhabhāsī ti. [=84].3 ",
  "vv84:3.1": "Vaṅke araññe amanussaṭṭhāne ",
  "vv84:3.2": "kantāre appodake appabhakkhe ",
  "vv84:3.3": "suduggame vaṇṇupathassa majjhe ",
  "vv84:3.4": "vaṅkaṃbhayā naṭṭhamanā manussā. [=84].4 ",
  "vv84:4.1": "Na-y-idha phalā mūlamayā ca santi ",
  "vv84:4.2": "upādānaṃ natthi kuto 'dha bhakkho ",
  "vv84:4.3": "aññatra paṃsūhi ca vālukāhi ca ",
  "vv84:4.4": "tattāhi uṇhāhi ca dāruṇāhi ca. [=84].5 ",
  "vv84:5.1": "Ujjaṅgalaṃ tattaṃ ivaṃ kapālaṃ ",
  "vv84:5.2": "anāyasaṃ paralokena tulyaṃ ",
  "vv84:5.3": "luddānaṃ āvāsam idaṃ purāṇaṃ ",
  "vv84:5.4": "bhūmippadeso abhisattarūpo. [=84].6 ",
  "vv84:6.1": "Atha tumhe kena vaṇṇena ",
  "vv84:6.2": "kim āsamānā imaṃ padesaṃ hi ",
  "vv84:6.3": "anuppaviṭṭhā sahasā samecca ",
  "vv84:6.4": "lobhā bhayā athavā sampamūḷhā ti. [=84].7 ",
  "vv84:7.1": "Magadhesu Aṅgesu ca satthavāhā ",
  "vv84:7.2": "āropayissaṃ paṇiyaṃ puthuttaṃ ",
  "vv84:7.3": "te yāmase Sindhu-Sovīrabhūmiṃ ",
  "vv84:7.4": "dhanatthikā uddayaṃ patthayānā. [=84].8 ",
  "vv84:8.1": "Divā pipāsaṃ 'nadhivāsayantā ",
  "vv84:8.2": "yoggānukampañ ca samekkhamānā ",
  "vv84:8.3": "etena vegena āyāma sabbe ",
  "vv84:8.4": "rattiṃ maggaṃ paṭipannā vikāle. [=84].9 ",
  "vv84:9.1": "Te duppayātā aparaddhamaggā ",
  "vv84:9.2": "andhākulā vippanaṭṭhā araññe ",
  "vv84:9.3": "suduggame vaṇṇupathassa majjhe ",
  "vv84:9.4": "disaṃ na jānāma pamūḷhacittā. [=84].10 ",
  "vv84:10.1": "Idañ ca disvāna adiṭṭhapubbaṃ ",
  "vv84:10.2": "vimānaseṭṭhañ ca tavañ ca yakkha ",
  "vv84:10.3": "tat uttariṃ jīvitam āsamānā ",
  "vv84:10.4": "disvā patītā sumanā udaggā ti. [=84].11 ",
  "vv84:11.1": "Pāraṃ samuddassa idañ ca vaṇṇuṃ ",
  "vv84:11.2": "vettācaraṃ saṅkupathañ ca maggaṃ ",
  "vv84:11.3": "nadiyo pana pabbatānañ ca duggā ",
  "vv84:11.4": "puthuddisā gacchatha bhogahetu. [=84].12 ",
  "vv84:12.1": "Pakkhandiyāna vijitaṃ paresaṃ ",
  "vv84:12.2": "verajjake mānuse pekkhamānā ",
  "vv84:12.3": "yaṃ vo sutaṃ vā athavā pi diṭṭhaṃ ",
  "vv84:12.4": "accherakaṃ taṃ vo suṇoma tātā ti. [=84].13 ",
  "vv84:13.1": "Ito pi accherataraṃ kumāra ",
  "vv84:13.2": "na no sutaṃ vā athavā pi diṭṭhaṃ ",
  "vv84:13.3": "atītamānussakam eva sabbaṃ ",
  "vv84:13.4": "disvā na tappāma anomavaṇṇaṃ. [=84].14 ",
  "vv84:14.1": "Vehāsayaṃ pokkharañño savanti ",
  "vv84:14.2": "pahūtamalyā bahupuṇḍarīkā ",
  "vv84:14.3": "dumā c' ime niccaphalūpapannā ",
  "vv84:14.4": "atīva gandhā surabhiṃ pavāyanti. [=84].15 ",
  "vv84:15.1": "Veḷuriyatthambhā satam ussitāse ",
  "vv84:15.2": "silāpavāḷassa ca āyataṃsā ",
  "vv84:15.3": "masāragallā sahā lohitaṅkā ",
  "vv84:15.4": "thambhā ime jotirasāmayāse. [=84].16 ",
  "vv84:16.1": "Sahassatthambhaṃ atulānubhāvaṃ ",
  "vv84:16.2": "tesūpari sādhu-m-idaṃ vimānaṃ ",
  "vv84:16.3": "ratanantaraṃ kañcanavedimissaṃ ",
  "vv84:16.4": "tapanīyapaṭṭehi ca sādhu channaṃ. [=84].17 ",
  "vv84:17.1": "Jambonaduttattam idaṃ sumaṭṭho ",
  "vv84:17.2": "pāsādasopānaphalūpapanno ",
  "vv84:17.3": "daḷho ca vaggu ca susaṅgato ca ",
  "vv84:17.4": "atīva nijjhānakhamo manuñño. [=84].18 ",
  "vv84:18.1": "Ratanantarasmiṃ bahuannapānaṃ ",
  "vv84:18.2": "parivārito accharāsaṅgaṇena ",
  "vv84:18.3": "muraja-āḷambaraturiyaghuṭṭo ",
  "vv84:18.4": "abhivandito 'si thutivandanāya. [=84].19 ",
  "vv84:19.1": "So modasi nārigaṇappabodhano ",
  "vv84:19.2": "vimānapāsādavare manorame ",
  "vv84:19.3": "acintiyo sabbaguṇūpapanno ",
  "vv84:19.4": "rājā yathā Vessavaṇo Naḷinyā. [=84].20 ",
  "vv84:20.1": "Devo nu āsi udavāsi yakkho ",
  "vv84:20.2": "udāhu devindo manussabhūto ",
  "vv84:20.3": "pucchanti taṃ vāṇijā satthavāhā ",
  "vv84:20.4": "ācikkha ko nāma tuvaṃ si yakkho ti. [=84].21 ",
  "vv84:21.1": "Serissako nāma aham hi yakkho ",
  "vv84:21.2": "kantāriyo vaṇṇupathamhi gutto ",
  "vv84:21.3": "imaṃ padesaṃ abhipālayāmi ",
  "vv84:21.4": "vacanakaro Vessavaṇassa rañño ti. [=84].22 ",
  "vv84:22.1": "Adhiccaladdhaṃ pariṇāmajan te ",
  "vv84:22.2": "sayaṃ kataṃ udāhu devehi dinnaṃ ",
  "vv84:22.3": "pucchanti taṃ vāṇijā satthavāhā ",
  "vv84:22.4": "kathaṃ tayā laddham idaṃ manuññan ti. [=84].23 ",
  "vv84:23.1": "Nādhiccaladdhaṃ na pariṇāmajaṃ me ",
  "vv84:23.2": "na sayaṃ kataṃ na hi devehi dinnaṃ ",
  "vv84:23.3": "sakehi kammehi apāpakehi ",
  "vv84:23.4": "puññehi me laddham idaṃ manuññan ti. [=84].24 ",
  "vv84:24.1": "Kin te vataṃ kiṃ pana brahmacariyaṃ ",
  "vv84:24.2": "kissa suciṇṇassa ayaṃ vipāko ",
  "vv84:24.3": "pucchanti taṃ vāṇijā satthavāhā ",
  "vv84:24.4": "kathaṃ tayā laddhaṃ idaṃ vimānan ti. [=84].25 ",
  "vv84:25.1": "Mamaṃ Pāyāsī ti ahū samaññā ",
  "vv84:25.2": "rajjaṃ yadā kārayiṃ Kosalānaṃ ",
  "vv84:25.3": "natthikadiṭṭhi kadariyo pāpadhammo ",
  "vv84:25.4": "ucchedavādī ca tadā ahosiṃ. [=84].26 ",
  "vv84:26.1": "Samaṇo ca kho āsi Kumārakassapo ",
  "vv84:26.2": "bahussuto cittakathī uḷāro ",
  "vv84:26.3": "so me tadā dhammakathaṃ akāsi ",
  "vv84:26.4": "diṭṭhivisūkāni vinodayī me. [=84].27 ",
  "vv84:27.1": "Tāhaṃ tassa dhammakathaṃ suṇitvā ",
  "vv84:27.2": "upāsakattaṃ paṭivedayissaṃ ",
  "vv84:27.3": "pāṇātipātā virato ahosiṃ ",
  "vv84:27.4": "loke adinnaṃ parivajjayissaṃ ",
  "vv84:27.5": "amajjapo no ca musā abhāṇiṃ ",
  "vv84:27.6": "sakena dārena ca homi tuṭṭho. [=84].28 ",
  "vv84:28.1": "Taṃ me vataṃ taṃ pana brahmacariyaṃ ",
  "vv84:28.2": "tassa suciṇṇassa ayaṃ vipāko ",
  "vv84:28.3": "teh' eva kammehi apāpakehi ",
  "vv84:28.4": "puññehi me laddham idaṃ vimānan ti. [=84].29 ",
  "vv84:29.1": "Saccaṃ kirāhaṃsu narā sapaññā ",
  "vv84:29.2": "anaññathā vacanaṃ paṇḍitānaṃ ",
  "vv84:29.3": "yahiṃ yahiṃ gacchati puññakammo ",
  "vv84:29.4": "tahiṃ tahiṃ modati kāmakāmī. [=84].30 ",
  "vv84:30.1": "Yahiṃ yahiṃ sokapariddavo ca ",
  "vv84:30.2": "vadho ca bandho ca parikkileso ",
  "vv84:30.3": "tahiṃ tahiṃ gacchati pāpakammo ",
  "vv84:30.4": "na muccati duggatiyā kadācī ti. [=84].31 ",
  "vv84:31.1": "Sammūḷharūpo va jano ahosi ",
  "vv84:31.2": "asmiṃ muhutte kalalīkato va ",
  "vv84:31.3": "janass' imassa tuyhañ ca kumāra ",
  "vv84:31.4": "appaccayo kena nu kho ahosī ti. [=84].32 ",
  "vv84:32.1": "Ime pi sirīsavanā ca tātā ",
  "vv84:32.2": "dibbā gandhā surabhiṃ sampavanti ",
  "vv84:32.3": "te sampavāyanti imaṃ vimānaṃ ",
  "vv84:32.4": "divā ca ratto ca tamaṃ nihantā. [=84].33 ",
  "vv84:33.1": "Imesañ ca kho vassataccayena ",
  "vv84:33.2": "sipāṭikā phalati ekamekā ",
  "vv84:33.3": "mānussakaṃ vassasataṃ atītaṃ ",
  "vv84:33.4": "yadagge kāyamhi idhūpapanno. [=84].34 ",
  "vv84:34.1": "Disvān' ahaṃ vassasatāni pañca ",
  "vv84:34.2": "asmiṃ vimāne ṭhatvāna tātā ",
  "vv84:34.3": "āyukkhayā puññakkhayā cavissaṃ ",
  "vv84:34.4": "ten' eva sokena pamucchito 'smī ti. [=84].35 ",
  "vv84:35.1": "Kathaṃ nu soceyya tathāvidho so ",
  "vv84:35.2": "laddhā vimānaṃ atulaṃ cirāya ",
  "vv84:35.3": "ye cāpi kho ittaram upapannā ",
  "vv84:35.4": "te nūna soceyyuṃ parittapuññā ti. [=84].36 ",
  "vv84:36.1": "Anucchaviṃ ovadiyañ ca me taṃ ",
  "vv84:36.2": "yaṃ maṃ tumhe peyyavācaṃ vadetha ",
  "vv84:36.3": "tumhe ca kho tātā mayānuguttā ",
  "vv84:36.4": "yen' icchakaṃ tena paletha sotthin ti. [=84].37 ",
  "vv84:37.1": "Gantvā mayaṃ Sindhu-Sovīrabhūmiṃ ",
  "vv84:37.2": "dhanatthikā uddayaṃ patthayānā ",
  "vv84:37.3": "yathāpayogā paripuṇṇacāgā ",
  "vv84:37.4": "kāhāma Serissa mahaṃ uḷāran ti. [=84].38 ",
  "vv84:38.1": "Mā c' eva Serissa mahaṃ akattha ",
  "vv84:38.2": "sabbañ ca vo bhavissati yaṃ vadetha ",
  "vv84:38.3": "pāpāni kammāni vivajjayātha ",
  "vv84:38.4": "dhammānuyogañ ca adhiṭṭhahāthā ti. [=84].39 ",
  "vv84:39.1": "Upāsako atthi imamhi saṅghe ",
  "vv84:39.2": "bahussuto sīlavatūpapanno ",
  "vv84:39.3": "saddho ca cāgī ca supesalo ca ",
  "vv84:39.4": "vicakkhaṇo santusito mutīmā. [=84].40 ",
  "vv84:40.1": "Sañjānamāno na musā bhaṇeyya ",
  "vv84:40.2": "parūpaghātāya na cetayeyya ",
  "vv84:40.3": "vebhūtikaṃ pesuṇaṃ no kareyya ",
  "vv84:40.4": "saṇhañ ca vācaṃ sakhilaṃ bhaṇeyya. [=84].41 ",
  "vv84:41.1": "Sagāravo sapatisso vinīto ",
  "vv84:41.2": "apāpako adhisīle visuddho ",
  "vv84:41.3": "so mātaraṃ pitarañ cāpi jantu ",
  "vv84:41.4": "dhammena poseti ariyavutti. [=84].42 ",
  "vv84:42.1": "Maññe so mātāpitunnaṃ kāraṇā ",
  "vv84:42.2": "bhogāni pariyesati na attahetu ",
  "vv84:42.3": "mātāpitunnañ ca yo accayena ",
  "vv84:42.4": "nekkhammapoṇo carissati brahmacariyaṃ. [=84].43 ",
  "vv84:43.1": "Ujū avaṅko asaṭho amāyo ",
  "vv84:43.2": "na lesakappena ca vohareyya ",
  "vv84:43.3": "so tādiso sukatakammakārī ",
  "vv84:43.4": "dhamme ṭhito kinti labhetha dukkhaṃ. [=84].44 ",
  "vv84:44.1": "Taṃ kāraṇā pātukato 'mhi attanā ",
  "vv84:44.2": "tasmā dhammaṃ passatha vāṇijāse ",
  "vv84:44.3": "aññatra ten' iha bhasmī bhavetha ",
  "vv84:44.4": "andhākulā vippanaṭṭhā araññe, ",
  "vv84:44.5": "taṃ khippamānena lahuṃ parena ",
  "vv84:44.6": "sukho ha ve sappurisena saṅgamo ti. [=84].45 ",
  "vv84:45.1": "Kiṃ nāma so kiñca karoti kammaṃ ",
  "vv84:45.2": "kiṃ nāmadheyyaṃ kiṃ pana tassa gottaṃ ",
  "vv84:45.3": "mayam pi naṃ daṭṭhukām' amha yakkha ",
  "vv84:45.4": "yassānukampāya idhāgato 'si ",
  "vv84:45.5": "lābhā hi tassa yassa tuvaṃ pihesī ti. [=84].46 ",
  "vv84:46.1": "Yo kappako Sambhavanāmadheyyo ",
  "vv84:46.2": "upāsako kocchaphalūpajīvī ",
  "vv84:46.3": "jānātha naṃ tumhākaṃ pesiyo so ",
  "vv84:46.4": "mā kho naṃ hīḷittha supesalo so ti. [=84].47 ",
  "vv84:47.1": "Jānāmase yaṃ tvaṃ vadesi yakkha ",
  "vv84:47.2": "na kho naṃ jānāma sa ediso ti ",
  "vv84:47.3": "mayam pi naṃ pūjayissāma yakkha ",
  "vv84:47.4": "sutvāna tuyhaṃ vacanaṃ uḷāran ti. [=84].48 ",
  "vv84:48.1": "Ye kec' imasmiṃ satthe manussā ",
  "vv84:48.2": "daharā mahantā athavā pi majjhimā ",
  "vv84:48.3": "sabbe va te ālambantu vimānaṃ ",
  "vv84:48.4": "passantu puññāna phalaṃ kadariyā ti. [=84].49 ",
  "vv84:49.1": "Te tattha sabbe va: ahaṃ pure ti ",
  "vv84:49.2": "taṃ kappakaṃ tattha purakkhipitvā ",
  "vv84:49.3": "sabbe va te ālaṃbiṃsu vimānaṃ ",
  "vv84:49.4": "Masakkasāraṃ viya Vāsavassa. [=84].50 ",
  "vv84:50.1": "Te tattha sabbe va: ahaṃ pure ti ",
  "vv84:50.2": "upāsakattaṃ paṭivedayiṃsu ",
  "vv84:50.3": "pāṇātipātā viratā ahesuṃ ",
  "vv84:50.4": "loke adinnaṃ parivajjayiṃsu ",
  "vv84:50.5": "amajjapā no ca musā bhaṇiṃsu ",
  "vv84:50.6": "sakena dārena ca ahesuṃ tuṭṭhā. [=84].51 ",
  "vv84:51.1": "Te tattha sabbe va: ahaṃ pure ti ",
  "vv84:51.2": "upāsakattaṃ paṭivedayitvā- ",
  "vv84:51.3": "pakkāmi sattho anumodamāno ",
  "vv84:51.4": "yakkhiddhiyā anumato punappunaṃ. [=84].52 ",
  "vv84:52.1": "Gantvāna te Sindhu-Sovīrabhūmiṃ ",
  "vv84:52.2": "dhanatthikā uddayaṃ patthayānā ",
  "vv84:52.3": "yathāpayogā paripuṇṇalābhā ",
  "vv84:52.4": "paccāgamuṃ Pāṭaliputtam akkhataṃ. [=84].53 ",
  "vv84:53.1": "Gantvāna te saṃ gharaṃ sotthivanto ",
  "vv84:53.2": "puttehi dārehi samaṅgibhūtā ",
  "vv84:53.3": "ānandī vittā sumanā patītā ",
  "vv84:53.4": "akaṃsu Serissa mahaṃ uḷāraṃ ",
  "vv84:53.5": "Serissakaṃ te pariveṇaṃ māpayiṃsu. [=84].54 ",
  "vv84:54.1": "Etādisā sappurisāna sevanā ",
  "vv84:54.2": "mahatthikā dhammaguṇāna sevanā ",
  "vv84:54.3": "ekassa atthāya upāsakassa ",
  "vv84:54.4": "sabbe va sattā sukhitā ahesun ti. Serissakavimānaṃ [=85].1 Uccam idaṃ ",
  "vv84:55.1": ""
}
