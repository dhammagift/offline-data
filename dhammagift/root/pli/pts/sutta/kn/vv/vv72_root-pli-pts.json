  "vv72:1.1": "Alaṅkato malyadharo suvattho ",
  "vv72:1.2": "sukuṇḍalī kappitakesamassu ",
  "vv72:1.3": "āmuttahatthābharaṇo yasassī ",
  "vv72:1.4": "dibbe vimānamhi yathāsi candimā. [=72].2 ",
  "vv72:2.1": "Dibbā ca vīṇā pavadanti vaggū ",
  "vv72:2.2": "aṭṭhaṭṭhakā sikkhitā sādhurūpā ",
  "vv72:2.3": "dibbā ca kaññā Tidasacarā uḷārā ",
  "vv72:2.4": "naccanti gāyanti pamodayanti. [=72].3 ",
  "vv72:3.1": "Deviddhipatto 'si mahānubhāvo ",
  "vv72:3.2": "manussabhūto kim akāsi puññaṃ ",
  "vv72:3.3": "kenāsi evaṃ jalitānubhāvo ",
  "vv72:3.4": "vaṇṇo ca te sabbadisā pabhāsatī ti. [=72].4 ",
  "vv72:4.1": "So devaputto attamano ",
  "vv72:4.2": "Moggallānena pucchito pañhaṃ puṭṭho viyākāsi ",
  "vv72:4.3": "yassa kammass' idaṃ phalaṃ. [=72].5 ",
  "vv72:5.1": "Ahaṃ manussesu manussabhūto ",
  "vv72:5.2": "disvāna samaṇe sīlavante ",
  "vv72:5.3": "sampannavijjācaraṇe yasassī ",
  "vv72:5.4": "bahussute taṇhakkhayūpapanne, ",
  "vv72:5.5": "annañ ca pānañ ca pasannacitto ",
  "vv72:5.6": "sakkacca dānaṃ vipulaṃ adāsiṃ. [=72].6 ",
  "vv72:6.1": "Tena m' etādiso vaṇṇo ",
  "vv72:6.2": "tena me idha-m-ijjhati uppajjanti ca me bhogā ye keci manaso piyā. [=72].7 Akkhāmi te bhikkhu mahānubhāva manussabhūto yam akāsi puññaṃ ten' amhi evaṃ jalitānubhāvo ",
  "vv72:6.3": "vaṇṇo ca me sabbadisā pabhāsatī ti. Kuṇḍalīvimānaṃ [=73].1 ",
  "vv72:7.1": ""
}
