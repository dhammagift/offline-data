  "vv1:0.1": "",
  "vv1:0.2": "",
  "vv1:0.3": "",
  "vv1:0.4": "",
  "vv1:1.1": "Namo tassa bhagavato arahato sammāsambuddhassa. [=1].1 ",
  "vv1:2.1": "Pīṭhaṃ te sovaṇṇamayaṃ uḷāraṃ ",
  "vv1:2.2": "manojavaṃ gacchati yena kāmaṃ ",
  "vv1:2.3": "alaṅkate malyadhare suvatthe ",
  "vv1:2.4": "obhāsasi vijju-r-iv' abbhakūṭaṃ. [=1].2 ",
  "vv1:3.1": "Kena t' etādiso vaṇṇo ",
  "vv1:3.2": "kena te idha-m-ijjhati ",
  "vv1:3.3": "uppajjanti ca te bhogā ",
  "vv1:3.4": "ye keci manaso piyā. [=1].3 ",
  "vv1:4.1": "Pucchāmi taṃ devi mahānubhāve ",
  "vv1:4.2": "manussabhūtā kim akāsi puññaṃ ",
  "vv1:4.3": "kenāsi evaṃ jalitānubhāvā ",
  "vv1:4.4": "vaṇṇo ca te sabbadisā pabhāsatī ti. [=1].4 ",
  "vv1:5.1": "Sā devatā attamanā ",
  "vv1:5.2": "Moggallānena pucchitā ",
  "vv1:5.3": "pañhaṃ puṭṭhā viyākāsi ",
  "vv1:5.4": "yassa kammass' idaṃ phalaṃ: [=1].5 ",
  "vv1:6.1": "Ahaṃ manussesu manussabhūtā ",
  "vv1:6.2": "abbhāgatān' āsanakaṃ adāsiṃ ",
  "vv1:6.3": "abhivādayiṃ añjalikaṃ akāsiṃ ",
  "vv1:6.4": "yathānubhāvañ ca adāsi dānaṃ. [=1].6 ",
  "vv1:7.1": "Tena m' etādiso vaṇṇo ",
  "vv1:7.2": "tena me idha-m-ijjhati ",
  "vv1:7.3": "uppajjanti ca me bhogā ",
  "vv1:7.4": "ye keci manaso piyā. [=1].7 ",
  "vv1:8.1": "Akkhāmi te bhikkhu mahānubhāva ",
  "vv1:8.2": "manussabhūtā yam akāsi puññaṃ ",
  "vv1:8.3": "ten' amhi evaṃ jalitānubhāvā ",
  "vv1:8.4": "vaṇṇo ca me sabbadisā pabhāsatī ti. ",
  "vv1:9.1": "Paṭhamapīṭhavimānaṃ [=2].1 "
}
