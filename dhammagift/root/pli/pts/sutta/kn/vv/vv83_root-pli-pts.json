{
  "vv83:0.1": "",
  "vv83:0.2": "",
  "vv83:0.3": "",
  "vv83:0.4": "",
  "vv83:1.1": "Alaṅkato maṭṭakuṇḍalī ",
  "vv83:1.2": "mālādhārī haricandanussado ",
  "vv83:1.3": "bāhā paggayha kandasi ",
  "vv83:1.4": "vanamajjhe kiṃ dukkhito tuvan ti. [=83].2 ",
  "vv83:2.1": "Sovaṇṇamayo pabhassaro ",
  "vv83:2.2": "uppanno rathapañjaro mama ",
  "vv83:2.3": "tassa cakkayugaṃ na vindāmi ",
  "vv83:2.4": "tena dukkhena jahissaṃ jīvitan ti. [=83].3 ",
  "vv83:3.1": "Sovaṇṇamayaṃ maṇimayaṃ ",
  "vv83:3.2": "lohitaṅkamayaṃ atha rūpiyāmayaṃ ",
  "vv83:3.3": "ācikkha me bhadda māṇava ",
  "vv83:3.4": "cakkayugaṃ paṭilābhayāmi te ti. [=83].4 ",
  "vv83:4.1": "So māṇavo tassa pāvadi: ",
  "vv83:4.2": "candasuriyā ubhay' ettha dissare ",
  "vv83:4.3": "sovaṇṇamayo ratho mama ",
  "vv83:4.4": "tena cakkayugena sobhatī ti. [=83].5 ",
  "vv83:5.1": "Bālo kho tvam asi māṇava ",
  "vv83:5.2": "yo tvaṃ patthayase apatthiyaṃ ",
  "vv83:5.3": "maññāmi tuvaṃ marissasi ",
  "vv83:5.4": "na hi tuvaṃ lacchasi candasūriye ti. [=83].6 Camanāgamanam ",
  "vv83:6.1": "pi dissati ",
  "vv83:6.2": "vaṇṇadhātu ubhayattha vīthiyā ",
  "vv83:6.3": "peto pana kālakato na dissati ",
  "vv83:6.4": "ko n' idha kandataṃ bālyataro ti. [=83].7 ",
  "vv83:7.1": "Saccaṃ kho vadesi māṇava ",
  "vv83:7.2": "aham eva kandataṃ bālyataro ",
  "vv83:7.3": "candaṃ viya dārako rudaṃ ",
  "vv83:7.4": "petaṃ kālakatābhipatthayan ti. [=83].8 ",
  "vv83:8.1": "Ādittaṃ vata maṃ santaṃ ",
  "vv83:8.2": "ghatasittaṃ va pāvakaṃ ",
  "vv83:8.3": "vārinā viya osiñcaṃ ",
  "vv83:8.4": "sabbaṃ nibbāpaye daraṃ. [=83].9 ",
  "vv83:9.1": "Abbahī vata me sallaṃ ",
  "vv83:9.2": "sokaṃ hadayanissitaṃ ",
  "vv83:9.3": "yo me sokaparetassa ",
  "vv83:9.4": "puttasokaṃ apānudi. [=83].10 ",
  "vv83:10.1": "Svāhaṃ abbūḷhasallo 'smi ",
  "vv83:10.2": "sītibhūto 'smi nibbuto ",
  "vv83:10.3": "na socāmi na rodāmi ",
  "vv83:10.4": "tava sutvāna māṇavā ti. [=83].11 ",
  "vv83:11.1": "Devatā nu 'si gandhabbo ",
  "vv83:11.2": "ādu Sakko purindado ",
  "vv83:11.3": "ko vā tvaṃ kassa vā putto ",
  "vv83:11.4": "kathaṃ jānemu taṃ mayan ti. [=83].12 ",
  "vv83:12.1": "Yañ ca kandasi yañ ca rodasi ",
  "vv83:12.2": "puttaṃ āḷāhane sayaṃ ḍahitvā ",
  "vv83:12.3": "svāhaṃ kusalaṃ karitvā kammaṃ ",
  "vv83:12.4": "Tidasānaṃ sahavyataṃ patto ti. [=83].13 ",
  "vv83:13.1": "Appaṃ vā bahuṃ vā nāddasāma ",
  "vv83:13.2": "dānaṃ dadantassa sake agāre ",
  "vv83:13.3": "uposathakammaṃ vā tādisaṃ ",
  "vv83:13.4": "kena kammena gato 'si devalokan ti. [=83].14 ",
  "vv83:14.1": "Ābādhiko 'haṃ dukkhito gilāno ",
  "vv83:14.2": "āturarūpo 'mhi sake nivesane ",
  "vv83:14.3": "buddhaṃ vigatarajaṃ vitiṇṇakaṅkhaṃ ",
  "vv83:14.4": "addakkhiṃ sugataṃ anomapaññaṃ. [=83].15 ",
  "vv83:15.1": "Svāhaṃ muditamano pasannacitto ",
  "vv83:15.2": "añjaliṃ akariṃ tathāgatassa ",
  "vv83:15.3": "tāhaṃ kusalaṃ karitvāna kammaṃ ",
  "vv83:15.4": "Tidasānaṃ sahavyataṃ patto ti. [=83].16 ",
  "vv83:16.1": "Acchariyaṃ vata abbhūtaṃ ",
  "vv83:16.2": "añjalikammassa ayam īdiso vipāko ",
  "vv83:16.3": "aham pi muditamano pasannacitto ",
  "vv83:16.4": "ajj' eva buddhaṃ saraṇaṃ vajāmī ti. [=83].17 ",
  "vv83:17.1": "Ajj' eva buddhaṃ saraṇaṃ vahāhi ",
  "vv83:17.2": "dhammañ ca saṅghañ ca pasannacitto ",
  "vv83:17.3": "tath' eva sikkhāya padāni pañca ",
  "vv83:17.4": "akhaṇḍaphullāni samādiyassu. [=83].18 ",
  "vv83:18.1": "Pāṇātipātā viramassu khippaṃ ",
  "vv83:18.2": "loke adinnaṃ parivajjayassu ",
  "vv83:18.3": "amajjapo mā ca musā bhaṇāhi ",
  "vv83:18.4": "sakena dārena ca hohi tuṭṭho. [=83].19 ",
  "vv83:19.1": "Atthakāmo 'si me yakkha ",
  "vv83:19.2": "hitakāmo 'si devate ",
  "vv83:19.3": "karomi tuyhaṃ vacanaṃ ",
  "vv83:19.4": "tvaṃ si ācariyo mama. [=83].20 ",
  "vv83:20.1": "Upemi buddhaṃ ",
  "vv83:20.2": "saraṇaṃ dhammañ cāpi anuttaraṃ ",
  "vv83:20.3": "saṅghañ ca naradevassa ",
  "vv83:20.4": "gacchāmi saraṇaṃ ahaṃ. [=83].21 ",
  "vv83:21.1": "Pāṇātipātā viramāmi khippaṃ ",
  "vv83:21.2": "loke adinnaṃ parivajjayāmi ",
  "vv83:21.3": "amajjapo no ca musā bhaṇāmi ",
  "vv83:21.4": "sakena dārena ca homi tuṭṭho ti. Maṭṭakuṇḍalī-vimānaṃ [=84].1 ",
  "vv83:22.1": ""
}
