{
  "vv22:0.1": "",
  "vv22:0.2": "",
  "vv22:0.3": "",
  "vv22:0.4": "",
  "vv22:1.1": "Nīlā pītā ca kāḷā ca ",
  "vv22:1.2": "mañjeṭṭhā atha lohitā ",
  "vv22:1.3": "uccāvacānaṃ vaṇṇānaṃ ",
  "vv22:1.4": "kiñjakkhaparivāritā. [=22].2 ",
  "vv22:2.1": "Mandāravānaṃ pupphānaṃ ",
  "vv22:2.2": "mālaṃ dhāresi muddhani ",
  "vv22:2.3": "na-y-ime aññesu kāyesu ",
  "vv22:2.4": "rukkhā santi sumedhase. [=22].3 ",
  "vv22:3.1": "Kena kāyaṃ upapannā ",
  "vv22:3.2": "Tāvatiṃsaṃ yasassinī ",
  "vv22:3.3": "devate pucchitācikkha ",
  "vv22:3.4": "kissa kammass' idaṃ phalan ti. [=22].4 ",
  "vv22:4.1": "Bhadditthikā ti maṃ aññiṃsu ",
  "vv22:4.2": "Kimbilāyaṃ upāsikā ",
  "vv22:4.3": "saddhā sīlena sampannā ",
  "vv22:4.4": "saṃvibhāgaratā sadā. [=22].5 ",
  "vv22:5.1": "Acchādanañ ca bhattañ ca ",
  "vv22:5.2": "senāsanaṃ padīpiyaṃ ",
  "vv22:5.3": "adāsiṃ ujubhūtesu ",
  "vv22:5.4": "vippasannena cetasā. [=22].6 ",
  "vv22:6.1": "Cātuddasiṃ pañcadasiṃ ",
  "vv22:6.2": "yā ca pakkhassa aṭṭhamī ",
  "vv22:6.3": "pāṭihāriyapakkhañ ca ",
  "vv22:6.4": "aṭṭhaṅgasusamāgataṃ ",
  "vv22:7.1": "uposathaṃ upavasissaṃ ",
  "vv22:7.2": "sadā sīlesu saṃvutā. [=22].7 ",
  "vv22:7.3": "",
  "vv22:7.4": "",
  "vv22:8.1": "Pāṇātipātā viratā ",
  "vv22:8.2": "musāvādā ca saññatā ",
  "vv22:8.3": "theyyā ca aticārā ca ",
  "vv22:8.4": "majjapānā ca ārakā [=22].8 ",
  "vv22:9.1": "Pañcasikkhāpade ratā ",
  "vv22:9.2": "ariyasaccāna kovidā ",
  "vv22:9.3": "upāsikā cakkhumato ",
  "vv22:9.4": "appamādavihārinī, ",
  "vv22:9.5": "katāvakānā katakusalā tato cutā ",
  "vv22:9.6": "sayampabhā anuvicarāmi Nandanaṃ. [=22].9 ",
  "vv22:10.1": "Bhikkhū c' aham paramahitānukampake ",
  "vv22:10.2": "abhojayiṃ tapassiyugaṃ mahāmuniṃ ",
  "vv22:10.3": "katāvakāsā katakusalā tato cutā ",
  "vv22:10.4": "sayampabhā anuvicarāmi Nandanaṃ. [=22].10 ",
  "vv22:11.1": "Aṭṭhaṅgikaṃ aparimitaṃ sukhāvahaṃ ",
  "vv22:11.2": "uposathaṃ satatamupāvasiṃ ahaṃ ",
  "vv22:11.3": "katāvakāsā katakusalā tato cutā ",
  "vv22:11.4": "sayampabhā anuvicarāmi Nandanaṃ. ",
  "vv22:12.1": "Bhadditthivimānaṃ [=23].1 "
}
