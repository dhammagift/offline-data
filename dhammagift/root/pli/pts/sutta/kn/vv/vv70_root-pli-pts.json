  "vv70:1.1": "maṇithūṇaṃ vimānaṃ ",
  "vv70:1.2": "samantato dvādasa yojanāni ",
  "vv70:1.3": "kūṭāgārā sattasatā uḷārā ",
  "vv70:1.4": "veḷuriyatthambhā rucakatthatā subhā. [=70].2 ",
  "vv70:2.1": "Deviddhipatto 'si mahānubhāvo ",
  "vv70:2.2": "manussabhūto kim akāsi puññaṃ ",
  "vv70:2.3": "kenāsi evaṃ jalitānubhāvo ",
  "vv70:2.4": "vaṇṇo ca te sabbadisā pabhāsatī ti. [=70].3 ",
  "vv70:3.1": "So devaputto attamano ",
  "vv70:3.2": "Moggallānena pucchito pañhaṃ puṭṭho viyākāsi ",
  "vv70:3.3": "yassa kammass' idaṃ phalaṃ. [=70].4 ",
  "vv70:4.1": "Ahaṃ manussesu manussabhūto ",
  "vv70:4.2": "disvāna bhikkhuṃ tasitaṃ kilantaṃ ",
  "vv70:4.3": "ekāhaṃ bhikkhaṃ paṭipādayissaṃ ",
  "vv70:4.4": "samaṅgibhattena tadā akāsiṃ. [=70].5 ",
  "vv70:5.1": "Tena m' etādiso vaṇṇo ",
  "vv70:5.2": "tena me idha-m-ijjhati uppajjanti ca me bhogā ye keci manaso piyā. [=70].6 Akkhāmi te bhikkhu mahānubhāva manussabhūto yam akāsi puññaṃ ten' amhi evaṃ jalitānubhāvo ",
  "vv70:5.3": "vaṇṇo ca me sabbadisā pabhāsatī ti. ",
  "vv70:6.1": "Bhikkhādāyakavimānaṃ [=71].1 Uccam idaṃ "
}
