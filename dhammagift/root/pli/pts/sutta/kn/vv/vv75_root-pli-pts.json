  "vv75:0.4": "",
  "vv75:1.1": "Yathā vanaṃ Cittalataṃ pabhāsati ",
  "vv75:1.2": "uyyānaseṭṭhaṃ Tidasānam uttamaṃ ",
  "vv75:1.3": "tathūpamaṃ tuyham idaṃ vimānaṃ ",
  "vv75:1.4": "obhāsayaṃ tiṭṭhati antalikkhe. [=75].2 ",
  "vv75:2.1": "Deviddhipatto 'si mahānubhāvo ",
  "vv75:2.2": "manussabhūto kim akāsi puññaṃ ",
  "vv75:2.3": "kenāsi evaṃ jalitānubhāvo ",
  "vv75:2.4": "vaṇṇo ca te sabbadisā pabhāsatī ti. [=75].3 ",
  "vv75:3.1": "So devaputto attamano ",
  "vv75:3.2": "Moggallānena pucchito pañhaṃ puṭṭho viyākāsi ",
  "vv75:3.3": "yassa kammass' idaṃ phalaṃ. [=75].4 ",
  "vv75:4.1": "Ahaṃ manussesu manussabhūto ",
  "vv75:4.2": "daliddo atāṇo kapaṇo kammakaro ahosiṃ ",
  "vv75:4.3": "jiṇṇe ca mātāpitaro abhāriṃ ",
  "vv75:4.4": "piyā ca me sīlavanto ahesuṃ ",
  "vv75:4.5": "annañ ca pānañ ca pasannacitto ",
  "vv75:4.6": "sakkacca dānaṃ vipulaṃ adāsiṃ. [=75].5 ",
  "vv75:5.1": "Tena m' etādiso vaṇṇo ",
  "vv75:5.2": "tena me idha-m-ijjhati uppajjanti ca me bhogā ye keci manaso piyā. [=75].6 Akkhāmi te bhikkhu mahānubhāva manussabhūto yam akāsi puññaṃ ten' amhi evaṃ jalitānubhāvo ",
  "vv75:5.3": "vaṇṇo ca me sabbadisā pabhāsatī ti. ",
  "vv75:6.1": "Cittalatāvimānaṃ [=76].1 "
}
