  "vv52:0.1": "",
  "vv52:0.2": "",
  "vv52:0.3": "",
  "vv52:0.4": "",
  "vv52:1.1": "Cirappavāsiṃ purisam ",
  "vv52:1.2": "dūrato sotthim āgataṃ ",
  "vv52:1.3": "ñātimittā suhajjā ca ",
  "vv52:1.4": "abhinandanti āgataṃ. [=52].2 ",
  "vv52:2.1": "Tath' eva katapuññam pi ",
  "vv52:2.2": "asmā lokā paraṃ gataṃ ",
  "vv52:2.3": "puññāni paṭigaṇhanti ",
  "vv52:2.4": "piyaṃ ñātī va āgataṃ. [=52].3 ",
  "vv52:3.1": "Uṭṭhehi Revate supāpadhamme ",
  "vv52:3.2": "āparutaṃ dvāraṃ adānasīle ",
  "vv52:3.3": "nessāma taṃ yattha thunanti duggatā ",
  "vv52:3.4": "samappitā nerayikā dukkhenā ti. [=52].4 ",
  "vv52:4.1": "Icc eva vatvāna Yamassa dūtā ",
  "vv52:4.2": "te dve yakkhā lohitakkhā brahantā ",
  "vv52:4.3": "paccekabāhāsu gahetvā Revatiṃ ",
  "vv52:4.4": "pakkāmayuṃ devagaṇassa santike. [=52].5 ",
  "vv52:5.1": "Ādiccavaṇṇaṃ ruciraṃ pabhassaraṃ ",
  "vv52:5.2": "vyamhaṃ subhaṃ kañcanajālachannaṃ ",
  "vv52:5.3": "kass' etam ākiṇṇajanaṃ vimānaṃ ",
  "vv52:5.4": "suriyassa raṃsī-r-iva jotamānaṃ. [=52].6 ",
  "vv52:6.1": "Nārīgaṇā candanasāralittā ",
  "vv52:6.2": "ubhato vimānaṃ upasobhayanti ",
  "vv52:6.3": "taṃ dissati suriyasamānavaṇṇaṃ ",
  "vv52:6.4": "ko modati saggappatto vimāne ti. [=52].7 ",
  "vv52:7.1": "Bārāṇasiyaṃ Nandiyo nāmāsi ",
  "vv52:7.2": "upāsako amaccharī dānapatī vadaññū; ",
  "vv52:7.3": "tass' etam ākiṇṇajanaṃ vimānaṃ ",
  "vv52:7.4": "suriyassa raṃsī-r-iva jotamānaṃ. [=52].8 ",
  "vv52:8.1": "Nārīgaṇā candanasāralittā ",
  "vv52:8.2": "ubhato vimānaṃ upasobhayanti ",
  "vv52:8.3": "taṃ dissati suriyasamānavaṇṇaṃ ",
  "vv52:8.4": "so modati saggappatto vimāne ti. [=52].9 ",
  "vv52:9.1": "Nandiyassāhaṃ bhariyā ",
  "vv52:9.2": "agārinī sabbakulassa issarā ",
  "vv52:9.3": "bhattu vimāne ramissāmi dān' ahaṃ ",
  "vv52:9.4": "na patthaye nirayaṃ dassanāyā ti. [=52].10 ",
  "vv52:10.1": "Eso te nirayo supāpadhamme ",
  "vv52:10.2": "puññaṃ tayā akataṃ jīvaloke ",
  "vv52:10.3": "na hi maccharī rosako pāpadhammo ",
  "vv52:10.4": "saggūpagānaṃ labhati sahavyatan ti. [=52].11 ",
  "vv52:11.1": "Kin nu gūthañ ca muttañ ca ",
  "vv52:11.2": "asucī paṭidissati ",
  "vv52:11.3": "duggandhaṃ kim idaṃ mīḷhaṃ ",
  "vv52:11.4": "kim etaṃ upavāyatī ti. [=52].12 ",
  "vv52:12.1": "Esa Saṃsavako nāma ",
  "vv52:12.2": "gambhīro sataporiso ",
  "vv52:12.3": "yattha vassasahassāni ",
  "vv52:12.4": "tuvaṃ paccasi Revate ti. [=52].13 ",
  "vv52:13.1": "Kin nu kāyena vācāya ",
  "vv52:13.2": "manasā dukkataṃ kataṃ ",
  "vv52:13.3": "kena Saṃsavako laddho ",
  "vv52:13.4": "gambhīro sataporiso ti. [=52].14 ",
  "vv52:14.1": "Samaṇe brāhmaṇe cāpi ",
  "vv52:14.2": "aññe vā pi vanibbake ",
  "vv52:14.3": "musāvādena vañcesi ",
  "vv52:14.4": "taṃ pāpaṃ pakataṃ tayā. [=52].15 ",
  "vv52:15.1": "Tena Saṃsavako laddho ",
  "vv52:15.2": "gambhīro sataporiso ",
  "vv52:15.3": "tattha vassasahassāni ",
  "vv52:15.4": "tuvaṃ paccasi Revate. [=52].16 ",
  "vv52:16.1": "Hatthe pi chindanti atho pi pāde ",
  "vv52:16.2": "kaṇṇe pi chindanti atho pi nāsaṃ ",
  "vv52:16.3": "atho pi kākoḷagaṇā samecca ",
  "vv52:16.4": "saṅgamma khādanti viphandamānan ti. [=52].17 ",
  "vv52:17.1": "Sādhu kho maṃ paṭinetha ",
  "vv52:17.2": "kāhāmi kusalaṃ bahuṃ ",
  "vv52:17.3": "dānena samacariyāya ",
  "vv52:17.4": "saññamena damena ca ",
  "vv52:17.5": "yaṃ katvā sukhitā honti ",
  "vv52:17.6": "na ca pacchānutappare ti. [=52].18 ",
  "vv52:18.1": "Pure tvaṃ pamajjitvā ",
  "vv52:18.2": "idāni paridevasi ",
  "vv52:18.3": "sayaṃ katānaṃ kammānaṃ ",
  "vv52:18.4": "vipākaṃ anubhossasī ti. [=52].19 ",
  "vv52:19.1": "Ko devalokato manussalokaṃ ",
  "vv52:19.2": "gantvāna puṭṭho me evaṃ vadeyya: ",
  "vv52:19.3": "nikkhittadaṇḍesu dadātha dānaṃ ",
  "vv52:19.4": "acchādanaṃ sayanam ath' annapānaṃ ",
  "vv52:19.5": "na hi maccharī rosako pāpadhammo ",
  "vv52:19.6": "saggūpagānaṃ labhati sahavyatan ti. [=52].20 ",
  "vv52:20.1": "Sāhaṃ nūna ito gantvā ",
  "vv52:20.2": "yoniṃ laddhāna mānusiṃ ",
  "vv52:20.3": "vadaññū sīlasampannā ",
  "vv52:20.4": "kāhāmi kusalaṃ bahuṃ ",
  "vv52:20.5": "dānena samacariyāya ",
  "vv52:20.6": "saññamena damena ca. [=52].21 ",
  "vv52:21.1": "Ārāmāni ca ropissaṃ ",
  "vv52:21.2": "dugge saṅkamanāni ca ",
  "vv52:21.3": "papañ ca udapānañ ca ",
  "vv52:21.4": "vippasannena cetasā. [=52].22 ",
  "vv52:22.1": "Cātuddasiṃ pañcadasiṃ ",
  "vv52:22.2": "yā ca pakkhassa aṭṭhamī ",
  "vv52:22.3": "pāṭihāriyapakkhañ ca ",
  "vv52:22.4": "aṭṭhaṅgasusamāgataṃ [=52].23 ",
  "vv52:23.1": "Uposathaṃ upavasissaṃ ",
  "vv52:23.2": "sadā sīlesu saṃvutā ",
  "vv52:23.3": "na ca dāne pamajjissaṃ ",
  "vv52:23.4": "sāmaṃ diṭṭhaṃ idaṃ mayā ti. [=52].24 ",
  "vv52:24.1": "Icc evaṃ vippalapantiṃ ",
  "vv52:24.2": "phandamānaṃ tato tato ",
  "vv52:24.3": "khipiṃsu niraye ghore ",
  "vv52:24.4": "uddhapādaṃ avaṃsiraṃ. [=52].25 ",
  "vv52:25.1": "Ahaṃ pure maccharinī ahosiṃ ",
  "vv52:25.2": "paribhāsikā sumaṇabrāhmaṇānaṃ ",
  "vv52:25.3": "vitathena sāmikaṃ vañcayitvā ",
  "vv52:25.4": "paccām' ahaṃ niraye ghorarūpe ti. ",
  "vv52:26.1": "Revatīvimānaṃ [=53].1 "
}
