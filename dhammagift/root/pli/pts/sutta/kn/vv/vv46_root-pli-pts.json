  "vv46:0.4": "",
  "vv46:1.1": "te ambavanaṃ rammaṃ ",
  "vv46:1.2": "pāsād' ettha mahallako ",
  "vv46:1.3": "nānāturiyasaṅghuṭṭho ",
  "vv46:1.4": "accharāgaṇaghosito. [=46].2 ",
  "vv46:2.1": "Padīpo c' ettha jalati ",
  "vv46:2.2": "niccaṃ sovaṇṇayo mahā ",
  "vv46:2.3": "dussaphalehi rukkhehi ",
  "vv46:2.4": "samantā parivārito. [=46].3 ",
  "vv46:3.1": "Kena t' etādiso vaṇṇo ",
  "vv46:3.2": "kena te idha-m-ijjhati uppajjanti ca te bhogā ye keci manaso piyā. [=46].4 Pucchāmi taṃ devi mahānubhāve manussabhūtā kim akāsi puññaṃ kenāsi evaṃ jalitānubhāvā ",
  "vv46:3.3": "vaṇṇo ca te sabbadisā pabhāsatī ti. [=46].5 ",
  "vv46:4.1": "Sā devatā attamanā ",
  "vv46:4.2": "Moggallānena pucchitā pañhaṃ puṭṭhā viyākāsi ",
  "vv46:4.3": "yassa kammass' idaṃ phalaṃ: [=46].6 ",
  "vv46:5.1": "Ahaṃ manussesu manussabhūtā ",
  "vv46:5.2": "purimāya jātiyā manussaloke ",
  "vv46:5.3": "vihāraṃ saṅghassa kāresiṃ ",
  "vv46:5.4": "ambehi parivāritaṃ. [=46].7 ",
  "vv46:6.1": "Pariyosite vihāre ",
  "vv46:6.2": "kārente niṭṭhite mahe ",
  "vv46:6.3": "ambe acchādayitvāna ",
  "vv46:6.4": "katvā dussamaye phale, [=46].8 ",
  "vv46:7.1": "Padīpaṃ tattha jāletvā ",
  "vv46:7.2": "bhojayitvā gaṇuttamaṃ ",
  "vv46:7.3": "niyyādesiṃ taṃ saṅghassa ",
  "vv46:7.4": "pasannā sehi pāṇihi. [=46].9 ",
  "vv46:8.1": "Tena me ambavanaṃ rammaṃ ",
  "vv46:8.2": "pāsād' ettha mahallako ",
  "vv46:8.3": "nānāturiyasaṅghuṭṭho ",
  "vv46:8.4": "accharāgaṇaghosito. [=46].10 ",
  "vv46:9.1": "Padīpo c' ettha jalati ",
  "vv46:9.2": "niccaṃ sovaṇṇayo mahā ",
  "vv46:9.3": "dussaphalehi rukkhehi ",
  "vv46:9.4": "samantā parivārito. [=46].11 ",
  "vv46:10.1": "Tena m' etādiso vaṇṇo ",
  "vv46:10.2": "tena me idha-m-ijjhati uppajjanti ca me bhogā ye keci manaso piyā. [=46].12 Akkhāmi te bhikkhu mahānubhāva manussabhūtā yam akāsi puññaṃ ten' amhi evaṃ jalitānubhāvā ",
  "vv46:10.3": "vaṇṇo ca me sabbadisā pabhāsatī ti. ",
  "vv46:11.1": "Ambavimānaṃ [=47].1 "
}
