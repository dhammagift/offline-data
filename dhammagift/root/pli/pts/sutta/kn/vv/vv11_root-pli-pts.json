{
  "vv11:0.1": "",
  "vv11:0.2": "",
  "vv11:0.3": "",
  "vv11:0.4": "",
  "vv11:1.1": "Koñcā mayūrā diviyā ca haṃsā ",
  "vv11:1.2": "vaggussarā kokilā sampatanti ",
  "vv11:1.3": "pupphābhikiṇṇaṃ rammam idaṃ vimānaṃ ",
  "vv11:1.4": "anekacittaṃ naranārisevitaṃ. [=11].2 ",
  "vv11:2.1": "Tatth' acchasi devi mahānubhāve ",
  "vv11:2.2": "iddhī vikubbanti anekarūpā ",
  "vv11:2.3": "imā ca te accharāyo samantato ",
  "vv11:2.4": "naccanti gāyanti pamodayanti. [=11].3 ",
  "vv11:3.1": "Deviddhipattāsi mahānubhāve ",
  "vv11:3.2": "manussabhūtā kim akāsi puññaṃ ",
  "vv11:3.3": "kenāsi evaṃ jalitānubhāvā ",
  "vv11:3.4": "vaṇṇo ca te sabbadisā pabhāsatī ti. [=11].4 ",
  "vv11:4.1": "Sā devatā attamanā ",
  "vv11:4.2": "Moggallānena pucchitā ",
  "vv11:4.3": "pañhaṃ puṭṭhā viyākāsi ",
  "vv11:4.4": "yassa kammass' idaṃ phalaṃ: [=11].5 ",
  "vv11:5.1": "Ahaṃ manussesu manussabhūtā ",
  "vv11:5.2": "patibbatā nāññamanā ahosiṃ ",
  "vv11:5.3": "mātā va puttaṃ anurakkhamānā ",
  "vv11:5.4": "kuddhā p' ahaṃ nappharusaṃ avocaṃ. [=11].6 ",
  "vv11:6.1": "Sacce ṭhitā mosavajjaṃ pahāya ",
  "vv11:6.2": "dāne ratā saṅgahitattabhāvā ",
  "vv11:6.3": "annañ ca pānañ ca pasannacittā ",
  "vv11:6.4": "sakkacca dānaṃ vipulaṃ adāsiṃ. [=11].7 ",
  "vv11:7.1": "Tena m' etādiso vaṇṇo ",
  "vv11:7.2": "tena me idha-m-ijjhati ",
  "vv11:7.3": "uppajjanti ca me bhogā ",
  "vv11:7.4": "ye keci manaso piyā. [=11].8 ",
  "vv11:8.1": "Akkhāmi te bhikkhu mahānubhāva ",
  "vv11:8.2": "manussabhūtā yam akāsi puññaṃ ",
  "vv11:8.3": "ten' amhi evaṃ jalitānubhāvā ",
  "vv11:8.4": "vaṇṇo ca me sabbadisā pabhāsatī ti. ",
  "vv11:9.1": "Paṭhamapatibbatāvimānaṃ [=12].1 Veḷuriyatthambhaṃ "
}
