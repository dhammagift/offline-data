  "vv10:0.1": "",
  "vv10:0.2": "",
  "vv10:0.3": "",
  "vv10:0.4": "",
  "vv10:1.1": "Abhikkantena vaṇṇena ",
  "vv10:1.2": "yā tvaṃ tiṭṭhasi devate ",
  "vv10:1.3": "obhāsentī disā sabbā ",
  "vv10:1.4": "osadhī viya tāramā, [=10].2 ",
  "vv10:2.1": "Kena t' etādiso vaṇṇo ",
  "vv10:2.2": "kena te idha-m-ijjhati ",
  "vv10:2.3": "uppajjanti ca te bhogā ",
  "vv10:2.4": "ye keci manaso piyā. [=10].3 ",
  "vv10:3.1": "Pucchāmi taṃ devi mahānubhāve ",
  "vv10:3.2": "manussabhūtā kim akāsi puññaṃ ",
  "vv10:3.3": "kenāsi evaṃ jalitānubhāvā ",
  "vv10:3.4": "vaṇṇo ca te sabbadisā pabhāsatī ti. [=10].4 ",
  "vv10:4.1": "Sā devatā attamanā ",
  "vv10:4.2": "Moggallānena pucchitā ",
  "vv10:4.3": "pañhaṃ puṭṭhā viyākāsi ",
  "vv10:4.4": "yassa kammass' idaṃ phalaṃ: [=10].5 ",
  "vv10:5.1": "Ahaṃ manussesu manussabhūtā ",
  "vv10:5.2": "purimāya jātiyā manussaloke ",
  "vv10:6.1": "addasaṃ virajaṃ buddhaṃ ",
  "vv10:6.2": "vippasannam anāvilaṃ. [=10].6 ",
  "vv10:6.3": "Āsajja dānaṃ adāsiṃ ",
  "vv10:6.4": "akāmā tiladakkhiṇaṃ ",
  "vv10:6.5": "dakkhiṇeyyassa buddhassa ",
  "vv10:6.6": "pasannā sehi pāṇihi. [=10].7 ",
  "vv10:7.1": "Tena m' etādiso vaṇṇo ",
  "vv10:7.2": "tena me idha-m-ijjhati ",
  "vv10:7.3": "uppajjanti ca me bhogā ",
  "vv10:7.4": "ye keci manaso piyā. [=10].8 ",
  "vv10:8.1": "Akkhāmi te bhikkhu mahānubhāva ",
  "vv10:8.2": "manussabhūtā yam akāsi puññaṃ ",
  "vv10:8.3": "ten' amhi evaṃ jalitānubhāvā ",
  "vv10:8.4": "vaṇṇo ca me sabbadisā pabhāsatī ti. ",
  "vv10:9.1": "Tiladakkhiṇavimānaṃ [=11].1 "
}
