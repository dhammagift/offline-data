  "vv62:0.1": "",
  "vv62:0.2": "",
  "vv62:0.3": "",
  "vv62:0.4": "",
  "vv62:1.1": "Ko nu dibbena yānena ",
  "vv62:1.2": "sabbasetena hatthinā ",
  "vv62:1.3": "turiyatāḷitanigghoso ",
  "vv62:1.4": "antalikkhe mahīyati. [=62].2 ",
  "vv62:2.1": "Devatā nu 'si gandhabbo ",
  "vv62:2.2": "ādu Sakko purindado ",
  "vv62:2.3": "ajānantā taṃ pucchāma ",
  "vv62:2.4": "kathaṃ jānemu taṃ mayan ti. [=62].3 ",
  "vv62:3.1": "N' amhi devo na gandhabbo ",
  "vv62:3.2": "nāpi Sakko purindado ",
  "vv62:3.3": "Sudhammā nāma ye devā ",
  "vv62:3.4": "tesaṃ aññataro ahan ti. [=62].4 ",
  "vv62:4.1": "Pucchāma devaṃ Sudhammaṃ ",
  "vv62:4.2": "puthuṃ katvāna añjaliṃ ",
  "vv62:4.3": "kiṃ katvā mānuse kammaṃ ",
  "vv62:4.4": "Sudhammaṃ upapajjatī ti. [=62].5 ",
  "vv62:5.1": "Ucchāgāraṃ tīṇāgāraṃ ",
  "vv62:5.2": "vatthāgārañ ca yo dade ",
  "vv62:5.3": "tiṇṇam aññataraṃ datvā ",
  "vv62:5.4": "Sudhammaṃ upapajjatī ti. ",
  "vv62:6.1": "Tatiyanāgavimānaṃ [=63].1 "
}
