{
  "vv37:0.1": "",
  "vv37:0.2": "",
  "vv37:0.3": "",
  "vv37:0.4": "",
  "vv37:1.1": "Kā nāma tvaṃ visālakkhi ",
  "vv37:1.2": "ramme Cittalatāvane ",
  "vv37:1.3": "samantā anupariyāsi ",
  "vv37:1.4": "narīgaṇapurakkhatā. [=37].2 ",
  "vv37:2.1": "Yadā devā Tāvatiṃsā ",
  "vv37:2.2": "pavisanti imaṃ vanaṃ ",
  "vv37:2.3": "sayoggā sarathā sabbe ",
  "vv37:2.4": "citrā honti idhāgatā. [=37].3 ",
  "vv37:3.1": "Tuyhañ ca idha pattāya ",
  "vv37:3.2": "uyyāne vicarantiyā ",
  "vv37:3.3": "kāyena dissati cittaṃ ",
  "vv37:3.4": "kena rūpaṃ tav' edisaṃ, ",
  "vv37:3.5": "devate pucchitācikkha ",
  "vv37:3.6": "kissa kammass' idaṃ phalan ti. [=37].4 ",
  "vv37:4.1": "Yena kammena devinda ",
  "vv37:4.2": "rūpaṃ mayhaṃ gatī ca me ",
  "vv37:4.3": "iddhī ca ānubhāvo ca ",
  "vv37:4.4": "taṃ suṇohi Purindada. [=37].5 ",
  "vv37:5.1": "Ahaṃ Rājagahe ramme ",
  "vv37:5.2": "Sunandā nām' upāsikā ",
  "vv37:5.3": "saddhā sīlena sampannā ",
  "vv37:5.4": "saṃvibhāgaratā sadā. [=37].6 ",
  "vv37:6.1": "Acchādanañ ca bhattañ ca ",
  "vv37:6.2": "senāsanaṃ padīpiyaṃ ",
  "vv37:6.3": "adāsiṃ ujubhūtesu ",
  "vv37:6.4": "vippasannena cetasā. [=37].7 ",
  "vv37:7.1": "Cātuddasiṃ pañcadasiṃ ",
  "vv37:7.2": "yā ca pakkhassa aṭṭhamī ",
  "vv37:7.3": "pāṭihāriyapakkhañ ca ",
  "vv37:7.4": "aṭṭhaṅgasusamāgataṃ ",
  "vv37:8.1": "uposathaṃ upavasissaṃ ",
  "vv37:8.2": "sadā sīlesu saṃvutā. [=37].8 ",
  "vv37:8.3": "",
  "vv37:8.4": "",
  "vv37:9.1": "Pāṇātipātā viratā ",
  "vv37:9.2": "musāvādā ca saññatā ",
  "vv37:9.3": "theyyā ca aticārā ca ",
  "vv37:9.4": "majjapānā ca ārakā [=37].9 ",
  "vv37:10.1": "Pañcasikkhāpade ratā ",
  "vv37:10.2": "ariyasaccāna kovidā ",
  "vv37:10.3": "upāsikā cakkhumato ",
  "vv37:10.4": "Gotamassa yasassino. [=37].10 ",
  "vv37:11.1": "Tassā me ñātikulā dāsī ",
  "vv37:11.2": "sadā mālābhihārati ",
  "vv37:11.3": "tāhaṃ bhagavato thūpe ",
  "vv37:11.4": "sabbam evābhiropayiṃ. [=37].11 ",
  "vv37:12.1": "Uposathe c' ahaṃ gantvā ",
  "vv37:12.2": "mālāgandhavilepanaṃ ",
  "vv37:12.3": "thūpasmiṃ abhiropesiṃ ",
  "vv37:12.4": "pasannā sehi pāṇihi. [=37].12 ",
  "vv37:13.1": "Tena kammena devinda ",
  "vv37:13.2": "rūpaṃ mayhaṃ gatī ca me ",
  "vv37:13.3": "iddhī ca ānubhāvo ca ",
  "vv37:13.4": "yaṃ mālaṃ abhiropayiṃ. [=37].13 ",
  "vv37:14.1": "Yañ ca sīlavatī āsiṃ ",
  "vv37:14.2": "na taṃ tāva vipaccati ",
  "vv37:14.3": "āsā ca pana me devinda ",
  "vv37:14.4": "sakadāgāminī siyan ti. ",
  "vv37:15.1": "Visālakkhivimānaṃ [=38].1 "
}
