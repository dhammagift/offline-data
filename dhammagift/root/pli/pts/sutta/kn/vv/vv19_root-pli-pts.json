{
  "vv19:0.1": "",
  "vv19:0.2": "",
  "vv19:0.3": "",
  "vv19:0.4": "",
  "vv19:1.1": "Abhikkantena vaṇṇena ",
  "vv19:1.2": "yā tvaṃ tiṭṭhasi devate ",
  "vv19:1.3": "obhāsentī disā sabbā ",
  "vv19:1.4": "osadhī viya tārakā, [=19].2 ",
  "vv19:2.1": "Kena t' etādiso vaṇṇo ",
  "vv19:2.2": "kena te idha-m-ijjhati ",
  "vv19:2.3": "uppajjanti ca te bhogā ",
  "vv19:2.4": "ye keci manaso piyā. [=19].3 ",
  "vv19:3.1": "Pucchāmi taṃ devi mahānubhāve ",
  "vv19:3.2": "manussabhūtā kim akāsi puññaṃ ",
  "vv19:3.3": "kenāsi evaṃ jalitānubhāvā ",
  "vv19:3.4": "vaṇṇo ca te sabbadisā pabhāsatī ti. [=19].4 ",
  "vv19:4.1": "Sā devatā attamanā ",
  "vv19:4.2": "Moggallānena pucchitā ",
  "vv19:4.3": "pañhaṃ puṭṭhā viyākāsi ",
  "vv19:4.4": "yassa kammass' idaṃ phalaṃ: [=19].5 ",
  "vv19:5.1": "Kevaṭṭadvārā nikkhamma ",
  "vv19:5.2": "ahu mayhaṃ nivesanaṃ ",
  "vv19:5.3": "tattha sañcaramānānaṃ ",
  "vv19:5.4": "sāvakānam mahesinaṃ, [=19].6 ",
  "vv19:6.1": "Odanaṃ kummāsaṃ ḍākaṃ ",
  "vv19:6.2": "loṇasovīrakañ c' ahaṃ ",
  "vv19:6.3": "adāsiṃ ujubhūtesu ",
  "vv19:6.4": "vippannena cetasā. [=19].7 ",
  "vv19:7.1": "Cātuddasiṃ pañcadasiṃ ",
  "vv19:7.2": "yā ca pakkhassa aṭṭhamī ",
  "vv19:7.3": "pāṭihāriyapakkhañ ca ",
  "vv19:7.4": "aṭṭhaṅgasusamāgataṃ [=19].8 ",
  "vv19:8.1": "Uposathaṃ upavasissaṃ ",
  "vv19:8.2": "sadā sīlesu saṃvutā ",
  "vv19:8.3": "saññamā saṃvibhāgā ca ",
  "vv19:8.4": "vimānaṃ āvasām' ahaṃ. [=19].9 ",
  "vv19:9.1": "Pāṇātipātā viratā ",
  "vv19:9.2": "musāvādā ca saññatā ",
  "vv19:9.3": "theyyā ca aticārā ca ",
  "vv19:9.4": "majjapānā ca ārakā [=19].10 ",
  "vv19:10.1": "Pañcasikkhāpade ratā ",
  "vv19:10.2": "ariyasaccāna kovidā ",
  "vv19:10.3": "upāsikā cakkhumato ",
  "vv19:10.4": "Gotamassa yasassino. [=19].11 ",
  "vv19:11.1": "Tena m' etādiso vaṇṇo ",
  "vv19:11.2": "tena me idha-m-ijjhati uppajjanti ca me bhogā ye keci manaso piyā. [=19].12 Akkhāmi te bhikkhu mahānubhāva manussabhūtā yam ahaṃ akāsiṃ ten' amhi evaṃ jalitānubhāvā ",
  "vv19:11.3": "vaṇṇo ca me sabbadisā pabhāsatī ti. ",
  "vv19:12.1": "Mama ca bhante vacanena bhagavato pāde sirasā vandeyyāsi; ",
  "vv19:12.2": "Lakhumā nāma bhante upāsikā bhagavato pāde sirasā vandatī ti. ",
  "vv19:12.3": "Anacchariyaṃ kho pan' etaṃ bhante yaṃ maṃ bhagavā aññatarasmiṃ sāmaññaphale vyākareyya. ",
  "vv19:12.4": "Taṃ bhagavā sakadāgāmiphale vyākāsī ti. ",
  "vv19:13.1": "Lakhumāvimānaṃ [=20].1 "
}
