  "vv79:0.1": "",
  "vv79:0.2": "",
  "vv79:0.3": "",
  "vv79:0.4": "",
  "vv79:1.1": "maṇithūṇaṃ vimānaṃ ",
  "vv79:1.2": "samantato dvādasa yojanāni ",
  "vv79:1.3": "kūṭāgārā sattasatā uḷārā ",
  "vv79:1.4": "veḷuriyatthambhā rucakatthatā subhā. [=79].2 ",
  "vv79:2.1": "Tatth' acchasi pivasi khādasī ca ",
  "vv79:2.2": "dibbā ca vīṇā pavadanti vaggū ",
  "vv79:2.3": "dibbā rasā kāmaguṇ' ettha pañca ",
  "vv79:2.4": "nāriyo ca naccanti suvaṇṇachannā. [=79].3 ",
  "vv79:3.1": "Kena t' etādiso vaṇṇo ",
  "vv79:3.2": "kena te idha-m-ijjhati uppajjanti ca te bhogā ye keci manaso piyā. [=79].4 Pucchāmi taṃ deva mahānubhāva manussabhūto kim akāsi puññaṃ kenāsi evaṃ jalitānubhāvo ",
  "vv79:3.3": "vaṇṇo ca te sabbadisā pabhāsatī ti. [=79].5 ",
  "vv79:4.1": "So devaputto attamano ",
  "vv79:4.2": "Moggallānena pucchito pañhaṃ puṭṭho viyākāsi ",
  "vv79:4.3": "yassa kammass' idaṃ phalaṃ. [=79].6 ",
  "vv79:5.1": "Gimhānaṃ pacchime mase ",
  "vv79:5.2": "patapante divaṅkare ",
  "vv79:5.3": "paresaṃ bhatako poso ",
  "vv79:5.4": "ambārāmam asiñcati. [=79].7 ",
  "vv79:6.1": "Atha tenāgamā bhikkhu ",
  "vv79:6.2": "Sāriputto ti vissuto ",
  "vv79:6.3": "kilantarūpo kāyena ",
  "vv79:6.4": "akilanto va cetasā. [=79].8 ",
  "vv79:7.1": "Tañ ca disvāna āyantaṃ ",
  "vv79:7.2": "avocaṃ ambasiñcako: ",
  "vv79:7.3": "sādhu taṃ bhante nhāpeyyaṃ ",
  "vv79:7.4": "yaṃ mam' assa sukhāvahaṃ. [=79].9 ",
  "vv79:8.1": "Tassa me anukampāya ",
  "vv79:8.2": "nikkhipi pattacīvaraṃ ",
  "vv79:8.3": "nisīdi rukkhamūlasmiṃ ",
  "vv79:8.4": "chāyāya ekacīvaro. [=79].10 ",
  "vv79:9.1": "Tañ ca acchena vārinā ",
  "vv79:9.2": "pasannamānaso naro ",
  "vv79:9.3": "nhāpayī rukkhamūlasmiṃ ",
  "vv79:9.4": "chāyāya ekacīvaraṃ. [=79].11 ",
  "vv79:10.1": "Ambo ca sitto samaṇo ca nhāpito ",
  "vv79:10.2": "mayā ca puññaṃ pasutaṃ anappakaṃ ",
  "vv79:10.3": "iti so pītiyā kāyaṃ ",
  "vv79:10.4": "sabbaṃ pharati attano. [=79].12 ",
  "vv79:11.1": "Tad eva ettakaṃ kammaṃ ",
  "vv79:11.2": "akāsiṃ tāya jātiyā ",
  "vv79:11.3": "pahāya mānusaṃ dehaṃ ",
  "vv79:11.4": "upapanno 'mhi Nandanaṃ. [=79].13 ",
  "vv79:12.1": "Nandane ca vane ramme ",
  "vv79:12.2": "nānādijagaṇāyute ",
  "vv79:12.3": "ramāmi naccagītehi ",
  "vv79:12.4": "accharāhi purakkhato ti. ",
  "vv79:13.1": "Ambavimānaṃ [=80].1 "
}
