  "vv61:0.1": "",
  "vv61:0.2": "",
  "vv61:0.3": "",
  "vv61:0.4": "",
  "vv61:1.1": "Mahantaṃ nāgaṃ abhiruyha ",
  "vv61:1.2": "sabbasetaṃ gajuttamaṃ ",
  "vv61:1.3": "vanā vanaṃ anupariyāsi ",
  "vv61:1.4": "nārīgaṇapurakkhato ",
  "vv61:1.5": "obhāsento disā sabbā ",
  "vv61:1.6": "osadhī viya tārakā. [=61].2 ",
  "vv61:2.1": "Kena t' etādiso vaṇṇo ",
  "vv61:2.2": "kena te idha-m-ijjhati uppajjanti ca te bhogā ye keci manaso piyā. [=61].3 Pucchāmi taṃ deva mahānubhāva manussabhūto kim akāsi puññaṃ kenāsi evaṃ jalitānubhāvo ",
  "vv61:2.3": "vaṇṇo ca te sabbadisā pabhāsatī ti. [=61].4 ",
  "vv61:3.1": "So devaputto attamano ",
  "vv61:3.2": "Moggallānena pucchito ",
  "vv61:3.3": "pañhaṃ puṭṭho viyākāsi ",
  "vv61:3.4": "yassa kammass' idaṃ phalaṃ. [=61].5 ",
  "vv61:4.1": "Ahaṃ manussesu manussabhūto ",
  "vv61:4.2": "upāsako cakkhumato ahosiṃ ",
  "vv61:4.3": "pāṇātipātā virato ahosiṃ ",
  "vv61:4.4": "loke adinnaṃ parivajjayissaṃ. [=61].6 ",
  "vv61:5.1": "Amajjapo na ca musā abhāṇiṃ ",
  "vv61:5.2": "sakena dārena ca tuṭṭho ahosiṃ ",
  "vv61:5.3": "annañ ca pānañ ca pasannacitto ",
  "vv61:5.4": "sakkacca dānaṃ vipulaṃ adāsiṃ. [=61].7 ",
  "vv61:6.1": "Tena m' etādiso vaṇṇo ",
  "vv61:6.2": "tena me idha-m-ijjhati uppajjanti ca me bhogā ye keci manaso piyā. [=61].8 Akkhāmi te bhikkhu mahānubhāva manussabhūto yam akāsi puññaṃ ten' amhi evaṃ jalitānubhāvo ",
  "vv61:6.3": "vaṇṇo ca me sabbadisā pabhāsatī ti. ",
  "vv61:7.1": "Dutiyanāgavimānaṃ [=62].1 "
}
