  "vv67:0.1": "",
  "vv67:0.2": "",
  "vv67:0.3": "",
  "vv67:0.4": "",
  "vv67:1.1": "maṇithūṇaṃ vimānaṃ ",
  "vv67:1.2": "samantato soḷasa yojanāni ",
  "vv67:1.3": "kūṭāgārā sattasatā uḷārā ",
  "vv67:1.4": "veḷuriyatthambhā rucakatthatā subhā. [=67].2 ",
  "vv67:2.1": "Tatth' acchasi pivasi khādasī ca ",
  "vv67:2.2": "dibbā ca vīṇā pavadanti vaggū ",
  "vv67:2.3": "aṭṭhaṭṭhakā sikkhitā sādhurūpā ",
  "vv67:2.4": "dibbā ca kaññā Tidasacarā uḷārā ",
  "vv67:2.5": "naccanti gāyanti pamodayanti. [=67].3 ",
  "vv67:3.1": "Deviddhipatto 'si mahānubhāvo ",
  "vv67:3.2": "manussabhūto kim akāsi puññaṃ ",
  "vv67:3.3": "kenāsi evaṃ jalitānubhāvo ",
  "vv67:3.4": "vaṇṇo ca te sabbadisā pabhāsatī ti. [=67].4 ",
  "vv67:4.1": "So devaputto attamano ",
  "vv67:4.2": "Moggallānena pucchito pañhaṃ puṭṭho viyākāsi ",
  "vv67:4.3": "yassa kammass' idaṃ phalaṃ. [=67].5 ",
  "vv67:5.1": "Phaladāyī phalaṃ vipulaṃ labhati ",
  "vv67:5.2": "dadam ujjugatesu pasannamānaso ",
  "vv67:5.3": "so hi modati saggagato Tidive ",
  "vv67:5.4": "anubhoti ca puññaphalaṃ vipulaṃ, ",
  "vv67:6.1": "tath' evāham mahāmuni ",
  "vv67:6.2": "adāsiṃ caturo phale. [=67].6 ",
  "vv67:7.1": "Tasmā hi phalaṃ alam eva dātuṃ ",
  "vv67:7.2": "niccaṃ manussena sukhatthikena ",
  "vv67:7.3": "dibbāni vā patthayatā sukhāni ",
  "vv67:7.4": "manussasobhaggatam icchatā vā. [=67].7 ",
  "vv67:8.1": "Tena m' etādiso vaṇṇo ",
  "vv67:8.2": "tena me idha-m-ijjhati uppajjanti ca me bhogā ye keci manaso piyā. [=67].8 Akkhāmi te bhikkhu mahānubhāva manussabhūto yam akāsi puññaṃ ten' amhi evaṃ jalitānubhāvo ",
  "vv67:8.3": "vaṇṇo ca me sabbadisā pabhāsatī ti. ",
  "vv67:9.1": "Phaladāyakavimānaṃ [=68].1 "
}
