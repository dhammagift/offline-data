  "vv36:0.1": "",
  "vv36:0.2": "",
  "vv36:0.3": "",
  "vv36:0.4": "",
  "vv36:1.1": "Pītavatthe pītadhaje ",
  "vv36:1.2": "pītālaṅkārabhūsite ",
  "vv36:1.3": "pītantarāhi vaggūhi ",
  "vv36:1.4": "apilandhā va sobhasi. [=36].2 ",
  "vv36:2.1": "Kā kambukāyuradhare ",
  "vv36:2.2": "kañcanāveḷabhūsite ",
  "vv36:2.3": "hemajālakapacchanne ",
  "vv36:2.4": "nānāratanamālinī. [=36].3 ",
  "vv36:3.1": "Sovaṇṇamayā lohitaṅkamayā ",
  "vv36:3.2": "muttāmayā veḷuriyāmayā ca ",
  "vv36:3.3": "masāragallā sahalohitaṅkā ",
  "vv36:3.4": "pārevatakkhīhi maṇīhi cittatā. [=36].4 ",
  "vv36:4.1": "Koci koci ettha mayūrasussaro ",
  "vv36:4.2": "haṃsassar' añño karavīkasussaro ",
  "vv36:4.3": "tesaṃ saro suyyati vaggurūpo ",
  "vv36:4.4": "pañcaṅgikaṃ turiyam iva ppavāditaṃ. [=36].5 ",
  "vv36:5.1": "Ratho ca te subho vaggu ",
  "vv36:5.2": "nānāratanacittito ",
  "vv36:5.3": "nānāvaṇṇāhi dhātūhi ",
  "vv36:5.4": "suvibhatto va sobhati. [=36].6 ",
  "vv36:6.1": "Tasmiṃ rathe kañcanabimbavaṇṇe ",
  "vv36:6.2": "yā tvaṃ ṭhitā bhāsas' imaṃ padesaṃ ",
  "vv36:6.3": "devate pucchitācikkha ",
  "vv36:6.4": "kissa kammass' idaṃ phalan ti. [=36].7 ",
  "vv36:7.1": "Sovaṇṇajālaṃ maṇisoṇṇacittaṃ ",
  "vv36:7.2": "muttācitaṃ hemajālena channaṃ ",
  "vv36:7.3": "parinibbute Gotame appameyye ",
  "vv36:7.4": "pasannacittā aham ābhiropayiṃ. [=36].8 ",
  "vv36:8.1": "Tāhaṃ kammaṃ karitvāna ",
  "vv36:8.2": "kusalaṃ buddhavaṇṇitaṃ ",
  "vv36:8.3": "apetasokā sukhitā ",
  "vv36:8.4": "sampamodām' anāmayā ti. ",
  "vv36:9.1": "Mallikāvimānaṃ [=37].1 "
}
