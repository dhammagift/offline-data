  "vv82:0.1": "",
  "vv82:0.2": "",
  "vv82:0.3": "",
  "vv82:0.4": "",
  "vv82:1.1": "Anekavaṇṇaṃ darasokanāsanaṃ ",
  "vv82:1.2": "vimānam āruyha anekacittaṃ ",
  "vv82:1.3": "parivārito accharāsaṅgaṇena ",
  "vv82:1.4": "Sunimmito bhūtapatīva modasi. [=82].2 ",
  "vv82:2.1": "Samassamo natthi kuto pan' uttaro ",
  "vv82:2.2": "yasena puññena ca iddhiyā ca ",
  "vv82:2.3": "sabbe ca devā Tidasagaṇā samecca ",
  "vv82:2.4": "taṃ taṃ namassanti sasiṃ va devā, ",
  "vv82:2.5": "imā ca te accharāyo samantato ",
  "vv82:2.6": "naccanti gāyanti pamodayanti. [=82].3 ",
  "vv82:3.1": "Deviddhipatto 'si mahānubhāvo ",
  "vv82:3.2": "manussabhūto kim akāsi puññaṃ ",
  "vv82:3.3": "kenāsi evaṃ jalitānubhāvo ",
  "vv82:3.4": "vaṇṇo ca sabbadisā pabhāsatī ti. [=82].4 ",
  "vv82:4.1": "So devaputto attamano ",
  "vv82:4.2": "Moggallānena pucchito pañhaṃ puṭṭho viyākāsi ",
  "vv82:4.3": "yassa kammass' idaṃ phalaṃ. [=82].5 ",
  "vv82:5.1": "Ahaṃ bhadante ahuvāsi pubbe ",
  "vv82:5.2": "Sumedhanāmassa jinassa sāvako ",
  "vv82:5.3": "puthujjano anavabodho 'ham asmiṃ ",
  "vv82:5.4": "so satta vassāni paribbajiss' ahaṃ. [=82].6 ",
  "vv82:6.1": "Svāhaṃ Sumedhassa jinassa satthuno ",
  "vv82:6.2": "parinibbutass' oghatiṇṇassa tādino ",
  "vv82:6.3": "ratanuccayaṃ hemajālena channaṃ ",
  "vv82:6.4": "vanditvā thūpasmiṃ manaṃ pasādayiṃ. [=82].7 ",
  "vv82:7.1": "Na m' āsi dānaṃ na ca m' atthi dātuṃ ",
  "vv82:7.2": "pare ca kho tattha samādapesiṃ: ",
  "vv82:7.3": "pūjetha naṃ pūjanīyassa dhātuṃ ",
  "vv82:7.4": "evaṃ kira saggam ito gamissatha. [=82].8 ",
  "vv82:8.1": "Tad eva kammaṃ kusalaṃ kataṃ mayā ",
  "vv82:8.2": "sukhañ ca dibbaṃ anubhomi attanā ",
  "vv82:8.3": "modām' ahaṃ Tidasagaṇassa majjhe ",
  "vv82:8.4": "na tassa puññassa khayam pi ajjhagan ti. ",
  "vv82:9.1": "Anekavaṇṇavimānaṃ [=83].1 "
}
