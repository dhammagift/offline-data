  "vv66:0.4": "",
  "vv66:1.1": "Yathā vanaṃ Cittalataṃ pabhāsati ",
  "vv66:1.2": "uyyānaseṭṭhaṃ Tidasānam uttamaṃ ",
  "vv66:1.3": "tathūpamaṃ tuyham idaṃ vimānaṃ ",
  "vv66:1.4": "obhāsayaṃ tiṭṭhati antalikkhe. [=66].2 ",
  "vv66:2.1": "Deviddhipatto 'si mahānubhāvo ",
  "vv66:2.2": "manussabhūto kim akāsi puññaṃ ",
  "vv66:2.3": "kenāsi evaṃ jalitānubhāvo ",
  "vv66:2.4": "vaṇṇo ca te sabbadisā pabhāsatī ti. [=66].3 ",
  "vv66:3.1": "So devaputto attamano ",
  "vv66:3.2": "Moggallānena pucchito pañhaṃ puṭṭho viyākāsi ",
  "vv66:3.3": "yassa kammass' idaṃ phalaṃ. [=66].4 ",
  "vv66:4.1": "Ahañ ca bhariyā ca manussaloke ",
  "vv66:4.2": "opānabhūtā gharam āvasimha ",
  "vv66:4.3": "annañ ca pānañ ca pasannacittā ",
  "vv66:4.4": "sakkacca dānaṃ vipulaṃ adamha. [=66].5 ",
  "vv66:5.1": "Tena m' etādiso vaṇṇo ",
  "vv66:5.2": "tena me idha-m-ijjhati uppajjanti ca me bhogā ye keci manaso piyā. [=66].6 Akkhāmi te bhikkhu mahānubhāva manussabhūto yam akāsi puññaṃ ten' amhi evaṃ jalitānubhāvo ",
  "vv66:5.3": "vaṇṇo ca me sabbadisā pabhāsatī ti. Dutiya-agāriyavimānaṃ [=67].1 Uccam idaṃ ",
  "vv66:6.1": ""
}
