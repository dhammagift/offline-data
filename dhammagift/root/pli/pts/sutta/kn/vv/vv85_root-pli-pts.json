  "vv85:0.3": "",
  "vv85:0.4": "",
  "vv85:1.1": "maṇithūṇaṃ vimānaṃ ",
  "vv85:1.2": "samantato dvādasayojanāni ",
  "vv85:1.3": "kūṭāgārā sattasatā uḷārā ",
  "vv85:1.4": "veḷuriyatthambhā rucakatthatā subhā. [=85].2 ",
  "vv85:2.1": "Tatth' acchasi pivasi khādasī ca ",
  "vv85:2.2": "dibbā ca vīṇā pavadanti vaggū ",
  "vv85:2.3": "dibbā rasā kāmaguṇ' ettha pañca ",
  "vv85:2.4": "nāriyo ca naccanti suvaṇṇachannā. [=85].3 ",
  "vv85:3.1": "Kena t' etādiso vaṇṇo ",
  "vv85:3.2": "kena te idha-m-ijjhati ",
  "vv85:3.3": "uppajjanti ca te bhogā ",
  "vv85:3.4": "ye keci manaso piyā. [=85].4 ",
  "vv85:4.1": "Pucchāmi taṃ deva mahānubhāva ",
  "vv85:4.2": "manussabhūto kim akāsi puññaṃ ",
  "vv85:4.3": "kenāsi evaṃ jalitānubhāvo ",
  "vv85:4.4": "vaṇṇo ca te sabbadisā pabhāsatī ti. [=85].5 ",
  "vv85:5.1": "So devaputto attamano ",
  "vv85:5.2": "Moggallānena pucchito ",
  "vv85:5.3": "pañhaṃ puṭṭho viyākāsi ",
  "vv85:5.4": "yassa kammass' idaṃ phalaṃ. [=85].6 ",
  "vv85:6.1": "Dunikkhittaṃ mālaṃ sunikkhipitvā ",
  "vv85:6.2": "patiṭṭhapetvā sugatassa thūpe ",
  "vv85:6.3": "mahiddhiko c' amhi mahānubhāvo ",
  "vv85:6.4": "dibbehi kāmehi samaṅgibhūto. [=85].7 ",
  "vv85:7.1": "Tena m' etādiso vaṇṇo ",
  "vv85:7.2": "tena me idha-m-ijjhati ",
  "vv85:7.3": "uppajjanti ca me bhogā ",
  "vv85:7.4": "ye keci manaso piyā. [=85].8 ",
  "vv85:8.1": "Akkhāmi te bhikkhu mahānubhāva ",
  "vv85:8.2": "manussabhūto yam ahaṃ akāsiṃ ",
  "vv85:8.3": "ten' amhi evaṃ jalitānubhāvo ",
  "vv85:8.4": "vaṇṇo ca me sabbadisā pabhāsatī ti. ",
  "vv85:9.1": "Sunikkhittavimānaṃ ",
  "vv85:9.2": "",
  "vv85:10.1": "Tass' uddānaṃ: ",
  "vv85:11.1": "Dve daliddā dve vihārā ",
  "vv85:11.2": "bhatako gopāla-Kanthakā ",
  "vv85:11.3": "anekavaṇṇa-maṭṭakuṇḍalī ",
  "vv85:11.4": "Serissako sunikkhittaṃ; ",
  "vv85:11.5": "purisānaṃ tatiyo vaggo ti. Vimānavatthu niṭṭhitaṃ ",
  "vv85:12.1": "",
  "vv85:13.1": ""
}
