  "vv68:0.4": "",
  "vv68:1.1": "Cando yathā vigatavalāhake nabhe ",
  "vv68:1.2": "obhāsayaṃ gacchati antalikkhe ",
  "vv68:1.3": "tathūpamaṃ tuyham idaṃ vimānaṃ ",
  "vv68:1.4": "obhāsayaṃ tiṭṭhati antalikkhe. [=68].2 ",
  "vv68:2.1": "Deviddhipatto 'si mahānubhāvo ",
  "vv68:2.2": "manussabhūto kim akāsi puññaṃ ",
  "vv68:2.3": "kenāsi evaṃ jalitānubhāvo ",
  "vv68:2.4": "vaṇṇo ca te sabbadisā pabhāsatī ti. [=68].3 ",
  "vv68:3.1": "So devaputto attamano ",
  "vv68:3.2": "Moggallānena pucchito pañhaṃ puṭṭho viyākāsi ",
  "vv68:3.3": "yassa kammass' idaṃ phalaṃ. [=68].4 ",
  "vv68:4.1": "Ahañ ca bhariyā ca manussaloke ",
  "vv68:4.2": "upassayaṃ arahato adamha ",
  "vv68:4.3": "annañ ca pānañ ca pasannacittā ",
  "vv68:4.4": "sakkacca dānaṃ vipulaṃ adamha. [=68].5 ",
  "vv68:5.1": "Tena m' etādiso vaṇṇo ",
  "vv68:5.2": "tena me idha-m-ijjhati uppajjanti ca me bhogā ye keci manaso piyā. [=68].6 Akkhāmi te bhikkhu mahānubhāva manussabhūto yam akāsi puññaṃ ten' amhi evaṃ jalitānubhāvo ",
  "vv68:5.3": "vaṇṇo ca me sabbadisā pabhāsatī ti. Upassayadāyakavimānaṃ [=69].1 ",
  "vv68:6.1": ""
}
