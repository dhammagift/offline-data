  "vv4:0.1": "",
  "vv4:0.2": "",
  "vv4:0.3": "",
  "vv4:0.4": "",
  "vv4:1.1": "Pīṭhaṃ te veḷuriyamayaṃ uḷāraṃ ",
  "vv4:1.2": "manojavaṃ gacchati yena kāmaṃ ",
  "vv4:1.3": "alaṅkate malyadhare suvatthe ",
  "vv4:1.4": "obhāsasi vijju-r-iv' abbhakūṭaṃ. [=4].2 ",
  "vv4:2.1": "Kena t' etādiso vaṇṇo ",
  "vv4:2.2": "kena te idha-m-ijjhati ",
  "vv4:2.3": "uppajjanti ca te bhogā ",
  "vv4:2.4": "ye keci manaso piyā. [=4].3 ",
  "vv4:3.1": "Pucchāmi taṃ devi mahānubhāve ",
  "vv4:3.2": "manussabhūtā kim akāsi puññaṃ ",
  "vv4:3.3": "kenāsi evaṃ jalitānubhāvā ",
  "vv4:3.4": "vaṇṇo ca te sabbadisā pabhāsatī ti. [=4].4 ",
  "vv4:4.1": "Sā devatā attamanā ",
  "vv4:4.2": "Moggallānena pucchitā ",
  "vv4:4.3": "pañhaṃ puṭṭhā viyākāsi ",
  "vv4:4.4": "yassa kammass' idaṃ phalaṃ: [=4].5 ",
  "vv4:5.1": "Appassa kammassa phalaṃ mamedaṃ ",
  "vv4:5.2": "yen' amhi evaṃ jalitānubhāvā. [=4].6 ",
  "vv4:5.3": "Ahaṃ manussesu manussabhūtā ",
  "vv4:5.4": "purimāya jātiyā manussaloke, ",
  "vv4:6.1": "addasaṃ virajaṃ bhikkhuṃ ",
  "vv4:6.2": "vippasannam anāvilaṃ ",
  "vv4:6.3": "tassa adās' ahaṃ pīṭhaṃ ",
  "vv4:6.4": "pasannā sehi pāṇihi. [=4].7 ",
  "vv4:7.1": "Tena m' etādiso vaṇṇo ",
  "vv4:7.2": "tena me idha-m-ijjhati ",
  "vv4:7.3": "uppajjanti ca me bhogā ",
  "vv4:7.4": "ye keci manaso piyā. [=4].8 ",
  "vv4:8.1": "Akkhāmi te bhikkhu mahānubhāva ",
  "vv4:8.2": "manussabhūtā yam akāsi puññaṃ ",
  "vv4:8.3": "ten' amhi evaṃ jalitānubhāvā ",
  "vv4:8.4": "vaṇṇo ca me sabbadisā pabhāsatī ti. ",
  "vv4:9.1": "Catutthapīṭhavimānaṃ [=5].1 "
}
