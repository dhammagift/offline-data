{
  "vv63:0.1": "",
  "vv63:0.2": "",
  "vv63:0.3": "",
  "vv63:0.4": "",
  "vv63:1.1": "Daḷhadhammā nisārassa ",
  "vv63:1.2": "dhanuṃ olubbha tiṭṭhasi ",
  "vv63:1.3": "khattiyo nu 'si rājañño ",
  "vv63:1.4": "ādu luddo vane caro ti. [=63].2 ",
  "vv63:2.1": "Assakādhipatissāhaṃ ",
  "vv63:2.2": "bhante putto vane caro ",
  "vv63:2.3": "nāmaṃ me bhikkhu te brūmi ",
  "vv63:2.4": "Sujāto iti maṃ vidū. [=63].3 ",
  "vv63:3.1": "Mige gavesamāno 'haṃ ",
  "vv63:3.2": "ogāhanto brahāvanaṃ ",
  "vv63:3.3": "migaṃ tañ c' eva nāddakkhiṃ ",
  "vv63:3.4": "tañ ca disvā ṭhito ahan ti. [=63].4 ",
  "vv63:4.1": "Svāgataṃ te mahāpuñña ",
  "vv63:4.2": "atho te adurāgataṃ ",
  "vv63:4.3": "etto udakam ādāya ",
  "vv63:4.4": "pāde pakkhālayassu te. [=63].5 ",
  "vv63:5.1": "Idam pi pāniyaṃ sītaṃ ",
  "vv63:5.2": "ābhataṃ girigabbharā ",
  "vv63:5.3": "rājaputta tato pītvā ",
  "vv63:5.4": "santhatasmiṃ upāvisā ti. [=63].6 ",
  "vv63:6.1": "Kalyāṇī vata te vācā ",
  "vv63:6.2": "savaṇīyā mahāmuni ",
  "vv63:6.3": "nelā atthavatī vaggu ",
  "vv63:6.4": "mantā atthañ ca bhāsasi. [=63].7 ",
  "vv63:7.1": "Kā te rati vane viharato ",
  "vv63:7.2": "isinisabha vadehi puṭṭho ",
  "vv63:7.3": "tava vacanapathaṃ nisāmayitvā ",
  "vv63:7.4": "atthadhammapadaṃ samācaremase ti. [=63].8 ",
  "vv63:8.1": "Ahiṃsā sabbapāṇīnaṃ ",
  "vv63:8.2": "kumār' amhāka ruccati ",
  "vv63:8.3": "theyyā ca aticārā ca ",
  "vv63:8.4": "majjapānā ca ārati, [=63].9 ",
  "vv63:9.1": "Ārati samacariyā ca ",
  "vv63:9.2": "bāhusaccaṃ kataññutā ",
  "vv63:9.3": "diṭṭh' eva dhamme pāsaṃsā ",
  "vv63:9.4": "dhammā ete pasaṃsiyā ti. [=63].10 ",
  "vv63:10.1": "Santike maraṇaṃ tuyhaṃ ",
  "vv63:10.2": "oraṃ māsehi pañcahi ",
  "vv63:10.3": "rājaputta vijānāhi ",
  "vv63:10.4": "attānaṃ parimocayā ti. [=63].11 ",
  "vv63:11.1": "Katamaṃ svāhaṃ janapadaṃ gantvā ",
  "vv63:11.2": "kiṃ kammaṃ kiñ ca porisaṃ ",
  "vv63:11.3": "kāya vā pana vijjāya ",
  "vv63:11.4": "bhaveyyaṃ ajarāmaro ti. [=63].12 ",
  "vv63:12.1": "Na vijjate so padeso ",
  "vv63:12.2": "kammaṃ vijjā ca porisaṃ ",
  "vv63:12.3": "yattha gantvā bhave macco ",
  "vv63:12.4": "rājaputtājarāmaro. [=63].13 ",
  "vv63:13.1": "Mahaddhanā mahābhogā ",
  "vv63:13.2": "raṭṭhavanto pi khattiyā ",
  "vv63:13.3": "pahūtadhanadhaññāse ",
  "vv63:13.4": "te pi na ajarāmarā. [=63].14 ",
  "vv63:14.1": "Yadi te sutā Andhakaveṇhuputtā ",
  "vv63:14.2": "sūrā vīrā vikkantappahārino ",
  "vv63:14.3": "te pi āyukkhayaṃ pattā ",
  "vv63:14.4": "viddhastā sassatī samā. [=63].15 ",
  "vv63:15.1": "Khattiyā brāhmaṇā vessā ",
  "vv63:15.2": "suddā caṇḍālapukkusā ",
  "vv63:15.3": "ete c' aññe ca jātiyā ",
  "vv63:15.4": "te pi na ajarāmarā. [=63].16 ",
  "vv63:16.1": "Ye mantaṃ parivattenti ",
  "vv63:16.2": "chaḷaṅgaṃ brahmacintitaṃ ",
  "vv63:16.3": "ete c' aññe ca vijjāya ",
  "vv63:16.4": "te pi no ajarāmarā. [=63].17 ",
  "vv63:17.1": "Isayo cāpi ye santā ",
  "vv63:17.2": "saññatattā tapassino ",
  "vv63:17.3": "sarīraṃ te pi kālena ",
  "vv63:17.4": "vijahanti tapassino. [=63].18 ",
  "vv63:18.1": "Bhāvitattā pi arahanto ",
  "vv63:18.2": "katakiccā anāsavā ",
  "vv63:18.3": "nikkhipanti imaṃ dehaṃ ",
  "vv63:18.4": "puññapāpaparikkhayā ti. [=63].19 ",
  "vv63:19.1": "Subhāsitā atthavatī ",
  "vv63:19.2": "gāthāyo te mahāmuni ",
  "vv63:19.3": "nijjhatto 'mhi subhaṭṭhena ",
  "vv63:19.4": "tvañ ca me saraṇaṃ bhavā ti. [=63].20 ",
  "vv63:20.1": "Mā maṃ tvaṃ saraṇaṃ gaccha ",
  "vv63:20.2": "tam eva saraṇaṃ vaja ",
  "vv63:20.3": "Sakyaputtaṃ mahāvīraṃ ",
  "vv63:20.4": "yam ahaṃ saraṇaṃ gato ti. [=63].21 ",
  "vv63:21.1": "Katarasmiṃ so janapade ",
  "vv63:21.2": "satthā tumhāka mārisa ",
  "vv63:21.3": "aham pi daṭṭhuṃ gacchissaṃ ",
  "vv63:21.4": "jinaṃ appaṭipuggalan ti. [=63].22 ",
  "vv63:22.1": "Puratthimasmiṃ janapade ",
  "vv63:22.2": "Okkākakulasambhavo ",
  "vv63:22.3": "satthāsi purisājañño ",
  "vv63:22.4": "so ca kho parinibbuto ti. [=63].23 ",
  "vv63:23.1": "Sace hi buddho tiṭṭheyya ",
  "vv63:23.2": "satthā tumhāka mārisa ",
  "vv63:23.3": "yojanāni sahassāni ",
  "vv63:23.4": "gaccheyyaṃ payirupāsituṃ. [=63].24 ",
  "vv63:24.1": "Yato ca kho parinibbuto ",
  "vv63:24.2": "satthā tumhāka mārisa ",
  "vv63:24.3": "nibbutam pi mahāvīraṃ ",
  "vv63:24.4": "gacchāmi saraṇaṃ ahaṃ. [=63].25 ",
  "vv63:25.1": "Upemi saraṇaṃ buddhaṃ ",
  "vv63:25.2": "dhammañ cāpi anuttaraṃ ",
  "vv63:25.3": "saṅghañ ca naradevassa ",
  "vv63:25.4": "gacchāmi saraṇaṃ ahaṃ. [=63].26 ",
  "vv63:26.1": "Pāṇātipātā viramāmi khippaṃ ",
  "vv63:26.2": "loke adinnaṃ parivajjayāmi ",
  "vv63:26.3": "amajjapo no ca musā bhaṇāmi ",
  "vv63:26.4": "sakena dārena ca homi tuṭṭho ti. [=63].27 ",
  "vv63:27.1": "Sahassaraṃsīva yathā mahappabho ",
  "vv63:27.2": "disaṃ yathā bhāti nabhe anukkamaṃ ",
  "vv63:27.3": "tathappakāro tav' ayaṃ mahāratho ",
  "vv63:27.4": "samantato yojanasatta-m-āyato. [=63].28 ",
  "vv63:28.1": "Suvaṇṇapaṭṭehi samantam otthaṭo ",
  "vv63:28.2": "ur' assa muttāhi maṇīhi cittito ",
  "vv63:28.3": "lekhā suvaṇṇassa ca rūpiyassa ca ",
  "vv63:28.4": "sobhanti veḷuriyamayā sunimmitā. [=63].29 ",
  "vv63:29.1": "Sīsañ c' idaṃ veḷuriyassa nimmitaṃ ",
  "vv63:29.2": "yugañ c' idaṃ lohitakāya cittitaṃ ",
  "vv63:29.3": "yuttā suvaṇṇassa ca rūpiyassa ca ",
  "vv63:29.4": "sobhanti assā ca p' ime manojavā. [=63].30 ",
  "vv63:30.1": "So tiṭṭhasi hemarathe adhiṭṭhito ",
  "vv63:30.2": "devānam indo va sahassavāhano ",
  "vv63:30.3": "pucchāmi tāhaṃ yasavanta kovidaṃ ",
  "vv63:30.4": "kathaṃ tayā laddho ayaṃ uḷāro ti. [=63].31 ",
  "vv63:31.1": "Sujāto nām' ahaṃ bhante ",
  "vv63:31.2": "rājaputto pure ahuṃ ",
  "vv63:31.3": "tvañ ca maṃ anukampāya ",
  "vv63:31.4": "saññamasmiṃ nivesayi. [=63].32 ",
  "vv63:32.1": "Khīṇāyukañ ca maṃ ñatvā ",
  "vv63:32.2": "sarīraṃ pādāsi satthuno: ",
  "vv63:32.3": "imaṃ Sujāta pūjehi ",
  "vv63:32.4": "taṃ te atthāya hehiti. [=63].33 ",
  "vv63:33.1": "Tāhaṃ gandhehi mālehi ",
  "vv63:33.2": "pūjayitvā samuyyuto ",
  "vv63:33.3": "pahāya mānusaṃ dehaṃ ",
  "vv63:33.4": "upapanno 'mhi Nandanaṃ. [=63].34 ",
  "vv63:34.1": "Nandanopavane ramme ",
  "vv63:34.2": "nānādijagaṇāyute ",
  "vv63:34.3": "ramāmi naccagītehi ",
  "vv63:34.4": "accharāhi purakkhato ti. ",
  "vv63:35.1": "Cūḷarathavimānaṃ [=64].1 "
}
