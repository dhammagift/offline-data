  "vv30:0.1": "",
  "vv30:0.2": "",
  "vv30:0.3": "",
  "vv30:0.4": "",
  "vv30:1.1": "Obhāsayitvā paṭhaviṃ sadevakaṃ ",
  "vv30:1.2": "atirocasi candimasūriyā viya ",
  "vv30:1.3": "siriyā ca vaṇṇena yasena tejasā ",
  "vv30:1.4": "Brahmā va deve Tidase sa-h-Indake. [=30].2 ",
  "vv30:2.1": "Pucchāmi taṃ uppalamāladhārinī ",
  "vv30:2.2": "āveḷinī kañcanasannibhattace ",
  "vv30:2.3": "alaṅkate uttamavatthadhārinī ",
  "vv30:2.4": "kā tvaṃ subhe devate vandase mamaṃ. [=30].3 ",
  "vv30:3.1": "Kiṃ tvaṃ pure kammam akāsi attanā ",
  "vv30:3.2": "manussabhūtā purimāya jātiyā ",
  "vv30:3.3": "dānaṃ suciṇṇaṃ atha sīlasaññamaṃ ",
  "vv30:3.4": "kenūpapannā sugatiṃ yasassinī. ",
  "vv30:3.5": "Devate pucchitācikkha ",
  "vv30:3.6": "kissa kammass' idam phalam. [=30].4 ",
  "vv30:4.1": "Idāni bhante imam eva gāmaṃ ",
  "vv30:4.2": "piṇḍāya amhāka gharaṃ upāgami ",
  "vv30:4.3": "tato te ucchussa adāsi khaṇḍikaṃ ",
  "vv30:4.4": "pasannacittā atulāya pītiyā. [=30].5 ",
  "vv30:5.1": "Sassu ca pacchā anuyuñjate mamaṃ: ",
  "vv30:5.2": "kahan nu ucchuṃ vadhuke avākiri. ",
  "vv30:5.3": "Na' cchaḍḍitaṃ no pana khāditaṃ mayā ",
  "vv30:5.4": "santassa bhikkhussa sayaṃ adās' ahaṃ. [=30].6 ",
  "vv30:6.1": "Tuyham nv idaṃ issariyaṃ atho mama ",
  "vv30:6.2": "iti ssā sassu paribhāsate mamaṃ; ",
  "vv30:6.3": "pīṭhaṃ gahetvā pahāram adāsi me ",
  "vv30:6.4": "tato cutā kālakatāmhi devatā. [=30].7 ",
  "vv30:7.1": "Tad eva kammaṃ kusalaṃ kataṃ mayā ",
  "vv30:7.2": "sukhañ ca kammaṃ anubhomi attanā ",
  "vv30:7.3": "devehi saddhiṃ paricārayām' ahaṃ ",
  "vv30:7.4": "modām' ahaṃ kāmaguṇehi pañcahi. [=30].8 ",
  "vv30:8.1": "Tad eva kammaṃ kusalaṃ kataṃ mayā ",
  "vv30:8.2": "sukhañ ca kammaṃ anubhomi attanā ",
  "vv30:8.3": "devindaguttā Tidasehi rakkhitā ",
  "vv30:8.4": "samappitā kāmaguṇehi pañcahi. [=30].9 ",
  "vv30:9.1": "Etādisaṃ puññaphalaṃ anappakaṃ ",
  "vv30:9.2": "mahāvipākā mama ucchudakkhiṇā ",
  "vv30:9.3": "devehi saddhiṃ paricārayām' ahaṃ ",
  "vv30:9.4": "modām' ahaṃ kāmaguṇehi pañcahi. [=30].10 ",
  "vv30:10.1": "Etādisaṃ puññaphalaṃ anappakaṃ ",
  "vv30:10.2": "mahājutīkā mama ucchudakkhiṇā ",
  "vv30:10.3": "devindaguttā Tidasehi rakkhitā ",
  "vv30:10.4": "sahassanetto-r-iva Nandane vane. [=30].11 ",
  "vv30:11.1": "Tuvañ ca bhante anukampakaṃ viduṃ ",
  "vv30:11.2": "upecca vandiṃ kusalañ ca pucchisaṃ ",
  "vv30:11.3": "tato te ucchussa adāsi khaṇḍikaṃ ",
  "vv30:11.4": "pasannacittā atulāya pītiyā ti. ",
  "vv30:12.1": "Ucchudāyikāvimānaṃ [=31].1 "
}
