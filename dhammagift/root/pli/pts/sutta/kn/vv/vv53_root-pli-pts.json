  "vv53:0.3": "",
  "vv53:0.4": "",
  "vv53:1.1": "Yo vadataṃ pavaro manujesu ",
  "vv53:1.2": "Sakyamunī bhagavā katakicco ",
  "vv53:1.3": "pāragato balaviriya-samaṅgī ",
  "vv53:1.4": "taṃ sugataṃ saraṇattham upehi. [=53].2 ",
  "vv53:2.1": "Rāgavirāgam anejam asokaṃ ",
  "vv53:2.2": "dhammam asaṅkhatam appaṭikūlaṃ ",
  "vv53:2.3": "madhuram imaṃ paguṇaṃ suvibhattaṃ ",
  "vv53:2.4": "dhammam imaṃ saraṇattham upehi. [=53].3 ",
  "vv53:3.1": "Yattha ca dinnamahapphalam āhu ",
  "vv53:3.2": "catusu sucīsu purisayugesu ",
  "vv53:3.3": "aṭṭha ca puggaladhammadasā te ",
  "vv53:3.4": "saṅgham imaṃ saraṇattham upehi. [=53].4 ",
  "vv53:4.1": "Na tathā tapati nabhasmiṃ suriyo ",
  "vv53:4.2": "cando ca na bhāsati na phusso ",
  "vv53:4.3": "yathātulam idaṃ mahappabhāsaṃ ",
  "vv53:4.4": "ko nu tvaṃ Tidivā mahiṃ upāgā. [=53].5 ",
  "vv53:5.1": "Chindati ca raṃsi pabhaṅkarassa ",
  "vv53:5.2": "sādhikavīsativojanāni ābhā ",
  "vv53:5.3": "rattim pi ca yathā divaṃ karoti ",
  "vv53:5.4": "parisuddhaṃ vimalaṃ subhaṃ vimānaṃ. [=53].6 ",
  "vv53:6.1": "Bahupadumavicitrapuṇḍarīkaṃ ",
  "vv53:6.2": "vokiṇṇaṃ kusumehi nekacittaṃ ",
  "vv53:6.3": "arajavirajahemajālacchannaṃ ",
  "vv53:6.4": "ākāse tapati yathā pi suriyo. [=53].7 ",
  "vv53:7.1": "Rattambarapītavāsasāhi ",
  "vv53:7.2": "agarupiyaṅgucandanussadāhi ",
  "vv53:7.3": "kañcanatanusannibhattacāhi ",
  "vv53:7.4": "paripūraṃ gaganaṃ va tārakāhi. [=53].8 ",
  "vv53:8.1": "Naranāriyo bahuk' ettha nekavaṇṇā ",
  "vv53:8.2": "kusumavibhūsitābharaṇ' ettha sumanā ",
  "vv53:8.3": "anilapamuñcitā pavanti surabhiṃ. ",
  "vv53:8.4": "tapanīyavitatā suvaṇṇacchādanā. [=53].9 ",
  "vv53:9.1": "Kissa saṃyamassa ayaṃ vipāko ",
  "vv53:9.2": "kenāsi kammaphalen' idhūpapanno ",
  "vv53:9.3": "yathā ca te adhigatam idaṃ vimānaṃ ",
  "vv53:9.4": "tad anupadaṃ avacāsi iṅgha puṭṭho ti. [=53].10 Yam ",
  "vv53:10.1": "idha pathe samecca māṇavena ",
  "vv53:10.2": "satthānusāsi anukampamāno ",
  "vv53:10.3": "tava ratanavarassa dhammaṃ sutvā ",
  "vv53:10.4": "karissāmī ti ca bravittha Chatto, [=53].11 ",
  "vv53:11.1": "Jinavarapavaraṃ upemi saraṇaṃ ",
  "vv53:11.2": "dhammañ cāpi tath' eva bhikkhusaṅghaṃ, ",
  "vv53:11.3": "no ti paṭhamaṃ avocāhaṃ bhante ",
  "vv53:11.4": "pacchā te vacanaṃ tath' ev' akāsiṃ. [=53].12 ",
  "vv53:12.1": "Mā ca pāṇavadhaṃ vividhaṃ carassu asuciṃ ",
  "vv53:12.2": "na hi pāṇesu asaññataṃ avaṇṇayiṃsu sappaññā- ",
  "vv53:12.3": "no ti paṭhamaṃ avocāhaṃ bhante ",
  "vv53:12.4": "pacchā te vacanaṃ tath' ev' akāsiṃ. [=53].13 ",
  "vv53:13.1": "Mā ca parajanassa rakkhitam pi ādātabbam ",
  "vv53:13.2": "amaññittha adinnaṃ ",
  "vv53:13.3": "no ti paṭhamaṃ avocāhaṃ bhante ",
  "vv53:13.4": "pacchā te vacanaṃ tath' ev' akāsiṃ. [=53].14 ",
  "vv53:14.1": "Mā ca parajanassa rakkhitāyo ",
  "vv53:14.2": "parabhariyā agamā anariyam etaṃ ",
  "vv53:14.3": "no ti paṭhamaṃ avocāhaṃ bhante ",
  "vv53:14.4": "pacchā te vacanaṃ tath' ev' akāsiṃ. [=53].15 ",
  "vv53:15.1": "Mā ca vitathaṃ aññathā abhāṇi ",
  "vv53:15.2": "na hi musāvādaṃ avaṇṇayiṃsu sapaññā ",
  "vv53:15.3": "no ti paṭhamaṃ avocāhaṃ bhante ",
  "vv53:15.4": "pacchā te vacanaṃ tath' ev' akāsiṃ. [=53].16 ",
  "vv53:16.1": "Yena ca purisassa apeti saññā ",
  "vv53:16.2": "taṃ majjaṃ parivajjayassu sabbaṃ ",
  "vv53:16.3": "no ti paṭhamaṃ avocāhaṃ bhante ",
  "vv53:16.4": "pacchā te vacanaṃ tath' ev' akāsiṃ. [=53].17 ",
  "vv53:17.1": "Svāhaṃ idha pañca sikkhā karitvā ",
  "vv53:17.2": "paṭipajjitvā tathāgatassa dhamme ",
  "vv53:17.3": "dvepatham agamāsiṃ coramajjhe ",
  "vv53:17.4": "te maṃ tattha vadhiṃsu bhogahetu. [=53].18 ",
  "vv53:18.1": "Ettakam idaṃ anussarāmi kusalaṃ ",
  "vv53:18.2": "tato paraṃ na me vijjati aññaṃ ",
  "vv53:18.3": "tena sucaritena kammunāhaṃ ",
  "vv53:18.4": "upapanno Tidivesu kāmakāmī. [=53].19 ",
  "vv53:19.1": "Passa khaṇamuhuttasaññamassa ",
  "vv53:19.2": "anudhammapaṭipattiyā vipākaṃ ",
  "vv53:19.3": "jalam iva yasasā samekkhamānā ",
  "vv53:19.4": "bahukā maṃ pihayanti hīnakāmā. [=53].20 ",
  "vv53:20.1": "Passa katipayāya desanāya ",
  "vv53:20.2": "sugatiñ c' amhi gato sukhañ ca patto ",
  "vv53:20.3": "ye ca te satataṃ suṇanti dhammaṃ ",
  "vv53:20.4": "maññe te amataṃ phusanti khemaṃ. [=53].21 ",
  "vv53:21.1": "Appakam pi kataṃ mahāvipākaṃ ",
  "vv53:21.2": "vipulaṃ hoti tathāgatassa dhamme ",
  "vv53:21.3": "passa katapuññatāya Chatto ",
  "vv53:21.4": "obhāseti paṭhaviṃ yathā pi suriyo. [=53].22 ",
  "vv53:22.1": "Kim idaṃ kusalaṃ ācarema ",
  "vv53:22.2": "icc eke hi samecca mantayanti ",
  "vv53:22.3": "te mayaṃ punar eva laddha mānusattaṃ ",
  "vv53:22.4": "paṭipannā viharemu sīlavanto. [=53].23 ",
  "vv53:23.1": "Bahukāro m' anukampako ca satthā ",
  "vv53:23.2": "iti me sati agamā divādivassa ",
  "vv53:23.3": "svāhaṃ upagato 'mhi saccanāmaṃ ",
  "vv53:23.4": "anukampassu puna pi suṇemu dhammaṃ. [=53].24 ",
  "vv53:24.1": "Ye 'dha pajahanti kāmarāgaṃ ",
  "vv53:24.2": "bhavarāgānusayañ ca pahāya mohaṃ ",
  "vv53:24.3": "na ca te puna upenti gabbhaseyyaṃ ",
  "vv53:24.4": "parinibbānagatā hi sītibhūtā ti. Chattamāṇavakavimānaṃ [=54].1 Uccam idaṃ ",
  "vv53:25.1": ""
}
