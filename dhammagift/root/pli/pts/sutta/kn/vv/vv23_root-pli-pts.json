{
  "vv23:0.1": "",
  "vv23:0.2": "",
  "vv23:0.3": "",
  "vv23:0.4": "",
  "vv23:1.1": "Abhikkantena vaṇṇena ",
  "vv23:1.2": "yā tvaṃ tiṭṭhasi devate ",
  "vv23:1.3": "obhāsentī disā sabbā ",
  "vv23:1.4": "osadhī viya tārakā, [=23].2 ",
  "vv23:2.1": "Kena t' etādiso vaṇṇo ",
  "vv23:2.2": "kena te idha-m-ijjhati ",
  "vv23:2.3": "uppajjanti ca te bhogā ",
  "vv23:2.4": "ye keci manaso piyā. [=23].3 ",
  "vv23:3.1": "Pucchāmi taṃ devi mahānubhāve ",
  "vv23:3.2": "manussabhūtā kim akāsi puññaṃ ",
  "vv23:3.3": "kenāsi evaṃ jalitānubhāvā ",
  "vv23:3.4": "vaṇṇo ca te sabbadisā pabhāsatī ti. [=23].4 ",
  "vv23:4.1": "Sā devatā attamanā ",
  "vv23:4.2": "Moggallānena pucchitā ",
  "vv23:4.3": "pañhaṃ puṭṭhā viyākāsi ",
  "vv23:4.4": "yassa kammass' idaṃ phalaṃ: [=23].5 ",
  "vv23:5.1": "Soṇadinnā ti maṃ aññiṃsu ",
  "vv23:5.2": "Nālandāyaṃ upāsikā ",
  "vv23:5.3": "saddhā sīlena sampannā ",
  "vv23:5.4": "saṃvibhāgaratā sadā. [=23].6 ",
  "vv23:6.1": "Acchādanañ ca bhattañ ca ",
  "vv23:6.2": "senāsanaṃ padīpiyaṃ ",
  "vv23:6.3": "adāsiṃ ujubhūtesu ",
  "vv23:6.4": "vippasannena cetasā. [=23].7 ",
  "vv23:7.1": "Cātuddasiṃ pañcadasiṃ ",
  "vv23:7.2": "yā ca pakkhassa aṭṭhamī ",
  "vv23:7.3": "pāṭihāriyapakkhañ ca ",
  "vv23:7.4": "aṭṭhaṅgasusamāgataṃ ",
  "vv23:8.1": "uposatham upavasissaṃ ",
  "vv23:8.2": "sadā sīlesu saṃvutā. [=23].8 ",
  "vv23:8.3": "",
  "vv23:8.4": "",
  "vv23:9.1": "Pāṇātipātā viratā ",
  "vv23:9.2": "musāvādā ca saññatā ",
  "vv23:9.3": "theyyā ca aticārā ca ",
  "vv23:9.4": "majjapānā ca ārakā [=23].9 ",
  "vv23:10.1": "Pañcasikkhāpade ratā ",
  "vv23:10.2": "ariyasaccāna kovidā ",
  "vv23:10.3": "upāsikā cakkhumato ",
  "vv23:10.4": "Gotamassa yasassino. [=23].10 ",
  "vv23:11.1": "Tena m' etādiso vaṇṇo ",
  "vv23:11.2": "tena me idha-m-ijjhati uppajjanti ca me bhogā ye keci manaso piyā. [=23].11 Akkhāmi te bhikkhu mahānubhāva manussabhūtā yam ahaṃ akāsiṃ ten' amhi evaṃ jalitānubhāvā ",
  "vv23:11.3": "vaṇṇo ca me sabbadisā pabhāsatī ti. ",
  "vv23:12.1": "Soṇadinnā-vimānaṃ [=24].1 "
}
