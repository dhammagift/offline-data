  "vv15:0.1": "",
  "vv15:0.2": "",
  "vv15:0.3": "",
  "vv15:0.4": "",
  "vv15:1.1": "Abhikkantena vaṇṇena ",
  "vv15:1.2": "yā tvaṃ tiṭṭhasi devate ",
  "vv15:1.3": "obhāsentī disā sabbā ",
  "vv15:1.4": "osadhī viya tārakā, [=15].2 ",
  "vv15:2.1": "Kena t' etādiso vaṇṇo ",
  "vv15:2.2": "kena te idha-m-ijjhati ",
  "vv15:2.3": "uppajjanti ca te bhogā ",
  "vv15:2.4": "ye keci manaso piyā. [=15].3 ",
  "vv15:3.1": "Pucchāmi taṃ devi mahānubhāve ",
  "vv15:3.2": "manussabhūtā kim akāsi puññaṃ ",
  "vv15:3.3": "kenāsi evaṃ jalitānubhāvā ",
  "vv15:3.4": "vaṇṇo ca te sabbadisā pabhāsatī ti. [=15].4 ",
  "vv15:4.1": "Sā devatā attamanā ",
  "vv15:4.2": "Moggallānena pucchitā ",
  "vv15:4.3": "pañhaṃ puṭṭhā viyākāsi ",
  "vv15:4.4": "yassa kammass' idaṃ phalaṃ: [=15].5 ",
  "vv15:5.1": "Issā ca maccheram atho paḷāso ",
  "vv15:5.2": "nāhosi mayhaṃ gharam āvasantiyā ",
  "vv15:5.3": "akkodhanā bhattu vasānuvattinī ",
  "vv15:5.4": "uposathe nicc' aham appamattā. [=15].6 ",
  "vv15:6.1": "Cātuddasiṃ pañcadasiṃ ",
  "vv15:6.2": "yā ca pakkhassa aṭṭhamī ",
  "vv15:6.3": "pāṭihāriyapakkhañ ca ",
  "vv15:6.4": "aṭṭhaṅgasusamāgataṃ [=15].7 ",
  "vv15:7.1": "Uposathaṃ upavasissaṃ ",
  "vv15:7.2": "sadā sīlesu saṃvutā ",
  "vv15:7.3": "saññamā saṃvibhāgā ca ",
  "vv15:7.4": "vimānaṃ āvasām' ahaṃ. [=15].8 ",
  "vv15:8.1": "Pāṇātipātā viratā ",
  "vv15:8.2": "musāvādā ca saññatā ",
  "vv15:8.3": "theyyā ca aticārā ca ",
  "vv15:8.4": "majjapānā ca ārakā [=15].9 ",
  "vv15:9.1": "Pañcasikkhāpade ratā ",
  "vv15:9.2": "ariyasaccāna kovidā ",
  "vv15:9.3": "upāsikā cakkhumato ",
  "vv15:9.4": "Gotamassa yasassino. [=15].10 ",
  "vv15:10.1": "Sāhaṃ sakena sīlena ",
  "vv15:10.2": "yasasā ca yasassinī ",
  "vv15:10.3": "anubhomi sakaṃ puññaṃ ",
  "vv15:10.4": "sukhitā c' amhi anāmayā. [=15].11 ",
  "vv15:11.1": "Tena m' etādiso vaṇṇo ",
  "vv15:11.2": "tena me idha-m-ijjhati ",
  "vv15:11.3": "uppajjanti ca me bhogā ",
  "vv15:11.4": "ye keci manaso piyā. [=15].12 ",
  "vv15:12.1": "Akkhāmi te bhikkhu mahānubhāva ",
  "vv15:12.2": "manussabhūtā yam ahaṃ akāsiṃ ",
  "vv15:12.3": "ten' amhi evaṃ jatilānubhāvā ",
  "vv15:12.4": "vaṇṇo ca me sabbadisā pabhāsatī ti. ",
  "vv15:13.1": "Mama ca bhante vacanena bhagavato pāde sirasā vandeyyāsi: ",
  "vv15:13.2": "Uttarā nāma bhante upāsikā bhagavato pāde sirasā vandātī ti. ",
  "vv15:13.3": "Anacchariyaṃ kho pan' etaṃ bhante yaṃ maṃ bhagavā aññatarasmiṃ sāmaññaphale vyākareyya. Taṃ bhagavā sakadāgāmiphale vyākāsī ti. ",
  "vv15:14.1": "Uttarāvimānaṃ [=16].1 "
}
