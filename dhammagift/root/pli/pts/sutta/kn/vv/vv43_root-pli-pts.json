{
  "vv43:0.1": "",
  "vv43:0.2": "",
  "vv43:0.3": "",
  "vv43:0.4": "",
  "vv43:1.1": "Abhikkantena vaṇṇena ",
  "vv43:1.2": "yā tvaṃ tiṭṭhasi devate obhāsentī disā sabbā ",
  "vv43:1.3": "osadhī viya tārakā, [=43].2 ",
  "vv43:2.1": "Kena t' etādiso vaṇṇo ",
  "vv43:2.2": "kena te idha-m-ijjhati uppajjanti ca te bhogā ye keci manaso piyā. [=43].3 Pucchāmi taṃ devi mahānubhāve manussabhūtā kim akāsi puññaṃ kenāsi evaṃ jalitānubhāvā ",
  "vv43:2.3": "vaṇṇo ca te sabbadisā pabhāsatī ti. [=43].4 ",
  "vv43:3.1": "Sā devatā attamanā ",
  "vv43:3.2": "Moggallānena pucchitā pañhaṃ puṭṭhā viyākāsi ",
  "vv43:3.3": "yassa kammass' idaṃ phalaṃ: [=43].5 ",
  "vv43:4.1": "Ahaṃ Andhakavindasmiṃ ",
  "vv43:4.2": "buddhassādiccabandhuno ",
  "vv43:4.3": "adāsiṃ kolasampākaṃ ",
  "vv43:4.4": "kañjikaṃ teladhūpitaṃ. [=43].6 ",
  "vv43:5.1": "Pipphalyā lasuṇena ca ",
  "vv43:5.2": "missaṃ lāmañjakena ca ",
  "vv43:5.3": "adāsiṃ ujubhūtasmiṃ ",
  "vv43:5.4": "vippasannena cetasā. [=43].7 ",
  "vv43:6.1": "Yā mahesittaṃ kāreyya ",
  "vv43:6.2": "cakkavattissa rājino ",
  "vv43:6.3": "nāri sabbaṅgakalyāṇī ",
  "vv43:6.4": "bhattu cānomadassikā ",
  "vv43:6.5": "etassa kañjikadānassa ",
  "vv43:6.6": "kalaṃ nāgghati soḷasiṃ. [=43].8 ",
  "vv43:7.1": "Sataṃ nikkhā sataṃ assā ",
  "vv43:7.2": "sataṃ assatarīrathā ",
  "vv43:7.3": "sataṃ kaññāsahassāni ",
  "vv43:7.4": "āmuttamaṇikuṇṇalā ",
  "vv43:7.5": "etassa kañjikadānassa ",
  "vv43:7.6": "kalaṃ nāgghanti soḷasiṃ. [=43].9 ",
  "vv43:8.1": "Sataṃ Hemavatā nāgā ",
  "vv43:8.2": "īsādantā urūḷhavā ",
  "vv43:8.3": "suvaṇṇakacchā mātaṅgā ",
  "vv43:8.4": "hemakappanavāsasā ",
  "vv43:8.5": "etassa kañjikadānassa ",
  "vv43:8.6": "kalaṃ nāgghanti soḷasiṃ. [=43].10 ",
  "vv43:9.1": "Catunnam api dīpānaṃ ",
  "vv43:9.2": "issaraṃ yo 'dha kāraye ",
  "vv43:9.3": "etassa kañjikadānassa ",
  "vv43:9.4": "kalaṃ nāgghati soḷasin ti. ",
  "vv43:10.1": "Kañjikadāyikāvimānaṃ [=44].1 "
}
