  "vv80:0.1": "",
  "vv80:0.2": "",
  "vv80:0.3": "",
  "vv80:0.4": "",
  "vv80:1.1": "Disvāna devaṃ paṭipucchi bhikkhu: ",
  "vv80:1.2": "ucce vimānamhi ciraṭṭhitīke ",
  "vv80:1.3": "āmuttahatthābharaṇo yasassī ",
  "vv80:1.4": "dibbe vimānamhi yathāsi candimā. [=80].2 ",
  "vv80:2.1": "Alaṅkato malyadharo suvattho ",
  "vv80:2.2": "sukuṇḍalī kappitakesamassu ",
  "vv80:2.3": "āmuttahatthābharaṇo yasassī ",
  "vv80:2.4": "dibbe vimānamhi yathāsi candimā. [=80].3 ",
  "vv80:3.1": "Dibbā ca vīṇā pavadanti vaggū ",
  "vv80:3.2": "aṭṭhaṭṭhakā sikkhitā sādhurūpā ",
  "vv80:3.3": "dibbā ca kaññā Tidasacarā uḷārā ",
  "vv80:3.4": "naccanti gāyanti pamodayanti. [=80].4 ",
  "vv80:4.1": "Deviddhipatto 'si mahāhubhāvo ",
  "vv80:4.2": "manussabhūto kim akāsi puññaṃ ",
  "vv80:4.3": "kenāsi evaṃ jalitānubhāvo ",
  "vv80:4.4": "vaṇṇo ca te sabbadisā pabhāsatī ti. [=80].5 ",
  "vv80:5.1": "So devaputto attamano ",
  "vv80:5.2": "Moggallānena pucchito pañhaṃ puṭṭho viyākāsi ",
  "vv80:5.3": "yassa kammass' idaṃ phalaṃ. [=80].6 ",
  "vv80:6.1": "Ahaṃ manussesu manussabhūto ",
  "vv80:6.2": "saṅgamma rakkhissaṃ paresaṃ dhenuyo ",
  "vv80:6.3": "tato ca āgā samaṇo mam' antike ",
  "vv80:6.4": "gāvo ca māse agamaṃsu khādituṃ. [=80].7 ",
  "vv80:7.1": "Dvay' ajja kiccaṃ ubhayañ ca kāriyaṃ ",
  "vv80:7.2": "icc ev' ahaṃ bhante tadā vicintayiṃ ",
  "vv80:7.3": "tato ca saññaṃ paṭiladdha yoniso ",
  "vv80:7.4": "dadāmi bhante ti khipiṃ anantakaṃ. [=80].8 ",
  "vv80:8.1": "So māsakhettaṃ turito avāsariṃ ",
  "vv80:8.2": "purā ayaṃ bhañjati yass' idaṃ dhanaṃ ",
  "vv80:8.3": "tato ca kaṇho urago mahāviso ",
  "vv80:8.4": "adaṃsi pāde turitassa me sato. [=80].9 ",
  "vv80:9.1": "Svāhaṃ aṭṭo 'mhi dukkhena pīḷito ",
  "vv80:9.2": "bhikkhu ca taṃ sāmaṃ muñcitvā nantakaṃ ",
  "vv80:9.3": "ahāsi kummāsaṃ mamānukampayā ",
  "vv80:9.4": "tato cuto kālakato 'mhi devatā. [=80].10 ",
  "vv80:10.1": "Tad eva kammaṃ kusalaṃ kataṃ mayā ",
  "vv80:10.2": "sukhañ ca kammaṃ anubhomi attanā ",
  "vv80:10.3": "tayā hi bhante anukampito bhusaṃ ",
  "vv80:10.4": "kataññutāya abhivādayāmi taṃ. [=80].11 ",
  "vv80:11.1": "Sadevake loke samārake ca ",
  "vv80:11.2": "añño muni natthi tayānukampako ",
  "vv80:11.3": "tayā hi bhante anukampito bhusaṃ ",
  "vv80:11.4": "kataññutāya abhivādayāmi taṃ. [=80].12 ",
  "vv80:12.1": "Imasmiṃ loke parasmiṃ vā pana ",
  "vv80:12.2": "añño muni natthi tayānukampako ",
  "vv80:12.3": "tayā hi bhante anukampito bhusaṃ ",
  "vv80:12.4": "kataññutāya abhivādayāmi taṃ. ",
  "vv80:13.1": "Gopālavimānaṃ [=81].1 "
}
