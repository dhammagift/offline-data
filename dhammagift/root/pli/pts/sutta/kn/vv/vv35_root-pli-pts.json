  "vv35:0.4": "",
  "vv35:1.1": "",
  "vv35:1.2": "surammaṃ ",
  "vv35:1.3": "vyamhaṃ sunimmitaṃ toraṇūpapannaṃ ",
  "vv35:1.4": "rucakupakiṇṇam idaṃ subhaṃ vimānaṃ. [=35].2 ",
  "vv35:2.1": "Bhāti ca dasa disā nabhe va suriyo ",
  "vv35:2.2": "sarade tamonudo sahassaraṃsī ",
  "vv35:2.3": "tathā tapati-m-idaṃ tava vimānaṃ ",
  "vv35:2.4": "jalam iva dhūmasikho nise nabhagge. [=35].3 ",
  "vv35:3.1": "Musatīva nayanaṃ sateratā va ",
  "vv35:3.2": "ākāse ṭhapitam idaṃ manuññaṃ ",
  "vv35:3.3": "vīṇāmurajasammatāḷaghuṭṭhaṃ ",
  "vv35:3.4": "iddhaṃ Indapuraṃ yathā tavedaṃ. [=35].4 ",
  "vv35:4.1": "Padumakumuduppalakuvalayaṃ ",
  "vv35:4.2": "yodhikabandhukanojakā ca santi ",
  "vv35:4.3": "sālakusumitapupphitā asokā ",
  "vv35:4.4": "vividhadumaggasugandhasevitam idaṃ. [=35].5 ",
  "vv35:5.1": "Saḷalalabujabhujakasaṃyuttā ",
  "vv35:5.2": "kusakasuphullitalatāvalambinīhi ",
  "vv35:5.3": "maṇijālasadisā yasassinī ",
  "vv35:5.4": "rammā pokkharaṇī upaṭṭhitā te. [=35].6 ",
  "vv35:6.1": "Udakaruhā ca ye 'tthi pupphajātā ",
  "vv35:6.2": "thalajā ye ca santi rukkhajātā ",
  "vv35:6.3": "mānusakā amānusakā ca dibbā ",
  "vv35:6.4": "sabbe tuyhaṃ nivesanamhi jātā. [=35].7 ",
  "vv35:7.1": "Kissa samadamass' ayaṃ vipāko ",
  "vv35:7.2": "kenāsi kammaphalen' idhūpapannā ",
  "vv35:7.3": "yathā ca te adhigatam idaṃ vimānaṃ ",
  "vv35:7.4": "tad anupadaṃ avacāsi 'lārapakhume ti. [=35].8 ",
  "vv35:8.1": "Yathā ca me adhigatam idaṃ vimānaṃ ",
  "vv35:8.2": "koñcamayūracakorasaṅghacaritaṃ ",
  "vv35:8.3": "dibbapilavahaṃsarājaciṇṇaṃ ",
  "vv35:8.4": "dijakāraṇḍavakokilābhinaditaṃ, [=35].9 ",
  "vv35:9.1": "Nānāsantānakapuppharukkhavividhā ",
  "vv35:9.2": "pāṭalijambuasokarukkhavantaṃ ",
  "vv35:9.3": "yathā ca me adhigatam idaṃ vimānaṃ ",
  "vv35:9.4": "tan te pavedissāmi suṇohi bhante. [=35].10 ",
  "vv35:10.1": "Magadhavarapuratthimena ",
  "vv35:10.2": "Nālakagāmo nāma atthi bhante ",
  "vv35:10.3": "tattha ahosiṃ pure suṇisā ",
  "vv35:10.4": "Sesavatī ti tattha jāniṃsu mamaṃ. [=35].11 ",
  "vv35:11.1": "Sāhaṃ apacitatthadhammakusalaṃ ",
  "vv35:11.2": "devamanussapūjitaṃ mahantaṃ ",
  "vv35:11.3": "Upatissaṃ nibbutaṃ appameyyaṃ ",
  "vv35:11.4": "muditamanā kusumehi abbhokiriṃ. [=35].12 ",
  "vv35:12.1": "Paramagatigatañ ca pūjayitvā ",
  "vv35:12.2": "antimadehadharaṃ isiṃ uḷāraṃ ",
  "vv35:12.3": "pahāya mānusakaṃ samussayaṃ ",
  "vv35:12.4": "Tidasagatā idha-m-āvasāmi ṭhānan ti. Sesavatī-vimānaṃ [=36].1 ",
  "vv35:13.1": ""
}
