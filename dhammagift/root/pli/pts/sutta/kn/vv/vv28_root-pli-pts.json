  "vv28:0.1": "",
  "vv28:0.2": "",
  "vv28:0.3": "",
  "vv28:0.4": "",
  "vv28:1.1": "Abhikkantena vaṇṇena ",
  "vv28:1.2": "yā tvaṃ tiṭṭhasi devate ",
  "vv28:1.3": "obhāsentī disā sabbā ",
  "vv28:1.4": "osadhī viya tārakā, [=28].2 ",
  "vv28:2.1": "Kena t' etādiso vaṇṇo ",
  "vv28:2.2": "kena te idha-m-ijjhati uppajjanti ca te bhogā ye keci manaso piyā. [=28].3 Pucchāmi taṃ devi mahanubhāve manussabhūtā kim akāsi puññaṃ kenāsi evaṃ jalitānubhāvā ",
  "vv28:2.3": "vaṇṇo ca te sabbadisā pabhāsatī ti. [=28].4 ",
  "vv28:3.1": "Sā devatā attamanā ",
  "vv28:3.2": "Moggallānena pucchitā pañhaṃ puṭṭhā viyākāsi ",
  "vv28:3.3": "yassa kammass' idaṃ phalaṃ: [=28].5 ",
  "vv28:4.1": "Ahaṃ manussesu manussabhūtā ",
  "vv28:4.2": "purimāya jātiyā manussaloke, ",
  "vv28:5.1": "addasaṃ virajaṃ bhikkhuṃ ",
  "vv28:5.2": "vippasannam anāvilaṃ. ",
  "vv28:5.3": "Tassa adās' ahaṃ bhikkhaṃ ",
  "vv28:5.4": "pasannā sehi pāṇihi. [=28].6 ",
  "vv28:6.1": "Tena m' etādiso vaṇṇo ",
  "vv28:6.2": "tena me idha-m-ijjhati uppajjanti ca me bhogā ye keci manaso piyā. [=28].7 Akkhāmi te bhikkhu mahānubhāva manussabhūtā yam ahaṃ akāsiṃ ten' amhi evaṃ jalitānubhāvā ",
  "vv28:6.3": "vaṇṇo ca me sabbadisā pabhāsatī ti. ",
  "vv28:7.1": "Dutiyabhikkhādāyikāvimānaṃ ",
  "vv28:8.1": "Tass' uddānaṃ: ",
  "vv28:9.1": "Dāsī c' eva Lakhumā ca ",
  "vv28:9.2": "atha ācāmadāyikā ",
  "vv28:9.3": "caṇḍālī bhadditthī c' eva ",
  "vv28:9.4": "Soṇadinnā Uposathā ",
  "vv28:9.5": "Niddā c' eva Suniddā ca ",
  "vv28:9.6": "dve ca bhikkhāya dāyikā; ",
  "vv28:9.7": "vaggo tena pavuccatī ",
  "vv28:10.1": "ti. [=29].1 ",
  "vv28:11.1": ""
}
