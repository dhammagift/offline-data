{
  "vv18:0.1": "",
  "vv18:0.2": "",
  "vv18:0.3": "",
  "vv18:0.4": "",
  "vv18:1.1": "Api Sakko va devindo ",
  "vv18:1.2": "ramme Cittalatāvane ",
  "vv18:1.3": "samantā anupariyāsi ",
  "vv18:1.4": "nārīgaṇapurakkhatā ",
  "vv18:1.5": "obhāsentī disā sabbā ",
  "vv18:1.6": "osadhī viya tārakā. [=18].2 ",
  "vv18:2.1": "Kena t' etādiso vaṇṇo ",
  "vv18:2.2": "kena te idha-m-ijjhati ",
  "vv18:2.3": "uppajjanti ca te bhogā ",
  "vv18:2.4": "ye keci manaso piyā. [=18].3 ",
  "vv18:3.1": "Pucchāmi taṃ devi mahānubhāve ",
  "vv18:3.2": "manussabhūtā kim akāsi puññaṃ ",
  "vv18:3.3": "kenāsi evaṃ jalitānubhāvā ",
  "vv18:3.4": "vaṇṇo ca te sabbadisā pabhāsatī ti. [=18].4 ",
  "vv18:4.1": "Sā devatā attamanā ",
  "vv18:4.2": "Moggallānena pucchitā ",
  "vv18:4.3": "pañhaṃ puṭṭhā viyākāsi ",
  "vv18:4.4": "yassa kammass' idaṃ phalaṃ: [=18].5 ",
  "vv18:5.1": "Ahaṃ manussesu manussabhūtā ",
  "vv18:5.2": "dāsī ahosiṃ parapessiyā kule. ",
  "vv18:6.1": "upāsikā cakkhumato ",
  "vv18:6.2": "Gotamassa yasassino. [=18].6 ",
  "vv18:6.3": "Tassā me nikkamo āsi ",
  "vv18:6.4": "sāsane tassa tādino: ",
  "vv18:7.1": "kāmaṃ bhijjatu 'yaṃ kāyo ",
  "vv18:7.2": "n' eva atth' ettha santhanaṃ. [=18].7 ",
  "vv18:7.3": "Sikkhāpadānaṃ pañcannaṃ ",
  "vv18:7.4": "maggo sovatthiko sivo ",
  "vv18:8.1": "akaṇṭako agahaṇo ",
  "vv18:8.2": "uju sabbhi pavedito. [=18].8 ",
  "vv18:8.3": "Nikkamassa phalaṃ passa ",
  "vv18:8.4": "yath' idaṃ pāpuṇ' itthikā ",
  "vv18:9.1": "āmantanikā rañño 'mhi ",
  "vv18:9.2": "Sakkassa vasavattino. [=18].9 ",
  "vv18:9.3": "Saṭṭhituriyasahassāni ",
  "vv18:9.4": "paṭibodhaṃ karonti me ",
  "vv18:10.1": "Ālambo Gaggaro Bhīmo ",
  "vv18:10.2": "Sādhuvādī ca Saṃsayo, [=18].10 ",
  "vv18:10.3": "Pokkharo ca Suphasso ca ",
  "vv18:10.4": "Vīṇāmokkhā ca nāriyo ",
  "vv18:11.1": "Nandā c' eva Sunandā ca ",
  "vv18:11.2": "Soṇadinnā Sucimhitā [=18].11 ",
  "vv18:11.3": "Alambusā Missakesī ca ",
  "vv18:11.4": "Puṇḍarīkāti dāruṇī ",
  "vv18:12.1": "Eṇiphassā Suphassā ca ",
  "vv18:12.2": "Subhaddā Muduvādinī. [=18].12 ",
  "vv18:12.3": "Etā c' aññā ca seyyāse ",
  "vv18:12.4": "accharānaṃ pabodhikā ",
  "vv18:13.1": "tā maṃ kālen' upāgantvā ",
  "vv18:13.2": "abhibhāsanti devatā: [=18].13 ",
  "vv18:13.3": "Handa naccāma gāyāma ",
  "vv18:13.4": "handa taṃ ramayāmase ",
  "vv18:14.1": "na-y-idaṃ akatapuññānaṃ ",
  "vv18:14.2": "katapuññānam ev' idaṃ. [=18].14 ",
  "vv18:14.3": "Asokaṃ Nandanaṃ rammaṃ ",
  "vv18:14.4": "Tidasānaṃ mahāvanaṃ ",
  "vv18:15.1": "sukhaṃ akatapuññānaṃ ",
  "vv18:15.2": "idha natthi parattha ca ",
  "vv18:15.3": "sukhañ ca katapuññānaṃ ",
  "vv18:15.4": "idha c' eva parattha ca. [=18].15 ",
  "vv18:16.1": "Tesaṃ sahavyakāmanaṃkattabbaṃ ",
  "vv18:16.2": "kusalaṃ bahuṃ ",
  "vv18:16.3": "katapuññā hi modanti ",
  "vv18:16.4": "sagge bhogasamaṅgino ti. ",
  "vv18:17.1": "Dāsivimānaṃ [=19].1 "
}
