  "vv17:0.1": "",
  "vv17:0.2": "",
  "vv17:0.3": "",
  "vv17:0.4": "",
  "vv17:1.1": "Idaṃ vimānaṃ ruciraṃ pabhassaraṃ ",
  "vv17:1.2": "veḷuriyatthambhaṃ satataṃ sunimmitaṃ ",
  "vv17:1.3": "sovaṇṇarukkhehi samantam otthataṃ ",
  "vv17:1.4": "ṭhānaṃ mamaṃ kammavipākasambhavaṃ. [=17].2 ",
  "vv17:2.1": "Tatr' ūpapannā purimaccharā imā ",
  "vv17:2.2": "sataṃ sahassāni sakena kammunā ",
  "vv17:2.3": "tuvaṃ si ajjhūpagatā yasassinī ",
  "vv17:2.4": "obhāsayaṃ tiṭṭhasi pubbadevatā. [=17].3 ",
  "vv17:3.1": "Sasī adhiggayha yathā virocati ",
  "vv17:3.2": "nakkhattarājā-r-iva tārakāgaṇaṃ ",
  "vv17:3.3": "tath' eva tvaṃ accharāsaṅgaṇaṃ imaṃ ",
  "vv17:3.4": "daddallamāmā yasasā virocasi. [=17].4 ",
  "vv17:4.1": "Kuto nu āgamma anomadassane ",
  "vv17:4.2": "upapannā tvaṃ bhavanaṃ mamaṃ idaṃ ",
  "vv17:4.3": "Brahmaṃ va devā Tidasā sa-h-Indakā ",
  "vv17:4.4": "sabbe na tappāmase dassanena tan ti. [=17].5 ",
  "vv17:5.1": "Yam etaṃ Sakka anupucchase mamaṃ: ",
  "vv17:5.2": "kuto cutā tvaṃ idha āgatā ti, ",
  "vv17:5.3": "Bārāṇasī nāma pur' atthi Kāsinaṃ ",
  "vv17:5.4": "tattha pure ahosiṃ Kesakārikā. [=17].6 ",
  "vv17:6.1": "Buddhe ca dhamme ca pasannamānasā ",
  "vv17:6.2": "saṅghe ca ekantagatā asaṃsayā ",
  "vv17:6.3": "akhaṇḍasikkhāpadā āgatapphalā ",
  "vv17:6.4": "sambodhidhamme niyatā anāmayā ti. [=17].7 ",
  "vv17:7.1": "Tan tyābhinandāmase svāgatañ ca te ",
  "vv17:7.2": "dhammena ca tvaṃ yasasā virocasi ",
  "vv17:7.3": "buddhe ca dhamme ca pasannamānase ",
  "vv17:7.4": "saṅghe ca ekantagate asaṃsaye ",
  "vv17:7.5": "akhaṇḍasikkhāpade āgatapphale ",
  "vv17:7.6": "sambodhidhamme niyate anāmaye ti. ",
  "vv17:8.1": "Kesakārīvimānaṃ ",
  "vv17:9.1": "Tass' uddānaṃ: ",
  "vv17:10.1": "Pañca pīṭhā, tayo nāvā, ",
  "vv17:10.2": "dīpatiladakkhiṇā, duve ",
  "vv17:10.3": "pati, dve suṇisā, Uttarā ",
  "vv17:10.4": "Sirimā Kesakārikā; ",
  "vv17:10.5": "vaggo tena pavuccatī ",
  "vv17:11.1": "ti. [=18].1 "
}
