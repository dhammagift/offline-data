  "vv12:0.4": "",
  "vv12:1.1": "ruciraṃ pabhassaraṃ ",
  "vv12:1.2": "vimānam āruyha anekacittaṃ ",
  "vv12:1.3": "tatth' acchasi devi mahānubhāve ",
  "vv12:1.4": "uccāvacā iddhi vikubbamānā. [=12].2 ",
  "vv12:1.5": "Imā ca te accharāyo samantato ",
  "vv12:1.6": "naccanti gāyanti ca pamodayanti [=12].3 ",
  "vv12:2.1": "Deviddhipattāsi mahānubhāve ",
  "vv12:2.2": "manussabhūtā kim akāsi puññaṃ ",
  "vv12:2.3": "kenāsi evaṃ jalitānubhāvā ",
  "vv12:2.4": "vaṇṇo ca te sabbadisā pabhāsatī ti. [=12].4 ",
  "vv12:3.1": "Sā devatā attamanā ",
  "vv12:3.2": "Moggallānena pucchitā ",
  "vv12:3.3": "pañhaṃ puṭṭhā viyākāsi ",
  "vv12:3.4": "yassa kammass' idaṃ phalaṃ: [=12].5 ",
  "vv12:4.1": "Ahaṃ manussesu manussabhūtā ",
  "vv12:4.2": "upāsikā cakkhumato ahosiṃ ",
  "vv12:4.3": "pāṇātipātā viratā ahosiṃ ",
  "vv12:4.4": "loke adinnaṃ parivajjayissaṃ. [=12].6 ",
  "vv12:5.1": "Amajjapā no ca musā abhāṇiṃ ",
  "vv12:5.2": "sakena sāminā ahosiṃ tuṭṭhā ",
  "vv12:5.3": "annañ ca pānañ ca pasannacittā ",
  "vv12:5.4": "sakkacca dānaṃ vipulaṃ adāsiṃ. [=12].7 ",
  "vv12:6.1": "Tena m' etādiso vaṇṇo ",
  "vv12:6.2": "tena me idha-m-ijjhati ",
  "vv12:6.3": "uppajjanti ca me bhogā ",
  "vv12:6.4": "ye keci manaso piyā. [=12].8 ",
  "vv12:7.1": "Akkhāmi te bhikkhu mahānubhāva ",
  "vv12:7.2": "manussabhūtā yam akāsi puññaṃ ",
  "vv12:7.3": "ten' amhi evaṃ jalitānubhāvā ",
  "vv12:7.4": "vaṇṇo ca me sabbadisā pabhāsatī ti. ",
  "vv12:8.1": "Dutiyapatibbatāvimānaṃ [=13].1 "
}
