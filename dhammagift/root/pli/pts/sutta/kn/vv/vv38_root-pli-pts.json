  "vv38:0.4": "",
  "vv38:1.1": "Pāricchattake koviḷāre ",
  "vv38:1.2": "ramaṇīye manorame ",
  "vv38:1.3": "dibbamālaṃ ganthamānā ",
  "vv38:1.4": "gāyantī sampamodasi. [=38].2 ",
  "vv38:2.1": "Tassā te naccamānāya ",
  "vv38:2.2": "aṅga-m-aṅgehi sabbaso ",
  "vv38:2.3": "dibbā saddā niccharanti ",
  "vv38:2.4": "savanīyā manoramā. [=38].3 ",
  "vv38:3.1": "Tassā te naccamānāya ",
  "vv38:3.2": "aṅga-m-aṅgehi sabbaso ",
  "vv38:3.3": "dibbā gandhā pavāyanti ",
  "vv38:3.4": "sucigandhā manoramā. [=38].4 ",
  "vv38:4.1": "Vivattamānā kāyena ",
  "vv38:4.2": "yā veṇīsu pilandhanā ",
  "vv38:4.3": "tesaṃ suyyati nigghaso ",
  "vv38:4.4": "turiye pañcaṅgike yathā. [=38].5 ",
  "vv38:5.1": "Vaṭamsakā vātadhutā ",
  "vv38:5.2": "vātena sampakampitā ",
  "vv38:5.3": "tesaṃ suyyati nigghoso ",
  "vv38:5.4": "turiye pañcaṅgike yathā. [=38].6 ",
  "vv38:6.1": "Yā pi te sirasmiṃ mālā ",
  "vv38:6.2": "sucigandhā manoramā ",
  "vv38:6.3": "vāti gandho disā sabbā ",
  "vv38:6.4": "rukkho mañjūsako yathā. [=38].7 ",
  "vv38:7.1": "Ghāyase taṃ sucigandhaṃ ",
  "vv38:7.2": "rūpaṃ passasi amānusaṃ ",
  "vv38:7.3": "devate pucchitācikkha ",
  "vv38:7.4": "kissa kammass' idaṃ phalan ti. [=38].8 ",
  "vv38:8.1": "Pabhassaraṃ accimantaṃ ",
  "vv38:8.2": "vaṇṇagandhena saṃyutaṃ ",
  "vv38:8.3": "asokapupphamālāhaṃ ",
  "vv38:8.4": "buddhassa upanāmayiṃ. [=38].9 ",
  "vv38:9.1": "Tāhaṃ kammaṃ karitvāna ",
  "vv38:9.2": "kusalaṃ buddhavaṇṇitaṃ ",
  "vv38:9.3": "apetasokā sukhitā ",
  "vv38:9.4": "sampamodām' anāmayā ti. ",
  "vv38:10.1": "Pāricchattakavimānaṃ ",
  "vv38:11.1": "Tass' uddānaṃ: ",
  "vv38:12.1": "Uḷāraṃ ucchu-pallaṅkaṃ ",
  "vv38:12.2": "Latā ca Guttilena ca ",
  "vv38:12.3": "daddalla-Sesavatī Mallī ",
  "vv38:12.4": "Visalakkhi Pāricchattako; ",
  "vv38:12.5": "vaggo tena pavuccatī ti. [=39].1 Mañjeṭṭhake ",
  "vv38:13.1": ""
}
