{
  "vv34:0.1": "",
  "vv34:0.2": "",
  "vv34:0.3": "",
  "vv34:0.4": "",
  "vv34:1.1": "Daddallamānā vaṇṇena ",
  "vv34:1.2": "yasasā ca yasassinī ",
  "vv34:1.3": "sabbe deve Tāvatiṃse ",
  "vv34:1.4": "vaṇṇena atirocasi. [=34].2 ",
  "vv34:2.1": "Dassanaṃ nābhijānāmi ",
  "vv34:2.2": "idaṃ paṭhamadassanaṃ ",
  "vv34:2.3": "kasmā kāyā nu āgamma ",
  "vv34:2.4": "nāmena bhāsase maman ti. [=34].3 ",
  "vv34:3.1": "Ahaṃ bhadde Subhaddāsiṃ ",
  "vv34:3.2": "pubbe mānusake bhave ",
  "vv34:3.3": "sahabhariyā ca te āsiṃ ",
  "vv34:3.4": "bhaginī ca kaniṭṭhikā. [=34].4 ",
  "vv34:4.1": "Sāhaṃ kāyassa bhedāya ",
  "vv34:4.2": "vippamuttā tato cutā ",
  "vv34:4.3": "Nimmānaratidevānaṃ ",
  "vv34:4.4": "upapannā sahavyatan ti. [=34].5 ",
  "vv34:5.1": "Pahūtakatakalyāṇā ",
  "vv34:5.2": "te deve yanti pāṇino ",
  "vv34:5.3": "yesaṃ tvaṃ kittayissasi ",
  "vv34:5.4": "Subhadde jātim attano. [=34].6 ",
  "vv34:6.1": "Kathaṃ tvaṃ kena vaṇṇena ",
  "vv34:6.2": "kena vā anusāsitā ",
  "vv34:6.3": "kīdisen' eva dānena ",
  "vv34:6.4": "subbatena yasassinī [=34].7 ",
  "vv34:7.1": "Yasaṃ etādisaṃ pattā ",
  "vv34:7.2": "visesaṃ vipulam ajjhatā ",
  "vv34:7.3": "devate pucchitācikkha ",
  "vv34:7.4": "kissa kammass' idaṃ phalan ti. [=34].8 ",
  "vv34:8.1": "Aṭṭh' eva piṇḍapātāni ",
  "vv34:8.2": "yaṃ dānaṃ adadaṃ pure ",
  "vv34:8.3": "dakkhiṇeyyassa saṅghassa ",
  "vv34:8.4": "pasannā sehi pāṇihi, [=34].9 ",
  "vv34:9.1": "Tena m' etādiso vaṇṇo ",
  "vv34:9.2": "tena me idha-m-ijjhati uppajjanti ca me bhogā ye keci manaso piyā. [=34].10 Akkhāmi te devi mahānubhāve manussabhūtā yam ahaṃ akāsiṃ ten' amhi evaṃ jalitānubhāvā ",
  "vv34:9.3": "vaṇṇo ca me sabbadisā pabhāsatī ti. [=34].11 ",
  "vv34:10.1": "Ahaṃ tayā bahutare bhikkhū ",
  "vv34:10.2": "saññate brahmacārino ",
  "vv34:10.3": "tappesiṃ annapānena ",
  "vv34:10.4": "pasannā sehi pāṇihi ",
  "vv34:11.1": "tayā bahutaraṃ datvā ",
  "vv34:11.2": "hīnakāyūpagā ahaṃ. [=34].12 ",
  "vv34:11.3": "Kathaṃ tvaṃ appataraṃ datvā ",
  "vv34:11.4": "visesaṃ vipulam ajjhagā ",
  "vv34:11.5": "devate pucchitācikkha ",
  "vv34:11.6": "kissa kammass' idaṃ phalan ti. [=34].13 ",
  "vv34:12.1": "Manobhāvaniyo bhikkhu ",
  "vv34:12.2": "sandiṭṭho me pure ahu ",
  "vv34:12.3": "tāhaṃ bhattena nimantesiṃ ",
  "vv34:12.4": "Revataṃ atta-naṭṭhamaṃ. [=34].14 ",
  "vv34:13.1": "So me atthapurekkhāro ",
  "vv34:13.2": "anukampāya Revato: ",
  "vv34:13.3": "saṅghe dehī ti maṃ voca ",
  "vv34:13.4": "tassāhaṃ vacanaṃ kariṃ. [=34].15 ",
  "vv34:14.1": "Sā dakkhiṇā saṅghagatā ",
  "vv34:14.2": "appameyye patiṭṭhitā, ",
  "vv34:14.3": "puggalesu tayā dinnaṃ ",
  "vv34:14.4": "na taṃ tava mahapphalan ti. [=34].16 ",
  "vv34:15.1": "Idān' evāhaṃ jānāmi ",
  "vv34:15.2": "saṅghe dinnaṃ mahapphalaṃ ",
  "vv34:15.3": "sāhaṃ gantvā manussattaṃ ",
  "vv34:15.4": "vadaññū vītamaccharā ",
  "vv34:15.5": "saṅghe dānāni dassāmi ",
  "vv34:15.6": "appamattā punappunan ti. [=34].17 ",
  "vv34:16.1": "Kā esā devatā bhadde ",
  "vv34:16.2": "tayā mantayate saha ",
  "vv34:16.3": "sabbe deve Tāvatiṃse ",
  "vv34:16.4": "vaṇṇena atirocatī ti. [=34].18 ",
  "vv34:17.1": "Manussabhūtā devinda ",
  "vv34:17.2": "pubbe mānusake bhave ",
  "vv34:17.3": "sahabhariyā ca me āsi ",
  "vv34:17.4": "bhaginī ca kaniṭṭhikā ",
  "vv34:17.5": "saṅghe dānāni datvāna ",
  "vv34:17.6": "katapuññā virocatī ti. [=34].19 ",
  "vv34:18.1": "Dhammena pubbe bhaginī ",
  "vv34:18.2": "tayā bhadde virocati ",
  "vv34:18.3": "yaṃ saṅghamhi appameyye ",
  "vv34:18.4": "patiṭṭhāpesi dakkhiṇaṃ. [=34].20 ",
  "vv34:19.1": "Pucchito hi mayā buddho ",
  "vv34:19.2": "Gijjhakūṭamhi pabbate ",
  "vv34:19.3": "vipākaṃ saṃvibhāgassa ",
  "vv34:19.4": "yattha dinnaṃ mahapphalaṃ. [=34].21 ",
  "vv34:20.1": "Yajamānānaṃ manussānaṃ ",
  "vv34:20.2": "puññapekkhāna pāṇinaṃ ",
  "vv34:20.3": "karotaṃ opadhikaṃ puññaṃ ",
  "vv34:20.4": "yattha dinnaṃ mahapphalaṃ, [=34].22 ",
  "vv34:21.1": "Taṃ me buddho viyākāsi ",
  "vv34:21.2": "jānaṃ kammaphalaṃ sakaṃ ",
  "vv34:21.3": "vipākaṃ saṃvibhāgassa ",
  "vv34:21.4": "yattha dinnaṃ mahapphalaṃ. [=34].23 ",
  "vv34:22.1": "Cattāro ca paṭipannā ",
  "vv34:22.2": "cattāro ca phale ṭhitā ",
  "vv34:22.3": "esa saṅgho ujubhūto ",
  "vv34:22.4": "paññāsīlasamāhito. [=34].24 ",
  "vv34:23.1": "Yajamānānaṃ manussānaṃ ",
  "vv34:23.2": "puññapekkhāna pāṇinaṃ ",
  "vv34:23.3": "karotaṃ opadhikaṃ puññaṃ ",
  "vv34:23.4": "saṅghe dinnaṃ mahapphalaṃ. [=34].25 ",
  "vv34:24.1": "Eso hi saṅgho vipulo mahaggato ",
  "vv34:24.2": "es' appameyyo udadhīva sāgaro ",
  "vv34:24.3": "ete hi seṭṭhā naravīrasāvakā ",
  "vv34:24.4": "pabhaṅkarā dhammam udīrayanti. [=34].26 ",
  "vv34:25.1": "Tesaṃ sudinnaṃ suhutaṃ suyiṭṭhaṃ ",
  "vv34:25.2": "ye saṅgham uddissa dadanti dānaṃ ",
  "vv34:25.3": "sā dakkhiṇā saṅghagatā patiṭṭhitā ",
  "vv34:25.4": "mahapphalā lokavidūna vaṇṇitā. [=34].27 ",
  "vv34:26.1": "Etādisaṃ yaññam anussarantā ",
  "vv34:26.2": "ye vedajātā vicaranti loke ",
  "vv34:26.3": "vineyya maccheramalaṃ samūlaṃ ",
  "vv34:26.4": "aninditā saggam upenti ṭhānan ti. ",
  "vv34:27.1": "Daddallavimānaṃ [=35].1 Phaḷikarajatahemajālacchannaṃ vividhavicitratalam addasaṃ "
}
