  "vv77:0.4": "",
  "vv77:1.1": "maṇithūṇaṃ vimānaṃ ",
  "vv77:1.2": "samantato dvādasa yojanāni ",
  "vv77:1.3": "kūṭāgārā sattasatā uḷārā ",
  "vv77:1.4": "veḷuriyatthambhā rucakatthatā subhā. [=77].2 ",
  "vv77:2.1": "Tatth' acchasi pivasi khādasī ca ",
  "vv77:2.2": "dibbā ca vīṇā pavadanti vaggū ",
  "vv77:2.3": "dibbā rasā kāmaguṇ' ettha pañca ",
  "vv77:2.4": "nāriyo ca naccanti suvaṇṇachannā. [=77].3 ",
  "vv77:3.1": "Kena t' etādiso vaṇṇo ",
  "vv77:3.2": "kena te idha-m-ijjhati uppajjanti ca te bhogā ye keci manaso piyā. [=77].4 Pucchāmi taṃ deva mahānubhāva manussabhūto kim akāsi puññaṃ kenāsi evaṃ jalitānubhāvo ",
  "vv77:3.3": "vaṇṇo ca te sabbadisā pabhāsatī ti. [=77].5 ",
  "vv77:4.1": "So devaputto attamano ",
  "vv77:4.2": "Moggallānena pucchito pañhaṃ puṭṭho viyākāsi ",
  "vv77:4.3": "yassa kammass' idaṃ phalaṃ. [=77].6 ",
  "vv77:5.1": "Ahaṃ manussesu manussabhūto ",
  "vv77:5.2": "vivane pathe saṅkamanaṃ akāsiṃ ",
  "vv77:5.3": "ārāmarukkhāni ca ropayissaṃ ",
  "vv77:5.4": "piyā ca me sīlavanto ahesuṃ ",
  "vv77:5.5": "annañ ca pānañ ca pasannacitto ",
  "vv77:5.6": "sakkacca dānaṃ vipulaṃ adāsiṃ. [=77].7 ",
  "vv77:6.1": "Tena m' etādiso vaṇṇo ",
  "vv77:6.2": "tena me idha-m-ijjhati uppajjanti ca me bhogā ye keci manaso piyā. [=77].8 Akkhāmi te bhikkhu mahānubhāva manussabhūto yam akāsi puññaṃ ten' amhi evaṃ jalitānubhāvo ",
  "vv77:6.3": "vaṇṇo ca me sabbadisā pabhāsatī ti. ",
  "vv77:7.1": "Maṇithūṇavimānaṃ [=78].1 "
}
