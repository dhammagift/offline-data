  "vv16:0.1": "",
  "vv16:0.2": "",
  "vv16:0.3": "",
  "vv16:0.4": "",
  "vv16:1.1": "Yuttā ca te parama-alaṅkatā hayā ",
  "vv16:1.2": "adhomukhā aghasigamā balī javā ",
  "vv16:1.3": "abhinimmitā pañcarathāsatā ca te ",
  "vv16:1.4": "anventi taṃ sārathicoditā hayā. [=16].2 ",
  "vv16:2.1": "Sā tiṭṭhasi rathavare alaṅkatā ",
  "vv16:2.2": "obhāsayaṃ jalam iva jotipāvako ",
  "vv16:2.3": "pucchāmi taṃ varatanu anomadassane ",
  "vv16:2.4": "kasmā nu kāyā anadhivaraṃ upāgamī ",
  "vv16:3.1": "ti. [=16].3 Kāmaggappattānaṃ yam āhu anuttaraṃ ",
  "vv16:3.2": "nimmāya nimmāya ramanti devatā ",
  "vv16:3.3": "tasmā kāyā accharā kāmavaṇṇinī ",
  "vv16:3.4": "idhāgatā anadhivaraṃ namassituṃ. [=16].4 ",
  "vv16:4.1": "Kiṃ tvaṃ pure sucaritam ācarīdha ",
  "vv16:4.2": "ken' acchasi tvaṃ amitayasā sukhedhitā ",
  "vv16:4.3": "iddhī ca te anadhivarā vihaṅgamā ",
  "vv16:4.4": "vaṇṇo ca te dasadisā virocati. [=16].5 ",
  "vv16:5.1": "Devehi tvaṃ parivutā sakkatā c' asi ",
  "vv16:5.2": "kuto cutā sugatigatāsi devate ",
  "vv16:5.3": "kassa vā tvaṃ vacanakarānusāsaniṃ ",
  "vv16:5.4": "ācikkha me tvaṃ yadi buddhasāvikā ti. [=16].6 ",
  "vv16:6.1": "Nagantare nagaravare sumāpite ",
  "vv16:6.2": "paricārikā rājavarassa sirīmato ",
  "vv16:6.3": "nacce gīte paramasusikkhitā ahuṃ ",
  "vv16:6.4": "Sirimā ti maṃ Rājagahe avediṃsu. [=16].7 ",
  "vv16:7.1": "Buddho ca me isinisabho vināyako ",
  "vv16:7.2": "adesayī samudayadukkhaniccataṃ ",
  "vv16:7.3": "asaṅkhataṃ dukkhanirodhasassataṃ ",
  "vv16:7.4": "maggañ c' imam akuṭilam añjasaṃ sivaṃ. [=16].8 ",
  "vv16:8.1": "Sutvān' ahaṃ amatapadam asaṅkhataṃ ",
  "vv16:8.2": "tathāgatass' anadhivarassa sāsanaṃ ",
  "vv16:8.3": "sīlesv' ahaṃ paramasusaṃvutā ahuṃ ",
  "vv16:8.4": "dhamme ṭhitā naravarabuddhadesite. [=16].9 ",
  "vv16:9.1": "Ñatvān' ahaṃ virajapadaṃ asaṅkhataṃ ",
  "vv16:9.2": "tathāgaten' anadhivarena desitaṃ ",
  "vv16:9.3": "tatth' ev' ahaṃ samathasamādhim āphusiṃ ",
  "vv16:9.4": "sā yeva me paramaniyāmatā ahu. [=16].10 ",
  "vv16:10.1": "Laddhān' ahaṃ amatavaraṃ visesanaṃ ",
  "vv16:10.2": "ekaṃsikā abhisamaye visesiya ",
  "vv16:10.3": "asaṃsayā bahujanapūjitā ahaṃ ",
  "vv16:10.4": "khiḍḍāratiṃ paccanubhom' anappakaṃ. [=16].11 ",
  "vv16:11.1": "Evaṃ ahaṃ amatadas' amhi devatā ",
  "vv16:11.2": "tathāgatass' anadhivarassa sāvikā ",
  "vv16:11.3": "dhammaddasā paṭhamaphale patiṭṭhitā ",
  "vv16:11.4": "sotāpannā na ca pana m' atthi duggati. [=16].12 ",
  "vv16:12.1": "Sā vandituṃ anadhivaraṃ upāgamiṃ ",
  "vv16:12.2": "pāsādike kusalarate ca bhikkhavo ",
  "vv16:12.3": "namassituṃ samaṇasamāgamaṃ sivaṃ ",
  "vv16:12.4": "sagāravā sirimato dhammarājino. [=16].13 ",
  "vv16:13.1": "Disvā muniṃ muditaman' amhi pīṇitā ",
  "vv16:13.2": "tathāgataṃ naravaradammasārathiṃ ",
  "vv16:13.3": "taṇhacchidaṃ kusalarataṃ vināyakaṃ ",
  "vv16:13.4": "vandām' ahaṃ paramahitānukampakan ti. ",
  "vv16:14.1": "Sirimāvimānaṃ [=17].1 "
}
