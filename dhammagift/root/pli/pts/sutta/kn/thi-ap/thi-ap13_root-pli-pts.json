  "thi-ap13:1.1": "",
  "thi-ap13:1.2": "kumbhadāsī ahos' ahaṃ / ",
  "thi-ap13:1.3": "mama bhāgaṃ gahetvāna ",
  "thi-ap13:1.4": "gacchiṃ udakabhārikā. // // ",
  "thi-ap13:2.1": "Panthamhisamaṇaṃ disvā ",
  "thi-ap13:2.2": "santacittaṃ samāhitaṃ / ",
  "thi-ap13:2.3": "pasannacittā sumanā ",
  "thi-ap13:2.4": "modake tīṇi dās' ahaṃ. // // ",
  "thi-ap13:3.1": "Tenakammena sukatena ",
  "thi-ap13:3.2": "cetanāpaṇidhīhi ca / ",
  "thi-ap13:3.3": "ekanavuti-kappāni ",
  "thi-ap13:3.4": "vinipātaṃ n' agacch' ahaṃ. // // ",
  "thi-ap13:4.1": "Sampattiṃtaṃ karitvāna ",
  "thi-ap13:4.2": "sabbaṃ anubhaviṃ ahaṃ / ",
  "thi-ap13:4.3": "modake tīṇi datvāna ",
  "thi-ap13:4.4": "pattā 'haṃ acalaṃ padaṃ. // // ",
  "thi-ap13:5.1": "Kilesā. . . ",
  "thi-ap13:5.2": "pe . . . ",
  "thi-ap13:5.3": "",
  "thi-ap13:6.1": "",
  "thi-ap13:6.2": "pe . . . ",
  "thi-ap13:6.3": "pe . . . // // Sāgataṃ. . . pe . . . pe . . . pe . . . // // ",
  "thi-ap13:7.1": "Paṭisambhidā. . . ",
  "thi-ap13:7.2": "pe . . . ",
  "thi-ap13:7.3": "pe . . . pe . . . // // ",
  "thi-ap13:8.1": "Itthaṃ sudaṃ āyasmā Timodakadāyikā bhikkhunī i. g. a-ti. Modakadāyikāya theriyā apadānaṃ samattaṃ. ",
  "thi-ap13:9.1": ""
}
