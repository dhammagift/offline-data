{
  "thi-ap23:0.1": "",
  "thi-ap23:0.2": "",
  "thi-ap23:0.3": "",
  "thi-ap23:1.1": "Padumuttaro nāma jino ",
  "thi-ap23:1.2": "sabbadhammāna pāragū / ",
  "thi-ap23:1.3": "ito satasahassamhi ",
  "thi-ap23:1.4": "kappe uppajji nāyako. // // ",
  "thi-ap23:2.1": "Tadā 'haṃ Haṃsavatiyaṃ ",
  "thi-ap23:2.2": "kule aññatare ahuṃ / ",
  "thi-ap23:2.3": "parakammakarī āsiṃ ",
  "thi-ap23:2.4": "nipakā sīlasaṃvutā. // // ",
  "thi-ap23:3.1": "Padumuttarabuddhassa ",
  "thi-ap23:3.2": "*Su*jāto aggasāvako / ",
  "thi-ap23:3.3": "vihārā abhinikkhamma ",
  "thi-ap23:3.4": "piṇḍapātāya gacchati. // // ",
  "thi-ap23:4.1": "Ghaṭaṃ gahetvā gacchantī ",
  "thi-ap23:4.2": "tadā udakahārikā / ",
  "thi-ap23:4.3": "taṃ disvā adadaṃ sūpaṃ ",
  "thi-ap23:4.4": "pasannā sehi pāṇihi. // // ",
  "thi-ap23:5.1": "Paṭiggahetvā tatth' eva ",
  "thi-ap23:5.2": "nisinno paribhuñji so / ",
  "thi-ap23:5.3": "tato netvāna taṃ gehaṃ ",
  "thi-ap23:5.4": "adāsiṃ tassa bhojanaṃ. // // ",
  "thi-ap23:6.1": "Tato me ayyako tuṭṭho ",
  "thi-ap23:6.2": "akari suṇisaṃ sakaṃ / ",
  "thi-ap23:6.3": "sassuyā sahagantvāna ",
  "thi-ap23:6.4": "sambuddhaṃ abhivādayiṃ. // // ",
  "thi-ap23:7.1": "Tadā so dhammakathikaṃ ",
  "thi-ap23:7.2": "bhikkhuniṃ parikittayaṃ / ",
  "thi-ap23:7.3": "ṭhapesi etadaggamhi; ",
  "thi-ap23:7.4": "taṃ sutvā muditā ahaṃ. // // ",
  "thi-ap23:8.1": "Nimantetvāna sugataṃ ",
  "thi-ap23:8.2": "sasaṅghaṃ lokanāyakaṃ / ",
  "thi-ap23:8.3": "mahādānaṃ daditvāna ",
  "thi-ap23:8.4": "taṃ ṭhānaṃ abhipatthayiṃ. // // ",
  "thi-ap23:9.1": "Tato maṃ sugato āha ",
  "thi-ap23:9.2": "ghananinnādasussaro: / ",
  "thi-ap23:9.3": "\"mamupaṭṭhānanirate ",
  "thi-ap23:9.4": "sasaṅghaparivesike // // ",
  "thi-ap23:10.1": "Saddhammasavane yutte ",
  "thi-ap23:10.2": "guṇāgacchitamānase / ",
  "thi-ap23:10.3": "bhadde bhavassu muditā, ",
  "thi-ap23:10.4": "lacchase panidhīphalaṃ. // // ",
  "thi-ap23:11.1": "Satasahasse ito kappe ",
  "thi-ap23:11.2": "Okkākulasambhavo / ",
  "thi-ap23:11.3": "Gotamo nāma nāmena ",
  "thi-ap23:11.4": "satthā loke bhavissati. // // ",
  "thi-ap23:12.1": "Tassa *dha*mmesu dāyādā ",
  "thi-ap23:12.2": "orasā dhammanimmitā / ",
  "thi-ap23:12.3": "Dhammadinnā ti nāmena ",
  "thi-ap23:12.4": "hessati satthu sāvikā\". // // ",
  "thi-ap23:13.1": "Taṃ sutvā muditā hutvā ",
  "thi-ap23:13.2": "yāvajīvaṃ mahāmuniṃ / ",
  "thi-ap23:13.3": "mettacittā paricariṃ ",
  "thi-ap23:13.4": "paccayehi vināyakaṃ. // // ",
  "thi-ap23:14.1": "Tena kammena sukatena ",
  "thi-ap23:14.2": "cetanāpaṇidhīhi ca / ",
  "thi-ap23:14.3": "jahitvā mānusaṃ dehaṃ ",
  "thi-ap23:14.4": "Tāvatiṃsaṃ agacch' ahaṃ. // // ",
  "thi-ap23:15.1": "Imamhi bhaddake kappe ",
  "thi-ap23:15.2": "brahmabandhu mahāyaso / ",
  "thi-ap23:15.3": "Kassapo nāma nāmena ",
  "thi-ap23:15.4": "uppajji vadataṃ varo. // // ",
  "thi-ap23:16.1": "Upaṭṭhāko mahesissa ",
  "thi-ap23:16.2": "tadā āsi narissaro / ",
  "thi-ap23:16.3": "Kāsirājā Kikī nāma ",
  "thi-ap23:16.4": "Bārāṇasi-puruttame. // // ",
  "thi-ap23:17.1": "Chaṭṭhā tass' ās' ahaṃ dhītā ",
  "thi-ap23:17.2": "Sudhammā iti vissutā / ",
  "thi-ap23:17.3": "dhammaṃ sutvā jinaggassa ",
  "thi-ap23:17.4": "pabbajjaṃ samarocayiṃ. // // ",
  "thi-ap23:18.1": "Anujāni na no tāto ",
  "thi-ap23:18.2": "agāre va tadā mayaṃ / ",
  "thi-ap23:18.3": "vīsaṃ vassasahassāni ",
  "thi-ap23:18.4": "vicarimhā atanditā. // // ",
  "thi-ap23:19.1": "Komārabrahmacariyaṃ ",
  "thi-ap23:20.1": "",
  "thi-ap23:20.2": "rājakaññā sukheṭhitā / ",
  "thi-ap23:20.3": "Buddhopaṭṭhānaniratā ",
  "thi-ap23:20.4": "muditā satta dhītaro. // // ",
  "thi-ap23:21.1": "Samaṇī Samanaguttā ca ",
  "thi-ap23:21.2": "Bhikkhunī Bhikkhadāyikā / ",
  "thi-ap23:21.3": "Dhammā c' eva Sudhammā ca ",
  "thi-ap23:21.4": "sattamī Saṅghadāyikā. // // ",
  "thi-ap23:22.1": "Khemā Uppalavaṇṇā ca ",
  "thi-ap23:22.2": "Paṭācārā ca Kuṇḍalā / ",
  "thi-ap23:22.3": "Gotamī ca ahaṃ c' eva ",
  "thi-ap23:22.4": "Visākhā hoti sattamī. // // ",
  "thi-ap23:23.1": "Tehi kammehi sukatehi ",
  "thi-ap23:23.2": "cetanāpaṇidhīhi ca / ",
  "thi-ap23:23.3": "jahitvā mānusaṃ dehaṃ ",
  "thi-ap23:23.4": "Tāvatiṃsaṃ agacch' ahaṃ // // ",
  "thi-ap23:24.1": "Pacchime ca bhave dāni ",
  "thi-ap23:24.2": "Giribbajapuruttame / ",
  "thi-ap23:24.3": "jātā seṭṭhikule phīte ",
  "thi-ap23:24.4": "sabbakāmasamiddhine. // // ",
  "thi-ap23:25.1": "Yadā rūpaguṇ' ūpetā ",
  "thi-ap23:25.2": "paṭhame yobbane ṭhitā / ",
  "thi-ap23:25.3": "tadā parakulaṃ gantvā ",
  "thi-ap23:25.4": "vasiṃ sukhasamappitā. // // ",
  "thi-ap23:26.1": "Upetvā lokasaraṇaṃ ",
  "thi-ap23:26.2": "suṇitvā dhammadesanaṃ / ",
  "thi-ap23:26.3": "anāgāmiphalaṃ patto ",
  "thi-ap23:26.4": "sāmiko me subuddhimā. // // ",
  "thi-ap23:27.1": "Tadā 'haṃ anujānetvā ",
  "thi-ap23:27.2": "pabbajiṃ anagāriyaṃ / ",
  "thi-ap23:27.3": "naciren' eva kālena ",
  "thi-ap23:27.4": "arahattaṃ apāpuṇiṃ. // // ",
  "thi-ap23:28.1": "Tadā upāsako so maṃ ",
  "thi-ap23:28.2": "upagantvā apucchatha / ",
  "thi-ap23:28.3": "gambhīre nipuṇe pañhe; ",
  "thi-ap23:28.4": "*te*sabbe vyākariṃ ahaṃ. // // ",
  "thi-ap23:29.1": "Jino tasmiṃ guṇe tuṭṭho ",
  "thi-ap23:29.2": "etadagge ṭhapesi maṃ / ",
  "thi-ap23:29.3": "bhikkhuniṃ dhammakathikaṃ; ",
  "thi-ap23:29.4": "n' āññaṃ passāmi edisaṃ // // ",
  "thi-ap23:30.1": "Dhammadinnā yathā dhīrā, ",
  "thi-ap23:30.2": "evaṃ dhāretha bhikkhavo. / ",
  "thi-ap23:30.3": "evāhaṃ paṇḍitā homi ",
  "thi-ap23:30.4": "nāyaken' ānukampitā. // // ",
  "thi-ap23:31.1": "Pariciṇṇo mayā satthā ",
  "thi-ap23:31.2": "kataṃ Buddhassa sāsanaṃ / ",
  "thi-ap23:31.3": "ohito garuko bhāro ",
  "thi-ap23:31.4": "bhavanetti samūhatā. // // ",
  "thi-ap23:32.1": "Yassa c' atthāya pabbajitā ",
  "thi-ap23:32.2": "agārasmā 'nagāriyaṃ / ",
  "thi-ap23:32.3": "so me attho anuppatto ",
  "thi-ap23:32.4": "sabbasaṃyojanakkhayo. // // ",
  "thi-ap23:33.1": "Iddhīsu ca vasī homi ",
  "thi-ap23:33.2": "dibbāya sotadhātuyā / ",
  "thi-ap23:33.3": "paracittāni jānāmi ",
  "thi-ap23:33.4": "satthu sāsanakārikā. // // ",
  "thi-ap23:34.1": "Pubbenivāsaṃ jānāmi ",
  "thi-ap23:34.2": "dibbacakkhuṃ visodhitaṃ / ",
  "thi-ap23:34.3": "khepetvā āsave sabbe ",
  "thi-ap23:34.4": "visuddh' āsiṃ sunimmalā. // // ",
  "thi-ap23:35.1": "Kilesā . . . ",
  "thi-ap23:35.2": "pe . . . ",
  "thi-ap23:35.3": "",
  "thi-ap23:36.1": "",
  "thi-ap23:36.2": "pe . . . ",
  "thi-ap23:36.3": "pe . . . // // Sāgataṃ . . . pe . . . pe . . . pe . . . // // ",
  "thi-ap23:37.1": "Paṭisambhidā . . . ",
  "thi-ap23:37.2": "pe . . . ",
  "thi-ap23:37.3": "pe . . . pe . . . // // ",
  "thi-ap23:38.1": "Itthaṃ sudaṃ Dhammadinnā bhikkhunī i. g. a-ti. Dhammadinnāya ",
  "thi-ap23:39.1": "theriyā apadānaṃ samattaṃ. "
}
