  "thi-ap40:1.1": "Imamhi bhaddake kappe ",
  "thi-ap40:1.2": "brahmabandhu mahāyaso / ",
  "thi-ap40:1.3": "Kassapo nāma nāmena ",
  "thi-ap40:1.4": "uppajji vadatam varo. // // ",
  "thi-ap40:2.1": "Sāvatthiyaṃ puravare ",
  "thi-ap40:2.2": "upāsakakule ahaṃ / ",
  "thi-ap40:2.3": "pasutā taṃ jinavaraṃ ",
  "thi-ap40:2.4": "disvā sutvā ca desanaṃ / ",
  "thi-ap40:3.1": "taṃ vīraṃ saraṇaṃ gantvā ",
  "thi-ap40:3.2": "sīlāni ca samādayiṃ. // // ",
  "thi-ap40:3.3": "Kadāci so mahāvīro ",
  "thi-ap40:3.4": "mahājanasamāgame / ",
  "thi-ap40:4.1": "attano abhisambodhiṃ ",
  "thi-ap40:4.2": "pakāsesi narāsabho / ",
  "thi-ap40:4.3": "ananussutadhammesu ",
  "thi-ap40:4.4": "pubbe dukkhādikesu ca. // // ",
  "thi-ap40:5.1": "Cakkhuñāṇañ ca paññā ca ",
  "thi-ap40:5.2": "vijjālokā ca āsi me / ",
  "thi-ap40:5.3": "taṃ sutvā uggahetvā ca ",
  "thi-ap40:5.4": "paripucchiñ ca bhikkhavo. // // ",
  "thi-ap40:6.1": "Tena kammena sukatena ",
  "thi-ap40:6.2": "cetanāpaṇidhīhi ca / ",
  "thi-ap40:6.3": "jahitvā mānusaṃ dehaṃ ",
  "thi-ap40:6.4": "Tāvatiṃsaṃ agacch' ahaṃ // // ",
  "thi-ap40:7.1": "Pacchime ca bhave dāni ",
  "thi-ap40:7.2": "jātā seṭṭhi-mahākule / ",
  "thi-ap40:7.3": "upecca Buddhasaddhammaṃ ",
  "thi-ap40:7.4": "*sutvā* saccupasaṃhitaṃ // // ",
  "thi-ap40:8.1": "Pabbajitvāciren' eva ",
  "thi-ap40:8.2": "saccatthāni vicintayaṃ / ",
  "thi-ap40:8.3": "khepetvā āsave sabbe ",
  "thi-ap40:8.4": "arahattaṃ apāpuṇiṃ. // // ",
  "thi-ap40:9.1": "Iddhīsu ca vasī homi ",
  "thi-ap40:9.2": "dibbāya sotadhātuyā / ",
  "thi-ap40:9.3": "cetopariyañāṇassa ",
  "thi-ap40:9.4": "vasī homi mahāmuṇe // // ",
  "thi-ap40:10.1": "Pubbenivāsaṃ jānāmi ",
  "thi-ap40:10.2": "dibbacakkhuṃ visodhitaṃ / ",
  "thi-ap40:10.3": "sabbāsavā parikkhīṇā ",
  "thi-ap40:10.4": "n' atthi dāni punabbhavo. // // ",
  "thi-ap40:11.1": "Atthadhammaniruttīsu ",
  "thi-ap40:11.2": "paṭibhāne tath' eva ca / ",
  "thi-ap40:11.3": "ñāṇaṃ me vipulaṃ suddhaṃ ",
  "thi-ap40:11.4": "Buddhaseṭṭhassa vāhasā. // // ",
  "thi-ap40:12.1": "Kilesā . . . pe . . . ",
  "thi-ap40:12.2": "pe . . . ",
  "thi-ap40:12.3": "pe . . . // // ",
  "thi-ap40:12.4": "Sāgataṃ . . . ",
  "thi-ap40:13.1": "pe . . . ",
  "thi-ap40:13.2": "pe . . . ",
  "thi-ap40:13.3": "pe . . . // // ",
  "thi-ap40:13.4": "",
  "thi-ap40:14.1": "Paṭisambhidā . . . pe . . . ",
  "thi-ap40:14.2": "pe . . . ",
  "thi-ap40:14.3": "",
  "thi-ap40:14.4": "pe . . . // // ",
  "thi-ap40:15.1": "Itthaṃ sudaṃ Selā bhikkhunī i. g. a-ti. Seḷā-bhikkhuniyā apadānaṃ samattaṃ. ",
  "thi-ap40:16.1": "",
  "thi-ap40:16.2": "",
  "thi-ap40:17.1": "Uddānaṃ: ",
  "thi-ap40:18.1": "Khattiyā brāhmaṇī c' eva ",
  "thi-ap40:18.2": "tathā Uppaladāyikā ",
  "thi-ap40:18.3": "Sigālamātā Sukkā ca ",
  "thi-ap40:18.4": "Abhirūpā Aḍḍhakāsikā gaṇikā c' eva ",
  "thi-ap40:19.1": "Puṇṇā ca Ambapālī ca ",
  "thi-ap40:19.2": "bhikkhunī ",
  "thi-ap40:19.3": "",
  "thi-ap40:19.4": "",
  "thi-ap40:20.1": "ti. ",
  "thi-ap40:21.1": "",
  "thi-ap40:21.2": "",
  "thi-ap40:21.3": "Niṭṭhitaṃ ",
  "thi-ap40:21.4": "",
  "thi-ap40:22.1": "",
  "thi-ap40:22.2": "",
  "thi-ap40:22.3": "Apadānaṃ. ",
  "thi-ap40:22.4": "",
  "thi-ap40:23.1": "",
  "thi-ap40:24.1": ""
}
