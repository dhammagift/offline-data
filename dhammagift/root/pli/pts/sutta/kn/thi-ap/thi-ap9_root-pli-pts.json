  "thi-ap9:0.3": "",
  "thi-ap9:1.1": "",
  "thi-ap9:1.2": "cārikī ās'ahan tadā / ",
  "thi-ap9:1.3": "ārāmena ca ārāmaṃ ",
  "thi-ap9:1.4": "carāmi kusalatthikā. // // ",
  "thi-ap9:2.1": "Kālapakkhamhidivase ",
  "thi-ap9:2.2": "addasaṃ bodhim uttamaṃ / ",
  "thi-ap9:2.3": "tattha cittaṃ pasādetvā ",
  "thi-ap9:2.4": "bodhimūle nisīd' ahaṃ. // // ",
  "thi-ap9:3.1": "Garucittaṃupaṭṭhetvā ",
  "thi-ap9:3.2": "sire katvāna āñjaliṃ / ",
  "thi-ap9:3.3": "somanassaṃ pavedetvā ",
  "thi-ap9:3.4": "evaṃ cintesi tāvade: // // ",
  "thi-ap9:4.1": "‘YadiBuddho amitaguṇo ",
  "thi-ap9:4.2": "asamappaṭipuggalo / ",
  "thi-ap9:4.3": "dassetu pāṭihīraṃ me ",
  "thi-ap9:4.4": "bodhi obhāsatu ayuṃ.' // // ",
  "thi-ap9:5.1": "Sahaāvajjite mayhaṃ ",
  "thi-ap9:5.2": "bodhi pajjali tāvade / ",
  "thi-ap9:5.3": "sabbasovaṇṇayā āsi ",
  "thi-ap9:5.4": "disā sabbā virocati. // // ",
  "thi-ap9:6.1": "Sattarattindivaṃtattha ",
  "thi-ap9:6.2": "bodhimūle nisīd' ahaṃ / ",
  "thi-ap9:6.3": "sattame divase patte ",
  "thi-ap9:6.4": "dīpapūjaṃ akās' ahaṃ. // // ",
  "thi-ap9:7.1": "Āsanaṃparivāretvā ",
  "thi-ap9:7.2": "pañcadīpāni pajjaluṃ / ",
  "thi-ap9:7.3": "yāva udeti suriyo ",
  "thi-ap9:7.4": "dīpā me pajjaluṃ tadā. // // ",
  "thi-ap9:8.1": "Tenakammena sukatena ",
  "thi-ap9:8.2": "cetanāpaṇidhīhi ca / ",
  "thi-ap9:8.3": "jahitvā mānusaṃ dehaṃ ",
  "thi-ap9:8.4": "Tāvatiṃsaṃ agacch' ahaṃ. // // ",
  "thi-ap9:9.1": "Tatthame sukataṃ vyamhaṃ ",
  "thi-ap9:9.2": "Pañcadīpīti vuccati / ",
  "thi-ap9:9.3": "satayojanam ubbiddhaṃ ",
  "thi-ap9:9.4": "saṭṭhiyojanavitthataṃ. // // ",
  "thi-ap9:10.1": "Asaṅkhiyānidīpāni ",
  "thi-ap9:10.2": "parivāre jalanti me / ",
  "thi-ap9:10.3": "yāvatā devabhavanaṃ ",
  "thi-ap9:10.4": "dīpālokena jotati. // // ",
  "thi-ap9:11.1": "Puratthābhimukhāṭhitā ",
  "thi-ap9:11.2": "yadi icchāmi passituṃ / ",
  "thi-ap9:11.3": "uddhaṃ adho ca tiriyañ ",
  "thi-ap9:11.4": "sabbaṃ passāmi cakkhunā. // // ",
  "thi-ap9:12.1": "Yāvatāabhikaṅkhāmi ",
  "thi-ap9:12.2": "dasuṃ sukatadukkate / ",
  "thi-ap9:12.3": "tattha āvaraṇaṃ n' atthi ",
  "thi-ap9:12.4": "rukkhesu pabbatesu vā. // // ",
  "thi-ap9:13.1": "Asītidevarājānaṃ ",
  "thi-ap9:13.2": "mahesittam akārayiṃ / ",
  "thi-ap9:13.3": "satānaṃ cakkavattīnaṃ ",
  "thi-ap9:13.4": "mahesittaṃ akārayiṃ. // // ",
  "thi-ap9:14.1": "Yaṃyaṃ yonūpapajjāmi ",
  "thi-ap9:14.2": "devattaṃ atha mānusaṃ / ",
  "thi-ap9:14.3": "dīpasatasahassāni ",
  "thi-ap9:14.4": "parivāre jalanti me. // // ",
  "thi-ap9:15.1": "Devalokācavitvāna ",
  "thi-ap9:15.2": "uppajja mātukucchiyaṃ / ",
  "thi-ap9:15.3": "mātukucchigatā santī ",
  "thi-ap9:15.4": "akkhi me na nimīlati. // // ",
  "thi-ap9:16.1": "",
  "thi-ap9:16.2": "Dīpasatasahassānipuññakammasamaṅginā / ",
  "thi-ap9:16.3": "sūtighare pajjalanti; ",
  "thi-ap9:16.4": "pañcadīpān' idaṃ phalaṃ. // // ",
  "thi-ap9:17.1": "Pacchimebhavasampatte ",
  "thi-ap9:17.2": "mānasaṃ vinivaṭṭayiṃ / ",
  "thi-ap9:17.3": "ajarāmaraṇaṃ sītibhāvaṃ ",
  "thi-ap9:17.4": "nibbānaṃ phassayiṃ ahaṃ. // // ",
  "thi-ap9:18.1": "Jātiyāsattavassā 'haṃ ",
  "thi-ap9:18.2": "arahattaṃ apāpuṇiṃ / ",
  "thi-ap9:18.3": "upasampādayī Buddho ",
  "thi-ap9:18.4": "guṇam aññāya Gotamo. // // ",
  "thi-ap9:19.1": "Maṇḍaperukkhamūle vā ",
  "thi-ap9:19.2": "pāsādesu guhāsu vā / ",
  "thi-ap9:19.3": "suññāgāre ca jhāyantā ",
  "thi-ap9:19.4": "pañcadipā jalanti me. // // ",
  "thi-ap9:20.1": "Dibbacakkhuṃvisuddhaṃ me ",
  "thi-ap9:20.2": "samādhikusalā ahaṃ / ",
  "thi-ap9:20.3": "abhiññāpāramiṃpattā: ",
  "thi-ap9:20.4": "pañca dīpān' idaṃ phalaṃ. // // ",
  "thi-ap9:21.1": "Sabbavositavosānākatakiccā ",
  "thi-ap9:21.2": "anāsavā / ",
  "thi-ap9:21.3": "Pa*ñcadīpā mahāvīra ",
  "thi-ap9:21.4": "pade vandāmi cakkhumā. // // ",
  "thi-ap9:22.1": "Satasahasseito kappe ",
  "thi-ap9:22.2": "yaṃ dīpam adadiṃ tadā / ",
  "thi-ap9:22.3": "duggatiṃ nābhijānāmi ",
  "thi-ap9:22.4": "pañcadīpān' idaṃ phalaṃ. // // ",
  "thi-ap9:23.1": "Kilesā. . . ",
  "thi-ap9:23.2": "pe . . . ",
  "thi-ap9:23.3": "",
  "thi-ap9:24.1": "",
  "thi-ap9:24.2": "pe . . . ",
  "thi-ap9:24.3": "pe . . . // // Sāgataṃ. . . pe . . . pe . . . pe . . . // // ",
  "thi-ap9:25.1": "Paṭisambhidā. . . ",
  "thi-ap9:25.2": "pe . . . ",
  "thi-ap9:25.3": "pe . . . pe . . . // // ",
  "thi-ap9:26.1": "Itthaṃ sudaṃ Pañcadīpikā bhikkhunī i. g. a-ti. Pañcadīpikāya theriyā apadānaṃ samattaṃ. ",
  "thi-ap9:27.1": "NagareBandhumatiyā āsiṃ udakabhārikā / udabhārena "
}
