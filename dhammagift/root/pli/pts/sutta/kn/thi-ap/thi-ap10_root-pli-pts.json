  "thi-ap10:1.1": "",
  "thi-ap10:1.2": "",
  "thi-ap10:1.3": "jīvāmi ",
  "thi-ap10:1.4": "tena posemi dārake. // // ",
  "thi-ap10:2.1": "Deyyadhammoca me n' atthi ",
  "thi-ap10:2.2": "puññakkhette anuttare / ",
  "thi-ap10:2.3": "koṭṭhakaṃ upasaṅkamma ",
  "thi-ap10:2.4": "udakaṃ paṭṭhapes' ahaṃ. // // ",
  "thi-ap10:3.1": "Tenakammena sukatena ",
  "thi-ap10:3.2": "Tāvatiṃsaṃ agacch' ahaṃ / ",
  "thi-ap10:3.3": "tattha me sukataṃ vyamhaṃ ",
  "thi-ap10:3.4": "udabhārena nimmitaṃ. // // ",
  "thi-ap10:4.1": "Accharānaṃsahassassa aham ",
  "thi-ap10:4.2": "pi pavarā tadā / ",
  "thi-ap10:4.3": "dasaṭṭhāne hitā sabbā ",
  "thi-ap10:4.4": "adhibhomi sadā ahaṃ. // // ",
  "thi-ap10:5.1": "Paññāsaṃdevarājānaṃ ",
  "thi-ap10:5.2": "mahesittam akārayiṃ / ",
  "thi-ap10:5.3": "vīsaticakkavattīnaṃ ",
  "thi-ap10:5.4": "mahesittam akārayiṃ. // // ",
  "thi-ap10:6.1": "Duvebhave saṃsarāmi ",
  "thi-ap10:6.2": "devatte atha mānuse / ",
  "thi-ap10:6.3": "duggatiṃ nābhijānāmi ",
  "thi-ap10:6.4": "udakadānass' idaṃ phalaṃ. // // ",
  "thi-ap10:7.1": "Pabbataggedumagge vā ",
  "thi-ap10:7.2": "antalikkhe ca bhūmiyā / ",
  "thi-ap10:7.3": "yadā udakam icchāmi ",
  "thi-ap10:7.4": "khippaṃ paṭilabhām' ahaṃ. // // ",
  "thi-ap10:8.1": "Avuṭṭhikādisā n' atthi ",
  "thi-ap10:8.2": "santatta-kaṭhitā na ca / ",
  "thi-ap10:8.3": "mama saṅkappam aññāya ",
  "thi-ap10:8.4": "mahāmegho pavassati. // // ",
  "thi-ap10:9.1": "Kadāciniyyamānāya ",
  "thi-ap10:9.2": "ñātisaṅghena me tadā / ",
  "thi-ap10:9.3": "yadā icchām' ahaṃ vassaṃ ",
  "thi-ap10:9.4": "mahāmegho ajāyati. // // ",
  "thi-ap10:10.1": "Uṇhaṃvā pariḷāho vā ",
  "thi-ap10:10.2": "atha m' eva na vijjati / ",
  "thi-ap10:10.3": "kāye ca me rajo n' atthi udakadānass' ",
  "thi-ap10:10.4": "idaṃ phalaṃ. // // ",
  "thi-ap10:11.1": "Visuddhamanasāajja ",
  "thi-ap10:11.2": "apetā manapāpikā / ",
  "thi-ap10:11.3": "sabbāsavā parikkhīṇā ",
  "thi-ap10:11.4": "n' atthi dāni punabbhavo. // // ",
  "thi-ap10:12.1": "Ekanavuteito kappe ",
  "thi-ap10:12.2": "yaṃ kammam akariṃ tadā / ",
  "thi-ap10:12.3": "duggatiṃ nābhijānāmi ",
  "thi-ap10:12.4": "udakadānass' idaṃ phalaṃ. // // ",
  "thi-ap10:13.1": "Kilesā. . . ",
  "thi-ap10:13.2": "pe . . . ",
  "thi-ap10:13.3": "",
  "thi-ap10:14.1": "",
  "thi-ap10:14.2": "pe . . . ",
  "thi-ap10:14.3": "pe . . . // // Sāgataṃ. . . pe . . . pe . . . pe . . . // // ",
  "thi-ap10:15.1": "Paṭisambhidā. . . ",
  "thi-ap10:15.2": "pe . . . ",
  "thi-ap10:15.3": "pe . . . pe . . . // // ",
  "thi-ap10:16.1": "Itthaṃ sudaṃ Udakadāyikā bhikkhunī i. g. a-ti. ",
  "thi-ap10:17.1": "Udakadāyikāya theriyā ",
  "thi-ap10:18.1": "apadānaṃ samattaṃ. ",
  "thi-ap10:19.1": "Uddānaṃ: ",
  "thi-ap10:20.1": "Sumedhā Mekhalādadā ",
  "thi-ap10:20.2": "Maṇḍapa-Saṅkamandadā ",
  "thi-ap10:20.3": "Nalamālī Piṇḍadadā ",
  "thi-ap10:20.4": "Kaṭacchu-Uppalappadā. ",
  "thi-ap10:21.1": "Dīpad-Odakadā c' eva ",
  "thi-ap10:21.2": "gāthāyo gaṇitā-vihā ekagāthā ",
  "thi-ap10:21.3": "satañ c' ",
  "thi-ap10:21.4": "eva sattādasa taduttariṃ. NagareBandhumatiyā "
}
