  "thi-ap16:0.3": "",
  "thi-ap16:1.1": "Candabhāgānadītīre ",
  "thi-ap16:1.2": "ahosiṃ kinnarī tadā / ",
  "thi-ap16:1.3": "addasaṃ virajaṃ Buddhaṃ ",
  "thi-ap16:1.4": "sayambhuṃ aparājitaṃ. // // ",
  "thi-ap16:2.1": "Pasannacittā sumanā ",
  "thi-ap16:2.2": "vedajātā katañjalī / ",
  "thi-ap16:2.3": "nalamālaṃ gahetvāna ",
  "thi-ap16:2.4": "sayambhuṃ abhipūjayiṃ. // // ",
  "thi-ap16:3.1": "Tena kammena sukatena ",
  "thi-ap16:3.2": "cetanāpaṇidhīhi ca / ",
  "thi-ap16:3.3": "jahitvā mānusaṃ dehaṃ ",
  "thi-ap16:3.4": "Tāvatiṃsaṃ agacch' ahaṃ. // // ",
  "thi-ap16:4.1": "Chattiṃsadevarājānaṃ ",
  "thi-ap16:4.2": "mahesittam akārayiṃ / ",
  "thi-ap16:4.3": "*manasā patthitaṃ mayhaṃ ",
  "thi-ap16:4.4": "nibbattati yath' icchitaṃ* // // ",
  "thi-ap16:5.1": "Dasannaṃ cakkavattīnaṃ ",
  "thi-ap16:5.2": "mahesittam akārayiṃ / *sucitattā ",
  "thi-ap16:5.3": "va hutvāna ",
  "thi-ap16:5.4": "saṃsarāmi bhavesv ahaṃ* // // ",
  "thi-ap16:6.1": "Kusalaṃ vijjate mayhaṃ ",
  "thi-ap16:6.2": "pabbajiṃ anagāriyaṃ / ",
  "thi-ap16:6.3": "pujārahā ahaṃ ajja ",
  "thi-ap16:6.4": "Sakyaputtassa sāsane. // // ",
  "thi-ap16:7.1": "*Visuddhamānasā ajja ",
  "thi-ap16:7.2": "apetamanapāpikā / ",
  "thi-ap16:7.3": "sabbāsavā parikkhīṇā ",
  "thi-ap16:7.4": "n' atthi dāni punabbhavo* // // ",
  "thi-ap16:8.1": "Kilesā . . . pe . . . pe . . . pe . . . // // Sāgataṃ . . . pe . . . pe . . . pe . . . // // Paṭisambhidā . . . pe . . . pe . . . pe . . . // // Catunavute ito kappe ",
  "thi-ap16:8.2": "yam Buddham abhipūjayiṃ / ",
  "thi-ap16:8.3": "duggatiṃ nābhijānāmi ",
  "thi-ap16:8.4": "nalamālān' idaṃ phalaṃ. // // ",
  "thi-ap16:9.1": "Kilesā . . . ",
  "thi-ap16:9.2": "pe . . . ",
  "thi-ap16:9.3": "",
  "thi-ap16:10.1": "",
  "thi-ap16:10.2": "pe . . . ",
  "thi-ap16:10.3": "",
  "thi-ap16:11.1": "",
  "thi-ap16:11.2": "pe . . . // // ",
  "thi-ap16:11.3": "sabbāsavā parikkhīṇā n' atthi dāni punabbhavo ti. ",
  "thi-ap16:12.1": "Itthaṃ sudaṃ Nalamālikā bhikkhunī i. g. a-ti. Nalamālikāya ",
  "thi-ap16:13.1": "theriyā apadānaṃ samattaṃ. "
}
