  "thi-ap6:1.1": "",
  "thi-ap6:1.2": "Bandhumā nāma khattiyo / ",
  "thi-ap6:1.3": "tassa rañño ahaṃ bhariyā ",
  "thi-ap6:1.4": "ekaccaṃ cārayām' aham // // ",
  "thi-ap6:2.1": "Rahogatānisīditvā ",
  "thi-ap6:2.2": "evaṃ cintes' ahan tadā: / ",
  "thi-ap6:2.3": "ādāya gamanīyaṃ hi ",
  "thi-ap6:2.4": "kusalaṃ n' atthi me kataṃ. // // ",
  "thi-ap6:3.1": "Mahābhitāpaṃdukkhaṃ ",
  "thi-ap6:3.2": "ghorarūpaṃ sudāruṇaṃ / ",
  "thi-ap6:3.3": "nirayaṃ nūna gacchāmi ",
  "thi-ap6:3.4": "ettha me n' atthi saṃsayo. // // ",
  "thi-ap6:4.1": "Rājānaṃupasaṅkamma ",
  "thi-ap6:4.2": "imaṃ vacanam abraviṃ: / ",
  "thi-ap6:4.3": "Ekaṃ me samaṇaṃ dehi ",
  "thi-ap6:4.4": "bhojayissāmi khattiya. // // ",
  "thi-ap6:5.1": "Adāsime mahārājā ",
  "thi-ap6:5.2": "samaṇaṃ bhāvitindriyaṃ / ",
  "thi-ap6:5.3": "tassa pattaṃ gahetvāna ",
  "thi-ap6:5.4": "paramannena tappayiṃ. // // ",
  "thi-ap6:6.1": "Pūrayitvāparamaṃ annaṃ ",
  "thi-ap6:6.2": "gandhālepaṃ akās' ahaṃ / ",
  "thi-ap6:6.3": "jālena pidahitvāna ",
  "thi-ap6:6.4": "mahānelena chādayiṃ. // // ",
  "thi-ap6:7.1": "Ārammaṇaṃmamaṃ etaṃ ",
  "thi-ap6:7.2": "sarāmi yāvajīvitaṃ / ",
  "thi-ap6:7.3": "tattha cittaṃ pasādetvā ",
  "thi-ap6:7.4": "Tāvatiṃsaṃ agacch' ahaṃ. // // ",
  "thi-ap6:8.1": "Tiṃsānaṃdivarājūnaṃ ",
  "thi-ap6:8.2": "mahesittam akārayiṃ / ",
  "thi-ap6:8.3": "manasā patthitaṃ mayhaṃ ",
  "thi-ap6:8.4": "nibbattati ",
  "thi-ap6:9.1": "yadicchakaṃ. // // Vīsānacakkavattīnaṃ ",
  "thi-ap6:9.2": "mahesittam akārayiṃ / ocitattā ",
  "thi-ap6:9.3": "ca hutvāna ",
  "thi-ap6:9.4": "saṃsarāmi bhavesv-ahaṃ. // // ",
  "thi-ap6:10.1": "Sabbabandhanamuttā'haṃ ",
  "thi-ap6:10.2": "apetā me upādikā / ",
  "thi-ap6:10.3": "sabbāsavā parikkhīṇā ",
  "thi-ap6:10.4": "n' atthi dāni punabbhavo. // // ",
  "thi-ap6:11.1": "Ekanavuteito kappe ",
  "thi-ap6:11.2": "yaṃ dānam adadiṃ tadā / ",
  "thi-ap6:11.3": "duggatiṃ nābhijānāmi ",
  "thi-ap6:11.4": "piṇḍapātass' idaṃ phalaṃ // // ",
  "thi-ap6:12.1": "Kilesā. . . ",
  "thi-ap6:12.2": "pe . . . ",
  "thi-ap6:12.3": "",
  "thi-ap6:13.1": "",
  "thi-ap6:13.2": "pe . . . ",
  "thi-ap6:13.3": "pe . . . // // Sāgataṃ. . . pe . . . pe . . . pe . . . // // ",
  "thi-ap6:14.1": "Paṭisambhidā. . . ",
  "thi-ap6:14.2": "pe . . . ",
  "thi-ap6:14.3": "pe . . . pe . . . // // ",
  "thi-ap6:15.1": "Itthaṃ sudaṃ Ekapiṇḍadāyikā bhikkhunī i. g. a-ti. Piṇḍadāyikāya theriyā apadānaṃ samattaṃ. Piṇḍacāraṃcarantassa ",
  "thi-ap6:16.1": ""
}
