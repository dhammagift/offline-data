  "thi-ap12:1.1": "",
  "thi-ap12:1.2": "kinnarī tadā / ",
  "thi-ap12:1.3": "ath' addasaṃ devadevaṃ ",
  "thi-ap12:1.4": "caṅkamantaṃ narāsabhaṃ. // // ",
  "thi-ap12:2.1": "Ocinitvānasalalaṃ ",
  "thi-ap12:2.2": "Buddhaseṭṭhass' adās' ahaṃ / ",
  "thi-ap12:2.3": "upasiṅghi mahāvīro ",
  "thi-ap12:2.4": "salalaṃ pupphagandhikaṃ. // // ",
  "thi-ap12:3.1": "Paṭiggahetvāsambuddho ",
  "thi-ap12:3.2": "Vipassī lokanāyako / ",
  "thi-ap12:3.3": "upasiṅghi mahāvīro ",
  "thi-ap12:3.4": "pekkhamānāya me tadā. // // ",
  "thi-ap12:4.1": "Añjalimpaggahetvāna ",
  "thi-ap12:4.2": "vanditvā dipaduttamaṃ / ",
  "thi-ap12:4.3": "sakaṃ cittaṃ pasādetvā ",
  "thi-ap12:4.4": "tato pabbatam āruhiṃ. // // ",
  "thi-ap12:5.1": "Ekanavuteito kappe ",
  "thi-ap12:5.2": "yaṃ pupphaṃ adadiṃ tadā / ",
  "thi-ap12:5.3": "duggatiṃ nābhijānāmi ",
  "thi-ap12:5.4": "Buddhapūjāy' idaṃ phalaṃ. // // ",
