{
  "thi-ap30:0.1": "",
  "thi-ap30:0.2": "",
  "thi-ap30:0.3": "",
  "thi-ap30:1.1": "Aṭṭhārasasahassāni ",
  "thi-ap30:1.2": "bhikkhunī Sakyasambhavā / ",
  "thi-ap30:1.3": "Yasodharī-pamukhāni ",
  "thi-ap30:1.4": "sambuddhaṃ upasaṅkamuṃ. // // ",
  "thi-ap30:2.1": "Yasodharīya-sahassāni ",
  "thi-ap30:2.2": "sabbā honti mahiddhikā / ",
  "thi-ap30:2.3": "vandanti munino pāde ",
  "thi-ap30:2.4": "ārocenti yathābalaṃ: // // ",
  "thi-ap30:3.1": "Jātikhīṇajarā vyādhi ",
  "thi-ap30:3.2": "maraṇañ ca mahāmuni / ",
  "thi-ap30:3.3": "anāsavaṃ padaṃ santaṃ ",
  "thi-ap30:3.4": "amataṃ yāma nāyaka. // // ",
  "thi-ap30:4.1": "Khalitañ ce pure atthi ",
  "thi-ap30:4.2": "sabbāsam pi mahāmuni / ",
  "thi-ap30:4.3": "aparādhaṃ pajānanti; ",
  "thi-ap30:4.4": "khama amhaṃ vināyaka. // // ",
  "thi-ap30:5.1": "Iddhiñ cāpi nidassetha ",
  "thi-ap30:5.2": "mama sāsanakārike / ",
  "thi-ap30:5.3": "parisānañ ca sabbāsaṃ ",
  "thi-ap30:5.4": "kaṅkhaṃ chindatha yāvatā // // ",
  "thi-ap30:6.1": "Yasodharī mahāvīra ",
  "thi-ap30:6.2": "manāpā piyadassanā / ",
  "thi-ap30:6.3": "sabbā tuyhaṃ mahāvīra ",
  "thi-ap30:6.4": "agāramhi pajāpatī. // // ",
  "thi-ap30:7.1": "*Thīnaṃ* satasahassānaṃ ",
  "thi-ap30:7.2": "navutīnañ chaḷ-uttariṃ / ",
  "thi-ap30:7.3": "agāre te mayaṃ vīra ",
  "thi-ap30:7.4": "pāmokkhā sabba-issarā. // // ",
  "thi-ap30:8.1": "Rūpācāraguṇūpetā ",
  "thi-ap30:8.2": "yobbanaṭṭhā piyaṃvadā / ",
  "thi-ap30:8.3": "sabbā no apacāyanti ",
  "thi-ap30:8.4": "devatā viya mānusā. // // ",
  "thi-ap30:9.1": "Aṭṭhārasasahassāni ",
  "thi-ap30:9.2": "sabbā Sākiyasambhavā / ",
  "thi-ap30:9.3": "Yasovatī sahassāni ",
  "thi-ap30:9.4": "pāmokkhā issarā tadā. // // ",
  "thi-ap30:10.1": "Kāmadhātuṃ atikkantā ",
  "thi-ap30:10.2": "saṇṭhitā rūpadhātuyā / ",
  "thi-ap30:10.3": "rūpena sadisā n' atthi ",
  "thi-ap30:10.4": "sahassānaṃ mahāmuni. // // ",
  "thi-ap30:11.1": "Sambuddhaṃ abhivādetvā ",
  "thi-ap30:11.2": "iddhiṃ dassesu satthuno / ",
  "thi-ap30:11.3": "nekā nānāvidhākārā ",
  "thi-ap30:11.4": "mahā-iddhiṃ vidassayuṃ. // // Cakkavālaṃ ",
  "thi-ap30:12.1": "samaṃ kāyaṃ ",
  "thi-ap30:12.2": "sīsaṃ uttarato kuru / ",
  "thi-ap30:12.3": "ubho pakkhā duve dīpā ",
  "thi-ap30:12.4": "jambudīpaṃ sarīrato. // // ",
  "thi-ap30:13.1": "Dakkhiṇañ ca saraṃ piñjaṃ ",
  "thi-ap30:13.2": "nānāsakhā tu pattakā / ",
  "thi-ap30:13.3": "candañ ca suriyañ c' akkhi ",
  "thi-ap30:13.4": "Merū pabbatato sikhaṃ. // // ",
  "thi-ap30:14.1": "Cakkavālagirituṇḍaṃ ",
  "thi-ap30:14.2": "jamburukkhaṃ samūlakaṃ / ",
  "thi-ap30:14.3": "vījamānaṃ upāgantvā ",
  "thi-ap30:14.4": "vandanti lokanāyakaṃ. // // ",
  "thi-ap30:15.1": "Hatthivaṇṇaṃ tath' ev' assaṃ ",
  "thi-ap30:15.2": "pabbataṃ jalajaṃ tathā / ",
  "thi-ap30:15.3": "candañ ca suriyaṃ Meruṃ ",
  "thi-ap30:15.4": "Sakkavaṇṇañ ca dassayuṃ // // ",
  "thi-ap30:16.1": "Yasovaṇṇā mayaṃ vīra ",
  "thi-ap30:16.2": "pāde vandāma cakkhuma / ",
  "thi-ap30:16.3": "tava vīra 'ppa*bhāve*na ",
  "thi-ap30:16.4": "nippannā naranāyakā. // // ",
  "thi-ap30:17.1": "Iddhīsu ca vasī homa ",
  "thi-ap30:17.2": "dibbāya sotadhātuyā / ",
  "thi-ap30:17.3": "cetopariyañāṇassa ",
  "thi-ap30:17.4": "vasī homa mahāmune. // // ",
  "thi-ap30:18.1": "Pubbenivāsaṃ jānāma ",
  "thi-ap30:18.2": "dibbacakkhuṃ visodhitaṃ / ",
  "thi-ap30:18.3": "sabbāsavā parikkhīṇā ",
  "thi-ap30:18.4": "n' atthi dāni punabbhavo. // // ",
  "thi-ap30:19.1": "Atthadhammaniruttīsu ",
  "thi-ap30:19.2": "paṭibhāne tath' eva ca / ",
  "thi-ap30:19.3": "ñāṇaṃ amhaṃ mahāvīra ",
  "thi-ap30:19.4": "uppannaṃ tava santike // // ",
  "thi-ap30:20.1": "Pubbānaṃ lokanāthānaṃ ",
  "thi-ap30:20.2": "saṅgamaṃ no nidassitaṃ / ",
  "thi-ap30:20.3": "adhikārā bahū amhe ",
  "thi-ap30:20.4": "tuyh' atthāya mahāmune. // // ",
  "thi-ap30:21.1": "Yaṃ amhaṃ purimaṃ kammaṃ ",
  "thi-ap30:21.2": "kusalaṃ sarase mune / ",
  "thi-ap30:21.3": "tuyh' atthāya mahāvīra ",
  "thi-ap30:21.4": "puññāni pacitāni no. // // ",
  "thi-ap30:22.1": "Abhabbaṭṭhāne vajjetvā ",
  "thi-ap30:22.2": "pācayimha anāvaraṃ / ",
  "thi-ap30:22.3": "tuyh' atthāya mahāvīra ",
  "thi-ap30:22.4": "cattāni jīvitāni no. // // ",
  "thi-ap30:23.1": "Nekakoṭisahassāni ",
  "thi-ap30:23.2": "bhariyatthāya dāsi no / ",
  "thi-ap30:23.3": "na tattha vimanā homa ",
  "thi-ap30:23.4": "tuyh' atthāya mahāmuni. // // ",
  "thi-ap30:24.1": "Nekakoṭisahassāni ",
  "thi-ap30:24.2": "upakārāya dāsi no / ",
  "thi-ap30:24.3": "na tattha vimanā homa ",
  "thi-ap30:24.4": "tuyh' atthāya mahāmuni. // // ",
  "thi-ap30:25.1": "Nekakoṭisahassāni ",
  "thi-ap30:25.2": "bhojanatthāya dāsi no / ",
  "thi-ap30:25.3": "na tattha vimanā homa ",
  "thi-ap30:25.4": "tuyh' atthāya mahāmune. // // ",
  "thi-ap30:26.1": "Nekakoṭisahassāni ",
  "thi-ap30:26.2": "jīvitāni cajimha no. / ",
  "thi-ap30:26.3": "bhayamokkhaṃ karissāma ",
  "thi-ap30:26.4": "jīvitāni cajimha no. // // ",
  "thi-ap30:27.1": "Aṅgagate alaṅkāre ",
  "thi-ap30:27.2": "vatthe nānāvidhe bahū / ",
  "thi-ap30:27.3": "itthibhaṇḍena gūhāma ",
  "thi-ap30:27.4": "tuyh' atthāya mahāmune. // // ",
  "thi-ap30:28.1": "Dhanadhaññapariccāgaṃ ",
  "thi-ap30:28.2": "gāmāni nigamāni ca / ",
  "thi-ap30:28.3": "khettaṃ dhītañ ca puttañ ca ",
  "thi-ap30:28.4": "pariccattaṃ mahāmuni. // // ",
  "thi-ap30:29.1": "Hatthi-assa-gavañ cāpi ",
  "thi-ap30:29.2": "dāsiyo paricārikā / ",
  "thi-ap30:29.3": "tuyhatthāya mahāvīra ",
  "thi-ap30:29.4": "pariccattaṃ asaṅkhiyaṃ. // // ",
  "thi-ap30:30.1": "Yaṃ amhe paṭimantesi ",
  "thi-ap30:30.2": "dānaṃ dassāma yācake / ",
  "thi-ap30:30.3": "vimanaṃ no na passāma ",
  "thi-ap30:30.4": "dadato dānaṃ uttamaṃ. // // ",
  "thi-ap30:31.1": "Nānāvidhaṃ bahuṃ dukkhaṃ ",
  "thi-ap30:31.2": "saṃsāre ca bahubbidhe / ",
  "thi-ap30:31.3": "tuyhatthāya mahāvīra ",
  "thi-ap30:31.4": "pariccattaṃ asaṅkhiyaṃ. // // ",
  "thi-ap30:32.1": "Sukhaṃ patvā na modāma ",
  "thi-ap30:32.2": "na ca dukkhesu dummanā / ",
  "thi-ap30:32.3": "sabbatthā tulitā homa ",
  "thi-ap30:32.4": "tuyhatthāya mahāmune. // // ",
  "thi-ap30:33.1": "Anumaggena sambuddho ",
  "thi-ap30:33.2": "saddhammaṃ abhinīharī / ",
  "thi-ap30:33.3": "anubhotvā sukhaṃ dukkhaṃ ",
  "thi-ap30:33.4": "patto bodhiṃ mahāmuni // // ",
  "thi-ap30:34.1": "Brahmadevañ ca sambuddhaṃ ",
  "thi-ap30:34.2": "Gotamaṃ lokanāyakaṃ / ",
  "thi-ap30:34.3": "aññesaṃ lokanāthānaṃ ",
  "thi-ap30:34.4": "saṅgaman te hi no bahuṃ. // // ",
  "thi-ap30:35.1": "Adhikāraṃ bahuṃ amhe ",
  "thi-ap30:35.2": "tuyhatthāya mahāmuni / ",
  "thi-ap30:35.3": "gavesantā Buddhadhammaṃ ",
  "thi-ap30:35.4": "mayan te paricārikā. // // ",
  "thi-ap30:36.1": "Kappe ca satasahasse ca ",
  "thi-ap30:36.2": "caturo ca asaṅkhiye / ",
  "thi-ap30:36.3": "Dīpaṅkaro mahāvīro ",
  "thi-ap30:36.4": "uppajji lokanāyako. // // ",
  "thi-ap30:37.1": "Paccanta-desa-visaye ",
  "thi-ap30:37.2": "nimantetvā Tathāgataṃ / ",
  "thi-ap30:37.3": "tassa āgamanaṃ maggaṃ ",
  "thi-ap30:37.4": "sodhenti tuṭṭhamānasā. // // ",
  "thi-ap30:38.1": "Tena kālena so āsi ",
  "thi-ap30:38.2": "Sumedho nāma brāhmaṇo / ",
  "thi-ap30:38.3": "maggañ ca paṭiyādesi ",
  "thi-ap30:38.4": "āyato sabbadassino. // // ",
  "thi-ap30:39.1": "Tena kālena āsimhā ",
  "thi-ap30:39.2": "sabbā brāhmaṇasambhavā / ",
  "thi-ap30:39.3": "phaludakajātipupphāni ",
  "thi-ap30:39.4": "āharimha samāgamaṃ // // ",
  "thi-ap30:40.1": "Tasmiṃ so samaye Buddho ",
  "thi-ap30:40.2": "Dīpaṅkaro mahāyaso / ",
  "thi-ap30:40.3": "viyākāsi mahāvīro ",
  "thi-ap30:40.4": "isim uggata-mānasaṃ. // // ",
  "thi-ap30:41.1": "Calati ravati puthavī ",
  "thi-ap30:41.2": "saṅkampati sadevake / ",
  "thi-ap30:41.3": "tassa kammaṃ pakittento ",
  "thi-ap30:41.4": "isim uggata-mānasaṃ. // // ",
  "thi-ap30:42.1": "Devakaññā manussā ca ",
  "thi-ap30:42.2": "amhe cāpi sadevakā / ",
  "thi-ap30:42.3": "nānāpūjanīyaṃ bhaṇḍam ",
  "thi-ap30:42.4": "pūjayitvāna patthayuṃ. // // ",
  "thi-ap30:43.1": "Tesaṃ Buddho viyākāsi ",
  "thi-ap30:43.2": "jotidīpī-sanāmako: / ",
  "thi-ap30:43.3": "ajjā ye patthitā atthi ",
  "thi-ap30:43.4": "te bhavissanti sammukhā. // // ",
  "thi-ap30:44.1": "Aparimeyy' ito kappe ",
  "thi-ap30:44.2": "yaṃ no Buddho viyākari / ",
  "thi-ap30:44.3": "vācaṃ anumodantā ",
  "thi-ap30:44.4": "evakārī ahumha no. // // ",
  "thi-ap30:45.1": "Tassa kammassa sukatassa ",
  "thi-ap30:45.2": "tattha cittaṃ pasādayuṃ / ",
  "thi-ap30:45.3": "devamānusakaṃ yoniṃ ",
  "thi-ap30:45.4": "anubhotvā asaṅkhiyaṃ. // // ",
  "thi-ap30:46.1": "Sukhadukkhe 'nubhotvāna ",
  "thi-ap30:46.2": "devesu mānusesu ca / ",
  "thi-ap30:46.3": "pacchime bhavasampatte ajātā ",
  "thi-ap30:46.4": "Sākiye kule. // // ",
  "thi-ap30:47.1": "Rūpavatī bhogavatī ",
  "thi-ap30:47.2": "yasa-sīlavatī *tato / ",
  "thi-ap30:47.3": "sabbaṅgasampadā* homa ",
  "thi-ap30:47.4": "kulesu atisakkatā. // // ",
  "thi-ap30:48.1": "Lābhaṃ silokaṃ sakkāraṃ ",
  "thi-ap30:48.2": "lokadhammasamāgamaṃ / ",
  "thi-ap30:48.3": "cittañ ca dukkhitaṃ n' atthi ",
  "thi-ap30:48.4": "vasāma akutobhayaṃ. // // Vuttaṃ ",
  "thi-ap30:49.1": "hetaṃ bhagavatā ",
  "thi-ap30:49.2": "rañño antepure tadā / ",
  "thi-ap30:49.3": "khattiyānaṃ pure vīra ",
  "thi-ap30:49.4": "upakāratthañ ca niddisī. // // ",
  "thi-ap30:50.1": "Upakārā ca yā nārī ",
  "thi-ap30:50.2": "yā ca nārī sukhe dukhe / ",
  "thi-ap30:50.3": "atthakkhāyī ca yā nārī ",
  "thi-ap30:50.4": "yā narī cānukampikā. // // ",
  "thi-ap30:51.1": "Dhammaṃ care sucaritaṃ ",
  "thi-ap30:51.2": "na naṃ duccaritaṃ care / ",
  "thi-ap30:51.3": "dhammacārī sukhaṃ seti ",
  "thi-ap30:51.4": "asmiṃ loke paramhi ca. // // ",
  "thi-ap30:52.1": "Agāraṃ vijahitvāna ",
  "thi-ap30:52.2": "pabbajimhā 'nagāriyaṃ / ",
  "thi-ap30:52.3": "aṭṭhamāse asampatte ",
  "thi-ap30:52.4": "catusaccaṃ phusimhi no. // // ",
  "thi-ap30:53.1": "Cīvaraṃ piṇḍapātañ ca ",
  "thi-ap30:53.2": "paccayaṃ sayanāsanaṃ / ",
  "thi-ap30:53.3": "upanenti bahuṃ amhe ",
  "thi-ap30:53.4": "sāgarass' eva ūmiyo. // // ",
  "thi-ap30:54.1": "Kilesā . . . pe . . . ",
  "thi-ap30:54.2": "pe . . . ",
  "thi-ap30:54.3": "pe . . . // // ",
  "thi-ap30:54.4": "Sāgataṃ . . . ",
  "thi-ap30:55.1": "pe . . . ",
  "thi-ap30:55.2": "pe . . . ",
  "thi-ap30:55.3": "pe . . . // // ",
  "thi-ap30:55.4": "",
  "thi-ap30:56.1": "Paṭisambhidā . . . pe . . . ",
  "thi-ap30:56.2": "pe . . . ",
  "thi-ap30:56.3": "",
  "thi-ap30:56.4": "pe . . . // // ",
  "thi-ap30:57.1": "*Evaṃ* bahuvidhaṃ dukkhaṃ ",
  "thi-ap30:57.2": "sampattī ca bahubbidhā / ",
  "thi-ap30:57.3": "visuddhabhāvasampattā ",
  "thi-ap30:57.4": "labhāma sabbasampadā. // // ",
  "thi-ap30:58.1": "Yā dadanti sakattānaṃ ",
  "thi-ap30:58.2": "puññatthāya mahesino / ",
  "thi-ap30:58.3": "pabhāyasampadā bhonti ",
  "thi-ap30:58.4": "nibbān'-amat'-asaṅkhataṃ // // ",
  "thi-ap30:59.1": "Parikkhīṇaṃ atītañ ca ",
  "thi-ap30:59.2": "paccuppannaṃ anāgataṃ / ",
  "thi-ap30:59.3": "saccaṃ kammam pi no khīṇaṃ ",
  "thi-ap30:59.4": "pāde vandāmi cakkhumā // // ",
  "thi-ap30:60.1": "Nibbānāya vadantīnaṃ ",
  "thi-ap30:60.2": "kiñ ca vakkhāmi uttariṃ / santasaṃkhatadoso ",
  "thi-ap30:60.3": "yo ",
  "thi-ap30:60.4": "pappotha amataṃ padan ti. // // ",
  "thi-ap30:61.1": "Itthaṃ sudaṃ Yasodharā pamukhāni aṭṭhārasabhikkhunī sahassā*ni*imā gāthāyo abhāsitthā ti. ",
  "thi-ap30:62.1": "",
  "thi-ap30:63.1": "",
  "thi-ap30:64.1": "Uddānaṃ: ",
  "thi-ap30:65.1": "Kuṇḍalā-Gotamī c' eva ",
  "thi-ap30:65.2": "Dhammadinnā ca Sākulā ",
  "thi-ap30:65.3": "Varanandā c' eva Sonā ca ",
  "thi-ap30:65.4": "Kāpilānī Yasodharā. ",
  "thi-ap30:66.1": "Dasaṭṭhārasasahassā gāthāyo gaṇitā- ",
  "thi-ap30:66.2": "v-iha satāni ",
  "thi-ap30:66.3": "c' eva cattāri ",
  "thi-ap30:66.4": "aṭṭhasattatim eva ca. [31.Yasavatī-pamukhāni khattiyakaññā bhikkhuniyo aṭṭhārasasahassāni.] "
}
