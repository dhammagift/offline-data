  "thi-ap7:1.1": "",
  "thi-ap7:1.2": "Tissanāmassa satthuno / ",
  "thi-ap7:1.3": "kaṭacchubhikkhaṃ paggayha ",
  "thi-ap7:1.4": "Buddhaseṭṭhass adās' ahaṃ // // ",
  "thi-ap7:2.1": "Paṭiggahetvāsambuddho ",
  "thi-ap7:2.2": "Tisso lokagganāyako / ",
  "thi-ap7:2.3": "vīthiyā saṇṭhito satthā ",
  "thi-ap7:2.4": "akā me anumodanaṃ: // // ",
  "thi-ap7:3.1": "‘Kaṭacchubhikkhaṃdatvāna ",
  "thi-ap7:3.2": "Tāvatiṃsaṃ gamissasi / ",
  "thi-ap7:3.3": "chattiṃsadevarājānaṃ ",
  "thi-ap7:3.4": "mahesittaṃ karissasi. // // ",
  "thi-ap7:4.1": "Paññāsaṃcakkavattīnaṃ ",
  "thi-ap7:4.2": "mahesittaṃ karissasi / ",
  "thi-ap7:4.3": "manasā patthitaṃ sabbaṃ ",
  "thi-ap7:4.4": "paṭilacchasi sabbadā. // // ",
  "thi-ap7:5.1": "Sampattiṃanubhotvāna pabbajissas' ",
  "thi-ap7:5.2": "akiñcanā / ",
  "thi-ap7:5.3": "sabbāsave pariññāya ",
  "thi-ap7:5.4": "nibbāyissas' anāsavā.' // // ",
  "thi-ap7:6.1": "Idaṃvatvāna sambuddho ",
  "thi-ap7:6.2": "Tisso lokagganāyako / ",
  "thi-ap7:6.3": "*nabhaṃ* abbhuggami vīro ",
  "thi-ap7:6.4": "haṃsarājā va ambare. // // ",
  "thi-ap7:7.1": "Sudinnaṃme dānavaraṃ ",
  "thi-ap7:7.2": "suyiṭṭhā yāgasampadā / ",
  "thi-ap7:7.3": "Kaṭacchubhikkhaṃ datvāna ",
  "thi-ap7:7.4": "pattā 'haṃ acalaṃ padaṃ. // // ",
  "thi-ap7:8.1": "Dvenavuteito kappe ",
  "thi-ap7:8.2": "yaṃ dānam adadiṃ tadā / ",
  "thi-ap7:8.3": "duggatiṃ nābhijānāmi ",
  "thi-ap7:8.4": "bhikkhadānass' idaṃ phalaṃ. // // ",
  "thi-ap7:9.1": "Kilesā. . . ",
  "thi-ap7:9.2": "pe . . . ",
  "thi-ap7:9.3": "",
  "thi-ap7:10.1": "",
  "thi-ap7:10.2": "pe . . . ",
  "thi-ap7:10.3": "pe . . . // // Sāgataṃ. . . pe . . . pe . . . pe . . . // // ",
  "thi-ap7:11.1": "Paṭisambhidā. . . ",
  "thi-ap7:11.2": "pe . . . ",
  "thi-ap7:11.3": "pe . . . pe . . . // // ",
  "thi-ap7:12.1": "Itthaṃ sudaṃ Kaṭacchubhikkhadāyikā bhikkhunī i. g. a-ti. aṭacchubhikkhadāyikāyabhikkhuniyā apadānaṃ samattaṃ. NagareAruṇavatiyā Aruṇavā ",
  "thi-ap7:13.1": ""
}
