{
  "thi-ap19:0.1": "",
  "thi-ap19:0.2": "",
  "thi-ap19:0.3": "",
  "thi-ap19:1.1": "Bhikkhunī Uppalavaṇṇā ",
  "thi-ap19:1.2": "iddhiyā pāramiṅgatā / ",
  "thi-ap19:1.3": "vanditvā satthuno pāde ",
  "thi-ap19:1.4": "imaṃ vacanam abraviṃ: // // ",
  "thi-ap19:2.1": "Nittiṇṇā jātisaṃsārā ",
  "thi-ap19:2.2": "pattāhaṃ acalaṃ padaṃ / ",
  "thi-ap19:2.3": "sabbadukkhaṃ mayā khīṇaṃ ",
  "thi-ap19:2.4": "ārocemi mahāmuni. // // ",
  "thi-ap19:3.1": "Yāvatā parisā atthi ",
  "thi-ap19:3.2": "pasannā jinasāsane / ",
  "thi-ap19:3.3": "yesañ ce me parādho 'tthi ",
  "thi-ap19:3.4": "khamantu jinasammukhā // // ",
  "thi-ap19:4.1": "Saṃsāre saṃsarantā me ",
  "thi-ap19:4.2": "khalitaṃ me sace bhave / ",
  "thi-ap19:4.3": "ārocemi mahāvīra ",
  "thi-ap19:4.4": "aparādhaṃ khamassu taṃ. // // ",
  "thi-ap19:5.1": "Iddhim cāpi nidassehi ",
  "thi-ap19:5.2": "mama sāsanakārike / ",
  "thi-ap19:5.3": "catasso parisā ajja ",
  "thi-ap19:5.4": "kaṅkhā chindāhi yāvatā. // // ",
  "thi-ap19:6.1": "Dhītā tuyhaṃ mahāvīra ",
  "thi-ap19:6.2": "paññāvanta jutindhara / ",
  "thi-ap19:6.3": "bahuñ ca dukkharaṃ kammaṃ ",
  "thi-ap19:6.4": "katam me atidukkharaṃ // // ",
  "thi-ap19:7.1": "Uppalass' eva me vaṇṇo ",
  "thi-ap19:7.2": "nāmen' Uppalanāmikā / ",
  "thi-ap19:7.3": "sāvikā te mahāvīra ",
  "thi-ap19:7.4": "pāde vandāmi cakkhumā // // ",
  "thi-ap19:8.1": "Rāhulo ca ahañ c' eva ",
  "thi-ap19:8.2": "'nekajātisate bahu / ",
  "thi-ap19:8.3": "ekasmiṃ sambhave jātā ",
  "thi-ap19:8.4": "samānacchandacetasā. // // ",
  "thi-ap19:9.1": "Nibbatti ekato hoti ",
  "thi-ap19:9.2": "jātiyā cāpi ekato / ",
  "thi-ap19:9.3": "pacchime bhavasampatte ",
  "thi-ap19:9.4": "ubho pi nāmasambhavā. // // ",
  "thi-ap19:10.1": "Putto ca Rāhulo nāma ",
  "thi-ap19:10.2": "dhītā Uppalasavhayā / ",
  "thi-ap19:10.3": "passa vīra mamaṃ iddhiṃ ",
  "thi-ap19:10.4": "balaṃ dassemi satthuno. // // ",
  "thi-ap19:11.1": "Mahāsamudde caturo ",
  "thi-ap19:11.2": "pakkhipī hatthapāṇiyaṃ / ",
  "thi-ap19:11.3": "telaṃ vatthigataṃ c' ",
  "thi-ap19:11.4": "eva vejjo komārako yathā. // // ",
  "thi-ap19:12.1": "Ubbattayitvā puthaviṃ ",
  "thi-ap19:12.2": "pakkhipī hatthapāṇiyaṃ / ",
  "thi-ap19:12.3": "cittapuññaṃ yathā nāma ",
  "thi-ap19:12.4": "luñciko mārako yuvā. // // ",
  "thi-ap19:13.1": "Cakkavālasamaṃ pāṇiṃ ",
  "thi-ap19:13.2": "chādayitvāna matthake / ",
  "thi-ap19:13.3": "vassāpetvāna phusitaṃ ",
  "thi-ap19:13.4": "nānāvaṇṇaṃ punappunaṃ. // // ",
  "thi-ap19:14.1": "Bhūmiṃ udukkhalaṃ katvā ",
  "thi-ap19:14.2": "dhaññaṃ katvāna sakkha*raṃ / ",
  "thi-ap19:14.3": "Si*neruṃ musalaṃ katvā ",
  "thi-ap19:14.4": "padakomāriko yathā. // // ",
  "thi-ap19:15.1": "Dhītā'haṃ Buddhaseṭṭhassa ",
  "thi-ap19:15.2": "nāmen' Uppalasavhayā / ",
  "thi-ap19:15.3": "abhiññāsu vasī bhūtā ",
  "thi-ap19:15.4": "tava sāsanakārikā. // // ",
  "thi-ap19:16.1": "Nānāvikubbanaṃ katvā ",
  "thi-ap19:16.2": "dassetvā lokanāyakaṃ / ",
  "thi-ap19:16.3": "nāmagottaṃ *saṃ*sāvetvā ",
  "thi-ap19:16.4": "pāde vandāmi cakkhumā. // // ",
  "thi-ap19:17.1": "Iddhiyā ca vasī homi ",
  "thi-ap19:17.2": "dibbāya sotadhātuyā / ",
  "thi-ap19:17.3": "cetopariyañāṇassa ",
  "thi-ap19:17.4": "vasī homi mahāmune. // // ",
  "thi-ap19:18.1": "Pubbenivāsaṃ jānāmi ",
  "thi-ap19:18.2": "dibbacakkhuṃ visodhitaṃ / ",
  "thi-ap19:18.3": "sabbāsavā parikkhīṇā ",
  "thi-ap19:18.4": "n' atthi dāni punabbhavo. // // ",
  "thi-ap19:19.1": "Atthadhammaniruttīsu ",
  "thi-ap19:19.2": "paṭibhāne tath' eva ca / ",
  "thi-ap19:19.3": "ñāṇaṃ me vipulaṃ suddhaṃ ",
  "thi-ap19:19.4": "pabhāvena mahesino. // // ",
  "thi-ap19:20.1": "Purimānaṃ jinaggānaṃ ",
  "thi-ap19:20.2": "saṅkamante nidassitaṃ / ",
  "thi-ap19:20.3": "adhikāraṃ bahuṃ mayhaṃ ",
  "thi-ap19:20.4": "tuyh' atthāya mahāmuni. // // ",
  "thi-ap19:21.1": "Yaṃ mayā purimaṃ kammaṃ ",
  "thi-ap19:21.2": "kusalaṃ saṃsare muni / ",
  "thi-ap19:21.3": "tav' atthāya mahāvīra ",
  "thi-ap19:21.4": "puññaṃ upacitaṃ mayā. // // ",
  "thi-ap19:22.1": "Abhabbaṭṭhāne vajjetvā ",
  "thi-ap19:22.2": "paripācento anāvaraṃ / ",
  "thi-ap19:22.3": "tav' atthāya mahāvīra ",
  "thi-ap19:22.4": "vattam me jīvituttamaṃ. // // ",
  "thi-ap19:23.1": "Dasakoṭisahassāni ",
  "thi-ap19:23.2": "adāsi mayhaṃ jīvitaṃ / ",
  "thi-ap19:23.3": "pariccattaṃ ca me hosi ",
  "thi-ap19:23.4": "tav' atthāya mahāmuni. // // ",
  "thi-ap19:24.1": "Satasahasse ",
  "thi-ap19:24.2": "",
  "thi-ap19:24.3": "ito ",
  "thi-ap19:24.4": "",
  "thi-ap19:25.1": "kappe ",
  "thi-ap19:25.2": "nāgakaññā ahaṃ tadā / ",
  "thi-ap19:25.3": "Vimalā nāma nāmena ",
  "thi-ap19:25.4": "kaññānaṃ sādhusammatā. // // ",
  "thi-ap19:26.1": "Mahorago mahānāgo ",
  "thi-ap19:26.2": "pasanno jinasāsane / ",
  "thi-ap19:26.3": "Padumuttaraṃ mahātejaṃ ",
  "thi-ap19:26.4": "nimmantesi sasāvakaṃ. // // ",
  "thi-ap19:27.1": "Ratanamayañ ca maṇḍapaṃ ",
  "thi-ap19:27.2": "pallaṅkaṃ ratanāmayaṃ / ",
  "thi-ap19:27.3": "ratanavālukākiṇṇaṃ ",
  "thi-ap19:27.4": "upabhogaṃ ratanāmayaṃ // // ",
  "thi-ap19:28.1": "Maggañ ca paṭipādesi ",
  "thi-ap19:28.2": "ratanaddhajabhūsitaṃ / ",
  "thi-ap19:28.3": "paccuggantvāna sambuddhaṃ ",
  "thi-ap19:28.4": "vajjento turiyehi so. // // ",
  "thi-ap19:29.1": "Parisāhi catassohi pareto ",
  "thi-ap19:29.2": "lokanāyako / ",
  "thi-ap19:29.3": "mahoragassa bhavane ",
  "thi-ap19:29.4": "nisīdi vara-m-āsane. // // ",
  "thi-ap19:30.1": "Annaṃ pānañ khādaniyaṃ ",
  "thi-ap19:30.2": "bhojanīyañ mahārahaṃ / ",
  "thi-ap19:30.3": "varaṃ varañ ca pādāsi ",
  "thi-ap19:30.4": "nāgarājā mahāyaso. // // ",
  "thi-ap19:31.1": "Bhuñjitvāna sa sambuddho ",
  "thi-ap19:31.2": "patte dhovitvā yoniso / ",
  "thi-ap19:31.3": "anumodaniyaṃ kāsi ",
  "thi-ap19:31.4": "nāgakaññā mahiddhikā. // // ",
  "thi-ap19:32.1": "Sabbañ ca phullitaṃ disvā ",
  "thi-ap19:32.2": "nāgakaññā mahāyasaṃ / ",
  "thi-ap19:32.3": "pasannaṃ satthuno cittaṃ ",
  "thi-ap19:32.4": "sunibaddhañ ca mānasaṃ. // // ",
  "thi-ap19:33.1": "Mamaṃ ca cittaṃ aññāya ",
  "thi-ap19:33.2": "jalajuttamanāmako / ",
  "thi-ap19:33.3": "tasmiṃ khaṇe mahāvīro ",
  "thi-ap19:33.4": "bhikkhuniṃ dassay' iddhiyā. // // ",
  "thi-ap19:34.1": "Iddhī anekā dassesi ",
  "thi-ap19:34.2": "bhikkhunī sā visāradā / ",
  "thi-ap19:34.3": "pamoditā vedajātā ",
  "thi-ap19:34.4": "satthāraṃ etad abraviṃ: // // ",
  "thi-ap19:35.1": "Addasāhaṃ imaṃ iddhiṃ ",
  "thi-ap19:35.2": "sumitaṃ itarāya pi / ",
  "thi-ap19:35.3": "kathaṃ ahosi sā vīra ",
  "thi-ap19:35.4": "iddhiyā suvisāradā? // // ",
  "thi-ap19:36.1": "Orasāmukhato jātā ",
  "thi-ap19:36.2": "dhītā mama mahiddhikā / ",
  "thi-ap19:36.3": "mamānusāsanīkārā ",
  "thi-ap19:36.4": "iddhiyā ca visāradā. // // ",
  "thi-ap19:37.1": "Buddhassa vacanam sutvā ",
  "thi-ap19:37.2": "tuṭṭhā eva patthes' ahaṃ / ",
  "thi-ap19:37.3": "aham pi tādisā homi ",
  "thi-ap19:37.4": "iddhiyā suvisāradā. // // ",
  "thi-ap19:38.1": "Pamoditāhaṃ sumanā ",
  "thi-ap19:38.2": "patta-m-uttamamānasā / ",
  "thi-ap19:38.3": "anāgatasmiṃ addhāne ",
  "thi-ap19:38.4": "īdisā homi nāyaka. // // ",
  "thi-ap19:39.1": "Maṇimayañ ca pallaṅkaṃ ",
  "thi-ap19:39.2": "maṇḍapañ ca pabhassaraṃ / ",
  "thi-ap19:39.3": "mahājanena tappetvā ",
  "thi-ap19:39.4": "sasaṅghaṃ lokanāyakaṃ // // ",
  "thi-ap19:40.1": "Nāgānaṃ pavaraṃ pu*pphaṃ* ",
  "thi-ap19:40.2": "aruṇaṃ nāmaṃ uppalaṃ / ",
  "thi-ap19:40.3": "vaṇṇaṃ me īdisaṃ hotu ",
  "thi-ap19:40.4": "pūjesiṃ lokanāyakaṃ. // // ",
  "thi-ap19:41.1": "Tena kammena sukatena ",
  "thi-ap19:41.2": "cetanāpaṇidhīhi ca / ",
  "thi-ap19:41.3": "jahitvā mānusaṃ dehaṃ ",
  "thi-ap19:41.4": "Tāvatiṃsaṃ agañch' ahaṃ. // // ",
  "thi-ap19:42.1": "Tato cutāhaṃ manuje ",
  "thi-ap19:42.2": "upapannā sayambhuno / ",
  "thi-ap19:42.3": "uppalehi paṭicchannaṃ ",
  "thi-ap19:42.4": "piṇḍapātam adās' ahaṃ. // // Ekanavute ",
  "thi-ap19:43.1": "ito kappe ",
  "thi-ap19:43.2": "Vipassī nāma nāyako / ",
  "thi-ap19:43.3": "uppajji caruṇayano ",
  "thi-ap19:43.4": "sabbadhammesu cakkhumā. // // ",
  "thi-ap19:44.1": "*Seṭṭhi*dhītā tadā hutvā ",
  "thi-ap19:44.2": "Bārāṇasipuruttame / ",
  "thi-ap19:44.3": "nimantetvāna sambuddhaṃ ",
  "thi-ap19:44.4": "sasaṅghaṃ lokanāyakaṃ // // ",
  "thi-ap19:45.1": "Mahādānaṃ daditvāna ",
  "thi-ap19:45.2": "uppalehi vimissitaṃ / ",
  "thi-ap19:45.3": "pūjayitvā ca teh' ",
  "thi-ap19:45.4": "eva vaṇṇassetaṃ apatthayiṃ. // // ",
  "thi-ap19:46.1": "Imamhi bhaddake kappe ",
  "thi-ap19:46.2": "brahmabandhu mahāyaso / ",
  "thi-ap19:46.3": "Kassapo nāma nāmena ",
  "thi-ap19:46.4": "uppajji vadatam varo. // // ",
  "thi-ap19:47.1": "Upaṭṭhāko mahesissa ",
  "thi-ap19:47.2": "tadā āsi narissaro / ",
  "thi-ap19:47.3": "Kāsirājā Kikī nāma ",
  "thi-ap19:47.4": "Bārāṇasipuruttame. // // ",
  "thi-ap19:48.1": "Tassāsiṃ dutiyā dhītā ",
  "thi-ap19:48.2": "*Samaṇ*aguttasavhayā / ",
  "thi-ap19:48.3": "dhammaṃ sutvā jinaggassa ",
  "thi-ap19:48.4": "pabbajjaṃ samarocayiṃ. // // ",
  "thi-ap19:49.1": "Anujāni na no tāto ",
  "thi-ap19:49.2": "agāre va tadā mayaṃ / ",
  "thi-ap19:49.3": "vīsavassasahassāni ",
  "thi-ap19:49.4": "vicarimha atanditā. // // ",
  "thi-ap19:50.1": "Komārabrahmacariyaṃ ",
  "thi-ap19:50.2": "rājakaññā sukheṭhitā / ",
  "thi-ap19:50.3": "Buddhopaṭṭhāniratā ",
  "thi-ap19:50.4": "muditā satta dhītaro. // // ",
  "thi-ap19:51.1": "Samaṇī Samaṇaguttā ca ",
  "thi-ap19:51.2": "Bhikkhunī Bhikkhadāyikā. / ",
  "thi-ap19:51.3": "Dhammā c' eva Sudhammā ca ",
  "thi-ap19:51.4": "sattamī Saṅghadāyikā. // // ",
  "thi-ap19:52.1": "*Ahaṃ* Khemā ca sappaññā ",
  "thi-ap19:52.2": "Paṭācārā ca Kuṇḍalā / ",
  "thi-ap19:52.3": "Kisāgotamī Dhammadinnā ",
  "thi-ap19:52.4": "Visākhā hoti sattamī. // // ",
  "thi-ap19:53.1": "Tehi kammehi sukatehi ",
  "thi-ap19:53.2": "cetanāpaṇidhīhi ca / ",
  "thi-ap19:53.3": "jahitvā mānusaṃ dehaṃ ",
  "thi-ap19:53.4": "Tāvatiṃsaṃ agacch' ahaṃ. // // ",
  "thi-ap19:54.1": "Tato cutā manussesu ",
  "thi-ap19:54.2": "upapannā mahākule / ",
  "thi-ap19:54.3": "pītamaṭṭhavaraṃ dussaṃ ",
  "thi-ap19:54.4": "adaṃ arahato ahaṃ. // // ",
  "thi-ap19:55.1": "Tato cut' Āriṭṭhapure ",
  "thi-ap19:55.2": "jātā vippakule ahaṃ / ",
  "thi-ap19:55.3": "dhītā Tirīṭavacchassa ",
  "thi-ap19:55.4": "Ummādantī manoharā. // // ",
  "thi-ap19:56.1": "Tato cutā janapade ",
  "thi-ap19:56.2": "*kule aññatare ahaṃ / ",
  "thi-ap19:56.3": "pasutā nātiphītamhi ",
  "thi-ap19:56.4": "sāliṃ gopem' ahan tadā. // // ",
  "thi-ap19:57.1": "Disvā paccekasambuddhaṃ ",
  "thi-ap19:57.2": "",
  "thi-ap19:57.3": "",
  "thi-ap19:57.4": "pañca lājasatān' ahaṃ / datvā padumachannāni, pañcaputtasatān' ahaṃ // // ",
  "thi-ap19:58.1": "Patthayiṃ tesu patthesu ",
  "thi-ap19:58.2": "madhuṃ datvā sayambhuno / ",
  "thi-ap19:58.3": "tato cutā araññe 'ham ",
  "thi-ap19:58.4": "ajāviṃ padumodare // // ",
  "thi-ap19:59.1": "Kāsirañño mahesī 'haṃ ",
  "thi-ap19:59.2": "hutvā sakkatapūjitā / ",
  "thi-ap19:59.3": "ajaniṃ rājaputtānaṃ ",
  "thi-ap19:59.4": "anūnasatapañcakaṃ. // // ",
  "thi-ap19:60.1": "Yadā te yobbanaṃ pattā ",
  "thi-ap19:60.2": "kīḷantā jalakīḷaṃ / ",
  "thi-ap19:60.3": "disvā opattapadumaṃ ",
  "thi-ap19:60.4": "āsuṃ paccekanāya*kā.* // // ",
  "thi-ap19:61.1": "Sāhaṃ tehi vinā bhūtā ",
  "thi-ap19:61.2": "*sut*avīrehi sokinī / ",
  "thi-ap19:61.3": "cutā Isigilīpasse ",
  "thi-ap19:61.4": "gāmakamhi ajāyi 'haṃ. // // ",
  "thi-ap19:62.1": "Yadā Buddhāsutamatī ",
  "thi-ap19:62.2": "sutānakasakaṃ tadā / ",
  "thi-ap19:62.3": "yāguṃ adāya gacchantī ",
  "thi-ap19:62.4": "aṭṭhapaccekanāyake // // ",
  "thi-ap19:63.1": "Bhikkhāya gāmaṃ gacchante ",
  "thi-ap19:63.2": "disvā *putte anussariṃ* / ",
  "thi-ap19:63.3": "khīradhārā viniggañchi ",
  "thi-ap19:63.4": "tadā me puttapemasā. // // ",
  "thi-ap19:64.1": "Tato tesaṃ adaṃ yāgum ",
  "thi-ap19:64.2": "pasannā sehi pāṇihi / ",
  "thi-ap19:64.3": "tato cutāhaṃ Tidasaṃ ",
  "thi-ap19:64.4": "Nandanaṃ upapajj' ahaṃ. // // ",
  "thi-ap19:65.1": "Anubhotvā sukhaṃ dukkhaṃ ",
  "thi-ap19:65.2": "saṃsaritvā bhavābhave / ",
  "thi-ap19:65.3": "tav' atthāya mahāvīra ",
  "thi-ap19:65.4": "pariccattañ ca jīvitaṃ. // // ",
  "thi-ap19:66.1": "Evaṃ bahu*vidhaṃ du*kkhaṃ ",
  "thi-ap19:66.2": "sampattī ca bahubbidhā / ",
  "thi-ap19:66.3": "pacchime bhavasampatte ",
  "thi-ap19:66.4": "jātā Sāvatthiyaṃ pure // // ",
  "thi-ap19:67.1": "Mahādhane seṭṭhikule ",
  "thi-ap19:67.2": "sukhite sajjite tathā / ",
  "thi-ap19:67.3": "nānāratanapajjote ",
  "thi-ap19:67.4": "sabbakāmasamiddhine. // // ",
  "thi-ap19:68.1": "Sakkatā pūjitā c' eva ",
  "thi-ap19:68.2": "mānitā 'pacitā tathā / ",
  "thi-ap19:68.3": "rūpasiriṃ anuppattā ",
  "thi-ap19:68.4": "kulesu atisakkatā. // // ",
  "thi-ap19:69.1": "Atīva patthitā c' āsiṃ ",
  "thi-ap19:69.2": "rūpabhogasirīhi ca / ",
  "thi-ap19:69.3": "patthitā seṭṭhiputtehi ",
  "thi-ap19:69.4": "anekehi satehi pi. // // ",
  "thi-ap19:70.1": "Agāraṃ pajahitvāna ",
  "thi-ap19:70.2": "pabbajiṃ anagāriyaṃ / ",
  "thi-ap19:70.3": "aṭṭhamāse asampatte ",
  "thi-ap19:70.4": "catusaccam apāpuṇiṃ. // // ",
  "thi-ap19:71.1": "*Iddhi*yā abhinimmitvā ",
  "thi-ap19:71.2": "caturassa-rathaṃ ahaṃ / ",
  "thi-ap19:71.3": "Buddhassa pāde vandissaṃ ",
  "thi-ap19:71.4": "lokanāthassa sirīmato. // // ",
  "thi-ap19:72.1": "Supupphitaggaṃ upagamma bhikkhunī ",
  "thi-ap19:72.2": "ekā tuvaṃ tiṭṭhasi sālamūle / ",
  "thi-ap19:72.3": "na c' atthi te dutiyā vaṇṇadhātu ",
  "thi-ap19:72.4": "bā*le na tvaṃ* bhāyasi dhuttakānaṃ? // // ",
  "thi-ap19:73.1": "Sataṃ sahassānam pi dhuttakānaṃ ",
  "thi-ap19:73.2": "idhāgatā tādisakā bhaveyyuṃ / ",
  "thi-ap19:73.3": "lomaṃ na iñjāmi na santasāmi Māraṃ ",
  "thi-ap19:73.4": "na bhāyāmi taṃ ekik' āsiṃ. // // ",
  "thi-ap19:74.1": "Esā antaradhāyāmi ",
  "thi-ap19:74.2": "kucchiṃ vā pavisāmi *te* / ",
  "thi-ap19:74.3": "bhamukantarikāyam pi ",
  "thi-ap19:74.4": "tiṭṭhantiṃ maṃ na dakkhasi. // // ",
  "thi-ap19:75.1": "Cittasmiṃ vasibhūtasmiṃ ",
  "thi-ap19:75.2": "iddhipādā subhāvitā / ",
  "thi-ap19:75.3": "sabbabandhanamutt' amhi ",
  "thi-ap19:75.4": "na tam bhāyāmi āvuso. // // ",
  "thi-ap19:76.1": "Sattisūlūpamā kāmā ",
  "thi-ap19:76.2": "khandhā pi adhikuṭṭanā / ",
  "thi-ap19:76.3": "yaṃ tvaṃ kā*maratiṃ brūsi,* ",
  "thi-ap19:76.4": "arati dāni sā mama. // // ",
  "thi-ap19:77.1": "Sabbattha vihatā nandī ",
  "thi-ap19:77.2": "tamokkhandho padālito / ",
  "thi-ap19:77.3": "evaṃ jānāhi pāpima, ",
  "thi-ap19:77.4": "nihato tvam asi antaka. // // ",
  "thi-ap19:78.1": "Jino tamhi gune tuṭṭho ",
  "thi-ap19:78.2": "etadagge ṭhapesi maṃ / ",
  "thi-ap19:78.3": "\"seṭṭhā iddhimatīnan\" ti ",
  "thi-ap19:78.4": "parisāsu vināyako. // // ",
  "thi-ap19:79.1": "Pariciṇṇo *ma*yā satthā ",
  "thi-ap19:79.2": "kataṃ Buddhassasāsanaṃ / ",
  "thi-ap19:79.3": "ohito garuko bhāro ",
  "thi-ap19:79.4": "bhavanetti samūhatā. // // ",
  "thi-ap19:80.1": "Yass' atthāya pabbajitā ",
  "thi-ap19:80.2": "agārasmā anagāriyaṃ / ",
  "thi-ap19:80.3": "so me attho anuppatto ",
  "thi-ap19:80.4": "sabbasaṃyojanakkhayo. // // ",
  "thi-ap19:81.1": "Cīvaraṃ piṇḍapātañ ca ",
  "thi-ap19:81.2": "paccayaṃ sayanāsanaṃ / ",
  "thi-ap19:81.3": "kha*ṇena* upanāmentī ",
  "thi-ap19:81.4": "sahassāni samantato. // // ",
  "thi-ap19:82.1": "Kilesā . . . ",
  "thi-ap19:82.2": "pe . . . ",
  "thi-ap19:82.3": "",
  "thi-ap19:83.1": "",
  "thi-ap19:83.2": "pe . . . ",
  "thi-ap19:83.3": "pe . . . // // Sāgataṃ . . . pe . . . pe . . . pe . . . // // ",
  "thi-ap19:84.1": "Paṭisambhidā . . . ",
  "thi-ap19:84.2": "pe . . . ",
  "thi-ap19:84.3": "pe . . . pe . . . // // ",
  "thi-ap19:85.1": "Itthaṃ sudaṃ Uppalavaṇṇā Bhikkhunī i. g. a-ti. Uppalavaṇṇāya ",
  "thi-ap19:86.1": "theriyā apadānaṃ samattaṃ. "
}
