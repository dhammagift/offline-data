  "thi-ap8:0.3": "",
  "thi-ap8:1.1": "",
  "thi-ap8:1.2": "nāma khattiyo / ",
  "thi-ap8:1.3": "tassa rañño ahaṃ bhariyā ",
  "thi-ap8:1.4": "na mālaṃ pādayām' ahaṃ. // // ",
  "thi-ap8:2.1": "Sattamālā gahetvāna ",
  "thi-ap8:2.2": "uppalī devagandhikā / ",
  "thi-ap8:2.3": "nisajja pāsādavare ",
  "thi-ap8:2.4": "evaṃ cintesi tāvade: // // ",
  "thi-ap8:3.1": "Kimme imāhi mālāhi ",
  "thi-ap8:3.2": "sirasā ropitāhi me / ",
  "thi-ap8:3.3": "varam me Buddhaseṭṭhassa ",
  "thi-ap8:3.4": "ñāṇamhi abhiropitaṃ. // // ",
  "thi-ap8:4.1": "Sambuddhaṃpaṭimānenti ",
  "thi-ap8:4.2": "dvārāsanne nisīd' ahaṃ / ",
  "thi-ap8:4.3": "yadā etīha sambuddho ",
  "thi-ap8:4.4": "pūjayissaṃ mahāmuniṃ. // // ",
  "thi-ap8:5.1": "Kakudhovilasanto va ",
  "thi-ap8:5.2": "migarājā va kesarī / ",
  "thi-ap8:5.3": "bhikkhusaṅghena sahito ",
  "thi-ap8:5.4": "āgacchi vīthiyā jino. // // ",
  "thi-ap8:6.1": "Buddhassaraṃsaṃ disvāna ",
  "thi-ap8:6.2": "haṭṭhā saṃviggamānasā / ",
  "thi-ap8:6.3": "dvāraṃ avāpuritvāna ",
  "thi-ap8:6.4": "Buddhaseṭṭhaṃ apūjayiṃ. // // ",
  "thi-ap8:7.1": "Sattauppalapupphāni ",
  "thi-ap8:7.2": "pavitthiṇṇāni ambare / ",
  "thi-ap8:7.3": "chādiṃ karontā Buddhassa ",
  "thi-ap8:7.4": "matthake dhārayanti te. // // ",
  "thi-ap8:8.1": "Udaggacittāsumanā ",
  "thi-ap8:8.2": "vedajātā katañjalī / ",
  "thi-ap8:8.3": "tattha cittaṃ pasādetvā ",
  "thi-ap8:8.4": "Tāvatiṃsaṃ agacch' ahaṃ. // // ",
  "thi-ap8:9.1": "Mahānelassachadanaṃ ",
  "thi-ap8:9.2": "dhārenti mama muddhani / ",
  "thi-ap8:9.3": "dibbaṃ gandhaṃ pavāyāmi ",
  "thi-ap8:9.4": "sattupalān' idaṃ phalaṃ. // // ",
  "thi-ap8:10.1": "Kadāciniyamānāya ",
  "thi-ap8:10.2": "ñātisaṅghena me tadā / ",
  "thi-ap8:10.3": "yāvatā parisā mayhaṃ ",
  "thi-ap8:10.4": "mahānelaṃ dhariyyati. // // ",
  "thi-ap8:11.1": "Sattatidevarājānaṃ ",
  "thi-ap8:11.2": "mahesittam akārayiṃ / ",
  "thi-ap8:11.3": "sabbattha issarā hutvā ",
  "thi-ap8:11.4": "saṃsarāmi bhavābhave. // // ",
  "thi-ap8:12.1": "Tesaṭṭhicakkavattīnaṃ ",
  "thi-ap8:12.2": "mahesittam akārayiṃ / ",
  "thi-ap8:12.3": "sabbe maṃ anuvattanti: ",
  "thi-ap8:12.4": "adeyyavacanā ahaṃ. // // ",
  "thi-ap8:13.1": "Uppalass'eva me vaṇṇo ",
  "thi-ap8:13.2": "gandho c' eva pavāyati / ",
  "thi-ap8:13.3": "duggatiṃ nābhijānāmi ",
  "thi-ap8:13.4": "Buddhapūjāy' idaṃ phalaṃ. // // ",
  "thi-ap8:14.1": "Iddhipādesukusalā bojjhaṅgabhāvane ",
  "thi-ap8:14.2": "ratā / ",
  "thi-ap8:14.3": "abhiññāpāramippattā ",
  "thi-ap8:14.4": "Buddhapūjāy' idaṃ phalaṃ. // // ",
  "thi-ap8:15.1": "",
  "thi-ap8:15.2": "Satipaṭṭhānakusalāsamādhijjhānagocarā / ",
  "thi-ap8:15.3": "sammappadhānam anuyuttā ",
  "thi-ap8:15.4": "Buddhapūjāy' idaṃ phalaṃ. // // ",
  "thi-ap8:16.1": "Viriyaṃme dhuradhorayhaṃ ",
  "thi-ap8:16.2": "yogakkhemādhivāhanaṃ / ",
  "thi-ap8:16.3": "sabbāsavā parikkhīṇā ",
  "thi-ap8:16.4": "n' atthi dāni punabbhavo. // // ",
  "thi-ap8:17.1": "Ekatiṃseito kappe ",
  "thi-ap8:17.2": "yaṃ puppham abhipūjayiṃ / ",
  "thi-ap8:17.3": "duggatiṃ nābhijānāmi ",
  "thi-ap8:17.4": "Buddhapūjāy' idaṃ phalaṃ. // // ",
  "thi-ap8:18.1": "Kilesā. . . ",
  "thi-ap8:18.2": "pe . . . ",
