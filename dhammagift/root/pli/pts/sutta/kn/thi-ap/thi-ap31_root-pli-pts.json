  "thi-ap31:1.1": "Bhavā sabbe parikkhīṇā ",
  "thi-ap31:1.2": "",
  "thi-ap31:1.3": "bhavasandhivimocitā / sabbāsavāmano n' atthi ",
  "thi-ap31:1.4": "ārocema mahāmuni. // // ",
  "thi-ap31:2.1": "Purimaṃ kammaṃ kusalaṃ ",
  "thi-ap31:2.2": "yaṃ kiñci sabbam patthitaṃ / ",
  "thi-ap31:2.3": "paribhogaṃ ayaṃ dinnaṃ ",
  "thi-ap31:2.4": "tuyh' atthāya mahāmuni. // // ",
  "thi-ap31:3.1": "Buddhapaccekabuddhānaṃ ",
  "thi-ap31:3.2": "sāvakānañ ca patthitaṃ / ",
  "thi-ap31:3.3": "paribhogaṃ ayaṃ dinnaṃ ",
  "thi-ap31:3.4": "tuyhatthāya mahāmuni. // // ",
  "thi-ap31:4.1": "Uccānīcam ayaṃ kammaṃ ",
  "thi-ap31:4.2": "bhikkhūnaṃ sādhu patthitaṃ / ",
  "thi-ap31:4.3": "uccākulāparikammaṃ ",
  "thi-ap31:4.4": "kat' amhehi mahāmune. // // ",
  "thi-ap31:5.1": "Ten' eva sukkamūlena ",
  "thi-ap31:5.2": "coditā kammasampadā / ",
  "thi-ap31:5.3": "mānussikam anikkantā ",
  "thi-ap31:5.4": "jāyiṃsu khattiye kule. // // ",
  "thi-ap31:6.1": "Uppatte 'va kate kamme ",
  "thi-ap31:6.2": "jātiyā cāpi ekato / ",
  "thi-ap31:6.3": "pacchime ekato jātā ",
  "thi-ap31:6.4": "khattiyā kulasambhavā. // // ",
  "thi-ap31:7.1": "Rūpavatī bhogavatī ",
  "thi-ap31:7.2": "lābhasakkārapūjitā / ",
  "thi-ap31:7.3": "antepure mahāvīra ",
  "thi-ap31:7.4": "devānaṃ viya Nandane. // // ",
  "thi-ap31:8.1": "Nibbinditvā agāramhā ",
  "thi-ap31:8.2": "pabbajimhā 'nagāriyaṃ / ",
  "thi-ap31:8.3": "katipāhaṃ upādāya ",
  "thi-ap31:8.4": "sabbā patt' amha nibbutiṃ. // // ",
  "thi-ap31:9.1": "Cīvaraṃ piṇḍapātañ ca ",
  "thi-ap31:9.2": "paccayaṃ sayanāsanaṃ / ",
  "thi-ap31:9.3": "upanenti bahuṃ amhe ",
  "thi-ap31:9.4": "sadā sakkata-pūjitā. // // ",
  "thi-ap31:10.1": "Kilesā . . . pe . . . ",
  "thi-ap31:10.2": "pe . . . ",
  "thi-ap31:10.3": "pe . . . // // ",
  "thi-ap31:10.4": "Sāgataṃ . . . ",
  "thi-ap31:11.1": "pe . . . ",
  "thi-ap31:11.2": "pe . . . ",
  "thi-ap31:11.3": "pe . . . // // ",
  "thi-ap31:11.4": "",
  "thi-ap31:12.1": "Paṭisambhidā . . . pe . . . ",
  "thi-ap31:12.2": "pe . . . ",
  "thi-ap31:12.3": "",
  "thi-ap31:12.4": "pe . . . // // ",
  "thi-ap31:13.1": "Itthaṃ sudaṃ Yasavatī pamukhāni khattiyakaññā bhikkhuniyo aṭṭhārasasahassāni bhagavato sammukhā imā gāthāyo abhāsitthā ti. *Yasavatīpamukhānaṃkhattiyakaññānaṃ bhikkhunīnaṃ aṭṭhārasasahassānaṃ apadānaṃ samattaṃ.* [32. Caturāsītiṃ brāhmaṇakaññā bhikkhunī sahassāni.] Cullāsītiṃ sahassāni ",
  "thi-ap31:14.1": ""
}
