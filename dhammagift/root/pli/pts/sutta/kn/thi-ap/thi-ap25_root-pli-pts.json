{
  "thi-ap25:0.1": "",
  "thi-ap25:0.2": "",
  "thi-ap25:0.3": "",
  "thi-ap25:1.1": "Padumuttaro nāma jino ",
  "thi-ap25:1.2": "sabbadhammāna pāragū / ",
  "thi-ap25:1.3": "ito satasahassamhi ",
  "thi-ap25:1.4": "kappe uppajji nāyako. // // ",
  "thi-ap25:2.1": "Ovādako viññāpako ",
  "thi-ap25:2.2": "tārako sabbapāṇinaṃ / ",
  "thi-ap25:2.3": "desanākusalo Buddho ",
  "thi-ap25:2.4": "tāresi janataṃ bahuṃ. // // ",
  "thi-ap25:3.1": "Anukampako kāruṇiko ",
  "thi-ap25:3.2": "hitesī sabbapāṇinaṃ / ",
  "thi-ap25:3.3": "sampatte titthiye sabbe ",
  "thi-ap25:3.4": "pañcasīle patiṭṭhapi. // // ",
  "thi-ap25:4.1": "Evaṃ nirākulaṃ āsi ",
  "thi-ap25:4.2": "suññataṃ titthiyehi ca / ",
  "thi-ap25:4.3": "vicittaṃ arahantehi ",
  "thi-ap25:4.4": "vasībhūtehi tādihi. // // ",
  "thi-ap25:5.1": "Ratanān' aṭṭhapaññāsaṃ uggato ",
  "thi-ap25:5.2": "so mahāmuṇi / ",
  "thi-ap25:5.3": "kañcanagghiyasaṅkāso ",
  "thi-ap25:5.4": "battiṃsavaralakkhaṇo. // // ",
  "thi-ap25:6.1": "Vassasahasahassāni ",
  "thi-ap25:6.2": "āyu tiṭṭhati tāvade / ",
  "thi-ap25:6.3": "tāvatā tiṭṭhamāno so ",
  "thi-ap25:6.4": "tāresi janataṃ bahuṃ. // // ",
  "thi-ap25:7.1": "Tadā' haṃ Haṃsavatiyaṃ ",
  "thi-ap25:7.2": "jātā seṭṭhikule ahuṃ / ",
  "thi-ap25:7.3": "nānāratanapajjote ",
  "thi-ap25:7.4": "mahāsukhasamappitā. // // ",
  "thi-ap25:8.1": "Upetvā taṃ mahāvīraṃ ",
  "thi-ap25:8.2": "assosiṃ dhammadesanaṃ / ",
  "thi-ap25:8.3": "amataṃ paramassādaṃ ",
  "thi-ap25:8.4": "paramatthanivedakaṃ. // // ",
  "thi-ap25:9.1": "Tadā nimantayitvāna ",
  "thi-ap25:9.2": "sasaṅghaṃ tibhavantagaṃ / ",
  "thi-ap25:9.3": "datvā tassa mahādānaṃ ",
  "thi-ap25:9.4": "pasannā sehi pāṇihi. // // ",
  "thi-ap25:10.1": "Jhāyinīnaṃ bhikkhunīnaṃ ",
  "thi-ap25:10.2": "aggaṭṭhānaṃ apatthayiṃ / ",
  "thi-ap25:10.3": "nipacca sirasā vīraṃ ",
  "thi-ap25:10.4": "sasaṅghaṃ lokanāyakaṃ. // // ",
  "thi-ap25:11.1": "Tadā adantadamako ",
  "thi-ap25:11.2": "tilokasaraṇo pabhū / ",
  "thi-ap25:11.3": "vyākāsi narasaddūlo: ",
  "thi-ap25:11.4": "\"lacchas' etaṃ supatthitaṃ. // // ",
  "thi-ap25:12.1": "Satasahasse ito kappe ",
  "thi-ap25:12.2": "Okkākakulasambhavo / ",
  "thi-ap25:12.3": "Gotamo nāma nāmena ",
  "thi-ap25:12.4": "satthā loke bhavissati. // // ",
  "thi-ap25:13.1": "Tassa dhammesu dāyādā ",
  "thi-ap25:13.2": "orasā dhammanimmitā / ",
  "thi-ap25:13.3": "Nandā ti nāma nāmena ",
  "thi-ap25:13.4": "hessati satthu sāvikā\". // // ",
  "thi-ap25:14.1": "Taṃ sutvā muditā hutvā ",
  "thi-ap25:14.2": "yāvajīvaṃ tadā jinaṃ / ",
  "thi-ap25:14.3": "mettacittā paricariṃ ",
  "thi-ap25:14.4": "paccayehi vināyakaṃ. // // ",
  "thi-ap25:15.1": "Tena kammena sukatena ",
  "thi-ap25:15.2": "cetanāpaṇidhīhi ca / ",
  "thi-ap25:15.3": "jahitvā mānusaṃ dehaṃ ",
  "thi-ap25:15.4": "Tāvatiṃsaṃ agacch' ahaṃ. // // ",
  "thi-ap25:16.1": "Tato cutā Yāmam agaṃ ",
  "thi-ap25:16.2": "tato 'haṃ Tusitaṃ agaṃ / ",
  "thi-ap25:16.3": "tato ca Nimmānaratiṃ ",
  "thi-ap25:16.4": "Vasavattipuran tato. // // ",
  "thi-ap25:17.1": "Yattha yatthopapajjāmi ",
  "thi-ap25:17.2": "tassa kammassa vāhasā / ",
  "thi-ap25:17.3": "tattha tatth' eva rājūnaṃ ",
  "thi-ap25:17.4": "mahesittam akārayiṃ. // // ",
  "thi-ap25:18.1": "Tato cutā manussatte ",
  "thi-ap25:18.2": "rājūnaṃ cakkavattinaṃ / ",
  "thi-ap25:18.3": "maṇḍalīnaṃ 'va rājūnaṃ ",
  "thi-ap25:18.4": "mahesittam akārayiṃ. // // ",
  "thi-ap25:19.1": "Sampattiṃ anubhotvāna ",
  "thi-ap25:19.2": "devesu manujesu ca / ",
  "thi-ap25:19.3": "sabbattha sukhitā hutvā ",
  "thi-ap25:19.4": "'nekakappesu saṃsariṃ. // // ",
  "thi-ap25:20.1": "Pacchime bhavasampatte ",
  "thi-ap25:20.2": "suramme Kapilavhaye / ",
  "thi-ap25:20.3": "rañño Suddhodanassā 'haṃ ",
  "thi-ap25:20.4": "dhītā āsiṃ aninditā. // // ",
  "thi-ap25:21.1": "Siriyā rūpiniṃ disvā ",
  "thi-ap25:21.2": "nanditaṃ āsi taṃ kulaṃ / ",
  "thi-ap25:21.3": "tena Nandā ti me nāmaṃ ",
  "thi-ap25:21.4": "sundaraṃ pavaraṃ aduṃ. // // ",
  "thi-ap25:22.1": "Yuvatīnañ ca sabbāsaṃ ",
  "thi-ap25:22.2": "kalyāṇī ti ca vissutā / ",
  "thi-ap25:22.3": "tasmim pi nagare ramme ",
  "thi-ap25:22.4": "ṭhapetvā taṃ Yasodharaṃ // // ",
  "thi-ap25:23.1": "Jeṭṭho bhātā tilokaggo, ",
  "thi-ap25:23.2": "majjhimo arahā tathā / ",
  "thi-ap25:23.3": "ekākinī gahaṭṭhā 'haṃ ",
  "thi-ap25:23.4": "mātuyā paricoditā: // // ",
  "thi-ap25:24.1": "\"Sākiyamhi kule jātā ",
  "thi-ap25:24.2": "putte Buddhānujā tuvaṃ / ",
  "thi-ap25:24.3": "Nandena pi vinā bhūtā ",
  "thi-ap25:24.4": "agāre kiṃ na acchasi? // // ",
  "thi-ap25:25.1": "Jarāvasānaṃ yobbaññaṃ ",
  "thi-ap25:25.2": "rūpaṃ asucisammataṃ / ",
  "thi-ap25:25.3": "rogantam api c' ārogyaṃ ",
  "thi-ap25:25.4": "jīvitaṃ maraṇantikaṃ. // // ",
  "thi-ap25:26.1": "Idam pi te subhaṃ rūpaṃ ",
  "thi-ap25:26.2": "passa kantaṃ manoharaṃ / ",
  "thi-ap25:26.3": "'maṃ bhūsanaṃ alaṅkāraṃ ",
  "thi-ap25:26.4": "sirisaṅkhatasannibhaṃ // // ",
  "thi-ap25:27.1": "Pūjitaṃ lokasāraṃ va ",
  "thi-ap25:27.2": "nayanānaṃ rasāyanaṃ / ",
  "thi-ap25:27.3": "puññānaṃ kittijananaṃ ",
  "thi-ap25:27.4": "Okkākakulanandanaṃ. // // ",
  "thi-ap25:28.1": "Naciren' eva kālena ",
  "thi-ap25:28.2": "jarā samadhihessati / ",
  "thi-ap25:28.3": "vihāya gehaṃ tāruññe ",
  "thi-ap25:28.4": "vara dhammam anindite.\" // // ",
  "thi-ap25:29.1": "Sutvāham mātu vacanaṃ ",
  "thi-ap25:29.2": "pabbajiṃ anagāriyaṃ / ",
  "thi-ap25:29.3": "dehena na tu cittena ",
  "thi-ap25:29.4": "rūpayobbanalāḷitā. // // ",
  "thi-ap25:30.1": "Mahatā ca payattena ",
  "thi-ap25:30.2": "jhān' ajjhena saraṃ mama / ",
  "thi-ap25:30.3": "kātuñ ca vadate mātā ",
  "thi-ap25:30.4": "na cāhaṃ tatra ussukā. // // ",
  "thi-ap25:31.1": "Tato mahākāruṇiko ",
  "thi-ap25:31.2": "disvā maṃ kāmalālasaṃ / ",
  "thi-ap25:31.3": "nibbindanatthaṃ rūpasmiṃ ",
  "thi-ap25:31.4": "mama cakkhupathe jino // // ",
  "thi-ap25:32.1": "Sakena ānubhāvena ",
  "thi-ap25:32.2": "itthiṃ māpesi sobhiniṃ / ",
  "thi-ap25:32.3": "dassanīyaṃ suruciraṃ ",
  "thi-ap25:32.4": "mamato pi surūpiniṃ. // // ",
  "thi-ap25:33.1": "Tam ahaṃ vimhitā disvā ",
  "thi-ap25:33.2": "avinicchitadehiniṃ / ",
  "thi-ap25:33.3": "cintayiṃ saphalaṃ me ti ",
  "thi-ap25:33.4": "nettalābhañ ca mānusaṃ // // ",
  "thi-ap25:34.1": "Tam āham \"ehi subhage ",
  "thi-ap25:34.2": "yen' attho taṃ vadehi me / ",
  "thi-ap25:34.3": "kulan te nāmagottañ ca ",
  "thi-ap25:34.4": "vada me yadi te piyaṃ\". // // ",
  "thi-ap25:35.1": "Na pañhakālo subhage ",
  "thi-ap25:35.2": "ucchaṅge maṃ nivesaya / ",
  "thi-ap25:35.3": "nisīdantī mam' aṅgāni ",
  "thi-ap25:35.4": "passajissaṃ muhuttakaṃ. // // ",
  "thi-ap25:36.1": "Tato sīsaṃ mam' aṅke sā ",
  "thi-ap25:36.2": "katvā sayi sulocanā / ",
  "thi-ap25:36.3": "tassā nalāṭe patitā ",
  "thi-ap25:36.4": "luddā paramadāruṇā. // // ",
  "thi-ap25:37.1": "Saha tassā nipātena ",
  "thi-ap25:37.2": "piḷakā udapajjatha / ",
  "thi-ap25:37.3": "pagghariṃsu pabhinnā ca ",
  "thi-ap25:37.4": "kuṇapā pubbalohitā. // // ",
  "thi-ap25:38.1": "Sambhinnaṃ vadanaṃ cāpi ",
  "thi-ap25:38.2": "kuṇapaṃ pūtigandhikaṃ / ",
  "thi-ap25:38.3": "uddhumātaṃ vinīlañ ca sabbañ ",
  "thi-ap25:38.4": "cāpi sarīrakaṃ. // // ",
  "thi-ap25:39.1": "Sā pavedhitasabbaṅgī ",
  "thi-ap25:39.2": "nissayanti muhuṃ muhuṃ / ",
  "thi-ap25:39.3": "vedayantī sakaṃ dukkhaṃ ",
  "thi-ap25:39.4": "karuṇaṃ paridevayi: // // ",
  "thi-ap25:40.1": "*Dukkhena dukkhitā homi ",
  "thi-ap25:40.2": "phusayanti ca vedanā* / ",
  "thi-ap25:40.3": "mahādukkhe nimugg' amhi ",
  "thi-ap25:40.4": "saraṇaṃ hohi me sakhī. // // ",
  "thi-ap25:41.1": "Kuhiṃ vadanasobhan te? ",
  "thi-ap25:41.2": "kuhiṃ te tuṅganāsikā? / ",
  "thi-ap25:41.3": "tambabimbavaroṭṭhan te ",
  "thi-ap25:41.4": "vadanaṃ te kuhiṃ gataṃ? // // ",
  "thi-ap25:42.1": "Kuhiṃ sasiṃ nibhaṃ vattaṃ? ",
  "thi-ap25:42.2": "kambugīvā kuhiṃ gatā? / ",
  "thi-ap25:42.3": "dolālocā ca te kaṇṇā ",
  "thi-ap25:42.4": "vevaṇṇaṃ samupāgatā. // // ",
  "thi-ap25:43.1": "Makula-khārak'-ākārā kalasā ",
  "thi-ap25:43.2": "va payodharā / ",
  "thi-ap25:43.3": "pabhinnā pūtikuṇapā ",
  "thi-ap25:43.4": "duṭṭhagandhitvam āgatā. // // ",
  "thi-ap25:44.1": "Vedimajjhā puthussoṇi ",
  "thi-ap25:44.2": "sūṇā 'va nītakibbisā / ",
  "thi-ap25:44.3": "jātā abhejjabharitā. ",
  "thi-ap25:44.4": "Aho rūpam asassataṃ. // // ",
  "thi-ap25:45.1": "Sabbaṃ sarīrasañjātaṃ ",
  "thi-ap25:45.2": "pūtigandhaṃ bhayānakaṃ / ",
  "thi-ap25:45.3": "susānam iva jegucchaṃ ",
  "thi-ap25:45.4": "ramante yattha bālisā. // // ",
  "thi-ap25:46.1": "Tadā mahākāruṇiko ",
  "thi-ap25:46.2": "bhātā me lokanāyako / ",
  "thi-ap25:46.3": "disvā saṃviggacittaṃ maṃ ",
  "thi-ap25:46.4": "imā gāthā abhāsatha: // // ",
  "thi-ap25:47.1": "Āturaṃ kuṇapaṃ pūtiṃ ",
  "thi-ap25:47.2": "passa Nande samussayaṃ / ",
  "thi-ap25:47.3": "asubhāya cittaṃ bhāvehi ",
  "thi-ap25:47.4": "ekaggam susamāhitaṃ. // // ",
  "thi-ap25:48.1": "Yathā idaṃ tathā etaṃ ",
  "thi-ap25:48.2": "yathā etaṃ tathā idaṃ / ",
  "thi-ap25:48.3": "duggandhaṃ pūtikaṃ vāti ",
  "thi-ap25:48.4": "bālānaṃ abhinanditaṃ. // // ",
  "thi-ap25:49.1": "Evam etaṃ avekkhantī ",
  "thi-ap25:49.2": "rattindivam atanditā / ",
  "thi-ap25:49.3": "tato sakāya paññāya ",
  "thi-ap25:49.4": "abhinibbijja dakkhasi. // // ",
  "thi-ap25:50.1": "Tato 'ham āsiṃ saṃviggā ",
  "thi-ap25:50.2": "sutvā gāthā subhāsitā / ",
  "thi-ap25:50.3": "tatra ṭhitā 'va 'haṃ santī ",
  "thi-ap25:50.4": "arahattaṃ apāpuṇiṃ. // // ",
  "thi-ap25:51.1": "Yattha yattha nisinnā 'haṃ ",
  "thi-ap25:51.2": "tadā jhānaparāyanā / ",
  "thi-ap25:51.3": "jino tasmiṃ guṇe tuṭṭho ",
  "thi-ap25:51.4": "etadagge ṭhapesi maṃ. // // ",
  "thi-ap25:52.1": "Kilesā . . . ",
  "thi-ap25:52.2": "pe . . . ",
  "thi-ap25:52.3": "",
  "thi-ap25:53.1": "",
  "thi-ap25:53.2": "pe . . . ",
  "thi-ap25:53.3": "pe . . . // // Sāgataṃ . . . pe . . . pe . . . pe . . . // // ",
  "thi-ap25:54.1": "Paṭisambhidā . . . ",
  "thi-ap25:54.2": "pe . . . ",
  "thi-ap25:54.3": "pe . . . pe . . . // // ",
  "thi-ap25:55.1": "Itthaṃ sudaṃ Nandā bhikkhunī Janapadakalyāṇī i. g. a-ti. Nandāya ",
  "thi-ap25:56.1": "theriyā apadānaṃ samattaṃ. "
}
