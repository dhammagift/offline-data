  "thi-ap14:1.1": "Nagare Haṃsavatiyā ",
  "thi-ap14:1.2": "ahosiṃ mālikā tadā / ",
  "thi-ap14:1.3": "mātā ca me pitā c' eva ",
  "thi-ap14:1.4": "kammantaṃ agamaṃsu te. // // ",
  "thi-ap14:2.1": "Majjhantikamhi suriye ",
  "thi-ap14:2.2": "addasaṃ samaṇaṃ ahaṃ / ",
  "thi-ap14:2.3": "vīthiyā anugacchantaṃ ",
  "thi-ap14:2.4": "āsanaṃ paññapes' ahaṃ. // // ",
  "thi-ap14:3.1": "Gonakāvikatikāhi ",
  "thi-ap14:3.2": "paññapetvā hav' āsanaṃ / ",
  "thi-ap14:3.3": "pasannacittā sumanā ",
  "thi-ap14:3.4": "imaṃ vacanam abruviṃ: // // ",
  "thi-ap14:4.1": "\"Santattā kaṭhitā bhūmi ",
  "thi-ap14:4.2": "sūro majjhantike ṭhito / ",
  "thi-ap14:4.3": "mālutā ca na vāyanti ",
  "thi-ap14:4.4": "kālo c' ev' attham eti taṃ. // // ",
  "thi-ap14:5.1": "Paññattaṃ āsanam idaṃ ",
  "thi-ap14:5.2": "tavatthāya mahumune / ",
  "thi-ap14:5.3": "anukampaṃ upādāya ",
  "thi-ap14:5.4": "nisīda mama āsane\". // // ",
  "thi-ap14:6.1": "Nisīdi tattha samaṇo ",
  "thi-ap14:6.2": "sudanto suddhamānaso / ",
  "thi-ap14:6.3": "tassa pattaṃ gahetvāna ",
  "thi-ap14:6.4": "yathārandhaṃ adās' ahaṃ. // // ",
  "thi-ap14:7.1": "Tena kammena sukatena ",
  "thi-ap14:7.2": "cetanāpaṇidhīhi ca / ",
  "thi-ap14:7.3": "jāhitvā mānusaṃ dehaṃ ",
  "thi-ap14:7.4": "Tāvatiṃsaṃ agacch' ahaṃ // // ",
  "thi-ap14:8.1": "Tattha me sukataṃ vyamhaṃ ",
  "thi-ap14:8.2": "āsanena sunimmitaṃ / ",
  "thi-ap14:8.3": "saṭṭhiyojanam ubbiddhaṃ ",
  "thi-ap14:8.4": "tiṃsayojanavitthataṃ. // // ",
  "thi-ap14:9.1": "Suvaṇṇamayā maṇimayā ",
  "thi-ap14:9.2": "atho pi phalikāmayā / ",
  "thi-ap14:9.3": "lohitaṅkamayā c' eva ",
  "thi-ap14:9.4": "pallaṅkā vividhā mama. // // ",
  "thi-ap14:10.1": "Tūlikāvikatikāhi ",
  "thi-ap14:10.2": "kaṭṭhissāvikatikāhi ca / ",
  "thi-ap14:10.3": "uddhaṃ-ekantalomī ca ",
  "thi-ap14:10.4": "pallaṅko me susanthato. // // ",
  "thi-ap14:11.1": "Yadā icchāmi gamanaṃ ",
  "thi-ap14:11.2": "hāsakhiḍḍasamappitaṃ / ",
  "thi-ap14:11.3": "saha pallaṅkaseṭṭhena ",
  "thi-ap14:11.4": "gacchāmi mama patthitaṃ. // // ",
  "thi-ap14:12.1": "Asītidevarājānaṃ ",
  "thi-ap14:12.2": "mahesittaṃ *akārayiṃ / ",
  "thi-ap14:12.3": "sattati*cakkavattīnaṃ ",
  "thi-ap14:12.4": "mahesittaṃ akārayiṃ. // // ",
  "thi-ap14:13.1": "Bhavābhave saṃsarantī ",
  "thi-ap14:13.2": "mahābhogaṃ labhām' ahaṃ / ",
  "thi-ap14:13.3": "bhoge me ūnatā n' atthi ",
  "thi-ap14:13.4": "ekāsanaphalaṃ idaṃ. // // ",
  "thi-ap14:14.1": "Duve bhave saṃsarāmi ",
  "thi-ap14:14.2": "devatte atha mānuse / ",
  "thi-ap14:14.3": "aññe bhave na jānāmi ",
  "thi-ap14:14.4": "ekāsanaphalaṃ idaṃ. // // ",
  "thi-ap14:15.1": "Duve kule pajāyāmi ",
  "thi-ap14:15.2": "khattiye cāpi brāhmaṇe / ",
  "thi-ap14:15.3": "uccākulikā sabbattha ",
  "thi-ap14:15.4": "ekāsanaphalaṃ idaṃ. // // ",
  "thi-ap14:16.1": "Domanassaṃ na jānāmi ",
  "thi-ap14:16.2": "cittasantāpanaṃ mama / ",
  "thi-ap14:16.3": "vevaṇṇiyaṃ na jānāmi ",
  "thi-ap14:16.4": "ekāsanaphalaṃ idaṃ. // // ",
  "thi-ap14:17.1": "Dhātiyo maṃ upaṭṭhanti ",
  "thi-ap14:17.2": "khujjā celāvikā bahū / ",
  "thi-ap14:17.3": "aṅkena aṅkaṃ gacchāmi ",
  "thi-ap14:17.4": "ekāsanaphalaṃ idaṃ. // // ",
  "thi-ap14:18.1": "Aññe nahāpenti bhojenti ",
  "thi-ap14:18.2": "aññe rāmenti maṃ sadā / ",
  "thi-ap14:18.3": "aññe gandhaṃ vilimpanti ",
  "thi-ap14:18.4": "ekāsanaphalaṃ idaṃ. // // ",
  "thi-ap14:19.1": "Maṇḍape rukkhamūle vā ",
  "thi-ap14:19.2": "suññāgāre vasantiyā / ",
  "thi-ap14:19.3": "mama saṅkappam aññāya ",
  "thi-ap14:19.4": "pallaṅko upatiṭṭhati. // // ",
  "thi-ap14:20.1": "Ayaṃ pacchimako mayhaṃ ",
  "thi-ap14:20.2": "carimo vattate bhavo / ",
  "thi-ap14:20.3": "ajjāpi rajjaṃ chaḍḍetvā ",
  "thi-ap14:20.4": "pabbajiṃ anagāriyaṃ. // // ",
  "thi-ap14:21.1": "Satasahasse ito kappe ",
  "thi-ap14:21.2": "yaṃ dānam adadiṃ tadā / ",
  "thi-ap14:21.3": "duggatiṃ nābhijānāmi ",
  "thi-ap14:21.4": "ekāsanaphalaṃ idaṃ. // // ",
  "thi-ap14:22.1": "Kilesā . . . ",
  "thi-ap14:22.2": "pe . . . ",
  "thi-ap14:22.3": "",
  "thi-ap14:23.1": "",
  "thi-ap14:23.2": "pe . . . ",
  "thi-ap14:23.3": "pe . . . // // Sāgataṃ . . . pe . . . pe . . . pe . . . // // ",
  "thi-ap14:24.1": "Paṭisambhidā . . . ",
  "thi-ap14:24.2": "pe . . . ",
  "thi-ap14:24.3": "pe . . . pe . . . // // ",
  "thi-ap14:25.1": "Itthaṃ sudaṃ āyasmā Ekāsanadāyikā bhikkhunī i. g. a-ti. Ekāsanadāyikāya ",
  "thi-ap14:26.1": "theriyā apadānaṃ samattaṃ. "
}
