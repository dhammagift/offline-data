  "thi-ap36:0.3": "",
  "thi-ap36:1.1": "kappe ",
  "thi-ap36:1.2": "Vipassī nāma nāyako / ",
  "thi-ap36:1.3": "uppajji cārunayano ",
  "thi-ap36:1.4": "sabbadhammesu cakkhumā. // // ",
  "thi-ap36:2.1": "Tadā 'haṃ Bandhumatiyaṃ ",
  "thi-ap36:2.2": "iddhe phīte mahākule / ",
  "thi-ap36:2.3": "jātā surūpadassitā sajanassā ",
  "thi-ap36:2.4": "'janassa ca. // // ",
  "thi-ap36:3.1": "Upagantvā mahāvīraṃ ",
  "thi-ap36:3.2": "Vipassī-lokanāyakaṃ / ",
  "thi-ap36:3.3": "dhammaṃ suṇitvā saraṇaṃ ",
  "thi-ap36:3.4": "upesiṃ naranāyakaṃ // // ",
  "thi-ap36:4.1": "Sīlesu saṃvutā hutvā ",
  "thi-ap36:4.2": "nibbute ca naruttame / ",
  "thi-ap36:4.3": "dhātu-thūpassa upari ",
  "thi-ap36:4.4": "soṇṇachattaṃ apūjayiṃ. // // ",
  "thi-ap36:5.1": "Muttacāgā sīlavatī ",
  "thi-ap36:5.2": "yāvajīvaṃ tato cutā / ",
  "thi-ap36:5.3": "jahitvā mānusaṃ dehaṃ ",
  "thi-ap36:5.4": "Tāvatiṃsaṃ agacch' ahaṃ // // ",
  "thi-ap36:6.1": "Tadā dasahi ṭhānehi ",
  "thi-ap36:6.2": "abhibhotvāna sesake / ",
  "thi-ap36:6.3": "rūpasaddehi gandhehi ",
  "thi-ap36:6.4": "rasehi phusanehi ca, // // ",
  "thi-ap36:7.1": "Ayunāpi ca vaṇṇena ",
  "thi-ap36:7.2": "sukhena yasasāpi ca / ",
  "thi-ap36:7.3": "tath' ev' ādhipateyyena ",
  "thi-ap36:7.4": "adhigayha viroc' ahaṃ. // // ",
  "thi-ap36:8.1": "Pacchime ca bhave dāni ",
  "thi-ap36:8.2": "jātā 'haṃ Kapilavhaye / ",
  "thi-ap36:8.3": "dhītā Khemaka-Sakkassa ",
  "thi-ap36:8.4": "Nandā *nāmo ti* vissutā. // // ",
  "thi-ap36:9.1": "Abhirūpaṃ uppādaṃ ",
  "thi-ap36:9.2": "āhu m' ekan ti sūcakaṃ / yadā 'haṃ yobbanaṃ pattā rūpavaṇṇavibhusitā. // // Idaṃ me-m' ",
  "thi-ap36:9.3": "",
  "thi-ap36:9.4": "atthe ",
  "thi-ap36:10.1": "Sakyānaṃ ",
  "thi-ap36:10.2": "vivādo *su-mahā* ahu / ",
  "thi-ap36:10.3": "pabbājesi tato tāto: ",
  "thi-ap36:10.4": "mā Sakyā vinassuṃ iti. // // ",
  "thi-ap36:11.1": "Pabbajitvā tathā c' ",
  "thi-ap36:11.2": "āhaṃ rūpadassiṃ naruttamaṃ / ",
  "thi-ap36:11.3": "sutvāna nopagacchāmi ",
  "thi-ap36:11.4": "mama rūpena gabbitā. // // ",
  "thi-ap36:12.1": "Ovādaṃ *pi na gacchāmi* ",
  "thi-ap36:12.2": "Buddhadassanabhīrukā / ",
  "thi-ap36:12.3": "tadā jino upāyena ",
  "thi-ap36:12.4": "upanetvā sa-santikaṃ. // // Tisso ",
  "thi-ap36:13.1": "thiyo nidassesi ",
  "thi-ap36:13.2": "iddhiyā maggakovido / ",
  "thi-ap36:13.3": "accharā rūpasadisā ",
  "thi-ap36:13.4": "taruṇī jaritā matā. // // ",
  "thi-ap36:14.1": "Tayo disvā susaṃviggā ",
  "thi-ap36:14.2": "virattāse kalebare / ",
  "thi-ap36:14.3": "aṭṭhāsi bhavanibbiṇṇā, ",
  "thi-ap36:14.4": "tadā maṃ āha nāyako: // // ",
  "thi-ap36:15.1": "Āturaṃ asuciṃ pūtiṃ ",
  "thi-ap36:15.2": "passa Nande samussayaṃ / ",
  "thi-ap36:15.3": "uggharantaṃ paggharantaṃ ",
  "thi-ap36:15.4": "bālānaṃ abhipatthitaṃ. // // ",
  "thi-ap36:16.1": "Asubhāya cittaṃ bhāvehi ",
  "thi-ap36:16.2": "ekaggaṃ susamāhitaṃ / ",
  "thi-ap36:16.3": "yathā idaṃ tathā etaṃ, ",
  "thi-ap36:16.4": "yathā etaṃ tathā idaṃ. // // ",
  "thi-ap36:17.1": "Evam etaṃ avekkhantī ",
  "thi-ap36:17.2": "rattindivam atanditā / ",
  "thi-ap36:17.3": "tato sakāya paññāya ",
  "thi-ap36:17.4": "abhinibbijja vacchasi. // // ",
  "thi-ap36:18.1": "Tassā me appamattāya ",
  "thi-ap36:18.2": "vicinant' idha yoniso / ",
  "thi-ap36:18.3": "yathābhūtam ayaṃ kāyo ",
  "thi-ap36:18.4": "diṭṭho santarabāhiro. // // ",
  "thi-ap36:19.1": "Atha nibbind' ahaṃ kāye ",
  "thi-ap36:19.2": "ajjhattañ ca virajj' ahaṃ / ",
  "thi-ap36:19.3": "appamattā visaṃyuttā ",
  "thi-ap36:19.4": "upasant' amhi nibbutā. // // ",
  "thi-ap36:20.1": "Iddhīsu ca vasī homi ",
  "thi-ap36:20.2": "dibbāya sotadhatuyā / ",
  "thi-ap36:20.3": "cetopariyañāṇassa ",
  "thi-ap36:20.4": "vasī homi tadā muni. // // ",
  "thi-ap36:21.1": "Pubbenivāsaṃ jānāmi ",
  "thi-ap36:21.2": "dibbacakkhuṃ visodhitaṃ / ",
  "thi-ap36:21.3": "sabbāsavā parikkhīṇā ",
  "thi-ap36:21.4": "n' atthi dāni punabbhavo. // // ",
  "thi-ap36:22.1": "Atthadhammaniruttīsu ",
  "thi-ap36:22.2": "paṭibhāne tath' eva ca / ",
  "thi-ap36:22.3": "ñāṇaṃ mama mahāvīra ",
  "thi-ap36:22.4": "uppannaṃ tava santike. // // ",
  "thi-ap36:23.1": "Kilesā . . . ",
  "thi-ap36:23.2": "pe . . . ",
  "thi-ap36:23.3": "",
  "thi-ap36:24.1": "",
  "thi-ap36:24.2": "pe . . . ",
  "thi-ap36:24.3": "pe . . . // // Sāgataṃ . . . pe . . . pe . . . pe . . . // // ",
  "thi-ap36:25.1": "Paṭisambhidā . . . ",
  "thi-ap36:25.2": "pe . . . ",
  "thi-ap36:25.3": "pe . . . pe . . . // // ",
  "thi-ap36:26.1": "Itthaṃ sudaṃ Abhirūpanandā bhikkhunī i. g. a-ti. *Abhirūpanandā bhikkhuniyā apadānaṃ samattaṃ.* ",
  "thi-ap36:27.1": ""
}
