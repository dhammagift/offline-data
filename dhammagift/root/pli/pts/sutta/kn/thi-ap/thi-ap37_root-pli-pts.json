  "thi-ap37:1.1": "Imamhi bhaddake kappe ",
  "thi-ap37:1.2": "brahmabandhu mahāyaso / ",
  "thi-ap37:1.3": "Kassapo nāma nāmena ",
  "thi-ap37:1.4": "uppajji vadataṃ varo. // // ",
  "thi-ap37:2.1": "Tadā 'haṃ pabbajitvāna ",
  "thi-ap37:2.2": "tassa Buddhassa sāsane / ",
  "thi-ap37:2.3": "saṃvutā pātimokkhamhi ",
  "thi-ap37:2.4": "indriyesu ca pañcasu. // // ",
  "thi-ap37:3.1": "Mattaññū nīca-āsane ",
  "thi-ap37:3.2": "yuttā jāgariyesu ca / ",
  "thi-ap37:3.3": "vasantī yuttayogā 'haṃ. ",
  "thi-ap37:3.4": "Bhikkhuniṃ vigatāsavaṃ // // ",
  "thi-ap37:4.1": "Akkosiṃ duṭṭhacittā 'haṃ ",
  "thi-ap37:4.2": "\"gaṇike\" ti sakiṃ tadā / ",
  "thi-ap37:4.3": "tena pāpena kammena ",
  "thi-ap37:4.4": "nirayamhi apaccisaṃ. // // ",
  "thi-ap37:5.1": "Ten' eva kammasesena ",
  "thi-ap37:5.2": "ajāyiṃ gaṇikākule / ",
  "thi-ap37:5.3": "bahuso 'va 'parādhitā, ",
  "thi-ap37:5.4": "pacchimāya ca jātiyaṃ // // ",
  "thi-ap37:6.1": "Kāsīsu seṭṭhikule jātā ",
  "thi-ap37:6.2": "brahmacariyaphalen ahaṃ / ",
  "thi-ap37:6.3": "accharā viya devesu ",
  "thi-ap37:6.4": "ahosiṃ rūpasampadā. // // ",
  "thi-ap37:7.1": "Disvā 'tidassanīyañ maṃ ",
  "thi-ap37:7.2": "Giribbaja-ppuruttame / ",
  "thi-ap37:7.3": "gaṇikatte nivesiṃsu ",
  "thi-ap37:7.4": "akkosanaphalena me. // // ",
  "thi-ap37:8.1": "Sāhaṃ sutvāna saddhammam ",
  "thi-ap37:8.2": "Buddhaseṭṭhena desitaṃ / ",
  "thi-ap37:8.3": "pubbavāsanasampannā ",
  "thi-ap37:8.4": "pabbajiṃ anagāriyaṃ. // // ",
  "thi-ap37:9.1": "Tadā 'pasampadatthāya ",
  "thi-ap37:9.2": "gacchan taṃ jinasantikaṃ / ",
  "thi-ap37:9.3": "magge dhutte ṭhite disvā, ",
  "thi-ap37:9.4": "labhiṃ dūto 'pasampadaṃ // // Sabbaṃ ",
  "thi-ap37:10.1": "kammaṃ parikkhīṇaṃ ",
  "thi-ap37:10.2": "puññapāpaṃ tath' eva ca / ",
  "thi-ap37:10.3": "sabbasaṃsāraṃ uttiṇṇā ",
  "thi-ap37:10.4": "gaṇikattañ ca khepitaṃ. // // ",
  "thi-ap37:11.1": "Iddhīsu ca vasī homi ",
  "thi-ap37:11.2": "dibbāya sotadhātuyā / ",
  "thi-ap37:11.3": "cetopariyañāṇassa ",
  "thi-ap37:11.4": "vasī homi mahāmune. // // ",
  "thi-ap37:12.1": "Pubbenivāsaṃ jānāmi ",
  "thi-ap37:12.2": "dibbacakkhuṃ visodhitaṃ / ",
  "thi-ap37:12.3": "sabbāsavā parikkhīṇā ",
  "thi-ap37:12.4": "n' atthi dāni punabbhavo. // // ",
  "thi-ap37:13.1": "Atthadhammaniruttīsu ",
  "thi-ap37:13.2": "paṭibhāne tath' eva ca / ",
  "thi-ap37:13.3": "ñāṇaṃ mama mahāvīra ",
  "thi-ap37:13.4": "uppannaṃ tava santike. // // ",
  "thi-ap37:14.1": "Kilesā . . . ",
  "thi-ap37:14.2": "pe . . . ",
  "thi-ap37:14.3": "",
  "thi-ap37:15.1": "",
  "thi-ap37:15.2": "pe . . . ",
  "thi-ap37:15.3": "pe . . . // // Sāgataṃ . . . pe . . . pe . . . pe . . . // // ",
  "thi-ap37:16.1": "Paṭisambhidā . . . ",
  "thi-ap37:16.2": "pe . . . ",
  "thi-ap37:16.3": "pe . . . pe . . . // // ",
  "thi-ap37:17.1": "Itthaṃ sudaṃ Aḍḍhakāsikā bhikkhunī i. g. a-ti. *Aḍḍhakāsikāya bhikkhuniyā apadānaṃ samattaṃ.* ",
  "thi-ap37:18.1": ""
}
