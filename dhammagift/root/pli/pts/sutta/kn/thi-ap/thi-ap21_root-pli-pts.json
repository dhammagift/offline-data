  "thi-ap21:0.3": "",
  "thi-ap21:1.1": "Padumuttaro nāma jino ",
  "thi-ap21:1.2": "sabbadhammāna pāragū / ",
  "thi-ap21:1.3": "ito satasahassamhi ",
  "thi-ap21:1.4": "kappe uppajji nāyako. // // ",
  "thi-ap21:2.1": "Tadā 'haṃ Haṃsavatiyaṃ ",
  "thi-ap21:2.2": "jātā seṭṭhikule ahuṃ / ",
  "thi-ap21:2.3": "nānāratanapajjote ",
  "thi-ap21:2.4": "mahāsukhasamappitā. // // ",
  "thi-ap21:3.1": "Upetvā taṃ mahāvīraṃ ",
  "thi-ap21:3.2": "as*sosiṃ dhammadesanaṃ / ",
  "thi-ap21:3.3": "tato jāta*ppasādāhaṃ ",
  "thi-ap21:3.4": "upesiṃ saraṇaṃ jinaṃ. // // ",
  "thi-ap21:4.1": "Tadā mahākāruṇiko ",
  "thi-ap21:4.2": "Padumuttaranāyako / khippābhiññānam ",
  "thi-ap21:4.3": "aggatte ",
  "thi-ap21:4.4": "ṭhapesi bhikkhuniṃ subhaṃ. // // ",
  "thi-ap21:5.1": "Taṃ sutvā muditā hutvā ",
  "thi-ap21:5.2": "*dānaṃ datvā mahesino / ",
  "thi-ap21:5.3": "nipacca* sirasā *pāde* ",
  "thi-ap21:5.4": "taṃ ṭhānaṃ abhipatthayiṃ. // // ",
  "thi-ap21:6.1": "Anumodi mahāvīro: ",
  "thi-ap21:6.2": "\"bhadde yan te 'bhipatthitaṃ / ",
  "thi-ap21:6.3": "samijjhissati taṃ sabbaṃ, ",
  "thi-ap21:6.4": "sukhinī hohi nibbutā. // // ",
  "thi-ap21:7.1": "Satasahasse ito kappe ",
  "thi-ap21:7.2": "*Okkākakulasambhavo* / ",
  "thi-ap21:7.3": "Gotamo nāma nāmena ",
  "thi-ap21:7.4": "satthā loke bhavissati. // // ",
  "thi-ap21:8.1": "Tassa dhammesu dāyādā ",
  "thi-ap21:8.2": "orasā dhammanimmitā / ",
  "thi-ap21:8.3": "Bhaddākuṇḍalakesā ti ",
  "thi-ap21:8.4": "hessati satthu sāvikā\". // // ",
  "thi-ap21:9.1": "Tena kammena sukatena ",
  "thi-ap21:9.2": "cetanāpaṇidhīhi ca / ",
  "thi-ap21:9.3": "jahitvā mānusaṃ dehaṃ ",
  "thi-ap21:9.4": "Tāvatiṃsaṃ agacch' ahaṃ. // // ",
  "thi-ap21:10.1": "Tato cutā Yāmam agaṃ ",
  "thi-ap21:10.2": "tato 'haṃ Tusitaṃ gatā / ",
  "thi-ap21:10.3": "tato ca Nimmānaratiṃ ",
  "thi-ap21:10.4": "Vasavattipuran tato. // // ",
  "thi-ap21:11.1": "Yatthayatthūpapajjāmi ",
  "thi-ap21:11.2": "tassa kammassa vāhasā / ",
  "thi-ap21:11.3": "tattha tatth' eva *rājūnaṃ ",
  "thi-ap21:11.4": "mahesittaṃ akārayiṃ.* // // ",
  "thi-ap21:12.1": "Tato cutā manussesu ",
  "thi-ap21:12.2": "rājūnaṃ cakkavattīnaṃ / ",
  "thi-ap21:12.3": "maṇḍalīnañ ca rājūnaṃ ",
  "thi-ap21:12.4": "mahesittam akārayiṃ. // // ",
  "thi-ap21:13.1": "Sampattiṃ anubhotvāna ",
  "thi-ap21:13.2": "devesu manujesu ca / ",
  "thi-ap21:13.3": "sabbattha sukhitā hutvā ",
  "thi-ap21:13.4": "'nekakappesu saṃsariṃ. // // ",
  "thi-ap21:14.1": "*Imamhi bhaddake kappe* ",
  "thi-ap21:14.2": "brahmabandhu mahāyaso / ",
  "thi-ap21:14.3": "Kassapo nāma nāmena ",
  "thi-ap21:14.4": "uppajji vadataṃ varo. // // ",
  "thi-ap21:15.1": "Upaṭṭhāko mahesissa ",
  "thi-ap21:15.2": "tadā āsi narissaro / ",
  "thi-ap21:15.3": "Kāsirājā Kikī nāma ",
  "thi-ap21:15.4": "Bārāṇasīpuruttame. // // ",
  "thi-ap21:16.1": "Tassa dhītā catutth' āsiṃ *Bhikkhadāyī ",
  "thi-ap21:16.2": "ti vissutā / ",
  "thi-ap21:16.3": "dhammaṃ* sutvā jinaggassa ",
  "thi-ap21:16.4": "pabbajjaṃ samarocayiṃ. // // ",
  "thi-ap21:17.1": "Anujāni na no tāto ",
  "thi-ap21:17.2": "agāre 'va tadā mayaṃ / ",
  "thi-ap21:17.3": "vīsaṃvassasahassāni ",
  "thi-ap21:17.4": "vicarimhā atanditā. // // ",
  "thi-ap21:18.1": "Komārabrahmacariyaṃ ",
  "thi-ap21:18.2": "rājakaññā sukheṭhitā / ",
  "thi-ap21:18.3": "Buddhopaṭṭhānaniratā * ",
  "thi-ap21:18.4": "muditā sattadhītaro. // // ",
  "thi-ap21:19.1": "Samaṇī Samaṇaguttā ca* ",
  "thi-ap21:19.2": "Bhikkhunī Bhikkhadāyikā / ",
  "thi-ap21:19.3": "Dhammā c' eva Sudhammā ca ",
  "thi-ap21:19.4": "sattamī Saṅghadāyikā. // // ",
  "thi-ap21:20.1": "Khemā Uppalavaṇṇā ca ",
  "thi-ap21:20.2": "Paṭācārā c' ahan tathā / ",
  "thi-ap21:20.3": "Kisāgotamī Dhammadinnā ",
  "thi-ap21:20.4": "Visākhā hoti sattamī. // // ",
  "thi-ap21:21.1": "Tehi kammehi sukatehi ",
  "thi-ap21:21.2": "cetanāpaṇidhīhi ca / ",
  "thi-ap21:21.3": "jahitvā manusaṃ dehaṃ ",
  "thi-ap21:21.4": "Tāvatiṃsaṃ agacch' ahaṃ. // // ",
  "thi-ap21:22.1": "Pacchime ca bhave dāni ",
  "thi-ap21:22.2": "Giribbajapuruttame / ",
  "thi-ap21:22.3": "jātā seṭṭhikule phīte, ",
  "thi-ap21:22.4": "yadā 'haṃ yobbane ṭhitā // // ",
  "thi-ap21:23.1": "Coraṃ vadhatthaṃ niyyantaṃ ",
  "thi-ap21:23.2": "disvā rattā tahiṃ ahaṃ / ",
  "thi-ap21:23.3": "pitā me taṃ sahassena ",
  "thi-ap21:23.4": "*mocayitvā vadhā tato. // // ",
  "thi-ap21:24.1": "Adāsi* tassa maṃ tato ",
  "thi-ap21:24.2": "viditvāna manaṃ mama / ",
  "thi-ap21:24.3": "tassāhaṃ āsi vissatthā ",
  "thi-ap21:24.4": "atīva dayitā hitā. // // ",
  "thi-ap21:25.1": "So me bhūsanalobhena ",
  "thi-ap21:25.2": "mālapaccāhaṭaṃ diso / ",
  "thi-ap21:25.3": "corappapātaṃ netvāna ",
  "thi-ap21:25.4": "pabbataṃ ceta*yi vadhaṃ. // // ",
  "thi-ap21:26.1": "Tadā 'haṃ paṇamitvāna* ",
  "thi-ap21:26.2": "Sattukaṃ sukatañjalī / ",
  "thi-ap21:26.3": "rakkhantī attano pāṇaṃ ",
  "thi-ap21:26.4": "imaṃ vacanam abraviṃ: // // ",
  "thi-ap21:27.1": "Idaṃ suvaṇṇakeyūraṃ ",
  "thi-ap21:27.2": "muttā veḷuriyā bahū / ",
  "thi-ap21:27.3": "saccaṃ harassu bhaddante ",
  "thi-ap21:27.4": "mañcadāsi ti sāvaya // // ",
  "thi-ap21:28.1": "*Oropayassu kalyāṇi ",
  "thi-ap21:28.2": "mā* bahuṃ paridevayi / ",
  "thi-ap21:28.3": "na cāhaṃ abhijānāmi ",
  "thi-ap21:28.4": "ahantvā dhanam ābhataṃ. // // ",
  "thi-ap21:29.1": "Yato sarāmi attānaṃ ",
  "thi-ap21:29.2": "yato patto 'smi viññutaṃ / ",
  "thi-ap21:29.3": "na cāhaṃ abhijānāmi ",
  "thi-ap21:29.4": "aññaṃ piyataraṃ tayā. // // ",
  "thi-ap21:30.1": "*Ehi taṃ upagūhissam ",
  "thi-ap21:30.2": "katvāna taṃ* padakkhiṇaṃ / ",
  "thi-ap21:30.3": "na ca dāni puno atthi ",
  "thi-ap21:30.4": "mama tuyhañ ca saṅgamo. // // ",
  "thi-ap21:31.1": "Na hi sabbesu ṭhānesu ",
  "thi-ap21:31.2": "puriso hoti paṇḍito / ",
  "thi-ap21:31.3": "itthī pi paṇḍitā hoti ",
  "thi-ap21:31.4": "tattha tattha vicakkhaṇā. // // ",
  "thi-ap21:32.1": "Na hi *sabbesu ṭhānesu ",
  "thi-ap21:32.2": "puriso ho*ti paṇḍito / ",
  "thi-ap21:32.3": "itthī pi paṇḍitā hoti ",
  "thi-ap21:32.4": "lahuṃ atthavicintikā. // // ",
  "thi-ap21:33.1": "Lahuñ ca vata khippañ ca ",
  "thi-ap21:33.2": "nikaṭṭhe samacetayiṃ / ",
  "thi-ap21:33.3": "migaṃ puṇṇāyaten' eva ",
  "thi-ap21:33.4": "tadā 'haṃ Sattukaṃ vadhiṃ. // // ",
  "thi-ap21:34.1": "Yo ca uppatitaṃ atthaṃ ",
  "thi-ap21:34.2": "na khippam anubujjhati / ",
  "thi-ap21:34.3": "*so haññate mandamati ",
  "thi-ap21:34.4": "coro 'va* girigabbhare. // // ",
  "thi-ap21:35.1": "Yo ca uppattitaṃ atthaṃ ",
  "thi-ap21:35.2": "khippam eva nibodhati / ",
  "thi-ap21:35.3": "muccate sattusambādhā ",
  "thi-ap21:35.4": "tadā 'haṃ Sattukā yathā // // ",
  "thi-ap21:36.1": "Tadā taṃ pātayitvāna ",
  "thi-ap21:36.2": "giriduggamhi Sattukaṃ / ",
  "thi-ap21:36.3": "santikaṃ setavatthānaṃ ",
  "thi-ap21:36.4": "upetvā pabba*jiṃ ahaṃ. // // ",
  "thi-ap21:37.1": "Saṇḍāsena ca kesam me* ",
  "thi-ap21:37.2": "luñcitvā sabbaso tadā / ",
  "thi-ap21:37.3": "pabbājetvā sa-samayaṃ ",
  "thi-ap21:37.4": "ācikkhiṃsu nirantaraṃ. // // ",
  "thi-ap21:38.1": "Tato taṃ uggahetvāna ",
  "thi-ap21:38.2": "nisīditvāna ekikā / ",
  "thi-ap21:38.3": "samayan taṃ vicintemi, ",
  "thi-ap21:38.4": "suvāṇā mānusaṃ karaṃ // // ",
  "thi-ap21:39.1": "Chinnaṃ gay*ha samīpe me ",
  "thi-ap21:39.2": "pātayitvā a*pakkami / ",
  "thi-ap21:39.3": "disvā nimittaṃ alabhiṃ ",
  "thi-ap21:39.4": "hatthaṃ taṃ puḷavākulaṃ. // // ",
  "thi-ap21:40.1": "*Ta*to uṭṭhāya *samviggā* ",
  "thi-ap21:40.2": "apucchiṃ sahadhammike / ",
  "thi-ap21:40.3": "te avocuṃ: ‘vijānanti ",
  "thi-ap21:40.4": "taṃ atthaṃ Sakyabhikkhavo.' // // ",
  "thi-ap21:41.1": "Sāhaṃ tam atthaṃ pucchissaṃ ",
  "thi-ap21:41.2": "upetvā Buddhasāvake / ",
  "thi-ap21:41.3": "te mam ādāya gañchīsu ",
  "thi-ap21:41.4": "Buddha*seṭṭha*ssa santikaṃ. // // ",
  "thi-ap21:42.1": "So me dhammam adesesi ",
  "thi-ap21:42.2": "khandhāyatanadhātuyo / ",
  "thi-ap21:42.3": "asubhāniccadukkhā ti ",
  "thi-ap21:42.4": "anattā ti ca nāyako. // // ",
  "thi-ap21:43.1": "Tassa dhammaṃ suṇitvā 'haṃ ",
  "thi-ap21:43.2": "dhammacakkhuṃ visodhayiṃ / ",
  "thi-ap21:43.3": "tato viññātasaddhammā ",
  "thi-ap21:43.4": "pabbajjaṃ upasampadaṃ // // ",
  "thi-ap21:44.1": "Āyāciṃ. So tadā āha ",
  "thi-ap21:44.2": "\"ehi Bhadde\" ti nāyako / ",
  "thi-ap21:44.3": "tadā 'haṃ upasampannā ",
  "thi-ap21:44.4": "parittaṃ toyam addasaṃ // // ",
  "thi-ap21:45.1": "Pādapakkhālanenāhaṃ ",
  "thi-ap21:45.2": "ñatvā sa-udayaṃvyayaṃ / ",
  "thi-ap21:45.3": "‘tathā sabbe pi saṅkhārā' ",
  "thi-ap21:45.4": "iti sañcintayiṃ tadā. // // ",
  "thi-ap21:46.1": "Tato cittaṃ vimuttam me ",
  "thi-ap21:46.2": "anupādāya sabbaso / ",
  "thi-ap21:46.3": "khippābhiññānam aggam me ",
  "thi-ap21:46.4": "tadā paññāpayī jino. // // ",
  "thi-ap21:47.1": "Iddhīsu ca vasī homi ",
  "thi-ap21:47.2": "dibbāya sotadhātuyā / ",
  "thi-ap21:47.3": "paracittāni jānāmi ",
  "thi-ap21:47.4": "satthu sāsanakārikā. // // ",
  "thi-ap21:48.1": "Pubbenivāsaṃ jānāmi ",
  "thi-ap21:48.2": "dibbacakkhuṃ visodhitaṃ / ",
  "thi-ap21:48.3": "khepetvā āsave sabbe ",
  "thi-ap21:48.4": "visuddh' āsiṃ sunimmalā. // // ",
  "thi-ap21:49.1": "Pariciṇṇo maya satthā ",
  "thi-ap21:49.2": "kataṃ Buddhassa sāsanaṃ / ",
  "thi-ap21:49.3": "ohito garuko bhāro ",
  "thi-ap21:49.4": "bhavanetti samūhatā. // // ",
  "thi-ap21:50.1": "Yassa c' atthāya pabbajjitā ",
  "thi-ap21:50.2": "agārasmā 'nagāriyaṃ / ",
  "thi-ap21:50.3": "so me attho anuppatto ",
  "thi-ap21:50.4": "sabbasaṃyojanakkhayo. // // ",
  "thi-ap21:51.1": "Atthadhammaniruttīsu ",
  "thi-ap21:51.2": "paṭibhāne tath' eva ca / ",
  "thi-ap21:51.3": "ñāṇam me vimalaṃ suddhaṃ ",
  "thi-ap21:51.4": "Buddhaseṭṭhassa vāhasā. // // ",
  "thi-ap21:52.1": "Kilesā . . . pe . . . ",
  "thi-ap21:52.2": "pe . . . ",
  "thi-ap21:52.3": "pe . . . // // ",
  "thi-ap21:52.4": "Sāgataṃ . . . ",
  "thi-ap21:53.1": "pe . . . ",
  "thi-ap21:53.2": "pe . . . ",
  "thi-ap21:53.3": "pe . . . // // ",
  "thi-ap21:53.4": "",
  "thi-ap21:54.1": "Paṭisambhidā . . . pe . . . ",
  "thi-ap21:54.2": "pe . . . ",
  "thi-ap21:54.3": "",
  "thi-ap21:54.4": "pe . . . // // ",
  "thi-ap21:55.1": "Itthaṃ sudaṃ Bhaddākuṇḍalakesā bhikkhunī i. g. a-ti. Kuṇḍalakesāya bhikkhuniyā apadānaṃ samattaṃ. ",
  "thi-ap21:56.1": ""
}
