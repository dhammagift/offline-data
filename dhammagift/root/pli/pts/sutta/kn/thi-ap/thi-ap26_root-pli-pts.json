  "thi-ap26:1.1": "Padumuttaro nāma jino ",
  "thi-ap26:1.2": "sabbadhammāna pāragū / ",
  "thi-ap26:1.3": "ito satasahassamhi ",
  "thi-ap26:1.4": "kappe uppajji nāyako. // // ",
  "thi-ap26:2.1": "Tadā 'haṃ seṭṭhikule jātā ",
  "thi-ap26:2.2": "sukhitā sajjitā piyā / ",
  "thi-ap26:2.3": "upetvā taṃ munivaraṃ ",
  "thi-ap26:2.4": "assosiṃ madhuraṃ vacaṃ. // // ",
  "thi-ap26:3.1": "Āraddhaviriyān' aggaṃ ",
  "thi-ap26:3.2": "vaṇṇentaṃ bhikkhuniṃ jinaṃ / ",
  "thi-ap26:3.3": "taṃ sutvā muditā hutvā ",
  "thi-ap26:3.4": "kāraṃ katvāna satthuno. // // ",
  "thi-ap26:4.1": "Abhivādiya sambuddhaṃ taṃ ",
  "thi-ap26:4.2": "ṭhānaṃ patthayiṃ tadā / ",
  "thi-ap26:4.3": "anumodi mahāvīro: ",
  "thi-ap26:4.4": "\"sijjhataṃ panidhī tava. // // ",
  "thi-ap26:5.1": "Satasahasse ito kappe ",
  "thi-ap26:5.2": "Okkākakulasambhavo / ",
  "thi-ap26:5.3": "Gotamo nāma nāmena ",
  "thi-ap26:5.4": "satthā loke bhavissati. // // ",
  "thi-ap26:6.1": "Tassa dhammesu dāyādā ",
  "thi-ap26:6.2": "orasā dhammanimmitā / ",
  "thi-ap26:6.3": "Sonā ti nāma nāmena ",
  "thi-ap26:6.4": "hessati satthu sāvikā\". // // ",
  "thi-ap26:7.1": "Taṃ sutvā muditā hutvā ",
  "thi-ap26:7.2": "yāvajīvaṃ tadā jinaṃ / ",
  "thi-ap26:7.3": "mettacittā paricariṃ ",
  "thi-ap26:7.4": "paccayehi vināyakaṃ. // // ",
  "thi-ap26:8.1": "Tena kammena sukatena ",
  "thi-ap26:8.2": "cetanāpaṇidhīhi ca / ",
  "thi-ap26:8.3": "jahitvā mānusaṃ dehaṃ ",
  "thi-ap26:8.4": "Tāvatiṃsaṃ agacch' ahaṃ // // ",
  "thi-ap26:9.1": "Pacchime ca bhave dāni ",
  "thi-ap26:9.2": "jātā seṭṭhikule ahaṃ / ",
  "thi-ap26:9.3": "Sāvatthiyaṃ puravare ",
  "thi-ap26:9.4": "iddhe phīte mahaddhane. // // ",
  "thi-ap26:10.1": "Yadā ca yobbanaṃ pattā ",
  "thi-ap26:10.2": "gantvā patikulaṃ ahaṃ / ",
  "thi-ap26:10.3": "dasa puttāni ajaniṃ ",
  "thi-ap26:10.4": "surūpāni visesato. // // ",
  "thi-ap26:11.1": "Sukheṭhitā ca te sabbe ",
  "thi-ap26:11.2": "jananettamanoharā / ",
  "thi-ap26:11.3": "amittānam pi rucitā ",
  "thi-ap26:11.4": "mamaṃ pāgeva te piyā. // // ",
  "thi-ap26:12.1": "Tato mayhaṃ akāmāya ",
  "thi-ap26:12.2": "dasaputtapurakkhato / ",
  "thi-ap26:12.3": "pabbajittha sa me bhattā ",
  "thi-ap26:12.4": "devadevassa sāsane. // // ",
  "thi-ap26:13.1": "Tad ekikā vicintesiṃ: ",
  "thi-ap26:13.2": "jīvitenālam atthu me / ",
  "thi-ap26:13.3": "jīnāya patiputtehi ",
  "thi-ap26:13.4": "vuḍḍhāya ca varākiyā. // // ",
  "thi-ap26:14.1": "Aham pi tattha gañchissaṃ ",
  "thi-ap26:14.2": "pasuto yattha me pati. / ",
  "thi-ap26:14.3": "Evāhaṃ cintayitvāna ",
  "thi-ap26:14.4": "pabbajiṃ anagāriyaṃ. // // ",
  "thi-ap26:15.1": "Tato ca maṃ bhikkhuniyo ",
  "thi-ap26:15.2": "ekaṃ bhikkhunupassaye / ",
  "thi-ap26:15.3": "vihāya gañchu ovādaṃ ",
  "thi-ap26:15.4": "\"tāpehi udakaṃ\" iti. // // ",
  "thi-ap26:16.1": "Tadā udakam āhatvā ",
  "thi-ap26:16.2": "okiritvāna kumbhiyā / ",
  "thi-ap26:16.3": "culle ṭhapetvā āsīnā ",
  "thi-ap26:16.4": "tato cittaṃ samādahiṃ. // // ",
  "thi-ap26:17.1": "Khandhe aniccato disvā ",
  "thi-ap26:17.2": "dukkhato ca anattato / ",
  "thi-ap26:17.3": "khepetva āsave sabbe ",
  "thi-ap26:17.4": "arahattaṃ apāpuṇiṃ. // // ",
  "thi-ap26:18.1": "Tadā 'gantvā bhikkhuniyo ",
  "thi-ap26:18.2": "uṇhodakam apucchisu / ",
  "thi-ap26:18.3": "tejodhātuṃ adhiṭṭhāya ",
  "thi-ap26:18.4": "khippaṃ santāpayiṃ jalaṃ. // // ",
  "thi-ap26:19.1": "Vimhitā tā jinavaraṃ ",
  "thi-ap26:19.2": "etam atthaṃ va sāvayuṃ, / ",
  "thi-ap26:19.3": "taṃ sutvā mudito nātho ",
  "thi-ap26:19.4": "imā gāthā abhāsatha: // // ",
  "thi-ap26:20.1": "\"Yo ca vassasataṃ jīve ",
  "thi-ap26:20.2": "kusīto hīnavīriyo / ",
  "thi-ap26:20.3": "ekāhaṃ jīvitaṃ seyyo ",
  "thi-ap26:20.4": "viriyaṃ ārabhato daḷhaṃ\". // // ",
  "thi-ap26:21.1": "Ārādhito mahāvīro ",
  "thi-ap26:21.2": "mayā suppaṭipattiyā / ",
  "thi-ap26:21.3": "āraddhaviriyān' aggaṃ ",
  "thi-ap26:21.4": "mam āha sa mahāmuni. // // ",
  "thi-ap26:22.1": "Kilesā . . . ",
  "thi-ap26:22.2": "pe . . . ",
  "thi-ap26:22.3": "",
  "thi-ap26:23.1": "",
  "thi-ap26:23.2": "pe . . . ",
  "thi-ap26:23.3": "pe . . . // // Sāgaṭaṃ . . . pe . . . pe . . . pe . . . // // ",
  "thi-ap26:24.1": "Paṭisambhidā . . . ",
  "thi-ap26:24.2": "pe . . . ",
  "thi-ap26:24.3": "pe . . . pe . . . // // ",
  "thi-ap26:25.1": "Itthaṃ sudaṃ Sonā-bhikkhunī i. g. a-ti. Sonā- theriyā apadānaṃ samattaṃ. ",
  "thi-ap26:26.1": ""
}
