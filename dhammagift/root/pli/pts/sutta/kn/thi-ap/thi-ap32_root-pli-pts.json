{
  "thi-ap32:0.1": "",
  "thi-ap32:0.2": "",
  "thi-ap32:0.3": "",
  "thi-ap32:1.1": "",
  "thi-ap32:1.2": "brahmaññākulasambhavā / ",
  "thi-ap32:1.3": "sukhumālahattha*pā*dā ",
  "thi-ap32:1.4": "pure tuyhaṃ mahāmuni. // // ",
  "thi-ap32:2.1": "Vessa-sudda-kule jātā ",
  "thi-ap32:2.2": "devā nāgā ca kinnarā / ",
  "thi-ap32:2.3": "cātuddīpā bahū kaññā ",
  "thi-ap32:2.4": "pure tuyhaṃ mahāmuni. // // ",
  "thi-ap32:3.1": "Keci pabbajitā atthi ",
  "thi-ap32:3.2": "saccadassāvino bahū / ",
  "thi-ap32:3.3": "devā ca kinnarā nāgā ",
  "thi-ap32:3.4": "phusissanti anāgate. // // ",
  "thi-ap32:4.1": "Anubhotvā yasaṃ sabbaṃ ",
  "thi-ap32:4.2": "patvāna sabbasampadā / ",
  "thi-ap32:4.3": "tvayi pasādaṃ paṭiladdhā ",
  "thi-ap32:4.4": "bujjhissanti anāgate. // // ",
  "thi-ap32:5.1": "Amhe brāhmaṇadhītā tu ",
  "thi-ap32:5.2": "brahmaññākulasambhavā / ",
  "thi-ap32:5.3": "pekkhato no mahāvīra ",
  "thi-ap32:5.4": "pāde vandāma cakkhumā. // // ",
  "thi-ap32:6.1": "Upāgatā bhavā sabbe ",
  "thi-ap32:6.2": "mūlataṇhā samūhatā / ",
  "thi-ap32:6.3": "samucchinnā anusayā ",
  "thi-ap32:6.4": "puññasaṅkhāradālitā. // // ",
  "thi-ap32:7.1": "Samādhigocarā sabbā ",
  "thi-ap32:7.2": "samāpattī *va* sī tathā / ",
  "thi-ap32:7.3": "jhānena dhammaratiyā ",
  "thi-ap32:7.4": "viharissāma no sadā. // // ",
  "thi-ap32:8.1": "Bhavanetti avijjā ca ",
  "thi-ap32:8.2": "saṅkhārā pi ca khepitā / ",
  "thi-ap32:8.3": "sududdasaṃ padaṃ gantvā ",
  "thi-ap32:8.4": "anujānimha nāyaka. // // ",
  "thi-ap32:9.1": "Upakārā mayaṃ tumhe ",
  "thi-ap32:9.2": "dīgharattaṃ katāvino / ",
  "thi-ap32:9.3": "bahunnaṃ saṃsayaṃ chetvā ",
  "thi-ap32:9.4": "sabbā gacchatha nibbutiṃ // // ",
  "thi-ap32:10.1": "Vanditvā munino pāde ",
  "thi-ap32:10.2": "katvā iddhivikubbanaṃ / ",
  "thi-ap32:10.3": "keci dassenti ālokaṃ ",
  "thi-ap32:10.4": "andhakāraṃ tathāparaṃ. // // ",
  "thi-ap32:11.1": "Dassenti candasuriye ",
  "thi-ap32:11.2": "sāgarañ ca samacchakaṃ / ",
  "thi-ap32:11.3": "Sineruṃ paribhaṇḍañ ca ",
  "thi-ap32:11.4": "dassenti pāricchattakaṃ. // // ",
  "thi-ap32:12.1": "Tāvatiṃsañ ca bhavanaṃ ",
  "thi-ap32:12.2": "Yāmaṃ dassenti iddhiyā / ",
  "thi-ap32:12.3": "Tusitā-Nimmitā-devā ",
  "thi-ap32:12.4": "Vasavatti-mahissarā. // // ",
  "thi-ap32:13.1": "Brahmāno keci dassenti ",
  "thi-ap32:13.2": "caṅkamaṃ *ca mahārahaṃ / ",
  "thi-ap32:13.3": "brahmavaṇṇañ ca*māpetvā ",
  "thi-ap32:13.4": "dhammaṃ desenti suññataṃ. // // ",
  "thi-ap32:14.1": "Nānāvikubbanaṃ katvā ",
  "thi-ap32:14.2": "iddhiṃ dassetvā satthuno / ",
  "thi-ap32:14.3": "dassayiṃsu balaṃ sabbā ",
  "thi-ap32:14.4": "pāde vandiṃsu satthuno. // // ",
  "thi-ap32:15.1": "Iddhisu ca vasī homa ",
  "thi-ap32:15.2": "dibbāya sotadhātuyā / ",
  "thi-ap32:15.3": "cetopariyañāṇassa ",
  "thi-ap32:15.4": "vasī homa mahāmune. // // ",
  "thi-ap32:16.1": "Pubbenivāsaṃ jānāma ",
  "thi-ap32:16.2": "dibbacakkhuṃ visodhitaṃ / ",
  "thi-ap32:16.3": "sabbāsavā parikkhīṇā ",
  "thi-ap32:16.4": "n' atthi dāni punabbhavo. // // ",
  "thi-ap32:17.1": "Atthadhammaniruttīsu ",
  "thi-ap32:17.2": "paṭibhāne tath' eva ca / ",
  "thi-ap32:17.3": "ñāṇaṃ amhaṃ mahāvīra ",
  "thi-ap32:17.4": "uppannaṃ tava santike. // // ",
  "thi-ap32:18.1": "Pubbānaṃ lokanāthānaṃ ",
  "thi-ap32:18.2": "saṅgaman tehi dassitaṃ / ",
  "thi-ap32:18.3": "adhikārā bahū amhe ",
  "thi-ap32:18.4": "tuyh' atthāya mahāmuni. // // ",
  "thi-ap32:19.1": "Yaṃ amhaṃ purimaṃ kammaṃ ",
  "thi-ap32:19.2": "kusalaṃ, sara taṃ muni / ",
  "thi-ap32:19.3": "tuyh' atthāya mahāvīra ",
  "thi-ap32:19.4": "puññāni 'pacitāni no // // ",
  "thi-ap32:20.1": "Satasahasse ito kappe ",
  "thi-ap32:20.2": "Padumuttaro mahāmuni / ",
  "thi-ap32:20.3": "puraṃ Haṃsavatī nāma ",
  "thi-ap32:20.4": "sambuddhassa kulāsayaṃ. // // ",
  "thi-ap32:21.1": "Dvārena Haṃsavatiyā ",
  "thi-ap32:21.2": "Gaṅgā sandati sabbadā / ",
  "thi-ap32:21.3": "Uddā*lana*diyā bhikkhū ",
  "thi-ap32:21.4": "gamanaṃ na labhanti te. // // ",
  "thi-ap32:22.1": "Divasaṃ dve tayo c' eva ",
  "thi-ap32:22.2": "sattā*haṃ* māsikaṃ tato / ",
  "thi-ap32:22.3": "catumāsam pi sampuṇṇaṃ ",
  "thi-ap32:22.4": "gamanaṃ na labhanti te. // // ",
  "thi-ap32:23.1": "Tadā ahu sattasāro ",
  "thi-ap32:23.2": "jaṭilo nāma raṭṭhiko / ",
  "thi-ap32:23.3": "oruddhe bhikkhavo disvā ",
  "thi-ap32:23.4": "setuno satta kārayi. // // Sataṃsahassehi ",
  "thi-ap32:24.1": "tadā ",
  "thi-ap32:24.2": "setuṃ Gaṅgāya kārayiṃ / ",
  "thi-ap32:24.3": "saṅghassa orime tīre ",
  "thi-ap32:24.4": "vihārañ ca akārayiṃ. // // ",
  "thi-ap32:25.1": "Itthiyo purisā c' eva ",
  "thi-ap32:25.2": "uccā-nīcakulāni ca / ",
  "thi-ap32:25.3": "tassa setū vihāre ca ",
  "thi-ap32:25.4": "samabhāgaṃ akaṃsu te. // // ",
  "thi-ap32:26.1": "Amhe aññe ca manujā ",
  "thi-ap32:26.2": "vippasannena cetasā / ",
  "thi-ap32:26.3": "tassa kammesu dāyādā ",
  "thi-ap32:26.4": "nagare janapadesu ca // // ",
  "thi-ap32:27.1": "Itthi-pumā kumārā ca ",
  "thi-ap32:27.2": "bahū c' eva kumārikā / ",
  "thi-ap32:27.3": "setuno ca vihārassa ",
  "thi-ap32:27.4": "vālukā ākiriṃsu te. // // ",
  "thi-ap32:28.1": "Vīthisammajjanaṃ katvā ",
  "thi-ap32:28.2": "kadalīpuṇṇakuṭaddhajā / ",
  "thi-ap32:28.3": "dhūmacuṇṇañ ca mālañ ca ",
  "thi-ap32:28.4": "sakkāraṃ katvā satthuno // // ",
  "thi-ap32:29.1": "Setū vihāre kāretvā ",
  "thi-ap32:29.2": "nimantetvā vināyakaṃ / ",
  "thi-ap32:29.3": "mahādānaṃ daditvāna ",
  "thi-ap32:29.4": "sambodhiṃ abhipatthayiṃ. // // ",
  "thi-ap32:30.1": "Padumuttaro mahāvīro ",
  "thi-ap32:30.2": "tārako sabbapāṇinaṃ / ",
  "thi-ap32:30.3": "anumodanīyaṃ Kāsi- ",
  "thi-ap32:30.4": "jaṭilassa mahāmuni: // // ",
  "thi-ap32:31.1": "Satasahasse atikkante ",
  "thi-ap32:31.2": "kappo hessati bhaddako / ",
  "thi-ap32:31.3": "bhavābhave 'nubhotvāna ",
  "thi-ap32:31.4": "pāpuṇissati bodhiyaṃ. // // ",
  "thi-ap32:32.1": "Keci hatthapadaṃ kammaṃ ",
  "thi-ap32:32.2": "katāvī naranāriyo / ",
  "thi-ap32:32.3": "anāgatasmiṃ addhāne ",
  "thi-ap32:32.4": "sabbe hessanti sammukhā. // // ",
  "thi-ap32:33.1": "Tena kammavipākena ",
  "thi-ap32:33.2": "cetanāpaṇidhīhi ca / ",
  "thi-ap32:33.3": "uppannā devabhavanaṃ ",
  "thi-ap32:33.4": "tuyhaṃ te paricārikā. // // ",
  "thi-ap32:34.1": "Dibbaṃ sukhaṃ asaṃkheyyaṃ ",
  "thi-ap32:34.2": "mānusañ ca asaṃkhiyaṃ / ",
  "thi-ap32:34.3": "tuyhaṃ vo paricāre ca ",
  "thi-ap32:34.4": "saṃsaritvā bhavābhave. // // ",
  "thi-ap32:35.1": "Satasahasse ito kappe ",
  "thi-ap32:35.2": "sukataṃ kammasampadaṃ / ",
  "thi-ap32:35.3": "sukhumālī manussānaṃ ",
  "thi-ap32:35.4": "atho devapure vare // // ",
  "thi-ap32:36.1": "Rūpabhogā yasañ c' eva ",
  "thi-ap32:36.2": "atho kittita-sakkatā / ",
  "thi-ap32:36.3": "labhāma satataṃ sabbaṃ ",
  "thi-ap32:36.4": "sukataṃ kammasampadaṃ. // // ",
  "thi-ap32:37.1": "Pacchime bhavasampatte ajātā ",
  "thi-ap32:37.2": "brāhmaṇe kule / ",
  "thi-ap32:37.3": "sukhumālā-hatthapādā ",
  "thi-ap32:37.4": "Sakyaputtanivesane. // // ",
  "thi-ap32:38.1": "Sabbakālam pi puthaviṃ ",
  "thi-ap32:38.2": "na passāma n' alaṅkataṃ / cikkhallabhūmiṃ ",
  "thi-ap32:38.3": "gamanaṃ ",
  "thi-ap32:38.4": "na passāma mahāmune. // // ",
  "thi-ap32:39.1": "Agāre vasante amhe ",
  "thi-ap32:39.2": "sakkāraṃ sabbakālikaṃ / ",
  "thi-ap32:39.3": "upanenti sadā sabbaṃ ",
  "thi-ap32:39.4": "pubbakammaphalaṃ tato. // // ",
  "thi-ap32:40.1": "Agāraṃ pajahitvāna ",
  "thi-ap32:40.2": "pabbajitvā 'nagāriyaṃ / saṃsārapathanittiṇṇā n' ",
  "thi-ap32:40.3": "atthi ",
  "thi-ap32:40.4": "dāni punabbhavo // // ",
  "thi-ap32:41.1": "Cīvaraṃ piṇḍapātañ ca ",
  "thi-ap32:41.2": "paccayaṃ sayanāsanaṃ / ",
  "thi-ap32:41.3": "upanenti sadā mahe ",
  "thi-ap32:41.4": "sahassāni tato tato. // // ",
  "thi-ap32:42.1": "Kilesā . . . ",
  "thi-ap32:42.2": "pe . . . ",
  "thi-ap32:42.3": "",
  "thi-ap32:43.1": "",
  "thi-ap32:43.2": "pe . . . ",
  "thi-ap32:43.3": "pe . . . // // Sāgataṃ . . . pe . . . pe . . . pe . . . // // ",
  "thi-ap32:44.1": "Paṭisambhidā . . . ",
  "thi-ap32:44.2": "pe . . . ",
  "thi-ap32:44.3": "pe . . . pe . . . // // Caturāsītiṃ ",
  "thi-ap32:45.1": "brāhmaṇakaññā bhikkhunī sahassāni bhagavato sammukhāya imā gāthāyo abhāsiṃsu ti. *Caturāsīti ",
  "thi-ap32:46.1": "brāhmaṇakaññānaṃ bhikkhunīnaṃ sahassānaṃ apadānaṃ samattaṃ.* "
}
