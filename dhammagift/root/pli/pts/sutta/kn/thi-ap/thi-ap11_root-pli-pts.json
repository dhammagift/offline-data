  "thi-ap11:0.3": "",
  "thi-ap11:1.1": "",
  "thi-ap11:1.2": "Bandhumā nāma khattiyo / ",
  "thi-ap11:1.3": "divase puṇṇamāyaṃ so ",
  "thi-ap11:1.4": "upapajji uposathaṃ. // // ",
  "thi-ap11:2.1": "Ahaṃtena samayena ",
  "thi-ap11:2.2": "kumbhadāsī ahuṃ tahiṃ / ",
  "thi-ap11:2.3": "disvā sarājikaṃ senaṃ ",
  "thi-ap11:2.4": "evāhaṃ cintayiṃ tadā: // // ",
  "thi-ap11:3.1": "Rājāpi rajjaṃ chaḍḍetvā ",
  "thi-ap11:3.2": "upapajji uposathaṃ / ",
  "thi-ap11:3.3": "saphalaṃ nūna taṃ kammaṃ ",
  "thi-ap11:3.4": "janakāyo pamodito. // // ",
  "thi-ap11:4.1": "Yonisopaccavekkhitvā ",
  "thi-ap11:4.2": "duggaccañ ca daḷiddataṃ / ",
  "thi-ap11:4.3": "manasaṃ sampahaṃsetvā ",
  "thi-ap11:4.4": "upapajjiṃ uposathaṃ. // // ",
  "thi-ap11:5.1": "Ahaṃuposathaṃ katvā ",
  "thi-ap11:5.2": "sammāsambuddhasāsane / ",
  "thi-ap11:5.3": "tena kammena sukatena ",
  "thi-ap11:5.4": "Tāvatiṃsaṃ agacch' ahaṃ. // // ",
  "thi-ap11:6.1": "Tatthame sukataṃ vyamhaṃ ubbhaṃ ",
  "thi-ap11:6.2": "yojanam uggataṃ / ",
  "thi-ap11:6.3": "kūṭāgāravarūpetaṃ ",
  "thi-ap11:6.4": "mahāsayanabhūsitaṃ. // // ",
  "thi-ap11:7.1": "Accharāsatasahassā ",
  "thi-ap11:7.2": "upatiṭṭhanti maṃ sadā / ",
  "thi-ap11:7.3": "aññe deve atikkamma ",
  "thi-ap11:7.4": "atirocāmi sabbadā. // // ",
  "thi-ap11:8.1": "Catusaṭṭhidevarājānaṃ ",
  "thi-ap11:8.2": "mahesittam akārayiṃ / ",
  "thi-ap11:8.3": "tesaṭṭhi cakkavattīnaṃ ",
  "thi-ap11:8.4": "mahesittam akārayiṃ. // // ",
  "thi-ap11:9.1": "Suvaṇṇavaṇṇāhutvāna ",
  "thi-ap11:9.2": "bhavesu saṃsarām' ahaṃ / ",
  "thi-ap11:9.3": "sabbattha pavarā homi; ",
  "thi-ap11:9.4": "uposathass' idaṃ phalaṃ. // // ",
  "thi-ap11:10.1": "Hatthiyānaṃassayānaṃ ",
  "thi-ap11:10.2": "rathayānañ ca kevalaṃ / ",
  "thi-ap11:10.3": "labhāmi sabbam etam hi ",
  "thi-ap11:10.4": "uposathass' idaṃ phalaṃ. // // ",
  "thi-ap11:11.1": "Sovaṇṇamayaṃrūpimayaṃ ",
  "thi-ap11:11.2": "atho pi phalikāmayaṃ / ",
  "thi-ap11:11.3": "lohitaṅkamayañ c' eva ",
  "thi-ap11:11.4": "sabbaṃ paṭilabhām' ahaṃ. // // ",
  "thi-ap11:12.1": "Koseyyakambalīyānikhomakappāsikāni ",
  "thi-ap11:12.2": "ca / ",
  "thi-ap11:12.3": "mahagghāni ca vatthāni ",
  "thi-ap11:12.4": "sabbaṃ paṭilabhām' ahaṃ. // // ",
  "thi-ap11:13.1": "Annaṃpānaṃ khādaniyaṃ ",
  "thi-ap11:13.2": "vatthasenāsanāni ca / ",
  "thi-ap11:13.3": "sabbam etaṃ paṭilabhe; ",
  "thi-ap11:13.4": "uposathass' idaṃ phalaṃ. // // ",
  "thi-ap11:14.1": "Varagandhañca mālañ ca ",
  "thi-ap11:14.2": "cuṇṇakañ ca vilepanaṃ / ",
  "thi-ap11:14.3": "sabbam etaṃ paṭilabhe, ",
  "thi-ap11:14.4": "uposathass' idaṃ phalaṃ. // // ",
  "thi-ap11:15.1": "Kūṭāgārañca pāsādaṃ ",
  "thi-ap11:15.2": "maṇḍapaṃ hammiyaṃ guhaṃ / ",
  "thi-ap11:15.3": "sabbam etaṃ paṭilabhe, ",
  "thi-ap11:15.4": "uposathass' idaṃ phalaṃ. // // ",
  "thi-ap11:16.1": "Jātiyāsattavass āhaṃ ",
  "thi-ap11:16.2": "pabbajiṃ anagāriyaṃ / ",
  "thi-ap11:16.3": "aṭṭhamāse asampatte ",
  "thi-ap11:16.4": "arahattaṃ apāpuṇiṃ. // // ",
  "thi-ap11:17.1": "Kilesā. . . pe . . . pe . . . ",
  "thi-ap11:17.2": "pe . . . / ",
  "thi-ap11:17.3": "sabbāsavā parikkhīṇā ",
  "thi-ap11:17.4": "n' atthi dāni punabbhavo. // // ",
  "thi-ap11:18.1": "Ekanavuteito kappe ",
  "thi-ap11:18.2": "yaṃ kammam akariṃ tadā / ",
  "thi-ap11:18.3": "duggatiṃ nābhijānāmi ",
  "thi-ap11:18.4": "uposathass' idaṃ phalaṃ. // // ",
  "thi-ap11:19.1": "Sāgataṃ. . . ",
  "thi-ap11:19.2": "pe . . . ",
  "thi-ap11:19.3": "",
  "thi-ap11:20.1": "",
  "thi-ap11:20.2": "pe . . . ",
  "thi-ap11:20.3": "pe . . . // // ",
  "thi-ap11:21.1": "Paṭisambhidā. . . ",
  "thi-ap11:21.2": "pe . . . ",
  "thi-ap11:21.3": "pe . . . pe . . . // // ",
  "thi-ap11:22.1": "Itthaṃ sudaṃ Ekūposathikā bhikkhunī i. g. a-ti. Ekūposathikāya theriyā ",
  "thi-ap11:23.1": "apadānaṃ samattaṃ. Candabhāgānadītīreahosiṃ "
}
