{
  "thi-ap1:0.1": "",
  "thi-ap1:0.2": "",
  "thi-ap1:0.3": "",
  "thi-ap1:1.1": "Namo tassa bhagavato arahato sammāsambuddhassa. ",
  "thi-ap1:2.1": "",
  "thi-ap1:3.1": "BhagavatiKoṇāgamane ",
  "thi-ap1:3.2": "saṅghārāmamhi navanivesamhi / ",
  "thi-ap1:3.3": "sakhiyo tīṇi janiyo ",
  "thi-ap1:3.4": "vihāradānaṃ adāsimha. // // ",
  "thi-ap1:4.1": "Dasakkhattuṃsatakkhattuṃ ",
  "thi-ap1:4.2": "satānaṃ ca satakkhattuṃ / ",
  "thi-ap1:4.3": "devesu upapajjimha. ",
  "thi-ap1:4.4": "Ko vādo mānuse bhave // // ",
  "thi-ap1:5.1": "Devesumahiddhikā ahumhā ",
  "thi-ap1:5.2": "manussakamhi ko vādo / ",
  "thi-ap1:5.3": "sattaratanassa mahesī ",
  "thi-ap1:5.4": "itthiratanaṃ ahaṃ bhaviṃ. // // ",
  "thi-ap1:6.1": "Idhasañcitā kusalaṃ ",
  "thi-ap1:6.2": "susamiddhakulappajā / ",
  "thi-ap1:6.3": "Dhanañjānī ca Khemā ca ",
  "thi-ap1:6.4": "ahaṃ pi ca tayo janā. // // ",
  "thi-ap1:7.1": "Ārāmaṃsukataṃ katvā ",
  "thi-ap1:7.2": "sabbāvayavamaṇḍitaṃ / ",
  "thi-ap1:7.3": "Buddhapamukkhasaṅghassa ",
  "thi-ap1:7.4": "niyyādetvā pamoditā. // // ",
  "thi-ap1:8.1": "Yatthayatthūpapajjāmi ",
  "thi-ap1:8.2": "tassa kammassa vahasā / ",
  "thi-ap1:8.3": "devesu aggataṃ pattā ",
  "thi-ap1:8.4": "manussesu tath' eva ca. // // ",
  "thi-ap1:9.1": "Imasmiṃyeva kappamhi ",
  "thi-ap1:9.2": "brahmabandhu mahāyaso / ",
  "thi-ap1:9.3": "Kassapo nāma nāmena ",
  "thi-ap1:9.4": "uppajji vadataṃ varo. // // ",
  "thi-ap1:10.1": "Upaṭṭhākomahesissa ",
  "thi-ap1:10.2": "tadā āsi narissaro / ",
  "thi-ap1:10.3": "Kāsirājā Kikī nāma ",
  "thi-ap1:10.4": "Bārāṇasipuruttame. // // ",
  "thi-ap1:11.1": "Tassāsuṃsatta dhītaro ",
  "thi-ap1:11.2": "rājakaññā sukheṭhitā / ",
  "thi-ap1:11.3": "Buddhopaṭṭhānaniratā ",
  "thi-ap1:11.4": "brahmacariyaṃ cariṃsu tā. // // ",
  "thi-ap1:12.1": "Tāsaṃsahāyikā hutvā ",
  "thi-ap1:12.2": "sīlesu susamāhitā / ",
  "thi-ap1:12.3": "datvā dānāni sakkaccaṃ ",
  "thi-ap1:12.4": "agāre va vataṃ cariṃ. // // ",
  "thi-ap1:13.1": "Tenakammena sukatena ",
  "thi-ap1:13.2": "cetanāpaṇidhīhi ca / ",
  "thi-ap1:13.3": "jahitvā mānusaṃ dehaṃ ",
  "thi-ap1:13.4": "Tāvatiṃsūpagā ahaṃ. // // Tatocutā Yāmam agaṃ ",
  "thi-ap1:14.1": "tato 'haṃ ",
  "thi-ap1:14.2": "Tusitaṃ gatā / ",
  "thi-ap1:14.3": "tato ca Nimmānaratiṃ ",
  "thi-ap1:14.4": "Vāsavattipuraṃ tato. // // ",
  "thi-ap1:15.1": "Yatthayatth' ūpapajjāmi ",
  "thi-ap1:15.2": "puññakammasamāhitā / ",
  "thi-ap1:15.3": "tattha tatth' eva rājūnaṃ ",
  "thi-ap1:15.4": "mahesittaṃ akārayiṃ. // // ",
  "thi-ap1:16.1": "Tatocutā manussatte ",
  "thi-ap1:16.2": "rājūnaṃ cakkavattinaṃ / ",
  "thi-ap1:16.3": "maṇḍalīnañ ca rājūnaṃ ",
  "thi-ap1:16.4": "mahesittaṃ akārayiṃ. // // ",
  "thi-ap1:17.1": "Sampattimanubhotvāna ",
  "thi-ap1:17.2": "devesu mānusesu ca / ",
  "thi-ap1:17.3": "sabbattha sukhitā hutvā ",
  "thi-ap1:17.4": "nekajātīsu saṃsariṃ. // // ",
  "thi-ap1:18.1": "Sohetu so pabhavo ",
  "thi-ap1:18.2": "taṃ mūlaṃ sā ca sāsane khanti / ",
  "thi-ap1:18.3": "taṃ paṭhamasamodhānaṃ ",
  "thi-ap1:18.4": "taṃ dhammaratāya nibbānaṃ. // // ",
  "thi-ap1:19.1": "Kilesājhāpitā mayhaṃ ",
  "thi-ap1:19.2": "bhavā sabbe samūhatā / ",
  "thi-ap1:19.3": "nāgī va bandhanaṃ chetvā ",
  "thi-ap1:19.4": "viharāmi anāsavā. // // ",
  "thi-ap1:20.1": "Sāgataṃvata me āsi ",
  "thi-ap1:20.2": "mama Buddhassa santike / ",
  "thi-ap1:20.3": "tisso vijjā anuppattā ",
  "thi-ap1:20.4": "kataṃ Buddhassa sāsanaṃ. // // ",
  "thi-ap1:21.1": "Paṭisambhidācatasso ",
  "thi-ap1:21.2": "vimokkhā pi ca aṭṭh' ime // // ",
  "thi-ap1:21.3": "chaḍabhiññā sacchikatā ",
  "thi-ap1:21.4": "kataṃ Buddhassa sāsanaṃ ti. ",
  "thi-ap1:22.1": "Itthaṃ sudaṃ āyasmā Sumedhā bhikkhunī imā gāthāyo abhāsitthā ti. ",
  "thi-ap1:23.1": "Siddhatthassabhagavato thūpaṃ kārāpitā ahaṃ / "
}
