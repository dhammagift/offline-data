{
  "thi-ap17:0.1": "",
  "thi-ap17:0.2": "",
  "thi-ap17:0.3": "",
  "thi-ap17:1.1": "Ekadā Lokapajjoto ",
  "thi-ap17:1.2": "Vesāliyaṃ *Mahāvane* / ",
  "thi-ap17:1.3": "kuṭāgāresu sālāyaṃ ",
  "thi-ap17:1.4": "vasate narasārathi. // // ",
  "thi-ap17:2.1": "Tadā jinassa mātucchā ",
  "thi-ap17:2.2": "Mahāgotami bhikkhunī / ",
  "thi-ap17:2.3": "tahiṃ setapure ramme ",
  "thi-ap17:2.4": "vasi bhikkhunupassaye / ",
  "thi-ap17:3.1": "*bhikkhunīhi vimu*ttāhi ",
  "thi-ap17:3.2": "satehi sahapañcahi. // // ",
  "thi-ap17:3.3": "Rahogatāya tass' evaṃ cittass' ",
  "thi-ap17:3.4": "āsi vitakkitaṃ: / ",
  "thi-ap17:4.1": "\"Buddhassa parinibbānaṃ ",
  "thi-ap17:4.2": "sāvakaggayugassa vā / ",
  "thi-ap17:4.3": "Rāhul-Ānanda-Nandānaṃ ",
  "thi-ap17:4.4": "nāhaṃ sakkomi passituṃ. // // ",
  "thi-ap17:5.1": "Paṭihacc' ",
  "thi-ap17:5.2": "āyusaṅkhāre ",
  "thi-ap17:5.3": "",
  "thi-ap17:5.4": "ossajitvāna ",
  "thi-ap17:6.1": "",
  "thi-ap17:6.2": "nibbutiṃ / ",
  "thi-ap17:6.3": "gaccheyyaṃ lokanāthena ",
  "thi-ap17:6.4": "anuññātā mahesinā\". // // ",
  "thi-ap17:7.1": "Tathā pañcasatānam pi ",
  "thi-ap17:7.2": "bhikkhunīnaṃ vitakkitaṃ / ",
  "thi-ap17:7.3": "āsi Khemādikānam pi ",
  "thi-ap17:7.4": "etad eva vitakkitaṃ. // // ",
  "thi-ap17:8.1": "Bhūmicālo tadā āsi ",
  "thi-ap17:8.2": "nāditā devadundubhi / ",
  "thi-ap17:8.3": "upassayādhivatthā yā ",
  "thi-ap17:8.4": "devatā sokapīḷitā. / ",
  "thi-ap17:9.1": "vilapantā sakaruṇaṃ ",
  "thi-ap17:9.2": "tatth' assūni pavattayuṃ. // // ",
  "thi-ap17:9.3": "Sabbā bhikkhuniyo tāhi ",
  "thi-ap17:9.4": "upagantvāna Gotamiṃ / ",
  "thi-ap17:10.1": "nipacca sirasā pāde ",
  "thi-ap17:10.2": "idaṃ vacanam abravuṃ: // // ",
  "thi-ap17:10.3": "\"Tattha toyalavāsittā ",
  "thi-ap17:10.4": "mayam ayye rahogatā / ",
  "thi-ap17:11.1": "sācalā calitā bhūmi ",
  "thi-ap17:11.2": "nāditā devadundubhi / ",
  "thi-ap17:11.3": "paridevā va sūyante ",
  "thi-ap17:11.4": "kim atthaṃ nūna Gotami? \" // // ",
  "thi-ap17:12.1": "Tadā avoca sā sabbaṃ ",
  "thi-ap17:12.2": "yathāparivitakkitaṃ / ",
  "thi-ap17:12.3": "tāyo pi sabbā āhaṃsu ",
  "thi-ap17:12.4": "yathāparivitakkitaṃ: // // ",
  "thi-ap17:13.1": "\"Yadi te rucitaṃ ayye ",
  "thi-ap17:13.2": "nibbānaṃ paramaṃ sivaṃ / ",
  "thi-ap17:13.3": "nibbāyissāma sabbā pi ",
  "thi-ap17:13.4": "Buddhānuññāya subbate. // // ",
  "thi-ap17:14.1": "Mayaṃ sahā va nikkhantā ",
  "thi-ap17:14.2": "gharā pi ca bhavā pi ca / ",
  "thi-ap17:14.3": "sahā yeva gamissāma ",
  "thi-ap17:14.4": "nibbānaṃ puram uttamaṃ\". // // ",
  "thi-ap17:15.1": "\"Nibbānāya vajantīnaṃ ",
  "thi-ap17:15.2": "kiṃ vakkhāmī\" ti sā vadi / ",
  "thi-ap17:15.3": "saha sabbāhi niggañchi ",
  "thi-ap17:15.4": "bhikkhunīlayanā tadā. // // ",
  "thi-ap17:16.1": "\"Upassaye yā 'dhivutthā ",
  "thi-ap17:16.2": "devatā tā khamantu me / ",
  "thi-ap17:16.3": "bhikkhunīlayanass' edaṃ ",
  "thi-ap17:16.4": "pacchimaṃ dassanaṃ mama. // // ",
  "thi-ap17:17.1": "Na jarā maccu vā yattha ",
  "thi-ap17:17.2": "appiyehi samāgamo / ",
  "thi-ap17:17.3": "piyehi na viyog' atthi ",
  "thi-ap17:17.4": "taṃ vajissaṃ asaṅkhataṃ\". // // ",
  "thi-ap17:18.1": "Avītarāgā taṃ sutvā ",
  "thi-ap17:18.2": "vacanaṃ sugatorasā / ",
  "thi-ap17:18.3": "sokaṭṭā parideviṃsu: ",
  "thi-ap17:18.4": "\"aho no appapuññatā. // // ",
  "thi-ap17:19.1": "Bhikkhunīnilayo suñño ",
  "thi-ap17:19.2": "bhūto tāhi vinā ayaṃ / ",
  "thi-ap17:19.3": "pabhāte viya tārāyo ",
  "thi-ap17:19.4": "na dissanti jinorasā. // // ",
  "thi-ap17:20.1": "Nibbānaṃ Gotamī yāti ",
  "thi-ap17:20.2": "satehi saha pañcahi / ",
  "thi-ap17:20.3": "nadīsatehi va saha ",
  "thi-ap17:20.4": "Gaṅga pañcahi sāgaraṃ\". // // ",
  "thi-ap17:21.1": "Rathiyāya vajantīnaṃ ",
  "thi-ap17:21.2": "disvā saddhā upāsikā / ",
  "thi-ap17:21.3": "gharā nikkhamma pādesu ",
  "thi-ap17:21.4": "nipacca idam abravuṃ: // // ",
  "thi-ap17:22.1": "\"Pasīdassu mahābhāge ",
  "thi-ap17:22.2": "anāthāyo vihāya no / ",
  "thi-ap17:22.3": "tayā na yuttaṃ nibbātuṃ\" ",
  "thi-ap17:22.4": "icc aṭṭā vilapiṃsu tā. // // ",
  "thi-ap17:23.1": "Tāsaṃ sokapahānatthaṃ ",
  "thi-ap17:23.2": "avoca madhuraṃ giram: / ",
  "thi-ap17:23.3": "\"ruditena alaṃ puttā ",
  "thi-ap17:23.4": "hāsa*kā*lo yaṃ ajja vo; // // ",
  "thi-ap17:24.1": "Pariññātaṃ mayā dukkhaṃ, ",
  "thi-ap17:24.2": "dukkhahetu vivajjito, / ",
  "thi-ap17:24.3": "nirodho me sacchikato, ",
  "thi-ap17:24.4": "maggo cāpi subhāvito, // // ",
  "thi-ap17:25.1": "",
  "thi-ap17:26.1": "Pariciṇṇo mayā satthā, ",
  "thi-ap17:26.2": "kataṃ Buddhassa sāsanaṃ, / ",
  "thi-ap17:26.3": "ohito garuko bhāro, ",
  "thi-ap17:26.4": "bhavanetti samūhatā; // // ",
  "thi-ap17:27.1": "Yassa-v-atthāya pabbajitā ",
  "thi-ap17:27.2": "agārasmā anagāriyaṃ / ",
  "thi-ap17:27.3": "so me attho anuppatto ",
  "thi-ap17:27.4": "sabbasaṃyojanakkhayo; // // ",
  "thi-ap17:28.1": "Buddho tassa ca saddhammo ",
  "thi-ap17:28.2": "anūno yāva tiṭṭhati, / ",
  "thi-ap17:28.3": "nibbātuṃ tāva kālo me, ",
  "thi-ap17:28.4": "mā maṃ socatha puttikā. // // ",
  "thi-ap17:29.1": "Koṇḍaññ'-Ānanda-Nandādi ",
  "thi-ap17:29.2": "tiṭṭhanti Rāhulo jino / ",
  "thi-ap17:29.3": "sukhito sahito saṅgho, ",
  "thi-ap17:29.4": "hatadappā va titthiyā; // // ",
  "thi-ap17:30.1": "Okkākavaṃsassa yaso ",
  "thi-ap17:30.2": "ussito Māramaddano / ",
  "thi-ap17:30.3": "nanu sampati kālo me ",
  "thi-ap17:30.4": "nibbānatthāya puttikā? // // ",
  "thi-ap17:31.1": "Cirappabhuti yaṃ mayhaṃ ",
  "thi-ap17:31.2": "patthitaṃ ajja sijjhate / ",
  "thi-ap17:31.3": "Ānandabherikālo yaṃ ",
  "thi-ap17:31.4": "kim vo assūhi puttikā. // // ",
  "thi-ap17:32.1": "Sace mayi dayā atthi, ",
  "thi-ap17:32.2": "yadi c' atthi kataññutā / ",
  "thi-ap17:32.3": "saddhammaṭṭhitiyā sabbā ",
  "thi-ap17:32.4": "karotha viriyaṃ daḷhaṃ. // // ",
  "thi-ap17:33.1": "Thīnaṃ adāsi pabbajjaṃ ",
  "thi-ap17:33.2": "sambuddho yācito mayā / ",
  "thi-ap17:33.3": "tasmā yathā 'ham uddissa ",
  "thi-ap17:33.4": "tathā tam anutiṭṭhatha\". // // ",
  "thi-ap17:34.1": "Tā evam anusāsitvā ",
  "thi-ap17:34.2": "bhikkhunīhi purakkhatā / ",
  "thi-ap17:34.3": "upecca Buddhaṃ vanditvā ",
  "thi-ap17:34.4": "imaṃ vacanam abravi: // // ",
  "thi-ap17:35.1": "\"Ahaṃ Sugata te mātā ",
  "thi-ap17:35.2": "tvaṃ ca dhīra pitā mama / ",
  "thi-ap17:35.3": "saddhammasukhado nātha, ",
  "thi-ap17:35.4": "tayā jāt' amhi Gotama; // // ",
  "thi-ap17:36.1": "Saṃvaddhito 'yaṃ Sugata ",
  "thi-ap17:36.2": "rūpakāyo mayā tava, / ",
  "thi-ap17:36.3": "anindiyo dhammakāyo ",
  "thi-ap17:36.4": "mama saṃvaddhito tayā; // // ",
  "thi-ap17:37.1": "Muhuttaṃ taṇhāsamanaṃ ",
  "thi-ap17:37.2": "khīraṃ tvaṃ pāyito mayā, / ",
  "thi-ap17:37.3": "tayā 'haṃ santam accantaṃ dhammakhīram ",
  "thi-ap17:37.4": "hi pāyitā; // // ",
  "thi-ap17:38.1": "Vaddhanārakkhane mayhaṃ ",
  "thi-ap17:38.2": "anaṇo tvaṃ mahāmune. / ",
  "thi-ap17:38.3": "puttakāmā thiyo tāva ",
  "thi-ap17:38.4": "labhantaṃ tādisaṃ sutaṃ! // // ",
  "thi-ap17:39.1": "Mandhātādi-narindānaṃ ",
  "thi-ap17:39.2": "yā mātā tā bhavaṇṇave / ",
  "thi-ap17:39.3": "nimuggā 'haṃ tayā putta ",
  "thi-ap17:39.4": "tāritā bhavasāgarā. // // ",
  "thi-ap17:40.1": "Rañño-mātā mahesī ti ",
  "thi-ap17:40.2": "sulabhan nāmam itthinaṃ, / ",
  "thi-ap17:40.3": "Buddhamātā ti yaṃ nāmaṃ ",
  "thi-ap17:40.4": "etam paramadullabhaṃ. // // ",
  "thi-ap17:41.1": "Tañ ca laddham mayā vīra, ",
  "thi-ap17:41.2": "paṇidhānam maman tayā / ",
  "thi-ap17:41.3": "aṇukaṃ vā mahantaṃ vā ",
  "thi-ap17:41.4": "taṃ sabbaṃ pūritam mayā. // // ",
  "thi-ap17:42.1": "Parinibbātum icchāmi ",
  "thi-ap17:42.2": "vihāy' emaṃ kalebaraṃ, / ",
  "thi-ap17:42.3": "anujānāhi me vīra ",
  "thi-ap17:42.4": "dukkhantakara nāyaka. // // ",
  "thi-ap17:43.1": "Cakkaṅkusadhajākiṇṇe ",
  "thi-ap17:43.2": "pāde kamalakomale / ",
  "thi-ap17:43.3": "pasārehi; paṇāman te ",
  "thi-ap17:43.4": "karissaṃ putta pemasā. // // ",
  "thi-ap17:44.1": "Suvaṇṇarāsisaṅkāsaṃ ",
  "thi-ap17:44.2": "sarīraṃ kuru pākaṭaṃ / ",
  "thi-ap17:44.3": "katvā dehaṃ sudiṭṭhan te ",
  "thi-ap17:44.4": "santiṃ gacchāmi nāyaka\". // // ",
  "thi-ap17:45.1": "Dvattiṃsalakkhaṇūpetaṃ ",
  "thi-ap17:45.2": "sappabhālaṅkataṃ tanuṃ / ",
  "thi-ap17:45.3": "sañjhāghanā va bālakkaṃ ",
  "thi-ap17:45.4": "mātucchaṃ dassayi jino. // // ",
  "thi-ap17:46.1": "Phullāravi*ndasaṅ*kāse ",
  "thi-ap17:46.2": "tarunādiccasappabhe / ",
  "thi-ap17:46.3": "cakkaṅki*te pāda*tale ",
  "thi-ap17:46.4": "pāde sā sirasā pati. // // ",
  "thi-ap17:47.1": "\"Paṇamāmi narādiccaṃ ",
  "thi-ap17:47.2": "ādiccakulaketunaṃ / ",
  "thi-ap17:47.3": "pacchime maraṇe mayhaṃ ",
  "thi-ap17:47.4": "na taṃ dakkhām aham puna. // // ",
  "thi-ap17:48.1": "Itthiyo nāma lokagga ",
  "thi-ap17:48.2": "sabbadosākarā *matā* / ",
  "thi-ap17:48.3": "*ya*di koc' atthi doso me ",
  "thi-ap17:48.4": "khamassu karuṇākara. // // ",
  "thi-ap17:49.1": "Itthikānañ ca pabbajjaṃ yaṃ ",
  "thi-ap17:49.2": "'haṃ yāciṃ punappunaṃ / ",
  "thi-ap17:49.3": "tattha ce atthi doso me ",
  "thi-ap17:49.4": "taṃ khamassu narāsabha. // // ",
  "thi-ap17:50.1": "Mayā bhikkhuniyo vīra ",
  "thi-ap17:50.2": "tavānuññāya sāsitā / ",
  "thi-ap17:50.3": "tattha ce atthi dunnītaṃ ",
  "thi-ap17:50.4": "khamassu khamādhipa. // // ",
  "thi-ap17:51.1": "Akkhante nāma khantabbaṃ ",
  "thi-ap17:51.2": "kim bhave guṇabhūsane / ",
  "thi-ap17:51.3": "kim uttaran te vakkhāmi ",
  "thi-ap17:51.4": "nibbānāya vajantiyā. // // ",
  "thi-ap17:52.1": "Suddhe anūne mama bhikkhusaṅghe ",
  "thi-ap17:52.2": "lokā ito nissarituṃ khamante / ",
  "thi-ap17:52.3": "pabhātakāle vyasanaṃ gahānaṃ ",
  "thi-ap17:52.4": "disvāna niyyāti hi candalekhā\". // // ",
  "thi-ap17:53.1": "Tadetarā bhikkhuniyo jinaggaṃ ",
  "thi-ap17:53.2": "tārā va candānugatā Sumeruṃ / ",
  "thi-ap17:53.3": "padakkhiṇaṃ katvā nipacca pāde ",
  "thi-ap17:53.4": "ṭhitā mukhan taṃ samudikkhamānā: // // ",
  "thi-ap17:54.1": "\"Na tittipubban tava dassanena ",
  "thi-ap17:54.2": "cakkhun na sotaṃ tava bhāsitena / ",
  "thi-ap17:54.3": "cittaṃ mamaṃ kevalam ekam eva ",
  "thi-ap17:54.4": "pappuyya taṃ dhammarasena tittiṃ. // // ",
  "thi-ap17:55.1": "Nadato parisāyan te ",
  "thi-ap17:55.2": "vādidappāpabhārino / ",
  "thi-ap17:55.3": "ye te dakkhinti vadanaṃ ",
  "thi-ap17:55.4": "dhaññā te narapuṅgava. // // ",
  "thi-ap17:56.1": "Dīghaṅgulī tambanakhe ",
  "thi-ap17:56.2": "subhe āyatapaṇhike / ",
  "thi-ap17:56.3": "ye pāde paṇamissanti ",
  "thi-ap17:56.4": "te pi dhaññā raṇantaga. // // ",
  "thi-ap17:57.1": "Madhurāni pahaṭṭhāni ",
  "thi-ap17:57.2": "dosaghātīn' hitāni ca / ",
  "thi-ap17:57.3": "ye te vākyāni sussanti ",
  "thi-ap17:57.4": "te pi dhaññā naruttama. // // ",
  "thi-ap17:58.1": "Dhaññā 'han te mahāvīra ",
  "thi-ap17:58.2": "pādapūjanatapparā / ",
  "thi-ap17:58.3": "tiṇṇasaṃsārakantārā ",
  "thi-ap17:58.4": "saddhammena sirimatā\". // // ",
  "thi-ap17:59.1": "Tato sā anusāvetvā ",
  "thi-ap17:59.2": "bhikkhusaṃghamhi subbatā / ",
  "thi-ap17:59.3": "Rahul'-Ānanda-Nande ca ",
  "thi-ap17:59.4": "vanditvā idam abravi: // // ",
  "thi-ap17:60.1": "\"Āsīvisālayasame ",
  "thi-ap17:60.2": "rogāvāse kaḷebare / nibbiṇṇā ",
  "thi-ap17:60.3": "dukkhapaṅke te ",
  "thi-ap17:60.4": "jarāmaraṇagocare // // ",
  "thi-ap17:61.1": "Nānākalala-m-ākiṇṇe, ",
  "thi-ap17:61.2": "parāyatte nirīhake / ",
  "thi-ap17:61.3": "tena nibbātum icchāmi ",
  "thi-ap17:61.4": "anumaññatha puttakā\". // // ",
  "thi-ap17:62.1": "Nando Rāhula-bhaddo ca ",
  "thi-ap17:62.2": "vītasokā nirāsavā / ",
  "thi-ap17:62.3": "ṭhitācaladhitī dhīrā ",
  "thi-ap17:62.4": "dhammatam anucintayuṃ. // // ",
  "thi-ap17:63.1": "\"Dhi-r-atthu saṅkhataṃ lolaṃ ",
  "thi-ap17:63.2": "asāraṃ kadalūpamaṃ / ",
  "thi-ap17:63.3": "māyāmarīcisadisaṃ ",
  "thi-ap17:63.4": "ittaraṃ anavaṭṭhitaṃ. // // ",
  "thi-ap17:64.1": "Yattha nāma jinassāyaṃ ",
  "thi-ap17:64.2": "mātucchā Buddhaposikā / ",
  "thi-ap17:64.3": "Gotamī nidhanaṃ yāti ",
  "thi-ap17:64.4": "aniccaṃ sabbasaṅkhataṃ\". // // ",
  "thi-ap17:65.1": "Ānando ca tadā sekho ",
  "thi-ap17:65.2": "sokaṭṭo jinavacchalo / ",
  "thi-ap17:65.3": "tatth' assūni dharanto so ",
  "thi-ap17:65.4": "karuṇaṃ paridevati: // // ",
  "thi-ap17:66.1": "\"Hāsantī Gotamī yāti, ",
  "thi-ap17:66.2": "nūnaṃ Buddho pi nibbutiṃ / ",
  "thi-ap17:66.3": "gacchati naciren' eva aggi ",
  "thi-ap17:66.4": "viya nirindhano\". // // ",
  "thi-ap17:67.1": "Evaṃ vilapamānan taṃ ",
  "thi-ap17:67.2": "Ānandaṃ āha Go*tamī: / ",
  "thi-ap17:67.3": "\"suti*sāgaragambhīra ",
  "thi-ap17:67.4": "Buddhupaṭṭhānatappara // // ",
  "thi-ap17:68.1": "Na yuttam socitum putta ",
  "thi-ap17:68.2": "hāsakāle upaṭṭhite / ",
  "thi-ap17:68.3": "tayā me saraṇaṃ putta ",
  "thi-ap17:68.4": "nibbānattam upāgataṃ. // // ",
  "thi-ap17:69.1": "Tayā tāta samajjhiṭṭho ",
  "thi-ap17:69.2": "pabbajjaṃ anujāni no / ",
  "thi-ap17:69.3": "mā putta vimano ho*hi ",
  "thi-ap17:69.4": "saphalo* te parissamo. // // ",
  "thi-ap17:70.1": "Yan na diṭṭhaṃ purāṇehi ",
  "thi-ap17:70.2": "titthikācariyehi pi / ",
  "thi-ap17:70.3": "taṃ padaṃ sukumārīhi ",
  "thi-ap17:70.4": "sattavassāhi veditaṃ. // // ",
  "thi-ap17:71.1": "Buddhasāsanapāletā ",
  "thi-ap17:71.2": "pacchimaṃ dassanan tava / ",
  "thi-ap17:71.3": "tattha gacchām' ahaṃ puttagato ",
  "thi-ap17:71.4": "yattha na dissate. // // ",
  "thi-ap17:72.1": "Kadāci dhammaṃ desento ",
  "thi-ap17:72.2": "khipi lokagganāyako / ",
  "thi-ap17:72.3": "tadā 'ham āsīsavacaṃ ",
  "thi-ap17:72.4": "avocaṃ anukampikā: // // ",
  "thi-ap17:73.1": "‘Cirañ jīva mahāvīra ",
  "thi-ap17:73.2": "kappan tiṭṭha mahāmune / ",
  "thi-ap17:73.3": "sabbalokassa atthāya ",
  "thi-ap17:73.4": "bhavassu ajarāmaro,\"' // // ",
  "thi-ap17:74.1": "Taṃ tathāvādinim Buddho ",
  "thi-ap17:74.2": "mamaṃ so etad abravi: / ",
  "thi-ap17:74.3": "\"na h' evaṃ vandiyā Buddhā ",
  "thi-ap17:74.4": "yathā vandasi Gotami\". // // ",
  "thi-ap17:75.1": "\"Kathañ carahi sabbaññu ",
  "thi-ap17:75.2": "vanditabbā Tathāgatā? / ",
  "thi-ap17:75.3": "kathaṃ avandiyā Buddhā? ",
  "thi-ap17:75.4": "Tam me akkhāhi pucchito\". // // ",
  "thi-ap17:76.1": "\"Āraddhaviriye pahitatte ",
  "thi-ap17:76.2": "niccaṃ daḷhaparakkame / ",
  "thi-ap17:76.3": "samagge sāvake passa ",
  "thi-ap17:76.4": "esā Buddhāna vandanā.\" // // ",
  "thi-ap17:77.1": "Tato upassayaṃ gantvā ",
  "thi-ap17:77.2": "ekikāhaṃ vicintayiṃ / ",
  "thi-ap17:77.3": "samaggaparisaṃ nātho ",
  "thi-ap17:77.4": "roceti tibhavantago. // // ",
  "thi-ap17:78.1": "Handāhaṃ parinibbissam ",
  "thi-ap17:78.2": "mā vipattiṃ nam addasaṃ / ",
  "thi-ap17:78.3": "evāhaṃ cintayitvāna ",
  "thi-ap17:78.4": "*disvāna* isisattamaṃ. // // ",
  "thi-ap17:79.1": "Parinibbānakālam me ",
  "thi-ap17:79.2": "ārocesiṃ vināyakaṃ / ",
  "thi-ap17:79.3": "tato so samanuññāsi: ",
  "thi-ap17:79.4": "\"kālaṃ jānāhi Gotami. // // ",
  "thi-ap17:80.1": "Kilesā . . . ",
  "thi-ap17:80.2": "pe . . . ",
  "thi-ap17:80.3": "",
  "thi-ap17:81.1": "",
  "thi-ap17:81.2": "pe . . . ",
  "thi-ap17:81.3": "pe . . . // // Sāgataṃ . . . pe . . . pe . . . pe . . . // // ",
  "thi-ap17:82.1": "Paṭisambhidā . . . ",
  "thi-ap17:82.2": "pe . . . ",
  "thi-ap17:82.3": "pe . . . pe . . . // // ",
  "thi-ap17:83.1": "Thīnaṃ dhammābhisamaye ",
  "thi-ap17:83.2": "ye bālā vimatiṃ gatā / ",
  "thi-ap17:83.3": "tesaṃ diṭṭhipahānatthaṃ ",
  "thi-ap17:83.4": "iddhiṃ dassehi Gotami\". // // ",
  "thi-ap17:84.1": "Tadā nipacca sambuddhaṃ ",
  "thi-ap17:84.2": "uppatitvāna ambaraṃ / ",
  "thi-ap17:84.3": "iddhī anekā dassesi ",
  "thi-ap17:84.4": "Buddhānuññāya Gotamī. // // ",
  "thi-ap17:85.1": "Ekikā bahudhā c' āsi ",
  "thi-ap17:85.2": "bahudhā c' ekikā tathā / ",
  "thi-ap17:85.3": "āvibhāvaṃ tirobhāvaṃ ",
  "thi-ap17:85.4": "tirokuḍḍaṃ tironabhaṃ. // // ",
  "thi-ap17:86.1": "Asajjamā*nā* agamā ",
  "thi-ap17:86.2": "bhūmiyam pi nimujjatha / ",
  "thi-ap17:86.3": "abhijjamāne udake ",
  "thi-ap17:86.4": "agañchi mahiyā yathā. // // ",
  "thi-ap17:87.1": "Sakuṇī va yathākāse ",
  "thi-ap17:87.2": "pallaṅkena gamī tadā / ",
  "thi-ap17:87.3": "vasaṃ vatteti kāyena ",
  "thi-ap17:87.4": "yāva brahmanivesanaṃ. // // ",
  "thi-ap17:88.1": "Sineruṃ daṇḍaṃ katvāna ",
  "thi-ap17:88.2": "chattaṃ katvā mahāmahiṃ / ",
  "thi-ap17:88.3": "samūlaṃ parivattetvā ",
  "thi-ap17:88.4": "dhārayaṃ caṅkamī nabhe. // // ",
  "thi-ap17:89.1": "Chassūrodayakāle 'va lokaṃ c' ",
  "thi-ap17:89.2": "akāsi dhūmitaṃ / ",
  "thi-ap17:89.3": "yugante viya lokaṃ sā ",
  "thi-ap17:89.4": "jālamālākulaṃ akā. // // ",
  "thi-ap17:90.1": "Mucalindaṃ mahāselaṃ ",
  "thi-ap17:90.2": "Meru-Mandāra-Daddare / ",
  "thi-ap17:90.3": "sāsapā-r-iva sabbāni ",
  "thi-ap17:90.4": "eken' aggahi muṭṭhinā. // // ",
  "thi-ap17:91.1": "Aṅgulaggena chādesi ",
  "thi-ap17:91.2": "bhākaraṃ sa-nisākaraṃ / ",
  "thi-ap17:91.3": "candasūrasahassāni ",
  "thi-ap17:91.4": "āvelam iva dhārayi. // // ",
  "thi-ap17:92.1": "Catusāgaratoyāni ",
  "thi-ap17:92.2": "dhārayi ekapāṇinā / ",
  "thi-ap17:92.3": "yugantajaladākārā ",
  "thi-ap17:92.4": "mahāvassam avassatha. // // ",
  "thi-ap17:93.1": "Cakkavattiṃ saparisaṃ ",
  "thi-ap17:93.2": "māpayi sā nabhattale / ",
  "thi-ap17:93.3": "garuḷaṃ dviradaṃ sīhaṃ ",
  "thi-ap17:93.4": "vinadantañ ca dassayi. // // ",
  "thi-ap17:94.1": "Ekikā abhinimmitvā ",
  "thi-ap17:94.2": "*'pp*ameyyaṃ bhikkhunīgaṇaṃ / ",
  "thi-ap17:94.3": "puna-r-antaradhāpetvā ",
  "thi-ap17:94.4": "ekikā munim abravi: // // ",
  "thi-ap17:95.1": "\"Mātucchā te ma*hā*vīra ",
  "thi-ap17:95.2": "tava sā*sa*nakārikā / ",
  "thi-ap17:95.3": "anuppattā sakaṃ atthaṃ ",
  "thi-ap17:95.4": "pāde vandati cakkhumā\". // // ",
  "thi-ap17:96.1": "Dassetvā vividhā iddhī ",
  "thi-ap17:96.2": "orohitvā nabhattalā / ",
  "thi-ap17:96.3": "vanditvā lokapajjotaṃ ",
  "thi-ap17:96.4": "ekamantaṃ nisīdi sā. // // ",
  "thi-ap17:97.1": "\"*Sā v*īsaṃvassasatikā ",
  "thi-ap17:97.2": "jātiyāhaṃ mahāmune / ",
  "thi-ap17:97.3": "alam ettāvatā vīra ",
  "thi-ap17:97.4": "nibbāyissāmi nāyaka\". // // ",
  "thi-ap17:98.1": "Tadā hi vimhitā sabbā ",
  "thi-ap17:98.2": "parisā sā katañjalī / ",
  "thi-ap17:98.3": "avoc' ayye, ‘kataṃ āsi ",
  "thi-ap17:98.4": "atuliddhiparakkamā.' // // ",
  "thi-ap17:99.1": "Padumuttaro nāma jino ",
  "thi-ap17:99.2": "sabbadhammesu cakkhumā / ",
  "thi-ap17:99.3": "ito satasahassamhi ",
  "thi-ap17:99.4": "kappe uppajji nāyako. // // ",
  "thi-ap17:100.1": "Tadā 'haṃ Haṃsavatiyā ",
  "thi-ap17:100.2": "jātāmaccakule ahuṃ / ",
  "thi-ap17:100.3": "sabbopakārasampanne ",
  "thi-ap17:100.4": "iddhe phīte mahaddhane. // // ",
  "thi-ap17:101.1": "Kadāci pitunā saddhiṃ ",
  "thi-ap17:101.2": "dāsīgaṇapurakkhatā / ",
  "thi-ap17:101.3": "mahatā parivārena ",
  "thi-ap17:101.4": "taṃ upecca narāsabhaṃ // // ",
  "thi-ap17:102.1": "Vāsavaṃ viya vassantaṃ ",
  "thi-ap17:102.2": "dhammamegham anāsavaṃ / ",
  "thi-ap17:102.3": "sāradādiccasadisaṃ ",
  "thi-ap17:102.4": "raṃsijālākulañ jinaṃ // // ",
  "thi-ap17:103.1": "Disvā cittaṃ pasādetvā ",
  "thi-ap17:103.2": "sutvā c' assa subhāsitaṃ / ",
  "thi-ap17:103.3": "mātucchaṃ bhikkhuniṃ agge ",
  "thi-ap17:103.4": "ṭhapentaṃ naranāyakaṃ. // // ",
  "thi-ap17:104.1": "Sutvā datvā mahādānaṃ ",
  "thi-ap17:104.2": "sattāhaṃ tassa tāsino / ",
  "thi-ap17:104.3": "sasaṅghassa naraggassa ",
  "thi-ap17:104.4": "paccayāni bahūni ca. // // ",
  "thi-ap17:105.1": "Nipacca pādamūlamhi ",
  "thi-ap17:105.2": "taṃ ṭhānaṃ abhipatthayiṃ / ",
  "thi-ap17:105.3": "tato mahāparisatiṃ ",
  "thi-ap17:105.4": "a*voca isi*sattamo: // // ",
  "thi-ap17:106.1": "\"Yā sasaṅghaṃ abhojesi ",
  "thi-ap17:106.2": "sattāhaṃ lokanāyakaṃ / ",
  "thi-ap17:106.3": "tam ahaṃ kittayissāmi; ",
  "thi-ap17:106.4": "suṇotha mama bhāsato: // // ",
  "thi-ap17:107.1": "Satasahasse-y-ito kappe ",
  "thi-ap17:107.2": "Okkākakulasambhavo / ",
  "thi-ap17:107.3": "Gotamo nāma nāmena ",
  "thi-ap17:107.4": "satthā loke bhavissati. // // ",
  "thi-ap17:108.1": "Tassa dhammesu dāyādo ",
  "thi-ap17:108.2": "oraso dhammanimmito / ",
  "thi-ap17:108.3": "Gotamī nāma nāmena ",
  "thi-ap17:108.4": "hessati satthu sāvikā. // // ",
  "thi-ap17:109.1": "Tassa Buddhassa mātucchā ",
  "thi-ap17:109.2": "dīpit' āpādikā ayaṃ / ",
  "thi-ap17:109.3": "*rattaññūnañ* ca aggattaṃ ",
  "thi-ap17:109.4": "bhikkhunīnaṃ labhissati\". // // ",
  "thi-ap17:110.1": "Taṃ sutvā 'haṃ pamuditā ",
  "thi-ap17:110.2": "yāvajīvaṃ tadā jinaṃ / ",
  "thi-ap17:110.3": "paccayehi upaṭṭhitvā ",
  "thi-ap17:110.4": "tato kālakatā ahaṃ // // ",
  "thi-ap17:111.1": "Tāvatiṃsesu devesu ",
  "thi-ap17:111.2": "sabbakāmasamiddhisu / ",
  "thi-ap17:111.3": "nibbattā dasah' aṅgehi ",
  "thi-ap17:111.4": "aññe a*bhibhavim ahaṃ.* // // ",
  "thi-ap17:112.1": "Rūpasaddehi gandhehi ",
  "thi-ap17:112.2": "rasehi phusanehi ca / ",
  "thi-ap17:112.3": "āyunāpi ca vaṇṇena ",
  "thi-ap17:112.4": "sukhena yasasā pi ca. // // ",
  "thi-ap17:113.1": "Tath' evādhipateyyena ",
  "thi-ap17:113.2": "adhigayha viroc' ahaṃ / ",
  "thi-ap17:113.3": "ahosiṃ amarindassa ",
  "thi-ap17:113.4": "mahesī dayitā tahiṃ. // // ",
  "thi-ap17:114.1": "Saṃsāre saṃsarantī 'haṃ ",
  "thi-ap17:114.2": "kammavāyusameritā / ",
  "thi-ap17:114.3": "Kāsissa rañño visaye ",
  "thi-ap17:114.4": "ajāyiṃ dāsagāmake. // // ",
  "thi-ap17:115.1": "Pañcadāsasatā nūna ",
  "thi-ap17:115.2": "nivasanti tahiṃ sadā / ",
  "thi-ap17:115.3": "sabbesaṃ tattha yo jeṭṭho ",
  "thi-ap17:115.4": "tassa jāyā ahos' ahaṃ. // // ",
  "thi-ap17:116.1": "Sayambhuno pañca-satā ",
  "thi-ap17:116.2": "gāmaṃ piṇḍāya pāvisuṃ / ",
  "thi-ap17:116.3": "te disvāna ahaṃ tuṭṭhā ",
  "thi-ap17:116.4": "saha sabbāhi ñātibhi. // // ",
  "thi-ap17:117.1": "Pūgā bhavitvā sabbāyo ",
  "thi-ap17:117.2": "cātumāse upaṭṭhiya / ",
  "thi-ap17:117.3": "ticīvarāni datvāna ",
  "thi-ap17:117.4": "saṃsāramha sasāmikā. // // ",
  "thi-ap17:118.1": "Tato cutā sapatikā ",
  "thi-ap17:118.2": "Tāvatiṃsagatā mayaṃ / ",
  "thi-ap17:118.3": "pacchime ca bhave dāni ",
  "thi-ap17:118.4": "jātā Devadahe pure. // // ",
  "thi-ap17:119.1": "Pitā Añjanasakko me ",
  "thi-ap17:119.2": "mātā mama Sulakkhaṇā / ",
  "thi-ap17:119.3": "tato Kapilavatthusmiṃ ",
  "thi-ap17:119.4": "Suddhodana-gharaṅ gatā. // // ",
  "thi-ap17:120.1": "Sesā Sakyakule jātā ",
  "thi-ap17:120.2": "tass' eva gharam āgamuṃ / ",
  "thi-ap17:120.3": "ahaṃ visiṭṭhā sabbāsaṃ ",
  "thi-ap17:120.4": "jinass' āpādikā ahuṃ. // // ",
  "thi-ap17:121.1": "Mama putto 'bhinikkhamma ",
  "thi-ap17:121.2": "Buddho āsi vināyako / ",
  "thi-ap17:121.3": "pacchāhaṃ pabbajitvāna ",
  "thi-ap17:121.4": "satehi saha pañcahi. // // ",
  "thi-ap17:122.1": "Sākiyānīhi vīrāhi ",
  "thi-ap17:122.2": "saha santisukhaṃ phusiṃ / ",
  "thi-ap17:122.3": "ye tadā pubbajātiyaṃ ",
  "thi-ap17:122.4": "asmākaṃ āsu sāmino // // ",
  "thi-ap17:123.1": "Saha puññassa kattāro ",
  "thi-ap17:123.2": "mahāsamayakārakā / ",
  "thi-ap17:123.3": "phusiṃsu arahattaṃ te ",
  "thi-ap17:123.4": "sugatenānukampitā. // // ",
  "thi-ap17:124.1": "Tadetarā bhikkhuniyo ",
  "thi-ap17:124.2": "āruhiṃsu nabhattalaṃ / ",
  "thi-ap17:124.3": "saṅgatā viya tārāyo ",
  "thi-ap17:124.4": "virociṃsu mahiddhikā. // // ",
  "thi-ap17:125.1": "Iddhī-anekā dassesuṃ ",
  "thi-ap17:125.2": "pilandhavikatiṃ yathā / ",
  "thi-ap17:125.3": "kammāro kanakass' eva ",
  "thi-ap17:125.4": "kammaññassa susikkito. // // ",
  "thi-ap17:126.1": "Dassetvā pāṭihīrāni ",
  "thi-ap17:126.2": "cittānī ca bahūni ca / ",
  "thi-ap17:126.3": "tosetvā vādipavaraṃ ",
  "thi-ap17:126.4": "muniṃ saparisan tadā // // ",
  "thi-ap17:127.1": "Orohitvāna gaganā ",
  "thi-ap17:127.2": "vanditvā isisattamaṃ / ",
  "thi-ap17:127.3": "anuññātā naraggena ",
  "thi-ap17:127.4": "yathā ṭhāne nisīdisuṃ. // // ",
  "thi-ap17:128.1": "Aho 'nukampitā amhaṃ ",
  "thi-ap17:128.2": "sabbāsaṃ vīra Gotamī / ",
  "thi-ap17:128.3": "vāsi*tā tava puññe*hi ",
  "thi-ap17:128.4": "pattā no āsavakkhayaṃ. // // ",
  "thi-ap17:129.1": "Kilesā . . . pe . . . ",
  "thi-ap17:129.2": "pe . . . ",
  "thi-ap17:129.3": "pe . . . // // ",
  "thi-ap17:129.4": "Sāgataṃ . . . ",
  "thi-ap17:130.1": "pe . . . ",
  "thi-ap17:130.2": "pe . . . ",
  "thi-ap17:130.3": "pe . . . // // ",
  "thi-ap17:130.4": "",
  "thi-ap17:131.1": "Paṭisambhidā . . . pe . . . ",
  "thi-ap17:131.2": "pe . . . ",
  "thi-ap17:131.3": "pe . . . // // ",
  "thi-ap17:131.4": "Iddhiyā ",
  "thi-ap17:132.1": "ca vasī homa ",
  "thi-ap17:132.2": "dibbāya sotadhātuyā / ",
  "thi-ap17:132.3": "cetopariyañāṇassa ",
  "thi-ap17:132.4": "*vasī homa* mahāmune. // // ",
  "thi-ap17:133.1": "Pubbenivāsañ jānāma ",
  "thi-ap17:133.2": "dibbañ cakkhuṃ visodhitaṃ / ",
  "thi-ap17:133.3": "sabbāsavā parikkhīṇā ",
  "thi-ap17:133.4": "n' atthi dāni punabbhavo. // // ",
  "thi-ap17:134.1": "Atthe dhamme ca nerutte ",
  "thi-ap17:134.2": "paṭibhāne ca vijjati / ",
  "thi-ap17:134.3": "ñāṇaṃ amhaṃ mahāvīra ",
  "thi-ap17:134.4": "uppannaṃ tava santike. // // ",
  "thi-ap17:135.1": "Asmāhi pariciṇṇo 'si ",
  "thi-ap17:135.2": "mettacittāhi nāyaka / ",
  "thi-ap17:135.3": "anujānāhi sabbāyo ",
  "thi-ap17:135.4": "nibbānāya mahāmune // // ",
  "thi-ap17:136.1": "Nibbāyissāma icc' evaṃ. ",
  "thi-ap17:136.2": "Kiṃ vakkhāmi vadantiyo / ",
  "thi-ap17:136.3": "yassa dāni ca vo kālaṃ ",
  "thi-ap17:136.4": "maññathā ti jino bravi. // // ",
  "thi-ap17:137.1": "Gotamī-ādikā tāyo ",
  "thi-ap17:137.2": "tadā bhikkhuniyo jinaṃ / ",
  "thi-ap17:137.3": "vanditvā āsanā tamhā ",
  "thi-ap17:137.4": "vuṭṭhāya agamīsu tā. // // ",
  "thi-ap17:138.1": "Mahatā janakāyena ",
  "thi-ap17:138.2": "saha lokagganāyako / ",
  "thi-ap17:138.3": "anusaṃyāyi so dhīro ",
  "thi-ap17:138.4": "mātucchaṃ yāva koṭṭhakaṃ. // // ",
  "thi-ap17:139.1": "Tadā nipati pādesu ",
  "thi-ap17:139.2": "Gotamī lokabandhuno / ",
  "thi-ap17:139.3": "sahetarāhi sabbāhi ",
  "thi-ap17:139.4": "pacchimaṃ pādavandanaṃ. // // ",
  "thi-ap17:140.1": "Idaṃ pacchimakaṃ mayhaṃ ",
  "thi-ap17:140.2": "lokanāthassa dassanaṃ / ",
  "thi-ap17:140.3": "na puno amatākāraṃ ",
  "thi-ap17:140.4": "passissāmi mukhan tava. // // ",
  "thi-ap17:141.1": "Na 'va me vadanaṃ vīra ",
  "thi-ap17:141.2": "tava pāde sukomale / ",
  "thi-ap17:141.3": "samphusissati lokagga; ",
  "thi-ap17:141.4": "ajja gacchāmi nibbutiṃ. // // ",
  "thi-ap17:142.1": "Rūpena kiṃ tavānena ",
  "thi-ap17:142.2": "diṭṭhadhamme yathātathe / ",
  "thi-ap17:142.3": "sabbaṃ saṅkhatam ev' etaṃ ",
  "thi-ap17:142.4": "anassāsikam ittaraṃ. // // ",
  "thi-ap17:143.1": "Sā saha tāhi gantvāna ",
  "thi-ap17:143.2": "bhikkhunupassayaṃ sakaṃ / ",
  "thi-ap17:143.3": "addhapallaṅkam ābhujya ",
  "thi-ap17:143.4": "nisīdi paramāsane. // // ",
  "thi-ap17:144.1": "Tadā upāsikā tattha ",
  "thi-ap17:144.2": "Buddhasāsanavacchalā / ",
  "thi-ap17:144.3": "tassā pavattiṃ sutvāna ",
  "thi-ap17:144.4": "upesuṃ pādavandikā. // // ",
  "thi-ap17:145.1": "Karehi uraṃ pahantvā ",
  "thi-ap17:145.2": "chimmamūlā yathā latā / ",
  "thi-ap17:145.3": "rudantā karuṇaṃ rāvaṃ ",
  "thi-ap17:145.4": "sokaṭṭā bhuvi pātitā. // // ",
  "thi-ap17:146.1": "Mā no saraṇade nāthe ",
  "thi-ap17:146.2": "vihāya gami nibbutiṃ / ",
  "thi-ap17:146.3": "nipatitvāna yācāma ",
  "thi-ap17:146.4": "sabbāyo sirasā mayaṃ. // // ",
  "thi-ap17:147.1": "Yā padhānatamā tāsaṃ ",
  "thi-ap17:147.2": "saddhāpaññā upāsikā / ",
  "thi-ap17:147.3": "tassā sīsaṃ pamajjantī ",
  "thi-ap17:147.4": "imaṃ vacanaṃ abraviṃ: // // ",
  "thi-ap17:148.1": "Alaṃ puttā visādena ",
  "thi-ap17:148.2": "mārapāsānuvattinā / ",
  "thi-ap17:148.3": "*aniccaṃ* saṅkhataṃ sabbaṃ ",
  "thi-ap17:148.4": "viyogantaṃ calācalaṃ. // // ",
  "thi-ap17:149.1": "Tato sā tā vivajjitvā ",
  "thi-ap17:149.2": "paṭhamaṃ jhānam uttamaṃ / dutiyaṃ ",
  "thi-ap17:149.3": "tatiyañ cāpi ",
  "thi-ap17:149.4": "samāpajji catutthakaṃ. // // ",
  "thi-ap17:150.1": "Ākāsāyatanañ c' eva ",
  "thi-ap17:150.2": "viññāṇāyatanan tathā / ",
  "thi-ap17:150.3": "ākiñcaññevasaññañ ca ",
  "thi-ap17:150.4": "samāpajji yathākkamaṃ. // // ",
  "thi-ap17:151.1": "Paṭilomena jhānāni ",
  "thi-ap17:151.2": "samāpajjatha Gotamī / ",
  "thi-ap17:151.3": "yāvatā paṭhamaṃ jhānaṃ ",
  "thi-ap17:151.4": "tato yāva catutthakaṃ. // // ",
  "thi-ap17:152.1": "Tato vuṭṭhāya nibbāyi ",
  "thi-ap17:152.2": "dīpaccīva nirāsanā / ",
  "thi-ap17:152.3": "bhūmicālo mahā āsi ",
  "thi-ap17:152.4": "nabhasā vijjutā pati. // // ",
  "thi-ap17:153.1": "Pānāditā dundubhiyo ",
  "thi-ap17:153.2": "parideviṃsu devatā / ",
  "thi-ap17:153.3": "pupphāvuṭṭhi ca gaganā ",
  "thi-ap17:153.4": "abhivassatha mediniṃ. // // ",
  "thi-ap17:154.1": "Kampito Merurājā pi ",
  "thi-ap17:154.2": "raṅgamajjhe yathā naṭo / ",
  "thi-ap17:154.3": "sokena 'vātidīno ca ",
  "thi-ap17:154.4": "viravo āsi sāgaro. // // ",
  "thi-ap17:155.1": "Devā nāgāsurā bra*hmā ",
  "thi-ap17:155.2": "saṃv*igg' āhaṃsu tāvade: / ",
  "thi-ap17:155.3": "aniccā vata saṅkhārā ",
  "thi-ap17:155.4": "yathāyaṃ vilayaṃ gatā. // // ",
  "thi-ap17:156.1": "Yā c' emaṃ parivāriṃsu ",
  "thi-ap17:156.2": "satthu sāsanakārikā / ",
  "thi-ap17:156.3": "tāyo pi anupādānā ",
  "thi-ap17:156.4": "dīpacci viya nibbutā. // // ",
  "thi-ap17:157.1": "Hā yogā vippayogantā ",
  "thi-ap17:157.2": "hāniccaṃ sabbasaṅkhataṃ / ",
  "thi-ap17:157.3": "hā jīvitaṃ vināsantaṃ ",
  "thi-ap17:157.4": "iccāsi paridevanā. // // ",
  "thi-ap17:158.1": "Tato devā ca brahmā ca ",
  "thi-ap17:158.2": "lokadhammānuvattanaṃ / ",
  "thi-ap17:158.3": "kālānurūpaṃ kubbanti ",
  "thi-ap17:158.4": "upetvā isisattamaṃ. // // ",
  "thi-ap17:159.1": "Tadā āmantayī satthā ",
  "thi-ap17:159.2": "Ānandaṃ sutisāgaraṃ: / ",
  "thi-ap17:159.3": "gacch' Ānanda nivedehi ",
  "thi-ap17:159.4": "bhikkhūnaṃ mātu nibbutiṃ. // // ",
  "thi-ap17:160.1": "Tad' Ānando nirānando ",
  "thi-ap17:160.2": "assunā puṇṇalocano / ",
  "thi-ap17:160.3": "gaggarena saren' āha: ",
  "thi-ap17:160.4": "\"samāgacchantu bhikkhavo, // // ",
  "thi-ap17:161.1": "Pubbadakkhiṇapacchāsu ",
  "thi-ap17:161.2": "uttarāyaṃ va santi ye / ",
  "thi-ap17:161.3": "sunantu bhāsitam mayhaṃ ",
  "thi-ap17:161.4": "bhikkhavo sugatorasā. // // ",
  "thi-ap17:162.1": "Yā vaḍḍhayi payattena ",
  "thi-ap17:162.2": "sarīraṃ pacchimaṃ mune / ",
  "thi-ap17:162.3": "sā Gotamī gatā santiṃ ",
  "thi-ap17:162.4": "tārā va suriyodaye. // // ",
  "thi-ap17:163.1": "Buddhamātā ti paññattiṃ ",
  "thi-ap17:163.2": "ṭhapayitvā gatāsayaṃ / ",
  "thi-ap17:163.3": "na yattha pañcanetto pi ",
  "thi-ap17:163.4": "gataṃ dakkhiti nāyako. // // ",
  "thi-ap17:164.1": "Yass' atthi sugate saddhā ",
  "thi-ap17:164.2": "yo vā sisso mahāmune / ",
  "thi-ap17:164.3": "Buddhamātussa sakkāraṃ ",
  "thi-ap17:164.4": "karotu sugatoraso.\" // // ",
  "thi-ap17:165.1": "Sudūraṭṭhā pi taṃ sutvā ",
  "thi-ap17:165.2": "sīgham āgañchu bhikkhavo / ",
  "thi-ap17:165.3": "keci Buddhānubhāvena ",
  "thi-ap17:165.4": "keci iddhīsu kovidā. // // ",
  "thi-ap17:166.1": "Kuṭāgāre vare ramme ",
  "thi-ap17:166.2": "sabbasovaṇṇaye subhe / ",
  "thi-ap17:166.3": "mañcakaṃ samāropesuṃ ",
  "thi-ap17:166.4": "yattha suttā 'pi Gotamī. // // ",
  "thi-ap17:167.1": "Cattāro lokapālā te ",
  "thi-ap17:167.2": "aṃsehi samadhārayuṃ / ",
  "thi-ap17:167.3": "sesā Sakkādikā devā ",
  "thi-ap17:167.4": "kuṭāgāre samaggahuṃ. // // ",
  "thi-ap17:168.1": "Kuṭāgārāni sabbāni ",
  "thi-ap17:168.2": "āsuṃ pañcasatāni hi / ",
  "thi-ap17:168.3": "saradādiccavaṇṇāni ",
  "thi-ap17:168.4": "Vissakammakatāni hi. // // ",
  "thi-ap17:169.1": "Sabbā tahiṃ bhikkhuniyo ",
  "thi-ap17:169.2": "āsuṃ mañcesu sāyitā / ",
  "thi-ap17:169.3": "devānaṃ khandham ārūḷhā ",
  "thi-ap17:169.4": "niyyanti anupubbaso. // // ",
  "thi-ap17:170.1": "Sabbaso chāditaṃ āsi ",
  "thi-ap17:170.2": "vitānena nabhatthalaṃ / ",
  "thi-ap17:170.3": "sa-tārā canda-sūrā ca ",
  "thi-ap17:170.4": "lañchitā kanakāmayā. // // ",
  "thi-ap17:171.1": "Paṭākā ussitā 'nekā ",
  "thi-ap17:171.2": "vitatā pupphakañcukā / ",
  "thi-ap17:171.3": "ogatākāsadhūmā va ",
  "thi-ap17:171.4": "mahiyā puppham uggataṃ. // // ",
  "thi-ap17:172.1": "Dissanti candasuriyā ",
  "thi-ap17:172.2": "vijjalanti ca tārakā / ",
  "thi-ap17:172.3": "majjhaṅgato pi c' ādicco ",
  "thi-ap17:172.4": "na tāpesi sasī yathā. // // ",
  "thi-ap17:173.1": "Devā dibbehi gandhehi ",
  "thi-ap17:173.2": "mālehi surabhīhi ca / ",
  "thi-ap17:173.3": "vāditehi ca naccehi ",
  "thi-ap17:173.4": "saṅgītīhi ca pūjayuṃ. // // ",
  "thi-ap17:174.1": "Nāgāsurā ca brahmāno ",
  "thi-ap17:174.2": "yathā *sattiṃ ya* thābalaṃ / ",
  "thi-ap17:174.3": "pūjayiṃsu vinīyantiṃ ",
  "thi-ap17:174.4": "nibbutaṃ Buddhamātaraṃ. // // ",
  "thi-ap17:175.1": "Sabbāyo purato nītā ",
  "thi-ap17:175.2": "nibbutā sugatorasā / ",
  "thi-ap17:175.3": "Gotamī niyyate pacchā ",
  "thi-ap17:175.4": "sakkatā Buddhapositā. // // ",
  "thi-ap17:176.1": "Purato devamanujā ",
  "thi-ap17:176.2": "sanā*gā* surabrahmakā / ",
  "thi-ap17:176.3": "pacchā sasāvako Buddho ",
  "thi-ap17:176.4": "pūjatthaṃ yāti mātuyā. // // ",
  "thi-ap17:177.1": "Buddhassa parinibbānaṃ ",
  "thi-ap17:177.2": "n' edisaṃ āsi yādisaṃ / ",
  "thi-ap17:177.3": "Gotamīparinibbānaṃ ",
  "thi-ap17:177.4": "atīv' acchariyaṃ ahu. // // Na ",
  "thi-ap17:178.1": "Buddho Buddhanibbāne no ",
  "thi-ap17:178.2": "padissati bhikkhavo / ",
  "thi-ap17:178.3": "Buddho Gotaminibbāne ",
  "thi-ap17:178.4": "Sāriputtādikā tathā. // // ",
  "thi-ap17:179.1": "Citakāni karitvāna ",
  "thi-ap17:179.2": "sabbagandhamayāni te / ",
  "thi-ap17:179.3": "gandhacuṇṇādi kiṇṇāni ",
  "thi-ap17:179.4": "jhāpayīsu ca tā tahiṃ. // // ",
  "thi-ap17:180.1": "Sesabhāgāni ḍayhiṃsu ",
  "thi-ap17:180.2": "aṭṭhisesāni sabbaso. / ",
  "thi-ap17:180.3": "Ānando ca tad' āvoca ",
  "thi-ap17:180.4": "saṃvegajanakaṃ vaco: // // ",
  "thi-ap17:181.1": "\"Gotamī nidhanaṃ yātā ",
  "thi-ap17:181.2": "daḍḍhañ c' assā sarīrakaṃ / ",
  "thi-ap17:181.3": "*sa*ṅketaṃ Buddhanibbānaṃ ",
  "thi-ap17:181.4": "na cirena bhavissati. // // ",
  "thi-ap17:182.1": "Tato Gotamīdhātūni ",
  "thi-ap17:182.2": "tassā pattagatāni so / ",
  "thi-ap17:182.3": "upanāmesi nāthassa ",
  "thi-ap17:182.4": "Ānando Buddhacodito. // // ",
  "thi-ap17:183.1": "Pāṇinā tāni paggayha ",
  "thi-ap17:183.2": "avoca isisattamo: / ",
  "thi-ap17:183.3": "mahato sāravantassa ",
  "thi-ap17:183.4": "yathā rukkhassa tiṭṭhato // // ",
  "thi-ap17:184.1": "Yo so mahattaro khandho ",
  "thi-ap17:184.2": "palujjeyya aniccatā / ",
  "thi-ap17:184.3": "tathā bhikkhunisaṅghassa ",
  "thi-ap17:184.4": "Gotamī parinibbutā. // // ",
  "thi-ap17:185.1": "Aho acchariyaṃ mayhaṃ ",
  "thi-ap17:185.2": "nibbutāya pi mātuyā / ",
  "thi-ap17:185.3": "sarīramattasesāya ",
  "thi-ap17:185.4": "n' atthi sokapariddavo. // // ",
  "thi-ap17:186.1": "Na sociyā paresaṃ sā ",
  "thi-ap17:186.2": "tiṇṇā saṃsārasāgarā / ",
  "thi-ap17:186.3": "parivajjitasantāpā ",
  "thi-ap17:186.4": "sītibhūtā sunibbutā. // // ",
  "thi-ap17:187.1": "Paṇḍitā 'si mahāpaññā ",
  "thi-ap17:187.2": "puthupaññā tath' eva ca / ",
  "thi-ap17:187.3": "rattaññū bhikkhunīnaṃ sā ",
  "thi-ap17:187.4": "evaṃ jānātha bhikkhavo. // // ",
  "thi-ap17:188.1": "Iddhiyā ca vasī āsi ",
  "thi-ap17:188.2": "dibbāya sotadhātuyā / ",
  "thi-ap17:188.3": "cetopariyañāṇassa ",
  "thi-ap17:188.4": "vasī āsi ca Gotamī. // // ",
  "thi-ap17:189.1": "Pubbenivāsaṃ aññāsi ",
  "thi-ap17:189.2": "dibbacakkhuṃ visodhitaṃ / ",
  "thi-ap17:189.3": "sabbāsavā parikkhīṇā ",
  "thi-ap17:189.4": "n' atthi tassā punabbhavo. // // ",
  "thi-ap17:190.1": "Atthadhammaniruttīsu ",
  "thi-ap17:190.2": "paṭibhāne tath' eva ca / ",
  "thi-ap17:190.3": "parisuddhaṃ ahū ñāṇaṃ ",
  "thi-ap17:190.4": "tasmā socaniyā na sā. // // ",
  "thi-ap17:191.1": "Ayoghanahatass' eva ",
  "thi-ap17:191.2": "jalato jātavedaso / ",
  "thi-ap17:191.3": "anupubbūpasantassa ",
  "thi-ap17:191.4": "yathā na ñāyate gati. // // ",
  "thi-ap17:192.1": "Evaṃ sammāvimuttānaṃ ",
  "thi-ap17:192.2": "*kāmaba* ndhoghatārinaṃ / ",
  "thi-ap17:192.3": "paññāpetuṃ gati n' atthi ",
  "thi-ap17:192.4": "pattānaṃ acalaṃ sukhaṃ. // // ",
  "thi-ap17:193.1": "Attadīpā tato hotha ",
  "thi-ap17:193.2": "satipaṭṭhānagocarā / ",
  "thi-ap17:193.3": "bhāvetvā sattabojjhaṅge ",
  "thi-ap17:193.4": "dukkhass' antaṃ karissathā ti. // // ",
  "thi-ap17:194.1": "Itthaṃ sudaṃ Mahāpajāpatīgotamī i. g. a-ti. Mahāpajāpatīgotamiyā theriyā apadānaṃ ",
  "thi-ap17:195.1": ""
}
