  "thi-ap28:6.1": "",
  "thi-ap28:6.2": "",
  "thi-ap28:6.3": "Purakkhatā bhikkhunīhi ",
  "thi-ap28:6.4": "satehi saha pañcahi / ",
  "thi-ap28:7.1": "mahiddhikā mahāpaññā ",
  "thi-ap28:7.2": "sambuddhaṃ upasaṅkamiṃ. // // ",
  "thi-ap28:7.3": "Sambuddhaṃ abhivādetvā ",
  "thi-ap28:7.4": "satthuno cakkalakkhaṇe / ",
  "thi-ap28:7.5": "nisinnā ekamantamhi ",
  "thi-ap28:7.6": "imaṃ vacanam abraviṃ: // // ",
  "thi-ap28:8.1": "Aṭṭhasattati vassā 'haṃ ",
  "thi-ap28:8.2": "pacchimo vattati vayo / ",
  "thi-ap28:8.3": "pabbhāram pi anuppattā ",
  "thi-ap28:8.4": "ārocemi mahāmuni // // ",
  "thi-ap28:9.1": "Paripakko vayo mayhaṃ ",
  "thi-ap28:9.2": "parittam atha jīvitaṃ / ",
  "thi-ap28:9.3": "pahāya vo gamissāmi ",
  "thi-ap28:9.4": "katam me saraṇam attano. // // Vayo ",
  "thi-ap28:10.1": "ca pacchime kāle ",
  "thi-ap28:10.2": "maraṇaṃ uparundhati / ",
  "thi-ap28:10.3": "ajjarattiṃ mahāvīra ",
  "thi-ap28:10.4": "pāpuṇissāmi nibbutiṃ. // // ",
  "thi-ap28:11.1": "N' atthi jāti jarā vyādhi ",
  "thi-ap28:11.2": "maraṇañ ca mahāmune / ",
  "thi-ap28:11.3": "ajarāmaraṇaṃ puraṃ ",
  "thi-ap28:11.4": "gamissāmi asaṅkhataṃ. // // ",
  "thi-ap28:12.1": "Yāvatā parisā nāma ",
  "thi-ap28:12.2": "samupayāti satthuno / ",
  "thi-ap28:12.3": "aparā*dhaṃ* pajānanti ",
  "thi-ap28:12.4": "khamantaṃ sammukhā muṇe // // ",
  "thi-ap28:13.1": "Saṃsarantañ ca saṃsāre ",
  "thi-ap28:13.2": "*khalitañ* ce tavaṃ mayi / āroce ",
  "thi-ap28:13.3": "va mahāvīra ",
  "thi-ap28:13.4": "aparādhaṃ khamassu me. // // ",
  "thi-ap28:14.1": "",
  "thi-ap28:14.2": "",
  "thi-ap28:14.3": "",
  "thi-ap28:14.4": "",
  "thi-ap28:15.1": "Iddhiñ cāpi nidassesi ",
  "thi-ap28:15.2": "mama sāsanakārike / ",
  "thi-ap28:15.3": "parisānañ ca sabbāsaṃ ",
  "thi-ap28:15.4": "kaṅkhaṃ chindassu sāsane // // ",
  "thi-ap28:16.1": "",
  "thi-ap28:16.2": "",
  "thi-ap28:16.3": "",
  "thi-ap28:16.4": "",
  "thi-ap28:17.1": "Yasodharā ahaṃ vīra ",
  "thi-ap28:17.2": "agāre te pajāpatī / ",
  "thi-ap28:17.3": "Sākiyamhi kule jātā ",
  "thi-ap28:17.4": "itthi atho *patiṭṭhitā* // // ",
  "thi-ap28:18.1": "Thīnaṃ satasahassānaṃ ",
  "thi-ap28:18.2": "navutīnaṃ chaḷ-uttariṃ / ",
  "thi-ap28:18.3": "agāre te ahaṃ vīra ",
  "thi-ap28:18.4": "pāmokkhā sabba-issarā. // // ",
  "thi-ap28:19.1": "Rūpācāraguṇūpetā ",
  "thi-ap28:19.2": "yobbanaṭṭhā piyaṃvadā / ",
  "thi-ap28:19.3": "sabbā maṃ apacāyanti ",
  "thi-ap28:19.4": "devatā viya mānusā. // // ",
  "thi-ap28:20.1": "Kaññā sahassapamukhā ",
  "thi-ap28:20.2": "Sakyaputta-nivesane / ",
  "thi-ap28:20.3": "samānasukhadukkhā tā ",
  "thi-ap28:20.4": "devatā viya Nandane // // ",
  "thi-ap28:21.1": "Kāmadhātum atikkantā ",
  "thi-ap28:21.2": "saṇṭhitā rūpadhātuyā / ",
  "thi-ap28:21.3": "rūpena sadisā n' atthi ",
  "thi-ap28:21.4": "ṭhapetvā lokanāyakaṃ. // // ",
  "thi-ap28:22.1": "Sambuddhaṃ abhivādetvā ",
  "thi-ap28:22.2": "iddhiṃ dassesi satthuno / ",
  "thi-ap28:22.3": "nekā nānāvidhākārā ",
  "thi-ap28:22.4": "mahā-iddhiṃ vidaṃsayiṃ. // // Cakkavālaṃ ",
  "thi-ap28:23.1": "samaṃ kāyaṃ ",
  "thi-ap28:23.2": "sīsaṃ uttarato kuru / ",
  "thi-ap28:23.3": "ubho pakkhā duve dīpā ",
  "thi-ap28:23.4": "jambudīpaṃ sarīrato. // // ",
  "thi-ap28:24.1": "Dakkhiṇañ ca saraṃ picchaṃ ",
  "thi-ap28:24.2": "nānā sākhā tu pattakā. / ",
  "thi-ap28:24.3": "candañ ca suriyañ c' akkhī ",
  "thi-ap28:24.4": "Meru-pabbatato sikhaṃ. // // ",
  "thi-ap28:25.1": "Cakkavālagirituṇḍaṃ jamburukkhasamūlakaṃ / ",
  "thi-ap28:25.2": "vījamānā ",
  "thi-ap28:25.3": "upāgantvā ",
  "thi-ap28:25.4": "vandate lokanāyakaṃ. // // ",
  "thi-ap28:26.1": "Hatthivaṇṇaṃ tath' ev' assaṃ ",
  "thi-ap28:26.2": "pabbataṃ jalajaṃ tathā / ",
  "thi-ap28:26.3": "candañ ca suriyaṃ Meruṃ ",
  "thi-ap28:26.4": "Sakkavaṇṇañ ca dassayi. // // ",
  "thi-ap28:27.1": "Yasodharā ahaṃ vīra ",
  "thi-ap28:27.2": "pāde vandāmi cakkhumā / ",
  "thi-ap28:27.3": "sahassaṃ lokadhātūnaṃ ",
  "thi-ap28:27.4": "phullapaccena chādayiṃ. // // ",
  "thi-ap28:28.1": "Brahmavaṇṇañ ca māpetvā ",
  "thi-ap28:28.2": "dhammaṃ desesi puññataṃ / ",
  "thi-ap28:28.3": "Yasodharā ahaṃ vīra ",
  "thi-ap28:28.4": "pāde vandāmi cakkhumā. // // ",
  "thi-ap28:29.1": "Iddhīsu ca vasī homi ",
  "thi-ap28:29.2": "dibbāya sotadhātuyā / ",
  "thi-ap28:29.3": "cetopariyañāṇassa ",
  "thi-ap28:29.4": "vasī homi mahāmune. // // ",
  "thi-ap28:30.1": "Pubbenivāsaṃ jānāmi ",
  "thi-ap28:30.2": "dibbacakkhuṃ visodhitaṃ / ",
  "thi-ap28:30.3": "sabbāsavā parikkhīṇā ",
  "thi-ap28:30.4": "n' atthi dāni punabbhavo. // // ",
  "thi-ap28:31.1": "Atthadhammaniruttīsu ",
  "thi-ap28:31.2": "paṭibhāne tath' eva ca / ",
  "thi-ap28:31.3": "ñāṇaṃ mama mahāvīra ",
  "thi-ap28:31.4": "uppannaṃ tava santike. // // ",
  "thi-ap28:32.1": "Pubbānaṃ lokanāthānaṃ ",
  "thi-ap28:32.2": "saṅgaman te su-dassitaṃ / ",
  "thi-ap28:32.3": "adhikāraṃ bahuṃ mayhaṃ ",
  "thi-ap28:32.4": "tuyhatthāya mahāmune. // // ",
  "thi-ap28:33.1": "Yaṃ mayhaṃ purimaṃ kammaṃ ",
  "thi-ap28:33.2": "kusalaṃ sarase mune / ",
  "thi-ap28:33.3": "tuyh' atthāya mahāvīra ",
  "thi-ap28:33.4": "puññaṃ upacitaṃ mayā. // // ",
  "thi-ap28:34.1": "Abhabbaṭṭhāne vajjetvā ",
  "thi-ap28:34.2": "pācayantī anāvaraṃ / ",
  "thi-ap28:34.3": "tuyh' atthāya mahāvīra ",
  "thi-ap28:34.4": "samattaṃ jīvitaṃ mayā. // // ",
  "thi-ap28:35.1": "Nekakoṭisahassāni ",
  "thi-ap28:35.2": "bhariyatthāya dāsi maṃ / ",
  "thi-ap28:35.3": "na tattha vimanā homi ",
  "thi-ap28:35.4": "tuyhatthāya mahāmune. // // ",
  "thi-ap28:36.1": "Nekakoṭisahassāni ",
  "thi-ap28:36.2": "upakārāya dāsi maṃ / ",
  "thi-ap28:36.3": "na tattha vimanā homi ",
  "thi-ap28:36.4": "tuyhatthāya mahāmune. // // ",
  "thi-ap28:37.1": "Nekakoṭisahassāni ",
  "thi-ap28:37.2": "bhojanatthāya dāsi maṃ / ",
  "thi-ap28:37.3": "na tattha vimanā homi ",
  "thi-ap28:37.4": "tuyhatthāya mahāmune. // // ",
  "thi-ap28:38.1": "Nekakoṭisahassāni ",
  "thi-ap28:38.2": "jīvitāni pariccajiṃ / ",
  "thi-ap28:38.3": "bhayamokkhaṃ karissanti ",
  "thi-ap28:38.4": "cajāmi mama jīvitaṃ. // // ",
  "thi-ap28:39.1": "Aṅgagate alaṅkāre ",
  "thi-ap28:39.2": "vatthe nānāvidhe bahū / ",
  "thi-ap28:39.3": "itthibhaṇḍena gūhāmi ",
  "thi-ap28:39.4": "tuyh' atthāya mahāmuni. // // ",
  "thi-ap28:40.1": "Dhanadhaññāpariccāgaṃ ",
  "thi-ap28:40.2": "gāmāni nigamāni ca / ",
  "thi-ap28:40.3": "khettaṃ puttañ ca dhītarañ ca ",
  "thi-ap28:40.4": "pariccattā mahāmuni. // // ",
  "thi-ap28:41.1": "Hatthi-assa-gavañ cāpi ",
  "thi-ap28:41.2": "dāsiyo paricārikā / ",
  "thi-ap28:41.3": "tuyh' atthāya mahāvīra ",
  "thi-ap28:41.4": "pariccattā asaṅkhiyā. // // ",
  "thi-ap28:42.1": "Yaṃ mayhaṃ paṭimantesi ",
  "thi-ap28:42.2": "dānaṃ dassāmi yācake / ",
  "thi-ap28:42.3": "vimanaṃ me na passāmi ",
  "thi-ap28:42.4": "dadato dānam uttamaṃ. // // ",
  "thi-ap28:43.1": "Nānāvidhaṃ bahuṃ dukkhaṃ ",
  "thi-ap28:43.2": "saṃsāre ca bahubbidhe / ",
  "thi-ap28:43.3": "tuyh' atthāya mahāvīra ",
  "thi-ap28:43.4": "pariccattaṃ asaṅkhiyaṃ. // // ",
  "thi-ap28:44.1": "Sukhaṃ pattā na modāmi ",
  "thi-ap28:44.2": "na ca dukkhesu dummanā / ",
  "thi-ap28:44.3": "sabbattha tulitā homi ",
  "thi-ap28:44.4": "tuyh' atthāya mahāmune. // // ",
  "thi-ap28:45.1": "Anumaggena sambuddho ",
  "thi-ap28:45.2": "yaṃ dhammaṃ abhinīharī / ",
  "thi-ap28:45.3": "anubhotvā sukhaṃ dukkhaṃ ",
  "thi-ap28:45.4": "patto bodhiṃ mahāmuni. // // ",
  "thi-ap28:46.1": "Brahmadevañ ca sambuddhaṃ ",
  "thi-ap28:46.2": "Gotamaṃ lokanāyakaṃ / ",
  "thi-ap28:46.3": "aññesaṃ lokanāthānaṃ ",
  "thi-ap28:46.4": "saṅgaman te bahum mayā. // // ",
  "thi-ap28:47.1": "Adhikāraṃ bahuṃ mayhaṃ ",
  "thi-ap28:47.2": "tuyh' atthāya mahāmuni / ",
  "thi-ap28:47.3": "gavesantā Buddhadhammaṃ ",
  "thi-ap28:47.4": "ahan te paricārikā. // // ",
  "thi-ap28:48.1": "Kappe satasahasse ca ",
  "thi-ap28:48.2": "caturo ca asaṅkhiye / ",
  "thi-ap28:48.3": "Dīpaṅkaro mahāvīro ",
  "thi-ap28:48.4": "uppajji lokanāyako. // // ",
  "thi-ap28:49.1": "Paccantadesavisaye ",
  "thi-ap28:49.2": "nimantetvā Tathāgataṃ / ",
  "thi-ap28:49.3": "tassa āgamanaṃ maggaṃ ",
  "thi-ap28:49.4": "sodhenti tuṭṭhamānasā. // // ",
  "thi-ap28:50.1": "Tena kālena so āsi ",
  "thi-ap28:50.2": "Sumedho nāma brāhmaṇo / ",
  "thi-ap28:50.3": "maggañ ca paṭiyādesi ",
  "thi-ap28:50.4": "āyato sabbadassino. // // ",
  "thi-ap28:51.1": "Tena kālen' ahaṃ āsiṃ ",
  "thi-ap28:51.2": "kaññā brāhmaṇasambhavā / ",
  "thi-ap28:51.3": "Sumittā nāma nāmena ",
  "thi-ap28:51.4": "upagacchiṃ samāgamaṃ. // // ",
  "thi-ap28:52.1": "Aṭṭha uppalahatthāni ",
  "thi-ap28:52.2": "pūjanatthāya satthuno / ",
  "thi-ap28:52.3": "ādāya janasammajjhe ",
  "thi-ap28:52.4": "addasaṃ isim uggataṃ // // ",
  "thi-ap28:53.1": "Cirānugataṃ dassitaṃ ",
  "thi-ap28:53.2": "patikantaṃ manoharaṃ / ",
  "thi-ap28:53.3": "disvā tadā amaññissaṃ ",
  "thi-ap28:53.4": "saphalaṃ jīvitaṃ mama. // // ",
  "thi-ap28:54.1": "Parakkamantaṃ saphalaṃ ",
  "thi-ap28:54.2": "addasaṃ isino tadā / ",
  "thi-ap28:54.3": "pubbakammena sambuddho ",
  "thi-ap28:54.4": "cittañ cāpi pasīdi me. // // ",
  "thi-ap28:55.1": "Bhiyyo cittaṃ pasādesiṃ ",
  "thi-ap28:55.2": "ise uggatamānase / ",
  "thi-ap28:55.3": "deyyaṃ aññaṃ na passāmi ",
  "thi-ap28:55.4": "demi pupphāni te isiṃ. // // ",
  "thi-ap28:56.1": "Pañcahatthā tavaṃ hontu ",
  "thi-ap28:56.2": "tato hontu mamaṃ ise / ",
  "thi-ap28:56.3": "tena siddhi saha hotu ",
  "thi-ap28:56.4": "bodhanatthāya tavaṃ ise. // // ",
  "thi-ap28:57.1": "",
  "thi-ap28:58.1": "Isi gahetvā pupphāni ",
  "thi-ap28:58.2": "āgacchantaṃ mahāyasaṃ / ",
  "thi-ap28:58.3": "pūjesi janasammajjhe ",
  "thi-ap28:58.4": "bodhanatthāya mahā-isi. // // ",
  "thi-ap28:59.1": "Passitvā janasammajjhe ",
  "thi-ap28:59.2": "Dīpaṅkara-mahāmuni / ",
  "thi-ap28:59.3": "viyākāsi mahāvīro ",
  "thi-ap28:59.4": "isim uggatamānasaṃ. // // ",
  "thi-ap28:60.1": "Aparimeyy' ito kappe ",
  "thi-ap28:60.2": "Dīpaṅkara-mahāmuni / ",
  "thi-ap28:60.3": "mama kammaṃ viyākāsi ",
  "thi-ap28:60.4": "ujubhāvaṃ mahāmuni. // // ",
  "thi-ap28:61.1": "Samacittā samakammā ",
  "thi-ap28:61.2": "samakārī bhavissati / ",
  "thi-ap28:61.3": "piyā hessati kammena ",
  "thi-ap28:61.4": "tuyh' atthāya mahā-ise. // // ",
  "thi-ap28:62.1": "Sudassanā suppiyā ca ",
  "thi-ap28:62.2": "manasā piyavādinī / ",
  "thi-ap28:62.3": "tassa dhammesu dāyādā ",
  "thi-ap28:62.4": "piyā hessati itthikā. // // ",
  "thi-ap28:63.1": "Yathāpi bhaṇḍasamuggaṃ ",
  "thi-ap28:63.2": "anurakkhati sāmi no / ",
  "thi-ap28:63.3": "evaṃ kusaladhammānaṃ ",
  "thi-ap28:63.4": "anurakkhiyate ayaṃ. // // ",
  "thi-ap28:64.1": "Tassa taṃ anukampanti ",
  "thi-ap28:64.2": "pūrayissati pāramī / ",
  "thi-ap28:64.3": "sīho va pañjaraṃ hetvā ",
  "thi-ap28:64.4": "pāpuṇissati bodhiyaṃ. // // ",
  "thi-ap28:65.1": "Aparimmeyy' ito kappe ",
  "thi-ap28:65.2": "yaṃ Buddho viyākāri ",
  "thi-ap28:65.3": "taṃ / vācaṃ anumodantī taṃ ",
  "thi-ap28:65.4": "evaṃ kārī bhaviṃ ahaṃ. // // ",
  "thi-ap28:66.1": "Tassa kammassa sukatassa ",
  "thi-ap28:66.2": "tattha cittaṃ pasādayiṃ / ",
  "thi-ap28:66.3": "devamānusakaṃ yoniṃ ",
  "thi-ap28:66.4": "anubhotvā asaṅkhiyaṃ. // // ",
  "thi-ap28:67.1": "Sukhadukkhe 'nubhotvāna ",
  "thi-ap28:67.2": "devesu mānusesu ca / ",
  "thi-ap28:67.3": "pacchime bhavasampatte ",
  "thi-ap28:67.4": "ajāyiṃ Sākiye kule. // // ",
  "thi-ap28:68.1": "Rūpavatī bhogavatī ",
  "thi-ap28:68.2": "yasa-sīlavatī tato / ",
  "thi-ap28:68.3": "sabbaṅgasampadā homi ",
  "thi-ap28:68.4": "kulesu-atisakkatā. // // ",
  "thi-ap28:69.1": "Lābhaṃ silokaṃ sakkāraṃ ",
  "thi-ap28:69.2": "lokadhammasamāgamaṃ / ",
  "thi-ap28:69.3": "cittañ ca dukkhitaṃ n' atthi ",
  "thi-ap28:69.4": "vasāmi akutobhayā. // // ",
  "thi-ap28:70.1": "Vuttaṃ hetaṃ bhagavatā ",
  "thi-ap28:70.2": "rañño antepure tadā / ",
  "thi-ap28:70.3": "khattiyānaṃ pure vīra ",
  "thi-ap28:70.4": "upakāratthañ ca niddisī. // // ",
  "thi-ap28:71.1": "Upakārā ca yā nārī ",
  "thi-ap28:71.2": "yā ca nārī sukhe dukhe / ",
  "thi-ap28:71.3": "atth' akkhāyī ca yā nārī ",
  "thi-ap28:71.4": "yā nārī c' ānukampikā. // // ",
  "thi-ap28:72.1": "Pañcakoṭisatā-Buddhā ",
  "thi-ap28:72.2": "navakoṭisatāni ca / ",
  "thi-ap28:72.3": "etesaṃ devadevānaṃ ",
  "thi-ap28:72.4": "mahādānaṃ pavattayiṃ. // // ",
  "thi-ap28:73.1": "Adhikāraṃ sadā mayhaṃ ",
  "thi-ap28:73.2": "mahārāja suṇohi me / ",
  "thi-ap28:73.3": "ekārasaṃ ",
  "thi-ap28:73.4": "koṭisatā paññākoṭisatāni ca. // // ",
  "thi-ap28:74.1": "Etesaṃ devadevānaṃ ",
  "thi-ap28:74.2": "mahādānaṃ pavattayiṃ / ",
  "thi-ap28:74.3": "adhikāraṃ sadā mayhaṃ ",
  "thi-ap28:74.4": "mahārāja suṇohi me. // // ",
  "thi-ap28:75.1": "Visakoṭisatā Buddhā ",
  "thi-ap28:75.2": "tiṃsakoṭisatāni ca / ",
  "thi-ap28:75.3": "etesaṃ devadevānaṃ ",
  "thi-ap28:75.4": "mahādānaṃ pavattayiṃ. // // ",
  "thi-ap28:76.1": "Adhikāraṃ sadā mayhaṃ ",
  "thi-ap28:76.2": "mahārāja suṇohi me / ",
  "thi-ap28:76.3": "cattārīsaṃ ",
  "thi-ap28:76.4": "koṭisatā paññākoṭisatāni ca. // // ",
  "thi-ap28:77.1": "Etesaṃ devadevānaṃ ",
  "thi-ap28:77.2": "mahādānaṃ pavattayiṃ. / ",
  "thi-ap28:77.3": "adhikaraṃ sadā mayhaṃ ",
  "thi-ap28:77.4": "mahārāja suṇohi me. // // ",
  "thi-ap28:78.1": "Saṭṭhikoṭisatā Buddhā ",
  "thi-ap28:78.2": "sattatikoṭisatāni ca / ",
  "thi-ap28:78.3": "etesaṃ devadevānaṃ ",
  "thi-ap28:78.4": "mahādānaṃ pavattayiṃ. // // ",
  "thi-ap28:79.1": "Adhikāraṃ sadā mayhaṃ ",
  "thi-ap28:79.2": "mahārāja suṇohi me / ",
  "thi-ap28:79.3": "asītikoṭisatā Buddhā ",
  "thi-ap28:79.4": "navutikoṭisatāni ca. // // ",
  "thi-ap28:80.1": "Etesaṃ devadevānaṃ ",
  "thi-ap28:80.2": "mahādānaṃ pavattayiṃ / ",
  "thi-ap28:80.3": "adhikāraṃ sadā mayhaṃ ",
  "thi-ap28:80.4": "mahārāja suṇohi me. // // ",
  "thi-ap28:81.1": "Koṭisatasahassāni ",
  "thi-ap28:81.2": "honti lokagganāyakā / ",
  "thi-ap28:81.3": "etesaṃ devadevānaṃ ",
  "thi-ap28:81.4": "mahādānaṃ pavattayiṃ. // // ",
  "thi-ap28:82.1": "Adhikāraṃ sadā mayhaṃ ",
  "thi-ap28:82.2": "mahārāja suṇohi me / ",
  "thi-ap28:82.3": "navakoṭisahassāni ",
  "thi-ap28:82.4": "apare lokanāyakā. // // ",
  "thi-ap28:83.1": "Etesaṃ devadevānaṃ ",
  "thi-ap28:83.2": "mahādānaṃ pavattayiṃ / ",
  "thi-ap28:83.3": "adhikāraṃ sadā mayhaṃ ",
  "thi-ap28:83.4": "mahārāja suṇohi me: // // ",
  "thi-ap28:84.1": "Koṭisatasahassāni ",
  "thi-ap28:84.2": "pañcasīti mahesinaṃ / ",
  "thi-ap28:84.3": "pañcasītikoṭisatā ",
  "thi-ap28:84.4": "sattati sahassakoṭiyo. // // ",
  "thi-ap28:85.1": "Etesaṃ devadevānaṃ ",
  "thi-ap28:85.2": "mahādānaṃ pavattayiṃ / ",
  "thi-ap28:85.3": "adhikāraṃ sahā mayhaṃ ",
  "thi-ap28:85.4": "mahārāja suṇohi me. // // ",
  "thi-ap28:86.1": "Paccekabuddhā dhūtarāgā aṭṭha ",
  "thi-ap28:86.2": "aṭṭhamakoṭiyo / ",
  "thi-ap28:86.3": "adhikāraṃ sahā mayhaṃ ",
  "thi-ap28:86.4": "mahārāja suṇohi me. // // ",
  "thi-ap28:87.1": "Khīṇāsavā vītamalā ",
  "thi-ap28:87.2": "asaṅkheyyā Buddhasāvakā / ",
  "thi-ap28:87.3": "adhikāraṃ sahā mayhaṃ ",
  "thi-ap28:87.4": "mahārāja suṇohi me. // // ",
  "thi-ap28:88.1": "Evaṃ dhammesu ciṇṇānaṃ ",
  "thi-ap28:88.2": "sadā saddhamma-carino / ",
  "thi-ap28:88.3": "dhammacārī sukhaṃ seti ",
  "thi-ap28:88.4": "asmiṃ loke paramhi ca. // // ",
  "thi-ap28:89.1": "Dhammaṃ care sucaritaṃ ",
  "thi-ap28:89.2": "na naṃ duccaritaṃ care / ",
  "thi-ap28:89.3": "dhammacārī sukhaṃ seti ",
  "thi-ap28:89.4": "asmiṃ loke paramhi ca. // // ",
  "thi-ap28:90.1": "Nibbinditvāna saṃsāre ",
  "thi-ap28:90.2": "pabbajiṃ anagāriyaṃ / ",
  "thi-ap28:90.3": "sahassaparivārena ",
  "thi-ap28:90.4": "pabbajitvā akiñcanā. // // ",
  "thi-ap28:91.1": "Agāraṃ vijahitvāna ",
  "thi-ap28:91.2": "pabbajiṃ anagāriyaṃ / ",
  "thi-ap28:91.3": "aṭṭhamāse asampatte ",
  "thi-ap28:91.4": "catusaccaṃ apāpuṇiṃ. // // ",
  "thi-ap28:92.1": "Cīvaraṃ piṇḍapātañ ca ",
  "thi-ap28:92.2": "paccayaṃ sayanāsanaṃ / ",
  "thi-ap28:92.3": "upanenti bahun eke sāgarass' ",
  "thi-ap28:92.4": "eva ūmiyo. // // ",
