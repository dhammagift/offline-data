  "thi-ap20:0.3": "",
  "thi-ap20:1.1": "Padumuttaro nāma jino ",
  "thi-ap20:1.2": "sabbadhammāna pāragū / ",
  "thi-ap20:1.3": "ito satasahassamhi ",
  "thi-ap20:1.4": "kappe uppajji nāyako. // // ",
  "thi-ap20:2.1": "Tadā 'haṃ Haṃsavatiyā ",
  "thi-ap20:2.2": "jātā seṭṭhikule ahuṃ / ",
  "thi-ap20:2.3": "nānāratanapajjote ",
  "thi-ap20:2.4": "mahāsukhasamappitā. // // ",
  "thi-ap20:3.1": "Upetvā taṃ mahāvīraṃ ",
  "thi-ap20:3.2": "assosiṃ dhammadesanaṃ / ",
  "thi-ap20:3.3": "tato jātappasādāhaṃ ",
  "thi-ap20:3.4": "upesiṃ saraṇaṃ jinaṃ. // // ",
  "thi-ap20:4.1": "Tato vinayadhārīnaṃ ",
  "thi-ap20:4.2": "aggaṃ vaṇṇesi nāyako / ",
  "thi-ap20:4.3": "bhikkhuniṃ lajjiniṃ tādiṃ ",
  "thi-ap20:4.4": "kappākappavisāradaṃ. // // ",
  "thi-ap20:5.1": "Tadā muditacittā 'haṃ ",
  "thi-ap20:5.2": "naṃ ṭhānaṃ abhikaṅkhinī / ",
  "thi-ap20:5.3": "nimantetvā dasabalaṃ ",
  "thi-ap20:5.4": "sasaṅghaṃ lokanāyakaṃ. // // ",
  "thi-ap20:6.1": "Bhojayitvāna sattāhaṃ ",
  "thi-ap20:6.2": "daditvā ca ticīvaraṃ / ",
  "thi-ap20:6.3": "nipacca sirasā pāde ",
  "thi-ap20:6.4": "imaṃ vacanam abraviṃ: // // ",
  "thi-ap20:7.1": "Yā tayā vaṇṇitā vīra ",
  "thi-ap20:7.2": "ito aṭṭhamake dine / ",
  "thi-ap20:7.3": "tadisā 'haṃ bhavissāmī ",
  "thi-ap20:7.4": "yadi sijjhati nāyaka. // // ",
  "thi-ap20:8.1": "Tadā avoca maṃ satthā: ",
  "thi-ap20:8.2": "Bhadde, mā bhāyi assasa / ",
  "thi-ap20:8.3": "anāgatamhi addhāne ",
  "thi-ap20:8.4": "lacchas' etaṃ manorathaṃ. // // ",
  "thi-ap20:9.1": "Satasahasse ito kappe ",
  "thi-ap20:9.2": "Okkākakulasambhavo / ",
  "thi-ap20:9.3": "Gotamo nāma nāmena ",
  "thi-ap20:9.4": "satthā loke bhavissati. // // ",
  "thi-ap20:10.1": "Tassa dhammesu dāyādā ",
  "thi-ap20:10.2": "orasā dhammanimmitā / ",
  "thi-ap20:10.3": "Paṭācārā ti nāmena ",
  "thi-ap20:10.4": "hessati satthu sāvikā. // // ",
  "thi-ap20:11.1": "Tadā 'haṃ muditā hutvā ",
  "thi-ap20:11.2": "yāvajīvaṃ tadā jinaṃ / ",
  "thi-ap20:11.3": "mettacittā paricariṃ ",
  "thi-ap20:11.4": "sasaṅghaṃ lokanāyakaṃ. // // ",
  "thi-ap20:12.1": "Tena kammena sukatena ",
  "thi-ap20:12.2": "cetanāpaṇidhīhi ca / ",
  "thi-ap20:12.3": "jahitvā mānusaṃ dehaṃ ",
  "thi-ap20:12.4": "Tāvatiṃsaṃ agacch' ahaṃ // // ",
  "thi-ap20:13.1": "Imamhi bhaddake kappe ",
  "thi-ap20:13.2": "brahmabandhu mahāyaso / ",
  "thi-ap20:13.3": "Kassapo nāma nāmena ",
  "thi-ap20:13.4": "uppajji vadataṃ varo. // // ",
  "thi-ap20:14.1": "Upaṭṭhāko mahesissa ",
  "thi-ap20:14.2": "tadā āsi narissaro / ",
  "thi-ap20:14.3": "Kāsirājā Kikī nāma ",
  "thi-ap20:14.4": "Bārāṇasī-puruttame. // // ",
  "thi-ap20:15.1": "Tass' āsiṃ tatiyā dhītā ",
  "thi-ap20:15.2": "Bhikkhunī iti vissutā / ",
  "thi-ap20:15.3": "dhammaṃ *sutvā ji*naggassa ",
  "thi-ap20:15.4": "pabbajjaṃ samarocayiṃ. // // ",
  "thi-ap20:16.1": "Anujāni na no tāto ",
  "thi-ap20:16.2": "agāre va tadā mayaṃ / ",
  "thi-ap20:16.3": "vīsaṃ vassasahassāni ",
  "thi-ap20:16.4": "vicarimha atanditā. // // ",
  "thi-ap20:17.1": "Komārabrahmacariyaṃ ",
  "thi-ap20:17.2": "rājakaññā sukheṭhitā / Buddh' ",
  "thi-ap20:17.3": "upaṭṭhānaniratā ",
  "thi-ap20:17.4": "muditā satta dhītaro. // // ",
  "thi-ap20:18.1": "Sama*ṇī Sama*ṇaguttā ",
  "thi-ap20:18.2": "Bhikkhunī Bhikkhadāyikā / ",
  "thi-ap20:18.3": "Dhammā c' eva Sudhammā ca ",
  "thi-ap20:18.4": "sattamī Saṅghadāyikā. // // ",
  "thi-ap20:19.1": "Ahaṃ Uppalavaṇṇā ca ",
  "thi-ap20:19.2": "Khemā Bhaddā ca bhikkhunī / ",
  "thi-ap20:19.3": "Kisāgotamī Dhammadinnā ",
  "thi-ap20:19.4": "Visākhā hoti sattamī. // // ",
  "thi-ap20:20.1": "Tehi kammehi sukatehi ",
  "thi-ap20:20.2": "cetanāpaṇidhīhi ca / ",
  "thi-ap20:20.3": "jahitvā mānusaṃ dehaṃ ",
  "thi-ap20:20.4": "Tāvatiṃsaṃ agamhase. // // ",
  "thi-ap20:21.1": "Pacchime ca bhave dāni ",
  "thi-ap20:21.2": "jātā seṭṭhikule ahaṃ / ",
  "thi-ap20:21.3": "Sāvatthiyaṃ puravare ",
  "thi-ap20:21.4": "iddhe phīte mahādhane. // // ",
  "thi-ap20:22.1": "Yadā ca yobbanūpetā ",
  "thi-ap20:22.2": "vitakkavasagā ahaṃ / ",
  "thi-ap20:22.3": "naraṃ janapadaṃ disvā ",
  "thi-ap20:22.4": "tena saddhiṃ agañch' ahaṃ // // ",
  "thi-ap20:23.1": "*Ekapu*ttappasūtā 'haṃ ",
  "thi-ap20:23.2": "dutiyo kucchiyā mamaṃ / ",
  "thi-ap20:23.3": "tadā 'haṃ mātāpitaro ",
  "thi-ap20:23.4": "okkāmīti sunicchitā. // // ",
  "thi-ap20:24.1": "Na rocesi pati mayhaṃ; ",
  "thi-ap20:24.2": "tadā tamhi pavāsite / ",
  "thi-ap20:24.3": "ekikā niggatā gehā ",
  "thi-ap20:24.4": "gantuṃ Sāvatthim uttamaṃ. // // ",
  "thi-ap20:25.1": "Tato me sāmi āgantvā ",
  "thi-ap20:25.2": "sambhāvesi pathe mamaṃ / ",
  "thi-ap20:25.3": "*tadā me kamma*jā vātā ",
  "thi-ap20:25.4": "uppannā atidāruṇā. // // ",
  "thi-ap20:26.1": "Udito ca mahāmegho ",
  "thi-ap20:26.2": "pasūtisamaye mama / ",
  "thi-ap20:26.3": "dabbatthāya tadā gantvā ",
  "thi-ap20:26.4": "sāmi sappena mārito. // // ",
  "thi-ap20:27.1": "Tadā vijātadukkhena ",
  "thi-ap20:27.2": "anāthā kapaṇā ahaṃ / ",
  "thi-ap20:27.3": "kunnadiṃ pūritaṃ disvā ",
  "thi-ap20:27.4": "gacchantī sakuṇālayaṃ // // ",
  "thi-ap20:28.1": "Bālaṃ ādāya atariṃ ",
  "thi-ap20:28.2": "pārakūle ca ekako / ",
  "thi-ap20:28.3": "pāyetvā bālakaṃ puttam ",
  "thi-ap20:28.4": "itaraṃ taraṇāy' ahaṃ // // ",
  "thi-ap20:29.1": "Nivattā, ukkuso hāsi ",
  "thi-ap20:29.2": "taruṇaṃ vilapantakaṃ / ",
  "thi-ap20:29.3": "itarañ ca vahī soto, ",
  "thi-ap20:29.4": "sāhaṃ sokasa*mappi*tā. // // ",
  "thi-ap20:30.1": "Sāvatthinagaraṃ gantvā ",
  "thi-ap20:30.2": "assosiṃ sajane mate / ",
  "thi-ap20:30.3": "tadā avocaṃ sokaṭṭā ",
  "thi-ap20:30.4": "mahāsokasamappitā: // // ",
  "thi-ap20:31.1": "Ubho puttā kālakatā ",
  "thi-ap20:31.2": "panthe pati mama mato / ",
  "thi-ap20:31.3": "mātā pitā ca bhātā ca ",
  "thi-ap20:31.4": "ekacitamhi ḍayhare. // // ",
  "thi-ap20:32.1": "Tadā kisā ca paṇḍū ca ",
  "thi-ap20:32.2": "anāthā dīnamānasā / ",
  "thi-ap20:32.3": "ito tato bhamantī 'haṃ ",
  "thi-ap20:32.4": "addasaṃ narasārathiṃ. // // ",
  "thi-ap20:33.1": "Tato avoca mam satthā: ",
  "thi-ap20:33.2": "\"putte mā soci assasa / ",
  "thi-ap20:33.3": "attānaṃ te gavesassu; ",
  "thi-ap20:33.4": "kiṃ niratthaṃ vihaññasi? // // ",
  "thi-ap20:34.1": "Na santi puttā tāṇāya, ",
  "thi-ap20:34.2": "na pitā na pi bandhavā / ",
  "thi-ap20:34.3": "antakenādhipannassa ",
  "thi-ap20:34.4": "n' atthi ñātīsu tāṇatā\". // // ",
  "thi-ap20:35.1": "Taṃ sutvā munino vākyaṃ ",
  "thi-ap20:35.2": "paṭhamaṃ phalaṃ ajjhagaṃ / ",
  "thi-ap20:35.3": "pabbajitvāna naciraṃ ",
  "thi-ap20:35.4": "arahattaṃ apāpuṇiṃ. // // ",
  "thi-ap20:36.1": "Iddhīsu ca vasī homi ",
  "thi-ap20:36.2": "dibbāya sotadhātuyā / ",
  "thi-ap20:36.3": "paracittāni jānāmi ",
  "thi-ap20:36.4": "satthu sāsanakārikā. // // ",
  "thi-ap20:37.1": "Pubbenivāsaṃ jānāmi ",
  "thi-ap20:37.2": "dibbacakkhuṃ visodhitaṃ / ",
  "thi-ap20:37.3": "khepetvā āsave sabbe ",
  "thi-ap20:37.4": "visuddh' āsiṃ sunimmalā. // // ",
  "thi-ap20:38.1": "Tato 'haṃ Vinayaṃ sabbaṃ ",
  "thi-ap20:38.2": "santike sabbadassino / ",
  "thi-ap20:38.3": "uggahiṃ sabbavitthāraṃ ",
  "thi-ap20:38.4": "vyāhariñ ca yathātathaṃ. // // ",
  "thi-ap20:39.1": "Jino tasmiṃ guṇe tuṭṭho ",
  "thi-ap20:39.2": "etadagge ṭhapesi maṃ / ",
  "thi-ap20:39.3": "aggaṃ Vinayadhārīnaṃ ",
  "thi-ap20:39.4": "Paṭācārā ca ekikā. // // ",
  "thi-ap20:40.1": "Pariciṇṇo mayā satthā ",
  "thi-ap20:40.2": "ka*taṃ* Buddhassa sāsanaṃ / ",
  "thi-ap20:40.3": "ohito garuko bhāro ",
  "thi-ap20:40.4": "bhavanetti samūhatā. // // ",
  "thi-ap20:41.1": "Yass' atthāya pabbajitā ",
  "thi-ap20:41.2": "agārasmā 'nagāriyaṃ / ",
  "thi-ap20:41.3": "so me attho anuppatto ",
  "thi-ap20:41.4": "sabbasaṃyojanakkhayo. // // ",
  "thi-ap20:42.1": "Kilesā . . . ",
  "thi-ap20:42.2": "pe . . . ",
  "thi-ap20:42.3": "",
  "thi-ap20:43.1": "",
  "thi-ap20:43.2": "pe . . . ",
  "thi-ap20:43.3": "pe . . . // // Sāgataṃ . . . pe . . . pe . . . pe . . . // // ",
  "thi-ap20:44.1": "Paṭisambhidā . . . ",
  "thi-ap20:44.2": "pe . . . ",
  "thi-ap20:44.3": "pe . . . pe . . . // // ",
  "thi-ap20:45.1": "Itthaṃ sudaṃ Paṭācārā bhikkhunī i. g. a-ti. ",
  "thi-ap20:46.1": "Paṭācārāya bhikkhuniyā ",
  "thi-ap20:47.1": "apadānaṃ samattaṃ. ",
  "thi-ap20:48.1": "Uddānaṃ: ",
  "thi-ap20:49.1": "Ekūposathikā c' eva ",
  "thi-ap20:49.2": "Salaḷā ca Timodakā ",
  "thi-ap20:49.3": "*Ekāsanapadā-Dīpā ",
  "thi-ap20:49.4": "Nalamālī ca Go*tamī. ",
  "thi-ap20:50.1": "Khemā Uppalavaṇṇā ca ",
  "thi-ap20:50.2": "Paṭācārā ca bhikkhunī ",
  "thi-ap20:50.3": "gāthāsatāni cattāri navutiṃ ",
  "thi-ap20:50.4": "sattam eva ca "
}
