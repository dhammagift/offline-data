{
  "thi-ap38:0.1": "",
  "thi-ap38:0.2": "",
  "thi-ap38:0.3": "",
  "thi-ap38:1.1": "Vipassino bhagavato ",
  "thi-ap38:1.2": "Sikhino Vessabhussa ca / ",
  "thi-ap38:1.3": "Kakusandhassa munino ",
  "thi-ap38:1.4": "Konāgamana-tādino // // ",
  "thi-ap38:2.1": "Kassapassa ca Buddhassa ",
  "thi-ap38:2.2": "pabbajitvāna sāsane / ",
  "thi-ap38:2.3": "bhikkhunī sīlasampannā ",
  "thi-ap38:2.4": "nipakā saṃvutindriyā. // // ",
  "thi-ap38:3.1": "Bahussutā dhammadharā ",
  "thi-ap38:3.2": "atthatthaparipucchikā / ",
  "thi-ap38:3.3": "uggahetā ca dhammānaṃ ",
  "thi-ap38:3.4": "sotāpayirupāsikā. // // ",
  "thi-ap38:4.1": "Desentī janamajjhe 'haṃ ",
  "thi-ap38:4.2": "ahosiṃ jinasāsanaṃ / ",
  "thi-ap38:4.3": "bāhusaccena tenāhaṃ ",
  "thi-ap38:4.4": "pesalā atimaññisaṃ. // // ",
  "thi-ap38:5.1": "Pacchime ca bhave dāni ",
  "thi-ap38:5.2": "Sāvatthiyaṃ puruttame / ",
  "thi-ap38:5.3": "Anāthapiṇḍino gehe ",
  "thi-ap38:5.4": "jātā 'haṃ kumbhadāsiyā. // // ",
  "thi-ap38:6.1": "Gatā udakabhāriyaṃ ",
  "thi-ap38:6.2": "sotthiyaṃ dijam addasaṃ / ",
  "thi-ap38:6.3": "sītaṭṭaṃ toyamajjhamhi; ",
  "thi-ap38:6.4": "taṃ disvā idaṃ abraviṃ: // // ",
  "thi-ap38:7.1": "\"Udabhārī ahaṃ sīte ",
  "thi-ap38:7.2": "sadā udakam otariṃ / ",
  "thi-ap38:7.3": "ayyānaṃ daṇḍabhayā bhītā ",
  "thi-ap38:7.4": "vācādosabhayaṭṭitā. // // ",
  "thi-ap38:8.1": "Kassa brāhmaṇa tvaṃ bhīto? ",
  "thi-ap38:8.2": "sadā udakam otari / ",
  "thi-ap38:8.3": "vedhamānehi gattehi ",
  "thi-ap38:8.4": "sītaṃ vedayase bhusaṃ\" // // ",
  "thi-ap38:9.1": "\"Jānantī vata maṃ, hoti ",
  "thi-ap38:9.2": "Puṇṇike paripucchiyaṃ? / ",
  "thi-ap38:9.3": "karontaṃ kusalaṃ kammaṃ ",
  "thi-ap38:9.4": "niddhantaṃ kammapāpakaṃ // // ",
  "thi-ap38:10.1": "Yo ca vuddho *daha*ro vā ",
  "thi-ap38:10.2": "pāpakammaṃ pakubbati / ",
  "thi-ap38:10.3": "udakābhisecanā so pi ",
  "thi-ap38:10.4": "pāpakammā pam*uccati.\"* // // ",
  "thi-ap38:11.1": "Uttarantassa akkhāsiṃ ",
  "thi-ap38:11.2": "dhammatthaṃ sahitaṃ padaṃ / ",
  "thi-ap38:11.3": "tañ ca sutvā sasaṃviggo ",
  "thi-ap38:11.4": "pabbajitvā 'rahā ahū. // // ",
  "thi-ap38:12.1": "Pūrentī ūnaka*sa*taṃ ",
  "thi-ap38:12.2": "jātā dāsīkule yato / ",
  "thi-ap38:12.3": "*tato* Puṇṇā ti nāmaṃ me ",
  "thi-ap38:12.4": "bhujissañ ca akaṃsu te. // // ",
  "thi-ap38:13.1": "Seṭṭhiṃ tato 'numānetvā ",
  "thi-ap38:13.2": "pabbajiṃ anagāriyaṃ / ",
  "thi-ap38:13.3": "naciren' eva kālena ",
  "thi-ap38:13.4": "arahattaṃ apāpuṇiṃ. // // ",
  "thi-ap38:14.1": "Iddhīsu ca vasī homi ",
  "thi-ap38:14.2": "dibbāya sotadhātuyā / ",
  "thi-ap38:14.3": "cetopariyañāṇassa ",
  "thi-ap38:14.4": "vasī homi mahāmune. // // ",
  "thi-ap38:15.1": "Pubbenivāsaṃ jānāmi ",
  "thi-ap38:15.2": "dibbacakkhuṃ visodhitaṃ / ",
  "thi-ap38:15.3": "sabbāsavā parikkhīṇā ",
  "thi-ap38:15.4": "n' atthi dāni punabbhavo. // // ",
  "thi-ap38:16.1": "Atthadhammaniruttīsu ",
  "thi-ap38:16.2": "paṭibhāne tath' eva ca / ",
  "thi-ap38:16.3": "ñāṇaṃ me vipulaṃ suddhaṃ ",
  "thi-ap38:16.4": "Buddhaseṭṭhassa vāhasā. // // ",
  "thi-ap38:17.1": "Bhāvanāya mahappaññā ",
  "thi-ap38:17.2": "suten'eva sutāvinī / ",
  "thi-ap38:17.3": "mānena nīcakulajā ",
  "thi-ap38:17.4": "na hi kammaṃ panassati. // // ",
  "thi-ap38:18.1": "Kilesā . . . ",
  "thi-ap38:18.2": "pe . . . ",
  "thi-ap38:18.3": "",
  "thi-ap38:19.1": "",
  "thi-ap38:19.2": "pe . . . ",
  "thi-ap38:19.3": "pe . . . // // Sāgataṃ . . . pe . . . pe . . . pe . . . // // ",
  "thi-ap38:20.1": "Paṭisambhidā . . . ",
  "thi-ap38:20.2": "pe . . . ",
  "thi-ap38:20.3": "pe . . . pe . . . // // ",
  "thi-ap38:21.1": "Itthaṃ sudaṃ Puṇṇikā bhikkhunī i. g. a-ti. *Puṇṇikā ",
  "thi-ap38:22.1": "bhikkhuniyā apadānaṃ samattaṃ.* "
}
