  "thi-ap39:0.3": "",
  "thi-ap39:1.1": "Yo raṃsiphusitāvelo ",
  "thi-ap39:1.2": "Phusso nāma mahāmuni / ",
  "thi-ap39:1.3": "tassāhaṃ bhaginī āsiṃ ",
  "thi-ap39:1.4": "ajāyiṃ khattiye kule // // ",
  "thi-ap39:2.1": "Tassa dhammaṃ suṇitvā 'haṃ ",
  "thi-ap39:2.2": "vippasannena cetasā / ",
  "thi-ap39:2.3": "mahādānaṃ daditvāna ",
  "thi-ap39:2.4": "pathayiṃ rūpasampadaṃ. // // ",
  "thi-ap39:3.1": "Ekatiṃse ito kappe ",
  "thi-ap39:3.2": "Sikhī lokagganāyako / ",
  "thi-ap39:3.3": "uppanno lokapajjoto ",
  "thi-ap39:3.4": "tilokasaraṇo jino. // // ",
  "thi-ap39:4.1": "Tad' Āruṇapure ramme ",
  "thi-ap39:4.2": "brahmaññakulasambhavā / ",
  "thi-ap39:4.3": "vimuttacittaṃ kupitā ",
  "thi-ap39:4.4": "bhikkhuniṃ abhisāpayiṃ // // ",
  "thi-ap39:5.1": "Vesikā 'va anācārā ",
  "thi-ap39:5.2": "jinasāsanadūsikā. / ",
  "thi-ap39:5.3": "Evaṃ akkosayitvāna ",
  "thi-ap39:5.4": "tena pāpena kammanā // // ",
  "thi-ap39:6.1": "Dāruṇaṃ nirayaṃ gantvā ",
  "thi-ap39:6.2": "mahādukkhasamappitā / ",
  "thi-ap39:6.3": "tato cutā manussesu ",
  "thi-ap39:6.4": "uppannā tapassinī. // // ",
  "thi-ap39:7.1": "Dasa jātisahassāni ",
  "thi-ap39:7.2": "gaṇikattaṃ akārayiṃ / ",
  "thi-ap39:7.3": "taṃ pāpaṃ na vimuccissaṃ ",
  "thi-ap39:7.4": "bhuttā duṭṭhavisaṃ yathā. // // ",
  "thi-ap39:8.1": "Brahmaceram asevissaṃ ",
  "thi-ap39:8.2": "Kassape jinasāsane / ",
  "thi-ap39:8.3": "tena kammavipākena ",
  "thi-ap39:8.4": "ajāyiṃ Tidase pure. // // ",
  "thi-ap39:9.1": "Pacchime bhavasampatte ",
  "thi-ap39:9.2": "ahosiṃ opapātikā / ",
  "thi-ap39:9.3": "ambasākh' antare jātā ",
  "thi-ap39:9.4": "Ambapālī ti ten' ahaṃ. // // ",
  "thi-ap39:10.1": "Parivutā pāṇakoṭīhi ",
  "thi-ap39:10.2": "pabbajiṃ jinasāsane / ",
  "thi-ap39:10.3": "pattā 'haṃ acalaṭṭhānaṃ ",
  "thi-ap39:10.4": "dhītā Buddhassa orasā. // // ",
  "thi-ap39:11.1": "Iddhīsu ca vasī homi ",
  "thi-ap39:11.2": "sotadhātuvisuddhiyā / ",
  "thi-ap39:11.3": "cetopariyañāṇassa ",
  "thi-ap39:11.4": "vasī homi mahāmuni. // // ",
  "thi-ap39:12.1": "Pubbenivāsaṃ jānāmi ",
  "thi-ap39:12.2": "dibbacakkhuṃ visodhitaṃ / ",
  "thi-ap39:12.3": "sabbāsavā parikkhīṇā ",
  "thi-ap39:12.4": "n' atthi dāni punabbhavo. // // ",
  "thi-ap39:13.1": "Atthadhammaniruttīsu ",
  "thi-ap39:13.2": "paṭibhāne tath' eva ca / ",
  "thi-ap39:13.3": "ñāṇam me vipulaṃ suddhaṃ ",
  "thi-ap39:13.4": "Buddhaseṭṭhassa vāhasā // // ",
  "thi-ap39:14.1": "Kilesā . . . ",
  "thi-ap39:14.2": "pe . . . ",
  "thi-ap39:14.3": "",
  "thi-ap39:15.1": "",
  "thi-ap39:15.2": "pe . . . ",
  "thi-ap39:15.3": "pe . . . // // Sāgataṃ . . . pe . . . pe . . . pe . . . // // ",
  "thi-ap39:16.1": "Paṭisambhidā . . . ",
  "thi-ap39:16.2": "pe . . . ",
  "thi-ap39:16.3": "pe . . . pe . . . // // ",
  "thi-ap39:17.1": "Itthaṃ sudaṃ Ambapālī bhikkhunī i. g. a-ti. *Ambapālī- ",
  "thi-ap39:18.1": "bhikkhuniyā apadānaṃ samattaṃ.* "
}
