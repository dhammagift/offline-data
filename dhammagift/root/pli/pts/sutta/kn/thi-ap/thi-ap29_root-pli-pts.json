  "thi-ap29:1.1": "Kappe ca satasahasse ca ",
  "thi-ap29:1.2": "caturo ca asaṅkhiye / ",
  "thi-ap29:1.3": "Dīpaṅkaro nāma jino ",
  "thi-ap29:1.4": "uppajji lokanāyako. // // ",
  "thi-ap29:2.1": "Dīpaṅkaro mahāvīro ",
  "thi-ap29:2.2": "viyākāsi vināyako / ",
  "thi-ap29:2.3": "Sumedhañ ca Sumittañ ca ",
  "thi-ap29:2.4": "samānasukhadukkhataṃ // // ",
  "thi-ap29:3.1": "Sadevakañ ca passanto ",
  "thi-ap29:3.2": "vicaranto sadevakaṃ / ",
  "thi-ap29:3.3": "tesaṃ pakittane amha ",
  "thi-ap29:3.4": "*upaggamma* samāgamaṃ. // // ",
  "thi-ap29:4.1": "Amhaṃ sabbā patī honti ",
  "thi-ap29:4.2": "anāgatasamāgame / ",
  "thi-ap29:4.3": "sabbā va tuyhaṃ bhariyā ",
  "thi-ap29:4.4": "manāpā piyavādikā. // // ",
  "thi-ap29:5.1": "Dānasīlam ayaṃ sabbaṃ ",
  "thi-ap29:5.2": "bhāvanaṃ ca subhāvitaṃ / ",
  "thi-ap29:5.3": "dīgharattaṃ mayaṃ sabbaṃ ",
  "thi-ap29:5.4": "pariccattaṃ mahāmune // // ",
  "thi-ap29:6.1": "Gandhaṃ vilepanaṃ mālaṃ ",
  "thi-ap29:6.2": "dīpañ ca ratanāmayaṃ / ",
  "thi-ap29:6.3": "yaṃ kiñci patthitaṃ sabbaṃ ",
  "thi-ap29:6.4": "pariccattaṃ mahāmune // // ",
  "thi-ap29:7.1": "Aññaṃ cāpi kataṃ kammaṃ ",
  "thi-ap29:7.2": "paribhogañ ca mānusaṃ / ",
  "thi-ap29:7.3": "dīgharattaṃ no sabbaṃ ",
  "thi-ap29:7.4": "pariccattaṃ mahāmuni. // // ",
  "thi-ap29:8.1": "Anekajātisaṃsāraṃ ",
  "thi-ap29:8.2": "bahuṃ puññam hi no kataṃ / ",
  "thi-ap29:8.3": "issaram anubhotvāna ",
  "thi-ap29:8.4": "saṃsaritvā bhavābhave. // // ",
  "thi-ap29:9.1": "Pacchime bhavasampatte ",
  "thi-ap29:9.2": "Sakyaputta-nivesane / ",
  "thi-ap29:9.3": "nānākulupapannāyo ",
  "thi-ap29:9.4": "accharā kāmavaṇṇinī. // // ",
  "thi-ap29:10.1": "Lābhaggena *yasa*ppattā ",
  "thi-ap29:10.2": "pūpitā sabba-sakkatā / ",
  "thi-ap29:10.3": "lābhiyo annapānānaṃ ",
  "thi-ap29:10.4": "sadā sammānitā mayaṃ. // // ",
  "thi-ap29:11.1": "Agāraṃ pajahitvāna ",
  "thi-ap29:11.2": "pabbajiṃ anagāriyaṃ / ",
  "thi-ap29:11.3": "aṭṭhamāse asampatte ",
  "thi-ap29:11.4": "sabbā patt' amha nibbutiṃ. // // ",
  "thi-ap29:12.1": "Lābhiyo annapanānaṃ ",
  "thi-ap29:12.2": "vatthaṃ se*nā*sanāni ca / ",
  "thi-ap29:12.3": "upenti paccayā sabbe ",
  "thi-ap29:12.4": "sadā sakkata-pūjitā. // // ",
  "thi-ap29:13.1": "Kilesa . . . ",
  "thi-ap29:13.2": "pe . . . ",
  "thi-ap29:13.3": "",
  "thi-ap29:14.1": "",
  "thi-ap29:14.2": "pe . . . ",
  "thi-ap29:14.3": "pe . . . // // Sāgataṃ . . . pe . . . pe . . . pe . . . // // ",
  "thi-ap29:15.1": "Paṭisambhidā . . . ",
  "thi-ap29:15.2": "pe . . . ",
  "thi-ap29:15.3": "pe . . . pe . . . // // ",
  "thi-ap29:16.1": "Itthaṃ sudaṃ Yasovatī pamukhāni dasabhikkhu*nī* sahassāni bhagavato sammukhā i. g. a-ti. *Āyumāni Yasodharāpamukhānaṃ dasabhikkhunī- sahassānaṃ apadānaṃ samattaṃ.* [30.Yasodharā-pamukhāni aṭṭhārasabhikkhunī sahassāni.] ",
  "thi-ap29:17.1": ""
}
