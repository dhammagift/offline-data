  "tha-ap532:0.1": "",
  "tha-ap532:0.2": "",
  "tha-ap532:0.3": "",
  "tha-ap532:1.1": "Imamhi bhaddake kappe ",
  "tha-ap532:1.2": "brahmabandhu mahāyaso / ",
  "tha-ap532:1.3": "Kassapo nama nāmena ",
  "tha-ap532:1.4": "uppajji vadataṃ varo. // // ",
  "tha-ap532:2.1": "Anuvyañjanasampanno ",
  "tha-ap532:2.2": "dvattiṃsavaralakkhaṇo / ",
  "tha-ap532:2.3": "byāmappabhāparivuto ",
  "tha-ap532:2.4": "raṃsijālasamosaṭo. // // ",
  "tha-ap532:3.1": "Assāsetā yathā cando ",
  "tha-ap532:3.2": "suriyo va pabhaṅkaro / ",
  "tha-ap532:3.3": "nibbāpetā yathā megho ",
  "tha-ap532:3.4": "sāgaro va gaṇākaro. // // ",
  "tha-ap532:4.1": "Dharanī-r-iva sīlena ",
  "tha-ap532:4.2": "Himavā va samādhinā / ",
  "tha-ap532:4.3": "ākāso viya paññāya ",
  "tha-ap532:4.4": "asaṅgo anilo yathā. // // ",
  "tha-ap532:5.1": "Sa kadāci mahāviro ",
  "tha-ap532:5.2": "parisāsu visārado / ",
  "tha-ap532:5.3": "saccāni sampakāseti ",
  "tha-ap532:5.4": "uddharanto mahājanaṃ. // // ",
  "tha-ap532:6.1": "Tadā hi Bārāṇasiyam ",
  "tha-ap532:6.2": "seṭṭhiputto mahāyaso / ",
  "tha-ap532:6.3": "ās' ahaṃ dhanadhaññassa ",
  "tha-ap532:6.4": "pahūtassa pahū tadā // // ",
  "tha-ap532:7.1": "Jaṅghāvihāraṃ vicaraṃ ",
  "tha-ap532:7.2": "Migadāyam upecc' ahaṃ / ",
  "tha-ap532:7.3": "addasaṃ tādisaṃ Buddhaṃ ",
  "tha-ap532:7.4": "desentaṃ amataṃ padaṃ. // // ",
  "tha-ap532:8.1": "Vissaṭṭhakantavacanaṃ ",
  "tha-ap532:8.2": "karavīkasamassaraṃ / ",
  "tha-ap532:8.3": "haṃsadundubhi-nigghosaṃ ",
  "tha-ap532:8.4": "viññāpentaṃ mahājanaṃ // // ",
  "tha-ap532:9.1": "Disvā devātidevan taṃ ",
  "tha-ap532:9.2": "sutvā ca madhuraṃ giraṃ / ",
  "tha-ap532:9.3": "pahāy' ānappake bhoge ",
  "tha-ap532:9.4": "pabbajiṃ anagāriyaṃ. // // ",
  "tha-ap532:10.1": "Evaṃ pabbajito cāhaṃ ",
  "tha-ap532:10.2": "nacirena bahussuto / ",
  "tha-ap532:10.3": "ahosiṃ dhammakathiko ",
  "tha-ap532:10.4": "vicittapaṭibhānavā. // // ",
  "tha-ap532:11.1": "Mahāparisamajjhe 'haṃ ",
  "tha-ap532:11.2": "haṭṭhacitto punappunaṃ / ",
  "tha-ap532:11.3": "vaṇṇayiṃ hemavaṇṇassa ",
  "tha-ap532:11.4": "vaṇṇaṃ vaṇṇavisārado: // // ",
  "tha-ap532:12.1": "Esa khīṇāsavo Buddho ",
  "tha-ap532:12.2": "anīgho chinnasaṃsayo / ",
  "tha-ap532:12.3": "sabbakammakkhayaṃ patto ",
  "tha-ap532:12.4": "vimutto satisaṅkhaye. // // ",
  "tha-ap532:13.1": "Esa so bhagavā Buddho ",
  "tha-ap532:13.2": "esa sīho anuttaro / ",
  "tha-ap532:13.3": "sadevakassa lokassa ",
  "tha-ap532:13.4": "brahmacakkappavattako. // // ",
  "tha-ap532:14.1": "Danto dametā santo ca ",
  "tha-ap532:14.2": "sametā nibbuto isi / ",
  "tha-ap532:14.3": "nibbāpetā ca assattho ",
  "tha-ap532:14.4": "assāsetā mahājanaṃ. // // ",
  "tha-ap532:15.1": "Vīro suro ca dhīro ca ",
  "tha-ap532:15.2": "pañño kāruṇiko vasī / ",
  "tha-ap532:15.3": "vijitāvī ca sa jino ",
  "tha-ap532:15.4": "apagabbho anālayo. // // ",
  "tha-ap532:16.1": "Anejo acalo dhīmā ",
  "tha-ap532:16.2": "amoho asamo muni / ",
  "tha-ap532:16.3": "dhorayho usabho nāgo ",
  "tha-ap532:16.4": "sīho sakko gurūsu pi // // ",
  "tha-ap532:17.1": "Virāgo vimalo brahmā ",
  "tha-ap532:17.2": "vādisuro raṇañjaho / ",
  "tha-ap532:17.3": "akhilo ca visallo ca ",
  "tha-ap532:17.4": "asamo payato suci. // // ",
  "tha-ap532:18.1": "Brāhmaṇo samaṇo nātho ",
  "tha-ap532:18.2": "bhisakko sallakattako / ",
  "tha-ap532:18.3": "yodho Buddho suto sūto ",
  "tha-ap532:18.4": "acalo mudito 'sito. // // ",
  "tha-ap532:19.1": "Tātā tantā ca hantā ca ",
  "tha-ap532:19.2": "kattā netā pakāsitā / ",
  "tha-ap532:19.3": "sampahaṃsitā bhottā ca ",
  "tha-ap532:19.4": "chettā sotā pasaṃsitā // // ",
  "tha-ap532:20.1": "Akhilo ca visālo ca ",
  "tha-ap532:20.2": "anīgho akathaṅkathī / ",
  "tha-ap532:20.3": "anejo virajo khattā ",
  "tha-ap532:20.4": "gandhā mettā pakāsitā. // // ",
  "tha-ap532:21.1": "Tāretā atha tāretā ",
  "tha-ap532:21.2": "kāretā sampadāletā / ",
  "tha-ap532:21.3": "pāpetā sahitā ",
  "tha-ap532:21.4": "hantā hantā tātāpi tāpaso. // // ",
  "tha-ap532:22.1": "Samacitto samasamo ",
  "tha-ap532:22.2": "asahāyo dayāyaso / ",
  "tha-ap532:22.3": "accherasanto akuho ",
  "tha-ap532:22.4": "katāvīisi sattamo. // // ",
  "tha-ap532:23.1": "Nittiṇṇakaṅkho nimmāno ",
  "tha-ap532:23.2": "appameyyo anūpamo / ",
  "tha-ap532:23.3": "sabbavākyapathātīto ",
  "tha-ap532:23.4": "saccaneyyantago jino. // // ",
  "tha-ap532:24.1": "Sattasāravare tasmiṃ ",
  "tha-ap532:24.2": "pasādo amatāvaho / ",
  "tha-ap532:24.3": "tasmā Buddhe ca dhamme ca ",
  "tha-ap532:24.4": "saṅghe saddhā mahiddhikā. // // ",
  "tha-ap532:25.1": "Guṇehi evamādīhi ",
  "tha-ap532:25.2": "tilokasaraṇuttamaṃ / ",
  "tha-ap532:25.3": "vaṇṇento parisāmajjhe ",
  "tha-ap532:25.4": "akaṃ dhammakathaṃ ahaṃ. // // ",
  "tha-ap532:26.1": "Tato cuto 'haṃ Tusite ",
  "tha-ap532:26.2": "anubhotvā mahāsukhaṃ / ",
  "tha-ap532:26.3": "tato cuto manussesu ",
  "tha-ap532:26.4": "jāto homi sugandhiko. // // ",
  "tha-ap532:27.1": "Nissāso mukhagandho ca ",
  "tha-ap532:27.2": "dehagandho tath' eva me / ",
  "tha-ap532:27.3": "sedagandho ca satatam ",
  "tha-ap532:27.4": "sabbagandho ti seti me. // // ",
  "tha-ap532:28.1": "Mukhagandho sadā mayhaṃ ",
  "tha-ap532:28.2": "padumuppalacampake / ",
  "tha-ap532:28.3": "atisanto sadā vāti ",
  "tha-ap532:28.4": "sarīro ca tath' eva me. // // ",
  "tha-ap532:29.1": "Guṇatthavassapupphan taṃ ",
  "tha-ap532:29.2": "phalan tu param abbhutaṃ / ",
  "tha-ap532:29.3": "ekaggamanasā sabbe ",
  "tha-ap532:29.4": "vaṇṇayissaṃ suṇotha me: // // ",
  "tha-ap532:30.1": "Guṇaṃ Buddhassa vatvāna ",
  "tha-ap532:30.2": "hitāya janasandhisu / ",
  "tha-ap532:30.3": "sukhito homi sabbattha ",
  "tha-ap532:30.4": "rasaddhovisamāyuto. // // ",
  "tha-ap532:31.1": "Yasassī sukhito kanto ",
  "tha-ap532:31.2": "jutimā piyadassano / ",
  "tha-ap532:31.3": "vattā aparibhūto ca ",
  "tha-ap532:31.4": "niddoso paññavā tathā. // // ",
  "tha-ap532:32.1": "Khīṇ' ev' āyu pi nibbānaṃ ",
  "tha-ap532:32.2": "sulabhaṃ Buddhabhattino / ",
  "tha-ap532:32.3": "tesaṃ hetuṃ pavakkhāmi ",
  "tha-ap532:32.4": "taṃ suṇotha yathātathaṃ. // // ",
  "tha-ap532:33.1": "Santaṃ yasaṃ bhagavato ",
  "tha-ap532:33.2": "vidhinā abhivādayaṃ / ",
  "tha-ap532:33.3": "yattha tatth' upapanno pi ",
  "tha-ap532:33.4": "yasassī tena bhom' ahaṃ. // // ",
  "tha-ap532:34.1": "Dukkhantakaraṇaṃ Buddhaṃ ",
  "tha-ap532:34.2": "dhammaṃ santam asaṅkhataṃ / ",
  "tha-ap532:34.3": "vaṇṇayaṃ sukhado āsiṃ ",
  "tha-ap532:34.4": "sattānaṃ sukhito tato. // // ",
  "tha-ap532:35.1": "Guṇaṃ vadanto Buddhassa ",
  "tha-ap532:35.2": "Buddhapītisamāyuto / ",
  "tha-ap532:35.3": "sakantim parakantiñ ca ",
  "tha-ap532:35.4": "janayiṃ tena kantimā. // // ",
  "tha-ap532:36.1": "Janoghe titthikākiṇṇo ",
  "tha-ap532:36.2": "abhibhuyya kutitthiye / ",
  "tha-ap532:36.3": "guṇaṃ vadanto jotesiṃ ",
  "tha-ap532:36.4": "nāyakaṃ jutimā tato. // // ",
  "tha-ap532:37.1": "Piyakārijinassāpi ",
  "tha-ap532:37.2": "sambuddhassa guṇaṃ varaṃ / saraṃ ",
  "tha-ap532:37.3": "divasasaṅko 'haṃ ",
  "tha-ap532:37.4": "ten' āsiṃ piyadassano. // // ",
  "tha-ap532:38.1": "Yathāsattivasenāhaṃ ",
  "tha-ap532:38.2": "sabbavācāhi santhaviṃ / ",
  "tha-ap532:38.3": "sugataṃ tena vāgīso ",
  "tha-ap532:38.4": "vicittapaṭibhānavā. // // ",
  "tha-ap532:39.1": "Ye bālā vimatiṃ pattā ",
  "tha-ap532:39.2": "paribhonti mahāmuniṃ / ",
  "tha-ap532:39.3": "niggahiṃ te saddhammena ",
  "tha-ap532:39.4": "paribhūto na ten' ahaṃ // // ",
  "tha-ap532:40.1": "Buddhavaṇṇehi sattānaṃ ",
  "tha-ap532:40.2": "kilese apaniṃ ahaṃ / ",
  "tha-ap532:40.3": "nikkilesamano homi ",
  "tha-ap532:40.4": "tassa kammassa vāhasā. // // ",
  "tha-ap532:41.1": "Sotūnaṃ Buddhim ajaniṃ ",
  "tha-ap532:41.2": "Buddhānussatidesako / ",
  "tha-ap532:41.3": "tenāham āsiṃ sappañño ",
  "tha-ap532:41.4": "nipuṇatthavipassako. // // ",
  "tha-ap532:42.1": "Sabbāsavaparikkhīṇo ",
  "tha-ap532:42.2": "tiṇṇasaṃsārasāgaro / ",
  "tha-ap532:42.3": "sikhī va anupādāno ",
  "tha-ap532:42.4": "pāpuṇissāmi nibbutiṃ. // // ",
  "tha-ap532:43.1": "Imasmiṃ yeva kappasmiṃ ",
  "tha-ap532:43.2": "yam ahaṃ santhaviṃ jinaṃ / ",
  "tha-ap532:43.3": "duggatiṃ nābhijānāmi ",
  "tha-ap532:43.4": "Buddhavaṇṇass' idaṃ phalaṃ. // // ",
  "tha-ap532:44.1": "Kilesā . . . ",
  "tha-ap532:44.2": "pe . . . ",
  "tha-ap532:44.3": "",
  "tha-ap532:45.1": "",
  "tha-ap532:45.2": "pe . . . ",
  "tha-ap532:45.3": "pe . . . // // Sāgataṃ . . . pe . . . pe . . . pe . . . // // ",
  "tha-ap532:46.1": "Paṭisambhidā . . . ",
  "tha-ap532:46.2": "pe . . . ",
  "tha-ap532:46.3": "pe . . . pe . . . // // ",
  "tha-ap532:47.1": "Itthaṃ sudaṃ āyasmā Sugandho thero i. g. a- ti. Sugandhattherassa ",
  "tha-ap532:48.1": "",
  "tha-ap532:49.1": "apadānaṃ samattaṃ. ",
  "tha-ap532:50.1": "Uddānaṃ: ",
  "tha-ap532:51.1": "Tiṇado Pecchado c' eva ",
  "tha-ap532:51.2": "Saraṇ Abbhañjanappado ",
  "tha-ap532:51.3": "Pūpaṭī Daṇḍadāyī ca ",
  "tha-ap532:51.4": "Nelapūji tath' eva ca ",
  "tha-ap532:52.1": "Bodhisammajjako 'Maṇḍo ",
  "tha-ap532:52.2": "Sugandho dasamo dijo ",
  "tha-ap532:52.3": "gāthā sataṃ satevīsaṃ ",
  "tha-ap532:52.4": "gaṇitañ c' ettha sabbaso. "
}
