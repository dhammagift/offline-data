  "tha-ap361:1.1": "tadā nāvaṃ ",
  "tha-ap361:1.2": "bhikkhu c' Ajīvako c' ahaṃ / ",
  "tha-ap361:1.3": "nāvāya bhijjamānāya ",
  "tha-ap361:1.4": "bhikkhu me saraṇam adā. // // ",
  "tha-ap361:2.1": "Ekatiṃse ito kappe ",
  "tha-ap361:2.2": "yañ ca me saraṇam adā / ",
  "tha-ap361:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap361:2.4": "saraṇāgamane idaṃ phalaṃ. // // ",
  "tha-ap361:3.1": "Paṭisambhidā . . . ",
  "tha-ap361:3.2": "pe . . . ",
  "tha-ap361:3.3": "pe . . . // // ",
  "tha-ap361:4.1": "Itthaṃ sudam āyasmā Saraṇāgamaniyo thero i. g. a-ti. Saraṇāgamaniyattherassa apadānaṃ samattaṃ. ",
  "tha-ap361:5.1": ""
}
