  "tha-ap277:1.1": "Udumbare vasanta*ssa ",
  "tha-ap277:1.2": "niyate paṇṇasa*nthare / ",
  "tha-ap277:1.3": "vutthokāso mayā dinno ",
  "tha-ap277:1.4": "samaṇassa mahesino. // // ",
  "tha-ap277:2.1": "Tissassa dipadindassa ",
  "tha-ap277:2.2": "lokanāthassa tādino / ",
  "tha-ap277:2.3": "añjaliṃ paggahetvāna ",
  "tha-ap277:2.4": "santhariṃ pupphasantharaṃ. // // ",
  "tha-ap277:3.1": "Dvenavute ito kappe ",
  "tha-ap277:3.2": "yaṃ 'kariṃ pupphasantharaṃ / ",
  "tha-ap277:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap277:3.4": "*santharassa* idaṃ phalaṃ. // // ",
  "tha-ap277:4.1": "Ito cuddasakappamhi ",
  "tha-ap277:4.2": "ahosiṃ manujādhipo / ",
  "tha-ap277:4.3": "Eka-añjaliko nāma ",
  "tha-ap277:4.4": "cakkavattī mahabbalo. // // ",
  "tha-ap277:5.1": "Paṭisambhidā . . . ",
  "tha-ap277:5.2": "pe . . . ",
  "tha-ap277:5.3": "pe . . . // // ",
  "tha-ap277:6.1": "Itthaṃ sudam āyasmā Ekañjaliyo thero i. g. a-ti. Ekañjaliyattherassa ",
  "tha-ap277:7.1": "apadānaṃ samattaṃ. "
}
