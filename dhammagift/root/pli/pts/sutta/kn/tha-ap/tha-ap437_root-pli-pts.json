  "tha-ap437:1.1": "Nagare Bandhumatiyā ",
  "tha-ap437:1.2": "dvārapālo ahos' ahaṃ / ",
  "tha-ap437:1.3": "addasaṃ virajaṃ Buddhaṃ ",
  "tha-ap437:1.4": "sabbadhammāna pāraguṃ. // // ",
  "tha-ap437:2.1": "Ucchukaṇḍikam ādāya ",
  "tha-ap437:2.2": "buddhaseṭṭhass' adās' ahaṃ / ",
  "tha-ap437:2.3": "pasannacitto sumano ",
  "tha-ap437:2.4": "Vipassissa mahesino. // // ",
  "tha-ap437:3.1": "Ekanavute ito kappe ",
  "tha-ap437:3.2": "yaṃ ucchum adadiṃ tadā / ",
  "tha-ap437:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap437:3.4": "ucchukaṇḍass' idaṃ phalaṃ. // // ",
  "tha-ap437:4.1": "Kilesā . . . ",
  "tha-ap437:4.2": "pe . . . ",
  "tha-ap437:4.3": "",
  "tha-ap437:5.1": "",
  "tha-ap437:5.2": "pe . . . ",
  "tha-ap437:5.3": "pe . . . // // Sāgataṃ . . . pe . . . pe . . . pe . . . // // ",
  "tha-ap437:6.1": "Paṭisambhidā . . . ",
  "tha-ap437:6.2": "pe . . . ",
  "tha-ap437:6.3": "pe . . . pe . . . // // ",
  "tha-ap437:7.1": "Itthaṃ sudaṃ āyasmā Ucchukaṇḍiko thero i. g. a-ti. Ucchukaṇḍikattherassa ",
  "tha-ap437:8.1": "apadānaṃ samattaṃ. "
}
