  "tha-ap97:0.2": "",
  "tha-ap97:0.3": "",
  "tha-ap97:1.1": "Siddhatthassa bhagavato ",
  "tha-ap97:1.2": "gandhathūpaṃ akās' ahaṃ / ",
  "tha-ap97:1.3": "sumanehi paṭicchannaṃ ",
  "tha-ap97:1.4": "Buddhānucchavikaṃ ahaṃ. // // ",
  "tha-ap97:2.1": "Kañcanagghiyasaṅkāsaṃ ",
  "tha-ap97:2.2": "Buddhaṃ lokagganāyakaṃ / ",
  "tha-ap97:2.3": "indīvaraṃ va jalitaṃ ",
  "tha-ap97:2.4": "ādittaṃ va hutāsanaṃ. // // ",
  "tha-ap97:3.1": "Vyagghusabhaṃ va pavaraṃ ",
  "tha-ap97:3.2": "abhijātaṃ va kesariṃ / ",
  "tha-ap97:3.3": "nisinnaṃ samaṇānaggaṃ ",
  "tha-ap97:3.4": "bhikkhusaṅghapurakhattaṃ / ",
  "tha-ap97:4.1": "vanditvā satthuno pāde ",
  "tha-ap97:4.2": "pakkāmiṃ uttarāmukho. // // ",
  "tha-ap97:4.3": "Catunavut' ito kappe ",
  "tha-ap97:4.4": "gandhamālaṃ yato adaṃ / ",
  "tha-ap97:5.1": "Buddhe katassa kārassa ",
  "tha-ap97:5.2": "phalenāhaṃ visesato / ",
  "tha-ap97:5.3": "duggatiṃ nābhijānāmi ",
  "tha-ap97:5.4": "Buddhapujāy' idaṃ phalaṃ. // // ",
  "tha-ap97:6.1": "Cattārisamhi ekūne ",
  "tha-ap97:6.2": "kappe āsiṃsu soḷasa / ",
  "tha-ap97:6.3": "Devagandhasanāmā te ",
  "tha-ap97:6.4": "rājāno cakkavattino. // // ",
  "tha-ap97:7.1": "Paṭisambhidā catasso ",
  "tha-ap97:7.2": "vimokhā pi ca aṭṭh' ime / chaḍabhiññā sacchikatā ",
  "tha-ap97:7.3": "kataṃ Buddhassa sāsanan ti. // // ",
  "tha-ap97:8.1": "Itthaṃ sudaṃ āyasmā Gandhamāliyo thero imā gāthāyo abhāsitthā ti. Gandhamāliyattherasso apadānaṃ samattaṃ. ",
  "tha-ap97:9.1": ""
}
