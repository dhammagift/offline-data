{
  "tha-ap132:0.1": "",
  "tha-ap132:0.2": "",
  "tha-ap132:0.3": "",
  "tha-ap132:1.1": "",
  "tha-ap132:1.2": "Gotamo nāma pabbato / ",
  "tha-ap132:1.3": "nānārukkhehi sañchanno ",
  "tha-ap132:1.4": "mahābhūtāgaṇālayo. // // ",
  "tha-ap132:2.1": "Vemajjhamhi ca tass' āsi ",
  "tha-ap132:2.2": "assamo abhinimmito / ",
  "tha-ap132:2.3": "purakkhato sasissehi ",
  "tha-ap132:2.4": "vasāmi assame ahaṃ. // // ",
  "tha-ap132:3.1": "‘Āyantu me sissagaṇā ",
  "tha-ap132:3.2": "padumaṃ āharantu me / ",
  "tha-ap132:3.3": "Buddhapūjaṃ karissāma ",
  "tha-ap132:3.4": "dipadindassa tādino.' // // ",
  "tha-ap132:4.1": "Evan ti te paṭissutvā ",
  "tha-ap132:4.2": "padumaṃ āhariṃsu me / ",
  "tha-ap132:4.3": "tathā nimittaṃ katvā 'haṃ ",
  "tha-ap132:4.4": "Buddhassa abhiropayiṃ. // // ",
  "tha-ap132:5.1": "Sisse tadā samānetvā ",
  "tha-ap132:5.2": "sādhukaṃ anusās' ahaṃ: / ",
  "tha-ap132:5.3": "mā kho tumhe pamajjittha, ",
  "tha-ap132:5.4": "appamādo sukhāvaho. // // ",
  "tha-ap132:6.1": "Evaṃ samanusāsitvā ",
  "tha-ap132:6.2": "te sisse vacanakkhame / ",
  "tha-ap132:6.3": "appamādaguṇe yutto ",
  "tha-ap132:6.4": "tadā kalakato ahaṃ. // // ",
  "tha-ap132:7.1": "Ekanavute ito kappe ",
  "tha-ap132:7.2": "yaṃ puppham abhiropayiṃ / ",
  "tha-ap132:7.3": "duggatiṃ nābhijānāmi ",
  "tha-ap132:7.4": "Buddhapūjāy' idaṃ phalaṃ. // // ",
  "tha-ap132:8.1": "Ekapaññāsakappamhi ",
  "tha-ap132:8.2": "rājā āsi Jaluttamo / ",
  "tha-ap132:8.3": "sattaratanasampanno ",
  "tha-ap132:8.4": "cakkavattī mahābalo. // // ",
  "tha-ap132:9.1": "Paṭisambhidā . . . ",
  "tha-ap132:9.2": "pe . . . ",
  "tha-ap132:9.3": "pe . . . // // ",
  "tha-ap132:10.1": "Itthaṃ sudaṃ āyasmā Padumapūjako thero imā gāthāyo abhāsitthā ti. Padumapūjakattherassa apadānaṃ samattaṃ. ",
  "tha-ap132:11.1": "",
  "tha-ap132:12.1": "",
  "tha-ap132:13.1": "Uddānaṃ: ",
  "tha-ap132:14.1": "Sereyyako Pupphathūpi ",
  "tha-ap132:14.2": "Pāyās'-Odaki-Thomako ",
  "tha-ap132:14.3": "Āsanī-Phala-Saññī ca ",
  "tha-ap132:14.4": "Gaṇṭhi-Padumapupphiyo ",
  "tha-ap132:14.5": "Pañcuttarasatā-gāthā ",
  "tha-ap132:14.6": "bhaṇitā atthadassīhi. Padummuttaro "
}
