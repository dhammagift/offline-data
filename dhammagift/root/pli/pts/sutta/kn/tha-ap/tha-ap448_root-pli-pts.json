  "tha-ap448:1.1": "Supupphitaṃ sālavanam ",
  "tha-ap448:1.2": "ogayha Vessabhū muni / ",
  "tha-ap448:1.3": "nisīdi giriduggesu ",
  "tha-ap448:1.4": "abhijāto va kesarī. // // ",
  "tha-ap448:2.1": "Pasannacitto sumano ",
  "tha-ap448:2.2": "ambāṭakam apūjayiṃ / ",
  "tha-ap448:2.3": "puññakkhettaṃ mahāvīraṃ ",
  "tha-ap448:2.4": "pasanno sehi pāṇihi. // // ",
  "tha-ap448:3.1": "Ekatiṃse ito kappe ",
  "tha-ap448:3.2": "yaṃ puppham abhiropayiṃ / ",
  "tha-ap448:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap448:3.4": "Buddhapūjāy' idaṃ phalaṃ. // // ",
  "tha-ap448:4.1": "Kilesā . . . ",
  "tha-ap448:4.2": "pe . . . ",
  "tha-ap448:4.3": "",
  "tha-ap448:5.1": "",
  "tha-ap448:5.2": "pe . . . ",
  "tha-ap448:5.3": "pe . . . // // Sāgataṃ . . . pe . . . pe . . . pe . . . // // ",
  "tha-ap448:6.1": "Paṭisambhidā . . . ",
  "tha-ap448:6.2": "pe . . . ",
  "tha-ap448:6.3": "pe . . . pe . . . // // ",
  "tha-ap448:7.1": "Itthaṃ sudam āyasmā Ambāṭakiyo thero i. g. a-ti. Ambāṭakiyattherassa ",
  "tha-ap448:8.1": "apadānaṃ samattaṃ. "
}
