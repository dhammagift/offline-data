{
  "tha-ap109:0.1": "",
  "tha-ap109:0.2": "",
  "tha-ap109:0.3": "",
  "tha-ap109:1.1": "Padumuttarabuddhassa ",
  "tha-ap109:1.2": "lokajeṭṭhassa tādino / ",
  "tha-ap109:1.3": "tiṇantare nisinnassa ",
  "tha-ap109:1.4": "upasantassa tādino // // ",
  "tha-ap109:2.1": "Naḷamālaṃ gahetvāna ",
  "tha-ap109:2.2": "bandhitvā vījanim ahaṃ / ",
  "tha-ap109:2.3": "Buddhassa upanāmesiṃ ",
  "tha-ap109:2.4": "dipadindassa tādino. // // ",
  "tha-ap109:3.1": "Paṭiggahetvā sabbaññū ",
  "tha-ap109:3.2": "vījaniṃ lokanāyako / ",
  "tha-ap109:3.3": "mama saṅkappam aññāya ",
  "tha-ap109:3.4": "imā gāthā abhāsatha: // // ",
  "tha-ap109:4.1": "‘Yathā me kāyo nibbāyi ",
  "tha-ap109:4.2": "pariḷāho na vijjati / ",
  "tha-ap109:4.3": "tath' eva tividhaggīhi ",
  "tha-ap109:4.4": "cittaṃ tava vimuccatu.' // // ",
  "tha-ap109:5.1": "Sabbe devā samāgañchuṃ ",
  "tha-ap109:5.2": "ye keci dumanissitā: / ",
  "tha-ap109:5.3": "‘sussāma Buddhavacanaṃ ",
  "tha-ap109:5.4": "hāsayantañ ca dāyakaṃ.' // // ",
  "tha-ap109:6.1": "Nisinno bhagavā tattha ",
  "tha-ap109:6.2": "devasaṅghapurakkhato / ",
  "tha-ap109:6.3": "dāyakaṃ sampahaṃsento ",
  "tha-ap109:6.4": "imā gāthā abhāsatha: // // ",
  "tha-ap109:7.1": "‘Iminā vījadānena ",
  "tha-ap109:7.2": "cittassa paṇidhīhi ca / ",
  "tha-ap109:7.3": "Subbato nāma nāmena ",
  "tha-ap109:7.4": "cakkavatti bhavissati. // // ",
  "tha-ap109:8.1": "Tena kammāvasesena ",
  "tha-ap109:8.2": "sukkamūlena codito / ",
  "tha-ap109:8.3": "Māluto nāma nāmena ",
  "tha-ap109:8.4": "cakkavattī bhavissati. // // ",
  "tha-ap109:9.1": "Iminā vījadānena ",
  "tha-ap109:9.2": "sammānavipulena ca / ",
  "tha-ap109:9.3": "kappasatasahassam-hi ",
  "tha-ap109:9.4": "duggatiṃ nūpapajjati.' // // ",
  "tha-ap109:10.1": "Tiṃsakappasahassamhi ",
  "tha-ap109:10.2": "subbatā aṭṭh' ahiṃsu te / ",
  "tha-ap109:10.3": "ekūnatiṃse sahasse ",
  "tha-ap109:10.4": "aṭṭha Mālutanāmakā\". // // ",
  "tha-ap109:11.1": "Paṭisambhidā catasso ",
  "tha-ap109:11.2": "vimokhā pi ca aṭṭh' ime / chaḍabhiññā sacchikatā ",
  "tha-ap109:11.3": "kataṃ Buddhassa sāsanan ti. // // ",
  "tha-ap109:12.1": "Itthaṃ sudaṃ āyasmā Nalamāliyo thero imā gāthāyo abhāsitthāti. Nalamāliyattherassa apadānaṃ samattaṃ. Sattamaṃ ",
  "tha-ap109:13.1": "",
  "tha-ap109:13.2": "bhāṇavāraṃ niṭṭhitaṃ. "
}
