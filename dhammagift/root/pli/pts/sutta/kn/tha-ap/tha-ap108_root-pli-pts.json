  "tha-ap108:0.2": "",
  "tha-ap108:0.3": "",
  "tha-ap108:1.1": "Suvaṇṇavaṇṇaṃ sambuddhaṃ ",
  "tha-ap108:1.2": "gacchantaṃ anilañjase / ",
  "tha-ap108:1.3": "ghatāsanaṃ va jalitaṃ ",
  "tha-ap108:1.4": "ādittaṃ va hutāsanaṃ. // // ",
  "tha-ap108:2.1": "Pāṇinā udakaṃ gayha ",
  "tha-ap108:2.2": "ākāse ukkhipim ahaṃ / ",
  "tha-ap108:2.3": "sampaṭicchi mahāvīro ",
  "tha-ap108:2.4": "Buddho kāruṇiko mayi. // // ",
  "tha-ap108:3.1": "Antalikkhe ṭhito satthā ",
  "tha-ap108:3.2": "Padumuttaranāyako / ",
  "tha-ap108:3.3": "mama saṅkappam aññāya ",
  "tha-ap108:3.4": "imā gāthā abhāsatha: // // ",
  "tha-ap108:4.1": "‘Imin' odakadānena ",
  "tha-ap108:4.2": "pītiuppādanena ca / ",
  "tha-ap108:4.3": "kappasatasahassam hi ",
  "tha-ap108:4.4": "duggatiṃ nūpagacchati.' // // ",
  "tha-ap108:5.1": "Tena kammena dipadinda ",
  "tha-ap108:5.2": "lokajeṭṭha narāsabha / ",
  "tha-ap108:5.3": "patto 'mhi acalaṃ ṭhānaṃ ",
  "tha-ap108:5.4": "hitvā jayaparājayaṃ. // // ",
  "tha-ap108:6.1": "Sahassarāja-nāmena ",
  "tha-ap108:6.2": "tayo te cakkavattino / ",
  "tha-ap108:6.3": "pañcasaṭṭhikappasate ",
  "tha-ap108:6.4": "cāturantā janādhipā. // // ",
  "tha-ap108:7.1": "Paṭisambhidā catasso ",
  "tha-ap108:7.2": "vimokhā pi ca aṭṭh' ime / chaḍabhiññā sacchikatā ",
  "tha-ap108:7.3": "kataṃ Buddhassa sāsanan ti. // // ",
  "tha-ap108:8.1": "Itthaṃ sudaṃ āyasmā Udakapūjako thero imā gāthāyo abhāsitthāti. Udakapūjakatherassa apadānaṃ samattaṃ. ",
  "tha-ap108:9.1": ""
}
