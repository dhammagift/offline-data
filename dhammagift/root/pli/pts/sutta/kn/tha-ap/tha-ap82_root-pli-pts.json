{
  "tha-ap82:0.1": "",
  "tha-ap82:0.2": "",
  "tha-ap82:0.3": "",
  "tha-ap82:1.1": "Padumuttaro nāma jino ",
  "tha-ap82:1.2": "sabbadhammāna pāragū / ",
  "tha-ap82:1.3": "danto dantaparivuto ",
  "tha-ap82:1.4": "nagarā nikkhamī jino. // // ",
  "tha-ap82:2.1": "Nagare Haṃsavatiyā ",
  "tha-ap82:2.2": "ahosiṃ māliko tadā / ",
  "tha-ap82:2.3": "yaṃ tattha uttamaṃ pupphaṃ tīṇi ",
  "tha-ap82:2.4": "pupphāni aggahiṃ. // // ",
  "tha-ap82:3.1": "Addasaṃ virajaṃ *Buddhaṃ ",
  "tha-ap82:3.2": "paṭimaggantarāpaṇe* / ",
  "tha-ap82:3.3": "so 'haṃ disvāna sambuddhaṃ ",
  "tha-ap82:3.4": "evaṃ cintes' ahaṃ tadā: // // ",
  "tha-ap82:4.1": "‘Kim me imehi pupphehi ",
  "tha-ap82:4.2": "rañño upanītehi me? / ",
  "tha-ap82:4.3": "Gāmaṃ vā gāmakkhettaṃ vā ",
  "tha-ap82:4.4": "sahassaṃ vā labheyya 'haṃ. // // ",
  "tha-ap82:5.1": "Adantadamakaṃ *dhīraṃ ",
  "tha-ap82:5.2": "sabbasattasukhāvahaṃ* / ",
  "tha-ap82:5.3": "lokanāthaṃ pūjayitvā ",
  "tha-ap82:5.4": "lacchāmi amitaṃ dhanaṃ.' // // ",
  "tha-ap82:6.1": "Evāhaṃ cintayitvāna ",
  "tha-ap82:6.2": "sakaṃ cittaṃ pasādayiṃ / ",
  "tha-ap82:6.3": "tīṇi lohitake gayha ",
  "tha-ap82:6.4": "ākāse ukkhipiṃ tadā. // // ",
  "tha-ap82:7.1": "Mayā ukkhittamattam hi ",
  "tha-ap82:7.2": "ākāse patthariṃsu te / ",
  "tha-ap82:7.3": "dhāriṃsu matthake tattha ",
  "tha-ap82:7.4": "uddhavaṇṭā adhomukhā. // // ",
  "tha-ap82:8.1": "Ye keci manujā disvā ",
  "tha-ap82:8.2": "ukkuṭṭhiṃ sampavattayuṃ / ",
  "tha-ap82:8.3": "devatā antalikkhamhi ",
  "tha-ap82:8.4": "sādhukāraṃ pavattayuṃ: // // ",
  "tha-ap82:9.1": "‘Accheraṃ loke uppannaṃ ",
  "tha-ap82:9.2": "buddhaseṭṭhassa vāhasā / ",
  "tha-ap82:9.3": "sabbe dhammaṃ suṇissāma ",
  "tha-ap82:9.4": "pupphānaṃ vāhasā mayaṃ.' // // ",
  "tha-ap82:10.1": "Padumuttaro lokavidū ",
  "tha-ap82:10.2": "āhutīnaṃ paṭiggaho / ",
  "tha-ap82:10.3": "vīthiyam hi ṭhito satthā ",
  "tha-ap82:10.4": "imā gāthā abhāsatha: // // ",
  "tha-ap82:11.1": "‘Yo so buddhaṃ apūjesi ",
  "tha-ap82:11.2": "rattapadumehi tadā / ",
  "tha-ap82:11.3": "tam ahaṃ kittayissāmi; ",
  "tha-ap82:11.4": "suṇotha mama bhāsato:' // // ",
  "tha-ap82:12.1": "Tiṃsakappasahassāni ",
  "tha-ap82:12.2": "devaloke ramissati / ",
  "tha-ap82:12.3": "tiṃsakappāni devindo ",
  "tha-ap82:12.4": "devarajjam karissati. // // ",
  "tha-ap82:13.1": "Mahāvitthārikaṃ nāma ",
  "tha-ap82:13.2": "vyamhaṃ hessati tāvade / ",
  "tha-ap82:13.3": "tiyojanasatubbeddhaṃ ",
  "tha-ap82:13.4": "diyaḍḍhasatavitthataṃ. // // ",
  "tha-ap82:14.1": "Cattārisatasahassāni ",
  "tha-ap82:14.2": "niyyūhā ca sumāpitā / ",
  "tha-ap82:14.3": "kūṭāgāravarūpetā ",
  "tha-ap82:14.4": "mahāsayanavositā. // // ",
  "tha-ap82:15.1": "Koṭisatasahassiyo ",
  "tha-ap82:15.2": "parivāressanti accharā / ",
  "tha-ap82:15.3": "kusalā naccagītassa ",
  "tha-ap82:15.4": "vāditehi padakkhinaṃ. // // ",
  "tha-ap82:16.1": "Etādise vyamhavare ",
  "tha-ap82:16.2": "nārīgaṇasamākule / ",
  "tha-ap82:16.3": "vassissati pupphavasso ",
  "tha-ap82:16.4": "dibbo lohitako sadā. // // ",
  "tha-ap82:17.1": "Bhittikhīle nāgadante ",
  "tha-ap82:17.2": "dvāragāhe ca toraṇe / ",
  "tha-ap82:17.3": "cakkamattā lohitakā ",
  "tha-ap82:17.4": "olambissanti tāvade. // // ",
  "tha-ap82:18.1": "Pattena pattasañchanne ",
  "tha-ap82:18.2": "anto vyamhavare imaṃ / ",
  "tha-ap82:18.3": "attharitvā pārupitvā ",
  "tha-ap82:18.4": "tuvaṭṭhissanti tāvade. // // ",
  "tha-ap82:19.1": "Bhavanaṃ parivāretvā ",
  "tha-ap82:19.2": "samantā satayojanaṃ / ",
  "tha-ap82:19.3": "te visuddhā lohitakā ",
  "tha-ap82:19.4": "dibbā gandhā pavāyare. // // ",
  "tha-ap82:20.1": "Pañcasatatikkhattuñ ca ",
  "tha-ap82:20.2": "cakkavatti bhavissati / ",
  "tha-ap82:20.3": "padesarajjaṃ vipulaṃ ",
  "tha-ap82:20.4": "gaṇanāto asaṅkhiyaṃ. // // ",
  "tha-ap82:21.1": "Sampattiyo duve bhutvā ",
  "tha-ap82:21.2": "anīti anupaddavo / ",
  "tha-ap82:21.3": "sampatte pariyosāne ",
  "tha-ap82:21.4": "nibbānaṃ passayissati. // // ",
  "tha-ap82:22.1": "Sudiṭṭho vata me Buddho, ",
  "tha-ap82:22.2": "vānijjaṃ suppayojitaṃ / ",
  "tha-ap82:22.3": "padumāni tīṇi pūjetvā ",
  "tha-ap82:22.4": "anubhosin ti sampadā. // // ",
  "tha-ap82:23.1": "Ajja me dhammapattassa ",
  "tha-ap82:23.2": "vippamuttassa sabbaso / ",
  "tha-ap82:23.3": "supupphitaṃ lohitakaṃ ",
  "tha-ap82:23.4": "dhārayissanti matthake. // // ",
  "tha-ap82:24.1": "Mama kammaṃ kathentassa ",
  "tha-ap82:24.2": "Padumuttarasatthuno / ",
  "tha-ap82:24.3": "sattapāṇasahassānaṃ ",
  "tha-ap82:24.4": "dhammābhisamayo ahu. // // ",
  "tha-ap82:25.1": "Satasahasse ito kappe ",
  "tha-ap82:25.2": "yaṃ Buddham abhipūjayiṃ / ",
  "tha-ap82:25.3": "duggatiṃ nābhijānāmi ",
  "tha-ap82:25.4": "tīṇi padumān' idaṃ phalaṃ. // // ",
  "tha-ap82:26.1": "Kilesā jhāpitā mayhaṃ ",
  "tha-ap82:26.2": "bhavā sabbe samūhatā / ",
  "tha-ap82:26.3": "sabbāsavaparikkhīṇo ",
  "tha-ap82:26.4": "n' atthi dāni punabbhavo. // // ",
  "tha-ap82:27.1": "Paṭisambhidā catasso ",
  "tha-ap82:27.2": "vimokhā pi ca aṭṭh' ime / chaḍabhiññā sacchikatā ",
  "tha-ap82:27.3": "kataṃ Buddhassa sāsanan ti. // // ",
  "tha-ap82:28.1": "Itthaṃ sudaṃ āyasmā Tīṇipadumiyo thero imā gāthāyo abhāsitthā ti. Tīṇipadumiyatherassa apadānaṃ samattaṃ. ",
  "tha-ap82:29.1": "",
  "tha-ap82:30.1": "",
  "tha-ap82:31.1": "Uddānaṃ: ",
  "tha-ap82:32.1": "Samālo Padasaññī ",
  "tha-ap82:32.2": "ca Sasaññ' Āluvadāyako ",
  "tha-ap82:32.3": "Ekasaññī Tiṇadado ",
  "tha-ap82:32.4": "Sūcī Pāṭalipupphiyo ",
  "tha-ap82:32.5": "Ṭhitañjalī Tipadumī ",
  "tha-ap82:32.6": "gāthāyo pañcasattati. "
}
