  "tha-ap282:0.1": "",
  "tha-ap282:0.2": "",
  "tha-ap282:0.3": "",
  "tha-ap282:1.1": "Mahāpathamhi visame ",
  "tha-ap282:1.2": "setu kārāpito mayā / ",
  "tha-ap282:1.3": "taraṇatthāya lokassa ",
  "tha-ap282:1.4": "pasanno sehi pāṇihi. // // Ekanavute ",
  "tha-ap282:2.1": "ito kappe ",
  "tha-ap282:2.2": "yaṃ setu kārito mayā / ",
  "tha-ap282:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap282:2.4": "setudānass' idaṃ phalaṃ. // // ",
  "tha-ap282:3.1": "Pañcapaññās' ito kappe ",
  "tha-ap282:3.2": "eko āsi Samogadho / ",
  "tha-ap282:3.3": "sattaratanasampanno ",
  "tha-ap282:3.4": "cakkavattī mahabbalo. // // ",
  "tha-ap282:4.1": "Paṭisambhidā . . . ",
  "tha-ap282:4.2": "pe . . . ",
  "tha-ap282:4.3": "pe . . . // // ",
  "tha-ap282:5.1": "Itthaṃ sudam āyasmā Taraṇiyo thero i. g. a- ti. Taraṇiyattherassa ",
  "tha-ap282:6.1": "",
  "tha-ap282:6.2": "apadānaṃ samattaṃ. ",
  "tha-ap282:7.1": "Uddānaṃ: ",
  "tha-ap282:8.1": "Sovaṇṇaṃ Tilamuṭṭhī ca ",
  "tha-ap282:8.2": "Caṅkoṭ'-Abbhañjam-Añjali ",
  "tha-ap282:8.3": "Potthako Citako Mālo ",
  "tha-ap282:8.4": "Ekapuṇḍarī-Setunā ",
  "tha-ap282:8.5": "Dvecattālīsa gāthāyo ",
  "tha-ap282:8.6": "gaṇitāyo vibhāvihi. ",
  "tha-ap282:9.1": "Suvaṇṇabimbohanavaggo aṭṭhavīsatimo. "
}
