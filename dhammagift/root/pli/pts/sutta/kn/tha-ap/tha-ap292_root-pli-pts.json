  "tha-ap292:0.1": "",
  "tha-ap292:0.2": "",
  "tha-ap292:0.3": "",
  "tha-ap292:1.1": "Cullāsītisahassāni ",
  "tha-ap292:1.2": "pabbajimha akiñcanā / ",
  "tha-ap292:1.3": "tesaṃ *pubbaṅga*mo āsim ",
  "tha-ap292:1.4": "uttamatthassa pattiyā. // // ",
  "tha-ap292:2.1": "Sarāgā sabhāvā loke vippasannam ",
  "tha-ap292:2.2": "anāvilaṃ / ",
  "tha-ap292:2.3": "upaṭṭhahiṃsu sakkaccaṃ ",
  "tha-ap292:2.4": "pasannā sehi pāṇihi. // // ",
  "tha-ap292:3.1": "Khīṇāsavā vantadosā ",
  "tha-ap292:3.2": "katakiccā anāsavā / ",
  "tha-ap292:3.3": "phariṃsu mettacittena ",
  "tha-ap292:3.4": "sayambhū aparājitā. // // ",
  "tha-ap292:4.1": "Tesam upaṭṭhahitvāna ",
  "tha-ap292:4.2": "sambuddhānaṃ patissato / ",
  "tha-ap292:4.3": "maraṇañ ca anuppatto ",
  "tha-ap292:4.4": "devattañ ca agamhase. // // ",
  "tha-ap292:5.1": "Catunavute ito kappe ",
  "tha-ap292:5.2": "yaṃ sīlam anupālayiṃ / ",
  "tha-ap292:5.3": "duggatiṃ nābhijānāmi ",
  "tha-ap292:5.4": "saññamassa idaṃ phalaṃ. // // ",
  "tha-ap292:6.1": "Paṭisambhidā . . . ",
  "tha-ap292:6.2": "pe . . . ",
  "tha-ap292:6.3": "pe . . . // // ",
  "tha-ap292:7.1": "Itthaṃ sudam āyasmā Pubbaṅgamiyo thero i. g. a- ti. Pubbaṅgamaniyattherassa ",
  "tha-ap292:8.1": "",
  "tha-ap292:9.1": "apadānaṃ samattaṃ. ",
  "tha-ap292:10.1": "Uddānaṃ: ",
  "tha-ap292:11.1": "Paṇṇaṃ Phalaṃ Uggamiyo ",
  "tha-ap292:11.2": "Ekapupphi ca Maghavā ",
  "tha-ap292:11.3": "Upaṭṭhāk āpadānañ ca ",
  "tha-ap292:11.4": "Pabbajjā ca Upaṭṭhahaṃ ",
  "tha-ap292:11.5": "Pubbaṅgamo ca gāthāyo ",
  "tha-ap292:11.6": "aṭṭhatālīsa kittitā ti. Paṇṇadāyakavaggo ekūnatiṃsamo. "
}
