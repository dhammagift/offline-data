  "tha-ap165:0.3": "",
  "tha-ap165:1.1": "bhagavato ",
  "tha-ap165:1.2": "pubbe phalam adās' ahaṃ / ",
  "tha-ap165:1.3": "nāḷikerañ ca pādāsiṃ ",
  "tha-ap165:1.4": "khajjakam abhisammataṃ. // // ",
  "tha-ap165:2.1": "Buddhassa tam ahaṃ datvā ",
  "tha-ap165:2.2": "Tissassa sumahesino / ",
  "tha-ap165:2.3": "modām' ahaṃ kāmakārī ",
  "tha-ap165:2.4": "upapajjaṃ yamicchakaṃ. // // ",
  "tha-ap165:3.1": "Dvenavute ito kappe ",
  "tha-ap165:3.2": "yaṃ dānam adadiṃ tadā / ",
  "tha-ap165:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap165:3.4": "phaladānass' idaṃ phalaṃ. // // ",
  "tha-ap165:4.1": "Ito terasakappamhi ",
  "tha-ap165:4.2": "rājā Indasamo ahuṃ / ",
  "tha-ap165:4.3": "sattaratanasampanno ",
  "tha-ap165:4.4": "cakkavattī mahabbalo. // // ",
  "tha-ap165:5.1": "Paṭisambhidā . . . ",
  "tha-ap165:5.2": "pe . . . ",
  "tha-ap165:5.3": "pe . . . // // ",
  "tha-ap165:6.1": "Itthaṃ sudaṃ ā. Khajjakadāyako thero i. g. ā-ti. Khajjakadāyakattherassa ",
  "tha-ap165:7.1": "apadānaṃ samattaṃ. "
}
