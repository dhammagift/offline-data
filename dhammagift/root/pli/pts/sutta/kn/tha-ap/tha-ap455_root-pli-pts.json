  "tha-ap455:1.1": "Tissassāhaṃ bhagavato ",
  "tha-ap455:1.2": "bodhirukkham a*vandi 'haṃ* / ",
  "tha-ap455:1.3": "paggayha vījaniṃ tattha ",
  "tha-ap455:1.4": "sīhāsanam avīj' ahaṃ. // // ",
  "tha-ap455:2.1": "Dvenavute ito kappe ",
  "tha-ap455:2.2": "sīhāsanam avīj' ahaṃ / ",
  "tha-ap455:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap455:2.4": "vījanāya idaṃ phalaṃ. // // ",
