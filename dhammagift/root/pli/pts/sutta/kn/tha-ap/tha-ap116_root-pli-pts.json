  "tha-ap116:0.3": "",
  "tha-ap116:1.1": "Varuṇo māma nāmena ",
  "tha-ap116:1.2": "devarājā ahaṃ tadā / ",
  "tha-ap116:1.3": "upaṭṭhahesiṃ sambuddhaṃ ",
  "tha-ap116:1.4": "sayoggabalavāhano. // // ",
  "tha-ap116:2.1": "Nibbutte lokanāthamhi ",
  "tha-ap116:2.2": "Atthadassi-naruttame / ",
  "tha-ap116:2.3": "turiyaṃ sabbam ādāya ",
  "tha-ap116:2.4": "agamaṃ bodhim uttamaṃ. // // ",
  "tha-ap116:3.1": "Vādi*tena ca naccena ",
  "tha-ap116:3.2": "samatāḷasamāhi*to / ",
  "tha-ap116:3.3": "Sammukhā viya sambuddhaṃ ",
  "tha-ap116:3.4": "upaṭṭhiṃ bodhim uttamaṃ. // // ",
  "tha-ap116:4.1": "Upaṭṭhahitvā taṃ bodhiṃ ",
  "tha-ap116:4.2": "dharaṇīrūhapādapaṃ / ",
  "tha-ap116:4.3": "pallaṅkaṃ ābhujitvāna ",
  "tha-ap116:4.4": "tattha kālakato ahaṃ. // // ",
  "tha-ap116:5.1": "Sakakammābhiraddho 'haṃ ",
  "tha-ap116:5.2": "pasanno bodhi-m-uttame / ",
  "tha-ap116:5.3": "tena *cittappasādena ",
  "tha-ap116:5.4": "nibbānam upapa*jj' ahaṃ // // ",
  "tha-ap116:6.1": "Saṭṭhiṃturiyasahassāni ",
  "tha-ap116:6.2": "parivārenti maṃ sadā / ",
  "tha-ap116:6.3": "mānussesu ca devesu ",
  "tha-ap116:6.4": "vattamānaṃ bhavābhave. // // ",
  "tha-ap116:7.1": "Tivaggī nibbutā mayhaṃ ",
  "tha-ap116:7.2": "bhavā sabbe samūhatā / ",
  "tha-ap116:7.3": "dhāremi antimaṃ dehaṃ ",
  "tha-ap116:7.4": "sammāsambuddhasāsane. // // ",
  "tha-ap116:8.1": "Subahū nāma nāmena ",
  "tha-ap116:8.2": "*cattutiṃsāsuṃ khattiyā / ",
  "tha-ap116:8.3": "sa*ttaratanasampannā ",
  "tha-ap116:8.4": "pañcakappasate ito. // // ",
  "tha-ap116:9.1": "Paṭisambhidā catasso ",
  "tha-ap116:9.2": "vimokhā pi ca aṭṭh' ime / chaḍabhiññā sacchikatā ",
  "tha-ap116:9.3": "kataṃ Buddhassa sāsanan ti. // // ",
  "tha-ap116:10.1": "Itthaṃ sudaṃ āyasmā Ekāsaniyo thero imā gāthāyo abhāsitthāti. ",
  "tha-ap116:11.1": "Ekāsanīyattherassa apadānaṃ samattaṃ. "
}
