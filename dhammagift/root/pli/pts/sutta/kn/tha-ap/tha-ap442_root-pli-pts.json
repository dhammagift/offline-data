  "tha-ap442:1.1": "Padumuttarabuddhassa ",
  "tha-ap442:1.2": "lokajeṭṭhassa tādino / ",
  "tha-ap442:1.3": "piṇḍāya vicarantassa ",
  "tha-ap442:1.4": "dhārato uttamaṃ yasaṃ // // ",
  "tha-ap442:2.1": "Aggaphalaṃ gahetvāna ",
  "tha-ap442:2.2": "vippasannena cetasā / ",
  "tha-ap442:2.3": "dakkhiṇeyyassa vīrassa ",
  "tha-ap442:2.4": "adāsiṃ satthuno ahaṃ. // // ",
  "tha-ap442:3.1": "Tena kammena dipadinda ",
  "tha-ap442:3.2": "lokajeṭṭha narāsabha / ",
  "tha-ap442:3.3": "patto 'mhi acalaṃ ṭhānaṃ ",
  "tha-ap442:3.4": "hitvā jayaparājayaṃ. // // ",
  "tha-ap442:4.1": "Satasahasse ito kappe ",
  "tha-ap442:4.2": "yaṃ dānam adadiṃ tadā / ",
  "tha-ap442:4.3": "duggatiṃ nābhijānāmi ",
  "tha-ap442:4.4": "aggadānass' idaṃ phalaṃ. // // ",
  "tha-ap442:5.1": "Kilesā . . . ",
  "tha-ap442:5.2": "pe . . . ",
  "tha-ap442:5.3": "",
  "tha-ap442:6.1": "",
  "tha-ap442:6.2": "pe . . . ",
  "tha-ap442:6.3": "pe . . . // // Sāgataṃ . . . pe . . . pe . . . pe . . . // // ",
  "tha-ap442:7.1": "Paṭisambhidā . . . ",
  "tha-ap442:7.2": "pe . . . ",
  "tha-ap442:7.3": "pe . . . pe . . . // // ",
  "tha-ap442:8.1": "Itthaṃ sudam āyasmā Jambuphaliyo thero i. g. a- ti. Jambuphaliyattherassa ",
  "tha-ap442:9.1": "",
  "tha-ap442:10.1": "apadānaṃ samattaṃ. ",
  "tha-ap442:11.1": "Uddānaṃ: ",
  "tha-ap442:12.1": "Thero-Ekavihārī ca ",
  "tha-ap442:12.2": "Saṅkhiko Pāṭihīrako ",
  "tha-ap442:12.3": "Thaviko Ucchukaṇḍī ca ",
  "tha-ap442:12.4": "Kalamb' Ambāṭakapadā ",
  "tha-ap442:13.1": "Harīṭak' Ambapiṇḍī ca ",
  "tha-ap442:13.2": "Jambudo dasamo yati ",
  "tha-ap442:13.3": "chalāsītiñ ca gāthāyo ",
  "tha-ap442:13.4": "gaṇitāyo vibhāvihīti. "
}
