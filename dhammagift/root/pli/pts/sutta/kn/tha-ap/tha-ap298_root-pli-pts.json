  "tha-ap298:1.1": "Pabbate Himavantamhi ",
  "tha-ap298:1.2": "ahosiṃ kinnaro tadā / ",
  "tha-ap298:1.3": "addasaṃ virajaṃ Buddhaṃ ",
  "tha-ap298:1.4": "vītarasmīva bhānumaṃ. // // ",
  "tha-ap298:2.1": "Upetaṃ maṃ tadā Buddhaṃ ",
  "tha-ap298:2.2": "Vipassiṃ loka*nāyakaṃ* / ",
  "tha-ap298:2.3": "candanaṃ tagaraṃ cāpi ",
  "tha-ap298:2.4": "pade osiñc' ahan tadā. // // ",
  "tha-ap298:3.1": "Ekanavute ito kappe ",
  "tha-ap298:3.2": "yaṃ pādam abhipūjāyiṃ / ",
  "tha-ap298:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap298:3.4": "pādapūjāy' idaṃ phalaṃ. // // ",
  "tha-ap298:4.1": "Paṭisambhidā . . . ",
  "tha-ap298:4.2": "pe . . . ",
  "tha-ap298:4.3": "pe . . . // // ",
  "tha-ap298:5.1": "Itthaṃ sudam āyasmā Pādapūjako thero i. g. a-ti. Pādapūjakattherassa apadānaṃ samattaṃ. Upasālaka-nāmo 'haṃ ",
  "tha-ap298:6.1": ""
}
