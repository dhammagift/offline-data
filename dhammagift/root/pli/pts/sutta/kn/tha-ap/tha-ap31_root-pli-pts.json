  "tha-ap31:0.1": "",
  "tha-ap31:0.2": "",
  "tha-ap31:0.3": "",
  "tha-ap31:1.1": "Suvaṇṇavaṇṇaṃ sambuddhaṃ ",
  "tha-ap31:1.2": "gacchantaṃ antarāpaṇe / ",
  "tha-ap31:1.3": "Vipassi-satthavāhaggaṃ ",
  "tha-ap31:1.4": "naravīraṃ vināyakaṃ // // ",
  "tha-ap31:2.1": "Adantadamanaṃ tādiṃ ",
  "tha-ap31:2.2": "mahāvādiṃ mahāmuniṃ / ",
  "tha-ap31:2.3": "disvā pasanno sumano ",
  "tha-ap31:2.4": "ekañjalim akās' ahaṃ. // // ",
  "tha-ap31:3.1": "Ekanavut' ito kappe ",
  "tha-ap31:3.2": "yam añjalim kariṃ tadā / ",
  "tha-ap31:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap31:3.4": "añjalissa idaṃ phalaṃ. // // ",
  "tha-ap31:4.1": "Paṭisambhidā catasso ",
  "tha-ap31:4.2": "vimokhā pi ca aṭṭh' ime / ",
  "tha-ap31:4.3": "chaḍabhiññā sacchikatā ",
  "tha-ap31:4.4": "kataṃ Buddhassa sāsanan ti. // // ",
  "tha-ap31:5.1": "Itthaṃ sudaṃ āyasmā Ekañjaliko thero imā gāthāyo abhāsitthā ti. ",
  "tha-ap31:6.1": "Ekañjalikatherassa apadānaṃ samattaṃ. "
}
