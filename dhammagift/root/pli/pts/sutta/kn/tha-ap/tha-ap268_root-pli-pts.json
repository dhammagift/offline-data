  "tha-ap268:1.1": "Candabhāgānadītīre ",
  "tha-ap268:1.2": "ukkuso ās' ahaṃ tadā / ",
  "tha-ap268:1.3": "mahantaṃ macchaṃ paggayha ",
  "tha-ap268:1.4": "Siddhatthamunino adaṃ. // // ",
  "tha-ap268:2.1": "Catunavute ito kappe ",
  "tha-ap268:2.2": "yaṃ maccham adadiṃ tadā / ",
  "tha-ap268:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap268:2.4": "macchadānass' idaṃ phalaṃ. // // ",
  "tha-ap268:3.1": "Paṭisambhidā . . . ",
  "tha-ap268:3.2": "pe . . . ",
  "tha-ap268:3.3": "pe . . . // // ",
  "tha-ap268:4.1": "Itthaṃ sudam āyasmā Macchadāyako thero i. g. a-ti. Macchadāyakattherassa apadānaṃ samattaṃ. ",
  "tha-ap268:5.1": ""
}
