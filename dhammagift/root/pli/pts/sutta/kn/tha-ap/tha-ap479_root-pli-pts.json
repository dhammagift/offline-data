  "tha-ap479:1.1": "Sobhito nāma sambuddho ",
  "tha-ap479:1.2": "Cittakuṭe vasī tadā / ",
  "tha-ap479:1.3": "gahetvā giripunnāgaṃ ",
  "tha-ap479:1.4": "sayambhum abhipūjayiṃ // // ",
  "tha-ap479:2.1": "Catunavute ito kappe ",
  "tha-ap479:2.2": "yaṃ Buddham abhipūjayiṃ / ",
  "tha-ap479:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap479:2.4": "Buddhapūjāy' idaṃ phalaṃ. // // ",
  "tha-ap479:3.1": "Kilesā . . . ",
  "tha-ap479:3.2": "pe . . . ",
  "tha-ap479:3.3": "",
  "tha-ap479:4.1": "",
  "tha-ap479:4.2": "pe . . . ",
  "tha-ap479:4.3": "pe . . . // // Sāgataṃ . . . pe . . . pe . . . pe . . . // // ",
  "tha-ap479:5.1": "Paṭisambhidā . . . ",
  "tha-ap479:5.2": "pe . . . ",
  "tha-ap479:5.3": "pe . . . pe . . . // // ",
  "tha-ap479:6.1": "Itthaṃ sudaṃ āyasmā Giripunnāgiyo thero i. g. a-ti. Giripunnāgiyattherassa ",
  "tha-ap479:7.1": "apadānaṃ samattaṃ. "
}
