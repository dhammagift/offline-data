  "tha-ap377:1.1": "Sumano nāma sambuddho ",
  "tha-ap377:1.2": "uppajji lokanāyako / ",
  "tha-ap377:1.3": "pasannacitto sumano ",
  "tha-ap377:1.4": "sattapaṇṇim apūjayiṃ. // // Satasahasse ",
  "tha-ap377:2.1": "ito kappe ",
  "tha-ap377:2.2": "sattapaṇṇim apūjayiṃ / ",
  "tha-ap377:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap377:2.4": "sattapaṇṇipūjāy' idaṃ phalaṃ. // // ",
  "tha-ap377:3.1": "Svāgataṃ . . . pe . . . // // Kilesā . . . ",
  "tha-ap377:3.2": "pe . . . // // ",
  "tha-ap377:3.3": "",
  "tha-ap377:4.1": "",
  "tha-ap377:4.2": "",
  "tha-ap377:4.3": "",
  "tha-ap377:5.1": "Paṭisambhidā . . . ",
  "tha-ap377:5.2": "pe . . . / ",
  "tha-ap377:5.3": "",
  "tha-ap377:6.1": "Itthaṃ sudam āyasmā Sattapaṇṇiyo . . . pe . . . pe . . . // // Citesu kiramānesu ",
