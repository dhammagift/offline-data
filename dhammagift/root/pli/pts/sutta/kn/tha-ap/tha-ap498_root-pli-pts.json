  "tha-ap498:1.1": "Sucintitaṃ bhagavantaṃ ",
  "tha-ap498:1.2": "lokajeṭṭhaṃ narāsabhaṃ / ",
  "tha-ap498:1.3": "upaviṭṭhaṃ mahāraññaṃ ",
  "tha-ap498:1.4": "vātābādhena pīḷitaṃ / ",
  "tha-ap498:2.1": "disvā cittaṃ pasādetvā ",
  "tha-ap498:2.2": "ghatamaṇḍaṃ upānayiṃ. // // ",
  "tha-ap498:2.3": "Katattā ācitattā ca ",
  "tha-ap498:2.4": "Gaṅgā Bhagīrasī c' ayaṃ / ",
  "tha-ap498:3.1": "mahāsamuddā cattāro ",
  "tha-ap498:3.2": "ghataṃ sampajjare mama. // // ",
  "tha-ap498:3.3": "Ayañ ca paṭhavī ghorā ",
  "tha-ap498:3.4": "appamāṇā asaṅkhiyā / ",
  "tha-ap498:4.1": "mama saṅkappam aññāya ",
  "tha-ap498:4.2": "bhavate madhusakkarā. // // ",
  "tha-ap498:4.3": "Cātuddīpā ime rukkhā ",
  "tha-ap498:4.4": "pādapā dharaṇīruhā / ",
  "tha-ap498:5.1": "mama saṅkappam aññāya ",
  "tha-ap498:5.2": "kapparukkhā bhavanti te. // // ",
  "tha-ap498:5.3": "Paññāsakkhattuṃ devindo ",
  "tha-ap498:5.4": "devarajjam akārayiṃ / ",
  "tha-ap498:6.1": "ekapaññāsakkhattuñ ca ",
  "tha-ap498:6.2": "cakkavatti ahos' ahaṃ / ",
  "tha-ap498:6.3": "padesarajjaṃ vipulaṃ ",
  "tha-ap498:6.4": "gaṇanāto asaṅkhiyaṃ. // // ",
  "tha-ap498:7.1": "Catunavute ito kappe ",
  "tha-ap498:7.2": "yaṃ *dānaṃ adadiṃ tadā* / ",
  "tha-ap498:7.3": "duggatiṃ nābhijānāmi ",
  "tha-ap498:7.4": "ghatamaṇḍass' idaṃ phalaṃ. // // ",
  "tha-ap498:8.1": "Kilesā . . . ",
  "tha-ap498:8.2": "pe . . . ",
  "tha-ap498:8.3": "",
  "tha-ap498:9.1": "",
  "tha-ap498:9.2": "pe . . . // // ",
  "tha-ap498:9.3": "Sāgataṃ . . . pe . . . pe . . . pe . . . // // ",
  "tha-ap498:10.1": "Paṭisambhidā . . . ",
  "tha-ap498:10.2": "pe . . . ",
  "tha-ap498:10.3": "pe . . . pe . . . // // ",
  "tha-ap498:11.1": "Itthaṃ sudaṃ āyasmā Ghatamaṇḍadāyako th. i. g. a-ti. Ghatamaṇḍadāyakattherassa apadānaṃ samattaṃ. Padumuttara-Buddhassa ",
  "tha-ap498:12.1": ""
}
