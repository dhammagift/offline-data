  "tha-ap494:1.1": "",
  "tha-ap494:1.2": "nāma pabbato / ",
  "tha-ap494:1.3": "tatth' addasaṃ paṃsukulaṃ ",
  "tha-ap494:1.4": "dumaggamhi vilambitaṃ. // // ",
  "tha-ap494:2.1": "Tīṇikiṅkhanipupphāni ",
  "tha-ap494:2.2": "ocinitvāna 'haṃ tadā / ",
  "tha-ap494:2.3": "haṭṭho haṭṭhena cittena ",
  "tha-ap494:2.4": "paṃsukūlaṃ apūjayiṃ // // ",
  "tha-ap494:3.1": "Tena kammena sukatena ",
  "tha-ap494:3.2": "*cetanāpaṇidhīhi ca / ",
  "tha-ap494:3.3": "jahitvā* mānusaṃ dehaṃ ",
  "tha-ap494:3.4": "Tāvatiṃsaṃ agacch' ahaṃ. // // ",
  "tha-ap494:4.1": "Ekanavut' ito kappe ",
  "tha-ap494:4.2": "yaṃ kammam akariṃ tadā / ",
  "tha-ap494:4.3": "duggatiṃ nābhijānāmi ",
  "tha-ap494:4.4": "pūjitvā arahaddhajaṃ. // // ",
  "tha-ap494:5.1": "Kilesā . . . ",
  "tha-ap494:5.2": "pe . . . ",
  "tha-ap494:5.3": "",
  "tha-ap494:6.1": "",
  "tha-ap494:6.2": "pe . . . ",
  "tha-ap494:6.3": "pe . . . // // Sāgataṃ . . . pe . . . pe . . . pe . . . // // ",
  "tha-ap494:7.1": "Paṭisambhidā . . . ",
  "tha-ap494:7.2": "pe . . . ",
  "tha-ap494:7.3": "pe . . . pe . . . // // ",
  "tha-ap494:8.1": "Itthaṃ sudaṃ āyasmā Paṃsukūlapūjako th. i. g. a-ti. Paṃsukūlapūjakattherassa apadānaṃ samattaṃ. ",
