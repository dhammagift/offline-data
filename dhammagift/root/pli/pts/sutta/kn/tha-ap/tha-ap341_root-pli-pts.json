  "tha-ap341:1.1": "Padumuttaro nāma jino ",
  "tha-ap341:1.2": "sabbadhammāna-pāragū / ",
  "tha-ap341:1.3": "catusaccaṃ pakāsento ",
  "tha-ap341:1.4": "santāreti bahuṃ janaṃ. // // ",
  "tha-ap341:2.1": "Ahaṃ tena samayena ",
  "tha-ap341:2.2": "jaṭilo uggatāpaṇo / ",
  "tha-ap341:2.3": "dhunanto vākacīrāni ",
  "tha-ap341:2.4": "gacchāmi ambare tadā. // // ",
  "tha-ap341:3.1": "Buddhaseṭṭhassa upari ",
  "tha-ap341:3.2": "gantuṃ na visahām' ahaṃ / ",
  "tha-ap341:3.3": "pakkhī va selam āsajja ",
  "tha-ap341:3.4": "gamanaṃ na labhe tadā. // // ",
  "tha-ap341:4.1": "Na me idaṃ bhūtapubbam ",
  "tha-ap341:4.2": "iriyassa vikopanaṃ / ",
  "tha-ap341:4.3": "dake yathā ummisitvā ",
  "tha-ap341:4.4": "evaṃ gacchāmi ambare. // // ",
  "tha-ap341:5.1": "Ulārabhūto manujo ",
  "tha-ap341:5.2": "heṭṭhāsīno bhavissati / ",
  "tha-ap341:5.3": "handa me naṃ gavesissam ",
  "tha-ap341:5.4": "api atthaṃ labheyy' ahaṃ. // // ",
  "tha-ap341:6.1": "Orohanto antalikkhā ",
  "tha-ap341:6.2": "saddam assosi satthuno / ",
  "tha-ap341:6.3": "aniccataṃ kathentassa ",
  "tha-ap341:6.4": "tam aham uggahiṃ tadā. // // ",
  "tha-ap341:7.1": "Aniccasaññam uggayha ",
  "tha-ap341:7.2": "agamāsiṃ mam' assamaṃ / ",
  "tha-ap341:7.3": "yāvatā*yu vasitvā*na ",
  "tha-ap341:7.4": "tattha kālakato ahaṃ. // // ",
  "tha-ap341:8.1": "Carime vattamānamhi ",
  "tha-ap341:8.2": "taṃ dhammasavanaṃ sariṃ / ",
  "tha-ap341:8.3": "tena kammena sukatena ",
  "tha-ap341:8.4": "Tāvatiṃsam agacch' ahaṃ. // // ",
  "tha-ap341:9.1": "Tiṃsakappasahassāni ",
  "tha-ap341:9.2": "devaloke ramiṃ ahaṃ / ",
  "tha-ap341:9.3": "Ekapaññāsakkhattuñ ca ",
  "tha-ap341:9.4": "devarajjam akārayiṃ. // // ",
  "tha-ap341:10.1": "*Ekasattatikkhattuñ ca* ",
  "tha-ap341:10.2": "cakkavattī ahos ahaṃ / ",
  "tha-ap341:10.3": "padesarajjaṃ vipulaṃ ",
  "tha-ap341:10.4": "gaṇanāto asaṅkhiyaṃ. // // ",
  "tha-ap341:11.1": "*Pi*tu ghare nisīditvā ",
  "tha-ap341:11.2": "samaṇo bhāvitindriyo / ",
  "tha-ap341:11.3": "kathāya paridīpento ",
  "tha-ap341:11.4": "aniccavatthudāhari // // ",
  "tha-ap341:12.1": "Anussarāmi *taṃ saññaṃ ",
  "tha-ap341:12.2": "saṃsaranto bhavābhave / ",
  "tha-ap341:12.3": "na koṭipaṭivijjhāmi ",
  "tha-ap341:12.4": "ni*bbānam accutaṃ padaṃ. // // ",
  "tha-ap341:13.1": "Aniccā vata saṅkhārā ",
  "tha-ap341:13.2": "uppādāvayadhammino / ",
  "tha-ap341:13.3": "uppajjitvā nirujjhanti ",
  "tha-ap341:13.4": "tesaṃ vupasamo sukho. // // ",
  "tha-ap341:14.1": "Saha gāthaṃ suṇitvāna ",
  "tha-ap341:14.2": "pubbasaññam anussariṃ / ",
  "tha-ap341:14.3": "ekāsane nisīditvā ",
  "tha-ap341:14.4": "arahattam apāpuṇiṃ. // // ",
  "tha-ap341:15.1": "Jātiyā *sattavasso 'ham*arahattam ",
  "tha-ap341:15.2": "apāpuṇiṃ / ",
  "tha-ap341:15.3": "upasampādayi Buddho ",
  "tha-ap341:15.4": "guṇam aññāya cakkhumā. // // ",
  "tha-ap341:16.1": "Dārako va ahaṃ santo ",
  "tha-ap341:16.2": "karaṇīyaṃ samāpayiṃ / ",
  "tha-ap341:16.3": "kim me karaṇiyam ajja ",
  "tha-ap341:16.4": "Sakyaputtassa sāsane. // // ",
  "tha-ap341:17.1": "Satasahasse ito kappe ",
  "tha-ap341:17.2": "yaṃ kammam akariṃ tadā / ",
  "tha-ap341:17.3": "duggatiṃ nābhijānāmi ",
  "tha-ap341:17.4": "saddhammasavane phalaṃ. // // ",
  "tha-ap341:18.1": "Paṭisambhidā . . . ",
  "tha-ap341:18.2": "pe . . . ",
  "tha-ap341:18.3": "pe . . . // // ",
  "tha-ap341:19.1": "Itthaṃ sudam āyasma Dhammasavaniyo thero i. g. a-ti. Dhammasavaniyattherassa ",
  "tha-ap341:20.1": "apadānaṃ samattaṃ. "
}
