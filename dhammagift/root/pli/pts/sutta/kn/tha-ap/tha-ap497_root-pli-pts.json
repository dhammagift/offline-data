  "tha-ap497:1.1": "",
  "tha-ap497:1.2": "Sujāto nāma sāvako / ",
  "tha-ap497:1.3": "paṃsukūlaṃ gavesanto ",
  "tha-ap497:1.4": "saṅkāre carate sadā. // // ",
  "tha-ap497:2.1": "Nagare Haṃsavatiyā ",
  "tha-ap497:2.2": "paresaṃ bhatako ahaṃ / ",
  "tha-ap497:2.3": "upaḍḍhadussaṃ datvāṇa ",
  "tha-ap497:2.4": "sirasā abhivādayiṃ. // // ",
  "tha-ap497:3.1": "Tena kammena sukatena ",
  "tha-ap497:3.2": "cetanāpaṇidhīhi ca / ",
  "tha-ap497:3.3": "jahitvā mānusaṃ dehaṃ ",
  "tha-ap497:3.4": "Tāvatiṃsaṃ agacch' ahaṃ. // // ",
  "tha-ap497:4.1": "Tettiṃsakkhattuṃ devindo ",
  "tha-ap497:4.2": "devarajjam akārayiṃ / ",
  "tha-ap497:4.3": "sattasattatikkhattuñ ca ",
  "tha-ap497:4.4": "cakkavatti ahos' ahaṃ. // // ",
  "tha-ap497:5.1": "Padesarajjaṃ vipulaṃ ",
  "tha-ap497:5.2": "gaṇanāto asaṅkhiyaṃ / ",
  "tha-ap497:5.3": "upaḍḍhadussadānena ",
  "tha-ap497:5.4": "modāmi akutobhayo. // // ",
  "tha-ap497:6.1": "Icchamāno c' ahaṃ ajja ",
  "tha-ap497:6.2": "sakānanaṃ sapabbataṃ / ",
  "tha-ap497:6.3": "khomadussehi chādeyyaṃ ",
  "tha-ap497:6.4": "aḍḍhadussass' idaṃ phalaṃ // // ",
  "tha-ap497:7.1": "Satasahasse ito kappe ",
  "tha-ap497:7.2": "yaṃ dānam adadiṃ tadā / ",
  "tha-ap497:7.3": "duggatiṃ nābhijānāmi ",
  "tha-ap497:7.4": "aḍḍhadussass' idaṃ phalaṃ. // // ",
  "tha-ap497:8.1": "Kilesā . . . ",
  "tha-ap497:8.2": "pe . . . ",
  "tha-ap497:8.3": "",
  "tha-ap497:9.1": "",
  "tha-ap497:9.2": "pe . . . ",
  "tha-ap497:9.3": "pe . . . // // Sāgataṃ . . . pe . . . pe . . . pe . . . // // ",
  "tha-ap497:10.1": "Paṭisambhidā . . . ",
  "tha-ap497:10.2": "pe . . . ",
  "tha-ap497:10.3": "pe . . . pe . . . // // ",
  "tha-ap497:11.1": "Itthaṃ sudaṃ āyasmā Upaḍḍhadussadāyako th. i. g. a-ti. Upaḍḍhadussadāyakattherassa apadānaṃ samattaṃ. ",
  "tha-ap497:12.1": ""
}
