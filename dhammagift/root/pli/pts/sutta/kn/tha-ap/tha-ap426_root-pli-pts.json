  "tha-ap426:1.1": "",
  "tha-ap426:1.2": "nāma pabbato / ",
  "tha-ap426:1.3": "tasmiṃ pabbatapassamhi ",
  "tha-ap426:1.4": "satta Buddhā vasiṃsu te. // // ",
  "tha-ap426:2.1": "Kadambaṃ pupphitaṃ disvā ",
  "tha-ap426:2.2": "paggahetvāna añjaliṃ / ",
  "tha-ap426:2.3": "satta mālā gahetvāna ",
  "tha-ap426:2.4": "puññacittena okiriṃ. // // ",
  "tha-ap426:3.1": "Tena kammena sukatena ",
  "tha-ap426:3.2": "cetanāpaṇidhīhi ca / ",
  "tha-ap426:3.3": "jahitvā mānusaṃ dehaṃ ",
  "tha-ap426:3.4": "Tāvatiṃsam agacch' ahaṃ. // // Catunavute ",
  "tha-ap426:4.1": "ito kappe ",
  "tha-ap426:4.2": "yaṃ kammam akariṃ tadā / ",
  "tha-ap426:4.3": "duggatiṃ nābhijānāmi ",
  "tha-ap426:4.4": "Buddhapūjāy' idaṃ phalaṃ. // // ",
  "tha-ap426:5.1": "Kilesā . . . ",
  "tha-ap426:5.2": "pe . . . ",
  "tha-ap426:5.3": "",
  "tha-ap426:6.1": "",
  "tha-ap426:6.2": "pe . . . ",
  "tha-ap426:6.3": "pe . . . // // Sāgataṃ . . . pe . . . pe . . . pe . . . // // ",
