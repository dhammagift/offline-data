  "tha-ap528:1.1": "Kānanaṃ vanam ogayha ",
  "tha-ap528:1.2": "veluṃ chetvān' ahaṃ tadā / ",
  "tha-ap528:1.3": "ālambanaṃ gahetvāna ",
  "tha-ap528:1.4": "saṅghassa adadiṃ ahaṃ. // // ",
  "tha-ap528:2.1": "Tena cittappasādena ",
  "tha-ap528:2.2": "subbate abhivādiya / ",
  "tha-ap528:2.3": "ālambadaṇḍaṃ datvāna ",
  "tha-ap528:2.4": "pakkāmi uttarāmukho. // // ",
  "tha-ap528:3.1": "Catunavute ito kappe ",
  "tha-ap528:3.2": "yaṃ daṇḍaṃ adadiṃ tadā / ",
  "tha-ap528:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap528:3.4": "daṇḍadānass' idaṃ phalaṃ. // // ",
  "tha-ap528:4.1": "Kilesā . . . ",
  "tha-ap528:4.2": "pe . . . ",
  "tha-ap528:4.3": "",
  "tha-ap528:5.1": "",
  "tha-ap528:5.2": "pe . . . ",
  "tha-ap528:5.3": "pe . . . // // Sāgataṃ . . . pe . . . pe . . . pe . . . // // ",
  "tha-ap528:6.1": "Paṭisambhidā . . . ",
  "tha-ap528:6.2": "pe . . . ",
  "tha-ap528:6.3": "pe . . . pe . . . // // ",
  "tha-ap528:7.1": "Itthaṃ sudaṃ āyasmā Daṇḍadāyaka tthero i. g. a- ti. Daṇḍadāyakattherassa ",
  "tha-ap528:8.1": "",
  "tha-ap528:8.2": "apadānaṃ samattaṃ. "
}
