  "tha-ap435:1.1": "Padumuttaro nāma jino ",
  "tha-ap435:1.2": "āhutīnaṃ paṭiggaho / ",
  "tha-ap435:1.3": "vasīsatasahassehi ",
  "tha-ap435:1.4": "nagaraṃ pāvisī tadā. // // ",
  "tha-ap435:2.1": "Nagaraṃ pavisantassa ",
  "tha-ap435:2.2": "upasantassa tādino / ",
  "tha-ap435:2.3": "ratanāni panādiṃsu ",
  "tha-ap435:2.4": "nigghoso āsi tāvade. // // ",
  "tha-ap435:3.1": "Buddhassa ānubhāvena ",
  "tha-ap435:3.2": "bherivajjanaghaṭṭitā / ",
  "tha-ap435:3.3": "sayaṃ vīṇā pavajjanti ",
  "tha-ap435:3.4": "Buddhassa pavisato puraṃ. // // ",
  "tha-ap435:4.1": "Buddhaseṭṭhaṃ namassāmi ",
  "tha-ap435:4.2": "Padumuttaraṃ mahāmuniṃ / ",
  "tha-ap435:4.3": "pāṭihīrañ ca passitvā ",
  "tha-ap435:4.4": "tattha cittaṃ pasādayiṃ. // // ",
  "tha-ap435:5.1": "Aho Buddhā aho dhammā ",
  "tha-ap435:5.2": "aho no satthu sampadā / ",
  "tha-ap435:5.3": "acetanā pi turiyā ",
  "tha-ap435:5.4": "sayam eva pavajjare. // // ",
  "tha-ap435:6.1": "Satasahasse ito kappe ",
  "tha-ap435:6.2": "yaṃ saññaṃ alabhiṃ tadā / ",
  "tha-ap435:6.3": "duggatiṃ nābhijānāmi ",
  "tha-ap435:6.4": "buddhasaññāy' idaṃ phalaṃ. // // ",
  "tha-ap435:7.1": "Kilesā . . . ",
  "tha-ap435:7.2": "pe . . . ",
  "tha-ap435:7.3": "",
  "tha-ap435:8.1": "",
  "tha-ap435:8.2": "pe . . . ",
  "tha-ap435:8.3": "pe . . . // // Sāgataṃ . . . pe . . . pe . . . pe . . . // // ",
  "tha-ap435:9.1": "Paṭisambhidā . . . ",
  "tha-ap435:9.2": "pe . . . ",
  "tha-ap435:9.3": "pe . . . pe . . . // // ",
  "tha-ap435:10.1": "Itthaṃ sudaṃ Pāṭihīrasaññako thero i. g. a-ti. Pāṭihīrasaññakattherassa apadānaṃ ",
  "tha-ap435:11.1": "samattaṃ. Kanikāraṃ va "
}
