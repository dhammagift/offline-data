  "tha-ap193:1.1": "Cullāsītisahassāni ",
  "tha-ap193:1.2": "thambho sovaṇṇayo ahu / ",
  "tha-ap193:1.3": "devalaṭṭhipaṭibhāgaṃ ",
  "tha-ap193:1.4": "vimānaṃ me sunimmitaṃ. // // ",
  "tha-ap193:2.1": "Tamālapupphaṃ paggayha ",
  "tha-ap193:2.2": "vippasannena cetasā / ",
  "tha-ap193:2.3": "Buddhassa abhiropesiṃ ",
  "tha-ap193:2.4": "Sikhino lokabandhuno. // // ",
  "tha-ap193:3.1": "Ekatiṃse ito kappe ",
  "tha-ap193:3.2": "yaṃ kammam akariṃ tadā / ",
  "tha-ap193:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap193:3.4": "Buddhapūjāy' idaṃ phalaṃ. // // ",
  "tha-ap193:4.1": "Ito vīsatime kappe ",
  "tha-ap193:4.2": "Candatitto ti ekako / ",
  "tha-ap193:4.3": "sattaratanasampanno ",
  "tha-ap193:4.4": "cakkavattī mahabbalo. // // ",
  "tha-ap193:5.1": "Paṭisambhidā . . . pe . . . ",
  "tha-ap193:5.2": "",
  "tha-ap193:5.3": "pe . . . // // ",
  "tha-ap193:5.4": "",
  "tha-ap193:6.1": "Itthaṃ sudaṃ āyasmā Tamālapupphiyo thero i. g. a-ti. Tamālapupphiyattherassa ",
  "tha-ap193:7.1": "apadānaṃ samattaṃ. "
}
