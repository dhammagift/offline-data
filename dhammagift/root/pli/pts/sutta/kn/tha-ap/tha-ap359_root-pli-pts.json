  "tha-ap359:1.1": "Divāvihārā nikkhanto ",
  "tha-ap359:1.2": "Vipassī lokanāyako / ",
  "tha-ap359:1.3": "bhikkhāya vicaranto so ",
  "tha-ap359:1.4": "mama santikam upāgami. // // ",
  "tha-ap359:2.1": "Tato patito sumano ",
  "tha-ap359:2.2": "Buddhaseṭṭhassa tādino / ",
  "tha-ap359:2.3": "*lo*ṇasupuṭakaṃ datvā ",
  "tha-ap359:2.4": "kappaṃ saggamhi mod' ahaṃ. // // ",
  "tha-ap359:3.1": "Ekanavut' ito kappe ",
  "tha-ap359:3.2": "supuṭakam adās' ahaṃ / ",
  "tha-ap359:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap359:3.4": "supuṭakass' idaṃ phalaṃ. // // ",
  "tha-ap359:4.1": "Paṭisambhidā . . . ",
  "tha-ap359:4.2": "pe . . . ",
  "tha-ap359:4.3": "pe . . . // // ",
  "tha-ap359:5.1": "Itthaṃ sudam āyasamā Supuṭakapūjako th. i. g. a-ti. Supuṭakapūjakattherassa ",
  "tha-ap359:6.1": "apadānaṃ samattaṃ. "
}
