  "tha-ap485:0.3": "",
  "tha-ap485:1.1": "pokkharaṇiṃ ",
  "tha-ap485:1.2": "nānākuñjarasevitaṃ / ",
  "tha-ap485:1.3": "uddharāmi bhisaṃ tattha ",
  "tha-ap485:1.4": "ghāsahetu ahaṃ tadā. // // ",
  "tha-ap485:2.1": "Bhagavā ca tamhi samaye ",
  "tha-ap485:2.2": "Padumuttara*savhayo / ",
  "tha-ap485:2.3": "rattam*baradharo Buddho ",
  "tha-ap485:2.4": "gacchati anilañjase. // // ",
  "tha-ap485:3.1": "Dhunanto paṃsukūlāni ",
  "tha-ap485:3.2": "saddam assos' ahaṃ tadā / ",
  "tha-ap485:3.3": "uddhaṃ nijjhāyamāno 'haṃ ",
  "tha-ap485:3.4": "addasaṃ lokanāyakaṃ. // // ",
  "tha-ap485:4.1": "Tatth' eva ṭhitako santo ",
  "tha-ap485:4.2": "āyāciṃ lokanāyakaṃ / ",
  "tha-ap485:4.3": "*madhu bhisehi savati ",
  "tha-ap485:4.4": "khirasa* ppi muḷālibhi / ",
  "tha-ap485:5.1": "paṭigaṇhātu me Buddho ",
  "tha-ap485:5.2": "anukampāya cakkhumā. // // ",
  "tha-ap485:5.3": "Tato kāruṇiko satthā ",
  "tha-ap485:5.4": "orohitvā mahāyaso / ",
  "tha-ap485:6.1": "patigaṇhi mamaṃ bhikkhaṃ ",
  "tha-ap485:6.2": "anukampāya cakkhumā. // // ",
  "tha-ap485:6.3": "Patiggahetvā sambuddho ",
  "tha-ap485:6.4": "akā me anumodanaṃ: / ",
  "tha-ap485:7.1": "‘Sukhī hohi mahāpuñña ",
  "tha-ap485:7.2": "gati tuyhaṃ samijjhatu / ",
  "tha-ap485:7.3": "iminā bhisadānena ",
  "tha-ap485:7.4": "labhassu vipulaṃ sukhaṃ.' // // ",
  "tha-ap485:8.1": "Idaṃ vatvāna sambuddho ",
  "tha-ap485:8.2": "jalajuttamanāmako / ",
  "tha-ap485:8.3": "bhikkham ādāya sambuddho ",
  "tha-ap485:8.4": "ambarena gami jino. // // ",
  "tha-ap485:9.1": "Tato bhisaṃ gahetvāna ",
  "tha-ap485:9.2": "āgacchiṃ mama assamaṃ / ",
  "tha-ap485:9.3": "bhisaṃ rukkhe lagetvāna ",
  "tha-ap485:9.4": "mama dānaṃ anussariṃ. // // ",
  "tha-ap485:10.1": "Mahāvāto vuṭṭhahitvā ",
  "tha-ap485:10.2": "sañjālesi vanan tadā / ",
  "tha-ap485:10.3": "ākāso abhinādittha ",
  "tha-ap485:10.4": "asaniyā phalantiyā. // // ",
  "tha-ap485:11.1": "Tato me asanipāto ",
  "tha-ap485:11.2": "matthake nipatī tadā / ",
  "tha-ap485:11.3": "so haṃ nisinnako santo ",
  "tha-ap485:11.4": "tattha kālakato ahaṃ. // // ",
  "tha-ap485:12.1": "Puññakammena saṃyutto ",
  "tha-ap485:12.2": "Tusitaṃ upapajj' ahaṃ / ",
  "tha-ap485:12.3": "kalebaraṃ me patitaṃ ",
  "tha-ap485:12.4": "devaloke ramām' ahaṃ. // // ",
  "tha-ap485:13.1": "Chaḷāsītisahassāni ",
  "tha-ap485:13.2": "nāriyo samalaṅkatā / ",
  "tha-ap485:13.3": "sāyapātaṃ upaṭṭhanti ",
  "tha-ap485:13.4": "bhisadānass' idaṃ phalaṃ. // // ",
  "tha-ap485:14.1": "Manussayoniṃ āgantvā ",
  "tha-ap485:14.2": "sukhito hom' ahan tadā / ",
  "tha-ap485:14.3": "bhoge me ūnatā n' atthi ",
  "tha-ap485:14.4": "bhisadānass' idaṃ phalaṃ. // // ",
  "tha-ap485:15.1": "Anukampitattā tena ",
  "tha-ap485:15.2": "devadevena tādinā / ",
  "tha-ap485:15.3": "sabbāsavā parikkhīṇā ",
  "tha-ap485:15.4": "n' atthi dāni punabbhavo // // ",
  "tha-ap485:16.1": "Satasahasse ito kappe ",
  "tha-ap485:16.2": "yaṃ bhikkham adadiṃ tadā / ",
  "tha-ap485:16.3": "duggatiṃ nābhijānāmi ",
  "tha-ap485:16.4": "bhisadānass' idaṃ phalaṃ. // // ",
  "tha-ap485:17.1": "Kilesā . . . ",
  "tha-ap485:17.2": "pe . . . ",
  "tha-ap485:17.3": "",
  "tha-ap485:18.1": "",
  "tha-ap485:18.2": "pe . . . ",
  "tha-ap485:18.3": "pe . . . // // Sāgataṃ . . . pe . . . pe . . . pe . . . // // ",
  "tha-ap485:19.1": "Paṭisambhidā . . . ",
  "tha-ap485:19.2": "pe . . . ",
  "tha-ap485:19.3": "pe . . . pe . . . // // ",
  "tha-ap485:20.1": "Itthaṃ sudaṃ āyasmā Bhisadāyako thero i. g. a-ti. Bhisadāyakattherassa apadānaṃ samattaṃ. ",
  "tha-ap485:21.1": ""
}
