  "tha-ap155:0.3": "",
  "tha-ap155:1.1": "Udentaṃ sataraṃsīva ",
  "tha-ap155:1.2": "pītaraṃsīva bhāṇumaṃ / ",
  "tha-ap155:1.3": "pannarase va tad-ahu- ",
  "tha-ap155:1.4": "niyantaṃ lokanāyakaṃ // // ",
  "tha-ap155:2.1": "Aṭṭhasaṭṭhisahassāni ",
  "tha-ap155:2.2": "sabbe khiṇāsavā ahuṃ / ",
  "tha-ap155:2.3": "parivāriṃsu sambuddhaṃ ",
  "tha-ap155:2.4": "dipadindaṃ narāsabhaṃ. // // ",
  "tha-ap155:3.1": "Sammajjitvāna taṃ vīthiṃ ",
  "tha-ap155:3.2": "niyante lokanāyake / ",
  "tha-ap155:3.3": "ussāpesiṃ dhajaṃ tattha ",
  "tha-ap155:3.4": "vippasannena cetasā. // // ",
  "tha-ap155:4.1": "Ekanavute ito kappe ",
  "tha-ap155:4.2": "yaṃ dhajaṃ abhiropayiṃ / ",
  "tha-ap155:4.3": "duggatiṃ nābhijānāmi ",
  "tha-ap155:4.4": "dhajadānass' idaṃ phalaṃ. // // ",
  "tha-ap155:5.1": "Ito catutthake kappe ",
  "tha-ap155:5.2": "rājā 'hosiṃ mahābalo / ",
  "tha-ap155:5.3": "sabbākārenasampanno ",
  "tha-ap155:5.4": "nāmena iti Vissuto. // // ",
  "tha-ap155:6.1": "Paṭisambhidā . . . ",
  "tha-ap155:6.2": "pe . . . ",
  "tha-ap155:6.3": "pe . . . // // ",
  "tha-ap155:7.1": "Itthaṃ sudaṃ ā. Vīthisammajjako thero i. g. a-ti. Vīthisammajjakattherassa apadānaṃ samattaṃ. ",
  "tha-ap155:8.1": ""
}
