  "tha-ap67:0.2": "",
  "tha-ap67:0.3": "",
  "tha-ap67:1.1": "Vessabhū nāma nāmena ",
  "tha-ap67:1.2": "isīnaṃ tatiyo ahu / ",
  "tha-ap67:1.3": "kānanaṃ vanam oggayha ",
  "tha-ap67:1.4": "vihāsi purisuttamo. // // ",
  "tha-ap67:2.1": "Bhisaṃ muḷālaṃ gaṇhitvā ",
  "tha-ap67:2.2": "agamaṃ Buddhasantike / ",
  "tha-ap67:2.3": "tañ ca Buddhassa pādāsiṃ ",
  "tha-ap67:2.4": "pasanno sehi pāṇihi. // // ",
  "tha-ap67:3.1": "Karena ca parāmaṭṭho ",
  "tha-ap67:3.2": "Vessabhū varabuddhinā / ",
  "tha-ap67:3.3": "sukhāhaṃ nābhijānāmi ",
  "tha-ap67:3.4": "saman tena kut' uttariṃ. // // ",
  "tha-ap67:4.1": "Carimo vattate mayhaṃ ",
  "tha-ap67:4.2": "bhavā sabbe samūhatā / ",
  "tha-ap67:4.3": "hatthināgena santena ",
  "tha-ap67:4.4": "kusalaṃ ropitaṃ mayā. // // ",
  "tha-ap67:5.1": "Ekatiṃse ito kappe ",
  "tha-ap67:5.2": "yaṃ kammam akariṃ tadā / ",
  "tha-ap67:5.3": "duggatiṃ nābhijānāmi ",
  "tha-ap67:5.4": "bhisadānass' idaṃ phalaṃ. // // ",
  "tha-ap67:6.1": "Samodhānā ca rājāno ",
  "tha-ap67:6.2": "soḷasa maṇujādhipā / ",
  "tha-ap67:6.3": "kappamhi terase āsuṃ ",
  "tha-ap67:6.4": "cakkavattī mahabbalā. // // ",
  "tha-ap67:7.1": "Paṭisambhidā catasso ",
  "tha-ap67:7.2": "vimokhā pi ca aṭṭh' ime / chaḷabhiññā sacchikatā ",
  "tha-ap67:7.3": "kataṃ Buddhassa sāsanan ti. // // ",
  "tha-ap67:8.1": "Itthaṃ sudaṃ āyasmā Bhisadāyako thero imā gāthāyo abhāsitthā ti. Bhisadāyakatherassa apadānaṃ samattaṃ. ",
  "tha-ap67:9.1": ""
}
