  "tha-ap521:0.3": "",
  "tha-ap521:1.1": "Varuṇo nāma nāmena ",
  "tha-ap521:1.2": "brāhmaṇo mantapāragū / ",
  "tha-ap521:1.3": "chaḍḍetvā dasaputtāni ",
  "tha-ap521:1.4": "vanam ajjhogahiṃ tadā. // // ",
  "tha-ap521:2.1": "Assamaṃ sukataṃ katvā ",
  "tha-ap521:2.2": "*suvibhattaṃ monoramaṃ / ",
  "tha-ap521:2.3": "paṇṇa*sālaṃ karitvāna ",
  "tha-ap521:2.4": "vasāmi pavane ahaṃ. // // ",
  "tha-ap521:3.1": "Padumuttaro lokavidū ",
  "tha-ap521:3.2": "āhutīnaṃ paṭiggaho / ",
  "tha-ap521:3.3": "mam uddharitukāmo so ",
  "tha-ap521:3.4": "agacchi mam 'assamaṃ. // // ",
  "tha-ap521:4.1": "Yāvatā vanasaṇḍasmiṃ ",
  "tha-ap521:4.2": "obhāso vipulo ahu / ",
  "tha-ap521:4.3": "Buddhas*sa ānubhāvena ",
  "tha-ap521:4.4": "pajjali pavanaṃ tadā. // // ",
  "tha-ap521:5.1": "Disvān' ahaṃ pāṭihīraṃ ",
  "tha-ap521:5.2": "Buddhaseṭṭhassa tadino / ",
  "tha-ap521:5.3": "pattapuṭaṃ gahetvāna ",
  "tha-ap521:5.4": "phalena pūrayiṃ ahaṃ. // // ",
  "tha-ap521:6.1": "Upagantvāna taṃ Buddhaṃ sākhārikaṃ ",
  "tha-ap521:6.2": "adās' ahaṃ / ",
  "tha-ap521:6.3": "anukampāya me Buddho ",
  "tha-ap521:6.4": "imaṃ vacanam abravī: // // ",
  "tha-ap521:7.1": "Khāribhāraṃ gahetvāna ",
  "tha-ap521:7.2": "pacchato ehi me tuvaṃ / ",
  "tha-ap521:7.3": "paribhutte ca saṅghamhi ",
  "tha-ap521:7.4": "puññaṃ taṃ va bhavissati. // // ",
  "tha-ap521:8.1": "Puṭakantaṃ gahetvāna ",
  "tha-ap521:8.2": "bhikkhusaṅghass' adās ahaṃ / ",
  "tha-ap521:8.3": "tattha cittaṃ pasādetvā ",
  "tha-ap521:8.4": "Tusitaṃ upapajj' ahaṃ. // // ",
  "tha-ap521:9.1": "Tattha naccehi ",
  "tha-ap521:9.2": "gītehi dibbehi vāditehi ca / ",
  "tha-ap521:9.3": "puññakammena saṃyutto ",
  "tha-ap521:9.4": "anubhomi sadā ahaṃ. // // ",
  "tha-ap521:10.1": "Yaṃ yaṃ yon' upapajjāmi ",
  "tha-ap521:10.2": "devattaṃ atha mānusaṃ / ",
  "tha-ap521:10.3": "bhoge me ūnatā n' atthi ",
  "tha-ap521:10.4": "phaladānass' idaṃ phalaṃ. // // ",
  "tha-ap521:11.1": "Yāvatā caturo dīpā ",
  "tha-ap521:11.2": "sasamuddā sapabbatā / ",
  "tha-ap521:11.3": "phalaṃ Buddhassa datvāna ",
  "tha-ap521:11.4": "issaraṃ kārayām' ahaṃ. // // ",
  "tha-ap521:12.1": "Yāvatā ye pakkhigaṇā ",
  "tha-ap521:12.2": "ākāse uppatanti te / ",
  "tha-ap521:12.3": "te pi maṃ vasam anventi ",
  "tha-ap521:12.4": "phaladānass' idaṃ phalaṃ. // // ",
  "tha-ap521:13.1": "Yāvatā vanasaṇḍamhi ",
  "tha-ap521:13.2": "yakkhā bhutā ca rakkhasā / ",
  "tha-ap521:13.3": "kumbhaṇḍā garulā cāpi ",
  "tha-ap521:13.4": "pāricariyaṃ upenti me. // // ",
  "tha-ap521:14.1": "Kumbhasoṇā madhukarā ",
  "tha-ap521:14.2": "ḍaṃsā ca makasā ubho / ",
  "tha-ap521:14.3": "te pi maṃ vasam anventi ",
  "tha-ap521:14.4": "phaladānass' idaṃ phalaṃ. // // ",
  "tha-ap521:15.1": "Supaṇṇā nāma sakuṇā ",
  "tha-ap521:15.2": "pakkhijātā mahābalā / ",
  "tha-ap521:15.3": "te pi maṃ saraṇaṃ yanti ",
  "tha-ap521:15.4": "phaladānass' idaṃ phalaṃ. // // ",
  "tha-ap521:16.1": "Ye pi dīghāyukā nāgā ",
  "tha-ap521:16.2": "iddhimanto mahāyasā / ",
  "tha-ap521:16.3": "te pi maṃ vasam anventi ",
  "tha-ap521:16.4": "phaladānass' idaṃ phalaṃ. // // ",
  "tha-ap521:17.1": "Sīhā vyagghā ca dīpī ca ",
  "tha-ap521:17.2": "acchakokataracchayo / ",
  "tha-ap521:17.3": "te pi maṃ vasam anventi ",
  "tha-ap521:17.4": "phaladānass' idaṃ phalaṃ. // // ",
  "tha-ap521:18.1": "Osadhī-tiṇa-vāsā ca ",
  "tha-ap521:18.2": "ye ca ākāsavāsino / ",
  "tha-ap521:18.3": "sabbe maṃ saraṇaṃ yanti ",
  "tha-ap521:18.4": "phaladānass' idaṃ phalaṃ. // // ",
  "tha-ap521:19.1": "Sududdasaṃ sunipuṇaṃ ",
  "tha-ap521:19.2": "gambhīraṃ suppakāsitaṃ / ",
  "tha-ap521:19.3": "passitvāna viharāmi ",
  "tha-ap521:19.4": "phaladānass' idaṃ phalaṃ. // // ",
  "tha-ap521:20.1": "Vimokhe aṭṭha passitvā ",
  "tha-ap521:20.2": "viharāmi anāsavo / ",
  "tha-ap521:20.3": "ātāpī nipako cāhaṃ ",
  "tha-ap521:20.4": "phaladānass' idaṃ phalaṃ // // ",
  "tha-ap521:21.1": "Ye phalaṭṭhā Buddhaputtā ",
  "tha-ap521:21.2": "khīṇadosā mahāyasā / ",
  "tha-ap521:21.3": "aham aññataro tesaṃ ",
  "tha-ap521:21.4": "phaladānass' idaṃ phalaṃ. // // ",
  "tha-ap521:22.1": "Abhiññāpāramiṃ gantvā ",
  "tha-ap521:22.2": "sukkamūlena codito / ",
  "tha-ap521:22.3": "sabbāsave pariññāya ",
  "tha-ap521:22.4": "viharāmi anāsavo. // // ",
  "tha-ap521:23.1": "Tevijjā iddhippattā ca ",
  "tha-ap521:23.2": "Buddhaputtā mahāyasā / ",
  "tha-ap521:23.3": "dibbasotaṃ samāpannā ",
  "tha-ap521:23.4": "tesaṃ aññataro ahaṃ. // // ",
  "tha-ap521:24.1": "Satasahasse ito kappe ",
  "tha-ap521:24.2": "yaṃ phalaṃ adadiṃ tadā / ",
  "tha-ap521:24.3": "duggatiṃ nābhijānāmi ",
  "tha-ap521:24.4": "phaladānass' idaṃ phalaṃ. // // ",
  "tha-ap521:25.1": "Kilesā . . . ",
  "tha-ap521:25.2": "pe . . . ",
  "tha-ap521:25.3": "",
  "tha-ap521:26.1": "",
  "tha-ap521:26.2": "pe . . . ",
  "tha-ap521:26.3": "pe . . . // // Sāgataṃ . . . pe . . . pe . . . pe . . . // // ",
  "tha-ap521:27.1": "Paṭisambhidā . . . ",
  "tha-ap521:27.2": "pe . . . ",
  "tha-ap521:27.3": "pe . . . pe . . . // // ",
  "tha-ap521:28.1": "Itthaṃ sudaṃ āyasmā Sabbaphaladāyako thero i. g. a-ti. Sabbaphaladāyakattherassa apadānaṃ ",
  "tha-ap521:29.1": "samattaṃ. Himavantass' avidūre "
}
