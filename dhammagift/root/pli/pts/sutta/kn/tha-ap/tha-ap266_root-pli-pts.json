  "tha-ap266:1.1": "Devabhūto ahaṃ santo ",
  "tha-ap266:1.2": "oruyha paṭhaviṃ tadā / ",
  "tha-ap266:1.3": "padīpe pañca pādāsiṃ ",
  "tha-ap266:1.4": "pasanno sehi pāṇihi. // // Catunavute ",
  "tha-ap266:2.1": "ito kappe ",
  "tha-ap266:2.2": "yaṃ padīpam adaṃ tadā / ",
  "tha-ap266:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap266:2.4": "dīpadānass' idaṃ phalaṃ. // // ",
  "tha-ap266:3.1": "Pañcapaññāsake kappe ",
  "tha-ap266:3.2": "eko āsi mahīpati / ",
  "tha-ap266:3.3": "Samantacakkhu nāmena ",
  "tha-ap266:3.4": "cakkavattī mahabbalo. // // ",
  "tha-ap266:4.1": "Paṭisambhidā . . . ",
  "tha-ap266:4.2": "pe . . . ",
  "tha-ap266:4.3": "pe . . . // // ",
  "tha-ap266:5.1": "Itthaṃ sudam āyasmā Araṇadīpiyo thero i. g. a-ti. Araṇadīpiyattherassa apadānaṃ ",
  "tha-ap266:6.1": "samattaṃ. Himavantass' avidūre "
}
