  "tha-ap393:170.0": "",
  "tha-ap393:170.1": "Natthuke sugate datvā . . . ",
  "tha-ap393:170.2": "pe . . . / ",
  "tha-ap393:170.3": "aṭṭhānisaṃse anubhomi . . . ",
  "tha-ap393:170.4": "pe . . . // // ",
  "tha-ap393:171.1": "Saddhaṃ sīlaṃ hiriñ cāpi ",
  "tha-ap393:171.2": "atho ottappiyaṃ guṇaṃ / ",
  "tha-ap393:171.3": "sukhañ cāgañ ca khantiñ ca ",
  "tha-ap393:171.4": "paññaṃ me aṭṭhamaṃ guṇaṃ. // // ",
  "tha-ap393:172.0": "",
  "tha-ap393:172.1": "Pīṭhake sugate datvā . . . ",
  "tha-ap393:172.2": "pe . . . / pañcānisaṃsānubhomi . . . ",
  "tha-ap393:172.3": "pe . . . ",
  "tha-ap393:172.4": "pe . . . // // ",
  "tha-ap393:173.1": "Ucce kule pajāyāmi ",
  "tha-ap393:173.2": "mahābhogo bhavām' ahaṃ / ",
  "tha-ap393:173.3": "sabbe mam apacāyanti ",
  "tha-ap393:173.4": "kitti abbhuggatā mamaṃ. // // ",
  "tha-ap393:174.1": "Kappasatasahassāni ",
  "tha-ap393:174.2": "pallaṅkā caturassarā / ",
  "tha-ap393:174.3": "parivāressanti maṃ niccaṃ ",
  "tha-ap393:174.4": "saṃvibhāgarato ahaṃ. // // ",
  "tha-ap393:175.0": "",
  "tha-ap393:175.1": "Bhisiyo sugate datvā . . . ",
  "tha-ap393:175.2": "pe . . . / ",
  "tha-ap393:175.3": "chānisaṃse anubhomi . . . ",
  "tha-ap393:175.4": "pe . . . // // samaṃ sambhatto ",
  "tha-ap393:176.1": "'pacito ",
  "tha-ap393:176.2": "muduko cārudassano / ",
  "tha-ap393:176.3": "labhāmi ñāṇaparivāraṃ ",
  "tha-ap393:176.4": "bhisidānass' idaṃ phalaṃ. // // ",
  "tha-ap393:177.1": "Tūlikā vikatikāyo ",
  "tha-ap393:177.2": "kaṭṭhissā cittikā bahū / ",
  "tha-ap393:177.3": "varapotthake kambale ca ",
  "tha-ap393:177.4": "labhāmi vividhe ahaṃ. // // ",
  "tha-ap393:178.1": "Pāvārike ca muduke ",
  "tha-ap393:178.2": "mudukā jinaveṇiyo / ",
  "tha-ap393:178.3": "labhāmi vividhatthāre ",
  "tha-ap393:178.4": "bhisidānass' idaṃ phalaṃ. // // ",
  "tha-ap393:179.1": "Yato sarāmi attānaṃ ",
  "tha-ap393:179.2": "yato patto 'smi viññutaṃ / ",
  "tha-ap393:179.3": "atucchojjhānamañño 'mhi ",
  "tha-ap393:179.4": "bhisidānass' idaṃ phalaṃ. // // Bimbohane ",
  "tha-ap393:180.0": "",
  "tha-ap393:180.1": "jine datvā . . . ",
  "tha-ap393:180.2": "pe . . . / ",
  "tha-ap393:180.3": "chānisaṃse anubhomi . . . ",
  "tha-ap393:180.4": "pe . . . // // ",
  "tha-ap393:181.1": "Uṇṇike padumake ca ",
  "tha-ap393:181.2": "atho lohitacandane / ",
  "tha-ap393:181.3": "bimbohane uppādemi ",
  "tha-ap393:181.4": "uttamaṅgaṃ sadā mamaṃ. // // ",
  "tha-ap393:182.1": "Aṭṭhaṅgike maggavare ",
  "tha-ap393:182.2": "sāmaññe caturo phale / ",
  "tha-ap393:182.3": "tesu ñāṇaṃ upānetvā ",
  "tha-ap393:182.4": "vihāre niccakālikaṃ. // // ",
  "tha-ap393:183.1": "Dāne dame saññame ca ",
  "tha-ap393:183.2": "appamaññesu rūpisu / ",
  "tha-ap393:183.3": "tesu ñāṇam upānetvā ",
  "tha-ap393:183.4": "vihāre sabbakālikaṃ. // // ",
  "tha-ap393:184.1": "Vatte guṇe ca pañcame ",
  "tha-ap393:184.2": "ācārakiriyāsu ca / ",
  "tha-ap393:184.3": "ñāṇaṃ uppādayitvāna ",
  "tha-ap393:184.4": "vihāre sabbadā ahaṃ. // // ",
  "tha-ap393:185.1": "Caṅkame vā padhāne vā ",
  "tha-ap393:185.2": "viriye bodhapakkhike / ",
  "tha-ap393:185.3": "tesu ñāṇam upānetvā ",
  "tha-ap393:185.4": "viharāmi yadicchakaṃ. // // ",
  "tha-ap393:186.1": "Sīlaṃ samādhi paññā ca ",
  "tha-ap393:186.2": "vimutti ca anuttarā / ",
  "tha-ap393:186.3": "tesu ñāṇam upānetvā ",
  "tha-ap393:186.4": "viharāmi sukham ahaṃ. // // Palālapīṭhe ",
  "tha-ap393:187.0": "",
  "tha-ap393:187.1": "jine datvā . . . ",
  "tha-ap393:187.2": "pe . . . / caturānisaṃse . . . ",
  "tha-ap393:187.3": "pe . . . // // ",
  "tha-ap393:187.4": "Sovaṇṇamaye ",
  "tha-ap393:188.1": "maṇimaye ",
  "tha-ap393:188.2": "dantasāramaye bahū / ",
  "tha-ap393:188.3": "pallaṅkaseṭṭhe vindāmi ",
  "tha-ap393:188.4": "palālapīṭhass' idaṃ phalaṃ. // // ",
  "tha-ap393:189.0": "",
  "tha-ap393:189.1": "Pādapīṭhe jine datvā . . . ",
  "tha-ap393:189.2": "pe . . . / ",
  "tha-ap393:189.3": "dvānisaṃse anubhomi . . . ",
  "tha-ap393:189.4": "pe . . . // // ",
  "tha-ap393:189.5": "Labhāmi bahuke yāne ",
  "tha-ap393:189.6": "pādapīṭhass' idaṃ phalaṃ / ",
  "tha-ap393:190.1": "dāsidāsā ca bhariyā ",
  "tha-ap393:190.2": "ye c' aññe anujīvino / ",
  "tha-ap393:190.3": "Sammā paricarante maṃ ",
  "tha-ap393:190.4": "pādapīṭhass' idaṃ phalaṃ. // // Telān' ",
  "tha-ap393:191.0": "",
  "tha-ap393:191.1": "abbhañjane datvā . . . ",
  "tha-ap393:191.2": "pe . . . / ",
  "tha-ap393:191.3": "pañcānisaṃse . . . pe . . . // // ",
  "tha-ap393:191.4": "",
  "tha-ap393:192.1": "Abyādhitā rūpavatā ",
  "tha-ap393:192.2": "khippaṃ dhammanisantitā / ",
  "tha-ap393:192.3": "lābhitā annapānassa ",
  "tha-ap393:192.4": "āyu pañcamakaṃ mama // // ",
  "tha-ap393:193.0": "",
  "tha-ap393:193.1": "Sappitelañ ca datvāna ",
  "tha-ap393:193.2": "saṅghe . . . pe . . . / ",
  "tha-ap393:193.3": "pañcānisaṃse . . . pe . . . // // ",
  "tha-ap393:193.4": "",
  "tha-ap393:194.1": "Thāmavā rūpasampanno ",
  "tha-ap393:194.2": "pahaṭṭhatanujo sadā / ",
  "tha-ap393:194.3": "avyādhī visajī homi ",
  "tha-ap393:194.4": "sappitelass' idaṃ phalaṃ. // // Mukhadhovanakaṃ ",
  "tha-ap393:195.0": "",
  "tha-ap393:195.1": "datvā ",
  "tha-ap393:195.2": "Buddhe saṅghe . . . pe . . . / ",
  "tha-ap393:195.3": "pañcānisaṃsānubhomi . . . ",
  "tha-ap393:195.4": "pe . . . // // ",
  "tha-ap393:196.1": "Visuddhakaṇṭho madhurassaro ",
  "tha-ap393:196.2": "kāsassāsavivajjito / ",
  "tha-ap393:196.3": "upphalagandho mukhato ",
  "tha-ap393:196.4": "upavāyati me sadā. // // ",
  "tha-ap393:197.0": "",
  "tha-ap393:197.1": "Dadhiṃ datvāna sampannaṃ ",
  "tha-ap393:197.2": "Buddhe saṅghe . . . pe . . . / ",
  "tha-ap393:197.3": "bhuñjāmi *amataṃ cittaṃ ",
  "tha-ap393:197.4": "varakāy*agataṃ satiṃ // // ",
  "tha-ap393:198.0": "",
  "tha-ap393:198.1": "Vaṇṇagandharasopetaṃ ",
  "tha-ap393:198.2": "madhuṃ datvā jine gaṇe / ",
  "tha-ap393:198.3": "Anupamam atuliyam ",
  "tha-ap393:198.4": "pive muttirasam ahaṃ. // // ",
  "tha-ap393:199.0": "",
  "tha-ap393:199.1": "Yathābhūtaṃ rasaṃ datvā ",
  "tha-ap393:199.2": "Buddhe saṅghe . . . pe . . . / ",
  "tha-ap393:199.3": "caturo phale anubhomi ",
  "tha-ap393:199.4": "kammānucchavike mama. // // Annapānañ ",
  "tha-ap393:200.0": "",
  "tha-ap393:200.1": "ca datvāna ",
  "tha-ap393:200.2": "saṅghe . . . pe . . . / ",
  "tha-ap393:200.3": "dasānisaṃse anubhomi . . . ",
  "tha-ap393:200.4": "pe . . . // // ",
  "tha-ap393:201.1": "Āyuvā balavā vīro ",
  "tha-ap393:201.2": "vaṇṇavā yasavā sukhī / ",
  "tha-ap393:201.3": "lābhī annassa pānassa ",
  "tha-ap393:201.4": "sūro paññāṇavā tathā / ",
  "tha-ap393:201.5": "ime guṇe paṭilabhe ",
  "tha-ap393:201.6": "saṃsaranto bhave ahaṃ. // // Dhūmaṃ ",
  "tha-ap393:202.0": "",
  "tha-ap393:202.1": "datvā sugate ",
  "tha-ap393:202.2": "saṅghe . . . pe . . . / ",
  "tha-ap393:202.3": "dasānisaṃsānubhomi . . . ",
  "tha-ap393:202.4": "pe . . . // // ",
  "tha-ap393:203.1": "Sugandhadeho yasavā ",
  "tha-ap393:203.2": "sīghapañño ca kittimā / ",
  "tha-ap393:203.3": "tikkhapañño bhūripañño ",
  "tha-ap393:203.4": "bhāsagambhīrapaññavā. // // ",
  "tha-ap393:204.1": "Vepullajavanappañño ",
  "tha-ap393:204.2": "saṃsaranto bhavābhave / ",
  "tha-ap393:204.3": "tass' eva vāhasā dāni ",
  "tha-ap393:204.4": "patto santisukhaṃ sivaṃ. // // Sāgataṃ vata me āsi mama Buddhassa santike / tisso vijjā anuppatto kataṃ Buddhassa sāsanaṃ. // // ",
  "tha-ap393:205.0": "",
  "tha-ap393:205.1": "Kilesā jhāpitā mayhaṃ ",
  "tha-ap393:205.2": "bhavā sabbe samūhatā / ",
  "tha-ap393:205.3": "nāgo va bandhanaṃ chetvā ",
  "tha-ap393:205.4": "viharāmi anāsavo. // // ",
