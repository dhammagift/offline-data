{
  "tha-ap393:0.1": "",
  "tha-ap393:0.2": "",
  "tha-ap393:0.3": "",
  "tha-ap393:1.1": "Nagare Haṃsavatiyā ",
  "tha-ap393:1.2": "āsiṃ dovāriko ahaṃ / ",
  "tha-ap393:1.3": "akkhobhaṃ amitabhogaṃ ",
  "tha-ap393:1.4": "ghare sannicitaṃ mamaṃ. // // ",
  "tha-ap393:2.1": "Rahogato nisīditvā ",
  "tha-ap393:2.2": "sampahaṃsitvā mānasaṃ / ",
  "tha-ap393:2.3": "nisajja pāsādavare ",
  "tha-ap393:2.4": "evaṃ cintes' ahan tadā: // // ",
  "tha-ap393:3.0": "",
  "tha-ap393:3.1": "Bahū me 'dhigatā bhogā: ",
  "tha-ap393:3.2": "phītam antepuraṃ mama / ",
  "tha-ap393:3.3": "rājāpi sannimantesi ",
  "tha-ap393:3.4": "Ānando puthuvissaro. // // ",
  "tha-ap393:4.1": "Ayañ ca Buddho uppanno ",
  "tha-ap393:4.2": "adhiccuppattiko muni / ",
  "tha-ap393:4.3": "saṃvijjanti ca me bhogā; ",
  "tha-ap393:4.4": "dānaṃ dassāmi satthuno. // // ",
  "tha-ap393:5.1": "Padume rājaputtena ",
  "tha-ap393:5.2": "dinnaṃ dānaṃ varaṃ jine / ",
  "tha-ap393:5.3": "hatthināge ca pallaṅke ",
  "tha-ap393:5.4": "appassenañ c' anappakaṃ. // // ",
  "tha-ap393:6.1": "Aham pi dānaṃ dassāmi ",
  "tha-ap393:6.2": "saṅghe guṇavaruttame / adinnapubbaṃ ",
  "tha-ap393:6.3": "dānavaraṃ ",
  "tha-ap393:6.4": "bhavissam ādikammiko. // // ",
  "tha-ap393:7.1": "Cintetvāhaṃ bahuvidhaṃ ",
  "tha-ap393:7.2": "yāge yassa sukhaṃ phalaṃ / ",
  "tha-ap393:7.3": "parikkhāradānam addakkhiṃ ",
  "tha-ap393:7.4": "mama saṅkappapūraṇaṃ. // // ",
  "tha-ap393:8.1": "Parikkhārāna dassāmi ",
  "tha-ap393:8.2": "saṅghe guṇavaruttame / ",
  "tha-ap393:8.3": "adinnapubbam aññesaṃ ",
  "tha-ap393:8.4": "bhavissam ādikammiko. // // ",
  "tha-ap393:9.0": "",
  "tha-ap393:9.1": "Naḷakāre upāgamma ",
  "tha-ap393:9.2": "chattaṃ kāresiṃ tāvade / ",
  "tha-ap393:9.3": "chattasatasahassāni ",
  "tha-ap393:9.4": "ekato sannipātayiṃ. // // ",
  "tha-ap393:10.1": "Dussasatasahassāni ",
  "tha-ap393:10.2": "ekato sannipātayiṃ / ",
  "tha-ap393:10.3": "",
  "tha-ap393:10.4": "",
  "tha-ap393:11.1": "vāsiyo satthake cāpi ",
  "tha-ap393:11.2": "sūciyo nakhacchedane. // // ",
  "tha-ap393:11.3": "Heṭṭhā chatte laggāpesiṃ ",
  "tha-ap393:11.4": "kāretvā tadanucchave / ",
  "tha-ap393:12.1": "vidhūpane tālavaṇṭe ",
  "tha-ap393:12.2": "morahatthe ca cāmare. // // ",
  "tha-ap393:12.3": "Parissāvane teladhāre ",
  "tha-ap393:12.4": "kārayiṃ tadanuccha*ve / ",
  "tha-ap393:13.1": "sūcighare aṃsabaddhe ",
  "tha-ap393:13.2": "atho* pi kāyabandhane. // // ",
  "tha-ap393:13.3": "Ādhārake ca sukate ",
  "tha-ap393:13.4": "kārayiṃ tadanucchave / ",
  "tha-ap393:14.1": "paribhogabhājane ca ",
  "tha-ap393:14.2": "atho pi lohathālake. // // ",
  "tha-ap393:14.3": "Bhesajjaṃ pūrayitvāna ",
  "tha-ap393:14.4": "heṭṭhā chatte ṭhapes' ahaṃ / ",
  "tha-ap393:15.1": "vacam usīram laṭṭhimadhuṃ ",
  "tha-ap393:15.2": "pipphalī maricāni ca // // ",
  "tha-ap393:15.3": "Harī*ṭakiṃ siṅgiveraṃ ",
  "tha-ap393:15.4": "sabbaṃ pūresi bhājane* / ",
  "tha-ap393:16.1": "upāhanā pādukāyo ",
  "tha-ap393:16.2": "atho udakapuñchane. // // ",
  "tha-ap393:16.3": "Kattaradaṇḍe sukate ",
  "tha-ap393:16.4": "kārayiṃ tadanucchave / ",
  "tha-ap393:17.1": "osadhaṃ jananāliṃ ca ",
  "tha-ap393:17.2": "salākā dhammakuttarā. // // ",
  "tha-ap393:17.3": "Kuñcikā pañcavaṇṇehi ",
  "tha-ap393:17.4": "sibbite kuñcikāghare / ",
  "tha-ap393:18.1": "āyoge dhūmanette ca ",
  "tha-ap393:18.2": "atho pi dīpadhārake. // // ",
  "tha-ap393:18.3": "Tumbake ca karaṇḍe ca ",
  "tha-ap393:18.4": "kārayiṃ tadanucchave / ",
  "tha-ap393:19.1": "saṇḍāse pipphale c' eva ",
  "tha-ap393:19.2": "atho pi malahārake. // // ",
  "tha-ap393:19.3": "Bhesajjathavike c' eva ",
  "tha-ap393:19.4": "kārayiṃ tadanucchave / ",
  "tha-ap393:20.1": "āsandiyo pīṭhake ca ",
  "tha-ap393:20.2": "pallaṅke caturomaye // // ",
  "tha-ap393:20.3": "tadanucchave kāretvā ",
  "tha-ap393:20.4": "heṭṭhā chatte ṭhapes' ahaṃ. / ",
  "tha-ap393:21.1": "Unnābhisī tūlabhisī ",
  "tha-ap393:21.2": "atho pi pīṭhikābhisī // // ",
  "tha-ap393:21.3": "bimbohane ca sukate ",
  "tha-ap393:21.4": "kārayiṃ tadanucchave / ",
  "tha-ap393:22.1": "kuruvinde madhusitthe ",
  "tha-ap393:22.2": "telahatthappatāpakaṃ // // ",
  "tha-ap393:22.3": "Sipāṭiphalake sucī ",
  "tha-ap393:22.4": "mañcam attharaṇena ca / ",
  "tha-ap393:23.1": "senāsane pādapuñche ",
  "tha-ap393:23.2": "sayanāsanadaṇḍake. // // ",
  "tha-ap393:23.3": "Dantapoṇe ca pāṭalī ",
  "tha-ap393:23.4": "sīsālepanagandhake / ",
  "tha-ap393:24.1": "araṇī palālapīṭhe ca ",
  "tha-ap393:24.2": "pattapidhānadhārake. // // ",
  "tha-ap393:24.3": "Udakassa katacchuñ ca ",
  "tha-ap393:24.4": "cuṇṇakam rajanammanaṃ / ",
  "tha-ap393:25.1": "sammajjanaṃ uda vatthaṃ ",
  "tha-ap393:25.2": "tathā vassikasāṭakaṃ // // ",
  "tha-ap393:25.3": "nisīdanaṃ kaṇḍucchādi ",
  "tha-ap393:25.4": "atha antaravāsakaṃ / ",
  "tha-ap393:26.1": "uttarāsaṅghasaṅghāṭiṃ ",
  "tha-ap393:26.2": "natthukaṃ mukhasodhanaṃ // // ",
  "tha-ap393:26.3": "bilaṅgaloṇaṃ bhūtaṃ ca ",
  "tha-ap393:26.4": "madhuñ ca dadhipānakaṃ / ",
  "tha-ap393:27.1": "pupphaṃ sitthaṃ pilotiñ ca ",
  "tha-ap393:27.2": "mukhapuñchanasuttakaṃ. // // ",
  "tha-ap393:27.3": "Dātabbaṃ nāma yam atthi ",
  "tha-ap393:27.4": "yañ ca kappati satthuno / ",
  "tha-ap393:28.1": "sabbam etam samānetvā ",
  "tha-ap393:28.2": "Ānandam upasaṅkamiṃ. // // ",
  "tha-ap393:28.3": "Upasaṅkamma rājānaṃ ",
  "tha-ap393:28.4": "janetāraṃ mahāyasaṃ / ",
  "tha-ap393:28.5": "sirasā abhivādetvā ",
  "tha-ap393:28.6": "imaṃ vacanam abraviṃ: // // ",
  "tha-ap393:29.0": "",
  "tha-ap393:29.1": "Ekato jātasaṃvaddhā ",
  "tha-ap393:29.2": "ubhinnam ekato yasaṃ / ",
  "tha-ap393:29.3": "sādhāraṇā sukkhadukkhe ",
  "tha-ap393:29.4": "ubho ca anuvattakā. // // ",
  "tha-ap393:30.1": "Atthi cetasikaṃ dukkhaṃ ",
  "tha-ap393:30.2": "tavāddheyyam arindama / ",
  "tha-ap393:30.3": "yadi sakkosi naṃ dukkhaṃ ",
  "tha-ap393:30.4": "vinodeyyāsi khattiya. // // ",
  "tha-ap393:31.1": "Tava dukkhaṃ mama dukkham ",
  "tha-ap393:31.2": "ubhinnam ekato manaṃ / ",
  "tha-ap393:31.3": "niṭṭhitan ti vijānāhi ",
  "tha-ap393:31.4": "mamādheyyaṃ sace tuvaṃ. // // ",
  "tha-ap393:32.1": "Jānāhi kho mahārāja ",
  "tha-ap393:32.2": "dukkhaṃ me dubbinodayaṃ / ",
  "tha-ap393:32.3": "bahussamāno gajjassu etaṃ ",
  "tha-ap393:32.4": "te duccajjaṃ dhanaṃ. // // ",
  "tha-ap393:33.1": "Yāvatā vijitaṃ atthi ",
  "tha-ap393:33.2": "yāvatā mama jīvitaṃ / ",
  "tha-ap393:33.3": "etehi yadi te attho ",
  "tha-ap393:33.4": "dassāmi avikampito. // // ",
  "tha-ap393:34.1": "Gajjitaṃ kho tayā deva ",
  "tha-ap393:34.2": "micchā taṃ bahugajjitaṃ / ",
  "tha-ap393:34.3": "jānissāmi tavaṃ ajja ",
  "tha-ap393:34.4": "sabbadhamme patiṭṭhitaṃ. // // ",
  "tha-ap393:35.1": "Atibāḷhaṃ nipīḷesi ",
  "tha-ap393:35.2": "dadamānassa me sato / ",
  "tha-ap393:35.3": "kin te palapite n' attho; ",
  "tha-ap393:35.4": "patthitaṃ te kathehi me. // // ",
  "tha-ap393:36.1": "Icchām' ahaṃ mahārāja ",
  "tha-ap393:36.2": "Buddhaseṭṭham anuttaraṃ / ",
  "tha-ap393:36.3": "bhojayissāmi sambuddhaṃ ",
  "tha-ap393:36.4": "vajjaṃ me p' āhu jīvitaṃ. // // ",
  "tha-ap393:37.1": "Aññam te 'haṃ varaṃ dammi; ",
  "tha-ap393:37.2": "ayācittho Tathāgataṃ / ",
  "tha-ap393:37.3": "adeyyo kassaci Buddho ",
  "tha-ap393:37.4": "maṇijotiraso yathā. // // ",
  "tha-ap393:38.1": "Nanu te gajjitaṃ deva ",
  "tha-ap393:38.2": "yāvajīvitam atthikaṃ / ",
  "tha-ap393:38.3": "jivitaṃ dadamānena ",
  "tha-ap393:38.4": "yuttaṃ dātuṃ Tathāgataṃ. // // ",
  "tha-ap393:39.1": "Ṭhapanīyo mahāvīro ",
  "tha-ap393:39.2": "adeyyo kassaci jino / ",
  "tha-ap393:39.3": "na me *paṭissuto* Buddho ",
  "tha-ap393:39.4": "varassu amitaṃ dhanaṃ. // // ",
  "tha-ap393:40.1": "Vinicchayam pāpuṇāma ",
  "tha-ap393:40.2": "pucchissāma vinicchaye / ",
  "tha-ap393:40.3": "yathāsaṇhaṃ kathessanti ",
  "tha-ap393:40.4": "paṭipucchāma taṃ tathā. // // ",
  "tha-ap393:41.1": "Rañño hatthe gahetvāna ",
  "tha-ap393:41.2": "agamāsiṃ vinicchayaṃ / ",
  "tha-ap393:41.3": "purato akkhadassānam ",
  "tha-ap393:41.4": "idaṃ vacanam abraviṃ: // // ",
  "tha-ap393:42.1": "Sunaṇtu me akkhadassā ",
  "tha-ap393:42.2": "rājā varam adāsi me / ",
  "tha-ap393:42.3": "na kiñci ṭhapayitvāna ",
  "tha-ap393:42.4": "jīvitam pi pavārayi. // // ",
  "tha-ap393:43.1": "Tassa me varadinnassa ",
  "tha-ap393:43.2": "Buddhaseṭṭhaṃ varim ahaṃ / ",
  "tha-ap393:43.3": "sudinno hoti me Buddho ",
  "tha-ap393:43.4": "athavā saṃsayaṃ mama. // // ",
  "tha-ap393:44.1": "Sussāma tava vacanaṃ ",
  "tha-ap393:44.2": "bhūmipālassa rājino / ",
  "tha-ap393:44.3": "ubhinnaṃ vacanaṃ sutvā ",
  "tha-ap393:44.4": "chindissām' ettha saṃsayaṃ. // // ",
  "tha-ap393:45.1": "Sabbaṃ deva tayā dinnaṃ ",
  "tha-ap393:45.2": "imassa sabbagāhikaṃ / ",
  "tha-ap393:45.3": "na kiñci ṭhapayitvāna ",
  "tha-ap393:45.4": "jīvitam pi pavārayi? // // ",
  "tha-ap393:46.1": "Kicchapatto va hutvāna ",
  "tha-ap393:46.2": "yācī varam anuttaraṃ / ",
  "tha-ap393:46.3": "imaṃ sudukkhitaṃ ñatvā ",
  "tha-ap393:46.4": "adāsiṃ sabbagāhikaṃ. // // ",
  "tha-ap393:47.1": "Parājayo tavaṃ deva ",
  "tha-ap393:47.2": "assa deyyo Tathāgato / ",
  "tha-ap393:47.3": "ubhinnaṃ saṃsayo chinno ",
  "tha-ap393:47.4": "yathāsaṇṭhamhi tiṭṭhatha. // // ",
  "tha-ap393:48.1": "Rājā tatth' eva ṭhatvāna ",
  "tha-ap393:48.2": "akkhadasse tad abravi: / ",
  "tha-ap393:48.3": "sammā mayhaṃ pi deyyātha ",
  "tha-ap393:48.4": "puna Buddhaṃ labhām' ahaṃ. // // ",
  "tha-ap393:49.1": "Pūretvā tava saṅkappaṃ ",
  "tha-ap393:49.2": "bhojayitvā Tathāgataṃ / ",
  "tha-ap393:49.3": "puna deyyāsi sambuddham ",
  "tha-ap393:49.4": "Ānandassa yasassino. // // ",
  "tha-ap393:50.0": "",
  "tha-ap393:50.1": "Akkhadasse 'bhivādetvā ",
  "tha-ap393:50.2": "Ānandañ cāpi khattiyaṃ / ",
  "tha-ap393:50.3": "tuṭṭho pamudito hutvā ",
  "tha-ap393:50.4": "sambuddham upasaṅkamiṃ. // // ",
  "tha-ap393:51.1": "Upasaṅkamma sambuddham ",
  "tha-ap393:51.2": "oghatiṇṇam anāsavaṃ / ",
  "tha-ap393:51.3": "sirasā abhivādetvā ",
  "tha-ap393:51.4": "idaṃ vacanam abraviṃ: // // ",
  "tha-ap393:52.1": "‘Vasīsatasahassehi ",
  "tha-ap393:52.2": "adhivāsehi cakkhumā / ",
  "tha-ap393:52.3": "hāsayanto mamaṃ cittaṃ ",
  "tha-ap393:52.4": "nivesanam upehi me.' // // ",
  "tha-ap393:53.1": "Padumuttaro lokavidū ",
  "tha-ap393:53.2": "āhutīnaṃ paṭiggaho / ",
  "tha-ap393:53.3": "mama saṅkappam aññāya ",
  "tha-ap393:53.4": "adhivāsesi cakkhumā. // // ",
  "tha-ap393:54.1": "Adhivāsanam aññāya ",
  "tha-ap393:54.2": "abhivādiya satthuno / ",
  "tha-ap393:54.3": "haṭṭho udaggacitto 'haṃ ",
  "tha-ap393:54.4": "nivesanam upāgamiṃ. // // ",
  "tha-ap393:55.0": "",
  "tha-ap393:55.1": "Mittāmacce samānetvā ",
  "tha-ap393:55.2": "idaṃ vacanam abraviṃ: / ",
  "tha-ap393:55.3": "sudullabho mayā laddho ",
  "tha-ap393:55.4": "maṇijotiraso yathā. // // ",
  "tha-ap393:56.1": "Kena taṃ pūjayisāma? ",
  "tha-ap393:56.2": "appameyyo anupamo / ",
  "tha-ap393:56.3": "atulo asamo vīro ",
  "tha-ap393:56.4": "jino appaṭipuggalo. // // ",
  "tha-ap393:57.1": "Tathā samasamo c' eva ",
  "tha-ap393:57.2": "adutiyo narāsabho / ",
  "tha-ap393:57.3": "dukkaram adhikāram hi ",
  "tha-ap393:57.4": "Buddhānucchavikaṃ tayā. // // ",
  "tha-ap393:58.1": "Nānāpupphe samānetvā ",
  "tha-ap393:58.2": "karoma pupphamaṇḍapaṃ / ",
  "tha-ap393:58.3": "Buddhānucchavikaṃ etaṃ ",
  "tha-ap393:58.4": "sabbapūjā bhavissati. // // ",
  "tha-ap393:59.1": "Uppalaṃ padumañ cāpi ",
  "tha-ap393:59.2": "vassikam atimuttakaṃ / ",
  "tha-ap393:59.3": "campakaṃ nāgap*upphañ ca ",
  "tha-ap393:59.4": "ma*ṇḍapaṃ kārayim ahaṃ. // // ",
  "tha-ap393:60.1": "Satāsanasahassāni ",
  "tha-ap393:60.2": "chattacchāyāya paññapiṃ / ",
  "tha-ap393:60.3": "pacchimam āsanaṃ mayham ",
  "tha-ap393:60.4": "adhikaṃ satam agghati // // ",
  "tha-ap393:61.1": "Satāsanasahassāni . . . ",
  "tha-ap393:61.2": "pe . . . / ",
  "tha-ap393:61.3": "paṭiyādetvā annapānaṃ ",
  "tha-ap393:61.4": "kālam arocayiṃ ahaṃ. // // ",
  "tha-ap393:62.1": "*Ārocitamhi kālamhi* ",
  "tha-ap393:62.2": "Padumuttaro mahāmuni / ",
  "tha-ap393:62.3": "vasīsatasahassehi ",
  "tha-ap393:62.4": "nivesanam upesi me. // // ",
  "tha-ap393:63.1": "Dhārentam uparicchattaṃ ",
  "tha-ap393:63.2": "suphullapupphamaṇḍape / ",
  "tha-ap393:63.3": "vasīsatasahassehi ",
  "tha-ap393:63.4": "nisīdi purisuttamo. // // ",
  "tha-ap393:64.1": "Chattasatasahassāni ",
  "tha-ap393:64.2": "satasahassa-m-āsanaṃ / ",
  "tha-ap393:64.3": "ka*ppiyam anavajjañ ca ",
  "tha-ap393:64.4": "paṭiga*ṇhāhi cakkhumā. // // ",
  "tha-ap393:65.1": "Padumuttaro lokavidū ",
  "tha-ap393:65.2": "āhutīnaṃ paṭiggaho / ",
  "tha-ap393:65.3": "maman tāretukāmo so ",
  "tha-ap393:65.4": "sampaṭicchi mahāmuni. // // ",
  "tha-ap393:66.0": "",
  "tha-ap393:66.1": "Bhikkhussa ekam ekassa ",
  "tha-ap393:66.2": "paccekaṃ patt' adās' ahaṃ / ",
  "tha-ap393:66.3": "jahiṃsu pupphakaṃ pattaṃ ",
  "tha-ap393:66.4": "lohaṃ pattam adhārayuṃ. // // ",
  "tha-ap393:67.1": "Sattarattindivaṃ *Buddho ",
  "tha-ap393:67.2": "ni*sīdi pupphamaṇḍape / ",
  "tha-ap393:67.3": "bodhayanto bahu satte ",
  "tha-ap393:67.4": "dhammacakkaṃ pavattayi. // // ",
  "tha-ap393:68.1": "Dhammacakkaṃ pavattento ",
  "tha-ap393:68.2": "heṭṭhato pupphamaṇḍape / ",
  "tha-ap393:68.3": "cullāsītisahassānaṃ ",
  "tha-ap393:68.4": "dhammābhisamayo ahu. // // ",
  "tha-ap393:69.1": "Sattame divase patte ",
  "tha-ap393:69.2": "Padumuttaro mahāmunī / ",
  "tha-ap393:69.3": "chattacchāyāya*m āsī*no ",
  "tha-ap393:69.4": "imā gāthā abhāsathā: // // ",
  "tha-ap393:70.0": "",
  "tha-ap393:70.1": "Anūnakaṃ dānavaraṃ ",
  "tha-ap393:70.2": "yo me pādāsi māṇavo / ",
  "tha-ap393:70.3": "tam ahaṃ kittayissāmi; ",
  "tha-ap393:70.4": "suṇotha mama bhāsato: // // ",
  "tha-ap393:71.1": "Hatthī assā rathā pattī ",
  "tha-ap393:71.2": "senā ca caturaṅginī / ",
  "tha-ap393:71.3": "parivāressanti taṃ niccaṃ ",
  "tha-ap393:71.4": "sabbadānass' idaṃ phalaṃ. // // ",
  "tha-ap393:72.1": "Hatthiyānam assayānaṃ ",
  "tha-ap393:72.2": "sivikaṃ sandamānikaṃ / ",
  "tha-ap393:72.3": "upaṭṭhissant' imaṃ niccaṃ ",
  "tha-ap393:72.4": "sabbadānass' idaṃ phalaṃ. // // ",
  "tha-ap393:73.1": "Saṭṭhirathasahassāni ",
  "tha-ap393:73.2": "sabbālaṅkārabhūsitā / ",
  "tha-ap393:73.3": "parivāressant' imaṃ niccaṃ ",
  "tha-ap393:73.4": "sabbadānass' idaṃ phalaṃ. // // ",
  "tha-ap393:74.1": "Saṭṭhituriyasahassāni ",
  "tha-ap393:74.2": "bheriyo samalaṅkatā / ",
  "tha-ap393:74.3": "vajjayissant' imaṃ niccaṃ ",
  "tha-ap393:74.4": "sabbadānass' idaṃ phalaṃ. // // ",
  "tha-ap393:75.1": "Chalāsītisahassāni ",
  "tha-ap393:75.2": "nāriyo samalaṅkatā / ",
  "tha-ap393:75.3": "vicittavatthābharaṇā ",
  "tha-ap393:75.4": "āmuttamaṇikuṇḍalā. // // ",
  "tha-ap393:76.1": "Aḷārapamhāhasulā ",
  "tha-ap393:76.2": "susoññā tanumajjhimā / ",
  "tha-ap393:76.3": "parivāressant' imaṃ niccaṃ ",
  "tha-ap393:76.4": "sabbadānass' idaṃ phalaṃ. // // ",
  "tha-ap393:77.1": "Tiṃsakappasahassāni ",
  "tha-ap393:77.2": "devaloke ramissati / ",
  "tha-ap393:77.3": "sahassakkhattuṃ devindo ",
  "tha-ap393:77.4": "devarajjaṃ karissati. // // ",
  "tha-ap393:78.1": "Sahassakkhattuṃ rājā *ca* ",
  "tha-ap393:78.2": "cakkavattī bhavissati / ",
  "tha-ap393:78.3": "padesarajjaṃ vipulaṃ ",
  "tha-ap393:78.4": "gaṇanāto asaṅkhiyaṃ. // // ",
  "tha-ap393:79.1": "Devaloke vasantassa ",
  "tha-ap393:79.2": "puññakammasamaṅgino / ",
  "tha-ap393:79.3": "devalokānupariyante ",
  "tha-ap393:79.4": "ratanachattaṃ dharissati. // // ",
  "tha-ap393:80.1": "Icchissati yadā cāyaṃ ",
  "tha-ap393:80.2": "chadanaṃ dussapupphajaṃ / ",
  "tha-ap393:80.3": "imassa cittam aññāya ",
  "tha-ap393:80.4": "nibaddhaṃ chādayissati. // // ",
  "tha-ap393:81.1": "Devalokā cavitvāna ",
  "tha-ap393:81.2": "sukkamūlena codito / ",
  "tha-ap393:81.3": "puññakammena saṃyutto ",
  "tha-ap393:81.4": "brahmabandhu bhavissati. // // ",
  "tha-ap393:82.1": "Kappasatasahassamhi ",
  "tha-ap393:82.2": "Okkākakulasambhavo / ",
  "tha-ap393:82.3": "Gotamo nāma gottena ",
  "tha-ap393:82.4": "satthā loke bhavissati. // // ",
  "tha-ap393:83.1": "Sabbam etam abhiññāya ",
  "tha-ap393:83.2": "Gotamo Sakyapuṅgavo / ",
  "tha-ap393:83.3": "bhikkhusaṅghe nisīditvā ",
  "tha-ap393:83.4": "etadagge ṭhapessati. // // ",
  "tha-ap393:84.1": "Pilindavaccho nām*ena* ",
  "tha-ap393:84.2": "hessati satthu sāvako / ",
  "tha-ap393:84.3": "devānam asurānañ ca ",
  "tha-ap393:84.4": "gandhabbānañ ca sakkato. // // ",
  "tha-ap393:85.1": "Bhikkhūnaṃ bhikkhunīnañ ca ",
  "tha-ap393:85.2": "gihīnañ ca tath' eva so / ",
  "tha-ap393:85.3": "piyo hutvāna sabbesaṃ ",
  "tha-ap393:85.4": "viharissat' anāsavo. // // ",
  "tha-ap393:86.0": "",
  "tha-ap393:86.1": "Satasahasse kataṃ kammaṃ ",
  "tha-ap393:86.2": "phalaṃ dassesi me idha / ",
  "tha-ap393:86.3": "sumutto saravego ca ",
  "tha-ap393:86.4": "kilese jhāpayissati. // // ",
  "tha-ap393:87.1": "Aho me sukataṃ kammaṃ ",
  "tha-ap393:87.2": "puññakkhette anuttare / ",
  "tha-ap393:87.3": "yatthakāraṃ karitvāna ",
  "tha-ap393:87.4": "patto 'mhi acalaṃ padaṃ. // // ",
  "tha-ap393:88.1": "Anūnakaṃ dānavaram ",
  "tha-ap393:88.2": "adāsi yo hi māṇavo / ",
  "tha-ap393:88.3": "ādipubbaṅgamo āsiṃ ",
  "tha-ap393:88.4": "tassa dānass' idaṃ phalaṃ. // // ",
  "tha-ap393:89.0": "",
  "tha-ap393:89.1": "Chatte sugate datvāna ",
  "tha-ap393:89.2": "saṅghe guṇavaruttame / ",
  "tha-ap393:89.3": "aṭṭhānisaṃse anubhomi ",
  "tha-ap393:89.4": "kammānucchavike mama. // // ",
  "tha-ap393:90.1": "Sītaṃ uṇhaṃ na jānāmi ",
  "tha-ap393:90.2": "rajojallaṃ na lippati / ",
  "tha-ap393:90.3": "anupaddavo anītī ca ",
  "tha-ap393:90.4": "homi apacito sadā. // // ",
  "tha-ap393:91.1": "Sukhumacchaviko homi ",
  "tha-ap393:91.2": "visadaṃ hoti mānasaṃ / ",
  "tha-ap393:91.3": "chattasatasahassāni ",
  "tha-ap393:91.4": "bhave saṃsarato mama. // // ",
  "tha-ap393:92.1": "Sabbālaṅkārayuttāni ",
  "tha-ap393:92.2": "tassa kammassa vāhasā / ",
  "tha-ap393:92.3": "idaṃ jātiṃ ṭhapetvāna ",
  "tha-ap393:92.4": "matthake dhārayanti me. // // ",
  "tha-ap393:93.1": "Tasmā imāya jātiyā ",
  "tha-ap393:93.2": "n' atthi me chattadhāraṇā / ",
  "tha-ap393:93.3": "mama sabbaṃ kataṃ kammaṃ ",
  "tha-ap393:93.4": "vimutticchattapattiyā. // // ",
  "tha-ap393:94.0": "",
  "tha-ap393:94.1": "Dussāni sugate datvā ",
  "tha-ap393:94.2": "saṅghe guṇavaruttame / ",
  "tha-ap393:94.3": "aṭṭhānisaṃse anubhomi ",
  "tha-ap393:94.4": "kammānucchavike mama. // // ",
  "tha-ap393:95.1": "Suvaṇṇavaṇṇo virajo ",
  "tha-ap393:95.2": "sappabhāso patāpavā / ",
  "tha-ap393:95.3": "siniddhaṃ hoti me gattaṃ ",
  "tha-ap393:95.4": "bhave saṃsarato mamaṃ. // // ",
  "tha-ap393:96.1": "Dussasatasahassāni ",
  "tha-ap393:96.2": "setā pītā ca lohitā / ",
  "tha-ap393:96.3": "dhārenti matthake mayhaṃ ",
  "tha-ap393:96.4": "dussadānass' idaṃ phalaṃ. // // ",
  "tha-ap393:97.1": "Koseyyakambalīyāni ",
  "tha-ap393:97.2": "khomakappāsikāni ca / ",
  "tha-ap393:97.3": "sabbattha paṭilābhāmi ",
  "tha-ap393:97.4": "tesaṃ nissandato ahaṃ. // // ",
  "tha-ap393:98.0": "",
  "tha-ap393:98.1": "Patte sugate datvāna ",
  "tha-ap393:98.2": "saṅghe guṇavaruttame / ",
  "tha-ap393:98.3": "dasānisaṃse anubhomi ",
  "tha-ap393:98.4": "kammānucchavike mama. // // ",
  "tha-ap393:99.1": "Suvaṇṇathāle maṇithāle ",
  "tha-ap393:99.2": "rajate pi ca thālake / ",
  "tha-ap393:99.3": "lohitaṅkamaye thāle ",
  "tha-ap393:99.4": "paribhuñjāmi sabbadā. // // ",
  "tha-ap393:100.1": "Anupaddavo anītī ca ",
  "tha-ap393:100.2": "homi apacito sadā / ",
  "tha-ap393:100.3": "lābhī annassa pānassa ",
  "tha-ap393:100.4": "vatthassa sayanassa ca. // // ",
  "tha-ap393:101.1": "Na vinassanti me bhogā; ",
  "tha-ap393:101.2": "ṭhitacitto bhavām' ahaṃ / ",
  "tha-ap393:101.3": "dhammakāmo sadā bhomi ",
  "tha-ap393:101.4": "'ppakileso anāsavo. // // ",
  "tha-ap393:102.1": "Devaloke manusse vā ",
  "tha-ap393:102.2": "anubaddhā ime guṇā / ",
  "tha-ap393:102.3": "chāyā yathāpi rukkhassa ",
  "tha-ap393:102.4": "sabbattha na jahanti maṃ // // ",
  "tha-ap393:103.0": "",
  "tha-ap393:103.1": "Cittabandhanasambaddhā ",
  "tha-ap393:103.2": "sukatā vāsiyo bahū / ",
  "tha-ap393:103.3": "datvāna Buddhaseṭṭhassa ",
  "tha-ap393:103.4": "saṅghassa ca tath' ev' ahaṃ / ",
  "tha-ap393:104.1": "aṭṭhānisaṃse anubhomi ",
  "tha-ap393:104.2": "kammānucchavike mama. // // ",
  "tha-ap393:104.3": "Sūro homi visālī ca ",
  "tha-ap393:104.4": "vesārajjesu pāramī / ",
  "tha-ap393:105.1": "dhitiviriyavā homi ",
  "tha-ap393:105.2": "paggahītamano sadā. // // ",
  "tha-ap393:105.3": "Kilesacchedanaṃ ñāṇam ",
  "tha-ap393:105.4": "sukhumam atulaṃ suciṃ / ",
  "tha-ap393:105.5": "sabbattha paṭilābhāmi ",
  "tha-ap393:105.6": "tassa nissandato mama. // // ",
  "tha-ap393:106.0": "",
  "tha-ap393:106.1": "Aka*kkase apha*ruse ",
  "tha-ap393:106.2": "adhote satthake bahū / ",
  "tha-ap393:106.3": "pasannacitto datvāna ",
  "tha-ap393:106.4": "Buddhasaṅghe tath' eva ca / ",
  "tha-ap393:107.1": "pañcānisaṃse anubhomi ",
  "tha-ap393:107.2": "kammānucchavike mama. // // ",
  "tha-ap393:107.3": "Kalyāṇacittaṃ viriyaṃ ",
  "tha-ap393:107.4": "khantiñ ca mettasatthakaṃ / ",
  "tha-ap393:108.1": "taṇhāsallassa chinnattā ",
  "tha-ap393:108.2": "pañ*ñāsattham anuttaraṃ / ",
  "tha-ap393:108.3": "vaji*rena samaṃ ñāṇaṃ ",
  "tha-ap393:108.4": "tesaṃ nissandato labhe. // // ",
  "tha-ap393:109.0": "",
  "tha-ap393:109.1": "Sūciyo sugate datvā ",
  "tha-ap393:109.2": "saṅghe guṇavaruttame / ",
  "tha-ap393:109.3": "pañcānisaṃse anubhomi ",
  "tha-ap393:109.4": "kammānucchavike mama. // // ",
  "tha-ap393:110.1": "Namassiyo kaṅkhachedo ",
  "tha-ap393:110.2": "abhirūpo ca bhogavā / ",
  "tha-ap393:110.3": "tikkhapañño *sadā homi ",
  "tha-ap393:110.4": "saṃsaranto bhavābhave.* // // ",
  "tha-ap393:111.1": "Gambhīraṃ nipuṇaṃ ṭhānam ",
  "tha-ap393:111.2": "attha-ñāṇena passayiṃ / ",
  "tha-ap393:111.3": "vajiraggasamaṃ ñāṇaṃ ",
  "tha-ap393:111.4": "hoti me tamaghāṭanaṃ. // // ",
  "tha-ap393:112.0": "",
  "tha-ap393:112.1": "Nakhacchedane sugate ",
  "tha-ap393:112.2": "datvā saṅghe guṇavaruttame / ",
  "tha-ap393:112.3": "pañcānisaṃse anubhomi ",
  "tha-ap393:112.4": "kammānucchavike mamaṃ. // // ",
  "tha-ap393:113.1": "Dāsidāse gavasse ca ",
  "tha-ap393:113.2": "bhata*ke ārakkhe bahū* / ",
  "tha-ap393:113.3": "nahāpite bhatake sūde ",
  "tha-ap393:113.4": "sabbatth' eva labhām' ahaṃ. // // ",
  "tha-ap393:114.0": "",
  "tha-ap393:114.1": "Vidhūpane sugate datvā ",
  "tha-ap393:114.2": "tālavaṇṭe ca sobhane / ",
  "tha-ap393:114.3": "aṭṭhānisaṃse anubhomi ",
  "tha-ap393:114.4": "kammānucchavike mama. // // ",
  "tha-ap393:115.1": "Sītam uṇhaṃ na jānāmi ",
  "tha-ap393:115.2": "pariḷāho na vijjati / ",
  "tha-ap393:115.3": "darathaṃ nābhijānāmi ",
  "tha-ap393:115.4": "cittasantāpanaṃ mama. // // ",
  "tha-ap393:116.1": "*Rāgaggi do*samohaggi ",
  "tha-ap393:116.2": "mānaggi diṭṭhiaggi ca / ",
  "tha-ap393:116.3": "sabbaggī nibbutā mayhaṃ ",
  "tha-ap393:116.4": "tassa nissandato mamaṃ. // // ",
  "tha-ap393:117.0": "",
  "tha-ap393:117.1": "Morahatthe cāmariyo ",
  "tha-ap393:117.2": "datvā saṅghe gaṇuttame / ",
  "tha-ap393:117.3": "upasantakileso 'haṃ ",
  "tha-ap393:117.4": "viharāmi anaṅgaṇo. // // ",
  "tha-ap393:118.0": "",
  "tha-ap393:118.1": "Parissāvane sugate ",
  "tha-ap393:118.2": "datvā saṅghe gaṇuttame / ",
  "tha-ap393:118.3": "pañcānisaṃse anubhomi ",
  "tha-ap393:118.4": "kammānucchavike mamaṃ. // // ",
  "tha-ap393:119.1": "Sabbesaṃ samatikkamma ",
  "tha-ap393:119.2": "dibbam āyuṃ labhām' ahaṃ / ",
  "tha-ap393:119.3": "appasayho sadā homi ",
  "tha-ap393:119.4": "corapaccatthikehi vā. // // ",
  "tha-ap393:120.1": "Satthena vā visena vā ",
  "tha-ap393:120.2": "vihesam pi na kubbate / ",
  "tha-ap393:120.3": "antarāmāraṇaṃ n' atthi ",
  "tha-ap393:120.4": "tesaṃ nissandato mamaṃ. // // ",
  "tha-ap393:121.0": "",
  "tha-ap393:121.1": "Teladhāre sugate datvā ",
  "tha-ap393:121.2": "saṅghe guṇavaruttame / ",
  "tha-ap393:121.3": "pañcānisaṃse anubhomi ",
  "tha-ap393:121.4": "kammānucchavike mamaṃ. // // ",
  "tha-ap393:122.1": "Sucārurūpo sugato ",
  "tha-ap393:122.2": "susamuggatamānaso / ",
  "tha-ap393:122.3": "avikkhittamano homi ",
  "tha-ap393:122.4": "sabbārakkhehi rakkhito. // // ",
  "tha-ap393:123.0": "",
  "tha-ap393:123.1": "Sūcighare sugate datvā ",
  "tha-ap393:123.2": "saṅghe guṇavaruttame / ",
  "tha-ap393:123.3": "tīṇānisaṃse anubhomi ",
  "tha-ap393:123.4": "kammānucchavike mamaṃ. // // ",
  "tha-ap393:124.1": "Cetosukhaṃ kāyasukham ",
  "tha-ap393:124.2": "iriyāpathajaṃ sukhaṃ / ",
  "tha-ap393:124.3": "ime guṇe paṭilabhāmi ",
  "tha-ap393:124.4": "tassa nissandato ahaṃ. // // ",
  "tha-ap393:125.0": "",
  "tha-ap393:125.1": "Aṃsabaddhe jine datvā ",
  "tha-ap393:125.2": "saṅghe guṇavaruttame / ",
  "tha-ap393:125.3": "tīṇānisaṃse anubhomi ",
  "tha-ap393:125.4": "kammānucchavike mama. // // ",
  "tha-ap393:126.1": "Saddhamme gādhaṃ vindāmi ",
  "tha-ap393:126.2": "sarāmi dutiyaṃ bhavaṃ / ",
  "tha-ap393:126.3": "sabbattha succhavī homi ",
  "tha-ap393:126.4": "tassa nissandato ahaṃ. // // ",
  "tha-ap393:127.0": "",
  "tha-ap393:127.1": "Kāyabandhe sugate datvā ",
  "tha-ap393:127.2": "saṅghe guṇavaruttame / ",
  "tha-ap393:127.3": "chānisaṃse anubhomi . . . ",
  "tha-ap393:127.4": "pe . . . // // ",
  "tha-ap393:128.1": "Samādhisu na kaṅkhāmi ",
  "tha-ap393:128.2": "vasī homi samādhisu / ",
  "tha-ap393:128.3": "abhejjapariso homi ",
  "tha-ap393:128.4": "ādeyyavacano sadā. // // ",
  "tha-ap393:129.1": "Upaṭṭhitasatī homi ",
  "tha-ap393:129.2": "tāso mayhaṃ na vijjati / ",
  "tha-ap393:129.3": "devaloke manusse vā ",
  "tha-ap393:129.4": "anubaddhā ime guṇā. // // ",
  "tha-ap393:130.0": "",
  "tha-ap393:130.1": "Ādhārake jine datvā ",
  "tha-ap393:130.2": "saṅghe guṇavaruttame / ",
  "tha-ap393:130.3": "pañcavaṇṇehi dāyādo ",
  "tha-ap393:130.4": "acalo homi kenaci. // // ",
  "tha-ap393:131.1": "Ye keci me sutā dhammā ",
  "tha-ap393:131.2": "satiñāṇappabodhanā / ",
  "tha-ap393:131.3": "*va*tā me na vinassanti ",
  "tha-ap393:131.4": "bhavanti suvinicchitā. // // ",
  "tha-ap393:132.0": "",
  "tha-ap393:132.1": "Bhājane paribhoge ca ",
  "tha-ap393:132.2": "datvā Buddhegaṇuttame / ",
  "tha-ap393:132.3": "tīṇānisaṃse anubhomi . . . ",
  "tha-ap393:132.4": "pe . . . // // Sovaṇṇamaye ",
  "tha-ap393:133.1": "maṇimaye ",
  "tha-ap393:133.2": "atho pi phalikāmaye / ",
  "tha-ap393:133.3": "lohitaṅkamaye c' eva ",
  "tha-ap393:133.4": "labhāmi bhājane ahaṃ. // // ",
  "tha-ap393:134.1": "Bhariyā dāsadāsī ca ",
  "tha-ap393:134.2": "hatthassarathapattike / ",
  "tha-ap393:134.3": "itthī patibbatā c' eva ",
  "tha-ap393:134.4": "paribhogādisampadā. // // ",
  "tha-ap393:135.1": "Vijjā mantapade c' eva ",
  "tha-ap393:135.2": "vividhe āgame bahū / ",
  "tha-ap393:135.3": "sabbaṃ sippan nisāmemi ",
  "tha-ap393:135.4": "paribhogādisampadā. // // ",
  "tha-ap393:136.0": "",
  "tha-ap393:136.1": "Thālake sugate datvā ",
  "tha-ap393:136.2": "saṅghe guṇavaruttame / ",
  "tha-ap393:136.3": "tīṇānisaṃse anubhomi . . . ",
  "tha-ap393:136.4": "pe . . . // // Sovaṇṇamaye ",
  "tha-ap393:137.1": "maṇimaye ",
  "tha-ap393:137.2": "atho pi phalikāmaye / ",
  "tha-ap393:137.3": "lohitaṅkamaye c' eva ",
  "tha-ap393:137.4": "labhāmi thālake ahaṃ. // // ",
  "tha-ap393:138.1": "Assatthake phalamaye ",
  "tha-ap393:138.2": "atho pokkharapattake / ",
  "tha-ap393:138.3": "madhupānakasaṅkhe ca ",
  "tha-ap393:138.4": "labhāmi thālake ahaṃ. // // ",
  "tha-ap393:139.1": "Vatte guṇe paṭilabhe ",
  "tha-ap393:139.2": "ācārakiriyāsu ca / ",
  "tha-ap393:139.3": "ime guṇe paṭilabhe ",
  "tha-ap393:139.4": "tassa nissandato ahaṃ. // // Bhesajje ",
  "tha-ap393:140.0": "",
  "tha-ap393:140.1": "sugate datvā ",
  "tha-ap393:140.2": "saṅghe guṇavaruttame / ",
  "tha-ap393:140.3": "dasānisaṃse anubhomi . . . ",
  "tha-ap393:140.4": "pe . . . // // ",
  "tha-ap393:141.1": "Āyuvā balavā vīro ",
  "tha-ap393:141.2": "vaṇṇavā yasavā sukhī / ",
  "tha-ap393:141.3": "anupaddavo anītī ca ",
  "tha-ap393:141.4": "bhomi cāpacito sadā. / ",
  "tha-ap393:141.5": "Na me piyaviyog' atthi ",
  "tha-ap393:141.6": "tassa nissandato mama. // // ",
  "tha-ap393:142.0": "",
  "tha-ap393:142.1": "Upāhane jine datvā ",
  "tha-ap393:142.2": "saṅghe guṇavaruttame / ",
  "tha-ap393:142.3": "tīṇānisaṃse anubhomi . . . ",
  "tha-ap393:142.4": "pe . . . // // ",
  "tha-ap393:143.1": "Hatthiyānam assayānaṃ ",
  "tha-ap393:143.2": "sivikaṃ sandamānikaṃ / saṭṭhiṃ ",
  "tha-ap393:143.3": "satasahassāni ",
  "tha-ap393:143.4": "parivārenti maṃ sadā. // // ",
  "tha-ap393:144.1": "Maṇimayā maṇḍalakā ",
  "tha-ap393:144.2": "sovaṇṇarajatapādukā / ",
  "tha-ap393:144.3": "nibbattanti paduddhāre ",
  "tha-ap393:144.4": "bhave saṃsarato mama. // // ",
  "tha-ap393:145.1": "Niyamaṃ paṭidhāvanti ācāraguṇasodhanaṃ / ",
  "tha-ap393:145.2": "",
  "tha-ap393:145.3": "ime guṇe paṭilabhe ",
  "tha-ap393:145.4": "tassa nissandato ahaṃ. // // ",
  "tha-ap393:146.0": "",
  "tha-ap393:146.1": "Pāduke sugate datvā ",
  "tha-ap393:146.2": "saṅghe guṇavaruttame / ",
  "tha-ap393:146.3": "iddhipādukam āruyha ",
  "tha-ap393:146.4": "viharāmi yadicchakaṃ. // // Mukhapuñchanacole ",
  "tha-ap393:147.0": "",
  "tha-ap393:147.1": "ca ",
  "tha-ap393:147.2": "datvā Buddhe gaṇuttame / ",
  "tha-ap393:147.3": "pañcānisaṃse anubhomi . . . ",
  "tha-ap393:147.4": "pe . . . // // ",
  "tha-ap393:148.1": "Suvaṇṇavaṇṇo virajo ",
  "tha-ap393:148.2": "sappabhāso patāpavā / ",
  "tha-ap393:148.3": "siniddhaṃ hoti me gattaṃ ",
  "tha-ap393:148.4": "rajojallaṃ na lippati. / ",
  "tha-ap393:148.5": "Ime guṇe paṭilabhe ",
  "tha-ap393:148.6": "tassa nissandato ahaṃ // // ",
  "tha-ap393:149.0": "",
  "tha-ap393:149.1": "Kattaradaṇḍe sugate ",
  "tha-ap393:149.2": "datvā saṅghe guṇavaruttame / ",
  "tha-ap393:149.3": "chānisaṃse anubhomi . . . ",
  "tha-ap393:149.4": "pe . . . // // ",
  "tha-ap393:150.1": "Puttā mayhaṃ bahū honti ",
  "tha-ap393:150.2": "tāso mayhaṃ na vijjati / ",
  "tha-ap393:150.3": "appasayho sadā homi ",
  "tha-ap393:150.4": "sabbārakkhehi rakkhito / ",
  "tha-ap393:150.5": "calitaṃ maṃ *na jānāmi* ",
  "tha-ap393:150.6": "āgataṃ mānasaṃ mamaṃ. // // ",
  "tha-ap393:151.0": "",
  "tha-ap393:151.1": "Osadham añjanaṃ datvā ",
  "tha-ap393:151.2": "Buddhe saṅghe gaṇuttame / ",
  "tha-ap393:151.3": "aṭṭhānisaṃse anubhomi . . . ",
  "tha-ap393:151.4": "pe . . . // // ",
  "tha-ap393:152.1": "Visālanayano homi ",
  "tha-ap393:152.2": "seta-pīta-salohito / ",
  "tha-ap393:152.3": "anāvilapasannakkho ",
  "tha-ap393:152.4": "sabbaro*gavivajjito* // // ",
  "tha-ap393:153.1": "labhāmi dibbanayanaṃ ",
  "tha-ap393:153.2": "paññācakkhum anuttaraṃ / ",
  "tha-ap393:153.3": "ime guṇe paṭilabhe ",
  "tha-ap393:153.4": "tassa nissandato ahaṃ. // // ",
  "tha-ap393:154.0": "",
  "tha-ap393:154.1": "Kuñcike sugate datvā ",
  "tha-ap393:154.2": "saṅghe guṇavaruttame / ",
  "tha-ap393:154.3": "dhammadvāravivaraṇaṃ ",
  "tha-ap393:154.4": "labhāmi ñāṇakuñcikaṃ. // // ",
  "tha-ap393:155.0": "",
  "tha-ap393:155.1": "Kuñcikānaṃ ghare datvā ",
  "tha-ap393:155.2": "*Buddhe saṅghe . . . pe . . .* / ",
  "tha-ap393:155.3": "dvānisaṃse anubhomi . . . ",
  "tha-ap393:155.4": "pe . . . // // ",
  "tha-ap393:155.5": "appakodho anāyāso ",
  "tha-ap393:155.6": "saṃsaranto bhave ahaṃ. ",
  "tha-ap393:156.0": "",
  "tha-ap393:156.1": "Āyoge sugate datvā ",
  "tha-ap393:156.2": "saṅghe . . . pe . . . / ",
  "tha-ap393:156.3": "pañcānisaṃse anubhomi . . . ",
  "tha-ap393:156.4": "pe . . . // // ",
  "tha-ap393:157.1": "Samādhisu na *kampāmi ",
  "tha-ap393:157.2": "vasī homi* samādhisu / ",
  "tha-ap393:157.3": "abhejjapariso homi ",
  "tha-ap393:157.4": "ādeyyavacano sadā / ",
  "tha-ap393:157.5": "Jāticca bhogasampatti ",
  "tha-ap393:157.6": "bhave saṃsarato mamaṃ. // // ",
  "tha-ap393:158.0": "",
  "tha-ap393:158.1": "Dhūmanette jine datvā ",
  "tha-ap393:158.2": "saṅghe . . . pe . . . / ",
  "tha-ap393:158.3": "tīṇānisaṃsā . . . ",
  "tha-ap393:158.4": "pe . . . // // ",
  "tha-ap393:159.1": "Sati *me ujukā hoti ",
  "tha-ap393:159.2": "susa*mbaddhā ca nahāruyo / ",
  "tha-ap393:159.3": "labhāmi dibbanayanaṃ ",
  "tha-ap393:159.4": "tassa nissandato ahaṃ. // // Dīpathāle ",
  "tha-ap393:160.0": "",
  "tha-ap393:160.1": "jine datvā ",
  "tha-ap393:160.2": "saṅghe . . . pe . . . / ",
  "tha-ap393:160.3": "tīṇānusaṃsānubhomi . . . ",
  "tha-ap393:160.4": "pe . . . // // ",
  "tha-ap393:161.1": "Jātimā aṅgasampanno ",
  "tha-ap393:161.2": "pañña*vā Bu*ddhasammato / ",
  "tha-ap393:161.3": "ime guṇe paṭilabhe ",
  "tha-ap393:161.4": "tassa nissandato ahaṃ. // // ",
  "tha-ap393:162.0": "",
  "tha-ap393:162.1": "Tumbake ca karaṇḍe ca ",
  "tha-ap393:162.2": "datvā Buddhe gaṇuttame / ",
  "tha-ap393:162.3": "dasānisaṃsānubhomi . . . pe . . . // // ",
  "tha-ap393:162.4": "Sadā gutto ",
  "tha-ap393:163.1": "sukhasamaṅgī ",
  "tha-ap393:163.2": "mahāyasavā tathāgattī / ",
  "tha-ap393:163.3": "bhattikato sukhumālo ",
  "tha-ap393:163.4": "sabbītiparivajjito. // // ",
  "tha-ap393:164.1": "Vipule ca guṇe lābhī ",
  "tha-ap393:164.2": "samāvacaraṇā mama / ",
  "tha-ap393:164.3": "suvivajjitaubbego ",
  "tha-ap393:164.4": "tumbake ca karaṇḍake. // // ",
  "tha-ap393:165.1": "Labhāmi caturo vaṇṇe ",
  "tha-ap393:165.2": "hatthassā ratanāni ca / ",
  "tha-ap393:165.3": "tāni me na vinassanti ",
  "tha-ap393:165.4": "tumbadāne idaṃ phalaṃ. // // Hatthī ",
  "tha-ap393:166.0": "",
  "tha-ap393:166.1": "līlaṅgake datvā ",
  "tha-ap393:166.2": "Buddhe saṅghe . . . pe . . . / ",
  "tha-ap393:166.3": "pañcānisaṃsānubhomi . . . ",
  "tha-ap393:166.4": "pe . . . // // ",
  "tha-ap393:167.1": "Sabbalakkhaṇasampanno ",
  "tha-ap393:167.2": "āyupaññāsamāhito / ",
  "tha-ap393:167.3": "sabbāyāsavinimutto ",
  "tha-ap393:167.4": "kāyo me hoti sabbadā. // // ",
  "tha-ap393:168.0": "",
  "tha-ap393:168.1": "Tanudhāre sunisite ",
  "tha-ap393:168.2": "saṅghe datvāna pipphale / ",
  "tha-ap393:168.3": "kilesakantanaṃ ñāṇaṃ ",
  "tha-ap393:168.4": "labhāmi atulaṃ suciṃ // // ",
  "tha-ap393:169.0": "",
  "tha-ap393:169.1": "Saṇḍāse sugate datvā ",
  "tha-ap393:169.2": "saṅghe . . . pe . . . / ",
  "tha-ap393:169.3": "kilesaluñcanaṃ ñāṇaṃ ",
