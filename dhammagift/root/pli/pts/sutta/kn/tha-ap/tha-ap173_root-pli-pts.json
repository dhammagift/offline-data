  "tha-ap173:0.3": "",
  "tha-ap173:1.1": "Pabbate Himavantamhi ",
  "tha-ap173:1.2": "mahājātassaro ahu / ",
  "tha-ap173:1.3": "tatthajo rakkhaso āsiṃ ",
  "tha-ap173:1.4": "ghorarūpo mahabbalo. // // ",
  "tha-ap173:2.1": "*Kumudaṃ* pupphate tattha ",
  "tha-ap173:2.2": "cakkamattāni jāyare / ",
  "tha-ap173:2.3": "ocināmi c' ahaṃ pupphaṃ ",
  "tha-ap173:2.4": "phalino samitaṃ tadā. // // ",
  "tha-ap173:3.1": "Atthadassī tu bhagavā ",
  "tha-ap173:3.2": "dipadindo narāsabho / ",
  "tha-ap173:3.3": "pupphaṃ saṅkocitaṃ disvā ",
  "tha-ap173:3.4": "āgacchi mama santikaṃ. // // ",
  "tha-ap173:4.1": "Upāgatañ ca sambuddhaṃ ",
  "tha-ap173:4.2": "devadevaṃ narāsabhaṃ / ",
  "tha-ap173:4.3": "*sabbañ ca pupphaṃ paggayha* ",
  "tha-ap173:4.4": "Buddhassa abhiropayiṃ. // // ",
  "tha-ap173:5.1": "Yāvatā Himavantato ",
  "tha-ap173:5.2": "yāva samantato ahū / ",
  "tha-ap173:5.3": "aggacchadanasampanno ",
  "tha-ap173:5.4": "āgamāsi Tathāgato. // // ",
  "tha-ap173:6.1": "Aṭṭhārase kappasate ",
  "tha-ap173:6.2": "yaṃ puppham abhiropayiṃ / ",
  "tha-ap173:6.3": "duggatiṃ nābhijānāmi ",
  "tha-ap173:6.4": "Buddhapūjāy' idaṃ phalaṃ. // // ",
  "tha-ap173:7.1": "Ito pannarase kappe ",
  "tha-ap173:7.2": "sattāhesuṃ *ja*nādhipā / ",
  "tha-ap173:7.3": "Sahassaratha-nāmā te ",
  "tha-ap173:7.4": "cakkavattī mahabbalā. // // ",
  "tha-ap173:8.1": "Paṭisambhidā . . . pe . . . ",
  "tha-ap173:8.2": "",
  "tha-ap173:8.3": "pe . . . // // ",
  "tha-ap173:8.4": "",
  "tha-ap173:9.1": "Itthaṃ sudaṃ ā. Kumudamāliyo thero i. g. a-ti. *Ku*mudamāliyattherassa apadānaṃ samattaṃ. ",
  "tha-ap173:10.1": ""
}
