  "tha-ap263:0.1": "",
  "tha-ap263:0.2": "",
  "tha-ap263:0.3": "",
  "tha-ap263:1.1": "Suvaṇṇavaṇṇaṃ Siddhatthaṃ ",
  "tha-ap263:1.2": "gacchantam antarāpaṇe / ",
  "tha-ap263:1.3": "jalajagge duve gayha ",
  "tha-ap263:1.4": "upagacchiṃ narāsabhaṃ. // // ",
  "tha-ap263:2.1": "Ekañ ca pupphaṃ pādesu ",
  "tha-ap263:2.2": "Buddhaseṭṭhassa nikkhipiṃ / ",
  "tha-ap263:2.3": "ekañ ca pupphaṃ paggayha ",
  "tha-ap263:2.4": "ākāse ukkhipim ahaṃ. // // ",
  "tha-ap263:3.1": "Catunavute ito kappe ",
  "tha-ap263:3.2": "yaṃ puppham abhiropayiṃ / ",
  "tha-ap263:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap263:3.4": "pupphadānass' idaṃ phalaṃ. // // ",
  "tha-ap263:4.1": "Ito battiṃsakappamhi ",
  "tha-ap263:4.2": "eko āsi mahīpati / ",
  "tha-ap263:4.3": "Antalikkhacaro nāma ",
  "tha-ap263:4.4": "cakkavattī mahabbalo. // // ",
  "tha-ap263:5.1": "Paṭisambhidā . . . pe . . . ",
  "tha-ap263:5.2": "",
  "tha-ap263:5.3": "pe . . . // // ",
  "tha-ap263:5.4": "",
  "tha-ap263:6.1": "Itthaṃ sudam āyasmā Ākāsukkhipiyo thero i. g. a-ti. Ākāsukkhipiyattherassa ",
  "tha-ap263:7.1": "apadānaṃ samattaṃ. "
}
