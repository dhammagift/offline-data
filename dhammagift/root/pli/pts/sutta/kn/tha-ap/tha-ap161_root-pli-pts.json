  "tha-ap161:1.1": "Kānanaṃ vanam ogayha ",
  "tha-ap161:1.2": "vasāmi luddako ahaṃ / ",
  "tha-ap161:1.3": "punnāgaṃ pupphitaṃ disvā ",
  "tha-ap161:1.4": "Buddhaseṭṭhaṃ anussariṃ. // // ",
  "tha-ap161:2.1": "Taṃ pupphaṃ ocinitvāna ",
  "tha-ap161:2.2": "sugandhaṃ gandhagandhitaṃ / ",
  "tha-ap161:2.3": "thūpaṃ karitvā puḷine ",
  "tha-ap161:2.4": "Buddhassa abhiropayiṃ. // // ",
  "tha-ap161:3.1": "Dvenavute ito kappe ",
  "tha-ap161:3.2": "yaṃ puppham abhipūjayiṃ / ",
  "tha-ap161:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap161:3.4": "Buddhapūjāy' idaṃ phalaṃ. // // ",
  "tha-ap161:4.1": "Ekamhi navute kappe ",
  "tha-ap161:4.2": "eko āsi Tamonudo / ",
  "tha-ap161:4.3": "sattaratanasampanno ",
  "tha-ap161:4.4": "cakkavattī mahabbalo. // // ",
  "tha-ap161:5.1": "Paṭisambhidā . . . ",
  "tha-ap161:5.2": "pe . . . ",
  "tha-ap161:5.3": "pe . . . // // ",
  "tha-ap161:6.1": "Itthaṃ sudaṃ ā. Punnāgapupphiyo thero i. g. ā-ti. Punnāgapupphiyattherassa apadānaṃ samattaṃ. Himavantass' avidūre ",
  "tha-ap161:7.1": ""
}
