  "tha-ap100:0.2": "",
  "tha-ap100:0.3": "",
  "tha-ap100:1.1": "Siddhatthassa bhagavato ",
  "tha-ap100:1.2": "adāsiṃ paṇṇasantharaṃ / ",
  "tha-ap100:1.3": "samantā upakāriñ ca ",
  "tha-ap100:1.4": "kusumaṃ okiriṃ ahaṃ. // // ",
  "tha-ap100:2.1": "Pāsāde *ca* guhaṃ rammaṃ ",
  "tha-ap100:2.2": "anubhomi mahārahaṃ / ",
  "tha-ap100:2.3": "mahagghāni ca pupphāni ",
  "tha-ap100:2.4": "sayane 'bhisavanti me. // // ",
  "tha-ap100:3.1": "Sayane 'han tuvaṭṭāmi ",
  "tha-ap100:3.2": "vicitte pupphasanthate / ",
  "tha-ap100:3.3": "pupphavuṭṭhi ca sayane ",
  "tha-ap100:3.4": "abhivassati tāvade. // // ",
  "tha-ap100:4.1": "Catunavut' ito kappe ",
  "tha-ap100:4.2": "adāsiṃ paṇṇasantharaṃ / ",
  "tha-ap100:4.3": "duggatiṃ nābhijānāmi ",
  "tha-ap100:4.4": "santharassa idaṃ phalaṃ. // // ",
  "tha-ap100:5.1": "Ṭhitosanthārakā nāma ",
  "tha-ap100:5.2": "satta te cakkavattino / ",
  "tha-ap100:5.3": "ito te pañcame kappe ",
  "tha-ap100:5.4": "uppajjiṃsu janādhipā. // // ",
  "tha-ap100:6.1": "Paṭisambhidā catasso ",
  "tha-ap100:6.2": "vimokhā pi ca aṭṭh' ime / chaḍabhiññā sacchikatā ",
  "tha-ap100:6.3": "kataṃ Buddhassa sāsanan ti. // // ",
  "tha-ap100:7.1": "Itthaṃ sudaṃ āyasmā Senādāyako-thero imā gāthāyo abhāsitthā ti. ",
  "tha-ap100:8.1": "Senāsanadāyakatherassa apadānaṃ samattaṃ. "
}
