  "tha-ap443:1.1": "Kakusandho mahāvīro ",
  "tha-ap443:1.2": "sabbadhammāna pāragū / ",
  "tha-ap443:1.3": "gaṇamhā vupakaṭṭho so ",
  "tha-ap443:1.4": "agamāsi vanantaraṃ. // // ",
  "tha-ap443:2.1": "Bījabījaṃ gahetvāna ",
  "tha-ap443:2.2": "latāya āvuṇiṃ ahaṃ / ",
  "tha-ap443:2.3": "bhagavā ca tamhi samaye ",
  "tha-ap443:2.4": "jhāyate pabbatantare. // // ",
  "tha-ap443:3.1": "Disvān' ahaṃ devadevaṃ ",
  "tha-ap443:3.2": "vippasannena cetasā / ",
  "tha-ap443:3.3": "dakkhiṇeyyassa vīrassa ",
  "tha-ap443:3.4": "bījabījaṃ *padās' ",
  "tha-ap443:4.1": "ahaṃ* // // Imasmiṃ ñeva kappasmiṃ ",
  "tha-ap443:4.2": "yaṃ phalam adadiṃ tadā / ",
  "tha-ap443:4.3": "duggatiṃ nābhijānāmi ",
  "tha-ap443:4.4": "bījabījass' idaṃ phalaṃ. // // ",
  "tha-ap443:5.1": "Kilesā . . . pe . . . ",
  "tha-ap443:5.2": "pe . . . ",
  "tha-ap443:5.3": "pe . . . // // ",
  "tha-ap443:5.4": "Sāgataṃ . . . ",
  "tha-ap443:6.1": "pe . . . ",
  "tha-ap443:6.2": "pe . . . ",
  "tha-ap443:6.3": "pe . . . // // ",
  "tha-ap443:6.4": "",
  "tha-ap443:7.1": "Paṭisambhidā . . . pe . . . ",
  "tha-ap443:7.2": "pe . . . ",
  "tha-ap443:7.3": "",
  "tha-ap443:7.4": "pe . . . // // ",
  "tha-ap443:8.1": "Itthaṃ sudam āyasmā Vibhīṭakamiñjiyo th. i. g. a-ti. Vibhīṭakamiñjiyattherassa ",
  "tha-ap443:9.1": "apadānaṃ samattaṃ. "
}
