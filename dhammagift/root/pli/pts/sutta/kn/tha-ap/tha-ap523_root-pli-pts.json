  "tha-ap523:0.3": "",
  "tha-ap523:1.1": "",
  "tha-ap523:1.2": "Lambako nāma pabbato / ",
  "tha-ap523:1.3": "tatth' Opatisso sambuddho ",
  "tha-ap523:1.4": "abbhokāsamhi caṅkami. // // ",
  "tha-ap523:2.1": "Migaluddo tadā āsiṃ ",
  "tha-ap523:2.2": "araññe kānane ahaṃ / ",
  "tha-ap523:2.3": "disvān' ahaṃ devadevaṃ ",
  "tha-ap523:2.4": "tiṇamuṭṭhim adās' ahaṃ. // // ",
  "tha-ap523:3.1": "Nisīdanatthaṃ Buddhasa ",
  "tha-ap523:3.2": "datvā cittaṃ pasādayiṃ / ",
  "tha-ap523:3.3": "sambuddhaṃ abhivādetvā ",
  "tha-ap523:3.4": "pakkāmiṃ uttarāmukho. // // ",
  "tha-ap523:4.1": "Aciragatamattassa ",
  "tha-ap523:4.2": "migarājā aheṭhayi / ",
  "tha-ap523:4.3": "sīhena patito santo ",
  "tha-ap523:4.4": "tattha kālakato ahaṃ. // // ",
  "tha-ap523:5.1": "Āsanne me kataṃ kammaṃ ",
  "tha-ap523:5.2": "Buddhaseṭṭhe anāsave / ",
  "tha-ap523:5.3": "sumutto saravego ca devalokaṃ ",
  "tha-ap523:5.4": "agacch ahaṃ. // // ",
  "tha-ap523:6.1": "Yūpo tatthaṃ subho āsi ",
  "tha-ap523:6.2": "puññakammābhinimmito / ",
  "tha-ap523:6.3": "sahassakaṇḍo satageṇḍu ",
  "tha-ap523:6.4": "dhajālu haritāmayo. // // ",
  "tha-ap523:7.1": "Pabhā niddhāvaṭe tassa ",
  "tha-ap523:7.2": "sataraṃsīva uggato / ",
  "tha-ap523:7.3": "ākiṇṇo devakaññābhi ",
  "tha-ap523:7.4": "āmodiṃ kāmakāmi 'haṃ. // // ",
  "tha-ap523:8.1": "Devalokā cavitvānā ",
  "tha-ap523:8.2": "sukkamūlena codito / ",
  "tha-ap523:8.3": "āgantvāna manusattaṃ ",
  "tha-ap523:8.4": "patto 'mhi āsavakkhayaṃ. // // ",
  "tha-ap523:9.1": "Catunavute ito kappe ",
  "tha-ap523:9.2": "nisīdanam adās' ahaṃ / ",
  "tha-ap523:9.3": "duggatiṃ nābhijānāmi ",
  "tha-ap523:9.4": "tiṇamuṭṭhe idaṃ phalaṃ. // // ",
  "tha-ap523:10.1": "Kilesā . . . pe . . . ",
  "tha-ap523:10.2": "pe . . . ",
  "tha-ap523:10.3": "pe . . . // // ",
  "tha-ap523:10.4": "Sāgataṃ . . . ",
  "tha-ap523:11.1": "pe . . . ",
  "tha-ap523:11.2": "pe . . . ",
  "tha-ap523:11.3": "pe . . . // // ",
  "tha-ap523:11.4": "",
  "tha-ap523:12.1": "Paṭisambhidā . . . pe . . . ",
  "tha-ap523:12.2": "pe . . . ",
  "tha-ap523:12.3": "",
  "tha-ap523:12.4": "pe . . . // // ",
  "tha-ap523:13.1": "Itthaṃ sudaṃ āyasmā Tiṇamuṭṭhidāyako th. i. g. a-ti. Tiṇamuṭṭhidāyakattherassa apadānaṃ samattaṃ. ",
  "tha-ap523:14.1": ""
}
