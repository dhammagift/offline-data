  "tha-ap293:0.1": "",
  "tha-ap293:0.2": "",
  "tha-ap293:0.3": "",
  "tha-ap293:1.1": "Ajito nāma nāmena ",
  "tha-ap293:1.2": "ahosiṃ brāhmaṇo tadā / ",
  "tha-ap293:1.3": "āhutiṃ yiṭṭhukāmo 'haṃ ",
  "tha-ap293:1.4": "nānāpupphaṃ samānayiṃ. // // ",
  "tha-ap293:2.1": "Jalantaṃ citakaṃ katvā ",
  "tha-ap293:2.2": "Sikhino lokabandhuno / ",
  "tha-ap293:2.3": "tañ ca pupphaṃ samānetvā ",
  "tha-ap293:2.4": "citake okirim ahaṃ. // // ",
  "tha-ap293:3.1": "Ekatiṃse ito kappe ",
  "tha-ap293:3.2": "yaṃ puppham abhipūjayiṃ / ",
  "tha-ap293:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap293:3.4": "Buddhapūjāy' idaṃ phalaṃ. // // ",
  "tha-ap293:4.1": "Sattavīse ito kappe ",
  "tha-ap293:4.2": "satt' āsuṃ manujādhipā / ",
  "tha-ap293:4.3": "Supajjalita-nāmā te ",
  "tha-ap293:4.4": "cakkavattī mahabbalā. // // ",
  "tha-ap293:5.1": "Paṭisambhidā . . . pe . . . ",
  "tha-ap293:5.2": "",
  "tha-ap293:5.3": "pe . . . // // ",
  "tha-ap293:5.4": "",
  "tha-ap293:6.1": "Itthaṃ sudam āyasmā Citapūjako thero i. g. a-ti. Citapūjakattherassa ",
  "tha-ap293:7.1": "apadānaṃ samattaṃ. "
}
