  "tha-ap467:1.1": "Siddhatthassa bhagavato ",
  "tha-ap467:1.2": "tālavaṇṭam adās' ahaṃ / ",
  "tha-ap467:1.3": "sumanehi paṭicchannaṃ ",
  "tha-ap467:1.4": "dhārayāmi mahāyasaṃ. // // ",
  "tha-ap467:2.1": "Catunavute ito kappe ",
  "tha-ap467:2.2": "tālavaṇṭam adās' ahaṃ / ",
  "tha-ap467:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap467:2.4": "tālavaṇṭass' idaṃ phalaṃ. // // ",
  "tha-ap467:3.1": "Kilesā . . . ",
  "tha-ap467:3.2": "pe . . . ",
  "tha-ap467:3.3": "",
  "tha-ap467:4.1": "",
  "tha-ap467:4.2": "pe . . . ",
  "tha-ap467:4.3": "pe . . . // // Sāgataṃ . . . pe . . . pe . . . pe . . . // // ",
  "tha-ap467:5.1": "Paṭisambhidā . . . ",
  "tha-ap467:5.2": "pe . . . ",
  "tha-ap467:5.3": "pe . . . pe . . . // // ",
  "tha-ap467:6.1": "Itthaṃ sudam āyasmā Sumanatālavaṇṭiyo th. i. g. a-ti. Sumanatālavaṇṭiyattherassa ",
  "tha-ap467:7.1": "apadānaṃ samattaṃ. "
}
