  "tha-ap436:1.1": "jalitaṃ ",
  "tha-ap436:1.2": "dīparukkhaṃ va jotitaṃ / ",
  "tha-ap436:1.3": "kañcanaṃ va virocantaṃ ",
  "tha-ap436:1.4": "addasaṃ dipaduttamaṃ. // // ",
  "tha-ap436:2.1": "Kamaṇḍaluṃ ṭhapetvāna ",
  "tha-ap436:2.2": "vā* kacīrañ ca kuṇḍikaṃ* / ",
  "tha-ap436:2.3": "ekaṃsaṃ ajinaṃ katvā ",
  "tha-ap436:2.4": "buddhaseṭṭhaṃ thaviṃ ahaṃ: // // ",
  "tha-ap436:3.1": "‘Tam andhakāraṃ vidhamaṃ ",
  "tha-ap436:3.2": "mohajālaṃ samākulaṃ / ",
  "tha-ap436:3.3": "ñāṇalokaṃ dassayitvā ",
  "tha-ap436:3.4": "nittiṇṇo 'si mahāmuni. // // ",
  "tha-ap436:4.1": "Samuddharasi 'maṃ lokaṃ ",
  "tha-ap436:4.2": "sabbāvantaṃ a*nuttaraṃ / ",
  "tha-ap436:4.3": "ñāṇe te upamā n' atthi* yāvatā ca gato ",
  "tha-ap436:4.4": "gati. // // ",
  "tha-ap436:5.1": "Tena ñāṇena sabbaññū ",
  "tha-ap436:5.2": "iti bhotvā pavuccati / ",
  "tha-ap436:5.3": "vandāmi taṃ mahāvīra sabbaññūtam ",
  "tha-ap436:5.4": "anāsavaṃ. // // Satasahasse ",
  "tha-ap436:6.1": "ito kappe ",
  "tha-ap436:6.2": "Buddhaseṭṭhaṃ thaviṃ ahaṃ / ",
  "tha-ap436:6.3": "duggatiṃ nābhijānāmi ",
  "tha-ap436:6.4": "ñāṇatthavanāy' idaṃ phalaṃ. // // ",
  "tha-ap436:7.1": "Kilesā . . . ",
  "tha-ap436:7.2": "pe . . . ",
  "tha-ap436:7.3": "",
  "tha-ap436:8.1": "",
  "tha-ap436:8.2": "pe . . . ",
  "tha-ap436:8.3": "pe . . . // // Sāgataṃ . . . pe . . . pe . . . pe . . . // // ",
  "tha-ap436:9.1": "Paṭisambhidā . . . ",
  "tha-ap436:9.2": "pe . . . ",
  "tha-ap436:9.3": "pe . . . pe . . . // // ",
  "tha-ap436:10.1": "Itthaṃ sudaṃ āyasmā Ñāṇathaviko thero i. g. a-ti. Ñāṇathavikattherassa ",
  "tha-ap436:11.1": "apadānaṃ samattaṃ. "
}
