{
  "tha-ap66:0.1": "",
  "tha-ap66:0.2": "",
  "tha-ap66:0.3": "",
  "tha-ap66:1.1": "Usabhaṃ pavaraṃ vīraṃ ",
  "tha-ap66:1.2": "mahesiṃ vijitāvinaṃ / ",
  "tha-ap66:1.3": "suvaṇṇavaṇṇaṃ sambuddhaṃ ",
  "tha-ap66:1.4": "ko disvā nappasidati? // // ",
  "tha-ap66:2.1": "Himavā vāparimeyyo ",
  "tha-ap66:2.2": "sāgaro va duruttaro / ",
  "tha-ap66:2.3": "tad eva jhānaṃ Buddhassa ",
  "tha-ap66:2.4": "ko disvā nappasīdati? // // ",
  "tha-ap66:3.1": "Vasudhā yathāppameyyā ",
  "tha-ap66:3.2": "cittā vanavaṭaṃsikā / ",
  "tha-ap66:3.3": "tath' eva sīlaṃ Buddhassa ",
  "tha-ap66:3.4": "ko disvā nappasīdati? // // ",
  "tha-ap66:4.1": "Anilañjasāsaṅkhubbho ",
  "tha-ap66:4.2": "yath' ākāso asaṅkhiyo / ",
  "tha-ap66:4.3": "tath' eva ñāṇaṃ Buddhassa ",
  "tha-ap66:4.4": "ko disvā nappasīdati? // // ",
  "tha-ap66:5.1": "Imāhi catūhi gāthāhi ",
  "tha-ap66:5.2": "brāhmaṇo Yenasavhayo / ",
  "tha-ap66:5.3": "buddhaseṭṭhaṃ thavitvāna ",
  "tha-ap66:5.4": "Siddhattham aparājitaṃ. // // ",
  "tha-ap66:6.1": "Catunavutikappānaṃ ",
  "tha-ap66:6.2": "duggatiṃ nūpapajj' aham / ",
  "tha-ap66:6.3": "sugatīsu susampattiṃ ",
  "tha-ap66:6.4": "anubhosiṃ anappakaṃ. // // Catunavute ",
  "tha-ap66:7.1": "ito kappe ",
  "tha-ap66:7.2": "thavitvā lokanāyakaṃ / ",
  "tha-ap66:7.3": "duggatiṃ nābhijānāmi ",
  "tha-ap66:7.4": "thomanāya idaṃ phalaṃ. // // ",
  "tha-ap66:8.1": "Catuddasamhi kappamhi ",
  "tha-ap66:8.2": "caturo āsuṃ Uggatā / ",
  "tha-ap66:8.3": "sattaratanasampannā ",
  "tha-ap66:8.4": "cakkavattī mahabbalā. // // ",
  "tha-ap66:9.1": "Paṭisambhidā catasso ",
  "tha-ap66:9.2": "vimokhā pi ca aṭṭh' ime / chaḷabhiññā sacchikatā ",
  "tha-ap66:9.3": "kataṃ Buddhassa sāsanan ti. // // ",
  "tha-ap66:10.1": "Itthaṃ sudaṃ āyasmā Parappasādako thero imā gāthāyo abhāsitthā ti. Parappasādakatherassa apadānaṃ samattaṃ. ",
  "tha-ap66:11.1": ""
}
