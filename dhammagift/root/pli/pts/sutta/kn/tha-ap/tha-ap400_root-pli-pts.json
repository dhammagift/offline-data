  "tha-ap400:1.1": "Nibbute Kakusandhamhi ",
  "tha-ap400:1.2": "brāhmaṇamhi vusīmati / ",
  "tha-ap400:1.3": "gahetvā salaḷaṃ mālaṃ ",
  "tha-ap400:1.4": "maṇḍapaṃ kārayim ahaṃ. // // ",
  "tha-ap400:2.1": "Tāvatiṃsagato santo ",
  "tha-ap400:2.2": "labhāmi vyamham uttamaṃ / ",
  "tha-ap400:2.3": "aññe deve 'tirocāmi ",
  "tha-ap400:2.4": "puññakammass' idaṃ phalaṃ. // // ",
  "tha-ap400:3.1": "Divā vā yadi vā rattiṃ ",
  "tha-ap400:3.2": "caṅkamanto ṭhito c'ahaṃ / ",
  "tha-ap400:3.3": "channo salaḷapupphehi ",
  "tha-ap400:3.4": "puññakammass' idaṃ phalaṃ. // // ",
  "tha-ap400:4.1": "Imasmiṃ yeva kappamhi ",
  "tha-ap400:4.2": "yaṃ Buddham abhipūjayiṃ / ",
  "tha-ap400:4.3": "duggatiṃ nābhijānāmi ",
  "tha-ap400:4.4": "Buddhapūjāy' idaṃ phalaṃ. // // ",
  "tha-ap400:5.1": "Kilesā . . . ",
  "tha-ap400:5.2": "pe . . . ",
  "tha-ap400:5.3": "",
  "tha-ap400:6.1": "",
  "tha-ap400:6.2": "pe . . . // // ",
  "tha-ap400:6.3": "Sāgataṃ . . . pe . . . pe . . . // // ",
  "tha-ap400:7.1": "Paṭisambhidā . . . ",
  "tha-ap400:7.2": "pe . . . ",
  "tha-ap400:7.3": "pe . . . // // ",
  "tha-ap400:8.1": "Itthaṃ sudam āyasmā Salaḷamaṇḍapiyo thero i. g. a-ti. / *Salaḷamaṇḍapiyattherassa apadānaṃ samattaṃ.* // // ",
  "tha-ap400:9.1": ""
}
