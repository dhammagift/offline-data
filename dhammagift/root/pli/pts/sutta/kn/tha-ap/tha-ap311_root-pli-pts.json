  "tha-ap311:0.3": "",
  "tha-ap311:1.1": "Udentaṃ sataraṃsīva vītaraṃsaṃ ",
  "tha-ap311:1.2": "va bhāṇumaṃ / ",
  "tha-ap311:1.3": "vanantaragataṃ santaṃ ",
  "tha-ap311:1.4": "lokajetthaṃ narāsabhaṃ // // ",
  "tha-ap311:2.1": "Addasaṃ supinantena ",
  "tha-ap311:2.2": "Siddhatthaṃ lokanāyakaṃ / ",
  "tha-ap311:2.3": "tattha cittaṃ pasādetvā ",
  "tha-ap311:2.4": "sugatim upapajj' ahaṃ. // // Catunavute ",
  "tha-ap311:3.1": "ito kappe ",
  "tha-ap311:3.2": "yaṃ saññam alabhiṃ tadā / ",
  "tha-ap311:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap311:3.4": "Buddhasaññāy' idaṃ phalaṃ. // // ",
  "tha-ap311:4.1": "Paṭisambhidā . . . ",
  "tha-ap311:4.2": "pe . . . ",
  "tha-ap311:4.3": "pe . . . // // ",
  "tha-ap311:5.1": "Itthaṃ sudam āyasmā Buddhasaññako thero i. g. a-ti. Buddhasaññakattherassa ",
  "tha-ap311:6.1": "apadānaṃ samattaṃ. "
}
