  "tha-ap96:0.1": "",
  "tha-ap96:0.2": "",
  "tha-ap96:0.3": "",
  "tha-ap96:1.1": "pure āsiṃ ",
  "tha-ap96:1.2": "Bandhumāyaṃ puruttame / ",
  "tha-ap96:1.3": "sūcidānaṃ mayā dinnaṃ ",
  "tha-ap96:1.4": "Vipassissa mahesino. // // ",
  "tha-ap96:2.1": "Vajiraggasamañ ñāṇaṃ ",
  "tha-ap96:2.2": "hoti kammena tādisaṃ / ",
  "tha-ap96:2.3": "virāgo 'mhi vimutto 'mhi ",
  "tha-ap96:2.4": "*patto 'mhi* āsavakkhayaṃ. // // ",
  "tha-ap96:3.1": "Atīte ca bhave sabbe ",
  "tha-ap96:3.2": "vattamāne c' anāgate / ",
  "tha-ap96:3.3": "ñāṇena viciniṃ sabbaṃ ",
  "tha-ap96:3.4": "sūcidānass' idaṃ phalaṃ. // // ",
  "tha-ap96:4.1": "Ekanavut' ito kappe ",
  "tha-ap96:4.2": "sattāsuṃ Vajirasamā / ",
  "tha-ap96:4.3": "sattaratanasampannā ",
  "tha-ap96:4.4": "cakkavattī mahābalā. // // ",
  "tha-ap96:5.1": "Paṭisambhidā catasso ",
  "tha-ap96:5.2": "vimokhā pi ca aṭṭh' ime / chaḍabhiññā sacchikatā ",
  "tha-ap96:5.3": "kataṃ Buddhassa sāsanan ti. // // ",
  "tha-ap96:6.1": "Itthaṃ sudaṃ āyasmā Sucidāyako thero imā gāthāyo abhāsitthā ti. Sucidāyakattherassa apadānaṃ samattaṃ. ",
  "tha-ap96:7.1": ""
}
