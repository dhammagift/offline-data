  "tha-ap39:0.3": "",
  "tha-ap39:1.1": "",
  "tha-ap39:1.2": "tāpaso ās' ahaṃ tadā / ",
  "tha-ap39:1.3": "lasuṇaṃ upajivāmi ",
  "tha-ap39:1.4": "lasuṇaṃ mayhaṃ bhojanaṃ. // // ",
  "tha-ap39:2.1": "Khāriyo pūrayitvāna ",
  "tha-ap39:2.2": "saṅghārāmaṃ agañch' ahaṃ / ",
  "tha-ap39:2.3": "haṭṭho haṭṭhena cittena ",
  "tha-ap39:2.4": "saṅghassa lasuṇaṃ adaṃ. // // ",
  "tha-ap39:3.1": "Vipassissa naraggassa ",
  "tha-ap39:3.2": "sāsane niratass' ahaṃ / ",
  "tha-ap39:3.3": "saṅghassa lasuṇaṃ datvā ",
  "tha-ap39:3.4": "kappaṃ saggamhi mod' ahaṃ. // // Ekanavute ",
  "tha-ap39:4.1": "ito kappe ",
  "tha-ap39:4.2": "lasuṇaṃ yam adan tadā / ",
  "tha-ap39:4.3": "duggatiṃ nābhijānāmi ",
  "tha-ap39:4.4": "lasuṇānaṃ idaṃ phalaṃ. // // ",
  "tha-ap39:5.1": "Paṭisambhidā catasso ",
  "tha-ap39:5.2": "vimokhā pi ca aṭṭh' ime / chaḍabhiññā sacchikatā ",
  "tha-ap39:5.3": "kataṃ Buddhassa sāsanan ti. // // ",
  "tha-ap39:6.1": "Itthaṃ sudaṃ āyasmā Lasuṇadāyako thero imā gāthāyo abhāsitthā ti. Lasuṇadāyakattherassa apadānaṃ samattaṃ. ",
  "tha-ap39:7.1": ""
}
