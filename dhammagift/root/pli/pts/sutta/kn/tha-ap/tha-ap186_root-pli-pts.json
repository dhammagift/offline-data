  "tha-ap186:0.3": "",
  "tha-ap186:1.1": "Tisso nāmāsi bhagavā ",
  "tha-ap186:1.2": "lokajeṭṭho narāsabho / ",
  "tha-ap186:1.3": "purakkhato sāvakehi ",
  "tha-ap186:1.4": "rathiyaṃ paṭipajjatha. // // ",
  "tha-ap186:2.1": "Pañcauppalahatthā ca ",
  "tha-ap186:2.2": "catur' oṭṭhapitā mayā / ",
  "tha-ap186:2.3": "āhutiṃ dātukāmo 'haṃ mūgo ",
  "tha-ap186:2.4": "'mhi vata siddhiyā. // // ",
  "tha-ap186:3.1": "Suvaṇṇavaṇṇaṃ sambuddhaṃ ",
  "tha-ap186:3.2": "gacchantam antarāpaṇe / ",
  "tha-ap186:3.3": "Buddharaṃsābhighuṭṭho 'mhi ",
  "tha-ap186:3.4": "pūjesiṃ dipaduttamaṃ // // ",
  "tha-ap186:4.1": "Dvenavute ito kappe ",
  "tha-ap186:4.2": "yaṃ puppham abhiropayiṃ / ",
  "tha-ap186:4.3": "duggatiṃ nābhijānāmi ",
  "tha-ap186:4.4": "Buddhapūjāy' idaṃ phalaṃ. // // ",
  "tha-ap186:5.1": "Ito terasakappamhi ",
  "tha-ap186:5.2": "pañc' āsu Sabhāsammatā / ",
  "tha-ap186:5.3": "sattaratanasampannā ",
  "tha-ap186:5.4": "cakkavattī mahabbalā. // // ",
  "tha-ap186:6.1": "Paṭisambhidā . . . ",
  "tha-ap186:6.2": "pe . . . ",
  "tha-ap186:6.3": "pe . . . // // ",
  "tha-ap186:7.1": "Itthaṃ sudaṃ āyasmā Pañcahatthiyo thero i. g. a-ti. Pañcahatthiyattherassa apadānaṃ samattaṃ. ",
  "tha-ap186:8.1": ""
}
