  "tha-ap239:1.1": "Migaluddo pure āsiṃ ",
  "tha-ap239:1.2": "araññe kānane ahaṃ / ",
  "tha-ap239:1.3": "piyālaṃ pupphitaṃ disvā ",
  "tha-ap239:1.4": "gatamagge khipim ahaṃ. // // ",
  "tha-ap239:2.1": "Ekanavute ito kappe ",
  "tha-ap239:2.2": "yaṃ puppham abhipūjayiṃ / ",
  "tha-ap239:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap239:2.4": "Buddhapūjāy' idaṃ phalaṃ. // // ",
  "tha-ap239:3.1": "Paṭisambhidā . . . ",
  "tha-ap239:3.2": "pe . . . ",
  "tha-ap239:3.3": "pe . . . // // ",
  "tha-ap239:4.1": "Itthaṃ sudam ayasmā Piyālapupphiyo thero i. g. a-ti. Piyālapupphiyattherassa apadānaṃ samattaṃ. ",
  "tha-ap239:5.1": ""
}
