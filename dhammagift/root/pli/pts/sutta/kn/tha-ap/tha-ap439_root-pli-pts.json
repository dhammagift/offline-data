  "tha-ap439:1.1": "Bu*ddhaṃ disvāna ",
  "tha-ap439:1.2": "sa*yambhuṃ aparājitaṃ / ",
  "tha-ap439:1.3": "ambāṭakaṃ gahetvāna ",
  "tha-ap439:1.4": "sayambhussa adās' ahaṃ. // // ",
  "tha-ap439:2.1": "Ekatiṃse ito kappe ",
  "tha-ap439:2.2": "yaṃ phalaṃ adadiṃ tadā / ",
  "tha-ap439:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap439:2.4": "phaladānass' idaṃ phalaṃ. // // ",
  "tha-ap439:3.1": "Kilesā . . . ",
  "tha-ap439:3.2": "pe . . . ",
  "tha-ap439:3.3": "",
  "tha-ap439:4.1": "",
  "tha-ap439:4.2": "pe . . . ",
  "tha-ap439:4.3": "pe . . . // // Sāgataṃ . . . pe . . . pe . . . pe . . . // // ",
  "tha-ap439:5.1": "Paṭisambhidā . . . ",
  "tha-ap439:5.2": "pe . . . ",
  "tha-ap439:5.3": "pe . . . pe . . . // // ",
  "tha-ap439:6.1": "Itthaṃ sudaṃ āyasmā Ambāṭako thero i. g. a-ti. Ambāṭakadāyakattherassa ",
  "tha-ap439:7.1": "apadānaṃ samattaṃ. "
}
