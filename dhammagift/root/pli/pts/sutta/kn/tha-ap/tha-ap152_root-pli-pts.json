  "tha-ap152:1.1": "Sumedhassa bhagavato ",
  "tha-ap152:1.2": "lokajeṭṭhassa tādino / ",
  "tha-ap152:1.3": "pallaṅko hi mayā dinno ",
  "tha-ap152:1.4": "sa-uttarasamacchado. // // ",
  "tha-ap152:2.1": "Sattaratanasampanno ",
  "tha-ap152:2.2": "pallaṅko āsi so tadā / ",
  "tha-ap152:2.3": "mama saṅkappam aññāya ",
  "tha-ap152:2.4": "nibbattati sadā mama. // // ",
  "tha-ap152:3.1": "Tiṃsakappasahassāni ",
  "tha-ap152:3.2": "pallaṅkam adadiṃ tadā / ",
  "tha-ap152:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap152:3.4": "pallaṅkassa idaṃ phalaṃ. // // ",
  "tha-ap152:4.1": "Vīsakappasahassamhi ",
  "tha-ap152:4.2": "Suvaṇṇābhā tayo janā / ",
  "tha-ap152:4.3": "sattaratanasampannā ",
  "tha-ap152:4.4": "cakkavattī mahābalā. // // ",
  "tha-ap152:5.1": "Paṭisambhidā . . . ",
  "tha-ap152:5.2": "pe . . . ",
  "tha-ap152:5.3": "pe . . . // // ",
  "tha-ap152:6.1": "Itthaṃ sudaṃ ā. Pallaṅkadāyako thero i. g. a- ti. Pallaṅkadāyakattherassa apadānaṃ samattaṃ. ",
  "tha-ap152:7.1": "",
  "tha-ap152:8.1": "",
  "tha-ap152:9.1": "Uddānaṃ: ",
  "tha-ap152:10.1": "Chatta-Thambho ca Vedī ca ",
  "tha-ap152:10.2": "Parivār'-Ummapupphiyo ",
  "tha-ap152:10.3": "Anuloma Maggadāyī ",
  "tha-ap152:10.4": "Phaladāyī-Vataṃsako ",
  "tha-ap152:10.5": "Pallaṅkadāyi gāthāyo ",
  "tha-ap152:10.6": "chappaññāsā pakittitā. Candaṃ va "
}
