  "tha-ap345:1.1": "Tisso nāma ahū satthā ",
  "tha-ap345:1.2": "lokajeṭṭho narāsabho / ",
  "tha-ap345:1.3": "*tayopadhikkha*yo disvā ",
  "tha-ap345:1.4": "dhajam āropitaṃ mayā. // // ",
  "tha-ap345:2.1": "Tena kammena sukatena ",
  "tha-ap345:2.2": "cetanāpaṇidhīhi ca / ",
  "tha-ap345:2.3": "jahitvā mānusaṃ dehaṃ ",
  "tha-ap345:2.4": "Tāvatiṃsam agacch' ahaṃ. // // ",
  "tha-ap345:3.1": "Satānaṃ tīṇikkhattuñ ca ",
  "tha-ap345:3.2": "devarājjam akārayiṃ / ",
  "tha-ap345:3.3": "satānaṃ pañcakkhattuñ ca ",
  "tha-ap345:3.4": "cakkavattī ahos' ahaṃ // // ",
  "tha-ap345:4.1": "Padesarajjaṃ vipulaṃ ",
  "tha-ap345:4.2": "gaṇanāto asaṅkhiyaṃ / ",
  "tha-ap345:4.3": "anubhomi sakaṃ kammaṃ ",
  "tha-ap345:4.4": "pubbe sukatam attano. // // ",
  "tha-ap345:5.1": "Dvenavute ito kappe ",
  "tha-ap345:5.2": "yaṃ kammam akariṃ tadā / ",
  "tha-ap345:5.3": "duggatiṃ nābhijānāmi ",
  "tha-ap345:5.4": "dhajadānass' idaṃ phalaṃ. // // ",
  "tha-ap345:6.1": "Icchamāno c' aham ajja ",
  "tha-ap345:6.2": "sakānanaṃ sapabbataṃ / ",
  "tha-ap345:6.3": "khomadussena chādeyyaṃ ",
  "tha-ap345:6.4": "tadā mayhaṃ kate phalaṃ. // // ",
  "tha-ap345:7.1": "Paṭisambhidā . . . ",
  "tha-ap345:7.2": "pe . . . ",
  "tha-ap345:7.3": "pe . . . // // ",
  "tha-ap345:8.1": "Itthaṃ sudam āyasmā Dhajadāyako thero i. g. a-ti. Dhajadāyakattherassa apadānaṃ samattaṃ. Himavantass' avidūre ",
  "tha-ap345:9.1": ""
}
