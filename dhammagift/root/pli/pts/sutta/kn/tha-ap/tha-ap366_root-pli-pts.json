  "tha-ap366:1.1": "Vijjādharo tadā āsiṃ ",
  "tha-ap366:1.2": "Himavantamhi pabbate / ",
  "tha-ap366:1.3": "addasaṃ virajaṃ Buddhaṃ ",
  "tha-ap366:1.4": "caṅkamantaṃ mahāyasaṃ. // // ",
  "tha-ap366:2.1": "Tīṇi kesarapupphāni ",
  "tha-ap366:2.2": "sīse katvān' ahaṃ tadā / ",
  "tha-ap366:2.3": "upasaṅkamma sambuddhaṃ ",
  "tha-ap366:2.4": "*Vessabhum abhi*pūjayiṃ. // // ",
  "tha-ap366:3.1": "Ekatiṃse ito kappe ",
  "tha-ap366:3.2": "yaṃ kammam akariṃ tadā / ",
  "tha-ap366:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap366:3.4": "Buddhapūjāy' idaṃ phalaṃ. // // ",
  "tha-ap366:4.1": "Paṭisambhidā . . . ",
  "tha-ap366:4.2": "pe . . . ",
  "tha-ap366:4.3": "pe . . . // // ",
  "tha-ap366:5.1": "Itthaṃ sudam āyasmā Kesarapupphiyo th. i. g. a-ti. Kesarapupphiyattherassa ",
  "tha-ap366:6.1": "apadānaṃ samattaṃ. "
}
