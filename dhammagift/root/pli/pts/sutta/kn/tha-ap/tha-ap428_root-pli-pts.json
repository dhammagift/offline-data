  "tha-ap428:0.3": "",
  "tha-ap428:1.1": "Sucintitaṃ bhagavantaṃ ",
  "tha-ap428:1.2": "lokajeṭṭhaṃ narāsabhaṃ / ",
  "tha-ap428:1.3": "upaviṭṭhaṃ mahāraññaṃ ",
  "tha-ap428:1.4": "vātābādhena pīḷitaṃ / ",
  "tha-ap428:2.1": "disvā cittaṃ pasādetvā ",
  "tha-ap428:2.2": "ghatamaṇḍaṃ upānayiṃ. // // ",
  "tha-ap428:2.3": "Katattā ācitattā ca ",
  "tha-ap428:2.4": "GaṅgāBhāgīrasī 'va 'yaṃ / ",
  "tha-ap428:3.1": "mahāsamuddā cattāro ",
  "tha-ap428:3.2": "ghataṃ sampajjare mama. // // ",
  "tha-ap428:3.3": "Ayañ ca paṭhavī ghorā ",
  "tha-ap428:3.4": "appamāṇā asaṅkhiyā / ",
  "tha-ap428:4.1": "mama saṅkappam aññāya ",
  "tha-ap428:4.2": "bhavate madhusakkarā. // // ",
  "tha-ap428:4.3": "Cātuddīpā ime rukkhā ",
  "tha-ap428:4.4": "pādapā dharaṇīruhā / ",
  "tha-ap428:5.1": "mama saṅkappam aññāya ",
  "tha-ap428:5.2": "kapparukkhā bhavanti te. // // ",
  "tha-ap428:5.3": "Paññāsakkhattuṃ devindo ",
  "tha-ap428:5.4": "devarajjam akārayiṃ / ",
  "tha-ap428:6.1": "ekapaññāsakkhattuñ ca ",
  "tha-ap428:6.2": "cakkavatti ahos' ahaṃ / ",
  "tha-ap428:6.3": "padesarajjaṃ vipulaṃ ",
  "tha-ap428:6.4": "gaṇanāto asaṅkhiyaṃ. // // ",
  "tha-ap428:7.1": "Catunavute ito kappe ",
  "tha-ap428:7.2": "yaṃ dānam adadiṃ tadā / ",
  "tha-ap428:7.3": "duggatiṃ nābhijānāmi ",
  "tha-ap428:7.4": "ghatamaṇḍass' idaṃ phalaṃ. // // ",
  "tha-ap428:8.1": "Kilesā . . . ",
  "tha-ap428:8.2": "pe . . . ",
  "tha-ap428:8.3": "",
  "tha-ap428:9.1": "",
  "tha-ap428:9.2": "pe . . . ",
  "tha-ap428:9.3": "pe . . . // // Sāgataṃ . . . pe . . . pe . . . pe . . . // // ",
  "tha-ap428:10.1": "Paṭisambhidā . . . ",
  "tha-ap428:10.2": "pe . . . ",
  "tha-ap428:10.3": "pe . . . pe . . . // // ",
  "tha-ap428:11.1": "Itthaṃ sudam āyasmā Ghatamaṇḍadāyako th. i. g. a-ti. Ghatamaṇḍadāyakattherassa apadānaṃ samattaṃ. ",
  "tha-ap428:12.1": ""
}
