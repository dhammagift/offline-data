  "tha-ap19:0.1": "",
  "tha-ap19:0.2": "",
  "tha-ap19:0.3": "",
  "tha-ap19:1.1": "Padumuttaraṃ bhagavantaṃ ",
  "tha-ap19:1.2": "lokajeṭṭhaṃ narāsabhaṃ / ",
  "tha-ap19:1.3": "pabbhāramhi nisinnaṃ taṃ ",
  "tha-ap19:1.4": "upagañchiṃ naruttamaṃ. // // ",
  "tha-ap19:2.1": "Kaṇikā*raṃ pupphitaṃ disvā ",
  "tha-ap19:2.2": "vaṇṭaṃ chetvān' ahaṃ tadā / ",
  "tha-ap19:2.3": "alaṅkaritvā chattamhi ",
  "tha-ap19:2.4": "Buddhassa abhiropayiṃ. // // ",
  "tha-ap19:3.1": "Piṇḍapātañ ca pādāsiṃ ",
  "tha-ap19:3.2": "paramannaṃ subhojanaṃ / ",
  "tha-ap19:3.3": "Buddhena navame tattha ",
  "tha-ap19:3.4": "samaṇe aṭṭha bhojayiṃ. // // ",
  "tha-ap19:4.1": "Anumodi mahāvīro ",
  "tha-ap19:4.2": "sayambhū aggapuggalo: / ",
  "tha-ap19:4.3": "*\"Iminā chattadā*nena ",
  "tha-ap19:4.4": "paramannappavecchanā. // // ",
  "tha-ap19:5.1": "Tena cittappasādena ",
  "tha-ap19:5.2": "sampattim anubhossati / ",
  "tha-ap19:5.3": "tiṃsakhattun ca devindo ",
  "tha-ap19:5.4": "devarajjaṃ karissati. // // ",
  "tha-ap19:6.1": "Ekavīsatikhattuñ ca ",
  "tha-ap19:6.2": "cakkavatti bhavissati / ",
  "tha-ap19:6.3": "padesarajjaṃ vipulaṃ ",
  "tha-ap19:6.4": "gaṇanāto asaṅkhiyaṃ // // ",
  "tha-ap19:7.1": "Yaṃ vadanti Sumedho ti bhūripaññaṃ sumedhasaṃ / kappe ",
  "tha-ap19:7.2": "'to ",
  "tha-ap19:7.3": "satasahasse eso ",
  "tha-ap19:7.4": "Buddho bhavissati. // // ",
  "tha-ap19:8.1": "Sāsane dippamānamhi ",
  "tha-ap19:8.2": "manussattaṃ gamissati / ",
  "tha-ap19:8.3": "",
  "tha-ap19:8.4": "",
  "tha-ap19:9.1": "Upaseno ti nāmena ",
  "tha-ap19:9.2": "hessati satthu sāvako\". // // ",
  "tha-ap19:9.3": "",
  "tha-ap19:9.4": "",
  "tha-ap19:10.1": "Carimaṃ vat*tate mayhaṃ ",
  "tha-ap19:10.2": "bhavā sabbe sa*mūhatā / ",
  "tha-ap19:10.3": "dhāremi antimam dehaṃ ",
  "tha-ap19:10.4": "jetvā Māraṃ savāhanaṃ. // // ",
  "tha-ap19:11.1": "Paṭisambhidā catasso ",
  "tha-ap19:11.2": "vimokhā pi ca aṭṭh' ime / ",
  "tha-ap19:11.3": "chaḍabhiññā sacchikatā ",
  "tha-ap19:11.4": "kataṃ Buddhassa sāsanan ti. // // ",
  "tha-ap19:12.1": "Itthaṃ sudaṃ āyasmā Upaseno Vaṅgantaputto thero imā gāthāyo abhāsitthā ti. Upasenavaṅgantaputtatherassa apadānaṃ samattaṃ. Tatiyaṃ ",
  "tha-ap19:13.1": "",
  "tha-ap19:13.2": "bhāṇavāraṃ niṭṭhitaṃ. "
}
