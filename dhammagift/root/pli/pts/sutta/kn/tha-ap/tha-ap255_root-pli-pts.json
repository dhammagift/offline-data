  "tha-ap255:1.1": "Ānando nāma sambuddho ",
  "tha-ap255:1.2": "sayambhū aparājito / ",
  "tha-ap255:1.3": "araññe parinibbāyi ",
  "tha-ap255:1.4": "amanussamhi kānane. // // ",
  "tha-ap255:2.1": "Devalokā idhāgantvā ",
  "tha-ap255:2.2": "citaṃ katvān' ahaṃ tadā / ",
  "tha-ap255:2.3": "sarīraṃ tattha *jhāpesiṃ ",
  "tha-ap255:2.4": "sakkārañ ca akās' ahaṃ.* // // Ekanavute ",
  "tha-ap255:3.1": "ito kappe ",
  "tha-ap255:3.2": "yaṃ kammam akariṃ tadā / ",
  "tha-ap255:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap255:3.4": "Buddhapūjāy' idaṃ phalaṃ. // // ",
  "tha-ap255:4.1": "Paṭisambhidā . . . ",
  "tha-ap255:4.2": "pe . . . ",
  "tha-ap255:4.3": "pe . . . // // ",
  "tha-ap255:5.1": "Itthaṃ sudam āyasmā Citakapūjako thero i. g. a-ti. Citakapūjakattherassa apadānaṃ samattaṃ. Himavantass' avidūre ",
  "tha-ap255:6.1": ""
}
