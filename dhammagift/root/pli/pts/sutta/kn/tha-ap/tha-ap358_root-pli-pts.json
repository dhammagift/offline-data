  "tha-ap358:1.1": "Sataraṃsi nāma sambuddho ",
  "tha-ap358:1.2": "sayambhū aparājito / ",
  "tha-ap358:1.3": "vuṭṭhahitvā samādhimhā ",
  "tha-ap358:1.4": "bhikkhāya mam upāgami. // // ",
  "tha-ap358:2.1": "Paccekabuddhaṃ disvāna ",
  "tha-ap358:2.2": "ambayāgum adāpayiṃ / ",
  "tha-ap358:2.3": "vippasanna*manan tassa ",
  "tha-ap358:2.4": "vippasannena cetasā.* // // ",
  "tha-ap358:3.1": "Catunavute ito kappe ",
  "tha-ap358:3.2": "yaṃ kammam akariṃ tadā / ",
  "tha-ap358:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap358:3.4": "ambayāguy' idaṃ phalaṃ. // // ",
  "tha-ap358:4.1": "Paṭisambhidā . . . ",
  "tha-ap358:4.2": "pe . . . ",
  "tha-ap358:4.3": "pe . . . // // ",
  "tha-ap358:5.1": "Itthaṃ sudam āyasmā Ambayāgudāyako thero i. g. a-ti. Ambayāgudāyakattherassa apadānaṃ samattaṃ. ",
  "tha-ap358:6.1": ""
}
