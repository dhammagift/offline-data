  "tha-ap160:0.3": "",
  "tha-ap160:1.1": "Suvaccho nāma nāmena ",
  "tha-ap160:1.2": "brāhmaṇo mantapāragū / ",
  "tha-ap160:1.3": "purakkhato sasissehi ",
  "tha-ap160:1.4": "vasati pabbatantare. // // ",
  "tha-ap160:2.1": "Padumuttaro nāma jino ",
  "tha-ap160:2.2": "āhutīṇaṃ paṭiggaho / ",
  "tha-ap160:2.3": "mam uddharitukāmo so ",
  "tha-ap160:2.4": "āgacchi mama santike. // // ",
  "tha-ap160:3.1": "Vehāyase caṅkamati ",
  "tha-ap160:3.2": "dhūpo 'tijalate tathā / ve ",
  "tha-ap160:3.3": "hāsaṃ mama disvāna ",
  "tha-ap160:3.4": "pakkāmi pācināmukho // // ",
  "tha-ap160:4.1": "Tañ ca acchariyaṃ disvā ",
  "tha-ap160:4.2": "abbhūtaṃ lomahaṃsanaṃ / ",
  "tha-ap160:4.3": "nāgapupphaṃ gahetvāna ",
  "tha-ap160:4.4": "gatamaggamhi okiriṃ // // ",
  "tha-ap160:5.1": "Satasahasse ito kappe ",
  "tha-ap160:5.2": "yaṃ puppham abhiropayiṃ / ",
  "tha-ap160:5.3": "tena cittappasādena ",
  "tha-ap160:5.4": "duggatiṃ nūpapajj' ahaṃ. // // ",
  "tha-ap160:6.1": "Ekatiṃse kappasate ",
  "tha-ap160:6.2": "rājā āsiṃ Mahāratho. / ",
  "tha-ap160:6.3": "sattaratanasampanno ",
  "tha-ap160:6.4": "cakkavattī mahabbalo. // // ",
  "tha-ap160:7.1": "Paṭisambhidā . . . ",
  "tha-ap160:7.2": "pe . . . ",
  "tha-ap160:7.3": "pe . . . // // ",
  "tha-ap160:8.1": "Itthaṃ sudaṃ ā. Nāgapupphiyo thero i. g. ā-ti. Nāgapupphiyattherassa apadānaṃ samattaṃ. ",
  "tha-ap160:9.1": ""
}
