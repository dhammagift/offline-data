  "tha-ap474:1.1": "Padumuttaro nāma jino ",
  "tha-ap474:1.2": "sabbadhammāna pāragū / ",
  "tha-ap474:1.3": "vivekakāmo sambuddho ",
  "tha-ap474:1.4": "gacchate anilañjase. // // ",
  "tha-ap474:2.1": "Avidūre Himavato ",
  "tha-ap474:2.2": "mahājātassaro ahū / ",
  "tha-ap474:2.3": "tattha me bhavanaṃ āsi ",
  "tha-ap474:2.4": "puññakammena *saṃ*yutaṃ. // // ",
  "tha-ap474:3.1": "Bhavanā abhinikkhamma ",
  "tha-ap474:3.2": "addasaṃ lokanāsanaṃ / ",
  "tha-ap474:3.3": "indīvaraṃ va jalitam ",
  "tha-ap474:3.4": "ādittaṃ va hutāsanaṃ. // // ",
  "tha-ap474:4.1": "Vicinaṃ nāddasaṃ pupphaṃ ",
  "tha-ap474:4.2": "pūjayissan ti nāyakaṃ / ",
  "tha-ap474:4.3": "Sakaṃ cittaṃ pasādetvā ",
  "tha-ap474:4.4": "avandiṃ satthuno ahaṃ. // // ",
  "tha-ap474:5.1": "Mama sīse maṇiṃ gayha ",
  "tha-ap474:5.2": "pūjayiṃ lokanāyakaṃ / ",
  "tha-ap474:5.3": "imāya maṇipūjāya ",
  "tha-ap474:5.4": "vipāko *hotu bhadda*ko. // // ",
  "tha-ap474:6.1": "Padumuttaro lokavidū ",
  "tha-ap474:6.2": "āhutīnaṃ paṭiggaho / ",
  "tha-ap474:6.3": "antalikkhe ṭhito satthā ",
  "tha-ap474:6.4": "imā gāthā abhāsatha: // // ",
  "tha-ap474:7.1": "‘So te ijjhatu saṅkappo ",
  "tha-ap474:7.2": "labhassu vipulaṃ sukhaṃ / ",
  "tha-ap474:7.3": "imāya maṇipūjāya ",
  "tha-ap474:7.4": "anubhohi mahāyasaṃ.' // // ",
  "tha-ap474:8.1": "Idaṃ *vatvāna* bhagavā ",
  "tha-ap474:8.2": "jalajuttamanāmako / ",
  "tha-ap474:8.3": "agamāsi Buddhaseṭṭho ",
  "tha-ap474:8.4": "yattha cittaṃ paṇīhitaṃ. // // ",
  "tha-ap474:9.1": "Saṭṭhikappāni devindo ",
  "tha-ap474:9.2": "devarajjam akārayiṃ / ",
  "tha-ap474:9.3": "anekasatakkhattuñ ca ",
  "tha-ap474:9.4": "cakkavatti ahos' ahaṃ. // // ",
  "tha-ap474:10.1": "Pubbakammaṃ sarantassa ",
  "tha-ap474:10.2": "devabhūtassa me sato / ",
  "tha-ap474:10.3": "maṇi nibbattate mayhaṃ ",
  "tha-ap474:10.4": "ālokakaraṇo mama. // // ",
  "tha-ap474:11.1": "Chalāsītisahassāni ",
  "tha-ap474:11.2": "nariyo me pariggahā / ",
  "tha-ap474:11.3": "vicittavatthābharaṇā ",
  "tha-ap474:11.4": "āmuttamaṇikuṇḍalā // // ",
  "tha-ap474:12.1": "Aḷārapamhā hasulā ",
  "tha-ap474:12.2": "susoññā tanumajjhimā / ",
  "tha-ap474:12.3": "parivārenti maṃ niccaṃ ",
  "tha-ap474:12.4": "maṇipūjāy' idaṃ phalaṃ. // // ",
  "tha-ap474:13.1": "Sovaṇṇamayā maṇimayā ",
  "tha-ap474:13.2": "lohitaṅkamayā tathā / ",
  "tha-ap474:13.3": "bhaṇḍā katākatā bhonti yadicchāya ",
  "tha-ap474:13.4": "pilandhanā. // // ",
  "tha-ap474:14.1": "Kūṭāgārā guhā rammā ",
  "tha-ap474:14.2": "sayanañ ca mahārahaṃ / ",
  "tha-ap474:14.3": "mama saṅkappam aññāya ",
  "tha-ap474:14.4": "nibbattanti yadicchakaṃ. // // ",
  "tha-ap474:15.1": "Lābhā tesaṃ suladdhaṃ va ",
  "tha-ap474:15.2": "ye labhanti upassutiṃ / ",
  "tha-ap474:15.3": "puññakkhettaṃ manussānam ",
  "tha-ap474:15.4": "osadhaṃ sabbapāṇinaṃ. // // ",
  "tha-ap474:16.1": "Mayham pi sukataṃ kammaṃ ",
  "tha-ap474:16.2": "yo 'haṃ addakkhi nāyakaṃ / ",
  "tha-ap474:16.3": "vinipātā pamutto 'mhi patto ",
  "tha-ap474:16.4": "ca acalaṃ padaṃ. // // ",
  "tha-ap474:17.1": "Yaṃ yaṃ yonūpapajjāmi ",
  "tha-ap474:17.2": "devattaṃ atha mānusaṃ / ",
  "tha-ap474:17.3": "samantā sattaratanā ",
  "tha-ap474:17.4": "āloko hoti me sadā. // // ",
  "tha-ap474:18.1": "Tāy' eva maṇipūjāya ",
  "tha-ap474:18.2": "anubhotvāna sampadā / ",
  "tha-ap474:18.3": "ñāṇāloko mayā diṭṭho ",
  "tha-ap474:18.4": "patto 'mhi acalaṃ padaṃ. // // ",
  "tha-ap474:19.1": "Satasahasse ito kappe ",
  "tha-ap474:19.2": "yaṃ maṇim abhipūjayuṃ / ",
  "tha-ap474:19.3": "duggatiṃ nābhijānāmi ",
  "tha-ap474:19.4": "maṇipūjāy' idaṃ phalaṃ. // // ",
  "tha-ap474:20.1": "Kilesā . . . ",
  "tha-ap474:20.2": "pe . . . ",
  "tha-ap474:20.3": "",
  "tha-ap474:21.1": "",
  "tha-ap474:21.2": "pe . . . ",
  "tha-ap474:21.3": "pe . . . // // Sāgataṃ . . . pe . . . pe . . . pe . . . // // ",
  "tha-ap474:22.1": "Paṭisambhidā . . . ",
  "tha-ap474:22.2": "pe . . . ",
  "tha-ap474:22.3": "pe . . . pe . . . // // ",
  "tha-ap474:23.1": "Itthaṃ sudam āyasmā Maṇipūjako thero i. g. a-ti. Maṇipūjakattherassa apadānaṃ samattaṃ. Kosiko ",
  "tha-ap474:24.1": ""
}
