  "tha-ap141:0.1": "",
  "tha-ap141:0.2": "",
  "tha-ap141:0.3": "",
  "tha-ap141:1.1": "Migarājā tadā āsiṃ ",
  "tha-ap141:1.2": "abhijāto va kesarī / ",
  "tha-ap141:1.3": "giriduggaṃ gavesanto ",
  "tha-ap141:1.4": "addasaṃ lokanāyakaṃ. // // ",
  "tha-ap141:2.1": "‘Ayaṃ nu kho mahāvīro ",
  "tha-ap141:2.2": "nibbāpeti mahājanaṃ / ",
  "tha-ap141:2.3": "yannūnāhaṃ upāseyyaṃ ",
  "tha-ap141:2.4": "devadevaṃ narāsabhaṃ!' // // ",
  "tha-ap141:3.1": "Sākhaṃ sālassa bhañjitvā ",
  "tha-ap141:3.2": "sakoṭaṃ puppham āhariṃ / ",
  "tha-ap141:3.3": "upagantvāna sambuddhaṃ ",
  "tha-ap141:3.4": "adāsiṃ puppham uttamaṃ. // // Ekanavute ",
  "tha-ap141:4.1": "ito kappe ",
  "tha-ap141:4.2": "yaṃ puppham abhiropayiṃ / ",
  "tha-ap141:4.3": "duggatiṃ nābhijānāmi ",
  "tha-ap141:4.4": "pupphadānass' idaṃ phalaṃ. // // ",
  "tha-ap141:5.1": "Ito ca navame kappe ",
  "tha-ap141:5.2": "Virocana-sanāmakā / ",
  "tha-ap141:5.3": "tayo āsiṃsu rājāno ",
  "tha-ap141:5.4": "cakkavattī mahābalā. // // ",
  "tha-ap141:6.1": "Paṭisambhidā . . . ",
  "tha-ap141:6.2": "pe . . . ",
  "tha-ap141:6.3": "pe . . . // // ",
  "tha-ap141:7.1": "Itthaṃ sudaṃ āyasmā Sālapupphadāyako thero i. g. a-ti. Sālapupphadāyakattherassa apadānaṃ samattaṃ. Parodhako ",
  "tha-ap141:8.1": ""
}
