  "tha-ap313:0.3": "",
  "tha-ap313:1.1": "Dhammadassissa munino ",
  "tha-ap313:1.2": "vati kārāpitā mayā / ",
  "tha-ap313:1.3": "ārakkho ca mayā dinno ",
  "tha-ap313:1.4": "dipadindassa tādino. // // ",
  "tha-ap313:2.1": "Aṭṭhārase kappasate ",
  "tha-ap313:2.2": "yaṃ kammam akariṃ tadā / ",
  "tha-ap313:2.3": "tena kammāvasesena ",
  "tha-ap313:2.4": "patto me āsavakkhayo. // // ",
  "tha-ap313:3.1": "Paṭisambhidā . . . pe . . . ",
  "tha-ap313:3.2": "",
  "tha-ap313:3.3": "pe . . . // // ",
  "tha-ap313:3.4": "",
  "tha-ap313:4.1": "Itthaṃ sudam āyasmā Ārakkhadāyako thero i. g. a-ti. Ārakkhadāyakattherassa ",
  "tha-ap313:5.1": "apadānaṃ samattaṃ. "
}
