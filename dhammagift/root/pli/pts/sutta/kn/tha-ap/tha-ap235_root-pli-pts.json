  "tha-ap235:0.2": "",
  "tha-ap235:0.3": "",
  "tha-ap235:1.1": "Aruṇavatiyā nagare ",
  "tha-ap235:1.2": "ahosiṃ pūviko tadā / ",
  "tha-ap235:1.3": "mama dvārena gacchantaṃ ",
  "tha-ap235:1.4": "Sikhinaṃ addasaṃ jinaṃ. // // ",
  "tha-ap235:2.1": "Buddhassa patthaṃ paggayha ",
  "tha-ap235:2.2": "sālapupphaṃ adās' ahaṃ / ",
  "tha-ap235:2.3": "sammaggatassa Buddhassa ",
  "tha-ap235:2.4": "vippasannena cetasā. // // ",
  "tha-ap235:3.1": "Ekatiṃse ito kappe ",
  "tha-ap235:3.2": "yaṃ khajjam abhidās' ahaṃ / ",
  "tha-ap235:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap235:3.4": "sālapupphass' idaṃ phalaṃ. // // ",
  "tha-ap235:4.1": "Ito cuddasakappamhi ",
  "tha-ap235:4.2": "ahosiṃ Amitañjalo / ",
  "tha-ap235:4.3": "sattaratanasampanno ",
  "tha-ap235:4.4": "cakkavattī mahabbalo. // // ",
  "tha-ap235:5.1": "Paṭisambhidā . . . ",
  "tha-ap235:5.2": "pe . . . // // ",
  "tha-ap235:5.3": "",
  "tha-ap235:6.1": "Itthaṃ sudaṃ āyasmā Sālapupphiyo thero i. g. a-ti. Sālapupphiyattherassa ",
  "tha-ap235:7.1": "apadānaṃ samattaṃ. "
}
