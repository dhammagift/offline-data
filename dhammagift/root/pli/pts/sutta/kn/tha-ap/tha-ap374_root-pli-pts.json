  "tha-ap374:0.1": "",
  "tha-ap374:0.2": "",
  "tha-ap374:0.3": "",
  "tha-ap374:1.1": "*Vipassī nāma bhagavā* ",
  "tha-ap374:1.2": "sayambhū aggapuggalo / ",
  "tha-ap374:1.3": "purakkhato sasissehi Bandhumaṃ ",
  "tha-ap374:1.4": "pavisī jino. // // ",
  "tha-ap374:2.1": "Tīṇi pāṭalipupphāni ",
  "tha-ap374:2.2": "ucchaṅge ṭhapitāni me / ",
  "tha-ap374:2.3": "sīsaṃ nahāyitukāmo 'haṃ ",
  "tha-ap374:2.4": "nadītittham agacch' ahaṃ. // // ",
  "tha-ap374:3.1": "Nikkhamma Bandhumatiyā ",
  "tha-ap374:3.2": "addasaṃ lokanāyakaṃ / ",
  "tha-ap374:3.3": "indīvaraṃ va jalitam ",
  "tha-ap374:3.4": "ādittaṃ va hutāsanaṃ // // ",
  "tha-ap374:4.1": "Vyagghusabhaṃ va pavaram ",
  "tha-ap374:4.2": "abhijātaṃ va kesariṃ / ",
  "tha-ap374:4.3": "gacchantaṃ samaṇānaggaṃ ",
  "tha-ap374:4.4": "bhikkhusaṅghapurakkhataṃ. // // ",
  "tha-ap374:5.1": "Tasmiṃ pasanno sugate ",
  "tha-ap374:5.2": "kilesamaladhovane / ",
  "tha-ap374:5.3": "gahetvā tīṇipupphāni ",
  "tha-ap374:5.4": "buddhaseṭṭham apūjayiṃ. // // ",
  "tha-ap374:6.1": "Ekanavut' ito kappe ",
  "tha-ap374:6.2": "yaṃ puppham abhipūjayiṃ / ",
  "tha-ap374:6.3": "duggatiṃ nābhijānāmi ",
  "tha-ap374:6.4": "Buddhapūjāy' idaṃ phalaṃ. // // ",
  "tha-ap374:7.1": "Paṭisambhidā . . . ",
  "tha-ap374:7.2": "pe . . . ",
  "tha-ap374:7.3": "pe . . . // // ",
  "tha-ap374:8.1": "Itthaṃ sudam āyasmā Pāṭalipupphiyo th. i. g. a-ti. Pāṭalipupphiyattherassa ",
  "tha-ap374:9.1": "apadānaṃ samattaṃ. "
}
