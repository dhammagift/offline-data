  "tha-ap328:0.2": "",
  "tha-ap328:0.3": "",
  "tha-ap328:1.1": "Suvaṇṇavaṇṇaṃ sambuddhaṃ ",
  "tha-ap328:1.2": "gacchantam antarāpaṇe / ",
  "tha-ap328:1.3": "kañcanagghiyasaṅkāsaṃ ",
  "tha-ap328:1.4": "battiṃsavaralakkhaṇaṃ // // ",
  "tha-ap328:2.1": "Siddhatthaṃ sabbasiddhattham ",
  "tha-ap328:2.2": "anejam aparājitaṃ / ",
  "tha-ap328:2.3": "sambuddham atināmetvā ",
  "tha-ap328:2.4": "bhojayin taṃ mahamuniṃ. // // ",
  "tha-ap328:3.1": "Muni kāruṇiko loke ",
  "tha-ap328:3.2": "obhāsayi mamaṃ tadā / ",
  "tha-ap328:3.3": "Buddhe cittaṃ pasādetvā ",
  "tha-ap328:3.4": "kappaṃ saggamhi mod' ahaṃ. // // Catunavute ",
  "tha-ap328:4.1": "ito kappe ",
  "tha-ap328:4.2": "yaṃ dānam adadiṃ tadā / ",
  "tha-ap328:4.3": "duggatiṃ nābhijānāmi ",
  "tha-ap328:4.4": "bhikkhadānass' idaṃ phalaṃ. // // ",
  "tha-ap328:5.1": "Paṭisambhidā . . . ",
  "tha-ap328:5.2": "pe . . . ",
  "tha-ap328:5.3": "pe . . . // // ",
  "tha-ap328:6.1": "Itthaṃ sudam āyasmā Annasaṃsāvako thero i. g. a-ti. Annasaṃsāvakattherassa apadānaṃ samattaṃ. ",
  "tha-ap328:7.1": ""
}
