  "tha-ap238:1.1": "Nagare Aruṇavatiyā ",
  "tha-ap238:1.2": "vaṇṇakāro ahaṃ tadā / ",
  "tha-ap238:1.3": "cetiye dussabhaṇḍāni ",
  "tha-ap238:1.4": "nānāvaṇṇaṃ rajes' ahaṃ. // // ",
  "tha-ap238:2.1": "Ekatiṃse ito kappe ",
  "tha-ap238:2.2": "yaṃ vaṇṇaṃ rajayiṃ tadā / ",
  "tha-ap238:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap238:2.4": "vaṇṇadānass' idaṃ phalaṃ. // // ",
  "tha-ap238:3.1": "Ito tevīsatī kappe Candupama- ",
  "tha-ap238:3.2": "sanāmako / ",
  "tha-ap238:3.3": "sattaratanasampanno ",
  "tha-ap238:3.4": "cakkavattī mahabbalo. // // ",
  "tha-ap238:4.1": "Paṭisambhidā . . . ",
  "tha-ap238:4.2": "pe . . . ",
  "tha-ap238:4.3": "pe . . . // // ",
  "tha-ap238:5.1": "Itthaṃ sudam āyasmā Vaṇṇakārako thero i. g. a-ti. Vaṇṇakārakattherassa ",
  "tha-ap238:6.1": "apadānaṃ samattaṃ. "
}
