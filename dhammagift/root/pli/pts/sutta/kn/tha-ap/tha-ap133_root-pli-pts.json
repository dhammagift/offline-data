  "tha-ap133:0.1": "",
  "tha-ap133:0.2": "",
  "tha-ap133:0.3": "",
  "tha-ap133:1.1": "nāma jino ",
  "tha-ap133:1.2": "lokajeṭṭho narāsabho / ",
  "tha-ap133:1.3": "mahato janakāyassa ",
  "tha-ap133:1.4": "deseti amataṃ padaṃ. // // ",
  "tha-ap133:2.1": "Tassāhaṃ vacanaṃ sutvā ",
  "tha-ap133:2.2": "vācāsabhim udīritaṃ / ",
  "tha-ap133:2.3": "añjalim paggahetvāna ",
  "tha-ap133:2.4": "ekaggo ās' ahan tadā. // // ",
  "tha-ap133:3.1": "Yathā samuddo udadhīnam aggo / ",
  "tha-ap133:3.2": "Meru nagānaṃ pavaro siluccayo // // ",
  "tha-ap133:3.3": "tath' eva ye cittavasena vattare / ",
  "tha-ap133:3.4": "na Buddhañāṇassa kalan-upenti te. // // ",
  "tha-ap133:4.1": "Dhamme vidhiṃ ṭhapetvāna ",
  "tha-ap133:4.2": "Buddho kāruṇiko isi / ",
  "tha-ap133:4.3": "bhikkhusaṅghe nisīditvā ",
  "tha-ap133:4.4": "imā gāthā abhāsatha: // // ",
  "tha-ap133:5.1": "‘Yo so ñāṇaṃ pakittesi ",
  "tha-ap133:5.2": "Buddhamhi lokanāyake / ",
  "tha-ap133:5.3": "kappānaṃ satasahasse ",
  "tha-ap133:5.4": "duggatiṃ so na gacchati. // // ",
  "tha-ap133:6.1": "Kilese jhāpayitvāna ",
  "tha-ap133:6.2": "ekaggo susamāhito / ",
  "tha-ap133:6.3": "Sobhito nāma nāmena ",
  "tha-ap133:6.4": "hessati satthu sāvako.' // // ",
  "tha-ap133:7.1": "",
  "tha-ap133:7.2": "",
  "tha-ap133:7.3": "",
  "tha-ap133:7.4": "",
  "tha-ap133:8.1": "Kilesā jhāpitā mayhaṃ ",
  "tha-ap133:8.2": "bhavā sabbe samūhatā / ",
  "tha-ap133:8.3": "tisso vijjā anuppattā ",
  "tha-ap133:8.4": "kataṃ Buddhassa sāsanan ti. // // Paññāse kappasahasse satt' ev' āsuṃ Samuggatā / sattaratanasampannā cakkavattī mahābalā. // // ",
  "tha-ap133:9.1": "Paṭisambhidā . . . pe . . . ",
  "tha-ap133:9.2": "",
  "tha-ap133:9.3": "pe . . . // // ",
  "tha-ap133:9.4": "",
  "tha-ap133:10.1": "Itthaṃ sudaṃ āyasmā Sobhito thero imā gāthāyo abhāsitthā ti. Sobhitattherassa ",
  "tha-ap133:11.1": "apadānaṃ samattaṃ. Vitthatāya nadītīre pilakkhaphalino "
}
