  "tha-ap500:0.3": "",
  "tha-ap500:1.1": "",
  "tha-ap500:1.2": "nāma pabbato / ",
  "tha-ap500:1.3": "assamo sukato mayhaṃ ",
  "tha-ap500:1.4": "paṇṇasālā sumāpitā. // // ",
  "tha-ap500:2.1": "Nārado nāma nāmena ",
  "tha-ap500:2.2": "jaṭilo uggatāpano / ",
  "tha-ap500:2.3": "catuddasaṃ sahassānaṃ ",
  "tha-ap500:2.4": "sissā paricaranti maṃ. // // ",
  "tha-ap500:3.1": "Paṭisallīnako santo ",
  "tha-ap500:3.2": "evaṃ cintes' ahaṃ tadā: / ",
  "tha-ap500:3.3": "sabbajano maṃ pūjeti ",
  "tha-ap500:3.4": "nāhaṃ pūjemi kañcinaṃ. // // ",
  "tha-ap500:4.1": "Na me ovādako atthi ",
  "tha-ap500:4.2": "vattā koci na vijjati / ",
  "tha-ap500:4.3": "anācariyupajjhāyo ",
  "tha-ap500:4.4": "vane vāsaṃ upem' ahaṃ. // // ",
  "tha-ap500:5.1": "Upāsamāno yam ahaṃ ",
  "tha-ap500:5.2": "garucittaṃ upaṭṭhahe / ",
  "tha-ap500:5.3": "so me ācariyo n' atthi ",
  "tha-ap500:5.4": "vanavāso niratthako. // // ",
  "tha-ap500:6.1": "Āyāgam me gavesissaṃ ",
  "tha-ap500:6.2": "garubhāvaniyaṃ tatha / ",
  "tha-ap500:6.3": "sāvassayo vasissāmi ",
  "tha-ap500:6.4": "na koci garahissati. // // ",
  "tha-ap500:7.1": "Uttānakūlā nadikā ",
  "tha-ap500:7.2": "supatitthā manoramā / ",
  "tha-ap500:7.3": "susuddhapuḷinākiṇṇā ",
  "tha-ap500:7.4": "avidūre mam' assamaṃ. // // ",
  "tha-ap500:8.1": "Nadī-Amarikaṃ nāma ",
  "tha-ap500:8.2": "upagantvā ahaṃ tadā / ",
  "tha-ap500:8.3": "saṃvaḍḍhayitvā pulinaṃ ",
  "tha-ap500:8.4": "akaṃ pulinacetiyaṃ. // // ",
  "tha-ap500:9.1": "Ye te ahesuṃ sambuddhā ",
  "tha-ap500:9.2": "bhavantakaraṇā munī / ",
  "tha-ap500:9.3": "tesaṃ etādiso thūpo ",
  "tha-ap500:9.4": "taṃ nimittaṃ karom' ahaṃ. // // ",
  "tha-ap500:10.1": "Karitvā puline thūpaṃ ",
  "tha-ap500:10.2": "sovaṇṇaṃ māpayiṃ ahaṃ / ",
  "tha-ap500:10.3": "sovaṇṇakiṅkhanipupphānaṃ ",
  "tha-ap500:10.4": "sahasse tīṇi pūjayiṃ. // // ",
  "tha-ap500:11.1": "Sāya-pātaṃ namassāmi ",
  "tha-ap500:11.2": "vittijāto katañjalī / ",
  "tha-ap500:11.3": "sammukhā viya sambuddhaṃ ",
  "tha-ap500:11.4": "vandiṃ pulinacetiyaṃ. // // ",
  "tha-ap500:12.1": "Yadā kilesā jhāyanti ",
  "tha-ap500:12.2": "vitakkā gehanissitā / ",
  "tha-ap500:12.3": "sarāmi sukataṃ thūpaṃ ",
  "tha-ap500:12.4": "paccavekkhāmi tāvade. // // ",
  "tha-ap500:13.1": "Upanissāya viharam ",
  "tha-ap500:13.2": "satthavāhaṃ vināyakaṃ / ",
  "tha-ap500:13.3": "kilese saṃvaseyyāsi ",
  "tha-ap500:13.4": "na yuttaṃ tava marisa. // // ",
  "tha-ap500:14.1": "Saha āvajjite thūpe ",
  "tha-ap500:14.2": "gāravaṃ hoti me tadā / ",
  "tha-ap500:14.3": "kuvitakkaṃ vinodemi ",
  "tha-ap500:14.4": "nāgo tuttaddito yathā. // // ",
  "tha-ap500:15.1": "Evaṃ viharamānaṃ maṃ ",
  "tha-ap500:15.2": "Maccurājā 'bhimaddatha / ",
  "tha-ap500:15.3": "tattha kālakato santo ",
  "tha-ap500:15.4": "brahmalokaṃ agañch' ahaṃ. // // ",
  "tha-ap500:16.1": "Yavatāyuṃ vasitvāna ",
  "tha-ap500:16.2": "tidase upapajj' ahaṃ / ",
  "tha-ap500:16.3": "asītikkhattuṃ devindo ",
  "tha-ap500:16.4": "devarajjam akārayiṃ. // // ",
  "tha-ap500:17.1": "Satānaṃ tīṇikkhattuñ ca ",
  "tha-ap500:17.2": "cakkavatti ahos' ahaṃ / ",
  "tha-ap500:17.3": "padesarajjaṃ vipulaṃ ",
  "tha-ap500:17.4": "gaṇanāto asaṅkhiyaṃ. // // ",
  "tha-ap500:18.1": "Tesaṃ kiṅkhanipupphānaṃ ",
  "tha-ap500:18.2": "vipākaṃ anubhom' ahaṃ / ",
  "tha-ap500:18.3": "dvāvīsatisahassāni ",
  "tha-ap500:18.4": "parivārenti maṃ bhave. // // ",
  "tha-ap500:19.1": "Thūpassa pariciṇṇattā ",
  "tha-ap500:19.2": "rajojallaṃ na limpati / ",
  "tha-ap500:19.3": "gatte sedā na muccanti ",
  "tha-ap500:19.4": "sappabhāso bhavām' ahaṃ. // // ",
  "tha-ap500:20.1": "Aho me sukato thūpo ",
  "tha-ap500:20.2": "sudiṭṭhā 'Marikā nadī / ",
  "tha-ap500:20.3": "thūpaṃ katvāna puline ",
  "tha-ap500:20.4": "patto 'mhi acalaṃ padaṃ. // // ",
  "tha-ap500:21.1": "Kusalaṃ kattukāmena ",
  "tha-ap500:21.2": "jantunā pāragāminā / ",
  "tha-ap500:21.3": "n' atthi khettaṃ akhettaṃ vā ",
  "tha-ap500:21.4": "paṭipatti va sārikā. // // ",
  "tha-ap500:22.1": "Yathāpi balavā poso ",
  "tha-ap500:22.2": "aṇṇavaṃ taritussahe / ",
  "tha-ap500:22.3": "parittaṃ kaṭṭham ādāya ",
  "tha-ap500:22.4": "pakkhandeyya mahāsaraṃ // // ",
  "tha-ap500:23.1": "Imāhaṃ kaṭṭhaṃ nissāya ",
  "tha-ap500:23.2": "tarissāmi mahodadhiṃ / ",
  "tha-ap500:23.3": "ussāhena viriyena ",
  "tha-ap500:23.4": "tareyya udadhiṃ naro. // // ",
  "tha-ap500:24.1": "Tath' eva me kataṃ kammaṃ ",
  "tha-ap500:24.2": "parittaṃ thokakañcanaṃ / kataṃ ",
  "tha-ap500:24.3": "kammaṃ upanissāya ",
  "tha-ap500:24.4": "saṃsāraṃ samatikkamiṃ. // // ",
  "tha-ap500:25.1": "Pacchime bhave sampatte ",
  "tha-ap500:25.2": "sukkamūlena codito / ",
  "tha-ap500:25.3": "Sāvatthiyaṃ pure jāto ",
  "tha-ap500:25.4": "mahāsāle su-aḍḍhake. // // ",
  "tha-ap500:26.1": "Saddhā mātāpitā mayhaṃ ",
  "tha-ap500:26.2": "Buddhassa saraṇaṃ gatā / ",
  "tha-ap500:26.3": "ubho diṭṭhapadā ete ",
  "tha-ap500:26.4": "anuvattanti sāsanaṃ. // // ",
  "tha-ap500:27.1": "Bodhipapaṭikaṃ gayha ",
  "tha-ap500:27.2": "soṇṇathūpaṃ akārayuṃ / ",
  "tha-ap500:27.3": "sāyapātaṃ namassanti ",
  "tha-ap500:27.4": "Sakyaputtassa sammukhā. // // ",
  "tha-ap500:28.1": "Uposathamhi divase ",
  "tha-ap500:28.2": "soṇṇathūpaṃ vinīharuṃ / ",
  "tha-ap500:28.3": "Buddhassa vaṇṇaṃ kittentā ",
  "tha-ap500:28.4": "tiyāmaṃ vītināmayuṃ. // // ",
  "tha-ap500:29.1": "Sahā disvāna 'haṃ thūpaṃ ",
  "tha-ap500:29.2": "sariṃ pulinacetiyaṃ / ",
  "tha-ap500:29.3": "ekāsane nisīditvā ",
  "tha-ap500:29.4": "arahattaṃ apāpuṇiṃ. // // ",
  "tha-ap500:30.1": "",
  "tha-ap500:31.1": "Gavesamāno taṃ vīraṃ ",
  "tha-ap500:31.2": "dhammasenāpat' addasaṃ / ",
  "tha-ap500:31.3": "agārā nikkhamitvāna ",
  "tha-ap500:31.4": "pabbajiṃ tassa santike. // // ",
  "tha-ap500:32.1": "Jātiyā sattavassena ",
  "tha-ap500:32.2": "arahattaṃ apāpuṇiṃ / ",
  "tha-ap500:32.3": "upasampādayī Buddho ",
  "tha-ap500:32.4": "guṇaṃ aññāya cakkhumā. // // ",
  "tha-ap500:33.1": "Dāraken' eva santema ",
  "tha-ap500:33.2": "kiriyaṃ niṭṭhitaṃ mayā / ",
  "tha-ap500:33.3": "*kata*m me karaṇīy' ajja ",
  "tha-ap500:33.4": "Sakyaputtassa sāsane. // // ",
  "tha-ap500:34.1": "Sabbaverabhayātīto ",
  "tha-ap500:34.2": "sabbasaṅgātigo isi / ",
  "tha-ap500:34.3": "sāvako te mahāvīra ",
  "tha-ap500:34.4": "soṇṇathūpass' idaṃ phalaṃ. // // ",
  "tha-ap500:35.1": "Kilesā . . . ",
  "tha-ap500:35.2": "pe . . . ",
  "tha-ap500:35.3": "",
  "tha-ap500:36.1": "",
  "tha-ap500:36.2": "pe . . . ",
  "tha-ap500:36.3": "pe . . . // // Sāgataṃ . . . pe . . . pe . . . pe . . . // // ",
  "tha-ap500:37.1": "Paṭisambhidā . . . ",
  "tha-ap500:37.2": "pe . . . ",
  "tha-ap500:37.3": "pe . . . pe . . . // // ",
  "tha-ap500:38.1": "Itthaṃ sudaṃ āyasmā Pulinathūpiyo thero i. g. a-ti. Puḷinathūpiyattherassa apadānaṃ samattaṃ. Himavantass' avidūre Bhāriko ",
  "tha-ap500:39.1": ""
}
