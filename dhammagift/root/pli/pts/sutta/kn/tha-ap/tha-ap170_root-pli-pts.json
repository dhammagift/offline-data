  "tha-ap170:0.2": "",
  "tha-ap170:0.3": "",
  "tha-ap170:1.1": "Tivarāyaṃ pure ramme ",
  "tha-ap170:1.2": "rājaputto ahaṃ tadā / ",
  "tha-ap170:1.3": "paṇṇākāraṃ labhitvāna ",
  "tha-ap170:1.4": "upasantass' adās' ahaṃ. // // ",
  "tha-ap170:2.1": "Adhivāsesi bhagavā ",
  "tha-ap170:2.2": "vatthaṃ hatthena āmasi / ",
  "tha-ap170:2.3": "Siddhattho adhivāsetvā ",
  "tha-ap170:2.4": "vehāsaṃ nabham uggami. // // ",
  "tha-ap170:3.1": "Buddhassa gacchamānassa ",
  "tha-ap170:3.2": "dussā dhāvanti pacchato / ",
  "tha-ap170:3.3": "tattha cittaṃ pasādesiṃ ",
  "tha-ap170:3.4": "Buddho no aggapuggalo. // // ",
  "tha-ap170:4.1": "Catunavute ito kappe ",
  "tha-ap170:4.2": "yaṃ dussam adadiṃ tadā / ",
  "tha-ap170:4.3": "duggatiṃ nābhijānāmi ",
  "tha-ap170:4.4": "dussadānass' idaṃ phalaṃ. // // ",
  "tha-ap170:5.1": "Sattasaṭṭhi ito kappe ",
  "tha-ap170:5.2": "cakkavattī tadā ahu / ",
  "tha-ap170:5.3": "Parisuddho 'ti namena ",
  "tha-ap170:5.4": "manujindo mahabbalo. // // ",
  "tha-ap170:6.1": "Paṭisambhidā . . . ",
  "tha-ap170:6.2": "pe . . . ",
  "tha-ap170:6.3": "pe . . . // // ",
  "tha-ap170:7.1": "Itthaṃ sudaṃ ā. Dussadāyako thero i. g. ā-ti. Dussadāyakattherassa apadānaṃ samattaṃ. Bandhumatiyā ",
  "tha-ap170:8.1": ""
}
