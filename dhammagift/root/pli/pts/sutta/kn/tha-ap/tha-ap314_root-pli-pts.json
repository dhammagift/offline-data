  "tha-ap314:1.1": "Sujāto sālalaṭṭhīva ",
  "tha-ap314:1.2": "sobhañjana-m-iv' uggato / ",
  "tha-ap314:1.3": "indalaṭṭhi-r-ivākāse ",
  "tha-ap314:1.4": "virocati sadā jino. // // ",
  "tha-ap314:2.1": "Tassa devātidevassa ",
  "tha-ap314:2.2": "Vessabhussa mahesino / ",
  "tha-ap314:2.3": "adāsiṃ bhojanam ahaṃ ",
  "tha-ap314:2.4": "vippasannena cetasā. // // ",
  "tha-ap314:3.1": "Tam me Buddho anumodi ",
  "tha-ap314:3.2": "sayambhū aparājito: / ",
  "tha-ap314:3.3": "bhave nibbattamānamhi ",
  "tha-ap314:3.4": "phalaṃ nibbattatu tavaṃ. // // ",
  "tha-ap314:4.1": "Ekatiṃse ito kappe ",
  "tha-ap314:4.2": "yaṃ dānam adadiṃ tadā / ",
  "tha-ap314:4.3": "duggatiṃ nābhijānāmi ",
  "tha-ap314:4.4": "bhojanass' idaṃ phalaṃ. // // ",
  "tha-ap314:5.1": "Pañcavīse ito kappe ",
  "tha-ap314:5.2": "eko āsi Amittabhā / ",
  "tha-ap314:5.3": "sattaratanasampanno ",
  "tha-ap314:5.4": "cakkavatti mahabbalo. // // ",
  "tha-ap314:6.1": "Paṭisambhidā . . . ",
  "tha-ap314:6.2": "pe . . . ",
  "tha-ap314:6.3": "pe . . . // // ",
  "tha-ap314:7.1": "Itthaṃ sudam āyasmā Bhojanadāyako thero i. g. a-ti. Bhojanadāyakattherassa apadānaṃ samattaṃ. Ākāse* 'va* ",
  "tha-ap314:8.1": ""
}
