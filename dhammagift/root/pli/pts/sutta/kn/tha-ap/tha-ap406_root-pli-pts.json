  "tha-ap406:1.1": "Gaṅgā Bhāgīrasī nāma ",
  "tha-ap406:1.2": "Himavantā pabhāvitā / ",
  "tha-ap406:1.3": "Haṃsavatiyā dvārena ",
  "tha-ap406:1.4": "anusandati tāvade. // // ",
  "tha-ap406:2.1": "Sobhito nāma *ārāmo* ",
  "tha-ap406:2.2": "Gaṅgākūle sumāpito / ",
  "tha-ap406:2.3": "tattha Padumuttaro Buddho ",
  "tha-ap406:2.4": "vāsate lokanāyako. // // ",
  "tha-ap406:3.1": "Tidasehi yathā Indo ",
  "tha-ap406:3.2": "manujehi purakkhato / ",
  "tha-ap406:3.3": "nisīdi tattha bhagavā ",
  "tha-ap406:3.4": "asambhīto va kesarī. // // ",
  "tha-ap406:4.1": "Nagare Haṃsavatiyā ",
  "tha-ap406:4.2": "vasāmi brāhmaṇo ahaṃ / ",
  "tha-ap406:4.3": "Chalaṅgo nāma nāmena ",
  "tha-ap406:4.4": "evaṃ nāma ahaṃ muni. // // ",
  "tha-ap406:5.1": "Aṭṭhārasaṃ sissasatā ",
  "tha-ap406:5.2": "parivārenti maṃ tadā / ",
  "tha-ap406:5.3": "tehi sissehi samito ",
  "tha-ap406:5.4": "Gaṅgātīram upāgamiṃ. // // ",
  "tha-ap406:6.1": "Tatth' addasāsiṃ samaṇe ",
  "tha-ap406:6.2": "nikkuhe dhotapāpake / ",
  "tha-ap406:6.3": "Bhāgīrasim taranto 'haṃ ",
  "tha-ap406:6.4": "evaṃ cintesiṃ tāvade: // // ",
  "tha-ap406:7.1": "Sāyapātaṃ tarantā 'me ",
  "tha-ap406:7.2": "Buddhaputtā mahāyasā / ",
  "tha-ap406:7.3": "viheṭhayanti attānaṃ ",
  "tha-ap406:7.4": "tesaṃ attā vihaññati. // // ",
  "tha-ap406:8.1": "Sadevakassa lokassa ",
  "tha-ap406:8.2": "Buddho aggaṃ pavuccati / ",
  "tha-ap406:8.3": "n' atthi me dakkhiṇe kāraṃ ",
  "tha-ap406:8.4": "gatimaggavisodhanaṃ. // // ",
  "tha-ap406:9.1": "Yannūna Buddhaseṭṭhassa ",
  "tha-ap406:9.2": "setuṃ Gaṅgāya kāraye / ",
  "tha-ap406:9.3": "kārāpetvā imaṃ kammaṃ ",
  "tha-ap406:9.4": "saṃsarāmi imaṃ bhavaṃ. // // ",
  "tha-ap406:10.1": "Satasahassaṃ datvāna ",
  "tha-ap406:10.2": "setuṃ kārāpayim ahaṃ / ",
  "tha-ap406:10.3": "saddahanto kataṃ kāraṃ ",
  "tha-ap406:10.4": "vipulam me bhavissati. // // ",
  "tha-ap406:11.1": "Kārāpetvāna 'haṃ setum ",
  "tha-ap406:11.2": "upesiṃ lokanāyakaṃ / ",
  "tha-ap406:11.3": "sirasi añjaliṃ katvā ",
  "tha-ap406:11.4": "imaṃ vacanam abraviṃ: // // ",
  "tha-ap406:12.1": "Satasahassassa v' ayam ",
  "tha-ap406:12.2": "katvā kārāpito mayā / ",
  "tha-ap406:12.3": "tavatthāya mahāsetuṃ ",
  "tha-ap406:12.4": "paṭigaṇha mahāmune. // // ",
  "tha-ap406:13.1": "Padumuttaro lokavidū ",
  "tha-ap406:13.2": "āhutīnaṃ paṭiggaho / ",
  "tha-ap406:13.3": "bhikkhusaṅghe nisīditvā ",
  "tha-ap406:13.4": "imā gāthā abhāsatha: // // ",
  "tha-ap406:14.1": "\"Yo me setum akāresi ",
  "tha-ap406:14.2": "pasanno sehi pāṇihi / ",
  "tha-ap406:14.3": "tam ahaṃ kittayissāmi ",
  "tha-ap406:14.4": "suṇotha mama bhāsato: // // Dālito ",
  "tha-ap406:15.0": "",
  "tha-ap406:15.1": "pabbatato vā ",
  "tha-ap406:15.2": "rukkhato patito pi 'yaṃ / ",
  "tha-ap406:15.3": "cuto pi lacchati ṭṭhānaṃ ",
  "tha-ap406:15.4": "setudānass' idaṃ phalaṃ. // // ",
  "tha-ap406:16.1": "Virūḷhamūlasantānaṃ ",
  "tha-ap406:16.2": "Nigrodham iva māluto / ",
  "tha-ap406:16.3": "amittā na sahissanti ",
  "tha-ap406:16.4": "setudānass' idaṃ phalaṃ. // // ",
  "tha-ap406:17.1": "Nāssa corā sahissanti ",
  "tha-ap406:17.2": "nātimaññati khattiyo / ",
  "tha-ap406:17.3": "sabbe atikkamm' āmitte ",
  "tha-ap406:17.4": "setudānass' idaṃ phalaṃ. // // ",
  "tha-ap406:18.1": "Abbhokāsagataṃ santaṃ ",
  "tha-ap406:18.2": "kaṭhinātapatāpitaṃ / ",
  "tha-ap406:18.3": "puññakammena saṃyuttaṃ ",
  "tha-ap406:18.4": "na bhavissati vedanā. // // ",
  "tha-ap406:19.1": "Devaloke manusse vā ",
  "tha-ap406:19.2": "hatthiyānaṃ sunimmitaṃ / ",
  "tha-ap406:19.3": "tassa saṅkappam aññāya ",
  "tha-ap406:19.4": "nibbattissati tāvade. // // ",
  "tha-ap406:20.1": "Sahass' assā vā*tajavā* ",
  "tha-ap406:20.2": "sindhavā sīghavāhanā / ",
  "tha-ap406:20.3": "sāyaṃpātaṃ upessanti ",
  "tha-ap406:20.4": "setudānass' idaṃ phalaṃ. // // ",
  "tha-ap406:21.1": "Āgantvāna manussattaṃ ",
  "tha-ap406:21.2": "sukhito 'yaṃ bhavissati / ",
  "tha-ap406:21.3": "ihāpi manujass' *eva* ",
  "tha-ap406:21.4": "hatthiyānaṃ bhavissati. // // ",
  "tha-ap406:22.1": "Kappasatasahassamhi ",
  "tha-ap406:22.2": "Okkākakulasambhavo / ",
  "tha-ap406:22.3": "Gotamo nāma nāmena*satthā ",
  "tha-ap406:22.4": "loke* bhavissati. // // ",
  "tha-ap406:23.1": "Tassa dhammesu dāyādo ",
  "tha-ap406:23.2": "oraso dhammanimmito. / ",
  "tha-ap406:23.3": "Sabbāsave pariññāya ",
  "tha-ap406:23.4": "nibbāyissat' anāsavo.\" // // ",
  "tha-ap406:24.1": "Aho me sukataṃ kammaṃ ",
  "tha-ap406:24.2": "jaladuttamanāmake / ",
  "tha-ap406:24.3": "tattha kāraṃ karitvāna ",
  "tha-ap406:24.4": "patto 'haṃ āsavakkhayaṃ. // // ",
  "tha-ap406:25.1": "Padhānaṃ pahittatto 'mhi ",
  "tha-ap406:25.2": "upasanto nirūpadhi / ",
  "tha-ap406:25.3": "nāgo va bandhanaṃ chetvā ",
  "tha-ap406:25.4": "viharāmi anāsavo. // // ",
  "tha-ap406:26.1": "Kilesā . . . ",
  "tha-ap406:26.2": "pe . . . ",
  "tha-ap406:26.3": "",
  "tha-ap406:27.1": "",
  "tha-ap406:27.2": "pe . . . // // . ",
  "tha-ap406:27.3": "Sāgataṃ . . . pe . . . pe . . . // // ",
  "tha-ap406:28.1": "Paṭisambhidā . . . ",
  "tha-ap406:28.2": "pe . . . ",
  "tha-ap406:28.3": "pe . . . // // ",
  "tha-ap406:29.1": "Itthaṃ sudam āyasmā Dhotako thero i. g. a-ti. Dhotakattherassa apadānaṃ samattaṃ. Himavantass' avidūre ",
  "tha-ap406:30.1": ""
}
