  "tha-ap438:1.1": "Romaso nāma sambuddho ",
  "tha-ap438:1.2": "vasati pabbatantare / ",
  "tha-ap438:1.3": "kalambaṃ tassa pādāsiṃ ",
  "tha-ap438:1.4": "pasanno sehi pāṇihi. // // Catunavute ",
  "tha-ap438:2.1": "ito kappe ",
  "tha-ap438:2.2": "yaṃ dānaṃ adadiṃ tadā / ",
  "tha-ap438:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap438:2.4": "kalambassa idaṃ phalaṃ. // // ",
  "tha-ap438:3.1": "Kilesā . . . ",
  "tha-ap438:3.2": "pe . . . ",
  "tha-ap438:3.3": "",
  "tha-ap438:4.1": "",
  "tha-ap438:4.2": "pe . . . ",
  "tha-ap438:4.3": "pe . . . // // Sāgataṃ . . . pe . . . pe . . . pe . . . // // ",
  "tha-ap438:5.1": "Paṭisambhidā . . . ",
  "tha-ap438:5.2": "pe . . . ",
  "tha-ap438:5.3": "pe . . . pe . . . // // ",
  "tha-ap438:6.1": "Itthaṃ sudaṃ āyasmā Kalambadāyako thero i. g. a-ti. Kalambadāyakattherassa ",
  "tha-ap438:7.1": "apadānaṃ samattaṃ. Pavane "
