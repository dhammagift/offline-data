  "tha-ap529:1.1": "Migaluddo pure āsiṃ ",
  "tha-ap529:1.2": "vicine vicaraṃ ahaṃ / ",
  "tha-ap529:1.3": "addasaṃ virajaṃ Buddhaṃ ",
  "tha-ap529:1.4": "sabbadhammāna pāraguṃ. // // ",
  "tha-ap529:2.1": "Tasmiṃ mahākāruṇike ",
  "tha-ap529:2.2": "sabbasattahite rate / ",
  "tha-ap529:2.3": "pasannacitto sumano ",
  "tha-ap529:2.4": "nelapupphaṃ apūjayiṃ. // // ",
  "tha-ap529:3.1": "Ekatiṃse ito kappe ",
  "tha-ap529:3.2": "yaṃ puppham abhipūjayiṃ / ",
  "tha-ap529:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap529:3.4": "Buddhapūjāy' idaṃ phalaṃ. // // ",
  "tha-ap529:4.1": "Kilesā . . . ",
  "tha-ap529:4.2": "pe . . . ",
  "tha-ap529:4.3": "",
  "tha-ap529:5.1": "",
  "tha-ap529:5.2": "pe . . . ",
  "tha-ap529:5.3": "pe . . . // // Sāgataṃ . . . pe . . . pe . . . pe . . . // // ",
  "tha-ap529:6.1": "Paṭisambhidā . . . ",
  "tha-ap529:6.2": "pe . . . ",
  "tha-ap529:6.3": "pe . . . pe . . . // // ",
  "tha-ap529:7.1": "Itthaṃ sudaṃ āyasmā Girinelapūjako thero i. g. a-ti. Girinelapūjakattherassa ",
  "tha-ap529:8.1": "apadānaṃ samattaṃ. "
}
