  "tha-ap382:0.3": "",
  "tha-ap382:1.1": "jotantaṃ ",
  "tha-ap382:1.2": "nisinnaṃ pabbatantare / ",
  "tha-ap382:1.3": "addasaṃ virajaṃ Buddhaṃ ",
  "tha-ap382:1.4": "lokajeṭṭhaṃ narāsabhaṃ. // // ",
  "tha-ap382:2.1": "Pasannacitto sumano ",
  "tha-ap382:2.2": "sīre katvāna añjaliṃ / ",
  "tha-ap382:2.3": "*kāsumāri*phalaṃ gayha ",
  "tha-ap382:2.4": "Buddhaseṭṭhassa dās' ahaṃ. // // ",
  "tha-ap382:3.1": "Ekatiṃse ito kappe ",
  "tha-ap382:3.2": "yaṃ phalam adadim ahaṃ / ",
  "tha-ap382:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap382:3.4": "phaladānass' idaṃ phalaṃ. // // ",
  "tha-ap382:4.1": "Sāgataṃ . . . pe . . . pe . . . // // Kilesā . . . ",
  "tha-ap382:4.2": "pe . . . ",
  "tha-ap382:4.3": "",
  "tha-ap382:5.1": "",
  "tha-ap382:5.2": "pe . . . // // ",
  "tha-ap382:5.3": "",
  "tha-ap382:6.1": "Paṭisambhidā . . . ",
  "tha-ap382:6.2": "pe . . . ",
  "tha-ap382:6.3": "pe . . . // // ",
  "tha-ap382:7.1": "Itthaṃ sudam āyasmā Kāsumāriphaladāyako Kāsumāriphaladāyakattherassa apadānaṃ samattaṃ. ",
  "tha-ap382:8.1": "",
  "tha-ap382:9.1": "Uddānaṃ: ",
  "tha-ap382:10.1": "",
  "tha-ap382:11.1": "Bodhi-Pāṭalipupphī ca Uppalī ",
  "tha-ap382:11.2": "Sattapaṇṇiyo ",
  "tha-ap382:11.3": "Gandhamuṭṭhī ca Citako ",
  "tha-ap382:11.4": "Tālaṃ Sumanadāmako ",
  "tha-ap382:11.5": "Kāsumāriphala pi ca ",
  "tha-ap382:11.6": "gāthā ekūnasaṭṭhikā "
}
