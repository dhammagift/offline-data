  "tha-ap447:1.1": "Nigrodhe haritobhāse ",
  "tha-ap447:1.2": "saṃvirūḷhamhi pādape / ",
  "tha-ap447:1.3": "utuḷhimālaṃ paggayha ",
  "tha-ap447:1.4": "bodhiyā abhiropayiṃ. // // ",
  "tha-ap447:2.1": "Imasmiṃ yeva kappamhi ",
  "tha-ap447:2.2": "yaṃ puppham abhiropayiṃ / ",
  "tha-ap447:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap447:2.4": "bodhipūjāy' idaṃ phalaṃ. // // ",
  "tha-ap447:3.1": "Kilesā . . . ",
  "tha-ap447:3.2": "pe . . . ",
  "tha-ap447:3.3": "",
  "tha-ap447:4.1": "",
  "tha-ap447:4.2": "pe . . . ",
  "tha-ap447:4.3": "pe . . . // // Sāgataṃ . . . pe . . . pe . . . pe . . . // // ",
  "tha-ap447:5.1": "Paṭisambhidā . . . ",
  "tha-ap447:5.2": "pe . . . ",
  "tha-ap447:5.3": "pe . . . pe . . . // // ",
  "tha-ap447:6.1": "Itthaṃ sudam āyasmā Utuḷhipupphiyo th. i. g. a-ti. Utuḷhipupphiyattherassa ",
  "tha-ap447:7.1": "apadānaṃ samattaṃ. "
}
