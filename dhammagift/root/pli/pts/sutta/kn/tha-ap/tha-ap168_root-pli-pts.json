  "tha-ap168:0.3": "",
  "tha-ap168:1.1": "Phusso nāmātha bhagavā ",
  "tha-ap168:1.2": "āhutīnaṃ paṭiggaho / ",
  "tha-ap168:1.3": "gacchate vīthiyā vīro ",
  "tha-ap168:1.4": "nibbāpento mahājanaṃ. // // ",
  "tha-ap168:2.1": "Anupubbena bhagavā ",
  "tha-ap168:2.2": "āgacchi mama santikaṃ / ",
  "tha-ap168:2.3": "tato 'haṃ pattaṃ paggayha ",
  "tha-ap168:2.4": "sappitelaṃ adās' ahaṃ. // // ",
  "tha-ap168:3.1": "Dvenavute ito kappe ",
  "tha-ap168:3.2": "yaṃ sappim adadiṃ tadā / ",
  "tha-ap168:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap168:3.4": "sappidānass' idaṃ phalaṃ. // // ",
  "tha-ap168:4.1": "Chappaññāse ito kappe ",
  "tha-ap168:4.2": "eko āsiṃ Samodako / ",
  "tha-ap168:4.3": "sattaratanasampanno ",
  "tha-ap168:4.4": "cakkavattī mahabbalo // // ",
  "tha-ap168:5.1": "Paṭisambhidā . . . ",
  "tha-ap168:5.2": "pe . . . ",
  "tha-ap168:5.3": "pe . . . // // ",
  "tha-ap168:6.1": "Itthaṃ sudaṃ ā. Sappidāyako thero i. g. ā-ti. Sappidāyakattherassa ",
  "tha-ap168:7.1": "apadānaṃ samattaṃ. "
}
