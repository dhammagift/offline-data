  "tha-ap386:1.1": "Buddhaṃ disvāna ",
  "tha-ap386:1.2": "Atthadassiṃ mahāyasaṃ / ",
  "tha-ap386:1.3": "pasannacitto sumano ",
  "tha-ap386:1.4": "pilakkhassa phalam adaṃ. // // ",
  "tha-ap386:2.1": "Aṭṭhārase kappasate ",
  "tha-ap386:2.2": "yaṃ phalam adadiṃ tadā / ",
  "tha-ap386:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap386:2.4": "phaladānass' idaṃ phalaṃ. // // ",
  "tha-ap386:3.1": "Sāgataṃ . . . pe . . . pe . . . // // Kilesā . . . ",
  "tha-ap386:3.2": "pe . . . ",
  "tha-ap386:3.3": "",
  "tha-ap386:4.1": "",
  "tha-ap386:4.2": "pe . . . // // ",
  "tha-ap386:4.3": "",
  "tha-ap386:5.1": "Paṭisambhidā . . . ",
  "tha-ap386:5.2": "pe . . . ",
  "tha-ap386:5.3": "pe // // ",
  "tha-ap386:6.1": "Itthaṃ sudam āyasmā Pilakkhaphaladāyako Pilakkhaphaladāyakattherassa apadānaṃ ",
  "tha-ap386:7.1": "samattaṃ. "
}
