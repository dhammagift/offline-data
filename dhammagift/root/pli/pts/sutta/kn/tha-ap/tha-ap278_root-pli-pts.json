  "tha-ap278:1.1": "Satthāraṃ dhammam ārabbha ",
  "tha-ap278:1.2": "saṅghañ cāpi mahesino / ",
  "tha-ap278:1.3": "potthadānaṃ mayā dinnaṃ ",
  "tha-ap278:1.4": "dakkhiṇeyye anuttare. // // ",
  "tha-ap278:2.1": "Ekanavute ito kappe ",
  "tha-ap278:2.2": "yaṃ kammam akariṃ tadā / ",
  "tha-ap278:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap278:2.4": "potthadānass' idaṃ phalaṃ. // // ",
  "tha-ap278:3.1": "Paṭisambhidā . . . ",
  "tha-ap278:3.2": "pe . . . ",
  "tha-ap278:3.3": "pe . . . // // ",
  "tha-ap278:4.1": "Itthaṃ sudam āyasmā Potthadāyako thero i. g. a-ti. Potthadāyakattherassa ",
  "tha-ap278:5.1": "apadānaṃ samattaṃ. "
}
