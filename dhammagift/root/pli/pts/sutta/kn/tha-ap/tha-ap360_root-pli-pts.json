  "tha-ap360:1.1": "Vipassino bhagavato ",
  "tha-ap360:1.2": "lokajeṭṭhassa tādino / ",
  "tha-ap360:1.3": "ekaṃ sajjhaṃ mayā dinnaṃ ",
  "tha-ap360:1.4": "pasannena sapāṇinā. // // ",
  "tha-ap360:2.1": "Hatthiyānaṃ assayānaṃ ",
  "tha-ap360:2.2": "dibbayānaṃ samajjhagaṃ / ",
  "tha-ap360:2.3": "tena sajjhakadānena ",
  "tha-ap360:2.4": "patto 'mhi āsavakkhayaṃ. // // ",
  "tha-ap360:3.1": "Ekanavute ito kappe ",
  "tha-ap360:3.2": "yaṃ sajjham adadiṃ tadā / ",
  "tha-ap360:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap360:3.4": "sajjhadānass' idaṃ phalaṃ. // // ",
  "tha-ap360:4.1": "Paṭisambhidā . . . ",
  "tha-ap360:4.2": "pe . . . ",
  "tha-ap360:4.3": "pe . . . // // ",
  "tha-ap360:5.1": "Itthaṃ sudam āyasmā Sajjhadāyako thero i. g. a-ti. Sajjhadāyakattherassa ",
  "tha-ap360:6.1": "apadānaṃ samattaṃ. Āruhamhā "
}
