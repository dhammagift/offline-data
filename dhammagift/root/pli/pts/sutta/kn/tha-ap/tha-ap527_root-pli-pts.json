  "tha-ap527:1.1": "Divāvihārā nikkhanto ",
  "tha-ap527:1.2": "Vipassī lokanāyako / ",
  "tha-ap527:1.3": "lahupūpapavaṃ datvā ",
  "tha-ap527:1.4": "kappaṃ saggamhi mod' ahaṃ. // // Ekanavute ",
  "tha-ap527:2.1": "ito kappe ",
  "tha-ap527:2.2": "pūpapavaṃ adās' ahaṃ / ",
  "tha-ap527:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap527:2.4": "pūpapavass' idaṃ phalaṃ. // // ",
  "tha-ap527:3.1": "Kilesā . . . ",
  "tha-ap527:3.2": "pe . . . ",
  "tha-ap527:3.3": "",
