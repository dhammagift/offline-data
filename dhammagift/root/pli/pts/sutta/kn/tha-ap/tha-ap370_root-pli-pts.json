  "tha-ap370:1.1": "Upasanto va sambuddho ",
  "tha-ap370:1.2": "vasati pabbatantare / ",
  "tha-ap370:1.3": "ekaṃ campakam ādāya ",
  "tha-ap370:1.4": "upagacchiṃ naruttamaṃ. // // ",
  "tha-ap370:2.1": "Pasannacitto sumano ",
  "tha-ap370:2.2": "paccekamunim uttamaṃ / ",
  "tha-ap370:2.3": "ubho hatthehi paggayha ",
  "tha-ap370:2.4": "pūjayim aparājitaṃ. // // ",
  "tha-ap370:3.1": "Ekatiṃse ito kappe ",
  "tha-ap370:3.2": "yaṃ puppham abhipūjayiṃ / ",
  "tha-ap370:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap370:3.4": "Buddhapūjāy' idaṃ phalaṃ. // // ",
  "tha-ap370:4.1": "Paṭisambhidā . . . ",
  "tha-ap370:4.2": "pe . . . ",
  "tha-ap370:4.3": "pe . . . // // ",
  "tha-ap370:5.1": "Itthaṃ sudam āyasmā Ekacampakapupphiyo th. i. g. a-ti. Ekacampakapupphiyattherassa apadānaṃ samattaṃ. ",
  "tha-ap370:6.1": ""
}
