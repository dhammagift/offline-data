  "tha-ap175:1.1": "Migaluddo pure āsiṃ ",
  "tha-ap175:1.2": "araññe kānane ahaṃ / ",
  "tha-ap175:1.3": "Vipassiṃ addasam Buddhaṃ ",
  "tha-ap175:1.4": "devadevaṃ narāsabhaṃ. // // ",
  "tha-ap175:2.1": "Rattikaṃ pupphitaṃ disvā ",
  "tha-ap175:2.2": "kuṭajaṃ dharaṇīruhaṃ / ",
  "tha-ap175:2.3": "samūlaṃ paggahetvāna ",
  "tha-ap175:2.4": "upanesiṃ mahe*sino. // // ",
  "tha-ap175:3.1": "Ekanavute* ito kappe ",
  "tha-ap175:3.2": "yaṃ puppham abhiropayiṃ / ",
  "tha-ap175:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap175:3.4": "pupphadānass' idaṃ phalaṃ. // // ",
  "tha-ap175:4.1": "Ito ca aṭṭhame kappe ",
  "tha-ap175:4.2": "Suppasannassanāmako / ",
  "tha-ap175:4.3": "sattaratanasampanno ",
  "tha-ap175:4.4": "rājāhosi mahabbalo. // // ",
  "tha-ap175:5.1": "Paṭisambhidā . . . ",
  "tha-ap175:5.2": "pe . . . ",
  "tha-ap175:5.3": "pe . . . // // ",
  "tha-ap175:6.1": "Itthaṃ sudaṃ āyasmā Rattipupphiyo thero i. g. a-ti. Rattipupphiyattherassa apadānaṃ samattaṃ. ",
  "tha-ap175:7.1": ""
}
