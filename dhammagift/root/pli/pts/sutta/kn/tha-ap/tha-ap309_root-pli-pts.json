  "tha-ap309:1.1": "Siddhatthassa bhagavato ",
  "tha-ap309:1.2": "ārāmo *ro*pito mama / ",
  "tha-ap309:1.3": "sandacchāyesu rukkhesu ",
  "tha-ap309:1.4": "upavattesu pakkhisu. // // ",
  "tha-ap309:2.1": "Addasaṃ virajaṃ Buddham ",
  "tha-ap309:2.2": "āhutīnaṃ paṭiggahaṃ / ",
  "tha-ap309:2.3": "ārāmam atināmesiṃ ",
  "tha-ap309:2.4": "lokajeṭṭhaṃ narāsabhaṃ. // // ",
  "tha-ap309:3.1": "Haṭṭho haṭṭhena cittena ",
  "tha-ap309:3.2": "phalam pupphañ ca 'dās' ahaṃ / ",
  "tha-ap309:3.3": "tato jātappasādo ca ",
  "tha-ap309:3.4": "taṃ dānaṃ pari*ṇāmay*iṃ. // // ",
  "tha-ap309:4.1": "*Buddhassa yaṃ idaṃ* dāsiṃ ",
  "tha-ap309:4.2": "vippasannena cetasā / ",
  "tha-ap309:4.3": "bhave nibbattamānamhi ",
  "tha-ap309:4.4": "nibbattati phalaṃ mama. // // ",
  "tha-ap309:5.1": "Catunavute ito kappe ",
  "tha-ap309:5.2": "yaṃ dānam adadiṃ tadā / ",
  "tha-ap309:5.3": "duggatiṃ nābhijānāmi ",
  "tha-ap309:5.4": "ārāmassa idaṃ phalaṃ. // // Ito ",
  "tha-ap309:6.1": "sattatiṃse kappe ",
  "tha-ap309:6.2": "*satt' āsuṃ Mudusītalā* / ",
  "tha-ap309:6.3": "sattaratanasampannā ",
  "tha-ap309:6.4": "cakkavattī mahabbalā. // // ",
  "tha-ap309:7.1": "Patisambhidā . . . ",
  "tha-ap309:7.2": "pe . . . ",
  "tha-ap309:7.3": "pe . . . // // ",
  "tha-ap309:8.1": "Itthaṃ sudam āyasmā Ārāmadāyako thero i. g. a-ti. Ārāmadāyakattherassa ",
  "tha-ap309:9.1": "apadānaṃ samattaṃ. "
}
