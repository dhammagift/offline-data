  "tha-ap286:1.1": "Dakkhiṇamhi duvāramhi ",
  "tha-ap286:1.2": "pisāco ās' ahaṃ tadā / ",
  "tha-ap286:1.3": "addasaṃ virajaṃ Buddhaṃ ",
  "tha-ap286:1.4": "vītaraṃsaṃ va bhāṇumaṃ. // // ",
  "tha-ap286:2.1": "Vipassissa naraggassa ",
  "tha-ap286:2.2": "sabbalokahitesino / ",
  "tha-ap286:2.3": "ekapupphaṃ mayā dinnaṃ ",
  "tha-ap286:2.4": "dipadindassa tādino. // // ",
  "tha-ap286:3.1": "Ekanavute ito kappe ",
  "tha-ap286:3.2": "yaṃ puppham adadiṃ tadā / ",
  "tha-ap286:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap286:3.4": "Buddhapūjāy' idaṃ phalaṃ. // // ",
  "tha-ap286:4.1": "Paṭisambhidā . . . ",
  "tha-ap286:4.2": "pe . . . ",
  "tha-ap286:4.3": "pe . . . // // ",
  "tha-ap286:5.1": "Itthaṃ sudam āyasmā Ekapupphiyo thero i. g. a-ti. Ekapupphiyattherassa apadānaṃ samattaṃ. Nammadā nadiyā ",
  "tha-ap286:6.1": ""
}
