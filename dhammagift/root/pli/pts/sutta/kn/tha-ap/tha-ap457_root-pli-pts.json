  "tha-ap457:1.1": "Kakusandhassa munino ",
  "tha-ap457:1.2": "brāhmaṇassa vusīmato / ",
  "tha-ap457:1.3": "divāvihāraṃ vajato ",
  "tha-ap457:1.4": "akkamanam adās' ahaṃ. // // ",
  "tha-ap457:2.1": "Imasmiṃ yeva kappasmiṃ ",
  "tha-ap457:2.2": "yaṃ dānam adadiṃ tadā / ",
  "tha-ap457:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap457:2.4": "akkamanass' idaṃ phalaṃ. // // ",
  "tha-ap457:3.1": "Kilesā . . . ",
  "tha-ap457:3.2": "pe . . . ",
  "tha-ap457:3.3": "",
  "tha-ap457:4.1": "",
  "tha-ap457:4.2": "pe . . . ",
  "tha-ap457:4.3": "pe . . . // // Sāgataṃ . . . pe . . . pe . . . pe . . . // // ",
  "tha-ap457:5.1": "Paṭisambhidā . . . ",
  "tha-ap457:5.2": "pe . . . ",
  "tha-ap457:5.3": "pe . . . pe . . . // // ",
  "tha-ap457:6.1": "Itthaṃ sudaṃ āyasmā Akkamanadāyako thero i. g. a-ti. Akkamanadāyakattherassa apadanaṃ samattaṃ. ",
  "tha-ap457:7.1": ""
}
