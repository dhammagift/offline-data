  "tha-ap319:1.1": "Sudassano mahāvīro ",
  "tha-ap319:1.2": "deseti amataṃ padaṃ / ",
  "tha-ap319:1.3": "parivuto sāvakehi ",
  "tha-ap319:1.4": "vasati ghara-m-uttame. // // ",
  "tha-ap319:2.1": "Tāya vācāya madhurāya ",
  "tha-ap319:2.2": "saṅgaṇhanta-mahājanaṃ / ",
  "tha-ap319:2.3": "ghoso ca vipulo āsi ",
  "tha-ap319:2.4": "sadevamānusena so. // // ",
  "tha-ap319:3.1": "Nigghosasaddaṃ sutvāna ",
  "tha-ap319:3.2": "Siddhatthassa mahesino / ",
  "tha-ap319:3.3": "sadde cittaṃ pasādetvā ",
  "tha-ap319:3.4": "avandiṃ lokanāyakaṃ. // // ",
  "tha-ap319:4.1": "Catunavute ito kappe ",
  "tha-ap319:4.2": "yaṃ saññam alabhiṃ tadā / ",
  "tha-ap319:4.3": "duggatiṃ nābhijānāmi ",
  "tha-ap319:4.4": "Buddhasaññāy' idaṃ phalaṃ. // // ",
  "tha-ap319:5.1": "Paṭisambhidā . . . ",
  "tha-ap319:5.2": "pe . . . ",
  "tha-ap319:5.3": "pe . . . // // ",
  "tha-ap319:6.1": "Itthaṃ sudam āyasmā Saddasaññako thero i. g. a-ti. Saddasaññakattherassa apadānaṃ samattaṃ. ",
  "tha-ap319:7.1": ""
}
