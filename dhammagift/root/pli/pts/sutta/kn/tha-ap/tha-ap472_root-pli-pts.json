  "tha-ap472:1.1": "Ajjhogahetvā Himavaṃ ",
  "tha-ap472:1.2": "mante vācem' ahaṃ tadā / ",
  "tha-ap472:1.3": "catupaññāsasahassāni ",
  "tha-ap472:1.4": "sissā mayham upaṭṭhahuṃ. // // ",
  "tha-ap472:2.1": "Adhītā vedagū sabbe ",
  "tha-ap472:2.2": "chalaṅge pāramiṅgatā / ",
  "tha-ap472:2.3": "sakavijjāh' upatthaddhā ",
  "tha-ap472:2.4": "Himavante vasanti te. // // ",
  "tha-ap472:3.1": "Cavitvā Tusitākāyā ",
  "tha-ap472:3.2": "devaputto mahāyaso / ",
  "tha-ap472:3.3": "uppajji mātukucchismiṃ ",
  "tha-ap472:3.4": "sampajāno paṭissato. // // ",
  "tha-ap472:4.1": "Sambuddhe upapajjante ",
  "tha-ap472:4.2": "dasasahassī pakampatha / ",
  "tha-ap472:4.3": "andhā cakkhuṃ alatthaṃsu ",
  "tha-ap472:4.4": "uppajjantamhi nāyake. // // ",
  "tha-ap472:5.1": "Chabbikāraṃ pakampittha ",
  "tha-ap472:5.2": "kevalā vasudhā ayaṃ / ",
  "tha-ap472:5.3": "nigghosasaddaṃ sutvāna ",
  "tha-ap472:5.4": "ubbijjiṃsu mahājanā. // // ",
  "tha-ap472:6.1": "Sabbe janā samāgamma ",
  "tha-ap472:6.2": "āgacchuṃ mama santikaṃ / ",
  "tha-ap472:6.3": "‘vasudhāyaṃ pakampittha ",
  "tha-ap472:6.4": "kiṃ vipāko bhavissati?' // // ",
  "tha-ap472:7.1": "Avacāsi tadā tesaṃ, ",
  "tha-ap472:7.2": "mā bhetha n' atthi vo bhayaṃ / ",
  "tha-ap472:7.3": "vissatthā hotha sabbe pi, ",
  "tha-ap472:7.4": "uppādo 'yaṃ sukhatthiko. // // ",
  "tha-ap472:8.1": "Aṭṭhahetuhi samphassa ",
  "tha-ap472:8.2": "vasudhāyaṃ pakampati / ",
  "tha-ap472:8.3": "tathā nimittā dissanti ",
  "tha-ap472:8.4": "obhāso vipulo mahā. // // ",
  "tha-ap472:9.1": "Asaṃsayaṃ Buddhaseṭṭho ",
  "tha-ap472:9.2": "uppajjissati cakkhumā / ",
  "tha-ap472:9.3": "saññāpetvāna janataṃ ",
  "tha-ap472:9.4": "pañcasīle kathem' ahaṃ // // ",
  "tha-ap472:10.1": "Sutvāna pañcasīlāni ",
  "tha-ap472:10.2": "Buddhuppādañ ca dullabhaṃ / ",
  "tha-ap472:10.3": "ubbegajātā sumanā ",
  "tha-ap472:10.4": "tuṭṭhahaṭṭhā āsiṃsu te. // // ",
  "tha-ap472:11.1": "Dvenavute ito kappe ",
  "tha-ap472:11.2": "yaṃ nimittaṃ viyākariṃ / ",
  "tha-ap472:11.3": "duggatiṃ nābhijānāmi ",
  "tha-ap472:11.4": "vyākaraṇāy' idaṃ phalaṃ. // // ",
  "tha-ap472:12.1": "Kilesā . . . ",
  "tha-ap472:12.2": "pe . . . ",
  "tha-ap472:12.3": "",
  "tha-ap472:13.1": "",
  "tha-ap472:13.2": "pe . . . ",
  "tha-ap472:13.3": "pe . . . // // Sāgataṃ . . . pe . . . pe . . . pe . . . // // ",
  "tha-ap472:14.1": "Paṭisambhidā . . . ",
  "tha-ap472:14.2": "pe . . . ",
  "tha-ap472:14.3": "pe . . . pe . . . // // ",
  "tha-ap472:15.1": "Itthaṃ sudam āyasmā Nimittavyākaraṇīyo th. i. g. a-ti. ",
  "tha-ap472:16.1": "Nimittavyākaraṇīyattherassa apadāmaṃ samattaṃ. ",
  "tha-ap472:17.1": "Uddānaṃ: Sālapupphī ",
  "tha-ap472:18.1": "ca ",
  "tha-ap472:19.1": "yo thero ",
  "tha-ap472:19.2": "Pūjā Nibbāpako pi ca ",
  "tha-ap472:19.3": "Setudo Tālavaṇṭī ca ",
  "tha-ap472:19.4": "Avaṭaṃ-Labuja-ppado. ",
  "tha-ap472:20.1": "Pilakkhu Paṭibhānī ca ",
  "tha-ap472:20.2": "Veyyakaraṇako dijo ",
  "tha-ap472:20.3": "dvesatañ c' eva gāthāyo ",
  "tha-ap472:20.4": "gaṇitāyo vibhāvihi. Sālapupphiyavaggo sattacattārīso. "
}
