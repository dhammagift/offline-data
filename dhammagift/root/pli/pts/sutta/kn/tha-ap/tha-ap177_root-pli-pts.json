  "tha-ap177:1.1": "*Nibbute lokanāthamhi ",
  "tha-ap177:1.2": "Padumuttara*nāyake / ",
  "tha-ap177:1.3": "pasannacitto sumano ",
  "tha-ap177:1.4": "sīhāsanam adās' ahaṃ. // // ",
  "tha-ap177:2.1": "Pahūtagandhamalyehi ",
  "tha-ap177:2.2": "diṭṭhadhammasukhāvahe / ",
  "tha-ap177:2.3": "tattha pūjaṃ karitvāna ",
  "tha-ap177:2.4": "nibbāyati bahujjano. // // ",
  "tha-ap177:3.1": "Pasannacitto sumano ",
  "tha-ap177:3.2": "vanditvā bodhim uttamaṃ / ",
  "tha-ap177:3.3": "kap*pānaṃ satasahassaṃ ",
  "tha-ap177:3.4": "duggatiṃ nū*papajj' ahaṃ. // // ",
  "tha-ap177:4.1": "Pannarasasahassamhi ",
  "tha-ap177:4.2": "kappānaṃ aṭṭha āsu te / ",
  "tha-ap177:4.3": "Sīluccaya-sanāmā va ",
  "tha-ap177:4.4": "rājāno cakkavattino. // // ",
  "tha-ap177:5.1": "Paṭisambhidā . . . ",
  "tha-ap177:5.2": "pe . . . ",
  "tha-ap177:5.3": "pe . . . // // ",
  "tha-ap177:6.1": "Itthaṃ sudaṃ āyasmā Sīhāsanadāyako thero i. g. a-ti. Sīhāsanadāyakattherassa ",
  "tha-ap177:7.1": "apadānaṃ samattaṃ. "
}
