  "tha-ap449:1.1": "Padumuttarassa bhagavato ",
  "tha-ap449:1.2": "sabbabhūtahitesino / ",
  "tha-ap449:1.3": "pasannacitto sumano ",
  "tha-ap449:1.4": "sīhāsanam adās' ahaṃ. // // ",
  "tha-ap449:2.1": "Devaloke manusse vā ",
  "tha-ap449:2.2": "yattha yattha vasām' ahaṃ / ",
  "tha-ap449:2.3": "labhāmi vipulaṃ vyamhaṃ ",
  "tha-ap449:2.4": "sīhāsanass' idaṃ phalaṃ // // ",
  "tha-ap449:3.1": "Sovaṇṇamayā rūpimayā ",
  "tha-ap449:3.2": "lohitaṅkamayā bahū / ",
  "tha-ap449:3.3": "maṇimayā ca pallaṅkā ",
  "tha-ap449:3.4": "nibbattanti mamaṃ sadā. // // ",
  "tha-ap449:4.1": "Bodhiyā āsanaṃ katvā ",
  "tha-ap449:4.2": "jalajuttamanāmino / ",
  "tha-ap449:4.3": "ucce kule pajāyāmi ",
  "tha-ap449:4.4": "aho dhammasudhammatā. // // ",
  "tha-ap449:5.1": "Satasahasse ito kappe ",
  "tha-ap449:5.2": "sīhāsanam akās' ahaṃ / ",
  "tha-ap449:5.3": "duggatiṃ nābhijānāmi ",
  "tha-ap449:5.4": "sīhāsanass' idaṃ phalaṃ. // // ",
  "tha-ap449:6.1": "Kilesā . . . ",
  "tha-ap449:6.2": "pe . . . ",
  "tha-ap449:6.3": "",
  "tha-ap449:7.1": "",
  "tha-ap449:7.2": "pe . . . ",
  "tha-ap449:7.3": "pe . . . // // Sāgataṃ . . . pe . . . pe . . . pe . . . // // ",
  "tha-ap449:8.1": "Paṭisambhidā . . . ",
  "tha-ap449:8.2": "pe . . . ",
  "tha-ap449:8.3": "pe . . . pe . . . // // ",
  "tha-ap449:9.1": "Itthaṃ sudaṃ āyasmā Sīhāsaniko thero i. g. a-ti. Sīhāsanikattherassa ",
  "tha-ap449:10.1": "apadānaṃ samattaṃ. "
}
