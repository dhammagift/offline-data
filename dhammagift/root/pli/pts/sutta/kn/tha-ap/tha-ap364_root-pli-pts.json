  "tha-ap364:0.3": "",
  "tha-ap364:1.1": "Yāmā devā idhāgantvā ",
  "tha-ap364:1.2": "Gotamaṃ sirivacchasaṃ / ",
  "tha-ap364:1.3": "kekkhārupupphaṃ paggayha ",
  "tha-ap364:1.4": "Buddhassa abhiropayiṃ. // // ",
  "tha-ap364:2.1": "Dvenavute ito kappe ",
  "tha-ap364:2.2": "yaṃ Buddham abhipūjayiṃ / ",
  "tha-ap364:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap364:2.4": "Buddhapūjāy' idaṃ phalaṃ. // // ",
  "tha-ap364:3.1": "Paṭisambhidā . . . ",
  "tha-ap364:3.2": "pe . . . ",
  "tha-ap364:3.3": "pe . . . // // ",
  "tha-ap364:4.1": "Itthaṃ sudam āyasmā Kekkhārupupphiyo th. i. g. a-ti. Kekkhārupupphiyattherassa ",
  "tha-ap364:5.1": "apadānaṃ samattaṃ. "
}
