  "tha-ap383:0.3": "",
  "tha-ap383:1.1": "Sataraṃsi nāma bhagavā ",
  "tha-ap383:1.2": "sayambhū aparājito / ",
  "tha-ap383:1.3": "vivekakāmo sambuddho ",
  "tha-ap383:1.4": "gocarāyābhinikkhami. // // ",
  "tha-ap383:2.1": "Phalahattho ahaṃ disvā ",
  "tha-ap383:2.2": "upagacchiṃ narāsabhaṃ / ",
  "tha-ap383:2.3": "pasannacitto sumano ",
  "tha-ap383:2.4": "avaṇṭam adadaṃ phalaṃ. // // ",
  "tha-ap383:3.1": "Catunavut' ito kappe ",
  "tha-ap383:3.2": "yaṃ phalam adadam ahaṃ / ",
  "tha-ap383:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap383:3.4": "phaladānass' idaṃ phalaṃ. // // ",
  "tha-ap383:4.1": "Sāgataṃ . . . pe . . . pe . . . // // Kilesā . . . pe . . . ",
  "tha-ap383:4.2": "",
  "tha-ap383:4.3": "",
  "tha-ap383:4.4": "",
  "tha-ap383:5.1": "pe . . . // // ",
  "tha-ap383:5.2": "",
  "tha-ap383:5.3": "",
  "tha-ap383:5.4": "",
  "tha-ap383:6.1": "Paṭisambhidā . . . pe . . . ",
  "tha-ap383:6.2": "",
  "tha-ap383:6.3": "pe . . . // // ",
  "tha-ap383:6.4": "",
  "tha-ap383:7.1": "Itthaṃ sudam āyasmā Avaṇṭaphaladāyako th. i. g. a-ti. Avaṇṭaphaladāyakattherassa apadānaṃ samattaṃ. ",
  "tha-ap383:8.1": ""
}
