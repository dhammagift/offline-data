  "tha-ap40:0.1": "",
  "tha-ap40:0.2": "",
  "tha-ap40:0.3": "",
  "tha-ap40:1.1": "Nibbute lokanāthamhi ",
  "tha-ap40:1.2": "Sikhimhi vadataṃ vare / ",
  "tha-ap40:1.3": "haṭṭho haṭṭhena cittena ",
  "tha-ap40:1.4": "avandiṃ thūpam uttamaṃ. // // ",
  "tha-ap40:2.1": "Vaḍḍhakehi kathāpetvā ",
  "tha-ap40:2.2": "mūlan datvān' ahaṃ tadā / ",
  "tha-ap40:2.3": "haṭṭho haṭṭhena cittena ",
  "tha-ap40:2.4": "āyāgaṃ kārapes' ahaṃ. // // ",
  "tha-ap40:3.1": "Aṭṭhakappāni devesu ",
  "tha-ap40:3.2": "abbhocchinnaṃ vasim ahaṃ / ",
  "tha-ap40:3.3": "avasesesu kappesu ",
  "tha-ap40:3.4": "vokiṇṇaṃ saṃsarim ahaṃ. // // ",
  "tha-ap40:4.1": "Kāye visaṃ na kamati ",
  "tha-ap40:4.2": "satthāni *na ca ha*nti me / ",
  "tha-ap40:4.3": "udake 'haṃ na miyyāmi ",
  "tha-ap40:4.4": "āyāgassa idaṃ phalaṃ. // // ",
  "tha-ap40:5.1": "Yad' icchāmi ahaṃ vassaṃ ",
  "tha-ap40:5.2": "mahāmegho pavassati / ",
  "tha-ap40:5.3": "devā pi me vasaṃ enti ",
  "tha-ap40:5.4": "puññakammass' idaṃ phalaṃ. // // ",
  "tha-ap40:6.1": "Sataratanasampanno ",
  "tha-ap40:6.2": "tiṃsakkhattuṃ ahos' ahaṃ / ",
  "tha-ap40:6.3": "na maṃ kecāvajānanti ",
  "tha-ap40:6.4": "puññakammass' idaṃ phalaṃ. // // ",
  "tha-ap40:7.1": "Ekatiṃse ito kappe ",
  "tha-ap40:7.2": "āyāgaṃ yam akārayiṃ / ",
  "tha-ap40:7.3": "duggatiṃ nābhijānāmi ",
  "tha-ap40:7.4": "āyāgassa idaṃ phalaṃ. // // ",
  "tha-ap40:8.1": "Paṭisambhidā catasso ",
  "tha-ap40:8.2": "vimokhā pi ca aṭṭh' ime / chaḍabhiññā sacchikatā ",
  "tha-ap40:8.3": "kataṃ Buddhassa sāsanan ti. // // ",
  "tha-ap40:9.1": "Itthaṃ sudaṃ āyasmā Āyāgodāyako thero imā gāthāyo abhāsitthā ti. ",
  "tha-ap40:10.1": "Āyāgadāyakatherassa apadānaṃ samattaṃ. "
}
