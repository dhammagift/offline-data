  "tha-ap537:0.3": "",
  "tha-ap537:1.1": "Ito satasahassamhi ",
  "tha-ap537:1.2": "kappe uppajji nāyako / ",
  "tha-ap537:1.3": "sabbalokahito vīro ",
  "tha-ap537:1.4": "Padumuttaranāmako. // // ",
  "tha-ap537:2.1": "Tadā 'haṃ brāhmaṇo hutvā ",
  "tha-ap537:2.2": "va sato vedapārago / ",
  "tha-ap537:2.3": "divāvihāraṃ vicaraṃ ",
  "tha-ap537:2.4": "addasaṃ lokanāyakaṃ // // ",
  "tha-ap537:3.1": "Catusaccaṃ pakāsentaṃ ",
  "tha-ap537:3.2": "bodhayantaṃ sadevakaṃ / ",
  "tha-ap537:3.3": "vicittakathikānaggaṃ ",
  "tha-ap537:3.4": "vaṇṇayantaṃ mahājane. // // ",
  "tha-ap537:4.1": "Tadā muditacitto 'haṃ ",
  "tha-ap537:4.2": "nimantetvā Tathāgataṃ / ",
  "tha-ap537:4.3": "nānārattehi vatthehi ",
  "tha-ap537:4.4": "alaṅkatvāna maṇḍapaṃ. // // ",
  "tha-ap537:5.1": "Nānāratanapajjotaṃ ",
  "tha-ap537:5.2": "sasaṅghaṃ bhojayiṃ tahiṃ / ",
  "tha-ap537:5.3": "bhojayitvāna sattāhaṃ ",
  "tha-ap537:5.4": "nānā-'gga-rasa-bhojanaṃ. // // ",
  "tha-ap537:6.1": "Nānācittehi pupphehi ",
  "tha-ap537:6.2": "pūjayitvā sasāvakaṃ / ",
  "tha-ap537:6.3": "nipacca pādamūlamhi ",
  "tha-ap537:6.4": "taṃ ṭhānaṃ patthayiṃ ahaṃ. // // ",
  "tha-ap537:7.1": "Tadā munivaro āha ",
  "tha-ap537:7.2": "karuṇ' eka-ras-āsayo / ",
  "tha-ap537:7.3": "passath' etaṃ dijavaraṃ ",
  "tha-ap537:7.4": "padumānanalocanaṃ // // ",
  "tha-ap537:8.1": "Pītipāmujjabahulaṃ ",
  "tha-ap537:8.2": "samuggatatanūruhaṃ / ",
  "tha-ap537:8.3": "hāsādhikaṃ visālakkhaṃ ",
  "tha-ap537:8.4": "mama sāsanalālasaṃ // // Maṃ pādamūle ",
  "tha-ap537:9.1": "patitaṃ ekāvattasumānasaṃ / ",
  "tha-ap537:9.2": "",
  "tha-ap537:9.3": "esa pattheti taṃ ṭhānaṃ ",
  "tha-ap537:9.4": "vicittakathikatthadaṃ. // // Satasahasse ",
  "tha-ap537:10.1": "ito kappe ",
  "tha-ap537:10.2": "Okkākakulasambhavo / ",
  "tha-ap537:10.3": "Gotamo nāma nāmena ",
  "tha-ap537:10.4": "satthā loke bhavissati. // // ",
  "tha-ap537:11.1": "Tassa dhammesu dāyādo ",
  "tha-ap537:11.2": "oraso dhammanimmito / ",
  "tha-ap537:11.3": "Kumāra Kassapo nāma ",
  "tha-ap537:11.4": "hessati satthu sāvako. // // ",
  "tha-ap537:12.1": "Vicittapupphadussānaṃ ",
  "tha-ap537:12.2": "ratanānañ ca vāhasā / ",
  "tha-ap537:12.3": "vicittakathikānaṃ so ",
  "tha-ap537:12.4": "aggataṃ pāpuṇissati. // // ",
  "tha-ap537:13.1": "Tena kammena sukatena ",
  "tha-ap537:13.2": "cetanāpaṇidhīhi ca / ",
  "tha-ap537:13.3": "jahitvā mānusaṃ dehaṃ ",
  "tha-ap537:13.4": "Tāvatiṃsaṃ agacch ahaṃ. // // ",
  "tha-ap537:14.1": "Paribbhamaṃ bhavākāse ",
  "tha-ap537:14.2": "raṅgamajjhe yathā naṭo / ",
  "tha-ap537:14.3": "sākhāmigatrajo hutvā ",
  "tha-ap537:14.4": "migiya kucchim okkhamiṃ. // // ",
  "tha-ap537:15.1": "Tadā mayi kucchigate ",
  "tha-ap537:15.2": "vijjhavāraṃ upaṭṭhitā / ",
  "tha-ap537:15.3": "sākhena cattā me mātā ",
  "tha-ap537:15.4": "nigrodham saraṇaṃ gatā. // // ",
  "tha-ap537:16.1": "Tena sā migarājena ",
  "tha-ap537:16.2": "maraṇā parimocitā / ",
  "tha-ap537:16.3": "pariccajitvā saṃ pāṇaṃ ",
  "tha-ap537:16.4": "mam evam ovadī tadā: // // ",
  "tha-ap537:17.1": "\"Nigrodham eva seveyya ",
  "tha-ap537:17.2": "na Sākham upasaṃvase / ",
  "tha-ap537:17.3": "Nigrodhasmiṃ mataṃ seyyo ",
  "tha-ap537:17.4": "yañ ce Sakhasmiṃ jīvitaṃ\". // // ",
  "tha-ap537:18.1": "Tenānusi*ṭṭhā* miga-y-ovādena / ",
  "tha-ap537:18.2": "*ahañ ca mātā ca tass' ovādena* // // ",
  "tha-ap537:18.3": "Āgamma rammaṃ Tusitādivāsaṃ / ",
  "tha-ap537:18.4": "gato pavāsaṃ sagharaṃ yath' eva. // // ",
  "tha-ap537:19.1": "Puno Kassapavīrassa ",
  "tha-ap537:19.2": "attham entamhi sāsane / ",
  "tha-ap537:19.3": "āruyha selasikharaṃ ",
  "tha-ap537:19.4": "yuñjitvā jinasāsanaṃ. // // ",
  "tha-ap537:20.1": "Idāni 'haṃ Rājagahe ",
  "tha-ap537:20.2": "jāto seṭṭhikule ahuṃ / ",
  "tha-ap537:20.3": "āpannagabbhā me mātā ",
  "tha-ap537:20.4": "pabbajiṃ anagāriyaṃ. // // ",
  "tha-ap537:21.1": "Sagabbhan taṃ viditvāna ",
  "tha-ap537:21.2": "Devadattam upānayuṃ / ",
  "tha-ap537:21.3": "so avoca: ‘vināsetha ",
  "tha-ap537:21.4": "pāpikaṃ bhikkhuniṃ imaṃ.' // // ",
  "tha-ap537:22.1": "Idāni pi munindena ",
  "tha-ap537:22.2": "jinena anukampitā / ",
  "tha-ap537:22.3": "sukhinī ajanī mayhaṃ ",
  "tha-ap537:22.4": "mātā bhikkhunupassaye. // // ",
  "tha-ap537:23.1": "Taṃ viditvā mahīpālo ",
  "tha-ap537:23.2": "Kosalo maṃ aposayi / ",
  "tha-ap537:23.3": "kumāraparihārena ",
  "tha-ap537:23.4": "nāmenāhañ ca Kassapo. // // ",
  "tha-ap537:24.1": "Mahā-Kassapam āgamma ",
  "tha-ap537:24.2": "ahaṃ Komārakassapo / ",
  "tha-ap537:24.3": "vammikasādisaṃ kāyaṃ ",
  "tha-ap537:24.4": "sutvā Buddhena desitaṃ. // // ",
  "tha-ap537:25.1": "Tato cittaṃ vimucci me ",
  "tha-ap537:25.2": "anupādāya sabbaso / ",
  "tha-ap537:25.3": "pāyāsiṃ damayitvā 'haṃ ",
  "tha-ap537:25.4": "etadaggaṃ apāpuṇiṃ. // // ",
  "tha-ap537:26.1": "Kilesā . . . ",
  "tha-ap537:26.2": "pe . . . ",
  "tha-ap537:26.3": "",
  "tha-ap537:27.1": "",
  "tha-ap537:27.2": "pe . . . ",
  "tha-ap537:27.3": "pe . . . // // Sāgataṃ . . . pe . . . pe . . . pe . . . // // ",
  "tha-ap537:28.1": "Paṭisambhidā . . . ",
  "tha-ap537:28.2": "pe . . . ",
  "tha-ap537:28.3": "pe . . . pe . . . // // ",
  "tha-ap537:29.1": "Itthaṃ sudaṃ āyasmā Kumārakassapo thero i. g. a- ti. Kumārakassapattherassa ",
  "tha-ap537:30.1": "",
  "tha-ap537:30.2": "apadānaṃ samattaṃ. "
}
