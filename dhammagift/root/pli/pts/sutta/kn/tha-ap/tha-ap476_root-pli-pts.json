  "tha-ap476:1.1": "Vipassino bhagavato ",
  "tha-ap476:1.2": "bodhiyā pāda-m- ",
  "tha-ap476:1.3": "uttame / sumanavījaniṃ gayha ",
  "tha-ap476:1.4": "avījiṃ bodhim uttamaṃ. // // Ekanavute ",
  "tha-ap476:2.1": "ito kappe ",
  "tha-ap476:2.2": "avījiṃ bodhim uttamaṃ / ",
  "tha-ap476:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap476:2.4": "vījanāya idaṃ phalaṃ. // // ",
  "tha-ap476:3.1": "Kilesā . . . ",
  "tha-ap476:3.2": "pe . . . ",
  "tha-ap476:3.3": "",
  "tha-ap476:4.1": "",
  "tha-ap476:4.2": "pe . . . ",
  "tha-ap476:4.3": "pe . . . // // Sāgataṃ . . . pe . . . pe . . . pe . . . // // ",
  "tha-ap476:5.1": "Paṭisambhidā . . . ",
  "tha-ap476:5.2": "pe . . . ",
  "tha-ap476:5.3": "pe . . . pe . . . // // ",
  "tha-ap476:6.1": "Itthaṃ sudam āyasmā Sumanavījaniyo thero i. g. a-ti. Sumanavījaniyattherassa ",
  "tha-ap476:7.1": "apadānaṃ samattaṃ. "
