  "tha-ap401:1.1": "Mahāsamuddam ogayha ",
  "tha-ap401:1.2": "bhavanam me sunimmitaṃ / ",
  "tha-ap401:1.3": "sunimmitā pokkharaṇī ",
  "tha-ap401:1.4": "cakkavākā pakūjitā. // // ",
  "tha-ap401:2.1": "Mandālakehi sañchannā ",
  "tha-ap401:2.2": "padumupphalakehi ca / ",
  "tha-ap401:2.3": "nadī ca sandate tattha ",
  "tha-ap401:2.4": "sūpatitthā manoramā. // // ",
  "tha-ap401:3.1": "Macchakacchapa*sañ*channā ",
  "tha-ap401:3.2": "nānāmigasamotthatā / mayurakoñcā ",
  "tha-ap401:3.3": "bhīrujā ",
  "tha-ap401:3.4": "kokilādihi vagguhi. // // ",
  "tha-ap401:4.1": "Pārevaṭā ravihaṃsā ",
  "tha-ap401:4.2": "cakkavākā nadīcarā / ",
  "tha-ap401:4.3": "dindibhā sāḷikā c' ettha ",
  "tha-ap401:4.4": "pampakā jīvajīvakā. // // ",
  "tha-ap401:5.1": "Haṃsā koñcābhināditā kosikā ",
  "tha-ap401:5.2": "piṅgalā bahū / ",
  "tha-ap401:5.3": "sattaratanasampannā ",
  "tha-ap401:5.4": "maṇimuttikavālukā. // // ",
  "tha-ap401:6.1": "Sabbe sovaṇṇayā rukkhā ",
  "tha-ap401:6.2": "nānāgandhā sameritā / ",
  "tha-ap401:6.3": "ujjotanti divā rattiṃ ",
  "tha-ap401:6.4": "bhavanaṃ sabbakālikaṃ. // // ",
  "tha-ap401:7.1": "Saṭṭhiṃ turiyasahassāni ",
  "tha-ap401:7.2": "sāyapāto pavajjare / ",
  "tha-ap401:7.3": "soḷasitthisahassāni ",
  "tha-ap401:7.4": "parivārenti maṃ sadā. // // ",
  "tha-ap401:8.1": "Abhinikkhamma bhavanā ",
  "tha-ap401:8.2": "Sumedhaṃ lokanāyakaṃ / ",
  "tha-ap401:8.3": "pasannacitto sumano ",
  "tha-ap401:8.4": "vandissan taṃ mahāyasaṃ. // // ",
  "tha-ap401:9.1": "Sambuddham abhivādetvā ",
  "tha-ap401:9.2": "sasissaṃ taṃ nimantayiṃ / ",
  "tha-ap401:9.3": "adhivasesi so vīro ",
  "tha-ap401:9.4": "Sumedho lokanāyako. // // ",
  "tha-ap401:10.1": "Mamaṃ dhammakathaṃ katvā ",
  "tha-ap401:10.2": "uyyojesi mahāmuni / ",
  "tha-ap401:10.3": "sambuddham abhivādetvā ",
  "tha-ap401:10.4": "bhavanam me upāgamiṃ. // // ",
  "tha-ap401:11.1": "Āmantayiṃ parijanaṃ ",
  "tha-ap401:11.2": "sabbe sannipatātha vo / ",
  "tha-ap401:11.3": "pubbaṇhasamayaṃ Buddho ",
  "tha-ap401:11.4": "bhavanam āgamissati. // // ",
  "tha-ap401:12.1": "Lābhā amhaṃ suladdhaṃ no ",
  "tha-ap401:12.2": "y' esāma tava sa*ntike* / ",
  "tha-ap401:12.3": "mayam pi buddhaseṭṭhassa ",
  "tha-ap401:12.4": "pūjaṃ karissāma satthuno. // // ",
  "tha-ap401:13.1": "Annaṃ pānaṃ paṭṭhapetvā ",
  "tha-ap401:13.2": "kālam arocayim ahaṃ / ",
  "tha-ap401:13.3": "vasīsatasahassehi ",
  "tha-ap401:13.4": "upesi lokanāyako. // // ",
  "tha-ap401:14.1": "Sataṅgikehi turiyehi ",
  "tha-ap401:14.2": "paccuggaman akās' ",
  "tha-ap401:14.3": "ahaṃ / sabbasovaṇṇaye pīṭhe ",
  "tha-ap401:14.4": "nisīdi purisuttamo. // // ",
  "tha-ap401:15.1": "Uparicchannam akāsiṃ ",
  "tha-ap401:15.2": "sabbasovaṇṇayaṃ tadā / ",
  "tha-ap401:15.3": "vījanīyā pavāyanti ",
  "tha-ap401:15.4": "bhikkhusaṅghassa antare. // // ",
  "tha-ap401:16.1": "Bahuken' annapānena ",
  "tha-ap401:16.2": "bhikkhusaṅgham atappayiṃ. / ",
  "tha-ap401:16.3": "paccekadussayugale ",
  "tha-ap401:16.4": "bhikkhusaṅghass adās' ahaṃ. // // ",
  "tha-ap401:17.1": "Yaṃ vadanti Samedho ti ",
  "tha-ap401:17.2": "lokāhutipaṭiggahaṃ / ",
  "tha-ap401:17.3": "bhikkhusaṅghe nisīditvā ",
  "tha-ap401:17.4": "*imā gāthā abhāsatha:* // // ",
  "tha-ap401:18.1": "Yo me annañ ",
  "tha-ap401:18.2": "ca pānañ ca saṅgham etena tappayi / ",
  "tha-ap401:18.3": "tam ahaṃ kittayissāmi ",
  "tha-ap401:18.4": "suṇotha mama bhāsato: // // ",
  "tha-ap401:19.1": "Aṭṭhārase kappasate ",
  "tha-ap401:19.2": "devaloke ramissati / ",
  "tha-ap401:19.3": "sahassakkhattuṃ rājā ca ",
  "tha-ap401:19.4": "cakkavattī bhavissati. // // ",
  "tha-ap401:20.1": "Upapajjati yaṃ yo*niṃ ",
  "tha-ap401:20.2": "devattam atha mānusaṃ / ",
  "tha-ap401:20.3": "sabbadā* sabbasovaṇṇaṃ ",
  "tha-ap401:20.4": "chadanaṃ dhārayissati. // // ",
  "tha-ap401:21.1": "Tiṃsakappasahassamhi ",
  "tha-ap401:21.2": "Okkākakulasambhavo / ",
  "tha-ap401:21.3": "Gotamo nāma nāmena ",
  "tha-ap401:21.4": "satthā loke bhavissati. // // ",
  "tha-ap401:22.1": "Tassa dhammesu dāyādo ",
  "tha-ap401:22.2": "oraso dhammanimmito / ",
  "tha-ap401:22.3": "sabbāsave pariññāya ",
  "tha-ap401:22.4": "nibbāyissat' anāsavo. // // ",
  "tha-ap401:23.1": "Bhikkhusaṅghe nisīditvā ",
  "tha-ap401:23.2": "sīhanādaṃ nadissati / ",
  "tha-ap401:23.3": "citake chattaṃ dhāreti ",
  "tha-ap401:23.4": "heṭṭhā chattamhi ḍayhatha. // // ",
  "tha-ap401:24.1": "Sāmaññaṃ me anuppattaṃ ",
  "tha-ap401:24.2": "kilesā jhāpitā mayā / ",
  "tha-ap401:24.3": "maṇḍape rukkhamūle vā ",
  "tha-ap401:24.4": "santāpo me na vijjati. // // ",
  "tha-ap401:25.1": "Tiṃsakappasahassamhi ",
  "tha-ap401:25.2": "yaṃ dānam adadiṃ tadā / ",
  "tha-ap401:25.3": "duggatiṃ nābhijānāmi ",
  "tha-ap401:25.4": "sabbadānass' idaṃ phalaṃ. // // ",
  "tha-ap401:26.1": "Kilesā . . . ",
  "tha-ap401:26.2": "pe . . . ",
  "tha-ap401:26.3": "",
  "tha-ap401:27.1": "",
  "tha-ap401:27.2": "pe . . . // // ",
  "tha-ap401:27.3": "Sāgataṃ . . . pe . . . pe . . . // // ",
  "tha-ap401:28.1": "Paṭisambhidā . . . ",
  "tha-ap401:28.2": "pe . . . ",
  "tha-ap401:28.3": "pe . . . // // ",
  "tha-ap401:29.1": "Itthaṃ sudam āyasmā Sabbadāyako thero i. g. a-ti. *Sabbadāyakattherassa apadānaṃ samattaṃ.* ",
  "tha-ap401:30.1": ""
}
