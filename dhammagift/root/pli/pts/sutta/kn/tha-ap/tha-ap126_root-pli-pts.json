  "tha-ap126:0.2": "",
  "tha-ap126:0.3": "",
  "tha-ap126:1.1": "Nisajja pāsādavare ",
  "tha-ap126:1.2": "Vipassiṃ addasaṃ jinaṃ / ",
  "tha-ap126:1.3": "kakudhaṃ vilasantaṃ va ",
  "tha-ap126:1.4": "sabbaññūtam-anāsavaṃ. // // ",
  "tha-ap126:2.1": "Pāsādassāvidūre ca ",
  "tha-ap126:2.2": "gacchati lokanāyako / ",
  "tha-ap126:2.3": "pabhā niddhāvate tassa ",
  "tha-ap126:2.4": "sataraṃsimhi nibbute. // // Gandhodakañ ca ",
  "tha-ap126:3.1": "paggayha ",
  "tha-ap126:3.2": "Buddhaseṭṭhaṃ samokiriṃ / ",
  "tha-ap126:3.3": "tena cittappasādena ",
  "tha-ap126:3.4": "tattha kālakato ahaṃ. // // ",
  "tha-ap126:4.1": "Ekanavute ito kappe ",
  "tha-ap126:4.2": "yaṃ gandhodakaṃ samokiriṃ / ",
  "tha-ap126:4.3": "duggatiṃ nābhijānāmi ",
  "tha-ap126:4.4": "Buddhapūjāy' idaṃ phalaṃ. // // ",
  "tha-ap126:5.1": "Ekatiṃse ito kappe ",
  "tha-ap126:5.2": "Sugandho nāma khattiyo / ",
  "tha-ap126:5.3": "sattaratanasampanno ",
  "tha-ap126:5.4": "cakkavattī mahābalo. // // ",
  "tha-ap126:6.1": "Paṭisambhidā catasso ",
  "tha-ap126:6.2": "vimokhā pi ca aṭṭh' ime / chaḍabhiññā sacchikatā ",
  "tha-ap126:6.3": "kataṃ Buddhassa sāsanan ti. // // ",
  "tha-ap126:7.1": "Itthaṃ sudaṃ āyasmā Gandhodakiyo thero imā gāthāyo abhāsitthā ti. ",
  "tha-ap126:8.1": "Gandhodakiyattherassa apadānaṃ samattaṃ. "
}
