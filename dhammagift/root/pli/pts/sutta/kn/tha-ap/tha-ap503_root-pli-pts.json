{
  "tha-ap503:0.1": "",
  "tha-ap503:0.2": "",
  "tha-ap503:0.3": "",
  "tha-ap503:1.1": "Sumedho nāma sambuddho ",
  "tha-ap503:1.2": "dvattiṃsavaralakkhaṇo / ",
  "tha-ap503:1.3": "vivekakāmo sambuddho ",
  "tha-ap503:1.4": "",
  "tha-ap503:2.1": "Himavantaṃ upāgami. // // Ajjhogahetvā Himavaṃ ",
  "tha-ap503:2.2": "aggo kāruṇiko muni / ",
  "tha-ap503:2.3": "pallaṅkaṃ ābhujitvāna ",
  "tha-ap503:2.4": "nisīdi purisuttamo. // // ",
  "tha-ap503:3.1": "Vijjādharo tadā āsiṃ ",
  "tha-ap503:3.2": "antalikkhacaro ahaṃ / ",
  "tha-ap503:3.3": "tisūlaṃ sukataṃ gayha ",
  "tha-ap503:3.4": "gacchāmi ambare tadā. // // ",
  "tha-ap503:4.1": "Pabbatagge yathā acci puññamāse ",
  "tha-ap503:4.2": "va candimā / ",
  "tha-ap503:4.3": "vane obhāsate Buddho ",
  "tha-ap503:4.4": "sālarājā va phullito. // // ",
  "tha-ap503:5.1": "Vanaggā nikkhamitvāna ",
  "tha-ap503:5.2": "Buddharaṃs' ābhidhāvare / ",
  "tha-ap503:5.3": "nalaggivaṇṇasaṅkāsā ",
  "tha-ap503:5.4": "disvā cittaṃ pasādayiṃ. // // ",
  "tha-ap503:6.1": "Vicinaṃ addasaṃ pupphaṃ ",
  "tha-ap503:6.2": "kaṇikāraṃ devagandhikaṃ / ",
  "tha-ap503:6.3": "tīṇipupphāni ādāya ",
  "tha-ap503:6.4": "Buddhaseṭṭhaṃ apūjayiṃ. // // ",
  "tha-ap503:7.1": "Buddhassa ānubhāvena ",
  "tha-ap503:7.2": "tīṇi pupphāni me tadā / ",
  "tha-ap503:7.3": "uddhavaṇṭā adhopattā ",
  "tha-ap503:7.4": "chāyaṃ kubbanti satthuno. // // ",
  "tha-ap503:8.1": "Tena kammena sukatena ",
  "tha-ap503:8.2": "cetanāpaṇidhīhi ca / ",
  "tha-ap503:8.3": "jahitvā mānusaṃ dehaṃ ",
  "tha-ap503:8.4": "Tāvatiṃsaṃ agacch' ahaṃ. // // ",
  "tha-ap503:9.1": "Tattha me sukataṃ vyamhaṃ ",
  "tha-ap503:9.2": "Kaṇikārīti ñāyati / ",
  "tha-ap503:9.3": "saṭṭhiyojanam ubbiddhaṃ ",
  "tha-ap503:9.4": "tiṃsayojanavitthataṃ. // // ",
  "tha-ap503:10.1": "Sahassakaṇḍo satageṇḍu dhajālu ",
  "tha-ap503:10.2": "haritāmayo / ",
  "tha-ap503:10.3": "satasahassa-niyyūhā ",
  "tha-ap503:10.4": "vyamhe pātubhaviṃsu me. // // ",
  "tha-ap503:11.1": "Sovaṇṇamayā maṇimayā ",
  "tha-ap503:11.2": "lohitaṅkamayā pi ca / ",
  "tha-ap503:11.3": "phalikāpi ca pallaṅkā ",
  "tha-ap503:11.4": "yenicchakā yadicchakā. // // ",
  "tha-ap503:12.1": "Ma*hārahañ ca sayanaṃ ",
  "tha-ap503:12.2": "tū*likāvikatīyutaṃ / ",
  "tha-ap503:12.3": "uddhalomika-ekantaṃ ",
  "tha-ap503:12.4": "bimbohanasamāyutaṃ. // // ",
  "tha-ap503:13.1": "Bhavanā nikkhamitvāna ",
  "tha-ap503:13.2": "caranto devacārikaṃ / ",
  "tha-ap503:13.3": "yadā icchāmi gamanaṃ ",
  "tha-ap503:13.4": "devasaṅghapurakkhato. // // ",
  "tha-ap503:14.1": "Pupphassa heṭṭhā tiṭṭhāmi ",
  "tha-ap503:14.2": "uparicchadanaṃ mama / ",
  "tha-ap503:14.3": "samantā yojanasataṃ ",
  "tha-ap503:14.4": "kanikārehi chāditaṃ. // // ",
  "tha-ap503:15.1": "Saṭṭhituriyasahassāni ",
  "tha-ap503:15.2": "sāyaṃ pātaṃ upaṭṭhahuṃ / ",
  "tha-ap503:15.3": "parivārenti maṃ niccaṃ ",
  "tha-ap503:15.4": "rattindivaṃ atanditā. // // ",
  "tha-ap503:16.1": "Tattha naccehi gītehi ",
  "tha-ap503:16.2": "*tā*lehi vāditehi ca / ",
  "tha-ap503:16.3": "ramāmi khiḍḍāratiyā ",
  "tha-ap503:16.4": "modāmi kāmakāmi 'haṃ. // // ",
  "tha-ap503:17.1": "Tattha bhutvā ca pitvā ca ",
  "tha-ap503:17.2": "modāmi Tidase tadā / ",
  "tha-ap503:17.3": "nārīgaṇehi sahito ",
  "tha-ap503:17.4": "modāmi vyamha-m-uttame. // // ",
  "tha-ap503:18.1": "Satānaṃ pañcakkhattuñ ca ",
  "tha-ap503:18.2": "devarajjam akārayiṃ / ",
  "tha-ap503:18.3": "satānaṃ tīṇikkhattuñ ca ",
  "tha-ap503:18.4": "cakkavatti ahos' ahaṃ. / ",
  "tha-ap503:18.5": "padesarajjaṃ vipulaṃ ",
  "tha-ap503:18.6": "gaṇanāto asaṅkhiyaṃ. // // ",
  "tha-ap503:19.1": "Bhavābhave saṃsaranto ",
  "tha-ap503:19.2": "mahābhoge labhām' ahaṃ. / ",
  "tha-ap503:19.3": "bhoge me ūnatā n' atthi ",
  "tha-ap503:19.4": "Buddhapūjāy' idaṃ phalaṃ. // // ",
  "tha-ap503:20.1": "Duve bhave saṃsarāmi ",
  "tha-ap503:20.2": "devatte atha mānuse / ",
  "tha-ap503:20.3": "aññaṃ gatiṃ na jānāmi ",
  "tha-ap503:20.4": "Buddhapūjāy' idaṃ phalaṃ. // // ",
  "tha-ap503:21.1": "Duve kule pajāyāmi ",
  "tha-ap503:21.2": "khattiye cāpi brāhmaṇe / ",
  "tha-ap503:21.3": "nīce kule na jānāmi ",
  "tha-ap503:21.4": "Buddhapūjāy' idaṃ phalaṃ. // // ",
  "tha-ap503:22.1": "Hatthiyānaṃ assayānaṃ ",
  "tha-ap503:22.2": "sivikaṃ sandamānikaṃ / ",
  "tha-ap503:22.3": "labhāmi sabbam ev' etaṃ ",
  "tha-ap503:22.4": "Buddhapūjāy' idaṃ phalaṃ. // // ",
  "tha-ap503:23.1": "Dāsīgaṇaṃ dāsagaṇaṃ ",
  "tha-ap503:23.2": "nāriyo ca alaṅkatā / ",
  "tha-ap503:23.3": "labhāmi sabbam ev' etaṃ ",
  "tha-ap503:23.4": "Buddhapūjāy' idaṃ phalaṃ. // // ",
  "tha-ap503:24.1": "Koseyyakambalīyāni ",
  "tha-ap503:24.2": "khomakappāsikāni ca / ",
  "tha-ap503:24.3": "labhāmi sabbam ev' etaṃ . . . ",
  "tha-ap503:24.4": "pe . . . pe . . . // // ",
  "tha-ap503:25.1": "Navavatthaṃ navaphalaṃ ",
  "tha-ap503:25.2": "nav'-agga-rasa-bhojanaṃ / ",
  "tha-ap503:25.3": "labhāmi . . . pe . . . ",
  "tha-ap503:25.4": "pe . . . pe . . . // // ",
  "tha-ap503:26.1": "Ime khāda ime bhuñja ",
  "tha-ap503:26.2": "imamhi sayane saya / ",
  "tha-ap503:26.3": "labhāmi . . . pe . . . ",
  "tha-ap503:26.4": "pe . . . pe . . . // // ",
  "tha-ap503:27.1": "Sabbattha pūjito homi ",
  "tha-ap503:27.2": "yaso accuggato mama / ",
  "tha-ap503:27.3": "mahāpakkho sadā homi ",
  "tha-ap503:27.4": "abhejjapariso tadā. / ",
  "tha-ap503:27.5": "ñātīnaṃ uttamo homi ",
  "tha-ap503:27.6": "Buddhapūjāy' idaṃ phalaṃ. // // ",
  "tha-ap503:28.1": "Sītaṃ uṇhaṃ na jānāmi ",
  "tha-ap503:28.2": "pariḷāho na vijjati / ",
  "tha-ap503:28.3": "atho cetasikaṃ dukkhaṃ ",
  "tha-ap503:28.4": "hadaye me na vijjati. // // ",
  "tha-ap503:29.1": "Suvaṇṇavaṇṇo hutvāna ",
  "tha-ap503:29.2": "saṃsarāmi bhavābhave / ",
  "tha-ap503:29.3": "duvaṇṇikaṃ na jānāmi ",
  "tha-ap503:29.4": "Buddhapūjāy' idaṃ phalaṃ. // // ",
  "tha-ap503:30.1": "Devalokā cavitvāna ",
  "tha-ap503:30.2": "sukkamūlena codito / ",
  "tha-ap503:30.3": "Savatthiyaṃ pure jāto ",
  "tha-ap503:30.4": "mahāsāle su-aḍḍhake. // // ",
  "tha-ap503:31.1": "Pañcakāmaguṇe hitvā ",
  "tha-ap503:31.2": "pabbajiṃ anagāriyaṃ / ",
  "tha-ap503:31.3": "jātiyā sattavasso 'va ",
  "tha-ap503:31.4": "arahattaṃ apāpuṇiṃ. // // ",
  "tha-ap503:32.1": "upasampādayī Buddho ",
  "tha-ap503:32.2": "guṇaṃ aññāya cakkhumā / ",
  "tha-ap503:32.3": "taruṇo pūjanīyo 'haṃ ",
  "tha-ap503:32.4": "Buddhapūjāy' idaṃ phalaṃ. // // ",
  "tha-ap503:33.1": "Dibbaṃ cakkhuṃ visuddham me ",
  "tha-ap503:33.2": "samādhikusalo ahaṃ / ",
  "tha-ap503:33.3": "abhiññāpāramippatto ",
  "tha-ap503:33.4": "Buddhapūjāy' idaṃ phalaṃ. // // ",
  "tha-ap503:34.1": "Paṭisambhidā anuppatto ",
  "tha-ap503:34.2": "iddhipādesu kovido / ",
  "tha-ap503:34.3": "saddhamme pāramippatto ",
  "tha-ap503:34.4": "Buddhapūjāy' idaṃ phalaṃ. // // ",
  "tha-ap503:35.1": "Tiṃsakappasahassamhi ",
  "tha-ap503:35.2": "yaṃ Buddham abhipūjayiṃ / ",
  "tha-ap503:35.3": "duggatiṃ nābhijānāmi ",
  "tha-ap503:35.4": "Buddhapūjāy' idaṃ phalaṃ. // // ",
  "tha-ap503:36.1": "Kilesā . . . pe . . . ",
  "tha-ap503:36.2": "pe . . . ",
  "tha-ap503:36.3": "pe . . . // // ",
  "tha-ap503:36.4": "Sāgataṃ . . . ",
  "tha-ap503:37.1": "pe . . . ",
  "tha-ap503:37.2": "pe . . . ",
  "tha-ap503:37.3": "pe . . . // // ",
  "tha-ap503:37.4": "",
  "tha-ap503:38.1": "Paṭisambhidā . . . pe . . . ",
  "tha-ap503:38.2": "pe . . . ",
  "tha-ap503:38.3": "",
  "tha-ap503:38.4": "pe . . . // // ",
  "tha-ap503:39.1": "Itthaṃ sudaṃ āyasmā Tīṇikaṇikārapupphiyo th. i. g. a-ti. Tīṇikaṇikārapupphiyattherassa apadānaṃ samattaṃ. ",
  "tha-ap503:40.1": ""
}
