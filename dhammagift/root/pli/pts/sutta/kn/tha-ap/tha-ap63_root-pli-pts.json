  "tha-ap63:0.3": "",
  "tha-ap63:1.1": "Pavanaṃ kānanaṃ disvā ",
  "tha-ap63:1.2": "a*ppasaddaṃ a*nāvilaṃ / ",
  "tha-ap63:1.3": "isīnaṃ anuciṇṇaṃ va ",
  "tha-ap63:1.4": "āhutīnaṃ paṭiggahaṃ // // ",
  "tha-ap63:2.1": "Thūpaṃ katvāna veḷūnaṃ ",
  "tha-ap63:2.2": "nānāpupphaṃ samokiriṃ / ",
  "tha-ap63:2.3": "sammukhā viya sambuddhaṃ ",
  "tha-ap63:2.4": "nimmitaṃ abhivandi 'haṃ. // // ",
  "tha-ap63:3.1": "Sattaratanasampanno ",
  "tha-ap63:3.2": "rājā raṭṭhasmiṃ issaro / ",
  "tha-ap63:3.3": "sakakammābhiraddho 'haṃ thūpapūjāy' ",
  "tha-ap63:3.4": "idaṃ phalaṃ. // // ",
  "tha-ap63:4.1": "Ekanavute ito kappe ",
  "tha-ap63:4.2": "yaṃ puppham abhiropayiṃ / ",
  "tha-ap63:4.3": "duggatiṃ nābhijānāmi ",
  "tha-ap63:4.4": "thūpapūjāy' idaṃ phalaṃ. // // ",
  "tha-ap63:5.1": "Asītikappen' antayaso ",
  "tha-ap63:5.2": "cakkavatti ahos' ahaṃ / ",
  "tha-ap63:5.3": "sattaratanasampanno ",
  "tha-ap63:5.4": "*catudīpamhi issaro* // // ",
  "tha-ap63:6.1": "Paṭisambhidā catasso ",
  "tha-ap63:6.2": "vimokhā pi ca aṭṭh' ime / ",
  "tha-ap63:6.3": "chaḷabhiññā sacchikatā ",
  "tha-ap63:6.4": "kataṃ Buddhassa sāsanan ti. // // ",
  "tha-ap63:7.1": "Itthaṃ sudaṃ āyasmā Sakacittaniyo thero imā gāthāyo abhāsitthā ti. Sakacittaniyatherassa apadānaṃ samattaṃ. ",
  "tha-ap63:8.1": ""
}
