  "tha-ap549:0.3": "",
  "tha-ap549:1.1": "Padumuttaro nāma jino ",
  "tha-ap549:1.2": "sabbadhammesu cakkhumā / ",
  "tha-ap549:1.3": "ito satasahassamhi ",
  "tha-ap549:1.4": "kappe uppajji nāyako. // // ",
  "tha-ap549:2.1": "Saraṇāgamane kañci ",
  "tha-ap549:2.2": "nivesesi Tathāgato / ",
  "tha-ap549:2.3": "kañci sīle nivesesi ",
  "tha-ap549:2.4": "dasakammapathuttame. // // ",
  "tha-ap549:3.1": "Deti kassaci so vīro ",
  "tha-ap549:3.2": "sāmaññaphalam uttamaṃ / ",
  "tha-ap549:3.3": "samāpattī tathā aṭṭha ",
  "tha-ap549:3.4": "tisso vijjā pavecchati. // // ",
  "tha-ap549:4.1": "Chalabhiññāsu yojeti ",
  "tha-ap549:4.2": "kañci sattaṃ naruttamo / ",
  "tha-ap549:4.3": "deti kassaci so nātho ",
  "tha-ap549:4.4": "catasso paṭisambhidā. // // ",
  "tha-ap549:5.1": "Bodhaneyyaṃ pajaṃ disvā ",
  "tha-ap549:5.2": "asaṅkheyye 'pi yojane / ",
  "tha-ap549:5.3": "khaṇena upagantvāna ",
  "tha-ap549:5.4": "vineti narasārathi. // // ",
  "tha-ap549:6.1": "Tadā 'haṃ Haṃsavatiyā ",
  "tha-ap549:6.2": "ahosiṃ brāhmaṇatrajo / ",
  "tha-ap549:6.3": "pāragū sabbavedānaṃ ",
  "tha-ap549:6.4": "veyyākaraṇasammato, // // ",
  "tha-ap549:7.1": "Niruttiyā ca kusalo ",
  "tha-ap549:7.2": "nighaṇṭe ca visārado / ",
  "tha-ap549:7.3": "padako keṭubhavidū ",
  "tha-ap549:7.4": "chandovicitikovido. // // ",
  "tha-ap549:8.1": "Jaṅghāvihāraṃ vicaraṃ ",
  "tha-ap549:8.2": "Haṃsārāmam upecc' ahaṃ / ",
  "tha-ap549:8.3": "addasaṃ vadataṃ seṭṭhaṃ ",
  "tha-ap549:8.4": "mahājana-purakkhataṃ // // ",
  "tha-ap549:9.1": "Desentaṃ virajaṃ dhammaṃ ",
  "tha-ap549:9.2": "paccanīka-matī ahaṃ / ",
  "tha-ap549:9.3": "upetvā tassa vākyāni ",
  "tha-ap549:9.4": "sutvāna vimalān' ahaṃ. // // ",
  "tha-ap549:10.1": "Vyāhaṭaṃ puna-r-uttañ ca ",
  "tha-ap549:10.2": "apatthaṃ 'va niratthakaṃ / ",
  "tha-ap549:10.3": "nāddasaṃ tassa munino ",
  "tha-ap549:10.4": "tato pabbajito ahaṃ. // // ",
  "tha-ap549:11.1": "Naciren' eva kālena ",
  "tha-ap549:11.2": "sabbasatthavisārado / ",
  "tha-ap549:11.3": "nipuṇe Buddhavacane ",
  "tha-ap549:11.4": "ahosiṃ gaṇisammato. // // ",
  "tha-ap549:12.1": "Tadā catasso gāthāyo ",
  "tha-ap549:12.2": "ganthavitvā suvyañjanā / ",
  "tha-ap549:12.3": "santhavitvā tilokaggaṃ ",
  "tha-ap549:12.4": "desayissaṃ dine dine: // // ",
  "tha-ap549:13.1": "\"Viratto si mahāvīro ",
  "tha-ap549:13.2": "saṃsāre sabhaye vasan / ",
  "tha-ap549:13.3": "karuṇāya na nibbāyi ",
  "tha-ap549:13.4": "tato kāruṇiko muni. // // ",
  "tha-ap549:14.1": "Puthujjano 'va yo satto ",
  "tha-ap549:14.2": "na kilesavaso ahu / ",
  "tha-ap549:14.3": "sampajāno satiyutto ",
  "tha-ap549:14.4": "tasmā eso acintiyo. // // ",
  "tha-ap549:15.1": "Dubbalāni kilesāni ",
  "tha-ap549:15.2": "yassa sayakatāni me / ",
  "tha-ap549:15.3": "ñāṇaggiparidaḍḍhāni ",
  "tha-ap549:15.4": "na khīyisu tadabbhutaṃ. // // ",
  "tha-ap549:16.1": "Yo sabbalokassa guru ",
  "tha-ap549:16.2": "loko yassa tathā guru / ",
  "tha-ap549:16.3": "tathāpi lokacariyā ",
  "tha-ap549:16.4": "loko tassānuvattako\". // // ",
  "tha-ap549:17.1": "Evamādīhi yaṃ Buddhaṃ ",
  "tha-ap549:17.2": "kittayaṃ dhammadesakaṃ / ",
  "tha-ap549:17.3": "yāvajīvaṃ karitvāna ",
  "tha-ap549:17.4": "gato saggaṃ tato cuto. // // ",
  "tha-ap549:18.1": "Satasahasse ito kappe ",
  "tha-ap549:18.2": "yaṃ Buddhaṃ abhikittayiṃ / ",
  "tha-ap549:18.3": "duggatiṃ nābhijānāmi ",
  "tha-ap549:18.4": "kittanāya idaṃ phalaṃ. // // ",
  "tha-ap549:19.1": "Devaloke mahārajjaṃ ",
  "tha-ap549:19.2": "rajjapādesikañ ca yaṃ / ",
  "tha-ap549:19.3": "cakkavatti mahārajjaṃ ",
  "tha-ap549:19.4": "bahuso 'nubhaviṃ ahaṃ. // // ",
  "tha-ap549:20.1": "Duve bhave pajāyāmi ",
  "tha-ap549:20.2": "devatte atha mānuse / ",
  "tha-ap549:20.3": "aññaṃ gatiṃ na jānāmi ",
  "tha-ap549:20.4": "kittanāya idaṃ phalaṃ. // // ",
  "tha-ap549:21.1": "Duve kule pajāyāmi ",
  "tha-ap549:21.2": "khattiye atha brāhmaṇe / ",
  "tha-ap549:21.3": "nīce kule na jānāmi ",
  "tha-ap549:21.4": "kittanāya idaṃ phalaṃ. // // ",
  "tha-ap549:22.1": "Pacchime ca bhave dāni ",
  "tha-ap549:22.2": "Giribbaja-puruttame / ",
  "tha-ap549:22.3": "rañño *'haṃ Bimbisā*rassa ",
  "tha-ap549:22.4": "putto nāmena c' Ābhayo. // // ",
  "tha-ap549:23.1": "Pāpamittavasaṃ gantvā ",
  "tha-ap549:23.2": "Nigaṇṭhena vimohito / ",
  "tha-ap549:23.3": "pesito Nāṭaputtena ",
  "tha-ap549:23.4": "Buddhaseṭṭhaṃ upecc ahaṃ. // // ",
  "tha-ap549:24.1": "Pucchitvā nipuṇaṃ pañhaṃ ",
  "tha-ap549:24.2": "sutvā vyākaraṇ-uttamaṃ / ",
  "tha-ap549:24.3": "pabbajitvāna naciraṃ ",
  "tha-ap549:24.4": "arahattaṃ apāpuṇiṃ. // // ",
  "tha-ap549:25.1": "Kittayitvā jinavaraṃ ",
  "tha-ap549:25.2": "kittito homi sabbadā / ",
  "tha-ap549:25.3": "sugandhadehavadano ",
  "tha-ap549:25.4": "āsiṃ sukhasamappito. // // ",
  "tha-ap549:26.1": "Tikkha-hāsa-lahu-pañño ",
  "tha-ap549:26.2": "mahāpañño tath' ev' ahaṃ / ",
  "tha-ap549:26.3": "vicittapaṭibhāno ca ",
  "tha-ap549:26.4": "tassa kammassa vāhasā. // // ",
  "tha-ap549:27.1": "AbhitthavitvāPadumuttarāhaṃ ",
  "tha-ap549:27.2": "pasannacitto asamaṃ sayambhuṃ / ",
  "tha-ap549:27.3": "Nāgacchi kappāni apāyabhūmiṃ ",
  "tha-ap549:27.4": "satasahassāni phalena tassa. // // ",
  "tha-ap549:28.1": "Kilesā. . . ",
  "tha-ap549:28.2": "pe . . . ",
  "tha-ap549:28.3": "",
  "tha-ap549:29.1": "",
  "tha-ap549:29.2": "pe . . . ",
  "tha-ap549:29.3": "pe . . . // // Sāgataṃ. . . pe . . . pe . . . pe . . . // // ",
  "tha-ap549:30.1": "Paṭisambhidā. . . ",
  "tha-ap549:30.2": "pe . . . ",
  "tha-ap549:30.3": "pe . . . pe . . . // // ",
  "tha-ap549:31.1": "Itthaṃ sudaṃ āyasmā Abhayo thero i. g. a-ti. Abhayattherassa ",
  "tha-ap549:32.1": "apadānaṃ samattaṃ. Imamhibhaddake "
}
