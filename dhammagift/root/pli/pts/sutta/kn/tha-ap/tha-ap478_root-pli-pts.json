  "tha-ap478:1.1": "Kassapassa bhagavato ",
  "tha-ap478:1.2": "brāhmaṇassa vusīmato / ",
  "tha-ap478:1.3": "pasannacitto sumano ",
  "tha-ap478:1.4": "kusaṭṭhakam adās' ahaṃ. // // ",
  "tha-ap478:2.1": "Imasmiṃ yeva kappasmiṃ ",
  "tha-ap478:2.2": "kasaṭṭhakam adās' ahaṃ / ",
  "tha-ap478:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap478:2.4": "kusaṭṭhakass' idaṃ phalaṃ. // // ",
  "tha-ap478:3.1": "Kilesā . . . ",
  "tha-ap478:3.2": "pe . . . ",
  "tha-ap478:3.3": "",
  "tha-ap478:4.1": "",
  "tha-ap478:4.2": "pe . . . ",
  "tha-ap478:4.3": "pe . . . // // Sāgataṃ . . . pe . . . pe . . . pe . . . // // ",
  "tha-ap478:5.1": "Paṭisambhidā . . . ",
  "tha-ap478:5.2": "pe . . . ",
  "tha-ap478:5.3": "pe . . . pe . . . // // ",
  "tha-ap478:6.1": "Itthaṃ sudam āyasmā Kusaṭṭhakadāyako th. i. g. a-ti. Kusaṭṭhadāyakattherassa apadānaṃ samattaṃ. ",
  "tha-ap478:7.1": ""
}
