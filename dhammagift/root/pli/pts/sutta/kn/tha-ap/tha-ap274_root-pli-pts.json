  "tha-ap274:0.3": "",
  "tha-ap274:1.1": "Mama saṅkappam aññāya ",
  "tha-ap274:1.2": "satthā lokagganāyako / ",
  "tha-ap274:1.3": "manomayena kāyena ",
  "tha-ap274:1.4": "iddhiyā upasaṅkami. // // ",
  "tha-ap274:2.1": "Satthāram upasaṅkantaṃ ",
  "tha-ap274:2.2": "vanditvā purisuttamaṃ / ",
  "tha-ap274:2.3": "pasannacitto sumano ",
  "tha-ap274:2.4": "tilamuṭṭhim adās' ahaṃ. // // Ekanavute ",
  "tha-ap274:3.1": "ito kappe ",
  "tha-ap274:3.2": "yaṃ dānam adadiṃ tadā / ",
  "tha-ap274:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap274:3.4": "tilamuṭṭhe idaṃ phalaṃ. // // ",
  "tha-ap274:4.1": "Ito soḷasakappamhi ",
  "tha-ap274:4.2": "Nandiyo nāma khattiyo / ",
  "tha-ap274:4.3": "sattaratanasampanno ",
  "tha-ap274:4.4": "cakkavattī mahabbalo. // // ",
  "tha-ap274:5.1": "Paṭisambhidā . . . ",
  "tha-ap274:5.2": "pe . . . ",
  "tha-ap274:5.3": "pe . . . // // ",
  "tha-ap274:6.1": "Itthaṃ sudam āyasmā Tilamuṭṭhidāyako thero i. g. a-ti. Tilamuṭṭhidāyakattherassa ",
  "tha-ap274:7.1": "apadānaṃ samattaṃ. "
}
