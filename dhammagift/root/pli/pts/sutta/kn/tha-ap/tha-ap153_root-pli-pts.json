  "tha-ap153:0.3": "",
  "tha-ap153:1.1": "vimalaṃ suddhaṃ ",
  "tha-ap153:1.2": "vippasannam anāvilaṃ / ",
  "tha-ap153:1.3": "nandibhavaparikkhīṇaṃ ",
  "tha-ap153:1.4": "tiṇṇaṃ lokavisattikaṃ -- // // ",
  "tha-ap153:2.1": "Nibbāpayantaṃ janataṃ ",
  "tha-ap153:2.2": "tiṇṇaṃ tārayataṃ ",
  "tha-ap153:2.3": "muṇiṃ / vanasmiṃ jhāyamānan tam ",
  "tha-ap153:2.4": "ekaggaṃ susamāhitaṃ. // // ",
  "tha-ap153:3.1": "Bandhujīvakapupphāni ",
  "tha-ap153:3.2": "laggetvā suttake ahaṃ / ",
  "tha-ap153:3.3": "Buddhassa abhiropesiṃ ",
  "tha-ap153:3.4": "Sikhino lokabandhuno. // // ",
  "tha-ap153:4.1": "Ekatiṃse ito kappe ",
  "tha-ap153:4.2": "yaṃ kammam akariṃ tada / ",
  "tha-ap153:4.3": "duggatiṃ nābhijānāmi ",
  "tha-ap153:4.4": "Buddhapūjāy' idaṃ phalaṃ. // // ",
  "tha-ap153:5.1": "Ito sattamake kappe ",
  "tha-ap153:5.2": "manujindo mahāyaso / ",
  "tha-ap153:5.3": "Samantacakkhu nām' āsiṃ ",
  "tha-ap153:5.4": "cakkavattī mahābalo. // // ",
  "tha-ap153:6.1": "Paṭisambhidā . . . pe . . . ",
  "tha-ap153:6.2": "",
  "tha-ap153:6.3": "pe . . . // // ",
  "tha-ap153:6.4": "",
  "tha-ap153:7.1": "Itthaṃ sudaṃ ā. Bandhujīvako thero i. g. a-ti. Bandhujīvakattherassa ",
  "tha-ap153:8.1": "apadānaṃ samattaṃ. "
}
