  "tha-ap502:1.1": "Migaluddo pure āsiṃ ",
  "tha-ap502:1.2": "vīcine vicaran tadā / ",
  "tha-ap502:1.3": "addasaṃ virajaṃ Buddhaṃ ",
  "tha-ap502:1.4": "sabbadhammāna pāraguṃ. // // ",
  "tha-ap502:2.1": "Piyālaphalam ādāya ",
  "tha-ap502:2.2": "Buddhaseṭṭhass' adās' ahaṃ / ",
  "tha-ap502:2.3": "puññakkhettassa vīrassa ",
  "tha-ap502:2.4": "pasanno sehi pāṇihi. // // ",
  "tha-ap502:3.1": "Ekatiṃse ito kappe ",
  "tha-ap502:3.2": "yaṃ phalaṃ adadiṃ tadā / ",
  "tha-ap502:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap502:3.4": "phaladānass' idaṃ phalaṃ. // // ",
  "tha-ap502:4.1": "Kilesā . . . ",
  "tha-ap502:4.2": "pe . . . ",
  "tha-ap502:4.3": "",
  "tha-ap502:5.1": "",
  "tha-ap502:5.2": "pe . . . ",
  "tha-ap502:5.3": "pe . . . // // Sāgataṃ . . . pe . . . pe . . . pe . . . // // ",
  "tha-ap502:6.1": "Paṭisambhidā . . . ",
  "tha-ap502:6.2": "pe . . . ",
  "tha-ap502:6.3": "pe . . . pe . . . // // ",
  "tha-ap502:7.1": "Itthaṃ sudaṃ āyasmā Piyālaphaladāyako th. i. g. a- ti. Piyālaphaladāyakattherassa ",
  "tha-ap502:8.1": "",
  "tha-ap502:8.2": "apadānaṃ samattaṃ. ",
  "tha-ap502:9.1": "Uddānaṃ: ",
  "tha-ap502:10.1": "Kiṅkhani-Paṃsukūlañ ca ",
  "tha-ap502:10.2": "Koraṇḍapupphi Kiṃsukhaṃ ",
  "tha-ap502:10.3": "Upaḍḍhadussī Ghatado ",
  "tha-ap502:10.4": "Udakaṃ-Thūpakārako ",
  "tha-ap502:11.1": "Naḷāgārī ca navamo ",
  "tha-ap502:11.2": "Piyālaphaladāyako ",
  "tha-ap502:11.3": "sataṃ ekañ ca gāthānaṃ ",
  "tha-ap502:11.4": "navakañ ca taduttariṃ. ",
  "tha-ap502:12.1": "Atha vaggUddānaṃ: ",
  "tha-ap502:13.1": "Metteyya-Bhaddālivaggo ",
  "tha-ap502:13.2": "Sakiṃsammajjako pi ca ",
  "tha-ap502:13.3": "eko Vibheṭakī vaggo ",
  "tha-ap502:13.4": "Jagati Sālapupphiyo ",
  "tha-ap502:14.1": "Naḷamālaṃ Paṃsukūlaṃ ",
  "tha-ap502:14.2": "Kiṅkhaṇipupphiyo tadā ",
  "tha-ap502:14.3": "asīti dve ca gāthāyo ",
  "tha-ap502:14.4": "catuddasasatāni ca. ",
  "tha-ap502:15.1": "",
  "tha-ap502:16.1": ""
}
