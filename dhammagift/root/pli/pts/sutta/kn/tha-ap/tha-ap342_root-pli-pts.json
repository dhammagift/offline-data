  "tha-ap342:1.1": "Nagare Haṃsavatiyā ",
  "tha-ap342:1.2": "āhosiṃ māliko tadā / ",
  "tha-ap342:1.3": "ogahetvā padumasaraṃ ",
  "tha-ap342:1.4": "satapatte ocinām' ahaṃ. // // ",
  "tha-ap342:2.1": "Padumuttaro nāma jino ",
  "tha-ap342:2.2": "sabbadhammāna pāragū / ",
  "tha-ap342:2.3": "sahasatasahassehi ",
  "tha-ap342:2.4": "santacittehi tādihi // // ",
  "tha-ap342:3.1": "Khīṇāsavehi suddhehi ",
  "tha-ap342:3.2": "chaḷābhiññāhi so saha / ",
  "tha-ap342:3.3": "mama vuddhiṃ samannesaṃ ",
  "tha-ap342:3.4": "āgacchi purisuttamo. // // ",
  "tha-ap342:4.1": "Disvān' ahaṃ devadevan ",
  "tha-ap342:4.2": "sayambhuṃ lokanāyakaṃ / ",
  "tha-ap342:4.3": "vaṇṭe chetvā satapattam ",
  "tha-ap342:4.4": "ukkhipim ambare tadā: // // ",
  "tha-ap342:5.1": "‘Yadi Buddho tuvaṃ vīra ",
  "tha-ap342:5.2": "lokajeṭṭho narāsabho / ",
  "tha-ap342:5.3": "sayaṃ gantvā satapattā ",
  "tha-ap342:5.4": "matthake dhārayantu te.' // // ",
  "tha-ap342:6.1": "Adhiṭṭhahi mahāvīro ",
  "tha-ap342:6.2": "lokajeṭṭho narāsabho / ",
  "tha-ap342:6.3": "Buddhassa ānubhāvena ",
  "tha-ap342:6.4": "matthake dhārayiṃsu te. // // ",
  "tha-ap342:7.1": "Tena kammena sukatena ",
  "tha-ap342:7.2": "cetanāpaṇidhīhi ca / ",
  "tha-ap342:7.3": "jahitvā mānusaṃ dehaṃ ",
  "tha-ap342:7.4": "Tāvatiṃsam agacch' ahaṃ. // // ",
  "tha-ap342:8.1": "Tattha me sukataṃ vyamhaṃ ",
  "tha-ap342:8.2": "Satapattan ti vuccati / ",
  "tha-ap342:8.3": "saṭṭhiyojanamubbiddhaṃ ",
  "tha-ap342:8.4": "tiṃsayojanavitthataṃ. // // ",
  "tha-ap342:9.1": "Sahassakkhattuṃ devindo ",
  "tha-ap342:9.2": "devarajjam akārayiṃ / ",
  "tha-ap342:9.3": "pañcasattatikkhattuñ ca ",
  "tha-ap342:9.4": "cakkavattī ahos' ahaṃ // // ",
  "tha-ap342:10.1": "Padesarajjaṃ vipulaṃ ",
  "tha-ap342:10.2": "gaṇanāto asaṅkhiyaṃ / ",
  "tha-ap342:10.3": "anubhomi sakaṃ kammaṃ ",
  "tha-ap342:10.4": "pubbe sukatam attano // // Ten' eva ",
  "tha-ap342:11.1": "ekapadumena ",
  "tha-ap342:11.2": "anubhotvāna sampadā / ",
  "tha-ap342:11.3": "Gotamassa bhagavato ",
  "tha-ap342:11.4": "dhammaṃ sacchikarim ahaṃ. // // ",
  "tha-ap342:12.1": "Kilesā jhāpitā mayhaṃ ",
  "tha-ap342:12.2": "bhavā sabbe samūhatā / ",
  "tha-ap342:12.3": "nāgo va bandhanaṃ chetvā ",
  "tha-ap342:12.4": "viharāmi anāsavo. // // ",
  "tha-ap342:13.1": "Satasahasse ito kappe ",
  "tha-ap342:13.2": "yaṃ puppham abhipūjayiṃ / ",
  "tha-ap342:13.3": "duggatiṃ nābhijānāmi ",
  "tha-ap342:13.4": "ekapadumass' idaṃ phalaṃ. // // ",
  "tha-ap342:14.1": "Paṭisambhidā . . . ",
  "tha-ap342:14.2": "pe . . . ",
  "tha-ap342:14.3": "pe . . . // // ",
  "tha-ap342:15.1": "Itthaṃ sudam āyasmā Ukkhittapadumiyo thero i. g. a-ti. ",
  "tha-ap342:16.1": "Ukkhittapadumiyattherassa apadānaṃ ",
  "tha-ap342:17.1": "samattaṃ. Uddānaṃ: ",
  "tha-ap342:18.1": "Gandhodaka- ",
  "tha-ap342:19.1": "Pūjanī ca ",
  "tha-ap342:19.2": "Punnāga-Ekadussikā ",
  "tha-ap342:19.3": "Phusito ca Pabhaṅkāro ",
  "tha-ap342:19.4": "Kuṭido Uttarīyako. ",
  "tha-ap342:20.1": "Savanī Ekapadumī ",
  "tha-ap342:20.2": "gāthāyo tattha piṇḍitā ",
  "tha-ap342:20.3": "ekaṃ gāthāsatañ c' eva ",
  "tha-ap342:20.4": "catu*tālīsa*meva ca. "
}
