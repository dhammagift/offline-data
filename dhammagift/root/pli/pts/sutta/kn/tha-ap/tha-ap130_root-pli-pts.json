  "tha-ap130:0.1": "",
  "tha-ap130:0.2": "",
  "tha-ap130:0.3": "",
  "tha-ap130:1.1": "Pabbate Himavantamhi ",
  "tha-ap130:1.2": "vasāmi pabbatantare / ",
  "tha-ap130:1.3": "puḷinaṃ sobhanaṃ disvā ",
  "tha-ap130:1.4": "Buddhaseṭṭhaṃ anussariṃ. // // ",
  "tha-ap130:2.1": "Ñāṇe upanidhā n' atthi ",
  "tha-ap130:2.2": "saṅgāmaṃ n' atthi satthuno / ",
  "tha-ap130:2.3": "sabbaṃ dhammaṃ abhiññāya ",
  "tha-ap130:2.4": "ñāṇena adhimuccati. // // ",
  "tha-ap130:3.1": "Namo te purisājañña, ",
  "tha-ap130:3.2": "nāmo te purisuttama! / ",
  "tha-ap130:3.3": "ñāṇena te samo n' atthi ",
  "tha-ap130:3.4": "yāvatā ñāṇa-m-uttame. // // ",
  "tha-ap130:4.1": "Ñāṇe cittaṃ pasādetvā ",
  "tha-ap130:4.2": "kappam saggamhi mod' ahaṃ / ",
  "tha-ap130:4.3": "avasesesu kappesu ",
  "tha-ap130:4.4": "kusalaṃ kāritaṃ mayā. // // ",
  "tha-ap130:5.1": "Ekanavute ito kappe ",
  "tha-ap130:5.2": "yaṃ saññam alabhiṃ tadā / ",
  "tha-ap130:5.3": "duggatiṃ nābhijānāmi ",
  "tha-ap130:5.4": "ñāṇasaññāy' idaṃ phalaṃ. // // ",
  "tha-ap130:6.1": "Ito tesattati kappe ",
  "tha-ap130:6.2": "eko Puḷinapupphiyo / ",
  "tha-ap130:6.3": "sattaratanasampanno ",
  "tha-ap130:6.4": "cakkavattī mahābalo. // // ",
  "tha-ap130:7.1": "Paṭisambhidā . . . ",
  "tha-ap130:7.2": "pe . . . ",
  "tha-ap130:7.3": "pe . . . // // ",
  "tha-ap130:8.1": "Itthaṃ sudaṃ āyasmā Ñāṇasaññako thero imā gāthāyo abhāsitthā ti. ",
  "tha-ap130:9.1": "Ñāṇasaññakattherassa apadānaṃ samattaṃ. "
}
