  "tha-ap451:1.1": "",
  "tha-ap451:1.2": "bodhiyā pāda-m- ",
  "tha-ap451:1.3": "uttame / vediyaṃ sukataṃ katvā ",
  "tha-ap451:1.4": "sakaṃ cittaṃ pasādiyiṃ. // // ",
  "tha-ap451:2.1": "*Atholārāṇi* bhaṇḍāni ",
  "tha-ap451:2.2": "katāni akatāni ca / ",
  "tha-ap451:2.3": "antalikkhā pavassanti ",
  "tha-ap451:2.4": "vedikāya-m-idaṃ phalaṃ. // // ",
  "tha-ap451:3.1": "Ubhato byūḷhasaṅgāme ",
  "tha-ap451:3.2": "pakkhandanto bhayānake / ",
  "tha-ap451:3.3": "bhayabheravaṃ na passāmi ",
  "tha-ap451:3.4": "vedikāya idaṃ phalaṃ. // // ",
  "tha-ap451:4.1": "Mama saṅkappam aññāya ",
  "tha-ap451:4.2": "vyamhaṃ nibbattate subhaṃ / ",
  "tha-ap451:4.3": "sayanāni mahagghāni ",
  "tha-ap451:4.4": "vedikāya idaṃ phalaṃ. // // ",
  "tha-ap451:5.1": "Satasahasse ito kappe ",
  "tha-ap451:5.2": "yaṃ vedikam akārayiṃ / ",
  "tha-ap451:5.3": "duggatiṃ nābhijānāmi ",
  "tha-ap451:5.4": "vedikāya idaṃ phalaṃ. // // ",
  "tha-ap451:6.1": "Kilesā . . . ",
  "tha-ap451:6.2": "pe . . . ",
  "tha-ap451:6.3": "",
  "tha-ap451:7.1": "",
  "tha-ap451:7.2": "pe . . . ",
  "tha-ap451:7.3": "pe . . . // // Sāgataṃ . . . pe . . . pe . . . pe . . . // // ",
  "tha-ap451:8.1": "Paṭisambhidā . . . ",
  "tha-ap451:8.2": "pe . . . ",
  "tha-ap451:8.3": "pe . . . pe . . . // // ",
  "tha-ap451:9.1": "Itthaṃ sudam āyasmā Vedikārako thero i. g. a-ti. Vedikārakattherassa ",
  "tha-ap451:10.1": "apadānaṃ samattaṃ. "
