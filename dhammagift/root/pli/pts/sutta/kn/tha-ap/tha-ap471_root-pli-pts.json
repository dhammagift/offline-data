  "tha-ap471:0.2": "",
  "tha-ap471:0.3": "",
  "tha-ap471:1.1": "Kakudhaṃ vilasantaṃ va ",
  "tha-ap471:1.2": "devadevaṃ narāsabhaṃ / ",
  "tha-ap471:1.3": "rathiyaṃ paṭipajjantaṃ ",
  "tha-ap471:1.4": "ko disvā nappasīdati? // // ",
  "tha-ap471:2.1": "Tam andhakāraṃ nāsetvā ",
  "tha-ap471:2.2": "santāretvā bahūjanaṃ / ",
  "tha-ap471:2.3": "ñāṇālokena jotentaṃ ",
  "tha-ap471:2.4": "ko disvā nappasīdati? // // ",
  "tha-ap471:3.1": "Vasīsatasahassehi ",
  "tha-ap471:3.2": "niyyantan lokanāyakaṃ / ",
  "tha-ap471:3.3": "uddharantaṃ bahū satte ",
  "tha-ap471:3.4": "ko disvā nappasīdati? // // ",
  "tha-ap471:4.1": "Āhanantaṃ dhammabheriṃ ",
  "tha-ap471:4.2": "maddantaṃ titthiye gaṇe / ",
  "tha-ap471:4.3": "sīhanādaṃ vinādantaṃ ",
  "tha-ap471:4.4": "ko disvā na ppasīdati? // // ",
  "tha-ap471:5.1": "Yāvatā brahmalokato ",
  "tha-ap471:5.2": "āgantvāna sabrahmakā / ",
  "tha-ap471:5.3": "pucchanti nipuṇe pañhe ",
  "tha-ap471:5.4": "ko disvā na ppasīdati? // // ",
  "tha-ap471:6.1": "Yass' añjaliṃ karitvāna ",
  "tha-ap471:6.2": "āyācanti sadevakā / ",
  "tha-ap471:6.3": "tena puññam anubhonti ",
  "tha-ap471:6.4": "ko disvā na ppasīdati? // // ",
  "tha-ap471:7.1": "Sabbe janā samāgantvā ",
  "tha-ap471:7.2": "sampavārenti cakkhumaṃ / ",
  "tha-ap471:7.3": "na vikampati ajjhiṭṭho ",
  "tha-ap471:7.4": "ko disvā na ppasīdati? // // ",
  "tha-ap471:8.1": "Nagaraṃ pavisato yassa ",
  "tha-ap471:8.2": "ra*va*nte *bheriyo bahū / ",
  "tha-ap471:8.3": "vinadanti* anugajjā ",
  "tha-ap471:8.4": "ko disvā nappasīdati? // // ",
  "tha-ap471:9.1": "Vīthiyā gacchato yassa ",
  "tha-ap471:9.2": "sabbābhā jotate sadā / ",
  "tha-ap471:9.3": "abbhuṇṇatā samā honti ",
  "tha-ap471:9.4": "ko disvā na ppasīdati? // // Vyāharante ",
  "tha-ap471:10.1": "ca Buddhassa ",
  "tha-ap471:10.2": "cakkavāḷamhi suyyati / ",
  "tha-ap471:10.3": "sabbe satte viññāpeti ",
  "tha-ap471:10.4": "ko disvā nappasīdati? // // Satasahasse ",
  "tha-ap471:11.1": "ito kappe ",
  "tha-ap471:11.2": "yaṃ Buddham abhikittayiṃ / ",
  "tha-ap471:11.3": "duggatiṃ nābhijānāmi ",
  "tha-ap471:11.4": "kittannāya idaṃ phalaṃ. // // ",
  "tha-ap471:12.1": "Kilesā . . . ",
  "tha-ap471:12.2": "pe . . . ",
  "tha-ap471:12.3": "",
  "tha-ap471:13.1": "",
  "tha-ap471:13.2": "pe . . . ",
  "tha-ap471:13.3": "pe . . . // // Sāgataṃ . . . pe . . . pe . . . pe . . . // // ",
  "tha-ap471:14.1": "Paṭisambhidā . . . ",
  "tha-ap471:14.2": "pe . . . ",
  "tha-ap471:14.3": "pe . . . pe . . . // // ",
  "tha-ap471:15.1": "Itthaṃ sudam āyasmā Sayaṃpaṭibhāniyo th. i. g. a-ti. Sayampaṭibhāniyātherassa apadānaṃ samattaṃ. ",
  "tha-ap471:16.1": ""
}
