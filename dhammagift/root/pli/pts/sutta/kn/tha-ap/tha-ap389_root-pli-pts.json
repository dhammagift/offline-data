  "tha-ap389:1.1": "jalitaṃ ",
  "tha-ap389:1.2": "puṇṇamāse va candimaṃ / ",
  "tha-ap389:1.3": "jalantaṃ dīparukkhaṃ va ",
  "tha-ap389:1.4": "addasaṃ lokanāyakaṃ. // // ",
  "tha-ap389:2.1": "Kadalīphalaṃ paggayha ",
  "tha-ap389:2.2": "adāsiṃ satthuno ahaṃ / ",
  "tha-ap389:2.3": "pasannacitto sumano ",
  "tha-ap389:2.4": "vanditvāna apakkamiṃ. // // ",
  "tha-ap389:3.1": "Ekatiṃse ito kappe ",
  "tha-ap389:3.2": "yaṃ phalam adadiṃ tadā / ",
  "tha-ap389:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap389:3.4": "phaladānass' idaṃ phalaṃ. // // ",
  "tha-ap389:4.1": "Sāgataṃ . . . pe . . . pe . . . // // Kilesā . . . ",
  "tha-ap389:4.2": "pe . . . ",
  "tha-ap389:4.3": "",
  "tha-ap389:5.1": "",
  "tha-ap389:5.2": "pe . . . // // ",
  "tha-ap389:5.3": "",
  "tha-ap389:6.1": "Paṭisambhidā . . . ",
  "tha-ap389:6.2": "pe . . . ",
  "tha-ap389:6.3": "pe . . . // // ",
  "tha-ap389:7.1": "Itthaṃ sudam āyasmā Kadalīphaladāyako th. i. g. a-ti. Kadalīphaladāyakattherassa apadānaṃ samattaṃ. ",
  "tha-ap389:8.1": ""
}
