  "tha-ap434:1.1": "Vipassino bhagavato ",
  "tha-ap434:1.2": "mahābodhimaho ahū / ",
  "tha-ap434:1.3": "mahājanā samāgamma ",
  "tha-ap434:1.4": "pūjenti bodhim uttamaṃ. // // ",
  "tha-ap434:2.1": "Na hi taṃ orakaṃ maññe ",
  "tha-ap434:2.2": "Buddhaseṭṭho bhavissati / ",
  "tha-ap434:2.3": "yassāyam edisā bodhi ",
  "tha-ap434:2.4": "pūjanīyā va satthuno. // // ",
  "tha-ap434:3.1": "Tato saṅkhaṃ gahetvāna ",
  "tha-ap434:3.2": "bodhirukkhaṃ upaṭṭhahaṃ / ",
  "tha-ap434:3.3": "dhamento sabbadivasaṃ ",
  "tha-ap434:3.4": "avandiṃ bodhim uttamaṃ. // // ",
  "tha-ap434:4.1": "Āsannake kataṃ kammaṃ ",
  "tha-ap434:4.2": "devalokaṃ a*pāpayiṃ* / ",
  "tha-ap434:4.3": "kalebaraṃ me patitaṃ ",
  "tha-ap434:4.4": "devaloke ramām' ahaṃ. // // ",
  "tha-ap434:5.1": "Saṭṭhituriyasahassāni ",
  "tha-ap434:5.2": "tuṭṭhahaṭṭhapamoditā / ",
  "tha-ap434:5.3": "sadā mayhaṃ upaṭṭhanti ",
  "tha-ap434:5.4": "Buddhapūjāy' idam phalaṃ. // // ",
  "tha-ap434:6.1": "Ekasattat' ime kappe ",
  "tha-ap434:6.2": "rājā āsi Sudassano / ",
  "tha-ap434:6.3": "cāturanto vijitāvī ",
  "tha-ap434:6.4": "*jambūsaṇḍa*ssa issaro. // // ",
  "tha-ap434:7.1": "Tato aṅgasatā turyā ",
  "tha-ap434:7.2": "parivārenti maṃ sadā / ",
  "tha-ap434:7.3": "anubhomi sakaṃ kammaṃ ",
  "tha-ap434:7.4": "upaṭṭhānass' idaṃ phalaṃ. // // ",
  "tha-ap434:8.1": "Yaṃ yaṃ yonūpapajjāmi ",
  "tha-ap434:8.2": "devattaṃ atha mānusaṃ / ",
  "tha-ap434:8.3": "mātukucchigatassāpi ",
  "tha-ap434:8.4": "vajjare bheriyo sadā. // // ",
  "tha-ap434:9.1": "Upaṭṭhahitvā *sambuddhaṃ* ",
  "tha-ap434:9.2": "anubhotvāna sampadā / ",
  "tha-ap434:9.3": "sivaṃ sukhemaṃ amataṃ ",
  "tha-ap434:9.4": "patto 'mhi acalaṃ padaṃ. // // ",
  "tha-ap434:10.1": "Ekanavute ito kappe ",
  "tha-ap434:10.2": "yaṃ kammam akariṃ tadā / ",
  "tha-ap434:10.3": "duggatiṃ nābhijānāmi ",
  "tha-ap434:10.4": "Buddhapūjāy' idaṃ phalaṃ. // // ",
  "tha-ap434:11.1": "Kilesā . . . ",
  "tha-ap434:11.2": "pe . . . ",
  "tha-ap434:11.3": "",
  "tha-ap434:12.1": "",
  "tha-ap434:12.2": "pe . . . ",
  "tha-ap434:12.3": "pe . . . // // Sāgataṃ . . . pe . . . pe . . . pe . . . // // ",
  "tha-ap434:13.1": "Paṭisambhidā . . . ",
  "tha-ap434:13.2": "pe . . . ",
  "tha-ap434:13.3": "pe . . . pe . . . // // ",
  "tha-ap434:14.1": "Itthaṃ sudaṃ āyasmā Ekasaṅkhiyo thero i. g. a-ti. Ekasaṅkhiyattherassa ",
  "tha-ap434:15.1": "apadānaṃ samattaṃ. "
}
