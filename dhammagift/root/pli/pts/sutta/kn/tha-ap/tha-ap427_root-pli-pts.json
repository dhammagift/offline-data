{
  "tha-ap427:0.1": "",
  "tha-ap427:0.2": "",
  "tha-ap427:0.3": "",
  "tha-ap427:1.1": "Vanakammiko pure āsiṃ ",
  "tha-ap427:1.2": "pitupetāmahen' ahaṃ / ",
  "tha-ap427:1.3": "pararuhirena jīvāmi ",
  "tha-ap427:1.4": "kusalaṃ me na vijjati. // // ",
  "tha-ap427:2.1": "Mama āsayasāmantā ",
  "tha-ap427:2.2": "Tisso loka*gganāya*ko / ",
  "tha-ap427:2.3": "padāni tīṇi dassesi ",
  "tha-ap427:2.4": "anukampāya cakkhumā. // // ",
  "tha-ap427:3.1": "Akkante ca pade disvā ",
  "tha-ap427:3.2": "Tissanāmassa satthuno / ",
  "tha-ap427:3.3": "haṭṭho haṭṭhena cittena ",
  "tha-ap427:3.4": "pade cittaṃ pasādayiṃ. // // ",
  "tha-ap427:4.1": "Koraṇḍaṃ pupphitaṃ disvā ",
  "tha-ap427:4.2": "pādapaṃ dharaṇīruhaṃ / ",
  "tha-ap427:4.3": "sakoṭakaṃ gahetvāna ",
  "tha-ap427:4.4": "padaseṭṭhe apūjayiṃ. // // ",
  "tha-ap427:5.1": "Tena kammena sukatena ",
  "tha-ap427:5.2": "cetanāpaṇidhīhi ca / ",
  "tha-ap427:5.3": "jahitvā mānusaṃ dehaṃ ",
  "tha-ap427:5.4": "Tāvatiṃsam agacch' ahaṃ. // // ",
  "tha-ap427:6.1": "Yaṃ yaṃ yonūpapajjāmi ",
  "tha-ap427:6.2": "devattam atha mānusaṃ / ",
  "tha-ap427:6.3": "koraṇḍavaṇṇako yeva ",
  "tha-ap427:6.4": "sappabhāso bhavām' ahaṃ. // // ",
  "tha-ap427:7.1": "Dvenavute ito kappe ",
  "tha-ap427:7.2": "yaṃ kammam akariṃ tadā / ",
  "tha-ap427:7.3": "duggatiṃ nābhijānāmi ",
  "tha-ap427:7.4": "padapūjāy' idaṃ phalaṃ. // // ",
  "tha-ap427:8.1": "Kilesā . . . ",
  "tha-ap427:8.2": "pe . . . // // ",
  "tha-ap427:8.3": "Sāgataṃ . . . ",
  "tha-ap427:9.1": "",
  "tha-ap427:9.2": "pe . . . // // ",
  "tha-ap427:9.3": "",
  "tha-ap427:10.1": "Paṭisambhidā . . . ",
  "tha-ap427:10.2": "pe . . . // // ",
  "tha-ap427:10.3": "",
  "tha-ap427:11.1": "Itthaṃ sudam āyasmā Koraṇḍapupphiyo thero i. g. a-ti. Koraṇḍapupphiyattherassa apadānaṃ samattaṃ. ",
  "tha-ap427:12.1": ""
}
