  "tha-ap167:0.3": "",
  "tha-ap167:1.1": "Vessabhū nāma sambuddho ",
  "tha-ap167:1.2": "lokajeṭṭho narāsabho / ",
  "tha-ap167:1.3": "divāvihārāya muni ",
  "tha-ap167:1.4": "ogāhitvā mahāvanaṃ. // // ",
  "tha-ap167:2.1": "Kaṇikāram ocinitvā ",
  "tha-ap167:2.2": "chattaṃ katvān' ahaṃ tadā / ",
  "tha-ap167:2.3": "pupphacchadanaṃ katvāna ",
  "tha-ap167:2.4": "Buddhassa abhiropayiṃ. // // ",
  "tha-ap167:3.1": "Ekatiṃse ito kappe ",
  "tha-ap167:3.2": "yaṃ puppham abhiropayiṃ / ",
  "tha-ap167:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap167:3.4": "Buddhapūjāy' idaṃ phalaṃ. // // ",
  "tha-ap167:4.1": "Ito vīsatikappamhi ",
  "tha-ap167:4.2": "Soṇṇābhā aṭṭha khattiyā / ",
  "tha-ap167:4.3": "sattaratanasampannā ",
  "tha-ap167:4.4": "cakkavattī mahabbalā. // // ",
  "tha-ap167:5.1": "Paṭisambhidā . . . ",
  "tha-ap167:5.2": "pe . . . ",
  "tha-ap167:5.3": "pe . . . // // ",
  "tha-ap167:6.1": "Itthaṃ sudaṃ ā. Kaṇikārapupphiyo thero i. g. ā-ti. Kaṇikāracchadaniyattherassa ",
  "tha-ap167:7.1": "apadānaṃ samattaṃ. "
}
