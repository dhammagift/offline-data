  "tha-ap81:0.2": "",
  "tha-ap81:0.3": "",
  "tha-ap81:1.1": "Migaluddo pure āsiṃ ",
  "tha-ap81:1.2": "araññe kānane ahaṃ / ",
  "tha-ap81:1.3": "tatth' addasāsiṃ sambuddhaṃ ",
  "tha-ap81:1.4": "Tissaṃ pavaralakkhaṇaṃ. // // ",
  "tha-ap81:2.1": "Tatthāhaṃ añjaliṃ katvā ",
  "tha-ap81:2.2": "pakkāmiṃ pācināmukho / ",
  "tha-ap81:2.3": "avidūre nisinnassa ",
  "tha-ap81:2.4": "niyate paṇṇasanthare. // // ",
  "tha-ap81:3.1": "Tato me asanīpāto ",
  "tha-ap81:3.2": "matthake nipatī tadā / ",
  "tha-ap81:3.3": "so 'haṃ maraṇakālamhi ",
  "tha-ap81:3.4": "akāsiṃ punar añjaliṃ. // // ",
  "tha-ap81:4.1": "Dvenavute ito kappe ",
  "tha-ap81:4.2": "añjalim akariṃ tadā / ",
  "tha-ap81:4.3": "duggatiṃ nābhijānāmi ",
  "tha-ap81:4.4": "añjalissa idaṃ phalaṃ. // // ",
  "tha-ap81:5.1": "Catupaṇṇāsakappamhi ",
  "tha-ap81:5.2": "Migaketu-sanāmako / ",
  "tha-ap81:5.3": "sattaratanasampanno ",
  "tha-ap81:5.4": "cakkavatti mahabbalo. // // ",
  "tha-ap81:6.1": "Paṭisambhidā catasso ",
  "tha-ap81:6.2": "vimokhā pi ca aṭṭh' ime / chaḍabhiññā sacchikatā ",
  "tha-ap81:6.3": "kataṃ Buddhassa sāsanan ti. // // ",
  "tha-ap81:7.1": "Itthaṃ sudaṃ āyasmā Ṭhitañjaliyo thero imā gāthāyo abhāsitthā ti. ",
  "tha-ap81:8.1": "Ṭhitañjaliyattherassa apadānaṃ samattaṃ. "
}
