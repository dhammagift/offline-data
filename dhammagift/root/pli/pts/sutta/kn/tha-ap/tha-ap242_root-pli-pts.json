  "tha-ap242:1.1": "pure āsiṃ ",
  "tha-ap242:1.2": "Tivarāyaṃ puruttame / ",
  "tha-ap242:1.3": "ekā vāsi mayā dinnā ",
  "tha-ap242:1.4": "sayambhum aparājitaṃ. // // ",
  "tha-ap242:2.1": "Catunavute ito kappe ",
  "tha-ap242:2.2": "yaṃ vāsim adadiṃ tadā / ",
  "tha-ap242:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap242:2.4": "vāsidānass' idaṃ phalaṃ. // // ",
  "tha-ap242:3.1": "Paṭisambhidā . . . ",
  "tha-ap242:3.2": "pe . . . ",
  "tha-ap242:3.3": "pe . . . // // ",
  "tha-ap242:4.1": "Itthaṃ sudam āyasmā Vāsidāyako thero i. g. a-ti. ",
  "tha-ap242:5.1": "Vāsidāyakattherassa apadānaṃ ",
  "tha-ap242:6.1": "samattaṃ. Uddānaṃ: ",
  "tha-ap242:7.1": "Udakāsanī ",
  "tha-ap242:8.1": "Bhājanado ",
  "tha-ap242:8.2": "Sālapupphī Kilañjado ",
  "tha-ap242:8.3": "Vediko Vaṇṇakāro ca ",
  "tha-ap242:8.4": "Piyālam-Ambayāgado ",
  "tha-ap242:8.5": "Jagatī Vāsidāyī ca ",
  "tha-ap242:8.6": "gāthā tiṃsa ca aṭṭha ca. Udakāsanadāyivaggo catubbīsatimo. "
}
