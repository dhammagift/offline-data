  "tha-ap73:0.2": "",
  "tha-ap73:0.3": "",
  "tha-ap73:1.1": "Apāṭaliṃ ahaṃ pupphaṃ ",
  "tha-ap73:1.2": "ujjhitaṃ sumahāpathe / ",
  "tha-ap73:1.3": "thūpamhi abhiropesiṃ ",
  "tha-ap73:1.4": "Sikhino lokabandhuno. // // ",
  "tha-ap73:2.1": "Ekatiṃse ito kappe ",
  "tha-ap73:2.2": "yaṃ kammam akariṃ tadā / ",
  "tha-ap73:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap73:2.4": "thūpapūjāy' idaṃ phalaṃ. // // ",
  "tha-ap73:3.1": "Ito pannarase kappe ",
  "tha-ap73:3.2": "Bhūmiyo nāma khattiyo / ",
  "tha-ap73:3.3": "sattaratanasampanno ",
  "tha-ap73:3.4": "cakkavatti mahabbalo. // // ",
  "tha-ap73:4.1": "Paṭisambhidā catasso ",
  "tha-ap73:4.2": "vimokhā pi ca aṭṭh' ime / ",
  "tha-ap73:4.3": "chaḍabhiññā sacchikatā ",
  "tha-ap73:4.4": "kataṃ Buddhassa sāsanan ti. // // ",
  "tha-ap73:5.1": "Itthaṃ sudaṃ āyasmā Nāgasamālo thero imā gāthāyo abhāsitthā ti. Nāgasamālatherassa ",
  "tha-ap73:6.1": "apadānaṃ samattaṃ. Akkantañ ca "
}
