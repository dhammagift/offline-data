  "tha-ap107:0.1": "",
  "tha-ap107:0.2": "",
  "tha-ap107:0.3": "",
  "tha-ap107:1.1": "nāmena ",
  "tha-ap107:1.2": "mālākāro ahaṃ tadā / ",
  "tha-ap107:1.3": "addasaṃ virajaṃ Buddhaṃ ",
  "tha-ap107:1.4": "lokajeṭṭhaṃ narāsabhaṃ. // // ",
  "tha-ap107:2.1": "Jātipuppham gahetvāna ",
  "tha-ap107:2.2": "pūjayiṃ Padumuttaraṃ / ",
  "tha-ap107:2.3": "visuddhacakkhu sumano ",
  "tha-ap107:2.4": "dibbacakkhuṃ samajjhagaṃ. // // ",
  "tha-ap107:3.1": "Etissā Buddhapūjāya ",
  "tha-ap107:3.2": "cittassa paṇidhīhi ca / ",
  "tha-ap107:3.3": "kappānaṃ satasahassaṃ ",
  "tha-ap107:3.4": "duggatiṃ nūpapajj' ahaṃ. // // ",
  "tha-ap107:4.1": "Soḷasāsiṃsu rājāno ",
  "tha-ap107:4.2": "Devuttarasanāmakā / ",
  "tha-ap107:4.3": "chattiṃsamhi ito kappe ",
  "tha-ap107:4.4": "cakkavattī mahābalā. // // ",
  "tha-ap107:5.1": "Paṭisambhidā catasso ",
  "tha-ap107:5.2": "vimokhā pi ca aṭṭh' ime / chaḍabhiññā sacchikatā ",
  "tha-ap107:5.3": "kataṃ Buddhassa sāsanan ti. // // ",
  "tha-ap107:6.1": "Itthaṃ sudaṃ āyasmā Muṭṭhipupphiyo thero imā gāthāyo abhāsitthāti. Muṭṭhipupphiyattherassa apadānaṃ samattaṃ. ",
  "tha-ap107:7.1": ""
}
