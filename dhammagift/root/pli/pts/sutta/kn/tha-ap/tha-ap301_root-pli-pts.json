  "tha-ap301:1.1": "Romaso nāma nāmena ",
  "tha-ap301:1.2": "Dānavo iti vissuto / ",
  "tha-ap301:1.3": "ambapiṇḍī mayā dinnā ",
  "tha-ap301:1.4": "Vipassissa mahesino. // // ",
  "tha-ap301:2.1": "Ekanavute ito kappe ",
  "tha-ap301:2.2": "yam ambam adadiṃ tadā / ",
  "tha-ap301:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap301:2.4": "ambadānass' idaṃ phalaṃ. // // ",
  "tha-ap301:3.1": "Paṭisambhidā . . . ",
  "tha-ap301:3.2": "pe . . . ",
  "tha-ap301:3.3": "pe . . . // // ",
  "tha-ap301:4.1": "Itthaṃ sudam āyasmā Ambapiṇḍiyo thero i. g. a-ti. Ambapiṇḍiyattherassa apadānaṃ samattaṃ. ",
  "tha-ap301:5.1": ""
}
