  "tha-ap481:0.3": "",
  "tha-ap481:1.1": "Anomadassī bhagavā ",
  "tha-ap481:1.2": "lokajeṭṭho narāsabho / ",
  "tha-ap481:1.3": "divāvihārā nikkhamma ",
  "tha-ap481:1.4": "patham āruhi cakkhumā. // // ",
  "tha-ap481:2.1": "Pānadhiṃ sukataṃ gayha ",
  "tha-ap481:2.2": "addhānaṃ paṭipajj' ahaṃ / ",
  "tha-ap481:2.3": "tatth' addasāsiṃ sambuddhaṃ ",
  "tha-ap481:2.4": "pattikañ cārudassanaṃ. // // ",
  "tha-ap481:3.1": "Sakaṃ cittaṃ pasādetvā ",
  "tha-ap481:3.2": "nīharitvāna pānadhiṃ / ",
  "tha-ap481:3.3": "pādamūle ṭhapetvāna ",
  "tha-ap481:3.4": "idaṃ vacanam abraviṃ: // // ",
  "tha-ap481:4.1": "Abhirūha mahāvīra ",
  "tha-ap481:4.2": "sugat-inda vināyaka / ",
  "tha-ap481:4.3": "ito phalaṃ labhissāmi ",
  "tha-ap481:4.4": "yo me attho samijjhatu. // // ",
  "tha-ap481:5.1": "Anomadassī bhagavā ",
  "tha-ap481:5.2": "lokajeṭṭho narāsabho / ",
  "tha-ap481:5.3": "pānadhim abhirūhitvā ",
  "tha-ap481:5.4": "imaṃ vacanam abravi: // // ",
  "tha-ap481:6.1": "Yo pānadhim me adadā ",
  "tha-ap481:6.2": "pasanno sehi pāṇihi / ",
  "tha-ap481:6.3": "tam ahaṃ kittayissāmi; ",
  "tha-ap481:6.4": "suṇotha mama bhāsato: // // ",
  "tha-ap481:7.1": "Buddhassa giram aññāya ",
  "tha-ap481:7.2": "sabbe devā samāgatā / ",
  "tha-ap481:7.3": "udaggacittā sumanā ",
  "tha-ap481:7.4": "vedajātā katañjalī. // // ",
  "tha-ap481:8.1": "Pānadhīnaṃ padānena ",
  "tha-ap481:8.2": "sukhito 'yaṃ bhavissati / ",
  "tha-ap481:8.3": "pañcapaññāsakkhattuñ ca ",
  "tha-ap481:8.4": "devarajjaṃ karissati. // // ",
  "tha-ap481:9.1": "Sahassakkhattuṃ rājā ca ",
  "tha-ap481:9.2": "cakkavattī bhavissati / ",
  "tha-ap481:9.3": "padesarajjaṃ vipulaṃ ",
  "tha-ap481:9.4": "gaṇanāto asaṅkhiyaṃ. // // ",
  "tha-ap481:10.1": "Aparimeyye ito kappe ",
  "tha-ap481:10.2": "Okkākakulasambhavo / ",
  "tha-ap481:10.3": "Gotamo nāma nāmena ",
  "tha-ap481:10.4": "satthā loke bhavissati. // // ",
  "tha-ap481:11.1": "Tassa dhammesu dāyādo ",
  "tha-ap481:11.2": "oraso dhammanimmito / ",
  "tha-ap481:11.3": "sabbāsave pariññāya ",
  "tha-ap481:11.4": "nibbāyissat' anāsavo. // // ",
  "tha-ap481:12.1": "Devaloke manusse vā ",
  "tha-ap481:12.2": "nibbattissati puññavā / ",
  "tha-ap481:12.3": "devayānapaṭibhāgaṃ ",
  "tha-ap481:12.4": "yānaṃ paṭilabhissati. // // ",
  "tha-ap481:13.1": "Pāsādā sivikā mayhaṃ ",
  "tha-ap481:13.2": "hatthino samalaṅkatā / ",
  "tha-ap481:13.3": "rathā c' ājañña-saṃyuttā ",
  "tha-ap481:13.4": "sadā pātubhavanti me. // // ",
  "tha-ap481:14.1": "Agārā nikkhamanto pi ",
  "tha-ap481:14.2": "rathena nikkhamām' ahaṃ / ",
  "tha-ap481:14.3": "kesesu chijjamānesu ",
  "tha-ap481:14.4": "arahattam apāpuṇiṃ. // // ",
  "tha-ap481:15.1": "Lābhā mayhaṃ suladdham me ",
  "tha-ap481:15.2": "vānijjaṃ suppayojitaṃ / ",
  "tha-ap481:15.3": "datvāna pānadhiṃ ekaṃ ",
  "tha-ap481:15.4": "patto 'mhi acalaṃ padaṃ. // // ",
  "tha-ap481:16.1": "Aparimeyy' ito kappe ",
  "tha-ap481:16.2": "yaṃ pānadhim adās' ahaṃ / ",
  "tha-ap481:16.3": "duggatiṃ nābhijānāmi ",
  "tha-ap481:16.4": "pānadhissa idaṃ phalaṃ. // // ",
  "tha-ap481:17.1": "Kilesā . . . ",
  "tha-ap481:17.2": "pe . . . ",
  "tha-ap481:17.3": "",
  "tha-ap481:18.1": "",
  "tha-ap481:18.2": "pe . . . ",
  "tha-ap481:18.3": "pe . . . // // Sāgataṃ . . . pe . . . pe . . . pe . . . // // ",
  "tha-ap481:19.1": "Paṭisambhidā . . . ",
  "tha-ap481:19.2": "pe . . . ",
  "tha-ap481:19.3": "pe . . . pe . . . // // ",
  "tha-ap481:20.1": "Itthaṃ sudam āyasmā Pānadhidāyako thero i. g. a-ti. Pānadhidāyakattherassa ",
  "tha-ap481:21.1": "apadānaṃ samattaṃ. "
}
