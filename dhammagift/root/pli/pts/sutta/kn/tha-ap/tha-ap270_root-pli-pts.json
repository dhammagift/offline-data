  "tha-ap270:1.1": "Candabhāgānadītīre ",
  "tha-ap270:1.2": "ahosiṃ kinnaro tadā / ",
  "tha-ap270:1.3": "Vipassim addasaṃ *Buddhaṃ ",
  "tha-ap270:1.4": "raṃsijālasamākulaṃ.* // // ",
  "tha-ap270:2.1": "Pasannacitto sumano ",
  "tha-ap270:2.2": "paramāya ca pītiyā / ",
  "tha-ap270:2.3": "paggayha saḷalaṃ pupphaṃ ",
  "tha-ap270:2.4": "Vipassim okirim ahaṃ. // // ",
  "tha-ap270:3.1": "Ekanavute ito kappe ",
  "tha-ap270:3.2": "yaṃ puppham abhipūjayiṃ / ",
  "tha-ap270:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap270:3.4": "Buddhapūjay' idaṃ phalaṃ. // // ",
  "tha-ap270:4.1": "Paṭisambhidā . . . ",
  "tha-ap270:4.2": "pe . . . ",
  "tha-ap270:4.3": "pe . . . // // ",
  "tha-ap270:5.1": "Itthaṃ sudam āyasmā Saḷalapupphiyo thero i. g. a-ti. Saḷalapupphiyattherassa apadānaṃ samattaṃ. ",
  "tha-ap270:6.1": ""
}
