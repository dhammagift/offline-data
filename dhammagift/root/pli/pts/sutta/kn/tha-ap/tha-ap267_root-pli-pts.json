  "tha-ap267:0.3": "",
  "tha-ap267:1.1": "",
  "tha-ap267:1.2": "Romaso nāma pabbato / ",
  "tha-ap267:1.3": "tamhi pabbatapādamhi ",
  "tha-ap267:1.4": "samaṇo bhāvitindriyo. // // ",
  "tha-ap267:2.1": "Biḷāliyo gahetvāna ",
  "tha-ap267:2.2": "samaṇassa adās' ahaṃ / ",
  "tha-ap267:2.3": "anumodi mahāvīro ",
  "tha-ap267:2.4": "sayambhū aparājito: // // ",
  "tha-ap267:3.1": "Biḷālī te mamaṃ dinnā ",
  "tha-ap267:3.2": "vippasannena cetasā / ",
  "tha-ap267:3.3": "bhave nibbattamānamhi ",
  "tha-ap267:3.4": "phalaṃ nibbattate tavaṃ. // // Catunavute ",
  "tha-ap267:4.1": "ito kappe ",
  "tha-ap267:4.2": "yaṃ biḷālim adās' ahaṃ / ",
  "tha-ap267:4.3": "duggatiṃ nābhijānāmi ",
  "tha-ap267:4.4": "biḷāliyā idaṃ phalaṃ. // // ",
  "tha-ap267:5.1": "Paṭisambhidā . . . ",
  "tha-ap267:5.2": "pe . . . ",
  "tha-ap267:5.3": "pe . . . // // ",
  "tha-ap267:6.1": "Itthaṃ sudam āyasmā Biḷālidāyako thero i. g. a-ti. Biḷālidāyakattherassa ",
  "tha-ap267:7.1": "apadānaṃ samattaṃ. "
}
