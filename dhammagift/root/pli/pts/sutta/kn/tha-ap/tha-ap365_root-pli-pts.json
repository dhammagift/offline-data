  "tha-ap365:1.1": "Phusso nāmā ti sambuddho ",
  "tha-ap365:1.2": "sabbadhammānapāragū / ",
  "tha-ap365:1.3": "vivekakāmo suppañño ",
  "tha-ap365:1.4": "āgacchi mama santike. // // ",
  "tha-ap365:2.1": "Tasmiṃ cittaṃ pasādetvā ",
  "tha-ap365:2.2": "mahākāruṇike jine / ",
  "tha-ap365:2.3": "bhisamuḷālaṃ paggayha ",
  "tha-ap365:2.4": "Buddhaseṭṭhassa dās' ahaṃ. // // ",
  "tha-ap365:3.1": "Dvenavute ito kappe ",
  "tha-ap365:3.2": "yaṃ bhisam adadiṃ tadā / ",
  "tha-ap365:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap365:3.4": "bhisadānass' idaṃ phalaṃ. // // ",
  "tha-ap365:4.1": "Paṭisambhidā . . . ",
  "tha-ap365:4.2": "pe . . . ",
  "tha-ap365:4.3": "pe . . . // // ",
  "tha-ap365:5.1": "Itthaṃ sudam āyasmā Bhisamuḷāladāyako th. i. g. a-ti. Bhisamulāḷadāyakattherassa apadānaṃ samattaṃ. ",
  "tha-ap365:6.1": ""
}
