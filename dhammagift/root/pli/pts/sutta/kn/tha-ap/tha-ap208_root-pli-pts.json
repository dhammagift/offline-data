  "tha-ap208:1.1": "Bhuñjantaṃ samaṇaṃ disvā ",
  "tha-ap208:1.2": "vippasannam anāvilaṃ / ",
  "tha-ap208:1.3": "ghaṭen' odakam ādāya ",
  "tha-ap208:1.4": "Siddhatthassa adās' ahaṃ. // // ",
  "tha-ap208:2.1": "Nimmalo hom' aham ajja ",
  "tha-ap208:2.2": "vimalo khīṇasaṃsayo / ",
  "tha-ap208:2.3": "bhave nibbattamānamhi ",
  "tha-ap208:2.4": "phalaṃ nibbattate mama. // // ",
  "tha-ap208:3.1": "Catunavute ito kappe ",
  "tha-ap208:3.2": "udakaṃ yaṃ tadā adaṃ / ",
  "tha-ap208:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap208:3.4": "udakadānass' idaṃ phalaṃ. // // ",
  "tha-ap208:4.1": "Ekasaṭṭhi ito kappe ",
  "tha-ap208:4.2": "eko 'va Vimalo ahu / ",
  "tha-ap208:4.3": "sattaratanasampanno ",
  "tha-ap208:4.4": "cakkavattī mahabbalo. // // ",
  "tha-ap208:5.1": "Paṭisambhidā . . . ",
  "tha-ap208:5.2": "pe . . . ",
  "tha-ap208:5.3": "pe // // ",
  "tha-ap208:6.1": "Itthaṃ sudam āyasmā Udakadāyako thero i. g. a-ti. Udakadāyakattherassa apadānaṃ ",
  "tha-ap208:7.1": "samattaṃ. Kaṇikāraṃ va "
}
