{
  "tha-ap125:0.1": "",
  "tha-ap125:0.2": "",
  "tha-ap125:0.3": "",
  "tha-ap125:1.1": "",
  "tha-ap125:1.2": "",
  "tha-ap125:1.3": "pavanā abhinikkhantaṃ ",
  "tha-ap125:1.4": "bhikkhusaṅghapurakkhataṃ. // // ",
  "tha-ap125:2.1": "Sahatthā kaṃsapātiyā ",
  "tha-ap125:2.2": "vaḍḍhetvā pāyāsaṃ ahaṃ / ",
  "tha-ap125:2.3": "āhutiyiṭṭhukāmo so ",
  "tha-ap125:2.4": "agamāsiṃ balim ahaṃ. // // ",
  "tha-ap125:3.1": "Bhagavā tamhi samaye ",
  "tha-ap125:3.2": "lokajeṭṭho narāsabho / ",
  "tha-ap125:3.3": "caṅkamaṃ susamārūḷho ",
  "tha-ap125:3.4": "ambare anilāyane. // // ",
  "tha-ap125:4.1": "Tañ ca acchariyaṃ disvā ",
  "tha-ap125:4.2": "abbhutaṃ lomahaṃsanaṃ / ",
  "tha-ap125:4.3": "ṭhapayitvā kaṃsapātiṃ ",
  "tha-ap125:4.4": "Vipassiṃ abhivādayiṃ. // // ",
  "tha-ap125:5.1": "Tuvaṃ devo 'si sabbaññū ",
  "tha-ap125:5.2": "sadevasahamānuse / ",
  "tha-ap125:5.3": "anukampaṃ upādāya ",
  "tha-ap125:5.4": "patigaṇha mahāmune. // // ",
  "tha-ap125:6.1": "Paṭiggahesi bhagavā ",
  "tha-ap125:6.2": "sabbaññū lokanāyako / ",
  "tha-ap125:6.3": "mama saṅkappam aññāya ",
  "tha-ap125:6.4": "satthā loke mahāmuni. // // ",
  "tha-ap125:7.1": "Ekanavute ito kappe ",
  "tha-ap125:7.2": "yaṃ dānam adadiṃ tadā / ",
  "tha-ap125:7.3": "duggatiṃ nābhijānāmi ",
  "tha-ap125:7.4": "pāyāsassa idaṃ phalaṃ. // // ",
  "tha-ap125:8.1": "Ekatālis' ito kappe ",
  "tha-ap125:8.2": "Buddho nāmā 'si khattiyo / ",
  "tha-ap125:8.3": "sattaratanasampanno ",
  "tha-ap125:8.4": "cakkavattī mahābalo. // // ",
  "tha-ap125:9.1": "Paṭisambhidā catasso ",
  "tha-ap125:9.2": "vimokhā pi ca aṭṭh' ime / chaḍabhiññā sacchikatā ",
  "tha-ap125:9.3": "kataṃ Buddhassa sāsanaṃ ti. // // ",
  "tha-ap125:10.1": "Itthaṃ sudaṃ āyasmā Pāyāsadāyako thero imā gāthāyo abhāsitthā ti. Pāyāsadāyakattherassa apadānaṃ samattaṃ. ",
  "tha-ap125:11.1": ""
}
