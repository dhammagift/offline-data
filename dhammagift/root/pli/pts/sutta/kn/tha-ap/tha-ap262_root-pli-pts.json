  "tha-ap262:0.1": "",
  "tha-ap262:0.2": "",
  "tha-ap262:0.3": "",
  "tha-ap262:1.1": "Suvaṇṇavaṇṇaṃ sambuddhaṃ ",
  "tha-ap262:1.2": "nisinnaṃ pabbatantare / ",
  "tha-ap262:1.3": "obhāsayantaṃ raṃsena ",
  "tha-ap262:1.4": "Sikhinaṃ sikhinaṃ yathā. // // ",
  "tha-ap262:2.1": "Aggajaṃ puppham ādāya ",
  "tha-ap262:2.2": "upagacchiṃ naruttamaṃ / ",
  "tha-ap262:2.3": "pasannacitto sumano ",
  "tha-ap262:2.4": "Buddhassa abhiropayiṃ. // // ",
  "tha-ap262:3.1": "Ekatiṃse ito kappe ",
  "tha-ap262:3.2": "yaṃ puppham abhipūjayiṃ / ",
  "tha-ap262:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap262:3.4": "Buddhapūjāy' idaṃ phalaṃ. // // ",
  "tha-ap262:4.1": "Pañcavīsati kappamhi ",
  "tha-ap262:4.2": "ahosim Amitavhayo / ",
  "tha-ap262:4.3": "sattaratanasampanno ",
  "tha-ap262:4.4": "cakkavattī mahabbalo. // // ",
  "tha-ap262:5.1": "Paṭisambhidā . . . ",
  "tha-ap262:5.2": "pe . . . ",
  "tha-ap262:5.3": "pe . . . // // ",
  "tha-ap262:6.1": "Itthaṃ sudam āyasmā Aggapupphiyo thero i. g. a-ti. Aggapupphiyattherassa apadānaṃ samattaṃ. ",
  "tha-ap262:7.1": "",
  "tha-ap262:8.1": "Uddānaṃ: Thomako- ",
  "tha-ap262:9.1": "Bhikkha- ",
  "tha-ap262:10.1": "Citakaṃ ",
  "tha-ap262:10.2": "Campako Sattapāṭalī ",
  "tha-ap262:10.3": "'Pāhano Mañjari Paṇṇañ ca ",
  "tha-ap262:10.4": "Kuṭido Aggapupphiyo ",
  "tha-ap262:10.5": "gāthāyo gaṇitā c' ettha ",
  "tha-ap262:10.6": "ekatālīsam-eva ca. "
}
