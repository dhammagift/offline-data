{
  "tha-ap192:0.1": "",
  "tha-ap192:0.2": "",
  "tha-ap192:0.3": "",
  "tha-ap192:1.1": "",
  "tha-ap192:1.2": "sabbe saṅgamma te mamaṃ / ",
  "tha-ap192:1.3": "tesaṃ nijjhāyamānānaṃ ",
  "tha-ap192:1.4": "pariḷāho ajāyatha. // // ",
  "tha-ap192:2.1": "Sunando nāma nāmena ",
  "tha-ap192:2.2": "Buddhassa sāvako tadā / ",
  "tha-ap192:2.3": "Dhammadassissa munino ",
  "tha-ap192:2.4": "āgacchi mama santike. // // ",
  "tha-ap192:3.1": "Ye me paddhacarā āsuṃ ",
  "tha-ap192:3.2": "te me pupphaṃ aduṃ tadā / ",
  "tha-ap192:3.3": "tāhaṃ pupphaṃ gahetvāna ",
  "tha-ap192:3.4": "sāvake abhiropayiṃ. // // ",
  "tha-ap192:4.1": "So haṃ kālakato tattha ",
  "tha-ap192:4.2": "punāpi upapajj' ahaṃ / ",
  "tha-ap192:4.3": "aṭṭhārase kappasate ",
  "tha-ap192:4.4": "vinipātaṃ n' agacch' ahaṃ. // // ",
  "tha-ap192:5.1": "Terase 'to kappasate ",
  "tha-ap192:5.2": "aṭṭhāsuṃ Dhūmaketuno / ",
  "tha-ap192:5.3": "sattaratanasampannā ",
  "tha-ap192:5.4": "cakkavattī mahabbalo. // // ",
  "tha-ap192:6.1": "Paṭisambhidā . . . ",
  "tha-ap192:6.2": "pe . . . ",
  "tha-ap192:6.3": "pe . . . // // ",
  "tha-ap192:7.1": "Itthaṃ sudam āyasmā Tivaṇṭipupphiyo thero i. g. a- ti. Tivaṇṭipupphiyattherassa ",
  "tha-ap192:8.1": "",
  "tha-ap192:9.1": "apadānaṃ samattaṃ. ",
  "tha-ap192:10.1": "Uddānaṃ: ",
  "tha-ap192:11.1": "Kuṭajo Bandhujīvī ca ",
  "tha-ap192:11.2": "Koṭumbarika Hatthiyo ",
  "tha-ap192:11.3": "Isimuggo ca Bodhī ca ",
  "tha-ap192:11.4": "Ekacinti Tikaṇṇiko ",
  "tha-ap192:11.5": "Ekacārī Tivaṇṭī ca ",
  "tha-ap192:11.6": "gāthāyo bāsaṭṭhi kittitā. Kuṭajapupphiyavaggo ekūnavīsatimo. "
}
