  "tha-ap522:1.1": "",
  "tha-ap522:1.2": "Romaso nāma pabbato / ",
  "tha-ap522:1.3": "Buddho pi Sambhavo nāma ",
  "tha-ap522:1.4": "abbhokāse vasī tadā. // // ",
  "tha-ap522:2.1": "Bhavanā nikkhamitvāna ",
  "tha-ap522:2.2": "padumaṃ dhārayiṃ ahaṃ / ",
  "tha-ap522:2.3": "ekāhaṃ dhārayitvāna ",
  "tha-ap522:2.4": "bhavanaṃ punar āgamiṃ. // // ",
  "tha-ap522:3.1": "Ekatiṃse ito kappe ",
  "tha-ap522:3.2": "yaṃ Buddham abhipūjayiṃ / ",
  "tha-ap522:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap522:3.4": "Buddhapūjāy' idaṃ phalaṃ. // // ",
  "tha-ap522:4.1": "Kilesā . . . ",
  "tha-ap522:4.2": "pe . . . ",
  "tha-ap522:4.3": "",
  "tha-ap522:5.1": "",
  "tha-ap522:5.2": "pe . . . ",
  "tha-ap522:5.3": "pe . . . // // Sāgataṃ . . . pe . . . pe . . . pe . . . // // ",
  "tha-ap522:6.1": "Paṭisambhidā . . . ",
  "tha-ap522:6.2": "pe . . . ",
  "tha-ap522:6.3": "pe . . . pe . . . // // ",
  "tha-ap522:7.1": "Itthaṃ sudaṃ āyasmā Padumadhāriyo thero i. g. a- ",
  "tha-ap522:8.1": "ti. Padumadhāriyattherassa ",
  "tha-ap522:9.1": "apadānaṃ samattaṃ. ",
  "tha-ap522:10.1": "Uddānaṃ: ",
  "tha-ap522:11.1": "Kureñjika Kapiṭṭhañ ca Kosumbhaṃ ",
  "tha-ap522:11.2": "atha Ketakaṃ ",
  "tha-ap522:11.3": "Nāgapupph' Ajjunañ c' eva ",
  "tha-ap522:11.4": "Kuṭajī Ghosasaññako ",
  "tha-ap522:12.1": "Thero ca Sabbaphalado ",
  "tha-ap522:12.2": "tathā Padumadhāriko ",
  "tha-ap522:12.3": "asīti c' ettha gāthāyo ",
  "tha-ap522:12.4": "tisso gāthā taduttariṃ. Kureñjiyaphaladāyakavaggo dvepaññāso. Himavantass' avidūre "
}
