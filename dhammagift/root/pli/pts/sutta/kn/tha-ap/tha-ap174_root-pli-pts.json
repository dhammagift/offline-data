  "tha-ap174:0.3": "",
  "tha-ap174:1.1": "Koṇḍaññassa bhagavato ",
  "tha-ap174:1.2": "lokajeṭṭhassa tādino / ",
  "tha-ap174:1.3": "ārohatthāya pāsādaṃ ",
  "tha-ap174:1.4": "nisseṇi-kāritā mayā. // // ",
  "tha-ap174:2.1": "Tena cittappasādena ",
  "tha-ap174:2.2": "*anubhutvāna sampa*dā / ",
  "tha-ap174:2.3": "dhāremi antimaṃ dehaṃ ",
  "tha-ap174:2.4": "sammāsambuddhasāsane. // // ",
  "tha-ap174:3.1": "Ekatiṃsamhi kappānaṃ ",
  "tha-ap174:3.2": "sahassamhi tayo tadā / ",
  "tha-ap174:3.3": "Pahasambahulā nāma rājāno ",
  "tha-ap174:3.4": "cakkavattino. // // ",
  "tha-ap174:4.1": "Paṭisambhidā . . . ",
  "tha-ap174:4.2": "pe . . . ",
  "tha-ap174:4.3": "pe . . . // // ",
  "tha-ap174:5.1": "Itthaṃ sudaṃ āyasmā Nisseṇidāyako thero i. g. a-ti. Nisseṇidāyakattherassa apadānaṃ samattaṃ. ",
  "tha-ap174:6.1": ""
}
