  "tha-ap394:0.3": "",
  "tha-ap394:1.1": "Nagare Haṃsavatiyā ",
  "tha-ap394:1.2": "vīthisāmi ahos' ahaṃ / ",
  "tha-ap394:1.3": "mamaṃ ñātī samānetvā ",
  "tha-ap394:1.4": "imaṃ vacanam abraviṃ: // // ",
  "tha-ap394:2.1": "Buddho loke samuppanno ",
  "tha-ap394:2.2": "puññakhettam anuttaraṃ / ",
  "tha-ap394:2.3": "ādhāro sabbalokassa ",
  "tha-ap394:2.4": "ā*hu*tīnaṃ paṭiggaho. // // ",
  "tha-ap394:3.1": "Khattiyā negamā c' eva ",
  "tha-ap394:3.2": "mahāsālā ca brāhmaṇā / ",
  "tha-ap394:3.3": "pasannacittā sumanā ",
  "tha-ap394:3.4": "pūgadhammam akaṃsu te. // // ",
  "tha-ap394:4.1": "Hatthārūḷhā anīkaṭṭhā ",
  "tha-ap394:4.2": "rathikā pattikārakā / ",
  "tha-ap394:4.3": "pasannacittā sumanā ",
  "tha-ap394:4.4": "pūgadhammam akaṃsu te. // // ",
  "tha-ap394:5.1": "Uggā ca rājaputtā ca ",
  "tha-ap394:5.2": "vesiyānā ca brāhmaṇā / ",
  "tha-ap394:5.3": "pasannacittā . . . pe . . . // // ",
  "tha-ap394:5.4": "",
  "tha-ap394:6.1": "Āḷārikā kappakā ca ",
  "tha-ap394:6.2": "nahāpakā mālakārakā / ",
  "tha-ap394:6.3": "pasannacittā . . . pe . . . // // ",
  "tha-ap394:6.4": "",
  "tha-ap394:7.1": "*Rajakā pesakārā ca ",
  "tha-ap394:7.2": "cammakārā ca nhāpikā / ",
  "tha-ap394:7.3": "pasannacittā . . . pe . . . // // ",
  "tha-ap394:7.4": "",
  "tha-ap394:8.1": "Usukārā cammikā ",
  "tha-ap394:8.2": "ca tacchakārā ",
  "tha-ap394:8.3": "",
  "tha-ap394:8.4": "ca ",
  "tha-ap394:9.1": "soṇṇakārā ca / ",
  "tha-ap394:9.2": "tipulopā kaṭā tathā ",
  "tha-ap394:9.3": "puggadhammaṃ . . . ",
  "tha-ap394:9.4": "pe* . . . // // ",
  "tha-ap394:10.1": "Bhatakā gītakā c' eva ",
  "tha-ap394:10.2": "dāsakammakārā bahū / ",
  "tha-ap394:10.3": "Yathā sakena thāmena ",
  "tha-ap394:10.4": "pūgadhammaṃ pe // // ",
  "tha-ap394:11.1": "Udahārā kaṭṭhahārā ",
  "tha-ap394:11.2": "kasikā tiṇahārakā / ",
  "tha-ap394:11.3": "yathā sakena . . . ",
  "tha-ap394:11.4": "pe . . . // // ",
  "tha-ap394:12.1": "Pupphikā mālikā c' eva ",
  "tha-ap394:12.2": "paṇṇikā phalahārikā / ",
  "tha-ap394:12.3": "yathā . . . ",
  "tha-ap394:12.4": "pe . . . // // ",
  "tha-ap394:13.1": "Gaṇikā kumbhadāsī ca ",
  "tha-ap394:13.2": "pūvikā macchakāyikā / ",
  "tha-ap394:13.3": "yathā . . . ",
  "tha-ap394:13.4": "pe . . . // // Ete ",
  "tha-ap394:14.1": "sabbe samāgantvā ",
  "tha-ap394:14.2": "gaṇaṃ bandhāma ekato / ",
  "tha-ap394:14.3": "adhikāraṃ karissāma ",
  "tha-ap394:14.4": "puññakkhette anuttare. // // ",
  "tha-ap394:15.1": "Te me sutvā*na vacan*aṃ ",
  "tha-ap394:15.2": "gaṇaṃ bandhiṃsu tāvade / ",
  "tha-ap394:15.3": "upaṭṭhānasālaṃ sukataṃ ",
  "tha-ap394:15.4": "bhikkhusaṅghassa kārayuṃ. // // ",
  "tha-ap394:16.1": "Niṭṭhāpetvāna taṃ sālam ",
  "tha-ap394:16.2": "udaggo tuṭṭhamānaso / ",
  "tha-ap394:16.3": "pareto tehi sabbehi ",
  "tha-ap394:16.4": "sambuddham upasaṅkamiṃ. // // ",
  "tha-ap394:17.1": "Upasaṅkamma sambuddhaṃ ",
  "tha-ap394:17.2": "lokanāthaṃ narāsabhaṃ / ",
  "tha-ap394:17.3": "vanditvā satthuno pāde ",
  "tha-ap394:17.4": "idaṃ vacanam abraviṃ: // // ",
  "tha-ap394:18.1": "Ime tīṇisatā vīra ",
  "tha-ap394:18.2": "purisā ekato gaṇā / ",
  "tha-ap394:18.3": "upaṭṭhānasālaṃ sukataṃ ",
  "tha-ap394:18.4": "niyyātenti tavaṃ muni // // ",
  "tha-ap394:19.1": "Bhikkhusaṅghassa purato ",
  "tha-ap394:19.2": "sampaṭicchatu cakkhumā / ",
  "tha-ap394:19.3": "tīṇi-satānaṃ purato ",
  "tha-ap394:19.4": "imā gāthā abhāsatha: // // ",
  "tha-ap394:20.1": "Tisatāpi ca jeṭṭho ca ",
  "tha-ap394:20.2": "anuvattiṃsu ekato / ",
  "tha-ap394:20.3": "sampattiṃ hi karitvāna ",
  "tha-ap394:20.4": "sabbe anubhavissatha. // // ",
  "tha-ap394:21.1": "Pacchime bhave sampatte ",
  "tha-ap394:21.2": "sītibhāvam anuttaraṃ / ",
  "tha-ap394:21.3": "ajaram amaraṃ santiṃ ",
  "tha-ap394:21.4": "nibbānaṃ phusayissatha. // // ",
  "tha-ap394:22.1": "Evaṃ Buddho viyākāsi ",
  "tha-ap394:22.2": "sabbaññu samaṇuttaro / ",
  "tha-ap394:22.3": "buddhassa vacanaṃ sutvā ",
  "tha-ap394:22.4": "somanassaṃ pavedayiṃ. // // ",
  "tha-ap394:23.1": "Tiṃsakappasahassāni ",
  "tha-ap394:23.2": "devaloke ramim ahaṃ / ",
  "tha-ap394:23.3": "devādhipo pañcasataṃ ",
  "tha-ap394:23.4": "devarajjam akārayiṃ. // // ",
  "tha-ap394:24.1": "Sahassakkhattuṃ rājā ca ",
  "tha-ap394:24.2": "cakkavatti ahos' ahaṃ / ",
  "tha-ap394:24.3": "devarajjaṃ karontassa ",
  "tha-ap394:24.4": "mahādevā avandisu. // // ",
  "tha-ap394:25.1": "Idha mānusake rajje ",
  "tha-ap394:25.2": "parisā honti bandhavā / ",
  "tha-ap394:25.3": "pacchime bhavasampatte ",
  "tha-ap394:25.4": "Vāseṭṭho nāma brāhmaṇo. // // ",
  "tha-ap394:26.1": "Asītikoṭinicayo ",
  "tha-ap394:26.2": "tassa putto ahos' ahaṃ / ",
  "tha-ap394:26.3": "Selo iti mamaṃ nāmaṃ ",
  "tha-ap394:26.4": "chalaṅge pāramiṅgato // // ",
  "tha-ap394:27.1": "Jaṅghāvihāraṃ vicaraṃ ",
  "tha-ap394:27.2": "sasissehi purakkhato / ",
  "tha-ap394:27.3": "jaṭābhābhārabharitaṃ ",
  "tha-ap394:27.4": "Keniyaṃ nāma tāpasaṃ. // // ",
  "tha-ap394:28.1": "Paṭiyattāhutaṃ disvā ",
  "tha-ap394:28.2": "imaṃ vacanam abruviṃ: / ",
  "tha-ap394:28.3": "āvāho vā vivāho vā ",
  "tha-ap394:28.4": "rājā vā te nimantito? // // ",
  "tha-ap394:29.1": "Āhutīyiṭṭhukāmo haṃ ",
  "tha-ap394:29.2": "brāhmaṇe devasammate / ",
  "tha-ap394:29.3": "na nimantemi rājānam ",
  "tha-ap394:29.4": "āhutī me na vijjati. // // ",
  "tha-ap394:30.1": "*Na c' atthi mayham āvāho ",
  "tha-ap394:30.2": "vivāho me na vijjati.* / ",
  "tha-ap394:30.3": "Sakyānaṃ nandijanano ",
  "tha-ap394:30.4": "seṭṭho loke sadevake // // ",
  "tha-ap394:31.1": "sabbalokahitatthāya ",
  "tha-ap394:31.2": "sattasukhāvaho / ",
  "tha-ap394:31.3": "so me nimantito ajja ",
  "tha-ap394:31.4": "tass' etaṃ paṭiyātanaṃ. // // ",
  "tha-ap394:32.1": "Timbarūsakavaṇṇābho ",
  "tha-ap394:32.2": "appameyyo anupamo / ",
  "tha-ap394:32.3": "rūpenāsadiso Buddho ",
  "tha-ap394:32.4": "svātanāya nimantito. // // ",
  "tha-ap394:33.1": "Ukkāmukhapahaṭo va ",
  "tha-ap394:33.2": "khadiraṅgārasannibho / ",
  "tha-ap394:33.3": "*vijjupamo* mahāvīro ",
  "tha-ap394:33.4": "so me Buddho nimantito. // // ",
  "tha-ap394:34.1": "Pabbatagge yathā aggi punnamāse ",
  "tha-ap394:34.2": "va candimā / ",
  "tha-ap394:34.3": "naḷaggivaṇṇasaṅkāso ",
  "tha-ap394:34.4": "so me Buddho nimantito. // // ",
  "tha-ap394:35.1": "Asambhīto bhayātīto ",
  "tha-ap394:35.2": "bhavantakaraṇo muni / ",
  "tha-ap394:35.3": "sīhūpamo mahāvīro ",
  "tha-ap394:35.4": "so me Buddho nimantito. // // ",
  "tha-ap394:36.1": "Kusalo Buddhadhamme hi ",
  "tha-ap394:36.2": "appasayho parehi so / ",
  "tha-ap394:36.3": "nāgupamo mahāvīro ",
  "tha-ap394:36.4": "so . . . pe . . . // // ",
  "tha-ap394:37.1": "Saddhammacārakusalo ",
  "tha-ap394:37.2": "Buddhanāgo asādiso / ",
  "tha-ap394:37.3": "u*sa*bhūpamo mahāvīro ",
  "tha-ap394:37.4": "so . . . pe . . . // // ",
  "tha-ap394:38.1": "Anantavaṇṇo amitayaso ",
  "tha-ap394:38.2": "vicittasabbalakkhaṇo / ",
  "tha-ap394:38.3": "Sakkupamo mahāvīro ",
  "tha-ap394:38.4": "so . . . pe . . . // // ",
  "tha-ap394:39.1": "Vasīgaṇī patāpī ca ",
  "tha-ap394:39.2": "tejasī ca durāsado / ",
  "tha-ap394:39.3": "brahm*ūpa*mo mahāvīro ",
  "tha-ap394:39.4": "so . . . pe . . . // // Mahantadhammo ",
  "tha-ap394:40.1": "dasabalo ",
  "tha-ap394:40.2": "balātibalapārago / ",
  "tha-ap394:40.3": "dharaṇūpamo mahāvīro ",
  "tha-ap394:40.4": "so . . . pe . . . // // ",
  "tha-ap394:41.1": "Sīlavīcisamākiṇṇo ",
  "tha-ap394:41.2": "dhammaviññānakhobhito / ",
  "tha-ap394:41.3": "udadhūpamo mahāvīro ",
  "tha-ap394:41.4": "so . . . pe . . . // // ",
  "tha-ap394:42.1": "*Durāsado duppasaho* ",
  "tha-ap394:42.2": "acalo uggato brahā / ",
  "tha-ap394:42.3": "nāgūpamo mahāvīro ",
  "tha-ap394:42.4": "so . . . pe . . . // // ",
  "tha-ap394:43.1": "Anantañāṇo asamasamo ",
  "tha-ap394:43.2": "atulo aggataṃ gato / ",
  "tha-ap394:43.3": "gaganūpamo mahāvīro ",
  "tha-ap394:43.4": "so . . . pe . . . // // ",
  "tha-ap394:44.1": "",
  "tha-ap394:45.1": "Patiṭṭhā bhayabhītānaṃ ",
  "tha-ap394:45.2": "tāṇo saraṇagāminaṃ / ",
  "tha-ap394:45.3": "assāsako mahāvīro ",
  "tha-ap394:45.4": "so . . . pe . . . // // ",
  "tha-ap394:46.1": "Āsayo Buddhimantānaṃ ",
  "tha-ap394:46.2": "puññakhettaṃ sukhesinaṃ / ",
  "tha-ap394:46.3": "ratanākaro mahāvīro ",
  "tha-ap394:46.4": "so . . . pe . . . // // ",
  "tha-ap394:47.1": "Assāsako vedakaro ",
  "tha-ap394:47.2": "sāmaññaphaladāyako / ",
  "tha-ap394:47.3": "meghūpamo mahāvīro ",
  "tha-ap394:47.4": "so . . . pe . . . // // Loke samussito ",
  "tha-ap394:48.1": "vīro sabbantamavinodano / ",
  "tha-ap394:48.2": "",
  "tha-ap394:48.3": "suriyūpamo mahāvīro ",
  "tha-ap394:48.4": "so . . . pe . . . // // ",
  "tha-ap394:49.1": "Ārammaṇavimuttīsu ",
  "tha-ap394:49.2": "sabhāva-rasako muni / ",
  "tha-ap394:49.3": "candūpamo mahāvīro ",
  "tha-ap394:49.4": "so . . . pe . . . // // ",
  "tha-ap394:50.1": "",
  "tha-ap394:50.2": "",
  "tha-ap394:50.3": "",
  "tha-ap394:50.4": "",
  "tha-ap394:51.1": "Yassa ñāṇam appameyyaṃ ",
  "tha-ap394:51.2": "sīlaṃ yassa anūpamaṃ / ",
  "tha-ap394:51.3": "vimutti asadisā yassa ",
  "tha-ap394:51.4": "so . . . pe . . . // // ",
  "tha-ap394:52.1": "Yassa pīti asadisā ",
  "tha-ap394:52.2": "thāmo yassa acintiyo / ",
  "tha-ap394:52.3": "Yassa parakkamo seṭṭho ",
  "tha-ap394:52.4": "so . . . pe . . . // // ",
  "tha-ap394:53.1": "Rago doso ca moho ca ",
  "tha-ap394:53.2": "visā sabbe samūhatā / ",
  "tha-ap394:53.3": "agarūpamo mahāvīro ",
  "tha-ap394:53.4": "so . . . pe . . . // // Kilesavyādhibahūdukkhāsabbantamavinodako / ",
  "tha-ap394:54.1": "",
  "tha-ap394:54.2": "vijjūpamo ",
  "tha-ap394:54.3": "mahāvīro ",
  "tha-ap394:54.4": "so . . . pe . . . // // Buddho ti ",
  "tha-ap394:55.1": "bho yaṃ vadesi ",
  "tha-ap394:55.2": "ghoso p' eso sudullabho / ",
  "tha-ap394:55.3": "Buddho Buddho ti sutvāna ",
  "tha-ap394:55.4": "pīti me udapajjatha. // // ",
  "tha-ap394:56.1": "Abbhantaram agaṇhantaṃ ",
  "tha-ap394:56.2": "pīti me bahinicchare / ",
  "tha-ap394:56.3": "so 'haṃ pītimano santo ",
  "tha-ap394:56.4": "imaṃ vacanam abraviṃ: // // ",
  "tha-ap394:57.1": "Kahaṃ nu kho so bhagavā ",
  "tha-ap394:57.2": "lokajeṭṭho narāsabho / ",
  "tha-ap394:57.3": "kattha gantvāna passissaṃ ",
  "tha-ap394:57.4": "sāmaññaphaladāyakaṃ. // // ",
  "tha-ap394:58.1": "Paggayha dakkhiṇaṃ bahuṃ ",
  "tha-ap394:58.2": "vedajāto katañjalī / ",
  "tha-ap394:58.3": "ācikkha me dhammarājaṃ ",
  "tha-ap394:58.4": "sokasallavinodanaṃ. // // ",
  "tha-ap394:59.1": "Udentaṃ va mahāmeghaṃ ",
  "tha-ap394:59.2": "nīlaṃ añjanasannibhaṃ / ",
  "tha-ap394:59.3": "sāgaraṃ viya dissantaṃ ",
  "tha-ap394:59.4": "passass' etaṃ mahāvanaṃ. // // ",
  "tha-ap394:60.1": "Ettha so vasate Buddho ",
  "tha-ap394:60.2": "adantadamako muni / ",
  "tha-ap394:60.3": "vinayanto ca veneyye ",
  "tha-ap394:60.4": "bodhento bodhapakkhiye. // // ",
  "tha-ap394:61.1": "Pipāsito va udakaṃ ",
  "tha-ap394:61.2": "bhojanaṃ va jigacchito / ",
  "tha-ap394:61.3": "gāvī yathā vacchagiddhā ",
  "tha-ap394:61.4": "evāhaṃ viciniṃ jinaṃ. // // ",
  "tha-ap394:62.1": "Ācāra-upacāraññū ",
  "tha-ap394:62.2": "dhammānucchavasaṃvaraṃ / ",
  "tha-ap394:62.3": "sikkhāpesiṃ sake sisse ",
  "tha-ap394:62.4": "gacchanto jinasantikaṃ. // // ",
  "tha-ap394:63.1": "Durāsadā hi bhagavanto ",
  "tha-ap394:63.2": "sīhā va ekacārakā / ",
  "tha-ap394:63.3": "pāde pādaṃ nikkhipantā ",
  "tha-ap394:63.4": "āgaccheyyātha māṇavā. // // ",
  "tha-ap394:64.1": "Āsīviso yathā ghoro ",
  "tha-ap394:64.2": "migarājā va kesarī / ",
  "tha-ap394:64.3": "matto va kuñjaro dantī ",
  "tha-ap394:64.4": "evaṃ Buddhā durāsadā. // // ",
  "tha-ap394:65.1": "Ukkāsitaṃ va khipitam ",
  "tha-ap394:65.2": "ajjupekkhāya mānavā / ",
  "tha-ap394:65.3": "pade padaṃ nikkhipantā ",
  "tha-ap394:65.4": "upetha Buddhasantikaṃ. // // ",
  "tha-ap394:66.1": "Paṭisallāṇagarukā ",
  "tha-ap394:66.2": "appasaddā durāsadā / ",
  "tha-ap394:66.3": "durūpasaṅkamā Buddhā ",
  "tha-ap394:66.4": "garū honti sadevake. // // ",
  "tha-ap394:67.1": "Yāvāhaṃ pañhaṃ pucchāmi ",
  "tha-ap394:67.2": "paṭisammodiyāmi vā / ",
  "tha-ap394:67.3": "appasaddā tadā hotha ",
  "tha-ap394:67.4": "munibhūtā va tiṭṭhatha // // ",
  "tha-ap394:68.1": "Yaṃ so desesi saddhammaṃ ",
  "tha-ap394:68.2": "khemaṃ nibbānapattiyā / ",
  "tha-ap394:68.3": "tam ev' atthaṃ nisāmetha ",
  "tha-ap394:68.4": "saddhammasavanaṃ sukhaṃ. // // ",
  "tha-ap394:69.1": "Upasaṅkamma sambuddhaṃ ",
  "tha-ap394:69.2": "sammodiṃ muninā ahaṃ / ",
  "tha-ap394:69.3": "taṃ kathaṃ vītisāretvā ",
  "tha-ap394:69.4": "lakkhaṇe upadhārayiṃ. // // ",
  "tha-ap394:70.1": "Lakkhaṇe dve va kaṅkhāmi ",
  "tha-ap394:70.2": "passāmi tiṃsalakkhaṇe / ",
  "tha-ap394:70.3": "kosohitaṃ vatthaguyham ",
  "tha-ap394:70.4": "itthiyā dassayi muni. // // ",
  "tha-ap394:71.1": "Jīvhaṃ ninnāmayitvā ca ",
  "tha-ap394:71.2": "kaṇṇasote ca nāsike / ",
  "tha-ap394:71.3": "paṭimasanalāṭan taṃ ",
  "tha-ap394:71.4": "kevalaṃ chādayī jino. // // ",
  "tha-ap394:72.1": "Tassāhaṃ lakkhaṇe disvā ",
  "tha-ap394:72.2": "paripuṇṇe savyañjane / ",
  "tha-ap394:72.3": "Buddho ti niṭṭhaṃ gantvāna ",
  "tha-ap394:72.4": "saha sissehi pabbajiṃ. // // ",
  "tha-ap394:73.1": "Satehi tīhi sahito ",
  "tha-ap394:73.2": "pabbajim anagāriyaṃ / ",
  "tha-ap394:73.3": "aṭṭhamāse asampatte ",
  "tha-ap394:73.4": "sabbe patt' amha nibbutiṃ. // // ",
  "tha-ap394:74.1": "Ekato kammaṃ katvāna ",
  "tha-ap394:74.2": "puññakkhette anuttare / ",
  "tha-ap394:74.3": "ekato saṃsaritvāna ",
  "tha-ap394:74.4": "ekato vinivaṭṭayuṃ. // // ",
  "tha-ap394:75.1": "Gopānasīyo datvāna ",
  "tha-ap394:75.2": "pūgadhamme vasiṃ ahaṃ / ",
  "tha-ap394:75.3": "tena kammena sukatena ",
  "tha-ap394:75.4": "aṭṭhahetū labhām' ahaṃ. // // ",
  "tha-ap394:76.1": "Disāsu pūjito homi ",
  "tha-ap394:76.2": "bhogā ca amitā mama / ",
  "tha-ap394:76.3": "patiṭṭhā bhosiṃ sabbesaṃ ",
  "tha-ap394:76.4": "tāso mama na vijjati. // // ",
  "tha-ap394:77.1": "Vyādhiyo me na vijjanti ",
  "tha-ap394:77.2": "dīghāyuṃ pālayāmi ca / ",
  "tha-ap394:77.3": "sukhumacchaviko homi ",
  "tha-ap394:77.4": "āvāse patthite vase. // // ",
  "tha-ap394:78.1": "Aṭṭha gopānasī datvā ",
  "tha-ap394:78.2": "pūgadhamme vasiṃ ahaṃ / ",
  "tha-ap394:78.3": "paṭisambhidā 'rahattañ ca ",
  "tha-ap394:78.4": "etaṃ me aparaṭṭhamaṃ. // // ",
  "tha-ap394:79.1": "Sabbavosita vosāno ",
  "tha-ap394:79.2": "katakicco anāsavo / ",
  "tha-ap394:79.3": "Aṭṭhagopānasī nāma ",
  "tha-ap394:79.4": "tava putto mahāmuni. // // ",
  "tha-ap394:80.1": "Pañca thambhāni datvāna ",
  "tha-ap394:80.2": "pūgadhamme vasiṃ ahaṃ / ",
  "tha-ap394:80.3": "tena kammena sukatena ",
  "tha-ap394:80.4": "pañcahetū labhām' ahaṃ. // // ",
  "tha-ap394:81.1": "Acalo homi mettāya ",
  "tha-ap394:81.2": "anūnabhogavā-m-ahaṃ / ",
  "tha-ap394:81.3": "ādeyyavacano homi ",
  "tha-ap394:81.4": "na dhaṃsemi yathā ahaṃ. // // ",
  "tha-ap394:82.1": "Abhantaṃ hoti me cittam ",
  "tha-ap394:82.2": "acalo homi kassaci / ",
  "tha-ap394:82.3": "tena kammena sukatena ",
  "tha-ap394:82.4": "vimalo homi sāsane. // // ",
  "tha-ap394:83.1": "Sagāravo sappaṭisso ",
  "tha-ap394:83.2": "katakicco anāsavo / ",
  "tha-ap394:83.3": "sāvako te mahāvīra ",
  "tha-ap394:83.4": "bhikkhu taṃ vandate mune. // // ",
  "tha-ap394:84.1": "Katvā sukatapallaṅkaṃ ",
  "tha-ap394:84.2": "sālāyaṃ paññapes' ahaṃ / ",
  "tha-ap394:84.3": "tena kammena sukatena ",
  "tha-ap394:84.4": "pañca hetū labhām' ahaṃ. // // ",
  "tha-ap394:85.1": "Ucce kule pajāyāmi ",
  "tha-ap394:85.2": "mahābhogo bhavām' ahaṃ / ",
  "tha-ap394:85.3": "sabbasampattiko homi ",
  "tha-ap394:85.4": "maccheraṃ me na vijjati. // // ",
  "tha-ap394:86.1": "Gamane patthite mayhaṃ ",
  "tha-ap394:86.2": "pallaṅko upatiṭṭhati / ",
  "tha-ap394:86.3": "saha pallaṅkaseṭṭhena ",
  "tha-ap394:86.4": "gacchāmi mama patthitaṃ. // // ",
  "tha-ap394:87.1": "Tena pallaṅkadānena ",
  "tha-ap394:87.2": "tamaṃ sabbaṃ vinodayiṃ / ",
  "tha-ap394:87.3": "*sabbābhiññā-balappatto* ",
  "tha-ap394:87.4": "thero vandati taṃ mune. // // ",
  "tha-ap394:88.1": "Parakiccattakiccāni ",
  "tha-ap394:88.2": "sabbakiccāni sādhayiṃ / ",
  "tha-ap394:88.3": "tena kammena sukatena ",
  "tha-ap394:88.4": "pāvisim abhayaṃ puraṃ. // // ",
  "tha-ap394:89.1": "Pariniṭṭhitasālam pi ",
  "tha-ap394:89.2": "paribhogam adās' ahaṃ / ",
  "tha-ap394:89.3": "tena kammena sukatena ",
  "tha-ap394:89.4": "seṭṭhan tam ajjhupāgato. // // ",
  "tha-ap394:90.1": "Ye keci damakā loke ",
  "tha-ap394:90.2": "hatthī asse damenti 'me / ",
  "tha-ap394:90.3": "karetvā kāraṇā nānā ",
  "tha-ap394:90.4": "dārune na damenti te. // // ",
  "tha-ap394:91.1": "Na heva tvaṃ mahāvīra ",
  "tha-ap394:91.2": "damesi naranāriyo / ",
  "tha-ap394:91.3": "adaṇḍena asatthena ",
  "tha-ap394:91.4": "damesi *uttame dame.* // // ",
  "tha-ap394:92.1": "*Dāna*ssa vaṇṇaṃ kittento ",
  "tha-ap394:92.2": "desanākusalo muni / ",
  "tha-ap394:92.3": "ekapañhe kathento va ",
  "tha-ap394:92.4": "mocesi tisate muni. // // ",
  "tha-ap394:93.1": "Dantā mayaṃ sārathinā ",
  "tha-ap394:93.2": "suvimuttā anāsavā / ",
  "tha-ap394:93.3": "sabbābhiññā-balappattā ",
  "tha-ap394:93.4": "nibbutā upadhikkhaye. // // ",
  "tha-ap394:94.1": "Satasahasse ito kappe ",
  "tha-ap394:94.2": "yaṃ dānam adadiṃ tadā / ",
  "tha-ap394:94.3": "atikkantā bhayā sabbe ",
  "tha-ap394:94.4": "sāladānass' idaṃ phalaṃ. // // ",
  "tha-ap394:95.1": "Sāgataṃ . . . pe . . . pe . . . // // Kilesā . . . ",
  "tha-ap394:95.2": "pe . . . ",
  "tha-ap394:95.3": "",
  "tha-ap394:96.1": "",
  "tha-ap394:96.2": "pe . . . // // ",
  "tha-ap394:96.3": "",
  "tha-ap394:97.1": "Paṭisambhidā . . . ",
  "tha-ap394:97.2": "pe . . . ",
  "tha-ap394:97.3": "pe . . . // // ",
  "tha-ap394:98.1": "Itthaṃ sudam āyasmā Selo sapariso bhagavato santike imā gāthāyo abhāsitthāti. *Selattherassa apadānaṃ samattaṃ.* Kanikāraṃ va ",
  "tha-ap394:99.1": ""
}
