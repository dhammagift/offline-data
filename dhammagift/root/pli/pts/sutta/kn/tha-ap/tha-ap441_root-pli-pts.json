  "tha-ap441:1.1": "Hatthirājā tadā āsiṃ ",
  "tha-ap441:1.2": "īsādanto urūḷhavo / ",
  "tha-ap441:1.3": "vicaranto brahmāraññe ",
  "tha-ap441:1.4": "addasaṃ lokanāyakaṃ. // // ",
  "tha-ap441:2.1": "Ambapiṇḍiṃ gahetvāna ",
  "tha-ap441:2.2": "adāsiṃ satthuno ahaṃ / ",
  "tha-ap441:2.3": "paṭigaṇhi mahāvīro ",
  "tha-ap441:2.4": "Siddhattho lokanāyako. // // ",
  "tha-ap441:3.1": "Mamaṃ nijjhāyamānassa ",
  "tha-ap441:3.2": "paribhuñji tadā jino / ",
  "tha-ap441:3.3": "tattha cittaṃ pasādetvā ",
  "tha-ap441:3.4": "Tusitam upapajj' ahaṃ. // // ",
  "tha-ap441:4.1": "Tato ahaṃ cavitvāna ",
  "tha-ap441:4.2": "cakkavatti ahos' ahaṃ / ",
  "tha-ap441:4.3": "eten' eva upāyena ",
  "tha-ap441:4.4": "an*ubhutvāna* sampadā // // ",
  "tha-ap441:5.1": "pa*dhānaṃ pahitatto 'haṃ ",
  "tha-ap441:5.2": "upasanto nirūpadhi / ",
  "tha-ap441:5.3": "sabbāsave pariññāya ",
  "tha-ap441:5.4": "viharāmi anāsavo. // // ",
  "tha-ap441:6.1": "Catunavute ito kappe ",
  "tha-ap441:6.2": "yaṃ phalam adadiṃ tadā / ",
  "tha-ap441:6.3": "duggatiṃ nābhijānāmi ",
  "tha-ap441:6.4": "phaladānass' idaṃ phalaṃ. // // ",
  "tha-ap441:7.1": "Kilesa . . . ",
  "tha-ap441:7.2": "pe . . . ",
  "tha-ap441:7.3": "",
  "tha-ap441:8.1": "",
  "tha-ap441:8.2": "pe . . . ",
  "tha-ap441:8.3": "pe . . . // // Sāgataṃ . . . pe . . . pe . . . pe . . . // // ",
  "tha-ap441:9.1": "Paṭisambhida . . . ",
  "tha-ap441:9.2": "pe . . . ",
  "tha-ap441:9.3": "pe . . . pe . . . // // ",
  "tha-ap441:10.1": "Itthaṃ sudam āyasmā Ambapiṇḍiyo thero i. g. a-ti. Ambapiṇḍiyattherassa apadānaṃ samattaṃ. ",
  "tha-ap441:11.1": ""
}
