  "tha-ap171:1.1": "nagare ",
  "tha-ap171:1.2": "mahāpūgagaṇo ahu / ",
  "tha-ap171:1.3": "tesāhaṃ pavaro āsiṃ ",
  "tha-ap171:1.4": "mama paddhacarā ca te. // // Te ",
  "tha-ap171:2.1": "sabbe sannipātetvā ",
  "tha-ap171:2.2": "puññakamme samādiyiṃ / ",
  "tha-ap171:2.3": "māḷaṃ kassāma saṅghassa ",
  "tha-ap171:2.4": "puññakkhettam anuttaraṃ. // // ",
  "tha-ap171:3.1": "Sādhū ti te paṭissutvā ",
  "tha-ap171:3.2": "ma*ma chandavasānugā / ",
  "tha-ap171:3.3": "niṭṭhā*pesuñ ca taṃ māḷaṃ ",
  "tha-ap171:3.4": "Vipassissa adamhase. // // ",
  "tha-ap171:4.1": "Ekanavute ito kappe ",
  "tha-ap171:4.2": "yaṃ māḷam adadiṃ tadā / ",
  "tha-ap171:4.3": "duggatiṃ nābhijānāmi ",
  "tha-ap171:4.4": "māḷadānass' idaṃ phalaṃ. // // ",
  "tha-ap171:5.1": "Ekūnasaṭṭhikappamhi ",
  "tha-ap171:5.2": "eko āsi janādhipo / ",
  "tha-ap171:5.3": "Āveyyo *nāma nā*mena ",
  "tha-ap171:5.4": "cakkavattī mahabbalo. // // ",
  "tha-ap171:6.1": "Paṭisambhidā . . . ",
  "tha-ap171:6.2": "pe . . . ",
  "tha-ap171:6.3": "pe . . . // // ",
  "tha-ap171:7.1": "Itthaṃ sudaṃ ā. Samādapako thero i. g. ā-ti. Samādapakattherassa apadānaṃ samattaṃ. ",
  "tha-ap171:8.1": ""
}
