  "tha-ap396:1.1": "*Sindhuyā nadiyā tīre ",
  "tha-ap396:1.2": "sukato assamo mama / ",
  "tha-ap396:1.3": "tassa vācem' ahaṃ sisse ",
  "tha-ap396:1.4": "itihāsaṃ salakkhaṇaṃ. // // ",
  "tha-ap396:2.1": "Dhammakāmā vinītā te ",
  "tha-ap396:2.2": "sotukāmā pi sāsanaṃ* / ",
  "tha-ap396:2.3": "Chalaṅge pāramiṃ pattā ",
  "tha-ap396:2.4": "Sindhukūle vasanti te. // // ",
  "tha-ap396:3.1": "Uppādāgamane c' eva ",
  "tha-ap396:3.2": "lakkhaṇesu ca kovidā / ",
  "tha-ap396:3.3": "uttamatthaṃ gavesantā ",
  "tha-ap396:3.4": "vasanti pavane tadā. // // ",
  "tha-ap396:4.1": "Sumedho nāma sambuddho ",
  "tha-ap396:4.2": "loke uppajji tāvade / ",
  "tha-ap396:4.3": "amhākam anukampanto ",
  "tha-ap396:4.4": "upagacchi vināyako. // // ",
  "tha-ap396:5.1": "Upāgataṃ mahāvīraṃ ",
  "tha-ap396:5.2": "Sumedhaṃ lokanāyakaṃ / ",
  "tha-ap396:5.3": "tiṇasantharakaṃ katvā ",
  "tha-ap396:5.4": "lokajeṭṭhass' adās' ahaṃ. // // ",
  "tha-ap396:6.1": "Pavanāto madhuṃ gayha ",
  "tha-ap396:6.2": "Buddhaseṭṭhass' adās' ahaṃ / ",
  "tha-ap396:6.3": "sambuddho paribh*uñjitvā ",
  "tha-ap396:6.4": "idaṃ vacanam abravi:* // // ",
  "tha-ap396:7.1": "Yan taṃ adāsi madhuṃ me ",
  "tha-ap396:7.2": "pasanno sehi pānihi / ",
  "tha-ap396:7.3": "tam ahaṃ kittayissāmi; ",
  "tha-ap396:7.4": "suṇotha mama bhāsato: // // ",
  "tha-ap396:8.1": "Iminā madhudānena ",
  "tha-ap396:8.2": "tiṇasanthārakena ca / ",
  "tha-ap396:8.3": "tiṃsakappasahassāni ",
  "tha-ap396:8.4": "devaloke ramissati. // // ",
  "tha-ap396:9.1": "Tiṃsakappasahassāni ",
  "tha-ap396:9.2": "*Okkākakula*sambhavo / ",
  "tha-ap396:9.3": "Gotamo nāma nāmena ",
  "tha-ap396:9.4": "satthā loke bhavissati. // // ",
  "tha-ap396:10.1": "Tassa dhammesu dāyādo ",
  "tha-ap396:10.2": "oraso dhammanimmito / ",
  "tha-ap396:10.3": "sabbāsave pariññāya ",
  "tha-ap396:10.4": "nibbāyissati 'nāsavo. // // ",
  "tha-ap396:11.1": "Devalokā idhāgantvā ",
  "tha-ap396:11.2": "mātukucchim upāgato / ",
  "tha-ap396:11.3": "madhuvasso pavassittha ",
  "tha-ap396:11.4": "chādayaṃ madhunā mahiṃ. // // ",
  "tha-ap396:12.1": "Mama nikkhantamattamhi ",
  "tha-ap396:12.2": "kumbhiyā vasuduttarā / ",
  "tha-ap396:12.3": "tatrāpi madhuvasso me ",
  "tha-ap396:12.4": "vassate niccakālikaṃ. // // ",
  "tha-ap396:13.1": "Agārā abhinikkhamma ",
  "tha-ap396:13.2": "pabbajjim anagāriyaṃ / ",
  "tha-ap396:13.3": "lābhī annassa pānassa ",
  "tha-ap396:13.4": "madhudānass' idaṃ phalaṃ. // // ",
  "tha-ap396:14.1": "Sabbakāmasamiddho 'haṃ ",
  "tha-ap396:14.2": "bhavitvā devamānuse / ",
  "tha-ap396:14.3": "ten' eva madhudānena ",
  "tha-ap396:14.4": "patto 'mhi āsavakkhayaṃ. // // ",
  "tha-ap396:15.1": "Vuṭṭhamhi deve caturaṅgule tiṇe / ",
  "tha-ap396:15.2": "samphīte dharaṇīruhe ca chappade // // ",
  "tha-ap396:15.3": "Suññe ghare maṇḍaparukkhamūlake / ",
  "tha-ap396:15.4": "vasāmi niccaṃ sukhito anāsavo. // // ",
  "tha-ap396:16.1": "Majjhe mayhaṃ bhavā assu ye ",
  "tha-ap396:16.2": "bhave samatikkamiṃ / ",
  "tha-ap396:16.3": "ajja me āsavā khīṇā ",
  "tha-ap396:16.4": "n' atthi dāni punabbhavo. // // ",
  "tha-ap396:17.1": "Tiṃsakappasahassamhi ",
  "tha-ap396:17.2": "yaṃ dānam adadiṃ tadā / ",
  "tha-ap396:17.3": "duggatiṃ nābhijānāmi ",
  "tha-ap396:17.4": "madhudānass' idaṃ phalaṃ. // // ",
  "tha-ap396:18.1": "Kilesā . . . ",
  "tha-ap396:18.2": "",
  "tha-ap396:18.3": "",
  "tha-ap396:18.4": "",
  "tha-ap396:19.1": "",
  "tha-ap396:19.2": "pe . . . ",
  "tha-ap396:19.3": "pe . . . // // Sāgataṃ . . . pe . . . pe . . . // // ",
  "tha-ap396:20.1": "Paṭisambhidā . . . ",
  "tha-ap396:20.2": "pe . . . ",
  "tha-ap396:20.3": "pe . . . // // ",
  "tha-ap396:21.1": "Itthaṃ sudam āyasmā Madhudāyako thero i. g. a-ti. *Madhudāyakattherassa apadānaṃ samattaṃ.* ",
  "tha-ap396:22.1": ""
}
