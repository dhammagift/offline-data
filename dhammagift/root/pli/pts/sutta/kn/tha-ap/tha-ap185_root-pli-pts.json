  "tha-ap185:0.1": "",
  "tha-ap185:0.2": "",
  "tha-ap185:0.3": "",
  "tha-ap185:1.1": "jotantaṃ ",
  "tha-ap185:1.2": "nisinnaṃ pabbatantare / ",
  "tha-ap185:1.3": "appameyyaṃ va udadhim ",
  "tha-ap185:1.4": "uddhataṃ dharaṇiṃ yathā. // // ",
  "tha-ap185:2.1": "Paretaṃ devasaṅghena ",
  "tha-ap185:2.2": "nisabhājāniyaṃ yathā / ",
  "tha-ap185:2.3": "haṭṭho haṭṭhena cittena ",
  "tha-ap185:2.4": "upagacchiṃ naruttamaṃ. // // ",
  "tha-ap185:3.1": "Satta pupphāni paggayha ",
  "tha-ap185:3.2": "koṭumbarasamākulaṃ / ",
  "tha-ap185:3.3": "Buddhassa abhiropesiṃ ",
  "tha-ap185:3.4": "Sikhino lokabandhuno. // // ",
  "tha-ap185:4.1": "Ekatiṃse ito kappe ",
  "tha-ap185:4.2": "yaṃ puppham abhipūjayiṃ / ",
  "tha-ap185:4.3": "duggatiṃ nābhijānāmi ",
  "tha-ap185:4.4": "Buddhapūjāy' idaṃ phalaṃ. // // ",
  "tha-ap185:5.1": "Ito vīsatikappamhi ",
  "tha-ap185:5.2": "Mahānela-sanāmako / ",
  "tha-ap185:5.3": "eko āsiṃ mahātejo ",
  "tha-ap185:5.4": "cakkavattī mahabbalo. // // ",
  "tha-ap185:6.1": "Paṭisambhidā . . . ",
  "tha-ap185:6.2": "pe . . . ",
  "tha-ap185:6.3": "pe . . . // // ",
  "tha-ap185:7.1": "Itthaṃ sudam āyasmā Koṭumbariyo thero i. g. a-ti. Koṭumbariyattherassa ",
  "tha-ap185:8.1": "apadānaṃ samattaṃ. "
}
