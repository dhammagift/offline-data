{
  "tha-ap405:0.1": "",
  "tha-ap405:0.2": "",
  "tha-ap405:0.3": "",
  "tha-ap405:1.1": "",
  "tha-ap405:1.2": "Asoko nāma pabbato / ",
  "tha-ap405:1.3": "tatthāsi assamo mayhaṃ ",
  "tha-ap405:1.4": "Vissakammena māpito. // // ",
  "tha-ap405:2.1": "Sumedho nāma sambuddho ",
  "tha-ap405:2.2": "aggo kāruṇiko muni / ",
  "tha-ap405:2.3": "nivāsayitvā pubbanhe ",
  "tha-ap405:2.4": "piṇḍāya me upāgami. // // ",
  "tha-ap405:3.1": "Upāgataṃ mahāvīram ",
  "tha-ap405:3.2": "Sumedhaṃ lokanāyakaṃ / ",
  "tha-ap405:3.3": "paggayha subhakaṃ pattaṃ ",
  "tha-ap405:3.4": "sappitelam apūrayiṃ. // // ",
  "tha-ap405:4.1": "Datvān' ahaṃ Buddhaseṭṭhe ",
  "tha-ap405:4.2": "Sumedhe lokanāyake / ",
  "tha-ap405:4.3": "añjaliṃ paggahetvāna ",
  "tha-ap405:4.4": "bhīyyo hāsaṃ janes' ahaṃ. // // ",
  "tha-ap405:5.1": "Iminā sappidānena ",
  "tha-ap405:5.2": "cetanāpanidhīhi ca / ",
  "tha-ap405:5.3": "devabhūto manusso vā ",
  "tha-ap405:5.4": "labhāmi vipulaṃ sukhaṃ. // // ",
  "tha-ap405:6.1": "Vinipātaṃ vivajjetvā ",
  "tha-ap405:6.2": "saṃsarāmi bhavābhave / ",
  "tha-ap405:6.3": "tattha cittaṃ paṇidhitvā ",
  "tha-ap405:6.4": "labhāmi acalaṃ padaṃ. // // ",
  "tha-ap405:7.1": "Lābhā tuyhaṃ suladdhan te ",
  "tha-ap405:7.2": "yaṃ mam addakkhi brāhmaṇo / ",
  "tha-ap405:7.3": "mama dassanam āgamma arahā ",
  "tha-ap405:7.4": "tvaṃ bhavissasi. // // ",
  "tha-ap405:8.1": "Vissaṭṭho hohi; mā bhāyi ",
  "tha-ap405:8.2": "adhigantvā mahāyasaṃ / ",
  "tha-ap405:8.3": "mamaṃ hi sappiṃ datvāna ",
  "tha-ap405:8.4": "parimokkhasi jātiyā. // // ",
  "tha-ap405:9.1": "Iminā sappidānena ",
  "tha-ap405:9.2": "",
  "tha-ap405:9.3": "",
  "tha-ap405:9.4": "",
  "tha-ap405:10.1": "",
  "tha-ap405:10.2": "mettacittavatāya ca / ",
  "tha-ap405:10.3": "aṭṭhārase kappasate ",
  "tha-ap405:10.4": "devaloke ramissasi. // // ",
  "tha-ap405:11.1": "Aṭṭhārase ca kkhattuṃ tvaṃ ",
  "tha-ap405:11.2": "devarājā bhavissasi / ",
  "tha-ap405:11.3": "padesarajjaṃ vipulaṃ ",
  "tha-ap405:11.4": "gaṇanāto asaṅkhiyaṃ. // // ",
  "tha-ap405:12.1": "Ekapaññāsakkhattuṃ ca ",
  "tha-ap405:12.2": "cakkavattī bhavissasi / ",
  "tha-ap405:12.3": "caturanto vijitāvī ",
  "tha-ap405:12.4": "jambusaṇḍassa issaro. // // ",
  "tha-ap405:13.1": "Mahāsamuddo va 'kkhobho ",
  "tha-ap405:13.2": "duddharo pathavī yathā / ",
  "tha-ap405:13.3": "evameva ca te bhogā ",
  "tha-ap405:13.4": "appameyyā bhavissare. // // ",
  "tha-ap405:14.1": "Saṭṭhikoṭī hiraññassa ",
  "tha-ap405:14.2": "datvāna pabbajiṃ ahaṃ / ",
  "tha-ap405:14.3": "kiṃ kusalaṃ gavesanto ",
  "tha-ap405:14.4": "Bāvarim upasaṅkamiṃ. // // ",
  "tha-ap405:15.1": "Tattha mante adhīyāmi ",
  "tha-ap405:15.2": "chalaṅgaṃ nāma lakkhaṇaṃ / ",
  "tha-ap405:15.3": "tam andhakāraṃ vidhamam ",
  "tha-ap405:15.4": "uppajji tvaṃ mahāmuni. // // ",
  "tha-ap405:16.1": "Tava dassanakāmo 'haṃ ",
  "tha-ap405:16.2": "āgato 'mhi mahāmune / ",
  "tha-ap405:16.3": "tava dhammaṃ suṇitvāna ",
  "tha-ap405:16.4": "patto 'mhi acalaṃ padaṃ. // // ",
  "tha-ap405:17.1": "Tiṃsakappasahassamhi ",
  "tha-ap405:17.2": "sappiṃ Buddhass'adās' ahaṃ / ",
  "tha-ap405:17.3": "etthantare nābhijāne ",
  "tha-ap405:17.4": "sappiṃ viññāpitaṃ mayā. // // ",
  "tha-ap405:18.1": "Mama saṅkappam aññāya ",
  "tha-ap405:18.2": "uppajjati yadicchakaṃ / ",
  "tha-ap405:18.3": "cittam aññāya nibbattaṃ ",
  "tha-ap405:18.4": "sabbe santappayām' ahaṃ. // // ",
  "tha-ap405:19.1": "Aho Buddhā aho dhammā ",
  "tha-ap405:19.2": "aho no satthu sampadā / ",
  "tha-ap405:19.3": "thokaṃ hi sappiṃ datvāna ",
  "tha-ap405:19.4": "appameyyaṃ labhām' ahaṃ. // // ",
  "tha-ap405:20.1": "Mahāsamudde udakaṃ ",
  "tha-ap405:20.2": "yāvatā Nerupassato / ",
  "tha-ap405:20.3": "mama sappim upādāya ",
  "tha-ap405:20.4": "kalabhāgaṃ na hessati. // // ",
  "tha-ap405:21.1": "Yāvatā cakkavālassa ",
  "tha-ap405:21.2": "kayiraṃtassa rāsito / ",
  "tha-ap405:21.3": "mayā nivatthavatthānam ",
  "tha-ap405:21.4": "okāso so na sammati. // // ",
  "tha-ap405:22.1": "Pabbatarājā Himavā ",
  "tha-ap405:22.2": "pavaro pi siluccayo / ",
  "tha-ap405:22.3": "mamānulittagandhassa ",
  "tha-ap405:22.4": "upanīyaṃ na hessati. // // ",
  "tha-ap405:23.1": "Vatthaṃ gandhañ ca sappiñ ca aññaṃ ",
  "tha-ap405:23.2": "vā diṭṭhadhammikaṃ / ",
  "tha-ap405:23.3": "asaṅkhataṃ ca nibbānaṃ ",
  "tha-ap405:23.4": "sappidānass' idaṃ phalaṃ. // // ",
  "tha-ap405:24.1": "Satipaṭṭhānasayano ",
  "tha-ap405:24.2": "samādhijjhānagocaro / ",
  "tha-ap405:24.3": "bhojjhaṅgabhojano ajja ",
  "tha-ap405:24.4": "sappidānass' idaṃ phalaṃ. // // ",
  "tha-ap405:25.1": "Kilesā . . . ",
  "tha-ap405:25.2": "pe . . . ",
  "tha-ap405:25.3": "",
  "tha-ap405:26.1": "",
  "tha-ap405:26.2": "pe . . . // // ",
  "tha-ap405:26.3": "Sāgataṃ . . . pe . . . pe . . . // // ",
  "tha-ap405:27.1": "Paṭisambhidā . . . ",
  "tha-ap405:27.2": "pe . . . ",
  "tha-ap405:27.3": "pe . . . // // ",
  "tha-ap405:28.1": "Itthaṃ sudam āyasmā Mettagū thero i. g. a-ti. Mettagūtherassa apadānaṃ samattaṃ. ",
  "tha-ap405:29.1": ""
}
