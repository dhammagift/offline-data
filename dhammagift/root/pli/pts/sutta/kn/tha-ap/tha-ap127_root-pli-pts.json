{
  "tha-ap127:0.1": "",
  "tha-ap127:0.2": "",
  "tha-ap127:0.3": "",
  "tha-ap127:1.1": "Jāyamāne Vipassimhi ",
  "tha-ap127:1.2": "nimittaṃ vyākariṃ ahaṃ / ",
  "tha-ap127:1.3": "nibbāpayañ ca janataṃ ",
  "tha-ap127:1.4": "Buddho loke bhavissati. // // ",
  "tha-ap127:2.1": "Yasmiṃ ca jāyamānasmiṃ ",
  "tha-ap127:2.2": "dasasahassī pakampati / ",
  "tha-ap127:2.3": "so dāni bhagavā satthā ",
  "tha-ap127:2.4": "dhammaṃ deseti cakkhumā. // // ",
  "tha-ap127:3.1": "Yasmiṃ ca jāyamānasmiṃ ",
  "tha-ap127:3.2": "āloko vipulo ahu / ",
  "tha-ap127:3.3": "so dāni bhagavā satthā ",
  "tha-ap127:3.4": "dhammaṃ deseti cakkhumā. // // ",
  "tha-ap127:4.1": "Yasmiṃ ca jāyamānasmiṃ ",
  "tha-ap127:4.2": "saritāyo na sandisuṃ. / ",
  "tha-ap127:4.3": "so dāni bhagavā satthā ",
  "tha-ap127:4.4": "dhammaṃ deseti cakkhumā. // // ",
  "tha-ap127:5.1": "Yasmiṃ ca jāyamānasmiṃ ",
  "tha-ap127:5.2": "avīcaggi na pajjali / ",
  "tha-ap127:5.3": "do dāni . . . pe . . . // // ",
  "tha-ap127:5.4": "Yasmiṃ ca ",
  "tha-ap127:6.1": "jāyamānasmiṃ ",
  "tha-ap127:6.2": "pakkhisaṅgho na sañcari / ",
  "tha-ap127:6.3": "so dāni . . . ",
  "tha-ap127:6.4": "pe . . . // // ",
  "tha-ap127:7.1": "Yasmiñ ca jāyamānasmiṃ ",
  "tha-ap127:7.2": "vātakkhandho na vāyati / ",
  "tha-ap127:7.3": "so dāni . . . ",
  "tha-ap127:7.4": "pe . . . // // ",
  "tha-ap127:8.1": "Yasmiñ ca jāyamānasmiṃ ",
  "tha-ap127:8.2": "sabbaratanāni jotisuṃ / ",
  "tha-ap127:8.3": "so dāni . . . pe . . . // // ",
  "tha-ap127:8.4": "Yasmiṃ ca ",
  "tha-ap127:9.1": "jāyamānasmiṃ ",
  "tha-ap127:9.2": "sattesu pada-vikkamā / ",
  "tha-ap127:9.3": "so dāni . . . pe . . . // // ",
  "tha-ap127:9.4": "",
  "tha-ap127:10.1": "Jātamatto ca sambuddho ",
  "tha-ap127:10.2": "disā sabbā vilokayi / ",
  "tha-ap127:10.3": "vācāsabhiñ c' udīresi ",
  "tha-ap127:10.4": "esā Buddhāna-dhammatā. // // ",
  "tha-ap127:11.1": "Saṃvejayitvā janataṃ ",
  "tha-ap127:11.2": "thavitvā lokanāyakaṃ / ",
  "tha-ap127:11.3": "sambuddhaṃ abhivādetvā ",
  "tha-ap127:11.4": "pakkāmiṃ pācināmukho. // // ",
  "tha-ap127:12.1": "Ekanavute ito kappe ",
  "tha-ap127:12.2": "yaṃ Buddham abhithomayiṃ / ",
  "tha-ap127:12.3": "duggatiṃ nābhijānāmi ",
  "tha-ap127:12.4": "thomanāya idaṃ phalaṃ. // // ",
  "tha-ap127:13.1": "Ito navutikappamhi ",
  "tha-ap127:13.2": "Sammukhāthavikavhayo / ",
  "tha-ap127:13.3": "sattaratanasampanno ",
  "tha-ap127:13.4": "cakkavattī mahābalo. // // ",
  "tha-ap127:14.1": "Paṭhavidundubhi-nāma ",
  "tha-ap127:14.2": "ekūnanavutimhi 'to / ",
  "tha-ap127:14.3": "sattaratanasampanno ",
  "tha-ap127:14.4": "cakkavattī mahābalo. // // ",
  "tha-ap127:15.1": "Aṭṭhāsītimhi 'to kappe ",
  "tha-ap127:15.2": "Obhāsamata-khattiyo / ",
  "tha-ap127:15.3": "sattaratanasampanno ",
  "tha-ap127:15.4": "cakkavattī mahābalo // // ",
  "tha-ap127:16.1": "Sattā*sītimhi* 'to kappe ",
  "tha-ap127:16.2": "Saritacchedanavhayo / ",
  "tha-ap127:16.3": "sattaratanasampanno ",
  "tha-ap127:16.4": "cakkavattī mahābalo. // // ",
  "tha-ap127:17.1": "Agginibbāpano nāma ",
  "tha-ap127:17.2": "kappānaṃ chaḷāsītiyā / ",
  "tha-ap127:17.3": "sattaratanasampanno . . . ",
  "tha-ap127:17.4": "pe . . . // // Rājāvātasamo nāma kap*pānaṃ pañcāsītiyā* / sattaratanasampanno . . . pe . . . // // ",
  "tha-ap127:18.1": "Gatipacchedano nāma ",
  "tha-ap127:18.2": "kappānaṃ ",
  "tha-ap127:18.3": "",
  "tha-ap127:18.4": "",
  "tha-ap127:19.1": "",
  "tha-ap127:19.2": "cullasītiyā / ",
  "tha-ap127:19.3": "sattaratanasampanno . . . ",
  "tha-ap127:19.4": "pe . . . // // Ratanappajjalo ",
  "tha-ap127:20.1": "nāma ",
  "tha-ap127:20.2": "kappānaṃ te asītiyā / ",
  "tha-ap127:20.3": "sattaratanasampanno . . . ",
  "tha-ap127:20.4": "pe . . . // // ",
  "tha-ap127:21.1": "Padavikkamaṇo nāma ",
  "tha-ap127:21.2": "kappānaṃ dve asītiyā / ",
  "tha-ap127:21.3": "sattaratanasampanno . . . ",
  "tha-ap127:21.4": "pe . . . // // ",
  "tha-ap127:22.1": "Rājāvilokano nāma ",
  "tha-ap127:22.2": "kappānaṃ ekāsītiyā / ",
  "tha-ap127:22.3": "sattaratanasampanno . . . ",
  "tha-ap127:22.4": "pe . . . // // Hirisāro ",
  "tha-ap127:23.1": "'ti nāmena ",
  "tha-ap127:23.2": "kappe *'sītimhi* khattiyo / ",
  "tha-ap127:23.3": "sattaratanasampanno . . . ",
  "tha-ap127:23.4": "pe . . . // // ",
  "tha-ap127:24.1": "Paṭisambhidā catasso ",
  "tha-ap127:24.2": "vimokhā pi ca aṭṭh' ime / chaḍabhiññā sacchikatā ",
  "tha-ap127:24.3": "kataṃ Buddhassa sāsanan ti. // // ",
  "tha-ap127:25.1": "Itthaṃ sudaṃ āyasmā Sammukhāthaviko thero imā gāthāyo abhāsitthā ti. ",
  "tha-ap127:26.1": "Sammukhāthavikattherassa apadānaṃ samattaṃ. "
}
