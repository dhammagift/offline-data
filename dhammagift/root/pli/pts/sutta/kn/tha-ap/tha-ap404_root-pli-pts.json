  "tha-ap404:1.1": "Pabbhārakuṭaṃ nissāya ",
  "tha-ap404:1.2": "sayambhū aparājito / ",
  "tha-ap404:1.3": "ābādhiko va yo Buddho ",
  "tha-ap404:1.4": "vasati pabbatantare. // // ",
  "tha-ap404:2.1": "Mama assamasāmantā ",
  "tha-ap404:2.2": "panādo āsi tāvade / ",
  "tha-ap404:2.3": "Buddhe nibbāyamānamhi ",
  "tha-ap404:2.4": "āloko āsi tāvade. // // ",
  "tha-ap404:3.1": "Yāvatā vanasaṇḍasmiṃ ",
  "tha-ap404:3.2": "acchakokataracchayo / ",
  "tha-ap404:3.3": "vālā ca kesarī sabbe ",
  "tha-ap404:3.4": "abhigajjiṃsu tāvade. // // ",
  "tha-ap404:4.1": "Uppādaṃ tam ahaṃ disvā ",
  "tha-ap404:4.2": "pabbhāram agamās' ahaṃ / tatth' ",
  "tha-ap404:4.3": "addasāsiṃ sambuddhaṃ ",
  "tha-ap404:4.4": "nibbutam aparājitaṃ. // // ",
  "tha-ap404:5.1": "Suphullaṃ sālarājaṃ va ",
  "tha-ap404:5.2": "sataraṃsīva uggataṃ / ",
  "tha-ap404:5.3": "vītaccikaṃ va aṅgāraṃ ",
  "tha-ap404:5.4": "nibbutam aparājitaṃ. // // ",
  "tha-ap404:6.1": "Tīṇaṃ kaṭṭhañ ca pūretvā ",
  "tha-ap404:6.2": "citakaṃ tatth' akās ahaṃ / ",
  "tha-ap404:6.3": "citakaṃ sukataṃ katvā ",
  "tha-ap404:6.4": "sarīraṃ jhāpayim ahaṃ. // // ",
  "tha-ap404:7.1": "Sarīraṃ jhāpayitvāna ",
  "tha-ap404:7.2": "gandhatoyaṃ samokiriṃ / ",
  "tha-ap404:7.3": "antalikkhe ṭhito yakkho ",
  "tha-ap404:7.4": "nāmam aggahi tāvade. // // ",
  "tha-ap404:8.1": "Taṃ pūritaṃ tayā kiccaṃ ",
  "tha-ap404:8.2": "sayambhussa mahesino / ",
  "tha-ap404:8.3": "Puṇṇako nāma nāmena ",
  "tha-ap404:8.4": "sadā hohi tuvaṃ mune. // // ",
  "tha-ap404:9.1": "Tamhā kāyā cavitvāna ",
  "tha-ap404:9.2": "devalokam agacch ahaṃ / ",
  "tha-ap404:9.3": "tattha divyamayo gandho ",
  "tha-ap404:9.4": "antalikkhe pavāyati. // // ",
  "tha-ap404:10.1": "Tatrāpi nāmadheyyaṃ me ",
  "tha-ap404:10.2": "Puṇṇako ti ahū tadā. / ",
  "tha-ap404:10.3": "devabhūto manusso vā ",
  "tha-ap404:10.4": "saṅkappaṃ pūrayām ahaṃ. // // ",
  "tha-ap404:11.1": "Idaṃ pacchimakaṃ mayhaṃ ",
  "tha-ap404:11.2": "carimo vattate bhavo / ",
  "tha-ap404:11.3": "idhāpi Puṇṇako nāma ",
  "tha-ap404:11.4": "nāmaṃ mayhaṃ paññāyati. // // ",
  "tha-ap404:12.1": "Tosayitvāna sambuddhaṃ ",
  "tha-ap404:12.2": "Gotamaṃ Sakyapuṅgavaṃ / ",
  "tha-ap404:12.3": "sabbāsave pariññāya ",
  "tha-ap404:12.4": "viharāmi anāsavo. // // ",
  "tha-ap404:13.1": "Ekanavute ito kappe ",
  "tha-ap404:13.2": "yaṃ kammam akariṃ tadā / ",
  "tha-ap404:13.3": "duggatiṃ nābhijānāmi ",
  "tha-ap404:13.4": "tanukiccass' idaṃ phalaṃ. // // ",
  "tha-ap404:14.1": "Kilesā . . . ",
  "tha-ap404:14.2": "pe . . . ",
  "tha-ap404:14.3": "",
  "tha-ap404:15.1": "",
  "tha-ap404:15.2": "pe . . . // // ",
  "tha-ap404:15.3": "Sāgataṃ . . . pe . . . pe . . . // // ",
  "tha-ap404:16.1": "Paṭisambhidā . . . ",
  "tha-ap404:16.2": "pe . . . ",
  "tha-ap404:16.3": "pe . . . // // ",
  "tha-ap404:17.1": "Itthaṃ sudam āyasmā Puṇṇako thero i. g. a-ti. Puṇṇakattherassa apadānaṃ ",
  "tha-ap404:18.1": "samattaṃ. Himavantass' avidūre "
}
