  "tha-ap72:0.1": "",
  "tha-ap72:0.2": "",
  "tha-ap72:0.3": "",
  "tha-ap72:1.1": "Abhītarūpaṃ sīhaṃ va ",
  "tha-ap72:1.2": "garuḷaggaṃ va pakkhinaṃ / ",
  "tha-ap72:1.3": "vyagghusabhaṃ va pavaraṃ ",
  "tha-ap72:1.4": "abhijātaṃ va kesariṃ // // ",
  "tha-ap72:2.1": "Sikhiṃ tilokasaraṇaṃ ",
  "tha-ap72:2.2": "anejaṃ aparājitaṃ / ",
  "tha-ap72:2.3": "nisinnaṃ *samaṇaggaṃ* ",
  "tha-ap72:2.4": "bhikkhusaṅghapurakkhataṃ // // ",
  "tha-ap72:3.1": "Caṅgoṭake ṭhapetvāna ",
  "tha-ap72:3.2": "anojaṃ pupphamuttamaṃ / ",
  "tha-ap72:3.3": "sahacaṅgoṭaken' eva ",
  "tha-ap72:3.4": "Buddhaseṭṭhaṃ samokiriṃ. // // ",
  "tha-ap72:4.1": "Tena cittappasādena ",
  "tha-ap72:4.2": "dipadinda narāsabha / ",
  "tha-ap72:4.3": "patto 'mhi acalaṭṭhānaṃ ",
  "tha-ap72:4.4": "hitvā jayaparājayaṃ. // // ",
  "tha-ap72:5.1": "Ekatiṃse ito kappe ",
  "tha-ap72:5.2": "yaṃ kammam akariṃ tadā / ",
  "tha-ap72:5.3": "duggatiṃ nābhijānāmi ",
  "tha-ap72:5.4": "Buddhapūjāy' idaṃ phalaṃ. // // ",
  "tha-ap72:6.1": "Sampuṇṇe tiṃsakappamhi ",
  "tha-ap72:6.2": "Devabhūti-sanāmakā / ",
  "tha-ap72:6.3": "sattaratanasampannā ",
  "tha-ap72:6.4": "pañc' āsuṃ cakkavattino. // // ",
  "tha-ap72:7.1": "Paṭisambhidā catasso ",
  "tha-ap72:7.2": "vimokhā pi ca aṭṭh' ime / chaḷabhiññā sacchikatā ",
  "tha-ap72:7.3": "kataṃ Buddhassa sāsanan ti. // // ",
  "tha-ap72:8.1": "Itthaṃ sudaṃ āyasmā Pupphacaṅgoṭiyo thero imā gāthāyo abhāsitthā ti. ",
  "tha-ap72:9.1": "Pupphacaṅgoṭiyatherassa ",
  "tha-ap72:10.1": "apadānaṃ samattaṃ. ",
  "tha-ap72:11.1": "Uddānaṃ: ",
  "tha-ap72:12.1": "Sakacittaṃ Addhāpupphi ",
  "tha-ap72:12.2": "Paccābhigamanena ca ",
  "tha-ap72:12.3": "Parappasādi Bhisado ",
  "tha-ap72:12.4": "Sucinti Vatthadāyako. ",
  "tha-ap72:13.1": "Ambadāyi ca Sumano ",
  "tha-ap72:13.2": "Pupphacaṅgoṭiko pi ca ",
  "tha-ap72:13.3": "gāth' ekasattati vuttā ",
  "tha-ap72:13.4": "gaṇitā atthadassihi. "
}
