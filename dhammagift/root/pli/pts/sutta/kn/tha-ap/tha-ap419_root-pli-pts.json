  "tha-ap419:1.1": "Nagare Bandhumatiyā ",
  "tha-ap419:1.2": "ahosiṃ māliko tadā / ",
  "tha-ap419:1.3": "ucchaṅgaṃ pūrayitvāna ",
  "tha-ap419:1.4": "āgamam antarāpaṇaṃ. // // ",
  "tha-ap419:2.1": "Bhagavā ca tamhi samaye ",
  "tha-ap419:2.2": "bhikkhusaṅghapurakkhato / ",
  "tha-ap419:2.3": "mahatā ānubhāvena ",
  "tha-ap419:2.4": "niyyāti lokanāyako. // // ",
  "tha-ap419:3.1": "Disvāna lokapajjotaṃ ",
  "tha-ap419:3.2": "Vipassiṃ lokatāraṇaṃ / ",
  "tha-ap419:3.3": "pupphaṃ paggayha ucchaṅgā ",
  "tha-ap419:3.4": "Buddhaseṭṭham apūjayiṃ. // // ",
  "tha-ap419:4.1": "Ekanavute ito kappe ",
  "tha-ap419:4.2": "yaṃ puppham abhipūjayiṃ / ",
  "tha-ap419:4.3": "duggatiṃ nābhijānāmi ",
  "tha-ap419:4.4": "Buddhapūjāy' idaṃ phalaṃ. // // ",
  "tha-ap419:5.1": "Kilesā . . . ",
  "tha-ap419:5.2": "pe . . . ",
  "tha-ap419:5.3": "",
  "tha-ap419:6.1": "",
  "tha-ap419:6.2": "pe . . . // // ",
  "tha-ap419:6.3": "Sāgataṃ . . . pe . . . pe . . . // // ",
  "tha-ap419:7.1": "Paṭisambhidā . . . ",
  "tha-ap419:7.2": "pe . . . ",
  "tha-ap419:7.3": "pe . . . // // ",
  "tha-ap419:8.1": "Itthaṃ sudam āyasmā Ucchaṅgapupphiyo th. i. g. a-ti. Ucchaṅgapupphiyattherassa apadānaṃ samattaṃ. ",
  "tha-ap419:9.1": ""
}
