  "tha-ap432:1.1": "Manobhāvaniyaṃ Buddham ",
  "tha-ap432:1.2": "attadantaṃ samāhitaṃ / ",
  "tha-ap432:1.3": "iriyamānaṃ brahmapathe ",
  "tha-ap432:1.4": "citta-vūpasame rataṃ // // ",
  "tha-ap432:2.1": "Nittiṇṇa-oghaṃ sambuddhaṃ ",
  "tha-ap432:2.2": "jhāyi-jhānarataṃ muniṃ / ",
  "tha-ap432:2.3": "upaviṭṭhaṃ samāpannam ",
  "tha-ap432:2.4": "indīvaradalappabhaṃ // // ",
  "tha-ap432:3.1": "Alābun' odakaṃ gayha ",
  "tha-ap432:3.2": "Buddhaseṭṭham upāgamiṃ / ",
  "tha-ap432:3.3": "Buddhassa pāde dhovitvā ",
  "tha-ap432:3.4": "alābukam adās' ahaṃ. // // ",
  "tha-ap432:4.1": "Āṇāpesi ca sambuddho ",
  "tha-ap432:4.2": "Padamuttaranāyako / imin' ",
  "tha-ap432:4.3": "odakam āhatvā ",
  "tha-ap432:4.4": "pādamūle ṭhapehi me. // // ",
  "tha-ap432:5.1": "Sādhūti 'haṃ paṭissutvā ",
  "tha-ap432:5.2": "satthu gāravatāya ca / ",
  "tha-ap432:5.3": "udakaṃ lābun' āhatvā ",
  "tha-ap432:5.4": "Buddhaseṭṭham upānayiṃ. // // ",
  "tha-ap432:6.1": "Anumodi mahāvīro ",
  "tha-ap432:6.2": "cittaṃ nibbāpayaṃ mamaṃ: / ",
  "tha-ap432:6.3": "‘iminā lābudānena ",
  "tha-ap432:6.4": "saṅkappo te samijjhatu.' // // ",
  "tha-ap432:7.1": "Pannarasesu kappesu ",
  "tha-ap432:7.2": "devaloke ramiṃ ahaṃ / ",
  "tha-ap432:7.3": "tiṃsatikkhattuṃ rājā ca ",
  "tha-ap432:7.4": "cakkavattī ahos' ahaṃ. // // ",
  "tha-ap432:8.1": "Diva vā yadi vā rattiṃ ",
  "tha-ap432:8.2": "caṅkamantassa tiṭṭhato / ",
  "tha-ap432:8.3": "sovaṇṇaṃ kattaraṃ gayha ",
  "tha-ap432:8.4": "tiṭṭhati purato mama. // // ",
  "tha-ap432:9.1": "Buddhassa datvāna lābuṃ ",
  "tha-ap432:9.2": "labhāmi soṇṇakattaraṃ / ",
  "tha-ap432:9.3": "appakampikataṃ kāraṃ ",
  "tha-ap432:9.4": "vipulaṃ hoti tādisaṃ. // // Satasahasse ",
  "tha-ap432:10.1": "ito kappe ",
  "tha-ap432:10.2": "yam alābum adaṃ tadā / ",
  "tha-ap432:10.3": "duggatiṃ nābhijānāmi ",
  "tha-ap432:10.4": "alābussa idaṃ phalaṃ. // // ",
  "tha-ap432:11.1": "Kilesā . . . ",
  "tha-ap432:11.2": "pe . . . ",
  "tha-ap432:11.3": "",
  "tha-ap432:12.1": "",
  "tha-ap432:12.2": "pe . . . ",
  "tha-ap432:12.3": "pe . . . // // Sāgataṃ . . . pe . . . pe . . . pe . . . // // ",
  "tha-ap432:13.1": "Paṭisambhidā . . . ",
  "tha-ap432:13.2": "pe . . . ",
  "tha-ap432:13.3": "pe . . . pe . . . // // ",
  "tha-ap432:14.1": "Itthaṃ sudaṃ āyasmā Sovaṇṇakattariko th. i. g. a- ti. Sovaṇṇakattarikattherassa ",
  "tha-ap432:15.1": "",
  "tha-ap432:16.1": "apadānaṃ samattaṃ. ",
  "tha-ap432:17.1": "Uddānaṃ: ",
  "tha-ap432:18.1": "Sakiṃsammajjako thero ",
  "tha-ap432:18.2": "Ekadussī tath' Āsanī Kadamba- ",
  "tha-ap432:18.3": "Koraṇḍa tadā Ghataṃ ",
  "tha-ap432:18.4": "Savaniko pi ca ",
  "tha-ap432:19.1": "Sucintito Kiṅkhaniko Soṇṇa-kattariko ",
  "tha-ap432:19.2": "pi ca ",
  "tha-ap432:19.3": "ekaṃ gāthāsatañ c' ettha ",
  "tha-ap432:19.4": "ekasattati-m-eva ca. "
}
