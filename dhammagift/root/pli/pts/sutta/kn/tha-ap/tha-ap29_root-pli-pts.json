  "tha-ap29:0.3": "",
  "tha-ap29:1.1": "Vipassissa bhagavato ",
  "tha-ap29:1.2": "bodhiyā pādamuttame / purāṇaṃ puḷinaṃ chaḍḍetvā ",
  "tha-ap29:1.3": "suddhaṃ puḷinam ",
  "tha-ap29:1.4": "ākiriṃ. // // ",
  "tha-ap29:2.1": "Ekanavut' ito kappe ",
  "tha-ap29:2.2": "yaṃ puḷinam adās' ahaṃ / ",
  "tha-ap29:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap29:2.4": "puḷinadānass' idaṃ phalaṃ. // // ",
  "tha-ap29:3.1": "Tipaññāse ito kappe ",
  "tha-ap29:3.2": "rājā āsiṃ janādhibhū / ",
  "tha-ap29:3.3": "Mahāpuḷino nāmena ",
  "tha-ap29:3.4": "cakkavattī mahābalo. // // ",
  "tha-ap29:4.1": "Paṭisambhidā catasso ",
  "tha-ap29:4.2": "vimokhā pi ca aṭṭh' ime / ",
  "tha-ap29:4.3": "chaḍabhiññā sacchikatā ",
  "tha-ap29:4.4": "kataṃ Buddhassa sāsanan ti. // // ",
  "tha-ap29:5.1": "Itthaṃ sudaṃ āyasmā Puḷinapūjako thero imā gāthāyo abhāsitthā ti. ",
  "tha-ap29:6.1": "Puḷinapūjakatherassa apadānaṃ samattaṃ. "
}
