  "tha-ap300:1.1": "Pabbate Himavantamhi ",
  "tha-ap300:1.2": "ahosiṃ luddako tadā / ",
  "tha-ap300:1.3": "Vipassim addasaṃ Buddhaṃ ",
  "tha-ap300:1.4": "lokajeṭṭhaṃ narāsabhaṃ. // // ",
  "tha-ap300:2.1": "Upāsitvāna sambuddhaṃ ",
  "tha-ap300:2.2": "veyyāvaccam akās' ahaṃ / ",
  "tha-ap300:2.3": "saraṇañ ca upāgacchiṃ ",
  "tha-ap300:2.4": "dipadindassa tādino. // // ",
  "tha-ap300:3.1": "Ekanavute ito kappe ",
  "tha-ap300:3.2": "saraṇaṃ yam agacch' ahaṃ / ",
  "tha-ap300:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap300:3.4": "saraṇāgamanapphalaṃ. // // ",
  "tha-ap300:4.1": "Paṭisambhidā . . . ",
  "tha-ap300:4.2": "pe . . . ",
  "tha-ap300:4.3": "pe . . . // // ",
  "tha-ap300:5.1": "Itthaṃ sudam āyasmā Saraṇagamaniyo thero i. g. a-ti. Saraṇagamaniyattherassa ",
  "tha-ap300:6.1": "apadānaṃ samattaṃ. "
}
