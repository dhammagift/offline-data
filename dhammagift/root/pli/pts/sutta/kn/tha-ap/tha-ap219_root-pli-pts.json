  "tha-ap219:1.1": "Tālavaṇṭaṃ mayā dinnaṃ ",
  "tha-ap219:1.2": "Tissassādiccabandhuno / ",
  "tha-ap219:1.3": "*gimhanibbāpanatthāya ",
  "tha-ap219:1.4": "pari*ḷāhopasantiyā. // // ",
  "tha-ap219:2.1": "Sannibbāpemi rāgaggiṃ ",
  "tha-ap219:2.2": "dosaggiñ ca taduttariṃ / ",
  "tha-ap219:2.3": "nibbāpemi ca mohaggiṃ ",
  "tha-ap219:2.4": "tālavaṇṭass' idaṃ phalaṃ. // // ",
  "tha-ap219:3.1": "Kilesā jhāpitā mayhaṃ ",
  "tha-ap219:3.2": "bhavā sabbe samūhatā / ",
  "tha-ap219:3.3": "dhāremi antimaṃ *dehaṃ ",
  "tha-ap219:3.4": "sammāsambuddha*sāsane. // // ",
  "tha-ap219:4.1": "Dvenavute ito kappe ",
  "tha-ap219:4.2": "yaṃ kammam akariṃ tadā / ",
  "tha-ap219:4.3": "duggatiṃ nābhijānāmi ",
  "tha-ap219:4.4": "Buddhapūjāy' idaṃ phalaṃ. // // ",
  "tha-ap219:5.1": "Tesaṭṭhimhi ito kappe ",
  "tha-ap219:5.2": "Mahārām' āsu ",
  "tha-ap219:5.3": "nāmakā / sattaratanasampannā ",
  "tha-ap219:5.4": "cakkavattī mahabbalā. // // ",
  "tha-ap219:6.1": "Paṭisambhidā . . . ",
  "tha-ap219:6.2": "pe . . . ",
  "tha-ap219:6.3": "pe . . . // // ",
  "tha-ap219:7.1": "Itthaṃ sudam āyasmā Tālavaṇṭadāyako thero i. g. a-ti. Tālavaṇṭadāyakattherassa ",
  "tha-ap219:8.1": "apadānaṃ samattaṃ. "
}
