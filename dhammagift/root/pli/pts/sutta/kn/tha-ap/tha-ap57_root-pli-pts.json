  "tha-ap57:0.3": "",
  "tha-ap57:1.1": "Padumuttarabuddhassa ",
  "tha-ap57:1.2": "ājānīyam adās' ahaṃ / ",
  "tha-ap57:1.3": "niyyādetvāna sambuddhe ",
  "tha-ap57:1.4": "agamāsiṃ sakaṃ gharaṃ. // // ",
  "tha-ap57:2.1": "Devalo nāma nāmena ",
  "tha-ap57:2.2": "satthuno aggasāvako / ",
  "tha-ap57:2.3": "varadhammassa dāyādo ",
  "tha-ap57:2.4": "āgañchi mama santikaṃ: // // ",
  "tha-ap57:3.1": "‘Sapattabhāro bhagavā ",
  "tha-ap57:3.2": "ājāneyyo na kappati / ",
  "tha-ap57:3.3": "tava saṅkappam aññāya ",
  "tha-ap57:3.4": "adhivāsesi cakkhumā.' // // ",
  "tha-ap57:4.1": "Agghāpetvā vātajavaṃ ",
  "tha-ap57:4.2": "sindhavaṃ sī*ghavāhanaṃ* / ",
  "tha-ap57:4.3": "Padumuttarabuddhassa ",
  "tha-ap57:4.4": "ajānīyam adās' ahaṃ. // // ",
  "tha-ap57:5.1": "Yaṃ yaṃ yonupapajjāmi ",
  "tha-ap57:5.2": "bhavane ",
  "tha-ap57:5.3": "sabbadā ",
  "tha-ap57:5.4": "mama / ",
  "tha-ap57:6.1": "khamanīyā vātajavā citte nibbattare mamaṃ. // // Lābhā tesaṃ suladdhaṃ vā ",
  "tha-ap57:6.2": "ye labhant' upasampadaṃ / ",
  "tha-ap57:6.3": "punappayirūpāseyyaṃ ",
  "tha-ap57:6.4": "Buddho loke sace bhave. // // ",
  "tha-ap57:7.1": "Aṭṭhavīsatikkhattāhaṃ ",
  "tha-ap57:7.2": "rājā āsiṃ mahābalo / ",
  "tha-ap57:7.3": "caturanto vijitāvī ",
  "tha-ap57:7.4": "jambusaṇḍassa issaro. // // ",
  "tha-ap57:8.1": "Imaṃ pacchimakaṃ mayhaṃ ",
  "tha-ap57:8.2": "carimo vattate bhavo / ",
  "tha-ap57:8.3": "patto 'mhi acalaṃ ṭhānaṃ ",
  "tha-ap57:8.4": "hitvā jayaparājayaṃ. // // ",
  "tha-ap57:9.1": "Catu*ttiṃse sahassamhi* ",
  "tha-ap57:9.2": "mahātej' āsi khattiyo / ",
  "tha-ap57:9.3": "sattaratanasampanno ",
  "tha-ap57:9.4": "cakkavatti mahabbalo. // // ",
  "tha-ap57:10.1": "Paṭisambhidā catasso ",
  "tha-ap57:10.2": "vimokhā pi ca aṭṭh' ime / chaḷabhiññā sacchikatā ",
  "tha-ap57:10.3": "kataṃ Buddhassa sāsanan ti. // // ",
  "tha-ap57:11.1": "Itthaṃ sudaṃ āyasmā Opavuyho thero imā gathāyo abhāsitthā ti. Opavuyhattherassa apadānaṃ samattaṃ. ",
  "tha-ap57:12.1": ""
}
