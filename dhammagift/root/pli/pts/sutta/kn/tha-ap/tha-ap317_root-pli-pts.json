  "tha-ap317:0.3": "",
  "tha-ap317:1.1": "Suvaṇṇavaṇṇaṃ sambuddhaṃ ",
  "tha-ap317:1.2": "sataraṃsīva bhāṇumaṃ / ",
  "tha-ap317:1.3": "avidūrena gacchantaṃ ",
  "tha-ap317:1.4": "Siddhattham aparājitaṃ // // ",
  "tha-ap317:2.1": "Tassa paccuggamitvāna ",
  "tha-ap317:2.2": "pavesitvāna *assamaṃ / ",
  "tha-ap317:2.3": "pupphāsanaṃ mayā dinnaṃ* ",
  "tha-ap317:2.4": "vippasannena cetasā. // // ",
  "tha-ap317:3.1": "Añjaliṃ paggahetvāna ",
  "tha-ap317:3.2": "vedajāto tadā ahaṃ / ",
  "tha-ap317:3.3": "buddhe cittaṃ pasādetvā kamman ",
  "tha-ap317:3.4": "taṃ pariṇāmayiṃ. // // ",
  "tha-ap317:4.1": "Yam me atthi kataṃ puññaṃ ",
  "tha-ap317:4.2": "sayambhūmh' aparājite / ",
  "tha-ap317:4.3": "sabbena *tena kusalena ",
  "tha-ap317:4.4": "vimalo* homi sāsane. // // ",
  "tha-ap317:5.1": "Catunavute ito kappe ",
  "tha-ap317:5.2": "pupphāsanam adaṃ tadā / ",
  "tha-ap317:5.3": "duggatiṃ nābhijānāmi ",
  "tha-ap317:5.4": "pupphāsanass' idaṃ phalaṃ. // // ",
  "tha-ap317:6.1": "Paṭisambhidā . . . ",
  "tha-ap317:6.2": "pe . . . ",
  "tha-ap317:6.3": "pe . . . // // ",
  "tha-ap317:7.1": "Itthaṃ sudam āyasmā Pupphāsanadāyako thero i. g. a-ti. Pupphāsaniyattherassa ",
  "tha-ap317:8.1": "apadānaṃ samattaṃ. "
}
