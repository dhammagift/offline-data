  "tha-ap194:0.2": "",
  "tha-ap194:0.3": "",
  "tha-ap194:1.1": "Yaṃ dāyavāsiko isi ",
  "tha-ap194:1.2": "tiṇaṃ lāyati satthuno / ",
  "tha-ap194:1.3": "sabbe padakkhiṇā vattā ",
  "tha-ap194:1.4": "puṭhavyā nipatiṃsu te. // // ",
  "tha-ap194:2.1": "Tam ahaṃ tiṇam ādāya ",
  "tha-ap194:2.2": "santhariṃ dharaṇi-m-uttame / ",
  "tha-ap194:2.3": "tiṇe ca tālapattāni ",
  "tha-ap194:2.4": "āharitvān' ahaṃ tadā. // // ",
  "tha-ap194:3.1": "Taṃ tiṇaṃ chadanaṃ katvā ",
  "tha-ap194:3.2": "Siddhatthassa adās' ahaṃ / ",
  "tha-ap194:3.3": "sattāhaṃ dhārayuṃ tattha devāmanussā ",
  "tha-ap194:3.4": "satthuno. // // Catunavute ",
  "tha-ap194:4.1": "ito kappe ",
  "tha-ap194:4.2": "yaṃ tiṇaṃ adadiṃ tadā / ",
  "tha-ap194:4.3": "duggatiṃ nābhijānāmi ",
  "tha-ap194:4.4": "tiṇadānass' idaṃ phalaṃ. // // ",
  "tha-ap194:5.1": "Pañcasaṭṭhi ito kappe ",
  "tha-ap194:5.2": "cattāro 'suṃ Mahādhanā / ",
  "tha-ap194:5.3": "sattaratanasampannā ",
  "tha-ap194:5.4": "cakkavattī mahabbalā. // // ",
  "tha-ap194:6.1": "Paṭisambhidā . . . ",
  "tha-ap194:6.2": "pe . . . ",
  "tha-ap194:6.3": "pe . . . // // ",
  "tha-ap194:7.1": "Itthaṃ sudam āyasmā Tiṇasantharadāyako thero i. g. a-ti. Tiṇasantharadāyakattherassa ",
  "tha-ap194:8.1": "apadānaṃ samattaṃ. "
}
