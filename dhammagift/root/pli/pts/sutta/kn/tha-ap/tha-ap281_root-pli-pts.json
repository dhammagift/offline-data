  "tha-ap281:1.1": "Romaso nāma nāmena ",
  "tha-ap281:1.2": "sayambhū sappabho tadā / ",
  "tha-ap281:1.3": "puṇḍarīkaṃ mayā dinnaṃ ",
  "tha-ap281:1.4": "vippasannena cetasā. // // ",
  "tha-ap281:2.1": "Catunavute ito kappe ",
  "tha-ap281:2.2": "puṇḍarīkam adadiṃ tadā / ",
  "tha-ap281:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap281:2.4": "puṇḍarīkass' idaṃ phalaṃ. // // ",
  "tha-ap281:3.1": "Paṭisambhidā . . . ",
  "tha-ap281:3.2": "pe . . . ",
  "tha-ap281:3.3": "pe . . . // // ",
  "tha-ap281:4.1": "Itthaṃ sudam āyasmā Puṇḍarīko thero i. g. a-ti. Ekapuṇḍarīkattherassa apadānaṃ samattaṃ. ",
  "tha-ap281:5.1": ""
}
