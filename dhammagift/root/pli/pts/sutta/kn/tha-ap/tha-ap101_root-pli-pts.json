  "tha-ap101:0.3": "",
  "tha-ap101:1.1": "Vipassissa bhagavato ",
  "tha-ap101:1.2": "mahāpūgagaṇo ahu / ",
  "tha-ap101:1.3": "veyyāvaccakaro āsiṃ ",
  "tha-ap101:1.4": "sabbakiccesu vyāvaṭo. // // ",
  "tha-ap101:2.1": "Deyyadhammo ca me n' atthi ",
  "tha-ap101:2.2": "sugatassa mahesino / ",
  "tha-ap101:2.3": "avandiṃ satthuno pāde ",
  "tha-ap101:2.4": "vippasannena cetasā. // // ",
  "tha-ap101:3.1": "Ekanavut' ito kappe ",
  "tha-ap101:3.2": "veyyāvaccaṃ akās' ahaṃ / ",
  "tha-ap101:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap101:3.4": "veyyāvaccass' idaṃ phalaṃ. // // ",
  "tha-ap101:4.1": "Ito aṭṭhamake kappe ",
  "tha-ap101:4.2": "rājā āsiṃ Sucintito / ",
  "tha-ap101:4.3": "sattaratanasampanno ",
  "tha-ap101:4.4": "cakkavatti mahābalo. // // ",
  "tha-ap101:5.1": "Paṭisambhidā catasso ",
  "tha-ap101:5.2": "vimokhā pi ca aṭṭh' ime / chaḍabhiññā sacchikatā ",
  "tha-ap101:5.3": "kataṃ Buddhassa sāsanan ti. // // ",
  "tha-ap101:6.1": "Itthaṃ sudaṃ āyasmā Veyyāvaccakaro thero imā gāthāyo abhāsitthā ti. ",
  "tha-ap101:7.1": "Veyyāvaccakatherassa apadānaṃ samattaṃ. Vipassino "
}
