  "tha-ap103:0.1": "",
  "tha-ap103:0.2": "",
  "tha-ap103:0.3": "",
  "tha-ap103:1.1": "Suvaṇṇavaṇṇaṃ sambuddhaṃ ",
  "tha-ap103:1.2": "āhutīnaṃ paṭiggahaṃ / ",
  "tha-ap103:1.3": "pavarā abhinikkhantaṃ ",
  "tha-ap103:1.4": "vānā nibbānam āgataṃ. // // ",
  "tha-ap103:2.1": "Kaṭacchubhikkhaṃ pādāsiṃ ",
  "tha-ap103:2.2": "Siddhatthassa mahesino / ",
  "tha-ap103:2.3": "paññassa upasantassa ",
  "tha-ap103:2.4": "mahāvīrassa tādino. // // ",
  "tha-ap103:3.1": "Padenānupadaṃ-yanto ",
  "tha-ap103:3.2": "nibbāpentaṃ mahājanaṃ / ",
  "tha-ap103:3.3": "*vit*ti me pāhunā tāva ",
  "tha-ap103:3.4": "Buddhass' ādiccabandhuno. // // Catunavut' ",
  "tha-ap103:4.1": "ito kappe ",
  "tha-ap103:4.2": "yaṃ dānam adadiṃ tadā / ",
  "tha-ap103:4.3": "duggatiṃ nābhijānāmi ",
  "tha-ap103:4.4": "bhikkhadānass' idaṃ phalaṃ. // // ",
  "tha-ap103:5.1": "Sattāsītimhi 'to kappe ",
  "tha-ap103:5.2": "Mahāreṇussanāmakā / ",
  "tha-ap103:5.3": "sattaratanasampannā ",
  "tha-ap103:5.4": "satt' eva cakkavattino. // // ",
  "tha-ap103:6.1": "Paṭisambhidā catasso ",
  "tha-ap103:6.2": "vimokhā pi ca aṭṭh' ime / ",
  "tha-ap103:6.3": "chaḍabhiññā sacchikatā ",
  "tha-ap103:6.4": "kataṃ Buddhassa sāsanan ti. // // ",
  "tha-ap103:7.1": "Itthaṃ sudaṃ āyasmā Bhikkhadāyako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap103:8.1": "Bhikkhadāyakattherassa apadānaṃ samattaṃ. "
}
