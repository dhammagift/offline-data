{
  "tha-ap25:0.1": "",
  "tha-ap25:0.2": "",
  "tha-ap25:0.3": "",
  "tha-ap25:1.1": "Nagare Candavatiyā ",
  "tha-ap25:1.2": "mātupaṭṭhāyako ahuṃ / ",
  "tha-ap25:1.3": "andhā mātāpitā mayhaṃ ",
  "tha-ap25:1.4": "te posemi ahaṃ tadā. // // ",
  "tha-ap25:2.1": "Rahogato nisīditvā ",
  "tha-ap25:2.2": "evaṃ cintes' ahaṃ tadā / ",
  "tha-ap25:2.3": "pose*nto mātāpitaro ",
  "tha-ap25:2.4": "pabba*jjaṃ na labhām' ahaṃ // // Tamandhakārā pihitā ",
  "tha-ap25:3.1": "tividhaggī ",
  "tha-ap25:3.2": "pi ḍayhare / ",
  "tha-ap25:3.3": "etādise bhaye jāte ",
  "tha-ap25:3.4": "n' atthi koci vināyako. // // ",
  "tha-ap25:4.1": "Buddho loke samuppanno ",
  "tha-ap25:4.2": "dippati jinasāsanaṃ / ",
  "tha-ap25:4.3": "sakkā uttaritum attā ",
  "tha-ap25:4.4": "puññakammena *jantunā* // // ",
  "tha-ap25:5.1": "Uggayha tīṇisaraṇe ",
  "tha-ap25:5.2": "paripuṇṇāni gopayaṃ / ",
  "tha-ap25:5.3": "tena kammena sukatena ",
  "tha-ap25:5.4": "parimokkhāmi duggatiṃ // // ",
  "tha-ap25:6.1": "Nisabho nāma samaṇo ",
  "tha-ap25:6.2": "Buddhassa aggasāvako / ",
  "tha-ap25:6.3": "tam ahaṃ upagantvāna ",
  "tha-ap25:6.4": "saraṇāgamanaṃ gahiṃ. // // ",
  "tha-ap25:7.1": "Vassasatasahassāni ",
  "tha-ap25:7.2": "āyu *vijjati* tāvade / ",
  "tha-ap25:7.3": "tāvatā saraṇāgamaṇaṃ ",
  "tha-ap25:7.4": "paripuṇṇam agopayiṃ. // // ",
  "tha-ap25:8.1": "Carime vattamāṇamhi ",
  "tha-ap25:8.2": "saraṇan tam anussariṃ / ",
  "tha-ap25:8.3": "tena kammena sukatena ",
  "tha-ap25:8.4": "Tāvatiṃsaṃ agaṃch' ahaṃ // // ",
  "tha-ap25:9.1": "Devaloke gato santo ",
  "tha-ap25:9.2": "puññakammasamāhito / ",
  "tha-ap25:9.3": "yaṃ desaṃ upapajjāmi ",
  "tha-ap25:9.4": "aṭṭhahetū labhām' ahaṃ. // // ",
  "tha-ap25:10.1": "Disāsu pūjito homi ",
  "tha-ap25:10.2": "tikkhapañño bhavām ahaṃ / ",
  "tha-ap25:10.3": "sabbe devā 'nuvattanti ",
  "tha-ap25:10.4": "amitabhogaṃ labhām ahaṃ. // // ",
  "tha-ap25:11.1": "Suvaṇṇavaṇṇo sabbattha ",
  "tha-ap25:11.2": "paṭikkanto bhavām' ahaṃ / ",
  "tha-ap25:11.3": "mittānaṃ acalo homi ",
  "tha-ap25:11.4": "yaso accuggato mamaṃ. // // ",
  "tha-ap25:12.1": "Asītikkhattuṃ devindo ",
  "tha-ap25:12.2": "devarajjam akārayiṃ / dibbaṃ ",
  "tha-ap25:12.3": "sukhaṃ anubhaviṃ ",
  "tha-ap25:12.4": "accharāhi purakkhato. // // ",
  "tha-ap25:13.1": "Pañcasattatikkhattuṃ ca ",
  "tha-ap25:13.2": "cakkavattī ahos' ahaṃ / ",
  "tha-ap25:13.3": "padesarajjaṃ vipulaṃ ",
  "tha-ap25:13.4": "gaṇanāto asaṅkhiyaṃ. // // ",
  "tha-ap25:14.1": "Pacchime bhave sampatte ",
  "tha-ap25:14.2": "puññakammasamāhito / ",
  "tha-ap25:14.3": "pure Sāvatthiyaṃ jāto ",
  "tha-ap25:14.4": "mahāsāle su-aḍḍhake. // // ",
  "tha-ap25:15.1": "Nagarā nikkhamitvāna ",
  "tha-ap25:15.2": "dārakehi purakkhato / ",
  "tha-ap25:15.3": "sahassakhiḍḍasamaṅgī 'haṃ ",
  "tha-ap25:15.4": "saṅghārāmaṃ upāgamiṃ. // // ",
  "tha-ap25:16.1": "Tatth' addasāsiṃ samaṇaṃ ",
  "tha-ap25:16.2": "vippamuttaṃ nirūpadhiṃ / ",
  "tha-ap25:16.3": "so me dhammam adesesi ",
  "tha-ap25:16.4": "saraṇañ ca adāsi me. // // ",
  "tha-ap25:17.1": "So 'haṃ sutvāna saraṇaṃ ",
  "tha-ap25:17.2": "saraṇam me anussariṃ / ",
  "tha-ap25:17.3": "ekāsane nisīditvā ",
  "tha-ap25:17.4": "arahattam apāpuṇiṃ. // // ",
  "tha-ap25:18.1": "Jātiyā sattavassena ",
  "tha-ap25:18.2": "arahattaṃ apāpuṇiṃ / ",
  "tha-ap25:18.3": "upasampādesi sambuddho ",
  "tha-ap25:18.4": "guṇam aññāya cakkhumā. // // ",
  "tha-ap25:19.1": "Aparimeyye ito kappe ",
  "tha-ap25:19.2": "saraṇāni agañch' ahaṃ / ",
  "tha-ap25:19.3": "tato me sukataṃ kammaṃ ",
  "tha-ap25:19.4": "phalaṃ dassesi me idha. // // ",
  "tha-ap25:20.1": "Sugopitaṃ me saraṇaṃ ",
  "tha-ap25:20.2": "mānasaṃ suppaṇihitaṃ / ",
  "tha-ap25:20.3": "anubhotvā yāsaṃ sabbaṃ ",
  "tha-ap25:20.4": "patto 'mhi acalaṃ padaṃ. // // ",
  "tha-ap25:21.1": "Yesaṃ sotāvadhān' atthi ",
  "tha-ap25:21.2": "suṇotha mama bhāsato; / ",
  "tha-ap25:21.3": "atthaṃ vo kathayissāmi ",
  "tha-ap25:21.4": "samaṃ diṭṭham idaṃ mamaṃ. // // ",
  "tha-ap25:22.1": "Buddho loke samuppanno ",
  "tha-ap25:22.2": "vattate jinasāsanaṃ / ",
  "tha-ap25:22.3": "amatā vāditā bheri ",
  "tha-ap25:22.4": "sokasallavinodanā. // // ",
  "tha-ap25:23.1": "Yathā sakena thāmena ",
  "tha-ap25:23.2": "puññakkhette anuttare / ",
  "tha-ap25:23.3": "adhikāraṃ kareyyātha ",
  "tha-ap25:23.4": "passayissatha nibbutiṃ. // // ",
  "tha-ap25:24.1": "Paggayha tīṇisaraṇe ",
  "tha-ap25:24.2": "pañcasīlāni gopaya / ",
  "tha-ap25:24.3": "Buddhe cittaṃ pasādetvā ",
  "tha-ap25:24.4": "dukkhass' antaṃ karissatha. // // ",
  "tha-ap25:25.1": "Mamopamaṃ karitvāna ",
  "tha-ap25:25.2": "sīlāni parigopiya / ",
  "tha-ap25:25.3": "aciraṃ arahattaṃ vo ",
  "tha-ap25:25.4": "sabbe pi pāpuṇissatha. // // ",
  "tha-ap25:26.1": "Tevijjo iddhippatto 'mhi ",
  "tha-ap25:26.2": "cetopariyakovido / ",
  "tha-ap25:26.3": "sāvako te mahāvīra ",
  "tha-ap25:26.4": "saraṇe vandati satthuno. // // ",
  "tha-ap25:27.1": "Aparimeyye ito kappe ",
  "tha-ap25:27.2": "saraṇaṃ Buddhass agañch' ahaṃ / ",
  "tha-ap25:27.3": "duggatiṃ nābhijānāmi ",
  "tha-ap25:27.4": "saraṇāgamaṇe phalaṃ. // // ",
  "tha-ap25:28.1": "Paṭisambhidā catasso ",
  "tha-ap25:28.2": "vimokhā pi ca aṭṭh' ime / ",
  "tha-ap25:28.3": "chaḍabhiññā sacchikatā ",
  "tha-ap25:28.4": "kataṃ Buddhassa sāsanan ti. // // ",
  "tha-ap25:29.1": "Itthaṃ sudaṃ āyasmā Tīṇisaraṇāgamaniyo thero imā gāthāyo abhāsitthā ti. ",
  "tha-ap25:30.1": "Tīṇisaraṇāgamaniyatherassa apadānaṃ samattaṃ. "
}
