  "tha-ap415:0.2": "",
  "tha-ap415:0.3": "",
  "tha-ap415:1.1": "maraṇaṃ ",
  "tha-ap415:1.2": "paccavekkhiṃ ahaṃ tadā / ",
  "tha-ap415:1.3": "ekato abhinikkamma ",
  "tha-ap415:1.4": "pabbajim anagāriyaṃ. // // ",
  "tha-ap415:2.1": "Caramānānupubbena ",
  "tha-ap415:2.2": "Gaṅgātīram upāgamiṃ / ",
  "tha-ap415:2.3": "tatth' addasāsiṃ paṭhaviṃ ",
  "tha-ap415:2.4": "Gaṅgātīre supuṇṇataṃ. // // ",
  "tha-ap415:3.1": "Assamaṃ tattha māpetvā ",
  "tha-ap415:3.2": "vasāmi assame ahaṃ / ",
  "tha-ap415:3.3": "sukato caṅkamo mayhaṃ ",
  "tha-ap415:3.4": "nānādijagaṇāyuto. // // ",
  "tha-ap415:4.1": "Mam upenti ca vissatthā ",
  "tha-ap415:4.2": "kūjanti ca manoharaṃ / ",
  "tha-ap415:4.3": "ramamāṇo saha tehi ",
  "tha-ap415:4.4": "vasāmi assame ahaṃ. // // ",
  "tha-ap415:5.1": "Mama assamasāmantā ",
  "tha-ap415:5.2": "migarājā catukkamo / ",
  "tha-ap415:5.3": "āsayā abhinikkhamma ",
  "tha-ap415:5.4": "gajji so medinī viya. // // ",
  "tha-ap415:6.1": "Nadite migarāje va ",
  "tha-ap415:6.2": "hāso me udapajjatha / ",
  "tha-ap415:6.3": "migarājaṃ gavesanto ",
  "tha-ap415:6.4": "addasaṃ lokanāyakaṃ. // // ",
  "tha-ap415:7.1": "Disvān' ahaṃ devadevaṃ ",
  "tha-ap415:7.2": "Tissaṃ lokagganāyakaṃ / ",
  "tha-ap415:7.3": "haṭṭho haṭṭhena cittena ",
  "tha-ap415:7.4": "pūjayiṃ nāgakesaraṃ. // // ",
  "tha-ap415:8.1": "Uggacchantaṃ va suriyaṃ ",
  "tha-ap415:8.2": "sālarājaṃ pa pupphitaṃ / ",
  "tha-ap415:8.3": "osadhiṃ va virocantaṃ ",
  "tha-ap415:8.4": "santhaviṃ lokanāyakaṃ: // // ",
  "tha-ap415:9.1": "‘Tava ñāṇena sabbaññū ",
  "tha-ap415:9.2": "jotesi 'maṃ sadevakaṃ / ",
  "tha-ap415:9.3": "tvaṃ hi ārādhayitvāna ",
  "tha-ap415:9.4": "jātiyā parimuccare. // // ",
  "tha-ap415:10.1": "Adassanena sabbaññū ",
  "tha-ap415:10.2": "Buddhānaṃ sabbadassinaṃ / ",
  "tha-ap415:10.3": "patantyavīcinirayaṃ ",
  "tha-ap415:10.4": "rāgadosehi ophuṭā. // // ",
  "tha-ap415:11.1": "Tava dassanam āgamma ",
  "tha-ap415:11.2": "sabbaññū lokanāyaka / ",
  "tha-ap415:11.3": "pamuccanti bhavā sabbe ",
  "tha-ap415:11.4": "phusanti amataṃ padaṃ. // // ",
  "tha-ap415:12.1": "Yadā Buddhā cakkhumantā ",
  "tha-ap415:12.2": "uppajjanti pabhaṅkarā / ",
  "tha-ap415:12.3": "kilese jhāpayitvāna ",
  "tha-ap415:12.4": "ālokaṃ dassayanti te.' // // ",
  "tha-ap415:13.1": "Kittayitvāna sambuddhaṃ ",
  "tha-ap415:13.2": "Tissaṃ lokagganāyakaṃ / ",
  "tha-ap415:13.3": "haṭṭho haṭṭhena cittena ",
  "tha-ap415:13.4": "tiṇasūlam apūjayiṃ. // // ",
  "tha-ap415:14.1": "Mama saṅkappam aññāya ",
  "tha-ap415:14.2": "Tisso lokagganāyako / ",
  "tha-ap415:14.3": "Sakāsane nisīditvā ",
  "tha-ap415:14.4": "imā gāthā abhāsatha: // // ",
  "tha-ap415:15.1": "Yo maṃ pupphehi chādesi ",
  "tha-ap415:15.2": "pasanno sehi pāṇihi / ",
  "tha-ap415:15.3": "tam ahaṃ kittayissāmi ",
  "tha-ap415:15.4": "suṇotha mama bhāsato: // // ",
  "tha-ap415:16.1": "Pañcavīsatikkhattuṃ so ",
  "tha-ap415:16.2": "devarajjaṃ karissati / ",
  "tha-ap415:16.3": "pañcasattatikkhattuñ ca ",
  "tha-ap415:16.4": "cakkavattī bhavissati // // ",
  "tha-ap415:17.1": "Padesarajjaṃ vipulaṃ ",
  "tha-ap415:17.2": "gaṇanāto asaṅkhiyaṃ / ",
  "tha-ap415:17.3": "tassa kammassa nissando ",
  "tha-ap415:17.4": "pupphāna pūjanāya so. // // ",
  "tha-ap415:18.1": "Sīsaṃ nhāto c' ayaṃ poso ",
  "tha-ap415:18.2": "puppham ākaṅkhate c' ayaṃ / ",
  "tha-ap415:18.3": "puññakammena saṃyutto ",
  "tha-ap415:18.4": "purato pātubhavissati. // // ",
  "tha-ap415:19.1": "Yaṃ yaṃ icchati kāmehi ",
  "tha-ap415:19.2": "taṃ taṃ pātubhavissati / ",
  "tha-ap415:19.3": "saṅkappaṃ paripūritvā ",
  "tha-ap415:19.4": "nibbāyissat' ",
  "tha-ap415:20.1": "anāsavo. // // Kilesā ",
  "tha-ap415:21.1": "jhāpayitvāna ",
  "tha-ap415:21.2": "sampajāno patissato / ",
  "tha-ap415:21.3": "ekāsane nisīditvā ",
  "tha-ap415:21.4": "arahattam apāpuṇiṃ. // // ",
  "tha-ap415:22.1": "Caṅkamanto nipajjanto ",
  "tha-ap415:22.2": "nisinno uda vā ṭhito / ",
  "tha-ap415:22.3": "Buddhaseṭṭhaṃ saritvāna ",
  "tha-ap415:22.4": "viharāmi ahaṃ tadā. // // ",
  "tha-ap415:23.1": "Cīvare *piṇḍapāte ca ",
  "tha-ap415:23.2": "paccaye* sayanāsane / ",
  "tha-ap415:23.3": "tattha me ūṇatā n' atthi ",
  "tha-ap415:23.4": "buddhapūjāy' idaṃ phalaṃ. // // ",
  "tha-ap415:24.1": "So dāni patto amataṃ ",
  "tha-ap415:24.2": "santaṃ padam anuttaraṃ / ",
  "tha-ap415:24.3": "sabbāsave pariññāya ",
  "tha-ap415:24.4": "viharāmi anāsavo. // // ",
  "tha-ap415:25.1": "Dvenavute ito kappe ",
  "tha-ap415:25.2": "yaṃ buddham abhipūjayiṃ / ",
  "tha-ap415:25.3": "duggatiṃ nābhijānāmi ",
  "tha-ap415:25.4": "Buddhapūjāy' idaṃ phalaṃ. // // ",
  "tha-ap415:26.1": "Kilesā . . . ",
  "tha-ap415:26.2": "pe . . . ",
  "tha-ap415:26.3": "",
  "tha-ap415:27.1": "",
  "tha-ap415:27.2": "pe . . . // // ",
  "tha-ap415:27.3": "Sāgataṃ . . . pe . . . pe . . . // // ",
  "tha-ap415:28.1": "Paṭisambhidā . . . ",
  "tha-ap415:28.2": "pe . . . ",
  "tha-ap415:28.3": "pe . . . // // ",
  "tha-ap415:29.1": "Itthaṃ sudam āyasmā Tiṇasūlakachādaniyo th. i. g. a-ti. Tiṇasūlakachādaniyattherassa ",
  "tha-ap415:30.1": "apadānaṃ samattaṃ. "
}
