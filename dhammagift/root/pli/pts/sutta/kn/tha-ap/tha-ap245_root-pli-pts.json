  "tha-ap245:1.1": "vemajjhe ",
  "tha-ap245:1.2": "vasāmi jalakukkuṭo / ",
  "tha-ap245:1.3": "ath' addasaṃ devadevaṃ ",
  "tha-ap245:1.4": "gacchantam anilañjase. // // ",
  "tha-ap245:2.1": "Tuṇḍena kesariṃ gayha ",
  "tha-ap245:2.2": "vippasannena cetasā / ",
  "tha-ap245:2.3": "Buddhassa abhiropesiṃ ",
  "tha-ap245:2.4": "Tissassa lokabandhuno. // // ",
  "tha-ap245:3.1": "Dvenavute ito kappe ",
  "tha-ap245:3.2": "yaṃ puppham abhipūjayiṃ / ",
  "tha-ap245:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap245:3.4": "Buddhapūjāy' idaṃ phalaṃ. // // ",
  "tha-ap245:4.1": "Tesattatimhi kappamhi ",
  "tha-ap245:4.2": "Satapatta-sanāmako / ",
  "tha-ap245:4.3": "sattaratanasampanno ",
  "tha-ap245:4.4": "cakkavattī mahabbalo. // // ",
  "tha-ap245:5.1": "Paṭisambhidā . . . ",
  "tha-ap245:5.2": "pe . . . ",
  "tha-ap245:5.3": "pe . . . // // ",
  "tha-ap245:6.1": "Itthaṃ sudam āyasmā Naḷinakesariyo thero i. g. a-ti. Naḷinakesariyattherassa apadānaṃ samattaṃ. Khīṇāsavasahassena ",
  "tha-ap245:7.1": ""
}
