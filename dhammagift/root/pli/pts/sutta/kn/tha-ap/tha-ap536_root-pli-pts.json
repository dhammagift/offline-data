  "tha-ap536:0.1": "",
  "tha-ap536:0.2": "",
  "tha-ap536:0.3": "",
  "tha-ap536:1.1": "Padumuttaro nāma jino ",
  "tha-ap536:1.2": "sabbalokavidū muni / ",
  "tha-ap536:1.3": "ito satasahassamhi ",
  "tha-ap536:1.4": "kappe uppajji cakkhumā. // // ",
  "tha-ap536:2.1": "Ovādako viññāpako ",
  "tha-ap536:2.2": "tārako sabbapāṇinaṃ / ",
  "tha-ap536:2.3": "desanākusalo Buddho ",
  "tha-ap536:2.4": "tāresi janataṃ bahuṃ. // // ",
  "tha-ap536:3.1": "Anukampako kāruṇiko ",
  "tha-ap536:3.2": "hitesi sabbapāṇinaṃ / ",
  "tha-ap536:3.3": "sampatte titthiye sabbe ",
  "tha-ap536:3.4": "pañcasīle patiṭṭhapi. // // ",
  "tha-ap536:4.1": "Evaṃ nirākulaṃ āsi ",
  "tha-ap536:4.2": "suññataṃ titthiyehi ca / ",
  "tha-ap536:4.3": "vicittaṃ arahantehi ",
  "tha-ap536:4.4": "vasībhūtehi tādihi. // // ",
  "tha-ap536:5.1": "Ratanānaṭṭhapaññāsaṃ ",
  "tha-ap536:5.2": "uggato so mahāmuni / ",
  "tha-ap536:5.3": "kañcanagghiyasaṅkāso ",
  "tha-ap536:5.4": "dvattiṃsavaralakkhaṇo // // ",
  "tha-ap536:6.1": "Vassasatasahassāni ",
  "tha-ap536:6.2": "āyaṃ vijjati tāvade / ",
  "tha-ap536:6.3": "tāvatā tiṭṭhamāno so ",
  "tha-ap536:6.4": "tāresi janataṃ bahuṃ. // // ",
  "tha-ap536:7.1": "Tadāhaṃ Haṃsavatiyaṃ ",
  "tha-ap536:7.2": "seṭṭhiputto mahāyaso / ",
  "tha-ap536:7.3": "upetvā lokapajjotaṃ ",
  "tha-ap536:7.4": "assosiṃ dhammadesanaṃ. // // ",
  "tha-ap536:8.1": "Senāsanāni bhikkhūnaṃ ",
  "tha-ap536:8.2": "paññāpentaṃ sa sāvakaṃ / ",
  "tha-ap536:8.3": "kittayantassa vacanaṃ ",
  "tha-ap536:8.4": "suṇitvā mudito ahaṃ. // // ",
  "tha-ap536:9.1": "Adhikāraṃ sasaṅghassa ",
  "tha-ap536:9.2": "katvā tassa mahesino / ",
  "tha-ap536:9.3": "nipacca sirasā pāde ",
  "tha-ap536:9.4": "taṃ ṭhānaṃ abhipatthayiṃ. // // ",
  "tha-ap536:10.1": "Tadahaṃ sa mahāvīro ",
  "tha-ap536:10.2": "mama kammaṃ pakittayaṃ: / ",
  "tha-ap536:10.3": "So yaṃ sasaṅghaṃ bhojesi ",
  "tha-ap536:10.4": "sattāhaṃ lokanāyakaṃ // // ",
  "tha-ap536:11.1": "So yaṃ kamalapattakkho ",
  "tha-ap536:11.2": "sīhaṃso kanakattaco / ",
  "tha-ap536:11.3": "maṃ pādamūle patito ",
  "tha-ap536:11.4": "patthayi ṭhānam uttamaṃ. // // Satasahasse ",
  "tha-ap536:12.1": "ito kappe ",
  "tha-ap536:12.2": "Okkākakulasambhavo / ",
  "tha-ap536:12.3": "Gotamo nāma nāmena ",
  "tha-ap536:12.4": "satthā loke bhavissati // // ",
  "tha-ap536:13.1": "Sāvako tassa Buddhassa ",
  "tha-ap536:13.2": "Dabbo nāmena vissuto / ",
  "tha-ap536:13.3": "senāsanapaññāpako ",
  "tha-ap536:13.4": "aggo hessat' ayaṃ tadā. // // ",
  "tha-ap536:14.1": "Tena kammena sukatena ",
  "tha-ap536:14.2": "cetanāpaṇidhīhi ca / ",
  "tha-ap536:14.3": "jahitvā mānusaṃ dehaṃ ",
  "tha-ap536:14.4": "Tāvatiṃsaṃ agacch' ahaṃ. // // ",
  "tha-ap536:15.1": "Satānaṃ tīṇikhattuñ ca ",
  "tha-ap536:15.2": "devarajjam akārayiṃ / ",
  "tha-ap536:15.3": "satānaṃ pañcakkhattuñ ca ",
  "tha-ap536:15.4": "cakkavatti ahos' ahaṃ. // // ",
  "tha-ap536:16.1": "Padesarajjaṃ vipulaṃ ",
  "tha-ap536:16.2": "gaṇanāto asaṅkhiyaṃ / ",
  "tha-ap536:16.3": "sabbattha sukhito āsiṃ ",
  "tha-ap536:16.4": "tassa kammassa vāhasā. // // ",
  "tha-ap536:17.1": "Ekanavute ito kappe ",
  "tha-ap536:17.2": "Vipassī nāma nāyako / ",
  "tha-ap536:17.3": "uppajji cārunayano ",
  "tha-ap536:17.4": "sabbadhammavipassako. // // ",
  "tha-ap536:18.1": "Duṭṭhacitto upavadi ",
  "tha-ap536:18.2": "sāvakaṃ tassa tādino / ",
  "tha-ap536:18.3": "sabbāsavaparikkhīṇaṃ ",
  "tha-ap536:18.4": "‘suddho' ti ca vijāniya. // // ",
  "tha-ap536:19.1": "Tass' eva naravīrassa ",
  "tha-ap536:19.2": "*sāvakānaṃ* mahesinaṃ / ",
  "tha-ap536:19.3": "salākaṃ paggahetvāna ",
  "tha-ap536:19.4": "khīrodanam adās' ahaṃ. // // ",
  "tha-ap536:20.1": "Imamhi bhaddake kappe ",
  "tha-ap536:20.2": "brahmabandhu mahāyaso / ",
  "tha-ap536:20.3": "Kassapo nāma nāmena ",
  "tha-ap536:20.4": "uppajji vadataṃ varo. // // ",
  "tha-ap536:21.1": "Sāsanaṃ jotayitvā so ",
  "tha-ap536:21.2": "abhibhuyya kutitthiye / ",
  "tha-ap536:21.3": "veneyye vinayitvā ca ",
  "tha-ap536:21.4": "nibbuto so sasāvako. // // ",
  "tha-ap536:22.1": "Sasissa-nibbute nāthe ",
  "tha-ap536:22.2": "attham entamhi sāsane / ",
  "tha-ap536:22.3": "devā kandiṃsu saṃviggā ",
  "tha-ap536:22.4": "muttakesā rudammukhā. // // ",
  "tha-ap536:23.1": "Nibbāyissati dhammakkho ",
  "tha-ap536:23.2": "na passissāma subbate / ",
  "tha-ap536:23.3": "na suṇissāma saddhammaṃ ",
  "tha-ap536:23.4": "aho no appapuññatā. // // ",
  "tha-ap536:24.1": "Tadāyaṃ puthavī sabbā ",
  "tha-ap536:24.2": "acalā sācalācalā / ",
  "tha-ap536:24.3": "sāgaro ca sasoko va ",
  "tha-ap536:24.4": "vinadī karuṇaṃ giraṃ. // // ",
  "tha-ap536:25.1": "Catuddisā dundubhiyo ",
  "tha-ap536:25.2": "nādayiṃsu samānusā / ",
  "tha-ap536:25.3": "samantato asaniyo ",
  "tha-ap536:25.4": "patiṃsu ca bhayāvahā. // // ",
  "tha-ap536:26.1": "Ukkā patiṃsu nabhasā ",
  "tha-ap536:26.2": "dhūmaketu ca dissati / ",
  "tha-ap536:26.3": "sabba-thalaja-sattā ca ",
  "tha-ap536:26.4": "raviṃsu karuṇaṃ migā. // // ",
  "tha-ap536:27.1": "Uppāde dāruṇe disvā ",
  "tha-ap536:27.2": "sāsanatthañ ca sūcakaṃ / ",
  "tha-ap536:27.3": "saṃviggā bhikkhavo tattha ",
  "tha-ap536:27.4": "cintayimha mayaṃ tadā // // ",
  "tha-ap536:28.1": "Sāsanena vinā sammā ",
  "tha-ap536:28.2": "jīvitena alam mayaṃ / ",
  "tha-ap536:28.3": "pavisitvā mahāraññaṃ ",
  "tha-ap536:28.4": "yuñjāma jinasāsane. // // ",
  "tha-ap536:29.1": "Addasamha tadāraññe ",
  "tha-ap536:29.2": "ubbiddhaṃ selam uttamaṃ / ",
  "tha-ap536:29.3": "nisseniyā tam āruyha ",
  "tha-ap536:29.4": "nisseniṃ pātapamhase. // // ",
  "tha-ap536:30.1": "Tadā ovadi no thero: ",
  "tha-ap536:30.2": "Buddhuppādo sudullabho / ",
  "tha-ap536:30.3": "saddhā vo sulabhā laddhā. ",
  "tha-ap536:30.4": "thokasesañ ca sāsanaṃ. // // ",
  "tha-ap536:31.1": "Nipatanti khaṇātītā ",
  "tha-ap536:31.2": "anante dukkhasāgare / ",
  "tha-ap536:31.3": "tasmā payogo kattabbo ",
  "tha-ap536:31.4": "yāvaṃ ṭhāti mune mataṃ. // // ",
  "tha-ap536:32.1": "Arahā āsi so thero ",
  "tha-ap536:32.2": "anāgāmi tadānugo / ",
  "tha-ap536:32.3": "susīlā itare yuttā ",
  "tha-ap536:32.4": "devalokam agamhase. // // ",
  "tha-ap536:33.1": "Nibbuto tiṇṇasaṃsāro ",
  "tha-ap536:33.2": "suddhāvāse ca ekako / ",
  "tha-ap536:33.3": "ahañ ca Pukkusātī ca ",
  "tha-ap536:33.4": "Sabhiyo Bāhiyo tathā // // ",
  "tha-ap536:34.1": "Kumāra-Kassapo c' eva ",
  "tha-ap536:34.2": "tattha *tatth' u*pagāmiyaṃ / ",
  "tha-ap536:34.3": "saṃsārabandhanāmuttā ",
  "tha-ap536:34.4": "Gotamen' ānukampitā. // // ",
  "tha-ap536:35.1": "Mallesu Kusinārāyaṃ ",
  "tha-ap536:35.2": "jāto gabbhe ca me sato / ",
  "tha-ap536:35.3": "mātā pitā cit' ārūḷhā ",
  "tha-ap536:35.4": "tato nibbattito s' ahaṃ // // ",
  "tha-ap536:36.1": "Patito dabbapuñjamhi ",
  "tha-ap536:36.2": "tato Dabbo ti vissuto / ",
  "tha-ap536:36.3": "brahmaceraphalenāhaṃ ",
  "tha-ap536:36.4": "vimutto sattavassiko. // // ",
  "tha-ap536:37.1": "Khīrāsanaphalenāhaṃ pañcaṅgehi ",
  "tha-ap536:37.2": "upāgato / ",
  "tha-ap536:37.3": "khīṇāsavo pavādena ",
  "tha-ap536:37.4": "pāpehi bahu codito. // // ",
  "tha-ap536:38.1": "Ubho puññañ ca pāpañ ca ",
  "tha-ap536:38.2": "vītivatto 'mhi dān' ahaṃ / ",
  "tha-ap536:38.3": "patvāna paramaṃ santiṃ ",
  "tha-ap536:38.4": "viharāmi anāsavo. // // ",
  "tha-ap536:39.1": "Senāsanaṃ paññāpayiṃ ",
  "tha-ap536:39.2": "hāsayitvāna subbate / ",
  "tha-ap536:39.3": "jino tasmiṃ gune tuṭṭho ",
  "tha-ap536:39.4": "etadagge ṭhapesi maṃ. // // ",
  "tha-ap536:40.1": "Kilesā . . . ",
  "tha-ap536:40.2": "pe . . . ",
  "tha-ap536:40.3": "",
  "tha-ap536:41.1": "",
  "tha-ap536:41.2": "pe . . . ",
  "tha-ap536:41.3": "pe . . . // // Sāgataṃ . . . pe . . . pe . . . pe . . . // // ",
  "tha-ap536:42.1": "Paṭisambhidā . . . ",
  "tha-ap536:42.2": "pe . . . ",
  "tha-ap536:42.3": "pe . . . pe . . . // // ",
  "tha-ap536:43.1": "Itthaṃ sudaṃ āyasmā Dabbamallaputto thero i. g. a-ti. Dabbamallaputtattherassa ",
  "tha-ap536:44.1": "apadānaṃ samattaṃ. "
}
