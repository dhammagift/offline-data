  "tha-ap41:0.2": "",
  "tha-ap41:0.3": "",
  "tha-ap41:1.1": "Siddhatthassa bhagavato ",
  "tha-ap41:1.2": "sīhāsanassa sammukhā / ",
  "tha-ap41:1.3": "dhammacakkaṃ mayā ṭhapitaṃ ",
  "tha-ap41:1.4": "sukataṃ viññuvaṇṇitaṃ. // // ",
  "tha-ap41:2.1": "Cāruvaṇṇo va sobhāmi ",
  "tha-ap41:2.2": "sayoggabalavāhano / ",
  "tha-ap41:2.3": "parivārenti maṃ niccaṃ ",
  "tha-ap41:2.4": "anuyuttā bahujjanā. // // ",
  "tha-ap41:3.1": "Saṭṭhiṃ turiyasahassehi ",
  "tha-ap41:3.2": "parivārem' ahaṃ sadā / ",
  "tha-ap41:3.3": "parivārena sobhāmi ",
  "tha-ap41:3.4": "puññakammass' idaṃ phalaṃ. // // ",
  "tha-ap41:4.1": "Catunavute ito kappe ",
  "tha-ap41:4.2": "yaṃ cakkaṃ ṭhapayim ahaṃ / ",
  "tha-ap41:4.3": "duggatiṃ nābhijānāmi ",
  "tha-ap41:4.4": "dhammacakkass' idaṃ phalaṃ. // // ",
  "tha-ap41:5.1": "Ito ekādase kappe ",
  "tha-ap41:5.2": "aṭṭh' āsiṃsu janādhipā / ",
  "tha-ap41:5.3": "Sahassarājā nāmena ",
  "tha-ap41:5.4": "cakkavattī mahabbalā. // // ",
  "tha-ap41:6.1": "Paṭisambhidā catasso ",
  "tha-ap41:6.2": "vimokhā pi ca aṭṭh' ime / chaḷabhiññā sacchikatā ",
  "tha-ap41:6.3": "kataṃ Buddhassa sāsanan ti. // // ",
  "tha-ap41:7.1": "Itthaṃ sudaṃ āyasmā Dhammacakkikothero imā gāthāyo abhāsitthā ti. ",
  "tha-ap41:8.1": "Dhammacakkikatherassa apadānaṃ samattaṃ. "
}
