  "tha-ap265:0.3": "",
  "tha-ap265:1.1": "Tissassa kho bhagavato ",
  "tha-ap265:1.2": "bodhiyā pāda-m-uttame / ",
  "tha-ap265:1.3": "aḍḍhacandaṃ mayā dinnaṃ ",
  "tha-ap265:1.4": "dharaṇīruhapādape. // // ",
  "tha-ap265:2.1": "Dvenavute ito kappe ",
  "tha-ap265:2.2": "yaṃ puppham abhiropayiṃ / ",
  "tha-ap265:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap265:2.4": "bodhipūjāy' idaṃ phalaṃ. // // ",
  "tha-ap265:3.1": "Pañcavīse ito kappe ",
  "tha-ap265:3.2": "Devapo nāma khattiyo / ",
  "tha-ap265:3.3": "sattaratanasampanno ",
  "tha-ap265:3.4": "cakkavattī mahabbalo. // // ",
  "tha-ap265:4.1": "Paṭisambhidā . . . ",
  "tha-ap265:4.2": "pe . . . ",
  "tha-ap265:4.3": "pe . . . // // ",
  "tha-ap265:5.1": "Itthaṃ sudam āyasmā Aḍḍhacandiyo thero i. g. a-ti. Aḍḍhacandiyattherassa apadānaṃ samattaṃ. ",
  "tha-ap265:6.1": ""
}
