  "tha-ap52:1.1": "Siddhatthassa bhagavato ",
  "tha-ap52:1.2": "lokajeṭṭhassa tādino / ",
  "tha-ap52:1.3": "agghiyaṃ kārayitvāna ",
  "tha-ap52:1.4": "jātipupphehi chādayiṃ. // // ",
  "tha-ap52:2.1": "Niṭṭhapetvāna taṃ puppham ",
  "tha-ap52:2.2": "buddhassa upanāmayiṃ / ",
  "tha-ap52:2.3": "pupphāvasesaṃ paggayha ",
  "tha-ap52:2.4": "Buddhassa abhiropayiṃ. // // ",
  "tha-ap52:3.1": "Kañcanagghiyasaṅkāsaṃ ",
  "tha-ap52:3.2": "Buddhaṃ lokagganāyakaṃ / ",
  "tha-ap52:3.3": "pasannacitto sumano ",
  "tha-ap52:3.4": "pupphagghiyam upānayiṃ. // // ",
  "tha-ap52:4.1": "Vitiṇṇakaṅkho sambuddho ",
  "tha-ap52:4.2": "tiṇṇoghehi purakkhato / ",
  "tha-ap52:4.3": "bhikkhusaṅghe nisīditvā ",
  "tha-ap52:4.4": "imā gāthā abhāsatha: // // ",
  "tha-ap52:5.1": "Dibbaṃ gandhaṃ pavāyantaṃ ",
  "tha-ap52:5.2": "yo me pupphagghiyaṃ adā / ",
  "tha-ap52:5.3": "tam ahaṃ kittayissāmi; ",
  "tha-ap52:5.4": "suṇotha mama bhāsato: // // ",
  "tha-ap52:6.1": "Ito cuto ayaṃ poso ",
  "tha-ap52:6.2": "devasaṅghapurakkhato / ",
  "tha-ap52:6.3": "jātipupphehi parikiṇṇo ",
  "tha-ap52:6.4": "devalokaṃ gamissati. // // ",
  "tha-ap52:7.1": "Ubbiddhaṃ bhavanaṃ tassa ",
  "tha-ap52:7.2": "sovaṇṇañ ca maṇimayaṃ / ",
  "tha-ap52:7.3": "vyamhā pātubhavissanti ",
  "tha-ap52:7.4": "puññakammapabhāvitā. // // ",
  "tha-ap52:8.1": "Catusattatikkhattuṃ so ",
  "tha-ap52:8.2": "devarajjaṃ karissati / ",
  "tha-ap52:8.3": "anubhossati sampattiṃ ",
  "tha-ap52:8.4": "accharāhi purakkhato. // // ",
  "tha-ap52:9.1": "*Pathavyā rajjaṃ tisataṃ ",
  "tha-ap52:9.2": "vasudhaṃ* āvasissati / ",
  "tha-ap52:9.3": "pañcasattatikkhattuñ ca ",
  "tha-ap52:9.4": "cakkavattī bhavissati. // // ",
  "tha-ap52:10.1": "Dujjayo nāma nāmena ",
  "tha-ap52:10.2": "hessati manujādhipo / ",
  "tha-ap52:10.3": "anubhotvāna taṃ puññaṃ ",
  "tha-ap52:10.4": "sakakammaṃ apassito. // // ",
  "tha-ap52:11.1": "Vinipātaṃ āgantvāna ",
  "tha-ap52:11.2": "manussattaṃ gamissati / ",
  "tha-ap52:11.3": "*hiraññassa ca nicitaṃ ",
  "tha-ap52:11.4": "koṭṭisatān* anappakaṃ. // // ",
  "tha-ap52:12.1": "Nibbattissati lokamhi ",
  "tha-ap52:12.2": "brāhmaṇo so bhavissati / ",
  "tha-ap52:12.3": "Vaṅgantassa suto dhīmā ",
  "tha-ap52:12.4": "Sāriyā oraso piyo. // // ",
  "tha-ap52:13.1": "So ca pacchā pabbājitvā ",
  "tha-ap52:13.2": "Aṅgīrasassa sāsane / ",
  "tha-ap52:13.3": "Cūlacundo ti nāmena ",
  "tha-ap52:13.4": "hessati *satthu sāvako. // // ",
  "tha-ap52:14.1": "Sāmaṇero ca* so santo ",
  "tha-ap52:14.2": "khīṇāsavo bhavissati / ",
  "tha-ap52:14.3": "sabbāsave pariññāya ",
  "tha-ap52:14.4": "nibbayissat' anāsavo. // // ",
  "tha-ap52:15.1": "Upaṭṭhahiṃ mahāvīraṃ ",
  "tha-ap52:15.2": "aññe ca pesale bahū / ",
  "tha-ap52:15.3": "bhātaram me c' upaṭṭhāsiṃ ",
  "tha-ap52:15.4": "uttamatthassa pattiyā. // // ",
  "tha-ap52:16.1": "Bhā*taraṃ me upaṭṭhitvā ",
  "tha-ap52:16.2": "dhātū pattamhi* opiya / ",
  "tha-ap52:16.3": "sambuddhaṃ upanāmesi ",
  "tha-ap52:16.4": "lokajeṭṭhaṃ narāsabhaṃ. // // ",
  "tha-ap52:17.1": "Ubho hatthehi paggayha ",
  "tha-ap52:17.2": "Buddho loke sadevake / ",
  "tha-ap52:17.3": "sandassayanto taṃ dhātuṃ ",
  "tha-ap52:17.4": "kittayi aggasāvakaṃ. // // ",
  "tha-ap52:18.1": "Cittañ ca suvimu*ttaṃ me ",
  "tha-ap52:18.2": "saddhā mayhaṃ patiṭṭhitā / ",
  "tha-ap52:18.3": "sabbāsa*ve pariññāya ",
  "tha-ap52:18.4": "viharāmi anāsavo. // // ",
  "tha-ap52:19.1": "Paṭisambhidā catasso ",
  "tha-ap52:19.2": "vimokhā pi ca aṭṭh' ime / ",
  "tha-ap52:19.3": "chaḷabhiññā sacchikatā ",
  "tha-ap52:19.4": "kataṃ Buddhassa sāsanan ti. // // ",
  "tha-ap52:20.1": "Itthaṃ sudaṃ āyasmā Cundathero imā gāthāyo abhā- sitthā ti. ",
  "tha-ap52:21.1": "Cundattherassa ",
  "tha-ap52:22.1": "apadānaṃ samattaṃ. ",
  "tha-ap52:23.1": "Uddānaṃ: ",
  "tha-ap52:24.1": "Upāli Soṇo Bhaddiyo ",
  "tha-ap52:24.2": "Sannidhāpaka Hatthiyo ",
  "tha-ap52:24.3": "Chadanaṃ Seyya-Caṅkamaṃ ",
  "tha-ap52:24.4": "Subhaddo Cundasavhayo ",
  "tha-ap52:24.5": "gāthā satañ ca tālīsaṃ ",
  "tha-ap52:24.6": "catasso ca tath' uttari "
}
