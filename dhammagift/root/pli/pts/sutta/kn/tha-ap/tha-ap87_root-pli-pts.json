  "tha-ap87:0.3": "",
  "tha-ap87:1.1": "Pabbate Himavantamhi ",
  "tha-ap87:1.2": "vāsaṃ kappes' ahaṃ pure / ",
  "tha-ap87:1.3": "ajinuttamavattho 'haṃ ",
  "tha-ap87:1.4": "vasāmi pabbatantare. // // ",
  "tha-ap87:2.1": "Suvaṇṇavaṇṇaṃ sambuddhaṃ ",
  "tha-ap87:2.2": "sataraṃsī va bhānumaṃ / ",
  "tha-ap87:2.3": "vanantara gataṃ disvā ",
  "tha-ap87:2.4": "sālarājaṃ va pupphitaṃ. // // ",
  "tha-ap87:3.1": "Raṃse cittaṃ pasādetvā ",
  "tha-ap87:3.2": "Vipassissa mahesino / ",
  "tha-ap87:3.3": "paggayha añjaliṃ vandiṃ ",
  "tha-ap87:3.4": "sirasā ukkuṭiṃ ahaṃ. // // ",
  "tha-ap87:4.1": "Ekanavute ito kappe ",
  "tha-ap87:4.2": "yaṃ kammam akariṃ tadā / ",
  "tha-ap87:4.3": "duggatiṃ nābhijānāmi ",
  "tha-ap87:4.4": "raṃsisaññāy' idaṃ phalaṃ. // // ",
  "tha-ap87:5.1": "Paṭisambhidā catasso ",
  "tha-ap87:5.2": "vimokhā pi ca aṭṭh' ime / chaḍabhiññā sacchikatā ",
  "tha-ap87:5.3": "kataṃ Buddhassa sāsanan ti. // // ",
  "tha-ap87:6.1": "Itthaṃ sudaṃ āyasmā Raṃsisaññako thero imā gāthāyo abhāsitthā ti. Raṃsisaññikattherassa apadānaṃ samattaṃ. ",
  "tha-ap87:7.1": ""
}
