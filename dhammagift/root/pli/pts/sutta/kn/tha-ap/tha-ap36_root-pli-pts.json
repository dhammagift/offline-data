{
  "tha-ap36:0.1": "",
  "tha-ap36:0.2": "",
  "tha-ap36:0.3": "",
  "tha-ap36:1.1": "",
  "tha-ap36:1.2": "lokajeṭṭhassa tādino / ",
  "tha-ap36:1.3": "aḍḍhānaṃ paṭipannassa ",
  "tha-ap36:1.4": "carato cārikaṃ tadā, // // ",
  "tha-ap36:2.1": "Suphullaṃ padumaṃ gayha ",
  "tha-ap36:2.2": "uppalaṃ mallikañ c' ahaṃ / ",
  "tha-ap36:2.3": "paramannaṃ gahetvāna ",
  "tha-ap36:2.4": "adāsiṃ satthuno ahaṃ. // // ",
  "tha-ap36:3.1": "Paribhuñji mahāvīro ",
  "tha-ap36:3.2": "paramannaṃ subhojanaṃ / ",
  "tha-ap36:3.3": "tañ ca pupphaṃ gahetvāna ",
  "tha-ap36:3.4": "janassa sampadassayi. // // ",
  "tha-ap36:4.1": "Iṭṭhaṃ kantaṃ ciraṃ loke ",
  "tha-ap36:4.2": "jalajaṃ puppham uttamaṃ / ",
  "tha-ap36:4.3": "Sudukkaraṃ tena kataṃ ",
  "tha-ap36:4.4": "yo me puppham adāsi so. // // ",
  "tha-ap36:5.1": "Yo puppham abhiropesi ",
  "tha-ap36:5.2": "paramannañ ca 'dāsi me / ",
  "tha-ap36:5.3": "tam ahaṃ kittayissāmi ",
  "tha-ap36:5.4": "suṇotha mama bhāsato: // // ",
  "tha-ap36:6.1": "*Dasa c' aṭṭha ca* kkhattuñ so ",
  "tha-ap36:6.2": "devarajjaṃ karissati / ",
  "tha-ap36:6.3": "uppalaṃ padumaṃ cāpi ",
  "tha-ap36:6.4": "mallikañ ca taduttariṃ. // // ",
  "tha-ap36:7.1": "Assa puññāvipākena ",
  "tha-ap36:7.2": "dibbagandhasamāyutaṃ / ",
  "tha-ap36:7.3": "ākāse chadanaṃ katvā ",
  "tha-ap36:7.4": "dhārayissati tāvade. // // ",
  "tha-ap36:8.1": "Pañcavīsatikkhattuñ ca ",
  "tha-ap36:8.2": "cakkavatti bhavissati / ",
  "tha-ap36:8.3": "*paṭhavyā rajjaṃ* pañcasataṃ ",
  "tha-ap36:8.4": "vasudhaṃ āvasissati. // // ",
  "tha-ap36:9.1": "Kappasatasahassamhi ",
  "tha-ap36:9.2": "Okkākakulasambhavo / ",
  "tha-ap36:9.3": "Gotamo nāma gottena ",
  "tha-ap36:9.4": "satthā loke bhavissati. // // ",
  "tha-ap36:10.1": "Sakakammābhiraddho so ",
  "tha-ap36:10.2": "sukkamūlena codito / ",
  "tha-ap36:10.3": "Sakyānaṃ nandijanano ",
  "tha-ap36:10.4": "ñātibandhu bhavissati. // // ",
  "tha-ap36:11.1": "So ca pacchā pabbajitvā ",
  "tha-ap36:11.2": "sukkamūlena codito / ",
  "tha-ap36:11.3": "sabbāsave pariññāya ",
  "tha-ap36:11.4": "nibbāyissat' anāsavo. // // Paṭisambhidā c' ",
  "tha-ap36:12.1": "anuppattam ",
  "tha-ap36:12.2": "katakiccam anāsavaṃ / ",
  "tha-ap36:12.3": "Gotamo lokabandhu so ",
  "tha-ap36:12.4": "etadagge ṭhapessati. // // ",
  "tha-ap36:13.1": "Padhānaṃ pahitatto so ",
  "tha-ap36:13.2": "upasanto nirūpadhi / ",
  "tha-ap36:13.3": "Udāyi nāma nāmena ",
  "tha-ap36:13.4": "hessati satthu sāvako. // // ",
  "tha-ap36:14.1": "Cittañ ca suvimuttam me ",
  "tha-ap36:14.2": "māno makkho ca dhaṃsito / ",
  "tha-ap36:14.3": "sabbāsave pariññāya ",
  "tha-ap36:14.4": "viharāmi anāsavo. // // ",
  "tha-ap36:15.1": "Tosayiñ cāpi sambuddham ",
  "tha-ap36:15.2": "ātāpī nipako ahaṃ / ",
  "tha-ap36:15.3": "pamodito ca sambuddho ",
  "tha-ap36:15.4": "etadagge ṭhapesi maṃ. // // ",
  "tha-ap36:16.1": "Paṭisambhidā catasso ",
  "tha-ap36:16.2": "vimokhā pi ca aṭṭh' ime / chaḍabhiññā sacchikatā ",
  "tha-ap36:16.3": "kataṃ Buddhassa sāsanan ti. // // ",
  "tha-ap36:17.1": "Itthaṃ sudaṃ āyasmā Kāludāyi thero imā gāthāyo abhāsitthā ti. ",
  "tha-ap36:18.1": "Kāludāyittherassa apadānaṃ samattaṃ. "
}
