  "tha-ap95:1.1": "Tissassāhaṃ bhagavato ",
  "tha-ap95:1.2": "upaḍḍhadussaṃ adās' ahaṃ / parakāpaññapatto ",
  "tha-ap95:1.3": "'mhi ",
  "tha-ap95:1.4": "duggandhena samappito. // // ",
  "tha-ap95:2.1": "Upaḍḍhadussaṃ datvāna ",
  "tha-ap95:2.2": "kappaṃ saggamhi mod' ahaṃ / ",
  "tha-ap95:2.3": "avasesesu kappesu ",
  "tha-ap95:2.4": "kusalan tīritam mayā. // // ",
  "tha-ap95:3.1": "Dvenavute ito kappe ",
  "tha-ap95:3.2": "yaṃ dussam adadiṃ tadā / ",
  "tha-ap95:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap95:3.4": "dussadānass' idaṃ phalaṃ. // // ",
  "tha-ap95:4.1": "Ekūnapaṇṇe kappamhi ",
  "tha-ap95:4.2": "rājāno cakkavattino / ",
  "tha-ap95:4.3": "Samantā-Odanā nāma ",
  "tha-ap95:4.4": "battiṃs' āsu janādhipā. // // ",
  "tha-ap95:5.1": "Paṭisambhidā catasso ",
  "tha-ap95:5.2": "vimokhā pi ca aṭṭh' ime / chaḍabhiññā sacchikatā ",
  "tha-ap95:5.3": "kataṃ Buddhassa sāsanan ti. // // ",
  "tha-ap95:6.1": "Itthaṃ sudaṃ āyasmā Aḍḍhacelako thero imā gāthāyo abhāsitthā ti. Aḍḍhacelakatherassa apadānaṃ samattaṃ. Kammāro 'haṃ ",
  "tha-ap95:7.1": ""
}
