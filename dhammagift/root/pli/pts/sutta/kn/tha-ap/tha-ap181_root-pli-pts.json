  "tha-ap181:0.1": "",
  "tha-ap181:0.2": "",
  "tha-ap181:0.3": "",
  "tha-ap181:1.1": "Nagare Bandhumatiyā ",
  "tha-ap181:1.2": "vejjo āsiṃ susikkhito / ",
  "tha-ap181:1.3": "āturānaṃ sudukkhīnaṃ ",
  "tha-ap181:1.4": "mahājanasukhāvaho. // // ",
  "tha-ap181:2.1": "Vyādhitaṃ samaṇaṃ disvā ",
  "tha-ap181:2.2": "sīlavantaṃ mahājutiṃ / ",
  "tha-ap181:2.3": "pasannacitto sumano ",
  "tha-ap181:2.4": "bhesajjam adadiṃ tadā. // // ",
  "tha-ap181:3.1": "Arogo āsi ten' eva ",
  "tha-ap181:3.2": "samaṇo saṃvutindriyo / ",
  "tha-ap181:3.3": "Asoko nāma nāmena ",
  "tha-ap181:3.4": "upaṭṭhāko Vipassino. // // ",
  "tha-ap181:4.1": "Ekanavute ito kappe ",
  "tha-ap181:4.2": "yam osadham adās' ahaṃ / ",
  "tha-ap181:4.3": "duggatiṃ nābhijānāmi ",
  "tha-ap181:4.4": "bhesajjassa idaṃ phalaṃ. // // ",
  "tha-ap181:5.1": "Ito ca aṭṭhame kappe ",
  "tha-ap181:5.2": "Sabbosadha-sanāmako / ",
  "tha-ap181:5.3": "sattaratanasampanno ",
  "tha-ap181:5.4": "cakkavattī mahabbalo. // // ",
  "tha-ap181:6.1": "Paṭisambhidā . . . ",
  "tha-ap181:6.2": "pe . . . ",
  "tha-ap181:6.3": "pe . . . // // ",
  "tha-ap181:7.1": "Itthaṃ sudaṃ āyasmā Tikicchako thero i. g. a-ti. Tikicchakattherassa ",
  "tha-ap181:8.1": "apadānaṃ samattaṃ. "
}
