  "tha-ap105:0.1": "",
  "tha-ap105:0.2": "",
  "tha-ap105:0.3": "",
  "tha-ap105:1.1": "Tivarāyaṃ nivāsī 'haṃ ",
  "tha-ap105:1.2": "ahosiṃ māliko tadā / ",
  "tha-ap105:1.3": "addasaṃ virajaṃ Buddhaṃ ",
  "tha-ap105:1.4": "Siddhatthaṃ lokapūjitaṃ. // // ",
  "tha-ap105:2.1": "Pasannacitto sumano ",
  "tha-ap105:2.2": "pupphahatthaṃ adās 'ahaṃ / ",
  "tha-ap105:2.3": "yatthayatth' upapajjāmi ",
  "tha-ap105:2.4": "tassa kammassa vāhasā // // ",
  "tha-ap105:3.1": "Anubhomi phalaṃ iṭṭhaṃ ",
  "tha-ap105:3.2": "pubbe sukatam attano / ",
  "tha-ap105:3.3": "parikkhitto sumallehi ",
  "tha-ap105:3.4": "sasaññāya idaṃ phalaṃ. // // ",
  "tha-ap105:4.1": "Catunavute ito kappe ",
  "tha-ap105:4.2": "yaṃ puppham abhiropayiṃ / ",
  "tha-ap105:4.3": "duggatiṃ nābhijānāmi ",
  "tha-ap105:4.4": "Buddhapūjāy' idaṃ phalaṃ. // // ",
  "tha-ap105:5.1": "Catunavute upādāya ",
  "tha-ap105:5.2": "ṭhapetvā vattamānakaṃ / ",
  "tha-ap105:5.3": "pañca rājā-satā tattha ",
  "tha-ap105:5.4": "Najjupamasanāmakā. // // ",
  "tha-ap105:6.1": "Paṭisambhidā catasso ",
  "tha-ap105:6.2": "vimokhā pi ca aṭṭh' ime / chaḍabhiññā sacchikatā ",
  "tha-ap105:6.3": "kataṃ Buddhassa sāsanan ti. // // ",
  "tha-ap105:7.1": "Itthaṃ sudaṃ āyasmā Uppalahatthiyo thero imā gāthāyo abhāsitthāti. Uppalahatthiyatherassa apadānaṃ samattaṃ. ",
  "tha-ap105:8.1": ""
}
