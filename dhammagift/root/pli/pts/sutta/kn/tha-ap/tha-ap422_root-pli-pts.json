  "tha-ap422:0.3": "",
  "tha-ap422:1.1": "Parinibbute kāruṇike ",
  "tha-ap422:1.2": "Siddhatthe lokanāyake / ",
  "tha-ap422:1.3": "vitthārike pāvacane ",
  "tha-ap422:1.4": "devamānusasakkate. // // ",
  "tha-ap422:2.1": "Caṇḍālo ās' ahaṃ tattha ",
  "tha-ap422:2.2": "āsandipīṭhakārako / ",
  "tha-ap422:2.3": "tena kammena jīvāmi ",
  "tha-ap422:2.4": "tena posemi dārake. // // ",
  "tha-ap422:3.1": "Āsandiṃ sukataṃ katvā ",
  "tha-ap422:3.2": "pasanno sehi pāṇihi / sayam eva ",
  "tha-ap422:3.3": "upāgantvā ",
  "tha-ap422:3.4": "bhikkhusaṅghass adās' ahaṃ. // // ",
  "tha-ap422:4.1": "Tena kammena sukatena ",
  "tha-ap422:4.2": "cetanāpaṇidhīhi ca / ",
  "tha-ap422:4.3": "jahitvā mānusaṃ dehaṃ ",
  "tha-ap422:4.4": "Tāvatiṃsam agacch' ahaṃ. // // ",
  "tha-ap422:5.1": "Devalokagato santo ",
  "tha-ap422:5.2": "modāmi Tidasaṃgaṇe / ",
  "tha-ap422:5.3": "sayanāni mahagghāni ",
  "tha-ap422:5.4": "nibbattanti yadicchakaṃ. // // ",
  "tha-ap422:6.1": "Paññāsakkhattuṃ devindo ",
  "tha-ap422:6.2": "devarajjam akārayiṃ / ",
  "tha-ap422:6.3": "asītikkhattuṃ rājā ca ",
  "tha-ap422:6.4": "cakkavattī ahos' ahaṃ. // // ",
  "tha-ap422:7.1": "Padesarajjaṃ vipulaṃ ",
  "tha-ap422:7.2": "gaṇanāto asaṅkhiyaṃ / ",
  "tha-ap422:7.3": "sukhito yasavā homi ",
  "tha-ap422:7.4": "mañcadānass' idaṃ phalaṃ. // // ",
  "tha-ap422:8.1": "Devalokā cavitvāna ",
  "tha-ap422:8.2": "emi ce mānusaṃ bhavaṃ / ",
  "tha-ap422:8.3": "mahārahā su-sayanā ",
  "tha-ap422:8.4": "sayam eva bhavanti me. // // ",
  "tha-ap422:9.1": "Ayaṃ pacchimako mayhaṃ ",
  "tha-ap422:9.2": "carimo vattate bhavo / ",
  "tha-ap422:9.3": "ajjāpi sayane kāle ",
  "tha-ap422:9.4": "sayanam upatiṭṭhati. // // ",
  "tha-ap422:10.1": "Catunavute ito kappe ",
  "tha-ap422:10.2": "yaṃ dānam adadiṃ tadā / ",
  "tha-ap422:10.3": "duggatiṃ nābhijānāmi ",
  "tha-ap422:10.4": "mañcadānass' idaṃ phalaṃ. // // ",
  "tha-ap422:11.1": "Kilesā . . . ",
  "tha-ap422:11.2": "pe . . . ",
  "tha-ap422:11.3": "",
  "tha-ap422:12.1": "",
  "tha-ap422:12.2": "pe . . . // // ",
  "tha-ap422:12.3": "Sāgataṃ . . . pe . . . pe . . . pe . . . // // ",
  "tha-ap422:13.1": "Paṭisambhidā . . . ",
  "tha-ap422:13.2": "pe . . . ",
  "tha-ap422:13.3": "pe . . . pe . . . // // ",
  "tha-ap422:14.1": "Itthaṃ sudam āyasmā Mañcadāyako thero i. g. a- ",
  "tha-ap422:15.1": "ti. Mañcadāyakattherassa ",
  "tha-ap422:16.1": "apadānaṃ samattaṃ. ",
  "tha-ap422:17.1": "Uddānaṃ: ",
  "tha-ap422:18.1": "Bhaddāli Ekacchatto ca ",
  "tha-ap422:18.2": "Tiṇasūlo ca Maṃsado ",
  "tha-ap422:18.3": "Nāgapallavi*ko Dīpi* ",
  "tha-ap422:18.4": "Ucchaṅgī Yāgudāyako ",
  "tha-ap422:19.1": "Patthodanī Mañcadado ",
  "tha-ap422:19.2": "gāthāyo gaṇitā v-iha ",
  "tha-ap422:19.3": "dvesatāni ca gāthānaṃ ",
  "tha-ap422:19.4": "gāthā c' ekā taduttarīti "
}
