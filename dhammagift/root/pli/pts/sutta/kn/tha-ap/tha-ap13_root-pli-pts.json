  "tha-ap13:0.3": "",
  "tha-ap13:1.1": "Nibbute lokanāthamhi ",
  "tha-ap13:1.2": "Siddhatthe dipaduttame / ",
  "tha-ap13:1.3": "vitthārite pāvacane ",
  "tha-ap13:1.4": "bāhujaññamhi sāsane // // ",
  "tha-ap13:2.1": "Pasannacitto sumano ",
  "tha-ap13:2.2": "sīhāsanam akās' ahaṃ / ",
  "tha-ap13:2.3": "sīhāsanaṃ karitvāna ",
  "tha-ap13:2.4": "pādapīṭhaṃ akās' ahaṃ. // // ",
  "tha-ap13:3.1": "Sīhāsane ca vassante ",
  "tha-ap13:3.2": "gharaṃ tattha akās' ahaṃ / ",
  "tha-ap13:3.3": "tena cittappasādena ",
  "tha-ap13:3.4": "Tusitaṃ upapajj' ahaṃ. // // ",
  "tha-ap13:4.1": "Āyāmena catubbīsā ",
  "tha-ap13:4.2": "yojanāsiṃsu tāvade / ",
  "tha-ap13:4.3": "vimānaṃ sukataṃ mayhaṃ ",
  "tha-ap13:4.4": "vitthārena catuddasaṃ // // ",
  "tha-ap13:5.1": "Sattakaññā sahassāni ",
  "tha-ap13:5.2": "parivārenti maṃ sadā / ",
  "tha-ap13:5.3": "soṇṇamayañ ca pallaṅkaṃ ",
  "tha-ap13:5.4": "vyamhe āsi sunimmitaṃ. // // ",
  "tha-ap13:6.1": "Hatthiyānaṃ assayānaṃ ",
  "tha-ap13:6.2": "dibbayānaṃ upaṭṭhitaṃ / ",
  "tha-ap13:6.3": "pāsādā sivikā c' eva ",
  "tha-ap13:6.4": "nibbattanti yadicchakaṃ. // // ",
  "tha-ap13:7.1": "Maṇimayā ca palla*ṅkā ",
  "tha-ap13:7.2": "aññe* sāramayā bahū / ",
  "tha-ap13:7.3": "nibbattanti mamaṃ sabbe ",
  "tha-ap13:7.4": "sīhāsanass' idaṃ phalaṃ. // // ",
  "tha-ap13:8.1": "Soṇṇamayā rūpimayā ",
  "tha-ap13:8.2": "phalikā veḷuriyāmayā / ",
  "tha-ap13:8.3": "pādukā abhirūhāmi ",
  "tha-ap13:8.4": "pādapīṭhass' idaṃ phalaṃ. // // ",
  "tha-ap13:9.1": "Catunavute ito kappe ",
  "tha-ap13:9.2": "yaṃ kammam akariṃ tadā / ",
  "tha-ap13:9.3": "duggatiṃ nābhijānāmi ",
  "tha-ap13:9.4": "puññakammass' idaṃ phalaṃ. // // ",
  "tha-ap13:10.1": "Tesattati ito kappe ",
  "tha-ap13:10.2": "Indanāmā tayo janā / ",
  "tha-ap13:10.3": "dvesattati ito kappe ",
  "tha-ap13:10.4": "tayo Sumana-nāmakā. // // ",
  "tha-ap13:11.1": "Samasattat' ito kappe ",
  "tha-ap13:11.2": "tayo Varuṇa-nāmakā / ",
  "tha-ap13:11.3": "sattaratanasampannā ",
  "tha-ap13:11.4": "catuddīpamhi issarā. // // ",
  "tha-ap13:12.1": "Paṭisambhidā catasso ",
  "tha-ap13:12.2": "vimokhā pi ca aṭṭh' ime / ",
  "tha-ap13:12.3": "chaḍabhiññā sacchikatā ",
  "tha-ap13:12.4": "kataṃ Buddhassa sāsanan ti. // // ",
  "tha-ap13:13.1": "Itthaṃ sudaṃ āyasmā Sīhāsanadāyako thero imā gāthāyo abhāsitthāti. Sīhāsanadāyakattherassa apadānaṃ samattaṃ. ",
  "tha-ap13:14.1": ""
}
