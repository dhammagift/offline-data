{
  "tha-ap32:0.1": "",
  "tha-ap32:0.2": "",
  "tha-ap32:0.3": "",
  "tha-ap32:1.1": "*Nagare Bandhumati*yā ",
  "tha-ap32:1.2": "ahosiṃ vāṇijo tadā / ",
  "tha-ap32:1.3": "ten' eva dāraṃ posemi ",
  "tha-ap32:1.4": "ropemi bījasampadaṃ. // // ",
  "tha-ap32:2.1": "Rathiyaṃ paṭipannassa ",
  "tha-ap32:2.2": "Vipassissa mahesino / ",
  "tha-ap32:2.3": "ekaṃ khomaṃ mayā dinnaṃ ",
  "tha-ap32:2.4": "kusalatthāya satthuno. // // ",
  "tha-ap32:3.1": "Ekanavute ito kappe ",
  "tha-ap32:3.2": "*yaṃ khomam adadiṃ tadā* / ",
  "tha-ap32:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap32:3.4": "khomadānass' idaṃ phalaṃ. // // ",
  "tha-ap32:4.1": "Sattavīse ito kappe ",
  "tha-ap32:4.2": "eko Sindhavasandano / ",
  "tha-ap32:4.3": "sattaratanasampanno ",
  "tha-ap32:4.4": "cātuddīpamhi issaro. // // ",
  "tha-ap32:5.1": "Paṭisambhidā catasso ",
  "tha-ap32:5.2": "vimokhā pi ca aṭṭh' ime / ",
  "tha-ap32:5.3": "chaḍabhiññā sacchikatā ",
  "tha-ap32:5.4": "kataṃ Buddhassa sāsanan ti. // // ",
  "tha-ap32:6.1": "Itthaṃ sudaṃ āyasmā Khomadāyako thero imā gāthāyo abhāsitthā ti. Khomadāyakatherassa apadānaṃ samattaṃ. ",
  "tha-ap32:7.1": "",
  "tha-ap32:8.1": "Uddānaṃ: ",
  "tha-ap32:9.1": "Subhūti Upavāno ca ",
  "tha-ap32:9.2": "Saraṇo Sīlagā*hako ",
  "tha-ap32:9.3": "Annasaṃsāvako Dhūpo* ",
  "tha-ap32:9.4": "Puḷino Uttiyena ca. ",
  "tha-ap32:10.1": "Añjalī Khomadāyī ca ",
  "tha-ap32:10.2": "das' eva tatiye gaṇe ",
  "tha-ap32:10.3": "pañcāsītisataṃ vuttā ",
  "tha-ap32:10.4": "gāthāyo sabbapiṇḍitā. ",
  "tha-ap32:11.1": "Subhūti vaggo tatiyo. ",
  "tha-ap32:12.1": ""
}
