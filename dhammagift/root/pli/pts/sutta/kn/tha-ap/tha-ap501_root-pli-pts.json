  "tha-ap501:1.1": "",
  "tha-ap501:1.2": "nāma pabbato / ",
  "tha-ap501:1.3": "sayambhū Nārado nāma ",
  "tha-ap501:1.4": "rukkhamūle vasī tadā. // // ",
  "tha-ap501:2.1": "Naḷāgāraṃ karitvāna ",
  "tha-ap501:2.2": "tiṇena chādayiṃ ahaṃ / ",
  "tha-ap501:2.3": "caṅkamaṃ sodhayitvāna ",
  "tha-ap501:2.4": "sayambhussa adās' ahaṃ. // // ",
  "tha-ap501:3.1": "Tena kammena sukatena ",
  "tha-ap501:3.2": "cetanāpaṇidhīhi ca / ",
  "tha-ap501:3.3": "jahitvā mānusaṃ dehaṃ ",
  "tha-ap501:3.4": "Tāvatiṃsaṃ agañch' ahaṃ. // // ",
  "tha-ap501:4.1": "Tattha me sukataṃ vyamhaṃ naḷakuṭikāya ",
  "tha-ap501:4.2": "nimmitaṃ / saṭṭhiyojanam ",
  "tha-ap501:4.3": "ubbiddhaṃ ",
  "tha-ap501:4.4": "tiṃsayojanavitthataṃ. // // ",
  "tha-ap501:5.1": "Catuddasesu kappesu ",
  "tha-ap501:5.2": "devaloke ramiṃ ahaṃ / ",
  "tha-ap501:5.3": "ekasattatikkhattuñ ca ",
  "tha-ap501:5.4": "devarajjam akārayiṃ. // // Catuttiṃsakkhattuñ c' ",
  "tha-ap501:6.1": "eva ",
  "tha-ap501:6.2": "cakkavatti ahos' ahaṃ / ",
  "tha-ap501:6.3": "padesarajjaṃ vipulaṃ ",
  "tha-ap501:6.4": "gaṇanāto asaṅkhiyaṃ. // // ",
  "tha-ap501:7.1": "Dhammapāsādam āruyha ",
  "tha-ap501:7.2": "sabbāgāravarūpamaṃ / ",
  "tha-ap501:7.3": "yadicchakāhaṃ vihareyy' ",
  "tha-ap501:7.4": "Sakyaputtassa sāsane. // // ",
  "tha-ap501:8.1": "Ekatiṃse ito kappe ",
  "tha-ap501:8.2": "yaṃ kammam akariṃ tadā / ",
  "tha-ap501:8.3": "duggatiṃ nābhijānāmi ",
  "tha-ap501:8.4": "naḷakuṭikāy' idaṃ phalaṃ. // // ",
  "tha-ap501:9.1": "Kilesā . . . ",
  "tha-ap501:9.2": "pe . . . ",
  "tha-ap501:9.3": "",
  "tha-ap501:10.1": "",
  "tha-ap501:10.2": "pe . . . ",
  "tha-ap501:10.3": "pe . . . // // Sāgataṃ . . . pe . . . pe . . . pe . . . // // ",
  "tha-ap501:11.1": "Paṭisambhidā . . . ",
  "tha-ap501:11.2": "pe . . . ",
  "tha-ap501:11.3": "pe . . . pe . . . // // ",
  "tha-ap501:12.1": "Itthaṃ sudaṃ āyasmā Naḷakuṭikadāyako thero i. g. a-ti. Naḷakuṭikadāyakattherassa apadānaṃ samattaṃ. ",
  "tha-ap501:13.1": ""
}
