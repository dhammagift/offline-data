  "tha-ap159:0.3": "",
  "tha-ap159:1.1": "",
  "tha-ap159:1.2": "Bhūtagaṇo nāma pabbato / ",
  "tha-ap159:1.3": "vasat' eko jino tattha ",
  "tha-ap159:1.4": "sayambhū lokanissaṭo. // // ",
  "tha-ap159:2.1": "Tiṇasūle gahetvāna ",
  "tha-ap159:2.2": "Buddhassa abhiropayiṃ / ",
  "tha-ap159:2.3": "ekūnasatasahassaṃ ",
  "tha-ap159:2.4": "kappānaṃ 'vinipātako. // // ",
  "tha-ap159:3.1": "Ito ekādase kappe ",
  "tha-ap159:3.2": "eko 'si Dharaṇīruho / ",
  "tha-ap159:3.3": "sattaratanasampanno ",
  "tha-ap159:3.4": "cakkavattī mahabbalo. // // ",
  "tha-ap159:4.1": "Paṭisambhidā . . . ",
  "tha-ap159:4.2": "pe . . . ",
  "tha-ap159:4.3": "pe . . . // // ",
  "tha-ap159:5.1": "Itthaṃ sudaṃ ā. Tiṇasulako thero i. g. ā-ti. Tiṇasūlakattherassa apadānaṃ samattaṃ. ",
  "tha-ap159:6.1": ""
}
