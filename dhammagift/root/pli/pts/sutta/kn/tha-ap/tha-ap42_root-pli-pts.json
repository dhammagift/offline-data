{
  "tha-ap42:0.1": "",
  "tha-ap42:0.2": "",
  "tha-ap42:0.3": "",
  "tha-ap42:1.1": "Siddhatthassa bhagavato ",
  "tha-ap42:1.2": "thūpaseṭṭhassa sammukhā / ",
  "tha-ap42:1.3": "vicittadusse laṅghetvā ",
  "tha-ap42:1.4": "kapparukkhaṃ ṭhapes' ahaṃ. // // ",
  "tha-ap42:2.1": "Yaṃ yaṃ *yonūpapajjāmi ",
  "tha-ap42:2.2": "devattaṃ* atha mānusaṃ / ",
  "tha-ap42:2.3": "sobhayanto mama dvāraṃ ",
  "tha-ap42:2.4": "kapparukkho patiṭṭhati. // // ",
  "tha-ap42:3.1": "Ahañ ca parisā c' eva ",
  "tha-ap42:3.2": "ye keci mama nissitā / ",
  "tha-ap42:3.3": "tamhā dussaṃ gahetvāna ",
  "tha-ap42:3.4": "nivāsema mayaṃ sadā. // // ",
  "tha-ap42:4.1": "Catunavute ito kappe ",
  "tha-ap42:4.2": "yaṃ rukkhaṃ ṭhapayiṃ tadā / ",
  "tha-ap42:4.3": "duggatiṃ nābhijānāmi ",
  "tha-ap42:4.4": "kapparukkhass' idaṃ phalaṃ. // // ",
  "tha-ap42:5.1": "Ito ca sattame kappe ",
  "tha-ap42:5.2": "Sucelā aṭṭha khattiyā / ",
  "tha-ap42:5.3": "sattaratanasampannā ",
  "tha-ap42:5.4": "cakkavattī mahābalā. // // ",
  "tha-ap42:6.1": "Paṭisambhidā catasso ",
  "tha-ap42:6.2": "vimokhā pi ca aṭṭh' ime / chaḷabhiññā sacchikatā ",
  "tha-ap42:6.3": "kataṃ Buddhassa sāsanan ti. // // ",
  "tha-ap42:7.1": "Itthaṃ sudaṃ āyasmā Kapparukkhiyo thero imā gāthāyo abhāsitthā ti. Kapparukkhiyatherassa apadānaṃ samattaṃ. ",
  "tha-ap42:8.1": "",
  "tha-ap42:9.1": "",
  "tha-ap42:10.1": "Tass' Uddānaṃ: ",
  "tha-ap42:11.1": "Kuṇḍa-Sāgata-Kaccānā ",
  "tha-ap42:11.2": "Udāyī Rājasavhayo ",
  "tha-ap42:11.3": "Adhimutto Lasuṇado ",
  "tha-ap42:11.4": "Āyāgī Dhammacakkiko. ",
  "tha-ap42:11.5": "Kapparukkhī ca dasamo ",
  "tha-ap42:11.6": "gāthā dvādasa sataṃ ti. "
}
