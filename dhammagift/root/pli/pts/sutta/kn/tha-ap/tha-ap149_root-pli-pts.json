  "tha-ap149:0.3": "",
  "tha-ap149:1.1": "Uttaritvāna nadikaṃ ",
  "tha-ap149:1.2": "vanaṃ gacchati cakkhumā / ",
  "tha-ap149:1.3": "tam addasāsiṃ sambuddhaṃ ",
  "tha-ap149:1.4": "Siddhaṭṭhaṃ varalakkhaṇaṃ // // ",
  "tha-ap149:2.1": "Kuddālapiṭakam ādāya ",
  "tha-ap149:2.2": "samaṃ katvāna taṃ pathaṃ / ",
  "tha-ap149:2.3": "satthāraṃ abhivādetvā ",
  "tha-ap149:2.4": "sakaṃ cittaṃ pasādayiṃ. // // ",
  "tha-ap149:3.1": "Catunavute ito kappe ",
  "tha-ap149:3.2": "yaṃ kammam akariṃ tadā / ",
  "tha-ap149:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap149:3.4": "maggadānass' idaṃ phalaṃ. // // ",
  "tha-ap149:4.1": "Sattapaññāsakappamhi ",
  "tha-ap149:4.2": "eko āsi janādhipo / ",
  "tha-ap149:4.3": "nāmena Suppabuddho ti ",
  "tha-ap149:4.4": "nāyako so narissaro. // // ",
  "tha-ap149:5.1": "Paṭisambhidā . . . ",
  "tha-ap149:5.2": "pe . . . ",
  "tha-ap149:5.3": "pe . . . // // ",
  "tha-ap149:6.1": "Itthaṃ sudaṃ ā. Maggadāyako thero i. g. a-ti. Maggadāyakattherassa apadānaṃ samattaṃ. ",
  "tha-ap149:7.1": ""
}
