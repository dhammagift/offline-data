  "tha-ap547:1.1": "Padumuttaro nāma jino ",
  "tha-ap547:1.2": "sabbadhammesu cakkhumā / ",
  "tha-ap547:1.3": "ito satasahassamhi ",
  "tha-ap547:1.4": "kappe uppajji nāyako. // // ",
  "tha-ap547:2.1": "Hitāya sabbasattānaṃ ",
  "tha-ap547:2.2": "sukhāya vadataṃ varo / ",
  "tha-ap547:2.3": "atthāya purisājañño ",
  "tha-ap547:2.4": "paṭipanno sadevake. // // ",
  "tha-ap547:3.1": "Yasaggapatto sirimā ",
  "tha-ap547:3.2": "kittivaṇṇabhato jino / ",
  "tha-ap547:3.3": "pūjito sabbalokassa ",
  "tha-ap547:3.4": "disā sabbā suvissuto. // // ",
  "tha-ap547:4.1": "Uttiṇṇavicikiccho so ",
  "tha-ap547:4.2": "vītivattakathaṃkatho / ",
  "tha-ap547:4.3": "paripuṇṇamanasaṅkappo ",
  "tha-ap547:4.4": "patto sambodhim uttamaṃ. // // ",
  "tha-ap547:5.1": "Anuppannassa maggassa ",
  "tha-ap547:5.2": "uppādetā naruttamo / ",
  "tha-ap547:5.3": "anakkhātañ ca akkhāsi ",
  "tha-ap547:5.4": "asañjātañ ca sañjanī. // // ",
  "tha-ap547:6.1": "Maggaññū so maggavidū ",
  "tha-ap547:6.2": "maggakkhāyī narāsabho / ",
  "tha-ap547:6.3": "maggassa kusalo satthā ",
  "tha-ap547:6.4": "sārathīnaṃ varuttamo. // // ",
  "tha-ap547:7.1": "Tadā mahākaruṇiko ",
  "tha-ap547:7.2": "dhammaṃ deseti nāyako / ",
  "tha-ap547:7.3": "nimugge mohamaggamhi ",
  "tha-ap547:7.4": "samuddharati pāṇino. // // ",
  "tha-ap547:8.1": "Bhikkhunīnaṃ ovadane ",
  "tha-ap547:8.2": "sāvakaṃ seṭṭhasammataṃ / ",
  "tha-ap547:8.3": "vaṇṇayaṃ etadaggamhi ",
  "tha-ap547:8.4": "paññāpesi mahāmuni. // // ",
  "tha-ap547:9.1": "Taṃ sutvā 'haṃ pamudito ",
  "tha-ap547:9.2": "nimantetvā Tathāgataṃ / ",
  "tha-ap547:9.3": "bhojayitvā sasaṅghaṃ taṃ ",
  "tha-ap547:9.4": "patthayiṃ thānam uttamaṃ. // // ",
  "tha-ap547:10.1": "Tadā pamudito nātho ",
  "tha-ap547:10.2": "maṃ avoca mahāisi: / ",
  "tha-ap547:10.3": "sukhī bhavassu dīghāyu, ",
  "tha-ap547:10.4": "lacchase taṃ manorathaṃ. // // ",
  "tha-ap547:11.1": "Satasahasse ito kappe ",
  "tha-ap547:11.2": "Okkākakulasambhavo / ",
  "tha-ap547:11.3": "Gotamo nāma nāmena ",
  "tha-ap547:11.4": "satthā loke bhavissati. // // ",
  "tha-ap547:12.1": "Tassa dhammesu dāyādo ",
  "tha-ap547:12.2": "oraso dhammanimmito / ",
  "tha-ap547:12.3": "Nandako nāma nāmena ",
  "tha-ap547:12.4": "hessati satthu sāvako. // // ",
  "tha-ap547:13.1": "Tena kammena sukatena ",
  "tha-ap547:13.2": "cetanāpaṇidhīhi ca / ",
  "tha-ap547:13.3": "jahitvā mānusaṃ dehaṃ ",
  "tha-ap547:13.4": "Tāvatiṃsupago ahaṃ. // // ",
  "tha-ap547:14.1": "Pacchime ca bhave dāni ",
  "tha-ap547:14.2": "jāto seṭṭhikule ahaṃ / ",
  "tha-ap547:14.3": "Sāvatthiyaṃ puravare ",
  "tha-ap547:14.4": "iddhe phīte mahaddhane. // // ",
  "tha-ap547:15.1": "Purappavese sugataṃ ",
  "tha-ap547:15.2": "disvā vimhitamānaso / ",
  "tha-ap547:15.3": "Jetārāmapaṭiggāhe ",
  "tha-ap547:15.4": "pabbajiṃ anagāriyaṃ. // // ",
  "tha-ap547:16.1": "Naciren' eva kālena ",
  "tha-ap547:16.2": "arahattaṃ apāpuṇiṃ / ",
  "tha-ap547:16.3": "tato 'ham tiṇṇasaṃsāro ",
  "tha-ap547:16.4": "sāsito sabbadassinā. // // ",
  "tha-ap547:17.1": "Bhikkhunīnaṃ dhammakathaṃ ",
  "tha-ap547:17.2": "paṭipucchākariṃ ahaṃ / ",
  "tha-ap547:17.3": "sāsitā tā mayā sabbā ",
  "tha-ap547:17.4": "abhaviṃsu anāsavā // // ",
  "tha-ap547:18.1": "Satāni pañc' anūnāni; ",
  "tha-ap547:18.2": "tadā tuṭṭho mahāhito / ",
  "tha-ap547:18.3": "bhikkhunīnaṃ ovadataṃ ",
  "tha-ap547:18.4": "agge ṭhāne ṭhapesi maṃ. // // ",
  "tha-ap547:19.1": "Satasahasse kataṃ kammaṃ ",
  "tha-ap547:19.2": "phalaṃ dassesi me idha / ",
  "tha-ap547:19.3": "sumutto saravego ca ",
  "tha-ap547:19.4": "kilese jhāpayiṃ mama. // // ",
  "tha-ap547:20.1": "Kilesā . . . ",
  "tha-ap547:20.2": "pe . . . ",
  "tha-ap547:20.3": "",
  "tha-ap547:21.1": "",
  "tha-ap547:21.2": "pe . . . ",
  "tha-ap547:21.3": "pe . . . // // Sāgataṃ . . . pe . . . pe . . . pe . . . // // ",
  "tha-ap547:22.1": "Paṭisambhidā . . . ",
  "tha-ap547:22.2": "pe . . . ",
  "tha-ap547:22.3": "pe . . . pe . . . // // ",
  "tha-ap547:23.1": "Itthaṃ sudaṃ āyasmā Nandako thero i. g. a-ti. Nandakattherassa apadānaṃ samattaṃ. ",
  "tha-ap547:24.1": ""
}
