  "tha-ap244:0.3": "",
  "tha-ap244:1.1": "Dhanuṃ adejjhaṃ katvāna ",
  "tha-ap244:1.2": "vanam ajjhogahiṃ ahaṃ / ",
  "tha-ap244:1.3": "kesaraṃ osaraṃ disvā ",
  "tha-ap244:1.4": "sabbamaṭṭaṃ supupphitaṃ. // // ",
  "tha-ap244:2.1": "Ubho hatthehi paggayha ",
  "tha-ap244:2.2": "sire katvāna añjaliṃ / ",
  "tha-ap244:2.3": "Buddhassa abhiropesiṃ ",
  "tha-ap244:2.4": "Tissassa lokabandhuno. // // ",
  "tha-ap244:3.1": "Dvenavute ito kappe ",
  "tha-ap244:3.2": "yaṃ pupphaṃ abhipūjayiṃ / ",
  "tha-ap244:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap244:3.4": "Buddhapūjāy' idaṃ phalaṃ. // // ",
  "tha-ap244:4.1": "Sattasattat' ime kappe ",
  "tha-ap244:4.2": "Pamokkharaṇa-nāmako / ",
  "tha-ap244:4.3": "sattaratanasampanno ",
  "tha-ap244:4.4": "cakkavattī mahabbalo. // // ",
  "tha-ap244:5.1": "Paṭisambhidā . . . ",
  "tha-ap244:5.2": "pe . . . ",
  "tha-ap244:5.3": "pe . . . // // ",
  "tha-ap244:6.1": "Itthaṃ sudaṃ āyasmā Nāgakesariyo thero i. g. a-ti. Nāgakesariyattherassa ",
  "tha-ap244:7.1": "apadānaṃ samattaṃ. Jātasarassa "
}
