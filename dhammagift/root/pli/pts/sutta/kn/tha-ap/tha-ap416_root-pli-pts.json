  "tha-ap416:1.1": "Nagare Bandhumatiyā ",
  "tha-ap416:1.2": "sūkariko ahos' ahaṃ / ",
  "tha-ap416:1.3": "ukkoṭakaṃ randhayitvā ",
  "tha-ap416:1.4": "madhusappimhi ākiriṃ. // // ",
  "tha-ap416:2.1": "Sannipātam ahaṃ gantvā ",
  "tha-ap416:2.2": "ekaṃ pattaṃ gahes' ahaṃ / ",
  "tha-ap416:2.3": "pūrayitvāna taṃ pattaṃ ",
  "tha-ap416:2.4": "bhikkhusaṅghassa dās' ahaṃ. // // ",
  "tha-ap416:3.1": "Yo 'ttha therataro bhikkhu ",
  "tha-ap416:3.2": "niyyātesi mamaṃ tadā: / ",
  "tha-ap416:3.3": "iminā pattapūrena ",
  "tha-ap416:3.4": "labhassu vipulaṃ sukhaṃ. // // ",
  "tha-ap416:4.1": "Dve sampattiyo bhutvā ",
  "tha-ap416:4.2": "sukkamūlena codito / ",
  "tha-ap416:4.3": "pacchime vattamānamhi ",
  "tha-ap416:4.4": "kilese jhāpayissati. // // ",
  "tha-ap416:5.1": "Tattha cittaṃ pasādetvā ",
  "tha-ap416:5.2": "Tāvatiṃsam agacch' ahaṃ / ",
  "tha-ap416:5.3": "tattha bhutvā ca pitvā ca ",
  "tha-ap416:5.4": "labhāmi vipulaṃ sukhaṃ. // // ",
  "tha-ap416:6.1": "Maṇḍape rukkhamūle vā ",
  "tha-ap416:6.2": "pubbakammam anussariṃ / ",
  "tha-ap416:6.3": "annapānābhivasso me ",
  "tha-ap416:6.4": "abhivassati tāvade. // // ",
  "tha-ap416:7.1": "Idaṃ pacchimakaṃ mayhaṃ ",
  "tha-ap416:7.2": "carimo vattate bhavo / ",
  "tha-ap416:7.3": "idhāpi annapānam me ",
  "tha-ap416:7.4": "vassate sabbakālikaṃ. // // ",
  "tha-ap416:8.1": "Ten' eva maṃsadānena ",
  "tha-ap416:8.2": "sandhāvitvā bhave ahaṃ / ",
  "tha-ap416:8.3": "sabbāsave pariññāya ",
  "tha-ap416:8.4": "viharāmi anāsavo. // // ",
  "tha-ap416:9.1": "Ekanavute ito kappe ",
  "tha-ap416:9.2": "yaṃ dānam adadiṃ tadā / ",
  "tha-ap416:9.3": "duggatiṃ nābhijānāmi ",
  "tha-ap416:9.4": "madhudānass' idaṃ phalaṃ. // // ",
  "tha-ap416:10.1": "Kilesā . . . ",
  "tha-ap416:10.2": "pe . . . ",
  "tha-ap416:10.3": "",
  "tha-ap416:11.1": "",
  "tha-ap416:11.2": "pe . . . // // ",
  "tha-ap416:11.3": "Sāgataṃ . . . pe . . . pe . . . // // ",
  "tha-ap416:12.1": "Paṭisambhidā . . . ",
  "tha-ap416:12.2": "pe . . . ",
  "tha-ap416:12.3": "pe . . . // // ",
  "tha-ap416:13.1": "Itthaṃ sudam āyasmā Madhumaṃsadāyako th. i. g. a-ti. Madhumaṃsadāyakattherassa ",
  "tha-ap416:14.1": "apadānaṃ samattaṃ. "
}
