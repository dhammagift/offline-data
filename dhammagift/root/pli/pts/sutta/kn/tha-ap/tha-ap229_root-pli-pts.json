  "tha-ap229:0.3": "",
  "tha-ap229:1.1": "Uyyānabhūmiṃ niyyanto ",
  "tha-ap229:1.2": "addasaṃ lokanāyakaṃ / ",
  "tha-ap229:1.3": "vaṭaṃsakaṃ gahetvāna ",
  "tha-ap229:1.4": "sovaṇṇaṃ sādhunimmitaṃ // // ",
  "tha-ap229:2.1": "Sīghaṃ tato samārūḷho ",
  "tha-ap229:2.2": "hatthikkhandhagato ahaṃ / ",
  "tha-ap229:2.3": "Buddhassa abhiropesiṃ ",
  "tha-ap229:2.4": "Sikhino lokabandhuno. // // ",
  "tha-ap229:3.1": "Ekatiṃse ito kappe ",
  "tha-ap229:3.2": "yaṃ puppham abhipūjayiṃ / ",
  "tha-ap229:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap229:3.4": "Buddhapūjāy' idaṃ phalaṃ. // // ",
  "tha-ap229:4.1": "Sattavīse ito kappe ",
  "tha-ap229:4.2": "eko āsi janādhipo / ",
  "tha-ap229:4.3": "Mahāpatāpo nāmena ",
  "tha-ap229:4.4": "cakkavattī mahabbalo. // // ",
  "tha-ap229:5.1": "Paṭisambhidā . . . ",
  "tha-ap229:5.2": "pe . . . ",
  "tha-ap229:5.3": "pe . . . // // ",
  "tha-ap229:6.1": "Itthaṃ sudam āyasmā Sovaṇṇavataṃsakiyo thero i. g. a-ti. Vataṃsakiyattherassa ",
  "tha-ap229:7.1": "apadānaṃ samattaṃ. "
}
