{
  "tha-ap12:0.1": "",
  "tha-ap12:0.2": "",
  "tha-ap12:0.3": "",
  "tha-ap12:1.1": "Ārāmādvārā nikkhamma ",
  "tha-ap12:1.2": "Padumuttaro mahāmuni / ",
  "tha-ap12:1.3": "vassanto amataṃ vuṭṭhiṃ ",
  "tha-ap12:1.4": "nibbāpesi mahājanaṃ. // // ",
  "tha-ap12:2.1": "Satasahassāni vīrā ",
  "tha-ap12:2.2": "chaḷabhiññā mahiddhikā / ",
  "tha-ap12:2.3": "parivārenti sambuddhaṃ ",
  "tha-ap12:2.4": "chāyā 'va anapāyinī. // // ",
  "tha-ap12:3.1": "Hatthikkhandhagato āsiṃ ",
  "tha-ap12:3.2": "setacchattam varuttamaṃ / ",
  "tha-ap12:3.3": "sucārurūpaṃ disvāna ",
  "tha-ap12:3.4": "vitti me udapajjatha. // // ",
  "tha-ap12:4.1": "Oruyha hatthikkhandhamhā ",
  "tha-ap12:4.2": "upagacchiṃ narāsabhaṃ / ",
  "tha-ap12:4.3": "ratanāmayachattam me ",
  "tha-ap12:4.4": "Buddhaseṭṭhassa dhārayiṃ. // // ",
  "tha-ap12:5.1": "Mama saṅkappam aññāya ",
  "tha-ap12:5.2": "Padumuttaro mahāisi / ",
  "tha-ap12:5.3": "taṃ kathaṃ ṭhapayitvāna ",
  "tha-ap12:5.4": "imā gāthā abhāsatha: // // ",
  "tha-ap12:6.1": "‘Yo so chattaṃ adhāresi ",
  "tha-ap12:6.2": "soṇṇalaṅkārabhūsitaṃ / ",
  "tha-ap12:6.3": "tam ahaṃ kittayissāmi; ",
  "tha-ap12:6.4": "suṇotha mama bhāsato: // // ",
  "tha-ap12:7.1": "Ito gantvā ayaṃ poso ",
  "tha-ap12:7.2": "Tusitaṃ āvasissati / ",
  "tha-ap12:7.3": "anubhossati sampattiṃ ",
  "tha-ap12:7.4": "accharāhi purakkhato. // // ",
  "tha-ap12:8.1": "Catutiṃsatikkhattuñ ca ",
  "tha-ap12:8.2": "devarajjaṃ karissati / ",
  "tha-ap12:8.3": "balādhipo aṭṭhasataṃ ",
  "tha-ap12:8.4": "vasudhaṃ āvasissati. // // ",
  "tha-ap12:9.1": "Aṭṭhapaññāsakkhattuñ ca ",
  "tha-ap12:9.2": "cakkavatti bhavissati / ",
  "tha-ap12:9.3": "padesarajjaṃ vipulaṃ ",
  "tha-ap12:9.4": "mahiyā kā*rayissati.* // // ",
  "tha-ap12:10.1": "Kappasatasahassamhi ",
  "tha-ap12:10.2": "Okkākakulasambhavo / ",
  "tha-ap12:10.3": "Gotamo nāma gottena ",
  "tha-ap12:10.4": "satthā loke bhavissati. // // ",
  "tha-ap12:11.1": "Sakyānaṃ kulaketussa ",
  "tha-ap12:11.2": "ñātibandhu bhavissati / ",
  "tha-ap12:11.3": "Ānando nāma nāmena ",
  "tha-ap12:11.4": "upaṭṭhāko mahesino. // // ",
  "tha-ap12:12.1": "Ātā*pī ni*pako cāpi ",
  "tha-ap12:12.2": "bāhusaccesu kovido / ",
  "tha-ap12:12.3": "nivātavutti athaddho ",
  "tha-ap12:12.4": "sabbapāṭhī bhavissati. // // ",
  "tha-ap12:13.1": "Padhānapahitatto so ",
  "tha-ap12:13.2": "upasanto nirūpadhi / ",
  "tha-ap12:13.3": "sabbāsave pariññāya ",
  "tha-ap12:13.4": "nibbāyissat' anāsavo'. // // ",
  "tha-ap12:14.1": "Santi āraññakā nāgā ",
  "tha-ap12:14.2": "kuñjarā saṭṭhihāyanā / ",
  "tha-ap12:14.3": "tidhāppabhinnā mātaṅgā-r- ",
  "tha-ap12:14.4": "īsādantā urūḷhavā. // // ",
  "tha-ap12:15.1": "Anekasatasahassā ",
  "tha-ap12:15.2": "paṇḍitā pi mahiddhikā / ",
  "tha-ap12:15.3": "sabbe te Buddhanāgassa ",
  "tha-ap12:15.4": "na honti parivimhitā. // // ",
  "tha-ap12:16.1": "Ādiyāme namassāmi ",
  "tha-ap12:16.2": "majjhime atha pacchime / ",
  "tha-ap12:16.3": "pasannacitto sumano ",
  "tha-ap12:16.4": "Buddhaseṭṭhaṃ upaṭṭhahiṃ. // // ",
  "tha-ap12:17.1": "Ātāpī nipako cāpi ",
  "tha-ap12:17.2": "sampajāno patissato / ",
  "tha-ap12:17.3": "sotāpattiphalaṃ patto ",
  "tha-ap12:17.4": "sekhabhūmisu kovido. // // ",
  "tha-ap12:18.1": "Kappe 'to satasahasse ",
  "tha-ap12:18.2": "yaṃ kammam abhinīhariṃ / ",
  "tha-ap12:18.3": "tāhaṃ bhūmim anuppatto ṭhito saṅgama- ",
  "tha-ap12:18.4": "m-ācalo. // // ",
  "tha-ap12:19.1": "Sāgataṃ vata me āsi ",
  "tha-ap12:19.2": "Buddhaseṭṭhassa santike / ",
  "tha-ap12:19.3": "tisso vijjā anuppatto ",
  "tha-ap12:19.4": "kataṃ Buddhassasāsanaṃ. // // ",
  "tha-ap12:20.1": "Paṭisambhidā catasso ",
  "tha-ap12:20.2": "vimokhā pi ca aṭṭh' ime / ",
  "tha-ap12:20.3": "chaḍabhiññā sacchikatā ",
  "tha-ap12:20.4": "kataṃ Buddhassa sāsanan ti. // // ",
  "tha-ap12:21.1": "Itthaṃ sudaṃ āyasmā Ānandatthero imā gāthāyo abhāsitthā ti. Ānandattherassa apadānaṃ samattaṃ. ",
  "tha-ap12:22.1": "",
  "tha-ap12:23.1": "Uddānaṃ: ",
  "tha-ap12:24.1": "Buddho Paccekasambuddho ",
  "tha-ap12:24.2": "Sāriputto ca Kolito ",
  "tha-ap12:24.3": "Kassapo Anuruddho ca ",
  "tha-ap12:24.4": "Puṇṇathero Upāli ca. ",
  "tha-ap12:25.1": "Koṇḍañño *ca* Piṇḍolo ",
  "tha-ap12:25.2": "*ca* Revat' Ānanda paṇḍito ",
  "tha-ap12:25.3": "chassatāni ca paññāsa ",
  "tha-ap12:25.4": "gathāyo sabbapiṇḍitā. ",
  "tha-ap12:26.1": "Apadāne Buddhavaggo paṭhamo. "
}
