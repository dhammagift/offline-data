{
  "tha-ap326:0.1": "",
  "tha-ap326:0.2": "",
  "tha-ap326:0.3": "",
  "tha-ap326:1.1": "Jātiyā sattavasso 'haṃ ",
  "tha-ap326:1.2": "ahosiṃ mantapāragū / ",
  "tha-ap326:1.3": "kulavaṃsam adhāresiṃ ",
  "tha-ap326:1.4": "yañño ussāhito mayā. // // ",
  "tha-ap326:2.1": "Cullāsītisahassāni ",
  "tha-ap326:2.2": "pasū haññanti me sadā / sārasmiṃ ",
  "tha-ap326:2.3": "hi upanītāni ",
  "tha-ap326:2.4": "yaññatthāya upaṭṭhitā. // // ",
  "tha-ap326:3.1": "Ukkāmukho pahaṭo va ",
  "tha-ap326:3.2": "khadiraṅgārasannibho / ",
  "tha-ap326:3.3": "udayanto va suriyo ",
  "tha-ap326:3.4": "puṇṇamāse va candimā // // ",
  "tha-ap326:4.1": "Siddhattho sabbasiddhattho ",
  "tha-ap326:4.2": "tilokamahito hito / ",
  "tha-ap326:4.3": "upagantvāna sambuddho ",
  "tha-ap326:4.4": "idaṃ vacanam abravi: // // ",
  "tha-ap326:5.1": "‘Ahiṃsā sabbapāṇānaṃ ",
  "tha-ap326:5.2": "kumāra mama ruccati / ",
  "tha-ap326:5.3": "theyyā ca aticārā ca ",
  "tha-ap326:5.4": "majjapānā ca ārati. // // ",
  "tha-ap326:6.1": "Rati ca samacariyāya ",
  "tha-ap326:6.2": "bāhusaccakataññutā / ",
  "tha-ap326:6.3": "diṭṭhe dhamme paratthā ca ",
  "tha-ap326:6.4": "dhammā ete pasaṃsiyā. // // ",
  "tha-ap326:7.1": "Ete dhamme bhāvayitvā ",
  "tha-ap326:7.2": "sattāsattahite rato / ",
  "tha-ap326:7.3": "Buddhe cittaṃ pasādetvā ",
  "tha-ap326:7.4": "bhāvehi maggam uttamaṃ.' // // ",
  "tha-ap326:8.1": "Idaṃ vatvāna sabbaññū ",
  "tha-ap326:8.2": "lokajeṭṭho narāsabho / ",
  "tha-ap326:8.3": "mam evam anusāsetvā ",
  "tha-ap326:8.4": "vehāsam uggato gato. // // ",
  "tha-ap326:9.1": "Pubbe cittaṃ visodhetvā ",
  "tha-ap326:9.2": "pacchā cittaṃ pasādayiṃ. / ",
  "tha-ap326:9.3": "Tena cittappasādena ",
  "tha-ap326:9.4": "Tusitam upapajj' ahaṃ. // // Catunavute ",
  "tha-ap326:10.1": "ito kappe ",
  "tha-ap326:10.2": "yadā cittaṃ pasādayiṃ / ",
  "tha-ap326:10.3": "duggatiṃ nābhijānāmi ",
  "tha-ap326:10.4": "Buddhasaññāy' idaṃ phalaṃ. // // ",
  "tha-ap326:11.1": "Paṭisambhidā . . . ",
  "tha-ap326:11.2": "pe . . . ",
  "tha-ap326:11.3": "pe . . . // // ",
  "tha-ap326:12.1": "Itthaṃ sudam āyasmā Saññasāmiko thero i. g. a-ti. Saññasāmikattherassa ",
  "tha-ap326:13.1": "apadānaṃ samattaṃ. "
}
