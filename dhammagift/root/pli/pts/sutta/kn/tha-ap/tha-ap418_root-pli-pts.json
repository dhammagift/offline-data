  "tha-ap418:0.3": "",
  "tha-ap418:1.1": "sugate ",
  "tha-ap418:1.2": "Siddhatthe lokanāyak / ",
  "tha-ap418:1.3": "sadevamanusā sabbe ",
  "tha-ap418:1.4": "pūjenti dipaduttamaṃ. // // ",
  "tha-ap418:2.1": "Āropite ca citake ",
  "tha-ap418:2.2": "Siddhatthe lokanāyake / ",
  "tha-ap418:2.3": "yathāsakena thāmena ",
  "tha-ap418:2.4": "citaṃ pūjenti satthuno. // // ",
  "tha-ap418:3.1": "Avidūre citakassa ",
  "tha-ap418:3.2": "dīpam ujjālayim ahaṃ / ",
  "tha-ap418:3.3": "yāva udeti suriyo ",
  "tha-ap418:3.4": "dīpam me tāva ujjali. // // ",
  "tha-ap418:4.1": "Tena kammena sukatena ",
  "tha-ap418:4.2": "cetanāpaṇidhīhi ca / ",
  "tha-ap418:4.3": "jahitvā mānusaṃ dehaṃ ",
  "tha-ap418:4.4": "Tāvatiṃsam agacch' ahaṃ. // // ",
  "tha-ap418:5.1": "Tattha me sukataṃ vyamhaṃ ",
  "tha-ap418:5.2": "Ekadīpī ti ñāyati / ",
  "tha-ap418:5.3": "dīpasatasahassāni ",
  "tha-ap418:5.4": "vyamhe pajjalare mama. // // ",
  "tha-ap418:6.1": "Udayanto va suriyo ",
  "tha-ap418:6.2": "deho me rājate sadā / ",
  "tha-ap418:6.3": "sabb'ābhāhi sarīrassa ",
  "tha-ap418:6.4": "āloko hoti me sadā. // // ",
  "tha-ap418:7.1": "Tirokuḍḍaṃ tiroselaṃ ",
  "tha-ap418:7.2": "samatiggayha pabbataṃ / ",
  "tha-ap418:7.3": "samantā yojanasataṃ ",
  "tha-ap418:7.4": "passāmi cakkhunā ahaṃ. // // ",
  "tha-ap418:8.1": "Sattasattatikkhattuñ ca ",
  "tha-ap418:8.2": "devaloke ramiṃ ahaṃ / ",
  "tha-ap418:8.3": "ekatiṃsakkhattuñ ca ",
  "tha-ap418:8.4": "devarajjam akārayiṃ. // // ",
  "tha-ap418:9.1": "Aṭṭhavīsatikkhattuñ ca ",
  "tha-ap418:9.2": "cakkavattī ahos' ahaṃ / ",
  "tha-ap418:9.3": "padesarajjaṃ vipulaṃ ",
  "tha-ap418:9.4": "gaṇanāto asaṅkhiyaṃ. // // ",
  "tha-ap418:10.1": "Devalokā cavitvāna ",
  "tha-ap418:10.2": "nibbattiṃ mātukucchiyaṃ / ",
  "tha-ap418:10.3": "mātukucchigatassāpi ",
  "tha-ap418:10.4": "akkhi me na nimīlati. // // ",
  "tha-ap418:11.1": "Jātiyā catuvasso' haṃ ",
  "tha-ap418:11.2": "pabbajiṃ anagāriyaṃ / ",
  "tha-ap418:11.3": "aḍḍhamāse asampatte ",
  "tha-ap418:11.4": "arahattam apāpuṇiṃ. // // Dibbaṃ ",
  "tha-ap418:12.1": "cakkhuṃ visodhesiṃ ",
  "tha-ap418:12.2": "bhavā sabbe samūhatā / ",
  "tha-ap418:12.3": "sabbe kilesā sañchinnā ",
  "tha-ap418:12.4": "ekadīpass' idaṃ phalaṃ. // // ",
  "tha-ap418:13.1": "Tirokuḍḍhaṃ tiroselaṃ ",
  "tha-ap418:13.2": "pabbatañ cāpi kevalaṃ / ",
  "tha-ap418:13.3": "samatikkamma passāmi ",
  "tha-ap418:13.4": "ekadīpass' idaṃ phalaṃ. // // ",
  "tha-ap418:14.1": "Visamā me samā honti ",
  "tha-ap418:14.2": "andhakāro na vijjati / ",
  "tha-ap418:14.3": "nāhaṃ passāmi timiram ",
  "tha-ap418:14.4": "ekadīpass' idaṃ phalaṃ. // // ",
  "tha-ap418:15.1": "Catunavute ito kappe ",
  "tha-ap418:15.2": "yaṃ dīpam adadiṃ tadā / ",
  "tha-ap418:15.3": "duggatiṃ nābhijānāmi ",
  "tha-ap418:15.4": "ekadīpass' idaṃ phalaṃ. // // ",
  "tha-ap418:16.1": "Kilesā . . . ",
  "tha-ap418:16.2": "pe . . . ",
  "tha-ap418:16.3": "",
  "tha-ap418:17.1": "",
  "tha-ap418:17.2": "pe . . . // // ",
  "tha-ap418:17.3": "Sāgataṃ . . . pe . . . pe . . . pe . . . // // ",
  "tha-ap418:18.1": "Paṭisambhidā . . . ",
  "tha-ap418:18.2": "pe . . . ",
  "tha-ap418:18.3": "pe . . . // // ",
  "tha-ap418:19.1": "Itthaṃ sudam āyasmā Edakīpiyo th. i. g. a-ti. Ekadīpiyattherassa apadānaṃ samattaṃ. ",
  "tha-ap418:20.1": ""
}
