  "tha-ap291:1.1": "me nāma ",
  "tha-ap291:1.2": "pitu santaṃ mamaṃ tadā / ",
  "tha-ap291:1.3": "mama hatthaṃ gahetvāna ",
  "tha-ap291:1.4": "upānayi mahāmuniṃ. // // ",
  "tha-ap291:2.1": "Ime mam uddisissanti ",
  "tha-ap291:2.2": "Buddhā lokagganāyakā / ",
  "tha-ap291:2.3": "te 'ham upaṭṭhahiṃ sakkaccaṃ ",
  "tha-ap291:2.4": "pasanno sehi pāṇihi. // // ",
  "tha-ap291:3.1": "Ekatiṃse ito kappe ",
  "tha-ap291:3.2": "Buddhe paricariṃ tadā / ",
  "tha-ap291:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap291:3.4": "upaṭṭhānass' idaṃ phalaṃ. // // ",
  "tha-ap291:4.1": "Tevisamhi ito kappe ",
  "tha-ap291:4.2": "caturo āsuṃ khattiyā / ",
  "tha-ap291:4.3": "Samaṇūpaṭṭhākā nāma ",
  "tha-ap291:4.4": "cakkavattī mahabbalā. // // ",
  "tha-ap291:5.1": "Paṭisambhidā . . . ",
  "tha-ap291:5.2": "pe . . . ",
  "tha-ap291:5.3": "pe . . . // // ",
  "tha-ap291:6.1": "Itthaṃ sudam āyasmā Buddhūpaṭṭhāko thero i. g. a-ti. Buddhūpaṭṭhāyakattherassa apadānaṃ samattaṃ. ",
  "tha-ap291:7.1": ""
}
