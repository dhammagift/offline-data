  "tha-ap217:1.1": "Udentaṃ sataraṃsīva ",
  "tha-ap217:1.2": "vītaraṃsīva bhānumaṃ / ",
  "tha-ap217:1.3": "vyagghūsabhaṃ va pavaraṃ ",
  "tha-ap217:1.4": "sujātaṃ pabbatantare. // // ",
  "tha-ap217:2.1": "Buddhassa ānubhāvo so ",
  "tha-ap217:2.2": "jalate pabbatantare / ",
  "tha-ap217:2.3": "raṃse cittaṃ pasādetvā ",
  "tha-ap217:2.4": "kappaṃ saggamhi mod' ahaṃ. // // ",
  "tha-ap217:3.1": "Avasesu kappesu ",
  "tha-ap217:3.2": "kusalaṃ tīritaṃ mayā / ",
  "tha-ap217:3.3": "tena cittappasādena ",
  "tha-ap217:3.4": "Buddhānussatiyāpi ca. // // ",
  "tha-ap217:4.1": "Tiṃsakappasahasse 'to ",
  "tha-ap217:4.2": "yaṃ saññam alabhiṃ tadā / ",
  "tha-ap217:4.3": "duggatiṃ nābhijānāmi ",
  "tha-ap217:4.4": "Buddhasaññāy' idaṃ phalaṃ. // // ",
  "tha-ap217:5.1": "Sattapaññāsakappamhi ",
  "tha-ap217:5.2": "eko āsi janādhipo / ",
  "tha-ap217:5.3": "Sujāto nāmo nāmena ",
  "tha-ap217:5.4": "cakkavattī mahabbalo. // // ",
  "tha-ap217:6.1": "Paṭisambhidā . . . ",
  "tha-ap217:6.2": "pe . . . ",
  "tha-ap217:6.3": "pe . . . // // ",
  "tha-ap217:7.1": "Itthaṃ sudam āyasmā Saraṃsisaññako thero i. g. a-ti. Raṃsisaññakattherassa apadānaṃ samattaṃ. ",
  "tha-ap217:8.1": ""
}
