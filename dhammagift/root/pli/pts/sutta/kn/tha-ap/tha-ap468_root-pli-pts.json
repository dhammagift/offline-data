  "tha-ap468:1.1": "Sataraṃsī nāma bhagavā ",
  "tha-ap468:1.2": "sayambhū aparājito / ",
  "tha-ap468:1.3": "vivekakāmo sambuddho ",
  "tha-ap468:1.4": "gocarāyābhinikkhami // // ",
  "tha-ap468:2.1": "Phalahattho ahaṃ disvā ",
  "tha-ap468:2.2": "upagacchiṃ narāsabhaṃ / ",
  "tha-ap468:2.3": "pasannacitto sumano ",
  "tha-ap468:2.4": "adāsim avaṭaṃ phalaṃ. // // ",
  "tha-ap468:3.1": "Catunavute ito kappe ",
  "tha-ap468:3.2": "yaṃ phalam adadiṃ tadā / ",
  "tha-ap468:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap468:3.4": "phaladānass' idaṃ phalaṃ. // // ",
  "tha-ap468:4.1": "Kilesā . . . ",
  "tha-ap468:4.2": "pe . . . ",
  "tha-ap468:4.3": "",
  "tha-ap468:5.1": "",
  "tha-ap468:5.2": "pe . . . ",
  "tha-ap468:5.3": "pe . . . // // Sāgataṃ . . . pe . . . pe . . . pe . . . // // ",
  "tha-ap468:6.1": "Paṭisambhidā . . . ",
  "tha-ap468:6.2": "pe . . . ",
  "tha-ap468:6.3": "pe . . . pe . . . // // ",
  "tha-ap468:7.1": "Itthaṃ sudam āyasmā Avaṭaphaliyo th. i. g. a-ti. Avaṭaphaliyattherassa apadānaṃ samattaṃ. ",
  "tha-ap468:8.1": ""
}
