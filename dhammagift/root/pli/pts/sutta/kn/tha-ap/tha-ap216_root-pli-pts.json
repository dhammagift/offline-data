  "tha-ap216:1.1": "Dumagge paṃsukūlikaṃ ",
  "tha-ap216:1.2": "laggaṃ disvāna satthuno / ",
  "tha-ap216:1.3": "añjaliṃ paggahetvāna ",
  "tha-ap216:1.4": "paṃsukūlam avandi 'haṃ. // // ",
  "tha-ap216:2.1": "Ekatiṃse ito kappe ",
  "tha-ap216:2.2": "yaṃ saññam alabhiṃ tadā / ",
  "tha-ap216:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap216:2.4": "Buddhapūjāy' idaṃ phalaṃ. // // ",
  "tha-ap216:3.1": "Pañcavīse ito kappe ",
  "tha-ap216:3.2": "eko āsi janādhipo / ",
  "tha-ap216:3.3": "Amitābho ti nāmena ",
  "tha-ap216:3.4": "cakkavattī mahabbalo. // // ",
  "tha-ap216:4.1": "Paṭisambhidā . . . ",
  "tha-ap216:4.2": "pe . . . ",
  "tha-ap216:4.3": "pe . . . // // ",
  "tha-ap216:5.1": "Itthaṃ sudam āyasmā Ekasaññako thero i. g. a-ti. Ekasaññakattherassa apadānaṃ samattaṃ. ",
  "tha-ap216:6.1": ""
}
