  "tha-ap305:1.1": "jotantam ",
  "tha-ap305:1.2": "udayantaṃ va bhāṇumaṃ / ",
  "tha-ap305:1.3": "Vipassim addasaṃ Buddhaṃ ",
  "tha-ap305:1.4": "lokajeṭṭhaṃ narāsabhaṃ. // // ",
  "tha-ap305:2.1": "Añjaliṃ paggahetvāna ",
  "tha-ap305:2.2": "atinesiṃ sakaṃ gharaṃ / ",
  "tha-ap305:2.3": "atinetvāna sambuddhaṃ ",
  "tha-ap305:2.4": "paramannam adās' ahaṃ. // // Ekanavute ",
  "tha-ap305:3.1": "ito kappe ",
  "tha-ap305:3.2": "paramannam adadiṃ tadā / ",
  "tha-ap305:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap305:3.4": "paramannass' idaṃ phalaṃ. // // ",
  "tha-ap305:4.1": "Paṭisambhidā . . . ",
  "tha-ap305:4.2": "pe . . . ",
  "tha-ap305:4.3": "pe . . . // // ",
  "tha-ap305:5.1": "Itthaṃ sudam āyasmā Paramannadāyako th. i. g. a-ti. Paramannadāyakattherassa apadānaṃ samattaṃ. ",
  "tha-ap305:6.1": ""
}
