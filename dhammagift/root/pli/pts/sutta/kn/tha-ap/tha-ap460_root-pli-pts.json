  "tha-ap460:1.1": "Parinibbute bhagavati ",
  "tha-ap460:1.2": "Padumuttare mahāyase / ",
  "tha-ap460:1.3": "pupphaṃ caṅgoṭake katvā ",
  "tha-ap460:1.4": "sarīram abhiropayiṃ. // // ",
  "tha-ap460:2.1": "Tattha cittaṃ pasādetvā ",
  "tha-ap460:2.2": "Nimmānam agamās' ahaṃ / ",
  "tha-ap460:2.3": "devalokagato santo ",
  "tha-ap460:2.4": "puññakammaṃ sarām' ahaṃ. // // ",
  "tha-ap460:3.1": "Ambarā pupphavasso me ",
  "tha-ap460:3.2": "sabbakālam pavassati / ",
  "tha-ap460:3.3": "saṃsarāmi manusse ce ",
  "tha-ap460:3.4": "rājā homi mahāyaso. // // ",
  "tha-ap460:4.1": "Tahiṃ kusumavasso me ",
  "tha-ap460:4.2": "abhivassati sabbadā / ",
  "tha-ap460:4.3": "tāy' eva pupphapūjāya ",
  "tha-ap460:4.4": "vāhasā sabbadassino. // // ",
  "tha-ap460:5.1": "Ayaṃ pacchimako mayhaṃ ",
  "tha-ap460:5.2": "carimo vattate bhavo / ",
  "tha-ap460:5.3": "ajjāpi pupphavasso me ",
  "tha-ap460:5.4": "abhivassati sabbadā. // // ",
  "tha-ap460:6.1": "Satasahasse ito kappe ",
  "tha-ap460:6.2": "yaṃ puppham abhiropayiṃ / ",
  "tha-ap460:6.3": "duggatiṃ nābhijānāmi ",
  "tha-ap460:6.4": "dehapūjāy' idaṃ phalaṃ. // // ",
  "tha-ap460:7.1": "Kilesā . . . ",
  "tha-ap460:7.2": "pe . . . ",
  "tha-ap460:7.3": "",
  "tha-ap460:8.1": "",
  "tha-ap460:8.2": "pe . . . ",
  "tha-ap460:8.3": "pe . . . // // Sāgataṃ . . . pe . . . pe . . . pe . . . // // ",
  "tha-ap460:9.1": "Paṭisambhidā . . . ",
  "tha-ap460:9.2": "pe . . . ",
  "tha-ap460:9.3": "pe . . . pe . . . // // ",
  "tha-ap460:10.1": "Itthaṃ sudaṃ āyasmā Jātipupphiyo thero i. g. a-ti. Jātipupphiyattherassa ",
  "tha-ap460:11.1": "apadānaṃ samattaṃ. "
}
