  "tha-ap91:0.3": "",
  "tha-ap91:1.1": "Vipassissa bhagavato ",
  "tha-ap91:1.2": "mahābodhimaho ahū / ",
  "tha-ap91:1.3": "pabbajj' upagato santo ",
  "tha-ap91:1.4": "upagacchiṃ mahaṃ ahaṃ. // // ",
  "tha-ap91:2.1": "Kusumodakaṃ ādāya ",
  "tha-ap91:2.2": "bodhiyā okirim ahaṃ / ",
  "tha-ap91:2.3": "*mocayissati no mu*tto ",
  "tha-ap91:2.4": "nibbāpessati nibbuto. // // ",
  "tha-ap91:3.1": "Ekanavut' ito kappe ",
  "tha-ap91:3.2": "yaṃ bodhim abhisiñc' ahaṃ / ",
  "tha-ap91:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap91:3.4": "bodhisaññāy' idaṃ phalaṃ. // // ",
  "tha-ap91:4.1": "Tettiṃse vattamānamhi ",
  "tha-ap91:4.2": "kappe āsuṃ janādhipa / ",
  "tha-ap91:4.3": "Udakāsecanā nāma ",
  "tha-ap91:4.4": "aṭṭh' ete cakkavattino. // // ",
  "tha-ap91:5.1": "Paṭisambhidā catasso ",
  "tha-ap91:5.2": "vimokhā pi ca aṭṭh' ime / chaḍābhiññā sacchikatā ",
  "tha-ap91:5.3": "kataṃ Buddhassa sāsanan ti. // // ",
  "tha-ap91:6.1": "Itthaṃ sudaṃ āyasmā Bodhisaññakothero imā gāthāyo abhāsitthā ti. ",
  "tha-ap91:7.1": "Bodhisaññakatherassa apadānaṃ samattaṃ. "
}
