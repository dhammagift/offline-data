  "tha-ap321:1.1": "Sindhuyā nadiyā tīre ",
  "tha-ap321:1.2": "ahosiṃ kassako tadā / ",
  "tha-ap321:1.3": "parakammāyane yutto ",
  "tha-ap321:1.4": "parabhattaṃ apassito. // // ",
  "tha-ap321:2.1": "Sindhum anucaranto 'haṃ ",
  "tha-ap321:2.2": "Siddhatthaṃ jinam addasaṃ / ",
  "tha-ap321:2.3": "samādhinā nisinnaṃ va ",
  "tha-ap321:2.4": "satapattaṃ va pupphitaṃ. // // ",
  "tha-ap321:3.1": "Sattakadalipupphāni ",
  "tha-ap321:3.2": "vaṇṭe chetvān' ahan tadā / ",
  "tha-ap321:3.3": "matthake abhiropesiṃ ",
  "tha-ap321:3.4": "Buddha*ssādiccabandhu*no. // // ",
  "tha-ap321:4.1": "Suvaṇṇavaṇṇaṃ sambuddham ",
  "tha-ap321:4.2": "anukūle samāhitaṃ / ",
  "tha-ap321:4.3": "tidhappabhinnaṃ mātaṅgaṃkuñjaraṃ ",
  "tha-ap321:4.4": "va durāsadaṃ // // ",
  "tha-ap321:5.1": "Tam aham upagantvāna ",
  "tha-ap321:5.2": "nipakaṃ bhāvitindriyaṃ / ",
  "tha-ap321:5.3": "añjaliṃ paggahetvāna ",
  "tha-ap321:5.4": "avandiṃ satthuno ahaṃ. // // ",
  "tha-ap321:6.1": "Catunavute ito kappe ",
  "tha-ap321:6.2": "yaṃ puppham abhipūjayiṃ / ",
  "tha-ap321:6.3": "duggatiṃ nābhijānāmi ",
  "tha-ap321:6.4": "Buddhapūjāy' idaṃ phalaṃ. // // ",
  "tha-ap321:7.1": "Paṭisambhidā . . . ",
  "tha-ap321:7.2": "pe . . . ",
  "tha-ap321:7.3": "pe . . . // // ",
  "tha-ap321:8.1": "Itthaṃ sudam āyasmā Kandalīpupphiyo thero i. g. a-ti. Kandalīpupphiyattherassa apadānaṃ samattaṃ. ",
  "tha-ap321:9.1": ""
}
