  "tha-ap178:1.1": "*Anomadassī bhagavā ",
  "tha-ap178:1.2": "dvipa*dindo narāsabho / ",
  "tha-ap178:1.3": "diṭṭhadhammasukhatthāya ",
  "tha-ap178:1.4": "ambhokāsamhi caṅkami. // // ",
  "tha-ap178:2.1": "Uddhate pāde pupphāni ",
  "tha-ap178:2.2": "lāsaṃ muddhani tiṭṭhare / ",
  "tha-ap178:2.3": "pasannacitto sumano ",
  "tha-ap178:2.4": "vanditvā puppham okiriṃ. // // Vīsaṃ ",
  "tha-ap178:3.1": "kappa*sahassamhi ",
  "tha-ap178:3.2": "ito pañ*ca janā ahuṃ / ",
  "tha-ap178:3.3": "Pupphachadaniyā nāma ",
  "tha-ap178:3.4": "cakkavattī mahabbalā. // // ",
  "tha-ap178:4.1": "Paṭisambhidā . . . ",
  "tha-ap178:4.2": "pe . . . ",
  "tha-ap178:4.3": "pe . . . // // ",
  "tha-ap178:5.1": "Itthaṃ sudaṃ āyasmā Maggadattiko thero i. g. a-ti. Maggadattikattherassa ",
  "tha-ap178:6.1": "apadānaṃ samattaṃ. "
}
