  "tha-ap351:1.1": "jotantaṃ ",
  "tha-ap351:1.2": "nisinnaṃ pabbatantare / ",
  "tha-ap351:1.3": "addasaṃ *virajaṃ Buddham ",
  "tha-ap351:1.4": "oghatiṇ*ṇam anāsavaṃ. // // ",
  "tha-ap351:2.1": "Tiṇḍukaṃ saphalaṃ disvā ",
  "tha-ap351:2.2": "bhinditvāna sakoṭakaṃ / ",
  "tha-ap351:2.3": "pasannacitto sumano ",
  "tha-ap351:2.4": "Vessabhussa adās' ahaṃ. // // Ekanavute ",
  "tha-ap351:3.1": "ito kappe ",
  "tha-ap351:3.2": "yaṃ phalam adadiṃ tadā / ",
  "tha-ap351:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap351:3.4": "phaladānass' idaṃ phalaṃ. // // ",
  "tha-ap351:4.1": "Paṭisambhidā . . . ",
  "tha-ap351:4.2": "pe . . . ",
  "tha-ap351:4.3": "pe . . . // // ",
  "tha-ap351:5.1": "Itthaṃ sudam āyasmā Tiṇḍukaphaladāyako th. i. g. a-ti. Tiṇḍukaphaladāyakattherassa ",
  "tha-ap351:6.1": "apadānaṃ samattaṃ. "
}
