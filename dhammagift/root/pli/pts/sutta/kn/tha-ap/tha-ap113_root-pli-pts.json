  "tha-ap113:0.1": "",
  "tha-ap113:0.2": "",
  "tha-ap113:0.3": "",
  "tha-ap113:1.1": "Vipassī nāma bhagavā ",
  "tha-ap113:1.2": "lokajeṭṭho narāsabho / ",
  "tha-ap113:1.3": "aṭṭhasaṭṭhisahassehi ",
  "tha-ap113:1.4": "pāvisi Bandhumaṃ tadā. // // ",
  "tha-ap113:2.1": "Nagarā abhinikkhamma ",
  "tha-ap113:2.2": "agamaṃ dīpacetiyaṃ / ",
  "tha-ap113:2.3": "addasaṃ virajaṃ Buddhaṃ ",
  "tha-ap113:2.4": "āhutīnaṃ paṭiggahaṃ. // // ",
  "tha-ap113:3.1": "Cullāsītisahassāni ",
  "tha-ap113:3.2": "yakkhā mayhaṃ upantike / ",
  "tha-ap113:3.3": "upaṭṭhahanti sakkaccaṃ ",
  "tha-ap113:3.4": "Indaṃ va Tidasāgaṇā. // // ",
  "tha-ap113:4.1": "Bhavanā abhinikkhamma ",
  "tha-ap113:4.2": "dussaṃ paggayh' ahaṃ tadā / ",
  "tha-ap113:4.3": "sīrasā abhivādesiṃ ",
  "tha-ap113:4.4": "tañ cādāsi mahesino: // // ",
  "tha-ap113:5.1": "‘Aho Buddhā aho dhammā ",
  "tha-ap113:5.2": "aho no satthu sampadā / ",
  "tha-ap113:5.3": "Buddhassa ānubhāvena ",
  "tha-ap113:5.4": "vasudhā 'yam pakampatha.' // // ",
  "tha-ap113:6.1": "Tañ ca acchariyaṃ disvā ",
  "tha-ap113:6.2": "abbhutaṃ lomahaṃsanaṃ / ",
  "tha-ap113:6.3": "Buddhe cittaṃ pasādesiṃ ",
  "tha-ap113:6.4": "dipadindamhi tādine. // // ",
  "tha-ap113:7.1": "So 'haṃ cittaṃ pasādetvā ",
  "tha-ap113:7.2": "dussaṃ datvāna satthuno / ",
  "tha-ap113:7.3": "saraṇañ ca upāgañchiṃ ",
  "tha-ap113:7.4": "sāmacco saparijjano. // // ",
  "tha-ap113:8.1": "Ekanavute ito kappe ",
  "tha-ap113:8.2": "yaṃ kammam akariṃ tadā / ",
  "tha-ap113:8.3": "duggatiṃ nābhijānāmi ",
  "tha-ap113:8.4": "Buddhapūjāy' idaṃ phalaṃ. // // ",
  "tha-ap113:9.1": "Ito paṇṇarase kappe ",
  "tha-ap113:9.2": "soḷas' āsiṃsu Vāhanā / ",
  "tha-ap113:9.3": "sattaratanasampannā ",
  "tha-ap113:9.4": "cakkavattī mahābalā // // ",
  "tha-ap113:10.1": "Paṭisambhidā catasso ",
  "tha-ap113:10.2": "vimokhā pi ca aṭṭh' ime / ",
  "tha-ap113:10.3": "chaḍabhiññā sacchikatā ",
  "tha-ap113:10.4": "kataṃ Buddhassa sāsanan ti. // // ",
  "tha-ap113:11.1": "Itthaṃ sudaṃ āyasmā Mahāparivāro thero imā gāthāyo abhāsitthā ti. ",
  "tha-ap113:12.1": "Mahāparivāratherassa apadānaṃ samattaṃ. "
}
