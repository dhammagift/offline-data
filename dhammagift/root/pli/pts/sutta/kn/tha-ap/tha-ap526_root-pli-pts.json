  "tha-ap526:1.1": "Nāgare Bandhumatiyā ",
  "tha-ap526:1.2": "rājuyyāne vasām' ahaṃ / ",
  "tha-ap526:1.3": "dhammavādī tadā āsiṃ ",
  "tha-ap526:1.4": "kamaṇḍaludharo ahaṃ. // // ",
  "tha-ap526:2.1": "Addasaṃ virajaṃ Buddhaṃ ",
  "tha-ap526:2.2": "sayambhuṃ aparājitaṃ / ",
  "tha-ap526:2.3": "padhānapahitattan taṃ ",
  "tha-ap526:2.4": "jhāyiṃ jhānarataṃ vasiṃ. // // ",
  "tha-ap526:3.1": "Sabbakāmasamiddhiñ ca ",
  "tha-ap526:3.2": "oghatiṇṇam anāsavaṃ / ",
  "tha-ap526:3.3": "disvā pasanno sumano ",
  "tha-ap526:3.4": "abbhañjanam adās ahaṃ // // Ekanavute ",
  "tha-ap526:4.1": "ito kappe ",
  "tha-ap526:4.2": "yam abbhañjanam adās ahaṃ / ",
  "tha-ap526:4.3": "duggatiṃ nābhijānāmi ",
  "tha-ap526:4.4": "abbhañjanass' idaṃ phalaṃ. // // ",
  "tha-ap526:5.1": "Kilesā . . . ",
  "tha-ap526:5.2": "pe . . . ",
  "tha-ap526:5.3": "",
  "tha-ap526:6.1": "",
  "tha-ap526:6.2": "pe . . . ",
  "tha-ap526:6.3": "pe . . . // // Sāgataṃ . . . pe . . . pe . . . pe . . . // // ",
  "tha-ap526:7.1": "Paṭisambhidā . . . ",
  "tha-ap526:7.2": "pe . . . ",
  "tha-ap526:7.3": "pe . . . pe . . . // // ",
  "tha-ap526:8.1": "Itthaṃ sudaṃ āyasmā Abbhañjanadāyako thero i. g. a-ti. Abbhañjanadāyakattherassa ",
  "tha-ap526:9.1": "apadānaṃ samattaṃ. "
}
