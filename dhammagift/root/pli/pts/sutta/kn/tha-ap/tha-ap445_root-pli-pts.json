  "tha-ap445:1.1": "Candabhāgānadītīre ",
  "tha-ap445:1.2": "assamo sukato mama / ",
  "tha-ap445:1.3": "belurukkhehi ākiṇṇo ",
  "tha-ap445:1.4": "nānādumanisevito. // // ",
  "tha-ap445:2.1": "Sugandham beluvaṃ disvā ",
  "tha-ap445:2.2": "Buddhaseṭṭham anussariṃ / ",
  "tha-ap445:2.3": "khāribhāraṃ pūrayitvā ",
  "tha-ap445:2.4": "tuṭṭho saṃviggamānaso // // ",
  "tha-ap445:3.1": "Kakusandham upāgamma ",
  "tha-ap445:3.2": "billapakkam adās' ahaṃ / ",
  "tha-ap445:3.3": "puññakkhettassa vīrassa ",
  "tha-ap445:3.4": "vippasannena cetasā. // // ",
  "tha-ap445:4.1": "Imasmiṃ yeva kappasmiṃ ",
  "tha-ap445:4.2": "yaṃ phalam adadiṃ tadā / ",
  "tha-ap445:4.3": "duggatiṃ nābhijānāmi ",
  "tha-ap445:4.4": "phaladānass' idaṃ phalaṃ. // // ",
  "tha-ap445:5.1": "Kilesā . . . ",
  "tha-ap445:5.2": "pe . . . ",
  "tha-ap445:5.3": "",
  "tha-ap445:6.1": "",
  "tha-ap445:6.2": "pe . . . ",
  "tha-ap445:6.3": "pe . . . // // Sāgataṃ . . . pe . . . pe . . . pe . . . // // ",
  "tha-ap445:7.1": "Paṭisambhidā . . . ",
  "tha-ap445:7.2": "pe . . . ",
  "tha-ap445:7.3": "pe . . . pe . . . // // ",
  "tha-ap445:8.1": "Itthaṃ sudam āyasmā Billaphaliyo thero i. g. a-ti. Billaphaliyattherassa apadānaṃ samattaṃ. ",
  "tha-ap445:9.1": ""
}
