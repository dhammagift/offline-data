  "tha-ap372:0.3": "",
  "tha-ap372:1.1": "Candabhāgānadītīre ",
  "tha-ap372:1.2": "ahosiṃ kinnaro tadā / ",
  "tha-ap372:1.3": "ath' addasaṃ devadevaṃ ",
  "tha-ap372:1.4": "caṅkamantaṃ narāsabhaṃ. // // ",
  "tha-ap372:2.1": "Ocinitvāna salaḷaṃ ",
  "tha-ap372:2.2": "pupphaṃ Buddhass' adās' ahaṃ / ",
  "tha-ap372:2.3": "upasiṅghi mahāvīro ",
  "tha-ap372:2.4": "salaḷaṃ devagandhikaṃ. // // ",
  "tha-ap372:3.1": "Paṭiggahetvā sambuddho ",
  "tha-ap372:3.2": "Vipassī lokanāyako / ",
  "tha-ap372:3.3": "upasiṅghi mahāvīro ",
  "tha-ap372:3.4": "pekkhamānassa me sadā. // // ",
  "tha-ap372:4.1": "Pasannacitto sumano ",
  "tha-ap372:4.2": "vanditvā dipaduttamaṃ / ",
  "tha-ap372:4.3": "añjalim paggahetvāna ",
  "tha-ap372:4.4": "puna pabbatam āruhiṃ. // // Ekanavute ",
  "tha-ap372:5.1": "ito kappe ",
  "tha-ap372:5.2": "yaṃ puppham abhipūjayiṃ / ",
  "tha-ap372:5.3": "duggatiṃ nābhijānāmi ",
  "tha-ap372:5.4": "Buddhapūjāy' idaṃ phalaṃ. // // ",
  "tha-ap372:6.1": "Paṭisambhidā . . . ",
  "tha-ap372:6.2": "pe . . . ",
  "tha-ap372:6.3": "pe . . . // // ",
  "tha-ap372:7.1": "Itthaṃ sudam āyasā Salaḷapupphiyo thero i. g. a- ",
  "tha-ap372:8.1": "ti. Salaḷapupphiyattherassa ",
  "tha-ap372:9.1": "apadānaṃ samattaṃ. ",
  "tha-ap372:10.1": "Uddānaṃ: ",
  "tha-ap372:11.1": "Mandāravañ ca Kekkhāru ",
  "tha-ap372:11.2": "Bhisa-Kesarapupphiyo ",
  "tha-ap372:11.3": "Aṅkolako Kadambī ca ",
  "tha-ap372:11.4": "Uddālī Ekacampako ",
  "tha-ap372:11.5": "Timiraṃ Salaḷañ c' eva ",
  "tha-ap372:11.6": "gāthā tālīsam eva ca. Mandārapupphiyavaggo sattatiṃso. "
}
