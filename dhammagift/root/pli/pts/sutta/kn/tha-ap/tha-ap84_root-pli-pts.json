  "tha-ap84:0.1": "",
  "tha-ap84:0.2": "",
  "tha-ap84:0.3": "",
  "tha-ap84:1.1": "Jātiyā sattavasso 'haṃ ",
  "tha-ap84:1.2": "pabbajiṃ anagāriyaṃ / ",
  "tha-ap84:1.3": "avandiṃ satthuno pāde ",
  "tha-ap84:1.4": "vippasannena cetasā. // // ",
  "tha-ap84:2.1": "Satta naṅgaliki pupphe ",
  "tha-ap84:2.2": "ākāse ukkhipiṃ ahaṃ / ",
  "tha-ap84:2.3": "Tissaṃ Buddhaṃ samuddissa ",
  "tha-ap84:2.4": "anantaguṇasāgaraṃ. // // ",
  "tha-ap84:3.1": "Sugatānugataṃ maggaṃ ",
  "tha-ap84:3.2": "pūjetvā haṭṭhamānaso / ",
  "tha-ap84:3.3": "añjaliṃ va tad' ākāsiṃ ",
  "tha-ap84:3.4": "pasanno sehi pāṇihi. // // ",
  "tha-ap84:4.1": "Dvenavute ito kappe ",
  "tha-ap84:4.2": "yaṃ kammam akariṃ tadā / ",
  "tha-ap84:4.3": "duggatiṃ nābhijānāmi ",
  "tha-ap84:4.4": "Buddhapūjāy' idaṃ phalaṃ. // // ",
  "tha-ap84:5.1": "Ito aṭṭhamake kappe ",
  "tha-ap84:5.2": "tayo Aggisikhā ahuṃ / ",
  "tha-ap84:5.3": "sattaratanasampannā ",
  "tha-ap84:5.4": "cakkavattī mahābalā. // // ",
  "tha-ap84:6.1": "Paṭisambhidā catasso ",
  "tha-ap84:6.2": "vimokhā pi ca aṭṭh' ime / chaḍabhiññā sacchikatā ",
  "tha-ap84:6.3": "kataṃ Buddhassa sāsanan ti. // // ",
  "tha-ap84:7.1": "Itthaṃ sudaṃ āyasmā Gatasaññako thero imā gāthāyo abhāsitthāti. Gatasaññakattherassa apadānaṃ samattaṃ. ",
  "tha-ap84:8.1": ""
}
