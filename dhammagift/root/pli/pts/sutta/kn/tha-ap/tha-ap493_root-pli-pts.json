  "tha-ap493:1.1": "",
  "tha-ap493:1.2": "nisinnaṃ pabbatantare / ",
  "tha-ap493:1.3": "addasaṃ virajaṃ Buddhaṃ ",
  "tha-ap493:1.4": "Vipassim lokanāyakaṃ. // // ",
  "tha-ap493:2.1": "Tīṇi kiṅkhanipupphāni ",
  "tha-ap493:2.2": "paggayha abhiropayiṃ / ",
  "tha-ap493:2.3": "sambuddhaṃ abhipūjitvā ",
  "tha-ap493:2.4": "gacchāmi dakkhiṇāmukho. // // ",
  "tha-ap493:3.1": "Tena kammena sukatena ",
  "tha-ap493:3.2": "cetanāpaṇidhīhi ca / ",
  "tha-ap493:3.3": "jahitvā manusaṃ dehaṃ ",
  "tha-ap493:3.4": "Tāvatiṃsaṃ agacch' ahaṃ. // // Ekanavute ",
  "tha-ap493:4.1": "ito kappe ",
  "tha-ap493:4.2": "yaṃ Buddham abhipūjayiṃ / ",
  "tha-ap493:4.3": "duggatiṃ nābhijānāmi ",
  "tha-ap493:4.4": "Buddhapūjāy' idaṃ phalaṃ. // // ",
  "tha-ap493:5.1": "Kilesā . . . pe . . . ",
  "tha-ap493:5.2": "pe . . . ",
  "tha-ap493:5.3": "pe . . . // // ",
  "tha-ap493:5.4": "Sāgataṃ . . . ",
  "tha-ap493:6.1": "pe . . . ",
  "tha-ap493:6.2": "pe . . . ",
  "tha-ap493:6.3": "pe . . . // // ",
  "tha-ap493:6.4": "",
  "tha-ap493:7.1": "Paṭisambhidā . . . pe . . . ",
  "tha-ap493:7.2": "pe . . . ",
  "tha-ap493:7.3": "",
  "tha-ap493:7.4": "pe . . . // // ",
  "tha-ap493:8.1": "Itthaṃ sudaṃ āyasmā Tīṇikiṅkhanipupphiyo th. i. g. a-ti. Tīṇikiṅkhanipupphiyattherassa apadānaṃ samattaṃ. ",
  "tha-ap493:9.1": "Himavantass' avidūre Udako "
