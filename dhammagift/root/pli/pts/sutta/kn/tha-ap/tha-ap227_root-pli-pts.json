  "tha-ap227:0.2": "",
  "tha-ap227:0.3": "",
  "tha-ap227:1.1": "Vipassissa bhagavato ",
  "tha-ap227:1.2": "aggisālam adās' ahaṃ / vyādhitānaṃ ",
  "tha-ap227:1.3": "ca āvāsam ",
  "tha-ap227:1.4": "uṇhodakapaṭiggahaṃ. // // ",
  "tha-ap227:2.1": "Tena kammena yaṃ mayham ",
  "tha-ap227:2.2": "attabhāvo sunimmito / ",
  "tha-ap227:2.3": "vyādhāhaṃ nābhijānāmi ",
  "tha-ap227:2.4": "puññakammass' idaṃ phalaṃ. // // ",
  "tha-ap227:3.1": "Ekanavute ito kappe ",
  "tha-ap227:3.2": "yaṃ sālam adadim ahaṃ / ",
  "tha-ap227:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap227:3.4": "aggisālāy' idaṃ phalaṃ. // // ",
  "tha-ap227:4.1": "Ito sattamake kappe ",
  "tha-ap227:4.2": "eko 'si Aparājito / ",
  "tha-ap227:4.3": "sattaratanasampanno ",
  "tha-ap227:4.4": "cakkavattī mahabbalo. // // ",
  "tha-ap227:5.1": "Paṭisambhidā . . . ",
  "tha-ap227:5.2": "pe . . . ",
  "tha-ap227:5.3": "pe . . . // // ",
  "tha-ap227:6.1": "Itthaṃ sudam āyasmā Avyādhiko thero i. g. a-ti. Avyādhikattherassa ",
  "tha-ap227:7.1": "apadānaṃ samattaṃ. "
}
