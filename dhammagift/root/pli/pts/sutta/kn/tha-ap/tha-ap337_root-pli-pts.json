  "tha-ap337:0.3": "",
  "tha-ap337:1.1": "Vipassī nāma sambuddho ",
  "tha-ap337:1.2": "lokajeṭṭho narāsabho / ",
  "tha-ap337:1.3": "khīṇāsavehi sahito ",
  "tha-ap337:1.4": "saṅghārāme vasī tadā. // // ",
  "tha-ap337:2.1": "Ārāmadvārā nikkhamma ",
  "tha-ap337:2.2": "Vipassī lokanāyako / ",
  "tha-ap337:2.3": "sahasatasahassehi ",
  "tha-ap337:2.4": "aṭṭha khīṇāsavehi tu. // // ",
  "tha-ap337:3.1": "Ajinena* nivattho 'haṃ ",
  "tha-ap337:3.2": "vāka*ciradharo pi ca / ",
  "tha-ap337:3.3": "kusumbhodakam ādāya ",
  "tha-ap337:3.4": "sambuddham upasaṅkamiṃ. // // ",
  "tha-ap337:4.1": "Sakaṃ cittaṃ pasādetvā ",
  "tha-ap337:4.2": "vedajāto katañjali / ",
  "tha-ap337:4.3": "kusumbhodakam ādāya ",
  "tha-ap337:4.4": "Buddham abbhukkirim ahaṃ // // ",
  "tha-ap337:5.1": "Tena kammena sambuddho ",
  "tha-ap337:5.2": "jalajuttamanāmako / ",
  "tha-ap337:5.3": "mama kammaṃ pakittetvā ",
  "tha-ap337:5.4": "*agamā ye*na patthitaṃ. // // ",
  "tha-ap337:6.1": "Phussitā pañcasahassā ",
  "tha-ap337:6.2": "yehi pūjes' ahaṃ jinaṃ / ",
  "tha-ap337:6.3": "aḍḍhateyyasahassehi ",
  "tha-ap337:6.4": "devarajjam akārayiṃ. // // ",
  "tha-ap337:7.1": "Aḍḍhateyyasahassehi ",
  "tha-ap337:7.2": "cakkavattī ahos' ahaṃ / ",
  "tha-ap337:7.3": "avasesena kammena ",
  "tha-ap337:7.4": "arahattam apāpuṇiṃ. // // ",
  "tha-ap337:8.1": "Devarājā yadā homi ",
  "tha-ap337:8.2": "manujādhipati yathā / tam ",
  "tha-ap337:8.3": "yeva nāmadheyyam me ",
  "tha-ap337:8.4": "Phussito nāma hom' ahaṃ. // // ",
  "tha-ap337:9.1": "Devabhūtassa santassa ",
  "tha-ap337:9.2": "athāpi mānusassa vā / ",
  "tha-ap337:9.3": "samantāvyāmato mayhaṃ ",
  "tha-ap337:9.4": "phussitaṃ va pavassati // // ",
  "tha-ap337:10.1": "Bhavā ugghāṭitā mayhaṃ ",
  "tha-ap337:10.2": "kilesā jhāpitā mama / ",
  "tha-ap337:10.3": "sabbāsave parikkhīṇo ",
  "tha-ap337:10.4": "phussitassa idaṃ phalaṃ. // // ",
  "tha-ap337:11.1": "Candanass' eva me vasso ",
  "tha-ap337:11.2": "tathā gandho pavāyati / ",
  "tha-ap337:11.3": "sārīriko mamaṃ gandho ",
  "tha-ap337:11.4": "aḍḍhakose pavāyati. // // ",
  "tha-ap337:12.1": "Dibbagandhaṃ sampavantaṃ ",
  "tha-ap337:12.2": "puññakammasamaṅginaṃ / ",
  "tha-ap337:12.3": "gandhaṃ ghatvāna jānanti ",
  "tha-ap337:12.4": "Phussito āgato idha. // // ",
  "tha-ap337:13.1": "Sākhā phalā sakaṭṭhāni ",
  "tha-ap337:13.2": "tiṇāni pi va sabbaso / ",
  "tha-ap337:13.3": "mama saṅkappam aññāya ",
  "tha-ap337:13.4": "gandho sampajjate khaṇe. // // ",
  "tha-ap337:14.1": "Satasahasse ito kappe ",
  "tha-ap337:14.2": "candanam abhipūjayiṃ / ",
  "tha-ap337:14.3": "duggatiṃ nābhijānāmi ",
  "tha-ap337:14.4": "phussitassa idaṃ phalaṃ. // // ",
  "tha-ap337:15.1": "Paṭisambhidā . . . ",
  "tha-ap337:15.2": "pe . . . ",
  "tha-ap337:15.3": "pe . . . // // ",
  "tha-ap337:16.1": "Itthaṃ sudam āyasmā Phussitakammiyo th. i. g. a-ti. Phussitakammiyattherassa apadānaṃ ",
  "tha-ap337:17.1": "samattaṃ. Padumuttarassa bhagavato "
}
