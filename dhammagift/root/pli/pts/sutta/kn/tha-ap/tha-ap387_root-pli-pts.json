  "tha-ap387:1.1": "Suvaṇṇavaṇṇaṃ sambuddham ",
  "tha-ap387:1.2": "āhutīnaṃ paṭiggahaṃ / ",
  "tha-ap387:1.3": "rathiyaṃ paṭipajjantaṃ ",
  "tha-ap387:1.4": "phārusaphalam adās' ahaṃ. // // ",
  "tha-ap387:2.1": "Ekanavut' ito kappe ",
  "tha-ap387:2.2": "yaṃ phalam adadam ahaṃ / ",
  "tha-ap387:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap387:2.4": "phaladānass' idaṃ phalaṃ. // // ",
  "tha-ap387:3.1": "Sāgataṃ . . . pe . . . pe . . . // // Kilesā . . . ",
  "tha-ap387:3.2": "pe . . . ",
  "tha-ap387:3.3": "",
  "tha-ap387:4.1": "",
  "tha-ap387:4.2": "pe . . . // // ",
  "tha-ap387:4.3": "",
  "tha-ap387:5.1": "Paṭisambhidā . . . ",
  "tha-ap387:5.2": "pe . . . ",
  "tha-ap387:5.3": "pe . . . // // ",
  "tha-ap387:6.1": "Itthaṃ sudam āyasmā Phārusaphaladāyako th. i. g. a-ti. Phārusaphaladāyakattherassa apadānaṃ samattaṃ. ",
  "tha-ap387:7.1": ""
}
