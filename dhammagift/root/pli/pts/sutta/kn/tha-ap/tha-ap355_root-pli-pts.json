  "tha-ap355:1.1": "Kiṃsukaṃ pupphitaṃ disvā ",
  "tha-ap355:1.2": "paggahetvāna añjaliṃ / ",
  "tha-ap355:1.3": "Buddhaṃ saritvā Siddhattham ",
  "tha-ap355:1.4": "ākāse abhipūjayiṃ. // // ",
  "tha-ap355:2.1": "Catunavute ito kappe ",
  "tha-ap355:2.2": "yaṃ puppham abhipūjayiṃ / ",
  "tha-ap355:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap355:2.4": "Buddhapūjāy' idaṃ phalaṃ. // // ",
  "tha-ap355:3.1": "Paṭisambidā . . . ",
  "tha-ap355:3.2": "pe . . . ",
  "tha-ap355:3.3": "pe . . . // // ",
  "tha-ap355:4.1": "Itthaṃ sudam āyasmā Kiṃsukapūjako thero i. g. a-ti. Kiṃsukapūjakattherassa apadānaṃ ",
  "tha-ap355:5.1": "samattaṃ. Akkantañ ca "
}
