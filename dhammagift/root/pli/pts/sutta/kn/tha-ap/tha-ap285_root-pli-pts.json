  "tha-ap285:1.1": "Sīhaṃ yathā vanacaraṃ ",
  "tha-ap285:1.2": "nisabhājāniyaṃ yathā / ",
  "tha-ap285:1.3": "kakudhaṃ vilasantaṃ va ",
  "tha-ap285:1.4": "agacchantaṃ narāsabhaṃ // // ",
  "tha-ap285:2.1": "Siddhatthaṃ lokapajjotaṃ ",
  "tha-ap285:2.2": "sabbalokatikicchakaṃ / ",
  "tha-ap285:2.3": "akāsiṃ paccuggamanaṃ ",
  "tha-ap285:2.4": "vippasannena cetasā. // // ",
  "tha-ap285:3.1": "Catunavute ito kappe ",
  "tha-ap285:3.2": "paccuggacchiṃ narāsabhaṃ / ",
  "tha-ap285:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap285:3.4": "paccuggaman' idaṃ phalaṃ. // // ",
  "tha-ap285:4.1": "Sattavīse ito kappe ",
  "tha-ap285:4.2": "eko āsi janādhipo / ",
  "tha-ap285:4.3": "Saparivāro ti nāmena ",
  "tha-ap285:4.4": "cakkavattī mahabbalo. // // ",
  "tha-ap285:5.1": "Paṭisambhidā . . . ",
  "tha-ap285:5.2": "pe . . . ",
  "tha-ap285:5.3": "pe . . . // // ",
  "tha-ap285:6.1": "Itthaṃ sudam āyasmā Paccuggamaniyo thero i. g. a-ti. Paccuggamaniyattherassa apadānaṃ samattaṃ. ",
  "tha-ap285:7.1": ""
}
