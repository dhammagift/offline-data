  "tha-ap21:0.1": "",
  "tha-ap21:0.2": "",
  "tha-ap21:0.3": "",
  "tha-ap21:1.1": "sodhayantassa ",
  "tha-ap21:1.2": "pavare pabbatuttame / ",
  "tha-ap21:1.3": "Siddhattho nāma bhagavā ",
  "tha-ap21:1.4": "āgacchi mama santikaṃ. // // ",
  "tha-ap21:2.1": "Buddhaṃ upagataṃ disvā ",
  "tha-ap21:2.2": "*lokajeṭṭhassa tādino / ",
  "tha-ap21:2.3": "santharaṃ paññāpet*vāna ",
  "tha-ap21:2.4": "pupphāsanam adās' ahaṃ. // // ",
  "tha-ap21:3.1": "Pupphāsane nisīditvā ",
  "tha-ap21:3.2": "Siddhattho lokanāyako / ",
  "tha-ap21:3.3": "mamañ ca gatim aññāya aniccattam ",
  "tha-ap21:3.4": "udāhari: // // ",
  "tha-ap21:4.1": "\"Aniccā vata saṅkhārā ",
  "tha-ap21:4.2": "uppādavayadhammino / ",
  "tha-ap21:4.3": "uppajjitvā nirujjhanti; ",
  "tha-ap21:4.4": "tesaṃ vūpasamo sukho\". // // ",
  "tha-ap21:5.1": "*Idaṃ vatvāna sa*bbaññū ",
  "tha-ap21:5.2": "lokajeṭṭho narāsabho / ",
  "tha-ap21:5.3": "nabham abbhuggamī vīro ",
  "tha-ap21:5.4": "haṃsarājā va ambare. // // ",
  "tha-ap21:6.1": "Sakaṃ diṭṭhiṃ jahitvāna ",
  "tha-ap21:6.2": "bhāvayāniccasaññ' ahaṃ / ",
  "tha-ap21:6.3": "ekāhaṃ bhāvayitvāna ",
  "tha-ap21:6.4": "tattha kālakato ahaṃ. // // ",
  "tha-ap21:7.1": "Dvesampattī anubhotvā ",
  "tha-ap21:7.2": "sukkamūlena codito / ",
  "tha-ap21:7.3": "*pacchime bhave* sampatte ",
  "tha-ap21:7.4": "sapākaṃ yonupāgamiṃ. // // ",
  "tha-ap21:8.1": "Agārā abhinikkhamma ",
  "tha-ap21:8.2": "pabbajiṃ anagāriyaṃ / ",
  "tha-ap21:8.3": "jātiyā sattavasso 'haṃ ",
  "tha-ap21:8.4": "arahattaṃ apāpuṇiṃ. // // ",
  "tha-ap21:9.1": "Āraddhaviriyo pahitatto ",
  "tha-ap21:9.2": "sīlesu susamāhito / ",
  "tha-ap21:9.3": "*tosetvāna mahā*nāgaṃ ",
  "tha-ap21:9.4": "alatthaṃ upasampadaṃ. // // ",
  "tha-ap21:10.1": "Catunavut' ito kappe ",
  "tha-ap21:10.2": "yaṃ kammam akariṃ tadā / ",
  "tha-ap21:10.3": "duggatiṃ nābhijānāmi ",
  "tha-ap21:10.4": "pupphadānass idaṃ phalaṃ. // // ",
  "tha-ap21:11.1": "Catunavut' ito kappe ",
  "tha-ap21:11.2": "yaṃ saññaṃ bhāvayiṃ tadā / ",
  "tha-ap21:11.3": "tam saññaṃ bhāvaya*ntassa ",
  "tha-ap21:11.4": "patto me* āsavakkhayo. // // ",
  "tha-ap21:12.1": "Paṭisambhidā catasso ",
  "tha-ap21:12.2": "vimokhā pi ca aṭṭh' ime / ",
  "tha-ap21:12.3": "chaḍabhiññā sacchikatā ",
  "tha-ap21:12.4": "kataṃ Buddhassa sāsanan ti. // // ",
  "tha-ap21:13.1": "Itthaṃ sudaṃ āyasmā Sopāko thero imā gāthāyo abhāsitthā ti. ",
  "tha-ap21:14.1": "Sopākatherassa apadānaṃ samattaṃ. "
}
