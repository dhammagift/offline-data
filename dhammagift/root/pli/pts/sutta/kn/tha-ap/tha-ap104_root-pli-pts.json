  "tha-ap104:0.1": "",
  "tha-ap104:0.2": "",
  "tha-ap104:0.3": "",
  "tha-ap104:1.1": "Suvaṇṇavaṇṇaṃ sambuddhaṃ ",
  "tha-ap104:1.2": "nisabhājāniyaṃ yathā / ",
  "tha-ap104:1.3": "tidhāppabhinnaṃ mātaṅgaṃ ",
  "tha-ap104:1.4": "kuñjaraṃ va mahesinaṃ // // ",
  "tha-ap104:2.1": "Obhāsentaṃ disā sabbā ",
  "tha-ap104:2.2": "uḷurājaṃ va pūritaṃ / ",
  "tha-ap104:2.3": "rathiyā paṭipajjantaṃ ",
  "tha-ap104:2.4": "lokajeṭṭhaṃ naruttamaṃ. // // ",
  "tha-ap104:3.1": "Ñāṇe cittaṃ pasādetvā ",
  "tha-ap104:3.2": "paggahetvāna añjaliṃ / ",
  "tha-ap104:3.3": "pasannacitto sumano ",
  "tha-ap104:3.4": "Siddhatthaṃ abhivādayiṃ. // // Catunavute ",
  "tha-ap104:4.1": "ito kappe ",
  "tha-ap104:4.2": "yaṃ kammam akariṃ tadā / ",
  "tha-ap104:4.3": "duggatiṃ nābhijānāmi ",
  "tha-ap104:4.4": "ñāṇasaññāy' idaṃ phalaṃ. // // ",
  "tha-ap104:5.1": "Tesattati ito kappe ",
  "tha-ap104:5.2": "soḷasāsuṃ naruttamā / ",
  "tha-ap104:5.3": "sattaratanasampannā ",
  "tha-ap104:5.4": "cakkavattī mahābalā. // // ",
  "tha-ap104:6.1": "Paṭisambhidā catasso ",
  "tha-ap104:6.2": "vimokhā pi ca aṭṭh' ime / chaḍabhiññā sacchikatā ",
  "tha-ap104:6.3": "kataṃ Buddhassa sāsanan ti. // // ",
  "tha-ap104:7.1": "Itthaṃ sudaṃ āyasmā Ñāṇasaññako thero imā gāthāyo abhāsitthāti. Ñāṇasaññakattherassa apadānaṃ samattaṃ. ",
  "tha-ap104:8.1": ""
}
