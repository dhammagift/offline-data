  "tha-ap462:4.3": "pe . . . // // Sāgataṃ . . . pe . . . pe . . . pe . . . // // ",
  "tha-ap462:5.1": "Paṭisambhidā . . . ",
  "tha-ap462:5.2": "pe . . . ",
  "tha-ap462:5.3": "pe . . . pe . . . // // ",
  "tha-ap462:6.1": "Itthaṃ sudam āyasmā Gandhapūjako thero i. g. a- ",
  "tha-ap462:7.1": "ti. Gandhapūjakattherassa ",
  "tha-ap462:8.1": "apadānaṃ samattaṃ. ",
  "tha-ap462:9.1": "Uddānaṃ: ",
  "tha-ap462:10.1": "Jagatī Morahatthī ca ",
  "tha-ap462:10.2": "Āsanī Ukkadhārako ",
  "tha-ap462:10.3": "Akkamī Vanakoraṇḍī ",
  "tha-ap462:10.4": "Chattado Jātipūjako ",
  "tha-ap462:11.1": "Sattipaṇṇī ca yo thero ",
  "tha-ap462:11.2": "dasamo Gandhapūjako ",
  "tha-ap462:11.3": "sattasaṭṭhī ca gāthāyo ",
  "tha-ap462:11.4": "gaṇitāyo vibhāvihi. Jagatidāyakavaggo chacattārīso. "
}
