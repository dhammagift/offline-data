  "tha-ap462:1.3": "pasannacitto sumano ",
  "tha-ap462:1.4": "gandhamuṭṭhim apūjayiṃ. // // Satasahasse ",
  "tha-ap462:2.1": "ito kappe ",
  "tha-ap462:2.2": "citakaṃ yam apūjayiṃ / ",
