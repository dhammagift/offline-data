  "tha-ap62:0.1": "",
  "tha-ap62:0.2": "",
  "tha-ap62:0.3": "",
  "tha-ap62:1.1": "Jātiyā sattavasso 'haṃ ",
  "tha-ap62:1.2": "addasaṃ *lokanā*yakaṃ / ",
  "tha-ap62:1.3": "pasannacitto sumano ",
  "tha-ap62:1.4": "upagañchiṃ naruttamaṃ. // // ",
  "tha-ap62:2.1": "Tissassāhaṃ bhagavato ",
  "tha-ap62:2.2": "lokajeṭṭhassa tādino / ",
  "tha-ap62:2.3": "haṭṭho hatthena cittena ",
  "tha-ap62:2.4": "ropayiṃ bodhim uttamaṃ. // // ",
  "tha-ap62:3.1": "Asa*no nāmadheyyena ",
  "tha-ap62:3.2": "dharaṇīrūhapādapo. / ",
  "tha-ap62:3.3": "pañ*cavasse paricariṃ ",
  "tha-ap62:3.4": "asanaṃ bodhim uttamaṃ. // // ",
  "tha-ap62:4.1": "Pupphitaṃ pādapaṃ disvā ",
  "tha-ap62:4.2": "abbhūtaṃ lomahaṃsanaṃ / ",
  "tha-ap62:4.3": "sakaṃ kammaṃ pakittento ",
  "tha-ap62:4.4": "Buddhaseṭṭhaṃ upāgamiṃ. // // ",
  "tha-ap62:5.1": "Tisso tadā yo sambuddho ",
  "tha-ap62:5.2": "sayambhū *aggapuggalo / ",
  "tha-ap62:5.3": "bhikkhusaṅghe nisīditvā ",
  "tha-ap62:5.4": "imā gāthā* abhāsatha: // // ",
  "tha-ap62:6.1": "‘Yenāyaṃ ropitā bodhi ",
  "tha-ap62:6.2": "Buddhapūjā ca sakkatā / ",
  "tha-ap62:6.3": "tam ahaṃ kittayissāmi; ",
  "tha-ap62:6.4": "suṇotha mama bhāsato: // // ",
  "tha-ap62:7.1": "Tiṃsakappāni devesu ",
  "tha-ap62:7.2": "devarajjaṃ karissati / ",
  "tha-ap62:7.3": "catusaṭṭhiñ ca khattuṃ so ",
  "tha-ap62:7.4": "cakkavatti bhavissati. // // ",
  "tha-ap62:8.1": "Tu*sitāhi cavit*vāna ",
  "tha-ap62:8.2": "sukkamūlena codito / ",
  "tha-ap62:8.3": "dve sampattī anubhotvā ",
  "tha-ap62:8.4": "manussatte ramissati. // // ",
  "tha-ap62:9.1": "Padhānaṃ pahitatto so ",
  "tha-ap62:9.2": "upasanto nirūpadhi / ",
  "tha-ap62:9.3": "sabbāsave pariññāya ",
  "tha-ap62:9.4": "nibbāyissat' anāsavo.' // // ",
  "tha-ap62:10.1": "Vivekam anuyutto 'haṃ ",
  "tha-ap62:10.2": "upasanto nirūpadhi / ",
  "tha-ap62:10.3": "*nāgo* va bandhanaṃ chetvā ",
  "tha-ap62:10.4": "viharāmi anāsavo. // // ",
  "tha-ap62:11.1": "Dvenavute ito kappe ",
  "tha-ap62:11.2": "bodhiṃ ropes ahaṃ tadā / ",
  "tha-ap62:11.3": "duggatiṃ nābhijānāmi ",
  "tha-ap62:11.4": "bodhiropay' idaṃ phalaṃ. // // ",
  "tha-ap62:12.1": "Catusattati ito kappe ",
  "tha-ap62:12.2": "Daṇḍaseno ti vissuto / ",
  "tha-ap62:12.3": "sattaratanasampanno ",
  "tha-ap62:12.4": "cakkavatti tadā ahu. // // Tesattati ",
  "tha-ap62:13.1": "ito kappe ",
  "tha-ap62:13.2": "sattāhesuṃ mahīpatī / ",
  "tha-ap62:13.3": "Samantanemi nāmena ",
  "tha-ap62:13.4": "rājāno cakkavattino. // // ",
  "tha-ap62:14.1": "Paṇṇavīsat' ito kappe ",
  "tha-ap62:14.2": "*Puṇṇa*ko nāma khattiyo / ",
  "tha-ap62:14.3": "sattaratanasampanno ",
  "tha-ap62:14.4": "cakkavatti mahabbalo. // // ",
  "tha-ap62:15.1": "Paṭisambhidā catasso ",
  "tha-ap62:15.2": "vimokhā pi ca aṭṭh' ime / chaḷabhiññā sacchikatā ",
  "tha-ap62:15.3": "kataṃ Buddhassa sāsanan ti. // // ",
  "tha-ap62:16.1": "Itthaṃ sudaṃ āyasmā Asanabodhiyo thero imā gāthāyo abhāsitthā ti. ",
  "tha-ap62:17.1": "Asanabodhiyatherassa ",
  "tha-ap62:18.1": "apadānaṃ samattaṃ. ",
  "tha-ap62:19.1": "Uddānaṃ:-- ",
  "tha-ap62:20.1": "Vījanī Sataraṃsī ca ",
  "tha-ap62:20.2": "Sayan Odaki Vāhiyo ",
  "tha-ap62:20.3": "Parivāro Padīpañ ca ",
  "tha-ap62:20.4": "Dhajo Paduma-Pūjako ",
  "tha-ap62:20.5": "Bodhī ca dasamo vutto ",
  "tha-ap62:20.6": "gāthā dvenavutī tathā. "
}
