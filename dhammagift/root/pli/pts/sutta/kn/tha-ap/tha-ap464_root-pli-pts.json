  "tha-ap464:1.1": "Jhāyamānassa bhagavato ",
  "tha-ap464:1.2": "Sikhino lokabandhuno / ",
  "tha-ap464:1.3": "aṭṭhacampakapupphāni ",
  "tha-ap464:1.4": "citakam abhiropayiṃ. // // ",
  "tha-ap464:2.1": "Ekatiṃse ito kappe ",
  "tha-ap464:2.2": "yaṃ puppham abhiropayiṃ / ",
  "tha-ap464:2.3": "duggataṃ nāghijānāmi ",
  "tha-ap464:2.4": "citapūjāy' idaṃ phalaṃ. // // ",
  "tha-ap464:3.1": "Kilesā . . . ",
  "tha-ap464:3.2": "pe . . . ",
  "tha-ap464:3.3": "",
  "tha-ap464:4.1": "",
  "tha-ap464:4.2": "pe . . . ",
  "tha-ap464:4.3": "pe . . . // // Sāgataṃ . . . pe . . . pe . . . pe . . . // // ",
  "tha-ap464:5.1": "Paṭisambhidā . . . ",
  "tha-ap464:5.2": "pe . . . ",
  "tha-ap464:5.3": "pe . . . pe . . . // // ",
  "tha-ap464:6.1": "Itthaṃ sudam āyasmā Citapūjako thero i. g. a-ti. Citapūjakattherassa apadānaṃ samattaṃ. ",
  "tha-ap464:7.1": ""
}
