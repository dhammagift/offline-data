  "tha-ap240:1.1": "Sake sippe avatthaddho ",
  "tha-ap240:1.2": "agamaṃ kānanam ahaṃ / ",
  "tha-ap240:1.3": "sambuddhaṃ santaṃ disvāna ",
  "tha-ap240:1.4": "ambayāgam adās' ahaṃ. // // Ekanavute ",
  "tha-ap240:2.1": "ito kappe ",
  "tha-ap240:2.2": "yaṃ dānam adadiṃ tadā / ",
  "tha-ap240:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap240:2.4": "ambayāgass' idaṃ phalaṃ. // // ",
  "tha-ap240:3.1": "Paṭisambhidā . . . ",
  "tha-ap240:3.2": "pe . . . ",
  "tha-ap240:3.3": "pe . . . // // ",
  "tha-ap240:4.1": "Itthaṃ sudam āyasmā Ambayāgadāyako thero i. g. a-ti. Ambayāgadāyakattherassa ",
  "tha-ap240:5.1": "apadānaṃ samattaṃ. "
}
