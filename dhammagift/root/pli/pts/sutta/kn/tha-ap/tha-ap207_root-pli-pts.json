  "tha-ap207:1.1": "Vipassissa bhagavato ",
  "tha-ap207:1.2": "āsim ārāmiko ahaṃ / ",
  "tha-ap207:1.3": "nigguṇḍipupphaṃ paggayha ",
  "tha-ap207:1.4": "Buddhassa abhiropayiṃ. // // ",
  "tha-ap207:2.1": "Ekanavute ito kappe ",
  "tha-ap207:2.2": "yaṃ puppham abhipūjayiṃ / ",
  "tha-ap207:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap207:2.4": "Buddhapūjāy' idaṃ phalaṃ. // // ",
  "tha-ap207:3.1": "Pañcatiṃse ito kappe ",
  "tha-ap207:3.2": "eko āsi janādhipo / ",
  "tha-ap207:3.3": "Mahāpatāpo nāmena ",
  "tha-ap207:3.4": "cakkavattī mahabbalo. // // ",
  "tha-ap207:4.1": "Paṭisambhidā . . . ",
  "tha-ap207:4.2": "pe . . . ",
  "tha-ap207:4.3": "pe . . . // // ",
  "tha-ap207:5.1": "Itthaṃ sudam āyasmā Nigguṇḍipupphiyo thero i. g. a-ti. Nigguṇḍipupphiyattherassa apadānaṃ samattaṃ. ",
  "tha-ap207:6.1": ""
}
