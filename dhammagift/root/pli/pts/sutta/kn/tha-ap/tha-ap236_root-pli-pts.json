  "tha-ap236:1.1": "Tivarāyaṃ pure ramme ",
  "tha-ap236:1.2": "nalakāro ahaṃ tadā / ",
  "tha-ap236:1.3": "Siddhatthe lokapajjote ",
  "tha-ap236:1.4": "pasannā janatā tahiṃ. // // ",
  "tha-ap236:2.1": "Pūjatthaṃ lokanāthassa ",
  "tha-ap236:2.2": "kilañjaṃ pariyesati / ",
  "tha-ap236:2.3": "Buddhapūjaṃ karontānaṃ ",
  "tha-ap236:2.4": "kilañjam adadam ahaṃ. // // ",
  "tha-ap236:3.1": "Catunavute ito kappe ",
  "tha-ap236:3.2": "yaṃ kammam akariṃ tadā / ",
  "tha-ap236:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap236:3.4": "kilañjassa idaṃ phalaṃ. // // ",
  "tha-ap236:4.1": "Sattasattatikappamhi ",
  "tha-ap236:4.2": "rājā āsi Jutindharo / ",
  "tha-ap236:4.3": "sattaratanasampanno ",
  "tha-ap236:4.4": "cakkavatti mahabbalo. // // ",
  "tha-ap236:5.1": "Paṭisambhidā . . . ",
  "tha-ap236:5.2": "pe . . . ",
  "tha-ap236:5.3": "pe . . . // // ",
  "tha-ap236:6.1": "Itthaṃ sudam āyasmā Kilañjadāyako thero i. g. a-ti. Kilañjadāyakattherassa apadānaṃ samattaṃ. ",
  "tha-ap236:7.1": ""
}
