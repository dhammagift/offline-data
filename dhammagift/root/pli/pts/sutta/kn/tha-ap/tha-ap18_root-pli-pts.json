  "tha-ap18:0.3": "",
  "tha-ap18:1.1": "Padumuttarassa bhagavato ",
  "tha-ap18:1.2": "lokajeṭṭhassa tādino / ",
  "tha-ap18:1.3": "*sattabhūmimhi pāsā*de ",
  "tha-ap18:1.4": "adāsiṃ santharaṃ ahaṃ. // // ",
  "tha-ap18:2.1": "Khīṇāsavasahassehi ",
  "tha-ap18:2.2": "parikiṇṇo mahāmuṇi / ",
  "tha-ap18:2.3": "upāgami gandhakuṭim ",
  "tha-ap18:2.4": "dipadindo narāsabho. // // ",
  "tha-ap18:3.1": "Virocantaṃ gandhakuṭiṃ ",
  "tha-ap18:3.2": "devadevo narāsabho / ",
  "tha-ap18:3.3": "bhikkhusaṅghe ṭhito satthā ",
  "tha-ap18:3.4": "ima gāthā abhāsatha: // // ",
  "tha-ap18:4.1": "*Yenāyaṃ jotito siyā ",
  "tha-ap18:4.2": "ādāso 'va susanthato / ",
  "tha-ap18:4.3": "tam ahaṃ kittayissāmi; ",
  "tha-ap18:4.4": "suṇotha mama bhāsato: // // ",
  "tha-ap18:5.1": "Soṇṇamayā rūpimayā ",
  "tha-ap18:5.2": "atho veḷuriyāmayā / ",
  "tha-ap18:5.3": "nibbattissanti ākāse ",
  "tha-ap18:5.4": "ye keci manaso piyā. // // ",
  "tha-ap18:6.1": "Catusa*ṭṭhi*kkhattuñ de*vindo ",
  "tha-ap18:6.2": "devarajjaṃ karissa*ti / ",
  "tha-ap18:6.3": "sahassakkhattuṃ cakkavatti ",
  "tha-ap18:6.4": "bhavissati anantarā. // // ",
  "tha-ap18:7.1": "Ekavīsatikappamhi ",
  "tha-ap18:7.2": "Vimalo nāma khattiyo / ",
  "tha-ap18:7.3": "cāturanto vijitāvī ",
  "tha-ap18:7.4": "cakkavatti bhavissati. // // ",
  "tha-ap18:8.1": "Naṅgaraṃ Reṇuvatī nāma ",
  "tha-ap18:8.2": "iṭṭhakāhi sumāpitaṃ / ",
  "tha-ap18:8.3": "āyāmato *tīṇisataṃ caturassaṃ* ",
  "tha-ap18:8.4": "samāyutaṃ. // // ",
  "tha-ap18:9.1": "Sudassano nāma pāsādo ",
  "tha-ap18:9.2": "Vissakammena māpito / ",
  "tha-ap18:9.3": "kūṭāgāravarūpeto ",
  "tha-ap18:9.4": "sattaratanabhūsito. // // ",
  "tha-ap18:10.1": "Dasa saddā avivittaṃ ",
  "tha-ap18:10.2": "vijjādharasamākulaṃ / ",
  "tha-ap18:10.3": "Sudassanaṃ va naṅgaraṃ ",
  "tha-ap18:10.4": "devatānaṃ bhavissati. // // ",
  "tha-ap18:11.1": "Pabhā nigga*cchate tassa ",
  "tha-ap18:11.2": "ugga*cchante va sūriye / ",
  "tha-ap18:11.3": "virocissati taṃ niccaṃ ",
  "tha-ap18:11.4": "samantā aṭṭhayojanaṃ. // // ",
  "tha-ap18:12.1": "Kappasatasahassamhi ",
  "tha-ap18:12.2": "Okkākakulasambhavo / ",
  "tha-ap18:12.3": "Gotamo nāma nāmena ",
  "tha-ap18:12.4": "satthā loke bhavissati. // // ",
  "tha-ap18:13.1": "Tusitāhi cavi*tvāna ",
  "tha-ap18:13.2": "su*kkamūlena codito / ",
  "tha-ap18:13.3": "Gotamassa bhagavato ",
  "tha-ap18:13.4": "atrajo so bhavissati. // // ",
  "tha-ap18:14.1": "Sace vaseyya āgāraṃ ",
  "tha-ap18:14.2": "cakkavattī bhaveyya so / ",
  "tha-ap18:14.3": "aṭṭhānaṃ etaṃ yaṃ tādi ",
  "tha-ap18:14.4": "agāre ratim ajjhagā. // // ",
  "tha-ap18:15.1": "Ni*kkhamitvā agāramhā* ",
  "tha-ap18:15.2": "pabbajissati subbato / ",
  "tha-ap18:15.3": "Rāhulo nāma nāmena ",
  "tha-ap18:15.4": "arahā so bhavissati. // // ",
  "tha-ap18:16.1": "Kikī va aṇḍaṃ rakkheyya ",
  "tha-ap18:16.2": "camarī-r-iva vāladhiṃ / ",
  "tha-ap18:16.3": "nipako sīlasampanno ",
  "tha-ap18:16.4": "mamaṃ rakkhi mahāmuni. // // ",
  "tha-ap18:17.1": "Tassāhaṃ dhamma*m aññāya ",
  "tha-ap18:17.2": "vihāsiṃ sāsa*ne rato / ",
  "tha-ap18:17.3": "sabbāsave pariññāya ",
  "tha-ap18:17.4": "viharāmi anāsavo. // // ",
  "tha-ap18:18.1": "Paṭisambhidā catasso ",
  "tha-ap18:18.2": "vimokhā pi ca aṭṭh' ime / ",
  "tha-ap18:18.3": "chaḍabhiññā sacchikatā ",
  "tha-ap18:18.4": "kataṃ Buddhassa sāsanan ti. // // ",
  "tha-ap18:19.1": "Itthaṃ sudaṃ āyasmā Rāhulo thero imā gāthāyo abhāsitthā ti. Rāhuḷatherassa ",
  "tha-ap18:20.1": "apadānaṃ samattaṃ. [17. Upasena Vaṅgantaputta .] "
}
