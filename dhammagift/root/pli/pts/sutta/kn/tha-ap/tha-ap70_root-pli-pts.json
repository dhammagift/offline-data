  "tha-ap70:0.1": "",
  "tha-ap70:0.2": "",
  "tha-ap70:0.3": "",
  "tha-ap70:1.1": "Anomadassī bhagavā ",
  "tha-ap70:1.2": "nisinno pabbatantare / ",
  "tha-ap70:1.3": "mettāya apharī lokaṃ ",
  "tha-ap70:1.4": "appamāṇaṃ nirūpadhī. // // ",
  "tha-ap70:2.1": "Kapi ahaṃ tadā āsiṃ ",
  "tha-ap70:2.2": "Himavante naguttame / ",
  "tha-ap70:2.3": "disvā Anomam amitaṃ ",
  "tha-ap70:2.4": "Buddhe cittaṃ pasādayiṃ. // // ",
  "tha-ap70:3.1": "Avidūre Himavantassa ",
  "tha-ap70:3.2": "ambā suphalino tadā / ",
  "tha-ap70:3.3": "tato pakkaṃ gahetvāna ",
  "tha-ap70:3.4": "ambam samadhukam adaṃ. // // ",
  "tha-ap70:4.1": "Tam me buddho viyākāsi ",
  "tha-ap70:4.2": "Anomadassī mahāmuni: / ",
  "tha-ap70:4.3": "‘Iminā madhudānena ",
  "tha-ap70:4.4": "ambadānena cūbhayaṃ. // // ",
  "tha-ap70:5.1": "Sattapaññāsakappāni ",
  "tha-ap70:5.2": "devaloke ramissasi / ",
  "tha-ap70:5.3": "avasesesu kappesu ",
  "tha-ap70:5.4": "vokiṇṇaṃ saṃsarissasi. // // ",
  "tha-ap70:6.1": "Khepetvā pāpakaṃ kammaṃ ",
  "tha-ap70:6.2": "paripakkāya buddhiyā / ",
  "tha-ap70:6.3": "vinipātādiyā gantvā ",
  "tha-ap70:6.4": "kilese jhāpayissasi.' // // ",
  "tha-ap70:7.1": "Dhammena yuttamenāhaṃ ",
  "tha-ap70:7.2": "damito 'mhi mahesinā / ",
  "tha-ap70:7.3": "patto 'mhi acalaṃ ṭhānaṃ ",
  "tha-ap70:7.4": "hitvā jayaparājayaṃ. // // ",
  "tha-ap70:8.1": "Sattasattati kappasate ",
  "tha-ap70:8.2": "Ambaṭṭhaja-sanāmakā / ",
  "tha-ap70:8.3": "*catuddasā te rājāno* ",
  "tha-ap70:8.4": "cakkavattī mahābalā. // // ",
  "tha-ap70:9.1": "Paṭisambhidā catasso ",
  "tha-ap70:9.2": "vimokhā pi ca aṭṭh' ime / chaḷabhiññā sacchikatā ",
  "tha-ap70:9.3": "kataṃ Buddhassa sāsanaṃ ti. // // ",
  "tha-ap70:10.1": "Itthaṃ sudaṃ āyasmā Ambadāyako thero imā gāthāyo abhāsitthā ti. ",
  "tha-ap70:11.1": "Ambadāyakatherassa apadānaṃ samattaṃ. "
}
