  "tha-ap348:1.1": "",
  "tha-ap348:1.2": "nāma pabbato / ",
  "tha-ap348:1.3": "Buddho Sudassano nāma ",
  "tha-ap348:1.4": "vihāsi pabbatantare. // // ",
  "tha-ap348:2.1": "Pupphaṃ hemavataṃ gayha ",
  "tha-ap348:2.2": "gacchaṃ vehāsayen' ahaṃ / ",
  "tha-ap348:2.3": "addasaṃ virajaṃ Buddham ",
  "tha-ap348:2.4": "oghatiṇṇam anāsavaṃ. // // ",
  "tha-ap348:3.1": "Satta campakapupphāni ",
  "tha-ap348:3.2": "sīse katvān' ahaṃ tadā / ",
  "tha-ap348:3.3": "Buddhassa abhiropesiṃ ",
  "tha-ap348:3.4": "sayambhussa mahesino. // // ",
  "tha-ap348:4.1": "Ekatiṃse ito kappe ",
  "tha-ap348:4.2": "yaṃ puppham abhipūjayiṃ / ",
  "tha-ap348:4.3": "duggatiṃ nābhijānāmi ",
  "tha-ap348:4.4": "Buddhapūjāy' idaṃ phalaṃ. // // ",
  "tha-ap348:5.1": "Paṭisambhidā . . . ",
  "tha-ap348:5.2": "pe . . . ",
  "tha-ap348:5.3": "pe . . . // // ",
  "tha-ap348:6.1": "Itthaṃ sudam āyasmā Campakapupphiyo thero i. g. a-ti. Campakapupphiyattherassa apadānaṃ samattaṃ. Himavantass' avidūre ",
  "tha-ap348:7.1": ""
}
