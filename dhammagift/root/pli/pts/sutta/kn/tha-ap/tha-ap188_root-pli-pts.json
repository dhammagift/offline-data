  "tha-ap188:1.1": "Nagare Rammavatiyā ",
  "tha-ap188:1.2": "āsiṃ Muraja-nāmako / ",
  "tha-ap188:1.3": "niccupaṭṭhānayutto 'mhi ",
  "tha-ap188:1.4": "gato 'haṃ bodhiṃ uttamaṃ. // // ",
  "tha-ap188:2.1": "Sāyapātaṃ uṭṭhahitvā ",
  "tha-ap188:2.2": "sukkamūlena codito / ",
  "tha-ap188:2.3": "aṭṭhārase kappasate ",
  "tha-ap188:2.4": "duggatiṃ nūpapajj' ahaṃ. // // ",
  "tha-ap188:3.1": "Pañcadase kappasate ",
  "tha-ap188:3.2": "rājāhosiṃ janādhipo / ",
  "tha-ap188:3.3": "Damatho nāma nāmena ",
  "tha-ap188:3.4": "cakkavattī mahabbalo. // // ",
  "tha-ap188:4.1": "Paṭisambhidā . . . ",
  "tha-ap188:4.2": "pe . . . ",
  "tha-ap188:4.3": "pe . . . // // ",
  "tha-ap188:5.1": "Itthaṃ sudaṃ āyasmā Bodhiupaṭṭhāyako thero i. g. a-ti. Bodhiupaṭṭhāyakattherassa ",
  "tha-ap188:6.1": "apadanaṃ samattaṃ. "
}
