  "tha-ap421:1.1": "Vanacārī pure āsiṃ ",
  "tha-ap421:1.2": "satataṃ vanakammiko / ",
  "tha-ap421:1.3": "patthodanaṃ gahetvāna ",
  "tha-ap421:1.4": "kammantam agamās' ahaṃ. // // ",
  "tha-ap421:2.1": "Tatth' addasāsiṃ sambuddhaṃ ",
  "tha-ap421:2.2": "sayambhum aparājitaṃ / ",
  "tha-ap421:2.3": "vanā piṇḍāya nikkhantaṃ ",
  "tha-ap421:2.4": "disvā cittaṃ pasādayiṃ. // // ",
  "tha-ap421:3.1": "Parakammāyane yutto ",
  "tha-ap421:3.2": "puññañ ca me na vijjati / ",
  "tha-ap421:3.3": "ayaṃ patthodanam atthi ",
  "tha-ap421:3.4": "bhojayissām' ahaṃ muniṃ. // // ",
  "tha-ap421:4.1": "Patthodanaṃ gahetvāna ",
  "tha-ap421:4.2": "sayambhussa adās' ahaṃ / ",
  "tha-ap421:4.3": "mama nijjhāyamānassa ",
  "tha-ap421:4.4": "paribhuñji tadā muni. // // ",
  "tha-ap421:5.1": "Tena kammena sukatena ",
  "tha-ap421:5.2": "cetanāpaṇidhīhi ca / ",
  "tha-ap421:5.3": "jahitvā mānusaṃ dehaṃ ",
  "tha-ap421:5.4": "Tāvatiṃsam agacch' ahaṃ. // // ",
  "tha-ap421:6.1": "Chattiṃsakkhattuṃ devindo ",
  "tha-ap421:6.2": "devarajjam akārayiṃ / ",
  "tha-ap421:6.3": "tettiṃsakkhattuṃ rājā ca ",
  "tha-ap421:6.4": "cakkavattī ahos' ahaṃ. // // ",
  "tha-ap421:7.1": "Padesarajjaṃ vipulaṃ ",
  "tha-ap421:7.2": "gaṇanāto asaṅkhiyaṃ / ",
  "tha-ap421:7.3": "sukhito yasavā homi ",
  "tha-ap421:7.4": "patthodanass' idaṃ phalaṃ. // // ",
  "tha-ap421:8.1": "Bhavābhave saṃsaranto ",
  "tha-ap421:8.2": "labhāmi amitaṃ dhanaṃ / ",
  "tha-ap421:8.3": "bhoge me ūnatā n' atthi ",
  "tha-ap421:8.4": "patthodanass' idaṃ phalaṃ. // // ",
  "tha-ap421:9.1": "Nadīsotapaṭibhāgā ",
  "tha-ap421:9.2": "bhogā nibbattare mama / ",
  "tha-ap421:9.3": "parimetuṃ na sakkomi ",
  "tha-ap421:9.4": "patthodanass' idaṃ phalaṃ. // // ",
  "tha-ap421:10.1": "Imaṃ khāda imaṃ bhuñja ",
  "tha-ap421:10.2": "imamhi sayane saya / ",
  "tha-ap421:10.3": "tenāhaṃ sukhito homi ",
  "tha-ap421:10.4": "patthodanass' idaṃ phalaṃ. // // ",
  "tha-ap421:11.1": "Catunavute ito kappe ",
  "tha-ap421:11.2": "yaṃ dānam adadiṃ tadā / ",
  "tha-ap421:11.3": "duggatiṃ nābhijānāmi ",
  "tha-ap421:11.4": "patthodanass' idaṃ phalaṃ. // // ",
  "tha-ap421:12.1": "Kilesā . . . ",
  "tha-ap421:12.2": "pe . . . ",
  "tha-ap421:12.3": "",
  "tha-ap421:13.1": "",
  "tha-ap421:13.2": "pe . . . // // ",
  "tha-ap421:13.3": "Sāgataṃ . . . pe . . . pe . . . pe . . . // // ",
  "tha-ap421:14.1": "Paṭisambhidā . . . ",
  "tha-ap421:14.2": "pe . . . ",
  "tha-ap421:14.3": "pe . . . // // ",
  "tha-ap421:15.1": "Itthaṃ sudam āyasmā Patthodanadāyako th. i. g. a-ti. Patthodanadāyakattherassa apadānaṃ samattaṃ. ",
  "tha-ap421:16.1": ""
}
