  "tha-ap323:0.2": "",
  "tha-ap323:0.3": "",
  "tha-ap323:1.1": "Samāhitaṃ samāpannaṃ ",
  "tha-ap323:1.2": "Siddhattham aparājitaṃ / ",
  "tha-ap323:1.3": "samādhinā upāviṭṭham ",
  "tha-ap323:1.4": "addasāsiṃ naruttamaṃ. // // ",
  "tha-ap323:2.1": "Ummāpupphaṃ gahetvāna ",
  "tha-ap323:2.2": "Buddhassa abhiropayiṃ / ",
  "tha-ap323:2.3": "sabbe pupphā ekasīsā ",
  "tha-ap323:2.4": "uddhavaṇṭā adhomukhā. // // ",
  "tha-ap323:3.1": "Sucittā viya tiṭṭhante ",
  "tha-ap323:3.2": "ākāse pupphasantharā / ",
  "tha-ap323:3.3": "tena cittappasādena ",
  "tha-ap323:3.4": "Tusitam upapajj' ahaṃ. // // Catunavute ",
  "tha-ap323:4.1": "ito kappe ",
  "tha-ap323:4.2": "yaṃ puppham abhipūjayiṃ / ",
  "tha-ap323:4.3": "duggatiṃ nābhijānāmi ",
  "tha-ap323:4.4": "Buddhapūjāy' idaṃ phalaṃ. // // ",
  "tha-ap323:5.1": "Pañcapaññās' ito kappe ",
  "tha-ap323:5.2": "eko āsi mahīpati / ",
  "tha-ap323:5.3": "Samantacchadano nāma ",
  "tha-ap323:5.4": "cakkavattī mahabbalo. // // ",
  "tha-ap323:6.1": "Paṭisambhidā . . . pe . . . ",
  "tha-ap323:6.2": "",
  "tha-ap323:6.3": "pe . . . // // ",
  "tha-ap323:6.4": "",
  "tha-ap323:7.1": "Itthaṃ sudam āyasmā Ummāpupphiyo thero i. g. a-ti. Ummāpupphiyattherassa apadānaṃ samattaṃ. ",
  "tha-ap323:8.1": ""
}
