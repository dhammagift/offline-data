{
  "tha-ap47:0.1": "",
  "tha-ap47:0.2": "",
  "tha-ap47:0.3": "",
  "tha-ap47:1.1": "Sumedho nāma sambuddho ",
  "tha-ap47:1.2": "gacchate antarāpaṇe / ",
  "tha-ap47:1.3": "khittacakkhu mitabhāṇī ",
  "tha-ap47:1.4": "satimā saṃvutindriyo. // // ",
  "tha-ap47:2.1": "Pañcauppalahatthāni ",
  "tha-ap47:2.2": "āveḷattham akāsi me / ",
  "tha-ap47:2.3": "tena Buddhaṃ apūjesiṃ ",
  "tha-ap47:2.4": "pasanno sehi pāṇihi. // // ",
  "tha-ap47:3.1": "Āropitā ca te pupphā ",
  "tha-ap47:3.2": "chādanaṃ assu satthuno / ",
  "tha-ap47:3.3": "saṃsāviṃsu mahānāgaṃ ",
  "tha-ap47:3.4": "sissā ācariyaṃ yathā. // // ",
  "tha-ap47:4.1": "Tiṃsakappasahassamhi ",
  "tha-ap47:4.2": "yaṃ puppham abhiropayiṃ / ",
  "tha-ap47:4.3": "duggatiṃ nābhijānāmi ",
  "tha-ap47:4.4": "Buddhapūjāy' idaṃ phalaṃ. // // ",
  "tha-ap47:5.1": "Ito vīsaṃkappasate ",
  "tha-ap47:5.2": "ahesuṃ pañca khattiyā / ",
  "tha-ap47:5.3": "Hatthiyā nāma nāmena ",
  "tha-ap47:5.4": "cakkavattī mahabbalā. // // ",
  "tha-ap47:6.1": "Paṭisambhidā catasso ",
  "tha-ap47:6.2": "vimokhā pi ca aṭṭh' ime / chaḷabhiññā sacchikatā ",
  "tha-ap47:6.3": "kataṃ Buddhassa sāsanan ti. // // ",
  "tha-ap47:7.1": "Itthaṃ sudaṃ āyasmā Pañcahatthiyo thero imā gāthāyo abhāsitthā ti. ",
  "tha-ap47:8.1": "Pañcahatthiyatherassa apadānaṃ samattaṃ. "
}
