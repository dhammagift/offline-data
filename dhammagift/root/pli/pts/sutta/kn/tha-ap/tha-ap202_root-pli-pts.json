{
  "tha-ap202:0.1": "",
  "tha-ap202:0.2": "",
  "tha-ap202:0.3": "",
  "tha-ap202:1.1": "Padumuttaro nāma jino ",
  "tha-ap202:1.2": "āhutīnaṃ paṭiggaho / ",
  "tha-ap202:1.3": "pavanā nikkhamitvāna ",
  "tha-ap202:1.4": "vihāraṃ yāti cakkhumā. // // ",
  "tha-ap202:2.1": "Ubho hatthehi paggayha ",
  "tha-ap202:2.2": "yūthikaṃ puppham uttamaṃ / ",
  "tha-ap202:2.3": "Buddhassa abhiropesiṃ ",
  "tha-ap202:2.4": "mettacittassa tādino. // // ",
  "tha-ap202:3.1": "Tena cittappasādena ",
  "tha-ap202:3.2": "anubhotvāna sampadā / ",
  "tha-ap202:3.3": "kappānaṃ satasahassaṃ ",
  "tha-ap202:3.4": "duggatiṃ nūpapajj' ahaṃ. // // ",
  "tha-ap202:4.1": "Ito paññāsakappesu ",
  "tha-ap202:4.2": "eko āsi janādhipo / ",
  "tha-ap202:4.3": "Samitaṃnandano nāma ",
  "tha-ap202:4.4": "cakkavattī mahabbalo. // // ",
  "tha-ap202:5.1": "Paṭisambhidā . . . ",
  "tha-ap202:5.2": "pe . . . ",
  "tha-ap202:5.3": "pe . . . // // ",
  "tha-ap202:6.1": "Itthaṃ sudaṃ āyasmā Yūthikapupphiyo thero i. g. a-ti. Yūthikapupphiyattherassa apadānaṃ ",
  "tha-ap202:7.1": "",
  "tha-ap202:7.2": "samattaṃ. Uddānaṃ: ",
  "tha-ap202:8.1": "Tamālī ",
  "tha-ap202:9.1": "Tiṇasanthāro ",
  "tha-ap202:9.2": "Khaṇḍaphullī-Asokiyo ",
  "tha-ap202:9.3": "Aṅkoḷakī Kisalayo ",
  "tha-ap202:9.4": "Tinduko Nelapupphiyo ",
  "tha-ap202:9.5": "Tikaṇḍo Yūthiko gāthāyo paññāsañ ca ",
  "tha-ap202:9.6": "aṭṭhañ ca. Tamālapupphiyavaggo vīsatimo. ",
  "tha-ap202:10.1": "Atha vaggUddānaṃ: ",
  "tha-ap202:11.1": "Bhikkhado Parivāro ",
  "tha-ap202:11.2": "ca Sereyya-Sobhito tathā ",
  "tha-ap202:11.3": "Chatto ca Bandhujīvī ca ",
  "tha-ap202:11.4": "Supāricariyo pi ca. ",
  "tha-ap202:12.1": "Kumudo Kuṭajo ceva ",
  "tha-ap202:12.2": "Tamālika dasamo kato ",
  "tha-ap202:12.3": "chassatāni ca gāthānaṃ ",
  "tha-ap202:12.4": "chasaṭṭhi ca tatuttariṃ. ",
  "tha-ap202:13.1": "Dutiyaṃ ",
  "tha-ap202:14.1": "satakaṃ samattaṃ. "
}
