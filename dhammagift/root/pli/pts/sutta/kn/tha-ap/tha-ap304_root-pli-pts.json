  "tha-ap304:1.1": "Gandhamālaṃ mayā dinnaṃ ",
  "tha-ap304:1.2": "Vipassissa mahesino / ",
  "tha-ap304:1.3": "adāsim ujubhūtassa ",
  "tha-ap304:1.4": "koseyyaṃ vattham uttamaṃ. // // ",
  "tha-ap304:2.1": "Ekanavute ito kappe ",
  "tha-ap304:2.2": "yaṃ vattham adadiṃ pure / ",
  "tha-ap304:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap304:2.4": "*gandhadānass'* idaṃ phalaṃ. // // ",
  "tha-ap304:3.1": "Ito pannarase kappe ",
  "tha-ap304:3.2": "Sucelo nāma khattiyo / ",
  "tha-ap304:3.3": "sattaratanasampanno ",
  "tha-ap304:3.4": "cakkavattī mahabbalo. // // ",
  "tha-ap304:4.1": "Paṭisambhidā . . . ",
  "tha-ap304:4.2": "pe . . . ",
  "tha-ap304:4.3": "pe . . . // // ",
  "tha-ap304:5.1": "Itthaṃ sudam āyasmā Sabbagandhiyo thero i. g. a-ti. Sabbagandhiyattherassa apadānaṃ samattaṃ. Kaṇikāraṃ va ",
  "tha-ap304:6.1": ""
}
