  "tha-ap551:1.1": "kappe ",
  "tha-ap551:1.2": "brahmabandhu mahāyaso. / ",
  "tha-ap551:1.3": "Kassapo nāma nāmena ",
  "tha-ap551:1.4": "uppajji vadataṃ varo. // // ",
  "tha-ap551:2.1": "Tadā'haṃ pabbajitvāna ",
  "tha-ap551:2.2": "tassa Buddhassa sāsane / ",
  "tha-ap551:2.3": "yāvajīvañ caritvāna ",
  "tha-ap551:2.4": "brahmaceraṃ tato cuto. // // ",
  "tha-ap551:3.1": "Tenakammena sukatena ",
  "tha-ap551:3.2": "cetanāpaṇidhīhi ca / ",
  "tha-ap551:3.3": "jahitvā mānusaṃ dehaṃ ",
  "tha-ap551:3.4": "Tāvatiṃsaṃ agacch ahaṃ // // ",
  "tha-ap551:4.1": "Tatocuto araññamhi ",
  "tha-ap551:4.2": "kapoto ās' ahaṃ tahiṃ / ",
  "tha-ap551:4.3": "vasate guṇasampanno ",
  "tha-ap551:4.4": "bhikkhu jhānarato sadā. // // ",
  "tha-ap551:5.1": "Mettacittokāruṇiko ",
  "tha-ap551:5.2": "sadā pamuditānano / ",
  "tha-ap551:5.3": "upekkhako mahāvīro ",
  "tha-ap551:5.4": "appamaññāsu kovido // // ",
  "tha-ap551:6.1": "Vinīvaraṇasaṅkappesabbasattahitāsaye / Vissattho ",
  "tha-ap551:6.2": "",
  "tha-ap551:6.3": "naciren' asmiṃ ",
  "tha-ap551:6.4": "tasmiṃ sugatasāvake. // // ",
  "tha-ap551:7.1": "Upeccapādamūlamhi ",
  "tha-ap551:7.2": "ni*si*nnassa tadā sa me / ",
  "tha-ap551:7.3": "kadāci āmisaṃ deti ",
  "tha-ap551:7.4": "dhammaṃ deseti c' ekadā. // // ",
  "tha-ap551:8.1": "Tadāvipulapemena ",
  "tha-ap551:8.2": "upāsitvā jinatrajaṃ / ",
  "tha-ap551:8.3": "tato cuto gato saggaṃ ",
  "tha-ap551:8.4": "pavā*so sagharaṃ yathā.* // // ",
  "tha-ap551:9.1": "Saggacutomanussesu ",
  "tha-ap551:9.2": "nibbatto puññakammanā / ",
  "tha-ap551:9.3": "agāraṃ chaḍḍayitvāna ",
  "tha-ap551:9.4": "pabbajjiṃ bahuso ahaṃ. // // ",
  "tha-ap551:10.1": "Samaṇotāpaso vippo ",
  "tha-ap551:10.2": "paribbājo tath' ev' ahaṃ / ",
  "tha-ap551:10.3": "hutvā vasī araññamhi ",
  "tha-ap551:10.4": "anekasata so ahaṃ. // // ",
  "tha-ap551:11.1": "Pacchimeca bhave dāni ",
  "tha-ap551:11.2": "ramme Kapilavatthave / ",
  "tha-ap551:11.3": "Vacchagotto ti Jotissa ",
  "tha-ap551:11.4": "jāyāya ahaṃ okkamiṃ. // // ",
  "tha-ap551:12.1": "Mātume dohalo āsi ",
  "tha-ap551:12.2": "tirokucchigatassa me / ",
  "tha-ap551:12.3": "jāyamānasamīpamhi ",
  "tha-ap551:12.4": "vanavāsāyanicchayo. // // ",
  "tha-ap551:13.1": "Tatome ajanī mātā ",
  "tha-ap551:13.2": "ramanīye vanantare / ",
  "tha-ap551:13.3": "gabbhato nikkhamantaṃ maṃ ",
  "tha-ap551:13.4": "kāsāyena paṭiggahuṃ. // // ",
  "tha-ap551:14.1": "Tatokumāro Siddhattho ",
  "tha-ap551:14.2": "jāto Sakyakuladdhajo / ",
  "tha-ap551:14.3": "tassa mitto piyo āsiṃ ",
  "tha-ap551:14.4": "saṃvissattho sumānigo // // ",
  "tha-ap551:15.1": "Sattasārehinikkhanto ",
  "tha-ap551:15.2": "ohāya vipulaṃ yasaṃ / ",
  "tha-ap551:15.3": "aham pi pabbajitvāna ",
  "tha-ap551:15.4": "Himavantaṃ upāgamiṃ. // // ",
  "tha-ap551:16.1": "Vanālayaṃbhāvaniyaṃ ",
  "tha-ap551:16.2": "Kassapaṃ dhutavādakaṃ / ",
  "tha-ap551:16.3": "disvā sutvā jinuppādaṃ ",
  "tha-ap551:16.4": "upesiṃ narasārathiṃ. // // ",
  "tha-ap551:17.1": "Some dhammam adesesi ",
  "tha-ap551:17.2": "sabbatthasampakāsayaṃ / ",
  "tha-ap551:17.3": "tato 'haṃ pabbajitvāna ",
  "tha-ap551:17.4": "vanam eva punāgamiṃ. // // ",
  "tha-ap551:18.1": "Tatth'appamatto viharaṃ ",
  "tha-ap551:18.2": "chalabhiññā apassayiṃ / ",
  "tha-ap551:18.3": "aho suladdhalābho 'mhi ",
  "tha-ap551:18.4": "sumitten' ānukampito. // // ",
  "tha-ap551:19.1": "Kilesā. . . ",
  "tha-ap551:19.2": "pe . . . ",
  "tha-ap551:19.3": "",
  "tha-ap551:20.1": "",
  "tha-ap551:20.2": "pe . . . ",
  "tha-ap551:20.3": "pe . . . // // Sāgataṃ. . . pe . . . pe . . . pe . . . // // ",
  "tha-ap551:21.1": "Paṭisambhidā. . . ",
  "tha-ap551:21.2": "pe . . . ",
  "tha-ap551:21.3": "pe . . . pe . . . // // ",
  "tha-ap551:22.1": "Itthaṃ sudaṃ āyasmā Vanavaccho thero i. g. a-ti. Vanavacchattherassa apadānaṃ samattaṃ. Imamhibhaddake ",
  "tha-ap551:23.1": ""
}
