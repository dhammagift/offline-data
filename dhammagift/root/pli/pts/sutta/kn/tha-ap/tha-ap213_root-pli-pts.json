  "tha-ap213:1.1": "Siddhatthassa bhagavato ",
  "tha-ap213:1.2": "dipadindassa tādino / ",
  "tha-ap213:1.3": "nāgaseṭṭho mayā dinno r- ",
  "tha-ap213:1.4": "īsādanto urūḷhavo. // // ",
  "tha-ap213:2.1": "Uttamatthaṃ anubhomi ",
  "tha-ap213:2.2": "santipadam anuttaraṃ / ",
  "tha-ap213:2.3": "aggadānaṃ mayā dinnaṃ ",
  "tha-ap213:2.4": "sabbalokahitesino. // // ",
  "tha-ap213:3.1": "Catunavute ito kappe ",
  "tha-ap213:3.2": "yaṃ dānam adadiṃ tadā / ",
  "tha-ap213:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap213:3.4": "nāgadānass' idaṃ phalaṃ. // // ",
  "tha-ap213:4.1": "Aṭṭhasattati kappamhi ",
  "tha-ap213:4.2": "solas' āsiṃsu khattiyā / ",
  "tha-ap213:4.3": "Samantapāsādikā nāma ",
  "tha-ap213:4.4": "cakkavattī mahabbalā. // // ",
  "tha-ap213:5.1": "Paṭisambhidā . . . pe . . . ",
  "tha-ap213:5.2": "",
  "tha-ap213:5.3": "pe . . . // // ",
  "tha-ap213:5.4": "",
  "tha-ap213:6.1": "Itthaṃ sudam āyasmā Hatthidāyako thero i. g. a-ti. Hatthidāyakattherassa apadānaṃ samattaṃ. Āraññakassa ",
  "tha-ap213:7.1": ""
}
