  "tha-ap17:0.1": "",
  "tha-ap17:0.2": "",
  "tha-ap17:0.3": "",
  "tha-ap17:1.1": "Nibbute lokanāthamhi ",
  "tha-ap17:1.2": "Sumedhe aggapuggale / ",
  "tha-ap17:1.3": "pasannacitto sumano ",
  "tha-ap17:1.4": "thūpapūjaṃ akās ahaṃ. // // ",
  "tha-ap17:2.1": "Ye ca khīṇāsavā tattha ",
  "tha-ap17:2.2": "chaḷabhiññā mahiddhikā / ",
  "tha-ap17:2.3": "te*saṃ tattha samānetvā ",
  "tha-ap17:2.4": "*saṅghabhattaṃ akās' ahaṃ. // // ",
  "tha-ap17:3.1": "Sumedhassa bhagavato ",
  "tha-ap17:3.2": "upaṭṭhāko tadā ahu / ",
  "tha-ap17:3.3": "Sumedho nāma nāmena ",
  "tha-ap17:3.4": "anumodittha so tadā. // // ",
  "tha-ap17:4.1": "Tena cittappasādena ",
  "tha-ap17:4.2": "vimānaṃ upapajj' ahaṃ / ",
  "tha-ap17:4.3": "chaḷāsītisahassāni ",
  "tha-ap17:4.4": "a*ccharāyo ramiṃsu me* // // ",
  "tha-ap17:5.1": "Mam' eva anuvattanti ",
  "tha-ap17:5.2": "sabbakāmehi tā sadā / ",
  "tha-ap17:5.3": "aññe deve atibhomi ",
  "tha-ap17:5.4": "puññakammass' idaṃ phalaṃ. // // ",
  "tha-ap17:6.1": "Pañcavīsatikappamhi ",
  "tha-ap17:6.2": "Varuṇo nāma khattiyo / ",
  "tha-ap17:6.3": "susuddhabhojano āsiṃ ",
  "tha-ap17:6.4": "cakkavatti ahaṃ tadā. // // ",
  "tha-ap17:7.1": "Na te bījaṃ pavapanti ",
  "tha-ap17:7.2": "na pi nīyanti naṅgalā / ",
  "tha-ap17:7.3": "akaṭṭhapākimaṃ sāliṃ ",
  "tha-ap17:7.4": "paribhuñjanti mānusā. // // ",
  "tha-ap17:8.1": "Tattha rajjaṃ karitvāna ",
  "tha-ap17:8.2": "devattaṃ puna gacch' ahaṃ. / ",
  "tha-ap17:8.3": "tadāpi edisā mayhaṃ ",
  "tha-ap17:8.4": "nibbattā bhogasampadā. // // ",
  "tha-ap17:9.1": "Na maṃ mittā amittā vā ",
  "tha-ap17:9.2": "*hiṃsanti sabbapāṇi*no / ",
  "tha-ap17:9.3": "sabbesam pi piyo homi ",
  "tha-ap17:9.4": "puññakammass idaṃ phalaṃ. // // ",
  "tha-ap17:10.1": "Tiṃsakappasahassamhi ",
  "tha-ap17:10.2": "yaṃ dānam adadiṃ tadā / ",
  "tha-ap17:10.3": "duggatiṃ nābhijānāmi ",
  "tha-ap17:10.4": "gandhālepass idaṃ phalaṃ. // // ",
  "tha-ap17:11.1": "*Imasmiṃ bhaddake kappe ",
  "tha-ap17:11.2": "eko āsi janādhipo / ",
  "tha-ap17:11.3": "mahānubhāvo rājā 'si ",
  "tha-ap17:11.4": "cakkavatti mahābalo. // // ",
  "tha-ap17:12.1": "So 'haṃ pañcasu sīlesu ",
  "tha-ap17:12.2": "ṭhapetvā janataṃ bahuṃ / ",
  "tha-ap17:12.3": "pāpetvā sugatiṃ yeva ",
  "tha-ap17:12.4": "devatānaṃ piyo ahuṃ.* // // ",
  "tha-ap17:13.1": "Paṭisambhidā catasso ",
  "tha-ap17:13.2": "vimokhā pi ca aṭṭh' ime / ",
  "tha-ap17:13.3": "chaḍabhiññā sacchikatā ",
  "tha-ap17:13.4": "kataṃ Buddhassa sāsanan ti. // // ",
  "tha-ap17:14.1": "Itthaṃ sudaṃ āyasmā Pilindavaccho thero imā gāthāyo abhāsitthāti. ",
  "tha-ap17:15.1": "Pilindavacchatherassa apadānaṃ samattaṃ. "
}
