  "tha-ap157:0.3": "",
  "tha-ap157:1.1": "Devaputto ahaṃ santo ",
  "tha-ap157:1.2": "pujesiṃ Sikhināyakaṃ / ",
  "tha-ap157:1.3": "mandāravena pupphena ",
  "tha-ap157:1.4": "Buddhassa abhiropayiṃ. // // ",
  "tha-ap157:2.1": "Sattāhaṃ chadanaṃ āsi ",
  "tha-ap157:2.2": "dibbaṃ mālyaṃ Tathāgate / ",
  "tha-ap157:2.3": "sabbe janā samāgantvā ",
  "tha-ap157:2.4": "namassiṃsu Tathāgataṃ. // // ",
  "tha-ap157:3.1": "Ekatiṃse ito kappe ",
  "tha-ap157:3.2": "yaṃ puppham abhipūjayiṃ / ",
  "tha-ap157:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap157:3.4": "Buddhapūjāy' idaṃ phalaṃ. // // ",
  "tha-ap157:4.1": "Ito ca dasame kappe ",
  "tha-ap157:4.2": "rājā 'hosiṃ Jutindharo / ",
  "tha-ap157:4.3": "sattaratanasampanno ",
  "tha-ap157:4.4": "cakkavattī mahabbalo. // // ",
  "tha-ap157:5.1": "Paṭisambhidā . . . ",
  "tha-ap157:5.2": "pe . . . ",
  "tha-ap157:5.3": "pe . . . // // ",
  "tha-ap157:6.1": "Itthaṃ sudaṃ ā. Mandāravapūjako thero i. g. ā-ti. Mandāravapūjakattherassa apadānaṃ samattaṃ. Himavantass' avidūre ",
  "tha-ap157:7.1": ""
}
