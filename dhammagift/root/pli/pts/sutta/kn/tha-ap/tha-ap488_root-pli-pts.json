  "tha-ap488:4.2": "pe . . . ",
  "tha-ap488:4.3": "pe . . . // // Sāgataṃ . . . pe . . . pe . . . pe . . . // // ",
  "tha-ap488:5.1": "Paṭisambhidā . . . ",
  "tha-ap488:5.2": "pe . . . ",
  "tha-ap488:5.3": "pe . . . pe . . . // // ",
  "tha-ap488:6.1": "Itthaṃ sudaṃ āyasmā Dhātupūjako thero i. g. a-ti. Dhātupūjakattherassa ",
