{
  "tha-ap5:0.1": "",
  "tha-ap5:0.2": "",
  "tha-ap5:0.3": "",
  "tha-ap5:1.1": "Padumuttarassa bhagavato ",
  "tha-ap5:1.2": "lokajeṭṭhassa tādino / ",
  "tha-ap5:1.3": "nibbute lokanāthamhi ",
  "tha-ap5:1.4": "pūjaṃ kubbanti satthuno / ",
  "tha-ap5:2.1": "udaggacittā janatā ",
  "tha-ap5:2.2": "āmoditapamoditā. // // ",
  "tha-ap5:2.3": "Tesu saṃvegajātesu ",
  "tha-ap5:2.4": "pīti me udapajjatha / ",
  "tha-ap5:3.1": "ñatimitte samānetvā ",
  "tha-ap5:3.2": "idaṃ vacanam abraviṃ: / ",
  "tha-ap5:3.3": "‘Parinibbuto mahāvīro ",
  "tha-ap5:3.4": "handa pūjaṃ karomase.' // // ",
  "tha-ap5:4.1": "Sadhū ti te paṭissutvā ",
  "tha-ap5:4.2": "bhiyyo hāsaṃ janiṃsu me / ",
  "tha-ap5:4.3": "buddhasmiṃ lokanāthasmiṃ ",
  "tha-ap5:4.4": "kāhāma puññasañcayaṃ. // // ",
  "tha-ap5:5.1": "Agghiyaṃ sukataṃ katvā ",
  "tha-ap5:5.2": "satahatthaṃ samuggataṃ / diyaḍḍhaṃ ",
  "tha-ap5:5.3": "hatthasataṃ pi ",
  "tha-ap5:5.4": "vimānaṃ nabham uggataṃ. // // ",
  "tha-ap5:6.1": "Katvāna agghiyaṃ tattha ",
  "tha-ap5:6.2": "tālapantīhi cittitaṃ / ",
  "tha-ap5:6.3": "sakaṃ cittaṃ pasādetvā ",
  "tha-ap5:6.4": "cetiyaṃ pūjay' uttamaṃ. // // ",
  "tha-ap5:7.1": "Aggikkhandho va jalito ",
  "tha-ap5:7.2": "sālarājā va phullito / ",
  "tha-ap5:7.3": "indalaṭṭhīva ākāse ",
  "tha-ap5:7.4": "obhāseti catuddisā. // // ",
  "tha-ap5:8.1": "Tesu cittaṃ pasādetvā ",
  "tha-ap5:8.2": "katvāna kusalaṃ bahuṃ / ",
  "tha-ap5:8.3": "pubbakammaṃ saritvāna ",
  "tha-ap5:8.4": "tidasaṃ upapajj' ahaṃ. // // ",
  "tha-ap5:9.1": "Sahassayuttaṃ hayavāhiṃ ",
  "tha-ap5:9.2": "dibbaṃ yānam adhiṭṭhito / ",
  "tha-ap5:9.3": "ubbiddhaṃ bhavanaṃ mayhaṃ ",
  "tha-ap5:9.4": "sattabhūmi samuggataṃ // // ",
  "tha-ap5:10.1": "Kūṭāgārasahassāni ",
  "tha-ap5:10.2": "sabbe sovaṇṇayā ahuṃ / ",
  "tha-ap5:10.3": "jalanti sakatejena ",
  "tha-ap5:10.4": "disā sabbā pabhāsayaṃ. // // ",
  "tha-ap5:11.1": "Santi aññe pi niyyuhā ",
  "tha-ap5:11.2": "lohitaṅkamayā tadā / ",
  "tha-ap5:11.3": "te pi jotanti ābhāya ",
  "tha-ap5:11.4": "samantā caturo disā // // ",
  "tha-ap5:12.1": "Puññakammābhinibbattā ",
  "tha-ap5:12.2": "kūṭāgārā sunimmitā / ",
  "tha-ap5:12.3": "maṇimayāpi jotanti ",
  "tha-ap5:12.4": "disādasa samantato. // // ",
  "tha-ap5:13.1": "Tesaṃ ujjotamānānaṃ ",
  "tha-ap5:13.2": "obhāso vipulo ahu / ",
  "tha-ap5:13.3": "sabbe deve atibhomi ",
  "tha-ap5:13.4": "puññakammass' idaṃ phalaṃ. // // ",
  "tha-ap5:14.1": "Saṭṭhikappasahassamhi ",
  "tha-ap5:14.2": "Ubbiddho nāma khattiyo / ",
  "tha-ap5:14.3": "caturanto vijitāvī ",
  "tha-ap5:14.4": "puṭhaviṃ āvasiṃ ahaṃ. // // ",
  "tha-ap5:15.1": "Tamh' eva bhaddake kappe ",
  "tha-ap5:15.2": "tiṃsakkhattuṃ ahos ahaṃ / ",
  "tha-ap5:15.3": "sakakammābhiraddho 'mhi ",
  "tha-ap5:15.4": "cakkavatti mahabbalo. // // ",
  "tha-ap5:16.1": "Sattaratanasampanno ",
  "tha-ap5:16.2": "cātudīpamhi issaro / ",
  "tha-ap5:16.3": "tatthāpi bhavanaṃ mayhaṃ ",
  "tha-ap5:16.4": "indalaṭṭhi 'va uggataṃ // // ",
  "tha-ap5:17.1": "Āyāmato catubbīsaṃ ",
  "tha-ap5:17.2": "vitthārena ca dvādasā. / ",
  "tha-ap5:17.3": "Rammakaṃ nāma naṅgaraṃ ",
  "tha-ap5:17.4": "daḷhapākāratoraṇaṃ. // // ",
  "tha-ap5:18.1": "Āyāmato pañcasataṃ ",
  "tha-ap5:18.2": "vitthārena tadaḍḍhakaṃ / ",
  "tha-ap5:18.3": "ākiṇṇaṃ janakāyehi ",
  "tha-ap5:18.4": "tidasānaṃ puraṃ viya. // // ",
  "tha-ap5:19.1": "Yathā sucighare sucipakkhittā ",
  "tha-ap5:19.2": "paṇṇuvīsati / ",
  "tha-ap5:19.3": "aññamaññam saṅghaṭṭhenti ",
  "tha-ap5:19.4": "ākiṇṇaṃ hoti taṃ tadā. // // ",
  "tha-ap5:20.1": "Evam pi nagaraṃ mayhaṃ ",
  "tha-ap5:20.2": "hatthassarathasaṅkulaṃ / ",
  "tha-ap5:20.3": "manussehi tadākiṇṇaṃ ",
  "tha-ap5:20.4": "Rammakaṃ naṅgaruttamaṃ. // // ",
  "tha-ap5:21.1": "Tattha bhutvā ca pitvā ca ",
  "tha-ap5:21.2": "puna devattataṃ gato / ",
  "tha-ap5:21.3": "bhave pacchimake mayhaṃ ",
  "tha-ap5:21.4": "ahosi kulasampadā. // // ",
  "tha-ap5:22.1": "Brāhmaññakulasambhūto ",
  "tha-ap5:22.2": "mahāratanasañcayo / ",
  "tha-ap5:22.3": "asītiṃkoṭiyo hitvā ",
  "tha-ap5:22.4": "'bhiraññassa paribbajiṃ. // // ",
  "tha-ap5:23.1": "Paṭisambhidā catasso ",
  "tha-ap5:23.2": "vimokhā pi ca aṭṭh' ime / ",
  "tha-ap5:23.3": "chaḍabhiññā sacchikatā ",
  "tha-ap5:23.4": "kataṃ buddhassa sāsanan ti. // // ",
  "tha-ap5:24.1": "Itthaṃ sudaṃ āyasmā Mahākassapo thero imā gāthāyo abhāsitthāti. ",
  "tha-ap5:25.1": "Mahākassapatherassa apadānaṃ samattaṃ. "
}
