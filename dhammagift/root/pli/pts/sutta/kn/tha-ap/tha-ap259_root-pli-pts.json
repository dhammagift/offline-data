  "tha-ap259:1.1": "Mañjarikaṃ karitvāna ",
  "tha-ap259:1.2": "rathiyaṃ paṭipajj' ahaṃ / ",
  "tha-ap259:1.3": "addasaṃ samaṇānaggaṃ ",
  "tha-ap259:1.4": "bhikkhusaṅghapurakkhataṃ. // // ",
  "tha-ap259:2.1": "Pasannacitto sumano ",
  "tha-ap259:2.2": "paramāya ca pītiyā / ",
  "tha-ap259:2.3": "ubho hatthehi paggayha ",
  "tha-ap259:2.4": "Buddhassa abhiropayiṃ. // // ",
  "tha-ap259:3.1": "Dvenavute ito kappe ",
  "tha-ap259:3.2": "yaṃ puppham abhipūjayiṃ / ",
  "tha-ap259:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap259:3.4": "pupphapūjāy' idaṃ phalaṃ. // // ",
  "tha-ap259:4.1": "Ito tesattati kappe ",
  "tha-ap259:4.2": "eko āsi mahīpati / ",
  "tha-ap259:4.3": "Jotiyo nāma nāmena ",
  "tha-ap259:4.4": "cakkavattī mahabbalo. // // ",
  "tha-ap259:5.1": "Paṭisambhidā . . . ",
  "tha-ap259:5.2": "pe . . . ",
  "tha-ap259:5.3": "pe . . . // // ",
  "tha-ap259:6.1": "Itthaṃ sudam āyasmā Mañjaripūjako thero i. g. a-ti. Mañjaripūjakattherassa apadānaṃ samattaṃ. ",
  "tha-ap259:7.1": ""
}
