  "tha-ap197:0.1": "",
  "tha-ap197:0.2": "",
  "tha-ap197:0.3": "",
  "tha-ap197:1.1": "Aṅkolaṃ pupphitaṃ disvā ",
  "tha-ap197:1.2": "māhāsārasamotataṃ / ",
  "tha-ap197:1.3": "ocinitvāna taṃ pupphaṃ ",
  "tha-ap197:1.4": "agamaṃ Buddhasantike. // // ",
  "tha-ap197:2.1": "Siddhattho tamhi samaye ",
  "tha-ap197:2.2": "patilīno mahāmuni / ",
  "tha-ap197:2.3": "muhuttaṃ patimānetvā ",
  "tha-ap197:2.4": "guhāyaṃ puppham okiriṃ // // Catunavute ",
  "tha-ap197:3.1": "ito kappe ",
  "tha-ap197:3.2": "yaṃ puppham abhiropayiṃ / ",
  "tha-ap197:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap197:3.4": "Buddhapūjāy' idaṃ phalaṃ. // // ",
  "tha-ap197:4.1": "Chattiṃsamhi ito kappe ",
  "tha-ap197:4.2": "ās' eko Devagajjito / ",
  "tha-ap197:4.3": "sattaratanasampanno ",
  "tha-ap197:4.4": "cakkavattī mahabbalo. // // ",
  "tha-ap197:5.1": "Paṭisambhidā . . . ",
  "tha-ap197:5.2": "pe . . . ",
  "tha-ap197:5.3": "pe . . . // // ",
  "tha-ap197:6.1": "Itthaṃ sudam āyasmā Aṅkolako thero i. g. a-ti. Aṅkoḷakattherassa ",
  "tha-ap197:7.1": "apadānaṃ samattaṃ. "
}
