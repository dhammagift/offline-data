  "tha-ap496:1.1": "Kiṃsukaṃ pupphitaṃ disvā ",
  "tha-ap496:1.2": "paggahetvāna añjaliṃ / ",
  "tha-ap496:1.3": "Buddhaseṭṭhaṃ saritvāna ",
  "tha-ap496:1.4": "ākāse abhipūjayiṃ. // // ",
  "tha-ap496:2.1": "Tena kammena sukatena ",
  "tha-ap496:2.2": "cetanāpaṇidhīhi ca / ",
  "tha-ap496:2.3": "jahitvā mānusaṃ dehaṃ ",
  "tha-ap496:2.4": "Tāvatiṃsaṃ agañch' ahaṃ. // // ",
  "tha-ap496:3.1": "Ekatiṃse ito kappe ",
  "tha-ap496:3.2": "yaṃ kammam akariṃ tadā / ",
  "tha-ap496:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap496:3.4": "Buddhapūjāy' idaṃ phalaṃ // // ",
  "tha-ap496:4.1": "Kilesā . . . ",
  "tha-ap496:4.2": "pe . . . ",
  "tha-ap496:4.3": "",
  "tha-ap496:5.1": "",
  "tha-ap496:5.2": "pe . . . ",
  "tha-ap496:5.3": "pe . . . // // Sāgataṃ . . . pe . . . pe . . . pe . . . // // ",
  "tha-ap496:6.1": "Paṭisambhidā . . . ",
  "tha-ap496:6.2": "pe . . . ",
  "tha-ap496:6.3": "pe . . . pe . . . // // ",
  "tha-ap496:7.1": "Itthaṃ sudaṃ āyasmā Kiṃsukapupphiyo th. i. g. a-ti. Kiṃsukapupphiyattherassa apadānaṃ samattaṃ. Padumuttarassa bhagavato ",
  "tha-ap496:8.1": ""
}
