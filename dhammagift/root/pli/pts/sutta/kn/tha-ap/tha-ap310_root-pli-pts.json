  "tha-ap310:1.1": "Atthadassissa munino ",
  "tha-ap310:1.2": "addasaṃ sāvakam ahaṃ / ",
  "tha-ap310:1.3": "navakammaṃ karontassa ",
  "tha-ap310:1.4": "*sīmāya upagacch' ahaṃ. // // ",
  "tha-ap310:2.1": "Niṭṭhite navakamme *ca ",
  "tha-ap310:2.2": "anulepaṃ adās' ahaṃ / ",
  "tha-ap310:2.3": "pasannacitto sumano ",
  "tha-ap310:2.4": "puññakkhette anuttare. // // ",
  "tha-ap310:3.1": "Atthārase kappasate ",
  "tha-ap310:3.2": "yaṃ kammam akariṃ tadā / ",
  "tha-ap310:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap310:3.4": "anulepass' idaṃ phalaṃ. // // ",
  "tha-ap310:4.1": "Paṭisambhidā . . . ",
  "tha-ap310:4.2": "pe . . . ",
  "tha-ap310:4.3": "pe . . . // // ",
  "tha-ap310:5.1": "Itthaṃ sudam āyasmā Anulepadāyako thero i. g. a-ti. Anulepadāyakattherassa ",
  "tha-ap310:6.1": "apadānaṃ samattaṃ. "
}
