  "tha-ap511:1.1": "Sataraṃsi nāma bhagavā ",
  "tha-ap511:1.2": "sayambhū aparājito / ",
  "tha-ap511:1.3": "vivekā vuṭṭhahitvāna ",
  "tha-ap511:1.4": "gocarā*yābhinikkha*mi. // // ",
  "tha-ap511:2.1": "Phalahattho ahaṃ disvā ",
  "tha-ap511:2.2": "upagacchiṃ narāsabhaṃ / ",
  "tha-ap511:2.3": "pasannacitto sumano ",
  "tha-ap511:2.4": "tālaphalam adās' ahaṃ. // // Catunavute ",
  "tha-ap511:3.1": "ito kappe ",
  "tha-ap511:3.2": "yaṃ phalaṃ adadiṃ tadā / ",
  "tha-ap511:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap511:3.4": "phaladānass' idaṃ phalaṃ. // // ",
  "tha-ap511:4.1": "Kilesā . . . ",
  "tha-ap511:4.2": "pe . . . ",
  "tha-ap511:4.3": "",
  "tha-ap511:5.1": "",
  "tha-ap511:5.2": "pe . . . ",
  "tha-ap511:5.3": "pe . . . // // Sāgataṃ . . . pe . . . pe . . . pe . . . // // ",
  "tha-ap511:6.1": "Paṭisambhidā . . . ",
  "tha-ap511:6.2": "pe . . . ",
  "tha-ap511:6.3": "pe . . . pe . . . // // ",
  "tha-ap511:7.1": "Itthaṃ sudaṃ āyasmā Tālaphaliyo thero i. g. a-ti. Tālaphaliyattherassa ",
  "tha-ap511:8.1": "apadānaṃ samattaṃ. "
}
