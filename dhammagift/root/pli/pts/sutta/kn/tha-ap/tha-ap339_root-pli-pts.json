  "tha-ap339:0.3": "",
  "tha-ap339:1.1": "Nagare Bandhumatiyā ",
  "tha-ap339:1.2": "ahosiṃ parakammiko / ",
  "tha-ap339:1.3": "parakammāyane yutto ",
  "tha-ap339:1.4": "parabhattaṃ apassito. // // ",
  "tha-ap339:2.1": "Rahogato nisīditvā ",
  "tha-ap339:2.2": "evaṃ cintesi tāvade: / ",
  "tha-ap339:2.3": "Buddho loke samuppanno ",
  "tha-ap339:2.4": "adhikāro *ca n' atthi* me. // // ",
  "tha-ap339:3.1": "Kālo gatiṃ me sodhetuṃ ",
  "tha-ap339:3.2": "khaṇo me paṭipādito / ",
  "tha-ap339:3.3": "dukkho nirayasamphasso ",
  "tha-ap339:3.4": "apuññānaṃ hi pāṇinaṃ. // // ",
  "tha-ap339:4.1": "Evāhaṃ cintayitvāna ",
  "tha-ap339:4.2": "kammasāmim upāgamiṃ / ",
  "tha-ap339:4.3": "ekāhaṃ kammaṃ *yācitvā ",
  "tha-ap339:4.4": "pavanaṃ pāvisim ahaṃ. // // ",
  "tha-ap339:5.1": "Tiṇakaṭṭhañ ca* valliñ ca āharitvān' ",
  "tha-ap339:5.2": "ahan tadā / ",
  "tha-ap339:5.3": "tidaṇḍake ṭhapetvāna ",
  "tha-ap339:5.4": "akaṃ tiṇakuṭim ahaṃ. // // ",
  "tha-ap339:6.1": "Saṅghassatthāya kuṭikaṃ ",
  "tha-ap339:6.2": "niyyātetvāna *tam ahaṃ* / ",
  "tha-ap339:6.3": "tadahe yeva āgantvā ",
  "tha-ap339:6.4": "kammasāmim upāgamiṃ. // // ",
  "tha-ap339:7.1": "*Tena kammena sukatena ",
  "tha-ap339:7.2": "Tāvatiṃsam agacch' ahaṃ / ",
  "tha-ap339:7.3": "tattha me* sukataṃ vyamhaṃ ",
  "tha-ap339:7.4": "tiṇakuṭikāya nimmitaṃ. // // ",
  "tha-ap339:8.1": "Sahassakaṇḍo satageṇḍu ",
  "tha-ap339:8.2": "dhajālu haritāmayo / ",
  "tha-ap339:8.3": "satasahassaniyyūhā ",
  "tha-ap339:8.4": "vyamhe pātubhaviṃsu me. // // ",
  "tha-ap339:9.1": "Yaṃ yaṃ yonūpapajjāmi ",
  "tha-ap339:9.2": "devattam atha mānusaṃ / ",
  "tha-ap339:9.3": "mama saṅkappam aññāya ",
  "tha-ap339:9.4": "*pāsādo upatiṭṭhati.* // // ",
  "tha-ap339:10.1": "Bhayaṃ vā chambhitattaṃ vā ",
  "tha-ap339:10.2": "lomahaṃso na vijjati / ",
  "tha-ap339:10.3": "tāsaṃ mamaṃ na jānāmi ",
  "tha-ap339:10.4": "tiṇakuṭikāy idaṃ phalaṃ. // // ",
  "tha-ap339:11.1": "Sīhavyagghā ca dīpī ca ",
  "tha-ap339:11.2": "acchakokataracchayo / ",
  "tha-ap339:11.3": "sabbe maṃ parivajjenti ",
  "tha-ap339:11.4": "tiṇakuṭikāy' idaṃ phalaṃ. // // ",
  "tha-ap339:12.1": "Siriṃsapā ca bhūtā *ca ",
  "tha-ap339:12.2": "ahi-kumbhaṇḍa-ra*kkhasā / ",
  "tha-ap339:12.3": "te pi maṃ parivajjenti ",
  "tha-ap339:12.4": "tiṇakuṭikāy' idaṃ phalaṃ. // // ",
  "tha-ap339:13.1": "Na pāpasupinassāhaṃ ",
  "tha-ap339:13.2": "sarāmi dassanaṃ mama / ",
  "tha-ap339:13.3": "upaṭṭhitā sati mayhaṃ ",
  "tha-ap339:13.4": "tiṇakuṭikāy' idaṃ phalaṃ. // // ",
  "tha-ap339:14.1": "Tāy' eva tiṇakuṭikāya ",
  "tha-ap339:14.2": "anubhotvāna sampadā / ",
  "tha-ap339:14.3": "Gotamassa bhagavato ",
  "tha-ap339:14.4": "dhammaṃ sacchikarim ahaṃ. // // ",
  "tha-ap339:15.1": "Ekanavute ito kappe ",
  "tha-ap339:15.2": "yaṃ kammam akariṃ tadā / ",
  "tha-ap339:15.3": "duggatiṃ nābhijānāmi ",
  "tha-ap339:15.4": "tiṇakuṭikāy' idaṃ phalaṃ. // // ",
  "tha-ap339:16.1": "Paṭisambhidā . . . ",
  "tha-ap339:16.2": "pe . . . ",
  "tha-ap339:16.3": "pe . . . // // ",
  "tha-ap339:17.1": "Itthaṃ sudam āyasmā Tiṇakuṭidāyako th. i. g. a-ti. Tiṇakuṭidāyakattherassa apadānaṃ samattaṃ. ",
  "tha-ap339:18.1": ""
}
