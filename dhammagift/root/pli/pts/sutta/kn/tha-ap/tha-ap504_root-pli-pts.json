  "tha-ap504:1.1": "Nagare Haṃsavatiyā ",
  "tha-ap504:1.2": "kumbhakāro ahos' ahaṃ / ",
  "tha-ap504:1.3": "addasaṃ virajaṃ Buddhaṃ ",
  "tha-ap504:1.4": "oghatiṇṇam anāsavaṃ. // // ",
  "tha-ap504:2.1": "Sukataṃ mattikāpattaṃ ",
  "tha-ap504:2.2": "Buddhaseṭṭhass' adās' ahaṃ / ",
  "tha-ap504:2.3": "pattaṃ datvā bhagavato ",
  "tha-ap504:2.4": "ujubhūtassa tādino // // ",
  "tha-ap504:3.1": "Bhave nibbattamāno 'haṃ ",
  "tha-ap504:3.2": "sovaṇṇathāle labhām' ahaṃ / ",
  "tha-ap504:3.3": "rūpimaye ca sovaṇṇe ",
  "tha-ap504:3.4": "taṭṭake ca maṇīmaye // // ",
  "tha-ap504:4.1": "Pātiyo paribhuñjāmi ",
  "tha-ap504:4.2": "puññakammass' idaṃ phalaṃ / ",
  "tha-ap504:4.3": "yasānañ ",
  "tha-ap504:4.4": "ca dhanānañ ca pattabhūto ca hom' ahaṃ. // // ",
  "tha-ap504:5.1": "Yathāpi bhaddake khette ",
  "tha-ap504:5.2": "bījam appam pi ropitaṃ / ",
  "tha-ap504:5.3": "sammādhāre pavecchante ",
  "tha-ap504:5.4": "phalaṃ toseti kassakaṃ. // // ",
  "tha-ap504:6.1": "Tath ev' imaṃ pattadānaṃ ",
  "tha-ap504:6.2": "Buddhakhettamhi ropitaṃ / ",
  "tha-ap504:6.3": "pītidhāre pavassante ",
  "tha-ap504:6.4": "phalaṃ me tosayissati. // // ",
  "tha-ap504:7.1": "Yāvatā khettā vijjanti ",
  "tha-ap504:7.2": "saṅghāpi ca gaṇāpi ca / ",
  "tha-ap504:7.3": "buddhakhettasamo n' atthi ",
  "tha-ap504:7.4": "sukhadānatthā pāṇinaṃ. // // ",
  "tha-ap504:8.1": "Namo te purisājañña! ",
  "tha-ap504:8.2": "Namo te purisuttamo! / ",
  "tha-ap504:8.3": "ekapattaṃ daditvāna ",
  "tha-ap504:8.4": "patto 'mhi acalaṃ padaṃ. // // ",
  "tha-ap504:9.1": "Ekanavute ito kappe ",
  "tha-ap504:9.2": "yaṃ pattam adadiṃ tadā / ",
  "tha-ap504:9.3": "duggatiṃ nābhijānāmi ",
  "tha-ap504:9.4": "Buddhapūjāy' idaṃ phalaṃ. // // ",
  "tha-ap504:10.1": "Kilesā . . . ",
  "tha-ap504:10.2": "pe . . . ",
  "tha-ap504:10.3": "",
  "tha-ap504:11.1": "",
  "tha-ap504:11.2": "pe . . . ",
  "tha-ap504:11.3": "pe . . . // // Sāgataṃ . . . pe . . . pe . . . pe . . . // // ",
  "tha-ap504:12.1": "Paṭisambhidā . . . ",
  "tha-ap504:12.2": "pe . . . ",
  "tha-ap504:12.3": "pe . . . pe . . . // // ",
  "tha-ap504:13.1": "Itthaṃ sudaṃ āyasmā Ekapattadāyako thero i. g. a-ti. Ekapattadāyakattherassa apadānaṃ ",
  "tha-ap504:14.1": "samattaṃ. Kaṇikāraṃ va "
}
