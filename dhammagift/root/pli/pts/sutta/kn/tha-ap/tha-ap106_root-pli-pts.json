  "tha-ap106:0.1": "",
  "tha-ap106:0.2": "",
  "tha-ap106:0.3": "",
  "tha-ap106:1.1": "Siddhatthassa bhagavato ",
  "tha-ap106:1.2": "jātipuppham adās' ahaṃ / ",
  "tha-ap106:1.3": "pādesu satta pupphāni ",
  "tha-ap106:1.4": "hāsena-kāritāni me. // // ",
  "tha-ap106:2.1": "Tena kammen' ahaṃ ajja ",
  "tha-ap106:2.2": "atihomi narāmare / ",
  "tha-ap106:2.3": "dhāremi antimaṃ dehaṃ ",
  "tha-ap106:2.4": "sammāsambuddhasāsane. // // ",
  "tha-ap106:3.1": "Catunavute ito kappe ",
  "tha-ap106:3.2": "yaṃ puppham abhiropayiṃ / ",
  "tha-ap106:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap106:3.4": "pupphapūjāy' idaṃ phalaṃ. // // ",
  "tha-ap106:4.1": "Samantagandhanāmā-'suṃ ",
  "tha-ap106:4.2": "terasā cakkavattino / ",
  "tha-ap106:4.3": "ito pañcamake kappe ",
  "tha-ap106:4.4": "cāturantā gaṇādhipā. // // ",
  "tha-ap106:5.1": "Paṭisambhidā catasso ",
  "tha-ap106:5.2": "vimokhā pi ca aṭṭh' ime / chaḍabhiññā sacchikatā ",
  "tha-ap106:5.3": "kataṃ Buddhassa sāsanan' ti. // // ",
  "tha-ap106:6.1": "Itthaṃ sudaṃ āyasmā Padapūjako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap106:7.1": "Padapūjakatherassa apadānaṃ samattaṃ. Sudassano ti "
}
