  "tha-ap154:0.2": "",
  "tha-ap154:0.3": "",
  "tha-ap154:1.1": "Parakammāyane yutto ",
  "tha-ap154:1.2": "aparādhaṃ akās' ahaṃ / ",
  "tha-ap154:1.3": "vanantaṃ atidhāvissaṃ ",
  "tha-ap154:1.4": "bhayabheravasamappito. // // ",
  "tha-ap154:2.1": "Pupphitaṃ pādapaṃ disvā ",
  "tha-ap154:2.2": "piṇḍibaddhaṃ sunimmitaṃ / ",
  "tha-ap154:2.3": "tambapupphaṃ gahetvāna ",
  "tha-ap154:2.4": "bodhiyaṃ okiriṃ ahaṃ. // // ",
  "tha-ap154:3.1": "Sammajjitvāna taṃ bodhiṃ ",
  "tha-ap154:3.2": "pāṭalipādamuttamaṃ / ",
  "tha-ap154:3.3": "pallaṅkaṃ ābhujitvāna ",
  "tha-ap154:3.4": "bodhimūle upāvisiṃ. // // ",
  "tha-ap154:4.1": "Gatamaggaṃ gavesanto ",
  "tha-ap154:4.2": "āgañchuṃ mama santike / ",
  "tha-ap154:4.3": "te ca dīsvān' ahaṃ tattha ",
  "tha-ap154:4.4": "āvajjiṃ bodhim uttamaṃ. // // Vanditvā ",
  "tha-ap154:5.1": "ca ahaṃ bodhiṃ ",
  "tha-ap154:5.2": "vippasannena cetasā / ",
  "tha-ap154:5.3": "anekatālīsa patiṃ ",
  "tha-ap154:5.4": "giridugge bhayānake. // // ",
  "tha-ap154:6.1": "Ekanavute ito kappe ",
  "tha-ap154:6.2": "yam puppham abhiropayiṃ / ",
  "tha-ap154:6.3": "duggatiṃ nābhijānāmi ",
  "tha-ap154:6.4": "bodhipūjāy' idaṃ phalaṃ. // // ",
  "tha-ap154:7.1": "Ito ca tatiye kappe ",
  "tha-ap154:7.2": "rājā Samphusito ahu / ",
  "tha-ap154:7.3": "sattaratanasampanno ",
  "tha-ap154:7.4": "cakkavattī mahābalo. // // ",
  "tha-ap154:8.1": "Paṭisambhidā . . . ",
  "tha-ap154:8.2": "pe . . . ",
  "tha-ap154:8.3": "pe . . . // // ",
  "tha-ap154:9.1": "Itthaṃ sudaṃ ā. Tambapupphiya thero i. g. a-ti. Tambapupphiyattherassa apadānaṃ samattaṃ. ",
  "tha-ap154:10.1": ""
}
