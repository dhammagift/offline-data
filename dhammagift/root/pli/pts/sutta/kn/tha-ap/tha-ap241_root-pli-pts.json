  "tha-ap241:1.1": "Nibbute lokanāthamhi ",
  "tha-ap241:1.2": "Atthadassi-naruttame / ",
  "tha-ap241:1.3": "jagatī kāritā mayhaṃ ",
  "tha-ap241:1.4": "Buddhassa thūpa-m-uttame. // // ",
  "tha-ap241:2.1": "Aṭṭhārase kappasate ",
  "tha-ap241:2.2": "yaṃ kammam akariṃ tadā / ",
  "tha-ap241:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap241:2.4": "jagatiyaṃ idaṃ phalaṃ. // // ",
  "tha-ap241:3.1": "Paṭisambhidā . . . ",
  "tha-ap241:3.2": "pe . . . ",
  "tha-ap241:3.3": "pe . . . // // ",
  "tha-ap241:4.1": "Itthaṃ sudam āyasmā Jagatikārako thero i. g. a-ti. Jagatikārakattherassa apadānaṃ samattaṃ. Kammāro 'haṃ ",
  "tha-ap241:5.1": ""
}
