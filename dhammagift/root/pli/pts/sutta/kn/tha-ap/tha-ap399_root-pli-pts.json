  "tha-ap399:0.3": "",
  "tha-ap399:1.1": "Bhariyā me kālakatā ",
  "tha-ap399:1.2": "putto sīvathikaṃ gato / ",
  "tha-ap399:1.3": "mātā pitā ca bhātā ",
  "tha-ap399:1.4": "ca ekacitakamhi ḍayhare. // // ",
  "tha-ap399:2.1": "Tena sokena santatto ",
  "tha-ap399:2.2": "kiso paṇḍu ahos' ahaṃ / ",
  "tha-ap399:2.3": "cittakkhepañ ca me āsi ",
  "tha-ap399:2.4": "tena sokena cakkhumā. // // ",
  "tha-ap399:3.1": "Sokasallapareto 'haṃ ",
  "tha-ap399:3.2": "vanantam upasaṅkamiṃ / ",
  "tha-ap399:3.3": "pavattaphalabhuñjitvā ",
  "tha-ap399:3.4": "rukkhamūle vasām' ahaṃ. // // ",
  "tha-ap399:4.1": "Sumedho nāma sambuddho ",
  "tha-ap399:4.2": "dukkhass' antakaro jino / ",
  "tha-ap399:4.3": "mam uddharitukāmo so ",
  "tha-ap399:4.4": "agacchi mama santike. // // ",
  "tha-ap399:5.1": "Padasaddaṃ suṇitvāna ",
  "tha-ap399:5.2": "Sumedhassa mahesino / ",
  "tha-ap399:5.3": "paggahetvāna 'haṃ sīsam ",
  "tha-ap399:5.4": "ullokesi mahāmuni. // // ",
  "tha-ap399:6.1": "Upagacchi mahāvīro ",
  "tha-ap399:6.2": "pīti me udapajjatha / ",
  "tha-ap399:6.3": "tadāsi me p' aggamano ",
  "tha-ap399:6.4": "disvā taṃ lokanāyakaṃ. // // ",
  "tha-ap399:7.1": "Satiṃ paṭilabhitvāna ",
  "tha-ap399:7.2": "paṇṇamuṭṭhim adās' ahaṃ / ",
  "tha-ap399:7.3": "nisīdi bhagavā tattha ",
  "tha-ap399:7.4": "anukampāya cakkhumā. // // ",
  "tha-ap399:8.1": "Nisajja tattha bhagavā ",
  "tha-ap399:8.2": "Sumedho lokanāyako / ",
  "tha-ap399:8.3": "dhammam me kathayī Buddho ",
  "tha-ap399:8.4": "sokasallavinodanaṃ: // // ",
  "tha-ap399:9.1": "Anavhātā tato āguṃ ",
  "tha-ap399:9.2": "nānuññātā ito gatā / ",
  "tha-ap399:9.3": "yathāgatā tathāgatā: ",
  "tha-ap399:9.4": "tattha kā paridevanā? // // ",
  "tha-ap399:10.1": "Yathāpi pathikā sattā ",
  "tha-ap399:10.2": "vassamānāya vuṭṭhiyā / ",
  "tha-ap399:10.3": "sabhaṇḍā upagacchanti ",
  "tha-ap399:10.4": "vassass' āpatanāya te. // // ",
  "tha-ap399:11.1": "Vasse ete oramite ",
  "tha-ap399:11.2": "sampayanti yadicchakaṃ / ",
  "tha-ap399:11.3": "evaṃ mātā pitā tuyhaṃ: ",
  "tha-ap399:11.4": "tattha kā paridevanā? // // ",
  "tha-ap399:12.1": "Āgantukā pāhuṇakā ",
  "tha-ap399:12.2": "caliteritakampitā / ",
  "tha-ap399:12.3": "evaṃ mātā pitā tuyhaṃ: ",
  "tha-ap399:12.4": "tattha kā paridevanā? // // ",
  "tha-ap399:13.1": "Yathāpi *urago jiṇṇaṃ ",
  "tha-ap399:13.2": "hitvā ga*cchati saṃ tanuṃ / ",
  "tha-ap399:13.3": "evaṃ mātā pitā tuyhaṃ ",
  "tha-ap399:13.4": "saṃ tanuṃ idha hiyyare. // // ",
  "tha-ap399:14.1": "Buddhassa giram aññāya ",
  "tha-ap399:14.2": "sokasallaṃ vivajjayiṃ / ",
  "tha-ap399:14.3": "pāmujjaṃ janayitvāna ",
  "tha-ap399:14.4": "Buddhasettham avandi 'haṃ. // // ",
  "tha-ap399:15.1": "Vanditvāna mahānāgaṃ girapañjaliṃ ",
  "tha-ap399:15.2": "pūjayiṃ / dibbagandhena ",
  "tha-ap399:15.3": "sampannaṃ ",
  "tha-ap399:15.4": "Sumedhaṃ lokanāyakaṃ. // // ",
  "tha-ap399:16.1": "Pūjayitvāna sambuddhaṃ ",
  "tha-ap399:16.2": "sire katvāna añjaliṃ / ",
  "tha-ap399:16.3": "anussaraṃ guṇaggāni ",
  "tha-ap399:16.4": "santhaviṃ lokanāyakaṃ. // // ",
  "tha-ap399:17.1": "Nitthiṇṇo 'si mahāvīra ",
  "tha-ap399:17.2": "sabbaññū lokanāyako / ",
  "tha-ap399:17.3": "sabbe satte uddharesi ",
  "tha-ap399:17.4": "ñāṇena tvaṃ mahāmune. // // ",
  "tha-ap399:18.1": "Vimatiṃ dveḷhakañ cāpi ",
  "tha-ap399:18.2": "sacchindasi mahāmune / ",
  "tha-ap399:18.3": "paṭipādesi me maggaṃ ",
  "tha-ap399:18.4": "tava ñāṇena cakkhumā. // // ",
  "tha-ap399:19.1": "Arahā siddhipattā ca ",
  "tha-ap399:19.2": "chaḷabhiññā mahiddhikā / ",
  "tha-ap399:19.3": "antalikkhe carā dhīrā ",
  "tha-ap399:19.4": "parivārenti tāvade. // // ",
  "tha-ap399:20.1": "Paṭipannā ca sekhā ca ",
  "tha-ap399:20.2": "phalaṭṭhā santi sāvakā. / ",
  "tha-ap399:20.3": "sūrodaye va padumā ",
  "tha-ap399:20.4": "pupphanti tava sāvakā. // // ",
  "tha-ap399:21.1": "Mahāsamuddo vākkhobbho ",
  "tha-ap399:21.2": "atulo pi duruttaro / ",
  "tha-ap399:21.3": "evaṃ ñāṇena sampanno ",
  "tha-ap399:21.4": "appameyyo 'si cakkhumā. // // ",
  "tha-ap399:22.1": "Vanditvāhaṃ lokajinaṃ ",
  "tha-ap399:22.2": "cakkhumantam mahāyasaṃ / ",
  "tha-ap399:22.3": "puthudisā namassanto ",
  "tha-ap399:22.4": "paṭikuṭiko agacch' ahaṃ. // // ",
  "tha-ap399:23.1": "Devalokā cavitvāna ",
  "tha-ap399:23.2": "sampajāno paṭissato / ",
  "tha-ap399:23.3": "okkami mātuyā kucchiṃ ",
  "tha-ap399:23.4": "sandhāvanto bhavābhave. // // ",
  "tha-ap399:24.1": "Agārā abhinikkhamma ",
  "tha-ap399:24.2": "pabbajim anagāriyaṃ / ",
  "tha-ap399:24.3": "ātāpī nipako cāpi ",
  "tha-ap399:24.4": "paṭisallāṇagocaro. // // ",
  "tha-ap399:25.1": "Padhānaṃ padahitvāna ",
  "tha-ap399:25.2": "tosayitvā mahāmuniṃ / ",
  "tha-ap399:25.3": "cando v' abbhaghanā mutto ",
  "tha-ap399:25.4": "vicarāmi ahaṃ tadā. // // ",
  "tha-ap399:26.1": "Vivekam anuyutto 'mhi ",
  "tha-ap399:26.2": "upasanto nirūpadhi / ",
  "tha-ap399:26.3": "sabbāsave pariññāya ",
  "tha-ap399:26.4": "viharāmi anāsavo. // // ",
  "tha-ap399:27.1": "Tiṃsakappasahassamhi ",
  "tha-ap399:27.2": "yaṃ Buddham abhipūjayiṃ / ",
  "tha-ap399:27.3": "duggatiṃ nābhijānāmi ",
  "tha-ap399:27.4": "Buddhapūjāy' idaṃ phalaṃ. // // ",
  "tha-ap399:28.1": "Kilesā . . . ",
  "tha-ap399:28.2": "",
  "tha-ap399:28.3": "",
  "tha-ap399:28.4": "",
  "tha-ap399:29.1": "",
  "tha-ap399:29.2": "pe . . . ",
  "tha-ap399:29.3": "pe . . . // // Sāgataṃ . . . pe . . . pe . . . // // ",
  "tha-ap399:30.1": "Paṭisambhidā . . . ",
  "tha-ap399:30.2": "pe . . . ",
  "tha-ap399:30.3": "pe . . . // // ",
  "tha-ap399:31.1": "Itthaṃ sudam āyasmā Girimānando thero i. g. a-ti. *Girimānandattherassa apadānaṃ samattaṃ.* ",
  "tha-ap399:32.1": ""
}
