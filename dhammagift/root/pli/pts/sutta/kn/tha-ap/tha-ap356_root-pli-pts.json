  "tha-ap356:1.1": "padaṃ disvā ",
  "tha-ap356:1.2": "Sikhino lokabandhuno / ",
  "tha-ap356:1.3": "ekaṃsam ajinaṃ katvā ",
  "tha-ap356:1.4": "padaseyyam avandi 'haṃ. // // ",
  "tha-ap356:2.1": "Koraṇḍaṃ pupphitaṃ disvā ",
  "tha-ap356:2.2": "pādapaṃ dharaṇīruhaṃ / ",
  "tha-ap356:2.3": "sakoṭakaṃ gahetvāna ",
  "tha-ap356:2.4": "pade cakkam apūjayiṃ. // // ",
  "tha-ap356:3.1": "Ekatiṃse ito kappe ",
  "tha-ap356:3.2": "yaṃ kammam akariṃ tadā / ",
  "tha-ap356:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap356:3.4": "padapūjāy' idaṃ phalaṃ. // // ",
  "tha-ap356:4.1": "Paṭisambhidā . . . ",
  "tha-ap356:4.2": "pe . . . ",
  "tha-ap356:4.3": "pe . . . // // ",
  "tha-ap356:5.1": "Itthaṃ sudam āyasmā Sakoṭakakoraṇḍadāyako thero i. g. a-ti. Sakoṭakakoraṇḍadāyakattherassa ",
  "tha-ap356:6.1": "apadānaṃ samattaṃ. "
}
