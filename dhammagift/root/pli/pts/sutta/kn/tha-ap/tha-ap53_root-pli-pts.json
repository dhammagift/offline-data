  "tha-ap53:0.1": "",
  "tha-ap53:0.2": "",
  "tha-ap53:0.3": "",
  "tha-ap53:1.1": "Padumuttarabuddhassa ",
  "tha-ap53:1.2": "lokajeṭṭhassa tādino / ",
  "tha-ap53:1.3": "vījanikā mayā dinnā ",
  "tha-ap53:1.4": "dīpadindassa tādino. // // ",
  "tha-ap53:2.1": "Sakaṃ cittaṃ pasādetvā ",
  "tha-ap53:2.2": "pagga*hetvāna añjaliṃ / ",
  "tha-ap53:2.3": "sambuddhaṃ abhivādetvā* ",
  "tha-ap53:2.4": "pakkāmiṃ uttarāmukho. // // ",
  "tha-ap53:3.1": "Vījaniṃ paggahetvāna ",
  "tha-ap53:3.2": "satthā lokagganāyako / ",
  "tha-ap53:3.3": "bhikkhusaṅghe ṭhito santo ",
  "tha-ap53:3.4": "imā gāthā abhāsathā: // // ",
  "tha-ap53:4.1": "Iminā vījanīdānena ",
  "tha-ap53:4.2": "cittassa paṇidhīhi ca / ",
  "tha-ap53:4.3": "kappānaṃ satasahassaṃ ",
  "tha-ap53:4.4": "vini*pātaṃ na gacchati // // ",
  "tha-ap53:5.1": "Āraddhavi*riyo pahitatto ",
  "tha-ap53:5.2": "cetoguṇasamāhito / ",
  "tha-ap53:5.3": "jātiyā sattavasso 'haṃ ",
  "tha-ap53:5.4": "arahattam apāpuṇiṃ. // // ",
  "tha-ap53:6.1": "Saṭṭhikappasahassamhi ",
  "tha-ap53:6.2": "Vījamānasanāmakā / ",
  "tha-ap53:6.3": "solas' āsiṃsu rājāno ",
  "tha-ap53:6.4": "cakkavattī mahābalā. // // ",
  "tha-ap53:7.1": "Paṭisambhidā catasso ",
  "tha-ap53:7.2": "vimokhā pi ca aṭṭh' ime / ",
  "tha-ap53:7.3": "chaḷabhiññā sacchikatā ",
  "tha-ap53:7.4": "kataṃ Buddhassa sāsasanan ti. // // ",
  "tha-ap53:8.1": "Itthaṃ sudaṃ āyasmā Vidhūpanadāyako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap53:9.1": "Vidhūpanadāyakatherassa apadānaṃ samattaṃ. "
}
