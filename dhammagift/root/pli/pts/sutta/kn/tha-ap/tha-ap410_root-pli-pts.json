{
  "tha-ap410:0.1": "",
  "tha-ap410:0.2": "",
  "tha-ap410:0.3": "",
  "tha-ap410:1.1": "nāma ",
  "tha-ap410:1.2": "Ketumati-puruttame / ",
  "tha-ap410:1.3": "sūro vikkamasampanno ",
  "tha-ap410:1.4": "puram ajjhāvasī tadā. // // ",
  "tha-ap410:2.1": "Tassa rañño pamattassa ",
  "tha-ap410:2.2": "aṭaviyo samuṭṭhahuṃ / ",
  "tha-ap410:2.3": "ocarā tuṇḍikā c' eva ",
  "tha-ap410:2.4": "raṭṭhaṃ vidhaṃsayaṃ tadā. // // ",
  "tha-ap410:3.1": "Paccante kupite khippaṃ ",
  "tha-ap410:3.2": "sannipātes' arindamo / ",
  "tha-ap410:3.3": "bhaṭe c' eva balatthe ca ",
  "tha-ap410:3.4": "ariṃ niggāhayiṃ tadā. // // ",
  "tha-ap410:4.1": "Hatthārūḷhā anīkaṭṭhā ",
  "tha-ap410:4.2": "sūrā ca cammayodhino / ",
  "tha-ap410:4.3": "dhanuggahā ca uggā ca ",
  "tha-ap410:4.4": "sabbe sannipatuṃ tadā. // // ",
  "tha-ap410:5.1": "Āḷārikā kappakā ca ",
  "tha-ap410:5.2": "nhāpakā mālakārakā / ",
  "tha-ap410:5.3": "sūrā vijitasaṅgāmā ",
  "tha-ap410:5.4": "sabbe sannipatuṃ tadā. // // ",
  "tha-ap410:6.1": "Khaggahatthā ca purisā ",
  "tha-ap410:6.2": "cāpahatthā ca vammino / ",
  "tha-ap410:6.3": "luddā vijitasaṅgāmā ",
  "tha-ap410:6.4": "sabbe sannipatuṃ tadā. // // ",
  "tha-ap410:7.1": "Tidhāppabhinnā mātaṅgā ",
  "tha-ap410:7.2": "kuñjarā saṭṭhihāyanā / ",
  "tha-ap410:7.3": "suvaṇṇakacchālaṅkārā ",
  "tha-ap410:7.4": "sabbe sannipatuṃ tadā. // // ",
  "tha-ap410:8.1": "Khamā sītassa uṇhassa ",
  "tha-ap410:8.2": "ukkārūharaṇassa ca / ",
  "tha-ap410:8.3": "yodhājīvā katakammā ",
  "tha-ap410:8.4": "sabbe sannipatuṃ tadā. // // ",
  "tha-ap410:9.1": "Saṅkhasaddaṃ bherisaddaṃ ",
  "tha-ap410:9.2": "atho uddhavasaddakaṃ / ",
  "tha-ap410:9.3": "etehi te hāsayantā ",
  "tha-ap410:9.4": "sabbe sannipatuṃ tadā. // // ",
  "tha-ap410:10.1": "Tisūlakontimantehi ",
  "tha-ap410:10.2": "kavacatomarehi ca / ",
  "tha-ap410:10.3": "koṭṭentānaṃ nivattantā ",
  "tha-ap410:10.4": "sabbe sannipatuṃ tadā. // // ",
  "tha-ap410:11.1": "Kavacāni nivāsetvā ",
  "tha-ap410:11.2": "sarājā Ajitañjayo / saṭṭhiṃ ",
  "tha-ap410:11.3": "pāṇasahassāni ",
  "tha-ap410:11.4": "sūle uttāsayiṃ tadā. // // ",
  "tha-ap410:12.1": "Saddam amānus' ākāsuṃ ",
  "tha-ap410:12.2": "aho rājā adhammiko / ",
  "tha-ap410:12.3": "niraye paccamānassa ",
  "tha-ap410:12.4": "kadā anto bhavissati? // // ",
  "tha-ap410:13.1": "Sayane 'haṃ tuvaṭṭento ",
  "tha-ap410:13.2": "vasāmi niraye tadā / ",
  "tha-ap410:13.3": "na supāmi divā rattiṃ ",
  "tha-ap410:13.4": "sūlato tajjayanti maṃ. // // ",
  "tha-ap410:14.1": "Kiṃ pamādena rajjena ",
  "tha-ap410:14.2": "vahanena balena ca / ",
  "tha-ap410:14.3": "na te pahonti dhāretuṃ ",
  "tha-ap410:14.4": "tāsayanti mamaṃ sadā. // // ",
  "tha-ap410:15.1": "Kim me puttehi dārehi ",
  "tha-ap410:15.2": "rajjena sakalena ca / ",
  "tha-ap410:15.3": "yannūna pabbajeyy' āhaṃ ",
  "tha-ap410:15.4": "gatimaggaṃ visodhaye. // // ",
  "tha-ap410:16.1": "Saṭṭhināgasahassāni ",
  "tha-ap410:16.2": "sabbālaṅkārabhūsite / ",
  "tha-ap410:16.3": "suvaṇṇakacchāmātaṅge hemakappanivāsase // // ",
  "tha-ap410:16.4": "",
  "tha-ap410:17.1": "Ārūḷhe gāmanīyehi ",
  "tha-ap410:17.2": "tomaraṅkusapāṇihi / ",
  "tha-ap410:17.3": "saṅgāmāvacare heva ",
  "tha-ap410:17.4": "anapekho vihāy' ahaṃ. // // ",
  "tha-ap410:17.5": "Sakakammena santatto ",
  "tha-ap410:17.6": "nikkhamiṃ anagāriyaṃ / ",
  "tha-ap410:18.1": "saṭṭhiṃ assasahassāni ",
  "tha-ap410:18.2": "sabbālaṅkārabhūsite // // ",
  "tha-ap410:18.3": "Ājāniye va jātiyā ",
  "tha-ap410:18.4": "sindhave sīghavāhino / ",
  "tha-ap410:19.1": "ārūḷhe gāmanīyehi ",
  "tha-ap410:19.2": "cāpahatthehi vammihi // // ",
  "tha-ap410:19.3": "Pahāyitvāna te sabbe ",
  "tha-ap410:19.4": "nikkhamiṃ anagāriyaṃ / ",
  "tha-ap410:20.1": "saṭṭhiṃ rathasahassāni ",
  "tha-ap410:20.2": "sabbālaṅkārabhūsite // // ",
  "tha-ap410:20.3": "Dīpe atho pi veyyagghe ",
  "tha-ap410:20.4": "sannaddhe ussitaddhaje / ",
  "tha-ap410:20.5": "te sabbe parihāyitvā ",
  "tha-ap410:20.6": "pabbajim anagāriyaṃ. // // ",
  "tha-ap410:21.1": "Saṭṭhiṃ dhenusahassāni ",
  "tha-ap410:21.2": "sabbā kaṃsūpadhāraṇā / ",
  "tha-ap410:21.3": "tāyo pi chaḍḍayitvāna ",
  "tha-ap410:21.4": "pabbajim anagāriyaṃ. // // ",
  "tha-ap410:22.1": "Saṭṭhiṃ itthisahassāni ",
  "tha-ap410:22.2": "sabbālaṅkārabhūsitā / ",
  "tha-ap410:22.3": "vicittavatthābharaṇā ",
  "tha-ap410:22.4": "āmuttamaṇikuṇḍalā // // ",
  "tha-ap410:23.1": "Āḷārapamhā hasulā ",
  "tha-ap410:23.2": "susoññā tanumajjhimā / ",
  "tha-ap410:23.3": "tā hitvā kandamānāyo ",
  "tha-ap410:23.4": "pabbajim anagāriyaṃ. // // ",
  "tha-ap410:24.1": "Saṭṭhigāmasahassāni ",
  "tha-ap410:24.2": "paripuṇṇāni sabbaso / ",
  "tha-ap410:24.3": "chaḍḍayitvāna taṃ rajjaṃ ",
  "tha-ap410:24.4": "pabbajim anagāriyaṃ. // // ",
  "tha-ap410:25.1": "Nagarā nikkhamitvāna ",
  "tha-ap410:25.2": "Himavantam upāgamiṃ / ",
  "tha-ap410:25.3": "Bhāgīrasīnadītīre ",
  "tha-ap410:25.4": "assamaṃ māpayim ahaṃ. // // ",
  "tha-ap410:26.1": "Paṇṇasālaṃ karitvāna ",
  "tha-ap410:26.2": "agyāgāram akās' ahaṃ / ",
  "tha-ap410:26.3": "āraddhaviriyo pahitatto ",
  "tha-ap410:26.4": "vasāmi assame ahaṃ. // // ",
  "tha-ap410:27.1": "Maṇḍape rukkhamūle vā ",
  "tha-ap410:27.2": "suññāgāre va jhāyato / ",
  "tha-ap410:27.3": "na uppajjatha tāso me ",
  "tha-ap410:27.4": "na passe bhayabheravaṃ. // // ",
  "tha-ap410:28.1": "Sumedho nāma sambuddho ",
  "tha-ap410:28.2": "aggo kāruṇiko muni / ",
  "tha-ap410:28.3": "ñāṇālokena jotento ",
  "tha-ap410:28.4": "loke uppajji tāvade. // // ",
  "tha-ap410:29.1": "Mama assamasāmantā ",
  "tha-ap410:29.2": "yakkho āsi mahiddhiko / ",
  "tha-ap410:29.3": "Buddhaseṭṭhamhi uppanne ",
  "tha-ap410:29.4": "ārocesi mamaṃ tadā: // // ",
  "tha-ap410:30.1": "‘Buddho loke samuppanno ",
  "tha-ap410:30.2": "Sumedho nāma cakkhumā / ",
  "tha-ap410:30.3": "tāreti janataṃ sabbaṃ ",
  "tha-ap410:30.4": "tvam pi so tārayissati.' // // ",
  "tha-ap410:31.1": "Yakkhassa vacanaṃ sutvā ",
  "tha-ap410:31.2": "saṃviggo āsi tāvade / ",
  "tha-ap410:31.3": "Buddho *Buddho* ti cintento ",
  "tha-ap410:31.4": "assamaṃ paṭisāmayiṃ. // // ",
  "tha-ap410:32.1": "Aggidāruñ ca chaḍḍetvā ",
  "tha-ap410:32.2": "saṃsāmetvāna santhataṃ / ",
  "tha-ap410:32.3": "assamam abhivanditvā ",
  "tha-ap410:32.4": "nikkhamiṃ pavanā ahaṃ. // // ",
  "tha-ap410:33.1": "Tato candanam ādāya ",
  "tha-ap410:33.2": "gāmāgāmaṃ purāpuraṃ / ",
  "tha-ap410:33.3": "devadevaṃ gavesanto ",
  "tha-ap410:33.4": "upagacchiṃ vināyakaṃ. // // ",
  "tha-ap410:34.1": "Bhagavā tamhi samaye ",
  "tha-ap410:34.2": "Sumedho lokanāyako / ",
  "tha-ap410:34.3": "catusaccaṃ pakāsento ",
  "tha-ap410:34.4": "bodheti janataṃ tadā. // // ",
  "tha-ap410:35.1": "Añjaliṃ paggahetvāna ",
  "tha-ap410:35.2": "sīse katvāna candanaṃ / ",
  "tha-ap410:35.3": "sambuddham abhivādetvā ",
  "tha-ap410:35.4": "imā gāthā abbāsatha: // // ",
  "tha-ap410:36.1": "Vassike pupphamānamhi ",
  "tha-ap410:36.2": "santike upavāyati / ",
  "tha-ap410:36.3": "tvaṃ vīra guṇagandhena ",
  "tha-ap410:36.4": "disā sabbā pavāyasi. // // ",
  "tha-ap410:37.1": "Campake nāgavanike ",
  "tha-ap410:37.2": "atimuttakakeṭake / ",
  "tha-ap410:37.3": "sālesu pupphamānesu ",
  "tha-ap410:37.4": "anuvātaṃ pavāyati. // // ",
  "tha-ap410:38.1": "Tava gandhaṃ suṇitvāna ",
  "tha-ap410:38.2": "Himavantā idhāgamiṃ / ",
  "tha-ap410:38.3": "pūjemi taṃ mahāvīra ",
  "tha-ap410:38.4": "lokajeṭṭha mahāyasa. // // ",
  "tha-ap410:39.1": "Varacandanen' ānulimpiṃ ",
  "tha-ap410:39.2": "Sumedhaṃ lokanāyakaṃ / ",
  "tha-ap410:39.3": "sakaṃ cittaṃ pasādetvā ",
  "tha-ap410:39.4": "tuṇhi aṭṭhāsi tāvade. // // ",
  "tha-ap410:40.1": "Sumedho nāma bhagavā ",
  "tha-ap410:40.2": "lokajeṭṭho narāsabho / ",
  "tha-ap410:40.3": "bhikkhusaṅghe nisīditvā ",
  "tha-ap410:40.4": "imā gāthā abhāsatha: // // ",
  "tha-ap410:41.1": "‘Yo me guṇe pakittesi ",
  "tha-ap410:41.2": "candanañ ca apūjayi / ",
  "tha-ap410:41.3": "tam ahaṃ kittayissāmi ",
  "tha-ap410:41.4": "suṇotha mama bhāsato: // // ",
  "tha-ap410:42.1": "Ādeyyavākyavacano ",
  "tha-ap410:42.2": "brahmā ujupatāpavā / ",
  "tha-ap410:42.3": "pañcavīsatikappāni ",
  "tha-ap410:42.4": "sappabhāso bhavissati. // // ",
  "tha-ap410:43.1": "Chavīsatikappasate ",
  "tha-ap410:43.2": "devaloke ramissati / ",
  "tha-ap410:43.3": "sahassakkhattuṃ rājā ca ",
  "tha-ap410:43.4": "cakkavattī bhavissati. // // ",
  "tha-ap410:44.1": "Tettiṃsakkhattuṃ devindo ",
  "tha-ap410:44.2": "devarajjaṃ karissati / ",
  "tha-ap410:44.3": "padesarajjaṃ vipulaṃ ",
  "tha-ap410:44.4": "gananāto asaṅkhiyaṃ. // // ",
  "tha-ap410:45.1": "Tato cuto 'yaṃ manujo ",
  "tha-ap410:45.2": "manussattaṃ gamissati / ",
  "tha-ap410:45.3": "puññakammena saṃyutto ",
  "tha-ap410:45.4": "brahmabandhu bhavissati. // // ",
  "tha-ap410:46.1": "Ajjhāyako mantadharo ",
  "tha-ap410:46.2": "tiṇṇavedāna pāragū / ",
  "tha-ap410:46.3": "tīṇilakkhaṇasampanno ",
  "tha-ap410:46.4": "Bāvarī nāma brāhmaṇo. // // ",
  "tha-ap410:47.1": "Tassa sisso bhavitvāna ",
  "tha-ap410:47.2": "hessati mantapāragū / ",
  "tha-ap410:47.3": "upagantvāna sambuddhaṃ ",
  "tha-ap410:47.4": "Gotamaṃ Sakyapuṅgavaṃ // // ",
  "tha-ap410:48.1": "Pucchitvā nipuṇe pañhe ",
  "tha-ap410:48.2": "bhāvayitvāna añjasaṃ / ",
  "tha-ap410:48.3": "sabbāsave pariññāya ",
  "tha-ap410:48.4": "nibbāyissati 'nāsavo. // // ",
  "tha-ap410:49.1": "Tivaggī nibbutā mayhaṃ ",
  "tha-ap410:49.2": "bhavā sabbe samūhatā / ",
  "tha-ap410:49.3": "sabbāsave pariññāya ",
  "tha-ap410:49.4": "viharāmi anāsavo. // // ",
  "tha-ap410:50.1": "Kilesā . . . ",
  "tha-ap410:50.2": "pe . . . ",
  "tha-ap410:50.3": "",
  "tha-ap410:51.1": "",
  "tha-ap410:51.2": "pe . . . ",
  "tha-ap410:51.3": "pe . . . // // Sāgataṃ . . . pe . . . pe . . . pe . . . // // ",
  "tha-ap410:52.1": "Paṭisambhidā . . . ",
  "tha-ap410:52.2": "pe . . . ",
  "tha-ap410:52.3": "pe . . . // // ",
  "tha-ap410:53.1": "Itthaṃ sudaṃ āyasmā Todeyyo thero i. g. a-ti. Todeyyattherassa ",
  "tha-ap410:54.1": "apadānaṃ samattaṃ. "
}
