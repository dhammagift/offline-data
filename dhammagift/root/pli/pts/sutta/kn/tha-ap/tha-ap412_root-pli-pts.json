{
  "tha-ap412:0.1": "",
  "tha-ap412:0.2": "",
  "tha-ap412:0.3": "",
  "tha-ap412:1.1": "",
  "tha-ap412:1.2": "Padumo nāma pabbato / ",
  "tha-ap412:1.3": "assamo sukato mayhaṃ ",
  "tha-ap412:1.4": "paṇṇasālā sumāpitā. // // ",
  "tha-ap412:2.1": "Nadiyo sandare tattha ",
  "tha-ap412:2.2": "sūpatitthā manoramā / ",
  "tha-ap412:2.3": "acchodakā sītajalā ",
  "tha-ap412:2.4": "sundarī nadiyo sadā. // // ",
  "tha-ap412:3.1": "Pāṭhīnā pāvusā macchā ",
  "tha-ap412:3.2": "jalajā muñjarohitā / ",
  "tha-ap412:3.3": "sobhanti nadiyā ete ",
  "tha-ap412:3.4": "vahanti nadiyo tadā. // // ",
  "tha-ap412:4.1": "Ambajambūhi sañchannā ",
  "tha-ap412:4.2": "kareri-tilakā tathā / ",
  "tha-ap412:4.3": "uddālakā pāṭaliyo ",
  "tha-ap412:4.4": "sobhenti mama assamaṃ. // // ",
  "tha-ap412:5.1": "Ākolakā bimbijālā ",
  "tha-ap412:5.2": "māyācārā ca pupphitā / ",
  "tha-ap412:5.3": "gandhena upavāyantā ",
  "tha-ap412:5.4": "sobhenti mama assamaṃ. // // ",
  "tha-ap412:6.1": "'timuttakā sattalikā ",
  "tha-ap412:6.2": "nāgāsālā ca pupphitā / ",
  "tha-ap412:6.3": "dibbagandhasampannā ",
  "tha-ap412:6.4": "sobhenti mama assamaṃ. // // ",
  "tha-ap412:7.1": "Kosumbhā saḷalā nīpā ",
  "tha-ap412:7.2": "kaṭṭhaṅgā ca supupphitā / dibbā ",
  "tha-ap412:7.3": "gandhā sampavantā ",
  "tha-ap412:7.4": "sobhenti mama assamaṃ. // // ",
  "tha-ap412:8.1": "Harītakā āmalakā ",
  "tha-ap412:8.2": "ambā jambū vibhīṭakā / ",
  "tha-ap412:8.3": "kolā bhallātakā bellā ",
  "tha-ap412:8.4": "phalāni bahū assame. // // ",
  "tha-ap412:9.1": "Kadambā kadalī tattha ",
  "tha-ap412:9.2": "pupphanti mama assame / ",
  "tha-ap412:9.3": "dibbā gandhā sampavantā ",
  "tha-ap412:9.4": "sobhenti mama assamaṃ. // // ",
  "tha-ap412:10.1": "Asokapiṇḍī ca ",
  "tha-ap412:10.2": "vārī nīparukkhā ca pupphitā / ",
  "tha-ap412:10.3": "dibbā gandhā sampavantā ",
  "tha-ap412:10.4": "sobhenti mama assamaṃ. // // ",
  "tha-ap412:11.1": "Punnāgā giripunnāgā ",
  "tha-ap412:11.2": "timirā tatthā pupphitā / ",
  "tha-ap412:11.3": "dibbā gandhā sampavantā ",
  "tha-ap412:11.4": "sobhenti mama assamaṃ. // // ",
  "tha-ap412:12.1": "Nigguṇḍī sirinigguṇḍī ",
  "tha-ap412:12.2": "camparukkh' ettha pupphitā / ",
  "tha-ap412:12.3": "dibbā . . . pe . . . ",
  "tha-ap412:12.4": "pe . . . pe . . . // // ",
  "tha-ap412:13.1": "Avidūre pokkharaṇī ",
  "tha-ap412:13.2": "cakkavākapakūjitā / ",
  "tha-ap412:13.3": "mandālake*hi* sañchannā ",
  "tha-ap412:13.4": "padumupphalakehi ca. // // ",
  "tha-ap412:14.1": "Acchodakā sītajalā ",
  "tha-ap412:14.2": "supatitthā manoramā / ",
  "tha-ap412:14.3": "acchā phalikasamānā ",
  "tha-ap412:14.4": "sobhenti mama assamaṃ. // // ",
  "tha-ap412:15.1": "Padumā pupphare tattha ",
  "tha-ap412:15.2": "puṇḍarīkā ca uppalā / ",
  "tha-ap412:15.3": "mandālakehi sañchannā ",
  "tha-ap412:15.4": "sobhenti mama assamaṃ. // // ",
  "tha-ap412:16.1": "Pāṭhīṇā pāvusā macchā ",
  "tha-ap412:16.2": "jalajā muñjarohitā / ",
  "tha-ap412:16.3": "vicarantā 'va te tattha ",
  "tha-ap412:16.4": "sobhenti mama assamaṃ. // // ",
  "tha-ap412:17.1": "Kumbhīlā suṃsumārā ca ",
  "tha-ap412:17.2": "kacchapā ca gahā bahū / ",
  "tha-ap412:17.3": "oguhā ajagarā 'va ",
  "tha-ap412:17.4": "sobhenti mama assamaṃ. // // ",
  "tha-ap412:18.1": "Pārevaṭā ravihaṃsā ",
  "tha-ap412:18.2": "cakkavākā nadīcarā / ",
  "tha-ap412:18.3": "dindibhā sālikā c' ettha ",
  "tha-ap412:18.4": "sobhenti mama assamaṃ. // // ",
  "tha-ap412:19.1": "Nayitā ambagandhī ca ",
  "tha-ap412:19.2": "ketakā tattha pupphitā / ",
  "tha-ap412:19.3": "dibbā gandhā sampavantā ",
  "tha-ap412:19.4": "sobhenti mama assamaṃ. // // ",
  "tha-ap412:20.1": "Sīhā vyagghā ca dīpī ca ",
  "tha-ap412:20.2": "acchakokataracchayo / ",
  "tha-ap412:20.3": "anusañcarantā pavane ",
  "tha-ap412:20.4": "sobhenti mama assamaṃ. // // ",
  "tha-ap412:21.1": "Te jaṭābhārabharitā ",
  "tha-ap412:21.2": "ajinuttaravāsino / ",
  "tha-ap412:21.3": "anusañcarantā pavane ",
  "tha-ap412:21.4": "sobhenti mama assamaṃ. // // ",
  "tha-ap412:22.1": "Ajināni dharā ete ",
  "tha-ap412:22.2": "nipakā santavuttino / ",
  "tha-ap412:22.3": "appāhārā ca te sabbe ",
  "tha-ap412:22.4": "sobhenti mama assamaṃ. // // ",
  "tha-ap412:23.1": "Khāribhāriṃ gahetvāna ",
  "tha-ap412:23.2": "ajjhogayha vanan tadā / ",
  "tha-ap412:23.3": "mūlaphalāni bhuñjantā ",
  "tha-ap412:23.4": "vasante assame tadā. // // ",
  "tha-ap412:24.1": "Na te dārum āharanti ",
  "tha-ap412:24.2": "udakaṃ vā pādadhovanaṃ / ",
  "tha-ap412:24.3": "sabbesam ānubhāvena ",
  "tha-ap412:24.4": "sayam evāhariyyati. // // ",
  "tha-ap412:25.1": "Cullāsītisahassāni ",
  "tha-ap412:25.2": "isayo tattha samāgatā / ",
  "tha-ap412:25.3": "sabbe ca jhāyino ete ",
  "tha-ap412:25.4": "uttamatthaṃ gavesakā. // // ",
  "tha-ap412:26.1": "Tapassino brahmacārī ",
  "tha-ap412:26.2": "coditā appanāvate / ",
  "tha-ap412:26.3": "ambarāvacarā sabbe ",
  "tha-ap412:26.4": "vasante assame tadā. // // ",
  "tha-ap412:27.1": "Pañcāhaṃ sannipatanti ",
  "tha-ap412:27.2": "ekaggā santavuttino / ",
  "tha-ap412:27.3": "aññoññam abhivādetvā ",
  "tha-ap412:27.4": "pakkamanti disāmukhā. // // ",
  "tha-ap412:28.1": "Padumuttaro nāma jino ",
  "tha-ap412:28.2": "sabbadhammāna pāragū / ",
  "tha-ap412:28.3": "tam andhakāraṃ vidhamaṃ ",
  "tha-ap412:28.4": "uppajji tāvade jino. // // ",
  "tha-ap412:29.1": "Mama assamasāmantā ",
  "tha-ap412:29.2": "yakkho āsi mahiddhiko / ",
  "tha-ap412:29.3": "so me pasaṃsi sambuddhaṃ ",
  "tha-ap412:29.4": "jalajuttamanāyakaṃ: // // ",
  "tha-ap412:30.1": "‘Esa Buddho samuppanno ",
  "tha-ap412:30.2": "Padumuttaro mahāmuni / ",
  "tha-ap412:30.3": "khippaṃ gantvāna sambuddhaṃ ",
  "tha-ap412:30.4": "payirupāsassu tam muni.' // // ",
  "tha-ap412:31.1": "Yakkhassa vacanaṃ sutvā ",
  "tha-ap412:31.2": "vippasannena cetasā / ",
  "tha-ap412:31.3": "assamaṃ saṃsāmetvāna ",
  "tha-ap412:31.4": "nikkhamiṃ pavanā tadā. // // ",
  "tha-ap412:32.1": "Cele va ḍayhamānamhi ",
  "tha-ap412:32.2": "nikkhamitvāna assamā / ",
  "tha-ap412:32.3": "ekarattiṃ nivāsetvā ",
  "tha-ap412:32.4": "upagacchiṃ vināyakaṃ. // // ",
  "tha-ap412:33.1": "Padumuttaro lokavidū ",
  "tha-ap412:33.2": "āhutīnaṃ paṭiggaho / ",
  "tha-ap412:33.3": "catusaccaṃ pakāsento ",
  "tha-ap412:33.4": "deseti amataṃ padaṃ. // // ",
  "tha-ap412:34.1": "Suphullapadumaṃ gayha ",
  "tha-ap412:34.2": "upagantvā mahesino / ",
  "tha-ap412:34.3": "pasannacitto sumano ",
  "tha-ap412:34.4": "Buddhassa abhiropayiṃ. // // ",
  "tha-ap412:35.1": "Pūjayitvāna sambuddhaṃ ",
  "tha-ap412:35.2": "jalajuttamanāyakaṃ / ",
  "tha-ap412:35.3": "ekaṃsaṃ ajinaṃ katvā ",
  "tha-ap412:35.4": "santhaviṃ lokanāyakaṃ. // // ",
  "tha-ap412:36.1": "Yena ñāṇena sambuddho ",
  "tha-ap412:36.2": "vasatīha anāsavo / ",
  "tha-ap412:36.3": "taṃ ñāṇaṃ kittayissāmi; ",
  "tha-ap412:36.4": "suṇotha mama bhasato: // // ",
  "tha-ap412:37.1": "Saṃsārasotaṃ chinditvā ",
  "tha-ap412:37.2": "tāresi sabbapāṇinaṃ / ",
  "tha-ap412:37.3": "tava dhammaṃ suṇitvāna ",
  "tha-ap412:37.4": "taṇhāsotaṃ taranti te. // // ",
  "tha-ap412:38.1": "Tuvaṃ satthā ca ketu cca ",
  "tha-ap412:38.2": "dhajo yūpo ca pāṇinaṃ / ",
  "tha-ap412:38.3": "parāyaṇo patiṭṭhā ca ",
  "tha-ap412:38.4": "dīpo ca dipaduttama. // // ",
  "tha-ap412:39.1": "Yāvatā gaṇino loke ",
  "tha-ap412:39.2": "satthavāhā pavuccare / ",
  "tha-ap412:39.3": "tuvaṃ aggo 'si sappañño ",
  "tha-ap412:39.4": "tava antogadhā va te. // // ",
  "tha-ap412:40.1": "Tava ñāṇena sappañño ",
  "tha-ap412:40.2": "tāresi janataṃ bahuṃ / ",
  "tha-ap412:40.3": "tava dassanam āgamma ",
  "tha-ap412:40.4": "dukkhass' antaṃ karissare. // // ",
  "tha-ap412:41.1": "Ye kec' ime gandhajātā ",
  "tha-ap412:41.2": "loke vāyanti cakkhumā / ",
  "tha-ap412:41.3": "tava gandhasamo n' atthi ",
  "tha-ap412:41.4": "puññakkhette mahāmune. // // ",
  "tha-ap412:42.1": "Tiracchayoniṃ nirayaṃ ",
  "tha-ap412:42.2": "parimocesi cakkhumā / ",
  "tha-ap412:42.3": "asaṅkhataṃ padaṃ santaṃ ",
  "tha-ap412:42.4": "desesi tvaṃ mahāmune. // // ",
  "tha-ap412:43.1": "Padumuttaro lokavidū ",
  "tha-ap412:43.2": "āhutīnaṃ paṭiggaho / ",
  "tha-ap412:43.3": "bhikkhusaṅghe nisīditvā ",
  "tha-ap412:43.4": "imā gāthā abhāsatha: // // ",
  "tha-ap412:44.1": "Yo me ñāṇam apūjesi ",
  "tha-ap412:44.2": "pasanno sehi pāṇihi / ",
  "tha-ap412:44.3": "tam ahaṃ kittayissāmi; ",
  "tha-ap412:44.4": "suṇotha mama bhāsato: // // ",
  "tha-ap412:45.1": "Tiṃsakappasahassāni ",
  "tha-ap412:45.2": "devaloke ramissati / ",
  "tha-ap412:45.3": "sahassakkhattuṃ rājā ca ",
  "tha-ap412:45.4": "cakkavattī bhavissati. // // ",
  "tha-ap412:46.1": "Suladdhalābhaṃ laddho 'mhi ",
  "tha-ap412:46.2": "tosayitvāna subbataṃ / ",
  "tha-ap412:46.3": "sabbāsave pariññāya ",
  "tha-ap412:46.4": "viharāmi anāsavo. // // ",
  "tha-ap412:47.1": "Kilesā . . . ",
  "tha-ap412:47.2": "pe . . . ",
  "tha-ap412:47.3": "",
  "tha-ap412:48.1": "",
  "tha-ap412:48.2": "pe . . . // // ",
  "tha-ap412:48.3": "Sāgataṃ . . . pe . . . pe . . . // // ",
  "tha-ap412:49.1": "Paṭisambhidā . . . ",
  "tha-ap412:49.2": "pe . . . ",
  "tha-ap412:49.3": "pe . . . // // ",
  "tha-ap412:50.1": "Itthaṃ sudam āyasmā Udeno thero i. g. a- ti. Udenattherassa ",
  "tha-ap412:51.1": "",
  "tha-ap412:52.1": "apadānaṃ samattaṃ. ",
  "tha-ap412:53.1": "Udānaṃ: ",
  "tha-ap412:54.1": "Metteyyo Puṇṇako thero ",
  "tha-ap412:54.2": "Mettagū Dhovako pi ca ",
  "tha-ap412:54.3": "Upasīvo ca Nando ca ",
  "tha-ap412:54.4": "Hemako sattamo tahiṃ. ",
  "tha-ap412:55.1": "Todeyyo Jatukaṇṇī ca ",
  "tha-ap412:55.2": "Udeno ca mahāyaso ",
  "tha-ap412:55.3": "tīṇi gāthā satān' ettha ",
  "tha-ap412:55.4": "asīti tīṇi c' uttariṃ. "
}
