  "tha-ap357:1.1": "Kānanaṃ vanam oggayha ",
  "tha-ap357:1.2": "veluṃ chetvān' ahaṃ tadā / ",
  "tha-ap357:1.3": "ālambanaṃ gahetvāna ",
  "tha-ap357:1.4": "saṅghassa adadam ahaṃ. // // ",
  "tha-ap357:2.1": "Tena cittappasādena ",
  "tha-ap357:2.2": "‘sukhan te' abhivādiya / ",
  "tha-ap357:2.3": "ālambanam pi datvāna ",
  "tha-ap357:2.4": "pakkāmiṃ uttarāmukho. // // ",
  "tha-ap357:3.1": "Catunavute ito kappe ",
  "tha-ap357:3.2": "yaṃ daṇḍam adadiṃ tadā / ",
  "tha-ap357:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap357:3.4": "daṇḍadānass' idaṃ phalaṃ. // // ",
  "tha-ap357:4.1": "Paṭisambhidā . . . ",
  "tha-ap357:4.2": "pe . . . ",
  "tha-ap357:4.3": "pe . . . // // ",
  "tha-ap357:5.1": "Itthaṃ sudam āyasmā Daṇḍadāyako thero i. g. a-ti. Daṇḍadāyakattherassa apadānaṃ samattaṃ. ",
  "tha-ap357:6.1": ""
}
