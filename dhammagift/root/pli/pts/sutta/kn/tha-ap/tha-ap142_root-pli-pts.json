{
  "tha-ap142:0.1": "",
  "tha-ap142:0.2": "",
  "tha-ap142:0.3": "",
  "tha-ap142:1.1": "tadā āsiṃ ",
  "tha-ap142:1.2": "paramānuparodhako / ",
  "tha-ap142:1.3": "pabbhāre seyyaṃ kappemi ",
  "tha-ap142:1.4": "avidūre Sikhisatthuno. // // ",
  "tha-ap142:2.1": "Sāyaṃ pātañ ca passāmi ",
  "tha-ap142:2.2": "Buddhaṃ lokagganāyakaṃ / ",
  "tha-ap142:2.3": "deyyadhammo ca me n' atthi ",
  "tha-ap142:2.4": "dipadindassa tādino. // // ",
  "tha-ap142:3.1": "Piyālaphalam ādāya ",
  "tha-ap142:3.2": "agamaṃ Buddhasantikaṃ / ",
  "tha-ap142:3.3": "paṭiggahesi bhagavā ",
  "tha-ap142:3.4": "lokajeṭṭho narāsabho. // // ",
  "tha-ap142:4.1": "Tato paraṃ upādāya ",
  "tha-ap142:4.2": "parivāriṃ vināyakaṃ / ",
  "tha-ap142:4.3": "ten cittappasādena ",
  "tha-ap142:4.4": "tattha kālakato ahaṃ. // // ",
  "tha-ap142:5.1": "Ekatiṃse ito kappe ",
  "tha-ap142:5.2": "yaṃ phalaṃ adadiṃ ahaṃ / ",
  "tha-ap142:5.3": "duggatiṃ nābhijānāmi ",
  "tha-ap142:5.4": "phaladānass' idaṃ phalaṃ. // // ",
  "tha-ap142:6.1": "Ito pannarase kappe ",
  "tha-ap142:6.2": "tayo āsiṃsu Mālabhi / ",
  "tha-ap142:6.3": "sattaratanasampannā ",
  "tha-ap142:6.4": "cakkavattī mahābalā // // ",
  "tha-ap142:7.1": "Paṭisambhidā . . . ",
  "tha-ap142:7.2": "pe . . . ",
  "tha-ap142:7.3": "pe . . . // // ",
  "tha-ap142:8.1": "Itthaṃ sudaṃ āyasmā Phaladāyako thero i. g. a-ti. Phaladāyakattherassa apadānaṃ samattaṃ. Uddānaṃ: Sobhi- ",
  "tha-ap142:9.1": "",
  "tha-ap142:10.1": "",
  "tha-ap142:11.1": "Sudassano ",
  "tha-ap142:12.1": "c' eva ",
  "tha-ap142:12.2": "Candano Pupphachadano ",
  "tha-ap142:12.3": "Raho-Campakapupphī ca ",
  "tha-ap142:12.4": "Atthasandassakena ca ",
  "tha-ap142:13.1": "Ekadussi Sāladado ",
  "tha-ap142:13.2": "dasamo Phaladāyako ",
  "tha-ap142:13.3": "gāṇitāyo sattatiṃ dve ca ",
  "tha-ap142:13.4": "ganitāyo vibhāvihi. "
}
