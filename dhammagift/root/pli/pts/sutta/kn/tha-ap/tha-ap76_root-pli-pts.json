  "tha-ap76:0.1": "",
  "tha-ap76:0.2": "",
  "tha-ap76:0.3": "",
  "tha-ap76:1.1": "Kānanaṃ vanam oggayha ",
  "tha-ap76:1.2": "vasāmi vivane ahaṃ / ",
  "tha-ap76:1.3": "Vipassim addasaṃ Buddhaṃ ",
  "tha-ap76:1.4": "āhutīnaṃ paṭiggahaṃ. // // ",
  "tha-ap76:2.1": "Bhisāluvañ ca pādāsim ",
  "tha-ap76:2.2": "udakaṃ hatthadhovanaṃ / ",
  "tha-ap76:2.3": "vanditvā sirasā pāde ",
  "tha-ap76:2.4": "pakkāmi uttarāmukho. // // ",
  "tha-ap76:3.1": "Ekanavute ito kappe ",
  "tha-ap76:3.2": "bhisāluvam adaṃ tadā / ",
  "tha-ap76:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap76:3.4": "puññakammass' idaṃ phalaṃ. // // ",
  "tha-ap76:4.1": "Ito tatiyake kappe ",
  "tha-ap76:4.2": "Bhisasammata-khattiyo / ",
  "tha-ap76:4.3": "sattaratanasampanno ",
  "tha-ap76:4.4": "cakkavatti mahabbalo. // // ",
  "tha-ap76:5.1": "Paṭisambhidā catasso ",
  "tha-ap76:5.2": "vimokhā pi ca aṭṭh' ime / chaḍabhiññā sacchikatā ",
  "tha-ap76:5.3": "kataṃ Buddhassa sāsanan ti. // // ",
  "tha-ap76:6.1": "Itthaṃ sudaṃ āyasmā Bhisāluvadāyako thero imā gāthāyo abhāsitthā ti. ",
  "tha-ap76:7.1": "Bhisāluvadāyakatherassa apadānaṃ ",
  "tha-ap76:7.2": "samattaṃ. "
}
