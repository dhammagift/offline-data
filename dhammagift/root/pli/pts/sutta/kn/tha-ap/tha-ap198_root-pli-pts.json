  "tha-ap198:0.3": "",
  "tha-ap198:1.1": "Nagare Dvāravatiyā ",
  "tha-ap198:1.2": "mālāgaccho mamam ahu / ",
  "tha-ap198:1.3": "udapāno ca tatth' eva ",
  "tha-ap198:1.4": "pādapāna virohano // // ",
  "tha-ap198:2.1": "Sabalena upatthaddho ",
  "tha-ap198:2.2": "Siddhattho aparājito / ",
  "tha-ap198:2.3": "mam ānukampamāno so ",
  "tha-ap198:2.4": "gacchate anilañjase. // // ",
  "tha-ap198:3.1": "Aññaṃ kiñci no passāmi ",
  "tha-ap198:3.2": "pūjayoggaṃ mahesino / ",
  "tha-ap198:3.3": "asokapallavaṃ disvā ",
  "tha-ap198:3.4": "ākāse ukkhipim ahaṃ. // // ",
  "tha-ap198:4.1": "Buddhassa te kisalayā ",
  "tha-ap198:4.2": "gacchato yanti pacchato / ",
  "tha-ap198:4.3": "so' haṃ disvāna tam iddhiṃ ",
  "tha-ap198:4.4": "aho Buddhassa pūjakā. // // ",
  "tha-ap198:5.1": "Catunavute ito kappe ",
  "tha-ap198:5.2": "pallavam abhiropayiṃ / ",
  "tha-ap198:5.3": "duggatiṃ nābhijānāmi ",
  "tha-ap198:5.4": "Buddhapūjāy' idaṃ phalaṃ. // // ",
  "tha-ap198:6.1": "Sattavīse ito kappe ",
  "tha-ap198:6.2": "eko Ekassaro ahu / ",
  "tha-ap198:6.3": "sattaratanasampanno ",
  "tha-ap198:6.4": "cakkavattī mahabbalo. // // ",
  "tha-ap198:7.1": "Paṭisambhidā . . . ",
  "tha-ap198:7.2": "pe . . . ",
  "tha-ap198:7.3": "pe . . . // // ",
  "tha-ap198:8.1": "Itthaṃ sudam āyasmā Kisalayapūjako thero i. g. a-ti. Kisalayapūjakattherassa apadānaṃ samattaṃ. Giriduggañ caro ",
  "tha-ap198:9.1": ""
}
