  "tha-ap147:1.1": "Nibbute Lokamahite ",
  "tha-ap147:1.2": "āhutīnaṃ paṭiggahe / ",
  "tha-ap147:1.3": "Siddhatthamhi bhagavati ",
  "tha-ap147:1.4": "mahāthūpamaho ahu. // // ",
  "tha-ap147:2.1": "Mahe pavattamānamhi ",
  "tha-ap147:2.2": "Siddhatthassa mahesino / ",
  "tha-ap147:2.3": "ummāpupphaṃ gahetvāna ",
  "tha-ap147:2.4": "thūpamhi abhiropayiṃ. // // ",
  "tha-ap147:3.1": "Catunavute ito kappe ",
  "tha-ap147:3.2": "yaṃ puppham abhiropayiṃ / ",
  "tha-ap147:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap147:3.4": "thūpapūjāy' idaṃ phalaṃ. // // ",
  "tha-ap147:4.1": "Ito ca navame kappe ",
  "tha-ap147:4.2": "Somadeva-sanāmakā / pañcāsītiṃ ",
  "tha-ap147:4.3": "'su rājāno ",
  "tha-ap147:4.4": "cakkavattī mahābalā. // // ",
  "tha-ap147:5.1": "Paṭisambhidā . . . ",
  "tha-ap147:5.2": "pe . . . ",
  "tha-ap147:5.3": "pe . . . // // ",
  "tha-ap147:6.1": "Itthaṃ sudaṃ ā. Ummāpupphiyo thero i. g. a-ti. Ummāpupphiyattherassa apadānaṃ samattaṃ. Anomadassissa munino bodhivedim akās' ahaṃ / ",
  "tha-ap147:7.1": ""
}
