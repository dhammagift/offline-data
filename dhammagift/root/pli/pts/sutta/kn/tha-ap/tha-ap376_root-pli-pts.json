  "tha-ap376:0.3": "",
  "tha-ap376:1.1": "Yadā nibbāyi sambuddho ",
  "tha-ap376:1.2": "mahesi Padumuttaro / ",
  "tha-ap376:1.3": "samāgamma janā sabbe ",
  "tha-ap376:1.4": "sarīraṃ nīharanti te. // // ",
  "tha-ap376:2.1": "Nīharante sarīramhi ",
  "tha-ap376:2.2": "vajjamānāsu bherisu / ",
  "tha-ap376:2.3": "pasannacitto sumano ",
  "tha-ap376:2.4": "pattipuppham apūjayiṃ. // // ",
  "tha-ap376:3.1": "Satasahasse ito kappe ",
  "tha-ap376:3.2": "yaṃ puppham abhipūjayiṃ / ",
  "tha-ap376:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap376:3.4": "sarīre pūjite phalaṃ. // // ",
  "tha-ap376:4.1": "Sāgataṃ vata me āsi Buddhaseṭṭhassa santike / Tisso vijjā anuppatto kataṃ Buddhassasāsanaṃ. // // Kilesā jhāpitā mayhaṃ ",
  "tha-ap376:4.2": "bhavā sabbe samūhatā / ",
  "tha-ap376:4.3": "nāgo va bandhanaṃ chetvā ",
  "tha-ap376:4.4": "viharāmi anāsavo. // // ",
  "tha-ap376:5.1": "",
  "tha-ap376:5.2": "",
  "tha-ap376:5.3": "",
  "tha-ap376:5.4": "",
  "tha-ap376:6.1": "Paṭisambhidā . . . ",
  "tha-ap376:6.2": "pe . . . ",
  "tha-ap376:6.3": "pe . . . // // ",
  "tha-ap376:7.1": "Itthaṃ sudam āyasmā Pattipupphiyo thero i. g. a-ti. Pattipupphiyattherassa apadānaṃ samattaṃ. ",
  "tha-ap376:8.1": ""
}
