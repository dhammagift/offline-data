  "tha-ap48:0.3": "",
  "tha-ap48:1.1": "Nibbute lokanāthamhi ",
  "tha-ap48:1.2": "Vipassimh' aggapuggale / suphullaṃ ",
  "tha-ap48:1.3": "padumaṃ gayha ",
  "tha-ap48:1.4": "citam āropayiṃ ahaṃ. // // ",
  "tha-ap48:2.1": "Āropite ca citake ",
  "tha-ap48:2.2": "vehasan nabham ",
  "tha-ap48:2.3": "uggamiṃ / ākāsacchadanaṃ katvā ",
  "tha-ap48:2.4": "citakamhi adhārayiṃ. // // Ekanavute ",
  "tha-ap48:3.1": "ito kappe ",
  "tha-ap48:3.2": "yaṃ puppham abhiropayiṃ / ",
  "tha-ap48:3.3": "duggatiṃ nābhijānāni ",
  "tha-ap48:3.4": "Buddhapūjāy' idaṃ phalaṃ. // // ",
  "tha-ap48:4.1": "Sattatālīs' ito kappe ",
  "tha-ap48:4.2": "Padumissaranāmako / ",
  "tha-ap48:4.3": "cāturanto vijitāvī ",
  "tha-ap48:4.4": "cakkavattī mahabbalo. // // ",
  "tha-ap48:5.1": "Paṭisambhidā catasso ",
  "tha-ap48:5.2": "vimokhā pi ca aṭṭh ime / chaḷabhiññā sacchikatā ",
  "tha-ap48:5.3": "kataṃ Buddhassa sāsanan ti. // // ",
  "tha-ap48:6.1": "Itthaṃ sudaṃ āyasmā Padumacchadaniyo thero imā gāthāyo abhāsitthā ti. Padumacchadaniyatherassa apadānaṃ samattaṃ. ",
  "tha-ap48:7.1": ""
}
