  "tha-ap352:0.3": "",
  "tha-ap352:1.1": "Romaso nāma sambuddho ",
  "tha-ap352:1.2": "nadīkūle vasī tadā / ",
  "tha-ap352:1.3": "addasaṃ virajaṃ Buddhaṃ ",
  "tha-ap352:1.4": "vītaraṃsīva bhāṇumaṃ // // ",
  "tha-ap352:2.1": "Ukkāmukhaṃ pahaṭaṃ va ",
  "tha-ap352:2.2": "khadiraṅgārasannibhaṃ / ",
  "tha-ap352:2.3": "osadhī viya rocantam ",
  "tha-ap352:2.4": "ekañja*lim* akās' ahaṃ. // // Catunavute ",
  "tha-ap352:3.1": "ito kappe ",
  "tha-ap352:3.2": "yam añjalim akās' ahaṃ / ",
  "tha-ap352:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap352:3.4": "añjaliyā idaṃ phalaṃ. // // ",
  "tha-ap352:4.1": "Paṭisambhidā . . . ",
  "tha-ap352:4.2": "pe . . . ",
  "tha-ap352:4.3": "pe . . . // // ",
  "tha-ap352:5.1": "Itthaṃ sudam āyasmā Ekañjaliyo thero i. g. a-ti. Ekañjaliyattherassa apadānaṃ ",
  "tha-ap352:6.1": "",
  "tha-ap352:7.1": "samattaṃ. Uddānaṃ: ",
  "tha-ap352:8.1": "Padum' ",
  "tha-ap352:9.1": "Uppalahatthā ti ",
  "tha-ap352:9.2": "Dhajo Kiṅkhaṇiko Nalo ",
  "tha-ap352:9.3": "Campako Paduma-Muṭṭhī ",
  "tha-ap352:9.4": "Tinduk' Ekañjalī tathā ",
  "tha-ap352:9.5": "cha ca saṭṭhi ca gāthāyo ",
  "tha-ap352:9.6": "gaṇitāyo vibhāvihi. "
}
