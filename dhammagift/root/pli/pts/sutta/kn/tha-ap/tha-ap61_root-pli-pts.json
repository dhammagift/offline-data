  "tha-ap61:0.1": "",
  "tha-ap61:0.2": "",
  "tha-ap61:0.3": "",
  "tha-ap61:1.1": "Catusaccaṃ pakāse*nto ",
  "tha-ap61:1.2": "varadhammacakka*pavattako / ",
  "tha-ap61:1.3": "vassate amataṃ vuṭṭhiṃ ",
  "tha-ap61:1.4": "nibbāpento mahājanaṃ. // // ",
  "tha-ap61:2.1": "Sadhajaṃ padumaṃ gayha ",
  "tha-ap61:2.2": "aḍḍhakose ṭṭhito ahaṃ / ",
  "tha-ap61:2.3": "Padumuttaramunissa ",
  "tha-ap61:2.4": "haṭṭho ukkhi*pim ambare.* // // ",
  "tha-ap61:3.1": "Āgacchante ca padume ",
  "tha-ap61:3.2": "abbhūto āsi *tāvade* / ",
  "tha-ap61:3.3": "mama saṅkappam aññāya ",
  "tha-ap61:3.4": "paggaṇhi vadataṃ varo. // // ",
  "tha-ap61:4.1": "Karaseṭṭhena paggayha ",
  "tha-ap61:4.2": "jalajaṃ puppham uttamaṃ / ",
  "tha-ap61:4.3": "bhikkhusaṅghe ṭhito satthā ",
  "tha-ap61:4.4": "imā gāthā abhāsatha: // // ",
  "tha-ap61:5.1": "Yen' idaṃ padumaṃ khittaṃ ",
  "tha-ap61:5.2": "sabbaññuta-m-anāsave / ",
  "tha-ap61:5.3": "*tam ahaṃ kit*tayissāmi; ",
  "tha-ap61:5.4": "suṇotha mama bhāsato: // // ",
  "tha-ap61:6.1": "Tiṃsakappāni devindo ",
  "tha-ap61:6.2": "devarajjaṃ karissati / ",
  "tha-ap61:6.3": "paṭhavyā rajjaṃ sattasataṃ ",
  "tha-ap61:6.4": "vasudhaṃ āvasissati. // // ",
  "tha-ap61:7.1": "Tattha pattaṃ gahetvāna ",
  "tha-ap61:7.2": "cakkavatti bhavissati / ",
  "tha-ap61:7.3": "ākāsato pupphavuṭṭhi ",
  "tha-ap61:7.4": "abhivassissati tadā. // // ",
  "tha-ap61:8.1": "Kappasatasahassamhi ",
  "tha-ap61:8.2": "Okkākakulasambhavo / ",
  "tha-ap61:8.3": "Gotamo nāma nāmena ",
  "tha-ap61:8.4": "satthā loke bhavissati. // // ",
  "tha-ap61:9.1": "Tassa dhammesu dāyādo ",
  "tha-ap61:9.2": "oraso *dhammani*mmito / ",
  "tha-ap61:9.3": "sabbāsave pariññāya ",
  "tha-ap61:9.4": "nibbāyissat' anāsavo. // // ",
  "tha-ap61:10.1": "Nikkhamitvāna kucchimhā ",
  "tha-ap61:10.2": "sampajāno patissato / ",
  "tha-ap61:10.3": "jātiyā pañcavasso 'haṃ ",
  "tha-ap61:10.4": "arahattaṃ apāpuṇiṃ. // // ",
  "tha-ap61:11.1": "Paṭisambhidā catasso ",
  "tha-ap61:11.2": "vimokhā pi ca aṭṭh' ime / chaḷabhiññā sacchikatā ",
  "tha-ap61:11.3": "kataṃ Buddhassa sāsanan ti. // // ",
  "tha-ap61:12.1": "Itthaṃ sudaṃ āyasmā Padumo thero imā gāthāyo abhā- sitthā ti. Padumattherassa apadānaṃ samattaṃ. ",
  "tha-ap61:13.1": ""
}
