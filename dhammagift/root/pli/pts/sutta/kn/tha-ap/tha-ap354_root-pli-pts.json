  "tha-ap354:0.3": "",
  "tha-ap354:1.1": "Nagare Aruṇavatiyā ",
  "tha-ap354:1.2": "āsiṃ yavasiko tadā / ",
  "tha-ap354:1.3": "panthe disvāna sambuddhaṃ ",
  "tha-ap354:1.4": "yavakalāpam apatthariṃ // // ",
  "tha-ap354:2.1": "Anukampako kāruṇiko ",
  "tha-ap354:2.2": "Sikhī lokagganāyako / ",
  "tha-ap354:2.3": "mama saṅkappam aññāya ",
  "tha-ap354:2.4": "nisīdi ya vasanthare. // // ",
  "tha-ap354:3.1": "Disvā nisinnaṃ vimalaṃ ",
  "tha-ap354:3.2": "mahājhāyivināyakaṃ / pāmujjaṃ ",
  "tha-ap354:3.3": "janayitvāna ",
  "tha-ap354:3.4": "tattha kālakato ahaṃ. // // ",
  "tha-ap354:4.1": "Ekatiṃse ito kappe ",
  "tha-ap354:4.2": "yaṃ kammam akariṃ tadā / ",
  "tha-ap354:4.3": "duggatiṃ nābhijānāmi ",
  "tha-ap354:4.4": "yavatthāre idaṃ phalaṃ. // // ",
  "tha-ap354:5.1": "Paṭisambhidā . . . ",
  "tha-ap354:5.2": "pe . . . ",
  "tha-ap354:5.3": "pe . . . // // ",
  "tha-ap354:6.1": "Itthaṃ sudam āyasmā Yavakalāpiko thero i. g. a-ti. Yavakalāpiyattherassa ",
  "tha-ap354:7.1": "apadānaṃ samattaṃ. "
}
