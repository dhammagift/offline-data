  "tha-ap530:0.3": "",
  "tha-ap530:1.1": "Ahaṃ pure bodhipattaṃ ",
  "tha-ap530:1.2": "ujjhitaṃ cetiyaṅgane / ",
  "tha-ap530:1.3": "taṃ gahetvāna chaḍḍesiṃ ",
  "tha-ap530:1.4": "alabhiṃ vīsatī gaṇe // // ",
  "tha-ap530:2.1": "Tassa kammassa tejena ",
  "tha-ap530:2.2": "saṃsaranto bhavābhave / ",
  "tha-ap530:2.3": "duve bhave saṃsarāmi ",
  "tha-ap530:2.4": "devattaṃ cāpi mānusaṃ. // // ",
  "tha-ap530:3.1": "Devalokā cavitvāna ",
  "tha-ap530:3.2": "āgantvā mānusaṃ bhavaṃ / ",
  "tha-ap530:3.3": "duve kule pajāyāmi ",
  "tha-ap530:3.4": "khattiye cāpi brāhmaṇe. // // ",
  "tha-ap530:4.1": "Aṅgapaccaṅgasampanno ",
  "tha-ap530:4.2": "ārohapariṇāhavā / ",
  "tha-ap530:4.3": "abhirūpo rucī homi ",
  "tha-ap530:4.4": "sampuṇṇaṅgo anūnako. // // ",
  "tha-ap530:5.1": "Devaloke manusse vā ",
  "tha-ap530:5.2": "jāto vā yattha katthaci / ",
  "tha-ap530:5.3": "bhave suvaṇṇavaṇṇo va ",
  "tha-ap530:5.4": "uttattakanakūpamo. // // ",
  "tha-ap530:6.1": "Mudukā maddavā niddhā ",
  "tha-ap530:6.2": "sukhumā sukumārakā / ",
  "tha-ap530:6.3": "chavi me sabbadā hoti ",
  "tha-ap530:6.4": "bodhipatte su-chaḍḍite. // // ",
  "tha-ap530:7.1": "Yato kuto ca gatisu ",
  "tha-ap530:7.2": "sarīre samudāgate / ",
  "tha-ap530:7.3": "na lippati rajojallaṃ ",
  "tha-ap530:7.4": "vipāko pattachaḍḍite. // // ",
  "tha-ap530:8.1": "Uṇhe vātātape tassa ",
  "tha-ap530:8.2": "aggitāpena vā puna / ",
  "tha-ap530:8.3": "gatte sedā na muccanti ",
  "tha-ap530:8.4": "vipāko pattachaḍḍite. // // ",
  "tha-ap530:9.1": "Kuṭṭhaṃ gaṇḍo kilāso ca ",
  "tha-ap530:9.2": "tilakā piḷakā tathā / ",
  "tha-ap530:9.3": "na honti kāye dadduñ ca ",
  "tha-ap530:9.4": "vipāko pattachaḍḍite. // // ",
  "tha-ap530:10.1": "Aparam pi gaṇaṃ tassa ",
  "tha-ap530:10.2": "nibbattati bhavābhave / ",
  "tha-ap530:10.3": "rogā na honti kāyasmiṃ ",
  "tha-ap530:10.4": "vipāko pattachaḍḍite. // // ",
  "tha-ap530:11.1": "Aparam pi guṇaṃ tassa ",
  "tha-ap530:11.2": "nibbattati bhavābhave / ",
  "tha-ap530:11.3": "na hoti cittajā pīḷā ",
  "tha-ap530:11.4": "vipāko pattachaḍḍite. // // ",
  "tha-ap530:12.1": "Aparam pi guṇaṃ tassa ",
  "tha-ap530:12.2": "nibbattati bhavābhave / ",
  "tha-ap530:12.3": "āmittā na bhavant' assa ",
  "tha-ap530:12.4": "vipāko pattachaḍḍite. // // ",
  "tha-ap530:13.1": "Aparam pi gaṇaṃ tassa ",
  "tha-ap530:13.2": "nibbattati bhavābhave / ",
  "tha-ap530:13.3": "anūnabhogo bhavati ",
  "tha-ap530:13.4": "vipāko pattachaḍḍite. // // ",
  "tha-ap530:14.1": "Aparam pi gunaṃ . . . pe . . . pe . . . ",
  "tha-ap530:14.2": "pe . . . / aggi- ",
  "tha-ap530:14.3": "rajjūhi corehi ",
  "tha-ap530:14.4": "na hoti udake bhayaṃ. // // ",
  "tha-ap530:15.1": "Aparam pi . . . pe . . . ",
  "tha-ap530:15.2": "pe . . . pe . . . / ",
  "tha-ap530:15.3": "dāsī dāsā anucarā ",
  "tha-ap530:15.4": "honti cittānuvattakā. // // ",
  "tha-ap530:16.1": "Yamhi āyuppamānamhi ",
  "tha-ap530:16.2": "jāyate mānuse bhave / ",
  "tha-ap530:16.3": "tato na hāyate āyu ",
  "tha-ap530:16.4": "tiṭṭhate yāvatāyukaṃ. // // ",
  "tha-ap530:17.1": "Abbhantarā bahicarā ",
  "tha-ap530:17.2": "negamā ca saraṭṭhakā / ",
  "tha-ap530:17.3": "anuyuttā honti sabbe pi ",
  "tha-ap530:17.4": "vuṭṭhikāmā sukhicchakā. // // ",
  "tha-ap530:18.1": "Bhogavā yasavā homi ",
  "tha-ap530:18.2": "sirimā ñātipakkhavā / ",
  "tha-ap530:18.3": "apetabhayasantāso ",
  "tha-ap530:18.4": "bhavesaṃ sabbato bhave. // // ",
  "tha-ap530:19.1": "Devā manussā asurā ",
  "tha-ap530:19.2": "gandhabbā yakkha-rakkhasā / ",
  "tha-ap530:19.3": "sabbe te parirakkhanti ",
  "tha-ap530:19.4": "bhave saṃsarato sadā. // // ",
  "tha-ap530:20.1": "Devaloke manusse vā ",
  "tha-ap530:20.2": "anubhotvā ubho yase / ",
  "tha-ap530:20.3": "avasāne ca nibbānaṃ ",
  "tha-ap530:20.4": "sivaṃ patto anuttaraṃ. // // ",
  "tha-ap530:21.1": "",
  "tha-ap530:21.2": "",
  "tha-ap530:21.3": "",
  "tha-ap530:21.4": "",
  "tha-ap530:22.1": "Magge phale āgame ca ",
  "tha-ap530:22.2": "jhānābhiññāguṇesu ca / ",
  "tha-ap530:22.3": "aññesaṃ adhiko hutvā ",
  "tha-ap530:22.4": "nibbāyāmi anāsavo. // // ",
  "tha-ap530:23.1": "Pure 'haṃ bodhiyā pattaṃ ",
  "tha-ap530:23.2": "chaḍḍetvā haṭṭhamānaso / ",
  "tha-ap530:23.3": "imehi vīsataṅgehi ",
  "tha-ap530:23.4": "samaṅgī homi sabbadā. // // ",
  "tha-ap530:24.1": "Kilesā . . . ",
  "tha-ap530:24.2": "pe . . . ",
  "tha-ap530:24.3": "",
  "tha-ap530:25.1": "",
  "tha-ap530:25.2": "pe . . . ",
  "tha-ap530:25.3": "pe . . . // // Sāgataṃ . . . pe . . . pe . . . pe . . . // // ",
  "tha-ap530:26.1": "Paṭisambhidā . . . ",
  "tha-ap530:26.2": "pe . . . ",
  "tha-ap530:26.3": "pe . . . pe . . . // // ",
  "tha-ap530:27.1": "Itthaṃ sudaṃ āyasmā Bodhisammajjako thero i. g. a-ti. Bodhisammajjakattherassa apadānaṃ samattaṃ. ",
  "tha-ap530:28.1": ""
}
