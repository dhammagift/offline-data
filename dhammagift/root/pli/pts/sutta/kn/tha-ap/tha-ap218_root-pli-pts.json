  "tha-ap218:0.3": "",
  "tha-ap218:1.1": "Assatthe haritobhāse ",
  "tha-ap218:1.2": "saṃvirūḷhamhi pādape / ",
  "tha-ap218:1.3": "ekaṃ Buddhagataṃ saññaṃ ",
  "tha-ap218:1.4": "alabhissaṃ patissato. // // ",
  "tha-ap218:2.1": "Ekatiṃse ito kappe ",
  "tha-ap218:2.2": "yaṃ saññam alabhiṃ tadā / ",
  "tha-ap218:2.3": "*duggatiṃ nābhijānāmi Buddhasaññāy' idaṃ phalaṃ* / tassā saññāya vāhasā ",
  "tha-ap218:2.4": "patto me āsavakkhayo. // // ",
  "tha-ap218:3.1": "Ito terasakappamhi ",
  "tha-ap218:3.2": "Dhaniṭṭho nāma khattiyo / ",
  "tha-ap218:3.3": "sattaratanasampanno ",
  "tha-ap218:3.4": "cakkavattī mahabbalo. // // ",
  "tha-ap218:4.1": "Paṭisambhidā . . . ",
  "tha-ap218:4.2": "pe . . . ",
  "tha-ap218:4.3": "pe . . . // // ",
  "tha-ap218:5.1": "Itthaṃ sudam āyasmā Saṇṭhita thero i. g. a-ti. Saṇṭhitattherassa ",
  "tha-ap218:6.1": "apadānaṃ samattaṃ. "
}
