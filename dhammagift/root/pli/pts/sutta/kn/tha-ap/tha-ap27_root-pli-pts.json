{
  "tha-ap27:0.1": "",
  "tha-ap27:0.2": "",
  "tha-ap27:0.3": "",
  "tha-ap27:1.1": "Suvaṇṇavaṇṇaṃ sambuddhaṃ ",
  "tha-ap27:1.2": "gacchantaṃ antarāpaṇe / ",
  "tha-ap27:1.3": "kañcanagghiyasaṅkāsaṃ ",
  "tha-ap27:1.4": "dvattiṃsavaralakkhaṇaṃ // // ",
  "tha-ap27:2.1": "Siddhatthaṃ lokapajjotaṃ ",
  "tha-ap27:2.2": "appameyyaṃ anopamaṃ / ",
  "tha-ap27:2.3": "alatthaṃ paramaṃ pītiṃ ",
  "tha-ap27:2.4": "disvā dantaṃ jutindharaṃ. // // ",
  "tha-ap27:3.1": "Sambuddhaṃ atināmetvā ",
  "tha-ap27:3.2": "bhojayiṃ taṃ mahāmuṇiṃ / ",
  "tha-ap27:3.3": "muni kāruṇiko nātho ",
  "tha-ap27:3.4": "anumodi ca maṃ tadā. // // ",
  "tha-ap27:4.1": "Tasmiṃ mahākāruṇike ",
  "tha-ap27:4.2": "paramassāsakārake / ",
  "tha-ap27:4.3": "Buddhe cittaṃ pasādetvā ",
  "tha-ap27:4.4": "kappam saggamhi mod' ahaṃ. // // Catunavute ",
  "tha-ap27:5.1": "ito kappe ",
  "tha-ap27:5.2": "yaṃ dānam adadiṃ tadā / ",
  "tha-ap27:5.3": "duggatiṃ nābhijānāmi ",
  "tha-ap27:5.4": "bhikkhadānass idaṃ phalaṃ. // // ",
  "tha-ap27:6.1": "Paṭisambhidā catasso ",
  "tha-ap27:6.2": "vimokhā pi ca aṭṭh' ime / ",
  "tha-ap27:6.3": "chaḍabhiññā sacchikatā ",
  "tha-ap27:6.4": "kataṃ Buddhassa sāsanan ti. // // ",
  "tha-ap27:7.1": "Itthaṃ sudaṃ āyasmā Annasaṃsāvako thero imā gāthāyo abhāsitthā ti. ",
  "tha-ap27:8.1": "Annasaṃsāvakatherassa apadānaṃ samattaṃ. "
}
