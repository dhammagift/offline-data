  "tha-ap203:0.3": "",
  "tha-ap203:1.1": "Kaṇikāraṃ pupphitaṃ disvā ",
  "tha-ap203:1.2": "ocinitvān' ahan tadā / ",
  "tha-ap203:1.3": "Tissassa abhiropesiṃ ",
  "tha-ap203:1.4": "oghatiṇṇassa tādino. // // ",
  "tha-ap203:2.1": "Dvenavute ito kappe ",
  "tha-ap203:2.2": "yaṃ puppham abhipūjayiṃ / ",
  "tha-ap203:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap203:2.4": "Buddhapūjāy' idaṃ phalaṃ. // // ",
  "tha-ap203:3.1": "Pañcatiṃse ito kappe ",
  "tha-ap203:3.2": "Aruṇapālo 'ti vissuto / ",
  "tha-ap203:3.3": "sattaratanasampanno ",
  "tha-ap203:3.4": "cakkavatti mahabbalo. // // ",
  "tha-ap203:4.1": "Paṭisambhidā . . . pe . . . ",
  "tha-ap203:4.2": "",
  "tha-ap203:4.3": "pe . . . // // ",
  "tha-ap203:4.4": "",
  "tha-ap203:5.1": "Itthaṃ sudam āyasmā Kaṇikārapupphiyo thero i. g. a-ti. Kaṇikārapupphiyattherassa apadānaṃ samattaṃ. ",
  "tha-ap203:6.1": ""
}
