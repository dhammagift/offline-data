  "tha-ap114:0.2": "",
  "tha-ap114:0.3": "",
  "tha-ap114:1.1": "Atthadassī jinavaro ",
  "tha-ap114:1.2": "lokajeṭṭho narāsabho / ",
  "tha-ap114:1.3": "vihārā abhinikkhamma ",
  "tha-ap114:1.4": "taḷākaṃ upasaṅkami. // // ",
  "tha-ap114:2.1": "Nahātva pītvā ca sambuddho ",
  "tha-ap114:2.2": "uttaritv' ekacīvaro / ",
  "tha-ap114:2.3": "aṭṭhāsi bhagavā tattha ",
  "tha-ap114:2.4": "vilokento disodisaṃ. // // ",
  "tha-ap114:3.1": "Bhavane upaviṭṭho 'haṃ ",
  "tha-ap114:3.2": "addasaṃ lokanāyakaṃ / ",
  "tha-ap114:3.3": "haṭṭho haṭṭhena cittena ",
  "tha-ap114:3.4": "appoṭhesiṃ ahaṃ tadā // // ",
  "tha-ap114:4.1": "Satarasmiṃ va jotantaṃ ",
  "tha-ap114:4.2": "pabhāsantaṃ va kañcanaṃ / ",
  "tha-ap114:4.3": "nacce gīte ca yutto ",
  "tha-ap114:4.4": "'haṃ pañcaturiyatamhi ca. // // ",
  "tha-ap114:5.1": "Yaṃ yaṃ yonūpapajjāmi ",
  "tha-ap114:5.2": "devattaṃ atha mānusaṃ / ",
  "tha-ap114:5.3": "sabbe satte atihomi ",
  "tha-ap114:5.4": "vipulo hoti me yaso. // // ",
  "tha-ap114:6.1": "‘Namo te purisājañña ",
  "tha-ap114:6.2": "namo te purisuttama / ",
  "tha-ap114:6.3": "attānaṃ tosayitvāna ",
  "tha-ap114:6.4": "pare tosesi tvaṃ mune.' // // ",
  "tha-ap114:7.1": "Paṭiggahetvā nisīditvā ",
  "tha-ap114:7.2": "hāsaṃ katvāna subbate / ",
  "tha-ap114:7.3": "upaṭṭhahitvā sambuddhaṃ ",
  "tha-ap114:7.4": "Tusitaṃ upapajj' ahaṃ. // // ",
  "tha-ap114:8.1": "Soḷase 'to kappasate ",
  "tha-ap114:8.2": "dvinavā Ekacintitā / ",
  "tha-ap114:8.3": "sattaratanasampannā ",
  "tha-ap114:8.4": "cakkavattī mahābalā. // // ",
  "tha-ap114:9.1": "Paṭisambhidā catasso ",
  "tha-ap114:9.2": "vimokhā pi ca aṭṭh' ime / chaḍabhiññā sacchikatā ",
  "tha-ap114:9.3": "kataṃ Buddhassa sāsanan ti. // // ",
  "tha-ap114:10.1": "Itthaṃ sudaṃ āyasmā Sumaṅgalo thero imā gāthāyo abhāsitthā ti. Sumaṅgalatherassa apadānaṃ samattaṃ. ",
  "tha-ap114:11.1": ""
}
