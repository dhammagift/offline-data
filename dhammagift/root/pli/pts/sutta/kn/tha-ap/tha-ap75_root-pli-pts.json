  "tha-ap75:0.2": "",
  "tha-ap75:0.3": "",
  "tha-ap75:1.1": "Dumagge paṃsukūlikaṃ ",
  "tha-ap75:1.2": "laggaṃ disvāna satthuno / ",
  "tha-ap75:1.3": "tato 'haṃ añjaliṃ katvā ",
  "tha-ap75:1.4": "paṃsukūliṃ avandi 'haṃ. // // ",
  "tha-ap75:2.1": "Dvenavute ito kappe ",
  "tha-ap75:2.2": "yaṃ kammam akariṃ tadā / ",
  "tha-ap75:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap75:2.4": "Buddhasaññāy' idaṃ phalaṃ. // // ",
  "tha-ap75:3.1": "Ito catutthake kappe ",
  "tha-ap75:3.2": "Dumasāro su khattiyo / ",
  "tha-ap75:3.3": "caturanto vijitāvī ",
  "tha-ap75:3.4": "cakkavattī mahabbalo. // // ",
  "tha-ap75:4.1": "Paṭisambhidā catasso ",
  "tha-ap75:4.2": "vimokhā pi ca aṭṭh' ime / chaḍabhiññā sacchikatā ",
  "tha-ap75:4.3": "kataṃ Buddhassa sāsanan ti. // // ",
  "tha-ap75:5.1": "Itthaṃ sudaṃ āyasmā Saññako thero imā gāthāyo abhāsitthā ti. ",
  "tha-ap75:6.1": "Saññakatherassa apadānaṃ samattaṃ. "
}
