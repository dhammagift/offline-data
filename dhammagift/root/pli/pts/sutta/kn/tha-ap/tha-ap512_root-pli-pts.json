  "tha-ap512:0.3": "",
  "tha-ap512:1.1": "Nagare Bandhumatiyā ",
  "tha-ap512:1.2": "ārāmiko ahaṃ tadā / ",
  "tha-ap512:1.3": "addasaṃ virajaṃ Buddhaṃ ",
  "tha-ap512:1.4": "gacchantaṃ anilañjase. // // ",
  "tha-ap512:2.1": "Nāḷikeraphalaṃ gayha ",
  "tha-ap512:2.2": "Buddhaseṭṭhass' adās' ahaṃ / ",
  "tha-ap512:2.3": "ākāse ṭhitako santo ",
  "tha-ap512:2.4": "patigaṇhi mahāyaso // // ",
  "tha-ap512:3.1": "Vittisañjanano mayhaṃ ",
  "tha-ap512:3.2": "diṭṭhadhammasukhāvaho / ",
  "tha-ap512:3.3": "phalaṃ Buddhassa datvāna ",
  "tha-ap512:3.4": "vippasannena cetasā. // // ",
  "tha-ap512:4.1": "Adhigacchiṃ tadā pītiṃ ",
  "tha-ap512:4.2": "vipulañ ca sukhuttamaṃ / ",
  "tha-ap512:4.3": "uppajjate va ratanaṃ ",
  "tha-ap512:4.4": "nibbattassa yahiṃ tahiṃ. // // Ekanavute ",
  "tha-ap512:5.1": "ito kappe ",
  "tha-ap512:5.2": "yaṃ phalaṃ adadiṃ tadā / ",
  "tha-ap512:5.3": "duggatiṃ nābhijānāmi ",
  "tha-ap512:5.4": "phaladānass' idaṃ phalaṃ. // // ",
  "tha-ap512:6.1": "Dibbaṃ cakkhuṃ visuddham me ",
  "tha-ap512:6.2": "samādhikusalo ahaṃ / ",
  "tha-ap512:6.3": "abhiññāpāramippatto ",
  "tha-ap512:6.4": "phaladānass' idaṃ phalaṃ. // // ",
  "tha-ap512:7.1": "Kilesā . . . ",
  "tha-ap512:7.2": "pe . . . ",
  "tha-ap512:7.3": "",
  "tha-ap512:8.1": "",
  "tha-ap512:8.2": "pe . . . ",
  "tha-ap512:8.3": "pe . . . // // Sāgataṃ . . . pe . . . pe . . . pe . . . // // ",
  "tha-ap512:9.1": "Paṭisambhidā . . . ",
  "tha-ap512:9.2": "pe . . . ",
  "tha-ap512:9.3": "pe . . . pe . . . // // ",
  "tha-ap512:10.1": "Itthaṃ sudaṃ āyasmā Nāḷikaradāyako th. i. g. a- ti. Nālikeradāyakattherassa ",
  "tha-ap512:11.1": "",
  "tha-ap512:12.1": "apadānaṃ samattaṃ. ",
  "tha-ap512:13.1": "Uddānaṃ: ",
  "tha-ap512:14.1": "Kaṇikār'-Ekapatto ca ",
  "tha-ap512:14.2": "Kāsumārī tath' Āvaṭaṃ Pārañ ",
  "tha-ap512:14.3": "ca Mātuluṅgañ ca Ajel' Āmoram- ",
  "tha-ap512:14.4": "eva ca ",
  "tha-ap512:15.1": "Tālaṃ tathā Nāḷikeraṃ ",
  "tha-ap512:15.2": "gāthāyo gaṇitā-v-iha ",
  "tha-ap512:15.3": "ekaṃ gāthā sataṃ hoti ",
  "tha-ap512:15.4": "ūnādhika-vivajjitaṃ. "
}
