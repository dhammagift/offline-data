  "tha-ap346:0.3": "",
  "tha-ap346:1.1": "",
  "tha-ap346:1.2": "Bhūtagaṇo nāma pabbato / ",
  "tha-ap346:1.3": "tatth' addasaṃ paṃsukūlaṃ ",
  "tha-ap346:1.4": "dumaggamhi vilaggitaṃ. // // ",
  "tha-ap346:2.1": "Tīṇi kiṅkhaṇikapupphāni ocinitvān' ",
  "tha-ap346:2.2": "ahan tadā / ",
  "tha-ap346:2.3": "haṭṭho haṭṭhena cittena ",
  "tha-ap346:2.4": "paṃsukūlam apūjayiṃ. // // ",
  "tha-ap346:3.1": "Ekatiṃse ito kappe ",
  "tha-ap346:3.2": "yaṃ kammam akariṃ tadā / ",
  "tha-ap346:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap346:3.4": "tīṇipupphān' idaṃ phalaṃ. // // ",
  "tha-ap346:4.1": "Paṭisambhidā . . . ",
  "tha-ap346:4.2": "pe . . . ",
  "tha-ap346:4.3": "pe . . . // // ",
  "tha-ap346:5.1": "Itthaṃ sudam āyasmā Tīṇikiṅkhaṇikapūjako thero i. g. a-ti. Tīṇikiṅkhaṇikapūjakattherassa apadānaṃ ",
  "tha-ap346:6.1": "samattaṃ. Himavantass' avidūre "
}
