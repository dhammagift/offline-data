{
  "tha-ap347:0.1": "",
  "tha-ap347:0.2": "",
  "tha-ap347:0.3": "",
  "tha-ap347:1.1": "",
  "tha-ap347:1.2": "Hārito nāma pabbato / ",
  "tha-ap347:1.3": "sayambhū Nārado nāma ",
  "tha-ap347:1.4": "rukkhamūle vasī tadā. // // ",
  "tha-ap347:2.1": "Nalāgāraṃ karitvāna ",
  "tha-ap347:2.2": "tiṇena chādayim ahaṃ / ",
  "tha-ap347:2.3": "caṅkamaṃ sodhayitvāna ",
  "tha-ap347:2.4": "sayambhussa adās' ahaṃ. // // ",
  "tha-ap347:3.1": "Catuddasesu kappesu ",
  "tha-ap347:3.2": "devaloke ramim ahaṃ / ",
  "tha-ap347:3.3": "catusattatikkhatuñ ca ",
  "tha-ap347:3.4": "devarajjam akārayiṃ. // // ",
  "tha-ap347:4.1": "Sattasattatikkhattuñ ca ",
  "tha-ap347:4.2": "cakkavatti-m-ahos' ahaṃ / ",
  "tha-ap347:4.3": "padesarajjaṃ vipulaṃ ",
  "tha-ap347:4.4": "gaṇanāto asaṅkhiyaṃ. // // ",
  "tha-ap347:5.1": "*Ubbiddhaṃ bhavanaṃ mayham* ",
  "tha-ap347:5.2": "indalaṭṭhīva uggataṃ / ",
  "tha-ap347:5.3": "sahassathambham atulaṃ ",
  "tha-ap347:5.4": "vimānaṃ sa-pabhassaraṃ. // // ",
  "tha-ap347:6.1": "Dve sampattī anubhotvā ",
  "tha-ap347:6.2": "sukkamūlena codito / ",
  "tha-ap347:6.3": "Gotamassa bhagavato ",
  "tha-ap347:6.4": "sāsane pabbajim ahaṃ. // // ",
  "tha-ap347:7.1": "Padhānam pahitatto 'mhi ",
  "tha-ap347:7.2": "upasanto nirūpadhi / ",
  "tha-ap347:7.3": "nāgo va bandhanaṃ chetvā ",
  "tha-ap347:7.4": "viharāmi anāsavo. // // ",
  "tha-ap347:8.1": "Paṭisambhidā . . . ",
  "tha-ap347:8.2": "pe . . . ",
  "tha-ap347:8.3": "pe . . . // // ",
  "tha-ap347:9.1": "Itthaṃ sudam āyasmā Naḷāgāriko thero i. g. a-ti. Nalāgārikattherassa apadānaṃ samattaṃ. Himavantass' avidūre Cāvalo ",
  "tha-ap347:10.1": ""
}
