  "tha-ap93:0.2": "",
  "tha-ap93:0.3": "",
  "tha-ap93:1.1": "Pūjārahe pūjayato ",
  "tha-ap93:1.2": "Buddhe yadi va sāvake / ",
  "tha-ap93:1.3": "papañcasamatikkante ",
  "tha-ap93:1.4": "tiṇṇasokapariddave. // // ",
  "tha-ap93:2.1": "Te tādise pūjayato ",
  "tha-ap93:2.2": "nibbute akutobhaye / ",
  "tha-ap93:2.3": "na sakkā puññaṃ saṅkhātuṃ ",
  "tha-ap93:2.4": "ime ttaṃ api kenaci. // // ",
  "tha-ap93:3.1": "Catunnam api dīpānaṃ ",
  "tha-ap93:3.2": "issaraṃ yodhakāraye / ",
  "tha-ap93:3.3": "ekissā pūjanāy' etaṃ ",
  "tha-ap93:3.4": "kalaṃ nāgghati soḷasiṃ. // // ",
  "tha-ap93:4.1": "Siddhatthassa naraggassa ",
  "tha-ap93:4.2": "cetiye phalitantare / ",
  "tha-ap93:4.3": "sudhāpiṇḍo mayā dinno ",
  "tha-ap93:4.4": "vippasannena cetasā. // // ",
  "tha-ap93:5.1": "Catunavute ito kappe ",
  "tha-ap93:5.2": "yaṃ kammam akariṃ tadā / ",
  "tha-ap93:5.3": "duggatiṃ nābhijānāmi ",
  "tha-ap93:5.4": "paṭisaṅkhārass' idaṃ phalaṃ. // // ",
  "tha-ap93:6.1": "Ito tiṃsati-kappamhi ",
  "tha-ap93:6.2": "Paṭisaṅkhārasavhayā / ",
  "tha-ap93:6.3": "sattaratanasampannā ",
  "tha-ap93:6.4": "terasācakkavattino. // // ",
  "tha-ap93:7.1": "Paṭisambhidā catasso ",
  "tha-ap93:7.2": "vimokhā pi ca aṭṭh' ime / ",
  "tha-ap93:7.3": "chaḍabhiññā sacchikatā ",
  "tha-ap93:7.4": "kataṃ Buddhassa sāsanan ti. // // ",
  "tha-ap93:8.1": "Itthaṃ sudaṃ āyasmā Sudhāpiṇḍiyo thero imā gāthāyo abhāsitthā ti. ",
  "tha-ap93:9.1": "Sudhāpiṇḍiyattherassa apadānaṃ samattaṃ. "
}
