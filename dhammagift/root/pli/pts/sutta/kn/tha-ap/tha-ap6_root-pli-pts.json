  "tha-ap6:0.1": "",
  "tha-ap6:0.2": "",
  "tha-ap6:0.3": "",
  "tha-ap6:1.1": "Sumedhaṃ bhagavantāhaṃ ",
  "tha-ap6:1.2": "lokajeṭṭhaṃ narāsabhaṃ / ",
  "tha-ap6:1.3": "vupakaṭṭhaṃ viharantaṃ ",
  "tha-ap6:1.4": "addasaṃ lokanāyakaṃ. // // ",
  "tha-ap6:2.1": "Upagantvāna sambuddhaṃ ",
  "tha-ap6:2.2": "sumedhaṃ lokanāyakaṃ / ",
  "tha-ap6:2.3": "añjalim paggahetvāna ",
  "tha-ap6:2.4": "buddhaseṭṭham ayāc' ahaṃ: // // ",
  "tha-ap6:3.1": "‘Anukampī mahāvīra ",
  "tha-ap6:3.2": "lokajeṭṭha narāsabha / ",
  "tha-ap6:3.3": "padīpan te padassāmi ",
  "tha-ap6:3.4": "rukkhamūlamhi jhāyato.' // // ",
  "tha-ap6:4.1": "Adhivāsesi so dhīro ",
  "tha-ap6:4.2": "sayambhū vadataṃ varo / ",
  "tha-ap6:4.3": "dumesu vinivijjhitvā ",
  "tha-ap6:4.4": "yantaṃ yojetv' ahaṃ tadā. // // ",
  "tha-ap6:5.1": "Sahassavaṭṭiṃ pādāsiṃ ",
  "tha-ap6:5.2": "buddhassa lokabandhuno / ",
  "tha-ap6:5.3": "sattāhaṃ pajjalitvāna ",
  "tha-ap6:5.4": "padīpā vupasammisuṃ. // // ",
  "tha-ap6:6.1": "Tena cittappasādena ",
  "tha-ap6:6.2": "cetanāpaṇidhīhi ca / ",
  "tha-ap6:6.3": "jahitvā mānusaṃ dehaṃ ",
  "tha-ap6:6.4": "vimānaṃ upapajj ahaṃ // // ",
  "tha-ap6:7.1": "Upapannassa devattaṃ ",
  "tha-ap6:7.2": "thambho āsi sunimmito / ",
  "tha-ap6:7.3": "samantato pajjalati ",
  "tha-ap6:7.4": "dīpadānass' idaṃ phalaṃ. // // ",
  "tha-ap6:8.1": "Samantā yojanaṃ sabbaṃ ",
  "tha-ap6:8.2": "virocemi ahaṃ tadā / ",
  "tha-ap6:8.3": "sabbe deve atihomi ",
  "tha-ap6:8.4": "dīpadānass' idaṃ phalaṃ. // // ",
  "tha-ap6:9.1": "Tiṃsakappāni devindo ",
  "tha-ap6:9.2": "devarajjam akārayiṃ / ",
  "tha-ap6:9.3": "na maṃ kec' atimaññanti ",
  "tha-ap6:9.4": "dīpadānass' idaṃ phalaṃ. // // ",
  "tha-ap6:10.1": "Aṭṭhavīsatikkhattuñ ca ",
  "tha-ap6:10.2": "cakkavattī ahos ahaṃ / ",
  "tha-ap6:10.3": "divārattiñ ca passāmi ",
  "tha-ap6:10.4": "samantā yojanaṃ tadā. // // ",
  "tha-ap6:11.1": "Sahassalokaṃ ñāṇena ",
  "tha-ap6:11.2": "passāmi satthu sāsane / ",
  "tha-ap6:11.3": "dibbacakkhuṃ anuppatto ",
  "tha-ap6:11.4": "dīpadānass' idaṃ phalaṃ. // // ",
  "tha-ap6:12.1": "Sumedho nāma sambuddho ",
  "tha-ap6:12.2": "tiṃsakappasahass' ito / ",
  "tha-ap6:12.3": "tassa dīpo mayā dinno ",
  "tha-ap6:12.4": "vippasannena cetasā. // // ",
  "tha-ap6:13.1": "Paṭisambhidā catasso ",
  "tha-ap6:13.2": "vimokhā pi ca aṭṭh' ime / ",
  "tha-ap6:13.3": "chaḍabhiññā sacchikatā ",
  "tha-ap6:13.4": "kataṃ buddhassa sāsanan ti. // // ",
  "tha-ap6:14.1": "Itthaṃ sudaṃ āyasmā Anuruddhatthero imā gāthāyo 'bhāsitthāti. Anuruddhattherassa apadānaṃsamattaṃ. ",
  "tha-ap6:15.1": ""
}
