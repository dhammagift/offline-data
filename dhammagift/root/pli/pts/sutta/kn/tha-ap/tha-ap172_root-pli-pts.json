  "tha-ap172:0.2": "",
  "tha-ap172:0.3": "",
  "tha-ap172:1.1": "Tisso nāmā ti bhagavā ",
  "tha-ap172:1.2": "lokajeṭṭho narāsabho / ",
  "tha-ap172:1.3": "pavisantaṃ gandhakuṭiṃ ",
  "tha-ap172:1.4": "vihārakusalaṃ *muniṃ // // Sagand*hamālyam ",
  "tha-ap172:2.1": "ādāya ",
  "tha-ap172:2.2": "agamāsiṃ jinantikaṃ / ",
  "tha-ap172:2.3": "appasādo 'va sambuddhe ",
  "tha-ap172:2.4": "pañcaṅgulim adās' ahaṃ. // // ",
  "tha-ap172:3.1": "Dvenavute ito kappe ",
  "tha-ap172:3.2": "yaṃ gandham abhiropayiṃ / ",
  "tha-ap172:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap172:3.4": "pañcaṅgulim idaṃ phalaṃ. // // ",
  "tha-ap172:4.1": "Dvesa*ttati ito kappe* ",
  "tha-ap172:4.2": "rājā āsi Sayampabho / ",
  "tha-ap172:4.3": "sattaratanasampanno ",
  "tha-ap172:4.4": "cakkavattī mahabbalo. // // ",
  "tha-ap172:5.1": "Paṭisambhidā . . . ",
  "tha-ap172:5.2": "pe . . . ",
  "tha-ap172:5.3": "pe . . . // // ",
  "tha-ap172:6.1": "Itthaṃ sudaṃ ā. Pañcaṅguliyo thero i. g. ā- ti. Pañcaṅguliyattherassa apadānaṃ samattaṃ. ",
  "tha-ap172:7.1": "",
  "tha-ap172:8.1": "",
  "tha-ap172:9.1": "Uddanaṃ : ",
  "tha-ap172:10.1": "Supārī Kaṇaverī ca ",
  "tha-ap172:10.2": "Khajjako Desapūjako ",
  "tha-ap172:10.3": "Kaṇikāro Sappidado ",
  "tha-ap172:10.4": "Yūthiko *Dussadāyako* ",
  "tha-ap172:10.5": "Māḷo ca Pañcaṅguliko ",
  "tha-ap172:10.6": "catupaññāsa gāthakā ti. Supāricariyavaggo sattarasamo. "
}
