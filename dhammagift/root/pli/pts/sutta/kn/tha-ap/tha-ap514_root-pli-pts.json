  "tha-ap514:1.1": "Suvaṇṇavaṇṇaṃ sambuddhaṃ ",
  "tha-ap514:1.2": "āhutīnaṃ paṭiggahaṃ / ",
  "tha-ap514:1.3": "rathiyaṃ paṭipajjantaṃ ",
  "tha-ap514:1.4": "kapiṭṭhaṃ adadaṃ phalaṃ. // // ",
  "tha-ap514:2.1": "Ekanavute ito kappe ",
  "tha-ap514:2.2": "yaṃ phalaṃ adadiṃ tadā / ",
  "tha-ap514:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap514:2.4": "phaladānass' idaṃ phalaṃ. // // ",
  "tha-ap514:3.1": "Kilesā . . . ",
  "tha-ap514:3.2": "pe . . . ",
  "tha-ap514:3.3": "",
  "tha-ap514:4.1": "",
  "tha-ap514:4.2": "pe . . . ",
  "tha-ap514:4.3": "pe . . . // // Sagataṃ . . . pe . . . pe . . . pe . . . // // ",
  "tha-ap514:5.1": "Paṭisambhidā . . . ",
  "tha-ap514:5.2": "pe . . . ",
  "tha-ap514:5.3": "pe . . .pe . . . // // ",
  "tha-ap514:6.1": "Itthaṃ sudaṃ āyasmā Kapiṭṭhaphaladāyako th. i. g. a-ti. Kapiṭṭhaphaladāyakattherassa ",
  "tha-ap514:7.1": "apadānaṃ samattaṃ. "
}
