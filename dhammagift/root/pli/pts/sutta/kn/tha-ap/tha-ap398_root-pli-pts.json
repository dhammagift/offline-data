{
  "tha-ap398:0.1": "",
  "tha-ap398:0.2": "",
  "tha-ap398:0.3": "",
  "tha-ap398:1.1": "",
  "tha-ap398:1.2": "Sobhito nāma pabbato / ",
  "tha-ap398:1.3": "assamo sukato mayhaṃ ",
  "tha-ap398:1.4": "sakasissehi māpito. // // ",
  "tha-ap398:2.1": "Maṇḍapā ca bahū tatthā ",
  "tha-ap398:2.2": "pupphitā sindhuvāritā / ",
  "tha-ap398:2.3": "kapiṭṭhaṃ ca bahuṃ tatthā ",
  "tha-ap398:2.4": "pupphitā jīvajīvakā. // // ",
  "tha-ap398:3.1": "Nigguṇḍiyo bahū tatthā ",
  "tha-ap398:3.2": "badarā malakāni *ca / ",
  "tha-ap398:3.3": "Phārusakā alābū* ca ",
  "tha-ap398:3.4": "puṇḍarīkā ca pupphitā. // // ",
  "tha-ap398:4.1": "Āḷakā beluvā tattha ",
  "tha-ap398:4.2": "kadalī mātuluṅgakā / ",
  "tha-ap398:4.3": "mahānāmā bahū tattha ",
  "tha-ap398:4.4": "ajjunā ca piyaṅgukā. // // ",
  "tha-ap398:5.1": "Kosumbhā salaḷā nīpā ",
  "tha-ap398:5.2": "nigrodhā ca kapitthanā / ",
  "tha-ap398:5.3": "ediso assamo mayhaṃ ",
  "tha-ap398:5.4": "sasisso 'haṃ tadā vasiṃ. // // ",
  "tha-ap398:6.1": "Anomadassī bhagavā ",
  "tha-ap398:6.2": "sayambhū lokanāyako / ",
  "tha-ap398:6.3": "gavesaṃ paṭisallāṇaṃ ",
  "tha-ap398:6.4": "mam assamam upāgami. // // Upetañ ca ",
  "tha-ap398:7.1": "mahāvīram Anomadassi- ",
  "tha-ap398:7.2": "mahāyasaṃ / ",
  "tha-ap398:7.3": "khaṇena lokanāthassa ",
  "tha-ap398:7.4": "vātābādho samuṭṭhahi // // ",
  "tha-ap398:8.1": "Vicaranto araññamhi ",
  "tha-ap398:8.2": "addasaṃ lokanāyakaṃ / ",
  "tha-ap398:8.3": "upagantvāna sambuddhaṃ ",
  "tha-ap398:8.4": "cakkhumantam mahāyasaṃ // // ",
  "tha-ap398:9.1": "Iriyañ cāpi disvāna ",
  "tha-ap398:9.2": "upalakkhes' ahan tadā / ",
  "tha-ap398:9.3": "asaṃsayaṃ hi Buddhassa ",
  "tha-ap398:9.4": "vyādhino udapajjatha. // // ",
  "tha-ap398:10.1": "Khippam assamam āgacchiṃ ",
  "tha-ap398:10.2": "mama sissāna santike / ",
  "tha-ap398:10.3": "bhesajjaṃ kattukāmo 'haṃ ",
  "tha-ap398:10.4": "sisse āmantayiṃ tadā. // // ",
  "tha-ap398:11.1": "Paṭissutvāna me vākyaṃ ",
  "tha-ap398:11.2": "sissā sabbe sagāravā / ",
  "tha-ap398:11.3": "ekajjhaṃ sannipātiṃsu ",
  "tha-ap398:11.4": "satthu gāravatā mama. // // ",
  "tha-ap398:12.1": "Khippaṃ pabbatam āruyha sabbosadham akās ",
  "tha-ap398:12.2": "ahaṃ / ",
  "tha-ap398:12.3": "pānīyayogaṃ katvāna ",
  "tha-ap398:12.4": "Buddhaseṭṭhass' adās' ahaṃ. // // Paribhutto ",
  "tha-ap398:13.1": "mahāvīro sabbaññū ",
  "tha-ap398:13.2": "lokanāyako / ",
  "tha-ap398:13.3": "khippaṃ vāto vūpasami ",
  "tha-ap398:13.4": "sugatassa mahesino. // // ",
  "tha-ap398:14.1": "Passaddhadarathaṃ disvā ",
  "tha-ap398:14.2": "Anomadassī mahāyaso / ",
  "tha-ap398:14.3": "sakāsane nisīditvā ",
  "tha-ap398:14.4": "imā gāthā abhāsatha: // // ",
  "tha-ap398:15.1": "Yo me pādāsi bhesajjaṃ ",
  "tha-ap398:15.2": "vyādhiñ ca samayī mayī / ",
  "tha-ap398:15.3": "tam ahaṃ kittayissāmi ",
  "tha-ap398:15.4": "suṇotha mama bhāsato: // // ",
  "tha-ap398:16.1": "Kappasatasahassāni ",
  "tha-ap398:16.2": "devaloke ramissati / ",
  "tha-ap398:16.3": "vādite turiye tattha ",
  "tha-ap398:16.4": "modissati sadā ayaṃ. // // ",
  "tha-ap398:17.1": "Manussalokam āgantvā ",
  "tha-ap398:17.2": "sukkamūlena codito / ",
  "tha-ap398:17.3": "sahassakkhattuṃ rājā ca ",
  "tha-ap398:17.4": "cakkavattī bhavissati. // // ",
  "tha-ap398:18.1": "Pañcapaññāsakappamhi ",
  "tha-ap398:18.2": "Anoma-nāma khattiyo / ",
  "tha-ap398:18.3": "cāturanto vijitāvī ",
  "tha-ap398:18.4": "jambusaṇḍassa issaro. // // ",
  "tha-ap398:19.1": "Sattaratanasampanno ",
  "tha-ap398:19.2": "cakkavattī mahabbalo / ",
  "tha-ap398:19.3": "Tāvatiṃse 'to khobhetvā ",
  "tha-ap398:19.4": "isseraṃ kārayissati. // // ",
  "tha-ap398:20.1": "Devabhūto manusso vā ",
  "tha-ap398:20.2": "appābādho bhavissati / ",
  "tha-ap398:20.3": "pariggahaṃ vivajjetvā ",
  "tha-ap398:20.4": "vyādhiṃ loke tarissati. // // ",
  "tha-ap398:21.1": "Aparimeyye ito kappe ",
  "tha-ap398:21.2": "Okkākakulasambhavo / ",
  "tha-ap398:21.3": "Gotamo nāma nāmena ",
  "tha-ap398:21.4": "satthā loke bhavissati. // // ",
  "tha-ap398:22.1": "Tassa dhammesu dāyādo ",
  "tha-ap398:22.2": "oraso dhammanimmito / ",
  "tha-ap398:22.3": "sabbāsave pariññāya ",
  "tha-ap398:22.4": "nibbāyissat' anāsavo. // // ",
  "tha-ap398:23.1": "Kilesā jhāpayitvāna ",
  "tha-ap398:23.2": "taṇhāsotaṃ tarissati / ",
  "tha-ap398:23.3": "Bakkulo nāma nāmena ",
  "tha-ap398:23.4": "hessati satthu sāvako. // // ",
  "tha-ap398:24.1": "Idaṃ sabbam abhiññāya ",
  "tha-ap398:24.2": "Gotamo Sakyapuṅgavo / ",
  "tha-ap398:24.3": "bhikkhusaṅghe nisīditvā ",
  "tha-ap398:24.4": "etadagge ṭhapessati. // // ",
  "tha-ap398:25.1": "Anomadassī bhagavā ",
  "tha-ap398:25.2": "sayambhū lokanāyako / ",
  "tha-ap398:25.3": "vivekānuvilokento ",
  "tha-ap398:25.4": "mam assamam upāgamī. // // ",
  "tha-ap398:26.1": "Upāgataṃ mahāvīraṃ ",
  "tha-ap398:26.2": "sabbaññuṃ lokanāyakaṃ / ",
  "tha-ap398:26.3": "sabbosadhena tappesiṃ ",
  "tha-ap398:26.4": "pasanno sehi pānihi. // // ",
  "tha-ap398:27.1": "Tassa me sukataṃ kammaṃ ",
  "tha-ap398:27.2": "sukhette bījasampadā / ",
  "tha-ap398:27.3": "khepetuṃ n' eva sakkomi ",
  "tha-ap398:27.4": "tadā hi sukataṃ mama. // // ",
  "tha-ap398:28.1": "Lābhā mama suladdhaṃ me ",
  "tha-ap398:28.2": "yo 'haṃ addakkhi nāyakaṃ / ",
  "tha-ap398:28.3": "tena kammāvasesena ",
  "tha-ap398:28.4": "patto 'mhi acalaṃ padaṃ // // ",
  "tha-ap398:29.1": "Sabbam etam abhiññāya ",
  "tha-ap398:29.2": "Gotamo Sakyapuṅgavo / ",
  "tha-ap398:29.3": "bhikkhusaṅghe nisīditvā ",
  "tha-ap398:29.4": "etadagge ṭhapesi maṃ. // // ",
  "tha-ap398:30.1": "Aparimeyye ito kappe ",
  "tha-ap398:30.2": "yaṃ kammam akariṃ tadā / ",
  "tha-ap398:30.3": "duggatiṃ nābhijānāmi ",
  "tha-ap398:30.4": "bhesajjass' idaṃ phalaṃ. // // ",
  "tha-ap398:31.1": "Kilesā . . . ",
  "tha-ap398:31.2": "",
  "tha-ap398:31.3": "",
  "tha-ap398:31.4": "",
  "tha-ap398:32.1": "",
  "tha-ap398:32.2": "pe . . . ",
  "tha-ap398:32.3": "pe . . . // // Sāgataṃ . . . pe . . . pe . . . // // ",
  "tha-ap398:33.1": "Paṭisambhidā . . . ",
  "tha-ap398:33.2": "pe . . . ",
  "tha-ap398:33.3": "pe . . . // // ",
  "tha-ap398:34.1": "Itthaṃ sudam āyasmā Bakkulo thero i. g. a-ti. Bakkulattherassa ",
  "tha-ap398:35.1": "apadānaṃ samattaṃ. "
}
