  "tha-ap327:0.3": "",
  "tha-ap327:1.1": "Candabhāgānadītīre ",
  "tha-ap327:1.2": "vasāmi assame ahaṃ / ",
  "tha-ap327:1.3": "suvaṇṇamigam addakkhiṃ ",
  "tha-ap327:1.4": "carantaṃ vipine ahaṃ. // // ",
  "tha-ap327:2.1": "Mige cittaṃ pasādetvā ",
  "tha-ap327:2.2": "lokajeṭṭham anussariṃ / ",
  "tha-ap327:2.3": "tena cittappasādena ",
  "tha-ap327:2.4": "aññe Buddhe anussariṃ. // // ",
  "tha-ap327:3.1": "Abbhatītā ca ye Buddhā ",
  "tha-ap327:3.2": "vattamānā tathāgatā / evam ",
  "tha-ap327:3.3": "eva virocanti ",
  "tha-ap327:3.4": "migarājā va cetaso. // // Catunavute ",
  "tha-ap327:4.1": "ito kappe ",
  "tha-ap327:4.2": "yaṃ saññam alabhiṃ tadā / ",
  "tha-ap327:4.3": "duggatiṃ nābhijānāmi ",
  "tha-ap327:4.4": "*Buddhasaññāy'* idaṃ phalaṃ. // // ",
  "tha-ap327:5.1": "Sattavīse ito kappe ",
  "tha-ap327:5.2": "eko āsi mahīpati / ",
  "tha-ap327:5.3": "Araññasatto nāmena ",
  "tha-ap327:5.4": "cakkavattī mahabbalo. // // ",
  "tha-ap327:6.1": "Paṭisambhidā . . . ",
  "tha-ap327:6.2": "pe . . . ",
  "tha-ap327:6.3": "pe . . . // // ",
  "tha-ap327:7.1": "Itthaṃ sudam āyasmā Nimittasaññako thero i. g. a-ti. Nimittasaññakattherassa ",
  "tha-ap327:8.1": "apadānaṃ samattaṃ. "
}
