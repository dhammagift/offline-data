{
  "tha-ap115:0.1": "",
  "tha-ap115:0.2": "",
  "tha-ap115:0.3": "",
  "tha-ap115:1.1": "Ubhinnaṃ devarājūnaṃ ",
  "tha-ap115:1.2": "saṅgāmo paccupaṭṭhito / ",
  "tha-ap115:1.3": "ahosi samupabbūḷho ",
  "tha-ap115:1.4": "mahāghoso pavattatha. // // ",
  "tha-ap115:2.1": "Padumuttaro lokavidū ",
  "tha-ap115:2.2": "āhutīnaṃ paṭiggaho / ",
  "tha-ap115:2.3": "antalikkhe ṭhito satthā ",
  "tha-ap115:2.4": "saṃvejesi mahājanaṃ. // // ",
  "tha-ap115:3.1": "Sabbe devā attamanā ",
  "tha-ap115:3.2": "nikkhittakavacāvudhā / ",
  "tha-ap115:3.3": "sambuddham-abhivādetvā ",
  "tha-ap115:3.4": "ekagg'-āsiṃsu tāvade. // // ",
  "tha-ap115:4.1": "Amhaṃ saṅkappam aññāya ",
  "tha-ap115:4.2": "vācāsabhim udīrayi / ",
  "tha-ap115:4.3": "anukampako lokavidū ",
  "tha-ap115:4.4": "nibbāpesi mahājanaṃ. // // ",
  "tha-ap115:5.1": "‘Paduṭṭhacitto manujo ",
  "tha-ap115:5.2": "ekapāṇaṃ viheṭhayaṃ / ",
  "tha-ap115:5.3": "tena cittappadosena ",
  "tha-ap115:5.4": "apāyaṃ upapajjati. // // ",
  "tha-ap115:6.1": "Saṅgāmasīse nāgo va ",
  "tha-ap115:6.2": "bahū pāṇe viheṭhayaṃ / ",
  "tha-ap115:6.3": "nibbāpetha sakaṃ cittaṃ ",
  "tha-ap115:6.4": "mā haññittho punappunaṃ.' // // ",
  "tha-ap115:7.1": "Dvinnam pi yakkharājānaṃ ",
  "tha-ap115:7.2": "senā sā vimhitā ahu / ",
  "tha-ap115:7.3": "saraṇañ ca upagañchuṃ ",
  "tha-ap115:7.4": "lokajeṭṭhaṃ su-tādinaṃ. // // ",
  "tha-ap115:8.1": "Saññāpetvāna janataṃ ",
  "tha-ap115:8.2": "uddharī pana cakkhumā / ",
  "tha-ap115:8.3": "pekkhamāno ca devehi ",
  "tha-ap115:8.4": "pakkāmi uttarāmukho. // // ",
  "tha-ap115:9.1": "Paṭhamaṃ saraṇaṃ gañchiṃ ",
  "tha-ap115:9.2": "dipadindassa tādino / ",
  "tha-ap115:9.3": "kappānaṃ satasahassaṃ ",
  "tha-ap115:9.4": "duggatiṃ nūpapajj' ahaṃ. // // Mahācundā hi ",
  "tha-ap115:10.1": "nāmā ca ",
  "tha-ap115:10.2": "soḷas' āsuṃ rathesabhā / ",
  "tha-ap115:10.3": "tiṃsakappasahassamhi ",
  "tha-ap115:10.4": "rājāno cakkavattino. // // ",
  "tha-ap115:11.1": "Paṭisambhidā catasso ",
  "tha-ap115:11.2": "vimokhā pi ca aṭṭh' ime / chaḍabhiññā sacchikatā ",
  "tha-ap115:11.3": "kataṃ Buddhassa sāsanan ti. // // ",
  "tha-ap115:12.1": "Itthaṃ sudaṃ āyasmā Saraṇāgamaniyo thero imā gāthāyo abhāsitthā ti. ",
  "tha-ap115:13.1": "Saraṇāgamaniyattherassa apadānaṃ samattaṃ. "
}
