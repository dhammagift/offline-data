  "tha-ap423:1.1": "Vipassino bhagavato ",
  "tha-ap423:1.2": "pāṭalibodhiṃ *uttamaṃ / ",
  "tha-ap423:1.3": "disvā va taṃ pā*dapaggaṃ ",
  "tha-ap423:1.4": "tattha cittaṃ pasādayiṃ. // // ",
  "tha-ap423:2.1": "Sammajjaniṃ gahetvāna ",
  "tha-ap423:2.2": "bodhiṃ sammajji tāvade / ",
  "tha-ap423:2.3": "sammajjitvāna taṃ bodhim ",
  "tha-ap423:2.4": "avandiṃ pāṭaliṃ ahaṃ. // // ",
  "tha-ap423:3.1": "Tattha cittaṃ pasādetvā ",
  "tha-ap423:3.2": "sire katvāna añjaliṃ / ",
  "tha-ap423:3.3": "namassamāno taṃ bodhiṃ ",
  "tha-ap423:3.4": "gacchiṃ *paṭikuṭim aham. // // ",
  "tha-ap423:4.1": "Cārima-maggena* gacchāmi ",
  "tha-ap423:4.2": "saranto bodhim uttamaṃ / ",
  "tha-ap423:4.3": "ajagaro maṃ pīḷesi ",
  "tha-ap423:4.4": "gho*ra*rūpo mahābalo. // // ",
  "tha-ap423:5.1": "Āsanne me kataṃ kammaṃ ",
  "tha-ap423:5.2": "phalena tosayī mamaṃ / ",
  "tha-ap423:5.3": "kalebaraṃ me gilati ",
  "tha-ap423:5.4": "devaloke ramām' ahaṃ. // // ",
  "tha-ap423:6.1": "Anāvilaṃ mama cittaṃ ",
  "tha-ap423:6.2": "vi*suddhaṃ paṇḍaraṃ sadā / ",
  "tha-ap423:6.3": "sokasallaṃ* na jānāmi ",
  "tha-ap423:6.4": "cittasantāpanaṃ mama. // // ",
  "tha-ap423:7.1": "Kuṭṭhaṃ gaṇḍo kilāso ca ",
  "tha-ap423:7.2": "apamāro vitacchikā / ",
  "tha-ap423:7.3": "daddu kaṇḍu ca me n' atthi ",
  "tha-ap423:7.4": "phalaṃ sammajjanāy' idaṃ. // // ",
  "tha-ap423:8.1": "Soko ca paridevo ca ",
  "tha-ap423:8.2": "hadaye me na vijjati / ",
  "tha-ap423:8.3": "asattam ujukaṃ cittaṃ ",
  "tha-ap423:8.4": "phalaṃ sammajjanāy' idaṃ. // // ",
  "tha-ap423:9.1": "*Samādhisu na sajjā*mi ",
  "tha-ap423:9.2": "visuddhaṃ hoti mānasaṃ / ",
  "tha-ap423:9.3": "yaṃ yaṃ samādhim icchāmi ",
  "tha-ap423:9.4": "so so sampajjate mama. // // ",
  "tha-ap423:10.1": "Rajanīye na rajjāmi ",
  "tha-ap423:10.2": "atho dosaniyesu ca / ",
  "tha-ap423:10.3": "mohanīye na muyhāmi ",
  "tha-ap423:10.4": "phalaṃ sammajjanāy' idaṃ. // // Ekanavute ",
  "tha-ap423:11.1": "ito kappe ",
  "tha-ap423:11.2": "yaṃ kammam ākariṃ tadā / ",
  "tha-ap423:11.3": "duggatiṃ nābhijānāmi ",
  "tha-ap423:11.4": "phalaṃ *sammaj*janāy' idaṃ. // // ",
  "tha-ap423:12.1": "Kilesā . . . pe . . . ",
  "tha-ap423:12.2": "pe . . . ",
  "tha-ap423:12.3": "pe . . . // // ",
  "tha-ap423:12.4": "Sāgataṃ . . . ",
  "tha-ap423:13.1": "pe . . . ",
  "tha-ap423:13.2": "pe . . . ",
  "tha-ap423:13.3": "pe . . . // // ",
  "tha-ap423:13.4": "",
  "tha-ap423:14.1": "Paṭisambhidā . . . pe . . . ",
  "tha-ap423:14.2": "pe . . . ",
  "tha-ap423:14.3": "",
  "tha-ap423:14.4": "pe . . . // // ",
  "tha-ap423:15.1": "Itthaṃ sudam āyasmā Sakiṃsammajjako thero i. g. a-ti. Sakiṃsammajjakattherassa ",
  "tha-ap423:16.1": "apadānaṃ samattaṃ. "
