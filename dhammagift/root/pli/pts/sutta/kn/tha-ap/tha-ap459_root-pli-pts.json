  "tha-ap459:1.1": "Aṅgārajātā puthuvī ",
  "tha-ap459:1.2": "kukkulānugatā mahī / ",
  "tha-ap459:1.3": "Padumuttaro bhagavā ",
  "tha-ap459:1.4": "abbhokāsamhi caṅkami. // // ",
  "tha-ap459:2.1": "Paṇḍaraṃ chattaṃ ādāya ",
  "tha-ap459:2.2": "addhānaṃ paṭipajj' ahaṃ / ",
  "tha-ap459:2.3": "tattha disvāna sambuddhaṃ ",
  "tha-ap459:2.4": "vitti me upapajjatha. // // ",
  "tha-ap459:3.1": "Marīcivophuṭā bhūmi ",
  "tha-ap459:3.2": "aṅgārā va mahī ayaṃ / ",
  "tha-ap459:3.3": "upavāyanti mahāvātā ",
  "tha-ap459:3.4": "sarīrass' ānukhepanā // // ",
  "tha-ap459:4.1": "Sītaṃ uṇhaṃ viharanti; ",
  "tha-ap459:4.2": "vātātapanivāraṇaṃ / ",
  "tha-ap459:4.3": "patigaṇha imaṃ chattaṃ ",
  "tha-ap459:4.4": "phassayissāmi nibbutiṃ. // // ",
  "tha-ap459:5.1": "Anukampako kāruṇiko ",
  "tha-ap459:5.2": "Padumuttaro mahāyaso / ",
  "tha-ap459:5.3": "mama saṅkappam aññāya ",
  "tha-ap459:5.4": "patigaṇhi tadā jino. // // ",
  "tha-ap459:6.1": "Tiṃsakappāni devindo ",
  "tha-ap459:6.2": "devarajjam akārayiṃ / ",
  "tha-ap459:6.3": "satānaṃ pañcakkhattuñ ca ",
  "tha-ap459:6.4": "cakkavatti ahos' ahaṃ // // ",
  "tha-ap459:7.1": "Padesarajjaṃ vipulaṃ ",
  "tha-ap459:7.2": "gaṇahāto asaṅkhiyaṃ / ",
  "tha-ap459:7.3": "anubhomi sakaṃ kammaṃ ",
  "tha-ap459:7.4": "pubbe sukatam attano. // // ",
  "tha-ap459:8.1": "Ayaṃ me pacchimā jāti ",
  "tha-ap459:8.2": "carimo vattate bhavo / ",
  "tha-ap459:8.3": "ajjāpi setacchattaṃ me ",
  "tha-ap459:8.4": "sabbakālaṃ dhariyyati. // // Satasahasse ",
  "tha-ap459:9.1": "ito kappe ",
  "tha-ap459:9.2": "yaṃ chattam adadiṃ tadā / ",
  "tha-ap459:9.3": "duggatiṃ nābhijānāmi ",
  "tha-ap459:9.4": "chattadānass' idaṃ phalaṃ. // // ",
  "tha-ap459:10.1": "Kilesā . . . ",
  "tha-ap459:10.2": "pe . . . ",
  "tha-ap459:10.3": "",
  "tha-ap459:11.1": "",
  "tha-ap459:11.2": "pe . . . ",
  "tha-ap459:11.3": "pe . . . // // Sāgataṃ . . . pe . . . pe . . . pe . . . // // ",
  "tha-ap459:12.1": "Paṭisambhidā . . . ",
  "tha-ap459:12.2": "pe . . . ",
  "tha-ap459:12.3": "pe . . . pe . . . // // ",
  "tha-ap459:13.1": "Itthaṃ sudam āyasmā Ekachattiyo thero i. g. a-ti. Ekachattiyattherassa apadānaṃ samattaṃ. ",
  "tha-ap459:14.1": ""
}
