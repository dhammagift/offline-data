  "tha-ap214:0.3": "",
  "tha-ap214:1.1": "isino ",
  "tha-ap214:1.2": "cirarattatapassino / ",
  "tha-ap214:1.3": "vaddhassa bhāvitattassa ",
  "tha-ap214:1.4": "adāsiṃ pānadhim ahaṃ. // // ",
  "tha-ap214:2.1": "Tena kammena dipadinda ",
  "tha-ap214:2.2": "lokajeṭṭha narāsabha / ",
  "tha-ap214:2.3": "sabbaṃ yānam anubhomi ",
  "tha-ap214:2.4": "pubbakammass' idaṃ phalaṃ. // // ",
  "tha-ap214:3.1": "Ekūnavute ito kappe ",
  "tha-ap214:3.2": "yaṃ kammam akariṃ tadā / ",
  "tha-ap214:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap214:3.4": "pānadhissa idaṃ phalaṃ. // // ",
  "tha-ap214:4.1": "Sattasattati ito kappe ",
  "tha-ap214:4.2": "aṭṭha āsiṃsu khattiyā / ",
  "tha-ap214:4.3": "Suyānā nāma nāmena ",
  "tha-ap214:4.4": "cakkavattī mahabbalā. // // ",
  "tha-ap214:5.1": "Paṭisambhidā . . . ",
  "tha-ap214:5.2": "pe . . . ",
  "tha-ap214:5.3": "pe . . . // // ",
  "tha-ap214:6.1": "Itthaṃ sudam ayasmā Pānadhidāyako thero i. g. a-ti. Pānadhidāyakattherassa ",
  "tha-ap214:7.1": "apadānaṃ samattaṃ. "
}
