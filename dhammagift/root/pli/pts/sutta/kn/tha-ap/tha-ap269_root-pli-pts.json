  "tha-ap269:1.1": "Candabhāgānadītīre ",
  "tha-ap269:1.2": "āsiṃ vanacaro tadā / ",
  "tha-ap269:1.3": "Siddhattham addasaṃ Buddhaṃ ",
  "tha-ap269:1.4": "gacchantam anilañjase. // // ",
  "tha-ap269:2.1": "Añjaliṃ paggahetvāna ",
  "tha-ap269:2.2": "ullokento mahāmuniṃ / ",
  "tha-ap269:2.3": "sakaṃ cittaṃ pasādetvā ",
  "tha-ap269:2.4": "avandiṃ nāyakam ahaṃ. // // ",
  "tha-ap269:3.1": "*Catunavute* ito kappe ",
  "tha-ap269:3.2": "yam avandiṃ narāsabhaṃ / ",
  "tha-ap269:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap269:3.4": "vandanāya idaṃ phalaṃ. // // ",
  "tha-ap269:4.1": "Paṭisambhidā . . . ",
  "tha-ap269:4.2": "pe . . . ",
  "tha-ap269:4.3": "pe . . . // // ",
  "tha-ap269:5.1": "Itthaṃ sudam āyasmā Javahaṃsako thero i. g. a-ti. Javahaṃsakattherassa ",
  "tha-ap269:6.1": "apadānaṃ samattaṃ. "
}
