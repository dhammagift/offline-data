  "tha-ap225:1.1": "Migaluddo pure āsiṃ ",
  "tha-ap225:1.2": "araññe kānane ahaṃ / ",
  "tha-ap225:1.3": "addasaṃ virajaṃ Buddham ",
  "tha-ap225:1.4": "āhutīnaṃ paṭiggahaṃ. // // ",
  "tha-ap225:2.1": "Maṃsapesī mayā dinnā ",
  "tha-ap225:2.2": "Vipassissa mahesino / ",
  "tha-ap225:2.3": "sadevakasmiṃ lokasmiṃ ",
  "tha-ap225:2.4": "issaraṃ kārayām' ahaṃ. // // ",
  "tha-ap225:3.1": "*Iminā maṃsadānena ",
  "tha-ap225:3.2": "rata*naṃ nibbattate mamaṃ / ",
  "tha-ap225:3.3": "duve me ratanā loke ",
  "tha-ap225:3.4": "diṭṭhadhammassa pattiyā. // // ",
  "tha-ap225:4.1": "Te 'haṃ sabbe anubhomi ",
  "tha-ap225:4.2": "maṃsadānassa pattiyā / ",
  "tha-ap225:4.3": "gattañ ca mudukaṃ mayhaṃ ",
  "tha-ap225:4.4": "paññā nipuṇavedinī. // // Ekanavute ",
  "tha-ap225:5.1": "ito kappe ",
  "tha-ap225:5.2": "yaṃ maṃsaṃ adadim ahaṃ / ",
  "tha-ap225:5.3": "duggatiṃ nābhijānāmi ",
  "tha-ap225:5.4": "maṃsadānass' idaṃ phalaṃ. // // ",
  "tha-ap225:6.1": "Ito catutthake kappe ",
  "tha-ap225:6.2": "eko āsi janādhipo / ",
  "tha-ap225:6.3": "Mahārohita-nāmo so ",
  "tha-ap225:6.4": "cakkavattī mahabbalo. // // ",
  "tha-ap225:7.1": "Paṭisambhidā . . . ",
  "tha-ap225:7.2": "pe . . . ",
  "tha-ap225:7.3": "pe . . . // // ",
  "tha-ap225:8.1": "Itthaṃ sudam āyasmā Dverataniyo thero i. g. a- ",
  "tha-ap225:9.1": "ti. Dverataniyattherassa ",
  "tha-ap225:9.2": "apadānaṃ samattaṃ. "
}
