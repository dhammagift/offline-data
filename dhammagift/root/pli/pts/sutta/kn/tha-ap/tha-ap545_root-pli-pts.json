{
  "tha-ap545:0.1": "",
  "tha-ap545:0.2": "",
  "tha-ap545:0.3": "",
  "tha-ap545:1.1": "Padumuttaro nāma jino ",
  "tha-ap545:1.2": "sabbadhammesu cakkhumā / ",
  "tha-ap545:1.3": "ito satasahassamhi ",
  "tha-ap545:1.4": "kappe uppajji nāyako. // // ",
  "tha-ap545:2.1": "Sīlaṃ tassa asaṅkheyyaṃ ",
  "tha-ap545:2.2": "samādhi vajiropamo / ",
  "tha-ap545:2.3": "asaṅkhiyaṃ ñāṇavaraṃ ",
  "tha-ap545:2.4": "vimutti ca anopamā. // // ",
  "tha-ap545:3.1": "Manuj'-āmara-nāgānaṃ ",
  "tha-ap545:3.2": "brahmānañ ca samāgame / ",
  "tha-ap545:3.3": "samaṇabrāhmaṇākiṇṇo ",
  "tha-ap545:3.4": "dhammaṃ desesi nāyako. // // ",
  "tha-ap545:4.1": "Sa sāvakaṃ mahālābhiṃ ",
  "tha-ap545:4.2": "puññavantaṃ jutindharaṃ / ",
  "tha-ap545:4.3": "ṭhapesi etadaggamhi ",
  "tha-ap545:4.4": "parisāsu visārado. // // ",
  "tha-ap545:5.1": "Tadā 'haṃ khattiyo āsiṃ ",
  "tha-ap545:5.2": "nagare Haṃsasavhaye / ",
  "tha-ap545:5.3": "sutvā jinassa taṃ vākyaṃ ",
  "tha-ap545:5.4": "sāvakassa guṇaṃ bahuṃ. // // ",
  "tha-ap545:6.1": "Nimantayitvā sattāhaṃ ",
  "tha-ap545:6.2": "bhojayitvā sasāvakaṃ. / ",
  "tha-ap545:6.3": "mahādānaṃ daditvāna ",
  "tha-ap545:6.4": "taṃ ṭhānaṃ abhipatthayiṃ. // // ",
  "tha-ap545:7.1": "Tadā maṃ vinataṃ pāde ",
  "tha-ap545:7.2": "disvāna purisāsabho / ",
  "tha-ap545:7.3": "susarena mahāvīro ",
  "tha-ap545:7.4": "imaṃ vacanam abravi: // // ",
  "tha-ap545:8.1": "Tato jinassa vacanaṃ ",
  "tha-ap545:8.2": "sotukāmā mahājanā / ",
  "tha-ap545:8.3": "deva-dānava-gandhabbā ",
  "tha-ap545:8.4": "brāhmaṇā ca mahiddhikā. // // ",
  "tha-ap545:9.1": "Samaṇā brāhmaṇā c' eva ",
  "tha-ap545:9.2": "namassīsu katañjalī / ",
  "tha-ap545:9.3": "\"namo te purisājañña! ",
  "tha-ap545:9.4": "namo te purisuttama! // // ",
  "tha-ap545:10.1": "Khattiyena mahādānaṃ ",
  "tha-ap545:10.2": "dinnaṃ sattāhikaṃ vibho / ",
  "tha-ap545:10.3": "sotukāmā phalaṃ tassa; ",
  "tha-ap545:10.4": "vyākarohi mahāmune\". // // ",
  "tha-ap545:11.1": "Tato avoca bhagavā ",
  "tha-ap545:11.2": "suṇotha mama bhāsitaṃ: / ",
  "tha-ap545:11.3": "appameyyamhi Buddhamhi ",
  "tha-ap545:11.4": "saṅghamhi suppatiṭṭhitā // // ",
  "tha-ap545:12.1": "Dakkhiṇādāya kho-v-atthaṃ? ",
  "tha-ap545:12.2": "Appameyyaphalā hi sā / ",
  "tha-ap545:12.3": "api ve sa mahābhogo ",
  "tha-ap545:12.4": "ṭhānaṃ pattheti uttamaṃ. // // ",
  "tha-ap545:13.1": "Lābhī vipulalābhānaṃ ",
  "tha-ap545:13.2": "yathā bhikkhu sudassano / ",
  "tha-ap545:13.3": "tathā 'ham pi bhaveyyan ti ",
  "tha-ap545:13.4": "lacchate taṃ anāgate. // // ",
  "tha-ap545:14.1": "Satasahasse ito kappe ",
  "tha-ap545:14.2": "Okkākakulasambhavo / ",
  "tha-ap545:14.3": "Gotamo nāma nāmena ",
  "tha-ap545:14.4": "satthā loke bhavissati. // // ",
  "tha-ap545:15.1": "Tassa dhammesu dāyādo ",
  "tha-ap545:15.2": "oraso dhammanimmito / ",
  "tha-ap545:15.3": "Sīvali nāma nāmena ",
  "tha-ap545:15.4": "hessati satthu sāvako. // // ",
  "tha-ap545:16.1": "Tena kammena sukatena ",
  "tha-ap545:16.2": "cetanāpaṇidhīhi ca / ",
  "tha-ap545:16.3": "jahitvā mānusaṃ dehaṃ ",
  "tha-ap545:16.4": "Tāvatiṃsūpago ahaṃ. // // ",
  "tha-ap545:17.1": "Ekanavute ito kappe ",
  "tha-ap545:17.2": "Vipassī lokanāyako / ",
  "tha-ap545:17.3": "uppajji cārunayano ",
  "tha-ap545:17.4": "sabbadhammavipassako. // // ",
  "tha-ap545:18.1": "Tadā 'haṃ Bandhumatiyā ",
  "tha-ap545:18.2": "kulass' aññatarassa ca / ",
  "tha-ap545:18.3": "dayito patthito c' eva ",
  "tha-ap545:18.4": "āsi kammantavyāvaṭo. // // ",
  "tha-ap545:19.1": "Tadā aññataro pūgo ",
  "tha-ap545:19.2": "Vipassissa mahesino / ",
  "tha-ap545:19.3": "pariveṇaṃ akāresi mahantam iti ",
  "tha-ap545:19.4": "vissutaṃ. // // ",
  "tha-ap545:20.1": "Niṭṭhite ca mahādānaṃ dadaṃ ",
  "tha-ap545:20.2": "khajjakasaññutaṃ / navadadhim ",
  "tha-ap545:20.3": "madhuṃ c' eva ",
  "tha-ap545:20.4": "vicinaṃ neva addasaṃ // // ",
  "tha-ap545:21.1": "Tadā bhattaṃ gahetvāna ",
  "tha-ap545:21.2": "navaṃ dadhim madhum pi ca / ",
  "tha-ap545:21.3": "kammasāmigharaṃ gacchan tam esantaṃ ",
  "tha-ap545:21.4": "tam addasaṃ. // // ",
  "tha-ap545:22.1": "Sahassam api datvāna ",
  "tha-ap545:22.2": "nālabhittha sat' aṃvayaṃ / ",
  "tha-ap545:22.3": "tato 'haṃ evaṃ cintesiṃ: ",
  "tha-ap545:22.4": "n' etaṃ hessati orakaṃ. // // ",
  "tha-ap545:23.1": "Yathā ime janā sabbe ",
  "tha-ap545:23.2": "sakkaronti Tathāgataṃ / ",
  "tha-ap545:23.3": "aham pi kāraṃ karissāmi ",
  "tha-ap545:23.4": "sasaṅghe lokanāyake. // // ",
  "tha-ap545:24.1": "Tadā 'ham evañ cintetvā ",
  "tha-ap545:24.2": "dadhiṃ madhuñ ca ekato / ",
  "tha-ap545:24.3": "moditvā lokanāthassa ",
  "tha-ap545:24.4": "sasaṅghassa adās' ahaṃ. // // ",
  "tha-ap545:25.1": "Tena kammena sukatena ",
  "tha-ap545:25.2": "cetanāpaṇidhīhi ca / ",
  "tha-ap545:25.3": "jahitvā mānusaṃ dehaṃ ",
  "tha-ap545:25.4": "Tāvatiṃsaṃ agacch ahaṃ // // ",
  "tha-ap545:26.1": "Puṇāhaṃ Bārāṇasiyaṃ ",
  "tha-ap545:26.2": "rājā hutvā mahāyaso / ",
  "tha-ap545:26.3": "sattukassa tadā Buddho ",
  "tha-ap545:26.4": "dvārarodhaṃ akārayiṃ. // // ",
  "tha-ap545:27.1": "Tadā tapassino ruddhā ",
  "tha-ap545:27.2": "ekāham rakkhitā ahuṃ / ",
  "tha-ap545:27.3": "tato tassa vipākena ",
  "tha-ap545:27.4": "pāpattaṃ nirayaṃ bhusaṃ. // // ",
  "tha-ap545:28.1": "Pacchime ca bhave dāni ",
  "tha-ap545:28.2": "jāto 'haṃ Koliye pure / ",
  "tha-ap545:28.3": "Suppavāsā ca me mātā ",
  "tha-ap545:28.4": "Mahālī Licchavī pitā. // // ",
  "tha-ap545:29.1": "Khattiyena puññakammena ",
  "tha-ap545:29.2": "dvārarodhassa vāhasā / ",
  "tha-ap545:29.3": "sattavassāni nivasī ",
  "tha-ap545:29.4": "mātukucchimhi dukkhito. // // ",
  "tha-ap545:30.1": "Sattāhaṃ dvāramūḷho 'haṃ ",
  "tha-ap545:30.2": "mahādukkhasamappito / ",
  "tha-ap545:30.3": "mātā me chandadānena ",
  "tha-ap545:30.4": "evaṃ āsi sudukkhitā. // // ",
  "tha-ap545:31.1": "Sāvatthito 'haṃ nikkhanto ",
  "tha-ap545:31.2": "Buddhena anukampito / ",
  "tha-ap545:31.3": "nikkhantadivase yeva ",
  "tha-ap545:31.4": "pabbajiṃ anagāriyaṃ. // // ",
  "tha-ap545:32.1": "Upajjhā Sāriputto me ",
  "tha-ap545:32.2": "Moggallāno mahiddhiko / ",
  "tha-ap545:32.3": "kese oropayanto me ",
  "tha-ap545:32.4": "anusāsi mahāmati. // // ",
  "tha-ap545:33.1": "Kesesu chijjamānesu ",
  "tha-ap545:33.2": "arahattaṃ apāpuṇiṃ / ",
  "tha-ap545:33.3": "deva-nāga-manussā ca ",
  "tha-ap545:33.4": "paccayān' upanenti me. // // ",
  "tha-ap545:34.1": "Padumuttara-nāmañ ca ",
  "tha-ap545:34.2": "Vipassiñ ca cināyakaṃ / ",
  "tha-ap545:34.3": "yaṃ pūjayiṃ pamudito ",
  "tha-ap545:34.4": "paccayehi visesato. // // ",
  "tha-ap545:35.1": "Tato tesaṃ visesena ",
  "tha-ap545:35.2": "kammānaṃ vipuluttamaṃ / ",
  "tha-ap545:35.3": "lābhaṃ labhāmi sabbattha ",
  "tha-ap545:35.4": "vane gāme jale thale. // // ",
  "tha-ap545:36.1": "Revataṃ dassanatthāya ",
  "tha-ap545:36.2": "yadā yāti vināyako / ",
  "tha-ap545:36.3": "tiṃsabhikkhusahassehi ",
  "tha-ap545:36.4": "saha lokagganāyako // // ",
  "tha-ap545:37.1": "Tadā dev' opanītehi ",
  "tha-ap545:37.2": "mamatthāya mahāmati / ",
  "tha-ap545:37.3": "paccayehi mahāvīro ",
  "tha-ap545:37.4": "sasaṅgho lokanāyako // // ",
  "tha-ap545:38.1": "Upaṭṭhito mayā Buddho, ",
  "tha-ap545:38.2": "gantvā Revatam addasaṃ / ",
  "tha-ap545:38.3": "tato Jetavanaṃ gantvā ",
  "tha-ap545:38.4": "etadagge ṭhapesi maṃ. // // ",
  "tha-ap545:39.1": "Lābhīnaṃ Sīvalī aggo ",
  "tha-ap545:39.2": "mama sissesu bhikkhavo / ",
  "tha-ap545:39.3": "sabbalokahito satthā ",
  "tha-ap545:39.4": "kittayiṃ parisāsu maṃ. // // ",
  "tha-ap545:40.1": "Kilesā . . . ",
  "tha-ap545:40.2": "pe . . . ",
  "tha-ap545:40.3": "",
  "tha-ap545:41.1": "",
  "tha-ap545:41.2": "pe . . . ",
  "tha-ap545:41.3": "pe . . . // // Sāgataṃ . . . pe . . . pe . . . pe . . . // // ",
  "tha-ap545:42.1": "Paṭisambhidā . . . ",
  "tha-ap545:42.2": "pe . . . ",
  "tha-ap545:42.3": "pe . . . pe . . . // // ",
  "tha-ap545:43.1": "Itthaṃ sudaṃ āyasmā Sīvalī thero i. g. a-ti. ",
  "tha-ap545:44.1": "Sīvalittherassa apadānaṃ samattaṃ. "
}
