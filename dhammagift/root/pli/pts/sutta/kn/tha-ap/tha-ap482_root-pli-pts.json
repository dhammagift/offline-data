  "tha-ap482:1.1": "Migaluddo pure āsiṃ ",
  "tha-ap482:1.2": "araññe kānane ahaṃ / ",
  "tha-ap482:1.3": "vātamigaṃ gavesanto ",
  "tha-ap482:1.4": "caṅkamaṃ addasaṃ ahaṃ. // // ",
  "tha-ap482:2.1": "Ucchaṅgapulinaṃ gayha ",
  "tha-ap482:2.2": "caṅkame okiriṃ ahaṃ / ",
  "tha-ap482:2.3": "pasannacitto sumano ",
  "tha-ap482:2.4": "sugatassa sirīmato. // // ",
  "tha-ap482:3.1": "Ekatiṃse ito kappe ",
  "tha-ap482:3.2": "pulinaṃ okiriṃ ahaṃ / ",
  "tha-ap482:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap482:3.4": "puḷinassa idaṃ phalaṃ. // // ",
  "tha-ap482:4.1": "Kilesā . . . ",
  "tha-ap482:4.2": "pe . . . ",
  "tha-ap482:4.3": "",
  "tha-ap482:5.1": "",
  "tha-ap482:5.2": "pe . . . ",
  "tha-ap482:5.3": "pe . . . // // Sāgataṃ . . . pe . . . pe . . . pe . . . // // ",
  "tha-ap482:6.1": "Paṭisambhidā . . . ",
  "tha-ap482:6.2": "pe . . . ",
  "tha-ap482:6.3": "pe . . . pe . . . // // ",
  "tha-ap482:7.1": "Itthaṃ sudam āyasmā Pulinacaṅkamiyo th. i. g. a- ",
  "tha-ap482:8.1": "ti. Pulinacaṅkamiyattherassa ",
  "tha-ap482:9.1": "apadānaṃ samattaṃ. ",
  "tha-ap482:10.1": "Uddānaṃ: ",
  "tha-ap482:11.1": "Naḷamālī Maṇidado ",
  "tha-ap482:11.2": "Ukkāsatika Vījanī ",
  "tha-ap482:11.3": "Kummāso ca Kusaṭṭho ca ",
  "tha-ap482:11.4": "Giripunnāgiyo pi ca ",
  "tha-ap482:12.1": "Valliṅkaro Pānadhido ",
  "tha-ap482:12.2": "atha Pulinacaṅkamo ",
  "tha-ap482:12.3": "gāthāyo pañcanavuti ",
  "tha-ap482:12.4": "gaṇitāyo vibhāvihi. "
}
