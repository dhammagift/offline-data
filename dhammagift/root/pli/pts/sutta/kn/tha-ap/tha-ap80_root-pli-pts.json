  "tha-ap80:0.2": "",
  "tha-ap80:0.3": "",
  "tha-ap80:1.1": "Suvaṇṇavaṇṇaṃ sambuddhaṃ ",
  "tha-ap80:1.2": "gacchantaṃ antarāpaṇe / ",
  "tha-ap80:1.3": "kañcanagghiyasaṅkāsaṃ ",
  "tha-ap80:1.4": "dvattiṃsavaralakkhaṇaṃ. // // ",
  "tha-ap80:2.1": "Seṭṭhiputto tadā āsiṃ ",
  "tha-ap80:2.2": "sukhumālo sukheṭhito / ",
  "tha-ap80:2.3": "ucchaṅge pāṭalīpupphaṃ ",
  "tha-ap80:2.4": "katvā taṃ abhisaṃhariṃ. // // ",
  "tha-ap80:3.1": "Haṭṭho haṭṭhena cittena ",
  "tha-ap80:3.2": "pupphena abhipūjayiṃ / ",
  "tha-ap80:3.3": "Tissaṃ lokaviduṃ nāthaṃ ",
  "tha-ap80:3.4": "naradevaṃ namass' ahaṃ. // // ",
  "tha-ap80:4.1": "Dvenavute ito kappe ",
  "tha-ap80:4.2": "yaṃ kammam akariṃ tadā / ",
  "tha-ap80:4.3": "duggatiṃ nābhijānāmi ",
  "tha-ap80:4.4": "pupphapūjāy' idaṃ phalaṃ. // // ",
  "tha-ap80:5.1": "Ito tesaṭṭhi kappamhi ",
  "tha-ap80:5.2": "Abhisammata-nāmako / ",
  "tha-ap80:5.3": "sattaratanasampanno ",
  "tha-ap80:5.4": "cakkavatti mahābalo. // // ",
  "tha-ap80:6.1": "Paṭisambhidā catasso ",
  "tha-ap80:6.2": "vimokhā pi ca aṭṭh' ime / chaḍabhiññā sacchikatā ",
  "tha-ap80:6.3": "kataṃ buddhassa sāsanan ti. // // ",
  "tha-ap80:7.1": "Itthaṃ sudaṃ āyasmā Pāṭalipupphiyo thero imā gāthāyo abhāsitthā ti. Pāṭalipupphiyatherassa apadānaṃ samattaṃ. ",
  "tha-ap80:8.1": ""
}
