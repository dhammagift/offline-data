  "tha-ap429:1.1": "Padumuttaro nāma jino ",
  "tha-ap429:1.2": "sabbadhammāna pāragū / ",
  "tha-ap429:1.3": "catusaccam pakāsento ",
  "tha-ap429:1.4": "santāreti bahūjanaṃ. // // ",
  "tha-ap429:2.1": "Ahaṃ tena samayena ",
  "tha-ap429:2.2": "jaṭilo uggatāpano / ",
  "tha-ap429:2.3": "dhunanto vākacīrāni ",
  "tha-ap429:2.4": "gacchāmi ambare tadā. // // ",
  "tha-ap429:3.1": "Buddhaseṭṭhassa upari ",
  "tha-ap429:3.2": "gantuṃ na visahām' ahaṃ / ",
  "tha-ap429:3.3": "pakkhī va selam āsajja ",
  "tha-ap429:3.4": "gamanaṃ na labhām' ahaṃ. // // ",
  "tha-ap429:4.1": "Udake vomisitvāna ",
  "tha-ap429:4.2": "evam gacchāmi ambare / ",
  "tha-ap429:4.3": "na me idaṃ bhūtapubbam ",
  "tha-ap429:4.4": "iriyāpathavikopanaṃ. // // ",
  "tha-ap429:5.1": "Handa me taṃ gavesissam ",
  "tha-ap429:5.2": "appev' atthaṃ labheyy' ahaṃ / ",
  "tha-ap429:5.3": "orohanto antalikkhā ",
  "tha-ap429:5.4": "saddam assosi satthuno. // // ",
  "tha-ap429:6.1": "Sarena rajanīyena ",
  "tha-ap429:6.2": "savanīyena vaggunā / ",
  "tha-ap429:6.3": "aniccataṃ kathentassa ",
  "tha-ap429:6.4": "tañ ñeva uggahiṃ tadā. // // ",
  "tha-ap429:6.5": "Aniccasaññam uggayha ",
  "tha-ap429:6.6": "agamāsiṃ mam assamaṃ / ",
  "tha-ap429:7.1": "yāvatāyuṃ vasitvāna ",
  "tha-ap429:7.2": "tattha kālakato ahaṃ. // // ",
  "tha-ap429:7.3": "Carime vattamānamhi ",
  "tha-ap429:7.4": "saddhammasavanaṃ sariṃ / ",
  "tha-ap429:8.1": "tena kammena sukatena ",
  "tha-ap429:8.2": "cetanāpaṇidhīhi ca / ",
  "tha-ap429:8.3": "jahitvā mānusaṃ dehaṃ ",
  "tha-ap429:8.4": "Tāvatiṃsam agacch' ahaṃ. // // ",
  "tha-ap429:9.1": "Tiṃsakappasahassāni ",
  "tha-ap429:9.2": "devaloke ramim ahaṃ / ",
  "tha-ap429:9.3": "ekapaññāsakkhattuñ ca ",
  "tha-ap429:9.4": "devarajjam akārayiṃ. // // ",
  "tha-ap429:10.1": "Ekavīsatikkhattuñ ca ",
  "tha-ap429:10.2": "cakkavattī ahos' ahaṃ / ",
  "tha-ap429:10.3": "padesarajjaṃ vipulaṃ ",
  "tha-ap429:10.4": "gaṇanāto asaṅkhiyaṃ. // // ",
  "tha-ap429:11.1": "Anubhosiṃ sakaṃ puññaṃ ",
  "tha-ap429:11.2": "sukhito 'haṃ bhavābhave / ",
  "tha-ap429:11.3": "anussarāmi taṃ saññaṃ ",
  "tha-ap429:11.4": "saṃsaranto bhavābhave / ",
  "tha-ap429:11.5": "na koṭipaṭivijjhāmi ",
  "tha-ap429:11.6": "nibbānam accutaṃ padaṃ. // // ",
  "tha-ap429:12.1": "Pitugehe nisīditvā ",
  "tha-ap429:12.2": "samaṇo bhāvitindriyo / ",
  "tha-ap429:12.3": "kathāyaṃ paridīpento ",
  "tha-ap429:12.4": "aniccaṃ vatthudāhariṃ. // // ",
  "tha-ap429:13.1": "Aniccā vata saṅkhārā ",
  "tha-ap429:13.2": "uppādavayadhammino / ",
  "tha-ap429:13.3": "uppajjitvā nirujjhanti ",
  "tha-ap429:13.4": "tesaṃ vūpasamo sukho. // // ",
  "tha-ap429:14.1": "Saha gāthaṃ suṇitvāna ",
  "tha-ap429:14.2": "pubbasaññām anussariṃ / ",
  "tha-ap429:14.3": "ekāsane nisīditvā ",
  "tha-ap429:14.4": "arahattam apāpuṇiṃ. // // ",
  "tha-ap429:15.1": "Jātiyā sattavassena ",
  "tha-ap429:15.2": "arahattam apāpuṇiṃ / ",
  "tha-ap429:15.3": "upasampādayī Buddho ",
  "tha-ap429:15.4": "dhammasavanass' idaṃ phalaṃ. // // ",
  "tha-ap429:16.1": "Satasahasse ito kappe ",
  "tha-ap429:16.2": "yaṃ dhammam asuṇiṃ tadā / ",
  "tha-ap429:16.3": "duggatiṃ nābhijānāmi ",
  "tha-ap429:16.4": "dhammasavanass' idaṃ phalaṃ. // // ",
  "tha-ap429:17.1": "Kilesā . . . ",
  "tha-ap429:17.2": "pe . . . ",
  "tha-ap429:17.3": "",
  "tha-ap429:18.1": "",
  "tha-ap429:18.2": "pe . . . ",
  "tha-ap429:18.3": "pe . . . // // Sāgataṃ . . . pe . . . pe . . . pe . . . // // ",
  "tha-ap429:19.1": "Paṭisambhidā . . . ",
  "tha-ap429:19.2": "pe . . . ",
  "tha-ap429:19.3": "pe . . . pe . . . // // ",
  "tha-ap429:20.1": "Itthaṃ sudam āyasmā Ekadhammasavanīyo th. i. g. a-ti. Ekadhammasavanīyattherassa ",
  "tha-ap429:21.1": "apadānaṃ samattaṃ. "
}
