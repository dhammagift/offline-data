  "tha-ap151:0.3": "",
  "tha-ap151:1.1": "Sumedho nāma nāmena ",
  "tha-ap151:1.2": "sayambhū aparājito / ",
  "tha-ap151:1.3": "vivekam anubrūhanto ",
  "tha-ap151:1.4": "ajjhogahi mahāvanaṃ. // // ",
  "tha-ap151:2.1": "Salalaṃ pupphitaṃ disvā ",
  "tha-ap151:2.2": "bandhitvāna vaṭaṃsakaṃ / ",
  "tha-ap151:2.3": "Buddhassa abhiropesiṃ ",
  "tha-ap151:2.4": "sammukhā lokanāyakaṃ. // // ",
  "tha-ap151:3.1": "Tiṃsakappasahassamhi ",
  "tha-ap151:3.2": "yaṃ puppham abhiropayiṃ / ",
  "tha-ap151:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap151:3.4": "buddhapūjāy' idaṃ phalaṃ. // // ",
  "tha-ap151:4.1": "Ūnavīse kappasate ",
  "tha-ap151:4.2": "solas' āsiṃsu Nimmitā / ",
  "tha-ap151:4.3": "sattaratanasampannā ",
  "tha-ap151:4.4": "cakkavattī mahābalā. // // ",
  "tha-ap151:5.1": "Paṭisambhidā . . . ",
  "tha-ap151:5.2": "pe . . . ",
  "tha-ap151:5.3": "pe . . . // // ",
  "tha-ap151:6.1": "Itthaṃ sudaṃ ā. Vaṭaṃsakiyo thero i. g. a-ti. Vaṭaṃsakiyattherassa ",
  "tha-ap151:7.1": "apadānaṃ samattaṃ. "
}
