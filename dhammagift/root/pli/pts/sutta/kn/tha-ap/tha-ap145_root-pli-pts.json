  "tha-ap145:0.3": "",
  "tha-ap145:1.1": "Nibbute lokanāthamhi ",
  "tha-ap145:1.2": "Piyadassi-naruttame / ",
  "tha-ap145:1.3": "pasannacitto sumano ",
  "tha-ap145:1.4": "Buddhavedim akās' ahaṃ // // ",
  "tha-ap145:2.1": "Maṇīhi parivāretvā ",
  "tha-ap145:2.2": "akāsiṃ maham uttamaṃ / ",
  "tha-ap145:2.3": "vedikāya-mahaṃ katvā ",
  "tha-ap145:2.4": "tattha kālakato ahaṃ. // // ",
  "tha-ap145:3.1": "Yaṃ yaṃ yonūpapajjāmi ",
  "tha-ap145:3.2": "devattaṃ atha mānusaṃ / ",
  "tha-ap145:3.3": "maṇī dhārenti ākāse ",
  "tha-ap145:3.4": "puññakammass' idaṃ phalaṃ // // ",
  "tha-ap145:4.1": "Soḷase 'to kappasate ",
  "tha-ap145:4.2": "Maṇippabhāsanāmakā / ",
  "tha-ap145:4.3": "battiṃs' āsiṃsu rājāno ",
  "tha-ap145:4.4": "cakkavattī mahābalā. // // ",
  "tha-ap145:5.1": "Paṭisambhidā . . . ",
  "tha-ap145:5.2": "pe . . . ",
  "tha-ap145:5.3": "pe . . . // // ",
  "tha-ap145:6.1": "Itthaṃ sudaṃ ā. Vedikārako thero i. g. ā-ti. Vedikārakattherassa ",
  "tha-ap145:7.1": "apadānaṃ samattaṃ. "
}
