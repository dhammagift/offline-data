  "tha-ap312:0.2": "",
  "tha-ap312:0.3": "",
  "tha-ap312:1.1": "Piyadassino bhagavato ",
  "tha-ap312:1.2": "pabbhāro sodhito mayā / ",
  "tha-ap312:1.3": "ghaṭakañ ca upaṭṭhāsiṃ ",
  "tha-ap312:1.4": "paribhogāya tādino. // // ",
  "tha-ap312:2.1": "Tam me buddho viyākāsi ",
  "tha-ap312:2.2": "Piyadassī mahāmuni: / ",
  "tha-ap312:2.3": "sahassakaṇḍo satageṇḍu ",
  "tha-ap312:2.4": "dhajālu haritāmayo // // ",
  "tha-ap312:3.1": "Nibbattissati so yūpo ",
  "tha-ap312:3.2": "ratanañ ca anappakaṃ / ",
  "tha-ap312:3.3": "pabbhāradānaṃ datvāna ",
  "tha-ap312:3.4": "kappaṃ saggamhi mod' ahaṃ. // // ",
  "tha-ap312:4.1": "Ito battiṃsakappamhi ",
  "tha-ap312:4.2": "Susuddho nāma khattiyo / ",
  "tha-ap312:4.3": "sattaratanasampanno ",
  "tha-ap312:4.4": "cakkavattī mahabbalo. // // ",
  "tha-ap312:5.1": "Paṭisambhidā . . . ",
  "tha-ap312:5.2": "pe . . . ",
  "tha-ap312:5.3": "pe . . . // // ",
  "tha-ap312:6.1": "Itthaṃ sudam āyasmā Pabbhāradāyako th. i. g. a- ti. Pabbhāradāyakattherassa ",
  "tha-ap312:7.1": "",
  "tha-ap312:8.1": "apadānaṃ samattaṃ. ",
  "tha-ap312:9.1": "Uddānaṃ: ",
  "tha-ap312:10.1": "Kesaraṃ-Gandham-Annañ ca ",
  "tha-ap312:10.2": "Dhammasañña-Pha- lena ca ",
  "tha-ap312:10.3": "Pasād'-Ārāmadāyī ca ",
  "tha-ap312:10.4": "Lomako Buddhasaññako ",
  "tha-ap312:10.5": "Pabbhārado ca gāthāyo ",
  "tha-ap312:10.6": "ekūnapaññāsa kittitā. Padumakesariyavaggo ekatiṃsatimo. "
}
