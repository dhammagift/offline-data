  "tha-ap190:0.3": "",
  "tha-ap190:1.1": "Devabhūto ahaṃ santo ",
  "tha-ap190:1.2": "accharāhi purakkhato / ",
  "tha-ap190:1.3": "pubbaṃ kammaṃ saritvāna ",
  "tha-ap190:1.4": "Buddhaseṭṭham anussariṃ // // ",
  "tha-ap190:2.1": "Tikaṇṇipupphaṃ paggayha ",
  "tha-ap190:2.2": "sakaṃ cittaṃ pasādayiṃ / ",
  "tha-ap190:2.3": "Buddhassa abhiropesiṃ ",
  "tha-ap190:2.4": "Vipassimhi narāsabhe // // ",
  "tha-ap190:3.1": "Ekanavute ito kappe ",
  "tha-ap190:3.2": "yaṃ puppham abhiropayiṃ / ",
  "tha-ap190:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap190:3.4": "Buddhapūjāy' idaṃ phalaṃ. // // ",
  "tha-ap190:4.1": "Tesattati ito kappe ",
  "tha-ap190:4.2": "catur āsuṃ naruttamā / ",
  "tha-ap190:4.3": "sattaratanasampannā ",
  "tha-ap190:4.4": "cakkavattī mahabbalā. // // ",
  "tha-ap190:5.1": "Paṭisambhidā . . . ",
  "tha-ap190:5.2": "pe . . . ",
  "tha-ap190:5.3": "pe . . . // // ",
  "tha-ap190:6.1": "Itthaṃ sudam āyasmā Tikaṇṇipupphiyo thero i. g. a-ti. Tikaṇṇipupphiyattherassa ",
  "tha-ap190:7.1": "apadānaṃ samattaṃ. "
}
