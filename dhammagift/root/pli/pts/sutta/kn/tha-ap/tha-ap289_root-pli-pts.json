  "tha-ap289:1.1": "Apadānaṃ sugatānaṃ ",
  "tha-ap289:1.2": "kittayissaṃ mahesinaṃ / ",
  "tha-ap289:1.3": "pāde ca sirasā vandiṃ ",
  "tha-ap289:1.4": "pasanno sehi pāṇihi. // // ",
  "tha-ap289:2.1": "Dvenavute ito kappe ",
  "tha-ap289:2.2": "apadānaṃ pakittayiṃ / ",
  "tha-ap289:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap289:2.4": "kittanāya idaṃ phalaṃ. // // ",
  "tha-ap289:3.1": "Paṭisambhidā . . . ",
  "tha-ap289:3.2": "pe . . . ",
  "tha-ap289:3.3": "pe . . . // // ",
  "tha-ap289:4.1": "Itthaṃ sudam āyasmā Apadāniyo thero i. g. a-ti. Apadāniyattherassa apadānaṃ samattaṃ. ",
  "tha-ap289:5.1": ""
}
