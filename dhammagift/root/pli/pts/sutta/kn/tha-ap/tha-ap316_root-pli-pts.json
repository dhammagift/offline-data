  "tha-ap316:1.1": "Nadī*kūle vasāmāhaṃ ",
  "tha-ap316:1.2": "Nesādo nā*ma brāhmaṇo / ",
  "tha-ap316:1.3": "satapattehi pupphehi ",
  "tha-ap316:1.4": "sammajjitvāna assamaṃ. // // ",
  "tha-ap316:2.1": "Suvaṇṇavaṇṇaṃ sambuddhaṃ ",
  "tha-ap316:2.2": "Siddhatthaṃ lokanāyakaṃ / ",
  "tha-ap316:2.3": "disvā 'va vane gacchantaṃ ",
  "tha-ap316:2.4": "hāso me udapajjatha. // // ",
  "tha-ap316:3.1": "Paccuggantvāna sa*mbuddhaṃ ",
  "tha-ap316:3.2": "lokajeṭṭhaṃ narāsabhaṃ* / ",
  "tha-ap316:3.3": "assamam atināmetvā ",
  "tha-ap316:3.4": "jalajaggehi okiriṃ. // // ",
  "tha-ap316:4.1": "Catunavute ito kappe ",
  "tha-ap316:4.2": "yaṃ puppham abhipūjayiṃ / ",
  "tha-ap316:4.3": "duggatiṃ nābhijānāmi ",
  "tha-ap316:4.4": "Buddhasaññāy' idaṃ phalaṃ. // // ",
  "tha-ap316:5.1": "Ito te sattame kappe ",
  "tha-ap316:5.2": "*caturo Pādapāvarā / ",
  "tha-ap316:5.3": "sattaratanasa*mpannā ",
  "tha-ap316:5.4": "cakkavattī mahabbalā. // // ",
  "tha-ap316:6.1": "Paṭisambhidā . . . ",
  "tha-ap316:6.2": "pe . . . ",
  "tha-ap316:6.3": "pe . . . // // ",
  "tha-ap316:7.1": "Itthaṃ sudam āyasmā Sattapaduminiyo thero i. g. a-ti. Sattapaduminiyattherassa ",
  "tha-ap316:8.1": "apadānaṃ samattaṃ. "
}
