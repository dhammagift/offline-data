  "tha-ap302:1.1": "Piṇḍāya caramānāhaṃ ",
  "tha-ap302:1.2": "Vipassim addasaṃ jinaṃ / ",
  "tha-ap302:1.3": "Uluṅkabhikkhaṃ pādāsiṃ ",
  "tha-ap302:1.4": "dipadindassa tadino. // // ",
  "tha-ap302:2.1": "Pasannacitto sumano ",
  "tha-ap302:2.2": "abhivādes' ahaṃ tadā / ",
  "tha-ap302:2.3": "anusaṃsāvayiṃ Buddham ",
  "tha-ap302:2.4": "uttamatthassa pattiyā. // // ",
  "tha-ap302:3.1": "Ito ekanavute kappe ",
  "tha-ap302:3.2": "anusaṃsāvayim ahaṃ / ",
  "tha-ap302:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap302:3.4": "anusaṃsāvanā phalaṃ. // // ",
  "tha-ap302:4.1": "Paṭisambhidā . . . ",
  "tha-ap302:4.2": "pe . . . ",
  "tha-ap302:4.3": "pe . . . // // ",
  "tha-ap302:5.1": "Itthaṃ sudam āyasmā Anusaṃsāvako thero i. g. a- ",
  "tha-ap302:6.1": "ti. Anusaṃsāvakattherassa ",
  "tha-ap302:6.2": "apadānaṃ samattaṃ. ",
  "tha-ap302:7.1": "Uddānaṃ: ",
  "tha-ap302:8.1": "Citakaṃ Pārichatto ca ",
  "tha-ap302:8.2": "Saddaṃ Gosīsasantharaṃ ",
  "tha-ap302:8.3": "Padaṃ Padesaṃ Saraṇaṃ ",
  "tha-ap302:8.4": "Ambo Saṃsāvako pi ca ",
  "tha-ap302:8.5": "sattatālīsa gāthāyo ",
  "tha-ap302:8.6": "gaṇitāyo vibhāvihi. ",
  "tha-ap302:9.1": "Atha vaggUddānaṃ: ",
  "tha-ap302:10.1": "Kaṇṇikāro Hatthidado ",
  "tha-ap302:10.2": "Ālamban-Udakāsana ",
  "tha-ap302:10.3": "Tuvaraṃ Thomano c' eva ",
  "tha-ap302:10.4": "Ukkhepaṃ Sīsupadhānaṃ. ",
  "tha-ap302:11.1": "Paṇṇado Citapūjī ca ",
  "tha-ap302:11.2": "gāthā c' ev' esā *sabbaso* ",
  "tha-ap302:11.3": "cattārīsa satānīha ",
  "tha-ap302:11.4": "ekapaññāsam-eva ca. ",
  "tha-ap302:12.1": "Pañcavīsasatā sabbā ",
  "tha-ap302:12.2": "dvāsattari taduttariṃ ",
  "tha-ap302:12.3": "tisatān apadānaṃ ",
  "tha-ap302:12.4": "gaṇitā atthadassīhi. ",
  "tha-ap302:13.1": "Tatiyaṃ ",
  "tha-ap302:14.1": "satakaṃ samattaṃ. "
}
