{
  "tha-ap122:0.1": "",
  "tha-ap122:0.2": "",
  "tha-ap122:0.3": "",
  "tha-ap122:1.1": "Jāyantassa Vipassissa ",
  "tha-ap122:1.2": "āloko vipulo ahu / ",
  "tha-ap122:1.3": "paṭhavī va pakampittha ",
  "tha-ap122:1.4": "sasāgarasapabbatā. // // ",
  "tha-ap122:2.1": "Nemittā ca viyākaṃsu: ",
  "tha-ap122:2.2": "‘Buddho loke bhavissati / ",
  "tha-ap122:2.3": "aggo ca sabbasattānaṃ ",
  "tha-ap122:2.4": "janataṃ uddharissati.' // // ",
  "tha-ap122:3.1": "Nemittānaṃ suṇitvāna ",
  "tha-ap122:3.2": "jātipūjaṃ akās' ahaṃ / ",
  "tha-ap122:3.3": "edisā pūjanā n' atthi ",
  "tha-ap122:3.4": "yādisā jātipūjanā. // // ",
  "tha-ap122:4.1": "Saṃkharitvāna kusalaṃ ",
  "tha-ap122:4.2": "sakaṃ cittaṃ pasādayiṃ / ",
  "tha-ap122:4.3": "jātipūjaṃ karitvāna ",
  "tha-ap122:4.4": "tattha kālakato ahaṃ. // // ",
  "tha-ap122:5.1": "Yaṃ yaṃ yonūpapajjāmi ",
  "tha-ap122:5.2": "devattaṃ atha mānusaṃ / ",
  "tha-ap122:5.3": "sabbe satte atibhomi ",
  "tha-ap122:5.4": "jātipūjāy' idaṃ phalaṃ. // // ",
  "tha-ap122:6.1": "Dhātuyo maṃ upaṭṭhanti ",
  "tha-ap122:6.2": "mama cittavasānugā / ",
  "tha-ap122:6.3": "na te sakkonti kopetuṃ ",
  "tha-ap122:6.4": "jātipūjāy' idaṃ phalaṃ. // // ",
  "tha-ap122:7.1": "Ekanavute ito kappe ",
  "tha-ap122:7.2": "yaṃ pūjam akariṃ tadā / ",
  "tha-ap122:7.3": "duggatiṃ nābhijānāmi ",
  "tha-ap122:7.4": "jātipūjāy' idaṃ phalaṃ. // // ",
  "tha-ap122:8.1": "Supāricariyā nāma ",
  "tha-ap122:8.2": "catutiṃsajanādhipā / ",
  "tha-ap122:8.3": "ito tatiye kappamhi ",
  "tha-ap122:8.4": "cakkavattī mahābalā. // // ",
  "tha-ap122:9.1": "Paṭisambhidā catasso ",
  "tha-ap122:9.2": "vimokhā pi ca aṭṭh' ime / chaḍabhiññā sacchikatā ",
  "tha-ap122:9.3": "kataṃ Buddhassa sāsanan ti. // // ",
  "tha-ap122:10.1": "Itthaṃ sudaṃ āyasmā Jātipūjako thero imā gāthāyo abhāsitthāti. Jātipūjakatherassa apadānaṃ samattaṃ. Uddānaṃ: Parivāra-Sumaṅgalya ",
  "tha-ap122:11.1": "",
  "tha-ap122:12.1": "",
  "tha-ap122:13.1": "Saraṇ- ",
  "tha-ap122:14.1": "Āsana- ",
  "tha-ap122:14.2": "Pupphikā ",
  "tha-ap122:14.3": "Citapūjī Buddhasaññī ",
  "tha-ap122:14.4": "Magg-Upaṭṭhāna-Jātinā ",
  "tha-ap122:14.5": "gāthāyo navuti vuttā ",
  "tha-ap122:14.6": "gaṇitāyo vibhāvihīti. "
}
