  "tha-ap453:1.1": "Dhammadassissa munino ",
  "tha-ap453:1.2": "bodhiyā pāda-m-uttame / ",
  "tha-ap453:1.3": "pasannacitto sumano ",
  "tha-ap453:1.4": "jagatiṃ kārayiṃ ahaṃ. // // ",
  "tha-ap453:2.1": "Darito pabbatato vā ",
  "tha-ap453:2.2": "rukkhato patito ahaṃ / ",
  "tha-ap453:2.3": "cuto patiṭṭhaṃ labhāmi ",
  "tha-ap453:2.4": "jagatiyā idaṃ phalaṃ. // // ",
  "tha-ap453:3.1": "Na me corā pasahanti ",
  "tha-ap453:3.2": "nātimaññati khattiyo / ",
  "tha-ap453:3.3": "sabbāmitte 'tikkamāmi ",
  "tha-ap453:3.4": "jagatiyā idaṃ phalaṃ. // // ",
  "tha-ap453:4.1": "Yaṃ yaṃ yon' upapajjāmi ",
  "tha-ap453:4.2": "devattam atha mānusaṃ / ",
  "tha-ap453:4.3": "sabbattha pūjito homi ",
  "tha-ap453:4.4": "jagatiyā idaṃ phalaṃ. // // ",
  "tha-ap453:5.1": "Atthārase kappasate ",
  "tha-ap453:5.2": "jagatiṃ kārayim ahaṃ / ",
  "tha-ap453:5.3": "duggatiṃ nābhijānāmi ",
  "tha-ap453:5.4": "jagatidānass' idaṃ phalaṃ. // // ",
  "tha-ap453:6.1": "Kilesā . . . pe . . . ",
  "tha-ap453:6.2": "pe . . . ",
  "tha-ap453:6.3": "pe . . . // // ",
  "tha-ap453:6.4": "Sāgataṃ . . . ",
  "tha-ap453:7.1": "pe . . . ",
  "tha-ap453:7.2": "pe . . . ",
  "tha-ap453:7.3": "pe . . . // // ",
  "tha-ap453:7.4": "",
  "tha-ap453:8.1": "Paṭisambhidā . . . pe . . . ",
  "tha-ap453:8.2": "pe . . . ",
  "tha-ap453:8.3": "",
  "tha-ap453:8.4": "pe . . . // // ",
  "tha-ap453:9.1": "Itthaṃ sudam āyasmā Jagatidāyako thero i. g. a-ti. Jagatidāyakattherassa apadānaṃ samattaṃ. ",
  "tha-ap453:10.1": ""
}
