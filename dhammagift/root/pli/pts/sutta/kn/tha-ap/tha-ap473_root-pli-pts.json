  "tha-ap473:1.1": "Suvaṇṇavaṇṇaṃ sambuddham ",
  "tha-ap473:1.2": "ahutīnaṃ paṭiggahaṃ / ",
  "tha-ap473:1.3": "pavanaggena gacchantaṃ ",
  "tha-ap473:1.4": "addasaṃ lokanāyakaṃ. // // ",
  "tha-ap473:2.1": "*Naḷamālaṃ gahetvāna ",
  "tha-ap473:2.2": "nikkhamanto va tāvade / ",
  "tha-ap473:2.3": "tatth' addasāsiṃ sambuddhaṃ ",
  "tha-ap473:2.4": "oghatiṇṇaṃ aṇāsavaṃ. // // ",
  "tha-ap473:3.1": "Pasannacitto sumano ",
  "tha-ap473:3.2": "naḷamālaṃ apūjayiṃ / ",
  "tha-ap473:3.3": "dakkhiṇeyyaṃ mahāvīraṃ ",
  "tha-ap473:3.4": "sabbalokānukampakaṃ.* // // ",
  "tha-ap473:4.1": "Ekatiṃse ito kappe ",
  "tha-ap473:4.2": "yaṃ puppham abhiropayiṃ / ",
  "tha-ap473:4.3": "duggatiṃ nābhijānāmi ",
  "tha-ap473:4.4": "Buddhapūjāy' idaṃ phalaṃ. // // ",
  "tha-ap473:5.1": "Kilesā . . . pe . . . ",
  "tha-ap473:5.2": "pe . . . ",
  "tha-ap473:5.3": "pe . . . // // ",
  "tha-ap473:5.4": "Sāgataṃ . . . ",
  "tha-ap473:6.1": "pe . . . ",
  "tha-ap473:6.2": "pe . . . ",
  "tha-ap473:6.3": "pe . . . // // ",
  "tha-ap473:6.4": "",
  "tha-ap473:7.1": "Paṭisambhidā . . . pe . . . ",
  "tha-ap473:7.2": "pe . . . ",
  "tha-ap473:7.3": "",
  "tha-ap473:7.4": "pe . . . // // ",
  "tha-ap473:8.1": "Itthaṃ sudam āyasmā Naḷamāliyo thero i. g. a-ti. Naḷamāliyattherassa apadānaṃ samattaṃ. ",
  "tha-ap473:9.1": ""
}
