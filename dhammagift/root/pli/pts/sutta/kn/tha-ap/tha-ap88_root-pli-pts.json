  "tha-ap88:0.3": "",
  "tha-ap88:1.1": "Pabbate Himavantamhi ",
  "tha-ap88:1.2": "vākacīradharo ahaṃ / ",
  "tha-ap88:1.3": "caṅkamañ ca samārūḷho ",
  "tha-ap88:1.4": "nisīdiṃ pācināmukho. // // ",
  "tha-ap88:2.1": "Pabbate sugataṃ disvā ",
  "tha-ap88:2.2": "Phussaṃ jhānarataṃ tadā / ",
  "tha-ap88:2.3": "añjaliṃ paggahetvāna ",
  "tha-ap88:2.4": "raṃse cittappasādayiṃ. // // ",
  "tha-ap88:3.1": "Dvenavute ito kappe ",
  "tha-ap88:3.2": "yaṃ saññam alabhiṃ tadā / ",
  "tha-ap88:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap88:3.4": "raṃsisaññāy' idaṃ phalaṃ. // // ",
  "tha-ap88:4.1": "Paṭisambhidā catasso ",
  "tha-ap88:4.2": "vimokhā pi ca aṭṭh' ime / chaḍabhiññā sacchikatā ",
  "tha-ap88:4.3": "kataṃ Buddhassa sāsanan ti. // // ",
  "tha-ap88:5.1": "Itthaṃ sudaṃ āyasmā Raṃsisaññako thero imā gāthāyo abhāsitthā ti. ",
  "tha-ap88:6.1": "Raṃsisaññakatherassa apadānaṃ samattaṃ. "
}
