  "tha-ap452:0.1": "",
  "tha-ap452:0.2": "",
  "tha-ap452:0.3": "",
  "tha-ap452:1.1": "Siddhatthassa bhagavato ",
  "tha-ap452:1.2": "dipadindassa tādino / ",
  "tha-ap452:1.3": "pasannacitto sumano ",
  "tha-ap452:1.4": "bodhigharam akārayiṃ. // // ",
  "tha-ap452:2.1": "Tusitaṃ upapanno 'mhi ",
  "tha-ap452:2.2": "vasāmi ratane ghare / ",
  "tha-ap452:2.3": "na me sītaṃ vā uṇhaṃ vā ",
  "tha-ap452:2.4": "vāto gatte na samphuse. // // ",
  "tha-ap452:3.1": "Pañcasaṭṭhimh' ito kappe ",
  "tha-ap452:3.2": "cakkavattī ahos' ahaṃ / ",
  "tha-ap452:3.3": "Kāsikaṃ nāma nagaraṃ ",
  "tha-ap452:3.4": "Vissakammena māpitaṃ // // ",
  "tha-ap452:4.1": "dasayojana-āyāmaṃ ",
  "tha-ap452:4.2": "aṭṭhayojana-vitthataṃ / ",
  "tha-ap452:4.3": "na tamhi nagare atthi ",
  "tha-ap452:4.4": "kaṭṭhaṃ vallī ca mattikā. // // ",
  "tha-ap452:5.1": "Tiriyaṃ yojanaṃ āsi ",
  "tha-ap452:5.2": "addhayojana-vitthataṃ / ",
  "tha-ap452:5.3": "Maṅgalo nāma pāsādo ",
  "tha-ap452:5.4": "Vissakammena māpito. // // ",
  "tha-ap452:6.1": "Cullāsītisahassāni ",
  "tha-ap452:6.2": "thambhā sovaṇṇayā ahuṃ / ",
  "tha-ap452:6.3": "maṇimayā ca niyyuhā ",
  "tha-ap452:6.4": "chadanaṃ rūpiyaṃ ahū. // // ",
  "tha-ap452:7.1": "Sabbasovaṇṇayaṃ gharaṃ ",
  "tha-ap452:7.2": "Vissakammena māpitaṃ / ",
  "tha-ap452:7.3": "ajjhāvutthaṃ mayā etaṃ ",
  "tha-ap452:7.4": "gharadānass' idaṃ phalaṃ. // // ",
  "tha-ap452:8.1": "Te sabbe anubhotvāna ",
  "tha-ap452:8.2": "devamānusake bhave / ",
  "tha-ap452:8.3": "ajja patto 'mhi nibbānaṃ ",
  "tha-ap452:8.4": "santipadam anuttaraṃ. // // Catunavute ito ",
  "tha-ap452:9.1": "kappe ",
  "tha-ap452:9.2": "bodhigharam akārayiṃ / ",
  "tha-ap452:9.3": "duggatiṃ nābhijānāmi ",
  "tha-ap452:9.4": "gharadānass' idaṃ phalaṃ. // // ",
  "tha-ap452:10.1": "Kilesā . . . ",
  "tha-ap452:10.2": "pe . . . ",
  "tha-ap452:10.3": "",
  "tha-ap452:11.1": "",
  "tha-ap452:11.2": "pe . . . ",
  "tha-ap452:11.3": "pe . . . // // Sāgataṃ . . . pe . . . pe . . . pe . . . // // ",
  "tha-ap452:12.1": "Paṭisambhidā . . . ",
  "tha-ap452:12.2": "pe . . . ",
  "tha-ap452:12.3": "pe . . . pe . . . // // ",
  "tha-ap452:13.1": "Itthaṃ sudam āyasmā Bodhighariyo thero i. g. a- ti. Bodhighariyattherassa ",
  "tha-ap452:14.1": "",
  "tha-ap452:15.1": "apadānaṃ samattaṃ. ",
  "tha-ap452:16.1": "Uddānaṃ: ",
  "tha-ap452:17.1": "Vibhītakī Kolaphalī ",
  "tha-ap452:17.2": "Billa-Bhallāṭaka-ppadā Nigrodh' ",
  "tha-ap452:17.3": "Ambāṭakī c' eva ",
  "tha-ap452:17.4": "Āsanī Pādapīṭhako ",
  "tha-ap452:18.1": "Vediko Bodhighariko ",
  "tha-ap452:18.2": "gāthāyo gaṇitā-v-iha ",
  "tha-ap452:18.3": "ekūnāsītikā sabbā ",
  "tha-ap452:18.4": "asmiṃ vagge pakittitā. Vibhīṭakivaggo pañcacattārīso. "
}
