  "tha-ap431:1.1": "Saddhāya abhinikkhamma ",
  "tha-ap431:1.2": "pabbajim anagāriyaṃ / ",
  "tha-ap431:1.3": "vākacīradharo āsiṃ ",
  "tha-ap431:1.4": "tapokammam apassito. // // ",
  "tha-ap431:2.1": "Atthadassī tu bhagavā ",
  "tha-ap431:2.2": "lokajeṭṭho narāsabho / ",
  "tha-ap431:2.3": "uppajji tamhi samaye ",
  "tha-ap431:2.4": "tārayanto mahājanaṃ. // // ",
  "tha-ap431:3.1": "Balañ ca vata me khīṇaṃ ",
  "tha-ap431:3.2": "vyādhinā paramen' ahaṃ / ",
  "tha-ap431:3.3": "Buddhaseṭṭhaṃ saritvāna ",
  "tha-ap431:3.4": "puline thūpam uttamaṃ, // // ",
  "tha-ap431:4.1": "Karitvā haṭṭhacitto 'haṃ ",
  "tha-ap431:4.2": "sahassena samokiriṃ / ",
  "tha-ap431:4.3": "soṇṇakiṅkhanipupphāni ",
  "tha-ap431:4.4": "uddaggamanaso ahaṃ. // // ",
  "tha-ap431:5.1": "Sammukhā viya sambuddhaṃ ",
  "tha-ap431:5.2": "thūpaṃ paricarim ahaṃ / ",
  "tha-ap431:5.3": "tena cetopasādena ",
  "tha-ap431:5.4": "Atthadassissa tādino // // ",
  "tha-ap431:6.1": "Devalokagato santo ",
  "tha-ap431:6.2": "labhāmi vipulaṃ sukhaṃ / ",
  "tha-ap431:6.3": "suvaṇṇavaṇṇo tatthāsiṃ ",
  "tha-ap431:6.4": "Buddhapūjāy' idaṃ phalaṃ. // // ",
  "tha-ap431:7.1": "Asītikoṭiyo mayhaṃ ",
  "tha-ap431:7.2": "nāriyo samalaṅkatā / ",
  "tha-ap431:7.3": "sadā mayham upaṭṭhanti ",
  "tha-ap431:7.4": "Buddhapūjāy' idaṃ phalaṃ. // // ",
  "tha-ap431:8.1": "Saṭṭhiṃ turiyasahassāni ",
  "tha-ap431:8.2": "bheriyo paṇavāni ca / ",
  "tha-ap431:8.3": "saṅkhā ca deṇḍimā tattha ",
  "tha-ap431:8.4": "vaggu vadati dundubhi. // // ",
  "tha-ap431:9.1": "Cullāsītisahassāni ",
  "tha-ap431:9.2": "hatthino samalaṅkatā / ",
  "tha-ap431:9.3": "tidhappabhinnamātaṅgā ",
  "tha-ap431:9.4": "kuñjarā saṭṭhihāyanā // // ",
  "tha-ap431:10.1": "Hemajālābhisañchannā ",
  "tha-ap431:10.2": "upaṭṭhānaṃ karonti me / ",
  "tha-ap431:10.3": "balakāye gaje c' eva ",
  "tha-ap431:10.4": "ūnatā me na vijjati. // // ",
  "tha-ap431:11.1": "Soṇṇakiṅkhanipupph*ānaṃ* ",
  "tha-ap431:11.2": "vipākam anubhon' ahaṃ / ",
  "tha-ap431:11.3": "aṭṭhapaññāsakkhattuñ ca ",
  "tha-ap431:11.4": "devarajjam akārayiṃ. // // ",
  "tha-ap431:12.1": "Ekasattatikkhāttuñ ca ",
  "tha-ap431:12.2": "cakkavatti ahos' ahaṃ / ",
  "tha-ap431:12.3": "pathavyā rajjam ekasataṃ ",
  "tha-ap431:12.4": "mahiyā kārayim ahaṃ. // // ",
  "tha-ap431:13.1": "So dāni patto amatam ",
  "tha-ap431:13.2": "asaṅkhataṃ sududdasaṃ / ",
  "tha-ap431:13.3": "*saṃyojan* aparikkhīṇo ",
  "tha-ap431:13.4": "n' atthi dāni punabbhavo. // // ",
  "tha-ap431:14.1": "Aṭṭhārase kappasate ",
  "tha-ap431:14.2": "yaṃ puppham abhiropayiṃ / ",
  "tha-ap431:14.3": "duggatiṃ nābhijānāmi ",
  "tha-ap431:14.4": "buddhapūjāy' idaṃ phalaṃ. // // ",
  "tha-ap431:15.1": "Kilesā . . . ",
  "tha-ap431:15.2": "pe . . . ",
  "tha-ap431:15.3": "",
  "tha-ap431:16.1": "",
  "tha-ap431:16.2": "pe . . . ",
  "tha-ap431:16.3": "pe . . . // // Sāgataṃ . . . pe . . . pe . . . pe . . . // // ",
  "tha-ap431:17.1": "Paṭisambhidā . . . ",
  "tha-ap431:17.2": "pe . . . ",
  "tha-ap431:17.3": "pe . . . pe . . . // // ",
  "tha-ap431:18.1": "Itthaṃ sudam āyasmā Sovaṇṇakiṅkhaniyo thero i. g. a-ti. Sovaṇṇakiṅkhaniyattherassa apadānaṃ samattaṃ. ",
  "tha-ap431:19.1": ""
}
