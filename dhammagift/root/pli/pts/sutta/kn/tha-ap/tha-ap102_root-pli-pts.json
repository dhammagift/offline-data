  "tha-ap102:0.1": "",
  "tha-ap102:0.2": "",
  "tha-ap102:0.3": "",
  "tha-ap102:1.1": "bhagavato ",
  "tha-ap102:1.2": "ahosiṃ saṅkhadhamako / ",
  "tha-ap102:1.3": "niccupaṭṭhānayutto 'mhi ",
  "tha-ap102:1.4": "*sugatassa mahesino* // // ",
  "tha-ap102:2.1": "Upaṭṭhānaphalaṃ passa ",
  "tha-ap102:2.2": "lokanāthassa tādino: / ",
  "tha-ap102:2.3": "saṭṭhituriyasahassāni ",
  "tha-ap102:2.4": "parivārenti maṃ sadā. // // ",
  "tha-ap102:3.1": "Ekanavut' ito kappe ",
  "tha-ap102:3.2": "yaṃ upaṭṭhiṃ mahāisiṃ / ",
  "tha-ap102:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap102:3.4": "upaṭṭhānass' idaṃ phalaṃ. // // ",
  "tha-ap102:4.1": "*Catunavute ito kappe ",
  "tha-ap102:4.2": "Mahā*nigghosanāmakā / ",
  "tha-ap102:4.3": "soḷasāsiṃsu rājāno ",
  "tha-ap102:4.4": "cakkavattī mahābalā. // // ",
  "tha-ap102:5.1": "Paṭisambhidā catasso ",
  "tha-ap102:5.2": "vimokhā pi ca aṭṭh' ime / chaḍabhiññā sacchikatā ",
  "tha-ap102:5.3": "kataṃ Buddhassa sāsanan ti. // // ",
  "tha-ap102:6.1": "Itthaṃ sudaṃ āyasmā Buddhūpaṭṭhāko thero imā gāthāyo abhāsitthā ti. ",
  "tha-ap102:7.1": "",
  "tha-ap102:7.2": "",
  "tha-ap102:8.1": "Buddhūpaṭṭhākatherassa ",
  "tha-ap102:9.1": "apadānaṃ samattaṃ. Uddānaṃ: ",
  "tha-ap102:9.2": "Sudhāpiṇḍañ ca Celañ ca Kammāro Gandhamāliyo ",
  "tha-ap102:9.3": "Tipupphiyo Madhu Senā ",
  "tha-ap102:9.4": "Veyyāvacco va Dhammako ",
  "tha-ap102:9.5": "Samasaṭṭhiñ ca gāthāyo ",
  "tha-ap102:9.6": "asmiṃ vagge pakiṭṭitā. ",
  "tha-ap102:10.1": "Atha VaggUddānaṃ: ",
  "tha-ap102:11.1": "Buddhavaggo hi paṭhamo ",
  "tha-ap102:11.2": "Sīhāsanī Subhūti ca ",
  "tha-ap102:11.3": "Kuṇḍa-Dhāno Upālī ca ",
  "tha-ap102:11.4": "Vījanī Sakacittanī ",
  "tha-ap102:12.1": "Nāgasamālo Timiraṃ ",
  "tha-ap102:12.2": "Sudhāvaggena tedasā ",
  "tha-ap102:12.3": "catuddasasatā gāthā ",
  "tha-ap102:12.4": "pañcapaññāsa-m-eva ca. ",
  "tha-ap102:13.1": "",
  "tha-ap102:14.1": "Paṭhamasatakaṃ samattaṃ. "
}
