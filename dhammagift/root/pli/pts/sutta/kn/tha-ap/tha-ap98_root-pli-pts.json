  "tha-ap98:0.1": "",
  "tha-ap98:0.2": "",
  "tha-ap98:0.3": "",
  "tha-ap98:1.1": "Migaluddo pure āsiṃ ",
  "tha-ap98:1.2": "araññe kānane ahaṃ / ",
  "tha-ap98:1.3": "pāṭaliharitaṃ disvā ",
  "tha-ap98:1.4": "tīṇi pupphāni okiriṃ. // // ",
  "tha-ap98:2.1": "Sattapattāni gaṇhitvā ",
  "tha-ap98:2.2": "bahicchaḍḍes' ahan tadā / ",
  "tha-ap98:2.3": "antosuddhaṃ bahisuddhaṃ ",
  "tha-ap98:2.4": "suvimuttaṃ anāsavaṃ. // // ",
  "tha-ap98:3.1": "Sammukhā viya sambuddhaṃ ",
  "tha-ap98:3.2": "Vipassi-lokanāyakaṃ / ",
  "tha-ap98:3.3": "pāṭaliṃ abhivādetvā ",
  "tha-ap98:3.4": "tattha kālakato ahaṃ. // // ",
  "tha-ap98:4.1": "Ekanavut' ito kappe ",
  "tha-ap98:4.2": "yaṃ bodhim abhipūjayiṃ / ",
  "tha-ap98:4.3": "duggatiṃ nābhijānāmi ",
  "tha-ap98:4.4": "bodhipūjāy' idaṃ phalaṃ. // // ",
  "tha-ap98:5.1": "Samantapāsādikā nāma ",
  "tha-ap98:5.2": "terasāsiṃsu rājino / ",
  "tha-ap98:5.3": "ito tettiṃsa kappamhi ",
  "tha-ap98:5.4": "cakkavattī mahābalā. // // ",
  "tha-ap98:6.1": "Paṭisambhidā catasso ",
  "tha-ap98:6.2": "vimokhā pi ca aṭṭh' ime / chaḍabhiññā sacchikatā ",
  "tha-ap98:6.3": "kataṃ Buddhassa sāsanan ti. // // ",
  "tha-ap98:7.1": "Itthaṃ sudaṃ āyasmā Tipupphiyo thero imā gāthāyo abhāsitthā ti. ",
  "tha-ap98:8.1": "Tipupphiyattherassa apadānaṃ samattaṃ. Vivane "
}
