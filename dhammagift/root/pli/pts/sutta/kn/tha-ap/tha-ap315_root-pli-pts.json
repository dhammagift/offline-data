  "tha-ap315:1.1": "padaṃ n' atthi ",
  "tha-ap315:1.2": "ambare anilañjase / ",
  "tha-ap315:1.3": "Siddhatthaṃ jinaṃ adakkhiṃ ",
  "tha-ap315:1.4": "gacchantaṃ tidivaṅgaṇaṃ. // // ",
  "tha-ap315:2.1": "Anilen' eritaṃ disvā ",
  "tha-ap315:2.2": "sammāsambuddhacīvaraṃ / ",
  "tha-ap315:2.3": "vitti me tāvade jātā ",
  "tha-ap315:2.4": "disvāna gamanaṃ mune. // // Catunavute ",
  "tha-ap315:3.1": "ito kappe ",
  "tha-ap315:3.2": "yaṃ saññam alabhiṃ tadā / ",
  "tha-ap315:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap315:3.4": "Buddhasaññāy' idaṃ phalaṃ. // // ",
  "tha-ap315:4.1": "Paṭisambhidā . . . ",
  "tha-ap315:4.2": "pe . . . ",
  "tha-ap315:4.3": "pe . . . // // ",
  "tha-ap315:5.1": "Itthaṃ sudam āyasmā Gatasaññako thero i. g. a-ti. Gatasaññakattherassa ",
  "tha-ap315:6.1": "apadānaṃ samattaṃ. "
}
