{
  "tha-ap329:0.1": "",
  "tha-ap329:0.2": "",
  "tha-ap329:0.3": "",
  "tha-ap329:1.1": "Yadā devo devakāyā ",
  "tha-ap329:1.2": "cavati āyusaṅkhayā / ",
  "tha-ap329:1.3": "tayo saddā niccharanti ",
  "tha-ap329:1.4": "devānam anumodataṃ. // // ",
  "tha-ap329:2.1": "Ito bho sugatiṃ gaccha ",
  "tha-ap329:2.2": "manussānaṃ sahavyataṃ / ",
  "tha-ap329:2.3": "manussabhūto saddhamme ",
  "tha-ap329:2.4": "labha saddham anuttaraṃ. // // ",
  "tha-ap329:3.1": "Sā te saddhā niviṭṭhassa ",
  "tha-ap329:3.2": "mūlajātā patiṭṭhitā / ",
  "tha-ap329:3.3": "yāvajīvam asaṃhīrā ",
  "tha-ap329:3.4": "saddhamme suppavedite. // // ",
  "tha-ap329:4.1": "Kāyena kusalaṃ katvā ",
  "tha-ap329:4.2": "vācāya kusalaṃ bahuṃ / ",
  "tha-ap329:4.3": "manasā kusalaṃ katvā ",
  "tha-ap329:4.4": "avyapajjhaṃ nirūpadhiṃ. // // ",
  "tha-ap329:5.1": "Tato opadhikaṃ puññaṃ ",
  "tha-ap329:5.2": "katvā dānena taṃ bahuṃ / ",
  "tha-ap329:5.3": "aññe nicc' eva saddhamme ",
  "tha-ap329:5.4": "brahmacariye nivesaya. // // ",
  "tha-ap329:6.1": "Imāya anukampāya ",
  "tha-ap329:6.2": "devadevaṃ yadā viduṃ / ",
  "tha-ap329:6.3": "cavantam anumodanti ",
  "tha-ap329:6.4": "ehi deva punappunaṃ. // // ",
  "tha-ap329:7.1": "Saṃviggo 'mhi tadā āsiṃ ",
  "tha-ap329:7.2": "devasaṅghe samāgate / ",
  "tha-ap329:7.3": "kaṃ su nāma ahaṃ yoniṃ ",
  "tha-ap329:7.4": "gamissāmi ito cuto? // // ",
  "tha-ap329:8.1": "Mama saṃvegam aññāya ",
  "tha-ap329:8.2": "samaṇo bhāvitindriyo / ",
  "tha-ap329:8.3": "mam uddharitukāmo so ",
  "tha-ap329:8.4": "agacchi mama santike. // // ",
  "tha-ap329:9.1": "Sumano nāma nāmena ",
  "tha-ap329:9.2": "Padumuttarasāvako / ",
  "tha-ap329:9.3": "atthadhammānusāsitvā ",
  "tha-ap329:9.4": "saṃvejesi maman tadā. // // ",
  "tha-ap329:10.1": "",
  "tha-ap329:11.1": "Tassāhaṃ vacanaṃ sutvā ",
  "tha-ap329:11.2": "Buddhe cittappasādayiṃ / ",
  "tha-ap329:11.3": "taṃ vīram abhivādetvā ",
  "tha-ap329:11.4": "tattha kālakato ahaṃ. // // ",
  "tha-ap329:12.1": "Upapajjissaṃ tatth' eva ",
  "tha-ap329:12.2": "sukkamūlena codito cross / ",
  "tha-ap329:12.3": "vasanto mātukucchimhi ",
  "tha-ap329:12.4": "puna dhāretu mātuyā // // ",
  "tha-ap329:13.1": "Tamhā kāyā cavitvāna ",
  "tha-ap329:13.2": "Tidase upapajj' ahaṃ / ",
  "tha-ap329:13.3": "etthantare na passāmi ",
  "tha-ap329:13.4": "domanassaṃ mamaṃ tadā. // // ",
  "tha-ap329:14.1": "Tāvatiṃsā cavitvāna ",
  "tha-ap329:14.2": "mātukucchiṃ samokkamaṃ / ",
  "tha-ap329:14.3": "nikkhamitvāna kucchimhā ",
  "tha-ap329:14.4": "kaṇhasukkam ajāni 'haṃ. // // ",
  "tha-ap329:15.1": "Jātiyā sattavassena ",
  "tha-ap329:15.2": "ārāmaṃ pāvisim ahaṃ / ",
  "tha-ap329:15.3": "Gotamassa bhagavato ",
  "tha-ap329:15.4": "Sakyaputtassa tādino. // // ",
  "tha-ap329:16.1": "Vitthārake pāvacane ",
  "tha-ap329:16.2": "bahujaññamhi sāsane / ",
  "tha-ap329:16.3": "addasaṃ sāsanakāre ",
  "tha-ap329:16.4": "bhikkhavo tattha satthuno. // // ",
  "tha-ap329:17.1": "Sāvatthi nāma nagaraṃ ",
  "tha-ap329:17.2": "rājā tatthāsi Kosalo / ",
  "tha-ap329:17.3": "rathena nāgayuttena ",
  "tha-ap329:17.4": "upesi bodhim uttamaṃ. // // ",
  "tha-ap329:18.1": "Tassāhaṃ nāgaṃ disvāna ",
  "tha-ap329:18.2": "pubbakammam anussariṃ / ",
  "tha-ap329:18.3": "añjaliṃ paggahetvāna ",
  "tha-ap329:18.4": "samayam agamās' ahaṃ. // // ",
  "tha-ap329:19.1": "Jātiyā sattavass' eva ",
  "tha-ap329:19.2": "pabbajim anagāriyaṃ / ",
  "tha-ap329:19.3": "yo so Buddham upaṭṭhāsi ",
  "tha-ap329:19.4": "Ānando nāma sāvako. // // ",
  "tha-ap329:20.1": "Gatimā dhitimā c' eva ",
  "tha-ap329:20.2": "satimā ca bahussuto / ",
  "tha-ap329:20.3": "rañño cittaṃ pasādento ",
  "tha-ap329:20.4": "niyyādesi mahājutiṃ. // // ",
  "tha-ap329:21.1": "Tassāhaṃ dhammaṃ sutvāna ",
  "tha-ap329:21.2": "pubbakammam anussariṃ / ",
  "tha-ap329:21.3": "tatth' eva ṭhitako santo ",
  "tha-ap329:21.4": "arahattam apāpuṇiṃ. // // ",
  "tha-ap329:22.1": "Ekaṃsaṃ cīvaraṃ katvā ",
  "tha-ap329:22.2": "sire katvāna añjaliṃ / ",
  "tha-ap329:22.3": "sambuddham abhivādetvā ",
  "tha-ap329:22.4": "imaṃ vācam udīrayiṃ: // // ",
  "tha-ap329:23.1": "‘Padumuttarabuddhassa ",
  "tha-ap329:23.2": "dipadindassa satthuno / ",
  "tha-ap329:23.3": "nigguṇṭhipupphaṃ paggayha ",
  "tha-ap329:23.4": "sīhāsane ṭhapes' ahaṃ. // // ",
  "tha-ap329:24.1": "Tena kammena dipadinda ",
  "tha-ap329:24.2": "lokajeṭṭha narāsabha / ",
  "tha-ap329:24.3": "patto 'mhi acalaṃ ṭhānaṃ ",
  "tha-ap329:24.4": "hitvā jayaparājayaṃ.' // // ",
  "tha-ap329:25.1": "Pañcavīsasahassamhi ",
  "tha-ap329:25.2": "kappānaṃ manujādhipā / ",
  "tha-ap329:25.3": "Abbudanirabbudāni ",
  "tha-ap329:25.4": "aṭṭh' aṭṭh' āsisu khattiyā. // // ",
  "tha-ap329:26.1": "Paṭisambhidā . . . ",
  "tha-ap329:26.2": "pe . . . ",
  "tha-ap329:26.3": "pe . . . // // ",
  "tha-ap329:27.1": "Itthaṃ sudam āyasmā Nigguṇṭhipupphiyo thero i. g. a-ti. Nigguṇṭhipupphiyattherassa apadānaṃ samattaṃ. ",
  "tha-ap329:28.1": ""
}
