  "tha-ap1:5.4": "",
  "tha-ap1:6.1": "Atha Buddhāpadānāni ",
  "tha-ap1:6.2": "suṇātha suddhamānasā / ",
  "tha-ap1:6.3": "tiṃsapāramīsampuṇṇā ",
  "tha-ap1:6.4": "dhammarājā asaṅkhiyā. // // ",
  "tha-ap1:7.1": "Sambodhiṃ Buddhaseṭṭhānaṃ ",
  "tha-ap1:7.2": "sasaṅghe lokanāyake / ",
  "tha-ap1:7.3": "dasaṅgulī namassitvā ",
  "tha-ap1:7.4": "sirasā abhivādayiṃ. // // ",
  "tha-ap1:8.1": "Yāvatā Buddhakhettesu ",
  "tha-ap1:8.2": "ratanā vijjanti 'saṅkhiyā / ",
  "tha-ap1:8.3": "ākāsaṭṭhā ca bhūmaṭṭhā ",
  "tha-ap1:8.4": "manasā sabbam āhare. // // ",
  "tha-ap1:9.1": "Tattha rūpiyabhūmiyaṃ ",
  "tha-ap1:9.2": "pāsādaṃ māpaye ahaṃ / ",
  "tha-ap1:9.3": "'nekabhūmiṃ ratanamayaṃ ",
  "tha-ap1:9.4": "ubbiddhaṃ nabham uggataṃ. // // ",
  "tha-ap1:10.1": "Vicittathambhaṃ sukataṃ ",
  "tha-ap1:10.2": "suvibhattaṃ mahārahaṃ / ",
  "tha-ap1:10.3": "kanakāmayasaṅghātaṃ ",
  "tha-ap1:10.4": "toraṇacchattamaṇḍitaṃ. // // ",
  "tha-ap1:11.1": "Paṭhamā veluriyā bhūmi ",
  "tha-ap1:11.2": "vimalabbhasamā subhā / ",
  "tha-ap1:11.3": "naḷinājalajākiṇṇā ",
  "tha-ap1:11.4": "varakañcanabhūmiyā. // // ",
  "tha-ap1:12.1": "Pavāḷaṃ sapavāḷavaṇṇā ",
  "tha-ap1:12.2": "kāci-lohitakāsubhā / ",
  "tha-ap1:12.3": "indagopakavaṇṇābhā ",
  "tha-ap1:12.4": "bhūmi obhāsati disā. // // ",
  "tha-ap1:13.1": "Suvibhattā gharamukhā ",
  "tha-ap1:13.2": "niyyuhā sīhapañjarā / ",
  "tha-ap1:13.3": "caturo vedikā jālā ",
  "tha-ap1:13.4": "gandhaveḷā manoramā. // // ",
  "tha-ap1:14.1": "Nīlā pītā lohitakā ",
  "tha-ap1:14.2": "odātā suddhakāḷakā / ",
  "tha-ap1:14.3": "kūṭāgāravarūpetā ",
  "tha-ap1:14.4": "sattaratanavibhūsitā. // // ",
  "tha-ap1:15.1": "Olokamayā padumā ",
  "tha-ap1:15.2": "vāḷāvihaṅgasobhitā / ",
  "tha-ap1:15.3": "nakkhattatārakākiṇṇā ",
  "tha-ap1:15.4": "candasuriyehi maṇḍitā. // // ",
  "tha-ap1:16.1": "Hemajālena sañchannā ",
  "tha-ap1:16.2": "soṇṇakiṅkiṇikāyutā / ",
  "tha-ap1:16.3": "vātavegena kūjanti ",
  "tha-ap1:16.4": "soṇṇamālā manoramā. // // ",
  "tha-ap1:17.1": "Mañjeṭṭhakaṃ lohitakaṃ ",
  "tha-ap1:17.2": "pītakaṃ haripañjaraṃ / ",
  "tha-ap1:17.3": "nānāraṅgehi sampītaṃ ",
  "tha-ap1:17.4": "ussitaddhajamālinī. // // ",
  "tha-ap1:18.1": "Nānābahū 'nekasatā phalakā ",
  "tha-ap1:18.2": "rajatāmayā / ",
  "tha-ap1:18.3": "maṇimayā lohitaṅkā ",
  "tha-ap1:18.4": "masāragallamayā tathā. // // ",
  "tha-ap1:18.5": "Nānāsayanavicittā ",
  "tha-ap1:18.6": "saṇhākāsikasanthatā / ",
  "tha-ap1:19.1": "kambalā dukulā cīnā ",
  "tha-ap1:19.2": "paṭṭuṇṇā paṇḍupāvurā / ",
  "tha-ap1:19.3": "vividhattharaṇaṃ sabbaṃ ",
  "tha-ap1:19.4": "manasā paññapem' ahaṃ. // // ",
  "tha-ap1:20.1": "Tāsu tāsveva bhūmisu ",
  "tha-ap1:20.2": "ratanakūṭalaṅkataṃ / ",
  "tha-ap1:20.3": "maṇiverocanā ukkā ",
  "tha-ap1:20.4": "dhārayantā sutiṭṭhare. // // ",
  "tha-ap1:21.1": "Sobhanti esikā thambhā ",
  "tha-ap1:21.2": "subhā kañcanatoraṇā / ",
  "tha-ap1:21.3": "jambonadā sāramayā ",
  "tha-ap1:21.4": "atho rajatamayā pi ca. // // ",
  "tha-ap1:22.1": "'Nekāsandhīsu vibhattā ",
  "tha-ap1:22.2": "kavāṭaggaḷacittitā / ",
  "tha-ap1:22.3": "ubhato puṇṇaghatā 'neke ",
  "tha-ap1:22.4": "padumuppalasaṃyutā. // // ",
  "tha-ap1:23.1": "Atīte sabba-Buddhe ca ",
  "tha-ap1:23.2": "sasaṅghe lokanāyake / ",
  "tha-ap1:23.3": "pakatīvaṇṇarūpena ",
  "tha-ap1:23.4": "nimminitvā sasāvake. // // ",
  "tha-ap1:24.1": "Tena dvārena pavisitvā ",
  "tha-ap1:24.2": "sabbe Buddhā sasāvakā / ",
  "tha-ap1:24.3": "sabbasovaṇṇaye pīṭhe ",
  "tha-ap1:24.4": "nisinnā ariyamaṇḍalā. // // ",
  "tha-ap1:25.1": "Ye ca etarahi atthi ",
  "tha-ap1:25.2": "Buddhā loke anuttarā / ",
  "tha-ap1:25.3": "*atītā vattamānā ca ",
  "tha-ap1:25.4": "bhavanaṃ sabbe samāruhuṃ.* // // ",
  "tha-ap1:26.1": "Paccekabuddhe 'nekasate ",
  "tha-ap1:26.2": "sayambhū aparājite / ",
  "tha-ap1:26.3": "atīte vattamāne ca ",
  "tha-ap1:26.4": "bhavanaṃ sabbe samāhariṃ. // // ",
  "tha-ap1:27.1": "Kapparukkhā bahū atthi ",
  "tha-ap1:27.2": "ye dibbā ye ca mānusā / ",
  "tha-ap1:27.3": "sabbaṃ dussaṃ samāhantvā ",
  "tha-ap1:27.4": "acchādemi ticīvaraṃ. // // ",
  "tha-ap1:28.1": "Khajjaṃ bhojjaṃ sāyaniyaṃ ",
  "tha-ap1:28.2": "sampannaṃ pānabhojanaṃ / ",
  "tha-ap1:28.3": "maṇimaye subhe patte ",
  "tha-ap1:28.4": "sampūretvā adās' ahaṃ // // ",
  "tha-ap1:29.1": "Dibbavatthā samāhutvā ",
  "tha-ap1:29.2": "maṭṭhacīvarasaṃyutā / ",
  "tha-ap1:29.3": "madhurā sakkharā ceva ",
  "tha-ap1:29.4": "telā ca madhuphānitā / ",
  "tha-ap1:30.1": "tappitā paramannena ",
  "tha-ap1:30.2": "sabbe te ariyamaṇḍalā. // // ",
  "tha-ap1:30.3": "*Ratanagabbhaṃ* pavisitvā ",
  "tha-ap1:30.4": "kesarī va guhāsayā / ",
  "tha-ap1:31.1": "mahārahamhi sayane ",
  "tha-ap1:31.2": "sīhaseyyam akappayuṃ. // // ",
  "tha-ap1:31.3": "Sampajānā samuṭṭhāya ",
  "tha-ap1:31.4": "sayane pallaṅkam ābhujuṃ / ",
  "tha-ap1:32.1": "gocaraṃ sabbabuddhānaṃ ",
  "tha-ap1:32.2": "jhānaratisamappitā. // // ",
  "tha-ap1:32.3": "Aññe dhammāni desenti ",
  "tha-ap1:32.4": "aññe *kīḷanti iddhiyā / ",
  "tha-ap1:33.1": "aññe abhiññā appenti ",
  "tha-ap1:33.2": "abhiññā*-vasibhāvitā / ",
  "tha-ap1:33.3": "vikubbanā vikubbanti ",
  "tha-ap1:33.4": "aññe 'nekasatasahassiyo. // // ",
  "tha-ap1:34.1": "Buddhā *pi* buddhe pucchanti ",
  "tha-ap1:34.2": "visayaṃ sabbaññum ālayaṃ / ",
  "tha-ap1:34.3": "gambhīraṃ nipuṇaṃ ṭhānaṃ ",
  "tha-ap1:34.4": "paññāya vinibujjhare. // // ",
  "tha-ap1:35.1": "Sāvakā buddhe pucchanti ",
  "tha-ap1:35.2": "buddhā pucchanti sāvake / ",
  "tha-ap1:35.3": "aññamaññañ ca pucchanti ",
  "tha-ap1:35.4": "añña*maññaṃ byākaronti te.* // // ",
  "tha-ap1:36.1": "Buddhā paccekabuddhā ca ",
  "tha-ap1:36.2": "sāvakā paricārakā / ",
  "tha-ap1:36.3": "evaṃ ratīsu rammānā ",
  "tha-ap1:36.4": "pāsāde 'bhiramanti te. // // ",
  "tha-ap1:37.1": "Suvaṇṇajālābhi saṃyuttaṃ rajatajālamaṇīhi ",
  "tha-ap1:37.2": "ca / ",
  "tha-ap1:37.3": "muttajālaparikkhittaṃ ",
  "tha-ap1:37.4": "chattaṃ dhārentu matthake. // // ",
  "tha-ap1:38.1": "Bhavantu celavitānā ",
  "tha-ap1:38.2": "soṇṇatārakacittitā / ",
  "tha-ap1:38.3": "vicittā malyavitatā ",
  "tha-ap1:38.4": "sabbe dhārentu matthake. // // ",
  "tha-ap1:39.1": "Vitatā malyadāmehi ",
  "tha-ap1:39.2": "gandhadāmehi sobhitā / ",
  "tha-ap1:39.3": "dussadāmehi parikiṇṇā ",
  "tha-ap1:39.4": "ratanadāmavibhūsitā. // // ",
  "tha-ap1:40.1": "Pupphābhikiṇṇā sucittā ",
  "tha-ap1:40.2": "surabhigandhadhūpitā / ",
  "tha-ap1:40.3": "gandhapañcaṅgulaṅkitā ",
  "tha-ap1:40.4": "hemacchadanachāditā. // // ",
  "tha-ap1:41.1": "Catuddisā pokkharañño ",
  "tha-ap1:41.2": "padumuppalasanthatā / ",
  "tha-ap1:41.3": "sovaṇṇarūpe khāyantu ",
  "tha-ap1:41.4": "padumareṇurajuggatā. // // ",
  "tha-ap1:42.1": "Pupphantu pādapā sabbe ",
  "tha-ap1:42.2": "pāsādassa samantato / ",
  "tha-ap1:42.3": "sayañ ca pupphā muñcitvā ",
  "tha-ap1:42.4": "gandhā bhavanam okiruṃ. // // ",
  "tha-ap1:43.1": "Sikhino tattha naccantu ",
  "tha-ap1:43.2": "divyā haṃsā pakūjare / ",
  "tha-ap1:43.3": "karavīkā ca gāyantu ",
  "tha-ap1:43.4": "dijasaṅghā samantato. // // ",
  "tha-ap1:44.1": "Bheriyo sabbā vajjantu ",
  "tha-ap1:44.2": "vīṇā sabbā ravantu tā / ",
  "tha-ap1:44.3": "sabbā saṅgītī vattantu ",
  "tha-ap1:44.4": "pāsādassa sāmantato. // // ",
  "tha-ap1:45.1": "Yāvatā buddhakhettamhi ",
  "tha-ap1:45.2": "cakkavāle ca-m-uppari / ",
  "tha-ap1:45.3": "mahantā jotisampannā ",
  "tha-ap1:45.4": "acchiddā ratanāmayā // // ",
  "tha-ap1:46.1": "Tiṭṭhantu soṇṇapallaṅkā; ",
  "tha-ap1:46.2": "dīparukkhā jalantu te / ",
  "tha-ap1:46.3": "bhavantu ekapajjotā ",
  "tha-ap1:46.4": "dasasahassī paramparā. // // ",
  "tha-ap1:47.1": "Gaṇikā lāsikā c' eva ",
  "tha-ap1:47.2": "naccantu accharāgaṇā / ",
  "tha-ap1:47.3": "nānāraṅgā padissantu ",
  "tha-ap1:47.4": "pāsādassa samantato. // // ",
  "tha-ap1:48.1": "Dumagge pabbatagge vā ",
  "tha-ap1:48.2": "Sinerugirimuddhane / ",
  "tha-ap1:48.3": "ussāpemi dhajaṃ sabbaṃ ",
  "tha-ap1:48.4": "vicittaṃ pañcavaṇṇikaṃ. // // ",
  "tha-ap1:49.1": "Nārā nāgā ca gandhabbā ",
  "tha-ap1:49.2": "sabbe devā upentu te / ",
  "tha-ap1:49.3": "namassantā pañjalikā ",
  "tha-ap1:49.4": "pāsādaṃ parivārayuṃ. // // ",
  "tha-ap1:50.1": "Yaṃ kiñci kusalaṃ kammaṃ ",
  "tha-ap1:50.2": "kattabbaṃ kiriyaṃ mama / ",
  "tha-ap1:50.3": "kāyena vācā manasā ",
  "tha-ap1:50.4": "tidase sukataṃ kataṃ. // // ",
  "tha-ap1:51.1": "Ye sattā saññino atthi ",
  "tha-ap1:51.2": "ye ca sattā asaññino / ",
  "tha-ap1:51.3": "kataṃ puññaphalaṃ mayhaṃ ",
  "tha-ap1:51.4": "sabbe bhāgī bhavantu te. // // ",
  "tha-ap1:52.1": "Yesaṃ kataṃ suviditaṃ ",
  "tha-ap1:52.2": "dinnaṃ puññaphalaṃ mayā / ",
  "tha-ap1:52.3": "ye ca tattha na jānanti ",
  "tha-ap1:52.4": "devā gantvā nivedayuṃ. // // ",
  "tha-ap1:53.1": "Sabbe lokamhi ye sattā ",
  "tha-ap1:53.2": "jīvantāhārahetukā / ",
  "tha-ap1:53.3": "manuññaṃ bhojanaṃ sabbaṃ ",
  "tha-ap1:53.4": "labhantu mama cetasā. // // ",
  "tha-ap1:54.1": "Manasā dānaṃ mayā dinnaṃ ",
  "tha-ap1:54.2": "manasā pasādam āvahiṃ / ",
  "tha-ap1:54.3": "pūjitā sabba-Sambuddhā ",
  "tha-ap1:54.4": "paccekā jinasāvakā. // // ",
  "tha-ap1:55.1": "Tena kammena sukatena ",
  "tha-ap1:55.2": "cetanā paṇidhīhi ca / ",
  "tha-ap1:55.3": "jahitvā mānusaṃ dehaṃ ",
  "tha-ap1:55.4": "Tāvatiṃsam agañch' ahaṃ. // // ",
  "tha-ap1:56.1": "Duve bhave pajānāmi ",
  "tha-ap1:56.2": "devatte atha mānuse / ",
  "tha-ap1:56.3": "aññaṃ gatiṃ na jānāmi ",
  "tha-ap1:56.4": "manasā patthanāphalaṃ. // // ",
  "tha-ap1:57.1": "Devānaṃ adhiko homi ",
  "tha-ap1:57.2": "bhavāmi manujādhipo / ",
  "tha-ap1:57.3": "rūpalakkhaṇasampanno ",
  "tha-ap1:57.4": "paññāya asamo bhave. // // ",
  "tha-ap1:58.1": "Bhojanaṃ vividhaṃ seṭṭhaṃ ",
  "tha-ap1:58.2": "ratanañ ca anappakaṃ / ",
  "tha-ap1:58.3": "nānāvidhāni vatthāni ",
  "tha-ap1:58.4": "nabhā khippam upenti maṃ. // // ",
  "tha-ap1:59.1": "Puthavyā pabbate c' eva ",
  "tha-ap1:59.2": "ākāse udake vane / ",
  "tha-ap1:59.3": "yaṃyaṃ hatthaṃ pasāremi ",
  "tha-ap1:59.4": "dibbā bhakkhā upenti maṃ. // // ",
  "tha-ap1:60.1": "Puthavyā pabbate c' eva ",
  "tha-ap1:60.2": "ākāse udake vane / ",
  "tha-ap1:60.3": "yaṃyaṃ hatthaṃ pasāremi ",
  "tha-ap1:60.4": "ratanā sabbe upenti me. // // ",
  "tha-ap1:61.1": "Puthavyā pabbate c' eva ",
  "tha-ap1:61.2": "ākāse udake vane / ",
  "tha-ap1:61.3": "Yaṃyaṃ hatthaṃ pasāremi ",
  "tha-ap1:61.4": "sabbe gandhā upenti me. // // ",
  "tha-ap1:62.1": "Puthavyā pabbate c' eva ",
  "tha-ap1:62.2": "ākāse udake vane / ",
  "tha-ap1:62.3": "yaṃyaṃ hatthaṃ pasāremi ",
  "tha-ap1:62.4": "sabbe yānā upenti me. // // ",
  "tha-ap1:63.1": "Puthavyā pabbate c' eva ",
  "tha-ap1:63.2": "ākāse udake vane / ",
  "tha-ap1:63.3": "yaṃyaṃ hatthaṃ pasāremi ",
  "tha-ap1:63.4": "sabbe mālā upenti me. // // ",
  "tha-ap1:64.1": "Puthavyā pabbate c' eva ",
  "tha-ap1:64.2": "ākāse udake vane / ",
  "tha-ap1:64.3": "yaṃyaṃ hatthaṃ pasāremi ",
  "tha-ap1:64.4": "alaṅkārā upenti me. // // ",
  "tha-ap1:65.1": "Puthavyā pabbate c' eva ",
  "tha-ap1:65.2": "ākāse udake vane / ",
  "tha-ap1:65.3": "yaṃyaṃ hatthaṃ pasāremi ",
  "tha-ap1:65.4": "sabbā kaññā upenti me. // // ",
  "tha-ap1:66.1": "Puthavyā pabbate c' eva ",
  "tha-ap1:66.2": "ākāse udake vane / ",
  "tha-ap1:66.3": "yaṃyaṃ hatthaṃ pasāremi upenti ",
  "tha-ap1:66.4": "madhusakkharā. // // Puthavyā ",
  "tha-ap1:67.1": "pabbate c' eva ",
  "tha-ap1:67.2": "ākāse udake vane / ",
  "tha-ap1:67.3": "yaṃyaṃ hatthaṃ pasāremi ",
  "tha-ap1:67.4": "sabbe khajjā upenti maṃ. // // ",
  "tha-ap1:68.1": "*Adhane addhikajane ",
  "tha-ap1:68.2": "yācake ca pathāvino* / ",
  "tha-ap1:68.3": "yam me kataṃ dānavaraṃ ",
  "tha-ap1:68.4": "sambodhivarapattiyā. // // ",
  "tha-ap1:69.1": "Nādento pabbataṃ selaṃ ",
  "tha-ap1:69.2": "gajjento bahalaṃ giriṃ / ",
  "tha-ap1:69.3": "sadevalokaṃ hāsento ",
  "tha-ap1:69.4": "buddho loke bhavām' ahaṃ. // // ",
  "tha-ap1:70.1": "Disā dasavidhā loke ",
  "tha-ap1:70.2": "yāyato n' atthi antakaṃ / ",
  "tha-ap1:70.3": "tasmiñ ca disābhāgamhi ",
  "tha-ap1:70.4": "buddhakhettā asaṅkhiyā. // // ",
  "tha-ap1:71.1": "Pabhāpakittitā mayhaṃ ",
  "tha-ap1:71.2": "yamakā raṃsivāhanā / ",
  "tha-ap1:71.3": "etth' antare raṃsijālaṃ ",
  "tha-ap1:71.4": "āloko vipulo bhave. // // ",
  "tha-ap1:72.1": "Ettake lokadhātumhi ",
  "tha-ap1:72.2": "sabbe passantu maṃ janā / ",
  "tha-ap1:72.3": "sabbe ca sumanā hontu sabbe mam anuvattare. // // ",
  "tha-ap1:72.4": "",
  "tha-ap1:73.1": "Visiṭṭhamadhunādena ",
  "tha-ap1:73.2": "amataṃ bherim āhane / ",
  "tha-ap1:73.3": "etth' antare janā sabbe ",
  "tha-ap1:73.4": "suṇantu madhuraṃ giraṃ. // // ",
  "tha-ap1:74.1": "Dhammameghena vassante ",
  "tha-ap1:74.2": "sabbe hontu anāsavā / ",
  "tha-ap1:74.3": "ye 'ttha pacchimakā sattā ",
  "tha-ap1:74.4": "sotāpannā bhavantu te. // // ",
  "tha-ap1:75.1": "Datvā dātabbakaṃ dānaṃ ",
  "tha-ap1:75.2": "sīlaṃ pūretv' asesato / ",
  "tha-ap1:75.3": "nekkhamme pāramiṃ patvā ",
  "tha-ap1:75.4": "patto sambodhim uttamaṃ. // // ",
  "tha-ap1:76.1": "Paṇḍite paripucchitvā ",
  "tha-ap1:76.2": "katvā viriyam uttamaṃ / ",
  "tha-ap1:76.3": "khantiyā pāramiṃ gantvā ",
  "tha-ap1:76.4": "patto sambodhim uttamaṃ. // // ",
  "tha-ap1:77.1": "Katvā saccam adhiṭṭhānaṃ ",
  "tha-ap1:77.2": "pūretvā saccapāramiṃ / ",
  "tha-ap1:77.3": "mettāya pāramiṃ gantvā ",
  "tha-ap1:77.4": "patto sambodhim uttamaṃ. // // ",
  "tha-ap1:78.1": "Lābhālābhe sukhe dukkhe ",
  "tha-ap1:78.2": "sammāne ca vimānane / ",
  "tha-ap1:78.3": "sabbattha samako hutvā ",
  "tha-ap1:78.4": "patto sambodhim uttamaṃ. // // ",
  "tha-ap1:79.1": "Kosajjaṃ bhayato disvā ",
  "tha-ap1:79.2": "viriyañ cāpi khemato / ",
  "tha-ap1:79.3": "āraddhavīriyā hotha ",
  "tha-ap1:79.4": "esā Buddhānusāsanī. // // ",
  "tha-ap1:80.1": "Vivādaṃ bhayato disvā ",
  "tha-ap1:80.2": "avivādaṃ ca khemato / ",
  "tha-ap1:80.3": "samaggā sakhilā hotha ",
  "tha-ap1:80.4": "esā Buddhānusāsanī. // // ",
  "tha-ap1:81.1": "Pamādaṃ bhayato disvā ",
  "tha-ap1:81.2": "appamādañ ca khemato / ",
  "tha-ap1:81.3": "bhāveth' aṭṭhaṅgikaṃ maggaṃ ",
  "tha-ap1:81.4": "esā Buddhānusāsanī. // // ",
  "tha-ap1:82.1": "Samāgatā bahū Buddhā ",
  "tha-ap1:82.2": "arahanto ca sabbaso / ",
  "tha-ap1:82.3": "Sambuddhe arahante ca ",
  "tha-ap1:82.4": "vandamānā namassatha. // // ",
  "tha-ap1:83.1": "Evaṃ acintiyā Buddhā ",
  "tha-ap1:83.2": "Buddhadhammā acintiyā / ",
  "tha-ap1:83.3": "acintiyesu pasannānaṃ ",
  "tha-ap1:83.4": "vipāko hoti acintiyo ti. // // ",
  "tha-ap1:84.1": "Itthaṃ sudaṃ Bhagavā attano buddhacaritaṃ sambhāvayamāno Buddhānaṃ 'padāniyaṃ nāma dhammapariyāyaṃ abhāsitthā ti. ",
  "tha-ap1:85.1": "Buddhāpadānaṃ samattaṃ. ______________________________________________________________________________ "
}
