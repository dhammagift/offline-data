  "tha-ap1:1.1": "Khuddaka-Nikāya, Sutta-Piṭaka I. Namo tassa bhagavato arahato sammāsambuddhassa. ",
  "tha-ap1:2.1": "",
  "tha-ap1:2.2": "",
  "tha-ap1:2.3": "",
  "tha-ap1:2.4": "",
  "tha-ap1:3.1": "",
  "tha-ap1:3.2": "",
  "tha-ap1:3.3": "",
  "tha-ap1:3.4": "",
  "tha-ap1:4.1": "",
  "tha-ap1:4.2": "",
  "tha-ap1:4.3": "",
  "tha-ap1:4.4": "",
  "tha-ap1:5.1": "",
