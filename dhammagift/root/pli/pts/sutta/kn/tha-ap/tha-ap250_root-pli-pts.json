  "tha-ap250:1.1": "Satta pāṭalipupphāni ",
  "tha-ap250:1.2": "sīse katvān' ahaṃ tadā / ",
  "tha-ap250:1.3": "Buddhassa abhiropesiṃ ",
  "tha-ap250:1.4": "Vessabhumhi naruttame. // // ",
  "tha-ap250:2.1": "Ekatiṃse ito kappe ",
  "tha-ap250:2.2": "yaṃ puppham abhiropayiṃ / ",
  "tha-ap250:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap250:2.4": "pupphapūjāy' idaṃ phalaṃ. // // ",
  "tha-ap250:3.1": "Paṭisambhidā . . . ",
  "tha-ap250:3.2": "pe . . . ",
  "tha-ap250:3.3": "pe . . . // // ",
  "tha-ap250:4.1": "Itthaṃ sudam āyasmā Pāṭalipūjako thero i. g a-ti. Pāṭalipūjakattherassa apadānaṃ samattaṃ. ",
  "tha-ap250:5.1": ""
}
