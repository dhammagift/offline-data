  "tha-ap363:0.3": "",
  "tha-ap363:1.1": "Tāvatiṃsā idhāgantvā ",
  "tha-ap363:1.2": "Maṅgalo nāma māṇavo / ",
  "tha-ap363:1.3": "mandāravaṃ gahetvāna ",
  "tha-ap363:1.4": "Vipassissa mahesino // // ",
  "tha-ap363:2.1": "Samādhinā nisinnassa ",
  "tha-ap363:2.2": "matthake dhārayim ahaṃ. / ",
  "tha-ap363:2.3": "sattāhaṃ dhārayitvāna ",
  "tha-ap363:2.4": "devalokaṃ punāgamiṃ. // // ",
  "tha-ap363:3.1": "Ekanavute ito kappe ",
  "tha-ap363:3.2": "yaṃ Buddham abhipūjayiṃ / ",
  "tha-ap363:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap363:3.4": "Buddhapūjāy' idaṃ phalaṃ. // // ",
  "tha-ap363:4.1": "Paṭisambhidā . . . pe . . . ",
  "tha-ap363:4.2": "",
  "tha-ap363:4.3": "pe . . . // // ",
  "tha-ap363:4.4": "",
  "tha-ap363:5.1": "Itthaṃ sudam āyasmā Mandāriyo thero i. g. a-ti. Ekamandāriyattherassa ",
  "tha-ap363:6.1": "apadānaṃ samattaṃ. "
}
