  "tha-ap204:0.3": "",
  "tha-ap204:1.1": "Suvaṇṇavaṇṇo bhagavā ",
  "tha-ap204:1.2": "sataraṃsi patāpavā / ",
  "tha-ap204:1.3": "caṅkamanaṃ samārūḷho ",
  "tha-ap204:1.4": "mettacitto sikhīsito. // // ",
  "tha-ap204:2.1": "Pasannacitto sumano ",
  "tha-ap204:2.2": "vanditvā ñāṇam uttamaṃ / ",
  "tha-ap204:2.3": "vinelapupphaṃ paggayha ",
  "tha-ap204:2.4": "Buddhassa abhiropayiṃ. // // ",
  "tha-ap204:3.1": "Ekatiṃse ito kappe ",
  "tha-ap204:3.2": "yaṃ pupphaṃ abhipūjayiṃ / ",
  "tha-ap204:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap204:3.4": "Buddhapūjāy' idaṃ phalaṃ. // // ",
  "tha-ap204:4.1": "Ekūnatiṃse kappamhi ",
  "tha-ap204:4.2": "Sumeghaghana-nāmako / ",
  "tha-ap204:4.3": "sattaratanasampanno ",
  "tha-ap204:4.4": "cakkavatti mahabbalo. // // ",
  "tha-ap204:5.1": "Paṭisambhidā . . . ",
  "tha-ap204:5.2": "pe . . . ",
  "tha-ap204:5.3": "pe . . . // // ",
  "tha-ap204:6.1": "Itthaṃ sudam āyasmā Vinelapupphiyo thero i. g. a-ti. Vinelapupphiyattherassa ",
  "tha-ap204:7.1": "apadānaṃ samattaṃ. "
}
