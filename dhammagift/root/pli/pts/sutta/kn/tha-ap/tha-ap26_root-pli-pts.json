{
  "tha-ap26:0.1": "",
  "tha-ap26:0.2": "",
  "tha-ap26:0.3": "",
  "tha-ap26:1.1": "Nagare Candavatiyā ",
  "tha-ap26:1.2": "bhatako ās' ahan tadā / ",
  "tha-ap26:1.3": "parakammāyane yutto ",
  "tha-ap26:1.4": "pabbajjaṃ na labhām' ahaṃ. // // ",
  "tha-ap26:2.1": "Mahandhakārā pihitā tividhaggī ",
  "tha-ap26:2.2": "pi *ḍa*yhare / ",
  "tha-ap26:2.3": "kena nu kho upāyena ",
  "tha-ap26:2.4": "visaṃyutto bhave ahaṃ. // // ",
  "tha-ap26:3.1": "Deyyadhammo ca me n'atthi ",
  "tha-ap26:3.2": "varāko bhatako ahaṃ / ",
  "tha-ap26:3.3": "yan nūnāhaṃ pañcasīlaṃ ",
  "tha-ap26:3.4": "rakkheyya paripūrayaṃ. // // ",
  "tha-ap26:4.1": "Anomadassissa muni ",
  "tha-ap26:4.2": "Nisabho nāmo sāvako / ",
  "tha-ap26:4.3": "tam ahaṃ upasaṅkamma ",
  "tha-ap26:4.4": "pañcasikkhāpad' aggahiṃ. // // ",
  "tha-ap26:5.1": "Vassasatasahassāni ",
  "tha-ap26:5.2": "āyu vijjati tāvade / ",
  "tha-ap26:5.3": "tāvatā pañcasīlāni ",
  "tha-ap26:5.4": "paripuṇṇāni gopayiṃ. // // ",
  "tha-ap26:6.1": "Maccukāle *ca* sampatte ",
  "tha-ap26:6.2": "devā assāsayanti maṃ / ",
  "tha-ap26:6.3": "ratho sahassayutto te ",
  "tha-ap26:6.4": "mārisāyaṃ upaṭṭhito. // // ",
  "tha-ap26:7.1": "Sampatte carime citte ",
  "tha-ap26:7.2": "mama sīlaṃ anussariṃ / ",
  "tha-ap26:7.3": "tena kammena sukatena ",
  "tha-ap26:7.4": "Tāvatiṃsaṃ agañch' ahaṃ. // // ",
  "tha-ap26:8.1": "Tiṃsakkhattuñ ca devindo ",
  "tha-ap26:8.2": "devarajjam akārayiṃ / dibbaṃ ",
  "tha-ap26:8.3": "sukhaṃ anubhaviṃ ",
  "tha-ap26:8.4": "accharāhi purakkhato. // // ",
  "tha-ap26:9.1": "Pañcasattatikkhattuñ ca ",
  "tha-ap26:9.2": "cakkavattī ahos' ahaṃ / ",
  "tha-ap26:9.3": "padesarajjaṃ vipulaṃ ",
  "tha-ap26:9.4": "gaṇanāto asaṅkhiyaṃ. // // ",
  "tha-ap26:10.1": "Devalokā cavitvāna ",
  "tha-ap26:10.2": "sukkamūlena codito / ",
  "tha-ap26:10.3": "pure Vesāliyaṃ jāto ",
  "tha-ap26:10.4": "mahāsāle su-aḍḍhake. // // ",
  "tha-ap26:11.1": "Vassupanāyike kāle ",
  "tha-ap26:11.2": "dippante jinasāsane / ",
  "tha-ap26:11.3": "mātā ca me pitā c' eva ",
  "tha-ap26:11.4": "pañcasikkhāpad' aggahuṃ. // // ",
  "tha-ap26:12.1": "Saha sutvān' ahaṃ sīlaṃ ",
  "tha-ap26:12.2": "mama sīlaṃ anussariṃ / ",
  "tha-ap26:12.3": "ekāsane nisīditvā ",
  "tha-ap26:12.4": "arahattam apāpuṇiṃ. // // ",
  "tha-ap26:13.1": "Jātiyā pañcavassena ",
  "tha-ap26:13.2": "arahattam apāpuṇiṃ / ",
  "tha-ap26:13.3": "upasampādayī Buddho ",
  "tha-ap26:13.4": "guṇam aññāya cakkhumā. // // ",
  "tha-ap26:14.1": "Paripuṇṇāni gopitvā ",
  "tha-ap26:14.2": "pañcasikkhāpadān' ahaṃ / ",
  "tha-ap26:14.3": "aparimeyye ito kappe ",
  "tha-ap26:14.4": "vinipātaṃ n' agacch' ahaṃ. // // So' ",
  "tha-ap26:15.1": "haṃ yasam anubhaviṃ ",
  "tha-ap26:15.2": "tesaṃ sīlāna vāhasā / ",
  "tha-ap26:15.3": "kappakoṭiṃ pakittento ",
  "tha-ap26:15.4": "*kittaye eka*desakaṃ. // // ",
  "tha-ap26:16.1": "Pañcasīlāni gopitvā ",
  "tha-ap26:16.2": "tayo hetū labhām' ahaṃ / ",
  "tha-ap26:16.3": "dīghāyuko mahābhogo ",
  "tha-ap26:16.4": "tikkhapañño bhavām' ahaṃ. // // ",
  "tha-ap26:17.1": "Pakittento ca sabbesaṃ ",
  "tha-ap26:17.2": "adhimattaṃ va porisaṃ / ",
  "tha-ap26:17.3": "bhavābhave saṃsaritvā ",
  "tha-ap26:17.4": "e*te ṭhāne labhām' ahaṃ. // // ",
  "tha-ap26:18.1": "Apa*rimeyyasīlesu ",
  "tha-ap26:18.2": "vattanto jinasāvako / ",
  "tha-ap26:18.3": "bhavesu yadi rajjeyyaṃ ",
  "tha-ap26:18.4": "vipāko kīdiso bhave. // // ",
  "tha-ap26:19.1": "Suciṇṇam me pañcasīlaṃ ",
  "tha-ap26:19.2": "bhatakena vipassinā / ",
  "tha-ap26:19.3": "tena sīlen' ahaṃ ajja ",
  "tha-ap26:19.4": "poṭhayiṃ sabbabandhanā. // // ",
  "tha-ap26:20.1": "Aparimeyye ito kappe ",
  "tha-ap26:20.2": "pañcasīlāni gopayiṃ / ",
  "tha-ap26:20.3": "duggatiṃ nābhijānāmi ",
  "tha-ap26:20.4": "pañcasīlān' idaṃ phalaṃ. // // ",
  "tha-ap26:21.1": "Paṭisambhidā cātasso ",
  "tha-ap26:21.2": "vimokhā pi ca aṭṭh' ime / ",
  "tha-ap26:21.3": "chaḍabhiññā sacchikatā ",
  "tha-ap26:21.4": "kataṃ Buddhassa sāsanan ti. // // ",
  "tha-ap26:22.1": "Itthaṃ sudaṃ āyasmā Pañcasīlasamādāniyo thero imā gāthāyo abhāsitthā ti. ",
  "tha-ap26:23.1": "Pañcasīlasamādāniyatherassa apadānaṃ samattaṃ. "
}
