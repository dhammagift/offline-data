  "tha-ap257:1.1": "jotantaṃ ",
  "tha-ap257:1.2": "nisinnaṃ pabbatantare / ",
  "tha-ap257:1.3": "satta pāṭalipupphāni ",
  "tha-ap257:1.4": "Buddhassa abhiropayiṃ. // // ",
  "tha-ap257:2.1": "Catunavute ito kappe ",
  "tha-ap257:2.2": "yaṃ puppham abhipūjayiṃ / ",
  "tha-ap257:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap257:2.4": "Buddhapūjāy' idaṃ phalaṃ. // // ",
  "tha-ap257:3.1": "Paṭisambhidā . . . ",
  "tha-ap257:3.2": "pe . . . ",
  "tha-ap257:3.3": "pe . . . // // ",
  "tha-ap257:4.1": "Itthaṃ sudam āyasmā Sattapāṭaliyo thero i. g. a-ti. Sattapāṭaliyattherassa ",
  "tha-ap257:5.1": "apadānaṃ samattaṃ. Ahosi "
