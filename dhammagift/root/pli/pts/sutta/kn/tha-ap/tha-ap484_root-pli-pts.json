  "tha-ap484:1.1": "Ajjhāyako mantadharo ",
  "tha-ap484:1.2": "tiṇṇaṃ vedānapāragū / ",
  "tha-ap484:1.3": "lakkhaṇe *itihāse ca ",
  "tha-ap484:1.4": "sanighaṇḍu-sa*keṭubhe. // // ",
  "tha-ap484:2.1": "Nadīsotapaṭibhāgā ",
  "tha-ap484:2.2": "sissā āyanti me tadā / ",
  "tha-ap484:2.3": "tesāhaṃ mante vācemi ",
  "tha-ap484:2.4": "rattindivam atandito. // // ",
  "tha-ap484:3.1": "Siddhattho nāma sambuddho ",
  "tha-ap484:3.2": "loke uppajji tāvade / ",
  "tha-ap484:3.3": "tam andhakāraṃ nāsetvā ",
  "tha-ap484:3.4": "ñāṇalokaṃ pavattayi. // // ",
  "tha-ap484:4.1": "Mama aññataro sisso ",
  "tha-ap484:4.2": "sissānaṃ so kathesi me / ",
  "tha-ap484:4.3": "sutvāna te etam atthaṃ ",
  "tha-ap484:4.4": "ārocesuṃ maman tadā: // // ",
  "tha-ap484:5.1": "\"Buddho loke samuppanno ",
  "tha-ap484:5.2": "sabbaññū lokanāyako / ",
  "tha-ap484:5.3": "tassānuvattati jano ",
  "tha-ap484:5.4": "lābho amhaṃ na hessati.\" // // ",
  "tha-ap484:6.1": "Adhiccuppattikā Buddhā ",
  "tha-ap484:6.2": "cakkhumanto mahāyasā / ",
  "tha-ap484:6.3": "yannūnāhaṃ Buddhaseṭṭhaṃ ",
  "tha-ap484:6.4": "passeyyaṃ lokanāyakaṃ. // // ",
  "tha-ap484:7.1": "Ajinam me gahetvāna ",
  "tha-ap484:7.2": "vākacīraṃ kamaṇḍaluṃ / ",
  "tha-ap484:7.3": "assamā abhinikkhamma ",
  "tha-ap484:7.4": "sisse āmantayiṃ ahaṃ. // // ",
  "tha-ap484:8.1": "Odumbarakapupphaṃ va ",
  "tha-ap484:8.2": "candamhi sasakaṃ yathā / ",
  "tha-ap484:8.3": "vāyasānaṃ yathā khīraṃ ",
  "tha-ap484:8.4": "dullabhaṃ lokanāyakaṃ. // // ",
  "tha-ap484:9.1": "Buddho lokamhi uppanno ",
  "tha-ap484:9.2": "manussattam pi dullabhaṃ / ",
  "tha-ap484:9.3": "ubhosu vijjamānesu ",
  "tha-ap484:9.4": "savanañ ca sudullabhaṃ. // // ",
  "tha-ap484:10.1": "Buddho loke samuppanno ",
  "tha-ap484:10.2": "cakkhuṃ lacchāma no bhavaṃ / ",
  "tha-ap484:10.3": "etha sabbe gamissāma ",
  "tha-ap484:10.4": "sammāsambuddhasantikaṃ. // // ",
  "tha-ap484:11.1": "Kamaṇḍaluddharā sabbe ",
  "tha-ap484:11.2": "kharājinanivāsino / ",
  "tha-ap484:11.3": "Je jaṭābhārabharitā ",
  "tha-ap484:11.4": "nikkhamuṃ pavanā tadā. // // ",
  "tha-ap484:12.1": "Yugamattaṃ pekkhamānā ",
  "tha-ap484:12.2": "utthamatthaṃ gavesino / ",
  "tha-ap484:12.3": "āyanti nāgapotā va ",
  "tha-ap484:12.4": "asambhītā va kesarī. // // ",
  "tha-ap484:13.1": "Appabhāsā alīlatā ",
  "tha-ap484:13.2": "nipakā santavuttino / ",
  "tha-ap484:13.3": "uñchāya caramānā te ",
  "tha-ap484:13.4": "Buddhaseṭṭhaṃ upāgamuṃ. // // ",
  "tha-ap484:14.1": "Diyaḍḍhayojane sese ",
  "tha-ap484:14.2": "vyadhi me udapajjatha / ",
  "tha-ap484:14.3": "Buddhaseṭṭhaṃ saritvāna ",
  "tha-ap484:14.4": "tattha kālakato ahaṃ. // // ",
  "tha-ap484:15.1": "Catunavute ito kappe ",
  "tha-ap484:15.2": "yaṃ saññam alabhiṃ tadā / ",
  "tha-ap484:15.3": "duggatiṃ nābhijānāmi ",
  "tha-ap484:15.4": "buddhasaññāy' idaṃ phalaṃ. // // ",
  "tha-ap484:16.1": "Kilesā . . . ",
  "tha-ap484:16.2": "pe . . . ",
  "tha-ap484:16.3": "",
  "tha-ap484:17.1": "",
  "tha-ap484:17.2": "pe . . . ",
  "tha-ap484:17.3": "pe . . . // // Sāgataṃ . . . pe . . . pe . . . pe . . . // // ",
  "tha-ap484:18.1": "Paṭisambhidā . . . ",
  "tha-ap484:18.2": "pe . . . ",
  "tha-ap484:18.3": "pe . . . pe . . . // // ",
  "tha-ap484:19.1": "Itthaṃ sudam āyasmā Buddhasaññako thero i. g. a-ti. Buddhasaññakattherassa apadānaṃ samattaṃ. Ogayhāhaṃ ",
  "tha-ap484:20.1": ""
}
