  "tha-ap163:0.3": "",
  "tha-ap163:1.1": "Padumo nāma nāmena ",
  "tha-ap163:1.2": "dipadindo narāsabho / ",
  "tha-ap163:1.3": "pavanā abhinikkamma ",
  "tha-ap163:1.4": "dhammaṃ desesi cakkhumā // // ",
  "tha-ap163:2.1": "Yakkhānaṃ samayo āsi ",
  "tha-ap163:2.2": "avidūre mahesino / ",
  "tha-ap163:2.3": "yena kiccena sampattā ",
  "tha-ap163:2.4": "ajjhāpekkhiṃsu tāvade // // ",
  "tha-ap163:3.1": "Buddhassa giram aññāya ",
  "tha-ap163:3.2": "amatassa ca desanaṃ / ",
  "tha-ap163:3.3": "pasannacitto sumano ",
  "tha-ap163:3.4": "appoṭhetvā upaṭṭh' ahaṃ. // // ",
  "tha-ap163:4.1": "Suciṇṇassa phalam passa ",
  "tha-ap163:4.2": "upaṭṭhānassa satthuno / ",
  "tha-ap163:4.3": "tiṃsakappasahassesu ",
  "tha-ap163:4.4": "duggatiṃ n' upapajj' ahaṃ. // // ",
  "tha-ap163:5.1": "Ūnatiṃse kappasate ",
  "tha-ap163:5.2": "Samalaṅkata-nāmako / ",
  "tha-ap163:5.3": "sattaratanasampanno ",
  "tha-ap163:5.4": "cakkavattī mahabbalo. // // ",
  "tha-ap163:6.1": "Paṭisambhidā . . . pe . . . ",
  "tha-ap163:6.2": "",
  "tha-ap163:6.3": "pe . . . // // ",
  "tha-ap163:6.4": "",
  "tha-ap163:7.1": "Itthaṃ sudaṃ ā. Supāricariyo thero i. g. ā-ti. Supāricariyattherassa apadānaṃ samattaṃ. ",
  "tha-ap163:8.1": ""
}
