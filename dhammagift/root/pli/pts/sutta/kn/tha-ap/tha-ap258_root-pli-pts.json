  "tha-ap258:1.1": "Candano nāma ",
  "tha-ap258:1.2": "sambuddhass' atrajo tadā / ",
  "tha-ap258:1.3": "eko 'pāhano mayā dinno ",
  "tha-ap258:1.4": "bodhi sampajja me tuvaṃ. // // ",
  "tha-ap258:2.1": "Ekanavute ito kappe ",
  "tha-ap258:2.2": "yaṃ 'pāhanam adadiṃ tadā / ",
  "tha-ap258:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap258:2.4": "'pāhanadānass' idaṃ phalaṃ. // // ",
  "tha-ap258:3.1": "Paṭisambhidā . . . ",
  "tha-ap258:3.2": "pe . . . ",
  "tha-ap258:3.3": "pe . . . // // ",
  "tha-ap258:4.1": "Itthaṃ sudam āyasmā 'Pāhanadāyaka thero i. g. a-ti. 'Pāhanadāyakattherassa ",
  "tha-ap258:5.1": "apadānaṃ samattaṃ. "
}
