  "tha-ap205:1.1": "Kañcanagghiyasaṅkāso ",
  "tha-ap205:1.2": "sabbaññū lokanāyako / ",
  "tha-ap205:1.3": "odakaṃ daham oggayha ",
  "tha-ap205:1.4": "sināyi lokanāyako. // // ",
  "tha-ap205:2.1": "Paggayha kiṅkhaṇiṃ pupphaṃ ",
  "tha-ap205:2.2": "Vipassissbāhiropayiṃ / ",
  "tha-ap205:2.3": "udaggacitto sumano ",
  "tha-ap205:2.4": "dipadindassa tādino. // // ",
  "tha-ap205:3.1": "Ekanavute ito kappe ",
  "tha-ap205:3.2": "yaṃ puppham abhipūjayiṃ / ",
  "tha-ap205:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap205:3.4": "Buddhapūjāy' idaṃ phalaṃ. // // ",
  "tha-ap205:4.1": "Sattasattati kappamhi ",
  "tha-ap205:4.2": "rājā Bhimaratho ahu / ",
  "tha-ap205:4.3": "sattaratanasampanno ",
  "tha-ap205:4.4": "cakkavattī mahabbalo. // // ",
  "tha-ap205:5.1": "Paṭisambhidā . . . ",
  "tha-ap205:5.2": "pe . . . ",
  "tha-ap205:5.3": "pe . . . // // ",
  "tha-ap205:6.1": "Itthaṃ sudam āyasmā Kiṅkhaṇikapupphiyo thero i. g. a-ti. Kiṅkhaṇikapupphiyattherassa apadānaṃ samattaṃ. ",
  "tha-ap205:7.1": ""
}
