  "tha-ap228:0.3": "",
  "tha-ap228:1.1": "Nārado iti me nāmaṃ ",
  "tha-ap228:1.2": "Kassapo iti maṃ vidū / ",
  "tha-ap228:1.3": "addasaṃ samaṇānaggaṃ ",
  "tha-ap228:1.4": "Vipassiṃ devasakkataṃ // // ",
  "tha-ap228:2.1": "Anuvyañjanadharaṃ Buddham ",
  "tha-ap228:2.2": "āhutīnaṃ paṭiggahaṃ / ",
  "tha-ap228:2.3": "Caṅkolapupphaṃ paggayha ",
  "tha-ap228:2.4": "Buddhassa abhiropayiṃ. // // ",
  "tha-ap228:3.1": "Ekanavute ito kappe ",
  "tha-ap228:3.2": "yaṃ puppham abhipūjayiṃ / ",
  "tha-ap228:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap228:3.4": "Buddhapūjāy' idaṃ phalaṃ. // // ",
  "tha-ap228:4.1": "Catusattati 'to kappe ",
  "tha-ap228:4.2": "Romaso nāma khattiyo / ",
  "tha-ap228:4.3": "āmuttamālābharaṇo ",
  "tha-ap228:4.4": "sayoggabalavāhano. // // ",
  "tha-ap228:5.1": "Paṭisambhidā . . . ",
  "tha-ap228:5.2": "pe . . . ",
  "tha-ap228:5.3": "pe . . . // // ",
  "tha-ap228:6.1": "Itthaṃ sudam āyasmā Caṅkolapupphiyo thero i. g. a-ti. Caṅkolapupphiyattherassa ",
  "tha-ap228:7.1": "apadānaṃ samattaṃ. "
}
