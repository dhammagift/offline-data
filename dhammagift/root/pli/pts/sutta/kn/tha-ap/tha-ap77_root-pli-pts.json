  "tha-ap77:0.1": "",
  "tha-ap77:0.2": "",
  "tha-ap77:0.3": "",
  "tha-ap77:1.1": "Khaṇḍo nām' āsi nāmena ",
  "tha-ap77:1.2": "Vipassiss' aggasāvako / ",
  "tha-ap77:1.3": "ekā bhikkhā mayā dinnā ",
  "tha-ap77:1.4": "lokāhutipaṭiggaho. // // ",
  "tha-ap77:2.1": "Tena cittappasādena ",
  "tha-ap77:2.2": "dipadinda narāsabha / ",
  "tha-ap77:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap77:2.4": "ekabhikkhāy' idaṃ phalaṃ. // // ",
  "tha-ap77:3.1": "Cattālīse ito kappe ",
  "tha-ap77:3.2": "Varuṇo nāma khattiyo / ",
  "tha-ap77:3.3": "sattaratanasampanno ",
  "tha-ap77:3.4": "cakkavatti mahabbalo. // // ",
  "tha-ap77:4.1": "Paṭisambhidā catasso ",
  "tha-ap77:4.2": "vimokhā pi ca aṭṭh' ime / chaḍabhiññā sacchikatā ",
  "tha-ap77:4.3": "kataṃ Buddhassa sāsanan ti. // // ",
  "tha-ap77:5.1": "Itthaṃ sudaṃ āyasmā Ekasaññako thero imā gāthāyo abhāsitthā ti. Ekasaññakatherassa apadānaṃ samattaṃ. Himavantass' avidūre ",
  "tha-ap77:6.1": ""
}
