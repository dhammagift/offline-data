  "tha-ap201:0.3": "",
  "tha-ap201:1.1": "nāmena ",
  "tha-ap201:1.2": "sayambhū aparājito / ",
  "tha-ap201:1.3": "pavanā nikkhamitvāna ",
  "tha-ap201:1.4": "nagaraṃ pāvisī jino. // // ",
  "tha-ap201:2.1": "Piṇḍacāraṃ caritvāna ",
  "tha-ap201:2.2": "nikkhami nagarā muni / ",
  "tha-ap201:2.3": "katakicco va sambuddho ",
  "tha-ap201:2.4": "so vasī vanam antare. // // ",
  "tha-ap201:3.1": "Tikaṇḍipupphaṃ paggayha ",
  "tha-ap201:3.2": "Buddhassa abhiropayiṃ / ",
  "tha-ap201:3.3": "pasannacitto sumano ",
  "tha-ap201:3.4": "sayambhussa mahesino. // // ",
  "tha-ap201:4.1": "Catunavute ito kappe ",
  "tha-ap201:4.2": "yaṃ puppham abhiropayiṃ / ",
  "tha-ap201:4.3": "duggatiṃ nābhijānāmi ",
  "tha-ap201:4.4": "Buddhapūjāy' idaṃ phalaṃ // // ",
  "tha-ap201:5.1": "Chalāsītimh' ito kappe ",
  "tha-ap201:5.2": "Apilāpiyanāmako / ",
  "tha-ap201:5.3": "sattaratanasampanno ",
  "tha-ap201:5.4": "cakkavattī mahabbalo. // // ",
  "tha-ap201:6.1": "Paṭisambhidā . . . ",
  "tha-ap201:6.2": "pe . . . ",
  "tha-ap201:6.3": "pe . . . // // ",
  "tha-ap201:7.1": "Itthaṃ sudam āyasmā Tikaṇḍipupphiyo thero i. g. a-ti. Tikaṇḍipupphiyattherassa ",
  "tha-ap201:8.1": "apadānaṃ samattaṃ. "
}
