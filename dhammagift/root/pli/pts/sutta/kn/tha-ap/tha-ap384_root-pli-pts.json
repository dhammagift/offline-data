  "tha-ap384:1.1": "Nagare Bandhumatiyā ",
  "tha-ap384:1.2": "āsim ārāmiko tadā / ",
  "tha-ap384:1.3": "addasaṃ virajaṃ Buddhaṃ ",
  "tha-ap384:1.4": "gacchantam anilañjase. // // ",
  "tha-ap384:2.1": "Labujassa phalaṃ gayha ",
  "tha-ap384:2.2": "Buddhaseṭṭhass' adās' ahaṃ / ",
  "tha-ap384:2.3": "ākāse ṭhito santo ",
  "tha-ap384:2.4": "paṭigaṇhi mahāyaso. // // ",
  "tha-ap384:3.1": "Vittisañjananaṃ mayhaṃ ",
  "tha-ap384:3.2": "diṭṭhadhammasukhāvahaṃ / ",
  "tha-ap384:3.3": "phalaṃ Buddhassa datvāna ",
  "tha-ap384:3.4": "vippasannena cetasā // // ",
  "tha-ap384:4.1": "Adhigacchiṃ tadā pītiṃ ",
  "tha-ap384:4.2": "vipulañ ca sukhuttamaṃ / ",
  "tha-ap384:4.3": "uppajjate va ratanaṃ ",
  "tha-ap384:4.4": "nibbattassa yahiṃ tahiṃ. // // Ekanavute ",
  "tha-ap384:5.1": "ito kappe ",
  "tha-ap384:5.2": "yaṃ phalam adadiṃ tadā / ",
  "tha-ap384:5.3": "duggatiṃ nābhijānāmi ",
  "tha-ap384:5.4": "phaladānass' idaṃ phalaṃ. // // ",
  "tha-ap384:6.1": "Sāgataṃ . . . pe . . . pe . . . // // Kilesā . . . ",
  "tha-ap384:6.2": "pe . . . ",
  "tha-ap384:6.3": "",
  "tha-ap384:7.1": "",
  "tha-ap384:7.2": "pe . . . // // ",
  "tha-ap384:7.3": "",
  "tha-ap384:8.1": "Paṭisambhidā . . . ",
  "tha-ap384:8.2": "pe . . . ",
  "tha-ap384:8.3": "pe . . . // // ",
  "tha-ap384:9.1": "Itthaṃ sudam āyasmā Labujaphaladāyako Labujaphaladāyakattherassa apadānaṃ samattaṃ. ",
  "tha-ap384:10.1": ""
}
