  "tha-ap379:1.1": "Parinibbute bhagavati ",
  "tha-ap379:1.2": "jalajuttamanāmake / ",
  "tha-ap379:1.3": "āropitamhi citake ",
  "tha-ap379:1.4": "sālapuppham apūjayiṃ. // // Satasahasse ",
  "tha-ap379:2.1": "ito kappe ",
  "tha-ap379:2.2": "yaṃ puppham abhipūjayiṃ / ",
  "tha-ap379:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap379:2.4": "citapūjāy' idaṃ phalaṃ. // // ",
  "tha-ap379:3.1": "Sāgataṃ vata me āsi Buddhaseṭṭhassa santike / tisso vijjā anuppatto kataṃ Buddhassa sāsanaṃ. // // Kilesā jhāpitā mayhaṃ ",
  "tha-ap379:3.2": "bhavā sabbe samūhatā / nāgo va bandhanaṃ chetvā ",
  "tha-ap379:3.3": "viharāmi anāsavo. // // ",
  "tha-ap379:4.1": "",
  "tha-ap379:4.2": "",
  "tha-ap379:4.3": "",
  "tha-ap379:5.1": "Paṭisambhidā . . . ",
  "tha-ap379:5.2": "pe . . . ",
  "tha-ap379:5.3": "pe . . . // // ",
  "tha-ap379:6.1": "Itthaṃ sudam āyasmā Citapūjako thero i. g. a-ti. Citapūjakattherassa ",
  "tha-ap379:7.1": "apadānaṃ samattaṃ. "
}
