{
  "tha-ap22:0.1": "",
  "tha-ap22:0.2": "",
  "tha-ap22:0.3": "",
  "tha-ap22:1.1": "Āhutiṃ yiṭṭhukāmo 'haṃ ",
  "tha-ap22:1.2": "paṭiyādetvāna bhojanaṃ / ",
  "tha-ap22:1.3": "brāhmaṇe paṭimānento ",
  "tha-ap22:1.4": "visāle mālake ṭhito. // // ",
  "tha-ap22:2.1": "Ath' addasāsiṃ sambu*ddhaṃ ",
  "tha-ap22:2.2": "Piyadassiṃ* mahāyasaṃ / ",
  "tha-ap22:2.3": "sabbalokavinetāraṃ ",
  "tha-ap22:2.4": "sayambhuṃ aggapuggalaṃ. // // ",
  "tha-ap22:3.1": "Bhagavantaṃ jutimantaṃ ",
  "tha-ap22:3.2": "sāvakehi purakkhataṃ / ",
  "tha-ap22:3.3": "ādiccam iva rocantaṃ ",
  "tha-ap22:3.4": "rathiyaṃ pavisantakaṃ. // // ",
  "tha-ap22:4.1": "Añjalim paggahetvāna ",
  "tha-ap22:4.2": "sakaṃ cittaṃ pasādayiṃ / ",
  "tha-ap22:4.3": "manasā 'va nimantesiṃ: ",
  "tha-ap22:4.4": "*‘āgacchatu* mahāmuni.' // // ",
  "tha-ap22:5.1": "Mama saṅkappam aññāya ",
  "tha-ap22:5.2": "satthā loke anuttaro / ",
  "tha-ap22:5.3": "khīṇāsavasahassehi ",
  "tha-ap22:5.4": "mama dvāraṃ upāgami // // ",
  "tha-ap22:6.1": "‘Namo te purisājañña ",
  "tha-ap22:6.2": "namo te purisuttama! / ",
  "tha-ap22:6.3": "pāsādaṃ abhirūhitvā ",
  "tha-ap22:6.4": "sīhāsane nisīda tvaṃ.' // // ",
  "tha-ap22:7.1": "Danto danta*parivāro ",
  "tha-ap22:7.2": "tiṇṇo* tārayataṃ varo / ",
  "tha-ap22:7.3": "pāsādaṃ abhirūhitvā ",
  "tha-ap22:7.4": "nisīdi pavarāsane. // // ",
  "tha-ap22:8.1": "Yam me atthi sake gehe ",
  "tha-ap22:8.2": "āmisaṃ paccupaṭṭhitaṃ / ",
  "tha-ap22:8.3": "tāhaṃ buddhassa pādāsiṃ ",
  "tha-ap22:8.4": "pasanno sehi pāṇihi. // // ",
  "tha-ap22:9.1": "Pasannacitto sumano ",
  "tha-ap22:9.2": "vedajāto kata*ñjalī / ",
  "tha-ap22:9.3": "Buddhaseṭṭhaṃ nama*ssāmi: ",
  "tha-ap22:9.4": "‘aho buddhass' uḷāratā. // // ",
  "tha-ap22:10.1": "Aṭṭhannaṃ payirupāsataṃ ",
  "tha-ap22:10.2": "bhuñjaṃ khīṇāsavā bahū / ",
  "tha-ap22:10.3": "tuyh' ev' eso ānubhāvo ",
  "tha-ap22:10.4": "saraṇan taṃ upem' ahaṃ'. // // ",
  "tha-ap22:11.1": "Piyadassī ca bhagavā ",
  "tha-ap22:11.2": "lokajeṭṭho narāsabho / ",
  "tha-ap22:11.3": "bhikkhusaṅghe nisīditvā ",
  "tha-ap22:11.4": "imā gāthā abhāsatha: // // ",
  "tha-ap22:12.1": "\"Yo so saṅghaṃ abhojesi ",
  "tha-ap22:12.2": "ujubhūtaṃ samāhitaṃ / ",
  "tha-ap22:12.3": "Tathāgataṃ ca sambuddhaṃ ",
  "tha-ap22:12.4": "suṇotha mama bhāsato: // // ",
  "tha-ap22:13.1": "Sattavīsatikkhattuṃ so ",
  "tha-ap22:13.2": "devarajjaṃ karissati / ",
  "tha-ap22:13.3": "sakakammābhiraddho so ",
  "tha-ap22:13.4": "devaloke ramissati. // // ",
  "tha-ap22:14.1": "Dasañ c' aṭṭhañ ca kkhattuṃ so ",
  "tha-ap22:14.2": "cakkavatti bhavissati / ",
  "tha-ap22:14.3": "pathavyā rajjaṃ pañcasataṃ ",
  "tha-ap22:14.4": "vasudhaṃ āvasissati\". // // ",
  "tha-ap22:15.1": "Araññaṃ vanam ogayha ",
  "tha-ap22:15.2": "kānanaṃ vyagghasevitaṃ / ",
  "tha-ap22:15.3": "padhānapadahitvāna ",
  "tha-ap22:15.4": "kilesā jhāpitā mayā. // // ",
  "tha-ap22:16.1": "Aṭṭhārase kappasate ",
  "tha-ap22:16.2": "yaṃ dānam adadiṃ tadā / ",
  "tha-ap22:16.3": "duggatiṃ nābhijānāmi ",
  "tha-ap22:16.4": "bhattadānass idaṃ phalaṃ. // // ",
  "tha-ap22:17.1": "Paṭisambhidā catasso ",
  "tha-ap22:17.2": "vimokhā pi ca aṭṭh' ime / ",
  "tha-ap22:17.3": "chaḍabhiññā sacchikatā ",
  "tha-ap22:17.4": "kataṃ Buddhassa sāsanan ti. // // ",
  "tha-ap22:18.1": "Itthaṃ sudaṃ āyasmā Sumaṅgalo thero imā gāthāyo abhāsitthā ti. Sumaṅgalatherassa ",
  "tha-ap22:19.1": "apadānaṃ samattaṃ. ",
  "tha-ap22:20.1": "Uddānaṃ:-- ",
  "tha-ap22:21.1": "Sīhāsanī Ekatthambhī ",
  "tha-ap22:21.2": "Nando ca Culla-Panthako ",
  "tha-ap22:21.3": "Pilindo Rāhulo ceva ",
  "tha-ap22:21.4": "Vaṅganto Raṭṭhapālako. ",
  "tha-ap22:22.1": "Sopāko Maṅgalo c' eva dase ",
  "tha-ap22:22.2": "ca dutiye vagge ",
  "tha-ap22:22.3": "satañ ca sattatiṃsā ca ",
  "tha-ap22:22.4": "gāthā c' ettha pakāsitā. ",
  "tha-ap22:23.1": "Himavantass' avidūre "
}
