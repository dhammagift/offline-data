  "tha-ap408:0.3": "",
  "tha-ap408:1.1": "Migaluddo pure āsiṃ ",
  "tha-ap408:1.2": "araññe kānane ahaṃ / ",
  "tha-ap408:1.3": "pasadamigaṃ gavesanto ",
  "tha-ap408:1.4": "sayambhum addasam ahaṃ. // // ",
  "tha-ap408:2.1": "Anuruddho nāma sambuddho ",
  "tha-ap408:2.2": "sayambhū aparājito / ",
  "tha-ap408:2.3": "vivekakāmo so vīro vanamajjh' ",
  "tha-ap408:2.4": "ogahiṃ tadā // // ",
  "tha-ap408:3.1": "Catudaṇḍe gahetvāna ",
  "tha-ap408:3.2": "catuṭṭhāne ṭhapes' ahaṃ / ",
  "tha-ap408:3.3": "maṇḍapaṃ sukataṃ katvā ",
  "tha-ap408:3.4": "padumapupphehi chādayiṃ. // // ",
  "tha-ap408:4.1": "Maṇḍapaṃ chādayitvāna ",
  "tha-ap408:4.2": "sayambhum abhivādayiṃ / ",
  "tha-ap408:4.3": "dhanuṃ tatth' eva nikkhippa ",
  "tha-ap408:4.4": "pabbajim anagāriyaṃ. // // ",
  "tha-ap408:5.1": "Naciraṃ pabbajitassa ",
  "tha-ap408:5.2": "vyādhi me udapajjatha / ",
  "tha-ap408:5.3": "pubbakammaṃ saritvāna ",
  "tha-ap408:5.4": "tattha kālakato ahaṃ. // // ",
  "tha-ap408:6.1": "Pubbakammena saṃyutto ",
  "tha-ap408:6.2": "Tusitam agamās' ahaṃ / ",
  "tha-ap408:6.3": "tattha sovaṇṇayaṃ vyamhaṃ ",
  "tha-ap408:6.4": "nibbattati yadicchakaṃ. // // ",
  "tha-ap408:7.1": "Sahassayuttaṃ hayavāhiṃ ",
  "tha-ap408:7.2": "dibbaṃ yānam ",
  "tha-ap408:7.3": "adhiṭṭhito / ārohitvāna taṃ yānaṃ ",
  "tha-ap408:7.4": "gacchām' ahaṃ yadicchakaṃ. // // ",
  "tha-ap408:8.1": "Tato me niyyamānassa ",
  "tha-ap408:8.2": "devabhūtassa me sato / ",
  "tha-ap408:8.3": "samantā yojanasataṃ ",
  "tha-ap408:8.4": "maṇḍapo me dhariyyati. // // Sayane ",
  "tha-ap408:9.1": "so tuvaṭṭhāmi ",
  "tha-ap408:9.2": "accanta-pupphasanthate / ",
  "tha-ap408:9.3": "antalikkhā ca padumā ",
  "tha-ap408:9.4": "vassante niccakālikaṃ. // // ",
  "tha-ap408:10.1": "Marīcike phandamāne ",
  "tha-ap408:10.2": "*tappamāne* ca ātape / ",
  "tha-ap408:10.3": "na maṃ tapati ātapo ",
  "tha-ap408:10.4": "maṇḍapassa idaṃ phalaṃ. // // ",
  "tha-ap408:11.1": "Duggatiṃ samatikkanto ",
  "tha-ap408:11.2": "apāyā pihitā mama / ",
  "tha-ap408:11.3": "maṇḍape rukkhamūle vā ",
  "tha-ap408:11.4": "santāpo me na vijjati. // // ",
  "tha-ap408:12.1": "Mahīsaññam adhiṭṭhāya ",
  "tha-ap408:12.2": "loṇatoyaṃ tarām' ahaṃ / ",
  "tha-ap408:12.3": "tassa me sukataṃ kammaṃ ",
  "tha-ap408:12.4": "Buddhapūjāy idaṃ phalaṃ. // // ",
  "tha-ap408:13.1": "Apatham pi pathaṃ katvāna ",
  "tha-ap408:13.2": "gacchāmi anilañjase / ",
  "tha-ap408:13.3": "aho me sukataṃ kammaṃ ",
  "tha-ap408:13.4": "Buddhapūjāy' idaṃ phalaṃ. // // ",
  "tha-ap408:14.1": "Pubbenivāsaṃ jānāmi ",
  "tha-ap408:14.2": "dibbacakkhuṃ visodhitaṃ / ",
  "tha-ap408:14.3": "āsavā me parikkhīṇā ",
  "tha-ap408:14.4": "Buddhapūjāy' idaṃ phalaṃ. // // ",
  "tha-ap408:15.1": "Jahitā purimā jāti ",
  "tha-ap408:15.2": "Buddhassa oraso ahaṃ / ",
  "tha-ap408:15.3": "dāyādo' mhi ca saddhamme ",
  "tha-ap408:15.4": "Buddhapūjāy' idaṃ phalaṃ. // // ",
  "tha-ap408:16.1": "Ārādhito 'mhi sugataṃ ",
  "tha-ap408:16.2": "Gotamaṃ Sakyapuṅgavaṃ / ",
  "tha-ap408:16.3": "dhammaddhajo dhammadāyādo ",
  "tha-ap408:16.4": "Buddhapūjāy' idaṃ phalaṃ. // // ",
  "tha-ap408:17.1": "Upaṭṭhitvāna sambuddhaṃ ",
  "tha-ap408:17.2": "Gotamaṃ Sakyapuṅgavaṃ / ",
  "tha-ap408:17.3": "pāraṃ gamaniyaṃ maggam ",
  "tha-ap408:17.4": "apucchiṃ lokanāyakaṃ. // // ",
  "tha-ap408:18.1": "Ajjhiṭṭho kathayī Buddho ",
  "tha-ap408:18.2": "gambhīraṃ nipuṇaṃ padaṃ / ",
  "tha-ap408:18.3": "tassāhaṃ dhammaṃ sutvāna ",
  "tha-ap408:18.4": "patto 'mhi āsavakkhayaṃ. // // ",
  "tha-ap408:19.1": "Aho me sukataṃ kammaṃ ",
  "tha-ap408:19.2": "parimutto 'mhi jātiyā / ",
  "tha-ap408:19.3": "sabbāsavaparikkhīṇo ",
  "tha-ap408:19.4": "n' atthi dāni punabbhavo. // // ",
  "tha-ap408:20.1": "Kilesā . . . ",
  "tha-ap408:20.2": "pe . . . ",
  "tha-ap408:20.3": "",
  "tha-ap408:21.1": "",
  "tha-ap408:21.2": "pe . . . // // ",
  "tha-ap408:21.3": "Sāgataṃ . . . pe . . . pe . . . // // ",
  "tha-ap408:22.1": "Paṭisambhidā . . . ",
  "tha-ap408:22.2": "pe . . . ",
  "tha-ap408:22.3": "pe . . . // // ",
  "tha-ap408:23.1": "Itthaṃ sudam āyasmā Nando thero i. g. a-ti. Nandattherassa apadānaṃ samattaṃ. ",
  "tha-ap408:24.1": ""
}
