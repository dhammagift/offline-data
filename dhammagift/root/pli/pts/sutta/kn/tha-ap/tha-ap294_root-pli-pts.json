  "tha-ap294:1.1": "Vākacīradharo āsim ",
  "tha-ap294:1.2": "ajinuttaravasano / ",
  "tha-ap294:1.3": "abhiññā pañca nibbattā ",
  "tha-ap294:1.4": "candassa parimajjako. // // ",
  "tha-ap294:2.1": "*Vipassiṃ lokapajjo*taṃ ",
  "tha-ap294:2.2": "disvā abhigataṃ mamaṃ / ",
  "tha-ap294:2.3": "pāricchattakapupphāni ",
  "tha-ap294:2.4": "dhāresiṃ satthuno ahaṃ. // // ",
  "tha-ap294:3.1": "Ekanavute ito kappe ",
  "tha-ap294:3.2": "yaṃ puppham abhidhārayiṃ / ",
  "tha-ap294:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap294:3.4": "dhāraṇāya idaṃ phalaṃ. // // ",
  "tha-ap294:4.1": "Sattāsītimhi 'to kappe ",
  "tha-ap294:4.2": "eko āsi mahīpati / ",
  "tha-ap294:4.3": "Samantadharaṇo nāma ",
  "tha-ap294:4.4": "cakkavattī mahabbalo. // // ",
  "tha-ap294:5.1": "Paṭisambhidā . . . ",
  "tha-ap294:5.2": "pe . . . ",
  "tha-ap294:5.3": "pe . . . // // ",
  "tha-ap294:6.1": "Itthaṃ sudam āyasmā Pupphadhārako thero i. g. a-ti. Pupphadhārakattherassa apadānaṃ samattaṃ. ",
  "tha-ap294:7.1": ""
}
