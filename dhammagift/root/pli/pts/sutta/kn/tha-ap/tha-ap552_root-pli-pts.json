  "tha-ap552:1.1": "kappe ",
  "tha-ap552:1.2": "brahmabandhu mahāyaso / ",
  "tha-ap552:1.3": "Kassapo nāma nāmena ",
  "tha-ap552:1.4": "uppajji vadataṃ varo. // // ",
  "tha-ap552:2.1": "Anuvyañjanasampannodvattiṃsavaralakkhaṇo / ",
  "tha-ap552:2.2": "",
  "tha-ap552:2.3": "byāmappabhāparivuto ",
  "tha-ap552:2.4": "raṃsijālasamotato. // // ",
  "tha-ap552:3.1": "Assāsetāyathā cando ",
  "tha-ap552:3.2": "suriyo va pabhaṅkaro / ",
  "tha-ap552:3.3": "nibbāpetā yathā megho ",
  "tha-ap552:3.4": "sāgaro va guṇākaro. // // ",
  "tha-ap552:4.1": "Dharaṇī-r-ivasīlena ",
  "tha-ap552:4.2": "Himavā va samādhinā / ",
  "tha-ap552:4.3": "ākāso viya paññāya ",
  "tha-ap552:4.4": "asaṅgo anilo yathā. // // ",
  "tha-ap552:5.1": "Tadāhi Bārāṇasiyaṃ ",
  "tha-ap552:5.2": "upapanno mahākule / ",
  "tha-ap552:5.3": "pahutadhanadhaññasmiṃ ",
  "tha-ap552:5.4": "nānāratanasañcaye. // // ",
  "tha-ap552:6.1": "Mahatāparivārena ",
  "tha-ap552:6.2": "nisinnaṃ lokanāyakaṃ / ",
  "tha-ap552:6.3": "upecca dhammaṃ assosiṃ amataṃ ",
  "tha-ap552:6.4": "ca manoharaṃ. // // ",
  "tha-ap552:7.1": "Dvattiṃsalakkhaṇadharosunakkhatto ",
  "tha-ap552:7.2": "va candimā / ",
  "tha-ap552:7.3": "anuvyañjanasampanno ",
  "tha-ap552:7.4": "sālarājā va phullito. // // ",
  "tha-ap552:8.1": "Raṃsijālaparikkhittoditto ",
  "tha-ap552:8.2": "va kanakācalo / ",
  "tha-ap552:8.3": "byāmappabhāparivuto ",
  "tha-ap552:8.4": "sarasmiṃ va divākaro. // // ",
  "tha-ap552:9.1": "Soṇṇānanojinavaro ",
  "tha-ap552:9.2": "ramanīva siluccayo / ",
  "tha-ap552:9.3": "karuṇāpuṇṇahadayo ",
  "tha-ap552:9.4": "vivaddho viya sāgaro. // // ",
  "tha-ap552:10.1": "Lokavissutakittīca ",
  "tha-ap552:10.2": "Sineru va naguttamo / ",
  "tha-ap552:10.3": "yasasā vitato vīro ",
  "tha-ap552:10.4": "ākāsasadiso muni. // // ",
  "tha-ap552:11.1": "Asaṅgacittosabbattha ",
  "tha-ap552:11.2": "anilo viya nāyako / ",
  "tha-ap552:11.3": "patiṭṭhā sabbabhūtānaṃ ",
  "tha-ap552:11.4": "mahī va munisattamo. // // ",
  "tha-ap552:12.1": "Anupalittolokena ",
  "tha-ap552:12.2": "toyena padumaṃ yathā / ",
  "tha-ap552:12.3": "kupāda-kaccha-dahano ",
  "tha-ap552:12.4": "aggikkhandho va sobhasi. // // ",
  "tha-ap552:13.1": "Agadoviya sabbattha ",
  "tha-ap552:13.2": "kilesavisanāyako / ",
  "tha-ap552:13.3": "gandhamādanaselo va ",
  "tha-ap552:13.4": "guṇagandhavibhūsito. // // ",
  "tha-ap552:14.1": "Guṇānaṃākaro vīro ",
  "tha-ap552:14.2": "ratanānaṃ va sāgaro / ",
  "tha-ap552:14.3": "sindhava va narājañño ",
  "tha-ap552:14.4": "kilesamalahārako. // // ",
  "tha-ap552:15.1": "Vijayīva mahāyodho ",
  "tha-ap552:15.2": "Mārasenāpamaddano / ",
  "tha-ap552:15.3": "cakkavattī va so rājā ",
  "tha-ap552:15.4": "bojjhaṅgaratan' issaro. // // ",
  "tha-ap552:16.1": "",
  "tha-ap552:16.2": "Mahābhisakkasaṅkāsodosavyādhitikicchako / ",
  "tha-ap552:16.3": "sallakatto yathā seṭṭho ",
  "tha-ap552:16.4": "diṭṭhigaṇḍaviphālako. // // ",
  "tha-ap552:17.1": "Sotadā lokapajjoto ",
  "tha-ap552:17.2": "sanarāmarasakkato / ",
  "tha-ap552:17.3": "parisāsu narādicco ",
  "tha-ap552:17.4": "dhammaṃ desayate jino: // // ",
  "tha-ap552:18.1": "Dānaṃdatvā mahābhogo ",
  "tha-ap552:18.2": "sīlena sugatūpago / ",
  "tha-ap552:18.3": "bhāvanāya ca nibbāti ",
  "tha-ap552:18.4": "icc' eva ",
  "tha-ap552:19.1": "m' anusāsatha. // // Desanantaṃ mahassādaṃ ",
  "tha-ap552:19.2": "ādimajjhantasobhanaṃ / ",
  "tha-ap552:19.3": "suṇanti parisā sabbā ",
  "tha-ap552:19.4": "amataṃ va mahārasaṃ. // // ",
  "tha-ap552:20.1": "Sutvāsumadhuraṃ dhammaṃ ",
  "tha-ap552:20.2": "pasanno jinasāsane / ",
  "tha-ap552:20.3": "sugataṃ saraṇaṃ gantvā ",
  "tha-ap552:20.4": "yāvajīvaṃ namass' ahaṃ. // // ",
  "tha-ap552:21.1": "Muninogandhakuṭiyā ",
  "tha-ap552:21.2": "opuñchesi tadā mahiṃ / ",
  "tha-ap552:21.3": "catujjātena gandhena ",
  "tha-ap552:21.4": "māse aṭṭhadine svahaṃ. // // Paṇidhāyasugandhan ",
  "tha-ap552:22.1": "taṃ sarīrassa ",
  "tha-ap552:22.2": "vigandhino / ",
  "tha-ap552:22.3": "tadā jino viyākāsi ",
  "tha-ap552:22.4": "sugandhatanulābhitaṃ. // // ",
  "tha-ap552:23.1": "Yoyaṃ gandhakuṭiṃ bhumiṃ ",
  "tha-ap552:23.2": "gandhen' opuñjate sakiṃ / ",
  "tha-ap552:23.3": "tena kammavipākena ",
  "tha-ap552:23.4": "upapanno yahiṃ tahiṃ // // ",
  "tha-ap552:24.1": "Sugandhadehosabbattha ",
  "tha-ap552:24.2": "bhavissati ayaṃ naro / ",
  "tha-ap552:24.3": "guṇagandhāyuto hutvā ",
  "tha-ap552:24.4": "nibbāyissat' anāsavo. // // ",
  "tha-ap552:25.1": "Tenakammena sukatena ",
  "tha-ap552:25.2": "cetanāpaṇidhīhi ca / ",
  "tha-ap552:25.3": "jahitvā mānusaṃ dehaṃ ",
  "tha-ap552:25.4": "Tāvatiṃsaṃ agacch' ahaṃ // // ",
  "tha-ap552:26.1": "Pacchimeca bhave dāni ",
  "tha-ap552:26.2": "jāto vippakule ahaṃ / ",
  "tha-ap552:26.3": "gabbham me vasato mātā ",
  "tha-ap552:26.4": "dehen' āsi sugandhitā. // // ",
  "tha-ap552:27.1": "Yadāca mātukucchimhā ",
  "tha-ap552:27.2": "*nikkhamāmi* tadā puri / ",
  "tha-ap552:27.3": "Sāvatthi sabbagandhehi ",
  "tha-ap552:27.4": "vāsitā viya vāyathā // // ",
  "tha-ap552:28.1": "Pupphavassañca surabhiṃ ",
  "tha-ap552:28.2": "dibbagandhaṃ manoramaṃ / ",
  "tha-ap552:28.3": "dhūpāni ca mahagghāni ",
  "tha-ap552:28.4": "upavāyiṃsu tāvade. // // ",
  "tha-ap552:29.1": "Devāca sabbagandhehi ",
  "tha-ap552:29.2": "dhūpapupphehi taṃ gharaṃ / ",
  "tha-ap552:29.3": "vāsayiṃsu sugandhena ",
  "tha-ap552:29.4": "yasmiṃ *jāto ahaṃ gha*re. // // ",
  "tha-ap552:30.1": "Yadāca taruṇo bhaddo ",
  "tha-ap552:30.2": "paṭhame yobbane ṭhito / ",
  "tha-ap552:30.3": "tadā Selaṃ saparisaṃ ",
  "tha-ap552:30.4": "vinetvā narasārathi. // // ",
  "tha-ap552:31.1": "Tehisabbehi sahito ",
  "tha-ap552:31.2": "Sāvatthipuram āgato / ",
  "tha-ap552:31.3": "tadā Buddhānubhāvan taṃ ",
  "tha-ap552:31.4": "disvā pabbajito ahaṃ. // // ",
  "tha-ap552:32.1": "Sīlaṃsamādhipaññañ ca ",
  "tha-ap552:32.2": "vimuttiñ ca anuttaraṃ / ",
  "tha-ap552:32.3": "bhāvetvā caturo dhamme ",
  "tha-ap552:32.4": "'pāpuṇiṃ āsavakkhayaṃ. // // ",
  "tha-ap552:33.1": "Yadāpabbajito c' āhaṃ ",
  "tha-ap552:33.2": "yadā ca arahaṃ ahaṃ / ",
  "tha-ap552:33.3": "nibbāyissaṃ yadā c' āhaṃ ",
  "tha-ap552:33.4": "gandhavasso tadā ahu. // // ",
  "tha-ap552:34.1": "Sarīragandhoca saṭṭho 'tiseti me ",
  "tha-ap552:34.2": "mahārahaṃ candanañ campakuppalaṃ / ",
  "tha-ap552:34.3": "Tath' eva gandhe itare va sabbato ",
  "tha-ap552:34.4": "pasayha vāyāmi gato tahiṃ tahiṃ. // // ",
  "tha-ap552:35.1": "Kilesā. . . ",
  "tha-ap552:35.2": "pe . . . ",
  "tha-ap552:35.3": "",
  "tha-ap552:36.1": "",
  "tha-ap552:36.2": "pe . . . ",
  "tha-ap552:36.3": "pe . . . // // Sāgataṃ. . . pe . . . pe . . . pe . . . // // ",
  "tha-ap552:37.1": "Paṭisambhidā. . . ",
  "tha-ap552:37.2": "pe . . . ",
  "tha-ap552:37.3": "pe . . . pe . . . // // ",
  "tha-ap552:38.1": "Itthaṃ sudaṃ āyasmā Cūlasugandho thero i. g. a- ti. Cūlasugandhattherassa ",
  "tha-ap552:39.1": "",
  "tha-ap552:40.1": "apadānaṃ samattaṃ. ",
  "tha-ap552:41.1": "Uddānaṃ: ",
  "tha-ap552:42.1": "Bhaddiyo Revato-thero ",
  "tha-ap552:42.2": "mahālābhī ca Sīvalī ",
  "tha-ap552:42.3": "Vaṅgīso Nandako c' eva ",
  "tha-ap552:42.4": "Kāḷudāyi tath' Ābhayo. ",
  "tha-ap552:43.1": "Lomaso Vanavaccho ca ",
  "tha-ap552:43.2": "Sugandho dasamo kato ",
  "tha-ap552:43.3": "tīṇi gāthā satā tattha ",
  "tha-ap552:43.4": "soḷasā ca taduttari. ",
  "tha-ap552:44.1": "Atha vaggUddānaṃ: ",
  "tha-ap552:45.1": "Kaṇikāravhayo vaggo ",
  "tha-ap552:45.2": "Phalado Tiṇadāyako ",
  "tha-ap552:45.3": "Kaccāno Bhaddiyo vaggo ",
  "tha-ap552:45.4": "gāthāyo gaṇitā v-iha. ",
  "tha-ap552:46.1": "Navagāthāsatānīha ",
  "tha-ap552:46.2": "caturāsītim eva ca ",
  "tha-ap552:46.3": "sapaññāsaṃ pañcasatā ",
  "tha-ap552:46.4": "apadānā pakāsitā. ",
  "tha-ap552:47.1": "Saha uddānagāthāhi ",
  "tha-ap552:47.2": "cha sahassāni hont' imā ",
  "tha-ap552:47.3": "dvesatāni ca gāthānaṃ ",
  "tha-ap552:47.4": "aṭṭhādasa tad uttariṃ. Ettāvatā Buddhāpadānañ "
}
