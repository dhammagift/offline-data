  "tha-ap46:0.1": "",
  "tha-ap46:0.2": "",
  "tha-ap46:0.3": "",
  "tha-ap46:1.1": "Araññe kuṭikaṃ katvā ",
  "tha-ap46:1.2": "vasāmi pabbatantare / ",
  "tha-ap46:1.3": "lābhālābhena santuṭṭho ",
  "tha-ap46:1.4": "yasena ayasena ca. // // ",
  "tha-ap46:2.1": "Padumuttaro lokavidū ",
  "tha-ap46:2.2": "āhutīnaṃ paṭiggaho / ",
  "tha-ap46:2.3": "vasīsatasahassehi ",
  "tha-ap46:2.4": "āgañchi mama santike. // // ",
  "tha-ap46:3.1": "Upāgataṃ mahāvīraṃ ",
  "tha-ap46:3.2": "jalajuttamanāyakaṃ / ",
  "tha-ap46:3.3": "tiṇasantharaṃ paññāpetvā ",
  "tha-ap46:3.4": "adāsiṃ satthuno ahaṃ. // // ",
  "tha-ap46:4.1": "Pasannacitto sumano ",
  "tha-ap46:4.2": "āmaṇḍaṃ pāniyañ ca 'haṃ / ",
  "tha-ap46:4.3": "adāsiṃ ujubhūtassa ",
  "tha-ap46:4.4": "vippasannena cetasā. // // ",
  "tha-ap46:5.1": "Satasahass' ito kappe ",
  "tha-ap46:5.2": "yaṃ dānam adadiṃ tadā / ",
  "tha-ap46:5.3": "duggatiṃ nābhijānāmi ",
  "tha-ap46:5.4": "āmaṇḍass' idaṃ phalaṃ. // // ",
  "tha-ap46:6.1": "Ekatālīsakappamhi ",
  "tha-ap46:6.2": "eko āsi Arindamo / ",
  "tha-ap46:6.3": "sattaratanasampanno ",
  "tha-ap46:6.4": "cakkavattī mahābalo. // // ",
  "tha-ap46:7.1": "Paṭisambhidā catasso ",
  "tha-ap46:7.2": "vimokhā pi ca aṭṭh' ime / chaḷabhiññā sacchikatā ",
  "tha-ap46:7.3": "kataṃ Buddhassa sāsanan ti. // // ",
  "tha-ap46:8.1": "Itthaṃ sudaṃ āyasmā Sannidhāpako thero imā gāthāyo abhāsitthā ti. Sannidhāpakatherassa apadānaṃ samattaṃ. ",
  "tha-ap46:9.1": ""
}
