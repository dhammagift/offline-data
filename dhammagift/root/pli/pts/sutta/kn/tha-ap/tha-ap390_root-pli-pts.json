  "tha-ap390:1.1": "Ajjuno nāma sambuddho ",
  "tha-ap390:1.2": "Himavante vasī tadā / ",
  "tha-ap390:1.3": "caraṇena ca sampanno ",
  "tha-ap390:1.4": "samādhikusalo muni. // // ",
  "tha-ap390:2.1": "Kumbhamattaṃ gahetvāna ",
  "tha-ap390:2.2": "panasaṃ jīvajīvakaṃ / ",
  "tha-ap390:2.3": "chattapaṇṇe thapetvāna ",
  "tha-ap390:2.4": "adāsiṃ satthuno ahaṃ. // // ",
  "tha-ap390:3.1": "Ekanavut' ito kappe ",
  "tha-ap390:3.2": "yaṃ phalam adadiṃ tadā / ",
  "tha-ap390:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap390:3.4": "phaladānass' idaṃ phalaṃ. // // ",
  "tha-ap390:4.1": "Sāgataṃ . . . pe . . . pe . . . // // Kilesā . . . ",
  "tha-ap390:4.2": "pe . . . ",
  "tha-ap390:4.3": "",
  "tha-ap390:5.1": "",
  "tha-ap390:5.2": "pe . . . // // ",
  "tha-ap390:5.3": "",
  "tha-ap390:6.1": "Paṭisambhidā . . . ",
  "tha-ap390:6.2": "pe . . . ",
  "tha-ap390:6.3": "pe . . . // // ",
  "tha-ap390:7.1": "Itthaṃ sudam āyasmā Panasaphaladāyako th. i. g. a-ti. Panasaphaladāyakattherassa apadānaṃ samattaṃ. ",
  "tha-ap390:8.1": ""
}
