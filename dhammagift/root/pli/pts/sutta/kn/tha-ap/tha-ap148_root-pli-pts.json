  "tha-ap148:1.1": "",
  "tha-ap148:1.2": "",
  "tha-ap148:1.3": "sudhāya piṇḍaṃ datvāna ",
  "tha-ap148:1.4": "pāṇikammaṃ akās' ahaṃ. // // ",
  "tha-ap148:2.1": "Disvā taṃ sukataṃ kammaṃ ",
  "tha-ap148:2.2": "Anomadassī naruttamo / ",
  "tha-ap148:2.3": "bhikkhusaṅghe ṭhito satthā ",
  "tha-ap148:2.4": "imā gāthā abhāsatha: // // ",
  "tha-ap148:3.1": "‘Iminā sudhakammena ",
  "tha-ap148:3.2": "cetasā-paṇidhīhi ca / ",
  "tha-ap148:3.3": "sampattiṃ anubhotvāna ",
  "tha-ap148:3.4": "dukkhass' antaṃ karissati.' // // ",
  "tha-ap148:4.1": "Pasannamukhavaṇṇo 'mhi ",
  "tha-ap148:4.2": "ekaggo susamāhito / ",
  "tha-ap148:4.3": "dhāremi antimaṃ dehaṃ ",
  "tha-ap148:4.4": "sammāsambuddhasāsane. // // ",
  "tha-ap148:5.1": "Ito kappasate āsi ",
  "tha-ap148:5.2": "paripuṇṇe anūnake / ",
  "tha-ap148:5.3": "rājā Sabbagghano nāma ",
  "tha-ap148:5.4": "cakkavattī mahābalo. // // ",
  "tha-ap148:6.1": "Paṭisambhidā . . . ",
  "tha-ap148:6.2": "pe . . . ",
  "tha-ap148:6.3": "pe . . . // // ",
  "tha-ap148:7.1": "Itthaṃ sudaṃ ā. Anulomadāyako thero i. g. a-ti. Anulomadāyakattherassa apadānaṃ samattaṃ. ",
  "tha-ap148:8.1": ""
}
