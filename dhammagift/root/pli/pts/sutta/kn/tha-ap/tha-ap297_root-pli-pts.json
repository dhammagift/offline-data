  "tha-ap297:0.2": "",
  "tha-ap297:0.3": "",
  "tha-ap297:1.1": "Ārāmadvārā nikkhamma ",
  "tha-ap297:1.2": "gosīsaṃ santhataṃ mayā / ",
  "tha-ap297:1.3": "anuhomi sakaṃ kammaṃ ",
  "tha-ap297:1.4": "pubbakammass' idaṃ phalaṃ. // // ",
  "tha-ap297:2.1": "Ājāniyā vātajavā ",
  "tha-ap297:2.2": "sindhavā sīghavāhanā / ",
  "tha-ap297:2.3": "anubhomi sabbam etaṃ ",
  "tha-ap297:2.4": "gosīsassa idaṃ phalaṃ. // // ",
  "tha-ap297:3.1": "Aho kāraṃ paramaṃ kāraṃ ",
  "tha-ap297:3.2": "sukhette sukataṃ mayā / ",
  "tha-ap297:3.3": "saṅghe katassa kārassa ",
  "tha-ap297:3.4": "na aññaṃ kalam agghati. // // Catunavute ",
  "tha-ap297:4.1": "ito kappe ",
  "tha-ap297:4.2": "yaṃ sīsaṃ santharim ahaṃ / ",
  "tha-ap297:4.3": "duggatiṃ nābhijānāmi ",
  "tha-ap297:4.4": "santhārass' idaṃ phalaṃ. // // ",
  "tha-ap297:5.1": "Pañcasattati kappamhi ",
  "tha-ap297:5.2": "Suppatiṭṭhita-nāmako / ",
  "tha-ap297:5.3": "eko āsi mahātejo ",
  "tha-ap297:5.4": "cakkavattī mahabbalo. // // ",
  "tha-ap297:6.1": "Paṭisambhidā . . . ",
  "tha-ap297:6.2": "pe . . . ",
  "tha-ap297:6.3": "pe . . . // // ",
  "tha-ap297:7.1": "Itthaṃ sudam āyasmā Gosīsanikkhepo thero i. g. a-ti. Gosīsanikkhepattherassa ",
  "tha-ap297:8.1": "apadānaṃ samattaṃ. "
}
