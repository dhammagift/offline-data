  "tha-ap444:1.1": "Ajinena nivattho 'haṃ ",
  "tha-ap444:1.2": "vākacīradharo tadā / ",
  "tha-ap444:1.3": "khāribhāraṃ haritvāna kolam ",
  "tha-ap444:1.4": "āharim assamaṃ. // // ",
  "tha-ap444:2.1": "Tamhi kāle Sikhī buddho ",
  "tha-ap444:2.2": "eko adutiyo ahū / ",
  "tha-ap444:2.3": "mam assamaṃ upagacchi ",
  "tha-ap444:2.4": "jotento sabbakālikaṃ. // // ",
  "tha-ap444:3.1": "Sakaṃ cittaṃ pasādetvā ",
  "tha-ap444:3.2": "vanditvāna ca subbataṃ / ",
  "tha-ap444:3.3": "ubho hatthehi paggayha ",
  "tha-ap444:3.4": "kolaṃ Buddhass' adās' ahaṃ. // // ",
  "tha-ap444:4.1": "Ekatiṃse ito kappe ",
  "tha-ap444:4.2": "yaṃ phalam adadiṃ tadā / ",
  "tha-ap444:4.3": "duggatiṃ nābhijānāmi ",
  "tha-ap444:4.4": "koladānass' idaṃ phalaṃ. // // ",
  "tha-ap444:5.1": "Kilesā . . . ",
  "tha-ap444:5.2": "pe . . . ",
  "tha-ap444:5.3": "",
  "tha-ap444:6.1": "",
  "tha-ap444:6.2": "pe . . . ",
  "tha-ap444:6.3": "pe . . . // // Sāgataṃ . . . pe . . . pe . . . pe . . . // // ",
  "tha-ap444:7.1": "Paṭisambhidā . . . ",
  "tha-ap444:7.2": "pe . . . ",
  "tha-ap444:7.3": "pe . . . pe . . . // // ",
  "tha-ap444:8.1": "Itthaṃ sudam āyasmā Koladāyako thero i. g. a-ti. Koladāyakattherassa ",
  "tha-ap444:9.1": "apadānaṃ samattaṃ. "
}
