  "tha-ap129:0.2": "",
  "tha-ap129:0.3": "",
  "tha-ap129:1.1": "Ajjhāyako mantadharo ",
  "tha-ap129:1.2": "tiṇṇaṃ vedāna-pāragū / ",
  "tha-ap129:1.3": "Himavantass' avidūre ",
  "tha-ap129:1.4": "vasāmi assame ahaṃ. // // ",
  "tha-ap129:2.1": "Aggihuttañ ca me atthi ",
  "tha-ap129:2.2": "puṇḍarīka-phalāni ca / ",
  "tha-ap129:2.3": "puṭake nikkhipitvāna ",
  "tha-ap129:2.4": "dumagge laggitaṃ mayā. // // ",
  "tha-ap129:3.1": "Padumuttaro lokavidū ",
  "tha-ap129:3.2": "āhutīnaṃ paṭiggaho / ",
  "tha-ap129:3.3": "mam uddharitukāmo so ",
  "tha-ap129:3.4": "bhikkhanto mam upāgami. // // ",
  "tha-ap129:4.1": "Pasannacitto sumano ",
  "tha-ap129:4.2": "phalaṃ Buddhass' adās' ahaṃ / ",
  "tha-ap129:4.3": "vittisañjanano mayhaṃ ",
  "tha-ap129:4.4": "diṭṭhadhammasukhāvaho. // // ",
  "tha-ap129:5.1": "Suvaṇṇavaṇṇo sambuddho ",
  "tha-ap129:5.2": "āhutīnaṃ paṭiggaho / ",
  "tha-ap129:5.3": "antalikkhe ṭhito satthā ",
  "tha-ap129:5.4": "imā gāthā abhāsatha: // // ",
  "tha-ap129:6.1": "‘Iminā phaladānena ",
  "tha-ap129:6.2": "cetanā paṇidhīhi ca / ",
  "tha-ap129:6.3": "kappānaṃ satasahassaṃ ",
  "tha-ap129:6.4": "duggatiṃ nūpagacchati.' // // ",
  "tha-ap129:7.1": "Ten' eva sukkamūlena ",
  "tha-ap129:7.2": "anubhotvāna sampadā / ",
  "tha-ap129:7.3": "patto 'mhi acalaṃ ṭhānaṃ ",
  "tha-ap129:7.4": "hitvā jayaparājayaṃ. // // ",
  "tha-ap129:8.1": "Ito sattakappasate ",
  "tha-ap129:8.2": "rājā āsi Sumaṅgalo / ",
  "tha-ap129:8.3": "sattaratanasampanno ",
  "tha-ap129:8.4": "cakkavattī mahābalo. // // ",
  "tha-ap129:9.1": "Paṭisambhidā . . . ",
  "tha-ap129:9.2": "pe . . . // // ",
  "tha-ap129:9.3": "",
  "tha-ap129:10.1": "Itthaṃ sudaṃ āyasmā Phaladāyako thero imā gāthāyo abhāsitthā ti. Phaladāyakatherassa apadānaṃ samattaṃ. ",
  "tha-ap129:11.1": ""
}
