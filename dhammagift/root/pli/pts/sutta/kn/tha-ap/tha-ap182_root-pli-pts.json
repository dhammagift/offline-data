  "tha-ap182:0.1": "",
  "tha-ap182:0.2": "",
  "tha-ap182:0.3": "",
  "tha-ap182:1.1": "Vessabhumhi bhagavati ",
  "tha-ap182:1.2": "ahos' ārāmiko ahaṃ / ",
  "tha-ap182:1.3": "pasannacitto sumano ",
  "tha-ap182:1.4": "upaṭṭhiṃ saṅgham uttamaṃ. // // ",
  "tha-ap182:2.1": "Ekatiṃse ito kappe ",
  "tha-ap182:2.2": "yaṃ kammam akariṃ tadā / ",
  "tha-ap182:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap182:2.4": "upaṭṭhānass' idaṃ phalaṃ. // // ",
  "tha-ap182:3.1": "Ito sattame kappe ",
  "tha-ap182:3.2": "satt' ev' āsuṃ Samotthaṭā / ",
  "tha-ap182:3.3": "sattaratanasampannā ",
  "tha-ap182:3.4": "cakkavattī mahabbalā. // // ",
  "tha-ap182:4.1": "Paṭisambhidā . . . ",
  "tha-ap182:4.2": "pe . . . ",
  "tha-ap182:4.3": "pe . . . // // ",
  "tha-ap182:5.1": "Itthaṃ sudaṃ āyasmā Saṅghupaṭṭhāko thero i. g. ā- ti. Saṅghupaṭṭhākattherassa apadānaṃ samattaṃ. ",
  "tha-ap182:6.1": "",
  "tha-ap182:7.1": "",
  "tha-ap182:8.1": "Uddānaṃ: ",
  "tha-ap182:9.1": "Kumudo, atha Nisseṇī ",
  "tha-ap182:9.2": "Rattiko Udapānado ",
  "tha-ap182:9.3": "Sīhāsanī Maggavado ",
  "tha-ap182:9.4": "Ekadīpī Maṇippado ",
  "tha-ap182:9.5": "Tikicchako Upaṭṭhāko ",
  "tha-ap182:9.6": "ekūnapaññāsagāthakā. "
}
