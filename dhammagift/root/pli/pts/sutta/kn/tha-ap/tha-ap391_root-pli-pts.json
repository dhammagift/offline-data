  "tha-ap391:0.1": "",
  "tha-ap391:0.2": "",
  "tha-ap391:0.3": "",
  "tha-ap391:1.1": "Vipassino pāvacane ",
  "tha-ap391:1.2": "ekaṃ leṇaṃ mayā kataṃ / ",
  "tha-ap391:1.3": "cātuddisassa saṅghassa ",
  "tha-ap391:1.4": "Bandhumā-rājadhāniyā. // // ",
  "tha-ap391:2.1": "Dussehi bhūmileṇassa ",
  "tha-ap391:2.2": "santharitvā pariccajiṃ / ",
  "tha-ap391:2.3": "udaggacitto sumano ",
  "tha-ap391:2.4": "akāsiṃ paṇidhiṃ tadā: // // ",
  "tha-ap391:3.1": "‘Ārādhayeyyaṃ sambuddhaṃ ",
  "tha-ap391:3.2": "pabbajjañ ca labheyy' ahaṃ / ",
  "tha-ap391:3.3": "anuttarañ ca nibbānaṃ ",
  "tha-ap391:3.4": "phuseyyaṃ santim uttamaṃ.' // // ",
  "tha-ap391:4.1": "Ten' eva sukkamūlena ",
  "tha-ap391:4.2": "kappaṃ navuti saṃsariṃ / ",
  "tha-ap391:4.3": "devabhūto manusso va ",
  "tha-ap391:4.4": "katapuñño viroc' ahaṃ. // // ",
  "tha-ap391:5.1": "Tato kammāvasesena ",
  "tha-ap391:5.2": "idha pacchimake bhave / ",
  "tha-ap391:5.3": "Campāyam aggaseṭṭhissa ",
  "tha-ap391:5.4": "jāto 'mhi ekaputtako. // // ",
  "tha-ap391:6.1": "Jāta*mat*tassa me sutvā ",
  "tha-ap391:6.2": "pitucchando ayam ahu / ",
  "tha-ap391:6.3": "dadām' ahaṃ kumārassa ",
  "tha-ap391:6.4": "vīsakoṭianūnakā. // // ",
  "tha-ap391:7.1": "Caturaṅgulā ca me lomā ",
  "tha-ap391:7.2": "jātā pādatale ubho / ",
  "tha-ap391:7.3": "sukhumā mudusamphassā ",
  "tha-ap391:7.4": "'tulāpi ca mahāsubhā. // // ",
  "tha-ap391:8.1": "Atītā navutī kappā ",
  "tha-ap391:8.2": "*ay*am eko 'va uttariṃ / ",
  "tha-ap391:8.3": "nābhijānāmi nikkhitte ",
  "tha-ap391:8.4": "pāde bhume asanthate. // // ",
  "tha-ap391:9.1": "Ārādhito me sambuddho ",
  "tha-ap391:9.2": "pabbajim anagāriyaṃ / ",
  "tha-ap391:9.3": "arahattañ ca me pattaṃ ",
  "tha-ap391:9.4": "sītibhūto 'mhi nibbuto. // // ",
  "tha-ap391:10.1": "Aggo āraddhaviriyānaṃ ",
  "tha-ap391:10.2": "niddiṭṭho *sabbadassinā* / ",
  "tha-ap391:10.3": "khīṇāsavo ca arahā ",
  "tha-ap391:10.4": "chaḷabhiññāmahiddhiko. // // ",
  "tha-ap391:11.1": "Ekanavut' ito kappe ",
  "tha-ap391:11.2": "yaṃ dānam adadiṃ tadā / ",
  "tha-ap391:11.3": "duggatiṃ nābhijānāmi ",
  "tha-ap391:11.4": "leṇadānass' idaṃ phalaṃ. // // ",
  "tha-ap391:12.1": "Sāgataṃ . . . pe . . . pe . . . // // Kilesā . . . ",
  "tha-ap391:12.2": "pe . . . ",
  "tha-ap391:12.3": "",
  "tha-ap391:13.1": "",
  "tha-ap391:13.2": "pe . . . // // ",
  "tha-ap391:13.3": "",
  "tha-ap391:14.1": "Paṭisambhidā . . . ",
  "tha-ap391:14.2": "pe . . . ",
  "tha-ap391:14.3": "pe . . . // // ",
  "tha-ap391:15.1": "Koṭivīso ti so Soṇo ",
  "tha-ap391:15.2": "bhikkhu *saṅghassa aggato* ",
  "tha-ap391:15.3": "pañhaṃ puṭṭho viyākāsi ",
  "tha-ap391:15.4": "Anotatte mahāsare ti. ",
  "tha-ap391:16.1": "Itthaṃ sudam āyasmā Soṇo Koṭivīso thero i. g. a-ti. Soṇakoṭivīsattherassa ",
  "tha-ap391:17.1": "apadānaṃ samattaṃ. "
}
