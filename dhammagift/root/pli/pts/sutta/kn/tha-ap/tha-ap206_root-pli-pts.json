  "tha-ap206:1.1": "Atthadassī tu bhagavā ",
  "tha-ap206:1.2": "dipadindo narāsabho / ",
  "tha-ap206:1.3": "purakkhato sāvakehi ",
  "tha-ap206:1.4": "Gaṅgātīram upāgami. // // ",
  "tha-ap206:2.1": "Samatitthikākapeyyā ",
  "tha-ap206:2.2": "Gaṅgā āsi duruttarā / ",
  "tha-ap206:2.3": "uttārayiṃ bhikkhusaṅghaṃ ",
  "tha-ap206:2.4": "Buddhañ ca dvipaduttamaṃ. // // ",
  "tha-ap206:3.1": "Aṭṭhārase kappasate ",
  "tha-ap206:3.2": "yaṃ kammam akariṃ tadā / ",
  "tha-ap206:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap206:3.4": "taraṇāya idaṃ phalaṃ. // // ",
  "tha-ap206:4.1": "Terase 'to kappasate ",
  "tha-ap206:4.2": "pañca Sabhogavā ahuṃ / ",
  "tha-ap206:4.3": "sattaratanasampannā ",
  "tha-ap206:4.4": "cakkavattī mahabbalā // // ",
  "tha-ap206:5.1": "",
  "tha-ap206:5.2": "",
  "tha-ap206:5.3": "",
  "tha-ap206:5.4": "",
  "tha-ap206:6.1": "Paṭisambhidā . . . ",
  "tha-ap206:6.2": "pe . . . ",
  "tha-ap206:6.3": "pe . . . // // ",
  "tha-ap206:7.1": "Itthaṃ sudam āyasmā Taraṇiyo thero i. g. a-ti. Taraṇiyattherassa apadānaṃ samattaṃ. ",
  "tha-ap206:8.1": ""
}
