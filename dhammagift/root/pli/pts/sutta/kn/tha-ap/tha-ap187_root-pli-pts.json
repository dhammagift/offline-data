  "tha-ap187:0.1": "",
  "tha-ap187:0.2": "",
  "tha-ap187:0.3": "",
  "tha-ap187:1.1": "Udentaṃ sataraṃsiṃ va uggataṃ ",
  "tha-ap187:1.2": "iva bhānumaṃ / ",
  "tha-ap187:1.3": "kakudhaṃ vilasantaṃ va ",
  "tha-ap187:1.4": "Padumuttaranāyakaṃ. // // ",
  "tha-ap187:2.1": "Isimuggā nisandhetvā ",
  "tha-ap187:2.2": "madhukhudde anīlake / ",
  "tha-ap187:2.3": "pāsāde va ṭhito santo ",
  "tha-ap187:2.4": "adāsiṃ lokabandhuno. // // ",
  "tha-ap187:3.1": "Aṭṭhasatasahassāni ",
  "tha-ap187:3.2": "ahesuṃ Buddhasāvakā / ",
  "tha-ap187:3.3": "sabbesaṃ pattapūrentaṃ ",
  "tha-ap187:3.4": "tato cāpi bahuttaraṃ // // ",
  "tha-ap187:4.1": "Tena cittappasādena ",
  "tha-ap187:4.2": "sukkamūlena codito / ",
  "tha-ap187:4.3": "kappānaṃ satasahassaṃ ",
  "tha-ap187:4.4": "duggatiṃ nūpapajj' ahaṃ // // ",
  "tha-ap187:5.1": "Cattārīsamhi sahasse ",
  "tha-ap187:5.2": "kappānam aṭṭh' ahiṃsu te / ",
  "tha-ap187:5.3": "Mahisamanta-nāmā te ",
  "tha-ap187:5.4": "cakkavattī mahabbalā. // // ",
  "tha-ap187:6.1": "Paṭisambhidā . . . ",
  "tha-ap187:6.2": "pe . . . ",
  "tha-ap187:6.3": "pe . . . // // ",
  "tha-ap187:7.1": "Itthaṃ sudaṃ āyasmā Isimuggadāyako thero i. g. a-ti. Isimuggadāyakattherassa apadānaṃ samattaṃ. ",
  "tha-ap187:8.1": ""
}
