  "tha-ap85:0.1": "",
  "tha-ap85:0.2": "",
  "tha-ap85:0.3": "",
  "tha-ap85:1.1": "Rukkhamūle nisinno 'haṃ ",
  "tha-ap85:1.2": "vyādhito paramen' ahaṃ / ",
  "tha-ap85:1.3": "paramakāruññapatto 'mhi ",
  "tha-ap85:1.4": "araññe kānane ahaṃ. // // ",
  "tha-ap85:2.1": "Anukampaṃ upādāya ",
  "tha-ap85:2.2": "Tisso satthā upesi maṃ / ",
  "tha-ap85:2.3": "so 'haṃ nipannako santo ",
  "tha-ap85:2.4": "sīre katvāna añjaliṃ. // // ",
  "tha-ap85:3.1": "Pasannacitto sumano ",
  "tha-ap85:3.2": "sabbasattānam uttamaṃ / ",
  "tha-ap85:3.3": "sambuddhaṃ abhivādetvā ",
  "tha-ap85:3.4": "tattha kālakato ahaṃ. // // ",
  "tha-ap85:4.1": "Dvenavute ito kappe ",
  "tha-ap85:4.2": "yaṃ vandiṃ purisuttamaṃ / ",
  "tha-ap85:4.3": "duggatiṃ nābhijānāmi ",
  "tha-ap85:4.4": "vandanāya idaṃ phalaṃ. // // ",
  "tha-ap85:5.1": "Ito pañcamake kappe ",
  "tha-ap85:5.2": "pañc' ev' āsuṃ Mahāsikhā / ",
  "tha-ap85:5.3": "sattaratanasampannā ",
  "tha-ap85:5.4": "cakkavattī mahabbalā. // // ",
  "tha-ap85:6.1": "Paṭisambhidā catasso ",
  "tha-ap85:6.2": "vimokhā pi ca aṭṭh' ime / chaḍabhiññā sacchikatā ",
  "tha-ap85:6.3": "kataṃ Buddhassa sāsanan ti. // // ",
  "tha-ap85:7.1": "Itthaṃ sudaṃ āyasmā Pannañjaliyo thero imā gāthāyo abhāsitthā ti. ",
  "tha-ap85:8.1": "Pannañjalikattherassa apadānaṃ samattaṃ. "
}
