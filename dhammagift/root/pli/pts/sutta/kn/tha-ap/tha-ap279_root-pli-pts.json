  "tha-ap279:1.1": "Candabhāgānadītīre ",
  "tha-ap279:1.2": "anusotaṃ vajām' ahaṃ / ",
  "tha-ap279:1.3": "satta māluvapupphāni ",
  "tha-ap279:1.4": "citak' āropayim ahaṃ. // // ",
  "tha-ap279:2.1": "Catunavute ito kappe ",
  "tha-ap279:2.2": "citakaṃ yaṃ apūjayiṃ / ",
  "tha-ap279:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap279:2.4": "citakapūjāy' idaṃ phalaṃ. // // ",
  "tha-ap279:3.1": "Sattasaṭṭhimh' ito kappe ",
  "tha-ap279:3.2": "Paṭijagga-sanāmakā / ",
  "tha-ap279:3.3": "sattaratanasampannā ",
  "tha-ap279:3.4": "satt' āsuṃ cakkavattino. // // ",
  "tha-ap279:4.1": "Paṭisambhidā . . . ",
  "tha-ap279:4.2": "pe . . . ",
  "tha-ap279:4.3": "pe . . . // // ",
  "tha-ap279:5.1": "Itthaṃ sudam āyasmā Citakapūjako thero i. g. a-ti. Citakapūjakattherassa apadānaṃ samattaṃ. ",
  "tha-ap279:6.1": ""
}
