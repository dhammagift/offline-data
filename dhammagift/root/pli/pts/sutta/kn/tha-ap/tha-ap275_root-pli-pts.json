  "tha-ap275:0.3": "",
  "tha-ap275:1.1": "Mahāsamuddaṃ nissāya ",
  "tha-ap275:1.2": "vasate pabbatantare / ",
  "tha-ap275:1.3": "paccuggantvān' akāmāhaṃ caṅgoṭakam ",
  "tha-ap275:1.4": "adās' ahaṃ. // // ",
  "tha-ap275:2.1": "Siddhatthassa mahesissa ",
  "tha-ap275:2.2": "sabbabhūtānukampino / ",
  "tha-ap275:2.3": "pupphacaṅgoṭakaṃ datvā ",
  "tha-ap275:2.4": "kappaṃ saggamhi mod' ahaṃ. // // Catunavute ",
  "tha-ap275:3.1": "ito kappe ",
  "tha-ap275:3.2": "caṅgoṭakam adaṃ tadā / ",
  "tha-ap275:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap275:3.4": "caṅgoṭakass' idaṃ phalaṃ. // // ",
  "tha-ap275:4.1": "Paṭisambhidā . . . ",
  "tha-ap275:4.2": "pe . . . ",
  "tha-ap275:4.3": "pe . . . // // ",
  "tha-ap275:5.1": "Itthaṃ sudam āyasmā Caṅgoṭakiyo thero i. g. a-ti. Caṅgoṭakiyattherassa apadānaṃ samattaṃ. ",
  "tha-ap275:6.1": ""
}
