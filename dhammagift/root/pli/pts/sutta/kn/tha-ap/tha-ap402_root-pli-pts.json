  "tha-ap402:1.1": "Padumuttaro nāma jino ",
  "tha-ap402:1.2": "sabbadhammāna pāragū / ",
  "tha-ap402:1.3": "ajjhogāhetvā Himavantaṃ ",
  "tha-ap402:1.4": "nisīdi lokanāyako. // // ",
  "tha-ap402:2.1": "Nāham addakkhiṃ sambuddhaṃ ",
  "tha-ap402:2.2": "na pi saddaṃ suṇom' ahaṃ / ",
  "tha-ap402:2.3": "mamaṃ bhikkhaṃ gavesanto ",
  "tha-ap402:2.4": "āhiṇḍāmi vane ahaṃ. // // ",
  "tha-ap402:3.1": "Tatth' addasāsiṃ sambuddhaṃ ",
  "tha-ap402:3.2": "dvattiṃsavaralakkhaṇaṃ / ",
  "tha-ap402:3.3": "disvāna cittam āpajjiṃ: ",
  "tha-ap402:3.4": "satto ko nām' ayaṃ bhave? // // ",
  "tha-ap402:4.1": "Lakkhaṇāni viloketvā ",
  "tha-ap402:4.2": "mama vijjam anussariṃ / ",
  "tha-ap402:4.3": "sutaṃ hi me taṃ Buddhānaṃ ",
  "tha-ap402:4.4": "paṇḍitānaṃ subhāsitaṃ. // // ",
  "tha-ap402:5.1": "Tesaṃ tathā taṃ vacanam: ",
  "tha-ap402:5.2": "ayaṃ Buddho bhavissati / ",
  "tha-ap402:5.3": "yannunāhaṃ sakkareyyaṃ ",
  "tha-ap402:5.4": "gatiṃ me sodhayissati. // // ",
  "tha-ap402:6.1": "Khippam assamam āgantvā ",
  "tha-ap402:6.2": "dumatelaṃ gahim ahaṃ / ",
  "tha-ap402:6.3": "kolambakaṃ gahetvāna ",
  "tha-ap402:6.4": "upagacchiṃ vināyakaṃ. // // ",
  "tha-ap402:7.1": "Tidaṇḍake gahetvāna ",
  "tha-ap402:7.2": "abbhokāse ṭhapes' ahaṃ / ",
  "tha-ap402:7.3": "padīpaṃ pajjaletvāna ",
  "tha-ap402:7.4": "aṭṭhakkhattum avand' ahaṃ. // // ",
  "tha-ap402:8.1": "Sattarattindivaṃ Buddho ",
  "tha-ap402:8.2": "nisīdi purisuttamo / ",
  "tha-ap402:8.3": "tato ratyā vivasane ",
  "tha-ap402:8.4": "vuṭṭhāsi lokanāyako. // // ",
  "tha-ap402:9.1": "Pasannacitto sumano ",
  "tha-ap402:9.2": "sabbarattindivam ahaṃ / ",
  "tha-ap402:9.3": "dīpaṃ Buddhassa pādāsiṃ ",
  "tha-ap402:9.4": "pasanno sehi pānihi. // // ",
  "tha-ap402:10.1": "Sabbe vanā gandhamayā ",
  "tha-ap402:10.2": "pabbate Gandhamādane / ",
  "tha-ap402:10.3": "Buddhass' ānubhāvena ",
  "tha-ap402:10.4": "upagacchuṃ tadā jinaṃ. // // ",
  "tha-ap402:11.1": "Ye keci pupphagandhā ye ",
  "tha-ap402:11.2": "pupphitā dharaṇīruhā / ",
  "tha-ap402:11.3": "Buddhass' ānubhāvena ",
  "tha-ap402:11.4": "sabbe sannipatuṃ tadā. // // ",
  "tha-ap402:12.1": "Yāvatā Himavantamhi ",
  "tha-ap402:12.2": "nāgā ca garuḷā ubho / ",
  "tha-ap402:12.3": "dhammañ va sotukāmā te ",
  "tha-ap402:12.4": "āgacchuṃ Buddhasantike. // // ",
  "tha-ap402:13.1": "Devalo nāma samaṇo ",
  "tha-ap402:13.2": "Buddhassa aggasāvako / ",
  "tha-ap402:13.3": "vasīsatasahassehi ",
  "tha-ap402:13.4": "Buddhasantik' upāgami. // // ",
  "tha-ap402:14.1": "Padumuttaro lokavidū ",
  "tha-ap402:14.2": "āhutīnaṃ paṭiggaho / ",
  "tha-ap402:14.3": "bhikkhusaṅghe nisīditvā ",
  "tha-ap402:14.4": "imā gāthā abhāsatha: // // ",
  "tha-ap402:15.1": "Yo me dīpaṃ padīpesi ",
  "tha-ap402:15.2": "pasanno sehi pānihi / ",
  "tha-ap402:15.3": "tam ahaṃ kittayissāmi: ",
  "tha-ap402:15.4": "suṇotha mama bhāsato: // // ",
  "tha-ap402:16.1": "Saṭṭhiṃ kappasahassāni ",
  "tha-ap402:16.2": "devaloke ramissati / ",
  "tha-ap402:16.3": "sahassakkhattuṃ rājā ca ",
  "tha-ap402:16.4": "cakkavattī bhavissati. // // ",
  "tha-ap402:17.1": "",
  "tha-ap402:18.1": "Chattiṃsakkhattuṃ devindo ",
  "tha-ap402:18.2": "devarajjaṃ karissati / ",
  "tha-ap402:18.3": "pathaviyaṃ sattasataṃ ",
  "tha-ap402:18.4": "vipulaṃ rajjaṃ karissati / ",
  "tha-ap402:19.1": "padesarajjaṃ vipulaṃ ",
  "tha-ap402:19.2": "gaṇanāto asaṅkhiyaṃ. // // ",
  "tha-ap402:19.3": "Iminā dīpadānena ",
  "tha-ap402:19.4": "dibbacakkhu bhavissati / ",
  "tha-ap402:20.1": "samantato aḍḍhakosaṃ ",
  "tha-ap402:20.2": "passissati ayaṃ sadā. // // ",
  "tha-ap402:20.3": "Devalokā cavantassa ",
  "tha-ap402:20.4": "nibbattantassa jantuno / ",
  "tha-ap402:21.1": "divā vā yadi vā rattiṃ ",
  "tha-ap402:21.2": "padīpaṃ dhārayissati / ",
  "tha-ap402:21.3": "jāyamānassa santassa ",
  "tha-ap402:21.4": "puññakammasamaṅgiṇo. // // ",
  "tha-ap402:22.1": "Yāvatā nagaram āsi ",
  "tha-ap402:22.2": "tāvatā jotayissati / ",
  "tha-ap402:22.3": "upapajjati yaṃ yoniṃ ",
  "tha-ap402:22.4": "devattam atha mānusaṃ. // // ",
  "tha-ap402:23.1": "Ass' eva dīpadānassa ",
  "tha-ap402:23.2": "aṭṭhadīpaphalena hi / ",
  "tha-ap402:23.3": "*na* jahissant' imaṃ jantuṃ ",
  "tha-ap402:23.4": "dīpadānass' idaṃ phalaṃ. // // ",
  "tha-ap402:24.1": "Kappasatasahassamhi ",
  "tha-ap402:24.2": "Okkākakulasambhavo / ",
  "tha-ap402:24.3": "Gotamo nāma nāmena ",
  "tha-ap402:24.4": "satthā loke bhavissati. // // ",
  "tha-ap402:25.1": "Tassa dhammesu dāyādo ",
  "tha-ap402:25.2": "oraso dhammanimmito / ",
  "tha-ap402:25.3": "sabbāsave pariññāya ",
  "tha-ap402:25.4": "nibbāyissat' anāsavo. // // ",
  "tha-ap402:26.1": "Tosayitvāna sambuddhaṃ ",
  "tha-ap402:26.2": "Gotamaṃ Sakyapuṅgavaṃ / ",
  "tha-ap402:26.3": "Ajito nāma nāmena ",
  "tha-ap402:26.4": "hessati satthu sāvako. // // ",
  "tha-ap402:27.1": "Saṭṭhiṃ kappasahassāni ",
  "tha-ap402:27.2": "devaloke ramim ahaṃ / ",
  "tha-ap402:27.3": "tatrāpi me dīpasataṃ ",
  "tha-ap402:27.4": "jotare niccakālikaṃ. // // ",
  "tha-ap402:28.1": "Devaloke manusse vā ",
  "tha-ap402:28.2": "niddhāvanti pabhā mama / ",
  "tha-ap402:28.3": "Buddhasetthaṃ saritvāna ",
  "tha-ap402:28.4": "bhiyyo bhāsaṃ janes' ahaṃ. // // ",
  "tha-ap402:29.1": "Tusitāhaṃ cavitvāna ",
  "tha-ap402:29.2": "okkamiṃ mātukucchiyā / ",
  "tha-ap402:29.3": "jāyamānassa santassa ",
  "tha-ap402:29.4": "āloko vipulo ahu. // // ",
  "tha-ap402:30.1": "Agārā abhinikkhamma ",
  "tha-ap402:30.2": "pabbajim anagāriyaṃ / ",
  "tha-ap402:30.3": "Bāvarim upasaṅkamma ",
  "tha-ap402:30.4": "sissattham ajjhupāgamiṃ. // // ",
  "tha-ap402:31.1": "Himavante vasanto 'haṃ ",
  "tha-ap402:31.2": "assosiṃ lokanāyakaṃ / ",
  "tha-ap402:31.3": "uttamatthaṃ gavesanto ",
  "tha-ap402:31.4": "upagacchiṃ vināyakaṃ. // // ",
  "tha-ap402:32.1": "Danto Buddho ca medhāvī ",
  "tha-ap402:32.2": "oghatiṇṇo nirūpadhī / ",
  "tha-ap402:32.3": "nibbānaṃ kathayi Buddho ",
  "tha-ap402:32.4": "sabbadukkhappamocanaṃ. // // ",
  "tha-ap402:33.1": "Tam me āgamanaṃ siddhaṃ ",
  "tha-ap402:33.2": "tosito 'haṃ mahāmuniṃ / ",
  "tha-ap402:33.3": "tisso vijjā anuppattā ",
  "tha-ap402:33.4": "kataṃ Buddhassa sāsanaṃ. // // ",
  "tha-ap402:34.1": "Satasahasse ito kappe ",
  "tha-ap402:34.2": "yaṃ dīpam adadiṃ tadā / ",
  "tha-ap402:34.3": "duggatiṃ nābhijānāmi ",
  "tha-ap402:34.4": "dīpadānass' idaṃ phalaṃ. // // ",
  "tha-ap402:35.1": "Kilesā . . . ",
  "tha-ap402:35.2": "pe . . . ",
  "tha-ap402:35.3": "",
  "tha-ap402:36.1": "",
  "tha-ap402:36.2": "pe . . . // // ",
  "tha-ap402:36.3": "Sāgataṃ . . . pe . . . pe . . . // // ",
  "tha-ap402:37.1": "Paṭisambhidā . . . ",
  "tha-ap402:37.2": "pe . . . ",
  "tha-ap402:37.3": "pe . . . // // ",
  "tha-ap402:38.1": "Itthaṃ sudam āyasmā Ajito thero i. g. a- ti. *Ajitattherassa ",
  "tha-ap402:39.1": "",
  "tha-ap402:39.2": "apadānaṃ samattaṃ.* ",
  "tha-ap402:40.1": "*Uddānaṃ:* ",
  "tha-ap402:41.1": "Pilindavaccho Selo ca ",
  "tha-ap402:41.2": "Sabbakittī Madhundado ",
  "tha-ap402:41.3": "Kūṭāgārī Ba*kulo ca ",
  "tha-ap402:41.4": "Giri*-Salaḷasavhayo. ",
  "tha-ap402:42.1": "Sabbado Ajito c' eva ",
  "tha-ap402:42.2": "gāthāyo gaṇitā-v-iha ",
  "tha-ap402:42.3": "satāni pañca gāthānaṃ ",
  "tha-ap402:42.4": "vīsati ca taduttarīti. ",
  "tha-ap402:43.1": "*Atha vagg' Uddānaṃ: ",
  "tha-ap402:44.1": "Padumārakkhado c' eva ",
  "tha-ap402:44.2": "Ummā Gandhodakena ca ",
  "tha-ap402:44.3": "Ekapaduma Saddasaññī ",
  "tha-ap402:44.4": "Mandhāraṃ Bodhivandako ",
  "tha-ap402:45.1": "Avaṇṭaṃ ca Pilindī ca ",
  "tha-ap402:45.2": "gāthāyo gaṇitāpi ca ",
  "tha-ap402:45.3": "catusattati gāthāyo ",
  "tha-ap402:45.4": "ekadasasatāni ca. ",
  "tha-ap402:46.1": "Catutthaṃ satakaṃ.* ",
  "tha-ap402:47.1": ""
}
