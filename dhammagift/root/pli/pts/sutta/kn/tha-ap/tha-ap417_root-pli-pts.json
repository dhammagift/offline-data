  "tha-ap417:1.1": "Nagare Bandhumatiyā ",
  "tha-ap417:1.2": "rājuyyāne vasām' ahaṃ / ",
  "tha-ap417:1.3": "mama assamasāmantā ",
  "tha-ap417:1.4": "nisīdi lokanāyako. // // ",
  "tha-ap417:2.1": "Nāgapallavam ādāya ",
  "tha-ap417:2.2": "Buddhassa abhiropayiṃ / ",
  "tha-ap417:2.3": "pasannacitto sumano ",
  "tha-ap417:2.4": "sugatam abhivādayiṃ. // // ",
  "tha-ap417:3.1": "Ekanavute ito kappe ",
  "tha-ap417:3.2": "yaṃ pallavam apūjayiṃ / ",
  "tha-ap417:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap417:3.4": "Buddhapūjāy' idaṃ phalaṃ. // // ",
  "tha-ap417:4.1": "Kilesā . . . ",
  "tha-ap417:4.2": "pe . . . ",
  "tha-ap417:4.3": "",
  "tha-ap417:5.1": "",
  "tha-ap417:5.2": "pe . . . // // ",
  "tha-ap417:5.3": "Sāgataṃ . . . pe . . . pe . . . // // ",
  "tha-ap417:6.1": "Paṭisambhidā . . . ",
  "tha-ap417:6.2": "pe . . . ",
  "tha-ap417:6.3": "pe . . . // // ",
  "tha-ap417:7.1": "Itthaṃ sudam āyasmā Nāgapallavako thero i. g. a-ti. Nāgapallavattherassa ",
  "tha-ap417:8.1": "apadānaṃ samattaṃ. Parinibbutamhi "
}
