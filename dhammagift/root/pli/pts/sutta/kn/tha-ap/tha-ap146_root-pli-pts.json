  "tha-ap146:0.2": "",
  "tha-ap146:0.3": "",
  "tha-ap146:1.1": "Padumuttaro nāma jino ",
  "tha-ap146:1.2": "lokajeṭṭho narāsabho / ",
  "tha-ap146:1.3": "jalitvā aggikkhandho va ",
  "tha-ap146:1.4": "sambuddho parinibbuto. // // ",
  "tha-ap146:2.1": "Nibbute ca mahāvīre ",
  "tha-ap146:2.2": "thūpo vitthāriko ahu / ",
  "tha-ap146:2.3": "thūpam rattaṃ upaṭṭhenti ",
  "tha-ap146:2.4": "dhātugehe varuttame. // // ",
  "tha-ap146:3.1": "Pasannacitto sumano ",
  "tha-ap146:3.2": "akaṃ kañcanavedikaṃ / ",
  "tha-ap146:3.3": "dīyati dhūmakkhandho ca ",
  "tha-ap146:3.4": "thupānucchavikaṃ tadā. // // ",
  "tha-ap146:4.1": "Bhave nibbattamānamhi ",
  "tha-ap146:4.2": "devatte atha mānuse / ",
  "tha-ap146:4.3": "omattam me na passāmi ",
  "tha-ap146:4.4": "pubbakammass' idam phalaṃ. // // ",
  "tha-ap146:5.1": "Pañcadase kappasate ",
  "tha-ap146:5.2": "ito aṭṭha janā ahuṃ / ",
  "tha-ap146:5.3": "sabbe Pamattanāmā te ",
  "tha-ap146:5.4": "cakkavattī mahābalā. // // ",
  "tha-ap146:6.1": "Paṭisambhidā . . . ",
  "tha-ap146:6.2": "pe . . . ",
  "tha-ap146:6.3": "pe . . . // // ",
  "tha-ap146:7.1": "Itthaṃ sudaṃ ā. Saparivāriyo thero i. g. a-ti. Saparivāriyattherassa ",
  "tha-ap146:8.1": "apadānaṃ samattaṃ. "
}
