  "tha-ap131:1.1": "Suvaṇṇavaṇṇo sambuddho ",
  "tha-ap131:1.2": "Vipassī dakkhiṇāraho / ",
  "tha-ap131:1.3": "purakkhato sāvakehi ",
  "tha-ap131:1.4": "ārāmā abhinikkhamī. // // ",
  "tha-ap131:2.1": "Disvān' ahaṃ Buddhaseṭṭhaṃ ",
  "tha-ap131:2.2": "sabbaññūtam-anāsavaṃ / ",
  "tha-ap131:2.3": "pasannacitto sumano ",
  "tha-ap131:2.4": "gaṇṭhipupphaṃ apūjayiṃ. // // ",
  "tha-ap131:3.1": "Tena cittappasādena ",
  "tha-ap131:3.2": "dipadindassa tādino / ",
  "tha-ap131:3.3": "haṭṭho haṭṭhena cittena ",
  "tha-ap131:3.4": "puna vandiṃ *Tathāgataṃ. // // ",
  "tha-ap131:4.1": "Eka*navute ito kappe ",
  "tha-ap131:4.2": "yaṃ puppham abhiropayiṃ / ",
  "tha-ap131:4.3": "duggatiṃ nābhijānāmi ",
  "tha-ap131:4.4": "Buddhapūjāy' idaṃ phalaṃ. // // ",
  "tha-ap131:5.1": "Ekatālīs' ito kappe ",
  "tha-ap131:5.2": "Varaṇo nama khattiyo / ",
  "tha-ap131:5.3": "sattaratanasampanno ",
  "tha-ap131:5.4": "cakkavattī mahābalo. // // ",
  "tha-ap131:6.1": "Paṭisambhidā . . . ",
  "tha-ap131:6.2": "pe . . . ",
  "tha-ap131:6.3": "pe . . . // // ",
  "tha-ap131:7.1": "Itthaṃ sudaṃ āyasmā Gaṇṭhipupphiyo thero imā gāthāyo abhāsitthā ti. Gaṇṭhipupphiyattherassa ",
  "tha-ap131:8.1": "apadānaṃ samattaṃ. Himavantass' avidūre "
}
