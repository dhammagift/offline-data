  "tha-ap90:1.1": "Pabbate Himavantamhi ",
  "tha-ap90:1.2": "vasāmi paṇṇasanthare / ",
  "tha-ap90:1.3": "Phussassa dhammaṃ bhaṇato ",
  "tha-ap90:1.4": "sadde cittaṃ pasādayiṃ. // // ",
  "tha-ap90:2.1": "Dvenavute ito kappe ",
  "tha-ap90:2.2": "yaṃ kammam akariṃ tadā / ",
  "tha-ap90:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap90:2.4": "puññakammass' idaṃ phalaṃ. // // ",
  "tha-ap90:3.1": "Paṭisambhidā catasso ",
  "tha-ap90:3.2": "vimokhā pi ca aṭṭh' ime / chaḍabhiññā sacchikatā ",
  "tha-ap90:3.3": "kataṃ Buddhassa sāsanan ti. // // ",
  "tha-ap90:4.1": "Itthaṃ sudaṃ āyasmā Saddasaññakothero imā gāthāyo abhāsitthā ti. Saddasaññakattherassa apadānaṃ samattaṃ. ",
  "tha-ap90:5.1": ""
}
