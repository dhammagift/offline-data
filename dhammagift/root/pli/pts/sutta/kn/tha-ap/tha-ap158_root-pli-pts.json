  "tha-ap158:0.3": "",
  "tha-ap158:1.1": "",
  "tha-ap158:1.2": "Kukkuṭo nāma pabbato / ",
  "tha-ap158:1.3": "tamhi pabbatapādamhi ",
  "tha-ap158:1.4": "satta Buddhā vasantike. // // ",
  "tha-ap158:2.1": "Kadambaṃ pupphitaṃ disvā ",
  "tha-ap158:2.2": "dīparājaṃ va uggataṃ / ",
  "tha-ap158:2.3": "ubho hatthehi paggayha ",
  "tha-ap158:2.4": "satta Buddhe samokiriṃ. // // ",
  "tha-ap158:3.1": "Catunavute ito kappe ",
  "tha-ap158:3.2": "yaṃ puppham abhipūjayiṃ / ",
  "tha-ap158:3.3": "duggatiṃ nabhijānāmi ",
  "tha-ap158:3.4": "Buddhapūjāy' idaṃ phalaṃ. // // ",
  "tha-ap158:4.1": "Dvenavute ito kappe ",
  "tha-ap158:4.2": "sattāhuṃ Phullanāyakā / ",
  "tha-ap158:4.3": "sattaratanasampannā ",
  "tha-ap158:4.4": "cakkavattī mahabbalā // // ",
  "tha-ap158:5.1": "Paṭisambhidā . . . ",
  "tha-ap158:5.2": "pe . . . ",
  "tha-ap158:5.3": "pe . . . // // ",
  "tha-ap158:6.1": "Itthaṃ sudaṃ ā. Kadambapupphiyo thero i. g. ā-ti. Kadambapupphiyattherassa apadānaṃ samattaṃ. Himavantass' avidūre ",
  "tha-ap158:7.1": ""
}
