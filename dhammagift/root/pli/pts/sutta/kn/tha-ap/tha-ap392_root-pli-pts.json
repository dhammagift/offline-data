  "tha-ap392:0.1": "",
  "tha-ap392:0.2": "",
  "tha-ap392:0.3": "",
  "tha-ap392:1.1": "Anota*ttasarāsanne ",
  "tha-ap392:1.2": "ramaṇīye silā*tale / ",
  "tha-ap392:1.3": "nānāratanapajjote ",
  "tha-ap392:1.4": "nānāgandhavanantare // // ",
  "tha-ap392:2.1": "Mahatā bhikkhusaṅghena ",
  "tha-ap392:2.2": "pareto lokanāyako / ",
  "tha-ap392:2.3": "āsīno vyākari tattha ",
  "tha-ap392:2.4": "pubbakammāni attano: // // ",
  "tha-ap392:3.1": "‘Suṇotha bhikkhavo mayham ",
  "tha-ap392:3.2": "yaṃ kammaṃ pakatam mayā / ",
  "tha-ap392:3.3": "*pilotiyassa kammassa ",
  "tha-ap392:3.4": "buddhatthe* pi vipaccati. // // ",
  "tha-ap392:4.0": "",
  "tha-ap392:4.1": "Munāli nām' ahaṃ dhutto ",
  "tha-ap392:4.2": "pubbe aññāsu jātisu / ",
  "tha-ap392:4.3": "paccekabuddhaṃ Surabhim ",
  "tha-ap392:4.4": "abbhācikkhim adūsakaṃ. // // ",
  "tha-ap392:5.1": "Tena kammavipākena ",
  "tha-ap392:5.2": "niraye saṃsariṃ ciraṃ / ",
  "tha-ap392:5.3": "bahū vassasahassāni ",
  "tha-ap392:5.4": "dukkhaṃ vedesiṃ vedanaṃ. // // ",
  "tha-ap392:6.1": "Tena kammāvasesena ",
  "tha-ap392:6.2": "idha pa*cchimake bhave / ",
  "tha-ap392:6.3": "abbhakkhā*naṃ mayā laddhaṃ ",
  "tha-ap392:6.4": "Sundarīkāya kāraṇā. // // ",
  "tha-ap392:7.0": "",
  "tha-ap392:7.1": "Sabbābhibhussa Buddhassa ",
  "tha-ap392:7.2": "Nando nām' āsi sāvako / ",
  "tha-ap392:7.3": "tam abbhakkhāya niraye ",
  "tha-ap392:7.4": "ciraṃ saṃsaritam mayā. // // ",
  "tha-ap392:8.1": "Dasavassasahassāni ",
  "tha-ap392:8.2": "niraye saṃsariṃ ciraṃ / ",
  "tha-ap392:8.3": "manussabhāvaṃ laddhāham ",
  "tha-ap392:8.4": "abbhakkhānaṃ bahuṃ labhiṃ. // // ",
  "tha-ap392:9.1": "Tena kammā*vasesena ",
  "tha-ap392:9.2": "Ciñca* mānavikā mamaṃ / ",
  "tha-ap392:9.3": "abbhakkhāsi abhūtena ",
  "tha-ap392:9.4": "janakāyassa aggato. // // ",
  "tha-ap392:10.0": "",
  "tha-ap392:10.1": "Brāhmaṇo sutavā āsim ",
  "tha-ap392:10.2": "ahaṃ sakkatapūjito / ",
  "tha-ap392:10.3": "mahāvane pañcasate ",
  "tha-ap392:10.4": "*mante* vācemi māṇave. // // ",
  "tha-ap392:11.1": "Tatthāgato ",
  "tha-ap392:11.2": "Isigaṇo pañcābhiññāmahi*ddhiko* / ",
  "tha-ap392:11.3": "tañ cāham ā*gataṃ disvā ",
  "tha-ap392:11.4": "abbhācikkhim adūsakaṃ. // // ",
  "tha-ap392:12.1": "Tato 'ham avacaṃ sisse: ",
  "tha-ap392:12.2": "kāmabhogī ayaṃ isi / ",
  "tha-ap392:12.3": "mayhaṃ vibhāsamānassa ",
  "tha-ap392:12.4": "anumodiṃsu māṇavā. // // ",
  "tha-ap392:13.1": "Tato māṇavakā sabbe ",
  "tha-ap392:13.2": "bhikkhamānā kulākule / ",
  "tha-ap392:13.3": "mahājanassa ahaṃsu: ",
  "tha-ap392:13.4": "*kāma*bhogī ayaṃ isi. // // ",
  "tha-ap392:14.1": "Tena kammavipākena ",
  "tha-ap392:14.2": "pañcabhikkhusatā ime / ",
  "tha-ap392:14.3": "abbhakkhānaṃ labhuṃ sabbe ",
  "tha-ap392:14.4": "Sundarīkāya kāraṇā. // // ",
  "tha-ap392:15.0": "",
  "tha-ap392:15.1": "Dvemātā-bhātaro pubbe ",
  "tha-ap392:15.2": "dhanahetu haniṃ ahaṃ / ",
  "tha-ap392:15.3": "pakkhipiṃ giriduggesu ",
  "tha-ap392:15.4": "silāya ca apiṃsayiṃ. // // ",
  "tha-ap392:16.1": "Tena kammavipākena ",
  "tha-ap392:16.2": "Devadatto silaṃ khipi / ",
  "tha-ap392:16.3": "aṅguṭṭhaṃ piṃsayī pāde ",
  "tha-ap392:16.4": "mama pāsānasakkharā. // // ",
  "tha-ap392:17.0": "",
  "tha-ap392:17.1": "Pure 'haṃ dārako hutvā ",
  "tha-ap392:17.2": "kīḷamāno mahāpathe / ",
  "tha-ap392:17.3": "paccekabuddhaṃ disvāna ",
  "tha-ap392:17.4": "magge sakalikaṃ dahiṃ. // // ",
  "tha-ap392:18.1": "Tena kammavipākena ",
  "tha-ap392:18.2": "idha pacchimake bhave / ",
  "tha-ap392:18.3": "vadhatthaṃ maṃ Devadatto ",
  "tha-ap392:18.4": "abhimāre payojayi. // // ",
  "tha-ap392:19.0": "",
  "tha-ap392:19.1": "Hatthāroho pure āsiṃ ",
  "tha-ap392:19.2": "paccekamunim uttamaṃ / ",
  "tha-ap392:19.3": "piṇḍāya vicarantaṃ *tam* ",
  "tha-ap392:19.4": "āsādesiṃ gajen' ahaṃ. // // ",
  "tha-ap392:20.1": "Tena kammavipākena ",
  "tha-ap392:20.2": "bhanto Nāḷāgirī gajo / ",
  "tha-ap392:20.3": "Giribbaje puravare ",
  "tha-ap392:20.4": "dāruṇo mam upāgamī. // // ",
  "tha-ap392:21.0": "",
  "tha-ap392:21.1": "Rājāhaṃ patthivo āsiṃ ",
  "tha-ap392:21.2": "sattiyā purisaṃ haniṃ / ",
  "tha-ap392:21.3": "tena kammavipākena ",
  "tha-ap392:21.4": "niraye paccasiṃ bhusaṃ. // // ",
  "tha-ap392:22.1": "Kammuṇo tassa sesena ",
  "tha-ap392:22.2": "c'ādiṇṇaṃ sakalaṃ mama / ",
  "tha-ap392:22.3": "pāde chaviṃ pakopesi ",
  "tha-ap392:22.4": "na hi kammaṃ panassati. // // ",
  "tha-ap392:23.0": "",
  "tha-ap392:23.1": "Ahaṃ kevaṭṭagāmasmim ",
  "tha-ap392:23.2": "ahuṃ kevaṭṭadārako / ",
  "tha-ap392:23.3": "macchake ghātite disvā ",
  "tha-ap392:23.4": "janayiṃ somanassakaṃ. // // ",
  "tha-ap392:24.1": "Tena kammavipākena ",
  "tha-ap392:24.2": "sīsadukkham ahu mama / ",
  "tha-ap392:24.3": "Sakkesu haññamānesu ",
  "tha-ap392:24.4": "yadā hani Viḍuḍabho. // // ",
  "tha-ap392:25.0": "",
  "tha-ap392:25.1": "Phussassāhaṃ pāvacane ",
  "tha-ap392:25.2": "sāvake paribhāsayiṃ / ",
  "tha-ap392:25.3": "yavaṃ khādatha bhuñjatha ",
  "tha-ap392:25.4": "mā ca bhuñjatha sāliyo. // // ",
  "tha-ap392:26.1": "Tena kammavipākena ",
  "tha-ap392:26.2": "temāsaṃ khāditaṃ yavaṃ / ",
  "tha-ap392:26.3": "nimantito brāhmaṇena ",
  "tha-ap392:26.4": "verajjāyaṃ vasiṃ tadā. // // ",
  "tha-ap392:27.0": "",
  "tha-ap392:27.1": "Nibbuddhe vattamānamhi ",
  "tha-ap392:27.2": "Mallaputtaṃ nisedhayiṃ / ",
  "tha-ap392:27.3": "tena kammavipākena ",
  "tha-ap392:27.4": "piṭṭhidukkham ahu mama. // // ",
  "tha-ap392:28.0": "",
  "tha-ap392:28.1": "Tikicchako aham āsiṃ ",
  "tha-ap392:28.2": "seṭṭhiputtaṃ virecayiṃ / ",
  "tha-ap392:28.3": "tena kammavipākena ",
  "tha-ap392:28.4": "hoti pakkhandikā mama. // // ",
  "tha-ap392:29.0": "",
  "tha-ap392:29.1": "Avacāhaṃ Jotipālo ",
  "tha-ap392:29.2": "sugataṃ Kassapaṃ tadā: / ",
  "tha-ap392:29.3": "kuto nu bodhi muṇḍassa ",
  "tha-ap392:29.4": "bodhi paramadullabhā? // // ",
  "tha-ap392:30.1": "Tena kammavipākena ",
  "tha-ap392:30.2": "ācariṃ dukkaraṃ bahuṃ / ",
  "tha-ap392:30.3": "chabbassān' Uruvelāyaṃ ",
  "tha-ap392:30.4": "tato bodhim apāpuṇiṃ. // // ",
  "tha-ap392:31.1": "Nāhaṃ etena maggena ",
  "tha-ap392:31.2": "pāpuṇiṃ bodhim uttamaṃ / ",
  "tha-ap392:31.3": "kummaggena gavesissaṃ ",
  "tha-ap392:31.4": "pubbakammena kārito. // // ",
  "tha-ap392:32.1": "Puññapāpaparikhīṇo ",
  "tha-ap392:32.2": "sabbasantāpavajjito / ",
  "tha-ap392:32.3": "asoko anupāyāso ",
  "tha-ap392:32.4": "nibbāyissam anāsavo.' // // ",
  "tha-ap392:33.1": "Evaṃ jino viyākāsi ",
  "tha-ap392:33.2": "bhikkhusaṅghassa aggato // // ",
  "tha-ap392:33.3": "sabbābhiññābalappatto ",
  "tha-ap392:33.4": "Anotatte mahāsare ti. ",
  "tha-ap392:34.1": "Itthaṃ sudaṃ bhagavā attano pubbacaritaṃ Pubbakammapiloti nāma Buddhāpadānaṃ dhammapari- yāyam abhāsi. Pubbakammapiloti nāma ",
  "tha-ap392:35.1": "",
  "tha-ap392:36.1": "Buddhāpadānaṃ samattaṃ. ",
  "tha-ap392:37.1": "Uddānaṃ: ",
  "tha-ap392:38.1": "Avaṇṭaṃ Labujañ c' eva ",
  "tha-ap392:38.2": "Udumbara Pilakkhu ca ",
  "tha-ap392:38.3": "Phāru-Vallī ca Kadalī ",
  "tha-ap392:38.4": "Panasa-Koṭivīsako. ",
  "tha-ap392:39.1": "Pubbakammapiloti ca ",
  "tha-ap392:39.2": "apadānaṃ mahesino ",
  "tha-ap392:39.3": "gāthāyo ekanavuti ",
  "tha-ap392:39.4": "gaṇitāyo vibhāvihī. ",
  "tha-ap392:40.1": ""
}
