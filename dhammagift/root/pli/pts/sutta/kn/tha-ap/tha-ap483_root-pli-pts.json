  "tha-ap483:1.1": "Tisso nāmāsi bhagavā ",
  "tha-ap483:1.2": "syambhū aggapuggalo / ",
  "tha-ap483:1.3": "paṃsukūlaṃ ṭhapetvāna ",
  "tha-ap483:1.4": "vihāraṃ pāvisī jino. // // ",
  "tha-ap483:2.1": "Tiyantaṃ dhanuṃ ādāya ",
  "tha-ap483:2.2": "akkhitto yamaliṃ ahaṃ / ",
  "tha-ap483:2.3": "maṇḍalaggaṃ gahetvāna ",
  "tha-ap483:2.4": "kānanaṃ pāvisiṃ ahaṃ. // // ",
  "tha-ap483:3.1": "Tatth' addasaṃ paṃsukūlaṃ ",
  "tha-ap483:3.2": "dumagge laggitaṃ tadā / ",
  "tha-ap483:3.3": "cāpaṃ tatth' eva nikkhippa ",
  "tha-ap483:3.4": "sire katvāna añjaliṃ. // // ",
  "tha-ap483:4.1": "Pasannacitto sumano ",
  "tha-ap483:4.2": "vipulāya ca pītiyā / ",
  "tha-ap483:4.3": "Buddhaseṭṭhaṃ saritvāna ",
  "tha-ap483:4.4": "paṃsukūlaṃ avandi ",
  "tha-ap483:5.1": "'haṃ / ",
  "tha-ap483:5.2": "",
  "tha-ap483:5.3": "duggatiṃ nābhijānāmi ",
  "tha-ap483:5.4": "vandanāya idaṃ phalaṃ. // // ",
  "tha-ap483:6.1": "Kilesā . . . pe . . . ",
  "tha-ap483:6.2": "pe . . . ",
  "tha-ap483:6.3": "pe . . . // // ",
  "tha-ap483:6.4": "Sāgataṃ . . . ",
  "tha-ap483:7.1": "pe . . . ",
  "tha-ap483:7.2": "pe . . . ",
  "tha-ap483:7.3": "pe . . . // // ",
  "tha-ap483:7.4": "",
  "tha-ap483:8.1": "Paṭisambhidā . . . pe . . . ",
  "tha-ap483:8.2": "pe . . . ",
  "tha-ap483:8.3": "",
  "tha-ap483:8.4": "pe . . . // // ",
  "tha-ap483:9.1": "Itthaṃ sudaṃ āyasmā Paṃsukūlasaññako th. i. g. a-ti. Paṃsukūlasaññakattherassa ",
  "tha-ap483:10.1": "apadānaṃ samattaṃ. "
}
