  "tha-ap222:1.1": "Piyadassissa bhagavato ",
  "tha-ap222:1.2": "caṅkamaṃ sodhitaṃ mayā / ",
  "tha-ap222:1.3": "nalakehi paṭicchannaṃ ",
  "tha-ap222:1.4": "vātātapanivāraṇaṃ. // // ",
  "tha-ap222:2.1": "Pāpaṃ vivajjanatthāya ",
  "tha-ap222:2.2": "kusalassūpasampadā / ",
  "tha-ap222:2.3": "kilesānaṃ pahānāya ",
  "tha-ap222:2.4": "padahiṃ satthu sāsane. // // ",
  "tha-ap222:3.1": "Ito ekādase kappe ",
  "tha-ap222:3.2": "Aggidevo ti vissuto / ",
  "tha-ap222:3.3": "sattaratanasampanno ",
  "tha-ap222:3.4": "cakkavattī mahabbalo. // // ",
  "tha-ap222:4.1": "Paṭisambhidā . . . ",
  "tha-ap222:4.2": "pe . . . ",
  "tha-ap222:4.3": "pe . . . // // ",
  "tha-ap222:5.1": "Itthaṃ sudam āyasmā Pāpanivāriyo thero i. g. a- ",
  "tha-ap222:6.1": "ti. Pāpanivāriyattherassa ",
  "tha-ap222:7.1": "apadānaṃ samattaṃ. ",
  "tha-ap222:8.1": "Uddānaṃ: ",
  "tha-ap222:9.1": "Hatthi-Pānadhi-Saccañ ca ",
  "tha-ap222:9.2": "Ekasaññi ca Raṃsiyo Saṇṭhito ",
  "tha-ap222:9.3": "Tālavaṇṭī ca ",
  "tha-ap222:9.4": "tathā Akkantasaññako ",
  "tha-ap222:9.5": "Sappi Pāpanivārī ca ",
  "tha-ap222:9.6": "catupaññāsa gāthakā. Atthadassi- "
}
