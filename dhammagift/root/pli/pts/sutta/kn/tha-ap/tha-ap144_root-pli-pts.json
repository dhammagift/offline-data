  "tha-ap144:1.1": "Nibbute lokanāthamhi ",
  "tha-ap144:1.2": "Dhammadassi-narāsabhe / ",
  "tha-ap144:1.3": "āropesiṃ dhajatthambhaṃ ",
  "tha-ap144:1.4": "Buddhaseṭṭhassa cetiye. // // ",
  "tha-ap144:2.1": "Nisseṇiṃ māpayitvāna ",
  "tha-ap144:2.2": "thūpaseṭṭhaṃ samāruhiṃ / ",
  "tha-ap144:2.3": "jātipupphaṃ gahetvāna ",
  "tha-ap144:2.4": "thambhambhi abhiropayiṃ. // // ",
  "tha-ap144:3.1": "Aho Buddhā! aho dhammā! ",
  "tha-ap144:3.2": "aho no satthu sampadā! / ",
  "tha-ap144:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap144:3.4": "thūpapūjāy' idaṃ phalaṃ. // // ",
  "tha-ap144:4.1": "Catunavute ito kappe ",
  "tha-ap144:4.2": "Thūpasikhasanāmakā / ",
  "tha-ap144:4.3": "soḷas' āsiṃsu rājāno ",
  "tha-ap144:4.4": "cakkavattī mahābalā. // // ",
  "tha-ap144:5.1": "Paṭisambhidā . . . ",
  "tha-ap144:5.2": "pe . . . ",
  "tha-ap144:5.3": "pe . . . // // ",
  "tha-ap144:6.1": "Itthaṃ sudaṃ ā. thambhāropako thero i. g. a-ti. Thambhāropakattherassa ",
  "tha-ap144:7.1": "apadānaṃ samattaṃ. "
}
