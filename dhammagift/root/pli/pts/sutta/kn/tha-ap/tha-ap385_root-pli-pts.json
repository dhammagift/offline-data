  "tha-ap385:1.1": "Vinatānadiyā tīre ",
  "tha-ap385:1.2": "vihāsi purisuttamo / ",
  "tha-ap385:1.3": "addasaṃ virajaṃ Buddham ",
  "tha-ap385:1.4": "ekaggaṃ susamāhitaṃ // // ",
  "tha-ap385:2.1": "Tasmiṃ pasannamānaso ",
  "tha-ap385:2.2": "kilesamaladhovane / ",
  "tha-ap385:2.3": "udumbaraṃ phalaṃ gayha ",
  "tha-ap385:2.4": "Buddhaseṭṭhass' adās' ahaṃ. // // ",
  "tha-ap385:3.1": "Ekanavut' ito kappe ",
  "tha-ap385:3.2": "yaṃ phalam adadiṃ tadā / ",
  "tha-ap385:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap385:3.4": "phaladānass' idaṃ phalaṃ. // // ",
  "tha-ap385:4.1": "Sāgataṃ . . . pe . . . pe . . . // // Kilesā . . . ",
  "tha-ap385:4.2": "pe . . . ",
  "tha-ap385:4.3": "",
  "tha-ap385:5.1": "",
  "tha-ap385:5.2": "pe . . . // // ",
  "tha-ap385:5.3": "",
  "tha-ap385:6.1": "Paṭisambhidā . . . ",
  "tha-ap385:6.2": "pe . . . ",
  "tha-ap385:6.3": "pe . . . // // ",
  "tha-ap385:7.1": "Itthaṃ sudam āyasmā Udumbaraphaladāyako th. i. g. a-ti. Udumbaraphaladāyakattherassa ",
  "tha-ap385:8.1": "apadānaṃ samattaṃ. Vanante "
}
