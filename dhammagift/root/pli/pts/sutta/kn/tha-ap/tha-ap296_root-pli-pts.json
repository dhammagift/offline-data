  "tha-ap296:1.1": "Anuggatamhi ādicce ",
  "tha-ap296:1.2": "pasādo vipulo ahū / ",
  "tha-ap296:1.3": "Buddhaseṭṭhassa lokamhi ",
  "tha-ap296:1.4": "pātubhāvo mahesino. // // ",
  "tha-ap296:2.1": "Saddam assos' ahaṃ tattha ",
  "tha-ap296:2.2": "na ca passāmi taṃ jinaṃ / ",
  "tha-ap296:2.3": "maraṇañ ca anuppatto ",
  "tha-ap296:2.4": "Buddhasaññam anussariṃ. // // Catunavute ",
  "tha-ap296:3.1": "ito kappe ",
  "tha-ap296:3.2": "yaṃ saññam alabhiṃ tadā / ",
  "tha-ap296:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap296:3.4": "Buddhapūjāy' idaṃ phalaṃ. // // ",
  "tha-ap296:4.1": "Paṭisambhidā . . . ",
  "tha-ap296:4.2": "pe . . . ",
  "tha-ap296:4.3": "pe . . . // // ",
  "tha-ap296:5.1": "Itthaṃ sudam āyasmā Saddasaññako thero i. g. a-ti. Saddasaññakattherassa ",
  "tha-ap296:6.1": "apadānaṃ samattaṃ. "
}
