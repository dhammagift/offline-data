  "tha-ap28:0.1": "",
  "tha-ap28:0.2": "",
  "tha-ap28:0.3": "",
  "tha-ap28:1.1": "Siddhatthassa bhagavato ",
  "tha-ap28:1.2": "lokajeṭṭhassa tādino / ",
  "tha-ap28:1.3": "kuṭidhūpaṃ mayā dinnaṃ ",
  "tha-ap28:1.4": "vippasannena cetasā. // // ",
  "tha-ap28:2.1": "Yaṃ yaṃ yonupapajjāmi ",
  "tha-ap28:2.2": "devattaṃ atha mānusaṃ / ",
  "tha-ap28:2.3": "sabbesam pi piyo homi ",
  "tha-ap28:2.4": "dhūpadānass' idaṃ phalaṃ. // // ",
  "tha-ap28:3.1": "Catunavut' ito kappe ",
  "tha-ap28:3.2": "yaṃ dhūpam adadiṃ tadā / ",
  "tha-ap28:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap28:3.4": "dhūpadānass' idaṃ phalaṃ. // // ",
  "tha-ap28:4.1": "Paṭisambhidā catasso ",
  "tha-ap28:4.2": "vimokhā pi ca aṭṭh' ime / ",
  "tha-ap28:4.3": "chaḍabhiññā sacchikatā ",
  "tha-ap28:4.4": "kataṃ Buddhassa sāsanan ti. // // ",
  "tha-ap28:5.1": "Itthaṃ sudaṃ āyasmā Dhūpadāyako thero imā gāthāyo abhāsitthā ti. Dhūpadāyakatherassa apadānaṃ samattaṃ. ",
  "tha-ap28:6.1": ""
}
