  "tha-ap525:1.1": "Āruhimha tadā nāvaṃ ",
  "tha-ap525:1.2": "bhikkhu ca 'jīvako c' ahaṃ / ",
  "tha-ap525:1.3": "nāvāya bhijjamānāya ",
  "tha-ap525:1.4": "bhikkhu me saraṇaṃ adā. // // ",
  "tha-ap525:2.1": "Ekatiṃse ito kappe ",
  "tha-ap525:2.2": "yaṃ so me saraṇaṃ adā / ",
  "tha-ap525:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap525:2.4": "saraṇāgamane phalaṃ. // // ",
  "tha-ap525:3.1": "Kilesā . . . ",
  "tha-ap525:3.2": "pe . . . ",
  "tha-ap525:3.3": "",
  "tha-ap525:4.1": "",
  "tha-ap525:4.2": "pe . . . ",
  "tha-ap525:4.3": "pe . . . // // Sāgataṃ . . . pe . . . pe . . . pe . . . // // ",
  "tha-ap525:5.1": "Paṭisambhidā . . . ",
  "tha-ap525:5.2": "pe . . . ",
  "tha-ap525:5.3": "pe . . . pe . . . // // ",
  "tha-ap525:6.1": "Itthaṃ sudaṃ āyasmā Saraṇāgamaniyo thero i. g. a-ti. Saraṇāgamaniyattherassa apadānaṃ samattaṃ. ",
  "tha-ap525:7.1": ""
}
