  "tha-ap446:8.1": "",
  "tha-ap446:8.2": "pe . . . ",
  "tha-ap446:8.3": "pe . . . // // Sāgataṃ . . . pe . . . pe . . . pe . . . // // ",
  "tha-ap446:9.1": "Paṭisambhidā . . . ",
