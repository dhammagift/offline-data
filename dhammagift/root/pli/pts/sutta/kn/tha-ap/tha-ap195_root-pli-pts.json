  "tha-ap195:0.3": "",
  "tha-ap195:1.1": "Phussassa kho bhagavato ",
  "tha-ap195:1.2": "thūpo āsi mahāvane / ",
  "tha-ap195:1.3": "kuñjarehi tadā bhinno ",
  "tha-ap195:1.4": "saṃrūḷho pādapo tahiṃ. // // ",
  "tha-ap195:2.1": "Visamañ ca samaṃ katvā ",
  "tha-ap195:2.2": "sudhāpiṇḍaṃ adās' ahaṃ / ",
  "tha-ap195:2.3": "tilokagaruno tassa ",
  "tha-ap195:2.4": "guṇehi paritosito. // // ",
  "tha-ap195:3.1": "Dvenavute ito kappe ",
  "tha-ap195:3.2": "yaṃ kammaṃ akariṃ tadā / ",
  "tha-ap195:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap195:3.4": "sudhāpiṇḍass' idaṃ phalaṃ. // // ",
  "tha-ap195:4.1": "Sattasattatikappamhi ",
  "tha-ap195:4.2": "Jitasen' āsuṃ solasa / ",
  "tha-ap195:4.3": "sattaratanasampannā ",
  "tha-ap195:4.4": "cakkavattī mahabbalā. // // ",
  "tha-ap195:5.1": "Paṭisambhidā . . . ",
  "tha-ap195:5.2": "pe . . . ",
  "tha-ap195:5.3": "pe . . . // // ",
  "tha-ap195:6.1": "Itthaṃ sudaṃ āyasmā Khaṇḍaphulliyo thero i. g. a-ti. Khaṇḍaphulliyattherassa ",
  "tha-ap195:7.1": "apadānaṃ samattaṃ. "
}
