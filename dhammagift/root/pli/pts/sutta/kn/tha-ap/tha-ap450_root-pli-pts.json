  "tha-ap450:1.1": "Sumedho nāma sambuddho ",
  "tha-ap450:1.2": "aggo kāruṇiko muni / ",
  "tha-ap450:1.3": "tārayitvā bahū satte ",
  "tha-ap450:1.4": "nibbuto so mahāyaso. // // ",
  "tha-ap450:2.1": "Sīhāsanassa *sā*mantā ",
  "tha-ap450:2.2": "Sumedhassa mahesino / ",
  "tha-ap450:2.3": "pasannacitto sumano ",
  "tha-ap450:2.4": "pādapīṭham akārayiṃ. // // ",
  "tha-ap450:3.1": "Katvāna kusalaṃ kammaṃ ",
  "tha-ap450:3.2": "sukhapākaṃ sukhindriyaṃ / ",
  "tha-ap450:3.3": "puññakammena *sam*yutto ",
  "tha-ap450:3.4": "Tāvatiṃsaṃ agacch' ahaṃ. // // ",
  "tha-ap450:4.1": "Tattha me vasamānassa ",
  "tha-ap450:4.2": "puññakammaṃ samaṅgino / ",
  "tha-ap450:4.3": "pādāni uddharantassa ",
  "tha-ap450:4.4": "soṇṇapīṭhā bhavanti me. // // ",
  "tha-ap450:5.1": "Lābhā tesaṃ suladdhaṃ te ",
  "tha-ap450:5.2": "ye labhanti upassutiṃ / ",
  "tha-ap450:5.3": "nibbute kāraṃ katvāna ",
  "tha-ap450:5.4": "labhanti vipulaṃ sukhaṃ. // // ",
  "tha-ap450:6.1": "Mayāpi sukataṃ kammaṃ ",
  "tha-ap450:6.2": "vānijjaṃ suppayojitaṃ / ",
  "tha-ap450:6.3": "pādapīṭhaṃ karitvāna ",
  "tha-ap450:6.4": "soṇṇapīṭhaṃ labhām' ahaṃ. // // ",
  "tha-ap450:7.1": "Yaṃ yaṃ disaṃ pakkamāmi ",
  "tha-ap450:7.2": "kenaci paccayen' ahaṃ / ",
  "tha-ap450:7.3": "soṇṇapīṭhe akkamāmi ",
  "tha-ap450:7.4": "puññakammass' idaṃ phalaṃ. // // ",
  "tha-ap450:8.1": "Tiṃsakappasahassamhi ",
  "tha-ap450:8.2": "yaṃ kammam akariṃ tadā / ",
  "tha-ap450:8.3": "duggatiṃ nābhijānāmi ",
  "tha-ap450:8.4": "pādapīṭhass' idaṃ phalaṃ. // // ",
  "tha-ap450:9.1": "Kilesā . . . ",
  "tha-ap450:9.2": "pe . . . ",
  "tha-ap450:9.3": "",
  "tha-ap450:10.1": "",
  "tha-ap450:10.2": "pe . . . ",
  "tha-ap450:10.3": "pe . . . // // Sāgataṃ . . . pe . . . pe . . . pe . . . // // ",
  "tha-ap450:11.1": "Paṭisambhidā . . . ",
  "tha-ap450:11.2": "pe . . . ",
  "tha-ap450:11.3": "pe . . . pe . . . // // ",
  "tha-ap450:12.1": "Itthaṃ sudam āyasmā Pādapīṭhiyo thero i. g. a-ti. Pādapīṭhiyattherassa apadānaṃ samattaṃ. Padumuttarabuddhassa ",
  "tha-ap450:13.1": ""
}
