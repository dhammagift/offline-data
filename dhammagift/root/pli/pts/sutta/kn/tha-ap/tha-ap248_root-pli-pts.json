  "tha-ap248:1.1": "Paramena damathena ",
  "tha-ap248:1.2": "Siddhatthassa mahesino / ",
  "tha-ap248:1.3": "pattadānaṃ mayā dinnaṃ ",
  "tha-ap248:1.4": "ujubhūtassa tādino. // // ",
  "tha-ap248:2.1": "Catunavute ito kappe ",
  "tha-ap248:2.2": "yaṃ dānam adadiṃ tadā / ",
  "tha-ap248:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap248:2.4": "pattadānass' idaṃ phalaṃ. // // ",
  "tha-ap248:3.1": "Paṭisambhidā . . . ",
  "tha-ap248:3.2": "pe . . . ",
  "tha-ap248:3.3": "pe . . . // // ",
  "tha-ap248:4.1": "Itthaṃ sudam āyasmā Pattadāyako thero i. g. a-ti. Pattadāyakattherassa ",
  "tha-ap248:5.1": "apadānaṃ samattaṃ. "
}
