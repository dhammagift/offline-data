  "tha-ap74:0.3": "",
  "tha-ap74:1.1": "padaṃ disvā ",
  "tha-ap74:1.2": "Tissassādiccabandhuno / ",
  "tha-ap74:1.3": "haṭṭho haṭṭhena cittena ",
  "tha-ap74:1.4": "pade cittaṃ pasādayiṃ. // // ",
  "tha-ap74:2.1": "Dvenavute ito kappe ",
  "tha-ap74:2.2": "yaṃ saññam alabhiṃ tadā / ",
  "tha-ap74:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap74:2.4": "padasaññāy' idaṃ phalaṃ. // // ",
  "tha-ap74:3.1": "Ito sattamake kappe ",
  "tha-ap74:3.2": "Sumedho nāma khattiyo / ",
  "tha-ap74:3.3": "sattaratanasampanno ",
  "tha-ap74:3.4": "cakkavatti mahābalo. // // ",
  "tha-ap74:4.1": "Paṭisambhidā catasso ",
  "tha-ap74:4.2": "vimokhā pi ca aṭṭh' ime / chaḍabhiññā sacchikatā ",
  "tha-ap74:4.3": "kataṃ Buddhassa sāsanaṃ ti. // // ",
  "tha-ap74:5.1": "Itthaṃ sudaṃ āyasmā Padasaññako thero imā gāthāyo abhāsitthā ti. Padasaññakatherassa apadānaṃ samattaṃ. ",
  "tha-ap74:6.1": ""
}
