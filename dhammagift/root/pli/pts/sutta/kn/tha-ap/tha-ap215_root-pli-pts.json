  "tha-ap215:1.1": "Vessabhū tamhi samaye ",
  "tha-ap215:1.2": "bhikkhusaṅghapurakkhato / ",
  "tha-ap215:1.3": "deseti ariyasaccāni ",
  "tha-ap215:1.4": "nibbāpento mahājanaṃ. // // ",
  "tha-ap215:2.1": "Paramakāruññapatto 'mhi ",
  "tha-ap215:2.2": "samitim agamās' ahaṃ / ",
  "tha-ap215:2.3": "so 'haṃ nisinnako santo ",
  "tha-ap215:2.4": "dhammam assosiṃ satthuno. // // ",
  "tha-ap215:3.1": "Tassāhaṃ dhammaṃ sutvāna ",
  "tha-ap215:3.2": "devalokam agacch' ahaṃ / ",
  "tha-ap215:3.3": "tiṃsakappāni devesu ",
  "tha-ap215:3.4": "avasiṃ tatth' ahaṃ pure. // // ",
  "tha-ap215:4.1": "Ekatiṃse ito kappe ",
  "tha-ap215:4.2": "yaṃ saññam alabhiṃ tadā / ",
  "tha-ap215:4.3": "duggatiṃ nābhijānāmi ",
  "tha-ap215:4.4": "saccasaññāy' idaṃ phalaṃ. // // ",
  "tha-ap215:5.1": "Chabbīsamhi ito kappe ",
  "tha-ap215:5.2": "eko āsi janādhipo / ",
  "tha-ap215:5.3": "Ekaphusita-nāmo so ",
  "tha-ap215:5.4": "cakkavattī mahabbalo. // // ",
  "tha-ap215:6.1": "Paṭisambhidā . . . ",
  "tha-ap215:6.2": "pe . . . ",
  "tha-ap215:6.3": "pe . . . // // ",
  "tha-ap215:7.1": "Itthaṃ sudam āyasmā Saccasaññako thero i. g. a-ti. Saccasaññakattherassa apadānaṃ samattaṃ. ",
  "tha-ap215:8.1": ""
}
