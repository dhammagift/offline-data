  "tha-ap550:1.1": "kappe ",
  "tha-ap550:1.2": "brahmabandhu mahāyaso / ",
  "tha-ap550:1.3": "Kassapo nāma nāmena ",
  "tha-ap550:1.4": "uppajji vadataṃ varo. // // ",
  "tha-ap550:2.1": "Tadā'haṃ Candano c' eva ",
  "tha-ap550:2.2": "pabbajitvāna sāsane / ",
  "tha-ap550:2.3": "āpāṇakoṭikaṃ dhammaṃ ",
  "tha-ap550:2.4": "pūrayitvāna sāsane. // // ",
  "tha-ap550:3.1": "Tatocutā Santusitaṃ ",
  "tha-ap550:3.2": "uppannā ubhayo mayaṃ / ",
  "tha-ap550:3.3": "tattha dibbehi naccehi ",
  "tha-ap550:3.4": "gītehi vāditehi ca. // // ",
  "tha-ap550:4.1": "Rūpādi-dasah'aṅgehi ",
  "tha-ap550:4.2": "adhibhotvāna sesake / ",
  "tha-ap550:4.3": "yāvatāyuṃ vasitvāna ",
  "tha-ap550:4.4": "anubhoma mahāsukhaṃ. // // ",
  "tha-ap550:5.1": "Tatocavitvā Tidasaṃ ",
  "tha-ap550:5.2": "Candano upapajjatha / ",
  "tha-ap550:5.3": "ahaṃ Kapilavatthusmiṃ ",
  "tha-ap550:5.4": "ahosiṃ Sākiyatrajo. // // ",
  "tha-ap550:6.1": "YadāUdāyi-thereṇa ",
  "tha-ap550:6.2": "ajjhiṭṭho lokanāyako / ",
  "tha-ap550:6.3": "anukampiya Sakyānaṃ ",
  "tha-ap550:6.4": "upesi Kapilavhayaṃ. // // ",
  "tha-ap550:7.1": "Tadā'timānino Sakyāna ",
  "tha-ap550:7.2": "Buddhassa guṇaññuno / ",
  "tha-ap550:7.3": "paṇamanti na sambuddhaṃ ",
  "tha-ap550:7.4": "jāti-tthaddhā anādarā. // // ",
  "tha-ap550:8.1": "Tesaṃsaṅkappam aññāya ",
  "tha-ap550:8.2": "ākāse caṅkamī jino / ",
  "tha-ap550:8.3": "pajjunno viya vassittha ",
  "tha-ap550:8.4": "pajjalittha yathā sikhī. // // ",
  "tha-ap550:9.1": "Dassetvārūpam atulaṃ ",
  "tha-ap550:9.2": "puna-r- antaradhāyatha / ",
  "tha-ap550:9.3": "eko pi hutvā bahudhā ",
  "tha-ap550:9.4": "ahosi punar ekako. // // ",
  "tha-ap550:10.1": "Andhakāraṃpakāsañ ca ",
  "tha-ap550:10.2": "dassayitvā anekadhā / ",
  "tha-ap550:10.3": "pāṭiheraṃ karitvāna ",
  "tha-ap550:10.4": "vinayi ñātake muni. // // ",
  "tha-ap550:11.1": "Cātuddīpomahāmegho ",
  "tha-ap550:11.2": "tāvade sampavassatha / ",
  "tha-ap550:11.3": "tadā hi Jātakaṃ Buddho ",
  "tha-ap550:11.4": "Vessantaram adesayi. // // ",
  "tha-ap550:12.1": "Tadāte khattiyā sabbe ",
  "tha-ap550:12.2": "nihantvā jātijaṃ madaṃ / ",
  "tha-ap550:12.3": "upesuṃ saraṇaṃ Buddhaṃ. ",
  "tha-ap550:12.4": "Āha Suddhodano tadā: // // ",
  "tha-ap550:13.1": "Idaṃtatiyaṃ tava bhūripañña ",
  "tha-ap550:13.2": "pādāni vandāmi samantacakkhu / ",
  "tha-ap550:13.3": "Yadā hi jāto paṭhavī pakampasi ",
  "tha-ap550:13.4": "yadā ca taṃ na jahi ",
  "tha-ap550:14.1": "jambucchāyā. // // TadāBuddhānubhāvan taṃ ",
  "tha-ap550:14.2": "disvā vimhitamānaso / ",
  "tha-ap550:14.3": "pabbajitvāna tatth' eva ",
  "tha-ap550:14.4": "nivasiṃ mātupājako. // // ",
  "tha-ap550:15.1": "Candanodevaputto maṃ ",
  "tha-ap550:15.2": "upagantvā 'nurañjatha / ",
  "tha-ap550:15.3": "bhaddekarattassa tadā ",
  "tha-ap550:15.4": "saṅkhepaṃ vitthārayaṃ naraṃ // // ",
  "tha-ap550:16.1": "Codito'haṃ tadā tena ",
  "tha-ap550:16.2": "upecca naranāyakaṃ / ",
  "tha-ap550:16.3": "bhaddekarattaṃ sutvāna ",
  "tha-ap550:16.4": "saṃviggo vana-māmako. // // ",
  "tha-ap550:17.1": "Tadāmātaram āpucchi ",
  "tha-ap550:17.2": "vane gacchāmi ekako / ",
  "tha-ap550:17.3": "sukhumālo ti me mātā ",
  "tha-ap550:17.4": "dhārayiṃ te tadā vacaṃ. // // ",
  "tha-ap550:18.1": "Dabbhaṃkusaṃ poṭakilam ",
  "tha-ap550:18.2": "usīraṃ muñjababbajaṃ / ",
  "tha-ap550:18.3": "urasā panudahessāmi ",
  "tha-ap550:18.4": "vivekam anubrūhayam // // ",
  "tha-ap550:19.1": "Tadāvanam paviṭṭho 'haṃ ",
  "tha-ap550:19.2": "saritvā jinasāsanaṃ / ",
  "tha-ap550:19.3": "bhaddekarattaṃ ovādaṃ ",
  "tha-ap550:19.4": "arahattaṃ apāpuṇiṃ. // // Atītaṃnānvāgameyya na ppaṭikaṅkhe anāgataṃ / yad ",
  "tha-ap550:20.1": "ātītaṃ pahīnan ",
  "tha-ap550:20.2": "",
  "tha-ap550:20.3": "taṃ ",
  "tha-ap550:20.4": "appattañ ca anāgataṃ. // // ",
  "tha-ap550:21.1": "Paccuppannañca yo dhammaṃ ",
  "tha-ap550:21.2": "tattha tattha vipassati / ",
  "tha-ap550:21.3": "asaṃhīraṃ asaṅkuppam' ",
  "tha-ap550:21.4": "saṃviggam anubrūhaye. // // ",
  "tha-ap550:22.1": "Ajj'eva kiccaṃ kātabbaṃ; ",
  "tha-ap550:22.2": "ko jaññā maraṇaṃ suve / ",
  "tha-ap550:22.3": "na hi tosaṃ karontena ",
  "tha-ap550:22.4": "mahāsenena Maccunā. // // ",
  "tha-ap550:23.1": "Evaṃvihāriṃ ātāpiṃ ",
  "tha-ap550:23.2": "ahorattam atanditaṃ / ",
  "tha-ap550:23.3": "tam ve bhaddekaratto ti ",
  "tha-ap550:23.4": "santo ācikkate muni. // // ",
  "tha-ap550:24.1": "Kilesā. . . ",
  "tha-ap550:24.2": "pe . . . ",
  "tha-ap550:24.3": "",
  "tha-ap550:25.1": "",
  "tha-ap550:25.2": "pe . . . ",
  "tha-ap550:25.3": "pe . . . // // Sāgataṃ. . . pe . . . pe . . . pe . . . // // ",
  "tha-ap550:26.1": "Paṭisambhidā. . . ",
  "tha-ap550:26.2": "pe . . . ",
  "tha-ap550:26.3": "pe . . . pe . . . // // ",
  "tha-ap550:27.1": "Itthaṃ sudaṃ āyasmā Lomasakaṅgiyo thero i. g. a-ti. Lomasakaṅgiyattherassa ",
  "tha-ap550:28.1": "apadānaṃ samattaṃ. Imamhibhaddake "
}
