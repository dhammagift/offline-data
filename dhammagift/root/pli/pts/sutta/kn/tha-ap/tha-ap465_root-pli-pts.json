  "tha-ap465:1.1": "Ḍayhamāne sarīramhi ",
  "tha-ap465:1.2": "Vessabhussa mahesino / ",
  "tha-ap465:1.3": "gandhodakaṃ gahetvāna ",
  "tha-ap465:1.4": "citaṃ nibbāpayim ahaṃ. // // ",
  "tha-ap465:2.1": "Ekatiṃse ito kappe ",
  "tha-ap465:2.2": "citaṃ nibbāpayim ahaṃ / ",
  "tha-ap465:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap465:2.4": "gandhodakass' idaṃ phalaṃ. // // ",
  "tha-ap465:3.1": "Kilesā . . . ",
  "tha-ap465:3.2": "pe . . . ",
  "tha-ap465:3.3": "",
  "tha-ap465:4.1": "",
  "tha-ap465:4.2": "pe . . . ",
  "tha-ap465:4.3": "pe . . . // // Sāgataṃ . . . pe . . . pe . . . pe . . . // // ",
  "tha-ap465:5.1": "Paṭisambhidā . . . ",
  "tha-ap465:5.2": "pe . . . ",
  "tha-ap465:5.3": "pe . . . pe . . . // // ",
  "tha-ap465:6.1": "Itthaṃ sudam āyasmā Citakanibbāpako th. i. g. a-ti. Citakanibbāpakattherassa ",
  "tha-ap465:7.1": "apadānaṃ samattaṃ. "
}
