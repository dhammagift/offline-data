  "tha-ap538:0.3": "",
  "tha-ap538:1.1": "Ito satasahassamhi ",
  "tha-ap538:1.2": "kappe uppajji nāyako / ",
  "tha-ap538:1.3": "mahappabho tilokaggo ",
  "tha-ap538:1.4": "nāmena Padumuttaro. // // ",
  "tha-ap538:2.1": "Khippābhiññassa bhikkhussa ",
  "tha-ap538:2.2": "guṇaṃ kittayato mune / ",
  "tha-ap538:2.3": "sutvā udaggacitto 'haṃ ",
  "tha-ap538:2.4": "kāraṃ katvā mahesino. // // ",
  "tha-ap538:3.1": "Datvā sattāhikaṃ dānaṃ ",
  "tha-ap538:3.2": "sa-sissassa mune-r-ahaṃ / ",
  "tha-ap538:3.3": "abhivādiya sambuddhaṃ ",
  "tha-ap538:3.4": "taṃ ṭhānaṃ patthayiṃ tadā. // // ",
  "tha-ap538:4.1": "Tato maṃ vyakarī Buddho: ",
  "tha-ap538:4.2": "etaṃ passatha brāhmaṇaṃ / ",
  "tha-ap538:4.3": "patitaṃ pādamūle me ",
  "tha-ap538:4.4": "pīn' aṃsaṃ paccavekkhanaṃ // // ",
  "tha-ap538:5.1": "Hemayaññopacitaṅgaṃ ",
  "tha-ap538:5.2": "avadātaṃ tanuttacaṃ / ",
  "tha-ap538:5.3": "palambabimbatamboṭṭhaṃ ",
  "tha-ap538:5.4": "sitatiṇhaṃ samaṃ dijaṃ // // ",
  "tha-ap538:6.1": "Guṇatthāmaṃ bahutaraṃ ",
  "tha-ap538:6.2": "samuggatatanūruhaṃ / ",
  "tha-ap538:6.3": "guṇe kāyatanībhūtaṃ ",
  "tha-ap538:6.4": "pītisamphullitānanaṃ. // // ",
  "tha-ap538:7.1": "Eso patthayato ṭhānaṃ ",
  "tha-ap538:7.2": "khippābhiññassa bhikkhuno / ",
  "tha-ap538:7.3": "anāgate mahāvīro ",
  "tha-ap538:7.4": "Gotamo nāma hessati. // // ",
  "tha-ap538:8.1": "Tassa dhammesu dāyādo ",
  "tha-ap538:8.2": "oraso dhammanimmito / ",
  "tha-ap538:8.3": "Bāhiyo nāma nāmena ",
  "tha-ap538:8.4": "hessati satthu sāvako. // // ",
  "tha-ap538:9.1": "Tadā hi tuṭṭho vuṭṭhāya ",
  "tha-ap538:9.2": "yāvajīvaṃ mahāmuniṃ / ",
  "tha-ap538:9.3": "kāraṃ katvā cuto saggaṃ ",
  "tha-ap538:9.4": "agaṃ sabhavanaṃ yathā. // // ",
  "tha-ap538:10.1": "Devabhūto manusso vā ",
  "tha-ap538:10.2": "sukhito tassa ka*mmuno / ",
  "tha-ap538:10.3": "vā*hasā saṃsaritvāna ",
  "tha-ap538:10.4": "sampattiṃ anubhos' ",
  "tha-ap538:11.1": "ahaṃ. // // Puno Kassapavīrassa ",
  "tha-ap538:11.2": "atthaṃ entamhi sāsane / ",
  "tha-ap538:11.3": "āruyha selaṃ sikharaṃ ",
  "tha-ap538:11.4": "yuñjitvā jinasāsane // // ",
  "tha-ap538:12.1": "Visuddhasīlo sappañño ",
  "tha-ap538:12.2": "jinasāsanakārako / ",
  "tha-ap538:12.3": "tato cutā pañcajanā ",
  "tha-ap538:12.4": "devalokaṃ *agamhase.* // // ",
  "tha-ap538:13.1": "Tato 'haṃ Bāhiko jāto ",
  "tha-ap538:13.2": "Bhārukacche puruttame / ",
  "tha-ap538:13.3": "tato nāvāya pakkanto ",
  "tha-ap538:13.4": "sāgaraṃ appasiddhiyaṃ. // // ",
  "tha-ap538:14.1": "Tato nāvā abhijjittha ",
  "tha-ap538:14.2": "gantvāna katipāhakaṃ / ",
  "tha-ap538:14.3": "tadā bhiṃsanake ghore ",
  "tha-ap538:14.4": "patito makarākare. // // ",
  "tha-ap538:15.1": "Tadā 'haṃ vāyamitvāna ",
  "tha-ap538:15.2": "*santaritvā* mahodadhiṃ / ",
  "tha-ap538:15.3": "Suppārapaṭṭanam varaṃ ",
  "tha-ap538:15.4": "sampatto mandavedhito. // // ",
  "tha-ap538:16.1": "Dārucīram nivāsetvā ",
  "tha-ap538:16.2": "gāmaṃ piṇḍāya pāvisiṃ / ",
  "tha-ap538:16.3": "tad' āha so jano tuṭṭho: ",
  "tha-ap538:16.4": "\"arahā 'yam idhāgato // // ",
  "tha-ap538:17.1": "Imaṃ annena pānena ",
  "tha-ap538:17.2": "*vatthena sa*yanena ca / ",
  "tha-ap538:17.3": "bhesajjena ca sakkatvā ",
  "tha-ap538:17.4": "hessāma sukhitā mayaṃ\". // // ",
  "tha-ap538:18.1": "Paccayānaṃ tadā lābhī' ",
  "tha-ap538:18.2": "tehi sakkatapūjitaṃ / arahā ",
  "tha-ap538:18.3": "'yan ti saṅkappaṃ ",
  "tha-ap538:18.4": "uppādesiṃ ayoniso. // // ",
  "tha-ap538:19.1": "Tato me ci*ttam aññāya ",
  "tha-ap538:19.2": "co*dayitvā pubbadevatā: / ",
  "tha-ap538:19.3": "‘na tvaṃ upāyamaggaññū ",
  "tha-ap538:19.4": "kuto hi arahā bhave.' // // ",
  "tha-ap538:20.1": "Codito tāya saṃviggo ",
  "tha-ap538:20.2": "tadā 'haṃ paripucchi taṃ: / ",
  "tha-ap538:20.3": "ke vā ete kuhiṃ loke ",
  "tha-ap538:20.4": "arahanto maruttamā? // // ",
  "tha-ap538:21.1": "*Sāvatthiyaṃ Ko*salamandire jino / ",
  "tha-ap538:21.2": "pahūtapañño varabhurimedhaso // // ",
  "tha-ap538:21.3": "Sakyaputto arahā anāsavo / ",
  "tha-ap538:21.4": "deseti dhammaṃ arahattapattiyā. // // ",
  "tha-ap538:22.1": "Tad' assa sutvā vacanaṃ supīṇito / ",
  "tha-ap538:22.2": "nidhiṃ va la*ddhā kappaṇo va vi*mhito // // ",
  "tha-ap538:22.3": "Udaggacitto arahattam uttamaṃ / ",
  "tha-ap538:22.4": "sudassanaṃ duṭṭhamanantagocaraṃ. // // ",
  "tha-ap538:23.1": "Tadā rato nikkhamitvāna satthuno / ",
  "tha-ap538:23.2": "sadā jinaṃ passāmi vimalānanaṃ // // ",
  "tha-ap538:23.3": "Upecca rammaṃ Vijitavhayaṃ va taṃ / ",
  "tha-ap538:23.4": "dije apucchiṃ: kuhiṃ Lokananda*no? // // ",
  "tha-ap538:24.1": "Tato* avocuṃ naradevavandito / ",
  "tha-ap538:24.2": "puraṃ paviṭṭho asanesanāya so. // // ",
  "tha-ap538:24.3": "Saso va khippaṃ munidassanussuko / ",
  "tha-ap538:24.4": "upecca vandāhi tam aggapuggalam // // ",
  "tha-ap538:25.1": "Tato 'haṃ tuvaṭaṃ gantvā ",
  "tha-ap538:25.2": "Sāvatthim puram uttamaṃ / ",
  "tha-ap538:25.3": "vicarantan tam addakkhiṃ ",
  "tha-ap538:25.4": "piṇḍattham apihāgidham // // ",
  "tha-ap538:26.1": "Pattapāṇiṃ alolakkhaṃ ",
  "tha-ap538:26.2": "bhājayantaṃ idhāmataṃ / ",
  "tha-ap538:26.3": "sirinilayasaṅkāsañ ",
  "tha-ap538:26.4": "ravidittiharānanaṃ. // // ",
  "tha-ap538:27.1": "Taṃ samecca nipaccāhaṃ ",
  "tha-ap538:27.2": "imaṃ vacanam abraviṃ: / ",
  "tha-ap538:27.3": "‘kupathe vippanaṭṭhassa ",
  "tha-ap538:27.4": "saraṇaṃ hohi Gotama.' // // ",
  "tha-ap538:28.1": "Pāṇasantāraṇatt*hāya ",
  "tha-ap538:28.2": "piṇḍāya vicarām' ahaṃ* / ",
  "tha-ap538:28.3": "na te dhammakathākālo ",
  "tha-ap538:28.4": "icc āha munisattamo. // // ",
  "tha-ap538:29.1": "Tadā punappunaṃ Buddhaṃ ",
  "tha-ap538:29.2": "āyāciṃ dhammalālaso / ",
  "tha-ap538:29.3": "so me dhammam adesesi ",
  "tha-ap538:29.4": "gambhīraṃ suññataṃ padaṃ // // ",
  "tha-ap538:30.1": "Tassa dhammaṃ suṇitvānaṃ ",
  "tha-ap538:30.2": "pāpuṇiṃ āsavakkhayaṃ / ",
  "tha-ap538:30.3": "pari*kkhīṇāyuko santo ",
  "tha-ap538:30.4": "atho* satthā 'nukampito. // // ",
  "tha-ap538:31.1": "Kilesā . . . ",
  "tha-ap538:31.2": "pe . . . ",
  "tha-ap538:31.3": "",
  "tha-ap538:32.1": "",
  "tha-ap538:32.2": "pe . . . ",
  "tha-ap538:32.3": "pe . . . // // Sāgataṃ . . . pe . . . pe . . . pe . . . // // ",
  "tha-ap538:33.1": "Paṭisambhidā . . . ",
  "tha-ap538:33.2": "pe . . . ",
  "tha-ap538:33.3": "pe . . . pe . . . // // ",
  "tha-ap538:34.1": "Evaṃ thero viyākāsi ",
  "tha-ap538:34.2": "Bāhiyo Dārucīriyo / ",
  "tha-ap538:34.3": "saṃkārakuṭe patito ",
  "tha-ap538:34.4": "bhūtādhiṭṭhāya gāviyā. // // ",
  "tha-ap538:35.1": "*Attano pubbacaritaṃ ",
  "tha-ap538:35.2": "ki*ttayitvā mahāmati / ",
  "tha-ap538:35.3": "parinibbāyi so vīro ",
  "tha-ap538:35.4": "Sāvatthiyaṃ puruttame. // // ",
  "tha-ap538:36.1": "Nagarā nikkhamanto taṃ ",
  "tha-ap538:36.2": "disvāna isisattamo / ",
  "tha-ap538:36.3": "dārucīradharaṃ dhīraṃ ",
  "tha-ap538:36.4": "bāhikaṃ bāhitāgamaṃ // // ",
  "tha-ap538:37.1": "Bhumiyaṃ *patitaṃ da*ntaṃ ",
  "tha-ap538:37.2": "indaketuṃ va pātitaṃ / ",
  "tha-ap538:37.3": "gatāyusaṃgataklesañ ",
  "tha-ap538:37.4": "jinasāsanakārakaṃ. // // ",
  "tha-ap538:38.1": "Tato āmantayī satthā ",
  "tha-ap538:38.2": "sāvake sāsane rate: / ",
  "tha-ap538:38.3": "gaṇhatha hutvā jhāpetha ",
  "tha-ap538:38.4": "tanuṃ sabrahmacārino // // ",
  "tha-ap538:39.1": "*Thūpaṃ ka*rotha pūjetha; ",
  "tha-ap538:39.2": "nibbuto so mahāmati / ",
  "tha-ap538:39.3": "khippābhiññānam es' aggo ",
  "tha-ap538:39.4": "sāvako me vaco karo. // // ",
  "tha-ap538:40.1": "Sahassam api ce gāthā ",
  "tha-ap538:40.2": "anatthapadasaṃhitā / ",
  "tha-ap538:40.3": "ekaṃ gāthāpadaṃ seyyo ",
  "tha-ap538:40.4": "yaṃ sutvā upasammati. // // ",
  "tha-ap538:41.1": "Yattha āpo ca pathavī ca ",
  "tha-ap538:41.2": "tejo vāyo na gādhati / ",
  "tha-ap538:41.3": "na tattha sukkā jotanti ",
  "tha-ap538:41.4": "ādicco na ppakāsati. // // ",
  "tha-ap538:42.1": "Na tattha candimā bhāti ",
  "tha-ap538:42.2": "tamo tattha na vijjati / ",
  "tha-ap538:42.3": "yadā ca attanā vedī ",
  "tha-ap538:42.4": "*muni mo*nena brāhmaṇo. // // ",
  "tha-ap538:43.1": "Atha rūpā arūpā ca ",
  "tha-ap538:43.2": "sukhadukkhā vimuccati // // ",
  "tha-ap538:43.3": "icc evaṃ abhaṇī nātho ",
  "tha-ap538:43.4": "tilokasaraṇo munī ti. ",
  "tha-ap538:44.1": "Itthaṃ sudaṃ āyasmā Bāhiyo thero i. g. a-ti. Bāhiyattherassa apadānaṃ samattaṃ. ",
  "tha-ap538:45.1": ""
}
