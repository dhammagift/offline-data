  "tha-ap509:1.1": "Ajjuno nāma sambuddho ",
  "tha-ap509:1.2": "Himavante vasī tadā / ",
  "tha-ap509:1.3": "caraṇena ca sampanno ",
  "tha-ap509:1.4": "samādhikusalo muni. // // ",
  "tha-ap509:2.1": "Kumbhamattaṃ gahetvāna ",
  "tha-ap509:2.2": "ajelam jīvajīvakaṃ / ",
  "tha-ap509:2.3": "chattapaṇṇaṃ gahetvāna ",
  "tha-ap509:2.4": "adāsiṃ satthuno ahaṃ. // // ",
  "tha-ap509:3.1": "Catunavute ito kappe ",
  "tha-ap509:3.2": "yaṃ phalaṃ adadiṃ tadā / ",
  "tha-ap509:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap509:3.4": "phaladānass' idaṃ phalaṃ. // // ",
  "tha-ap509:4.1": "Kilesā . . . ",
  "tha-ap509:4.2": "pe . . . ",
  "tha-ap509:4.3": "",
  "tha-ap509:5.1": "",
  "tha-ap509:5.2": "pe . . . ",
  "tha-ap509:5.3": "pe . . . // // Sāgataṃ . . . pe . . . pe . . . pe . . . // // ",
  "tha-ap509:6.1": "Paṭisambhidā . . . ",
  "tha-ap509:6.2": "pe . . . ",
  "tha-ap509:6.3": "pe . . . pe . . . // // ",
  "tha-ap509:7.1": "Itthaṃ sudaṃ āyasmā Ajelaphaladāyako thero i. g. a-ti. Ajelaphaladāyakattherassa apadānaṃ samattaṃ ",
  "tha-ap509:8.1": ""
}
