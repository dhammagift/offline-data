  "tha-ap303:1.1": "Isisaṅghe ahaṃ pubbe ",
  "tha-ap303:1.2": "āsiṃ *mātaṅgavāraṇo* / ",
  "tha-ap303:1.3": "mahesīnaṃ pasādena ",
  "tha-ap303:1.4": "padumakesaram okiriṃ. // // ",
  "tha-ap303:2.1": "Paccekajinaseṭṭhesu ",
  "tha-ap303:2.2": "dhutarāgesu tādisu / ",
  "tha-ap303:2.3": "tesu cittaṃ pasādetvā ",
  "tha-ap303:2.4": "kappaṃ saggamhi mod' ahaṃ. // // Ekanavute ",
  "tha-ap303:3.1": "ito kappe ",
  "tha-ap303:3.2": "kesaram okiriṃ tadā / ",
  "tha-ap303:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap303:3.4": "*pupphapūjāy'* idaṃ phalaṃ. // // ",
  "tha-ap303:4.1": "Paṭisambhidā . . . pe . . . ",
  "tha-ap303:4.2": "",
  "tha-ap303:4.3": "pe . . . // // ",
  "tha-ap303:4.4": "",
  "tha-ap303:5.1": "Itthaṃ sudam āyasmā Padumakesariyo thero i. g. a-ti. Padumakesariyattherassa ",
  "tha-ap303:6.1": "apadānaṃ samattaṃ. "
}
