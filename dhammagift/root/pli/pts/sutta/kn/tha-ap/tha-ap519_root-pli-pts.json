  "tha-ap519:1.1": "",
  "tha-ap519:1.2": "nāma pabbato / ",
  "tha-ap519:1.3": "Buddho Sudassano nāma ",
  "tha-ap519:1.4": "vasate pabbatantare. // // ",
  "tha-ap519:2.1": "Pupphaṃ hemavataṃ gayha ",
  "tha-ap519:2.2": "vehāsaṃ agamās' ahaṃ / ",
  "tha-ap519:2.3": "tatth' addasāsiṃ sambuddhaṃ ",
  "tha-ap519:2.4": "oghatiṇṇam anāsavaṃ. // // ",
  "tha-ap519:3.1": "Pupphaṃ kuṭajam ādāya ",
  "tha-ap519:3.2": "sire katvān' ahan tadā / ",
  "tha-ap519:3.3": "Buddhassa abhiropesiṃ ",
  "tha-ap519:3.4": "sayambhussa mahesino. // // ",
  "tha-ap519:4.1": "Ekatiṃse ito kappe ",
  "tha-ap519:4.2": "yaṃ pupphaṃ abhipūjayiṃ / ",
  "tha-ap519:4.3": "duggatiṃ nābhijānāmi ",
  "tha-ap519:4.4": "Buddhapūjāy' idaṃ phalaṃ. // // ",
  "tha-ap519:5.1": "Kilesā . . . ",
  "tha-ap519:5.2": "pe . . . ",
  "tha-ap519:5.3": "",
  "tha-ap519:6.1": "",
  "tha-ap519:6.2": "pe . . . ",
  "tha-ap519:6.3": "pe . . . // // Sāgataṃ . . . pe . . . pe . . . pe . . . // // ",
  "tha-ap519:7.1": "Paṭisambhidā . . . ",
  "tha-ap519:7.2": "pe . . . ",
  "tha-ap519:7.3": "pe . . . pe . . . // // ",
  "tha-ap519:8.1": "Itthaṃ sudaṃ āyasmā Kuṭajapupphiyo thero i. g. a-ti. Kuṭajapupphiyattherassa ",
  "tha-ap519:9.1": "apadānaṃ samattaṃ. "
}
