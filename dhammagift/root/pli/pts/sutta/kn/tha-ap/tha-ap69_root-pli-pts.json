  "tha-ap69:0.1": "",
  "tha-ap69:0.2": "",
  "tha-ap69:0.3": "",
  "tha-ap69:1.1": "tadā āsiṃ ",
  "tha-ap69:1.2": "supaṇṇo garuḷādhipo / ",
  "tha-ap69:1.3": "addasaṃ virajaṃ buddhaṃ ",
  "tha-ap69:1.4": "gacchantaṃ Gandhamādanaṃ // // ",
  "tha-ap69:2.1": "Jahitvā garuḷavaṇṇaṃ ",
  "tha-ap69:2.2": "māṇavatthaṃ adhārayiṃ / ",
  "tha-ap69:2.3": "ekaṃ vatthaṃ mayā dinnaṃ ",
  "tha-ap69:2.4": "dipadindassa tādino. // // ",
  "tha-ap69:3.1": "Naṃ ca dussaṃ paṭiggayha ",
  "tha-ap69:3.2": "Buddho lokagganāyako / ",
  "tha-ap69:3.3": "antalikkhe ṭhito satthā ",
  "tha-ap69:3.4": "imā gāthā abhāsatha: // // ",
  "tha-ap69:4.1": "Iminā vatthadānena ",
  "tha-ap69:4.2": "cittassa paṇidhīhi ca / ",
  "tha-ap69:4.3": "pahāya garuḷāyoniṃ ",
  "tha-ap69:4.4": "devaloke ramissati. // // ",
  "tha-ap69:5.1": "Atthadassī tu bhagavā ",
  "tha-ap69:5.2": "lokajeṭṭho narāsabho / ",
  "tha-ap69:5.3": "vatthadānaṃ pasaṃsitvā ",
  "tha-ap69:5.4": "pakkāmi uttarāmukho. // // ",
  "tha-ap69:6.1": "Bhave nibbattamānamhi ",
  "tha-ap69:6.2": "honti me vatthasampadā / ",
  "tha-ap69:6.3": "ākāse chadanaṃ hoti ",
  "tha-ap69:6.4": "vatthadānass' idaṃ phalaṃ. // // ",
  "tha-ap69:7.1": "Aruṇakā satta janā ",
  "tha-ap69:7.2": "cakkavattī mahabbalā / ",
  "tha-ap69:7.3": "chattiṃsatimhi āsiṃsu ",
  "tha-ap69:7.4": "kappamhi manujādhipā. // // ",
  "tha-ap69:8.1": "Paṭisambhidā catasso ",
  "tha-ap69:8.2": "vimokhā pi ca aṭṭh' ime / chaḷabhiññā sacchikatā ",
  "tha-ap69:8.3": "kataṃ Buddhassa sāsanan ti. // // ",
  "tha-ap69:9.1": "Itthaṃ sudaṃ āyasmā Vatthadāyako thero imā gāthāyo abhāsitthā ti. ",
  "tha-ap69:10.1": "Vatthadāyakattherassa apadānaṃ samattaṃ. "
}
