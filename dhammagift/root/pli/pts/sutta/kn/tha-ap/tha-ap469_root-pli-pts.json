  "tha-ap469:1.1": "Nagare Bandhumatiyā ",
  "tha-ap469:1.2": "ārāmiko ahaṃ tadā / ",
  "tha-ap469:1.3": "addasaṃ virajaṃ Buddhaṃ ",
  "tha-ap469:1.4": "gacchantam anilañjase. // // ",
  "tha-ap469:2.1": "Labujaphalam ādāya ",
  "tha-ap469:2.2": "Buddhasetthass' adās' ahaṃ / ",
  "tha-ap469:2.3": "ākāse va ṭhito santo ",
  "tha-ap469:2.4": "patigaṇhi mahāyaso / ",
  "tha-ap469:3.1": "vittiṃ sañjanano mayhaṃ ",
  "tha-ap469:3.2": "diṭṭhadhammasukhāvaho. // // ",
  "tha-ap469:3.3": "Phalaṃ Buddhassa datvāna ",
  "tha-ap469:3.4": "vippasannena cetasā / ",
  "tha-ap469:4.1": "adhigacchiṃ tadā pūtiṃ ",
  "tha-ap469:4.2": "vipulaṃ sukham uttamaṃ / ",
  "tha-ap469:4.3": "uppajjate 'va ratanaṃ ",
  "tha-ap469:4.4": "nibbattassa yahiṃ yahiṃ. // // Ekanavute ",
  "tha-ap469:5.1": "ito kappe ",
  "tha-ap469:5.2": "yaṃ phalam adadiṃ tadā / ",
  "tha-ap469:5.3": "duggatiṃ nābhijānāmi ",
  "tha-ap469:5.4": "phaladānass' idaṃ phalaṃ. // // ",
  "tha-ap469:6.1": "Kilesā . . . ",
  "tha-ap469:6.2": "pe . . . ",
  "tha-ap469:6.3": "",
  "tha-ap469:7.1": "",
  "tha-ap469:7.2": "pe . . . ",
  "tha-ap469:7.3": "pe . . . // // Sāgataṃ . . . pe . . . pe . . . pe . . . // // ",
  "tha-ap469:8.1": "Paṭisambhidā . . . ",
  "tha-ap469:8.2": "pe . . . ",
  "tha-ap469:8.3": "pe . . . pe . . . // // ",
  "tha-ap469:9.1": "Itthaṃ sudam āyasmā Labujadāyako th. i. g. a-ti. Labujadāyakattherassa apadānaṃ ",
  "tha-ap469:10.1": "samattaṃ. Vanante "
}
