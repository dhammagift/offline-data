  "tha-ap256:1.1": "",
  "tha-ap256:1.2": "Vikaṭo nāma pabbato / ",
  "tha-ap256:1.3": "tassa vemajjhe vasati ",
  "tha-ap256:1.4": "samaṇo bhāvitindriyo. // // ",
  "tha-ap256:2.1": "Disvāna tassopasamaṃ ",
  "tha-ap256:2.2": "vippasannena cetasā / ",
  "tha-ap256:2.3": "tīṇi campakapupphāni ",
  "tha-ap256:2.4": "gahetvāna samokiriṃ. // // ",
  "tha-ap256:3.1": "Ekanavute ito kappe ",
  "tha-ap256:3.2": "yaṃ puppham abhipūjayiṃ / ",
  "tha-ap256:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap256:3.4": "Buddhapūjāy' idaṃ phalaṃ. // // ",
  "tha-ap256:4.1": "Paṭisambhidā . . . ",
  "tha-ap256:4.2": "pe . . . ",
  "tha-ap256:4.3": "pe . . . // // ",
  "tha-ap256:5.1": "Itthaṃ sudam āyasmā Ticampakapupphiyo thero i. g. a-ti. Ticampakapupphiyattherassa apadānaṃ samattaṃ. Kaṇikāraṃ va ",
  "tha-ap256:6.1": ""
}
