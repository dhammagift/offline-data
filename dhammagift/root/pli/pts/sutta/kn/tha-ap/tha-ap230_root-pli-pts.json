  "tha-ap230:1.1": "Nibbute lokanāthamhi ",
  "tha-ap230:1.2": "Sikhimhi vadataṃ vare / ",
  "tha-ap230:1.3": "vataṃsakehi ākiṇṇaṃ ",
  "tha-ap230:1.4": "bodhipūjam akās' ahaṃ. // // ",
  "tha-ap230:2.1": "Ekatiṃse ito kappe ",
  "tha-ap230:2.2": "yaṃ pūjam akariṃ tadā / ",
  "tha-ap230:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap230:2.4": "bodhipūjāy' idaṃ phalaṃ. // // ",
  "tha-ap230:3.1": "Ito chabbīsatī kappe ",
  "tha-ap230:3.2": "ahu Meghabbha-nāmako / ",
  "tha-ap230:3.3": "sattaratanasampanno ",
  "tha-ap230:3.4": "cakkavatti mahabbalo. // // ",
  "tha-ap230:4.1": "Paṭisambhidā . . . ",
  "tha-ap230:4.2": "pe . . . ",
  "tha-ap230:4.3": "pe . . . // // ",
  "tha-ap230:5.1": "Itthaṃ sudam āyasmā Miñjavaṭaṃsakiyo thero i. g. a-ti. Miñjavaṭaṃsakiyattherassa ",
  "tha-ap230:6.1": "apadānaṃ samattaṃ. "
}
