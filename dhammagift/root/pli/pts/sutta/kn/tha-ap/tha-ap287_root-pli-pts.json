  "tha-ap287:1.1": "tīre ",
  "tha-ap287:1.2": "sayambhū aparājito / ",
  "tha-ap287:1.3": "samādhi so samāpanno ",
  "tha-ap287:1.4": "vippasanno anāvilo. // // ",
  "tha-ap287:2.1": "Disvā pasannasumano ",
  "tha-ap287:2.2": "sambuddham aparājitaṃ / ",
  "tha-ap287:2.3": "tāhaṃ maghavapupphena ",
  "tha-ap287:2.4": "sayambhuṃ pūjayiṃ tadā. // // ",
  "tha-ap287:3.1": "Ekanavute ito kappe ",
  "tha-ap287:3.2": "yaṃ puppham abhipūjayiṃ / ",
  "tha-ap287:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap287:3.4": "Buddhapūjāy' idaṃ phalaṃ. // // ",
  "tha-ap287:4.1": "Paṭisambhidā . . . ",
  "tha-ap287:4.2": "pe . . . ",
  "tha-ap287:4.3": "pe . . . // // ",
  "tha-ap287:5.1": "Itthaṃ sudam āyasmā Maghavapupphiyo thero i. g. a-ti. Maghavapupphiyattherassa ",
  "tha-ap287:6.1": "apadānaṃ samattaṃ. "
}
