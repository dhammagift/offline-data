  "tha-ap308:0.2": "",
  "tha-ap308:0.3": "",
  "tha-ap308:1.1": "Namo te buddhavīr' atthu ",
  "tha-ap308:1.2": "vippamutto si sabbadhi / ",
  "tha-ap308:1.3": "vyasanam hi anuppatto ",
  "tha-ap308:1.4": "tassa me saraṇaṃ bhava. // // ",
  "tha-ap308:2.1": "Siddhattho tassa vyākāsi ",
  "tha-ap308:2.2": "loke appaṭipuggalo: / ",
  "tha-ap308:2.3": "‘mahodadhisamo saṅgho ",
  "tha-ap308:2.4": "appameyyo anuttaro. // // ",
  "tha-ap308:3.1": "Tattha tvaṃ viraje khette ",
  "tha-ap308:3.2": "anantaphaladāyake / ",
  "tha-ap308:3.3": "saṅghe cittaṃ pasādehi sukhī ",
  "tha-ap308:3.4": "bījañ ca ropaya.' // // ",
  "tha-ap308:4.1": "Idaṃ vatvāna sabbaññū ",
  "tha-ap308:4.2": "lokajeṭṭho narāsabho / ",
  "tha-ap308:4.3": "mam evam anusāsitvā ",
  "tha-ap308:4.4": "vehāsaṃ nabham uggami. // // ",
  "tha-ap308:5.1": "Aciraṃ gatamaggamhi ",
  "tha-ap308:5.2": "sabbaññumhi narāsabhe / ",
  "tha-ap308:5.3": "maraṇaṃ samanuppatto ",
  "tha-ap308:5.4": "Tusitam upapajj' ahaṃ. // // ",
  "tha-ap308:6.1": "Tadāhaṃ viraje khette ",
  "tha-ap308:6.2": "anantaphaladāyake / ",
  "tha-ap308:6.3": "saṅghe cittaṃ pasādetvā ",
  "tha-ap308:6.4": "kappaṃ saggamhi mod' ahaṃ. // // Catunavute ",
  "tha-ap308:7.1": "ito kappe ",
  "tha-ap308:7.2": "pasādam alabhiṃ tadā / ",
  "tha-ap308:7.3": "duggatiṃ nābhijānāmi ",
  "tha-ap308:7.4": "pasādassa idaṃ phalaṃ. // // ",
  "tha-ap308:8.1": "Paṭisambhidā . . . ",
  "tha-ap308:8.2": "pe . . . ",
  "tha-ap308:8.3": "pe . . . // // ",
  "tha-ap308:9.1": "Itthaṃ sudam āyasmā Sampasādiko thero i. g. a-ti. Sampasādakattherassa ",
  "tha-ap308:10.1": "apadānaṃ samattaṃ. "
}
