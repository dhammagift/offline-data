{
  "tha-ap162:0.1": "",
  "tha-ap162:0.2": "",
  "tha-ap162:0.3": "",
  "tha-ap162:1.1": "",
  "tha-ap162:1.2": "mahājātassaro ahu / ",
  "tha-ap162:1.3": "padumuppalasañchanno ",
  "tha-ap162:1.4": "puṇḍarīkasamotato. // // ",
  "tha-ap162:2.1": "Kakudho nāma nāmena ",
  "tha-ap162:2.2": "tatthāsiṃ sakuṇo tadā / ",
  "tha-ap162:2.3": "sīlavā Buddhisampanno ",
  "tha-ap162:2.4": "puññāpuññe sukovido. // // ",
  "tha-ap162:3.1": "Padumuttaro lokavidū ",
  "tha-ap162:3.2": "āhutīnaṃ paṭiggaho / ",
  "tha-ap162:3.3": "jātassarass' avidūre ",
  "tha-ap162:3.4": "sañcarittha mahāmuni. // // ",
  "tha-ap162:4.1": "Jalajaṃ kumudaṃ gahetvā ",
  "tha-ap162:4.2": "upanesiṃ mahesino / ",
  "tha-ap162:4.3": "mama saṅkappam aññāya ",
  "tha-ap162:4.4": "paṭiggahi mahāmuni. // // ",
  "tha-ap162:5.1": "Taṃ dānam adaditvā-'haṃ ",
  "tha-ap162:5.2": "sukkamūlena codito / ",
  "tha-ap162:5.3": "kappānaṃ satasahassan ",
  "tha-ap162:5.4": "duggatiṃ nupapajj' ahaṃ // // ",
  "tha-ap162:6.1": "Soḷase 'to kappasate ",
  "tha-ap162:6.2": "āsuṃ Varuṇanāmakā / ",
  "tha-ap162:6.3": "aṭṭha ete janā tattha ",
  "tha-ap162:6.4": "cakkavattī mahabbalā. // // ",
  "tha-ap162:7.1": "Paṭisambhidā . . . ",
  "tha-ap162:7.2": "pe . . . ",
  "tha-ap162:7.3": "pe . . . // // ",
  "tha-ap162:8.1": "Itthaṃ sudaṃ ā. Kumudadāyako thero i. g. ā- ti. Kumudadāyakattherassa apadānaṃ samattaṃ. ",
  "tha-ap162:9.1": "",
  "tha-ap162:10.1": "",
  "tha-ap162:11.1": "Uddānaṃ: ",
  "tha-ap162:12.1": "Bandhujīvo Tambapupphī ",
  "tha-ap162:12.2": "Vīthī Kakkārupupphiyo ",
  "tha-ap162:12.3": "Mandāravo Kadambī ca ",
  "tha-ap162:12.4": "Suliko Nāgapupphiyo ",
  "tha-ap162:12.5": "Punnāgo Komudī gāthā ",
  "tha-ap162:12.6": "chappaññāsapakittitā. "
}
