{
  "tha-ap20:0.1": "",
  "tha-ap20:0.2": "",
  "tha-ap20:0.3": "",
  "tha-ap20:1.1": "Padumuttarassa bhagavato ",
  "tha-ap20:1.2": "lokajeṭṭhassa tādino / ",
  "tha-ap20:1.3": "varanāgo mayā dinno-r- ",
  "tha-ap20:1.4": "īsādanto *urūḷhavo* // // ",
  "tha-ap20:2.1": "Setacchattopasevito sāthabbaṇo ",
  "tha-ap20:2.2": "sahatthipo / ",
  "tha-ap20:2.3": "agghāpetvāna taṃ sabbaṃ ",
  "tha-ap20:2.4": "saṅghārāmam akārayiṃ. // // ",
  "tha-ap20:3.1": "Catupaññāsasahassāni ",
  "tha-ap20:3.2": "pāsāde kārayim ahaṃ / ",
  "tha-ap20:3.3": "mahābhattaṃ karitvāna ",
  "tha-ap20:3.4": "*niyyātesiṃ mahesino.* // // ",
  "tha-ap20:4.1": "Anumodi mahāvīro ",
  "tha-ap20:4.2": "sayambhū aggapuggalo / ",
  "tha-ap20:4.3": "sabbe jane hāsayanto ",
  "tha-ap20:4.4": "deseti amataṃ padaṃ. // // ",
  "tha-ap20:5.1": "Tam me buddho viyākāsi ",
  "tha-ap20:5.2": "jaladuttamanāyako / ",
  "tha-ap20:5.3": "bhikkhusaṅghe nisīditvā ",
  "tha-ap20:5.4": "imā gāthā abhāsatha: // // ",
  "tha-ap20:6.1": "\"‘Catupaññāsasahassāni ",
  "tha-ap20:6.2": "pāsāde kārayiṃ ahaṃ' / ",
  "tha-ap20:6.3": "Kathayissāmi vipākaṃ; ",
  "tha-ap20:6.4": "suṇotha mama bhāsato: // // ",
  "tha-ap20:7.1": "Aṭṭhārasasahassāni ",
  "tha-ap20:7.2": "kūṭāgārā bhavissare / ",
  "tha-ap20:7.3": "vyamhuttamamhi nibbattā ",
  "tha-ap20:7.4": "sabbasoṇṇamayā ca te. // // ",
  "tha-ap20:8.1": "*Paññāsakhat*tuṃ devindo ",
  "tha-ap20:8.2": "devarajjaṃ karissati / ",
  "tha-ap20:8.3": "aṭṭhapaññāsakhattuñ ca ",
  "tha-ap20:8.4": "cakkavatti bhavissati. // // ",
  "tha-ap20:9.1": "Kappasatasahassamhi ",
  "tha-ap20:9.2": "Okkākakulasambhavo / ",
  "tha-ap20:9.3": "Gotamo nāma nāmena ",
  "tha-ap20:9.4": "satthā loke bhavissati. // // ",
  "tha-ap20:10.1": "*Devalokā* cavitvāna ",
  "tha-ap20:10.2": "sukkamūlena codito / ",
  "tha-ap20:10.3": "aḍḍhe kule mahābhoge ",
  "tha-ap20:10.4": "nibbattissati tāvade. // // ",
  "tha-ap20:11.1": "So pacchā pabbajitvāna ",
  "tha-ap20:11.2": "sukkamūlena codito / ",
  "tha-ap20:11.3": "Raṭṭhapālo ti nāmena ",
  "tha-ap20:11.4": "hessati satthu sāvako // // ",
  "tha-ap20:12.1": "Padhānapahitatto so ",
  "tha-ap20:12.2": "upa*santo nirūpa*dhi / ",
  "tha-ap20:12.3": "sabbāsave pariññāya ",
  "tha-ap20:12.4": "nibbāyissat' anāsavo.\" // // ",
  "tha-ap20:13.1": "Uṭṭhāya abhinikkhamma ",
  "tha-ap20:13.2": "jahitvā bhogasampadā / ",
  "tha-ap20:13.3": "kheḷapiṇḍo va bhogamhi ",
  "tha-ap20:13.4": "pemaṃ mayhaṃ na vijjati. // // ",
  "tha-ap20:14.1": "Viriyam me dhuradhorayhaṃ ",
  "tha-ap20:14.2": "yogakkhemādivāhanaṃ / ",
  "tha-ap20:14.3": "dhāremi antimaṃ *dehaṃ ",
  "tha-ap20:14.4": "sammāsa*mbuddhasāsane. // // ",
  "tha-ap20:15.1": "Paṭisambhidā catasso ",
  "tha-ap20:15.2": "vimokhā pi ca aṭṭh' ime / ",
  "tha-ap20:15.3": "chaḍabhiññā sacchikatā ",
  "tha-ap20:15.4": "kataṃ Buddhassasāsanan ti. // // ",
  "tha-ap20:16.1": "Itthaṃ sudaṃ āyasmā Raṭṭhapālo thero imā gāthāyo abhāsitthā ti. Raṭṭhapālatherassa apadānaṃ samattaṃ. abbhāraṃ ",
  "tha-ap20:17.1": ""
}
