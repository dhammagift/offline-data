  "tha-ap196:1.1": "Tivarāyaṃ pure ramme ",
  "tha-ap196:1.2": "rājuyyānam ahu tadā / ",
  "tha-ap196:1.3": "uyyānapālo tatth' āsiṃ ",
  "tha-ap196:1.4": "rañño paddhacaro ahaṃ. // // ",
  "tha-ap196:2.1": "Padumo nāma nāmena ",
  "tha-ap196:2.2": "sayambhū sappabho ahū / ",
  "tha-ap196:2.3": "nisinnaṃ puṇḍarīkamhi ",
  "tha-ap196:2.4": "chāyāy' na jahitaṃ muniṃ // // ",
  "tha-ap196:3.1": "Asokaṃ pupphitaṃ disvā ",
  "tha-ap196:3.2": "piṇḍibhāraṃ sudassanaṃ / ",
  "tha-ap196:3.3": "Buddhassa abhiropesiṃ ",
  "tha-ap196:3.4": "jalajuttamanāmino. // // ",
  "tha-ap196:4.1": "Catunavute ito kappe ",
  "tha-ap196:4.2": "yaṃ puppham abhiropayiṃ / ",
  "tha-ap196:4.3": "duggatiṃ nābhijānāmi ",
  "tha-ap196:4.4": "Buddhapūjāy' idaṃ phalaṃ. // // ",
  "tha-ap196:5.1": "Sattatimhi ito kappe ",
  "tha-ap196:5.2": "soḷasā Aruṇañjahā / ",
  "tha-ap196:5.3": "sattaratanasampannā ",
  "tha-ap196:5.4": "cakkavattī mahabbalā. // // ",
  "tha-ap196:6.1": "Paṭisambhidā . . . ",
  "tha-ap196:6.2": "pe . . . ",
  "tha-ap196:6.3": "pe . . . // // ",
  "tha-ap196:7.1": "Itthaṃ sudām āyasmā Asokapūjako thero i. g. a-ti. Asokapūjakattherassa apadānaṃ samattaṃ. ",
  "tha-ap196:8.1": ""
}
