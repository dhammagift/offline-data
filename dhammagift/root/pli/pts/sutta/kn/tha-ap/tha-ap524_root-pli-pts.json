  "tha-ap524:1.1": "Vipassino bhagavato ",
  "tha-ap524:1.2": "lokajeṭṭhassa tādino / ",
  "tha-ap524:1.3": "ekapecchaṃ mayā dinnaṃ ",
  "tha-ap524:1.4": "pasannena sapāṇinā. // // ",
  "tha-ap524:2.1": "Hatthiyānaṃ assayānaṃ ",
  "tha-ap524:2.2": "dibbayānaṃ samajjhagaṃ / ",
  "tha-ap524:2.3": "tena pecchakadānenā ",
  "tha-ap524:2.4": "patto 'mhi āsavakkhayaṃ. // // ",
  "tha-ap524:3.1": "Ekanavute ito kappe ",
  "tha-ap524:3.2": "yaṃ peccham adadiṃ tadā / ",
  "tha-ap524:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap524:3.4": "pecchadānass' idaṃ phalaṃ. // // ",
  "tha-ap524:4.1": "Kilesā . . . ",
  "tha-ap524:4.2": "pe . . . ",
  "tha-ap524:4.3": "",
  "tha-ap524:5.1": "",
  "tha-ap524:5.2": "pe . . . ",
  "tha-ap524:5.3": "pe . . . // // Sāgataṃ . . . pe . . . pe . . . pe . . . // // ",
  "tha-ap524:6.1": "Paṭisambhidā . . . ",
  "tha-ap524:6.2": "pe . . . ",
  "tha-ap524:6.3": "pe . . . pe . . . // // ",
  "tha-ap524:7.1": "Itthaṃ sudaṃ āyasmā Pecchadyako thero i. g. a-ti. Pecchadāyakattherassa apadānaṃ samattaṃ. ",
  "tha-ap524:8.1": ""
}
