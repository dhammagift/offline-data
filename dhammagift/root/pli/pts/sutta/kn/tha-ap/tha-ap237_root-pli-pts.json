  "tha-ap237:0.3": "",
  "tha-ap237:1.1": "Vipassino bhagavato ",
  "tha-ap237:1.2": "bodhiyā pāda-m-uttame / ",
  "tha-ap237:1.3": "pasannacitto sumano ",
  "tha-ap237:1.4": "kāresiṃ vedikam ahaṃ. // // ",
  "tha-ap237:2.1": "Ekanavute ito kappe ",
  "tha-ap237:2.2": "kāresiṃ vedikam ahaṃ / ",
  "tha-ap237:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap237:2.4": "Buddhapūjāy' idaṃ phalaṃ. // // ",
  "tha-ap237:3.1": "Ito ekādase kappe ",
  "tha-ap237:3.2": "ahosiṃ Sūriyassamo / ",
  "tha-ap237:3.3": "sattaratanasampanno ",
  "tha-ap237:3.4": "cakkavattī mahabbalo. // // ",
  "tha-ap237:4.1": "Paṭisambhidā . . . ",
  "tha-ap237:4.2": "pe . . . ",
  "tha-ap237:4.3": "pe . . . // // ",
  "tha-ap237:5.1": "Itthaṃ sudam āyasmā Vediyadāyako thero i. g. a-ti. Vediyadāyakattherassa ",
  "tha-ap237:6.1": "apadānaṃ samattaṃ. "
}
