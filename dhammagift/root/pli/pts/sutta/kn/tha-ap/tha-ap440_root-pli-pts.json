  "tha-ap440:1.1": "Harīṭakaṃ āmalakaṃ ",
  "tha-ap440:1.2": "amba-jambu-vibhīṭakaṃ / ",
  "tha-ap440:1.3": "kolaṃ bhallātakaṃ bellaṃ sayam ",
  "tha-ap440:1.4": "ev' āharām' ahaṃ. // // ",
  "tha-ap440:2.1": "Disvāna pabbhāragataṃ ",
  "tha-ap440:2.2": "jhāyiṃ jhānarataṃ muniṃ / ",
  "tha-ap440:2.3": "ābādhena papīḷentaṃ ",
  "tha-ap440:2.4": "adutiyaṃ mahāmuniṃ. // // ",
  "tha-ap440:3.1": "Harīṭakaṃ gahetvāna ",
  "tha-ap440:3.2": "sayambhussa adās ahaṃ / ",
  "tha-ap440:3.3": "khādamattamhi bhesajje ",
  "tha-ap440:3.4": "vyādhi passambhi tāvade. // // ",
  "tha-ap440:4.1": "Pahīnadaratho Buddho ",
  "tha-ap440:4.2": "anumodaniyaṃ akā: / ",
  "tha-ap440:4.3": "‘Bhesajjadānen' iminā ",
  "tha-ap440:4.4": "vyādhivupasamena ca // // ",
  "tha-ap440:5.1": "Devabhūto manusso vā ",
  "tha-ap440:5.2": "jāto vā aññajātiyā / ",
  "tha-ap440:5.3": "sabbattha sukhito hohi ",
  "tha-ap440:5.4": "mā ca te vyādhi āgamā.' // // ",
  "tha-ap440:6.1": "Idaṃ vatvāna sambuddho ",
  "tha-ap440:6.2": "sayambhu aparājito / ",
  "tha-ap440:6.3": "nabhaṃ abbhuggamī vīro ",
  "tha-ap440:6.4": "haṃsarājā va ambare. // // ",
  "tha-ap440:7.1": "Yato harīṭakam adaṃ ",
  "tha-ap440:7.2": "sayambhussa mahesino / ",
  "tha-ap440:7.3": "imaṃ jātiṃ upādāya ",
  "tha-ap440:7.4": "vyādhi me n' upapajjatha. // // ",
  "tha-ap440:8.1": "Ayaṃ pacchimako mayhaṃ ",
  "tha-ap440:8.2": "carimo vattate bhavo / ",
  "tha-ap440:8.3": "tisso vijjā sacchikatā ",
  "tha-ap440:8.4": "kataṃ Buddhassa sāsanaṃ. // // ",
  "tha-ap440:9.1": "Catunavute ito kappe ",
  "tha-ap440:9.2": "bhesajjam adadiṃ tadā / ",
  "tha-ap440:9.3": "duggatiṃ nābhijānāmi ",
  "tha-ap440:9.4": "bhesajjassa idaṃ phalaṃ. // // ",
  "tha-ap440:10.1": "Kilesā . . . ",
  "tha-ap440:10.2": "pe . . . ",
  "tha-ap440:10.3": "",
  "tha-ap440:11.1": "",
  "tha-ap440:11.2": "pe . . . ",
  "tha-ap440:11.3": "pe . . . // // Sāgataṃ . . . pe . . . pe . . . pe . . . // // ",
  "tha-ap440:12.1": "Paṭisambhidā . . . ",
  "tha-ap440:12.2": "pe . . . ",
  "tha-ap440:12.3": "pe . . . pe . . . // // ",
  "tha-ap440:13.1": "Itthaṃ sudam āyasmā Harīṭakadāyako thero i. g. a-ti. Harīṭakadāyakattherassa ",
  "tha-ap440:14.1": "apadānaṃ samattaṃ. "
}
