  "tha-ap143:1.1": "Parinibbute bhagavati ",
  "tha-ap143:1.2": "Atthadassi-naruttame / ",
  "tha-ap143:1.3": "chattādhichattaṃ karetvā ",
  "tha-ap143:1.4": "thūpamhi abhiropayiṃ. // // ",
  "tha-ap143:2.1": "Kālena kālaṃ āgantvā ",
  "tha-ap143:2.2": "namassiṃ lokanāyakaṃ / ",
  "tha-ap143:2.3": "pupphacchadanaṃ katvāna ",
  "tha-ap143:2.4": "chattamhi abhiropayiṃ. // // ",
  "tha-ap143:3.1": "Sattarase kappasate ",
  "tha-ap143:3.2": "devarajjam akārayiṃ. / ",
  "tha-ap143:3.3": "manussattaṃ na gacchāmi ",
  "tha-ap143:3.4": "thūpapūjāy' idaṃ phalaṃ. // // ",
  "tha-ap143:4.1": "Paṭisambhidā . . . pe . . . ",
  "tha-ap143:4.2": "",
  "tha-ap143:4.3": "pe . . . // // ",
  "tha-ap143:4.4": "",
  "tha-ap143:5.1": "Itthaṃ sudaṃ āyasmā Adhicchattiyo thero i. g. a-ti. Adhicchatiyattherassa apadānaṃ samattaṃ. ",
  "tha-ap143:6.1": ""
}
