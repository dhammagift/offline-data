  "tha-ap234:0.2": "",
  "tha-ap234:0.3": "",
  "tha-ap234:1.1": "Nagare Bandhumatiyā ",
  "tha-ap234:1.2": "kumbhakāro ahaṃ tadā / ",
  "tha-ap234:1.3": "bhājanaṃ anupālesiṃ ",
  "tha-ap234:1.4": "bhikkhusaṅghassa tāvade. // // ",
  "tha-ap234:2.1": "Ekūnavute ito kappe ",
  "tha-ap234:2.2": "bhājanaṃ anupālayiṃ / ",
  "tha-ap234:2.3": "duggatiṃ nābhijānami ",
  "tha-ap234:2.4": "bhājanass' idaṃ phalaṃ // // ",
  "tha-ap234:3.1": "Te-paññāse ito kappe ",
  "tha-ap234:3.2": "Anantajāli-nāmako / ",
  "tha-ap234:3.3": "sattaratanasampanno ",
  "tha-ap234:3.4": "cakkavattī mahābalo. // // ",
  "tha-ap234:4.1": "Paṭisambhidā . . . ",
  "tha-ap234:4.2": "pe . . . // // ",
  "tha-ap234:4.3": "",
  "tha-ap234:5.1": "Itthaṃ sudaṃ āyasmā Bhājanadāyako thero i. g. a-ti. Bhājanadāyakattherassa ",
  "tha-ap234:6.1": "apadānaṃ samattaṃ. "
}
