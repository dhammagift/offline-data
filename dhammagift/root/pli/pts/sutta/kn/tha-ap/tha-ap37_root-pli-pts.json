{
  "tha-ap37:0.1": "",
  "tha-ap37:0.2": "",
  "tha-ap37:0.3": "",
  "tha-ap37:1.1": "Atthadassī tu bhagavā ",
  "tha-ap37:1.2": "sayambhū aparājito / ",
  "tha-ap37:1.3": "bhikkhusaṅghaparibbūḷho ",
  "tha-ap37:1.4": "rathiyaṃ paṭipajjatha. // // ",
  "tha-ap37:2.1": "Sissehi samparivuto ",
  "tha-ap37:2.2": "gharamhā abhinikkhamiṃ / ",
  "tha-ap37:2.3": "nikkhamitvān' ahaṃ tattha ",
  "tha-ap37:2.4": "addasaṃ lokanāyakaṃ. // // ",
  "tha-ap37:3.1": "Abhivādetvāna sambuddhaṃ ",
  "tha-ap37:3.2": "sire katvāna añjaliṃ / ",
  "tha-ap37:3.3": "sakaṃ cittaṃ pasādetvā ",
  "tha-ap37:3.4": "santhaviṃ lokanāyakaṃ. // // ",
  "tha-ap37:4.1": "Yāvatā rūpino sattā ",
  "tha-ap37:4.2": "arūpī vā asaññino / ",
  "tha-ap37:4.3": "sabbe te tava ñaṇamhi ",
  "tha-ap37:4.4": "anto honti samāhaṭā. // // Sumacchikena ",
  "tha-ap37:5.1": "jālena ",
  "tha-ap37:5.2": "udakaṃ yo parikkhipe / ",
  "tha-ap37:5.3": "ye keci udake pāṇā ",
  "tha-ap37:5.4": "antojāle bhavanti te. // // ",
  "tha-ap37:6.1": "Yesañ ca cetanā atthi ",
  "tha-ap37:6.2": "*rūpi*no ca arūpino / ",
  "tha-ap37:6.3": "sabbe te tava ñāṇamhi ",
  "tha-ap37:6.4": "anto honti samāhaṭā. // // ",
  "tha-ap37:7.1": "Samuddharas' imaṃ lokaṃ ",
  "tha-ap37:7.2": "andhakārasamākulaṃ / ",
  "tha-ap37:7.3": "tava dhammaṃ suṇitvāna ",
  "tha-ap37:7.4": "kaṅkhāsotaṃ taranti te. // // ",
  "tha-ap37:8.1": "Avijjānivuto loko ",
  "tha-ap37:8.2": "andhakārena otthaṭo / ",
  "tha-ap37:8.3": "*tava ñāṇamhi* jotante ",
  "tha-ap37:8.4": "andhakārā padhaṃsitā. // // ",
  "tha-ap37:9.1": "Tuvaṃ cakkhu 'si sabbesaṃ ",
  "tha-ap37:9.2": "mahātamapanūdano / ",
  "tha-ap37:9.3": "tava dhammaṃ suṇitvāna ",
  "tha-ap37:9.4": "nibbāyati bahujjano. // // ",
  "tha-ap37:10.1": "Piṭharaṃ pūrayitvāna ",
  "tha-ap37:10.2": "madhukhuddaṃ aneḷakaṃ / ",
  "tha-ap37:10.3": "ubhohatthehi paggayha ",
  "tha-ap37:10.4": "upanesiṃ mahesi*no.* // // ",
  "tha-ap37:11.1": "*Paṭigaṇhi* mahāvīro ",
  "tha-ap37:11.2": "subhakena mahāisi / ",
  "tha-ap37:11.3": "bhuñjitvā tañ ca sabbaññū ",
  "tha-ap37:11.4": "vehāsan nabham uggami. // // ",
  "tha-ap37:12.1": "Antalikkhe ṭhito satthā ",
  "tha-ap37:12.2": "Atthadassī narāsabho / ",
  "tha-ap37:12.3": "mama cittaṃ pasādento ",
  "tha-ap37:12.4": "imā gāthā abhāsathā: // // ",
  "tha-ap37:13.1": "Yen' idaṃ thavitaṃ ñā*naṃ ",
  "tha-ap37:13.2": "buddhaseṭṭho ca* thomito / ",
  "tha-ap37:13.3": "tena cittappasādena ",
  "tha-ap37:13.4": "duggatiṃ so na gacchati. // // ",
  "tha-ap37:14.1": "Catuddasañ ca khattuṃ so ",
  "tha-ap37:14.2": "devarajjaṃ karissati / ",
  "tha-ap37:14.3": "padesarajjaṭṭhasataṃ ",
  "tha-ap37:14.4": "vasudhaṃ āvasissati. // // ",
  "tha-ap37:15.1": "Pañc' eva satakkhattuñ ca ",
  "tha-ap37:15.2": "cakkavattī bhavissati / ",
  "tha-ap37:15.3": "padesa*rajjaṃ asaṅkheyaṃ ",
  "tha-ap37:15.4": "mahiyā* kārayissati. // // ",
  "tha-ap37:16.1": "Ajjhāyako mantadharo ",
  "tha-ap37:16.2": "tiṇṇaṃ vedāna pāragū / ",
  "tha-ap37:16.3": "Gotamassa bhagavato ",
  "tha-ap37:16.4": "sāsane pabbajissati. // // ",
  "tha-ap37:17.1": "Gambhīraṃ nipuṇaṃ atthaṃ ",
  "tha-ap37:17.2": "ñāṇena vicinissati / ",
  "tha-ap37:17.3": "Mogharājā ti nāmena ",
  "tha-ap37:17.4": "hessati *satthu sāvako* // // ",
  "tha-ap37:18.1": "Tīhi vijjāhi sampanno katakicco ",
  "tha-ap37:18.2": "anāsavo / ",
  "tha-ap37:18.3": "Gotamo satthavāhaggo ",
  "tha-ap37:18.4": "etadagge ṭhapessati. // // ",
  "tha-ap37:19.1": "Hitvā mānusakaṃ yogaṃ ",
  "tha-ap37:19.2": "chetvāna bhavabandhanaṃ / ",
  "tha-ap37:19.3": "sabbāsave pariññāya ",
  "tha-ap37:19.4": "viharāmi anāsavo. // // ",
  "tha-ap37:20.1": "Paṭisambhidā catasso ",
  "tha-ap37:20.2": "vimokhā pi ca aṭṭh' ime / chaḍabhiññā sacchikatā ",
  "tha-ap37:20.3": "kataṃ Buddhassa sāsanan ti. // // ",
  "tha-ap37:21.1": "Itthaṃ sudaṃ āyasmā Mogharājā thero imā gāthāyo abhāsitthā ti. Mogharājattherassa apadānaṃ samattaṃ. ",
  "tha-ap37:22.1": ""
}
