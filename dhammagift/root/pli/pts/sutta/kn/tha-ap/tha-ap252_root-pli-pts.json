  "tha-ap252:0.3": "",
  "tha-ap252:1.1": "nāma nāmena ",
  "tha-ap252:1.2": "sayambhū aparājito / ",
  "tha-ap252:1.3": "pavanā nikkhamitvāna ",
  "tha-ap252:1.4": "anuppatto mahānadiṃ. // // ",
  "tha-ap252:2.1": "Uddālakaṃ gahetvāna ",
  "tha-ap252:2.2": "sayambhussa adās' ahaṃ / saṃyatass' ",
  "tha-ap252:2.3": "ujjubhūtassa ",
  "tha-ap252:2.4": "pasannamānaso ahaṃ. // // ",
  "tha-ap252:3.1": "Ekatiṃse ito kappe ",
  "tha-ap252:3.2": "yaṃ puppham abhipūjayiṃ / ",
  "tha-ap252:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap252:3.4": "pupphadānass' idaṃ phalaṃ. // // ",
  "tha-ap252:4.1": "Paṭisambhidā . . . ",
  "tha-ap252:4.2": "pe . . . ",
  "tha-ap252:4.3": "pe . . . // // ",
  "tha-ap252:5.1": "Itthaṃ sudam āyasmā Uddāladāyako thero i. g. a-ti. Uddāladāyakattherassa apadānaṃ ",
  "tha-ap252:6.1": "",
  "tha-ap252:7.1": "samattaṃ. Uddānaṃ: Tuvaraṃ- ",
  "tha-ap252:8.1": "Nāga- ",
  "tha-ap252:9.1": "Nalinā ",
  "tha-ap252:9.2": "Virava-Kuṭidhūpako ",
  "tha-ap252:9.3": "Patto-Dhātu-Pāṭaliyo ",
  "tha-ap252:9.4": "Bimbi-Uddālakena ",
  "tha-ap252:9.5": "sattatiṃsati gāthāyo ",
  "tha-ap252:9.6": "gaṇitāyo vibhāvihi. Tuvaradāyavaggo pañcavīsatimo. "
}
