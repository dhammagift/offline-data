  "tha-ap123:0.2": "",
  "tha-ap123:0.3": "",
  "tha-ap123:1.1": "Ajjhāyako mantadharo ",
  "tha-ap123:1.2": "tiṇṇaṃ vedāna-pāragū / ",
  "tha-ap123:1.3": "abbhokāse ṭṭhito santo ",
  "tha-ap123:1.4": "addasaṃ lokanāyakaṃ // // ",
  "tha-ap123:2.1": "Sīhaṃ yathā vanacaraṃ ",
  "tha-ap123:2.2": "vyaggharājaṃ va nittasaṃ / ",
  "tha-ap123:2.3": "tidhāppabhinnaṃ mātaṅgaṃ ",
  "tha-ap123:2.4": "kuñjaraṃ va mahesinaṃ. // // ",
  "tha-ap123:3.1": "Sereyyakaṃ gahetvāna ",
  "tha-ap123:3.2": "ākāse ukkhipiṃ ahaṃ / ",
  "tha-ap123:3.3": "Buddhassa ānubhāvena ",
  "tha-ap123:3.4": "parivārentu sabbato. // // ",
  "tha-ap123:4.1": "Adhiṭṭhāsi mahāvīro ",
  "tha-ap123:4.2": "sabbaññū lokanāyako / ",
  "tha-ap123:4.3": "samantā pupphachadanaṃ ",
  "tha-ap123:4.4": "okiriṃsu narāsabhaṃ. // // ",
  "tha-ap123:5.1": "Tato sapupphakañcukā ",
  "tha-ap123:5.2": "antovaṇṭā bahimukhā / ",
  "tha-ap123:5.3": "sattāhaṃ chadanaṃ katvā ",
  "tha-ap123:5.4": "tato antaradhāyatha. // // ",
  "tha-ap123:6.1": "Tañ ca acchariyaṃ disvā ",
  "tha-ap123:6.2": "abbhutaṃ lomahaṃsanaṃ / ",
  "tha-ap123:6.3": "Buddhe cittaṃ pasādesiṃ ",
  "tha-ap123:6.4": "sugate lokanāyake. // // ",
  "tha-ap123:7.1": "Tena cittappasādena ",
  "tha-ap123:7.2": "sukkamūlena codito / ",
  "tha-ap123:7.3": "kappānaṃ satasahassaṃ ",
  "tha-ap123:7.4": "duggatiṃ nūpapajj' ahaṃ. // // ",
  "tha-ap123:8.1": "Pannarasasahassamhi ",
  "tha-ap123:8.2": "kappānaṃ pañc' ahiṃsu ",
  "tha-ap123:8.3": "te / Cīnamālā-sanāmā ca ",
  "tha-ap123:8.4": "cakkavattī mahābalā. // // ",
  "tha-ap123:9.1": "Paṭisambhidā catasso ",
  "tha-ap123:9.2": "vimokhā pi ca aṭṭh' ime / ",
  "tha-ap123:9.3": "chaḍabhiññā sacchikatā ",
  "tha-ap123:9.4": "kataṃ Buddhassa sāsanan ti. // // ",
  "tha-ap123:10.1": "Itthaṃ sudaṃ āyasmā Sereyyako thero īmā gāthāyo abhāsitthā ti. Sereyyakattherassa ",
  "tha-ap123:11.1": "apadānaṃ samattaṃ. Himavantass' avidūre "
}
