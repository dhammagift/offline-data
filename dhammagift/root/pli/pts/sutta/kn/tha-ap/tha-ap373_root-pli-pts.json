  "tha-ap373:0.1": "",
  "tha-ap373:0.2": "",
  "tha-ap373:0.3": "",
  "tha-ap373:1.1": "Pāṭaliṃ haritaṃ disvā ",
  "tha-ap373:1.2": "pādapaṃ dharaṇīruhaṃ / ",
  "tha-ap373:1.3": "ekaṃsam añjaliṃ katvā ",
  "tha-ap373:1.4": "avandiṃ pāṭalim ahaṃ. // // ",
  "tha-ap373:2.1": "Añjaliṃ paggahetvāna ",
  "tha-ap373:2.2": "garuṃ katvāna mānasaṃ / ",
  "tha-ap373:2.3": "antosuddhaṃ bahiṃ suddhaṃ ",
  "tha-ap373:2.4": "suvimuttam anāsavaṃ // // ",
  "tha-ap373:3.1": "Vipassiṃ lokamahitaṃ ",
  "tha-ap373:3.2": "karuṇāñāṇasāgaraṃ / ",
  "tha-ap373:3.3": "sammukhā viya *sam*buddham ",
  "tha-ap373:3.4": "avandiṃ pāṭalim ahaṃ. // // ",
  "tha-ap373:4.1": "Ekanavut' ito kappe ",
  "tha-ap373:4.2": "yaṃ bodhim abhivand' ahaṃ / ",
  "tha-ap373:4.3": "duggatiṃ nābhijānāmi ",
  "tha-ap373:4.4": "vandanāya idaṃ phalaṃ. // // ",
  "tha-ap373:5.1": "Paṭisambhidā . . . pe . . . ",
  "tha-ap373:5.2": "",
  "tha-ap373:5.3": "pe . . . // // ",
  "tha-ap373:5.4": "",
  "tha-ap373:6.1": "Itthaṃ sudam āyasmā Bodhivandako thero i. g. a-ti. Bodhivandakattherassa ",
  "tha-ap373:7.1": "apadānaṃ samattaṃ. "
}
