  "tha-ap118:0.1": "",
  "tha-ap118:0.2": "",
  "tha-ap118:0.3": "",
  "tha-ap118:1.1": "Vasāmi rājāyatane ",
  "tha-ap118:1.2": "sāmacco saparijjano / ",
  "tha-ap118:1.3": "parinibbute bhagavati ",
  "tha-ap118:1.4": "Sikhine lokabandhune. // // ",
  "tha-ap118:2.1": "Pasannacitto sumano ",
  "tha-ap118:2.2": "citakaṃ agamās' ahaṃ / ",
  "tha-ap118:2.3": "turiyaṃ tattha vādetvā ",
  "tha-ap118:2.4": "gandhamālaṃ samokiriṃ. // // ",
  "tha-ap118:3.1": "Citakamhi pūjaṃ katvā ",
  "tha-ap118:3.2": "vanditvā citakaṃ ahaṃ / ",
  "tha-ap118:3.3": "pasannacitto sumano ",
  "tha-ap118:3.4": "sakaṃ bhava' upāgamiṃ. // // ",
  "tha-ap118:4.1": "Bhavane upaviṭṭho 'haṃ ",
  "tha-ap118:4.2": "citakapūjaṃ anussariṃ / ",
  "tha-ap118:4.3": "tena kammena dipadinda ",
  "tha-ap118:4.4": "lokajeṭṭha narāsabha // // ",
  "tha-ap118:5.1": "Anubhotvāna sampattiṃ ",
  "tha-ap118:5.2": "devesu manujesu ca / ",
  "tha-ap118:5.3": "patto 'mhi acalaṭṭhānaṃ ",
  "tha-ap118:5.4": "hitvā jayaparājayaṃ. // // ",
  "tha-ap118:6.1": "Ekatiṃse ito kappe ",
  "tha-ap118:6.2": "yaṃ puppham abhiropayiṃ / ",
  "tha-ap118:6.3": "duggatiṃ nābhijānāmi ",
  "tha-ap118:6.4": "citakapūjāy' idaṃ phalaṃ. // // ",
  "tha-ap118:7.1": "Ekūnatiṃse kappamhi ",
  "tha-ap118:7.2": "ito soḷasa rājino / ",
  "tha-ap118:7.3": "Uggatā nāma nāmena ",
  "tha-ap118:7.4": "cakkavattī mahābalā. // // ",
  "tha-ap118:8.1": "Paṭisambhidā catasso ",
  "tha-ap118:8.2": "vimokhā pi ca aṭṭh' ime / chaḍabhiññā sacchikatā ",
  "tha-ap118:8.3": "kataṃ Buddhassa sāsanan ti. // // ",
  "tha-ap118:9.1": "Itthaṃ sudaṃ āyasmā Citakapūjako thero imā gāthāyo abhāsitthā ti. ",
  "tha-ap118:10.1": "Citakapūjakattherassa apadānaṃ samattaṃ. "
}
