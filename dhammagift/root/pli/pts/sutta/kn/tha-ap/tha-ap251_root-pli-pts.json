  "tha-ap251:1.1": "Padumuttaro nāma jino ",
  "tha-ap251:1.2": "sayambhū aggapuggalo / ",
  "tha-ap251:1.3": "catusaccaṃ pakāseti ",
  "tha-ap251:1.4": "deseti amataṃ padaṃ. // // ",
  "tha-ap251:2.1": "Bimbijālikapupphāni ",
  "tha-ap251:2.2": "puthu katvān' ahaṃ tadā / ",
  "tha-ap251:2.3": "Buddhassa abhiropesiṃ ",
  "tha-ap251:2.4": "dipadindassa tādino. // // ",
  "tha-ap251:3.1": "Aṭṭhasaṭṭhimh' ito kappe ",
  "tha-ap251:3.2": "caturo Kiñjakesarā / ",
  "tha-ap251:3.3": "sattaratanasampannā ",
  "tha-ap251:3.4": "cakkavattī mahabbalā. // // ",
  "tha-ap251:4.1": "Paṭisambhidā . . . ",
  "tha-ap251:4.2": "pe . . . ",
  "tha-ap251:4.3": "pe . . . // // ",
  "tha-ap251:5.1": "Itthaṃ sudam āyasmā Bimbijāliyo thero i. g. a-ti. Bimbijāliyattherassa apadānaṃ samattaṃ. Kakuddho ",
  "tha-ap251:6.1": ""
}
