  "tha-ap233:1.1": "Ārāmadvārā nikkhamma ",
  "tha-ap233:1.2": "phalakaṃ santhariṃ ahaṃ / ",
  "tha-ap233:1.3": "udakañ ca upaṭṭhāsiṃ ",
  "tha-ap233:1.4": "uttamatthassa pattiyā. // // ",
  "tha-ap233:2.1": "Ekatiṃse ito kappe ",
  "tha-ap233:2.2": "yaṃ kammaṃ akariṃ tadā / ",
  "tha-ap233:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap233:2.4": "āsane c' odake phalaṃ. // // ",
  "tha-ap233:3.1": "Ito pannarase kappe ",
  "tha-ap233:3.2": "Abhisāma-samavhayo / ",
  "tha-ap233:3.3": "sattaratanasampanno ",
  "tha-ap233:3.4": "cakkavattī mahabbalo. // // ",
  "tha-ap233:4.1": "Paṭisambhidā . . . pe . . . ",
  "tha-ap233:4.2": "",
  "tha-ap233:4.3": "pe . . . // // ",
  "tha-ap233:4.4": "",
  "tha-ap233:5.1": "Itthaṃ sudaṃ āyasmā Udakāsanadāyako thero i. g. a-ti. Udakāsanadāyakattherassa apadānaṃ samattaṃ. ",
  "tha-ap233:6.1": ""
}
