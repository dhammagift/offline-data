  "tha-ap420:0.3": "",
  "tha-ap420:1.1": "Atithiṃ me gahetvāna ",
  "tha-ap420:1.2": "āgacchiṃ gāmakam tadā / ",
  "tha-ap420:1.3": "sampuṇṇa-nadikaṃ disvā ",
  "tha-ap420:1.4": "saṅghārāmam upāgamiṃ. // // ",
  "tha-ap420:2.1": "Āraññakā dhūtavādā ",
  "tha-ap420:2.2": "jhāyino lukhacīvarā / ",
  "tha-ap420:2.3": "vivekābhiratā dhīrā ",
  "tha-ap420:2.4": "saṅghārāme vasanti te. // // ",
  "tha-ap420:3.1": "Gati tesam upacchinnā ",
  "tha-ap420:3.2": "suvimuttāna tādinaṃ / ",
  "tha-ap420:3.3": "piṇḍāya te na gacchanti ",
  "tha-ap420:3.4": "oruddhanadikā yadi. // // ",
  "tha-ap420:4.1": "Pasannacitto sumano ",
  "tha-ap420:4.2": "vedajāto katañjalī / ",
  "tha-ap420:4.3": "taṇḍulam me gahetvāna ",
  "tha-ap420:4.4": "yāgudānam akās' ahaṃ. // // ",
  "tha-ap420:5.1": "Pañcannaṃ yāguṃ datvāna ",
  "tha-ap420:5.2": "pasanno sehi pāṇihi / ",
  "tha-ap420:5.3": "sakakammābhiraddho 'haṃ ",
  "tha-ap420:5.4": "Tāvatiṃsam agacch' ahaṃ. // // ",
  "tha-ap420:6.1": "Maṇimayañ ca me vyamhaṃ ",
  "tha-ap420:6.2": "nibbattan Tidase gaṇe / ",
  "tha-ap420:6.3": "nārīgaṇehi sahito ",
  "tha-ap420:6.4": "modāmi vyamha-m-uttame. // // ",
  "tha-ap420:7.1": "Tettiṃsakkhattuṃ devindo ",
  "tha-ap420:7.2": "devarajjam akārayiṃ / ",
  "tha-ap420:7.3": "tiṃsakkhattuṃ cakkavattī ",
  "tha-ap420:7.4": "mahārajjam akārayiṃ. // // ",
  "tha-ap420:8.1": "Padesarajjaṃ vipulaṃ ",
  "tha-ap420:8.2": "gaṇanāto asaṅkhiyaṃ / ",
  "tha-ap420:8.3": "devaloke manusse vā ",
  "tha-ap420:8.4": "anubhotvā yasam ahaṃ. // // ",
  "tha-ap420:9.1": "Pacchime bhave sampatte ",
  "tha-ap420:9.2": "pabbajim anagāriyaṃ / ",
  "tha-ap420:9.3": "saha oropite kese ",
  "tha-ap420:9.4": "sabbasampattivijjh' ahaṃ. // // ",
  "tha-ap420:10.1": "Khayato vayato cāpi ",
  "tha-ap420:10.2": "sammasanto kalebaraṃ / ",
  "tha-ap420:10.3": "*pure si* kkhāpadādāne ",
  "tha-ap420:10.4": "arahattam apāpuṇiṃ. // // ",
  "tha-ap420:11.1": "Sudinnam me dānavaraṃ ",
  "tha-ap420:11.2": "vānijjaṃ suppayojitaṃ / ",
  "tha-ap420:11.3": "ten' eva yāgudānena ",
  "tha-ap420:11.4": "patto 'mhi acalaṃ padaṃ. // // ",
  "tha-ap420:12.1": "Sokaṃ pariddavaṃ vyādhiṃ ",
  "tha-ap420:12.2": "darathaṃ cittatāpanaṃ / ",
  "tha-ap420:12.3": "nābhijānāmi uppannaṃ ",
  "tha-ap420:12.4": "yāgudānass' idaṃ phalaṃ. // // ",
  "tha-ap420:13.1": "Yāguṃ saṅghassa datvāna ",
  "tha-ap420:13.2": "puññakkhette anuttare / ",
  "tha-ap420:13.3": "pañcānisaṃse anubhom' ",
  "tha-ap420:13.4": "aho yāgu-suyiṭṭhatā. // // ",
  "tha-ap420:14.1": "Avyādhitā rūpavatā ",
  "tha-ap420:14.2": "khippaṃ dhammanisantitā / ",
  "tha-ap420:14.3": "lābhitā annapānassa ",
  "tha-ap420:14.4": "āyu pañcamakaṃ mama. // // ",
  "tha-ap420:15.1": "Yo koci vedaṃ janayaṃ ",
  "tha-ap420:15.2": "saṃghe yāguṃ *dadey*ya so / ",
  "tha-ap420:15.3": "imāni pañcaṭhānāni ",
  "tha-ap420:15.4": "patigaṇheyya paṇḍito. // // ",
  "tha-ap420:16.1": "Karaṇīyaṃ kataṃ sabbaṃ ",
  "tha-ap420:16.2": "bhavā ugghāṭitā mayā / ",
  "tha-ap420:16.3": "sabbāsavaparikkhīṇo ",
  "tha-ap420:16.4": "n' atthi dāni punabbhavo. // // ",
  "tha-ap420:17.1": "So haṃ vicarissāmi ",
  "tha-ap420:17.2": "gāmā gāmaṃ purā puraṃ / ",
  "tha-ap420:17.3": "namassamāno sambuddhaṃ ",
  "tha-ap420:17.4": "dhammassa ca sudhammataṃ. // // ",
  "tha-ap420:18.1": "Tiṃsakappasahassāni ",
  "tha-ap420:18.2": "yaṃ dānam adadiṃ tadā / ",
  "tha-ap420:18.3": "duggatiṃ nābhijānāmi ",
  "tha-ap420:18.4": "yāgudānass' idaṃ phalaṃ. // // ",
  "tha-ap420:19.1": "Kilesā . . . ",
  "tha-ap420:19.2": "pe . . . ",
  "tha-ap420:19.3": "",
  "tha-ap420:20.1": "",
  "tha-ap420:20.2": "pe . . . // // ",
  "tha-ap420:20.3": "Sāgataṃ . . . pe . . . pe . . . pe . . . // // ",
  "tha-ap420:21.1": "Paṭisambhidā . . . ",
  "tha-ap420:21.2": "pe . . . ",
  "tha-ap420:21.3": "pe . . . // // ",
  "tha-ap420:22.1": "Itthaṃ sudam āyasmā Yāgudāyako thero i. g. a-ti. Yāgudāyakattherassa apadānaṃ samattaṃ. ",
  "tha-ap420:23.1": ""
}
