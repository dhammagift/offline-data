  "tha-ap169:1.1": "Candabhāgānadītīre ",
  "tha-ap169:1.2": "anusotaṃ vajām' ahaṃ / ",
  "tha-ap169:1.3": "sayambhum addasaṃ tattha ",
  "tha-ap169:1.4": "sālarājaṃ va pupphitaṃ. // // ",
  "tha-ap169:2.1": "Pupphaṃ yūthikam ādāya ",
  "tha-ap169:2.2": "upagacchiṃ mahāmuniṃ / ",
  "tha-ap169:2.3": "pasannacitto sumano ",
  "tha-ap169:2.4": "Buddhassa abhiropayiṃ. // // ",
  "tha-ap169:3.1": "Catunavute ito kappe ",
  "tha-ap169:3.2": "yaṃ puppham abhipūjayiṃ / ",
  "tha-ap169:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap169:3.4": "Buddhapūjāy' idaṃ phalaṃ // // ",
  "tha-ap169:4.1": "Sattasaṭṭhi ito kappe ",
  "tha-ap169:4.2": "eko Samuddharo ahu / ",
  "tha-ap169:4.3": "sattaratanasampanno ",
  "tha-ap169:4.4": "cakkavattī mahabbalo. // // ",
  "tha-ap169:5.1": "Paṭisambhidā . . . ",
  "tha-ap169:5.2": "pe . . . ",
  "tha-ap169:5.3": "pe . . . // // ",
  "tha-ap169:6.1": "Itthaṃ sudaṃ ā. Yūthikapupphiyo thero i. g. ā-ti. Yūthikapupphiyattherassa ",
  "tha-ap169:7.1": "apadānaṃ samattaṃ. "
}
