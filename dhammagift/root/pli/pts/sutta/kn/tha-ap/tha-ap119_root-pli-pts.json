  "tha-ap119:0.3": "",
  "tha-ap119:1.1": "Yadā Vipassilokaggo ",
  "tha-ap119:1.2": "āyusaṅkhāram ossaji / ",
  "tha-ap119:1.3": "paṭhavī sampakampittha ",
  "tha-ap119:1.4": "medinī-jalamekhalā. // // ",
  "tha-ap119:2.1": "Otataṃ vitataṃ mayhaṃ ",
  "tha-ap119:2.2": "suvicittaṃ vaṭaṃsakaṃ / ",
  "tha-ap119:2.3": "bhavanam pi pakampittha ",
  "tha-ap119:2.4": "Buddhassa āyusaṅkhaye. // // ",
  "tha-ap119:3.1": "Tāso mayhaṃ samuppanno ",
  "tha-ap119:3.2": "bhavane sampakampite / ",
  "tha-ap119:3.3": "uppādo nu kim atthāya ",
  "tha-ap119:3.4": "āloko vipulo ahu. // // ",
  "tha-ap119:4.1": "Vessavaṇṇo idhāgamma ",
  "tha-ap119:4.2": "nibbāpesi mahājanaṃ / ",
  "tha-ap119:4.3": "‘pāṇabhūtaṃ bhayaṃ n' atthi; ",
  "tha-ap119:4.4": "ekaggā hotha saṃvutā.' // // ",
  "tha-ap119:5.1": "Aho Buddhā aho dhammā ",
  "tha-ap119:5.2": "aho no satthu sampadā / ",
  "tha-ap119:5.3": "yasmiṃ uppajjamānasmiṃ ",
  "tha-ap119:5.4": "paṭhavī sampakampati. // // ",
  "tha-ap119:6.1": "Buddhānubhāvaṃ kittetvā ",
  "tha-ap119:6.2": "kappaṃ saggamhi mod' ahaṃ. / ",
  "tha-ap119:6.3": "avasesesu kappesu ",
  "tha-ap119:6.4": "kusalaṃ kāritaṃ mayā. // // ",
  "tha-ap119:7.1": "Ekanavute ito kappe ",
  "tha-ap119:7.2": "yaṃ saññam alabhiṃ tadā / ",
  "tha-ap119:7.3": "duggatiṃ nābhijānāmi ",
  "tha-ap119:7.4": "Buddhasaññāy' idaṃ phalaṃ. // // ",
  "tha-ap119:8.1": "Ito cuddasakappamhi ",
  "tha-ap119:8.2": "rājā āsiṃ patāpavā / ",
  "tha-ap119:8.3": "Samito nāma nāmena ",
  "tha-ap119:8.4": "cakkavattī mahābalo. // // ",
  "tha-ap119:9.1": "Paṭisambhidā catasso ",
  "tha-ap119:9.2": "vimokhā pi ca aṭṭh' ime / chaḍabhiññā sacchikatā ",
  "tha-ap119:9.3": "kataṃ Buddhassa sāsanan ti. // // ",
  "tha-ap119:10.1": "Itthaṃ sudaṃ āyasmā Buddhasaññako thero imā gāthāyo abhāsitthā ti. Buddhasaññakattherassa apadānaṃ samattaṃ. ",
  "tha-ap119:11.1": ""
}
