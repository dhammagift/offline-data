  "tha-ap200:1.1": "Sumedho nāma bhagavā ",
  "tha-ap200:1.2": "lokajeṭṭho narāsabho / ",
  "tha-ap200:1.3": "pacchime anukampāya ",
  "tha-ap200:1.4": "padhānaṃ padahī jino. // // ",
  "tha-ap200:2.1": "Tassa ca kampamānassa ",
  "tha-ap200:2.2": "dipadindassa tādino / ",
  "tha-ap200:2.3": "girinelassa pupphānaṃ ",
  "tha-ap200:2.4": "muṭṭhiṃ Buddhass' aropayiṃ // // ",
  "tha-ap200:3.1": "Tena cittappasādena ",
  "tha-ap200:3.2": "sukkamūlena codito / ",
  "tha-ap200:3.3": "tiṃsakappasahassāni ",
  "tha-ap200:3.4": "duggatiṃ nūpapajj' ahaṃ. // // ",
  "tha-ap200:4.1": "Tevīsatikappasate ",
  "tha-ap200:4.2": "Sunelo nāma khattiyo / ",
  "tha-ap200:4.3": "sattaratanasampanno ",
  "tha-ap200:4.4": "eko āsi mahabbalo. // // ",
  "tha-ap200:5.1": "Paṭisambhidā . . . ",
  "tha-ap200:5.2": "pe . . . ",
  "tha-ap200:5.3": "pe . . . // // ",
  "tha-ap200:6.1": "Itthaṃ sudam āyasmā Muṭṭhipūjako thero i. g. a-ti. Muṭṭhipūjakattherassa apadānaṃ samattaṃ. Sumaṅgalo ti ",
  "tha-ap200:7.1": ""
}
