  "tha-ap454:1.1": "Morahatthaṃ gahetvāna ",
  "tha-ap454:1.2": "upesiṃ lokanāyakaṃ / ",
  "tha-ap454:1.3": "pasannacitto sumano ",
  "tha-ap454:1.4": "morahattham adās' ahaṃ. // // ",
  "tha-ap454:2.1": "Iminā morahatthena ",
  "tha-ap454:2.2": "cetanāpaṇidhīhi ca / ",
  "tha-ap454:2.3": "nibbanti me tayo aggī ",
  "tha-ap454:2.4": "labhāmi vipulaṃ sukhaṃ. // // ",
  "tha-ap454:3.1": "Aho Buddhā aho dhammā ",
  "tha-ap454:3.2": "aho no satthu sampadā / ",
  "tha-ap454:3.3": "datvān' ahaṃ morahatthaṃ ",
  "tha-ap454:3.4": "labhāmi vipulaṃ sukhaṃ. // // ",
  "tha-ap454:4.1": "Tivaggī nibbutā mayhaṃ ",
  "tha-ap454:4.2": "bhavā sabbe samūhatā / ",
  "tha-ap454:4.3": "sabbāsavā parikkhīṇā ",
  "tha-ap454:4.4": "n' atthi dāni punabbhavo. // // ",
  "tha-ap454:5.1": "Ekatiṃse ito kappe ",
  "tha-ap454:5.2": "yaṃ dānam adadiṃ tadā / ",
  "tha-ap454:5.3": "duggatiṃ nābhijānāmi ",
  "tha-ap454:5.4": "morahatthass' idaṃ phalaṃ. // // ",
  "tha-ap454:6.1": "Kilesā . . . ",
  "tha-ap454:6.2": "pe . . . ",
  "tha-ap454:6.3": "",
  "tha-ap454:7.1": "",
  "tha-ap454:7.2": "pe . . . ",
  "tha-ap454:7.3": "pe . . . // // Sāgataṃ . . . pe . . . pe . . . pe . . . // // ",
  "tha-ap454:8.1": "Paṭisambhidā . . . ",
  "tha-ap454:8.2": "pe . . . ",
  "tha-ap454:8.3": "pe . . . pe . . . // // ",
  "tha-ap454:9.1": "Itthaṃ sudaṃ āyasmā Morahatthiyo thero i. g. a-ti. Morahatthiyattherassa apadānaṃ samattaṃ. ",
  "tha-ap454:10.1": ""
}
