  "tha-ap224:1.1": "ito kappe ",
  "tha-ap224:1.2": "gaṇasantharako ahaṃ / ",
  "tha-ap224:1.3": "addasaṃ virajaṃ Buddham ",
  "tha-ap224:1.4": "āhutīnaṃ paṭiggahaṃ. // // ",
  "tha-ap224:2.1": "cammakhaṇḍaṃ mayā dinnaṃ ",
  "tha-ap224:2.2": "Sikhino lokabandhuno / ",
  "tha-ap224:2.3": "tena kammena dipadinda ",
  "tha-ap224:2.4": "lokajeṭṭha narāsabha // // ",
  "tha-ap224:3.1": "Sampattim anubhotvāna ",
  "tha-ap224:3.2": "kilese jhāpayim ahaṃ / ",
  "tha-ap224:3.3": "dhāremi antimaṃ dehaṃ ",
  "tha-ap224:3.4": "sammāsambuddhasāsane. // // ",
  "tha-ap224:4.1": "Ekatiṃse ito kappe ",
  "tha-ap224:4.2": "ajinaṃ yam adās' ahaṃ / ",
  "tha-ap224:4.3": "duggatiṃ nābhijānāmi ",
  "tha-ap224:4.4": "ajinassa idaṃ phalaṃ. // // ",
  "tha-ap224:5.1": "Ito *pañcamake* kappe ",
  "tha-ap224:5.2": "rājā āsi Sudāyako / ",
  "tha-ap224:5.3": "sattaratanasampanno ",
  "tha-ap224:5.4": "cakkavattī mahabbalo. // // ",
  "tha-ap224:6.1": "Paṭisambhidā . . . ",
  "tha-ap224:6.2": "pe . . . ",
  "tha-ap224:6.3": "pe . . . // // ",
  "tha-ap224:7.1": "Itthaṃ sudam āyasmā Ajinadāyako thero i. g. a-ti. Ajinadāyakattherassa apadānaṃ samattaṃ. ",
  "tha-ap224:8.1": ""
}
