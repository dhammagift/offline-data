{
  "tha-ap124:0.1": "",
  "tha-ap124:0.2": "",
  "tha-ap124:0.3": "",
  "tha-ap124:1.1": "",
  "tha-ap124:1.2": "Kukkuro nāma pabbato / ",
  "tha-ap124:1.3": "vemajjhe tassa vasati ",
  "tha-ap124:1.4": "brāhmaṇo mantapāragū. // // ",
  "tha-ap124:2.1": "Pañcasissasahassāni ",
  "tha-ap124:2.2": "parivārent' imaṃ sadā / ",
  "tha-ap124:2.3": "pubbuṭṭhāyī ca te āsuṃ ",
  "tha-ap124:2.4": "mantesu ca visāradā. // // ",
  "tha-ap124:3.1": "Buddho loke samuppanno, ",
  "tha-ap124:3.2": "taṃ vijānātha no bhavaṃ / ",
  "tha-ap124:3.3": "asītiṃvyañjanā nassa ",
  "tha-ap124:3.4": "battiṃsavaralakkhaṇā / ",
  "tha-ap124:4.1": "vyāmappabhājinavaro ",
  "tha-ap124:4.2": "ādicco va virocati. // // ",
  "tha-ap124:4.3": "Sissānaṃ vacanaṃ sutvā ",
  "tha-ap124:4.4": "brāhmaṇo mantapāragū / ",
  "tha-ap124:5.1": "assamā abhinikkhamma ",
  "tha-ap124:5.2": "disaṃ pucchati brāhmaṇo / ",
  "tha-ap124:5.3": "yamhi dese mahāvīro ",
  "tha-ap124:5.4": "vasati lokanāyako? // // ",
  "tha-ap124:6.1": "Na hi disvāna passissaṃ ",
  "tha-ap124:6.2": "jinaṃ appaṭipuggalaṃ. / ",
  "tha-ap124:6.3": "udaggacitto sumano ",
  "tha-ap124:6.4": "pūjessañ ca Tathāgataṃ. // // ",
  "tha-ap124:7.1": "Etha sissā gamissāma ",
  "tha-ap124:7.2": "dakkhissāma Tathāgataṃ / ",
  "tha-ap124:7.3": "vanditvā satthuno pāde ",
  "tha-ap124:7.4": "sossāma jinasāsanaṃ. // // ",
  "tha-ap124:8.1": "Ekāhaṃ abhinikkhamma ",
  "tha-ap124:8.2": "vyādhiṃ paṭilabhim ahaṃ / ",
  "tha-ap124:8.3": "vyādhinā pīḷito santo ",
  "tha-ap124:8.4": "sālaṃ ve sayituṃ gamiṃ. // // ",
  "tha-ap124:9.1": "Sabbe sisse samānetvā ",
  "tha-ap124:9.2": "apucchiṃ te tathā ahaṃ / ",
  "tha-ap124:9.3": "kīdisaṃ lokanāthassa ",
  "tha-ap124:9.4": "guṇaṃ paramabuddhino. // // ",
  "tha-ap124:10.1": "Te me puṭṭhā viyākaṃsu ",
  "tha-ap124:10.2": "yathā dassāvino tathā / ",
  "tha-ap124:10.3": "*kukkuṭṭhaṃ Buddha*seṭṭhaṃ taṃ ",
  "tha-ap124:10.4": "dassesuṃ mama sammukhā. // // ",
  "tha-ap124:11.1": "Tesāhaṃ vacanaṃ sutvā ",
  "tha-ap124:11.2": "sakaṃ cittaṃ pasādayiṃ / ",
  "tha-ap124:11.3": "pupphehi thūpaṃ katvāna ",
  "tha-ap124:11.4": "tattha kālakato ahaṃ. // // ",
  "tha-ap124:12.1": "Te me sarīraṃ jhāpetvā ",
  "tha-ap124:12.2": "āgamaṃsu Buddhasantike / ",
  "tha-ap124:12.3": "añjaliṃ paggahetvāna ",
  "tha-ap124:12.4": "satthāraṃ abhivādayuṃ. // // ",
  "tha-ap124:13.1": "*Pupphehi thū*paṃ katvāna ",
  "tha-ap124:13.2": "sugatassa mahesino / ",
  "tha-ap124:13.3": "kappānaṃ satasahassaṃ ",
  "tha-ap124:13.4": "duggatiṃ nūpapajj' ahaṃ. // // ",
  "tha-ap124:14.1": "Cattārisatasahassamhi ",
  "tha-ap124:14.2": "kappe solasa khattiyā / ",
  "tha-ap124:14.3": "nāmen' Aggisamā nāmā ",
  "tha-ap124:14.4": "cakkavattī mahābalā. // // Vīse ",
  "tha-ap124:15.1": "kappasahassamhi ",
  "tha-ap124:15.2": "rājāno cakkavattino / ",
  "tha-ap124:15.3": "Ghatāsana-sanāmā ",
  "tha-ap124:15.4": "ca aṭṭhatiṃsa mahīpatī. // // ",
  "tha-ap124:16.1": "Paṭisambhidā catasso ",
  "tha-ap124:16.2": "vimokhā pi ca aṭṭh' ime / chaḍabhiññā sacchikatā ",
  "tha-ap124:16.3": "kataṃ Buddhassa sāsanan ti. // // ",
  "tha-ap124:17.1": "Itthaṃ sudaṃ āyasmā Pupphathupiyo thero imā gāthāyo abhāsitthāti. ",
  "tha-ap124:18.1": "Pupphathupiyattherassa apadānaṃ samattaṃ. Suvaṇṇavaṇṇaṃ sambuddhaṃ dvattiṃsavaralakkhaṇaṃ / "
}
