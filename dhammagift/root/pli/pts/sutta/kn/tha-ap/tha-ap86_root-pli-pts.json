  "tha-ap86:0.1": "",
  "tha-ap86:0.2": "",
  "tha-ap86:0.3": "",
  "tha-ap86:1.1": "Abhibhū nāma so bhikkhu ",
  "tha-ap86:1.2": "Sikhino aggasāvako / ",
  "tha-ap86:1.3": "mahānubhāvo tevijjo ",
  "tha-ap86:1.4": "Himavantaṃ upāgami. // // ",
  "tha-ap86:2.1": "Aham pi Himavantamhi ",
  "tha-ap86:2.2": "ramanīy' assame isi / ",
  "tha-ap86:2.3": "vasāmi appamaññāsu ",
  "tha-ap86:2.4": "iddhīsu ca tadā vasī. // // ",
  "tha-ap86:3.1": "Pakkhī jāto viy' ākāse ",
  "tha-ap86:3.2": "pabbataṃ abhipatthayiṃ / ",
  "tha-ap86:3.3": "adho pupphaṃ gahetvāna ",
  "tha-ap86:3.4": "āgañchiṃ pabbataṃ ahaṃ. // // ",
  "tha-ap86:4.1": "Sattapupphāni gaṇhitvā ",
  "tha-ap86:4.2": "matthake okiriṃ ahaṃ / ",
  "tha-ap86:4.3": "ālokito ca vīrena ",
  "tha-ap86:4.4": "pakkāmiṃ pācināmukho. // // ",
  "tha-ap86:5.1": "Āvāsam abhisambhosiṃ ",
  "tha-ap86:5.2": "patvāna assamaṃ ahaṃ / ",
  "tha-ap86:5.3": "khāribhāraṃ gahetvāna ",
  "tha-ap86:5.4": "pāvisiṃ pabbatantaraṃ. // // ",
  "tha-ap86:6.1": "Ajagaro maṃ pīḷesi ",
  "tha-ap86:6.2": "ghorarūpo mahabbalo / ",
  "tha-ap86:6.3": "pubbakammaṃ saritvāna ",
  "tha-ap86:6.4": "tattha kālakato ahaṃ. // // ",
  "tha-ap86:7.1": "Ekatiṃse ito kappe ",
  "tha-ap86:7.2": "yaṃ puppham abhiropayiṃ / ",
  "tha-ap86:7.3": "duggatiṃ nābhijānāmi ",
  "tha-ap86:7.4": "pupphapūjāy' idaṃ phalaṃ. // // ",
  "tha-ap86:8.1": "Paṭisambhidā catasso ",
  "tha-ap86:8.2": "vimokhā pi ca aṭṭh' ime / chaḍabhiññā sacchikatā ",
  "tha-ap86:8.3": "kataṃ Buddhassa sāsanan ti. // // ",
  "tha-ap86:9.1": "Itthaṃ sudaṃ āyasmā Adhopupphiyo thero imā gāthāyo abhāsitthā ti. Adhopupphiyattherassa apadānaṃ samattaṃ. ",
  "tha-ap86:10.1": ""
}
