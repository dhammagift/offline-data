  "tha-ap367:1.1": "Padumo nāma sambuddho ",
  "tha-ap367:1.2": "Cittakūṭe vasī tadā / ",
  "tha-ap367:1.3": "disvāna tam ahaṃ Buddhaṃ ",
  "tha-ap367:1.4": "sayambhum upagacchi 'haṃ. // // ",
  "tha-ap367:2.1": "Aṅkolaṃ pupphitaṃ disvā ",
  "tha-ap367:2.2": "ocinitvān' ahan tadā / ",
  "tha-ap367:2.3": "upagantvāna sambuddhaṃ ",
  "tha-ap367:2.4": "pūjesiṃ Padumaṃ jinaṃ. // // ",
  "tha-ap367:3.1": "Ekatiṃse ito kappe ",
  "tha-ap367:3.2": "yaṃ puppham abhipūjayiṃ / ",
  "tha-ap367:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap367:3.4": "Buddhapūjāy' idaṃ phalaṃ. // // ",
  "tha-ap367:4.1": "Paṭisambhidā . . . ",
  "tha-ap367:4.2": "pe . . . ",
  "tha-ap367:4.3": "pe . . . // // ",
  "tha-ap367:5.1": "Itthaṃ sudam āyasmā Aṅkolapupphiyo thero i. g. a-ti. Aṅkolapupphiyattherassa apadānaṃ samattaṃ. ",
  "tha-ap367:6.1": ""
}
