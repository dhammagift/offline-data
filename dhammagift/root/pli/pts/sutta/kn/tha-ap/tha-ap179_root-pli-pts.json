  "tha-ap179:1.1": "Padumuttarassa munino ",
  "tha-ap179:1.2": "salaḷe bodhi-m-uttame / ",
  "tha-ap179:1.3": "pasannaci*tto sumano ",
  "tha-ap179:1.4": "ekaṃ dīp*aṃ adās' ahaṃ. // // ",
  "tha-ap179:2.1": "Bhave nibbattamānamhi ",
  "tha-ap179:2.2": "nibbatte puññasañcaye / ",
  "tha-ap179:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap179:2.4": "dīpadānass' idaṃ phalaṃ. // // ",
  "tha-ap179:3.1": "Solase kappasahasse ",
  "tha-ap179:3.2": "'to 'me caturo janā / ",
  "tha-ap179:3.3": "Candābhā nāma nāmena ",
  "tha-ap179:3.4": "cakkavattī *mahābalā.* // // ",
  "tha-ap179:4.1": "Paṭisambhidā . . . ",
  "tha-ap179:4.2": "pe . . . ",
  "tha-ap179:4.3": "pe . . . // // ",
  "tha-ap179:5.1": "Itthaṃ sudaṃ āyasmā Ekadīpiyo thero i. g. a- ",
  "tha-ap179:6.1": "ti. Ekadīpiyattherassa ",
  "tha-ap179:6.2": "apadānaṃ samattaṃ. "
}
