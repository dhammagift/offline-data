  "tha-ap71:0.2": "",
  "tha-ap71:0.3": "",
  "tha-ap71:1.1": "Sumano nāma nāmena ",
  "tha-ap71:1.2": "mālākāro ahaṃ tadā / ",
  "tha-ap71:1.3": "addasaṃ virajaṃ Buddhaṃ ",
  "tha-ap71:1.4": "āhutīnaṃ paṭiggahaṃ. // // ",
  "tha-ap71:2.1": "Ubbo hatthehi paggayha ",
  "tha-ap71:2.2": "sumanaṃ pupphamuttamaṃ / ",
  "tha-ap71:2.3": "Buddhassa abhiropesiṃ ",
  "tha-ap71:2.4": "Sikhino lokabandhuno. // // ",
  "tha-ap71:3.1": "Imāya pupphapūjāya ",
  "tha-ap71:3.2": "cetanāpaṇidhīhi ca / ",
  "tha-ap71:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap71:3.4": "Buddhapūjāy' idaṃ phalaṃ. // // ",
  "tha-ap71:4.1": "Ekatiṃse ito kappe ",
  "tha-ap71:4.2": "yaṃ puppham abhiropayiṃ / ",
  "tha-ap71:4.3": "duggatiṃ nābhijānāmi ",
  "tha-ap71:4.4": "Buddhapūjāy' idaṃ phalaṃ. // // ",
  "tha-ap71:5.1": "Chabbīsatimhi kappamhi ",
  "tha-ap71:5.2": "cattār' assu mahāyasā / ",
  "tha-ap71:5.3": "sattaratanasampannā ",
  "tha-ap71:5.4": "rājāno cakkavattino. // // ",
  "tha-ap71:6.1": "Paṭisambhidā catasso ",
  "tha-ap71:6.2": "vimokhā pi ca aṭṭh' ime / chaḷabhiññā sacchikatā ",
  "tha-ap71:6.3": "kataṃ Buddhassa sāsanan ti. // // ",
  "tha-ap71:7.1": "Itthaṃ sudaṃ āyasmā Sumano thero imā gāthāyo abhāsitthā ti. ",
  "tha-ap71:8.1": "Sumanattherassa apadānaṃ samattaṃ. "
}
