  "tha-ap59:1.1": "Padumuttarabuddhassa ",
  "tha-ap59:1.2": "sabbabhūtānukampino / ",
  "tha-ap59:1.3": "susaṇṭhahitvā saddhamme ",
  "tha-ap59:1.4": "ujudiṭṭhi ahos' ahaṃ. // // ",
  "tha-ap59:2.1": "Padīpadānam pādā*siṃ ",
  "tha-ap59:2.2": "parivāre*tvāna bodhiyaṃ / ",
  "tha-ap59:2.3": "saddahanto padīpāni ",
  "tha-ap59:2.4": "akariṃ tāvade ahaṃ. // // ",
  "tha-ap59:3.1": "Yaṃ yaṃ yonupapajjāmi ",
  "tha-ap59:3.2": "devattaṃ atha mānusaṃ / ",
  "tha-ap59:3.3": "ākāse ukkaṃ dhārento ",
  "tha-ap59:3.4": "dīpadānass' idaṃ phalaṃ. // // ",
  "tha-ap59:4.1": "Tirokuḍḍaṃ tiroselaṃ ",
  "tha-ap59:4.2": "*samati*ggayha pabbataṃ / ",
  "tha-ap59:4.3": "samantā yojanasataṃ ",
  "tha-ap59:4.4": "dassanaṃ anubhom' ahaṃ. // // ",
  "tha-ap59:5.1": "Tena kammāvasesena ",
  "tha-ap59:5.2": "patto' mhi āsavakkhayaṃ / ",
  "tha-ap59:5.3": "dhāremi antimaṃ dehaṃ ",
  "tha-ap59:5.4": "dipadindassa sāsane. // // ",
  "tha-ap59:6.1": "Catuttiṃse kappasate ",
  "tha-ap59:6.2": "Satacakkhu-sanāmakā / ",
  "tha-ap59:6.3": "rājā 'hesuṃ mahātejā ",
  "tha-ap59:6.4": "cakkavattī mahābalā. // // ",
  "tha-ap59:7.1": "Paṭisambhidā catasso ",
  "tha-ap59:7.2": "vimokhā pi ca aṭṭh' ime / chaḷabhiññā sacchikatā ",
  "tha-ap59:7.3": "kataṃ Buddhassa sāsanan ti. // // ",
  "tha-ap59:8.1": "Itthaṃ sudaṃ āyasmā Pañcadīpiko thero imā gāthāyo abhāsitthā ti. Pañcadīpikatherassa apadānaṃ samattaṃ. ",
  "tha-ap59:9.1": ""
}
