  "tha-ap368:1.1": "Suvaṇṇavaṇṇaṃ sambuddhaṃ ",
  "tha-ap368:1.2": "gacchantam antarāpaṇe / ",
  "tha-ap368:1.3": "kañcanagghiyasaṅkāsaṃ ",
  "tha-ap368:1.4": "battiṃsavarakkhaṇaṃ // // ",
  "tha-ap368:2.1": "Nisajja pāsādavare ",
  "tha-ap368:2.2": "addasaṃ lokanāyakaṃ / ",
  "tha-ap368:2.3": "kadambapupphaṃ paggayha ",
  "tha-ap368:2.4": "Vipassim abhipūjayiṃ. // // ",
  "tha-ap368:3.1": "Ekanavute ito kappe ",
  "tha-ap368:3.2": "yaṃ puppham abhipūjayiṃ / ",
  "tha-ap368:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap368:3.4": "Buddhapūjāy' idaṃ phalaṃ. // // ",
  "tha-ap368:4.1": "Paṭisambhidā . . . ",
  "tha-ap368:4.2": "pe . . . ",
  "tha-ap368:4.3": "pe . . . // // ",
  "tha-ap368:5.1": "Itthaṃ sudam āyasmā Kadambapupphiyo th. i. g. a-ti. Kadambapupphiyattherassa ",
  "tha-ap368:6.1": "apadānaṃ samattaṃ. Anātho "
}
