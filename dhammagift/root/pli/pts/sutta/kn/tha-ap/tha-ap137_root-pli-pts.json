  "tha-ap137:0.3": "",
  "tha-ap137:1.1": "",
  "tha-ap137:1.2": "Vasabho nāma pabbato / ",
  "tha-ap137:1.3": "tasmiṃ pabbatapādamhi ",
  "tha-ap137:1.4": "assamo āsi māpito. // // ",
  "tha-ap137:2.1": "Tīṇi vassasahassāni ",
  "tha-ap137:2.2": "vācesi brāhmaṇo tadā / ",
  "tha-ap137:2.3": "saṃsāvetvāna te sisse ",
  "tha-ap137:2.4": "ekamantaṃ upāvisi. // // ",
  "tha-ap137:3.1": "Ekamantaṃ nisīditvā ",
  "tha-ap137:3.2": "brāhmaṇo mantapāragū / ",
  "tha-ap137:3.3": "Buddhavesaṃ gavesanto ",
  "tha-ap137:3.4": "ñāṇe cittaṃ pasādayi. // // ",
  "tha-ap137:4.1": "Tattha cittaṃ pasādetvā ",
  "tha-ap137:4.2": "nisīdi paṇṇasanthare / ",
  "tha-ap137:4.3": "pallaṅkam ābhujitvāna ",
  "tha-ap137:4.4": "tattha kālakato ahaṃ. // // ",
  "tha-ap137:5.1": "Ekatiṃse ito kappe ",
  "tha-ap137:5.2": "yaṃ saññam alabhiṃ tadā / ",
  "tha-ap137:5.3": "duggatiṃ nābhijānāmi ",
  "tha-ap137:5.4": "ñāṇasaññāy' idaṃ phalaṃ. // // ",
  "tha-ap137:6.1": "Sattavīsamhi kappamhi ",
  "tha-ap137:6.2": "rājā Siridharo ahu / ",
  "tha-ap137:6.3": "sattaratanasampanno ",
  "tha-ap137:6.4": "cakkavattī mahābalo. // // ",
  "tha-ap137:7.1": "Paṭisambhidā . . . ",
  "tha-ap137:7.2": "pe . . . ",
  "tha-ap137:7.3": "pe . . . // // ",
  "tha-ap137:8.1": "Itthaṃ sudaṃ āyasmā Rahosaññako thero i. g. a-ti. Rahosaññakattherassa apadānaṃ samattaṃ. Kaṇikāraṃ va ",
  "tha-ap137:9.1": ""
}
