  "tha-ap480:1.1": "Sumano nāma sambuddho ",
  "tha-ap480:1.2": "Takkarāya vasī tadā / ",
  "tha-ap480:1.3": "vallikaraphalaṃ gayha ",
  "tha-ap480:1.4": "sayambhussa adās' ahaṃ. // // ",
  "tha-ap480:2.1": "Ekatiṃse ito kappe ",
  "tha-ap480:2.2": "yaṃ phalaṃ adadiṃ tadā / ",
  "tha-ap480:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap480:2.4": "phalānass' idaṃ phalaṃ. // // ",
  "tha-ap480:3.1": "Kilesā . . . ",
  "tha-ap480:3.2": "pe . . . ",
  "tha-ap480:3.3": "",
  "tha-ap480:4.1": "",
  "tha-ap480:4.2": "pe . . . ",
  "tha-ap480:4.3": "pe . . . // // Sāgataṃ . . . pe . . . pe . . . pe . . . // // ",
  "tha-ap480:5.1": "Paṭisambhidā . . . ",
  "tha-ap480:5.2": "pe . . . ",
  "tha-ap480:5.3": "pe . . . pe . . . // // ",
  "tha-ap480:6.1": "Itthaṃ sudaṃ āyasmā Vallikaraphaladāyako th. i. g. a-ti. Vallikaraphaladāyakattherassa apadānaṃ samattaṃ. ",
  "tha-ap480:7.1": ""
}
