  "tha-ap470:1.1": "Buddhaṃ disvāna ",
  "tha-ap470:1.2": "Atthadassiṃ mahāyasaṃ / ",
  "tha-ap470:1.3": "pasannacitto sumano ",
  "tha-ap470:1.4": "pilakkhussa phalaṃ adaṃ. // // ",
  "tha-ap470:2.1": "Aṭṭhārase kappasate ",
  "tha-ap470:2.2": "yaṃ phalam adadiṃ tadā / ",
  "tha-ap470:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap470:2.4": "phaladānass' idaṃ phalaṃ. // // ",
  "tha-ap470:3.1": "Kilesā . . . ",
  "tha-ap470:3.2": "pe . . . ",
  "tha-ap470:3.3": "",
  "tha-ap470:4.1": "",
  "tha-ap470:4.2": "pe . . . ",
  "tha-ap470:4.3": "pe . . . // // Sāgataṃ . . . pe . . . pe . . . pe . . . // // ",
  "tha-ap470:5.1": "Paṭisambhidā . . . ",
  "tha-ap470:5.2": "pe . . . ",
  "tha-ap470:5.3": "pe . . . pe . . . // // ",
  "tha-ap470:6.1": "Itthaṃ sudam āyasmā Pilakkhuphaladāyako th. i. g. a-ti. Pilakkhuphaladāyakattherassa ",
  "tha-ap470:7.1": "apadānaṃ samattaṃ. "
}
