  "tha-ap68:0.1": "",
  "tha-ap68:0.2": "",
  "tha-ap68:0.3": "",
  "tha-ap68:1.1": "Giriduggacaro āsiṃ ",
  "tha-ap68:1.2": "abhijāto va kesarī / ",
  "tha-ap68:1.3": "migasaṅghaṃ vadhitvāna ",
  "tha-ap68:1.4": "jīvāmi pabbatantare. // // ",
  "tha-ap68:2.1": "Atthadassī tu bhagavā ",
  "tha-ap68:2.2": "sabbaññū vadataṃ varo / ",
  "tha-ap68:2.3": "mam uddharitukāmo so ",
  "tha-ap68:2.4": "āgañchi pabbatuttamaṃ. // // ",
  "tha-ap68:3.1": "Pasadañ ca migaṃ hantvā ",
  "tha-ap68:3.2": "bhakkhetuṃ samupāgamiṃ / ",
  "tha-ap68:3.3": "bhagavā tamhi samaye ",
  "tha-ap68:3.4": "bhikkhayāno upāgami. // // ",
  "tha-ap68:4.1": "Varamaṃsāni paggayha ",
  "tha-ap68:4.2": "adāsiṃ tassa satthuno / ",
  "tha-ap68:4.3": "anumodī mahāvīro ",
  "tha-ap68:4.4": "nibbāpento mamaṃ tadā. // // ",
  "tha-ap68:5.1": "Tena cittappasādena ",
  "tha-ap68:5.2": "giriduggappavekkh' ahaṃ / ",
  "tha-ap68:5.3": "pītiṃ uppādayitvāna ",
  "tha-ap68:5.4": "tattha kālakato ahaṃ. // // ",
  "tha-ap68:6.1": "Etena maṃsadānena ",
  "tha-ap68:6.2": "cittassa paṇidhīhi ca / ",
  "tha-ap68:6.3": "paṇṇarase kappasate ",
  "tha-ap68:6.4": "devaloke ramiṃ ahaṃ. // // ",
  "tha-ap68:7.1": "Avasesesu kappesu ",
  "tha-ap68:7.2": "kusalaṃ kāritaṃ mayā / ",
  "tha-ap68:7.3": "ten' eva maṃsadānena ",
  "tha-ap68:7.4": "Buddhānussaraṇena ca. // // ",
  "tha-ap68:8.1": "Aṭṭhatiṃsamhi kappamhi ",
  "tha-ap68:8.2": "aṭṭha Dīghāyunāmakā / ",
  "tha-ap68:8.3": "satthimh' ito kappasate ",
  "tha-ap68:8.4": "duve Varuṇanāmakā. // // ",
  "tha-ap68:9.1": "Paṭisambhidā catasso ",
  "tha-ap68:9.2": "vimokhā pi ca aṭṭh' ime / chaḷabhiññā sacchikatā ",
  "tha-ap68:9.3": "kataṃ Buddhassa sāsanaṃ ti. // // ",
  "tha-ap68:10.1": "Itthaṃ sudaṃ āyasmā Sucintito thero imā gāthāyo abhāsitthā ti. Sucintitatherassa ",
  "tha-ap68:11.1": "apadānaṃ samattaṃ. Pakkhī jāto "
}
