  "tha-ap273:0.3": "",
  "tha-ap273:1.1": "Ekāsanam aham adaṃ ",
  "tha-ap273:1.2": "pasanno sehi pāṇihi / ",
  "tha-ap273:1.3": "bibbohanañ ca pādāsim ",
  "tha-ap273:1.4": "uttamatthassa pattiyā. // // ",
  "tha-ap273:2.1": "Ekanavute ito kappe ",
  "tha-ap273:2.2": "bibbohanam adās' ahaṃ / ",
  "tha-ap273:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap273:2.4": "bibbohanass' idaṃ phalaṃ. // // ",
  "tha-ap273:3.1": "Ito tesaṭṭhime kappe ",
  "tha-ap273:3.2": "Asamo nāma khattiyo / ",
  "tha-ap273:3.3": "sattaratanasampanno ",
  "tha-ap273:3.4": "cakkavattī mahabbalo. // // ",
  "tha-ap273:4.1": "Paṭisambhidā . . . pe . . . ",
  "tha-ap273:4.2": "",
  "tha-ap273:4.3": "pe . . . // // ",
  "tha-ap273:4.4": "",
  "tha-ap273:5.1": "Itthaṃ sudam āyasmā Suvaṇṇabibbohaniyo thero i. g. a-ti. Suvaṇṇabibbohaniyattherassa ",
  "tha-ap273:6.1": "apadānaṃ samattaṃ. "
}
