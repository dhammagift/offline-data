{
  "tha-ap112:0.1": "",
  "tha-ap112:0.2": "",
  "tha-ap112:0.3": "",
  "tha-ap112:1.1": "Suvaṇṇavaṇṇaṃ sambuddhaṃ ",
  "tha-ap112:1.2": "sataraṃsīva bhānumaṃ / ",
  "tha-ap112:1.3": "obhāsentaṃ disā sabbā ",
  "tha-ap112:1.4": "uḷurājaṃ va pūrītaṃ // // ",
  "tha-ap112:2.1": "Purakkh*ataṃ sāvakehi ",
  "tha-ap112:2.2": "sāgareneva medinī / ",
  "tha-ap112:2.3": "nāgaṃ pa*ggayha reṇūhi ",
  "tha-ap112:2.4": "Vipassissābhiropayiṃ. // // ",
  "tha-ap112:3.1": "Ekanavute ito kappe ",
  "tha-ap112:3.2": "yaṃ reṇum abhiropayiṃ / ",
  "tha-ap112:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap112:3.4": "Buddhapūjāy' idaṃ phalaṃ. // // ",
  "tha-ap112:4.1": "Paṇṇatālīs' ito *kappe ",
  "tha-ap112:4.2": "Reṇu-nām' āsi khattiyo / ",
  "tha-ap112:4.3": "sattaratana*sampanno ",
  "tha-ap112:4.4": "cakkavattī mahābalo. // // ",
  "tha-ap112:5.1": "Paṭisambhidā catasso ",
  "tha-ap112:5.2": "vimokhā pi ca aṭṭh' ime / chaḍabhiññā sacchikatā ",
  "tha-ap112:5.3": "kataṃ Buddhassa sāsanan ti. // // ",
  "tha-ap112:6.1": "Itthaṃ sudaṃ āyasmā Reṇupūjakothero imā gāthāyo abhāsitthāti. Reṇupūjakattherassa apadānaṃ samattaṃ. Uddānaṃ: ",
  "tha-ap112:7.1": "",
  "tha-ap112:8.1": "",
  "tha-ap112:9.1": "",
  "tha-ap112:10.1": "Bhikkhadāyī Ñāṇaṃsaññī ",
  "tha-ap112:10.2": "Hatthiyo Padapūjako ",
  "tha-ap112:10.3": "Muṭṭhipupphī Udakado ",
  "tha-ap112:10.4": "Naḷamālī Nivāsako ",
  "tha-ap112:10.5": "Biḷālidāyī Reṇu ca ",
  "tha-ap112:10.6": "gāthāyo cha ca saṭṭhi ca "
}
