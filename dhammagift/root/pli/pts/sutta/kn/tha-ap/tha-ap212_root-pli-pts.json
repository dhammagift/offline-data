{
  "tha-ap212:0.1": "",
  "tha-ap212:0.2": "",
  "tha-ap212:0.3": "",
  "tha-ap212:1.1": "bhagavato ",
  "tha-ap212:1.2": "devadevassa tādino / ",
  "tha-ap212:1.3": "ekachattaṃ mayā dinnaṃ ",
  "tha-ap212:1.4": "vippasannena cetasā. // // ",
  "tha-ap212:2.1": "Nivutaṃ hoti me pāpaṃ ",
  "tha-ap212:2.2": "kusalass' upasampadā / ",
  "tha-ap212:2.3": "ākāse chattaṃ dhārenti ",
  "tha-ap212:2.4": "pubbakammass' idaṃ phalaṃ. // // ",
  "tha-ap212:3.1": "Carimaṃ vattate mayhaṃ ",
  "tha-ap212:3.2": "bhavā sabbe samūhatā / ",
  "tha-ap212:3.3": "dhāremi antimaṃ dehaṃ ",
  "tha-ap212:3.4": "sammāsambuddhasāsane. // // ",
  "tha-ap212:4.1": "Dvenavute ito kappe ",
  "tha-ap212:4.2": "yaṃ chattam adadiṃ tadā / ",
  "tha-ap212:4.3": "duggatiṃ nābhijānāmi ",
  "tha-ap212:4.4": "chattadānass' idaṃ phalaṃ. // // ",
  "tha-ap212:5.1": "Dvesattati ito kappe ",
  "tha-ap212:5.2": "aṭṭh' āsiṃsu janādhipā / ",
  "tha-ap212:5.3": "Mahānidāna-nāmena ",
  "tha-ap212:5.4": "rājāno cakkavattino. // // ",
  "tha-ap212:6.1": "Paṭisambhidā . . . ",
  "tha-ap212:6.2": "pe . . . ",
  "tha-ap212:6.3": "pe . . . // // ",
  "tha-ap212:7.1": "Itthaṃ sudam āyasmā Vātātapanivāriyo thero i. g. a- ti. Vātātapanivāriyattherassa ",
  "tha-ap212:8.1": "",
  "tha-ap212:9.1": "apadānaṃ samattaṃ. ",
  "tha-ap212:10.1": "Uddānaṃ: ",
  "tha-ap212:11.1": "Kaṇikāro Vinelañ ca ",
  "tha-ap212:11.2": "Kiṅkinī-Taraṇena ca ",
  "tha-ap212:11.3": "Nigguṇḍipupphaṃ 'dakado ",
  "tha-ap212:11.4": "Salaḷo ca Koraṇḍako ",
  "tha-ap212:11.5": "Ādhāraka-Vātātapa ",
  "tha-ap212:11.6": "aṭṭhatālisa gāthakā. Kaṇikārapupphiyavaggo ekūnavīsatimo. "
}
