  "tha-ap283:1.1": "Paṇṇasāle nisinno 'mhi ",
  "tha-ap283:1.2": "paṇṇabhojanabhojano / ",
  "tha-ap283:1.3": "upaviṭṭhañ ca maṃ santam ",
  "tha-ap283:1.4": "upagacchi mahāisi // // ",
  "tha-ap283:2.1": "Siddhattho lokapajjoto ",
  "tha-ap283:2.2": "sabbalokatikicchako / ",
  "tha-ap283:2.3": "tassa paṇṇaṃ mayā dinnaṃ ",
  "tha-ap283:2.4": "nisinnassa paṇṇasanthare. // // ",
  "tha-ap283:3.1": "Catunavute ito kappe ",
  "tha-ap283:3.2": "yaṃ paṇṇam adadiṃ tadā / ",
  "tha-ap283:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap283:3.4": "paṇṇadānass' idaṃ phalaṃ. // // ",
  "tha-ap283:4.1": "Paṭisambhidā . . . pe . . . ",
  "tha-ap283:4.2": "",
  "tha-ap283:4.3": "pe . . . // // ",
  "tha-ap283:4.4": "",
  "tha-ap283:5.1": "Itthaṃ sudam āyasmā Paṇṇadāyako thero i. g. a-ti. Paṇṇadāyakattherassa apadānaṃ ",
  "tha-ap283:6.1": "samattaṃ. Sinerusamasanto so dharaṇīdhārisādiso / "
}
