{
  "tha-ap546:0.1": "",
  "tha-ap546:0.2": "",
  "tha-ap546:0.3": "",
  "tha-ap546:1.1": "Padumuttaro nāma jino ",
  "tha-ap546:1.2": "sabbadhammesu cakkhumā / ",
  "tha-ap546:1.3": "ito satasahassamhi ",
  "tha-ap546:1.4": "kappe uppajji nāyako. // // ",
  "tha-ap546:2.1": "Yathāpi sāgare ūmi ",
  "tha-ap546:2.2": "gagaṇe viya tārakā / ",
  "tha-ap546:2.3": "evaṃ pāvacanaṃ tassa ",
  "tha-ap546:2.4": "arahantehi cintitaṃ. // // ",
  "tha-ap546:3.1": "Sadevāsuranāgehi ",
  "tha-ap546:3.2": "manujehi purakkhato / ",
  "tha-ap546:3.3": "samaṇabrāhmaṇākiṇṇe ",
  "tha-ap546:3.4": "janamajjhe jinuttamo // // ",
  "tha-ap546:4.1": "Pabhāhi anurañjanto ",
  "tha-ap546:4.2": "loke lokantagū jino / ",
  "tha-ap546:4.3": "vacanena vibodhento ",
  "tha-ap546:4.4": "veneyyapadumāni so // // ",
  "tha-ap546:5.1": "Vesārajjehi sampanno ",
  "tha-ap546:5.2": "catuhi purisuttamo / ",
  "tha-ap546:5.3": "pahīnabhayasārajjo ",
  "tha-ap546:5.4": "khemappatto visārado. // // ",
  "tha-ap546:6.1": "Āsabhaṃ pavaraṃ ṭhānaṃ ",
  "tha-ap546:6.2": "Buddhabhumiṃ ca kevalaṃ / ",
  "tha-ap546:6.3": "paṭijānāti lokaggo ",
  "tha-ap546:6.4": "n' atthi sañcodako kvaci // // ",
  "tha-ap546:7.1": "Sīhanādam asambhītaṃ ",
  "tha-ap546:7.2": "nadato tassa tādino / ",
  "tha-ap546:7.3": "devo naro vā brahmā vā ",
  "tha-ap546:7.4": "paṭivattā na vijjati. // // ",
  "tha-ap546:8.1": "Desento pavaraṃ dhammaṃ ",
  "tha-ap546:8.2": "santārento sadevakaṃ / ",
  "tha-ap546:8.3": "dhammacakkaṃ pavatteti ",
  "tha-ap546:8.4": "parisāsu visārado. // // ",
  "tha-ap546:9.1": "Paṭibhānavataṃ aggaṃ ",
  "tha-ap546:9.2": "sāvakaṃ sādhusammataṃ / ",
  "tha-ap546:9.3": "guṇaṃ bahuṃ pakittetvā ",
  "tha-ap546:9.4": "etadagge ṭhapesi taṃ. // // ",
  "tha-ap546:10.1": "Tadā 'haṃ Haṃsavatiyā ",
  "tha-ap546:10.2": "brāhmaṇo sādhusammato / ",
  "tha-ap546:10.3": "sabbavedavidū jāto ",
  "tha-ap546:10.4": "vāgīso vādisūdano. // // ",
  "tha-ap546:11.1": "Upecca taṃ mahāvīraṃ ",
  "tha-ap546:11.2": "sutvā taṃ dhammadesanaṃ / ",
  "tha-ap546:11.3": "pītivaraṃ paṭilabhiṃ ",
  "tha-ap546:11.4": "sāvakassa guṇe rato. // // ",
  "tha-ap546:12.1": "Nimantayitvā sugataṃ ",
  "tha-ap546:12.2": "sasaṅghaṃ lokanandanaṃ / ",
  "tha-ap546:12.3": "sattāhaṃ bhojayitvā 'haṃ dussehi ",
  "tha-ap546:12.4": "chādayiṃ tadā. // // ",
  "tha-ap546:13.1": "Nipacca sirasā pāde ",
  "tha-ap546:13.2": "katokāso katañjalī / ",
  "tha-ap546:13.3": "ekamantaṃ ṭhito haṭṭho ",
  "tha-ap546:13.4": "santhaviṃ jinam uttamaṃ // // ",
  "tha-ap546:14.1": "Namo te vālisaddūla! ",
  "tha-ap546:14.2": "Namo te purisuttama! / ",
  "tha-ap546:14.3": "Namo te sabbalokaggā! ",
  "tha-ap546:14.4": "Namo te abhayaṅkara! // // ",
  "tha-ap546:15.1": "Namo te māramathana! ",
  "tha-ap546:15.2": "Namo te diṭṭhisūdana! / ",
  "tha-ap546:15.3": "Namo te santisukhada! ",
  "tha-ap546:15.4": "Namo te saraṇantaga! // // ",
  "tha-ap546:16.1": "Anāthānaṃ bhavan nātho ",
  "tha-ap546:16.2": "bhītānaṃ abhayappado / ",
  "tha-ap546:16.3": "vissānabhūmisantānaṃ ",
  "tha-ap546:16.4": "saraṇaṃ saraṇesinaṃ. // // ",
  "tha-ap546:17.1": "Evamādihi sambuddhaṃ ",
  "tha-ap546:17.2": "santhavitvā mahāguṇaṃ / ",
  "tha-ap546:17.3": "avocaṃ vādisurassa ",
  "tha-ap546:17.4": "gatim pappomi bhikkhuno. // // ",
  "tha-ap546:18.1": "Tadā avoca bhagavā ",
  "tha-ap546:18.2": "anantapaṭibhānavā: / ",
  "tha-ap546:18.3": "\"Yo so Buddhaṃ apūjesi ",
  "tha-ap546:18.4": "sattāhaṃ saha sāvakaṃ. // // ",
  "tha-ap546:19.1": "Guṇañ ca me pakittesi ",
  "tha-ap546:19.2": "pasanno sehi pāṇihi / ",
  "tha-ap546:19.3": "eso patthayate ṭhānaṃ ",
  "tha-ap546:19.4": "vādisurassa bhikkhuno. // // ",
  "tha-ap546:20.1": "Anāgatamhi addhāne ",
  "tha-ap546:20.2": "lacchate taṃ manorathaṃ / ",
  "tha-ap546:20.3": "devamanussasampattiṃ ",
  "tha-ap546:20.4": "anubhotvā anappakaṃ. // // ",
  "tha-ap546:21.1": "Satasahasse ito kappe ",
  "tha-ap546:21.2": "Okkākakulasambhavo / ",
  "tha-ap546:21.3": "Gotamo nāma nāmena ",
  "tha-ap546:21.4": "satthā loke bhavissati. // // ",
  "tha-ap546:22.1": "Tassa dhammesu dāyādo ",
  "tha-ap546:22.2": "oraso dhammanimmito / ",
  "tha-ap546:22.3": "Vaṅgīso nāma nāmena ",
  "tha-ap546:22.4": "hessati satthu sāvako\". // // ",
  "tha-ap546:23.1": "Taṃ sutvā mudito hutvā ",
  "tha-ap546:23.2": "yāvajīvaṃ tadā jinaṃ / ",
  "tha-ap546:23.3": "paccayehi upaṭṭhāsiṃ ",
  "tha-ap546:23.4": "mettacitto Tathāgataṃ. // // ",
  "tha-ap546:24.1": "Tena kammena sukatena ",
  "tha-ap546:24.2": "cetanāpaṇidhīhi ca / ",
  "tha-ap546:24.3": "jahitvā mānusaṃ dehaṃ ",
  "tha-ap546:24.4": "Tusitaṃ agamās' ahaṃ. // // ",
  "tha-ap546:25.1": "Pacchime ca bhave dāni paribbājakule ahaṃ / pacchā ",
  "tha-ap546:25.2": "jāto ",
  "tha-ap546:25.3": "yadā āsiṃ ",
  "tha-ap546:25.4": "jātiyā sattavassiko. // // ",
  "tha-ap546:26.1": "Sabbavedavidū jāto ",
  "tha-ap546:26.2": "vādasatthavisārado / ",
  "tha-ap546:26.3": "vaggussaro cittakathī ",
  "tha-ap546:26.4": "paravādappamaddano. // // ",
  "tha-ap546:27.1": "Vaṅge hi jāto Vaṅgīso ",
  "tha-ap546:27.2": "vacane issaro ti vā / ",
  "tha-ap546:27.3": "Vaṅgīso iti me nāmaṃ ",
  "tha-ap546:27.4": "abhavi lokasammataṃ. // // ",
  "tha-ap546:28.1": "Yadā 'haṃ viññutaṃ patto ",
  "tha-ap546:28.2": "ṭhito paṭhamayobbane / ",
  "tha-ap546:28.3": "tadā Rājagahe ramme ",
  "tha-ap546:28.4": "Sāriputtam ",
  "tha-ap546:29.1": "ath' addasaṃ // // ",
  "tha-ap546:30.1": "Piṇḍāya vicarantan taṃ ",
  "tha-ap546:30.2": "pattapāṇiṃ susaṃvutaṃ / ",
  "tha-ap546:30.3": "alolakkhiṃ mitabhāsiṃ ",
  "tha-ap546:30.4": "yugamattaṃ nirikkhitaṃ. // // ",
  "tha-ap546:31.1": "Tam disvā vimhito hutvā ",
  "tha-ap546:31.2": "avocaṃ man ",
  "tha-ap546:31.3": "anucchaviṃ / kaṇṇikāraparicitaṃ ",
  "tha-ap546:31.4": "cittaṃ gāthāpadaṃ ahaṃ. // // ",
  "tha-ap546:32.1": "",
  "tha-ap546:32.2": "",
  "tha-ap546:32.3": "Tadā so paṇḍito vīro ",
  "tha-ap546:32.4": "uttaraṃ samavoca me / ",
  "tha-ap546:33.1": "virāgasahitaṃ vākyaṃ ",
  "tha-ap546:33.2": "katvān' uddayam uttamaṃ // // ",
  "tha-ap546:33.3": "Vicittapaṭibhāne hi ",
  "tha-ap546:33.4": "tosito tena tādinā / ",
  "tha-ap546:34.1": "nipacca sirasā pāde ",
  "tha-ap546:34.2": "\"pabbājehīti\" c' abraviṃ. // // ",
  "tha-ap546:34.3": "Tato maṃ sa mahāpañño ",
  "tha-ap546:34.4": "Buddhaseṭṭham upānayi / ",
  "tha-ap546:35.1": "",
  "tha-ap546:35.2": "",
  "tha-ap546:35.3": "mam āha vadataṃ seṭṭho: saccaṃ Vaṅgīsa ",
  "tha-ap546:35.4": "kacci te // // ",
  "tha-ap546:36.1": "Mataṃ ",
  "tha-ap546:36.2": "sīsaṃ ",
  "tha-ap546:36.3": "vanacchuddhaṃ ",
  "tha-ap546:36.4": "api bārasavassi*kaṃ* / ",
  "tha-ap546:36.5": "tayā vijjāvisesena ",
  "tha-ap546:36.6": "sace sakkosi bhāsaya. // // Āmā ",
  "tha-ap546:37.1": "ti me paṭiññāte ",
  "tha-ap546:37.2": "tīṇi sīsāni dassayi / ",
  "tha-ap546:37.3": "atho nirayadevesu ",
  "tha-ap546:37.4": "upapanne avācayi. // // ",
  "tha-ap546:38.1": "*Tadā pacceka*buddhassa ",
  "tha-ap546:38.2": "siraṃ dassesi nāyako / ",
  "tha-ap546:38.3": "tato 'haṃ vigatārambho ",
  "tha-ap546:38.4": "pabbajjaṃ samayāci 'haṃ. // // ",
  "tha-ap546:39.1": "Pabbajitvāna sugataṃ ",
  "tha-ap546:39.2": "santhavāmi yahiṃ tahiṃ / ",
  "tha-ap546:39.3": "tato maṃ kavyacitto ti ",
  "tha-ap546:39.4": "ujjhāyanti ha bhikkhavo. // // ",
  "tha-ap546:40.1": "Tato vīmaṃsanattham me ",
  "tha-ap546:40.2": "āha Buddho vināyako: / ",
  "tha-ap546:40.3": "*takki*tānaṃ imā gāthā ",
  "tha-ap546:40.4": "ṭhānaso paṭibhanti vā? // // ",
  "tha-ap546:41.1": "Na kavyacitto 'haṃ vīra, ",
  "tha-ap546:41.2": "ṭhānaso paṭibhanti me / ",
  "tha-ap546:41.3": "tana dānena Vaṅgīsa ",
  "tha-ap546:41.4": "ṭhānaso santhavāhi maṃ // // ",
  "tha-ap546:42.1": "Tadā 'haṃ santhaviṃ vīraṃ ",
  "tha-ap546:42.2": "gāthāhi isisattamaṃ / so ",
  "tha-ap546:42.3": "ṭhānaso tadā tuṭṭho ",
  "tha-ap546:42.4": "jino aggaṃ ṭhapesi maṃ. // // ",
  "tha-ap546:43.1": "Paṭibhānena cittena ",
  "tha-ap546:43.2": "aññe samatimaññ' ahaṃ / ",
  "tha-ap546:43.3": "pesal' etena saṃviggo ",
  "tha-ap546:43.4": "arahattaṃ apāpuṇiṃ. // // ",
  "tha-ap546:44.1": "Paṭibhānavataṃ aggo ",
  "tha-ap546:44.2": "añño koci na vijjati / ",
  "tha-ap546:44.3": "yathāyaṃ bhikkhu Vaṅgīso, ",
  "tha-ap546:44.4": "evaṃ dhāretha bhikkhavo // // ",
  "tha-ap546:45.1": "Satasahasse kataṃ kammaṃ ",
  "tha-ap546:45.2": "phalaṃ dassesi me idha / ",
  "tha-ap546:45.3": "sumutto saravego ca ",
  "tha-ap546:45.4": "kilese jhāpayiṃ mama. // // ",
  "tha-ap546:46.1": "Kilesā . . . ",
  "tha-ap546:46.2": "pe . . . ",
  "tha-ap546:46.3": "",
  "tha-ap546:47.1": "",
  "tha-ap546:47.2": "pe . . . ",
  "tha-ap546:47.3": "pe . . . // // Sāgataṃ . . . pe . . . pe . . . pe . . . // // ",
  "tha-ap546:48.1": "Paṭisambhidā . . . ",
  "tha-ap546:48.2": "pe . . . ",
  "tha-ap546:48.3": "pe . . . pe . . . // // ",
  "tha-ap546:49.1": "Itthaṃ sudaṃ āyasmā Vaṅgīso thero i. g. a-ti. Vaṅgīsattherassa ",
  "tha-ap546:50.1": "apadānaṃ samattaṃ. "
}
