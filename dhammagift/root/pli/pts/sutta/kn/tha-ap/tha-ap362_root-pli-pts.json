  "tha-ap362:0.3": "",
  "tha-ap362:1.1": "Tisso nām' āsi sambuddho ",
  "tha-ap362:1.2": "vihāsi pavane tadā / ",
  "tha-ap362:1.3": "Tusitāhi idhāgantvā ",
  "tha-ap362:1.4": "piṇḍapātam adās ahaṃ. // // ",
  "tha-ap362:2.1": "Sambuddham abhivādetvā ",
  "tha-ap362:2.2": "Tissanāma- mahāyasaṃ / ",
  "tha-ap362:2.3": "Sakacittaṃ pasādetvā ",
  "tha-ap362:2.4": "Tusitam agamās' ahaṃ. // // ",
  "tha-ap362:3.1": "Dvenavute ito kappe ",
  "tha-ap362:3.2": "yaṃ dānam adadiṃ tadā / ",
  "tha-ap362:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap362:3.4": "piṇḍapātass' idaṃ phalaṃ. // // ",
  "tha-ap362:4.1": "Paṭisambhidā . . . ",
  "tha-ap362:4.2": "pe . . . ",
  "tha-ap362:4.3": "pe . . . // // ",
  "tha-ap362:5.1": "Itthaṃ sudam āyasmā Piṇḍapātiko thero i. g. a- ",
  "tha-ap362:6.1": "ti. Piṇḍapatikattherassa ",
  "tha-ap362:7.1": "apadānaṃ samattaṃ. ",
  "tha-ap362:8.1": "Uddānaṃ: ",
  "tha-ap362:9.1": "Saddasañña-Yavasiko ",
  "tha-ap362:9.2": "Kiṃsuko 'Raṇḍapupphiyo ",
  "tha-ap362:9.3": "Ālamban'-Ambayāgu ca ",
  "tha-ap362:9.4": "Supuṭī Sajjhadāyako ",
  "tha-ap362:9.5": "Saraṇaṃ Piṇḍapāto ca ",
  "tha-ap362:9.6": "gāthā tālīsam eva ca. "
}
