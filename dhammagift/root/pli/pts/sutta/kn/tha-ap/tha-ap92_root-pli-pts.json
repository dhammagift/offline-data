  "tha-ap92:0.1": "",
  "tha-ap92:0.2": "",
  "tha-ap92:0.3": "",
  "tha-ap92:1.1": "Pokkharavanaṃ paviṭṭho ",
  "tha-ap92:1.2": "bhuñjanto padumān' ",
  "tha-ap92:1.3": "ahaṃ / addasaṃ Phussasambuddhaṃ ",
  "tha-ap92:1.4": "battiṃsavaralakkhaṇaṃ. // // ",
  "tha-ap92:2.1": "Padumapupphaṃ gahetvā ",
  "tha-ap92:2.2": "ākāse ukkhipiṃ ahaṃ / ",
  "tha-ap92:2.3": "pasannakammaṃ katvāna ",
  "tha-ap92:2.4": "pabbajiṃ anagāriyaṃ. // // ",
  "tha-ap92:3.1": "Pabbajitvāna kāyena ",
  "tha-ap92:3.2": "manasā saṃvutena ca / ",
  "tha-ap92:3.3": "vacīduccaritaṃ hitvā ",
  "tha-ap92:3.4": "ājīvaṃ parisodhayiṃ. // // ",
  "tha-ap92:4.1": "Dvenavute ito kappe ",
  "tha-ap92:4.2": "yaṃ puppham abhiropayiṃ / ",
  "tha-ap92:4.3": "duggatiṃ nābhijānāmi ",
  "tha-ap92:4.4": "Buddhapūjāy' idaṃ phalaṃ. // // ",
  "tha-ap92:5.1": "Padumabhāsanāmā ca ",
  "tha-ap92:5.2": "aṭṭhārasa-mahīpatī / ",
  "tha-ap92:5.3": "aṭṭhārasasu kappesu ",
  "tha-ap92:5.4": "aṭṭhatālīsa-m-āsisuṃ. // // ",
  "tha-ap92:6.1": "Paṭisambhidā catasso ",
  "tha-ap92:6.2": "vimokhā pi ca aṭṭh' ime / chaḍabhiññā sacchikatā ",
  "tha-ap92:6.3": "kataṃ Buddhassa sāsanan ti. // // ",
  "tha-ap92:7.1": "Itthaṃ sudaṃ āyasmā Padumapupphiyothero imā gāthāyo abhāsitthā ti. Padumapupphiyattherassa apadānaṃ samattaṃ. Uddānaṃ: ",
  "tha-ap92:8.1": "",
  "tha-ap92:9.1": "",
  "tha-ap92:10.1": "Timiraṃ ",
  "tha-ap92:11.1": "Naṅgalipupphī ",
  "tha-ap92:11.2": "Nipannañjaliko Adho ",
  "tha-ap92:11.3": "dve Raṃsisaññī Phalado ",
  "tha-ap92:11.4": "Saddasaññī ca Sevako ",
  "tha-ap92:11.5": "Padumapupphī ca gāthāyo ",
  "tha-ap92:11.6": "chapaññāsa pakittitā. Timirapupphiyavaggo navamo. "
}
