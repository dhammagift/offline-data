  "tha-ap284:1.1": "",
  "tha-ap284:1.2": "",
  "tha-ap284:1.3": "vuṭṭhahitvā samādhimhā ",
  "tha-ap284:1.4": "bhikkhāya mam upaṭṭhito. // // ",
  "tha-ap284:2.1": "Harīṭakam āmalakam ",
  "tha-ap284:2.2": "ambajambuvibhīṭakaṃ / ",
  "tha-ap284:2.3": "koḷaṃ bhallāṭakaṃ bellaṃ ",
  "tha-ap284:2.4": "phārusakaphalāni ca // // ",
  "tha-ap284:3.1": "Siddhatthassa mahesissa ",
  "tha-ap284:3.2": "sabbalokānukampino / ",
  "tha-ap284:3.3": "tañ ca sabbaṃ mayā dinnaṃ ",
  "tha-ap284:3.4": "vippasannena cetasā. // // ",
  "tha-ap284:4.1": "Catunavute ito kappe ",
  "tha-ap284:4.2": "yaṃ phalam adadiṃ tadā / ",
  "tha-ap284:4.3": "duggatiṃ nābhijānāmi ",
  "tha-ap284:4.4": "phaladānass' idaṃ phalaṃ. // // ",
  "tha-ap284:5.1": "Sattapaññās' ito kappe ",
  "tha-ap284:5.2": "Ekajjho nāma khattiyo / ",
  "tha-ap284:5.3": "sattaratanasampanno ",
  "tha-ap284:5.4": "cakkavattī mahabbalo. // // ",
  "tha-ap284:6.1": "Paṭisambhidā . . . ",
  "tha-ap284:6.2": "pe . . . ",
  "tha-ap284:6.3": "pe . . . // // ",
  "tha-ap284:7.1": "Itthaṃ sudam āyasmā Phaladāyako thero i. g. a-ti. Phaladāyakattherassa ",
  "tha-ap284:8.1": "apadānaṃ samattaṃ. "
}
