  "tha-ap243:0.2": "",
  "tha-ap243:0.3": "",
  "tha-ap243:1.1": "Migaluddo pure āsiṃ ",
  "tha-ap243:1.2": "araññe kānane ahaṃ / ",
  "tha-ap243:1.3": "haritvā tuvaram ādāya ",
  "tha-ap243:1.4": "saṅghassa adadaṃ ahaṃ. // // ",
  "tha-ap243:2.1": "Ekanavute ito kappe ",
  "tha-ap243:2.2": "yaṃ dānaṃ adadiṃ tadā / ",
  "tha-ap243:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap243:2.4": "tuvarassa idaṃ phalaṃ. // // ",
  "tha-ap243:3.1": "Paṭisambhidā . . . pe . . . // // ",
  "tha-ap243:3.2": "",
  "tha-ap243:3.3": "",
  "tha-ap243:3.4": "",
  "tha-ap243:4.1": "Itthaṃ sudaṃ āyasmā Tuvaradāyako thero i. g. a-ti. Tuvaradāyakattherassa ",
  "tha-ap243:5.1": "apadānaṃ samattaṃ. "
}
