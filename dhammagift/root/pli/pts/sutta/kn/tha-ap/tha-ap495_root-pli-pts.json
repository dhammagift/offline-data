  "tha-ap495:0.3": "",
  "tha-ap495:1.1": "Vanakammiko pūre āsiṃ ",
  "tha-ap495:1.2": "pitupitāmahen' ahaṃ / ",
  "tha-ap495:1.3": "pararuhireṇa jīvāmi ",
  "tha-ap495:1.4": "kusalam me na vijjati. // // ",
  "tha-ap495:2.1": "Mama āsayasāmantā ",
  "tha-ap495:2.2": "Tisso lokagganāyako / tīṇi ",
  "tha-ap495:2.3": "padāni dassesi ",
  "tha-ap495:2.4": "anukampāya cakkhumā. // // ",
  "tha-ap495:3.1": "Akkante ca pade disvā ",
  "tha-ap495:3.2": "Tissa-nāmassa satthuno / ",
  "tha-ap495:3.3": "haṭṭho haṭṭhena cittena ",
  "tha-ap495:3.4": "pade cittaṃ pasādayiṃ. // // ",
  "tha-ap495:4.1": "Koraṇḍaṃ pupphitaṃ disvā ",
  "tha-ap495:4.2": "pādapaṃ dharaṇīruhaṃ / ",
  "tha-ap495:4.3": "caṅgoṭakaṃ gahetvāna ",
  "tha-ap495:4.4": "padaseṭṭhe apūjayiṃ. // // ",
  "tha-ap495:5.1": "Tena kammena sukatena ",
  "tha-ap495:5.2": "cetanāpaṇidhīhi ca / ",
  "tha-ap495:5.3": "jahitvā mānusaṃ dehaṃ ",
  "tha-ap495:5.4": "Tāvatiṃsaṃ agañch' ahaṃ. // // ",
  "tha-ap495:6.1": "Yaṃ yaṃ yonūpapajjāmi ",
  "tha-ap495:6.2": "devattaṃ atha mānusaṃ / ",
  "tha-ap495:6.3": "koraṇḍakachavī homi ",
  "tha-ap495:6.4": "sappabhāso bhavām' ahaṃ. // // ",
  "tha-ap495:7.1": "Dvenavute ito kappe ",
  "tha-ap495:7.2": "yaṃ kammam akariṃ tadā / ",
  "tha-ap495:7.3": "duggatiṃ nābhijānāmi ",
  "tha-ap495:7.4": "pādapūjāy' idaṃ phalaṃ. // // ",
  "tha-ap495:8.1": "Kilesā . . . ",
  "tha-ap495:8.2": "pe . . . ",
  "tha-ap495:8.3": "",
  "tha-ap495:9.1": "",
  "tha-ap495:9.2": "pe . . . ",
  "tha-ap495:9.3": "pe . . . // // Sāgataṃ . . . pe . . . pe . . . pe . . . // // ",
  "tha-ap495:10.1": "Paṭisambhidā . . . ",
  "tha-ap495:10.2": "pe . . . ",
  "tha-ap495:10.3": "pe . . . pe . . . // // ",
  "tha-ap495:11.1": "Itthaṃ sudaṃ āyasmā Koraṇḍapupphiyo thero i. g. a-ti. Koraṇḍapupphiyattherassa apadānaṃ samattaṃ. ",
  "tha-ap495:12.1": ""
}
