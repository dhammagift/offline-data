  "tha-ap89:1.1": "Pabbate Himavantamhi ",
  "tha-ap89:1.2": "kharājinadharo ahaṃ / ",
  "tha-ap89:1.3": "Phussaṃ jinavaraṃ disvā ",
  "tha-ap89:1.4": "phalahattho phalaṃ adaṃ // // ",
  "tha-ap89:2.1": "Yam ahaṃ phalam adāsiṃ ",
  "tha-ap89:2.2": "vippasannena cetasā / ",
  "tha-ap89:2.3": "bhave nibbattamānamhi ",
  "tha-ap89:2.4": "phalaṃ nibbattate mamaṃ. // // ",
  "tha-ap89:3.1": "Dvenavute ito kappe ",
  "tha-ap89:3.2": "yaṃ phalam adadim ahaṃ / ",
  "tha-ap89:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap89:3.4": "phaladānass' idaṃ phalaṃ. // // ",
  "tha-ap89:4.1": "Paṭisambhidā catasso ",
  "tha-ap89:4.2": "vimokhā pi ca aṭṭh' ime / chaḍabhiññā sacchikatā ",
  "tha-ap89:4.3": "kataṃ Buddhassa sasanan ti. // // ",
  "tha-ap89:5.1": "Itthaṃ sudaṃ āyasmā Phaladāyakothero imā gāthāyo abhāsitthā ti. ",
  "tha-ap89:6.1": "Phaladāyakatherassa apadānaṃ samattaṃ. "
}
