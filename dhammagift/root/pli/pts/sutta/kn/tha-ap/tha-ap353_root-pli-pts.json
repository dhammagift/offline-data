  "tha-ap353:0.3": "",
  "tha-ap353:1.1": "Migaluddo pure āsim ",
  "tha-ap353:1.2": "araññe kānane ahaṃ / ",
  "tha-ap353:1.3": "tatth' addasāsiṃ sambuddhaṃ ",
  "tha-ap353:1.4": "devasaṅghapurakkhataṃ // // ",
  "tha-ap353:2.1": "Catusaccaṃ pakāsentam ",
  "tha-ap353:2.2": "uddharantaṃ mahājanaṃ / ",
  "tha-ap353:2.3": "assosiṃ madhuraṃ vācaṃ ",
  "tha-ap353:2.4": "karavīkarudopamaṃ. // // ",
  "tha-ap353:3.1": "Brahmassarassa munino ",
  "tha-ap353:3.2": "Sikhino lokabandhuno / ",
  "tha-ap353:3.3": "ghose cittaṃ pasādetvā ",
  "tha-ap353:3.4": "patto 'mhi āsavakkhayaṃ. // // ",
  "tha-ap353:4.1": "Ekatiṃse ito kappe ",
  "tha-ap353:4.2": "yaṃ kammam akariṃ tadā / ",
  "tha-ap353:4.3": "duggatiṃ nābhijānāmi ",
  "tha-ap353:4.4": "pasādassa idaṃ phalaṃ. // // ",
  "tha-ap353:5.1": "Paṭisambhidā . . . pe . . . ",
  "tha-ap353:5.2": "",
  "tha-ap353:5.3": "pe . . . // // ",
  "tha-ap353:5.4": "",
  "tha-ap353:6.1": "Itthaṃ sudam āyasmā Saddasaññako thero i. g. a-ti. Saddasaññakattherassa apadānaṃ samattaṃ. ",
  "tha-ap353:7.1": ""
}
