  "tha-ap466:1.1": "Vipassino bhagavato ",
  "tha-ap466:1.2": "caṅkamantassa sammukhā / ",
  "tha-ap466:1.3": "pasannacitto sumano ",
  "tha-ap466:1.4": "setuṃ kārāpayim ahaṃ. // // ",
  "tha-ap466:2.1": "Ekanavute ito kappe ",
  "tha-ap466:2.2": "yaṃ setuṃ kārayiṃ ahaṃ. / ",
  "tha-ap466:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap466:2.4": "setudānass' idaṃ phalaṃ. // // ",
  "tha-ap466:3.1": "Kilesā . . . ",
  "tha-ap466:3.2": "pe . . . ",
  "tha-ap466:3.3": "",
  "tha-ap466:4.1": "",
  "tha-ap466:4.2": "pe . . . ",
  "tha-ap466:4.3": "pe . . . // // Sāgataṃ . . . pe . . . pe . . . pe . . . // // ",
  "tha-ap466:5.1": "Paṭisambhidā . . . ",
  "tha-ap466:5.2": "pe . . . ",
  "tha-ap466:5.3": "pe . . . pe . . . // // ",
  "tha-ap466:6.1": "Itthaṃ sudam āyasmā Setudāyako thero i. g. a-ti. Setudāyakattherassa apadānaṃ samattaṃ. ",
  "tha-ap466:7.1": ""
}
