  "tha-ap506:1.1": "Sahassaraṃsī bhagavā ",
  "tha-ap506:1.2": "sayambhū aparājito / ",
  "tha-ap506:1.3": "vivekā vuṭṭhahitvāna ",
  "tha-ap506:1.4": "gocarāyābhinikkhami. // // ",
  "tha-ap506:2.1": "Phalahattho ahaṃ disvā ",
  "tha-ap506:2.2": "upagacchiṃ narāsabhaṃ / ",
  "tha-ap506:2.3": "pasannacitto sumano ",
  "tha-ap506:2.4": "avaṭaṃ adadaṃ phalaṃ. // // ",
  "tha-ap506:3.1": "Catunavute ito kappe ",
  "tha-ap506:3.2": "yaṃ phalaṃ adadiṃ tadā / ",
  "tha-ap506:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap506:3.4": "phaladānass' idaṃ phalaṃ. // // ",
  "tha-ap506:4.1": "Kilesā . . . ",
  "tha-ap506:4.2": "pe . . . ",
  "tha-ap506:4.3": "",
  "tha-ap506:5.1": "",
  "tha-ap506:5.2": "pe . . . ",
  "tha-ap506:5.3": "pe . . . // // Sāgataṃ . . . pe . . . pe . . . pe . . . // // ",
  "tha-ap506:6.1": "Paṭisambhidā . . . ",
  "tha-ap506:6.2": "pe . . . ",
  "tha-ap506:6.3": "pe . . . pe . . . // // ",
  "tha-ap506:7.1": "Ittham sudaṃ āyasmā Avaṭaphaliyo thero i. g. a-ti. Avaṭaphaliyattherassa ",
  "tha-ap506:8.1": "apadānaṃ samattaṃ. "
}
