  "tha-ap520:1.1": "Migaluddo pure āsiṃ ",
  "tha-ap520:1.2": "araññe vivane ahaṃ / ",
  "tha-ap520:1.3": "addasaṃ virajaṃ Buddhaṃ ",
  "tha-ap520:1.4": "devasaṅghapurakkhataṃ // // ",
  "tha-ap520:2.1": "Catusaccaṃ pakāsentaṃ ",
  "tha-ap520:2.2": "desantaṃ amataṃ padaṃ / ",
  "tha-ap520:2.3": "assosiṃ madhuraṃ dhammaṃ ",
  "tha-ap520:2.4": "Sikhino lokabandhuno. // // ",
  "tha-ap520:3.1": "Ghose cittaṃ pasādesiṃ ",
  "tha-ap520:3.2": "asamappaṭipuggalaṃ / ",
  "tha-ap520:3.3": "tatth cittaṃ pasādetvā ",
  "tha-ap520:3.4": "atariṃ duttaraṃ bhavaṃ. // // ",
  "tha-ap520:4.1": "Ekatiṃse ito kappe ",
  "tha-ap520:4.2": "yaṃ saññam alabhiṃ tadā / ",
  "tha-ap520:4.3": "duggatiṃ nābhijānāmi ",
  "tha-ap520:4.4": "ghosasaññāy' idaṃ phalaṃ. // // ",
  "tha-ap520:5.1": "Kilesā . . . ",
  "tha-ap520:5.2": "pe . . . ",
  "tha-ap520:5.3": "",
  "tha-ap520:6.1": "",
  "tha-ap520:6.2": "pe . . . ",
  "tha-ap520:6.3": "pe . . . // // Sāgataṃ . . . pe . . . pe . . . pe . . . // // ",
  "tha-ap520:7.1": "Paṭisambhidā . . . ",
  "tha-ap520:7.2": "pe . . . ",
  "tha-ap520:7.3": "pe . . . pe . . . // // ",
  "tha-ap520:8.1": "Itthaṃ sudaṃ āyasmā Ghosasaññako thero i. g. a-ti. Ghosasaññakattherassa apadānaṃ samattaṃ. ",
  "tha-ap520:9.1": ""
}
