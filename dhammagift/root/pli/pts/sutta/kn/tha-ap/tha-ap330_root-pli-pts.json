  "tha-ap330:0.2": "",
  "tha-ap330:0.3": "",
  "tha-ap330:1.1": "Vessabhussa bhagavato ",
  "tha-ap330:1.2": "lokajeṭṭhassa tādino / ",
  "tha-ap330:1.3": "sabbe janā samāgamma ",
  "tha-ap330:1.4": "mahāpūjaṃ karonti te. // // ",
  "tha-ap330:2.1": "Sudhāya piṇḍaṃ katvāna ",
  "tha-ap330:2.2": "āveḷaṃ sumanāy' ahaṃ / ",
  "tha-ap330:2.3": "sīhāsanassa purato ",
  "tha-ap330:2.4": "abhiropes' ahan tadā. // // ",
  "tha-ap330:3.1": "Sabbe janā samāgamma ",
  "tha-ap330:3.2": "pekkhanti puppham uttamaṃ / ",
  "tha-ap330:3.3": "ken' idaṃ pūjitaṃ pupphaṃ ",
  "tha-ap330:3.4": "Buddhaseṭṭhassa tādino? // // ",
  "tha-ap330:4.1": "Tena cittappasādena ",
  "tha-ap330:4.2": "Nimmānam upapajj' ahaṃ / ",
  "tha-ap330:4.3": "anubhosiṃ sakaṃ kammaṃ ",
  "tha-ap330:4.4": "pubbe sukatam attano. // // ",
  "tha-ap330:5.1": "Yaṃ yaṃ yonūpapajjāmi ",
  "tha-ap330:5.2": "devattam atha mānusaṃ / ",
  "tha-ap330:5.3": "sabbesānaṃ piyo homi ",
  "tha-ap330:5.4": "pupphapūjāy' idaṃ phalaṃ. // // ",
  "tha-ap330:6.1": "Nābhijānāmi kāyena ",
  "tha-ap330:6.2": "vācāya uda cetasā / ",
  "tha-ap330:6.3": "saṃyatāna tapassīnaṃ ",
  "tha-ap330:6.4": "katam uṭṭhāhitaṃ mayā. // // ",
  "tha-ap330:7.1": "Tena sucaritenāhaṃ ",
  "tha-ap330:7.2": "cittassa paṇidhīhi ca / ",
  "tha-ap330:7.3": "sabbesaṃ pūjito homi ",
  "tha-ap330:7.4": "anakkosass' idaṃ phalaṃ. // // Ekatiṃse ito kappe yaṃ puppham abhipūjayiṃ / duggatiṃ nābhijānāmi Buddhapūjāy' idaṃ phalaṃ. // // ",
  "tha-ap330:8.1": "Ito *ekādase kappe* ",
  "tha-ap330:8.2": "Sahassāro' si khattiyo / ",
  "tha-ap330:8.3": "sattaratanasampanno ",
  "tha-ap330:8.4": "cakkavattī mahabbalo. // // ",
  "tha-ap330:9.1": "Paṭisambhidā . . . ",
  "tha-ap330:9.2": "pe . . . ",
  "tha-ap330:9.3": "pe . . . // // ",
  "tha-ap330:10.1": "Itthaṃ sudam āyasmā Sumanāveḷiyo thero i. g. a-ti. Sumanāveḷiyattherassa ",
  "tha-ap330:11.1": "apadānaṃ samattaṃ. "
}
