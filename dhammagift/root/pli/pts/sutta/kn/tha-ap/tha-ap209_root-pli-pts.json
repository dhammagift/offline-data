  "tha-ap209:1.1": "jotantaṃ ",
  "tha-ap209:1.2": "nisinnaṃ pabbatantare / ",
  "tha-ap209:1.3": "obhāsentaṃ disā sabbā ",
  "tha-ap209:1.4": "Siddhatthaṃ narasārathiṃ. // // ",
  "tha-ap209:2.1": "Dhanum adejjhaṃ katvāna ",
  "tha-ap209:2.2": "usuṃ sandhāy' ahaṃ tadā / ",
  "tha-ap209:2.3": "pupphaṃ savaṇṭaṃ chetvāna ",
  "tha-ap209:2.4": "Buddhassa abhiropayiṃ. // // ",
  "tha-ap209:3.1": "Catunavute ito kappe ",
  "tha-ap209:3.2": "yaṃ puppham abhipūjāyiṃ / ",
  "tha-ap209:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap209:3.4": "Buddhapūjāy'idaṃ phalaṃ. // // ",
  "tha-ap209:4.1": "Ekapaññās' ito kappe ",
  "tha-ap209:4.2": "eko āsi Jutindharo / ",
  "tha-ap209:4.3": "sattaratanasampanno ",
  "tha-ap209:4.4": "cakkavattī mahabbalo. // // ",
  "tha-ap209:5.1": "Paṭisambhidā . . . ",
  "tha-ap209:5.2": "pe . . . ",
  "tha-ap209:5.3": "pe . . . // // ",
  "tha-ap209:6.1": "Itthaṃ sudam āyasmā Salaḷamāliyo thero i. g. a-ti. Salaḷamāliyattherassa apadānaṃ ",
  "tha-ap209:7.1": "samattaṃ. Akkantañ ca "
}
