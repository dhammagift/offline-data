  "tha-ap475:1.1": "nāma bhagavā ",
  "tha-ap475:1.2": "Cittakuṭe vasī tadā / ",
  "tha-ap475:1.3": "jhāyī jhānarato Buddho ",
  "tha-ap475:1.4": "vivekābhirato muni. // // ",
  "tha-ap475:2.1": "Ajjhogahetvā Himavantaṃ ",
  "tha-ap475:2.2": "nārīgaṇapurakkhato / ",
  "tha-ap475:2.3": "addasaṃ Kosikaṃ Buddhaṃ ",
  "tha-ap475:2.4": "puṇṇamāse va candimaṃ. // // ",
  "tha-ap475:3.1": "Ukkāsate gahetvāna ",
  "tha-ap475:3.2": "parivāres' ahaṃ tadā / ",
  "tha-ap475:3.3": "sattarattindivaṃ ṭhatvā ",
  "tha-ap475:3.4": "aṭṭhamena agacch' ahaṃ. // // ",
  "tha-ap475:4.1": "*Vuṭṭhi*taṃ Kosikaṃ Buddhaṃ ",
  "tha-ap475:4.2": "sayambhum aparājitaṃ / ",
  "tha-ap475:4.3": "pasannacitto vanditvā ",
  "tha-ap475:4.4": "ekaṃ bhikkhaṃ adās' ahaṃ. // // ",
  "tha-ap475:5.1": "Tena kammena dipadindaṃ ",
  "tha-ap475:5.2": "lokajāṭṭhaṃ narāsabhaṃ / ",
  "tha-ap475:5.3": "uppajjiṃ Tusite kāye ",
  "tha-ap475:5.4": "ekabhikkhass' idaṃ phalaṃ. // // ",
  "tha-ap475:6.1": "Divasañ c' eva rattiñ ca ",
  "tha-ap475:6.2": "āloko hoti me sadā / ",
  "tha-ap475:6.3": "samantā yojanasataṃ ",
  "tha-ap475:6.4": "obhāsena pharām' ahaṃ. // // ",
  "tha-ap475:7.1": "Pañcapaññāsakappamhi ",
  "tha-ap475:7.2": "cakkavattī ahos' ahaṃ / ",
  "tha-ap475:7.3": "cāturanto vijitā*vī* ",
  "tha-ap475:7.4": "jambusaṇḍassa issaro. // // ",
  "tha-ap475:8.1": "Tadā me nagaraṃ āsi ",
  "tha-ap475:8.2": "iddhaṃ phītaṃ sunimmitaṃ / ",
  "tha-ap475:8.3": "tiṃsayojana-āyāmaṃ ",
  "tha-ap475:8.4": "vitthārena ca vīsati. // // ",
  "tha-ap475:9.1": "Sobhanaṃ nāma nagaraṃ ",
  "tha-ap475:9.2": "Vissakammena mapitaṃ / ",
  "tha-ap475:9.3": "dasasaddāvivittan taṃ ",
  "tha-ap475:9.4": "samatālasamāhitaṃ. // // ",
  "tha-ap475:10.1": "Na tasmiṃ nagare atthi ",
  "tha-ap475:10.2": "valli-kaṭṭhañ ca mattikā / ",
  "tha-ap475:10.3": "sabbasovaṇṇayaṃ yeva ",
  "tha-ap475:10.4": "jotate niccakālikaṃ. // // ",
  "tha-ap475:11.1": "Catupākāraparikkhittaṃ ",
  "tha-ap475:11.2": "tayo āsuṃ maṇimayā / ",
  "tha-ap475:11.3": "vemajjhe tālapattī ca ",
  "tha-ap475:11.4": "Vissakammena māpitā. // // ",
  "tha-ap475:12.1": "Dasasahassā pokkharañño ",
  "tha-ap475:12.2": "padumuppalachāditā / ",
  "tha-ap475:12.3": "puṇḍarīkehi sañchannā ",
  "tha-ap475:12.4": "nānāgandhasameritā. // // Catunavute ",
  "tha-ap475:13.1": "ito kappe ",
  "tha-ap475:13.2": "yaṃ ukkaṃ dhārayiṃ ahaṃ / ",
  "tha-ap475:13.3": "duggatiṃ nābhijānāmi ",
  "tha-ap475:13.4": "ukkādhārass' idaṃ phalaṃ. // // ",
  "tha-ap475:14.1": "Kilesā . . . ",
  "tha-ap475:14.2": "pe . . . ",
  "tha-ap475:14.3": "",
  "tha-ap475:15.1": "",
  "tha-ap475:15.2": "pe . . . ",
  "tha-ap475:15.3": "pe . . . // // Sāgataṃ . . . pe . . . pe . . . pe . . . // // ",
  "tha-ap475:16.1": "Paṭisambhidā . . . ",
  "tha-ap475:16.2": "pe . . . ",
  "tha-ap475:16.3": "pe . . . pe . . . // // ",
  "tha-ap475:17.1": "Itthaṃ sudam āyasmā Ukkāsatiko thero i. g. a-ti. Ukkāsatikattherassa apadānaṃ samattaṃ. ",
  "tha-ap475:18.1": ""
}
