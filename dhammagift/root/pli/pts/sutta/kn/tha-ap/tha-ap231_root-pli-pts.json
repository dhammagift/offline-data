  "tha-ap231:0.3": "",
  "tha-ap231:1.1": "Asito nāma nāmena ",
  "tha-ap231:1.2": "mālākāro ahaṃ tadā / ",
  "tha-ap231:1.3": "āveḷaṃ paggahetvāna ",
  "tha-ap231:1.4": "rañño dātuṃ vajām' ahaṃ. // // ",
  "tha-ap231:2.1": "Asampatto 'mhi rājānam ",
  "tha-ap231:2.2": "addasaṃ Sikhināyakaṃ / ",
  "tha-ap231:2.3": "haṭṭho haṭṭhena cittena ",
  "tha-ap231:2.4": "Buddhassa abhiropayiṃ. // // ",
  "tha-ap231:3.1": "Ekatiṃse ito kappe ",
  "tha-ap231:3.2": "yaṃ puppham abhipūjayiṃ / ",
  "tha-ap231:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap231:3.4": "Buddhapūjāy 'idaṃ phalaṃ. // // ",
  "tha-ap231:4.1": "Pañcavīse ito kappe ",
  "tha-ap231:4.2": "rājāhosi mahābalo / ",
  "tha-ap231:4.3": "Dvebhāro nāma nāmena ",
  "tha-ap231:4.4": "cakkavattī mahabbalo. // // ",
  "tha-ap231:5.1": "Paṭisambhidā . . . ",
  "tha-ap231:5.2": "pe . . . ",
  "tha-ap231:5.3": "pe . . . // // ",
  "tha-ap231:6.1": "Itthaṃ sudam āyasmā Sukatāveḷiyo thero i. g. a-ti. Sukatāveḷiyattherassa ",
  "tha-ap231:7.1": "apadānaṃ samattaṃ. "
}
