  "tha-ap56:0.1": "",
  "tha-ap56:0.2": "",
  "tha-ap56:0.3": "",
  "tha-ap56:1.1": "Padumuttarabuddhassa ",
  "tha-ap56:1.2": "mahābodhimaho ahu / ",
  "tha-ap56:1.3": "vicittaghaṭam ādāya ",
  "tha-ap56:1.4": "gandhodakam adās' ahaṃ. // // ",
  "tha-ap56:2.1": "Nahānakāle ca bodhiyā ",
  "tha-ap56:2.2": "mahāmegho pavassatha / ",
  "tha-ap56:2.3": "ninnādo ca mahā ahu ",
  "tha-ap56:2.4": "*asaniyā phalantiyā.* // // ",
  "tha-ap56:3.1": "Tena 'vāsanivegena ",
  "tha-ap56:3.2": "tattha kālakato ahaṃ / ",
  "tha-ap56:3.3": "devaloke ṭhito santo ",
  "tha-ap56:3.4": "imā gāthā abhās' ahaṃ: // // ",
  "tha-ap56:4.1": "Aho Buddhā aho dhammā ",
  "tha-ap56:4.2": "aho no satthu sampadā / ",
  "tha-ap56:4.3": "kalebaram me patitaṃ ",
  "tha-ap56:4.4": "devaloke ramām' ahaṃ. // // ",
  "tha-ap56:5.1": "Ubbiddhaṃ bhavanaṃ ma*yhaṃ ",
  "tha-ap56:5.2": "satabhūmiṃ samuggataṃ / ",
  "tha-ap56:5.3": "kaññā satasahassāni ",
  "tha-ap56:5.4": "parivārenti maṃ* sadā. // // ",
  "tha-ap56:6.1": "Rogā pi me na vijjanti ",
  "tha-ap56:6.2": "soko mayhaṃ na vijjati / ",
  "tha-ap56:6.3": "pariḷāhaṃ na passāmi ",
  "tha-ap56:6.4": "puññakammass' idaṃ phalaṃ. // // ",
  "tha-ap56:7.1": "Aṭṭhavīse kappasate ",
  "tha-ap56:7.2": "rājā Samvasito ahu / ",
  "tha-ap56:7.3": "sattaratanasampanno ",
  "tha-ap56:7.4": "cakkavattī mahabbalo. // // ",
  "tha-ap56:8.1": "Paṭisambhidā catasso ",
  "tha-ap56:8.2": "vimokhā pi ca aṭṭh' ime / chaḷabhiññā sacchikatā ",
  "tha-ap56:8.3": "kataṃ Buddhassa sāsanan ti. // // ",
  "tha-ap56:9.1": "Itthaṃ sudaṃ āyasmā Gandhodakiyo thero imā gāthāyo abhāsitthā ti. Gandhodakatherassa apadānaṃ samattaṃ. ",
  "tha-ap56:10.1": ""
}
