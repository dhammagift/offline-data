  "tha-ap403:0.3": "",
  "tha-ap403:1.1": "Pabbhārakuṭaṃ nissāya ",
  "tha-ap403:1.2": "Sobhito nāma tāpaso / ",
  "tha-ap403:1.3": "pavattaphalaṃ bhuñjitvā ",
  "tha-ap403:1.4": "vasati pabbatantare. // // ",
  "tha-ap403:2.1": "Aggidārum āharitvā ",
  "tha-ap403:2.2": "ujjālesim ahaṃ tadā / ",
  "tha-ap403:2.3": "uttamatthaṃ gavesanto ",
  "tha-ap403:2.4": "brahmalokupattiyā. // // ",
  "tha-ap403:3.1": "Padumuttaro lokavidū ",
  "tha-ap403:3.2": "āhutīnaṃ paṭiggaho / ",
  "tha-ap403:3.3": "mam uddharitukāmo so ",
  "tha-ap403:3.4": "āgacchi mama santike. // // ",
  "tha-ap403:4.1": "Kiṃ karohi mahāpuññaṃ ",
  "tha-ap403:4.2": "dehi me aggidārukaṃ / ",
  "tha-ap403:4.3": "aham aggiṃ paricare ",
  "tha-ap403:4.4": "tato me suddhi hehiti. // // ",
  "tha-ap403:5.1": "Subhaddako tvaṃ manuja ",
  "tha-ap403:5.2": "deva te tvaṃ pajānasi / ",
  "tha-ap403:5.3": "tuvam aggim paricara ",
  "tha-ap403:5.4": "handa te aggidārukaṃ. // // ",
  "tha-ap403:6.1": "Tato kaṭṭhaṃ gahetvāna ",
  "tha-ap403:6.2": "aggim ujjālayī jino / ",
  "tha-ap403:6.3": "na tattha kaṭṭhaṃ pajjhāyi: ",
  "tha-ap403:6.4": "pāṭihīraṃ mahesino. // // ",
  "tha-ap403:7.1": "Na te aggi pajjalati ",
  "tha-ap403:7.2": "āhutī te na vijjati / ",
  "tha-ap403:7.3": "niratthakaṃ vataṃ tuyham ",
  "tha-ap403:7.4": "aggiṃ paricarassu me. // // ",
  "tha-ap403:8.1": "Kīdiso so mahāvīra ",
  "tha-ap403:8.2": "aggi tava pavuccati / ",
  "tha-ap403:8.3": "mayham pi kathayass' etam ",
  "tha-ap403:8.4": "ubho paricarāmase. // // ",
  "tha-ap403:9.1": "Hetudhammanirodhāya ",
  "tha-ap403:9.2": "kilesājhāpanāya ca / ",
  "tha-ap403:9.3": "issāmacchariyaṃ hitvā: ",
  "tha-ap403:9.4": "tayo ete mam' āhutī. // // ",
  "tha-ap403:10.1": "Kīdiso tvaṃ mahāvīra ",
  "tha-ap403:10.2": "katham gotto 'si mārisa / ",
  "tha-ap403:10.3": "ācārapaṭipatti te ",
  "tha-ap403:10.4": "bāḷham kho mama ruccati. // // ",
  "tha-ap403:11.1": "Khattiyamhi kūle jāto ",
  "tha-ap403:11.2": "abhiññāpāramiṅgato / ",
  "tha-ap403:11.3": "sabbāsavaparikkhīṇo ",
  "tha-ap403:11.4": "n' atthi dāni punabbhavo. // // ",
  "tha-ap403:12.1": "Yadi Buddho 'si sabbaññū ",
  "tha-ap403:12.2": "pabhaṅkara tamonuda / ",
  "tha-ap403:12.3": "namassissāmi taṃ deva ",
  "tha-ap403:12.4": "dukkhass' antakaro tuvaṃ. // // ",
  "tha-ap403:13.1": "Pattharitvājinañ cammaṃ ",
  "tha-ap403:13.2": "nisīdanam adās' ahaṃ / ",
  "tha-ap403:13.3": "nisīda tattha sabbaññū ",
  "tha-ap403:13.4": "upaṭṭhissām' ahaṃ tavaṃ. // // ",
  "tha-ap403:14.1": "Nisīdi bhagavā tattha ",
  "tha-ap403:14.2": "ajinamhi suvitthate / ",
  "tha-ap403:14.3": "nimantayitvā sambuddhaṃ ",
  "tha-ap403:14.4": "pabbatam agamās' ahaṃ. // // ",
  "tha-ap403:15.1": "Khāribhārañ ca pūretvā ",
  "tha-ap403:15.2": "tindukaṃ phalam āhariṃ / ",
  "tha-ap403:15.3": "madhunā yojayitvāna ",
  "tha-ap403:15.4": "phalaṃ Buddhass' adās' ahaṃ. // // ",
  "tha-ap403:16.1": "Mama nijjhāyamānassa ",
  "tha-ap403:16.2": "paribhuñji tadā jino / ",
  "tha-ap403:16.3": "tattha cittaṃ pasādesiṃ ",
  "tha-ap403:16.4": "pekkhanto lokanāyakaṃ. // // ",
  "tha-ap403:17.1": "Padumuttaro lokavidū ",
  "tha-ap403:17.2": "āhutīnaṃ paṭiggaho / ",
  "tha-ap403:17.3": "mam' assame nisīditvā ",
  "tha-ap403:17.4": "imā gāthā abhāsatha: // // ",
  "tha-ap403:18.1": "‘Yo me phalena tappesi ",
  "tha-ap403:18.2": "pasanno sehi pāṇihi / ",
  "tha-ap403:18.3": "tam ahaṃ kittayissāmi; ",
  "tha-ap403:18.4": "suṇotha mama bhāsato: // // ",
  "tha-ap403:19.1": "Pañcavīsatikkhattuṃ so ",
  "tha-ap403:19.2": "devarajjaṃ karissati / ",
  "tha-ap403:19.3": "sahassakkhattuṃ rājā ca ",
  "tha-ap403:19.4": "cakkavattī bhavissati. // // ",
  "tha-ap403:20.1": "Tassa saṅkappam aññāya ",
  "tha-ap403:20.2": "pubbakammasamaṅgino / ",
  "tha-ap403:20.3": "annaṃ pānañ ca vatthañ ca ",
  "tha-ap403:20.4": "sayanañ ca mahārahaṃ // // ",
  "tha-ap403:21.1": "Puññakammena saṃyuttā ",
  "tha-ap403:21.2": "nibbattissanti tāvade / ",
  "tha-ap403:21.3": "sadā pamudito cāyaṃ ",
  "tha-ap403:21.4": "bhavissati anāmayo. // // ",
  "tha-ap403:22.1": "Upapajjati yaṃ yoniṃ ",
  "tha-ap403:22.2": "devattam atha mānusaṃ / ",
  "tha-ap403:22.3": "sabbattha sukhito hutvā ",
  "tha-ap403:22.4": "manussattaṃ bhavissati. // // ",
  "tha-ap403:23.1": "Ajjhāyako mantadharo ",
  "tha-ap403:23.2": "tiṇṇavedāna pāragū / ",
  "tha-ap403:23.3": "sambuddham upagantvāna ",
  "tha-ap403:23.4": "arahā so bhavissati.' // // ",
  "tha-ap403:24.1": "Yato sarāmi attānaṃ ",
  "tha-ap403:24.2": "yato patto 'smi viññutaṃ / ",
  "tha-ap403:24.3": "bhoge me ūnatā n' atthi ",
  "tha-ap403:24.4": "phaladānass' idaṃ phalaṃ. // // ",
  "tha-ap403:25.1": "Varadhammam anuppatto ",
  "tha-ap403:25.2": "rāgadose samūhaniṃ / ",
  "tha-ap403:25.3": "sabbāsavaparikkhīṇo ",
  "tha-ap403:25.4": "n' atthi dāni punabbhavo. // // ",
  "tha-ap403:26.1": "Kilesā . . . pe . . . ",
  "tha-ap403:26.2": "pe . . . // // ",
  "tha-ap403:26.3": "",
  "tha-ap403:26.4": "Sāgataṃ . . . ",
  "tha-ap403:27.1": "pe . . . ",
  "tha-ap403:27.2": "",
  "tha-ap403:27.3": "pe . . . // // ",
  "tha-ap403:27.4": "",
  "tha-ap403:28.1": "Paṭisambhidā . . . pe . . . ",
  "tha-ap403:28.2": "",
  "tha-ap403:28.3": "pe . . . // // ",
  "tha-ap403:28.4": "",
  "tha-ap403:29.1": "Itthaṃ sudam āyasmā Tissametteyyo thero i. g. a-ti. Tissametteyyattherassa ",
  "tha-ap403:30.1": "apadānaṃ samattaṃ. "
}
