  "tha-ap247:1.1": "Siddhatthassa bhagavato ",
  "tha-ap247:1.2": "ahosiṃ kuṭigopako / ",
  "tha-ap247:1.3": "kālena kālaṃ dhūpesiṃ ",
  "tha-ap247:1.4": "pasanno sehi pāṇihi. // // Catunavute ",
  "tha-ap247:2.1": "ito kappe ",
  "tha-ap247:2.2": "yaṃ kammam akariṃ tadā / ",
  "tha-ap247:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap247:2.4": "Buddhapūjāy' idaṃ phalaṃ. // // ",
  "tha-ap247:3.1": "Paṭisambhidā . . . ",
  "tha-ap247:3.2": "pe . . . ",
  "tha-ap247:3.3": "pe . . . // // ",
  "tha-ap247:4.1": "Itthaṃ sudam āyasmā Kuṭidhūpako thero i. g. a-ti. Kuṭidhūpakattherassa ",
  "tha-ap247:5.1": "apadānaṃ samattaṃ. "
}
