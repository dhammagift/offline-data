  "tha-ap295:0.2": "",
  "tha-ap295:0.3": "",
  "tha-ap295:1.1": "Putto mama pabbajito ",
  "tha-ap295:1.2": "kāsāyavasano tadā / ",
  "tha-ap295:1.3": "so ca Buddhattaṃ sampatto ",
  "tha-ap295:1.4": "nibbuto lokapūjito. // // ",
  "tha-ap295:2.1": "Vicinanto sakaṃ puttam ",
  "tha-ap295:2.2": "agamaṃ pacchato ahaṃ / ",
  "tha-ap295:2.3": "nibbutassa mahantassa ",
  "tha-ap295:2.4": "citakam agamās' ahaṃ. // // ",
  "tha-ap295:3.1": "Paggayha añjaliṃ tattha ",
  "tha-ap295:3.2": "vanditvā citakam ahaṃ / ",
  "tha-ap295:3.3": "Setacchattañ ca paggayha ",
  "tha-ap295:3.4": "āropesim ahaṃ tadā. // // ",
  "tha-ap295:4.1": "Catunavute ito kappe ",
  "tha-ap295:4.2": "yaṃ chattam abhiropayiṃ / ",
  "tha-ap295:4.3": "duggatiṃ nābhijānāmi ",
  "tha-ap295:4.4": "chattadānass' idaṃ phalaṃ. // // ",
  "tha-ap295:5.1": "Pañcavīse ito kappe ",
  "tha-ap295:5.2": "satta āsuṃ janādhipā / ",
  "tha-ap295:5.3": "Mahārahā-sanāmā te ",
  "tha-ap295:5.4": "cakkavattī mahabbalā. // // ",
  "tha-ap295:6.1": "Paṭisambhidā . . . ",
  "tha-ap295:6.2": "pe . . . ",
  "tha-ap295:6.3": "pe . . . // // ",
  "tha-ap295:7.1": "Itthaṃ sudam āyasmā Chattadāyako thero i. g. a-ti. Chattadāyakattherassa ",
  "tha-ap295:8.1": "apadānaṃ samattaṃ. "
}
