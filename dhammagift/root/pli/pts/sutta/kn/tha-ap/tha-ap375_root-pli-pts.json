  "tha-ap375:0.3": "",
  "tha-ap375:1.1": "Candabhāgānadītīre ",
  "tha-ap375:1.2": "ahosiṃ vānaro tadā / ",
  "tha-ap375:1.3": "addasaṃ virajaṃ Buddhaṃ ",
  "tha-ap375:1.4": "nisinnaṃ pabbatantare, // // ",
  "tha-ap375:2.1": "Obhāsentaṃ disā sabbā ",
  "tha-ap375:2.2": "sāla *rājaṃ* va phullitaṃ / ",
  "tha-ap375:2.3": "lakkhaṇavyañjanūpetaṃ disvā ",
  "tha-ap375:2.4": "attamano ahaṃ. // // ",
  "tha-ap375:3.1": "Udaggacitto sumano ",
  "tha-ap375:3.2": "pītiyā haṭṭhamāṇaso / ",
  "tha-ap375:3.3": "tīṇi uppaḷapupphāni ",
  "tha-ap375:3.4": "matthake abhiropayiṃ. // // ",
  "tha-ap375:4.1": "Pūjayitvāna pupphāni ",
  "tha-ap375:4.2": "Phussassātha mahesino / ",
  "tha-ap375:4.3": "sagāravo bhavitvāna ",
  "tha-ap375:4.4": "pakkāmiṃ uttarāmukho. // // ",
  "tha-ap375:5.1": "Gacchanto paṭikuṭiko ",
  "tha-ap375:5.2": "vippasannena cetasā / ",
  "tha-ap375:5.3": "selantare patitvāna ",
  "tha-ap375:5.4": "pāpuṇiṃ jīvitakkhayaṃ. // // ",
  "tha-ap375:6.1": "Tena kammena sukatena ",
  "tha-ap375:6.2": "cetanāpaṇidhīhi ca / ",
  "tha-ap375:6.3": "jahitvā purimaṃ jātiṃ ",
  "tha-ap375:6.4": "Tāvatiṃsam agacch' ahaṃ. // // ",
  "tha-ap375:7.1": "Satānaṃ tīṇikhattuñ ca ",
  "tha-ap375:7.2": "devarajjam akārayiṃ / ",
  "tha-ap375:7.3": "satānaṃ pañcakhattuñ ca ",
  "tha-ap375:7.4": "cakkavatti ahos' ahaṃ. // // ",
  "tha-ap375:8.1": "Dvenavut' ito kappe ",
  "tha-ap375:8.2": "yaṃ puppham abhipūjayiṃ / ",
  "tha-ap375:8.3": "duggatiṃ nābhijānāmi ",
  "tha-ap375:8.4": "Buddhapūjāy' idaṃ phalaṃ. // // ",
  "tha-ap375:9.1": "Paṭisambhidā . . . ",
  "tha-ap375:9.2": "pe . . . ",
  "tha-ap375:9.3": "pe . . . // // ",
  "tha-ap375:10.1": "Itthaṃ sudam āyasmā Tīṇuppalamāliyo th. i. g. a-ti. Tīṇuppalamāliyattherassa apadānaṃ samattaṃ. ",
  "tha-ap375:11.1": ""
}
