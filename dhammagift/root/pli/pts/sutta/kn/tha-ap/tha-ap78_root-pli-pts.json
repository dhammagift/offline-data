  "tha-ap78:0.1": "",
  "tha-ap78:0.2": "",
  "tha-ap78:0.3": "",
  "tha-ap78:1.1": "",
  "tha-ap78:1.2": "mahājātassaro ahū / ",
  "tha-ap78:1.3": "satapattehi sañchanno ",
  "tha-ap78:1.4": "nānāsakuṇamālayo. // // ",
  "tha-ap78:2.1": "Tamhi nahātvā pivitvā ca ",
  "tha-ap78:2.2": "avidūre vasām' ahaṃ / ",
  "tha-ap78:2.3": "addasaṃ samaṇānaggaṃ ",
  "tha-ap78:2.4": "gacchantaṃ anilañjase. // // ",
  "tha-ap78:3.1": "Mama saṅkappām aññāya ",
  "tha-ap78:3.2": "satthā loke anuttaro / ",
  "tha-ap78:3.3": "abbhato oruhitvāna ",
  "tha-ap78:3.4": "bhūmiy' aṭṭhāsi tāvade. // // ",
  "tha-ap78:4.1": "Visāṇena tiṇaṃ gayha ",
  "tha-ap78:4.2": "nisīdanam adās' ahaṃ / ",
  "tha-ap78:4.3": "nisīdi bhagavā tattha ",
  "tha-ap78:4.4": "Tisso lokavināyako. // // ",
  "tha-ap78:5.1": "Sakaṃ cittaṃ pasādetvā ",
  "tha-ap78:5.2": "avandiṃ lokanāyakaṃ / ",
  "tha-ap78:5.3": "paṭikuṭiko avasakkiṃ ",
  "tha-ap78:5.4": "nijjhāyanto mahāmuniṃ. // // ",
  "tha-ap78:6.1": "Tena cittappasādena ",
  "tha-ap78:6.2": "Nimmānaṃ upapajj' ahaṃ / ",
  "tha-ap78:6.3": "duggatiṃ nābhijānāmi ",
  "tha-ap78:6.4": "santhārassa idaṃ phalaṃ. // // ",
  "tha-ap78:7.1": "Ito dutiyake kappe ",
  "tha-ap78:7.2": "Migasammata-khattiyo / ",
  "tha-ap78:7.3": "sattaratanasampanno ",
  "tha-ap78:7.4": "cakkavattī mahabbalo. // // ",
  "tha-ap78:8.1": "Paṭisambhidā catasso ",
  "tha-ap78:8.2": "vimokhā pi ca aṭṭh' ime / chaḍabhiññā sacchikatā ",
  "tha-ap78:8.3": "kataṃ Buddhassa sāsanan ti. // // ",
  "tha-ap78:9.1": "Itthaṃ sudaṃ āyasmā Tiṇasanthārako thero imā gāthāyo abhāsitthā ti. ",
  "tha-ap78:10.1": "Tiṇasanthāradāyakatherassa apadānaṃ samattaṃ. "
}
