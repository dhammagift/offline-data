  "tha-ap183:0.1": "",
  "tha-ap183:0.2": "",
  "tha-ap183:0.3": "",
  "tha-ap183:1.1": "Suvaṇṇavaṇṇaṃ sambuddhaṃ ",
  "tha-ap183:1.2": "sataraṃsīva uggataṃ / ",
  "tha-ap183:1.3": "disaṃ anuvilokentaṃ ",
  "tha-ap183:1.4": "gacchantam anilañjase // // ",
  "tha-ap183:2.1": "Kuṭajaṃ pupphitaṃ disvā ",
  "tha-ap183:2.2": "haṃ vitthatasamotthaṭaṃ / ",
  "tha-ap183:2.3": "rukkhato ocinitvāna ",
  "tha-ap183:2.4": "Phussassa abhiropayiṃ // // ",
  "tha-ap183:3.1": "Dvenavute ito kappe ",
  "tha-ap183:3.2": "yaṃ puppham abhiropayiṃ / ",
  "tha-ap183:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap183:3.4": "Buddhapūjāy' idaṃ phalaṃ. // // ",
  "tha-ap183:4.1": "Ito sattarase kappe ",
  "tha-ap183:4.2": "tayo āsiṃsu Pupphitā / ",
  "tha-ap183:4.3": "sattaratanasampannā ",
  "tha-ap183:4.4": "cakkavattī mahabbalā. // // ",
  "tha-ap183:5.1": "Paṭisambhidā . . . pe . . . ",
  "tha-ap183:5.2": "",
  "tha-ap183:5.3": "pe . . . // // ",
  "tha-ap183:5.4": "",
  "tha-ap183:6.1": "Itthaṃ sudaṃ āyasmā Kuṭajapupphiyo thero i. g. ā-ti. Kuṭajapupphiyattherassa ",
  "tha-ap183:7.1": "apadānaṃ samattaṃ. "
}
