  "tha-ap58:0.3": "",
  "tha-ap58:1.1": "Padumuttarabuddhassa ",
  "tha-ap58:1.2": "piṇḍapātaṃ adās' ahaṃ / ",
  "tha-ap58:1.3": "gantvā taṃ bhojanaṭṭhānaṃ ",
  "tha-ap58:1.4": "mallikāhi parikkh*ittaṃ. // // ",
  "tha-ap58:2.1": "Tamh' āsanamhi* āsīno ",
  "tha-ap58:2.2": "Buddho lokagganāyako / ",
  "tha-ap58:2.3": "akittayi piṇḍapātaṃ ",
  "tha-ap58:2.4": "ujubhūto samāhito: // // ",
  "tha-ap58:3.1": "‘Yathāpi bhaddake khette ",
  "tha-ap58:3.2": "bījaṃ appam pi ropitaṃ / ",
  "tha-ap58:3.3": "sammādhāraṃ pavecchante ",
  "tha-ap58:3.4": "phalaṃ toseti kassakaṃ. // // ",
  "tha-ap58:4.1": "*Tath' evāyaṃ piṇḍapāto ",
  "tha-ap58:4.2": "sukhe*tte ropito tayā / ",
  "tha-ap58:4.3": "bhave nibbattamānamhi ",
  "tha-ap58:4.4": "phalato tosayissati.' // // ",
  "tha-ap58:5.1": "Idaṃ vatvāna sambuddho ",
  "tha-ap58:5.2": "Jalajuttamanāmako / ",
  "tha-ap58:5.3": "piṇḍapātaṃ thavitvāna ",
  "tha-ap58:5.4": "pakkāmi uttarāmukho. // // ",
  "tha-ap58:6.1": "Saṃvuto pātimokkhasmi ",
  "tha-ap58:6.2": "indriyesu ca pañcasu / ",
  "tha-ap58:6.3": "pav*ivekaṃ anuyutto* ",
  "tha-ap58:6.4": "viharāmi anāsavo. // // ",
  "tha-ap58:7.1": "Paṭisambhidā catasso ",
  "tha-ap58:7.2": "vimokhā pi ca aṭṭh' ime / chaḷabhiññā sacchikatā ",
  "tha-ap58:7.3": "kataṃ Buddhassa sāsanan ti. // // ",
  "tha-ap58:8.1": "Itthaṃ sudaṃ āyasmā Saparivārāsano thero imā gāthāyo abhāsitthā ti. ",
  "tha-ap58:9.1": "Saparivārāsanattherassa apadānaṃ samattaṃ. "
}
