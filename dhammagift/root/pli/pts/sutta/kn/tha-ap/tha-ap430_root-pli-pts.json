  "tha-ap430:0.3": "",
  "tha-ap430:1.1": "Nagare Haṃsavatiyā ",
  "tha-ap430:1.2": "ahosiṃ kassako tadā / ",
  "tha-ap430:1.3": "kasikammena jīvāmi ",
  "tha-ap430:1.4": "tena posemi dārake. // // ",
  "tha-ap430:2.1": "Susampannaṃ tadā khettaṃ ",
  "tha-ap430:2.2": "dhaññaṃ me phalitam ahu / ",
  "tha-ap430:2.3": "pākakāle ca sampatte ",
  "tha-ap430:2.4": "evaṃ cintes' ahaṃ tadā: // // ",
  "tha-ap430:3.1": "Nacchannaṃ nappaṭirūpaṃ ",
  "tha-ap430:3.2": "jānantassa guṇā*gu*ṇaṃ / ",
  "tha-ap430:3.3": "yo 'haṃ saṅghe adatvāna ",
  "tha-ap430:3.4": "aggaṃ bhuñjeyya 'maṃ tadā. // // ",
  "tha-ap430:4.1": "Ayaṃ Buddho asamasamo ",
  "tha-ap430:4.2": "battiṃsavaralakkhaṇo / ",
  "tha-ap430:4.3": "tato pabhāvito saṅgho ",
  "tha-ap430:4.4": "puññakkhetto anuttaro. // // ",
  "tha-ap430:5.1": "Tattha dassām' ahaṃ dānaṃ ",
  "tha-ap430:5.2": "navasassaṃ pure pure / ",
  "tha-ap430:5.3": "evāhaṃ cintayitvāna ",
  "tha-ap430:5.4": "haṭṭho pīṇitamānaso. // // ",
  "tha-ap430:6.1": "Khettato dhaññam āharitvā ",
  "tha-ap430:6.2": "sambuddham upasaṅkamiṃ / ",
  "tha-ap430:6.3": "upasaṅkamma sambuddhaṃ ",
  "tha-ap430:6.4": "lokajeṭṭhaṃ narāsabhaṃ / ",
  "tha-ap430:6.5": "vanditvā satthuno pāde ",
  "tha-ap430:6.6": "imaṃ vacanam abraviṃ: // // ",
  "tha-ap430:7.1": "Navasassañ ca sampannam ",
  "tha-ap430:7.2": "āyāgo pi ca taṃ mune / ",
  "tha-ap430:7.3": "anukampam upādāya ",
  "tha-ap430:7.4": "adhivāsehi cakkhumā. // // ",
  "tha-ap430:8.1": "Padumuttaro lokavidū ",
  "tha-ap430:8.2": "āhutīnaṃ paṭiggaho / ",
  "tha-ap430:8.3": "mamaṃ saṅkappam aññāya imaṃ ",
  "tha-ap430:8.4": "vacanam abraviṃ: // // ",
  "tha-ap430:9.1": "Cattāro ca paṭipannā ",
  "tha-ap430:9.2": "cattāro ca phale ṭhitā / ",
  "tha-ap430:9.3": "esa saṅgho ujubhūto ",
  "tha-ap430:9.4": "paññā-sīla-samāhito // // ",
  "tha-ap430:9.5": "Yajantānaṃ manussānaṃ ",
  "tha-ap430:9.6": "puññapekkhāna pāṇinaṃ / ",
  "tha-ap430:10.1": "karontaṃ opadhikaṃ puññaṃ ",
  "tha-ap430:10.2": "saṅghe dinnaṃ mahapphalaṃ. // // ",
  "tha-ap430:10.3": "Tasmiṃ saṅghe ca dātabbaṃ ",
  "tha-ap430:10.4": "navasassaṃ tathetaraṃ / ",
  "tha-ap430:11.1": "saṅghato uddisitvāna ",
  "tha-ap430:11.2": "bhikkhū netvāna saṃ gharaṃ / ",
  "tha-ap430:11.3": "paṭiyattaṃ ghare yan te ",
  "tha-ap430:11.4": "bhikkhusaṅghassa dehi tvaṃ' // // ",
  "tha-ap430:12.1": "Saṅghato uddisitvāna ",
  "tha-ap430:12.2": "bhikkhū netvāna 'haṃ gharaṃ / ",
  "tha-ap430:12.3": "yaṃ ghare paṭiyattaṃ me ",
  "tha-ap430:12.4": "bhikkhusaṅghassa dās' ahaṃ. // // ",
  "tha-ap430:13.1": "Tena kammena sukatena ",
  "tha-ap430:13.2": "cetanāpaṇidhīhi ca / ",
  "tha-ap430:13.3": "jahitvā mānusaṃ dehaṃ ",
  "tha-ap430:13.4": "Tāvatiṃsam agacch' ahaṃ. // // ",
  "tha-ap430:14.1": "Tattha me sukataṃ vyamhaṃ ",
  "tha-ap430:14.2": "sovaṇṇaṃ sappabhassaraṃ / ",
  "tha-ap430:14.3": "saṭṭhiyojanam ubbiddhaṃ ",
  "tha-ap430:14.4": "tiṃsayojanavitthataṃ. // // ",
  "tha-ap430:15.1": "",
  "tha-ap430:16.1": "Ākiṇṇaṃ bhavanaṃ mayhaṃ ",
  "tha-ap430:16.2": "nārīgaṇasamākulaṃ / ",
  "tha-ap430:16.3": "tattha bhutvā pivitvā ca ",
  "tha-ap430:16.4": "vasāmi Tidase ahaṃ. // // ",
  "tha-ap430:17.1": "Satānaṃ tīṇikkhattuñ ca ",
  "tha-ap430:17.2": "devarajjam akārayiṃ / ",
  "tha-ap430:17.3": "satānaṃ pañcakkhattuñ ca ",
  "tha-ap430:17.4": "cakkavattī ahos' ahaṃ / ",
  "tha-ap430:17.5": "padesarajjaṃ vipulaṃ ",
  "tha-ap430:17.6": "gaṇanāto asaṅkhiyaṃ. // // ",
  "tha-ap430:18.1": "Bhavābhave saṃsaranto ",
  "tha-ap430:18.2": "labhāmi amitaṃ dhanaṃ / ",
  "tha-ap430:18.3": "bhoge me ūnatā n' atthi ",
  "tha-ap430:18.4": "navasassass' idaṃ phalaṃ. // // ",
  "tha-ap430:19.1": "Hatthiyānaṃ assayānaṃ ",
  "tha-ap430:19.2": "sivikaṃ sandamānikaṃ / ",
  "tha-ap430:19.3": "labhāmi sabbam ev' etaṃ ",
  "tha-ap430:19.4": "navasassass' idaṃ phalaṃ. // // ",
  "tha-ap430:20.1": "Navavatthaṃ navaphalaṃ ",
  "tha-ap430:20.2": "nav' agga-rasa-bhojanaṃ / ",
  "tha-ap430:20.3": "labhāmi sabbam ev' etaṃ ",
  "tha-ap430:20.4": "navasassass' idaṃ phalaṃ. // // ",
  "tha-ap430:21.1": "Koseyyakambaliyyāni ",
  "tha-ap430:21.2": "khomakappāsikāni ca / ",
  "tha-ap430:21.3": "labhāmi sabbam ev' etaṃ ",
  "tha-ap430:21.4": "navasassass' idaṃ phalaṃ. // // ",
  "tha-ap430:22.1": "Dāsīgaṇaṃ dāsagaṇaṃ ",
  "tha-ap430:22.2": "nāriyo ca alaṅkatā / ",
  "tha-ap430:22.3": "labhāmi . . . pe . . . ",
  "tha-ap430:22.4": "pe . . . // // ",
  "tha-ap430:23.1": "Na maṃ sītaṃ vā uṇhaṃ vā ",
  "tha-ap430:23.2": "pariḷāho na vijjati / ",
  "tha-ap430:23.3": "atho cetasikaṃ dukkaṃ ",
  "tha-ap430:23.4": "hadaye me na vijjati. // // ",
  "tha-ap430:24.1": "Imaṃ khāda imaṃ bhuñja ",
  "tha-ap430:24.2": "imamhi sayane saya / ",
  "tha-ap430:24.3": "labhāmi . . . pe . . . ",
  "tha-ap430:24.4": "pe . . . // // ",
  "tha-ap430:25.1": "Ayaṃ pacchimako dāni ",
  "tha-ap430:25.2": "carimo vattate bhavo / ",
  "tha-ap430:25.3": "ajjāpi deyyadhamme me ",
  "tha-ap430:25.4": "phalaṃ toseti sabbadā. // // ",
  "tha-ap430:26.1": "Navasassaṃ daditvāna ",
  "tha-ap430:26.2": "saṅghe guṇavaruttame / ",
  "tha-ap430:26.3": "aṭṭhānisaṃse anubhom' ",
  "tha-ap430:26.4": "kammānucchavike mama. // // ",
  "tha-ap430:27.1": "Vaṇṇavā yāsavā homi ",
  "tha-ap430:27.2": "mahābhogo anītiko / ",
  "tha-ap430:27.3": "mahāpakkho sadā homi ",
  "tha-ap430:27.4": "abhejjapariso sadā. // // ",
  "tha-ap430:28.1": "Sabbe mam apacāyanti ",
  "tha-ap430:28.2": "ye keci paṭhaviṃ-sitā / ",
  "tha-ap430:28.3": "deyyadhammā ca ye keci ",
  "tha-ap430:28.4": "pure pure labhām' ahaṃ. // // ",
  "tha-ap430:29.1": "Bhikkhusaṅghassa vā majjhe ",
  "tha-ap430:29.2": "Buddhaseṭṭhassa sammukhā / ",
  "tha-ap430:29.3": "sabbe pi samatikkamma ",
  "tha-ap430:29.4": "denti mayh' eva dāyakā. // // ",
  "tha-ap430:30.1": "Paṭhamaṃ navasassam hi ",
  "tha-ap430:30.2": "datvā saṅghe gaṇuttame / ",
  "tha-ap430:30.3": "imānisaṃse anubhom' ",
  "tha-ap430:30.4": "navasassass' idaṃ phalaṃ. // // ",
  "tha-ap430:31.1": "Satasahass' ito kappe ",
  "tha-ap430:31.2": "yaṃ dānam adadiṃ tadā / ",
  "tha-ap430:31.3": "duggatim nābhijānāmi ",
  "tha-ap430:31.4": "navasassass' idaṃ phalaṃ. // // ",
  "tha-ap430:32.1": "Kilesā . . . ",
  "tha-ap430:32.2": "pe . . . ",
  "tha-ap430:32.3": "",
  "tha-ap430:33.1": "",
  "tha-ap430:33.2": "pe . . . ",
  "tha-ap430:33.3": "pe . . . // // Sāgataṃ . . . pe . . . pe . . . pe . . . // // ",
  "tha-ap430:34.1": "Paṭisambhidā . . . ",
  "tha-ap430:34.2": "pe . . . ",
  "tha-ap430:34.3": "pe . . . pe . . . // // ",
  "tha-ap430:35.1": "Itthaṃ sudam āyasmā Sucintito thero i. g. a-ti. Sucintitattherassa ",
  "tha-ap430:36.1": "apadānaṃ samattaṃ. "
}
