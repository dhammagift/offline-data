  "tha-ap280:1.1": "Pabbate Himavantamhi ",
  "tha-ap280:1.2": "Mahāsindhu sudassano / ",
  "tha-ap280:1.3": "tatth' addasaṃ vītarāgaṃ ",
  "tha-ap280:1.4": "sappabhāsaṃ sudassanaṃ. // // ",
  "tha-ap280:2.1": "Paramopasame yuttaṃ ",
  "tha-ap280:2.2": "disvā taṃ vimhitāsayo / ",
  "tha-ap280:2.3": "āluvan tassa pādāsiṃ ",
  "tha-ap280:2.4": "pasanno sehi pāṇihi. // // ",
  "tha-ap280:3.1": "Ekatiṃse ito kappe ",
  "tha-ap280:3.2": "yam āluvam adaṃ tadā / ",
  "tha-ap280:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap280:3.4": "āluvassa idaṃ phalaṃ. // // ",
  "tha-ap280:4.1": "Paṭisambhidā . . . ",
  "tha-ap280:4.2": "pe . . . ",
  "tha-ap280:4.3": "pe . . . // // ",
  "tha-ap280:5.1": "Itthaṃ sudam āyasmā Āluvadāyako thero i. g. a-ti. Āluvadāyakattherassa apadānaṃ samattaṃ. ",
  "tha-ap280:6.1": ""
}
