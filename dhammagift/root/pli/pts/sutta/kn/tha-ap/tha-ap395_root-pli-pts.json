  "tha-ap395:0.3": "",
  "tha-ap395:1.1": "jalitaṃ ",
  "tha-ap395:1.2": "dīparukkhaṃ va jotitaṃ / ",
  "tha-ap395:1.3": "osadhiṃ va virocantaṃ ",
  "tha-ap395:1.4": "vijjuṃ abbhaghane yathā // // ",
  "tha-ap395:2.1": "Asambhītam anuttāsiṃ ",
  "tha-ap395:2.2": "migarājaṃ va kesariṃ / ",
  "tha-ap395:2.3": "ñāṇālokaṃ pakāsentaṃ ",
  "tha-ap395:2.4": "maddantaṃ titthiye gaṇe // // ",
  "tha-ap395:3.1": "Uddharantam imaṃ lokaṃ ",
  "tha-ap395:3.2": "chindantaṃ sabbasaṃsayaṃ / ",
  "tha-ap395:3.3": "lasantaṃ migarājaṃ va ",
  "tha-ap395:3.4": "addasaṃ lokanāyakaṃ. // // ",
  "tha-ap395:4.1": "Jaṭājinadharo āsiṃ ",
  "tha-ap395:4.2": "brahā uju patāpavā / ",
  "tha-ap395:4.3": "*vā*kacīraṃ gahetvāna ",
  "tha-ap395:4.4": "pādamūle apatthariṃ. // // ",
  "tha-ap395:5.1": "Kāḷānusārikaṃ gayha ",
  "tha-ap395:5.2": "anulimpin Tathāgataṃ / ",
  "tha-ap395:5.3": "sambuddham anulimpitvā ",
  "tha-ap395:5.4": "santhaviṃ lokanāyakaṃ. // // ",
  "tha-ap395:6.1": "Samuddharas' imaṃ lokam ",
  "tha-ap395:6.2": "oghatiṇṇa mahāmuni / ",
  "tha-ap395:6.3": "ñāṇālokena jotesi ",
  "tha-ap395:6.4": "vajirañāṇam uttamaṃ. // // ",
  "tha-ap395:7.1": "Dhammacakkaṃ pavattesi ",
  "tha-ap395:7.2": "maddase paratitthiye / ",
  "tha-ap395:7.3": "usabho jitasaṅgāme ",
  "tha-ap395:7.4": "sampakampesi mediniṃ. // // ",
  "tha-ap395:8.1": "Mahāsamudde ūmī va ",
  "tha-ap395:8.2": "velantamhi pabhijjare / ",
  "tha-ap395:8.3": "tath' eva tava ñāṇamhi ",
  "tha-ap395:8.4": "sabbā diṭṭhī pabhijjare. // // ",
  "tha-ap395:9.1": "Sukhumacchikajāle va ",
  "tha-ap395:9.2": "saramhi sampatānite / ",
  "tha-ap395:9.3": "antojāligatā pāṇā ",
  "tha-ap395:9.4": "pīḷitā honti tāvade. // // ",
  "tha-ap395:10.1": "Tath' eva titthiyā loke ",
  "tha-ap395:10.2": "phuṭā saccavinissitā / ",
  "tha-ap395:10.3": "anto ñāṇavare tuyhaṃ ",
  "tha-ap395:10.4": "parivattanti mārisa. // // ",
  "tha-ap395:11.1": "Patiṭṭhā vuyhataṃ oghe ",
  "tha-ap395:11.2": "tvam hi nātho abandhanaṃ / ",
  "tha-ap395:11.3": "bhayāṭṭitānaṃ saraṇo ",
  "tha-ap395:11.4": "muttatthīnaṃ parāyano. // // ",
  "tha-ap395:12.1": "Ekavīro asadiso ",
  "tha-ap395:12.2": "mettākāruṇādisañcayo / susīlo ",
  "tha-ap395:12.3": "asamo santo ",
  "tha-ap395:12.4": "vasitavijitañjayo. // // ",
  "tha-ap395:13.1": "Dhīro vigatasammoho ",
  "tha-ap395:13.2": "anejo akathaṃ kathī / ",
  "tha-ap395:13.3": "vusito vantadoso 'si ",
  "tha-ap395:13.4": "nimmalo payato suci. // // ",
  "tha-ap395:14.1": "Saṅgh' ātīto gatamado ",
  "tha-ap395:14.2": "tevijjo tibhavantago / ",
  "tha-ap395:14.3": "sīmātigo dhammagarū ",
  "tha-ap395:14.4": "katattho hitadhammato. // // ",
  "tha-ap395:15.1": "Tārako tvaṃ yāthā nāvā ",
  "tha-ap395:15.2": "nidhi v' assāsakārako / ",
  "tha-ap395:15.3": "asambhīto yathā sīho ",
  "tha-ap395:15.4": "gajarājā va dammito. // // ",
  "tha-ap395:16.1": "Thometvā dasagāthāhi ",
  "tha-ap395:16.2": "Padumuttaraṃ mahāyasaṃ / ",
  "tha-ap395:16.3": "vanditvā satthuno pāde ",
  "tha-ap395:16.4": "tuṇhī aṭṭhās' ahaṃ tadā. // // ",
  "tha-ap395:17.1": "Padumuttaro lokavidū ",
  "tha-ap395:17.2": "āhutīnaṃ paṭiggaho / ",
  "tha-ap395:17.3": "bhikkhusaṅghe ṭhito satthā ",
  "tha-ap395:17.4": "imā gāthā abhāsatha: // // ",
  "tha-ap395:18.1": "Yo me sīlañ ca ñāṇañ ca dhamman ",
  "tha-ap395:18.2": "cāpi pakittayi / ",
  "tha-ap395:18.3": "tam ahaṃ kittayissāmi ",
  "tha-ap395:18.4": "suṇotha mama bhāsato: // // ",
  "tha-ap395:19.1": "Saṭṭhiṃ kappasahassāni ",
  "tha-ap395:19.2": "devaloke ramissati / ",
  "tha-ap395:19.3": "aññe deve adhibhotvā ",
  "tha-ap395:19.4": "isseraṃ kārayissati. // // ",
  "tha-ap395:20.1": "So pacchā pabbajitvāna ",
  "tha-ap395:20.2": "sukkamūlena codito / ",
  "tha-ap395:20.3": "Gotamassa bhagavato ",
  "tha-ap395:20.4": "sāsane pabbajissati. // // ",
  "tha-ap395:21.1": "Pabbajitvāna kāyena ",
  "tha-ap395:21.2": "pāpakammaṃ vivajjiya / ",
  "tha-ap395:21.3": "sabbāsave pariññāya ",
  "tha-ap395:21.4": "nibbāyissat' anāsavo. // // ",
  "tha-ap395:22.1": "Yathāpi megho thanayaṃ ",
  "tha-ap395:22.2": "tappeti medinim imaṃ / ",
  "tha-ap395:22.3": "tath' eva tvaṃ mahāvīra ",
  "tha-ap395:22.4": "thanena tappayī mamaṃ. // // ",
  "tha-ap395:23.1": "Sīlaṃ paññaṃ ca dhamman ca ",
  "tha-ap395:23.2": "thavitvā lokanāyakaṃ / ",
  "tha-ap395:23.3": "patto 'mhi paramaṃ santiṃ ",
  "tha-ap395:23.4": "nibbānaṃ padaṃ accutaṃ. // // ",
  "tha-ap395:24.1": "Api nūn' esa bhagavā ",
  "tha-ap395:24.2": "ciraṃ tiṭṭheyya cakkhumā / ",
  "tha-ap395:24.3": "aññātañ ca vijāneyyaṃ ",
  "tha-ap395:24.4": "phasseyyam amataṃ padaṃ. // // ",
  "tha-ap395:25.1": "Ayaṃ me pacchimā jāti ",
  "tha-ap395:25.2": "bhavā sabbe samūhatā / ",
  "tha-ap395:25.3": "sabbāsave pariññāya ",
  "tha-ap395:25.4": "viharāmi anāsavo. // // ",
  "tha-ap395:26.1": "Satasahasse ito kappe ",
  "tha-ap395:26.2": "yaṃ Buddham abhipūjayiṃ / ",
  "tha-ap395:26.3": "duggatiṃ nābhijānāmi ",
  "tha-ap395:26.4": "kittanāya idaṃ phalaṃ. // // ",
  "tha-ap395:27.1": "Kilesā . . . ",
  "tha-ap395:27.2": "",
  "tha-ap395:27.3": "",
  "tha-ap395:27.4": "",
  "tha-ap395:28.1": "",
  "tha-ap395:28.2": "pe . . . ",
  "tha-ap395:28.3": "pe . . . // // Sāgataṃ . . . pe . . . pe . . . // // ",
  "tha-ap395:29.1": "Paṭisambhidā . . . ",
  "tha-ap395:29.2": "pe . . . ",
  "tha-ap395:29.3": "pe . . . // // ",
  "tha-ap395:30.1": "*Itthaṃ sudam āyasmā Sabbakittiko thero imā gāthāyo abhāsitthāti. Sabbakittikattherassa apadānaṃ samattaṃ.* ",
  "tha-ap395:31.1": ""
}
