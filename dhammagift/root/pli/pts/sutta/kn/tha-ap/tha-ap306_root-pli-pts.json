  "tha-ap306:0.3": "",
  "tha-ap306:1.1": "Vipassino bhagavato ",
  "tha-ap306:1.2": "mahābodhimaho ahu / ",
  "tha-ap306:1.3": "rukkhaṭṭh' ass' eva sambuddho ",
  "tha-ap306:1.4": "lokajeṭṭho narāsabho. // // ",
  "tha-ap306:2.1": "Bhagavā tamhi samaye ",
  "tha-ap306:2.2": "bhikkhusaṅghapurakkhato / ",
  "tha-ap306:2.3": "catusaccaṃ pakāseti ",
  "tha-ap306:2.4": "vācāsabhim udīrayaṃ. // // ",
  "tha-ap306:3.1": "Saṅkhittena ca desento ",
  "tha-ap306:3.2": "vitthāreṇa ca desayaṃ / ",
  "tha-ap306:3.3": "vivattacchaddo sambuddho ",
  "tha-ap306:3.4": "nibbāpesi mahājanaṃ. // // ",
  "tha-ap306:4.1": "Tassāhaṃ dhammaṃ sutvāna ",
  "tha-ap306:4.2": "lokajeṭṭhassa tādino / ",
  "tha-ap306:4.3": "vanditvā satthuno pāde ",
  "tha-ap306:4.4": "pakkāmiṃ uttarāmukho. // // ",
  "tha-ap306:5.1": "Ekanavute ito kappe ",
  "tha-ap306:5.2": "yaṃ dhammam asuṇiṃ tadā / ",
  "tha-ap306:5.3": "duggatiṃ nābhijānāmi ",
  "tha-ap306:5.4": "dhammadānass' idaṃ phalaṃ. // // ",
  "tha-ap306:6.1": "Tettiṃsamhi ito kappe ",
  "tha-ap306:6.2": "eko āsi mahīpati / ",
  "tha-ap306:6.3": "Sutavā nāma nāmena ",
  "tha-ap306:6.4": "cakkavattī mahabbalo. // // ",
  "tha-ap306:7.1": "Paṭisambhidā . . . ",
  "tha-ap306:7.2": "pe . . . ",
  "tha-ap306:7.3": "pe . . . // // ",
  "tha-ap306:8.1": "Itthaṃ sudam āyasmā Dhammasaññako th. i. g. a-ti. Dhammasaññakattherassa apadānaṃ ",
  "tha-ap306:9.1": "samattaṃ. Bhāgīrasī nadītīre "
}
