  "tha-ap83:0.3": "",
  "tha-ap83:1.1": "Candabhāgānadītīre ",
  "tha-ap83:1.2": "anusotaṃ vajām' ahaṃ / ",
  "tha-ap83:1.3": "nisinnaṃ samaṇaṃ disvā ",
  "tha-ap83:1.4": "vippasannam anāvilaṃ. // // ",
  "tha-ap83:2.1": "Tassa cittaṃ pasādetvā ",
  "tha-ap83:2.2": "evaṃ cintes' ahaṃ tadā / ",
  "tha-ap83:2.3": "tārayissati tiṇṇo 'yaṃ ",
  "tha-ap83:2.4": "danto 'yaṃ damayissati. // // ",
  "tha-ap83:3.1": "Assāsessati assattho ",
  "tha-ap83:3.2": "santo ca samayissati / ",
  "tha-ap83:3.3": "mocayissati mutto ca ",
  "tha-ap83:3.4": "nibbāpessati nibbuto. // // ",
  "tha-ap83:4.1": "Evāhaṃ cintayitvāna ",
  "tha-ap83:4.2": "Siddhatthassa mahesino / ",
  "tha-ap83:4.3": "gahetvā timiraṃ pupphaṃ ",
  "tha-ap83:4.4": "matthake okirim ahaṃ. // // ",
  "tha-ap83:5.1": "Añjalippaggahetvāna katvāna ",
  "tha-ap83:5.2": "ca padakkhinaṃ / ",
  "tha-ap83:5.3": "vanditvā satthuno pāde ",
  "tha-ap83:5.4": "pakkāmiṃ aparaṃ disaṃ. // // ",
  "tha-ap83:6.1": "Aciraṃ gatamattaṃ maṃ ",
  "tha-ap83:6.2": "migarājā apīḷayi / ",
  "tha-ap83:6.3": "papātam anugacchanto ",
  "tha-ap83:6.4": "tatth' eva papatiṃ ahaṃ. // // ",
  "tha-ap83:7.1": "Catunavut' ito kappe ",
  "tha-ap83:7.2": "yaṃ puppham abhiropayiṃ / ",
  "tha-ap83:7.3": "duggatiṃ nābhijānāmi ",
  "tha-ap83:7.4": "Buddhapujāy' idaṃ phalaṃ. // // ",
  "tha-ap83:8.1": "Chappaññāsamhi kappamhi ",
  "tha-ap83:8.2": "satt' ev' āsuṃ mahāyasā / ",
  "tha-ap83:8.3": "sattaratanasampannā ",
  "tha-ap83:8.4": "cakkavattī mahabbalā. // // ",
  "tha-ap83:9.1": "Paṭisambhidā catasso ",
  "tha-ap83:9.2": "vimokhā pi ca aṭṭh' ime / ",
  "tha-ap83:9.3": "chaḍabhiññā sacchikatā ",
  "tha-ap83:9.4": "kataṃ Buddhassa sāsanan ti. // // ",
  "tha-ap83:10.1": "Itthaṃ sudaṃ āyasmā Timirapupphiyo thero imā gāthāyo abhāsitthā ti. Timirapupphiyattherassa apadānaṃ samattaṃ. ",
  "tha-ap83:11.1": ""
}
