  "tha-ap458:1.1": "Siddhatthassa bhagavato ",
  "tha-ap458:1.2": "lokajeṭṭhassa tādino / ",
  "tha-ap458:1.3": "vanakoraṇḍam ādāya ",
  "tha-ap458:1.4": "Buddhassa abhiropayiṃ. // // ",
  "tha-ap458:2.1": "Catunavute ito kappe ",
  "tha-ap458:2.2": "yaṃ puppham abhiropayiṃ / ",
  "tha-ap458:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap458:2.4": "Buddhapūjāy' idaṃ phalaṃ. // // ",
  "tha-ap458:3.1": "Kilesā . . . ",
  "tha-ap458:3.2": "pe . . . ",
  "tha-ap458:3.3": "",
  "tha-ap458:4.1": "",
  "tha-ap458:4.2": "pe . . . ",
  "tha-ap458:4.3": "pe . . . // // Sāgataṃ . . . pe . . . pe . . . pe . . . // // ",
  "tha-ap458:5.1": "Paṭisambhidā . . . ",
  "tha-ap458:5.2": "pe . . . ",
  "tha-ap458:5.3": "pe . . . pe . . . // // ",
  "tha-ap458:6.1": "Itthaṃ sudaṃ āyasmā Vanakoraṇḍiyo th. i. g. a- ",
  "tha-ap458:7.1": "ti. Vanakoraṇḍiyattherassa ",
  "tha-ap458:7.2": "apadānaṃ samattaṃ. "
}
