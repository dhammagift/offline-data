  "tha-ap369:1.1": "nāma sambuddho ",
  "tha-ap369:1.2": "Gaṅgākūle vasī tadā / ",
  "tha-ap369:1.3": "uddālakaṃ gahetvāna ",
  "tha-ap369:1.4": "pūjayim aparājitaṃ. // // ",
  "tha-ap369:2.1": "Ekatiṃse ito kappe ",
  "tha-ap369:2.2": "yaṃ puppham abhipūjayiṃ / ",
  "tha-ap369:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap369:2.4": "Buddhapūjāy' idaṃ phalaṃ. // // ",
  "tha-ap369:3.1": "Paṭisambhidā . . . ",
  "tha-ap369:3.2": "pe . . . ",
  "tha-ap369:3.3": "pe . . . // // ",
  "tha-ap369:4.1": "Itthaṃ sudam āyasmā Uddālapupphiyo thero i. g. a-ti. Uddālapupphiyattherassa apadānaṃ samattaṃ. ",
  "tha-ap369:5.1": ""
}
