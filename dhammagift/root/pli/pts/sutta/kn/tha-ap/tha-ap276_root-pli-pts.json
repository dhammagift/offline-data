  "tha-ap276:0.3": "",
  "tha-ap276:1.1": "Koṇḍaññassa bhagavato ",
  "tha-ap276:1.2": "vītarāgassa tādino / ",
  "tha-ap276:1.3": "ākāsasamacittassa ",
  "tha-ap276:1.4": "nippapañcassa jhāyino // // ",
  "tha-ap276:2.1": "Sabbamohānivattassa ",
  "tha-ap276:2.2": "sabbalokahitesino / ",
  "tha-ap276:2.3": "abbhañjanaṃ mayā dinnaṃ ",
  "tha-ap276:2.4": "dipadindassa tādino. // // ",
  "tha-ap276:3.1": "Aparimeyye ito kappe ",
  "tha-ap276:3.2": "*abbhañjanam adaṃ* tadā / ",
  "tha-ap276:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap276:3.4": "abhañjanass' idaṃ phalaṃ. // // ",
  "tha-ap276:4.1": "Ito pannarase kappe ",
  "tha-ap276:4.2": "Cirappo nāma khattiyo / ",
  "tha-ap276:4.3": "sattaratanasampanno ",
  "tha-ap276:4.4": "cakkavattī mahabbalo. // // ",
  "tha-ap276:5.1": "Paṭisambhidā . . . ",
  "tha-ap276:5.2": "pe . . . ",
  "tha-ap276:5.3": "pe . . . // // ",
  "tha-ap276:6.1": "Itthaṃ sudam āyasmā Abbhañjanadāyako thero i. g. a-ti. Abbhañjanadāyakattherassa apadānaṃ samattaṃ. ",
  "tha-ap276:7.1": ""
}
