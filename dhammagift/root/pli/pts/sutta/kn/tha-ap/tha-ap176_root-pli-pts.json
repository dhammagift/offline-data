  "tha-ap176:1.1": "*Vipassino bhagavato ",
  "tha-ap176:1.2": "udapā*no kato mayā / ",
  "tha-ap176:1.3": "piṇḍapātaṃ daditvāna niyyātesiṃ ",
  "tha-ap176:1.4": "ahaṃ tadā. // // ",
  "tha-ap176:2.1": "Ekanavute ito kappe ",
  "tha-ap176:2.2": "yaṃ kammam akarin tadā / ",
  "tha-ap176:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap176:2.4": "udapānass' idaṃ phalaṃ // // ",
  "tha-ap176:3.1": "Paṭisambhida . . . ",
  "tha-ap176:3.2": "pe . . . ",
  "tha-ap176:3.3": "pe . . . // // ",
  "tha-ap176:4.1": "Itthaṃ sudaṃ āyasmā Udapānadāyako thero i. g. a-ti. Udapānadāyakattherassa apadānaṃ samattaṃ. ",
  "tha-ap176:5.1": ""
}
