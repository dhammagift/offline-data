  "tha-ap332:0.1": "",
  "tha-ap332:0.2": "",
  "tha-ap332:0.3": "",
  "tha-ap332:1.1": "Padumuttaro lokavidū ",
  "tha-ap332:1.2": "āhutīnaṃ paṭiggaho / ",
  "tha-ap332:1.3": "ākāse jalavuṭṭhīva ",
  "tha-ap332:1.4": "vassati dhammavuṭṭhiyā. // // ",
  "tha-ap332:2.1": "Tam addasāsiṃ sambuddhaṃ ",
  "tha-ap332:2.2": "desentam amataṃ padaṃ / ",
  "tha-ap332:2.3": "sakaṃ cittaṃ pasādetvā ",
  "tha-ap332:2.4": "agamāsiṃ sakaṃ gharaṃ // // ",
  "tha-ap332:3.1": "Chattam alaṅkataṃ gayha ",
  "tha-ap332:3.2": "upagacchiṃ naruttamaṃ / ",
  "tha-ap332:3.3": "haṭṭho haṭṭhena cittena ",
  "tha-ap332:3.4": "ākāse ukkhipim ahaṃ. // // ",
  "tha-ap332:4.1": "Susaṅgahītayānaṃ va ",
  "tha-ap332:4.2": "danto va sāvakuttamo / ",
  "tha-ap332:4.3": "upagantvāna sambuddhaṃ ",
  "tha-ap332:4.4": "matthake sampatiṭṭhahi. // // ",
  "tha-ap332:5.1": "Anukampako kāruṇiko ",
  "tha-ap332:5.2": "Buddho lokagganāyako / ",
  "tha-ap332:5.3": "bhikkhusaṅghe nisīditvā ",
  "tha-ap332:5.4": "imā gāthā abhāsatha: // // ",
  "tha-ap332:6.1": "‘Yena chattam idaṃ dinnam ",
  "tha-ap332:6.2": "alaṅkataṃ manoramaṃ / ",
  "tha-ap332:6.3": "tena cittappasādena ",
  "tha-ap332:6.4": "duggatiṃ so na gacchati. // // ",
  "tha-ap332:7.1": "Sattakkhattuñ ca devesu ",
  "tha-ap332:7.2": "devarajjaṃ karissati / ",
  "tha-ap332:7.3": "chattiṃsakkhattuṃ rājā ca ",
  "tha-ap332:7.4": "cakkavattī bhavissati. // // ",
  "tha-ap332:8.1": "Kappasatasahassamhi ",
  "tha-ap332:8.2": "Okkākakulasambhavo / ",
  "tha-ap332:8.3": "Gotamo nāma nāmena ",
  "tha-ap332:8.4": "satthā loke bhavissati. // // ",
  "tha-ap332:9.1": "Tassa dhammesu dāyādo ",
  "tha-ap332:9.2": "oraso dhammanimmito / ",
  "tha-ap332:9.3": "sabbāsave pariññāya ",
  "tha-ap332:9.4": "nibbāyissat' anāsavo.' // // ",
  "tha-ap332:10.1": "Buddhassa giram aññāya ",
  "tha-ap332:10.2": "vācāsabhim udīritaṃ / ",
  "tha-ap332:10.3": "pasannacitto sumano ",
  "tha-ap332:10.4": "bhiyyobhāsaṃ janes' ahaṃ. // // ",
  "tha-ap332:11.1": "Jahitvā mānusaṃ yoniṃ ",
  "tha-ap332:11.2": "devayoniṃ samajjhagaṃ / ",
  "tha-ap332:11.3": "vimānam uttamaṃ mayham ",
  "tha-ap332:11.4": "abbhuggataṃ manoramaṃ. // // ",
  "tha-ap332:12.1": "Vimānā nikkhamantassa ",
  "tha-ap332:12.2": "setacchattaṃ dhāriyati ",
  "tha-ap332:12.3": "tadā / saññaṃ paṭilabhāmi ",
  "tha-ap332:12.4": "pubbakammass' idaṃ phalaṃ. // // ",
  "tha-ap332:13.1": "Devalokā cavitvāna ",
  "tha-ap332:13.2": "manussattañ ca āgacchiṃ / ",
  "tha-ap332:13.3": "chattiṃsakkhattuñ cakkavattī ",
  "tha-ap332:13.4": "sattakappasatamhi 'to. // // ",
  "tha-ap332:14.1": "Tamhā kāyā cavitvāna ",
  "tha-ap332:14.2": "āgacchaṃ tidasaṃ puraṃ / ",
  "tha-ap332:14.3": "saṃsaritvānupubbena ",
  "tha-ap332:14.4": "mānussaṃ punar āgamaṃ. // // ",
  "tha-ap332:15.1": "Okkantam mātukucchiṃ maṃ ",
  "tha-ap332:15.2": "setacchattam adhārayuṃ / ",
  "tha-ap332:15.3": "Jātiyā sattavassā 'haṃ ",
  "tha-ap332:15.4": "pabbajim anagāriyaṃ. // // ",
  "tha-ap332:16.1": "Sunando nāma nāmena ",
  "tha-ap332:16.2": "brāhmaṇo mantapāragū / ",
  "tha-ap332:16.3": "phalitaṃ chattam ādāya ",
  "tha-ap332:16.4": "sāvakaggassa so adā. // // ",
  "tha-ap332:17.1": "Anumodi mahāvīro ",
  "tha-ap332:17.2": "Sāriputto mahākathī / ",
  "tha-ap332:17.3": "sutvānumodanaṃ tassa ",
  "tha-ap332:17.4": "pubbakammam anussariṃ: // // ",
  "tha-ap332:18.1": "Añjaliṃ paggahetvāna ",
  "tha-ap332:18.2": "sakaṃ cittaṃ pasādayiṃ / ",
  "tha-ap332:18.3": "saritvā pūrimaṃ kammam ",
  "tha-ap332:18.4": "arahattam apāpuṇiṃ. // // ",
  "tha-ap332:19.1": "Uṭṭhāya āsanā tamhā ",
  "tha-ap332:19.2": "sīre katvāna añjaliṃ / ",
  "tha-ap332:19.3": "sambuddham abhivādetvā ",
  "tha-ap332:19.4": "imaṃ vācam udīrayiṃ: // // ",
  "tha-ap332:20.1": "Satasahasse ito kappe ",
  "tha-ap332:20.2": "Buddho loke anuttaro / ",
  "tha-ap332:20.3": "Padumuttaro lokavidū ",
  "tha-ap332:20.4": "āhutīnaṃ paṭiggaho. // // ",
  "tha-ap332:21.1": "Tassa chattaṃ mayā dinnaṃ ",
  "tha-ap332:21.2": "vicittaṃ samalaṅkataṃ / ",
  "tha-ap332:21.3": "ubho hatthehi paggaṇhi ",
  "tha-ap332:21.4": "sayambhū aggapuggalo. // // ",
  "tha-ap332:22.1": "Aho buddhā aho dhammā ",
  "tha-ap332:22.2": "aho no satthu sampadā / ",
  "tha-ap332:22.3": "ekachattassa dānena ",
  "tha-ap332:22.4": "duggatiṃ nūpapajj' ahaṃ. // // ",
  "tha-ap332:23.1": "Kilesā jhāpitā mayhaṃ ",
  "tha-ap332:23.2": "bhavā sabbe samūhatā / ",
  "tha-ap332:23.3": "sabbāsave pariññāya ",
  "tha-ap332:23.4": "viharāmi anāsavo. // // ",
  "tha-ap332:24.1": "Paṭisambhidā . . . ",
  "tha-ap332:24.2": "pe . . . ",
  "tha-ap332:24.3": "pe . . . // // ",
  "tha-ap332:25.1": "Itthaṃ sudam āyasmā Saparivārachattadāyako th. i. g. a-ti. ",
  "tha-ap332:26.1": "Saparivārachattadāyakattherassa apadānaṃ ",
  "tha-ap332:27.1": "samattaṃ. Uddānaṃ: ",
  "tha-ap332:28.1": "Ummāpupphañ ",
  "tha-ap332:29.1": "ca Pulinaṃ ",
  "tha-ap332:29.2": "Hāso Saññā-Nimittako ",
  "tha-ap332:29.3": "Saṃsāvako Nigguṇṭhī ca ",
  "tha-ap332:29.4": "Sumanaṃ Pupphachattako ",
  "tha-ap332:29.5": "Saparivāracchatto ca ",
  "tha-ap332:29.6": "gāthā sattasat' uttarā. "
}
