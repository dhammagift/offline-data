  "tha-ap371:1.1": "Candabhāgānadītīre ",
  "tha-ap371:1.2": "anusotaṃ vajām' ahaṃ / ",
  "tha-ap371:1.3": "addasaṃ virajaṃ Buddhaṃ ",
  "tha-ap371:1.4": "*sālarājaṃ va phul*litaṃ. // // ",
  "tha-ap371:2.1": "Pasannacitto sumano ",
  "tha-ap371:2.2": "paccekamunim uttamaṃ / ",
  "tha-ap371:2.3": "gahetvā timiraṃ pupphaṃ ",
  "tha-ap371:2.4": "matthake okirim ahaṃ. // // ",
  "tha-ap371:3.1": "Ekanavute ito kappe ",
  "tha-ap371:3.2": "yaṃ puppham abhipūjayiṃ / ",
  "tha-ap371:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap371:3.4": "Buddhapūjāy' idaṃ phalaṃ. // // ",
  "tha-ap371:4.1": "Paṭisambhidā . . . ",
  "tha-ap371:4.2": "pe . . . ",
  "tha-ap371:4.3": "pe . . . // // ",
  "tha-ap371:5.1": "Itthaṃ sudam āyasmā Timirapupphiyo th. i. g. a-ti. Timirapupphiyattherassa ",
  "tha-ap371:6.1": "apadānaṃ samattaṃ. "
}
