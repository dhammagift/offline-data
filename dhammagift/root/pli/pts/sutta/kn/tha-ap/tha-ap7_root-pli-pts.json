  "tha-ap7:0.3": "",
  "tha-ap7:1.1": "Ajjhāyako mantadharo ",
  "tha-ap7:1.2": "tiṇṇaṃ vedānapāragū / purakkhato ",
  "tha-ap7:1.3": "'smi sissehi ",
  "tha-ap7:1.4": "upagacchiṃ naruttamaṃ. // // ",
  "tha-ap7:2.1": "Padumuttaro lokavidū ",
  "tha-ap7:2.2": "ahutīnaṃ paṭiggaho / ",
  "tha-ap7:2.3": "mama kammaṃ pakittesi ",
  "tha-ap7:2.4": "saṅkhittena mahāmuni. // // ",
  "tha-ap7:3.1": "Tāhaṃ dhammaṃ suṇitvāna ",
  "tha-ap7:3.2": "abhivādetvāna satthuno / ",
  "tha-ap7:3.3": "añjalim paggahetvāna ",
  "tha-ap7:3.4": "pakkāmiṃ dakkhiṇāmukho. // // ",
  "tha-ap7:4.1": "Saṅkhittena suṇitvāna ",
  "tha-ap7:4.2": "vitthārena adesayiṃ / ",
  "tha-ap7:4.3": "sabbe sissā attamanā ",
  "tha-ap7:4.4": "sutvāna mama bhāsato. // // ",
  "tha-ap7:4.5": "Sakadiṭṭhiṃ vinodetvā ",
  "tha-ap7:4.6": "buddhe cittaṃ pasādayuṃ / ",
  "tha-ap7:5.1": "saṅkhittena pi desemi ",
  "tha-ap7:5.2": "vitthārena tath ev ahaṃ. // // Abhidhammanayañño ",
  "tha-ap7:5.3": "haṃ ",
  "tha-ap7:5.4": "Kathāvatthuvisuddhiyā / ",
  "tha-ap7:5.5": "sabbesaṃ viññāpetvāna ",
  "tha-ap7:5.6": "viharāmi anāsavo. // // ",
  "tha-ap7:6.1": "Ito pañcasate kappe ",
  "tha-ap7:6.2": "caturo suppakāsakā / ",
  "tha-ap7:6.3": "sattaratanasampannā ",
  "tha-ap7:6.4": "cātuddīpamhi issarā. // // ",
  "tha-ap7:7.1": "Paṭisambhidā catasso ",
  "tha-ap7:7.2": "vimokhā pi ca aṭṭh' ime / ",
  "tha-ap7:7.3": "chaḍabhiññā sacchikatā ",
  "tha-ap7:7.4": "kataṃ buddhassa sāsanan ti. // // ",
  "tha-ap7:8.1": "Itthaṃ sudaṃ āyasmā Puṇṇomantāniputtothero imā gāthāyo abhāsitthāti. ",
  "tha-ap7:9.1": "Puṇṇo Mantāṇiputtattherassa apadānaṃsamattaṃ. Naṅgare "
}
