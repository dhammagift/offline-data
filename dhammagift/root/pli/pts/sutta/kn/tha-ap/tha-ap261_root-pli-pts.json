  "tha-ap261:1.1": "sambuddho ",
  "tha-ap261:1.2": "rukkhamūle vasī tadā / ",
  "tha-ap261:1.3": "paṇṇasālaṃ karitvāna ",
  "tha-ap261:1.4": "adāsim aparājite. // // ",
  "tha-ap261:2.1": "Ekanavute ito kappe ",
  "tha-ap261:2.2": "yaṃ paṇṇakuṭikam adaṃ / ",
  "tha-ap261:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap261:2.4": "kuṭidānass' idaṃ phalaṃ. // // ",
  "tha-ap261:3.1": "Aṭṭhatiṃse ito kappe ",
  "tha-ap261:3.2": "soḷas āsiṃsu rājino / ",
  "tha-ap261:3.3": "Sabbattha-abhivassīti ",
  "tha-ap261:3.4": "vuccare cakkavattino. // // ",
  "tha-ap261:4.1": "paṭisambhidā . . . ",
  "tha-ap261:4.2": "pe . . . ",
  "tha-ap261:4.3": "pe . . . // // ",
  "tha-ap261:5.1": "Itthaṃ sudam āyasmā Kuṭidāyako thero i. g. a-ti. Kuṭidāyakattherassa ",
  "tha-ap261:6.1": "apadānaṃ samattaṃ. "
}
