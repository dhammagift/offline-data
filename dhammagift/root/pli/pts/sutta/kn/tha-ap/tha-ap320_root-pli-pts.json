  "tha-ap320:0.3": "",
  "tha-ap320:1.1": "Kesarim abhijātaṃ va ",
  "tha-ap320:1.2": "aggikkhandhaṃ va pabbate / ",
  "tha-ap320:1.3": "obhāsentaṃ disā sabbā ",
  "tha-ap320:1.4": "Siddhatthaṃ pabbatantare. // // ",
  "tha-ap320:2.1": "Suriyassa ca ālokaṃ ",
  "tha-ap320:2.2": "candālokaṃ tath' eva ca / ",
  "tha-ap320:2.3": "Buddhālokañ ca disvāna ",
  "tha-ap320:2.4": "vitti me upapajjatha. // // ",
  "tha-ap320:3.1": "Tayo āloke disvāna ",
  "tha-ap320:3.2": "disvāna sāvakuttamaṃ / ",
  "tha-ap320:3.3": "ekaṃsaṃ ajinaṃ katvā ",
  "tha-ap320:3.4": "santhaviṃ lokanāyakaṃ. // // ",
  "tha-ap320:4.1": "Tayo hi ālokakarā ",
  "tha-ap320:4.2": "loke lokatamonudā / ",
  "tha-ap320:4.3": "cando ca suriyo cāpi ",
  "tha-ap320:4.4": "Buddho ca lokanāyako. // // ",
  "tha-ap320:5.1": "Opamam upadaṃsetvā ",
  "tha-ap320:5.2": "kittito me mahāmuni / ",
  "tha-ap320:5.3": "Buddhassa vaṇṇaṃ kittetvā ",
  "tha-ap320:5.4": "kappaṃ saggamhi mod' ahaṃ. // // Catunavute ",
  "tha-ap320:6.1": "ito kappe ",
  "tha-ap320:6.2": "yaṃ Buddham abhikittayiṃ / ",
  "tha-ap320:6.3": "duggatiṃ nābhijānāmi ",
  "tha-ap320:6.4": "kittanāya idaṃ phalaṃ. // // ",
  "tha-ap320:7.1": "Ekasaṭṭhimhi 'to kappe ",
  "tha-ap320:7.2": "eko Ñāṇadharo ahu / ",
  "tha-ap320:7.3": "sattaratanasampanno ",
  "tha-ap320:7.4": "cakkavattī mahabbalo. // // ",
  "tha-ap320:8.1": "Paṭisambhidā . . . ",
  "tha-ap320:8.2": "pe . . . ",
  "tha-ap320:8.3": "pe . . . // // ",
  "tha-ap320:9.1": "Itthaṃ sudam āyasmā Tiraṃsiyo thero i. g. a-ti. Tiraṃsiyattherassa apadānaṃ samattaṃ. ",
  "tha-ap320:10.1": ""
}
