  "tha-ap513:1.1": "Migaluddo pure āsiṃ ",
  "tha-ap513:1.2": "vivane vicaraṃ ahaṃ / ",
  "tha-ap513:1.3": "addasaṃ virajaṃ Buddhaṃ ",
  "tha-ap513:1.4": "sabbadhammāna pāraguṃ. // // ",
  "tha-ap513:2.1": "Kureñjiyaphalaṃ gayha ",
  "tha-ap513:2.2": "Buddhaseṭṭhass' adās ahaṃ / ",
  "tha-ap513:2.3": "puññakkhettassa vīrassa ",
  "tha-ap513:2.4": "pasanno sehi pāṇihi. // // ",
  "tha-ap513:3.1": "Ekatiṃse ito kappe ",
  "tha-ap513:3.2": "yaṃ phalaṃ adadiṃ tadā / ",
  "tha-ap513:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap513:3.4": "phaladānass' idaṃ phalaṃ. // // ",
  "tha-ap513:4.1": "Kilesā . . . pe . . . ",
  "tha-ap513:4.2": "pe . . . ",
  "tha-ap513:4.3": "pe . . . // // ",
  "tha-ap513:4.4": "Sāgataṃ . . . ",
  "tha-ap513:5.1": "pe . . . ",
  "tha-ap513:5.2": "pe . . . ",
  "tha-ap513:5.3": "pe . . . // // ",
  "tha-ap513:5.4": "",
  "tha-ap513:6.1": "Paṭisambhidā . . . pe . . . ",
  "tha-ap513:6.2": "pe . . . ",
  "tha-ap513:6.3": "",
  "tha-ap513:6.4": "pe . . . // // ",
  "tha-ap513:7.1": "Itthaṃ sudaṃ āyasmā Kureñjiyaphaladāyako th. i. g. a-ti. Kureñjiyaphaladāyakattherassa ",
  "tha-ap513:8.1": "apadānaṃ samattaṃ. "
}
