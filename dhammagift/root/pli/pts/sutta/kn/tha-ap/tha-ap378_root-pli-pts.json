  "tha-ap378:1.1": "",
  "tha-ap378:1.2": "nānāgandhe samāgate / ",
  "tha-ap378:1.3": "pasannacitto sumano ",
  "tha-ap378:1.4": "gandhamuṭṭhim apūjayiṃ. // // Satasahasse ",
  "tha-ap378:2.1": "ito kappe ",
  "tha-ap378:2.2": "citakaṃ yam apūjayiṃ / ",
  "tha-ap378:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap378:2.4": "citapūjāy' idaṃ phalaṃ. // // ",
  "tha-ap378:3.1": "Sāgataṃ vata me āsi mama Buddhassa santike / tisso vijjā anuppatto kataṃ Buddhassa sāsanaṃ. // // Kilesā jhāpitā mayhaṃ ",
  "tha-ap378:3.2": "bhavā sabbe samūhatā / nāgo va bandhanaṃ chetvā ",
  "tha-ap378:3.3": "viharāmi anāsavo. // // ",
  "tha-ap378:4.1": "",
  "tha-ap378:4.2": "",
  "tha-ap378:4.3": "",
  "tha-ap378:5.1": "Paṭisambhidā . . . ",
  "tha-ap378:5.2": "pe . . . ",
  "tha-ap378:5.3": "pe . . . // // ",
  "tha-ap378:6.1": "Itthaṃ sudam āyasmā Gandhamuṭṭhiyo th. i. g. a-ti. Gandhamuṭṭhiyattherassa ",
  "tha-ap378:7.1": "apādanaṃ samattaṃ. "
}
