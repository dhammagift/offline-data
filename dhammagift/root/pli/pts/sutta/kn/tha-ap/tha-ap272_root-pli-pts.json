  "tha-ap272:1.1": "Suvaṇṇavaṇṇo sambuddho ",
  "tha-ap272:1.2": "Vipassī dakkhiṇāraho / ",
  "tha-ap272:1.3": "nadītīre ṭhito satthā ",
  "tha-ap272:1.4": "bhikkhusaṅghapurakkhato. // // ",
  "tha-ap272:2.1": "Nāvā na vijjate tattha ",
  "tha-ap272:2.2": "santāraṇī mahaṇṇave / ",
  "tha-ap272:2.3": "nadiyā abhinikkhamma ",
  "tha-ap272:2.4": "tāresiṃ lokanāyakaṃ. // // ",
  "tha-ap272:3.1": "Ekanavute ito kappe ",
  "tha-ap272:3.2": "yaṃ tāresiṃ naruttamaṃ / ",
  "tha-ap272:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap272:3.4": "taraṇāya idaṃ phalaṃ. // // ",
  "tha-ap272:4.1": "Paṭisambhidā . . . ",
  "tha-ap272:4.2": "pe . . . ",
  "tha-ap272:4.3": "pe . . . // // ",
  "tha-ap272:5.1": "Itthaṃ sudam āyasmā Taraṇiyo thero i. g. a- ",
  "tha-ap272:6.1": "ti. Taraṇiyattherassa ",
  "tha-ap272:7.1": "apadānaṃ samattaṃ. ",
  "tha-ap272:8.1": "Uddānaṃ: ",
  "tha-ap272:9.1": "Ukkhepī Tela-Candī ca ",
  "tha-ap272:9.2": "Dīpado ca Biḷālido ",
  "tha-ap272:9.3": "Maccho Javo Salaḷado ",
  "tha-ap272:9.4": "Rakkhaso Taraṇo dasa ",
  "tha-ap272:9.5": "gāthāyo c' ettha saṅkhātā ",
  "tha-ap272:9.6": "tālisam-ekam eva ca. Padumukkhepavaggo sattavīsatimo. "
}
