  "tha-ap38:0.3": "",
  "tha-ap38:1.1": "Nibbute lokanāthamhi ",
  "tha-ap38:1.2": "Atthadassi-naruttame / ",
  "tha-ap38:1.3": "nimantetvā bhikkhusaṅgham ",
  "tha-ap38:1.4": "vippasannena cetasā // // ",
  "tha-ap38:2.1": "Nimantetvā saṅgharatanaṃ ",
  "tha-ap38:2.2": "ujubhūtaṃ samāhitaṃ / ",
  "tha-ap38:2.3": "ucchunā maṇḍapaṃ katvā ",
  "tha-ap38:2.4": "bhojesiṃ saṅgham uttamaṃ. // // ",
  "tha-ap38:3.1": "Yaṃ yaṃ yonūpapajjāmi ",
  "tha-ap38:3.2": "devattaṃ atha mānusaṃ / ",
  "tha-ap38:3.3": "sabbe satte atihomi ",
  "tha-ap38:3.4": "puññakammass' idaṃ phalaṃ. // // ",
  "tha-ap38:4.1": "Aṭṭhārase kappasate ",
  "tha-ap38:4.2": "yaṃ dānam adadiṃ tadā / ",
  "tha-ap38:4.3": "duggatiṃ nābhijānāmi ",
  "tha-ap38:4.4": "ucchudānass' idaṃ phalaṃ. // // ",
  "tha-ap38:5.1": "Paṭisambhidā catasso ",
  "tha-ap38:5.2": "vimokhā pi ca aṭṭh' ime / chaḍabhiññā sacchikatā ",
  "tha-ap38:5.3": "kataṃ Buddhassa sāsanan ti. // // ",
  "tha-ap38:6.1": "Itthaṃ sudaṃ āyasmā Adhimutto thero imā gāthāyo abhāsitthā ti. Adhimuttattherassa apadānaṃ samattaṃ. Himavantass' avidūre ",
  "tha-ap38:7.1": ""
}
