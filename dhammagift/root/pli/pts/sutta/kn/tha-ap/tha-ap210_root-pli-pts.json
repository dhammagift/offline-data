  "tha-ap210:1.1": "padaṃ disvā ",
  "tha-ap210:1.2": "cakkālaṅkārabhūsitaṃ / ",
  "tha-ap210:1.3": "padenānupadaṃ yanto ",
  "tha-ap210:1.4": "Vipassissa mahesino. // // ",
  "tha-ap210:2.1": "Koraṇḍaṃ pupphitaṃ disvā ",
  "tha-ap210:2.2": "samūlaṃ pūjitaṃ mayā / ",
  "tha-ap210:2.3": "haṭṭho haṭṭhena cittena ",
  "tha-ap210:2.4": "avandiṃ padam uttamaṃ. // // Ekanavute ",
  "tha-ap210:3.1": "ito kappe ",
  "tha-ap210:3.2": "yaṃ puppham abhipūjayiṃ / ",
  "tha-ap210:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap210:3.4": "padapūjāy' idaṃ phalaṃ. // // ",
  "tha-ap210:4.1": "Sattapaññāsakappamhi ",
  "tha-ap210:4.2": "eko Vītamalo ahū / ",
  "tha-ap210:4.3": "sattaratanasampanno ",
  "tha-ap210:4.4": "cakkavattī mahabbalo. // // ",
  "tha-ap210:5.1": "Paṭisambhidā . . . ",
  "tha-ap210:5.2": "pe . . . ",
  "tha-ap210:5.3": "pe . . . // // ",
  "tha-ap210:6.1": "Itthaṃ sudam āyasmā Koraṇḍapupphiyo thero i. g. a-ti. Koraṇḍapupphiyattherassa apadānaṃ samattaṃ. ",
  "tha-ap210:7.1": ""
}
