  "tha-ap349:1.1": "",
  "tha-ap349:1.2": "Romaso nāma pabbato / ",
  "tha-ap349:1.3": "Buddho pi Sambhavo nāma ",
  "tha-ap349:1.4": "abbhokāse vasī tadā. // // ",
  "tha-ap349:2.1": "Bhavanā nikkhamitvāna ",
  "tha-ap349:2.2": "padumaṃ dhārayim ahaṃ / ",
  "tha-ap349:2.3": "*ekāhaṃ* dhārayitvāna ",
  "tha-ap349:2.4": "punabbhavaṃ upāgamiṃ. // // Ekanavute ",
  "tha-ap349:3.1": "ito kappe ",
  "tha-ap349:3.2": "yaṃ puppham abhipūjayiṃ / ",
  "tha-ap349:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap349:3.4": "Buddhapūjāy' idaṃ phalaṃ. // // ",
  "tha-ap349:4.1": "Paṭisambhidā . . . ",
  "tha-ap349:4.2": "pe . . . ",
  "tha-ap349:4.3": "pe . . . // // ",
  "tha-ap349:5.1": "Itthaṃ sudam āyasmā Padumapūjako thero i. g. a-ti. ",
  "tha-ap349:6.1": "Padumapūjakattherassa apadānaṃ samattaṃ. ",
  "tha-ap349:6.2": "Himavantass' avidūre "
}
