  "tha-ap325:1.1": "Dumagge paṃsukūlikaṃ ",
  "tha-ap325:1.2": "laggaṃ disvāna satthuno / ",
  "tha-ap325:1.3": "añjaliṃ paggahetvāna ",
  "tha-ap325:1.4": "*bhiyyo* uccāritaṃ mayā. // // ",
  "tha-ap325:2.1": "Dūrato paṭidisvāna ",
  "tha-ap325:2.2": "hāso me upapajjatha / ",
  "tha-ap325:2.3": "añjaliṃ paggahetvāna ",
  "tha-ap325:2.4": "bhiyyo cittaṃ pasādayiṃ. // // ",
  "tha-ap325:3.1": "Ekanavute ito kappe ",
  "tha-ap325:3.2": "yaṃ saññam alabhiṃ tadā / ",
  "tha-ap325:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap325:3.4": "Buddhasaññāy' idaṃ phalaṃ. // // ",
  "tha-ap325:4.1": "Paṭisambhidā . . . ",
  "tha-ap325:4.2": "pe . . . ",
  "tha-ap325:4.3": "pe . . . // // ",
  "tha-ap325:5.1": "Itthaṃ sudam āyasmā Hāsajanako thero i. g. a-ti. Hāsajanakattherassa apadānaṃ samattaṃ. ",
  "tha-ap325:6.1": ""
}
