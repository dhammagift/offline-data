  "mil7.1:1.1": "Bhante Nāgasena, katihi angehi samannāgato bhikkhu arahattaṃ sacchikarotīti. - ",
  "mil7.1:2.1": "Idha mahārāja arahattaṃ sacchikātukāmena bhikkhunā ",
  "mil7.1:3.1": "ghorassarassa ekaṃ angaṃ gahetabbaṃ. ",
  "mil7.1:4.1": "Kukkuṭassa pañca angāni gahetabbāni. ",
  "mil7.1:5.1": "Kalandakassa ekaṃ angaṃ gahetabbaṃ. ",
  "mil7.1:6.1": "Dīpiniyā ekaṃ angaṃ gahetabbaṃ. ",
  "mil7.1:7.1": "Dīpikassa dve angāni gahetabbāni. ",
  "mil7.1:8.1": "Kummassa pañca angāni gahetabbāni. ",
  "mil7.1:9.1": "Vaṃsassa ekaṃ angaṃ gahetabbaṃ. ",
  "mil7.1:10.1": "Cāpassa ekaṃ angaṃ gahetabbaṃ. ",
  "mil7.1:11.1": "Vāyasassa dve angāni gahetabbāni. ",
  "mil7.1:12.1": "Makkaṭassa dve angāni gahetabbāni. ",
  "mil7.1:13.1": "Lāpulatāya ",
  "mil7.1:14.1": "ekaṃ angaṃ gahetabbaṃ. ",
  "mil7.1:15.1": "Padumassa tīṇi angāni gahetabbāni. ",
  "mil7.1:16.1": "Bījassa dve angāni. gahetabbāni. ",
  "mil7.1:17.1": "Sālakalyāṇikāya ekaṃ angaṃ gahetabbaṃ. ",
  "mil7.1:18.1": "Nāvāya tīṇi angāni gahetabbāni. ",
  "mil7.1:19.1": "Nāvālakanakassa dve angāni gahetabbāni. ",
  "mil7.1:20.1": "Kūpassa ekaṃ angaṃ gahetabbaṃ. ",
  "mil7.1:21.1": "Niyyāmakassa tīṇi angāni gahetabbāni. ",
  "mil7.1:22.1": "Kammakarassa ekaṃ angaṃ gahetabbaṃ. ",
  "mil7.1:23.1": "Samuddassa pañca angāni gahetabbāni. ",
  "mil7.1:24.1": "",
  "mil7.1:25.1": "Paṭhaviyā pañca angāni gahetabbāni. ",
  "mil7.1:26.1": "Āpassa pañca angāni gahetabbāni. ",
  "mil7.1:27.1": "Tejassa pañca angāni gahetabbāni. ",
  "mil7.1:28.1": "Vāyussa pañca angāni gahetabbāni. ",
  "mil7.1:29.1": "Pabbatassa pañca angāni gahetabbāni. ",
  "mil7.1:30.1": "Ākāsassa pañca angāni gahetabbāni. ",
  "mil7.1:31.1": "Candassa pañca angāni gahetabbāni. ",
  "mil7.1:32.1": "Suriyassa satta angāni gahetabbāni. ",
  "mil7.1:33.1": "Sakkassa tīṇi angāni gahetabbāni. ",
  "mil7.1:34.1": "Cakkavattissa cattāri angāni gahetabbāni. ",
  "mil7.1:35.1": "",
  "mil7.1:36.1": "Upacikāya ekaṃ angaṃ gahetabbaṃ. ",
  "mil7.1:37.1": "Biḷārassa dve angāni gahetabbāni. ",
  "mil7.1:38.1": "Undurassa ekaṃ angaṃ gahetabbaṃ. ",
  "mil7.1:39.1": "Vicchikassa ekaṃ angaṃ gahetabbaṃ. ",
  "mil7.1:40.1": "Nakulassa ekaṃ angaṃ gahetabbaṃ. ",
  "mil7.1:41.1": "Jarasigālassa dve angāni gahetabbāni. ",
  "mil7.1:42.1": "Migassa tīṇi angāni gahetabbāni. ",
  "mil7.1:43.1": "Gorūpassa cattāri angāni gahetabbāni. ",
  "mil7.1:44.1": "Varāhassa dve angāni gahetabbāni. ",
  "mil7.1:45.1": "Hatthissa pañca angāni gahetabbāni. ",
  "mil7.1:46.1": "",
