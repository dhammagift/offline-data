  "mil3.7.12:0.3": "",
  "mil3.7.12:1.1": "Rājā āha: ",
  "mil3.7.12:1.2": "Bhante Nāgasena, samuddo samuddo ti vuccati, kena kāraṇena udakaṃ samuddo ti vuccatīti. - ",
  "mil3.7.12:1.3": "Thero āha: ",
  "mil3.7.12:1.4": "Yattakaṃ mahārāja udakaṃ tattakaṃ loṇaṃ, ",
  "mil3.7.12:1.5": "yattakaṃ loṇaṃ tattakaṃ udakaṃ, ",
  "mil3.7.12:1.6": "tasmā samuddo ti vuccatīti. - ",
  "mil3.7.12:2.1": "Kallo si bhante Nāgasenāti. ",
  "mil3.7.12:3.1": ""
}
