  "mil3.6.8:1.1": "Rājā āha: ",
  "mil3.6.8:1.2": "Bhante Nāgasena, paññā kuhiṃ paṭivasatīti. - ",
  "mil3.6.8:1.3": "Na katthaci mahārājāti. - ",
  "mil3.6.8:1.4": "Tena hi bhante Nāgasena na-tthi paññā ti. - ",
  "mil3.6.8:1.5": "Vāto mahārāja kuhiṃ paṭivasatīti. - ",
  "mil3.6.8:1.6": "Na katthaci bhante ti. - ",
  "mil3.6.8:1.7": "Tena hi mahārāja na-tthi vāto ti. - ",
  "mil3.6.8:2.1": "Kallo si bhante Nāgasenāti. ",
  "mil3.6.8:3.1": ""
}
