{
  "snp4.6:0.1": "",
  "snp4.6:0.2": "",
  "snp4.6:1.1": "Appaṃ vata jīvitaṃ idaṃ, ",
  "snp4.6:1.2": "oraṃ vassasatā pi miyyati, ",
  "snp4.6:1.3": "yo ce pi aticca jīvati, ",
  "snp4.6:1.4": "atha kho so jarasā pi miyyati. 805. ",
  "snp4.6:2.1": "Socanti janā mamāyite, ",
  "snp4.6:2.2": "na hi santi niccā pariggahā, ",
  "snp4.6:2.3": "vinābhāvasantam ev' idaṃ, ",
  "snp4.6:2.4": "iti disvā nāgāram āvase. 806. ",
  "snp4.6:3.1": "Maraṇena pi tam pahīyati, ",
  "snp4.6:3.2": "yaṃ puriso ‘mama-y-idan' ti maññati, -- ",
  "snp4.6:3.3": "evam pi viditvā paṇḍito ",
  "snp4.6:3.4": "na mamattāya nametha māmako. 807. ",
  "snp4.6:4.1": "Supinena yathā pi saṅgataṃ ",
  "snp4.6:4.2": "paṭibuddho puriso na passati,| ",
  "snp4.6:4.3": "evam pi piyāyitaṃ janaṃ ",
  "snp4.6:4.4": "petaṃ kālakataṃ na passati. 808. ",
  "snp4.6:5.1": "Diṭṭhā pi sutā pi te janā, ",
  "snp4.6:5.2": "yesaṃ nāmam idaṃ pavuccati: ",
  "snp4.6:5.3": "nāmam evāvasissati ",
  "snp4.6:5.4": "akkheyyaṃ petassa jantuno. 809. ",
  "snp4.6:6.1": "sokapāridevamaccharaṃ ",
  "snp4.6:6.2": "na jahanti giddhā mamāyite, ",
  "snp4.6:6.3": "tasmā munayo pariggahaṃ ",
  "snp4.6:6.4": "hitvā acariṃsu khemadassino. 810. ",
  "snp4.6:7.1": "Patilīnacarassa bhikkhuno ",
  "snp4.6:7.2": "bhajamānassa vivittamānasaṃ ",
  "snp4.6:7.3": "sāmaggiyam āhu tassa taṃ, ",
  "snp4.6:7.4": "yo attānaṃ bhavane na dassaye. 811. ",
  "snp4.6:8.1": "sabbattha mani anissito ",
  "snp4.6:8.2": "na piyaṃ kubbati no pi appiyaṃ, ",
  "snp4.6:8.3": "tasmiṃ paridevamaccharaṃ ",
  "snp4.6:8.4": "paṇṇe vāri yathā na lippati. 812. ",
  "snp4.6:9.1": "Udabindu yathā pi pokkhare ",
  "snp4.6:9.2": "padume vāri yathā na lippati, ",
  "snp4.6:9.3": "evaṃ muni nopalippati ",
  "snp4.6:9.4": "yad idaṃ diṭṭhasutaṃ mutesu vā. 813. ",
  "snp4.6:10.1": "Dhono na hi tena maññati ",
  "snp4.6:10.2": "yad idaṃ diṭṭhasutaṃ mutesu vā, ",
  "snp4.6:10.3": "na aññena visuddhim icchati: ",
  "snp4.6:10.4": "na hi so rajjati no virajjatī ti ",
  "snp4.6:10.5": "JARĀSUTTAṂ NIṬṬHITAṂ. 814. \"Methunam anuyuttassa icc-āyasmā "
}
