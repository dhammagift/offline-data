{
  "snp4.2:0.1": "",
  "snp4.2:0.2": "",
  "snp4.2:1.1": "Satto guhāyaṃ bahunābhichanno ",
  "snp4.2:1.2": "tiṭṭhaṃ naro mohanasmiṃ pagāḷho,| ",
  "snp4.2:1.3": "dūre vivekā hi tathāvidho so, ",
  "snp4.2:1.4": "kāmā hi loke na he suppahāyā. 773. ",
  "snp4.2:2.1": "Icchānidānā bhavasātabaddhā ",
  "snp4.2:2.2": "te duppamuñcā, na hi aññamokkhā ",
  "snp4.2:2.3": "pacchā pure vā pi apekhamānā ",
  "snp4.2:2.4": "ime va kāme purime va jappaṃ. 774. ",
  "snp4.2:3.1": "Kāmesu giddhā pasutā pamūḷhā ",
  "snp4.2:3.2": "avadāniyā te visame niviṭṭhā ",
  "snp4.2:3.3": "dukkhūpanītā paridevayanti: ",
  "snp4.2:3.4": "\"kiṃ su bhavissāma ito cutāse\". 775. ",
  "snp4.2:4.1": "Tasmā hi sikkhetha idh' eva jantu: ",
  "snp4.2:4.2": "yaṃ kiñci jaññā ‘visaman' ti loke, ",
  "snp4.2:4.3": "na tassa hetu visamaṃ careyya, ",
  "snp4.2:4.4": "appaṃ hi taṃ jīvitaṃ āhu dhīrā. 776. ",
  "snp4.2:5.1": "Passāmi loke pariphandamānaṃ ",
  "snp4.2:5.2": "pajaṃ imaṃ taṇhāgataṃ bhavesu, ",
  "snp4.2:5.3": "hīnā narā maccumukhe lapanti ",
  "snp4.2:5.4": "avītataṇhāse bhavābhavesu. 777. ",
  "snp4.2:6.1": "Mamāyite passatha phandamāne ",
  "snp4.2:6.2": "macche va appodake khīṇasote, ",
  "snp4.2:6.3": "etam pi disvā amamo careyya ",
  "snp4.2:6.4": "bhavesu āsattim akubbamāno. 778. ",
  "snp4.2:7.1": "Ubhosu antesu vineyya chandaṃ ",
  "snp4.2:7.2": "phassaṃ pariññāya anānugiddho, ",
  "snp4.2:7.3": "yad attagarahī, tad akubbamāno ",
  "snp4.2:7.4": "na lippatī diṭṭhasutesu dhīro. 779. ",
  "snp4.2:8.1": "Saññaṃ pariññā vitareyya oghaṃ ",
  "snp4.2:8.2": "pariggahesu muni nopalitto ",
  "snp4.2:8.3": "abbūḷhasallo caraṃ appamatto ",
  "snp4.2:8.4": "nāsiṃsati lokam imaṃ parañ cā ti ",
  "snp4.2:8.5": "GUHAṬṬHAKASUTTAṂ NIṬṬHITAṂ. 780. "
}
