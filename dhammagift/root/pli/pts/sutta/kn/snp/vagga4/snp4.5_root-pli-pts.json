{
  "snp4.5:0.1": "",
  "snp4.5:0.2": "",
  "snp4.5:1.1": "diṭṭhīsu paribbasāno ",
  "snp4.5:1.2": "yad uttariṃkurute jantu loke, ",
  "snp4.5:1.3": "\"hīnā\" ti aññe tato sabba-m-āha: ",
  "snp4.5:1.4": "tasmā vivādāni avītivatto. 797. ",
  "snp4.5:2.1": "Yad attanī passati ānisaṃsaṃ ",
  "snp4.5:2.2": "diṭṭhe sute sīlavate mute vā, ",
  "snp4.5:2.3": "tad eva so tattha samuggahāya ",
  "snp4.5:2.4": "nihīnato passati sabbam aññaṃ. 798. ",
  "snp4.5:3.1": "Taṃ vāpi ganthaṃ kusalā vadanti, ",
  "snp4.5:3.2": "yaṃ nissito passati hīnam aññaṃ, ",
  "snp4.5:3.3": "tasmā hi diṭṭhaṃ vā sutaṃ mutaṃ vā ",
  "snp4.5:3.4": "sīlabbataṃ bhikkhu na nissayeyya. 799. ",
  "snp4.5:4.1": "Diṭṭhim pi lokasmiṃ na kappayeyya ",
  "snp4.5:4.2": "ñāṇena vā sīlavatena vā pi, ",
  "snp4.5:4.3": "‘samo' ti attānaṃ anūpaneyya ",
  "snp4.5:4.4": "‘hīno' na maññetha ‘visesi' vā pi. 800. ",
  "snp4.5:5.1": "Attaṃ pahāya anupādiyāno ",
  "snp4.5:5.2": "ñāṇe pi so nissayaṃ no karoti, ",
  "snp4.5:5.3": "",
  "snp4.5:5.4": "diṭṭhim pi so na pacceti kiñci. 801. ",
  "snp4.5:6.1": "Yassūbhayante paṇidhīdha n' atthi ",
  "snp4.5:6.2": "bhavābhavāya idha vā huraṃ vā, ",
  "snp4.5:6.3": "nivesanā tassa na santi keci ",
  "snp4.5:6.4": "dhammesu niccheyya samugahītā, 802. ",
  "snp4.5:7.1": "tassīdha diṭṭhe va sute mute vā ",
  "snp4.5:7.2": "pakappitā n' atthi aṇū pi saññā: ",
  "snp4.5:7.3": "taṃ brāhmaṇaṃ diṭṭhim anādiyānaṃ ",
  "snp4.5:7.4": "kenīdha lokasmiṃ vikappayeyya. 803. ",
  "snp4.5:8.1": "Na kappayanti na purekkharonti, ",
  "snp4.5:8.2": "dhammā pi tesaṃ na paṭicchitāse,| ",
  "snp4.5:8.3": "na brāhmaṇo sīlavatena neyyo, ",
  "snp4.5:8.4": "pāraṃgato na pacceti tādi ti ",
  "snp4.5:8.5": "PARAMAṬṬHAKASUTTAṂ NIṬṬHITAṂ. 804. "
}
