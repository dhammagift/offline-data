  "snp4.10:0.1": "",
  "snp4.10:0.2": "",
  "snp4.10:1.1": "\"Kathaṃdassī kathaṃsīlo ",
  "snp4.10:1.2": "upasanto ti vuccati, ",
  "snp4.10:1.3": "tam me Gotama pabrūhi ",
  "snp4.10:1.4": "pucchito uttamaṃ naraṃ\". 849. ",
  "snp4.10:2.1": "\"Vitataṇho purā bhedā ",
  "snp4.10:2.2": "ti Bhagavā ",
  "snp4.10:2.3": "pubbam antam anissito ",
  "snp4.10:2.4": "vemajjhe nūpasaṃkheyyo, ",
  "snp4.10:2.5": "tassa n' atthi purekkhataṃ. 850. ",
  "snp4.10:3.1": "Akkodhano asantāsī, ",
  "snp4.10:3.2": "avikatthī akukkuco, ",
  "snp4.10:3.3": "mantabhāṇī anuddhato, ",
  "snp4.10:3.4": "sa ve vācāyato muni. 851. ",
  "snp4.10:4.1": "Nirāsatti anāgate ",
  "snp4.10:4.2": "atītaṃ nānusocati, ",
  "snp4.10:4.3": "vivekadassī phassesu ",
  "snp4.10:4.4": "diṭṭhīsu ca na niyyati, 852. ",
  "snp4.10:5.1": "patilīno akuhako, ",
  "snp4.10:5.2": "apihālu amaccharī, ",
  "snp4.10:5.3": "appagabbho ajeguccho, ",
  "snp4.10:5.4": "pesuṇeyye ca no yuto, 853. ",
  "snp4.10:6.1": "sātiyesu anassāvī ",
  "snp4.10:6.2": "atimāne ca no yuto, ",
  "snp4.10:6.3": "saṇho ca paṭibhānavā, ",
  "snp4.10:6.4": "na saddho na virajjati, 854. ",
  "snp4.10:7.1": "lābhakamyā na sikkhati, ",
  "snp4.10:7.2": "alābhe na ca kuppati, ",
  "snp4.10:7.3": "aviruddho ca taṇhāya ",
  "snp4.10:7.4": "rase ca nānugijjhati, 855. ",
  "snp4.10:8.1": "upekhako sadā sato ",
  "snp4.10:8.2": "na loke maññate samaṃ ",
  "snp4.10:8.3": "na visesī na nīceyyo, ",
  "snp4.10:8.4": "tassa no santi ussadā. 856. ",
  "snp4.10:9.1": "Yassa nissayatā n' atthi, ",
  "snp4.10:9.2": "ñatvā dhammaṃ anissito ",
  "snp4.10:9.3": "bhavāya vibhavāya vā ",
  "snp4.10:9.4": "taṇhā yassa na vijjati, 857. ",
  "snp4.10:10.1": "taṃ brūmi upasanto ti ",
  "snp4.10:10.2": "kāmesu anapekhinaṃ, ",
  "snp4.10:10.3": "ganthā tassa na vijjanti, ",
  "snp4.10:10.4": "atāri so visattikaṃ. 858. ",
  "snp4.10:11.1": "Na tassa puttā pasavo vā ",
  "snp4.10:11.2": "khettaṃ vatthuṃ na vijjati,| ",
  "snp4.10:11.3": "attaṃ vā pi nirattaṃ vā ",
  "snp4.10:11.4": "na tasmiṃ upalabbhati. 859. ",
  "snp4.10:12.1": "Yena naṃ vajju puthujjanā ",
  "snp4.10:12.2": "atho samaṇabrāhmaṇā, ",
  "snp4.10:12.3": "taṃ tassa apurekkhataṃ, ",
  "snp4.10:12.4": "tasmā vādesu n' ejati. 860. ",
  "snp4.10:13.1": "Vītagedho amaccharī ",
  "snp4.10:13.2": "na ussesu vadate muni ",
  "snp4.10:13.3": "na samesu na omesu, ",
  "snp4.10:13.4": "kappaṃ n' eti akappiyo. 861. ",
  "snp4.10:14.1": "Yassa loke sakaṃ n' atthi, ",
  "snp4.10:14.2": "asatā ca na socati, ",
  "snp4.10:14.3": "dhammesu ca na gacchati, ",
  "snp4.10:14.4": "sa ve santo ti vuc- catī\" ti PURĀBHEDASUTTAṂ NIṬṬHITAṂ. 862. \"Kuto pahūtā ",
  "snp4.10:14.5": ""
}
