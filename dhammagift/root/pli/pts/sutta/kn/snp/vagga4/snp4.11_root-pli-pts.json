  "snp4.11:0.1": "",
  "snp4.11:0.2": "",
  "snp4.11:1.1": "kalahā vivādā ",
  "snp4.11:1.2": "puridevasokā sahamaccharā ca ",
  "snp4.11:1.3": "mānātimānā sahapesuṇā ca, ",
  "snp4.11:1.4": "kuto pahūtā te, tad iṃgha brūhi\". 863. ",
  "snp4.11:2.1": "\"Piyā pahūtā kalahā vivādā ",
  "snp4.11:2.2": "paridevasokā sahamaccharā ca ",
  "snp4.11:2.3": "mānātimānā sahapesuṇā ca, ",
  "snp4.11:2.4": "macchariyayuttā kalahā vivādā ",
  "snp4.11:2.5": "vivādajātesu ca pesuṇāni\". 864. ",
  "snp4.11:3.1": "\"Piyā su lokasmiṃ kutonidānā ",
  "snp4.11:3.2": "ye vā pi lobhā vicaranti loke, ",
  "snp4.11:3.3": "āsā ca niṭṭhā ca kutonidānā, ",
  "snp4.11:3.4": "ye samparāyāya narassa honti\". 865. ",
  "snp4.11:4.1": "\"Chandānidānāni piyāni loke ",
  "snp4.11:4.2": "ye vā pi lobhā vicaranti loke, ",
  "snp4.11:4.3": "āsā ca niṭṭhā ca itonidānā, ",
  "snp4.11:4.4": "ye samparāyāya narassa honti\". 866. ",
  "snp4.11:5.1": "\"Chando nu lokasmiṃ kutonidāno, ",
  "snp4.11:5.2": "vinicchayā vā pi kuto pahūtā ",
  "snp4.11:5.3": "kodho mosavajjañ ca kathaṃkathā ca ",
  "snp4.11:5.4": "ye vā pi dhammā samaṇena vuttā\". 867. ",
  "snp4.11:6.1": "\"‘Sātaṃ, asātan' ti yam āhu loke, ",
  "snp4.11:6.2": "tam ūpanissāya pahoti chando, ",
  "snp4.11:6.3": "rūpesu disvā vibhavaṃ bhavañ ca ",
  "snp4.11:6.4": "vinicchayaṃ kurute jantu loke. 868. ",
  "snp4.11:7.1": "Kodho mosavajjañ ca ",
  "snp4.11:7.2": "kathaṃkathā ca ete pi dhammā dvaya-m-eva sante: ",
  "snp4.11:7.3": "kathaṃkathī ñāṇapathāya sikkhe, ",
  "snp4.11:7.4": "ñatvā pavuttā samaṇena dhammā\". 869. ",
  "snp4.11:8.1": "\"Sātaṃ asātañ ca kutonidānā, ",
  "snp4.11:8.2": "kismiṃ asante na bhavanti h' ete, ",
  "snp4.11:8.3": "‘vibbavaṃ bhavañ cāpi' yam etam attaṃ, ",
  "snp4.11:8.4": "etam me pabrūhi yatonidānaṃ\". 870. ",
  "snp4.11:9.1": "\"Phassanidānaṃ sātaṃ asātaṃ, ",
  "snp4.11:9.2": "phasse asante na bhavanti h' ete,| ",
  "snp4.11:9.3": "‘vibhavaṃ bhavañ cāpi' yam etam atthaṃ, ",
  "snp4.11:9.4": "etaṃ te pabrūmi itonidānaṃ\". 871. ",
  "snp4.11:10.1": "\"Phasso nu lokasmiṃ kutonidāno, ",
  "snp4.11:10.2": "pariggahā vā pi kuto pahūtā, ",
  "snp4.11:10.3": "kismiṃ asante na mamattam atthi, ",
  "snp4.11:10.4": "kismiṃ vibhūte na phusanti phassā\". 872. ",
  "snp4.11:11.1": "\"Nāmañ ca rūpañ ca paṭicca phassā, ",
  "snp4.11:11.2": "icchānidānāni pariggahāni, ",
  "snp4.11:11.3": "icchā na santyā na mamattam atthi, ",
  "snp4.11:11.4": "rūpe vibhūte na phusanti phassā\". 873. ",
  "snp4.11:12.1": "\"Kathaṃsametassa vibhoti rūpaṃ, ",
  "snp4.11:12.2": "sukhaṃ dukhaṃ vā pi kathaṃ vibhoti, ",
  "snp4.11:12.3": "etam me pabrūhi yathā vibhoti, ",
  "snp4.11:12.4": "‘taṃ jāniyāma' iti me mano ahū\". 874. ",
  "snp4.11:13.1": "\"Na saññasaññī na visaññasaññi ",
  "snp4.11:13.2": "no pi asaññī na vibhūtasaññī, -- ",
  "snp4.11:13.3": "evaṃsametassa vibhoti rūpaṃ, ",
  "snp4.11:13.4": "saññānidānā hi papañcasaṃkhā\". 875. ",
  "snp4.11:14.1": "\"Yan tam apucchimha, akittayī no, ",
  "snp4.11:14.2": "aññaṃ taṃ pucchāma, tad iṃgha brūhi:| ",
  "snp4.11:14.3": "ettāvat' aggaṃ no vadanti h' eke ",
  "snp4.11:14.4": "yakkhassa suddhiṃ idha paṇḍitāse, ",
  "snp4.11:14.5": "udāhu aññam pi vadanti etto\". 876. ",
  "snp4.11:15.1": "\"Ettāvat' aggam pi vadanti h' eke ",
  "snp4.11:15.2": "yakkhassa suddhiṃ idha paṇḍitāse, ",
  "snp4.11:15.3": "tesaṃ pun' eke samayaṃ vadanti ",
  "snp4.11:15.4": "anupādisese kusalā vadānā. 877. ",
  "snp4.11:16.1": "Ete ca ñatvā ‘upanissitā' ti ",
  "snp4.11:16.2": "ñatvā munī nissaye so vimaṃsī, ",
  "snp4.11:16.3": "ñatvā vimutto na vivādam eti ",
  "snp4.11:16.4": "bhavābhavāya na sameti dhīro\" ti KALAHAVIVĀDASUTTAṂ NIṬṬHITAṂ. 878. \"Sakaṃ sakaṃ diṭṭhi paribbasānā ",
  "snp4.11:16.5": ""
}
