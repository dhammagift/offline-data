{
  "snp4.14:0.1": "",
  "snp4.14:0.2": "",
  "snp4.14:1.1": "\"Pucchāmi taṃ Adiccabandhaṃ ",
  "snp4.14:1.2": "vivekaṃ santipadañ ca mahesiṃ: ",
  "snp4.14:1.3": "kathaṃ disvā nibbāti bhikkhu ",
  "snp4.14:1.4": "anupādiyāno lokasmiṃ kiñci\". 916. ",
  "snp4.14:2.1": "\"Mūlaṃ papañcasaṃkhāyā ",
  "snp4.14:2.2": "ti Bhagavā ",
  "snp4.14:2.3": "‘mantā asmī' ti sabbam uparundhe, ",
  "snp4.14:2.4": "yā kāci taṇhā ajjhattaṃ, ",
  "snp4.14:2.5": "tāsaṃ vinayā sadā sato sikkhe. 917. ",
  "snp4.14:3.1": "Yaṃ kiñci dhammam abhijaññā ",
  "snp4.14:3.2": "ajjhattam atha vā pi bahiddhā, ",
  "snp4.14:3.3": "na tena thāmaṃ kubbetha, ",
  "snp4.14:3.4": "na hi sā nibbuti sataṃ vuttā: 918. ",
  "snp4.14:4.1": "seyyo na tena maññeyya ",
  "snp4.14:4.2": "nīceyyo atha vā pi sarikkho, -- ",
  "snp4.14:4.3": "puṭṭho anekarūpehi ",
  "snp4.14:4.4": "nātumānaṃ vikappayan tiṭṭhe. 919. ",
  "snp4.14:5.1": "Ajjhattam eva ",
  "snp4.14:5.2": "upasame, nāññato bhikkhu santim eseyya: ",
  "snp4.14:5.3": "ajjhattaṃ upasantassa ",
  "snp4.14:5.4": "n' atthi attā, kuto nirattaṃ vā. 920. ",
  "snp4.14:6.1": "Majjhe yathā samuddassa ",
  "snp4.14:6.2": "ūmi no jāyatī, ṭhito hoti, ",
  "snp4.14:6.3": "evaṃ ṭhito onej' assa: ",
  "snp4.14:6.4": "ussadaṃ bhikkhu na kareyya kuhiñci\". 921. ",
  "snp4.14:7.1": "\"Akittayi vivaṭacakkhu ",
  "snp4.14:7.2": "sakkhi dhammaṃ parissayavinayaṃ, ",
  "snp4.14:7.3": "paṭipadaṃ vadehi, bhaddan te, ",
  "snp4.14:7.4": "pātimokkhaṃ atha vā pi samādhiṃ\". 922. ",
  "snp4.14:8.1": "\"Cakkhūhi n' eva lol' assa, ",
  "snp4.14:8.2": "gāmakathāya āvaraye sotaṃ, ",
  "snp4.14:8.3": "rase ca nānugijjheyya, ",
  "snp4.14:8.4": "na ca mamāyetha kiñci lokasmiṃ. 923. ",
  "snp4.14:9.1": "Phassena yadā phuṭṭh' assa, ",
  "snp4.14:9.2": "paridevaṃ bhikkhu na kareyya kuhiñci, ",
  "snp4.14:9.3": "bhavañ ca nābhijappeyya ",
  "snp4.14:9.4": "bheravesu ca na sampavedheyya. 924. ",
  "snp4.14:10.1": "Annānam atho pānānaṃ ",
  "snp4.14:10.2": "khādaniyānaṃ atho pi vatthānaṃ ",
  "snp4.14:10.3": "laddhā na sannidhiṃ kayirā, ",
  "snp4.14:10.4": "na ca parittase tāni alabhamāno. 925. ",
  "snp4.14:11.1": "Jhāyī na pādalol' assa, ",
  "snp4.14:11.2": "virame kukkuccaṃ, na-ppamajjeyya, atha ",
  "snp4.14:11.3": "āsanesu sayanesu ",
  "snp4.14:11.4": "appasaddesu bhikkhu vihareyya. 926. ",
  "snp4.14:12.1": "Niddaṃ na bahulīkareyya, ",
  "snp4.14:12.2": "jāgariyaṃ bhajeyya ātāpī, ",
  "snp4.14:12.3": "tandiṃ māyaṃ hassaṃ khiḍḍaṃ ",
  "snp4.14:12.4": "methunaṃ vippajahe savibhūsaṃ. 927. ",
  "snp4.14:13.1": "Āthabbaṇaṃ supinaṃ lakkhaṇaṃ ",
  "snp4.14:13.2": "no vidahe atho pi nakkhattaṃ, ",
  "snp4.14:13.3": "virutañ ca gabbhakaraṇaṃ ",
  "snp4.14:13.4": "tikicchaṃ māmako na seveyya. 928. ",
  "snp4.14:14.1": "Nindāya na-ppavedheyya, ",
  "snp4.14:14.2": "na uṇṇameyya pasaṃsito bhikkhu, ",
  "snp4.14:14.3": "lobhaṃ saha macchariyena ",
  "snp4.14:14.4": "kodhaṃ pesuṇiyañ ca panudeyya. 929. ",
  "snp4.14:15.1": "Kayavikkaye na tiṭṭheyya, ",
  "snp4.14:15.2": "upavādaṃ bhikkhu na kareyya kuhiñci, ",
  "snp4.14:15.3": "gāme ca nābhisajjeyya, ",
  "snp4.14:15.4": "lābhakamyā janaṃ na lāpayeyya. 930. ",
  "snp4.14:16.1": "Na ca katthitā siyā bhikkhu, ",
  "snp4.14:16.2": "na ca vācaṃ payutaṃ bhāseyya, ",
  "snp4.14:16.3": "pāgabbhiyaṃ na sikkheyya, ",
  "snp4.14:16.4": "kathaṃ viggākikaṃ na kathayeyya. 931. ",
  "snp4.14:17.1": "Mosavajje na niyyetha, ",
  "snp4.14:17.2": "sampajāno saṭhāni na kayirā,| ",
  "snp4.14:17.3": "atha jīvitena paññāya ",
  "snp4.14:17.4": "sīlavatena nāññam atimaññe. 932. ",
  "snp4.14:18.1": "Sutvā rusito bahuṃ vācaṃ ",
  "snp4.14:18.2": "samaṇānaṃ puthuvacanānaṃ ",
  "snp4.14:18.3": "pharusena ne na paṭivajjā, ",
  "snp4.14:18.4": "na hi santo paṭisenikaronti. 933. ",
  "snp4.14:19.1": "Etañ ca dhammam aññāya ",
  "snp4.14:19.2": "vicinaṃ bhikkhu sadā sato sikkhe, ",
  "snp4.14:19.3": "‘santī' ti nibbutiṃ ñatvā ",
  "snp4.14:19.4": "sāsane Gotamassa na-ppamajjeyya. 934. ",
  "snp4.14:20.1": "Abhibhū hi so anabhibhūto ",
  "snp4.14:20.2": "sakkhi dhammaṃ anītiham adassī ",
  "snp4.14:20.3": "tasmā hi tassa Bhagavato sāsane ",
  "snp4.14:20.4": "appamatto sadā namassam anusikkhe\" ti Bhagavā ti ",
  "snp4.14:20.5": "TUVAṬAKASUTTAṂ NIṬṬHITAṂ. 935. "
}
