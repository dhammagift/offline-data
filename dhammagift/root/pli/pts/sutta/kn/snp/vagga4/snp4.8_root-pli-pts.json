  "snp4.8:0.1": "",
  "snp4.8:0.2": "",
  "snp4.8:1.1": "suddhi\" iti vādiyanti, ",
  "snp4.8:1.2": "nāññesu dhammesu visuddhim āhu, ",
  "snp4.8:1.3": "yaṃ nissitā, tatthā subhaṃ vadānā ",
  "snp4.8:1.4": "paccekasaccesu puthū niviṭṭhā. 825. ",
  "snp4.8:2.1": "Te vādakāmā parisaṃ vigayha ",
  "snp4.8:2.2": "bālaṃ dahanti mithu aññamaññaṃ, ",
  "snp4.8:2.3": "vadenti te aññasitā kathojjaṃ ",
  "snp4.8:2.4": "pasaṃsakāmā kusalā vadānā. 826. ",
  "snp4.8:3.1": "Yutto kathāyaṃ parisāya majjhe ",
  "snp4.8:3.2": "pasaṃsam icchaṃ vinighāti hoti, ",
  "snp4.8:3.3": "apāhatasmiṃ pana maṃku hoti, ",
  "snp4.8:3.4": "nindāya so kuppati randhamesī. 827. ",
  "snp4.8:4.1": "Yam assa vādaṃ parihīnam āhu ",
  "snp4.8:4.2": "apāhataṃ pañhavīmaṃsakāse, ",
  "snp4.8:4.3": "paridevati socati hīnavādo, ",
  "snp4.8:4.4": "‘upaccagā man' ti anutthuṇāti. 828. ",
  "snp4.8:5.1": "Ete vivādā samaṇesu jātā, ",
  "snp4.8:5.2": "etesu ugghāti nighāti hoti, ",
  "snp4.8:5.3": "etam pi disvā virame kathojjam, ",
  "snp4.8:5.4": "na h' aññadatth' atthi pasaṃsalābhā. 829. ",
  "snp4.8:6.1": "pasaṃsito vā pana tattha hoti ",
  "snp4.8:6.2": "akkhāya vādaṃ parisāya majjhe, ",
  "snp4.8:6.3": "so hassati uṇṇamati-cca tena ",
  "snp4.8:6.4": "pappuyya tam atthaṃ yathā mano ahū. 830. ",
  "snp4.8:7.1": "Yā uṇṇati, sāssa vighātabhūmi, ",
  "snp4.8:7.2": "mānātimānaṃ vadate pan' eso, ",
  "snp4.8:7.3": "*etam pi disvā na vivādayethā,* ",
  "snp4.8:7.4": "na hi tena suddhiṃ kusalā vadanti. 831. ",
  "snp4.8:8.1": "sūro yathā rājakhādāya puṭṭho ",
  "snp4.8:8.2": "abhigajjam eti paṭisūram icchaṃ, ",
  "snp4.8:8.3": "yen' eva so tena palehi sūra, ",
  "snp4.8:8.4": "pubbe va n' atthi yad idaṃ yudhāya. 832. ",
  "snp4.8:9.1": "Ye diṭṭhim uggayha vivādiyanti ",
  "snp4.8:9.2": "\"idam eva saccan\" ti ca vādiyanti,| ",
  "snp4.8:9.3": "te tvaṃ vadassu, an hi te 'dha atthi ",
  "snp4.8:9.4": "vādamhi jāte paṭisenikattā. 833. ",
  "snp4.8:10.1": "Visenikatvā pana ye caranti ",
  "snp4.8:10.2": "diṭṭhīhi diṭṭhim avirujjhamānā, ",
  "snp4.8:10.3": "tesu tvaṃ kiṃ labhetho Pasūra, ",
  "snp4.8:10.4": "yes' īdha n' atthi param uggahītaṃ. 834. ",
  "snp4.8:11.1": "Atha tvaṃ pavitakkam āgamā ",
  "snp4.8:11.2": "manasā diṭṭhigatāni cintayanto, ",
  "snp4.8:11.3": "dhonena yugaṃ samāgamā, ",
  "snp4.8:11.4": "na hi tvaṃ sagghasi sampayātave ti ",
  "snp4.8:11.5": "PASŪRASUTTAṂ NIṬṬHITAṂ. 835. "
}
