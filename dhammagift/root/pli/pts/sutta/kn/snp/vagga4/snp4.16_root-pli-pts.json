{
  "snp4.16:0.1": "",
  "snp4.16:0.2": "",
  "snp4.16:1.1": "\"Na me diṭṭho ito pubbe ",
  "snp4.16:1.2": "icc-āyasmā Sāriputto ",
  "snp4.16:1.3": "na-ssuto uda kassaci ",
  "snp4.16:1.4": "evaṃ vagguvado satthā ",
  "snp4.16:1.5": "Tusitā gaṇi-m-āgato 956. ",
  "snp4.16:2.1": "sadevakassa lokassa, ",
  "snp4.16:2.2": "yathā dissati cakkhumā: ",
  "snp4.16:2.3": "sabbaṃ tamaṃ vinodetvā ",
  "snp4.16:2.4": "eko va ratim ajjhagā. 957. ",
  "snp4.16:3.1": "Tam Buddhaṃ asitaṃ tādiṃ ",
  "snp4.16:3.2": "akuhaṅ gaṇim āgataṃ bahunnam ",
  "snp4.16:3.3": "idha baddhānaṃ ",
  "snp4.16:3.4": "atthi pañhena āga- miṃ: 958. ",
  "snp4.16:4.1": "Bhikkhuno vijigucchato ",
  "snp4.16:4.2": "bhajato rittam āsanaṃ ",
  "snp4.16:4.3": "rukkhamūlaṃ susānaṃ vā, ",
  "snp4.16:4.4": "pabbatānaṃ guhāsu vā 959. ",
  "snp4.16:5.1": "uccāvacesu sayanesu, ",
  "snp4.16:5.2": "kīvanto tattha bheravā, ",
  "snp4.16:5.3": "yehi bhikkhu na vedheyya ",
  "snp4.16:5.4": "nigghose sayanāsane. 960. ",
  "snp4.16:6.1": "Kati parissayā loke ",
  "snp4.16:6.2": "gacchato amataṃ disaṃ, ",
  "snp4.16:6.3": "ye bhikkhu abhisambhave ",
  "snp4.16:6.4": "pantamhi sayanāsane. 961. ",
  "snp4.16:7.1": "Ky-āssa vyappathayo assu, ",
  "snp4.16:7.2": "ky-āss' assu idha gocarā, ",
  "snp4.16:7.3": "kāni sīlabbatān' assu ",
  "snp4.16:7.4": "pahitattassa bhikkhuno. 962. ",
  "snp4.16:8.1": "Kaṃ so sikkhaṃ samādāya ",
  "snp4.16:8.2": "ekodi nipako sato ",
  "snp4.16:8.3": "kammāro rajatasseva ",
  "snp4.16:8.4": "niddhame malam attano\". 963. ",
  "snp4.16:9.1": "\"Vijigucchamānassa yad idaṃ phāsu, ",
  "snp4.16:9.2": "Sāriputtā ti Bhagavā ",
  "snp4.16:9.3": "rittāsanaṃ sayanaṃ sevato ce ",
  "snp4.16:9.4": "sambodhikāmassa, yathānudhammaṃ ",
  "snp4.16:9.5": "taṃ te pavakkhāmi yathā pajānaṃ. 964. ",
  "snp4.16:10.1": "Pañcannaṃ dhīro bhayānaṃ na bhāye ",
  "snp4.16:10.2": "bhikkhu sato (sa) pariyantacārī: ",
  "snp4.16:10.3": "ḍaṃsādhipātānaṃ siriṃsapānaṃ ",
  "snp4.16:10.4": "manussaphassānaṃ catuppadānaṃ, 965. ",
  "snp4.16:11.1": "paradhammikānam pi na santaseyya ",
  "snp4.16:11.2": "disvā pi tesaṃ bahubheravāni, ",
  "snp4.16:11.3": "athāparāni abhisambhaveyya ",
  "snp4.16:11.4": "parissayāni kusalānesī. 966. ",
  "snp4.16:12.1": "Ātaṃkaphassena khudāya phuṭṭho ",
  "snp4.16:12.2": "sītaṃ accuṇhaṃ adhivāsayeyya, ",
  "snp4.16:12.3": "sa tehi phuṭṭho bahudhā anoko ",
  "snp4.16:12.4": "viriyaṃ parakkamma daḷhaṃ kareyya. 967. ",
  "snp4.16:13.1": "Theyyaṃ na kareyya, na musā bhaṇeyya, ",
  "snp4.16:13.2": "mettāya phasse tasathāvarāni, ",
  "snp4.16:13.3": "yad āvilattaṃ manaso vijaññā, ",
  "snp4.16:13.4": "‘kaṇhassa pakkho' ti vinodayeyya. 968. ",
  "snp4.16:14.1": "Kodhātimānassa vasaṃ na gacche, ",
  "snp4.16:14.2": "mūlam pi tesaṃ palikhañña tiṭṭhe, ",
  "snp4.16:14.3": "atha-ppiyaṃ vā pana appiyaṃ vā ",
  "snp4.16:14.4": "addhā bhavanto abhisambhaveyya. 969. ",
  "snp4.16:15.1": "Paññaṃ purakkhatvā kalyāṇapīti ",
  "snp4.16:15.2": "vikkhambhaye tāni parissayāni, ",
  "snp4.16:15.3": "aratiṃ sahetha sayanamhi pante, ",
  "snp4.16:15.4": "caturo sahetha paridevadhamme: 970. ",
  "snp4.16:16.1": "‘kiṃ su asissāmi, kuvaṃ vā asissaṃ ",
  "snp4.16:16.2": "dukkhaṃ vata settha, kuv' ajja sessaṃ' ",
  "snp4.16:16.3": "ete vitakke paridevaneyye ",
  "snp4.16:16.4": "vinayetha sekho aniketasārī. 971. ",
  "snp4.16:17.1": "Annañ ca laddhā vasanañ ca kāle ",
  "snp4.16:17.2": "mattaṃ so jaññā idha tosanatthaṃ, ",
  "snp4.16:17.3": "sotesu gutto yatacāri gāme ",
  "snp4.16:17.4": "rusito pi vācaṃ pharusaṃ na vajjā. 972. ",
  "snp4.16:18.1": "Okkhittacakkhu na ca pādalolo ",
  "snp4.16:18.2": "jhānānuyutto bahujāgar' assa, upekham ",
  "snp4.16:18.3": "ārabbha samāhitatto ",
  "snp4.16:18.4": "takkāsayaṃ kukkucciy' ūpacchinde. 973. ",
  "snp4.16:19.1": "Cudito vacīhi satimābhinande, ",
  "snp4.16:19.2": "sabrahmacārīsu khilaṃ pabhinde, ",
  "snp4.16:19.3": "vācaṃ pamuñce kusalaṃ nātivelaṃ, ",
  "snp4.16:19.4": "janavādadhammāya na cetayeyya. 974. ",
  "snp4.16:20.1": "Athāparaṃ pañca rajāni loke ",
  "snp4.16:20.2": "yesaṃ satīmā vinayāya sikkhe: ",
  "snp4.16:20.3": "rūpesu saddesu atho rasesu ",
  "snp4.16:20.4": "gandhesu phassesu sahetha rāgaṃ. 975. ",
  "snp4.16:21.1": "Etesu dhammesu vineyya chandaṃ ",
  "snp4.16:21.2": "bhikkhu satīmā suvimuttacitto ",
  "snp4.16:21.3": "kālena so samma dhammaṃ parivīmaṃsamāno ",
  "snp4.16:21.4": "ekodibhūto vihane tamaṃ so\" ti Bhagavā ti ",
  "snp4.16:21.5": "SĀRIPUTTASUTTAṂ NIṬṬHITAṂ. Tass' uddānaṃ: ",
  "snp4.16:21.6": "",
  "snp4.16:22.0": "",
  "snp4.16:22.1": "Kāma-Guhañ ca Duṭṭhā ca ",
  "snp4.16:22.2": "Suddhañ ca Paramā Jarā ",
  "snp4.16:22.3": "Metteyyo ca Pasūro ca ",
  "snp4.16:22.4": "Māgandi Purabhedanaṃ ",
  "snp4.16:23.1": "Kalahaṃ dve ca Vyūhāni punar ",
  "snp4.16:23.2": "eva Tuvaṭṭakaṃ ",
  "snp4.16:23.3": "Attadaṇḍavarasuttaṃ Therapañhena ",
  "snp4.16:23.4": "soḷasa, ",
  "snp4.16:23.5": "tāni etāni suttāni ",
  "snp4.16:23.6": "sabbān' Aṭṭhakavaggikā ti.| 1. Vatthugāthā. 976. "
}
