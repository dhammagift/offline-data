{
  "snp4.3:0.1": "",
  "snp4.3:0.2": "",
  "snp4.3:1.1": "Vadanti ve duṭṭhamanā pi eke, ",
  "snp4.3:1.2": "atho pi ve saccamanā vadanti, ",
  "snp4.3:1.3": "vādañ ca jātaṃ muni no upeti, ",
  "snp4.3:1.4": "tasmā munī n' atthi khilo kuhiñci. 781. ",
  "snp4.3:2.1": "Sakaṃ hi diṭṭhiṃ katham accayeyya ",
  "snp4.3:2.2": "chandānunīto ruciyā niviṭṭho ",
  "snp4.3:2.3": "sayaṃ samattāni pakubbamāno: ",
  "snp4.3:2.4": "yathā hi jāneyya, tathā vadeyya. 782. ",
  "snp4.3:3.1": "Yo attano sīlavatāni jantu ",
  "snp4.3:3.2": "anānupuṭṭho ca paresa pāvā, ",
  "snp4.3:3.3": "anariyadhammaṃ kusalā tam āhu, ",
  "snp4.3:3.4": "yo ātumānaṃ sayam eva pāvā. 783. ",
  "snp4.3:4.1": "Santo ca bhikkhu abhinibbutatto ",
  "snp4.3:4.2": "\"iti 'han\" ti sīlesu akatthamāno, -- ",
  "snp4.3:4.3": "tam ariyadhammaṃ kusalā vadanti, ",
  "snp4.3:4.4": "yass' ussadā n' atthi kuhiñci loke. 784. ",
  "snp4.3:5.1": "Pakappitā saṃkhatā yassa dhammā ",
  "snp4.3:5.2": "purakkhatā santi avīvadātā, ",
  "snp4.3:5.3": "yad attanī passati ānisaṃsaṃ, ",
  "snp4.3:5.4": "taṃ nissito kuppapaṭiccasantiṃ 785. ",
  "snp4.3:6.1": "Diṭṭhīnivesā na hi svātivattā ",
  "snp4.3:6.2": "dhammesu niccheyya samuggahītaṃ, ",
  "snp4.3:6.3": "tasmā naro tesu nivesanesu ",
  "snp4.3:6.4": "nirassati ādiyati-cca dhammaṃ. 786. ",
  "snp4.3:7.1": "dhonassa hī n' atthi kuhiñci loke ",
  "snp4.3:7.2": "pakappitā diṭṭhi bhavābhavesu, ",
  "snp4.3:7.3": "māyañ ca mānañ ca pahāya dhono ",
  "snp4.3:7.4": "sa kena gaccheyya: anūpayo so. 787. ",
  "snp4.3:8.1": "Upayo hi dhammesu upeti vādaṃ, ",
  "snp4.3:8.2": "anūpayaṃ kena kathaṃ vadeyya, ",
  "snp4.3:8.3": "attaṃ nirattaṃ na hi tassa atthi: ",
  "snp4.3:8.4": "adhosi so diṭṭhi-m-idh' eva sabbā ti ",
  "snp4.3:8.5": "DUṬṬHAṬṬHAKASUTTAṂ NIṬṬHITAṂ. 788. "
}
