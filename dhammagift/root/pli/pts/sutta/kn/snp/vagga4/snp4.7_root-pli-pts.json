  "snp4.7:1.1": "",
  "snp4.7:1.2": "Tisso Metteyyo ",
  "snp4.7:1.3": "vighātaṃ brūhi mārisa , ",
  "snp4.7:1.4": "sutvāna tava sāsanaṃ ",
  "snp4.7:1.5": "viveke sikkhissāmase\". 815. ",
  "snp4.7:2.1": "\"Methunam anuyuttassa ",
  "snp4.7:2.2": "Metteyyā ti Bhagavā ",
  "snp4.7:2.3": "mussat' evāpi sāsanaṃ, ",
  "snp4.7:2.4": "micchā ca paṭipajjati, ",
  "snp4.7:2.5": "etaṃ tasmiṃ anāriyaṃ. 816. ",
  "snp4.7:3.1": "Eko pubbe caritvāna ",
  "snp4.7:3.2": "methunaṃ yo nisevati, ",
  "snp4.7:3.3": "yānaṃ bhantaṃ va taṃ loke ",
  "snp4.7:3.4": "hīnam āhu putujjanaṃ. 817. ",
  "snp4.7:4.1": "Yaso kitti ca yā pubbe, ",
  "snp4.7:4.2": "hāyat' evāpi tassa sā, ",
  "snp4.7:4.3": "etam pi disvā sikkhetha ",
  "snp4.7:4.4": "methunaṃ vippahātave. 818. ",
  "snp4.7:5.1": "Saṃkappehi pareto so ",
  "snp4.7:5.2": "kapaṇo viya jhāyati, ",
  "snp4.7:5.3": "sutvā paresaṃ nigghosaṃ ",
  "snp4.7:5.4": "maṃku hoti tathāvidho. 819. ",
  "snp4.7:6.1": "Atha satthāni Kurute ",
  "snp4.7:6.2": "paravādehi codito, ",
  "snp4.7:6.3": "esa khv-assa mahāgedho: ",
  "snp4.7:6.4": "mosavajjaṃ pagāhati. 820. ",
  "snp4.7:7.1": "Paṇḍito ti samaññāto ",
  "snp4.7:7.2": "ekacariyaṃ adhiṭṭhito, ",
  "snp4.7:7.3": "athāpi methune yutto ",
  "snp4.7:7.4": "mando va parikissati. 821. ",
  "snp4.7:8.1": "Etam ādīnavaṃ ñatvā ",
  "snp4.7:8.2": "muni pubbāpare idha ",
  "snp4.7:8.3": "ekacariyaṃ daḷhaṃ kayirā, ",
  "snp4.7:8.4": "na nisevetha methunaṃ. 822. ",
  "snp4.7:9.1": "Vivekaṃ yeva sikkhetha, ",
  "snp4.7:9.2": "*etad ariyānam* uttamaṃ, ",
  "snp4.7:9.3": "#tena seṭṭho na# maññetha, ",
  "snp4.7:9.4": "sa ve nibbānasantike. 823. ",
  "snp4.7:10.1": "Rittassa munino carato ",
  "snp4.7:10.2": "kāmesu anapekhino ",
  "snp4.7:10.3": "oghatiṇṇassa pihayanti ",
  "snp4.7:10.4": "kāmesu gathitā pajā\" ti. TISSAMETTEYYASUTTAṂ NIṬṬHITAṂ. 824. \"Idh' eva ",
  "snp4.7:10.5": ""
}
