  "snp4.12:1.1": "",
  "snp4.12:1.2": "viggayha nānā kusalā vadanti: ",
  "snp4.12:1.3": "‘yo evaṃ jānāti, sa vedi dhammaṃ, ",
  "snp4.12:1.4": "idam paṭikkosam akevalī so.' 879. ",
  "snp4.12:2.1": "Evam pi viggayha vivādiyanti, ",
  "snp4.12:2.2": "‘bālo paro akusalo' ti cāhu, ",
  "snp4.12:2.3": "sacco nu vādo katamo imesaṃ, ",
  "snp4.12:2.4": "sabbe va h' ime kusalā vadānā\". 880. ",
  "snp4.12:3.1": "\"Parassa ce dhammam anānujānaṃ bālo ",
  "snp4.12:3.2": "mago hoti nihīnapañño, ",
  "snp4.12:3.3": "sabbe va bālā sunihīnapaññā, ",
  "snp4.12:3.4": "sabbe v' ime diṭṭhi paribbasānā. 881. ",
  "snp4.12:4.1": "Sandiṭṭhiyā ce pana vīvadātā ",
  "snp4.12:4.2": "saṃsuddhapaññā kusalā mutīmā, ",
  "snp4.12:4.3": "na tesaṃ koci parihīnapañño, ",
  "snp4.12:4.4": "diṭṭhi hi tesam pi tathā samattā. 882. ",
  "snp4.12:5.1": "Na vāham ‘etaṃ tathiyan' ti brūmi, ",
  "snp4.12:5.2": "yam āhu bālā mithu aññamaññaṃ: ",
  "snp4.12:5.3": "sakaṃ sakaṃ diṭṭhim akaṃsu saccaṃ, ",
  "snp4.12:5.4": "tasmā hi ‘bālo' ti paraṃ dahanti\". 883. ",
  "snp4.12:6.1": "\"Yam āhu ‘saccaṃ tathiyan' ti eke, ",
  "snp4.12:6.2": "tam āhu aññe ‘tucchaṃ musā' ti, ",
  "snp4.12:6.3": "evam pi viggayha vivādiyanti, ",
  "snp4.12:6.4": "kasmā na ekaṃ samaṇā vadanti\". 884. ",
  "snp4.12:7.1": "\"Ekaṃ hi saccaṃ na dutīyam atthi, ",
  "snp4.12:7.2": "yasmiṃ pajāno vivade pajānaṃ, ",
  "snp4.12:7.3": "nānā te saccāni sayaṃ thunanti, ",
  "snp4.12:7.4": "tasmā na ekaṃ samaṇā vadanti\". 885. ",
  "snp4.12:8.1": "\"Kasmā nu saccāni vadanti nānā ",
  "snp4.12:8.2": "pavādiyāse kusalā vadānā: ",
  "snp4.12:8.3": "saccāni su tāni bahūni nānā, ",
  "snp4.12:8.4": "udāhu te takkam anussaranti\". 886. ",
  "snp4.12:9.1": "\"Na h' eva saccāni bahūni nānā, ",
  "snp4.12:9.2": "aññatra saññāya niccāni loke, ",
  "snp4.12:9.3": "takkañ ca diṭṭhīsu pakappayitvā ",
  "snp4.12:9.4": "‘saccaṃ, musā' ti dvayadhammam āhu. 887. ",
  "snp4.12:10.1": "Diṭṭhe sute sīlavate mute vā ",
  "snp4.12:10.2": "ete ca nissāya vimānadassī ",
  "snp4.12:10.3": "vinicchaye ṭhatva pahassamāno ",
  "snp4.12:10.4": "‘bālo paro akusalo' ti cāha. 888. ",
  "snp4.12:11.1": "Yen' eva ‘bālo' ti paraṃ dahāti, ",
  "snp4.12:11.2": "tenātumānaṃ ‘kusalo' ti cāha: ",
  "snp4.12:11.3": "sayam attanā so kusalo vadāno ",
  "snp4.12:11.4": "aññaṃ vimāneti, tath' eva pāvā. 889. ",
  "snp4.12:12.1": "Atīsaraṃdiṭṭhiyā so samatto ",
  "snp4.12:12.2": "mānena matto paripuṇṇamānī ",
  "snp4.12:12.3": "sayam eva sāmaṃ manasābhisitto, ",
  "snp4.12:12.4": "diṭṭhī hi sā tassa tathā samattā. 890. ",
  "snp4.12:13.1": "Parassa ce hi vacasā nihīno, ",
  "snp4.12:13.2": "tumo sahā hoti nihīnapañño: ",
  "snp4.12:13.3": "atha ce sayaṃ vedagū hoti dhīro, ",
  "snp4.12:13.4": "na koci bālo samaṇesu atthi. 891. ",
  "snp4.12:14.1": "‘Aññaṃ ito yābhivadanti dhammaṃ, ",
  "snp4.12:14.2": "aparaddhā suddhim akevalīno,' evaṃ ",
  "snp4.12:14.3": "hi tithyā puthuso vadanti, ",
  "snp4.12:14.4": "sandiṭṭhirāgena *hi te* 'bhirattā. 892. ",
  "snp4.12:15.1": "‘Idh' eva suddhi' iti vādiyanti, ",
  "snp4.12:15.2": "nāññesu dhammesu visuddhim āhu, ",
  "snp4.12:15.3": "evam pi tithyā puthuso niviṭṭhā ",
  "snp4.12:15.4": "sakāyane tattha daḷhaṃ vadānā. 893. ",
  "snp4.12:16.1": "Sakāyane cāpi daḷhaṃ vadāno ",
  "snp4.12:16.2": "kam ettha ‘bālo' ti paraṃ daheyya: ",
  "snp4.12:16.3": "sayam eva so medhakaṃ āvaheyya ",
  "snp4.12:16.4": "paraṃ vadaṃ bālam asuddhidhammaṃ. 894. ",
  "snp4.12:17.1": "Vinicchaye ṭhatvā sayaṃ pamāya ",
  "snp4.12:17.2": "uddhaṃ so lokasmiṃ vivādam eti, ",
  "snp4.12:17.3": "hitvāna sabbāni vinicchayāni ",
  "snp4.12:17.4": "na medhakaṃ kurute jantu loke\" ti ",
  "snp4.12:17.5": "CŪḶAVIYŪHASUTTAṂ NIṬṬHITAṂ. 895. "
}
