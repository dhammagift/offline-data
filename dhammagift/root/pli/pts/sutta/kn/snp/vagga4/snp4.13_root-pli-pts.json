{
  "snp4.13:0.1": "",
  "snp4.13:0.2": "",
  "snp4.13:1.1": "\"Ye kec' ime diṭṭhi paribbasānā ",
  "snp4.13:1.2": "‘idam eva saccan' ti vivādiyanti, ",
  "snp4.13:1.3": "sabbe va te nindam anvānayanti ",
  "snp4.13:1.4": "atho pasaṃsam pi labhanti tattha\". 896. ",
  "snp4.13:2.1": "\"Appaṃ hi etaṃ na alaṃ samāya, ",
  "snp4.13:2.2": "duve vivādassa phalāni brūmi, ",
  "snp4.13:2.3": "etam pi disvā na vivādiyetha ",
  "snp4.13:2.4": "khemābhipassaṃ avivādabhūmiṃ. 897. ",
  "snp4.13:3.1": "Yā kāc' imā sammutiyo puthujjā, ",
  "snp4.13:3.2": "sabbā va etā na upeti vidvā, ",
  "snp4.13:3.3": "anūpayo so upayaṃ kim eyya ",
  "snp4.13:3.4": "diṭṭhe sute khantim akubbamāno. 898. ",
  "snp4.13:4.1": "Sīluttamā saññamenāhu suddhiṃ ",
  "snp4.13:4.2": "vataṃ samādāya upaṭṭhitāse ",
  "snp4.13:4.3": "‘idh' eva sikkema, ath' assa suddhiṃ' ",
  "snp4.13:4.4": "bhavūpanītā kusalā vadānā. 899. ",
  "snp4.13:5.1": "Sace cuto sīlavatāto hoti, ",
  "snp4.13:5.2": "sa vedhati kammaṃ virādhayitvā, ",
  "snp4.13:5.3": "sa jappati paṭṭhayatīdha suddhiṃ ",
  "snp4.13:5.4": "satthā va hīno pavasaṃ gharamhā. 900. ",
  "snp4.13:6.1": "Sīlabbataṃ vāpi pahāya sabbaṃ ",
  "snp4.13:6.2": "kammañ ca sāvajjanavajjam etaṃ| ‘suddhī, ",
  "snp4.13:6.3": "asuddhī' ti apattayāno ",
  "snp4.13:6.4": "virato care santim anuggahāya. 901. ",
  "snp4.13:7.1": "Tapūpanissāya jigucchitaṃ vā ",
  "snp4.13:7.2": "atha vā pi diṭṭhaṃ va sutaṃ mutaṃ vā ",
  "snp4.13:7.3": "uddhaṃsarā suddhim anutthuṇanti ",
  "snp4.13:7.4": "avītataṇhāse bhavābhavesu. 902. ",
  "snp4.13:8.1": "Patthayamānassa hi jappitāni ",
  "snp4.13:8.2": "saṃvedhitaṃ cāpi pakappitesu: ",
  "snp4.13:8.3": "cutūpapāto idha yassa n' atthi, ",
  "snp4.13:8.4": "sa kena vedheyya kuhiñ ca jappe. 903. ",
  "snp4.13:9.1": "\"Yam āhu dhammaṃ ‘paraman' ti eke , ",
  "snp4.13:9.2": "tam eva ‘hīnan' ti panāhu aññe: ",
  "snp4.13:9.3": "sacco nu vādo katamo imesaṃ, ",
  "snp4.13:9.4": "sabbe va hīme kusalā vadānā. 904. Sakaṃ ",
  "snp4.13:10.1": "hi dhammaṃ paripuṇṇam āhu ",
  "snp4.13:10.2": "*aññassa dhammaṃ pana hīnam āhu,* ",
  "snp4.13:10.3": "evam pi viggayha vivādiyanti ",
  "snp4.13:10.4": "sakaṃ sakaṃ sammutim āhu saccaṃ\". 905. ",
  "snp4.13:11.1": "\"Parassa ce vambhayitena hīno, ",
  "snp4.13:11.2": "na koci dhammesu visesi assa, ",
  "snp4.13:11.3": "puthū hi aññassa vadanti dhammaṃ ",
  "snp4.13:11.4": "nihīnato samhi daḷhaṃ vadānā. 906. ",
  "snp4.13:12.1": "Sadhammapūjā ca panā tath' eva: ",
  "snp4.13:12.2": "yathā pasaṃsanti sakāyanāni, ",
  "snp4.13:12.3": "sabbe va vādā thathivā bhaveyyuṃ, ",
  "snp4.13:12.4": "suddhī hi nesaṃ paccattam eva. 907. ",
  "snp4.13:13.1": "Na brāhmaṇassa paraneyyam atthi ",
  "snp4.13:13.2": "dhammesu niccheyya samuggahītaṃ, ",
  "snp4.13:13.3": "tasmā vivādāni upātivatto, ",
  "snp4.13:13.4": "na hi seṭṭhato passati dhammam aññaṃ. 908. ",
  "snp4.13:14.1": "‘Jānāmi passāmi, tath' eva etaṃ' ",
  "snp4.13:14.2": "diṭṭhiyā eke paccenti suddhiṃ: ",
  "snp4.13:14.3": "addakkhi ce, kiṃ hi tumassa tena, ",
  "snp4.13:14.4": "atisitvā aññena vadantī suddhiṃ. 909. ",
  "snp4.13:15.1": "Passaṃ naro dakkhiti nāmarūpaṃ, ",
  "snp4.13:15.2": "disvāna vāññassati tāni-m-eva: ",
  "snp4.13:15.3": "kāmaṃ bahuṃ passatu appakaṃ vā, ",
  "snp4.13:15.4": "na hi tena suddhiṃ kusalā vadanti. 910. ",
  "snp4.13:16.1": "Nivissavādī na hi suddhināyo ",
  "snp4.13:16.2": "pakappitaṃ diṭṭhi purekkharāno, ",
  "snp4.13:16.3": "yaṃ nissito, tattha subhaṃ vadāno ",
  "snp4.13:16.4": "suddhiṃvado tattha tath' addasā so. 911. ",
  "snp4.13:17.1": "Na brāhmaṇo kappam upeti saṃkhaṃ ",
  "snp4.13:17.2": "na diṭṭhisārī na pi ñāṇabandhu,| ",
  "snp4.13:17.3": "ñatvā ca so sammutiyo puthujjā ",
  "snp4.13:17.4": "upekhati, uggahaṇanta-m-aññe. 912. ",
  "snp4.13:18.1": "Visajja ganthāni munīdha loke ",
  "snp4.13:18.2": "",
  "snp4.13:18.3": "santo asantesu upekkhako so ",
  "snp4.13:18.4": "anuggaho, uggahaṇanta-m-aññe. 913. ",
  "snp4.13:19.1": "Pubbāsave hitvā nave akubbaṃ ",
  "snp4.13:19.2": "na chandagū no pi nivissavādo, ",
  "snp4.13:19.3": "sa vippamutto diṭṭhigatehi dhīro ",
  "snp4.13:19.4": "na lippati loke anattagarahī. 914. ",
  "snp4.13:20.1": "Sa sabbadhammesu visenibhūto, ",
  "snp4.13:20.2": "yaṃ kiñci diṭṭhaṃ va sutaṃ mutaṃ vā, ",
  "snp4.13:20.3": "sa pannabhāro muni vippayutto ",
  "snp4.13:20.4": "na kappiyo nūparato na patthiyo\" ti Bhagavā ti MAHĀVIYŪHASUTTAṂ NIṬṬHITAṂ. 915. ",
  "snp4.13:20.5": ""
}
