{
  "snp4.9:0.1": "",
  "snp4.9:0.2": "",
  "snp4.9:1.1": "\"disvāna Taṇhaṃ *Aratiṃ Ragañ ca* ",
  "snp4.9:1.2": "nāhosi chando api methunasmiṃ ",
  "snp4.9:1.3": "kim ev' edaṃ muttakarīsapuṇṇaṃ, ",
  "snp4.9:1.4": "pādā pi naṃ samphusitaṃ na icche\". 836. ",
  "snp4.9:2.1": "\"Etādisañ ce ratanam na icchasi ",
  "snp4.9:2.2": "nāriṃ narindehi bahūhi patthitaṃ, ",
  "snp4.9:2.3": "diṭṭhigataṃ silavatānujīvitaṃ bhavīpapattiñ ca ",
  "snp4.9:2.4": "vadesi kīdisaṃ\". 837. ",
  "snp4.9:3.1": "\"Idaṃ vadāmī' ti na tassa hoti ",
  "snp4.9:3.2": "Māgandiyā ti Bhagavā ",
  "snp4.9:3.3": "dhammesu niccheyya samuggahītaṃ, ",
  "snp4.9:3.4": "passañ ca diṭṭhīsu anuggahāya ",
  "snp4.9:3.5": "ajjhattasantiṃ pacinaṃ adassaṃ\". 838. ",
  "snp4.9:4.1": "\"Vinicchayā yāni pakappitāni, ",
  "snp4.9:4.2": "iti Māgandiyo ",
  "snp4.9:4.3": "te ve muni brūsi anuggahāya, ",
  "snp4.9:4.4": "‘ajjhattasantī' ti yam etam atthaṃ ",
  "snp4.9:4.5": "kathan nu dhīrehi paveditaṃ taṃ\". 839. ",
  "snp4.9:5.1": "\"Na diṭṭhiyā na sutiyā na ñāṇena, ",
  "snp4.9:5.2": "Māgandiyā ti Bhagavā ",
  "snp4.9:5.3": "sīlabbatenāpi *na suddhim* āha ",
  "snp4.9:5.4": "adiṭṭhiyā assutiyā aññāṇā ",
  "snp4.9:5.5": "asīlatā abbatā no pi tena, ",
  "snp4.9:5.6": "ete ca nissajja anuggahāya ",
  "snp4.9:5.7": "santo anissāya bhavaṃ na jappe\". 840. ",
  "snp4.9:6.1": "\"No ce kira diṭṭhiyā na sutiyā na ñāṇena ",
  "snp4.9:6.2": "iti Māgandiyo ",
  "snp4.9:6.3": "sīlabbatenāpi visuddhim āha | ",
  "snp4.9:6.4": "adiṭṭhiyā assutiyā aññāṇā ",
  "snp4.9:6.5": "asīlatā abbatā no pi tena, ",
  "snp4.9:6.6": "maññe-m-ahaṃ momuham eva dhammaṃ , ",
  "snp4.9:6.7": "diṭṭhiyā eke paccenti suddhiṃ\". 841. ",
  "snp4.9:7.1": "\"Diṭṭhiñ ca nissāya anupucchamāno ",
  "snp4.9:7.2": "Māgandiyā ti Bhagavā ",
  "snp4.9:7.3": "samuggahītesu pamoham āgā ",
  "snp4.9:7.4": "ito ca nāddakkhi aṇum pi saññaṃ, ",
  "snp4.9:7.5": "tasmā tuvaṃ momuhato dahāsi. 842. ",
  "snp4.9:8.1": "Samo visesī uda vā nihīno ",
  "snp4.9:8.2": "yo maññatī, so vivadetha tena, ",
  "snp4.9:8.3": "tīsu vidhāsu avikampamāno -- ",
  "snp4.9:8.4": "‘samo, visesī' ti na tassa hoti. 843. ",
  "snp4.9:9.1": "‘Saccan' ti so brāhmaṇo kiṃ vadeyya, ",
  "snp4.9:9.2": "‘musā' ti vā so vivadetha kena: ",
  "snp4.9:9.3": "yasmiṃ samaṃ visamañ cāpi n' atthi, ",
  "snp4.9:9.4": "sa kena vādaṃ paṭisaṃyujeyya. 844. ",
  "snp4.9:10.1": "Okam pahāya aniketasārī ",
  "snp4.9:10.2": "gāme akubbaṃ muni santhavāni ",
  "snp4.9:10.3": "kāmehi ritto apurekkharāno ",
  "snp4.9:10.4": "kathaṃ na viggayha janena kayirā, 845. ",
  "snp4.9:11.1": "Yehi vivitto vicareyya loke, ",
  "snp4.9:11.2": "na tāni uggayha vadeyya nāgo:| ",
  "snp4.9:11.3": "elambujaṃ kaṇṭakaṃ vārijaṃ yathā ",
  "snp4.9:11.4": "jalena paṃkena c' anūpalittaṃ, ",
  "snp4.9:11.5": "evaṃ munī santivādo agiddho ",
  "snp4.9:11.6": "kāme ca loke ca anūpalitto. 846. ",
  "snp4.9:12.1": "Na vedagū diṭṭhiyā na mutiyā ",
  "snp4.9:12.2": "sa mānam eti, na hi tammayo so, ",
  "snp4.9:12.3": "na kammanā no pi sutena neyyo ",
  "snp4.9:12.4": "anūpanīto so nivesanesu. 847. ",
  "snp4.9:13.1": "Saññāvirattassa na santi ganthā, ",
  "snp4.9:13.2": "paññāvimuttassa na santi mohā: ",
  "snp4.9:13.3": "saññañ ca diṭṭhiñ ca ye aggahesuṃ, ",
  "snp4.9:13.4": "te ghaṭṭayantā vicaranti loke\" ti ",
  "snp4.9:13.5": "MĀGANDIYASUTTAṂ NIṬṬHITAṂ. 848. "
}
