  "snp5.9:0.1": "",
  "snp5.9:0.2": "",
  "snp5.9:1.1": "\"Ye me pubbe viyākaṃsu ",
  "snp5.9:1.2": "icc-āyasmā Hemako| ",
  "snp5.9:1.3": "huraṃ Gotamasāsanā: ",
  "snp5.9:1.4": "‘icc-āsi, iti bhavissati,' ",
  "snp5.9:1.5": "sabban taṃ itihītihaṃ, ",
  "snp5.9:1.6": "sabban taṃ takkavaḍḍhanaṃ, 1085. ",
  "snp5.9:1.7": "nāhaṃ tattha abhiramiṃ. ",
  "snp5.9:2.1": "Tvañ ca me dhammam akkhāhi ",
  "snp5.9:2.2": "taṇhānigghātanaṃ muni, ",
  "snp5.9:2.3": "yaṃ viditvā sato caraṃ ",
  "snp5.9:2.4": "tare loke visattikaṃ\". 1086. ",
  "snp5.9:3.1": "\"Idha diṭṭhasutamutaviññātesu ",
  "snp5.9:3.2": "piyarūpesu Hemaka ",
  "snp5.9:3.3": "chandarāgavinodanaṃ ",
  "snp5.9:3.4": "nibbānapadam accutaṃ. 1087. ",
  "snp5.9:4.1": "Etad aññāya ye satā ",
  "snp5.9:4.2": "diṭṭhadhammābhinibbutā, -- ",
  "snp5.9:4.3": "upasantā ca te sadā, -- ",
  "snp5.9:4.4": "tiṇṇā loke visattikan\" ti ",
  "snp5.9:4.5": "HEMAKAMĀṆAVAPUCCHĀ NIṬṬHITĀ. 1088. "
}
