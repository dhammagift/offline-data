  "snp5.15:0.1": "",
  "snp5.15:0.2": "",
  "snp5.15:1.1": "\"Yo atītaṃ ādisati ",
  "snp5.15:1.2": "icc-āyasmā Posālo ",
  "snp5.15:1.3": "anejo chinnasaṃsayo, ",
  "snp5.15:1.4": "pāraguṃ sabbadhammānaṃ ",
  "snp5.15:1.5": "atthi pañhena āgamaṃ: 1113. ",
  "snp5.15:2.1": "Vibhūtarūpasaññissa ",
  "snp5.15:2.2": "sabbakāyapahāyino ",
  "snp5.15:2.3": "ajjhattañ ca bahiddhā ca ",
  "snp5.15:2.4": "‘n' atthi kiñcī' ti passato ",
  "snp5.15:2.5": "ñāṇaṃ Sakkānupucchāmi, ",
  "snp5.15:2.6": "kathaṃ neyyo tathāvidho\". 1114. ",
  "snp5.15:3.1": "\"Viññāṇaṭṭhitiyo sabbā ",
  "snp5.15:3.2": "Posālā ti Bhagavā ",
  "snp5.15:3.3": "abhijānaṃ Tathāgato ",
  "snp5.15:3.4": "tiṭṭhantam enaṃ jānāti ",
  "snp5.15:3.5": "vimuttaṃ tapparāyanaṃ. 1115. ",
  "snp5.15:4.1": "Ākiñcaññāsambhavaṃ ñatvā ",
  "snp5.15:4.2": "‘nandī saṃyojanaṃ' iti ",
  "snp5.15:4.3": "evam evaṃ abhiññāya ",
  "snp5.15:4.4": "tato tattha vipassati, ",
  "snp5.15:4.5": "etaṃ ñāṇaṃ tathaṃ tassa ",
  "snp5.15:4.6": "brāhmaṇassa vusīmato\" ti ",
  "snp5.15:4.7": "POSĀLAMĀṆAVAPUCCHĀ NIṬṬHITĀ. 1116. "
}
