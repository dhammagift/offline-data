{
  "snp5.18:0.1": "",
  "snp5.18:0.2": "",
  "snp5.18:1.1": "Bhagavā Magadhesu viharanto Pāsāṇake cetiye, ",
  "snp5.18:1.2": "paricārakasoḷasānaṃ brāhmaṇānaṃ ajjhiṭṭho puṭṭho puṭṭho pañhe vyākāsi. ",
  "snp5.18:1.3": "Ekamekassa ce pi pañhassa attham aññāya dhammam aññāya dhammānudhammaṃ paṭipajjeyya, gaccheyy' eva jarāmaraṇassa pāraṃ, ",
  "snp5.18:1.4": "pāraṅgamanīyā ime dhammā ti tasmā imassa dhammapariyāyassa Pārāyanan t' eva adhivacanaṃ. 1124. ",
  "snp5.18:2.1": "Ajito Tissa-Metteyyo ",
  "snp5.18:2.2": "Puṇṇako atha Mettagū ",
  "snp5.18:2.3": "Dhotako Upasīvo ca ",
  "snp5.18:2.4": "Nando ca atha Hemako 1125. ",
  "snp5.18:3.1": "Todeyya-Kappā dubhayo ",
  "snp5.18:3.2": "Jatukaṇṇī ca paṇḍito ",
  "snp5.18:3.3": "Bhadrāvudho Udayo ca ",
  "snp5.18:3.4": "Posālo cāpi brāhmaṇo ",
  "snp5.18:3.5": "Mogharājā ca medhāvī ",
  "snp5.18:3.6": "Piṅgiyo ca mahā isi 1126. ",
  "snp5.18:4.1": "ete Buddhaṃ upāgañchuṃ ",
  "snp5.18:4.2": "sampannacaraṇaṃ isiṃ, ",
  "snp5.18:4.3": "pucchantā nipuṇe pañhe ",
  "snp5.18:4.4": "Buddhaseṭṭhaṃ upāgamuṃ. 1127. ",
  "snp5.18:5.1": "Tesaṃ Buddho vyākāsi ",
  "snp5.18:5.2": "pañhe puṭṭho yathātathaṃ, ",
  "snp5.18:5.3": "pañhānaṃ veyyākaraṇena ",
  "snp5.18:5.4": "tosesi brāhmaṇe muni. 1128. ",
  "snp5.18:6.1": "Te tositā cakkhumatā ",
  "snp5.18:6.2": "Buddhen' Ādiccabandhunā ",
  "snp5.18:6.3": "brahmacariyam acariṃsu ",
  "snp5.18:6.4": "varapaññassa santike. 1129. ",
  "snp5.18:7.1": "Ekamekassa pañhassa ",
  "snp5.18:7.2": "yathā Buddhena desitaṃ, ",
  "snp5.18:7.3": "tathā yo paṭipajjeyya, ",
  "snp5.18:7.4": "gacche pāraṃ apārato, 1130. ",
  "snp5.18:8.1": "apārā pāraṃ gaccheyya ",
  "snp5.18:8.2": "bhāvento maggam uttamaṃ, ",
  "snp5.18:8.3": "maggo so pāraṅgamanāya, ",
  "snp5.18:8.4": "tasmā Pārāyanaṃ iti. 1131. \"Pārāyanam anugāyissaṃ:* icc-āyasmā "
}
