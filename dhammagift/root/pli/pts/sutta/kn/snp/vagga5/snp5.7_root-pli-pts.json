{
  "snp5.7:0.1": "",
  "snp5.7:0.2": "",
  "snp5.7:1.1": "\"Eko ahaṃ Sakka mahantam oghaṃ ",
  "snp5.7:1.2": "icc-āyasmā Upasīvo ",
  "snp5.7:1.3": "anissito no visahāmi tārituṃ, ",
  "snp5.7:1.4": "ārammaṇaṃ brūhi samantacakkhu, ",
  "snp5.7:1.5": "yaṃ nissito ogham imaṃ tareyya\". 1070. ",
  "snp5.7:2.1": "\"Ākiñcaññaṃ pekkhamāno satīmā ",
  "snp5.7:2.2": "Upasīvā ti Bhagavā ",
  "snp5.7:2.3": "‘n' atthī' ti nissāya tarassu oghaṃ,| ",
  "snp5.7:2.4": "kāme pahāya virato kathāhi ",
  "snp5.7:2.5": "taṇhakkhayaṃ nattamahābhipassa\". 1071. ",
  "snp5.7:3.1": "\"Sabbesu kāmesu yo vītarāgo ",
  "snp5.7:3.2": "icc-āyasmā Upasīvo ",
  "snp5.7:3.3": "ākiñcaññaṃ nissito hitva-m-aññaṃ ",
  "snp5.7:3.4": "saññāvimokhe parame vimutto, ",
  "snp5.7:3.5": "tiṭṭhe nu so tattha anānuyāyī\". 1072. ",
  "snp5.7:4.1": "\"Sabbesu kāmesu yo vītarāgo ",
  "snp5.7:4.2": "Upasīvā ti Bhagavā ",
  "snp5.7:4.3": "ākiñcaññaṃ nissito hitva-m-aññaṃ ",
  "snp5.7:4.4": "saññāvimokhe parame vimutto, ",
  "snp5.7:4.5": "tiṭṭheyya so tattha anānuyāyī\". 1073. ",
  "snp5.7:5.1": "\"Tiṭṭhe ce so tattha anānuyāyī ",
  "snp5.7:5.2": "pūgam pi vassānaṃ samantacakkhu, ",
  "snp5.7:5.3": "tatth' eva so sītisiyā vimutto, ",
  "snp5.7:5.4": "bhavetha viññāṇaṃ tathāvidhassa\". 1074. ",
  "snp5.7:6.1": "\"Accī yathā vātavegena khitto ",
  "snp5.7:6.2": "Upasīvā ti Bhagavā ",
  "snp5.7:6.3": "atthaṃ paleti na upeti saṃkhaṃ,| ",
  "snp5.7:6.4": "evaṃ munī nāmakāyā vimutto ",
  "snp5.7:6.5": "atthaṃ paleti na upeti saṃkhaṃ\". 1075. ",
  "snp5.7:7.1": "\"Atthaṇ gato so uda vā so n' atthi ",
  "snp5.7:7.2": "udāhu ve sassatiyā arogo, ",
  "snp5.7:7.3": "tam me munī sādhu viyākarohi, ",
  "snp5.7:7.4": "tathā hi te vidito esa dhammo\". 1076. ",
  "snp5.7:8.1": "\"Atthaṇ gatassa na pamāṇam atthi, ",
  "snp5.7:8.2": "Upasīvā ti Bhagavā ",
  "snp5.7:8.3": "yena naṃ vajju, taṃ tassa n' atthi, ",
  "snp5.7:8.4": "sabbesu dhammesu samūhatesu ",
  "snp5.7:8.5": "samūhatā vādapathā pi sabbe\" ti ",
  "snp5.7:8.6": "UPASĪVAMĀṆAVAPUCCHĀ NIṬṬHITĀ. 8. Nandamāṇavapucchā (7). 1077. "
}
