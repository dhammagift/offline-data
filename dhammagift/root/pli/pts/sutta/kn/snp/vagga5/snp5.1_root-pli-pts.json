{
  "snp5.1:0.1": "",
  "snp5.1:0.2": "",
  "snp5.1:1.1": "Kosalānaṃ purā rammā ",
  "snp5.1:1.2": "agamā Dakkhiṇāpathaṃ ",
  "snp5.1:1.3": "ākiñcaññaṃ patthayāno ",
  "snp5.1:1.4": "brāhmaṇo mantapāragū. 977. ",
  "snp5.1:2.1": "So Assakassa visaye ",
  "snp5.1:2.2": "Aḷakassa samāsane ",
  "snp5.1:2.3": "vasī Godhāvarīkūle ",
  "snp5.1:2.4": "uñchena ca phalena ca. 978. ",
  "snp5.1:3.1": "Tass' eva upanissāya ",
  "snp5.1:3.2": "gāmo ca vipulo ahū, ",
  "snp5.1:3.3": "tato jātena āyena ",
  "snp5.1:3.4": "",
  "snp5.1:4.1": "mahāyaññam akappayi, 979. mabāyaññaṃ yajitvāna ",
  "snp5.1:4.2": "puna pāvisi assamaṃ. ",
  "snp5.1:4.3": "Tasmiṃ patipaviṭṭhamhi ",
  "snp5.1:4.4": "añño āgañchi brāh- maṇo 980. ",
  "snp5.1:5.1": "ugghaṭṭapādo tasito ",
  "snp5.1:5.2": "paṃkadanto rajassiro, ",
  "snp5.1:5.3": "so ca naṃ upasaṃkamma ",
  "snp5.1:5.4": "satāni pañca yācati. 981. ",
  "snp5.1:6.1": "Tam enam Bāvarī disvā ",
  "snp5.1:6.2": "āsanena nimantayi, ",
  "snp5.1:6.3": "sukhañ ca kusalaṃ pucchi, ",
  "snp5.1:6.4": "idaṃ vacanam abravi: 982. ",
  "snp5.1:7.1": "\"Yaṃ kho mamaṃ deyyadhammaṃ ",
  "snp5.1:7.2": "sabbaṃ vissajjitam mayā, ",
  "snp5.1:7.3": "anujānāhi me brahme, ",
  "snp5.1:7.4": "n' atthi pañca satāni me\". 983. ",
  "snp5.1:8.1": "\"Sace me yācamānassa ",
  "snp5.1:8.2": "bhavaṃ nānupadassati, ",
  "snp5.1:8.3": "sattame divase tuyhaṃ ",
  "snp5.1:8.4": "muddhā phalatu sattadhā\". 984. ",
  "snp5.1:9.1": "Abhisaṃkharitvā kuhako ",
  "snp5.1:9.2": "bheravaṃ so akittayi, -- ",
  "snp5.1:9.3": "tassa taṃ vacanaṃ sutvā ",
  "snp5.1:9.4": "Bāvarī dukkhito ahū, 985. ",
  "snp5.1:10.1": "ussussati anāhāro ",
  "snp5.1:10.2": "sokasallasamappito, ",
  "snp5.1:10.3": "atho pi evaṃcittassa ",
  "snp5.1:10.4": "jhāne na ramatī mano. 986. ",
  "snp5.1:11.1": "Utrastaṃ dukkhitaṃ disvā ",
  "snp5.1:11.2": "devatā atthakāminī ",
  "snp5.1:11.3": "Bāvariṃ upasaṃkamma ",
  "snp5.1:11.4": "idaṃ vacanam abravi: 987. ",
  "snp5.1:12.1": "\"Na so muddhaṃ pajānāti, ",
  "snp5.1:12.2": "kuhako so dhanatthiko, ",
  "snp5.1:12.3": "muddhani muddhapāte vā ",
  "snp5.1:12.4": "ñāṇaṃ tassa na vijjati\". 988. ",
  "snp5.1:13.1": "\"Bhotī carahi jānāti, ",
  "snp5.1:13.2": "tam me akkhāhi pucchitā ",
  "snp5.1:13.3": "muddhaṃ muddhādhipātañ ca, ",
  "snp5.1:13.4": "taṃ suṇoma vaco tava\". 989. ",
  "snp5.1:14.1": "\"Aham p' etaṃ na jānāmi, ",
  "snp5.1:14.2": "ñāṇam m' ettha na vijjati, ",
  "snp5.1:14.3": "muddhaṃ muddhādhipāto ca ",
  "snp5.1:14.4": "Jinānaṃ h' eta dassanaṃ\". 990. ",
  "snp5.1:15.1": "\"Atha ko carahi jānāti ",
  "snp5.1:15.2": "asmiṃ puthavimaṇḍale ",
  "snp5.1:15.3": "muddhaṃ muddhādhipātañ ca, ",
  "snp5.1:15.4": "tam me akkhāhi devate\". 991. ",
  "snp5.1:16.1": "\"Purā Kapilavatthumhā ",
  "snp5.1:16.2": "nikkhanto lokanāyako ",
  "snp5.1:16.3": "apacco Okkākarājassa ",
  "snp5.1:16.4": "Sakyaputto pabhaṃkaro. 992. ",
  "snp5.1:17.1": "So hi brāhmaṇa sambuddho ",
  "snp5.1:17.2": "sabbadhammāna pāragū ",
  "snp5.1:17.3": "sabbābhiññābalappatto ",
  "snp5.1:17.4": "sabbadhammesu cakkhumā ",
  "snp5.1:17.5": "sabbadhammakkhayaṃ patto ",
  "snp5.1:17.6": "vimutto upadhisaṃkhaye, 993. ",
  "snp5.1:18.1": "Buddho so Bhagavā loke ",
  "snp5.1:18.2": "dhammaṃ deseti cakkhumā: ",
  "snp5.1:18.3": "taṃ tvaṃ gantvāna pucchassu, ",
  "snp5.1:18.4": "so te taṃ vyākarissati\". 994. ",
  "snp5.1:19.1": "‘Sambuddho' ti vaco sutvā ",
  "snp5.1:19.2": "udaggo Bāvarī ahū, ",
  "snp5.1:19.3": "sok' assa tanuko āsi, ",
  "snp5.1:19.4": "pītiñ ca vipulaṃ labhi. 995. ",
  "snp5.1:20.1": "So Bāvarī attamano udaggo ",
  "snp5.1:20.2": "taṃ devataṃ pucchati vedajāto: ",
  "snp5.1:20.3": "\"katamamhi gāme nigamamhi vā puna ",
  "snp5.1:20.4": "katamamhi vā janapade lakanātho, ",
  "snp5.1:20.5": "yattha gantvā namassemu ",
  "snp5.1:20.6": "Sambuddhaṃ dipaduttamaṃ\". 996. ",
  "snp5.1:21.1": "\"Sāvatthiyaṃ Kosalamandire Jino ",
  "snp5.1:21.2": "pahūtapañño varabhūrimedhaso, ",
  "snp5.1:21.3": "so Sakyaputto vidhuro anāsavo ",
  "snp5.1:21.4": "muddhādhipātassa vidū narāsabho\". 997. ",
  "snp5.1:22.1": "Tato āmantayī sisse ",
  "snp5.1:22.2": "brāhmaṇe mantapārage: ",
  "snp5.1:22.3": "\"etha māṇavā, akkhissaṃ, ",
  "snp5.1:22.4": "suṇotha vacanaṃ mama: 998. ",
  "snp5.1:23.1": "yass' eso dullabho loke ",
  "snp5.1:23.2": "pātubhāvo abhiṇhaso, ",
  "snp5.1:23.3": "sv-ājja lokamhi uppanno ",
  "snp5.1:23.4": "Sambuddho iti vissuto, ",
  "snp5.1:23.5": "khippaṃ gantvāna Sāvatthiṃ ",
  "snp5.1:23.6": "passavho dipaduttamaṃ\". 999. ",
  "snp5.1:24.1": "\"Kathañ carahi jānemu ",
  "snp5.1:24.2": "disvā ‘Buddho' ti brāhmaṇa, ",
  "snp5.1:24.3": "ajānatan no pabrūhi, ",
  "snp5.1:24.4": "yathā jānemu taṃ mayaṃ\". 1000. ",
  "snp5.1:25.1": "\"Āgatāni hi mantesu ",
  "snp5.1:25.2": "mahāpurisalakkhaṇā ",
  "snp5.1:25.3": "dvattiṃsā ca vyākhyātā ",
  "snp5.1:25.4": "samattā anupubbaso. 1001. ",
  "snp5.1:26.1": "Yass' ete honti gattesu ",
  "snp5.1:26.2": "mahāpurisalakkhaṇā, ",
  "snp5.1:26.3": "dve va tassa gatiyo, ",
  "snp5.1:26.4": "tatiyā hi na vijjati. 1002. ",
  "snp5.1:27.1": "Sace agāraṃ ajjhāvasati, ",
  "snp5.1:27.2": "vijeyya paṭhaviṃ imaṃ ",
  "snp5.1:27.3": "adaṇḍena asatthena ",
  "snp5.1:27.4": "dhammena-m-anusāsati. 1003. ",
  "snp5.1:28.1": "Sace ca so pabbajati ",
  "snp5.1:28.2": "agārā anagāriyaṃ, ",
  "snp5.1:28.3": "vivattacchaddo sambuddho ",
  "snp5.1:28.4": "arahā bhavati anut- taro. 1004. ",
  "snp5.1:29.1": "Jātiṃ gottañ ca lakkhaṇaṃ ",
  "snp5.1:29.2": "mante sisse punāpare ",
  "snp5.1:29.3": "muddhaṃ muddhādhipātañ ca ",
  "snp5.1:29.4": "manasā yeva puc- chatha. 1005. ",
  "snp5.1:30.1": "Anāvaraṇadassāvī ",
  "snp5.1:30.2": "yadi buddho bhavissati, ",
  "snp5.1:30.3": "manasā pucchite pañhe ",
  "snp5.1:30.4": "vācāya vissajessati\". 1006. ",
  "snp5.1:31.1": "Bāvarissa vaco sutvā ",
  "snp5.1:31.2": "sissā soḷasa brāhmaṇā ",
  "snp5.1:31.3": "Ajito Tissa-Metteyyo ",
  "snp5.1:31.4": "Puṇṇako atha Mettagū 1007. ",
  "snp5.1:32.1": "Dhotako Upasīvo ca ",
  "snp5.1:32.2": "Nando ca atha Hemako ",
  "snp5.1:32.3": "Todeyya-Kappā dubhayo ",
  "snp5.1:32.4": "Jatukaṇṇī ca paṇḍito 1008. ",
  "snp5.1:33.1": "Bhadrāvudho Udayo ca ",
  "snp5.1:33.2": "Posālo cāpi brāhmaṇo ",
  "snp5.1:33.3": "Mogharājā ca medhāvī ",
  "snp5.1:33.4": "Piṅgiyo ca mahā isi, 1009. ",
  "snp5.1:34.1": "paccekagaṇino sabbe ",
  "snp5.1:34.2": "sabbalokassa vissutā ",
  "snp5.1:34.3": "jhāyī jhānaratā dhīrā ",
  "snp5.1:34.4": "pubbavāsanavāsitā, 1010. ",
  "snp5.1:35.1": "Bāvariṃ abhivādetvā ",
  "snp5.1:35.2": "katvā ca naṃ padakkhiṇaṃ ",
  "snp5.1:35.3": "jaṭājinadharā sabbe ",
  "snp5.1:35.4": "pakkāmuṃ uttarāmukhā: 1011. ",
  "snp5.1:36.1": "Aḷakassa Patiṭṭhānaṃ ",
  "snp5.1:36.2": "purimaṃ Māhissatiṃ tadā ",
  "snp5.1:36.3": "Ujjeniñ cāpi Gonaddhaṃ ",
  "snp5.1:36.4": "Vedisaṃ Vanasavhayaṃ 1012. ",
  "snp5.1:37.1": "Kosambiṃ cāpi Sāketaṃ ",
  "snp5.1:37.2": "Sāvatthiñ ca puruttamaṃ ",
  "snp5.1:37.3": "Setavyaṃ Kapilavatthuṃ ",
  "snp5.1:37.4": "Kusinārañ ca mandiraṃ 1013. ",
  "snp5.1:38.1": "Pāvañ ca Bhoganagaraṃ ",
  "snp5.1:38.2": "Vesāliṃ Māgadhaṃ puraṃ ",
  "snp5.1:38.3": "Pāsāṇakañ cetiyañ ca ",
  "snp5.1:38.4": "ramaṇīyaṃ manoramaṃ. 1014. ",
  "snp5.1:39.1": "Tasito v' udakaṃ sītaṃ ",
  "snp5.1:39.2": "mahālābhaṃ va vāṇijo ",
  "snp5.1:39.3": "chāyaṃ ghammābhitatto va ",
  "snp5.1:39.4": "turitā pabbatam āruhaṃ. 1015. ",
  "snp5.1:40.1": "Bhagavā ca tamhi samaye ",
  "snp5.1:40.2": "bhikkhusaṃghapurakkhato ",
  "snp5.1:40.3": "bhikkhūnaṃ dhammaṃ deseti, ",
  "snp5.1:40.4": "sīho va nadatī vane. 1016. ",
  "snp5.1:41.1": "Ajito addasa Sambuddhaṃ vītaraṃsi ",
  "snp5.1:41.2": "va bhāṇumaṃ ",
  "snp5.1:41.3": "candaṃ yathā pannarase ",
  "snp5.1:41.4": "pāripūriṃ upāgataṃ. 1017. ",
  "snp5.1:42.1": "Ath' assa gatte disvāna ",
  "snp5.1:42.2": "paripūrañ ca ",
  "snp5.1:42.3": "",
  "snp5.1:42.4": "vyañjanaṃ 1018. ",
  "snp5.1:43.1": "\"Ādissa jammanaṃ brūhi, ",
  "snp5.1:43.2": "gottaṃ brūhi salakkhaṇaṃ, ",
  "snp5.1:43.3": "mantesu pāramiṃ brūhi, ",
  "snp5.1:43.4": "kati vāceti brāhmaṇo\". 1019. ",
  "snp5.1:44.1": "\"Vīsaṃvassasataṃ āyu, ",
  "snp5.1:44.2": "so ca gottena Bāvari, ",
  "snp5.1:44.3": "tīṇ' assa lakkhaṇā gatte, ",
  "snp5.1:44.4": "tiṇṇaṃ vedāna pāragū, 1020. ",
  "snp5.1:45.1": "lakkhaṇe itihāse ca ",
  "snp5.1:45.2": "sanighaṇḍusakeṭubhe, ",
  "snp5.1:45.3": "pañca satāni vāceti, ",
  "snp5.1:45.4": "sadhamme pāramiṃ gato\". 1021. ",
  "snp5.1:46.1": "\"Lakkhaṇānaṃ pavicayaṃ ",
  "snp5.1:46.2": "Bāvarissa naruttama ",
  "snp5.1:46.3": "taṇhacchida pakāsehi, ",
  "snp5.1:46.4": "mā no kaṃkhāyitaṃ ahū\". 1022. ",
  "snp5.1:47.1": "\"Mukhaṃ jivhāya chādeti, ",
  "snp5.1:47.2": "uṇṇ' assa bhamukantare, ",
  "snp5.1:47.3": "kosohitaṃ vatthaguyhaṃ, ",
  "snp5.1:47.4": "evaṃ jānāhi māṇava\". 1023. ",
  "snp5.1:48.1": "Pucchaṃ hi kiñci asuṇanto ",
  "snp5.1:48.2": "sutvā pañhe viyākate ",
  "snp5.1:48.3": "vicinteti jano sabbo ",
  "snp5.1:48.4": "vedajāto katañjali: 1024. ",
  "snp5.1:49.1": "‘Ko nu devo va Brahmā vā ",
  "snp5.1:49.2": "Indo vā pi Sujampati ",
  "snp5.1:49.3": "manasā pucchi te pañhe, ",
  "snp5.1:49.4": "kam etaṃ paṭibhāsati.' 1025. ",
  "snp5.1:50.1": "\"Muddhaṃ muddhādhipātañ ca ",
  "snp5.1:50.2": "Bāvarī paripucchati, ",
  "snp5.1:50.3": "taṃ vyākarohi Bhagavā, ",
  "snp5.1:50.4": "kaṃkhaṃ vinaya no ise\". 1026. ",
  "snp5.1:51.1": "\"Avijjā muddhā ti jānāhi, ",
  "snp5.1:51.2": "vijjā muddhādhipātinī ",
  "snp5.1:51.3": "saddhāsatisamādhīhi ",
  "snp5.1:51.4": "chandaviriyena saṃyutā\". 1027. ",
  "snp5.1:52.1": "Tato vedena mahatā ",
  "snp5.1:52.2": "santhambhitvāna māṇavo ",
  "snp5.1:52.3": "ekaṃsaṃ ajinaṃ katvā ",
  "snp5.1:52.4": "pādesu sirasā pati: 1028. ",
  "snp5.1:53.1": "\"Bāvarī brāhmaṇo bhoto ",
  "snp5.1:53.2": "saha sissehi mārisa ",
  "snp5.1:53.3": "udaggacitto sumano ",
  "snp5.1:53.4": "pāde vandati cakkhuma\". 1029. ",
  "snp5.1:54.1": "\"Sukhito Bāvarī hotu ",
  "snp5.1:54.2": "saha sissehi brāhmaṇo, ",
  "snp5.1:54.3": "tvañ cāpi sukhito hohi, ",
  "snp5.1:54.4": "ciraṃ jīvāhi māṇava. 1030. ",
  "snp5.1:55.1": "Bāvarissa ca tuyhaṃ vā ",
  "snp5.1:55.2": "sabbesaṃ sabbasaṃsayaṃ ",
  "snp5.1:55.3": "katāvakāsā pucchavho, ",
  "snp5.1:55.4": "yaṃ kiñci manas' icchatha\". 1031. ",
  "snp5.1:56.1": "Sambuddhena katokāso ",
  "snp5.1:56.2": "nisīditvāna pañjali ",
  "snp5.1:56.3": "Ajito paṭhamaṃ pañhaṃ ",
  "snp5.1:56.4": "tattha pucchi Tathāgataṃ. ",
  "snp5.1:56.5": "VATTHUGĀTHĀ NIṬṬHITĀ. 2. Ajitamāṇavapucchā (1). 1032. \"Kena-ssu "
}
