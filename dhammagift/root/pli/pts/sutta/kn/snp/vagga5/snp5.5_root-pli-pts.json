{
  "snp5.5:0.1": "",
  "snp5.5:0.2": "",
  "snp5.5:1.1": "",
  "snp5.5:1.2": "Mettagū ",
  "snp5.5:1.3": "maññāmi taṃ vedaguṃ bhāvitattaṃ: ",
  "snp5.5:1.4": "kuto nu dukkhā samudāgatā ime, ",
  "snp5.5:1.5": "ye keci lokasmiṃ anekarūpā\". ",
  "snp5.5:2.1": "",
  "snp5.5:2.2": "Mettagū ti Bhagavā ",
  "snp5.5:2.3": "taṃ te pavakkhāmi yathā pajānaṃ: ",
  "snp5.5:2.4": "upadhīnidānā pabhavanti dukkhā, ",
  "snp5.5:2.5": "ye keci lokasmiṃ anekarūpā. 1051. ",
  "snp5.5:3.1": "Yo ve avidvā upadhiṃ karoti, ",
  "snp5.5:3.2": "punappunaṃ dukkham upeti mando, ",
  "snp5.5:3.3": "tasmā hi jānaṃ upadhiṃ na kayirā ",
  "snp5.5:3.4": "dukkhassa jātippabhavānupassī\". 1052. ",
  "snp5.5:4.1": "\"Yan taṃ apucchimha akittayī no, ",
  "snp5.5:4.2": "aññaṃ taṃ pucchāmi, tad iṃgha brūhi: ",
  "snp5.5:4.3": "kathan nu dhīrā vitaranti oghaṃ ",
  "snp5.5:4.4": "jātijaraṃ sokapariddavañ ca, ",
  "snp5.5:4.5": "tam me munī sādhu viyākarohi, ",
  "snp5.5:4.6": "tathā hi te vidito esa dhammo\". 1053. ",
  "snp5.5:5.1": "\"Kittayissāmi te dhammaṃ, ",
  "snp5.5:5.2": "Mettagū ti Bhagavā ",
  "snp5.5:5.3": "diṭṭhe dhamme anītihaṃ ",
  "snp5.5:5.4": "yaṃ viditvā sato caraṃ ",
  "snp5.5:5.5": "tare loke visattikaṃ\". 1054. ",
  "snp5.5:6.1": "\"Tañ cāhaṃ abhinandāmi ",
  "snp5.5:6.2": "mahesi dhammam uttamaṃ, ",
  "snp5.5:6.3": "yaṃ viditvā sato caraṃ ",
  "snp5.5:6.4": "tare loke visattikaṃ\". 1055. ",
  "snp5.5:7.1": "\"Yaṃ kiñci sampajānāsi ",
  "snp5.5:7.2": "Mettagū ti Bhagavā ",
  "snp5.5:7.3": "uddhaṃ adho tiriyaṃ cāpi majjhe,| ",
  "snp5.5:7.4": "etesu nandiñ ca nivesanañ ca ",
  "snp5.5:7.5": "panujja viññāṇaṃ bhave na tiṭṭhe. 1056. ",
  "snp5.5:8.1": "Evaṃvihārī sato appamatto ",
  "snp5.5:8.2": "bhikkhu caraṃ hitvā mamāyitāni ",
  "snp5.5:8.3": "jātijaraṃ sokapariddavañ ca ",
  "snp5.5:8.4": "idh' eva vidvā pajaheyya dukkhaṃ\". 1057. ",
  "snp5.5:9.1": "\"Etābhinandāmi vaco mahesino ",
  "snp5.5:9.2": "sukittitaṃ Gotam' anūpadhīkaṃ, ",
  "snp5.5:9.3": "addhā hi Bhagavā pahāsi dukkhaṃ, ",
  "snp5.5:9.4": "tathā hi te vidito esa dhammo. 1058. ",
  "snp5.5:10.1": "Te cāpi nūna pajaheyyu dukkhaṃ, ",
  "snp5.5:10.2": "ye tvaṃ muni aṭṭhitaṃ ovadeyya, ",
  "snp5.5:10.3": "taṃ taṃ namassāmi samecca nāga, ",
  "snp5.5:10.4": "app-eva maṃ Bhagavā aṭṭhitaṃ ova- deyya\". 1059. ",
  "snp5.5:11.1": "\"Yaṃ brāhmaṇaṃ vedaguṃ ābhijaññā ",
  "snp5.5:11.2": "akiñcanaṃ kāmabhave asattaṃ, ",
  "snp5.5:11.3": "addhā hi so ogham imaṃ atāri, ",
  "snp5.5:11.4": "tiṇṇo ca pāraṃ akhilo akaṃkho, 1060. ",
  "snp5.5:12.1": "vidvā ca so vedagu naro idha, ",
  "snp5.5:12.2": "bhavābhave saṅgam imaṃ visajja| ",
  "snp5.5:12.3": "so vītataṇho anigho nirāso, ",
  "snp5.5:12.4": "atāri so jātijaran ti brūmī\" ti ",
  "snp5.5:12.5": "METTAGŪMĀṆAVAPUCCHĀ NIṬṬHITĀ. 1061. "
}
