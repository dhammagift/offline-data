  "snp5.11:0.2": "",
  "snp5.11:1.1": "\"Majjhe sarasmiṃ tiṭṭhataṃ ",
  "snp5.11:1.2": "icc-āyasmā Kappo ",
  "snp5.11:1.3": "oghe jāte mahabbhaye ",
  "snp5.11:1.4": "jarāmaccuparetānaṃ ",
  "snp5.11:1.5": "dīpaṃ pabrūhi mārisa, ",
  "snp5.11:1.6": "tvañ ca me dīpam akkhāhi, ",
  "snp5.11:1.7": "yatha-y-idaṃ nāparaṃ siyā\". 1093. ",
  "snp5.11:2.1": "\"Majjhe sarasmiṃ tiṭṭhataṃ ",
  "snp5.11:2.2": "kappā ti Bhagavā ",
  "snp5.11:2.3": "oghe jāte mahabbhaye ",
  "snp5.11:2.4": "jarāmaccuparetānaṃ ",
  "snp5.11:2.5": "dīpaṃ pabrūmi Kappa te 1094. ",
  "snp5.11:3.1": "akiñcanaṃ anādānaṃ ",
  "snp5.11:3.2": "etaṃ dīpaṃ anāparaṃ, ",
  "snp5.11:3.3": "nibbānaṃ iti naṃ brūmi, ",
  "snp5.11:3.4": "jarāmaccuparikkhayaṃ. 1095. ",
  "snp5.11:4.1": "Etad aññāya ye satā ",
  "snp5.11:4.2": "diṭṭhadhammābhinibbutā, ",
  "snp5.11:4.3": "na te Māra-vasānugā, ",
  "snp5.11:4.4": "na te Mārassa paddhagū\" ti ",
  "snp5.11:4.5": "KAPPAMĀṆAVAPUCCHĀ NIṬṬHITĀ. 12. Jatukaṇṇimāṇavapucchā (11). 1096. \"Sutvān' ahaṃ vīram akāmakāmiṃ icc-āyasmā Jakukaṇṇī "
}
