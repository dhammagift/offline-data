  "snp5.13:0.1": "",
  "snp5.13:0.2": "",
  "snp5.13:1.1": "taṇhacchidaṃ anejaṃ ",
  "snp5.13:1.2": "icc-āyasmā Bhadrāvudho ",
  "snp5.13:1.3": "nandiṃjahaṃ oghatiṇṇaṃ vimuttaṃ ",
  "snp5.13:1.4": "kappaṃjahaṃ abhiyāce sumedhaṃ: ",
  "snp5.13:1.5": "sutvāna nāgassa apanamissanti ito 1102. ",
  "snp5.13:2.1": "nānā janā janapadehi saṅgatā ",
  "snp5.13:2.2": "tava vīra vākyaṃ abhikaṃkhamānā, ",
  "snp5.13:2.3": "tesaṃ tuvaṃ sādhu viyākarohi, ",
  "snp5.13:2.4": "tathā hi te vidito esa dhammo\". 1103. ",
  "snp5.13:3.1": "\"Ādānataṇhaṃ vinayetha sabbaṃ ",
  "snp5.13:3.2": "Bhadrāvudhā ti Bhagavā ",
  "snp5.13:3.3": "uddhaṃ adho tiriyañ cāpi majjhe,| ",
  "snp5.13:3.4": "yaṃ yaṃ hi lokasmiṃ upādiyanti, ",
  "snp5.13:3.5": "ten' eva Māro anveti jantuṃ. 1104. ",
  "snp5.13:4.1": "Tasmā pajānaṃ na upādiyetha ",
  "snp5.13:4.2": "bhikkhu sato kiñcanaṃ sabbaloke ",
  "snp5.13:4.3": "‘ādānasatte' iti pekkhamāno ",
  "snp5.13:4.4": "pajaṃ imaṃ maccudheyye visattan\" ti ",
  "snp5.13:4.5": "BHADRĀVUDHAMĀṆAVAPUCCHĀ NIṬṬHITĀ. 1105. "
}
