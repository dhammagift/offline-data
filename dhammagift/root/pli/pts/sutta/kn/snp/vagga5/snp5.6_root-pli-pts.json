{
  "snp5.6:0.1": "",
  "snp5.6:0.2": "",
  "snp5.6:1.1": "\"Pucchāmi taṃ Bhagavā, brūhi me taṃ, ",
  "snp5.6:1.2": "icc-āyasmā Dhotako ",
  "snp5.6:1.3": "vācābhikaṃkhāmi mahesi tuyhaṃ: ",
  "snp5.6:1.4": "tava sutvāna nigghosaṃ ",
  "snp5.6:1.5": "sikkhe nibbānam attano\". 1062. ",
  "snp5.6:2.1": "\"Tena h' ātappaṃ karohi, ",
  "snp5.6:2.2": "Dhotakā ti Bhagavā ",
  "snp5.6:2.3": "idh' eva nipako sato ",
  "snp5.6:2.4": "ito sutvāna nigghosaṃ ",
  "snp5.6:2.5": "sikkhe nibbānam attano\". 1063. ",
  "snp5.6:3.1": "\"Passām' ahaṃ devamanussaloke ",
  "snp5.6:3.2": "akiñcanaṃ brāhmaṇaṃ iriyamānaṃ, ",
  "snp5.6:3.3": "taṃ taṃ namassāmi samantacakkhu: ",
  "snp5.6:3.4": "pamuñca maṃ Sakka kathaṃkathāhi\". 1064. ",
  "snp5.6:4.1": "\"Nāhaṃ gamissāmi pamocamāya ",
  "snp5.6:4.2": "kathaṃkathiṃ Dhotaka kañci loke, ",
  "snp5.6:4.3": "dhammañ ca seṭṭhaṃ ājānamāno ",
  "snp5.6:4.4": "evaṃ tuvaṃ ogham imaṃ taresi\". 1065. ",
  "snp5.6:5.1": "\"Anusāsa brahme karuṇāyamāno ",
  "snp5.6:5.2": "vivekadhammaṃ, yam ahaṃ vijaññaṃ,| ",
  "snp5.6:5.3": "yathāhaṃ ākāso va avyāpajjamāno ",
  "snp5.6:5.4": "idh' eva santo asito careyyaṃ\". 1066. ",
  "snp5.6:6.1": "\"Kittayissāmi te santiṃ, ",
  "snp5.6:6.2": "Dhotakā ti bhagavā ",
  "snp5.6:6.3": "diṭṭhe dhamme anītihaṃ ",
  "snp5.6:6.4": "yaṃ viditvā sato caraṃ ",
  "snp5.6:6.5": "tare loke visattikaṃ\". 1067. ",
  "snp5.6:7.1": "\"Tañ cāhaṃ abhinandāmi ",
  "snp5.6:7.2": "mahesi santim uttamaṃ, ",
  "snp5.6:7.3": "yaṃ viditvā sato caraṃ ",
  "snp5.6:7.4": "tare loke visttikaṃ\". 1068. ",
  "snp5.6:8.1": "\"Yaṃ kiñci sampajānāsi ",
  "snp5.6:8.2": "Dhotakā ti Bhagavā ",
  "snp5.6:8.3": "uddhaṃ adho tiriyaṃ cāpi majjhe, ",
  "snp5.6:8.4": "etaṃ viditvā ‘saṅgo' ti loke ",
  "snp5.6:8.5": "bhavābhavāya mā kāsi taṇhan\" ti ",
  "snp5.6:8.6": "DHOTAKAMĀṆAVAPUCCHĀ NIṬṬHITĀ. 7. Upasīvamāṇarapacchā (6). 1069. "
}
