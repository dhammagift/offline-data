  "snp5.16:1.1": "\"Dvāhaṃ Sakkaṃ apucchissaṃ, ",
  "snp5.16:1.2": "icc-āyasmā Mogharājā ",
  "snp5.16:1.3": "na me vyākāsi cakkhumā, ",
  "snp5.16:1.4": "‘yāvatatiyañ ca devisi ",
  "snp5.16:1.5": "vyākarotī' ti me sutam: 1117. ",
  "snp5.16:2.1": "‘Ayaṃ loko, paro loko, ",
  "snp5.16:2.2": "Brahmaloko sadevako.' ",
  "snp5.16:2.3": "diṭṭhin te nābhijānāmi ",
  "snp5.16:2.4": "Gotamassa yasassino. 1118. ",
  "snp5.16:3.1": "Evaṃ abhikkantadassāviṃ ",
  "snp5.16:3.2": "atthi pañhena āgamaṃ: ",
  "snp5.16:3.3": "kathaṃ lokaṃ avekkhantaṃ ",
  "snp5.16:3.4": "maccurājā na passati\". 1119. ",
  "snp5.16:4.1": "\"Suññato lokaṃ avekkhassu ",
  "snp5.16:4.2": "Mogharāja sadā sato ",
  "snp5.16:4.3": "attānuciṭṭhiṃ ūhacca, ",
  "snp5.16:4.4": "evaṃ maccutaro siyā: ",
  "snp5.16:4.5": "evaṃ lokaṃ avekkhantaṃ ",
  "snp5.16:4.6": "maccurājā na passatī\" ti MOGHARĀJAMĀṆAVAPUCCHĀ NIṬṬHITĀ. 1120. \"Jiṇṇo 'ham asmi ",
  "snp5.16:4.7": ""
}
