{
  "snp5.8:0.1": "",
  "snp5.8:0.2": "",
  "snp5.8:1.1": "\"‘Santi loke munayo' ",
  "snp5.8:1.2": "icc-āyasmā Nando ",
  "snp5.8:1.3": "janā vadanti, ta-y-idaṃ kathaṃ su: ",
  "snp5.8:1.4": "ñāṇūpapannaṃ no muniṃ vadanti ",
  "snp5.8:1.5": "udāhu ve jīvitenūpapannaṃ\". 1078. ",
  "snp5.8:2.1": "\"Na diṭṭhiyā na sutiyā na ñāṇena ",
  "snp5.8:2.2": "munīdha Nanda kusalā vadanti,| ",
  "snp5.8:2.3": "visenikatvā anighā nirāsā ",
  "snp5.8:2.4": "caranti ye, te munayo ti brūmi\". 1079. ",
  "snp5.8:3.1": "\"Ye kec' ime samaṇabrāhmaṇāse ",
  "snp5.8:3.2": "icc-āyasmā Nando ",
  "snp5.8:3.3": "diṭṭhe sutenāpi vadanti suddhiṃ, ",
  "snp5.8:3.4": "sīlabbatenāpi vadanti suddhiṃ. ",
  "snp5.8:3.5": "anekarūpena vadanti suddhiṃ, ",
  "snp5.8:3.6": "kacciṃ su te Bhagavā tattha yathā carantā ",
  "snp5.8:3.7": "atāru jātiñ ca jarañ ca mārisa, 1080. ",
  "snp5.8:3.8": "",
  "snp5.8:4.1": "\"Ye kec' ime samaṇabrāhmaṇāse ",
  "snp5.8:4.2": "Nandā ti Bhagavā ",
  "snp5.8:4.3": "diṭṭhe sutenāpi vadanti suddhiṃ, ",
  "snp5.8:4.4": "sīlabbatenāpi vadanti suddhiṃ, ",
  "snp5.8:4.5": "anekarūpena vadanti suddhiṃ, ",
  "snp5.8:4.6": "kiñcāpi te tattha yathā caranti, ",
  "snp5.8:4.7": "nātariṃsu jātijaran ti brūmi\". 1081. ",
  "snp5.8:5.1": "\"Ye kec' ime samaṇabrāhmaṇāse ",
  "snp5.8:5.2": "icc-āyasmā Nando ",
  "snp5.8:5.3": "diṭṭhe sutenāpi vadanti suddhiṃ, ",
  "snp5.8:5.4": "sīlabbatenāpi vadanti suddhiṃ, ",
  "snp5.8:5.5": "anekarūpena vadanti suddhiṃ, ",
  "snp5.8:5.6": "sace muni brūsi anoghatiṇṇe,| ",
  "snp5.8:5.7": "atha ko carahi devamanussaloke ",
  "snp5.8:5.8": "atāri jātiñ ca jarañ ca mārisa, 1082. ",
  "snp5.8:5.9": "",
  "snp5.8:6.1": "\"Nāhaṃ ‘sabbe samaṇabrāhmaṇāse ",
  "snp5.8:6.2": "Nandā ti Bhagavā ",
  "snp5.8:6.3": "jātijarāya nivutā' ti brūmi: ",
  "snp5.8:6.4": "ye s' īdha diṭṭhaṃ va sutaṃ mutaṃ vā ",
  "snp5.8:6.5": "sīlabbataṃ vā pi pahāya sabbaṃ ",
  "snp5.8:6.6": "anekarūpam pi pahāya sabbaṃ ",
  "snp5.8:6.7": "taṇhaṃ pariññāya anāsavāse, ",
  "snp5.8:6.8": "te ve ‘narā oghatiṇṇā' ti brūmi\". 1083. ",
  "snp5.8:7.1": "\"Etābhinandāmi vaco mahesino ",
  "snp5.8:7.2": "sukittitaṃ Gotam' anūpadhīkaṃ: ",
  "snp5.8:7.3": "ye s' īdha diṭṭhaṃ va sutaṃ mutaṃ vā ",
  "snp5.8:7.4": "sīlabbataṃ vā pi pahāya sabbaṃ ",
  "snp5.8:7.5": "anekarūpam pi pahāya sabbaṃ ",
  "snp5.8:7.6": "taṇhaṃ pariññāya anāsavāse, ",
  "snp5.8:7.7": "ahaṃ pi te ‘oghatiṇṇā' ti brūmī\" ti ",
  "snp5.8:7.8": "NANDAMĀṆAVAPUCCHĀ NIṬṬHITĀ. 1084. "
}
