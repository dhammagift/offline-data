{
  "snp5.4:0.1": "",
  "snp5.4:0.2": "",
  "snp5.4:1.1": "\"Anejaṃ mūladassāviṃ ",
  "snp5.4:1.2": "icc-āyasamā Puṇṇako ",
  "snp5.4:1.3": "atthi pañhena āgamaṃ:| ",
  "snp5.4:1.4": "kiṃnissitā isayo manujā ",
  "snp5.4:1.5": "khattiyā brāhmaṇā devatānaṃ ",
  "snp5.4:1.6": "yaññam akappayiṃsu puthū idha loke, 1044. ",
  "snp5.4:1.7": "",
  "snp5.4:2.1": "\"Ye kec' ime isayo manujā -- ",
  "snp5.4:2.2": "Puṇṇakā ti Bhagavā -- ",
  "snp5.4:2.3": "khattiyā brāhmaṇā devatānaṃ ",
  "snp5.4:2.4": "yaññam akappayiṃsu puthū idha loke, ",
  "snp5.4:2.5": "āsiṃsamānā Puṇṇaka itthabhāvaṃ ",
  "snp5.4:2.6": "jaraṃ sitā yaññam akappayiṃsu\". 1045. ",
  "snp5.4:3.1": "*\"Ye kec' ime isayo manujā -- ",
  "snp5.4:3.2": "icc-āyasmā Puṇṇako -- ",
  "snp5.4:3.3": "khattiyā brāhmaṇā devatānaṃ ",
  "snp5.4:3.4": "yaññam akappayiṃsu puthu idha loke,* ",
  "snp5.4:3.5": "kacciṃ su te Bhagavā yaññapathe appamattā ",
  "snp5.4:3.6": "atāru jātiñ ca jarañ ca mārisa, 1046. ",
  "snp5.4:3.7": "\"Āsiṃsanti ",
  "snp5.4:4.1": "thomayanti abhijappanti juhanti -- ",
  "snp5.4:4.2": "Puṇṇakā ti Bhagavā -- ",
  "snp5.4:4.3": "kāmābhijappanti paṭicca lābhaṃ, ",
  "snp5.4:4.4": "te yājayogā bhavarāgarattā ",
  "snp5.4:4.5": "nātariṃsu jātijaran ti brūmi\". 1047. ",
  "snp5.4:5.1": "\"Te ce nātariṃsu yājayogā -- ",
  "snp5.4:5.2": "icc-āyasmā Puṇṇako -- ",
  "snp5.4:5.3": "yaññehi jātiñ ca jarañ ca mārisa, ",
  "snp5.4:5.4": "atha ko carahi devamanussaloke ",
  "snp5.4:5.5": "atāri jātiñ ca jarañ ca mārisa, 1048. ",
  "snp5.4:5.6": "\"Saṃkhāya lokasmiṃ parovarāni Puṇṇakā ti Bhagavā ",
  "snp5.4:6.1": "",
  "snp5.4:6.2": "",
  "snp5.4:6.3": "yass' iñjitaṃ n' atthi kuhiñci loke, ",
  "snp5.4:6.4": "santo vidhūmo anigho nirāso ",
  "snp5.4:6.5": "atāri so jātijaran ti brūmī\" ti ",
  "snp5.4:6.6": "PUṆṆAKAMĀṆAVAPUCCHĀ NIṬṬHITĀ. icc-āyasmā "
}
