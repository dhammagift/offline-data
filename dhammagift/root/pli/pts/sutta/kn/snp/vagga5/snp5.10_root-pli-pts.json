{
  "snp5.10:0.1": "",
  "snp5.10:0.2": "",
  "snp5.10:1.1": "\"Yasmiṃ kāmā na vasanti, ",
  "snp5.10:1.2": "icc-āyasmā Todeyyo ",
  "snp5.10:1.3": "taṇhā yassa na vijjati, ",
  "snp5.10:1.4": "kathaṃkathā ca yo tiṇṇo, ",
  "snp5.10:1.5": "vinokho tassa kīdiso\". 1089. ",
  "snp5.10:2.1": "\"Yasmiṃ kāmā na vasanti, ",
  "snp5.10:2.2": "Todeyyā ti Bhagavā ",
  "snp5.10:2.3": "taṇhā yassa na vijjati, ",
  "snp5.10:2.4": "kathaṃkathā ca yo tiṇṇo, ",
  "snp5.10:2.5": "vimokho tassa naparo\". 1090. ",
  "snp5.10:3.1": "\"Nirāsayo so uda āsasāno, ",
  "snp5.10:3.2": "paññāṇavā so uda paññakappī: ",
  "snp5.10:3.3": "muniṃ ahaṃ Sakka yathā vijaññaṃ, ",
  "snp5.10:3.4": "tam me viyācikkha samantacakkhu\". 1091. ",
  "snp5.10:4.1": "\"Nirāsayo so na so āsasāno, ",
  "snp5.10:4.2": "paññāṇavā so na ca paññakappī: ",
  "snp5.10:4.3": "evam pi Todeyya muniṃ vijāna ",
  "snp5.10:4.4": "akiñcanaṃ kāmabhave asattan\" ti ",
  "snp5.10:4.5": "TODEYYAMĀṆAVAPUCCHĀ NIṬṬHITĀ. 1092. "
}
