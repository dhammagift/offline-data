  "snp5.2:1.1": "nivuto loko, ",
  "snp5.2:1.2": "icc-āyasmā Ajito ",
  "snp5.2:1.3": "kena-ssu na-ppakāsati, ",
  "snp5.2:1.4": "ki 'ssābhilepanaṃ brūsi, ",
  "snp5.2:1.5": "kiṃ su tassa mahabbhayaṃ\". 1033. ",
  "snp5.2:2.1": "\"Avijjāya nivuto loko, ",
  "snp5.2:2.2": "Ajitā ti Bhagavā ",
  "snp5.2:2.3": "vevicchā pamādā na-ppakāsati, ",
  "snp5.2:2.4": "jappābhilepanaṃ brūmi, ",
  "snp5.2:2.5": "dukkham assa mahabbhayaṃ\". 1034. ",
  "snp5.2:3.1": "\"Savanti sabbadhī sotā, ",
  "snp5.2:3.2": "icc-āyasmā Ajito ",
  "snp5.2:3.3": "*sotānaṃ kiṃ nivāraṇaṃ,* ",
  "snp5.2:3.4": "sotānaṃ saṃvaraṃ brūhi, ",
  "snp5.2:3.5": "kena sotā pithiyyare\". 1035. ",
  "snp5.2:4.1": "\"Yāni sotāni lokasmiṃ, ",
  "snp5.2:4.2": "Ajitā ti Bhagavā ",
  "snp5.2:4.3": "sati tesaṃ nivāraṇaṃ, ",
  "snp5.2:4.4": "sotānaṃ saṃvaraṃ brūmi, ",
  "snp5.2:4.5": "paññāy' ete pithiyyare\". 1036. ",
  "snp5.2:5.1": "\"Paññā c' eva satī ca ",
  "snp5.2:5.2": "icc-āyasmā Ajito ",
  "snp5.2:5.3": "nāmarūpañ ca mārisa, ",
  "snp5.2:5.4": "etaṃ me puṭṭho pabrūhi, ",
  "snp5.2:5.5": "katth' etaṃ uparujjhati\". 1037. ",
  "snp5.2:6.1": "\"Yam etaṃ pañhaṃ apucchi, ",
  "snp5.2:6.2": "Ajita taṃ vadāmi te, ",
  "snp5.2:6.3": "yattha nāmañ ca rūpañ ca ",
  "snp5.2:6.4": "asesaṃ uparujjhati: ",
  "snp5.2:6.5": "viññāṇassa nirodhena ",
  "snp5.2:6.6": "etth' etaṃ uparujjhati\". 1038. ",
  "snp5.2:7.1": "\"Ye ca saṃkhātadhammāse, ",
  "snp5.2:7.2": "ye ca sekhā puthū idha, ",
  "snp5.2:7.3": "tesaṃ me nipako iriyaṃ ",
  "snp5.2:7.4": "puṭṭho pabrūhi mārisa\". 1039. ",
  "snp5.2:8.1": "\"Kāmesu nābhigijjheyya, ",
  "snp5.2:8.2": "manasānāvilo siyā, ",
  "snp5.2:8.3": "kusalo sabbadhammānaṃ ",
  "snp5.2:8.4": "sato bhikkhu paribbaje\" ti| AJITAMĀṆAVAPUCCHĀ NIṬṬHITĀ. 1040. \"Ko 'dha ",
  "snp5.2:8.5": ""
}
