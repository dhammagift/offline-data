{
  "snp1.8:0.1": "",
  "snp1.8:0.2": "",
  "snp1.8:1.1": "",
  "snp1.8:1.2": "santaṃ padaṃ abhisamecca: ",
  "snp1.8:1.3": "sakko ujū ca sūjū ca ",
  "snp1.8:1.4": "suvaco c' assa mudu anatimānī, 144. ",
  "snp1.8:2.1": "santussako ca subharo ca ",
  "snp1.8:2.2": "appakicco ca sallahukavutti ",
  "snp1.8:2.3": "santindriyo ca nipako ca ",
  "snp1.8:2.4": "appagabbho kulesu ananugiddho, 145. ",
  "snp1.8:3.1": "na ca khuddaṃ samācare kiñci, ",
  "snp1.8:3.2": "yena viññū pare upavadeyyuṃ. ",
  "snp1.8:3.3": "Sukhino vā khemino hontu ",
  "snp1.8:3.4": "sabbe sattā bhavantu sukhitattā: 146. ",
  "snp1.8:4.1": "ye keci pāṇabhūt' atthi ",
  "snp1.8:4.2": "tasā vā thāvarā vā anavasesā ",
  "snp1.8:4.3": "dīghā vā ye mahantā vā ",
  "snp1.8:4.4": "majjhimā rassakā aṇukathūlā. 147. ",
  "snp1.8:5.1": "diṭṭhā vā ye vā addiṭṭhā, ",
  "snp1.8:5.2": "ye ca dūre vasanti avidūre, ",
  "snp1.8:5.3": "bhūtā vā sambhavesī vā, -- ",
  "snp1.8:5.4": "sabbe sattā bhavantu sukhitattā. 148. ",
  "snp1.8:6.1": "Na paro paraṃ nikubbetha, ",
  "snp1.8:6.2": "nātimaññetha katthacinaṃ kañci, ",
  "snp1.8:6.3": "vyārosanā paṭighasaññā ",
  "snp1.8:6.4": "nāññamaññassa dukkham iccheyya. 149. ",
  "snp1.8:7.1": "Mātā yathā niyaṃ puttaṃ ",
  "snp1.8:7.2": "āyusā ekaputtam anurakkhe, ",
  "snp1.8:7.3": "evam pi sabbabhūtesu ",
  "snp1.8:7.4": "mānasam bhāvaye aparimāṇaṃ. 150. ",
  "snp1.8:8.1": "Mettañ ca sabbalokasmiṃ ",
  "snp1.8:8.2": "mānasam bhāvaye aparimāṇaṃ ",
  "snp1.8:8.3": "uddhaṃ daho ca tiriyañ ca ",
  "snp1.8:8.4": "asambādhaṃ averaṃ asapattaṃ. 151. ",
  "snp1.8:9.1": "Tiṭṭhaṃ caraṃ nisinno vā ",
  "snp1.8:9.2": "sayāno vā yāvat' assa vigatamiddho, ",
  "snp1.8:9.3": "etaṃ satiṃ adhiṭṭheyya, ",
  "snp1.8:9.4": "brahmam etaṃ vihāraṃ idha-m-āhu. 152. ",
  "snp1.8:10.1": "Diṭṭhiñ ca anupagamma ",
  "snp1.8:10.2": "sīlavā dassanena sampanno ",
  "snp1.8:10.3": "kāmesu vineyya gedhaṃ, ",
  "snp1.8:10.4": "na hi jātu gabbhaseyyaṃ punar etī ti ",
  "snp1.8:10.5": "Mettasuttaṃ niṭṭhitaṃ. 153. "
}
