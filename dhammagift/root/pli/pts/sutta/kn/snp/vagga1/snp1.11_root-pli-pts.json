{
  "snp1.11:0.1": "",
  "snp1.11:0.2": "",
  "snp1.11:1.1": "Caraṃ vā yadi vā tiṭṭhaṃ ",
  "snp1.11:1.2": "nisinno uda vā sayaṃ ",
  "snp1.11:1.3": "sammiñjeti pasāreti, -- ",
  "snp1.11:1.4": "esā kāyassa iñjanā. 194. ",
  "snp1.11:2.1": "Aṭṭhīnahārusaññutto ",
  "snp1.11:2.2": "tacamaṃsāvalepano ",
  "snp1.11:2.3": "chaviyā kāyo paṭicchanno ",
  "snp1.11:2.4": "yathābhūtaṃ na dissati, 195. ",
  "snp1.11:3.1": "antapūro udarapūro ",
  "snp1.11:3.2": "yakapeḷassa vatthino ",
  "snp1.11:3.3": "hadayassa papphāsassa ",
  "snp1.11:3.4": "vakkassa pihakassa ca 196. ",
  "snp1.11:4.1": "siṃghānikāya khelassa ",
  "snp1.11:4.2": "sedassa medassa ca ",
  "snp1.11:4.3": "lohitassa lasikāya ",
  "snp1.11:4.4": "pittassa ca vasāya ca. 197. ",
  "snp1.11:5.1": "Ath' assa navahi sotehi ",
  "snp1.11:5.2": "asucī savati sabbadā: ",
  "snp1.11:5.3": "akkhimhā akkhigūthako, ",
  "snp1.11:5.4": "kaṇṇamhā kaṇṇagūthako, 198. ",
  "snp1.11:6.1": "siṃghāṇikā ca nāsāto, ",
  "snp1.11:6.2": "mukhena vamat' ekadā ",
  "snp1.11:6.3": "pittaṃ semhañ ca vamati, ",
  "snp1.11:6.4": "kāyamhā sedajallikā. 199. ",
  "snp1.11:7.1": "Ath' assa susiraṃ sīsaṃ ",
  "snp1.11:7.2": "matthaluṅgassa pūritam, ",
  "snp1.11:7.3": "subhato naṃ maññatī bālo ",
  "snp1.11:7.4": "avijjāya purakkhato. 200. ",
  "snp1.11:8.1": "Yadā ca so mato seti ",
  "snp1.11:8.2": "uddhumāto vinīlako ",
  "snp1.11:8.3": "apaviddho susānasmiṃ, ",
  "snp1.11:8.4": "anapekhā honti ñātayo, 201. ",
  "snp1.11:9.1": "khādanti naṃ supāṇā ca ",
  "snp1.11:9.2": "sigālā ca vakā kimī, ",
  "snp1.11:9.3": "kākā gijjhā ca khādanti, ",
  "snp1.11:9.4": "ye c' aññe santi pāṇayo. 202. ",
  "snp1.11:10.1": "Sutvāna Buddhavacanaṃ ",
  "snp1.11:10.2": "bhikkhu paññāṇavā idha, ",
  "snp1.11:10.3": "so kho maṃ parijānāti, ",
  "snp1.11:10.4": "yathābhūtaṃ hi passati. 203. ",
  "snp1.11:11.1": "‘Yathā idaṃ tathā etaṃ, ",
  "snp1.11:11.2": "yathā etaṃ tathā idaṃ,' ",
  "snp1.11:11.3": "ajjhattañ ca bahiddhā ca ",
  "snp1.11:11.4": "kāye chandaṃ virājaye. 204. ",
  "snp1.11:12.1": "Chandarāgaviratto so ",
  "snp1.11:12.2": "bhikkhu paññāṇavā idha ",
  "snp1.11:12.3": "ajjhagā amataṃ santiṃ ",
  "snp1.11:12.4": "nibbāna-padam accutaṃ. 205. Dipādako ",
  "snp1.11:13.1": "'yam asuci ",
  "snp1.11:13.2": "duggandho parihīrati ",
  "snp1.11:13.3": "nānākuṇapaparipūro ",
  "snp1.11:13.4": "vissavanto tato tato. 206. ",
  "snp1.11:14.1": "Etādisena kāyena ",
  "snp1.11:14.2": "yo maññe uṇṇametave ",
  "snp1.11:14.3": "paraṃ vā avajāneyya -- ",
  "snp1.11:14.4": "kim aññatra adassanā ti ",
  "snp1.11:14.5": "VIJAYASUTTAṂ NIṬṬHITAṂ. 207. "
}
