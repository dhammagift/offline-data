{
  "snp1.10:0.1": "",
  "snp1.10:0.2": "",
  "snp1.10:1.1": "Evam me sutaṃ: ",
  "snp1.10:1.2": "Ekaṃ samayaṃ Bhagavā Āḷaviyaṃ viharati Āḷavakassa yakkhassa bhavane. ",
  "snp1.10:1.3": "Atha kho Āḷavako yakkho yena Bhagavā ten' upasaṃkami, upasaṃkamitvā Bhagavantaṃ etad avoca: ",
  "snp1.10:1.4": "\"nikkhama samaṇā\" ti, -- ",
  "snp1.10:1.5": "\"sādh' āvuso\" ti Bhagavā nikkhami, -- ",
  "snp1.10:1.6": "\"pavisa samaṇā\" ti, -- ",
  "snp1.10:1.7": "\"sādh' āvuso\" ti Bhagavā pāvisi. ",
  "snp1.10:2.1": "Dutiyam pi ",
  "snp1.10:2.2": "kho Āḷavako yakkho Bhagavantaṃ etad avoca: ",
  "snp1.10:2.3": "\"nikkhama samaṇā\" ti, -- ",
  "snp1.10:2.4": "\"sādh' āvuso\" ti Bhagavā nikkhami, -- ",
  "snp1.10:2.5": "\"pavisa samaṇā\" ti, -- ",
  "snp1.10:2.6": "\"sādh' āvuso\" ti Bhagavā pāvisi. ",
  "snp1.10:3.1": "Tatiyam pi kho Āḷavako yakkho Bhagavantaṃ etad avoca: ",
  "snp1.10:3.2": "\"nikkhama samaṇā\" ti, -- \"sādh' āvuso\" ti Bhagavā nikkhami, -- \"pavisa samaṇā\" ti, -- \"sādh' āvuso\" ti Bhagavā pāvisi. Catuttham pi kho Āḷavako yakkho Bhagavantaṃ etad avoca: \"nikkhama samaṇā\" ti. ",
  "snp1.10:3.3": "\"Na khv-āhan taṃ āvuso nikkhamissāmi, ",
  "snp1.10:3.4": "yan te karaṇīyaṃ, taṃ karohī\" ti. ",
  "snp1.10:4.1": "\"Pañhan taṃ samaṇa pucchissāmi, ",
  "snp1.10:4.2": "sace me na vyākarissasi, cittaṃ vā te khipissāmi hadayaṃ vā te phālessāmi pādesu vā gahetvā pāra-Gaṅgāya khipissāmī\" ti. ",
  "snp1.10:5.1": "\"Na khv-āhan taṃ āvuso passāmi sadevake loke samārake sabrahmake sassamaṇabrāhmaṇiyā pajāya sadevamanussāya, yo me cittaṃ vā khipeyya hadayaṃ vā phāḷeyya pādesu vā gahetvā pāra-Gaṅgāya khipeyya, ",
  "snp1.10:5.2": "api ca tvaṃ āvuso puccha yad ākaṃkhasī\" ti. ",
  "snp1.10:5.3": "Atha kho Āḷavako yakkho Bhagavantaṃ gāthāya ajjhabhāsi: 181. ",
  "snp1.10:6.1": "\"Kiṃ sū 'dha vittaṃ purisassa seṭṭhaṃ, ",
  "snp1.10:6.2": "kiṃ su suciṇṇaṃ sukham āvahāti, ",
  "snp1.10:6.3": "kiṃ su have sādutaraṃ rasānaṃ, ",
  "snp1.10:6.4": "kathaṃjīvim jīvitam āhu seṭṭhaṃ\". 182. ",
  "snp1.10:7.1": "\"Saddh' īdha vittaṃ purisassa seṭṭhaṃ, ",
  "snp1.10:7.2": "dhammo suciṇṇo sukham āvahāti, ",
  "snp1.10:7.3": "saccaṃ have sādutaraṃ rasānaṃ, ",
  "snp1.10:7.4": "paññājīviṃ jīvitam āhu seṭṭhaṃ\". 183. ",
  "snp1.10:8.1": "\"Kathaṃ su taratī oghaṃ, ",
  "snp1.10:8.2": "kathaṃ su tarati aṇṇavaṃ, ",
  "snp1.10:8.3": "kathaṃ su dukkhaṃ acceti, ",
  "snp1.10:8.4": "kathaṃ su parisujjhati\". 184. ",
  "snp1.10:9.1": "\"Saddhāya taratī oghaṃ, ",
  "snp1.10:9.2": "appamādena aṇṇavaṃ, ",
  "snp1.10:9.3": "viriyena dukkhaṃ acceti, ",
  "snp1.10:9.4": "paññāya parisujjhati\". 185. ",
  "snp1.10:10.1": "\"Kathaṃ su labhate paññaṃ, ",
  "snp1.10:10.2": "kathaṃ su vindate dhanaṃ, ",
  "snp1.10:10.3": "kathaṃ su kittiṃ pappoti, ",
  "snp1.10:10.4": "kathaṃ mittāni ganthati, ",
  "snp1.10:10.5": "asmā lokā paraṃ lokaṃ ",
  "snp1.10:10.6": "kathaṃ pecca na socati\". 186. ",
  "snp1.10:11.1": "\"Saddahāno arahataṃ ",
  "snp1.10:11.2": "dhammaṃ nibbānapattiyā ",
  "snp1.10:11.3": "sussūsā labbate paññaṃ ",
  "snp1.10:11.4": "appamatto vicakkhaṇo, 187. ",
  "snp1.10:12.1": "patirūpakārī dhuravā ",
  "snp1.10:12.2": "uṭṭhātā vindate dhanaṃ, ",
  "snp1.10:12.3": "saccena kittiṃ pappoti, ",
  "snp1.10:12.4": "dadaṃ mittāni ganthati. 188. ",
  "snp1.10:13.1": "Yass' ete caturo dhammā ",
  "snp1.10:13.2": "saddhassa gharamesino ",
  "snp1.10:13.3": "saccaṃ dhammo dhiti cāgo, ",
  "snp1.10:13.4": "sa ve pecca na socati. 189. ",
  "snp1.10:14.1": "Iṃgha aññe pi pucchassu ",
  "snp1.10:14.2": "puthū samaṇabrāhmaṇe, ",
  "snp1.10:14.3": "yadi saccā damā cāgā ",
  "snp1.10:14.4": "khantyā bhiyyo 'dha vijjati\". 190. ",
  "snp1.10:15.1": "\"Kathan nu dāni puccheyyaṃ ",
  "snp1.10:15.2": "puthū samaṇabrāhmaṇe, ",
  "snp1.10:15.3": "so 'haṃ ajja pajānāmi ",
  "snp1.10:15.4": "yo attho samparāyiko. 191. ",
  "snp1.10:16.1": "Atthāya vata me Buddho ",
  "snp1.10:16.2": "vāsāy' Āḷavim āgamā, so ",
  "snp1.10:16.3": "'ham ajja pajānāmi ",
  "snp1.10:16.4": "yattha dinnaṃ mahapphalaṃ. 192. ",
  "snp1.10:17.1": "So ahaṃ vicarissāmi ",
  "snp1.10:17.2": "gāmā gāmaṃ purā puraṃ ",
  "snp1.10:17.3": "namassamāno Sambuddhaṃ ",
  "snp1.10:17.4": "dhammassa ca sudhammatan\" ti ",
  "snp1.10:17.5": "ĀḶAVAKASUTTAṂ NIṬṬHITAṂ. 193. "
}
