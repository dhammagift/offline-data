{
  "snp1.6:0.1": "",
  "snp1.6:0.2": "",
  "snp1.6:1.1": "Evam me sutaṃ: ",
  "snp1.6:1.2": "Ekaṃ samayaṃ Bhagavā Sāvatthiyaṃ viharati Jetavane Anāthapiṇḍikassa ārāme. ",
  "snp1.6:1.3": "Atha kho aññatarā devatā abhikkantāya rattiyā abhikkantavaṇṇā kevalakappaṃ Jetavanaṃ obhāsetvā yena Bhagavā ten' upasaṃkami, upasaṃkamitvā Bhagavantaṃ abhivādetvā ekamantaṃ aṭṭhāsi. ",
  "snp1.6:1.4": "Ekamantaṃ ṭhitā kho sā devatā Bhagavantaṃ gāthāya ajjhabhāsi: 91. ",
  "snp1.6:2.1": "\"Parābhavantaṃ purisaṃ ",
  "snp1.6:2.2": "mayaṃ pacchāma Gotamaṃ ",
  "snp1.6:2.3": "Bhagavantaṃ puṭṭhum āgamma: ",
  "snp1.6:2.4": "kim parābhavato mukham\". 92. ",
  "snp1.6:3.1": "\"Suvijāno bhavaṃ hoti, ",
  "snp1.6:3.2": "suvijāno parābhavo: ",
  "snp1.6:3.3": "dhammakāmo bhavaṃ hoti, ",
  "snp1.6:3.4": "dhammadessī parābhavo\". 93. ",
  "snp1.6:4.1": "\"Iti h' etaṃ vijānāma, ",
  "snp1.6:4.2": "paṭhamo so parābbavo, ",
  "snp1.6:4.3": "dutiyaṃ Bhagavā brūhi: ",
  "snp1.6:4.4": "kim parābhavato mukhaṃ\". 94. ",
  "snp1.6:5.1": "\"Asant' assa piyā honti, ",
  "snp1.6:5.2": "sante na kurute piyaṃ, ",
  "snp1.6:5.3": "asataṃ dhammaṃ roceti, ",
  "snp1.6:5.4": "tam parābhavato mukhaṃ\". 95. ",
  "snp1.6:6.1": "\"Iti h' etaṃ vijānāma, ",
  "snp1.6:6.2": "dutiyo so parābhavo, ",
  "snp1.6:6.3": "tatiyaṃ Bhagavā brūhi: ",
  "snp1.6:6.4": "kim parābhavato mukhaṃ\". 96. ",
  "snp1.6:7.1": "\"Niddāsīlī sabhāsīlī ",
  "snp1.6:7.2": "anuṭṭhātā ca yo naro ",
  "snp1.6:7.3": "alaso kodhapaññāṇo, ",
  "snp1.6:7.4": "tam parābhavato mukhaṃ\". 97. ",
  "snp1.6:8.1": "\"Iti h' etaṃ vijānāma, ",
  "snp1.6:8.2": "tatiyo so parābhavo, ",
  "snp1.6:8.3": "catutthaṃ Bhagavā brūhi: ",
  "snp1.6:8.4": "kim parābhavato mukhaṃ\". 98. ",
  "snp1.6:9.1": "\"Yo mātaraṃ vā pitaraṃ vā ",
  "snp1.6:9.2": "jiṇṇakaṃ gatayobbanaṃ ",
  "snp1.6:9.3": "pahu santo na bharati, ",
  "snp1.6:9.4": "tam p; arābhavato mukham\". 99. ",
  "snp1.6:10.1": "\"Iti h' etaṃ vijānāma, ",
  "snp1.6:10.2": "catuttho so parābhavo, ",
  "snp1.6:10.3": "pañcamaṃ Bhagavā brūhi: ",
  "snp1.6:10.4": "kim parābhavato mukhaṃ\". 100. ",
  "snp1.6:11.1": "\"Yo brāhmaṇaṃ vā sammaṇaṃ vā ",
  "snp1.6:11.2": "aññaṃ vā pi vaṇibbakaṃ ",
  "snp1.6:11.3": "musāvādena vañceti, ",
  "snp1.6:11.4": "tam parābhavato mukhaṃ\". 101. ",
  "snp1.6:12.1": "\"Iti h' etaṃ vijānāma, ",
  "snp1.6:12.2": "pañcamo so parābhavo, ",
  "snp1.6:12.3": "chaṭṭhamaṃ Bhagavā brūhi: ",
  "snp1.6:12.4": "kim parābhavato mukhaṃ\". 102. ",
  "snp1.6:13.1": "\"Pahūtavitto puriso ",
  "snp1.6:13.2": "sahirañño sabhojano ",
  "snp1.6:13.3": "eko bhuñjati sādūni, ",
  "snp1.6:13.4": "tam parābhavato mukhaṃ\". 103. ",
  "snp1.6:14.1": "\"Iti h' etaṃ vijānāma, ",
  "snp1.6:14.2": "chaṭṭhamo so parābhavo ",
  "snp1.6:14.3": "sattamaṃ Bhagavā brūhi: ",
  "snp1.6:14.4": "kim parābhavato mukhaṃ\". 104. ",
  "snp1.6:15.1": "\"Jātitthaddho dhanatthaddho ",
  "snp1.6:15.2": "gottatthaddho ca yo naro ",
  "snp1.6:15.3": "saṃ ñātiṃ atimaññeti, ",
  "snp1.6:15.4": "tam parābhavato mukhaṃ\". 105. ",
  "snp1.6:16.1": "\"Iti h' etaṃ vijānāma, ",
  "snp1.6:16.2": "sattamo so parābhavo, ",
  "snp1.6:16.3": "aṭṭhamaṃ Bhagavā brūhi: ",
  "snp1.6:16.4": "kim parābhavato mukhaṃ\". 106. ",
  "snp1.6:17.1": "\"Itthidhutto surādhutto ",
  "snp1.6:17.2": "akkhadhutto ca yo naro ",
  "snp1.6:17.3": "laddhaṃ laddhaṃ vināseti, ",
  "snp1.6:17.4": "tam parābhavato mukhaṃ\". 107. ",
  "snp1.6:18.1": "\"Iti h' etaṃ vijānāma, ",
  "snp1.6:18.2": "aṭṭhamo so parābbavo, ",
  "snp1.6:18.3": "navamaṃ Bhagavā brūhi: ",
  "snp1.6:18.4": "kim parābhavato mukhaṃ\". 108. ",
  "snp1.6:19.1": "\"Sehi dārehi asantuṭṭho ",
  "snp1.6:19.2": "vesiyāsu padissati, ",
  "snp1.6:19.3": "dissati paradāresu, ",
  "snp1.6:19.4": "tam parābhavato mukhaṃ\". 109. ",
  "snp1.6:20.1": "\"Iti h' etaṃ vijānāma, ",
  "snp1.6:20.2": "navamo so parābhavo, ",
  "snp1.6:20.3": "dasamaṃ Bhagavā brūhi: ",
  "snp1.6:20.4": "kim parābhavato mukham\". 110. ",
  "snp1.6:21.1": "\"Atītayobbano poso ",
  "snp1.6:21.2": "āneti timbarutthaniṃ, ",
  "snp1.6:21.3": "tassā issā na supati, ",
  "snp1.6:21.4": "tam parābhavato mukhaṃ\". 111. ",
  "snp1.6:22.1": "\"Iti h' etaṃ vijānāma, ",
  "snp1.6:22.2": "dasamo so parābhavo, ",
  "snp1.6:22.3": "ekādasamaṃ Bhagavā brūhi: ",
  "snp1.6:22.4": "kim parābhavato mukhaṃ\". 112. ",
  "snp1.6:23.1": "\"Itthisoṇḍiṃ vikiraṇiṃ ",
  "snp1.6:23.2": "purisaṃ vā pi tādisaṃ ",
  "snp1.6:23.3": "issariyasmiṃ ṭhāpeti, ",
  "snp1.6:23.4": "tam parābhavato mukham\". 113. ",
  "snp1.6:24.1": "\"Iti h' etaṃ vijānāma, ",
  "snp1.6:24.2": "ekādasamo so parābhavo, ",
  "snp1.6:24.3": "dvādasamaṃ Bhagavā brūhi: ",
  "snp1.6:24.4": "kim parābhavato mukham\". 114. ",
  "snp1.6:25.1": "\"Appabhogo mahātaṇho ",
  "snp1.6:25.2": "khattiye jāyate kule, ",
  "snp1.6:25.3": "so 'dha rajjaṃ patthayati, ",
  "snp1.6:25.4": "tam parābhavato mukhaṃ. 115. ",
  "snp1.6:26.1": "Ete parābhave loke ",
  "snp1.6:26.2": "paṇḍito samavekkhiya ",
  "snp1.6:26.3": "ariyo dassanasampanno, ",
  "snp1.6:26.4": "sa lokaṃ bhajate sivan\" ti ",
  "snp1.6:26.5": "Parābhavasuttaṃ niṭṭhitaṃ. "
}
