{
  "snp1.2:0.1": "",
  "snp1.2:0.2": "",
  "snp1.2:1.1": "\"Pakkodano duddhakhīro 'ham asmi ",
  "snp1.2:1.2": "iti Dhaniyo gopo ",
  "snp1.2:1.3": "anutīre Mahiyā samānavāso, ",
  "snp1.2:1.4": "channā kuṭi, āhito gini, -- ",
  "snp1.2:1.5": "atha ce patthayasī, pavassa davassa deva\". 19. ",
  "snp1.2:2.1": "\"Akkodhano vigatakhīlo 'ham asmi ",
  "snp1.2:2.2": "iti Bhagavā ",
  "snp1.2:2.3": "anutīre Mahiy' ekarattivāso, ",
  "snp1.2:2.4": "vivaṭā kuṭi, nibbuto gini, -- ",
  "snp1.2:2.5": "atha ce patthayasī, pavassa deva\". 20. ",
  "snp1.2:3.1": "\"Andhakamakasā na vijjare, ",
  "snp1.2:3.2": "iti Dhaniyo gopo ",
  "snp1.2:3.3": "kacche rūḷhatiṇe caranti gāvo, ",
  "snp1.2:3.4": "vuṭṭhim pi saheyyuṃ āgataṃ, -- ",
  "snp1.2:3.5": "atha ce patthayasī. pavassa deva\". 21. ",
  "snp1.2:4.1": "\"Baddhā hi bhisī susaṃkhatā, ",
  "snp1.2:4.2": "iti Bhagavā ",
  "snp1.2:4.3": "tiṇṇo pāragato vineyya oghaṃ, ",
  "snp1.2:4.4": "attho bhisiyā na vijjati, -- ",
  "snp1.2:4.5": "atha ce patthayasī, pavassa deva\". 22. ",
  "snp1.2:5.1": "\"Gopī mama assavā alolā ",
  "snp1.2:5.2": "iti Dhaniyo gopo ",
  "snp1.2:5.3": "dīgharattaṃ saṃvāsiyā manāpā, ",
  "snp1.2:5.4": "tassā na suṇāmi kiñci pāpaṃ, -- ",
  "snp1.2:5.5": "atha ce --pe--\" 23. ",
  "snp1.2:6.1": "\"Cittaṃ mama assavaṃ vimuttaṃ ",
  "snp1.2:6.2": "iti Bhagavā ",
  "snp1.2:6.3": "dīgharattaṃ paribhāvitaṃ sudantaṃ, ",
  "snp1.2:6.4": "pāpam pana me na vijjati, -- ",
  "snp1.2:6.5": "atha ce . . \". 24. ",
  "snp1.2:7.1": "\"Attavetanabhato 'ham asmi, ",
  "snp1.2:7.2": "iti Dhaniyo gopo ",
  "snp1.2:7.3": "puttā ca me samāniyā arogā, ",
  "snp1.2:7.4": "tesaṃ na suṇāmi kiñci pāpaṃ, -- ",
  "snp1.2:7.5": "atha ce . . \". 25. ",
  "snp1.2:8.1": "\"Nāhaṃ bhatako 'smi kassaci, ",
  "snp1.2:8.2": "iti Bhagavā ",
  "snp1.2:8.3": "nibbitthena carāmi sabbaloke, ",
  "snp1.2:8.4": "attho bhatiyā na vijjati, -- ",
  "snp1.2:8.5": "atha ce . . \". 26. ",
  "snp1.2:9.1": "\"Atthi vasā, atthi dhenupā, ",
  "snp1.2:9.2": "iti Dhaniyo gopo ",
  "snp1.2:9.3": "godharaṇiyo paveṇiyo pi atthi, ",
  "snp1.2:9.4": "usabho pi gavampatī ca atthi, -- ",
  "snp1.2:9.5": "atha ce . . \". 27. ",
  "snp1.2:10.1": "\"N' atthi vasā, n' atthi dhenupā, ",
  "snp1.2:10.2": "iti Bhagavā ",
  "snp1.2:10.3": "godharaṇiyo paveṇiyo pi n' atthi,| ",
  "snp1.2:10.4": "usabho pi gavampatīdha n' atthi, -- ",
  "snp1.2:10.5": "atha ce . . \". 28. ",
  "snp1.2:11.1": "\"Khīlā nikhātā asampavedhī, ",
  "snp1.2:11.2": "iti Dhaniyo gopo ",
  "snp1.2:11.3": "dāmā muñjamayā navā susaṇṭhānā, ",
  "snp1.2:11.4": "na hi sakkhiti dhenupā pi chettuṃ, -- ",
  "snp1.2:11.5": "atha ce . . \". 29. ",
  "snp1.2:12.1": "\"Usabho-r-iva chetva bandhanāni ",
  "snp1.2:12.2": "iti Bhagavā ",
  "snp1.2:12.3": "nāgo pūtilataṃ va dālayitvā ",
  "snp1.2:12.4": "nāhaṃ puna upessaṃ gabbhaseyyaṃ, -- ",
  "snp1.2:12.5": "atha ce patthayasī, pavassa deva\". 30. ",
  "snp1.2:13.1": "Ninnañ ca thalañ ca pūrayanto ",
  "snp1.2:13.2": "mahāmegho pāvassi tāvad eva, ",
  "snp1.2:13.3": "sutvā devassa vassato ",
  "snp1.2:13.4": "imam atthaṃ Dhaniyo abhāsatha: 31. ",
  "snp1.2:14.1": "\"Lābhā vata no anappakā, ",
  "snp1.2:14.2": "ye mayaṃ Bhagavantaṃ addasāma, ",
  "snp1.2:14.3": "saraṇaṃ taṃ upema cakkhuma, ",
  "snp1.2:14.4": "satthā no hohi tuvam mahāmuni. 32. ",
  "snp1.2:15.1": "Gopī ca ahañ ca assava ",
  "snp1.2:15.2": "brahmacariyaṃ Sugate carāmase, ",
  "snp1.2:15.3": "jātimaraṇassa pāragā ",
  "snp1.2:15.4": "dukkhass' antakarā bhavāmase\". 33. ",
  "snp1.2:16.1": "\"Nandati puttehi puttimā, ",
  "snp1.2:16.2": "iti Māro pāpimā ",
  "snp1.2:16.3": "gomiko gohi tath' eva nandati, ",
  "snp1.2:16.4": "upadhī hi narassa nandanā, ",
  "snp1.2:16.5": "na hi so nandati yo nirūpadhi\". 34. ",
  "snp1.2:17.1": "\"Socati puttehi puttimā, ",
  "snp1.2:17.2": "iti Bhagavā ",
  "snp1.2:17.3": "gomiko gohi tath' eva socati, ",
  "snp1.2:17.4": "upadhī hi narassa socanā, ",
  "snp1.2:17.5": "na hi so socati yo nirūpadhī\" ti ",
  "snp1.2:17.6": "DHANIYASUTTAṂ NIṬṬHITAṂ. 35. "
}
