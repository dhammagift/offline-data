{
  "snp1.5:0.1": "",
  "snp1.5:0.2": "",
  "snp1.5:1.1": "\"Pucchāmi muniṃ pahūtapaññaṃ ",
  "snp1.5:1.2": "iti Cundo kammāraputto ",
  "snp1.5:1.3": "Buddhaṃ dhammassāmiṃ vītataṇhaṃ ",
  "snp1.5:1.4": "dipaduttamaṃ sārathīnaṃ pavaraṃ: ",
  "snp1.5:1.5": "kati loke samaṇā, tad iṃgha brūhi\". 84. ",
  "snp1.5:2.1": "\"Caturo samaṇā, na pañcamo 'tthi,| ",
  "snp1.5:2.2": "Cundā ti Bhagavā ",
  "snp1.5:2.3": "te te āvikaromi sakkhipuṭṭho: ",
  "snp1.5:2.4": "maggajino maggadesako ca, ",
  "snp1.5:2.5": "magge jīvati, yo ca maggadūsī\". 85. ",
  "snp1.5:3.1": "\"Kam maggajinaṃ vadanti buddhā, ",
  "snp1.5:3.2": "iti Cundo kammāraputto ",
  "snp1.5:3.3": "maggajjhāyī kathaṃ atulyo hoti, ",
  "snp1.5:3.4": "magge jīvati me brūhi puṭṭho, ",
  "snp1.5:3.5": "atha me avikarohi maggadūsiṃ\" 86. ",
  "snp1.5:4.1": "\"Yo tiṇṇakathaṃkatho visallo ",
  "snp1.5:4.2": "nibbānābhirato anānugiddho ",
  "snp1.5:4.3": "lokassa sadevakassa netā, ",
  "snp1.5:4.4": "tādiṃ maggajinaṃ vadanti buddhā. 87. ",
  "snp1.5:5.1": "Paramaṃ paraman ti yo 'dha ñatvā ",
  "snp1.5:5.2": "akkhāti vibhajati idh' eva dhammaṃ, ",
  "snp1.5:5.3": "taṃ kaṃkhacchidaṃ muniṃ, anejaṃ ",
  "snp1.5:5.4": "dutiyaṃ bhikkhunam āhu maggadesiṃ. 88. ",
  "snp1.5:6.1": "Yo dhammapade sudesite ",
  "snp1.5:6.2": "magge jīvati saññato satīmā ",
  "snp1.5:6.3": "anavajjapadāni sevamano, ",
  "snp1.5:6.4": "tatiyaṃ bhikkhunam āhu maggajīviṃ. 89. ",
  "snp1.5:7.1": "Chadanaṃ katvāna subbatānaṃ ",
  "snp1.5:7.2": "pakkhandī kuladūsako pagabbho ",
  "snp1.5:7.3": "māyāvī asaññato palāpo ",
  "snp1.5:7.4": "patirūpena caraṃ, sa maggadūsī. 90. ",
  "snp1.5:8.1": "Ete ca paṭivijjhi yo gahaṭṭho ",
  "snp1.5:8.2": "sutavā ariyasāvako sapañño| ",
  "snp1.5:8.3": "sabbe ne ‘tādisā' ti ñatvā , ",
  "snp1.5:8.4": "iti disvā na hāpeti tassa saddhā, -- ",
  "snp1.5:8.5": "kathaṃ hi duṭṭhena asampaduṭṭhaṃ ",
  "snp1.5:8.6": "suddhaṃ asuddhena samaṃ kareyyā\" ti ",
  "snp1.5:8.7": "Cundasuttaṃ niṭṭhitaṃ. "
}
