{
  "snp1.12:0.1": "",
  "snp1.12:0.2": "",
  "snp1.12:1.1": "Santhavāto bhayaṃ jātaṃ, ",
  "snp1.12:1.2": "niketā jāyate rajo, ",
  "snp1.12:1.3": "aniketam asanthavaṃ: ",
  "snp1.12:1.4": "etaṃ ve munidassanaṃ. 208. ",
  "snp1.12:2.1": "Yo jātam ucchijja na ropayeyya, ",
  "snp1.12:2.2": "jāyantam assa nānuppavecche, ",
  "snp1.12:2.3": "tam āhu ekaṃ muninaṃ carantaṃ: ",
  "snp1.12:2.4": "addakkhi so santipadaṃ mahesi. 209. ",
  "snp1.12:3.1": "Saṃkhāya vatthūni pamāya bījaṃ ",
  "snp1.12:3.2": "sineham assa nānuppavecche, ",
  "snp1.12:3.3": "sa ve munī jātikhayantadassī ",
  "snp1.12:3.4": "takkaṃ pahāya na upeti saṃkhaṃ. 210. ",
  "snp1.12:4.1": "Aññāya sabbāni nivesanāni ",
  "snp1.12:4.2": "anikāmayaṃ aññataraṃ pi tesaṃ ",
  "snp1.12:4.3": "sa ve munī vitagedho agiddho ",
  "snp1.12:4.4": "nāyūhatī, pāragato hi hoti. 211. ",
  "snp1.12:5.1": "Sabbābhibhuṃ sabbaviduṃ sumedhaṃ ",
  "snp1.12:5.2": "sabbesu dhammesu anūpalitaṃ ",
  "snp1.12:5.3": "sabbañjahaṃ taṇhakkhaye vimuttaṃ, ",
  "snp1.12:5.4": "taṃ vāpi dhīrā muniṃ vedayanti. 212. ",
  "snp1.12:6.1": "Paññābalaṃ sīlavatūpapannaṃ ",
  "snp1.12:6.2": "samāhitaṃ jhānarataṃ satīmaṃ ",
  "snp1.12:6.3": "saṅgā pamuttaṃ akhilaṃ anāsavaṃ, ",
  "snp1.12:6.4": "taṃ vāpi dhīra muniṃ vedayanti. 213. ",
  "snp1.12:7.1": "Ekaṃ carantaṃ muniṃ appamattaṃ ",
  "snp1.12:7.2": "nindāpasaṃsāsu avedhamānaṃ ",
  "snp1.12:7.3": "sīhaṃ va saddesu asantasantaṃ ",
  "snp1.12:7.4": "vātaṃ va jālamhi asajjamānaṃ ",
  "snp1.12:7.5": "padumaṃ va toyena alippamānaṃ ",
  "snp1.12:7.6": "netāram āññesaṃ anaññaneyyaṃ, ",
  "snp1.12:7.7": "taṃ vāpi --pe--. 214. ",
  "snp1.12:8.1": "Yo ogahane thambho-r-ivābhijāyati, ",
  "snp1.12:8.2": "yasmiṃ pare vācā pariyantaṃ vadanti, ",
  "snp1.12:8.3": "taṃ vītarāgaṃ susamāhitindriyaṃ, ",
  "snp1.12:8.4": "taṃ vāpi . . . 215. ",
  "snp1.12:9.1": "Yo ve ṭhitatto tasaraṃ va ujjaṃ ",
  "snp1.12:9.2": "jigucchati kammehi pāpakehi ",
  "snp1.12:9.3": "vīmaṃsamāno visamaṃ samañ ca, ",
  "snp1.12:9.4": "taṃ vāpi . . . 216. ",
  "snp1.12:10.1": "Yo saññatatto na karoti pāpaṃ, ",
  "snp1.12:10.2": "daharo ca majjho ca munī yatatto, ",
  "snp1.12:10.3": "arosaneyyo so na roseti kañci, ",
  "snp1.12:10.4": "taṃ vāpi . . . 217. ",
  "snp1.12:11.1": "Yad aggato majjhato sesato vā ",
  "snp1.12:11.2": "piṇḍaṃ labhetha paradattūpajīvī, ",
  "snp1.12:11.3": "nālan thutun no pi nipaccavādī, ",
  "snp1.12:11.4": "taṃ vāpi . . . 218. ",
  "snp1.12:12.1": "Muniṃ carantaṃ virataṃ methunasmā, ",
  "snp1.12:12.2": "yo yobbane na upanibajjhate kvaci, ",
  "snp1.12:12.3": "madappamādā virataṃ vippamuttaṃ, ",
  "snp1.12:12.4": "taṃ vāpi . . . 219. ",
  "snp1.12:13.1": "Aññāya lokaṃ paramatthadassiṃ ",
  "snp1.12:13.2": "oghaṃ samuddaṃ atitariya tādiṃ .| ",
  "snp1.12:13.3": "taṃ chinnaganthaṃ asitaṃ anāsavaṃ ",
  "snp1.12:13.4": "taṃ vāpi dhīrā muniṃ vedayanti. 220. ",
  "snp1.12:14.1": "Asamā ubho dūravihāravuttino: ",
  "snp1.12:14.2": "gihi dāraposī amano ca subbato, -- ",
  "snp1.12:14.3": "parapāṇarodhāya gihī asaññato, ",
  "snp1.12:14.4": "niccaṃ munī rakkhati pāṇine yato. 221. ",
  "snp1.12:15.1": "Sikhī yathā nīlagīvo vihaṅgamo ",
  "snp1.12:15.2": "haṃsassa nopeti javaṃ kudācanaṃ, ",
  "snp1.12:15.3": "evaṃ gihī nānukaroti bhikkhuno ",
  "snp1.12:15.4": "munino vivittassa vanamhi jhāyato ti| MUNISUTTAṂ NIṬṬHITAṂ. Tass' uddānaṃ: Urago Dhaniyo c' eva Visānañ ca tathā Kasi Cundo Parābhavo c' eva Vasalo Mettabhāvanā Sātāgiro Āḷavako Vijjaya ca tathā Muni, dvādas' etāni suttāni ",
  "snp1.12:15.5": "",
  "snp1.12:15.6": "Uragavaggo ti ",
  "snp1.12:16.0": "",
  "snp1.12:16.1": "",
  "snp1.12:16.2": "vuccatī ",
  "snp1.12:16.3": "",
  "snp1.12:16.4": "",
  "snp1.12:17.1": "",
  "snp1.12:17.2": "ti.| 222. ",
  "snp1.12:17.3": "",
  "snp1.12:17.4": ""
}
