{
  "snp1.3:0.1": "",
  "snp1.3:0.2": "",
  "snp1.3:1.1": "Sabbesu bhūtesu nidhāya daṇḍaṃ ",
  "snp1.3:1.2": "aviheṭhayaṃ aññataram pi tesaṃ ",
  "snp1.3:1.3": "na puttam iccheyya kuto sahāyaṃ, ",
  "snp1.3:1.4": "eko care khaggavisāṇakappo. 36. ",
  "snp1.3:2.1": "Saṃsaggajātassa bhavati sneho, ",
  "snp1.3:2.2": "snehanvayaṃ dukkham idam pahoti, ",
  "snp1.3:2.3": "ādīnavaṃ snehajaṃ pekkhamāno ",
  "snp1.3:2.4": "eko care khaggavisāṇakappo. 37. ",
  "snp1.3:3.1": "Mitte suhajje anukampamāno ",
  "snp1.3:3.2": "hāpeti atthaṃ paṭibaddhacitto, ",
  "snp1.3:3.3": "etaṃ bhayaṃ santhave pekkhamāno ",
  "snp1.3:3.4": "eko care khaggavisāṇakappo. 38. ",
  "snp1.3:4.1": "Vaṃso visālo va yathā visatto ",
  "snp1.3:4.2": "puttesu dāresu ca yā apekhā,| vaṃsākaḷīro ",
  "snp1.3:4.3": "va asajjamāno ",
  "snp1.3:4.4": "eko care --pe--. 39. ",
  "snp1.3:5.1": "Migo araññamhi yathā abaddho ",
  "snp1.3:5.2": "yenicchakaṃ ghacchati gocarāya, ",
  "snp1.3:5.3": "viññū naro seritaṃ pekkhamāno ",
  "snp1.3:5.4": "eko care . . . 40. ",
  "snp1.3:6.1": "Āmantanā hoti sahāyamajjhe ",
  "snp1.3:6.2": "vāse ṭhāne gamane cārikāya, ",
  "snp1.3:6.3": "anabhijjhitaṃ seritaṃ pekkhamāno ",
  "snp1.3:6.4": "eko care . . . 41. ",
  "snp1.3:7.1": "Khiḍḍā ratī hoti sahāyamajjhe ",
  "snp1.3:7.2": "puttesu ca vipulaṃ hoti pemam, ",
  "snp1.3:7.3": "parissayānaṃ sahitā achambhī ",
  "snp1.3:7.4": "eko care . . . 42. ",
  "snp1.3:8.1": "Cātuddiso appatigho ca hoti ",
  "snp1.3:8.2": "santussamāno itarītarena, ",
  "snp1.3:8.3": "parissayānaṃ sahitā achambhī ",
  "snp1.3:8.4": "eko care . . . 43. ",
  "snp1.3:9.1": "Dussaṅgahā pabbajitā pi eke ",
  "snp1.3:9.2": "atho gahatthā gharam āvasantā, ",
  "snp1.3:9.3": "appossukko paraputtesu hutvā ",
  "snp1.3:9.4": "eko care . . . 44. ",
  "snp1.3:10.1": "Oropayitvā gihivyañjanāni ",
  "snp1.3:10.2": "saṃsīnapatto yathā koviḷāro| ",
  "snp1.3:10.3": "chetvāna vīro gihibandhanāni ",
  "snp1.3:10.4": "eko care . . . 45. ",
  "snp1.3:11.1": "Sace labhetha nipakaṃ sahāyaṃ ",
  "snp1.3:11.2": "saddhiṃcaraṃ sādhuvihāri dhīraṃ, ",
  "snp1.3:11.3": "abhibhuyya sabbāni parissayāni ",
  "snp1.3:11.4": "careyya ten' attamano satīmā. 46. ",
  "snp1.3:12.1": "No ce labhetha nipakaṃ sahāyaṃ ",
  "snp1.3:12.2": "saddhiṃcaraṃ sādhurihāri dhīraṃ, ",
  "snp1.3:12.3": "rājā va raṭṭhaṃ vijitam pahāya ",
  "snp1.3:12.4": "eko care . . . 47. ",
  "snp1.3:13.1": "Addhā pasaṃsāma sahāyasampadaṃ: ",
  "snp1.3:13.2": "seṭṭhā samā sevitabbā sahāyā, ",
  "snp1.3:13.3": "ete aladdhā anavajjabhojī ",
  "snp1.3:13.4": "eko care . . . 48. ",
  "snp1.3:14.1": "Disvā suvaṇṇassa pabhassarāni ",
  "snp1.3:14.2": "kammāraputtena suniṭṭhitāni ",
  "snp1.3:14.3": "saṃghaṭṭamānāni duve bhujasmiṃ ",
  "snp1.3:14.4": "eko care . . . 49. ",
  "snp1.3:15.1": "Evaṃ dutiyena sahā mam' assa ",
  "snp1.3:15.2": "vācābhilāpo abhisajjanā vā, ",
  "snp1.3:15.3": "etaṃ bhayaṃ āyatiṃ pekkhamāno ",
  "snp1.3:15.4": "eko care . . . 50. ",
  "snp1.3:16.1": "Kāmā hi citrā madhurā manoramā ",
  "snp1.3:16.2": "virūparūpena mathenti cittaṃ, ",
  "snp1.3:16.3": "ādīnavaṃ kāmaguṇesu disvā ",
  "snp1.3:16.4": "eko care . . . 51. ",
  "snp1.3:17.1": "‘Itī ca gaṇḍo ca upaddavo ca ",
  "snp1.3:17.2": "rogo ca sallañ ca bhayañ ca m' etaṃ,' ",
  "snp1.3:17.3": "etaṃ bhayaṃ kāmaguṇesu disvā ",
  "snp1.3:17.4": "eko care . . . 52. ",
  "snp1.3:18.1": "Sītañ ca uṇhañ ca, khudaṃ pipāsaṃ, ",
  "snp1.3:18.2": "vātātāpe ḍaṃsasiriṃsape ca ",
  "snp1.3:18.3": "sabbāni p' etāni abhisambhavitvā ",
  "snp1.3:18.4": "eko care . . . 53. ",
  "snp1.3:19.1": "Nāgo va yūthāni vivajjayitvā ",
  "snp1.3:19.2": "sañjātakhandho padumī ulāro ",
  "snp1.3:19.3": "yathābhirantaṃ vihare araññe, ",
  "snp1.3:19.4": "eko care . . . 54. ",
  "snp1.3:20.1": "Aṭṭhāna taṃ saṃgaṇikāratassa, ",
  "snp1.3:20.2": "yam phassaye sāmayikaṃ vimuttiṃ, -- ",
  "snp1.3:20.3": "Ādiccabandhussa vaco nisamma 55. ",
  "snp1.3:20.4": "",
  "snp1.3:21.1": "Diṭṭhīvisūkāni upātivatto ",
  "snp1.3:21.2": "patto niyāmaṃ paṭiladdhamaggo, ",
  "snp1.3:21.3": "‘uppannañāṇo 'mhi anaññaneyyo' ",
  "snp1.3:21.4": "eko care . . . 56. ",
  "snp1.3:22.1": "Nillolupo nikkuho nippipāso ",
  "snp1.3:22.2": "nimmakkho niddhantakasāvamoho ",
  "snp1.3:22.3": "nirāsayo sabbaloke bhavitvā ",
  "snp1.3:22.4": "eko care . . . 57. ",
  "snp1.3:23.1": "Pāpaṃ sahāyaṃ parivajjayetha ",
  "snp1.3:23.2": "anatthadassiṃ visame niviṭṭhaṃ, ",
  "snp1.3:23.3": "sayaṃ na seve pasutaṃ pamattaṃ, ",
  "snp1.3:23.4": "eko care . . . 58. ",
  "snp1.3:24.1": "Bahussutaṃ dhammadharaṃ bhajetha ",
  "snp1.3:24.2": "mittaṃ uḷāraṃ patibhānavantaṃ, ",
  "snp1.3:24.3": "aññāya atthāni vineyya kaṃkhaṃ ",
  "snp1.3:24.4": "eko care . . . 59. ",
  "snp1.3:25.1": "Khiḍḍaṃ ratiṃ kāmasukhañ ca loke ",
  "snp1.3:25.2": "analaṃkaritvā anapekkhamāno ",
  "snp1.3:25.3": "vibhūsanaṭṭhānā virato saccavādī ",
  "snp1.3:25.4": "eko care . . . 60. ",
  "snp1.3:26.1": "Puttañ ca dāraṃ pitarañ ca mataraṃ ",
  "snp1.3:26.2": "dhanāni dhaṇṇāni ca bandhavāni ca ",
  "snp1.3:26.3": "hitvāna kāmāni yathodhikāni ",
  "snp1.3:26.4": "eko care . . . 61. ",
  "snp1.3:27.1": "‘Saṅgo eso, parittam ettha sokhyaṃ, ",
  "snp1.3:27.2": "app' assādo, dukkham ettha bhiyyo, ",
  "snp1.3:27.3": "gaḷo eso' iti ñatvā mutīmā ",
  "snp1.3:27.4": "eko care . . . 62. Sandālayitvā ",
  "snp1.3:28.1": "saṃyojanāni ",
  "snp1.3:28.2": "jālaṃ va bhetvā sālil' ambucārī ",
  "snp1.3:28.3": "aggīva daḍḍhaṃ anivattamāno ",
  "snp1.3:28.4": "eko care . . . 63. Okkhitacakkhū ",
  "snp1.3:29.1": "na ca pādalolo ",
  "snp1.3:29.2": "guttindriyo rakkhitamānasāno ",
  "snp1.3:29.3": "amavassuto apariḍayhamāno ",
  "snp1.3:29.4": "eko care . . . 64. ",
  "snp1.3:30.1": "Ohārayitvā gihivyañjanāni ",
  "snp1.3:30.2": "saṃchinnapatto Yathā pārichatto| ",
  "snp1.3:30.3": "kāsāyavattho abhinikkhamitvā ",
  "snp1.3:30.4": "eko care . . . 65. ",
  "snp1.3:31.1": "Rasesu gedhaṃ akaraṃ alolo ",
  "snp1.3:31.2": "anaññaposī sapadānacārī ",
  "snp1.3:31.3": "kule kule appaṭibakkhacitto ",
  "snp1.3:31.4": "eko care . . . 66. ",
  "snp1.3:32.1": "Pahāya pañcāvaraṇāni cetaso ",
  "snp1.3:32.2": "upakkilese vyapanujja sabbe ",
  "snp1.3:32.3": "anissito chetvā sinebadosaṃ ",
  "snp1.3:32.4": "eko care . . . 67. ",
  "snp1.3:33.1": "Vipiṭṭhikatvāna sukhaṃ dukhañ ",
  "snp1.3:33.2": "ca pubbe va ca ",
  "snp1.3:33.3": "somanadomanassaṃ laddhān' upekhaṃ samathaṃ visuddhaṃ ",
  "snp1.3:33.4": "eko care . . . 68. ",
  "snp1.3:34.1": "Āraddhaviriyo paramatthapattiyā ",
  "snp1.3:34.2": "alīnacitto akusītavutti ",
  "snp1.3:34.3": "daḷhanikkamo thāmabalūpapanno ",
  "snp1.3:34.4": "eko care . . . 69. ",
  "snp1.3:35.1": "Paṭisallāṇaṃ jhānam ariñcamāno ",
  "snp1.3:35.2": "dhammesu niccaṃ anudhammacārī ",
  "snp1.3:35.3": "ādīnavaṃ sammasitā bhavesu ",
  "snp1.3:35.4": "eko care . . . 70. ",
  "snp1.3:36.1": "Taṇhakkhayaṃ patthayaṃ appamatto ",
  "snp1.3:36.2": "anelamūgo sutavā satīmā ",
  "snp1.3:36.3": "saṃkhātadhammo niyato padhānavā ",
  "snp1.3:36.4": "eko care . . . 71. ",
  "snp1.3:37.1": "Sīho va saddesu asantasanto ",
  "snp1.3:37.2": "vāto va jālamhi asajjamāno ",
  "snp1.3:37.3": "padumaṃ va toyena alippamāno ",
  "snp1.3:37.4": "eko care . . . 72. ",
  "snp1.3:38.1": "Sīho yathā dāṭhabalī pasayha ",
  "snp1.3:38.2": "rājā migānaṃ abhibhuyyacārī ",
  "snp1.3:38.3": "sevetha pantāni senāsanāni, ",
  "snp1.3:38.4": "eko care . . . 73. ",
  "snp1.3:39.1": "Mettaṃ upekhaṃ karuṇaṃ vimuttiṃ ",
  "snp1.3:39.2": "āsevamāno muditañ ca kāle ",
  "snp1.3:39.3": "sabbena lokena avirujjhamāno ",
  "snp1.3:39.4": "eko care . . . 74. ",
  "snp1.3:40.1": "Rāgañ ca dosañ ca pahāya mohaṃ ",
  "snp1.3:40.2": "sandālayitvā saṃyojanāni ",
  "snp1.3:40.3": "asantasaṃ jīvitasaṃkhayamhi ",
  "snp1.3:40.4": "eko care . . . 75. ",
  "snp1.3:41.1": "Bhajanti sevanti ca kāraṇatthā, ",
  "snp1.3:41.2": "nikkāraṇā dullabhā dullabhā ajja mittā, ",
  "snp1.3:41.3": "āttaṭṭhapaññā asucī manussā, -- ",
  "snp1.3:41.4": "eko care khaggavisāṇakappo ",
  "snp1.3:41.5": "ti Khaggavisāyasuttaṃ niṭṭhitaṃ. "
}
