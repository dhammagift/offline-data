{
  "snp1.9:0.1": "",
  "snp1.9:0.2": "",
  "snp1.9:1.1": "\"Ajja pannaraso uposatho, ",
  "snp1.9:1.2": "iti Sātāgiro yakkho ",
  "snp1.9:1.3": "divyā ratti upaṭṭhitā, ",
  "snp1.9:1.4": "anomanāmaṃ satthāraṃ ",
  "snp1.9:1.5": "handa passāma Gotamaṃ\". 154. ",
  "snp1.9:2.1": "\"Kacci mano supaṇihito ",
  "snp1.9:2.2": "iti Hemavato yakkho ",
  "snp1.9:2.3": "sabbabhūtesu tādino, ",
  "snp1.9:2.4": "kacci iṭṭhe aniṭṭhe ca ",
  "snp1.9:2.5": "saṃkapp' assa vasīkatā\". 155. ",
  "snp1.9:3.1": "\"Mano c' assa supaṇihito ",
  "snp1.9:3.2": "iti Sātāgiro yakkho ",
  "snp1.9:3.3": "sabbabhūtesu tādino, ",
  "snp1.9:3.4": "atho iṭṭhe aniṭṭhe ca ",
  "snp1.9:3.5": "saṃkapp' assa vasījatā\", 156. ",
  "snp1.9:4.1": "\"Kacci adinnaṃ nādiyati, ",
  "snp1.9:4.2": "iti Hemavato yakkho ",
  "snp1.9:4.3": "kacci pāṇesu saññato, ",
  "snp1.9:4.4": "kacci ārā pamādamhā, ",
  "snp1.9:4.5": "kacci jhānaṃ na riñcati\". 157. ",
  "snp1.9:5.1": "\"Na so adinnaṃ ādiyati, ",
  "snp1.9:5.2": "iti Sātāgiro yakkho ",
  "snp1.9:5.3": "atho pāṇesu saññato, ",
  "snp1.9:5.4": "atho ārā pamādamhā, ",
  "snp1.9:5.5": "Buddho jhānaṃ na riñcati\". 158. ",
  "snp1.9:6.1": "\"Kacci musā na bhaṇati,| ",
  "snp1.9:6.2": "iti Hemavato yakkho ",
  "snp1.9:6.3": "Kacci na khīṇavyappatho, ",
  "snp1.9:6.4": "Kacci vebhūtiyan nāha, ",
  "snp1.9:6.5": "kacci samphaṃ na bhāsati\". 159. ",
  "snp1.9:7.1": "\"Musā ca so na bhaṇati, ",
  "snp1.9:7.2": "iti Sātāgiro yakkho ",
  "snp1.9:7.3": "atho na khīṇavyappatho, ",
  "snp1.9:7.4": "atho vebhūtiyan nāha, ",
  "snp1.9:7.5": "mantā atthaṃ so bhāsati\". 160. ",
  "snp1.9:8.1": "\"Kacci na rajjati kāmesu, ",
  "snp1.9:8.2": "iti Hemavato yakkho ",
  "snp1.9:8.3": "kacci cittaṃ anāvilaṃ, ",
  "snp1.9:8.4": "kacci mohaṃ atikkanto, ",
  "snp1.9:8.5": "kacci dhammesu cakkhumā\". 161. ",
  "snp1.9:9.1": "\"Na so rajjati kāmesu, ",
  "snp1.9:9.2": "iti Sātāgiro yakkho ",
  "snp1.9:9.3": "atho cittaṃ anāvilaṃ, ",
  "snp1.9:9.4": "sabbamohaṃ atikkanto. ",
  "snp1.9:9.5": "Buddho dhammesu cakkhumā\". 162. ",
  "snp1.9:10.1": "\"Kacci vijjāya sampanno, ",
  "snp1.9:10.2": "iti Hemavato yakkho ",
  "snp1.9:10.3": "kacci saṃsuddhacāraṇo, ",
  "snp1.9:10.4": "kacci 'ssa āsavā khīṇā, ",
  "snp1.9:10.5": "kacci n' atthi punabbhavo\". 163. ",
  "snp1.9:11.1": "\"Vijjāya-m-eva sampanno, ",
  "snp1.9:11.2": "iti Sātāgiro yakkho ",
  "snp1.9:11.3": "atho saṃsuddhacāraṇo, ",
  "snp1.9:11.4": "sabb' assa āsavā khīṇā, ",
  "snp1.9:11.5": "n' atthi tassa punabbhavo. 163 A. ",
  "snp1.9:12.1": "Sampannaṃ munino cittaṃ ",
  "snp1.9:12.2": "kammanā vyappathena ca, ",
  "snp1.9:12.3": "vijjācaraṇasampannaṃ ",
  "snp1.9:12.4": "dhammato naṃ pasaṃsasi. 163 B. ",
  "snp1.9:13.1": "Sampannaṃ munino cittaṃ ",
  "snp1.9:13.2": "kammanā vyappathena ca, ",
  "snp1.9:13.3": "vijjācaraṇasampannaṃ ",
  "snp1.9:13.4": "dhammato anumodasi. 164. ",
  "snp1.9:14.1": "Sampannaṃ munino cittaṃ ",
  "snp1.9:14.2": "kammanā vyappathena ca, ",
  "snp1.9:14.3": "vijjācaraṇasampannaṃ ",
  "snp1.9:14.4": "handa passāma Gotamaṃ. 165. ",
  "snp1.9:15.1": "Eṇijaṃghaṃ kisaṃ dhīraṃ ",
  "snp1.9:15.2": "appāhāraṃ alolupaṃ ",
  "snp1.9:15.3": "muniṃ vanasmiṃ jhāyantaṃ ",
  "snp1.9:15.4": "ehi passāma Gotamaṃ. 166. ",
  "snp1.9:16.1": "Sīhaṃ v' ekacaraṃ nāgaṃ ",
  "snp1.9:16.2": "kāmesu anapekhinaṃ ",
  "snp1.9:16.3": "upasaṃkamma pucchāma ",
  "snp1.9:16.4": "maccupāsā pamocanaṃ. 167. ",
  "snp1.9:17.1": "Akkhātāraṃ pavattāraṃ ",
  "snp1.9:17.2": "sabbadhammāna pāraguṃ ",
  "snp1.9:17.3": "Buddhaṃ verabhayātītam ",
  "snp1.9:17.4": "mayaṃ pucchāma Gota- maṃ\", 168. ",
  "snp1.9:18.1": "\"Kismiṃ loko samuppanno, ",
  "snp1.9:18.2": "iti Hemavato yakkho ",
  "snp1.9:18.3": "kismiṃ kubbati santhavaṃ, ",
  "snp1.9:18.4": "kissa loko upādāya ",
  "snp1.9:18.5": "kismiṃ loko vihaññati\". 169. ",
  "snp1.9:19.1": "\"Chassu loko samuppanno, ",
  "snp1.9:19.2": "Hemavatā ti Bhagavā ",
  "snp1.9:19.3": "chassu kubbati santhavaṃ, ",
  "snp1.9:19.4": "channam eva upādāya ",
  "snp1.9:19.5": "chassu loko vihaññati\". 170. ",
  "snp1.9:20.1": "\"Kataman taṃ upādānaṃ, ",
  "snp1.9:20.2": "yattha loko vihaññati, ",
  "snp1.9:20.3": "niyyānaṃ pucchito brūhi: ",
  "snp1.9:20.4": "kathaṃ dukkhā pamuccati\". 171. ",
  "snp1.9:21.1": "\"Pañca kāmagunā loke ",
  "snp1.9:21.2": "manochaṭṭhā paveditā, ",
  "snp1.9:21.3": "ettha chandaṃ virājetvā ",
  "snp1.9:21.4": "evaṃ dukkhā pamuccati. 172. ",
  "snp1.9:22.1": "Etaṃ lokassa niyyānaṃ ",
  "snp1.9:22.2": "akkhātaṃ vo yathātathaṃ, ",
  "snp1.9:22.3": "etam vo aham akkhāmi: ",
  "snp1.9:22.4": "evaṃ dukkhā pamuccati\". 173. ",
  "snp1.9:23.1": "\"Ko sū 'dha taratī oghaṃ, ",
  "snp1.9:23.2": "ko 'dha tarati aṇṇavaṃ, ",
  "snp1.9:23.3": "appatiṭṭhe anālambe ",
  "snp1.9:23.4": "ko gambhīre na sīdati\". 174. ",
  "snp1.9:24.1": "\"Sabbadā sīlasampanno ",
  "snp1.9:24.2": "paññavā susamāhito ",
  "snp1.9:24.3": "ajjhattacintī satimā ",
  "snp1.9:24.4": "oghaṃ tarati duttaraṃ. 175. ",
  "snp1.9:25.1": "Virato kāmasaññya ",
  "snp1.9:25.2": "sabbasaṃyojanātigo ",
  "snp1.9:25.3": "nandībhavaparikkhīṇo, ",
  "snp1.9:25.4": "so gambhīre na sīdati\". 176. ",
  "snp1.9:26.1": "\"Gambhīrapaññaṃ nipuṇatthadassiṃ ",
  "snp1.9:26.2": "akiñcanaṃ kāmabhave asattaṃ ",
  "snp1.9:26.3": "taṃ passatha sabbadhi vippamuttaṃ ",
  "snp1.9:26.4": "dibbe pathe kamamānaṃ mahesiṃ. 177. ",
  "snp1.9:27.1": "Anomanāmaṃ nipuṇatthadassiṃ ",
  "snp1.9:27.2": "paññādadaṃ kāmālaye asattaṃ ",
  "snp1.9:27.3": "taṃ passatha sabbaviduṃ sumedhaṃ ",
  "snp1.9:27.4": "ariye pathe kamamānaṃ mahesiṃ. 178. ",
  "snp1.9:28.1": "Suddiṭṭhaṃ vata no ajja ",
  "snp1.9:28.2": "suppabhātaṃ suhuṭṭhitaṃ, ",
  "snp1.9:28.3": "yaṃ addasāma Sambuddhaṃ ",
  "snp1.9:28.4": "oghatiṇṇam anāsavaṃ. 179. ",
  "snp1.9:29.1": "Ime dasasatā yakkhā ",
  "snp1.9:29.2": "iddhimanto yasassino ",
  "snp1.9:29.3": "sabbe taṃ saraṇaṃ yanti, ",
  "snp1.9:29.4": "tvan no satthā anuttaro. 180. ",
  "snp1.9:30.1": "Te mayaṃ vicarissāma ",
  "snp1.9:30.2": "gāmā gāmaṃ nagā nagaṃ ",
  "snp1.9:30.3": "namassamānā Sambuddhaṃ ",
  "snp1.9:30.4": "dhammassa ca sudhammatan\" ti ",
  "snp1.9:30.5": "Hemavatasuttaṃ niṭṭhitaṃ. "
}
