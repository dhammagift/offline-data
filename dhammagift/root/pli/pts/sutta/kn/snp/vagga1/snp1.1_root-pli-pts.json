{
  "snp1.1:0.1": "",
  "snp1.1:0.2": "",
  "snp1.1:1.1": "1. Yo uppatitaṃ vineti kodhaṃ ",
  "snp1.1:1.2": "visataṃ sappavisaṃ va osadhehi, ",
  "snp1.1:1.3": "so bhikkhu jahāti orapāraṃ ",
  "snp1.1:1.4": "urago jiṇṇam iva tacaṃ purāṇaṃ. 2. ",
  "snp1.1:2.1": "Yo rāgam udacchidā asesa ",
  "snp1.1:2.2": "bhisapupphaṃ va saroruhaṃ vigayha, ",
  "snp1.1:2.3": "so bhikkhu . . . 3. ",
  "snp1.1:2.4": "",
  "snp1.1:3.1": "Yo taṇham udacchidā asesaṃ ",
  "snp1.1:3.2": "saritaṃ sīghasaraṃ visosayitvā, ",
  "snp1.1:3.3": "so bhikkhu . . . 4. ",
  "snp1.1:3.4": "",
  "snp1.1:4.1": "Yo mānam udabbadhī asesaṃ ",
  "snp1.1:4.2": "naḷasetuṃ va sudubbalaṃ mahogho, ",
  "snp1.1:4.3": "so bhikkhu . . . 5. ",
  "snp1.1:4.4": "",
  "snp1.1:5.1": "Yo najjhagamā bhavesu sāraṃ ",
  "snp1.1:5.2": "vicinaṃ puppham iva udumbaresu, ",
  "snp1.1:5.3": "so bhikkhu . . . 6. ",
  "snp1.1:5.4": "",
  "snp1.1:6.1": "Yass' antarato na santi kopa ",
  "snp1.1:6.2": "itibhavābhavatañ ca vītivatto, ",
  "snp1.1:6.3": "so bhikkhu . . . 7. ",
  "snp1.1:6.4": "",
  "snp1.1:7.1": "Yassa vitakkā vidhūpitā ",
  "snp1.1:7.2": "ajjhattaṃ suvikappitā asesā, ",
  "snp1.1:7.3": "so bhikkhu . . . 8. ",
  "snp1.1:7.4": "",
  "snp1.1:8.1": "Yo nāccasārī na paccasārī ",
  "snp1.1:8.2": "sabbaṃ accagamā imaṃ papañcaṃ, ",
  "snp1.1:8.3": "so bhikkhu . . . 9. ",
  "snp1.1:8.4": "",
  "snp1.1:9.1": "Yo nāccasārī na paccasārī ",
  "snp1.1:9.2": "‘sabbam vitatham idan' ti ñatvā loke, ",
  "snp1.1:9.3": "so bhikkhu . . . 10. ",
  "snp1.1:9.4": "",
  "snp1.1:10.1": "Yo nāccasārī na paccasārī ",
  "snp1.1:10.2": "‘sabbaṃ vitatham idan' ti vītalobho, ",
  "snp1.1:10.3": "so bhikkhu . . . 11. ",
  "snp1.1:10.4": "",
  "snp1.1:11.1": "Yo nāccasārī na paccasārī ",
  "snp1.1:11.2": "‘sabbaṃ vitatham idan' ti vītarāgo, ",
  "snp1.1:11.3": "so bhikkhu . . . 12. ",
  "snp1.1:11.4": "",
  "snp1.1:12.1": "Yo nāccasārī na paccasārī ",
  "snp1.1:12.2": "‘sabbaṃ vitatham idan' ti vītadoso, ",
  "snp1.1:12.3": "so bhikkhu . . . 13. ",
  "snp1.1:12.4": "",
  "snp1.1:13.1": "Yo nāccasārī na paccasārī ",
  "snp1.1:13.2": "‘sabbaṃ vitatham idan' ti vītamoho, ",
  "snp1.1:13.3": "so bhikkhu . . . 14. ",
  "snp1.1:13.4": "",
  "snp1.1:14.1": "Yassānusayā na santi keci, ",
  "snp1.1:14.2": "mūlā akusalā samūhatāse, ",
  "snp1.1:14.3": "so bhikkhu . . . 15. ",
  "snp1.1:14.4": "",
  "snp1.1:15.1": "Yassa darathajā na santi keci ",
  "snp1.1:15.2": "oraṃ āgamanāya paccayāse, ",
  "snp1.1:15.3": "so bhikkhu . . . 16. ",
  "snp1.1:15.4": "",
  "snp1.1:16.1": "Yassa vanathajā na santi keci ",
  "snp1.1:16.2": "vinibandhāya bhavāya hetukappā, ",
  "snp1.1:16.3": "so bhikkhu . . . 17. ",
  "snp1.1:16.4": "",
  "snp1.1:17.1": "Yo nīvaraṇe pahāya pañca ",
  "snp1.1:17.2": "anigho tiṇṇakathaṃkatho visallo, ",
  "snp1.1:17.3": "so bhikkhu jahāti orapāraṃ ",
  "snp1.1:17.4": "urago jiṇṇam iva tacaṃ purāṇan ti ",
  "snp1.1:17.5": "URAGASUTTAṂ NIṬṬHITAṂ. 18. "
}
