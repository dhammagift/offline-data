{
  "snp3.8:0.1": "",
  "snp3.8:0.2": "",
  "snp3.8:1.1": "",
  "snp3.8:1.2": "maccānaṃ idha jīvitaṃ ",
  "snp3.8:1.3": "kasirañ ca parittañ ca, ",
  "snp3.8:1.4": "tañ ca dukkhena saññutaṃ. 575. ",
  "snp3.8:2.1": "Na hi so upakkamo atthi, ",
  "snp3.8:2.2": "yena jātā na miyyare, ",
  "snp3.8:2.3": "jaram pi patvā maraṇaṃ, ",
  "snp3.8:2.4": "evaṃdhammā hi pāṇino. 576. ",
  "snp3.8:3.1": "Phalānam iva pakkānaṃ ",
  "snp3.8:3.2": "pāto papatanā bhayaṃ, ",
  "snp3.8:3.3": "evaṃ jātānaṃ maccānaṃ ",
  "snp3.8:3.4": "niccaṃ maraṇato bhayaṃ. 577. ",
  "snp3.8:4.1": "Yathā pi kumbhakārassa ",
  "snp3.8:4.2": "katā mattikabhājanā ",
  "snp3.8:4.3": "sabbe bhedanapariyantā, ",
  "snp3.8:4.4": "evam maccāna jīvitaṃ. 578. ",
  "snp3.8:5.1": "Daharā ca mahantā ca ",
  "snp3.8:5.2": "ye bālā ye ca paṇḍitā ",
  "snp3.8:5.3": "sabbe maccuvasaṃ yanti, ",
  "snp3.8:5.4": "sabbe maccuparāyanā. 579. ",
  "snp3.8:6.1": "Tesaṃ maccuparetānaṃ ",
  "snp3.8:6.2": "gacchataṃ paralokato ",
  "snp3.8:6.3": "na pitā tāyate puttaṃ ",
  "snp3.8:6.4": "ñātī vā pana ñātake. 580. ",
  "snp3.8:7.1": "Pekkhataṃ yeva ñātīnaṃ ",
  "snp3.8:7.2": "passa lālapataṃ puthu ",
  "snp3.8:7.3": "ekameko va maccānaṃ ",
  "snp3.8:7.4": "go vajjho viya niyyati. 581. ",
  "snp3.8:8.1": "Evam abbhāhato loko ",
  "snp3.8:8.2": "maccunā ca jarāya ca, -- ",
  "snp3.8:8.3": "tasmā dhīrā na socanti ",
  "snp3.8:8.4": "viditvā lokapariyāyaṃ. 582. ",
  "snp3.8:9.1": "Yassa maggaṃ na jānāsi ",
  "snp3.8:9.2": "āgatassa gatassa vā, ",
  "snp3.8:9.3": "ubho ante asampassaṃ ",
  "snp3.8:9.4": "niratthaṃ paridevasi. 583. ",
  "snp3.8:10.1": "Paridevayamāno ce ",
  "snp3.8:10.2": "kañcid atthaṃ udabbahe ",
  "snp3.8:10.3": "sammūḷho hiṃsam attānaṃ, ",
  "snp3.8:10.4": "kayira c' enaṃ vicakkhaṇo. 584. ",
  "snp3.8:11.1": "Na hi raṇṇena sokena ",
  "snp3.8:11.2": "santiṃ pappoti cetaso, ",
  "snp3.8:11.3": "bhiyy' ass' uppajjate dukkhaṃ, ",
  "snp3.8:11.4": "sarīraṃ upahaññati, 585. ",
  "snp3.8:12.1": "kiso vivaṇṇo bhavati ",
  "snp3.8:12.2": "hiṃsam attānam attanā: ",
  "snp3.8:12.3": "na tena petā pālenti, ",
  "snp3.8:12.4": "niratthā paridevanā. 586. ",
  "snp3.8:13.1": "Sokam appajahaṃ jantu ",
  "snp3.8:13.2": "bhiyyo dukkhaṃ nigacchati, ",
  "snp3.8:13.3": "anutthuṇanto kālakataṃ ",
  "snp3.8:13.4": "sokassa vasam anvagū. 587. ",
  "snp3.8:14.1": "Aññe pi passa gamine ",
  "snp3.8:14.2": "yathākammūpage nare ",
  "snp3.8:14.3": "maccuno vasam āgamma ",
  "snp3.8:14.4": "phandante v' idha pāṇine. 588. ",
  "snp3.8:15.1": "Yena yena hi maññanti, ",
  "snp3.8:15.2": "tato taṃ hoti aññathā, -- ",
  "snp3.8:15.3": "etādiso vinābhāvo, ",
  "snp3.8:15.4": "passa lokassa pariyāyaṃ: 589. ",
  "snp3.8:16.1": "api ce vassasataṃ jīve ",
  "snp3.8:16.2": "bhiyyo vā pana mānavo, ",
  "snp3.8:16.3": "ñātisaṃghā vinā hoti, ",
  "snp3.8:16.4": "jahāti idha jīvitaṃ. 590. ",
  "snp3.8:17.1": "Tasmā arahato sutvā ",
  "snp3.8:17.2": "vineyya paridevitaṃ ",
  "snp3.8:17.3": "petaṃ kālakataṃ disvā ",
  "snp3.8:17.4": "‘na so labbhā mayā' iti. 591. ",
  "snp3.8:18.1": "Yathā saraṇam ādittaṃ ",
  "snp3.8:18.2": "vārinā parinibbaye, ",
  "snp3.8:18.3": "evam pi dhīro sappañño ",
  "snp3.8:18.4": "paṇḍito kusalo naro ",
  "snp3.8:18.5": "khippam uppatitaṃ sokaṃ ",
  "snp3.8:18.6": "vāto tūlaṃ va dhaṃsaye 592. ",
  "snp3.8:19.1": "paridevaṃ pajappañ ca ",
  "snp3.8:19.2": "domanassañ ca attano: ",
  "snp3.8:19.3": "attano sukham esāno ",
  "snp3.8:19.4": "abbahe sallam attano. 593. ",
  "snp3.8:20.1": "Abbūḷhasallo asito ",
  "snp3.8:20.2": "santiṃ pappuyya cetaso, ",
  "snp3.8:20.3": "sabbasokaṃ atikkanto ",
  "snp3.8:20.4": "asoko hoti nibbuto ti ",
  "snp3.8:20.5": "SALLASUTTAṂ NIṬṬHITAṂ. 9. Vāseṭṭhadutta. "
}
