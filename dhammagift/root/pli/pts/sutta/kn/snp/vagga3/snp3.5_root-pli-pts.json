{
  "snp3.5:0.1": "",
  "snp3.5:0.2": "",
  "snp3.5:1.1": "Evam me sutaṃ: ",
  "snp3.5:1.2": "Ekaṃ samayaṃ Bhagavā Rājagahe viharati Gijjhakūṭe pabbate. ",
  "snp3.5:1.3": "Atha kho Māgho māṇavo yena Bhagavā ten' upasaṃkami, upasaṃkamitvā Bhagavatā saddhiṃ sammodi, ",
  "snp3.5:1.4": "sammodanīyaṃ kathaṃ sārāṇīyaṃ vitisāretvā ekamantaṃ nisīdi. ",
  "snp3.5:1.5": "Ekamantaṃ nisinno kho Māgho māṇavo Bhagavantaṃ etad avoca: \"ahaṃ ",
  "snp3.5:2.1": "hi bho Gotama dāyako dānapati vadaññū yācayogo, ",
  "snp3.5:2.2": "dhammena bhoge pariyesāmi, ",
  "snp3.5:2.3": "dhammena bhoge pariyesitvā dhammaladdhehi bhogehi dhammādhigatehi ekassa pi dadāmi, dvinnam pi dadāmi, tiṇṇam pi dadāmi, catunnam pi dadāmi, pañcannam pi dadāmi, channam pi dadāmi, sattannam pi dadāmi, aṭṭhannam pi dadāmi, navannam pi dadāmi, dasannam pi dadāmi, vīsāya pi dadāmi, tiṃsāya pi dadāmi, cattārīsāya pi dadāmi (paññāsāya pi dadāmi), satassa pi dadāmi, bhiyyo pi dadāmi, -- ",
  "snp3.5:2.4": "kaccāhaṃ bho Gotama evaṃ dadanto evaṃ yajanto bahuṃ puññaṃ pasavāmī\" ti. ",
  "snp3.5:3.1": "\"Taggha tvaṃ mānava evaṃ dadanto evaṃ yajanto bahuṃ puññam pasavasi, ",
  "snp3.5:3.2": "yo kho māṇava dāyako kānapati vadaññū yācayogo ",
  "snp3.5:3.3": "dhammena bhoge pariyesati ",
  "snp3.5:3.4": "dhammena bhoge pariyesitvā dhammaladdhehi bhogehi dhammādhigatehi ekassa pi dadāti-pe-satassa pi dadāti bhiyyo pi dadāti, bahuṃ so puññaṃ pasavatī\" ti. ",
  "snp3.5:3.5": "Atha kho Māgho māṇavo Bhagavantaṃ gāthāya ajjhabhāsi: 487. ",
  "snp3.5:4.1": "\"Pucchām' aham bho Gotamaṃ vadaññuṃ ",
  "snp3.5:4.2": "iti Māgho māṇavo ",
  "snp3.5:4.3": "kāsāyavāsiṃ agihaṃ carantaṃ: ",
  "snp3.5:4.4": "yo yācayogo dānapatī gahaṭṭho ",
  "snp3.5:4.5": "puññatthiko yajati puññapekho| ",
  "snp3.5:4.6": "dadaṃ paresaṃ idha annapānaṃ, ",
  "snp3.5:4.7": "kattha hutaṃ yajamānassa sujjhe\". 488. ",
  "snp3.5:5.1": "\"Yo yācayogo dānapatī gahaṭṭho ",
  "snp3.5:5.2": "Māghā ti Bhagavā ",
  "snp3.5:5.3": "puññatthiko yajati puññapekho ",
  "snp3.5:5.4": "dadaṃ paresaṃ idha annapānaṃ, ",
  "snp3.5:5.5": "ārādhaye dakkhiṇeyyehi tādi\". 489. ",
  "snp3.5:6.1": "\"Yo yācayogo dānapatī gahaṭṭho ",
  "snp3.5:6.2": "iti (Māgho) māṇavo ",
  "snp3.5:6.3": "puññatthiko yajati puññapekho ",
  "snp3.5:6.4": "dadaṃ paresaṃ idha annapānaṃ, -- ",
  "snp3.5:6.5": "akkhāhi me Bhagavā dakkhiṇeyye\". 490. ",
  "snp3.5:7.1": "\"Ye ve asattā vicaranti loke ",
  "snp3.5:7.2": "akiñcanā kevalino yatattā, ",
  "snp3.5:7.3": "kālena tesu havyaṃ pavecche, ",
  "snp3.5:7.4": "yo brāhmaṇo puññapekho yajetha. 491. ",
  "snp3.5:8.1": "Ye sabbasaṃyojanabandhanacchidā ",
  "snp3.5:8.2": "dantā vimuttā anighā nirāsā, ",
  "snp3.5:8.3": "kālena tesu havyaṃ pavecche, ",
  "snp3.5:8.4": "yo brāhmaṇo puññapekho yajetha. 492. ",
  "snp3.5:9.1": "Ye sabbasaṃyojanavippamuttā ",
  "snp3.5:9.2": "dantā vimuttā anighā nirāsā, ",
  "snp3.5:9.3": "kālena ",
  "snp3.5:9.4": "--pe--. 493. ",
  "snp3.5:10.1": "Rāgañ ca dosañ ca pahāya mohaṃ ",
  "snp3.5:10.2": "khīṇāsavā vusitabrahmacariyā, ",
  "snp3.5:10.3": "kālena . . . 494. ",
  "snp3.5:10.4": "",
  "snp3.5:11.1": "Yesu na māyā vasatī na māno,| ",
  "snp3.5:11.2": "",
  "snp3.5:11.3": "",
  "snp3.5:11.4": "",
  "snp3.5:12.1": "ye vītalobhā amamā nirāsā, ",
  "snp3.5:12.2": "",
  "snp3.5:12.3": "kālena . . . 495. ",
  "snp3.5:12.4": "",
  "snp3.5:13.1": "Ye ve na taṇhāsu upātipannā ",
  "snp3.5:13.2": "vitareyya oghaṃ amamā caranti, ",
  "snp3.5:13.3": "kālena . . . 496. Yesan ",
  "snp3.5:13.4": "tu ",
  "snp3.5:14.1": "taṇhā n' atthi kuhiñci loke ",
  "snp3.5:14.2": "bhavābhavāya idha vā huraṃ vā, ",
  "snp3.5:14.3": "kālena . . . 497. ",
  "snp3.5:14.4": "",
  "snp3.5:15.1": "Ye kāme hitvā agihā caranti ",
  "snp3.5:15.2": "susaññatattā tasaraṃ va ujju, ",
  "snp3.5:15.3": "kālena . . . 498. ",
  "snp3.5:15.4": "",
  "snp3.5:16.1": "Ye vītarāgā susamāhitindriyā ",
  "snp3.5:16.2": "cando va Rāhu-gahaṇā pamuttā, ",
  "snp3.5:16.3": "kālena . . . 499. ",
  "snp3.5:16.4": "",
  "snp3.5:17.1": "Samitāvino vītarāgā akopā, ",
  "snp3.5:17.2": "yesaṅ gatī n' atthi idha vippahāya, ",
  "snp3.5:17.3": "kālena . . . 500. Jahetvā ",
  "snp3.5:17.4": "",
  "snp3.5:18.1": "jātimaraṇaṃ asesaṃ ",
  "snp3.5:18.2": "kathaṃkathaṃ sabbam upātivattā, ",
  "snp3.5:18.3": "kālena . . . 501. ",
  "snp3.5:18.4": "",
  "snp3.5:19.1": "Ye attadīpā vicaranti loke ",
  "snp3.5:19.2": "akiñcanā sabbadhi vippamuttā, ",
  "snp3.5:19.3": "kālena . . . 502. ",
  "snp3.5:19.4": "",
  "snp3.5:20.1": "Ye h' ettha jānanti yathātathā idaṃ: ",
  "snp3.5:20.2": "‘ayam antimā, n' atthi punabbhavo' ti, ",
  "snp3.5:20.3": "kālena . . . 503. ",
  "snp3.5:20.4": "",
  "snp3.5:21.1": "Yo vedagū jhānarato satīmā ",
  "snp3.5:21.2": "sambodhipatto saraṇaṃ bahunnaṃ, ",
  "snp3.5:21.3": "kālena tamhi havyaṃ pavecche, ",
  "snp3.5:21.4": "yo brāhmaṇo puññapekho yajetha\". 504. ",
  "snp3.5:22.1": "\"Addhā amoghā mama pucchanā ahū, ",
  "snp3.5:22.2": "",
  "snp3.5:22.3": "akkhāsi me Bhagavā dakkhineyye, ",
  "snp3.5:22.4": "tvaṃ h' ettha jānāsi yathātathā idaṃ, ",
  "snp3.5:22.5": "tathā hi te vidito esa dhammo\". 505. ",
  "snp3.5:23.1": "\"Yo yācayogo dānapatī gahaṭṭho ",
  "snp3.5:23.2": "iti Māgho māṇavo puññatthiko yajati puññapekho ",
  "snp3.5:23.3": "dadaṃ paresaṃ idha annapānaṃ, -- ",
  "snp3.5:23.4": "akkhāhi me Bhagavā yaññasampadaṃ\". 506. ",
  "snp3.5:24.1": "\"Yajassu, yajamāno ",
  "snp3.5:24.2": "Māghā ti Bhagavā ",
  "snp3.5:24.3": "sabbattha vippasādehi cittaṃ: ",
  "snp3.5:24.4": "ārammaṇaṃ yajamānassa yaññaṃ, ",
  "snp3.5:24.5": "ettha patiṭṭhāya jahāti dosaṃ. 507. ",
  "snp3.5:25.1": "So vītarāgo pavineyya dosaṃ ",
  "snp3.5:25.2": "mettaṃ cittaṃ bhāvayaṃ appamāṇaṃ ",
  "snp3.5:25.3": "rattiṃdivaṃ satataṃ appamatto ",
  "snp3.5:25.4": "sabbā disā pharate appamaññaṃ\". 508. ",
  "snp3.5:26.1": "\"Ko sujjhati muccati bajjhatī ca, ",
  "snp3.5:26.2": "ken' attanā gacchati Brahmalokaṃ, ",
  "snp3.5:26.3": "ajānato me muni brūhi puṭṭho, ",
  "snp3.5:26.4": "Bhagavāhi me sakkhi Brahm' ajja diṭṭho,| tvaṃ ",
  "snp3.5:26.5": "hi no Brahmasamo ti saccaṃ: ",
  "snp3.5:26.6": "kathaṃ upapajjati Brahmalokaṃ jutīmā\". 509. ",
  "snp3.5:27.1": "\"Yo yajati tividhaṃ yaññasampadaṃ, ",
  "snp3.5:27.2": "Māghā ti Bhagavā ",
  "snp3.5:27.3": "ārādhavye dakkhiṇeyyehi tādi, ",
  "snp3.5:27.4": "evaṃ yajitvā sammā yācayogo ",
  "snp3.5:27.5": "upapajjati Brahmalokan ti brūmī\" ti. ",
  "snp3.5:28.1": "Evaṃ vutte Māgho māṇavo Bhagavantaṃ etad avoca: ",
  "snp3.5:28.2": "\"abhikkantaṃ bho Gotama --pe-- ",
  "snp3.5:28.3": "ajjatagge pāṇupetaṃ saraṇaṃ gatan\" ti ",
  "snp3.5:28.4": "MĀGHASUTTAṂ NIṬṬHITAṂ. "
}
