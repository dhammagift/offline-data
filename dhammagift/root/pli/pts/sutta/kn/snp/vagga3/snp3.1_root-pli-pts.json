{
  "snp3.1:0.1": "",
  "snp3.1:0.2": "",
  "snp3.1:1.1": "Pabbajjaṃ kittayissāmi, ",
  "snp3.1:1.2": "yathā pabbaji cakkhumā, ",
  "snp3.1:1.3": "yathā vīmaṃsamāno so ",
  "snp3.1:1.4": "pabbajjaṃ samarocayi, 406. ",
  "snp3.1:2.1": "‘Sambādho 'yaṃ gharāvāso ",
  "snp3.1:2.2": "rajassāyatanam' iti ",
  "snp3.1:2.3": "‘abbhokāso ca pabbajjā' ",
  "snp3.1:2.4": "iti disvāna pabbaji, 407. ",
  "snp3.1:3.1": "pabbajitvāna kāyena ",
  "snp3.1:3.2": "pāpakammaṃ vivajjayi ",
  "snp3.1:3.3": "vacīduccaritaṃ hitvā ",
  "snp3.1:3.4": "ājīvaṃ parisodhayi. 408. ",
  "snp3.1:4.1": "Agamā Rājagahaṃ Buddho ",
  "snp3.1:4.2": "Magadhānaṃ Giribbajaṃ, ",
  "snp3.1:4.3": "piṇḍāya abhihāresi ",
  "snp3.1:4.4": "ākiṇṇavaralakkhaṇo. 409. ",
  "snp3.1:5.1": "Tam addasā Bimbisāro ",
  "snp3.1:5.2": "pāsādasmiṃ patiṭṭhito, ",
  "snp3.1:5.3": "disvā lakkhaṇasampannaṃ ",
  "snp3.1:5.4": "imam atthaṃ abhāsatha: 410. ",
  "snp3.1:6.1": "\"Imaṃ bhonto nisāmetha: ",
  "snp3.1:6.2": "abhirūpo brahā suci ",
  "snp3.1:6.3": "caraṇena c' eva sampanno, yugamattañ ca ",
  "snp3.1:6.4": "pekkhati 411. ",
  "snp3.1:7.1": "okkhittacakkhu satimā, ",
  "snp3.1:7.2": "nāyaṃ nīcakulā-m-iva. Rājadūtā ",
  "snp3.1:7.3": "vidhāvantu, ",
  "snp3.1:7.4": "kuhiṃ bhikkhu gamissati\". 412. ",
  "snp3.1:8.1": "Te pesitā rājadūtā ",
  "snp3.1:8.2": "piṭṭhito anubandhisuṃ: ",
  "snp3.1:8.3": "‘kuhiṃ gamissati bhikkhu, ",
  "snp3.1:8.4": "katthavāso bhavissati.' 413. ",
  "snp3.1:9.1": "Sapadānañ caramāno ",
  "snp3.1:9.2": "guttadvāro susaṃvuto ",
  "snp3.1:9.3": "khippaṃ pattaṃ apūresi ",
  "snp3.1:9.4": "sampajāno patissato. 414. Sa ",
  "snp3.1:10.1": "piṇḍacāraṃ caritvā ",
  "snp3.1:10.2": "nikkhamma nagarā muni ",
  "snp3.1:10.3": "Paṇḍavaṃ abhihāresi, ",
  "snp3.1:10.4": "etthavāso bhavissati. 415. ",
  "snp3.1:11.1": "Disvāna vāsūpagataṃ ",
  "snp3.1:11.2": "tato dūtā upāvisuṃ, ",
  "snp3.1:11.3": "eko ca dūto āgantvā ",
  "snp3.1:11.4": "rājino paṭivedayi: 416. ",
  "snp3.1:12.1": "\"Esa bhikkhu mahārāja ",
  "snp3.1:12.2": "Paṇḍavassa puratthato ",
  "snp3.1:12.3": "nisinno vyagghusabho va ",
  "snp3.1:12.4": "sīho va girigabbhare\". 417. ",
  "snp3.1:13.1": "Sutvāna dūtavacanaṃ ",
  "snp3.1:13.2": "bhaddayānena khattiyo ",
  "snp3.1:13.3": "taramānarūpo niyyāsi ",
  "snp3.1:13.4": "yena Paṇḍavapabbato. 418. ",
  "snp3.1:14.1": "Sa yānabhūmiṃ yāyitvā ",
  "snp3.1:14.2": "yānā oruyha khattiyo ",
  "snp3.1:14.3": "pattiko upasaṃkamma ",
  "snp3.1:14.4": "āsajja naṃ upāvisi. 419. ",
  "snp3.1:15.1": "Nisajja rājā sammodi ",
  "snp3.1:15.2": "kathaṃ sārāṇiyaṃ tato, ",
  "snp3.1:15.3": "kathaṃ so vītisāretvā ",
  "snp3.1:15.4": "imam atthaṃ abhāsatha: 420. ",
  "snp3.1:16.1": "\"Yuvā ca daharo cāsi ",
  "snp3.1:16.2": "paṭhamuppattiko susu ",
  "snp3.1:16.3": "vaṇṇārohena sampanno ",
  "snp3.1:16.4": "jātimā viya khattiyo 421. ",
  "snp3.1:17.1": "sobhayanto anīkaggaṃ ",
  "snp3.1:17.2": "nāgasaṃghapurakkhato, ",
  "snp3.1:17.3": "dadāmi bhoge, bhuñjassu, ",
  "snp3.1:17.4": "jātiṃ c' akkhāhi 422. ",
  "snp3.1:18.1": "\"Ujuṃ janapado rāja ",
  "snp3.1:18.2": "Himavantassa passato ",
  "snp3.1:18.3": "dhanaviriyena sampanno ",
  "snp3.1:18.4": "Kosalesu niketino. 423. ",
  "snp3.1:19.1": "Ādiccā nāma gottena, ",
  "snp3.1:19.2": "Sākiyā nāma jātiyā, ",
  "snp3.1:19.3": "tamhā kulā pabbajito 'mhi rāja ",
  "snp3.1:19.4": "na kāme abhipatthayaṃ -- 424. ",
  "snp3.1:20.1": "Kāmesv-ādīnavaṃ disvā ",
  "snp3.1:20.2": "nekkhammaṃ daṭṭhu khemato ",
  "snp3.1:20.3": "padhānāya gamissāmi, ",
  "snp3.1:20.4": "ettha me rañjatī mano\" ti ",
  "snp3.1:20.5": "PABBAJJĀSUTTAṂ NIṬṬHITAṂ. 425. "
}
