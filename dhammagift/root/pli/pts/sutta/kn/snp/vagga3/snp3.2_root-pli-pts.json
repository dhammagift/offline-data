{
  "snp3.2:0.1": "",
  "snp3.2:0.2": "",
  "snp3.2:1.1": "Tam maṃ padhānapahitattaṃ ",
  "snp3.2:1.2": "nadiṃ Nerañjaram pati ",
  "snp3.2:1.3": "viparakkamma jhāyantaṃ ",
  "snp3.2:1.4": "yogakkhemassa pattiyā 426. ",
  "snp3.2:2.1": "Namucī karuṇaṃ vācaṃ ",
  "snp3.2:2.2": "bhāsamāno upāgami: ",
  "snp3.2:2.3": "\"kiso tvam asi dubbaṇṇo, ",
  "snp3.2:2.4": "santike maraṇan tava. 427. ",
  "snp3.2:3.1": "Sahassabhāgo maraṇassa, ",
  "snp3.2:3.2": "ekaṃso tava jīvitaṃ, ",
  "snp3.2:3.3": "jīva bho, jīvitaṃ seyyo, ",
  "snp3.2:3.4": "jīvaṃ puññāni kāhasi. 428. ",
  "snp3.2:4.1": "Carato ca te brahmacariyaṃ ",
  "snp3.2:4.2": "aggihuttañ ca jūhato ",
  "snp3.2:4.3": "pahūtaṃ cīyate puññaṃ, ",
  "snp3.2:4.4": "kiṃ padhānena kāhasi. 429. ",
  "snp3.2:5.1": "Duggo maggo padhānāya ",
  "snp3.2:5.2": "dukkaro durabhisambhavo\", ",
  "snp3.2:5.3": "imā gāthā bhaṇaṃ Māro ",
  "snp3.2:5.4": "aṭṭhā Buddhassa santike. 430. ",
  "snp3.2:6.1": "Taṃ tathāvādinaṃ Māraṃ ",
  "snp3.2:6.2": "Bhagavā etad abravi: ",
  "snp3.2:6.3": "\"pamattabandhu pāpimā, ",
  "snp3.2:6.4": "yen' atthena idhāgato , 431. ",
  "snp3.2:7.1": "aṇumattena pi puññena ",
  "snp3.2:7.2": "attho mayhaṃ na vijjati, ",
  "snp3.2:7.3": "yesañ ca attho puññānaṃ, ",
  "snp3.2:7.4": "te Māro vattum arahati. 432. ",
  "snp3.2:8.1": "Atthi saddhā tato viriyaṃ, ",
  "snp3.2:8.2": "paññā ca mama vijjati , ",
  "snp3.2:8.3": "evaṃ maṃ pahitattaṃ (pi) ",
  "snp3.2:8.4": "kiṃ jīvam anupucchasi. 433. ",
  "snp3.2:9.1": "Nadīnam api sotāni ",
  "snp3.2:9.2": "ayaṃ vāto visosaye, ",
  "snp3.2:9.3": "kiñ ca me pahitattassa ",
  "snp3.2:9.4": "lohitaṃ nūpasussaye. 434. ",
  "snp3.2:10.1": "Lohite sussamānamhi ",
  "snp3.2:10.2": "pittaṃ semhañ ca sussati, ",
  "snp3.2:10.3": "maṃsesu khīyamānesu ",
  "snp3.2:10.4": "bhiyyo cittaṃ pasīdati, ",
  "snp3.2:10.5": "bhiyyo sati ca paññā ca ",
  "snp3.2:10.6": "samādhi mama tiṭṭhati. 435. ",
  "snp3.2:11.1": "Tassa m' evaṃ viharato ",
  "snp3.2:11.2": "pattass' uttamavedanaṃ ",
  "snp3.2:11.3": "kāmesu nāpekhate cittaṃ, ",
  "snp3.2:11.4": "passa sattassa suddhatam. 436. ",
  "snp3.2:12.1": "Kāmā te paṭhamā senā, ",
  "snp3.2:12.2": "dutiyā arati vuccati, ",
  "snp3.2:12.3": "tatiyā khuppipāsā te, ",
  "snp3.2:12.4": "catutthī taṇhā pavuccati, 437. ",
  "snp3.2:13.1": "pañcamī thīnamiddhaṃ te, ",
  "snp3.2:13.2": "chaṭṭhā bhīrū pavuccati, ",
  "snp3.2:13.3": "sattamī vicikicchā te, ",
  "snp3.2:13.4": "makkho thambho te aṭṭhamo, 438. ",
  "snp3.2:14.1": "lābho siloko sakkāro ",
  "snp3.2:14.2": "micchāladdho ca yo yaso, ",
  "snp3.2:14.3": "yo c' attānaṃ samukkaṃse ",
  "snp3.2:14.4": "pare ca avajānati, 439. ",
  "snp3.2:15.1": "esa Namuci te senā ",
  "snp3.2:15.2": "Kaṇhassābhippahāraṇī, ",
  "snp3.2:15.3": "na naṃ arūro jināti, ",
  "snp3.2:15.4": "jetvā ca labhate sukhaṃ. 440. ",
  "snp3.2:16.1": "Esa muñjaṃ parihare, ",
  "snp3.2:16.2": "dhi-r-atthu idha jīvitaṃ, ",
  "snp3.2:16.3": "saṅgāme me mataṃ seyyo, ",
  "snp3.2:16.4": "yañce jīve parājito. 441. ",
  "snp3.2:17.1": "Pagāḷhā ettha na dissanti ",
  "snp3.2:17.2": "eke samaṇabrāhmaṇā, ",
  "snp3.2:17.3": "tañ ca maggaṃ na jānanti, ",
  "snp3.2:17.4": "yena gacchanti subbatā. 442. ",
  "snp3.2:18.1": "Samantā dhajiniṃ disvā ",
  "snp3.2:18.2": "yuttaṃ Māraṃ savāhanaṃ ",
  "snp3.2:18.3": "yuddhāya paccuggacchāmi, ",
  "snp3.2:18.4": "mā maṃ ṭhānā acāvayi. 443. ",
  "snp3.2:19.1": "Yaṃ te taṃ na-ppasahati ",
  "snp3.2:19.2": "senaṃ loko sadevako,| ",
  "snp3.2:19.3": "taṃ te paññāya gacchāmi ",
  "snp3.2:19.4": "āmaṃ pattaṃ va amhanā. 444. ",
  "snp3.2:20.1": "Vasiṃkaritvā saṃkappaṃ ",
  "snp3.2:20.2": "satiñ ca suppatiṭṭhitaṃ ",
  "snp3.2:20.3": "raṭṭhā raṭṭhaṃ vicarissaṃ ",
  "snp3.2:20.4": "sāvake vinayaṃ puthu. 445. ",
  "snp3.2:21.1": "Te appamattā pahitattā ",
  "snp3.2:21.2": "mama sāsanakārakā ",
  "snp3.2:21.3": "akāmassa te gamissanti, ",
  "snp3.2:21.4": "yattha gantvā na socare\". 446. ",
  "snp3.2:22.1": "\"Satta vassāni Bhagavantaṃ ",
  "snp3.2:22.2": "anubandhiṃ padā padaṃ, ",
  "snp3.2:22.3": "otāraṃ nādhigacchissaṃ ",
  "snp3.2:22.4": "Sambuddhassa satīmato. 447. ",
  "snp3.2:23.1": "Medavaṇṇaṃ va pāsāṇaṃ ",
  "snp3.2:23.2": "vāyaso anupariyagā: ",
  "snp3.2:23.3": "‘ap' ettha mudu vindema, ",
  "snp3.2:23.4": "api assādanā siyā,' 448. ",
  "snp3.2:24.1": "Aladdhā tattha assādaṃ ",
  "snp3.2:24.2": "vāyas' etto apakkami, -- ",
  "snp3.2:24.3": "kāko va selaṃ āsajja ",
  "snp3.2:24.4": "nibbijjāpema Gotamaṃ\". 449. ",
  "snp3.2:25.1": "Tassa sokaparetassa ",
  "snp3.2:25.2": "vīṇā kacchā abhassatha, ",
  "snp3.2:25.3": "tato so dummano yakkho ",
  "snp3.2:25.4": "tatth' ev' antaradhāyathā ti ",
  "snp3.2:25.5": "PADHĀNASUTTAṂ NIṬṬHITAṂ. "
}
