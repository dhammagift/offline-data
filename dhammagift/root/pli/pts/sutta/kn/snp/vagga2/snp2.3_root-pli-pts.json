{
  "snp2.3:0.1": "",
  "snp2.3:0.2": "",
  "snp2.3:1.1": "tarantaṃ vijigucchamānaṃ ",
  "snp2.3:1.2": "\"sakhāham asmi\" iti bhāsamānaṃ ",
  "snp2.3:1.3": "sayhāni kammāni anādiyantaṃ ",
  "snp2.3:1.4": "‘n' eso manan' ti iti naṃ vijaññā. 254. ",
  "snp2.3:2.1": "Ananvayaṃ piyaṃ vācaṃ ",
  "snp2.3:2.2": "yo mittesu pakubbati, ",
  "snp2.3:2.3": "akarontaṃ bhāsamānaṃ ",
  "snp2.3:2.4": "parijānanti paṇḍitā. 255. ",
  "snp2.3:3.1": "Na so mitto yo sadā appamatto ",
  "snp2.3:3.2": "bhedāsaṃkī randham evānupassī, yasmiṃ ",
  "snp2.3:3.3": "ca seti urasīva putto, ",
  "snp2.3:3.4": "sa ve mitto yo parehi abhejjo. 256. ",
  "snp2.3:4.1": "Pāmujjakaraṇaṃ ṭhānaṃ ",
  "snp2.3:4.2": "pasaṃsāvahanaṃ sukhaṃ ",
  "snp2.3:4.3": "phalānisaṃso bhāveti ",
  "snp2.3:4.4": "vahanto porisaṃ dhuraṃ. 257. ",
  "snp2.3:5.1": "Pavivekarasam pītvā ",
  "snp2.3:5.2": "rasaṃ upasamassa ca ",
  "snp2.3:5.3": "niddaro hoti nippāpo ",
  "snp2.3:5.4": "dhammapitirasaṃ pivan ti ",
  "snp2.3:5.5": "HIRISUTTAṂ NIṬṬHITAṂ. "
}
