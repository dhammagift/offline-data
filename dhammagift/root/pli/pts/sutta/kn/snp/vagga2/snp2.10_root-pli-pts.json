{
  "snp2.10:0.1": "",
  "snp2.10:0.2": "",
  "snp2.10:1.1": "Uṭṭhahatha nisīdatha, ",
  "snp2.10:1.2": "ko attho supitena vo, ",
  "snp2.10:1.3": "āturānaṃ hi kā niddā ",
  "snp2.10:1.4": "sallaviddhāna ruppataṃ. 332. ",
  "snp2.10:2.1": "Uṭṭhahatha nisīdatha ",
  "snp2.10:2.2": "daḷhaṃ sikkhatha santiyā, ",
  "snp2.10:2.3": "mā vo pamatte viññāya ",
  "snp2.10:2.4": "maccurājā amohayittha vasānuge. 333. ",
  "snp2.10:3.1": "Yāya devā manussā ca ",
  "snp2.10:3.2": "sitā tiṭṭhanti atthikā, ",
  "snp2.10:3.3": "tarath' etaṃ visattikaṃ, ",
  "snp2.10:3.4": "khaṇo ve mā upaccagā, ",
  "snp2.10:3.5": "khaṇātītā hi socanti ",
  "snp2.10:3.6": "nirayamhi samappitā. 334. ",
  "snp2.10:4.1": "Pamādo rajo . . ., ",
  "snp2.10:4.2": "pamādānupatito rajo: ",
  "snp2.10:4.3": "appamādena vijjāya ",
  "snp2.10:4.4": "abbahe sallam attano ti ",
  "snp2.10:4.5": "UṬṬHĀNASUTTAṂ NIṬṬHITAṂ. 335. "
}
