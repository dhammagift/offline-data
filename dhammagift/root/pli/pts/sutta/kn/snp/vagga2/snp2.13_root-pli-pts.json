{
  "snp2.13:0.1": "",
  "snp2.13:0.2": "",
  "snp2.13:1.1": "\"Pucchāmi muniṃ pahūtapaññaṃ ",
  "snp2.13:1.2": "tiṇṇam pāragataṃ parinibbutaṃ ṭhitattaṃ: ",
  "snp2.13:1.3": "nikkhamma gharā panujja kāme ",
  "snp2.13:1.4": "kathaṃ bhikkhu sammā so loke paribbajeyya\". 360. ",
  "snp2.13:2.1": "\"Yassa maṅgalā samūhatā ",
  "snp2.13:2.2": "ti Bhagavā ",
  "snp2.13:2.3": "uppādā supinā ca lakkhaṇā ca, ",
  "snp2.13:2.4": "sa maṅgaladosavippahīno bhikkhu ",
  "snp2.13:2.5": "sammā so loke paribbajeyya. 361. ",
  "snp2.13:3.1": "Rāgaṃ vinayetha nānusesu ",
  "snp2.13:3.2": "dibbesu kāmesu cāpi bhikkhu , ",
  "snp2.13:3.3": "atikkamma bhavaṃ samecca dhammaṃ ",
  "snp2.13:3.4": "sammā so loke paribbajeyya. 362. ",
  "snp2.13:4.1": "Vipiṭṭhikatvā pesuṇāni ",
  "snp2.13:4.2": "kodhaṃ kadariyam jaheyya bhikkhu, ",
  "snp2.13:4.3": "anurodhavirodhavippahīno ",
  "snp2.13:4.4": "sammā so --pe--. 363. ",
  "snp2.13:5.1": "Hitvāna pivañ ca appiyañ ca ",
  "snp2.13:5.2": "anupādāya anissito kuhiñci ",
  "snp2.13:5.3": "saṃyojaniyehi vippamutto ",
  "snp2.13:5.4": "sammā so . . . 364. ",
  "snp2.13:6.1": "Na so upadhīsu sāram eti, ",
  "snp2.13:6.2": "ādānesu vineyya chandarāgaṃ ",
  "snp2.13:6.3": "so anissito anaññaneyyo, ",
  "snp2.13:6.4": "sammā so . . . 365. ",
  "snp2.13:7.1": "Vacasā manasā ca kammanā ca ",
  "snp2.13:7.2": "aviruddho sammā viditvā dhamman ",
  "snp2.13:7.3": "nibbānapadābhipatthayāno ",
  "snp2.13:7.4": "sammā so . . . 366. ",
  "snp2.13:8.1": "Yo ‘vandati man' ti na uṇṇameyya ",
  "snp2.13:8.2": "akkuṭṭho pi na sandhiyetha bhikkhu ",
  "snp2.13:8.3": "laddhā parabhojanaṃ na majje, ",
  "snp2.13:8.4": "sammā so . . . 367. ",
  "snp2.13:9.1": "Lobhañ ca bhavañ ca vippahāya ",
  "snp2.13:9.2": "virato chedanabandhanāto bhikkhu ",
  "snp2.13:9.3": "so tiṇṇakathaṃkatho visallo, ",
  "snp2.13:9.4": "sammā so . . . 368. ",
  "snp2.13:10.1": "Sāruppam attano viditvā ",
  "snp2.13:10.2": "na ca bhikkhu hiṃseyya kañci loke, ",
  "snp2.13:10.3": "yathātathiyaṃ viditvā dhammaṃ ",
  "snp2.13:10.4": "sammā so . . . 369. ",
  "snp2.13:11.1": "Yassānusayā na santi keci, ",
  "snp2.13:11.2": "mūlā akusalā samūhatāse, ",
  "snp2.13:11.3": "so nirāsayo anāsasāno, ",
  "snp2.13:11.4": "sammā so . . . 370. ",
  "snp2.13:12.1": "Āsavakhīṇo pahīnamāno ",
  "snp2.13:12.2": "sabbaṃ rāgapathaṃ upātivatto ",
  "snp2.13:12.3": "danto parinibbuto ṭhitatto ",
  "snp2.13:12.4": "sammā so . . . 371. ",
  "snp2.13:13.1": "Saddho sutavā niyāmadassī ",
  "snp2.13:13.2": "",
  "snp2.13:13.3": "lobhaṃ dosaṃ vineyya paṭighaṃ ",
  "snp2.13:13.4": "sammā so . . . 372. ",
  "snp2.13:14.1": "Saṃsuddhajino vivattacchaddo ",
  "snp2.13:14.2": "dhammesu vasī pāragū anejo ",
  "snp2.13:14.3": "saṃkhāranirodhañāṇakusalo ",
  "snp2.13:14.4": "sammā so . . . 373. ",
  "snp2.13:15.1": "Atītesu anāgatesu cāpi ",
  "snp2.13:15.2": "kappātīto aticca suddhipañño ",
  "snp2.13:15.3": "sabbāyatanehi vippamutto ",
  "snp2.13:15.4": "sammā so . . . 374. ",
  "snp2.13:16.1": "Aññāya padaṃ samecca dhammaṃ ",
  "snp2.13:16.2": "vivaṭaṃ disvāna pahānam āsavānaṃ ",
  "snp2.13:16.3": "sabbūpadhīnaṃ parikkhayā ",
  "snp2.13:16.4": "sammā so loke paribbajeyya\". 375. ",
  "snp2.13:17.1": "\"Addhā hi Bhagavā tath' eva etaṃ: ",
  "snp2.13:17.2": "yo so evaṃvihāri danto bhikkhu| ",
  "snp2.13:17.3": "sabbasaṃyojaniye ca vītivatto, ",
  "snp2.13:17.4": "sammā so loke paribbajeyyā\" ti ",
  "snp2.13:17.5": "SAMMĀPARIBBĀJANIYASUTTAṂ NIṬṬHITAṂ. "
}
