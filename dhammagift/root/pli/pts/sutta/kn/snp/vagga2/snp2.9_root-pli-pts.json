{
  "snp2.9:0.1": "",
  "snp2.9:0.2": "",
  "snp2.9:1.1": "\"Kiṃsīlo kiṃsamācāro ",
  "snp2.9:1.2": "kāni kammāni brūhayaṃ ",
  "snp2.9:1.3": "naro sammāviviṭṭh' assa ",
  "snp2.9:1.4": "uttamatthañ ca pāpuṇe\". 325. ",
  "snp2.9:2.1": "\"Vaddhāpacāyī anusuyyako siyā, ",
  "snp2.9:2.2": "kālaññu c' assa garunaṃ dassanāya, ",
  "snp2.9:2.3": "dhammiṃ kathaṃ erayitaṃ khaṇaññū ",
  "snp2.9:2.4": "suṇeyya sakkacca subhāsitāni. 326. ",
  "snp2.9:3.1": "Kālena gacche garunaṃ sakāsaṃ ",
  "snp2.9:3.2": "thambhaṃ niraṃkatvā nivātavutti,| ",
  "snp2.9:3.3": "atthaṃ dhammaṃ saññamaṃ brahmacariyaṃ ",
  "snp2.9:3.4": "anussare c' eva samācare ca. 327. ",
  "snp2.9:4.1": "Dhammārāmo dhammarato ",
  "snp2.9:4.2": "dhamme ṭhito dhammavinicchayaññū ",
  "snp2.9:4.3": "n' evācare dhammasandosavādaṃ ",
  "snp2.9:4.4": "tacchehi niyyetha subhāsitehi. 328. ",
  "snp2.9:5.1": "Hassaṃ jappaṃ paridevaṃ padosaṃ ",
  "snp2.9:5.2": "māyākataṃ kuhanaṃ giddhimānaṃ ",
  "snp2.9:5.3": "sārambha-kakkassa-kasāva-mucchaṃ ",
  "snp2.9:5.4": "hitvā care vītamado ṭhitatto. 329. ",
  "snp2.9:6.1": "Viññātasārāni subhāsitāni, ",
  "snp2.9:6.2": "sutañ ca viññātaṃ samādhisāraṃ, -- ",
  "snp2.9:6.3": "na tassa paññā ca sutañ ca vaḍḍhati, ",
  "snp2.9:6.4": "yo sāhaso hoti naro pamatto. 330. ",
  "snp2.9:7.1": "Dhamme ca ye ariyapavedite ratā ",
  "snp2.9:7.2": "anuttarā te vacasā manasā kammanā ca, ",
  "snp2.9:7.3": "te santi-soracca-samādhisaṇṭhitā ",
  "snp2.9:7.4": "sutassa paññāya ca sāram ajjhagū\" ti ",
  "snp2.9:7.5": "KIṂSĪLASUTTAṂ NIṬṬHITAṂ. 331. "
}
