{
  "snp2.6:0.1": "",
  "snp2.6:0.2": "",
  "snp2.6:1.1": "Dhammacariyaṃ brahmacariyaṃ ",
  "snp2.6:1.2": "etad āhu vasutta- maṃ: ",
  "snp2.6:1.3": "pabbajito pi ce hoti ",
  "snp2.6:1.4": "agārasmā anagāriyaṃ, 275. ",
  "snp2.6:2.1": "So ce mukharajātiko ",
  "snp2.6:2.2": "vihesābhirato mago, ",
  "snp2.6:2.3": "jīvitan tassa pāpiyo, ",
  "snp2.6:2.4": "rajaṃ vaḍḍheti attano. 276. ",
  "snp2.6:3.1": "Kalahābhirato bhikkhu ",
  "snp2.6:3.2": "mohadhammena āvaṭo ",
  "snp2.6:3.3": "akkhātam pi na jānāti ",
  "snp2.6:3.4": "dhammaṃ Baddhena desitaṃ. 277. ",
  "snp2.6:4.1": "Vihesaṃ bhāvitattānaṃ ",
  "snp2.6:4.2": "avijjāya purakkhato ",
  "snp2.6:4.3": "saṃkilesaṃ na jānāti ",
  "snp2.6:4.4": "maggaṃ nirayagāminaṃ, 278. ",
  "snp2.6:5.1": "vinipātaṃ samāpanno ",
  "snp2.6:5.2": "gabbhā gabbhaṃ tamā tamaṃ, ",
  "snp2.6:5.3": "sa ve tādisako bhikkhu ",
  "snp2.6:5.4": "pecca dukkhaṃ nigacchati. 279. ",
  "snp2.6:6.1": "Gūthakūpo yathā assa ",
  "snp2.6:6.2": "sampuṇṇo gaṇavassiko, ",
  "snp2.6:6.3": "yo evarūpo assa, ",
  "snp2.6:6.4": "dubbisodho hi saṅgaṇo. 280. ",
  "snp2.6:7.1": "Yaṃ evarūpaṃ jānātha ",
  "snp2.6:7.2": "bhikkhavo gehanissitaṃ ",
  "snp2.6:7.3": "pāpicchaṃ pāpasaṃkappaṃ ",
  "snp2.6:7.4": "pāpāacāragocaraṃ, 281. ",
  "snp2.6:8.1": "sabbe samaggā hutvāna ",
  "snp2.6:8.2": "abhinibbijjayātha naṃ: ",
  "snp2.6:8.3": "kāraṇḍavaṃ niddhamatha, ",
  "snp2.6:8.4": "kasambuṃ apakas- satha, 282. ",
  "snp2.6:9.1": "tato palāpe vāhetha ",
  "snp2.6:9.2": "assamaṇe samaṇamānine. ",
  "snp2.6:9.3": "Niddhamitvāna pāpicche ",
  "snp2.6:9.4": "pāpāacāragocare 283. ",
  "snp2.6:10.1": "suddhā suddhehi saṃvāsaṃ ",
  "snp2.6:10.2": "kappayavho patissatā, ",
  "snp2.6:10.3": "tato samaggā nipakā ",
  "snp2.6:10.4": "dukkhass' antaṃ karissathā ti ",
  "snp2.6:10.5": "DHAMMACARIYASUTTAṂ NIṬṬHITAṂ. "
}
