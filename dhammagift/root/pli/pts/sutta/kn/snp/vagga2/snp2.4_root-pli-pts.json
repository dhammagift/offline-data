{
  "snp2.4:0.1": "",
  "snp2.4:0.2": "",
  "snp2.4:1.1": "Evam me sutaṃ: ",
  "snp2.4:1.2": "Ekaṃ samayaṃ Bhagavā Sāvatthiyaṃ viharati Jetavane Anāthapiṇḍikassa ārāme. ",
  "snp2.4:1.3": "Atha kho aññatarā devatā abhikkantāya rattiyā abhikkantavaṇṇā kevalakappaṃ Jetavanaṃ obhāsetvā yena Bhagavā ten' upasaṃkami, upasaṃkamitvā Bhagavantaṃ abhivādetvā ekamantaṃ aṭṭhāsi. ",
  "snp2.4:1.4": "Ekamantaṃ ṭhitā kho sā devatā Bhagavantaṃ gāthāya ajjhabhāsi: 258. ",
  "snp2.4:2.1": "\"Bahū devā manussā ca ",
  "snp2.4:2.2": "maṅgalāni acintayuṃ ",
  "snp2.4:2.3": "ākaṃkhamānā sotthānaṃ, ",
  "snp2.4:2.4": "brūhi maṅgalam uttamaṃ\". 259. ",
  "snp2.4:3.1": "\"Asevanā ca bālānaṃ ",
  "snp2.4:3.2": "paṇḍitānañ ca sevanā ",
  "snp2.4:3.3": "pūjā ca pūjanīyānaṃ, ",
  "snp2.4:3.4": "etam maṅgalam uttamaṃ. 260. ",
  "snp2.4:4.1": "Patirūpadesavāso ca ",
  "snp2.4:4.2": "pubbe ca katapuññatā ",
  "snp2.4:4.3": "attasammāpaṇidhi ca, ",
  "snp2.4:4.4": "etam maṅgalam uttamaṃ. 261. ",
  "snp2.4:5.1": "Bāhusaccañ ca sippañ ca ",
  "snp2.4:5.2": "vinayo ca susikkhito ",
  "snp2.4:5.3": "subhāsitā ca yā vācā, ",
  "snp2.4:5.4": "etaṃ . . . 262. ",
  "snp2.4:6.1": "Mātāpitu-upaṭṭhānaṃ ",
  "snp2.4:6.2": "puttadārassa saṅgaho ",
  "snp2.4:6.3": "anākulā ca kammantā, ",
  "snp2.4:6.4": "etaṃ . . . 263. ",
  "snp2.4:7.1": "Dānañ ca dhammacariyā ca ",
  "snp2.4:7.2": "ñātakānañ ca saṅgaho ",
  "snp2.4:7.3": "anavajjāni kammāni, ",
  "snp2.4:7.4": "etaṃ . . . 264. ",
  "snp2.4:8.1": "Ārati viratī pāpā ",
  "snp2.4:8.2": "majjapānā ca suññamo ",
  "snp2.4:8.3": "appamādo ca dhammesu, ",
  "snp2.4:8.4": "etaṃ . . . 265. ",
  "snp2.4:9.1": "Gāravo ca nivāto ca ",
  "snp2.4:9.2": "santuṭṭhī ca kataññutā ",
  "snp2.4:9.3": "kālena dhammasavanaṃ, ",
  "snp2.4:9.4": "etaṃ . . . 266. ",
  "snp2.4:10.1": "Khantī ca sovacassatā ",
  "snp2.4:10.2": "samaṇānañ ca dassanaṃ ",
  "snp2.4:10.3": "kālena dhammasākacchā, ",
  "snp2.4:10.4": "etaṃ . . . 267. ",
  "snp2.4:11.1": "Tapo ca brahmacariyā ca ",
  "snp2.4:11.2": "ariyasaccāna dassanaṃ ",
  "snp2.4:11.3": "nibbānasacchikiriyā ca, ",
  "snp2.4:11.4": "etaṃ . . . 268. ",
  "snp2.4:12.1": "Phuṭṭhassa lokadhammehi ",
  "snp2.4:12.2": "cittam yassa na kampati ",
  "snp2.4:12.3": "asokaṃ virajaṃ khemaṃ, ",
  "snp2.4:12.4": "etaṃ . . . 269. ",
  "snp2.4:13.1": "Etādisāni katvāna ",
  "snp2.4:13.2": "sabbattha-m-aparājitā, ",
  "snp2.4:13.3": "sabbattha sotthiṃ gacchanti, ",
  "snp2.4:13.4": "taṃ tesaṃ maṅgalam uttaman\" ",
  "snp2.4:13.5": "ti MAHĀMAṄGALASUTTAṂ NIṬṬHITAṂ. "
}
