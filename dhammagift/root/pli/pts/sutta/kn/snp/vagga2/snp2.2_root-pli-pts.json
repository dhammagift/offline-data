  "snp2.2:1.1": "",
  "snp2.2:1.2": "pattapphalaṃ mūlapphalaṃ gavipphalaṃ ",
  "snp2.2:1.3": "dhammena laddhaṃ satam añhamānā ",
  "snp2.2:1.4": "na kāmakāmā alikaṃ bhaṇanti. 240. ",
  "snp2.2:2.1": "Yad añhamāno sukataṃ suniṭṭhitaṃ ",
  "snp2.2:2.2": "parehi dinnaṃ payataṃ panītaṃ| ",
  "snp2.2:2.3": "sālīnam annaṃ paribhuñjamāno ",
  "snp2.2:2.4": "so bhuñjatī Kassapa āmagandhaṃ. 241. ",
  "snp2.2:3.1": "‘Na āmagandho mama kappatī' ti ",
  "snp2.2:3.2": "icc-eva tvaṃ bhāsasi brahmabandhu ",
  "snp2.2:3.3": "sālīnam annaṃ paribhuñjamāno ",
  "snp2.2:3.4": "sakuntamaṃsehi susaṃkhatehi, -- ",
  "snp2.2:3.5": "kathappakāro ",
  "snp2.2:3.6": "tava āmagandho\". 242. ",
  "snp2.2:4.1": "\"Pāṇātipāto vadhachedabandhanaṃ ",
  "snp2.2:4.2": "theyyaṃ musāvādo nikatī vañcanāni ca ",
  "snp2.2:4.3": "ajjhenakujjaṃ paradārasevanā, ",
  "snp2.2:4.4": "esāmagandho, na hi maṃsabhojanaṃ. 243. ",
  "snp2.2:5.1": "Ye idha dāmesu asaññatā janā ",
  "snp2.2:5.2": "rasesu giddhā asucīkamissitā ",
  "snp2.2:5.3": "natthikadiṭṭhi visamā durannayā, ",
  "snp2.2:5.4": "esāmagandho, na hi maṃsabhojanaṃ. 244. ",
  "snp2.2:6.1": "Ye lūkhasā dāruṇā piṭṭhimaṃsikā ",
  "snp2.2:6.2": "mittadduno nikkaruṇatimānino ",
  "snp2.2:6.3": "adānasīlā na ca denti kassaci, -- ",
  "snp2.2:6.4": "esāmagandho --pe--. 245. ",
  "snp2.2:7.1": "Kodho mado thambho paccuṭṭhāpanā ca ",
  "snp2.2:7.2": "māyā usuyyā bhassasamussayo ca ",
  "snp2.2:7.3": "mānātimāno ca asabbhi santhavo, ",
  "snp2.2:7.4": "esāmagandho . . . 246. ",
  "snp2.2:8.1": "Ye pāpasīlā iṇaghāta-sūcakā ",
  "snp2.2:8.2": "vohārakūṭā idha pāṭirūpikā ",
  "snp2.2:8.3": "narādhamā ye 'dha karonti kibbisaṃ, -- ",
  "snp2.2:8.4": "esāmagandho . . . 247. ",
  "snp2.2:9.1": "Ye idha pāṇesu asaññatā janā ",
  "snp2.2:9.2": "paresam ādāya vihesam uyyutā ",
  "snp2.2:9.3": "dussīla-luddā pharusā anādarā, -- ",
  "snp2.2:9.4": "esāmagandho . . . 248. ",
  "snp2.2:10.1": "Etesu giddhā viruddhātipātino ",
  "snp2.2:10.2": "nicc' uyyutā, pecca tamaṃ vajanti ye, ",
  "snp2.2:10.3": "patanti sattā nirayaṃ avaṃsirā, -- ",
  "snp2.2:10.4": "esāmagandho . . . 249. Na macchamaṃsaṃ ",
  "snp2.2:11.1": "nānāsakattaṃ ",
  "snp2.2:11.2": "na naggiyaṃ muṇḍiyaṃ jaṭā jallaṃ ",
  "snp2.2:11.3": "kharājināni vā nāggihuttass' upasevanā va yā ",
  "snp2.2:11.4": "ye vā pi loke amarā bahū tapā ",
  "snp2.2:11.5": "mantāhutī yañña-m-utūpasevanā ",
  "snp2.2:11.6": "sodhenti maccaṃ avitiṇṇakaṃkhaṃ. 250. ",
  "snp2.2:12.1": "Sotesu gutto vijitindriyo care ",
  "snp2.2:12.2": "dhamme ṭhito ajjavamaddave rato , ",
  "snp2.2:12.3": "saṅgātigo sabbadukkhappahīno ",
  "snp2.2:12.4": "na lippati diṭṭhasutesu dhīro\". 251. ",
  "snp2.2:13.1": "Icc-etam attham Bhagavā punappunaṃ ",
  "snp2.2:13.2": "akkhāsi, taṃ vedayi mantapāragū, ",
  "snp2.2:13.3": "citrāhi gāthāhi muni-ppakāsayi ",
  "snp2.2:13.4": "nirāmagandho asito durannayo. 252. ",
  "snp2.2:14.1": "Sutvāna Buddhassa subhāsitam padaṃ ",
  "snp2.2:14.2": "nirāmagandhaṃ sabbadukkhappanūdanaṃ ",
  "snp2.2:14.3": "nīcamano vandi Tathāgatassa ",
  "snp2.2:14.4": "tatth' eva pabbajjam arocayitthā ti ĀMAGANDHASUTTAṂ NIṬṬHITAṂ. 253. Hirin ",
  "snp2.2:14.5": ""
}
