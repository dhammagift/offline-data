  "snp2.1:1.1": "Yānīdha bhūtāni samāgatāmi ",
  "snp2.1:1.2": "bhummāni vā yāni va antalikkhe, ",
  "snp2.1:1.3": "sabbe va bhūtā sumanā bhavantu, ",
  "snp2.1:1.4": "atho pi sakkacca suṇantu bhāsitaṃ. 223. ",
  "snp2.1:2.1": "Tasmā hi bhūtā misāmetha sabbe, ",
  "snp2.1:2.2": "mettaṃ karotha mānusiyā pajāya, ",
  "snp2.1:2.3": "divā ca ratto ca haranti ye baliṃ, ",
  "snp2.1:2.4": "tasmā hi ne rakkhatha appamattā. 224. ",
  "snp2.1:3.1": "Yaṃ kiñci vittaṃ idha vā huraṃ vā, ",
  "snp2.1:3.2": "saggesu vā yaṃ ratanaṃ panītaṃ, ",
  "snp2.1:3.3": "na no samaṃ atthi Tathāgatena, -- ",
  "snp2.1:3.4": "idam pi Buddhe ratanaṃ paṇītaṃ, ",
  "snp2.1:3.5": "etena saccena suvatthi hotu. 225. ",
  "snp2.1:4.1": "Khayaṃ virāgaṃ amataṃ paṇītaṃ ",
  "snp2.1:4.2": "yad ajjhagā Sakyamunī samāhito, ",
  "snp2.1:4.3": "na tena dhammena sam' atthi kiñci, -- ",
  "snp2.1:4.4": "idam pi Dhamme ratanaṃ paṇītaṃ, ",
  "snp2.1:4.5": "etena saccena suvatthi hotu. 226. ",
  "snp2.1:5.1": "Yam buddhaseṭṭho parivaṇṇayī suciṃ ",
  "snp2.1:5.2": "samādhim ānantarikañ ñam āhu,| ",
  "snp2.1:5.3": "samādhinā tena samo na vijjati, -- ",
  "snp2.1:5.4": "idam pi Dhamme ratanaṃ paṇītaṃ, ",
  "snp2.1:5.5": "etena saccena suvatthi hotu. 227. ",
  "snp2.1:6.1": "Ye puggalā aṭṭha satam pasatthā, ",
  "snp2.1:6.2": "cattāri etāni yugāni honti, ",
  "snp2.1:6.3": "te dakkhiṇeyyā Sugatassa sāvakā, ",
  "snp2.1:6.4": "etesu dinnāni mahapphalāni, -- ",
  "snp2.1:6.5": "idam pi Saṃghe ratanaṃ panītaṃ, ",
  "snp2.1:6.6": "etena saccena suvatthi hotu. 228. ",
  "snp2.1:7.1": "Ye suppayuttā manasā daḷhena ",
  "snp2.1:7.2": "nikkāmino Gotamasāsanamhi, ",
  "snp2.1:7.3": "te pattipattā amataṃ vigayha ",
  "snp2.1:7.4": "laddhā mudhā nibbutiṃ bhuñjamānā, -- ",
  "snp2.1:7.5": "idam pi Saṃghe ratanaṃ paṇītaṃ, ",
  "snp2.1:7.6": "etena saccena suvatthi hotu. 229. ",
  "snp2.1:8.1": "Yath' indakhīlo paṭhaviṃ sito siyā ",
  "snp2.1:8.2": "catubbhi vātehi asampakampiyo, ",
  "snp2.1:8.3": "tathūpamaṃ sappurisaṃ vadāmi ",
  "snp2.1:8.4": "yo ariyasaccāni avecca passati, -- ",
  "snp2.1:8.5": "idam pi Saṃghe ratanaṃ paṇītāṃ, ",
  "snp2.1:8.6": "etena saccena suvatthi hotu. 230. ",
  "snp2.1:9.1": "Ye ariyasaccāni vibhāvayanti ",
  "snp2.1:9.2": "gambhīrapaññena sudesitāni, ",
  "snp2.1:9.3": "kiñcāpi te honti bhusappamattā, ",
  "snp2.1:9.4": "na te bhavaṃ aṭṭhamaṃ ādiyanti, -- ",
  "snp2.1:9.5": "idam pi Saṃghe ratanaṃ paṇītaṃ, ",
  "snp2.1:9.6": "etena saccena suvatthi hotu. 231. ",
  "snp2.1:10.1": "Sahā v' assa dassanasampadāya ",
  "snp2.1:10.2": "tayas su dhammā jahitā bhavanti:| ",
  "snp2.1:10.3": "sakkāyadiṭṭhi vicikicchitañ ca ",
  "snp2.1:10.4": "sīlabbataṃ vā pi yad atthi kiñci, ",
  "snp2.1:11.1": "catūh' apāyehi ca vippamutto ",
  "snp2.1:11.2": "cha cābhiṭhānāni abhabbo kātuṃ, -- ",
  "snp2.1:11.3": "idam pi Saṃghe ratanaṃ paṇītaṃ, ",
  "snp2.1:11.4": "etena saccena suvatthi hotu. 232. ",
  "snp2.1:12.1": "Kiñcāpi so kammaṃ karoti pāpakaṃ ",
  "snp2.1:12.2": "kāyena vācā uda cetasā vā, ",
  "snp2.1:12.3": "abhabbo so tassa paṭicchadāya, ",
  "snp2.1:12.4": "abhabbatā diṭṭhapadassa vuttā, -- ",
  "snp2.1:12.5": "idam pi Saṃghe ratanaṃ paṇītaṃ, ",
  "snp2.1:12.6": "etena saccena suvatthi hotu. 233. ",
  "snp2.1:13.1": "Vanappagumbe yathā phussitagge ",
  "snp2.1:13.2": "gimhāna māse paṭhamasmiṃ gimhe, ",
  "snp2.1:13.3": "tathūpamaṃ dhammavaraṃ adesayi ",
  "snp2.1:13.4": "nibbānagāmiṃ paramaṃhitāya, -- ",
  "snp2.1:13.5": "idam pi Buddhe ratanaṃ paṇītaṃ, ",
  "snp2.1:13.6": "etena saccena suvatthi hotu. 234. ",
  "snp2.1:14.1": "Varo varaññū varado varāharo ",
  "snp2.1:14.2": "anuttaro dhammavaraṃ adesayi, -- ",
  "snp2.1:14.3": "idam pi Buddhe ratanaṃ paṇītaṃ, ",
  "snp2.1:14.4": "etena saccena suvatthi hotu. 235. ",
  "snp2.1:15.1": "‘Khīṇaṃ purāṇaṃ, navaṃ n' atthi sam- bhavaṃ,' virattacittā ",
  "snp2.1:15.2": "āyatike bhavasmiṃ ",
  "snp2.1:15.3": "te khīṇabījā avirūḷhichandā| ",
  "snp2.1:15.4": "nibbanti dhīrā yathāyam padīpo, -- ",
  "snp2.1:15.5": "idam pi Saṃghe ratanaṃ paṇītaṃ, ",
  "snp2.1:15.6": "etena saccena suvatthi hotu. 236. ",
  "snp2.1:16.1": "Yānīdha bhūtāni samāgatāni ",
  "snp2.1:16.2": "bhummāni vā yāni va antalikkhe, ",
  "snp2.1:16.3": "tathāgataṃ devamanussapūjitaṃ ",
  "snp2.1:16.4": "Buddhaṃ namassāma, suvatthi hotu. 237. ",
  "snp2.1:17.1": "Yānīdha bhūtāni samāgatāmi ",
  "snp2.1:17.2": "bhummāni vā yāni va antalikkhe, ",
  "snp2.1:17.3": "tathāgataṃ devamanussapūjitaṃ ",
  "snp2.1:17.4": "Dhammaṃ namassāma, suvatthi hotu. 238. ",
  "snp2.1:18.1": "Yānīdha bhūtāni samāgatāni ",
  "snp2.1:18.2": "bhummāni vā yāni va antalikkhe, ",
  "snp2.1:18.3": "tathāgataṃ devamanussapūjitaṃ ",
  "snp2.1:18.4": "Saṃghaṃ namassāma, suvatthi hotū ti RATANASUTTAṂ NIṬṬHITAṂ. 239. \"Sāmāka-ḍiṅgulaka-cīnakāni ",
  "snp2.1:18.5": ""
}
