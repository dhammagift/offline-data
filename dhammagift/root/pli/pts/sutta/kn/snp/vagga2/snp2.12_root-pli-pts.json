{
  "snp2.12:0.1": "",
  "snp2.12:0.2": "",
  "snp2.12:1.1": "Evam me sutaṃ: ",
  "snp2.12:1.2": "Ekaṃ samayaṃ Bhagavā Āḷaviyaṃ viharati Aggāḷave cetiye. ",
  "snp2.12:1.3": "Tena kho pana samayena āyasmato Vaṅgīsassa upajjhāyo Nigrodhakappo nāma thero Aggāḷave cetiye aciraparinibbuto hoti. ",
  "snp2.12:1.4": "Atha kho āyasmato Vaṅgīsassa rahogatassa paṭisallīnassa evaṃ cetaso parivitakko udapādi: ",
  "snp2.12:1.5": "‘parinibbuto nu kho me upājjhāyo udāhu no parinibbuto' ti. ",
  "snp2.12:1.6": "Atha kho āyasmā Vaṅgīso sāyaṇhasamayaṃ paṭisallānā vuṭṭhito yena Bhagavā ten' upasaṃkami, upasaṃkamitvā Bhagavantaṃ abhivādetvā ekamantaṃ nisīdi. Ekamantaṃ nisinno kho āyasmā Vaṅgīso Bhagavantaṃ etad avoca: ",
  "snp2.12:1.7": "\"idha mayhaṃ bhante rahogatassa paṭisallīnassa evaṃ cetaso parivitakko udapādi ",
  "snp2.12:1.8": "‘parinibbuto nu kho me upajjhāyo udāhu no parinibbuto\"' ti. ",
  "snp2.12:1.9": "Atha kho āyasmā Vaṅgīso uṭṭhāyāssanā ekaṃsaṃ cīvaraṃ katvā yena Bhagavā ten' añjalim paṇāmitvā Bhagavantaṃ gāthāyā ajjhabhāsi: 343. ",
  "snp2.12:2.1": "\"Pucchāma Satthāraṃ anomapaññaṃ, ",
  "snp2.12:2.2": "diṭṭhe va dhamme yo vicikicchānaṃ chettā: ",
  "snp2.12:2.3": "Aggāḷave kālam akāsi bhikkhu ",
  "snp2.12:2.4": "ñāto yasassī abhinibbutatto. 344. ",
  "snp2.12:3.1": "Nibrodhakappo iti tassa nāmaṃ ",
  "snp2.12:3.2": "tayā kataṃ Bhagavā brāhmaṇassa, ",
  "snp2.12:3.3": "so taṃ namassaṃ acari mutyapekho ",
  "snp2.12:3.4": "āraddhaviriyo daḷhadhammadassī. 345. ",
  "snp2.12:4.1": "Taṃ sāvakaṃ Sakka mayam pi sabbe ",
  "snp2.12:4.2": "aññātum icchāma sumantacakkhu, ",
  "snp2.12:4.3": "samavaṭṭhitā no savanāya sotā, ",
  "snp2.12:4.4": "tuvan no satthā, tvam anuttaro si. 346. ",
  "snp2.12:5.1": "Chind' eva no vicikicchaṃ, brūhi m' etaṃ, ",
  "snp2.12:5.2": "parinibbutaṃ vedaya bhūripañña, ",
  "snp2.12:5.3": "majjhe va no bhāsa samantacakkhu ",
  "snp2.12:5.4": "Sakko va devānaṃ sahassanetto. 347. ",
  "snp2.12:6.1": "Ye keci ganthā idha mohamaggā ",
  "snp2.12:6.2": "aññāṇapakkhā vicikicchaṭhānā| ",
  "snp2.12:6.3": "Tathāgataṃ patvā na te bhavanti, ",
  "snp2.12:6.4": "cakkhuṃ hi etaṃ paramaṃ narānaṃ. 348. ",
  "snp2.12:7.1": "No ce hi jātu puriso kilese ",
  "snp2.12:7.2": "vāto yathā abbhaghanaṃ vihāne, ",
  "snp2.12:7.3": "tamo v' assa nivuto sabbaloko, ",
  "snp2.12:7.4": "na jotimanto pi narā tapeyyuṃ. 349. ",
  "snp2.12:8.1": "Dhīrā ca pajjotakarā bhavanti, ",
  "snp2.12:8.2": "taṃ taṃ ahaṃ dhīra tath' eva maññe, ",
  "snp2.12:8.3": "vipassinaṃ jānam upāgamamha: ",
  "snp2.12:8.4": "parisāsu no āvikarohi Kappaṃ. 350. ",
  "snp2.12:9.1": "Khippaṃ giraṃ eraya vagguvagguṃ haṃsā ",
  "snp2.12:9.2": "va paggayha saṇiṃ nikūja ",
  "snp2.12:9.3": "bindussarena suvikappitena ",
  "snp2.12:9.4": "sabbe va te ujjugatā suṇoma. 351. ",
  "snp2.12:10.1": "Pahīnajātimaraṇaṃ asesaṃ ",
  "snp2.12:10.2": "niggayha dhonaṃ vadessāmi dhammaṃ, ",
  "snp2.12:10.3": "na kāmakāro hi puthujjanānaṃ ",
  "snp2.12:10.4": "saṃkheyyakāro ca tathāgatānaṃ. 352. ",
  "snp2.12:11.1": "Sampannaveyyākaraṇan tava-y-idaṃ ",
  "snp2.12:11.2": "samujjupaññassa samuggahītaṃ, ",
  "snp2.12:11.3": "ayam añjalī pacchimo suppaṇāmito, ",
  "snp2.12:11.4": "mā mohayi jānam anomapañña. 353. ",
  "snp2.12:12.1": "Parovaraṃ ariyadhammaṃ viditvā ",
  "snp2.12:12.2": "mā mohayi jānam anomaviriya,| ",
  "snp2.12:12.3": "vāriṃ yathā ghammani ghammatatto ",
  "snp2.12:12.4": "vācābhikaṃkhāmi sutassavassa. 354. Yadatthiyaṃ ",
  "snp2.12:13.1": "brahmacariyaṃ acāri ",
  "snp2.12:13.2": "Kappāyano, kacci 'ssa taṃ amoghaṃ, ",
  "snp2.12:13.3": "nibbāyi so ādu saupādiseso, ",
  "snp2.12:13.4": "yathā vimutto ahu taṃ suṇāma\". 355. ",
  "snp2.12:14.1": "\"Acchecchi tanhaṃ idha nāmarūpe ",
  "snp2.12:14.2": "ti Bhagavā ",
  "snp2.12:14.3": "Kaṇhassa sotaṃ dīgharattānusayitaṃ, ",
  "snp2.12:14.4": "atāri jātimaraṇaṃ asesaṃ\" -- ",
  "snp2.12:14.5": "icc-abravī Bhagavā pañcaseṭṭho. 356. ",
  "snp2.12:15.1": "\"Esa sutvā pasīdāmi ",
  "snp2.12:15.2": "vaco te isisattama, ",
  "snp2.12:15.3": "amoghaṃ kira me puṭṭhaṃ, ",
  "snp2.12:15.4": "na maṃ vañcesi brāhmaṇo. 357. ",
  "snp2.12:16.1": "Yathāvādī tathākārī ",
  "snp2.12:16.2": "ahū Buddhassa sāvako, ",
  "snp2.12:16.3": "acchidā Maccuno jālaṃ ",
  "snp2.12:16.4": "tataṃ māyāvino daḷhaṃ. 358. ",
  "snp2.12:17.1": "Addasa Bhagavā ādiṃ ",
  "snp2.12:17.2": "upādānassa Kappiyo, ",
  "snp2.12:17.3": "accagā vata Kappāyano ",
  "snp2.12:17.4": "maccudheyyaṃ suduttaran\" ti VAṄGĪSASUTTAṂ NIṬṬHITAṂ. 359. ",
  "snp2.12:17.5": ""
}
