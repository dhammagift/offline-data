{
  "snp2.8:0.1": "",
  "snp2.8:0.2": "",
  "snp2.8:1.1": "Yasmā hi dhammaṃ puriso vijaññā , ",
  "snp2.8:1.2": "Indaṃ va naṃ devatā pūjayeyya, ",
  "snp2.8:1.3": "so pūjito tasmiṃ pasannacitto ",
  "snp2.8:1.4": "bahussuto pātukaroti dhammaṃ. 317. ",
  "snp2.8:2.1": "Tad aṭṭhikatvāna nisamma dhīro ",
  "snp2.8:2.2": "dhammānudhammaṃ paṭipajjamāno ",
  "snp2.8:2.3": "viññū vibhāvī nipuṇo ca hoti, ",
  "snp2.8:2.4": "yo tādisaṃ bhajati appamatto. 318. ",
  "snp2.8:3.1": "Khuddañ ca bālaṃ upasevamāno ",
  "snp2.8:3.2": "anāgatatthañ ca bālaṃ usūyakañ ca ",
  "snp2.8:3.3": "idh' eva dhammaṃ avibhāvayitvā ",
  "snp2.8:3.4": "avitiṇṇakaṃkho maraṇaṃ upeti. 319. ",
  "snp2.8:4.1": "Yathā naro āpagaṃ otaritvā ",
  "snp2.8:4.2": "mahodikaṃ salilaṃ sīghasotaṃ, ",
  "snp2.8:4.3": "so vuyhamāno anusotagāmī ",
  "snp2.8:4.4": "kiṃ so pare sakkhati tārayetuṃ, 320. ",
  "snp2.8:5.1": "tath' eva dhammaṃ avibhāvayitvā ",
  "snp2.8:5.2": "bahussutānaṃ anisāmay' atthaṃ, ",
  "snp2.8:5.3": "sayaṃ ajānaṃ avitiṇṇakaṃkho ",
  "snp2.8:5.4": "kiṃ so pare sakkhati nijjhapetuṃ. 321. ",
  "snp2.8:6.1": "Yathā pi nāvaṃ daḷham āruhitvā ",
  "snp2.8:6.2": "piyen' arittena samaṅgibhūto, ",
  "snp2.8:6.3": "so tāraye tattha bahū pi aññe ",
  "snp2.8:6.4": "tatrūpayaññū kusalo mutīmā, 322. ",
  "snp2.8:7.1": "evam pi yo vedagu bhāvitatto ",
  "snp2.8:7.2": "bahussuto hoti avedhadhammo, ",
  "snp2.8:7.3": "so kho pare nijjhapaye pajānaṃ ",
  "snp2.8:7.4": "sotāvadhānūpanisūpapanne. 323. ",
  "snp2.8:8.1": "Tasmā have sappurisaṃ bhajetha ",
  "snp2.8:8.2": "medhāvinañ c' eva bahussutañ ca, ",
  "snp2.8:8.3": "aññāya atthaṃ paṭipajjamāno ",
  "snp2.8:8.4": "viññātadhammo so sukhaṃ labhethā ti ",
  "snp2.8:8.5": "NĀVĀSUTTAṂ NIṬṬHITAṂ. 324. "
}
