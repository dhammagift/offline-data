{
  "dhp235:0.1": "",
  "dhp235:0.2": "",
  "dhp235:0.3": "",
  "dhp235:0.4": "",
  "dhp235:1": "",
  "dhp235:2": "ca taṃ upaṭṭhitā, / ",
  "dhp235:3": "uyyogamukhe ca tiṭṭhasi ",
  "dhp235:4": "pātheyyam pi ca te na vijjati. // // ",
  "dhp236:1": "so karohi dīpam attano ",
  "dhp236:2": "khippaṃ vāyama paṇḍito bhava, / ",
  "dhp236:3": "niddhantamalo anaṅgaṇo ",
  "dhp236:4": "dibbaṃ ariyabhūmim ehisi. // // ",
  "dhp237:1": "upanītavayo va dāni si ",
  "dhp237:2": "sampayāto si Yamassa santike, / ",
  "dhp237:3": "vāso pi ca te n' atthi antarā ",
  "dhp237:4": "pātheyyam pi ca te na vijjati. // // ",
  "dhp238:1": "so karohi dīpam attano ",
  "dhp238:2": "khippaṃ vāyama paṇḍito bhava, / ",
  "dhp238:3": "niddhantamalo anaṅgaṇo ",
  "dhp238:4": "na punaṃ jātijaraṃ upehisi. // // ",
  "dhp239:0": "",
  "dhp239:1": "anupubbena medhāvī ",
  "dhp239:2": "thokathokaṃ khaṇe khaṇe / ",
  "dhp239:3": "kammāro rajatasseva ",
  "dhp239:4": "niddhame malam attano. // // ayasā va ",
  "dhp240:0": "",
  "dhp240:1": "malaṃ samuṭṭhitaṃ ",
  "dhp240:2": "taduṭṭhāya tam eva khādati / ",
  "dhp240:3": "evaṃ atidhonacārinaṃ ",
  "dhp240:4": "sakakammāni nayanti duggatiṃ. // // ",
  "dhp241:0": "",
  "dhp241:1": "asajjhāyamalā mantā, ",
  "dhp241:2": "anuṭṭhānamalā gharā, / ",
  "dhp241:3": "malaṃ vaṇṇassa kosajjaṃ, ",
  "dhp241:4": "pamādo rakkhato malaṃ. // // mal' itthiyā ",
  "dhp242:0": "",
  "dhp242:1": "duccaritaṃ, ",
  "dhp242:2": "maccheraṃ dadato malaṃ, / ",
  "dhp242:3": "malā ve pāpakā dhammā ",
  "dhp242:4": "asmiṃ loke paramhi ca. // // ",
  "dhp243:1": "tato malā malataraṃ ",
  "dhp243:2": "avijjā paramaṃ malaṃ, / ",
  "dhp243:3": "etaṃ malaṃ pahatvāna ",
  "dhp243:4": "nimmalā hotha bhikkhavo. // // ",
  "dhp244:0": "",
  "dhp244:1": "sujīvaṃ ahirīkena ",
  "dhp244:2": "kākasūrena dhaṃsinā / ",
  "dhp244:3": "pakkhandinā pagabbhena ",
  "dhp244:4": "saṃkiliṭṭhena jīvitaṃ. // // ",
  "dhp245:1": "hirīmatā ca dujjīvaṃ ",
  "dhp245:2": "niccaṃ sucigavesinā / ",
  "dhp245:3": "alīnen' appagabbhena ",
  "dhp245:4": "suddhājīvena passatā. // // ",
  "dhp246:0": "",
  "dhp246:1": "yo pāṇaṃ atimāpeti ",
  "dhp246:2": "musāvādañ ca bhāsati / ",
  "dhp246:3": "loke adinnaṃ ādiyati ",
  "dhp246:4": "paradārañ ca gacchati, // // surāmerayapānañ ca ",
  "dhp247:1": "",
  "dhp247:2": "yo naro anuyuñjati / ",
  "dhp247:3": "idh' eva-m-eso lokasmiṃ ",
  "dhp247:4": "mūlaṃ khanati attano. // // ",
  "dhp248:1": "evaṃ bho purisa jānāhi: ",
  "dhp248:2": "pāpadhammā asaññatā, / ",
  "dhp248:3": "mā taṃ lobho adhammo ca ",
  "dhp248:4": "ciraṃ dukkhāya randhayuṃ. // // dadanti ",
  "dhp249:0": "",
  "dhp249:1": "ve yathāsaddhaṃ ",
  "dhp249:2": "yathāpasādanaṃ jano, / ",
  "dhp249:3": "tattha yo maṅku bhavati ",
  "dhp249:4": "paresaṃ pānabhojane / ",
  "dhp249:5": "na so divā vā rattiṃ vā ",
  "dhp249:6": "samādhiṃ adhigacchati. // // ",
  "dhp250:1": "yassa c' etaṃ samucchinnaṃ ",
  "dhp250:2": "mūlaghaccaṃ samūhataṃ / ",
  "dhp250:3": "sa ve divā vā rattiṃ vā ",
  "dhp250:4": "samādhiṃ adhigacchati. // // n' atthi ",
  "dhp251:0": "",
  "dhp251:1": "rāgasamo aggi ",
  "dhp251:2": "n' atthi dosasamo gaho / ",
  "dhp251:3": "n' atthi mohasamaṃ jālaṃ ",
  "dhp251:4": "n' atthi taṇhāsamā nadī. // // ",
  "dhp252:0": "",
  "dhp252:1": "sudassaṃ vajjam aññesaṃ ",
  "dhp252:2": "attano pana duddasaṃ, / ",
  "dhp252:3": "paresaṃ hi so vajjāni ",
  "dhp252:4": "opunāti yathā bhusaṃ, / ",
  "dhp252:5": "attano pana chādeti ",
  "dhp252:6": "kaliṃ va kitavā saṭho. // // ",
  "dhp253:0": "",
  "dhp253:1": "paravajjānupassissa ",
  "dhp253:2": "niccaṃ ujjhānasaññino / ",
  "dhp253:3": "āsavā tassa vaḍḍhanti ",
  "dhp253:4": "ārā so āsavakkhayā. // // ākāse ca ",
  "dhp254:0": "",
  "dhp254:1": "padaṃ n' atthi ",
  "dhp254:2": "samaṇo n' atthi bāhiro, / ",
  "dhp254:3": "papañcābhiratā pajā ",
  "dhp254:4": "nippapañcā tathāgatā. // // ākāse ca ",
  "dhp255:1": "padaṃ n' atthi ",
  "dhp255:2": "samaṇo n' atthi bāhiro / ",
  "dhp255:3": "saṃkhārā sassatā n' atthi ",
  "dhp255:4": "n' atthi ",
  "dhp255:5": "buddhānam iñjitaṃ. // // "
}
