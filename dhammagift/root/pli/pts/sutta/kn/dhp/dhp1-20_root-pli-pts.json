{
  "dhp1:0.1": "",
  "dhp1:0.2": "",
  "dhp1:0.3": "",
  "dhp1:0.4": "",
  "dhp1:1": "Dhammapada manopubbaṅgamā dhammā ",
  "dhp1:2": "manoseṭṭhā manomayā, / ",
  "dhp1:3": "manasā ce paduṭṭhena ",
  "dhp1:4": "bhāsatī vā karoti vā / ",
  "dhp1:5": "tato naṃ dukkham anveti ",
  "dhp1:6": "cakkaṃ va vahato padaṃ. // // ",
  "dhp2:0": "",
  "dhp2:1": "manopubbaṅgamā dhammā ",
  "dhp2:2": "manoseṭṭhā manomayā, / ",
  "dhp2:3": "manasā ce pasannena ",
  "dhp2:4": "bhāsatī vā karoti vā / ",
  "dhp2:5": "tato naṃ sukham anveti ",
  "dhp2:6": "chāyā va anapāyinī. // // ",
  "dhp3:0": "",
  "dhp3:1": "\"akkocchi maṃ avadhi maṃ ",
  "dhp3:2": "ajini maṃ ahāsi me\", / ",
  "dhp3:3": "ye taṃ upanayhanti ",
  "dhp3:4": "veraṃ tesaṃ na sammati. // // ",
  "dhp4:1": "\"akkocchi maṃ avadhi maṃ ",
  "dhp4:2": "ajini maṃ ahāsi me\", / ",
  "dhp4:3": "ye taṃ na upanayhanti ",
  "dhp4:4": "veraṃ tes' ūpasammati. // // ",
  "dhp5:0": "",
  "dhp5:1": "na hi verena verāni ",
  "dhp5:2": "sammant' idha kudācana / ",
  "dhp5:3": "averena ca sammanti, ",
  "dhp5:4": "esa dhammo sanantano. // // ",
  "dhp6:0": "",
  "dhp6:1": "pare ca na vijānanti: ",
  "dhp6:2": "\"mayam ettha yamāmase\", / ",
  "dhp6:3": "ye ca tattha vijānanti ",
  "dhp6:4": "tato sammanti medhagā. // // ",
  "dhp7:0": "",
  "dhp7:1": "subhānupassiṃ viharantaṃ ",
  "dhp7:2": "indriyesu asaṃvutaṃ / ",
  "dhp7:3": "bhojanamhi cāmattaññuṃ ",
  "dhp7:4": "kusītaṃ hīnavīriyaṃ / ",
  "dhp7:5": "taṃ ve pasahatī Māro ",
  "dhp7:6": "vāto rukkhaṃ va dubbalaṃ. // // ",
  "dhp8:1": "asubhānupassiṃ viharantaṃ ",
  "dhp8:2": "indriyesu susaṃvutaṃ / ",
  "dhp8:3": "bhojanamhi ca mattaññuṃ ",
  "dhp8:4": "saddhaṃ āraddhavīriyaṃ / ",
  "dhp8:5": "taṃ ve na-ppasahatī Māro ",
  "dhp8:6": "vāto selaṃ va pabbataṃ. // // ",
  "dhp9:0": "",
  "dhp9:1": "anikkasāvo kāsāvaṃ ",
  "dhp9:2": "yo vatthaṃ paridahessati / ",
  "dhp9:3": "apeto damasaccena ",
  "dhp9:4": "na so kāsāvam arahati. // // ",
  "dhp10:1": "yo ca vantakasāv' assa ",
  "dhp10:2": "sīlesu susamāhito / ",
  "dhp10:3": "upeto damasaccena ",
  "dhp10:4": "sa ve kāsāvam arahati. // // ",
  "dhp11:0": "",
  "dhp11:1": "asāre sāramatino ",
  "dhp11:2": "sāre cāsāradassino / ",
  "dhp11:3": "te sāraṃ nādhigacchanti ",
  "dhp11:4": "micchāsaṃkappagocarā. // // sārañ ca ",
  "dhp12:1": "sārato ñatvā ",
  "dhp12:2": "asārañ ca asārato / ",
  "dhp12:3": "te sāraṃ adhigacchanti ",
  "dhp12:4": "sammāsaṃkappagocarā. // // ",
  "dhp13:0": "",
  "dhp13:1": "yathā agāraṃ ducchannaṃ ",
  "dhp13:2": "vuṭṭhi samativijjhati / ",
  "dhp13:3": "evaṃ abhāvitaṃ cittaṃ ",
  "dhp13:4": "rāgo samativijjhati. // // ",
  "dhp14:1": "yathā agāraṃ succhannaṃ ",
  "dhp14:2": "vuṭṭhi na samativijjhati / ",
  "dhp14:3": "evaṃ subhāvitaṃ cittaṃ ",
  "dhp14:4": "rāgo na samativijjhati. // // ",
  "dhp15:0": "",
  "dhp15:1": "idha socati pecca socati ",
  "dhp15:2": "pāpakārī ubhayattha socati, / ",
  "dhp15:3": "so socati so vihaññati ",
  "dhp15:4": "disvā kammakiliṭṭham attano. // // ",
  "dhp16:0": "",
  "dhp16:1": "idha modati pecca modati ",
  "dhp16:2": "katapuñño ubhayattha modati, / ",
  "dhp16:3": "so modati so pamodati ",
  "dhp16:4": "disvā kammavisuddhim attano. // // ",
  "dhp17:0": "",
  "dhp17:1": "idha tappati pecca tappati ",
  "dhp17:2": "pāpakārī ubhayattha tappati, / ",
  "dhp17:3": "\"pāpaṃ me katan\" ti tappati. ",
  "dhp17:4": "bhiyyo tappati duggatiṃ gato. // // ",
  "dhp18:0": "",
  "dhp18:1": "idha nandati pecca nandati ",
  "dhp18:2": "katapuñño ubhayattha nandati, / ",
  "dhp18:3": "\"puññaṃ me katan\" ti nandati. ",
  "dhp18:4": "bhiyyo nandati suggatiṃ gato. // // bahum pi ",
  "dhp19:0": "",
  "dhp19:1": "ce sahitaṃ bhāsamāno ",
  "dhp19:2": "na takkaro hoti naro pamatto / ",
  "dhp19:3": "gopo va gāvo gaṇayaṃ paresaṃ ",
  "dhp19:4": "na bhāgavā sāmaññassa hoti. // // appam pi ",
  "dhp20:1": "ce sahitaṃ bhāsamāno ",
  "dhp20:2": "dhammassa hoti anudhammacārī / ",
  "dhp20:3": "rāgañ ca dosañ ca pahāya mohaṃ ",
  "dhp20:4": "sammappajāno suvimuttacitto / ",
  "dhp20:5": "anupādiyāno idha vā huraṃ vā ",
  "dhp20:6": "sa bhāgavā sāmaññassa hoti. // // ",
  "dhp20:7": ""
}
