  "dhp334:0.4": "",
  "dhp334:1": "manujassa pamattacārino ",
  "dhp334:2": "taṇhā vaḍḍhati māluvā viya, / ",
  "dhp334:3": "so palavatī hurāhuraṃ ",
  "dhp334:4": "phalam icchaṃ va vanasmi vānaro. // // ",
  "dhp335:1": "yaṃ esā sahatī jammī ",
  "dhp335:2": "taṇhā loke visattikā / ",
  "dhp335:3": "sokā tassa pavaḍḍhanti ",
  "dhp335:4": "abhivaṭṭhaṃ va bīraṇaṃ. // // ",
  "dhp336:1": "yo c' etaṃ sahatī jammiṃ ",
  "dhp336:2": "taṇhaṃ loke duraccayaṃ / ",
  "dhp336:3": "sokā tamhā papatanti ",
  "dhp336:4": "udabindu va pokkharā. // // ",
  "dhp337:1": "taṃ vo vadāmi bhaddaṃ vo ",
  "dhp337:2": "yāvant' ettha samāgatā / ",
  "dhp337:3": "taṇhāya mūlaṃ khanatha ",
  "dhp337:4": "usīrattho va bīraṇaṃ / ",
  "dhp337:5": "mā vo naḷaṃ va soto va ",
  "dhp337:6": "Māro bhañji punappunaṃ. // // ",
  "dhp338:0": "",
  "dhp338:1": "yathāpi mūle anupaddave daḷhe ",
  "dhp338:2": "chinno pi rukkho punar eva rūhati / ",
  "dhp338:3": "evam pi taṇhānusaye anūhate ",
  "dhp338:4": "nibbattati dukkham idaṃ punappunaṃ. // // ",
  "dhp339:1": "yassa chattiṃsatī sotā ",
  "dhp339:2": "manāpassavanā bhusā, / ",
  "dhp339:3": "vāhā vahanti duddiṭṭhaṃ ",
  "dhp339:4": "saṃkappā rāganissitā. // // ",
  "dhp340:1": "savanti sabbadā sotā, ",
  "dhp340:2": "latā ubbhijja tiṭṭhati / ",
  "dhp340:3": "tañ ca disvā lataṃ jātaṃ ",
  "dhp340:4": "mūlaṃ paññāya chindatha. // // ",
  "dhp341:1": "saritāni sinehitāni ca ",
  "dhp341:2": "somanassāni bhavanti jantuno / ",
  "dhp341:3": "te sātasitā sukhesino ",
  "dhp341:4": "te ve jātijarūpagā narā. // // ",
  "dhp342:1": "tasiṇāya purakkhatā pajā ",
  "dhp342:2": "parisappanti saso va bādhito, / ",
  "dhp342:3": "saññojanasaṅgasattakā ",
  "dhp342:4": "dukkham upenti punappunaṃ cirāya. // // ",
  "dhp343:1": "tasiṇāya purakkhatā pajā ",
  "dhp343:2": "parisappanti saso va bādhito, / ",
  "dhp343:3": "tasmā tasiṇaṃ vinodaye ",
  "dhp343:4": "bhikkhu ākaṃkha virāgam attano. // // ",
  "dhp344:0": "",
  "dhp344:1": "yo nibbanatho vanādhimutto ",
  "dhp344:2": "vanamutto vanam eva dhāvati / ",
  "dhp344:3": "taṃ puggalam eva passatha: ",
  "dhp344:4": "mutto bandhanam eva dhāvati. // // ",
  "dhp345:0": "",
  "dhp345:1": "na taṃ daḷhaṃ bandhanam āhu dhīrā ",
  "dhp345:2": "yad āyasaṃ dārujaṃ pabbajañ ca / ",
  "dhp345:3": "sārattarattā maṇikuṇḍalesu ",
  "dhp345:4": "puttesu dāresu ca yā apekhā, // // ",
  "dhp346:1": "etaṃ daḷhaṃ bandhanam āhu dhīrā ",
  "dhp346:2": "ohārinaṃ sithilaṃ duppamuñcaṃ / ",
  "dhp346:3": "etam pi chetvāna paribbajanti ",
  "dhp346:4": "anapekhino kāmasukhaṃ pahāya. // // ",
  "dhp347:0": "",
  "dhp347:1": "ye rāgarattānupatanti sotaṃ ",
  "dhp347:2": "sayaṃkataṃ makkaṭako va jālaṃ / ",
  "dhp347:3": "etam pi chetvāna vajanti dhīrā ",
  "dhp347:4": "anapekhino sabbadukkhaṃ pahāya. // // ",
  "dhp348:0": "",
  "dhp348:1": "muñca pure muñca pacchato ",
  "dhp348:2": "majjhe muñca bhavassa pāragū, / ",
  "dhp348:3": "sabbattha vimuttamānaso ",
  "dhp348:4": "na punañ jātijaraṃ upehisi. // // vitakkapamathitassa ",
  "dhp349:0": "",
  "dhp349:1": "jantuno ",
  "dhp349:2": "tibbarāgassa subhānupassino / ",
  "dhp349:3": "bhiyyo taṇhā pavaḍḍhati, ",
  "dhp349:4": "esa kho daḷhaṃ karoti bandhanaṃ. // // ",
  "dhp350:1": "vitakkūpasame ca yo rato ",
  "dhp350:2": "asubhaṃ bhāvayatī sadā sato / ",
  "dhp350:3": "esa kho vyantikāhiti ",
  "dhp350:4": "esa-cchecchati Mārabandhanaṃ. // // ",
  "dhp351:0": "",
  "dhp351:1": "niṭṭhaṅgato asantāsī ",
  "dhp351:2": "vītataṇho anaṅgaṇo / ",
  "dhp351:3": "acchidda bhavasallāni ",
  "dhp351:4": "antimo 'yaṃ samussayo. // // ",
  "dhp352:1": "vītataṇho anādāno ",
  "dhp352:2": "niruttipadakovido / ",
  "dhp352:3": "akkharānaṃ sannipātaṃ ",
  "dhp352:4": "jaññā pubbāparāni ca / ",
  "dhp352:5": "sa ve antimasārīro ",
  "dhp352:6": "mahāpañño mahāpuriso ti vuccati. // // ",
  "dhp353:0": "",
  "dhp353:1": "sabbābhibhū sabbavidū 'ham asmi ",
  "dhp353:2": "sabbesu dhammesu anūpalitto / ",
  "dhp353:3": "sabbañjaho taṇhakkhaye vimutto ",
  "dhp353:4": "sayaṃ abhiññāya kam uddiseyyaṃ. // // ",
  "dhp354:0": "",
  "dhp354:1": "sabbadānaṃ dhammadānaṃ jināti, ",
  "dhp354:2": "sabbaṃ rasaṃ dhammaraso jināti, / ",
  "dhp354:3": "sabbaṃ ratiṃ dhammaratī jināti, ",
  "dhp354:4": "taṇhakkhayo sabbadukkhaṃ jināti. // // ",
  "dhp355:0": "",
  "dhp355:1": "hananti bhogā dummedhaṃ ",
  "dhp355:2": "no ce pāragavesino, / ",
  "dhp355:3": "bhogataṇhāya dummedho ",
  "dhp355:4": "hanti aññe va attanaṃ. // // ",
  "dhp356:0": "",
  "dhp356:1": "tiṇadosāni khettāni, ",
  "dhp356:2": "rāgadosā ayaṃ pajā, / ",
  "dhp356:3": "tasmā hi vītarāgesu ",
  "dhp356:4": "dinnaṃ hoti mahapphalaṃ. // // ",
  "dhp357:1": "tiṇadosāni khettāni, ",
  "dhp357:2": "dosadosā ayaṃ pajā, / ",
  "dhp357:3": "tasmā hi vītadosesu ",
  "dhp357:4": "dinnaṃ hoti mahapphalaṃ. // // ",
  "dhp358:1": "tiṇadosāni khettāni, ",
  "dhp358:2": "mohadosā ayaṃ pajā, / ",
  "dhp358:3": "tasmā hi vītamohesu ",
  "dhp358:4": "dinnaṃ hoti mahapphalaṃ. // // ",
  "dhp359:1": "tiṇadosāni khettāni, ",
  "dhp359:2": "icchādosā ayaṃ pajā, / ",
  "dhp359:3": "tasmā hi vigaticchesu ",
  "dhp359:4": "dinnaṃ hoti mahapphalaṃ. // // ",
  "dhp359:5": ""
}
