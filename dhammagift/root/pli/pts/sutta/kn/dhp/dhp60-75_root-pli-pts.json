  "dhp60:0.4": "",
  "dhp60:1": "dīghā jāgarato rattī ",
  "dhp60:2": "dīghaṃ santassa yojanaṃ / ",
  "dhp60:3": "dīgho bālānaṃ saṃsāro ",
  "dhp60:4": "saddhammaṃ avijānataṃ. // // carañ ce ",
  "dhp61:0": "",
  "dhp61:1": "nādhigaccheyya ",
  "dhp61:2": "seyyaṃ sadisam attano / ",
  "dhp61:3": "ekacariyaṃ daḷhaṃ kayirā ",
  "dhp61:4": "n' atthi bāle sahāyatā. // // ",
  "dhp62:0": "",
  "dhp62:1": "\"puttā m' atthi dhanaṃ m' atthi\" ",
  "dhp62:2": "iti bālo vihaññati / ",
  "dhp62:3": "attā hi attano n' atthi ",
  "dhp62:4": "kuto puttā kuto dhanaṃ. // // ",
  "dhp63:0": "",
  "dhp63:1": "yo bālo maññatī balyaṃ ",
  "dhp63:2": "paṇḍito vāpi tena so, / ",
  "dhp63:3": "bālo ca paṇḍitamānī ",
  "dhp63:4": "sa ve bālo ti vuccati. // // yāvajīvam pi ",
  "dhp64:0": "",
  "dhp64:1": "ce bālo ",
  "dhp64:2": "paṇḍitaṃ payirupāsati / ",
  "dhp64:3": "na so dhammaṃ vijānāti ",
  "dhp64:4": "dabbī sūparasaṃ yathā. // // muhuttam api ",
  "dhp65:0": "",
  "dhp65:1": "ce viññū ",
  "dhp65:2": "paṇḍitaṃ payirupāsati / ",
  "dhp65:3": "khippaṃ dhammaṃ vijānāti ",
  "dhp65:4": "jivhā sūparasaṃ yathā. // // ",
  "dhp66:0": "",
  "dhp66:1": "caranti bālā dummedhā ",
  "dhp66:2": "amitteneva attanā / ",
  "dhp66:3": "karontā pāpakaṃ kammaṃ ",
  "dhp66:4": "yaṃ hoti kaṭukapphalaṃ. // // ",
  "dhp67:0": "",
  "dhp67:1": "na taṃ kammaṃ kataṃ sādhu ",
  "dhp67:2": "yaṃ katvā anutappati / ",
  "dhp67:3": "yassa assumukho rodaṃ ",
  "dhp67:4": "vipākaṃ paṭisevati. // // tañ ca ",
  "dhp68:0": "",
  "dhp68:1": "kammaṃ kataṃ sādhu ",
  "dhp68:2": "yaṃ katvā nānutappati / ",
  "dhp68:3": "yassa patīto sumano ",
  "dhp68:4": "vipākaṃ paṭisevati. // // madhuvā ",
  "dhp69:0": "",
  "dhp69:1": "maññatī bālo ",
  "dhp69:2": "yāva pāpaṃ na paccati / ",
  "dhp69:3": "yadā ca paccatī pāpaṃ ",
  "dhp69:4": "atha bālo dukkhaṃ nigacchati. // // ",
  "dhp70:0": "",
  "dhp70:1": "māse māse kusaggena ",
  "dhp70:2": "bālo bhuñjetha bhojanaṃ / ",
  "dhp70:3": "na so saṃkhatadhammānaṃ ",
  "dhp70:4": "kalaṃ nāgghati soḷasiṃ. // // ",
  "dhp71:0": "",
  "dhp71:1": "na hi pāpaṃ kataṃ kammaṃ ",
  "dhp71:2": "sajju khīraṃ va mucchati / ",
  "dhp71:3": "ḍahantam bālam anveti ",
  "dhp71:4": "bhasmācchanno va pāvako. // // yāvad eva ",
  "dhp72:0": "",
  "dhp72:1": "anatthāya ",
  "dhp72:2": "ñattaṃ bālassa jāyati / ",
  "dhp72:3": "hanti bālassa sukkaṃsaṃ ",
  "dhp72:4": "muddham assa vipātayaṃ. // // asataṃ bhāvanam iccheyya purekkhārañ ca ",
  "dhp73:0": "",
  "dhp73:1": "",
  "dhp73:2": "bhikkhusu / ",
  "dhp73:3": "āvāsesu ca issariyaṃ ",
  "dhp73:4": "pūjā parakulesu ca. // // \"mam' eva ",
  "dhp74:1": "kata maññantu ",
  "dhp74:2": "gihī pabbajitā ubho, / ",
  "dhp74:3": "mam' evātivasā assu ",
  "dhp74:4": "kiccākiccesu kismici\", / ",
  "dhp74:5": "iti bālassa saṃkappo, ",
  "dhp74:6": "icchā māno ca vaḍḍhati. // // ",
  "dhp75:0": "",
  "dhp75:1": "aññā hi lābhūpanisā ",
  "dhp75:2": "aññā nibbānagāminī, / ",
  "dhp75:3": "evam etaṃ abhiññāya ",
  "dhp75:4": "bhikkhu Buddhassa sāvako / ",
  "dhp75:5": "sakkāraṃ nābhinandeyya ",
  "dhp75:6": "vivekam anubrūhaye. // // ",
  "dhp75:7": "nidhīnaṃ va "
}
