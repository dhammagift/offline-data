{
  "dhp273:0.1": "",
  "dhp273:0.2": "",
  "dhp273:0.3": "",
  "dhp273:0.4": "",
  "dhp273:1": "seṭṭho ",
  "dhp273:2": "saccānaṃ caturo padā, / ",
  "dhp273:3": "virāgo seṭṭho dhammānaṃ ",
  "dhp273:4": "dipadānañ ca cakkhumā. // // es' eva ",
  "dhp274:1": "maggo n' atth' añño ",
  "dhp274:2": "dassanassa visuddhiyā, / ",
  "dhp274:3": "etaṃ hi tumhe paṭipajjatha, ",
  "dhp274:4": "Mārass' etaṃ pamohanaṃ. // // etaṃ hi ",
  "dhp275:1": "tumhe paṭipannā ",
  "dhp275:2": "dukkhass' antaṃ karissatha, / ",
  "dhp275:3": "akkhāto ve mayā maggo ",
  "dhp275:4": "aññāya sallasanthanaṃ. // // ",
  "dhp276:1": "tumhehi kiccaṃ ātappaṃ, ",
  "dhp276:2": "akkhātāro tathāgatā, / ",
  "dhp276:3": "paṭipannā pamokkhanti ",
  "dhp276:4": "jhāyino Mārabandhanā. // // ",
  "dhp277:0": "",
  "dhp277:1": "\"sabbe saṃkhārā aniccā\" ti ",
  "dhp277:2": "yadā paññāya passati / ",
  "dhp277:3": "atha nibbindatī dukkhe, ",
  "dhp277:4": "esa maggo visuddhiyā. // // ",
  "dhp278:0": "",
  "dhp278:1": "\"sabbe saṃkhārā dukkhā\" ti ",
  "dhp278:2": "yadā paññāya passati / ",
  "dhp278:3": "atha nibbindatī dukkhe, ",
  "dhp278:4": "esa maggo visuddhiyā. // // ",
  "dhp279:0": "",
  "dhp279:1": "\"sabbe dhammā anattā\" ti ",
  "dhp279:2": "yadā paññāya passati / ",
  "dhp279:3": "atha nibbindatī dukkhe, ",
  "dhp279:4": "esa maggo visuddhiyā. // // ",
  "dhp280:0": "",
  "dhp280:1": "uṭṭhānakālamhi anuṭṭhahāno ",
  "dhp280:2": "yuvā balī ālasiyaṃ upeto / ",
  "dhp280:3": "saṃsannasaṃkappamano kusīto ",
  "dhp280:4": "paññāya maggaṃ alaso na vindati. // // ",
  "dhp281:0": "",
  "dhp281:1": "vācānurakkhī manasā susaṃvuto ",
  "dhp281:2": "kāyena ca akusalaṃ na kayirā / ",
  "dhp281:3": "ete tayo kammapathe visodhaye, ",
  "dhp281:4": "ārādhaye maggam isippaveditaṃ. // // ",
  "dhp282:0": "",
  "dhp282:1": "yogā ve jāyati bhūrī ",
  "dhp282:2": "ayogā bhūrisaṃkhayo / ",
  "dhp282:3": "etaṃ dvedhāpathaṃ ñatvā ",
  "dhp282:4": "bhavāya vibhavāya ca / ",
  "dhp282:5": "tath' attānaṃ niveseyya ",
  "dhp282:6": "yathā bhūrī pavaḍḍhati. // // ",
  "dhp283:0": "",
  "dhp283:1": "vanaṃ chindatha, mā rukkhaṃ, ",
  "dhp283:2": "vanato jāyatī bhayaṃ, / ",
  "dhp283:3": "chetvā vanaṃ vanathañ ca ",
  "dhp283:4": "nibbanā hotha bhikkhavo. // // yāvaṃ ",
  "dhp284:1": "hi vanatho na chijjati ",
  "dhp284:2": "aṇumatto pi narassa nārisu / ",
  "dhp284:3": "paṭibaddhamano va tāva so ",
  "dhp284:4": "vaccho khīrapako va mātari. // // ",
  "dhp285:0": "",
  "dhp285:1": "ucchinda sineham attano ",
  "dhp285:2": "kumudaṃ sāradikaṃ va pāṇinā, / ",
  "dhp285:3": "santimaggam eva brūhaya ",
  "dhp285:4": "nibbānaṃ sugatena desitaṃ. // // ",
  "dhp286:0": "",
  "dhp286:1": "idha vassaṃ vasissāmi ",
  "dhp286:2": "idha hemantagimhisu / ",
  "dhp286:3": "iti bālo vicinteti ",
  "dhp286:4": "antarāyaṃ na bujjhati. // // ",
  "dhp287:0": "",
  "dhp287:1": "taṃ puttapasusammattaṃ ",
  "dhp287:2": "byāsattamanasaṃ naraṃ / ",
  "dhp287:3": "suttaṃ gāmaṃ mahogho va ",
  "dhp287:4": "maccu ādāya gacchati. // // ",
  "dhp288:0": "",
  "dhp288:1": "na santi puttā tāṇāya ",
  "dhp288:2": "na pitā na pi bandhavā / ",
  "dhp288:3": "antakenādhipannassa ",
  "dhp288:4": "n' atthi ñātīsu tāṇatā. // // etam atthavasaṃ ",
  "dhp289:1": "ñatvā ",
  "dhp289:2": "paṇḍito sīlasaṃvuto / ",
  "dhp289:3": "nibbānagamanaṃ maggaṃ ",
  "dhp289:4": "khippam eva visodhaye. // // ",
  "dhp289:5": ""
}
