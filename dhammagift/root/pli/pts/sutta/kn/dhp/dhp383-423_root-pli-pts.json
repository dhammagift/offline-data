  "dhp383:0.3": "",
  "dhp383:0.4": "",
  "dhp383:1": "chinda sotaṃ parakkamma, ",
  "dhp383:2": "kāme panuda brāhmaṇa, / ",
  "dhp383:3": "saṃkhārānaṃ khayaṃ ñatvā ",
  "dhp383:4": "akataññū si brāhmaṇa. // // ",
  "dhp384:0": "",
  "dhp384:1": "yadā dvayesu dhammesu ",
  "dhp384:2": "pāragū hoti brāhmaṇo / ",
  "dhp384:3": "ath' assa sabbe saṃyogā ",
  "dhp384:4": "atthaṃ gacchanti jānato. // // ",
  "dhp385:0": "",
  "dhp385:1": "yassa pāraṃ apāraṃ vā ",
  "dhp385:2": "pārāpāraṃ na vijjati / ",
  "dhp385:3": "vītaddaraṃ visaññuttaṃ ",
  "dhp385:4": "tam ahaṃ brūmi brāhmaṇaṃ. // // ",
  "dhp386:0": "",
  "dhp386:1": "jhāyiṃ virajam āsīnaṃ ",
  "dhp386:2": "katakiccaṃ anāsavaṃ / ",
  "dhp386:3": "uttamatthaṃ anuppattaṃ ",
  "dhp386:4": "tam ahaṃ brūmi brāhmaṇaṃ. // // ",
  "dhp387:0": "",
  "dhp387:1": "divā tapati ādicco, ",
  "dhp387:2": "rattiṃ ābhāti candimā, / ",
  "dhp387:3": "sannaddho khattiyo tapati, ",
  "dhp387:4": "jhāyī tapati brāhmaṇo, / ",
  "dhp387:5": "atha sabbam ahorattiṃ ",
  "dhp387:6": "Buddho tapati tejasā. // // bāhitapāpo ti ",
  "dhp388:0": "",
  "dhp388:1": "brāhmaṇo ",
  "dhp388:2": "samacariyā samaṇo ti vuccati. / ",
  "dhp388:3": "pabbājayam attano malaṃ ",
  "dhp388:4": "tasmā pabbajito ti vuccati. // // ",
  "dhp389:0": "",
  "dhp389:1": "na brāhmaṇassa pahareyya ",
  "dhp389:2": "nāssa muñcetha brāhmaṇo, / ",
  "dhp389:3": "dhī brāhmaṇassa hantāraṃ, ",
  "dhp389:4": "tato dhī y' assa muñcati. // // ",
  "dhp390:1": "na brāhmaṇass' etad akiñci seyyo ",
  "dhp390:2": "yadā nisedho manaso piyehi, / ",
  "dhp390:3": "yato yato hiṃsamano nivattati ",
  "dhp390:4": "tato tato sammati-m-eva dukkhaṃ. // // ",
  "dhp391:0": "",
  "dhp391:1": "yassa kāyena vācāya ",
  "dhp391:2": "manasā n' atthi dukkataṃ / ",
  "dhp391:3": "saṃvutaṃ tīhi ṭhānehi ",
  "dhp391:4": "tam ahaṃ brūmi brāhmaṇaṃ. // // ",
  "dhp392:0": "",
  "dhp392:1": "yamhā dhammaṃ vijāneyya ",
  "dhp392:2": "sammāsambuddhadesitaṃ / ",
  "dhp392:3": "sakkaccaṃ taṃ namasseyya ",
  "dhp392:4": "aggihuttaṃ va brāhmaṇo. // // ",
  "dhp393:0": "",
  "dhp393:1": "na jaṭāhi na gottena ",
  "dhp393:2": "na jaccā hoti brāhmaṇo, / ",
  "dhp393:3": "yamhi saccañ ca dhammo ca ",
  "dhp393:4": "so sukhī so ca brāhmaṇo. // // kin ",
  "dhp394:0": "",
  "dhp394:1": "te jaṭāhi dummedha, ",
  "dhp394:2": "kin te ajinasāṭiyā, / ",
  "dhp394:3": "abbhantaran te gahanaṃ, ",
  "dhp394:4": "bāhiraṃ parimajjasi. // // ",
  "dhp395:0": "",
  "dhp395:1": "paṃsukūladharaṃ jantuṃ ",
  "dhp395:2": "kisaṃ dhamanisanthataṃ / ",
  "dhp395:3": "ekaṃ vanasmiṃ jhāyantaṃ ",
  "dhp395:4": "tam ahaṃ brūmi brāhmaṇaṃ. // // ",
  "dhp396:0": "",
  "dhp396:1": "na cāhaṃ brāhmaṇaṃ brūmi ",
  "dhp396:2": "yonijaṃ mattisambhavaṃ / ",
  "dhp396:3": "bhovādi nāma so hoti ",
  "dhp396:4": "sa ve hoti sakiñcano, / ",
  "dhp396:5": "akiñcanaṃ anādānaṃ ",
  "dhp396:6": "tam ahaṃ brūmi brāhmaṇaṃ. // // ",
  "dhp397:0": "",
  "dhp397:1": "sabbasaṃyojanaṃ chetvā ",
  "dhp397:2": "yo ve na paritassati / ",
  "dhp397:3": "saṅgātigaṃ visaṃyuttaṃ ",
  "dhp397:4": "tam ahaṃ brūmi brāhmaṇam. // // ",
  "dhp398:0": "",
  "dhp398:1": "chetvā nandhiṃ varattañ ca ",
  "dhp398:2": "sandānaṃ sahanukkamaṃ / ",
  "dhp398:3": "ukkhittapaḷighaṃ buddhaṃ ",
  "dhp398:4": "tam ahaṃ brūmi brāhmaṇaṃ. // // ",
  "dhp399:0": "",
  "dhp399:1": "akkosaṃ vadhabandhañ ca ",
  "dhp399:2": "aduṭṭho yo titikkhati / ",
  "dhp399:3": "khantībalaṃ balānīkaṃ ",
  "dhp399:4": "tam ahaṃ brūmi brāhmaṇaṃ. // // ",
  "dhp400:0": "",
  "dhp400:1": "akkodhanaṃ vatavantaṃ ",
  "dhp400:2": "sīlavantaṃ anussutaṃ / ",
  "dhp400:3": "dantaṃ antimasārīraṃ ",
  "dhp400:4": "tam ahaṃ brūmi brāhmaṇaṃ. // // ",
  "dhp401:0": "",
  "dhp401:1": "vāri pokkharapatte va ",
  "dhp401:2": "āragge-r-iva sāsapo / ",
  "dhp401:3": "yo na lippati kāmesu ",
  "dhp401:4": "tam ahaṃ brūmi brāhmaṇaṃ // // ",
  "dhp402:0": "",
  "dhp402:1": "yo dukkhassa pajānāti ",
  "dhp402:2": "idh' eva khayam attano / ",
  "dhp402:3": "pannabhāraṃ visaññuttaṃ ",
  "dhp402:4": "tam ahaṃ brūmi brāhmaṇaṃ. // // ",
  "dhp403:0": "",
  "dhp403:1": "gambhīrapaññaṃ medhāviṃ ",
  "dhp403:2": "maggāmaggassa kovidaṃ / ",
  "dhp403:3": "uttamatthaṃ anuppattaṃ ",
  "dhp403:4": "tam ahaṃ brūmi brāhmaṇaṃ. // // ",
  "dhp404:0": "",
  "dhp404:1": "asaṃsaṭṭhaṃ gahaṭṭhehi ",
  "dhp404:2": "anāgārehi c' ūbhayaṃ / ",
  "dhp404:3": "anokasāriṃ appicchaṃ ",
  "dhp404:4": "tam ahaṃ brūmi brāhmaṇaṃ. // // ",
  "dhp405:0": "",
  "dhp405:1": "nidhāya daṇḍaṃ bhūtesu ",
  "dhp405:2": "tasesu thāvaresu ca / ",
  "dhp405:3": "yo na hanti na ghāteti ",
  "dhp405:4": "tam ahaṃ brūmi brāhmaṇaṃ. // // ",
  "dhp406:0": "",
  "dhp406:1": "aviruddhaṃ viruddhesu ",
  "dhp406:2": "attadaṇḍesu nibbutaṃ / ",
  "dhp406:3": "sādānesu anādānaṃ ",
  "dhp406:4": "tam ahaṃ brūmi brāhmaṇaṃ. // // ",
  "dhp407:0": "",
  "dhp407:1": "yassa rāgo ca doso ca ",
  "dhp407:2": "māno makkho ca pātito / ",
  "dhp407:3": "sāsapo-r-iva āraggā ",
  "dhp407:4": "tam ahaṃ brūmi brāhmaṇaṃ. // // ",
  "dhp408:0": "",
  "dhp408:1": "akakkasaṃ viññāpaniṃ ",
  "dhp408:2": "giraṃ saccaṃ udīraye / ",
  "dhp408:3": "yāya nābhisaje kañci ",
  "dhp408:4": "tam ahaṃ brūmi brāhmaṇaṃ. // // yo 'dha ",
  "dhp409:0": "",
  "dhp409:1": "dīghaṃ va rassaṃ vā ",
  "dhp409:2": "aṇuṃthūlaṃ subhāsubhaṃ / ",
  "dhp409:3": "loke adinnaṃ nādiyate ",
  "dhp409:4": "tam ahaṃ brūmi brāhmaṇaṃ. // // ",
  "dhp410:0": "",
  "dhp410:1": "āsā yassa na vijjanti ",
  "dhp410:2": "asmiṃ loke paramhi ca / ",
  "dhp410:3": "nirāsayaṃ visaṃyuttaṃ ",
  "dhp410:4": "tam ahaṃ brūmi brāhmaṇaṃ. // // ",
  "dhp411:0": "",
  "dhp411:1": "yassālayā na vijjanti ",
  "dhp411:2": "aññāya akathaṃkathī / ",
  "dhp411:3": "amatogadhaṃ anuppattaṃ ",
  "dhp411:4": "tam ahaṃ brūmi brāhmaṇaṃ. // // yo 'dha puññañ ca pāpañ ca ",
  "dhp412:0": "",
  "dhp412:1": "",
  "dhp412:2": "ubho saṅgaṃ upaccagā / ",
  "dhp412:3": "asokaṃ virajaṃ suddhaṃ ",
  "dhp412:4": "tam ahaṃ brūmi brāhmaṇaṃ. // // candaṃ va ",
  "dhp413:0": "",
  "dhp413:1": "vimalaṃ suddhaṃ ",
  "dhp413:2": "vippasannam anāvilaṃ / ",
  "dhp413:3": "nandībhavaparikkhīṇaṃ ",
  "dhp413:4": "tam ahaṃ brūmi brāhmaṇaṃ. // // yo imaṃ ",
  "dhp414:0": "",
  "dhp414:1": "palipathaṃ duggaṃ ",
  "dhp414:2": "saṃsāraṃ moham accagā / ",
  "dhp414:3": "tiṇṇo pāragato jhāyī ",
  "dhp414:4": "anejo akathaṃkathī / ",
  "dhp414:5": "anupādāya nibbuto ",
  "dhp414:6": "tam ahaṃ brūmi brāhmaṇaṃ. // // yo 'dha ",
  "dhp415:0": "",
  "dhp415:1": "kāme pahatvāna ",
  "dhp415:2": "anāgāro paribbaje / ",
  "dhp415:3": "kāmābhavaparikkhīṇaṃ ",
  "dhp415:4": "tam ahaṃ brūmi brāhmaṇaṃ. // // yo 'dha ",
  "dhp416:0": "",
  "dhp416:1": "taṇhaṃ pahatvāna ",
  "dhp416:2": "anāgāro paribbaje / ",
  "dhp416:3": "taṇhābhavaparikkhīṇaṃ ",
  "dhp416:4": "tam ahaṃ brūmi brāhmaṇaṃ. // // ",
  "dhp416:5.0": "",
  "dhp416:5.1": "",
  "dhp416:6": "",
  "dhp416:7": "",
  "dhp416:8": "",
  "dhp417:0": "",
  "dhp417:1": "hitvā mānusakaṃ yogaṃ ",
  "dhp417:2": "dibbaṃ yogaṃ upaccagā / ",
  "dhp417:3": "sabbayogavisaṃyuttaṃ ",
  "dhp417:4": "tam ahaṃ brūmi brāhmaṇaṃ. // // ",
  "dhp418:0": "",
  "dhp418:1": "hitvā ratiñ ca aratiñ ca ",
  "dhp418:2": "sītibhūtaṃ nirūpadhiṃ / ",
  "dhp418:3": "sabbalokābhibhuṃ vīraṃ ",
  "dhp418:4": "tam ahaṃ brūmi brāhmaṇaṃ. // // ",
  "dhp419:0": "",
  "dhp419:1": "cutiṃ yo vedi sattānaṃ ",
  "dhp419:2": "upapattiñ ca sabbaso / ",
  "dhp419:3": "asattaṃ sugataṃ buddhaṃ ",
  "dhp419:4": "tam ahaṃ brūmi brāhmaṇaṃ. // // ",
  "dhp420:1": "yassa gatiṃ na jānanti ",
  "dhp420:2": "devā gandhabbamānusā / ",
  "dhp420:3": "khīṇāsavaṃ arahantaṃ ",
  "dhp420:4": "tam ahaṃ brūmi brāhmaṇaṃ. // // ",
  "dhp421:0": "",
  "dhp421:1": "yassa pure ca pacchā ca ",
  "dhp421:2": "majjhe ca n' atthi kiñcanaṃ / ",
  "dhp421:3": "akiñcanaṃ anādānaṃ ",
  "dhp421:4": "tam ahaṃ brūmi brāhmaṇaṃ. // // ",
  "dhp422:0": "",
  "dhp422:1": "usabhaṃ pavaraṃ vīraṃ ",
  "dhp422:2": "mahesiṃ vijitāvinaṃ / ",
  "dhp422:3": "anejaṃ nhātakaṃ buddhaṃ ",
  "dhp422:4": "tam ahaṃ brūmi brāhmaṇaṃ. // // ",
  "dhp423:0": "",
  "dhp423:1": "pubbenivāsaṃ yo vedi ",
  "dhp423:2": "saggāpāyañ ca passati / ",
  "dhp423:3": "atho jātikkhayaṃ patto ",
  "dhp423:4": "abhiññāvosito muni / ",
  "dhp423:5": "sabbavositavosānaṃ ",
  "dhp423:6": "tam ahaṃ brūmi brāhmaṇaṃ.1 // // ",
  "dhp423:7": "",
  "dhp423:8": "yamakaṃ appamādaṃ ",
  "dhp423:9": "",
  "dhp423:10": "",
  "dhp423:11": "",
  "dhp423:12": "",
  "dhp423:13": "",
  "dhp423:14": "cittaṃ ",
  "dhp423:15": "pupphaṃ bālena paṇḍitaṃ / ",
  "dhp423:16": "arahantaṃ sahassena ",
  "dhp423:17": "pāpaṃ daṇḍena, te dasa. // // ",
  "dhp423:18": "jarā attā ca loko ca ",
  "dhp423:19": "buddhaṃ sukhaṃ piyena ca / ",
  "dhp423:20": "kodhaṃ malañ ca dhammaṭṭhaṃ ",
  "dhp423:21": "maggavaggena vīsati. // // ",
  "dhp423:22": "pakiṇṇaṃ nirayaṃ nāgo ",
  "dhp423:23": "taṇhaṃ bhikkhu ca brāhmaṇo, / ",
  "dhp423:24": "ete chabbīsatī vaggā ",
  "dhp423:25": "desitādiccabandhunā. // // ",
