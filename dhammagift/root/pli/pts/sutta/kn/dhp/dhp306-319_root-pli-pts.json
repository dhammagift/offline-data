  "dhp306:0.3": "",
  "dhp306:0.4": "",
  "dhp306:1": "abhūtavādī nirayaṃ upeti ",
  "dhp306:2": "yo vāpi katvā na karomi c' āha / ",
  "dhp306:3": "ubho pi te pecca samā bhavanti ",
  "dhp306:4": "nihīnakammā manujā parattha. // // ",
  "dhp307:0": "",
  "dhp307:1": "kāsāvakaṇṭhā bahavo ",
  "dhp307:2": "pāpadhammā asaññatā, / ",
  "dhp307:3": "pāpā pāpehi kammehi ",
  "dhp307:4": "nirayaṃ te upapajjare. // // ",
  "dhp308:0": "",
  "dhp308:1": "seyyo ayoguḷo bhutto ",
  "dhp308:2": "tatto aggisikhūpamo / ",
  "dhp308:3": "yañ ce bhuñjeyya dussīlo ",
  "dhp308:4": "raṭṭhapiṇḍaṃ asaññato. // // ",
  "dhp309:0": "",
  "dhp309:1": "cattāri ṭhānāni naro pamatto ",
  "dhp309:2": "āpajjatī paradārūpasevī: / ",
  "dhp309:3": "apuññalābhaṃ na nikāmaseyyaṃ ",
  "dhp309:4": "nindaṃ tatīyaṃ nirayaṃ catutthaṃ. // // ",
  "dhp310:1": "apuññalābho ca gatī ca pāpikā ",
  "dhp310:2": "bhītassa bhītāya ratī ca thokikā / ",
  "dhp310:3": "rājā ca daṇḍaṃ garukaṃ paṇeti, ",
  "dhp310:4": "tasmā naro paradāraṃ na seve. // // ",
  "dhp311:0": "",
  "dhp311:1": "kuso yathā duggahīto ",
  "dhp311:2": "hatthaṃ evānukantati / ",
  "dhp311:3": "sāmaññaṃ dupparāmaṭṭhaṃ ",
  "dhp311:4": "nirayāy' upakaḍḍhati. // // ",
  "dhp312:1": "yaṃ kiñci saṭhilaṃ kammaṃ ",
  "dhp312:2": "saṃkiliṭṭhañ ca yaṃ vataṃ / ",
  "dhp312:3": "saṃkassaraṃ brahmacariyaṃ ",
  "dhp312:4": "na taṃ hoti mahapphalaṃ. // // kayirañ ",
  "dhp313:1": "ce kayirāth' enaṃ ",
  "dhp313:2": "daḷham enaṃ parakkame, / ",
  "dhp313:3": "saṭhilo hi paribbājo ",
  "dhp313:4": "bhiyyo ākirate rajaṃ. // // ",
  "dhp314:0": "",
  "dhp314:1": "akataṃ dukkataṃ seyyo ",
  "dhp314:2": "pacchā tapati dukkataṃ, / ",
  "dhp314:3": "katañ ca sukataṃ seyyo ",
  "dhp314:4": "yaṃ katvā nānutappati. // // ",
  "dhp315:0": "",
  "dhp315:1": "nagaraṃ yathā paccantaṃ ",
  "dhp315:2": "guttaṃ santarabāhiraṃ / ",
  "dhp315:3": "evaṃ gopetha attānaṃ, ",
  "dhp315:4": "khaṇo ve mā upaccagā, / ",
  "dhp315:5": "khaṇātītā hi socanti ",
  "dhp315:6": "nirayamhi samappitā. // // ",
  "dhp316:0": "",
  "dhp316:1": "alajjitāye lajjanti ",
  "dhp316:2": "lajjitāye na lajjare / ",
  "dhp316:3": "micchādiṭṭhisamādānā ",
  "dhp316:4": "sattā gacchanti duggatiṃ. // // ",
  "dhp317:1": "abhaye bhayadassino ",
  "dhp317:2": "bhaye cābhayadassino / ",
  "dhp317:3": "micchādiṭṭhisamādānā ",
  "dhp317:4": "sattā gacchanti duggatiṃ. // // ",
  "dhp318:0": "",
  "dhp318:1": "avajje vajjamatino ",
  "dhp318:2": "vajje cāvajjadassino / ",
  "dhp318:3": "micchādiṭṭhisamādānā ",
  "dhp318:4": "sattā gacchanti duggatiṃ. // // vajjañ ca ",
  "dhp319:1": "vajjato ñatvā ",
  "dhp319:2": "avajjañ ca avajjato / ",
  "dhp319:3": "sammādiṭṭhisamādānā ",
  "dhp319:4": "sattā gacchanti suggatiṃ.3 // // ",
  "dhp319:5": ""
}
