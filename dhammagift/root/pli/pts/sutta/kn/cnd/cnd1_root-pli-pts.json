  "cnd1:0.3": "",
  "cnd1:0.4": "Culla Niddesa. 1. Vatthugāthā. (=976): ",
  "cnd1:1.1": "Kosalānaṃ purā rammā ",
  "cnd1:1.2": "agamā Dakkhiṇāpathaṃ ",
  "cnd1:1.3": "ākiñcaññaṃ patthayāno ",
  "cnd1:1.4": "brāhmaṇo mantapāragū. (=977): ",
  "cnd1:2.1": "So Assakassa visaye ",
  "cnd1:2.2": "Muḷakassa samāsane ",
  "cnd1:2.3": "vasī Godhāvarīkūle ",
  "cnd1:2.4": "uñchena ca phalena ca. (=978): ",
  "cnd1:3.1": "Tass' eva upanissāya ",
  "cnd1:3.2": "gāmo ca vipulo ahu, ",
  "cnd1:3.3": "tato jātena āyena ",
  "cnd1:3.4": "mahāyaññam akappayi, (=979): ",
  "cnd1:4.1": "Mahāyaññaṃ yajitvāna ",
  "cnd1:4.2": "puna pāvisi assamaṃ. ",
  "cnd1:4.3": "Tasmiṃ patipaviṭṭhamhi ",
  "cnd1:4.4": "añño āgañchi brāhmaṇo (=980): ",
  "cnd1:5.1": "Ugghaṭṭapādo tasito ",
  "cnd1:5.2": "paṅkadanto rajassiro, ",
  "cnd1:5.3": "so ca naṃ upasaṅkamma ",
  "cnd1:5.4": "satāni pañca yācati. (=981): ",
  "cnd1:6.1": "Tam enaṃ Bāvarī disvā ",
  "cnd1:6.2": "āsanena nimantayi, ",
  "cnd1:6.3": "sukhañ ca kusalaṃ pucchi, ",
  "cnd1:6.4": "idaṃ vacanam abravi: (=982): ",
  "cnd1:7.1": "\"Yaṃ kho mamaṃ deyyadhammaṃ ",
  "cnd1:7.2": "sabbaṃ vissajjitam mayā, ",
  "cnd1:7.3": "anujānāhi me brahme, ",
  "cnd1:7.4": "n' atthi pañca satāni me.\" (=983): ",
  "cnd1:8.1": "\"Sace me yācamānassa ",
  "cnd1:8.2": "bhavaṃ n' ānupadassati, ",
  "cnd1:8.3": "sattame divase tuyhaṃ ",
  "cnd1:8.4": "muddhā phalatu sattadhā.\" (=984): ",
  "cnd1:9.1": "Abhisaṅkharitvā kuhako ",
  "cnd1:9.2": "bheravaṃ so akittayi, ",
  "cnd1:9.3": "tassa taṃ vacanaṃ sutvā ",
  "cnd1:9.4": "Bāvarī dukkhito ahu, (=985): ",
  "cnd1:10.1": "Ussussati anāhāro ",
  "cnd1:10.2": "sokasalla-samappito, ",
  "cnd1:10.3": "atho pi evaṃ-cittassa ",
  "cnd1:10.4": "jhāne na ramatī mano. (=986): ",
  "cnd1:11.1": "Utrastaṃ dukkhitaṃ disvā ",
  "cnd1:11.2": "devatā atthakāminī. ",
  "cnd1:11.3": "Bāvariṃ upasaṅkamma ",
  "cnd1:11.4": "idaṃ vacanam abravi: (=987): ",
  "cnd1:12.1": "\"Na so muddhaṃ pajānāti, ",
  "cnd1:12.2": "kuhako so dhan' atthiko, ",
  "cnd1:12.3": "muddhani muddhapāte vā ",
  "cnd1:12.4": "ñāṇaṃ tassa na vijjati.\" (=988): ",
  "cnd1:13.1": "\"Bhotī carahi jānāti, ",
  "cnd1:13.2": "tam me akkhāhi pucchitā ",
  "cnd1:13.3": "muddhaṃ muddhādhipātañ ca, ",
  "cnd1:13.4": "taṃ suṇoma vaco tava.\" (=989): ",
  "cnd1:14.1": "\"Aham p' etaṃ na jānāmi, ",
  "cnd1:14.2": "ñāṇam m' ettha na vijjati, ",
  "cnd1:14.3": "muddhaṃ muddhādhipāto ca ",
  "cnd1:14.4": "Jinānaṃ h' eta dassanaṃ.\" (=990): ",
  "cnd1:15.1": "\"Atha ko carahi jānāti ",
  "cnd1:15.2": "asmiṃ puthavimaṇḍale ",
  "cnd1:15.3": "muddhaṃ muddhādhipātañ ca, ",
  "cnd1:15.4": "tam me akkhāhi devate.\" (=991): ",
  "cnd1:16.1": "\"Purā Kapilavatthumhā ",
  "cnd1:16.2": "nikkhanto lokanāyako ",
  "cnd1:16.3": "apacco Okkākarājassa ",
  "cnd1:16.4": "Sakyaputto pabhaṅkaro. (=992): ",
  "cnd1:17.1": "So hi brāhmaṇa sambuddho ",
  "cnd1:17.2": "sabbadhammānapāragū ",
  "cnd1:17.3": "sabb' ābhiññā-balappatto ",
  "cnd1:17.4": "sabba-dhammesu cakkhumā ",
  "cnd1:17.5": "sabba-dhamma-kkhayaṃ patto ",
  "cnd1:17.6": "vimutto upadhikkhaye, (=993): ",
  "cnd1:18.1": "Buddho so Bhagavā loke ",
  "cnd1:18.2": "dhammaṃ deseti cakkhumā ",
  "cnd1:18.3": "taṃ tvaṃ gantvāna pucchassu, ",
  "cnd1:18.4": "so te taṃ byākarissati.\" (=994): ",
  "cnd1:19.1": "‘Sambuddho' ti vaco sutvā ",
  "cnd1:19.2": "udaggo Bāvarī ahu, ",
  "cnd1:19.3": "sok' assa tanuko āsi, ",
  "cnd1:19.4": "pītiñ ca vipulaṃ labhi. (=995): ",
  "cnd1:20.1": "So Bāvarī attamano udaggo ",
  "cnd1:20.2": "taṃ devataṃ pucchati Vedajāto: ",
  "cnd1:20.3": "\"katamamhi gāme nigamamhi vā puna ",
  "cnd1:20.4": "katamamhi vā janapade lokanātho, ",
  "cnd1:20.5": "yattha gantvā namassemu ",
  "cnd1:20.6": "Sambuddhaṃ dipa-duttamaṃ.\" (=996): ",
  "cnd1:21.1": "\"Sāvatthiyaṃ Kosalamandire Jino ",
  "cnd1:21.2": "pahūta-pañño vara-bhūrimedhaso, ",
  "cnd1:21.3": "so Sakyaputto vidhuro anāsavo ",
  "cnd1:21.4": "muddhādhipātassa vidū narāsabho.\" (=997): ",
  "cnd1:22.1": "Tato āmantayi sisse ",
  "cnd1:22.2": "brāhmaṇe mantapārage: ",
  "cnd1:22.3": "\"etha māṇavā, akkhissaṃ, ",
  "cnd1:22.4": "suṇotha vacanaṃ mama: (=998): ",
  "cnd1:23.1": "Yass' eso dullabho loke ",
  "cnd1:23.2": "pātubhāvo abhiṇhaso, ",
  "cnd1:23.3": "sv-ajja lokamhi uppanno ",
  "cnd1:23.4": "Sambuddho iti vissuto, ",
  "cnd1:23.5": "khippaṃ gantvāna Sāvatthim ",
  "cnd1:23.6": "passavho dipa-d- ",
  "cnd1:24.1": "uttamaṃ.\" (=999): \"Kathañ carahi jānemu ",
  "cnd1:24.2": "disvā ‘Buddho' ti brāhmaṇa, ",
  "cnd1:24.3": "ajānatan no pabrūhi, ",
  "cnd1:24.4": "yathā jānemu taṃ mayaṃ.\" (=1000): ",
  "cnd1:25.1": "\"Āgatāni hi mantesu ",
  "cnd1:25.2": "mahāpurisa-lakkhaṇā ",
  "cnd1:25.3": "dvattiṃsā ca byakkhātā ",
  "cnd1:25.4": "samattā anupubbaso. (=1001): ",
  "cnd1:26.1": "Yass' ete honti gattesu ",
  "cnd1:26.2": "mahāpurisa-lakkhaṇā, ",
  "cnd1:26.3": "dve yeva tassa gatiyo, ",
  "cnd1:26.4": "tatiyā hi na vijjati. (=1002): ",
  "cnd1:27.1": "Sace agāraṃ āvasati, ",
  "cnd1:27.2": "vijeyya paṭhaviṃ imaṃ ",
  "cnd1:27.3": "adaṇḍena asatthena ",
  "cnd1:27.4": "dhammena-m-anusāsati; (=1003): ",
  "cnd1:28.1": "Sace ca so pabbajati ",
  "cnd1:28.2": "agārā anagāriyaṃ, ",
  "cnd1:28.3": "vivaṭa-cchado sambuddho ",
  "cnd1:28.4": "arahā bhavati anuttaro. (=1004): ",
  "cnd1:29.1": "Jātiṃ gottañ ca lakkhaṇaṃ ",
  "cnd1:29.2": "mante sisse pun' āpare ",
  "cnd1:29.3": "muddhaṃ muddhādhipātañ ca ",
  "cnd1:29.4": "manasā yeva pucchatha. (=1005): ",
  "cnd1:30.1": "Anāvaraṇadassāvī ",
  "cnd1:30.2": "yadi buddho bhavissati, ",
  "cnd1:30.3": "manasā pucchite pañhe ",
  "cnd1:30.4": "vācāya vissajessati.\" (=1006): ",
  "cnd1:31.1": "Bāvarissa vaco sutvā ",
  "cnd1:31.2": "sissā solasa brāhmaṇā ",
  "cnd1:31.3": "Ajito Tissa-Metteyyo ",
  "cnd1:31.4": "Puṇṇako atha Mettagū. (=1007): ",
  "cnd1:32.1": "Dhotako Upasīvo ca ",
  "cnd1:32.2": "Nando ca atha Hemako ",
  "cnd1:32.3": "Todeyya-Kappā d' ubhayo ",
  "cnd1:32.4": "Jatukaṇṇī ca paṇḍito (=1008): ",
  "cnd1:33.1": "Bhadrāvudho Udayo ca ",
  "cnd1:33.2": "Posālo cā pi brāhmaṇo ",
  "cnd1:33.3": "Mogharājā ca medhāvī ",
  "cnd1:33.4": "Piṅgiyo ca mahā isi, (=1009): ",
  "cnd1:34.1": "Pacceka-gaṇino sabbe ",
  "cnd1:34.2": "sabba-lokassa vissutā ",
  "cnd1:34.3": "jhāyī jhānaratā dhīrā ",
  "cnd1:34.4": "pubba-vāsana-vāsitā (=1010): ",
  "cnd1:35.1": "Bāvariṃ abhivādetvā ",
  "cnd1:35.2": "katvā ca naṃ padakkhiṇaṃ ",
  "cnd1:35.3": "jaṭājinadharā sabbe ",
  "cnd1:35.4": "pakkāmuṃ uttarāmukhā: (=1011): ",
  "cnd1:36.1": "Muḷakassa Patiṭṭhānaṃ ",
  "cnd1:36.2": "purimaṃ Māhissatiṃ tadā ",
  "cnd1:36.3": "Ujjeniñ c' āpi Gonaddhaṃ ",
  "cnd1:36.4": "Vedisaṃ Vanasavhayaṃ, (=1012): ",
  "cnd1:37.1": "Kosambiṃ cā pi Sāketaṃ ",
  "cnd1:37.2": "Sāvatthiñ ca pur' uttamaṃ ",
  "cnd1:37.3": "Setabyaṃ Kapilavatthuṃ ",
  "cnd1:37.4": "Kusinārañ ca mandiraṃ, (=1013): ",
  "cnd1:38.1": "Pāvañ ca Bhoganagaraṃ ",
  "cnd1:38.2": "Vesāliṃ Māgadhaṃ puraṃ ",
  "cnd1:38.3": "Pāsāṇakañ cetiyañ ca ",
  "cnd1:38.4": "ramaṇīyaṃ manoramaṃ. (=1014): ",
  "cnd1:39.1": "Tasito v' udakaṃ sītaṃ ",
  "cnd1:39.2": "mahālābhaṃ va vāṇijo ",
  "cnd1:39.3": "chāyaṃ ghamm' ābhitatto va ",
  "cnd1:39.4": "turitā pabbatam āruhuṃ, (=1015): ",
  "cnd1:40.1": "Bhagavā ca tamhi samaye ",
  "cnd1:40.2": "bhikkhu-saṅgha-purakkhato ",
  "cnd1:40.3": "bhikkhūnaṃ dhammaṃ deseti, ",
  "cnd1:40.4": "sīho va nadati vane. (=1016): ",
  "cnd1:41.1": "Ajito addasa Sambuddhaṃ vītaraṃsi ",
  "cnd1:41.2": "va bhāṇumaṃ ",
  "cnd1:41.3": "candaṃ yathā pannarase ",
  "cnd1:41.4": "pāripūriṃ upāgataṃ. (=1017): ",
  "cnd1:42.1": "Ath' assa gatte disvāna ",
  "cnd1:42.2": "paripūrañ ca byañjanaṃ ",
  "cnd1:42.3": "ekamantaṃ ṭhito haṭṭho ",
  "cnd1:42.4": "manopañhe apucchatha: (=1018): ",
  "cnd1:43.1": "\"Ādissa jammanaṃ brūhi, ",
  "cnd1:43.2": "gottaṃ brūhi salakkhaṇaṃ, ",
  "cnd1:43.3": "mantesu pāramiṃ brūhi , ",
  "cnd1:43.4": "kati vāceti brāhmaṇo.\" (=1019): ",
  "cnd1:44.1": "\"Vīsaṃ-vassasataṃ āyu, ",
  "cnd1:44.2": "so ca gottena Bāvari, ",
  "cnd1:44.3": "tīṇ' assa lakkhaṇā gatte ",
  "cnd1:44.4": "tiṇṇaṃ vedāna pāragū. (=1020): ",
  "cnd1:45.1": "Lakkhaṇe itihāse ca ",
  "cnd1:45.2": "sanighaṇḍu-sakeṭubhe, ",
  "cnd1:45.3": "pañca satāni vāceti ",
  "cnd1:45.4": "sadhamme pāramiṃ gato.\" (=1021): ",
  "cnd1:46.1": "Lakkhaṇānaṃ pavicayaṃ ",
  "cnd1:46.2": "Bāvarissa nar' uttama ",
  "cnd1:46.3": "taṇhacchida pakāsehi, ",
  "cnd1:46.4": "mā no kaṅkhāyitaṃ ahu.\" (=1022): ",
  "cnd1:47.1": "\"Mukhaṃ jivhāya chādeti, ",
  "cnd1:47.2": "uṇṇ' assa bhamukantare, ",
  "cnd1:47.3": "kosohitaṃ vatthaguyhaṃ: ",
  "cnd1:47.4": "evaṃ jānāhi māṇava.\" (=1023): ",
  "cnd1:48.1": "Pucchaṃ hi kiñci asuṇanto ",
  "cnd1:48.2": "sutvā pañhe viyākate ",
  "cnd1:48.3": "vicinteti jano sabbo ",
  "cnd1:48.4": "vedajāto katañjali: (=1024): ",
  "cnd1:49.1": "‘Ko nu devo va Brahmā vā ",
  "cnd1:49.2": "Indo vā pi Sujampati ",
  "cnd1:49.3": "Manasā pucchi te pañhe, ",
  "cnd1:49.4": "kam etaṃ paṭibhāsati.' (=1025): ",
  "cnd1:50.1": "\"Muddhaṃ muddhādhipātañ ca ",
  "cnd1:50.2": "Bāvarī paripucchati, ",
  "cnd1:50.3": "taṃ byākarohi Bhagavā, ",
  "cnd1:50.4": "kaṅkhaṃ vinaya no ise.\" (=1026): ",
  "cnd1:51.1": "\"Avijjā muddhā ti jānāhi, ",
  "cnd1:51.2": "vijjā muddhādhipātinī ",
  "cnd1:51.3": "saddhā-sati-samādhīhi ",
  "cnd1:51.4": "chanda-viriyena saṃyutā.\" (=1027): ",
  "cnd1:52.1": "Tato vedena mahatā ",
  "cnd1:52.2": "santhambhitvāna māṇavo ",
  "cnd1:52.3": "ekaṃsaṃ ajinaṃ katvā ",
  "cnd1:52.4": "pādesu sirasā pati: (=1028): ",
  "cnd1:53.1": "\"Bāvarī brāhmaṇo bhoto ",
  "cnd1:53.2": "saha sissehi mārisa ",
  "cnd1:53.3": "udaggacitto sumano ",
  "cnd1:53.4": "pāde vandati cakkhuma.\" (=1029): ",
  "cnd1:54.1": "\"Sukhito Bāvarī hotu ",
  "cnd1:54.2": "saha sissehi brāhmaṇo, ",
  "cnd1:54.3": "tvañ cā pi sukhito hohi, ",
  "cnd1:54.4": "ciraṃ jīvāhi māṇava. (=1030): ",
  "cnd1:55.1": "Bāvarissa ca tuyhaṃ vā ",
  "cnd1:55.2": "sabbesaṃ sabba-saṃsayaṃ ",
  "cnd1:55.3": "kat' āvakāsā pucchavho, ",
  "cnd1:55.4": "yam kiñci manas' icchatha.\" (=1031): ",
  "cnd1:56.1": "Sambuddhena kat' okāso ",
  "cnd1:56.2": "nisīditvāna pañjalī ",
  "cnd1:56.3": "Ajito paṭhamaṃ pañhaṃ ",
  "cnd1:56.4": "tattha pucchi Tathāgataṃ. ",
  "cnd1:56.5": "VATTHUGĀTHĀ NIṬṬHITĀ. (=1032): \"Kena-ssu "
}
