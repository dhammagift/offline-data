  "bv10:1.1": "Anomadassissa aparena ",
  "bv10:1.2": "sambuddho dvipad' uttamo / ",
  "bv10:1.3": "Padumo nāma nāmena ",
  "bv10:1.4": "asamo appaṭipuggalo // // ",
  "bv10:2.1": "Tassāpi asamaṃ sīlaṃ ",
  "bv10:2.2": "samādhī pi anantakā / ",
  "bv10:2.3": "asaṅkheyyaṃ ñāṇavaraṃ ",
  "bv10:2.4": "vimuttī ca anūpamā // // ",
  "bv10:3.1": "Tassāpi atulatejassa ",
  "bv10:3.2": "dhammacakkappavattane / ",
  "bv10:3.3": "abhisamayā tayo āsuṃ ",
  "bv10:3.4": "mahātamapavāhanā // // ",
  "bv10:4.1": "Paṭhamābhisamaye buddho ",
  "bv10:4.2": "koṭisatam-abodhayī / ",
  "bv10:4.3": "dutiyābhisamaye dhīro ",
  "bv10:4.4": "navutikoṭim-abodhayī // // ",
  "bv10:5.1": "Yadā ca Padumo buddho ",
  "bv10:5.2": "ovadī sakam-atrajaṃ / ",
  "bv10:5.3": "tadā asītikoṭīnaṃ ",
  "bv10:5.4": "tatiyābhisamayo ahu // // ",
  "bv10:6.1": "Sannipātā tayo āsuṃ ",
  "bv10:6.2": "Padumassa mahesino / ",
  "bv10:6.3": "koṭisatasahassānaṃ ",
  "bv10:6.4": "paṭhamo āsi samāgamo // // ",
  "bv10:7.1": "Kaṭhin' atthārasamaye ",
  "bv10:7.2": "uppanne kaṭhinacīvare / ",
  "bv10:7.3": "dhammasenāpat' atthāya ",
  "bv10:7.4": "bhikkhū sibbiṃsu cīvaraṃ // // ",
  "bv10:8.1": "Tadā te vimalā bhikkhū ",
  "bv10:8.2": "chaḷabhiññā mah' iddhikā / ",
  "bv10:8.3": "tīṇi satasahassāni ",
  "bv10:8.4": "samiṃsu aparājitā // // ",
  "bv10:9.1": "Punāparaṃ so narāsabho ",
  "bv10:9.2": "pavane vāsam-upāgami, / ",
  "bv10:9.3": "tadā samāgamo āsi ",
  "bv10:9.4": "dvinnaṃ satasahassinaṃ // // ",
  "bv10:10.1": "Ahaṃ tena samayena ",
  "bv10:10.2": "sīho āsiṃ migādhibhū / ",
  "bv10:10.3": "vivekam-anubrūhantaṃ ",
  "bv10:10.4": "pavane addasaṃ jinaṃ // // ",
  "bv10:11.1": "Vanditvā sirasā pāde ",
  "bv10:11.2": "katvāna taṃ padakkhiṇaṃ / ",
  "bv10:11.3": "tikkhattuṃ abhināditvā ",
  "bv10:11.4": "sattāhaṃ jinam-upaṭṭhahiṃ // // ",
  "bv10:12.1": "Sattāhā varasamāpattiyā ",
  "bv10:12.2": "uṭṭhahitvā tathāgato / ",
  "bv10:12.3": "manasā cintayitvāna ",
  "bv10:12.4": "koṭibhikkhū samānayī // // ",
  "bv10:13.1": "Tadā pi so mahāvīro ",
  "bv10:13.2": "tesaṃ majjhe viyākarī: / ",
  "bv10:13.3": "aparimeyye ito kappe ",
  "bv10:13.4": "ayaṃ buddho bhavissati // // ",
  "bv10:14.1": "Padhānaṃ padahitvāva katvā ",
  "bv10:14.2": "dukkarakārikaṃ / ",
  "bv10:14.3": "assatthamūle sambuddho bujjhissati mahāyaso // // ",
  "bv10:15.1": "Tassāpi vacanaṃ sutvā ",
  "bv10:15.2": "bhiyyo cittaṃ pasādayiṃ / ",
  "bv10:15.3": "uttariṃ vatam-adhiṭṭhāsiṃ ",
  "bv10:15.4": "dasapāramipūriyā // // ",
  "bv10:16.1": "Campakaṃ nāma nagaraṃ ",
  "bv10:16.2": "Asamo nāma khattiyo / ",
  "bv10:16.3": "Asamā nāma janikā ",
  "bv10:16.4": "Padumassa mahesino // // ",
  "bv10:17.1": "Dasavassasahassāni ",
  "bv10:17.2": "agāraṃ ajjha so vasi / ",
  "bv10:17.3": "Nandā ca Suyasā Uttarā ",
  "bv10:17.4": "tayo pāsāda-m-uttamā // // ",
  "bv10:18.1": "Tettiṃsasatasahassāni ",
  "bv10:18.2": "nāriyo samalaṅkatā / ",
  "bv10:18.3": "Uttarā nāma sā nārī ",
  "bv10:18.4": "Rammo nāmāsi atrajo // // ",
  "bv10:19.1": "Nimitte caturo disvā ",
  "bv10:19.2": "rathayānena nikkhami / ",
  "bv10:19.3": "anūnakaṃ aḍḍhamāsaṃ ",
  "bv10:19.4": "padhānaṃ padahī jino // // ",
  "bv10:20.1": "Brahmunā yācito santo ",
  "bv10:20.2": "Padumo lokanāyako / ",
  "bv10:20.3": "vatti cakkaṃ mahāvīro ",
  "bv10:20.4": "Dhanañjay' uyyāna-m-uttame // // ",
  "bv10:21.1": "Sālo ca Upasālo ca ",
  "bv10:21.2": "ahesuṃ aggasāvakā / ",
  "bv10:21.3": "Varuṇo nām' upaṭṭhāko ",
  "bv10:21.4": "Padumassa mahesino // // ",
  "bv10:22.1": "Rādhā c' eva Surādhā ca ",
  "bv10:22.2": "ahesuṃ aggasāvikā / ",
  "bv10:22.3": "bodhi tassa bhagavato ",
  "bv10:22.4": "mahāsoṇo 'ti vuccati // // ",
  "bv10:23.1": "Bhiyyo c' eva Asamo ca ",
  "bv10:23.2": "ahesuṃ agg' upaṭṭhakā / ",
  "bv10:23.3": "Rucī ca Nandarāmā ca ",
  "bv10:23.4": "ahesuṃ agg' upaṭṭhikā // // ",
  "bv10:24.1": "Aṭṭhapaññāsaratanaṃ ",
  "bv10:24.2": "accuggato mahāmuni / ",
  "bv10:24.3": "pabhā niddhāvatī tassa ",
  "bv10:24.4": "asamā sabbaso disā // // ",
  "bv10:25.1": "Candappabhā suriyappabhā ",
  "bv10:25.2": "ratan' agghimaṇippabhā / ",
  "bv10:25.3": "sabbā pi tā hatā honti ",
  "bv10:25.4": "patvā jinapabh' uttamaṃ // // ",
  "bv10:26.1": "Vassasatasahassāni ",
  "bv10:26.2": "āyu vijjati tāvade / ",
  "bv10:26.3": "tāvatā tiṭṭhamāno so ",
  "bv10:26.4": "tāresi janataṃ bahuṃ // // ",
  "bv10:27.1": "Paripakkamānase satte ",
  "bv10:27.2": "bodhayitvā asesato / ",
  "bv10:27.3": "sesake anusāsitvā ",
  "bv10:27.4": "nibbuto so sasāvako // // ",
  "bv10:28.1": "Urago va tacaṃ jiṇṇaṃ ",
  "bv10:28.2": "vuddhapattaṃ va pādapo / ",
  "bv10:28.3": "jahitvā sabbasaṅkhāre ",
  "bv10:28.4": "nibbuto so yathā sikhī // // ",
  "bv10:29.1": "Padumo jinavaro satthā ",
  "bv10:29.2": "Dhammārāmamhi nibbuto / ",
  "bv10:29.3": "dhātuvitthārikaṃ āsi ",
  "bv10:29.4": "tesu tesu padesato 'ti // // ",
  "bv10:30.1": "Padumassa bhagavato vaṃso aṭṭhamo "
}
