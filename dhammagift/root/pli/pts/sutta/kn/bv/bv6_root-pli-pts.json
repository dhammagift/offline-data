  "bv6:1.1": "Maṅgalassa aparena ",
  "bv6:1.2": "Sumano nāma nāyako / ",
  "bv6:1.3": "sabbadhammehi asamo ",
  "bv6:1.4": "sabbasattānam-uttamo // // So pi ",
  "bv6:2.1": "tadā amatabheriṃ ",
  "bv6:2.2": "ahanī Mekhale pure, / ",
  "bv6:2.3": "dhammasaṅkhasamāyuttaṃ ",
  "bv6:2.4": "navaṅgaṃ jinasāsanaṃ // // ",
  "bv6:3.1": "Nijjinitvā kilese so ",
  "bv6:3.2": "patvā sambodhim-uttamaṃ / ",
  "bv6:3.3": "māpesi nagaraṃ satthā ",
  "bv6:3.4": "dhammapuravar' uttamaṃ // // ",
  "bv6:4.1": "Nirantaraṃ akuṭilaṃ ",
  "bv6:4.2": "ujuṃ vipulavitthataṃ / ",
  "bv6:4.3": "māpesi so mahāvīthiṃ ",
  "bv6:4.4": "satipaṭṭhānavar' uttamaṃ // // ",
  "bv6:5.1": "Phale cattāri sāmaññe ",
  "bv6:5.2": "catasso paṭisambhidā / ",
  "bv6:5.3": "chaḷabhiññāṭṭhasamāpatti ",
  "bv6:5.4": "pasāresi tattha vīthiyaṃ // // ",
  "bv6:6.1": "Ye appamattā akhilā ",
  "bv6:6.2": "hiriviriyeh' upāgatā / ",
  "bv6:6.3": "te te ime guṇavare ",
  "bv6:6.4": "ādiyanti yathā sukhaṃ // // ",
  "bv6:7.1": "Evam-etena yogena ",
  "bv6:7.2": "uddharanto mahājanaṃ / ",
  "bv6:7.3": "bodhesi paṭhamaṃ satthā ",
  "bv6:7.4": "koṭisahassiyo // // ",
  "bv6:8.1": "Yamhi kāle mahāvīro ",
  "bv6:8.2": "ovadī titthiye gaṇe / ",
  "bv6:8.3": "koṭisahassābhisamiṃsu ",
  "bv6:8.4": "dutiye dhammadesane // // ",
  "bv6:9.1": "Yadā devā manussā ca ",
  "bv6:9.2": "samaggā ekamānasā / ",
  "bv6:9.3": "nirodhapañhaṃ pucchiṃsu ",
  "bv6:9.4": "saṃsayañcāpi mānasaṃ, // // ",
  "bv6:10.1": "Tadā pi dhammadesane ",
  "bv6:10.2": "nirodhaparidīpane / ",
  "bv6:10.3": "navutikoṭisahassānaṃ ",
  "bv6:10.4": "tatiyābhisamayo ahu // // ",
  "bv6:11.1": "Sannipātā tayo āsuṃ ",
  "bv6:11.2": "Sumanassa mahesino / ",
  "bv6:11.3": "khīṇāsavānaṃ vimalānaṃ ",
  "bv6:11.4": "santacittāna tādinaṃ // // ",
  "bv6:12.1": "Vassaṃ vutthassa bhagavato ",
  "bv6:12.2": "abhighuṭṭhe pavāraṇe / ",
  "bv6:12.3": "koṭisatasahassehi ",
  "bv6:12.4": "pavāresi tathāgato // // ",
  "bv6:13.1": "Tato paraṃ sannipāte ",
  "bv6:13.2": "vimale Kañcanapabbate / ",
  "bv6:13.3": "navutikoṭisahassānaṃ ",
  "bv6:13.4": "dutiyo āsi samāgamo // // ",
  "bv6:14.1": "Yadā Sakko devarājā ",
  "bv6:14.2": "buddhadassan' upāgami / ",
  "bv6:14.3": "asītikoṭisahassānaṃ ",
  "bv6:14.4": "tatiyo āsi samāgamo // // ",
  "bv6:15.1": "Ahaṃ tena samayena ",
  "bv6:15.2": "nāgarājā mah' iddhiko / ",
  "bv6:15.3": "Atulo nāma nāmena ",
  "bv6:15.4": "ussannakusalasañcayo // // ",
  "bv6:16.1": "Tadā' haṃ nāgabhavanā ",
  "bv6:16.2": "nikkhamitvā sañātibhi / ",
  "bv6:16.3": "nāgānaṃ dibbaturiyehi ",
  "bv6:16.4": "sasaṅghaṃ jinam-upaṭṭhahiṃ // // ",
  "bv6:17.1": "Koṭisatasahassānaṃ ",
  "bv6:17.2": "annapānena tappayiṃ / ",
  "bv6:17.3": "paccekadussayugaṃ datvā ",
  "bv6:17.4": "saraṇaṃ taṃ upāgamiṃ // // ",
  "bv6:18.1": "So pi maṃ buddho vyākāsi ",
  "bv6:18.2": "Sumano lokanāyako: / ",
  "bv6:18.3": "aparimeyye ito kappe ",
  "bv6:18.4": "ayaṃ buddho bhavissati // // ",
  "bv6:19.1": "Padhānaṃ padahitvāna ",
  "bv6:19.2": "katvā dukkarakārikaṃ / ",
  "bv6:19.3": "assatthamūle sambuddho bujjhissati mahāyaso // // ",
  "bv6:20.1": "Tassāpi vacanaṃ sutvā ",
  "bv6:20.2": "bhiyyo cittaṃ pasādayiṃ / ",
  "bv6:20.3": "uttariṃ vatam-adhiṭṭhāsiṃ ",
  "bv6:20.4": "dasapāramipūriyā // // ",
  "bv6:21.1": "Mekhalaṃ nāma nagaraṃ ",
  "bv6:21.2": "Sudatto nāma khattiyo / ",
  "bv6:21.3": "Sirimā nāma janikā ",
  "bv6:21.4": "Sumanassa mahesino // // ",
  "bv6:22.1": "Navavassasahassāni ",
  "bv6:22.2": "agāraṃ ajjha so vasi / ",
  "bv6:22.3": "Cando Sucando Vaṭaṃso ca ",
  "bv6:22.4": "tayo pāsāda-m-uttamā // // ",
  "bv6:23.1": "Tesaṭṭhisatasahassāni ",
  "bv6:23.2": "nāriyo samalaṅkatā, / ",
  "bv6:23.3": "Vaṭaṃsikā nāma nārī ",
  "bv6:23.4": "Anūpamo nāma atrajo // // ",
  "bv6:24.1": "Nimitte caturo disvā ",
  "bv6:24.2": "hatthiyānena nikkhami / ",
  "bv6:24.3": "anūnadasamāsāni ",
  "bv6:24.4": "padhānaṃ padahī jino // // ",
  "bv6:25.1": "Brahmunā yacito santo ",
  "bv6:25.2": "Sumano lokanāyako / ",
  "bv6:25.3": "vatti cakkaṃ mahāvīro ",
  "bv6:25.4": "Mekhale puravar' uttame // // ",
  "bv6:26.1": "Saraṇo Bhāvitatto ca ",
  "bv6:26.2": "ahesuṃ aggasāvakā / ",
  "bv6:26.3": "Udeno nām' upaṭṭhāko ",
  "bv6:26.4": "Sumanassa mahesino // // ",
  "bv6:27.1": "Soṇā ca Upasoṇā ca ",
  "bv6:27.2": "ahesuṃ aggasāvikā / ",
  "bv6:27.3": "so pi buddho amitayaso ",
  "bv6:27.4": "nāgamūle abujjhatha // // ",
  "bv6:28.1": "Varuṇo ca Saraṇo ca ",
  "bv6:28.2": "ahesuṃ agg' upaṭṭhakā / ",
  "bv6:28.3": "Cālā ca Upacālā ca ",
  "bv6:28.4": "ahesuṃ agg' upaṭṭhikā // // ",
  "bv6:29.1": "Uccattanena so buddho ",
  "bv6:29.2": "navutihatthasamuggato / ",
  "bv6:29.3": "kañcan' agghiyasaṅkāso ",
  "bv6:29.4": "dasasahassī virocatha // // ",
  "bv6:30.1": "Navutivassasahassāni ",
  "bv6:30.2": "āyu vijjati tāvade / ",
  "bv6:30.3": "tāvatā tiṭṭhamāno so ",
  "bv6:30.4": "tāresi janataṃ bahuṃ // // ",
  "bv6:31.1": "Tāraṇīye tārayitvā ",
  "bv6:31.2": "bodhanīye ca bodhayī / ",
  "bv6:31.3": "parinibbāyi sambuddho ",
  "bv6:31.4": "ulurājā va atthamī // // ",
  "bv6:32.1": "Te pi khīṇāsavā bhikkhū ",
  "bv6:32.2": "so pi buddho asādiso / ",
  "bv6:32.3": "atulaṃ pabhaṃ dassayitvā ",
  "bv6:32.4": "nibbutā te mahāyasā // // ",
  "bv6:33.1": "Tañca ñāṇaṃ atuliyaṃ ",
  "bv6:33.2": "tāni cātuliyāni ratanāni / ",
  "bv6:33.3": "sabbaṃ samantarahitaṃ ",
  "bv6:33.4": "nanu rittā sabbasaṅkhārā // // ",
  "bv6:34.1": "Sumano yasadharo buddho ",
  "bv6:34.2": "Aṅgārāmamhi nibbuto / ",
  "bv6:34.3": "tatth' eva tassa jinathūpo ",
  "bv6:34.4": "catuyojana-m-uggato ti // // ",
  "bv6:35.1": "Sumanassa bhagavato vaṃso catuttho "
}
