  "bv1:77.4": "mett' upekkhā ca kīdisā // // ",
  "bv1:78.1": "Dasapāramī tayā dhīra ",
  "bv1:78.2": "kīdisā lokanāyaka / ",
  "bv1:78.3": "kathaṃ upapāramī puṇṇā ",
  "bv1:78.4": "param' atthapāramī kathaṃ // // ",
  "bv1:79.1": "Tassa puṭṭho viyākāsi ",
  "bv1:79.2": "karavīkamadhuraṅgiro / ",
  "bv1:79.3": "nibbāpayanto hadayaṃ ",
  "bv1:79.4": "hāsayanto sadevakaṃ // // ",
  "bv1:80.1": "Atītabuddhānaṃ jinānaṃ desitaṃ ",
  "bv1:80.2": "nikīḷitaṃ buddhaparamparāgataṃ / ",
  "bv1:80.3": "pubbenivāsānugatāya buddhiyā ",
  "bv1:80.4": "pakāsayī lokahitaṃ sadevake // // ",
  "bv1:81.1": "Pītipāmojjajananaṃ ",
  "bv1:81.2": "sokasallavinodanaṃ / ",
  "bv1:81.3": "sabbasampattipaṭilābhaṃ ",
  "bv1:81.4": "cittīkatvā suṇātha me // // ",
  "bv1:82.1": "Madanimmadanaṃ sokanudaṃ ",
  "bv1:82.2": "saṃsāraparimocanaṃ / ",
  "bv1:82.3": "sabbadukkhakkhayaṃ maggaṃ ",
  "bv1:82.4": "sakkaccaṃ paṭipajjathā 'ti // // ",
  "bv1:83.1": "Ratanacaṅkamanakaṇḍaṃ niṭṭhitaṃ "
}
