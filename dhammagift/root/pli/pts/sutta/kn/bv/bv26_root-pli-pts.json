  "bv26:1.1": "Koṇāgamanassa aparena ",
  "bv26:1.2": "sambuddho dvipad' uttamo / ",
  "bv26:1.3": "Kassapo nāma nāmena ",
  "bv26:1.4": "dhammarājā pabhaṅkaro // // ",
  "bv26:2.1": "Sañchaḍḍitaṃ kulamūlaṃ ",
  "bv26:2.2": "bahūnaṃ pānabhojanaṃ / ",
  "bv26:2.3": "datvāna yācake dānaṃ ",
  "bv26:2.4": "pūrayitvāna mānasaṃ / ",
  "bv26:2.5": "usabho va ālakaṃ bhetvā ",
  "bv26:2.6": "patto sambodhim-uttamaṃ // // ",
  "bv26:3.1": "Dhammacakkappavattente ",
  "bv26:3.2": "Kassape lokanāyake / ",
  "bv26:3.3": "vīsatikoṭisahassānaṃ ",
  "bv26:3.4": "paṭhamābhisamayo ahu // // ",
  "bv26:4.1": "Catumāsaṃ yadā buddho ",
  "bv26:4.2": "loke carati cārikaṃ / ",
  "bv26:4.3": "dasakoṭisahassānaṃ ",
  "bv26:4.4": "dutiyābhisamayo ahu // // ",
  "bv26:5.1": "Yamakaṃ vikubbanaṃ katvā ",
  "bv26:5.2": "ñāṇadhātum-pakittayi / ",
  "bv26:5.3": "pañcakoṭisahassānaṃ ",
  "bv26:5.4": "tatiyābhisamayo ahu // // ",
  "bv26:6.1": "Sudhammadevapure ramme ",
  "bv26:6.2": "tattha dhammaṃ pakāsayi / ",
  "bv26:6.3": "tīṇī koṭisahassānaṃ ",
  "bv26:6.4": "devānaṃ bodhayī jino // // ",
  "bv26:7.1": "Naradevassa yakkhassa ",
  "bv26:7.2": "apare dhammadesane / ",
  "bv26:7.3": "etesānaṃ abhisamayā ",
  "bv26:7.4": "gaṇanāto asaṅkhiyā // // ",
  "bv26:8.1": "Tassāpi devadevassa ",
  "bv26:8.2": "eko āsi samāgamo / ",
  "bv26:8.3": "khīṇasavānaṃ vimalānaṃ ",
  "bv26:8.4": "santacittāna tādinaṃ // // ",
  "bv26:9.1": "Vīsatibhikkhusahassānaṃ ",
  "bv26:9.2": "tadā āsi samāgamo / ",
  "bv26:9.3": "atikkantabhavakantānaṃ ",
  "bv26:9.4": "hirisīlena tādinaṃ // // ",
  "bv26:10.1": "Ahaṃ tadā māṇavako ",
  "bv26:10.2": "Jotipālo 'ti vissuto / ",
  "bv26:10.3": "ajjhāyako mantadharo ",
  "bv26:10.4": "tiṇṇaṃ vedāna pāragū // // ",
  "bv26:11.1": "Lakkhaṇe itihāse ca ",
  "bv26:11.2": "sadhamme pāramiṅgato / bhumm' antalikkhe ",
  "bv26:11.3": "kusalo ",
  "bv26:11.4": "katavijjo anāvayo // // ",
  "bv26:12.1": "Kassapassa bhagavato ",
  "bv26:12.2": "Ghaṭīkāro nām' upaṭṭhako / ",
  "bv26:12.3": "sagāravo sappatisso ",
  "bv26:12.4": "nibbuto tatiye phale // // ",
  "bv26:13.1": "Ādāya maṃ Ghaṭīkāro ",
  "bv26:13.2": "upagañchi Kassapaṃ jinaṃ / ",
  "bv26:13.3": "tassa dhammaṃ suṇitvāna ",
  "bv26:13.4": "pabbajiṃ tassa santike // // ",
  "bv26:14.1": "Āraddhaviriyo hutvā ",
  "bv26:14.2": "vattāvattesu kovido / ",
  "bv26:14.3": "na kvāpi parihāyāmi ",
  "bv26:14.4": "pūremi jinasāsanaṃ // // ",
  "bv26:15.1": "Yāvatā buddhabhaṇitaṃ ",
  "bv26:15.2": "navaṅgaṃ satthusāsanaṃ / ",
  "bv26:15.3": "sabbaṃ pariyāpuṇitvāna ",
  "bv26:15.4": "sobhayiṃ jinasāsanaṃ // // ",
  "bv26:16.1": "Mama acchariyaṃ disvā ",
  "bv26:16.2": "so pi buddho viyākari: / ",
  "bv26:16.3": "imamhi Bhaddake kappe ",
  "bv26:16.4": "ayaṃ buddho bhavissati // // ",
  "bv26:17.1": "Ahu Kapilavhaye ramme ",
  "bv26:17.2": "nikkhamitvā tathāgato / ",
  "bv26:17.3": "padhānaṃ padahitvāna ",
  "bv26:17.4": "katvā dukkarakārikaṃ, // // ",
  "bv26:18.1": "Ajapālarukkhamūle ",
  "bv26:18.2": "nisīditvā tathāgato / ",
  "bv26:18.3": "tattha pāyasam-paggayha ",
  "bv26:18.4": "Nerañjaram-upehiti // // ",
  "bv26:19.1": "Nerañjarāya tīramhi ",
  "bv26:19.2": "pāyāsaṃ paribhuñjiya / ",
  "bv26:19.3": "paṭiyattavaramaggena ",
  "bv26:19.4": "bodhimaṇḍam-upehiti // // ",
  "bv26:20.1": "Tato padakkhiṇaṃ katvā ",
  "bv26:20.2": "bodhimaṇḍaṃ nar' uttamo / ",
  "bv26:20.3": "aparājitaṭhānamhi ",
  "bv26:20.4": "bodhipallaṅka-m-uttame / ",
  "bv26:20.5": "pallaṅkena nisīditvā ",
  "bv26:20.6": "bujjhissati mahāyaso // // ",
  "bv26:21.1": "Imassa janikā mātā ",
  "bv26:21.2": "Māyā nāma bhavissati / ",
  "bv26:21.3": "pitā Suddhodano nāma ",
  "bv26:21.4": "ayaṃ hessati Gotamo // // ",
  "bv26:22.1": "Anāsavā vītarāgā ",
  "bv26:22.2": "santacittā samāhitā / ",
  "bv26:22.3": "Kolito Upatisso ca ",
  "bv26:22.4": "aggā hessanti sāvakā // // ",
  "bv26:22.5": "Ānando nām' upaṭṭhāko upaṭṭhissati ",
  "bv26:22.6": "taṃ jinaṃ / ",
  "bv26:23.1": "Khemā Uppalavaṇṇā ca ",
  "bv26:23.2": "aggā hessanti sāvikā, // // ",
  "bv26:23.3": "Anāsavā vītarāgā santacittā ",
  "bv26:23.4": "samāhitā / ",
  "bv26:23.5": "bodhi tassa bhagavato ",
  "bv26:23.6": "assattho 'ti pavuccati // // ",
  "bv26:24.1": "Citto ca Hatthāḷavako ",
  "bv26:24.2": "aggā hessant' upaṭṭhakā / ",
  "bv26:24.3": "Nandamātā Uttarā ca ",
  "bv26:24.4": "aggā hessant' upaṭṭhikā // // ",
  "bv26:25.1": "Idaṃ sutvāna vacanaṃ ",
  "bv26:25.2": "asamassa mahesino / ",
  "bv26:25.3": "āmoditā naramarū: ",
  "bv26:25.4": "buddhabīj' aṅkuro ayaṃ // // ",
  "bv26:26.1": "Ukkuṭṭhisaddā vattanti ",
  "bv26:26.2": "apphoṭhenti hasanti ca / ",
  "bv26:26.3": "katañjalī namassanti ",
  "bv26:26.4": "dasasahassī sadevakā: // // ",
  "bv26:27.1": "Yad' imassa lokanāthassa ",
  "bv26:27.2": "virajjhissāma sāsanaṃ / ",
  "bv26:27.3": "anāgatamhi addhāne ",
  "bv26:27.4": "hessāma sammukhā imaṃ // // ",
  "bv26:28.1": "Yathā manussā nadiṃ tarantā ",
  "bv26:28.2": "paṭititthaṃ virajjhiya / ",
  "bv26:28.3": "heṭṭhā titthe gahetvāna ",
  "bv26:28.4": "uttaranti mahānadiṃ, // // ",
  "bv26:29.1": "Evam-eva mayaṃ sabbe ",
  "bv26:29.2": "yadi muñcām' imaṃ jinaṃ / ",
  "bv26:29.3": "anāgatamhi addhāne ",
  "bv26:29.4": "hessāma sammukhā imaṃ // // ",
  "bv26:30.1": "Tassāhaṃ vacanaṃ sutvā ",
  "bv26:30.2": "bhiyyo cittaṃ pasādayiṃ / ",
  "bv26:30.3": "uttariṃ vatam-adhiṭṭhāsiṃ ",
  "bv26:30.4": "dasapāramipūriyā // // ",
  "bv26:31.1": "Evaṃ ahaṃ saṃsaritvā ",
  "bv26:31.2": "parivajjento anācaraṃ / ",
  "bv26:31.3": "dukkarañ ca kataṃ mayhaṃ ",
  "bv26:31.4": "bodhiyā yeva kāraṇā // // ",
  "bv26:32.1": "Nagaraṃ Bārāṇasī nāma ",
  "bv26:32.2": "Kikī nām' āsi khattiyo / ",
  "bv26:32.3": "vasati tattha nagare ",
  "bv26:32.4": "sambuddhassa mahākulaṃ // // ",
  "bv26:33.1": "Brāhmaṇo Brahmadatato ca ",
  "bv26:33.2": "āsi buddhassa so pitā / ",
  "bv26:33.3": "Dhanavatī nāma janikā ",
  "bv26:33.4": "Kassapassa mahesino // // ",
  "bv26:34.1": "Duve vassasahassāni ",
  "bv26:34.2": "agāraṃ ajjha so vasi / ",
  "bv26:34.3": "Haṃso Yaso Sirinando ",
  "bv26:34.4": "tayo pasāda-m-uttamā // // ",
  "bv26:35.1": "Tisoḷasasahassāni ",
  "bv26:35.2": "nāriyo samalaṅkatā / ",
  "bv26:35.3": "Sunandā nāma sā nārī ",
  "bv26:35.4": "Vijitaseno nāma atrajo // // ",
  "bv26:36.1": "Nimitte caturo disvā ",
  "bv26:36.2": "pāsādenābhinikkhami / ",
  "bv26:36.3": "sattāhaṃ padhānacāraṃ ",
  "bv26:36.4": "acarī puris' uttamo // // ",
  "bv26:37.1": "Brahmunā yācito santo ",
  "bv26:37.2": "Kassapo lokanāyako / ",
  "bv26:37.3": "vatti cakkaṃ mahāvīro ",
  "bv26:37.4": "migadāye nar' uttamo // // ",
  "bv26:38.1": "Tisso ca Bhāradvājo ca ",
  "bv26:38.2": "ahesuṃ aggasāvakā / ",
  "bv26:38.3": "Sabbamitto upaṭṭhāko ",
  "bv26:38.4": "Kassapassa mahesino // // ",
  "bv26:39.1": "Anulā ca Uruvelā ca ",
  "bv26:39.2": "ahesuṃ aggasāvikā / ",
  "bv26:39.3": "bodhi tassa bhagavato ",
  "bv26:39.4": "nigrodho 'ti pavuccati // // ",
  "bv26:40.1": "Sumaṅgalo Ghaṭikāro ca ",
  "bv26:40.2": "ahesuṃ agg' upaṭṭhakā / Vijitasenā ",
  "bv26:40.3": "ca Bhaddā ca ",
  "bv26:40.4": "ahesuṃ agg' upaṭṭhikā // // ",
  "bv26:41.1": "Uccattanena so buddho ",
  "bv26:41.2": "vīsatiratanam-uggato / ",
  "bv26:41.3": "vijjulaṭṭhī va ākāse ",
  "bv26:41.4": "cando va gahapūrito // // ",
  "bv26:42.1": "Vīsativassasahassāni ",
  "bv26:42.2": "āyu tassa mahesino / ",
  "bv26:42.3": "tāvatā tiṭṭhamāno so ",
  "bv26:42.4": "tāresi janataṃ bahuṃ // // ",
  "bv26:43.1": "Dhammataḷākaṃ māpetvā ",
  "bv26:43.2": "sīlaṃ datvā vilepanaṃ / ",
  "bv26:43.3": "dhammadussaṃ nivāsetvā ",
  "bv26:43.4": "dhammamālaṃ virājiya, // // ",
  "bv26:44.1": "Dhammavimalam-ādāsaṃ ",
  "bv26:44.2": "ṭhapayitvā mahājane: / ",
  "bv26:44.3": "keci nibbānaṃ patthentā ",
  "bv26:44.4": "passantu me alaṅkaraṃ // // ",
  "bv26:45.1": "Sīlakañcukaṃ datvāna ",
  "bv26:45.2": "jhānakavacavammitaṃ / ",
  "bv26:45.3": "dhammacammaṃ pārupitvā ",
  "bv26:45.4": "datvā sannāham-uttamaṃ, // // ",
  "bv26:46.1": "Satiphalakaṃ datvāna ",
  "bv26:46.2": "tikhiṇañāṇakuntimaṃ / ",
  "bv26:46.3": "dhammakhaggavaraṃ datvā ",
  "bv26:46.4": "sīlasaṃsaggamaddanaṃ, // // ",
  "bv26:47.1": "Tevijjābhūsanaṃ datvā ",
  "bv26:47.2": "āvelaṃ caturo phale / ",
  "bv26:47.3": "chaḷabhiññābharaṇaṃ datvā ",
  "bv26:47.4": "dhammapupphapilandhanaṃ, // // ",
  "bv26:48.1": "Saddhammapaṇḍaraṃ chattaṃ ",
  "bv26:48.2": "datvā pāpanivāraṇaṃ / ",
  "bv26:48.3": "māpetvā abhayaṃ pupphaṃ ",
  "bv26:48.4": "nibbuto so sasāvako // // ",
  "bv26:49.1": "Eso hi sammāsambuddho ",
  "bv26:49.2": "appameyyo durāsado / ",
  "bv26:49.3": "eso hi dhammaratano ",
  "bv26:49.4": "svākkhāto ehipassiko // // ",
  "bv26:50.1": "Eso hi saṅgharatano ",
  "bv26:50.2": "suppaṭipanno anuttaro / ",
  "bv26:50.3": "sabbaṃ samantarahitaṃ ",
  "bv26:50.4": "nanu rittā sabbasaṅkhāra // // ",
  "bv26:51.1": "Mahākassapo jino satthā ",
  "bv26:51.2": "Setavyārāmamhi nibbuto / ",
  "bv26:51.3": "tatth' eva tassa jinathūpo ",
  "bv26:51.4": "yojan' ubbedha-m-uggato ti // // ",
  "bv26:52.1": "Kassapassa bhagavato vaṃso catuvīsatimo Aham-etarahi "
}
