{
  "bv15:0.1": "",
  "bv15:0.2": "",
  "bv15:1.1": "Sujātassa aparena ",
  "bv15:1.2": "sayambhū lokanāyako / ",
  "bv15:1.3": "durāsado asamasamo ",
  "bv15:1.4": "Piyadassī mahāyaso // // ",
  "bv15:2.1": "So pi buddho amitayaso ",
  "bv15:2.2": "ādicco va virocati / nihantvāna tamaṃ ",
  "bv15:2.3": "sabbaṃ ",
  "bv15:2.4": "dhammacakkaṃ pavattayi // // ",
  "bv15:3.1": "Tassāpi atulatejassa ",
  "bv15:3.2": "ahesum-abhisamayā tayo / ",
  "bv15:3.3": "koṭisatasahassānaṃ ",
  "bv15:3.4": "paṭhamābhisamayo ahū // // ",
  "bv15:4.1": "Sudassano devarājā ",
  "bv15:4.2": "micchādiṭṭhim-aracoyi / ",
  "bv15:4.3": "tassa diṭṭhiṃ vinodento ",
  "bv15:4.4": "satthā dhammam-adesayi // // ",
  "bv15:5.1": "Janasannipāto atulo ",
  "bv15:5.2": "mahā sannipatī tadā / ",
  "bv15:5.3": "navutikoṭisahassānaṃ ",
  "bv15:5.4": "dutiyābhisamayo ahu // // ",
  "bv15:6.1": "Yadā Doṇamukhaṃ hatthiṃ ",
  "bv15:6.2": "vinesi narasārathi / ",
  "bv15:6.3": "asītikoṭisahassānaṃ ",
  "bv15:6.4": "tatiyābhisamayo ahu // // ",
  "bv15:7.1": "Sannipātā tayo āsuṃ ",
  "bv15:7.2": "tassāpi Piyadassino / ",
  "bv15:7.3": "koṭisatasahassānaṃ ",
  "bv15:7.4": "paṭhamo āsi samāgamo // // ",
  "bv15:8.1": "Tato paraṃ navutikoṭī ",
  "bv15:8.2": "samiṃsu ekato munī / ",
  "bv15:8.3": "tatiye sannipātamhi ",
  "bv15:8.4": "asītikoṭiyo ahū // // ",
  "bv15:9.1": "Ahaṃ tena samayena ",
  "bv15:9.2": "Kassapo nāma brāhmaṇo / ",
  "bv15:9.3": "ajjhāyako mantadharo ",
  "bv15:9.4": "tiṇṇaṃ vedāna pāragū // // ",
  "bv15:10.1": "Tassa dhammaṃ suṇitvāna ",
  "bv15:10.2": "pasādaṃ janayī-m-ahaṃ / ",
  "bv15:10.3": "koṭisatasahassehi ",
  "bv15:10.4": "saṅghārāmaṃ amāpayiṃ // // ",
  "bv15:11.1": "Tassa datvāna ārāmaṃ ",
  "bv15:11.2": "haṭṭho saṃviggamānaso / ",
  "bv15:11.3": "saraṇaṃ pañcasīlañca ",
  "bv15:11.4": "daḷhaṃ katvā samādiyiṃ // // ",
  "bv15:12.1": "So pi maṃ buddho vyākāsi ",
  "bv15:12.2": "saṅghamajjhe nisīdiya: / ",
  "bv15:12.3": "aṭṭhārase kappasate ",
  "bv15:12.4": "ayaṃ buddho bhavissati // // ",
  "bv15:13.1": "Padhānaṃ padahitvāna ",
  "bv15:13.2": "katvā dukkarakārikaṃ / ",
  "bv15:13.3": "assatthamūle sambuddho bujjhissati mahāyaso // // ",
  "bv15:14.1": "Tassāpi vacanaṃ sutvā ",
  "bv15:14.2": "bhiyyo cittaṃ pasādayiṃ / ",
  "bv15:14.3": "uttariṃ vatam-adhiṭṭhāsiṃ ",
  "bv15:14.4": "dasapāramipūriyā // // ",
  "bv15:15.1": "Sudhaññaṃ nāma nagaraṃ ",
  "bv15:15.2": "Sudatto nāma khattiyo / ",
  "bv15:15.3": "Sucandā nāma janikā ",
  "bv15:15.4": "Piyadassissa satthuno // // ",
  "bv15:16.1": "Navavassasahassāni ",
  "bv15:16.2": "agāraṃ ajjha so vasī / ",
  "bv15:16.3": "Sunimmala-Vimala-Giriguhā ",
  "bv15:16.4": "tayo pāsāda-m-uttamā // // ",
  "bv15:17.1": "Tettiṃsati sahassāni ",
  "bv15:17.2": "nāriyo samalaṅkatā / ",
  "bv15:17.3": "Vimalā nāma nārī ca ",
  "bv15:17.4": "Kañcanaveḷo nāma atrajo // // ",
  "bv15:18.1": "Nimitte caturo disvā ",
  "bv15:18.2": "rathayānena nikkhami / ",
  "bv15:18.3": "chamāsaṃ padhānacāraṃ ",
  "bv15:18.4": "acarī puris' uttamo // // ",
  "bv15:19.1": "Brahmunā yācito santo ",
  "bv15:19.2": "Piyadassī mahāmunī / ",
  "bv15:19.3": "vatti cakkaṃ mahāvīro ",
  "bv15:19.4": "Ussāvan' uyyāne manorame // // ",
  "bv15:20.1": "Pālito Sabbadassī ca ",
  "bv15:20.2": "ahesuṃ aggasāvakā / ",
  "bv15:20.3": "Sobhito nām' upaṭṭhāko ",
  "bv15:20.4": "Piyadassissa satthuno // // ",
  "bv15:21.1": "Sujātā Dhammadinnā ca ",
  "bv15:21.2": "ahesuṃ aggasāvikā / ",
  "bv15:21.3": "bodhi tassa bhagavato ",
  "bv15:21.4": "kakudho 'ti pavuccati // // ",
  "bv15:22.1": "Sannako Dhammiko c' eva ",
  "bv15:22.2": "ahesuṃ agg' upaṭṭhakā / ",
  "bv15:22.3": "Visākhā Dhammadinnā ca ",
  "bv15:22.4": "ahesuṃ agg' upaṭṭhikā // // ",
  "bv15:23.1": "So pi buddho amitayaso ",
  "bv15:23.2": "dvattiṃsavaralakkhaṇo / ",
  "bv15:23.3": "asītihattha-m-ubhedho ",
  "bv15:23.4": "sālarājā va dissati // // ",
  "bv15:24.1": "Aggicandasuriyānaṃ ",
  "bv15:24.2": "n' atthi tādisikā pabhā / ",
  "bv15:24.3": "yathā ahu pabhā tassa ",
  "bv15:24.4": "asamassa mahesino // // ",
  "bv15:25.1": "Tassāpi devadevassa ",
  "bv15:25.2": "āyu tāvatakaṃ ahu / ",
  "bv15:25.3": "navutivassasahassāni ",
  "bv15:25.4": "loke aṭṭhāsi cakkhumā // // ",
  "bv15:26.1": "So pi buddho asamasamo ",
  "bv15:26.2": "yugāni pi tāni atuliyāni / ",
  "bv15:26.3": "sabbaṃ samantarahitaṃ ",
  "bv15:26.4": "nanu rittā sabbasaṅkhārā // // So ",
  "bv15:27.1": "Piyadassī munivaro ",
  "bv15:27.2": "Assatthārāmamhi nibbuto / ",
  "bv15:27.3": "tatth' eva tassa jinathūpo ",
  "bv15:27.4": "tīṇi yojana-m-uggato ti // // ",
  "bv15:28.1": "Piyadassissa bhagavato vaṃso terasamo Tatth' eva "
}
