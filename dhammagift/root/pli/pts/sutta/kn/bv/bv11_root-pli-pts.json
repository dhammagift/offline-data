{
  "bv11:0.1": "",
  "bv11:0.2": "",
  "bv11:1.1": "Padumassa aparena ",
  "bv11:1.2": "sambuddho dvipad' uttamo / ",
  "bv11:1.3": "Nārado nāma nāmena ",
  "bv11:1.4": "asamo appaṭipuggalo // // ",
  "bv11:2.1": "So buddho cakkavattissa ",
  "bv11:2.2": "jeṭṭho dayita-oraso / ",
  "bv11:2.3": "āmuttamālyābharaṇo ",
  "bv11:2.4": "uyyānaṃ upasaṅkami // // ",
  "bv11:3.1": "Tatrāsi rukkho yasavipulo ",
  "bv11:3.2": "abhirūpo brahā suci / ",
  "bv11:3.3": "tam-ajjhapatvā upanisīdi ",
  "bv11:3.4": "mahāsoṇassa heṭṭhato // // ",
  "bv11:4.1": "Tattha ñāṇavar' uppajji ",
  "bv11:4.2": "anantaṃ vajir' ūpamaṃ / ",
  "bv11:4.3": "tena vicini saṅkhāre ",
  "bv11:4.4": "ukkujjam-avakujjakaṃ // // ",
  "bv11:5.1": "Tattha sabbakilesāni ",
  "bv11:5.2": "asesaṃ abhivāhayī / ",
  "bv11:5.3": "pāpuṇī kevalaṃ bodhiṃ ",
  "bv11:5.4": "buddhañāṇe ca cuddasa // // ",
  "bv11:6.1": "Pāpuṇitvāna sambodhiṃ ",
  "bv11:6.2": "dhammacakkaṃ pavattayi / ",
  "bv11:6.3": "koṭisatasahassānaṃ ",
  "bv11:6.4": "paṭhamābhisamayo ahu // // ",
  "bv11:7.1": "Mahādoṇaṃ nāgarājaṃ ",
  "bv11:7.2": "vinayanto mahāmuni / ",
  "bv11:7.3": "pāṭiheraṃ tadākāsi ",
  "bv11:7.4": "dassayanto sadevake // // ",
  "bv11:8.1": "Tadā devamanussānaṃ ",
  "bv11:8.2": "tamhi dhammappakāsane / ",
  "bv11:8.3": "navutikoṭisahassāni ",
  "bv11:8.4": "tariṃsu sabbasaṃsayaṃ // // ",
  "bv11:9.1": "Yamhi kāle mahāvīro ",
  "bv11:9.2": "ovadī sakam-atrajaṃ / ",
  "bv11:9.3": "asītikoṭisahassānaṃ ",
  "bv11:9.4": "tatiyābhisamayo ahu // // ",
  "bv11:10.1": "Sannipātā tayo āsuṃ ",
  "bv11:10.2": "Nāradassa mahesino / ",
  "bv11:10.3": "koṭisatasahassānaṃ ",
  "bv11:10.4": "paṭhamo āsi samāgamo // // ",
  "bv11:11.1": "Yadā buddho buddhaguṇaṃ ",
  "bv11:11.2": "sanidānaṃ pakāsayi / ",
  "bv11:11.3": "navutikoṭisahassāni ",
  "bv11:11.4": "samiṃsu vimalā tadā // // ",
  "bv11:12.1": "Yadā Verocano nāgo ",
  "bv11:12.2": "dānaṃ dadāti satthuno / ",
  "bv11:12.3": "tadā samiṃsu jinaputtā ",
  "bv11:12.4": "asītisatasahassiyo // // ",
  "bv11:13.1": "Ahaṃ tena samayena ",
  "bv11:13.2": "jaṭilo uggatāpano / ",
  "bv11:13.3": "antalikkhacaro āsiṃ ",
  "bv11:13.4": "pañcābhiññāsu pāragū // // ",
  "bv11:14.1": "Tadā p' āhaṃ asamasamaṃ ",
  "bv11:14.2": "sasaṅghaṃ saparijjanaṃ / ",
  "bv11:14.3": "annapānena tappetvā ",
  "bv11:14.4": "candanenābhipūjayiṃ // // ",
  "bv11:15.1": "So pi maṃ tadā vyākāsi ",
  "bv11:15.2": "Nārado lokanāyako: / ",
  "bv11:15.3": "aparimeyye ito kappe ",
  "bv11:15.4": "ayaṃ buddho bhavissati // // ",
  "bv11:16.1": "Padhānaṃ padahitvāna ",
  "bv11:16.2": "katvā dukkarakārikaṃ / ",
  "bv11:16.3": "assatthamūle sambuddho bujjhissati mahāyaso // // ",
  "bv11:17.1": "Tassāpi vacanaṃ sutvā ",
  "bv11:17.2": "bhiyyo hāsetva mānasaṃ / ",
  "bv11:17.3": "adhiṭṭhahiṃ vataṃ uggaṃ ",
  "bv11:17.4": "dasapāramipūriyā // // ",
  "bv11:18.1": "Nagaraṃ Dhaññavatī nāma ",
  "bv11:18.2": "Sudevo nāma khattiyo / ",
  "bv11:18.3": "Anomā nāma janikā ",
  "bv11:18.4": "Nāradassa mahesino // // ",
  "bv11:19.1": "Nava vassasahassāni ",
  "bv11:19.2": "agāraṃ ajjha so vasī / ",
  "bv11:19.3": "Jitā Vijitā' Bhirāmā ",
  "bv11:19.4": "tayo pāsāda-m-uttamā // // ",
  "bv11:20.1": "Ticattārīsasahassāni ",
  "bv11:20.2": "nāriyo samalaṅkatā / ",
  "bv11:20.3": "Jitasenā nāma nārī ",
  "bv11:20.4": "Nand' uttaro nāma atrajo // // ",
  "bv11:21.1": "Nimitte caturo disvā ",
  "bv11:21.2": "padasā gamanena nikkhami / ",
  "bv11:21.3": "sattāhaṃ padhānacariyaṃ ",
  "bv11:21.4": "acarī lokanāyako // // ",
  "bv11:22.1": "Brahmunā yācito santo ",
  "bv11:22.2": "Nārado lokanāyako / ",
  "bv11:22.3": "vatti cakkaṃ mahāvīro ",
  "bv11:22.4": "Dhanañjay' uyyāna-m-uttame // // ",
  "bv11:23.1": "Bhaddasālo Jitamitto ",
  "bv11:23.2": "ahesuṃ aggasāvakā / ",
  "bv11:23.3": "Vāseṭṭho nām' upaṭṭhāko ",
  "bv11:23.4": "Nāradassa mahesino // // ",
  "bv11:24.1": "Uttarā Phagguṇī c' eva ",
  "bv11:24.2": "ahesuṃ aggasāvikā / ",
  "bv11:24.3": "bodhi tassa bhagavato ",
  "bv11:24.4": "mahāsoṇo ti vuccati // // ",
  "bv11:25.1": "Uggar' indo Vasabho ca ",
  "bv11:25.2": "ahesuṃ agg' upaṭṭhakā / ",
  "bv11:25.3": "Indāvarī ca Caṇḍī ca ",
  "bv11:25.4": "ahesuṃ agg' upaṭṭhikā // // ",
  "bv11:26.1": "Aṭṭhāsīti ratanāni ",
  "bv11:26.2": "accuggato mahāmuni / ",
  "bv11:26.3": "kañcan' agghikasaṅkāso ",
  "bv11:26.4": "dasasahassī virocatha // // ",
  "bv11:27.1": "Tassa byāmappabhā kāyā ",
  "bv11:27.2": "niddhāvati disodisaṃ / ",
  "bv11:27.3": "nirantaraṃ divā rattiṃ ",
  "bv11:27.4": "yojanaṃ pharate sadā // // ",
  "bv11:28.1": "Na keci tena samayena ",
  "bv11:28.2": "samantā yojane janā / ",
  "bv11:28.3": "ukkā padīpe ujjalenti ",
  "bv11:28.4": "buddharaṃsena otthaṭā // // ",
  "bv11:29.1": "Navutivassasahassāni ",
  "bv11:29.2": "āyu vijjati tāvade / ",
  "bv11:29.3": "tāvatā tiṭṭhamāno so ",
  "bv11:29.4": "tāresi janataṃ bahuṃ // // ",
  "bv11:30.1": "Yathā ulūhi gaganaṃ ",
  "bv11:30.2": "vicittaṃ upasobhati / ",
  "bv11:30.3": "tath' eva sāsanaṃ tassa ",
  "bv11:30.4": "arahantehi sobhati // // ",
  "bv11:31.1": "Saṃsārasotaṃ taraṇāya ",
  "bv11:31.2": "sesake paṭipannake / ",
  "bv11:31.3": "dhammasetuṃ daḷhaṃ katvā ",
  "bv11:31.4": "nibbuto so narāsabho // // ",
  "bv11:32.1": "So pi buddho asamasamo ",
  "bv11:32.2": "te pi khīṇāsavā atulatejā / ",
  "bv11:32.3": "sabbaṃ samantarahitaṃ ",
  "bv11:32.4": "nanu rittā sabbasaṅkhārā // // ",
  "bv11:33.1": "Nārado jinavasabho ",
  "bv11:33.2": "nibbuto Sudassane pure / ",
  "bv11:33.3": "tatth' eva jinathūpavaro catu ",
  "bv11:33.4": "yojanam-uggato // // ",
  "bv11:34.1": "Nāradassa bhagavato vaṃso navamo "
}
