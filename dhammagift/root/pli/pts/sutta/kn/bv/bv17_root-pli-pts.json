{
  "bv17:0.1": "",
  "bv17:0.2": "",
  "bv17:1.1": "Maṇḍakappamhi ",
  "bv17:1.2": "Dhammadassī mahāyaso / ",
  "bv17:1.3": "tam' andhakāraṃ vidhametvā ",
  "bv17:1.4": "atirocati sadevake // // ",
  "bv17:2.1": "Tassāpi atulatejassa ",
  "bv17:2.2": "dhammacakkappavattane / ",
  "bv17:2.3": "koṭisatasahassānaṃ ",
  "bv17:2.4": "paṭhamābhisamayo ahu // // ",
  "bv17:3.1": "Yadā buddho Dhammadassī ",
  "bv17:3.2": "vinesi Sañjayaṃ isiṃ / ",
  "bv17:3.3": "tadā navutikoṭīnaṃ ",
  "bv17:3.4": "dutiyābhisamayo ahu // // ",
  "bv17:4.1": "Yadā Sakko upāgañchi ",
  "bv17:4.2": "sapariso vināyakaṃ / ",
  "bv17:4.3": "tadā asītikoṭīnaṃ ",
  "bv17:4.4": "tatiyābhisamayo ahu // // ",
  "bv17:5.1": "Tassāpi devadevassa ",
  "bv17:5.2": "sannipātā tayo ahuṃ / ",
  "bv17:5.3": "khīṇāsavānaṃ vimalānaṃ ",
  "bv17:5.4": "santicittāna tādinaṃ // // ",
  "bv17:6.1": "Yadā buddho Dhammadassī ",
  "bv17:6.2": "Saraṇe vassam-upāgami / ",
  "bv17:6.3": "tadā koṭisahassānaṃ ",
  "bv17:6.4": "paṭhamo āsi samāgamo // // ",
  "bv17:7.1": "Punāparaṃ yadā buddho ",
  "bv17:7.2": "devato eti mānuse / ",
  "bv17:7.3": "tadāpi satakoṭīnaṃ ",
  "bv17:7.4": "dutiyo āsi samāgamo // // ",
  "bv17:8.1": "Punāparaṃ yadā buddho ",
  "bv17:8.2": "pakāsesi dhute guṇe / ",
  "bv17:8.3": "tadā asītikoṭīnaṃ ",
  "bv17:8.4": "tatiyo āsi samāgamo // // ",
  "bv17:9.1": "Ahaṃ tena samayena ",
  "bv17:9.2": "Sakko āsiṃ purindado / ",
  "bv17:9.3": "dibbena gandhamālena ",
  "bv17:9.4": "turiyena abhipūjayiṃ // // ",
  "bv17:10.1": "So pi maṃ buddho vyākāsi ",
  "bv17:10.2": "devamajjhe nisīdiya: / ",
  "bv17:10.3": "aṭṭhārase kappasate ",
  "bv17:10.4": "ayaṃ buddho bhavissati // // ",
  "bv17:11.1": "Padhānaṃ padahitvāna ",
  "bv17:11.2": "katvā dukkarakārikaṃ / ",
  "bv17:11.3": "assatthamūle sambuddho bujjhissati mahāyaso // // ",
  "bv17:12.1": "Tassāpi vacanaṃ sutvā ",
  "bv17:12.2": "bhiyyo cittaṃ pasādayiṃ / ",
  "bv17:12.3": "uttariṃ vatam-adhiṭṭhāsiṃ ",
  "bv17:12.4": "dasapāramipūriyā // // ",
  "bv17:13.1": "Saraṇaṃ nāma nagaraṃ ",
  "bv17:13.2": "Saraṇo nāma khattiyo / ",
  "bv17:13.3": "Sundarā nāma janikā ",
  "bv17:13.4": "Dhammadassissa satthuno // // ",
  "bv17:14.1": "Aṭṭhārasavassāni ",
  "bv17:14.2": "agāraṃ ajjha so vasi / ",
  "bv17:14.3": "Arajo Virajo Sudassano ",
  "bv17:14.4": "tayo pāsāda-m-uttamā // // ",
  "bv17:15.1": "Ticattārīsasahassāni ",
  "bv17:15.2": "nāriyo samalaṅkatā / ",
  "bv17:15.3": "Vicikolī nāma nārī ",
  "bv17:15.4": "atrajo Puṇṇavaḍḍhano // // ",
  "bv17:16.1": "Nimitte caturo disvā ",
  "bv17:16.2": "pāsādenābhinikkhami / ",
  "bv17:16.3": "sattāhaṃ padhānacāraṃ ",
  "bv17:16.4": "acarī puris' uttamo // // ",
  "bv17:17.1": "Brahmunā yācito santo ",
  "bv17:17.2": "Dhammadassī narāsabho / ",
  "bv17:17.3": "vatti cakkaṃ mahāvīro ",
  "bv17:17.4": "migadāye nar' uttamo // // ",
  "bv17:18.1": "Padumo Phussadevo ca ",
  "bv17:18.2": "ahesuṃ aggasāvakā / ",
  "bv17:18.3": "Sunetto nām' upaṭṭhāko ",
  "bv17:18.4": "Dhammadassissa satthuno // // ",
  "bv17:19.1": "Khemā ca Saccanāmā ca ",
  "bv17:19.2": "ahesuṃ aggasāvikā / ",
  "bv17:19.3": "bodhi tassa bhagavato ",
  "bv17:19.4": "bimbajālo 'ti vuccati // // ",
  "bv17:20.1": "Subhaddo Kaṭissaho c' eva ",
  "bv17:20.2": "ahesuṃ agg' upaṭṭhakā / ",
  "bv17:20.3": "Sāliyā ca Valīyā ca ",
  "bv17:20.4": "ahesuṃ agg' upaṭṭhikā // // ",
  "bv17:21.1": "So pi buddho asamasamo ",
  "bv17:21.2": "asītihattam-uggato / ",
  "bv17:21.3": "atirocati tejena ",
  "bv17:21.4": "dasasahassimhi dhātuyā // // ",
  "bv17:22.1": "Suphullo sālarājā va ",
  "bv17:22.2": "vijjū va gagane yathā / ",
  "bv17:22.3": "majjhantike va suriyo ",
  "bv17:22.4": "evaṃ so upasobhatha // // ",
  "bv17:23.1": "Tassāpi atulatejassa ",
  "bv17:23.2": "samakaṃ āsi jīvitaṃ / ",
  "bv17:23.3": "vassasatasahassāni ",
  "bv17:23.4": "loke aṭṭhāsi cakkhumā // // ",
  "bv17:24.1": "Obhāsaṃ dassayitvāna ",
  "bv17:24.2": "vimalaṃ katvāna sāsanaṃ / ",
  "bv17:24.3": "ravi-cando va gagane ",
  "bv17:24.4": "nibbuto so sasāvako // // ",
  "bv17:25.1": "Dhammadassī mahāvīro ",
  "bv17:25.2": "Kesārāmamhi nibbuto / ",
  "bv17:25.3": "tatth' eva so thūpavaro ",
  "bv17:25.4": "tiyojanasamuggato // // ",
  "bv17:26.1": "Dhammadassissa bhagavato vaṃso paṇṇarasamo "
}
