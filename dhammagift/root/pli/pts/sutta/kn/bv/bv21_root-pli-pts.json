  "bv21:1.1": "Phussassa ca aparena ",
  "bv21:1.2": "sambuddho dvipad' uttamo / ",
  "bv21:1.3": "Vipassī nāma nāmena ",
  "bv21:1.4": "loke uppajji cakkhumā // // ",
  "bv21:2.1": "Avijjaṃ sabbaṃ padāletvā ",
  "bv21:2.2": "patto sambodhim-uttamaṃ / ",
  "bv21:2.3": "dhammacakkaṃ pavattetuṃ ",
  "bv21:2.4": "pakkāmi Bandhumatīpuraṃ // // ",
  "bv21:3.1": "Dhammacakkaṃ pavattetvā ",
  "bv21:3.2": "ubho bodhesi nāyako / ",
  "bv21:3.3": "gaṇanāya na vattabbo ",
  "bv21:3.4": "paṭhamābhisamayo ahu // // ",
  "bv21:4.1": "Punāparaṃ amitayaso ",
  "bv21:4.2": "tattha saccaṃ pakāsayi, / ",
  "bv21:4.3": "caturāsītisahassānaṃ ",
  "bv21:4.4": "dutiyābhisamayo ahu // // ",
  "bv21:5.1": "Caturāsītisahassāni ",
  "bv21:5.2": "sambuddhaṃ anupabbajuṃ / ",
  "bv21:5.3": "tesam-ārāmapattānaṃ ",
  "bv21:5.4": "dhammaṃ desesi cakkhumā // // ",
  "bv21:6.1": "Sabbākārena bhāsato ",
  "bv21:6.2": "sutvā upanisādino / ",
  "bv21:6.3": "te pi dhammaṃ varaṃ gantvā ",
  "bv21:6.4": "tatiyābhisamayo ahu // // ",
  "bv21:7.1": "Sannipātā tayo āsuṃ ",
  "bv21:7.2": "Vipassissa mahesino / ",
  "bv21:7.3": "khīṇāsavānaṃ vimalānaṃ ",
  "bv21:7.4": "santacittāna tādinaṃ // // ",
  "bv21:8.1": "Aṭṭhasaṭṭhisahassānaṃ ",
  "bv21:8.2": "paṭhamo āsi samāgamo / ",
  "bv21:8.3": "bhikkhusatasahassānaṃ ",
  "bv21:8.4": "dutiyo āsi samāgamo // // ",
  "bv21:9.1": "Asītibhikkhusahassānaṃ ",
  "bv21:9.2": "tatiyo āsi samāgamo. / ",
  "bv21:9.3": "tattha bhikkhugaṇamajjhe ",
  "bv21:9.4": "sambuddho atirocati // // ",
  "bv21:10.1": "Ahaṃ tena samayena ",
  "bv21:10.2": "nāgarājā mah' iddhiko / ",
  "bv21:10.3": "Atulo nāma nāmena ",
  "bv21:10.4": "puññavanto jutindharo // // ",
  "bv21:11.1": "Nekānaṃ nāgakoṭīnaṃ ",
  "bv21:11.2": "parivāretvān' ahaṃ tadā / ",
  "bv21:11.3": "vajjanto dibbaturiyehi ",
  "bv21:11.4": "lokajeṭṭhaṃ upāgamiṃ // // ",
  "bv21:12.1": "Upasaṅkamitvā sambuddhaṃ ",
  "bv21:12.2": "Vipassiṃ lokanāyakaṃ / ",
  "bv21:12.3": "maṇimuttaratanakhacitaṃ ",
  "bv21:12.4": "sabbābharaṇabhūsitaṃ / ",
  "bv21:12.5": "nimantetvā dhammarājassa ",
  "bv21:12.6": "suvaṇṇapīṭham-adās' ahaṃ // // ",
  "bv21:13.1": "So pi maṃ buddho vyākāsi ",
  "bv21:13.2": "saṅghamajjhe nisīdiya: / ",
  "bv21:13.3": "ekanavute ito kappe ",
  "bv21:13.4": "ayaṃ buddho bhavissati // // ",
  "bv21:14.1": "Ahu Kapilavhaye ramme ",
  "bv21:14.2": "nikkhamitvā tathāgato / ",
  "bv21:14.3": "padhānaṃ padahitvāna ",
  "bv21:14.4": "katvā dukkarakārikaṃ, // // ",
  "bv21:15.1": "Ajapālarukkhamūlamhi ",
  "bv21:15.2": "nisīditvā tathāgato / ",
  "bv21:15.3": "tattha pāyāsam-aggayha ",
  "bv21:15.4": "Nerañjaram-upehiti // // ",
  "bv21:16.1": "Nerañjarāya tīramhi ",
  "bv21:16.2": "pāyāsaṃ asatī jino / ",
  "bv21:16.3": "paṭiyattavaramaggena ",
  "bv21:16.4": "bodhimūlaṃ upehiti // // ",
  "bv21:17.1": "Tato padakkhiṇaṃ katvā ",
  "bv21:17.2": "bodhimaṇḍaṃ anuttaro / ",
  "bv21:17.3": "assatthamūle sambodhiṃ ",
  "bv21:17.4": "bujjhissati mahāyaso // // ",
  "bv21:18.1": "Imassa janikā mātā ",
  "bv21:18.2": "Māyā nāma bhavissati / ",
  "bv21:18.3": "pitā Suddhodano nāma ",
  "bv21:18.4": "ayaṃ hessati Gotamo // // ",
  "bv21:19.1": "Anāsavā vītarāgā ",
  "bv21:19.2": "santacittā samāhitā / ",
  "bv21:19.3": "Kolito Upatisso ca ",
  "bv21:19.4": "aggā hessanti sāvakā // // ",
  "bv21:19.5": "Ānando nām' upaṭṭhāko upaṭṭhissati ",
  "bv21:19.6": "taṃ jinaṃ / ",
  "bv21:20.1": "Khemā Uppalavaṇṇā ca ",
  "bv21:20.2": "aggā hessanti sāvikā, // // ",
  "bv21:20.3": "Anāsavā vītarāgā ",
  "bv21:20.4": "santacittā samāhitā | / ",
  "bv21:20.5": "bodhi tassa bhagavato ",
  "bv21:20.6": "assattho 'ti pavuccati // // ",
  "bv21:21.1": "",
  "bv21:21.2": "",
  "bv21:21.3": "",
  "bv21:21.4": "",
  "bv21:21.5": "",
  "bv21:21.6": "",
  "bv21:22.1": "",
  "bv21:22.2": "",
  "bv21:22.3": "",
  "bv21:23.1": "Tassāhaṃ vacanaṃ sutvā ",
  "bv21:23.2": "bhiyyo cittaṃ pasādayiṃ / ",
  "bv21:23.3": "uttariṃ vatam-adhiṭṭhāsiṃ ",
  "bv21:23.4": "dasapāramipūriyā // // ",
  "bv21:24.1": "Nagaraṃ Bandhumatī nāma ",
  "bv21:24.2": "Bandhumā nāma khattiyo / ",
  "bv21:24.3": "mātā Bandhumatī nāma ",
  "bv21:24.4": "Vipassissa mahesino // // ",
  "bv21:25.1": "Aṭṭhavassasahassāni ",
  "bv21:25.2": "agāraṃ ajjha so vasi / ",
  "bv21:25.3": "Nando Sunando Sirimā ",
  "bv21:25.4": "tayo pāsāda-m-uttamā // // ",
  "bv21:26.1": "Ticattārīsasahassāni ",
  "bv21:26.2": "nāriyo samalaṅkatā / ",
  "bv21:26.3": "Sutanā nāma sā nārī ",
  "bv21:26.4": "Samavattakkhandho nām' atrajo // // ",
  "bv21:27.1": "Nimitte caturo disvā ",
  "bv21:27.2": "rathayānena nikkhami / ",
  "bv21:27.3": "anūna-aṭṭhamāsāni ",
  "bv21:27.4": "padhānaṃ padahī jino // // ",
  "bv21:28.1": "Brahmunā yācito santo ",
  "bv21:28.2": "Vipassī lokanāyako / ",
  "bv21:28.3": "vatti cakkaṃ mahāvīro ",
  "bv21:28.4": "migadāye nar' uttamo // // ",
  "bv21:29.1": "Khandho ca Tissanāmo ca ",
  "bv21:29.2": "ahesuṃ aggasāvakā / ",
  "bv21:29.3": "Asoko nām' upaṭṭhāko ",
  "bv21:29.4": "Vipassissa mahesino // // ",
  "bv21:30.1": "Candā ca Candamittā ca ",
  "bv21:30.2": "ahesuṃ aggasāvikā / ",
  "bv21:30.3": "bodhi tassa bhagavato ",
  "bv21:30.4": "pāṭalī 'ti pavuccati // // ",
  "bv21:31.1": "Punabbasumitto Nāgo ca ",
  "bv21:31.2": "ahesuṃ agg' upaṭṭhakā / ",
  "bv21:31.3": "Sirimā Uttarā c' eva ",
  "bv21:31.4": "ahesuṃ agg' upaṭṭhikā // // ",
  "bv21:32.1": "Asītihattha-m-ubbedho ",
  "bv21:32.2": "Vipassī lokanāyako / ",
  "bv21:32.3": "pabhā niddhāvatī tassa ",
  "bv21:32.4": "samantā sattayojane // // ",
  "bv21:33.1": "Asītivassasahassāni ",
  "bv21:33.2": "āyu buddhassa tāvade / ",
  "bv21:33.3": "tāvatā tiṭṭhamāno so ",
  "bv21:33.4": "tāresi janataṃ bahuṃ // // ",
  "bv21:34.1": "Bahū devamanussānaṃ ",
  "bv21:34.2": "bandhanā parimocayi / ",
  "bv21:34.3": "maggāmaggañca ācikkhi ",
  "bv21:34.4": "avasesaputhujjane // // ",
  "bv21:35.1": "Ālokaṃ dassayitvāna ",
  "bv21:35.2": "desetvā amataṃ padaṃ / ",
  "bv21:35.3": "jalitvā aggikkhandho va ",
  "bv21:35.4": "nibbuto so sasāvako // // ",
  "bv21:36.1": "Iddhivaraṃ puññavaraṃ ",
  "bv21:36.2": "lakkhaṇaṃ catubhūmakaṃ / ",
  "bv21:36.3": "sabbaṃ samantarahitaṃ ",
  "bv21:36.4": "nanu rittā sabbasaṅkhārā // // ",
  "bv21:37.1": "Vipassī jinavaro dhīro ",
  "bv21:37.2": "Sumittārāmamhi nibbuto / ",
  "bv21:37.3": "tatth' eva tassa thūpavaro ",
  "bv21:37.4": "sattayojana-m-ussito ti // // ",
  "bv21:38.1": "Vipassissa bhagavato vaṃso ekūnavīsatimo "
}
