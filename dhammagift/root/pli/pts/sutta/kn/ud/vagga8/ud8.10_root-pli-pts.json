{
  "ud8.10:0.1": "",
  "ud8.10:0.2": "",
  "ud8.10:1.1": "evam me sutaṃ. ",
  "ud8.10:1.2": "ekaṃ samayaṃ bhagavā Sāvatthiyaṃ viharati Jetavane Anāthapiṇḍikassa ārāme. ",
  "ud8.10:1.3": "tatra kho bhagavā bhikkhū āmantesi: ",
  "ud8.10:1.4": "bhikkhavo 'ti. bhaddante ",
  "ud8.10:1.5": "'ti te bhikkhū bhagavato paccassosuṃ. ",
  "ud8.10:1.6": "bhagavā etad avoca: ",
  "ud8.10:2.1": "Dabbassa bhikkhave Mallaputtassa vehāsaṃ abbhuggantvā . . . na masi (= ",
  "ud8.10:2.2": "VIII.9). seyyathā pi nāma sappissa . . . na masi, ",
  "ud8.10:2.3": "evaṃ kho bhikkhave Dabbassa Mallaputtassa vehāsaṃ . . . na masī 'ti (ib.). ",
  "ud8.10:3.1": "atha kho bhagavā etam atthaṃ viditvā tāyaṃ velāyaṃ imaṃ udānaṃ udānesi: ",
  "ud8.10:4.1": "ayoghanahatass' eva ",
  "ud8.10:4.2": "jalato jātavedasso ",
  "ud8.10:4.3": "anupubbūpasantassa ",
  "ud8.10:4.4": "yathā na ñāyate gati, ",
  "ud8.10:5.1": "evaṃ sammāvimuttānaṃ ",
  "ud8.10:5.2": "kāmabandhoghatārinaṃ ",
  "ud8.10:5.3": "paññāpetuṃ gati n' atthi ",
  "ud8.10:5.4": "pattānaṃ acalaṃ sukhan ti. ||10|| tatr' uddānaṃ bhavati: ",
  "ud8.10:5.5": "",
  "ud8.10:5.6": "",
  "ud8.10:6.0": "",
  "ud8.10:6.1": "nibbānā caturo vuttā ",
  "ud8.10:6.2": "Cundo Pāṭaligāmiyā, ",
  "ud8.10:6.3": "dvidhāpatho Visākhā ca ",
  "ud8.10:6.4": "Dabbena ca saha te dasā 'ti. ",
  "ud8.10:7.0": "",
  "ud8.10:7.1": "vaggam idaṃ pathamaṃ varabodhi, ",
  "ud8.10:7.2": "vaggam idaṃ dutiyo Mucalindo, ",
  "ud8.10:7.3": "Nandakavaggavaro tatiyo, ",
  "ud8.10:7.4": "Meghiyavaggavaro catuttho. ",
  "ud8.10:8.1": "pañcamavaggavaran ti Soṇo, ",
  "ud8.10:8.2": "chaṭṭhamavaggavaraṃ ti jaccandho, ",
  "ud8.10:8.3": "sattamavaggavaran ti ca Cūḷo, ",
  "ud8.10:8.4": "Pāṭaligāmiyavar' aṭṭhamavaggo. ",
  "ud8.10:9.1": "asītianūnakasuttavaraṃ vaggam ",
  "ud8.10:9.2": "id' aṭṭhamaṃ suvibhattaṃ ",
  "ud8.10:9.3": "dassitaṃ cakkhumatā vimalena ",
  "ud8.10:9.4": "saddhā hi taṃ udānan t' idam āhu. udānam samattaṃ. ",
  "ud8.10:9.5": ""
}
