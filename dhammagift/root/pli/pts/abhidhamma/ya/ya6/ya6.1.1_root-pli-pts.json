{
  "ya6.1.1:0.1": "",
  "ya6.1.1:0.2": "",
  "ya6.1.1:0.3": "",
  "ya6.1.1:1.1": "",
  "ya6.1.1:2.1": "Tayo saṅkhārā: (1s) kāyasaṅkhāro (2s) vacīsaṅkhāro (3s) cittasaṅkhāro. Assāsapassāsā kāyasaṅkhāro, vitakkavicārā vacīsaṅkhāro, saññā ca vedanā ca cittasaṅkhāro, ṭhapetvā vitakkavicāre sabbe pi cittasampayuttakā dhammā cittasaṅkhāro. ",
  "ya6.1.1:3.0.1": "",
  "ya6.1.1:3.0.2": "",
  "ya6.1.1:3.1": "Kāyo kāyasaṅkhāro, ",
  "ya6.1.1:4.1": "kāyasaṅkhāro kāyo; ",
  "ya6.1.1:5.1": "vacī vacīsaṅkhāro, ",
  "ya6.1.1:6.1": "vacīsaṅkhāro vacī; ",
  "ya6.1.1:7.1": "cittaṃ cittasaṅkhāro, ",
  "ya6.1.1:8.1": "cittasaṅkhāro cittaṃ. ",
  "ya6.1.1:9.0": "",
  "ya6.1.1:9.1": "Na kāyo na kāyasaṅkhāro, ",
  "ya6.1.1:10.1": "na kāyasaṅkhāro na kāyo; ",
  "ya6.1.1:11.1": "na vacī . . . (as ",
  "ya6.1.1:12.1": "for kāyo) . . . ",
  "ya6.1.1:13.1": "na cittaṃ . . . ",
  "ya6.1.1:14.1": "",
  "ya6.1.1:15.0.1": "",
  "ya6.1.1:15.0.2": "",
  "ya6.1.1:15.1": "Kāyo kāyasaṅkhāro, ",
  "ya6.1.1:16.1": "saṅkhārā vacīsaṅkhāro; ",
  "ya6.1.1:17.1": "kāyo kāyasaṅkhāro, ",
  "ya6.1.1:18.1": "saṅkhārā cittasaṅkhāro. ",
  "ya6.1.1:19.1": "Vacī vacīsaṅkhāro, ",
  "ya6.1.1:20.1": "saṅkhārā kāyasaṅkhāro . . . ",
  "ya6.1.1:21.1": "(as for ",
  "ya6.1.1:22.1": "kāyo) . . . cittasaṅkhāro. ",
  "ya6.1.1:23.1": "Cittaṃ cittasaṅkhāro, ",
  "ya6.1.1:24.1": "saṅkhārā kāyasaṅkhāro . . . ",
  "ya6.1.1:25.1": "",
  "ya6.1.1:26.1": "vacīsaṅkhāro. ",
  "ya6.1.1:27.0": "",
  "ya6.1.1:27.1": "Na kāyo na kāyasaṅkhāro, ",
  "ya6.1.1:28.1": "na saṅkhārā na vacīsaṅkhāro; ",
  "ya6.1.1:29.1": "na kāyo na kāyasaṅkhāro, ",
  "ya6.1.1:30.1": "na saṅkhārā na cittasaṅkhāro. ",
  "ya6.1.1:31.1": "Na vacī na vacīsaṅkhāro, ",
  "ya6.1.1:32.1": "na saṅkhārā na kāyasaṅkhāro . . . ",
  "ya6.1.1:33.1": "(as for ",
  "ya6.1.1:34.1": "kāyo) . . . na cittasaṅkhāro. ",
  "ya6.1.1:35.1": "Na cittaṃ na cittasaṅkhāro, ",
  "ya6.1.1:36.1": "na saṅkhārā na kāyasaṅkhāro . . . ",
  "ya6.1.1:37.1": "na ",
  "ya6.1.1:38.1": "vacīsaṅkhāro. ",
  "ya6.1.1:39.0.1": "",
  "ya6.1.1:39.0.2": "",
  "ya6.1.1:39.1": "Kāyasaṅkhāro vacīsaṅkhāro, ",
  "ya6.1.1:40.1": "vacīsaṅkhāro kāyasaṅkhāro; ",
  "ya6.1.1:41.1": "kāyasaṅkhāro cittasaṅkhāro, ",
  "ya6.1.1:42.1": "cittasaṅkhāro kāyasaṅkhāro. ",
  "ya6.1.1:43.1": "Vacīsaṅkhāro cittasaṅkhāro, ",
  "ya6.1.1:44.1": "cittasaṅkhāro vacīsaṅkhāro. ",
  "ya6.1.1:45.0": "",
  "ya6.1.1:45.1": "Na kāyasaṅkhāro na vacīsaṅkhāro . . . ",
  "ya6.1.1:46.1": "(as in ",
  "ya6.1.1:47.1": "preceding paragraph, ",
  "ya6.1.1:48.1": "but with ",
  "ya6.1.1:49.1": "negative ",
  "ya6.1.1:50.1": "forms). [Paṇṇattivāro. ] ",
  "ya6.1.1:51.1": ""
}
