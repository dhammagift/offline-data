  "ya5.1.1:1.1": "",
  "ya5.1.1:2.1": "Cattāri saccāni: 1. dukkhasaccaṃ 3. nirodhasaccaṃ. 2. samudayasaccaṃ. 4. maggasaccaṃ. ",
  "ya5.1.1:3.0.1": "",
  "ya5.1.1:3.0.2": "",
  "ya5.1.1:3.1": "Dukkhaṃ dukkhasaccaṃ, ",
  "ya5.1.1:4.1": "dukkhasaccaṃ dukkhaṃ; ",
  "ya5.1.1:5.1": "samudayo samudayasaccaṃ, ",
  "ya5.1.1:6.1": "samudayasaccaṃ samudayo; ",
  "ya5.1.1:7.1": "nirodho nirodhasaccaṃ, ",
  "ya5.1.1:8.1": "nirodhasaccaṃ nirodho; ",
  "ya5.1.1:9.1": "maggo maggasaccaṃ, ",
  "ya5.1.1:10.1": "maggasaccaṃ maggo. ",
  "ya5.1.1:11.0": "",
  "ya5.1.1:11.1": "Na dukkhaṃ na dukkhasaccaṃ, ",
  "ya5.1.1:12.1": "na dukkhasaccaṃ na dukkhaṃ; ",
  "ya5.1.1:13.1": "na samudayo na samudayasaccaṃ, ",
  "ya5.1.1:14.1": "na samudayasaccaṃ na samudayo; ",
  "ya5.1.1:15.1": "na nirodho na nirodhasaccaṃ ",
  "ya5.1.1:16.1": "na nirodhasaccaṃ na nirodho; ",
  "ya5.1.1:17.1": "na maggo na maggasaccaṃ, ",
  "ya5.1.1:18.1": "na maggasaccaṃ na maggo. ",
  "ya5.1.1:19.0.1": "",
  "ya5.1.1:19.0.2": "",
  "ya5.1.1:19.1": "Dukkhaṃ dukkhasaccaṃ, ",
  "ya5.1.1:20.1": "saccā samudayasaccaṃ; ",
  "ya5.1.1:21.1": "dukkhaṃ dukkhasaccaṃ, ",
  "ya5.1.1:22.1": "saccā nirodhasaccaṃ; ",
  "ya5.1.1:23.1": "dukkhaṃ dukkhasaccaṃ, ",
  "ya5.1.1:24.1": "saccā maggasaccaṃ. ",
  "ya5.1.1:25.1": "Samudayo samudayasaccaṃ, ",
  "ya5.1.1:26.1": "saccā dukkhasaccaṃ, . . . ",
