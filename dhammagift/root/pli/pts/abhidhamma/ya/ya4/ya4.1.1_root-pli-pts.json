{
  "ya4.1.1:0.1": "",
  "ya4.1.1:0.2": "",
  "ya4.1.1:0.3": "",
  "ya4.1.1:1.1": "",
  "ya4.1.1:2.1": "Aṭṭhārasa dhātuyo: 1. cakkhudhātu. 6. rūpadhātu. 2. sotadhātu. 7. saddadhātu. 3. ghānadhātu. 8. gandhadhātu. 4. jivhādhātu. 9. rasadhātu. 5. kāyadhātu. 10. phoṭṭhabbadhātu. 11. cakkhuviññāṇadhātu. 15. kāyaviññāṇadhātu. 12. sotaviññāṇadhātu. 16. manodhātu. 13. ghānaviññāṇadhātu. 17. manoviññāṇadhātu. 14. jivhāviññāṇadhātu. 18. dhammadhātu. ",
  "ya4.1.1:3.0.1": "",
  "ya4.1.1:3.0.2": "",
  "ya4.1.1:3.1": "Cakkhu cakkhudhātu, ",
  "ya4.1.1:4.1": "cakkhudhātu cakkhu; ",
  "ya4.1.1:5.1": "sotaṃ sotādhātu, ",
  "ya4.1.1:6.1": "sotadhātu sotaṃ . . . pe . . . ",
  "ya4.1.1:7.1": "Cakkhuviññāṇaṃ cakkhuviññāṇadhātu, ",
  "ya4.1.1:8.1": "cakkhuviññāṇadhātu cakkhuviññāṇaṃ; . . . pe . . . ",
  "ya4.1.1:9.1": "Mano manodhātu, ",
  "ya4.1.1:10.1": "manodhātu mano; ",
  "ya4.1.1:11.1": "manoviññāṇaṃ manoviññāṇadhātu, ",
  "ya4.1.1:12.1": "manoviññāṇadhātu manoviññaṇaṃ; ",
  "ya4.1.1:13.1": "dhammo dhammadhātu, ",
  "ya4.1.1:14.1": "dhammadhātu dhammo. ",
  "ya4.1.1:15.0": "",
  "ya4.1.1:15.1": "Na cakkhu na cakkhudhātu, ",
  "ya4.1.1:16.1": "na cakkhudhātu na cakkhu; ",
  "ya4.1.1:17.1": "na sotaṃ na sotadhātu, ",
  "ya4.1.1:18.1": "na sotadhātu na sotaṃ . . . pe . . . ",
  "ya4.1.1:19.1": "Na cakkhuviññāṇaṃ na cakkhuviññāṇadhātu, ",
  "ya4.1.1:20.1": "na cakkhuviññāṇadhātu na cakkhuviññāṇaṃ; . . . pe . . . ",
  "ya4.1.1:21.1": "Na mano na manodhātu, ",
  "ya4.1.1:22.1": "na manodhātu na mano; ",
  "ya4.1.1:23.1": "na manoviññāṇaṃ na manoviññāṇadhātu, . . . ",
  "ya4.1.1:24.1": "na manoviññāṇaṃ; ",
  "ya4.1.1:25.1": "na dhammo na dhammadhātu, . . . ",
  "ya4.1.1:26.1": "na dhammo. ",
  "ya4.1.1:27.0.1": "",
  "ya4.1.1:27.0.2": "",
  "ya4.1.1:27.1": "Cakkhu cakkhudhātu, ",
  "ya4.1.1:28.1": "dhātū sotādhātu . . . pe . . . ",
  "ya4.1.1:29.1": "cakkhu cakkhudhātu, ",
  "ya4.1.1:30.1": "dhātū dhammadhātu. ",
  "ya4.1.1:31.1": "(Yathā Āyatanayamake cakkaṃ bandhitaṃ, cvaṃ idha cakkaṃ bandhitabbaṃ.) ",
  "ya4.1.1:32.0": "",
  "ya4.1.1:32.1": "Na cakkhu na cakkhudhātu, ",
  "ya4.1.1:33.1": "na dhātū na sotadhātu; ",
  "ya4.1.1:34.1": "na cakkhu na cakkhudhātu, ",
  "ya4.1.1:35.1": "na dhātū na ghānadhātu; . . . pe . . . ",
  "ya4.1.1:36.1": "na cakkhu na cakkhudhātu, ",
  "ya4.1.1:37.1": "na dhātū na dhammadhātu . . . pe . . . ",
  "ya4.1.1:38.1": "na dhammo na dhammadhātu, ",
  "ya4.1.1:39.1": "na dhātū na cakkhudhātu; . . . pe . . . ",
  "ya4.1.1:40.1": "na dhammo na dhammadhātu, ",
  "ya4.1.1:41.1": "na dhātū an manoviññāṇadhātu. ",
  "ya4.1.1:42.1": "(cakkaṃ bandhitabbaṃ.) ",
  "ya4.1.1:43.0.1": "",
  "ya4.1.1:43.0.2": "",
  "ya4.1.1:43.1": "Cakkhu dhātu, ",
  "ya4.1.1:44.1": "dhātū cakkhu; ",
  "ya4.1.1:45.1": "sotaṃ . . . pe . . . ",
  "ya4.1.1:46.1": "",
  "ya4.1.1:47.1": "ghānaṃ jivhā kāyo rūpaṃ saddo gandho raso phoṭṭhabbo ",
  "ya4.1.1:48.1": "",
  "ya4.1.1:49.1": "cakkhuviññāṇaṃ ",
  "ya4.1.1:50.1": "sotaviññāṇaṃ ",
  "ya4.1.1:51.1": "",
  "ya4.1.1:52.1": "ghānaviññāṇaṃ jivhāviññāṇaṃ kāyaviññāṇaṃ ",
  "ya4.1.1:53.1": "mano dhātu, ",
  "ya4.1.1:54.1": "dhātū mano; ",
  "ya4.1.1:55.1": "manoviññāṇaṃ dhātu, ",
  "ya4.1.1:56.1": "dhātū manoviññāṇaṃ; ",
  "ya4.1.1:57.1": "dhammo dhātu, ",
  "ya4.1.1:58.1": "dhātū dhammo. ",
  "ya4.1.1:59.0": "",
  "ya4.1.1:59.1": "Na cakkhu na dhātu, ",
  "ya4.1.1:60.1": "na dhātū na cakkhu; ",
  "ya4.1.1:61.1": "na sotaṃ . . . pe . . . ",
  "ya4.1.1:62.1": "",
  "ya4.1.1:63.1": "na ghānaṃ na jivhā na kāyo na rūpaṃ na saddo na gandho na raso na phoṭṭhabbo ",
  "ya4.1.1:64.1": "na cakkhuviññāṇaṃ ",
  "ya4.1.1:65.1": "",
  "ya4.1.1:66.1": "na sotaviññāṇaṃ na ghānaviññāṇaṃ na jivhāviññāṇaṃ ",
  "ya4.1.1:67.1": "na kāyaviññāṇaṃ na ",
  "ya4.1.1:68.1": "",
  "ya4.1.1:69.1": "mano na dhātu, ",
  "ya4.1.1:70.1": "na dhātū na mano; ",
  "ya4.1.1:71.1": "na manoviññāṇaṃ na dhātu, ",
  "ya4.1.1:72.1": "na dhātū na manoviññāṇaṃ; ",
  "ya4.1.1:73.1": "na dhammo na dhātu, ",
  "ya4.1.1:74.1": "na dhātū na dhammo. ",
  "ya4.1.1:75.0.1": "",
  "ya4.1.1:75.0.2": "",
  "ya4.1.1:75.1": "Cakkhu dhātu, ",
  "ya4.1.1:76.1": "dhātū sotaṃ; . . . pe . . . ",
  "ya4.1.1:77.1": "cakkhu dhātu, ",
  "ya4.1.1:78.1": "dhātū dhammo, . . . pe . . . ",
  "ya4.1.1:79.1": "dhammo dhātu, ",
  "ya4.1.1:80.1": "dhātū cakkhuṃ; . . . pe . . . ",
  "ya4.1.1:81.1": "dhammo dhātu, ",
  "ya4.1.1:82.1": "dhātū manoviññāṇaṃ. ",
  "ya4.1.1:83.1": "(cakkaṃ bandhitabbaṃ.) ",
  "ya4.1.1:84.0": "",
  "ya4.1.1:84.1": "Na cakkhu na dhātu, ",
  "ya4.1.1:85.1": "na dhātū na sotaṃ; . . . ",
  "ya4.1.1:86.1": "",
  "ya4.1.1:87.1": "pe . . . ",
  "ya4.1.1:88.1": "na cakkhu na dhātu, ",
  "ya4.1.1:89.1": "na dhātū na dhammo . . . pe . . . ",
  "ya4.1.1:90.1": "na dhammo na dhātu, ",
  "ya4.1.1:91.1": "na dhātū na cakkhu; . . . pe . . . . ",
  "ya4.1.1:92.1": "na dhammo na dhātu, ",
  "ya4.1.1:93.1": "na dhātū na mānoviññāṇaṃ. ",
  "ya4.1.1:94.1": "(cakkaṃ bandhitabbaṃ.) ",
  "ya4.1.1:95.1": "UDDESAVĀRAṂ NIṬṬHITAṂ. [Paṇṇattivāro. ] "
}
