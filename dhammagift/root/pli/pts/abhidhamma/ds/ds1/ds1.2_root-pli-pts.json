{
  "ds1.2:0.1": "",
  "ds1.2:0.2": "",
  "ds1.2:1.0.1": "",
  "ds1.2:1.0.2": "",
  "ds1.2:1.1": "Hetū dhammā, ",
  "ds1.2:2.1": "na hetū dhammā. ",
  "ds1.2:3.0": "",
  "ds1.2:3.1": "Sahetukā dhammā, ",
  "ds1.2:4.1": "ahetukā dhammā. ",
  "ds1.2:5.0": "",
  "ds1.2:5.1": "",
  "ds1.2:6.1": "",
  "ds1.2:7.0": "",
  "ds1.2:7.1": "Hetu-sampayuttā dhammā, hetu-vippayuttā dhammā. Hetu c' eva dhammā, sahetukā ca, ",
  "ds1.2:8.1": "sahetukā c' eva dhammā na ca hetū. ",
  "ds1.2:9.0": "",
  "ds1.2:9.1": "Hetū c' eva dhammā hetu-sampayuttā ca, ",
  "ds1.2:10.1": "hetu-sampayuttā c' eva dhammā na ca hetū. No ",
  "ds1.2:11.0": "",
  "ds1.2:11.1": "hetū kho pana dhammā sahetukā pi ",
  "ds1.2:12.1": "ahetukā pi. ",
  "ds1.2:12.2": "Hetu-gocchakaṃ. ",
  "ds1.2:13.0.1": "",
  "ds1.2:13.0.2": "",
  "ds1.2:13.1": "Sappaccayā dhammā, ",
  "ds1.2:14.1": "appaccayā dhammā. ",
  "ds1.2:15.0": "",
  "ds1.2:15.1": "Saṅkhatā dhamma, ",
  "ds1.2:16.1": "asaṅkhatā dhammā. ",
  "ds1.2:17.0": "",
  "ds1.2:17.1": "Sanidassanā dhammā, ",
  "ds1.2:18.1": "anidassanā dhammā. ",
  "ds1.2:19.0": "",
  "ds1.2:19.1": "Sappaṭighā dhammā, ",
  "ds1.2:20.1": "appaṭighā dhammā. ",
  "ds1.2:21.0": "",
  "ds1.2:21.1": "Rūpino dhammā, ",
  "ds1.2:22.1": "arūpino dhammā. ",
  "ds1.2:23.0": "",
  "ds1.2:23.1": "Lokiyā dhammā, ",
  "ds1.2:24.1": "lokuttarā dhammā. ",
  "ds1.2:25.0": "",
  "ds1.2:25.1": "Kenaci viññeyyā dhammā, ",
  "ds1.2:26.1": "kenaci na viññeyyā dhammā. ",
  "ds1.2:26.2": "Cūḷantara-dukaṃ. ",
  "ds1.2:27.0.1": "",
  "ds1.2:27.0.2": "",
  "ds1.2:27.1": "Āsavā dhammā, ",
  "ds1.2:28.1": "no āsavā dhammā. ",
  "ds1.2:29.0": "",
  "ds1.2:29.1": "Sāsavā dhammā, ",
  "ds1.2:30.1": "anāsavā dhammā. ",
  "ds1.2:31.0": "",
  "ds1.2:31.1": "",
  "ds1.2:32.1": "",
  "ds1.2:33.0": "",
  "ds1.2:33.1": "Āsava-sampayuttā dhammā, āsava-vippayuttā dhammā. Āsavā c' eva dhammā sāsavā ca, ",
  "ds1.2:34.1": "sāsavā c' eva dhammā no ca āsavā. ",
  "ds1.2:35.0": "",
  "ds1.2:35.1": "Āsavā c' eva dhammā āsava-sampayuttā ca ",
  "ds1.2:36.1": "āsava-sampayuttā c' eva dhammā no ca āsavā. ",
  "ds1.2:37.0": "",
  "ds1.2:37.1": "Āsava-vippayuttā kho pana dhammā sāsavāpi ",
  "ds1.2:38.1": "anāsavāpi. ",
  "ds1.2:38.2": "Āsava-gocchakaṃ. ",
  "ds1.2:39.0.1": "",
  "ds1.2:39.0.2": "",
  "ds1.2:39.1": "Saññojanā dhammā, ",
  "ds1.2:40.1": "no saññojanā dhammā. ",
  "ds1.2:41.0": "",
  "ds1.2:41.1": "Saññojaniyā dhammā, ",
  "ds1.2:42.1": "asaññojaniyā dhammā. ",
  "ds1.2:43.0": "",
  "ds1.2:43.1": "Saññojanasampayuttā dhammā, ",
  "ds1.2:44.1": "saññojana-vippayuttā dhammā. ",
  "ds1.2:45.0": "",
  "ds1.2:45.1": "Saññojanā c' eva dhammā saññojaniyā ca, ",
  "ds1.2:46.1": "saññojaniyā c' eva dhammā no ca saññojanā. ",
  "ds1.2:47.0": "",
  "ds1.2:47.1": "Saññojanā c' eva dhammā saññojana-sampayuttā ca, ",
  "ds1.2:48.1": "sāññojana-sampayuttā c' eva dhammā no ca saññojanā. ",
  "ds1.2:49.0": "",
  "ds1.2:49.1": "Saññojana-vippayuttā kho pana dhammā saññojaniyā pi ",
  "ds1.2:50.1": "asaññojaniyā pi. ",
  "ds1.2:50.2": "Saññojana- ",
  "ds1.2:51.0.1": "goacchakaṃ. ",
  "ds1.2:51.0.2": "",
  "ds1.2:51.1": "Ganthā dhammā, ",
  "ds1.2:52.1": "no ganthā dhammā. ",
  "ds1.2:53.0": "",
  "ds1.2:53.1": "Ganthaniyā dhammā, ",
  "ds1.2:54.1": "aganthaniyā-dhammā. ",
  "ds1.2:55.0": "",
  "ds1.2:55.1": "",
  "ds1.2:56.1": "",
  "ds1.2:57.0": "",
  "ds1.2:57.1": "Gantha-sampayuttā dhammā, gantha-vippayuttā dhammā. Ganthā c' eva dhammā ganthaniyā ca, ",
  "ds1.2:58.1": "ganthaniyā c' eva dhammā no ca ganthā. ",
  "ds1.2:59.0": "",
  "ds1.2:59.1": "Ganthā c' eva dhammā gantha-sampayuttā ca, ",
  "ds1.2:60.1": "gantha-sampayuttā c' eva dhammā no ca ganthā. ",
  "ds1.2:61.0": "",
  "ds1.2:61.1": "Gantha-vippayuttā kho pana dhammā ganthaniyā pi ",
  "ds1.2:62.1": "aganthaniyā pi. ",
  "ds1.2:62.2": "Gantha-gocchakaṃ. ",
  "ds1.2:63.0.1": "",
  "ds1.2:63.0.2": "",
  "ds1.2:63.1": "Oghā dhammā, ",
  "ds1.2:64.1": "no oghā dhammā. ",
  "ds1.2:65.0": "",
  "ds1.2:65.1": "Oghaniyā dhammā, ",
  "ds1.2:66.1": "anoghaniyā dhammā. ",
  "ds1.2:67.0": "",
  "ds1.2:67.1": "",
  "ds1.2:68.1": "",
  "ds1.2:69.0": "",
  "ds1.2:69.1": "Ogha-sampayuttā dhammā, ogha-vippayuttā dhammā. Oghā c' eva dhammā oghaniyā ca, ",
  "ds1.2:70.1": "oghaniyā c' eva dhammā no ca oghā. ",
  "ds1.2:71.0": "",
  "ds1.2:71.1": "Oghā c' eva dhammā ogha-sampayuttā ca, ",
  "ds1.2:72.1": "ogha-sampayuttā c' eva dhammā no ca oghā. ",
  "ds1.2:73.0": "",
  "ds1.2:73.1": "Ogha-vippayuttā kho pana dhammā oghaniyā pi ",
  "ds1.2:74.1": "anoghaniyā pi. ",
  "ds1.2:74.2": "Ogha-gocchakaṃ. ",
  "ds1.2:75.0.1": "",
  "ds1.2:75.0.2": "",
  "ds1.2:75.1": "Yogā dhammā, ",
  "ds1.2:76.1": "no yogā dhammā. ",
  "ds1.2:77.0": "",
  "ds1.2:77.1": "Yoganiyā dhammā, ",
  "ds1.2:78.1": "ayoganiyā dhammā ",
  "ds1.2:79.0": "",
  "ds1.2:79.1": "",
  "ds1.2:80.1": "",
  "ds1.2:81.0": "",
  "ds1.2:81.1": "Yoga-sampayuttā dhammā, yoga-vippayuttā dhammā. Yogā c' eva dhammā yoganiyā ca, ",
  "ds1.2:82.1": "yoganiyā c' eva dhammā no ca yogā. ",
  "ds1.2:83.0": "",
  "ds1.2:83.1": "Yogā c' eva dhammā yoga-sampayuttā ca, ",
  "ds1.2:84.1": "yoga-sampayuttā c' eva dhammā no ca yogā. ",
  "ds1.2:85.0": "",
  "ds1.2:85.1": "Yoga-vippayuttā kho pana dhammā yoganiyā pi ",
  "ds1.2:86.1": "ayoganiyā pi. ",
  "ds1.2:86.2": "Yoga-gocchakaṃ. ",
  "ds1.2:87.0.1": "",
  "ds1.2:87.0.2": "",
  "ds1.2:87.1": "Nīvaraṇā dhammā, ",
  "ds1.2:88.1": "no nīvaraṇā dhammā. ",
  "ds1.2:89.0": "",
  "ds1.2:89.1": "Nīvaraṇīyā dhammā, ",
  "ds1.2:90.1": "anīvaraṇīyā dhammā ",
  "ds1.2:91.0": "",
  "ds1.2:91.1": "",
  "ds1.2:92.1": "",
  "ds1.2:93.0": "",
  "ds1.2:93.1": "Nīvaraṇa-sampayuttā dhammā, nīvaraṇa-vippayuttā dhammā. Nīvaraṇā c' eva dhammā nīvaraṇīyā ca, ",
  "ds1.2:94.1": "nīvaraṇīyā c' eva dhammā no ca nīvaraṇā. ",
  "ds1.2:95.0": "",
  "ds1.2:95.1": "Nīvaraṇa-vippayuttā ",
  "ds1.2:96.1": "",
  "ds1.2:97.0": "",
  "ds1.2:97.1": "kho pana dhammā nīvaraṇīyā pi ",
  "ds1.2:98.1": "anīvaraṇīyā pi. ",
  "ds1.2:98.2": "Nīvaraṇa-gocchakaṃ. ",
  "ds1.2:99.0.1": "",
  "ds1.2:99.0.2": "",
  "ds1.2:99.1": "Parāmāsā dhammā, ",
  "ds1.2:100.1": "no parāmāsā dhammā. ",
  "ds1.2:101.0": "",
  "ds1.2:101.1": "Parāmaṭṭhā dhammā, ",
  "ds1.2:102.1": "aparāmaṭṭhā dhammā. ",
  "ds1.2:103.0": "",
  "ds1.2:103.1": "",
  "ds1.2:104.1": "",
  "ds1.2:105.0": "",
  "ds1.2:105.1": "Parāmāsa-sampayuttā dhammā parāmāsa-vippayuttā dhammā. Parāmāsā c' eva dhammā parāmaṭṭhā ca, ",
  "ds1.2:106.1": "parāmaṭṭhā c' eva dhammā no ca parāmāsā. ",
  "ds1.2:107.0": "",
  "ds1.2:107.1": "Parāmāsa-vippayuttā kho pana dhammā parāmaṭṭhā pi ",
  "ds1.2:108.1": "aparāmaṭṭhā pi. ",
  "ds1.2:108.2": "Parāmāsa-gocchakaṃ. ",
  "ds1.2:109.0.1": "",
  "ds1.2:109.0.2": "",
  "ds1.2:109.1": "Sārammaṇā dhammā, ",
  "ds1.2:110.1": "anārammaṇā dhammā. ",
  "ds1.2:111.0": "",
  "ds1.2:111.1": "Cittā dhammā, ",
  "ds1.2:112.1": "no cittā dhammā. ",
  "ds1.2:113.0": "",
  "ds1.2:113.1": "Cetasikā dhammā, ",
  "ds1.2:114.1": "acetasikā dhammā. ",
  "ds1.2:115.0": "",
  "ds1.2:115.1": "Citta-sampayuttā dhammā, ",
  "ds1.2:116.1": "citta-vippayuttā dhammā. ",
  "ds1.2:117.0": "",
  "ds1.2:117.1": "Citta-saṃsaṭṭhā dhammā, ",
  "ds1.2:118.1": "citta-visaṃsaṭṭhā dhammā. ",
  "ds1.2:119.0": "",
  "ds1.2:119.1": "Citta-samuṭṭhānā dhammā, ",
  "ds1.2:120.1": "no citta-samuṭṭhānā dhammā. ",
  "ds1.2:121.0": "",
  "ds1.2:121.1": "Citta-sahabhuno dhammā, ",
  "ds1.2:122.1": "no citta-sahabhuno dhammā. ",
  "ds1.2:123.0": "",
  "ds1.2:123.1": "Cittānuparivattino dhammā, ",
  "ds1.2:124.1": "no cittānuparivattino dhammā. ",
  "ds1.2:125.0": "",
  "ds1.2:125.1": "Citta-saṃsaṭṭhā-samuṭṭhānā dhammā, ",
  "ds1.2:126.1": "no citta-saṃsaṭṭhasamuṭṭhānā dhammā. Citta-saṃsaṭṭha- ",
  "ds1.2:127.0": "",
  "ds1.2:127.1": "samuṭṭhāna-sahabhuno dhammā, ",
  "ds1.2:128.1": "no cittasaṃsaṭṭha-samuṭṭhāna-sahabhuno dhammā. ",
  "ds1.2:129.0": "",
  "ds1.2:129.1": "Citta-saṃsaṭṭhā-samuṭṭhānānuparivattino dhammā, ",
  "ds1.2:130.1": "no cittasaṃsaṭṭha-samuṭṭhānānuparivattino dhammā. ",
  "ds1.2:131.0": "",
  "ds1.2:131.1": "Ajjhattikā dhammā, ",
  "ds1.2:132.1": "bāhirā dhammā. ",
  "ds1.2:133.0": "",
  "ds1.2:133.1": "Upādā dhammā, ",
  "ds1.2:134.1": "no upādā dhammā. ",
  "ds1.2:135.0": "",
  "ds1.2:135.1": "Upādiṇṇā dhammā, ",
  "ds1.2:136.1": "anupādiṇṇā dhammā. ",
  "ds1.2:136.2": "Mahantara-dukaṃ. ",
  "ds1.2:137.0.1": "",
  "ds1.2:137.0.2": "",
  "ds1.2:137.1": "Upādānā dhammā, ",
  "ds1.2:138.1": "no upādānā dhammā. ",
  "ds1.2:139.0": "",
  "ds1.2:139.1": "Upādāniyā dhammā, ",
  "ds1.2:140.1": "anupādāniyā dhammā. ",
  "ds1.2:141.0": "",
  "ds1.2:141.1": "",
  "ds1.2:142.1": "",
  "ds1.2:143.0": "",
  "ds1.2:143.1": "Upādāna-sampayuttā dhammā, upādāna-vippayuttā dhammā Upādānā c' eva dhammā upādāniyā ca, ",
  "ds1.2:144.1": "upādāniyā c' eva dhammā no ca upādānā. ",
  "ds1.2:145.0": "",
  "ds1.2:145.1": "Upādānā c' eva dhammā upādāna-sampayuttā ca, ",
  "ds1.2:146.1": "upādānasampayuttā c' eva dhammā no ca upādānā. ",
  "ds1.2:147.0": "",
  "ds1.2:147.1": "Upādāna-vippayuttā kho pana dhammā upādāniyā pi ",
  "ds1.2:148.1": "anupādāniyā pi. ",
  "ds1.2:148.2": "Upādāna-gocchakaṃ. ",
  "ds1.2:149.0.1": "",
  "ds1.2:149.0.2": "",
  "ds1.2:149.1": "Kilesā dhammā, ",
  "ds1.2:150.1": "no kilesā dhammā. ",
  "ds1.2:151.0": "",
  "ds1.2:151.1": "Saṅkilesikā dhammā, ",
  "ds1.2:152.1": "asaṅkilesika dhammā. ",
  "ds1.2:153.0": "",
  "ds1.2:153.1": "Saṅkiliṭṭhā dhammā, ",
  "ds1.2:154.1": "asaṅkiliṭṭhā dhammā. ",
  "ds1.2:155.0": "",
  "ds1.2:155.1": "",
  "ds1.2:156.1": "",
  "ds1.2:157.0": "",
  "ds1.2:157.1": "Kilesa-sampayuttā dhammā, kilesa-vippayuttā dhammā. Kilesā c' eva dhammā saṅkilesikā ca, ",
  "ds1.2:158.1": "saṅkilesikā c' eva dhammā no ca kilesā. ",
  "ds1.2:159.0": "",
  "ds1.2:159.1": "Kilesā c' eva dhammā saṅkiliṭṭhā ca, ",
  "ds1.2:160.1": "saṅkiliṭṭhā c' eva dhammā no ca kilesā. ",
  "ds1.2:161.0": "",
  "ds1.2:161.1": "Kilesā c' eva dhammā kilesa-sampayuttā ca, ",
  "ds1.2:162.1": "kilesa-sampayuttā c' eva dhammā no ca kilesā. ",
  "ds1.2:163.0": "",
  "ds1.2:163.1": "Kilesa-vippayuttā kho pana dhammā saṅkilesikā pi ",
  "ds1.2:164.1": "asaṅkilesikā pi. ",
  "ds1.2:164.2": "Kilesa-gocchakaṃ. ",
  "ds1.2:165.0.1": "",
  "ds1.2:165.0.2": "",
  "ds1.2:165.1": "Dassanena pahātabbā dhammā, ",
  "ds1.2:166.1": "na dassanena pahātabbā dhammā. ",
  "ds1.2:167.0": "",
  "ds1.2:167.1": "Bhāvanāya pahātabbā dhammā, ",
  "ds1.2:168.1": "na bhāvanāya pahātabbā dhammā. ",
  "ds1.2:169.0": "",
  "ds1.2:169.1": "Dassanena pahātabba-hatukā dhammā, ",
  "ds1.2:170.1": "na dassanena pahātabba-hetukā dhammā. ",
  "ds1.2:171.0": "",
  "ds1.2:171.1": "Bhāvanāya pahātabba-hetukā dhammā, ",
  "ds1.2:172.1": "na bhāvanāya pahātabba-hetukā dhammā. ",
  "ds1.2:173.0": "",
  "ds1.2:173.1": "Savitakkā dhammā, ",
  "ds1.2:174.1": "avitakkā dhammā. ",
  "ds1.2:175.0": "",
  "ds1.2:175.1": "Savicārā dhammā, ",
  "ds1.2:176.1": "avicārā dhammā. ",
  "ds1.2:177.0": "",
  "ds1.2:177.1": "Sappītikā dhammā, ",
  "ds1.2:178.1": "appītikā dhammā. ",
  "ds1.2:179.0": "",
  "ds1.2:179.1": "Pītī-sahagatā dhammā, ",
  "ds1.2:180.1": "na pīti-sahagatā dhammā. ",
  "ds1.2:181.0": "",
  "ds1.2:181.1": "Sukha-sahagatā dhammā, ",
  "ds1.2:182.1": "na sukha-sahagatā dhammā. ",
  "ds1.2:183.0": "",
  "ds1.2:183.1": "Upekkhā-sahagatā dhammā, ",
  "ds1.2:184.1": "na upekkhā-sahagatā dhammā. ",
  "ds1.2:185.0": "",
  "ds1.2:185.1": "Kāmāvacarā dhammā, ",
  "ds1.2:186.1": "na kāmāvacarā dhammā. ",
  "ds1.2:187.0": "",
  "ds1.2:187.1": "Rūpāvacarā dhammā, ",
  "ds1.2:188.1": "na rūpāvacarā dhammā. ",
  "ds1.2:189.0": "",
  "ds1.2:189.1": "Arūpāvacarā dhammā, ",
  "ds1.2:190.1": "na arūpāvacarā dhammā. ",
  "ds1.2:191.0": "",
  "ds1.2:191.1": "Pariyāpannā dhammā, ",
  "ds1.2:192.1": "apariyāpannā dhammā. ",
  "ds1.2:193.0": "",
  "ds1.2:193.1": "Niyyānikā dhammā, ",
  "ds1.2:194.1": "aniyyānikā dhammā. ",
  "ds1.2:195.0": "",
  "ds1.2:195.1": "Niyatā dhammā, ",
  "ds1.2:196.1": "aniyatā dhammā. ",
  "ds1.2:197.0": "",
  "ds1.2:197.1": "Sa-uttarā dhammā, ",
  "ds1.2:198.1": "anuttarā dhammā. ",
  "ds1.2:199.0": "",
  "ds1.2:199.1": "Saraṇā dhammā, ",
  "ds1.2:200.1": "asaraṇā dhammā. ",
  "ds1.2:200.2": "Piṭṭhi-dukaṃ. ",
  "ds1.2:200.3": "Abhidhamma-mātikā. "
}
