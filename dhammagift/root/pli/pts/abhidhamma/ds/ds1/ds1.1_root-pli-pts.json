{
  "ds1.1:0.1": "",
  "ds1.1:0.2": "",
  "ds1.1:1.0.1": "",
  "ds1.1:1.0.2": "Namo tassa Bhagavato Arahato Sammāsambuddhassa. ",
  "ds1.1:1.1": "Kusalā dhammā, ",
  "ds1.1:2.1": "akusalā dhammā, ",
  "ds1.1:3.1": "avyākatā dhammā. ",
  "ds1.1:4.0": "",
  "ds1.1:4.1": "Sukhāya vedanāya sampayuttā dhammā, ",
  "ds1.1:5.1": "dukkhāya vedanāya sampayuttā dhammā, ",
  "ds1.1:6.1": "adukkham-asukhāya vedanāya sampayuttā dhammā. ",
  "ds1.1:7.0": "",
  "ds1.1:7.1": "Vipākā dhammā, ",
  "ds1.1:8.1": "vipākadhammadhammā, ",
  "ds1.1:9.1": "nevavipāka-navipākadhammadhammā. ",
  "ds1.1:10.0": "",
  "ds1.1:10.1": "Upādiṇṇupādāniyā dhammā, ",
  "ds1.1:11.1": "anupādiṇṇupādāniyā dhammā, ",
  "ds1.1:12.1": "anupādiṇṇa-anupādāniyā dhammā. ",
  "ds1.1:13.0": "",
  "ds1.1:13.1": "Saṅkiliṭṭha-saṅkilesikā dhammā, ",
  "ds1.1:14.1": "asaṅkiliṭṭhasaṅkilesikā dhammā, ",
  "ds1.1:15.1": "asaṅkiliṭṭha-asaṅkilesikā dhammā. ",
  "ds1.1:16.0": "",
  "ds1.1:16.1": "Savitakka-savicārā dhammā, ",
  "ds1.1:17.1": "avitakka-vicāramattā dhammā, ",
  "ds1.1:18.1": "avitakka-avicārā dhammā. ",
  "ds1.1:19.0": "",
  "ds1.1:19.1": "Pīti-sahagatā dhammā, ",
  "ds1.1:20.1": "sukha-sahagatā dhammā, ",
  "ds1.1:21.1": "upekkhāsahagatā dhammā. ",
  "ds1.1:22.0": "",
  "ds1.1:22.1": "Dassanena pahātabbā dhammā, ",
  "ds1.1:23.1": "bhāvanāya pahātabbā dhammā, ",
  "ds1.1:24.1": "neva dassanena na bhāvanāya pahātabbā dhammā. ",
  "ds1.1:25.0": "",
  "ds1.1:25.1": "Dassanena pahātabba-hetukā dhammā, ",
  "ds1.1:26.1": "bhāvanāya pahātabba-hetukā dhammā, ",
  "ds1.1:27.1": "neva dassanena na bhāvanāya pahātabba-hetukā dhammā. ",
  "ds1.1:28.0": "",
  "ds1.1:28.1": "Ācaya-gāmino dhammā, apacaya-gāmino dhammā, nevācayagāmino na ",
  "ds1.1:29.1": "apacayagāmino dhammā. ",
  "ds1.1:30.1": "",
  "ds1.1:31.0": "",
  "ds1.1:31.1": "Sekkhā dhammā, ",
  "ds1.1:32.1": "asekkhā dhammā, ",
  "ds1.1:33.1": "neva sekkhā nāsekkhā dhammā. ",
  "ds1.1:34.0": "",
  "ds1.1:34.1": "Parittā dhammā, ",
  "ds1.1:35.1": "mahaggatā dhammā, ",
  "ds1.1:36.1": "appamāṇā dhammā. ",
  "ds1.1:37.0": "",
  "ds1.1:37.1": "Parittārammaṇā dhammā, ",
  "ds1.1:38.1": "mahaggatārammaṇā dhammā, ",
  "ds1.1:39.1": "appamāṇārammaṇā dhammā. ",
  "ds1.1:40.0": "",
  "ds1.1:40.1": "Hīnā dhammā, ",
  "ds1.1:41.1": "majjhimā dhammā, ",
  "ds1.1:42.1": "paṇītā dhammā. ",
  "ds1.1:43.0": "",
  "ds1.1:43.1": "Micchattaniyatā dhammā, ",
  "ds1.1:44.1": "sampattaniyatā dhammā, ",
  "ds1.1:45.1": "aniyatā dhammā. ",
  "ds1.1:46.0": "",
  "ds1.1:46.1": "Maggārammaṇā dhammā, ",
  "ds1.1:47.1": "maggahetukā dhammā, ",
  "ds1.1:48.1": "maggādhipatino dhammā. ",
  "ds1.1:49.0": "",
  "ds1.1:49.1": "Uppannā dhammā, ",
  "ds1.1:50.1": "anuppannā dhammā, ",
  "ds1.1:51.1": "uppādino dhammā. ",
  "ds1.1:52.0": "",
  "ds1.1:52.1": "Atītā dhammā, ",
  "ds1.1:53.1": "anāgatā dhammā, ",
  "ds1.1:54.1": "paccuppannā dhammā. ",
  "ds1.1:55.0": "",
  "ds1.1:55.1": "Atītārammaṇā dhammā, ",
  "ds1.1:56.1": "anāgatārammaṇā dhammā, ",
  "ds1.1:57.1": "paccuppannārammaṇā dhammā. ",
  "ds1.1:58.0": "",
  "ds1.1:58.1": "Ajjhattā dhammā, ",
  "ds1.1:59.1": "bahiddhā dhammā, ",
  "ds1.1:60.1": "ajjhatta-bahiddhā dhammā. ",
  "ds1.1:61.0": "",
  "ds1.1:61.1": "Ajjhattārammaṇā dhammā, ",
  "ds1.1:62.1": "bahiddhārammaṇā dhammā, ",
  "ds1.1:63.1": "ajjhatta-bahiddhārammaṇā dhammā. ",
  "ds1.1:64.0": "",
  "ds1.1:64.1": "Sanidassana-sappaṭighā dhammā, ",
  "ds1.1:65.1": "anidassana-sappaṭighā dhammā, ",
  "ds1.1:66.1": "anidassana-appaṭighā dhammā. ",
  "ds1.1:66.2": "Tikaṃ niṭṭhitaṃ "
}
