{
  "ds1.3:0.1": "",
  "ds1.3:0.2": "",
  "ds1.3:1.0": "",
  "ds1.3:1.1": "Vijjābhāgino dhammā, ",
  "ds1.3:2.1": "avijjābhāgino dhammā. ",
  "ds1.3:3.0": "",
  "ds1.3:3.1": "Vijjūpama dhammā, ",
  "ds1.3:4.1": "vajirūpamā dhammā. ",
  "ds1.3:5.0": "",
  "ds1.3:5.1": "Bālā dhammā, ",
  "ds1.3:6.1": "paṇḍitā dhammā. ",
  "ds1.3:7.0": "",
  "ds1.3:7.1": "Kaṇhā dhammā, ",
  "ds1.3:8.1": "sukkā dhammā. ",
  "ds1.3:9.0": "",
  "ds1.3:9.1": "Tapanīyā dhammā, ",
  "ds1.3:10.1": "atapanīyā dhammā. ",
  "ds1.3:11.0": "",
  "ds1.3:11.1": "Adhivacanā dhammā, ",
  "ds1.3:12.1": "adhivacanapathā dhammā. ",
  "ds1.3:13.0": "",
  "ds1.3:13.1": "Nirutti dhammā, ",
  "ds1.3:14.1": "niruttipathā dhammā. ",
  "ds1.3:15.0": "",
  "ds1.3:15.1": "Paññatti dhammā, ",
  "ds1.3:16.1": "paññattipathā dhammā. ",
  "ds1.3:17.0": "",
  "ds1.3:17.1": "Nāmañ ca ",
  "ds1.3:18.1": "rūpañ ca. ",
  "ds1.3:19.0": "",
  "ds1.3:19.1": "Avijjā ca ",
  "ds1.3:20.1": "bhavataṇhā ca. ",
  "ds1.3:21.0": "",
  "ds1.3:21.1": "Bhavadiṭṭhi ca ",
  "ds1.3:22.1": "vibhavadiṭṭhi ca. ",
  "ds1.3:23.0": "",
  "ds1.3:23.1": "Sassatadiṭṭhi ca ",
  "ds1.3:24.1": "ucchedadiṭṭhi ca. ",
  "ds1.3:25.0": "",
  "ds1.3:25.1": "Antavādiṭṭhi ca ",
  "ds1.3:26.1": "anantavādiṭṭhi ca. ",
  "ds1.3:27.0": "",
  "ds1.3:27.1": "Pubbantānudiṭṭhi ca ",
  "ds1.3:28.1": "aparantānudiṭṭhi ca. ",
  "ds1.3:29.0": "",
  "ds1.3:29.1": "Ahirikañ ca ",
  "ds1.3:30.1": "anottappañ ca. ",
  "ds1.3:31.0": "",
  "ds1.3:31.1": "Hiri ca ",
  "ds1.3:32.1": "ottappañ ca. ",
  "ds1.3:33.0": "",
  "ds1.3:33.1": "Dovacassatā ca ",
  "ds1.3:34.1": "pāpamittatā ca. ",
  "ds1.3:35.0": "",
  "ds1.3:35.1": "Sovacassatā ca ",
  "ds1.3:36.1": "kalyāṇamittatā ca. ",
  "ds1.3:37.0": "",
  "ds1.3:37.1": "Āpatti-kusalatā ca ",
  "ds1.3:38.1": "āpatti-vuṭṭhāna-kusalatā ca. ",
  "ds1.3:39.0": "",
  "ds1.3:39.1": "Samāpatti-kusalatā ca ",
  "ds1.3:40.1": "samāpatti-vuṭṭhāna-kusalatā ca. ",
  "ds1.3:41.0": "",
  "ds1.3:41.1": "Dhātu-kusalatā ca ",
  "ds1.3:42.1": "manasikāra-kusalatā ca. ",
  "ds1.3:43.0": "",
  "ds1.3:43.1": "Āyatana-kusalatā ca ",
  "ds1.3:44.1": "paṭiccasamuppāda-kusalatā ca. ",
  "ds1.3:45.0": "",
  "ds1.3:45.1": "Ṭhāna-kusalatā ca ",
  "ds1.3:46.1": "aṭṭhāna-kusalatā ca. ",
  "ds1.3:47.0": "",
  "ds1.3:47.1": "Ajjavo ca ",
  "ds1.3:48.1": "maddavo ca. ",
  "ds1.3:49.0": "",
  "ds1.3:49.1": "Khantī ca ",
  "ds1.3:50.1": "soraccañ ca. ",
  "ds1.3:51.0": "",
  "ds1.3:51.1": "Sākhalyañ ca ",
  "ds1.3:52.1": "paṭisanthāro ca. ",
  "ds1.3:53.0": "",
  "ds1.3:53.1": "Indriyesu agutta-dvāratā ca ",
  "ds1.3:54.1": "bhojane amattaññutā ca. ",
  "ds1.3:55.0": "",
  "ds1.3:55.1": "Indriyesu gutta-dvāratā ca, ",
  "ds1.3:56.1": "bhojane mattaññutā ca. ",
  "ds1.3:57.0": "",
  "ds1.3:57.1": "Muṭṭhasaccañ ca, ",
  "ds1.3:58.1": "asampajaññañ ca. ",
  "ds1.3:59.0": "",
  "ds1.3:59.1": "Sati ca ",
  "ds1.3:60.1": "sampajaññañ ca. ",
  "ds1.3:61.0": "",
  "ds1.3:61.1": "Paṭisaṅkhāna-balañ ca ",
  "ds1.3:62.1": "bhāvanā-balañ ca. ",
  "ds1.3:63.0": "",
  "ds1.3:63.1": "Samatho ca ",
  "ds1.3:64.1": "vipassanā ca. ",
  "ds1.3:65.0": "",
  "ds1.3:65.1": "Samatha-nimittañ ca ",
  "ds1.3:66.1": "paggāha-nimittañ ca. ",
  "ds1.3:67.0": "",
  "ds1.3:67.1": "Paggāho ca ",
  "ds1.3:68.1": "avikkhepo ca. ",
  "ds1.3:69.0": "",
  "ds1.3:69.1": "Sīlavipatti ca ",
  "ds1.3:70.1": "diṭṭhivipatti ca. ",
  "ds1.3:71.0": "",
  "ds1.3:71.1": "Sīlasampadā ca ",
  "ds1.3:72.1": "diṭṭhisampadā ca. ",
  "ds1.3:73.0": "",
  "ds1.3:73.1": "Sīlavisuddhi ca ",
  "ds1.3:74.1": "diṭṭhivisuddhi ca. Diṭṭhi-visuddhi kho ",
  "ds1.3:75.0": "",
  "ds1.3:75.1": "pana ",
  "ds1.3:76.1": "yathā diṭṭhissa ca padhānaṃ. ",
  "ds1.3:77.0": "",
  "ds1.3:77.1": "Saṃvego ca saṃvejaniyesu ṭhānesu ",
  "ds1.3:78.1": "saṃviggassa ca yoniso padhānaṃ. ",
  "ds1.3:79.0": "",
  "ds1.3:79.1": "Asantuṭṭhitā ca kusalesu dhammesu, ",
  "ds1.3:80.1": "appaṭivānitā ca padhānasmiṃ. ",
  "ds1.3:81.0": "",
  "ds1.3:81.1": "Vijjā ca ",
  "ds1.3:82.1": "vimutti ca. ",
  "ds1.3:83.0": "",
  "ds1.3:83.1": "Khaye ñāṇaṃ ",
  "ds1.3:84.1": "anuppāde ñāṇan ti. Suttanta- ",
  "ds1.3:84.2": "mātikā. ",
  "ds1.3:84.3": "MĀTIKĀ NIṬṬHITĀ. 1. "
}
