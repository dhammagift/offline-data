  "kv6.4:0.1": "",
  "kv6.4:0.2": "",
  "kv6.4:0.3": "",
  "kv6.4:0.4": "",
  "kv6.4:1.1": "Ākāsānañcāyatanaṃ asaṃkhatan ti? ",
  "kv6.4:1.2": "Āmantā. ",
  "kv6.4:1.3": "Nibbānaṃ tāṇaṃ leṇaṃ saraṇaṃ parāyanaṃ accutaṃ amatan ti? ",
  "kv6.4:1.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv6.4:1.5": "Ākāsānañcāyatanaṃ asaṃkhataṃ, nibbānaṃ asaṃkhatan ti? ",
  "kv6.4:1.6": "Āmantā. ",
  "kv6.4:1.7": "Dve asaṃkhatānīti? ",
  "kv6.4:1.8": "Na h' evaṃ vattabbe --pe-- ",
  "kv6.4:1.9": "Dve asaṃkhatānīti? ",
  "kv6.4:1.10": "Āmantā. ",
  "kv6.4:1.11": "Dve tāṇāni --pe-- ",
  "kv6.4:1.12": "antarīkā vā ti? ",
  "kv6.4:1.13": "Na h' evaṃ vattabbe --pe-- 2. ",
  "kv6.4:2.1": "Ākāsānañcāyatanaṃ asaṃkhatan ti? ",
  "kv6.4:2.2": "Āmantā. ",
  "kv6.4:2.3": "Ākāsānañcāyatanaṃ bhavo gati sattāvāso saṃsāro yoni viññāṇaṭṭhiti attabhāvapaṭilābho ti? ",
  "kv6.4:2.4": "Āmantā. ",
  "kv6.4:2.5": "Asaṃkhataṃ bhavo gati sattāvāso saṃsāro yoni viññāṇaṭṭhiti attabhāvapaṭilābho ti? ",
  "kv6.4:2.6": "Na h' evaṃ vattabbe --pe-- ",
  "kv6.4:3.1": "Atthi ākāsānañcāyatanūpagaṃ kamman ti? ",
  "kv6.4:3.2": "Āmantā. ",
  "kv6.4:3.3": "Atthi asaṃkhatūpagaṃ kamman ti? ",
  "kv6.4:3.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv6.4:3.5": "Atthi ākāsānañcāyatanūpagā sattā ti? ",
  "kv6.4:3.6": "Āmantā. ",
  "kv6.4:3.7": "Atthi asaṃkhatūpagā sattā ti? ",
  "kv6.4:3.8": "Na h' evaṃ vattabbe --pe-- 3. ",
  "kv6.4:4.1": "Ākāsānañcāyatane sattā jāyanti jīyanti mīyanti cavanti uppajjantīti? ",
  "kv6.4:4.2": "Āmantā. ",
  "kv6.4:4.3": "Asaṃkhate sattā jāyanti jīyanti mīyanti cavanti uppajjantīti? ",
  "kv6.4:4.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv6.4:4.5": "Ākāsānañcāyatane atthi vedanā saññā saṃkhārā viññāṇan ti? ",
  "kv6.4:4.6": "Āmantā. ",
  "kv6.4:4.7": "Asaṃkhate atthi vedanā saññā saṃkhārā viññāṇan ti? ",
  "kv6.4:4.8": "Na h' evaṃ vattabbe --pe-- ",
  "kv6.4:4.9": "Ākāsānañcāyatanaṃ catuvokārabhavo ti? ",
  "kv6.4:4.10": "Āmantā. ",
  "kv6.4:4.11": "Asaṃkhataṃ catuvokārabhavo ti? ",
  "kv6.4:4.12": "Na h' evaṃ vattabbe --pe-- 4. ",
  "kv6.4:5.1": "Na vattabbaṃ ",
  "kv6.4:5.2": "\"Cattāro āruppā asaṃkhatā ti\"? ",
  "kv6.4:5.3": "Āmantā. ",
  "kv6.4:5.4": "Nanu cattāro āruppā anejā vuttā Bhagavatā ti? ",
  "kv6.4:5.5": "Āmantā. ",
  "kv6.4:5.6": "Hañci cattāro āruppā anejā vuttā Bhagavatā, tena vata re vattabbe ",
  "kv6.4:5.7": "\"Cattāro āruppā asaṃkhatā ti.\" ",
  "kv6.4:5.8": "Āruppakathā. 1. "
}
