  "kv6.2:0.3": "",
  "kv6.2:0.4": "",
  "kv6.2:1.1": "Paṭiccasamuppādo asaṃkhato ti? ",
  "kv6.2:1.2": "Āmantā. ",
  "kv6.2:1.3": "Nibbānaṃ tāṇaṃ leṇaṃ saraṇaṃ parāyanaṃ accutaṃ amatan ti? ",
  "kv6.2:1.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv6.2:1.5": "Paṭiccasamuppādo asaṃkhato, nibbānaṃ asaṃkhatan ti? ",
  "kv6.2:1.6": "Āmantā. ",
  "kv6.2:1.7": "Dve asaṃkhatānīti? ",
  "kv6.2:1.8": "Na h' evaṃ vattabbe --pe-- ",
  "kv6.2:1.9": "Dve asaṃkhatānīti? ",
  "kv6.2:1.10": "Āmantā. ",
  "kv6.2:1.11": "Dve tāṇāni, dve leṇāni, dve saraṇāni, dve parāyanāni, dve accutāni, dve amatāni, dve nibbānānīti? ",
  "kv6.2:1.12": "Na h' evaṃ vattabbe --pe-- ",
  "kv6.2:1.13": "Dve nibbānānīti? ",
  "kv6.2:1.14": "Āmantā. ",
  "kv6.2:1.15": "Atthi dvinnaṃ nibbānānaṃ uccanīcatā, hīnappaṇītatā, ukkaṃsāvakaṃso, sīmā vā bhedo vā rājī vā antarīkā vā ti? ",
  "kv6.2:1.16": "Na h' evaṃ vattabbe --pe-- 2. ",
  "kv6.2:2.1": "Paṭiccasamuppādo asaṃkhato ti? ",
  "kv6.2:2.2": "Āmantā. ",
  "kv6.2:2.3": "Avijjā asaṃkhatā ti? ",
  "kv6.2:2.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv6.2:2.5": "Avijjā saṃkhatā ti? ",
  "kv6.2:2.6": "Āmantā. ",
  "kv6.2:2.7": "Paṭiccasamuppādo saṃkhato ti? ",
  "kv6.2:2.8": "Na h' evaṃ vattabbe --pe-- ",
  "kv6.2:2.9": "Paṭiccasamuppādo asaṃkhato ti? ",
  "kv6.2:2.10": "Āmantā. ",
  "kv6.2:2.11": "Avijjāpaccayā saṃkhārā asaṃkhatā ti? ",
  "kv6.2:2.12": "Na h' evaṃ vattabbe --pe-- ",
  "kv6.2:2.13": "Avijjāpaccayā saṃkhārā saṃkhatā ti? ",
  "kv6.2:2.14": "Āmantā. ",
  "kv6.2:2.15": "Paṭiccasamuppādo saṃkhato ti? ",
  "kv6.2:2.16": "Na h' evaṃ vattabbe --pe-- 3. ",
  "kv6.2:2.17": "Paṭiccasamuppādo asaṃkhato ti? ",
  "kv6.2:2.18": "Āmantā. ",
  "kv6.2:2.19": "Saṃkhārapaccayā viññāṇaṃ asaṃkhatan ti? ",
  "kv6.2:2.20": "Na h' evaṃ vattabbe --pe-- ",
  "kv6.2:2.21": "Saṃkhārapaccayā viññāṇaṃ saṃkhatan ti? ",
  "kv6.2:2.22": "Āmantā. ",
  "kv6.2:2.23": "Paṭiccasamuppādo saṃkhato ti? ",
  "kv6.2:2.24": "Na h' evaṃ vattabbe --pe-- ",
  "kv6.2:2.25": "Paṭiccasamuppādo asaṃkhato ti? ",
  "kv6.2:2.26": "Āmantā. ",
  "kv6.2:2.27": "Viññāṇapaccayā nāmarūpaṃ asaṃkhatan ti? ",
  "kv6.2:2.28": "Na h' evaṃ vattabbe --pe-- ",
  "kv6.2:2.29": "Viññāṇapaccayā nāmarūpaṃ saṃkhatan ti? ",
  "kv6.2:2.30": "Āmantā. ",
  "kv6.2:2.31": "Paṭiccasamuppādo saṃkhato ti? ",
  "kv6.2:2.32": "Na h' evaṃ vattabbe --pe-- ",
  "kv6.2:2.33": "paṭiccasamuppādo asaṃkhato ti? ",
  "kv6.2:2.34": "Āmantā. ",
  "kv6.2:2.35": "Jātipaccayā jarāmaraṇaṃ asaṃkhatan ti? ",
  "kv6.2:2.36": "Na h' evaṃ vattabbe --pe-- ",
  "kv6.2:2.37": "Jātipaccayā jarāmaraṇaṃ saṃkhatan ti? ",
  "kv6.2:2.38": "Āmantā. ",
  "kv6.2:2.39": "Paṭiccasamuppādo saṃkhato ti? ",
  "kv6.2:2.40": "Na h' evaṃ vattabbe --pe-- 4. ",
  "kv6.2:3.1": "Na vattabbaṃ ",
  "kv6.2:3.2": "\"Paṭiccasamuppādo asaṃkhato ti\"? ",
  "kv6.2:3.3": "Āmantā. ",
  "kv6.2:3.4": "Nanu vuttaṃ Bhagavatā -- ",
  "kv6.2:3.5": "\"Jātipaccayā Bhikkhave jarāmaraṇaṃ, ",
  "kv6.2:3.6": "uppādā vā Tathāgatānaṃ anuppādā vā Tathāgatānaṃ ṭhitā 'va sā dhātu dhammaṭṭhitatā dhammaniyāmatā idappaccayatā; ",
  "kv6.2:3.7": "taṃ Tathāgato abhisambujjhati, abhisameti; ",
  "kv6.2:3.8": "abhisambujjhitvā abhisametvā ācikkhati deseti, paññāpeti paṭṭhapeti, vivarati vibhajati uttānīkaroti; ",
  "kv6.2:3.9": "passathāti c' āha ",
  "kv6.2:3.10": "jātipaccayā Bhikkhave jarāmaraṇaṃ, ",
  "kv6.2:3.11": "bhavapaccayā Bhikkhave jāti --pe-- ",
  "kv6.2:3.12": "avijjāpaccayā Bhikkhave saṃkhārā ",
  "kv6.2:3.13": "uppādā vā Tathāgatānaṃ anuppādā vā Tathāgatānaṃ ṭhitā 'va sā dhātu --pe-- ",
  "kv6.2:3.14": "passathāti c' āha ",
  "kv6.2:3.15": "avijjāpaccayā Bhikkhave saṃkhārā, ",
  "kv6.2:3.16": "iti kho Bhikkhave yā tatra tathatā avitathatā anaññathatā idappaccayatā, ",
  "kv6.2:3.17": "ayaṃ vuccati Bhikkhave paṭiccasamuppādo ti.\" ",
  "kv6.2:3.18": "Atth' eva suttanto ti? ",
  "kv6.2:3.19": "Āmantā. ",
  "kv6.2:3.20": "Tena hi paṭiccasamuppādo asaṃkhato ti. 5. ",
  "kv6.2:4.1": "\"Avijjāpaccayā saṃkhārā ti\" yā tattha dhammaṭṭhitatā dhammaniyāmatā asaṃkhatā, nibbānaṃ asaṃkhatan ti? ",
  "kv6.2:4.2": "Āmantā. ",
  "kv6.2:4.3": "Dve asaṃkhatānīti? ",
  "kv6.2:4.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv6.2:4.5": "Dve asaṃkhatānīti? ",
  "kv6.2:4.6": "Āmantā. ",
  "kv6.2:4.7": "Dve tāṇāni --pe-- ",
  "kv6.2:4.8": "antarīkā vā ti? ",
  "kv6.2:4.9": "Na h' evaṃ vattabbe --pe-- 6. ",
  "kv6.2:5.1": "\"Avijjāpaccayā saṃkhārā ti\" yā tattha dhammaṭṭhitatā dhammaniyāmatā asaṃkhatā, \"saṃkhārapaccayā viññāṇan ti\" yā tattha dhammaṭṭhitatā dhammaniyāmatā asaṃkhatā, nibbānaṃ asaṃkhatan ",
  "kv6.2:5.2": "",
  "kv6.2:5.3": "ti? ",
  "kv6.2:5.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv6.2:5.5": "Tīṇi asaṃkhatānīti? Na h' evaṃ vattabbe --pe-- Tīṇi asaṃkhatānīti? ",
  "kv6.2:5.6": "Āmantā. ",
  "kv6.2:5.7": "Tīṇi tāṇāni --pe-- ",
  "kv6.2:5.8": "antarīkā vā ti? ",
  "kv6.2:5.9": "Na h' evaṃ vattabbe --pe-- 7. ",
  "kv6.2:6.1": "\"Avijjāpaccayā saṃkhārā ti\" yā tattha dhammaṭṭhitatā dhammaniyāmatā asaṃkhatā, \"saṃkhārapaccayā viññāṇan ti\" yā tattha dhammaṭṭhitatā dhammaniyāmatā asaṃkhatā --pe--, ",
  "kv6.2:6.2": "\"jātipaccayā jarāmaraṇan ti\" yā tattha dhammaṭṭhitatā dhammaniyāmatā asaṃkhatā, nibbānaṃ asaṃkhatan ti? ",
  "kv6.2:6.3": "Āmantā. ",
  "kv6.2:6.4": "Dvādasa asaṃkhatānīti? ",
  "kv6.2:6.5": "Na h' evaṃ vattabbe --pe-- ",
  "kv6.2:6.6": "Dvādasa asaṃkhatānīti? ",
  "kv6.2:6.7": "Āmantā. ",
  "kv6.2:6.8": "Dvādasa tāṇāni --pe-- dvādasa leṇāni --pe-- ",
  "kv6.2:6.9": "antarīkā vā ti? ",
  "kv6.2:6.10": "Na h' evaṃ vattabbe --pe-- ",
  "kv6.2:6.11": "Paṭiccasamuppādakathā. 1. "
}
