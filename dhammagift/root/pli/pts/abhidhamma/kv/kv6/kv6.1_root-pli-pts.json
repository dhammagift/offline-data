  "kv6.1:0.3": "",
  "kv6.1:0.4": "",
  "kv6.1:1.1": "Niyāmo asaṃkhato ti? ",
  "kv6.1:1.2": "Āmantā. ",
  "kv6.1:1.3": "Nibbānaṃ tāṇaṃ leṇaṃ saraṇaṃ parāyanaṃ accutaṃ amatan ti? ",
  "kv6.1:1.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv6.1:2.1": "Niyāmo asaṃkhato, nibbānaṃ asaṃkhatan ti? ",
  "kv6.1:2.2": "Āmantā. ",
  "kv6.1:2.3": "Dve asaṃkhatānīti? ",
  "kv6.1:2.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv6.1:3.1": "Dve asaṃkhatānīti? ",
  "kv6.1:3.2": "Āmantā. ",
  "kv6.1:3.3": "Dve tāṇāni, dve leṇāni, dve saraṇāni, dve parāyanāni, dve accutāni, dve amatāni, dve nibbānānīti? ",
  "kv6.1:3.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv6.1:4.1": "Dve nibbānānīti? ",
  "kv6.1:4.2": "Āmantā. ",
  "kv6.1:4.3": "Atthi dvinnaṃ nibbānānaṃ uccanīcatā, hīnappaṇītatā, ukkaṃsāvakaṃso, sīmā vā bhedo vā rājī vā antarīkā vā ti? ",
  "kv6.1:4.4": "Na h' evaṃ vattabbe --pe-- 2. ",
  "kv6.1:5.1": "Niyāmo asaṃkhato ti? ",
  "kv6.1:5.2": "Āmantā. ",
  "kv6.1:5.3": "Atthi keci niyāmaṃ okkamanti paṭilabhanti, uppādenti samuppādenti, uṭṭhāpenti samuṭṭhāpenti, nibbattenti abhinibbattenti, janenti sañjanentīti? ",
  "kv6.1:5.4": "Āmantā. ",
  "kv6.1:5.5": "Atthi keci asaṃkhataṃ okkamanti paṭilabhanti, uppādenti samuppādenti, uṭṭhāpenti samuṭṭhāpenti, nibbattenti abhinibbattenti, janenti sañjanentīti? ",
  "kv6.1:5.6": "Na h' evaṃ vattabbe --pe-- 3. ",
  "kv6.1:6.1": "Niyāmo asaṃkhato ti? ",
  "kv6.1:6.2": "Āmantā. ",
  "kv6.1:6.3": "Maggo asaṃkhato ti? ",
  "kv6.1:6.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv6.1:7.1": "Maggo saṃkhato ti? ",
  "kv6.1:7.2": "Āmantā. ",
  "kv6.1:7.3": "Niyāmo saṃkhato ti? ",
  "kv6.1:7.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv6.1:8.1": "Sotāpattiniyāmo asaṃkhato ti? ",
  "kv6.1:8.2": "Āmantā. ",
  "kv6.1:8.3": "Sotāpattimaggo asaṃkhato ti? ",
  "kv6.1:8.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv6.1:9.1": "Sotāpattimaggo saṃkhato ti? ",
  "kv6.1:9.2": "Āmantā. ",
  "kv6.1:9.3": "Sotāpattiniyāmo saṃkhato ti? ",
  "kv6.1:9.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv6.1:10.1": "Sakadāgāminiyāmo --pe-- ",
  "kv6.1:10.2": "anāgāminiyāmo --pe-- ",
  "kv6.1:10.3": "arahattaniyāmo asaṃkhato ti? ",
  "kv6.1:10.4": "Āmantā. ",
  "kv6.1:10.5": "Arahattamaggo asaṃkhato ti? ",
  "kv6.1:10.6": "Na h' evaṃ vattabbe --pe-- ",
  "kv6.1:10.7": "Arahattamaggo saṃkhato ti? ",
  "kv6.1:10.8": "Āmantā. ",
  "kv6.1:10.9": "Arahattaniyāmo saṃkhato ti? ",
  "kv6.1:10.10": "Na h' evaṃ vattabbe --pe-- 4. ",
  "kv6.1:11.1": "Sotāpattiniyāmo asaṃkhato --pe-- ",
  "kv6.1:11.2": "arahattaniyāmo asaṃkhato, nibbānaṃ asaṃkhatan ti? ",
  "kv6.1:11.3": "Āmantā. ",
  "kv6.1:11.4": "Pañca asaṃkhatānīti? ",
  "kv6.1:11.5": "Na h' evaṃ vattabbe --pe-- ",
  "kv6.1:11.6": "Pañca asaṃkhatānīti? ",
  "kv6.1:11.7": "Āmantā. ",
  "kv6.1:11.8": "Pañca tāṇāni --pe-- ",
  "kv6.1:11.9": "antarīkā vā ti? ",
  "kv6.1:11.10": "Na h' evaṃ vattabbe --pe-- 5. ",
  "kv6.1:12.1": "Niyāmo asaṃkhato ti? ",
  "kv6.1:12.2": "Āmantā. ",
  "kv6.1:12.3": "Micchattaniyāmo asaṃkhato ti? ",
  "kv6.1:12.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv6.1:12.5": "Micchattaniyāmo saṃkhato ti? ",
  "kv6.1:12.6": "Āmantā. ",
  "kv6.1:12.7": "Sammattaniyāmo saṃkhato ti? ",
  "kv6.1:12.8": "Na h' evaṃ vattabbe --pe-- 6. ",
  "kv6.1:13.1": "Na vattabbaṃ ",
  "kv6.1:13.2": "\"Niyāmo asaṃkhato ti\"? ",
  "kv6.1:13.3": "Āmantā. ",
  "kv6.1:13.4": "Niyāme uppajja niruddhe aniyato hotīti? ",
  "kv6.1:13.5": "Na h' evaṃ vattabbe --pe-- ",
  "kv6.1:13.6": "Tena hi niyāmo asaṃkhato ti. ",
  "kv6.1:13.7": "Micchattaniyāme uppajja niruddhe aniyato hotīti? ",
  "kv6.1:13.8": "Na h' evaṃ vattabbe --pe-- ",
  "kv6.1:13.9": "Tena hi micchattaniyāmo asaṃkhato ti. ",
  "kv6.1:13.10": "Niyāmakathā. 1. "
}
