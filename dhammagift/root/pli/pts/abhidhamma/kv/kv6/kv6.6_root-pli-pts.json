  "kv6.6:0.1": "",
  "kv6.6:0.2": "",
  "kv6.6:0.3": "",
  "kv6.6:0.4": "",
  "kv6.6:1.1": "Ākāso asaṃkhato ti? ",
  "kv6.6:1.2": "Āmantā. ",
  "kv6.6:1.3": "Nibbānaṃ tāṇaṃ leṇaṃ saraṇaṃ parāyanaṃ accutaṃ amatan ti? ",
  "kv6.6:1.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv6.6:1.5": "Ākāso asaṃkhato, nibbānaṃ asaṃkhatan ti? ",
  "kv6.6:1.6": "Āmantā. ",
  "kv6.6:1.7": "Dve asaṃkhatānīti? ",
  "kv6.6:1.8": "Na h' evaṃ vattabbe --pe-- ",
  "kv6.6:1.9": "Dve asaṃkhatānīti? ",
  "kv6.6:1.10": "Āmantā. ",
  "kv6.6:1.11": "Dve tāṇāni --pe-- antarīkā vā ti? ",
  "kv6.6:1.12": "Na h' evaṃ vattabbe --pe-- 2. ",
  "kv6.6:2.1": "Ākāso asaṃkhato ti? ",
  "kv6.6:2.2": "Āmantā. ",
  "kv6.6:2.3": "Atthi keci anākāsaṃ ākāsaṃ karontīti? ",
  "kv6.6:2.4": "Āmantā. ",
  "kv6.6:2.5": "Atthi keci saṃkhataṃ asaṃkhataṃ karontīti? ",
  "kv6.6:2.6": "Na h' evaṃ vattabbe --pe-- ",
  "kv6.6:2.7": "Atthi keci ākāsaṃ anākāsaṃ karontīti? ",
  "kv6.6:2.8": "Āmantā. ",
  "kv6.6:2.9": "Atthi keci asaṃkhataṃ saṃkhataṃ karontīti? ",
  "kv6.6:2.10": "Na h' evaṃ vattabbe --pe-- 3. ",
  "kv6.6:3.1": "Ākāse pakkhiyo gacchanti, candhimasuriyā gacchanti, tārakarūpāni gacchanti, iddhiṃ vikubbanti, bāhuṃ cālenti, pāṇiṃ cālenti, leḍḍum khipanti, laguḷaṃ khipanti, iddhiṃ khipanti, usuṃ khipantīti? ",
  "kv6.6:3.2": "Āmantā. ",
  "kv6.6:3.3": "Asaṃkhate pakkhiyo gacchanti, candhimasuriyā gacchanti, tārakarūpāni gacchanti, iddhiṃ vikubbanti, bāhuṃ cālenti, pāṇiṃ cālenti, leḍḍum khipanti, laguḷaṃ khipanti, iddhiṃ khipanti, usuṃ khipanīti? ",
  "kv6.6:3.4": "Na h' evaṃ vattabbe --pe-- 4. ",
  "kv6.6:4.1": "Ākāsaṃ parivāretvā gharāni karonti, koṭṭhāni karontīti? ",
  "kv6.6:4.2": "Āmantā. ",
  "kv6.6:4.3": "Asaṃkhataṃ parivāretvā gharāni karonti, koṭṭhāni karontīti? ",
  "kv6.6:4.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv6.6:5.1": "Udapāne khaññamāne anākāso ākāso hotīti? ",
  "kv6.6:5.2": "Āmantā. ",
  "kv6.6:5.3": "Saṃkhataṃ asaṃkhataṃ hotīti? ",
  "kv6.6:5.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv6.6:6.1": "Tuccha-udapāne pūriyamāne, tucchakoṭṭhe pūriyamāne, tucchakumbhiyā pūriyamānāya, ākāso antaradhāyatīti? ",
  "kv6.6:6.2": "Āmantā. ",
  "kv6.6:6.3": "Asaṃkhataṃ antaradhāyatīti? ",
  "kv6.6:6.4": "Na h' evaṃ vattabbe --pe-- 5. ",
  "kv6.6:7.1": "Na vattabbaṃ ",
  "kv6.6:7.2": "\"Ākāso asaṃkhato ti\"? ",
  "kv6.6:7.3": "Āmantā. ",
  "kv6.6:7.4": "Ākāso saṃkhato ti? ",
  "kv6.6:7.5": "Na h' evaṃ vattabbe --pe-- ",
  "kv6.6:7.6": "Tena hi ākāso asaṃkhato ti. ",
  "kv6.6:7.7": "Ākāsakathā. 1. "
}
