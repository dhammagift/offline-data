  "kv6.3:0.3": "",
  "kv6.3:0.4": "",
  "kv6.3:1.1": "Cattāri saccāni asaṃkhatānīti? ",
  "kv6.3:1.2": "Āmantā. ",
  "kv6.3:1.3": "Cattāri tāṇāni, cattāri leṇāni, cattāri saraṇāni, cattāri parāyanāni, cattāri accutāni, cattāri amatāni, cattāri nibbānānīti? ",
  "kv6.3:1.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv6.3:1.5": "Cattāri nibbānānīti? ",
  "kv6.3:1.6": "Āmantā. ",
  "kv6.3:1.7": "Atthi catunnaṃ nibbānānaṃ uccanīcatā, hīnappaṇītatā, ukkaṃsāvakaṃso, sīmā vā bhedo vā rājī vā antarīkā vā ti? ",
  "kv6.3:1.8": "Na h' evaṃ vattabbe --pe-- 2. ",
  "kv6.3:2.1": "Dukkhasaccaṃ asaṃkhatan ti? ",
  "kv6.3:2.2": "Āmantā. ",
  "kv6.3:2.3": "Dukkhaṃ asaṃkhatan ti? ",
  "kv6.3:2.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv6.3:2.5": "Dukkhasaccaṃ asaṃkhatan ti? ",
  "kv6.3:2.6": "Āmantā. ",
  "kv6.3:2.7": "Kāyikaṃ dukkhaṃ, cetasikaṃ dukkhaṃ, sokaparidevadukkhadomanassūpāyāsā asaṃkhatā ti? ",
  "kv6.3:2.8": "Na h' evaṃ vattabbe --pe-- ",
  "kv6.3:2.9": "Samudayasaccaṃ asaṃkhatan ti? ",
  "kv6.3:2.10": "Āmantā. ",
  "kv6.3:2.11": "Samudayo asaṃkhato ti? ",
  "kv6.3:2.12": "Na h' evaṃ vattabbe --pe-- ",
  "kv6.3:2.13": "Samudayasaccaṃ asaṃkhatan ti? ",
  "kv6.3:2.14": "Āmantā. ",
  "kv6.3:2.15": "Kāmataṇhā bhavataṇhā vibhavataṇhā asaṃkhatā ti? ",
  "kv6.3:2.16": "Na h' evaṃ vattabbe --pe-- ",
  "kv6.3:2.17": "Maggasaccaṃ asaṃkhatan ti? ",
  "kv6.3:2.18": "Āmantā. ",
  "kv6.3:2.19": "Maggo asaṃkhato ti? ",
  "kv6.3:2.20": "Na h' evaṃ vattabbe --pe-- ",
  "kv6.3:2.21": "Maggasaccaṃ asaṃkhatan ti? ",
  "kv6.3:2.22": "Āmantā. ",
  "kv6.3:2.23": "Sammādiṭṭhi --pe-- sammāsamādhi asaṃkhato ti? ",
  "kv6.3:2.24": "Na h' evaṃ vattabbe --pe-- 3. ",
  "kv6.3:3.1": "Dukkhaṃ saṃkhatan ti? ",
  "kv6.3:3.2": "Āmantā. ",
  "kv6.3:3.3": "Dukkhasaccaṃ saṃkhatan ti? ",
  "kv6.3:3.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv6.3:3.5": "Kāyikaṃ dukkhaṃ, cetasikaṃ dukkhaṃ, sokaparidevadukkhadomanassūpāyāsā saṃkhatā ti? ",
  "kv6.3:3.6": "Āmantā. ",
  "kv6.3:3.7": "Dukkhasaccaṃ asaṃkhatan ti? ",
  "kv6.3:3.8": "Na h' evaṃ vattabbe --pe-- ",
  "kv6.3:3.9": "Samudayo saṃkhato ti? ",
  "kv6.3:3.10": "Āmantā. ",
  "kv6.3:3.11": "Samudayasaccaṃ saṃkhatan ti? ",
  "kv6.3:3.12": "Na h' evaṃ vattabbe --pe-- ",
  "kv6.3:3.13": "Kāmataṇhā bhavataṇhā vibhavataṇhā saṃkhatā ti? ",
  "kv6.3:3.14": "Āmantā. ",
  "kv6.3:3.15": "Samudayasaccaṃ saṃkhatan ti? ",
  "kv6.3:3.16": "Na h' evaṃ vattabbe --pe-- ",
  "kv6.3:3.17": "Maggo saṃkhato ti? ",
  "kv6.3:3.18": "Āmantā. ",
  "kv6.3:3.19": "Maggasaccaṃ saṃkhatan ti? ",
  "kv6.3:3.20": "Na h' evaṃ vattabbe --pe-- ",
  "kv6.3:3.21": "Sammādiṭṭhi --pe-- sammāsamādhi saṃkhato ti? ",
  "kv6.3:3.22": "Āmantā. ",
  "kv6.3:3.23": "Maggasaccaṃ saṃkhatan ti? ",
  "kv6.3:3.24": "Na h' evaṃ vattabbe --pe-- 4. ",
  "kv6.3:4.1": "Nirodhasaccaṃ asaṃkhataṃ, nirodho asaṃkhato ti? ",
  "kv6.3:4.2": "Āmantā. ",
  "kv6.3:4.3": "Dukkhasaccaṃ asaṃkhataṃ, dukkhaṃ asaṃkhatan ti? ",
  "kv6.3:4.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv6.3:4.5": "Nirodhasaccaṃ asaṃkhataṃ, nirodho asaṃkhato ti? ",
  "kv6.3:4.6": "Āmantā. ",
  "kv6.3:4.7": "Samudayasaccaṃ asaṃkhataṃ, samudayo asaṃkhato ti? ",
  "kv6.3:4.8": "Na h' evaṃ vattabbe --pe-- ",
  "kv6.3:4.9": "Nirodhasaccaṃ asaṃkhataṃ, nirodho asaṃkhato ti? ",
  "kv6.3:4.10": "Āmantā. ",
  "kv6.3:4.11": "Maggasaccaṃ asaṃkhataṃ, maggo asaṃkhato ti? ",
  "kv6.3:4.12": "Na h' evaṃ vattabbe --pe-- 5. ",
  "kv6.3:5.1": "Dukkhasaccaṃ asaṃkhataṃ, dukkhaṃ saṃkhatan ti? ",
  "kv6.3:5.2": "Āmantā. ",
  "kv6.3:5.3": "Nirodhasaccaṃ asaṃkhataṃ, nirodho saṃkhato ti? ",
  "kv6.3:5.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv6.3:5.5": "Samudayasaccaṃ asaṃkhataṃ, samudayo saṃkhato ti? ",
  "kv6.3:5.6": "Āmantā. ",
  "kv6.3:5.7": "Nirodhasaccaṃ asaṃkhataṃ, nirodho saṃkhato ti? ",
  "kv6.3:5.8": "Na h' evaṃ vattabbe --pe-- ",
  "kv6.3:5.9": "Maggasaccaṃ asaṃkhataṃ, maggo saṃkhato ti? ",
  "kv6.3:5.10": "Āmantā. ",
  "kv6.3:5.11": "Nirodhasaccaṃ asaṃkhataṃ nirodho saṃkhato ti? ",
  "kv6.3:5.12": "Na h' evaṃ vattabbe --pe-- 6. ",
  "kv6.3:6.1": "Na vattabaṃ ",
  "kv6.3:6.2": "\"Cattāri saccāni asaṃkhatānīti\"? ",
  "kv6.3:6.3": "Āmantā. ",
  "kv6.3:6.4": "Nanu vuttaṃ Bhagavatā -- ",
  "kv6.3:6.5": "\"Cattār' imāni Bhikkhave tathāni avitathāni anaññathāni. ",
  "kv6.3:6.6": "Katamāni cattāri? ",
  "kv6.3:6.7": "Idaṃ dukkhan ti Bhikkhave tathaṃ etaṃ avitathaṃ etaṃ anaññathaṃ etaṃ --pe-- ",
  "kv6.3:6.8": "ayaṃ dukkhasamudayo ti --pe-- ",
  "kv6.3:6.9": "ayaṃ dukkhanirodho ti --pe-- ",
  "kv6.3:6.10": "ayaṃ dukkhanirodhagāminī paṭipadā ti tathaṃ etaṃ avitathaṃ etaṃ anaññathaṃ etaṃ: ",
  "kv6.3:6.11": "imāni kho Bhikkhave cattāri tathāni avitathāni anaññathānīti.\" ",
  "kv6.3:6.12": "Atth' eva suttanto ti? ",
  "kv6.3:6.13": "Āmantā. ",
  "kv6.3:6.14": "Tena hi cattāri saccāni asaṃkhatānīti. ",
  "kv6.3:6.15": "Saccakathā. 1. "
}
