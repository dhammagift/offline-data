{
  "kv3.12:0.1": "",
  "kv3.12:0.2": "",
  "kv3.12:0.3": "",
  "kv3.12:0.4": "",
  "kv3.12:1.1": "Nevasaññānāsaññāyatane na vattabbaṃ ",
  "kv3.12:1.2": "\"Saññā atthīti\"? ",
  "kv3.12:1.3": "Āmantā. ",
  "kv3.12:1.4": "Asaññabhavo asaññagati asaññasattāvāso asaññasaṃsāro asaññayoni asaññattabhāvapaṭilābho ti? ",
  "kv3.12:1.5": "",
  "kv3.12:2.1": "",
  "kv3.12:2.2": "Āmantā. ",
  "kv3.12:2.3": "Hañci asaññabhavo asaññagati --pe-- ",
  "kv3.12:2.4": "asaññattabhāvapaṭilābho, no vata re vattabbe ",
  "kv3.12:2.5": "Nevasaññānāsaññāyatane na vattabbaṃ ",
  "kv3.12:2.6": "‘Saññā atthīti.\"' 2. ",
  "kv3.12:3.1": "Nevasaññānāsaññāyatane na vattabbaṃ ",
  "kv3.12:3.2": "\"Saññā atthīti\"? ",
  "kv3.12:3.3": "Āmantā. ",
  "kv3.12:3.4": "Ekavokārabhavo gati --pe-- ",
  "kv3.12:3.5": "attabhāvapaṭilābho ti? ",
  "kv3.12:3.6": "Na h' evaṃ vattabbe --pe-- ",
  "kv3.12:4.1": "Nanu catuvokārabhavo gati --pe-- ",
  "kv3.12:4.2": "attabhāvapaṭilābho ti? ",
  "kv3.12:4.3": "Āmantā. ",
  "kv3.12:4.4": "Hañci catuvokārabhavo gati --pe-- ",
  "kv3.12:4.5": "attabhāvapaṭilābho, no vata re vattabbe ",
  "kv3.12:4.6": "\"Nevasaññānāsaññāyatane na vattabbaṃ ",
  "kv3.12:4.7": "‘Saññā atthīti. \"' 3. ",
  "kv3.12:5.1": "Asaññasattesu na vattabbaṃ ",
  "kv3.12:5.2": "\"Saññā atthi,\" so ca asaññabhavo asaññagati asaññasattāvāso asaññasaṃsāro asaññayoni asaññattabhāvapaṭilābho ti? ",
  "kv3.12:5.3": "Āmantā. ",
  "kv3.12:5.4": "Nevasaññānāsaññāyatane na vattabbaṃ ",
  "kv3.12:5.5": "\"Saññā atthi,\" so ca asaññabhavo asaññagati asaññasattāvāso asaññasaṃsāro asaññayoni asaññattabhāvapaṭilābho ti? ",
  "kv3.12:5.6": "Na h' evaṃ vattabbe --pe-- ",
  "kv3.12:6.1": "Asaññasattesu na vattabbaṃ ",
  "kv3.12:6.2": "\"Saññā atthi,\" so ca ekavokārabhavo gati --pe-- ",
  "kv3.12:6.3": "attabhāvapaṭilābho ti? ",
  "kv3.12:6.4": "Āmantā. ",
  "kv3.12:6.5": "Nevasaññānāsaññāyatane na vattabbaṃ ",
  "kv3.12:6.6": "\"Saññā atthi,\" so ca ekavokārabhavo gati --pe-- attabhāvapaṭilābho ti? ",
  "kv3.12:6.7": "Na h' evaṃ vattabbe --pe-- 4. ",
  "kv3.12:7.1": "Nevasaññānāsaññāyatane na vattabbaṃ ",
  "kv3.12:7.2": "\"Saññā atthi,\" so ca saññabhavo saññagati --pe-- ",
  "kv3.12:7.3": "saññattabhāvapaṭilābho ti? ",
  "kv3.12:7.4": "Āmantā. ",
  "kv3.12:7.5": "Asaññasattesu na vattabbaṃ ",
  "kv3.12:7.6": "\"Saññā atthi,\" so ca saññabhavo saññagati --pe-- ",
  "kv3.12:7.7": "saññattabhāvapaṭilābho ti? ",
  "kv3.12:7.8": "Na h' evaṃ vattabbe --pe-- ",
  "kv3.12:8.1": "Nevasaññānāsaññāyatane na vattabbaṃ ",
  "kv3.12:8.2": "\"Saññā atthi,\" so ca catuvokārabhavo gati --pe-- ",
  "kv3.12:8.3": "attabhāvapaṭilābho ti? ",
  "kv3.12:8.4": "Āmantā. ",
  "kv3.12:8.5": "Asaññasattesu na vattabbaṃ ",
  "kv3.12:8.6": "\"Saññā atthi,\" so ca catuvokārabhavo gati --pe-- ",
  "kv3.12:8.7": "attabhāvapaṭilābho ti? ",
  "kv3.12:8.8": "Na h' evaṃ vattabbe --pe-- 5. ",
  "kv3.12:9.1": "Nevasaññānāsaññāyatane na vattabbaṃ ",
  "kv3.12:9.2": "\"Saññā atthīti?\" ",
  "kv3.12:9.3": "Āmantā. ",
  "kv3.12:9.4": "Nanu nevasaññānāsaññāyatanaṃ catuvokārabhavo ti? ",
  "kv3.12:9.5": "Āmantā. ",
  "kv3.12:9.6": "Hañci nevasaññānāsaññāyatanaṃ catuvokārabhavo, no vata re vattabbe ",
  "kv3.12:9.7": "\"Nevasaññānāsaññāyatane na vattabbaṃ ",
  "kv3.12:9.8": "‘Saññā atthīti.\"' 6. ",
  "kv3.12:10.1": "Nevasaññānāsaññāyatanaṃ catuvokārabhavo, nevasaññānāsaññāyatane na vattabbaṃ ",
  "kv3.12:10.2": "\"Saññā atthīti? ",
  "kv3.12:10.3": "Āmantā. ",
  "kv3.12:10.4": "Ākāsānañcāyatanaṃ catuvokārabhavo, ākāsānañcāyatane na vattabbaṃ ",
  "kv3.12:10.5": "\"Saññā atthīti\"? ",
  "kv3.12:10.6": "Na h' evaṃ vattabbe --pe-- ",
  "kv3.12:11.1": "Nevasaññānāsaññāyatanaṃ catuvokārabhavo, nevasaññānāsaññāyatane na vattabbaṃ ",
  "kv3.12:11.2": "\"Saññā atthīti\"? ",
  "kv3.12:11.3": "Āmantā. ",
  "kv3.12:11.4": "viññāṇañcāyatanaṃ --pe-- ",
  "kv3.12:11.5": "ākiñcaññāyatanaṃ catuvokārabhavo, ākiñcaññāyatane na vattabbaṃ ",
  "kv3.12:11.6": "\"Saññā atthīti\"? ",
  "kv3.12:11.7": "Na h' evaṃ vattabbe --pe-- 7. ",
  "kv3.12:12.1": "Ākāsānañcāyatanaṃ catuvokārabhavo, atthi tattha saññā ti? ",
  "kv3.12:12.2": "Āmantā. ",
  "kv3.12:12.3": "Nevasaññānāsaññāyatanaṃ catuvokārabhavo, atthi tattha saññā ti? ",
  "kv3.12:12.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv3.12:13.1": "Viññāṇañcāyatanaṃ --pe-- ",
  "kv3.12:13.2": "ākiñcaññāyatanaṃ catuvokārabhavo, atthi tattha saññā ti? ",
  "kv3.12:13.3": "Āmantā. ",
  "kv3.12:13.4": "Nevasaññānāsaññāyatanaṃ catuvokārabhavo, atthi tattha saññā ti? ",
  "kv3.12:13.5": "Na h' evaṃ vattabbe --pe-- 8. ",
  "kv3.12:14.1": "Nevasaññānāsaññāyatane na vattabbaṃ ",
  "kv3.12:14.2": "\"Saññā atthīti vā n' atthīti vā ti\"? ",
  "kv3.12:14.3": "Āmantā. ",
  "kv3.12:14.4": "Nanu nevasaññānāsaññāyatanaṃ catuvokārabhavo ti? ",
  "kv3.12:14.5": "Āmantā. ",
  "kv3.12:14.6": "Hañci nevasaññānāsaññāyatanaṃ catuvokārabhavo, no vata re vattabbe ",
  "kv3.12:14.7": "\"Nevasaññānāsaññāyatane na vattabbaṃ ",
  "kv3.12:14.8": "‘Saññā atthīti vā n' atthīti vā ti.\"' 9. ",
  "kv3.12:15.1": "Nevasaññānāsaññāyatanaṃ catuvokārabhavo, nevasaññānāsaññāyatane na vattabbaṃ ",
  "kv3.12:15.2": "\"Saññā atthīti vā n' atthīti vā ti\"? ",
  "kv3.12:15.3": "Āmantā. ",
  "kv3.12:15.4": "Ākāsānañcāyatanaṃ --pe-- ",
  "kv3.12:15.5": "viññāṇañcāyatanaṃ --pe-- ",
  "kv3.12:15.6": "ākiñcaññāyatanaṃ catuvokārabhavo, ākiñcaññāyatane na vattabbaṃ ",
  "kv3.12:15.7": "\"Sañña atthīti vā n' atthīti vā ti.\" 10. ",
  "kv3.12:15.8": "",
  "kv3.12:16.1": "Ākāsānañcāyatanaṃ catuvokārabhavo, atthi tattha saññā ti? ",
  "kv3.12:16.2": "Āmantā. ",
  "kv3.12:16.3": "Nevasaññānāsaññāyatanaṃ catuvokārabhavo, atthi tattha saññā ti? ",
  "kv3.12:16.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv3.12:17.1": "Viññāṇañcāyatanaṃ --pe-- ",
  "kv3.12:17.2": "ākiñcaññāyatanaṃ catuvokārabhavo, atthi tattha saññā ti? ",
  "kv3.12:17.3": "Āmantā. ",
  "kv3.12:17.4": "Nevasaññānāsaññāyatanaṃ catuvokārabhavo, atthi tattha saññā ti? ",
  "kv3.12:17.5": "Na h' evaṃ vattabbe --pe-- 11. ",
  "kv3.12:18.1": "Nevasaññānāsaññāyatane na vattabbaṃ ",
  "kv3.12:18.2": "\"Saññā atthīti vā n' atthīti vā ti\"? ",
  "kv3.12:18.3": "Āmantā. ",
  "kv3.12:18.4": "Nanu nevasaññānāsaññāyatanan ti? ",
  "kv3.12:18.5": "Āmantā. ",
  "kv3.12:18.6": "Hañci nevasaññānāsaññāyatanaṃ, tena vata re vattabbe ",
  "kv3.12:18.7": "\"Nevasaññānāsaññāyatane na vattabbaṃ ",
  "kv3.12:18.8": "‘Saññā atthīti vā n' atthīti vā ti.\"' 12. ",
  "kv3.12:19.1": "Nevasaññānāsaññāyatanan ti katvā, nevasaññānāsaññāyatane na vattabbaṃ ",
  "kv3.12:19.2": "\"Saññā atthīti vā n' atthīti vā ti\"? ",
  "kv3.12:19.3": "Āmantā. ",
  "kv3.12:19.4": "Adukkhamasukhā vedanā ti katvā, adukkhamasukhāya vedanāya na vattabbaṃ ",
  "kv3.12:19.5": "\"Vedanā ti vā, avedanā ti vā ti\"? ",
  "kv3.12:19.6": "Na h' evaṃ vattabbe --pe-- ",
  "kv3.12:19.7": "Nevasaññānāsaññāyatanakathā. ",
  "kv3.12:19.8": "",
  "kv3.12:19.9": "",
  "kv3.12:20.1": "Balaṃ sādhāraṇaṃ, Ariyaṃ, ",
  "kv3.12:20.2": "Sārāgaṃ cittaṃ vimuccati, ",
  "kv3.12:20.3": "Vimuttaṃ vimuccamānaṃ, ",
  "kv3.12:20.4": "Atthi cittaṃ vimuccamānaṃ, ",
  "kv3.12:21.1": "Aṭṭhamakassa puggalassa ",
  "kv3.12:21.2": "diṭṭhipariyuṭṭhānaṃ pahīnaṃ, ",
  "kv3.12:21.3": "Aṭṭhamakassa puggalassa ",
  "kv3.12:21.4": "n' atthi pañcindriyāni, Cakkhuṃ, ",
  "kv3.12:22.1": "Sotaṃ dhammupatthaddhaṃ, ",
  "kv3.12:22.2": "Yathākammūpagatañāṇaṃ, ",
  "kv3.12:22.3": "Devesu saṃvaro, Asaññasattesu ",
  "kv3.12:22.4": "saññā, evameva bhavaggan ti. 1. "
}
