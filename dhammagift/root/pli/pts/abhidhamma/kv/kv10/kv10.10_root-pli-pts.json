  "kv10.10:0.4": "",
  "kv10.10:1.1": "Viññatti sīlan ti? ",
  "kv10.10:1.2": "Āmantā. ",
  "kv10.10:1.3": "Pāṇātipātā veramaṇīti? ",
  "kv10.10:1.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv10.10:1.5": "Adinnādānā veramaṇīti? ",
  "kv10.10:1.6": "Na h' evaṃ vattabbe --pe-- ",
  "kv10.10:1.7": "Kāmesu micchācārā veramaṇīti? ",
  "kv10.10:1.8": "Na h' evaṃ vattabbe --pe-- ",
  "kv10.10:1.9": "Musāvādā veramaṇīti? ",
  "kv10.10:1.10": "Na h' evaṃ vattabbe --pe-- ",
  "kv10.10:1.11": "Surāmerayamajjapamādaṭṭhānā veramaṇīti? ",
  "kv10.10:1.12": "Na h' evaṃ vattabbe --pe-- ",
  "kv10.10:2.1": "Abhivādanaṃ sīlaṃ, paccuṭṭhānaṃ sīlaṃ, añjalīkammaṃ sīlaṃ, sāmīcikammaṃ sīlaṃ, āsanābhihāro sīlaṃ, seyyābhihāro sīlaṃ, pādodakābhihāro sīlaṃ, pādakathaliyābhihāro sīlaṃ, nahāne piṭṭhiparikammaṃ sīlan ti? ",
  "kv10.10:2.2": "Āmantā. ",
  "kv10.10:2.3": "Pāṇātipātā veramaṇīti? ",
  "kv10.10:2.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv10.10:2.5": "Surāmerayamajjapamādaṭṭhānā veramaṇīti? ",
  "kv10.10:2.6": "Na h' evaṃ vattabbe --pe-- 2. ",
  "kv10.10:3.1": "Na vattabbaṃ ",
  "kv10.10:3.2": "Viññatti sīlan ti.\" ",
  "kv10.10:3.3": "",
  "kv10.10:3.4": "Dussīlyan ti? ",
  "kv10.10:3.5": "Na h' evaṃ vattabbe --pe-- ",
  "kv10.10:3.6": "Tena hi viññatti sīlan ti. ",
  "kv10.10:3.7": "Viññatti sīlan ti kathā. X.11. 1. "
}
