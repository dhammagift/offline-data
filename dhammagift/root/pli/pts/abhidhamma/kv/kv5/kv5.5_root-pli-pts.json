  "kv5.5:1.1": "Sabbaṃ ñāṇaṃ paṭisambhidā ti? ",
  "kv5.5:1.2": "Āmantā. ",
  "kv5.5:1.3": "Sammutiñāṇaṃ paṭisambhidā ti? ",
  "kv5.5:1.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv5.5:1.5": "Sammutiñāṇaṃ paṭisambhidā ti? ",
  "kv5.5:1.6": "Āmantā. ",
  "kv5.5:1.7": "Ye keci sammutiṃ jānanti, sabbe te paṭisambhidappattā ti? ",
  "kv5.5:1.8": "Na h' evaṃ vattabbe --pe-- ",
  "kv5.5:1.9": "Sabbaṃ ñāṇaṃ paṭisambhidā ti? ",
  "kv5.5:1.10": "Āmantā. ",
  "kv5.5:1.11": "Cetopariyāye ñāṇaṃ paṭisambhidā ti? ",
  "kv5.5:1.12": "Na h' evaṃ vattabbe --pe-- ",
  "kv5.5:1.13": "Cetopariyāye ñāṇaṃ paṭisambhidā ti? ",
  "kv5.5:1.14": "Āmantā. ",
  "kv5.5:1.15": "Ye keci paracittaṃ jānanti, sabbe te paṭisambhidappattā ti? ",
  "kv5.5:1.16": "Na h' evaṃ vattabbe --pe-- 2. ",
  "kv5.5:2.1": "Sabbaṃ ñāṇaṃ paṭisambhidā ti? ",
  "kv5.5:2.2": "Āmantā. ",
  "kv5.5:2.3": "Sabbā paññā paṭisambhidā ti? ",
  "kv5.5:2.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv5.5:2.5": "Sabbā paññā paṭisambhidā ti? ",
  "kv5.5:2.6": "Āmantā. ",
  "kv5.5:2.7": "Paṭhavīkasiṇasamāpattiṃ samāpannassa atthi paññā, sā paññā paṭisambhidā ti? ",
  "kv5.5:2.8": "Na h' evaṃ vattabbe --pe-- ",
  "kv5.5:2.9": "Āpokasiṇaṃ --pe-- ",
  "kv5.5:2.10": "tejokasiṇaṃ --pe-- ",
  "kv5.5:2.11": "vāyokasiṇaṃ -- pe -- ",
  "kv5.5:2.12": "nīlakasiṇaṃ --pe-- ",
  "kv5.5:2.13": "pītakasiṇaṃ --pe-- ",
  "kv5.5:2.14": "lohitakasiṇaṃ -- pe -- ",
  "kv5.5:2.15": "odātakasiṇaṃ --pe-- ",
  "kv5.5:2.16": "ākāsānañcāyatanaṃ --pe-- ",
  "kv5.5:2.17": "viññāṇañcāyatanaṃ --pe-- ",
  "kv5.5:2.18": "ākiñcaññāyatanaṃ --pe-- ",
  "kv5.5:2.19": "nevasaññānāsaññāyatanaṃ samāpannassa --pe-- ",
  "kv5.5:2.20": "dānaṃ dadantassa --pe-- ",
  "kv5.5:2.21": "cīvaraṃ dadantassa --pe-- ",
  "kv5.5:2.22": "piṇḍapātaṃ dadantassa --pe-- ",
  "kv5.5:2.23": "senāsanaṃ dadantassa --pe-- ",
  "kv5.5:2.24": "gilānapaccayabhesajjaparikkhāraṃ dadantassa atthi paññā, sā paññā paṭisambhidā ti? ",
  "kv5.5:2.25": "Na h' evaṃ vattabbe --pe-- 3. ",
  "kv5.5:3.1": "Na vattabbaṃ ",
  "kv5.5:3.2": "\"Sabbaṃ ñāṇaṃ paṭisambhidā ti\"? ",
  "kv5.5:3.3": "Āmantā. ",
  "kv5.5:3.4": "Atthi lokuttarā paññā, sā na paṭisambhidā ti? ",
  "kv5.5:3.5": "Na h' evaṃ vattabbe --pe-- ",
  "kv5.5:3.6": "Tena hi sabbaṃ ñāṇaṃ paṭisambhidā ti. ",
  "kv5.5:3.7": "Paṭisambhidakathā. V. 6. 1. "
}
