  "kv12.5:0.1": "",
  "kv12.5:0.2": "",
  "kv12.5:0.3": "",
  "kv12.5:0.4": "",
  "kv12.5:1.1": "Sattakkhattuparamo puggalo sattakkhattuparamatā niyato ti? ",
  "kv12.5:1.2": "Āmantā. ",
  "kv12.5:1.3": "Mātā jīvitā voropitā, ",
  "kv12.5:1.4": "pitā jīvitā voropito, ",
  "kv12.5:1.5": "Arahā jīvitā voropito, ",
  "kv12.5:1.6": "duṭṭhena cittena Tathāgatassa lohitaṃ uppāditaṃ, ",
  "kv12.5:1.7": "Saṃgho bhinno ti? ",
  "kv12.5:1.8": "Na h' evaṃ vattabbe --pe-- 2. ",
  "kv12.5:2.1": "Sattakkhattuparamo puggalo sattakkhattuparamatā niyato ti? ",
  "kv12.5:2.2": "Āmantā. ",
  "kv12.5:2.3": "Abhabbo antarā dhammaṃ abhisametun ti? ",
  "kv12.5:2.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv12.5:2.5": "Abhabbo antarā dhammaṃ abhisametun ti? ",
  "kv12.5:2.6": "Āmantā. ",
  "kv12.5:2.7": "Mātā jīvitā voropitā, ",
  "kv12.5:2.8": "pitā jīvitā voropito, ",
  "kv12.5:2.9": "Arahā jīvitā voropito, ",
  "kv12.5:2.10": "duṭṭhena cittena Tathāgatassa lohitaṃ uppāditaṃ, ",
  "kv12.5:2.11": "Saṃgho bhinno ti? ",
  "kv12.5:2.12": "Na h' evaṃ vattabbe --pe-- 3. ",
  "kv12.5:3.1": "Sattakkhattuparamo puggalo sattakkhattuparamatā niyato ti? ",
  "kv12.5:3.2": "Āmantā. ",
  "kv12.5:3.3": "Atthi so niyāmo, yena niyāmena sattakkhattuparamo puggalo sattakkhattuparamatā niyato ti? ",
  "kv12.5:3.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv12.5:3.5": "Atthi te satipaṭṭhānā, ",
  "kv12.5:3.6": "sammappadhānā, ",
  "kv12.5:3.7": "iddhipādā, ",
  "kv12.5:3.8": "indriyā, ",
  "kv12.5:3.9": "balā, ",
  "kv12.5:3.10": "bojjhaṅgā, yehi bojjhaṅgehi sattakkhattuparamo puggalo sattakkhattuparamatā niyato ti? ",
  "kv12.5:3.11": "Na h' evaṃ vattabbe --pe-- 4. ",
  "kv12.5:4.1": "N' atthi so niyāmo, yena niyamena sattakkhattuparamo puggalo sattakkhattuparamatā niyato ti? ",
  "kv12.5:4.2": "Āmantā. ",
  "kv12.5:4.3": "Hañci n' atthi so niyāmo, yena niyāmena sattakkhattuparamo puggalo sattakkhattuparamatā niyato, no vata re vattabbe ",
  "kv12.5:4.4": "\"Sattakkhattuparamo puggalo sattakkhattuparamatā niyato ti.\" ",
  "kv12.5:5.1": "N' atthi te satipaṭṭhānā --pe-- ",
  "kv12.5:5.2": "bojjhaṅgā, yehi bojjhaṅgehi sattakkhattuparamo puggalo sattakkhattuparamatā niyato ti? ",
  "kv12.5:5.3": "Āmantā. ",
  "kv12.5:5.4": "Hañci n' atthi te bojjhaṅgā, yehi bojjhaṅgehi sattakkhattuparamo puggalo sattakkhattuparamatā niyato, no vata re vattabbe ",
  "kv12.5:5.5": "\"Sattakkhattuparamo puggalo sattakkhattuparamatā niyato ti.\" 5. ",
  "kv12.5:6.1": "Sattakkhattuparamo puggalo sattakkhattuparamatā niyato ti? ",
  "kv12.5:6.2": "Āmantā. ",
  "kv12.5:6.3": "Sakadāgāminiyāmenāti? ",
  "kv12.5:6.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv12.5:6.5": "Anāgāminiyāmenāti? ",
  "kv12.5:6.6": "Na h' evaṃ vattabbe --pe-- ",
  "kv12.5:6.7": "Arahattaniyāmenāti? ",
  "kv12.5:6.8": "Na h' evaṃ vattabbe --pe-- ",
  "kv12.5:7.1": "Katamena niyāmenāti? ",
  "kv12.5:7.2": "Sotāpattiniyāmenāti. ",
  "kv12.5:7.3": "Sattakkhattuparamo puggalo sattakkhattuparamatā niyato ti? ",
  "kv12.5:7.4": "Āmantā. ",
  "kv12.5:7.5": "Ye keci sotāpattiniyāmaṃ okkamanti, sabbe te sattakkhattuparamatā niyatā ti? ",
  "kv12.5:7.6": "Na h' evaṃ vattabbe --pe-- 6. ",
  "kv12.5:8.1": "Na vattabbaṃ ",
  "kv12.5:8.2": "\"Sattakkhattuparamo puggalo sattakkhattuparamatā niyato ti\"? ",
  "kv12.5:8.3": "Āmantā. ",
  "kv12.5:8.4": "Nanu so sattakkhattuparamo ti? ",
  "kv12.5:8.5": "Āmantā. ",
  "kv12.5:8.6": "Hañci so sattakkhattuparamo, tena vata re vattabbe ",
  "kv12.5:8.7": "\"Sattakkhattuparamo puggalo sattakkhattuparamatā niyato ti.\" ",
  "kv12.5:8.8": "Sattakkhattuparamakathā. 1. "
}
