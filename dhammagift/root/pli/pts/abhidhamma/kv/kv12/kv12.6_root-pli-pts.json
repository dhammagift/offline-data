  "kv12.6:1.1": "Na vattabbaṃ ",
  "kv12.6:1.2": "\"Kolaṃkolo puggalo kolaṃkolatā niyato ti\"? ",
  "kv12.6:1.3": "Āmantā. ",
  "kv12.6:1.4": "Nanu so kolaṃkolo ti? ",
  "kv12.6:1.5": "Āmantā. ",
  "kv12.6:1.6": "Hañci so kolaṃkolo, tena vata re vattabbe ",
  "kv12.6:1.7": "\"Kolaṃkolo puggalo kolaṃkolatā ",
  "kv12.6:1.8": "niyato ti.\" 2. "
}
