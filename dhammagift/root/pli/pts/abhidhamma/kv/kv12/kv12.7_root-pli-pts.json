  "kv12.7:1.1": "Na vattabbaṃ ",
  "kv12.7:1.2": "\"Ekabījī puggalo ekabījitā niyato ti\"? ",
  "kv12.7:1.3": "Āmantā. ",
  "kv12.7:1.4": "Nanu so ekabījī ti? ",
  "kv12.7:1.5": "Āmantā. ",
  "kv12.7:1.6": "Hañci so ekabījī, tena vata re vattabbe ",
  "kv12.7:1.7": "\"Ekabījī puggalo ekabījitā ",
  "kv12.7:1.8": "niyato ti.\" 1. "
}
