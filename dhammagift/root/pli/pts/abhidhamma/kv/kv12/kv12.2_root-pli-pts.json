{
  "kv12.2:0.1": "",
  "kv12.2:0.2": "",
  "kv12.2:0.3": "",
  "kv12.2:0.4": "",
  "kv12.2:1.1": "Sabbaṃ kammaṃ savipākan ti? ",
  "kv12.2:1.2": "Āmantā. ",
  "kv12.2:1.3": "Sabbā cetanā savipākā ti? ",
  "kv12.2:1.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv12.2:1.5": "Sabbā cetanā savipākā ti? ",
  "kv12.2:1.6": "Āmantā. ",
  "kv12.2:1.7": "Vipākābyākatā cetanā savipākā ti? ",
  "kv12.2:1.8": "Na h' evaṃ vattabbe --pe-- ",
  "kv12.2:1.9": "Sabbā cetanā savipākā ti? ",
  "kv12.2:1.10": "Āmantā. ",
  "kv12.2:1.11": "Kiriyābyākatā cetanā savipākā ti? ",
  "kv12.2:1.12": "Na h' evaṃ vattabbe --pe-- ",
  "kv12.2:2.1": "Sabbā cetanā savipākā ti? ",
  "kv12.2:2.2": "Āmantā. ",
  "kv12.2:2.3": "Kāmāvacarā vipākābyākatā cetanā savipākā ti? ",
  "kv12.2:2.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv12.2:2.5": "Sabbā cetanā savipākā ti? ",
  "kv12.2:2.6": "Āmantā. ",
  "kv12.2:2.7": "Rūpāvacarā, arūpāvacarā, apariyāpannā vipākābyākatā cetanā savipākā ti? ",
  "kv12.2:2.8": "Na h' evaṃ vattabbe --pe-- ",
  "kv12.2:3.1": "Sabbā cetanā savipākā ti? ",
  "kv12.2:3.2": "Āmantā. ",
  "kv12.2:3.3": "Kāmāvacarā kiriyābyākatā cetanā savipākā ti? ",
  "kv12.2:3.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv12.2:3.5": "Sabbā cetanā savipākā ti? ",
  "kv12.2:3.6": "Āmantā. ",
  "kv12.2:3.7": "Rūpāvacarā, arūpāvacarā kiriyābyākatā cetanā savipākā ti? ",
  "kv12.2:3.8": "Na h' evaṃ vattabbe --pe-- 2. ",
  "kv12.2:4.1": "Vipākābyākatā cetanā avipākā ti? ",
  "kv12.2:4.2": "Āmantā. ",
  "kv12.2:4.3": "Hañci vipākābyākatā cetanā avipākā, no vata re vattabbe ",
  "kv12.2:4.4": "\"Sabbā cetanā savipākā ti.\" ",
  "kv12.2:5.1": "Kiriyābyākatā cetanā avipākā ti? ",
  "kv12.2:5.2": "Āmantā. ",
  "kv12.2:5.3": "Hañci kiriyābyākatā cetanā avipākā, no vata re vattabbe ",
  "kv12.2:5.4": "\"Sabbā cetanā savipākā ti.\" ",
  "kv12.2:6.1": "Kāmāvacarā, rūpāvacarā, arūpāvacarā, apariyāpannā vipākābyākatā cetanā avipākā ti? ",
  "kv12.2:6.2": "Āmantā. ",
  "kv12.2:6.3": "Hañci apariyāpannā vipākābyākatā cetanā avipākā, no vata re vattabbe ",
  "kv12.2:6.4": "\"Sabbā cetanā savipākā ti.\" ",
  "kv12.2:7.1": "Kāmāvacarā, rūpāvacarā, arūpāvacarā kiriyābyākatā cetanā avipākā ti? ",
  "kv12.2:7.2": "Āmantā. ",
  "kv12.2:7.3": "Hañci arūpāvacarā kiriyābyākatā cetanā avipākā, no vata re vattabbe ",
  "kv12.2:7.4": "\"Sabbā cetanā savipākā ti.\" 3. ",
  "kv12.2:8.1": "Na vattabbaṃ ",
  "kv12.2:8.2": "\"Sabbaṃ kammaṃ savipākan ti\"? ",
  "kv12.2:8.3": "Āmantā. ",
  "kv12.2:8.4": "Nanu vuttaṃ Bhagavatā -- ",
  "kv12.2:8.5": "\"Nāhaṃ Bhikkhave sañcetanikānaṃ kammānaṃ katānaṃ upacitānaṃ appaṭisaṃveditvā byantibhāvaṃ vadāmi tañ ca kho diṭṭh' eva dhamme uppajje vā apare vā pariyāye ti.\" ",
  "kv12.2:8.6": "Atth' eva suttanto ti? ",
  "kv12.2:8.7": "Āmantā. ",
  "kv12.2:8.8": "Tena hi sabbaṃ kammaṃ savipākan ti. ",
  "kv12.2:8.9": "Kammakathā. 1. "
}
