  "kv13.9:3.3": "Dhammataṇhā akusalā ti? ",
  "kv13.9:3.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv13.9:3.5": "Saddataṇhā --pe-- ",
  "kv13.9:3.6": "phoṭṭhabbataṇhā akusalā ti? ",
  "kv13.9:3.7": "Āmantā. ",
  "kv13.9:3.8": "Dhammataṇhā akusalā ti? ",
  "kv13.9:3.9": "Na h' evam vattabbe --pe-- 2. ",
  "kv13.9:4.1": "Dhammataṇhā abyākatā ti? ",
  "kv13.9:4.2": "Āmantā. ",
  "kv13.9:4.3": "Nanu taṇhā akusalā vuttā Bhagavatā ti? ",
  "kv13.9:4.4": "Āmantā. ",
  "kv13.9:4.5": "Hañci taṇhā akusalā vuttā Bhagavatā, no vata re vattabbe ",
  "kv13.9:4.6": "Dhammataṇhā abyākatā ti.\" ",
  "kv13.9:5.1": "Dhammataṇhā abyākatā ti? ",
  "kv13.9:5.2": "Āmantā. ",
  "kv13.9:5.3": "Nanu lobho akusalo vutto Bhagavatā, dhammataṇhā lobho ti? ",
  "kv13.9:5.4": "Āmantā. ",
  "kv13.9:5.5": "Hañci lobho akusalo vutto Bhagavatā, dhammataṇhā lobho, no vata re vattabbe ",
  "kv13.9:5.6": "Dhammataṇhā abyākatā ti.\" 3. ",
  "kv13.9:6.1": "Dhammataṇhā lobho abyākato ti? ",
  "kv13.9:6.2": "Āmantā. ",
  "kv13.9:6.3": "Rūpataṇhā lobho abyākato ti? ",
  "kv13.9:6.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv13.9:6.5": "Dhammataṇhā lobho abyākato ti? ",
