  "kv13.2:0.3": "",
  "kv13.2:0.4": "",
  "kv13.2:1.1": "Kappaṭṭho kusalaṃ cittaṃ na paṭilabheyyāti? ",
  "kv13.2:1.2": "Āmantā. ",
  "kv13.2:1.3": "Kappaṭṭho dānaṃ dadeyyāti? ",
  "kv13.2:1.4": "Āmantā. ",
  "kv13.2:1.5": "Hañci kappaṭṭho dānaṃ dadeyya, no vata re vattabbe ",
  "kv13.2:1.6": "\"Kappaṭṭho kusalaṃ cittaṃ na paṭilabheyyāti.\" ",
  "kv13.2:2.1": "Kappaṭṭho kusalaṃ cittaṃ na paṭilabheyyāti? ",
  "kv13.2:2.2": "Āmantā. ",
  "kv13.2:2.3": "Kappaṭṭho cīvaraṃ dadeyya, ",
  "kv13.2:2.4": "piṇḍapātaṃ dadeyya, ",
  "kv13.2:2.5": "senāsanaṃ dadeyya, ",
  "kv13.2:2.6": "gilānapaccayabhesajjaparikkhāraṃ dadeyya, ",
  "kv13.2:2.7": "khādanīyaṃ dadeyya, ",
  "kv13.2:2.8": "bhojanīyaṃ dadeyya, ",
  "kv13.2:2.9": "pānīyaṃ dadeyya, ",
  "kv13.2:2.10": "cetiyaṃ vandeyya, ",
  "kv13.2:2.11": "cetiye mālaṃ āropeyya, ",
  "kv13.2:2.12": "gandhaṃ āropeyya, ",
  "kv13.2:2.13": "vilepanaṃ āropeyya, ",
  "kv13.2:2.14": "cetiyaṃ padakkhiṇaṃ kareyyāti? ",
  "kv13.2:2.15": "Āmantā. ",
  "kv13.2:2.16": "Hañci kappaṭṭho cetiyaṃ padakkhiṇaṃ kareyya, no vata re vattabbe ",
  "kv13.2:2.17": "\"Kappaṭṭho kusalaṃ cittaṃ na paṭilabheyyāti.\" 2. ",
  "kv13.2:3.1": "Kappaṭṭho kusalaṃ cittaṃ paṭilabheyyāti? ",
  "kv13.2:3.2": "Āmantā. ",
  "kv13.2:3.3": "Tato vuṭṭhānaṃ kusalaṃ cittaṃ paṭilabheyyāti? ",
  "kv13.2:3.4": "Āmantā. ",
  "kv13.2:3.5": "Rūpāvacaraṃ --pe-- ",
  "kv13.2:3.6": "arūpāvacaraṃ --pe-- ",
  "kv13.2:3.7": "lokuttaraṃ kusalaṃ cittaṃ paṭilabheyyāti? ",
  "kv13.2:3.8": "Na h' evaṃ vattabbe --pe-- ",
  "kv13.2:3.9": "Kusalapaṭilābhakathā. 1. "
}
