  "kv13.6:0.1": "",
  "kv13.6:0.2": "",
  "kv13.6:0.3": "",
  "kv13.6:0.4": "",
  "kv13.6:1.1": "Sammukhībhūto saññojanaṃ jahatīti? ",
  "kv13.6:1.2": "Āmantā. ",
  "kv13.6:1.3": "Ratto rāgaṃ jahati, duṭṭho dosaṃ jahati, mūḷho mohaṃ jahati, kiliṭṭho kilese jahatīti? ",
  "kv13.6:1.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv13.6:1.5": "Rāgena rāgaṃ jahati, dosena dosaṃ jahati, mohena mohaṃ jahati, kilesehi kelese jahatīti? ",
  "kv13.6:1.6": "Na h' evaṃ vattabbe --pe-- ",
  "kv13.6:2.1": "Rāgo cittasampayutto maggo cittasampayutto ti? ",
  "kv13.6:2.2": "Āmantā. ",
  "kv13.6:2.3": "Dvinnaṃ phassānaṃ --pe-- ",
  "kv13.6:2.4": "dvinnaṃ cittānaṃ samodhānaṃ hotīti? ",
  "kv13.6:2.5": "Na h' evaṃ vattabbe --pe-- ",
  "kv13.6:2.6": "Rāgo akusalo maggo kusalo ti? ",
  "kv13.6:2.7": "Āmantā. ",
  "kv13.6:2.8": "Kusalākusalā sāvajjānavajjā hīnappaṇītā kaṇhasukkasappaṭibhābā dhammā sammukhībhāvaṃ āgacchantīti? Na h' evaṃ vattabbe --pe-- Kūsalākusalā sāvajjānavajjā hīnappaṇītā kaṇhasukkasappaṭibhāgā dhammā ",
  "kv13.6:2.9": "",
  "kv13.6:3.1": "",
  "kv13.6:3.2": "sammukhībhāvaṃ āgacchantīti? ",
  "kv13.6:3.3": "Āmantā. ",
  "kv13.6:3.4": "Nanu vuttaṃ Bhagavatā -- ",
  "kv13.6:3.5": "\"Cattār' imāni Bhikkhave suvidūravidūrāni. ",
  "kv13.6:3.6": "Katamāni cattāri? ",
  "kv13.6:3.7": "Nabhañ ca Bhikkhave pathavī ca ",
  "kv13.6:3.8": "idaṃ paṭhamaṃ suvidūravidūraṃ -- pe -- tasmā sataṃ dhammo asabbhi ārakā ti.\" ",
  "kv13.6:3.9": "Atth' eva suttanto ti? ",
  "kv13.6:3.10": "Āmantā. ",
  "kv13.6:3.11": "Tena hi na vattabbaṃ ",
  "kv13.6:3.12": "\"Kusalākusalā --pe-- ",
  "kv13.6:3.13": "sammukhībhāvaṃ āgacchantīti.\" 2. ",
  "kv13.6:4.1": "Sammukhībhūto saññojanaṃ jahatīti? ",
  "kv13.6:4.2": "Āmantā. ",
  "kv13.6:4.3": "Nanu vuttaṃ Bhagavatā -- ",
  "kv13.6:4.4": "\"So evaṃ samāhite citte parisuddhe pariyodāte anaṅgaṇe vigatūpakkilese mudubhūte kammaniye ṭhite āneñjapatte ",
  "kv13.6:4.5": "āsavānaṃ khayañāṇāya cittaṃ abhininnāmetīti.\" ",
  "kv13.6:4.6": "Atth' eva suttanto ti? ",
  "kv13.6:4.7": "Āmantā. ",
  "kv13.6:4.8": "Tena hi na vattabbaṃ ",
  "kv13.6:4.9": "\"Sammukhībhūto saññojanaṃ jahatīti.\" 3. ",
  "kv13.6:5.1": "Na vattabbaṃ ",
  "kv13.6:5.2": "\"Sammukhībhūto saññojanaṃ jahatīti\"? ",
  "kv13.6:5.3": "Āmantā. ",
  "kv13.6:5.4": "Nanu vuttaṃ Bhagavatā -- ",
  "kv13.6:5.5": "\"Tassa evaṃ jānato evaṃ passato kāmāsavā pi cittaṃ vimuccati --pe-- ",
  "kv13.6:5.6": "avijjāsavā pi cittaṃ vimuccatīti.\" ",
  "kv13.6:5.7": "Atth' eva suttanto ti? ",
  "kv13.6:5.8": "Āmantā. ",
  "kv13.6:5.9": "Tena hi sammukhībhūto saññojanaṃ jahatīti. ",
  "kv13.6:5.10": "Sammukhībhūtakathā. 1. "
}
