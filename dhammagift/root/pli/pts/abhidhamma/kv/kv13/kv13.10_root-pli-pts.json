{
  "kv13.10:0.1": "",
  "kv13.10:0.2": "",
  "kv13.10:0.3": "",
  "kv13.10:0.4": "",
  "kv13.10:1.1": "Dhammataṇhā na dukkhasamudayo ti? ",
  "kv13.10:1.2": "Āmantā. ",
  "kv13.10:1.3": "Rūpataṇhā na dukkhasmudayo ti? ",
  "kv13.10:1.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv13.10:1.5": "Dhammataṇhā na dukkhasamudayo ti? ",
  "kv13.10:1.6": "Āmantā. ",
  "kv13.10:1.7": "Saddataṇhā ",
  "kv13.10:1.8": "",
  "kv13.10:1.9": "--pe-- ",
  "kv13.10:1.10": "phoṭṭhabbataṇhā na dukkhasamudayo ti? ",
  "kv13.10:1.11": "Na h' evaṃ vattabbe --pe-- ",
  "kv13.10:2.1": "Rūpataṇhā dukkhasamudayo ti? ",
  "kv13.10:2.2": "Āmantā. ",
  "kv13.10:2.3": "Dhammataṇhā dukkhasamudayo ti? ",
  "kv13.10:2.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv13.10:2.5": "Saddataṇhā --pe-- ",
  "kv13.10:2.6": "",
  "kv13.10:2.7": "",
  "kv13.10:2.8": "phoṭṭhabbataṇhā dukkhasamudayo ti? ",
  "kv13.10:2.9": "Āmantā. ",
  "kv13.10:2.10": "Dhammataṇhā dukkhasamudayo ti? ",
  "kv13.10:2.11": "Na h' evaṃ vattabbe --pe-- 2. ",
  "kv13.10:3.1": "Dhammataṇhā na dukkhasamudayo ti? ",
  "kv13.10:3.2": "Āmantā. ",
  "kv13.10:3.3": "Nanu taṇhā dukkhasamudayo vutto Bhagavatā ti? ",
  "kv13.10:3.4": "Āmantā. ",
  "kv13.10:3.5": "Hañci taṇhā dukkhasamudayo vutto Bhagavatā, no vata re vattabbe ",
  "kv13.10:3.6": "\"Dhammataṇhā na dukkhasamudayo ti.\" ",
  "kv13.10:3.7": "Dhammataṇhā na dukkhasamudayo ti? ",
  "kv13.10:3.8": "Āmantā. ",
  "kv13.10:3.9": "Nanu labho dukkhasamudayo vutto Bhagavatā, dhammataṇhā lobho ti? ",
  "kv13.10:3.10": "Āmantā. ",
  "kv13.10:3.11": "Hañci lobho dukkhasamudayo vutto Bhagavatā, dhammataṇhā lobho, no vata re vattabbe ",
  "kv13.10:3.12": "\"Dhammataṇhā na dukkhasamudayo ti.\" 3. ",
  "kv13.10:4.1": "Dhammataṇhā lobho na dukkhasamudayo ti? ",
  "kv13.10:4.2": "Āmantā. ",
  "kv13.10:4.3": "Rūpataṇhā lobho na dukkhasamudayo ti? ",
  "kv13.10:4.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv13.10:4.5": "Dhammataṇhā lobho na dukkhasamudayo ti? ",
  "kv13.10:4.6": "Āmantā. ",
  "kv13.10:4.7": "Saddataṇhā --pe-- ",
  "kv13.10:4.8": "",
  "kv13.10:4.9": "",
  "kv13.10:4.10": "phoṭṭhabbataṇhā lobho na dukkhasamudayo ti? ",
  "kv13.10:4.11": "Na h' evaṃ vattabbe --pe-- ",
  "kv13.10:5.1": "Rūpataṇhā lobho dukkhasamudayo ti? ",
  "kv13.10:5.2": "Āmantā. ",
  "kv13.10:5.3": "Dhammataṇhā lobho dukkhasamudayo ti? ",
  "kv13.10:5.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv13.10:5.5": "Saddataṇhā --pe-- ",
  "kv13.10:5.6": "phoṭṭhabbataṇhā lobho dukkhasamudayo ti? ",
  "kv13.10:5.7": "Āmantā. ",
  "kv13.10:5.8": "Dhammataṇhā lobho dukkhasamudayo ti? ",
  "kv13.10:5.9": "Na h' evaṃ vattabbe --pe-- 4. ",
  "kv13.10:6.1": "Dhammataṇhā na dukkhasamudayo ti? ",
  "kv13.10:6.2": "Āmantā. ",
  "kv13.10:6.3": "Nanu vuttaṃ Bhagavatā ",
  "kv13.10:6.4": "\"Yāyaṃ taṇhā ponobhavikā nandirāgasahagatā tatratatrābhinandinī, seyyathīdaṃ ",
  "kv13.10:6.5": "kāmataṇhā bhavataṇhā vibhavataṇhā ti.\" ",
  "kv13.10:6.6": "Atth' eva suttanto ti? ",
  "kv13.10:6.7": "Āmantā. ",
  "kv13.10:6.8": "Tena hi na vattabbaṃ ",
  "kv13.10:6.9": "Dhammataṇhā na dukkhasamudayo ti? 5. ",
  "kv13.10:7.1": "Na vattabbaṃ ",
  "kv13.10:7.2": "\"Dhammataṇhā na dukkhasamudayo ti?\" ",
  "kv13.10:7.3": "Āmantā. ",
  "kv13.10:7.4": "Nanu sā dhammataṇhā ti? ",
  "kv13.10:7.5": "Āmantā. ",
  "kv13.10:7.6": "Hañci sā dhammataṇhā, tena vata re vattabbe ",
  "kv13.10:7.7": "\"Dhammataṇhā na dukkhasamudayo ti.\" ",
  "kv13.10:7.8": "Dhammataṇhā na dukkhasamudayo ti kathā. ",
  "kv13.10:7.9": "",
  "kv13.10:7.10": "",
  "kv13.10:8.1": "Kappaṭṭho kappaṃ tiṭṭheyya, Kappaṭṭho kusalaṃ cittaṃ na paṭilabheyya, Anantarāpayutto puggalo sammattaniyāmaṃ okkameyya, Niyato niyāmaṃ okkameyya, Nivuto nīvaraṇaṃ jahati, Sammukhībhūto saññojanaṃ jahati, Jhānanikanti, Asātarāgo Dhammataṇhā abyākatā, Dhammataṇhā na dukkhasamudayo ti. 1. "
}
