{
  "kv13.5:0.1": "",
  "kv13.5:0.2": "",
  "kv13.5:0.3": "",
  "kv13.5:0.4": "",
  "kv13.5:1.1": "Nivuto nīvaraṇaṃ jahatīti? ",
  "kv13.5:1.2": "Āmantā. ",
  "kv13.5:1.3": "Ratto rāgaṃ jahati, duṭṭho dosaṃ jahati, mūḷho moham jahati, kiliṭṭho kilese jahatīti? ",
  "kv13.5:1.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv13.5:1.5": "Rāgena rāgaṃ jahati, dosena dosaṃ jahati, mohena mohaṃ jahati, kilesehi kilese jahatīti? ",
  "kv13.5:1.6": "Na h' evaṃ vattabbe --pe-- ",
  "kv13.5:2.1": "Rāgo cittasampayutto maggo cittasampayutto ti? ",
  "kv13.5:2.2": "Āmantā. ",
  "kv13.5:2.3": "Dvinnaṃ phassānaṃ --pe-- ",
  "kv13.5:2.4": "dvinnaṃ cittānaṃ samodhānaṃ hotīti? ",
  "kv13.5:2.5": "Na h' evaṃ vattabbe --pe-- ",
  "kv13.5:2.6": "Rāgo akusalo maggo kusalo ti? ",
  "kv13.5:2.7": "Āmantā. ",
  "kv13.5:2.8": "Kusalākusalā sāvajjānavajjā hīnappaṇītā kaṇhasukkasappaṭibhāgā dhammā sammukhībhāvaṃ āgacchantīti? ",
  "kv13.5:2.9": "Na h' evaṃ vattabbe --pe-- ",
  "kv13.5:3.1": "Kusalākusalā sāvajjānavajjā hīnappaṇītā kaṇhasukkasappaṭibhāgā dhammā sammukhībhāvaṃ āgacchantīti? ",
  "kv13.5:3.2": "Āmantā. ",
  "kv13.5:3.3": "Nanu vuttaṃ Bhagavatā -- ",
  "kv13.5:3.4": "\"Cattār' imāni Bhikkhave suvidūravidūrāni. ",
  "kv13.5:3.5": "Katamāni cattāri? ",
  "kv13.5:3.6": "Nabhañ ca Bhikkhave pathavī ca ",
  "kv13.5:3.7": "idaṃ paṭhamaṃ suvidūravidūraṃ -- pe -- tasmā sataṃ dhammo asabbhi ārakā ti.\" ",
  "kv13.5:3.8": "Atth' eva suttanto ti? ",
  "kv13.5:3.9": "Āmantā. ",
  "kv13.5:3.10": "Tena hi na vattabaṃ ",
  "kv13.5:3.11": "Kusalākusalā --pe-- ",
  "kv13.5:3.12": "sammukhībhāvaṃ āgacchantīti.\" 2. ",
  "kv13.5:4.1": "Nivuto nīvaraṇaṃ jahatīti? ",
  "kv13.5:4.2": "Āmantā. ",
  "kv13.5:4.3": "Nanu vuttaṃ Bhagavatā -- ",
  "kv13.5:4.4": "\"So evaṃ samāhite citte parisuddhe pariyodāte anaṅgaṇe vigatūpakkilese mudubhūte kammaniye ṭhite āneñjapatte āsavānaṃ khayañāṇāya cittaṃ abhininnāmetīti.\" ",
  "kv13.5:4.5": "Atth' eva suttanto ti? ",
  "kv13.5:4.6": "Āmantā. ",
  "kv13.5:4.7": "Tena hi na vattabbaṃ ",
  "kv13.5:4.8": "\"Nivuto nīvaraṇaṃ jahatīti.\" 3. ",
  "kv13.5:5.1": "Na vattabbaṃ ",
  "kv13.5:5.2": "\"Nivuto nīvaraṇaṃ jahatīti\"? ",
  "kv13.5:5.3": "Āmantā. ",
  "kv13.5:5.4": "Nanu vuttaṃ Bhagavatā -- ",
  "kv13.5:5.5": "\"Tassa evaṃ jānato evaṃ passato kāmāsavā pi cittaṃ vimuccati --pe-- ",
  "kv13.5:5.6": "avijjāsavā pi cittaṃ vimuccatīti.\" ",
  "kv13.5:5.7": "Atth' eva suttanto ti? ",
  "kv13.5:5.8": "Āmantā. ",
  "kv13.5:5.9": "Tena hi nivuto nīvaraṇaṃ jahatīti. ",
  "kv13.5:5.10": "Nivutakathā. 1. "
}
