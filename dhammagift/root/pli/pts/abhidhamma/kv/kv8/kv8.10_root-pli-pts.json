  "kv8.10:1.1": "",
  "kv8.10:1.2": "Āmantā. ",
  "kv8.10:1.3": "N' atthi rūpīnaṃ dhammānaṃ āyuṭṭhiti yapanā yāpanā iriyanā vattanā pālanā ti? ",
  "kv8.10:1.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv8.10:1.5": "Atthi rūpīnaṃ dhammānaṃ āyuṭṭhiti yapanā yāpanā iriyanā vattanā pālanā ti? ",
  "kv8.10:1.6": "Āmantā. ",
  "kv8.10:1.7": "Hañci atthi rūpīnaṃ dhammānaṃ āyuṭṭhiti yapanā yāpanā iriyanā vattanā pālanā, no vata re vattabbe ",
  "kv8.10:1.8": "\"N' atthi jīvitindriyan ti.\" 2. ",
  "kv8.10:2.1": "Atthi arūpīnaṃ dhammānaṃ āyuṭṭhiti yapanā yāpanā iriyanā vattanā pālanā, atthi arūpajīvitindriyan ti? ",
  "kv8.10:2.2": "Āmantā. ",
  "kv8.10:2.3": "Atthi rūpīnaṃ dhammānaṃ āyuṭṭhiti yapanā yāpanā iriyanā vattanā pālanā, atthi rūpajīvitindriyan ti? ",
  "kv8.10:2.4": "Na h' evam vattabbe --pe-- ",
  "kv8.10:2.5": "Atthi rūpīnaṃ dhammānaṃ āyuṭṭhiti yapanā yāpanā iriyanā vattanā pālanā, n' atthi rūpajīvitindriyan ti? ",
  "kv8.10:2.6": "Āmantā. ",
  "kv8.10:2.7": "Atthi arūpīnaṃ dhammānaṃ āyuṭṭhiti yapanā yāpanā iriyanā vattanā pālanā, n' atthi arūpajīvitindriyan ti? ",
  "kv8.10:2.8": "Na h' evaṃ vattabbe --pe-- 3. ",
  "kv8.10:3.1": "Arūpīnaṃ dhammānaṃ āyu arūpajīvitindriyan ti? ",
  "kv8.10:3.2": "Āmantā. ",
  "kv8.10:3.3": "Rūpīnaṃ dhammānaṃ āyu rūpajīvitindriyan ti? ",
  "kv8.10:3.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv8.10:3.5": "Rūpīnaṃ dhammānaṃ āyu na vattabbaṃ ",
  "kv8.10:3.6": "rūpajīvitindriyan ti? ",
  "kv8.10:3.7": "Āmantā. ",
  "kv8.10:3.8": "Arūpīnaṃ dhammānaṃ āyu na vattabbaṃ ",
  "kv8.10:3.9": "arūpajīvitindriyan ti? ",
  "kv8.10:3.10": "Na h' evaṃ vattabbe --pe-- 4. ",
  "kv8.10:4.1": "Rūpīnaṃ dhammānaṃ āyu arūpajīvitindriyan ti? ",
  "kv8.10:4.2": "Āmantā. ",
  "kv8.10:4.3": "Arūpīnaṃ dhammānaṃ āyu rūpajīvitindriyan ti? ",
  "kv8.10:4.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv8.10:5.1": "Arūpīnaṃ dhammānaṃ āyu na vattabbaṃ ",
  "kv8.10:5.2": "rūpajīvitindriyan ti? ",
  "kv8.10:5.3": "Āmantā. ",
  "kv8.10:5.4": "Rūpīnaṃ dhammānaṃ āyu na vattabbaṃ ",
  "kv8.10:5.5": "arūpajīvitindriyan ti? ",
  "kv8.10:5.6": "Na h' evaṃ vattabbe --pe-- 5. ",
  "kv8.10:6.1": "Rūpīnañ ca arūpīnañ ca dhammānaṃ āyu arūpajīvitindriyan ti? ",
  "kv8.10:6.2": "Āmantā. ",
  "kv8.10:6.3": "Rūpīnañ ca arūpīnañ ca dhammānaṃ āyu rūpajīvitindriyan ti? ",
  "kv8.10:6.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv8.10:7.1": "Rūpīnañ ca arūpīnañ ca dhammānaṃ āyu na vattabbaṃ ",
  "kv8.10:7.2": "rūpajīvitindriyan ti? ",
  "kv8.10:7.3": "Āmantā. ",
  "kv8.10:7.4": "Rūpīnañ ca arūpīnañ ca dhammānaṃ āyu na vattabbaṃ ",
  "kv8.10:7.5": "arūpajīvitindriyan ti? ",
  "kv8.10:7.6": "Na h' evam vattabbe --pe-- 6. ",
  "kv8.10:7.7": "N' atthi rūpajīvitindriyan ti? ",
  "kv8.10:7.8": "Āmantā. ",
  "kv8.10:7.9": "Nirodhaṃ samāpannassa n' atthi jīvitindriyan ti? ",
  "kv8.10:7.10": "Na h' evaṃ vattabbe --pe-- ",
  "kv8.10:8.1": "Nirodhaṃ samāpannassa atthi jīvitindriyan ti? ",
  "kv8.10:8.2": "Āmantā. ",
  "kv8.10:8.3": "Hañci nirodhaṃ samāpannassa atthi jīvitindriyaṃ, no vata re vattabbe ",
  "kv8.10:8.4": "\"N' atthi rūpajīvitindriyan ti.\" 7. ",
  "kv8.10:9.1": "Nirodhaṃ samāpannassa atthi jīvitindriyan ti? ",
  "kv8.10:9.2": "Āmantā. ",
  "kv8.10:9.3": "Katamakkhandhapariyāpannan ti? Saṃkhārakkhandhapariyāpannan ",
  "kv8.10:9.4": "ti. ",
  "kv8.10:9.5": "Nirodhaṃ samāpannassa atthi saṃkhārakkhandho ti? ",
  "kv8.10:9.6": "Na h' evaṃ vattabbe --pe-- ",
  "kv8.10:10.1": "Nirodhaṃ samāpannassa atthi saṃkhārakkhandho ti? ",
  "kv8.10:10.2": "Āmantā. ",
  "kv8.10:10.3": "Nirodhaṃ samāpannassa atthi vedanākkhandho --pe-- ",
  "kv8.10:10.4": "saññākkhandho --pe-- ",
  "kv8.10:10.5": "viññāṇakkhandho ti? ",
  "kv8.10:10.6": "Na h' evaṃ vattabbe --pe-- ",
  "kv8.10:11.1": "Nirodhaṃ samāpannassa atthi vedanākkhandho --pe-- ",
  "kv8.10:11.2": "saññākkhandho --pe-- ",
  "kv8.10:11.3": "viññāṇakkhandho ti? ",
  "kv8.10:11.4": "Āmantā. ",
  "kv8.10:11.5": "Na nirodhasamāpanno ti? ",
  "kv8.10:11.6": "Na h' evaṃ vattabbe --pe-- 8. ",
  "kv8.10:12.1": "N' atthi rūpajīvitindriyan ti? ",
  "kv8.10:12.2": "Āmantā. ",
  "kv8.10:12.3": "Asaññasattānaṃ n' atthi jīvitindriyan ti? ",
  "kv8.10:12.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv8.10:13.1": "Asaññasattānaṃ atthi jīvitindriyan ti? ",
  "kv8.10:13.2": "Āmantā. ",
  "kv8.10:13.3": "Hañci asaññasattānaṃ atthi jīvitindriyaṃ, no vata re vattabbe ",
  "kv8.10:13.4": "\"N' atthi rūpajīvitindriyan ti.\" 9. ",
  "kv8.10:13.5": "Asaññasattānaṃ atthi jīvitindriyan ti? ",
  "kv8.10:13.6": "Āmantā. ",
  "kv8.10:13.7": "Katamakkhandhapariyāpannan ti? Saṃkhārakkhandhapariyāpannan ",
  "kv8.10:13.8": "ti. ",
  "kv8.10:13.9": "Asaññasattānaṃ atthi saṃkhārakkhandho ti? ",
  "kv8.10:13.10": "Na h' evaṃ vattabbe --pe-- ",
  "kv8.10:14.1": "Asaññasattānaṃ atthi saṃkhārakkhandho ti? ",
  "kv8.10:14.2": "Āmantā. ",
  "kv8.10:14.3": "Asaññasattānaṃ atthi vedanākkhandho --pe-- ",
  "kv8.10:14.4": "saññākkhandho --pe-- ",
  "kv8.10:14.5": "viññāṇakkhandho ti? ",
  "kv8.10:14.6": "Na h' evaṃ vattabbe --pe-- ",
  "kv8.10:15.1": "Asaññasattānaṃ atthi vedanākkhandho --pe-- ",
  "kv8.10:15.2": "saññākkhandho --pe-- ",
  "kv8.10:15.3": "viññāṇakkhandho ti? ",
  "kv8.10:15.4": "Āmantā. ",
  "kv8.10:15.5": "Pañcavokārabhavo ti? ",
  "kv8.10:15.6": "Na h' evaṃ vattabbe --pe-- 10. ",
  "kv8.10:16.1": "Uppattesiyena cittena samuṭṭhitaṃ jīvitindriyaṃ uppattesiye citte bhijjamāne ekadesaṃ bhijjatīti? ",
  "kv8.10:16.2": "Āmantā. ",
  "kv8.10:16.3": "Uppattesiyena cittena samuṭṭhito phasso uppattesiye citte bhijjamāne ekadeso bhijjatīti? ",
  "kv8.10:16.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv8.10:17.1": "Uppattesiyena cittena samuṭṭhito phasso uppattesiye citte bhijjamāne anavaseso bhijjatīti? ",
  "kv8.10:17.2": "Āmantā. ",
  "kv8.10:17.3": "Uppattesiyena cittena samuṭṭhitaṃ jīvitindriyaṃ uppattesiye citte bhijjamāne anavasesaṃ bhijjatīti? ",
  "kv8.10:17.4": "Na h' evaṃ vattabbe --pe-- 11. ",
  "kv8.10:18.1": "Dve jīvitindriyānīti? ",
  "kv8.10:18.2": "Āmantā. ",
  "kv8.10:18.3": "Dvīhi jīvitehi jīvati, dvīhi maraṇehi mīyatīti? ",
  "kv8.10:18.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv8.10:18.5": "Jīvitindriyakathā 1. "
}
