  "kv8.5:1.1": "Rūpino dhammā rūpadhātūti? ",
  "kv8.5:1.2": "Āmantā. ",
  "kv8.5:1.3": "Rūpaṃ bhavo gati sattāvāso saṃsāro yoni viññāṇaṭṭhiti attabhāvapaṭilābho ti? ",
  "kv8.5:1.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv8.5:1.5": "Atthi rūpūpagaṃ kamman ti? ",
  "kv8.5:1.6": "Na h' evaṃ vattabbe --pe-- ",
  "kv8.5:1.7": "Atthi rūpūpagā sattā ti? ",
  "kv8.5:1.8": "Na h' evaṃ vattabbe --pe-- ",
  "kv8.5:1.9": "Rūpe sattā jāyanti jīyanti mīyanti cavanti uppajjantīti? ",
  "kv8.5:1.10": "Na h' evaṃ vattabbe --pe-- ",
  "kv8.5:1.11": "Rūpe atthi rūpaṃ vedanā saññā saṃkhārā viññāṇan ti? ",
  "kv8.5:1.12": "Na h' evaṃ vattabbe --pe-- ",
  "kv8.5:1.13": "Rūpaṃ pañcavokārabhavo ti? ",
  "kv8.5:1.14": "Na h' evaṃ vattabbe --pe-- 2. ",
  "kv8.5:2.1": "Rūpadhātu bhavo gati --pe-- ",
  "kv8.5:2.2": "attabhāvapaṭilābho ti? ",
  "kv8.5:2.3": "Āmantā. ",
  "kv8.5:2.4": "Rūpaṃ bhavo gati --pe-- ",
  "kv8.5:2.5": "attabhāvapaṭilābho ti? ",
  "kv8.5:2.6": "Na h' evaṃ vattabbe --pe-- ",
  "kv8.5:2.7": "Atthi rūpadhātūpagaṃ kamman ti? ",
  "kv8.5:2.8": "Āmantā. ",
  "kv8.5:2.9": "Atthi rūpūpagaṃ kamman ti? ",
  "kv8.5:2.10": "Na h' evaṃ vattabbe --pe-- ",
  "kv8.5:2.11": "Atthi rūpadhātūpagā sattā ti? ",
  "kv8.5:2.12": "Āmantā. ",
  "kv8.5:2.13": "Atthi rūpūpagā sattā ti? ",
  "kv8.5:2.14": "Na h' evaṃ vattabbe --pe-- ",
  "kv8.5:3.1": "Rūpadhātuyā sattā jāyanti jīyanti mīyanti cavanti uppajjantīti? ",
  "kv8.5:3.2": "Āmantā. ",
  "kv8.5:3.3": "Rūpe sattā jāyanti jīyanti mīyanti cavanti uppajjantīti? ",
  "kv8.5:3.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv8.5:3.5": "Rūpadhātuyā atthi rūpaṃ vedanā saññā saṃkhārā viññāṇan ti? ",
  "kv8.5:3.6": "Āmantā. ",
  "kv8.5:3.7": "Rūpe atthi rūpaṃ vedanā saññā saṃkhārā viññāṇan ti? ",
  "kv8.5:3.8": "Na h' evaṃ vattabbe --pe-- ",
  "kv8.5:3.9": "Rūpadhātu pañcavokārabhavo ti? ",
  "kv8.5:3.10": "Āmantā. ",
  "kv8.5:3.11": "Rūpaṃ pañcavokārabhavo ti? ",
  "kv8.5:3.12": "Na h' evaṃ vattabbe --pe-- ",
  "kv8.5:4.1": "Rūpino dhammā rūpadhātu, kāmadhātuyā atthi rūpan ti? ",
  "kv8.5:4.2": "Āmantā. ",
  "kv8.5:4.3": "Sā va kāmadhātu, sā rūpadhātūti? ",
  "kv8.5:4.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv8.5:4.5": "Sā va kāmadhātu, sā rūpadhātūti? ",
  "kv8.5:4.6": "Āmantā. ",
  "kv8.5:4.7": "Kāmabhavena samannāgato puggalo dvīhi bhavehi samannāgato hoti ",
  "kv8.5:4.8": "kāmabhavena ca rūpabhavena cāti? ",
  "kv8.5:4.9": "Na h' evaṃ vattabbe --pe-- ",
  "kv8.5:4.10": "Rūpadhātukathā. 1. "
}
