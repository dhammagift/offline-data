  "kv14.9:0.1": "",
  "kv14.9:0.2": "",
  "kv14.9:0.3": "",
  "kv14.9:0.4": "",
  "kv14.9:1.1": "Diṭṭhigataṃ apariyāpannan ti? ",
  "kv14.9:1.2": "Āmantā. ",
  "kv14.9:1.3": "Maggo phalaṃ nibbānaṃ, sotāpattimaggo sotāpattiphalaṃ, sakadāgāmimaggo sakadāgāmiphalaṃ, anāgāmimaggo anāgāmiphalaṃ, arahattamaggo arahattaphalaṃ, satipaṭṭhānaṃ sammappadhānaṃ iddhipādo indriyaṃ balaṃ bojjhaṅgo ti? ",
  "kv14.9:1.4": "Na h' evaṃ vattabbe --pe-- 2. ",
  "kv14.9:2.1": "Na vattabbaṃ ",
  "kv14.9:2.2": "\"Diṭṭhigataṃ apariyāpannan ti\"? ",
  "kv14.9:2.3": "Āmantā. ",
  "kv14.9:2.4": "Puthujjano \"kāmesu vītarāgo ti\" vattabbo ti? ",
  "kv14.9:2.5": "Āmantā. ",
  "kv14.9:2.6": "\"Vigatadiṭṭhiyo ti\" vattabbo ti? ",
  "kv14.9:2.7": "Na h' evaṃ vattabbe --pe-- ",
  "kv14.9:2.8": "Tena hi diṭṭhigataṃ apariyāpannan ti. ",
  "kv14.9:2.9": "Apariyāpannakathā. ",
  "kv14.9:2.10": "",
  "kv14.9:2.11": "",
  "kv14.9:3.1": "Akusalamūlaṃ paṭisandahati kusalamūlaṃ, ",
  "kv14.9:3.2": "Kusalamūlaṃ paṭisandahati akusalamūlaṃ, ",
  "kv14.9:3.3": "Saḷāyatānaṃ, Cha viññāṇakāyā, ",
  "kv14.9:3.4": "Ariyarūpaṃ mahābhūtanaṃ upādāya, ",
  "kv14.9:3.5": "Sv' eva anusayo taṃ pariyuṭṭhānaṃ, ",
  "kv14.9:3.6": "Cittavippayuttaṃ, ",
  "kv14.9:3.7": "Yathā dhātu tañ ñeva anuseti, ",
  "kv14.9:3.8": "Diṭṭhigataṃ abyākataṃ, ",
  "kv14.9:3.9": "Diṭṭhigataṃ apariyāpannan ti. 1. "
}
