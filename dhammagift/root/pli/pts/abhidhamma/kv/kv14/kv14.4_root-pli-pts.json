  "kv14.4:0.1": "",
  "kv14.4:0.2": "",
  "kv14.4:0.3": "",
  "kv14.4:0.4": "",
  "kv14.4:1.1": "Ariyārūpaṃ mahābhūtānaṃ upādāyāti? ",
  "kv14.4:1.2": "Āmantā. ",
  "kv14.4:1.3": "Ariyarūpaṃ kusalan ti? ",
  "kv14.4:1.4": "Āmantā. ",
  "kv14.4:1.5": "Mahābhūtā kusalā ti? ",
  "kv14.4:1.6": "Na h' evaṃ vattabbe --pe-- ",
  "kv14.4:1.7": "Mahābhūtā abyākatā ti? ",
  "kv14.4:1.8": "Āmantā. ",
  "kv14.4:1.9": "Ariyarūpaṃ abyākatan ti? ",
  "kv14.4:1.10": "Na h' evaṃ vattabbe --pe-- 2. ",
  "kv14.4:1.11": "Ariyarūpaṃ mahābhūtānaṃ upādāyāti? ",
  "kv14.4:1.12": "Āmantā. ",
  "kv14.4:1.13": "Ariyarūpaṃ anāsavaṃ asaññojanīyaṃ aganthanīyaṃ anoghanīyaṃ ayoganīyaṃ anīvaraṇīyaṃ aparāmaṭṭhaṃ anupādāniyaṃ asaṃkilesikan ti? ",
  "kv14.4:1.14": "Āmantā. ",
  "kv14.4:1.15": "Mahābhūtā anāsavā --pe-- asaṃkilesikā ti? ",
  "kv14.4:1.16": "Na h' evaṃ vattabbe --pe-- ",
  "kv14.4:1.17": "Mahābhūtā sāsavā --pe-- saṃkilesikā ti? ",
  "kv14.4:1.18": "Āmantā. ",
  "kv14.4:1.19": "Ariyarūpaṃ sāsavaṃ --pe-- saṃkilesikan ti? ",
  "kv14.4:1.20": "Na h' evaṃ vattabbe --pe-- 3. ",
  "kv14.4:2.1": "Na vattabbaṃ ",
  "kv14.4:2.2": "\"Ariyarūpaṃ mahābhūtānaṃ upādāyāti\"? ",
  "kv14.4:2.3": "Āmantā. ",
  "kv14.4:2.4": "Nanu vuttaṃ Bhagavatā -- ",
  "kv14.4:2.5": "\"Yaṃ kiñci Bhikkhave rūpaṃ cattāri mahābhūtāni catunnañ ca mahābhūtānaṃ upādāya rūpan ti.\" ",
  "kv14.4:2.6": "Atth' eva suttanto ti? ",
  "kv14.4:2.7": "Āmantā. ",
  "kv14.4:2.8": "Tena hi ariyārūpaṃ mahābhūtānaṃ upādāyāti. ",
  "kv14.4:2.9": "Ariyarūpakathā. 1. "
}
