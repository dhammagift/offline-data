{
  "kv14.2:0.1": "",
  "kv14.2:0.2": "",
  "kv14.2:0.3": "",
  "kv14.2:0.4": "",
  "kv14.2:1.1": "Saḷāyatanaṃ apubbaṃ acarimaṃ mātukucchisamiṃ saṇṭhātīti? ",
  "kv14.2:1.2": "Āmantā. ",
  "kv14.2:1.3": "Sabbaṅgapaccaṅgī ahīnindriyo mātukucchismiṃ okkamatīti? ",
  "kv14.2:1.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv14.2:2.1": "Uppattesiyena cittena cakkhāyatanaṃ saṇṭhātīti? ",
  "kv14.2:2.2": "Āmantā. ",
  "kv14.2:2.3": "Uppattesiyena cittena hatthā saṇṭhanti, pādā saṇṭhanti, sīsaṃ saṇāhāti, kaṇṇo saṇṭhāti, nāsikā saṇṭhāti, mukhaṃ saṇṭhāti, dantā saṇṭhantīti? ",
  "kv14.2:2.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv14.2:3.1": "Uppattesiyena cittena sotāyatanaṃ --pe-- ",
  "kv14.2:3.2": "ghānāyatanaṃ --pe-- ",
  "kv14.2:3.3": "jivhāyatanaṃ saṇṭhātīti? ",
  "kv14.2:3.4": "Āmantā. ",
  "kv14.2:3.5": "Uppattesiyena cittena hatthā saṇṭhanti, pādā saṇṭhanti, sīsaṃ saṇṭhāti, kaṇṇo saṇṭhāti, nāsikā saṇṭhāti, mukhaṃ saṇṭhāti, dantā saṇṭhantīti? ",
  "kv14.2:3.6": "Na h' evaṃ vattabbe --pe-- 2. ",
  "kv14.2:4.1": "Mātukucchigatassa pacchā cakkhāyatanaṃ uppajjatīti? ",
  "kv14.2:4.2": "Āmantā. ",
  "kv14.2:4.3": "Mātukucchismiṃ cakkhupaṭilābhāya kammaṃ karotīti? ",
  "kv14.2:4.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv14.2:4.5": "Mātukucchigatassa pacchā sotāyatanaṃ --pe-- ",
  "kv14.2:4.6": "ghānāyatanaṃ --pe-- ",
  "kv14.2:4.7": "jivhāyatanaṃ uppajjatīti? ",
  "kv14.2:4.8": "Āmantā. ",
  "kv14.2:4.9": "Mātukucchismiṃ jivhāpaṭitābhāya kammaṃ karotīti? ",
  "kv14.2:4.10": "Na h' evaṃ vattabbe --pe-- ",
  "kv14.2:5.1": "Mātukucchigatassa pacchā kesā lomā nakhā dantā aṭṭhī uppajjantīti? ",
  "kv14.2:5.2": "Āmantā. ",
  "kv14.2:5.3": "Mātukucchismiṃ aṭṭhipaṭilābhāya kammaṃ karotīti? ",
  "kv14.2:5.4": "Na h' evaṃ vattabbe --pe-- 3. ",
  "kv14.2:6.1": "Na vattabbaṃ ",
  "kv14.2:6.2": "\"Mātukucchigatassa pacchā kesā lomā nakhā dantā aṭṭhī uppajjantīti\"? ",
  "kv14.2:6.3": "Āmantā. ",
  "kv14.2:6.4": "Nanu vuttaṃ Bhagavatā -- ",
  "kv14.2:7.1": "\"Paṭhammaṃ kalalaṃ hoti, ",
  "kv14.2:7.2": "kalalā hoti abbudaṃ, ",
  "kv14.2:7.3": "Abbudā jāyate pesī, ",
  "kv14.2:7.4": "pesī nibbattati ghano, ",
  "kv14.2:7.5": "Ghanā pasākhā jāyanti ",
  "kv14.2:7.6": "kesā lomā nakhā pi ca, ",
  "kv14.2:8.1": "Yañ c' assa bhuñjati mātā ",
  "kv14.2:8.2": "annaṃ pānañ ca bhojanaṃ ",
  "kv14.2:8.3": "Tena so tattha yāpeti ",
  "kv14.2:8.4": "mātukucchigato naro ti.\" ",
  "kv14.2:9.1": "Atth' eva suttanto ti? ",
  "kv14.2:9.2": "Āmantā. ",
  "kv14.2:9.3": "Tena hi mātukucchigatassa pacchā kesā lomā nakhā dantā aṭṭhī uppajjantīti. ",
  "kv14.2:9.4": "Saḷāyatanuppattikathā. 1. "
}
