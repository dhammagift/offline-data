  "kv18.9:0.3": "",
  "kv18.9:0.4": "",
  "kv18.9:1.1": "Cakkhunā rūpaṃ passatīti? ",
  "kv18.9:1.2": "Āmantā. ",
  "kv18.9:1.3": "Rūpena rūpaṃ passatīti? ",
  "kv18.9:1.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv18.9:1.5": "Rūpena rūpaṃ passatīti? ",
  "kv18.9:1.6": "Āmantā. ",
  "kv18.9:1.7": "Rūpena rūpaṃ paṭivijānātīti? ",
  "kv18.9:1.8": "Na h' evaṃ vattabbe --pe-- ",
  "kv18.9:1.9": "Rūpena rūpaṃ paṭivijānātīti? ",
  "kv18.9:1.10": "Āmantā. ",
  "kv18.9:1.11": "Rūpaṃ manoviññāṇan ti? ",
  "kv18.9:1.12": "Na h' evaṃ vattabbe --pe-- 2. ",
  "kv18.9:1.13": "Cakkhunā rūpaṃ passatīti? ",
  "kv18.9:1.14": "Āmantā. ",
  "kv18.9:1.15": "Atthi cakkhussa āvaṭṭanā --pe-- paṇidhīti? ",
  "kv18.9:1.16": "Na h' evaṃ vattabbe --pe-- ",
  "kv18.9:1.17": "Nanu n' atthi cakkhussa āvaṭṭanā --pe-- paṇidhīti? ",
  "kv18.9:1.18": "Āmantā. ",
  "kv18.9:1.19": "Hañci n' atthi cakkhussa āvaṭṭanā --pe-- paṇidhi, no vata re vattabbe ",
  "kv18.9:1.20": "\"Cakkhunā rūpaṃ pasatīti.\" 3. ",
  "kv18.9:2.1": "Sotena saddaṃ suṇātīti --pe-- ",
  "kv18.9:2.2": "ghānena gandhaṃ ghāyatīti --pe-- ",
  "kv18.9:2.3": "jivhāya rasaṃ sāyatīti --pe-- ",
  "kv18.9:2.4": "kāyena phoṭṭhabbaṃ phusatīti? ",
  "kv18.9:2.5": "Āmantā. ",
  "kv18.9:2.6": "Rūpena rūpaṃ phusatīti? ",
  "kv18.9:2.7": "Na h' evaṃ vattabbe --pe-- ",
  "kv18.9:3.1": "Rūpena rūpam phusatīti? ",
  "kv18.9:3.2": "Āmantā. ",
  "kv18.9:3.3": "Rūpena rūpam paṭivijānātīti? ",
  "kv18.9:3.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv18.9:3.5": "Rūpena rūpaṃ paṭivijānātīti? ",
  "kv18.9:3.6": "Āmantā. ",
  "kv18.9:3.7": "Rūpaṃ manoviññāṇan ti? ",
  "kv18.9:3.8": "Na h' evaṃ vattabbe --pe-- 4. ",
  "kv18.9:3.9": "Kāyena phoṭṭhabbaṃ phusatīti? ",
  "kv18.9:3.10": "Āmantā. ",
  "kv18.9:3.11": "Atthi kāyassa āvaṭṭanā --pe-- paṇidhīti? ",
  "kv18.9:3.12": "Na h' evaṃ vattabbe --pe-- ",
  "kv18.9:3.13": "Nanu n' atthi kāyassa āvaṭṭanā --pe-- paṇidhīti? ",
  "kv18.9:3.14": "Āmantā. ",
  "kv18.9:3.15": "Hañci n' atthi kāyassa āvaṭṭanā --pe-- paṇidhi, no vata re vattabbe ",
  "kv18.9:3.16": "\"Kāyena phoṭṭhabbaṃ phusatīti.\" 5. ",
  "kv18.9:4.1": "Na vattabbaṃ ",
  "kv18.9:4.2": "\"Cakkhunā rūpaṃ passatīti --pe-- ",
  "kv18.9:4.3": "kāyena phoṭṭhabbaṃ phusatīti\"? ",
  "kv18.9:4.4": "Āmantā. ",
  "kv18.9:4.5": "Nanu vuttaṃ Bhagavatā -- ",
  "kv18.9:4.6": "\"Idha Bhikkhave bhikkhu cakkhunā rūpaṃ passati --pe-- ",
  "kv18.9:4.7": "kāyena phoṭṭhabbaṃ phusatīti.\" ",
  "kv18.9:4.8": "Atth' eva suttanto ti? ",
  "kv18.9:4.9": "Āmantā. ",
  "kv18.9:4.10": "Tena hi cakkhunā rūpaṃ passatīti --pe-- ",
  "kv18.9:4.11": "kāyena phoṭṭhabbaṃ phusatīti. ",
  "kv18.9:4.12": "Cakkhunā rūpaṃ passatīti kathā. ",
  "kv18.9:4.13": "",
  "kv18.9:4.14": "",
  "kv18.9:5.1": "Buddho Bhagavā manussaloke aṭṭhāsi, ",
  "kv18.9:5.2": "Buddhena Bhagavatā Dhammo desito, ",
  "kv18.9:5.3": "N' atthi Buddhassa Bhagavato karuṇā, ",
  "kv18.9:5.4": "Buddhassa Bhagavato uccārapassāvo ativiya aññe gandhajāte adhigaṇhāti, ",
  "kv18.9:5.5": "Ekena ariyamaggena cattāri sāmaññaphalāni sacchikaroti, ",
  "kv18.9:5.6": "Jhānā jhānaṃ saṃkamati, ",
  "kv18.9:5.7": "Atthi jhānantarikā, ",
  "kv18.9:5.8": "Samāpanno saddaṃ suṇāti, ",
  "kv18.9:5.9": "Cakkhunā rūpam passati, ",
  "kv18.9:5.10": "Kāyena phoṭṭhabbaṃ phusatīti. 1. "
}
