  "kv19.5:1.1": "Sabbadhammānaṃ tathatā asaṃkhatā ti? ",
  "kv19.5:1.2": "Āmantā. ",
  "kv19.5:1.3": "Nibbānaṃ tāṇaṃ leṇaṃ saraṇaṃ parāyanaṃ accutaṃ ",
  "kv19.5:1.4": "amatan ti? ",
  "kv19.5:1.5": "Na h' evaṃ vattabbe --pe-- ",
  "kv19.5:1.6": "Sabbadhammānaṃ tathatā asaṃkhatā, nibbānaṃ asaṃkhatan ti? ",
  "kv19.5:1.7": "Āmantā. ",
  "kv19.5:1.8": "Dve asaṃkhatānīti? ",
  "kv19.5:1.9": "Na h' evaṃ vattabbe --pe-- ",
  "kv19.5:1.10": "Dve asaṃkhatānīti? ",
  "kv19.5:1.11": "Āmantā. ",
  "kv19.5:1.12": "Dve tāṇāni --pe-- ",
  "kv19.5:1.13": "antarīkā vā ti? ",
  "kv19.5:1.14": "Na h' evaṃ vattabbe --pe-- 2. ",
  "kv19.5:2.1": "Rūpassa rūpatā, nanu rūpatā asaṃkhatā ti? ",
  "kv19.5:2.2": "Āmantā. ",
  "kv19.5:2.3": "Nibbānaṃ tāṇaṃ leṇaṃ saraṇaṃ parāyanaṃ accutaṃ ",
  "kv19.5:2.4": "amatan ti? ",
  "kv19.5:2.5": "Na h' evaṃ vattabbe --pe-- ",
  "kv19.5:2.6": "Rūpassa rūpatā, nanu rūpatā asaṃkhatā ti? ",
  "kv19.5:2.7": "Āmantā. ",
  "kv19.5:2.8": "Dve asaṃkhatānīti? ",
  "kv19.5:2.9": "Na h' evaṃ vattabbe --pe-- ",
  "kv19.5:2.10": "Dve asaṃkhatānīti? ",
  "kv19.5:2.11": "Āmantā. ",
  "kv19.5:2.12": "Dve tāṇāni --pe-- ",
  "kv19.5:2.13": "antarīkā vā ti? ",
  "kv19.5:2.14": "Na h' evaṃ vattabbe --pe-- 3. ",
  "kv19.5:3.1": "Vedanāya vedanāta, nanu vedanatā --pe-- ",
  "kv19.5:3.2": "saññāya saññatā, nanu saññatā --pe-- ",
  "kv19.5:3.3": "saṃkhārānaṃ saṃkhāratā, nanu saṃkhāratā --pe-- ",
  "kv19.5:3.4": "viññāṇassa viññāṇatā, nanu viññāṇatā asaṃkhatā ti? ",
  "kv19.5:3.5": "Āmantā. ",
  "kv19.5:3.6": "Nibbānaṃ tāṇam leṇaṃ saraṇaṃ parāyanaṃ accutaṃ ",
  "kv19.5:3.7": "amatan ti? ",
  "kv19.5:3.8": "Na h' evaṃ vattabbe --pe-- ",
  "kv19.5:4.1": "Viññāṇassa viññāṇatā, nanu rūpatā asaṃkhatā ",
  "kv19.5:4.2": "ti? ",
  "kv19.5:4.3": "Āmantā. ",
  "kv19.5:4.4": "Cha asaṃkhatānīti? ",
  "kv19.5:4.5": "Na h' evaṃ vattabbe --pe-- ",
  "kv19.5:4.6": "Cha asaṃkhatānīti? ",
  "kv19.5:4.7": "Āmantā. ",
  "kv19.5:4.8": "Cha tāṇāni --pe-- ",
  "kv19.5:4.9": "antarīkā vā ti? ",
  "kv19.5:4.10": "Na h' evaṃ vattabbe --pe-- 4. ",
  "kv19.5:5.1": "Na vattabbaṃ ",
  "kv19.5:5.2": "\"Sabbadhammānaṃ tathatā asaṃkhatā ti\"? ",
  "kv19.5:5.3": "Āmantā. ",
  "kv19.5:5.4": "Sabbadhammānaṃ tathatā rūpaṃ ",
  "kv19.5:5.5": "vedanā ",
  "kv19.5:5.6": "saññā ",
  "kv19.5:5.7": "saṃkhārā ",
  "kv19.5:5.8": "viññāṇan ti? ",
  "kv19.5:5.9": "Āmantā. ",
  "kv19.5:5.10": "Tena hi sabbadhammānaṃ tathatā asaṃkhatā ti. Tathatā kathā. 1. ",
  "kv19.5:5.11": ""
}
