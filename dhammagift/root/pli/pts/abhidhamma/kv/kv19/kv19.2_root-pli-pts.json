{
  "kv19.2:0.1": "",
  "kv19.2:0.2": "",
  "kv19.2:0.3": "",
  "kv19.2:0.4": "",
  "kv19.2:1.1": "Suññatā saṃkhārakkhandhapariyāpannā ti? ",
  "kv19.2:1.2": "Āmantā. ",
  "kv19.2:1.3": "Animittaṃ saṃkhārakkhandhapariyāpannan ti? ",
  "kv19.2:1.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv19.2:1.5": "Suññatā saṃkhārakkhandhapariyāpannā ti? ",
  "kv19.2:1.6": "Āmantā. ",
  "kv19.2:1.7": "Appaṇihito saṃkhārakkhandhapariyāpanno ti? ",
  "kv19.2:1.8": "Na h' evaṃ vattabbe --pe-- 2. ",
  "kv19.2:1.9": "Animittaṃ na vattabbaṃ ",
  "kv19.2:1.10": "\"saṃkhārakkhandhapariyāpannan ti\"? ",
  "kv19.2:1.11": "Āmantā. ",
  "kv19.2:1.12": "Suññatā na vattabbā ",
  "kv19.2:1.13": "\"saṃkhārakkhandhapariyāpannā ti\"? ",
  "kv19.2:1.14": "Na h' evaṃ vattabbe --pe-- ",
  "kv19.2:1.15": "Appaṇihito na vattabbo ",
  "kv19.2:1.16": "\"saṃkhārakkhandhapariyāpanno ti\"? ",
  "kv19.2:1.17": "Āmantā. ",
  "kv19.2:1.18": "Suññatā na vattabbā ",
  "kv19.2:1.19": "\"saṃkhārakkhandhapariyāpannā ti\"? ",
  "kv19.2:1.20": "Na h' evaṃ vattabbe --pe-- 3. ",
  "kv19.2:2.1": "Suññatā saṃkhārakkhandhapariyāpannā ti? ",
  "kv19.2:2.2": "Āmantā. ",
  "kv19.2:2.3": "Saṃkhārakkhandho na anicco na saṃkhato na paṭiccasamuppanno na khayadhammo na vayadhammo na virāgadhammo na nirodhadhammo na vipariṇāmadhammo ti? ",
  "kv19.2:2.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv19.2:2.5": "Nanu saṃkhārakkhandho anicco saṃkhato paṭiccasamuppanno khayadhammo vayadhammo virāgadhammo nirodhadhammo vipariṇāmadhammo ti? ",
  "kv19.2:2.6": "Āmantā. ",
  "kv19.2:2.7": "Hañci saṃkhārakkhandho anicco --pe-- ",
  "kv19.2:2.8": "vipariṇāmadhammo, no vata re vattabbe ",
  "kv19.2:2.9": "\"Suññatā saṃkhārakkhandhapariyāpannā ti.\" 4. ",
  "kv19.2:3.1": "Rūpakkhandhassa suññatā saṃkhārakkhandhapariyāpannā ti? ",
  "kv19.2:3.2": "Āmantā. ",
  "kv19.2:3.3": "Saṃkhārakkhandhassa suññatā rūpakkhandhapariyāpannā ti? ",
  "kv19.2:3.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv19.2:3.5": "Vedanā --pe-- ",
  "kv19.2:3.6": "saññā --pe-- ",
  "kv19.2:3.7": "viññāṇakkhandhassa suññatā saṃkhārakkhandhapariyāpannā ti? ",
  "kv19.2:3.8": "Āmantā. ",
  "kv19.2:3.9": "Saṃkhārakkhandhassa suññatā viññāṇakkhandhapariyāpannā ti? ",
  "kv19.2:3.10": "Na h' evaṃ vattabbe --pe-- 5. ",
  "kv19.2:4.1": "Saṃkharakkhandhassa suññatā na vattabbā ",
  "kv19.2:4.2": "\"rūpakkhandhapariyāpannā ti\"? ",
  "kv19.2:4.3": "Āmantā. ",
  "kv19.2:4.4": "Rūpakkhandhassa suññatā na vattabbā ",
  "kv19.2:4.5": "\"saṃkhārakkhandhapariyāpannā ti\"? ",
  "kv19.2:4.6": "Na h' evaṃ vattabbe --pe-- ",
  "kv19.2:4.7": "Saṃkhārakkhandhassa suññatā na vattabbā ",
  "kv19.2:4.8": "",
  "kv19.2:4.9": "",
  "kv19.2:4.10": "\"viññā ṇakkhandhapariyāpannā ti\"? ",
  "kv19.2:4.11": "Āmantā. ",
  "kv19.2:4.12": "Viññāṇakkhandhassa suññatā na vattabbā ",
  "kv19.2:4.13": "\"saṃkhārakkhandhapariyāpannā ti\"? ",
  "kv19.2:4.14": "Na h' evaṃ vattabbe --pe-- 6. ",
  "kv19.2:5.1": "Na vattabbaṃ ",
  "kv19.2:5.2": "\"Suññatā saṃkhārakkhandhapariyāpannā ti\"? ",
  "kv19.2:5.3": "Āmantā. ",
  "kv19.2:5.4": "Nanu vuttaṃ Bhagavatā -- ",
  "kv19.2:5.5": "\"Suññaṃ idaṃ Bhikkhave saṃkhārā attena vā attaniyena vā ti.\" ",
  "kv19.2:5.6": "Atth' eva suttanto ti? ",
  "kv19.2:5.7": "Āmantā. ",
  "kv19.2:5.8": "Tena hi suññatā saṃkhārakkhandhapariyāpannā ti. Suññatā kathā. 1. ",
  "kv19.2:5.9": ""
}
