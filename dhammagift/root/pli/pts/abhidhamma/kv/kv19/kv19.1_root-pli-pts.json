{
  "kv19.1:0.1": "",
  "kv19.1:0.2": "",
  "kv19.1:0.3": "",
  "kv19.1:0.4": "",
  "kv19.1:1.1": "Atīte kilese jahatīti? ",
  "kv19.1:1.2": "Āmantā. ",
  "kv19.1:1.3": "Niruddhaṃ nirodheti, vigataṃ vigameti, kīṇaṃ khepeti, atthaṅgataṃ atthaṅgameti, abbhatthaṅgataṃ abbhatthaṅgametīti? ",
  "kv19.1:1.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv19.1:1.5": "Atīte kilese jahatīti? ",
  "kv19.1:1.6": "Āmantā. ",
  "kv19.1:1.7": "Nanu atītaṃ niruddhan ti? ",
  "kv19.1:1.8": "Āmantā. ",
  "kv19.1:1.9": "Hañci atītaṃ niruddhaṃ, no vata re vattabbe ",
  "kv19.1:1.10": "\"Atīte kilese jahatīti.\" ",
  "kv19.1:1.11": "Atīte kilese jahatīti? ",
  "kv19.1:1.12": "Āmantā. ",
  "kv19.1:1.13": "Nanu atītaṃ n' atthīti? ",
  "kv19.1:1.14": "Āmantā. ",
  "kv19.1:1.15": "Hañci atītaṃ n' atthi, no vata re vattabbe ",
  "kv19.1:1.16": "\"Atīte kilese jahatīti.\" 2. ",
  "kv19.1:2.1": "Anāgate kilese jahatīti? ",
  "kv19.1:2.2": "Āmantā. ",
  "kv19.1:2.3": "Ajātaṃ ajaneti, asañjātaṃ asañjaneti, anibbattaṃ anibbattati, apātubhūtaṃ apātubhāvetīti? ",
  "kv19.1:2.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv19.1:2.5": "Anāgate kilese jahatīti? ",
  "kv19.1:2.6": "Āmantā. ",
  "kv19.1:2.7": "Nanu anāgataṃ ajātan ti? ",
  "kv19.1:2.8": "Āmantā. ",
  "kv19.1:2.9": "Hañci anāgataṃ ajātaṃ, no vata re vattabbe ",
  "kv19.1:2.10": "\"Anāgate kilese jahatīti.\" ",
  "kv19.1:2.11": "Anāgate kilese jahatīti? ",
  "kv19.1:2.12": "Āmantā. ",
  "kv19.1:2.13": "Nanu anāgataṃ n' atthīti? ",
  "kv19.1:2.14": "Āmantā. ",
  "kv19.1:2.15": "Hañci anāgataṃ n' atthi, no vata re vattabbe ",
  "kv19.1:2.16": "\"Anāgate kilese jahatīti.\" 3. ",
  "kv19.1:3.1": "Paccuppanne kilese jahatīti? ",
  "kv19.1:3.2": "Āmantā. ",
  "kv19.1:3.3": "Ratto rāgaṃ jahati, duṭṭho dosaṃ jahati, mūḷho mohaṃ jahati, kiliṭṭho kilese jahatīti? ",
  "kv19.1:3.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv19.1:3.5": "Rāgena rāgaṃ jahati, dosena dosaṃ jahati, mohena mohaṃ jahati, kilesehi kilese jahatīti? ",
  "kv19.1:3.6": "Na h' evaṃ vattabbe --pe-- ",
  "kv19.1:4.1": "Rāgo cittasampayutto, maggo cittasampayutto ti? ",
  "kv19.1:4.2": "Āmantā. Dvinnaṃ phassānaṃ --pe-- ",
  "kv19.1:4.3": "dvinnaṃ cittānaṃ samodhānaṃ hotīti? ",
  "kv19.1:4.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv19.1:5.1": "Rāgo akusalo, maggo kusalo ti? ",
  "kv19.1:5.2": "Āmantā. ",
  "kv19.1:5.3": "Kusalākusalā sāvajjānavajjā hīnappaṇītā kaṇhasukkasappaṭibhāgā dhammā sammukhībhāvaṃ āgacchantīti? ",
  "kv19.1:5.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv19.1:6.1": "Kusalākusalā savajjānavajjā hīnappaṇītā kaṇhasukkasappaṭibhāgā dhammā sammukhībhāvaṃ āgacchantīti? ",
  "kv19.1:6.2": "Āmantā. ",
  "kv19.1:6.3": "Nanu vuttaṃ Bhagavatā -- ",
  "kv19.1:6.4": "\"Cattār' imāni Bhikkhave suvidūravidūrāni. ",
  "kv19.1:6.5": "Katamāni cattāri? ",
  "kv19.1:6.6": "Nabhañ ca Bhikkhave pathavī ca, ",
  "kv19.1:6.7": "idaṃ paṭhamaṃ suvidūravidūraṃ --pe-- tasmā sataṃ dhammo asabbhi ārakā ti.\" ",
  "kv19.1:6.8": "Atth' eva suttanto ti? ",
  "kv19.1:6.9": "Āmantā. ",
  "kv19.1:6.10": "Tena hi na vattabbaṃ ",
  "kv19.1:6.11": "\"Kusalākusalā --pe-- ",
  "kv19.1:6.12": "āgacchantīti.\" 4. ",
  "kv19.1:7.1": "Na vattabbaṃ ",
  "kv19.1:7.2": "\"Atīte anāgate paccuppanne kilese jahatīti.\" ",
  "kv19.1:7.3": "Āmantā. ",
  "kv19.1:7.4": "N' atthi kilesajahanā ti? ",
  "kv19.1:7.5": "Na h' evaṃ vattabbe --pe-- ",
  "kv19.1:7.6": "Tena hi atīte anāgate paccuppanne kilese jahatīti. ",
  "kv19.1:7.7": "Kilesajahanakathā. 1. "
}
