  "kv21.3:0.4": "",
  "kv21.3:1.1": "Atthi kiñci saññojanaṃ appahāya arahattappattīti? ",
  "kv21.3:1.2": "Āmantā. ",
  "kv21.3:1.3": "Atthi kiñci sakkāyadiṭṭhiṃ appahāya --pe-- ",
  "kv21.3:1.4": "vicikicchaṃ ",
  "kv21.3:1.5": "sīlabbataparāmāsaṃ ",
  "kv21.3:1.6": "rāgaṃ ",
  "kv21.3:1.7": "dosaṃ ",
  "kv21.3:1.8": "mohaṃ ",
  "kv21.3:1.9": "anottappaṃ appahāya arahattappattīti? ",
  "kv21.3:1.10": "Na h' evaṃ vattabbe --pe-- 2. ",
  "kv21.3:2.1": "Atthi kiñci saññojanaṃ appahāya arahattappattīti? ",
  "kv21.3:2.2": "Āmantā. ",
  "kv21.3:2.3": "Arahā sarāgo sadoso samoho samāno samakkho sapaḷāso sa-upāyāso sakileso ti? ",
  "kv21.3:2.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv21.3:2.5": "Nanu Arahā nirāgo niddoso nimmoho nimmāno nimmakkho nippaḷāso nirūpāyāso nikkileso ti? ",
  "kv21.3:2.6": "Āmantā. ",
  "kv21.3:2.7": "Hañci Arahā nirāgo niddoso nimmoho nimmāno nimmakkho nippaḷāso nirūpāyāso ",
  "kv21.3:2.8": "nikkileso, no vata re vattabbe ",
  "kv21.3:2.9": "\"Atthi kiñci saññojanaṃ appahāya arahattappattīti.\" 3. ",
  "kv21.3:3.1": "Na vattabbaṃ \"Atthi ",
  "kv21.3:3.2": "kiñci saññojanaṃ appahāya Arahattapattīti\"? ",
  "kv21.3:3.3": "Āmantā. ",
  "kv21.3:3.4": "Arahā sabbaṃ Buddhavisayaṃ jānātīti? ",
  "kv21.3:3.5": "Na h' evaṃ vattabbe --pe-- ",
  "kv21.3:3.6": "Tena hi atthi kiñci saññojanaṃ appahāya Arahattappattīti. ",
  "kv21.3:3.7": "Saññojanakathā. 1. "
}
