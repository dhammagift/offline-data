  "kv21.7:1.1": "Sabbe dhammā niyatā ti? ",
  "kv21.7:1.2": "Āmantā. ",
  "kv21.7:1.3": "Micchattaniyatā ti? ",
  "kv21.7:1.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv21.7:1.5": "Sammattaniyatā ti? ",
  "kv21.7:1.6": "Na h' evaṃ vattabbe --pe-- ",
  "kv21.7:1.7": "N' atthi aniyato rāsīti? ",
  "kv21.7:1.8": "Na h' evaṃ vattabbe --pe-- ",
  "kv21.7:1.9": "Nanu atthi aniyato rāsīti? ",
  "kv21.7:1.10": "Āmantā. ",
  "kv21.7:1.11": "Hañci atthi aniyato rāsi, no vata re vattabbe ",
  "kv21.7:1.12": "\"Sabbe dhammā niyatā ti.\" 2. ",
  "kv21.7:2.1": "Sabbe dhammā niyatā ti? ",
  "kv21.7:2.2": "Āmantā. ",
  "kv21.7:2.3": "Nanu tayo rāsī vuttā Bhagavatā -- ",
  "kv21.7:2.4": "micchattaniyato rāsi, sammattaniyato rāsi, aniyato rāsīti? ",
  "kv21.7:2.5": "Āmantā. ",
  "kv21.7:2.6": "Hañci tayo rāsī vuttā Bhagavatā -- ",
  "kv21.7:2.7": "micchattaniyato rāsi, sammattaniyato rāsi, aniyato rāsi, no vata re vattabbe ",
  "kv21.7:2.8": "\"Sabbe dhammā niyatā ti.\" 3. ",
  "kv21.7:3.1": "Rūpaṃ rūpaṭṭhena niyatan ti? ",
  "kv21.7:3.2": "Āmantā. ",
  "kv21.7:3.3": "Micchattaniyatan ti? ",
  "kv21.7:3.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv21.7:3.5": "Sammattaniyatan ti? ",
  "kv21.7:3.6": "Na h' evaṃ vattabbe --pe-- ",
  "kv21.7:3.7": "Vedanā --pe-- ",
  "kv21.7:3.8": "saññā --pe-- ",
  "kv21.7:3.9": "saṃkhārā --pe-- ",
  "kv21.7:3.10": "viññāṇaṃ viññāṇaṭṭhena niyatan ti? ",
  "kv21.7:3.11": "Āmantā. ",
  "kv21.7:3.12": "Micchattaniyatan ti? ",
  "kv21.7:3.13": "Na h' evaṃ vattabbe --pe-- ",
  "kv21.7:3.14": "Sammattaniyatan ti? ",
  "kv21.7:3.15": "Na h' evaṃ vattabbe --pe-- 4. ",
  "kv21.7:4.1": "Na vattabbaṃ ",
  "kv21.7:4.2": "\"Rūpaṃ rūpaṭṭhena niyataṃ --pe-- ",
  "kv21.7:4.3": "vedanā --pe-- ",
  "kv21.7:4.4": "saññā --pe-- ",
  "kv21.7:4.5": "saṃkhārā --pe-- ",
  "kv21.7:4.6": "viññāṇaṃ viññānaṭṭhena niyatan ti\"? ",
  "kv21.7:4.7": "Āmantā. ",
  "kv21.7:4.8": "Rūpaṃ hoti, vedanā hoti, ",
  "kv21.7:4.9": "saññā hoti, ",
  "kv21.7:4.10": "saṃkhārā honti, ",
  "kv21.7:4.11": "viññāṇaṃ hoti, ",
  "kv21.7:4.12": "vedanā, ",
  "kv21.7:4.13": "saññā, saṃkhārā, ",
  "kv21.7:4.14": "",
  "kv21.7:4.15": "viññāṇaṃ rūpaṃ hoti, ",
  "kv21.7:4.16": "vedanā hoti, ",
  "kv21.7:4.17": "saññā hoti, ",
  "kv21.7:4.18": "saṃkhārā hontīti? ",
  "kv21.7:4.19": "Na h' evaṃ vattabbe --pe-- ",
  "kv21.7:4.20": "Tena hi rūpaṃ rūpaṭṭhena niyataṃ, vedanā, ",
  "kv21.7:4.21": "saññā, saṃkhārā, ",
  "kv21.7:4.22": "",
  "kv21.7:4.23": "viññāṇaṃ viññāṇaṭṭhena niyatan ti. ",
  "kv21.7:4.24": "Dhammakathā. 1. "
}
