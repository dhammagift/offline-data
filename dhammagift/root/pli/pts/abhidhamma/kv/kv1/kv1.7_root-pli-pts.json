  "kv1.7:15.3": "Atītaṃ viññāṇaṃ khandho atītaṃ viññāṇaṃ atthīti? ",
  "kv1.7:15.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv1.7:15.5": "Paccuppannaṃ viññāṇaṃ āyatanaṃ --pe-- ",
  "kv1.7:15.6": "paccuppannaṃ viññāṇaṃ dhātu --pe-- ",
  "kv1.7:15.7": "paccuppannaṃ viññāṇaṃ khandhādhātuāyatanaṃ, paccuppannaṃ viññāṇaṃ atthīti? ",
  "kv1.7:15.8": "Āmantā. ",
  "kv1.7:15.9": "Atītaṃ viññāṇaṃ khandhādhātuāyatanaṃ atītaṃ viññāṇaṃ atthīti? ",
  "kv1.7:15.10": "Na h' evaṃ vattabbe --pe-- 16. ",
  "kv1.7:16.1": "Paccuppannaṃ viññāṇaṃ khandho, paccuppannaṃ viññāṇaṃ atthīti? ",
  "kv1.7:16.2": "Āmantā. ",
  "kv1.7:16.3": "Anāgataṃ viññāṇaṃ khandho, anāgataṃ viññāṇaṃ atthīti? ",
  "kv1.7:16.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv1.7:16.5": "Paccuppannaṃ viññāṇaṃ āyatanaṃ --pe-- ",
  "kv1.7:16.6": "paccuppannaṃ viññāṇaṃ dhātu --pe-- ",
  "kv1.7:16.7": "paccuppannaṃ viññāṇaṃ khandhādhātuāyatanaṃ, paccuppannaṃ viññāṇaṃ atthīti? ",
  "kv1.7:16.8": "Āmantā. ",
  "kv1.7:16.9": "Anāgataṃ viññāṇaṃ khandhādhātuāyatanaṃ, anāgataṃ viññāṇaṃ atthīti? ",
  "kv1.7:16.10": "Na h' evaṃ vattabbe --pe-- 17. ",
  "kv1.7:17.1": "Atītaṃ viññāṇaṃ khandho, atītaṃ viññāṇaṃ n' atthīti? ",
  "kv1.7:17.2": "Āmantā. ",
  "kv1.7:17.3": "Paccuppannaṃ viññāṇaṃ khandho, paccuppannaṃ viññāṇaṃ n' atthīti? ",
  "kv1.7:17.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv1.7:17.5": "Atītaṃ viññāṇaṃ āyatanaṃ --pe-- ",
  "kv1.7:17.6": "atītaṃ viññāṇaṃ dhātu --pe-- ",
  "kv1.7:17.7": "atītaṃ viññāṇaṃ khandhādhātuāyatanaṃ, atītaṃ viññāṇaṃ n' atthīti? ",
  "kv1.7:17.8": "Āmantā. ",
  "kv1.7:17.9": "Paccuppannaṃ viññāṇaṃ khandhādhātuāyatanaṃ , paccuppannaṃ viññāṇaṃ n' atthīti? ",
  "kv1.7:17.10": "Na h' evaṃ vattabbe --pe-- 18. ",
  "kv1.7:17.11": "Anāgataṃ viññāṇaṃ khandho, anāgataṃ viññāṇaṃ n' atthīti? ",
  "kv1.7:17.12": "Āmantā. ",
  "kv1.7:17.13": "Paccuppannaṃ viññāṇaṃ khandho, paccuppannaṃ viññāṇaṃ n' atthīti? ",
  "kv1.7:17.14": "Na h' evaṃ vattabbe --pe-- ",
  "kv1.7:17.15": "Anāgataṃ viññāṇaṃ āyatanaṃ --pe-- ",
  "kv1.7:17.16": "anāgataṃ viññāṇaṃ dhātu --pe-- ",
  "kv1.7:17.17": "anāgataṃ viññāṇaṃ khandhādhātuāyatanaṃ, anāgataṃ viññāṇaṃ n' atthīti? ",
  "kv1.7:17.18": "Āmantā. ",
  "kv1.7:17.19": "Paccuppannaṃ viññāṇaṃ khandhādhātuāyatanaṃ, paccuppannaṃ viññāṇaṃ n' atthīti? ",
  "kv1.7:17.20": "Na h' evaṃ vattabbe --pe-- 19. ",
  "kv1.7:18.0": "",
  "kv1.7:18.1": "Na vattabbaṃ ",
  "kv1.7:18.2": "\"Atītānāgatā khandhādhātuāyatanaṃ n' atthi c' ete ti\"? ",
  "kv1.7:18.3": "Āmantā. ",
  "kv1.7:18.4": "Nanu vuttaṃ Bhagavatā ",
  "kv1.7:18.5": "\"Tayo 'me Bhikkhave niruttipathā adhivacanapathā paññattipathā --pe-- viññūhīti.\" ",
  "kv1.7:18.6": "Atth' eva suttanto ti? ",
  "kv1.7:18.7": "Āmantā. ",
  "kv1.7:18.8": "Tena hi na vattabbaṃ ",
  "kv1.7:18.9": "\"Atītānāgatā khandhādhātuāyatanaṃ n' atthi c' ete ti.\" 20. ",
  "kv1.7:19.1": "Atītānāgatā khandhādhātuāyatanaṃ n' atthi c' ete ti? ",
  "kv1.7:19.2": "Āmantā. ",
  "kv1.7:19.3": "Nanu vuttaṃ Bhagavatā -- ",
  "kv1.7:19.4": "\"Yaṃ kiñci Bhikkhave rūpaṃ atītānāgatapaccuppannaṃ ajjhattaṃ vā bahiddhā vā oḷārikaṃ vā sukhumaṃ vā hīnaṃ vā paṇītaṃ vā yaṃ dure santike vā, ayaṃ vuccati rūpakkhandho, ",
  "kv1.7:19.5": "yā kāci vedanā, ",
  "kv1.7:19.6": "yā kāci saññā, ",
  "kv1.7:19.7": "ye keci saṃkhārā, ",
  "kv1.7:19.8": "yaṃ kiñci viññāṇaṃ atītānāgatapaccuppannaṃ ajjhattaṃ vā bahiddhā vā oḷārikaṃ vā sukhumaṃ vā hīnaṃ vā paṇītaṃ vā yaṃ dure santike vā, ",
  "kv1.7:19.9": "ayaṃ vuccati viññāṇakkhandho ti.\" ",
  "kv1.7:19.10": "Atth' eva suttanto ti? ",
  "kv1.7:19.11": "Āmantā. ",
  "kv1.7:19.12": "Tena hi na vattabbaṃ ",
  "kv1.7:19.13": "\"Atītānāgatā khandhādhātuāyatanaṃ n' atthi c' ete ti.\" Atītaṃ khandhā ti kathā I.8. 1. ",
  "kv1.7:19.14": ""
}
