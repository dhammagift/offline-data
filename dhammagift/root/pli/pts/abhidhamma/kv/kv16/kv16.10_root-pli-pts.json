  "kv16.10:1.1": "Rūparāgo rūpadhātupariyāpanno ti? ",
  "kv16.10:1.2": "Āmantā. ",
  "kv16.10:1.3": "Samāpattesiyo uppattesiyo diṭṭhadhammasukhavihāro samāpattesiyena cittena uppattesiyena cittena diṭṭhadhammasukhavihārena cittena sahagato sahajāto saṃsaṭṭho sampayutto ekuppādo ekanirodho ekavatthuko ekārammaṇo ti? ",
  "kv16.10:1.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv16.10:1.5": "Nanu na samāpattesiyo na uppattesiyo na diṭṭhadhammasukhavihāro na samāpattesiyena cittena na uppattesiyena cittena na diṭṭhadhammasukhavihārena cittena sahagato --pe-- ekārammaṇo ti? ",
  "kv16.10:1.6": "Āmantā. ",
  "kv16.10:1.7": "Hañci na samāpattesiyo --pe-- ekārammaṇo, no vata re vattabbe ",
  "kv16.10:1.8": "\"Rūparāgo rūpadhātupariyāpanno ti.\" 2. ",
  "kv16.10:2.1": "Rūparāgo rūpadhātupariyāpanno ti? ",
  "kv16.10:2.2": "Āmantā. ",
  "kv16.10:2.3": "Saddarāgo saddadhātupariyāpanno ti? ",
  "kv16.10:2.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv16.10:2.5": "Rūparāgo rūpadhātupariyāpanno ti? ",
  "kv16.10:2.6": "Āmantā. ",
  "kv16.10:2.7": "Gandharāgo --pe-- ",
  "kv16.10:2.8": "rasarāgo --pe-- ",
  "kv16.10:2.9": "phoṭṭhabbarāgo phoṭṭhabbadhātupariyāpanno ti? ",
  "kv16.10:2.10": "Na h' evaṃ vattabbe --pe-- 3. ",
  "kv16.10:3.1": "Saddarāgo na vattabbaṃ ",
  "kv16.10:3.2": "\"saddadhātupariyāpanno ti\"? ",
  "kv16.10:3.3": "Āmantā. ",
  "kv16.10:3.4": "Rūparāgo na vattabbaṃ ",
  "kv16.10:3.5": "\"rūpadhātupariyāpanno ti\"? ",
  "kv16.10:3.6": "Na h' evaṃ vattabbe --pe-- ",
  "kv16.10:3.7": "Gandharāgo --pe-- ",
  "kv16.10:3.8": "rasarāgo --pe-- ",
  "kv16.10:3.9": "phoṭṭhabbarāgo na vattabbaṃ ",
  "kv16.10:3.10": "\"phoṭṭhabbadhātupariyāpanno ti\"? ",
  "kv16.10:3.11": "Āmantā. ",
  "kv16.10:3.12": "Rūparāgo na vattabbaṃ ",
  "kv16.10:3.13": "\"rūpadhātupariyāpanno ti\"? ",
  "kv16.10:3.14": "Na h' evaṃ vattabbe --pe-- 4. ",
  "kv16.10:4.1": "Arūparāgo ",
  "kv16.10:4.2": "",
  "kv16.10:4.3": "",
  "kv16.10:4.4": "",
  "kv16.10:4.5": "",
  "kv16.10:4.6": "arūpadhātupariyāpanno ti? ",
  "kv16.10:4.7": "Āmantā. ",
  "kv16.10:4.8": "Samāpattesiyo uppattesiyo diṭṭhadhammasukhavihāro samāpattesiyena cittena uppattesiyena cittena diṭṭhadhammasukhavihārena cittena sahagato sahajāto saṃsaṭṭho sampayutto ekuppādo ekanirodho ekavatthuko ekārammaṇo ti? ",
  "kv16.10:4.9": "Na h' evaṃ vattabbe --pe-- ",
  "kv16.10:4.10": "Nanu na samāpattesiyo na uppattesiyo na diṭṭhadhammasukhavihāro na samāpattesiyena cittena na uppattesiyena cittena na diṭṭhadhammasukhavihārena cittena sahagato --pe-- ekārammaṇo ti? ",
  "kv16.10:4.11": "Āmantā. ",
  "kv16.10:4.12": "Hañci na samāpattesiyo --pe-- ekārammaṇo, no vata re vattabbe ",
  "kv16.10:4.13": "\"Arūparāgo arūpadhātupariyāpanno ti.\" 5. ",
  "kv16.10:5.1": "Arūparāgo arūpadhātupariyāpanno ti? ",
  "kv16.10:5.2": "Āmantā. ",
  "kv16.10:5.3": "Saddarāgo saddadhātupariyāpanno ti? ",
  "kv16.10:5.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv16.10:5.5": "Arūparāgo arūpadhātupariyāpanno ti? ",
  "kv16.10:5.6": "Āmantā. ",
  "kv16.10:5.7": "Gandharāgo --pe-- ",
  "kv16.10:5.8": "rasarāgo --pe-- ",
  "kv16.10:5.9": "phoṭṭhabbarāgo phoṭṭhabbadhātupariyāpanno ti? ",
  "kv16.10:5.10": "Na h' evaṃ vattabbe --pe-- 6. ",
  "kv16.10:6.1": "Saddarāgo na vattabbaṃ ",
  "kv16.10:6.2": "\"Saddadhātupariyāpanno ti\"? ",
  "kv16.10:6.3": "Āmantā. ",
  "kv16.10:6.4": "Arūparāgo na vattabbaṃ ",
  "kv16.10:6.5": "\"arūpadhātupariyāpanno ti\"? ",
  "kv16.10:6.6": "Na h' evaṃ vattabbe --pe-- ",
  "kv16.10:6.7": "Gandharāgo --pe-- ",
  "kv16.10:6.8": "rasarāgo -- Pe -- ",
  "kv16.10:6.9": "phoṭṭhabbarāgo na vattabbaṃ ",
  "kv16.10:6.10": "\"phoṭṭhabbadhātupariyāpanno ti\"? ",
  "kv16.10:6.11": "Āmantā. ",
  "kv16.10:6.12": "Arūparāgo na vattabbaṃ ",
  "kv16.10:6.13": "\"arūpadhātupariyāpanno ti\"? ",
  "kv16.10:6.14": "Na h' evaṃ vattabbe --pe-- 7. ",
  "kv16.10:7.1": "Na vattabbaṃ ",
  "kv16.10:7.2": "\"Rūparāgo rūpadhātupariyāpanno, arūparāgo arūpadhātupariyāpanno ti\"? ",
  "kv16.10:7.3": "Āmantā. ",
  "kv16.10:7.4": "Nanu kāmarāgo kāmadhātupariyāpanno ti? ",
  "kv16.10:7.5": "Āmantā. ",
  "kv16.10:7.6": "Hañci kāmarāgo kāmadhātupariyāpanno, tena vata re vattabbe ",
  "kv16.10:7.7": "\"Rūparāgo rūpadhātupariyāpanno, arūparāgo arūpadhātupariyāpanno ti.\" ",
  "kv16.10:7.8": "Rūparāgo rūpadhātupariyāpanno, arūparāgo arūpadhātupariyāpanno ti kathā. ",
  "kv16.10:7.9": "",
  "kv16.10:7.10": "",
  "kv16.10:7.11": "",
  "kv16.10:8.1": "Cittaniggaho, Cittapaggaho, Sukhānuppadānaṃ, Adhigayha manasikāro, Rūpaṃ hetu, Rūpaṃ sahetukaṃ, Rūpaṃ kusalaṃ pi akusalaṃ pi, Rūpaṃ vipāko, Atthi rūpaṃ rūpāvacaraṃ, Atthi rūpaṃ arūpāvacaraṃ, Sabbe kilesā kāmadhātupariyāpannā ti. 1. "
}
