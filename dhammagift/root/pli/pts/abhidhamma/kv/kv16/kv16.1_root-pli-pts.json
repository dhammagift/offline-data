{
  "kv16.1:0.1": "",
  "kv16.1:0.2": "",
  "kv16.1:0.3": "",
  "kv16.1:0.4": "",
  "kv16.1:1.1": "Paro parassa cittaṃ niggaṇhātīti? ",
  "kv16.1:1.2": "Āmantā. ",
  "kv16.1:1.3": "Paro parassa cittaṃ mā rajji mā dussi mā muyhi mā kilissīti niggaṇhātīti? ",
  "kv16.1:1.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv16.1:1.5": "Paro parassa cittaṃ niggaṇhātīti? ",
  "kv16.1:1.6": "Āmantā. ",
  "kv16.1:1.7": "Paro parassa uppanno phasso mā nirujjhīti niggaṇhātīti? ",
  "kv16.1:1.8": "Na h' evaṃ vattabbe --pe-- ",
  "kv16.1:1.9": "Paro parassa uppannā vedanā --pe-- ",
  "kv16.1:1.10": "uppannā saññā -- pe -- ",
  "kv16.1:1.11": "uppannā cetanā --pe-- ",
  "kv16.1:1.12": "uppannaṃ cittaṃ --pe-- ",
  "kv16.1:1.13": "uppannā saddhā --pe-- ",
  "kv16.1:1.14": "uppannaṃ viriyaṃ --pe-- ",
  "kv16.1:1.15": "uppannā sati -- ",
  "kv16.1:1.16": "pe--uppanno samādhi --pe-- ",
  "kv16.1:1.17": "uppannā paññā mā nirujjhīti niggaṇhātīti? ",
  "kv16.1:1.18": "Na h' evaṃ vattabbe --pe-- 2. ",
  "kv16.1:2.1": "Paro parassa cittaṃ niggaṇhātīti? ",
  "kv16.1:2.2": "Āmantā. ",
  "kv16.1:2.3": "Paro parassa atthāya rāgaṃ pajahati, ",
  "kv16.1:2.4": "dosaṃ pajahati --pe-- ",
  "kv16.1:2.5": "anottappaṃ pajahatīti? ",
  "kv16.1:2.6": "Na h' evaṃ vattabbe --pe-- ",
  "kv16.1:3.1": "Paro parassa cittaṃ niggaṇhātīti? ",
  "kv16.1:3.2": "Āmantā. ",
  "kv16.1:3.3": "Paro parassa atthāya maggaṃ bhāveti, ",
  "kv16.1:3.4": "satipaṭṭhānaṃ bhāveti --pe-- ",
  "kv16.1:3.5": "bojjhaṅgaṃ bhāvetīti? ",
  "kv16.1:3.6": "Na h' evaṃ vattabbe --pe-- ",
  "kv16.1:4.1": "Paro parassa cittaṃ niggaṇhātīti? ",
  "kv16.1:4.2": "Āmantā. ",
  "kv16.1:4.3": "Paro parassa atthāya dukkhaṃ parijānāti, samudayaṃ pajahati, nirodhaṃ sacchikaroti, maggaṃ bhāvetīti? ",
  "kv16.1:4.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv16.1:5.1": "Paro parassa cittaṃ niggaṇhātīti? ",
  "kv16.1:5.2": "Āmantā. ",
  "kv16.1:5.3": "Añño aññassa kārako, paraṃ kataṃ sukhaṃ dukkhaṃ añño karoti añño paṭisaṃvedetīti? ",
  "kv16.1:5.4": "Na h' evaṃ vattabbe --pe-- 3. ",
  "kv16.1:6.1": "Paro parassa cittaṃ niggaṇhātīti? ",
  "kv16.1:6.2": "Āmantā. ",
  "kv16.1:6.3": "Nanu vuttaṃ Bhagavatā -- ",
  "kv16.1:7.1": "\"Attanā va kataṃ pāpaṃ, ",
  "kv16.1:7.2": "attanā saṃkilissati, ",
  "kv16.1:7.3": "Attanā akataṃ pāpaṃ, ",
  "kv16.1:7.4": "attanā va visujjhati, ",
  "kv16.1:7.5": "Suddhi asuddhi paccattaṃ ",
  "kv16.1:7.6": "añño aññaṃ visodhaye ti.\" ",
  "kv16.1:8.1": "Atth' eva suttanto ti? ",
  "kv16.1:8.2": "Āmantā. ",
  "kv16.1:8.3": "Tena hi na vattabbaṃ ",
  "kv16.1:8.4": "\"Paro parassa cittaṃ niggaṇhātīti.\" 4. ",
  "kv16.1:9.1": "Na vattabbaṃ ",
  "kv16.1:9.2": "\"Paro parassa cittaṃ niggaṇhātīti\"? ",
  "kv16.1:9.3": "Āmantā. ",
  "kv16.1:9.4": "Nanu atthi balappattā atthi vasībhūtā ti? ",
  "kv16.1:9.5": "Āmantā. ",
  "kv16.1:9.6": "Hañci atthi balappattā atthi vasībhūtā, tena vata re vattabbe ",
  "kv16.1:9.7": "\"Paro parassa cittaṃ niggaṇhātīti.\" ",
  "kv16.1:9.8": "Niggahakathā. 1. "
}
