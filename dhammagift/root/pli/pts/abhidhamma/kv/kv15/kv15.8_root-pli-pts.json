  "kv15.8:1.1": "Saññāvedayitanirodhasamāpatti lokiyā ti? ",
  "kv15.8:1.2": "Āmantā. ",
  "kv15.8:1.3": "Rūpan ti? ",
  "kv15.8:1.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv15.8:1.5": "Vedanā ",
  "kv15.8:1.6": "saññā ",
  "kv15.8:1.7": "saṃkhārā ",
  "kv15.8:1.8": "viññāṇan ti? ",
  "kv15.8:1.9": "Na h' evaṃ vattabbe --pe-- ",
  "kv15.8:1.10": "Kāmāvacarā ti? ",
  "kv15.8:1.11": "Na h' evaṃ vattabbe --pe-- ",
  "kv15.8:1.12": "Rūpāvacarā ti? ",
  "kv15.8:1.13": "Na h' evaṃ vattabbe --pe-- ",
  "kv15.8:1.14": "Arūpāvacarā ti? ",
  "kv15.8:1.15": "Na h' evaṃ vattabbe --pe-- 2. ",
  "kv15.8:2.1": "Na vattabbaṃ ",
  "kv15.8:2.2": "\"Saññāvedayitanirodhasamāpatti lokiyā ti\"? ",
  "kv15.8:2.3": "Āmantā. ",
  "kv15.8:2.4": "Lokuttarā ti? ",
  "kv15.8:2.5": "Na h' evaṃ vattabbe --pe-- ",
  "kv15.8:2.6": "Tena hi lokiyā ti. ",
  "kv15.8:2.7": "Dutiyasaññāvedayitakathā. 1. Saññāvedayitanirodhasamāpanno "
