  "kv15.6:0.4": "",
  "kv15.6:1.1": "Lokuttarānaṃ dhammānaṃ jarāmaraṇaṃ lokuttaran ti? ",
  "kv15.6:1.2": "Āmantā. ",
  "kv15.6:1.3": "Maggo phalaṃ nibbānaṃ --pe-- bojjhaṅgo ti? ",
  "kv15.6:1.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv15.6:1.5": "Sotāpattimaggassa jarāmaraṇaṃ sotāpattimaggo ti? ",
  "kv15.6:1.6": "Na h' evaṃ vattabbe --pe-- ",
  "kv15.6:1.7": "Sotāpattimaggassa jarāmaraṇaṃ sotāpattimaggo ti? ",
  "kv15.6:1.8": "Āmantā. ",
  "kv15.6:1.9": "Sotāpattiphalassa jarāmaraṇaṃ sotāpattiphalan ti? ",
  "kv15.6:1.10": "Na h' evaṃ vattabbe --pe-- ",
  "kv15.6:1.11": "Sakadāgāmimaggassa --pe-- ",
  "kv15.6:1.12": "sakadāgāmiphalassa --pe-- ",
  "kv15.6:1.13": "anāgāmimaggassa --pe-- ",
  "kv15.6:1.14": "anāgāmiphalassa --pe-- ",
  "kv15.6:1.15": "arahattamaggassa jarāmaraṇaṃ arahattamaggo ti? ",
  "kv15.6:1.16": "Na h' evaṃ vattabbe --pe-- ",
  "kv15.6:1.17": "Arahattamaggassa jarāmaraṇaṃ arahattamaggo ti? ",
  "kv15.6:1.18": "Āmantā. ",
  "kv15.6:1.19": "Arahattaphalassa jarāmaraṇaṃ arahattaphalan ti? ",
  "kv15.6:1.20": "Na h' evaṃ vattabbe --pe-- ",
  "kv15.6:1.21": "Satipaṭṭhānānaṃ ",
  "kv15.6:1.22": "sammappadhānānaṃ ",
  "kv15.6:1.23": "iddhipādānaṃ ",
  "kv15.6:1.24": "indriyānaṃ ",
  "kv15.6:1.25": "balānaṃ ",
  "kv15.6:1.26": "bojjhaṅgānaṃ jarāmaraṇaṃ bojjhaṅgo ti? ",
  "kv15.6:1.27": "Na h' evaṃ vattabbe --pe-- 2. ",
  "kv15.6:2.1": "Na vattabbaṃ ",
  "kv15.6:2.2": "\"Lokuttarānaṃ dhammānaṃ jarāmaraṇaṃ lokuttaran ti\"? ",
  "kv15.6:2.3": "Āmantā. ",
  "kv15.6:2.4": "Lokiyan ti? ",
  "kv15.6:2.5": "Na h' evaṃ vattabbe --pe-- ",
  "kv15.6:2.6": "Tena hi lokuttaran ti. ",
  "kv15.6:2.7": "Jarāmaraṇakathā. 1. "
}
