  "kv15.7:1.1": "Saññāvedayitanirodhasamāpatti lokuttarā ti? ",
  "kv15.7:1.2": "Āmantā. ",
  "kv15.7:1.3": "Maggo phalaṃ nibbānaṃ --pe-- bojjhaṅgo ti? ",
  "kv15.7:1.4": "Na h' evaṃ vattabbe --pe-- 2. ",
  "kv15.7:2.1": "Na vattabbaṃ ",
  "kv15.7:2.2": "\"Saññāvedayitanirodhasamāpatti lokuttarā ti\"? ",
  "kv15.7:2.3": "Āmantā. ",
  "kv15.7:2.4": "Lokiyā ti? ",
  "kv15.7:2.5": "Na h' evaṃ vattabbe --pe-- ",
  "kv15.7:2.6": "Tena hi lokuttarā ti. ",
  "kv15.7:2.7": "Saññāvedayitakathā. 1. "
}
