  "kv15.3:0.4": "",
  "kv15.3:1.1": "Addhā parinipphanno ti? ",
  "kv15.3:1.2": "Āmantā. ",
  "kv15.3:1.3": "Rūpan ti? ",
  "kv15.3:1.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv15.3:1.5": "Vedanā --pe-- ",
  "kv15.3:1.6": "saññā --pe-- ",
  "kv15.3:1.7": "saṃkhārā --pe-- ",
  "kv15.3:1.8": "viññāṇan ti? ",
  "kv15.3:1.9": "Na h' evaṃ vattabbe --pe-- ",
  "kv15.3:1.10": "Atīto addhā parinipphanno ti? ",
  "kv15.3:1.11": "",
  "kv15.3:1.12": "Rūpan ti? ",
  "kv15.3:1.13": "Na h' evaṃ vattabbe --pe-- ",
  "kv15.3:1.14": "Vedanā --pe-- ",
  "kv15.3:1.15": "saññā --pe-- ",
  "kv15.3:1.16": "saṃkhārā --pe-- ",
  "kv15.3:1.17": "viññāṇan ti? ",
  "kv15.3:1.18": "Na h' evaṃ vattabbe --pe-- 2. ",
  "kv15.3:1.19": "Anāgato addhā parinipphanno ti? ",
  "kv15.3:1.20": "Āmantā. ",
  "kv15.3:1.21": "Rūpan ti? ",
  "kv15.3:1.22": "Na h' evaṃ vattabbe --pe-- ",
  "kv15.3:1.23": "Āmantā. Vedanā --pe-- ",
  "kv15.3:1.24": "saññā --pe-- ",
  "kv15.3:1.25": "saṃkhārā --pe-- ",
  "kv15.3:1.26": "viññāṇan ti? ",
  "kv15.3:1.27": "Na h' evaṃ vattabbe --pe-- ",
  "kv15.3:1.28": "Paccuppanno addhā parinipphanno ti? ",
  "kv15.3:1.29": "Āmantā. ",
  "kv15.3:1.30": "Rūpan ti? ",
  "kv15.3:1.31": "Na h' evaṃ vattabbe --pe-- ",
  "kv15.3:1.32": "Vedanā --pe-- ",
  "kv15.3:1.33": "saññā --pe-- ",
  "kv15.3:1.34": "saṃkhārā --pe-- ",
  "kv15.3:1.35": "viññāṇan ti? ",
  "kv15.3:1.36": "Na h' evaṃ vattabbe --pe-- 3. ",
  "kv15.3:2.1": "Atītaṃ rūpaṃ vedanā saññā saṃkhārā viññāṇaṃ, atīto addhā ti? ",
  "kv15.3:2.2": "Āmantā. ",
  "kv15.3:2.3": "Atītā pañc' addhā ti? ",
  "kv15.3:2.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv15.3:2.5": "Anāgataṃ rūpaṃ vedanā saññā saṃkhārā viññāṇaṃ, anāgato addhā ti? ",
  "kv15.3:2.6": "Āmantā. ",
  "kv15.3:2.7": "Anāgatā pañc' addhā ti? ",
  "kv15.3:2.8": "Na h' evaṃ vattabbe --pe-- ",
  "kv15.3:2.9": "Paccuppannaṃ rūpaṃ vedanā saññā saṃkhārā viññāṇaṃ, paccuppanno addhā ti? ",
  "kv15.3:2.10": "Āmantā. ",
  "kv15.3:2.11": "Paccuppannā pañc' addhā ti? ",
  "kv15.3:2.12": "Na h' evaṃ vattabbe --pe-- 4. ",
  "kv15.3:3.1": "Atītā pañcakkhandhā atīto addhā, anāgatā pañcakkhandhā anāgato addhā, paccuppannā pañcakkhandhā paccuppanno addhā ti? ",
  "kv15.3:3.2": "Āmantā. ",
  "kv15.3:3.3": "Pannaras' addhā ti? ",
  "kv15.3:3.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv15.3:4.1": "Atītāni dvādas' āyatanāni atīto addhā, anāgatāni dvādas' āyatanāni anāgato addhā, paccuppannāni dvādas' āyatanāni paccuppanno addhā ti? ",
  "kv15.3:4.2": "Āmantā. ",
  "kv15.3:4.3": "Chattiṃs' addhā ti? ",
  "kv15.3:4.4": "Na h' evaṃ vattabbe --pe-- 5. ",
  "kv15.3:5.1": "Atītā aṭṭhārasa dhātuyo atīto addhā, anāgatā aṭṭhārasa dhātuyo anāgato addhā, paccuppannā aṭṭhārasa dhātuyo paccuppanno addhā ti? ",
  "kv15.3:5.2": "Āmantā. ",
  "kv15.3:5.3": "Catupaññās' addhā ti? ",
  "kv15.3:5.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv15.3:6.1": "Atītāni bāvīsat' indriyāni atīto addhā, anāgatāni bāvīsat' indriyāni anāgato addhā, paccuppannāni bāvīsat' indriyāni paccuppanno addhā ti? ",
  "kv15.3:6.2": "Āmantā. ",
  "kv15.3:6.3": "Chasaṭṭhī addhā ti? ",
  "kv15.3:6.4": "Na h' evaṃ vattabbe --pe-- 6. ",
  "kv15.3:7.1": "Na vattabbaṃ ",
  "kv15.3:7.2": "\"Addhā parinipphanno ti\"? ",
  "kv15.3:7.3": "Āmantā. ",
  "kv15.3:7.4": "Nanu vuttaṃ Bhagavatā -- ",
  "kv15.3:7.5": "\"Tīṇ' imāni Bhikkhave kathāvatthūni. ",
  "kv15.3:7.6": "Katamāni tīṇi? ",
  "kv15.3:7.7": "Atītaṃ vā Bhikkhave addhānaṃ ārabbha kathaṃ katheyya ",
  "kv15.3:7.8": "‘evaṃ ahosi atītaṃ addhānan ti,' ",
  "kv15.3:7.9": "anāgataṃ vā Bhikkhave addhānaṃ ārabbha kathaṃ katheyya ",
  "kv15.3:7.10": "‘evaṃ bhavissati anāgataṃ addhānan ti,' ",
  "kv15.3:7.11": "etarahi vā Bhikkhave paccuppannaṃ addhānaṃ ārabbha kathaṃ katheyya ",
  "kv15.3:7.12": "‘evaṃ hoti etarahi paccuppannan ti.' ",
  "kv15.3:7.13": "Imāni kho Bhikkhave tīṇi kathāvatthūnīti.\" ",
  "kv15.3:7.14": "Atth' eva suttanto ti? ",
  "kv15.3:7.15": "Āmantā. ",
  "kv15.3:7.16": "Tena hi addhā parinipphanno ti. ",
  "kv15.3:7.17": "Addhākathā. 1. "
}
