  "kv15.4:0.3": "",
  "kv15.4:0.4": "",
  "kv15.4:1.1": "Khaṇo parinipphanno, layo parinipphanno, muhuttaṃ parinipphannan ti? ",
  "kv15.4:1.2": "Āmantā. ",
  "kv15.4:1.3": "Rūpan ti? ",
  "kv15.4:1.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv15.4:1.5": "Vedanā --pe-- ",
  "kv15.4:1.6": "saññā ",
  "kv15.4:1.7": "--pe-- saṃkhārā --pe-- ",
  "kv15.4:1.8": "viññāṇan ti? ",
  "kv15.4:1.9": "Na h' evaṃ vattabbe --pe-- 2. ",
  "kv15.4:2.1": "Na vattabbaṃ ",
  "kv15.4:2.2": "\"Muhuttaṃ parinipphannan ti\"? ",
  "kv15.4:2.3": "Āmantā. ",
  "kv15.4:2.4": "Nanu vuttaṃ Bhagavatā -- ",
  "kv15.4:2.5": "\"Tīṇ' imāni Bhikkhave kathāvatthūni. ",
  "kv15.4:2.6": "Katamāni tīṇi? ",
  "kv15.4:2.7": "Atītaṃ vā Bhikkhave addhānaṃ ārabbha kathaṃ katheyya ",
  "kv15.4:2.8": "‘evaṃ ahosi atītaṃ addhānan ti,' ",
  "kv15.4:2.9": "anāgataṃ vā Bhikkhave addhānaṃ ārabbha kathaṃ katheyya ",
  "kv15.4:2.10": "‘evaṃ bhavissati anāgataṃ addhānan ti,' ",
  "kv15.4:2.11": "etarahi vā Bhikkhave paccuppannaṃ addhānaṃ ārabbha kathaṃ katheyya ",
  "kv15.4:2.12": "‘evaṃ hoti etarahi paccuppannaṃ ti.' ",
  "kv15.4:2.13": "Imāni kho Bhikkhave tīṇi kathāvatthūnīti.\" ",
  "kv15.4:2.14": "Atth' eva suttanto ti? ",
  "kv15.4:2.15": "Āmantā. ",
  "kv15.4:2.16": "Tena hi muhuttaṃ parinipphannan ti. ",
  "kv15.4:2.17": "Khaṇalayamuhuttakathā. 1. "
}
