  "kv17.3:0.4": "",
  "kv17.3:1.1": "",
  "kv17.3:1.2": "Āmantā. ",
  "kv17.3:1.3": "Kammaṃ pi kammato ti? ",
  "kv17.3:1.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv17.3:1.5": "Sabbaṃ idaṃ kammato ti? ",
  "kv17.3:1.6": "Āmantā. ",
  "kv17.3:1.7": "Sabbaṃ idaṃ pubbekatahetūti? ",
  "kv17.3:1.8": "Na h' evaṃ vattabbe --pe-- 2. ",
  "kv17.3:1.9": "Sabbaṃ idaṃ kammato ti? ",
  "kv17.3:1.10": "Āmantā. ",
  "kv17.3:1.11": "Sabbaṃ idaṃ kammavipākato ti? ",
  "kv17.3:1.12": "Na h' evaṃ vattabbe --pe-- ",
  "kv17.3:2.1": "Sabbaṃ idaṃ kammavipākato ti? ",
  "kv17.3:2.2": "Āmantā. ",
  "kv17.3:2.3": "Kammavipākena pāṇaṃ haneyyāti? ",
  "kv17.3:2.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv17.3:2.5": "Pāṇātipāto saphalo ti? ",
  "kv17.3:2.6": "Āmantā. ",
  "kv17.3:2.7": "Kammavipāko saphalo ti? ",
  "kv17.3:2.8": "Na h' evaṃ vattabbe --pe-- ",
  "kv17.3:2.9": "Kammavipāko aphalo ti? ",
  "kv17.3:2.10": "Āmantā. ",
  "kv17.3:2.11": "Pāṇātipāto aphalo ti? ",
  "kv17.3:2.12": "Na h' evaṃ vattabbe --pe-- 3. ",
  "kv17.3:3.1": "Kammavipākena adinnaṃ ādiyeyya --pe-- ",
  "kv17.3:3.2": "musā bhaṇeyya, ",
  "kv17.3:3.3": "pisuṇaṃ bhaṇeyya, ",
  "kv17.3:3.4": "pharusaṃ bhaṇeyya, ",
  "kv17.3:3.5": "samphappalapeyya , ",
  "kv17.3:3.6": "sandhiṃ chindeyya, ",
  "kv17.3:3.7": "nillopaṃ hareyya, ",
  "kv17.3:3.8": "ekāgārikaṃ kareyya, ",
  "kv17.3:3.9": "paripanthe tiṭṭheyya, ",
  "kv17.3:3.10": "paradāraṃ gaccheyya, ",
  "kv17.3:3.11": "gāmaghātaṃ kareyya, ",
  "kv17.3:3.12": "nigamaghātaṃ kareyya, ",
  "kv17.3:3.13": "kammavipākena dānaṃ dadeyya, ",
  "kv17.3:3.14": "cīvaraṃ dadeyya, ",
  "kv17.3:3.15": "piṇḍapātaṃ dadeyya, ",
  "kv17.3:3.16": "senāsanaṃ dadeyya, ",
  "kv17.3:3.17": "gilānapaccayabhesajjaparikkhāraṃ dadeyyāti? ",
  "kv17.3:3.18": "Āmantā. ",
  "kv17.3:3.19": "Gilānapaccayabhesajjaparikkhāro saphalo ti? ",
  "kv17.3:3.20": "Āmantā. ",
  "kv17.3:3.21": "Kammavipāko saphalo ti? ",
  "kv17.3:3.22": "Na h' evaṃ vattabbe --pe-- ",
  "kv17.3:3.23": "Kammavipāko aphalo ti? ",
  "kv17.3:3.24": "Āmantā. ",
  "kv17.3:3.25": "Gilānapaccayabhesajjaparikkhāro aphalo ti? ",
  "kv17.3:3.26": "Na h' evaṃ vattabbe --pe-- 4. ",
  "kv17.3:4.1": "Na vattabbaṃ ",
  "kv17.3:4.2": "\"Sabbaṃ idaṃ kammato ti\"? ",
  "kv17.3:4.3": "Āmantā. ",
  "kv17.3:4.4": "Nanu vuttaṃ Bhagavatā -- ",
  "kv17.3:5.1": "\"Kammunā vattati loko ",
  "kv17.3:5.2": "kammunā vattati pajā ",
  "kv17.3:5.3": "Kammanibandhanā sattā ",
  "kv17.3:5.4": "rathassānīva yāyato. ",
  "kv17.3:6.1": "Kammena kittiṃ labhate pasaṃsaṃ, ",
  "kv17.3:6.2": "Kammena jāniṃ ca vadhañ ca bandhaṃ, ",
  "kv17.3:6.3": "Taṃ kammaṃ nānākaraṇaṃ viditvā ",
  "kv17.3:6.4": "Kasmā vade n' atthi kamman ti loke ti.\" ",
  "kv17.3:7.1": "Atth' eva suttanto ti? ",
  "kv17.3:7.2": "Āmantā. ",
  "kv17.3:7.3": "Tena hi sabbaṃ idaṃ kammato ti. Sabbaṃ idaṃ kammato ti kathā. 1. Indriyabaddhañ ñeva dukkhan ti? ",
  "kv17.3:7.4": ""
}
