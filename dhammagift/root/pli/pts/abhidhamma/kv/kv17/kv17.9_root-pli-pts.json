  "kv17.9:0.1": "",
  "kv17.9:0.2": "",
  "kv17.9:0.3": "",
  "kv17.9:0.4": "",
  "kv17.9:1.1": "Na vattabbaṃ ",
  "kv17.9:1.2": "\"Saṃghassa dinnaṃ mahapphalan ti\"? ",
  "kv17.9:1.3": "Āmantā. ",
  "kv17.9:1.4": "Nanu Saṃgho āhuneyyo pāhuneyyo dakkhiṇeyyo añjalīkaraṇīyo anuttaraṃ puññakkhettaṃ lokassāti? ",
  "kv17.9:1.5": "Āmantā. ",
  "kv17.9:1.6": "Hañci Saṃgho āhuneyyo --pe-- lokassa, tena vata re vattabbe ",
  "kv17.9:1.7": "\"Saṃghassa dinnaṃ mahapphalan ti.\" 2. ",
  "kv17.9:2.1": "Na vattabbaṃ ",
  "kv17.9:2.2": "\"Saṃghassa dinnaṃ mahapphalan ti\"? ",
  "kv17.9:2.3": "Āmantā. ",
  "kv17.9:2.4": "Nanu cattāro purisayugā, aṭṭha purisapuggalā dakkhiṇeyyā vuttā Bhagavatā ti? ",
  "kv17.9:2.5": "Āmantā. ",
  "kv17.9:2.6": "Hañci cattāro purisayugā, aṭṭha purisapuggalā dakkhiṇeyyā vuttā Bhagavatā, tena vata re vattabbe ",
  "kv17.9:2.7": "\"Saṃghassa dinnaṃ mahapphalan ti.\" 3. ",
  "kv17.9:3.1": "Na vattabbaṃ ",
  "kv17.9:3.2": "\"Saṃghassa dinnaṃ mahapphalan ti\"? ",
  "kv17.9:3.3": "Āmantā. ",
  "kv17.9:3.4": "Nanu vuttaṃ Bhagavatā -- ",
  "kv17.9:3.5": "\"Saṃghe Gotamī dehi, Saṃghe te dinne ahañ c' eva pūjito bhavissāmi Saṃgho cāti.\" ",
  "kv17.9:3.6": "Atth' eva suttanto ti? ",
  "kv17.9:3.7": "Āmantā. ",
  "kv17.9:3.8": "Tena hi Saṃghassa dinnaṃ mahapphalan ti. 4. ",
  "kv17.9:4.1": "Na vattabbaṃ ",
  "kv17.9:4.2": "\"Saṃghassa dinnaṃ mahapphalan ti\"? ",
  "kv17.9:4.3": "Āmantā. ",
  "kv17.9:4.4": "Nanu Sakko devānaṃ indo Bhagavantaṃ etad avoca -- ",
  "kv17.9:5.1": "\"Yajamānānaṃ manussānaṃ ",
  "kv17.9:5.2": "puññapekhānapāṇinaṃ ",
  "kv17.9:5.3": "Karotaṃ opadhikaṃ puññaṃ ",
  "kv17.9:5.4": "kathā dinnaṃ mahapphalan ti.\" ",
  "kv17.9:6.1": "\"Cattāro ca paṭipannā ",
  "kv17.9:6.2": "cattāro ca phale ṭhitā ",
  "kv17.9:6.3": "Esasaṃgho ujubhūto ",
  "kv17.9:6.4": "paññāsīlasamāhito. ",
  "kv17.9:7.1": "Yajamānānaṃ manussānaṃ ",
  "kv17.9:7.2": "puññapekhānapāṇinaṃ ",
  "kv17.9:7.3": "Karotaṃ opadhikaṃ puññaṃ ",
  "kv17.9:7.4": "Saṃghe dinnaṃ mahapphalan ti.\" ",
  "kv17.9:8.1": "\"Eso hi Saṃgho vipulo mahaggato ",
  "kv17.9:8.2": "Esappameyyo udadhīva sāgaro ",
  "kv17.9:8.3": "Ete hi seṭṭhā naravīrasāvakā ",
  "kv17.9:8.4": "Pabhaṅkarā dhammaṃ udīrayan ti. ",
  "kv17.9:9.1": "Tesam sudinnaṃ suhutaṃ suyiṭṭhaṃ ",
  "kv17.9:9.2": "Ye saṃghaṃ uddissa dadanti dānaṃ ",
  "kv17.9:9.3": "Sā dakkhiṇā Saṃghagatā paṭiṭṭhitā ",
  "kv17.9:9.4": "Mahapphalā lokavidūna vaṇṇitā ",
  "kv17.9:10.1": "Etādisaṃ yaññaṃ anussarantā ",
  "kv17.9:10.2": "Ye vedajātā viharanti loke ",
  "kv17.9:10.3": "Vineyya maccheraṃ alaṃ samālaṃ ",
  "kv17.9:10.4": "Aninditā saggaṃ upenti ṭhānan ti.\" ",
  "kv17.9:11.1": "Atth' eva suttanto ti? ",
  "kv17.9:11.2": "Āmantā. ",
  "kv17.9:11.3": "Tena hi Saṃghassa dinnaṃ mahapphalan ti. ",
  "kv17.9:11.4": "Na vattabbaṃ \"Saṃghassa dinnaṃ mahap- phalan ti\" kathā. 1. "
}
