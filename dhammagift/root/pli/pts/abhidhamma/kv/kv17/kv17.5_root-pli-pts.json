  "kv17.5:0.3": "",
  "kv17.5:0.4": "",
  "kv17.5:1.1": "Ṭhapetvā ariyamaggaṃ avasesā saṃkhārā dukkhā ti? ",
  "kv17.5:1.2": "Āmantā. ",
  "kv17.5:1.3": "Dukkhasamudayo pi dukkho ti? ",
  "kv17.5:1.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv17.5:1.5": "Dukkhasamudayo pi dukkho ti? ",
  "kv17.5:1.6": "Āmantā. ",
  "kv17.5:1.7": "Tīṇ' eva ariyasaccānīti? ",
  "kv17.5:1.8": "Na h' evaṃ vattabbe --pe-- ",
  "kv17.5:1.9": "Tīṇ' eva ariyasaccānīti? ",
  "kv17.5:1.10": "Āmantā. ",
  "kv17.5:1.11": "Nanu cattāri ariyasaccāni vuttāni Bhagavatā -- ",
  "kv17.5:1.12": "Dukkhaṃ, Dukkhasamudayo, Dukkhanirodho, Dukkhanirodhagāminī paṭipadā ti? ",
  "kv17.5:1.13": "Āmantā. ",
  "kv17.5:1.14": "Hañci cattāri ariyasaccāni vuttāni Bhagavatā -- ",
  "kv17.5:1.15": "Dukkhaṃ, Dukkhasamudayo, Dukkhanirodho, Dukkhanirodhagāminī paṭipadā, ",
  "kv17.5:1.16": "no vata re vattabbe ",
  "kv17.5:1.17": "\"Tīṇ' eva ariyasaccānīti.\" 2. ",
  "kv17.5:2.1": "Dukkhasamudayo pi dukkho ti? ",
  "kv17.5:2.2": "Āmantā. ",
  "kv17.5:2.3": "Ken' aṭṭhenāti? ",
  "kv17.5:2.4": "Aniccaṭṭhenāti. ",
  "kv17.5:2.5": "Ariyamaggo anicco ti? ",
  "kv17.5:2.6": "Āmantā. ",
  "kv17.5:2.7": "Ariyamaggo dukkho ti? ",
  "kv17.5:2.8": "Na h' evaṃ vattabbe --pe-- ",
  "kv17.5:3.1": "Ariyamaggo anicco so ca na dukkho ti? ",
  "kv17.5:3.2": "Āmantā. ",
  "kv17.5:3.3": "Dukkhasamudayo anicco so ca na dukkho ti? ",
  "kv17.5:3.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv17.5:3.5": "Dukkhasamudayo anicco so ca dukkho ti? ",
  "kv17.5:3.6": "Āmantā. ",
  "kv17.5:3.7": "Ariyamaggo anicco so ca dukkho ti? ",
  "kv17.5:3.8": "Na h' evaṃ vattabbe --pe-- 3. ",
  "kv17.5:4.1": "Na vattabbaṃ ",
  "kv17.5:4.2": "\"Ṭhapetvā ariyamaggaṃ avasesā saṃkhārā dukkhā ti\"? ",
  "kv17.5:4.3": "Āmantā. ",
  "kv17.5:4.4": "Nanu sā dukkhanirodhagāminī paṭipadā ti? ",
  "kv17.5:4.5": "Āmantā. ",
  "kv17.5:4.6": "Hañci sā dukkhanirodhagāminī paṭipadā, tena vata re vattabbe ",
  "kv17.5:4.7": "\"Ṭhapetvā ariyamaggaṃ avasesā saṃkhārā dukkhā ti.\" ",
  "kv17.5:4.8": "Ṭhapetvā ariyamaggan ti kathā. 1. "
}
