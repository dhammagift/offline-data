  "kv22.3:0.3": "",
  "kv22.3:0.4": "",
  "kv22.3:1.1": "Arahā āneñje ṭhito parinibbāyatīti? ",
  "kv22.3:1.2": "Āmantā. ",
  "kv22.3:1.3": "Nanu Arahā pakaticitte ṭhito parinibbāyatīti? ",
  "kv22.3:1.4": "Āmantā. ",
  "kv22.3:1.5": "Hañci Arahā pakaticitte ṭhito parinibbāyati, no vata re vattabbe ",
  "kv22.3:1.6": "\"Arahā āneñje ṭhito parinibbāyatīti.\" 2. ",
  "kv22.3:2.1": "Arahā āneñje ṭhito parinibbāyatīti? ",
  "kv22.3:2.2": "Āmantā. ",
  "kv22.3:2.3": "Arahā kiriyamaye citte ṭhito parinibbāyatīti? ",
  "kv22.3:2.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv22.3:2.5": "Nanu Arahā vipākacitte ṭhito parinibbāyatīti? ",
  "kv22.3:2.6": "Āmantā. ",
  "kv22.3:2.7": "Hañci Arahā vipākacitte ṭhito parinibbāyati, no vata re vattabbe ",
  "kv22.3:2.8": "\"Arahā āneñje ṭhito parinibbāyatīti.\" 3. ",
  "kv22.3:3.1": "Arahā āneñje ṭhito parinibbāyatīti? ",
  "kv22.3:3.2": "Āmantā. ",
  "kv22.3:3.3": "Arahā kiriyābyākate citte ṭhito parinibbāyatīti? ",
  "kv22.3:3.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv22.3:3.5": "Nanu Arahā vipākābyākate citte ṭhito parinibbāyatīti? ",
  "kv22.3:3.6": "Āmantā. ",
  "kv22.3:3.7": "Hañci Arahā vipākābyākate citte ṭhito parinibbāyati, no vata re vattabbe ",
  "kv22.3:3.8": "\"Arahā āneñje ṭhito parinibbāyatīti.\" 4. ",
  "kv22.3:4.1": "Arahā āneñje ṭhito parinibbāyatīti? ",
  "kv22.3:4.2": "Āmantā. ",
  "kv22.3:4.3": "Nanu Bhagavā catutthajjhānā vuṭṭhahitvā samanantarā parinibbuto ti? ",
  "kv22.3:4.4": "Āmantā. ",
  "kv22.3:4.5": "Hañci Bhagavā catutthajjhānā vuṭṭhahitvā samanantarā parinibbuto, no vata re vattabbe ",
  "kv22.3:4.6": "\"Arahā āneñje ṭhito parinibbāyatīti.\" ",
  "kv22.3:4.7": "Āneñjakathā. 1. "
}
