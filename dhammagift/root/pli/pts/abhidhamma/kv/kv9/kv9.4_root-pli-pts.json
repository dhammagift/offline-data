  "kv9.4:0.3": "",
  "kv9.4:0.4": "",
  "kv9.4:1.1": "Anusayā anārammaṇā ti? ",
  "kv9.4:1.2": "Āmantā. ",
  "kv9.4:1.3": "Rūpaṃ nibbānaṃ cakkhāyatanaṃ --pe-- ",
  "kv9.4:1.4": "phoṭṭhabbāyatanan ti? ",
  "kv9.4:1.5": "Na h' evaṃ vattabbe --pe-- ",
  "kv9.4:2.1": "Kāmarāgānusayo anārammaṇo ti? ",
  "kv9.4:2.2": "Āmantā. ",
  "kv9.4:2.3": "Kāmarāgo kāmarāgapariyuṭṭhānaṃ kāmarāgasaññojanaṃ kāmogho kāmayogo kāmacchandanīvaraṇaṃ anārammaṇan ti? ",
  "kv9.4:2.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv9.4:2.5": "Kāmarāgo kāmarāgapariyuṭṭhānaṃ kāmarāgasaññojanaṃ kāmogho kāmayogo kāmacchandanīvaraṇaṃ sārammaṇan ti? ",
  "kv9.4:2.6": "Āmantā. ",
  "kv9.4:2.7": "Kāmarāgānusayo sārammaṇo ti? ",
  "kv9.4:2.8": "Na h' evaṃ vattabbe --pe-- 2. ",
  "kv9.4:3.1": "Kāmarāgānusayo anārammaṇo ti? ",
  "kv9.4:3.2": "Āmantā. ",
  "kv9.4:3.3": "Katamakkhandhapariyāpanno ti? Saṃkhārakkhandhapariyāpanno ",
  "kv9.4:3.4": "ti. ",
  "kv9.4:3.5": "Saṃkhārakkhandho anārammaṇo ti? ",
  "kv9.4:3.6": "Na h' evaṃ vattabbe --pe-- ",
  "kv9.4:3.7": "Saṃkhārakkhandho anārammaṇo ti? ",
  "kv9.4:3.8": "Āmantā. ",
  "kv9.4:3.9": "Vedanākkhandho, saññākkhandho, viññāṇakkhandho anārammaṇo ti? ",
  "kv9.4:3.10": "Na h' evaṃ vattabbe --pe-- 3. ",
  "kv9.4:4.1": "Kāmarāgānusayo saṃkhārakkhandhapariyāpanno anārammaṇo ti? ",
  "kv9.4:4.2": "Āmantā. ",
  "kv9.4:4.3": "Kāmarāgo saṃkhārakkhandhapariyāpanno anārammaṇo ti? ",
  "kv9.4:4.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv9.4:4.5": "Kāmarāgo saṃkhārakkhandhapariyāpanno sārammaṇo ti? ",
  "kv9.4:4.6": "Āmantā. ",
  "kv9.4:4.7": "Kāmarāgānusayo saṃkhārakkhandhapariyāpanno sārammaṇo ti? ",
  "kv9.4:4.8": "Na h' evaṃ vattabbe --pe-- 4. ",
  "kv9.4:5.1": "Kāmarāgānusayo saṃkhārakkhandhapariyāpanno anārammaṇo, kāmarāgo saṃkhārakkhandhapariyāpanno sārammaṇo ti? ",
  "kv9.4:5.2": "Āmantā. ",
  "kv9.4:5.3": "Saṃkhārakkhandho ekadeso sārammaṇo, ekadeso anārammaṇo ti? ",
  "kv9.4:5.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv9.4:5.5": "Saṃkhārakkhandho ekadeso sārammaṇo, ekadeso anārammaṇo ti? ",
  "kv9.4:5.6": "Āmantā. ",
  "kv9.4:5.7": "Vedanākkhandho, saññākkhandho, viññāṇakkhandho ekadeso sārammaṇo, ekadeso anārammaṇo ti? ",
  "kv9.4:5.8": "Na h' evaṃ vattabbe --pe-- 5. ",
  "kv9.4:6.1": "Paṭighānusayo, mānānusayo, diṭṭhānusayo, vicikicchānusayo, bhavarāgānusayo, avijjānusayo anārammaṇo ti? ",
  "kv9.4:6.2": "Āmantā. ",
  "kv9.4:6.3": "Avijjā avijjogho avijjāyogo avijjāpariyuṭṭhānaṃ avijjāsaññojanaṃ avijjānīvaraṇaṃ anārammaṇan ti? ",
  "kv9.4:6.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv9.4:6.5": "Avijjā avijjogho --pe-- ",
  "kv9.4:6.6": "avijjānīvaraṇaṃ sārammaṇan ti? ",
  "kv9.4:6.7": "Āmantā. ",
  "kv9.4:6.8": "Avijjānusayo sārammaṇo ti? ",
  "kv9.4:6.9": "Na h' evaṃ vattabbe --pe-- 6. ",
  "kv9.4:7.1": "Avijjānusayo anārammaṇo ti? ",
  "kv9.4:7.2": "Āmantā. ",
  "kv9.4:7.3": "Katamakkhandhapariyāpanno ti? Saṃkhārakkhandhapariyāpanno ",
  "kv9.4:7.4": "ti. ",
  "kv9.4:7.5": "Saṃkhārakkhandho anārammaṇo ti? ",
  "kv9.4:7.6": "Na h' evaṃ vattabbe --pe-- ",
  "kv9.4:7.7": "Saṃkhārakkhandho anārammaṇo ti? ",
  "kv9.4:7.8": "Āmantā. ",
  "kv9.4:7.9": "Vedanākkhandho, saññākkhandho, viññāṇakkhandho anārammaṇo ti? ",
  "kv9.4:7.10": "Na h' evaṃ vattabbe --pe-- 7. ",
  "kv9.4:8.1": "Avijjānusayo saṃkhārakkhandhapariyāpanno anārammaṇo ti? ",
  "kv9.4:8.2": "Āmantā. ",
  "kv9.4:8.3": "Avijjā saṃkhārakkhandhapariyāpannā anārammaṇā ti? ",
  "kv9.4:8.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv9.4:8.5": "Avijjā saṃkhārakkhandhapariyāpannā sārammaṇā ti? ",
  "kv9.4:8.6": "Āmantā. ",
  "kv9.4:8.7": "Avijjānusayo saṃkhārakkhandhapariyāpanno sārammaṇo ti? ",
  "kv9.4:8.8": "Na h' evaṃ vattabbe --pe-- 8. ",
  "kv9.4:9.1": "Avijjānusayo saṃkhārakkhandhapariyāpanno anārammaṇo, avijjā saṃkhārakkhandhapariyāpannā sārammaṇā ti? ",
  "kv9.4:9.2": "Āmantā. ",
  "kv9.4:9.3": "Saṃkhārakkhandho ekadeso sārammaṇo, ekadeso anārammaṇo ti? ",
  "kv9.4:9.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv9.4:9.5": "Saṃkhārakkhandho ekadeso sārammaṇo, ekadeso anārammaṇo ti? ",
  "kv9.4:9.6": "Āmantā. ",
  "kv9.4:9.7": "Vedanākkhandho, saññākkhandho, viññāṇakkhandho ekadeso sārammaṇo, ekadeso anārammaṇo ti? ",
  "kv9.4:9.8": "Na h' evaṃ vattabbe --pe-- 9. ",
  "kv9.4:10.1": "Na vattabbaṃ ",
  "kv9.4:10.2": "\"Anusayā anārammaṇā ti\"? ",
  "kv9.4:10.3": "Āmantā. ",
  "kv9.4:10.4": "Puthujjano kusalābyākate citte vattamāne \"sānusayo ti\" vattabbo ti? ",
  "kv9.4:10.5": "Āmantā. ",
  "kv9.4:10.6": "Atthi tesaṃ anusayānaṃ ārammaṇan ti? ",
  "kv9.4:10.7": "Na h' evaṃ vattabbe --pe-- ",
  "kv9.4:10.8": "Tena hi anusayā anārammaṇā ti. 10. ",
  "kv9.4:10.9": "Puthujjano kusalābyākate citte vattamāne \"sarāgo ti\" vattabbo ti? ",
  "kv9.4:10.10": "Āmantā. ",
  "kv9.4:10.11": "Atthi tassa rāgassa ārammaṇan ti? ",
  "kv9.4:10.12": "Na h' evaṃ vattabbe --pe-- ",
  "kv9.4:10.13": "Tena hi rāgo anārammaṇo ti. Anusayā anārammaṇā ti kathā. 1. ",
  "kv9.4:10.14": ""
}
