{
  "kv9.5:0.1": "",
  "kv9.5:0.2": "",
  "kv9.5:0.3": "",
  "kv9.5:0.4": "",
  "kv9.5:1.1": "Ñāṇaṃ anārammaṇan ti? ",
  "kv9.5:1.2": "Āmantā. ",
  "kv9.5:1.3": "Rūpaṃ nibbānaṃ cakkhāyatanaṃ --pe-- ",
  "kv9.5:1.4": "phoṭṭhabhāyatanan ti? ",
  "kv9.5:1.5": "Na h' evaṃ vattabbe --pe-- ",
  "kv9.5:1.6": "Ñāṇaṃ anārammaṇan ti? ",
  "kv9.5:1.7": "Āmantā. ",
  "kv9.5:1.8": "Paññā, paññindriyaṃ, paññābalaṃ, sammādiṭṭhi, dhammavicayasambojjhaṅgo anārammaṇo ti? ",
  "kv9.5:1.9": "Na h' evaṃ vattabbe --pe-- ",
  "kv9.5:1.10": "Paññā, paññindriyaṃ, paññābalaṃ, sammādiṭṭhi, dhammavicayasambojjhaṅgo sārammaṇo ti? ",
  "kv9.5:1.11": "Āmantā. ",
  "kv9.5:1.12": "Ñāṇaṃ sārammaṇan ti? ",
  "kv9.5:1.13": "Na h' evaṃ vattabbe --pe-- 2. ",
  "kv9.5:2.1": "Ñāṇaṃ anārammaṇan ti? ",
  "kv9.5:2.2": "Āmantā. ",
  "kv9.5:2.3": "Katamakkhandhapariyāpannan ti? Saṃkhārakkhandhapariyāpannan ",
  "kv9.5:2.4": "ti. ",
  "kv9.5:2.5": "Saṃkhārakkhandho anārammaṇo ti? ",
  "kv9.5:2.6": "Na h' evaṃ vattabbe --pe-- ",
  "kv9.5:2.7": "Saṃkhārakkhandho anārammaṇo ti? ",
  "kv9.5:2.8": "Āmantā. ",
  "kv9.5:2.9": "Vedanākkhandho, saññākkhandho, viññāṇakkhandho anārammaṇo ti? ",
  "kv9.5:2.10": "Na h' evaṃ vattabbe --pe-- 3. ",
  "kv9.5:2.11": "Ñāṇaṃ saṃkhārakkhandhapariyāpannaṃ anārammaṇan ti? ",
  "kv9.5:2.12": "Āmantā. ",
  "kv9.5:2.13": "Paññā saṃkhārakkhandhapariyāpannā anārammaṇā ti? ",
  "kv9.5:2.14": "Na h' evaṃ vattabbe --pe-- ",
  "kv9.5:2.15": "Paññā saṃkhārakkhandhapariyāpannā sārammaṇā ti? ",
  "kv9.5:2.16": "Āmantā. ",
  "kv9.5:2.17": "Ñāṇaṃ saṃkhārakkhandhapariyāpannaṃ sārammaṇan ti? ",
  "kv9.5:2.18": "Na h' evaṃ vattabbe --pe-- 4. ",
  "kv9.5:3.1": "Ñāṇaṃ saṃkhārakkhandhapariyāpannaṃ anārammaṇaṃ, paññā saṃkhārakkhandhapariyāpannā sārammaṇā ti? ",
  "kv9.5:3.2": "Āmantā. ",
  "kv9.5:3.3": "Saṃkhārakkhandho ekadeso sārammaṇo, ekadeso anārammaṇo ti? ",
  "kv9.5:3.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv9.5:3.5": "Saṃkhārakkhandho ekadeso sārammaṇo, ekadeso anārammaṇo ti? ",
  "kv9.5:3.6": "Āmantā. ",
  "kv9.5:3.7": "Vedanākkhandho, saññākkhandho, viññāṇakkhandho ekadeso sārammaṇo, ekadeso anāramanaṇo ti? ",
  "kv9.5:3.8": "Na h' evaṃ vattabbe --pe-- 5. ",
  "kv9.5:4.1": "Na vattabbaṃ ",
  "kv9.5:4.2": "\"Ñāṇaṃ anārammaṇan ti\"? ",
  "kv9.5:4.3": "Āmantā. ",
  "kv9.5:4.4": "Arahā cakkhuviññāṇasamaṅgī \"ñāṇīti\" vattabbo ti? ",
  "kv9.5:4.5": "Āmantā. ",
  "kv9.5:4.6": "Atthi tassa ñāṇassa ārammaṇan ti? ",
  "kv9.5:4.7": "Na h' evaṃ vattabbe --pe-- ",
  "kv9.5:4.8": "Tena hi ñāṇaṃ anārammaṇan ti. 6. ",
  "kv9.5:4.9": "Arahā cakkhuviññāṇasamaṅgī \"paññavā ti\" vattabbo ti? ",
  "kv9.5:4.10": "Āmantā. ",
  "kv9.5:4.11": "Atthi tāya paññāya ārammaṇan ti? ",
  "kv9.5:4.12": "Na h' evaṃ vattabbe --pe-- ",
  "kv9.5:4.13": "Tena hi paññā anārammaṇā ti. ",
  "kv9.5:4.14": "Ñāṇaṃ anārammaṇan ti kathā. 1. "
}
