  "kv9.1:0.4": "",
  "kv9.1:1.1": "Ānisaṃsadassāvissa saññojanānaṃ pahānan ti? ",
  "kv9.1:1.2": "Āmantā. ",
  "kv9.1:1.3": "Nanu saṃkhāre aniccato manasikaroto saññojanā pahīyantīti? ",
  "kv9.1:1.4": "Āmantā. ",
  "kv9.1:1.5": "Hañci saṃkhāre aniccato manasikaroto saññojanā pahīyanti, no vata re vattabbe ",
  "kv9.1:1.6": "\"Ānisaṃsadassāvissa saññojanānaṃ pahānan ti.\" 2. ",
  "kv9.1:2.1": "Nanu saṃkhāre dukkhato --pe-- ",
  "kv9.1:2.2": "rogato ",
  "kv9.1:2.3": "gaṇḍato ",
  "kv9.1:2.4": "sallato ",
  "kv9.1:2.5": "aghato ",
  "kv9.1:2.6": "ābādhato ",
  "kv9.1:2.7": "parato ",
  "kv9.1:2.8": "palokato ",
  "kv9.1:2.9": "ītito ",
  "kv9.1:2.10": "upaddavato ",
  "kv9.1:2.11": "bhayato ",
  "kv9.1:2.12": "upasaggato ",
  "kv9.1:2.13": "calato ",
  "kv9.1:2.14": "pabhaṅguto ",
  "kv9.1:2.15": "adhuvato ",
  "kv9.1:2.16": "atānato ",
  "kv9.1:2.17": "aleṇato ",
  "kv9.1:2.18": "asaraṇato ",
  "kv9.1:2.19": "asaraṇibhūtato ",
  "kv9.1:2.20": "riccato ",
  "kv9.1:2.21": "tucchato ",
  "kv9.1:2.22": "suññato ",
  "kv9.1:2.23": "anattato ",
  "kv9.1:2.24": "ādīnavato --pe-- ",
  "kv9.1:2.25": "vipariṇāmadhammato manasikaroto saññojanā pahīyantīti? ",
  "kv9.1:2.26": "Āmantā. ",
  "kv9.1:2.27": "Hañci saṃkhāre vipariṇāmadhammato manasikaroto saññojanā pahīyanti, no vata re vattabbe ",
  "kv9.1:2.28": "\"Ānisaṃsadassāvissa saññojanānaṃ pahānan ti.\" 3. ",
  "kv9.1:3.1": "Saṃkhāre ca aniccato manasikaroti, nibbāne ca ānisaṃsadassāvī hotīti? ",
  "kv9.1:3.2": "Na h' evaṃ vattabbe --pe-- ",
  "kv9.1:3.3": "Saṃkhāre ca aniccato manasikaroti, nibbāne ca ānisaṃsadassāvī hotīti? ",
  "kv9.1:3.4": "Āmantā. ",
  "kv9.1:3.5": "Dvinnaṃ phassānaṃ --pe-- ",
  "kv9.1:3.6": "dvinnaṃ cittānaṃ samodhānaṃ hotīti? ",
  "kv9.1:3.7": "Na h' evaṃ vattabbe --pe-- ",
  "kv9.1:3.8": "Saṃkhāre ca dukkhato --pe-- rogato --pe-- ",
  "kv9.1:3.9": "vipariṇāmadhammato manasikaroti, nibbāne ca ānisaṃsadassāvī hotīti? ",
  "kv9.1:3.10": "Na h' evaṃ vattabbe --pe-- ",
  "kv9.1:3.11": "Saṃkhāre ca vipariṇāmadhammato manasikaroti, nibbāne ca ānisaṃsadassāvī hotīti? ",
  "kv9.1:3.12": "Āmantā. ",
  "kv9.1:3.13": "Dvinnaṃ phassānaṃ --pe-- ",
  "kv9.1:3.14": "dvinnaṃ cittānaṃ samodhānaṃ hotīti? ",
  "kv9.1:3.15": "Na h' evaṃ vattabbe --pe-- 4. ",
  "kv9.1:4.1": "Na vattabbaṃ ",
  "kv9.1:4.2": "\"Ānisaṃsadassāvissa saññojanānaṃ pahānan ti\"? ",
  "kv9.1:4.3": "Āmantā. ",
  "kv9.1:4.4": "Nanu vuttaṃ Bhagavatā -- ",
  "kv9.1:4.5": "\"Idha Bhikkhave bhikkhu nibbāne sukhānupassī viharati sukhasaññī sukhapaṭisaṃvedī satataṃ samitaṃ abbokiṇṇaṃ cetasā adhimuccamāno paññāya pariyogāhamāno ti.\" ",
  "kv9.1:4.6": "Atth' eva suttanto ti? ",
  "kv9.1:4.7": "Āmantā. ",
  "kv9.1:4.8": "Tena hi ānisaṃsadassāvissa saññojanānaṃ pahānan ",
  "kv9.1:4.9": "ti. Ānisaṃsakathā. 1. "
}
