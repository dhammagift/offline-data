  "kv11.1:1.1": "Anusayā abyākatā ti? ",
  "kv11.1:1.2": "Āmantā. ",
  "kv11.1:1.3": "Vipākābyākatā kiriyābyākatā rūpaṃ nibbānaṃ cakkhāyatanaṃ --pe-- phoṭṭhabbāyatanan ti? ",
  "kv11.1:1.4": "Na h' evaṃ vattabbe --pe-- 2. ",
  "kv11.1:2.1": "Kāmarāgānusayo abyākato ti? ",
  "kv11.1:2.2": "Āmantā. ",
  "kv11.1:2.3": "Kāmarāgo kāmarāgapariyuṭṭhānaṃ kāmarāgasaññojanaṃ kāmogho kāmayogo kāmacchandanīvaraṇaṃ abyākatan ti? ",
  "kv11.1:2.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv11.1:2.5": "Kāmarāgo --pe-- kāmacchandanīvaraṇaṃ akusalan ti? ",
  "kv11.1:2.6": "Āmantā. ",
  "kv11.1:2.7": "Kāmarāgānusayo akusalo ti? ",
  "kv11.1:2.8": "Na h' evaṃ vattabbe --pe-- 3. ",
  "kv11.1:3.1": "Paṭighānusayo abyākato ti? ",
  "kv11.1:3.2": "Āmantā. ",
  "kv11.1:3.3": "Paṭighaṃ paṭighapariyuṭṭhānaṃ paṭighasaññojanaṃ abyākatan ti? ",
  "kv11.1:3.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv11.1:3.5": "Paṭighaṃ paṭighapariyuṭṭhānaṃ paṭighasaññojanaṃ akusalan ti? ",
  "kv11.1:3.6": "Āmantā. ",
  "kv11.1:3.7": "Paṭighānusayo akusalo ti? ",
  "kv11.1:3.8": "Na h' evaṃ vattabbe --pe-- 4. ",
  "kv11.1:4.1": "Mānānusayo abyākato ti? ",
  "kv11.1:4.2": "Āmantā. ",
  "kv11.1:4.3": "Māno mānapariyuṭṭhānaṃ mānasañojanaṃ abyākatan ti? ",
  "kv11.1:4.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv11.1:4.5": "Māno mānapariyuṭṭhānaṃ mānasaññojanaṃ akusalan ti? ",
  "kv11.1:4.6": "Āmantā. ",
  "kv11.1:4.7": "Mānānusayo akusalo ti? ",
  "kv11.1:4.8": "Na h' evaṃ vattabbe --pe-- 5. ",
  "kv11.1:5.1": "Diṭṭhānusayo abyākato ti? ",
  "kv11.1:5.2": "Āmantā. ",
  "kv11.1:5.3": "Diṭṭhi diṭṭhogho diṭṭhiyogo diṭṭhipariyuṭṭhānaṃ diṭṭhisaññojanaṃ abyākatan ti? ",
  "kv11.1:5.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv11.1:5.5": "Diṭṭhi diṭṭhogho diṭṭhiyogo diṭṭhipariyuṭṭhānaṃ diṭṭhisaññojanaṃ akusalan ti? ",
  "kv11.1:5.6": "Āmantā. ",
  "kv11.1:5.7": "Diṭṭhānusayo akusalo ti? ",
  "kv11.1:5.8": "Na h' evaṃ vattabbe --pe-- 6. ",
  "kv11.1:6.1": "Vicikicchānusayo abyākato ti? ",
  "kv11.1:6.2": "Āmantā. ",
  "kv11.1:6.3": "Vicikicchā vicikicchāpariyuṭṭhānaṃ vicikicchāsaññojanaṃ vicikicchānīvaraṇaṃ abyākatan ti? ",
  "kv11.1:6.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv11.1:6.5": "Vicikicchā vicikicchāpariyuṭṭhānaṃ vicikicchāsaññojanaṃ vicikicchānīvaraṇaṃ akusalan ti? ",
  "kv11.1:6.6": "Āmantā. ",
  "kv11.1:6.7": "Vicikicchānusayo akusalo ti? ",
  "kv11.1:6.8": "Na h' evaṃ vattabbe --pe-- 7. ",
  "kv11.1:7.1": "Bhavarāgānusayo abyākato ti? ",
  "kv11.1:7.2": "Āmantā. ",
  "kv11.1:7.3": "Bhavarāgo bhavarāgapariyuṭṭhānaṃ bhavarāgasaññojanaṃ abyākatan ti? ",
  "kv11.1:7.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv11.1:7.5": "Bhavarāgo bhavarāgapariyuṭṭhānaṃ bhavarāgasaññojanaṃ akusalan ti? ",
  "kv11.1:7.6": "Āmantā. ",
  "kv11.1:7.7": "Bhavarāgānusayo akusalo ti? ",
  "kv11.1:7.8": "Na h' evaṃ vattabbe --pe-- 8. ",
  "kv11.1:8.1": "Avijjānusayo abyākato ti? ",
  "kv11.1:8.2": "Āmantā. ",
  "kv11.1:8.3": "Avijjā avijjogho avijjāyogo avijjāpariyuṭṭhānaṃ avijjāsaññojanaṃ avijjānīvaraṇaṃ abyākatan ti? ",
  "kv11.1:8.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv11.1:8.5": "Avijjā avijjogho avijjāyogo avijjāpariyuṭṭhānaṃ avijjāsaññojanaṃ avijjānīvaraṇaṃ akusalan ti? ",
  "kv11.1:8.6": "Āmantā. ",
  "kv11.1:8.7": "Avijjānusayo akusalo ti? ",
  "kv11.1:8.8": "Na h' evaṃ vattabbe --pe-- 9. ",
  "kv11.1:9.1": "Na vattabbaṃ ",
  "kv11.1:9.2": "\"Anusayā abyākatā ti\"? ",
  "kv11.1:9.3": "Āmantā. ",
  "kv11.1:9.4": "Puthujjano kusalābyākate citte vattamāne sānusayo ti\" vattabbo ti? ",
  "kv11.1:9.5": "Āmantā. ",
  "kv11.1:9.6": "Kusalākusalā dhammā sammukhībhāvaṃ āgacchantīti? ",
  "kv11.1:9.7": "Na h' evaṃ vattabbe --pe-- ",
  "kv11.1:9.8": "Tena hi anusayā abyākatā ti. ",
  "kv11.1:9.9": "Puthujjano kusalābyākate citte vattamāne \"sarāgo ti\" vattabbo ti? ",
  "kv11.1:9.10": "Āmantā. ",
  "kv11.1:9.11": "Kusalākusalā dhammā sammukhībhāvaṃ āgacchantīti? ",
  "kv11.1:9.12": "Na h' evaṃ vattabbe --pe-- ",
  "kv11.1:9.13": "Tena hi rāgo abyākato ti. 10. ",
  "kv11.1:10.1": "Anusayā ahetukā ti? ",
  "kv11.1:10.2": "Āmantā. ",
  "kv11.1:10.3": "Rūpaṃ nibbānaṃ cakkhāyatanaṃ --pe-- phoṭṭhabbāyatanan ti? ",
  "kv11.1:10.4": "Na h' evaṃ vattabbe --pe--' ",
  "kv11.1:11.1": "Kāmarāgānusayo ahetuko ti? ",
  "kv11.1:11.2": "Āmantā. ",
  "kv11.1:11.3": "Kāmarāgo kāmarāgapariyuṭṭhānaṃ kāmarāgasaññojanaṃ --pe-- kāmāraganīvaraṇaṃ ahetukan ti? ",
  "kv11.1:11.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv11.1:11.5": "Kāmarāgo kāmarāgapariyuṭṭhānaṃ kāmarāgasaññojanaṃ --pe-- kāmāraganīvaraṇaṃ sahetukan ti? ",
  "kv11.1:11.6": "Āmantā. ",
  "kv11.1:11.7": "Kāmarāgānusayo sahetuko ti? ",
  "kv11.1:11.8": "Na h' evaṃ vattabbe --pe-- ",
  "kv11.1:11.9": "Paṭighānusayo --pe-- ",
  "kv11.1:11.10": "mānānusayo, ",
  "kv11.1:11.11": "diṭṭhānusayo, ",
  "kv11.1:11.12": "vicikicchānusayo, ",
  "kv11.1:11.13": "bhavarāgānusayo --pe-- ",
  "kv11.1:11.14": "avijjānusayo ahetuko ti? ",
  "kv11.1:11.15": "Āmantā. ",
  "kv11.1:11.16": "Avijjā avijjogho avijjāyogo avijjāpariyuṭṭhānaṃ avijjāsaññojanaṃ avijjānīvaraṇaṃ ahetukan ti? ",
  "kv11.1:11.17": "Na h' evaṃ vattabbe --pe-- ",
  "kv11.1:11.18": "Avijjā avijjogho --pe-- ",
  "kv11.1:11.19": "avijjānīvaraṇaṃ sahetukan ti? ",
  "kv11.1:11.20": "Āmantā. ",
  "kv11.1:11.21": "Avijjānusayo sahetuko ti? ",
  "kv11.1:11.22": "Na h' evaṃ vattabbe --pe-- 11. ",
  "kv11.1:12.1": "Na vattabbaṃ ",
  "kv11.1:12.2": "\"Anusayā ahetukā ti\"? ",
  "kv11.1:12.3": "Āmantā. ",
  "kv11.1:12.4": "Puthujjano kusalābyākate citte vattamāne \"sānusayo ti\" vattabbo ti? ",
  "kv11.1:12.5": "Āmantā. ",
  "kv11.1:12.6": "Anusayā tena hetunā sahetukā ti? ",
  "kv11.1:12.7": "Na h' evaṃ vattabbe --pe-- ",
  "kv11.1:12.8": "Tena hi anusayā ahetukā ti. ",
  "kv11.1:12.9": "Puthujjano kusalābyākate citte vattamāne \"sarāgo ti\" vattabbo ti? ",
  "kv11.1:12.10": "Āmantā. ",
  "kv11.1:12.11": "Rāgo tena hetunā sahetuko ti? ",
  "kv11.1:12.12": "Na h' evaṃ vattabbe --pe-- ",
  "kv11.1:12.13": "Tena hi rāgo ahetuko ti. 12. ",
  "kv11.1:13.1": "Anusayā cittavippayuttā ti? ",
  "kv11.1:13.2": "Āmantā. ",
  "kv11.1:13.3": "Rūpaṃ nibbānaṃ cakkhāyatanaṃ --pe-- phoṭṭhabbāyatanan ti? ",
  "kv11.1:13.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv11.1:14.1": "Kāmarāgānusayo cittavippayutto ti? ",
  "kv11.1:14.2": "Āmantā. ",
  "kv11.1:14.3": "Kāmarāgo kāmarāgapariyuṭṭhānaṃ kāmarāgasaññojanaṃ kāmogho kāmayogo kāmacchandanīvaraṇaṃ cittavippayuttan ti? ",
  "kv11.1:14.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv11.1:14.5": "Kāmarāgo --pe-- kāmacchandanīvaraṇaṃ cittasampayuttan ti? ",
  "kv11.1:14.6": "Āmantā. ",
  "kv11.1:14.7": "Kāmarāgānusayo cittasampayutto ti? ",
  "kv11.1:14.8": "Na h' evaṃ vattabbe --pe-- 13. ",
  "kv11.1:15.1": "Kāmarāgānusayo cittavippayutto ti? ",
  "kv11.1:15.2": "Āmantā. ",
  "kv11.1:15.3": "Katamakkhandhapariyāpanno ti? Saṃkhārakkhandhapariyāpanno ",
  "kv11.1:15.4": "ti. ",
  "kv11.1:15.5": "Saṃkhārakkhandho cittavippayutto ti? ",
  "kv11.1:15.6": "Na h' evaṃ vattabbe ",
  "kv11.1:15.7": "--pe-- Saṃkhārakkhandho cittavippayutto ti? ",
  "kv11.1:15.8": "Āmantā. ",
  "kv11.1:15.9": "Vedanākkhandho, viññāṇakkhandho cittavippayutto ti? ",
  "kv11.1:15.10": "Na h' evaṃ vattabbe --pe-- 14. ",
  "kv11.1:16.1": "Kāmarāgānusayo saṃkhārakkhandhapariyāpanno cittavippayutto ti? ",
  "kv11.1:16.2": "Āmantā. ",
  "kv11.1:16.3": "Kāmarāgo saṃkhārakkhandhapariyāpanno cittavippayutto ti? ",
  "kv11.1:16.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv11.1:16.5": "Kāmarāgo saṃkhārakkhandhapariyāpanno cittasampayutto ti? ",
  "kv11.1:16.6": "Āmantā. ",
  "kv11.1:16.7": "Kāmarāgānusayo saṃkhārakkhandhapariyāpanno cittasampayutto ti? ",
  "kv11.1:16.8": "Na h' evaṃ vattabbe --pe-- 15. ",
  "kv11.1:17.1": "Kāmarāgānusayo saṃkhārakkhandhapariyāpanno cittavipayutto, kāmarāgo saṃkhārakkhandhapariyāpanno cittasampayutto ti? ",
  "kv11.1:17.2": "Āmantā. ",
  "kv11.1:17.3": "Saṃkhārakkhandho ekadeso cittasampayutto ekadeso cittavippayutto ti? ",
  "kv11.1:17.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv11.1:18.1": "Saṃkhārakkhandho ekadeso cittasampayutto ekadeso cittavippayutto ti? ",
  "kv11.1:18.2": "Āmantā. ",
  "kv11.1:18.3": "Vedanākkhandho, viññāṇakkhandho ekadeso cittasampayutto ekadeso cittavippayutto ti? ",
  "kv11.1:18.4": "Na h' evaṃ vattabbe --pe-- 16. ",
  "kv11.1:19.1": "Paṭighānusayo, mānānusayo, diṭṭhānusayo, vicikicchānusayo, bhavarāgānusayo, avijjānusayo cittavipayutto ti? ",
  "kv11.1:19.2": "Āmantā. ",
  "kv11.1:19.3": "Avijjā avijjogho avijjāyogo --pe-- avijjānīvaraṇaṃ cittavippayuttan ti? ",
  "kv11.1:19.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv11.1:19.5": "Avijjā avijjogho avijjāyogo --pe-- avijjānīvaraṇaṃ cittasampayuttan ti? ",
  "kv11.1:19.6": "Āmantā. ",
  "kv11.1:19.7": "Avijjānusayo cittasampayutto ti? ",
  "kv11.1:19.8": "Na h' evaṃ vattabbe --pe-- 17. ",
  "kv11.1:20.1": "Avijjānusayo cittavippayutto ti? ",
  "kv11.1:20.2": "Āmantā. ",
  "kv11.1:20.3": "Katamakkhandhapariyāpanno ti? Saṃkhārakkhandhapariyāpanno ",
  "kv11.1:20.4": "ti. ",
  "kv11.1:20.5": "Saṃkhārakkhandho cittavippayutto ti? ",
  "kv11.1:20.6": "Na h' evaṃ vattabbe ",
  "kv11.1:20.7": "--pe-- Saṃkhārakkhandho cittavippayutto ti? ",
  "kv11.1:20.8": "Āmantā. ",
  "kv11.1:20.9": "Vedanākkhandho, saññākkhandho cittavippayutto ti? ",
  "kv11.1:20.10": "Na h' evaṃ vattabbe --pe-- 8. ",
  "kv11.1:21.1": "Avijjānusayo saṃkhārakkhadhapariyāpanno cittavippayutto ti? ",
  "kv11.1:21.2": "Āmantā. ",
  "kv11.1:21.3": "Avijjā saṃkhārakkhandhapariyāpannā cittavippayuttā ti? ",
  "kv11.1:21.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv11.1:21.5": "Avijjā saṃkhārakkhandhapariyāpannā cittasampayuttā ti? ",
  "kv11.1:21.6": "Āmantā. ",
  "kv11.1:21.7": "Avijjānusayo saṃkhārakkhandhapariyāpanno cittasampayutto ti? ",
  "kv11.1:21.8": "Na h' evaṃ vattabbe --pe-- 19. ",
  "kv11.1:22.1": "Avijjānusayo saṃkhārakkhandhapariyāpanno cittavippayutto, avijjā saṃkhārakkhandhapariyāpannā cittasampayuttā ti? ",
  "kv11.1:22.2": "Āmantā. ",
  "kv11.1:22.3": "Saṃkhārakkhandho ekadeso cittasampayutto ekadeso cittavippayutto ti? ",
  "kv11.1:22.4": "Na h' evaṃ vattabbe ",
  "kv11.1:23.1": "--pe-- Saṃkhārakkhandho ekadeso cittasampayutto ekadeso cittavippayutto ti? ",
  "kv11.1:23.2": "Āmantā. ",
  "kv11.1:23.3": "Vedanākkhandho, saññākkhandho ekadeso citasampayutto ekadeso cittavippayutto ti? ",
  "kv11.1:23.4": "Na h' evaṃ vattabbe --pe-- 20. ",
  "kv11.1:24.1": "Na vattabbaṃ ",
  "kv11.1:24.2": "\"Anusayā cittavippayuttā ti\"? ",
  "kv11.1:24.3": "Āmantā. ",
  "kv11.1:24.4": "Puthujjano kusalābyākate citte vattamāne \"sānusayo ti\" vattabbo ti? ",
  "kv11.1:24.5": "Āmantā. ",
  "kv11.1:24.6": "Anusayā tena cittena sampayuttā ti? ",
  "kv11.1:24.7": "Na h' evaṃ vattabbe --pe-- ",
  "kv11.1:24.8": "Tena hi anusayā cittavippayuttā ti. ",
  "kv11.1:24.9": "Puthujjano kusalābyākate citte vattamāne \"sarāgo ti\" vattabbo ti? ",
  "kv11.1:24.10": "Āmantā. ",
  "kv11.1:24.11": "Rāgo tena cittena sampayutto ti? ",
  "kv11.1:24.12": "Na h' evaṃ vattabbe --pe-- ",
  "kv11.1:24.13": "Tena hi rāgo cittavippayutto ti. ",
