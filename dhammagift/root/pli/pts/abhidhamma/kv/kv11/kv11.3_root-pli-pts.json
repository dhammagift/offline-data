{
  "kv11.3:0.1": "",
  "kv11.3:0.2": "",
  "kv11.3:0.3": "",
  "kv11.3:0.4": "",
  "kv11.3:1.1": "Ñāṇaṃ cittavippayuttan ti? ",
  "kv11.3:1.2": "Āmantā. ",
  "kv11.3:1.3": "Rūpaṃ nibbānaṃ cakkhāyatanaṃ --pe-- phoṭṭhabbāyatanan ti? ",
  "kv11.3:1.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv11.3:1.5": "Ñāṇaṃ cittavippayuttan ti? ",
  "kv11.3:1.6": "Āmantā. ",
  "kv11.3:1.7": "Paññā paññindriyaṃ paññābalaṃ sammādiṭṭhi dhammavicayasambojjhaṅgo cittavippayutto ti? ",
  "kv11.3:1.8": "Na h' evaṃ vattabbe --pe-- ",
  "kv11.3:1.9": "Paññā paññindriyaṃ paññābalaṃ sammādiṭṭhi dhammavicayasambojjhaṅgo cittasampayutto ti? ",
  "kv11.3:1.10": "Āmantā. ",
  "kv11.3:1.11": "Ñāṇaṃ cittasampayuttan ti? ",
  "kv11.3:1.12": "Na h' evaṃ vattabbe --pe-- 2. ",
  "kv11.3:2.1": "Ñāṇaṃ cittavippayuttan ti? ",
  "kv11.3:2.2": "Āmantā. ",
  "kv11.3:2.3": "Katamakkhandhapariyāpannan ti? Saṃkhārakkhandhapariyāpannan ",
  "kv11.3:2.4": "ti. ",
  "kv11.3:2.5": "Saṃkhārakkhandho cittavippayutto ti? ",
  "kv11.3:2.6": "Na h' evaṃ vattabbe --pe-- ",
  "kv11.3:2.7": "Saṃkhārakkhandho cittavippayutto ti? ",
  "kv11.3:2.8": "Āmantā. ",
  "kv11.3:2.9": "Vedanākkhandho, saññākkhandho cittavippayutto ti? ",
  "kv11.3:2.10": "Na h' evaṃ vattabbe --pe-- 3. ",
  "kv11.3:2.11": "Ñāṇaṃ saṃkhārakkhandhapariyāpannaṃ cittavippayuttan ti? ",
  "kv11.3:2.12": "Āmantā. ",
  "kv11.3:2.13": "Paññā saṃkhārakkhandhapariyāpannā cittavippayuttā ti? ",
  "kv11.3:2.14": "Na h' evaṃ vattabbe --pe-- ",
  "kv11.3:2.15": "Paññā saṃkhārakkhandhapariyāpannā cittasampayuttā ti? ",
  "kv11.3:2.16": "Āmantā. ",
  "kv11.3:2.17": "Ñāṇaṃ saṃkhārakkhandhapariyāpannaṃ. cittasampayuttan ti? ",
  "kv11.3:2.18": "Na h' evaṃ vattabbe --pe-- 4. ",
  "kv11.3:2.19": "Ñāṇaṃ saṃkhārakkhandhapariyāpannaṃ cittavippayuttaṃ, paññā saṃkhārakkhandhapariyāpannā cittasampayuttā ti? ",
  "kv11.3:2.20": "Āmantā. ",
  "kv11.3:2.21": "Saṃkhārakkhandho ekadeso cittasampayutto ekadeso cittavippayutto ti? ",
  "kv11.3:2.22": "Na h' evaṃ vattabbe --pe-- ",
  "kv11.3:2.23": "Saṃkhārakkhandho ekadeso cittasampayutto ekadeso cittavippayutto ti? ",
  "kv11.3:2.24": "Āmantā. ",
  "kv11.3:2.25": "Vedanākkhandho, saññākkhandho ekadeso cittasampayutto, ekadeso cittavippayutto ti? ",
  "kv11.3:2.26": "Na h' evaṃ vattabbe --pe-- 5. ",
  "kv11.3:3.1": "Na vattabbaṃ ",
  "kv11.3:3.2": "\"Ñāṇaṃ cittavippayuttan ti\"? ",
  "kv11.3:3.3": "Āmantā. ",
  "kv11.3:3.4": "Arahā cakkhuviññāṇasamaṅgī \"ñāṇī ti\" vattabbo ti? ",
  "kv11.3:3.5": "Āmantā. ",
  "kv11.3:3.6": "Ñāṇaṃ tena cittena sampayuttan ti? ",
  "kv11.3:3.7": "Na h' evaṃ vattabbe --pe-- ",
  "kv11.3:3.8": "Tena hi ñāṇaṃ cittavippayuttan ti. ",
  "kv11.3:4.1": "Arahā cakkhuviññāṇasamaṅgī \"paññavā ti\" vattabbo ti? ",
  "kv11.3:4.2": "Āmantā. ",
  "kv11.3:4.3": "Paññā tena cittena sampayuttā ti? ",
  "kv11.3:4.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv11.3:4.5": "Tena hi paññā cittavippayuttā ti. Nāṇaṃ cittavippayuttan ti kathā. 1. ",
  "kv11.3:4.6": ""
}
