{
  "kv11.6:0.1": "",
  "kv11.6:0.2": "",
  "kv11.6:0.3": "",
  "kv11.6:0.4": "",
  "kv11.6:1.1": "Cittasantati samādhīti? ",
  "kv11.6:1.2": "Āmantā. ",
  "kv11.6:1.3": "Atītā cittasantati samādhīti? ",
  "kv11.6:1.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv11.6:1.5": "Cittasantati samādhīti? ",
  "kv11.6:1.6": "Āmantā. ",
  "kv11.6:1.7": "Anāgatā cittasantati samādhīti? ",
  "kv11.6:1.8": "Na h' evaṃ vattabbe --pe-- ",
  "kv11.6:1.9": "",
  "kv11.6:1.10": "",
  "kv11.6:1.11": "Nanu atītaṃ niruddhaṃ, anāgataṃ ajātan ti? ",
  "kv11.6:1.12": "Āmantā. ",
  "kv11.6:1.13": "Hañci atītaṃ niruddhaṃ, anāgataṃ ajātaṃ, no vata re vattabbe ",
  "kv11.6:1.14": "\"Cittasantati samādhīti.\" 2. ",
  "kv11.6:2.1": "Ekacittakkhaṇiko samādhīti? ",
  "kv11.6:2.2": "Āmantā. ",
  "kv11.6:2.3": "Cakkhuviññāṇasamaṅgī samāpanno ti? ",
  "kv11.6:2.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv11.6:2.5": "Sotaviññāṇasamaṅgī --pe-- ",
  "kv11.6:2.6": "ghanāviññāṇasamaṅgī -- pe -- ",
  "kv11.6:2.7": "jivhāviññāṇasamaṅgī --pe-- ",
  "kv11.6:2.8": "kāyaviññāṇasamaṅgī --pe-- ",
  "kv11.6:2.9": "akusalacittasamaṅgī --pe-- ",
  "kv11.6:2.10": "rāgasahagatacittasamaṅgī -- pe -- ",
  "kv11.6:2.11": "dosasahagatacittasamaṅgī --pe-- ",
  "kv11.6:2.12": "mohasahagatacittasamaṅgī --pe-- ",
  "kv11.6:2.13": "anottappasahagatacittasamaṅgī samāpanno ti? ",
  "kv11.6:2.14": "Na h' evaṃ vattabbe --pe-- 3. ",
  "kv11.6:3.1": "Cittasantati samādhīti? ",
  "kv11.6:3.2": "Āmantā. ",
  "kv11.6:3.3": "Akusalacittasantati samādhīti? ",
  "kv11.6:3.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv11.6:3.5": "Rāgasahagatā --pe-- ",
  "kv11.6:3.6": "dosasahagatā --pe-- ",
  "kv11.6:3.7": "mohasahagatā --pe-- ",
  "kv11.6:3.8": "anottappasahagatā cittasantati samādhīti? ",
  "kv11.6:3.9": "Na h' evaṃ vattabbe --pe-- 4. ",
  "kv11.6:4.1": "Na vattabbaṃ ",
  "kv11.6:4.2": "\"Cittasantati samādhīti\"? ",
  "kv11.6:4.3": "Āmantā. ",
  "kv11.6:4.4": "Nanu vuttaṃ Bhagavatā -- ",
  "kv11.6:4.5": "\"Ahaṃ kho āvuso Nigaṇha pahomi aniñjamāno kāyena abhāsamāno vācaṃ satta rattindivāni ekantasukhapaṭisaṃvedī viharitun ti.\" ",
  "kv11.6:4.6": "Atth' eva suttanto ti? ",
  "kv11.6:4.7": "Āmantā. ",
  "kv11.6:4.8": "Tena hi cittasantati samādhīti. ",
  "kv11.6:4.9": "Samādhikathā. 1. "
}
