  "kv11.7:1.1": "Dhammaṭṭhitatā parinipphannā ti? ",
  "kv11.7:1.2": "Āmantā. ",
  "kv11.7:1.3": "Tāya ṭhitatā parinipphannā ti? ",
  "kv11.7:1.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv11.7:1.5": "Tāya ṭhitatā parinipphannā ti? ",
  "kv11.7:1.6": "Āmantā. ",
  "kv11.7:1.7": "Tāya tāy' eva n' atthi dukkhass' antakiriyā, n' atthi vaṭṭūpacchedo, n' atthi anupādāparinibbānan ti? ",
  "kv11.7:1.8": "Na h' evaṃ vattabbe --pe-- 2. ",
  "kv11.7:2.1": "Rūpassa ṭhitatā parinipphannā ti? ",
  "kv11.7:2.2": "Āmantā. ",
  "kv11.7:2.3": "Tāya ṭhitatā parinipphannā ti? ",
  "kv11.7:2.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv11.7:2.5": "Tāya ṭhitatā parinipphannā ti? ",
  "kv11.7:2.6": "Āmantā. ",
  "kv11.7:2.7": "Tāya tāy' eva n' atthi dukkhass' antakiriyā, n' atthi vaṭṭūpacchedo, n' atthi anupādāparinibbānan ti? ",
  "kv11.7:2.8": "Na h' evaṃ vattabbe --pe-- 3. ",
  "kv11.7:3.1": "Vedanāya ṭhitatā --pe-- ",
  "kv11.7:3.2": "saññāya ṭhitatā --pe-- ",
  "kv11.7:3.3": "saṃkhārānaṃ ṭhitatā --pe-- ",
  "kv11.7:3.4": "viññāṇassa ṭhitatā parinipphannā ti? ",
  "kv11.7:3.5": "Āmantā. ",
  "kv11.7:3.6": "Tāya ṭhitatā parinipphannā ti? ",
  "kv11.7:3.7": "Na h' evaṃ vattabbe --pe-- ",
  "kv11.7:3.8": "Tāya ",
  "kv11.7:3.9": "",
  "kv11.7:3.10": "tāy' eva n' atthi dukkhass' anakiriyā n' atthi vaṭṭūpacchedo n' atthi anuppādāparinibbānan ti? ",
  "kv11.7:3.11": "Na h' evaṃ vattabbe --pe-- ",
  "kv11.7:3.12": "Dhammaṭṭhitatākathā. 1. "
