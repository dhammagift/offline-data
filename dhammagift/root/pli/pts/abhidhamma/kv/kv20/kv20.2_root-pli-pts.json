  "kv20.2:1.1": "puthujjanassa ñāṇan ti? ",
  "kv20.2:1.2": "Āmantā. ",
  "kv20.2:1.3": "N' atthi puthujjanassa paññā pajānanā vicayo pavicayo dhammavicayo sallakkhaṇā upalakkhaṇā paccupalakkhaṇā ti? ",
  "kv20.2:1.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv20.2:1.5": "Nanu atthi puthujjanassa paññā --pe-- ",
  "kv20.2:1.6": "paccupalakkhaṇā ti? ",
  "kv20.2:1.7": "Āmantā. ",
  "kv20.2:1.8": "Hañci atthi puthujjanassa paññā --pe-- ",
  "kv20.2:1.9": "paccupalakkhaṇā, no vata re vattabbe ",
  "kv20.2:1.10": "\"N' atthi puthujjanassa ñāṇan ti.\" 2. ",
  "kv20.2:2.1": "N' atthi puthujjanassa ñāṇan ti? ",
  "kv20.2:2.2": "Āmantā. ",
  "kv20.2:2.3": "Puthujjano paṭhamaṃ jhānaṃ samāpajjeyyāti? ",
  "kv20.2:2.4": "Āmantā. ",
  "kv20.2:2.5": "Hañci puthujjano paṭhamaṃ jhānaṃ samāpajjeyya, no vata re vattabbe ",
  "kv20.2:2.6": "\"N' atthi puthujjanassa ñāṇan ti.\" ",
  "kv20.2:3.1": "Puthujjano dutiyaṃ jhānaṃ --pe-- ",
  "kv20.2:3.2": "tatiyaṃ jhānaṃ -- pe -- ",
  "kv20.2:3.3": "catutthaṃ jhānaṃ --pe-- ",
  "kv20.2:3.4": "ākāsānañcāyatanaṃ samāpajjeyya, ",
  "kv20.2:3.5": "viññāṇañcāyatanaṃ ākiñcaññāyatanaṃ nevasaññānāsaññāyatanaṃ samāpajjeyya, ",
  "kv20.2:3.6": "puthujjano dānaṃ dadeyya --pe-- ",
  "kv20.2:3.7": "cīvaraṃ, ",
  "kv20.2:3.8": "piṇḍapātaṃ, ",
  "kv20.2:3.9": "senāsanaṃ, ",
  "kv20.2:3.10": "gilānapaccayabhesajjaparikkhāraṃ dadeyyāti? ",
  "kv20.2:3.11": "Āmantā. ",
  "kv20.2:3.12": "Hañci puthujjano gilānapaccayabhesajjaparikkhāraṃ dadeyya, no vata re vattabbe ",
  "kv20.2:3.13": "\"N' ",
  "kv20.2:4.1": "atthi puthujjanassa ñāṇan ti.\" 3. Atthi puthujjanassa ñāṇan ti? ",
  "kv20.2:4.2": "Āmantā. ",
  "kv20.2:4.3": "Puthujjano tena ñāṇena dukkhaṃ parijānāti, samudayaṃ pajahati, nirodhaṃ sacchikaroti, maggaṃ bhāvetīti? ",
  "kv20.2:4.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv20.2:4.5": "Ñāṇakathā. 1. N' atthi "
}
