  "kv20.1:0.3": "",
  "kv20.1:0.4": "",
  "kv20.1:1.1": "Asañcicca mātaraṃ jīvitā voropetvā ānantariko hotīti? ",
  "kv20.1:1.2": "Āmantā. ",
  "kv20.1:1.3": "Asañcicca pāṇaṃ hantvā pāṇātipātī hotīti? ",
  "kv20.1:1.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv20.1:1.5": "Asañcicca mātaraṃ jīvitā voropetvā ānantariko hotīti? ",
  "kv20.1:1.6": "Āmantā. ",
  "kv20.1:1.7": "Asañcicca adinnaṃ ādiyitvā --pe-- ",
  "kv20.1:1.8": "musābhaṇitvā musāvādī hotīti? ",
  "kv20.1:1.9": "Na h' evaṃ vattabbe --pe-- 2. ",
  "kv20.1:2.1": "Asañcicca pāṇaṃ hantvā pāṇātipātī na hotīti? ",
  "kv20.1:2.2": "Āmantā. ",
  "kv20.1:2.3": "Asañcicca mātaraṃ jīvitā voropetvā ānantariko na hotīti? ",
  "kv20.1:2.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv20.1:2.5": "Asañcicca adinnaṃ ādiyitvā --pe-- ",
  "kv20.1:2.6": "musābhaṇitvā musāvādī na hotīti? ",
  "kv20.1:2.7": "Āmantā. ",
  "kv20.1:2.8": "Asañcicca mātaraṃ jīvitā voropetvā ānantariko na hotīti? ",
  "kv20.1:2.9": "Na h' evaṃ vattabbe --pe-- 3. ",
  "kv20.1:3.1": "Asañcicca mātaraṃ jīvitā voropetvā ānantariko hotīti? ",
  "kv20.1:3.2": "Āmantā. ",
  "kv20.1:3.3": "\"Asañcicca mātaraṃ jīvitā voropetvā ānantariko hotīti,\" ",
  "kv20.1:3.4": "atth' eva suttanto ti? ",
  "kv20.1:3.5": "N' atthi. ",
  "kv20.1:3.6": "\"Sañcicca mātaraṃ jīvitā voropetvā ānantariko hotīti,\" ",
  "kv20.1:3.7": "atth' eva suttanto ti? ",
  "kv20.1:3.8": "Āmantā. ",
  "kv20.1:3.9": "Hañci \"sañcicca mātaraṃ jīvitā voropetvā ānantariko hotīti,\" ",
  "kv20.1:3.10": "atth' eva suttanto, no vata re vattabbe ",
  "kv20.1:3.11": "\"Asañcicca mātaraṃ jīvitā voropetvā ānantariko hotīti.\" 4. ",
  "kv20.1:4.1": "Na vattabbaṃ ",
  "kv20.1:4.2": "\"Mātughātako ānantariko ti\"? ",
  "kv20.1:4.3": "Āmantā. ",
  "kv20.1:4.4": "Nanu mātā jīvitā voropitā ti? ",
  "kv20.1:4.5": "Āmantā. ",
  "kv20.1:4.6": "Hañci mātā jīvitā voropitā, tena vata re vattabbe ",
  "kv20.1:4.7": "Mātughātako ānantariko ti.\" 5. ",
  "kv20.1:5.1": "Na vattabbaṃ ",
  "kv20.1:5.2": "\"Pitughātako ānantariko ti\"? ",
  "kv20.1:5.3": "Āmantā. ",
  "kv20.1:5.4": "Nanu pitā jīvitā voropito ti? ",
  "kv20.1:5.5": "Āmantā. ",
  "kv20.1:5.6": "Hañci pitā jīvitā voropito, tena vata re vattabbe ",
  "kv20.1:5.7": "\"Pitughātako ānantariko ti.\" 6. ",
  "kv20.1:6.1": "Na vattabbaṃ ",
  "kv20.1:6.2": "\"Arahantaghātako ānantariko ti\"? ",
  "kv20.1:6.3": "Āmantā. ",
  "kv20.1:6.4": "Nanu Arahā jīvitā voropito ti? ",
  "kv20.1:6.5": "Āmantā. ",
  "kv20.1:6.6": "Hañci Arahā jīvitā voropito, tena vata re vattabbe ",
  "kv20.1:6.7": "\"Arahantaghātako ānantariko ti.\" 7. ",
  "kv20.1:7.1": "Na vattabbaṃ ",
  "kv20.1:7.2": "\"Lohituppādako ānantariko ti\"? ",
  "kv20.1:7.3": "Āmantā. ",
  "kv20.1:7.4": "Nanu Tathāgatassa lohitaṃ uppāditan ti? ",
  "kv20.1:7.5": "Āmantā. ",
  "kv20.1:7.6": "Hañci Tathāgatassa lohitaṃ uppāditan, tena vata re vattabbe ",
  "kv20.1:7.7": "\"Lohituppādako ānantariko ti.\" 8. ",
  "kv20.1:8.1": "Saṃghabhedako ānantariko ti? ",
  "kv20.1:8.2": "Āmantā. ",
  "kv20.1:8.3": "Sabbe Saṃghabhedakā ānantarikā ti? ",
  "kv20.1:8.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv20.1:8.5": "Sabbe Saṃghabhedakā ānantarikā ti? ",
  "kv20.1:8.6": "Āmantā. ",
  "kv20.1:8.7": "Dhammasaññī Saṃghabhedako ānantariko ti? ",
  "kv20.1:8.8": "Na h' evaṃ vattabbe --pe-- ",
  "kv20.1:9.1": "Dhammasaññī Saṃghabhedako ānantariko ti? ",
  "kv20.1:9.2": "Āmantā. ",
  "kv20.1:9.3": "Nanu vuttaṃ Bhagavatā -- ",
  "kv20.1:9.4": "\"Atth' Upāli Saṃghabhedako āpāyiko nerayiko kappaṭṭho atekiccho, ",
  "kv20.1:9.5": "atth' Upāli Saṃghabhedako na āpāyiko na nerayiko na kappaṭṭho na atekiccho ti.\" ",
  "kv20.1:9.6": "Atth' eva suttanto ti? ",
  "kv20.1:9.7": "Āmantā. ",
  "kv20.1:9.8": "Tena hi na vattabbaṃ ",
  "kv20.1:9.9": "\"Dhammasaññī Saṃghabhedako ānantariko ti.\" 9. ",
  "kv20.1:10.1": "Na vattabbaṃ ",
  "kv20.1:10.2": "\"Dhammasaññī Saṃghabhedako ānantariko ti\"? ",
  "kv20.1:10.3": "Āmantā. ",
  "kv20.1:10.4": "Nanu vuttaṃ Bhagavatā -- ",
  "kv20.1:11.1": "\"Āpāyiko nerayiko ",
  "kv20.1:11.2": "kappaṭṭho Saṃghabhedako ",
  "kv20.1:11.3": "Vaggarato adhammaṭṭho ",
  "kv20.1:11.4": "yogakkhemato dhaṃsati ",
  "kv20.1:11.5": "Saṃghaṃ samaggaṃ bhetvāna ",
  "kv20.1:11.6": "kappaṃ nirayamhi paccatīti.\" ",
  "kv20.1:12.1": "Atth' eva suttanto ti? ",
  "kv20.1:12.2": "Āmantā. ",
  "kv20.1:12.3": "Tena hi Saṃgabhedako ānantariko ti. ",
  "kv20.1:12.4": "Asañciccakathā. 1. N' atthi "
}
