  "kv23.3:0.3": "",
  "kv23.3:0.4": "",
  "kv23.3:1.1": "Bodhisatto issariyakāmakārikāhetu vinipātaṃ gacchatīti? ",
  "kv23.3:1.2": "Āmantā. ",
  "kv23.3:1.3": "Bodhisatto issariyakāmakārikāhetu nirayaṃ gacchati, ",
  "kv23.3:1.4": "sañjīvaṃ gacchati, ",
  "kv23.3:1.5": "kālasuttaṃ gacchati, ",
  "kv23.3:1.6": "tāpanaṃ gacchati, ",
  "kv23.3:1.7": "patāpanaṃ gacchati, ",
  "kv23.3:1.8": "saṃghātakaṃ gacchati, ",
  "kv23.3:1.9": "roruvaṃ gacchati, ",
  "kv23.3:1.10": "avīciṃ gacchatīti? ",
  "kv23.3:1.11": "Na h' evaṃ vattabbe --pe-- ",
  "kv23.3:2.1": "Bodhisatto issariyakāmakārikāhetu vinipātaṃ gacchatīti? ",
  "kv23.3:2.2": "Āmantā. ",
  "kv23.3:2.3": "Bodhisatto issariyakāmakārikāhetu vinipātaṃ gacchatīti, ",
  "kv23.3:2.4": "atth' eva suttanto ti? ",
  "kv23.3:2.5": "N' atthi. ",
  "kv23.3:2.6": "Hañci Bodhisatto issariyakāmakārikāhetu vinipātaṃ gacchatīti, ",
  "kv23.3:2.7": "n' atth' eva suttanto, no vata re vattabbe ",
  "kv23.3:2.8": "Bodhisatto issariyakāmakārikāhetu vinipātaṃ gacchatīti.\" 2. ",
  "kv23.3:3.1": "Bodhisatto issariyākāmakārikāhetu gabbhaseyyaṃ okkamatīti? ",
  "kv23.3:3.2": "",
  "kv23.3:3.3": "Bodhisatto issariyakāmakārikāhetu nirayaṃ upapajjeyya, tiracchānayoniṃ upapajjeyyāti? ",
  "kv23.3:3.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv23.3:4.1": "Bodhisatto issariyakāmakārikāhetu gabbhaseyyaṃ okkamatīti? ",
  "kv23.3:4.2": "Āmantā. ",
  "kv23.3:4.3": "Bodhisatto iddhimā ti? ",
  "kv23.3:4.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv23.3:4.5": "Bodhisatto iddhimā ti? ",
  "kv23.3:4.6": "Āmantā. ",
  "kv23.3:4.7": "Bodhisattena chandiddhipādo bhāvito --pe-- ",
  "kv23.3:4.8": "viriyiddhipādo --pe-- ",
  "kv23.3:4.9": "cittiddhipādo --pe-- ",
  "kv23.3:4.10": "vīmaṃsiddhipādo bhāvito ti? ",
  "kv23.3:4.11": "Na h' evaṃ vattabbe --pe-- ",
  "kv23.3:5.1": "Bodhisatto issariyakāmakārikāhetu gabbhaseyyaṃ okkamatīti? ",
  "kv23.3:5.2": "Āmantā. ",
  "kv23.3:5.3": "Bodhisatto issariyakāmakārikāhetu gabbhaseyyaṃ okkamatīti, ",
  "kv23.3:5.4": "atth' eva suttanto ti? ",
  "kv23.3:5.5": "N' atthi ",
  "kv23.3:5.6": "Hañci Bodhisatto issariyakāmakārikāhetu gabbhaseyyaṃ okkamatīti, ",
  "kv23.3:5.7": "n' atthi' eva suttanto, no vata re vattabbe ",
  "kv23.3:5.8": "Bodhisatto issariyakāmakārikāhetu gabbhaseyyaṃ okkamatīti.\" 3. ",
  "kv23.3:6.1": "Bodhisatto issariyakāmakārikāhetu dukkarakārikaṃ akāsīti? ",
  "kv23.3:6.2": "Āmantā. ",
  "kv23.3:6.3": "Bodhisatto issariyakāmakārikāhetu sassato loko ti pacchāgacchi, ",
  "kv23.3:6.4": "asassato loko ti --pe-- ",
  "kv23.3:6.5": "antavā loko ti --pe-- ",
  "kv23.3:6.6": "anantavā loko ti ",
  "kv23.3:6.7": "",
  "kv23.3:6.8": "",
  "kv23.3:6.9": "",
  "kv23.3:6.10": "",
  "kv23.3:6.11": "--pe-- ",
  "kv23.3:6.12": "taṃ jīvaṃ taṃ sarīran ti, aññaṃ jīvaṃ aññaṃ sarīran ti, hoti Tathāgato paraṃ maraṇā ti, na hoti Tathāgato paraṃ maraṇā ti, hoti ca na ca hoti Tathāgato paraṃ maraṇā ti, n' eva hoti na na hoti Tathāgato paraṃ maraṇā ti pacchāgacchīti? ",
  "kv23.3:6.13": "Na h' evaṃ vattabbe --pe-- ",
  "kv23.3:7.1": "Bodhisatto issariyakāmakārikāhetu dukkarakārikaṃ akāsīti? ",
  "kv23.3:7.2": "Āmantā. ",
  "kv23.3:7.3": "Bodhisatto issariyakāmakārikāhetu dukkarakārikaṃ akāsīti, ",
  "kv23.3:7.4": "atth' eva suttanto ti? ",
  "kv23.3:7.5": "N' atthi. ",
  "kv23.3:7.6": "Hañci Bodhisatto issariyakāmakārikāhetu dukkarakārikaṃ akāsīti, ",
  "kv23.3:7.7": "n' atthi' eva suttanto, no vata re vattabbe ",
  "kv23.3:7.8": "\"Bodhisatto issariyakāmakārikāhetu dukkarakārikaṃ akāsīti.\" 4. ",
  "kv23.3:8.1": "Bodhisatto issariyakāmakārikāhetu aparantapaṃ akāsi, aññaṃ satthāraṃ uddisīti? ",
  "kv23.3:8.2": "Āmantā. ",
  "kv23.3:8.3": "Bodhisatto issariyakāmakārikāhetu sassato loko ti pacchāgacchi, asassato loko ti --pe-- ",
  "kv23.3:8.4": "anatavā loko ti --pe-- anantavā loko ti --pe-- taṃ jīvaṃ taṃ sarīran ti, aññaṃ jīvaṃ aññaṃ sarīran ti, hoti Tathāgato paraṃ maraṇā ti, na hoti Tathāgato paraṃ maraṇā ti, hoti ca na ca hoti Tathāgato paraṃ maraṇā ti, n' eva hoti na na hoti Tathāgato paraṃ maraṇā ti pacchāgacchīti? ",
  "kv23.3:8.5": "Na h' evaṃ vattabbe --pe-- ",
  "kv23.3:9.1": "Bodhisatto issariyakāmakārikāhetu aññaṃ satthāraṃ uddisīti? ",
  "kv23.3:9.2": "Āmantā. ",
  "kv23.3:9.3": "Bodhisatto issariyakāmakārikāhetu aññaṃ satthāraṃ uddisīti, ",
  "kv23.3:9.4": "atth' eva suttanto ti? ",
  "kv23.3:9.5": "N' atthi. ",
  "kv23.3:9.6": "Hañci Bodhisatto issariyakāmakārikāhetu aññaṃ satthāraṃ uddisīti, ",
  "kv23.3:9.7": "n' atth' eva suttanto, no vata re vattabbe ",
  "kv23.3:9.8": "\"Bodhisatto issariyakāmakārikāhetu aññaṃ satthāraṃ uddisīti.\" ",
  "kv23.3:9.9": "Issariyakāmakārikākathā. 1. "
}
