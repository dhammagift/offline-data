  "kv23.4:1.1": "Atthi na rāgo rāgapaṭirūpako ti? ",
  "kv23.4:1.2": "Āmantā. ",
  "kv23.4:1.3": "Atthi na phasso phassapaṭirūpako, ",
  "kv23.4:1.4": "atthi na vedanā vedanāpaṭirūpakā, ",
  "kv23.4:1.5": "atthi na saññā saññāpaṭirūpakā, ",
  "kv23.4:1.6": "atthi na cetanā cetanāpaṭirūpakā, ",
  "kv23.4:1.7": "atthi na cittaṃ cittapaṭirūpakaṃ, ",
  "kv23.4:1.8": "atthi na saddhā saddhāpaṭirūpakā, ",
  "kv23.4:1.9": "atthi na viriyaṃ viriyapaṭirūpakaṃ, ",
  "kv23.4:1.10": "atthi na sati satipaṭirūpakā, ",
  "kv23.4:1.11": "atthi na samādhi samādhipaṭirūpako , ",
  "kv23.4:1.12": "atthi na paññā paññāpaṭirūpakā ti? ",
  "kv23.4:1.13": "Na h' evaṃ vattabbe --pe-- 2. ",
  "kv23.4:2.1": "Atthi na doso dosapaṭirūpako, ",
  "kv23.4:2.2": "atthi na moho mohapaṭirūpako, ",
  "kv23.4:2.3": "atthi na kileso kilesapaṭirūpakā ti? ",
  "kv23.4:2.4": "Āmantā. ",
  "kv23.4:2.5": "Atthi na phasso phassapaṭirūpako --pe-- ",
  "kv23.4:2.6": "atthi na paññā paññāpaṭirūpakā ti? ",
  "kv23.4:2.7": "Na h' evaṃ vattabbe --pe-- ",
  "kv23.4:2.8": "Paṭirūpakathā. 1. "
}
