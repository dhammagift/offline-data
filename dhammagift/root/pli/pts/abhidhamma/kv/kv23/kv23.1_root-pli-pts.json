  "kv23.1:1.1": "methuno dhammo paṭisevitabbo ti? ",
  "kv23.1:1.2": "Āmantā. ",
  "kv23.1:1.3": "Ekādhippāyena asamaṇena hotabbaṃ, abhikkhunā hotabbaṃ, chinnamūlena hotabbaṃ, pārājikena hotabban ti? ",
  "kv23.1:1.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv23.1:1.5": "Ekādhippāyena methuno dhammo paṭisevitabbo ti? ",
  "kv23.1:1.6": "Āmantā. ",
  "kv23.1:1.7": "Ekādhippāyena pāṇo hantabbo, ",
  "kv23.1:1.8": "adinnaṃ ādiyitabbaṃ, ",
  "kv23.1:1.9": "musā bhaṇitabbā, ",
  "kv23.1:1.10": "pisuṇaṃ bhaṇitabbaṃ, ",
  "kv23.1:1.11": "pharusaṃ bhaṇitabbaṃ, ",
  "kv23.1:1.12": "samphappalāpitabbaṃ, ",
  "kv23.1:1.13": "sandhi cheditabbā, ",
  "kv23.1:1.14": "nillopaṃ hātabbaṃ, ",
  "kv23.1:1.15": "ekāgārikaṃ kātabbaṃ, ",
  "kv23.1:1.16": "paripanthe ṭhātabbaṃ, ",
  "kv23.1:1.17": "paradāro gantabbo, ",
  "kv23.1:1.18": "gāmaghāto kātabbo, ",
  "kv23.1:1.19": "nigamaghāto kātabbo ti? ",
  "kv23.1:1.20": "Na h' evaṃ vattabbe --pe-- ",
  "kv23.1:1.21": "Ekādhippāyakathā. 1. "
}
