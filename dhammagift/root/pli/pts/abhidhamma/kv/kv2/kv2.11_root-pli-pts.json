{
  "kv2.11:0.1": "",
  "kv2.11:0.2": "",
  "kv2.11:0.3": "",
  "kv2.11:0.4": "",
  "kv2.11:1.1": "Dve nirodhā ti? ",
  "kv2.11:1.2": "Āmantā. ",
  "kv2.11:1.3": "Dve dukkhanirodhā ti? ",
  "kv2.11:1.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv2.11:1.5": "Dve dukkhanirodhā ti? ",
  "kv2.11:1.6": "Āmantā. ",
  "kv2.11:1.7": "Dve nirodhasaccānīti? ",
  "kv2.11:1.8": "Na h' evaṃ vattabbe --pe-- ",
  "kv2.11:1.9": "Dve nirodhasaccānīti? ",
  "kv2.11:1.10": "Āmantā. ",
  "kv2.11:1.11": "Dve dukkhasaccānīti? ",
  "kv2.11:1.12": "Na h' evaṃ vattabbe --pe-- ",
  "kv2.11:1.13": "Dve nirodhasaccānīti? ",
  "kv2.11:1.14": "Āmantā. ",
  "kv2.11:1.15": "Dve samudayasaccānīti? ",
  "kv2.11:1.16": "Na h' evaṃ vattabbe --pe-- ",
  "kv2.11:1.17": "Dve nirodhasaccānīti? ",
  "kv2.11:1.18": "Āmantā. ",
  "kv2.11:1.19": "Dve maggasaccānīti? ",
  "kv2.11:1.20": "Na h' evaṃ vattabbe --pe-- ",
  "kv2.11:2.1": "Dve nirodhasaccānīti? ",
  "kv2.11:2.2": "Āmantā. ",
  "kv2.11:2.3": "Dve tāṇāni --pe-- ",
  "kv2.11:2.4": "dve leṇāni, ",
  "kv2.11:2.5": "dve saraṇāni, ",
  "kv2.11:2.6": "dve parāyanāni, ",
  "kv2.11:2.7": "dve accutāni, ",
  "kv2.11:2.8": "dve amatāni --pe--, ",
  "kv2.11:2.9": "dve nibbānānīti? ",
  "kv2.11:2.10": "Na h' evaṃ vattabbe --pe-- ",
  "kv2.11:3.1": "Dve nibbānānīti? ",
  "kv2.11:3.2": "Āmantā. ",
  "kv2.11:3.3": "Atthi dvinnaṃ nibbānānaṃ uccanīcatā hinappaṇītatā ukkaṃsāvakaṃso sīmā vā bhedo vā rājī vā antarīkā vā ti? ",
  "kv2.11:3.4": "Na h' evaṃ vattabbe --pe-- 2. ",
  "kv2.11:4.1": "Dve nirodhā ti? ",
  "kv2.11:4.2": "Āmantā. ",
  "kv2.11:4.3": "Nanu appaṭisaṃkhāniruddhe saṃkhāre paṭisaṃkhā nirodhentīti? ",
  "kv2.11:4.4": "Āmantā. ",
  "kv2.11:4.5": "Hañci appaṭisaṃkhāniruddhe saṃkhāre paṭisaṃkhā nirodhenti, no vata re vattabbe ",
  "kv2.11:4.6": "\"Dve nirodhā ti.\" 3. ",
  "kv2.11:5.1": "Na vattabbaṃ ",
  "kv2.11:5.2": "\"Dve nirodhā ti\"? ",
  "kv2.11:5.3": "Āmantā. ",
  "kv2.11:5.4": "Nanu appaṭisaṃkhāniruddhā saṃkhārā accantabhaggā, paṭisaṃkhāniruddhā saṃkhārā accantabhaggā ti? ",
  "kv2.11:5.5": "Āmantā. ",
  "kv2.11:5.6": "Hañci appaṭisaṃkhāniruddhā saṃkhārā accantabhaggā, paṭisaṃkhāniruddhā saṃkhārā accantabhaggā, tena vata re vattabbe ",
  "kv2.11:5.7": "\"Dve nirodhā ti.\" 4. ",
  "kv2.11:6.1": "Dve nirodhā ti? ",
  "kv2.11:6.2": "Āmantā. ",
  "kv2.11:6.3": "Paṭisaṃkhāniruddhā saṃkhārā ariyamaggaṃ āgamma niruddhā ti? ",
  "kv2.11:6.4": "Āmantā. ",
  "kv2.11:6.5": "Appaṭisaṃkhāniruddhā saṃkhārā ariyamaggaṃ āgamma niruddhā ti? ",
  "kv2.11:6.6": "Na h' evaṃ vattabbe --pe-- 5. ",
  "kv2.11:7.1": "Dve nirodhā ti? ",
  "kv2.11:7.2": "Āmantā. ",
  "kv2.11:7.3": "Paṭisaṃkhāniruddhā saṃkhārā na puna uppajjantīti? ",
  "kv2.11:7.4": "Āmantā. ",
  "kv2.11:7.5": "Appaṭisaṃkhāniruddhā saṃkhārā na puna uppajjantīti? ",
  "kv2.11:7.6": "Na h' evaṃ vattabbe --pe-- ",
  "kv2.11:7.7": "Tena hi na vattabbaṃ ",
  "kv2.11:7.8": "\"Dve nirodhā ti.\" ",
  "kv2.11:7.9": "Nirodhakathā ",
  "kv2.11:7.10": "",
  "kv2.11:7.11": "",
  "kv2.11:8.1": "Parūpahāro, Aññāṇaṃ, ",
  "kv2.11:8.2": "Kaṃkhā, Paravitāraṇā, ",
  "kv2.11:8.3": "Vacībhedo, Dukkhāhāro, ",
  "kv2.11:8.4": "Ṭhiti, Kukkuḷā, ",
  "kv2.11:8.5": "Saṃkhārā, Eko abhisamayo, Eko ",
  "kv2.11:8.6": "vohāro, Eko nirodho ti. 1. "
}
