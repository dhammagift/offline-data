  "kv2.7:1.1": "Ekaṃ cittaṃ divasaṃ tiṭṭhatīti? ",
  "kv2.7:1.2": "Āmantā. ",
  "kv2.7:1.3": "Upaḍḍhadivaso uppādakkhaṇo, upaḍḍhadivaso vayakkhaṇo ti? ",
  "kv2.7:1.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv2.7:2.1": "Ekaṃ cittaṃ dve divase tiṭṭhatīti? ",
  "kv2.7:2.2": "Āmantā. ",
  "kv2.7:2.3": "Divaso uppādakkhaṇo, divaso vayakkhaṇo ti? ",
  "kv2.7:2.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv2.7:3.1": "Ekaṃ cittaṃ cattāro divase tiṭṭhati --pe-- ",
  "kv2.7:3.2": "aṭṭha divase tiṭṭhati, ",
  "kv2.7:3.3": "dasa divase tiṭṭhati, ",
  "kv2.7:3.4": "vīsati divase tiṭṭhati, ",
  "kv2.7:3.5": "māsaṃ tiṭṭhati, ",
  "kv2.7:3.6": "dve māse tiṭṭhati, ",
  "kv2.7:3.7": "cattāro māse tiṭṭhati, ",
  "kv2.7:3.8": "aṭṭha māse tiṭṭhati, ",
  "kv2.7:3.9": "dasa māse tiṭṭhati, ",
  "kv2.7:3.10": "saṃvaccharaṃ tiṭṭhati, ",
  "kv2.7:3.11": "dve vassāni tiṭṭhati, ",
  "kv2.7:3.12": "cattāri vassāni tiṭṭhati, ",
  "kv2.7:3.13": "aṭṭha vassāni tiṭṭhati, ",
  "kv2.7:3.14": "dasa vassāni tiṭṭhati, ",
  "kv2.7:3.15": "vīsati vassāni tiṭṭhati, ",
  "kv2.7:3.16": "tiṃsa vassāni tiṭṭhati, ",
  "kv2.7:3.17": "cattārīsa vassāni tiṭṭhati, ",
  "kv2.7:3.18": "paññāsa vassāni tiṭṭhati, ",
  "kv2.7:3.19": "vassasataṃ tiṭṭhati, ",
  "kv2.7:3.20": "dve vassasatāni tiṭṭhati, ",
  "kv2.7:3.21": "cattāri vassasatāni tiṭṭhati, ",
  "kv2.7:3.22": "pañca vassasatāni tiṭṭhati, ",
  "kv2.7:3.23": "vassasahassaṃ tiṭṭhati, ",
  "kv2.7:3.24": "dve vassasahassāni tiṭṭhati, ",
  "kv2.7:3.25": "cattāri vassasahassāni tiṭṭhati, ",
  "kv2.7:3.26": "aṭṭha vassasahassāni tiṭṭhati, ",
  "kv2.7:3.27": "soḷasa vassasahassāni tiṭṭhati, ",
  "kv2.7:3.28": "kappaṃ tiṭṭhati, ",
  "kv2.7:3.29": "dve kappe tiṭṭhati, ",
  "kv2.7:3.30": "",
  "kv2.7:3.31": "aṭṭha kappe tiṭṭhati, ",
  "kv2.7:3.32": "soḷasa kappe tiṭṭhati, ",
  "kv2.7:3.33": "battiṃsa kappe tiṭṭhati, ",
  "kv2.7:3.34": "catusaṭṭhī kappe tiṭṭhati, ",
  "kv2.7:3.35": "pañca kappasatāni tiṭṭhati, ",
  "kv2.7:3.36": "kappasahassaṃ tiṭṭhati, ",
  "kv2.7:3.37": "dve kappasahassāni tiṭṭhati, ",
  "kv2.7:3.38": "",
  "kv2.7:3.39": "aṭṭha kappasahassāni tiṭṭhati, ",
  "kv2.7:3.40": "soḷasa kappasahassāni tiṭṭhati, ",
  "kv2.7:3.41": "vīsati kappasahassāni tiṭṭhati, ",
  "kv2.7:3.42": "cattārīsa kappasahassāni tiṭṭhati, ",
  "kv2.7:3.43": "saṭṭhikappasahassāni tiṭṭhati, --pe-- ",
  "kv2.7:3.44": "caturāsīti kappasahassāni tiṭṭhatīti? ",
  "kv2.7:3.45": "Āmantā. ",
  "kv2.7:3.46": "Dve cattārīsa kappasahassāni upādakkhaṇo, dve cattārīsa kappasahassāni vayakkhaṇo ti? ",
  "kv2.7:3.47": "Na h' evaṃ vattabbe --pe-- 2. ",
  "kv2.7:4.1": "Ekaṃ cittaṃ divasaṃ tiṭṭhatīti? ",
  "kv2.7:4.2": "Āmantā. ",
  "kv2.7:4.3": "Atth' aññe dhammā ekāhaṃ bahu pi uppajjitvā nirujjhantīti? ",
  "kv2.7:4.4": "Āmantā. ",
  "kv2.7:4.5": "Te dhammā cittena lahuparivattā ti? ",
  "kv2.7:4.6": "Na h' evaṃ vattabbe --pe-- ",
  "kv2.7:5.1": "Te dhammā cittena lahuparivattā ti? ",
  "kv2.7:5.2": "Āmantā. ",
  "kv2.7:5.3": "Nanu vuttaṃ Bhagavatā -- ",
  "kv2.7:5.4": "\"Nāhaṃ Bhikkhave aññaṃ ekaṃ dhammaṃ pi samanupassāmi evaṃ lahuparivattaṃ yathayidaṃ cittam. ",
  "kv2.7:5.5": "Yāvañ c' idaṃ Bhikkhave upamā pi na sukarā yāva lahuparivattaṃ cittan ti.\" ",
  "kv2.7:5.6": "Atth' eva suttanto ti? ",
  "kv2.7:5.7": "Āmantā. ",
  "kv2.7:5.8": "Tena hi na vattabbaṃ ",
  "kv2.7:5.9": "\"Te dhammā cittena lahuparivattā ti.\" 3. ",
  "kv2.7:6.1": "Te dhammā cittena lahuparivattā ti? ",
  "kv2.7:6.2": "Āmantā. ",
  "kv2.7:6.3": "Nanu vuttaṃ Bhagavatā -- ",
  "kv2.7:6.4": "\"Seyyathāpi Bhikkhave makkaṭo araññe pavane caramāno sākhaṃ gaṇhāti, taṃ muñcitvā aññaṃ gaṇhāti, taṃ muñcitvā aññaṃ gaṇhāti, ",
  "kv2.7:6.5": "evameva kho Bhikkhave yadidaṃ vuccati \"cittaṃ iti pi,\" \"mano iti pi,\" \"viññāṇaṃ iti pi,\" taṃ rattiyā ca divasassa ca aññad eva uppajjati, aññaṃ nirujjhatīti.\" ",
  "kv2.7:6.6": "Atth' eva suttanto ti? ",
  "kv2.7:6.7": "Āmantā. ",
  "kv2.7:6.8": "Tena hi na vattabbaṃ ",
  "kv2.7:6.9": "\"Te dhammā cittena lahuparivattā ti.\" 4. ",
  "kv2.7:7.1": "Ekaṃ cittaṃ divasaṃ tiṭṭhatīti? ",
  "kv2.7:7.2": "Āmantā. ",
  "kv2.7:7.3": "Cakkhuviññāṇaṃ divasaṃ tiṭṭhatīti? ",
  "kv2.7:7.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv2.7:7.5": "Sotaviññāṇaṃ --pe-- ",
  "kv2.7:7.6": "ghānaviññāṇaṃ, ",
  "kv2.7:7.7": "jivhāviññāṇaṃ, ",
  "kv2.7:7.8": "kāyaviññāṇaṃ, ",
  "kv2.7:7.9": "akusalaṃ cittaṃ, ",
  "kv2.7:7.10": "rāgasahagataṃ ",
  "kv2.7:7.11": "dosasahagataṃ ",
  "kv2.7:7.12": "mohasahagataṃ ",
  "kv2.7:7.13": "mānasahagataṃ ",
  "kv2.7:7.14": "diṭṭhisahagataṃ ",
  "kv2.7:7.15": "vicikicchāsahagataṃ ",
  "kv2.7:7.16": "thīnasahagataṃ ",
  "kv2.7:7.17": "uddhaccasahagataṃ ",
  "kv2.7:7.18": "ahirikasahagataṃ ",
  "kv2.7:7.19": "anottappasahagataṃ cittaṃ divasaṃ tiṭṭhatīti? ",
  "kv2.7:7.20": "Na h' evaṃ vattabbe --pe-- 5. ",
  "kv2.7:8.1": "Ekaṃ cittaṃ divasaṃ tiṭṭhatīti? ",
  "kv2.7:8.2": "Āmantā. ",
  "kv2.7:8.3": "Yen' eva cittena cakkhunā rūpaṃ passati, ten' eva cittena sotena saddaṃ suṇāti --pe-- ",
  "kv2.7:8.4": "ghānena gandhaṃ ghāyati, ",
  "kv2.7:8.5": "jivhāya rasaṃ sāyati, ",
  "kv2.7:8.6": "kāyena phoṭṭhabbaṃ phusati --pe-- ",
  "kv2.7:8.7": "manasā dhammaṃ vijānāti --pe-- ",
  "kv2.7:8.8": "yen' eva cittena manasā dhammaṃ vijānāti, ten' eva cittena cakkhunā rūpaṃ passati --pe-- ",
  "kv2.7:8.9": "sotena saddaṃ suṇāti, ",
  "kv2.7:8.10": "ghānena gandhaṃ ghāyati, ",
  "kv2.7:8.11": "jivhāya rasaṃ sāyati, ",
  "kv2.7:8.12": "kāyena phoṭṭhabbaṃ phusatīti? ",
  "kv2.7:8.13": "Na h' evaṃ vattabbe --pe-- 6. ",
  "kv2.7:9.1": "Ekaṃ cittaṃ divasaṃ tiṭṭhatīti? ",
  "kv2.7:9.2": "Āmantā. ",
  "kv2.7:9.3": "Yen' eva cittena abhikkamati ten' eva cittena paṭikkamati, ",
  "kv2.7:9.4": "yen' eva cittena paṭikkamati ten' eva cittena abhikkamati, ",
  "kv2.7:9.5": "yen' eva cittena āloketi ten' eva cittena viloketi. ",
  "kv2.7:9.6": "yen' eva cittena viloketi ten' eva cittena āloketi, ",
  "kv2.7:9.7": "yen' eva cittena sammiñjeti ten' eva cittena pasāreti, ",
  "kv2.7:9.8": "yen' eva cittena pasāreti ten' eva cittena sammiñjetīti? ",
  "kv2.7:9.9": "Na h' evaṃ vattabbe --pe-- 7. ",
  "kv2.7:10.1": "Ākāsānañcāyatanūpagānaṃ devānaṃ ekaṃ cittaṃ yāvatāyukaṃ tiṭṭhatīti? ",
  "kv2.7:10.2": "Āmantā. ",
  "kv2.7:10.3": "Manussānaṃ ekaṃ cittaṃ yāvatāyukaṃ tiṭṭhatīti? ",
  "kv2.7:10.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv2.7:11.1": "Ākāsānañcāyatanūpagānaṃ devānaṃ ekaṃ cittaṃ yāvatāyukaṃ tiṭṭhatīti? ",
  "kv2.7:11.2": "Āmantā. ",
  "kv2.7:11.3": "Cātummahārājikānaṃ devānaṃ --pe-- ",
  "kv2.7:11.4": "Tāvatiṃsānaṃ devānaṃ, ",
  "kv2.7:11.5": "Yāmānaṃ devānaṃ, ",
  "kv2.7:11.6": "Tusitānaṃ devānaṃ, ",
  "kv2.7:11.7": "Nimmānaratīnaṃ devānaṃ, ",
  "kv2.7:11.8": "Paranimmitavasavattīnaṃ devānaṃ, ",
  "kv2.7:11.9": "Brahmapārisajjānaṃ devānaṃ, ",
  "kv2.7:11.10": "Brahmaparohitānaṃ devānaṃ, ",
  "kv2.7:11.11": "Mahābrahmānaṃ devānaṃ, ",
  "kv2.7:11.12": "Parittābhānaṃ devānaṃ, ",
  "kv2.7:11.13": "Appamāṇābhānaṃ devānaṃ, ",
  "kv2.7:11.14": "Ābhassarānaṃ devānaṃ, ",
  "kv2.7:11.15": "Parittasubhānaṃ devānaṃ, ",
  "kv2.7:11.16": "Appamāṇasubhānaṃ, devānaṃ, ",
  "kv2.7:11.17": "Subhakiṇṇānaṃ devānaṃ, ",
  "kv2.7:11.18": "Vehapphalānaṃ devānaṃ, ",
  "kv2.7:11.19": "Avihānaṃ devānaṃ, ",
  "kv2.7:11.20": "Atappānaṃ devānaṃ, ",
  "kv2.7:11.21": "Sudassānaṃ devānaṃ, ",
  "kv2.7:11.22": "Sudassīnaṃ devānaṃ -- pe -- ",
  "kv2.7:11.23": "Akaniṭṭhānaṃ devānaṃ ekaṃ cittaṃ yāvatāyukaṃ tiṭṭhatīti? ",
  "kv2.7:11.24": "Na h' evaṃ vattabbe --pe-- 8. ",
  "kv2.7:12.1": "Ākāsānañcāyatanūpagānaṃ devānaṃ vīsati kappasahassāni āyuppamāṇaṃ, ākāsānañcāyatanūpagānaṃ devānaṃ ekaṃ cittaṃ vīsati kappasahassāni tiṭṭhatīti? ",
  "kv2.7:12.2": "Āmantā. ",
  "kv2.7:12.3": "Manussānaṃ vassasataṃ āyuppamāṇaṃ, manussānaṃ ekaṃ cittaṃ vassasataṃ tiṭṭhatīti? ",
  "kv2.7:12.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv2.7:13.1": "Ākāsānañcāyatanūpagānaṃ devānaṃ vīsati kappasahassāni āyuppamāṇaṃ, ākāsānañcāyatanūpagānaṃ devānaṃ ekaṃ cittaṃ vīsati kappasahassāni tiṭṭhatīti? ",
  "kv2.7:13.2": "Āmantā. ",
  "kv2.7:13.3": "Cātummahārājikānaṃ devānaṃ pañca vassasatāni āyuppamāṇaṃ, cātummahārājikānaṃ devānaṃ ekaṃ cittaṃ pañca vassasatāni tiṭṭhati --pe-- ",
  "kv2.7:13.4": "vassasahassaṃ tiṭṭhati, ",
  "kv2.7:13.5": "dve vassasahassāni tiṭṭhati, ",
  "kv2.7:13.6": "cattāri vassasahassāni tiṭṭhati, ",
  "kv2.7:13.7": "aṭṭha vassasahassāni tiṭṭhati, ",
  "kv2.7:13.8": "soḷasa vassasahassāni tiṭṭhati, ",
  "kv2.7:13.9": "kappassa tatiyabhāgaṃ tiṭṭhati, ",
  "kv2.7:13.10": "upaḍḍhakappaṃ tiṭṭhati, ",
  "kv2.7:13.11": "ekaṃ kappaṃ tiṭṭhati, ",
  "kv2.7:13.12": "dve kappe tiṭṭhati, ",
  "kv2.7:13.13": "cattāro kappe tiṭṭhati, ",
  "kv2.7:13.14": "aṭṭha kappe tiṭṭhati, ",
  "kv2.7:13.15": "soḷasa kappe tiṭṭhati, ",
  "kv2.7:13.16": "battiṃsa kappe tiṭṭhati, ",
  "kv2.7:13.17": "catusaṭṭhī kappe tiṭṭhati, ",
  "kv2.7:13.18": "pañca kappasatāni tiṭṭhati, ",
  "kv2.7:13.19": "kappasahassaṃ tiṭṭhati, ",
  "kv2.7:13.20": "dve kappasahassāni tiṭṭhati, ",
  "kv2.7:13.21": "cattāri kappasahassāni tiṭṭhati, ",
  "kv2.7:13.22": "aṭṭha kappasahassāni tiṭṭhati ",
  "kv2.7:13.23": "--pe-- Akaniṭṭhagānaṃ devānaṃ soḷasa kappasahassāni āyuppamāṇaṃ, Akaniṭṭhagānaṃ devānaṃ ekaṃ cittaṃ soḷasa kappasahassāni tiṭṭhatīti? ",
  "kv2.7:13.24": "Na h' evaṃ vattabbe --pe-- 9. ",
  "kv2.7:14.1": "Ākāsānañcāyatanūpagānaṃ devānaṃ cittaṃ muhuttaṃ muhuttaṃ uppajjati, muhuttaṃ muhuttaṃ nirujjhatīti? ",
  "kv2.7:14.2": "Āmantā. ",
  "kv2.7:14.3": "Ākāsānañcāyatanūpagā devā muhuttaṃ muhuttaṃ cavanti, muhuttaṃ muhuttaṃ uppajjantīti? ",
  "kv2.7:14.4": "Na h' evaṃ vattabbe --pe-- 10. ",
  "kv2.7:15.1": "Ākāsānañcāyatanūpagānaṃ devānaṃ ekaṃ cittaṃ yāvatāyukaṃ tiṭṭhatīti? ",
  "kv2.7:15.2": "Āmantā. ",
  "kv2.7:15.3": "Ākāsānañcāyatanūpagā devā yen' eva cittena uppajjanti, ten' eva cittena cavantīti? ",
  "kv2.7:15.4": "Na h' evaṃ vattabbe --pe-- ",
  "kv2.7:15.5": "Cittaṭṭhikathā. 1. "
}
