  "patthana18.26:0.3": "",
  "patthana18.26:1.1": "dhammassa . . . Ārammaṇādhipati, sahajātādhipati. ",
  "patthana18.26:2.1": "Ārammaṇādhipati: -- ",
  "patthana18.26:3.1": "dānaṃ, sīlaṃ, uposathakammaṃ, ",
  "patthana18.26:4.1": "taṃ garuṃ ",
  "patthana18.26:5.1": "katvā paccavekkhati assādeti, abhinandati; taṃ garuṃ ",
  "patthana18.26:6.1": "katvā rāgo. diṭṭhi . . . "
}
