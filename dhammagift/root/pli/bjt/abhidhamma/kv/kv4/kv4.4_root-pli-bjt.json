  "kv4.4:0.4": "4. 4. samannāgatakathā. ",
  "kv4.4:1.1": "arahā catūhi phalehi samannāgato’ti. ",
  "kv4.4:1.2": "āmantā. ",
  "kv4.4:1.3": "arahā catūhi phassehi catūhi vedanāhi catūhi saññāhi catūhi cetanāhi catūhi cittehi catūhi saddhāhi catūhi viriyehi catūhi satīhi catūhi samādhīhi catūhi paññāhi samannāgato’ti. ",
  "kv4.4:1.4": "na hevaṃ vattabbe …pe… ",
  "kv4.4:2.1": "anāgāmī tīhi phalehi samannāgato’ti. ",
  "kv4.4:2.2": "āmantā. ",
  "kv4.4:2.3": "anāgāmī tīhi phassehi …pe… tīhi paññāhi samannāgato’ti. ",
  "kv4.4:2.4": "na hevaṃ vattabbe …pe… ",
  "kv4.4:3.1": "sakadāgāmī dvīhi phalehi samannāgato’ti. ",
  "kv4.4:3.2": "āmantā. ",
  "kv4.4:3.3": "sakadāgāmī dvīhi phassehi …pe… dvīhi paññāhi samannāgato’ti. ",
  "kv4.4:3.4": "na hevaṃ vattabbe …pe… ",
  "kv4.4:4.1": "arahā sotāpattiphalena samannāgato’ti. ",
  "kv4.4:4.2": "āmantā. ",
  "kv4.4:4.3": "arahā sotāpanno sattakkhattuparamo kolaṃkolo ekabījī’ti. ",
  "kv4.4:4.4": "na hevaṃ vattabbe …pe… ",
  "kv4.4:4.5": "arahā sakadāgāmiphalena samannāgato’ti. ",
  "kv4.4:4.6": "āmantā. ",
  "kv4.4:4.7": "arahā sakadāgāmī’ti. ",
  "kv4.4:4.8": "na hevaṃ vattabbe …pe… ",
  "kv4.4:4.9": "arahā anāgāmiphalena samannāgato’ti. ",
  "kv4.4:4.10": "āmantā. ",
  "kv4.4:4.11": "arahā anāgāmī antarāparinibbāyī upahaccaparinibbāyī asaṃkhāraparinibbāyī sasaṃkhāraparinibbāyī uddhaṃsoto akaniṭṭhagāmī’ti. ",
  "kv4.4:4.12": "na hevaṃ vattabbe …pe… ",
  "kv4.4:5.1": "anāgāmī sotāpattiphalena samannāgato’ti. ",
  "kv4.4:5.2": "āmantā. ",
  "kv4.4:5.3": "anāgāmī sotāpanno sattakkhattuparamo kolaṃkolo ekabījī’ti. ",
  "kv4.4:5.4": "na hevaṃ vattabbe …pe… ",
  "kv4.4:5.5": "anāgāmī sakadāgāmiphalena samannāgato’ti. ",
  "kv4.4:5.6": "āmantā. ",
  "kv4.4:5.7": "anāgāmī sakadāgāmī’ti. ",
  "kv4.4:5.8": "na hevaṃ vattabbe …pe… ",
  "kv4.4:6.1": "sakadāgāmī sotāpattiphalena samannāgato’ti. ",
  "kv4.4:6.2": "āmantā. ",
  "kv4.4:6.3": "sakadāgāmī sotāpanno, sattakkhattuparamo kolaṃkolo ekabījī’ti. ",
  "kv4.4:6.4": "na hevaṃ vattabbe …pe… ",
  "kv4.4:7.1": "sotāpattiphalena samannāgato ‘sotāpanno’ti vattabbo’ti. ",
  "kv4.4:7.2": "āmantā. ",
  "kv4.4:7.3": "arahā sotāpattiphalena samannāgato’ti. ",
  "kv4.4:7.4": "āmantā. ",
  "kv4.4:7.5": "sveva arahā sotāpanno’ti. ",
  "kv4.4:7.6": "na hevaṃ vattabbe …pe… ",
  "kv4.4:8.1": "sakadāgāmiphalena samannāgato ‘sakadāgāmī’ti vattabboti. ",
  "kv4.4:8.2": "āmantā. ",
  "kv4.4:8.3": "arahā sakadāgāmiphalena samannāgato’ti. ",
  "kv4.4:8.4": "āmantā. ",
  "kv4.4:8.5": "sve’va arahā so sakadāgāmī’ti. ",
  "kv4.4:8.6": "na hevaṃ vattabbe …pe… ",
  "kv4.4:9.1": "anāgāmiphalena samannāgato anāgāmī’ti vattabboti. ",
  "kv4.4:9.2": "āmantā. ",
  "kv4.4:9.3": "arahā anāgāmiphalena samannāgato’ti. ",
  "kv4.4:9.4": "āmantā. ",
  "kv4.4:9.5": "sve’va arahā so anāgāmī’ti. ",
  "kv4.4:9.6": "na hevaṃ vattabbe …pe… ",
  "kv4.4:10.1": "sotāpattiphalena samannāgato ‘sotāpanno’ti vattabbo’ti. ",
  "kv4.4:10.2": "āmantā. ",
  "kv4.4:10.3": "anāgāmī sotāpattiphalena samannāgato’ti. ",
  "kv4.4:10.4": "āmantā. ",
  "kv4.4:10.5": "sve’va anāgāmī so sotāpanno’ti. ",
  "kv4.4:10.6": "na hevaṃ vattabbe …pe… ",
  "kv4.4:11.1": "sakadāgāmiphalena samannāgato ‘sakadāgāmī’ti vattabboti. ",
  "kv4.4:11.2": "āmantā. ",
  "kv4.4:11.3": "anāgāmī sakadāgāmiphalena samannāgato’ti. ",
  "kv4.4:11.4": "āmantā. ",
  "kv4.4:11.5": "sve’va anāgāmī so sakadāgāmī’ti. ",
  "kv4.4:11.6": "na hevaṃ vattabbe …pe… ",
  "kv4.4:12.1": "sotāpattiphalena samannāgato sotāpanno’ti vattabbo’ti. ",
  "kv4.4:12.2": "āmantā. ",
  "kv4.4:12.3": "sakadāgāmī sotāpattiphalena samannāgato’ti. ",
  "kv4.4:12.4": "āmantā. ",
  "kv4.4:12.5": "sve’va sakadāgāmī so sotāpanno’ti. ",
  "kv4.4:12.6": "na hevaṃ vattabbe …pe… ",
  "kv4.4:13.1": "arahā sotāpattiphalena samannāgato’ti. ",
  "kv4.4:13.2": "āmantā. ",
  "kv4.4:13.3": "nanu arahā sotāpattiphalaṃ vītivatto’ti. ",
  "kv4.4:13.4": "āmantā. ",
  "kv4.4:13.5": "hañci arahā sotāpattiphalaṃ vītivatto, anu: pā: no ca vata re vattabbe: ",
  "kv4.4:13.6": "arahā sotāpattiphalena samannāgatoti. ",
  "kv4.4:14.1": "arahā sotāpattiphalaṃ vītivatto tena samannāgatoti. ",
  "kv4.4:14.2": "āmantā. ",
  "kv4.4:14.3": "arahā sotāpattimaggaṃ vītivatto, sakkāyadiṭṭhiṃ vicikicchaṃ sīlabbataparāmāsaṃ apāyagamanīyaṃ rāgaṃ apāyagamanīyaṃ dosaṃ apāyagamanīyaṃ mohaṃ vītivatto tena samannāgato’ti. ",
  "kv4.4:14.4": "na hevaṃ vattabbe …pe… ",
  "kv4.4:15.1": "arahā sakadāgāmiphalena samannāgato’ti. ",
  "kv4.4:15.2": "āmantā. ",
  "kv4.4:15.3": "nanu arahā sakadāgāmiphalaṃ vītivatto’ti. ",
  "kv4.4:15.4": "āmantā. ",
  "kv4.4:15.5": "hañci arahā sakadāgāmiphalaṃ vītivatto, no ca vata re vattabbe: ",
  "kv4.4:15.6": "arahā sakadāgāmiphalena samannāgato’ti. ",
  "kv4.4:16.1": "arahā sakadāgāmiphalaṃ vītivatto tena samannāgato’ti. ",
  "kv4.4:16.2": "āmantā. ",
  "kv4.4:16.3": "arahā sakadāgāmimaggaṃ vītivatto oḷārikaṃ kāmarāgaṃ oḷārikaṃ byāpādaṃ vītivatto tena samannāgato’ti. ",
  "kv4.4:16.4": "na hevaṃ vattabbe …pe… ",
  "kv4.4:17.1": "arahā anāgāmiphalena samannāgato’ti. ",
  "kv4.4:17.2": "āmantā. ",
  "kv4.4:17.3": "nanu arahā anāgāmiphalena vītivatto’ti. ",
  "kv4.4:17.4": "āmantā. ",
  "kv4.4:17.5": "hañci arahā anāgāmiphalaṃ vītivatto, no ca vata re vattabbe: ",
  "kv4.4:17.6": "arahā anāgāmiphalena samannāgato’ti. ",
  "kv4.4:18.1": "arahā anāgāmiphalaṃ vītivatto tena samannāgato’ti. ",
  "kv4.4:18.2": "āmantā. ",
  "kv4.4:18.3": "arahā anāgāmimaggaṃ vītivatto aṇusahagataṃ kāmarāgaṃ aṇusahagataṃ byāpādaṃ vītivatto tena samannāgato’ti. ",
  "kv4.4:18.4": "na hevaṃ vattabbe …pe… ",
  "kv4.4:19.1": "anāgāmī sotāpattiphalena samannāgato’ti ",
  "kv4.4:19.2": "āmantā. ",
  "kv4.4:19.3": "nanu anāgāmī sotāpattiphalaṃ vītivatto’ti. ",
  "kv4.4:19.4": "āmantā. ",
  "kv4.4:19.5": "hañci anāgāmī sotāpattiphalaṃ vītivatto, no ca vata re vattabbe: ",
  "kv4.4:19.6": "anāgāmī sotāpattiphalena samannāgatoti. ",
  "kv4.4:20.1": "anāgāmī sotāpattiphalaṃ vītivatto tena samannāgato’ti. ",
  "kv4.4:20.2": "āmantā. ",
  "kv4.4:20.3": "anāgāmī sotāpattimaggaṃ vītivatto sakkāyadiṭṭhiṃ …pe… apāyagamanīyaṃ mohaṃ vītivatto tena samannāgato’ti. ",
  "kv4.4:20.4": "na hevaṃ vattabbe …pe… ",
  "kv4.4:21.1": "anāgāmī sakadāgāmiphalena samannāgato’ti. ",
  "kv4.4:21.2": "āmantā. ",
  "kv4.4:21.3": "nanu anāgāmī sakadāgāmiphalaṃ vītivatto’ti. ",
  "kv4.4:21.4": "āmantā. ",
  "kv4.4:21.5": "hañci anāgāmī sakadāgāmiphalaṃ vītivatto, no ca vata re vattabbe: ",
  "kv4.4:21.6": "anāgāmī sakadāgāmiphalena samannāgato’ti. ",
  "kv4.4:22.1": "anāgāmī sakadāgāmiphalaṃ vītivatto tena samannāgato’ti. ",
  "kv4.4:22.2": "āmantā. ",
  "kv4.4:22.3": "anāgāmī sakadāgāmimaggaṃ vītivatto oḷārikaṃ kāmarāgaṃ oḷārikaṃ byāpādaṃ vītivatto tena samannāgato’ti. ",
  "kv4.4:22.4": "na hevaṃ vattabbe …pe… ",
  "kv4.4:23.1": "sakadāgāmī sotāpattiphalena samannāgato’ti. ",
  "kv4.4:23.2": "āmantā. ",
  "kv4.4:23.3": "nanu sakadāgāmī sotāpattiphalaṃ vītivatto’ti. ",
  "kv4.4:23.4": "āmantā. ",
  "kv4.4:23.5": "hañci sakadāgāmī sotāpattiphalaṃ vītivatto, no ca vata re vattabbe: ",
  "kv4.4:23.6": "sakadāgāmī sotāpattiphalena samannāgato’ti. ",
  "kv4.4:24.1": "sakadāgāmī sotāpattiphalaṃ vītivatto tena samannāgato’ti. ",
  "kv4.4:24.2": "āmantā. ",
  "kv4.4:24.3": "sakadāgāmī sotāpattimaggaṃ vītivatto sakkāyadiṭṭhiṃ …pe… apāyagamanīyaṃ mohaṃ vītivatto tena samannāgato’ti. ",
  "kv4.4:24.4": "na hevaṃ vattabbe …pe… ",
  "kv4.4:25.1": "na vattabbaṃ: ",
  "kv4.4:25.2": "arahā catūhi phalehi samannāgato’ti. ",
  "kv4.4:25.3": "āmantā. ",
  "kv4.4:25.4": "nanu arahatā cattāri phalāni paṭiladdhāni tehi ca aparihīno’ti. ",
  "kv4.4:25.5": "āmantā. ",
  "kv4.4:25.6": "hañci arahatā cattāri phalāni paṭiladdhāni tehi ca aparihīno, tena vata re vattabbe: ",
  "kv4.4:25.7": "arahā catūhi phalehi samannāgato’ti. ",
  "kv4.4:26.1": "na vattabbaṃ: ",
  "kv4.4:26.2": "‘anāgāmī tīhi phalehi samannāgato’ti. ",
  "kv4.4:26.3": "āmantā. ",
  "kv4.4:26.4": "nanu anāgāminā tīhi phalāni paṭiladdhāni tehi ca aparihīno’ti ",
  "kv4.4:26.5": "āmantā. ",
  "kv4.4:26.6": "hañci anāgāminā tīhi phalāni paṭiladdhāni tehi ca aparihīno, tena vata re vattabbe: ",
  "kv4.4:26.7": "‘anāgāmī tīhi phalehi samannāgato’ti. ",
  "kv4.4:27.1": "na vattabbaṃ ",
  "kv4.4:27.2": "‘sakadāgāmī dvīhi phalehi samannāgato’ti. ",
  "kv4.4:27.3": "āmantā. ",
  "kv4.4:27.4": "nanu sakadāgāminā dve phalāni paṭiladdhāni tehi ca aparihīno’ti. ",
  "kv4.4:27.5": "āmantā. ",
  "kv4.4:27.6": "hañci sakadāgāminā dve phalāni paṭiladdhāni tehi ca aparihīno, tena vata re vattabbe: ",
  "kv4.4:27.7": "sakadāgāmī dvīhi phalehi samannāgato’ti. ",
  "kv4.4:28.1": "arahatā cattāri phalāni paṭiladdhāni tehi ca aparihīno’ti arahā catūhi phalehi samannāgato’ti. ",
  "kv4.4:28.2": "āmantā. ",
  "kv4.4:28.3": "arahatā cattāro maggā paṭiladdhā tehi ca aparihīno’ti arahā catūhi maggehi samannāgato’ti. ",
  "kv4.4:28.4": "na hevaṃ vattabbe …pe… ",
  "kv4.4:29.1": "anāgāminā tīṇi phalāni paṭiladdhāni te hi ca aparihīno’ti anāgāmī tīhi phalehi samannāgato’ti. ",
  "kv4.4:29.2": "āmantā. ",
  "kv4.4:29.3": "anāgāminā tayo maggā paṭiladdhā tehi ca aparino’ti anāgāmī tīhi maggehi sammannāgato’ti. ",
  "kv4.4:29.4": "na hevaṃ vattabbe …pe… ",
  "kv4.4:30.1": "sakadāgāminā dve phalāni paṭiladdhāni tehi ca aparihīno’ti sakadāgāmī dvīhi phalehi samannāgato’ti. ",
  "kv4.4:30.2": "āmantā. ",
  "kv4.4:30.3": "sakadāgāminā dve maggā paṭiladdhā tehi ca aparihīno’ti sakadāgāmī dvīhi maggehi samannāgato’ti. ",
  "kv4.4:30.4": "na hevaṃ vattabbe …pe… ",
  "kv4.4:30.5": "samannāgatakathā niṭṭhitā. "
}
