  "kv22.5:0.4": "22. 5-7. tissopi kathā. ",
  "kv22.5:1.1": "atthi gabbhaseyyāya arahattappattī’ti. ",
  "kv22.5:1.2": "āmantā. ",
  "kv22.5:1.3": "suttassa pamattassa muṭṭhassatissa asampajānassa arahattappattī’ti. ",
  "kv22.5:1.4": "na hevaṃ vattabbe …pe… ",
  "kv22.5:2.1": "atthi supinagatassa dhammābhisamayo’ti. ",
  "kv22.5:2.2": "āmantā. ",
  "kv22.5:2.3": "suttassa pamattassa muṭṭhassatissa asampajānassa dhammābhisamayo’ti. ",
  "kv22.5:2.4": "na hevaṃ vattabbe …pe… ",
  "kv22.5:3.1": "atthi supinagatassa arahattappattī’ti. ",
  "kv22.5:3.2": "āmantā. ",
  "kv22.5:3.3": "suttassa pamattassa muṭṭhassatissa1 asampajānassa dhammābhisamayo’ti. ",
  "kv22.5:3.4": "na hevaṃ vattabbe …pe… ",
  "kv22.5:3.5": "tissopi kathā niṭṭhitā. "
