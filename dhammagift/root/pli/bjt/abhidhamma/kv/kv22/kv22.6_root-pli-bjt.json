  "kv22.6:0.1": "",
  "kv22.6:0.2": "",
  "kv22.6:0.3": "",
  "kv22.6:0.4": "22. 8. abyākata kathā. ",
  "kv22.6:1.1": "sabbaṃ supinagatassa cittaṃ abyākatanti. ",
  "kv22.6:1.2": "āmantā. ",
  "kv22.6:1.3": "supinantena pāṇaṃ haneyyā’ti. ",
  "kv22.6:1.4": "āmantā. ",
  "kv22.6:1.5": "hañci supinantena pāṇaṃ haneyya, no ca vata re vattabbe ",
  "kv22.6:1.6": "“sabbaṃ supinagatassa cittaṃ abyākata”nti. ",
  "kv22.6:2.1": "supinantena adinnaṃ ādiyye …pe… ",
  "kv22.6:2.2": "musā bhaṇeyya …pe… ",
  "kv22.6:2.3": "pisuṇaṃ bhaṇeyya …pe… ",
  "kv22.6:2.4": "pharusaṃ bhaṇeyya …pe… ",
  "kv22.6:2.5": "samphaṃ palapeyya …pe… ",
  "kv22.6:2.6": "sandhiṃ chindeyya …pe… ",
  "kv22.6:2.7": "nillopaṃ hareyya …pe… ",
  "kv22.6:2.8": "ekāgārikaṃ kareyya …pe… ",
  "kv22.6:2.9": "paripanthe tiṭṭheyya …pe… ",
  "kv22.6:2.10": "paradāraṃ gaccheyya …pe… ",
  "kv22.6:2.11": "gāmaghātakaṃ kareyya …pe… ",
  "kv22.6:2.12": "nigamaghātakaṃ kareyya …pe… ",
  "kv22.6:2.13": "supinantena methunaṃ dhammaṃ patiseveyya …pe… ",
  "kv22.6:2.14": "supinagatassa asuci mucceyya …pe… ",
  "kv22.6:2.15": "supinantena dānaṃ dadeyya …pe… ",
  "kv22.6:2.16": "cīvaraṃ dadeyya …pe… ",
  "kv22.6:2.17": "piṇḍapātaṃ dadeyya …pe… ",
  "kv22.6:2.18": "senāsanaṃ dadeyya ",
  "kv22.6:2.19": "…pe… gilānapaccayabhesajja parikkhāraṃ dadeyya …pe… ",
  "kv22.6:2.20": "khādanīyaṃ dadeyya …pe… ",
  "kv22.6:2.21": "bhojanīyaṃ dadeyya …pe… ",
  "kv22.6:2.22": "pānīyaṃ dadeyya …pe… ",
  "kv22.6:2.23": "cetiyaṃ vandeyya …pe… ",
  "kv22.6:2.24": "cetiye mālaṃ āropeyya …pe… ",
  "kv22.6:2.25": "gandhaṃ āropeyya …pe… ",
  "kv22.6:2.26": "vilepanaṃ āropeyya …pe… ",
  "kv22.6:2.27": "cetiyaṃ abhidakkhiṇaṃ kareyyā’ti. ",
  "kv22.6:2.28": "āmantā. ",
  "kv22.6:2.29": "hañci supinantena cetiyaṃ abhidakkhiṇaṃ kareyya, ne ca vata re vattabbe ",
  "kv22.6:2.30": "“sabbaṃ supinagatassa cittaṃ abyākata”nti. ",
  "kv22.6:3.1": "na vattabbaṃ ",
  "kv22.6:3.2": "“sabbaṃ supinagatassa cittaṃ abyākata”nti. ",
  "kv22.6:3.3": "āmantā. ",
  "kv22.6:3.4": "nanu supinagatassa cittaṃ abbohāriyaṃ vuttaṃ bhagavatā’ti. ",
  "kv22.6:3.5": "āmantā. ",
  "kv22.6:3.6": "hañci supinagatassa cittaṃ abbohāriyaṃ vuttaṃ bhagavatā, tena vata re vattabbe ",
  "kv22.6:3.7": "“sabbaṃ supinagatassa cittaṃ abyākata”nti. ",
  "kv22.6:3.8": "abyākata kathā niṭṭhitā. "
}
