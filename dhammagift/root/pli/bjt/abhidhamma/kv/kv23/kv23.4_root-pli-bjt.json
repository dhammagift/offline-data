  "kv23.4:0.3": "",
  "kv23.4:0.4": "23. 4. patirūpa kathā. ",
  "kv23.4:1.1": "attha na rāgo rāgapatirūpakoti. ",
  "kv23.4:1.2": "āmantā. ",
  "kv23.4:1.3": "atthi na phasso phassapatirūpako, ",
  "kv23.4:1.4": "attha na vedanā vedanāpatirūpakā, ",
  "kv23.4:1.5": "atthi na saññā saññāpatirūpakā, ",
  "kv23.4:1.6": "atthi na cetanā cetanāpatirūpakā, ",
  "kv23.4:1.7": "atthi na cittaṃ cittapatirūpakaṃ, ",
  "kv23.4:1.8": "atthi na saddhā saddhāpatirūpakā, ",
  "kv23.4:1.9": "atthi na viriyaṃ viriyapatirūpakaṃ, ",
  "kv23.4:1.10": "atthi na sati satipatirūpakā, ",
  "kv23.4:1.11": "atthi na samādhi samādhipatirupako, ",
  "kv23.4:1.12": "atthi na paññā paññāpati rūpakā’ti. ",
  "kv23.4:1.13": "na hevaṃ vattabbe …pe… ",
  "kv23.4:2.1": "atthi na doso dosapatirūpako …pe… ",
  "kv23.4:2.2": "atthi na moho mohapatirūpako …pe… ",
  "kv23.4:2.3": "atthi na kileso kilesapatirūpako’ti. ",
  "kv23.4:2.4": "āmantā. ",
  "kv23.4:2.5": "atthi na phasso phassapatirūpako …pe… ",
  "kv23.4:2.6": "atthi na paññā paññāpatirūpakā’ti. ",
  "kv23.4:2.7": "na hevaṃ vattabbe …pe… ",
  "kv23.4:2.8": "patirūpa kathā niṭṭhitā. "
}
