  "kv23.2:0.4": "23. 2. arahantavaṇṇa kathā. ",
  "kv23.2:1.1": "arahantānaṃ vaṇṇena amanussā methunaṃ dhammaṃ patisevantī’ti. ",
  "kv23.2:1.2": "āmantā. ",
  "kv23.2:1.3": "arahantānaṃ vaṇṇena amanussā pāṇaṃ hanantī …pe… ",
  "kv23.2:1.4": "adinnaṃ ādiyanti …pe… ",
  "kv23.2:1.5": "musā bhaṇanti …pe… ",
  "kv23.2:1.6": "pisuṇaṃ bhaṇanti …pe… ",
  "kv23.2:1.7": "pharusaṃ bhaṇanti …pe… ",
  "kv23.2:1.8": "samphaṃ palapanti …pe… ",
  "kv23.2:1.9": "sandhiṃ chindanti …pe… ",
  "kv23.2:1.10": "nillopaṃ haranti …pe… ",
  "kv23.2:1.11": "ekāgārikaṃ karonti …pe… ",
  "kv23.2:1.12": "paripanthe tiṭṭhanti …pe… ",
  "kv23.2:1.13": "paradāraṃ gacchanti ",
  "kv23.2:1.14": "…pe… gāmaghātaṃ karonti …pe… ",
  "kv23.2:1.15": "nigamaghātaṃ karontī’ti. ",
  "kv23.2:1.16": "na hevaṃ vattabbe …pe… ",
  "kv23.2:1.17": "arahantavaṇṇakathā niṭṭhitā. "
}
