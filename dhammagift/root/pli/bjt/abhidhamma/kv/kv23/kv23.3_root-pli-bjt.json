  "kv23.3:0.3": "",
  "kv23.3:0.4": "23. 3. issariyakāmakāritā kathā. ",
  "kv23.3:1.1": "bodhisatto issariyakāmakāritāhetu vinipātaṃ gacchatī’ti. ",
  "kv23.3:1.2": "āmantā. ",
  "kv23.3:1.3": "bodhisatto issariyakāmakāritāhetu nirayaṃ gacchati …pe… ",
  "kv23.3:1.4": "sañjīvaṃ gacchati …pe… ",
  "kv23.3:1.5": "kālasuttaṃ gacchati …pe… ",
  "kv23.3:1.6": "tāpanaṃ gacchati. ",
  "kv23.3:1.7": "…pe… patāpanaṃ gacchati ",
  "kv23.3:1.8": "…pe… saṅghātaṃ gacchati …pe… ",
  "kv23.3:1.9": "roruvaṃ gacchati …pe… ",
  "kv23.3:1.10": "avīciṃ gacchatī’ti. ",
  "kv23.3:1.11": "na hevaṃ vattabbe …pe… ",
  "kv23.3:2.1": "bodhisatto issariyakāmakāritāhetu vinipātaṃ gacchatī’ti. ",
  "kv23.3:2.2": "āmantā. ",
  "kv23.3:2.3": "bodhisatto issariyakāmakāritāhetu vinipātaṃ gacchatī’ti. ",
  "kv23.3:2.4": "attheva suttanto’ti. ",
  "kv23.3:2.5": "natthi. ",
  "kv23.3:2.6": "hañci bodhisatto issariyakāmakāritāhetu vinipātaṃ gacchatī’ti ",
  "kv23.3:2.7": "nattheva suttanto, no ca vata re vattabbe ",
  "kv23.3:2.8": "“bodhisatto issariyāmakāritā hetu vinipātaṃ gacchatī”ti. ",
  "kv23.3:3.1": "bodhisatto issariyakāmakāritāhetu gabbhaseyyaṃ okkamatī’ti. ",
  "kv23.3:3.2": "āmantā. ",
  "kv23.3:3.3": "bodhisatto issariyakāmakāritāhetu nirayaṃ upapajjeyya …pe… tiracchānayoniṃ uppajjeyyā’ti. ",
  "kv23.3:3.4": "na hevaṃ vattabbe …pe… ",
  "kv23.3:4.1": "bodhisatto issariyakāmakāritāhetu gabbhaseyyaṃ okkamatī’ti. ",
  "kv23.3:4.2": "āmantā. ",
  "kv23.3:4.3": "bodhisatto iddhimāti. ",
  "kv23.3:4.4": "na hevaṃ vattabbe …pe… ",
  "kv23.3:4.5": "bodhisatto iddhimāti. ",
  "kv23.3:4.6": "āmantā. ",
  "kv23.3:4.7": "bodhisattena chandiddhipādo bhāvito …pe… ",
  "kv23.3:4.8": "viriyiddhipādo …pe… ",
  "kv23.3:4.9": "cittiddhipādo …pe… ",
  "kv23.3:4.10": "vīmaṃsiddhipādo bhāvito’ti. ",
  "kv23.3:4.11": "na hevaṃ vattabbe …pe… ",
  "kv23.3:5.1": "bodhisatto issariyakāmakāritāhetu gabbhaseyyaṃ okkamatī’ti. ",
  "kv23.3:5.2": "āmantā. ",
  "kv23.3:5.3": "‘bodhisatto issariyakāmakāritāhetu gabbhaseyyaṃ okkamatī’ti ",
  "kv23.3:5.4": "attheva suttanto’ti. ",
  "kv23.3:5.5": "natthi. ",
  "kv23.3:5.6": "hañci ‘bodhisatto issariyakāmakāritāhetu gabbhaseyyaṃ okkamatī’ti ",
  "kv23.3:5.7": "nattheva suttanto, no ca vata re vattabbe ",
  "kv23.3:5.8": "“bodhisatto issariyakāmakāritāhetu gabbhaseyyaṃ okkamatī”ti. ",
  "kv23.3:6.1": "bodhisatto issariyakāmakāritāhetu dukkarakārikaṃ ākāsī’ti. ",
  "kv23.3:6.2": "āmantā. ",
  "kv23.3:6.3": "bodhisatto issariyakāmakāritāhetu sassato lokoti paccāgacchi ",
  "kv23.3:6.4": "asassato lokoti …pe… ",
  "kv23.3:6.5": "antavā lokoti …pe… ",
  "kv23.3:6.6": "anantavā lokoti …pe… ",
  "kv23.3:6.7": "taṃ jīvaṃ taṃ sarīranti …pe… ",
  "kv23.3:6.8": "aññaṃ jīvaṃ aññaṃ sarīranti …pe… ",
  "kv23.3:6.9": "hoti tathāgato parammaraṇāti …pe… ",
  "kv23.3:6.10": "na hoti tathāgato parammaraṇāti …pe… ",
  "kv23.3:6.11": "hoti na ca hoti tathāgato parammaraṇāti …pe… ",
  "kv23.3:6.12": "neva hoti na na hoti tathāgato parammaraṇāti paccāgacchiti. ",
  "kv23.3:6.13": "na hevaṃ vattabbe …pe… ",
  "kv23.3:7.1": "bodhisatto issariyakāmakāritāhetu dukkarakārikaṃ akāsi’ti. ",
  "kv23.3:7.2": "āmantā. ",
  "kv23.3:7.3": "‘bodhisatto issariyakāmakāritāhetu dukkarakārikaṃ akāsī’ti ",
  "kv23.3:7.4": "attheva suttanto’ti. ",
  "kv23.3:7.5": "natthi. ",
  "kv23.3:7.6": "‘hañci bodhisatto issariyakāmakāritāhetu dukkarakārikaṃ akāsī’ti ",
  "kv23.3:7.7": "nattheva suttanto, no ca vata re vattabbe ",
  "kv23.3:7.8": "‘bodhisatto issariyakāmakāritāhetu dukkarakārikaṃ akāsī’ti. ",
  "kv23.3:8.1": "bodhisatto issariyakāmakāritāhetu aparantapaṃ akāsi, aññaṃ satthāraṃ uddīsī’ti. ",
  "kv23.3:8.2": "āmantā. ",
  "kv23.3:8.3": "bodhisatto issariyakāmakāritāhetu sassato lokoti paccāgacchi …pe… ",
  "kv23.3:8.4": "neva hoti na na hoti tathāgato parammaraṇā’ti paccāgacchi’ti. ",
  "kv23.3:8.5": "na hevaṃ vattabbe …pe… ",
  "kv23.3:9.1": "bodhisatto issariyakāmakāritāhetu aññaṃ satthāraṃ uddisī’ti. ",
  "kv23.3:9.2": "āmantā. ",
  "kv23.3:9.3": "‘bodhisatto issariyakāmakāritāhetu aññaṃ satthāraṃ uddisī’ti ",
  "kv23.3:9.4": "attheva suttantoti. ",
  "kv23.3:9.5": "natthi. ",
  "kv23.3:9.6": "‘hañci bodhisatto issariyakāmakāritāhetu aññaṃ satthāraṃ uddīsī’ti ",
  "kv23.3:9.7": "nattheva suttanto, no ca vata re vattabbe ",
  "kv23.3:9.8": "“bodhisatto issariyakāmakāritāhetu aññaṃ satthāraṃ uddīsī’ti. ",
  "kv23.3:9.9": "issariyakāmakāritā kathā niṭṭhitā. "
}
