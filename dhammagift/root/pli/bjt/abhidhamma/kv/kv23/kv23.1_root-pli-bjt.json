  "kv23.1:0.4": "23. 1. ekādhippāya kathā. ",
  "kv23.1:1.1": "ekādhippāyena methuno dhammo patisevitabbo’ti. ",
  "kv23.1:1.2": "āmantā. ",
  "kv23.1:1.3": "ekādhippāyena assamaṇena hotabbaṃ abhikkhunā hotabbaṃ jinnamūlena hotabbaṃ pārājikena hotabbanti. ",
  "kv23.1:1.4": "na hevaṃ vattabbe …pe… ",
  "kv23.1:1.5": "ekādhippāyena methuno dhammo patisevitabbo’ti. ",
  "kv23.1:1.6": "āmantā. ",
  "kv23.1:1.7": "ekādhippāyena pāṇo hantabbo …pe… ",
  "kv23.1:1.8": "adinnaṃ ādiyitabbaṃ …pe… ",
  "kv23.1:1.9": "musā bhaṇitabbā …pe… ",
  "kv23.1:1.10": "pisuṇaṃ bhaṇitabbaṃ …pe… ",
  "kv23.1:1.11": "pharusaṃ bhaṇitabbaṃ …pe… ",
  "kv23.1:1.12": "samphaṃ palapitabbaṃ …pe… ",
  "kv23.1:1.13": "sandhi cheditabbo …pe… ",
  "kv23.1:1.14": "nillopaṃ kātabbaṃ …pe… ",
  "kv23.1:1.15": "ekāgārikaṃ kātabbaṃ …pe… ",
  "kv23.1:1.16": "paripanthe ṭhātabbaṃ …pe… ",
  "kv23.1:1.17": "paradāro gantabbo ",
  "kv23.1:1.18": "…pe… gāmaghāto kātabbo ",
  "kv23.1:1.19": "…pe… nigamaghāto kātabbo’ti. ",
  "kv23.1:1.20": "na hevaṃ vattabbe …pe… ",
  "kv23.1:1.21": "ekādhippāyakathā niṭṭhitā. "
}
