  "kv11.8:0.3": "",
  "kv11.8:0.4": "11. 8. aniccatā kathā ",
  "kv11.8:1.1": "aniccatā parinipphannā’ti. ",
  "kv11.8:1.2": "āmantā. ",
  "kv11.8:1.3": "tāya aniccatāya aniccatā parinipphannā’ti. ",
  "kv11.8:1.4": "na hevaṃ vattabbe …pe… ",
  "kv11.8:1.5": "tāya aniccatāya tāya aniccatā parinipphannā’ti. ",
  "kv11.8:1.6": "āmantā. ",
  "kv11.8:1.7": "tāya tāye’va natthi dukkhassa antakiriyā natthi vaṭṭūpacchedo, natthi anupādā parinibbānanti. ",
  "kv11.8:1.8": "na hevaṃ vattabbe …pe… ",
  "kv11.8:2.1": "jarā parinipphannā’ti. ",
  "kv11.8:2.2": "āmantā. ",
  "kv11.8:2.3": "tāya jarāya jarā parinipphannā’ti. ",
  "kv11.8:2.4": "na hevaṃ vattabbe …pe… ",
  "kv11.8:2.5": "tāya jarāya jarā parinipphannā’ti. ",
  "kv11.8:2.6": "āmantā. ",
  "kv11.8:2.7": "tāya tāye’va natthi dukkhassa antakiriyā, natthi vaṭṭūpacchedo, natthi anupādā parinibbānanti. ",
  "kv11.8:2.8": "na hevaṃ vattabbe …pe… ",
  "kv11.8:3.1": "maraṇaṃ parinipphannanti. ",
  "kv11.8:3.2": "āmantā. ",
  "kv11.8:3.3": "tassa maraṇassa maraṇaṃ parinipphannanti. ",
  "kv11.8:3.4": "na hevaṃ vattabbe …pe… ",
  "kv11.8:3.5": "tassa maraṇassa maraṇaṃ parinipphannanti. ",
  "kv11.8:3.6": "āmantā. ",
  "kv11.8:3.7": "tassa tasseva natthi dukkhassa antakiriyā, natthi vaṭṭūpacchedo, natthi anupādā parinibbānanti. ",
  "kv11.8:3.8": "na hevaṃ vattabbe …pe… ",
  "kv11.8:4.1": "rūpaṃ parinipphannaṃ. rūpassa aniccatā atthi’ti. ",
  "kv11.8:4.2": "āmantā. ",
  "kv11.8:4.3": "aniccatā parinipphannā. aniccatāya aniccatā atthi’ti. ",
  "kv11.8:4.4": "na hevaṃ vattabbe …pe… ",
  "kv11.8:4.5": "rūpaṃ parinipphannaṃ. rūpassa jarā atthi’ti. ",
  "kv11.8:4.6": "āmantā. ",
  "kv11.8:4.7": "jarā parinipphannā, jarāya jarā atthi’ti. ",
  "kv11.8:4.8": "na hevaṃ vattabbe …pe… ",
  "kv11.8:5.1": "rūpaṃ parinipphannaṃ. rūpassa bhedo atthi, antaradhānaṃ atthī’ti. ",
  "kv11.8:5.2": "āmantā. ",
  "kv11.8:5.3": "maraṇaṃ parinipphannaṃ. maraṇassa bhedo atthi, antaradhānaṃ atthī’ti. ",
  "kv11.8:5.4": "na hevaṃ vattabbe …pe… ",
  "kv11.8:6.1": "vedanā …pe… ",
  "kv11.8:6.2": "saññā …pe… saṅkhārā …pe… ",
  "kv11.8:6.3": "viññāṇaṃ parinipphannaṃ. viññāṇassa aniccatā atthi’ti. ",
  "kv11.8:6.4": "āmantā. ",
  "kv11.8:6.5": "aniccatā parinipphannā. aniccatāya aniccatā atthi’ti. ",
  "kv11.8:6.6": "na hevaṃ vattabbe …pe… sa. pu ",
  "kv11.8:6.7": "viññāṇaṃ parinipphannaṃ. viññāṇassa jarā atthi’ti. ",
  "kv11.8:6.8": "āmantā. ",
  "kv11.8:6.9": "jarā parinipphannā. jarāya jarā atthi’ti. ",
  "kv11.8:6.10": "na hevaṃ vattabbe …pe… ",
  "kv11.8:7.1": "viññāṇaṃ parinipphannaṃ. viññāṇassa bhedo atthi, antarādhānaṃ atthi’ti. ",
  "kv11.8:7.2": "āmantā. ",
  "kv11.8:7.3": "maraṇaṃ parinipphannaṃ. maraṇassa bhedo atthi, antaradhānaṃ atthi’ti. ",
  "kv11.8:7.4": "na hevaṃ vattabbe …pe… ",
  "kv11.8:7.5": "aniccatākathā niṭṭhitā. ",
  "kv11.8:7.6": "ekādasamo vaggo ",
  "kv11.8:7.7": "niṭṭhito. tassa uddānaṃ ",
  "kv11.8:8.1": "anusayā abyākatā ahetukā cittavippayuttā ñāṇe vigate ñāṇī ñāṇaṃ cittavippayuttaṃ yattha saddo ñāṇaṃ pavattati. iddhibalena samannāgato kappaṃ tiṭṭheyya cittasantati samādhi dhammaṭṭhitatā aniccatā’ti. dvādasamo vaggo "
}
