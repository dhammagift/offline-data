{
  "kv11.3:0.1": "",
  "kv11.3:0.2": "",
  "kv11.3:0.3": "",
  "kv11.3:0.4": "11. 3. ñāṇaṃ cittavippayuttantikathā. ",
  "kv11.3:1.1": "ñāṇaṃ cittavippayuttanti. ",
  "kv11.3:1.2": "āmantā. ",
  "kv11.3:1.3": "rūpaṃ nibbānaṃ. ",
  "kv11.3:1.4": "na hevaṃ vattabbe …pe… ",
  "kv11.3:1.5": "ñāṇaṃ cittavippayuttanti. ",
  "kv11.3:1.6": "āmantā. ",
  "kv11.3:1.7": "paññā paññindriyaṃ paññābalaṃ sammādiṭṭhi dhammavicayasambojjhaṅgo cittavippayutto’ti. ",
  "kv11.3:1.8": "na hevaṃ vattabbe …pe… ",
  "kv11.3:1.9": "paññā paññindriyaṃ paññābalaṃ sammādiṭṭhi dhammavicayasambojjhaṅgo cittasampayutto’ti. ",
  "kv11.3:1.10": "āmantā. ",
  "kv11.3:1.11": "ñāṇaṃ cittasampayuttanti. ",
  "kv11.3:1.12": "na hevaṃ vattabbe …pe… ",
  "kv11.3:2.1": "ñāṇaṃ cittavippayuttanti. ",
  "kv11.3:2.2": "āmantā. ",
  "kv11.3:2.3": "katamakkhandhapariyāpannanti. ",
  "kv11.3:2.4": "saṅkhārakkhandhapariyāpannanti. ",
  "kv11.3:2.5": "saṅkhārakkhandho cittavippayutto’ti. ",
  "kv11.3:2.6": "na hevaṃ vattabbe …pe… ",
  "kv11.3:2.7": "saṅkhārakkhandho cittavippayutto’ti. pa. paṭiññā. ",
  "kv11.3:2.8": "āmantā. ",
  "kv11.3:2.9": "vedanākkhandho, saññākkhandho cittavippayutto’ti. ",
  "kv11.3:2.10": "na hevaṃ vattabbe …pe… ",
  "kv11.3:2.11": "ñāṇaṃ saṅkhārakkhandhapariyāpannaṃ cittavippayuttanti. ",
  "kv11.3:2.12": "āmantā. ",
  "kv11.3:2.13": "paññā saṅkhārakkhandhapariyāpannā cittavippayuttā’ti. ",
  "kv11.3:2.14": "na hevaṃ vattabbe …pe… ",
  "kv11.3:2.15": "paññā saṅkhārakkhandhapariyāpannā cittavippayuttā’ti. ",
  "kv11.3:2.16": "āmantā. ",
  "kv11.3:2.17": "ñāṇaṃ saṅkhārakkhandhapariyāpannaṃ cittasampayuttanti. ",
  "kv11.3:2.18": "na hevaṃ vattabbe …pe… ",
  "kv11.3:2.19": "ñāṇaṃ saṅkhārakkhandhapariyāpannaṃ cittavippayuttaṃ, paññā saṅkhārakkhandhapariyāpannā cittasampayuttā’ti. ",
  "kv11.3:2.20": "āmantā. ",
  "kv11.3:2.21": "saṅkhārakkhandho ekadeso cittasampayutto, ekadeso cittavippayutto’ti. ",
  "kv11.3:2.22": "na hevaṃ vattabbe …pe… ",
  "kv11.3:2.23": "saṅkhārakkhandho ekadeso cittasampayutto ekadeso cittavippayutto’ti. ",
  "kv11.3:2.24": "āmantā. ",
  "kv11.3:2.25": "vedanākkhandho, saññākkhandho ekadeso cittasampayutto ekadeso cittavippayutto’ti. ",
  "kv11.3:2.26": "na hevaṃ vattabbe …pe… ",
  "kv11.3:3.1": "na vattabbaṃ ",
  "kv11.3:3.2": "ñāṇaṃ cittavippayutta’nti. ",
  "kv11.3:3.3": "āmantā. ",
  "kv11.3:3.4": "“arahā cakkhuviññāṇasamaṅgī ñāṇī’ti vattabbo”ti. ",
  "kv11.3:3.5": "āmantā. ",
  "kv11.3:3.6": "ñāṇaṃ tena cittena sampayutta’nti. ",
  "kv11.3:3.7": "na hevaṃ vattabbe …pe… ",
  "kv11.3:3.8": "tena hi ñāṇaṃ cittavippayuttanti. ",
  "kv11.3:4.1": "arahā cakkhuviññāṇasamaṅgī paññāvā’ti vattabbo’ti. ",
  "kv11.3:4.2": "āmantā. ",
  "kv11.3:4.3": "paññā tena cittena sampayuttā’ti. ",
  "kv11.3:4.4": "na hevaṃ vattabbe …pe… ",
  "kv11.3:4.5": "tena hi paññā cittavippayuttā’ti. ",
  "kv11.3:4.6": "ñāṇaṃ cittavippayuttanti kathā niṭṭhitā. "
}
