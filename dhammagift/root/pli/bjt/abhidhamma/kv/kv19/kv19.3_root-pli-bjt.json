  "kv19.3:0.4": "19. 3. sāmaññaphala kathā ",
  "kv19.3:1.1": "sāmaññaphalaṃ asaṅkhatanti. ",
  "kv19.3:1.2": "āmantā. ",
  "kv19.3:1.3": "nibbānaṃ tāṇaṃ leṇaṃ saraṇaṃ parāyaṇaṃ accutaṃ amatanti. ",
  "kv19.3:1.4": "na hevaṃ vattabbe …pe… ",
  "kv19.3:1.5": "sāmaññaphalaṃ asaṅkhataṃ, nibbānaṃ asaṅkhatanti. ",
  "kv19.3:1.6": "āmantā. ",
  "kv19.3:1.7": "dve asaṅkhatānīti. ",
  "kv19.3:1.8": "na hevaṃ vattabbe …pe… ",
  "kv19.3:1.9": "dve asaṅkhatānī’ti. ",
  "kv19.3:1.10": "āmantā. ",
  "kv19.3:1.11": "dve tāṇāni …pe… ",
  "kv19.3:1.12": "antarikāvāti. ",
  "kv19.3:1.13": "na hevaṃ vattabbe …pe… ",
