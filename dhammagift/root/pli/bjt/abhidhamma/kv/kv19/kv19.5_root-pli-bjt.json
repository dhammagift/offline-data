  "kv19.5:0.3": "",
  "kv19.5:0.4": "19. 5. tathatā kathā. ",
  "kv19.5:1.1": "sabbadhammānaṃ tathatā asaṅkhatā’ti. ",
  "kv19.5:1.2": "āmantā. ",
  "kv19.5:1.3": "nibbānaṃ tāṇaṃ leṇaṃ saraṇaṃ parāyanaṃ accutaṃ ",
  "kv19.5:1.4": "amatanti. ",
  "kv19.5:1.5": "na hevaṃ vattabbe …pe… ",
  "kv19.5:1.6": "sabbadhammānaṃ tathatā asaṅkhatā, nibbānaṃ asaṅkhatanti. ",
  "kv19.5:1.7": "āmantā. sa. anu ",
  "kv19.5:1.8": "dve asaṅkhatānī’ti. ",
  "kv19.5:1.9": "na hevaṃ vattabbe …pe… ",
  "kv19.5:1.10": "dve asaṅkhatānī’ti. ",
  "kv19.5:1.11": "āmantā. ",
  "kv19.5:1.12": "dve tāṇāni …pe… [dve] ",
  "kv19.5:1.13": "antarikā vā’ti. ",
  "kv19.5:1.14": "na hevaṃ vattabbe …pe… ",
  "kv19.5:2.1": "rūpassa rūpatā, nanu rūpatā asaṅkhatā’ti. ",
  "kv19.5:2.2": "āmantā. ",
  "kv19.5:2.3": "nibbānaṃ …pe… ",
  "kv19.5:2.4": "amatanti. ",
  "kv19.5:2.5": "na hevaṃ vattabbe …pe… ",
  "kv19.5:2.6": "rūpassa rūpatā, nanu rūpatā asaṅkhatā, nibbānaṃ asaṅkhatanti. ",
  "kv19.5:2.7": "āmantā. ",
  "kv19.5:2.8": "dve asaṅkhatānī’ti. ",
  "kv19.5:2.9": "na hevaṃ vattabbe …pe… ",
  "kv19.5:2.10": "dve asaṅkhatānī’ti. ",
  "kv19.5:2.11": "āmantā. ",
  "kv19.5:2.12": "dve tāṇāni …pe… [dve] ",
  "kv19.5:2.13": "antarikā vā’ti ",
  "kv19.5:2.14": "na hevaṃ vattabbe …pe… ",
  "kv19.5:3.1": "vedanāya vedanatā, nanu vedanatā …pe… ",
  "kv19.5:3.2": "saññāya saññatā, nanu saññatā …pe… ",
  "kv19.5:3.3": "saṅkhārānaṃ saṅkhāratā, nanu saṅkhāratā …pe… ",
  "kv19.5:3.4": "viññāṇassa viññāṇatā, nanu viññāṇatā asaṅkhatā’ti. ",
  "kv19.5:3.5": "āmantā. ",
  "kv19.5:3.6": "nibbānaṃ …pe… ",
  "kv19.5:3.7": "amatanti. ",
  "kv19.5:3.8": "na hevaṃ vattabbe …pe… ",
  "kv19.5:4.1": "rūpassa rūpatā, nanu rūpatā, …pe… ",
  "kv19.5:4.2": "viññāṇassa viññāṇatā, nanu viññāṇatā asaṅkhatā, nibbānaṃ asaṅkhatanti. ",
  "kv19.5:4.3": "āmantā. ",
  "kv19.5:4.4": "cha asaṅkhatānī’ti. ",
  "kv19.5:4.5": "na hevaṃ vattabbe …pe… ",
  "kv19.5:4.6": "cha asaṅkhatānī’ti. ",
  "kv19.5:4.7": "āmantā. ",
  "kv19.5:4.8": "cha tāṇāni …pe… [cha] ",
  "kv19.5:4.9": "antarikā vā’ti. ",
  "kv19.5:4.10": "na hevaṃ vattabbe …pe… ",
  "kv19.5:5.1": "na vattabbaṃ ",
  "kv19.5:5.2": "‘sabbadhammānaṃ tathatā asaṅkhatā’ti. ",
  "kv19.5:5.3": "āmantā. ",
  "kv19.5:5.4": "sabbadhammānaṃ tathatā rūpaṃ ",
  "kv19.5:5.5": "vedanā ",
  "kv19.5:5.6": "saññā ",
  "kv19.5:5.7": "saṅkhārā ",
  "kv19.5:5.8": "viññāṇanti. ",
  "kv19.5:5.9": "na hevaṃ vattabbe …pe… ",
  "kv19.5:5.10": "tena hi “sabbadhammānaṃ tathatā asaṅkhatā”ti. ",
  "kv19.5:5.11": "tathatā kathā niṭṭhitā. "
}
