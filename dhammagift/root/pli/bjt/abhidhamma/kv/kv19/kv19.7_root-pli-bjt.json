  "kv19.7:0.3": "",
  "kv19.7:0.4": "19. 7. accantaniyāma kathā. ",
  "kv19.7:1.1": "atthi puthujjanassa accantaniyāmatā’ti. ",
  "kv19.7:1.2": "āmantā. ",
  "kv19.7:1.3": "mātughātako accantaniyato, pitughātako …pe… ",
  "kv19.7:1.4": "arahantaghātako …pe… ",
  "kv19.7:1.5": "ruhiruppādako …pe… ",
  "kv19.7:1.6": "saṅghabhedako accantaniyato’ti. ",
  "kv19.7:1.7": "na hevaṃ vattabbe …pe… ",
  "kv19.7:2.1": "atthi puthujjanassa accantaniyāmatā’ti. ",
  "kv19.7:2.2": "āmantā. ",
  "kv19.7:2.3": "accantaniyatassa puggalassa vicikicchā uppajjeyyā’ti. ",
  "kv19.7:2.4": "āmantā. ",
  "kv19.7:2.5": "hañci accantaniyatassa puggalassa vicikicchā uppajjeyya, no ca vata re vattabbe ",
  "kv19.7:2.6": "“atthi puthujjanassa accantaniyāmatā’ti. ",
  "kv19.7:3.1": "accantaniyatassa puggalassa vicikicchā nuppajjeyyā’ti. ",
  "kv19.7:3.2": "āmantā. ",
  "kv19.7:3.3": "pahīnā’ti. ",
  "kv19.7:3.4": "na hevaṃ vattabbe …pe… ",
  "kv19.7:3.5": "pahīnā’ti. ",
  "kv19.7:3.6": "āmantā. ",
  "kv19.7:3.7": "sotāpattimaggenā’ti. ",
  "kv19.7:3.8": "na hevaṃ vattabbe …pe… ",
  "kv19.7:3.9": "sakadāgāmī …pe… ",
  "kv19.7:3.10": "anāgāmī …pe… ",
  "kv19.7:3.11": "arahattamaggenā’ti. ",
  "kv19.7:3.12": "na hevaṃ vattabbe …pe… ",
  "kv19.7:4.1": "katamena maggenā’ti. ",
  "kv19.7:4.2": "akusalena maggenā’ti. ",
  "kv19.7:4.3": "akusalo maggo niyyāṇiko khayagāmī bodhagāmi anāsavo …pe… asaṅkilesiko’ti. ",
  "kv19.7:4.4": "na hevaṃ vattabbe …pe… ",
  "kv19.7:4.5": "nanu akusalo maggo aniyyāniko […pe…] ",
  "kv19.7:4.6": "saṅkilesiko’ti. ",
  "kv19.7:4.7": "āmantā. ",
  "kv19.7:4.8": "hañci akusalo maggo aniyyāniko …pe… ",
  "kv19.7:4.9": "saṅkilesiko, no ca vata re vattabbe ",
  "kv19.7:4.10": "“accantaniyatassa puggalassa vicikicchā akusalena maggena pahīnā’ti. ",
  "kv19.7:5.1": "sassatadiṭṭhiyā niyatassa puggalassa ucchedadiṭṭhi uppajjeyyāti. ",
  "kv19.7:5.2": "āmantā. ",
  "kv19.7:5.3": "hañci sassatadiṭṭhiyā niyatassa puggalassa ucchedadiṭṭhi uppajjeyya, no ca vata re vattabbe ",
  "kv19.7:5.4": "“atthi puthujjanassa accantaniyāmatā”ti ",
  "kv19.7:6.1": "sassatadiṭṭhiyā niyatassa puggalassa ucchedadiṭṭhi nuppajjeyyā”ti. ",
  "kv19.7:6.2": "āmantā. ",
  "kv19.7:6.3": "pahīnā’ti. ",
  "kv19.7:6.4": "na hevaṃ vattabbe …pe… ",
  "kv19.7:6.5": "pahīnā’ti. ",
  "kv19.7:6.6": "āmantā. ",
  "kv19.7:6.7": "sotāpattimaggenā’ti. ",
  "kv19.7:6.8": "na hevaṃ vattabbe …pe… ",
  "kv19.7:6.9": "sakadāgāmimaggena …pe… ",
  "kv19.7:6.10": "anāgāmimaggena …pe… ",
  "kv19.7:6.11": "arahattamaggenāti. ",
  "kv19.7:6.12": "na hevaṃ vattabbe …pe… ",
  "kv19.7:7.1": "katamena maggenā’ti. ",
  "kv19.7:7.2": "akusalena maggenā’ti. ",
  "kv19.7:7.3": "akusalo maggo niyyāṇiko khayagāmī bodhagāmī anāsavo …pe… asaṅkilesiko’ti. na hevaṃ vattabbe …pe… nanu akusalo maggo aniyyāniko …pe… saṅkilesiko’ti. āmantā. hañci akusalo maggo aniyyāniko …pe… saṅkilesiko, no ca vata re vattabbe ",
  "kv19.7:7.4": "“sassatadiṭṭhiyā niyatassa puggalassa ucchedadiṭṭhi akusalena maggena pahīnā”ti. ",
  "kv19.7:8.1": "ucchedadiṭṭhiyā niyatassa puggalassa sassatadiṭṭhi uppajjeyyā’ti. ",
  "kv19.7:8.2": "āmantā. ",
  "kv19.7:8.3": "hañci ucchedadiṭṭhiyā niyatassa puggalassa sassatadiṭṭhi uppajjeyya, no ca vata re vattabbe ",
  "kv19.7:8.4": "“atthi puthujjanassa accantaniyāmatā”ti ",
  "kv19.7:9.1": "ucchedadiṭṭhiyā niyatassa puggalassa sassatadiṭṭhi nuppajjeyyāti. ",
  "kv19.7:9.2": "āmantā. ",
  "kv19.7:9.3": "pahīnā’ti. ",
  "kv19.7:9.4": "na hevaṃ vattabbe …pe… ",
  "kv19.7:9.5": "pahīnā’ti. ",
  "kv19.7:9.6": "āmantā. ",
  "kv19.7:9.7": "sotāpattimaggenā’ti. ",
  "kv19.7:9.8": "na hevaṃ vattabbe …pe… ",
  "kv19.7:9.9": "sakadāgāmī maggena …pe… ",
  "kv19.7:9.10": "anāgāmimaggena …pe… ",
  "kv19.7:9.11": "arahattamagganā’ti. ",
  "kv19.7:9.12": "na hevaṃ vattabbe …pe… ",
  "kv19.7:10.1": "katamena maggenā’ti. ",
  "kv19.7:10.2": "akusalena maggenā’ti. ",
  "kv19.7:10.3": "akusalo maggo aniyyāniko …pe… saṅkilesiko, no ca vata re vattabbe ",
  "kv19.7:10.4": "“ucchedadiṭṭhiyā niyatassa puggalassa sassatadiṭṭhi akusalena maggena pahīnā”ti. ",
  "kv19.7:11.1": "na vattabbaṃ ",
  "kv19.7:11.2": "“atthi puthujjanassa accantaniyāmatā”ti. ",
  "kv19.7:11.3": "āmantā. ",
  "kv19.7:11.4": "nanu vuttaṃ bhagavatā ",
  "kv19.7:11.5": "“idha bhikkhave ekacco puggalo samannāgato hoti ekantakāḷakehi akusalehi dhammehi, so sakiṃ nimuggo nimuggo’va hetī”ti, ",
  "kv19.7:11.6": "atthe’va suttantoti. ",
  "kv19.7:11.7": "āmantā. ",
  "kv19.7:11.8": "tena hi “atthi puthujjanassa accantaniyāmatā”ti. ",
  "kv19.7:12.1": "vuttaṃ bhagavatā ",
  "kv19.7:12.2": "“idha bhikkhave ekacco puggalo samannāgato hoti ekantakāḷakehi akusalehi dhammehi. so sakiṃ nimuggo nimuggo’va hotī”ti. katvā tena ca kāraṇena “atthi puthujjanassa accantaniyāmatā”ti. ",
  "kv19.7:12.3": "āmantā. ",
  "kv19.7:12.4": "vuttaṃ bhagavatā ",
  "kv19.7:12.5": "“idha bhikkhave ekacco puggalo ummujjitvā nimujjatī”ti. ",
  "kv19.7:12.6": "atthe’va suttanto’ti. ",
  "kv19.7:12.7": "āmantā. ",
  "kv19.7:12.8": "sabbakālaṃ ummujjitvā nimujjatī’ti. ",
  "kv19.7:12.9": "na hevaṃ vattabbe …pe… ",
  "kv19.7:13.1": "vuttaṃ bhagavatā”idha ",
  "kv19.7:13.2": "bhikkhave ekacco puggalo samannāgato hoti ekantakāḷakehi akusalehi dhammehi. so sakiṃ nimuggo nimuggo’va hotī”ti ",
  "kv19.7:13.3": "katvā tena ca kāraṇena “atthi puthujjanassa accantaniyāmatā”ti. ",
  "kv19.7:13.4": "āmantā. ",
  "kv19.7:13.5": "vuttaṃ bhagavatā ",
  "kv19.7:13.6": "“idha bhikkhave ekacco puggalo ummujjitvā ṭhito hoti, ummujjitvā vipassati, viloketi, ummujjitvā patarati, ummujjitvā patigādhappatto hotī”ti. ",
  "kv19.7:13.7": "attheva suttanto’ti. ",
  "kv19.7:13.8": "āmantā. ",
  "kv19.7:13.9": "“sabbakālaṃ ummujjitvā patigādhappatto hotī”ti. ",
  "kv19.7:13.10": "na hevaṃ vattabbe …pe… ",
  "kv19.7:13.11": "accantaniyāma kathā niṭṭhitā. "
}
