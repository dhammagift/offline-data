  "kv19.2:0.3": "",
  "kv19.2:0.4": "19. 2. suññatā kathā. ",
  "kv19.2:1.1": "suññatā saṅkhārakkhandhapariyāpannā’ti. ",
  "kv19.2:1.2": "āmantā. ",
  "kv19.2:1.3": "animittaṃ saṅkhārakkhandhapariyāpannanti. ",
  "kv19.2:1.4": "na hevaṃ vattabbe …pe… ",
  "kv19.2:1.5": "suññatā saṅkhārakkhandhapariyāpannā’ti. ",
  "kv19.2:1.6": "āmantā. ",
  "kv19.2:1.7": "appaṇihito saṅkhārakkhandhapariyāpanno’ti. ",
  "kv19.2:1.8": "na hevaṃ vattabbe …pe… ",
  "kv19.2:1.9": "animittaṃ na vattabbaṃ ",
  "kv19.2:1.10": "saṅkhārakkhandhapariyāpannanti. ",
  "kv19.2:1.11": "āmantā. ",
  "kv19.2:1.12": "suññatā na vattabbā ",
  "kv19.2:1.13": "saṅkhārakkhandhapariyāpannāti. ",
  "kv19.2:1.14": "na hevaṃ vattabbe …pe… ",
  "kv19.2:1.15": "appaṇihito na vattabbo ",
  "kv19.2:1.16": "saṅkhārakkhandhapariyāpanno’ti. ",
  "kv19.2:1.17": "āmantā. ",
  "kv19.2:1.18": "suññatā na vattabbā ",
  "kv19.2:1.19": "saṅkhārakkhandhapariyāpannāti. ",
  "kv19.2:1.20": "na hevaṃ vattabbe …pe… ",
  "kv19.2:2.1": "suññatā saṅkhārakkhandhapariyāpannā’ti. ",
  "kv19.2:2.2": "āmantā. ",
  "kv19.2:2.3": "saṅkhārakkhandho na anicco na saṅkhato na paṭiccasamuppanno na khayadhammo na vayadhammo na virāgadhammo na nirodhadhammo na vipariṇāmadhammo’ti. ",
  "kv19.2:2.4": "na hevaṃ vattabbe …pe… ",
  "kv19.2:2.5": "nanu saṅkhārakkhandho anicco saṅkhato paṭicca samuppanno khayadhammo vayadhammo virāgadhammo nirodhadhammo vipariṇāmadhammo’ti. ",
  "kv19.2:2.6": "āmantā. ",
  "kv19.2:2.7": "hañci saṅkhārakkhandho anicco …pe… ",
  "kv19.2:2.8": "vipariṇāmadhammo, no ca vata re vattabbe ",
  "kv19.2:2.9": "“suññatā saṅkhārakkhandhapariyāpannā’ti. ",
  "kv19.2:3.1": "rūpakkhandhassa suññatā saṅkhārakkhandhapariyāpannā’ti. ",
  "kv19.2:3.2": "āmantā. ",
  "kv19.2:3.3": "saṅkhārakkhandhassa suññatā rūpakkhandhapariyāpannā’ti. ",
  "kv19.2:3.4": "na hevaṃ vattabbe …pe… ",
  "kv19.2:3.5": "vedanā …pe… ",
  "kv19.2:3.6": "saññā …pe… ",
  "kv19.2:3.7": "viññāṇakkhandhassa suññatā saṅkhārakkhandhapariyāpannā’ti. ",
  "kv19.2:3.8": "āmantā. ",
  "kv19.2:3.9": "saṅkhārakkhandhassa suññatā viññāṇakkhandhapariyāpannāti. ",
  "kv19.2:3.10": "na hevaṃ vattabbe …pe… ",
  "kv19.2:4.1": "saṅkhārakkhandhassa suññatā na vattabbā ",
  "kv19.2:4.2": "rūpakkhandhapariyāpannā’ti. ",
  "kv19.2:4.3": "āmantā. ",
  "kv19.2:4.4": "rūpakkhandhassa suññatā na vattabbā ",
  "kv19.2:4.5": "“saṅkhārakkhandhapariyāpannā’ti. ",
  "kv19.2:4.6": "na hevaṃ vattabbe …pe… ",
  "kv19.2:4.7": "saṅkhārakkhandhassa suññatā na vattabbā ",
  "kv19.2:4.8": "vedanā …pe… ",
  "kv19.2:4.9": "saññā …pe… ",
  "kv19.2:4.10": "viññāṇakkhandhapariyāpannā’tī. ",
  "kv19.2:4.11": "āmantā. ",
  "kv19.2:4.12": "viññāṇakkhandhassa suññatā na vattabbā ",
  "kv19.2:4.13": "saṅkhārakkhandhapariyāpannā’ti. ",
  "kv19.2:4.14": "na hevaṃ vattabbe …pe… ",
  "kv19.2:5.1": "na vattabbaṃ ",
  "kv19.2:5.2": "suññatā saṅkhārakkhandhapariyāpannā’ti. ",
  "kv19.2:5.3": "āmantā. ",
  "kv19.2:5.4": "nanu vuttaṃ bhagavatā ",
  "kv19.2:5.5": "“suññamidaṃ bhikkhave saṃkhārā attena vā attaniyena vā “ti ",
  "kv19.2:5.6": "attheva suttanto’ti. ",
  "kv19.2:5.7": "āmantā. ",
  "kv19.2:5.8": "tena hi “suññatā saṅkhārakkhandhapariyāpannā”ti. ",
  "kv19.2:5.9": "suññatā kathā niṭṭhitā. "
}
