  "kv7.3:0.1": "",
  "kv7.3:0.2": "",
  "kv7.3:0.3": "",
  "kv7.3:0.4": "7. 3. cetasikakathā. ",
  "kv7.3:1.1": "natthī cetasiko dhammo’ti. ",
  "kv7.3:1.2": "āmantā. ",
  "kv7.3:1.3": "nanu atthī keci dhammā cittena sahagatā sahajātā saṃsaṭṭhā sampayuttā ekuppādā ekanirodhā ekavatthukā ekārammaṇā’ti. ",
  "kv7.3:1.4": "āmantā. ",
  "kv7.3:1.5": "hañci atthī keci dhammā cittena sahagatā sahajātā saṃsaṭṭhā sampayuttā ekuppādā ekanirodhā ekavatthukā ekārammaṇā, no ca vata re vattabbe: ",
  "kv7.3:1.6": "natthī cetasiko dhammo’ti. ",
  "kv7.3:2.1": "phasso cittena sahajāto’ti. ",
  "kv7.3:2.2": "āmantā. anu ṭha: ",
  "kv7.3:2.3": "hañci phasso cittena sahajāto, tena vata re vattabbe: ",
  "kv7.3:2.4": "phasso cetasiko’ti. ",
  "kv7.3:2.5": "vedanā …pe… ",
  "kv7.3:2.6": "saññā …pe… ",
  "kv7.3:2.7": "cetanā …pe… ",
  "kv7.3:2.8": "saddhā …pe… ",
  "kv7.3:2.9": "viriyaṃ …pe… ",
  "kv7.3:2.10": "sati …pe… ",
  "kv7.3:2.11": "samādhi …pe… ",
  "kv7.3:2.12": "paññā …pe… ",
  "kv7.3:2.13": "rāgo …pe… ",
  "kv7.3:2.14": "doso …pe… ",
  "kv7.3:2.15": "moho …pe… ",
  "kv7.3:2.16": "anottappaṃ cittena sahajātanti. ",
  "kv7.3:2.17": "āmantā. anu ṭha: ",
  "kv7.3:2.18": "hañci anottappaṃ cittena sahajātaṃ, tena vata re vattabbe: ",
  "kv7.3:2.19": "anottappaṃ cetasikanti. ",
  "kv7.3:3.1": "‘cittena sahajātā’ti katvā cetasikā’ti. ",
  "kv7.3:3.2": "āmantā. ",
  "kv7.3:3.3": "‘phassena sahajātā’ti katvā phassikā’ti. ",
  "kv7.3:3.4": "āmantā. ",
  "kv7.3:3.5": "‘cittena sahajātā’ti katvā cetasikā’ti. ",
  "kv7.3:3.6": "āmantā. ",
  "kv7.3:3.7": "vedanāya …pe… ",
  "kv7.3:3.8": "saññāya …pe… ",
  "kv7.3:3.9": "cetanāya …pe… ",
  "kv7.3:3.10": "saddhāya …pe… ",
  "kv7.3:3.11": "viriyena …pe… ",
  "kv7.3:3.12": "satiyā …pe… ",
  "kv7.3:3.13": "samādhinā …pe… ",
  "kv7.3:3.14": "paññāya …pe… ",
  "kv7.3:3.15": "rāgena …pe… ",
  "kv7.3:3.16": "dosena …pe… ",
  "kv7.3:3.17": "mohena …pe… ",
  "kv7.3:3.18": "anottappena sahajātā’ti katvā anottappikā’ti. ",
  "kv7.3:3.19": "āmantā. ",
  "kv7.3:4.1": "natthī cetasiko dhammo’ti. ",
  "kv7.3:4.2": "āmantā. ",
  "kv7.3:4.3": "nanu vuttaṃ bhagavatā: ",
  "kv7.3:5.1": "“cittaṃ hidaṃ cetasikā ca dhammā ",
  "kv7.3:5.2": "anattato saṃviditassa honti. ",
  "kv7.3:5.3": "hīnappaṇītaṃ tadubhaye viditvā ",
  "kv7.3:5.4": "sammaddaso vedi palokadhammanti” ",
  "kv7.3:6.1": "atthe’va suttanto’ti. ",
  "kv7.3:6.2": "āmantā. ",
  "kv7.3:6.3": "tena hi atthī ‘cetasiko dhammo’ti. ",
  "kv7.3:7.1": "natthī cetasiko dhammo’ti. ",
  "kv7.3:7.2": "āmantā. ",
  "kv7.3:7.3": "nanu vuttaṃ bhagavatā ",
  "kv7.3:7.4": "“idha kevaṭṭa bhikkhu parasattānaṃ parapuggalānaṃ cittampi ādisati, cetasikampi ādisati, vitakkitampi ādisati, vicāritampi ādisati: ",
  "kv7.3:7.5": "evampi te mano. itthampi te mano. itipi te citta’nti” ",
  "kv7.3:7.6": "atthe’va suttanto’ti. ",
  "kv7.3:7.7": "āmantā. ",
  "kv7.3:7.8": "tena hi ‘atthī cetasiko dhammo’ti. ",
  "kv7.3:7.9": "cetasikakathā niṭṭhitā. "
}
