  "kv1.8:5.3": "āmantā. ",
  "kv1.8:5.4": "atītā avipakkavipākā dhammā ",
  "kv1.8:5.5": "te natthī’ti. ",
  "kv1.8:5.6": "na hevaṃ vattabbe …pe… ",
  "kv1.8:6.1": "atītā avipakkavipākā dhammā ",
  "kv1.8:6.2": "te atthī’ti. ",
  "kv1.8:6.3": "āmantā. ",
  "kv1.8:6.4": "nanu atītā avipakkavipākā dhammā niruddhā’ti. ",
  "kv1.8:6.5": "āmantā. ",
  "kv1.8:6.6": "hañci atītā avipakkavipākā dhammā niruddhā, no ca vata re vattabbe: ",
  "kv1.8:6.7": "atītā avipakkavipākā dhammā ",
  "kv1.8:6.8": "te atthī’ti. ",
  "kv1.8:7.1": "atītā avipakkavipākā dhammā niruddhā, ",
  "kv1.8:7.2": "te atthī’ti. ",
  "kv1.8:7.3": "āmantā. ",
  "kv1.8:7.4": "atītā vipakkavipākā dhammā niruddhā, ",
  "kv1.8:7.5": "te atthī’ti. ",
  "kv1.8:7.6": "na hevaṃ vattabbe …pe… ",
  "kv1.8:7.7": "atītā avipakkavipākā dhammā niruddhā, ",
  "kv1.8:7.8": "te atthī’ti. ",
  "kv1.8:7.9": "āmantā. ",
  "kv1.8:7.10": "atītā avipākā dhammā niruddhā, ",
  "kv1.8:7.11": "te atthī’ti. ",
  "kv1.8:7.12": "na hevaṃ vattabbe …pe… ",
  "kv1.8:8.1": "atītā vipakkavipākā dhammā niruddhā, ",
  "kv1.8:8.2": "te natthī’ti. ",
  "kv1.8:8.3": "āmantā. ",
  "kv1.8:8.4": "atītā avipakkavipākā dhammā niruddhā, ",
  "kv1.8:8.5": "te natthī’ti. ",
  "kv1.8:8.6": "na hevaṃ vattabbe …pe… ",
  "kv1.8:9.1": "atītā vipakkavipākā dhammā niruddhā, te natthī’ti. āmantā. atītā avipākā dhammā niruddhā, ",
  "kv1.8:9.2": "te natthī’ti. ",
  "kv1.8:9.3": "",
  "kv1.8:9.4": "",
  "kv1.8:9.5": "",
  "kv1.8:9.6": "na hevaṃ vattabbe …pe… ",
  "kv1.8:10.1": "atītā avipakkavipākā dhammā niruddhā, ",
  "kv1.8:10.2": "te atthī’ti. ",
  "kv1.8:10.3": "āmantā. ",
  "kv1.8:10.4": "atītā vipakkavipākā dhammā niruddhā, ",
  "kv1.8:10.5": "te natthī’ti. ",
  "kv1.8:10.6": "āmantā. ",
  "kv1.8:10.7": "atītā ekadesaṃ vipakkavipākā dhammā, niruddhā, ekadesaṃ avipakkavipākā dhammā niruddhā, ",
  "kv1.8:10.8": "te ekacce atthī ekacce natthī’ti. ",
  "kv1.8:10.9": "na hevaṃ vattabbe …pe… ",
  "kv1.8:11.1": "na vattabbaṃ: ",
  "kv1.8:11.2": "atītā avipakkavipākā dhammā ",
  "kv1.8:11.3": "te atthī’ti. ",
  "kv1.8:11.4": "āmantā. ",
  "kv1.8:11.5": "nanu atītā avipakkavipākā dhammā vipaccissantīti. ",
  "kv1.8:11.6": "āmantā. ",
  "kv1.8:11.7": "hañci atītā avipakkavipākā dhammā vipaccissanti, tena vata re vattabbe: ",
  "kv1.8:11.8": "atītā avipakkavipākā dhammā, ",
  "kv1.8:11.9": "te atthī’ti. ",
  "kv1.8:12.1": "atītā avipakkavipākā dhammā vipaccissantī’ti katvā te atthī’ti. ",
  "kv1.8:12.2": "āmantā. ",
  "kv1.8:12.3": "vipaccissantīti katvā paccuppannā’ti. ",
  "kv1.8:12.4": "na hevaṃ vattabbe …pe… ",
  "kv1.8:12.5": "vipaccissantī’ti katvā paccuppannā’ti. ",
  "kv1.8:12.6": "āmantā. ",
  "kv1.8:12.7": "paccuppannā dhammā nirujjhissantī’ti katvā te natthī’ti. ",
  "kv1.8:12.8": "na hevaṃ vattabbe …pe… ",
  "kv1.8:13.0": "",
  "kv1.8:13.1": "anāgataṃ atthī’ti. ",
  "kv1.8:13.2": "ekaccaṃ atthī, ekaccaṃ natthī’ti. ",
  "kv1.8:13.3": "ekaccaṃ jātaṃ ekaccaṃ ajātaṃ, ",
  "kv1.8:13.4": "ekaccaṃ sañjātaṃ ekaccaṃ asañjātaṃ, ",
  "kv1.8:13.5": "ekaccaṃ nibbattaṃ ekaccaṃ anibbattaṃ, ",
  "kv1.8:13.6": "ekaccaṃ pātubhūtaṃ ekaccaṃ apātubhūtanti. ",
  "kv1.8:13.7": "na hevaṃ vattabbe …pe… ",
  "kv1.8:14.1": "anāgataṃ ekaccaṃ atthī, ekaccaṃ natthī’ti. ",
  "kv1.8:14.2": "āmantā. ",
  "kv1.8:14.3": "anāgata uppādino dhammā, ekacce atthī ekacce natthī’ti. ",
  "kv1.8:14.4": "na hevaṃ vattabbe …pe… ",
  "kv1.8:14.5": "anāgataṃ ekaccaṃ atthī, ekaccaṃ natthī’ti. ",
  "kv1.8:14.6": "āmantā. ",
  "kv1.8:14.7": "anāgatā anuppādino dhammā, ekacce atthī ekacce natthī’ti. ",
  "kv1.8:14.8": "na hevaṃ vattabbe …pe… ",
  "kv1.8:15.1": "anāgataṃ ekaccaṃ atthi, ekaccaṃ natthī’ti. ",
  "kv1.8:15.2": "āmantā ",
  "kv1.8:15.3": "kimatthi kiṃ natthī’ti. ",
  "kv1.8:15.4": "anāgatā uppādino dhammā ",
  "kv1.8:15.5": "te atthi, ",
  "kv1.8:15.6": "anāgatā anuppādino dhammā ",
  "kv1.8:15.7": "te natthī’ti. ",
  "kv1.8:15.8": "anāgatā uppādino dhammā ",
  "kv1.8:15.9": "te atthī’ti. ",
  "kv1.8:15.10": "āmantā. ",
  "kv1.8:15.11": "anāgatā anuppādino dhammā ",
  "kv1.8:15.12": "te atthī’ti. ",
  "kv1.8:15.13": "na hevaṃ vattabbe …pe… ",
  "kv1.8:15.14": "anāgatā anuppādino dhammā, ",
  "kv1.8:15.15": "te natthīti. ",
  "kv1.8:15.16": "āmantā. ",
  "kv1.8:15.17": "anāgatā uppādino dhammā, ",
  "kv1.8:15.18": "te natthī’ti. ",
  "kv1.8:15.19": "na hevaṃ vattabbe …pe… ",
  "kv1.8:16.1": "anāgatā uppādino dhammā ",
  "kv1.8:16.2": "te atthī’ti. ",
  "kv1.8:16.3": "āmantā. ",
  "kv1.8:16.4": "nanu anāgatā uppādino dhammā ajātāti. ",
  "kv1.8:16.5": "āmantā. ",
  "kv1.8:16.6": "hañci anāgatā uppādino dhammā ajātāti, no ca vata re vattabbe ",
  "kv1.8:16.7": "anāgatā uppādino dhammā, ",
  "kv1.8:16.8": "te atthī’ti. ",
  "kv1.8:17.1": "anāgatā uppādino dhammā ajātā, ",
  "kv1.8:17.2": "te atthīti. ",
  "kv1.8:17.3": "āmantā. ",
  "kv1.8:17.4": "anāgatā anuppādino dhammā ajātā, ",
  "kv1.8:17.5": "te atthī’ti. ",
  "kv1.8:17.6": "na hevaṃ vattabbe …pe… ",
  "kv1.8:17.7": "anāgatā anuppādino dhammā ajātā, ",
  "kv1.8:17.8": "te natthī’ti. ",
  "kv1.8:17.9": "āmantā. ",
  "kv1.8:17.10": "anāgatā uppādino dhammā ajātā, ",
  "kv1.8:17.11": "te natthī’ti. ",
  "kv1.8:17.12": "na hevaṃ vattabbe …pe… ",
  "kv1.8:18.1": "na vattabbaṃ ",
  "kv1.8:18.2": "‘anāgatā uppādino dhammā, ",
  "kv1.8:18.3": "te atthī’ti. ",
  "kv1.8:18.4": "āmantā. ",
  "kv1.8:18.5": "nanu anāgatā uppādino dhammā uppajjissantī’ti. ",
  "kv1.8:18.6": "āmantā. ",
  "kv1.8:18.7": "hañci anāgatā uppādino dhammā uppajjissanti, tena vata re vattabbe: ",
  "kv1.8:18.8": "anāgatā uppādino dhammā, ",
  "kv1.8:18.9": "te atthī’ti. ",
  "kv1.8:19.1": "anāgatā uppādino dhammā uppajjissantī’ti katvā te atthī’ti. ",
  "kv1.8:19.2": "āmantā. ",
  "kv1.8:19.3": "uppajjissantī’ti katvā paccuppannā’ti. ",
  "kv1.8:19.4": "na hevaṃ vattabbe …pe… ",
  "kv1.8:19.5": "uppajjissantī’ti katvā paccuppannā’ti. ",
  "kv1.8:19.6": "āmantā. ",
  "kv1.8:19.7": "paccuppannā dhammā nirujjhissantī’ti katvā te natthī’ti. ",
  "kv1.8:19.8": "na hevaṃ vattabbe …pe… ",
  "kv1.8:19.9": "ekaccaṃ atthītikathā niṭṭhitā. "
