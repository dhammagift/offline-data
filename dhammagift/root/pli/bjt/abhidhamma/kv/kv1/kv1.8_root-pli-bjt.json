  "kv1.8:0.4": "ekaccaṃ atthītikathā ",
  "kv1.8:1.0": "1. 8. ",
  "kv1.8:1.1": "atītaṃ atthī’ti. ",
  "kv1.8:1.2": "ekaccaṃ atthī ekaccaṃ natthī’ti. ",
  "kv1.8:1.3": "ekaccaṃ niruddhaṃ, ekaccaṃ na niruddhaṃ, ",
  "kv1.8:1.4": "ekaccaṃ vigataṃ, ekaccaṃ avigataṃ, ",
  "kv1.8:1.5": "ekaccaṃ atthaṅgataṃ, ekaccaṃ na atthaṅgataṃ, ",
  "kv1.8:1.6": "ekaccaṃ abbhatthaṅgataṃ, ekaccaṃ na abbhatthaṅgatanti. ",
  "kv1.8:1.7": "na hevaṃ vattabbe …pe… ",
  "kv1.8:2.1": "atītaṃ ekaccaṃ atthī, ekaccaṃ natthī’ti. ",
  "kv1.8:2.2": "āmantā. ",
  "kv1.8:2.3": "atītā avipakkavipākā dhammā ekacce atthī, ekacce natthī’ti. ",
  "kv1.8:2.4": "na hevaṃ vattabbe …pe… ",
  "kv1.8:2.5": "atītaṃ ekaccaṃ atthī, ekaccaṃ natthī’ti. ",
