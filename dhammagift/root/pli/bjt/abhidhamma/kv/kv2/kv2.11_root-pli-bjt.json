  "kv2.11:0.3": "",
  "kv2.11:0.4": "2. 11. nirodhakathā ",
  "kv2.11:1.1": "dve nirodhā’ti. ",
  "kv2.11:1.2": "āmantā. ",
  "kv2.11:1.3": "dve dukkhanirodhāti. ",
  "kv2.11:1.4": "na hevaṃ vattabbe …pe… ",
  "kv2.11:1.5": "dve dukkhanirodhāti. ",
  "kv2.11:1.6": "āmantā. ",
  "kv2.11:1.7": "dve nirodhasaccānīti. ",
  "kv2.11:1.8": "na hevaṃ vattabbe …pe… ",
  "kv2.11:1.9": "dve nirodhasaccānīti. ",
  "kv2.11:1.10": "āmantā. ",
  "kv2.11:1.11": "dve dukkhasaccānīti. ",
  "kv2.11:1.12": "na hevaṃ vattabbe …pe… ",
  "kv2.11:1.13": "dve nirodhasaccānīti. ",
  "kv2.11:1.14": "āmantā. ",
  "kv2.11:1.15": "dve samudayasaccānīti. ",
  "kv2.11:1.16": "na hevaṃ vattabbe …pe… ",
  "kv2.11:1.17": "dve nirodhasaccānīti. ",
  "kv2.11:1.18": "āmantā. ",
  "kv2.11:1.19": "dve maggasaccānīti. ",
  "kv2.11:1.20": "na hevaṃ vattabbe …pe… ",
  "kv2.11:2.1": "dve nirodhasaccānīti. ",
  "kv2.11:2.2": "āmantā. ",
  "kv2.11:2.3": "dve tāṇāni …pe… ",
  "kv2.11:2.4": "dve leṇāni …pe… ",
  "kv2.11:2.5": "dve saraṇāni …pe… ",
  "kv2.11:2.6": "dve parāyanāni …pe… ",
  "kv2.11:2.7": "dve accutāni …pe… ",
  "kv2.11:2.8": "dve amatāni …pe… ",
  "kv2.11:2.9": "dve nibbānānīti. ",
  "kv2.11:2.10": "na hevaṃ vattabbe …pe… ",
  "kv2.11:3.1": "dve nibbānānī’ti. ",
  "kv2.11:3.2": "āmantā. ",
  "kv2.11:3.3": "atthī dvinnaṃ nibbānānaṃ uccanīcatā, hīnappaṇītatā, ukkaṃsāvakaṃso, sīmā vā bhedo vā, rājī vā antarikā vāti. ",
  "kv2.11:3.4": "na hevaṃ vattabbe …pe… ",
  "kv2.11:4.1": "dve nirodhāti. ",
  "kv2.11:4.2": "āmantā. ",
  "kv2.11:4.3": "nanu appaṭisaṅkhāniruddhe saṅkhāre paṭisaṅkhā nirodhentī’ti. ",
  "kv2.11:4.4": "āmantā. ",
  "kv2.11:4.5": "hañci appaṭisaṅkhāniruddhe saṅkhāre paṭisaṅkhā nirodhenti, no ca vata re vattabbe ",
  "kv2.11:4.6": "‘dve nirodhā’ti. ",
  "kv2.11:5.1": "na vattabbaṃ ",
  "kv2.11:5.2": "dve nirodhāti. ",
  "kv2.11:5.3": "āmantā. ",
  "kv2.11:5.4": "nanu appaṭisaṅkhāniruddhāpi saṅkhārā accantabhaggā, paṭisaṅkhāniruddhāpi saṅkhārā accantabhaggāti. ",
  "kv2.11:5.5": "āmantā. ",
  "kv2.11:5.6": "hañci appaṭisaṅkhāniruddhāpi saṅkhārā accantabhaggā, paṭisaṅkhāniruddhāpi saṅkhārā accantabhaggā, tena vata re vattabbe ",
  "kv2.11:5.7": "‘dve nirodhā’ti. ",
  "kv2.11:6.1": "dveva nirodhāti. ",
  "kv2.11:6.2": "āmantā. ",
  "kv2.11:6.3": "paṭisaṅkhāniruddhāpi saṅkhārā ariyamaggaṃ āgamma niruddhāti. ",
  "kv2.11:6.4": "āmantā. ",
  "kv2.11:6.5": "appaṭisaṅkhāniruddhāpi saṅkhārā ariyamaggaṃ āgamma niruddhāti. ",
  "kv2.11:6.6": "na hevaṃ vattabbe …pe… ",
  "kv2.11:7.1": "dve nirodhāti. ",
  "kv2.11:7.2": "āmantā. ",
  "kv2.11:7.3": "paṭisaṅkhāniruddhā saṅkhārā na puna uppajjantīti. ",
  "kv2.11:7.4": "āmantā. ",
  "kv2.11:7.5": "appaṭisaṅkhāniruddhā saṅkhārā na puna uppajjantīti. ",
  "kv2.11:7.6": "na hevaṃ vattabbe …pe… ",
  "kv2.11:7.7": "tena hi na vattabbaṃ: ",
  "kv2.11:7.8": "dve nirodhāti. ",
  "kv2.11:7.9": "nirodhakathā niṭṭhitā. ",
  "kv2.11:7.10": "dutiyo vaggo ",
  "kv2.11:7.11": "niṭṭhito. tassa uddānaṃ: ",
  "kv2.11:8.1": "parūpahāro aññāṇaṃ ",
  "kv2.11:8.2": "kaṅkhā paravitaraṇā ",
  "kv2.11:8.3": "vacībhedo dukkhāhāro ",
  "kv2.11:8.4": "cittaṭṭhiti ca kukkuḷā ",
  "kv2.11:8.5": "ekābhisamayo ceva ",
  "kv2.11:8.6": "vohāro ca nirodhakoti. "
}
