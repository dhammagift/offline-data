  "kv16.2:0.1": "",
  "kv16.2:0.2": "",
  "kv16.2:0.3": "",
  "kv16.2:0.4": "16. 2. paggaha kathā. ",
  "kv16.2:1.1": "paro parassa cittaṃ paggaṇhātī’ti. ",
  "kv16.2:1.2": "āmantā. ",
  "kv16.2:1.3": "paro parassa cittaṃ mā rajji, mā dussi, mā muyhi, mā kilissī’ti paggaṇhātī’ti. ",
  "kv16.2:1.4": "na hevaṃ vattabbe …pe… ",
  "kv16.2:1.5": "paro parassa cittaṃ paggaṇhātī’ti. ",
  "kv16.2:1.6": "āmantā. ",
  "kv16.2:1.7": "paro parassa alobhaṃ kusalamūlaṃ janeti, ",
  "kv16.2:1.8": "adosaṃ kusalamūlaṃ janeti, ",
  "kv16.2:1.9": "amohaṃ kusalamūlaṃ janeti, ",
  "kv16.2:1.10": "saddhaṃ janeti, ",
  "kv16.2:1.11": "viriyaṃ janeti, ",
  "kv16.2:1.12": "satiṃ janeti, ",
  "kv16.2:1.13": "samādhiṃ janeti, ",
  "kv16.2:1.14": "paññaṃ janetī’ti. ",
  "kv16.2:1.15": "na hevaṃ vattabbe …pe… ",
  "kv16.2:1.16": "pare parassa cittaṃ paggaṇhātī’ti. ",
  "kv16.2:1.17": "āmantā. ",
  "kv16.2:1.18": "paro parassa uppanno phasso mā nirujjhi’ti paggaṇhātī’ti. ",
  "kv16.2:1.19": "na hevaṃ vattabbe …pe… ",
  "kv16.2:1.20": "paro parassa uppannā vedanā …pe… ",
  "kv16.2:1.21": "uppannā saññā …pe… uppannā cetanā …pe… uppannaṃ cittaṃ …pe… uppannā saddhā …pe… uppannaṃ viriyaṃ …pe… uppannā sati …pe… uppanno samādhi …pe… uppannā paññā mā nirujjhī’ti paggaṇhātī’ti. ",
  "kv16.2:1.22": "na hevaṃ vattabbe …pe… ",
  "kv16.2:2.1": "paro parassa cittaṃ paggaṇhātī’ti. ",
  "kv16.2:2.2": "āmantā. ",
  "kv16.2:2.3": "paro parassa atthāya rāgaṃ pajahati, ",
  "kv16.2:2.4": "dosaṃ pajahati, ",
  "kv16.2:2.5": "mohaṃ pajahati …pe… ",
  "kv16.2:2.6": "anottappaṃ pajahatī’ti. ",
  "kv16.2:2.7": "na hevaṃ vattabbe …pe… ",
  "kv16.2:3.1": "paro parassa cittaṃ paggaṇhātī’ti. ",
  "kv16.2:3.2": "āmantā. ",
  "kv16.2:3.3": "paro parassa atthāya maggaṃ bhāveti …pe… ",
  "kv16.2:3.4": "satipaṭṭhānaṃ bhāveti …pe… ",
  "kv16.2:3.5": "bojjhaṅgaṃ bhāvetī’ti. ",
  "kv16.2:3.6": "na hevaṃ vattabbe …pe… ",
  "kv16.2:4.1": "paro parassa cittaṃ paggaṇhātī’ti. ",
  "kv16.2:4.2": "āmantā. ",
  "kv16.2:4.3": "paro parassa atthāya dukkhaṃ parijānāti …pe… ",
  "kv16.2:4.4": "maggaṃ bhāvetī’ti. ",
  "kv16.2:4.5": "na hevaṃ vattabbe …pe… ",
  "kv16.2:5.1": "paro parassa cittaṃ paggaṇhātī’ti. ",
  "kv16.2:5.2": "āmantā. ",
  "kv16.2:5.3": "añño aññassa kārako, paraṃ kataṃ sukhaṃ dukkhaṃ, añño karoti, añño paṭisaṃvedetī’ti. ",
  "kv16.2:5.4": "na hevaṃ vattabbe …pe… ",
  "kv16.2:6.1": "paro parassa cittaṃ paggaṇhātī’ti. ",
  "kv16.2:6.2": "āmantā. ",
  "kv16.2:6.3": "nanu vuttaṃ bhagavatā. ",
  "kv16.2:7.1": "“attanāva kataṃ pāpaṃ …pe… ",
  "kv16.2:7.2": "nāñño aññā visodhaye”ti ",
  "kv16.2:8.1": "attheva suttantoti. ",
  "kv16.2:8.2": "āmantā. ",
  "kv16.2:8.3": "tena hi na vattabbaṃ: ",
  "kv16.2:8.4": "paro parassa cittaṃ paggaṇhātī’ti. ",
  "kv16.2:9.1": "na vattabbaṃ ",
  "kv16.2:9.2": "paro parassa cittaṃ paggaṇhātī’ti. ",
  "kv16.2:9.3": "āmantā. ",
  "kv16.2:9.4": "nanu atthi balappattā atthi vasībhūtā’ti. ",
  "kv16.2:9.5": "āmantā. ",
  "kv16.2:9.6": "hañci atthi balappattā atthi vasībhūtā. tena vata re vattabbe ",
  "kv16.2:9.7": "“paro parassa cittaṃ paggaṇhā”ti. ",
  "kv16.2:9.8": "paggahakathā niṭṭhitā. "
}
