  "kv16.1:0.1": "",
  "kv16.1:0.2": "",
  "kv16.1:0.3": "",
  "kv16.1:0.4": "16. 1. niggahakathā. ",
  "kv16.1:1.1": "paro parassa cittaṃ niggaṇhātī’ti. ",
  "kv16.1:1.2": "āmantā. ",
  "kv16.1:1.3": "paro parassa cittaṃ mā rajji, mā dussi, mā muyhi mā kilissī’ti niggaṇhātī’ti. ",
  "kv16.1:1.4": "na hevaṃ vattabbe …pe… ",
  "kv16.1:1.5": "paro parassa cittaṃ niggaṇhātī’ti. ",
  "kv16.1:1.6": "āmantā. ",
  "kv16.1:1.7": "paro parassa uppanno phasso mā nirujjhī’ti niggaṇhātī’ti. ",
  "kv16.1:1.8": "na hevaṃ vattabbe …pe… ",
  "kv16.1:1.9": "paro parassa uppannā vedanā …pe… ",
  "kv16.1:1.10": "uppannā saññā …pe… ",
  "kv16.1:1.11": "uppannā cetanā …pe… ",
  "kv16.1:1.12": "uppannaṃ cittaṃ …pe… ",
  "kv16.1:1.13": "uppannā saddhā …pe… ",
  "kv16.1:1.14": "uppannaṃ viriyaṃ …pe… ",
  "kv16.1:1.15": "uppannā sati …pe… ",
  "kv16.1:1.16": "uppanno samādhi …pe… ",
  "kv16.1:1.17": "uppannā paññā mā nirujjhi’ti niggaṇhātī’ti. ",
  "kv16.1:1.18": "na hevaṃ vattabbe …pe… ",
  "kv16.1:2.1": "paro parassa cittaṃ niggaṇhātī’ti. ",
  "kv16.1:2.2": "āmantā. ",
  "kv16.1:2.3": "paro parassa atthāya rāgaṃ pajahatī’ti …pe… ",
  "kv16.1:2.4": "dosaṃ pajahati …pe… ",
  "kv16.1:2.5": "anottappaṃ pajahatī’ti. ",
  "kv16.1:2.6": "na hevaṃ vattabbe …pe… ",
  "kv16.1:3.1": "paro parassa cittaṃ niggaṇhātī’ti. ",
  "kv16.1:3.2": "āmantā. ",
  "kv16.1:3.3": "paro parassa atthāya maggaṃ bhāveti …pe… ",
  "kv16.1:3.4": "satipaṭṭhānaṃ bhāveti …pe… ",
  "kv16.1:3.5": "bojjhaṅgaṃ bhāvetī’ti. ",
  "kv16.1:3.6": "na hevaṃ vattabbe …pe… ",
  "kv16.1:4.1": "paro parassa cittaṃ niggaṇhātī’ti. ",
  "kv16.1:4.2": "āmantā. ",
  "kv16.1:4.3": "paro parassa atthāya dukkhaṃ parijānāti, samudayaṃ pajahati, nirodhaṃ sacchikaroti, maggaṃ bhāvetī’ti. ",
  "kv16.1:4.4": "na hevaṃ vattabbe …pe… ",
  "kv16.1:5.1": "paro parassa cittaṃ niggaṇhātī’ti. ",
  "kv16.1:5.2": "āmantā. ",
  "kv16.1:5.3": "añño aññassa kārako, paraṃ kataṃ sukhaṃ dukkhaṃ, añño karoti, añño paṭisaṃvedetī’ti. ",
  "kv16.1:5.4": "na hevaṃ vattabbe …pe… ",
  "kv16.1:6.1": "paro parassa cittaṃ niggaṇhātī’ti. ",
  "kv16.1:6.2": "āmantā. ",
  "kv16.1:6.3": "nanu vuttaṃ bhagavatā: ",
  "kv16.1:7.1": "“attanā’va kataṃ pāpaṃ ",
  "kv16.1:7.2": "attanā saṅkilissati. ",
  "kv16.1:7.3": "attanā akataṃ pāpaṃ ",
  "kv16.1:7.4": "attanā: va visujjhati. ",
  "kv16.1:7.5": "suddhi asuddhi paccattaṃ ",
  "kv16.1:7.6": "nāñño aññaṃ visodhaye”ti ",
  "kv16.1:8.1": "attheva suttanto’ti. ",
  "kv16.1:8.2": "āmantā. ",
  "kv16.1:8.3": "tena hi na vattabbaṃ: ",
  "kv16.1:8.4": "“paro parassa cittaṃ niggaṇhātī’ti. ",
  "kv16.1:9.1": "na vattabbaṃ ",
  "kv16.1:9.2": "paro parassa cittaṃ niggaṇhātī’ti. ",
  "kv16.1:9.3": "āmantā. ",
  "kv16.1:9.4": "nanu atthi balappattā, atthi vasībhūtā’ti. ",
  "kv16.1:9.5": "āmantā. ",
  "kv16.1:9.6": "hañci atthi balappattā, atthi vasībhūtā. tena vata re vattabbe ",
  "kv16.1:9.7": "“paro parassa cittaṃ niggaṇhātī”ti. ",
  "kv16.1:9.8": "niggahakathā niṭṭhitā. "
}
