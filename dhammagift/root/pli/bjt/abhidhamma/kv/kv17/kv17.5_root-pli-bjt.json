  "kv17.5:0.1": "",
  "kv17.5:0.2": "",
  "kv17.5:0.3": "",
  "kv17.5:0.4": "17. 5. ṭhapetvā ariyamagganti kathā. ",
  "kv17.5:1.1": "ṭhapetvā ariyamaggaṃ avasesā saṅkhārā dukkhā’ti. ",
  "kv17.5:1.2": "āmantā. ",
  "kv17.5:1.3": "dukkhasamudayopi dukkho’ti. ",
  "kv17.5:1.4": "na hevaṃ vattabbe …pe… ",
  "kv17.5:1.5": "dukkhasamudayopi dukkho’ti. ",
  "kv17.5:1.6": "āmantā. ",
  "kv17.5:1.7": "tīṇeva ariyasaccānī’ti. ",
  "kv17.5:1.8": "na hevaṃ vattabbe …pe… ",
  "kv17.5:1.9": "tīṇeva ariyasaccānīti. ",
  "kv17.5:1.10": "āmantā. ",
  "kv17.5:1.11": "nanu cattāri ariyasaccāni vuttāni bhagavatā: ",
  "kv17.5:1.12": "“dukkhaṃ dukkhasamudayo dukkhanirodho dukkhanirodhagāminī paṭipadā”ti. ",
  "kv17.5:1.13": "āmantā. ",
  "kv17.5:1.14": "hañci cattāri ariyasaccāni vuttāni bhagavatā: ",
  "kv17.5:1.15": "dukkhaṃ dukkhasamudayo dukkhanirodho dukkhanirodhagāminī paṭipadā, ",
  "kv17.5:1.16": "no ca vata re vattabbe: ",
  "kv17.5:1.17": "“tīṇeva ariyasaccānī”ti. ",
  "kv17.5:2.1": "dukkhasamudayo’pi dukkho’ti. ",
  "kv17.5:2.2": "āmantā. ",
  "kv17.5:2.3": "kenaṭṭhenāti. ",
  "kv17.5:2.4": "aniccaṭṭhenāti. ",
  "kv17.5:2.5": "ariyamaggo anicco’ti. ",
  "kv17.5:2.6": "āmantā. ",
  "kv17.5:2.7": "ariyamaggo dukkho’ti. ",
  "kv17.5:2.8": "na hevaṃ vattabbe …pe… ",
  "kv17.5:3.1": "ariyamaggo anicco, so ca na dukkhoti. ",
  "kv17.5:3.2": "āmantā. ",
  "kv17.5:3.3": "dukkhasamudayo anicco, so ca na dukkho’ti. ",
  "kv17.5:3.4": "na hevaṃ vattabbe …pe… ",
  "kv17.5:3.5": "dukkhasamudayo anicco, so ca dukkho’ti. ",
  "kv17.5:3.6": "āmantā. ",
  "kv17.5:3.7": "ariyamaggo anicco, so ca dukkho’ti. ",
  "kv17.5:3.8": "na hevaṃ vattabbe …pe… ",
  "kv17.5:4.1": "na vattabbaṃ ",
  "kv17.5:4.2": "ṭhapetvā ariyamaggaṃ avasesā saṅkhārā dukkhā’ti ",
  "kv17.5:4.3": "āmantā. ",
  "kv17.5:4.4": "nanu sā dukkhanirodhagāminī paṭipadāti. ",
  "kv17.5:4.5": "āmantā. ",
  "kv17.5:4.6": "hañci sā dukkhanirodhagāminī paṭipadā, tena vata re vattabbe: ",
  "kv17.5:4.7": "“ṭhapetvā ariyamaggaṃ avasesā saṅkhārā dukkhā”ti. ",
  "kv17.5:4.8": "ṭhapetvā ariyamagganti kathā niṭṭhitā. "
}
