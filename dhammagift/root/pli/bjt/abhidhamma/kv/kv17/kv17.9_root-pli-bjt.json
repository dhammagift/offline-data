  "kv17.9:0.1": "",
  "kv17.9:0.2": "",
  "kv17.9:0.3": "",
  "kv17.9:0.4": "17. 9. na vattabbaṃ saṅghassa dinnaṃ mahapphalanti kathā. ",
  "kv17.9:1.1": "na vattabbaṃ ",
  "kv17.9:1.2": "“saṅghassa dinnaṃ mahapphala”nti. ",
  "kv17.9:1.3": "āmantā. ",
  "kv17.9:1.4": "nanu saṅgho āhuneyyo pāhuneyyo dakkhiṇeyyo añjalikaraṇīyo anuttaraṃ puññakkhettaṃ lokassā’ti. ",
  "kv17.9:1.5": "āmantā. ",
  "kv17.9:1.6": "hañci saṅgho āhuneyyo …pe… anuttaraṃ puññakkhettaṃ lokassa, tena vata re vattabbe: ",
  "kv17.9:1.7": "“saṅghassa dinnaṃ mahapphala”nti. ",
  "kv17.9:2.1": "na vattabbaṃ ",
  "kv17.9:2.2": "‘saṅghassa dinnaṃ mahapphala’nti. ",
  "kv17.9:2.3": "āmantā. ",
  "kv17.9:2.4": "nanu cattāro purisayugā aṭṭhapurisapuggalā dakkhiṇeyyā vuttā bhagavatā’ti. ",
  "kv17.9:2.5": "āmantā. ",
  "kv17.9:2.6": "hañci cattāro purisayugā aṭṭhapurisapuggalā dakkhiṇeyyā vuttā bhagavatā, tena vata re vattabbe ",
  "kv17.9:2.7": "“saṅghassa dinnaṃ mahapphala”nti. ",
  "kv17.9:3.1": "na vattabbaṃ ",
  "kv17.9:3.2": "‘saṅghassa dinnaṃ mahapphala’nti. ",
  "kv17.9:3.3": "āmantā. ",
  "kv17.9:3.4": "nanu vuttaṃ bhagavatā ",
  "kv17.9:3.5": "“saṅghe gotami, dehi, saṅghe te dinne ahañceva pūjito bhavissāmi, saṅgho cā”ti. ",
  "kv17.9:3.6": "attheva suttanto’ti. ",
  "kv17.9:3.7": "āmantā. ",
  "kv17.9:3.8": "tena hi saṅghassa dinnaṃ mahapphala’nti. ",
  "kv17.9:4.1": "na vattabbaṃ ",
  "kv17.9:4.2": "saṅghassa dinnaṃ mahapphalanti. ",
  "kv17.9:4.3": "āmantā. ",
  "kv17.9:4.4": "nanu sakko devānamindo bhagavantaṃ etadavoca: ",
  "kv17.9:5.1": "“yajamānānaṃ manussānaṃ ",
  "kv17.9:5.2": "puññapekhāna pāṇinaṃ ",
  "kv17.9:5.3": "tarotaṃ opadhikaṃ puññaṃ ",
  "kv17.9:5.4": "kattha dinnaṃ mahapphalanti. ",
  "kv17.9:6.1": "cattāro ca paṭipannā ",
  "kv17.9:6.2": "cattāro ca phale ṭhitā ",
  "kv17.9:6.3": "esa saṅgho ujubhūto ",
  "kv17.9:6.4": "paññāsīlasamāhito. ",
  "kv17.9:7.1": "yajamānānaṃ manussānaṃ ",
  "kv17.9:7.2": "puññapekhāna pāṇinaṃ ",
  "kv17.9:7.3": "karotaṃ opadhikaṃ puññaṃ ",
  "kv17.9:7.4": "saṅghe dinnaṃ mahapphalanti. ",
  "kv17.9:8.1": "eso hi saṅgho vipulo mahaggato ",
  "kv17.9:8.2": "esappameyyo udadhīva sāgaro ",
  "kv17.9:8.3": "ete hi seṭṭhā naravīra sāvakā ",
  "kv17.9:8.4": "pabhaṅkarā dhammamudīrayanti. ",
  "kv17.9:9.1": "tesaṃ sudinnaṃ suhutaṃ suyiṭṭhaṃ ",
  "kv17.9:9.2": "ye saṅghamuddissa dadanti dānaṃ ",
  "kv17.9:9.3": "sā dakkhiṇā saṅghagatā patiṭṭhitā ",
  "kv17.9:9.4": "mahapphalā lokavidūna vaṇṇitā. ",
  "kv17.9:10.1": "etādisaṃ yaññamanussarantā ",
  "kv17.9:10.2": "ye vedajātā viharanti loke ",
  "kv17.9:10.3": "vineyya maccheramalaṃ samūlaṃ ",
  "kv17.9:10.4": "aninditā saggamupenti ṭhāna”nti. ",
  "kv17.9:11.1": "attheva suttantoti. ",
  "kv17.9:11.2": "āmantā. ",
  "kv17.9:11.3": "tena hi saṅghassa dinnaṃ mahapphalanti. ",
  "kv17.9:11.4": "na vattabbaṃ saṅghassa dinnaṃ mahapphalanti kathā niṭṭhitā. "
}
