  "kv17.3:0.3": "",
  "kv17.3:0.4": "17. 3. sabbamidaṃ kammatoti kathā. ",
  "kv17.3:1.1": "sabbamidaṃ. kammato’ti. ",
  "kv17.3:1.2": "āmantā. ",
  "kv17.3:1.3": "kammampi kammatoti. ",
  "kv17.3:1.4": "na hevaṃ vattabbe …pe… ",
  "kv17.3:1.5": "sabbamidaṃ kammatoti. ",
  "kv17.3:1.6": "āmantā. ",
  "kv17.3:1.7": "sabbamidaṃ pubbekatahetūti. ",
  "kv17.3:1.8": "na hevaṃvattabbe …pe… ",
  "kv17.3:1.9": "sabbamidaṃ. kammatoti. ",
  "kv17.3:1.10": "āmantā. ",
  "kv17.3:1.11": "sabbamidaṃ kammavipākatoti. ",
  "kv17.3:1.12": "na hevaṃ vattabbe …pe… ",
  "kv17.3:2.1": "sabbamidaṃ. kammavipākatoti. ",
  "kv17.3:2.2": "āmantā. ",
  "kv17.3:2.3": "kammavipākena pāṇaṃ haneyyāti. ",
  "kv17.3:2.4": "āmantā. ",
  "kv17.3:2.5": "pāṇātipāto saphaloti. ",
  "kv17.3:2.6": "āmantā. ",
  "kv17.3:2.7": "kammavipāko saphaloti. ",
  "kv17.3:2.8": "na hevaṃ vattabbe …pe… ",
  "kv17.3:2.9": "kammavipāko aphaloti. ",
  "kv17.3:2.10": "āmantā. ",
  "kv17.3:2.11": "pāṇātipāto aphalo’ti. ",
  "kv17.3:2.12": "na hevaṃ vattabbe …pe… ",
  "kv17.3:3.1": "kammavipākena adinnaṃ ādiyeyya …pe… ",
  "kv17.3:3.2": "musā bhaṇeyya …pe… ",
  "kv17.3:3.3": "pisuṇaṃ bhaṇeyya …pe… ",
  "kv17.3:3.4": "pharusaṃ bhaṇeyya …pe… ",
  "kv17.3:3.5": "samphaṃ palapeyya …pe… ",
  "kv17.3:3.6": "sandhiṃ chindeyya …pe… ",
  "kv17.3:3.7": "nillopaṃ hareyya …pe… ",
  "kv17.3:3.8": "ekāgārikaṃ kareyya …pe… ",
  "kv17.3:3.9": "paripanthe tiṭṭheyya …pe… ",
  "kv17.3:3.10": "paradāraṃ gaccheyya …pe… ",
  "kv17.3:3.11": "gāmaghātakaṃ kareyya …pe… ",
  "kv17.3:3.12": "nigamaghātakaṃ kareyya …pe… ",
  "kv17.3:3.13": "kammavipākena dānaṃ dadeyya …pe… ",
  "kv17.3:3.14": "cīvaraṃ dadeyya …pe… ",
  "kv17.3:3.15": "piṇḍapātaṃ dadeyya …pe… ",
  "kv17.3:3.16": "senāsanaṃ dadeyya ",
  "kv17.3:3.17": "…pe… gilānapaccaya bhesajja parikkhāraṃ dadeyyāti. ",
  "kv17.3:3.18": "āmantā. ",
  "kv17.3:3.19": "gilānapaccayabhesajjaparikkhāro saphaloti. ",
  "kv17.3:3.20": "āmantā. ",
  "kv17.3:3.21": "kammavipāko saphaloti. ",
  "kv17.3:3.22": "na hevaṃ vattabbe …pe… ",
  "kv17.3:3.23": "kammavipāko aphaloti. ",
  "kv17.3:3.24": "āmantā. ",
  "kv17.3:3.25": "gilānapaccayabhesajjaparikkhāro aphaloti. ",
  "kv17.3:3.26": "na hevaṃ vattabbaṃ …pe… ",
  "kv17.3:4.1": "na vattabbaṃ ",
  "kv17.3:4.2": "‘sabbamidaṃ kammato’ti. ",
  "kv17.3:4.3": "āmantā. ",
  "kv17.3:4.4": "nanu vuttaṃ bhagavatā: ",
  "kv17.3:5.1": "“kammunā vattati loko ",
  "kv17.3:5.2": "kammunā vattatī pajā, ",
  "kv17.3:5.3": "kammanibandhanā sattā. ",
  "kv17.3:5.4": "rathassāṇīva yāyato. ",
  "kv17.3:6.1": "kammena kittiṃ labhate pasaṃsaṃ ",
  "kv17.3:6.2": "kammena jāniṃ ca vadhaṃ ca bandhā. ",
  "kv17.3:6.3": "taṃ kammanānākaraṇaṃ viditvā ",
  "kv17.3:6.4": "kasmā vade natthi kammanti lokoti”ti ",
  "kv17.3:7.1": "attheva suttantoti. ",
  "kv17.3:7.2": "āmantā. ",
  "kv17.3:7.3": "tena hi “sabbamidaṃ kammato”ti. ",
  "kv17.3:7.4": "sabbamidaṃ kammatoti kathā niṭṭhitā. "
}
