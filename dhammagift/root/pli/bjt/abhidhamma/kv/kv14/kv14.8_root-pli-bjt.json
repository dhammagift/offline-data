  "kv14.8:0.1": "",
  "kv14.8:0.2": "",
  "kv14.8:0.3": "",
  "kv14.8:0.4": "14. 8. abyākatakathā. ",
  "kv14.8:1.1": "diṭṭhigataṃ abyākatanti. ",
  "kv14.8:1.2": "āmantā. ",
  "kv14.8:1.3": "vipākābyākataṃ kiriyābyākataṃ rūpaṃ nibbānaṃ cakkhāyatanaṃ …pe… ",
  "kv14.8:1.4": "phoṭṭhabbāyatananti. ",
  "kv14.8:1.5": "na hevaṃ vattabbe …pe… ",
  "kv14.8:1.6": "diṭṭhigataṃ abyākatanti. ",
  "kv14.8:1.7": "āmantā. ",
  "kv14.8:1.8": "diṭṭhigatasampayutto phasso abyākato’ti. ",
  "kv14.8:1.9": "na hevaṃ vattabbe …pe… ",
  "kv14.8:1.10": "diṭṭhigataṃ abyākatanti. ",
  "kv14.8:1.11": "āmantā. ",
  "kv14.8:1.12": "diṭṭhigatasampayuttā vedanā …pe… ",
  "kv14.8:1.13": "saññā …pe… ",
  "kv14.8:1.14": "cetanā …pe… ",
  "kv14.8:1.15": "cittaṃ abyākatanti. ",
  "kv14.8:1.16": "na hevaṃ vattabbe …pe… ",
  "kv14.8:2.1": "diṭṭhigatasampayutto phasso akusalo’ti. ",
  "kv14.8:2.2": "āmantā. ",
  "kv14.8:2.3": "diṭṭhigataṃ akusalanti. ",
  "kv14.8:2.4": "na hevaṃ vattabbe …pe… ",
  "kv14.8:2.5": "diṭṭhigatasampayuttā vedanā …pe… saññā …pe… cetanā …pe… cittaṃ akusalanti. ",
  "kv14.8:2.6": "āmantā. ",
  "kv14.8:2.7": "diṭṭhigataṃ akusalanti. ",
  "kv14.8:2.8": "na hevaṃ vattabbe …pe… ",
  "kv14.8:3.1": "diṭṭhigataṃ abyākatanti. ",
  "kv14.8:3.2": "āmantā. ",
  "kv14.8:3.3": "aphalaṃ avipākanti. ",
  "kv14.8:3.4": "na hevaṃ vattabbe …pe… ",
  "kv14.8:3.5": "nanu saphalaṃ savipākanti. ",
  "kv14.8:3.6": "āmantā. ",
  "kv14.8:3.7": "hañci saphalaṃ savipākaṃ, no ca vata re vattabbe ",
  "kv14.8:3.8": "‘diṭṭhigataṃ abyākata’nti. ",
  "kv14.8:4.1": "diṭṭhigataṃ abyākatanti. ",
  "kv14.8:4.2": "āmantā. ",
  "kv14.8:4.3": "nanu micchādiṭṭhiparamāni vajjāni, vuttāni bhagavatā’ti. ",
  "kv14.8:4.4": "āmantā. ",
  "kv14.8:4.5": "hañci “micchādiṭṭhiparamāni vajjāni, vuttāni bhagavatā, no ca vata re vattabbe ",
  "kv14.8:4.6": "diṭṭhigataṃ abyākatanti. ",
  "kv14.8:5.1": "diṭṭhigataṃ abyākatanti. ",
  "kv14.8:5.2": "āmantā. ",
  "kv14.8:5.3": "nanu vuttaṃ bhagavatā: ",
  "kv14.8:5.4": "“micchādiṭṭhi kho vaccha, akusalaṃ …pe… sammādiṭṭhi kusalanti. ",
  "kv14.8:5.5": "attheva suttanto’ti. ",
  "kv14.8:5.6": "āmantā. ",
  "kv14.8:5.7": "tena hi na vattabbaṃ ",
  "kv14.8:5.8": "“diṭṭhigataṃ abyākata”nti. ",
  "kv14.8:6.1": "diṭṭhigataṃ abyākatanti. ",
  "kv14.8:6.2": "āmantā. ",
  "kv14.8:6.3": "nanu vuttaṃ bhagavatā ",
  "kv14.8:6.4": "“micchādiṭṭhikassa kho ahaṃ puṇṇa dvinnaṃ gatīnaṃ aññataraṃ gatiṃ vadāmi: ",
  "kv14.8:6.5": "nirayaṃ vā tiracchānayoniṃ vā”ti ",
  "kv14.8:6.6": "attheva suttanto’ti. ",
  "kv14.8:6.7": "āmantā. ",
  "kv14.8:6.8": "tena hi na vattabbaṃ: ",
  "kv14.8:6.9": "diṭṭhigataṃ abyākatanti. ",
  "kv14.8:7.1": "na vattabbaṃ ",
  "kv14.8:7.2": "“diṭṭhigataṃ abyākata”nti. ",
  "kv14.8:7.3": "āmantā. ",
  "kv14.8:7.4": "nanu vuttaṃ bhagavatā ",
  "kv14.8:7.5": "“sassato loko’ti kho vaccha, abyākatametaṃ. ",
  "kv14.8:7.6": "asassato loko’ti kho vaccha, abyākatametaṃ. ",
  "kv14.8:7.7": "antavā loko’ti kho vaccha, abyākatametaṃ. ",
  "kv14.8:7.8": "anantavā loko’ti kho vaccha, …pe… ",
  "kv14.8:7.9": "taṃ jīvaṃ taṃ sarīranti kho vaccha …pe… ",
  "kv14.8:7.10": "aññaṃ jīvaṃ aññaṃ sarīranti kho vaccha …pe… ",
  "kv14.8:7.11": "hoti tathāgato parammaraṇā’ti kho vaccha …pe… ",
  "kv14.8:7.12": "na hoti tathāgato parammaraṇā’ti kho vaccha …pe… ",
  "kv14.8:7.13": "hoti ca na ca hoti tathāgato parammaraṇā’ti kho vaccha …pe… ",
  "kv14.8:7.14": "neva hoti na na hoti tathāgato parammaraṇā’ti kho vaccha, abyākatameta”nti ",
  "kv14.8:7.15": "attheva suttanto’ti. ",
  "kv14.8:7.16": "āmantā. ",
  "kv14.8:7.17": "tena hi “diṭṭhigataṃ abyākata”nti. ",
  "kv14.8:8.1": "diṭṭhigataṃ abyākatanti. ",
  "kv14.8:8.2": "āmantā. ",
  "kv14.8:8.3": "nanu vuttaṃ bhagavatā ",
  "kv14.8:8.4": "“micchādiṭṭhikassa bhikkhave purisapuggalassa yañceva kāyakammaṃ yathādiṭṭhi samattaṃ samādinnaṃ, yañca vacīkammaṃ …pe… yañca manokammaṃ …pe… yā ca cetanā, yā ca patthanā, yo ca paṇidhi, ye ca saṅkhārā, sabbe te dhammā aniṭṭhāya akantāya amanāpāya ahitāya dukkhāya saṃvattantī”ti ",
  "kv14.8:8.5": "attheva suttanto’ti. ",
  "kv14.8:8.6": "āmantā. ",
  "kv14.8:8.7": "tena hi na vattabbaṃ ",
  "kv14.8:8.8": "“diṭṭhigataṃ abyākata”nti. ",
  "kv14.8:8.9": "abyākatakathā niṭṭhitā. "
}
