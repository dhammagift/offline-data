  "kv14.9:0.3": "",
  "kv14.9:0.4": "14. 9. apariyāpannakathā. ",
  "kv14.9:1.1": "diṭṭhigataṃ apariyāpanna’nti. ",
  "kv14.9:1.2": "āmantā. ",
  "kv14.9:1.3": "maggo, phalaṃ, nibbānaṃ, sotāpattimaggo, sotāpattiphalaṃ, sakadāgāmimaggo, sakadāgāmiphalaṃ, anāgāmimaggo, anāgāmiphalaṃ, arahattamaggo, arahattaphalaṃ, satipaṭṭhānaṃ, sammappadhānaṃ iddhipādo, indriyaṃ, balaṃ, bojjhaṅgo’ti. ",
  "kv14.9:1.4": "na hevaṃ vattabbe …pe… ",
  "kv14.9:2.1": "na vattabbaṃ ",
  "kv14.9:2.2": "diṭṭhigataṃ apariyāpannanti. ",
  "kv14.9:2.3": "āmantā. ",
  "kv14.9:2.4": "‘puthujjano kāmesu vītarāgo’ti vattabbo’ti. ",
  "kv14.9:2.5": "āmantā. ",
  "kv14.9:2.6": "‘vigatadiṭṭhiyo’ti vattabbo’ti. ",
  "kv14.9:2.7": "na hevaṃ vattabbe …pe… ",
  "kv14.9:2.8": "tena hi diṭṭhigataṃ apariyāpannanti. ",
  "kv14.9:2.9": "apariyāpannakathā niṭṭhitā. ",
  "kv14.9:2.10": "cuddasamo vaggo. ",
  "kv14.9:2.11": "tassuddānaṃ: ",
  "kv14.9:3.1": "akusalamūlaṃ paṭisandahati kusalamūlaṃ ",
  "kv14.9:3.2": "kusalamūlaṃ paṭisandahati akusalamūlaṃ ",
  "kv14.9:3.3": "saḷāyatanaṃ cha viññāṇakāyā ",
  "kv14.9:3.4": "ariyarūpaṃ mahābhūtānupādāya. ",
  "kv14.9:3.5": "svevānusayo taṃ pariyuṭṭhānaṃ ",
  "kv14.9:3.6": "",
  "kv14.9:3.7": "yathādhātu taññevanuseti ",
  "kv14.9:3.8": "diṭṭhigataṃ abyākatamapariyāpannanti. ",
  "kv14.9:3.9": "paṇṇarasamo vaggo. "
}
