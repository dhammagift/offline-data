  "kv14.5:0.1": "",
  "kv14.5:0.2": "",
  "kv14.5:0.3": "",
  "kv14.5:0.4": "14. 5. añño anusayotikathā. ",
  "kv14.5:1.1": "añño kāmarāgānusayo aññaṃ kāmarāgapariyuṭṭhānanti. ",
  "kv14.5:1.2": "āmantā. ",
  "kv14.5:1.3": "añño kāmarāgo aññaṃ kāmarāgapariyuṭṭhānanti. ",
  "kv14.5:1.4": "na hevaṃ vattabbe …pe… ",
  "kv14.5:1.5": "sve’va kāmarāgo taṃ kāmarāgapariyuṭṭhānanti. ",
  "kv14.5:1.6": "āmantā. ",
  "kv14.5:1.7": "sve’va kāmārāgānusayo taṃ kāmarāgapariyuṭṭhānanti. ",
  "kv14.5:1.8": "na hevaṃ vattabbe …pe… ",
  "kv14.5:2.1": "añño paṭighānusayo aññaṃ paṭighapariyuṭṭhānanti. ",
  "kv14.5:2.2": "āmantā. ",
  "kv14.5:2.3": "aññaṃ paṭighaṃ aññaṃ paṭighapariyuṭṭhānanti. ",
  "kv14.5:2.4": "na hevaṃ vattabbe …pe… ",
  "kv14.5:2.5": "taññeva paṭighaṃ taṃ paṭighapariyuṭṭhānanti. ",
  "kv14.5:2.6": "āmantā. ",
  "kv14.5:2.7": "sve’va paṭighānusayo taṃ paṭighapariyuṭṭhānanti. ",
  "kv14.5:2.8": "na hevaṃ vattabbe …pe… ",
  "kv14.5:3.1": "añño mānānusayo aññaṃ mānapariyuṭṭhānanti. ",
  "kv14.5:3.2": "āmantā. ",
  "kv14.5:3.3": "añño māno aññaṃ mānapariyuṭṭhānanti. ",
  "kv14.5:3.4": "na hevaṃ vattabbe …pe… ",
  "kv14.5:3.5": "sve’va māno taṃ mānapariyuṭṭhānanti. ",
  "kv14.5:3.6": "āmantā. ",
  "kv14.5:3.7": "sve’va mānānusayo taṃ mānapariyuṭṭhānanti. ",
  "kv14.5:3.8": "na hevaṃ vattabbe …pe… ",
  "kv14.5:4.1": "añño diṭṭhānusayo aññaṃ diṭṭhipariyuṭṭhānanti. pa. paṭiññā. ",
  "kv14.5:4.2": "āmantā. ",
  "kv14.5:4.3": "aññā diṭṭhi aññaṃ diṭṭhipariyuṭṭhānanti. ",
  "kv14.5:4.4": "na hevaṃ vattabbe …pe… ",
  "kv14.5:4.5": "sā’va diṭṭhi taṃ diṭṭhipariyuṭṭhānanti. ",
  "kv14.5:4.6": "āmantā. ",
  "kv14.5:4.7": "sve’va diṭṭhānusayo taṃ diṭṭhipariyuṭṭhānanti. ",
  "kv14.5:4.8": "na hevaṃ vattabbe …pe… ",
  "kv14.5:5.1": "añño vicikicchānusayo aññaṃ vicikicchāpariyuṭṭhānanti. ",
  "kv14.5:5.2": "āmantā. ",
  "kv14.5:5.3": "aññā vicikicchā aññaṃ vicikicchāpariyuṭṭhanti. ",
  "kv14.5:5.4": "na hevaṃ vattabbe …pe… ",
  "kv14.5:5.5": "sā’va vicikicchā taṃ vicikicchāpariyuṭṭhānanti. ",
  "kv14.5:5.6": "āmantā. ",
  "kv14.5:5.7": "sve’va vicikicchānusayo taṃ vicikicchāpariyuṭṭhānanti. ",
  "kv14.5:5.8": "na hevaṃ vattabbe …pe… ",
  "kv14.5:6.1": "añño bhavarāgānusayo aññaṃ bhavarāgapariyuṭṭhānanti. ",
  "kv14.5:6.2": "āmantā. ",
  "kv14.5:6.3": "añño bhavarāgo aññaṃ bhavarāgapariyuṭṭhānanti. ",
  "kv14.5:6.4": "na hevaṃ vattabbe …pe… ",
  "kv14.5:6.5": "sve’va bhavarāgo taṃ bhavarāgapariyuṭṭhānanti. ",
  "kv14.5:6.6": "āmantā. ",
  "kv14.5:6.7": "sve’va bhavarāgānusayo taṃ bhavarāgapariyuṭṭhānanti. ",
  "kv14.5:6.8": "na hevaṃ vattabbe …pe… ",
  "kv14.5:7.1": "añño avijjānusayo, aññaṃ avijjāpariyuṭṭhānanti. ",
  "kv14.5:7.2": "āmantā. ",
  "kv14.5:7.3": "aññā avijjā, aññaṃ avijjāpariyuṭṭhānanti. ",
  "kv14.5:7.4": "na hevaṃ vattabbe …pe… ",
  "kv14.5:7.5": "sā’va avijjā taṃ avijjāpariyuṭṭhānanti. ",
  "kv14.5:7.6": "āmantā. ",
  "kv14.5:7.7": "sve’va avijjānusayo taṃ avijjāpariyuṭṭhānanti. ",
  "kv14.5:7.8": "na hevaṃ vattabbe …pe… ",
  "kv14.5:8.1": "na vattabbaṃ ",
  "kv14.5:8.2": "añño anusayo aññaṃ pariyuṭṭhānanti. sa. paṭiññā ",
  "kv14.5:8.3": "āmantā. ",
  "kv14.5:8.4": "puthujjano kusalābyākate citte vattamāne sānusayo’ti vattabbo’ti. sa. paṭiññā ",
  "kv14.5:8.5": "āmantā. ",
  "kv14.5:8.6": "pariyuṭṭhito’ti vattabbo’ti. ",
  "kv14.5:8.7": "na hevaṃ vattabbe …pe… ",
  "kv14.5:8.8": "tena hi añño anusayo, aññaṃ pariyuṭṭhānanti. ",
  "kv14.5:8.9": "kusalābyākate citte vattamāne sarāgo’ti vattabbo’ti. ",
  "kv14.5:8.10": "āmantā. ",
  "kv14.5:8.11": "pariyuṭṭhito’ti vattabbo’ti. ",
  "kv14.5:8.12": "na hevaṃ vattabbe …pe… ",
  "kv14.5:8.13": "tena hi añño rāgo, aññaṃ pariyuṭṭhānanti. ",
  "kv14.5:8.14": "añño anusayotikathā niṭṭhitā. "
}
