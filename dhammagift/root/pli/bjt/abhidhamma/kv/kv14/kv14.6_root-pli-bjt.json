  "kv14.6:0.3": "",
  "kv14.6:0.4": "14. 6. pariyuṭṭhānaṃ cittavippayuttantikathā. ",
  "kv14.6:1.1": "pariyuṭṭhānaṃ cittavippayuttanti. ",
  "kv14.6:1.2": "āmantā. ",
  "kv14.6:1.3": "rūpaṃ nibbānaṃ cakkhāyatanaṃ …pe… ",
  "kv14.6:1.4": "phoṭṭhabbāyatananti. ",
  "kv14.6:1.5": "na hevaṃ vattabbe …pe… ",
  "kv14.6:1.6": "pariyuṭṭhānaṃ cittavippayuttanti. ",
  "kv14.6:1.7": "āmantā. ",
  "kv14.6:1.8": "natthi sarāgaṃ cittaṃ, sadosaṃ cittaṃ, samohaṃ cittaṃ …pe… ",
  "kv14.6:1.9": "akusalaṃ cittaṃ, saṃkiliṭṭhaṃ cittanti. ",
  "kv14.6:1.10": "na hevaṃ vattabbe …pe… ",
  "kv14.6:1.11": "nanu atthi sarāgaṃ cittaṃ, sadosaṃ cittaṃ, samohaṃ cittaṃ, …pe… ",
  "kv14.6:1.12": "akusalaṃ cittaṃ saṃkiliṭṭhaṃ cittanti. ",
  "kv14.6:1.13": "āmantā. ",
  "kv14.6:1.14": "hañci atthi sarāgaṃ cittaṃ, sadosaṃ cittaṃ, samohaṃ cittaṃ …pe… ",
  "kv14.6:1.15": "akusalaṃ cittaṃ saṃkiliṭṭhaṃ cittaṃ, no ca vata re vattabbe ",
  "kv14.6:1.16": "‘pariyuṭṭhānaṃ cittavippayutta’nti. ",
  "kv14.6:1.17": "pariyuṭṭhānaṃ cittavippayuttantikathā niṭṭhitā. "
}
