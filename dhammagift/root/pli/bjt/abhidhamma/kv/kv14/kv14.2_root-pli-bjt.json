{
  "kv14.2:0.1": "",
  "kv14.2:0.2": "",
  "kv14.2:0.3": "",
  "kv14.2:0.4": "14. 2. saḷāyatanuppattikathā. ",
  "kv14.2:1.1": "saḷāyatanaṃ apubbaṃ acarimaṃ mātukucchismiṃ saṇṭhātī’ti. ",
  "kv14.2:1.2": "āmantā. ",
  "kv14.2:1.3": "sabbaṅgapaccayā ahīnindriyo mātukucchismiṃ okkamatī’ti. ",
  "kv14.2:1.4": "na hevaṃ vattabbe …pe… ",
  "kv14.2:2.1": "upapattesiyena cittena cakkhāyatanaṃ saṇṭhātī’ti. ",
  "kv14.2:2.2": "āmantā. ",
  "kv14.2:2.3": "upapattesiyena cittena hatthā saṇṭhanti, pādā saṇṭhanti, sīsaṃ saṇṭhāti, kaṇṇo saṇṭhāti, nāsikā saṇṭhāti, mukhaṃ saṇṭhāti, dantā saṇṭhantī’ti. ",
  "kv14.2:2.4": "na hevaṃ vattabbe …pe… ",
  "kv14.2:3.1": "upapattesiyena cittena sotāyatanaṃ …pe… ",
  "kv14.2:3.2": "ghānāyatanaṃ …pe… ",
  "kv14.2:3.3": "jivhāyatanaṃ saṇṭhātī’ti. ",
  "kv14.2:3.4": "āmantā. ",
  "kv14.2:3.5": "upapattesiyena cittena hatthā saṇṭhanti, pādā saṇṭhanti, sīsaṃ saṇṭhāti, kaṇṇo saṇṭhāti, nāsikā saṇṭhāti, mukhaṃ saṇṭhāti, dantā saṇṭhantī’ti. ",
  "kv14.2:3.6": "na hevaṃ vattabbe …pe… ",
  "kv14.2:4.1": "mātukucchigatassa pacchā cakkhāyatanaṃ uppajjatī’ti. ",
  "kv14.2:4.2": "āmantā. ",
  "kv14.2:4.3": "mātukucchismiṃ cakkhupaṭilābhāya kammaṃ karotī’ti. ",
  "kv14.2:4.4": "na hevaṃ vattabbe …pe… ",
  "kv14.2:4.5": "mātukucchigatassa pacchā sotāyatanaṃ …pe… ",
  "kv14.2:4.6": "ghānāyatanaṃ …pe… ",
  "kv14.2:4.7": "jivhāyatanaṃ uppajjatī’ti. ",
  "kv14.2:4.8": "āmantā. ",
  "kv14.2:4.9": "mātukucchismiṃ jivhāyatanapaṭilābhaya kammaṃ karotī’ti. ",
  "kv14.2:4.10": "na hevaṃ vattabbe …pe… ",
  "kv14.2:5.1": "mātukucchigatassa pacchā kesā lomā nakhā dantā aṭṭhi uppajjantī’ti. ",
  "kv14.2:5.2": "āmantā. ",
  "kv14.2:5.3": "mātukucchismiṃ aṭṭhipaṭilābhāya kammaṃ karotī’ti. ",
  "kv14.2:5.4": "na hevaṃ vattabbe …pe… ",
  "kv14.2:6.1": "na vattabbaṃ ",
  "kv14.2:6.2": "mātukucchigatassa paccayā kesā lomā nakhā dantā aṭṭhi uppajjantī’ti. ",
  "kv14.2:6.3": "āmantā. ",
  "kv14.2:6.4": "nanu vuttaṃ bhagavatā. ",
  "kv14.2:7.1": "“paṭhamaṃ kalalaṃ hoti ",
  "kv14.2:7.2": "kalalā hoti abbudaṃ ",
  "kv14.2:7.3": "abbudā jāyate pesī ",
  "kv14.2:7.4": "pesī nibbattatī ghano ",
  "kv14.2:7.5": "ghanā pasākhā jāyanti ",
  "kv14.2:7.6": "kesā lomā nakhā’pi ca. ",
  "kv14.2:8.1": "yañcassa bhuñjate. mātā ",
  "kv14.2:8.2": "annaṃ pānañca bhojanaṃ ",
  "kv14.2:8.3": "tena so tattha yāpeti ",
  "kv14.2:8.4": "mātukucchigato naro’ti” ",
  "kv14.2:9.1": "atthe’va suttanto’ti. ",
  "kv14.2:9.2": "āmantā. ",
  "kv14.2:9.3": "tena hi “mātukucchigatassa pacchā kesā lomā nakhā dantā aṭṭhi uppajjantī”ti. ",
  "kv14.2:9.4": "saḷāyatanuppattikathā niṭṭhitā. "
}
