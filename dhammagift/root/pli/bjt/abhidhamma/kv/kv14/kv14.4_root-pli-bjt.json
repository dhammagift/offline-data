  "kv14.4:0.1": "",
  "kv14.4:0.2": "",
  "kv14.4:0.3": "",
  "kv14.4:0.4": "14. 4. ariyarūpakathā. ",
  "kv14.4:1.1": "ariyarūpaṃ mahābhūtānaṃ upādāyā’ti. ",
  "kv14.4:1.2": "āmantā. ",
  "kv14.4:1.3": "ariyarūpaṃ kusalanti. ",
  "kv14.4:1.4": "āmantā. ",
  "kv14.4:1.5": "mahābhūtā kusalā’ti. ",
  "kv14.4:1.6": "na hevaṃ vattabbe …pe… ",
  "kv14.4:1.7": "mahābhūtā abyākatā’ti. ",
  "kv14.4:1.8": "āmantā. ",
  "kv14.4:1.9": "ariyarūpaṃ abyākatanti. ",
  "kv14.4:1.10": "na hevaṃ vattabbe …pe… ",
  "kv14.4:1.11": "ariyarūpaṃ mahābhūtānaṃ upādāyā’ti. pa. paṭiññā ",
  "kv14.4:1.12": "āmantā. ",
  "kv14.4:1.13": "ariyarūpaṃ anāsavaṃ asaṃyojaniyaṃ aganthanīyaṃ anoghanīyaṃ ayoganīyaṃ anīvaraṇiyaṃ aparāmaṭṭhaṃ anupādāniyaṃ asaṃkilesikanti. ",
  "kv14.4:1.14": "āmantā. ",
  "kv14.4:1.15": "mahābhūtā anāsavā …pe… asaṃkilesikāti. ",
  "kv14.4:1.16": "na hevaṃ vattabbe …pe… ",
  "kv14.4:1.17": "mahābhūtā sāsavā saṃyojaniyā …pe… saṃkilesikā’ti. ",
  "kv14.4:1.18": "āmantā. ",
  "kv14.4:1.19": "ariyarūpaṃ sāsavaṃ saṃyojaniyaṃ …pe… saṃkilesikanti. ",
  "kv14.4:1.20": "na hevaṃ vattabbe …pe… ",
  "kv14.4:2.1": "na vattabbaṃ ",
  "kv14.4:2.2": "‘ariyarūpaṃ mahābhūtānaṃ upādāyā’ti. ",
  "kv14.4:2.3": "āmantā. ",
  "kv14.4:2.4": "nanu vuttaṃ bhagavatā: ",
  "kv14.4:2.5": "“yaṃ kiñci bhikkhave rūpaṃ cattāri mahābhūtāni catunnañca mahābhūtānaṃ upādāya rūpa”nti ",
  "kv14.4:2.6": "attheva suttanto’ti. ",
  "kv14.4:2.7": "āmantā. ",
  "kv14.4:2.8": "tena hi “ariyarūpaṃ mahābhūtānaṃ upādāyā”ti. ",
  "kv14.4:2.9": "ariyarūpakathā niṭṭhitā. "
}
