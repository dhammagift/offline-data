  "kv12.2:0.1": "",
  "kv12.2:0.2": "",
  "kv12.2:0.3": "",
  "kv12.2:0.4": "12. 2. kammakathā. ",
  "kv12.2:1.1": "sabbaṃ kammaṃ savipākanti. ",
  "kv12.2:1.2": "āmantā. ",
  "kv12.2:1.3": "sabbā cetanā savipākā’ti. ",
  "kv12.2:1.4": "na hevaṃ vattabbe …pe… ",
  "kv12.2:1.5": "sabbā cetanā savipākā’ti. ",
  "kv12.2:1.6": "āmantā. ",
  "kv12.2:1.7": "vipākābyākatā cetanā savipākā’ti. ",
  "kv12.2:1.8": "na hevaṃ vattabbe …pe… ",
  "kv12.2:1.9": "sabbā cetanā savipākā’ti. ",
  "kv12.2:1.10": "āmantā. ",
  "kv12.2:1.11": "kiriyābyākatā cetanā savipākā’ti. ",
  "kv12.2:1.12": "na hevaṃ vattabbe …pe… ",
  "kv12.2:2.1": "sabbā cetanā savipākā’ti. ",
  "kv12.2:2.2": "āmantā. ",
  "kv12.2:2.3": "kāmāvacarā vipākābyākatā cetanā savipākā’ti. ",
  "kv12.2:2.4": "na hevaṃ vattabbe …pe… ",
  "kv12.2:2.5": "sabbā cetanā savipākā’ti. ",
  "kv12.2:2.6": "āmantā. ",
  "kv12.2:2.7": "rūpāvacarā arūpāvacarā apariyāpannā vipākābyākatā cetanā savipākā’ti. ",
  "kv12.2:2.8": "na hevaṃ vattabbe …pe… ",
  "kv12.2:3.1": "sabbā cetanā savipākā’ti. ",
  "kv12.2:3.2": "āmantā. ",
  "kv12.2:3.3": "kāmāvacarā kiriyābyākatā cetanā savipākā’ti. ",
  "kv12.2:3.4": "na hevaṃ vattabbe …pe… ",
  "kv12.2:3.5": "sabbā cetanā savipākāti. ",
  "kv12.2:3.6": "āmantā. ",
  "kv12.2:3.7": "rūpāvacarā arūpāvacarā kiriyābyākatā cetanā savipākātī’ti. ",
  "kv12.2:3.8": "na hevaṃ vattabbe. ",
  "kv12.2:4.1": "vipākābyākatā cetanā avipākā’ti. ",
  "kv12.2:4.2": "āmantā. ",
  "kv12.2:4.3": "hañci vipākābyākatā cetanā avipākā. no ca vata re vattabbe ",
  "kv12.2:4.4": "“sabbā cetanā savipākā”ti. ",
  "kv12.2:5.1": "kiriyābyākatā cetanā avipākā’ti. ",
  "kv12.2:5.2": "āmantā. ",
  "kv12.2:5.3": "hañci kiriyābyākatā cetanā avipākā’ti. anu pā: no ca vata re vattabbe ",
  "kv12.2:5.4": "“sabbā cetanā savipākā”ti. sa. anu. ",
  "kv12.2:6.1": "kāmāvacarā rūpāvacarā arūpāvacarā apariyāpannā vipākābyākatā cetanā avipākāti. ",
  "kv12.2:6.2": "āmantā. ",
  "kv12.2:6.3": "hañci apariyāpannā vipākābyākatā cetanā avipākā, anu pā: no ca vata re vattabbe ",
  "kv12.2:6.4": "“sabbā cetanā savipākā”ti. sa. anu. ",
  "kv12.2:7.1": "kāmāvacarā rūpāvacarā arūpāvacarā kiriyābyākatā cetanā avipākāti. ",
  "kv12.2:7.2": "āmantā. ",
  "kv12.2:7.3": "hañci arūpāvacarā kiriyābyākatā cetanā avipākā, no ca vata re vattabbe ",
  "kv12.2:7.4": "“sabbā cetanā savipākā”ti. ",
  "kv12.2:8.1": "na vattabbaṃ ",
  "kv12.2:8.2": "sabbaṃ kammaṃ savipākanti. ",
  "kv12.2:8.3": "āmantā. ",
  "kv12.2:8.4": "nanu vuttaṃ bhagavatā: ",
  "kv12.2:8.5": "“nāhaṃ bhikkhave sañcetanikānaṃ kammānaṃ katānaṃ upacitānaṃ appaṭisaṃviditvā byantībhāvaṃ vadāmi. tañca kho diṭṭhe vā dhamme upapajje vā apare vā pariyāye”ti ",
  "kv12.2:8.6": "atthe’va suttanto’ti. ",
  "kv12.2:8.7": "āmantā. ",
  "kv12.2:8.8": "tena hi “sabbaṃ kammaṃ savipāka”nti. ",
  "kv12.2:8.9": "kammakathā niṭṭhitā. "
}
