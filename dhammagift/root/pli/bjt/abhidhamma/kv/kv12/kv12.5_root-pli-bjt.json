  "kv12.5:0.3": "",
  "kv12.5:0.4": "12. 5. sattakkhattuparamakathā ",
  "kv12.5:1.1": "sa. pu. sattakkhattuparamo puggalo sattakkhattuparamatā niyato’ti. ",
  "kv12.5:1.2": "āmantā. ",
  "kv12.5:1.3": "mātā jīvitā voropitā, ",
  "kv12.5:1.4": "pitā jīvitā voropito, ",
  "kv12.5:1.5": "arahā jīvitā voropito, ",
  "kv12.5:1.6": "duṭṭhena cittena tathāgatassa lohitaṃ uppāditaṃ, ",
  "kv12.5:1.7": "saṅgho bhinno’ti. ",
  "kv12.5:1.8": "na hevaṃ vattabbe …pe… ",
  "kv12.5:2.1": "sattakkhattuparamo puggalo sattakkhattuparamatāniyato’ti. ",
  "kv12.5:2.2": "āmantā. ",
  "kv12.5:2.3": "abhabbo antarā dhammaṃ abhisametunti. ",
  "kv12.5:2.4": "na hevaṃ pattabbe …pe… ",
  "kv12.5:2.5": "abhabbo antarā dhammaṃ abhisametunti. ",
  "kv12.5:2.6": "āmantā. ",
  "kv12.5:2.7": "mātā jīvitā voropitā, ",
  "kv12.5:2.8": "pitā jīvitā voropito, ",
  "kv12.5:2.9": "arahā jīvitā voropito, ",
  "kv12.5:2.10": "duṭṭhena cittena tathāgatassa lohitaṃ uppāditaṃ, ",
  "kv12.5:2.11": "saṅgho bhinno’ti. ",
  "kv12.5:2.12": "na hevaṃ vattabbe …pe… ",
  "kv12.5:3.1": "sattakkhattuparamo puggalo sattakkhattuparamatāniyato’ti. ",
  "kv12.5:3.2": "āmantā. ",
  "kv12.5:3.3": "atthi so niyāmo yena niyāmena sattakkhattuparamo puggalo sattakkhattuparamatāniyato’ti. ",
  "kv12.5:3.4": "na hevaṃ vattabbe …pe… ",
  "kv12.5:3.5": "atthi te satipaṭṭhānā …pe… ",
  "kv12.5:3.6": "sammappadhānā …pe… ",
  "kv12.5:3.7": "iddhipādā …pe… ",
  "kv12.5:3.8": "indriyā …pe… ",
  "kv12.5:3.9": "balā …pe… te ",
  "kv12.5:3.10": "bojjhaṅgā yehi bojjhaṅgehi sattakkhattuparamo puggalo sattakkhattuparamatāniyato’ti. ",
  "kv12.5:3.11": "na hevaṃ vattabbe …pe… ",
  "kv12.5:4.1": "natthi so niyāmo yena niyāmena sattakkhattuparamo puggalo sattakkhattuparamatāniyato’ti. ",
  "kv12.5:4.2": "āmantā. ",
  "kv12.5:4.3": "hañci natthi so niyāmo yena niyāmena sattakkhattuparamo puggalo sattakkhattuparamatā niyato, no ca vata re vattabbe ",
  "kv12.5:4.4": "“sattakkhattuparamo puggalo sattakkhattuparamatāniyato”ti. ",
  "kv12.5:5.1": "natthi te satipaṭṭhānā …pe… te ",
  "kv12.5:5.2": "bojjhaṅgā yehi bojjhaṅgehi sattakkhattuparamo puggalo sattakkhattuparamatāniyato’ti. ",
  "kv12.5:5.3": "āmantā. ",
  "kv12.5:5.4": "hañci natthi te bojjhaṅgā yehi bojjhaṅgehi sattakkhattuparamo puggalo sattakkhattuparamatāniyato, no ca vata re vattabbe ",
  "kv12.5:5.5": "“sattakkhattuparamo puggalo sattakkhattuparamatāniyato”ti. ",
  "kv12.5:6.1": "sattakkhattuparamo puggalo sattakkhattuparamatāniyato’ti. ",
  "kv12.5:6.2": "āmantā. ",
  "kv12.5:6.3": "sakadāgāminiyāmenā’ti. ",
  "kv12.5:6.4": "na hevaṃ vattabbe …pe… ",
  "kv12.5:6.5": "anāgāminiyāmenā’ti. ",
  "kv12.5:6.6": "na hevaṃ vattabbe …pe… ",
  "kv12.5:6.7": "arahattaniyāmenā’ti. ",
  "kv12.5:6.8": "na hevaṃ vattabbe …pe… ",
  "kv12.5:7.1": "katamena niyāmenā’ti. ",
  "kv12.5:7.2": "sotāpattiniyāmenā’ti. ",
  "kv12.5:7.3": "sattakkhattuparamo puggalo sattakkhattuparamatāniyato’ti. ",
  "kv12.5:7.4": "āmantā. ",
  "kv12.5:7.5": "ye keci sotāpattiniyāmaṃ okkamanti sabbe te sattakkhattuparamatāniyato’ti. ",
  "kv12.5:7.6": "na hevaṃ vattabbe …pe… ",
  "kv12.5:8.1": "na vattabbaṃ ",
  "kv12.5:8.2": "“sattakkhattuparamo puggalo sattakkhattuparamatāniyato’ti. ",
  "kv12.5:8.3": "āmantā. ",
  "kv12.5:8.4": "nanu so sattakkhattuparamo’ti. ",
  "kv12.5:8.5": "āmantā. ",
  "kv12.5:8.6": "hañci so sattakkhattuparamo, tena vata re vattabbe ",
  "kv12.5:8.7": "“sattakkhattuparamo puggalo sattakkhattuparamatāniyato”ti. ",
  "kv12.5:8.8": "sattakkhattuparamakathā niṭṭhitā. "
}
