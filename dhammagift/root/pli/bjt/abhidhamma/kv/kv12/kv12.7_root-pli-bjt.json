  "kv12.7:0.4": "12. 7. ekabījīkathā ",
  "kv12.7:1.1": "na vattabbaṃ ",
  "kv12.7:1.2": "“ekabījī puggalo ekabījitāniyato’ti. ",
  "kv12.7:1.3": "āmantā. ",
  "kv12.7:1.4": "nanu so ekabījī’ti. ",
  "kv12.7:1.5": "āmantā. ",
  "kv12.7:1.6": "hañci so ekabījī, tena vata re vattabbe ",
  "kv12.7:1.7": "“ekabījī puggalo ekabījitāniyato’ti. ",
  "kv12.7:1.8": "ekabījikathā niṭṭhitā. "
}
