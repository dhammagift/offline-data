  "kv18.3:0.3": "",
  "kv18.3:0.4": "18. 3. karuṇā kathā. ",
  "kv18.3:1.1": "natthi “buddhassa bhagavato karuṇā”ti. ",
  "kv18.3:1.2": "āmantā. ",
  "kv18.3:1.3": "natthi “buddhassa bhagavato mettā”ti. ",
  "kv18.3:1.4": "na hevaṃ vattabbe …pe… ",
  "kv18.3:1.5": "natthi “buddhassa bhagavato karuṇā”ti. ",
  "kv18.3:1.6": "āmantā. ",
  "kv18.3:1.7": "natthi buddhassa bhagavato muditā …pe… ",
  "kv18.3:1.8": "upekkhā’ti. ",
  "kv18.3:1.9": "na hevaṃ vattabbe …pe… ",
  "kv18.3:2.1": "atthi buddhassa bhagavato mettā’ti. ",
  "kv18.3:2.2": "āmantā. ",
  "kv18.3:2.3": "atthi buddhassa bhagavato karuṇāti. ",
  "kv18.3:2.4": "na hevaṃ vattabbe …pe… ",
  "kv18.3:2.5": "atthi buddhassa bhagavato muditā …pe… ",
  "kv18.3:2.6": "upekkhā’ti. ",
  "kv18.3:2.7": "āmantā. ",
  "kv18.3:2.8": "atthi buddhassa bhagavato karuṇā’ti. ",
  "kv18.3:2.9": "na hevaṃ vattabbe …pe… ",
  "kv18.3:3.1": "natthi buddhassa bhagavato karuṇā’ti. ",
  "kv18.3:3.2": "āmantā. ",
  "kv18.3:3.3": "“bhagavā akāruṇiko’ti. ",
  "kv18.3:3.4": "na hevaṃ vattabbe …pe… ",
  "kv18.3:3.5": "nanu bhagavā kāruṇiko lokahito lokānukampako lokatthacaro’ti. ",
  "kv18.3:3.6": "āmantā. ",
  "kv18.3:3.7": "hañci bhagavā kāruṇiko lokahito lokānukampako lokatthacaro, no ca vata re vattabbe ",
  "kv18.3:3.8": "‘natthi buddhassa bhagavato karuṇā’ti ",
  "kv18.3:4.1": "natthi buddhassa bhagavato karuṇā’ti. ",
  "kv18.3:4.2": "āmantā. ",
  "kv18.3:4.3": "nanu bhagavā mahākaruṇāsamāpattiṃ samāpajjī’ti. ",
  "kv18.3:4.4": "āmantā. ",
  "kv18.3:4.5": "hañci bhagavā mahākaruṇāsamāpattiṃ samāpajji, no ca vata re vattabbe, ",
  "kv18.3:4.6": "‘natthi buddhassa bhagavato karuṇā’ti. ",
  "kv18.3:5.1": "atthi buddhassa bhagavato karuṇā’ti. ",
  "kv18.3:5.2": "āmantā. ",
  "kv18.3:5.3": "bhagavā sarāgo’ti. ",
  "kv18.3:5.4": "na hevaṃ vattabbe …pe… ",
  "kv18.3:5.5": "tena hi ‘natthi buddhassa bhagavato karuṇā’ti. ",
  "kv18.3:5.6": "karuṇākathā niṭṭhitā. "
}
