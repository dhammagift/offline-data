  "kv18.9:0.3": "",
  "kv18.9:0.4": "18. 9. cakkhunā rūpaṃ passatīti kathā. ",
  "kv18.9:1.1": "cakkhunā rūpaṃ passatīti. ",
  "kv18.9:1.2": "āmantā. ",
  "kv18.9:1.3": "rūpena rūpaṃ passatī’ti. ",
  "kv18.9:1.4": "na hevaṃ vattabbe …pe… ",
  "kv18.9:1.5": "rūpena rūpaṃ passatī’ti. ",
  "kv18.9:1.6": "āmantā. ",
  "kv18.9:1.7": "rūpena rūpaṃ paṭivijānātī’ti. ",
  "kv18.9:1.8": "na hevaṃ vattabbe …pe… ",
  "kv18.9:1.9": "rūpena rūpaṃ paṭivijānātī’ti. ",
  "kv18.9:1.10": "āmantā. ",
  "kv18.9:1.11": "rūpaṃ manoviññāṇanti. ",
  "kv18.9:1.12": "na hevaṃ vattabbe …pe… ",
  "kv18.9:1.13": "cakkhunā rūpaṃ passatī’ti. ",
  "kv18.9:1.14": "āmantā. ",
  "kv18.9:1.15": "atthi cakkhussa āvaṭṭanā …pe… paṇidhī’ti. ",
  "kv18.9:1.16": "na hevaṃ vattabbe …pe… ",
  "kv18.9:1.17": "nanu natthi cakkhussa āvaṭṭanā …pe… paṇidhī’ti. ",
  "kv18.9:1.18": "āmantā. ",
  "kv18.9:1.19": "hañci natthi cakkhussa āvaṭṭanā …pe… paṇidhi, no ca vata re vattabbe ",
  "kv18.9:1.20": "“cakkhunā rūpaṃ passatī”ti. ",
  "kv18.9:2.1": "sotena saddaṃ suṇātī’ti …pe… ",
  "kv18.9:2.2": "ghānena gandhaṃ ghāyatī’ti …pe… ",
  "kv18.9:2.3": "jivhāya rasaṃ sāyatī’ti …pe… ",
  "kv18.9:2.4": "kāyena phoṭṭhabbaṃ phusati’ti. ",
  "kv18.9:2.5": "āmantā. ",
  "kv18.9:2.6": "rūpena rūpaṃ phusatī’ti. ",
  "kv18.9:2.7": "na hevaṃ vattabbe …pe… ",
  "kv18.9:3.1": "rūpena rūpaṃ phusatī’ti. ",
  "kv18.9:3.2": "āmantā. ",
  "kv18.9:3.3": "rūpena rūpaṃ paṭivijānātī’ti. ",
  "kv18.9:3.4": "na hevaṃ vattabbe …pe… ",
  "kv18.9:3.5": "rūpena rūpaṃ paṭivijānātī’ti. ",
  "kv18.9:3.6": "āmantā. ",
  "kv18.9:3.7": "rūpaṃ manoviññāṇanti. ",
  "kv18.9:3.8": "na hevaṃ vattabbe …pe… ",
  "kv18.9:3.9": "kāyena phoṭṭhabbaṃ phusati’ti. pa. paṭiññā ",
  "kv18.9:3.10": "āmantā. ",
  "kv18.9:3.11": "atthi kāyassa āvaṭṭanā …pe… paṇidhī’ti. ",
  "kv18.9:3.12": "na hevaṃ vattabbe …pe… ",
  "kv18.9:3.13": "nanu natthi kāyassa āvaṭṭanā …pe… paṇidhī’ti. pa. paṭiññā ",
  "kv18.9:3.14": "āmantā. ",
  "kv18.9:3.15": "hañci natthi kāyassa āvaṭṭanā …pe… paṇidhi, no ca vata re vattabbe ",
  "kv18.9:3.16": "“kāyena phoṭṭhabbaṃ phusati”ti. ",
  "kv18.9:4.1": "na vattabbaṃ ",
  "kv18.9:4.2": "‘cakkhunā rūpaṃ passati …pe… ",
  "kv18.9:4.3": "kāyena phoṭṭhabbaṃ phusati’ti. ",
  "kv18.9:4.4": "āmantā. ",
  "kv18.9:4.5": "nanu vuttaṃ bhagavatā ",
  "kv18.9:4.6": "“idha bhikkhave bhikkhu cakkhunā rūpaṃ passati …pe… ",
  "kv18.9:4.7": "kāyena phoṭṭhabbaṃ phusatī’ti ",
  "kv18.9:4.8": "atthe’va suttanto’ti. ",
  "kv18.9:4.9": "āmantā. ",
  "kv18.9:4.10": "tena hi ‘cakkhunā rūpaṃ passati …pe… ",
  "kv18.9:4.11": "kāyena phoṭṭhabbaṃ phusatī’ti. ",
  "kv18.9:4.12": "cakkhunā rūpaṃ passatī’ti kathā niṭṭhitā. ",
  "kv18.9:4.13": "aṭṭhārasamo vaggo ",
  "kv18.9:4.14": "niṭṭhito. tassa uddānaṃ. ",
  "kv18.9:5.1": "buddho bhagavā manussaloke aṭṭhāsi, ",
  "kv18.9:5.2": "buddhena bhagavatā dhammo desito, ",
  "kv18.9:5.3": "natthi buddhassa bhagavato karuṇā, ",
  "kv18.9:5.4": "buddhassa bhagavato uccārapassāvo ativiya aññe gandhajāte adhigaṇhāti, ",
  "kv18.9:5.5": "ekena ariyamaggena cattāri sāmaññaphalāni sacchikaroti, ",
  "kv18.9:5.6": "jhānā jhānaṃ saṅkamati, ",
  "kv18.9:5.7": "atthi jhānantarikā, ",
  "kv18.9:5.8": "samāpanno saddaṃ suṇāti, ",
  "kv18.9:5.9": "cakkhunā rūpaṃ passati …pe… ",
  "kv18.9:5.10": "kāyena phoṭṭhabbaṃ phusati. ekūnavīsatimo vaggo. "
}
