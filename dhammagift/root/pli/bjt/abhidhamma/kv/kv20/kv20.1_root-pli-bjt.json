  "kv20.1:0.4": "20. 1. asañciccakathā. ",
  "kv20.1:1.1": "“asañcicca mātaraṃ jīvitā voropetvā ānantariko hotī”ti. ",
  "kv20.1:1.2": "āmantā. ",
  "kv20.1:1.3": "asañcicca pāṇaṃ hantvā pāṇātipātī hotī’ti. ",
  "kv20.1:1.4": "na hevaṃ vattabbe …pe… ",
  "kv20.1:1.5": "asañcicca mātaraṃ jīvitā voropetvā ānantariko hotī’ti. ",
  "kv20.1:1.6": "āmantā. ",
  "kv20.1:1.7": "asañcicca adinnaṃ ādiyitvā …pe… ",
  "kv20.1:1.8": "musābhaṇitvā musāvādī hotī’ti. ",
  "kv20.1:1.9": "na hevaṃ vattabbe …pe… ",
  "kv20.1:2.1": "asañcicca pānaṃ hantvā pāṇātipātī na hotī’ti. ",
  "kv20.1:2.2": "āmantā. ",
  "kv20.1:2.3": "asañcicca mātaraṃ jīvitā voropetvā ānantariko na hotī’ti. ",
  "kv20.1:2.4": "na hevaṃ vattabbe …pe… ",
  "kv20.1:2.5": "asañcicca adinnaṃ ādiyitvā …pe… ",
  "kv20.1:2.6": "musā bhaṇitvā musāvādī na hotī’ti. ",
  "kv20.1:2.7": "āmantā. ",
  "kv20.1:2.8": "sañcicca mātaraṃ jīvitā voropetvā ānantariko na hotī’ti. ",
  "kv20.1:2.9": "na hevaṃ vattabbe …pe… ",
  "kv20.1:3.1": "asañcicca mātaraṃ jīvitā voropetvā ānantariko hotī’ti. ",
  "kv20.1:3.2": "āmantā. ",
  "kv20.1:3.3": "“asañcicca mātaraṃ jīvitaṃ voropetvā ānantariko hotī”ti ",
  "kv20.1:3.4": "atthe’va suttanto’ti. ",
  "kv20.1:3.5": "natthi. ",
  "kv20.1:3.6": "“sañcicca mātaraṃ jīvitaṃ voropetvā ānantariko hotī”ti ",
  "kv20.1:3.7": "atthe’va suttanto’ti. ",
  "kv20.1:3.8": "āmantā. ",
  "kv20.1:3.9": "hañci “sañcicca mātaraṃ jīvitā voropetvā ānantariko hotī”ti ",
  "kv20.1:3.10": "atthe’va suttanto. no ca vata re vattabbe ",
  "kv20.1:3.11": "“asañcicca mātaraṃ jīvitaṃ voropetvā ānantariko hotī”ti. ",
  "kv20.1:4.1": "na vattabbaṃ ",
  "kv20.1:4.2": "“mātughātako ānantariko”ti. ",
  "kv20.1:4.3": "āmantā. ",
  "kv20.1:4.4": "nanu mātā jīvitā voropitā’ti. ",
  "kv20.1:4.5": "āmantā. ",
  "kv20.1:4.6": "hañci mātā jīvitā voropitā, tena vata re vattabbe ",
  "kv20.1:4.7": "“mātughātako ānantariko”ti. ",
  "kv20.1:5.1": "na vattabbaṃ ",
  "kv20.1:5.2": "“pitughātako ānantariko”ti. ",
  "kv20.1:5.3": "āmantā. ",
  "kv20.1:5.4": "nanu pitā jīvitā voropito’ti. ",
  "kv20.1:5.5": "āmantā. ",
  "kv20.1:5.6": "hañci pitā jīvitā voropito, tena vata re vattabbe ",
  "kv20.1:5.7": "“pitughātako ānantariko”ti. ",
  "kv20.1:6.1": "na vattabbaṃ ",
  "kv20.1:6.2": "“arahantaghātako ānantariko”ti. ",
  "kv20.1:6.3": "āmantā. ",
  "kv20.1:6.4": "nanu arahā jīvitā voropito’ti. ",
  "kv20.1:6.5": "āmantā. ",
  "kv20.1:6.6": "hañci arahā jīvitā voropito, tena vata re vattabbe ",
  "kv20.1:6.7": "“arahantaghātako ānantariko”ti. ",
  "kv20.1:7.1": "na vattabbaṃ ",
  "kv20.1:7.2": "“lohituppādako. ānantariko”ti. ",
  "kv20.1:7.3": "āmantā. ",
  "kv20.1:7.4": "nanutathāgatassa lohitaṃ uppāditanti. ",
  "kv20.1:7.5": "āmantā. ",
  "kv20.1:7.6": "hañci tathāgatassa lohitaṃ uppāditaṃ, tena vata re vattabbe ",
  "kv20.1:7.7": "“lohituppādako ānantariko”ti. ",
  "kv20.1:8.1": "“saṅghabhedako ānantariko”ti. ",
  "kv20.1:8.2": "āmantā. ",
  "kv20.1:8.3": "“sabbe saṅghabhedakā ānantarikā”ti. ",
  "kv20.1:8.4": "na hevaṃ vattabbe …pe… ",
  "kv20.1:8.5": "sabbe saṅghabhedakā ānantarikā’ti. ",
  "kv20.1:8.6": "āmantā. ",
  "kv20.1:8.7": "dhammasaññī saṅghabhedako ānantariko’ti. ",
  "kv20.1:8.8": "na hevaṃ vattabbe …pe… ",
  "kv20.1:9.1": "dhammasaññī saṅghabhedako ānantariko’ti. ",
  "kv20.1:9.2": "āmantā. ",
  "kv20.1:9.3": "nanu vuttaṃ bhagavatā ",
  "kv20.1:9.4": "“atthupāli saṅghabhedako āpāyiko nerayiko kappaṭṭho atekiccho, ",
  "kv20.1:9.5": "atthupāli saṅghabhedako na apāyiko na nerayiko na kappaṭṭho na atekiccho”ti. ",
  "kv20.1:9.6": "atthe’va suttanto’ti. ",
  "kv20.1:9.7": "āmantā. ",
  "kv20.1:9.8": "tena hi na vattabbaṃ ",
  "kv20.1:9.9": "“dhammasaññī saṅghabhedako ānantariko”ti. ",
  "kv20.1:10.1": "na vattabbaṃ ",
  "kv20.1:10.2": "“dhammasaññī saṅghabhedako ānantariko”ti. ",
  "kv20.1:10.3": "āmantā. ",
  "kv20.1:10.4": "nanu vuttaṃ bhagavatā: ",
  "kv20.1:11.1": "“āpāyiko nerayiko ",
  "kv20.1:11.2": "kappaṭṭho saṅghabhedako ",
  "kv20.1:11.3": "vaggarato adhammaṭṭho ",
  "kv20.1:11.4": "yogakkhemā padhaṃsati ",
  "kv20.1:11.5": "saṅghaṃ samaggaṃ bhetvāna ",
  "kv20.1:11.6": "kappaṃ nirayamhi paccatī”ti ",
  "kv20.1:12.1": "atthe’va suttanto’ti. ",
  "kv20.1:12.2": "āmantā. ",
  "kv20.1:12.3": "tena hi “saṅghabhedako ānantariko”ti. ",
  "kv20.1:12.4": "asañcicca kathā niṭṭhitā. "
}
