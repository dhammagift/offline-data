  "kv20.2:0.3": "",
  "kv20.2:0.4": "20. 2. ñāṇa kathā. ",
  "kv20.2:1.1": "natthi puthujjanassa ñāṇanti. ",
  "kv20.2:1.2": "āmantā. ",
  "kv20.2:1.3": "natthi puthujjanassa paññā pajānanā vicayo pavicayo dhammavicayo sallakkhaṇā upalakkhaṇā paccupalakkhaṇā’ti. ",
  "kv20.2:1.4": "na hevaṃ vattabbe …pe… ",
  "kv20.2:1.5": "nanu atthi puthujjanassa paññā pajānanā vicayo …pe… ",
  "kv20.2:1.6": "paccupalakkhaṇā’ti. ",
  "kv20.2:1.7": "āmantā. ",
  "kv20.2:1.8": "hañci atthi puthujjanassa paññā pajānanā vicayo …pe… ",
  "kv20.2:1.9": "paccupalakkhaṇā. no ca vata re vattabbe ",
  "kv20.2:1.10": "“natthi puthujjanassa ñāṇa”nti. ",
  "kv20.2:2.1": "natthi puthujjanassa ñāṇanti. ",
  "kv20.2:2.2": "āmantā. ",
  "kv20.2:2.3": "puthujjano paṭhamaṃ jhānaṃ samāpajjeyyāti. ",
  "kv20.2:2.4": "āmantā. ",
  "kv20.2:2.5": "hañci puthujjano paṭhamaṃ jhānaṃ samāpajjeyya, no ca vata re vattabbe ",
  "kv20.2:2.6": "“natthi puthujjanassa ñāṇa”nti. ",
  "kv20.2:3.1": "puthujjano dutiyaṃ jhānaṃ …pe… ",
  "kv20.2:3.2": "tatiyaṃ jhānaṃ …pe… ",
  "kv20.2:3.3": "catutthaṃ jhānaṃ …pe… ",
  "kv20.2:3.4": "ākāsānañcāyatanaṃ samāpajjeyya, ",
  "kv20.2:3.5": "viññāṇañcāyatanaṃ …pe… ākiñcaññāyatanaṃ …pe… nevasaññānāsaññāyatanaṃ samāpajjeyya, ",
  "kv20.2:3.6": "puthujjano dānaṃ dadeyya …pe… ",
  "kv20.2:3.7": "cīvaraṃ dadeyya …pe… ",
  "kv20.2:3.8": "piṇḍapātaṃ dadeyya …pe… ",
  "kv20.2:3.9": "senāsanaṃ dadeyya …pe… ",
  "kv20.2:3.10": "gilānapaccayabhesajjaparikkhāraṃ dadeyyā’ti. ",
  "kv20.2:3.11": "āmantā. ",
  "kv20.2:3.12": "hañci puthujjano gilānapaccayabhesajjaparikkhāraṃ dadeyya, no ca vata re vattabbe ",
  "kv20.2:3.13": "“natthi puthujjanassa ñāṇa”nti. ",
  "kv20.2:4.1": "atthi puthujjanassa ñāṇanti. ",
  "kv20.2:4.2": "āmantā. ",
  "kv20.2:4.3": "puthujjano tena ñāṇena dukkhaṃ parijānāti, samudayaṃ pajahati, nirodhaṃ sacchikaroti, maggaṃ bhāvetī’ti. ",
  "kv20.2:4.4": "na hevaṃ vattabbe …pe… ",
  "kv20.2:4.5": "ñāṇa kathā niṭṭhitā. "
}
