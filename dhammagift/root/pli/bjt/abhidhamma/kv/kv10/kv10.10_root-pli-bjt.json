  "kv10.10:0.3": "",
  "kv10.10:0.4": "10. 10. viññatti sīlanti kathā. ",
  "kv10.10:1.1": "viññatti sīlanti. ",
  "kv10.10:1.2": "āmantā. ",
  "kv10.10:1.3": "pāṇātipātā veramaṇī’ti. ",
  "kv10.10:1.4": "na hevaṃ vattabbe …pe… ",
  "kv10.10:1.5": "adinnādānā veramaṇī’ti. ",
  "kv10.10:1.6": "na hevaṃ vattabbe …pe… ",
  "kv10.10:1.7": "kāmesu micchācārā veramaṇī’ti. ",
  "kv10.10:1.8": "na hevaṃ vattabbe …pe… ",
  "kv10.10:1.9": "musāvādā veramaṇī’ti. ",
  "kv10.10:1.10": "na hevaṃ vattabbe …pe… ",
  "kv10.10:1.11": "surāmerayamajjapamādaṭṭhānā veramaṇī’ti. ",
  "kv10.10:1.12": "na hevaṃ vattabbe …pe… sa. pu ",
  "kv10.10:2.1": "abhivādanaṃ sīlaṃ, paccuṭṭhānaṃ sīlaṃ, añjalikammaṃ sīlaṃ, sāmīcikammaṃ sīlaṃ, āsanābhihāro sīlaṃ, seyyābhihāro sīlaṃ, pādodakābhihāro sīlaṃ, pādakaṭhalikābhihāro sīlaṃ, nahāne piṭṭhikammaṃ sīlanti. ",
  "kv10.10:2.2": "āmantā. ",
  "kv10.10:2.3": "pāṇātipātā veramaṇī’ti. ",
  "kv10.10:2.4": "na hevaṃ vattabbe …pe… ",
  "kv10.10:2.5": "surāmerayamajjapamādaṭṭhānā veramaṇī’ti. ",
  "kv10.10:2.6": "na hevaṃ vattabbe …pe… ",
  "kv10.10:3.1": "na vattabbaṃ: ",
  "kv10.10:3.2": "viññatti sīlanti. ",
  "kv10.10:3.3": "āmantā. ",
  "kv10.10:3.4": "dussīlanti. ",
  "kv10.10:3.5": "na hevaṃ vattabbe …pe… ",
  "kv10.10:3.6": "tena hi viññatti sīlanti. ",
  "kv10.10:3.7": "viññatti sīlantikathā niṭṭhitā. "
}
