  "kv8.5:0.3": "",
  "kv8.5:0.4": "8. 5. rūpadhātukathā ",
  "kv8.5:1.1": "rūpino dhammā rūpadhātū’ti. ",
  "kv8.5:1.2": "āmantā. ",
  "kv8.5:1.3": "rūpaṃ bhavo gati sattāvāso saṃsāro yoni viññāṇaṭṭhiti attabhāvapaṭilābho’ti. ",
  "kv8.5:1.4": "na hevaṃ vattabbe …pe… ",
  "kv8.5:1.5": "atthī rūpūpagaṃ kammanti. ",
  "kv8.5:1.6": "na hevaṃ vattabbe …pe… ",
  "kv8.5:1.7": "atthī rūpūpagā sattā’ti. ",
  "kv8.5:1.8": "na hevaṃ vattabbe …pe… ",
  "kv8.5:1.9": "rūpe sattā jāyanti, jīyanti, mīyanti, cavanti, uppajjantī’ti. ",
  "kv8.5:1.10": "na hevaṃ vattabbe …pe… ",
  "kv8.5:1.11": "rūpe atthī rūpaṃ vedanā saññā saṅkhārā viññāṇanti. ",
  "kv8.5:1.12": "na hevaṃ vattabbe …pe… ",
  "kv8.5:1.13": "rūpaṃ pañcavokārabhavo’ti. ",
  "kv8.5:1.14": "na hevaṃ vattabbe …pe… ",
  "kv8.5:2.1": "rūpadhātu bhavo gati …pe… ",
  "kv8.5:2.2": "attabhāvapaṭilābho’ti. ",
  "kv8.5:2.3": "āmantā. ",
  "kv8.5:2.4": "rūpaṃ bhavo gati …pe… ",
  "kv8.5:2.5": "attabhāvapaṭilābho’ti. ",
  "kv8.5:2.6": "na hevaṃ vattabbe …pe… ",
  "kv8.5:2.7": "atthī rūpadhātūpagaṃ kammanti. ",
  "kv8.5:2.8": "āmantā. ",
  "kv8.5:2.9": "atthī rūpūpagaṃ kammanti. ",
  "kv8.5:2.10": "na hevaṃ vattabbe …pe… ",
  "kv8.5:2.11": "atthī rūpadhātūpagā sattā’ti. ",
  "kv8.5:2.12": "āmantā. ",
  "kv8.5:2.13": "atthī rūpūpagā sattā’ti. ",
  "kv8.5:2.14": "na hevaṃ vattabbe …pe… ",
  "kv8.5:3.1": "rūpadhātuyā sattā jāyanti jīyanti mīyanti cavanti uppajjantī’ti. ",
  "kv8.5:3.2": "āmantā. ",
  "kv8.5:3.3": "rūpe sattā jāyanti jīyanti mīyanti cavanti uppajjantī’ti? ",
  "kv8.5:3.4": "na hevaṃ vattabbe …pe… ",
  "kv8.5:3.5": "rūpe atthī rūpaṃ vedanā saññā saṅkhārā viññāṇanti. ",
  "kv8.5:3.6": "āmantā. ",
  "kv8.5:3.7": "rūpe atthī rūpaṃ1 vedanā saññā saṅkhārā viññāṇanti? ",
  "kv8.5:3.8": "na hevaṃ vattabbe …pe… ",
  "kv8.5:3.9": "rūpadhātu pañcavokārabhavo’ti. ",
  "kv8.5:3.10": "āmantā. ",
  "kv8.5:3.11": "rūpaṃ pañcavokārabhavo’ti. ",
  "kv8.5:3.12": "na hevaṃ vattabbe …pe… ",
  "kv8.5:4.1": "rūpino dhammā rūpadhātu, kāmadhātuyā atthī rūpanti. ",
  "kv8.5:4.2": "āmantā. ",
  "kv8.5:4.3": "sā’va kāmadhātu. sā rūpadhātū’ti. ",
  "kv8.5:4.4": "na hevaṃ vattabbe …pe… ",
  "kv8.5:4.5": "sā’va kāmadhātu rūpadhātū’ti. ",
  "kv8.5:4.6": "āmantā. ",
  "kv8.5:4.7": "kāmabhavena samannāgato puggalo dvīhi bhavehi samannāgato hoti, ",
  "kv8.5:4.8": "kāmabhavena rūpabhavena cā’ti. ",
  "kv8.5:4.9": "na hevaṃ vattabbe …pe… ",
  "kv8.5:4.10": "rūpadhātukathā niṭṭhitā. "
}
