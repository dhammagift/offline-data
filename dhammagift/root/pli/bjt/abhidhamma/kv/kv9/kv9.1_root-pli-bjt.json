  "kv9.1:0.4": "9. 1. ānisaṃsakathā. ",
  "kv9.1:1.1": "ānisaṃsadassāvissa saññojanānaṃ pahānanti. ",
  "kv9.1:1.2": "āmantā. ",
  "kv9.1:1.3": "nanu saṅkhāre aniccato manasikaroto saññojanā pahīyantīti. ",
  "kv9.1:1.4": "āmantā. ",
  "kv9.1:1.5": "hañci saṅkhāre aniccato manasikaroto saññojanā pahīyanti, no ca vata re vattabbe: ",
  "kv9.1:1.6": "ānisaṃsadassāvissa saññojanānaṃ pahānanti. ",
  "kv9.1:2.1": "nanu saṅkhāre dukkhato …pe… ",
  "kv9.1:2.2": "rogato …pe… ",
  "kv9.1:2.3": "gaṇḍato …pe… ",
  "kv9.1:2.4": "sallato …pe… ",
  "kv9.1:2.5": "aghato …pe… ",
  "kv9.1:2.6": "ābādhato …pe… ",
  "kv9.1:2.7": "parato …pe… ",
  "kv9.1:2.8": "palokato …pe… ",
  "kv9.1:2.9": "ītito …pe… ",
  "kv9.1:2.10": "upaddavato …pe… ",
  "kv9.1:2.11": "bhayato …pe… ",
  "kv9.1:2.12": "upasaggato …pe… ",
  "kv9.1:2.13": "calato …pe… ",
  "kv9.1:2.14": "pabhaṅguto …pe… ",
  "kv9.1:2.15": "addhuvato …pe… ",
  "kv9.1:2.16": "atāṇato …pe… ",
  "kv9.1:2.17": "aleṇato …pe… ",
  "kv9.1:2.18": "asaraṇato …pe… ",
  "kv9.1:2.19": "asaraṇībhūtato …pe… ",
  "kv9.1:2.20": "rittato …pe… ",
  "kv9.1:2.21": "tucchato …pe… ",
  "kv9.1:2.22": "suññato …pe… ",
  "kv9.1:2.23": "anattato …pe… ",
  "kv9.1:2.24": "ādīnavato …pe… ",
  "kv9.1:2.25": "vipariṇāmadhammato manasikaroto saññojanā pahīyantīti. ",
  "kv9.1:2.26": "āmantā. ",
  "kv9.1:2.27": "hañci saṅkhāre vipariṇāmadhammato manasikaroto saññojanā pahīyanti. no ca vata re vattabbe: ",
  "kv9.1:2.28": "ānisaṃsadassāvissa saññojanānaṃ pahānanti. ",
  "kv9.1:3.1": "saṅkhāre ca aniccato ",
  "kv9.1:3.2": "",
  "kv9.1:3.3": "manasikaroti, nibbāne ca ānisaṃsadassāvī hotīti. ",
  "kv9.1:3.4": "āmantā. ",
  "kv9.1:3.5": "dvinnaṃ phassānaṃ …pe… ",
  "kv9.1:3.6": "dvinnaṃ cittānaṃ samodhānaṃ hotī’ti. ",
  "kv9.1:3.7": "na hevaṃ vattabbe …pe… ",
  "kv9.1:3.8": "saṅkhāre ca dukkhato …pe… rogato …pe… ",
  "kv9.1:3.9": "vipariṇāmadhammato manasikarotī, nibbāne ca ānisaṃsadassāvī hotī’ti. ",
  "kv9.1:3.10": "na hevaṃ vattabbe …pe… ",
  "kv9.1:3.11": "saṅkhāre ca vipariṇāmadhammato manasikaroti, nibbāne ca ānisaṃsadassāvī hotī’ti. ",
  "kv9.1:3.12": "āmantā. ",
  "kv9.1:3.13": "dvinnaṃ phassānaṃ …pe… ",
  "kv9.1:3.14": "dvinnaṃ cittānaṃ samodhānaṃ hotī’ti. ",
  "kv9.1:3.15": "na hevaṃ vattabbe …pe… ",
  "kv9.1:4.1": "na vattabbaṃ: ",
  "kv9.1:4.2": "ānisaṃsadassāvissa saññojanānaṃ pahānanti. ",
  "kv9.1:4.3": "āmantā. ",
  "kv9.1:4.4": "nanu vuttaṃ bhagavatā: ",
  "kv9.1:4.5": "“idha bhikkhave, bhikkhu nibbāne sukhānupassī viharati sukhasaññī sukhapaṭisaṃvedī sattaṃ samitaṃ abbokiṇṇaṃ cetasā adhimuccamāno paññāya pariyogāhamāno”ti ",
  "kv9.1:4.6": "attheva suttantoti. ",
  "kv9.1:4.7": "āmantā. ",
  "kv9.1:4.8": "tena hi ānisaṃsadassāvissa saññojanānaṃ pahānanti. ",
  "kv9.1:4.9": "ānisaṃsakathā niṭṭhitā. "
}
