  "kv9.4:0.1": "",
  "kv9.4:0.2": "",
  "kv9.4:0.3": "",
  "kv9.4:0.4": "9. 4. anusayā anārammaṇā’ti kathā. ",
  "kv9.4:1.1": "anusayā anārammaṇā’ti. ",
  "kv9.4:1.2": "āmantā. ",
  "kv9.4:1.3": "rūpaṃ nibbānaṃ cakkhāyatanaṃ …pe… ",
  "kv9.4:1.4": "phoṭṭhabbāyatananti. ",
  "kv9.4:1.5": "na hevaṃ vattabbe …pe… ",
  "kv9.4:2.1": "kāmarāgānusayo anārammaṇo’ti. ",
  "kv9.4:2.2": "āmantā. ",
  "kv9.4:2.3": "kāmarāgo kāmarāgapariyuṭṭhānaṃ kāmarāgasaññojanaṃ kāmogho kāmayogo kāmacchandanīvaraṇaṃ anārammaṇanti. ",
  "kv9.4:2.4": "na hevaṃ vattabbe …pe… ",
  "kv9.4:2.5": "kāmarāgo kāmarāgapariyuṭṭhānaṃ kāmarāga saññojanaṃ kāmogho kāmayogo kāmacchandanīvaraṇaṃ sārammaṇanti. ",
  "kv9.4:2.6": "āmantā. ",
  "kv9.4:2.7": "kāmārāgānusayo sārammaṇoti. ",
  "kv9.4:2.8": "na hevaṃ vattabbe …pe… ",
  "kv9.4:3.1": "kāmarāgānusayo anārammaṇo’ti. ",
  "kv9.4:3.2": "āmantā. ",
  "kv9.4:3.3": "katamakkhandhapariyāpanno’ti. ",
  "kv9.4:3.4": "saṅkhārakkhandhapariyāpanno’ti. ",
  "kv9.4:3.5": "saṅkhārakkhandho anārammaṇo’ti. ",
  "kv9.4:3.6": "na hevaṃ vattabbe …pe… ",
  "kv9.4:3.7": "saṅkhārakkhandho anārammaṇo’ti. ",
  "kv9.4:3.8": "āmantā. ",
  "kv9.4:3.9": "vedanākkhandho saññākkhandho viññāṇakkhandho anārammaṇo’ti. ",
  "kv9.4:3.10": "na hevaṃ vattabbe …pe… ",
  "kv9.4:4.1": "kāmarāgānusayo saṅkhārakkhandhapariyāpanno anārammaṇo’ti ",
  "kv9.4:4.2": "āmantā. ",
  "kv9.4:4.3": "kāmarāgo saṅkhārakkhandhapariyāpanno anārammaṇo’ti. ",
  "kv9.4:4.4": "na hevaṃ vattabbe …pe… ",
  "kv9.4:4.5": "kāmarāgo saṅkhārakkhandhapariyāpanno sārammaṇo’ti. ",
  "kv9.4:4.6": "āmantā. ",
  "kv9.4:4.7": "kāmarāgānusayo saṅkhārakkhandhapariyāpanno sārammaṇo’ti. ",
  "kv9.4:4.8": "na hevaṃ vattabbe …pe… ",
  "kv9.4:5.1": "kāmarāgānusayo saṅkhārakkhandhapariyāpanno anārammaṇo, kāmarāgo saṅkhārakkhandhapariyāpanno sārammaṇo’ti. ",
  "kv9.4:5.2": "āmantā. ",
  "kv9.4:5.3": "saṅkhārakkhandho ekadeso sārammaṇo, ekadeso anārammaṇo’ti. ",
  "kv9.4:5.4": "na hevaṃ vattabbe …pe… ",
  "kv9.4:5.5": "saṅkhārakkhandho ekadeso sārammaṇo, ekadeso anārammaṇo’ti. ",
  "kv9.4:5.6": "āmantā. ",
  "kv9.4:5.7": "vedanākkhandho …pe… saññākkhandho …pe… viññāṇakkhandho ekadeso sārammaṇo, ekadeso anārammaṇo’ti. ",
  "kv9.4:5.8": "na hevaṃ vattabbe …pe… ",
  "kv9.4:6.1": "paṭighānusayo mānānusayo diṭṭhānusayo vicikicchānusayo bhavarāgānusayo avijjānusayo anārammaṇo’ti. ",
  "kv9.4:6.2": "āmantā. ",
  "kv9.4:6.3": "avijjā avijjogho avijjāyogo avijjānusayo avijjāpariyuṭṭhānaṃ avijjāsaññojanaṃ avijjānīvaraṇaṃ anārammaṇanti. ",
  "kv9.4:6.4": "na hevaṃ vattabbe …pe… ",
  "kv9.4:6.5": "avijjā avijjogho …pe… ",
  "kv9.4:6.6": "avijjānīvaraṇaṃ sārammaṇanti. ",
  "kv9.4:6.7": "āmantā. ",
  "kv9.4:6.8": "avijjānusayo sārammaṇo’ti. ",
  "kv9.4:6.9": "na hevaṃ vattabbe …pe… ",
  "kv9.4:7.1": "avijjānusayo anārammaṇo’ti. ",
  "kv9.4:7.2": "āmantā. ",
  "kv9.4:7.3": "katamakkhandhapariyāpanno’ti. ",
  "kv9.4:7.4": "saṅkhārakkhandhapariyāpanno’ti. saṅkhārakkhandho anārammaṇo’ti. na hevaṃ vattabbe …pe… saṅkhārakkhandho anārammaṇo’ti. āmantā. vedanākkhandho saññākkhandho viññāṇakkhandho anārammaṇo’ti. na hevaṃ vattabbe …pe… avijjānusayo anārammaṇo’ti. āmantā. katamakkhandha pariyāpanno’ti. saṅkhārakkhandhapariyāpanno’ti. ",
  "kv9.4:7.5": "saṅkhārakkhandho anārammaṇo’ti. ",
  "kv9.4:7.6": "na hevaṃ vattabbe …pe… ",
  "kv9.4:7.7": "saṅkhārakkhandho anārammaṇo’ti. ",
  "kv9.4:7.8": "āmantā. ",
  "kv9.4:7.9": "vedanākkhandho saññākkhandho viññāṇakkhandho anārammaṇo’ti. ",
  "kv9.4:7.10": "na hevaṃ vattabbe …pe… ",
  "kv9.4:8.1": "avijjānusayo saṅkhārakkhandhapariyāpanno anārammaṇo’ti. ",
  "kv9.4:8.2": "āmantā. ",
  "kv9.4:8.3": "avijjā saṅkhārakkhandhapariyāpannā anārammaṇāti. ",
  "kv9.4:8.4": "na hevaṃ vattabbe …pe… ",
  "kv9.4:8.5": "avijjā saṅkhārakkhandhapariyāpannā sārammaṇā’ti. ",
  "kv9.4:8.6": "āmantā. ",
  "kv9.4:8.7": "avijjānuso saṅkhārakkhandhapariyāpanno sārammaṇo’ti. ",
  "kv9.4:8.8": "na hevaṃ vattabbe …pe… ",
  "kv9.4:9.1": "avijjānusayo saṅkhārakkhandhapariyāpanno anārammaṇo, avijjā saṅkhārakkhandhapariyāpannā sārammaṇā’ti. ",
  "kv9.4:9.2": "āmantā. ",
  "kv9.4:9.3": "saṅkhārakkhandho ekadeso sārammaṇo ekadeso anārammaṇo’ti. ",
  "kv9.4:9.4": "na hevaṃ vattabbe …pe… ",
  "kv9.4:9.5": "saṅkhārakkhandho ekadeso sārammaṇo, ekadeso anārammaṇo’ti. ",
  "kv9.4:9.6": "āmantā. ",
  "kv9.4:9.7": "vedanākkhandho saññākkhandho viññāṇakkhandho ekadeso sārammaṇo, ekadeso anārammaṇo’ti. ",
  "kv9.4:9.8": "na hevaṃ vattabbe …pe… ",
  "kv9.4:10.1": "na vattabbaṃ ",
  "kv9.4:10.2": "“anusayā anārammaṇā’ti. ",
  "kv9.4:10.3": "āmantā. ",
  "kv9.4:10.4": "puthujjano kusalābyākate citte vattamāne sānusayo’ti vattabbo’ti. ",
  "kv9.4:10.5": "āmantā. ",
  "kv9.4:10.6": "atthī tesaṃ anusayānaṃ ārammaṇanti. ",
  "kv9.4:10.7": "na hevaṃ vattabbe …pe… ",
  "kv9.4:10.8": "tenahi anusayā anārammaṇā’ti. ",
  "kv9.4:10.9": "puthujjano kusalābyākate citte vattamāne sārāgo’ti vattabbo’ti. ",
  "kv9.4:10.10": "āmantā. ",
  "kv9.4:10.11": "atthī tassa rāgassa ārammaṇanti. ",
  "kv9.4:10.12": "na hevaṃ vattabbe …pe… ",
  "kv9.4:10.13": "tenahi rāgo anārammaṇo’ti. ",
  "kv9.4:10.14": "anusayā anārammaṇātikathā niṭṭhitā. "
}
