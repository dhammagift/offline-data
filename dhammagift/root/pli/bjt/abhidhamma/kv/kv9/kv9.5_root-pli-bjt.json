  "kv9.5:0.3": "",
  "kv9.5:0.4": "9. 5. ñāṇaṃ anārammaṇanti kathā. ",
  "kv9.5:1.1": "ñāṇaṃ anārammaṇanti. ",
  "kv9.5:1.2": "āmantā. ",
  "kv9.5:1.3": "rūpaṃ nibbānaṃ cakkhāyatanaṃ …pe… ",
  "kv9.5:1.4": "phoṭṭhabbāyatananti. ",
  "kv9.5:1.5": "na hevaṃ vattabbe …pe… ",
  "kv9.5:1.6": "ñāṇaṃ anārammaṇanti. ",
  "kv9.5:1.7": "āmantā. ",
  "kv9.5:1.8": "paññā paññindriyaṃ paññābalaṃ sammādiṭṭhi dhammavicaya sambojjhaṅgo anārammaṇo’ti. ",
  "kv9.5:1.9": "na hevaṃ vattabbe …pe… sa. pu ",
  "kv9.5:1.10": "paññā paññindriyaṃ paññābalaṃ, sammādiṭṭhi dhammavicaya sambojjhaṅgo sārammaṇo’ti. ",
  "kv9.5:1.11": "āmantā. ",
  "kv9.5:1.12": "ñāṇaṃ sārammaṇanti. ",
  "kv9.5:1.13": "na hevaṃ vattabbe …pe… ",
  "kv9.5:2.1": "ñāṇaṃ anārammaṇanti. ",
  "kv9.5:2.2": "āmantā. ",
  "kv9.5:2.3": "katamakkhandhapariyāpannanti. ",
  "kv9.5:2.4": "saṅkhārakkhandhapariyāpannanti. ",
  "kv9.5:2.5": "saṅkhārakkhadho anārammaṇo’ti. ",
  "kv9.5:2.6": "na hevaṃ vattabbe …pe… ",
  "kv9.5:2.7": "saṅkhārakkhandho anārammaṇo’ti. ",
  "kv9.5:2.8": "āmantā. ",
  "kv9.5:2.9": "vedanākkhandho saññākkhandho viññāṇakkhandho anārammaṇo’ti. ",
  "kv9.5:2.10": "na hevaṃ vattabbe …pe… ",
  "kv9.5:2.11": "ñāṇaṃ saṅkhārakkhandhapariyāpannaṃ anārammaṇanti. ",
  "kv9.5:2.12": "āmantā. ",
  "kv9.5:2.13": "paññā saṅkhārakkhandhapariyāpannā anārammaṇā’ti. ",
  "kv9.5:2.14": "na hevaṃ vattabbe …pe… ",
  "kv9.5:2.15": "paññā saṅkhārakkhandhapariyāpannā sārammaṇā’ti. ",
  "kv9.5:2.16": "āmantā. ",
  "kv9.5:2.17": "ñāṇaṃ saṅkhārakkhandhapariyāpannā sārammaṇanti. ",
  "kv9.5:2.18": "na hevaṃ vattabbe …pe… ",
  "kv9.5:3.1": "ñāṇaṃ saṅkhārakkhandhapariyāpannaṃ anārammaṇaṃ, paññā saṅkhārakkhandhapariyāpannā sārammaṇā’ti. ",
  "kv9.5:3.2": "āmantā. ",
  "kv9.5:3.3": "saṅkhārakkhandho ekadeso sārammaṇo, ekadeso anārammaṇo’ti. ",
  "kv9.5:3.4": "na hevaṃ vattabbe …pe… ",
  "kv9.5:3.5": "saṅkhārakkhandho ekadeso sārammaṇo, ekadeso anārammaṇo’ti. ",
  "kv9.5:3.6": "āmantā. ",
  "kv9.5:3.7": "vedanākkhandho saññākkhandho viññāṇakkhandho ekadeso sārammaṇo, ekadeso anārammaṇo’ti. ",
  "kv9.5:3.8": "na hevaṃ vattabbe …pe… ",
  "kv9.5:4.1": "na vattabbaṃ ",
  "kv9.5:4.2": "ñāṇaṃ anārammaṇanti. ",
  "kv9.5:4.3": "āmantā. ",
  "kv9.5:4.4": "arahā cakkhuviññāṇasamaṅgī ñāṇīti vattabbo’ti. ",
  "kv9.5:4.5": "āmantā. ",
  "kv9.5:4.6": "atthī tassa ñāṇassa ārammaṇanti. ",
  "kv9.5:4.7": "na hevaṃ vattabbe …pe… pa. ā. ",
  "kv9.5:4.8": "tena hi ñāṇaṃ anārammaṇanti. ",
  "kv9.5:4.9": "arahā cakkhuviññāṇasamaṅgī paññavā’ti vattabbo’ti. ",
  "kv9.5:4.10": "āmantā. ",
  "kv9.5:4.11": "atthī tāya paññāya ārammaṇanti. ",
  "kv9.5:4.12": "na hevaṃ vattabbe …pe… ",
  "kv9.5:4.13": "tena hi paññā anārammaṇā’ti. ",
  "kv9.5:4.14": "ñāṇa anārammaṇantikathā niṭṭhitā. "
}
