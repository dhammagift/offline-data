  "kv6.4:0.1": "",
  "kv6.4:0.2": "",
  "kv6.4:0.3": "",
  "kv6.4:0.4": "6. 4. āruppakathā ",
  "kv6.4:1.1": "ākāsānañcāyatanaṃ asaṅkhatanti. ",
  "kv6.4:1.2": "āmantā. ",
  "kv6.4:1.3": "nibbānaṃ tāṇaṃ leṇaṃ saraṇaṃ parāyanaṃ accutaṃ amatanti. ",
  "kv6.4:1.4": "na hevaṃ vattabbe …pe… ",
  "kv6.4:1.5": "ākāsānañcāyatanaṃ asaṅkhatanti. ",
  "kv6.4:1.6": "āmantā. ",
  "kv6.4:1.7": "dve asaṅkhatānī’ti. ",
  "kv6.4:1.8": "na hevaṃ vattabbe …pe… ",
  "kv6.4:1.9": "dve asaṅkhatānī’ti. ",
  "kv6.4:1.10": "āmantā. ",
  "kv6.4:1.11": "dve tāṇāni …pe… ",
  "kv6.4:1.12": "antarikāvā’ti. ",
  "kv6.4:1.13": "na hevaṃ vattabbe …pe… ",
  "kv6.4:2.1": "ākāsānañcāyatanaṃ asaṅkhatanti. ",
  "kv6.4:2.2": "āmantā. ",
  "kv6.4:2.3": "ākāsānañcāyatanaṃ bhavo gati sattāvāso saṃsāro yoni viññāṇaṭṭhiti attabhāvapaṭilābho’ti. ",
  "kv6.4:2.4": "āmantā. ",
  "kv6.4:2.5": "asaṅkhataṃ bhavo gati sattāvāso saṃsāro yoni viññāṇaṭṭhiti attabhāvapaṭilābho’ti. ",
  "kv6.4:2.6": "na hevaṃ vattabbe …pe… ",
  "kv6.4:3.1": "atthī ākāsānañcāyatanūpagaṃ kammanti. ",
  "kv6.4:3.2": "āmantā. ",
  "kv6.4:3.3": "atthī asaṅkhatūpagaṃ kammanti. ",
  "kv6.4:3.4": "na hevaṃ vattabbe …pe… ",
  "kv6.4:3.5": "atthī ākāsānañcāyatanūpagā sattā’ti. ",
  "kv6.4:3.6": "āmantā. ",
  "kv6.4:3.7": "atthi asaṅkhatūpagā sattā’ti. ",
  "kv6.4:3.8": "na hevaṃ vattabbe …pe… ",
  "kv6.4:4.1": "ākāsānañcāyatane sattā jāyanti, jīyanti mīyanti, cavanti, upapajjantī’ti. ",
  "kv6.4:4.2": "āmantā. ",
  "kv6.4:4.3": "asaṅkhate sattā jāyanti, jīyanti, mīyanti, cavanti, uppajjantī’ti. ",
  "kv6.4:4.4": "na hevaṃ vattabbe …pe… ",
  "kv6.4:4.5": "ākāsānañcāyatane atthī vedanā saññā saṃkhārā viññāṇanti. ",
  "kv6.4:4.6": "āmantā. ",
  "kv6.4:4.7": "asaṅkhate atthī vedanā saññā saṅkhārā viññāṇanti. ",
  "kv6.4:4.8": "na hevaṃ vattabbe …pe… ",
  "kv6.4:4.9": "ākāsānañcāyatanaṃ catuvokārabhavo’ti. ",
  "kv6.4:4.10": "āmantā. ",
  "kv6.4:4.11": "asaṅkhataṃ catuvokārabhavo’ti. ",
  "kv6.4:4.12": "na hevaṃ vattabbe …pe… ",
  "kv6.4:5.1": "na vattabbaṃ: ",
  "kv6.4:5.2": "‘cattāro āruppā asaṅkhatā’ti. ",
  "kv6.4:5.3": "āmantā. ",
  "kv6.4:5.4": "nanu cattāro āruppā anejā vuttā bhagavatā’ti. ",
  "kv6.4:5.5": "āmantā. ",
  "kv6.4:5.6": "hañci cattāro āruppā anejā vuttā bhagavatā, tena vata re vattabbe: ",
  "kv6.4:5.7": "‘cattāro āruppā asaṅkhatā’ti. ",
  "kv6.4:5.8": "aruppakathā niṭṭhitā. "
}
