  "kv6.9:0.4": "",
  "kv6.9:1.1": "cakkhundriyaṃ sanidassananti. ",
  "kv6.9:1.2": "āmantā. ",
  "kv6.9:1.3": "rūpaṃ rūpāyatanaṃ rūpadhātu nīlaṃ pītakaṃ lohitakaṃ odātakaṃ cakkhuviññeyyaṃ cakkhusmiṃ paṭihaññati ",
  "kv6.9:1.4": "cakkhussa āpāthaṃ āgacchatī’ti. ",
  "kv6.9:1.5": "na hevaṃ vattabbe …pe… ",
  "kv6.9:2.1": "cakkhundriyaṃ sanidassananti. ",
  "kv6.9:2.2": "āmantā. ",
  "kv6.9:2.3": "cakkhuñca paṭicca cakkhundriyañca uppajjati cakkhuviññāṇanti. ",
  "kv6.9:2.4": "na hevaṃ vattabbe …pe… ",
  "kv6.9:3.1": "cakkhuñca paṭicca cakkhundriyañca uppajjati cakkhuviññāṇanti. ",
  "kv6.9:3.2": "āmantā. ",
  "kv6.9:3.3": "‘cakkhuñca paṭicca cakkhundriyañca uppajjati cakkhuviññāṇanti’ ",
  "kv6.9:3.4": "atthe’va suttanto’ti. ",
  "kv6.9:3.5": "natthī. ",
  "kv6.9:3.6": "“cakkhuñca paṭicca rūpeca uppajjati cakkhuviññāṇanti” ",
  "kv6.9:3.7": "atthe’va suttanto’ti. ",
  "kv6.9:3.8": "āmantā. ",
  "kv6.9:3.9": "hañci ‘cakkhuviñca paṭicca rūpe ca uppajjati cakkhuviññāṇanti’ ",
  "kv6.9:3.10": "atthe’va suttanto, no ca vata re vattabbe ",
  "kv6.9:3.11": "‘cakkhuñca paṭicca cakkhundriyañca uppajjati cakkhuviññāṇanti. ",
  "kv6.9:4.1": "na vattabbaṃ ",
  "kv6.9:4.2": "‘pañcindriyāni sanidassanānī’ti. ",
  "kv6.9:4.3": "āmantā. ",
  "kv6.9:4.4": "nanu passati. cakkhuṃ sotaṃ ghānaṃ jivhaṃ kāyanti. ",
  "kv6.9:4.5": "āmantā. ",
  "kv6.9:4.6": "hañci passati cakkhuṃ sotaṃ ghānaṃ jivhaṃ kāyaṃ, tena vata re vattabbe ",
  "kv6.9:4.7": "‘pañcindriyāni sanidassanānī’ti. ",
  "kv6.9:4.8": ""
}
