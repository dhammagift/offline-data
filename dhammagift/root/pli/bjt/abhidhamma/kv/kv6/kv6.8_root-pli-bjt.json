  "kv6.8:0.3": "",
  "kv6.8:0.4": "6. 8. paṭhavīdhātu sanidassanāti ādiṃ katvā kāyakammaṃ sanidassananti pariyosānakathā. ",
  "kv6.8:1.1": "paṭhavīdhātu sanidassanā’ti. ",
  "kv6.8:1.2": "āmantā. ",
  "kv6.8:1.3": "rūpaṃ rūpāyatanaṃ rūpadhātu nīlaṃ pītakaṃ lohitakaṃ odātaṃ cakkhuviññeyyaṃ cakkhusmiṃ paṭihaññati cakkhussa āpāthaṃ āgacchatīti. ",
  "kv6.8:1.4": "na hevaṃ vattabbe …pe… ",
  "kv6.8:2.1": "paṭhavīdhātu sanidassanā’ti. ",
  "kv6.8:2.2": "āmantā. ",
  "kv6.8:2.3": "cakkhuñca paṭicca paṭhavīdhātuñca uppajjati cakkhuviññāṇanti. ",
  "kv6.8:2.4": "na hevaṃ vattabbe …pe… ",
  "kv6.8:3.1": "cakkhuñca paṭicca paṭhavīdhātuñca uppajjati cakkhuviññāṇanti. ",
  "kv6.8:3.2": "āmantā. ",
  "kv6.8:3.3": "cakkhuñca paṭicca paṭhavīdhātuñca uppajjati cakkhuviññāṇanti ",
  "kv6.8:3.4": "atthe’va suttanto’ti. ",
  "kv6.8:3.5": "natthī. ",
  "kv6.8:3.6": "“cakkhuñca paṭicca rūpe ca uppajjati cakkhuviññāṇanti” ",
  "kv6.8:3.7": "atthe’va suttanto’ti. ",
  "kv6.8:3.8": "āmantā. ",
  "kv6.8:3.9": "hañci ‘cakkhuviñca paṭicca rūpe ca uppajjati cakkhuviññāṇanti’ ",
  "kv6.8:3.10": "atthe’va suttanto, no ca vata re vattabbe: ",
  "kv6.8:3.11": "cakkhuñca paṭicca paṭhavīdhātuñca uppajjati cakkhu viññāṇanti. ",
  "kv6.8:4.1": "na vattabbaṃ ",
  "kv6.8:4.2": "‘paṭhavīdhātu sanidassanā’ti. ",
  "kv6.8:4.3": "āmantā. ",
  "kv6.8:4.4": "nanu passati bhūmiṃ pāsāṇaṃ pabbatanti. ",
  "kv6.8:4.5": "āmantā. ",
  "kv6.8:4.6": "hañci passati bhūmiṃ pāsāṇaṃ pabbataṃ, tena vata re vattabbe’ ",
  "kv6.8:4.7": "paṭhavīdhātusanidassanā’ti. ",
  "kv6.8:5.1": "na vattabbaṃ: ",
  "kv6.8:5.2": "apodhātu sanidassanā’ti. ",
  "kv6.8:5.3": "āmantā. ",
  "kv6.8:5.4": "nanu passati udakanti. ",
  "kv6.8:5.5": "āmantā. ",
  "kv6.8:5.6": "hañci passati udakaṃ, tena vata re vattabbe: ",
  "kv6.8:5.7": "āpodhātu sanidassanā’ti. ",
  "kv6.8:6.1": "na vattabbaṃ ",
  "kv6.8:6.2": "‘tejodhātu sanidassanā’ti. ",
  "kv6.8:6.3": "āmantā. ",
  "kv6.8:6.4": "nanu passati aggiṃ jalantanti. ",
  "kv6.8:6.5": "āmantā. ",
  "kv6.8:6.6": "hañci passati aggiṃ jalantaṃ, tena vata re vattabbe: ",
  "kv6.8:6.7": "‘tejodhātu sanidassanā’ti. ",
  "kv6.8:7.1": "na vattabbaṃ ",
  "kv6.8:7.2": "‘vāyodhātu sanidassanā’ti. ",
  "kv6.8:7.3": "āmantā. ",
  "kv6.8:7.4": "nanu passati vātena rukkhe sañcāliyamāne’ti. ",
  "kv6.8:7.5": "āmantā. ",
  "kv6.8:7.6": "hañci passati vātena rukkhe sañcāliyamāne, tena vata re vattabbe: ",
  "kv6.8:7.7": "‘vāyodhātu sanidassanā’ti. ",
  "kv6.8:7.8": ""
}
