  "kv6.1:0.4": "6. 1. niyāmakathā. ",
  "kv6.1:1.1": "niyāmo asaṅkhato’ti. ",
  "kv6.1:1.2": "āmantā. ",
  "kv6.1:1.3": "nibbānaṃ tāṇaṃ leṇaṃ saraṇaṃ parāyanaṃ accutaṃ amatanti. ",
  "kv6.1:1.4": "na hevaṃ vattabbe …pe… ",
  "kv6.1:2.1": "niyāmo asaṅkhato, nibbānaṃ asaṅkhatanti. ",
  "kv6.1:2.2": "āmantā. ",
  "kv6.1:2.3": "dve asaṅkhatānī’ti. ",
  "kv6.1:2.4": "na hevaṃ vattabbe …pe… ",
  "kv6.1:3.1": "dve asaṅkhatānī’ti. ",
  "kv6.1:3.2": "āmantā. ",
  "kv6.1:3.3": "dve tāṇāni, dve leṇāni, dve saraṇāni, dve parāyanāni, dve accutāni, dve amatāni, dve nibbānānī’ti. ",
  "kv6.1:3.4": "na hevaṃ vattabbe …pe… ",
  "kv6.1:4.1": "dve nibbānānī’ti. ",
  "kv6.1:4.2": "āmantā. ",
  "kv6.1:4.3": "atthī dvinnaṃ nibbānānaṃ uccanīcatā hīnappaṇittā ukkaṃsāvakaṃso sīmā vā bhedo vā rāji vā antarikā vā’ti. ",
  "kv6.1:4.4": "na hevaṃ vattabbe …pe… ",
  "kv6.1:5.1": "niyāmo asaṅkhato’ti. ",
  "kv6.1:5.2": "āmantā. ",
  "kv6.1:5.3": "atthī keci niyāmaṃ okkamanti, paṭilabhanti, uppādenti, samuppādenti, uṭṭhāpenti, samuṭṭhāpenti, nibbattenti, abhinibbattenti, janenti, sañjenentī’ti. ",
  "kv6.1:5.4": "āmantā. ",
  "kv6.1:5.5": "atthī keci asaṅkhataṃ okkamanti paṭilabhanti uppādenti samuppādenti uṭṭhāpenti samuṭṭhāpenti nibbattenti abhinibbattenti janenti sañjenentī’ti. ",
  "kv6.1:5.6": "na hevaṃ vattabbe …pe… ",
  "kv6.1:6.1": "niyāmo asaṅkhato’ti. ",
  "kv6.1:6.2": "āmantā. ",
  "kv6.1:6.3": "maggo asaṅkhato’ti. ",
  "kv6.1:6.4": "na hevaṃ vattabbe …pe… ",
  "kv6.1:7.1": "maggo saṅkhato’ti. ",
  "kv6.1:7.2": "āmantā. ",
  "kv6.1:7.3": "niyāmo saṅkhato’ti. ",
  "kv6.1:7.4": "na hevaṃ vattabbe …pe… ",
  "kv6.1:8.1": "sotāpattiniyāmo asaṅkhato’ti. ",
  "kv6.1:8.2": "āmantā. ",
  "kv6.1:8.3": "sotāpattimaggo asaṅkhatoti, ",
  "kv6.1:8.4": "na hevaṃ vattabbe …pe… ",
  "kv6.1:9.1": "sotāpattimaggo saṅkhato’ti. ",
  "kv6.1:9.2": "āmantā. ",
  "kv6.1:9.3": "sotāpattiniyāmo saṅkhato’ti. ",
  "kv6.1:9.4": "na hevaṃ vattabbe …pe… ",
  "kv6.1:10.1": "sakadāgāmī niyāmo …pe… ",
  "kv6.1:10.2": "anāgāmī niyāmo …pe… ",
  "kv6.1:10.3": "arahatta niyāmo asaṅkhato’ti. ",
  "kv6.1:10.4": "āmantā. ",
  "kv6.1:10.5": "arahattamaggo asaṅkhato’ti. ",
  "kv6.1:10.6": "na hevaṃ vattabbe …pe… ",
  "kv6.1:10.7": "arahattamaggo saṅkhato’ti. ",
  "kv6.1:10.8": "āmantā. ",
  "kv6.1:10.9": "arahattaniyāmo saṅkhato’ti. ",
  "kv6.1:10.10": "na hevaṃ vattabbe …pe… ",
  "kv6.1:11.1": "sotāpattiniyāmo asaṅkhato …pe… ",
  "kv6.1:11.2": "arahattaniyāmo asaṅkhato. nibbānaṃ asaṅkhatanti. ",
  "kv6.1:11.3": "āmantā. ",
  "kv6.1:11.4": "pañca asaṅkhatānī’ti. ",
  "kv6.1:11.5": "na hevaṃ vattabbe …pe… ",
  "kv6.1:11.6": "pañca asaṅkhatānī’ti. ",
  "kv6.1:11.7": "āmantā. ",
  "kv6.1:11.8": "pañca tāṇāni …pe… ",
  "kv6.1:11.9": "antarikā vā’ti. ",
  "kv6.1:11.10": "na hevaṃ vattabbe …pe… ",
  "kv6.1:12.1": "niyāmo asaṅkhato’ti. ",
  "kv6.1:12.2": "āmantā. ",
  "kv6.1:12.3": "micchattaniyāmo asaṅkhato’ti. ",
  "kv6.1:12.4": "na hevaṃ vattabbe …pe… ",
  "kv6.1:12.5": "micchattaniyāmo asaṅkhato’ti. ",
  "kv6.1:12.6": "āmantā. ",
  "kv6.1:12.7": "sammattaniyāmo saṅkhato’ti. ",
  "kv6.1:12.8": "na hevaṃ vattabbe …pe… ",
  "kv6.1:13.1": "na vattabbaṃ ",
  "kv6.1:13.2": "‘niyāmo asaṅkhato’ti. ",
  "kv6.1:13.3": "āmantā. ",
  "kv6.1:13.4": "niyāme uppajja niruddhe aniyate hotī’ti. ",
  "kv6.1:13.5": "na hevaṃ vattabbe …pe… ",
  "kv6.1:13.6": "tena hi niyāmo asaṅkhato’ti. ",
  "kv6.1:13.7": "micchattaniyāme uppajja niruddhe aniyato hotī’ti. ",
  "kv6.1:13.8": "na hevaṃ vattabbe …pe… ",
  "kv6.1:13.9": "tena hi ‘micchattaniyāmo asaṅkhato’ti. ",
  "kv6.1:13.10": "niyāmakathā niṭṭhitā. "
}
