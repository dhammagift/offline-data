  "kv6.3:0.4": "6. 3. saccakathā ",
  "kv6.3:1.1": "cattāri saccāni asaṅkhatānī’ti. ",
  "kv6.3:1.2": "āmantā. ",
  "kv6.3:1.3": "cattāri tāṇāni, cattāri leṇāni, cattāri saraṇāni, cattāri parāyanāni. cattāri accutāni, cattāri amatāni, cattāri nibbānānī’ti. ",
  "kv6.3:1.4": "na hevaṃ vattabbe …pe… ",
  "kv6.3:1.5": "cattāri nibbānānī’ti. ",
  "kv6.3:1.6": "āmantā. ",
  "kv6.3:1.7": "atthī catunnaṃ nibbānānaṃ uccanīcatā hīnappaṇītatā ukkaṃsāvakaṃso sīmā vā bhedo vā rājī vā antarikā vā’ti. ",
  "kv6.3:1.8": "na hevaṃ vattabbe …pe… ",
  "kv6.3:2.1": "dukkhasaccaṃ asaṅkhatanti. ",
  "kv6.3:2.2": "āmantā. ",
  "kv6.3:2.3": "dukkhaṃ asaṅkhatanti. ",
  "kv6.3:2.4": "na hevaṃ vattabbe …pe… ",
  "kv6.3:2.5": "dukkhasaccaṃ asaṅkhatanti. ",
  "kv6.3:2.6": "āmantā. ",
  "kv6.3:2.7": "kāyikaṃ dukkhaṃ cetasikaṃ dukkhaṃ sokaparidevadukkhadomanassaupāyāsā asaṅkhatā’ti. ",
  "kv6.3:2.8": "na hevaṃ vattabbe …pe… ",
  "kv6.3:2.9": "samudayasaccaṃ asaṅkhatanti. ",
  "kv6.3:2.10": "āmantā. ",
  "kv6.3:2.11": "samudayo asaṅkhato’ti. ",
  "kv6.3:2.12": "na hevaṃ vattabbe …pe… ",
  "kv6.3:2.13": "samudayasaccaṃ asaṅkhatanti. ",
  "kv6.3:2.14": "āmantā. ",
  "kv6.3:2.15": "kāmataṇhā bhavataṇhā vibhavataṇhā asaṅkhatā’ti. ",
  "kv6.3:2.16": "na hevaṃ vattabbe …pe… ",
  "kv6.3:2.17": "maggasaccaṃ asaṅkhatanti. ",
  "kv6.3:2.18": "āmantā. ",
  "kv6.3:2.19": "maggo asaṅkhato’ti. ",
  "kv6.3:2.20": "na hevaṃ vattabbe …pe… ",
  "kv6.3:2.21": "maggasaccaṃ asaṅkhatanti. ",
  "kv6.3:2.22": "āmantā. ",
  "kv6.3:2.23": "sammādiṭṭhi …pe… sammāsamādhi asaṅkhato’ti. ",
  "kv6.3:2.24": "na hevaṃ vattabbe …pe… ",
  "kv6.3:3.1": "dukkhaṃ saṅkhatanti. ",
  "kv6.3:3.2": "āmantā. ",
  "kv6.3:3.3": "dukkhasaccaṃ saṅkhatanti. ",
  "kv6.3:3.4": "na hevaṃ vattabbe …pe… ",
  "kv6.3:3.5": "kāyikaṃ dukkhaṃ cetasikaṃ dukkhaṃ sokaparidevadukkhadomanassaupāyāsā saṅkhatā’ti. ",
  "kv6.3:3.6": "āmantā. ",
  "kv6.3:3.7": "dukkhasaccaṃ saṅkhatanti. ",
  "kv6.3:3.8": "na hevaṃ vattabbe …pe… ",
  "kv6.3:3.9": "samudayo saṅkhato’ti. ",
  "kv6.3:3.10": "āmantā. ",
  "kv6.3:3.11": "samudayasaccaṃ saṅkhatanti. ",
  "kv6.3:3.12": "na hevaṃ vattabbe …pe… ",
  "kv6.3:3.13": "kāmataṇhā bhavataṇhā vibhavataṇhā saṅkhatā’ti. ",
  "kv6.3:3.14": "āmantā. ",
  "kv6.3:3.15": "samudayosaccaṃ saṅkhatanti. ",
  "kv6.3:3.16": "na hevaṃ vattabbe …pe… ",
  "kv6.3:3.17": "maggo saṅkhato’ti. ",
  "kv6.3:3.18": "āmantā. ",
  "kv6.3:3.19": "maggasaccaṃ saṅkhatanti. ",
  "kv6.3:3.20": "na hevaṃ vattabbe …pe… ",
  "kv6.3:3.21": "sammādiṭṭhi …pe… sammāsamādhi saṅkhatā’ti. ",
  "kv6.3:3.22": "āmantā. ",
  "kv6.3:3.23": "maggasaccaṃ saṅkhatanti. ",
  "kv6.3:3.24": "na hevaṃ vattabbe …pe… ",
  "kv6.3:4.1": "nirodhasaccaṃ asaṅkhataṃ, nirodho asaṅkhato’ti. ",
  "kv6.3:4.2": "āmantā. ",
  "kv6.3:4.3": "dukkhasaccaṃ asaṅkhataṃ, dukkhaṃ asaṅkhatanti. ",
  "kv6.3:4.4": "na hevaṃ vattabbe …pe… ",
  "kv6.3:4.5": "nirodhasaccaṃ asaṅkhataṃ, nirodho asaṅkhato’ti. ",
  "kv6.3:4.6": "āmantā. ",
  "kv6.3:4.7": "samudayasaccaṃ asaṅkhataṃ samudayo asaṅkhato’ti. ",
  "kv6.3:4.8": "na hevaṃ vattabbe …pe… ",
  "kv6.3:4.9": "nirodhasaccaṃ asaṅkhataṃ, nirodho asaṅkhato’ti. ",
  "kv6.3:4.10": "āmantā. ",
  "kv6.3:4.11": "maggasaccaṃ asaṅkhataṃ, maggo asaṅkhato’ti. ",
  "kv6.3:4.12": "na hevaṃ vattabbe …pe… ",
  "kv6.3:5.1": "dukkhasaccaṃ asaṅkhataṃ, dukkhaṃ saṅkhatanti. ",
  "kv6.3:5.2": "āmantā. ",
  "kv6.3:5.3": "nirodhasaccaṃ asaṅkhataṃ nirodho saṅkhato’ti. ",
  "kv6.3:5.4": "na hevaṃ vattabbe …pe… ",
  "kv6.3:5.5": "samudayasaccaṃ asaṅkhataṃ, samudayo saṅkhato’ti. ",
  "kv6.3:5.6": "āmantā. ",
  "kv6.3:5.7": "nirodhasaccaṃ asaṅkhataṃ, nirodho saṅkhato’ti. ",
  "kv6.3:5.8": "na hevaṃ vattabbe …pe… ",
  "kv6.3:5.9": "maggasaccaṃ asaṅkhataṃ, maggo saṅkhato’ti. ",
  "kv6.3:5.10": "āmantā. ",
  "kv6.3:5.11": "nirodhasaccaṃ asaṅkhataṃ nirodho saṅkhato’ti. ",
  "kv6.3:5.12": "na hevaṃ vattabbe …pe… ",
  "kv6.3:6.1": "na vattabbaṃ ",
  "kv6.3:6.2": "‘cattāri saccāni asaṅkhatānī’ti. ",
  "kv6.3:6.3": "āmantā. ",
  "kv6.3:6.4": "nanu vuttaṃ bhagavatā ",
  "kv6.3:6.5": "“cattārimāni bhikkhave tathāni avitathāni anaññathāni. ",
  "kv6.3:6.6": "katamāni cattāri: ",
  "kv6.3:6.7": "idaṃ dukkhanti bhikkhave tathametaṃ avitathametaṃ anaññathametaṃ. ",
  "kv6.3:6.8": "ayaṃ dukkhasamudayo’ti …pe… ",
  "kv6.3:6.9": "ayaṃ dukkhanirodho’ti …pe… ",
  "kv6.3:6.10": "ayaṃ dukkhanirodhagāminīpaṭipadā’ti tathametaṃ avitathametaṃ anaññathametaṃ. ",
  "kv6.3:6.11": "imāni kho bhikkhave cattāri tathāni avitathāni anaññathānī”ti ",
  "kv6.3:6.12": "atthe’va suttanto’ti. ",
  "kv6.3:6.13": "āmantā. ",
  "kv6.3:6.14": "tena hi cattāri saccāni asaṅkhatānī’ti. ",
  "kv6.3:6.15": "saccakathā niṭṭhitā. "
}
