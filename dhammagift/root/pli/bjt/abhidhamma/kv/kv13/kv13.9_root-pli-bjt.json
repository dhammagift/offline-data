  "kv13.9:2.11": "na hevaṃ vattabbe …pe… ",
  "kv13.9:3.1": "rūpataṇhā akusalā’ti. ",
  "kv13.9:3.2": "āmantā. ",
  "kv13.9:3.3": "dhammataṇhā akusalā’ti. ",
  "kv13.9:3.4": "na hevaṃ vattabbe …pe… ",
  "kv13.9:3.5": "saddataṇhā …pe… ",
  "kv13.9:3.6": "phoṭṭhabbataṇhā akusalā’ti. ",
  "kv13.9:3.7": "āmantā. ",
  "kv13.9:3.8": "dhammataṇhā akusalā’ti. ",
  "kv13.9:3.9": "na hevaṃ vattabbe …pe… ",
  "kv13.9:4.1": "dhammataṇhā abyākatā’ti. ",
  "kv13.9:4.2": "āmantā. ",
  "kv13.9:4.3": "nanu taṇhā akusalā vuttā bhagavatā’ti. ",
  "kv13.9:4.4": "āmantā. ",
  "kv13.9:4.5": "hañci taṇhā akusalā vuttā bhagavatā, no ca vata re, vattabbe ",
  "kv13.9:4.6": "dhammataṇhā abyākatā’ti. ",
  "kv13.9:5.1": "dhammataṇhā abyākatā’ti. ",
  "kv13.9:5.2": "āmantā. ",
  "kv13.9:5.3": "nanu lobho akusalo vutto bhagavatā, dhammataṇhā lobho’ti. ",
  "kv13.9:5.4": "āmantā. ",
  "kv13.9:5.5": "hañci lobho akusalo vutto bhagavatā, dhammataṇhā lobho. no ca vata re, vattabbe ",
  "kv13.9:5.6": "‘dhammataṇhā abyākatā’ti. ",
  "kv13.9:6.1": "dhammataṇhā lobho abyākato’ti. ",
  "kv13.9:6.2": "āmantā. ",
  "kv13.9:6.3": "rūpataṇhā lobho abyākato’ti. ",
  "kv13.9:6.4": "na hevaṃ vattabbe …pe… ",
  "kv13.9:6.5": "dhammataṇhā lobho abyākato’ti. pa. paṭiññā ",
  "kv13.9:6.6": "āmantā. ",
  "kv13.9:6.7": "saddataṇhā …pe… gandhataṇhā …pe… rasataṇhā …pe… ",
  "kv13.9:6.8": "phoṭṭhabbataṇhā lobho ",
  "kv13.9:6.9": "",
  "kv13.9:7.1": "akusalo’ti. ",
  "kv13.9:7.2": "pa. ",
  "kv13.9:7.3": "paṭi ",
  "kv13.9:7.4": "na hevaṃ vattabbe …pe… ",
  "kv13.9:7.5": "saddataṇhā …pe… ",
  "kv13.9:7.6": "phoṭṭhabbataṇhā lobho akusalo’ti. ",
  "kv13.9:7.7": "āmantā. ",
  "kv13.9:7.8": "dhammataṇhā lobho akusalo’ti. ",
  "kv13.9:7.9": "na hevaṃ vattabbe …pe… ",
  "kv13.9:8.1": "dhammataṇhā abyākatā’ti. ",
  "kv13.9:8.2": "āmantā. ",
  "kv13.9:8.3": "nanu vuttaṃ bhagavatā: ",
  "kv13.9:8.4": "“yāyaṃ taṇhā ponobhavikā nandirāgasahagatā tatratatrābhinandinī seyyathīdaṃ: ",
  "kv13.9:8.5": "kāmataṇhā bhavataṇhā vibhavataṇhā”ti ",
  "kv13.9:8.6": "attheva suttanto’ti. pa. paṭiññā. ",
  "kv13.9:8.7": "āmantā. ",
  "kv13.9:8.8": "tena hi na vattabbaṃ ",
  "kv13.9:8.9": "“dhammataṇhā abyākatā”ti. ",
  "kv13.9:9.1": "na vattabbaṃ ",
  "kv13.9:9.2": "“dhammataṇhā abyākatā”ti. ",
  "kv13.9:9.3": "āmantā. ",
  "kv13.9:9.4": "nanu sā dhammataṇhā’ti. ",
  "kv13.9:9.5": "āmantā. ",
  "kv13.9:9.6": "hañci sā dhammataṇhā, tena vata re vattabbe ",
  "kv13.9:9.7": "“dhammataṇhā abyākatā”ti. ",
  "kv13.9:9.8": "dhammataṇhā abyākatātikathā niṭṭhitā. "
