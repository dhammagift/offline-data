  "kv13.5:0.1": "",
  "kv13.5:0.2": "",
  "kv13.5:0.3": "",
  "kv13.5:0.4": "13. 5. nivutakathā. ",
  "kv13.5:1.1": "sa. pu. nivuto nīvaraṇaṃ jahatī’ti. ",
  "kv13.5:1.2": "āmantā. ",
  "kv13.5:1.3": "ratto rāgaṃ jahati. duṭṭho dosaṃ jahati. mūḷho mohaṃ jahati. kiliṭṭho kilese jahatī’ti. ",
  "kv13.5:1.4": "na hevaṃ vattabbe …pe… ",
  "kv13.5:1.5": "rāgena rāgaṃ jahati, dosena dosaṃ jahati, mohena mohaṃ jahati, kilesehi kilese jahatī’ti. ",
  "kv13.5:1.6": "na hevaṃ vattabbe …pe… ",
  "kv13.5:2.1": "rāgo cittasampayutto, maggo cittasampayutto’ti. ",
  "kv13.5:2.2": "āmantā. ",
  "kv13.5:2.3": "dvinnaṃ phassānaṃ …pe… ",
  "kv13.5:2.4": "dvinnaṃ cittānaṃ samodhānaṃ hotī’ti. ",
  "kv13.5:2.5": "na hevaṃ vattabbe …pe… ",
  "kv13.5:2.6": "rāgo akusalo, maggo akusalo’ti. ",
  "kv13.5:2.7": "āmantā. ",
  "kv13.5:2.8": "kusalākusalā sāvajjānavajjā hīnappaṇītā kaṇhasukkasappaṭibhāgā dhammā sammukhībhāvaṃ āgacchantī’ti. ",
  "kv13.5:2.9": "na hevaṃ vattabbe …pe… ",
  "kv13.5:3.1": "kusalākusalā sāvajjānavajjā hīnappaṇītā kaṇhasukkasappaṭibhāgā dhammā sammukhībhāvaṃ āgacchantī’ti. ",
  "kv13.5:3.2": "āmantā. ",
  "kv13.5:3.3": "nanu vuttaṃ bhagavatā ",
  "kv13.5:3.4": "“cattārimāni bhikkhave suvidūravidūrāni ",
  "kv13.5:3.5": "katamāni cattāri: ",
  "kv13.5:3.6": "nabhañca bhikkhave paṭhavī ca ",
  "kv13.5:3.7": "idaṃ paṭhamaṃ suvidūravidūraṃ …pe… tasmā sataṃ dhammo asabbhi ārakā’ti ",
  "kv13.5:3.8": "attheva suttanto’ti. ",
  "kv13.5:3.9": "āmantā. ",
  "kv13.5:3.10": "tena hi na vattabbaṃ ",
  "kv13.5:3.11": "“kusalākusalā …pe… ",
  "kv13.5:3.12": "sammukhībhāvaṃ āgacchantī’ti. ",
  "kv13.5:4.1": "nivuto nīvaraṇaṃ jahatī’ti. ",
  "kv13.5:4.2": "āmantā. ",
  "kv13.5:4.3": "nanu vuttaṃ bhagavatā ",
  "kv13.5:4.4": "“so evaṃ samāhite citte parisuddhe pariyodāte anaṅgaṇe vigatūpakkilese mudubhūte kammaniye ṭhite aneñjappatte āsavānaṃ khayañāṇāya cittaṃ abhininnāmetī’ti ",
  "kv13.5:4.5": "atthe’va suttanto’ti. ",
  "kv13.5:4.6": "āmantā. ",
  "kv13.5:4.7": "tena hi na vattabbaṃ ",
  "kv13.5:4.8": "“nivuto nīvaraṇaṃ jahatī”ti. ",
  "kv13.5:5.1": "na vattabbaṃ ",
  "kv13.5:5.2": "nivuto nīvaraṇaṃ jahatī’ti. ",
  "kv13.5:5.3": "āmantā. ",
  "kv13.5:5.4": "nanu vuttaṃ bhagavatā ",
  "kv13.5:5.5": "“tassa evaṃ jānato evaṃ passato kāmāsavā’pi cittaṃ vimuccati …pe… ",
  "kv13.5:5.6": "avijjāsavā’pi cittaṃ vimuccatī”ti. ",
  "kv13.5:5.7": "attheva suttanto’ti. ",
  "kv13.5:5.8": "āmantā. ",
  "kv13.5:5.9": "tena hi nivuto nīvaraṇaṃ jahatī’ti. ",
  "kv13.5:5.10": "nivutakathā niṭṭhitā. "
}
