  "kv13.6:0.1": "",
  "kv13.6:0.2": "",
  "kv13.6:0.3": "",
  "kv13.6:0.4": "13. 6. sammukhībhūtakathā. ",
  "kv13.6:1.1": "sammukhībhūto saññojanaṃ jahatī’ti. ",
  "kv13.6:1.2": "āmantā. ",
  "kv13.6:1.3": "ratto rāgaṃ jahati, duṭṭho dosaṃ jahati, mūḷho mohaṃ jahati, kiliṭṭho kilese jahatī’ti. ",
  "kv13.6:1.4": "na hevaṃ vattabbe …pe… ",
  "kv13.6:1.5": "rāgena rāgaṃ jahati, dosena dosaṃ jahati, mohena mohaṃ jahati, kilesehi kilese jahatī’ti. ",
  "kv13.6:1.6": "na hevaṃ vattabbe …pe… ",
  "kv13.6:2.1": "rāgo cittasampayutto, maggo cittasampayutto’ti. ",
  "kv13.6:2.2": "āmantā. ",
  "kv13.6:2.3": "dvinnaṃ phassānaṃ …pe… ",
  "kv13.6:2.4": "dvinnaṃ cittānaṃ samodhānaṃ hotī’ti. ",
  "kv13.6:2.5": "na hevaṃ vattabbe …pe… ",
  "kv13.6:2.6": "rāgo akusalo, maggo kusalo’ti. ",
  "kv13.6:2.7": "āmantā. ",
  "kv13.6:2.8": "kusalākusalā sāvajjānavajjā hīnappaṇītā kaṇhasukkasappaṭibhāgā dhammā sammukhībhāvaṃ āgacchantī’ti. ",
  "kv13.6:2.9": "na hevaṃ vattabbe …pe… ",
  "kv13.6:3.1": "kusalākusalā …pe… ",
  "kv13.6:3.2": "sammukhībhāvaṃ āgacchantī’ti. ",
  "kv13.6:3.3": "āmantā. ",
  "kv13.6:3.4": "nanu vuttaṃ bhagavatā ",
  "kv13.6:3.5": "“cattārimāni bhikkhave suvidūravidūrāni. ",
  "kv13.6:3.6": "katamāni cattāri: ",
  "kv13.6:3.7": "nabhañca bhikkhave paṭhavī ca, ",
  "kv13.6:3.8": "idaṃ paṭhamaṃ suvidūravidūraṃ …pe… tasmā sataṃ dhammo asabbhi ārakā”ti. ",
  "kv13.6:3.9": "attheva suttanto’ti. ",
  "kv13.6:3.10": "āmantā. ",
  "kv13.6:3.11": "tena hi vattabbaṃ ",
  "kv13.6:3.12": "“kusalākusalā …pe… ",
  "kv13.6:3.13": "sammukhībhāvaṃ āgacchantī”ti. ",
  "kv13.6:4.1": "sammukhībhūto saññojanaṃ jahatī’ti. ",
  "kv13.6:4.2": "āmantā. ",
  "kv13.6:4.3": "nanu vuttaṃ bhagavatā ",
  "kv13.6:4.4": "“so evaṃ samāhite citte parisuddhe …pe… ",
  "kv13.6:4.5": "āsavānaṃ khayañāṇāya cittaṃ abhininnāmetī”ti. ",
  "kv13.6:4.6": "attheva suttanto’ti. ",
  "kv13.6:4.7": "āmantā. ",
  "kv13.6:4.8": "tena hi na vattabbaṃ ",
  "kv13.6:4.9": "“sammūkhībhuto saññojanaṃ jahatī’ti. ",
  "kv13.6:5.1": "na vattabbaṃ ",
  "kv13.6:5.2": "“sammukhībhūto saññojanaṃ jahatī”ti. ",
  "kv13.6:5.3": "āmantā. ",
  "kv13.6:5.4": "nanu vuttaṃ bhagavatā: ",
  "kv13.6:5.5": "tassa evaṃ jānato evaṃ passato kāmāsavā’pi cittaṃ vimuccati …pe… ",
  "kv13.6:5.6": "avijjāsavā’pi cittaṃ vimuccatī”ti. ",
  "kv13.6:5.7": "atthe’va suttanto’ti. ",
  "kv13.6:5.8": "āmantā. ",
  "kv13.6:5.9": "tena hi sammukhībhūto saññojanaṃ jahatī”ti. ",
  "kv13.6:5.10": "sammukhībhūtakathā niṭṭhitā. "
}
