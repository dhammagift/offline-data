{
  "kv13.1:0.1": "",
  "kv13.1:0.2": "",
  "kv13.1:0.3": "",
  "kv13.1:0.4": "13. 1. kappaṭṭhakathā. ",
  "kv13.1:1.1": "kappaṭṭho kappaṃ tiṭṭheyyā’ti. ",
  "kv13.1:1.2": "āmantā. ",
  "kv13.1:1.3": "kappo ca saṇṭhāti, buddho ca loke uppajjatī’ti. ",
  "kv13.1:1.4": "na hevaṃ vattabbe …pe… ",
  "kv13.1:1.5": "kappaṭṭho kappaṃ tiṭṭheyyā’ti. ",
  "kv13.1:1.6": "āmantā. ",
  "kv13.1:1.7": "kappo ca saṇṭhāti, saṅgho ca bhijjatī’ti. ",
  "kv13.1:1.8": "na hevaṃ vattabbe …pe… ",
  "kv13.1:1.9": "kappaṭṭho kappaṃ tiṭṭheyyā’ti. ",
  "kv13.1:1.10": "āmantā. ",
  "kv13.1:1.11": "kappo ca saṇṭhāti, kappaṭṭho ca kappaṭṭhiyaṃ kammaṃ karotī’ti. ",
  "kv13.1:1.12": "na hevaṃ vattabbe …pe… ",
  "kv13.1:1.13": "kappaṭṭho kappaṃ tiṭṭheyyā’ti. ",
  "kv13.1:1.14": "āmantā. ",
  "kv13.1:1.15": "kappo ca saṇṭhāti, kappaṭṭho ca puggalo kālaṃ karotī’ti. ",
  "kv13.1:1.16": "na hevaṃ vattabbe …pe… ",
  "kv13.1:2.1": "kappaṭṭho kappaṃ tiṭṭheyyā’ti. ",
  "kv13.1:2.2": "āmantā. ",
  "kv13.1:2.3": "atītaṃ kappaṃ tiṭṭheyya, anāgataṃ kappaṃ tiṭṭheyyā’ti. ",
  "kv13.1:2.4": "na hevaṃ vattabbe …pe… ",
  "kv13.1:2.5": "kappaṭṭho kappaṃ tiṭṭheyyā’ti. ",
  "kv13.1:2.6": "āmantā. ",
  "kv13.1:2.7": "dve kappe tiṭṭheyya, tayo kappe tiṭṭheyya. cattāro kappe tiṭṭheyyā’ti. ",
  "kv13.1:2.8": "na hevaṃ vattabbe …pe… ",
  "kv13.1:3.1": "kappaṭṭho kappaṃ tiṭṭheyyā’ti. ",
  "kv13.1:3.2": "āmantā. ",
  "kv13.1:3.3": "kappaṭṭho kappe ḍayhante kattha gacchatī’ti. ",
  "kv13.1:3.4": "aññaṃ lokadhātuṃ gacchatī’ti. ",
  "kv13.1:3.5": "mato gacchati, vehāsaṃ gacchatī’ti. ",
  "kv13.1:3.6": "mato gacchatī’ti. ",
  "kv13.1:3.7": "kappaṭṭhiyaṃ kammaṃ aparāpariyavepakkanti. ",
  "kv13.1:3.8": "na hevaṃ vattabbe …pe… ",
  "kv13.1:3.9": "vehāsaṃ gacchatī’ti. ",
  "kv13.1:3.10": "āmantā. ",
  "kv13.1:3.11": "kappaṭṭho iddhimā’ti. ",
  "kv13.1:3.12": "na hevaṃ vattabbe …pe… ",
  "kv13.1:3.13": "kappaṭṭho iddhimā’ti. ",
  "kv13.1:3.14": "āmantā. ",
  "kv13.1:3.15": "kappaṭṭhena chandiddhipādo bhāvito viriyiddhipādo bhāvito cittiddhipādo bhāvito vīmaṃsiddhipādo bhāvito’ti. ",
  "kv13.1:3.16": "na hevaṃ vattabbe …pe… ",
  "kv13.1:4.1": "na vattabbaṃ ",
  "kv13.1:4.2": "‘kappaṭṭho kappaṃ tiṭṭheyyā’ti. ",
  "kv13.1:4.3": "āmantā. ",
  "kv13.1:4.4": "nanu vuttaṃ bhagavatā. ",
  "kv13.1:5.1": "“āpāyiko nerayiko ",
  "kv13.1:5.2": "kappaṭṭho saṅghabhedako, ",
  "kv13.1:5.3": "vaggarato adhammaṭṭho ",
  "kv13.1:5.4": "yogakkhemato dhaṃsati. ",
  "kv13.1:5.5": "saṅghaṃ samaggaṃ bhetvāna ",
  "kv13.1:5.6": "kappaṃ nirayamhi paccatī”ti. ",
  "kv13.1:6.1": "attheva suttanto’ti. ",
  "kv13.1:6.2": "āmantā. ",
  "kv13.1:6.3": "tena hi “kappaṭṭho kappaṃ tiṭṭheyyā”ti. ",
  "kv13.1:6.4": "kappaṭṭhakathā niṭṭhitā. "
}
