  "kv13.2:0.4": "13. 2. kusalapaṭilābhakathā. ",
  "kv13.2:1.1": "kappaṭṭho kusalaṃ cittaṃ na paṭilabheyyā’ti. ",
  "kv13.2:1.2": "āmantā. ",
  "kv13.2:1.3": "kappaṭṭho dānaṃ dadeyyā’ti. ",
  "kv13.2:1.4": "āmantā. ",
  "kv13.2:1.5": "hañci kappaṭṭho dānaṃ dadeyya, anu pā: no ca vata re vattabbe ",
  "kv13.2:1.6": "“kappaṭṭho kusalaṃ cittaṃ na paṭilabheyyā”ti. ",
  "kv13.2:2.1": "kappaṭṭho kusalaṃ cittaṃ na paṭilabheyyā’ti. ",
  "kv13.2:2.2": "āmantā. ",
  "kv13.2:2.3": "kappaṭṭho cīvaraṃ dadeyya …pe… ",
  "kv13.2:2.4": "piṇḍapātaṃ dadeyya …pe… ",
  "kv13.2:2.5": "senāsanaṃ dadeyya …pe… ",
  "kv13.2:2.6": "gilānapaccayabhesajjaparikkhāraṃ dadeyya …pe… ",
  "kv13.2:2.7": "khādanīyaṃ dadeyya …pe… ",
  "kv13.2:2.8": "bhojanīyaṃ dadeyya …pe… ",
  "kv13.2:2.9": "pānīyaṃ dadeyya …pe… ",
  "kv13.2:2.10": "cetiyaṃ vandeyya …pe… ",
  "kv13.2:2.11": "cetiye mālaṃ āropeyya …pe… ",
  "kv13.2:2.12": "gandhaṃ āropeyya …pe… ",
  "kv13.2:2.13": "vilepanaṃ āropeyya …pe… ",
  "kv13.2:2.14": "cetiyaṃ padakkhiṇaṃ kareyyā’ti. ",
  "kv13.2:2.15": "āmantā. ",
  "kv13.2:2.16": "hañci kappaṭṭho cetiyaṃ padakkhiṇaṃ kareyya, anu pā: no ca vata re vattabbe ",
  "kv13.2:2.17": "“kappaṭṭho kusalaṃ cittaṃ na paṭilabheyyā’ti. ",
  "kv13.2:3.1": "kappaṭṭho kusalaṃ cittaṃ paṭilabheyyā’ti. ",
  "kv13.2:3.2": "āmantā. ",
  "kv13.2:3.3": "tato vuṭṭhānaṃ kusalaṃ cittaṃ paṭilabheyyā’ti. ",
  "kv13.2:3.4": "āmantā. ",
  "kv13.2:3.5": "rūpāvacaraṃ …pe… ",
  "kv13.2:3.6": "arūpāvacaraṃ …pe… ",
  "kv13.2:3.7": "lokuttaraṃ kusalaṃ cittaṃ paṭilabheyyā’ti. ",
  "kv13.2:3.8": "na hevaṃ vattabbe …pe… ",
  "kv13.2:3.9": "kusalapaṭilābhakathā niṭṭhitā. "
}
