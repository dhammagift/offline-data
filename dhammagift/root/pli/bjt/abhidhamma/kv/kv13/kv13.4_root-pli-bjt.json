  "kv13.4:0.3": "",
  "kv13.4:0.4": "13. 4. niyatassa niyāmakathā. ",
  "kv13.4:1.1": "niyato niyāmaṃ okkamatī’ti. ",
  "kv13.4:1.2": "āmantā. ",
  "kv13.4:1.3": "micchattaniyato sammattaniyāmaṃ okkamati, sammattaniyato micchattaniyāmaṃ okkamatī’ti. ",
  "kv13.4:1.4": "na hevaṃ vattabbe …pe… sa. pu. ",
  "kv13.4:2.1": "niyato niyāmaṃ okkamatī’ti. ",
  "kv13.4:2.2": "āmantā. ",
  "kv13.4:2.3": "pubbe maggaṃ bhāvetvā pacchā niyāmaṃ okkamatī’ti. ",
  "kv13.4:2.4": "na hevaṃ vattabbe …pe… ",
  "kv13.4:2.5": "pubbe sotāpattimaggaṃ bhāvetvā pacchā sotāpattiniyāmaṃ okkamatī’ti. ",
  "kv13.4:2.6": "na hevaṃ vattabbe …pe… ",
  "kv13.4:2.7": "pubbe sakadāgāmimaggaṃ …pe… ",
  "kv13.4:2.8": "anāgāmimaggaṃ …pe… ",
  "kv13.4:2.9": "arahattamaggaṃ bhāvetvā pacchā arahattaniyāmaṃ okkamatī’ti. ",
  "kv13.4:2.10": "na hevaṃ vattabbe …pe… ",
  "kv13.4:3.1": "pubbe satipaṭṭhānaṃ …pe… ",
  "kv13.4:3.2": "sammappadhānaṃ …pe… iddhipādaṃ …pe… indriyaṃ …pe… balaṃ …pe… bojjhaṅgaṃ bhāvetvā pacchā niyāmaṃ okkamatī’ti. ",
  "kv13.4:3.3": "na hevaṃ vattabbe …pe… ",
  "kv13.4:4.1": "na vattabbaṃ ",
  "kv13.4:4.2": "niyato niyāmaṃ okkamatī’ti. ",
  "kv13.4:4.3": "āmantā. pa. anu. ",
  "kv13.4:4.4": "bhabbo bodhisatto tāya jātiyā dhammaṃ nābhisametunti. ",
  "kv13.4:4.5": "na hevaṃ vattabbe …pe… ",
  "kv13.4:4.6": "tena hi “niyato niyāmaṃ okkamatī”ti. ",
  "kv13.4:4.7": "niyatassa niyāmakathā niṭṭhitā. "
}
