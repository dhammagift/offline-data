  "kv21.5:0.4": "21. 5. buddha kathā. ",
  "kv21.5:1.1": "atthi buddhānaṃ buddhehi hīnātirekatā’ti. ",
  "kv21.5:1.2": "āmantā. ",
  "kv21.5:1.3": "satipaṭṭhānato’ti. ",
  "kv21.5:1.4": "na hevaṃ vattabbe …pe… ",
  "kv21.5:1.5": "sammappadhānato …pe… ",
  "kv21.5:1.6": "iddhipādato …pe… ",
  "kv21.5:1.7": "indriyato …pe… ",
  "kv21.5:1.8": "balato …pe… ",
  "kv21.5:1.9": "bojjhaṅgato …pe… ",
  "kv21.5:1.10": "vasībhāvato …pe… ",
  "kv21.5:1.11": "sabbaññutañāṇadassanato’ti. ",
  "kv21.5:1.12": "na hevaṃ vattabbe …pe… ",
  "kv21.5:1.13": "buddha kathā niṭṭhitā. "
}
