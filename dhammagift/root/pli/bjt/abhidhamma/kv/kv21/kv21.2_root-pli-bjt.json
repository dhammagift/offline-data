  "kv21.2:0.3": "",
  "kv21.2:0.4": "21. 2. avivittakathā. ",
  "kv21.2:1.1": "puthujjano tedhātukehi dhammehi avivitto’ti. ",
  "kv21.2:1.2": "āmantā. ",
  "kv21.2:1.3": "puthujjano tedhātukehi phassehi …pe… ",
  "kv21.2:1.4": "tedhātukāhi vedanāhi …pe… ",
  "kv21.2:1.5": "saññāhi …pe… ",
  "kv21.2:1.6": "cetanāhi …pe… ",
  "kv21.2:1.7": "cittehi …pe… ",
  "kv21.2:1.8": "saddhāhi …pe… ",
  "kv21.2:1.9": "viriyehi …pe… ",
  "kv21.2:1.10": "satīhi …pe… ",
  "kv21.2:1.11": "samādhīhi …pe… ",
  "kv21.2:1.12": "tedhātukāhi paññāhi avivitto’ti. ",
  "kv21.2:1.13": "na hevaṃ vattabbe …pe… ",
  "kv21.2:2.1": "puthujjano tedhātukehi dhammehi avivitto’ti. ",
  "kv21.2:2.2": "āmantā. ",
  "kv21.2:2.3": "yasmiṃ khaṇe puthujjano cīvaraṃ deti, tasmiṃ khaṇe paṭhamaṃ jhānaṃ upasampajja viharati …pe… ",
  "kv21.2:2.4": "ākāsānañcāyatanaṃ upasampajjaviharatī’ti. ",
  "kv21.2:2.5": "na hevaṃ vattabbe …pe… ",
  "kv21.2:2.6": "yasmiṃ khaṇe puthujjano piṇḍapātaṃ deti …pe… ",
  "kv21.2:2.7": "senāsanaṃ deti …pe… ",
  "kv21.2:2.8": "gilānapaccayabhesajjaparikkhāraṃ deti, tasmiṃ khaṇe catutthaṃ jhānaṃ upasampajja viharati …pe… ",
  "kv21.2:2.9": "nevasaññānāsaññāyatanaṃ upasampajja viharatī’ti. ",
  "kv21.2:2.10": "na hevaṃ vattabbe …pe… ",
  "kv21.2:3.1": "na vattabbaṃ ",
  "kv21.2:3.2": "puthujjano tedhātukehi dhammehi avivitto’ti. ",
  "kv21.2:3.3": "āmantā. ",
  "kv21.2:3.4": "puthujjanassa rupadhātuarūpadhātugaṃ kammaṃ pariññātanti. ",
  "kv21.2:3.5": "na hevaṃ vattabbe …pe… ",
  "kv21.2:3.6": "tena hi “puthujjano tedhātukehi dhammehi avivitto”ti. ",
  "kv21.2:3.7": "avivittakathā niṭṭhitā. "
}
