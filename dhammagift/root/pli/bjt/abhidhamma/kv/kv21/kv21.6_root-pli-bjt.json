  "kv21.6:0.4": "21. 6. sabbadisā kathā. ",
  "kv21.6:1.1": "sabbā disā buddhā tiṭṭhantī’ti. ",
  "kv21.6:1.2": "āmantā. ",
  "kv21.6:1.3": "puratthimāya disāya buddho tiṭṭhatī’ti. ",
  "kv21.6:1.4": "na hevaṃ vattabbe …pe… ",
  "kv21.6:1.5": "puratthimāya disāya buddho tiṭṭhatī’ti. ",
  "kv21.6:1.6": "āmantā. ",
  "kv21.6:1.7": "kinnāmo so bhagavā, kiṃ jacco, kiṃ gotto, kinnāmā tassa bhagavato mātāpitaro, kinnāmaṃ tassa bhagavato sāvakayugaṃ, konāmo tassa bhagavato sāvakayugaṃ, konāmo tassa bhagavato upaṭṭhāko, kīdisaṃ cīvaraṃ dhāreti, kīdisaṃ pattaṃ dhāreti, katarasmiṃ gāme vā nigame vā nagare vā raṭṭhe vā janapade vā’ti. ",
  "kv21.6:1.8": "na hevaṃ vattabbe …pe… ",
  "kv21.6:2.1": "dakkhiṇāya disāya …pe… ",
  "kv21.6:2.2": "pacchimāya disāya …pe… ",
  "kv21.6:2.3": "uttarāya disāya …pe… ",
  "kv21.6:2.4": "heṭṭhimāya disāya buddho tiṭṭhati’ti. ",
  "kv21.6:2.5": "na hevaṃ vattabbe …pe… ",
  "kv21.6:2.6": "heṭṭhimāya disāya buddho tiṭṭhatī’ti. ",
  "kv21.6:2.7": "āmantā. ",
  "kv21.6:2.8": "kinnāmo so bhagavā …pe… ",
  "kv21.6:2.9": "janapade vā’ti. ",
  "kv21.6:2.10": "na hevaṃ vattabbe …pe… ",
  "kv21.6:3.1": "uparimāya disāya buddho tiṭṭhatī’ti. ",
  "kv21.6:3.2": "na hevaṃ vattabbe …pe… ",
  "kv21.6:3.3": "uparimāya disāya buddho tiṭṭhatī’ti. ",
  "kv21.6:3.4": "āmantā. ",
  "kv21.6:3.5": "cātummahārājike tiṭṭhati …pe… ",
  "kv21.6:3.6": "tāvatiṃse tiṭṭhati …pe… ",
  "kv21.6:3.7": "yāme tiṭṭhati …pe… ",
  "kv21.6:3.8": "tusite tiṭṭhati …pe… ",
  "kv21.6:3.9": "nimmāṇaratiyā tiṭṭhati …pe… ",
  "kv21.6:3.10": "paranimmita vasavattiyā tiṭṭhati …pe… ",
  "kv21.6:3.11": "brahmaloke tiṭṭhatī’ti. ",
  "kv21.6:3.12": "na hevaṃ vattabbe …pe… ",
  "kv21.6:3.13": "sabbadisā kathā niṭṭhitā. "
}
