{
  "kv15.11:0.1": "",
  "kv15.11:0.2": "",
  "kv15.11:0.3": "",
  "kv15.11:0.4": "15. 11. kammūpacayakathā. ",
  "kv15.11:1.1": "aññaṃ kammaṃ, añño kammūpacayo’ti. ",
  "kv15.11:1.2": "āmantā. ",
  "kv15.11:1.3": "añño phasso, añño phassupacayo, ",
  "kv15.11:1.4": "aññā vedanā, añño vedanūpacayo, ",
  "kv15.11:1.5": "aññā saññā, añño saññūpacayo, ",
  "kv15.11:1.6": "aññā cetanā, añño cetanūpacayo, ",
  "kv15.11:1.7": "aññaṃ cittaṃ, añño cittūpacayo, ",
  "kv15.11:1.8": "aññā saddhā, añño saddhūpacayo, ",
  "kv15.11:1.9": "aññaṃ viriyaṃ, añño viriyūpacayo, ",
  "kv15.11:1.10": "aññā sati, añño satūpacayo, ",
  "kv15.11:1.11": "añño samādhi, añño samādhupacayo, ",
  "kv15.11:1.12": "aññā paññā, añño paññūpacayo, ",
  "kv15.11:1.13": "añño rāgo, añño rāgūpacayo …pe… ",
  "kv15.11:1.14": "aññaṃ anottappaṃ, añño anottappupacayo’tī. ",
  "kv15.11:1.15": "na hevaṃ vattabbe …pe… ",
  "kv15.11:2.1": "aññaṃ kammaṃ, añño kammupacayoti. ",
  "kv15.11:2.2": "āmantā, ",
  "kv15.11:2.3": "kammupacayo kammena sahajāto’ti. ",
  "kv15.11:2.4": "na hevaṃ vattabbe …pe… ",
  "kv15.11:3.1": "kammūpacayo kammena sahajāto’ti. ",
  "kv15.11:3.2": "āmantā. ",
  "kv15.11:3.3": "kusalena kammena sahajāto kammupacayo kusalo’ti. na hevaṃ vattabbe …pe… ",
  "kv15.11:4.1": "kusalena kammena sahajāto kammūpacayo kusalo’ti. ",
  "kv15.11:4.2": "āmantā. ",
  "kv15.11:4.3": "sukhāya vedanāya sampayuttena kammena sahajāto kammupacayo sukhāya vedanāya sampayutto’ti. ",
  "kv15.11:4.4": "na hevaṃ vattabbe …pe… ",
  "kv15.11:4.5": "dukkhāya vedanāya …pe… ",
  "kv15.11:4.6": "adukkhamasukhāya vedanāya sampayuttena kammena sahajāto kammūpacayo adukkhamasukhāya vedanāya sampayutto’ti. ",
  "kv15.11:4.7": "na hevaṃ vattabbe …pe… ",
  "kv15.11:5.1": "kammūpacayo kammena sahajāto’ti. ",
  "kv15.11:5.2": "āmantā. ",
  "kv15.11:5.3": "akusalena kammena sahajāto kammūpacayo akusaloti. ",
  "kv15.11:5.4": "na hevaṃ vattabbe …pe… ",
  "kv15.11:6.1": "akusalena kammena sahajāto kammūpacayo akusalo’ti. ",
  "kv15.11:6.2": "āmantā. ",
  "kv15.11:6.3": "sukhāya vedanāya sampayuttena kammena sahajāto kammupacayo sukhāya vedanāya sampayutto’ti. ",
  "kv15.11:6.4": "na hevaṃ vattabbe …pe… ",
  "kv15.11:6.5": "dukkhāya vedanāya …pe… ",
  "kv15.11:6.6": "adukkhamasukhāya vedanāya sampayuttena kammena sahajāto kammūpacayo adukkhamasukhāya vedanāya sampayutto’ti. ",
  "kv15.11:6.7": "na hevaṃ vattabbe …pe… ",
  "kv15.11:7.1": "kammaṃ cittena sahajātaṃ, kammaṃ sārammaṇanti. ",
  "kv15.11:7.2": "āmantā. ",
  "kv15.11:7.3": "kammūpacayo cittena sahajāto, kammūpacayo sārammaṇo’ti. ",
  "kv15.11:7.4": "na hevaṃ vattabbe …pe… ",
  "kv15.11:7.5": "kammūpacayo cittena sahajāto, kammūpacayo anārammaṇo’ti. ",
  "kv15.11:7.6": "āmantā. ",
  "kv15.11:7.7": "kammaṃ cittena sahajātaṃ, kammaṃ anārammaṇanti. ",
  "kv15.11:7.8": "na hevaṃ vattabbe …pe… ",
  "kv15.11:8.1": "kammaṃ cittena sahajātaṃ, cittaṃ bhijjamānaṃ kammaṃ bhijjatī’ti. ",
  "kv15.11:8.2": "āmantā. ",
  "kv15.11:8.3": "kammupacayo cittena sahajāto, cittaṃ bhijjamānaṃ kammūpacayo bhijjatīti. ",
  "kv15.11:8.4": "na hevaṃ vattabbe …pe… ",
  "kv15.11:9.1": "kammupacayo cittena sahajāto, cittaṃ bhijjamānaṃ kammūpacayo na bhijjatīti, ",
  "kv15.11:9.2": "āmantā. ",
  "kv15.11:9.3": "kammaṃ cittena sahajātaṃ, cittaṃ bhijjamānaṃ kammaṃ na bhijjatī’ti. ",
  "kv15.11:9.4": "na hevaṃ vattabbe …pe… ",
  "kv15.11:10.1": "kammamhi kammūpacayo’ti. ",
  "kv15.11:10.2": "āmantā, ",
  "kv15.11:10.3": "taññeva kammaṃ so kammūpacayo’ti. ",
  "kv15.11:10.4": "na hevaṃ vattabbe …pe… ",
  "kv15.11:11.1": "kammamhi kammūpacayo, kammūpacayato vipāko nibbattatī’ti. ",
  "kv15.11:11.2": "āmantā. ",
  "kv15.11:11.3": "taññeva kammaṃ, so kammūpacayo, so kammavipāko’ti. ",
  "kv15.11:11.4": "na hevaṃ vattabbe …pe… ",
  "kv15.11:12.1": "kammamhi kammūpacayo, kammūpacayato vipāko nibbattati, vipāko sārammaṇo’ti. ",
  "kv15.11:12.2": "āmantā. ",
  "kv15.11:12.3": "kammūpacayo sārammaṇo’ti. ",
  "kv15.11:12.4": "na hevaṃ vattabbe …pe… ",
  "kv15.11:12.5": "kammūpacayo anārammaṇo’ti. ",
  "kv15.11:12.6": "āmantā. ",
  "kv15.11:12.7": "vipāko anārammaṇo’ti. ",
  "kv15.11:12.8": "na hevaṃ vattabbe …pe… ",
  "kv15.11:13.1": "aññaṃ kammaṃ, añño kammūpacayo’ti. ",
  "kv15.11:13.2": "āmantā. ",
  "kv15.11:13.3": "nanu vuttaṃ bhagavatā ",
  "kv15.11:13.4": "“idha puṇṇa, ekacco sabyāpajjhampi abyāpajjhampi kāyasaṅkhāraṃ abhisaṅkharoti, sabyāpajjhampi abyāpajjhampi vacīsaṅkhāraṃ …pe… ",
  "kv15.11:13.5": "manosaṅkhāraṃ abhisaṅkharoti. so sabyāpajjhampi abyāpajjhampi kāyasaṅkhāraṃ abhisaṅkharitvā sabyāpajjhampi abyāpajjhampi vacīsaṅkhāraṃ …pe… ",
  "kv15.11:13.6": "manosaṅkhāraṃ abhisaṅkharitvā sabyāpajjhampi abyāpajjhampi lokaṃ upapajjati. ",
  "kv15.11:13.7": "tamenaṃ sabyāpajjhampi abyāpajjhampi lokaṃ upapannaṃ samānaṃ sabyāpajjhampi abyāpajjhampi phassā phusanti. ",
  "kv15.11:13.8": "so sabyāpajjhehipi abyāpajjhehipi phassehi phuṭṭho samāno sabyāpajjhampi abyāpajjhampi vedanaṃ vedeti vokiṇṇasukhadukkhaṃ, seyyathāpi manussā ekacce ca devā ekacce ca vinipātikā. ",
  "kv15.11:13.9": "iti kho puṇṇa, bhūtā bhūtassa upapatti hoti. yaṃ karoti tena upapajjati. upapannametaṃ phassā phusanti. ",
  "kv15.11:13.10": "evampahaṃ puṇṇa, kammadāyādā sattā’ti vadāmi”ti, ",
  "kv15.11:13.11": "attheva suttanto. ",
  "kv15.11:13.12": "āmantā. ",
  "kv15.11:13.13": "tena hi na vattabbaṃ ",
  "kv15.11:13.14": "“aññaṃ kammaṃ añño kammūpacayo”ti, ",
  "kv15.11:13.15": "kammūpacayakathā niṭṭhitā. ",
  "kv15.11:13.16": "paṇṇarasamo vaggo. ",
  "kv15.11:13.17": "tassuddānaṃ: ",
  "kv15.11:14.1": "“paccayatā vavatthitā ",
  "kv15.11:14.2": "paṭiccasamuppādo ",
  "kv15.11:14.3": "addhā ca ",
  "kv15.11:14.4": "khaṇo layo muhuttaṃ ",
  "kv15.11:14.5": "cattāro āsavā anāsavā ",
  "kv15.11:14.6": "lokuttarānaṃ dhammānaṃ jarāmaraṇaṃ, lokuttarā ",
  "kv15.11:14.7": "saññāvedayitanirodhasamāpatti, ",
  "kv15.11:14.8": "lokiyā saññāvedayitanirodhasamāpatti, ",
  "kv15.11:14.9": "saññāvedayitanirodhaṃ samāpanno kālaṃ kareyya, ",
  "kv15.11:14.10": "sveva maggo asaññasattūpapattiyā, ",
  "kv15.11:14.11": "aññaṃ kammaṃ añño kammūpacayo”ti. ",
  "kv15.11:14.12": "tatiyo paṇṇāsako. ",
  "kv15.11:14.13": "soḷasamo ",
  "kv15.11:15.1": "",
  "kv15.11:15.2": "",
  "kv15.11:15.3": "vaggo. ",
  "kv15.11:15.4": ""
}
