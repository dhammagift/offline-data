  "kv15.4:0.1": "",
  "kv15.4:0.2": "",
  "kv15.4:0.3": "",
  "kv15.4:0.4": "15. 4. khaṇa-laya-muhuttakathā. ",
  "kv15.4:1.1": "khaṇo parinipphanno …pe… layo parinipphanno …pe… muhuttaṃ parinipphannanti. ",
  "kv15.4:1.2": "āmantā. ",
  "kv15.4:1.3": "rūpanti. ",
  "kv15.4:1.4": "na hevaṃ vattabbe …pe… ",
  "kv15.4:1.5": "vedanā …pe… ",
  "kv15.4:1.6": "saññā …pe… ",
  "kv15.4:1.7": "saṅkhārā …pe… ",
  "kv15.4:1.8": "viññāṇanti. ",
  "kv15.4:1.9": "na hevaṃ vattabbe …pe… ",
  "kv15.4:2.1": "na vattabbaṃ ",
  "kv15.4:2.2": "muhuttaṃ parinipphannanti. ",
  "kv15.4:2.3": "āmantā. ",
  "kv15.4:2.4": "nanu vuttaṃ bhagavatā: ",
  "kv15.4:2.5": "“tīṇimāni bhikkhave, kathāvatthuni. ",
  "kv15.4:2.6": "katamāni tīṇi: ",
  "kv15.4:2.7": "atītaṃ vā bhikkhave, addhānaṃ ārabbha kathaṃ katheyya: ",
  "kv15.4:2.8": "evaṃ ahosi atītamaddhānanti. ",
  "kv15.4:2.9": "anāgataṃ vā bhikkhave addhānaṃ ārabbha kathaṃ katheyya: ",
  "kv15.4:2.10": "evaṃ bhavissati anāgatamaddhānanti. ",
  "kv15.4:2.11": "etarahi vā paccuppannaṃ addhānaṃ ārabbha kataṃ katheyya: ",
  "kv15.4:2.12": "evaṃ hoti etarahi paccuppannanti ",
  "kv15.4:2.13": "imāni kho bhikkhave, tīṇi kathāvatthuni’ti ",
  "kv15.4:2.14": "attheva suttanto’ti. ",
  "kv15.4:2.15": "āmantā. ",
  "kv15.4:2.16": "tena hi muhuttaṃ parinipphannanti. ",
  "kv15.4:2.17": "khaṇa-laya-muhuttakathā niṭṭhitā. "
}
