  "kv15.2:0.3": "",
  "kv15.2:0.4": "15. 2. aññamaññapaccayakathā. ",
  "kv15.2:1.1": "avijjāpaccayāpi saṅkhārā, na vattabbaṃ ",
  "kv15.2:1.2": "‘saṅkhārapaccayāpi avijjā’ti. ",
  "kv15.2:1.3": "āmantā. ",
  "kv15.2:1.4": "nanu avijjā saṅkhārena sahajātā’ti. ",
  "kv15.2:1.5": "āmantā. ",
  "kv15.2:1.6": "hañci avijjā saṅkhārena sahajātā, tena vata re vattabbe ",
  "kv15.2:1.7": "“avijjāpaccayāpi saṅkhārā, saṅkhārapaccayāpi avijjā”ti. ",
  "kv15.2:2.1": "taṇhāpaccayā upādānaṃ, na vattabbaṃ ",
  "kv15.2:2.2": "upādāna paccayāpi taṇhā’ti. ",
  "kv15.2:2.3": "āmantā. ",
  "kv15.2:2.4": "nanu taṇhā upādānena sahajātā’ti. ",
  "kv15.2:2.5": "āmantā. ",
  "kv15.2:2.6": "hañci taṇhā upādānena sahajātā, tena vata re vattabbe ",
  "kv15.2:2.7": "“taṇhāpaccayāpi upādānaṃ, upādānapaccayāpi taṇhā”ti. ",
  "kv15.2:3.1": "“jarāmaraṇapaccayā bhikkhave, jāti, jātipaccayā bhavo”ti ",
  "kv15.2:3.2": "attheva suttanto’ti. ",
  "kv15.2:3.3": "natthi. ",
  "kv15.2:3.4": "tena hi “avijjāpaccayāpi saṅkhārā, na vattabbaṃ, ",
  "kv15.2:3.5": "saṅkhārapaccayāpi avijjā’ti. ",
  "kv15.2:3.6": "taṇhāpaccayāpi upādānaṃ, na vattabbaṃ ",
  "kv15.2:3.7": "upādānapaccayāpi taṇhā”ti. ",
  "kv15.2:4.1": "“viññāṇapaccayā bhikkhave nāmarūpaṃ, nāmarūpapaccayāpi viññāṇa”nti ",
  "kv15.2:4.2": "attheva suttanto’ti. ",
  "kv15.2:4.3": "āmantā. ",
  "kv15.2:4.4": "tena hi avijjāpaccayāpi saṅkhārā, saṅkhārapaccayāpi avijjā, ",
  "kv15.2:4.5": "taṇhāpaccayāpi upādānaṃ upādānapaccayāpi taṇhā’ti. ",
  "kv15.2:4.6": "aññamaññapaccayakathā niṭṭhitā. "
}
