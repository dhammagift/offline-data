  "kv15.7:0.4": "15. 7. saññāvedayitakathā. ",
  "kv15.7:1.1": "saññāvedayitanirodhasamāpatti lokuttarāti. ",
  "kv15.7:1.2": "āmantā. ",
  "kv15.7:1.3": "maggo …pe… phalaṃ …pe… nibbānaṃ …pe… sotāpattimaggo …pe… sotāpattiphalaṃ …pe… bojjhaṅgo’ti. ",
  "kv15.7:1.4": "na hevaṃ vattabbe …pe… ",
  "kv15.7:2.1": "na vattabbaṃ ",
  "kv15.7:2.2": "saññāvedayitanirodhasamāpatti lokuttarā’ti. ",
  "kv15.7:2.3": "āmantā. ",
  "kv15.7:2.4": "lokiyā’ti. ",
  "kv15.7:2.5": "na hevaṃ vattabbe …pe… ",
  "kv15.7:2.6": "tena hi lokuttarāti. ",
  "kv15.7:2.7": "saññāvedayitakathā niṭṭhitā. "
}
