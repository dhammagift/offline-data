  "kv15.6:0.3": "",
  "kv15.6:0.4": "15. 6. jarāmaraṇakathā. ",
  "kv15.6:1.1": "lokuttarānaṃ dhammānaṃ jarāmaraṇaṃ lokuttaranti. ",
  "kv15.6:1.2": "āmantā. ",
  "kv15.6:1.3": "maggo phalaṃ nibbānaṃ sotāpattimaggo …pe… sotāpattiphalaṃ …pe… bojjhaṅgo’ti. ",
  "kv15.6:1.4": "na hevaṃ vattabbe …pe… ",
  "kv15.6:1.5": "sotāpattimaggassa jarāmaraṇaṃ sotāpattimaggo’ti. ",
  "kv15.6:1.6": "na hevaṃ vattabbe …pe… ",
  "kv15.6:1.7": "sotāpattimaggassa jarāmaraṇaṃ sotāpattimaggoti. pa. paṭiññā ",
  "kv15.6:1.8": "āmantā. ",
  "kv15.6:1.9": "sotāpattiphalassa jarāmaraṇaṃ sotāpattiphalanti. ",
  "kv15.6:1.10": "na hevaṃ vattabbe …pe… ",
  "kv15.6:1.11": "sakadāgāmimaggassa …pe… ",
  "kv15.6:1.12": "sakadāgāmiphalassa …pe… ",
  "kv15.6:1.13": "anāgāmimaggassa …pe… ",
  "kv15.6:1.14": "anāgāmiphalassa …pe… ",
  "kv15.6:1.15": "arahattamaggassa jarāmaraṇaṃ arahattamaggo’ti. ",
  "kv15.6:1.16": "na hevaṃ vattabbe …pe… ",
  "kv15.6:1.17": "arahattamaggassa jarāmaraṇaṃ arahattamaggo’ti. ",
  "kv15.6:1.18": "āmantā. ",
  "kv15.6:1.19": "arahattaphalassa jarāmaraṇaṃ arahattaphalanti. ",
  "kv15.6:1.20": "na hevaṃ vattabbe …pe… ",
  "kv15.6:1.21": "satipaṭṭhānānaṃ …pe… ",
  "kv15.6:1.22": "sammappadhānānaṃ …pe… ",
  "kv15.6:1.23": "iddhipādānaṃ …pe… ",
  "kv15.6:1.24": "indriyānaṃ …pe… ",
  "kv15.6:1.25": "balānaṃ …pe… ",
  "kv15.6:1.26": "bojjhaṅgānaṃ jarāmaraṇaṃ bojjhaṅgo’ti. ",
  "kv15.6:1.27": "na hevaṃ vattabbe …pe… ",
  "kv15.6:2.1": "na vattabbaṃ ",
  "kv15.6:2.2": "lokuttarānaṃ dhammānaṃ jarāmaraṇaṃ lokuttaranti. ",
  "kv15.6:2.3": "āmantā. ",
  "kv15.6:2.4": "lokiyanti. ",
  "kv15.6:2.5": "na hevaṃ vattabbe …pe… ",
  "kv15.6:2.6": "tena hi lokuttaranti. ",
  "kv15.6:2.7": "jarāmaraṇakathā niṭṭhitā. "
}
