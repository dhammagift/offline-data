  "kv15.3:0.4": "15. 3. addhākathā ",
  "kv15.3:1.1": "addhā parinipphanno’ti. ",
  "kv15.3:1.2": "āmantā. ",
  "kv15.3:1.3": "rūpanti. ",
  "kv15.3:1.4": "na hevaṃ vattabbe …pe… ",
  "kv15.3:1.5": "vedanā …pe… ",
  "kv15.3:1.6": "saññā …pe… ",
  "kv15.3:1.7": "saṅkhārā …pe… ",
  "kv15.3:1.8": "viññāṇanti. ",
  "kv15.3:1.9": "na hevaṃ vattabbe …pe… ",
  "kv15.3:1.10": "atīto addhā parinipphanno’ti, ",
  "kv15.3:1.11": "āmantā. ",
  "kv15.3:1.12": "rūpanti. ",
  "kv15.3:1.13": "na hevaṃ vattabbe …pe… ",
  "kv15.3:1.14": "vedanā …pe… ",
  "kv15.3:1.15": "saññā …pe… ",
  "kv15.3:1.16": "saṅkhārā …pe… ",
  "kv15.3:1.17": "viññāṇanti. ",
  "kv15.3:1.18": "na hevaṃ vattabbe …pe… ",
  "kv15.3:1.19": "anāgato addhā parinipphanno’ti. ",
  "kv15.3:1.20": "āmantā. ",
  "kv15.3:1.21": "rūpanti. ",
  "kv15.3:1.22": "na hevaṃ vattabbe …pe… ",
  "kv15.3:1.23": "vedanā …pe… ",
  "kv15.3:1.24": "saññā …pe… ",
  "kv15.3:1.25": "saṅkhārā …pe… ",
  "kv15.3:1.26": "viññāṇanti. ",
  "kv15.3:1.27": "na hevaṃ vattabbe …pe… ",
  "kv15.3:1.28": "paccuppanno addhā parinipphanno’ti. ",
  "kv15.3:1.29": "āmantā. ",
  "kv15.3:1.30": "rūpanti. ",
  "kv15.3:1.31": "na hevaṃ vattabbe …pe… ",
  "kv15.3:1.32": "vedanā …pe… ",
  "kv15.3:1.33": "saññā …pe… ",
  "kv15.3:1.34": "saṅkhārā …pe… ",
  "kv15.3:1.35": "viññāṇanti. ",
  "kv15.3:1.36": "na hevaṃ vattabbe …pe… ",
  "kv15.3:2.1": "atītā rūpā vedanā saññā saṅkhārā viññāṇaṃ atīto addhā’ti. ",
  "kv15.3:2.2": "āmantā. ",
  "kv15.3:2.3": "atītā pañcadhāti. ",
  "kv15.3:2.4": "na hevaṃ vattabbe …pe… ",
  "kv15.3:2.5": "anāgatā rūpā vedanā saññā saṅkhārā viññāṇaṃ anāgato addhā’ti. ",
  "kv15.3:2.6": "āmantā. ",
  "kv15.3:2.7": "anāgatā pañcadhā’ti. ",
  "kv15.3:2.8": "na hevaṃ vattabbe …pe… ",
  "kv15.3:2.9": "paccuppannā rūpā vedanā saññā saṅkhārā viññāṇaṃ paccuppanno addhā’ti. ",
  "kv15.3:2.10": "āmantā. ",
  "kv15.3:2.11": "paccuppannā pañcadhā’ti. ",
  "kv15.3:2.12": "na hevaṃ vattabbe …pe… ",
  "kv15.3:3.1": "atītā pañcakkhandhā atīto addhā, anāgatā pañcakkhandhā anāgato addhā, paccuppannā pañcakkhandhā paccuppanno addhāti. ",
  "kv15.3:3.2": "āmantā. ",
  "kv15.3:3.3": "paṇṇarasaddhā’ti. ",
  "kv15.3:3.4": "na hevaṃ vattabbe …pe… ",
  "kv15.3:4.1": "atītāni dvādasāyatanāni atīto addhā, anāgatāni dvādasāyatanāni anāgato addhā, paccuppannāni dvādasāyatanāni paccuppanno addhā’ti. ",
  "kv15.3:4.2": "āmantā. ",
  "kv15.3:4.3": "chattiṃsa addhā’ti. ",
  "kv15.3:4.4": "na hevaṃ vattabbe …pe… ",
  "kv15.3:5.1": "atītā aṭṭhārasa dhātuyo atīto addhā, anāgatā aṭṭhārasa dhātuyo anāgato addhā, paccuppannā aṭṭhārasa dhātuyo paccuppanno addhā’ti. ",
  "kv15.3:5.2": "āmantā. ",
  "kv15.3:5.3": "catupaññāsaddhāti. ",
  "kv15.3:5.4": "na hevaṃ vattabbe …pe… ",
  "kv15.3:6.1": "atītāni bāvīsatindriyāni atīto addhā, anāgatāni bāvīsatindriyāni anāgato addhā, paccuppannāni bāvīsatindriyāni paccuppanno addhā’ti. ",
  "kv15.3:6.2": "āmantā. ",
  "kv15.3:6.3": "chasaṭṭhi addhāti. ",
  "kv15.3:6.4": "na hevaṃ vattabbe …pe… ",
  "kv15.3:7.1": "na vattabbaṃ ",
  "kv15.3:7.2": "addhā parinipphanno’ti. ",
  "kv15.3:7.3": "āmantā. ",
  "kv15.3:7.4": "nanu vuttaṃ bhagavatā: ",
  "kv15.3:7.5": "“tīṇimāni bhikkhave kathāvatthuni. ",
  "kv15.3:7.6": "katamāni tīṇi: ",
  "kv15.3:7.7": "atītaṃ vā bhikkhave, addhānaṃ ārabbha kathaṃ katheyya: ",
  "kv15.3:7.8": "evaṃ ahosi atītamaddhānanti. ",
  "kv15.3:7.9": "anāgataṃ vā bhikkhave, addhānaṃ ārabbha kathaṃ katheyya: ",
  "kv15.3:7.10": "evaṃ bhavissati anāgatamaddhānanti. ",
  "kv15.3:7.11": "etarahi vā bhikkhave, paccuppannaṃ addhānaṃ ārabbha kathaṃ katheyya: ",
  "kv15.3:7.12": "evaṃ hoti etarahi paccuppannanti. ",
  "kv15.3:7.13": "imāni kho bhikkhave, tīṇi kathāvatthunī”ti ",
  "kv15.3:7.14": "attheva suttanto’ti. ",
  "kv15.3:7.15": "āmantā. ",
  "kv15.3:7.16": "tena hi addhā parinipphanno’ti. ",
  "kv15.3:7.17": "addhākathā niṭṭhitā. "
}
