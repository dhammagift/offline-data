  "kv15.5:0.4": "15. 5. āsavakathā. ",
  "kv15.5:1.1": "cattāro āsavā anāsavā’ti. ",
  "kv15.5:1.2": "āmantā. ",
  "kv15.5:1.3": "maggo …pe… phalaṃ …pe… nibbānaṃ …pe… sotāpattimaggo …pe… sotāpattiphalaṃ …pe… bojjhaṅgo’ti. ",
  "kv15.5:1.4": "na hevaṃ vattabbe …pe… ",
  "kv15.5:2.1": "na vattabbaṃ: ",
  "kv15.5:2.2": "cattāro āsavā anāsavā’ti. ",
  "kv15.5:2.3": "āmantā. ",
  "kv15.5:2.4": "atthaññeva āsavā yehi āsavehi te āsavā sāsavā honti’ti. ",
  "kv15.5:2.5": "na hevaṃ vattabbe …pe… ",
  "kv15.5:2.6": "tena hi cattāro āsavā anāsavā’ti. ",
  "kv15.5:2.7": "āsavakathā niṭṭhitā. "
}
