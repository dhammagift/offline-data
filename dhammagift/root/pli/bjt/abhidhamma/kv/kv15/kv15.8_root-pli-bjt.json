  "kv15.8:0.4": "15. 8. dutiyasaññāvedayitakathā ",
  "kv15.8:1.1": "saññāvedayitanirodhasamāpatti lokiyā’ti. ",
  "kv15.8:1.2": "āmantā. ",
  "kv15.8:1.3": "rūpanti. ",
  "kv15.8:1.4": "na hevaṃ vattabbe …pe… ",
  "kv15.8:1.5": "vedanā …pe… ",
  "kv15.8:1.6": "saññā …pe… ",
  "kv15.8:1.7": "saṅkhārā …pe… ",
  "kv15.8:1.8": "viññāṇanti. ",
  "kv15.8:1.9": "na hevaṃ vattabbe …pe… ",
  "kv15.8:1.10": "kāmāvacarāti. ",
  "kv15.8:1.11": "na hevaṃ vattabbe …pe… ",
  "kv15.8:1.12": "rūpāvacarā’ti. ",
  "kv15.8:1.13": "na hevaṃ vattabbe …pe… ",
  "kv15.8:1.14": "arūpāvacarā’ti. ",
  "kv15.8:1.15": "na hevaṃ vattabbe …pe… ",
  "kv15.8:2.1": "na vattabbaṃ ",
  "kv15.8:2.2": "saññāvedayitanirodhasamāpatti lokiyā’ti. ",
  "kv15.8:2.3": "āmantā. ",
  "kv15.8:2.4": "lokuttarā’ti. ",
  "kv15.8:2.5": "na hevaṃ vattabbe …pe… ",
  "kv15.8:2.6": "tena hi lokiyā’ti. ",
  "kv15.8:2.7": "dutiyasaññāvedayitakathā niṭṭhitā. "
