  "dt2.8:0.1": "",
  "dt2.8:0.2": "",
  "dt2.8:0.3": "8. vippayuttena sampayutta pada niddeso ",
  "dt2.8:1.1": "rūpakkhandhena ye dhammā vippayuttā, te dhammā katīhi khandhehi katihāyatanehi katīhi dhātūhi sampayuttāti: ",
  "dt2.8:1.2": "natthī. ",
  "dt2.8:2.1": "vedanākkhandhena ye dhammā …pe… ",
  "dt2.8:2.2": "saññākkhandhena ye dhammā - ",
  "dt2.8:2.3": "saṅkhārakkhandhena ye dhammā - ",
  "dt2.8:2.4": "viññāṇakkhandhena ye dhammā - ",
  "dt2.8:2.5": "saraṇehi dhammehi ye dhammā - ",
  "dt2.8:2.6": "araṇehi dhammehi ye dhammā vippayuttā, te dhammā katihi khandhehi katihāyatanehi katīhi dhātūhi sampayuttāti: ",
  "dt2.8:2.7": "natthī. ",
  "dt2.8:3.1": "dhammāyatana dhammadhātu ",
  "dt2.8:3.2": "atha jīvita nāmarūpaṃ, ",
  "dt2.8:3.3": "saḷāyatanaṃ jāti jarā maraṇaṃ ",
  "dt2.8:3.4": "dve mātike na labbhare. ",
  "dt2.8:4.1": "paṭhamantare satta ca ",
  "dt2.8:4.2": "gocchake dasa aparante. ",
  "dt2.8:4.3": "cuddasa cha va matthake ",
  "dt2.8:4.4": "iccete sattacattāḷīsa dhammā, ",
  "dt2.8:4.5": "samucchede na labbhanti ",
  "dt2.8:4.6": "moghapucchakena ca. ",
  "dt2.8:5.1": "vippayuttena sampayutta pada niddeso niṭṭhito. "
}
