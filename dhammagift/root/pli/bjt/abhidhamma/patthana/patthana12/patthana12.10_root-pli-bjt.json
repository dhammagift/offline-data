  "patthana12.10:1.1": "dhammaṃ paṭicca-. ",
  "patthana12.10:2.1": "na āsavavippayuttaṃ na ",
  "patthana12.10:3.1": "anāsavaṃ na hetuṃ dhammaṃ paṭicca-. ",
  "patthana12.10:4.1": "no ",
  "patthana12.10:5.1": "saññojanaṃ na hetuṃ dhammaṃ paṭicca-. no ganthaṃ na hetuṃ dhammaṃ paṭicca-. ",
  "patthana12.10:6.1": "no ",
  "patthana12.10:7.1": "oghaṃ na hetuṃ dhammaṃ paṭicca-. ",
  "patthana12.10:8.1": "no ",
  "patthana12.10:9.1": "yogaṃ na hetuṃ dhammaṃ paṭicca-. no ",
  "patthana12.10:10.1": "nīvaraṇaṃ na hetuṃ "
}
