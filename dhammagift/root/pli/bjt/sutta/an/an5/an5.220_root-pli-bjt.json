{
  "an5.220:0.1": "",
  "an5.220:0.2": "",
  "an5.220:0.3": "5. 5. 2. 10. [madhurāsuttaṃ] ",
  "an5.220:1.1": "[sāvatthinidānaṃ] pañcime bhikkhave ādīnavā madhurāyaṃ. ",
  "an5.220:1.2": "katame pañca: ",
  "an5.220:1.3": "visamā, bahurajā, caṇḍasunakhā, vāḷayakkhā, dullabhapiṇḍā. ",
  "an5.220:1.4": "ime kho bhikkhave pañca ādīnavā madhurāyanti. ",
  "an5.220:1.5": "",
  "an5.220:1.6": "akkosakavaggo dutiyo. ",
  "an5.220:2.0": "tassuddānaṃ: ",
  "an5.220:2.1": "akkosabhaṇḍanasīlaṃ ",
  "an5.220:2.2": "bahubhāṇī dve akkhantiyo ",
  "an5.220:2.3": "apāsādikā dve vuttā ",
  "an5.220:2.4": "aggismiṃ madhurāya cā’ti. "
}
