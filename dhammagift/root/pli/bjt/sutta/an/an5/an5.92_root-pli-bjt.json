  "an5.92:0.3": "5. 2. 5. 2. [dutiyasampadāsuttaṃ] ",
  "an5.92:1.1": "[sāvatthinidānaṃ] pañcimā bhikkhave sampadā. ",
  "an5.92:1.2": "katamā pañca? ",
  "an5.92:1.3": "sīlasampadā samādhisampadā paññāsampadā vimuttisampadā. vimuttiñāṇadassanasampadā. ",
  "an5.92:1.4": "imā kho bhikkhave pañca sampadāti. ",
  "an5.92:1.5": ""
}
