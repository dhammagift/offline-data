  "an5.229:0.1": "",
  "an5.229:0.2": "",
  "an5.229:0.3": "5. 5. 3. 9. [paṭhamakaṇhasappasuttaṃ] ",
  "an5.229:1.1": "[sāvatthinidānaṃ] pañcime bhikkhave ādīnavā kaṇhasappe. ",
  "an5.229:1.2": "katame pañca: ",
  "an5.229:1.3": "asuci, duggandho, sabhīru, sappaṭibhayo, mittadubhī ",
  "an5.229:1.4": "ime kho bhikkhave pañca ādīnavā kaṇhasappe. ",
  "an5.229:2.1": "evameva kho bhikkhave pañcime ādīnavā mātugāme. ",
  "an5.229:2.2": "katame pañca: ",
  "an5.229:2.3": "asuci duggandho, sabhīru, sappaṭibhayo, mittadubhī. ",
  "an5.229:2.4": "ime kho bhikkhave pañca ādīnavā mātugāmeti. ",
  "an5.229:2.5": ""
}
