{
  "an5.42:0.1": "",
  "an5.42:0.2": "",
  "an5.42:0.3": "5. 1. 5. 2. [sappurisasuttaṃ] ",
  "an5.42:1.1": "[sāvatthinidānaṃ] sappuriso bhikkhave kule jāyamāno bahuno janassa atthāya hitāya sukhāya hoti. ",
  "an5.42:1.2": "mātāpitunnaṃ atthāya hitāya sukhāya hoti ",
  "an5.42:1.3": "puttadārassa atthāya hitāya sukhāya hoti. ",
  "an5.42:1.4": "dāsakammakaraporisassa atthāya hitāya sukhāya hoti. ",
  "an5.42:1.5": "mittāmaccānaṃ atthāya hitāya sukhāya hoti. ",
  "an5.42:1.6": "samaṇabrāhmaṇānaṃ atthāya hitāya sukhāya hoti. ",
  "an5.42:2.1": "seyyathāpi bhikkhave mahāmegho sabbasassāni sampādento bahuno janassa atthāya hitāya sukhāya hoti, ",
  "an5.42:2.2": "evameva kho bhikkhave sappuriso kule jāyamāno bahuno janassa atthāya hitāya sukhāya hoti: ",
  "an5.42:2.3": "mātāpitunnaṃ atthāya hitāya sukhāya hoti. ",
  "an5.42:2.4": "puttadārassa atthāya hitāya sukhāya hoti. ",
  "an5.42:2.5": "dāsakammakaraporisassa atthāya hitāya sukhāya hoti. ",
  "an5.42:2.6": "mittāmaccānaṃ atthāya hitāya sukhāya hoti. ",
  "an5.42:2.7": "samaṇabrāhmaṇānaṃ atthāya hitāya sukhāya hotīti. ",
  "an5.42:3.1": "hito bahunnaṃ paṭipajja bhoge ",
  "an5.42:3.2": "taṃ devatā rakkhati devaguttaṃ, ",
  "an5.42:3.3": "bahussutaṃ sīlavatūpapannaṃ ",
  "an5.42:3.4": "dhamme ṭhitaṃ na vijahāti kitti. ",
  "an5.42:4.1": "dhammaṭṭhaṃ sīlasampannaṃ ",
  "an5.42:4.2": "saccavādiṃ hirīmanaṃ, ",
  "an5.42:4.3": "nekkhaṃ jambonadasseva ",
  "an5.42:4.4": "ko taṃ ninditumarahati, ",
  "an5.42:4.5": "devāpi naṃ pasaṃsanti ",
  "an5.42:4.6": "brahmunāpi pasaṃsitoti. ",
  "an5.42:4.7": ""
}
