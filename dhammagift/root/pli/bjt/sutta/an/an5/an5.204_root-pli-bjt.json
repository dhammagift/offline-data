  "an5.204:0.3": "5. 5. 1. 4. [balasuttaṃ] ",
  "an5.204:1.1": "[sāvatthinidānaṃ] pañcimāni bhikkhave, balāni. ",
  "an5.204:1.2": "katamāni pañca: ",
  "an5.204:1.3": "saddhābalaṃ, hiribalaṃ, ottappabalaṃ, viriyabalaṃ, paññābalaṃ. ",
  "an5.204:1.4": "imāni kho bhikkhave, pañca balānīti. ",
  "an5.204:1.5": ""
}
