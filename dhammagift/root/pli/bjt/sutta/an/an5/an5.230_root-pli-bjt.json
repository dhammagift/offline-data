{
  "an5.230:0.1": "",
  "an5.230:0.2": "",
  "an5.230:0.3": "5. 5. 3. 10. [dutiyakaṇhasappasuttaṃ] ",
  "an5.230:1.1": "[sāvatthinidānaṃ] pañcime bhikkhave ādīnavā kaṇhasappe. ",
  "an5.230:1.2": "katame pañca: ",
  "an5.230:1.3": "kodhano, upanāhī, ghoraviso, dujīvho, mittadubhī. ",
  "an5.230:1.4": "ime kho bhikkhave pañca ādīnavā kaṇhasappe. ",
  "an5.230:2.1": "evameva kho bhikkhave pañca ādīnavā mātugāme. ",
  "an5.230:2.2": "katame pañca: ",
  "an5.230:2.3": "kodhano, upanāhī, ghoraviso, dujīvho, mittadubhī. ",
  "an5.230:2.4": "tatridaṃ bhikkhave mātugāmassa ghoravisatā: ",
  "an5.230:2.5": "yebhuyyena bhikkhave mātugāmo tibbarāgo. ",
  "an5.230:2.6": "tatridaṃ bhikkhave mātugāmassa dujīvhatā: ",
  "an5.230:2.7": "yebhuyyena bhikkhave mātugāmo pisunāvāco. ",
  "an5.230:2.8": "tatridaṃ bhikkhave mātugāmassa mittadubhitā: ",
  "an5.230:2.9": "yebhuyyena bhikkhave mātugāmo aticārinī. ",
  "an5.230:2.10": "ime kho bhikkhave pañca ādīnavā mātugāmeti. ",
  "an5.230:2.11": "",
  "an5.230:2.12": "dīghacārikavaggo tatiyo. ",
  "an5.230:3.0": "tassuddānaṃ: dīghacārikaṃ ",
  "an5.230:3.1": "dve vuttā ",
  "an5.230:3.2": "atinivāsamacchare, ",
  "an5.230:3.3": "dve ca kulūpagā bhogā ",
  "an5.230:3.4": "bhattaṃ sappāpare duveti. "
}
