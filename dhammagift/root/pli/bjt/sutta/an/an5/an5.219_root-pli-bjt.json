  "an5.219:0.3": "5. 5. 2. 9. [aggisuttaṃ] ",
  "an5.219:1.1": "[sāvatthinidānaṃ] pañcime bhikkhave ādīnavā aggismiṃ. ",
  "an5.219:1.2": "katame pañca: ",
  "an5.219:1.3": "acakkhusso, dubbaṇṇakaraṇo, dubbalakaraṇo, saṅgaṇikāpavaddhano, tiracchānakathāpavattaniko. ",
  "an5.219:1.4": "ime bhikkhave pañca: ādīnavā aggisminti. ",
  "an5.219:1.5": ""
}
