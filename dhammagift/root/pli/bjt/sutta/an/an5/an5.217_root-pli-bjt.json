{
  "an5.217:0.1": "",
  "an5.217:0.2": "",
  "an5.217:0.3": "5. 5. 2. 7. [paṭhamaapāsādika suttaṃ] ",
  "an5.217:1.1": "[sāvatthinidānaṃ] pañcime bhikkhave ādīnavā apāsādike. ",
  "an5.217:1.2": "katame pañca: ",
  "an5.217:1.3": "attāpi attānaṃ upavadati, ",
  "an5.217:1.4": "anuvicca viññū garahanti, ",
  "an5.217:1.5": "pāpako kittisaddo abbhuggacchati, ",
  "an5.217:1.6": "sammūḷho kālaṃ karoti, ",
  "an5.217:1.7": "kāyassa bhedā parammaraṇā apāyaṃ duggatiṃ vinipātaṃ nirayaṃ upapajjati. ",
  "an5.217:1.8": "ime kho bhikkhave pañca ādīnavā apāsādike. ",
  "an5.217:2.1": "pañcime bhikkhave pañca ādīnavā pāsādike ",
  "an5.217:2.2": "katame pañca: ",
  "an5.217:2.3": "attāpi attānaṃ na upavadati, ",
  "an5.217:2.4": "anuvicca viññū pasaṃsanti, ",
  "an5.217:2.5": "kalyāṇo kittisaddo abbhuggacchati, ",
  "an5.217:2.6": "asammūḷho kālaṃ karoti, ",
  "an5.217:2.7": "kāyassa bhedā parammaraṇā sugatiṃ saggaṃ lokaṃ upapajjati. ",
  "an5.217:2.8": "ime kho bhikkhave pañca ānisaṃsā pāsādiketi. ",
  "an5.217:2.9": ""
}
