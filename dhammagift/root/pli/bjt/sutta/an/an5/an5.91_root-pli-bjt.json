{
  "an5.91:0.1": "",
  "an5.91:0.2": "5. kakudhavaggo ",
  "an5.91:0.3": "5. 2. 5. 1. [paṭhamasampadāsuttaṃ] ",
  "an5.91:1.1": "[sāvatthinidānaṃ] pañcimā bhikkhave sampadā. ",
  "an5.91:1.2": "katamā pañca? ",
  "an5.91:1.3": "saddhāsampadā sīlasampadā sutasampadā cāgasampadā paññāsampadā. ",
  "an5.91:1.4": "imā kho bhikkhave pañca sampadāti. ",
  "an5.91:1.5": ""
}
