  "an5.13:0.1": "",
  "an5.13:0.2": "",
  "an5.13:0.3": "5. 1. 2. 3. [balasaṅkhittasuttaṃ] ",
  "an5.13:1.1": "pañcimāni bhikkhave balāni. ",
  "an5.13:1.2": "katamāni pañca: ",
  "an5.13:1.3": "saddhābalaṃ, viriyabalaṃ, satibalaṃ, samādhibalaṃ, paññābalaṃ. ",
  "an5.13:1.4": "imāni kho bhikkhave pañcabalānīti. ",
  "an5.13:1.5": ""
}
