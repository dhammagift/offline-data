{
  "an5.40:0.1": "",
  "an5.40:0.2": "",
  "an5.40:0.3": "5. 1. 4. 10. [mahāsālasuttaṃ] ",
  "an5.40:1.1": "himavantaṃ bhikkhave pabbatarājaṃ nissāya mahāsālā pañcahi vaḍḍhīhi vaḍḍhanti. ",
  "an5.40:1.2": "katamāhi pañcahi? ",
  "an5.40:1.3": "sākhāpattapalāsena vaḍḍhanti. ",
  "an5.40:1.4": "tacena vaḍḍhanti. ",
  "an5.40:1.5": "papaṭikāya vaḍḍhanti. ",
  "an5.40:1.6": "pheggunā vaḍḍhanti. ",
  "an5.40:1.7": "sārena vaḍḍhanti. ",
  "an5.40:1.8": "himavantaṃ bhikkhave pabbatarājaṃ nissāya mahāsālā imāhi pañcahi vaḍḍhīhi vaḍḍhanti. ",
  "an5.40:1.9": "evameva kho bhikkhave saddhaṃ kulapatiṃ nissāya antojano pañcahi vaḍḍhīhi vaḍḍhati. ",
  "an5.40:1.10": "katamāhi pañcahi? ",
  "an5.40:1.11": "saddhāya vaḍḍhati. ",
  "an5.40:1.12": "sīlena vaḍḍhati. ",
  "an5.40:1.13": "sutena vaḍḍhati. ",
  "an5.40:1.14": "cāgena vaḍḍhati. ",
  "an5.40:1.15": "paññāya vaḍḍhati. ",
  "an5.40:1.16": "saddhaṃ bhikkhave kulapatiṃ nissāya antojano imāhi pañcahi vaḍḍhīhi vaḍḍhatīti. ",
  "an5.40:2.1": "yathā ca pabbato selo ",
  "an5.40:2.2": "araññasmiṃ brahāvane, ",
  "an5.40:2.3": "taṃ rukkhā upanissāya ",
  "an5.40:2.4": "vaḍḍhante te vanappatī. ",
  "an5.40:3.1": "tatheva sīla sampannaṃ ",
  "an5.40:3.2": "saddhaṃ kulapatiṃ idha, ",
  "an5.40:3.3": "upanissāya vaḍḍhanti ",
  "an5.40:3.4": "puttadārā ca bandhavā, ",
  "an5.40:3.5": "amaccā ñātisaṅghā ca ",
  "an5.40:3.6": "ye cassa anujīvino. ",
  "an5.40:4.1": "tassa sīlavato sīlaṃ ",
  "an5.40:4.2": "cāgaṃ sucaritāni ca, ",
  "an5.40:4.3": "passamānānukubbanti ",
  "an5.40:4.4": "ye bhavanti civakkhaṇā. ",
  "an5.40:5.1": "idha dhammaṃ caritvāna ",
  "an5.40:5.2": "maggaṃ sugatigāminaṃ, ",
  "an5.40:5.3": "nandino devalokasmiṃ ",
  "an5.40:5.4": "modanti kāmakāminoti. ",
  "an5.40:5.5": "",
  "an5.40:5.6": "sumanāvaggo catuttho. ",
  "an5.40:6.0": "tassuddānaṃ: ",
  "an5.40:6.1": "sumanā cundī uggaho ",
  "an5.40:6.2": "sīhadānānisaṃsayo kāla ",
  "an5.40:6.3": "bhojana saddhāya ",
  "an5.40:6.4": "puttasālehi te dasāti. "
}
