  "an9.69:0.1": "",
  "an9.69:0.2": "",
  "an9.69:0.3": "9. 2. 2. 7. macchariya satipaṭṭhāna suttaṃ ",
  "an9.69:1.1": "[sāvatthinidānaṃ] pañcimāni bhikkhave macchariyāni. ",
  "an9.69:1.2": "katamāni pañca: ",
  "an9.69:1.3": "āvāsamacchariyaṃ, kulamacchariyaṃ, lābhamacchariyaṃ, vaṇṇamacchariyaṃ, dhammamacchariyaṃ. ",
  "an9.69:1.4": "imāni kho bhikkhave pañca macchariyāni. ",
  "an9.69:2.1": "imesaṃ kho bhikkhave, pañcannaṃ macchariyānaṃ pahānāya …pe… ime cattāro satipaṭṭhānā bhāvetabbāti. ",
  "an9.69:2.2": ""
}
