  "an9.66:0.1": "",
  "an9.66:0.2": "",
  "an9.66:0.3": "9. 2. 2. 4. upādānakkhandha satipaṭṭhāna suttaṃ ",
  "an9.66:1.1": "[sāvatthinidānaṃ] pañcime bhikkhave upādānakkhandhā. ",
  "an9.66:1.2": "katame pañca: ",
  "an9.66:1.3": "rūpūpādānakkhandho, vedanūpādānakkhandho, saññūpādānakkhandho, saṅkhārūpādānakkhandho, viññāṇupādānakkhandho. ",
  "an9.66:1.4": "ime kho bhikkhave, pañcupādānakkhandhā. ",
  "an9.66:2.1": "imesaṃ kho bhikkhave pañcannaṃ upādānakkhandhānaṃ pahānāya …pe… ime cattāro satipaṭṭhānā bhāvetabbāti. ",
  "an9.66:2.2": ""
}
