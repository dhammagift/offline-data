  "an9.70:0.1": "",
  "an9.70:0.2": "",
  "an9.70:0.3": "9. 2. 2. 8. uddhambhāgiya satipaṭṭhāna suttaṃ ",
  "an9.70:1.1": "[sāvatthinidānaṃ] pañcimāni bhikkhave, uddhambhāgiyāni saññojanāni, ",
  "an9.70:1.2": "katamāni pañca: ",
  "an9.70:1.3": "rūparāgo, arūparāgo, māno, uddhaccaṃ, avijjā. ",
  "an9.70:1.4": "imāni kho bhikkhave pañcuddhambhāgiyāni saññojanāti. ",
  "an9.70:2.1": "imesaṃ kho bhikkhave pañcannaṃ uddhambhāgiyānaṃ saññojanānaṃ pahānāya …pe… ime cattāro satipaṭṭhānā bhāvetabbāti. ",
  "an9.70:2.2": ""
}
