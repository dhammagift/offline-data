  "an9.68:0.1": "",
  "an9.68:0.2": "",
  "an9.68:0.3": "9. 2. 2. 6. gati satipaṭṭhāna suttaṃ ",
  "an9.68:1.1": "[sāvatthinidānaṃ] pañcimā bhikkhave gatiyo. ",
  "an9.68:1.2": "katame pañca: ",
  "an9.68:1.3": "nirayo, tiracchānayoni, pettivisayo, manussā, devā. ",
  "an9.68:1.4": "imā kho bhikkhave pañca gatiyo. ",
  "an9.68:2.1": "imāsaṃ kho bhikkhave pañcannaṃ gatīnaṃ pahānāya …pe… ime cattāro satipaṭṭhānā bhāvetabbāti. ",
  "an9.68:2.2": ""
}
