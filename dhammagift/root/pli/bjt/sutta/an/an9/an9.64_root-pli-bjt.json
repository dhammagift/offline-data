{
  "an9.64:0.1": "",
  "an9.64:0.2": "",
  "an9.64:0.3": "9. 2. 2. 2. nīvaraṇa satipaṭṭhāna suttaṃ ",
  "an9.64:1.1": "[sāvatthinidānaṃ] pañcimāni bhikkhave nīvaraṇāni. ",
  "an9.64:1.2": "katamāni pañca: ",
  "an9.64:1.3": "kāmacchandanīvaraṇaṃ, vyāpādanīvaraṇaṃ, thīnamiddhanīvaraṇaṃ, uddhaccakukkuccanīvaraṇaṃ, vicikicchānīvaraṇaṃ. ",
  "an9.64:1.4": "imāni kho bhikkhave pañca nīvaraṇāni. ",
  "an9.64:2.1": "imesaṃ kho bhikkhave pañcannaṃ nīvaraṇānaṃ pahānāya ",
  "an9.64:2.2": "",
  "an9.64:2.3": "",
  "an9.64:2.4": "…pe… ",
  "an9.64:2.5": "",
  "an9.64:2.6": "",
  "an9.64:2.7": "ime cattāro satipaṭṭhānā bhāvetabbāti. ",
  "an9.64:2.8": ""
}
