  "an9.67:0.1": "",
  "an9.67:0.2": "",
  "an9.67:0.3": "9. 2. 2. 5. orambhāgiya satipaṭṭhāna suttaṃ ",
  "an9.67:1.1": "[sāvatthinidānaṃ] pañcimāni bhikkhave orambhāgiyāni saññojanāni. ",
  "an9.67:1.2": "katamāni pañca: ",
  "an9.67:1.3": "sakkāyadiṭṭhi, vicikicchā, sīlabbataparāmāso, kāmacchando, byāpādo. ",
  "an9.67:1.4": "imāni kho bhikkhave pañcorambhāgiyāni saññojanāni. ",
  "an9.67:2.1": "imesaṃ kho bhikkhave pañcannaṃ orambhāgiyānaṃ saññojanānaṃ pahānāya …pe… ime cattāro satipaṭṭhānā bhāvetabbāti. ",
  "an9.67:2.2": ""
}
