  "an9.29:0.1": "",
  "an9.29:0.2": "",
  "an9.29:0.3": "9. 1. 3. 9. āghātavatthu suttaṃ ",
  "an9.29:1.1": "[sāvatthinidānaṃ] nava imāni bhikkhave āghātavatthūni, ",
  "an9.29:1.2": "katamāni nava: ",
  "an9.29:1.3": "anatthaṃ me acarīti āghātaṃ bandhati. ",
  "an9.29:1.4": "anatthaṃ me caratīti āghātaṃ bandhati, ",
  "an9.29:1.5": "anatthaṃ me carissatīti āghātaṃ bandhati. ",
  "an9.29:1.6": "piyassa me manāpassa anatthaṃ acari …pe… ",
  "an9.29:1.7": "anatthaṃ carati …pe… ",
  "an9.29:1.8": "anatthaṃ carissatīti āghātaṃ bandhati. ",
  "an9.29:1.9": "appiyassa me amanāpassa atthaṃ acari …pe… ",
  "an9.29:1.10": "atthaṃ carati …pe… ",
  "an9.29:1.11": "atthaṃ carissatīti āghātaṃ bandhati. ",
  "an9.29:1.12": "imāni kho bhikkhave nava āghātavatthūnīti. ",
  "an9.29:1.13": ""
}
