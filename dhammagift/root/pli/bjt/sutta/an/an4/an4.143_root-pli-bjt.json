{
  "an4.143:0.1": "",
  "an4.143:0.2": "",
  "an4.143:0.3": "4. 3. 5. 3. [ālokasuttaṃ] ",
  "an4.143:1.1": "cattārome bhikkhave ālokā. ",
  "an4.143:1.2": "katame cattāro? ",
  "an4.143:1.3": "candāloko, suriyāloko, aggāloko, paññāloko. ",
  "an4.143:1.4": "ime kho bhikkhave cattāro ālokā. ",
  "an4.143:1.5": "etadaggaṃ bhikkhave imesaṃ catunnaṃ ālokānaṃ yadidaṃ paññālokoti. ",
  "an4.143:1.6": ""
}
