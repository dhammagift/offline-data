  "an4.75:0.3": "4. 2. 3. 5. [dutiyaaggasuttaṃ] ",
  "an4.75:1.1": "cattārimāni bhikkhave aggāni. ",
  "an4.75:1.2": "katamāni cattāri? ",
  "an4.75:1.3": "rūpaggaṃ, vedanāggaṃ, saññaggaṃ, bhavaggaṃ. ",
  "an4.75:1.4": "imāni kho bhikkhave cattāri aggānīni. ",
  "an4.75:1.5": ""
}
