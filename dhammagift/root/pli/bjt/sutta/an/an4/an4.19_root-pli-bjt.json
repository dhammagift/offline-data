{
  "an4.19:0.1": "",
  "an4.19:0.2": "",
  "an4.19:0.3": "4. 1. 2. 9. [agatināgatisuttaṃ] ",
  "an4.19:1.1": "cattārimāni bhikkhave, agatigamanāni. ",
  "an4.19:1.2": "katamāni cattāri? ",
  "an4.19:1.3": "chandāgatiṃ gacchati. dosāgatiṃ gacchati. mohāgatiṃ gacchati. bhayāgatiṃ gacchati. ",
  "an4.19:1.4": "imāni kho bhikkhave, cattāri agatigamanānīti. ",
  "an4.19:2.1": "cattārimāni bhikkhave, nāgatigamanāni. ",
  "an4.19:2.2": "katamāni cattāri? ",
  "an4.19:2.3": "na chandāgatiṃ gacchati. na dosāgatiṃ gacchati. na mohāgatiṃ gacchati. na bhayāgatiṃ gacchati. ",
  "an4.19:2.4": "imāni kho bhikkhave, cattāri nāgatigamanānīti. ",
  "an4.19:3.1": "chandā dosā bhayā mohā ",
  "an4.19:3.2": "yo dhammaṃ ativattati, ",
  "an4.19:3.3": "nihīyati tassa yaso ",
  "an4.19:3.4": "kālapakkheva candimā’ti. ",
  "an4.19:4.1": "chandā dosā bhayā mohā ",
  "an4.19:4.2": "yo dhammaṃ nātivattati, ",
  "an4.19:4.3": "āpūrati tassa yaso ",
  "an4.19:4.4": "sukkapakkheva candimā’ti. ",
  "an4.19:4.5": ""
}
