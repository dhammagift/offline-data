{
  "an4.154:0.1": "",
  "an4.154:0.2": "",
  "an4.154:0.3": "4. 4. 1. 4. [tatiyabalasuttaṃ] ",
  "an4.154:1.1": "cattārimāni bhikkhave balāni. ",
  "an4.154:1.2": "katamāni cattāri? ",
  "an4.154:1.3": "satibalaṃ, samādhibalaṃ, anavajjabalaṃ, saṃgāhabalaṃ. ",
  "an4.154:1.4": "imāni kho bhikkhave cattāri balānīti. ",
  "an4.154:1.5": ""
}
