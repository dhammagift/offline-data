{
  "an4.119:0.1": "",
  "an4.119:0.2": "",
  "an4.119:0.3": "4. 3. 2. 9. [bhayasuttaṃ] ",
  "an4.119:1.1": "cattārimāni bhikkhave bhayāni. ",
  "an4.119:1.2": "katamāni cattāri? ",
  "an4.119:1.3": "jātibhayaṃ jarābhayaṃ vyādhibhayaṃ maraṇabhayaṃ. ",
  "an4.119:1.4": "imāni kho bhikkhave cattāri bhayānīti. ",
  "an4.119:1.5": ""
}
