  "an4.261:0.3": "4. 6. 8. [balasuttaṃ] ",
  "an4.261:1.1": "cattārimāni bhikkhave balāni. ",
  "an4.261:1.2": "katamāni cattāri? ",
  "an4.261:1.3": "viriyabalaṃ satibalaṃ samādhibalaṃ paññābalaṃ. ",
  "an4.261:1.4": "imāni kho bhikkhave cattāri balānīti. ",
  "an4.261:1.5": ""
}
