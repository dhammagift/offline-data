{
  "an4.132:0.1": "",
  "an4.132:0.2": "",
  "an4.132:0.3": "4. 3. 4. 2. [paṭibhānapuggalasuttaṃ] ",
  "an4.132:1.1": "cattārome bhikkhave puggalā santo saṃvijjamānā lokasmiṃ. ",
  "an4.132:1.2": "katame cattāro? ",
  "an4.132:1.3": "yuttapaṭibhāno na muttapaṭibhāno, ",
  "an4.132:1.4": "muttapaṭibhāno na yuttapaṭibhāno, ",
  "an4.132:1.5": "yuttapaṭibhāno ca muttapaṭibhāno ca, ",
  "an4.132:1.6": "neva yuttapaṭibhāno neva muttapaṭibhāno. ",
  "an4.132:1.7": "ime kho bhikkhave cattāro puggalā santo saṃvijjamānā lokasminti. ",
  "an4.132:1.8": ""
}
