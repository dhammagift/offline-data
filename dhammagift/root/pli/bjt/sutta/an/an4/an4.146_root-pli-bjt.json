  "an4.146:0.3": "4. 3. 5. 6. [kālasuttaṃ] ",
  "an4.146:1.1": "cattārome bhikkhave kālā. ",
  "an4.146:1.2": "katame cattāro? ",
  "an4.146:1.3": "kālena dhammassavaṇaṃ, kālena dhammasākacchā, kālena samatho, kālena vipassanā. ",
  "an4.146:1.4": "ime kho bhikkhave cattāro kālāti. ",
  "an4.146:1.5": ""
}
