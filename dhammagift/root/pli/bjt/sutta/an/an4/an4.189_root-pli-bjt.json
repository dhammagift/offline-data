{
  "an4.189:0.1": "",
  "an4.189:0.2": "",
  "an4.189:0.3": "4. 4. 4. 9. [sacchikaraṇīya suttaṃ] ",
  "an4.189:1.1": "[sāvatthinidānaṃ] cattārome bhikkhave sacchikaraṇīyā dhammā. ",
  "an4.189:1.2": "katame cattāro? ",
  "an4.189:1.3": "atthi bhikkhave dhammā kāyena sacchikaraṇīyā. ",
  "an4.189:1.4": "atthi bhikkhave dhammā satiyā sacchikaraṇīyā. ",
  "an4.189:1.5": "atthi bhikkhave dhammā cakkhunā sacchikaraṇīyā. ",
  "an4.189:1.6": "atthi bhikkhave dhammā paññāya sacchikaraṇīyā. ",
  "an4.189:1.7": "katame ca bhikkhave dhammā kāyena sacchikaraṇīyā. ",
  "an4.189:1.8": "aṭṭha vimokkhā bhikkhave kāyena sacchikaraṇīyā. ",
  "an4.189:2.1": "katame ca bhikkhave dhammā satiyā sacchikaraṇīyā? ",
  "an4.189:2.2": "pubbenivāso bhikkhave satiyā sacchikaraṇīyo. ",
  "an4.189:3.1": "katame ca bhikkhave dhammā cakkhunā sacchikaraṇīyā? ",
  "an4.189:3.2": "sattānaṃ cutūpapāto bhikkhave cakkhunā sacchikaraṇīyo. ",
  "an4.189:4.1": "katame ca bhikkhave dhammā paññāya sacchikaraṇīyā? ",
  "an4.189:4.2": "āsavānaṃ khayo bhikkhave paññāya sacchikaraṇīyo. ",
  "an4.189:4.3": "ime kho bhikkhave cattāro sacchikaraṇīyā dhammāti. ",
  "an4.189:4.4": ""
}
