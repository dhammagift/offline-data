{
  "an4.66:0.1": "",
  "an4.66:0.2": "",
  "an4.66:0.3": "4. 2. 2. 6. [sarāga (puggala) suttaṃ] ",
  "an4.66:1.1": "cattāro’me bhikkhave puggalā santo saṃvijjamānā lokasmiṃ. ",
  "an4.66:1.2": "katame cattāro? ",
  "an4.66:1.3": "sarāgo, sadoso, samoho, samāno. ",
  "an4.66:1.4": "ime kho bhikkhave cattāro puggalā santo saṃvijjamānā lokasminti. ",
  "an4.66:2.1": "sārattā rajanīyesu ",
  "an4.66:2.2": "piyarūpābhinandino, ",
  "an4.66:2.3": "mohena adhamā sattā ",
  "an4.66:2.4": "baddhā vaḍḍhenti bandhanaṃ. ",
  "an4.66:3.1": "rāgajañca dosajañca ",
  "an4.66:3.2": "mohajañcācāpaviddasu. karonti ",
  "an4.66:3.3": "akusalaṃ kammaṃ ",
  "an4.66:3.4": "savighātaṃ dukhudrayaṃ. ",
  "an4.66:4.1": "avijjānivutā posā ",
  "an4.66:4.2": "andhabhūtā acakkhukā, ",
  "an4.66:4.3": "yathā dhammā tathā santā ",
  "an4.66:4.4": "na nassevanti na maññareti. ",
  "an4.66:4.5": ""
}
