  "an4.256:0.3": "4. 6. 3. [saṅgahavatthusuttaṃ] ",
  "an4.256:1.1": "cattārimāni bhikkhave saṅgahavatthūni. ",
  "an4.256:1.2": "katamāni cattāri? ",
  "an4.256:1.3": "dānaṃ, peyyavajjaṃ, atthacariyā, samānattatā. ",
  "an4.256:1.4": "imāni kho bhikkhave cattāri saṅgahavatthūnīti. ",
  "an4.256:1.5": ""
}
