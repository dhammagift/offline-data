  "an4.148:0.3": "4. 3. 5. 8. [vacīduccaritasuttaṃ] ",
  "an4.148:1.1": "cattārimāni bhikkhave vacīduccaritāni. ",
  "an4.148:1.2": "katamāni cattāri? ",
  "an4.148:1.3": "musāvādo, pisunāvācā, pharusāvācā, samphappalāpo. ",
  "an4.148:1.4": "imāni kho bhikkhave cattāri vacīduccaritāni. ",
  "an4.148:1.5": ""
}
