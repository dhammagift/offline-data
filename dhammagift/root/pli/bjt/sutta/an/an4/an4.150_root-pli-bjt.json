{
  "an4.150:0.1": "",
  "an4.150:0.2": "",
  "an4.150:0.3": "4. 3. 5. 10. [sārasuttaṃ] ",
  "an4.150:1.1": "cattārome bhikkhave sārā. ",
  "an4.150:1.2": "katame cattāro? ",
  "an4.150:1.3": "sīlasāro, samādhisāro, paññāsāro, vimuttisāro. ",
  "an4.150:1.4": "ime kho bhikkhave cattāro sārāti. ",
  "an4.150:1.5": "",
  "an4.150:1.6": "ābhāvaggo pañcamo. ",
  "an4.150:2.0": "",
  "an4.150:2.1": "",
  "an4.150:2.2": "",
  "an4.150:2.3": "",
  "an4.150:2.4": "",
  "an4.150:2.5": "tatiyo paṇṇāsako. "
}
