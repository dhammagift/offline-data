{
  "an4.151:0.1": "tatiyo paṇṇāsako. 4. catuttho paṇṇāsako ",
  "an4.151:0.2": "1. indriyavaggo ",
  "an4.151:0.3": "4. 4. 1. 1. [indriyasuttaṃ] ",
  "an4.151:1.1": "[sāvatthinidānaṃ] cattārimāni bhikkhave indriyāni. ",
  "an4.151:1.2": "katamāni cattāri? ",
  "an4.151:1.3": "saddhindriyaṃ, viriyindriyaṃ, satindriyaṃ, samādhindriyaṃ. ",
  "an4.151:1.4": "imāni kho bhikkhave cattāri indriyānīti. ",
  "an4.151:1.5": ""
}
