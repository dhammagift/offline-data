{
  "an4.221:0.1": "",
  "an4.221:0.2": "3. sucaritavaggo ",
  "an4.221:0.3": "4. 5. 3. 1. [vacīsucaritasuttaṃ] ",
  "an4.221:1.1": "[sāvatthinidānaṃ] cattārimāni bhikkhave vacīduccaritāni. ",
  "an4.221:1.2": "katamāni cattāri? ",
  "an4.221:1.3": "musāvādo, pisuṇāvācā, pharusāvācā, samphappalāpo. ",
  "an4.221:1.4": "imāni kho bhikkhave cattāri vacīduccaritāni. ",
  "an4.221:1.5": "cattārimāni bhikkhave vacīsucaritāni. ",
  "an4.221:1.6": "katamāni cattāri? ",
  "an4.221:1.7": "saccavācā, apisuṇāvācā, saṇhavācā, mattābhassaṃ. ",
  "an4.221:1.8": "imāni kho bhikkhave cattāri vacīsucaritāni. ",
  "an4.221:1.9": ""
}
