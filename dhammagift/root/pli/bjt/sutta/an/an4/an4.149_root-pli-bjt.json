  "an4.149:0.3": "4. 3. 5. 9. [vacīsucaritasuttaṃ] ",
  "an4.149:1.1": "cattārimāni bhikkhave vacīsucaritāni. ",
  "an4.149:1.2": "katamāni cattāri? ",
  "an4.149:1.3": "saccavācā, apisunavācā, saṇhavācā, mantābhāsā. ",
  "an4.149:1.4": "imāni kho bhikkhave cattāri vacīsucaritānīti. ",
  "an4.149:1.5": ""
}
