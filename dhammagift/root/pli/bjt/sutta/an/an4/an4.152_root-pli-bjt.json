  "an4.152:0.1": "",
  "an4.152:0.2": "",
  "an4.152:0.3": "4. 4. 1. 2. [balasuttaṃ] ",
  "an4.152:1.1": "cattārimāni bhikkhave balāni. ",
  "an4.152:1.2": "katamāni cattāri? ",
  "an4.152:1.3": "saddhābalaṃ, viriyabalaṃ, satibalaṃ, samādhibalaṃ. ",
  "an4.152:1.4": "imāni kho bhikkhave cattāri balānīti. ",
  "an4.152:1.5": ""
}
