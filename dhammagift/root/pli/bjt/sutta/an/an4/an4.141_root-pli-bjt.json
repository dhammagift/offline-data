{
  "an4.141:0.1": "",
  "an4.141:0.2": "5. ābhāvaggo ",
  "an4.141:0.3": "4. 3. 5. 1. [ābhāsuttaṃ] ",
  "an4.141:1.1": "[sāvatthinidānaṃ] catasso imā bhikkhave ābhā. ",
  "an4.141:1.2": "katamā catasso? ",
  "an4.141:1.3": "candābhā, sūriyābhā, aggābhā, paññābhā. ",
  "an4.141:1.4": "imā kho bhikkhave catasso ābhā. ",
  "an4.141:1.5": "etadaggaṃ bhikkhave imāsaṃ catassannaṃ ābhānaṃ yadidaṃ paññābhāti. ",
  "an4.141:1.6": ""
}
