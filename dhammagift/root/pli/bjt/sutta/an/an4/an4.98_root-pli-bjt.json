{
  "an4.98:0.1": "",
  "an4.98:0.2": "",
  "an4.98:0.3": "4. 2. 5. 8. [attahitasuttaṃ] ",
  "an4.98:1.1": "cattāro’me bhikkhave puggalā santo saṃvijjamānā lokasmiṃ. ",
  "an4.98:1.2": "katame cattāro? ",
  "an4.98:1.3": "attahitāya paṭipanno no parahitāya ",
  "an4.98:1.4": "parahitāya paṭipanno no attahitāya. ",
  "an4.98:1.5": "nevattahitāya paṭipanno no parahitāya. ",
  "an4.98:1.6": "attahitāya ca paṭipanno parahitāya ca. ",
  "an4.98:1.7": "ime kho bhikkhave cattāro puggalā santo saṃvijjamānā lokasminti. ",
  "an4.98:1.8": ""
}
