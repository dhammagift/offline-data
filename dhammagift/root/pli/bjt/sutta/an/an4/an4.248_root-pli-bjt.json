  "an4.248:0.1": "",
  "an4.248:0.2": "",
  "an4.248:0.3": "4. 5. 5. 6. [paññāvuddhi suttaṃ] ",
  "an4.248:1.1": "cattārome bhikkhave dhammā paññāvuddhiyā saṃvattantī. ",
  "an4.248:1.2": "katame cattāro? ",
  "an4.248:1.3": "sappurisasaṃsevo, saddhammasavaṇaṃ, yoniso manasikāro, dhammānudhammapaṭipatti. ",
  "an4.248:1.4": "ime kho bhikkhave cattāro dhammā paññāvuddhiyā saṃvattantīti. ",
  "an4.248:1.5": ""
}
