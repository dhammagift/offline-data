{
  "an4.145:0.1": "",
  "an4.145:0.2": "",
  "an4.145:0.3": "4. 3. 5. 5. [pajjotasuttaṃ] ",
  "an4.145:1.1": "cattārome bhikkhave pajjotā. ",
  "an4.145:1.2": "katame cattāro? ",
  "an4.145:1.3": "candapajjoto, suriyapajjoto, aggipajjoto, paññāpajjoto. ",
  "an4.145:1.4": "ime kho bhikkhave cattāro pajjotā. ",
  "an4.145:1.5": "etadaggaṃ bhikkhave imesaṃ catunnaṃ pajjotānaṃ yadidaṃ paññāpajjototi. ",
  "an4.145:1.6": ""
}
