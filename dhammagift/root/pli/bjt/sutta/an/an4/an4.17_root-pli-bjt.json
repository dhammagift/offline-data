{
  "an4.17:0.1": "",
  "an4.17:0.2": "",
  "an4.17:0.3": "4. 1. 2. 7. [agatisuttaṃ] ",
  "an4.17:1.1": "cattārimāni bhikkhave, agatigamanāni. ",
  "an4.17:1.2": "katamāni cattāri? ",
  "an4.17:1.3": "chandāgatiṃ gacchati. dosāgatiṃ gacchati. mohāgatiṃ gacchati. bhayāgatiṃ gacchati. ",
  "an4.17:1.4": "imāni kho bhikkhave, cattāri agatigamanānīti. ",
  "an4.17:2.1": "chandā dosā bhayā mohā ",
  "an4.17:2.2": "yo dhammaṃ ativattati, ",
  "an4.17:2.3": "nihīyati tassa yaso ",
  "an4.17:2.4": "kālapakkheva candimā’ti. ",
  "an4.17:2.5": ""
}
