{
  "an4.56:0.1": "",
  "an4.56:0.2": "",
  "an4.56:0.3": "4. 2. 1. 6. [dutiya (nakula) samajīvīsuttaṃ] ",
  "an4.56:1.1": "ākaṅkheyyuṃ ce bhikkhave, ubho jānipatayo diṭṭhe ceva dhamme aññamaññaṃ passituṃ abhisamparāyañca aññamaññaṃ passituṃ. ubho va assu samasaddhā samasīlā samacāgā samapaññā. te diṭṭhe ceva dhamme aññamaññaṃ passanti, abhisamparāyañca aññamaññaṃ passantīti. ",
  "an4.56:2.1": "ubho saddhā vadaññū ca ",
  "an4.56:2.2": "saññatā dhammajīvino, ",
  "an4.56:2.3": "te honti jānipatayo ",
  "an4.56:2.4": "aññamaññaṃ piyaṃvadā. ",
  "an4.56:3.1": "atthā sampacurā honti ",
  "an4.56:3.2": "phāsatthaṃ upajāyati, ",
  "an4.56:3.3": "amittā dummanā honti ",
  "an4.56:3.4": "ubhinnaṃ samasīlinaṃ. ",
  "an4.56:4.1": "idha dhammaṃ caritvāna ",
  "an4.56:4.2": "samasīlabbatā ubho, ",
  "an4.56:4.3": "nandino devalokasmiṃ ",
  "an4.56:4.4": "modanti kāmakāminoti. ",
  "an4.56:4.5": ""
}
