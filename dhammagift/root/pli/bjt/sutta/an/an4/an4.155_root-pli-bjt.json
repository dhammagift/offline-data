{
  "an4.155:0.1": "",
  "an4.155:0.2": "",
  "an4.155:0.3": "4. 4. 1. 5. [catuttha balasuttaṃ] ",
  "an4.155:1.1": "cattārimāni bhikkhave balāni. ",
  "an4.155:1.2": "katamāni cattāri? ",
  "an4.155:1.3": "paṭisaṅkhānabalaṃ, bhāvanābalaṃ, anavajjabalaṃ, saṅgāhabalaṃ. ",
  "an4.155:1.4": "imāni kho bhikkhave cattāri balānīti. ",
  "an4.155:1.5": ""
}
