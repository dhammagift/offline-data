{
  "an4.153:0.1": "",
  "an4.153:0.2": "",
  "an4.153:0.3": "4. 4. 1. 3. [dutiyabalasuttaṃ] ",
  "an4.153:1.1": "cattārimāni bhikkhave balāni. ",
  "an4.153:1.2": "katamāni cattāri? ",
  "an4.153:1.3": "paññābalaṃ viriyabalaṃ anavajjabalaṃ, saṃgāhabalaṃ. ",
  "an4.153:1.4": "imāni kho bhikkhave cattāri balānīti. ",
  "an4.153:1.5": ""
}
