{
  "an4.74:0.1": "",
  "an4.74:0.2": "",
  "an4.74:0.3": "4. 2. 3. 4. [paṭhamaaggasuttaṃ] ",
  "an4.74:1.1": "cattārimāni bhikkhave aggāni. ",
  "an4.74:1.2": "katamāni cattāri? ",
  "an4.74:1.3": "sīlaggaṃ samādhaggaṃ, paññaggaṃ, vimuttaggaṃ. ",
  "an4.74:1.4": "imāni kho bhikkhave cattāri aggānīti. ",
  "an4.74:1.5": ""
}
