{
  "an4.42:0.1": "",
  "an4.42:0.2": "",
  "an4.42:0.3": "4. 1. 5. 2. [pañhavyākaraṇa suttaṃ] ",
  "an4.42:1.1": "cattārimāni bhikkhave, pañhavyākaraṇāni ",
  "an4.42:1.2": "katamāni cattāri: ",
  "an4.42:1.3": "atthi bhikkhave, pañho ekaṃsavyākaraṇīyo, ",
  "an4.42:1.4": "atthi bhikkhave, pañho vibhajja vyākaraṇīyo, ",
  "an4.42:1.5": "atthi bhikkhave, pañho paṭipucchā vyākaraṇīyo, ",
  "an4.42:1.6": "atthi bhikkhave, pañho ṭhapanīyo. ",
  "an4.42:1.7": "imāni kho bhikkhave, cattāri pañhavyākaraṇānīti. ",
  "an4.42:2.1": "ekaṃsavacanaṃ ekaṃ ",
  "an4.42:2.2": "vibhajjavacanāparaṃ, ",
  "an4.42:2.3": "tatiyaṃ paṭipuccheyya ",
  "an4.42:2.4": "catutthaṃ pana ṭhāpaye. ",
  "an4.42:3.1": "yo ca nesaṃ tattha tattha ",
  "an4.42:3.2": "jānāti anudhammataṃ, ",
  "an4.42:3.3": "catupañhassa kusalo ",
  "an4.42:3.4": "āhu bhikkhuṃ tathāvidhaṃ. ",
  "an4.42:4.1": "durāsado duppasaho ",
  "an4.42:4.2": "gambhīro duppadhaṃsiyo ",
  "an4.42:4.3": "atho atthe anatthe ca ",
  "an4.42:4.4": "ubhayassa hoti kovido. ",
  "an4.42:5.1": "anatthaṃ parivajjeti ",
  "an4.42:5.2": "atthaṃ gaṇhāti paṇḍito, ",
  "an4.42:5.3": "atthābhisamayā dhīro ",
  "an4.42:5.4": "paṇḍitoti pavuccatīti. ",
  "an4.42:5.5": ""
}
