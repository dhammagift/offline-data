{
  "an10.145:0.1": "",
  "an10.145:0.2": "5. ariyavaggo ",
  "an10.145:0.3": "10. 3. 5. 1. ariyamagga suttaṃ ",
  "an10.145:1.1": "ariyamaggañca vo bhikkhave desissāmi, anariyamaggañca. ",
  "an10.145:1.2": "taṃ suṇātha …pe… ",
  "an10.145:1.3": "katamo ca bhikkhave anariyamaggo: ",
  "an10.145:1.4": "micchādiṭṭhi …pe… micchāvimutti. ",
  "an10.145:1.5": "ayaṃ vuccati bhikkhave anariyo maggo. ",
  "an10.145:1.6": "katamo ca bhikkhave ariyo maggo: ",
  "an10.145:1.7": "sammādiṭṭhi …pe… sammāvimutti. ",
  "an10.145:1.8": "ayaṃ vuccati bhikkhave ariyo maggoti. ",
  "an10.145:1.9": ""
}
