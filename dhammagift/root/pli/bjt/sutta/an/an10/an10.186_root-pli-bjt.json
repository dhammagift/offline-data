{
  "an10.186:0.1": "",
  "an10.186:0.2": "",
  "an10.186:0.3": "10. 4. 3. 9. ācayagāmī suttaṃ ",
  "an10.186:1.1": "ācayagāmiñca vo bhikkhave dhammaṃ desissāmi, apacayagāmiñca. ",
  "an10.186:1.2": "taṃ suṇātha …pe… ",
  "an10.186:1.3": "katamo ca bhikkhave ācayagāmī dhammo: ",
  "an10.186:1.4": "pāṇātipāto …pe… ",
  "an10.186:1.5": "micchādiṭṭhi. ",
  "an10.186:1.6": "ayaṃ vuccati bhikkhave ācayagāmī dhammo. ",
  "an10.186:2.1": "katamo ca bhikkhave apacayagāmī dhammo: ",
  "an10.186:2.2": "pāṇātipātā veramaṇī …pe… ",
  "an10.186:2.3": "sammādiṭṭhi. ",
  "an10.186:2.4": "ayaṃ vuccati bhikkhave apacayagāmī dhammo ",
  "an10.186:2.5": "ti. "
}
