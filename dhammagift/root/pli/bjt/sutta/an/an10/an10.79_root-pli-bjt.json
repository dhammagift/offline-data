  "an10.79:0.1": "",
  "an10.79:0.2": "",
  "an10.79:0.3": "10. 2. 3. 9. āghātavatthu suttaṃ ",
  "an10.79:1.1": "[sāvatthi] dasa imāni bhikkhave āghātavatthūni. ",
  "an10.79:1.2": "katamāni dasa: ",
  "an10.79:1.3": "anatthamme acarīti āghātaṃ bandhati, ",
  "an10.79:1.4": "anatthamme caratīti āghātaṃ bandhati, ",
  "an10.79:1.5": "anatthamme carissatīti āghātaṃ bandhati. ",
  "an10.79:1.6": "piyassa me manāpassa anatthaṃ acarīti …pe… ",
  "an10.79:1.7": "anatthaṃ caratīti …pe… ",
  "an10.79:1.8": "anatthaṃ carissatīti āghātaṃ bandhati. ",
  "an10.79:1.9": "appiyassa me amanāpassa atthaṃ acari …pe… ",
  "an10.79:1.10": "atthaṃ carati …pe… ",
  "an10.79:1.11": "atthaṃ carissatīti āghātaṃ bandhati, ",
  "an10.79:1.12": "aṭṭhāne ca kuppati. ",
  "an10.79:1.13": "imāni kho bhikkhave dasa āghātavatthūnīti. ",
  "an10.79:1.14": ""
}
