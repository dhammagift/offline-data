{
  "an10.140:0.1": "",
  "an10.140:0.2": "",
  "an10.140:0.3": "10. 3. 4. 7. sāvajja suttaṃ ",
  "an10.140:1.1": "sāvajjañca kho bhikkhave dhammaṃ desissāmi, anavajjañca. ",
  "an10.140:1.2": "taṃ suṇātha …pe… ",
  "an10.140:1.3": "katamo ca bhikkhave sāvajjo dhammo: ",
  "an10.140:1.4": "micchādiṭṭhi …pe… micchāvimutti. ",
  "an10.140:1.5": "ayaṃ vuccati bhikkhave sāvajjo dhammo. ",
  "an10.140:1.6": "katamo ca bhikkhave anavajjo dhammo: ",
  "an10.140:1.7": "sammādiṭṭhi …pe… sammāvimutti. ",
  "an10.140:1.8": "ayaṃ vuccati bhikkhave anavajjo dhammoti. ",
  "an10.140:1.9": ""
}
