  "an10.168:0.1": "",
  "an10.168:0.2": "",
  "an10.168:0.3": "10. 4. 2. 2. ariyapaccorohaṇī suttaṃ ",
  "an10.168:1.1": "ariyaṃ vo bhikkhave paccorohaṇiṃ desissāmi, ",
  "an10.168:1.2": "taṃ suṇātha …pe… ",
  "an10.168:1.3": "",
  "an10.168:1.4": "bhagavā etadavoca: ",
  "an10.168:2.1": "",
  "an10.168:2.2": "idha bhikkhave ariyasāvako iti paṭisañcikkhati, ",
  "an10.168:2.3": "pāṇātipātassa kho pāpako vipāko ",
  "an10.168:2.4": "diṭṭhe ceva dhamme abhisamparāyañcāti. ",
  "an10.168:2.5": "so iti paṭisaṅkhāya pāṇātipātaṃ pajahati. ",
  "an10.168:2.6": "pāṇātipātā paccorohati ",
  "an10.168:3.1": "",
  "an10.168:3.2": "",
  "an10.168:3.3": "",
  "an10.168:3.4": "",
  "an10.168:4.1": "…pe… ",
  "an10.168:4.2": "",
  "an10.168:5.1": "",
  "an10.168:5.2": "",
  "an10.168:6.1": "",
  "an10.168:6.2": "",
  "an10.168:7.1": "",
  "an10.168:7.2": "",
  "an10.168:8.1": "",
  "an10.168:8.2": "",
  "an10.168:9.1": "",
  "an10.168:9.2": "",
  "an10.168:10.1": "",
  "an10.168:10.2": "",
  "an10.168:11.1": "micchādiṭṭhiyā kho pāpako vipāko diṭṭhe ceva dhamme abhisamparāyañcāti. ",
  "an10.168:11.2": "so iti paṭisaṅkhāya micchādiṭṭhiṃ pajahati, ",
  "an10.168:11.3": "micchādiṭṭhiyā paccorohati. ",
  "an10.168:11.4": "ayaṃ vuccati bhikkhave ariyā paccorohaṇīti. ",
  "an10.168:11.5": ""
}
