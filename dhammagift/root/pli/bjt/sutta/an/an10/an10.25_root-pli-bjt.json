{
  "an10.25:0.1": "",
  "an10.25:0.2": "",
  "an10.25:0.3": "10. 1. 3. 5. kasiṇa suttaṃ ",
  "an10.25:1.1": "dasa imāni bhikkhave kasiṇāyatanāni, ",
  "an10.25:1.2": "katamāni dasa: ",
  "an10.25:1.3": "paṭhavikasiṇameko sañjānāti uddhaṃ adho tiriyaṃ advayaṃ appamāṇaṃ. ",
  "an10.25:1.4": "āpokasiṇameko sañjānāti …pe… ",
  "an10.25:1.5": "tejokasiṇameko sañjānāti …pe… ",
  "an10.25:1.6": "vāyokasiṇameko sañjānāti …pe… ",
  "an10.25:1.7": "nīlakasiṇameko sañjānāti …pe… ",
  "an10.25:1.8": "pītakasiṇameko sañjānāti ",
  "an10.25:1.9": "…pe… lohitakasiṇa meko sañjānāti …pe… ",
  "an10.25:1.10": "odātakasiṇameko sañjānāti …pe… ",
  "an10.25:1.11": "ākāsakasiṇameko sañjānāti …pe… ",
  "an10.25:1.12": "viññāṇakasiṇameko sañjānāti uddhaṃ adho tiriyaṃ advayaṃ appamāṇaṃ. ",
  "an10.25:1.13": "imāni kho bhikkhave dasa kasiṇāyatanānīti. ",
  "an10.25:1.14": ""
}
