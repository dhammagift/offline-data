{
  "an10.213:0.1": "",
  "an10.213:0.2": "",
  "an10.213:0.3": "10. 5. 1. 3. mātugāma suttaṃ ",
  "an10.213:1.1": "dasahi bhikkhave dhammehi samannāgato mātugāmo yathābhataṃ nikkhitto evaṃ niraye. ",
  "an10.213:1.2": "katamehi dasahi: ",
  "an10.213:1.3": "pāṇātipātī hoti ",
  "an10.213:1.4": "adinnādāyī hoti, ",
  "an10.213:1.5": "kāmesu micchācārī hoti, ",
  "an10.213:1.6": "musāvādī hoti, ",
  "an10.213:1.7": "pisunā vāco hoti, ",
  "an10.213:1.8": "pharusā vāco hoti, ",
  "an10.213:1.9": "samphappalāpī hoti, ",
  "an10.213:1.10": "abhijjhālū hoti, ",
  "an10.213:1.11": "vyāpanna citto hoti, ",
  "an10.213:1.12": "micchā diṭṭhiko hoti. ",
  "an10.213:1.13": "imehi kho bhikkhave dasahi dhammehi samannāgato mātugāmo yathābhataṃ nikkhitte evaṃ niraye. ",
  "an10.213:2.1": "dasahi bhikkhave dhammehi samannāgato mātugāmo yathābhataṃ nikkhitto evaṃ sagge. ",
  "an10.213:2.2": "katamehi dasahi: ",
  "an10.213:2.3": "pāṇātipātā paṭivirato hoti, ",
  "an10.213:2.4": "adinnādānā paṭivirato hoti, ",
  "an10.213:2.5": "kāmesu micchācārā paṭivirato hoti, ",
  "an10.213:2.6": "musāvādā paṭivirato hoti, ",
  "an10.213:2.7": "pisunāya vācāya paṭivirato hoti, ",
  "an10.213:2.8": "pharusāya vācāya paṭivirato hoti, ",
  "an10.213:2.9": "samphappalāpā paṭivirato hoti, ",
  "an10.213:2.10": "anabhijjhālū hoti, ",
  "an10.213:2.11": "abyāpannacitto hoti, ",
  "an10.213:2.12": "sammādiṭṭhiko hoti. ",
  "an10.213:2.13": "imehi kho bhikkhave dasahi dhammehi samannāgato mātugāmo yathābhataṃ nikkhitto evaṃ saggeti. ",
  "an10.213:2.14": ""
}
