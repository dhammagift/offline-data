{
  "an10.120:0.1": "",
  "an10.120:0.2": "",
  "an10.120:0.3": "10. 3. 2. 8. dutiya paccorohaṇī suttaṃ ",
  "an10.120:1.1": "ariyaṃ kho bhikkhave paccorohaṇiṃ desissāmi. ",
  "an10.120:1.2": "taṃ suṇātha …pe… ",
  "an10.120:1.3": "katamā ca bhikkhave ariyā paccorohaṇī: ",
  "an10.120:1.4": "idha bhikkhave ariyasāvako iti paṭisaṃcikkhati: ",
  "an10.120:1.5": "“micchādiṭṭhiyā kho pāpako vipāko ",
  "an10.120:1.6": "diṭṭhe ceva dhamme, abhisamparāyañcā”ti, ",
  "an10.120:1.7": "so iti paṭisaṅkhāya micchādiṭṭhiṃ pajahati, ",
  "an10.120:1.8": "micchādiṭṭhiyā paccorohati. ",
  "an10.120:1.9": "micchāsaṅkappassa kho pāpako vipāko …pe… ",
  "an10.120:1.10": "micchāvācāya kho pāpako vipāko …pe… ",
  "an10.120:1.11": "micchākammantassa kho pāpako vipāko …pe… ",
  "an10.120:1.12": "micchāājīvassa kho pāpako …pe… ",
  "an10.120:1.13": "micchāvāyāmassa kho pāpako vipāko …pe… ",
  "an10.120:1.14": "micchāsatiyā kho pāpako vipāko …pe… ",
  "an10.120:1.15": "micchāsamādhissa kho pāpako vipāko …pe… ",
  "an10.120:1.16": "micchāñāṇassa kho pāpako vipāko …pe… ",
  "an10.120:1.17": "micchāvimuttiyā kho pāpako vipāko ",
  "an10.120:1.18": "diṭṭhe ceva dhamme abhisamparāyañcāti ",
  "an10.120:1.19": "so iti paṭisaṅkhāya micchāvimuttiṃ pajahati. ",
  "an10.120:1.20": "micchāvimuttiyā paccorohati. ",
  "an10.120:1.21": "ayaṃ vuccati bhikkhave ariyā paccorohaṇīti. ",
  "an10.120:1.22": ""
}
