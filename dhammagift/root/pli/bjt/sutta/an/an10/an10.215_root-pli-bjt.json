{
  "an10.215:0.1": "",
  "an10.215:0.2": "",
  "an10.215:0.3": "10. 5. 1. 5. visārada suttaṃ ",
  "an10.215:1.1": "dasahi bhikkhave dhammehi samannāgatā upāsikā avisāradā agāraṃ ajjhāvasati. ",
  "an10.215:1.2": "katamehi dasahi: ",
  "an10.215:1.3": "pāṇātipātinī hoti, ",
  "an10.215:1.4": "adinnādāyinī hoti, ",
  "an10.215:1.5": "kāmesu micchācārinī hoti, ",
  "an10.215:1.6": "musāvādinī hoti, ",
  "an10.215:1.7": "pisunāvācā hoti, ",
  "an10.215:1.8": "pharusavācā hoti, ",
  "an10.215:1.9": "samphappalāpinī hoti, ",
  "an10.215:1.10": "abhijjhālunī hoti, ",
  "an10.215:1.11": "byāpannacittā hoti, ",
  "an10.215:1.12": "micchādiṭṭhikā hoti. ",
  "an10.215:1.13": "imehi kho bhikkhave dasahi dhammehi samannāgatā upāsikā avisāradā agāraṃ ajjhāvasati. ",
  "an10.215:2.1": "dasahi bhikkhave dhammehi samannāgatā upāsikā visāradā agāraṃ ajjhāvasati. ",
  "an10.215:2.2": "katamehi dasahi: ",
  "an10.215:2.3": "pāṇātipātā paṭiviratā hoti, ",
  "an10.215:2.4": "adinnādānā paṭiviratā hoti, ",
  "an10.215:2.5": "kāmesu micchācārā paṭiviratā hoti, ",
  "an10.215:2.6": "musāvādā paṭiviratā hoti, ",
  "an10.215:2.7": "pisunāya vācāya paṭiviratā hoti, ",
  "an10.215:2.8": "pharusāya vācāya paṭiviratā hoti, ",
  "an10.215:2.9": "samphappalāpā paṭiviratā hoti, ",
  "an10.215:2.10": "anabhijjhālunī hoti, ",
  "an10.215:2.11": "abyāpannacittā hoti, ",
  "an10.215:2.12": "sammādiṭṭhikā hoti. ",
  "an10.215:2.13": "imehi kho bhikkhave dasahi dhammehi samannāgatā upāsikā visāradā agāraṃ ajjhāvasatīti. ",
  "an10.215:2.14": ""
}
