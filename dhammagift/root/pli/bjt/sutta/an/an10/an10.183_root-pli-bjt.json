{
  "an10.183:0.1": "",
  "an10.183:0.2": "",
  "an10.183:0.3": "10. 4. 3. 6. sāsavadhamma suttaṃ ",
  "an10.183:1.1": "sāsavañca vo bhikkhave dhammaṃ desissāmi, anāsavañca. ",
  "an10.183:1.2": "taṃ suṇātha …pe… ",
  "an10.183:1.3": "katamo ca bhikkhave sāsavo dhammo: ",
  "an10.183:1.4": "pāṇātipāto …pe… ",
  "an10.183:1.5": "micchādiṭṭhi. ",
  "an10.183:1.6": "ayaṃ vuccati bhikkhave sāsavo dhammo. ",
  "an10.183:2.1": "katamo ca bhikkhave anāsavo dhammo: ",
  "an10.183:2.2": "pāṇātipātā veramaṇī …pe… ",
  "an10.183:2.3": "sammādiṭṭhi. ",
  "an10.183:2.4": "ayaṃ vuccati bhikkhave anāsavo dhammo ",
  "an10.183:2.5": "ti. "
}
