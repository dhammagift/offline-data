{
  "an10.187:0.1": "",
  "an10.187:0.2": "",
  "an10.187:0.3": "10. 4. 3. 10. dukkhudraya suttaṃ ",
  "an10.187:1.1": "dukkhudrayañca vo bhikkhave dhammaṃ desissāmi, sukhudrayañca. ",
  "an10.187:1.2": "taṃ suṇātha …pe… ",
  "an10.187:1.3": "katamo ca bhikkhave dukkhudrayo dhammo: ",
  "an10.187:1.4": "pāṇātipāto …pe… ",
  "an10.187:1.5": "micchādiṭṭhi. ",
  "an10.187:1.6": "ayaṃ vuccati bhikkhave dukkhudrayo dhammo. ",
  "an10.187:2.1": "katamo ca bhikkhave sukhudrayo dhammo: ",
  "an10.187:2.2": "pāṇātipātā veramaṇī …pe… ",
  "an10.187:2.3": "sammādiṭṭhi. ",
  "an10.187:2.4": "ayaṃ vuccati bhikkhave sukhudrayo dhammo ",
  "an10.187:2.5": "ti. "
}
