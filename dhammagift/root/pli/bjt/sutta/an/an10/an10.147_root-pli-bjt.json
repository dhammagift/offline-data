{
  "an10.147:0.1": "",
  "an10.147:0.2": "",
  "an10.147:0.3": "10. 3. 5. 3. saddhamma suttaṃ ",
  "an10.147:1.1": "saddhammañca vo bhikkhave desissāmi, asaddhammañca. ",
  "an10.147:1.2": "taṃ suṇātha …pe… ",
  "an10.147:1.3": "katamo ca bhikkhave asaddhammo: ",
  "an10.147:1.4": "micchādiṭṭhi …pe… micchāvimutti. ",
  "an10.147:1.5": "ayaṃ vuccati bhikkhave asaddhammo. ",
  "an10.147:1.6": "katamo ca bhikkhave saddhammo: ",
  "an10.147:1.7": "sammādiṭṭhi …pe… ",
  "an10.147:1.8": "ayaṃ vuccati bhikkhave saddhammoti. ",
  "an10.147:1.9": ""
}
