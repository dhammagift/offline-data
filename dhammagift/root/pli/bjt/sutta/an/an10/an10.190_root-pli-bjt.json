{
  "an10.190:0.1": "",
  "an10.190:0.2": "",
  "an10.190:0.3": "10. 4. 4. 2. kaṇhamagga suttaṃ ",
  "an10.190:1.1": "kaṇhamaggañca vo bhikkhave desissāmi, sukkamaggañca. ",
  "an10.190:1.2": "taṃ suṇātha …pe… ",
  "an10.190:1.3": "katamo ca bhikkhave kaṇho maggo: ",
  "an10.190:1.4": "pāṇātipāto …pe… ",
  "an10.190:1.5": "micchādiṭṭhi. ",
  "an10.190:1.6": "ayaṃ vuccati bhikkhave kaṇho maggo. ",
  "an10.190:2.1": "katamo ca bhikkhave sukko maggo: ",
  "an10.190:2.2": "pāṇātipātā veramaṇī …pe… ",
  "an10.190:2.3": "sammādiṭṭhi. ",
  "an10.190:2.4": "ayaṃ vuccati bhikkhave sukko maggo ",
  "an10.190:2.5": "ti. "
}
