{
  "an10.146:0.1": "",
  "an10.146:0.2": "",
  "an10.146:0.3": "10. 3. 5. 2. sukkamagga suttaṃ ",
  "an10.146:1.1": "sukkamaggañca vo bhikkhave desissāmi kaṇhamaggañca. ",
  "an10.146:1.2": "",
  "an10.146:1.3": "katamo ca bhikkhave kaṇhamaggo: ",
  "an10.146:1.4": "micchādiṭṭhi …pe… micchāvimutti. ",
  "an10.146:1.5": "ayaṃ vuccati bhikkhave kaṇhamaggo. ",
  "an10.146:1.6": "katamo ca bhikkhave sukkamaggo: ",
  "an10.146:1.7": "sammādiṭṭhi …pe… sammāvimutti. ",
  "an10.146:1.8": "ayaṃ vuccati bhikkhave sukkamaggoti. ",
  "an10.146:1.9": ""
}
