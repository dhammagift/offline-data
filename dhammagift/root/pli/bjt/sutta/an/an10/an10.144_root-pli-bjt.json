{
  "an10.144:0.1": "",
  "an10.144:0.2": "",
  "an10.144:0.3": "10. 3. 4. 11. dukkhavipāka suttaṃ ",
  "an10.144:1.1": "dukkhavipākañca vo bhikkhave dhammaṃ desissāmi, sukhavipākañca, ",
  "an10.144:1.2": "taṃ suṇātha …pe… ",
  "an10.144:1.3": "katamo ca bhikkhave dukkhavipāko dhammo: ",
  "an10.144:1.4": "micchādiṭṭhi …pe… micchāvimutti. ",
  "an10.144:1.5": "ayaṃ vuccati bhikkhave dukkhavipāko dhammo. ",
  "an10.144:1.6": "katamo ca bhikkhave sukha vipāko dhammo: ",
  "an10.144:1.7": "sammādiṭṭhi …pe… sammāvimutti. ",
  "an10.144:1.8": "ayaṃ vuccati bhikkhave sukhavipāko dhammoti. ",
  "an10.144:1.9": "",
  "an10.144:1.10": "sādhuvaggo catuttho. "
}
