{
  "an10.1:0.1": "aṅguttaranikāye 10. dasakanipāto namo tassa bhagavato arahato sammāsambuddhassa 1. paṭhamo paṇṇāsako ",
  "an10.1:0.2": "1. ānisaṃsavaggo ",
  "an10.1:0.3": "10. 1. 1. 1. kimatthiyasuttaṃ ",
  "an10.1:1.1": "evaṃ me sutaṃ: ",
  "an10.1:1.2": "ekaṃ samayaṃ bhagavā sāvatthiyaṃ viharati jetavane anāthapiṇḍikassa ārāme. ",
  "an10.1:1.3": "atha kho āyasmā ānando yena bhagavā tenupasaṃkami. upasaṅkamitvā bhagavantaṃ abhivādetvā ekamantaṃ nisīdi. ekamantaṃ nisinno kho āyasmā ānando bhagavantaṃ etadavoca: ",
  "an10.1:2.1": "kimatthiyāni bhante kusalāni sīlāni, kimānisaṃsānīti? ",
  "an10.1:2.2": "avippaṭisāratthāni kho ānanda kusalāni sīlāni, avippaṭisārānisaṃsānīti. ",
  "an10.1:3.1": "avippaṭisāro pana bhante kimatthiyo, kimānisaṃsoti? ",
  "an10.1:3.2": "avippaṭisāro kho ānanda pāmojjattho, pāmojjānisaṃsoti. ",
  "an10.1:4.1": "pāmojjaṃ pana bhante kimatthiyaṃ, kimānisaṃsanti? ",
  "an10.1:4.2": "pāmojjaṃ kho ānanda pītatthaṃ, pītānisaṃsanti. ",
  "an10.1:5.1": "pīti pana bhante kimatthiyā, kimānisaṃsāti? ",
  "an10.1:5.2": "pīti kho ānanda passaddhatthā, passaddhānisaṃsāti. ",
  "an10.1:6.1": "passaddhi pana bhante kimatthiyā, kimānisaṃsāti? ",
  "an10.1:6.2": "passaddhi kho ānanda sukhatthā, sukhānisaṃsāti. ",
  "an10.1:7.1": "sukhaṃ pana bhante kimatthiyaṃ, kimānisaṃsanti? ",
  "an10.1:7.2": "sukhaṃ kho ānanda samādhatthaṃ, samādhānisaṃsanti. ",
  "an10.1:8.1": "samādhi pana bhante kimatthiyo, kimānisaṃsoti? ",
  "an10.1:8.2": "samādhi kho ānanda yathābhūtañāṇadassanattho, yathābhūtañāṇadassanānisaṃsoti. ",
  "an10.1:9.1": "yathābhūtañāṇadassanaṃ pana bhante kimatthiyaṃ, kimānisaṃsanti? ",
  "an10.1:9.2": "yathābhūtañāṇadassanaṃ kho ānanda nibbidāvirāgatthaṃ, nibbidāvirāgānisaṃsanti. . ",
  "an10.1:10.1": "nibbidāvirāgo pana bhante kimatthiyo, kimānisaṃsoti? ",
  "an10.1:10.2": "nibbidāvirāgo kho ānanda vimuttiñāṇadassanattho, vimuttiñāṇadassanānisaṃsoti. ",
  "an10.1:11.1": "iti kho ānanda kusalāni sīlāni avippaṭisāratthāni avippaṭisārānisaṃsāni. ",
  "an10.1:11.2": "avippaṭisāro pāmojjattho, pāmojjānisaṃso. ",
  "an10.1:11.3": "pāmojjaṃ pītatthaṃ pītānisaṃsaṃ. ",
  "an10.1:11.4": "pīti passaddhatthā, passaddhānisaṃsā. ",
  "an10.1:11.5": "passaddhi sukhatthā sukhānisaṃsā. ",
  "an10.1:11.6": "sukhaṃ samādhatthaṃ samādhānisaṃsaṃ. ",
  "an10.1:11.7": "samādhi yathābhūtañāṇadassanattho yathābhūtañāṇadassanānisaṃso. ",
  "an10.1:11.8": "yathābhūtañāṇadassanaṃ nibbidāvirāgānisaṃsaṃ. ",
  "an10.1:11.9": "nibbidāvirāgo vimuttiñāṇadassanattho vimuttiñāṇadassanānisaṃso. ",
  "an10.1:11.10": "iti kho ānanda kusalāni sīlāni anupubbena aggāya parentīti. ",
  "an10.1:11.11": ""
}
