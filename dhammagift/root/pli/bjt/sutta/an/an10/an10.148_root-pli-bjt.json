{
  "an10.148:0.1": "",
  "an10.148:0.2": "",
  "an10.148:0.3": "10. 3. 5. 4. sappurisadhamma suttaṃ ",
  "an10.148:1.1": "sappurisadhammañca vo bhikkhave desissāmi, asappurisadhammañca. ",
  "an10.148:1.2": "taṃ suṇātha …pe… ",
  "an10.148:1.3": "katamo ca bhikkhave asappurisadhammo: ",
  "an10.148:1.4": "micchādiṭṭhi …pe… micchāvimutti. ",
  "an10.148:1.5": "ayaṃ vuccati bhikkhave asappurisadhammoti. ",
  "an10.148:1.6": "katamo ca bhikkhave sappurisadhammo: ",
  "an10.148:1.7": "sammādiṭṭhi …pe… sammāvimutti. ",
  "an10.148:1.8": "ayaṃ vuccati bhikkhave sappurisadhammoti. ",
  "an10.148:1.9": ""
}
