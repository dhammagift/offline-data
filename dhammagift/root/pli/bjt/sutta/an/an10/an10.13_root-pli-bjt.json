  "an10.13:0.1": "",
  "an10.13:0.2": "",
  "an10.13:0.3": "10. 1. 2. 3. saṃyojana suttaṃ ",
  "an10.13:1.1": "[sāvatthiyaṃ] dasa imāni bhikkhave saṃyojanāni, ",
  "an10.13:1.2": "katamāni dasa: ",
  "an10.13:1.3": "pañcorambhāgiyāni saṃyojanāni, pañcuddhambhāgiyāni saṃyojanāni. ",
  "an10.13:1.4": "katamāni pañcorambhāgiyāni saṃyojanāni: ",
  "an10.13:1.5": "sakkāyadiṭṭhi, vicikicchā sīlabbataparāmāso, kāmacchando, byāpādoti. ",
  "an10.13:1.6": "imāni pañcorambhāgiya saṃyojanāni. ",
  "an10.13:2.1": "katamāni pañcuddhambhāgiyāni saṃyojanāni: ",
  "an10.13:2.2": "rūparāgo, arūparāgo, māno, uddhaccaṃ, avijjā. ",
  "an10.13:2.3": "imāni kho pañcuddhambhāgiyāni, saṃyojanāni. ",
  "an10.13:2.4": "imāni kho bhikkhave dasasaṃyojanānīti. ",
  "an10.13:2.5": ""
}
