{
  "an10.179:0.1": "",
  "an10.179:0.2": "",
  "an10.179:0.3": "10. 4. 3. 2. ariyadhamma suttaṃ ",
  "an10.179:1.1": "ariyadhammañca vo bhikkhave desissāmi, anariyadhammañca ",
  "an10.179:1.2": "taṃ suṇātha …pe… ",
  "an10.179:1.3": "katamo ca bhikkhave anariyo dhammo: ",
  "an10.179:1.4": "pāṇātipāto …pe… ",
  "an10.179:1.5": "micchādiṭṭhi. ",
  "an10.179:1.6": "ayaṃ vuccati bhikkhave anariyo dhammo. ",
  "an10.179:2.1": "katamo ca bhikkhave ariyo dhammo: ",
  "an10.179:2.2": "pāṇātipātā veramaṇī …pe… ",
  "an10.179:2.3": "sammādiṭṭhi. ",
  "an10.179:2.4": "ayaṃ vuccati bhikkhave ariyo dhammoti. ",
  "an10.179:2.5": ""
}
