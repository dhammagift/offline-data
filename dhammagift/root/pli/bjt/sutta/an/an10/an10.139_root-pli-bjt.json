{
  "an10.139:0.1": "",
  "an10.139:0.2": "",
  "an10.139:0.3": "10. 3. 4. 6. sāsava suttaṃ ",
  "an10.139:1.1": "sāsavañca vo bhikkhave dhammaṃ desissāmi, anāsavañca. ",
  "an10.139:1.2": "taṃ suṇātha …pe… ",
  "an10.139:1.3": "katamo ca bhikkhave sāsavo dhammo: ",
  "an10.139:1.4": "micchādiṭṭhi …pe… micchāvimutti. ",
  "an10.139:1.5": "ayaṃ vuccati bhikkhave sāsavo dhammo. ",
  "an10.139:1.6": "katamo ca bhikkhave anāsavo dhammo: ",
  "an10.139:1.7": "sammādiṭṭhi …pe… sammāvimutti. ",
  "an10.139:1.8": "ayaṃ vuccati bhikkhave anāsavo dhammoti. ",
  "an10.139:1.9": ""
}
