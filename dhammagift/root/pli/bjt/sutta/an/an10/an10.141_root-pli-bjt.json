{
  "an10.141:0.1": "",
  "an10.141:0.2": "",
  "an10.141:0.3": "10. 3. 4. 8. tapanīya suttaṃ ",
  "an10.141:1.1": "tapanīyañca vo bhikkhave dhammaṃ desissāmi, atapanīyañca. ",
  "an10.141:1.2": "taṃ suṇātha …pe… ",
  "an10.141:1.3": "katamo ca bhikkhave tapanīyo dhammo: ",
  "an10.141:1.4": "micchādiṭṭhi …pe… micchāvimutti. ",
  "an10.141:1.5": "ayaṃ vuccati bhikkhave katamo ca tapanīyo dhammo. ",
  "an10.141:1.6": "katamo ca bhikkhave atapanīyo dhammo: ",
  "an10.141:1.7": "sammā diṭṭhi …pe… sammāvimutti. ",
  "an10.141:1.8": "ayaṃ vuccati bhikkhave atapanīyo dhammoti. ",
  "an10.141:1.9": ""
}
