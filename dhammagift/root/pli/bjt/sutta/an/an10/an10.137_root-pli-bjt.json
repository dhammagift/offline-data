{
  "an10.137:0.1": "",
  "an10.137:0.2": "",
  "an10.137:0.3": "10. 3. 4. 4. attha suttaṃ ",
  "an10.137:1.1": "atthañca vo bhikkhave desissāmi anatthañca. ",
  "an10.137:1.2": "taṃ suṇātha …pe… ",
  "an10.137:1.3": "katamo ca bhikkhave anattho: ",
  "an10.137:1.4": "micchādiṭṭhi …pe… micchāvimutti. ",
  "an10.137:1.5": "ayaṃ vuccati bhikkhave anattho. ",
  "an10.137:1.6": "katamo ca bhikkhave attho: ",
  "an10.137:1.7": "sammādiṭṭhi …pe… sammāvimutti. ",
  "an10.137:1.8": "ayaṃ vuccati bhikkhave atthoti. ",
  "an10.137:1.9": ""
}
