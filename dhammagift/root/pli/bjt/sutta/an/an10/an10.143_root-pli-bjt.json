{
  "an10.143:0.1": "",
  "an10.143:0.2": "",
  "an10.143:0.3": "10. 3. 4. 10. dukkhudraya suttaṃ ",
  "an10.143:1.1": "dukkhudrayañca vo bhikkhave dhammaṃ desissāmi, sukhudrayañca. ",
  "an10.143:1.2": "taṃ suṇātha …pe… ",
  "an10.143:1.3": "katamo ca bhikkhave dukkhudrayo dhammo: ",
  "an10.143:1.4": "micchādiṭṭhi …pe… micchāvimutti. ",
  "an10.143:1.5": "ayaṃ vuccati bhikkhave dukkhudrayo dhammo. ",
  "an10.143:1.6": "katamo ca bhikkhave sukhudrayo dhammo: ",
  "an10.143:1.7": "sammādiṭṭhi …pe… sammāvimutti. ",
  "an10.143:1.8": "ayaṃ vuccati bhikkhave sukhudrayo dhammoti. ",
  "an10.143:1.9": ""
}
