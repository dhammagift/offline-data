  "an10.78:0.1": "",
  "an10.78:0.2": "",
  "an10.78:0.3": "10. 2. 3. 8. nigaṇṭha suttaṃ ",
  "an10.78:1.1": "[sāvatthi] dasahi bhikkhave asaddhammehi samannāgatā nigaṇṭhā. ",
  "an10.78:1.2": "katamehi dasahi: ",
  "an10.78:1.3": "assaddhā bhikkhave nigaṇṭhā, ",
  "an10.78:1.4": "dussīlā bhikkhave nigaṇṭhā, ",
  "an10.78:1.5": "ahirikā bhikkhave nigaṇṭhā, ",
  "an10.78:1.6": "anottappino bhikkhave nigaṇṭhā, ",
  "an10.78:1.7": "asappurisambhattino bhikkhave nigaṇṭhā, ",
  "an10.78:1.8": "attukkaṃsakaparavambhakā bhikkhave nigaṇṭhā, ",
  "an10.78:1.9": "sandiṭṭhiparāmāsā ādhānagāhī duppaṭinissaggino bhikkhave nigaṇṭhā, ",
  "an10.78:1.10": "kuhakā bhikkhave nigaṇṭhā, ",
  "an10.78:1.11": "pāpicchā bhikkhave nigaṇṭhā, ",
  "an10.78:1.12": "micchādiṭṭhikā bhikkhave nigaṇṭhā. ",
  "an10.78:1.13": "imehi kho bhikkhave dasahi asaddhammehi samannāgatā nigaṇṭhāti. ",
  "an10.78:1.14": ""
}
