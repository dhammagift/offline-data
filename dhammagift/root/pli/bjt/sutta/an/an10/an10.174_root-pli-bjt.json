{
  "an10.174:0.1": "",
  "an10.174:0.2": "",
  "an10.174:0.3": "10. 4. 2. 8. kammanidāna suttaṃ ",
  "an10.174:1.1": "pāṇātipātampahaṃ bhikkhave tividhaṃ vadāmi ",
  "an10.174:1.2": "lobhahetukampi dosahetukampi mohahetukampi. ",
  "an10.174:2.1": "adinnādānampahaṃ bhikkhave tividhaṃ vadāmi ",
  "an10.174:2.2": "lobhahetukampi dosahetukampi mohahetukampi. ",
  "an10.174:3.1": "kāmesu micchācārampahaṃ bhikkhave tividhaṃ vadāmi ",
  "an10.174:3.2": "lobhahetukampi dosahetukampi mohahetukampi. ",
  "an10.174:4.1": "musāvādampahaṃ bhikkhave tividhaṃ vadāmi ",
  "an10.174:4.2": "lobhahetukampi dosahetukampi mohahetukampi. ",
  "an10.174:5.1": "pisuṇaṃvācampahaṃ bhikkhave tividhaṃ vadāmi ",
  "an10.174:5.2": "lobhahetukampi dosahetukampi mohahetukampi. ",
  "an10.174:6.1": "pharusaṃvācampahaṃ bhikkhave tividhaṃ vadāmi ",
  "an10.174:6.2": "lobhahetukampi dosahetukampi mohahetukampi. ",
  "an10.174:7.1": "samphappalāpampahaṃ bhikkhave tividhaṃ vadāmi ",
  "an10.174:7.2": "lobhahetukampi dosahetukampi mohahetukampi. ",
  "an10.174:8.1": "abhijjhampahaṃ bhikkhave tividhaṃ vadāmi ",
  "an10.174:8.2": "lobhahetukampi dosahetukampi mohahetukampi. ",
  "an10.174:9.1": "vyāpādampahaṃ bhikkhave tividhaṃ vadāmi ",
  "an10.174:9.2": "lobhahetukampi dosahetukampi mohahetukampi. ",
  "an10.174:10.1": "micchādiṭṭhimpahaṃ bhikkhave tividhaṃ vadāmi ",
  "an10.174:10.2": "lobhahetukampi dosahetukampi mohahetukampi. ",
  "an10.174:10.3": "iti kho bhikkhave lobho kammanidānasambhavo, doso kammanidānasambhavo, moho kammanidānasambhavo. ",
  "an10.174:10.4": "lobhakkhayā kammanidānasaṅkhayo, dosakkhayā kammanidānasaṅkhayo, mohakkhayā kammanidānasaṅkhayoti. ",
  "an10.174:10.5": ""
}
