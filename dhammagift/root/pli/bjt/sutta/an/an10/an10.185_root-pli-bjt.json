{
  "an10.185:0.1": "",
  "an10.185:0.2": "",
  "an10.185:0.3": "10. 4. 3. 8. tapanīya suttaṃ ",
  "an10.185:1.1": "tapanīyañca vo bhikkhave dhammaṃ desissāmi, atapanīyañca. ",
  "an10.185:1.2": "taṃ suṇātha …pe… ",
  "an10.185:1.3": "katamo ca bhikkhave tapanīyo dhammo: ",
  "an10.185:1.4": "pāṇātipāto …pe… ",
  "an10.185:1.5": "micchādiṭṭhi. ",
  "an10.185:1.6": "ayaṃ vuccati bhikkhave tapanīyo dhammo. ",
  "an10.185:2.1": "katamo ca bhikkhave atapanīyo dhammo: ",
  "an10.185:2.2": "pāṇātipātā veramaṇī …pe… ",
  "an10.185:2.3": "sammādiṭṭhi. ",
  "an10.185:2.4": "ayaṃ vuccati bhikkhave atapanīyo dhammo ",
  "an10.185:2.5": "ti. "
}
