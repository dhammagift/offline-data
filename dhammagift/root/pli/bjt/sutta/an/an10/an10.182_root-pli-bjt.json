{
  "an10.182:0.1": "",
  "an10.182:0.2": "",
  "an10.182:0.3": "10. 4. 3. 5. dhamma suttaṃ ",
  "an10.182:1.1": "dhammañca vo bhikkhave desissāmi, adhammañca. ",
  "an10.182:1.2": "taṃ suṇātha …pe… ",
  "an10.182:1.3": "katamo ca bhikkhave adhammo: ",
  "an10.182:1.4": "pāṇātipāto …pe… ",
  "an10.182:1.5": "micchādiṭṭhi. ",
  "an10.182:1.6": "ayaṃ vuccati bhikkhave adhammo. ",
  "an10.182:2.1": "katamo ca bhikkhave dhammo: ",
  "an10.182:2.2": "pāṇātipātā veramaṇī …pe… ",
  "an10.182:2.3": "sammādiṭṭhi. ",
  "an10.182:2.4": "ayaṃ vuccati bhikkhave dhammo ",
  "an10.182:2.5": "ti. "
}
