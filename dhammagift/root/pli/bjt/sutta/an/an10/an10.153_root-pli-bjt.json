  "an10.153:0.1": "",
  "an10.153:0.2": "",
  "an10.153:0.3": "10. 3. 5. 9. anussaritabba suttaṃ ",
  "an10.153:1.1": "anussaritabbañca vo bhikkhave dhammaṃ desissāmi, nānussaritabbañca. ",
  "an10.153:1.2": "taṃ suṇātha …pe… ",
  "an10.153:1.3": "katamo ca bhikkhave nānussaritabbo dhammo: ",
  "an10.153:1.4": "micchādiṭṭhi …pe… micchāvimutti. ",
  "an10.153:1.5": "ayaṃ vuccati bhikkhave nānussaritabbo dhammo. ",
  "an10.153:1.6": "katamo ca bhikkhave anussaritabbo dhammo: ",
  "an10.153:1.7": "sammādiṭṭhi …pe… sammāvimutti. ",
  "an10.153:1.8": "ayaṃ vuccati bhikkhave anussaritabbo dhammoti. ",
  "an10.153:1.9": ""
}
