{
  "an10.135:0.1": "",
  "an10.135:0.2": "",
  "an10.135:0.3": "10. 3. 4. 2. ariyadhamma suttaṃ ",
  "an10.135:1.1": "ariyadhammañca vo bhikkhave desissāmi anariyadhammañca. ",
  "an10.135:1.2": "taṃ suṇātha sādhukaṃ manasikarotha …pe… ",
  "an10.135:1.3": "katamo ca bhikkhave anariyo dhammo. ",
  "an10.135:1.4": "micchādiṭṭhi …pe… micchāvimutti. ",
  "an10.135:1.5": "ayaṃ vuccati bhikkhave anariyo dhammo. ",
  "an10.135:1.6": "katamo ca bhikkhave ariyo dhammo: ",
  "an10.135:1.7": "sammādiṭṭhi …pe… sammāvimutti. ",
  "an10.135:1.8": "ayaṃ vuccati bhikkhave ariyo dhammoti. ",
  "an10.135:1.9": ""
}
