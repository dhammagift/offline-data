{
  "an10.180:0.1": "",
  "an10.180:0.2": "",
  "an10.180:0.3": "10. 4. 3. 3. kusala suttaṃ ",
  "an10.180:1.1": "kusalañca vo bhikkhave desissāmi, akusalañca. ",
  "an10.180:1.2": "taṃ suṇātha …pe… ",
  "an10.180:1.3": "katamañca bhikkhave akusalaṃ: ",
  "an10.180:1.4": "pāṇātipāto …pe… ",
  "an10.180:1.5": "micchādiṭṭhi. ",
  "an10.180:1.6": "idaṃ vuccati bhikkhave akusalaṃ. ",
  "an10.180:2.1": "katamañca bhikkhave kusalaṃ: ",
  "an10.180:2.2": "pāṇātipātā veramaṇī …pe… ",
  "an10.180:2.3": "sammādiṭṭhi. ",
  "an10.180:2.4": "idaṃ vuccati bhikkhave kusalanti. ",
  "an10.180:2.5": ""
}
