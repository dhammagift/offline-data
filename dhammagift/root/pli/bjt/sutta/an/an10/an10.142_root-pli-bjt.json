  "an10.142:0.1": "",
  "an10.142:0.2": "",
  "an10.142:0.3": "10. 3. 4. 9. ācayagāmī suttaṃ ",
  "an10.142:1.1": "ācayagāmiñca vo bhikkhave desissāmi, apacayagāmiñca. ",
  "an10.142:1.2": "taṃ suṇātha …pe… ",
  "an10.142:1.3": "katamo ca bhikkhave ācayagāmī dhammo: ",
  "an10.142:1.4": "micchādiṭṭhi …pe… micchāvimutti. ",
  "an10.142:1.5": "ayaṃ vuccati bhikkhave ācayagāmī dhammo. ",
  "an10.142:1.6": "katamo ca bhikkhave apacayagāmī dhammo: ",
  "an10.142:1.7": "sammādiṭṭhi …pe… sammāvimutti. ",
  "an10.142:1.8": "ayaṃ vuccati bhikkhave apacayagāmī dhammoti. ",
  "an10.142:1.9": ""
}
