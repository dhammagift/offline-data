{
  "an10.184:0.1": "",
  "an10.184:0.2": "",
  "an10.184:0.3": "10. 4. 3. 7. sāvajja suttaṃ ",
  "an10.184:1.1": "sāvajjañca vo bhikkhave dhammaṃ desissāmi, anavajjañca. ",
  "an10.184:1.2": "taṃ suṇātha …pe… ",
  "an10.184:1.3": "katamo ca bhikkhave sāvajjo dhammo: ",
  "an10.184:1.4": "pāṇātipāto …pe… ",
  "an10.184:1.5": "micchādiṭṭhi. ",
  "an10.184:1.6": "ayaṃ vuccati bhikkhave sāvajjo dhammo. ",
  "an10.184:2.1": "katamo ca bhikkhave anavajjo dhammo: ",
  "an10.184:2.2": "pāṇātipātā veramaṇī …pe… ",
  "an10.184:2.3": "sammādiṭṭhi. ",
  "an10.184:2.4": "ayaṃ vuccati bhikkhave anavajjo dhammo ",
  "an10.184:2.5": "ti. "
}
