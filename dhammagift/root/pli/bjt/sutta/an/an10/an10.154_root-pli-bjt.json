{
  "an10.154:0.1": "",
  "an10.154:0.2": "",
  "an10.154:0.3": "10. 3. 5. 10. sacchikātabba suttaṃ ",
  "an10.154:1.1": "sacchikātabbañca vo bhikkhave dhammaṃ desissāmi, na sacchikātabbañca. ",
  "an10.154:1.2": "taṃ suṇātha …pe… ",
  "an10.154:1.3": "katamo ca bhikkhave na sacchikātabbo dhammo: ",
  "an10.154:1.4": "micchādiṭṭhi …pe… micchāvimutti. ",
  "an10.154:1.5": "ayaṃ vuccati bhikkhave na sacchikātabbo dhammo. ",
  "an10.154:1.6": "katamo ca bhikkhave sacchikātabbo dhammo: ",
  "an10.154:1.7": "sammādiṭṭhi …pe… sammāvimutti. ",
  "an10.154:1.8": "ayaṃ vuccati bhikkhave sacchikātabbo dhammoti. ",
  "an10.154:1.9": "",
  "an10.154:1.10": "ariyavaggo pañcamo. ",
  "an10.154:1.11": "tatiyo paṇṇāsako. "
}
