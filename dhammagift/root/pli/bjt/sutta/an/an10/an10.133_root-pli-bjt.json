{
  "an10.133:0.1": "",
  "an10.133:0.2": "",
  "an10.133:0.3": "10. 3. 3. 11. ekādasama suttaṃ ",
  "an10.133:1.1": "dasa ime bhikkhave sammattā. ",
  "an10.133:1.2": "katame dasa: ",
  "an10.133:1.3": "sammādiṭṭhi sammā saṅkappo sammāvācā sammākammanto sammāājīvo sammāvāyāmo sammāsati sammāsamādhi sammāñāṇaṃ sammāvimutti. ",
  "an10.133:1.4": "ime kho bhikkhave dasa sammattāti. ",
  "an10.133:1.5": "",
  "an10.133:1.6": "parisuddhavaggo tatiyo. "
}
