{
  "an10.193:0.1": "",
  "an10.193:0.2": "",
  "an10.193:0.3": "10. 4. 4. 5. uppādetabbadhamma suttaṃ ",
  "an10.193:1.1": "uppādetabbañca vo bhikkhave dhammaṃ desissāmi, na uppādetabbañca. ",
  "an10.193:1.2": "taṃ suṇātha …pe… ",
  "an10.193:1.3": "katamo ca bhikkhave na uppādetabbo dhammo: ",
  "an10.193:1.4": "pāṇātipāto …pe… ",
  "an10.193:1.5": "micchādiṭṭhi. ",
  "an10.193:1.6": "ayaṃ vuccati bhikkhave na uppādetabbo dhammo. ",
  "an10.193:2.1": "katamo ca bhikkhave uppādetabbo dhammo: ",
  "an10.193:2.2": "pāṇātipātā veramaṇī …pe… ",
  "an10.193:2.3": "sammādiṭṭhi. ",
  "an10.193:2.4": "ayaṃ vuccati bhikkhave uppādetabbo dhammoti. ",
  "an10.193:2.5": ""
}
