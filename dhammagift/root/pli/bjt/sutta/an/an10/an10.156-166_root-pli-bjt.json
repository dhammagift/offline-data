{
  "an10.156-166:0.1": "",
  "an10.156-166:0.2": "",
  "an10.156-166:0.3": "10. 4. 1. 2-12. bhajitabbādi suttāni ",
  "an10.156-166:1.1": "dasahi bhikkhave samannāgato puggalo na bhajitabbo …pe… ",
  "an10.156-166:1.2": "bhajitabboti. ",
  "an10.156-166:1.3": "3.na ",
  "an10.156-166:1.4": "payirupāsitabbo …pe… payirupāsitabboti. ",
  "an10.156-166:1.5": "na pujjo hoti …pe… ",
  "an10.156-166:1.6": "pujjo hotīti. ",
  "an10.156-166:1.7": "na pāsaṃso hoti …pe… ",
  "an10.156-166:1.8": "pāsaṃso hotīti. ",
  "an10.156-166:1.9": "agāravo hoti …pe… ",
  "an10.156-166:1.10": "sagāravo hotīti. ",
  "an10.156-166:1.11": "appatisso hoti …pe… ",
  "an10.156-166:1.12": "sappatisso hotīti. nārādhako hoti …pe… ",
  "an10.156-166:1.13": "ārādhako hotīti. ",
  "an10.156-166:1.14": "",
  "an10.156-166:1.15": "na visujjhati ",
  "an10.156-166:1.16": "…pe… visujjhatīti. ",
  "an10.156-166:1.17": "mānaṃ nādhibhoti …pe… ",
  "an10.156-166:1.18": "mānaṃ adhibhotīti. ",
  "an10.156-166:1.19": "paññāya na vaḍḍhati …pe… ",
  "an10.156-166:1.20": "paññāya vaḍḍhatīti. ",
  "an10.156-166:2.1": "bahuṃ apuññaṃ pasavati ",
  "an10.156-166:2.2": "…pe… ",
  "an10.156-166:2.3": "katamehi dasahi: ",
  "an10.156-166:2.4": "sammādiṭṭhiko hoti, sammāsaṅkappo hoti, sammāvāco hoti, sammākammanto hoti, sammāājīvo hoti, sammāvāyāmo hoti, sammāsati hoti, sammāsamādhi hoti, sammāñāṇī hoti, sammāvimutti hoti, ",
  "an10.156-166:2.5": "imehi kho bhikkhave dasahi dhammehi samannāgato puggalo bahuṃ puññaṃ pasavatīti. ",
  "an10.156-166:2.6": "puggalavaggo paṭhamo. "
}
