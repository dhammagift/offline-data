  "an3.108:0.1": "",
  "an3.108:0.2": "",
  "an3.108:0.3": "3. 3. 1. 6. ",
  "an3.108:1.1": "tiṇṇaṃ bhikkhave, paṭisevanāya natthi titti. ",
  "an3.108:1.2": "katamesaṃ tiṇṇaṃ: ",
  "an3.108:1.3": "soppassa bhikkhave, paṭisevanāya natthi titti. ",
  "an3.108:1.4": "surāmerayapānassa bhikkhave, paṭisevanāya natthi titti. ",
  "an3.108:1.5": "methunadhammasamāpattiyā bhikkhave, paṭisevanāya natthi titti. ",
  "an3.108:1.6": "imesaṃ bhikkhave, tiṇṇaṃ paṭisevanāya natthi tittīti. ",
  "an3.108:1.7": ""
}
