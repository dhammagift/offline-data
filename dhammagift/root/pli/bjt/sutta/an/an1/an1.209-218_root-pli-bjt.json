{
  "an1.209:0.1": "",
  "an1.209:0.2": "1. 14. 3. 1-10. ",
  "an1.209:1.1": "etadaggaṃ bhikkhave mama sāvakānaṃ bhikkhūnaṃ sikkhākāmānaṃ yadidaṃ rāhulo, …pe… ",
  "an1.210:1.1": "saddhāpabbajitānaṃ yadidaṃ raṭṭhapālo, …pe… ",
  "an1.211:1.1": "paṭhamaṃ salākaṃ gaṇhantānaṃ yadidaṃ kuṇḍadhāno, …pe… ",
  "an1.212:1.1": "paṭibhānavantānaṃ yadidaṃ vaṅgīso, …pe… ",
  "an1.213:1.1": "samantapāsādikānaṃ yadidaṃ upaseno vaṅgantaputto, …pe… ",
  "an1.214:1.1": "senāsanapaññāpakānaṃ yadidaṃ dabbo mallaputto …pe… ",
  "an1.215:1.1": "devatānaṃ piyamanāpānaṃ yadidaṃ piḷindivaccho, …pe… ",
  "an1.216:1.1": "khippābhiññānaṃ yadidaṃ bāhiyo dārucīriyo, …pe… ",
  "an1.217:1.1": "cittakathikānaṃ yadidaṃ kumārakassapo, …pe… ",
  "an1.218:1.1": "paṭisambhidāpattānaṃ yadidaṃ mahākoṭṭhitoti. ",
  "an1.218:1.2": "vaggo tatiyo. "
}
