{
  "an1.235:0.1": "",
  "an1.235:0.2": "1. 14. 5. 1-13. ",
  "an1.235:1.1": "etadaggaṃ bhikkhave mama sāvikānaṃ bhikkhunīnaṃ rattaññūnaṃ yadidaṃ mahāpajāpatīgotamī, -pe- ",
  "an1.236:1.1": "mahāpaññānaṃ yadidaṃ khemā, -pe- ",
  "an1.237:1.1": "iddhimantīnaṃ yadidaṃ uppalavaṇṇā, -pe- ",
  "an1.238:1.1": "vinayadharānaṃ yadidaṃ paṭācārā, -pe- ",
  "an1.239:1.1": "dhammakathikānaṃ yadidaṃ dhammadinnā, -pe- ",
  "an1.240:1.1": "jhāyīnaṃ yadidaṃ nandā, -pe- ",
  "an1.241:1.1": "āraddhaviriyānaṃ yadidaṃ soṇā, -pe- ",
  "an1.242:1.1": "dibbacakkhukānaṃ yadidaṃ sakulā, -pe- ",
  "an1.243:1.1": "khippābhiññānaṃ yadidaṃ bhaddā kuṇḍalakesā, -pe- ",
  "an1.244:1.1": "pubbenivāsaṃ anussarantīnaṃ yadidaṃ bhaddākāpilānī, -pe- ",
  "an1.245:1.1": "mahābhiññappattānaṃ yadidaṃ bhaddakaccānā, -pe- ",
  "an1.246:1.1": "lūkhacīvaradharānaṃ yadidaṃ kisāgotamī, -pe- ",
  "an1.247:1.1": "saddhādhimuttānaṃ yadidaṃ sigālamātāti. ",
  "an1.247:1.2": "vaggo pañcamo. "
}
