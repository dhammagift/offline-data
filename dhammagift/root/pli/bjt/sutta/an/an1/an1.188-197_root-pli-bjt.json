{
  "an1.188:0.1": "",
  "an1.188:0.2": "1. 14. 1. 1-10. 14. etadaggapāḷi. ",
  "an1.188:1.1": "[sāvatthinidānaṃ] etadaggaṃ bhikkhave mama sāvakānaṃ bhikkhūnaṃ rattaññūnaṃ yadidaṃ aññākoṇḍañño …pe… ",
  "an1.189:1.1": "mahāpaññānaṃ yadidaṃ sāriputto, …pe… ",
  "an1.190:1.1": "iddhimantānaṃ yadidaṃ mahāmoggallāno, …pe… ",
  "an1.191:1.1": "dhutavādānaṃ yadidaṃ mahākassapo, …pe… ",
  "an1.192:1.1": "dibbacakkhukānaṃ yadidaṃ anuruddho, …pe… ",
  "an1.193:1.1": "uccākulikānaṃ yadidaṃ bhaddiyo kāḷigodhāyaputto, …pe… ",
  "an1.194:1.1": "mañjussarānaṃ yadidaṃ lakuṇṭakabhaddiyo, …pe… ",
  "an1.195:1.1": "sīhanādikānaṃ yadidaṃ piṇḍolabhāradvājo, …pe… ",
  "an1.196:1.1": "dhammakathikānaṃ yadidaṃ puṇṇo mantāṇiputto, …pe… saṃkhittena ",
  "an1.197:1.1": "bhāsitassa vitthārena atthaṃ vibhajantānaṃ yadidaṃ mahākaccānoti. ",
  "an1.197:1.2": "vaggo paṭhamo. "
}
