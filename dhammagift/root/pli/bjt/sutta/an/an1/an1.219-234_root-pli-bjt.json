{
  "an1.219:0.1": "",
  "an1.219:0.2": "1. 14. 4. 1-16. ",
  "an1.219:1.1": "etadaggaṃ bhikkhave mama sāvakānaṃ bhikkhūnaṃ bahussutānaṃ yadidaṃ ānando, …pe… ",
  "an1.220:1.1": "satimantānaṃ yadidaṃ ānando, …pe… ",
  "an1.221:1.1": "gatimantānaṃ yadidaṃ ānando, …pe… ",
  "an1.222:1.1": "dhitimantānaṃ yadidaṃ ānando, …pe… ",
  "an1.223:1.1": "upaṭṭhākānaṃ yadidaṃ ānando, …pe… ",
  "an1.224:1.1": "mahāparisānaṃ yadidaṃ uruvelakassapo, …pe… ",
  "an1.225:1.1": "kulappasādakānaṃ yadidaṃ kāḷudāyī, …pe… ",
  "an1.226:1.1": "appābādhānaṃ yadidaṃ bakkulo, …pe… ",
  "an1.227:1.1": "pubbenivāsaṃ anussarantānaṃ yadidaṃ sobhito, …pe… ",
  "an1.228:1.1": "vinayadharānaṃ yadidaṃ upāli, …pe… ",
  "an1.229:1.1": "bhikkhunovādakānaṃ yadidaṃ nandako, …pe… ",
  "an1.230:1.1": "indriyesu guttadvārānaṃ yadidaṃ nando, …pe… ",
  "an1.231:1.1": "bhikkhuovādakānaṃ yadidaṃ mahākappino, …pe… ",
  "an1.232:1.1": "tejodhātukusalānaṃ yadidaṃ sāgato, …pe… ",
  "an1.233:1.1": "paṭibhāneyyakānaṃ yadidaṃ rādho, …pe… ",
  "an1.234:1.1": "lūkhacīvaradharānaṃ yadidaṃ mogharājāti. ",
  "an1.234:1.2": "vaggo catuttho. "
}
