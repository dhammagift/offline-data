{
  "an1.198:0.1": "",
  "an1.198:0.2": "1. 14. 2. 1-11. ",
  "an1.198:1.1": "etadaggaṃ bhikkhave mama sāvakānaṃ bhikkhūnaṃ manomayaṃ kāyaṃ abhinimmiṇantānaṃ yadidaṃ cullapanthako, ",
  "an1.199:1.1": "cetovivaṭṭakusalānaṃ yadidaṃ cullapanthako, …pe… ",
  "an1.200:1.1": "saññāvivaṭṭakusalānaṃ yadidaṃ mahāpanthako, …pe… ",
  "an1.201:1.1": "araṇavihārīnaṃ yadidaṃ subhūti, …pe… ",
  "an1.202:1.1": "dakkhiṇeyyānaṃ yadidaṃ subhūti, …pe… ",
  "an1.203:1.1": "āraññakānaṃ yadidaṃ revato khadiravaniyo, …pe… ",
  "an1.204:1.1": "jhāyīnaṃ yadidaṃ kaṅkhārevato, …pe… ",
  "an1.205:1.1": "āraddhaviriyānaṃ yadidaṃ soṇo koḷivīso, …pe… ",
  "an1.206:1.1": "kalyāṇavākkaraṇānaṃ yadidaṃ soṇo kuṭikaṇṇo, …pe… ",
  "an1.207:1.1": "lābhīnaṃ yadidaṃ sīvalī, …pe… ",
  "an1.208:1.1": "saddhādhimuttānaṃ yadidaṃ vakkalīti. ",
  "an1.208:1.2": "vaggo dutiyo. "
}
