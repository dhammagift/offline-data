{
  "an1.248:0.1": "",
  "an1.248:0.2": "1. 14. 6. 1-10. ",
  "an1.248:1.1": "etadaggaṃ bhikkhave mama sāvakānaṃ upāsakānaṃ paṭhamaṃ saraṇaṃ gacchantānaṃ yadidaṃ tapussabhallikā vāṇijā, -pe- ",
  "an1.249:1.1": "dāyakānaṃ yadidaṃ sudatto gahapati anāthapiṇḍiko, -pe- ",
  "an1.250:1.1": "dhammakathikānaṃ yadidaṃ citto gahapati macchikāsaṇḍiko, -pe- ",
  "an1.251:1.1": "catūhi saṅgahavatthūhi parisaṃ saṅgaṇhantānaṃ yadidaṃ hatthako āḷavako, -pe- ",
  "an1.252:1.1": "paṇītadāyakānaṃ yadidaṃ mahānāmo sakko, -pe- ",
  "an1.253:1.1": "manāpadāyakānaṃ yadidaṃ uggo gahapati vesāliko, -pe- ",
  "an1.254:1.1": "saṅghupaṭṭhākānaṃ yadidaṃ uggato gahapati, -pe- ",
  "an1.255:1.1": "aveccappasannānaṃ yadidaṃ sūro ambaṭṭho, -pe- ",
  "an1.256:1.1": "puggalappasannānaṃ yadidaṃ jīvako komārabhacco, -pe- ",
  "an1.257:1.1": "vissāsakānaṃ yadidaṃ nakulapitā gahapatīti. ",
  "an1.257:1.2": "vaggo chaṭṭho. "
}
