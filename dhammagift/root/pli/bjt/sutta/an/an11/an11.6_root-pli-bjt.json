{
  "an11.6:0.1": "",
  "an11.6:0.2": "",
  "an11.6:0.3": "11. 1. 6. vyasana suttaṃ ",
  "an11.6:1.1": "yo so bhikkhave bhikkhu akkosakaparibhāsako ",
  "an11.6:2.1": "",
  "an11.6:2.2": "",
  "an11.6:2.3": "",
  "an11.6:2.4": "",
  "an11.6:2.5": "",
  "an11.6:2.6": "",
  "an11.6:2.7": "",
  "an11.6:2.8": "",
  "an11.6:2.9": "ariyūpavādī ",
  "an11.6:2.10": "",
  "an11.6:2.11": "",
  "an11.6:2.12": "",
  "an11.6:2.13": "",
  "an11.6:3.1": "sabrahmacārīnaṃ aṭṭhānametaṃ anavakāso yaṃ so ekādasannaṃ vyasanānaṃ aññataraṃ vyasanaṃ na nigaccheyya. ",
  "an11.6:4.1": "katamesaṃ ekādasannaṃ: ",
  "an11.6:4.2": "anadhigataṃ nādhigacchati, ",
  "an11.6:4.3": "adhigataṃ parihāyati, ",
  "an11.6:4.4": "saddhammassa na vodāyati, ",
  "an11.6:4.5": "saddhammesu vā adhimāniko hoti. ",
  "an11.6:4.6": "anabhirato vā brahmacariyaṃ carati, ",
  "an11.6:4.7": "aññataraṃ vā saṅkiliṭṭhaṃ āpattiṃ āpajjati. ",
  "an11.6:4.8": "sikkhaṃ vā paccakkhāya hīnāyāvattati, ",
  "an11.6:4.9": "gāḷhaṃ vā rogātaṅkaṃ phusati, ",
  "an11.6:4.10": "ummādaṃ vā pāpuṇāti cittakkhepaṃ, ",
  "an11.6:4.11": "sammūḷho kālaṃ karoti, ",
  "an11.6:4.12": "kāyassa bhedā parammaraṇā apāyaṃ duggatiṃ vinipātaṃ nirayaṃ upapajjati. ",
  "an11.6:4.13": "yo so bhikkhave bhikkhu akkosakaparibhāsako ariyūpavādī sabrahmacārīnaṃ, aṭṭhānametaṃ anavakāso yaṃ so imesaṃ ekādasannaṃ vyasanānaṃ aññataraṃ vyasanaṃ na nigaccheyyāti. ",
  "an11.6:4.14": ""
}
