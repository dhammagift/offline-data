{
  "an8.56:0.1": "",
  "an8.56:0.2": "",
  "an8.56:0.3": "8. 2. 6. 6. kāmādhivacana suttaṃ ",
  "an8.56:1.1": "[sāvatthinidānaṃ] bhayanti bhikkhave, kāmānametaṃ adhivacanaṃ, ",
  "an8.56:1.2": "dukkhanti bhikkhave, kāmānametaṃ adhivacanaṃ, ",
  "an8.56:1.3": "rogoti bhikkhave, kāmānametaṃ adhivacanaṃ, ",
  "an8.56:1.4": "gaṇḍoti bhikkhave, kāmānametaṃ adhivacanaṃ, ",
  "an8.56:1.5": "sallanti bhikkhave, kāmānametaṃ adhivacanaṃ, ",
  "an8.56:1.6": "saṅgoti bhikkhave, kāmānametaṃ adhivacanaṃ ",
  "an8.56:1.7": "paṅkoti bhikkhave, kāmānametaṃ adhivacanaṃ. ",
  "an8.56:1.8": "gabbhoti bhikkhave, kāmānametaṃ adhivacanaṃ. ",
  "an8.56:1.9": "kasmā ca bhikkhave, bhayanti kāmānametaṃ adhivacanaṃ: ",
  "an8.56:1.10": "yasmā ca kāmarāgarattāyaṃ bhikkhave, chandarāgavinibaddho diṭṭhadhammikāpi bhayā na parimuccati, samparāyikāpi bhayā na parimuccati, tasmā bhayanti kāmānametaṃ adhivacanaṃ. ",
  "an8.56:1.11": "kasmā ca bhikkhave, dukkhanti …pe… ",
  "an8.56:1.12": "rogoti …pe… ",
  "an8.56:1.13": "gaṇḍoti …pe… ",
  "an8.56:1.14": "sallanti …pe… ",
  "an8.56:1.15": "saṅgoti …pe… ",
  "an8.56:1.16": "paṅkoti …pe… ",
  "an8.56:1.17": "gabbhoti kāmānametaṃ adhivacanaṃ: ",
  "an8.56:1.18": "yasmā ca kāmarāgarattāyaṃ bhikkhave, chandarāgavinibaddho diṭṭhadhammikāpi gabbhā na parimuccati, samparādhikāpi gabbhā na parimuccati, tasmā gabbhoti kāmānametaṃ adhivacanaṃ. ",
  "an8.56:2.1": "bhayaṃ dukkhañca rogo ca ",
  "an8.56:2.2": "gaṇḍo sallañca saṅgo ca, ",
  "an8.56:2.3": "paṅko gabbho ca ubhayaṃ ",
  "an8.56:2.4": "ete kāmā pavuccanti, ",
  "an8.56:2.5": "yattha satto puthujjano. ",
  "an8.56:3.1": "otiṇṇo sātarūpena ",
  "an8.56:3.2": "punagabbhāya gacchati, ",
  "an8.56:3.3": "yato ca bhikkhu ātāpī ",
  "an8.56:3.4": "sampajaññaṃ na riñcati ",
  "an8.56:4.1": "so imaṃ palipaṃ duggaṃ ",
  "an8.56:4.2": "atikkamma tathāvidho, ",
  "an8.56:4.3": "pajaṃjāti jarūpetaṃ ",
  "an8.56:4.4": "phandamānaṃ avekkhatīti. ",
  "an8.56:4.5": ""
}
