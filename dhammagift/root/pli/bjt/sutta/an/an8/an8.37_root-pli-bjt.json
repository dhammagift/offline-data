  "an8.37:0.1": "",
  "an8.37:0.2": "",
  "an8.37:0.3": "8. 1. 4. 7. sappurisadāna suttaṃ ",
  "an8.37:1.1": "[sāvatthinidānaṃ] aṭṭhimāni bhikkhave, sappurisadānāni, ",
  "an8.37:1.2": "katamāni aṭṭha: ",
  "an8.37:1.3": "suciṃ deti, paṇītaṃ detī, kālena deti, kappiyaṃ deti, viceyya deti, abhiṇhaṃ deti, dadaṃ cittaṃ pasādeti. datvā attamano hoti, ",
  "an8.37:1.4": "imāni kho bhikkhave, aṭṭha sappurisadānānīti. ",
  "an8.37:2.1": "suciṃ paṇītaṃ kālena ",
  "an8.37:2.2": "kappiyaṃ pānabhojanaṃ, ",
  "an8.37:2.3": "abhiṇhaṃ dadāti dānaṃ ",
  "an8.37:2.4": "sukhettesu brahmacārisu. ",
  "an8.37:3.1": "na ca vippaṭisārissa ",
  "an8.37:3.2": "cajitvā āmisaṃ bahuṃ, ",
  "an8.37:3.3": "evaṃ dinnāni dānāni ",
  "an8.37:3.4": "vaṇṇayanti vipassino. ",
  "an8.37:4.1": "evaṃ yajitvā medhāvī ",
  "an8.37:4.2": "saddho muttena cetasā, ",
  "an8.37:4.3": "abyāpajjhaṃ sukhaṃ lokaṃ ",
  "an8.37:4.4": "paṇḍito upapajjatīti. ",
  "an8.37:4.5": ""
}
