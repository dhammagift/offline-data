{
  "an8.60:0.1": "",
  "an8.60:0.2": "",
  "an8.60:0.3": "8. 2. 6. 10. dutiya aṭṭhapuggala suttaṃ ",
  "an8.60:1.1": "[sāvatthinidānaṃ] aṭṭhime bhikkhave, puggalā āhuneyyā …pe… anuttaraṃ puññakkhettaṃ lokassa. ",
  "an8.60:1.2": "katame aṭṭha: ",
  "an8.60:1.3": "sotāpanno sotāpannaphalasacchikiriyāya paṭipanno …pe… arahā arahattaphalasacchikiriyāya paṭipanno. ",
  "an8.60:1.4": "ime kho bhikkhave, aṭṭhapuggalā āhuneyyā …pe… anuttaraṃ puññakkhettaṃ lokassāti. ",
  "an8.60:2.1": "cattāro ca paṭipannā ",
  "an8.60:2.2": "cattāro ca phale ṭhitā ",
  "an8.60:2.3": "esa saṅgho samukkaṭṭho ",
  "an8.60:2.4": "sattānaṃ aṭṭhapuggalā. ",
  "an8.60:3.1": "yajamānānaṃ manussānaṃ ",
  "an8.60:3.2": "puññapekkhāna pāṇinaṃ, ",
  "an8.60:3.3": "karotaṃ opadhikaṃ puññaṃ ",
  "an8.60:3.4": "ettha dinnaṃ mahapphalanti. ",
  "an8.60:3.5": "",
  "an8.60:3.6": "gotamīvaggo chaṭṭho. tatruddānaṃ: ",
  "an8.60:4.0": "",
  "an8.60:4.1": "gotamī ovādaṃ saṅkhittaṃ ",
  "an8.60:4.2": "dīghajāṇu ca ujjayo, ",
  "an8.60:4.3": "bhayaṃ dve āhuneyyā ca ",
  "an8.60:4.4": "dve ca aṭṭhapuggalā ti. "
}
