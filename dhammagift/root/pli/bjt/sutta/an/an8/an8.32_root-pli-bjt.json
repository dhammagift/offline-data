  "an8.32:0.3": "8. 1. 4. 2. dutiyadāna suttaṃ ",
  "an8.32:1.1": "[sāvatthinidānaṃ] saddhā hiriyaṃ kusalañca dānaṃ ",
  "an8.32:1.2": "dhammā ete sappurisānuyātā, ",
  "an8.32:1.3": "etaṃ hi maggaṃ diviyaṃ vadantī ",
  "an8.32:1.4": "etehi gacchati devalokanti. ",
  "an8.32:1.5": ""
}
