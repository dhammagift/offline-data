{
  "an6.120-139:0.1": "",
  "an6.120-139:0.2": "",
  "an6.120-139:0.3": "6. 2. 17-36. [bhallikādi vīsati suttāni] ",
  "an6.120-139:1.1": "[sāvatthinidānaṃ] chahi bhikkhave dhammehi samannāgato bhalliko gahapati …pe… ",
  "an6.120-139:1.2": "sudatto gahapati anāthapiṇḍiko …pe… ",
  "an6.120-139:1.3": "citto gahapati macchikāsaṇḍiko …pe… ",
  "an6.120-139:1.4": "hatthako āḷavako …pe… ",
  "an6.120-139:1.5": "mahānāmo sakko …pe… ",
  "an6.120-139:1.6": "uggo gahapati vesāliko …pe… ",
  "an6.120-139:1.7": "uggato gahapati ",
  "an6.120-139:1.8": "…pe… sūro ambaṭṭho …pe… ",
  "an6.120-139:1.9": "jīvako komārabhacco …pe… ",
  "an6.120-139:1.10": "nakulapitā gahapati …pe… ",
  "an6.120-139:1.11": "tavakaṇṇiko gahapati …pe… ",
  "an6.120-139:1.12": "pūraṇo gahapati …pe… ",
  "an6.120-139:1.13": "isidatto gahapati …pe… ",
  "an6.120-139:1.14": "sandhāno gahapati ",
  "an6.120-139:1.15": "…pe… vijayo gahapati ",
  "an6.120-139:1.16": "…pe… vajjiyamahito gahapati …pe… ",
  "an6.120-139:1.17": "meṇḍako gahapati …pe… ",
  "an6.120-139:1.18": "vāseṭṭho upāsako …pe… ",
  "an6.120-139:1.19": "ariṭṭho upāsako …pe… ",
  "an6.120-139:1.20": "sāraggo upāsako tathāgate niṭṭhaṃgato amataddaso amataṃ sacchikatvā irīyati. ",
  "an6.120-139:1.21": "katamehi chahi. ",
  "an6.120-139:1.22": "buddhe aveccappasādena, dhamme aveccappasādena, saṅghe aveccappasādena, ariyena sīlena, ariyena ñāṇena. ariyāya vimuttiyā. ",
  "an6.120-139:1.23": "imehi kho bhikkhave chahi dhammehi samannāgato sāraggo upāsako tathāgate niṭṭhaṃ gato amataddaso amataṃ sacchikatvā irīyatīti. ",
  "an6.120-139:1.24": "sāmañña vaggo. ",
  "an6.120-139:1.25": "chakkanipāte rāgādipeyyāla suttāni. [sāvatthinidānaṃ] "
}
