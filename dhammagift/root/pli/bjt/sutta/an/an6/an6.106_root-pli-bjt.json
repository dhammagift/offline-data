{
  "an6.106:0.1": "",
  "an6.106:0.2": "",
  "an6.106:0.3": "6. 2. 5. 11. [taṇhā suttaṃ] ",
  "an6.106:1.1": "[sāvatthinidānaṃ] tisso imā bhikkhave taṇhā pahātabbā, tayo ca mānā. ",
  "an6.106:1.2": "katamā tisso taṇhā pahātabbā: ",
  "an6.106:1.3": "kāmataṇhā, bhavataṇhā, vibhavataṇhā, ",
  "an6.106:1.4": "imā tisso taṇhā pahātabbā. ",
  "an6.106:1.5": "katame tayo mānā pahātabbā: ",
  "an6.106:1.6": "māno, omāno, atimāno. ",
  "an6.106:1.7": "ime tayo mānā pahātabbā. ",
  "an6.106:1.8": "yato ca kho bhikkhave bhikkhuno imā tisso taṇhā pahīnā hontī, ime ca tayo mānā, ",
  "an6.106:1.9": "ayaṃ vuccati bhikkhave bhikkhu acchecchi taṇhaṃ, vāvattayī saṃyojanaṃ, sammā mānābhisamayā antamakāsi dukkhassāti. ",
  "an6.106:1.10": "ānisaṃsa ",
  "an6.106:1.11": "vaggo pañcamo. ",
  "an6.106:2.0": "tassuddānaṃ: ",
  "an6.106:2.1": "pātubhāvo ānisaṃso ",
  "an6.106:2.2": "anicca dukkha anattato ",
  "an6.106:2.3": "nibbānaṃ anavatthi ",
  "an6.106:2.4": "ukkhittāsi atammayo ",
  "an6.106:2.5": "bhavā taṇhāyekā dasāti. (machasaṃ.) ",
  "an6.106:2.6": "dutiyo paṇṇāsako samatto paṇṇāsakātireka vaggā "
}
