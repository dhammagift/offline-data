{
  "an7.10:0.1": "",
  "an7.10:0.2": "",
  "an7.10:0.3": "7. 1. 1. 10. [macchariyasaṃyojana suttaṃ] ",
  "an7.10:1.1": "[sāvatthinidānaṃ] sattimāni bhikkhave, saññojanāni: ",
  "an7.10:1.2": "katamāni satta: ",
  "an7.10:1.3": "anunayasaññojanaṃ, paṭighasaññojanaṃ, diṭṭhisaññojanaṃ, vicikicchāsaññojanaṃ, mānasaññojanaṃ, issāsaññojanaṃ, macchariyasaññojanaṃ ",
  "an7.10:1.4": "imāni kho bhikkhave, satta saññojanānīti. ",
  "an7.10:1.5": "",
  "an7.10:1.6": "dhanavaggo paṭhamo. ",
  "an7.10:2.0": "tassuddānaṃ: ",
  "an7.10:2.1": "dvepiyāni balaṃdhanaṃ, saṅkhittaṃceva ",
  "an7.10:2.2": "vitthataṃ ",
  "an7.10:2.3": "uggaṃsaññojanaṃceva ",
  "an7.10:2.4": "pahānaṃ macchariyenacā’ti. "
}
