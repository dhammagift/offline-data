{
  "an7.615:0.1": "āhuneyyavaggo ",
  "an7.615:0.2": "",
  "an7.615:0.3": "1-510. rāgādipeyyālasuttāni [rāgādipeyyāla suttāni] ",
  "an7.615:1.1": "[sāvatthinidānaṃ] rāgassa bhikkhave abhiññāya sattadhammā bhāvetabbā. ",
  "an7.615:1.2": "katame satta: ",
  "an7.615:1.3": "satisambojjhaṅgo …pe… ",
  "an7.615:1.4": "upekkhāsambojjhaṅgo. ",
  "an7.615:1.5": "rāgassa bhikkhave abhiññāya ime sattadhammā bhāvetabbā. "
}
