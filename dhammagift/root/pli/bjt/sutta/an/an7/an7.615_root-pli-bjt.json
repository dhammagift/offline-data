  "an7.615:1.1": "rāgassa bhikkhave abhiññāya sattadhammā bhāvetabbā. ",
  "an7.615:1.2": "katame satta: ",
  "an7.615:1.3": "satisambojjhaṅgo …pe… ",
  "an7.615:1.4": "upekkhāsambojjhaṅgo. ",
  "an7.615:1.5": "rāgassa bhikkhave abhiññāya ime sattadhammā bhāvetabbā. "
}
