{
  "an7.94:0.1": "",
  "an7.94:0.2": "",
  "an7.94:0.3": "7. 2. 4. 10. [saddhammasuttaṃ] ",
  "an7.94:1.1": "[sāvatthinidānaṃ] sattime bhikkhave, saddhammā. ",
  "an7.94:1.2": "katame satta: ",
  "an7.94:1.3": "saddho hoti, hirimā hoti, ottappī hoti, bahussuto hoti, āraddhaviriyo hoti, satimā hoti, paññavā hoti. ",
  "an7.94:1.4": "ime kho bhikkhave, satta saddhammā. ",
  "an7.94:1.5": "",
  "an7.94:1.6": "samaṇavaggo catuttho. ",
  "an7.94:2.0": "tassuddānaṃ: ",
  "an7.94:2.1": "bhikkhu samaṇabrāhmaṇa - sotthiyo ",
  "an7.94:2.2": "ca nahātako ",
  "an7.94:2.3": "vedagū ariyo arahā - ",
  "an7.94:2.4": "dve ca dhammāti te dasa "
}
