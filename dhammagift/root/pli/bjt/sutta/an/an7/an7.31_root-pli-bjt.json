{
  "an7.31:0.1": "",
  "an7.31:0.2": "",
  "an7.31:0.3": "7. 1. 3. 11. [upāsaka parābhava suttaṃ] ",
  "an7.31:1.1": "[sāvatthinidānaṃ] sattime bhikkhave, upāsakassa parābhavā …pe… ",
  "an7.31:1.2": "sattime bhikkhave, upāsakassa sambhavā. ",
  "an7.31:1.3": "katame satta: ",
  "an7.31:1.4": "bhikkhudassanaṃ na hāpeti. ",
  "an7.31:1.5": "saddhammasavaṇaṃ nappamajjati. ",
  "an7.31:1.6": "adhisīle sikkhati. ",
  "an7.31:1.7": "pasādabahulo hoti ",
  "an7.31:1.8": "bhikkhūsu theresu ca navesu ca majjhimesu ca. anupārambhacitto dhammaṃ suṇāti na randhagavesī. ",
  "an7.31:1.9": "na ito bahiddhā dakkhiṇeyyaṃ gavesati. ",
  "an7.31:1.10": "idha ca pubbakāraṃ karoti. ",
  "an7.31:1.11": "ime kho bhikkhave, satta upāsakassa sambhavāti. ",
  "an7.31:2.1": "dassanaṃ bhāvitattānaṃ ",
  "an7.31:2.2": "yo hāpeti upāsako, ",
  "an7.31:2.3": "savaṇañca ariyadhammānaṃ ",
  "an7.31:2.4": "adhisīle na sikkhati. ",
  "an7.31:3.1": "…pe… ",
  "an7.31:3.2": "",
  "an7.31:3.3": "",
  "an7.31:3.4": "",
  "an7.31:4.1": "",
  "an7.31:4.2": "",
  "an7.31:4.3": "",
  "an7.31:4.4": "",
  "an7.31:5.1": "",
  "an7.31:5.2": "",
  "an7.31:5.3": "[upāsako sevamāno] ",
  "an7.31:5.4": "saddhammā parihāyatī”ti ",
  "an7.31:6.1": "",
  "an7.31:6.2": "",
  "an7.31:6.3": "",
  "an7.31:6.4": "[…pe…] ",
  "an7.31:7.1": "",
  "an7.31:7.2": "",
  "an7.31:7.3": "",
  "an7.31:7.4": "",
  "an7.31:8.1": "[29. ",
  "an7.31:8.2": "",
  "an7.31:8.3": "",
  "an7.31:8.4": "",
  "an7.31:9.1": "ete kho aparihānīye ",
  "an7.31:9.2": "sattadhamme sudesite, ",
  "an7.31:9.3": "upāsako sevamāno ",
  "an7.31:9.4": "saddhammā na parihāyatī’ti.] ",
  "an7.31:9.5": "",
  "an7.31:9.6": "vajjisattakavaggo tatiyo ",
  "an7.31:10.0": "tassuddānaṃ: ",
  "an7.31:10.1": "sārandado vassakāro aparihānīya pañcakaṃ sekho ca ",
  "an7.31:10.2": "parihāni ",
  "an7.31:10.3": "ca ",
  "an7.31:10.4": "vipatti ca parābhavo cāti. "
}
