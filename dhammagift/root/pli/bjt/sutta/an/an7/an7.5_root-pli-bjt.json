  "an7.5:0.1": "",
  "an7.5:0.2": "",
  "an7.5:0.3": "7. 1. 1. 5. [saṅkhitta dhanasuttaṃ] ",
  "an7.5:1.1": "[sāvatthinidānaṃ] sattimāni bhikkhave, dhanāni. ",
  "an7.5:1.2": "katamāni satta: ",
  "an7.5:1.3": "saddhādhanaṃ, sīladhanaṃ, hiridhanaṃ, ottappadhanaṃ, sutadhanaṃ, cāgadhanaṃ, paññādhanaṃ. ",
  "an7.5:1.4": "imāni kho bhikkhave, satta dhanānī’ti. ",
  "an7.5:2.1": "saddhādhanaṃ sīladhanaṃ ",
  "an7.5:2.2": "hiri ottappiyaṃ dhanaṃ ",
  "an7.5:2.3": "sutadhanaṃ ca cāgo ca ",
  "an7.5:2.4": "paññā ve sattamaṃ dhanaṃ. ",
  "an7.5:3.1": "yassa ete dhanā atthi ",
  "an7.5:3.2": "itthiyā purisassa vā ",
  "an7.5:3.3": "adaḷiddoti taṃ āhu ",
  "an7.5:3.4": "amoghaṃ tassa jīvitaṃ. ",
  "an7.5:4.1": "tasmā saddhañca sīlañca, ",
  "an7.5:4.2": "pasādaṃ dhammadassanaṃ ",
  "an7.5:4.3": "anuyuñjetha medhāvī ",
  "an7.5:4.4": "saraṃ buddhāna sāsanaṃ’ti. ",
  "an7.5:4.5": ""
}
