{
  "an7.3:0.1": "",
  "an7.3:0.2": "",
  "an7.3:0.3": "7. 1. 1. 3. [saṅkhitta sattabala suttaṃ] ",
  "an7.3:1.1": "",
  "an7.3:1.2": "[sāvatthinidānaṃ] ",
  "an7.3:1.3": "sattimāni bhikkhave, balāni. ",
  "an7.3:1.4": "katamāni satta: ",
  "an7.3:1.5": "saddhābalaṃ, viriyabalaṃ, hiribalaṃ, ottappabalaṃ, satibalaṃ, samādhibalaṃ, paññābalaṃ. ",
  "an7.3:1.6": "imāni kho bhikkhave sattabalāni. ",
  "an7.3:2.1": "saddhābalaṃ viriyabalaṃ ",
  "an7.3:2.2": "hiriottappiyaṃ balaṃ ",
  "an7.3:2.3": "satibalaṃ samādhī ca ",
  "an7.3:2.4": "paññā ve sattamaṃ balaṃ. ",
  "an7.3:2.5": "etehi balavā bhikkhu ",
  "an7.3:2.6": "sukhaṃ jīvati paṇḍito. ",
  "an7.3:3.1": "yoniso vicine dhammaṃ ",
  "an7.3:3.2": "paññāyatthaṃ vipassati. ",
  "an7.3:3.3": "pajjotasseva nibbānaṃ ",
  "an7.3:3.4": "vimokkho hoti cetaso’ti. ",
  "an7.3:3.5": ""
}
