  "an7.93:0.3": "7. 2. 4. 9. [asaddhammasuttaṃ] ",
  "an7.93:1.1": "[sāvatthinidānaṃ] sattime bhikkhave, asaddhammā. ",
  "an7.93:1.2": "katame satta: ",
  "an7.93:1.3": "assaddho hoti, ahiriko hoti, anottāpī hoti, appassuto hoti, kusīto hoti, muṭṭhassati hoti, duppañño hoti. ",
  "an7.93:1.4": "ime kho bhikkhave, satta asaddhammā. ",
  "an7.93:1.5": ""
}
