{
  "an7.62:0.1": "",
  "an7.62:0.2": "",
  "an7.62:0.3": "7. 2. 1. 9. [māpuññabhāyi suttaṃ] ",
  "an7.62:1.1": "[sāvatthinidānaṃ] mā bhikkhave, puññānaṃ bhāyittha. ",
  "an7.62:1.2": "sukhassetaṃ bhikkhave, adhivacanaṃ yadidaṃ puññanti. ",
  "an7.62:1.3": "abhijānāmi kho panāhaṃ bhikkhave, dīgharattaṃ katānaṃ puññānaṃ dīgharattaṃ iṭṭhaṃ kantaṃ manāpaṃ vipākaṃ paccanubhūtaṃ. ",
  "an7.62:1.4": "sattavassāni mettaṃ cittaṃ bhāvesiṃ. ",
  "an7.62:1.5": "sattavassāni mettaṃ cittaṃ bhāvetvā sattasaṃvaṭṭavivaṭṭakappe nayimaṃ lokaṃ punarāgamāsiṃ. ",
  "an7.62:1.6": "saṃvaṭṭamānassudāhaṃ bhikkhave, loke ābhassarūpago homi. ",
  "an7.62:1.7": "vivaṭṭamāne loke suññaṃ brahmavimānaṃ upapajjāmi. ",
  "an7.62:2.1": "tatra sudaṃ bhikkhave, (sattakkhattuṃ) brahmā homi mahābrahmā abhibhū anabhibhūto aññadatthu daso vasavattī. ",
  "an7.62:2.2": "chattiṃsakkhattuṃ kho panāhaṃ bhikkhave sakko ahosiṃ devānamindo. ",
  "an7.62:2.3": "anekasatakkhattuṃ rājā ahosiṃ cakkavatti dhammiko dhammarājā cāturanto vijitāvī janapadatthāvariyappatto sattaratanasamannāgato. ",
  "an7.62:2.4": "tassa mayhaṃ bhikkhave, imāni sattaratanāni ahesuṃ. seyyathīdaṃ: ",
  "an7.62:2.5": "cakkaratanaṃ hatthiratanaṃ assaratanaṃ maṇiratanaṃ itthiratanaṃ gahapatiratanaṃ parināyakaratanameva sattamaṃ. ",
  "an7.62:2.6": "parosahassaṃ kho pana me bhikkhave, puttā ahesuṃ sūrā vīraṅgarūpā parasenappamaddanā. ",
  "an7.62:2.7": "sohaṃ imaṃ paṭhaviṃ sāgarapariyantaṃ adaṇḍena asatthena dhammena abhivijiya ajjhāvasinti. ",
  "an7.62:3.1": "passa puññānaṃ vipākaṃ ",
  "an7.62:3.2": "kusalānaṃ sukhesino ",
  "an7.62:3.3": "mettaṃ cittaṃ vibhāvetvā sattavassāni bhikkhave, ",
  "an7.62:3.4": "satta saṃvaṭṭa-vivaṭṭakappe ",
  "an7.62:3.5": "",
  "an7.62:3.6": "nayimaṃ lokaṃ punāgamaṃ. ",
  "an7.62:4.1": "saṃvaṭṭamāne lokamhi ",
  "an7.62:4.2": "homi ābhassarūpago, ",
  "an7.62:4.3": "vivaṭṭamāne lokamhi suññaṃ ",
  "an7.62:4.4": "brahmūpago ahuṃ. ",
  "an7.62:5.1": "sattakkhattuṃ mahābrahmā ",
  "an7.62:5.2": "vasavattī tadā ahuṃ. ",
  "an7.62:5.3": "chattiṃsakkhattuṃ devindo ",
  "an7.62:5.4": "devarajjamakārayiṃ. ",
  "an7.62:6.1": "cakkavattī ahuṃ rājā ",
  "an7.62:6.2": "jambudīpassa issaro ",
  "an7.62:6.3": "muddhāvasitto khattiyo ",
  "an7.62:6.4": "manussādhipatī ahuṃ. ",
  "an7.62:7.1": "adaṇḍena asatthena ",
  "an7.62:7.2": "vijeyya paṭhaviṃ imaṃ ",
  "an7.62:7.3": "asāhasena dhammena ",
  "an7.62:7.4": "samena anusāsiyaṃ. ",
  "an7.62:8.1": "dhammena rajjaṃ kāretvā ",
  "an7.62:8.2": "asmiṃ paṭhavimaṇḍale ",
  "an7.62:8.3": "mahaddhane mahābhoge ",
  "an7.62:8.4": "aḍḍhe ajāyisaṃ kule ",
  "an7.62:9.1": "sabbakāmehi sampanno ",
  "an7.62:9.2": "ratanehi ca sattahi, ",
  "an7.62:9.3": "buddhā saṅgāhakā loke ",
  "an7.62:9.4": "tehi etaṃ sudesitaṃ. ",
  "an7.62:10.1": "esa hetumahantassa pathavyo ",
  "an7.62:10.2": "yena vuccati. ",
  "an7.62:10.3": "pahūtavittūpakaraṇo ",
  "an7.62:10.4": "rājā homi patāpavā ",
  "an7.62:11.1": "iddhimā yasavā homi ",
  "an7.62:11.2": "jambusaṇḍassa issaro. ",
  "an7.62:11.3": "ko sutvā nappasīdeyya ",
  "an7.62:11.4": "api kaṇhābhijātiyo. ",
  "an7.62:12.1": "tasmā hi atthakāmena ",
  "an7.62:12.2": "mahattamabhikaṅkhatā ",
  "an7.62:12.3": "saddhammo garukātabbo ",
  "an7.62:12.4": "saraṃ buddhāna ",
  "an7.62:12.5": "sāsanaṃ. "
}
