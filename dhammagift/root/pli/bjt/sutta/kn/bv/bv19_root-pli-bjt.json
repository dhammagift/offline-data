{
  "bv19:0.1": "",
  "bv19:0.2": "17. tissa buddhavaṃso ",
  "bv19:1.1": "siddhattha aparena ",
  "bv19:1.2": "assamo appaṭipuggalo ",
  "bv19:1.3": "anantatejo amitayaso ",
  "bv19:1.4": "tisso lokagganāyako. ",
  "bv19:2.1": "tama’ndhakāraṃ vidhametvā ",
  "bv19:2.2": "obhāsetvā sadevakaṃ ",
  "bv19:2.3": "anukampako mahā vīro ",
  "bv19:2.4": "loke uppajji cakkhumā. ",
  "bv19:3.1": "tassā’pi atulā iddhi ",
  "bv19:3.2": "atulaṃ sīlaṃ samādhi ca ",
  "bv19:3.3": "sabbattha pāramiṃ gantvā ",
  "bv19:3.4": "dhammacakkaṃ pavattayī. ",
  "bv19:4.1": "so buddho dasasahassimhi ",
  "bv19:4.2": "viññāpesi giraṃ suciṃ ",
  "bv19:4.3": "koṭisatāni abhisamiṃsu ",
  "bv19:4.4": "paṭhame dhammadesane. ",
  "bv19:5.1": "dutiyo navutikoṭīnaṃ ",
  "bv19:5.2": "tatiyo saṭṭhikoṭiyo ",
  "bv19:5.3": "bandhanāto pamocesi ",
  "bv19:5.4": "sampatte naramarū tadā. ",
  "bv19:6.1": "sannipātā tayo āsuṃ ",
  "bv19:6.2": "tisse lokagganāyake ",
  "bv19:6.3": "khīṇāsavānaṃ vimalānaṃ ",
  "bv19:6.4": "santacittāna tādinaṃ. ",
  "bv19:7.1": "khīṇāsavasatasahassānaṃ ",
  "bv19:7.2": "paṭhamo āsi samāgamo ",
  "bv19:7.3": "navuti sata sahassānaṃ ",
  "bv19:7.4": "dutiyo āsi samāgamo. ",
  "bv19:8.1": "asīti satasahassānaṃ ",
  "bv19:8.2": "tatiyo āsi samāgamo ",
  "bv19:8.3": "khīṇāsavānaṃ vimalānaṃ ",
  "bv19:8.4": "pupphitānaṃ vimuttiyā. ",
  "bv19:9.1": "ahaṃ tena samayena ",
  "bv19:9.2": "sujāto nāma khattiyo ",
  "bv19:9.3": "mahābhogaṃ chaḍḍhayitvā ",
  "bv19:9.4": "pabbajiṃ isipabbajaṃ. ",
  "bv19:10.1": "mayi pabbajite sante ",
  "bv19:10.2": "uppajji lokanāyako ",
  "bv19:10.3": "buddho’ti saddaṃ sutvāna ",
  "bv19:10.4": "pīti me upapajjatha. ",
  "bv19:11.1": "dibbaṃ mandāravaṃ pupphaṃ ",
  "bv19:11.2": "padumaṃ pāricchattakaṃ ",
  "bv19:11.3": "ubho hatthehi paggayha ",
  "bv19:11.4": "dhunamāno upāgamiṃ. ",
  "bv19:12.1": "cātuvaṇṇaparivutaṃ ",
  "bv19:12.2": "tissaṃ lokagganāyakaṃ ",
  "bv19:12.3": "tama’haṃ pupphaṃ gahetvāna ",
  "bv19:12.4": "matthake dhārayiṃ jinaṃ. ",
  "bv19:13.1": "so’pi buddho vyākāsi ",
  "bv19:13.2": "janamajjhe nisīdiya ",
  "bv19:13.3": "dvenavute ito kappe ",
  "bv19:13.4": "ayaṃ buddho bhavissati. ahu kapilavhayā rammaṃ nikkhamitvā tathāgato ",
  "bv19:14.1": "padhānaṃ padahitvāna ",
  "bv19:14.2": "katvā dukkarakārikaṃ. ajapālarukkhamūlamhi nisīditvā tathāgato tatthapāyāsamaggayha nerañjaramupehiti. nerañjarāya tīramhi pāyāsaṃ ādāya so jino paṭiyattavaramaggena bodhimūlamhi ehiti. tato padakkhiṇaṃ katvā bodhimaṇḍaṃ anuttaro assattharukkhamūlamhi bujjhissati mahāyaso. imassa janikā mātā māyā nāma bhavissati pitā suddhodano nāma ayaṃ hessati gotamo. kolito upatisso ca aggā hessanti sāvakā ānando nā’mupaṭṭhāko upaṭṭhissati taṃ jinaṃ. khemā uppalavaṇṇā ca aggā hessanti sāvikā bodhi tassa bhagavato assattho’ti pavuccati. citto ca hatthāḷavako aggā hessantu’paṭṭhakā uttarā nanda mātā ca aggā hessantu’ paṭṭhikā āyuvassasataṃ tassa gotamassa yasassino. idaṃ sutvāna vacanaṃ asamassa mahesino āmoditā naramarū buddhabījaṅkuro ayaṃ. ukkuṭṭhi saddaṃ vattenti apphoṭenti hasanti ca katañjalī namassanti dasasahassī sadevakā. yadi’massa lokanāthassa virajjhissāma sāsanaṃ anāgatamhi addhāne hessāma sammukhā imaṃ. yathā manussā nadiṃ tarantā paṭititthaṃ virajjhiya heṭṭhā titthe gahetvāna uttaranti mahānadiṃ. eva’meva mayaṃ sabbe yadi muñcāmi’maṃ jinaṃ anāgatamhi addhāne ",
  "bv19:14.3": "hessāma sammukhā imaṃ. ",
  "bv19:15.1": "tassā’pi vacanaṃ sutvā ",
  "bv19:15.2": "bhiyyo cittaṃ pasādayiṃ ",
  "bv19:15.3": "uttariṃ vata madhiṭṭhāsiṃ ",
  "bv19:15.4": "dasapārami pūriyā. ",
  "bv19:16.1": "khemakaṃ nāma nagaraṃ ",
  "bv19:16.2": "janasandho nāma khattiyo ",
  "bv19:16.3": "padumā nāma janikā ",
  "bv19:16.4": "tissassa ca mahesino. ",
  "bv19:17.1": "sattavassasahassāni ",
  "bv19:17.2": "agāramajjhaso vasī ",
  "bv19:17.3": "guhā selanāri nisabhā ",
  "bv19:17.4": "tayo pāsāda muttamā. ",
  "bv19:18.1": "samatiṃsa sahassāni ",
  "bv19:18.2": "nāriyo samalaṅkatā ",
  "bv19:18.3": "subhaddā nāma sā nāri ",
  "bv19:18.4": "ānando nāma atrajo. ",
  "bv19:19.1": "nimitte caturo disvā ",
  "bv19:19.2": "assayānena nikkhami ",
  "bv19:19.3": "anūnakaṃ aṭṭhamāsaṃ ",
  "bv19:19.4": "padhānaṃ padahī jino. ",
  "bv19:20.1": "brahmunā yācito santo ",
  "bv19:20.2": "tisso lokagganāyako ",
  "bv19:20.3": "vatti cakkaṃ mahāvīro ",
  "bv19:20.4": "yasavatīdāyamuttame. ",
  "bv19:21.1": "brahmadevo ca udayo ca ",
  "bv19:21.2": "ahesuṃ aggasāvakā ",
  "bv19:21.3": "samaṅgo nāmupaṭṭhāko ",
  "bv19:21.4": "tissassa ca mahesino. ",
  "bv19:22.1": "phussā ce’vā ca sudattāca ",
  "bv19:22.2": "ahesuṃ aggasāvikā ",
  "bv19:22.3": "bodhi tassa bhagavato ",
  "bv19:22.4": "asano’ti pavuccati. ",
  "bv19:23.1": "sambalo ca sirī ceva ",
  "bv19:23.2": "ahesuṃ aggupaṭṭhakā ",
  "bv19:23.3": "kisāgotamī upasenā ",
  "bv19:23.4": "ahesuṃ aggupaṭṭhikā. ",
  "bv19:24.1": "so’pi buddho saṭṭhiratano ",
  "bv19:24.2": "ahu uccattane jino ",
  "bv19:24.3": "anupamo asadiso ",
  "bv19:24.4": "himavā viya dissati. ",
  "bv19:25.1": "tassā’pi atulatejassa ",
  "bv19:25.2": "āyu āsi anuttaro ",
  "bv19:25.3": "vassasatasahassāni ",
  "bv19:25.4": "loke aṭṭhāsi cakkhumā. ",
  "bv19:26.1": "uttamaṃ pavaraṃ seṭṭhaṃ ",
  "bv19:26.2": "anubhotvā mahāyasaṃ ",
  "bv19:26.3": "jalitvā aggikkhandho’va ",
  "bv19:26.4": "nibbuto so sasāvako. ",
  "bv19:27.1": "valāhakova anilena ",
  "bv19:27.2": "suriyena viya ussāvo ",
  "bv19:27.3": "andhakārova dīpena ",
  "bv19:27.4": "nibbuto so sasāvako. ",
  "bv19:28.1": "tisso jinavaro buddho ",
  "bv19:28.2": "nandārāmamhi nibbuto ",
  "bv19:28.3": "tatthe’va tassa jinathūpo ",
  "bv19:28.4": "tīṇi ",
  "bv19:29.1": "yojanamussito’ti. tissa buddhavaṃso sattarasamo. "
}
