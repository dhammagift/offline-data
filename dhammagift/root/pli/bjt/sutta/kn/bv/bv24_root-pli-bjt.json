{
  "bv24:0.1": "",
  "bv24:0.2": "22. kakusandha buddhavaṃso ",
  "bv24:1.1": "vessabhussa aparena ",
  "bv24:1.2": "sambuddho dipaduttamo ",
  "bv24:1.3": "kakusandho nāma nāmena ",
  "bv24:1.4": "appameyyā durāsado ",
  "bv24:2.1": "ugghāṭetvā sabbabhavaṃ ",
  "bv24:2.2": "cariyāpāramiṃ gato ",
  "bv24:2.3": "sīho’ca pañjaraṃ bhetvā ",
  "bv24:2.4": "patto sambodhimuttamaṃ. ",
  "bv24:3.1": "dhammacakkaṃ pavattente ",
  "bv24:3.2": "kakusandhe lokanāyake ",
  "bv24:3.3": "cattāḷīsa koṭisahassānaṃ ",
  "bv24:3.4": "paṭhamā’bhisamayo ahu. ",
  "bv24:4.1": "antalikkhamhi ākāse ",
  "bv24:4.2": "yamakaṃ katvā vikubbanaṃ ",
  "bv24:4.3": "tiṃsakoṭisahassānaṃ ",
  "bv24:4.4": "bodhesi devamānuse. ",
  "bv24:5.1": "naradevassa yakkhassa ",
  "bv24:5.2": "catusaccappakāsane ",
  "bv24:5.3": "dhammā’bhisamayo tassa ",
  "bv24:5.4": "gaṇanāto asaṅkhiyo. ",
  "bv24:6.1": "kakusandhassa bhagavato ",
  "bv24:6.2": "eko āsisamāgamo ",
  "bv24:6.3": "khīṇāsavānaṃ vimalānaṃ ",
  "bv24:6.4": "santacittāna tādinaṃ. ",
  "bv24:7.1": "cattāḷīsasahassānaṃ ",
  "bv24:7.2": "tadā āsi samāgamo ",
  "bv24:7.3": "danta bhūmimanuppattānaṃ ",
  "bv24:7.4": "āsavārigaṇakkhayā ",
  "bv24:8.1": "ahaṃ tena samayena ",
  "bv24:8.2": "khemo nāmāsiṃ khattiyo ",
  "bv24:8.3": "tathāgate jinaputte ca ",
  "bv24:8.4": "dānaṃ datvā anappakaṃ. ",
  "bv24:9.1": "pattañca cīvaraṃ datvā ",
  "bv24:9.2": "añjanaṃ madhulaṭṭhikaṃ ",
  "bv24:9.3": "imetaṃ patthitaṃ sabbaṃ ",
  "bv24:9.4": "paṭiyādemi varaṃ varaṃ. ",
  "bv24:10.1": "so’pi maṃ muni vyākāsi ",
  "bv24:10.2": "kakusandho lokanāyako ",
  "bv24:10.3": "imamhi bhaddake kappe ",
  "bv24:10.4": "ayaṃ buddho bhavissati. ",
  "bv24:11.1": "ahu kapilavhayā rammā ",
  "bv24:11.2": "nikkhamitvā tathāgato padhānaṃ padahitvāna katvā dukkarakārikaṃ. ajapālarukkhamūlamhi nisīditvā tathāgato tattha pāyāsamaggayha nerañjaramupehiti. nerañjarā nadītīre pāyāsaṃ ādāya so jino, paṭiyattavaramaggena bodhimūla’mupehiti. tato padakkhiṇaṃ katvā bodhimaṇḍaṃ anuttaro assatthamūle sambodhiṃ bujjhissati mahāyaso. imassa janikā mātā māyā nāma bhavissati pitā suddhodano nāma ayaṃ hessati gotamo. anāsavā vītarāgā santacittā samāhitā kolito upatisso ca aggā hessanti sāvakā ānando nāmupaṭṭhāko upaṭṭhissati taṃ jinaṃ. khemā uppalavaṇṇā ca aggā hessanti sāvikā bodhi tassa bhagavato assattho’ti pavuccati. citto ca hatthāḷavako aggā hessantu’paṭṭhakā uttarā nandamātā ca aggā hessantu’paṭṭhikā āyu vassasataṃ tassa gotamassa yasassino. idaṃ sutvāna vacanaṃ asamassa mahesino āmoditā naramarū buddha bījaṅkuro ayaṃ. ukkuṭṭhi saddaṃ vattenti apphoṭhenti hasanti ca katañjalī namassanti dasasahassī sadevakā. yadimassa lokanāthassa virajjhissāma sāsanaṃ anāgatamhi addhāne ",
  "bv24:11.3": "hessāma sammukhā imaṃ. ",
  "bv24:12.1": "yathā manussā nadiṃ tarantā paṭititthaṃ virajjhiya heṭṭhā titthe gahetvāna uttaranti mahānadiṃ. eva’meva mayaṃ sabbe yadi muñcāmi’maṃ jinaṃ anāgatamhi addhāne hessāma sammukhā imaṃ. tassā’haṃ vacanaṃ sutvā ",
  "bv24:12.2": "bhiyyo cittaṃ pasādayiṃ ",
  "bv24:12.3": "uttariṃ vatamadhiṭṭhāsiṃ ",
  "bv24:12.4": "dasa pārami pūriyā. ",
  "bv24:13.1": "nagaraṃ khemavatī nāma ",
  "bv24:13.2": "khemo nāmāsa’haṃ tadā ",
  "bv24:13.3": "sabbaññutaṃ gavesanto ",
  "bv24:13.4": "pabbajiṃ tassa santike. ",
  "bv24:14.1": "brāhmaṇo aggidatto ca ",
  "bv24:14.2": "āsi buddhassa so pitā ",
  "bv24:14.3": "visākhā nāma janikā ",
  "bv24:14.4": "kukusandhassa mahesino. ",
  "bv24:15.1": "vasati tattha khemapure ",
  "bv24:15.2": "sambuddhassa mahākulaṃ ",
  "bv24:15.3": "narānaṃ pavaraṃ seṭṭhaṃ ",
  "bv24:15.4": "jātimantaṃ mahāyasaṃ. ",
  "bv24:16.1": "catuvassasahassāni ",
  "bv24:16.2": "agāramajjhaso vasī ",
  "bv24:16.3": "ruci suruci rativaddhano ",
  "bv24:16.4": "tayo pāsāda muttamā. ",
  "bv24:17.1": "samatiṃsasahassāni ",
  "bv24:17.2": "nāriyo samalaṅkatā ",
  "bv24:17.3": "virocamānā nāma nārī ",
  "bv24:17.4": "uttaro nāma atrajo ",
  "bv24:18.1": "nimitte caturo disvā ",
  "bv24:18.2": "rathayānena nikkhamī ",
  "bv24:18.3": "anūnakaṃ aṭṭhamāsaṃ ",
  "bv24:18.4": "padhānaṃ padahī jino. ",
  "bv24:19.1": "brahmunā yācito santo ",
  "bv24:19.2": "kakusandho lokanāyako ",
  "bv24:19.3": "vatti cakkaṃ mahāvīro ",
  "bv24:19.4": "migadāye naruttamo. ",
  "bv24:20.1": "vidhuro sañjīvanāmo ca ",
  "bv24:20.2": "ahesuṃ aggasāvakā ",
  "bv24:20.3": "buddhijo nāmu’paṭṭhāko ",
  "bv24:20.4": "kakusandhassa satthuno. ",
  "bv24:21.1": "sāmā ca campā nāmā ca ",
  "bv24:21.2": "ahesuṃ aggasāvikā ",
  "bv24:21.3": "bodhi tassa bhagavato ",
  "bv24:21.4": "sirīso’ti pavuccati. ",
  "bv24:22.1": "accuto ca sumano ca ",
  "bv24:22.2": "ahesuṃ aggu’paṭṭhakā ",
  "bv24:22.3": "nandā ceva sunandā ca ",
  "bv24:22.4": "ahesuṃ aggu’paṭṭhikā ",
  "bv24:23.1": "cattāḷīsa ratanāni ",
  "bv24:23.2": "accuggato mahāmuni ",
  "bv24:23.3": "kanakappabhāniccharati ",
  "bv24:23.4": "samantā dasa yojanaṃ. ",
  "bv24:24.1": "cattāḷīsavassasahassāni ",
  "bv24:24.2": "āyu tassa mahesino ",
  "bv24:24.3": "tāvatā tiṭṭhamāno so ",
  "bv24:24.4": "tāresi janataṃ bahuṃ. ",
  "bv24:25.1": "dhammā’paṇaṃ pasāretvā ",
  "bv24:25.2": "naranārīnaṃ sadevake ",
  "bv24:25.3": "naditvā sīhanādaṃva ",
  "bv24:25.4": "nibbuto so sasāvako. ",
  "bv24:26.1": "aṭṭhaṅgavacanasampanno ",
  "bv24:26.2": "acchiddāni nirantaraṃ ",
  "bv24:26.3": "sabbaṃ samantarahitaṃ ",
  "bv24:26.4": "nanu rittā sabbasaṅkhārā. ",
  "bv24:27.1": "kakusandho jinavaro ",
  "bv24:27.2": "khemārāmamhi nibbuto ",
  "bv24:27.3": "tatthe’va tassa thūpavaro ",
  "bv24:27.4": "gāvutanabhamuggato. kakusanandha ",
  "bv24:28.1": "buddhavaṃso dvāvīsatimo. "
}
