{
  "bv29:0.1": "",
  "bv29:0.2": "dhātubhājanīya kathā ",
  "bv29:1.1": "mahāgotamo jinavaro ",
  "bv29:1.2": "kusinārāya nibbuto ",
  "bv29:1.3": "dhātu vitthārikaṃ āsi ",
  "bv29:1.4": "tesu tesu padesato. ",
  "bv29:2.1": "eko ajātasattussa ",
  "bv29:2.2": "eko vesāliyāpure ",
  "bv29:2.3": "eko kapilavatthumhi ",
  "bv29:2.4": "eko ca allakappake. ",
  "bv29:3.1": "eko ca rāmagāmamhi ",
  "bv29:3.2": "eko va veṭhadīpake ",
  "bv29:3.3": "eko pāveyyake malle ",
  "bv29:3.4": "eko ca kosinārake. ",
  "bv29:4.1": "kumbhassa thūpaṃ kāresi ",
  "bv29:4.2": "brāhmaṇo doṇa savhayo ",
  "bv29:4.3": "aṅgārathūpaṃ kāresuṃ ",
  "bv29:4.4": "moriyā tuṭṭha ",
  "bv29:5.1": "mānasā. aṭṭhasārīrikā thūpā ",
  "bv29:5.2": "navamo kumbhacetiyo ",
  "bv29:5.3": "aṅgāra thūpo dasamo ",
  "bv29:5.4": "tadāyeva patiṭṭhito. ",
  "bv29:6.1": "",
  "bv29:6.2": "",
  "bv29:6.3": "",
  "bv29:6.4": "",
  "bv29:7.1": "",
  "bv29:7.2": "",
  "bv29:7.3": "",
  "bv29:7.4": "",
  "bv29:8.1": "",
  "bv29:8.2": "",
  "bv29:8.3": "",
  "bv29:8.4": "",
  "bv29:9.1": "",
  "bv29:9.2": "",
  "bv29:9.3": "",
  "bv29:9.4": "",
  "bv29:10.1": "",
  "bv29:10.2": "",
  "bv29:10.3": "",
  "bv29:10.4": "",
  "bv29:11.1": "ekā dāṭhā tidasapure ",
  "bv29:11.2": "ekā nāgapure ahu ",
  "bv29:11.3": "ekā gandhāra visaye ",
  "bv29:11.4": "ekā kāliṅgarājino ",
  "bv29:12.1": "cattāḷīsa samādantā ",
  "bv29:12.2": "kesā lomā ca sabbaso ",
  "bv29:12.3": "devā hariṃsu ekekaṃ ",
  "bv29:12.4": "cakkavāḷa paramparā. ",
  "bv29:13.1": "madhurāyaṃ bhagavato ",
  "bv29:13.2": "patto daṇḍañca cīvaraṃ ",
  "bv29:13.3": "nivāsanaṃ kusaghare ",
  "bv29:13.4": "paccattharaṇaṃ kapilavhaye. ",
  "bv29:14.1": "pāṭaliputtanagare ",
  "bv29:14.2": "karakaṃ kāyabandhanaṃ ",
  "bv29:14.3": "campāyamudakasāṭikā ",
  "bv29:14.4": "uṇṇalomañca kosale. ",
  "bv29:15.1": "kāsāvañca brahmaloke ",
  "bv29:15.2": "veṭhanaṃ tidase pure pāsāṇake padaṃ seṭṭhaṃ yañcāpi accutippadaṃ ",
  "bv29:15.3": "nisīdanaṃ avanti pure ",
  "bv29:15.4": "raṭṭhe attharaṇaṃ tadā ",
  "bv29:16.1": "araṇī ca mithilāyaṃ ",
  "bv29:16.2": "videhe parissāvanaṃ ",
  "bv29:16.3": "vāsi sūcigharañcā’pi ",
  "bv29:16.4": "indapatte pure tadā. ",
  "bv29:17.1": "parikkhāraṃ avasesaṃ ",
  "bv29:17.2": "janapade aparantake ",
  "bv29:17.3": "paribhuttañca muninā ",
  "bv29:17.4": "akaṃsu manujā tadā. ",
  "bv29:18.1": "dhātu vitthārikaṃ āsi ",
  "bv29:18.2": "gotamassa mahesino ",
  "bv29:18.3": "pāṇinaṃ anukampāya ",
  "bv29:18.4": "āhu porāṇikā tadā. dhātubhājanīyakathā niṭṭhitā. buddhavaṃso niṭṭhito. "
}
