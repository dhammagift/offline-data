{
  "bv15:0.1": "",
  "bv15:0.2": "13. piyadassī buddhavaṃso ",
  "bv15:1.1": "sujātassa aparena ",
  "bv15:1.2": "sayambhū loka nāyako ",
  "bv15:1.3": "durāsado asamasa ",
  "bv15:1.4": "piyadassī mahāyaso. ",
  "bv15:2.1": "so’pi buddho amitayaso ",
  "bv15:2.2": "ādicco’va virocati nihantvāna tamaṃ ",
  "bv15:2.3": "sabbaṃ ",
  "bv15:2.4": "dhammacakkaṃ pavattayī. ",
  "bv15:3.1": "tassā’pi atulatejassa ",
  "bv15:3.2": "ahesuṃ abhisamayā tayo ",
  "bv15:3.3": "koṭisatasahassānaṃ ",
  "bv15:3.4": "paṭhamā’bhisamayo ahu. ",
  "bv15:4.1": "sudassano devarājā ",
  "bv15:4.2": "micchādiṭṭhima’ rocayī ",
  "bv15:4.3": "tassa diṭṭhiṃ vinodento ",
  "bv15:4.4": "satthā dhammama’desayī. ",
  "bv15:5.1": "janasannipāto atulo ",
  "bv15:5.2": "mahāsannipatī tadā ",
  "bv15:5.3": "navutikoṭisahassānaṃ ",
  "bv15:5.4": "dutiyābhisamayo ahu. ",
  "bv15:6.1": "yadā doṇamukhaṃ hatthiṃ ",
  "bv15:6.2": "vinesi narasārathi ",
  "bv15:6.3": "asītikoṭisahassānaṃ ",
  "bv15:6.4": "tatiyā’bhisamayo ahu. ",
  "bv15:7.1": "sannipātā tayo āsuṃ ",
  "bv15:7.2": "tassā’pi piyadassino ",
  "bv15:7.3": "koṭisatasahassānaṃ ",
  "bv15:7.4": "paṭhamo āsi samāgamo. ",
  "bv15:8.1": "tato paraṃ navutikoṭī ",
  "bv15:8.2": "samiṃsu ekato munī ",
  "bv15:8.3": "tatiye sannipātamhi ",
  "bv15:8.4": "asītikoṭiyo ahu. ",
  "bv15:9.1": "ahaṃ tena samayena ",
  "bv15:9.2": "kassapo nāma brāhmaṇo ",
  "bv15:9.3": "ajjhāyako mantadharo ",
  "bv15:9.4": "tiṇṇaṃ vedānapāragū. ",
  "bv15:10.1": "tassa dhammaṃ suṇitvāna ",
  "bv15:10.2": "pasādaṃ janayiṃ ahaṃ ",
  "bv15:10.3": "koṭisatasahassehi ",
  "bv15:10.4": "saṅghārāmaṃ amāpayiṃ. ",
  "bv15:11.1": "tassa datvāna ārāmaṃ ",
  "bv15:11.2": "haṭṭho saṃviggamānaso ",
  "bv15:11.3": "saraṇe pañcasīle ca ",
  "bv15:11.4": "daḷhaṃ katvā samādiyiṃ ",
  "bv15:12.1": "so’pi maṃ buddho vyākāsi ",
  "bv15:12.2": "saṅghamajjhe nisīdiya ",
  "bv15:12.3": "aṭṭhārase kappasate ",
  "bv15:12.4": "ayaṃ buddho bhavissati. ahu kapilavhayā rammā nikkhamitvā tathāgato ",
  "bv15:13.1": "padhānaṃ padahitvāna ",
  "bv15:13.2": "katvā dukkarakārikaṃ. ajapālarukkhamūlasmiṃ nisīditvā tathāgato tattha pāyāsamaggayha nerañjaramupehiti. nerañjarāya tīramhi pāyāsaṃ ādāya so jino paṭiyattavaramaggena bodhimūlaṃ hi ehiti. tato padakkhiṇaṃ katvā bodhimaṇḍaṃ anuttaro assattharukkhamūlamhi bujjhissati mahāyaso. imassa janikā mātā māyā nāma bhavissati pitā suddhodano nāma ayaṃ hessati gotamo. kolito upatisso ca aggā hessanti sāvakā ānando nāmu’paṭṭhāko upaṭṭhissati taṃ jinaṃ. khemā uppalavaṇṇā ca aggā hessanti sāvikā. bodhi tassa bhagavato assattho’ti pavuccati. citto ca hatthāḷavako aggā hessantu’paṭṭhakā uttarā nandamātā ca aggā hessantu’paṭṭhikā āyu vassasataṃ tassa gotamassa yasassino. idaṃ sutvāna vacanaṃ asamassa mahesino āmoditā naramarū buddhabījaṅkuro ayaṃ. ukkuṭṭhisaddaṃ vattenti apphoṭenti hasanti ca katañjalī namassanti dasasahassī sadevakā. yadi’massa lokanāthassa virajjhissāma sāsanaṃ anāgatamhi addhāne hessāma sammukhā imaṃ. yathā manussā nadiṃ tarantā paṭititthaṃ virajjhiya heṭṭhātitthe gahetvāna uttaranti mahānadiṃ. evame’va mayaṃ sabbe yadi muñcāmi’maṃ jinaṃ anāgatamhi addhāne ",
  "bv15:13.3": "hessāma sammukhā imaṃ. ",
  "bv15:14.1": "tassā’pi vacanaṃ sutvā ",
  "bv15:14.2": "bhiyyo cittaṃ pasādayiṃ ",
  "bv15:14.3": "uttariṃ vatamadhiṭṭhāsi ",
  "bv15:14.4": "dasapāramipūriyā. ",
  "bv15:15.1": "sudhaññaṃ nāma nagaraṃ ",
  "bv15:15.2": "sudatto nāma khattiyo ",
  "bv15:15.3": "sucandā nāma janikā ",
  "bv15:15.4": "piyadassissa satthuno. ",
  "bv15:16.1": "nava vassa sahassāni ",
  "bv15:16.2": "agāramajjhaso vasī ",
  "bv15:16.3": "sunimmalavimalagiribrahā ",
  "bv15:16.4": "tayo pāsādamuttamā. ",
  "bv15:17.1": "tettiṃsatisahassāni ",
  "bv15:17.2": "nāriyo samalaṅkatā ",
  "bv15:17.3": "vimalā nāma nārī ca ",
  "bv15:17.4": "kañcanāvelo nāma atrajo. ",
  "bv15:18.1": "nimitte caturo disvā ",
  "bv15:18.2": "rathayānena nikkhami ",
  "bv15:18.3": "chamāsaṃ padhānacāraṃ ",
  "bv15:18.4": "acarī purisuttamo. ",
  "bv15:19.1": "brahmunā yācito santo ",
  "bv15:19.2": "piyadassī mahāmuni ",
  "bv15:19.3": "vatti cakkaṃ mahāvīro ",
  "bv15:19.4": "usabhuyyāne manorame ",
  "bv15:20.1": "pālito sabbadassī ca ",
  "bv15:20.2": "ahesuṃ aggasāvakā ",
  "bv15:20.3": "sobhito nāmupaṭṭhāko ",
  "bv15:20.4": "piyadassissa satthuno. ",
  "bv15:21.1": "sujātā dhammadinnā ca ",
  "bv15:21.2": "ahesuṃ aggasāvikā ",
  "bv15:21.3": "bodhi tassa bhagavato ",
  "bv15:21.4": "kakudho’ti pavuccati. ",
  "bv15:22.1": "sandhako dhammako ceva ",
  "bv15:22.2": "ahesuṃ aggu’paṭṭhakā ",
  "bv15:22.3": "visākhā dhammadinnā ca ",
  "bv15:22.4": "ahesuṃ aggu’paṭṭhikā. ",
  "bv15:23.1": "so’pi buddho amitayaso ",
  "bv15:23.2": "dvattiṃsavaralakkhaṇo ",
  "bv15:23.3": "asītihatthamubbedho ",
  "bv15:23.4": "sālarājā’va dissati. ",
  "bv15:24.1": "aggīcanda suriyānaṃ ",
  "bv15:24.2": "natthi tādisikā pabhā ",
  "bv15:24.3": "yathā ahu pabhā tassa ",
  "bv15:24.4": "asamassa mahesino. ",
  "bv15:25.1": "tassā’pi devadevassa ",
  "bv15:25.2": "āyu tāvatakaṃ ahu ",
  "bv15:25.3": "navutivassasahassāni ",
  "bv15:25.4": "loke aṭṭhāsi cakkhumā. ",
  "bv15:26.1": "so’pi buddho asamasamo ",
  "bv15:26.2": "yugāni’pi tāni atuliyāni ",
  "bv15:26.3": "sabbaṃ samantarahitaṃ ",
  "bv15:26.4": "nanu rittā sabbasaṅkhārā. so ",
  "bv15:27.1": "piyadassī munivaro ",
  "bv15:27.2": "assatthārāmamhi nibbuto ",
  "bv15:27.3": "tattheva tassa jinathūpo ",
  "bv15:27.4": "tīṇi yojana muggato’ti. ",
  "bv15:28.1": "piyadassī buddhavaṃso terasamo. "
}
