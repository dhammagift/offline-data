{
  "bv20:0.1": "",
  "bv20:0.2": "18. phussa buddhavaṃso ",
  "bv20:1.1": "tatthe’va maṇḍakappamhi ",
  "bv20:1.2": "ahu satthā anuttaro ",
  "bv20:1.3": "anupamo asadiso ",
  "bv20:1.4": "phusso lokagganāyako. ",
  "bv20:2.1": "so’pi sabbaṃ tamaṃ hantvā ",
  "bv20:2.2": "vijaṭetvā mahājaṭaṃ ",
  "bv20:2.3": "sadevakaṃ tappayanto ",
  "bv20:2.4": "abhivassī amatambunā. ",
  "bv20:3.1": "dhammacakkaṃ pavattente ",
  "bv20:3.2": "phusse nakkhattamaṅgale ",
  "bv20:3.3": "koṭisatasahassānaṃ ",
  "bv20:3.4": "paṭhamā’bhisamayo ahu. ",
  "bv20:4.1": "navutisatasahassānaṃ ",
  "bv20:4.2": "dutiyā’bhisamayo ahu ",
  "bv20:4.3": "asītisatasahassānaṃ ",
  "bv20:4.4": "tatiyā’bhisamayo ahu. ",
  "bv20:5.1": "sannipātā tayo āsuṃ ",
  "bv20:5.2": "phussassa’pi mahesino ",
  "bv20:5.3": "khīṇāsavānaṃ vimalānaṃ ",
  "bv20:5.4": "santacittāna’tādinaṃ. ",
  "bv20:6.1": "saṭṭhisatasahassānaṃ ",
  "bv20:6.2": "paṭhamo āsi samāgamo ",
  "bv20:6.3": "paññāsasatasahassānaṃ ",
  "bv20:6.4": "dutiyo āsi samāgamo. ",
  "bv20:7.1": "cattārīsasatasahassānaṃ ",
  "bv20:7.2": "tatiyo āsi samāgamo ",
  "bv20:7.3": "anupādā vimuttānāṃ ",
  "bv20:7.4": "vocchinnapaṭisandhinaṃ. ",
  "bv20:8.1": "ahaṃ tena samayena ",
  "bv20:8.2": "vijitāvi nāma khattiyo ",
  "bv20:8.3": "chaḍḍayitvā mahārajjaṃ ",
  "bv20:8.4": "pabbajiṃ tassa santike. ",
  "bv20:9.1": "so’pi maṃ buddho vyākāsi ",
  "bv20:9.2": "phusso lokagganāyako ",
  "bv20:9.3": "ito dve navuti kappe ",
  "bv20:9.4": "ayaṃ buddho bhavissati. ahu kapilavhayā rammā nikkhamitvā tathāgato ",
  "bv20:10.1": "padhānaṃ padahitvāna ",
  "bv20:10.2": "katvā dukkarakārikaṃ. ajapālarukkhamūlamhi nisīditvā tathāgato tattha pāyāsamaggayha nerañjaramupehiti. nerañjarāya tīramhi pāyāsaṃ ādāya so jino paṭiyattavaramaggena bodhimūlamhi ehiti. tato padakkhiṇaṃ katvā bodhimaṇḍaṃ anuttaro assattharukkhamūlamhi bujjhissati mahāyaso. imassa janikā mātā māyā nāma bhavissati pitā suddhodano nāma ayaṃ hessati gotamo. kolito upatisso ca aggā hessanti sāvakā ānando nāmu’paṭṭhāko upaṭṭhissati taṃ jinaṃ. khemā uppalavaṇṇā ca aggā hessanti sāvikā bodhi tassa bhagavato assattho’ti pavuccati. citto ca hatthāḷavako aggā hessantu’paṭṭhakā uttarā nandamātā ca aggā hessantu’paṭṭhikā āyu vassa sataṃ tassa gotamassa yasassino. idaṃ sutvāna vacanaṃ asamassa mahesino āmoditā naramarū buddhabījaṅkuro ayaṃ. ukkuṭṭhi saddaṃ vattenti apphoṭhenti hasanti ca katañjalī namassanti dasasahassī sadevakā. yadi’massa lokanāthassa virajjhissāma sāsanaṃ anāgatamhi addhāne hessāma sammukhā imaṃ. yathā manussā nadiṃ tarantā paṭititthaṃ virajhiya heṭṭhā titthe gahetvāna uttaranti mahānadiṃ. eva’meva mayaṃ sabbe yadi muñcāmi’maṃ jinaṃ anāgatamhi addhāne ",
  "bv20:10.3": "hessāma sammukhā imaṃ. ",
  "bv20:11.1": "tassā’pi vacanaṃ sutvā ",
  "bv20:11.2": "bhiyyo cittaṃ pasādayiṃ ",
  "bv20:11.3": "uttariṃ vata madhiṭṭhāsiṃ ",
  "bv20:11.4": "dasapāramipūriyā. ",
  "bv20:12.1": "suttantaṃ vinayañcā’pi ",
  "bv20:12.2": "navaṅgaṃ satthusāsanaṃ ",
  "bv20:12.3": "sabbaṃ pariyāpuṇitvāna ",
  "bv20:12.4": "sobhayiṃ jinasāsanaṃ. ",
  "bv20:13.1": "tatthappa’matto viharanto ",
  "bv20:13.2": "brahmaṃ bhāvetva bhāvanaṃ ",
  "bv20:13.3": "abhiññāsu pāramiṃ gantvā ",
  "bv20:13.4": "brahmaloka’magaccha’haṃ. ",
  "bv20:14.1": "kāsikaṃ nāma nagaraṃ ",
  "bv20:14.2": "jayaseno nāma khattiyo ",
  "bv20:14.3": "sirimā nāma janikā ",
  "bv20:14.4": "phussa’ssāpi mahesino. ",
  "bv20:15.1": "navavassasahassāni ",
  "bv20:15.2": "agāramajjhaso vasī ",
  "bv20:15.3": "garuḷapakkhahaṃsasuvaṇṇahārā ",
  "bv20:15.4": "tayo pāsādamuttamā. ",
  "bv20:16.1": "tīṇidasasahassāni ",
  "bv20:16.2": "nāriyo samalaṅkatā ",
  "bv20:16.3": "kisāgotamī nāma nāri ",
  "bv20:16.4": "anupamo nāma atrajo. ",
  "bv20:17.1": "nimitte caturo disvā ",
  "bv20:17.2": "hatthiyānena nikkhami ",
  "bv20:17.3": "chamāsaṃ padhānacāraṃ ",
  "bv20:17.4": "acarī purisuttamo. ",
  "bv20:18.1": "brahmunā yācito santo ",
  "bv20:18.2": "phusso lokagganāyako ",
  "bv20:18.3": "vatti cakkaṃ mahāvīro ",
  "bv20:18.4": "migadāye naruttamo. ",
  "bv20:19.1": "surakkhito dhammaseno ca ",
  "bv20:19.2": "ahesuṃ aggasāvakā ",
  "bv20:19.3": "sabhiyo nāmu’paṭṭhāko ",
  "bv20:19.4": "phussassa ca mahesino. ",
  "bv20:20.1": "cālā ca upacālā ca ",
  "bv20:20.2": "ahesuṃ aggasāvikā ",
  "bv20:20.3": "bodhi tassa bhagavato ",
  "bv20:20.4": "āmaṇḍo’ti pavuccati. ",
  "bv20:21.1": "dhanañjayo visākho ca ",
  "bv20:21.2": "ahesuṃ aggu’paṭṭhakā ",
  "bv20:21.3": "padumā ce’va nāgā ca ",
  "bv20:21.4": "ahesuṃ aggupaṭṭhikā. ",
  "bv20:22.1": "aṭṭhapaññāsaratanaṃ ",
  "bv20:22.2": "so’pi accuggato muni ",
  "bv20:22.3": "sobhati sataraṃsīva ",
  "bv20:22.4": "ulurājāva pūrito. ",
  "bv20:23.1": "navutivassasahassāni ",
  "bv20:23.2": "āyu vijjati tāvade ",
  "bv20:23.3": "tāvatā tiṭṭhamāno so ",
  "bv20:23.4": "tāresi janataṃ bahuṃ. ",
  "bv20:24.1": "ovaditvā bahū satte ",
  "bv20:24.2": "santāretvā mahājane ",
  "bv20:24.3": "so’pi satthā atulayaso ",
  "bv20:24.4": "nibbuto’so sasāvako. ",
  "bv20:25.1": "phusso jinavaro satthā ",
  "bv20:25.2": "setārāmamhi nibbuto ",
  "bv20:25.3": "dhātuvitthārikaṃ āsī ",
  "bv20:25.4": "tesu tesu padesato’ti. ",
  "bv20:26.1": "phussa buddhavaṃso aṭṭhārasamo. "
}
