{
  "bv17:0.1": "",
  "bv17:0.2": "15. dhammadassī buddhavaṃso ",
  "bv17:1.1": "tatthe’va maṇḍakappamhi ",
  "bv17:1.2": "dhammadassī mahāyaso ",
  "bv17:1.3": "tama’ndhakāraṃ vidhametvā ",
  "bv17:1.4": "atirocati sadevake. ",
  "bv17:2.1": "tassā’pi atulatejassa ",
  "bv17:2.2": "dhammacakkappavattane ",
  "bv17:2.3": "koṭisatasahassānaṃ ",
  "bv17:2.4": "paṭhamā’bhi samayo ahu. ",
  "bv17:3.1": "yadā buddho dhammadassī ",
  "bv17:3.2": "vinesi sañjayaṃ isiṃ ",
  "bv17:3.3": "tadā navutikoṭīnaṃ ",
  "bv17:3.4": "dutiyā’bhisamayo ahu. ",
  "bv17:4.1": "yadā sakko upagañchi ",
  "bv17:4.2": "sahapariso vināyakaṃ ",
  "bv17:4.3": "tadā asīti koṭīnaṃ ",
  "bv17:4.4": "tatiyā’bhisamayo ahu. ",
  "bv17:5.1": "tassā’pi devadevassa ",
  "bv17:5.2": "sannipātā tayo ahu ",
  "bv17:5.3": "khīṇāsavānaṃ vimalānaṃ ",
  "bv17:5.4": "santacittāna’tādinaṃ. ",
  "bv17:6.1": "yadā buddho dhammadassī ",
  "bv17:6.2": "saraṇe vassaṃ upāgamī ",
  "bv17:6.3": "tadā koṭisahassānaṃ ",
  "bv17:6.4": "paṭhamo āsi samāgamo. ",
  "bv17:7.1": "punā’paraṃ yadā buddho ",
  "bv17:7.2": "devato eti mānusaṃ ",
  "bv17:7.3": "tadā’pi satakoṭīnaṃ ",
  "bv17:7.4": "dutiyo āsi samāgamo. ",
  "bv17:8.1": "punā’paraṃ yadā buddho ",
  "bv17:8.2": "pakāsesi dhute guṇe ",
  "bv17:8.3": "tadā asīti koṭīnaṃ ",
  "bv17:8.4": "tatiyo āsi samāgamo. ",
  "bv17:9.1": "ahaṃ tena samayena ",
  "bv17:9.2": "sakko āsiṃ purindado ",
  "bv17:9.3": "dibbena gandhamālena ",
  "bv17:9.4": "turiyena abhipūjayiṃ. ",
  "bv17:10.1": "so’pi maṃ buddho vyākāsi ",
  "bv17:10.2": "devamajjhe nisīdiya ",
  "bv17:10.3": "aṭṭhārase kappasate ",
  "bv17:10.4": "ayaṃ buddho bhavissati. ahu kapilavhayā rammā nikkhamitvā tathāgato ",
  "bv17:11.1": "padhānaṃ padahitvāna ",
  "bv17:11.2": "katvā dukkarakārikaṃ. ajapālarukkhamūlasmiṃ nisīditvā tathāgato tattha pāyāsamaggayha nerañjaramupehiti. nerañjarāya tīramhi pāyāsaṃ ādāya so jino paṭiyattavaramaggena bodhimūlamhi ehiti. tato padakkhiṇaṃ katvā bodhimaṇḍaṃ anuttaro assattharukkhamūlamhi bujjhissati mahāyaso. imassa janikā mātā māyā nāma bhavissati pitā suddhodano nāma ayaṃ hessati gotamo. kolito upatisso ca aggā hessanti sāvakā ānando nāmu’paṭṭhāko upaṭṭhissati taṃ jinaṃ. khemā uppalavaṇṇā ca aggā hessanti sāvikā bodhi tassa bhagavato assattho’ti pavuccati. citto ca hatthāḷavako aggā hessantu’paṭṭhakā uttarā nandamātā ca aggā hessantu’paṭṭhikā āyu vassasataṃ tassa gotamassa yasassino. idaṃ sutvāna vacanaṃ asamassa mahesino āmoditā naramarū buddhabījaṅkuro ayaṃ. ukkuṭṭhisaddaṃ vattenti apphoṭenti hasanti ca katañjalī namassanti dasasahassī sadevakā. yadi’massa lokanāthassa virajjhissāma sāsanaṃ anāgatamhi addhāne hessāma sammukhā imaṃ. yathā manussā nadiṃ tarantā paṭititthaṃ virajjhiya heṭṭhā titthe gahetvāna uttaranti mahānadiṃ. eva’meva mayaṃ sabbe yadi muñcāmi’maṃ jinaṃ anāgatamhi addhāne ",
  "bv17:11.3": "hessāma sammukhā imaṃ. ",
  "bv17:12.1": "tassā’pi vacanaṃ sutvā ",
  "bv17:12.2": "bhiyyo cittaṃ pasādayiṃ ",
  "bv17:12.3": "uttariṃ vatamadhiṭṭhāsiṃ ",
  "bv17:12.4": "dasapāramipūriyā. ",
  "bv17:13.1": "saraṇaṃ nāma nagaraṃ ",
  "bv17:13.2": "saraṇo nāma khattiyo ",
  "bv17:13.3": "sunandā nāma janikā ",
  "bv17:13.4": "dhammadassissa satthuno. ",
  "bv17:14.1": "aṭṭha vassasahassāni ",
  "bv17:14.2": "agāramajjhaso vasī ",
  "bv17:14.3": "arajo virajo sudassano ",
  "bv17:14.4": "tayo pāsādamuttamā. ",
  "bv17:15.1": "ticattārīsasahassāni ",
  "bv17:15.2": "nāriyo samalaṅkatā ",
  "bv17:15.3": "vicatolī nāma nārī ",
  "bv17:15.4": "atrajo puññavaḍḍhano. ",
  "bv17:16.1": "nimitte caturo disvā ",
  "bv17:16.2": "pāsādenā’bhinikkhami ",
  "bv17:16.3": "sattāhaṃ padhānacāraṃ ",
  "bv17:16.4": "acarī purisuttamo. ",
  "bv17:17.1": "brahmunā yācito santo ",
  "bv17:17.2": "dhammadassī narāsabho ",
  "bv17:17.3": "vatti cakkaṃ mahāvīro ",
  "bv17:17.4": "migadāye naruttame. ",
  "bv17:18.1": "padumo phussadevo ca ",
  "bv17:18.2": "ahesuṃ aggasāvakā ",
  "bv17:18.3": "sunetto nāmu’paṭṭhāko ",
  "bv17:18.4": "dhammadassissa satthuno. ",
  "bv17:19.1": "khemā ca saccanāmā ca ",
  "bv17:19.2": "ahesuṃ aggasāvikā ",
  "bv17:19.3": "bodhi tassa bhagavato ",
  "bv17:19.4": "bimbijālo ti vuccati. ",
  "bv17:20.1": "subhaddo kaṭisaho ceva ",
  "bv17:20.2": "ahesuṃ aggu’paṭṭhakā ",
  "bv17:20.3": "sāliyā ca valiyā ca ",
  "bv17:20.4": "ahesuṃ aggu’paṭṭhikā. ",
  "bv17:21.1": "so’pi buddho asamasamo ",
  "bv17:21.2": "asītihatthamuggato ",
  "bv17:21.3": "atirocati tejena ",
  "bv17:21.4": "dasasahassimhi dhātuyā. ",
  "bv17:22.1": "suphullo sālarājāva ",
  "bv17:22.2": "vijjū’va gagane yathā ",
  "bv17:22.3": "majjhantike va suriyo ",
  "bv17:22.4": "evaṃ so upasobhatha ",
  "bv17:23.1": "tassā’pi atulatejassa ",
  "bv17:23.2": "samakaṃ āsi jīvitaṃ ",
  "bv17:23.3": "vassasatasahassāni ",
  "bv17:23.4": "loke aṭṭhāsi cakkhumā. ",
  "bv17:24.1": "obhāsaṃ dassayitvāna ",
  "bv17:24.2": "vimalaṃ katvāna sāsanaṃ ",
  "bv17:24.3": "ravicando va gagane ",
  "bv17:24.4": "nibbuto so sasāvako’ti. ",
  "bv17:25.1": "dhammadassī mahāvīro ",
  "bv17:25.2": "kesārāmamhi nibbuto ",
  "bv17:25.3": "tatthe’va’ssa thūpavaro ",
  "bv17:25.4": "tiyojana ",
  "bv17:26.1": "samuggatoti. dhammadassī buddhavaṃso paṇṇarasamo. "
}
