{
  "bv5:0.1": "",
  "bv5:0.2": "3. maṅgala buddhavaṃso ",
  "bv5:1.1": "koṇḍaññassa aparena ",
  "bv5:1.2": "maṅgalo nāma nāyako, ",
  "bv5:1.3": "tamaṃ loke nihantvāna, ",
  "bv5:1.4": "dhammukka’mabhidhārayi. ",
  "bv5:2.1": "atulā’si pabhā tassa, ",
  "bv5:2.2": "jineha’ññehi uttariṃ, ",
  "bv5:2.3": "canda suriyappabhaṃ hantvā ",
  "bv5:2.4": "dasa sahassī virocati. ",
  "bv5:3.1": "so’pi buddho pakāsesi, ",
  "bv5:3.2": "caturo saccavaruttame ",
  "bv5:3.3": "te te sacca rasaṃ pītvā, ",
  "bv5:3.4": "vinodenti mahātamaṃ. ",
  "bv5:4.1": "patvāna bodhi’matulaṃ, ",
  "bv5:4.2": "paṭhame dhammadesane, ",
  "bv5:4.3": "koṭisatasahassānaṃ, ",
  "bv5:4.4": "paṭhamā’bhisamayo ahu. ",
  "bv5:5.1": "surindadevabhavane ",
  "bv5:5.2": "buddho dhammamadesayi, ",
  "bv5:5.3": "navakoṭisahassānaṃ, ",
  "bv5:5.4": "dutiyā’bhisamayo ahu. ",
  "bv5:6.1": "yadā sunando cakkavatti, ",
  "bv5:6.2": "sambuddhaṃ upasaṅkami, ",
  "bv5:6.3": "tadā ahani sambuddho, ",
  "bv5:6.4": "dhammabheriṃ varuttamaṃ. ",
  "bv5:7.1": "sunandassā’nucarā janatā, ",
  "bv5:7.2": "tadā’suṃ navutikoṭiyo, ",
  "bv5:7.3": "sabbe’pi te niravasesā, ",
  "bv5:7.4": "ahesuṃ ehibhikkhukā. ",
  "bv5:8.1": "sannipātā tayo āsuṃ, ",
  "bv5:8.2": "maṅgalassa mahesino, ",
  "bv5:8.3": "koṭisata sahassānaṃ, ",
  "bv5:8.4": "paṭhamo āsi samāgamo. ",
  "bv5:9.1": "dutiyo koṭisahassānaṃ, ",
  "bv5:9.2": "tatiyo navuti koṭinaṃ, ",
  "bv5:9.3": "khīṇāsavānaṃ vimalānaṃ, ",
  "bv5:9.4": "tadā āsi samāgamo. ",
  "bv5:10.1": "ahaṃ tena samayena ",
  "bv5:10.2": "surucī nāma brāhmaṇo, ",
  "bv5:10.3": "ajjhāyako mantadharo ",
  "bv5:10.4": "tiṇṇaṃ vedānaṃ pāragū. ",
  "bv5:11.1": "tamahaṃ upasaṅkamma, ",
  "bv5:11.2": "saraṇaṃ gantvāna satthuno, ",
  "bv5:11.3": "sambuddhapamukhaṃ saṅghaṃ ",
  "bv5:11.4": "gandhamālena pūjayiṃ ",
  "bv5:11.5": "pūjetvā gandhamālena ",
  "bv5:11.6": "gavapānena tappayiṃ. ",
  "bv5:12.1": "so’pi maṃ buddho vyākāsi ",
  "bv5:12.2": "maṅgalo dipaduttamo aparimeyye ",
  "bv5:12.3": "ito kappe ",
  "bv5:12.4": "ayaṃ buddho bhavissati. ahu kapilavhayā rammā nikkhamitvā tathāgato ",
  "bv5:13.1": "padhānaṃ padahitvāna ",
  "bv5:13.2": "katvā dukkarakārikaṃ. ajapālarukkhamūlasmiṃ nisīditvā tathāgato tattha pāyāsamaggayha nerañjaramupehiti. nerañjarāya tīramhi pāyāsaṃ ādāya so jino paṭiyattavaramaggena bodhimūlamhi ehiti. tato padakkhiṇaṃ katvā bodhimaṇḍaṃ anuttaro assattharukkhamūlamhi bujjhissati mahāyaso. imassa janikā mātā māyā nāma bhavissati pitā suddhodano nāma ayaṃ hessati gotamo. kolito upatisso ca aggā hessanti sāvakā ānando nāmu paṭṭhāko upaṭṭhissati taṃ jinaṃ. khemā uppalavaṇṇā ca aggā hessanti sāvikā bodhi tassa bhagavato, assattho’ti pavuccati. citto ca hatthāḷavako aggā hessantu’paṭṭhakā uttarā nanda mātā ca aggā hessantu’paṭṭhikā āyu vassa sataṃ tassa, gotamassa yasassino. idaṃ sutvāna vacanaṃ asamassa mahesino āmoditā naramarū buddha bījaṅkuro ayaṃ. ukkuṭṭhi saddaṃ vattenti apphoṭenti hasanti ca katañjalī namassanti dassasahassī sadevakā. yadi’massa lokanāthassa virajjhissāma sāsanaṃ anāgatampi addhāne hessāma sammukhā imaṃ. yathā manussā nadiṃ tarantā paṭititthaṃ virajjhiya heṭṭhā titthe gahetvāna uttaranti mahānadiṃ. eva’meva mayaṃ sabbe yadi muñcāmi’maṃ jinaṃ anāgatamhi addhāne ",
  "bv5:13.3": "hessāma sammukhā imaṃ. ",
  "bv5:14.1": "tassā’pi vacanaṃ sutvā ",
  "bv5:14.2": "bhiyyo cittaṃ pasādayiṃ ",
  "bv5:14.3": "uttariṃ vatamadhiṭṭhāsiṃ ",
  "bv5:14.4": "dasa pārami pūriyā. ",
  "bv5:15.1": "tadā pīti manubrūhanto ",
  "bv5:15.2": "sambodhivara pattiyā ",
  "bv5:15.3": "buddhe datvāna maṃ gehaṃ ",
  "bv5:15.4": "pabbajiṃ tassa santike. ",
  "bv5:16.1": "suttantaṃ vinayañcā’pi ",
  "bv5:16.2": "navaṅgaṃ satthusāsanaṃ ",
  "bv5:16.3": "sabbaṃ pariyāpuṇitvāna ",
  "bv5:16.4": "sobhayiṃ jinasāsanaṃ. ",
  "bv5:17.1": "tatthappamatto viharanto ",
  "bv5:17.2": "brahmaṃ bhāvetva bhāvanaṃ ",
  "bv5:17.3": "abhiññā pāramiṃ gantvā ",
  "bv5:17.4": "brahmalokamagacchahaṃ. nagaraṃ ",
  "bv5:18.1": "uttaraṃ nāma ",
  "bv5:18.2": "uttaro nāma khattiyo, ",
  "bv5:18.3": "uttarā nāma janikā ",
  "bv5:18.4": "maṅgalassa mahesino. ",
  "bv5:19.1": "nava vassasahassāni ",
  "bv5:19.2": "agāra majjhe so vasi ",
  "bv5:19.3": "yasavā sucimā sirimā’ ",
  "bv5:19.4": "tayo pāsādamuttamā. ",
  "bv5:20.1": "samatiṃsa sahassāni’ ",
  "bv5:20.2": "nāriyo samalaṅkatā ",
  "bv5:20.3": "yasavatī nāma nārī ",
  "bv5:20.4": "sīvalo nāma atrajo. ",
  "bv5:21.1": "nimitte caturo disvā ",
  "bv5:21.2": "assa yānena nikkhami, ",
  "bv5:21.3": "anūnakaṃ aṭṭhamāsaṃ ",
  "bv5:21.4": "padhānaṃ padahī jino. ",
  "bv5:22.1": "brahmunā yācito satto ",
  "bv5:22.2": "maṅgalo lokanāyako ",
  "bv5:22.3": "vatti cakkaṃ mahāvīro ",
  "bv5:22.4": "vane siri varuttame. ",
  "bv5:23.1": "sudevo dhammaseno ca ",
  "bv5:23.2": "ahesuṃ aggasāvakā, ",
  "bv5:23.3": "pālito nāmupaṭṭhāko ",
  "bv5:23.4": "maṅgalassa mahesino. ",
  "bv5:24.1": "sīvalā ca asokā ca ",
  "bv5:24.2": "ahesuṃ aggasāvikā, ",
  "bv5:24.3": "bodhi tassa bhagavato ",
  "bv5:24.4": "nāgarukkhoti vuccati. ",
  "bv5:25.1": "nando ceva visākho ca ",
  "bv5:25.2": "ahesuṃ aggu’paṭṭhakā, ",
  "bv5:25.3": "anulā ceva sutanā ca ",
  "bv5:25.4": "ahesuṃ aggu’paṭṭhikā. ",
  "bv5:26.1": "aṭṭhāsīti ratanāni ",
  "bv5:26.2": "accuggato mahāmunī, ",
  "bv5:26.3": "tato niddhāvanti raṃsī ",
  "bv5:26.4": "anekasatasahassiyo. ",
  "bv5:27.1": "navutivassasahassāni ",
  "bv5:27.2": "āyu vijjati tāvade ",
  "bv5:27.3": "tāvatā tiṭṭhamāno so ",
  "bv5:27.4": "tāresi janataṃ bahuṃ. ",
  "bv5:28.1": "yathā’pi sāgare ūmi ",
  "bv5:28.2": "na sakkā tā gaṇetuye, ",
  "bv5:28.3": "tathe’va sāvakā tassa ",
  "bv5:28.4": "na sakkā te gaṇetuye. ",
  "bv5:29.1": "yāva aṭṭhāsi sambuddho ",
  "bv5:29.2": "maṅgalo lokanāyako, ",
  "bv5:29.3": "na tassa sāsane atthi ",
  "bv5:29.4": "saṃkilesa maraṇaṃ tadā. ",
  "bv5:30.1": "dhammukkaṃ dhārayitvāna ",
  "bv5:30.2": "santāretvā mahājanaṃ, ",
  "bv5:30.3": "jalitvā dhumaketūva ",
  "bv5:30.4": "nibbuto so mahāyaso. ",
  "bv5:31.1": "saṅkhārānaṃ sahāvantaṃ ",
  "bv5:31.2": "dassayitvā sadevake, ",
  "bv5:31.3": "jalitvā aggikkhandho’va ",
  "bv5:31.4": "suriyo atthaṃgato yathā. ",
  "bv5:32.1": "uyyāne vessare nāma ",
  "bv5:32.2": "buddho nibbāyi maṅgalo, ",
  "bv5:32.3": "tatthe’va tassa jinathūpo ",
  "bv5:32.4": "tiṃsa ",
  "bv5:33.1": "yojanamuggato’ti. maṅgala buddhavaṃso tatiyo. "
}
