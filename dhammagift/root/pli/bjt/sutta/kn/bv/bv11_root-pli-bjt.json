{
  "bv11:0.1": "",
  "bv11:0.2": "9. nārada buddhavaṃso ",
  "bv11:1.1": "padumassa aparena ",
  "bv11:1.2": "sambuddho dipaduttamo ",
  "bv11:1.3": "nārado nāma nāmena ",
  "bv11:1.4": "asamo appaṭipuggalo. ",
  "bv11:2.1": "so buddho cakkavattissa ",
  "bv11:2.2": "jeṭṭho dayitaoraso ",
  "bv11:2.3": "āmuttamālābharaṇo ",
  "bv11:2.4": "uyyānaṃ upasaṅkami. ",
  "bv11:3.1": "tatthā’si rukkho yasavipulo ",
  "bv11:3.2": "abhirūpo brahā sucī ",
  "bv11:3.3": "tamajjhappatvā upanisīdi ",
  "bv11:3.4": "mahāsoṇassa heṭṭhato, ",
  "bv11:4.1": "tattha ñāṇavaruppajji ",
  "bv11:4.2": "anantaṃ vajirūpamaṃ ",
  "bv11:4.3": "tena vicini saṅkhāre ",
  "bv11:4.4": "ukkujjama’vakujjakaṃ. ",
  "bv11:5.1": "tattha sabba kilesāni ",
  "bv11:5.2": "asesamabhivāhayī ",
  "bv11:5.3": "pāpuṇi kevalaṃ bodhiṃ ",
  "bv11:5.4": "buddhañāṇo ca cuddasa. ",
  "bv11:6.1": "pāpuṇitvāna sambodhiṃ ",
  "bv11:6.2": "dhammacakkaṃ pavattayī ",
  "bv11:6.3": "koṭisatasahassānaṃ ",
  "bv11:6.4": "paṭhamābhisamayo ahū. ",
  "bv11:7.1": "mahādoṇaṃ nāgarājaṃ ",
  "bv11:7.2": "vinayanto mahāmuni ",
  "bv11:7.3": "pāṭiheraṃ tadākāsi ",
  "bv11:7.4": "dassayanto sadevake. ",
  "bv11:8.1": "tadā devamanussānaṃ ",
  "bv11:8.2": "tamhi dhammappakāsane ",
  "bv11:8.3": "navutikoṭisahassāni ",
  "bv11:8.4": "tariṃsu sabbasaṃsayaṃ. ",
  "bv11:9.1": "yamhi kāle mahāvīro ",
  "bv11:9.2": "ovadi sakamatrajaṃ ",
  "bv11:9.3": "asītikoṭi sahassānaṃ ",
  "bv11:9.4": "tatiyā’bhisamayo ahu. ",
  "bv11:10.1": "sannipātā tayo āsuṃ ",
  "bv11:10.2": "nāradassa mahesino ",
  "bv11:10.3": "koṭisatasassānaṃ ",
  "bv11:10.4": "paṭhamo āsi samāgamo. ",
  "bv11:11.1": "yadā buddho buddhaguṇaṃ ",
  "bv11:11.2": "sanidānaṃ pakāsayī ",
  "bv11:11.3": "navutikoṭisahassāni ",
  "bv11:11.4": "samiṃsu vimalā tadā. ",
  "bv11:12.1": "yadā verocano nāgo ",
  "bv11:12.2": "dānaṃ dadāti satthuno ",
  "bv11:12.3": "tadā samiṃsu jinaputtā ",
  "bv11:12.4": "asītisatasahassiyo. ",
  "bv11:13.1": "ahaṃ tena samayena ",
  "bv11:13.2": "jaṭilo uggatāpano, ",
  "bv11:13.3": "antalikkhacaro āsiṃ ",
  "bv11:13.4": "pañcābhiññāsu pāragū. ",
  "bv11:14.1": "tadā’pa’haṃ asamasamaṃ ",
  "bv11:14.2": "sasaṅghaṃ saparijjanaṃ ",
  "bv11:14.3": "annapānena tappetvā ",
  "bv11:14.4": "candanenā’bhipūjayiṃ. ",
  "bv11:15.1": "so’pi maṃ buddho vyākāsi, ",
  "bv11:15.2": "nārado loka nāyako aparimeyye ",
  "bv11:15.3": "ito kappe ",
  "bv11:15.4": "ayaṃ buddho bhavissati. ahu kapilavhayā rammā nikkhamitvā tathāgato ",
  "bv11:16.1": "padhānaṃ padahitvāna ",
  "bv11:16.2": "katvā dukkarakārikaṃ. ajapālarukkhamūlasmi nisīditvā tathāgato tattha pāyāsamaggayha nerañjaramupehiti. nerañjarāya tīramhi pāyāsaṃ ādāya so jino paṭiyattavaramaggena bodhimūlamhi ehiti. tato padakkhiṇaṃ katvā bodhimaṇḍaṃ anuttaro assattharukkhamūlamhi bujjhissati mahāyaso. imassa janikā mātā māyā nāma bhavissati pitā suddhodano nāma ayaṃ hessati gotamo. kolito upatisso ca aggā hessanti sāvakā ānando nāmu’paṭṭhāko upaṭṭhissati taṃ jinaṃ. khemā uppalavaṇṇā ca aggā hessanti sāvikā bodhi tassa bhagavato assattho’ti pavuccati. citto ca hatthāḷavako aggā hessantu’paṭṭhakā uttarānandamātā ca aggā hessantupaṭṭhikā āyu vassasataṃ tassa gotamassa yasassino. idaṃ sutvāna vacanaṃ asamassa mahesino āmoditā naramarū buddhabījaṅkuro ayaṃ. ukkuṭṭhisaddaṃ vattenti apphoṭenti hasanti ca katañjalī namassanti dasasahassī sadevakā. yadi’massa lokanāthassa virajjhissāma sāsanaṃ. anāgatamhi addhāne hessāma sammukhā imaṃ. yathā manussā nadiṃ tarantā paṭititthaṃ virajjhiya heṭṭhā titthe gahetvāna uttaranti mahānadiṃ. evameva mayaṃ sabbe yadi muñcāmi’maṃ jinaṃ anāgatamhi addhāne ",
  "bv11:16.3": "hessāma sammukhā imaṃ. ",
  "bv11:17.1": "tassā’pi vacanaṃ sutvā ",
  "bv11:17.2": "bhiyyo bhāvetva mānasaṃ ",
  "bv11:17.3": "adhiṭṭhahiṃ vataṃ uggaṃ ",
  "bv11:17.4": "dasapāramipūriyā. ",
  "bv11:18.1": "nagaraṃ dhaññavatī nāma ",
  "bv11:18.2": "sudevo nāma khattiyo ",
  "bv11:18.3": "anomā nāma janikā ",
  "bv11:18.4": "nāradassa mahesino. ",
  "bv11:19.1": "navavassasahassāni ",
  "bv11:19.2": "agāramajjhaso vasī ",
  "bv11:19.3": "jito vijito vijitā’bhirāmo ",
  "bv11:19.4": "tayo pāsāda muttamā. ",
  "bv11:20.1": "ticattārīsasahassāni ",
  "bv11:20.2": "nāriyo samalaṅkatā ",
  "bv11:20.3": "vijitasenā. nāma nārī ",
  "bv11:20.4": "nanduttaro nāma atrajo. ",
  "bv11:21.1": "nimitte caturo disvā ",
  "bv11:21.2": "pa sā gamanena nikkhamī ",
  "bv11:21.3": "sattāhaṃ padhanacariyaṃ. ",
  "bv11:21.4": "acarī lokanāyako. ",
  "bv11:22.1": "brahmunā yācito santo ",
  "bv11:22.2": "nārado lokanāyako ",
  "bv11:22.3": "vatti cakkaṃ mahāvīro ",
  "bv11:22.4": "dhanañjayu’yyāna muttame. ",
  "bv11:23.1": "bhaddasālo jitamitto ",
  "bv11:23.2": "ahesuṃ aggasāvakā ",
  "bv11:23.3": "vāseṭṭho nāmu’paṭṭhāko ",
  "bv11:23.4": "nāradassa mahesino. ",
  "bv11:24.1": "uttarā phaggunī ce’va ",
  "bv11:24.2": "ahesuṃ aggasāvikā ",
  "bv11:24.3": "bodhi tassa bhagavato ",
  "bv11:24.4": "mahāsono’ti vuccati. ",
  "bv11:25.1": "uggarindo ca vasabho ca ",
  "bv11:25.2": "ahesuṃ aggupaṭṭhakā ",
  "bv11:25.3": "indīvarī ca undī ca ",
  "bv11:25.4": "ahesuṃ aggu’paṭṭhikā. ",
  "bv11:26.1": "aṭṭhāsītiratanāni ",
  "bv11:26.2": "accuggato mahāmuni ",
  "bv11:26.3": "kañcanagghiyasaṃkāso ",
  "bv11:26.4": "dasasahassī virocati. ",
  "bv11:27.1": "tassa vyāmappabhā kāyā ",
  "bv11:27.2": "niddhāvati disodisaṃ ",
  "bv11:27.3": "nirantaraṃ divārattiṃ ",
  "bv11:27.4": "yojanaṃ pharate tadā. ",
  "bv11:28.1": "na keci tena samayena ",
  "bv11:28.2": "samantā yojane janā ",
  "bv11:28.3": "ukkā padīpe ujjālenti ",
  "bv11:28.4": "buddharaṃsena otthaṭā. ",
  "bv11:29.1": "navutivassasahassāni ",
  "bv11:29.2": "ayu vijjati tāvade ",
  "bv11:29.3": "tāvatā tiṭṭhamāno so ",
  "bv11:29.4": "tāresi janataṃ bahuṃ. ",
  "bv11:30.1": "yathā uḷuhi gaganaṃ ",
  "bv11:30.2": "vicittaṃ upasobhati ",
  "bv11:30.3": "tathe’va sāsanaṃ tassa ",
  "bv11:30.4": "arahantehi sobhati. ",
  "bv11:31.1": "saṃsārasotaṃ taraṇāya ",
  "bv11:31.2": "sesake paṭipantake ",
  "bv11:31.3": "dhammasetuṃ daḷhaṃ katvā ",
  "bv11:31.4": "nibbuto so narāsabho. ",
  "bv11:32.1": "so’pi buddho asamasamo ",
  "bv11:32.2": "te’pi khīṇāsavā atulatejā ",
  "bv11:32.3": "sabbaṃ samantarahitaṃ ",
  "bv11:32.4": "nanu rittā sabbasaṅkhārā. ",
  "bv11:33.1": "nārado jinavasabho ",
  "bv11:33.2": "nibbuto sudassane pure ",
  "bv11:33.3": "tatthe’va jinathūpavaro ",
  "bv11:33.4": "catuyojana’muggato’ti. ",
  "bv11:34.1": "nārada buddhavaṃso navamo. "
}
