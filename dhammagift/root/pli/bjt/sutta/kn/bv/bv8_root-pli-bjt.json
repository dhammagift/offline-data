{
  "bv8:0.1": "",
  "bv8:0.2": "6. sobhita buddhavaṃso ",
  "bv8:1.1": "revatassa aparena ",
  "bv8:1.2": "sobhito nāma nāyako ",
  "bv8:1.3": "samāhito santacitto ",
  "bv8:1.4": "asamo appaṭipuggalo. ",
  "bv8:2.1": "so jino sakagehamhi ",
  "bv8:2.2": "mānasaṃ vinīvaṭṭayī ",
  "bv8:2.3": "patvāna kevalaṃ bodhiṃ ",
  "bv8:2.4": "dhammacakkaṃ pavattayī. ",
  "bv8:3.1": "yāva heṭṭhā avīcito ",
  "bv8:3.2": "bhavaggācā’pi uddhato ",
  "bv8:3.3": "etthantare ekaparisā ",
  "bv8:3.4": "ahosi dhammadesane. ",
  "bv8:4.1": "tāya parisāya sambuddho ",
  "bv8:4.2": "dhammacakkaṃ pavattayī ",
  "bv8:4.3": "gaṇanāya na vattabbo ",
  "bv8:4.4": "paṭhamā’bhisamayo ahu. ",
  "bv8:5.1": "tato parampi desente ",
  "bv8:5.2": "marūnaṃ ca samāgame ",
  "bv8:5.3": "navutikoṭisahassānaṃ ",
  "bv8:5.4": "dutiyā’bhisamayo ahu. ",
  "bv8:6.1": "punāparaṃ rājaputto ",
  "bv8:6.2": "jayaseno nāma khattiyo ",
  "bv8:6.3": "ārāmaṃ ropayitvāna ",
  "bv8:6.4": "buddhe niyādayi tadā. ",
  "bv8:7.1": "tassa yāgaṃ pakittento ",
  "bv8:7.2": "dhammaṃ desesi cakkhumā ",
  "bv8:7.3": "tadā koṭisahassānaṃ ",
  "bv8:7.4": "tatiyā’bhisamayo ahu. ",
  "bv8:8.1": "sannipātā tayo āsuṃ ",
  "bv8:8.2": "sobhitassa mahesino ",
  "bv8:8.3": "khīṇāsavānaṃ vimalānaṃ ",
  "bv8:8.4": "santacittāna’tādinaṃ. ",
  "bv8:9.1": "uggato nāma so rājā ",
  "bv8:9.2": "dānaṃ deti naruttame ",
  "bv8:9.3": "tamhi dāne samāgañchuṃ ",
  "bv8:9.4": "arahantā satakoṭiyo. ",
  "bv8:10.1": "punāparaṃ puragaṇo ",
  "bv8:10.2": "deti dānaṃ naruttame ",
  "bv8:10.3": "tadā navutikoṭīnaṃ ",
  "bv8:10.4": "dutiyo āsi samāgamo. ",
  "bv8:11.1": "devaloke vasitvāna ",
  "bv8:11.2": "yadā orohatī jino ",
  "bv8:11.3": "tadā asītikoṭīnaṃ ",
  "bv8:11.4": "tatiyo āsi samāgamo. ",
  "bv8:12.1": "ahaṃ tena samayena ",
  "bv8:12.2": "sujāto nāma brāhmaṇo ",
  "bv8:12.3": "tadā sasāvakaṃ buddhaṃ ",
  "bv8:12.4": "annapānena tappayiṃ. ",
  "bv8:13.1": "so’pi maṃ buddho vyākāsi ",
  "bv8:13.2": "sobhito lokanāyako ",
  "bv8:13.3": "aparimeyye ito kappe ",
  "bv8:13.4": "ayaṃ buddho bhavissati. ahu kapilavhayā rammā nikkhamitvā tathāgato ",
  "bv8:14.1": "padhānaṃ padahitvāna ",
  "bv8:14.2": "katvā dukkarakārikaṃ. ajapārukkhamūlasmiṃ nisīditvā tathāgato tattha pāyāsamaggayha nerañjaramupehiti. nerañjarāya tīramhi pāyāsaṃ ādāya so jino paṭiyattavaramaggena bodhimūlamhi ehiti. tato padakkhiṇaṃ katvā bodhimaṇḍaṃ anuttaro assattharukkhamūlamhi bujjhissati mahāyaso. imassa janikā mātā māyā nāma bhavissati, pitā suddhodano nāma, ayaṃ hessati gotamo. kolito upatisso ca, aggā hessanti sāvakā, ānando nāmu’ paṭṭhāko, upaṭṭhissati taṃ jinaṃ. khemā uppalavaṇṇā ca, aggā hessanti sāvikā, bodhi tassa bhagavato, assattho’ti pavuccati. citto ca hatthāḷavako, aggā hessantu’ paṭṭhakā, uttarā nandamātā ca, aggā hessantu’ paṭṭhikā, āyu vassa sataṃ tassa, gotamassa yasassino. idaṃ sutvāna vacanaṃ asamassa mahesino āmoditā naramarū buddhabījaṅkuro ayaṃ. ukkuṭṭhisaddaṃ vattenti apphoṭenti hasanti ca katañjalī namassanti dasa sahassī sadevakā. yadi’massa lokanāthassa virajjhissāma sāsanaṃ anāgatamhi addhāne hessāma sammukhā imaṃ. yathā manussā nadiṃ tarantā paṭititthaṃ virajjhiya heṭṭhā titthe gahetvāna uttaranti mahānadiṃ. eva’meva mayaṃ sabbe yadimuñcāmi’maṃ jinaṃ anāgatamhi addhāne ",
  "bv8:14.3": "hessāma sammukhā imaṃ. ",
  "bv8:15.1": "tassā’pi vacanaṃ sutvā ",
  "bv8:15.2": "haṭṭho saṃviggamānaso ",
  "bv8:15.3": "tamevatthamanuppattiyā ",
  "bv8:15.4": "uggaṃ dhitimakāsahaṃ. ",
  "bv8:16.1": "sudhammaṃ nāma nagaraṃ ",
  "bv8:16.2": "sudhammo nāma khattiyo ",
  "bv8:16.3": "sudhammā nāma janikā ",
  "bv8:16.4": "sobhitassa mahesino. ",
  "bv8:17.1": "navavassasahassāni ",
  "bv8:17.2": "agāramajjhaso vasī ",
  "bv8:17.3": "kumudo kalīro padumo ",
  "bv8:17.4": "tayo pāsādamuttamā. ",
  "bv8:18.1": "sattati sahassāni ",
  "bv8:18.2": "nāriyo samalaṅkatā ",
  "bv8:18.3": "makhīlā nāma sā nārī ",
  "bv8:18.4": "sīho nāmā’si atrajo. ",
  "bv8:19.1": "nimitte caturo disvā ",
  "bv8:19.2": "pāsādenā’bhi nikkhami ",
  "bv8:19.3": "sattā’haṃ padhānācāraṃ ",
  "bv8:19.4": "caritvā purisuttamo ",
  "bv8:20.1": "",
  "bv8:20.2": "",
  "bv8:20.3": "",
  "bv8:20.4": "",
  "bv8:21.1": "",
  "bv8:21.2": "",
  "bv8:21.3": "",
  "bv8:21.4": "",
  "bv8:22.1": "",
  "bv8:22.2": "",
  "bv8:22.3": "bujjhamāno ca so buddho ",
  "bv8:22.4": "nāgamūle abujjhatha. ",
  "bv8:23.1": "brahmunā yācito santo sobhito lokanāyako vatti cakkaṃ mahāvīro sudhamamuyyānamuttame. asamo ca sunetto ca ahesuṃ aggasāvakā anomo nāmu paṭṭhāko sobhitassa mahesino nakulā ca sujātā ca ahesuṃ aggasāvikā. rammo ceva sudatto ca ",
  "bv8:23.2": "ahesuṃ aggupaṭṭhakā ",
  "bv8:23.3": "nakulā ceva cittā ca ",
  "bv8:23.4": "ahesuṃ aggupaṭṭhikā. ",
  "bv8:24.1": "aṭṭhapaññāsa ratanaṃ ",
  "bv8:24.2": "accuggato mahāmuni ",
  "bv8:24.3": "obhāseti disā sabbā ",
  "bv8:24.4": "sataraṃsī’va uggato. ",
  "bv8:25.1": "yathā suphullaṃ pavanaṃ ",
  "bv8:25.2": "nānā gandhehi dhūpitaṃ ",
  "bv8:25.3": "tatheva tassa pāvacanaṃ ",
  "bv8:25.4": "sīlagandhehi dhūpitaṃ. ",
  "bv8:26.1": "yathāpi sāgaro nāma ",
  "bv8:26.2": "dassanena atappiyo ",
  "bv8:26.3": "tathe’va tassa pāvacanaṃ ",
  "bv8:26.4": "savaṇena atappiyaṃ. ",
  "bv8:27.1": "navutivassasahassāni ",
  "bv8:27.2": "āyu vijjati tāvade ",
  "bv8:27.3": "tāvatā tiṭṭhamāno so ",
  "bv8:27.4": "tāresi janataṃ bahuṃ. ",
  "bv8:28.1": "ovādaṃ anusiṭṭhiñca ",
  "bv8:28.2": "datvāna sesake jane ",
  "bv8:28.3": "hūtāsanova tāpetvā ",
  "bv8:28.4": "nibbuto so sa sāvako. ",
  "bv8:29.1": "so ca buddho asamasamo ",
  "bv8:29.2": "te’ca sāvakā balappattā ",
  "bv8:29.3": "sabbaṃ samantarahitaṃ ",
  "bv8:29.4": "nanu rittā sabbasaṅkhārā. ",
  "bv8:30.1": "sobhito varasambuddho ",
  "bv8:30.2": "sīhārāmamhi nibbuto ",
  "bv8:30.3": "dhātu vitthārikaṃ āsi ",
  "bv8:30.4": "tesu tesu padesato’ti. ",
  "bv8:31.1": "sobhita buddhavaṃso chaṭṭho. "
}
