{
  "bv22:0.1": "",
  "bv22:0.2": "20. sikhī buddhavaṃso ",
  "bv22:1.1": "vipassissa aparena ",
  "bv22:1.2": "sambuddho dipaduttamo ",
  "bv22:1.3": "sikhivhayo āsi jino ",
  "bv22:1.4": "asamo appaṭipuggalo. ",
  "bv22:2.1": "mārasenaṃ pamadditvā ",
  "bv22:2.2": "patto sambodhimuttamaṃ ",
  "bv22:2.3": "dhammacakkaṃ pavattesi ",
  "bv22:2.4": "anukampāya pāṇinaṃ. ",
  "bv22:3.1": "dhammacakkaṃ pavattente ",
  "bv22:3.2": "sikhimhi muni puṅgave ",
  "bv22:3.3": "koṭisatasahassānaṃ ",
  "bv22:3.4": "paṭhamā’bhisamayo ahu. ",
  "bv22:4.1": "aparampi dhammaṃ desento ",
  "bv22:4.2": "gaṇaseṭṭhe naruttame ",
  "bv22:4.3": "navutikoṭisahassānaṃ ",
  "bv22:4.4": "dutiyā’bhisamayo ahu. ",
  "bv22:5.1": "yamakaṃ pāṭihīrañca ",
  "bv22:5.2": "dassayante sadevake ",
  "bv22:5.3": "asītikoṭisahassānaṃ ",
  "bv22:5.4": "tatiyā’bhisamayo ahu. ",
  "bv22:6.1": "sannipātā tayo āsuṃ ",
  "bv22:6.2": "sikhissa’pi mahesino ",
  "bv22:6.3": "khīṇāsavānaṃ vimalānaṃ ",
  "bv22:6.4": "santacittāna’tādinaṃ. ",
  "bv22:7.1": "bhikkhusatasahassānaṃ ",
  "bv22:7.2": "paṭhamo āsi samāgamo ",
  "bv22:7.3": "asīti bhikkhusahassānaṃ ",
  "bv22:7.4": "dutiyo āsi samāgamo. ",
  "bv22:8.1": "sattati bhikkhusahassānaṃ ",
  "bv22:8.2": "tatiyo āsi samāgamo ",
  "bv22:8.3": "anupalitto padumaṃ’va ",
  "bv22:8.4": "toyamhi sampavaḍḍhitaṃ. ",
  "bv22:9.1": "ahaṃ tena samayena ",
  "bv22:9.2": "arindamo nāma khattiyo ",
  "bv22:9.3": "sambuddhapamukhaṃ saṅghaṃ ",
  "bv22:9.4": "annapānena tappayiṃ. ",
  "bv22:10.1": "bahuṃ dussavaraṃ datvā ",
  "bv22:10.2": "dussakoṭiṃ anappakaṃ ",
  "bv22:10.3": "alaṅkataṃ hatthiyānaṃ ",
  "bv22:10.4": "sambuddhassa adāsa’haṃ. ",
  "bv22:11.1": "hatthiyānaṃ nimminitvā ",
  "bv22:11.2": "kappiyaṃ upanāmayiṃ ",
  "bv22:11.3": "pūrayiṃ mānasaṃ mayhaṃ ",
  "bv22:11.4": "niccaṃ daḷhamupaṭṭhitaṃ. ",
  "bv22:12.1": "so’pi maṃ buddho vyākāsi ",
  "bv22:12.2": "sikhīlokagganāyako ",
  "bv22:12.3": "ekatiṃse ito kappe ",
  "bv22:12.4": "ayaṃ buddho bhavissati. ",
  "bv22:13.1": "ahūkapilavhayā rammā ",
  "bv22:13.2": "nikkhamitvā tathāgato padhānaṃ padahitvāna katvā dukkara kārikaṃ. ajapālarukkhamūlamhi nisīditvā tathāgato tattha pāyāsamaggayha nerañjaramupehiti. nerañjarāya tīramhi pāyāsaṃ ādāya so jino, paṭiyattavaramaggena bodhimūla’mupehiti. tato padakkhiṇaṃ katvā bodhimaṇḍaṃ anuttaro assattharukkhamūlamhi bujjhissati mahāyaso. imassa janikā mātā māyā nāma bhavissati pitā suddhodano nāma ayaṃ hessati gotamo. anāsavā vītarāgā santacittā samāhitā kolito upatisso ca aggā hessanti sāvakā ānando nāmu’paṭṭhāko upaṭṭhissati taṃ jinaṃ. khemā uppalavaṇṇā ca aggā hessanti sāvikā bodhi tassa bhagavato assattho’ti pavuccati. citto ca hatthāḷavako aggā hessantu’paṭṭhakā uttarā nandamātā ca aggā hessantu’paṭṭhikā āyu vassasataṃ tassa gotamassa yasassino. idaṃ sutvāna vacanaṃ asamassa mahesino āmoditā naramarū buddhabījaṅkuro ayaṃ. ukkuṭṭhi saddaṃ pavattenti apphoṭenti hasanti ca katañjalī namassanti dasasahassī sadevakā. yadi’massa lokanāthassa virajjhissāma sāsanaṃ anāgatamhi addhāne hessāma sammukhā imaṃ. yathā manussā nadiṃ tarantā paṭititthaṃ virajjhiya heṭṭhā titthe gahetvāna uttaranti mahānadiṃ. eva’meva mayaṃ sabbe yadi muñcāmi’maṃ jinaṃ anāgatamhi addhāne ",
  "bv22:13.3": "hessāma sammukhā imaṃ. ",
  "bv22:14.1": "tassā’haṃ vacanaṃ sutvā ",
  "bv22:14.2": "bhiyyo cittaṃ pasādayiṃ ",
  "bv22:14.3": "uttariṃ vata madhiṭṭhāsiṃ ",
  "bv22:14.4": "dasa pāramipūriyā. ",
  "bv22:15.1": "nagaraṃ aruṇavatī nāma ",
  "bv22:15.2": "aruṇavā nāma khattiyo ",
  "bv22:15.3": "pabhāvati nāma janikā ",
  "bv22:15.4": "sikhissa ca mahesino. ",
  "bv22:16.1": "sattavassasahassāni ",
  "bv22:16.2": "agāramajjhaso vasī ",
  "bv22:16.3": "sucando girivasabho ",
  "bv22:16.4": "tayo pāsādamuttamaṃ. catuvīsati ",
  "bv22:17.1": "sahassāni ",
  "bv22:17.2": "nāriyo samalaṅkatā ",
  "bv22:17.3": "sabbakāmā nāma nāri ",
  "bv22:17.4": "atulo nāma atrajo. ",
  "bv22:18.1": "nimitte caturo disvā ",
  "bv22:18.2": "hatthiyānena nikkhami ",
  "bv22:18.3": "aṭṭhamāsaṃ padhānacāraṃ ",
  "bv22:18.4": "acarī purisuttamo. ",
  "bv22:19.1": "brahmunā yācito santo ",
  "bv22:19.2": "sikhī lokagganāyako ",
  "bv22:19.3": "vatti cakkaṃ mahāvīro ",
  "bv22:19.4": "migācire naruttamo. ",
  "bv22:20.1": "abhibhū sambhavo nāma ",
  "bv22:20.2": "ahesuṃ aggasāvakā ",
  "bv22:20.3": "khemaṅkaro nāmu’paṭṭhāko ",
  "bv22:20.4": "sikhissa’pi mahesino. ",
  "bv22:21.1": "makhilā ca padumā ceti ",
  "bv22:21.2": "ahesuṃ aggasāvikā ",
  "bv22:21.3": "bodhi tassa bhagavato ",
  "bv22:21.4": "puṇḍarīkoti vuccati. ",
  "bv22:22.1": "sirivaḍḍho ca nando ca ",
  "bv22:22.2": "ahesuṃ aggu’paṭṭhakā ",
  "bv22:22.3": "cittā ce’va suguttā ca ",
  "bv22:22.4": "ahesuṃ aggu’paṭṭhikā. ",
  "bv22:23.1": "uccattanena so buddho ",
  "bv22:23.2": "sattati hatthamuggato kañcanagghiya ",
  "bv22:23.3": "saṃkāso ",
  "bv22:23.4": "dvattiṃsavaralakkhaṇo. ",
  "bv22:24.1": "tassa byāmappabhā kāyā ",
  "bv22:24.2": "divārattiṃ nirantaraṃ ",
  "bv22:24.3": "diso disaṃ niccharanti ",
  "bv22:24.4": "tīṇiyojanaso pabhā. ",
  "bv22:25.1": "sattativassasahassāni ",
  "bv22:25.2": "āyu tassa mahesino ",
  "bv22:25.3": "tāvatā tiṭṭhamāno so ",
  "bv22:25.4": "tāresi janataṃ bahuṃ. ",
  "bv22:26.1": "dhammameghaṃ pavassetvā ",
  "bv22:26.2": "temayitvā sadevake ",
  "bv22:26.3": "khemantaṃ pāpayitvāna ",
  "bv22:26.4": "nibbuto so sasāvako. ",
  "bv22:27.1": "anuvyañjanasampannaṃ ",
  "bv22:27.2": "dvattiṃsavaralakkhaṇaṃ ",
  "bv22:27.3": "sabbaṃ samantarahitaṃ ",
  "bv22:27.4": "nanu rittā sabbasaṅkhārā. ",
  "bv22:28.1": "sikhī munivaro buddho ",
  "bv22:28.2": "dussārāmamhi nibbuto ",
  "bv22:28.3": "tatthe’va tassa thūpavaro ",
  "bv22:28.4": "tīṇiyojanamuggato. ",
  "bv22:29.1": "sikhī buddhavāso vīsatimo. "
}
