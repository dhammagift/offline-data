{
  "bv18:0.1": "",
  "bv18:0.2": "16. siddhattha buddhavaṃso ",
  "bv18:1.1": "dhammadassissa aparena ",
  "bv18:1.2": "siddhattho lokanāyako ",
  "bv18:1.3": "nihanitvā tamaṃ sabbaṃ ",
  "bv18:1.4": "suriyo abbhuggato yathā ",
  "bv18:2.1": "so’pi patvāna sambodhiṃ ",
  "bv18:2.2": "santārento sadevakaṃ ",
  "bv18:2.3": "abhivassi dhammameghena ",
  "bv18:2.4": "nibbāpento sadevakaṃ. ",
  "bv18:3.1": "tassā’pi atulatejassa ",
  "bv18:3.2": "ahesuṃ abhisamayā tayo ",
  "bv18:3.3": "koṭisatasahassānaṃ ",
  "bv18:3.4": "paṭhamā’bhisamayo ahu. ",
  "bv18:4.1": "punā’paraṃ bhīmarathe ",
  "bv18:4.2": "yadā ahani dundubhiṃ ",
  "bv18:4.3": "tadā navutikoṭīnaṃ ",
  "bv18:4.4": "dutiyā’bhi samayo ahu. ",
  "bv18:5.1": "yadā buddho dhammaṃ desesi ",
  "bv18:5.2": "vehāre so puruttame ",
  "bv18:5.3": "tadā navuti koṭīnaṃ ",
  "bv18:5.4": "tatiyā’bhisamayo ahu. ",
  "bv18:6.1": "sannipātā tayo āsuṃ ",
  "bv18:6.2": "tasmi’mpi dipaduttame ",
  "bv18:6.3": "khīṇāsavānaṃ vimalānaṃ ",
  "bv18:6.4": "santacittāna’tādinaṃ. ",
  "bv18:7.1": "koṭisatānaṃ navutīnaṃ ",
  "bv18:7.2": "asītiyā ca koṭīnaṃ ",
  "bv18:7.3": "ete āsuṃ tayo ṭhānā ",
  "bv18:7.4": "vimalānaṃ samāgame. ",
  "bv18:8.1": "ahaṃ tena samayena ",
  "bv18:8.2": "maṅgalo nāma tāpaso ",
  "bv18:8.3": "uggatejo duppasaho ",
  "bv18:8.4": "abhiññābalasamāhito. ",
  "bv18:9.1": "jambuto phalamā’netvā ",
  "bv18:9.2": "siddhatthassa adāsa’haṃ ",
  "bv18:9.3": "paṭiggahetvā sambuddho ",
  "bv18:9.4": "idaṃ vacana’mabruvi. ",
  "bv18:10.1": "passatha imaṃ tāpasaṃ ",
  "bv18:10.2": "jaṭilaṃ uggatāpanaṃ ",
  "bv18:10.3": "catunavute ito kappe ",
  "bv18:10.4": "ayaṃ buddho bhavissati. ahu kapilavhayā rammā nikkhamitvā tathāgato ",
  "bv18:11.1": "padhānaṃ padahitvāna ",
  "bv18:11.2": "katvā dukkarakārikaṃ. ajapālarukkhamūlamhi nisīditvā tathāgato tattha pāyāsamaggayha nerañjaramupehiti. nerañjarāya tīramhi pāyāsaṃ ādāya so jino paṭiyattavaramaggena bodhimūlaṃhi ehiti. tato padakkhiṇaṃ katvā bodhimaṇḍaṃ anuttaro assattharukkhamūlamhi bujjhissati mahāyaso. imassa janikā mātā, māyā nāma bhavissati pitā suddhodano nāma ayaṃ hessati gotamo. kolito upatisso ca aggā hessanti sāvakā ānando nāmu’paṭṭhāko, upaṭṭhissati taṃ jinaṃ. khemā uppalavaṇṇā ca aggā hessanti sāvikā bodhi tassa bhagavato assattho’ti pavuccati. citto ca hatthāḷavako, aggā hessantu’paṭṭhakā uttarā nandamātā ca aggā hessantu’paṭṭhikā āyu vassa sataṃ tassa gotamassa yasassino. idaṃ sutvāna vacanaṃ asamassa mahesino āmoditā naramarū buddhabījaṅkuro ayaṃ. ukkuṭṭhisaddā vattanti apphoṭenti hasantica katañjalī, namassanti dasasahassīsadevakā. yadimassa lokanāthassa virajjhissāma sāsanaṃ anāgatamhi addhāne hessāma sammukhā imaṃ. yathā manussā nadiṃ tarantā paṭititthaṃ virajjhiya heṭṭhā titthaṃ gahetvāna uttaranti mahānadiṃ. eva’meva mayaṃ sabbe yadi muñcāmi’maṃ jinaṃ anāgatamhi addhāne ",
  "bv18:11.3": "hessāma sammukhā imaṃ. ",
  "bv18:12.1": "tassā’pi vacanaṃ sutvā ",
  "bv18:12.2": "bhiyyo cittaṃ pasādayiṃ ",
  "bv18:12.3": "uttariṃ vatamadhiṭṭhāsiṃ ",
  "bv18:12.4": "dasapārami pūriyā. ",
  "bv18:13.1": "vebhāraṃ nāma nagaraṃ ",
  "bv18:13.2": "udeno nāma khattiyo ",
  "bv18:13.3": "suphassā nāma janikā ",
  "bv18:13.4": "siddhatthassa mahesino. ",
  "bv18:14.1": "dasavassasahassāni ",
  "bv18:14.2": "agāramajjhaso vasī ",
  "bv18:14.3": "kokāsuppalakokanadā ",
  "bv18:14.4": "tayo pāsādamuttamā. ",
  "bv18:15.1": "tisoḷasasahassāni ",
  "bv18:15.2": "nāriyo samalaṅkatā ",
  "bv18:15.3": "sumanā nāma sā nārī ",
  "bv18:15.4": "anupamo nāma atrajo. ",
  "bv18:16.1": "nimitte caturo disvā ",
  "bv18:16.2": "sivikā yānena nikkhami ",
  "bv18:16.3": "anūnadasamāsāni ",
  "bv18:16.4": "padhānaṃ padahī jino. ",
  "bv18:17.1": "brahmunā yācito santo ",
  "bv18:17.2": "siddhattho lokanāyako ",
  "bv18:17.3": "vatti cakkaṃ mahāvīro ",
  "bv18:17.4": "migadāye naruttamo. ",
  "bv18:18.1": "sambalo ca sumitto ca ",
  "bv18:18.2": "ahesuṃ aggasāvakā ",
  "bv18:18.3": "revato nāmu’paṭṭhāko ",
  "bv18:18.4": "siddhatthassa mahesino. ",
  "bv18:19.1": "sīvalā ca surāmā ca ",
  "bv18:19.2": "ahesuṃ aggasāvikā ",
  "bv18:19.3": "bodhi tassa bhagavato ",
  "bv18:19.4": "kaṇikāroti vuccati. ",
  "bv18:20.1": "suppiyo ca samuddo ca ",
  "bv18:20.2": "ahesuṃ aggu’paṭṭhakā ",
  "bv18:20.3": "rammā ceva surammā ca ",
  "bv18:20.4": "ahesuṃ aggu’paṭṭhikā. ",
  "bv18:21.1": "so buddho saṭṭhī ratanaṃ ",
  "bv18:21.2": "ahosi nabhamuggato, ",
  "bv18:21.3": "kañcanagghiya saṃkāso ",
  "bv18:21.4": "dasasahassī virocati. ",
  "bv18:22.1": "so’pi buddho asama samo ",
  "bv18:22.2": "atulo appaṭipuggalo ",
  "bv18:22.3": "vassasatasahassāni ",
  "bv18:22.4": "loke aṭṭhāsi cakkhumā. ",
  "bv18:23.1": "vipulaṃ pabhaṃ dassayitvā ",
  "bv18:23.2": "pupphāpetvāna sāvake ",
  "bv18:23.3": "vilāsetvā ca samāpatyā ",
  "bv18:23.4": "nibbuto so sāsavako. ",
  "bv18:24.1": "siddhattho munivaro buddho ",
  "bv18:24.2": "anomārāmamhi nibbuto ",
  "bv18:24.3": "tatthe’va’ssa thūpavaro ",
  "bv18:24.4": "catuyojanamuggato’ti. ",
  "bv18:25.1": "siddhattha buddhavaṃso soḷasamo. "
}
