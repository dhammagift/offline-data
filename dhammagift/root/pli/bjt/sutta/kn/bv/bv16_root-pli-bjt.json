{
  "bv16:0.1": "",
  "bv16:0.2": "14. atthadassī buddhavaṃso ",
  "bv16:1.1": "tatthe’va maṇḍakappamhi ",
  "bv16:1.2": "atthadassī narāsabho mahā ",
  "bv16:1.3": "tamaṃ nihantvāna ",
  "bv16:1.4": "patto sambodhimuttamaṃ. ",
  "bv16:2.1": "brahmunā yācito santo ",
  "bv16:2.2": "dhammacakkaṃ pavattayī ",
  "bv16:2.3": "amatena tappayī lokaṃ ",
  "bv16:2.4": "dasasahassī sadevakaṃ. ",
  "bv16:3.1": "tassā’pi lokanāthassa ",
  "bv16:3.2": "ahesuṃ abhisamayā tayo ",
  "bv16:3.3": "koṭisatasahassānaṃ ",
  "bv16:3.4": "paṭhamābhisamayo ahu. ",
  "bv16:4.1": "yadā buddho atthadassī ",
  "bv16:4.2": "carati devacārikaṃ ",
  "bv16:4.3": "koṭisatasahassānaṃ ",
  "bv16:4.4": "dutiyā’bhisamayo ahu. ",
  "bv16:5.1": "punāparaṃ yadā buddho ",
  "bv16:5.2": "desesi pitusantike ",
  "bv16:5.3": "koṭisatasahassānaṃ ",
  "bv16:5.4": "tatiyā’bhisamayo ahu. ",
  "bv16:6.1": "sannipātā tayo āsuṃ ",
  "bv16:6.2": "tassā’pi ca mahesino ",
  "bv16:6.3": "khīṇāsavānaṃ vimalānaṃ ",
  "bv16:6.4": "santacittāna’tādinaṃ. ",
  "bv16:7.1": "aṭṭhanavutisahassānaṃ ",
  "bv16:7.2": "paṭhamo āsi samāgamo ",
  "bv16:7.3": "aṭṭhāsītisahassānaṃ ",
  "bv16:7.4": "dutiyo āsi samāgamo. ",
  "bv16:8.1": "aṭṭhasattatisahassānaṃ ",
  "bv16:8.2": "tatiyo āsi samāgamo ",
  "bv16:8.3": "anupādāvimuttānaṃ ",
  "bv16:8.4": "vimalānaṃ mahesinaṃ. ",
  "bv16:9.1": "ahaṃ tena samayena ",
  "bv16:9.2": "jaṭilo uggatāpano ",
  "bv16:9.3": "susīmo nāma nāmena ",
  "bv16:9.4": "mahiyā seṭṭhasammato ",
  "bv16:10.1": "dibbaṃ mandāravaṃ pupphaṃ ",
  "bv16:10.2": "padumaṃ pāricchattakaṃ devalokā ",
  "bv16:10.3": "haritvāna sambuddhaṃ ",
  "bv16:10.4": "abhipūjayiṃ. ",
  "bv16:11.1": "sopi maṃ buddho vyākāsi ",
  "bv16:11.2": "atthadassī mahāmuni ",
  "bv16:11.3": "aṭṭhārase kappasate ",
  "bv16:11.4": "ayaṃ buddho bhavissati. ahu kapilavhayā rammā nikkhamitvā tathāgato ",
  "bv16:12.1": "padhānaṃ padahitvāna ",
  "bv16:12.2": "katvā dukkarakārikaṃ. ajapālarukkhamūlasmiṃ nisīditvā tathāgato tattha pāyāsamaggayha nerañjaramupehiti. nerañjarāya tīramhi pāyāsaṃ ādāya so jino paṭiyattavaramaggena bodhimūlamhi ehiti. tato padakkhiṇaṃ katvā bodhimaṇḍaṃ anuttaro assattharukkhamūlamhi bujjhissati mahāyaso. imassa janikā mātā māyā nāma bhavissati pitā suddhodano nāma ayaṃ hessati gotamo. kolito upatisso ca aggā hessanti sāvakā ānando nā’mupaṭṭhāko upaṭṭhissati taṃ jinaṃ. khemā uppalavaṇṇā ca aggā hessanti sāvikā bodhi tassa bhagavato assattho’ti pavuccati. citto ca hatthāḷavako aggā hessantu’paṭṭhakā uttarā nandamātā ca aggā hessantu’paṭṭhikā āyu vassa sataṃ tassa gotamassa yasassino. idaṃ sutvāna vacanaṃ asamassa mahesino āmoditā naramarū buddhabījaṅkuro ayaṃ. ukkuṭṭhisaddaṃ vattenti apphoṭenti hasanti ca katañjalī namassanti dasasahassī sadevakā. yadimassa lokanāthassa virajjhissāma sāsanaṃ anāgatamhi addhāne hessāma sammukhā imaṃ. yathā manussā nadiṃ tarantā paṭititthaṃ virajjhiya heṭṭhātitthe gahetvāna uttaranti mahānadiṃ. eva’meva mayaṃ sabbe yadi muñcāmi’maṃ jinaṃ anāgatamhi addhāne ",
  "bv16:12.3": "hessāma sammukhā imaṃ. ",
  "bv16:13.1": "tassā’pi vacanaṃ sutvā ",
  "bv16:13.2": "haṭṭho saṃviggamānaso ",
  "bv16:13.3": "uttariṃ vatamadhiṭṭhāsiṃ ",
  "bv16:13.4": "dasapāramipūriyā. ",
  "bv16:14.1": "sobhanaṃ nāma nagaraṃ ",
  "bv16:14.2": "sāgaro nāma khattiyo ",
  "bv16:14.3": "sudassanā nāma janitā ",
  "bv16:14.4": "atthadassissa satthuno. ",
  "bv16:15.1": "dasavassasahassāni ",
  "bv16:15.2": "agāramajjhaso vasī ",
  "bv16:15.3": "amaragirisuragirigirivāhanā ",
  "bv16:15.4": "tayo pāsādamuttamā. ",
  "bv16:16.1": "tettiṃsatisahassāni ",
  "bv16:16.2": "nāriyo samalaṅkatā ",
  "bv16:16.3": "visākhā nāma sā nārī ",
  "bv16:16.4": "selo nāmā’si atrajo. ",
  "bv16:17.1": "nimitte caturo disvā ",
  "bv16:17.2": "assayānena nikkhamī ",
  "bv16:17.3": "anūnaaṭṭhamāsāni ",
  "bv16:17.4": "padhānaṃ padahī jino. ",
  "bv16:18.1": "brahmunā yācito santo ",
  "bv16:18.2": "atthadassī mahāyaso ",
  "bv16:18.3": "vatti cakkaṃ mahāvīro ",
  "bv16:18.4": "anomuyyāne narāsabho. ",
  "bv16:19.1": "santo ca upasanto ca ",
  "bv16:19.2": "ahesuṃ aggasāvakā ",
  "bv16:19.3": "abhayo nāmu’paṭṭhāko ",
  "bv16:19.4": "atthadassissa satthuno. ",
  "bv16:20.1": "dhammā ce’va sudhammā ca ",
  "bv16:20.2": "ahesuṃ aggasāvikā ",
  "bv16:20.3": "bodhi tassa bhagavato ",
  "bv16:20.4": "campako’ti pavuccati. ",
  "bv16:21.1": "nakulo ca nisabho ca ",
  "bv16:21.2": "ahesuṃ aggu’paṭṭhakā ",
  "bv16:21.3": "makilā ca sunandā ca ",
  "bv16:21.4": "ahesuṃ aggu’paṭṭhikā. ",
  "bv16:22.1": "so’pi buddho asamasamo ",
  "bv16:22.2": "asīti ratanuggato ",
  "bv16:22.3": "sobhati sālarājā’va ",
  "bv16:22.4": "uḷurājā’va pūrito. ",
  "bv16:23.1": "tassa pākatikā raṃsī ",
  "bv16:23.2": "anekasatakoṭiyo ",
  "bv16:23.3": "uddhaṃ adho dasadisā ",
  "bv16:23.4": "pharanti yojanaṃ tadā. ",
  "bv16:24.1": "so’pi buddho narāsabho ",
  "bv16:24.2": "sabbasattu’ttamo muni ",
  "bv16:24.3": "vassasatasahassāni ",
  "bv16:24.4": "loke aṭṭhāsi cakkhumā. ",
  "bv16:25.1": "atulaṃ dassetvā obhāsaṃ ",
  "bv16:25.2": "virocetvā sadevake ",
  "bv16:25.3": "so’pi aniccataṃ patto ",
  "bv16:25.4": "yatha’ggu’pādānasaṅkhayā. ",
  "bv16:26.1": "atthadassī jinavaro ",
  "bv16:26.2": "anomārāmamhi nibbuto ",
  "bv16:26.3": "dhātuvitthārikaṃ āsi ",
  "bv16:26.4": "tesu tesu padesato’ti. ",
  "bv16:27.1": "atthadassī buddhavaṃso cuddasamo. "
}
