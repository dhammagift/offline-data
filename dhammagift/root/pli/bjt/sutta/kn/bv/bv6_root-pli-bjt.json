{
  "bv6:0.1": "",
  "bv6:0.2": "4. sumana buddhavaṃso ",
  "bv6:1.1": "maṅgalassa aparena ",
  "bv6:1.2": "sumano nāma nāyako ",
  "bv6:1.3": "sabbadhammehi asamo ",
  "bv6:1.4": "sabbasattāna’ muttamo. so’pi ",
  "bv6:2.1": "tadā amatabheriṃ ",
  "bv6:2.2": "ahanī mekhale pure, ",
  "bv6:2.3": "dhammasaṅkhasamāyuttaṃ ",
  "bv6:2.4": "navaṅgaṃ jinasāsanaṃ. ",
  "bv6:3.1": "nijjinitvā kilese so ",
  "bv6:3.2": "patvā sambodhi’muttamaṃ ",
  "bv6:3.3": "māpesi nagaraṃ satthā ",
  "bv6:3.4": "saddhammapuravaruttamaṃ. ",
  "bv6:4.1": "nirantaraṃ akuṭilaṃ ",
  "bv6:4.2": "ujuṃ vipula vitthataṃ ",
  "bv6:4.3": "māpesi so mahāvīthiṃ ",
  "bv6:4.4": "satipaṭṭhānavaruttamaṃ. ",
  "bv6:5.1": "phale cattāri sāmaññe ",
  "bv6:5.2": "catasso paṭisambhidā ",
  "bv6:5.3": "chaḷabhiññāṭṭha samāpatti ",
  "bv6:5.4": "pasāresi tattha vīthiyaṃ. ",
  "bv6:6.1": "ye appamattā akhilā ",
  "bv6:6.2": "hiri viriyehu’pāgatā ",
  "bv6:6.3": "te te ime guṇavare ",
  "bv6:6.4": "ādiyanti yathā sukhaṃ. ",
  "bv6:7.1": "evametena yogena ",
  "bv6:7.2": "uddharanto mahājanaṃ ",
  "bv6:7.3": "bodhesi paṭhamaṃ satthā ",
  "bv6:7.4": "koṭisatasahassiyo. ",
  "bv6:8.1": "yamhi kāle mahāvīro ",
  "bv6:8.2": "ovadi titthiye gaṇe ",
  "bv6:8.3": "koṭi sahassābhisamiṃsu ",
  "bv6:8.4": "dutiye dhammadesane. ",
  "bv6:9.1": "yadā devā manussā ca ",
  "bv6:9.2": "samaggā ekamānasā ",
  "bv6:9.3": "nirodha pañhaṃ pucchiṃsu ",
  "bv6:9.4": "saṃsayañcā’pi mānasaṃ. ",
  "bv6:10.1": "tadā’pi dhammadesane ",
  "bv6:10.2": "nirodha paridīpane navuti ",
  "bv6:10.3": "koṭi sahassānaṃ ",
  "bv6:10.4": "tatiyā’bhisamayo ahu. ",
  "bv6:11.1": "sannipātā tayo āsuṃ ",
  "bv6:11.2": "sumanassa mahesino ",
  "bv6:11.3": "khīṇāsavānaṃ vimalānaṃ ",
  "bv6:11.4": "santa cittāna tādinaṃ. ",
  "bv6:12.1": "vassaṃ vutthassa bhagavato ",
  "bv6:12.2": "abhighuṭṭhe pavāraṇe ",
  "bv6:12.3": "koṭisatasahassehi ",
  "bv6:12.4": "pavāresi tathāgato. ",
  "bv6:13.1": "tato paraṃ sannipāte ",
  "bv6:13.2": "vimale kañcana pabbate ",
  "bv6:13.3": "navutikoṭisahassānaṃ ",
  "bv6:13.4": "dutiyo āsi samāgamo. ",
  "bv6:14.1": "yadā sakko devarājā ",
  "bv6:14.2": "buddhadassanu’pāgami ",
  "bv6:14.3": "asītikoṭisahassānaṃ ",
  "bv6:14.4": "tatiyo āsi samāgamo. ",
  "bv6:15.1": "ahaṃ tena samayena ",
  "bv6:15.2": "nāgarājā mahiddhiko ",
  "bv6:15.3": "atulo nāma nāmena ",
  "bv6:15.4": "ussannakusalasañcayo. ",
  "bv6:16.1": "tadā’haṃ nāgabhavanā ",
  "bv6:16.2": "nikkhamitvā sa ñātihi ",
  "bv6:16.3": "nāgānaṃ dibbaturiyehi ",
  "bv6:16.4": "sasaṅghaṃ jinamupaṭṭhahiṃ. ",
  "bv6:17.1": "koṭi sata sahassānaṃ ",
  "bv6:17.2": "annapānena tappayiṃ ",
  "bv6:17.3": "paccekaṃ dussayugaṃ datvā ",
  "bv6:17.4": "saraṇaṃ taṃ upāgamiṃ. ",
  "bv6:18.1": "sopi maṃ buddho vyākāsi ",
  "bv6:18.2": "sumano loka nāyako ",
  "bv6:18.3": "aparimeyye ito kappe ",
  "bv6:18.4": "ayaṃ buddho bhavissati. ahu kapilavhayā rammā nikkhamitvā tathāgato ",
  "bv6:19.1": "padhānaṃ padahitvāna ",
  "bv6:19.2": "katvā dukkarakārikaṃ. ajapālarukkhamūlasmiṃ nisīditvā tathāgato tattha pāyāsamaggayha nerañjara mupehiti. nerañjarāya tīramhi pāyāsaṃ ādāya so jino paṭiyattavaramaggena bodhimūlamhi ehiti. tato padakkhiṇaṃ katvā bodhimaṇḍaṃ anuttaro assattha rukkhamūlamhi bujjhissati mahāyaso. imassa janikā mātā māyā nāma bhavissati pitā suddhodano nāma ayaṃ hessati gotamo. kolito upatisso ca aggāhessanti sāvakā ānando nāmu’paṭṭhāko upaṭṭhissati taṃ jinaṃ. khemā uppalavaṇṇā ca aggā hessanti sāvikā bodhi tassa bhagavato assattho’ti pavuccati. citto ca hatthāḷavako aggā hessantu’paṭṭhakā uttarā nandamātā ca aggā hessantu’paṭṭhikā āyu vassa sataṃ tassa gotamassa yasassino. idaṃ sutvāna vacanaṃ asamassa mahesino āmoditā naramarū buddha bījaṅkuro ayaṃ. ukkuṭṭhi saddaṃ vattenti apphoṭenti hasanti ca katañjalī namassanti dasa sahassī sadevakā. yadi’massa loka nāthassa virajjhissāma sāsanaṃ anāgatamhi addhāne hessāma sammukhā imaṃ. yathā manussā nadiṃ tarantā paṭititthaṃ virajjhiya heṭṭhā titthe gahetvāna uttaranti mahānadiṃ. eva’meva mayaṃ sabbe yadi muñcāmi’maṃ jinaṃ anāgatamhi addhāne ",
  "bv6:19.3": "hessāma sammukhā imaṃ. ",
  "bv6:20.1": "tassā’pi vacanaṃ sutvā ",
  "bv6:20.2": "bhiyyo cittaṃ pasādayiṃ ",
  "bv6:20.3": "uttariṃ vatamadhiṭṭhāsiṃ ",
  "bv6:20.4": "dasapārami ",
  "bv6:21.1": "pūriyā. mekhalaṃ nāma nagaraṃ ",
  "bv6:21.2": "sudatto nāma khattiyo ",
  "bv6:21.3": "sirimā nāma janikā ",
  "bv6:21.4": "sumanassa mahesino. ",
  "bv6:22.1": "nava vassa ",
  "bv6:22.2": "sahassāni agāramajjha so vasī ",
  "bv6:22.3": "cando sucando vaṭaṃso ca ",
  "bv6:22.4": "tayo pāsādamuttamā. ",
  "bv6:23.1": "te saṭṭhisahassāni ",
  "bv6:23.2": "nāriyo samalaṅkatā, ",
  "bv6:23.3": "vaṭaṃsikā nāma nārī ",
  "bv6:23.4": "anupamo nāma atrajo. ",
  "bv6:24.1": "nimitte caturo disvā ",
  "bv6:24.2": "hatthiyānena nikkhami ",
  "bv6:24.3": "anūnadasamāsāni ",
  "bv6:24.4": "padhānaṃ padahī jino. ",
  "bv6:25.1": "brahmunā yācito santo ",
  "bv6:25.2": "sumano loka nāyako ",
  "bv6:25.3": "vatti cakkaṃ mahāvīro ",
  "bv6:25.4": "mekhale puramuttame. ",
  "bv6:26.1": "saraṇo bhāvitatto ca ",
  "bv6:26.2": "ahesuṃ aggasāvakā ",
  "bv6:26.3": "udeno nāmu’paṭṭhāko ",
  "bv6:26.4": "sumanassa mahesino. ",
  "bv6:27.1": "soṇā ca upasoṇā ca ",
  "bv6:27.2": "ahesuṃ aggasāvikā ",
  "bv6:27.3": "so’pi buddho amitayaso ",
  "bv6:27.4": "nāgamūle abujjhatha. ",
  "bv6:28.1": "varuṇo ca saraṇo ca ",
  "bv6:28.2": "ahesuṃ aggu’paṭṭhakā ",
  "bv6:28.3": "cālā ca upacālā ca ",
  "bv6:28.4": "ahesuṃ aggupaṭṭhikā. ",
  "bv6:29.1": "uccattanena so buddho ",
  "bv6:29.2": "navutihatthasamuggato kañcanagghiya ",
  "bv6:29.3": "saṃkāso dasa ",
  "bv6:29.4": "sahassī virocati. ",
  "bv6:30.1": "navuti vassa ",
  "bv6:30.2": "sahassāni āyuvijjati tāvade ",
  "bv6:30.3": "tāvatā tiṭṭhamāno so ",
  "bv6:30.4": "tāresi janataṃ bahuṃ. ",
  "bv6:31.1": "tāraṇīye tārayitvā ",
  "bv6:31.2": "bodhanīye ca bodhayī ",
  "bv6:31.3": "parinibbāyi sambuddho ",
  "bv6:31.4": "uḷurājā’ca atthamī. ",
  "bv6:32.1": "te’pi khīṇāsavā bhikkhu ",
  "bv6:32.2": "so ca buddho asādiso ",
  "bv6:32.3": "atulaṃ pahaṃ dassayitvā ",
  "bv6:32.4": "nibbutā te mahāyasā. ",
  "bv6:33.1": "tañca ñāṇaṃ atuliyaṃ ",
  "bv6:33.2": "tāni cā’tuliyāni ratanāni ",
  "bv6:33.3": "sabbaṃ samantarahitaṃ ",
  "bv6:33.4": "nanu rittā sabbasaṅkhārā. ",
  "bv6:34.1": "sumano yasadharo buddho ",
  "bv6:34.2": "aṅgāramamhi nibbuto ",
  "bv6:34.3": "tatve’va tassa jinathūpo ",
  "bv6:34.4": "catuyojana ",
  "bv6:35.1": "muggato’ti. sumana buddhavaṃso catuttho. "
}
