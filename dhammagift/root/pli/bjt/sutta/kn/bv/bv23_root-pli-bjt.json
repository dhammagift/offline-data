{
  "bv23:0.1": "",
  "bv23:0.2": "21. vessabhū buddhavaṃso ",
  "bv23:1.1": "tattheva maṇḍakappamhi ",
  "bv23:1.2": "asamo appaṭipuggalo ",
  "bv23:1.3": "vessabhū nāma nāmena ",
  "bv23:1.4": "loke uppajji nāyako. ",
  "bv23:2.1": "ādittanti ca rāgaggi ",
  "bv23:2.2": "taṇhānaṃ vijitaṃ tadā ",
  "bv23:2.3": "nāgo’va bandhanaṃ chetvā ",
  "bv23:2.4": "patto sambodhimuttamaṃ. ",
  "bv23:3.1": "dhammacakkaṃ pavattente ",
  "bv23:3.2": "vessabhūlokanāyake ",
  "bv23:3.3": "asītikoṭisahassānaṃ ",
  "bv23:3.4": "paṭhamā’bhisamayo ahu. ",
  "bv23:4.1": "pakkante cārikaṃ raṭṭhe ",
  "bv23:4.2": "lokajeṭṭhe narāsabhe ",
  "bv23:4.3": "sattati koṭisahassānaṃ ",
  "bv23:4.4": "dutiyā’bhisamayo ahu. ",
  "bv23:5.1": "mahādiṭṭhiṃ vinodento ",
  "bv23:5.2": "pāṭihīraṃ karoti so ",
  "bv23:5.3": "samāgatā naramarū ",
  "bv23:5.4": "dasasahassī sadevake. ",
  "bv23:6.1": "mahā acchariyaṃ disvā ",
  "bv23:6.2": "abbhutaṃ lomahaṃsanaṃ ",
  "bv23:6.3": "devā ce va manussā ca ",
  "bv23:6.4": "bujjhare saṭṭhikoṭiyo. ",
  "bv23:7.1": "sannipātā tayo āsuṃ ",
  "bv23:7.2": "vessabhussa mahesino ",
  "bv23:7.3": "khīṇāsavānaṃ vimalānaṃ ",
  "bv23:7.4": "santacittāna’tādinaṃ. ",
  "bv23:8.1": "asītibhikkhusahassānaṃ ",
  "bv23:8.2": "paṭhamo āsi samāgamo ",
  "bv23:8.3": "sattatibhikkhusahassānaṃ ",
  "bv23:8.4": "dutiyo āsi samāgamo. ",
  "bv23:9.1": "saṭṭhi bhikkhusahassānaṃ ",
  "bv23:9.2": "tatiyo āsi samāgamo ",
  "bv23:9.3": "jarādi bhayā’tītānaṃ ",
  "bv23:9.4": "orasānaṃ mahesino. ",
  "bv23:10.1": "ahaṃ tena samayena ",
  "bv23:10.2": "sudassano nāma khattiyo ",
  "bv23:10.3": "nimantetvā mahāvīraṃ ",
  "bv23:10.4": "dānaṃ datvā mahārahaṃ ",
  "bv23:10.5": "annapānena vatthena ",
  "bv23:10.6": "sasaṅghaṃ jinamapūjayiṃ. ",
  "bv23:11.1": "tassa buddhassa asamassa ",
  "bv23:11.2": "cakkaṃ vattita’muttamaṃ ",
  "bv23:11.3": "sutvāna paṇītaṃ dhammaṃ ",
  "bv23:11.4": "pabbajja’mabhirocayiṃ. ",
  "bv23:12.1": "mahādānaṃ pavattetvā ",
  "bv23:12.2": "rattiṃ divamatandito ",
  "bv23:12.3": "pabbajjaṃ guṇasampannaṃ ",
  "bv23:12.4": "pabbajiṃ jinasantike. ",
  "bv23:13.1": "ācāraguṇasampanno ",
  "bv23:13.2": "vattasīlasamāhito ",
  "bv23:13.3": "sabbaññutaṃ gavesanto ",
  "bv23:13.4": "ramāmī jinasāsane ",
  "bv23:14.1": "saddhāpītimu’pāgantvā ",
  "bv23:14.2": "pāde vandāmi satthari ",
  "bv23:14.3": "pīti uppajjatī mayhaṃ ",
  "bv23:14.4": "bodhiyāye’va kāraṇā. ",
  "bv23:15.1": "anivattimānasaṃ ñatvā ",
  "bv23:15.2": "sambuddho etada’bravi ",
  "bv23:15.3": "ekatiṃse ito kappe ",
  "bv23:15.4": "ayaṃ buddho bhavissati. ",
  "bv23:16.1": "ahū kapilavhayā rammā ",
  "bv23:16.2": "nikkhamitvā tathāgato padhānaṃ padahitvāna katvā dukkarakārikaṃ. ajapālarukkhamūlamhi nisīditvā tathāgato tattha pāyāsaṃ paggayha neraṃjaramupehiti. nerañjarāya tīramhi pāyāsaṃ ādāya so jino paṭiyattavaramaggena bodhimūlamupehiti. tato padakkhiṇaṃ katvā bodhimaṇḍaṃ anuttaro assattharukkhamūlamhi bujjhissati mahāyaso. imassa janikā mātā māyā nāma bhavissati pitā suddhodano nāma ayaṃ hessati gotamo. anāsavā vītarāgā santacittā samāhitā kolito upatisso ca aggā hessanti sāvakā ānando nāmu’paṭṭhāko upaṭṭhissati taṃ jinaṃ khemā uppalavaṇṇā ca aggā hessanti sāvikā bodhi tassa bhagavato assattho’ti pavuccati. citto ca hatthāḷavako aggā hessantu’paṭṭhakā uttarā nandamātā ca aggā hessantu paṭṭhikā āyu vassasataṃ tassa gotamassa yasassino. idaṃ sutvāna vacanaṃ asamassa mahesino āmoditā naramarū buddhabījaṅkuro ayaṃ. ukkuṭṭhisaddaṃ vattenti apphoṭenti hasanti ca katañjalī namassanti dasasahassī sadevakā. yadi’massa lokanāthassa virajjhissāma sāsanaṃ anāgatamhi addhāne hessāma sammukhā imaṃ. yathā manussā nadiṃ tarantā paṭititthaṃ virajjhiya heṭṭhā titthe gahetvāna uttaranti mahānadiṃ. eva’meva mayaṃ sabbe yadi muñcāmi maṃ jinaṃ anāgatamhi addhāne ",
  "bv23:16.3": "hessāma sammukhā imaṃ. ",
  "bv23:17.1": "tassā’haṃ vacanaṃ sutvā ",
  "bv23:17.2": "bhiyyo cittaṃ pasādayiṃ ",
  "bv23:17.3": "uttariṃ vatamadhiṭṭhāsiṃ ",
  "bv23:17.4": "dasapāramipūriyā. ",
  "bv23:18.1": "anupamaṃ nāma nagaraṃ ",
  "bv23:18.2": "suppatīto nāma khattiyo ",
  "bv23:18.3": "mātā yasavatī nāma ",
  "bv23:18.4": "vessabhussa mahesino. ",
  "bv23:19.1": "chabbassasahassāni ",
  "bv23:19.2": "agāramajjha so vasī ",
  "bv23:19.3": "rucisurucirativaḍḍhano ",
  "bv23:19.4": "tayo pāsādamuttamā. ",
  "bv23:20.1": "anūnatiṃsasahassāni ",
  "bv23:20.2": "nāriyo samalaṅkatā ",
  "bv23:20.3": "sucittā nāma sā nārī ",
  "bv23:20.4": "suppabuddho nāma atrajo. ",
  "bv23:21.1": "nimitte caturo disvā ",
  "bv23:21.2": "sivikāyā’bhinikkhami ",
  "bv23:21.3": "cha māsaṃ padhānacāraṃ ",
  "bv23:21.4": "acarī purisuttamo. ",
  "bv23:22.1": "brahmunā yācito santo ",
  "bv23:22.2": "vessabhulokanāyako ",
  "bv23:22.3": "vatti cakkaṃ mahāvīro ",
  "bv23:22.4": "aruṇārāme naruttamo. ",
  "bv23:23.1": "soṇo ca uttaro ceva ",
  "bv23:23.2": "ahesuṃ aggasāvakā ",
  "bv23:23.3": "upasanto nāmu’paṭṭhāko ",
  "bv23:23.4": "vessabhussa mahesino. ",
  "bv23:24.1": "dāmā ceva samālā ca ",
  "bv23:24.2": "ahesuṃ aggasāvikā ",
  "bv23:24.3": "bodhi tassa bhagavato ",
  "bv23:24.4": "sālo iti pavuccati ",
  "bv23:25.1": "sotthiko ceva rammo ca ",
  "bv23:25.2": "ahesuṃ aggu’paṭṭhakā ",
  "bv23:25.3": "gotamī ca sirimā ca ",
  "bv23:25.4": "ahesuṃ aggu’paṭṭhikā. ",
  "bv23:26.1": "saṭṭhiratanamubbedho ",
  "bv23:26.2": "hemayūpasamūpamo ",
  "bv23:26.3": "kāyā niccharatī raṃsi rattiṃ ",
  "bv23:26.4": "sikhī va pabbate. ",
  "bv23:27.1": "saṭṭhivassasahassāni ",
  "bv23:27.2": "āyu vijjati tāvade ",
  "bv23:27.3": "tāvatā tiṭṭhamāno so ",
  "bv23:27.4": "tāresi janataṃ bahuṃ. ",
  "bv23:28.1": "dhammaṃ vitthārikaṃ katvā ",
  "bv23:28.2": "vibhajitvā mahājanaṃ ",
  "bv23:28.3": "dhammanāvaṃ ṭhapetvāna ",
  "bv23:28.4": "nibbuto so sasāvako. ",
  "bv23:29.1": "dassanīyaṃ sabbajanaṃ ",
  "bv23:29.2": "vihārañciriyāpathaṃ ",
  "bv23:29.3": "sabbaṃ samantarahitaṃ ",
  "bv23:29.4": "nanu rittā sabbasaṅkhārā ",
  "bv23:30.1": "vessabhū jinavaro satthā ",
  "bv23:30.2": "khemārāmamhi nibbuto ",
  "bv23:30.3": "dhātu vitthārikaṃ āsī ",
  "bv23:30.4": "tesu tesu padesatoti. ",
  "bv23:31.1": "vessabhū buddhavaṃso ekavīsatimo. "
}
