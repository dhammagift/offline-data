{
  "bv10:0.1": "",
  "bv10:0.2": "8. paduma buddhavaṃso ",
  "bv10:1.1": "anoma dassissa aparena ",
  "bv10:1.2": "sambuddho dipaduttamo ",
  "bv10:1.3": "padumo nāma nāmena ",
  "bv10:1.4": "asamo appaṭipuggalo. ",
  "bv10:2.1": "tassā’pi asamaṃ sīlaṃ ",
  "bv10:2.2": "samādhi’pi anantako ",
  "bv10:2.3": "asaṅkheyyaṃ ñāṇavaraṃ ",
  "bv10:2.4": "vimutti ca anūpamā. ",
  "bv10:3.1": "tassā’pi atulatejassa ",
  "bv10:3.2": "dhammacakkappavattane ",
  "bv10:3.3": "abhisamayā tayo āsuṃ ",
  "bv10:3.4": "mahātamapavāhanā. ",
  "bv10:4.1": "paṭhamābhisamaye buddho ",
  "bv10:4.2": "koṭisatamabodhayī ",
  "bv10:4.3": "dutiyābhisamaye dhīro ",
  "bv10:4.4": "navutikoṭimabodhayī. ",
  "bv10:5.1": "yadā ca padumo buddho ",
  "bv10:5.2": "ovadī sakama’trajaṃ ",
  "bv10:5.3": "tadā asītikoṭīnaṃ ",
  "bv10:5.4": "tatiyā’bhisamayo ahu. ",
  "bv10:6.1": "sannipātā tayo āsuṃ ",
  "bv10:6.2": "padumassa mahesino, ",
  "bv10:6.3": "koṭisatasahassānaṃ ",
  "bv10:6.4": "paṭhamo āsi samāgamo. ",
  "bv10:7.1": "kaṭhinatthārasamaye ",
  "bv10:7.2": "uppanne kaṭhinacīvare ",
  "bv10:7.3": "dhammasenāpata’tthāya ",
  "bv10:7.4": "bhikkhu sibbiṃsu cīvaraṃ. ",
  "bv10:8.1": "tadā te vimalā bhikkhu ",
  "bv10:8.2": "chaḷabhiññā mahiddhikā ",
  "bv10:8.3": "tīṇi satasahassāni ",
  "bv10:8.4": "samiṃsu aparājitā. ",
  "bv10:9.1": "punāparaṃ so narāsabho ",
  "bv10:9.2": "pavane vāsaṃ upāgato ",
  "bv10:9.3": "tadā samāgamo āsā ",
  "bv10:9.4": "dvinnaṃ satasahassānaṃ. ",
  "bv10:10.1": "ahaṃ tena samayena ",
  "bv10:10.2": "sīho āsiṃ migādhibhū ",
  "bv10:10.3": "pavivekamanubrūhantaṃ ",
  "bv10:10.4": "pavane addasaṃ jinaṃ. ",
  "bv10:11.1": "vanditvā sirasā pāde ",
  "bv10:11.2": "katvāna taṃ padakkhiṇaṃ ",
  "bv10:11.3": "tikkhattuṃ abhināditvā. ",
  "bv10:11.4": "sattāhaṃ jinamupaṭṭhahiṃ. ",
  "bv10:12.1": "sattāhaṃ varasamāpattiyā ",
  "bv10:12.2": "uṭṭhahitvā tathāgato ",
  "bv10:12.3": "manasā cintayitvāna ",
  "bv10:12.4": "koṭibhikkhu samānayī. ",
  "bv10:13.1": "tadāpi so mahāvīro ",
  "bv10:13.2": "tesaṃ majjhe viyākarī ",
  "bv10:13.3": "aparimeyye ito kappe ",
  "bv10:13.4": "ayaṃ buddho bhavissati. ahu kapilamhayā rammā nikkhamitvā tathāgato ",
  "bv10:14.1": "padhānaṃ padahitvāna ",
  "bv10:14.2": "katvā dukkarakārikaṃ. ajapālarukkhamūlasmiṃ nisīditvā tathāgato tattha pāyāsamaggayha nerañjaramupehiti. nerañjarāya tīramhi pāyāsaṃ ādāya so jino paṭiyattavaramaggena bodhimūlamhi ehiti. tato padakkhiṇaṃ katvā bodhimaṇḍaṃ anuttaro assattharukkhamūlamhi bujjhissati mahāyaso. imassa janikā mātā māyā nāma bhavissati pitā suddhodano nāma ayaṃ hessati gotamo. kolito upatisso ca aggā hessanti sāvakā ānando nāmupaṭṭhāko upaṭṭhissati taṃ jinaṃ. khemā uppalavaṇṇā ca aggā hessanti sāvikā bodhi tassa bhagavato assattho’ti pavuccati. citto ca hatthāḷavako aggā hessantu’paṭṭhakā uttarā nandamātā ca aggā hessantu’paṭṭhikā āyu vassa sataṃ tassa gotamassa yasassino. idaṃ sutvāna vacanaṃ asamassa mahesino āmoditā naramarū buddhabījaṅkuro ayaṃ. ukkuṭṭhisaddaṃ vattenti apphoṭhenti hasanti ca katañjalī namassanti dasasahassī sadevakā. yadi’massa lokanāthassa virajjhissāma sāsanaṃ anāgatamhi addhāne hessāma sammukhā imaṃ. yathā manussā nadiṃ tarantā paṭititthaṃ virajjhiya heṭṭhā titthe gahetvāna uttaranti mahānadiṃ. eva’meva mayaṃ sabbe yadi muñcāmi’maṃ jinaṃ anāgatamhi addhāne ",
  "bv10:14.3": "hessāma sammukhā imaṃ. ",
  "bv10:15.1": "tassā’pi vacanaṃ sutvā ",
  "bv10:15.2": "bhiyyo cittaṃ pasādayiṃ ",
  "bv10:15.3": "uttariṃ vatamadhiṭṭhāsiṃ ",
  "bv10:15.4": "dasapārami pūriyā. ",
  "bv10:16.1": "campakaṃ nāma nagaraṃ ",
  "bv10:16.2": "asamo nāma khattiyo ",
  "bv10:16.3": "asmā nāma janikā ",
  "bv10:16.4": "padumassa mahesino. ",
  "bv10:17.1": "dasavassasahassāni ",
  "bv10:17.2": "agāramajjhaso vasi ",
  "bv10:17.3": "uttaravasuyasuttarā. ",
  "bv10:17.4": "tayo pāsādamuttamā. ",
  "bv10:18.1": "tettiṃsa satasahassāni ",
  "bv10:18.2": "nāriyo samalaṅkatā ",
  "bv10:18.3": "uttarā nāma sā nāri ",
  "bv10:18.4": "rammo nāmā’si atrajo. ",
  "bv10:19.1": "nimitte caturo disvā ",
  "bv10:19.2": "rathayānena nikkhamī ",
  "bv10:19.3": "anūnaaṭṭhamāsāni ",
  "bv10:19.4": "padhānaṃ padahī jino. ",
  "bv10:20.1": "brahmunā yācito’santo ",
  "bv10:20.2": "padumo lokanāyako ",
  "bv10:20.3": "vatti cakkaṃ mahāvīro ",
  "bv10:20.4": "dhanañjayuyyānamuttame. ",
  "bv10:21.1": "sālo ca upasālo ca ",
  "bv10:21.2": "ahesuṃ aggasāvakā ",
  "bv10:21.3": "varuṇo nāmu’paṭṭhāko ",
  "bv10:21.4": "padumassa mahesino. ",
  "bv10:22.1": "rādhā ce’va surādhā’ca ",
  "bv10:22.2": "ahesuṃ aggasāvikā ",
  "bv10:22.3": "bodhi tassa bhagavato ",
  "bv10:22.4": "mahāsoṇo’ti vuccati. ",
  "bv10:23.1": "bhiyyo ceva asamo ca ",
  "bv10:23.2": "ahesuṃ aggu’paṭṭhakā ",
  "bv10:23.3": "rucī ca nandarāmā ca ",
  "bv10:23.4": "ahesuṃ aggupaṭṭhikā. ",
  "bv10:24.1": "aṭṭhapaññāsaratanaṃ ",
  "bv10:24.2": "accuggato mahāmunī ",
  "bv10:24.3": "pabhā niddhāvati tassa ",
  "bv10:24.4": "asmā sabbato disā. ",
  "bv10:25.1": "candappabhā suriyappabhā ",
  "bv10:25.2": "ratanaggi-maṇippabhā ",
  "bv10:25.3": "sabbā’pi tā hatā honti ",
  "bv10:25.4": "patvā jinapabhuttamaṃ. ",
  "bv10:26.1": "vassasatasahassāni ",
  "bv10:26.2": "āyu vijjati tāvade ",
  "bv10:26.3": "tāvatā tiṭṭhamāno so ",
  "bv10:26.4": "tāresi janataṃ bahuṃ. ",
  "bv10:27.1": "paripakkamānase satte ",
  "bv10:27.2": "bodhayitvā asesato ",
  "bv10:27.3": "sesa’ññe anusāsitvā ",
  "bv10:27.4": "nibbuto so sasāvako. ",
  "bv10:28.1": "uragova tacaṃ jiṇṇaṃ ",
  "bv10:28.2": "vaddhaṃ pattaṃ’va pādapo ",
  "bv10:28.3": "jahitvā sabbasaṅkhāre ",
  "bv10:28.4": "nibbuto so yathā sikhī. ",
  "bv10:29.1": "padumo jinavaro satthā ",
  "bv10:29.2": "dhammārāmamhi nibbuto ",
  "bv10:29.3": "dhātuvitthārikaṃ āsi ",
  "bv10:29.4": "tesu tesu padesato. ",
  "bv10:30.1": "padumabuddhavaṃso aṭṭhamo. "
}
