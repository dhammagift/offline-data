{
  "bv12:0.1": "",
  "bv12:0.2": "10. padumuttara buddhavaṃso ",
  "bv12:1.1": "nāradassa aparena ",
  "bv12:1.2": "sambuddho dipaduttamo ",
  "bv12:1.3": "padumuttaro nāma jino ",
  "bv12:1.4": "akkhobho sāgarūpamo. ",
  "bv12:2.1": "maṇḍakappo’va so āsi ",
  "bv12:2.2": "yamhi buddho ajāyatha ",
  "bv12:2.3": "ussantakusalā janatā ",
  "bv12:2.4": "tamhi kappe ajāyatha. ",
  "bv12:3.1": "padumuttarassa bhagavato ",
  "bv12:3.2": "paṭhame dhammadesane ",
  "bv12:3.3": "koṭisatasahassānaṃ ",
  "bv12:3.4": "dhammābhisamayo ahu. ",
  "bv12:4.1": "tato parampi vassante ",
  "bv12:4.2": "tappayante ca pāṇino ",
  "bv12:4.3": "sattatiṃsasatasahassānaṃ ",
  "bv12:4.4": "dutiyā’bhisamayo ahū. ",
  "bv12:5.1": "yamhi kāle mahāvīro ",
  "bv12:5.2": "ānandaṃ upasaṅkami ",
  "bv12:5.3": "pitusantikamupāgantvā ",
  "bv12:5.4": "ahani amatadundubhiṃ. ",
  "bv12:6.1": "āhate amatabherimhi ",
  "bv12:6.2": "vassante dhammavuṭṭhiyā ",
  "bv12:6.3": "paññāsasatasahassānaṃ ",
  "bv12:6.4": "tatiyā’bhisamayo ahu. ",
  "bv12:7.1": "ovādako viññāpako ",
  "bv12:7.2": "tārako sabbapāṇinaṃ ",
  "bv12:7.3": "desanākusalo buddho ",
  "bv12:7.4": "tāresi janataṃ bahuṃ. ",
  "bv12:8.1": "sannipātā tayo āsuṃ ",
  "bv12:8.2": "padumuttarassa satthuno ",
  "bv12:8.3": "koṭisatasahassānaṃ ",
  "bv12:8.4": "paṭhamo āsi samāgamo. ",
  "bv12:9.1": "yadā buddho asamasamo ",
  "bv12:9.2": "vasī vehārapabbate ",
  "bv12:9.3": "navutikoṭisahassānaṃ ",
  "bv12:9.4": "dutiyo āsi samāgamo. ",
  "bv12:10.1": "puna cārikaṃ pakkante ",
  "bv12:10.2": "gāmanigamaraṭṭhato ",
  "bv12:10.3": "asītikoṭisahassānaṃ ",
  "bv12:10.4": "tatiyo āsi samāgamo. ",
  "bv12:11.1": "ahaṃ tena samayena ",
  "bv12:11.2": "jaṭilo nāma raṭṭhiko ",
  "bv12:11.3": "sambuddhapamukhaṃ saṅghaṃ ",
  "bv12:11.4": "sahattaṃ dussama’dāsa’haṃ. ",
  "bv12:12.1": "so’pi maṃ buddho vyākāsi ",
  "bv12:12.2": "saṅghamajjhe nisīdiya ",
  "bv12:12.3": "satasahasse ito kappe ",
  "bv12:12.4": "ayaṃ buddho bhavissati. ahu kapilavhayā rammā nikkhamitvā tathāgato. ",
  "bv12:13.1": "padhānaṃ padahitvāna ",
  "bv12:13.2": "katvā dukkarakārikaṃ. ajapālarukkhamūlasmiṃ nisīditvā tathāgato tattha pāyāsamaggayha nerañjaramupehiti. nerañjarāya tīramhi pāyāsaṃ ādāya so jino paṭiyattavaramaggena bodhimūlamhi ehiti. tato padakkhiṇaṃ katvā bodhimaṇḍaṃ anuttaro assattharukkhamūlamhi bujjhissati mahāyaso. imassa janikā mātā māyā nāma bhavissati pitā suddhodano nāma ayaṃ hessati gotamo. kolito upatisso ca aggā hessanti sāvakā ānando nāmu’paṭṭhāko upaṭṭhissati taṃ jinaṃ. khemā uppalavaṇṇā ca aggāhessanti sāvikā bodhi tassa bhagavato assatthoti pavuccati. citto ca hatthāḷavako aggā hessantu’paṭṭhakā uttarā nandamātā ca aggā hessantu’paṭṭhikā āyu vassasataṃ tassa gotamassa yasassino. idaṃ sutvāna vacanaṃ asamassa mahesino āmoditā naramarū buddhabījaṅkuro ayaṃ. ukkuṭṭhisaddaṃ vattenti apphoṭenti hasanti ca katañjalī namassanti dasasahassī sadevakā. yadi’massa lokanāthassa virajjhissāma sāsanaṃ anāgatamhi addhāne hessāma sammukhā imaṃ. yathā manussā nadiṃ tarantā paṭititthaṃ virajjhiya heṭṭhā titthe gahetvāna uttaranti mahānadiṃ. eva’meva mayaṃ sabbe yadi muñcāmi’maṃ jinaṃ anāgatamhi addhāne ",
  "bv12:13.3": "hessāma sammukhā imaṃ. ",
  "bv12:14.1": "tassā’pi vacanaṃ sutvā ",
  "bv12:14.2": "uttariṃ vatamadhiṭṭhahiṃ ",
  "bv12:14.3": "akāsi’muggaṃ daḷhadhītiṃ ",
  "bv12:14.4": "dasapāramipūriyā. ",
  "bv12:15.1": "vyāhatā titthiyā sabbe ",
  "bv12:15.2": "vimanā dummanā tadā ",
  "bv12:15.3": "na tesaṃ keci paricaranti ",
  "bv12:15.4": "raṭṭhato nicchubhanti te. ",
  "bv12:16.1": "sabbe tattha samāgantvā ",
  "bv12:16.2": "upagañchuṃ buddhasantike ",
  "bv12:16.3": "tuvaṃ nātho mahāvīra ",
  "bv12:16.4": "saraṇaṃ hohi cakkhuma. ",
  "bv12:17.1": "anukampako kāruṇiko ",
  "bv12:17.2": "hitesī sabbapāṇinaṃ ",
  "bv12:17.3": "sampatte titthiye sabbe ",
  "bv12:17.4": "pañcasīle patiṭṭhahi. ",
  "bv12:18.1": "evaṃ nirākulaṃ āsi ",
  "bv12:18.2": "suññakaṃ titthiyehi taṃ ",
  "bv12:18.3": "vicittaṃ arahantehi ",
  "bv12:18.4": "vasībhūtehi tādihi. ",
  "bv12:19.1": "nagaraṃ haṃsavatīnāma ",
  "bv12:19.2": "ānando nāma khattiyo ",
  "bv12:19.3": "sujātā nāma janikā ",
  "bv12:19.4": "padumuttarassa mahesino. ",
  "bv12:20.1": "dasavassasahassāni ",
  "bv12:20.2": "agāramajjhaso vasī ",
  "bv12:20.3": "naravāhano yaso vasavattī ",
  "bv12:20.4": "tayo pāsādamuttamā. ",
  "bv12:21.1": "ticattārīsasahassāni ",
  "bv12:21.2": "nāriyo samalaṅkatā ",
  "bv12:21.3": "vasudattā nāma nārī ",
  "bv12:21.4": "uttaro nāma atrajo. ",
  "bv12:22.1": "nimitte caturo disvā ",
  "bv12:22.2": "pāsādenā’bhinikkhami ",
  "bv12:22.3": "sattāhaṃ padhānacāraṃ ",
  "bv12:22.4": "acarī purisuttamo. ",
  "bv12:23.1": "brahmunā yācito santo ",
  "bv12:23.2": "padumuttaro vināyako ",
  "bv12:23.3": "vatti cakkaṃ mahāvīro ",
  "bv12:23.4": "mīthiluyyānamuttame. ",
  "bv12:24.1": "devalo ca sujāto ca ",
  "bv12:24.2": "ahesuṃ aggasāvakā ",
  "bv12:24.3": "sumano nāmupaṭṭhāko ",
  "bv12:24.4": "padumuttarassa satthuno. ",
  "bv12:25.1": "amitā asmā ceva ",
  "bv12:25.2": "ahesuṃ aggasāvikā ",
  "bv12:25.3": "bodhi tassa bhagavato ",
  "bv12:25.4": "salalo’ti pavuccati. ",
  "bv12:26.1": "vitiṇṇo ceva tisso ca ",
  "bv12:26.2": "ahesuṃ aggu’paṭṭhakā ",
  "bv12:26.3": "hatthā ceva vicittā ca ",
  "bv12:26.4": "ahesuṃ aggu’paṭṭhikā. ",
  "bv12:27.1": "aṭṭhapaññāsaratanaṃ ",
  "bv12:27.2": "accuggato mahāmuni ",
  "bv12:27.3": "kañcanagghiya saṃkāso ",
  "bv12:27.4": "dvattiṃsavaralakkhaṇo. ",
  "bv12:28.1": "kuḍḍā kavāṭā bhittī ca ",
  "bv12:28.2": "rukkhā nagasiluccayā ",
  "bv12:28.3": "na tassā’varaṇaṃ atthi ",
  "bv12:28.4": "samantā dvādasayojane. ",
  "bv12:29.1": "vassasatasahassāni ",
  "bv12:29.2": "āyu vijjati tāvade ",
  "bv12:29.3": "tāvatā tiṭṭhamāno so ",
  "bv12:29.4": "tāresi janataṃ bahuṃ. ",
  "bv12:30.1": "santāretvā bahujanaṃ ",
  "bv12:30.2": "chinditvā sabbasaṃsayaṃ ",
  "bv12:30.3": "jalitvā aggikkhandho’va ",
  "bv12:30.4": "nibbuto so sasāvako. ",
  "bv12:31.1": "padumuttaro jino buddho ",
  "bv12:31.2": "nandārāmamhi nibbuto ",
  "bv12:31.3": "tatthe’va tassa thūpavaro ",
  "bv12:31.4": "dvādasubbedha yojano’ti. ",
  "bv12:32.1": "padumuttarabuddhavaṃso dasamo. "
}
