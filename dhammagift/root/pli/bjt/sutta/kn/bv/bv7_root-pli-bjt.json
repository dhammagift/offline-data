{
  "bv7:0.1": "",
  "bv7:0.2": "5. revata buddhavaṃso ",
  "bv7:1.1": "sumanassa aparena ",
  "bv7:1.2": "revato nāma nāyako ",
  "bv7:1.3": "anupamo asadiso ",
  "bv7:1.4": "atulo uttamo jino. ",
  "bv7:2.1": "so’pi dhammaṃ pakāsesi ",
  "bv7:2.2": "brahmunā abhiyācito ",
  "bv7:2.3": "khandhadhātuvavatthānaṃ ",
  "bv7:2.4": "appavattaṃ bhavā’bhave. ",
  "bv7:3.1": "tassā’bhisamayā tīṇi ",
  "bv7:3.2": "ahesuṃ dhammadesane ",
  "bv7:3.3": "gaṇanāya na vattabbo ",
  "bv7:3.4": "paṭhamā’bhisamayo ahu. ",
  "bv7:4.1": "yadā arindamaṃ rājaṃ ",
  "bv7:4.2": "vinesi revato muni ",
  "bv7:4.3": "tadā koṭisahassānaṃ ",
  "bv7:4.4": "dutiyā’bhisamayo ahu. ",
  "bv7:5.1": "sattā’haṃ paṭisallānā ",
  "bv7:5.2": "vuṭṭhahitvā narāsabho ",
  "bv7:5.3": "koṭisataṃ naramarūnaṃ ",
  "bv7:5.4": "vinesi uttame phale. ",
  "bv7:6.1": "sannipātā tayo āsuṃ ",
  "bv7:6.2": "revatassa mahesino ",
  "bv7:6.3": "khīṇāsavānaṃ vimalānaṃ ",
  "bv7:6.4": "suvimuttāna’ tādinaṃ. ",
  "bv7:7.1": "atikkantā gaṇanapathaṃ ",
  "bv7:7.2": "paṭhamaṃ ye samāgatā ",
  "bv7:7.3": "koṭisatasahassānāṃ ",
  "bv7:7.4": "dutiyo āsi samāgamo. ",
  "bv7:8.1": "yo’pi paññāya asamo ",
  "bv7:8.2": "tassa cakkānuvattako ",
  "bv7:8.3": "so tadā vyādhito āsi ",
  "bv7:8.4": "patto jīvitasaṃsayaṃ. ",
  "bv7:9.1": "tassa gilānapucchāya ",
  "bv7:9.2": "ye tadā upagatā muni ",
  "bv7:9.3": "koṭisatasahassā arahanto ",
  "bv7:9.4": "tatiyo āsi samāgamo. ",
  "bv7:10.1": "ahaṃ tena samayena ",
  "bv7:10.2": "atidevo nāma brāhmaṇo ",
  "bv7:10.3": "upagantvā revataṃ buddhaṃ ",
  "bv7:10.4": "saraṇaṃ tassa gacchahaṃ. ",
  "bv7:11.1": "tassa sīlaṃ samādhiñca ",
  "bv7:11.2": "paññāguṇamanuttamaṃ ",
  "bv7:11.3": "thomayitvā yathāthāmaṃ ",
  "bv7:11.4": "uttarīya’madāsa’haṃ. ",
  "bv7:12.1": "so’pi maṃ buddho vyākāsi ",
  "bv7:12.2": "revato lokanāyako ",
  "bv7:12.3": "aparimeyye ito kappe ",
  "bv7:12.4": "ayaṃ buddho bhavissati. ahu kapilavhayā rammā nikkhamitvā tathāgato ",
  "bv7:13.1": "padhānaṃ padahitvāna ",
  "bv7:13.2": "katvā dukkarakārikaṃ. ajapālarukkhamūlasmiṃ nisīditvā tathāgato tattha pāyāsamaggayha nerañjaramupehiti. nerañjarāya tīramhi pāyāsaṃ ādāya so jino paṭiyattavaramaggena bodhimūlamhi ehiti. tato padakkhiṇaṃ katvā bodhimaṇḍaṃ anuttaro assattharukkhamūlamhi bujjhissati mahāyaso. imassa janikā mātā māyā nāma bhavissati pitā suddhodano nāma ayaṃ hessati gotamo. kolito upatisso ca aggā hessanti sāvakā ānando nāmu’ paṭṭhāko upaṭṭhissati taṃ jinaṃ. khemā uppalavaṇṇā ca aggā hessanti sāvikā bodhi tassa bhagavato assattho’ti pavuccati. citto ca hatthāḷavako aggā hessantu’ paṭṭhakā uttarā nandamātā ca aggā hessantu’ paṭṭhikā āyu vassasataṃ tassa gotamassa yasassino. idaṃ sutvāna vacanaṃ asamassa mahesino āmoditā naramarū buddhabījaṅkuro ayaṃ. ukkuṭṭhisaddaṃ vattenti apphoṭenti hasanti ca katañjalī namassanti dasasahassī sadevakā. yadi’massa lokanāthassa virajjhissāma sāsanaṃ anāgatamhi addhāne hessāma sammukhā imaṃ. yathā manussā nadiṃ tarantā paṭititthaṃ virajjhiya heṭṭhā titthe gahetvāna uttaranti mahānadiṃ. eva’meva mayaṃ sabbe yadi muñcāmi’ maṃ jinaṃ anāgatamhi addhāne ",
  "bv7:13.3": "hessāma sammukhā imaṃ. ",
  "bv7:14.1": "tassā’pi vacanaṃ sutvā ",
  "bv7:14.2": "bhiyyo cittaṃ pasādayiṃ ",
  "bv7:14.3": "uttariṃ vata’madhiṭṭhāsiṃ ",
  "bv7:14.4": "dasapāramipūriyā. ",
  "bv7:15.1": "tadā’pi maṃ buddhadhammaṃ ",
  "bv7:15.2": "saritvā anubrūhayiṃ ",
  "bv7:15.3": "āharissāmi taṃ dhammaṃ ",
  "bv7:15.4": "yaṃ mayhaṃ abhipatthitaṃ. ",
  "bv7:16.1": "nagaraṃ sudhaññavati nāma ",
  "bv7:16.2": "vipulo nāma khattiyo ",
  "bv7:16.3": "vipulā nāma janikā ",
  "bv7:16.4": "revatassa mahesino. ",
  "bv7:17.1": "chabbassasahassāni ",
  "bv7:17.2": "agāramajjha so vasī ",
  "bv7:17.3": "sudassano ca ratanagghi ",
  "bv7:17.4": "āveḷo ca vibhūsito ",
  "bv7:17.5": "puññakammābhinibbattā ",
  "bv7:17.6": "tayo pāsāda muttamā. ",
  "bv7:18.1": "tettiṃsa sahassāni ",
  "bv7:18.2": "nāriyo samalaṅkatā ",
  "bv7:18.3": "sudassanā nāma devī ",
  "bv7:18.4": "varuṇo nāma atrajo. ",
  "bv7:19.1": "nimitte caturo disvā ",
  "bv7:19.2": "rathayānena nikkhami ",
  "bv7:19.3": "anūnasattamāsāni ",
  "bv7:19.4": "padhānaṃ padahī jino. ",
  "bv7:20.1": "brahmunā yācito santo ",
  "bv7:20.2": "revato loka nāyako ",
  "bv7:20.3": "vatti cakkaṃ mahāvīro ",
  "bv7:20.4": "varuṇā rāme sirīghare. ",
  "bv7:21.1": "varuṇo brahmadevo ca ",
  "bv7:21.2": "ahesuṃ agga sāvakā ",
  "bv7:21.3": "sambhavo nāmupaṭṭhāko ",
  "bv7:21.4": "revatassa mahesino. ",
  "bv7:22.1": "bhaddā ceva subhaddā ca ",
  "bv7:22.2": "ahesuṃ aggasāvikā ",
  "bv7:22.3": "so’pi buddho asamasamo ",
  "bv7:22.4": "nāgamūle abujjhatha. ",
  "bv7:23.1": "padumo kuñjaro ceva ",
  "bv7:23.2": "ahesuṃ aggu’paṭṭhakā ",
  "bv7:23.3": "sirimā ceva yasavatī ",
  "bv7:23.4": "ahesuṃ aggu’paṭṭhikā. ",
  "bv7:24.1": "uccattanena so buddho ",
  "bv7:24.2": "asīti hattha muggato ",
  "bv7:24.3": "obhāseti disā sabbā ",
  "bv7:24.4": "indaketūva uggato. ",
  "bv7:25.1": "tassa sarīre nibbattā ",
  "bv7:25.2": "pabhā mālā anuttarā ",
  "bv7:25.3": "divā vā yadivā rattiṃ ",
  "bv7:25.4": "samantā pharati yojanaṃ. ",
  "bv7:26.1": "saṭṭhivassasahassāni ",
  "bv7:26.2": "āyu vijjati tāvade ",
  "bv7:26.3": "tāvatā tiṭṭhamāno so ",
  "bv7:26.4": "tāresi janataṃ bahuṃ. ",
  "bv7:27.1": "dassayitvā buddhabalaṃ ",
  "bv7:27.2": "amataṃ loke pakāsayaṃ ",
  "bv7:27.3": "nibbāyi anupādāno ",
  "bv7:27.4": "yatha’ggu’pādānasaṅkhayā. ",
  "bv7:28.1": "so ca kāyo ratananibho ",
  "bv7:28.2": "so ca dhammo asādiso ",
  "bv7:28.3": "sabbaṃ samantarahitaṃ ",
  "bv7:28.4": "nanu rittā sabbasaṅkhārā. ",
  "bv7:29.1": "revato yasadharo buddho ",
  "bv7:29.2": "nibbuto so mahāmuni ",
  "bv7:29.3": "dhātuvitthārikaṃ āsī ",
  "bv7:29.4": "tesu tesu padesato’ti. ",
  "bv7:30.1": "revata buddhavaṃso pañcamo. "
}
