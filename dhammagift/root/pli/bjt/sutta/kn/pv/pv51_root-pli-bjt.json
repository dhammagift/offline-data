  "pv51:0.1": "",
  "pv51:0.2": "",
  "pv51:0.3": "4. 16. ",
  "pv51:1.1": "kinnu ummattarūpo ca ",
  "pv51:1.2": "migo bhanto va dhāvasi, ",
  "pv51:1.3": "nissaṃsayaṃ pāpakammanto ",
  "pv51:1.4": "kinnu saddāyase tuvaṃ. ",
  "pv51:2.1": "ahaṃ bhaddanta petomhi ",
  "pv51:2.2": "duggato yamalokiko, ",
  "pv51:2.3": "pāpakammaṃ karitvāna ",
  "pv51:2.4": "petalokaṃ ito gato. ",
  "pv51:3.1": "saṭṭhikūṭasahassāni ",
  "pv51:3.2": "paripuṇṇāni sabbaso, ",
  "pv51:3.3": "sīse mayhaṃ nipatanti ",
  "pv51:3.4": "te bhindanti ca matthakaṃ. ",
  "pv51:4.1": "kinnu kāyena vācāya ",
  "pv51:4.2": "manasā dukkaṭaṃ kataṃ, ",
  "pv51:4.3": "kissa kammavipākena ",
  "pv51:4.4": "idaṃ dukkhaṃ nigacchasi. ",
  "pv51:5.1": "saṭṭhikūṭasahassāni ",
  "pv51:5.2": "paripuṇṇāni sabbaso, ",
  "pv51:5.3": "sīse tuyhaṃ nipatanti ",
  "pv51:5.4": "te bhindanti ca matthakaṃ. ",
  "pv51:6.1": "athaddasāsiṃ sambuddhaṃ ",
  "pv51:6.2": "sunettaṃ bhāvitindriyaṃ, ",
  "pv51:6.3": "nisinnaṃ rukkhamūlasmiṃ ",
  "pv51:6.4": "jhāyantamakutobhayaṃ. ",
  "pv51:7.1": "sālittakappahārena ",
  "pv51:7.2": "bhindissaṃ tassa matthakaṃ, ",
  "pv51:7.3": "tassa kammavipākena ",
  "pv51:7.4": "idaṃ dukkhaṃ nigacchisaṃ. ",
  "pv51:8.1": "saṭṭhikūṭasahassāni ",
  "pv51:8.2": "paripuṇṇāni sabbaso, ",
  "pv51:8.3": "sīse mayhaṃ nipatanti ",
  "pv51:8.4": "te bhindanti ca matthakaṃ. ",
  "pv51:9.1": "dhammena te kāpurisā- ",
  "pv51:9.2": "saṭṭhikūṭasahassāni ",
  "pv51:9.3": "paripuṇṇāni sabbaso, ",
  "pv51:9.4": "sīse tuyhaṃ nipatanti ",
  "pv51:9.5": "te bhindanti ca matthaka’nti. ",
  "pv51:10.1": "",
  "pv51:11.1": "saṭṭhikūṭasahassapetavatthu soḷasamaṃ. mahāvaggo catuttho. ",
  "pv51:12.1": "tassuddānaṃ: ",
  "pv51:13.1": "ambasakkharo serissako ",
  "pv51:13.2": "piṅgalo revatī ucchukhādakā ",
  "pv51:13.3": "dve kumārā dve gūthakhādakā gaṇapāṭali pokkharañca ",
  "pv51:13.4": "ambarukkha- ",
  "pv51:14.1": "bhogasaṃhārā seṭṭhiputta ",
  "pv51:14.2": "saṭṭhikūṭā ",
  "pv51:14.3": "iti soḷasavatthūni ",
  "pv51:14.4": "tena pavuccatī’ti. ",
  "pv51:15.1": "",
  "pv51:16.1": "petavatthu ",
  "pv51:16.2": "pāḷi ",
  "pv51:16.3": "",
  "pv51:16.4": "samattā. ",
  "pv51:17.1": ""
}
