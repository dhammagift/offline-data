{
  "pv37:0.1": "",
  "pv37:0.2": "",
  "pv37:0.3": "4. 2. ",
  "pv37:1.1": "suṇātha yakkhassa ca vāṇijāna ca ",
  "pv37:1.2": "samāgamo yattha tadā ahosi, ",
  "pv37:1.3": "yathā kathaṃ itarītarena cāpi ",
  "pv37:1.4": "subhāsitaṃ tañca suṇātha sabbe. ",
  "pv37:2.1": "yo so ahu rājā pāyāsi nāmo ",
  "pv37:2.2": "bhummānaṃ sahavyagato yasassī, ",
  "pv37:2.3": "so modamānova sake vimāne ",
  "pv37:2.4": "amānuso mānuse ajjhahāsīti. ",
  "pv37:3.1": "vaṅke araññe amanussaṭṭhāne ",
  "pv37:3.2": "kantāre appodake appabhakkhe, ",
  "pv37:3.3": "suduggame vaṇṇupathassa majjhe, ",
  "pv37:3.4": "vaṅkaṃ bhayā naṭṭhamanā manussā. ",
  "pv37:4.1": "nayidha phalā mūlamayā ca santi ",
  "pv37:4.2": "upādānaṃ natthi kuto idha bhakkho, ",
  "pv37:4.3": "aññatra paṃsūhi ca vālukāhi ca ",
  "pv37:4.4": "tattāhi uṇhāhi ca dāruṇāhi ca. ",
  "pv37:5.1": "ujjaṅgalaṃ tattamivaṃ kapālaṃ ",
  "pv37:5.2": "anāyasaṃ paralokena tulyaṃ, ",
  "pv37:5.3": "luddānamāvāsamidaṃ purāṇaṃ ",
  "pv37:5.4": "bhūmippadeso abhisattarūpo. ",
  "pv37:6.1": "atha tumhe kena vaṇṇena ",
  "pv37:6.2": "kimāsamānā imaṃ padesaṃ hi. ",
  "pv37:6.3": "anuppaviṭṭhā sahasā samecca ",
  "pv37:6.4": "lobhā bhayā athavā sampamūḷhā. ",
  "pv37:7.1": "magadhesu aṅgesu ca satthavāhā ",
  "pv37:7.2": "āropayitvā paṇiyaṃ puthuttaṃ, ",
  "pv37:7.3": "te yāmase sindhusovīrabhūmiṃ ",
  "pv37:7.4": "dhanatthikā uddayaṃ patthayānā ",
  "pv37:8.1": "divā pipāsaṃ’nadhi vāsayantā ",
  "pv37:8.2": "yoggānukampañca samekkhamānā, ",
  "pv37:8.3": "etena vegena āyāma sabbe ",
  "pv37:8.4": "rattiṃ maggaṃ paṭipannā vikāle. ",
  "pv37:9.1": "te duppayātā aparaddhamaggā ",
  "pv37:9.2": "andhākulā vippanaṭṭhā araññe, ",
  "pv37:9.3": "suduggame vaṇṇupathassa majjhe ",
  "pv37:9.4": "disaṃ na jānāma pamūḷhacittā. ",
  "pv37:10.1": "idañca disvāna adiṭṭhapubbaṃ ",
  "pv37:10.2": "vimānaseṭṭhañca tuvañca yakkha, ",
  "pv37:10.3": "taduttariṃ jīvitamāsamānā ",
  "pv37:10.4": "disvā patītā sumanā udaggāti. ",
  "pv37:11.1": "pāraṃ samuddassa idañca vaṇṇuṃ ",
  "pv37:11.2": "vettācaraṃ saṅkupathañca maggaṃ, ",
  "pv37:11.3": "nadiyo pana pabbatānañca duggā ",
  "pv37:11.4": "puthuddisā gacchatha bhogahetu. ",
  "pv37:12.1": "pakkhandiyāna vijitaṃ paresaṃ ",
  "pv37:12.2": "verajjake mānuse pekkhamānā, ",
  "pv37:12.3": "yaṃ vo sutaṃ vā athavāpi diṭṭhaṃ ",
  "pv37:12.4": "accherakaṃ taṃ vo suṇoma tātā. ",
  "pv37:13.1": "itopi accherataraṃ kumāra ",
  "pv37:13.2": "na no sutaṃ vā athavāpi diṭṭhaṃ, ",
  "pv37:13.3": "atītamānusakkameva sabbaṃ ",
  "pv37:13.4": "disvāna tappāma anomavaṇṇaṃ. ",
  "pv37:14.1": "vehāsayaṃ pokkharañño savanti ",
  "pv37:14.2": "pahūtamalyā bahupuṇḍarīkā, ",
  "pv37:14.3": "dumācime niccaphalūpapannā ",
  "pv37:14.4": "atīva gandhā surabhiṃ pavāyanti. ",
  "pv37:15.1": "veḷuriyatthamhā satamussitāse ",
  "pv37:15.2": "silāppavāḷassa ca āyataṃsā, ",
  "pv37:15.3": "masāragallā saha lohitaṅkā ",
  "pv37:15.4": "thambhā ime jotirasāmayāse. ",
  "pv37:16.1": "sahassatthambhaṃ atulānubhāvaṃ ",
  "pv37:16.2": "tesūpari sādhumidaṃ vimānaṃ, ",
  "pv37:16.3": "ratanantaraṃ kañcanavedimissaṃ ",
  "pv37:16.4": "tapanīyapaṭṭehi ca sādhu channaṃ. ",
  "pv37:17.1": "jambonaduttattamidaṃ sumaṭṭho ",
  "pv37:17.2": "pāsādasopānaphalupapanno, ",
  "pv37:17.3": "daḷho ca vaggu sumukho susaṃgato ",
  "pv37:17.4": "atīva nijjhānakhamo manuñño. ",
  "pv37:18.1": "ratanantarasmiṃ bahuannapānaṃ ",
  "pv37:18.2": "parivārito accharāsaṃgaṇena, murajja ",
  "pv37:18.3": "āḷambaraturiyaghuṭṭho ",
  "pv37:18.4": "abhivanditosi thutivandanāya. ",
  "pv37:19.1": "so modayi nārigaṇappabodhano ",
  "pv37:19.2": "vimānapāsādavare manorame, ",
  "pv37:19.3": "acintiyo sabbaguṇūpapanno ",
  "pv37:19.4": "rājā yathā vessavaṇo naḷinyā. ",
  "pv37:20.1": "devo nu āsi uda vāsi yakkho ",
  "pv37:20.2": "udāhu devindo manussabhūto, ",
  "pv37:20.3": "pucchanti taṃ vāṇijā satthavāhā ",
  "pv37:20.4": "ācikkha ko nāma tuvaṃsi yakkhāti. ",
  "pv37:21.1": "serissako nāma ahampi yakkho ",
  "pv37:21.2": "kantāriyo vaṇṇupathamhi gutto, ",
  "pv37:21.3": "imaṃ padesaṃ abhipālayāmi ",
  "pv37:21.4": "vācaṅkaro vessavaṇassa rañño. ",
  "pv37:22.1": "adhicca laddhaṃ pariṇāmajaṃ te ",
  "pv37:22.2": "sayaṃ kataṃ udāhu devehi dinnaṃ, ",
  "pv37:22.3": "pucchanti taṃ vāṇijā satthavāhā ",
  "pv37:22.4": "kathaṃ tayā laddhamidaṃ manuññanti. ",
  "pv37:23.1": "nādhicca laddhaṃ na pariṇāmajaṃ me ",
  "pv37:23.2": "na sayaṃ kataṃ napi devehi dinnaṃ, ",
  "pv37:23.3": "sakehi kammehi apāpakehi ",
  "pv37:23.4": "puññehi me laddhamidaṃ manuññanti. ",
  "pv37:24.1": "kinte vataṃ kiṃ pana brahmacariyaṃ ",
  "pv37:24.2": "kissa suciṇṇassa ayaṃ vipāko, ",
  "pv37:24.3": "pucchanti taṃ vāṇijā satthavāhā ",
  "pv37:24.4": "kathaṃ tayā laddhamidaṃ vimānanti. ",
  "pv37:25.1": "mamaṃ pāyāsīti ahū samaññā ",
  "pv37:25.2": "rajjaṃ yadā kārayiṃ kosalānaṃ, ",
  "pv37:25.3": "natthikadiṭṭhi kadariyo pāpadhammo ",
  "pv37:25.4": "ucchedavādī ca tadā ahosiṃ. ",
  "pv37:26.1": "samaṇo ca kho āsi kumārakassapo ",
  "pv37:26.2": "bahussuto cittakathī uḷāro, ",
  "pv37:26.3": "so me tadā dhammakathaṃ akāsi ",
  "pv37:26.4": "diṭṭhivisūkāni vinodayī me. ",
  "pv37:27.1": "tāhaṃ tassa dhammakathaṃ suṇitvā ",
  "pv37:27.2": "upāsakattaṃ paṭivedayissaṃ, ",
  "pv37:27.3": "pāṇātipātā virato ahosiṃ ",
  "pv37:27.4": "loke adinnaṃ parivajjayissaṃ. ",
  "pv37:27.5": "amajjapo no ca musā abhāṇiṃ ",
  "pv37:27.6": "sakena dārena ca ahosiṃ tuṭṭho. ",
  "pv37:28.1": "taṃ me vataṃ taṃ pana brahmacariyaṃ ",
  "pv37:28.2": "tassa suciṇṇassa ayaṃ vipāko, ",
  "pv37:28.3": "teheva kammehi apāpakehi ",
  "pv37:28.4": "puññehi me laddhamidaṃ vimānanti. ",
  "pv37:29.1": "saccaṃ kirāhaṃsu narā sapaññā ",
  "pv37:29.2": "anaññathā vacanaṃ paṇḍitānaṃ, ",
  "pv37:29.3": "yahiṃ yahiṃ gacchati puññakammo ",
  "pv37:29.4": "tahiṃ tahiṃ modati kāmakāmī. ",
  "pv37:30.1": "yahiṃ yahiṃ sokapariddavo ca ",
  "pv37:30.2": "vadho ca bandho ca parikkileso, ",
  "pv37:30.3": "tahiṃ tahiṃ gacchati pāpakammo ",
  "pv37:30.4": "na muccati duggatiyā kadācīti. ",
  "pv37:31.1": "sammūḷharūpo ca jano ahosi ",
  "pv37:31.2": "asmiṃ muhutte kalalīkatova, ",
  "pv37:31.3": "janassimassa tuyhañca kumāra ",
  "pv37:31.4": "appaccayo kena nu kho ahosi. ",
  "pv37:32.1": "ime sirisūpavanā ca tātā ",
  "pv37:32.2": "dibbā gandhā surabhiṃ sampavanti, ",
  "pv37:32.3": "te sampavāyanti imaṃ vimānaṃ ",
  "pv37:32.4": "divā ca ratto ca tamaṃ nihantvā ",
  "pv37:33.1": "imesaṃ ca kho vassasataccayena ",
  "pv37:33.2": "sipāṭikā phalati ekamekā, ",
  "pv37:33.3": "mānussakaṃ vassasataṃ atītaṃ ",
  "pv37:33.4": "yadante kāyamhi idhūpapanno. ",
  "pv37:34.1": "disvānahaṃ vassasatāni pañca ",
  "pv37:34.2": "asmiṃ vimāne katvāna tātā, ",
  "pv37:34.3": "āyukkhayā puññakkhayā cavissaṃ ",
  "pv37:34.4": "teneva sokena pamucchitosmi, ",
  "pv37:35.1": "kathaṃ nu soceyya tathāvidho so ",
  "pv37:35.2": "laddhaṃ vimānaṃ atulaṃ cirāya, ",
  "pv37:35.3": "yecāpi kho ittaramupapannā ",
  "pv37:35.4": "te nūna soceyyuṃ parittapuññā ",
  "pv37:36.1": "anucchaviṃ ovadiyañca me taṃ ",
  "pv37:36.2": "yaṃ maṃ tumhe peyyavācaṃ vadetha ",
  "pv37:36.3": "tumhe ca kho tātā mayānuguttā ",
  "pv37:36.4": "yenicchakaṃ tena paletha sotthi, ",
  "pv37:37.1": "gantvā mayaṃ sindhusovīrabhūmiṃ ",
  "pv37:37.2": "dhanatthikā uddayaṃ patthayānā, ",
  "pv37:37.3": "yathā payogā paripuṇṇacāgā ",
  "pv37:37.4": "kāhāma serissamahaṃ uḷāraṃ. ",
  "pv37:38.1": "mā ceva serissamahaṃ akattha ",
  "pv37:38.2": "sabbañca vo bhavissati yaṃ vadetha, ",
  "pv37:38.3": "pāpāni kammāni vivajjayātha ",
  "pv37:38.4": "dhammānuyogañca adhiṭṭhahātha. ",
  "pv37:39.1": "upāsako atthi imamhi saṅghe ",
  "pv37:39.2": "bahussuto sīlavatūpapanno, ",
  "pv37:39.3": "saddho ca cāgī ca supesalo ca ",
  "pv37:39.4": "vicakkhaṇo santusito matīmā. ",
  "pv37:40.1": "sañjānamāno na musā bhaṇeyya ",
  "pv37:40.2": "parūpaghātāya na cetayeyya, ",
  "pv37:40.3": "vebhūtikaṃ pisunaṃ no kareyya ",
  "pv37:40.4": "saṇhañca vācaṃ sakhilaṃ bhaṇeyya. ",
  "pv37:41.1": "sagāravo sappatisso vinīto ",
  "pv37:41.2": "apāpako adhisīle visuddho, ",
  "pv37:41.3": "so mātaraṃ pitarañcāpi jantu ",
  "pv37:41.4": "dhammena poseti ariyavutti. ",
  "pv37:42.1": "maññe so mātāpitunnaṃ kāraṇā ",
  "pv37:42.2": "bhogāni pariyesati na attahetu. ",
  "pv37:42.3": "mātāpitunnañca yo accayena ",
  "pv37:42.4": "nekkhammapono carissati brahmacariyaṃ. ",
  "pv37:43.1": "ujū avaṅko asaṭho amāyo ",
  "pv37:43.2": "na lesakappena ca vohareyya, ",
  "pv37:43.3": "so tādiso sukkatakammakārī ",
  "pv37:43.4": "dhamme ṭhito kinti labhetha dukkhaṃ. ",
  "pv37:44.1": "taṃ kāraṇā pātukatomhi attanā. ",
  "pv37:44.2": "tasmā dhammaṃ passatha vāṇijāse, ",
  "pv37:44.3": "aññatra tenīha bhasmībhavetha ",
  "pv37:44.4": "andhākulā vippanaṭṭhā araññe. ",
  "pv37:44.5": "taṃ khippamānena lahuṃ parena ",
  "pv37:44.6": "sukho bhave sappurisena saṅgamo. ",
  "pv37:45.1": "kiṃ nāma so kiñca karoti kammaṃ ",
  "pv37:45.2": "kiṃ nāmadheyyaṃ kiṃ pana tassa gottaṃ, ",
  "pv37:45.3": "mayampi naṃ daṭṭhūkāmha yakkha ",
  "pv37:45.4": "yassānukampāya idhāgatosi ",
  "pv37:45.5": "lābhā hi tassa yassa tuvaṃ pihesi. ",
  "pv37:46.1": "yo kappako sambhavanāmadheyyo ",
  "pv37:46.2": "upāsako kocchaphalūpajīvī, ",
  "pv37:46.3": "jānātha naṃ tumhākaṃ pesiyo so ",
  "pv37:46.4": "mā kho naṃ bhīḷittha supesalo so. ",
  "pv37:47.1": "jānāmase yaṃ tvaṃ vadesi yakkha ",
  "pv37:47.2": "na kho naṃ jānāma sa īdisoti. ",
  "pv37:47.3": "mayampi naṃ pūjayissāma yakkha ",
  "pv37:47.4": "sutvāna tuyhaṃ vacanaṃ uḷāraṃ. ",
  "pv37:48.1": "ye kecimasmiṃ satthe manussā ",
  "pv37:48.2": "daharā mahantā athavāpi majjhimā ",
  "pv37:48.3": "sabbeva te ālambantū vimānaṃ ",
  "pv37:48.4": "passantu puññāna phalaṃ kadariyā. ",
  "pv37:49.1": "te tattha sabbeva ahaṃ pureti ",
  "pv37:49.2": "taṃ kappakaṃ tattha purakkhipitvā, ",
  "pv37:49.3": "sabbeva te ālambiṃsu vimānaṃ ",
  "pv37:49.4": "masakkasāraṃ viya vāsavassa. ",
  "pv37:50.1": "te tattha sabbeva ahaṃ pureti ",
  "pv37:50.2": "upāsakattaṃ paṭivedayiṃsu, ",
  "pv37:50.3": "pāṇātipātā viratā ahesuṃ ",
  "pv37:50.4": "loke adinnaṃ parivajjayiṃsu. ",
  "pv37:50.5": "amajjapā no ca musā bhaṇiṃsu ",
  "pv37:50.6": "sakena dārena ca ahesuṃ tuṭṭhā. ",
  "pv37:51.1": "te tattha sabbeva ahaṃ pureti ",
  "pv37:51.2": "upāsakattaṃ paṭivedayitvā, ",
  "pv37:51.3": "pakkāmi sattho anumodamāno ",
  "pv37:51.4": "yakkhiddhiyā anumato punappunaṃ. ",
  "pv37:52.1": "gantvāna te sindhusovīrabhūmiṃ ",
  "pv37:52.2": "dhanatthikā udrayaṃ patthayānā, ",
  "pv37:52.3": "yathāpayogā paripuṇṇalābhā ",
  "pv37:52.4": "paccāgamuṃ pāṭaliputtamakkhataṃ. ",
  "pv37:53.1": "gantvāna te saṅgharaṃ sotthimanto ",
  "pv37:53.2": "puttehi dārehi samaṅgibhūtā, ",
  "pv37:53.3": "ānanda cittā sumanā patītā ",
  "pv37:53.4": "akaṃsu serissamahaṃ uḷāraṃ. ",
  "pv37:53.5": "serissakaṃ te pariveṇaṃ māpayiṃsu ",
  "pv37:54.1": "etādisā sappurisāna sevanā, ",
  "pv37:54.2": "mahatthikā dhammaguṇāna sevanā, ",
  "pv37:54.3": "ekassa atthāya upāsakassa ",
  "pv37:54.4": "sabbeva sattā sukhitā ahesu’nti. ",
  "pv37:55.1": "serissakapetavatthu dutiyaṃ. ",
  "pv37:55.2": "bhāṇavāraṃ tatiyaṃ. "
}
