  "pv18:0.1": "",
  "pv18:0.2": "",
  "pv18:0.3": "2. 6. maṭṭakuṇḍalīpetavatthu pañcamaṃ. ",
  "pv18:1.1": "uṭṭhehi kaṇha kiṃ sesi ",
  "pv18:1.2": "ko attho supanena te, ",
  "pv18:1.3": "yo ca tuyhaṃ sako bhātā ",
  "pv18:1.4": "hadayaṃ cakkhuñca dakkhiṇaṃ, ",
  "pv18:1.5": "tassa vātā balīyanti ",
  "pv18:1.6": "sasaṃ jappati kesava, ",
  "pv18:2.1": "tassa taṃ vacanaṃ sutvā ",
  "pv18:2.2": "rohiṇeyyassa kesavo ",
  "pv18:2.3": "taramānarūpo uṭṭhāsi ",
  "pv18:2.4": "bhātusokena aṭṭito. ",
  "pv18:3.1": "kinnu ummattarūpova ",
  "pv18:3.2": "kevalaṃ dvārakaṃ imaṃ, ",
  "pv18:3.3": "saso sasoti lapasi ",
  "pv18:3.4": "kīdisaṃ sasamicchasi. ",
  "pv18:4.1": "sovaṇṇamayaṃ maṇimayaṃ ",
  "pv18:4.2": "lohamayaṃ atha rūpiyāmayaṃ, ",
  "pv18:4.3": "saṅkhasilāpavāḷamayaṃ ",
  "pv18:4.4": "kārayissāmi te sasaṃ. ",
  "pv18:5.1": "santi aññepi sasakā ",
  "pv18:5.2": "araññe vanagocarā, ",
  "pv18:5.3": "tepi te ānayissāma ",
  "pv18:5.4": "kīdisaṃ sasamicchasi. ",
  "pv18:6.1": "nāhamete sase icche ",
  "pv18:6.2": "ye sasā paṭhavinissitā ",
  "pv18:6.3": "candato sasamicchāmi ",
  "pv18:6.4": "taṃ me āhara kesava. ",
  "pv18:7.1": "so nūna madhuraṃ ñāti ",
  "pv18:7.2": "jīvitaṃ vijahissasi, ",
  "pv18:7.3": "apatthiyaṃ patthayasi ",
  "pv18:7.4": "candato sasamicchasi. ",
  "pv18:8.1": "evañce kaṇha jānāsi ",
  "pv18:8.2": "yathaññamanusāsasi, ",
  "pv18:8.3": "kasmā pure mataṃ puttaṃ ",
  "pv18:8.4": "ajjāpi anusocasi. ye ",
  "pv18:9.1": "na labbhā manussena ",
  "pv18:9.2": "amanussena vā pana, ",
  "pv18:9.3": "jāto me mā marī putto ",
  "pv18:9.4": "kuto labbhā alabbhiyaṃ, ",
  "pv18:10.1": "na mantā mūlabhesajjā ",
  "pv18:10.2": "osadhehi dhanena vā, ",
  "pv18:10.3": "sakkā ānayituṃ kaṇha ",
  "pv18:10.4": "yaṃ petamanusocasi. ",
  "pv18:11.1": "mahaddhanā mahābhogā ",
  "pv18:11.2": "raṭṭhavantopi khattiyā, ",
  "pv18:11.3": "pahūtadhanadhaññā ye ",
  "pv18:11.4": "tepi no ajarāmarā. ",
  "pv18:12.1": "khattiyā brāhmaṇā vessā ",
  "pv18:12.2": "suddā caṇḍālapukkusā, ",
  "pv18:12.3": "ete caññe ca jātiyā ",
  "pv18:12.4": "tepi no ajarāmarā. ",
  "pv18:13.1": "ye mantaṃ parivattenti ",
  "pv18:13.2": "chaḷaṅgaṃ brahmacintitaṃ ",
  "pv18:13.3": "ete caññe ca jātiyā ",
  "pv18:13.4": "tepi no ajarāmarā. ",
  "pv18:14.1": "isayo vāpi ye santā ",
  "pv18:14.2": "saññatattā tapassino, ",
  "pv18:14.3": "sarīraṃ tepi kālena ",
  "pv18:14.4": "vijahanti tapassino. ",
  "pv18:15.1": "bhāvitattā arahanto ",
  "pv18:15.2": "katakiccā anāsavā, ",
  "pv18:15.3": "nikkhipanti imaṃ dehaṃ ",
  "pv18:15.4": "puññapāpaparikkhayā. ",
  "pv18:16.1": "ādittaṃ vata maṃ santaṃ ",
  "pv18:16.2": "ghatasittaṃva pāvakaṃ, ",
  "pv18:16.3": "vārinā viya osiñcaṃ ",
  "pv18:16.4": "sabbaṃ nibbāpaye daraṃ. ",
  "pv18:17.1": "abbūḷhaṃ vata me sallaṃ ",
  "pv18:17.2": "sokaṃ hadayanissitaṃ, ",
  "pv18:17.3": "yo me sokaparetassa ",
  "pv18:17.4": "puttasokaṃ apānudi. ",
  "pv18:18.1": "svāhaṃ abbūḷhasallosmi ",
  "pv18:18.2": "sītibhūtosmi nibbuto, ",
  "pv18:18.3": "na socāmi na rodāmi ",
  "pv18:18.4": "tava sutvāna bhātika. ",
  "pv18:19.1": "evaṃ karonti sappaññā ",
  "pv18:19.2": "ye honti anukampakā, ",
  "pv18:19.3": "vinivattayanti sokamhā ",
  "pv18:19.4": "ghato jeṭṭhaṃva bhātaraṃ, ",
  "pv18:20.1": "yassa etādisā honti ",
  "pv18:20.2": "amaccā paricārakā, ",
  "pv18:20.3": "subhāsitena anventi ",
  "pv18:20.4": "ghato jeṭṭhaṃva bhātaranti. ",
  "pv18:21.1": ""
}
