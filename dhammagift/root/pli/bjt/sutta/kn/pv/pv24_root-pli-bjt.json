  "pv24:0.1": "",
  "pv24:0.2": "",
  "pv24:0.3": "2. 12. ",
  "pv24:1.1": "sovaṇṇa sopānaphalakā ",
  "pv24:1.2": "sovaṇṇa vālukasanthatā ",
  "pv24:1.3": "tattha sogandhiyā vaggū ",
  "pv24:1.4": "sucigandhā manoramā. ",
  "pv24:2.1": "nānā rukkhehi sañchannā ",
  "pv24:2.2": "nānāgandhasameritā, ",
  "pv24:2.3": "nānāpadumasañchannā ",
  "pv24:2.4": "puṇḍarīkasamotatā. ",
  "pv24:3.1": "surabhī sampavāyantī ",
  "pv24:3.2": "manuññā māluteritā, ",
  "pv24:3.3": "haṃsā koñcābhirudā cakkavākābhikūjitā. ",
  "pv24:3.4": "nānā ",
  "pv24:4.1": "dijagaṇākiṇṇā ",
  "pv24:4.2": "nānāgharagaṇāyutā, ",
  "pv24:4.3": "nānāphaladharā rukkhā ",
  "pv24:4.4": "nānāpupphadharā vanā ",
  "pv24:5.1": "na manussesu īdisaṃ ",
  "pv24:5.2": "nagaraṃ yādisaṃ idaṃ ",
  "pv24:5.3": "pāsādā bahukā tuyhaṃ ",
  "pv24:5.4": "sovaṇṇarūpiyāmayā ",
  "pv24:5.5": "daddallamānā ābhanti ",
  "pv24:5.6": "samantā caturo disā, ",
  "pv24:6.1": "pañcadāsisatā tuyhaṃ ",
  "pv24:6.2": "yā temā paricārikā. ",
  "pv24:6.3": "tā kambukeyūradharā kañcanāveḷa ",
  "pv24:6.4": "bhūsitā, ",
  "pv24:7.1": "pallaṅkā bahukā tuyhaṃ ",
  "pv24:7.2": "sovaṇṇarūpiyāmayā. ",
  "pv24:7.3": "kādalimigasañchannā ",
  "pv24:7.4": "sajjā gonakasanthatā, ",
  "pv24:8.1": "yattha tvaṃ vāsūpagatā ",
  "pv24:8.2": "sabbakāmasamiddhinī ",
  "pv24:8.3": "sampattāyaḍḍharattāya ",
  "pv24:8.4": "tato uṭṭhāya gacchasi, ",
  "pv24:9.1": "uyyānabhūmiṃ gantvāna ",
  "pv24:9.2": "pokkharaññā samantato. ",
  "pv24:9.3": "tassā tīre tuvaṃ ṭhāsi ",
  "pv24:9.4": "harite saddale subhe, ",
  "pv24:10.1": "tato te kaṇṇamuṇḍo sunakho ",
  "pv24:10.2": "aṅgamaṅgāni khādati. ",
  "pv24:10.3": "yadā ca khāyitā āsi ",
  "pv24:10.4": "aṭṭhisaṅkhalikā katā, ",
  "pv24:10.5": "ogāhasi pokkharaṇiṃ ",
  "pv24:10.6": "hoti kāyo yathā pure. ",
  "pv24:11.1": "tato tvaṃ aṅgapaccaṅgī ",
  "pv24:11.2": "sucārupiyadassanā, ",
  "pv24:11.3": "vatthena pārupitvāna ",
  "pv24:11.4": "āyāsi mama santikaṃ. ",
  "pv24:12.1": "kinnu kāyena vācāya ",
  "pv24:12.2": "manasā dukkaṭaṃ kataṃ, ",
  "pv24:12.3": "kissa kammavipākena ",
  "pv24:12.4": "kaṇṇamuṇḍo ca sunakho. ",
  "pv24:12.5": "aṅgamaṅgāni khādati. ",
  "pv24:13.1": "kimbilāyaṃ gahapati ",
  "pv24:13.2": "saddho āsi upāsako, ",
  "pv24:13.3": "tassāhaṃ bhariyā āsiṃ ",
  "pv24:13.4": "dussīlā aticārinī. ",
  "pv24:14.1": "so maṃ aticaramānāya ",
  "pv24:14.2": "sāmiko etadabravī, ",
  "pv24:14.3": "netaṃ channaṃ nappatirūpaṃ ",
  "pv24:14.4": "yaṃ tvaṃ aticarāsi maṃ. ",
  "pv24:15.1": "sāhaṃ ghorañca sapathaṃ ",
  "pv24:15.2": "musāvādamabhāsisaṃ, nāhantaṃ aticarāmi kāyena uda ",
  "pv24:15.3": "cetasā. svāhaṃ taṃ aticarāmi ",
  "pv24:15.4": "kāyena uda cetasā, ",
  "pv24:16.1": "ayaṃ ",
  "pv24:16.2": "kaṇṇamuṇḍo ",
  "pv24:16.3": "sunakho ",
  "pv24:16.4": "aṅgamaṅgāni khādatu. ",
  "pv24:17.1": "tassa kammassa vipākaṃ ",
  "pv24:17.2": "musāvādassa cūbhayaṃ, ",
  "pv24:17.3": "sattavassasatāni ca ",
  "pv24:17.4": "anubhūtaṃ yato hi me, ",
  "pv24:17.5": "kaṇṇamuṇḍo ca sunakho ",
  "pv24:17.6": "aṅgamaṅgāni khādati. ",
  "pv24:18.1": "tvañca deva bahukāro ",
  "pv24:18.2": "atthāya me idhāgato, ",
  "pv24:18.3": "sumuttāhaṃ kaṇḍamuṇḍassa ",
  "pv24:18.4": "asokā akutobhayā. ",
  "pv24:19.1": "tāhaṃ deva namassāmi ",
  "pv24:19.2": "yācāmi pañjalīkatā, ",
  "pv24:19.3": "bhuñja amānuse kāme ",
  "pv24:19.4": "rama deva mayā saha. ",
  "pv24:20.1": "bhutvā amānuse kāme ",
  "pv24:20.2": "ramitomhi tayā saha, ",
  "pv24:20.3": "tāhaṃ subhage yācāmi ",
  "pv24:20.4": "khippaṃ paṭinayāhi ma’nti. ",
  "pv24:21.1": ""
}
