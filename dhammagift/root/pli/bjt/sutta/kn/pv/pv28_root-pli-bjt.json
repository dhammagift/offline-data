{
  "pv28:0.1": "",
  "pv28:0.2": "",
  "pv28:0.3": "3. 3. ",
  "pv28:1.1": "veḷuriyatthambhaṃ ruciraṃ pabhassaraṃ ",
  "pv28:1.2": "vimānamāruyha anekacittaṃ, ",
  "pv28:1.3": "tatthacchasi devi mahānubhāve ",
  "pv28:1.4": "pathaddhanī paṇṇaraseva candimā ",
  "pv28:2.1": "vaṇṇopi te kanakassa sanniho ",
  "pv28:2.2": "uttattarūpo bhusadassanīyo, ",
  "pv28:2.3": "pallaṅkaseṭṭhe atule nisinnā ",
  "pv28:2.4": "ekā tuvaṃ natthi ca tuyha sāmiko. ",
  "pv28:3.1": "imā ca te pokkharañño samantā ",
  "pv28:3.2": "pahūtamālā bahupuṇḍarīkā, ",
  "pv28:3.3": "suvaṇṇacuṇṇehi samantamottā ",
  "pv28:3.4": "na tattha paṅko paṇako ca vijjati. ",
  "pv28:4.1": "haṃsā cime dassanīyā manoramā ",
  "pv28:4.2": "udakasmiṃ anupariyanti sabbadā, ",
  "pv28:4.3": "samayya vaggūpanadanti sabbe ",
  "pv28:4.4": "bindussarā dundubhinaṃva ghoso. ",
  "pv28:5.1": "daddallamānā yasasā yasassinī ",
  "pv28:5.2": "nāvāya ca tvaṃ avalamba tiṭṭhasi, ",
  "pv28:5.3": "āḷārapamhe hasite piyaṃ vade ",
  "pv28:5.4": "sabbaṅgakalyāṇi bhusaṃ virocasi. ",
  "pv28:6.1": "idaṃ vimānaṃ virajaṃ same ṭhitaṃ ",
  "pv28:6.2": "uyyānavantaṃ ratinandivaḍḍhanaṃ, ",
  "pv28:6.3": "icchāmahaṃ nāri anomadassane ",
  "pv28:6.4": "tayā saha nandane idha modituṃ. ",
  "pv28:7.1": "karohi kammaṃ idha vedanīyaṃ ",
  "pv28:7.2": "cittañca te idha nihitaṃ bhavatu, ",
  "pv28:7.3": "katvāna kammaṃ idha vedanīyaṃ ",
  "pv28:7.4": "evaṃ lacchasi kāmakāminiṃ, ",
  "pv28:8.1": "sādhūti so tassā paṭissuṇitvā ",
  "pv28:8.2": "akāsi kammaṃ tahiṃ vedaniyaṃ, ",
  "pv28:8.3": "katvāna kammaṃ tahiṃ vedaniyaṃ ",
  "pv28:8.4": "uppajji so māṇavo tassā sahavyata’nti. ",
  "pv28:9.1": "rathakārapetavatthu tatiyaṃ. ",
  "pv28:9.2": "bhāṇavāraṃ dutiyaṃ. "
}
