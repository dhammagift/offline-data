{
  "pv46:0.1": "",
  "pv46:0.2": "",
  "pv46:0.3": "4. 11. ",
  "pv46:1.1": "diṭṭhā tayā nirayā tiracchānayoni ",
  "pv46:1.2": "petā asurā athavāpi manussā devā ",
  "pv46:1.3": "sayamaddasa kammavipākamattano ",
  "pv46:1.4": "nessāmi taṃ pāṭaliputtamakkhataṃ ",
  "pv46:1.5": "tattha gantvā kusalaṃ karohi dhammaṃ. ",
  "pv46:2.1": "atthakāmosi me yakkha ",
  "pv46:2.2": "hitakāmosi devate, ",
  "pv46:2.3": "karomi tuyhaṃ vacanaṃ ",
  "pv46:2.4": "tvaṃsi ācariyo mama. ",
  "pv46:3.1": "diṭṭhā mayā nirayā tiracchānayoni ",
  "pv46:3.2": "petā asurā athavāpi manussā devā ",
  "pv46:3.3": "sayamaddasa kammavipākamattano ",
  "pv46:3.4": "kāhāmi puññāni anappakānī’ti. ",
  "pv46:4.1": "pāṭalīputtapetavatthu ekādasamaṃ. "
}
