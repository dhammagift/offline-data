  "pv27:0.1": "",
  "pv27:0.2": "",
  "pv27:0.3": "3. 2. abhijjamānapetavatthu paṭhamaṃ. ",
  "pv27:1.1": "kuṇḍinagariyo thero ",
  "pv27:1.2": "sānuvāsī nivāsino, ",
  "pv27:1.3": "poṭṭhapādoti nāmena ",
  "pv27:1.4": "samaṇo bhāvitindriyo. ",
  "pv27:2.1": "tassa mātā pitā bhātā ",
  "pv27:2.2": "duggatā yamalokikā, ",
  "pv27:2.3": "pāpakammaṃ karitvāna ",
  "pv27:2.4": "petalokaṃ ito gatā. ",
  "pv27:3.1": "te duggatā sūcikaṭṭā ",
  "pv27:3.2": "kilantā naggino kisā, ",
  "pv27:3.3": "uttasantā mahātāsā ",
  "pv27:3.4": "na dassenti kurūrino. ",
  "pv27:4.1": "tassa bhātā vitaritvā ",
  "pv27:4.2": "naggo ekapathekako, ",
  "pv27:4.3": "catukuṇḍiko bhavitvāna ",
  "pv27:4.4": "therassa dassayī tumaṃ. ",
  "pv27:5.1": "thero cāmanasī katvā ",
  "pv27:5.2": "tuṇhībhūto apakkami, ",
  "pv27:5.3": "so ca viññāpayī theraṃ ",
  "pv27:5.4": "bhātā petagato ahaṃ. ",
  "pv27:6.1": "mātā pitā ca te bhante ",
  "pv27:6.2": "duggatā yamalokikā, ",
  "pv27:6.3": "pāpakammaṃ karitvāna ",
  "pv27:6.4": "petalokaṃ ito gatā. ",
  "pv27:7.1": "te duggatā sūcikaṭṭā ",
  "pv27:7.2": "kilantā naggino kisā, ",
  "pv27:7.3": "uttasantā mahātāsā ",
  "pv27:7.4": "na dassenti kurūrino. ",
  "pv27:8.1": "anukampassu kāruṇiko ",
  "pv27:8.2": "datvā anvādisāhi no, ",
  "pv27:8.3": "tava dinnena dānena ",
  "pv27:8.4": "yāpessanti kurūrino. ",
  "pv27:9.1": "thero caritvā piṇḍāya ",
  "pv27:9.2": "bhikkhu aññe va dvādasa, ",
  "pv27:9.3": "ekajjhaṃ sannipatiṃsu ",
  "pv27:9.4": "bhattavissaggakāraṇā. ",
  "pv27:10.1": "thero sabbeva te āha ",
  "pv27:10.2": "yathā laddhaṃ dadātha me, ",
  "pv27:10.3": "saṅghabhattaṃ karissāmi ",
  "pv27:10.4": "anukampāya ñātinaṃ. ",
  "pv27:11.1": "niyyātayiṃsu therassa ",
  "pv27:11.2": "thero saṅghaṃ nimantayī, ",
  "pv27:11.3": "datvā anvādisi thero ",
  "pv27:11.4": "mātu pitu ca bhātuno. ",
  "pv27:11.5": "idaṃ me ñātīnaṃ hotu ",
  "pv27:11.6": "sukhitā hontu ñātayo, ",
  "pv27:12.1": "samanantarānuddiṭṭhe ",
  "pv27:12.2": "bhojanaṃ udapajjatha. ",
  "pv27:12.3": "suciṃ paṇītaṃ sampannaṃ ",
  "pv27:12.4": "anekarasabyañjanaṃ, ",
  "pv27:13.1": "tato uddisayī bhātā ",
  "pv27:13.2": "vaṇṇavā balavā sukhī. ",
  "pv27:13.3": "pahūtaṃ bhojanaṃ bhante ",
  "pv27:13.4": "passa naggāmbhase mayaṃ, ",
  "pv27:13.5": "tathā bhante parakkama ",
  "pv27:13.6": "yathā vatthaṃ labhāmase. ",
  "pv27:14.1": "thero saṅkārakūṭamhā ",
  "pv27:14.2": "uccinitvānanantake, ",
  "pv27:14.3": "pilotikaṃ paṭaṃ katvā ",
  "pv27:14.4": "saṅghe cātuddise adā. ",
  "pv27:15.1": "datvā anvādisi thero ",
  "pv27:15.2": "mātu pitu ca bhātuno, ",
  "pv27:15.3": "idaṃ me ñātīnaṃ hotu ",
  "pv27:15.4": "sukhitā hontu ñātayo. ",
  "pv27:16.1": "samantarānuddiṭṭhe ",
  "pv27:16.2": "vatthāni udapajjiṃsu, ",
  "pv27:16.3": "tato suvatthavasano ",
  "pv27:16.4": "therassa dassayītu maṃ. ",
  "pv27:17.1": "yāvatā nandarājassa ",
  "pv27:17.2": "vijitasmiṃ paṭicchadā, ",
  "pv27:17.3": "tato bahutarā bhante ",
  "pv27:17.4": "vatthānacchādanāni no. ",
  "pv27:18.1": "koseyyakambalīyāni ",
  "pv27:18.2": "khomakappāsikāni ca, ",
  "pv27:18.3": "vipulā ca mahagghā ca ",
  "pv27:18.4": "tepākāseva lambare. ",
  "pv27:19.1": "te mayaṃ paridahāma ",
  "pv27:19.2": "yaṃ yaṃ hi manaso piyaṃ, ",
  "pv27:19.3": "tathā bhante parakkama ",
  "pv27:19.4": "yathā gehaṃ labhāmase. ",
  "pv27:20.1": "thero paṇṇakuṭiṃ katvā ",
  "pv27:20.2": "saṅghe cātuddise adā, ",
  "pv27:20.3": "datvā anvādisi thero ",
  "pv27:20.4": "mātu pitu ca bhātuno. ",
  "pv27:20.5": "idaṃ me ñātīnaṃ hotu ",
  "pv27:20.6": "sukhitā hontu ñātayo, ",
  "pv27:21.1": "samanantarānuddiṭṭhe ",
  "pv27:21.2": "gharāni udapajjisuṃ. ",
  "pv27:21.3": "kūṭāgāranivesanā ",
  "pv27:21.4": "vibhattā bhāgaso mitā, ",
  "pv27:22.1": "na manussesu īdisā ",
  "pv27:22.2": "yādisā no gharā idha. ",
  "pv27:22.3": "api dibbesu yādisā ",
  "pv27:22.4": "tādisā no gharā idha, ",
  "pv27:23.1": "daddallamānā ābhanti ",
  "pv27:23.2": "samantā caturo disā. ",
  "pv27:23.3": "tathā bhante parakkama ",
  "pv27:23.4": "yathā pānaṃ labhāmase, ",
  "pv27:24.1": "thero karakaṃ pūretvā ",
  "pv27:24.2": "saṅghe cātuddise adā. ",
  "pv27:24.3": "datvā anvādisi thero ",
  "pv27:24.4": "mātu pitu ca bhātuno, ",
  "pv27:24.5": "idaṃ me ñātīnaṃ hotu ",
  "pv27:24.6": "sukhitā hontu ñātayo. ",
  "pv27:25.1": "samanantarānuddiṭṭhe ",
  "pv27:25.2": "pānīyaṃ udapajjatha, ",
  "pv27:25.3": "gambhīrā caturassā ca ",
  "pv27:25.4": "pokkharañño sunimmitā. ",
  "pv27:26.1": "sītodikā sūpatitthā ",
  "pv27:26.2": "sītā appaṭigandhiyā, ",
  "pv27:26.3": "padumuppalasañchannā ",
  "pv27:26.4": "vārikiñjakkhapūritā. ",
  "pv27:27.1": "tattha nahātvā pivitvā ca ",
  "pv27:27.2": "therassa paṭidassayuṃ, ",
  "pv27:27.3": "pahūtaṃ pānīyaṃ bhante ",
  "pv27:27.4": "pādā dukkhaṃ phalanti no. ",
  "pv27:28.1": "āhiṇḍamānā khañjāma ",
  "pv27:28.2": "sakkhare kusakaṇṭake, ",
  "pv27:28.3": "tathā bhante parakkama ",
  "pv27:28.4": "yathā yānaṃ labhāmase. ",
  "pv27:29.1": "thoro sipāṭikaṃ laddhā ",
  "pv27:29.2": "saṅghe cātuddise adā, ",
  "pv27:29.3": "datvā anvādisi thero ",
  "pv27:29.4": "mātu pitu ca bhātuno. ",
  "pv27:29.5": "idaṃ me ñātīnaṃ hotu ",
  "pv27:29.6": "sukhitā hontu ñātayo, ",
  "pv27:30.1": "samanantarānuddiṭṭhe ",
  "pv27:30.2": "petā rathenamāgamuṃ. ",
  "pv27:30.3": "anukampitamha bhaddante ",
  "pv27:30.4": "bhattenacchādanena ca, ",
  "pv27:31.1": "gharena pānadānena ",
  "pv27:31.2": "yānadānena cūbhayaṃ: ",
  "pv27:31.3": "muniṃ kāruṇikaṃ loke ",
  "pv27:31.4": "bhante vanditumāgatā’ti. ",
  "pv27:32.1": ""
}
