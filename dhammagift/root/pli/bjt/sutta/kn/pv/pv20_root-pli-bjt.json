  "pv20:0.1": "",
  "pv20:0.2": "",
  "pv20:0.3": "2. 8. ",
  "pv20:1.1": "naggo kiso pabbajitosi bhante, ",
  "pv20:1.2": "rattiṃ kuhiṃ gacchasi kissa hetu, ",
  "pv20:1.3": "ācikkha me taṃ api sakkuṇemu ",
  "pv20:1.4": "sabbena cittaṃ paṭipādaye tuvaṃ. ",
  "pv20:2.1": "bārāṇasīnagaraṃ dūraghuṭṭhaṃ ",
  "pv20:2.2": "tatthāhaṃ gahapati aḍḍhako dīno, ",
  "pv20:2.3": "adātā gedhitamano āmisasmiṃ ",
  "pv20:2.4": "dussīlyena yamavisayamhī patto. ",
  "pv20:3.1": "so sūcikāya kilamito tehi ",
  "pv20:3.2": "teneva ñātīsu yāmi āmisahetuṃ, ",
  "pv20:3.3": "adānasīlā na ca saddahanti ",
  "pv20:3.4": "dānaphalaṃ hoti paramhi loke. ",
  "pv20:4.1": "dhītā ca mayhaṃ lapate abhikkhaṇaṃ ",
  "pv20:4.2": "dassāmi dānaṃ pitunaṃ pitāmahānaṃ, ",
  "pv20:4.3": "upakkhaṭaṃ parivisayanti brāhmaṇe ",
  "pv20:4.4": "yāmyahaṃ andhakavindaṃ bhottunti. ",
  "pv20:5.1": "tamavoca rājā anubhaviyāna tampi ",
  "pv20:5.2": "eyyāsi khippaṃ ahampi karissaṃ pūjaṃ, ",
  "pv20:5.3": "ācikkha me taṃ yadi atthi hetu ",
  "pv20:5.4": "saddhāyitaṃ hetuvaco suṇomi. ",
  "pv20:6.1": "tathāti vatvā agamāsi tattha ",
  "pv20:6.2": "bhuṃñjisu bhattaṃ na ca pana dakkhiṇārahā, ",
  "pv20:6.3": "paccāgami rājagahaṃ punāparaṃ ",
  "pv20:6.4": "pāturahosi purato janādhipassa ",
  "pv20:7.1": "disvāna petaṃ punareva āgataṃ ",
  "pv20:7.2": "rājā avoca ahampi kiṃ dadāmi, ",
  "pv20:7.3": "ācikkha me taṃ yadi atthi hetu ",
  "pv20:7.4": "yena tuvaṃ cirataraṃ pīṇito siyāti. ",
  "pv20:8.1": "buddhañca saṅghaṃ parivisiyāna rāja ",
  "pv20:8.2": "annena pānenapi cīvarena. ",
  "pv20:8.3": "taṃ dakkhiṇaṃ ādisa me hitāya ",
  "pv20:8.4": "evaṃ ahaṃ cirataraṃ pīṇito siyā. ",
  "pv20:9.1": "tato ca rājā nipatitvā tāvade ",
  "pv20:9.2": "dānaṃ sahatthā atulaṃ daditvā saṅghe, ",
  "pv20:9.3": "ārocayī pakatiṃ tathāgatassa ",
  "pv20:9.4": "tassa ca petassa dakkhiṇaṃ ādisittha. ",
  "pv20:10.1": "so pūjito ativiya sobhamāno ",
  "pv20:10.2": "pāturahosi purato janādhipassa, ",
  "pv20:10.3": "yakkhohamasmi parimiddhippatto ",
  "pv20:10.4": "na mayhamiddhisamasadisā manussā. ",
  "pv20:11.1": "passānubhāvaṃ aparimitaṃ mamedaṃ ",
  "pv20:11.2": "tayānuddiṭṭhaṃ atulaṃ daditvā saṅghe, ",
  "pv20:11.3": "santappito satataṃ sadā bahūhi ",
  "pv20:11.4": "yāmyahaṃ sukhito manussadevā’ti. ",
  "pv20:12.1": "cullaseṭṭhipetavatthu aṭṭhamaṃ. ",
  "pv20:12.2": "bhāṇavāraṃ paṭhamaṃ. "
}
