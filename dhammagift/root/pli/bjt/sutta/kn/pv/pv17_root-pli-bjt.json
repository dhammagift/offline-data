{
  "pv17:0.1": "",
  "pv17:0.2": "",
  "pv17:0.3": "2. 5. ",
  "pv17:1.1": "alaṅkato maṭṭakuṇḍalī ",
  "pv17:1.2": "mālādhārī haricandanussado, ",
  "pv17:1.3": "bāhā paggayha kandasi ",
  "pv17:1.4": "vanamajjhe kiṃ dukkhito tuvanti? ",
  "pv17:2.1": "sovaṇṇamayo pabhassaro ",
  "pv17:2.2": "uppanno rathapañjaro mama, ",
  "pv17:2.3": "tassa cakkayugaṃ na vindāmi ",
  "pv17:2.4": "tena dukkhena jahissaṃ jīvitanti. ",
  "pv17:3.1": "sovaṇṇamayaṃ maṇimayaṃ ",
  "pv17:3.2": "lohitaṅkamayaṃ atha rūpiyāmayaṃ, ",
  "pv17:3.3": "ācikkha me bhaddamāṇava ",
  "pv17:3.4": "cakkayugaṃ paṭilābhayāmi teti. ",
  "pv17:4.1": "so māṇavo tassa pāvadi ",
  "pv17:4.2": "candasuriyā ubhayettha dissare, ",
  "pv17:4.3": "sovaṇṇamayo ratho mama ",
  "pv17:4.4": "tena cakkayugena sobhatīti. ",
  "pv17:5.1": "bālo kho tvamasi māṇava ",
  "pv17:5.2": "yo tvaṃ patthayase apatthiyaṃ, ",
  "pv17:5.3": "maññāmi tuvaṃ marissasi ",
  "pv17:5.4": "na hi tvaṃ lacchasi candasuriyeti. ",
  "pv17:6.1": "gamanāgamanampi dissati ",
  "pv17:6.2": "vaṇṇadhātu ubhayettha vīthiyo, ",
  "pv17:6.3": "peto pana kālakato na dissati ",
  "pv17:6.4": "konidha kandataṃ bālyataroti. ",
  "pv17:7.1": "saccaṃ kho vadesi māṇava ",
  "pv17:7.2": "ahameva kandataṃ bālyataro ",
  "pv17:7.3": "candaṃ viya dārako rudaṃ ",
  "pv17:7.4": "petaṃ kālakatābhipatthayaṃ. ",
  "pv17:8.1": "ādittaṃ vata maṃ santaṃ ",
  "pv17:8.2": "ghatasittaṃva pāvakaṃ, ",
  "pv17:8.3": "vārinā viya osiñcaṃ ",
  "pv17:8.4": "sabbaṃ nibbāpaye daraṃ. ",
  "pv17:9.1": "abbahī vata me sallaṃ ",
  "pv17:9.2": "sokaṃ hadayanissitaṃ, ",
  "pv17:9.3": "yo me sokaparetassa ",
  "pv17:9.4": "puttasokaṃ apānudi. ",
  "pv17:10.1": "svāhaṃ abbūḷhasallosmi ",
  "pv17:10.2": "sītibhūtosmi nibbuto, ",
  "pv17:10.3": "na socāmi na rodāmi ",
  "pv17:10.4": "tava sutvāna māṇava. ",
  "pv17:11.1": "devatānusi gandhabbo ",
  "pv17:11.2": "ādu sakko purindado, ",
  "pv17:11.3": "ko vā tvaṃ kassa vā putto ",
  "pv17:11.4": "kathaṃ jānemu taṃ mayaṃ ",
  "pv17:12.1": "yañca kandasi yañca rodasi ",
  "pv17:12.2": "puttaṃ āḷāhane sayaṃ dahitvā, ",
  "pv17:12.3": "svāhaṃ kusalaṃ karitvā kammaṃ ",
  "pv17:12.4": "tidāsānaṃ sahavyataṃ patto. ",
  "pv17:13.1": "appaṃ vā bahuṃ vā nāddasāma ",
  "pv17:13.2": "dānaṃ dadantassa sake agāre, ",
  "pv17:13.3": "uposathakammaṃ vā tādisaṃ ",
  "pv17:13.4": "kena kammena gātosi devalokanti. ",
  "pv17:14.1": "ābādhikohaṃ dukkhito bāḷhagilāno ",
  "pv17:14.2": "āturarūpomhi sake nivesane, ",
  "pv17:14.3": "buddhaṃ vigatarajaṃ vitiṇṇakaṅkhaṃ ",
  "pv17:14.4": "addakkhiṃ sugataṃ anomapaññaṃ. ",
  "pv17:15.1": "svāhaṃ muditamano pasannacitto ",
  "pv17:15.2": "añjaliṃ akariṃ tathāgatassa, ",
  "pv17:15.3": "tāhaṃ kusalaṃ karitvā kammaṃ ",
  "pv17:15.4": "tidasānaṃ sahavyataṃ patto. ",
  "pv17:16.1": "acchariyaṃ vata abbhutaṃ ",
  "pv17:16.2": "añjalikammassa ayamīdiso vipāko, ",
  "pv17:16.3": "ahampi muditamano pasannacitto ",
  "pv17:16.4": "ajjeva buddhaṃ saraṇaṃ vajāmi. ",
  "pv17:17.1": "ajjeva buddhaṃ saraṇaṃ vajāhi ",
  "pv17:17.2": "dhammañca saṅghañca pasannacitto, ",
  "pv17:17.3": "tatheva sikkhāya padāni pañca ",
  "pv17:17.4": "akhaṇḍaphullāni samādiyassu. ",
  "pv17:18.1": "pāṇātipātā viramassu khippaṃ ",
  "pv17:18.2": "loke adinnaṃ parivajjayassu, ",
  "pv17:18.3": "amajjapo mā ca musā bhaṇāhi ",
  "pv17:18.4": "sakena dārena ca hohi tuṭṭho. ",
  "pv17:19.1": "atthakāmosi me yakkha ",
  "pv17:19.2": "hitakāmosi devate, ",
  "pv17:19.3": "karomi tuyhaṃ vacanaṃ ",
  "pv17:19.4": "tvaṃsi ācariyo mama. ",
  "pv17:20.1": "upemi saraṇaṃ buddhaṃ ",
  "pv17:20.2": "dhammañcāpi anuttaraṃ, ",
  "pv17:20.3": "saṅghañca naradevassa ",
  "pv17:20.4": "gacchāmi saraṇaṃ ahaṃ. ",
  "pv17:21.1": "pāṇātipātā viramāmi khippaṃ ",
  "pv17:21.2": "loke adinnaṃ parivajjayāmi ",
  "pv17:21.3": "amajjapo no ca musā bhaṇāmi ",
  "pv17:21.4": "sakena dārena ca homi tuṭṭhoti. ",
  "pv17:22.1": "maṭṭakuṇḍalīpetavatthu pañcamaṃ. "
}
