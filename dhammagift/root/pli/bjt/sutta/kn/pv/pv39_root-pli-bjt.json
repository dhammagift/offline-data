  "pv39:0.3": "4. 4. nandaka petavatthu tatiyaṃ. ",
  "pv39:1.1": "uṭṭhehi revate supāpadhamme ",
  "pv39:1.2": "apārutaṃ dvāraṃ adānasīle, ",
  "pv39:1.3": "nessāma taṃ yattha thunanti duggatā. ",
  "pv39:1.4": "samappitā nerayikā dukhena. ",
  "pv39:2.1": "icceva vatvāna yamassa dūtā ",
  "pv39:2.2": "te dve yakkhā lohitakkhā brahantā, ",
  "pv39:2.3": "paccekabāhāsu gahetvāna revatiṃ ",
  "pv39:2.4": "pakkāmayuṃ devagaṇassa santike. ",
  "pv39:3.1": "ādiccavaṇṇaṃ ruciraṃ pabhassaraṃ ",
  "pv39:3.2": "khyamhaṃ subhaṃ kañcanajālachannaṃ, ",
  "pv39:3.3": "kassetamākiṇṇajanaṃ vimānaṃ ",
  "pv39:3.4": "suriyassa raṃsīriva jotamānaṃ. ",
  "pv39:4.1": "nārīgaṇā candanasāralittā ",
  "pv39:4.2": "ubhato vimānaṃ upasobhayanti, ",
  "pv39:4.3": "taṃ dissati suriyasamānavaṇṇaṃ ",
  "pv39:4.4": "ko modati saggappatto vimāne. ",
  "pv39:5.1": "bārāṇasiyaṃ nandiyo nāmupāsako ",
  "pv39:5.2": "amaccharī dānapatī vadaññū, ",
  "pv39:5.3": "tassetamākiṇṇajanaṃ vimānaṃ ",
  "pv39:5.4": "suriyassa raṃsīriva jotamānaṃ. ",
  "pv39:6.1": "nārīgaṇā candanasāralittā ",
  "pv39:6.2": "ubhato vimānaṃ upasobhayanti, ",
  "pv39:6.3": "taṃ dissati suriyasamānavaṇṇaṃ ",
  "pv39:6.4": "so modati saggappatto vimāne. ",
  "pv39:7.1": "nandiyassāhaṃ bhariyā ",
  "pv39:7.2": "agārinī sabbakulassa issarā, ",
  "pv39:7.3": "bhattuvidhāne ramissāmi dānahaṃ ",
  "pv39:7.4": "na patthaye nirayaṃ dassanāya. ",
  "pv39:8.1": "eso te nirayo supāpadhamme ",
  "pv39:8.2": "puññaṃ tayā akataṃ jīvaloke, ",
  "pv39:8.3": "na hi maccharī rosako pāpadhammo ",
  "pv39:8.4": "saggūpagānaṃ labhatī sahavyataṃ. ",
  "pv39:9.1": "kinnu gūthañca muttañca ",
  "pv39:9.2": "asuci patidissati, ",
  "pv39:9.3": "duggandhaṃ kimidaṃ mīḷahaṃ ",
  "pv39:9.4": "kimetaṃ upavāyati, ",
  "pv39:10.1": "esa saṃsavako nāma ",
  "pv39:10.2": "gambhīro sataporiso, ",
  "pv39:10.3": "yattha vassasahassāni ",
  "pv39:10.4": "tuvaṃ paccasi revate. ",
  "pv39:11.1": "kinnu kāyena vācāya ",
  "pv39:11.2": "manasā dukkaṭaṃ kataṃ, ",
  "pv39:11.3": "kena saṃsavako laddho ",
  "pv39:11.4": "gambhīro sataporiso. ",
  "pv39:12.1": "samaṇe brāhmaṇe cāpi ",
  "pv39:12.2": "aññe cāpi vaṇibbake, ",
  "pv39:12.3": "musāvādena vañcesi ",
  "pv39:12.4": "taṃ pāpaṃ pakataṃ tayā. ",
  "pv39:13.1": "tena saṃsavako laddho ",
  "pv39:13.2": "gambhīro sataporiso, ",
  "pv39:13.3": "tattha vassasahassāni ",
  "pv39:13.4": "tuvaṃ paccasi revate. ",
  "pv39:14.1": "hatthepi chindanti athopi pāde ",
  "pv39:14.2": "kaṇṇepi chindanti athopi tāsaṃ, ",
  "pv39:14.3": "athopi kākoḷagaṇā samecca ",
  "pv39:14.4": "saṃgamma khādanti viphandamānaṃ. ",
  "pv39:15.1": "sādhu kho maṃ paṭinetha ",
  "pv39:15.2": "kāhāmi kusalaṃ bahuṃ, ",
  "pv39:15.3": "dānena samacariyāya ",
  "pv39:15.4": "saññamena damena ca, ",
  "pv39:15.5": "yaṃ katvā sukhitā honti ",
  "pv39:15.6": "na ca pacchānutappare. ",
  "pv39:16.1": "pure tuvaṃ pamajjitvā ",
  "pv39:16.2": "idāni paridevasi, ",
  "pv39:16.3": "sayaṃ katānaṃ kammānaṃ ",
  "pv39:16.4": "vipākaṃ anubhossasi. ",
  "pv39:17.1": "ko devalokato manussalokaṃ ",
  "pv39:17.2": "gantvāna puṭṭho me evaṃ vadeyya, ",
  "pv39:17.3": "nikkhittadaṇḍesu dadātha dānaṃ ",
  "pv39:17.4": "acchādanaṃ sayana mathannapānaṃ ",
  "pv39:17.5": "na hi maccharī rosako pāpadhammo ",
  "pv39:17.6": "saggūpagānaṃ labhati sahavyataṃ. ",
  "pv39:18.1": "sāhaṃ nūna ito gantvā ",
  "pv39:18.2": "yoniṃ laddhāna mānusiṃ, ",
  "pv39:18.3": "vadaññū sīlasampannā ",
  "pv39:18.4": "kāhāmi kusalaṃ bahuṃ: ",
  "pv39:18.5": "dānena samacariyāya ",
  "pv39:18.6": "saññamena damena ca. ",
  "pv39:19.1": "ārāmāni ca ropissaṃ ",
  "pv39:19.2": "dugge saṅkamanāni ca, ",
  "pv39:19.3": "papañca udapānañca ",
  "pv39:19.4": "vippasannena cetasā ",
  "pv39:20.1": "cātuddasiṃ pañcadasiṃ ",
  "pv39:20.2": "yā ca pakkhassa aṭṭhamiṃ, ",
  "pv39:20.3": "pāṭihāriyapakkhañca ",
  "pv39:20.4": "aṭṭhaṅgasusamāgataṃ. ",
  "pv39:21.1": "uposathaṃ upavasissaṃ ",
  "pv39:21.2": "sadā sīlesu saṃvutā, ",
  "pv39:21.3": "na ca dāne pamajjissaṃ ",
  "pv39:21.4": "sāmaṃ diṭṭhamidaṃ mayaṃ. ",
  "pv39:22.1": "iccevaṃ vippalapantiṃ ",
  "pv39:22.2": "phandamānaṃ tato tato, ",
  "pv39:22.3": "khipiṃsu niraye ghore ",
  "pv39:22.4": "uddhapādaṃ avaṃsiraṃ. ",
  "pv39:23.1": "ahaṃ pure maccharinī ahosiṃ ",
  "pv39:23.2": "paribhāsikā samaṇabrāhmaṇānaṃ, ",
  "pv39:23.3": "vitathena ca sāmikaṃ vañcayitvā ",
  "pv39:23.4": "paccāmahaṃ niraye ghorarūpe’ti. ",
  "pv39:24.1": ""
}
