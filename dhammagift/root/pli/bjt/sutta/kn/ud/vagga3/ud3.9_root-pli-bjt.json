{
  "ud3.9:0.1": "",
  "ud3.9:0.2": "3. 9. sippasuttaṃ ",
  "ud3.9:1.1": "evaṃ me suta:– ",
  "ud3.9:1.2": "ekaṃ samayaṃ bhagavā sāvatthiyaṃ viharati jetavane anāthapiṇḍikassa ārāme. ",
  "ud3.9:1.3": "tena kho pana samayena sambahulānaṃ bhikkhūnaṃ pacchābhattaṃ piṇḍapātapaṭikkantānaṃ maṇḍalamāle sannisinnānaṃ sannipatitānaṃ ayamantarākathā udapādi: ",
  "ud3.9:1.4": "“ko nu kho āvuso sippaṃ jānāti, ",
  "ud3.9:1.5": "ko kiṃ sippaṃ sikkhi, ",
  "ud3.9:1.6": "kataraṃ sippaṃ sippānaṃ agga”nti. ",
  "ud3.9:2.1": "tatthekacce evamāhaṃsu. ",
  "ud3.9:2.2": "“hatthisippaṃ sippānaṃ agga”nti. ",
  "ud3.9:2.3": "ekacce evamāhaṃsu: ",
  "ud3.9:2.4": "“assasippaṃ sippānaṃ agga”nti. ",
  "ud3.9:2.5": "ekacce evamāhaṃsu: ",
  "ud3.9:2.6": "“rathasippaṃ sippānaṃ agga”nti. ",
  "ud3.9:2.7": "ekacce evamāhaṃsu: ",
  "ud3.9:2.8": "“dhanusippaṃ sippānaṃ agga”nti. ",
  "ud3.9:2.9": "ekacce evamāhaṃsu: ",
  "ud3.9:2.10": "“tharusippaṃ sippānaṃ agga”nti. ",
  "ud3.9:2.11": "ekacce evamāhaṃsu: ",
  "ud3.9:2.12": "“muddāsippaṃ sippānaṃ agga”nti. ",
  "ud3.9:2.13": "ekacce evamāhaṃsu: ",
  "ud3.9:2.14": "“gaṇanasippaṃ sippānaṃ agga”nti. ",
  "ud3.9:2.15": "ekacce evamāhaṃsu: ",
  "ud3.9:2.16": "“saṅkhānasippaṃ sippānaṃ agga”nti. ",
  "ud3.9:2.17": "ekacce evamāhaṃsu: ",
  "ud3.9:2.18": "“lekhāsippaṃ sippānaṃ agga”nti. ",
  "ud3.9:2.19": "ekacce evamāhaṃsu: ",
  "ud3.9:2.20": "“kāveyyasippaṃ sippānaṃ agga”nti. ",
  "ud3.9:2.21": "ekacce evamāhaṃsu: ",
  "ud3.9:2.22": "“lokāyatasippaṃ sippānaṃ agga”nti. ",
  "ud3.9:2.23": "ekacce evamāhaṃsu: ",
  "ud3.9:2.24": "“khattavijjāsippaṃ sippānaṃ agga”nti. ",
  "ud3.9:2.25": "ayañcarahi tesaṃ bhikkhūnaṃ antarākathā hoti vippakatā. ",
  "ud3.9:3.1": "atha kho bhagavā sāyanhasamayaṃ patisallānā vuṭṭhito yena maṇḍalamālo tenupasaṅkami. upasaṅkamitvā paññatte āsane nisīdi. ",
  "ud3.9:3.2": "nisajja kho bhagavā bhikkhū āmantesi: ",
  "ud3.9:3.3": "“kāyanuttha bhikkhave etarahi kathāya sannisinnā, kā ca pana vo antarā kathā vippakatā”ti. ",
  "ud3.9:4.1": "idha bhante amhākaṃ pacchābhattaṃ piṇḍapātapaṭikkantānaṃ maṇḍalamāle sannisinnānaṃ sannipatitānaṃ ayamantarā kathā udapādi: ",
  "ud3.9:4.2": "“ko nu kho āvuso sippaṃ jānāti, ",
  "ud3.9:4.3": "ko kiṃ sippaṃ sikkhi, ",
  "ud3.9:4.4": "kataraṃ sippaṃ sippānaṃ agga”nti. ",
  "ud3.9:5.1": "tatthekacce evamāhaṃsu: ",
  "ud3.9:5.2": "“hatthisippaṃ sippānaṃ agga”nti. ",
  "ud3.9:5.3": "ekacce evamāhaṃsu: ",
  "ud3.9:5.4": "‘assasippaṃ sippānaṃ agga”nti. ",
  "ud3.9:5.5": "ekacce evamāhaṃsu: ",
  "ud3.9:5.6": "“rathasippaṃ sippānaṃ agga”nti. ",
  "ud3.9:5.7": "ekacce evamāhaṃsu: ",
  "ud3.9:5.8": "“dhanusippaṃ sippānaṃ agga”nti. ",
  "ud3.9:5.9": "ekacce evamāhaṃsu: ",
  "ud3.9:5.10": "“tharusippaṃ sippānaṃ agga”nti. ",
  "ud3.9:5.11": "ekacce evamāhaṃsu: ",
  "ud3.9:5.12": "“muddāsippaṃ sippānaṃ agga”nti. ",
  "ud3.9:5.13": "ekacce evamāhaṃsu: ",
  "ud3.9:5.14": "“gaṇanasippaṃ sippānaṃ agga”nti. ",
  "ud3.9:5.15": "ekacce evamāhaṃsu: ",
  "ud3.9:5.16": "“saṅkhānasippaṃ sippānaṃ agga”nti. ",
  "ud3.9:5.17": "ekacce evamāhaṃsu: ",
  "ud3.9:5.18": "“lekhāsippaṃ sippānaṃ agga”nti. ",
  "ud3.9:5.19": "ekacce evamāhaṃsu: ",
  "ud3.9:5.20": "“kāveyyasippaṃ sippānaṃ agga”nti. ",
  "ud3.9:5.21": "ekacce evamāhaṃsu: ",
  "ud3.9:5.22": "“lokāyatasippaṃ sippānaṃ agga”nti. ",
  "ud3.9:5.23": "ekacce evamāhaṃsu: ",
  "ud3.9:5.24": "khattavijjā sippaṃ sippānaṃ agga”nti. ",
  "ud3.9:5.25": "ayaṃ kho no bhante antarā kathā hoti vippakatā. atha kho bhagavā anuppattoti. ",
  "ud3.9:6.1": "“nakhvetaṃ bhikkhave tumhākaṃ patirūpaṃ kulaputtānaṃ saddhā agārasmā anagāriyaṃ pabbajitānaṃ, yaṃ tumhe evarūpiṃ kathaṃ katheyyātha. ",
  "ud3.9:6.2": "sannipatitānaṃ vo bhikkhave dvayaṃ karaṇīyaṃ, ",
  "ud3.9:6.3": "“dhammī vā kathā ariyo vā tuṇhībhāvo”ti. ",
  "ud3.9:7.1": "atha kho bhagavā etamatthaṃ viditvā tāyaṃ velāyaṃ imaṃ udānaṃ udānesi: ",
  "ud3.9:8.1": "asippajīvī lahu atthakāmo ",
  "ud3.9:8.2": "yatindriyo sabbadhi vippamutto, ",
  "ud3.9:8.3": "anokasārī amamo nirāso ",
  "ud3.9:8.4": "hitvā mānaṃ ekacaro sa bhikkhū”ti. ",
  "ud3.9:8.5": ""
}
