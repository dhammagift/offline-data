  "iti23:0.4": "1. 3. 3. [ubho-attha suttaṃ] ",
  "iti23:1.1": "vuttaṃ hetaṃ bhagavatā. vuttamarahatā’ti me sutaṃ: ",
  "iti23:2.1": "ekadhammo bhikkhave bhāvito bahulīkato ubho atthe samadhigayha tiṭṭhati, ",
  "iti23:2.2": "diṭṭhadhammikañceva atthaṃ samparāyikañca. ",
  "iti23:2.3": "katamo ekadhammo? ",
  "iti23:2.4": "appamādo kusalesu dhammesu. ",
  "iti23:2.5": "ayaṃ kho bhikkhave ekadhammo bhāvito bahulīkato ubho atthe samadhigayha tiṭṭhati ",
  "iti23:2.6": "diṭṭhadhammikañceva atthaṃ samparāyikañcā ti. ",
  "iti23:2.7": "etamatthaṃ bhagavā avoca. ",
  "iti23:2.8": "tatthetaṃ iti vuccati: ",
  "iti23:3.1": "“appamādaṃ pasaṃsanti ",
  "iti23:3.2": "puññakiriyāsu paṇḍitā. ",
  "iti23:3.3": "appamatto ubho atthe ",
  "iti23:3.4": "adhigaṇhāti paṇḍito. ",
  "iti23:4.1": "diṭṭhevadhamme yo attho ",
  "iti23:4.2": "yo cattho samparāyiko ",
  "iti23:4.3": "atthābhisamayā dhīro ",
  "iti23:4.4": "paṇḍitoti pavuccatī”ti. ",
  "iti23:5.1": "ayampi attho vutto bhagavatā, iti me sutanti. ",
  "iti23:5.2": ""
}
