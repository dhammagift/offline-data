  "iti20:0.3": "",
  "iti20:0.4": "1. 2. 10. [paduṭṭhapuggalasuttaṃ] ",
  "iti20:1.1": "vuttaṃ hetaṃ bhagavatā. vuttamarahatā’ti me sutaṃ: ",
  "iti20:2.1": "idāhaṃ bhikkhave ekaccaṃ puggalaṃ paduṭṭhacittaṃ evaṃ cetasā ceto paricca pajānāmi: ",
  "iti20:2.2": "“imamhi cāyaṃ samaye puggalo kālaṃ kareyya, yathābhataṃ nikkhitto, evaṃ niraye. ",
  "iti20:2.3": "taṃ kissa hetu: ",
  "iti20:2.4": "cittañhi’ssa bhikkhave paduṭṭhaṃ. ",
  "iti20:2.5": "cetopadosahetu kho pana bhikkhave evamidhekacce sattā kāyassa bhedā parammaraṇā apāyaṃ duggatiṃ vinipātaṃ nirayaṃ upapajjantī”ti. ",
  "iti20:2.6": "etamatthaṃ bhagavā avoca. ",
  "iti20:2.7": "tatthetaṃ iti vuccati: ",
  "iti20:3.1": "“paduṭṭhacittaṃ ñatvāna ",
  "iti20:3.2": "ekaccaṃ idha puggalaṃ, ",
  "iti20:3.3": "etamatthañca vyākāsi ",
  "iti20:3.4": "buddho bhikkhūna santike. ",
  "iti20:4.1": "imamhi cāyaṃ samaye ",
  "iti20:4.2": "kālaṃ kayirātha puggalo, ",
  "iti20:4.3": "nirayaṃ upapajjeyya ",
  "iti20:4.4": "cittañhi’ssa padūsitaṃ.” ",
  "iti20:5.1": "yathā’haritvā nikkhipeyya ",
  "iti20:5.2": "evameva tathāvidhā ",
  "iti20:5.3": "cetopadosahetū hi ",
  "iti20:5.4": "sattā gacchanti duggati”nti ",
  "iti20:6.1": "ayampi attho vutto bhagavatā. iti me sutanti. ",
  "iti20:6.2": "vaggo ",
  "iti20:6.3": "dutiyo. tassuddāna: ",
  "iti20:7.0": "",
  "iti20:7.1": "moho kodho atha makkho ",
  "iti20:7.2": "vijjā taṇhā sekhā duve, ",
  "iti20:7.3": "bhedo sāmaggi puggalo ca ",
  "iti20:7.4": "vaggamāhu dutiyanti vuccati. "
}
