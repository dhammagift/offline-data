  "vv60:0.3": "",
  "vv60:0.4": "5. 10. dutiyasūcivimānaṃ. ",
  "vv60:1.1": "susukkakhandhaṃ abhiruyhaṃ nāgaṃ ",
  "vv60:1.2": "akācitaṃ dantiṃ baliṃ mahājavaṃ ",
  "vv60:1.3": "abhiruyha gajavaraṃ sukappitaṃ ",
  "vv60:1.4": "idhāgamā vehāsayamantaḷikkhe. ",
  "vv60:2.1": "nāgassa dantesu duvesu nimmitā ",
  "vv60:2.2": "acchodikā paduminiyo suphullā ",
  "vv60:2.3": "padumesu ca turiyagaṇā pavajjare ",
  "vv60:2.4": "imā ca naccanti manobharāyo. ",
  "vv60:3.1": "deviddhipattosi mahānubhāvo ",
  "vv60:3.2": "manussabhūto kimakāsi puññaṃ ",
  "vv60:3.3": "kenāsi evaṃ jalitānubhāvo ",
  "vv60:3.4": "vaṇṇo ca te sabbadisā pabhāsatīti. ",
  "vv60:4.1": "so devaputto attamano ",
  "vv60:4.2": "moggallānena pucchetā, ",
  "vv60:4.3": "pañhaṃ puṭṭho viyākāsi ",
  "vv60:4.4": "yassa kammassidaṃ phalaṃ. ",
  "vv60:5.1": "aṭṭheva muttapupphāni ",
  "vv60:5.2": "kassapassa mahesino ",
  "vv60:5.3": "thūpasmiṃ abhiropesiṃ ",
  "vv60:5.4": "pasanno sehi pāṇihi. ",
  "vv60:6.1": "tena me tādiso vaṇṇo ",
  "vv60:6.2": "tena me idhamijjhati, uppajjanti ca me bhogā ye keci manaso piyā. akkhāmi te bhikkhu mahānubhāva manussabhūto yamakāsi puññaṃ tenamhi evaṃ jalitānubhāvo ",
  "vv60:6.3": "vaṇṇo ca me sabbadisā pabhāsatīti. ",
  "vv60:7.1": ""
}
