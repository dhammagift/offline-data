  "vv27:0.1": "",
  "vv27:0.2": "",
  "vv27:0.3": "",
  "vv27:0.4": "2. 10. ",
  "vv27:1.1": "abhikkantena vaṇṇena ",
  "vv27:1.2": "yā tvaṃ tiṭṭhasi devate, ",
  "vv27:1.3": "obhāsenti disā sabbā ",
  "vv27:1.4": "osadhī viya tārakā. ",
  "vv27:2.1": "kena te tādiso vaṇṇo ",
  "vv27:2.2": "kena te idhamijjhati, uppajjanti ca te bhogā ye keci manaso piyā. pucchāmi taṃ devi mahānubhāve manussabhūtā kimakāsi puññaṃ kenāsi evaṃ jalitānubhāvā ",
  "vv27:2.3": "vaṇṇo ca te sabbadisā pabhāsatīti. ",
  "vv27:3.1": "sā devatā attamanā ",
  "vv27:3.2": "moggallānena pucchitā, pañhaṃ puṭṭhā viyākāsi ",
  "vv27:3.3": "yassa kammassidaṃ phalaṃ. ",
  "vv27:4.1": "ahaṃ manussesu manussabhūtā ",
  "vv27:4.2": "purimāya jātiyā manussaloke ",
  "vv27:5.1": "addasaṃ virajaṃ buddhaṃ ",
  "vv27:5.2": "vippasannamanāvilaṃ ",
  "vv27:5.3": "tassa adāsahaṃ bhikkhaṃ ",
  "vv27:5.4": "pasannā sehi pāṇihi ",
  "vv27:6.1": "tena me tādiso vaṇṇo ",
  "vv27:6.2": "tena me idhamijjhati, uppajjanti ca me bhogā ye keci manaso piyā. akkhāmi te bhikkhu mahānubhāva manussabhūtā yamahaṃ akāsiṃ tenamhi evaṃ jalitānubhāvā ",
  "vv27:6.3": "vaṇṇo ca me sabbadisā pabhāsatīti. ",
  "vv27:7.1": "bhikkhādāyikā vimānaṃ. "
}
