{
  "vv77:0.1": "",
  "vv77:0.2": "",
  "vv77:0.3": "",
  "vv77:0.4": "7. 3. ",
  "vv77:1.1": "uccamidaṃ maṇithūṇaṃ vimānaṃ ",
  "vv77:1.2": "samantato dvādasa yojanāni ",
  "vv77:1.3": "kūṭāgārā sattasatā uḷārā ",
  "vv77:1.4": "veḷuriyatthambhā rucakatthatā subhā ",
  "vv77:2.1": "tatthacchasi pivasi khādasi ca ",
  "vv77:2.2": "dibbā ca vīṇā pavadanti vagguṃ ",
  "vv77:2.3": "dibbā rasā kāmaguṇettha pañca ",
  "vv77:2.4": "nāriyo ca naccanti suvaṇṇa channā ",
  "vv77:3.1": "kena te tādiso vaṇṇo ",
  "vv77:3.2": "kena te idhamijjhati, uppajjanti ca te bhogā ye keci manaso piyā deviddhipattosi mahānubhāvo manussabhūto kimakāsi puññaṃ kenāsi evaṃ jalitānubhāvo ",
  "vv77:3.3": "vaṇṇo ca te sabbadisā pabhāsatīti. ",
  "vv77:4.1": "so devaputto attamano ",
  "vv77:4.2": "moggallānena pucchito, pañhaṃ puṭṭho viyākāsi ",
  "vv77:4.3": "yassa kammassidaṃ phalaṃ ",
  "vv77:5.1": "ahaṃ manussesu manussabhūto ",
  "vv77:5.2": "vivane pathe caṅkamanaṃ akāsiṃ ",
  "vv77:5.3": "ārāmarukkhāni ca ropayissaṃ ",
  "vv77:5.4": "piyā ca me sīlavanto ahesuṃ ",
  "vv77:5.5": "annaṃ ca pānaṃ ca pasannacitto ",
  "vv77:5.6": "sakkaccadānaṃ vipulaṃ adāsiṃ ",
  "vv77:6.1": "tena me tādiso vaṇṇo ",
  "vv77:6.2": "tena me idhamijjhati, uppajjanti ca me bhogā ye keci manaso piyā akkhāmi te bhikkhu mahānubhāva manussabhūto yamakāsi puññaṃ tenamhi evaṃ jalitānubhāvo ",
  "vv77:6.3": "vaṇṇo ca me sabbadisā pabhāsatīti. ",
  "vv77:7.1": "maṇithūṇavimānaṃ. "
}
