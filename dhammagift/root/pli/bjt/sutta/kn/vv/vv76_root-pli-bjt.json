  "vv76:0.3": "",
  "vv76:0.4": "7. 2. cittalatāvimānaṃ ",
  "vv76:1.1": "yathā vanaṃ nandanaṃ cittalataṃ pabhāsati ",
  "vv76:1.2": "uyyānaseṭṭhaṃ tidasānamuttamaṃ ",
  "vv76:1.3": "tadūpamaṃ tuyhamidaṃ vimānaṃ ",
  "vv76:1.4": "obhāsayaṃ tiṭṭhati antaḷikkhe ",
  "vv76:2.1": "deviddhipattosi mahānubhāvo ",
  "vv76:2.2": "manussabhūto kimakāsi puññaṃ ",
  "vv76:2.3": "kenāsi evaṃ jalitānubhāvo ",
  "vv76:2.4": "vaṇṇoca te sabbadisā pabhāsatīti ",
  "vv76:3.1": "so devaputto attamano ",
  "vv76:3.2": "moggallānena pucchito, pañhaṃ puṭṭho viyākāsi ",
  "vv76:3.3": "yassa kammassidaṃ phalaṃ ",
  "vv76:4.1": "ahaṃ manussesu manussabhūto ",
  "vv76:4.2": "daḷiddo atāṇo kapaṇo kammakaro ahosiṃ ",
  "vv76:4.3": "jiṇṇo ca mātāpitaro abhariṃ ",
  "vv76:4.4": "piyā ca me sīlavanto ahesuṃ ",
  "vv76:4.5": "annañca pānañca pasannacitto ",
  "vv76:4.6": "sakkacca dānaṃ vipulaṃ adāsiṃ ",
  "vv76:5.1": "tena me tādiso vaṇṇo ",
  "vv76:5.2": "tena me idhamijjhati, uppajjanti ca me bhogā ye keci manaso piyā. akkhāmi te bhikkhu mahānubhāva manussabhūto yamakāsi puññaṃ tenamhi evaṃ jalitānubhāvo ",
  "vv76:5.3": "vaṇṇo ca me sabbadisā pabhāsatīti. ",
  "vv76:6.1": ""
}
