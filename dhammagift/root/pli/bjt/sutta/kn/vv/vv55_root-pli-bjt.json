  "vv55:0.1": "",
  "vv55:0.2": "",
  "vv55:0.3": "",
  "vv55:0.4": "5. 5. ",
  "vv55:1.1": "uccamidaṃ maṇithūṇaṃ vimānaṃ ",
  "vv55:1.2": "samantato dvādasa yojanāni ",
  "vv55:1.3": "kūṭāgārā sattasatā uḷārā ",
  "vv55:1.4": "veḷuriyatthambhā rucakatthatā subhā. ",
  "vv55:2.1": "tatthacchasi pivasi khādasica ",
  "vv55:2.2": "dibbā ca vīṇā pavadanti vagguṃ ",
  "vv55:2.3": "dibbā rasā kāmaguṇettha pañca ",
  "vv55:2.4": "nāriyo ca naccanti suvaṇṇachannā. ",
  "vv55:3.1": "kena te tādiso vaṇṇo ",
  "vv55:3.2": "kena te idhamijjhati, uppajjanti ca te bhogā ye keci manaso piyā. pucchāmi taṃ deva mahānubhāva manussabhūto kimakāsi puññaṃ kenāsi evaṃ jalitānubhāvo ",
  "vv55:3.3": "vaṇṇo ca te sabbadisā pabhāsatīti. ",
  "vv55:4.1": "so devaputtā attamano ",
  "vv55:4.2": "moggallānena pucchito, ",
  "vv55:4.3": "pañhaṃ puṭṭho viyākāsi ",
  "vv55:4.4": "yassa kammassidaṃ phalaṃ. ",
  "vv55:5.1": "dibbaṃ mamaṃ vassasahassamāyu ",
  "vv55:5.2": "vācābhigītaṃ manasā pavattitaṃ ",
  "vv55:5.3": "ettāvatā ṭhassati puññakammo ",
  "vv55:5.4": "dibbehi kāmehi samaṅgibhūto. ",
  "vv55:6.1": "tena me tādiso vaṇṇo ",
  "vv55:6.2": "tena me idhamijjhati, uppajjanti ca me bhogā ye keci manaso piyā. akkhāmi te bhikkhu mahānubhāva manussabhūto yamakāsi puññaṃ tenamhi evaṃ jalitānubhāvo ",
  "vv55:6.3": "vaṇṇo ca me sabbadisā pabhāsatīti. ",
  "vv55:7.1": ""
}
