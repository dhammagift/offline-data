  "vv73:0.3": "",
  "vv73:0.4": "6. 9. paṭhamakuṇḍalīvimānaṃ ",
  "vv73:1.1": "alaṅkato malyadharo suvattho ",
  "vv73:1.2": "sukuṇḍalī kappitakesamassu ",
  "vv73:1.3": "āmuttahatthābharaṇo yasassī ",
  "vv73:1.4": "dibbe vimānamhi yathāsi candimā ",
  "vv73:2.1": "dibbā ca vīṇā pavadanti vagguṃ ",
  "vv73:2.2": "aṭṭhaṭṭhakā sikkhitā sādhurūpā ",
  "vv73:2.3": "dibbā ca kaññā tidasacarā uḷārā ",
  "vv73:2.4": "naccanti gāyanti pamodayanti ",
  "vv73:3.1": "deviddhipattosi mahānubhāvo ",
  "vv73:3.2": "manussabhūto kimakāsi puññaṃ ",
  "vv73:3.3": "kenāsi evaṃ jalitānubhāvo ",
  "vv73:3.4": "vaṇṇo ca te sabbadisā pabhāsatīti ",
  "vv73:4.1": "so devaputto attamano ",
  "vv73:4.2": "moggallānena pucchito, pañhaṃ puṭṭho viyākāsi ",
  "vv73:4.3": "yassa kammassidaṃ phalanti ",
  "vv73:5.1": "ahaṃ manussesu manussabhūto ",
  "vv73:5.2": "disvāna samaṇe sādhurūpe ",
  "vv73:5.3": "sampannavijjācaraṇe yasassī ",
  "vv73:5.4": "bahussute sīlavatūpapanne ",
  "vv73:5.5": "annañca pānañca pasannacitto ",
  "vv73:5.6": "sakkacca dānaṃ vipulaṃ adāsiṃ ",
  "vv73:6.1": "tena me tādiso vaṇṇo ",
  "vv73:6.2": "tena me idhamijjhati, uppajjanti ca me bhogā ye keci manaso piyā akkhāmi te bhikkhu mahānubhāva manussabhūto yamakāsi puññaṃ tenamhi evaṃ jalitānubhāvo ",
  "vv73:6.3": "vaṇṇo ca me sabbadisā pabhāsatīti. ",
  "vv73:7.1": ""
}
