{
  "vv85:0.1": "",
  "vv85:0.2": "",
  "vv85:0.3": "",
  "vv85:0.4": "7. 11. ",
  "vv85:1.1": "uccamidaṃ maṇithūṇaṃ vimānaṃ ",
  "vv85:1.2": "samantato dvādasa yojanāni ",
  "vv85:1.3": "kūṭāgārā sattasatā uḷārā ",
  "vv85:1.4": "veḷuriyatthamhā rucakatthatā subhā ",
  "vv85:2.1": "tatthacchasi pivasi khādasi ca ",
  "vv85:2.2": "dibbā ca vīṇā pavadanti vagguṃ ",
  "vv85:2.3": "dibbā rasā kāmaguṇettha pañca ",
  "vv85:2.4": "nāriyo ca naccanti suvaṇṇachannā. ",
  "vv85:3.1": "kena te tādiso vaṇṇo ",
  "vv85:3.2": "kena te idhamijjhati ",
  "vv85:3.3": "uppajjanti ca te bhogā ",
  "vv85:3.4": "ye keci manaso piyā ",
  "vv85:4.1": "pucchāmi taṃ deva mahānubhāva ",
  "vv85:4.2": "manussabhūto kimakāsi puññaṃ ",
  "vv85:4.3": "kenāsi evaṃ jalitānubhāvo ",
  "vv85:4.4": "vaṇṇo ca te sabbadisā pabhāsatīti. ",
  "vv85:5.1": "so devaputto attamano ",
  "vv85:5.2": "moggallānena pucchito, ",
  "vv85:5.3": "pañhaṃ puṭṭho viyākāsi ",
  "vv85:5.4": "yassa kammassidaṃ phalaṃ. ",
  "vv85:6.1": "dunnīkkhittaṃ mālaṃ sunikkhipitvā ",
  "vv85:6.2": "patiṭṭhapetvā sugatassa thūpe ",
  "vv85:6.3": "mahiddhiko camhi mahānubhāvo ",
  "vv85:6.4": "dibbehi kāmehi samaṅgibhūto. ",
  "vv85:7.1": "tena me tādiso vaṇṇo ",
  "vv85:7.2": "tena me idhamijjhati, ",
  "vv85:7.3": "uppajjanti ca me bhogā ",
  "vv85:7.4": "ye keci manaso piyā. ",
  "vv85:8.1": "akkhāmi te bhikkhu mahānubhāva ",
  "vv85:8.2": "manussabhūto yamahaṃ akāsiṃ ",
  "vv85:8.3": "tenamhi evaṃ jalitānubhāvo ",
  "vv85:8.4": "vaṇṇo ca me sabbadisā pabhāsatīti. ",
  "vv85:9.1": "sunikkhittavimānaṃ. ",
  "vv85:9.2": "sunikkhittavaggo sattamo. ",
  "vv85:10.1": "tassuddānaṃ: ",
  "vv85:11.1": "dve daḷiddā dve vihārā ",
  "vv85:11.2": "bhatako gopālakanthakā anekavaṇṇā ",
  "vv85:11.3": "maṭṭakuṇḍalī ",
  "vv85:11.4": "serissako sunikkhittaṃ ",
  "vv85:11.5": "purisānaṃ tatiyo vaggoti. ",
  "vv85:12.1": "bhāṇavāraṃ catutthaṃ. ",
  "vv85:13.1": "vimānavatthu niṭṭhitaṃ "
}
