{
  "vv58:0.1": "",
  "vv58:0.2": "",
  "vv58:0.3": "",
  "vv58:0.4": "5. 8. ",
  "vv58:1.1": "uccamidaṃ maṇithūṇaṃ vimānaṃ ",
  "vv58:1.2": "samantato dvādasa yojanāni ",
  "vv58:1.3": "kūṭāgārā sattasatā uḷārā ",
  "vv58:1.4": "veḷuriyatthambhā rucakatthatā subhā. ",
  "vv58:2.1": "tatthacchasi pivasi khādasi ca ",
  "vv58:2.2": "dibbā ca vīṇā pavadanti vagguṃ ",
  "vv58:2.3": "dibbā rasā kāmaguṇettha pañca ",
  "vv58:2.4": "nāriyo ca naccanti suvaṇṇa chattā. ",
  "vv58:3.1": "kena te tādiso vaṇṇo ",
  "vv58:3.2": "kena te idhamijjhati uppajjanti ca te bhogā ye keci manaso piyā. pucchāmi taṃ deva mahānubhāva manussabhūto kimakāsi puññaṃ kenāsi evaṃ jalitānubhāvo ",
  "vv58:3.3": "vaṇṇo ca te sabbadisā pabhāsatīti. ",
  "vv58:4.1": "so devaputto attamano ",
  "vv58:4.2": "moggallānena pucchito, pañhaṃ puṭṭho viyākāsi ",
  "vv58:4.3": "yassa kammassidaṃ phalaṃ. ",
  "vv58:5.1": "yaṃ dadāti na taṃ hoti ",
  "vv58:5.2": "yañceva dajjā tañceva seyyo ",
  "vv58:5.3": "sūci dinnā sūcimeva seyyo. ",
  "vv58:6.1": "tena me tādiso vaṇṇo ",
  "vv58:6.2": "tena me idhamijjhati, uppajjanti ca me bhogā ye keci manaso piyā. akkhāmi te bhikkhu mahānubhāva manussabhūto yamakāsi puññaṃ tenamhi evaṃ jalitānubhāvo ",
  "vv58:6.3": "vaṇṇo ca me sabbadisā pabhāsatīti. ",
  "vv58:7.1": "sūcīvimānaṃ. "
}
