{
  "vv47:0.1": "",
  "vv47:0.2": "",
  "vv47:0.3": "",
  "vv47:0.4": "4. 9. ",
  "vv47:1.1": "pītavatthe pītadhaje ",
  "vv47:1.2": "pītālaṅkārabhūsite, ",
  "vv47:1.3": "pītacandanalittaṅge ",
  "vv47:1.4": "pītauppalamālini ",
  "vv47:2.1": "pītapāsādasayane ",
  "vv47:2.2": "pītāsane pītabhājane, ",
  "vv47:2.3": "pītachatte pītarathe ",
  "vv47:2.4": "pītasse pītavījane. ",
  "vv47:3.1": "kiṃ kammamakarī bhadde ",
  "vv47:3.2": "pubbe mānusake bhave, ",
  "vv47:3.3": "devate pucchitācikkha ",
  "vv47:3.4": "kissa kammassidaṃ phala’nti. ",
  "vv47:4.1": "kosātakī nāma latatthi bhante ",
  "vv47:4.2": "kittitā anabhijjhitā, ",
  "vv47:4.3": "tassā cattāri pupphāni ",
  "vv47:4.4": "thūpaṃ abhihariṃ ahaṃ. ",
  "vv47:5.1": "satthu sarīramuddissa ",
  "vv47:5.2": "vippasannena cetasā, ",
  "vv47:5.3": "nāssa maggaṃ avekkhissaṃ ",
  "vv47:5.4": "tadaggamanasā sati. ",
  "vv47:6.1": "tato maṃ avadhī gāvī ",
  "vv47:6.2": "thūpaṃ appattamānasaṃ, ",
  "vv47:6.3": "tañcāhaṃ abhisañceyyaṃ ",
  "vv47:6.4": "bhīyo nūna ito siyā. ",
  "vv47:7.1": "tena kammena devinda ",
  "vv47:7.2": "maghavā devakuñjara, ",
  "vv47:7.3": "pahāya mānusaṃ dehaṃ ",
  "vv47:7.4": "tava sahavyatamāgatā, ti ",
  "vv47:8.1": "idaṃ sutvā tidasādhipati ",
  "vv47:8.2": "maghavā devakuñjaro, ",
  "vv47:8.3": "tāvatiṃse pasādento ",
  "vv47:8.4": "mātaliṃ etadabravī, ti. ",
  "vv47:9.1": "passa mātali accheraṃ ",
  "vv47:9.2": "cittaṃ kammaphalaṃ idaṃ, ",
  "vv47:9.3": "appakampi kataṃ deyyaṃ ",
  "vv47:9.4": "puññaṃ hoti mahapphalaṃ ",
  "vv47:10.1": "natthi citte pasannamhi ",
  "vv47:10.2": "appikānāma dakkhiṇā, ",
  "vv47:10.3": "tathāgate vā sambuddhe ",
  "vv47:10.4": "athavā tassa sāvake. ",
  "vv47:11.1": "ehi mātali amhepi ",
  "vv47:11.2": "bhiyyo bhiyyo mahemase, ",
  "vv47:11.3": "tathāgatassa dhātuyo ",
  "vv47:11.4": "sukho puññānamuccayo. ",
  "vv47:12.1": "tiṭṭhante nibbute cāpi ",
  "vv47:12.2": "same citte samaṃ phalaṃ, ",
  "vv47:12.3": "cetopaṇidhihetūhi ",
  "vv47:12.4": "sattā gacchanti suggatiṃ. ",
  "vv47:13.1": "bahunnaṃ vata atthāya ",
  "vv47:13.2": "uppajjanti tathāgatā, ",
  "vv47:13.3": "yattha kāraṃ karitvāna ",
  "vv47:13.4": "saggaṃ gacchanti dāyakā, ",
  "vv47:14.1": "ti. "
}
