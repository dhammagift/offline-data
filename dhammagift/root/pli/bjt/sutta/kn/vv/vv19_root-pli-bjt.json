  "vv19:0.1": "",
  "vv19:0.2": "",
  "vv19:0.3": "",
  "vv19:0.4": "2. 2. dāsīvimānaṃ. ",
  "vv19:1.1": "abhikkantena vaṇṇena ",
  "vv19:1.2": "yā tvaṃ tiṭṭhasi devate, ",
  "vv19:1.3": "obhāsenti disā sabbā ",
  "vv19:1.4": "osadhī viya tārākā. ",
  "vv19:2.1": "kena te tādiso vaṇṇo ",
  "vv19:2.2": "kena te idhamijjhati, ",
  "vv19:2.3": "uppajjanti ca te bhogā ",
  "vv19:2.4": "ye keci manaso piyā. ",
  "vv19:3.1": "pucchāmi taṃ devi mahānubhāve ",
  "vv19:3.2": "manussabhūtā kimakāsi puññaṃ ",
  "vv19:3.3": "kenāsi evaṃ jalitānubhāvā ",
  "vv19:3.4": "vaṇṇo ca te sabbadisā pabhāsatīti. ",
  "vv19:4.1": "sā devatā attamanā ",
  "vv19:4.2": "moggallānena pucchitā, ",
  "vv19:4.3": "pañhaṃ puṭṭhā viyākāsi ",
  "vv19:4.4": "yassa kammassidaṃ phalaṃ. ",
  "vv19:5.1": "kevaṭṭadvārā nikkhamma ",
  "vv19:5.2": "ahu mayhaṃ nivesanaṃ, ",
  "vv19:5.3": "tattha sañcaramānānaṃ ",
  "vv19:5.4": "sāvakānaṃ mahesinaṃ. ",
  "vv19:6.1": "odanaṃ kummāsaṃ sākaṃ ",
  "vv19:6.2": "loṇasovīrakañcahaṃ, ",
  "vv19:6.3": "adāsiṃ ujubhūtesu ",
  "vv19:6.4": "vippasannena cetasā. ",
  "vv19:7.1": "cātuddasiṃ pañcadasiṃ ",
  "vv19:7.2": "yā ca pakkhassa aṭṭhamī, ",
  "vv19:7.3": "pāṭihāriyapakkhañca ",
  "vv19:7.4": "aṭṭhaṅgasusamāgataṃ ",
  "vv19:8.1": "uposathaṃ upavasissaṃ ",
  "vv19:8.2": "sadā sīlesu saṃvutā, ",
  "vv19:8.3": "saññamā saṃvibhāgā ca ",
  "vv19:8.4": "vimānaṃ āvasāmahaṃ ",
  "vv19:9.1": "pāṇātipātā viratā ",
  "vv19:9.2": "musāvādā ca saññatā, ",
  "vv19:9.3": "theyyā ca aticārā ca ",
  "vv19:9.4": "majjapānā ca ārakā ",
  "vv19:10.1": "pañcasikkhāpade ratā ",
  "vv19:10.2": "ariyasaccāna kovidā, ",
  "vv19:10.3": "upāsikā cakkhumato ",
  "vv19:10.4": "gotamassa yasassino ",
  "vv19:11.1": "tena me tādiso vaṇṇo ",
  "vv19:11.2": "tena me idhamijjhati, uppajjanti ca me bhogā ye keci manaso piyā. akkhāmi te bhikkhu mahānubhāva manussabhūtā yamahaṃ akāsiṃ tenamhi evaṃ jalitānubhāvā ",
  "vv19:11.3": "vaṇṇo ca me sabbadisā pabhāsatīti. ",
  "vv19:12.1": "mama ca bhante vacanena bhagavato pāde sirasā vandeyyāsi, ",
  "vv19:12.2": "lakhumā nāma bhante upāsikā bhagavato pāde sirasā vandatīti. ",
  "vv19:12.3": "anacchariyaṃ kho panetaṃ bhante yaṃ maṃ bhagavā aññatarasmiṃ sāmaññaphale vyākareyya ",
  "vv19:12.4": "taṃ bhagavā sakadāgāmiphale vyākāsīti. ",
  "vv19:13.1": ""
}
