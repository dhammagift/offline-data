{
  "vv37:0.1": "",
  "vv37:0.2": "",
  "vv37:0.3": "",
  "vv37:0.4": "3. 9. ",
  "vv37:1.1": "kā nāma tvaṃ visālakkhi ",
  "vv37:1.2": "ramme cittalatāvane, ",
  "vv37:1.3": "samantā anupariyāsi ",
  "vv37:1.4": "nārīgaṇapurakkhatā. ",
  "vv37:2.1": "yadā devā tāvatiṃsā ",
  "vv37:2.2": "pavisanti imaṃ vanaṃ, ",
  "vv37:2.3": "sayoggā sarathā sabbe ",
  "vv37:2.4": "citrā hontī idhāgatā. ",
  "vv37:3.1": "tuyhañca idha pattāya ",
  "vv37:3.2": "uyyāne vicarantiyā, ",
  "vv37:3.3": "kāye na dissati cittaṃ ",
  "vv37:3.4": "kenarūpaṃ tavedisaṃ ",
  "vv37:3.5": "devate pucchitācikkha ",
  "vv37:3.6": "kissa kammassidaṃ phalanti. ",
  "vv37:4.1": "yena kammena devinda ",
  "vv37:4.2": "rūpaṃ mayhaṃ gatī ca me, ",
  "vv37:4.3": "iddhi ca anubhāvo ca ",
  "vv37:4.4": "taṃ suṇohi purīndada. ",
  "vv37:5.1": "ahaṃ rājagahe ramme ",
  "vv37:5.2": "sunandānāmupāsikā, ",
  "vv37:5.3": "saddhā sīlena sampannā ",
  "vv37:5.4": "saṃvibhāgaratā sadā. ",
  "vv37:6.1": "acchādanañca bhattañca ",
  "vv37:6.2": "senāsanaṃ padīpiyaṃ, ",
  "vv37:6.3": "adāsiṃ ujubhūtesu ",
  "vv37:6.4": "vippasannena cetasā. ",
  "vv37:7.1": "cātuddasiṃ pañcadasiṃ ",
  "vv37:7.2": "yāca pakkhassa aṭṭhamī, ",
  "vv37:7.3": "pāṭihāriya pakkhañca ",
  "vv37:7.4": "aṭṭhaṅgasusamāgataṃ. ",
  "vv37:8.1": "uposathaṃ upavasissaṃ ",
  "vv37:8.2": "sadā sīlesu saṃvutā, ",
  "vv37:8.3": "saññamā saṃvibhāgā ca ",
  "vv37:8.4": "vimānaṃ āvasāmahaṃ ",
  "vv37:9.1": "pāṇātipātā viratā ",
  "vv37:9.2": "musāvādā ca saññatā, ",
  "vv37:9.3": "theyyā ca aticārā ca ",
  "vv37:9.4": "majjapānā ca ārakā. ",
  "vv37:10.1": "pañcasikkhāpade ratā ",
  "vv37:10.2": "ariyasaccāna kovidā, ",
  "vv37:10.3": "upāsikā cakkhumato ",
  "vv37:10.4": "gotamassa yasassino. ",
  "vv37:11.1": "tassā me ñātikulā dāsī ",
  "vv37:11.2": "sadā mālābhihāratī, ",
  "vv37:11.3": "tāhaṃ bhagavato thūpe ",
  "vv37:11.4": "sabbamevābhiropayiṃ. ",
  "vv37:12.1": "uposathe cahaṃ gantvā ",
  "vv37:12.2": "mālāgandhavilepanaṃ, ",
  "vv37:12.3": "thūpasmiṃ abhiropesiṃ ",
  "vv37:12.4": "pasannā sehi pāṇihi. ",
  "vv37:13.1": "tena kammena devinda ",
  "vv37:13.2": "rūpaṃ mayhaṃ gatī ca me, ",
  "vv37:13.3": "iddhi ca anubhāvo ca ",
  "vv37:13.4": "yaṃ mālaṃ abhiropayiṃ. ",
  "vv37:14.1": "yañca sīlavatī āsiṃ ",
  "vv37:14.2": "na taṃ tāva vipaccatī, ",
  "vv37:14.3": "āsā ca pana me devinda ",
  "vv37:14.4": "sakadāgāminī siyanti. ",
  "vv37:15.1": "visālakkhī vimānaṃ. "
}
