  "vv7:0.3": "",
  "vv7:0.4": "1. 7. paṭhamanāvāvimānaṃ. ",
  "vv7:1.1": "suvaṇṇacchadanaṃ nāvaṃ ",
  "vv7:1.2": "nārī āruyha tiṭṭhasi, ",
  "vv7:1.3": "ogāhasi pokkharaṇiṃ ",
  "vv7:1.4": "padumaṃ chindasi pāṇinā. ",
  "vv7:2.1": "kena te tādiso vaṇṇo ",
  "vv7:2.2": "kena te idhamijjhati, ",
  "vv7:2.3": "uppajjanti ca te bhogā ",
  "vv7:2.4": "ye keci manaso piyā. ",
  "vv7:3.1": "pucchāmi taṃ devi mahānubhāve ",
  "vv7:3.2": "manussabhūtā kimakāsi puññaṃ, ",
  "vv7:3.3": "kenāsi evaṃ jalitānubhāvā ",
  "vv7:3.4": "vaṇṇo ca te sabbadisā pabhāsatīti. ",
  "vv7:4.1": "sā devatā attamanā ",
  "vv7:4.2": "moggallānena pucchitā, ",
  "vv7:4.3": "pañhaṃ puṭṭhā viyākāsi ",
  "vv7:4.4": "yassa kammassidaṃ phalaṃ. ",
  "vv7:5.1": "ahaṃ manussesu manussabhūtā ",
  "vv7:5.2": "purimāya jātiyā manussaloke, ",
  "vv7:5.3": "disvāna bhikkhuṃ tasitaṃ kilantaṃ ",
  "vv7:5.4": "uṭṭhāya pātuṃ udakaṃ adāsiṃ. ",
  "vv7:6.1": "yo ce kilantassa pipāsitassa ",
  "vv7:6.2": "uṭṭhāya pātuṃ udakaṃ dadāti, ",
  "vv7:6.3": "sītodakā tassa bhavanti najjo ",
  "vv7:6.4": "pahūtamālyā bahupuṇḍarīkā. ",
  "vv7:7.1": "tamāpagā anupariyanti sabbadā ",
  "vv7:7.2": "sītodakā vālukasanthatā nadī, ",
  "vv7:7.3": "ambā ca sālā tilakā ca jambuyo ",
  "vv7:7.4": "uddālakā pāṭaliyo ca phullā. ",
  "vv7:8.1": "taṃ bhūmibhāgehi upetarūpaṃ ",
  "vv7:8.2": "vimānaseṭṭhaṃ bhusasobhamānaṃ, ",
  "vv7:8.3": "tassīdha kammassa ayaṃ vipāko ",
  "vv7:8.4": "etādisaṃ katapuññā labhanti. ",
  "vv7:9.1": "tena me tādiso vaṇṇo ",
  "vv7:9.2": "tena me idhamijjhati, ",
  "vv7:9.3": "uppajjanti ca me bhogā ",
  "vv7:9.4": "ye keci manaso piyā. ",
  "vv7:10.1": "akkhāmi te bhikkhu mahānubhāva ",
  "vv7:10.2": "manussabhūtā yamakāsi puññaṃ, ",
  "vv7:10.3": "tenamhi evaṃ jalitānubhāvā ",
  "vv7:10.4": "vaṇṇo ca me sabbadisā pabhāsatīti. ",
  "vv7:11.1": ""
}
