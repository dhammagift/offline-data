  "vv17:0.4": "1. 17. sirimāvimānaṃ. ",
  "vv17:1.1": "idaṃ vimānaṃ ruciraṃ pabhassaraṃ ",
  "vv17:1.2": "veḷuriyatthamhaṃ satataṃ sunimmitaṃ ",
  "vv17:1.3": "sovaṇṇarukkhehi samantamotthataṃ ",
  "vv17:1.4": "ṭhānaṃ mamaṃ kammavipākasambhavaṃ. ",
  "vv17:2.1": "tatrūpapannā purimaccharā imā ",
  "vv17:2.2": "sataṃ sahassāni sakena kammunā ",
  "vv17:2.3": "tuvaṃsi ajjhupagatā yasassinī ",
  "vv17:2.4": "obhāsayaṃ tiṭṭhasi pubbadevatā. ",
  "vv17:3.1": "sasī adhiggayha yathā virocati ",
  "vv17:3.2": "nakkhattarājāriva tārakāgaṇaṃ ",
  "vv17:3.3": "tatheva tvaṃ accharāsaṅgamaṃ imaṃ ",
  "vv17:3.4": "daddallamānā yasasā virocasi. ",
  "vv17:4.1": "kuto nu āgamma anomadassane ",
  "vv17:4.2": "uppannā tvaṃ bhavanaṃ mamaṃ idaṃ ",
  "vv17:4.3": "brahmaṃva devā tidasā saindakā ",
  "vv17:4.4": "sabbe na tappāmase dassanena tanti. ",
  "vv17:5.1": "yametaṃ sakka anupucchase mamaṃ ",
  "vv17:5.2": "kuto cutā tvaṃ idha āgatāti ",
  "vv17:5.3": "bārāṇasī nāma puratthi kāsinaṃ ",
  "vv17:5.4": "tattha pure ahosiṃ kesakārikā. ",
  "vv17:6.1": "buddhe ca dhamme ca pasannamānasā ",
  "vv17:6.2": "saṅghe ca ekantagatā asaṃsayā ",
  "vv17:6.3": "akhaṇḍasikkhāpadā āgatapphalā ",
  "vv17:6.4": "sambodhidhamme niyatā anāmayāti. ",
  "vv17:7.1": "tanatyābhinandamase sāgatañca te ",
  "vv17:7.2": "dhammena ca tvaṃ yassā virocasi ",
  "vv17:7.3": "buddhe ca dhamme ca pasannamānase ",
  "vv17:7.4": "saṅghe ca ekantagate asaṃsaye ",
  "vv17:7.5": "akhaṇḍa sikkhāpade āgatapphale ",
  "vv17:7.6": "sambodhidhamme niyate anāmayeti. ",
  "vv17:8.1": "",
  "vv17:9.1": "kesakārīvimānaṃ. pīṭhavaggo paṭhamo. tassuddānaṃ: ",
  "vv17:10.1": "pañcapīṭhā tayo nāvā ",
  "vv17:10.2": "dīpatiladakkhiṇā duve ",
  "vv17:10.3": "pati dve suṇisā uttarā ",
  "vv17:10.4": "sirimā kesakārikā ",
  "vv17:10.5": "vaggo tena pavuccatīti. ",
  "vv17:11.1": ""
}
