  "vv56:0.3": "",
  "vv56:0.4": "5. 6. dvārapālakavimānaṃ. ",
  "vv56:1.1": "uccamidaṃ maṇithūṇaṃ vimānaṃ ",
  "vv56:1.2": "samantato dvādasa yojanāni ",
  "vv56:1.3": "kūṭāgārā sattasatā uḷārā ",
  "vv56:1.4": "veḷuriyatthambhā rucakatthatā subhā. ",
  "vv56:2.1": "tatthacchasi pivasi khādasi ca ",
  "vv56:2.2": "dibbā ca vīṇā pavadanti vagguṃ ",
  "vv56:2.3": "dibbā rasā kāmaguṇettha pañca ",
  "vv56:2.4": "nāriyo ca naccanti suvaṇṇachattā. ",
  "vv56:3.1": "kena te tādiso vaṇṇo ",
  "vv56:3.2": "kena te idhamijjhati, uppajjanti ca te bhogā ye keci manaso piyā. pucchāmi taṃ deva mahānubhāva manussabhūto kimakāsi puññaṃ kenāsi evaṃ jalitānubhāvo ",
  "vv56:3.3": "vaṇṇo ca te sabbadisā pabhāsatīti. ",
  "vv56:4.1": "so devaputto attamano ",
  "vv56:4.2": "moggallānena pucchito, ",
  "vv56:4.3": "pañhaṃ puṭṭho viyākāsi yassakammassidaṃ phalaṃ ",
  "vv56:5.1": "karaṇīyāni puññāni ",
  "vv56:5.2": "paṇḍitena vijānatā, ",
  "vv56:5.3": "sammaggatesu buddhesu ",
  "vv56:5.4": "yattha dinnaṃ mahapphalaṃ. ",
  "vv56:6.1": "atthāya vata me buddho ",
  "vv56:6.2": "araññā gāmamāgato, ",
  "vv56:6.3": "tattha cittaṃ pasādetvā ",
  "vv56:6.4": "tāvatisūpago ahaṃ ",
  "vv56:7.1": "tena me tādiso vaṇṇo ",
  "vv56:7.2": "tena me idhamijjhati, uppajjanti ca me bhogā ye keci manaso piyā. akkhāmi te bhikkhu mahānubhāva manussabhūto yamakāsi puññaṃ tenamhi evaṃ jalitānubhāvo ",
  "vv56:7.3": "vaṇṇo ca me sabbadisā pabhāsatīti. ",
  "vv56:8.1": ""
}
