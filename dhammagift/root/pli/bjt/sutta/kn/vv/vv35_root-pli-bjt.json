  "vv35:0.1": "",
  "vv35:0.2": "",
  "vv35:0.3": "",
  "vv35:0.4": "3. 7. daddalla vimānaṃ. ",
  "vv35:1.1": "phalikarajatahemajālacchannaṃ ",
  "vv35:1.2": "vividhavicitratalamaddasaṃ surammaṃ ",
  "vv35:1.3": "vyamhaṃ sunimmitaṃ toraṇūpapannaṃ ",
  "vv35:1.4": "rucakupakiṇṇamidaṃ subhaṃ vimānaṃ. ",
  "vv35:2.1": "bhāti ca dasadisā nabheva suriyo ",
  "vv35:2.2": "sarade tamonudo sahassaraṃsi ",
  "vv35:2.3": "tathā tapatimidaṃ tava vimānaṃ ",
  "vv35:2.4": "jalamiva dhūmasikho nise nabhagge. ",
  "vv35:3.1": "musatīva nayanaṃ sateratāva ",
  "vv35:3.2": "ākāse ṭhapitamidaṃ manuññaṃ ",
  "vv35:3.3": "vīṇāmurajasammatālaghuṭṭhaṃ ",
  "vv35:3.4": "iddhaṃ indapuraṃ tathā tavedaṃ. ",
  "vv35:4.1": "paduma kumuduppala ",
  "vv35:4.2": "kuvalayaṃ yūdhika bandhukanojakā ca santi ",
  "vv35:4.3": "sālakusumita pupphitā asokā ",
  "vv35:4.4": "vividha dumagga sugandha ",
  "vv35:5.1": "sevitamidaṃ. saḷala labuja bhujaka saññatā ",
  "vv35:5.2": "kusakasuphullita latāvalambinīhi ",
  "vv35:5.3": "maṇijāla sadisā yasassinī ",
  "vv35:5.4": "rammā pokkharaṇī upaṭṭhitā te. ",
  "vv35:6.1": "udakaruhā ca yetthi pupphajātā ",
  "vv35:6.2": "thalajā ye ca santi rukkhajātā ",
  "vv35:6.3": "mānusakāmānusakā ca dibbā ",
  "vv35:6.4": "sabbe tuyhaṃ nivesanamhi jātā. ",
  "vv35:7.1": "kissa saṃyamadamassayaṃ vipāko ",
  "vv35:7.2": "kenāsi kammaphalenidhūpapannā ",
  "vv35:7.3": "yathā ca te adhigatamidaṃ vimānaṃ ",
  "vv35:7.4": "tadanupadaṃ avacāsu’ḷārapakhumeti. ",
  "vv35:8.1": "yathā ca me adhigatamidaṃ vimānaṃ ",
  "vv35:8.2": "koñcamayūracakora saṅghacaritaṃ dibbapilavahaṃsarājaciṇṇaṃ ",
  "vv35:8.3": "dvijakāraṇḍava kokilābhinaditaṃ. ",
  "vv35:8.4": "nānā santānaka puppharukkhavividhā ",
  "vv35:9.1": "pāṭali jambu ",
  "vv35:9.2": "asoka rukkhavantaṃ ",
  "vv35:9.3": "yathā ca me adhigatamidaṃ vimānaṃ ",
  "vv35:9.4": "tante pavadissāmi suṇohi bhante. ",
  "vv35:10.1": "magadhavarapuratthimena ",
  "vv35:10.2": "nāḷakagāmo nāma atthi bhante ",
  "vv35:10.3": "tattha ahosiṃ pure suṇisā ",
  "vv35:10.4": "sesavatī tattha jāniṃsu mamaṃ. ",
  "vv35:11.1": "sāhaṃ apacitatthadhammakusalaṃ ",
  "vv35:11.2": "devamanussapūjitaṃ mahantaṃ ",
  "vv35:11.3": "upatissaṃ nibbutaṃ appameyyaṃ ",
  "vv35:11.4": "mudītamanā kusumehi abbhokiriṃ. ",
  "vv35:12.1": "paramagatigatañca pūjayitvā ",
  "vv35:12.2": "antimadehadharaṃ isiṃ uḷāraṃ, ",
  "vv35:12.3": "pahāya mānusakaṃ samusasyaṃ ",
  "vv35:12.4": "tidasagatā idhamāvasāmi ṭhānanti. ",
  "vv35:13.1": ""
}
