  "vv4:0.4": "1. 4. tatiyapīṭhavimānaṃ. ",
  "vv4:1.1": "pīṭhaṃ te veḷuriyamayaṃ uḷāraṃ ",
  "vv4:1.2": "manojavaṃ gacchati yena kāmaṃ, ",
  "vv4:1.3": "alaṅkate mālyadhare suvatthe ",
  "vv4:1.4": "obhāsasi vijjurivabbhakūṭaṃ. ",
  "vv4:2.1": "kena te tādiso vaṇṇo ",
  "vv4:2.2": "kena te idhamijjhati, ",
  "vv4:2.3": "uppajjanti ca te bhogā ",
  "vv4:2.4": "ye keci manaso piyā. ",
  "vv4:3.1": "pucchāmi taṃ devi mahānubhāve ",
  "vv4:3.2": "manussabhūtā kimakāsi puññaṃ, ",
  "vv4:3.3": "kenāsi evaṃ jalitānubhāvā ",
  "vv4:3.4": "vaṇṇo ca te sabbadisā pabhāsatīti. ",
  "vv4:4.1": "sā devatā attamanā ",
  "vv4:4.2": "moggallānena pucchitā, ",
  "vv4:4.3": "pañhaṃ puṭṭhā viyākāsi ",
  "vv4:4.4": "yassa kammassidaṃ phalaṃ. ",
  "vv4:5.1": "appassa kammassa phalaṃ mamedaṃ ",
  "vv4:5.2": "yenamhi evaṃ jalitānubhāvā ",
  "vv4:5.3": "ayaṃ manussesu manussabhūtā ",
  "vv4:5.4": "purimāya jātiyā manussaloke. ",
  "vv4:6.1": "addasaṃ virajaṃ bhikkhuṃ ",
  "vv4:6.2": "vippasannamanāvilaṃ, ",
  "vv4:6.3": "tassa adāsahaṃ pīṭhaṃ ",
  "vv4:6.4": "pasannā sehi pāṇihi. ",
  "vv4:7.1": "tena me tādiso vaṇṇo ",
  "vv4:7.2": "tena me idhamijjhati, ",
  "vv4:7.3": "uppajjanti ca me bhogā ",
  "vv4:7.4": "ye keci manaso piyā. ",
  "vv4:8.1": "akkhāmi te bhikkhu mahānubhāva ",
  "vv4:8.2": "manussabhūtā yamakāsi puññaṃ, ",
  "vv4:8.3": "tenamhi evaṃ jalitānubhāvā ",
  "vv4:8.4": "vaṇṇo ca me sabbadisā pabhāsatīti. ",
  "vv4:9.1": ""
}
