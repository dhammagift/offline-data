  "vv49:0.3": "",
  "vv49:0.4": "4. 11. ucchu vimānaṃ. ",
  "vv49:1.1": "abhikkantena vaṇṇena ",
  "vv49:1.2": "yā tvaṃ tiṭṭhasi devate, ",
  "vv49:1.3": "obhāsentī disā sabbā ",
  "vv49:1.4": "osadhī viya tārakā. ",
  "vv49:2.1": "kena te tādiso vaṇṇo ",
  "vv49:2.2": "kena te idhamijjhati, uppajjanti ca te bhogā ye keci manaso piyā. pucchāmi taṃ devi mahānubhāve, manussabhūtā kimakāsi puññaṃ kenāsi evaṃ jalitānubhāvā ",
  "vv49:2.3": "vaṇṇo ca te sabbadisā pabhāsatī’ti. ",
  "vv49:3.1": "sā devatā attamanā ",
  "vv49:3.2": "moggallānena pucchitā, pañhaṃ puṭṭhā viyākāsi ",
  "vv49:3.3": "yassa kammassidaṃ phalaṃ. ",
  "vv49:4.1": "ahaṃ manussesu manussabhūtā ",
  "vv49:4.2": "disvāna samaṇe sīlavante ",
  "vv49:4.3": "pādāni vanditva manaṃ pāsādayiṃ ",
  "vv49:4.4": "cittāmahaṃ añjalikaṃ akāsiṃ. ",
  "vv49:5.1": "tena me tādiso vaṇṇo ",
  "vv49:5.2": "tena me idhamijjhati, uppajjanti ca me bhogā ye keci manaso piyā. akkhāmi te bhikkhu mahānubhāva manussabhūtā yamahaṃ akāsiṃ tenamhi evaṃ jalitānubhāvā ",
  "vv49:5.3": "vaṇṇo ca me sabbadisā pabhāsatī’ti. ",
  "vv49:6.1": ""
}
