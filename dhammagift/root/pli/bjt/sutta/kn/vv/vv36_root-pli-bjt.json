  "vv36:0.3": "",
  "vv36:0.4": "3. 8. sesavatī vimānaṃ. ",
  "vv36:1.1": "pītavatthe pītadhaje ",
  "vv36:1.2": "pītālaṅkārabhūsite, ",
  "vv36:1.3": "pītantarāhi vagguhi ",
  "vv36:1.4": "apiḷandhāva sobhasi. ",
  "vv36:2.1": "kā kambukeyūradhare ",
  "vv36:2.2": "kañcanāveḷabhūsite, ",
  "vv36:2.3": "hemajālaka pacchanne ",
  "vv36:2.4": "nānāratanamālini. ",
  "vv36:3.1": "sovaṇṇamayā lohitaṅkamayā ca ",
  "vv36:3.2": "muttāmayā veḷuriyamayā ca ",
  "vv36:3.3": "masāragallā saha lohitaṅkā ",
  "vv36:3.4": "pārāvatakkhīhi maṇīhi cittitā. ",
  "vv36:4.1": "koci koci ettha mayūrasussaro ",
  "vv36:4.2": "haṃsassarañño karavīkasussaro ",
  "vv36:4.3": "tesaṃ saro sūyati vaggurūpo ",
  "vv36:4.4": "pañcaṅgikaṃ turiyamivappavāditaṃ. ",
  "vv36:5.1": "ratho ca te subho vaggu ",
  "vv36:5.2": "nānāratanacittito ",
  "vv36:5.3": "nānāvaṇṇābhi dhātūhi ",
  "vv36:5.4": "sucibhatto ca sobhati. ",
  "vv36:6.1": "tasmiṃ rathe kañcanabimbavaṇṇe ",
  "vv36:6.2": "yā tvaṃ ṭhitā bhāsasimaṃ padesaṃ ",
  "vv36:6.3": "devate pucchitācikkha ",
  "vv36:6.4": "kissa kammassidaṃ phalanti. ",
  "vv36:7.1": "sovaṇṇajālaṃ maṇisoṇṇacittitaṃ ",
  "vv36:7.2": "muttācitaṃ hemajālena channaṃ ",
  "vv36:7.3": "parinibbute gotame appameyye ",
  "vv36:7.4": "pasannacittā ahamābhiropayiṃ. ",
  "vv36:8.1": "tāhaṃ kammaṃ karitvāna ",
  "vv36:8.2": "kusalaṃ buddhavaṇṇitaṃ, ",
  "vv36:8.3": "apetasokā sukhitā ",
  "vv36:8.4": "sampamodāmanāmayā’ti. ",
  "vv36:9.1": ""
}
