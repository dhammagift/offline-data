  "vv74:0.1": "",
  "vv74:0.2": "",
  "vv74:0.3": "",
  "vv74:0.4": "6. 10. dutiyakuṇḍalīvimānaṃ. ",
  "vv74:1.1": "yā devarājassa sabhā sudhammā ",
  "vv74:1.2": "yatthacchati devasaṅgho samaggo ",
  "vv74:1.3": "tathūpamaṃ tuyhamidaṃ vimānaṃ ",
  "vv74:1.4": "obhāsayaṃ tiṭṭhati antaḷikkhe ",
  "vv74:2.1": "deviddhipattosi mahānubhāvo ",
  "vv74:2.2": "manussabhūto kimakāsi puññaṃ ",
  "vv74:2.3": "kenāsi evaṃ jalitānubhāvo ",
  "vv74:2.4": "vaṇṇo ca te sabbadisā pabhāsatīti ",
  "vv74:3.1": "so devaputto attamano ",
  "vv74:3.2": "moggallānena pucchito, pañhaṃ puṭṭho viyākāsi ",
  "vv74:3.3": "yassa kammassidaṃ phalanti ",
  "vv74:4.1": "ahaṃ manussesu manussabhūto ",
  "vv74:4.2": "rañño pāyāsissa ahosiṃ māṇavo ",
  "vv74:4.3": "laddhā dhanaṃ saṃvibhāgaṃ akāsiṃ ",
  "vv74:4.4": "piyā ca me sīlavanto ahesuṃ ",
  "vv74:4.5": "annañca pānañca pasannacitto ",
  "vv74:4.6": "sakkacca dānaṃ vipulaṃ adāsiṃ ",
  "vv74:5.1": "tena me tādiso vaṇṇo ",
  "vv74:5.2": "tena me idhamijjhati, uppajjanti ca me bhogā ye keci manaso piyā akkhāmi te bhikkhu mahānubhāva manussabhūto yamakāsi puññaṃ tenamhi evaṃ jalitānubhāvo ",
  "vv74:5.3": "vaṇṇo ca me sabbadisā pabhāsatīti. ",
  "vv74:6.1": "",
  "vv74:7.1": "",
  "vv74:8.1": "uttaravimānaṃ. pāyāsi vaggo chaṭṭho. tassuddānaṃ: ",
  "vv74:9.1": "dve agārino phaladāyī ",
  "vv74:9.2": "dve upassayadāyī bhikkhāyadāyi ",
  "vv74:9.3": "yavapālako ceva dve ",
  "vv74:9.4": "kuṇḍalino pāyāsīti ",
  "vv74:10.1": "purisānaṃ dutiyo vaggo pavuccatīti. "
}
