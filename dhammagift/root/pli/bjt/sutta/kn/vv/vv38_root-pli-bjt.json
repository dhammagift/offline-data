  "vv38:0.1": "",
  "vv38:0.2": "",
  "vv38:0.3": "",
  "vv38:0.4": "3. 10. ",
  "vv38:1.1": "pāricchattake koviḷāre ",
  "vv38:1.2": "ramaṇīye manorame, ",
  "vv38:1.3": "dibbaṃ mālaṃ ganthamānā ",
  "vv38:1.4": "gāyantī sampamodasī. ",
  "vv38:2.1": "tassā te naccamānāya ",
  "vv38:2.2": "aṅgamaṅgehi sabbaso, ",
  "vv38:2.3": "dibbā saddā niccharanti ",
  "vv38:2.4": "savaṇīyā manoramā. ",
  "vv38:3.1": "tassā te naccamānāya ",
  "vv38:3.2": "aṅgamaṅgehi sabbaso, ",
  "vv38:3.3": "dibbā gandhā pavāyanti ",
  "vv38:3.4": "sucigandhā manoramā. ",
  "vv38:4.1": "vivattamānā kāyena ",
  "vv38:4.2": "yā veṇīsu piḷandhanā, ",
  "vv38:4.3": "tesaṃ sūyati nigghoso ",
  "vv38:4.4": "turiye pañcaṅgike yathā. ",
  "vv38:5.1": "vaṭaṃsakā vātadhūtā ",
  "vv38:5.2": "vātena sampakampitā, ",
  "vv38:5.3": "tesaṃ sūyati nigghoso ",
  "vv38:5.4": "turiye pañcaṅgike yathā. ",
  "vv38:6.1": "yāpi te sirasmiṃ mālā ",
  "vv38:6.2": "sucigandhā manoramā, ",
  "vv38:6.3": "vāti gandho disā sabbā ",
  "vv38:6.4": "rukkho mañjussako yathā. ",
  "vv38:7.1": "ghāyase taṃ suciṃ gandhaṃ ",
  "vv38:7.2": "rūpaṃ passasi amānusaṃ, ",
  "vv38:7.3": "devate pucchitācikkha ",
  "vv38:7.4": "kissa kammassidaṃ phalanti. ",
  "vv38:8.1": "pabhassaraṃ accimantaṃ ",
  "vv38:8.2": "vaṇṇagandhena saññutaṃ, ",
  "vv38:8.3": "asokapupphamālāhaṃ ",
  "vv38:8.4": "buddhassa upanāmayiṃ. ",
  "vv38:9.1": "tāhaṃ kammaṃ karitvāna ",
  "vv38:9.2": "kusalaṃ buddhavaṇṇitaṃ, ",
  "vv38:9.3": "apetasokā sukhitā ",
  "vv38:9.4": "sampamodāmanāmayāti. ",
  "vv38:10.1": "pāricchattaka vimānaṃ. pāricchattakavaggo tatiyo. ",
  "vv38:11.1": "tassuddānaṃ: ",
  "vv38:12.1": "uḷāraṃ ucchupallaṅkaṃ ",
  "vv38:12.2": "latā ca guttilena ca ",
  "vv38:12.3": "daddalla sesavatī mallī ",
  "vv38:12.4": "visālakkhi pāricchattako ",
  "vv38:12.5": "vaggo tena pavuccatīti. ",
  "vv38:13.1": ""
}
