  "vv11:0.1": "",
  "vv11:0.2": "",
  "vv11:0.3": "",
  "vv11:0.4": "1. 11. ",
  "vv11:1.1": "koñcā mayūrā diviyā ca haṃsā ",
  "vv11:1.2": "vaggussarā kokilā sampatanti, ",
  "vv11:1.3": "pupphābhikiṇṇaṃ rammamidaṃ vimānaṃ ",
  "vv11:1.4": "anekacittaṃ naranārisevitaṃ. ",
  "vv11:2.1": "tatthacchasi devi mahānubhāve ",
  "vv11:2.2": "iddhi vikubbantī anekarūpā, ",
  "vv11:2.3": "imā ca te accharāyo samantato ",
  "vv11:2.4": "naccanti gāyanti pamodayanti. ",
  "vv11:3.1": "deviddhipattāsi mahānubhāve ",
  "vv11:3.2": "manussabhūtā kimakāsi puññaṃ, ",
  "vv11:3.3": "kenāsi evaṃ jalitānubhāvā ",
  "vv11:3.4": "vaṇṇo ca te sabbadisā pabhāsatīti. ",
  "vv11:4.1": "sā devatā attamanā ",
  "vv11:4.2": "moggallānena pucchitā, ",
  "vv11:4.3": "pañhaṃ puṭṭhā viyākāsi ",
  "vv11:4.4": "yassa kammassidaṃ phalaṃ. ",
  "vv11:5.1": "ahaṃ manussesu manussabhūtā ",
  "vv11:5.2": "patibbatā nāññamanā ahosiṃ, ",
  "vv11:5.3": "mātāva puttaṃ anurakkhamānā ",
  "vv11:5.4": "kuddhāpahaṃ nappharusaṃ avocaṃ. ",
  "vv11:6.1": "sacce ṭhitā mosavajjaṃ pahāya ",
  "vv11:6.2": "dāne ratā saṅgahitattabhāvā, ",
  "vv11:6.3": "annaṃ ca pānaṃ ca pasannacittā ",
  "vv11:6.4": "sakkacca dānaṃ vipulaṃ adāsiṃ. ",
  "vv11:7.1": "tena me tādiso vaṇṇo ",
  "vv11:7.2": "tena me idhamijjhati, ",
  "vv11:7.3": "uppajjanti ca me bhogā ",
  "vv11:7.4": "ye keci manaso piyā. ",
  "vv11:8.1": "akkhāmi te bhikkhu mahānubhāva ",
  "vv11:8.2": "manussabhūtā yamakāsi puññaṃ ",
  "vv11:8.3": "tenamhi evaṃ jalitānubhāvā ",
  "vv11:8.4": "vaṇṇo ca me sabbadisā pabhāsatīti. ",
  "vv11:9.1": "patibbatāvimānaṃ. "
}
