{
  "vv57:0.1": "",
  "vv57:0.2": "",
  "vv57:0.3": "",
  "vv57:0.4": "5. 7. ",
  "vv57:1.1": "uccamidaṃ maṇithūṇaṃ vimānaṃ ",
  "vv57:1.2": "samantato dvādasa yojanāni ",
  "vv57:1.3": "kūṭāgārā sattasatā uḷārā ",
  "vv57:1.4": "veḷuriyatthambhā rucakatthatā subhā. ",
  "vv57:2.1": "tatthacchasi pivasi khādasi ca ",
  "vv57:2.2": "dibbā ca vīṇā pavadanti vagguṃ ",
  "vv57:2.3": "dibbā rasā kāmaguṇettha pañca ",
  "vv57:2.4": "nāriyo ca naccanti suvaṇṇachattā. ",
  "vv57:3.1": "kena te tādiso vaṇṇo ",
  "vv57:3.2": "kena te idhamijjhati, uppajjanti ca te bhogā ye keci manaso piyā. pucchāmi taṃ deva mahānubhāva manussabhūto kimakāsi puññaṃ kenāsi evaṃ jalitānubhāvo ",
  "vv57:3.3": "vaṇṇo ca te sabbadisā pabhāsatīti. ",
  "vv57:4.1": "so devaputto attamano ",
  "vv57:4.2": "moggallānena pucchito, pañhaṃ puṭṭho viyākāsi ",
  "vv57:4.3": "yassakammassidaṃ phalaṃ. ",
  "vv57:5.1": "karaṇīyāni puññāni ",
  "vv57:5.2": "paṇḍitena vijānatā, ",
  "vv57:5.3": "sammaggatesu bhikkhūsū ",
  "vv57:5.4": "yattha dinnaṃ mahapphalaṃ. ",
  "vv57:6.1": "atthāya vata me bhikkhu ",
  "vv57:6.2": "araññā gāmamāgato, ",
  "vv57:6.3": "tattha cittaṃ pasādetvā ",
  "vv57:6.4": "tāvatiṃsopago ahaṃ. ",
  "vv57:7.1": "tena me tādiso vaṇṇo ",
  "vv57:7.2": "tena me idhamijjhati, uppajjanti ca me bhogā ye keci manaso piyā. akkhāmi te bhikkhu mahānubhāva manussabhūto yamakāsi puññaṃ tenamhi evaṃ jalitānubhāvo ",
  "vv57:7.3": "vaṇṇo ca me sabbadisā pabhāsatīti. ",
  "vv57:8.1": "dutiyakaraṇīyavimānaṃ. "
}
