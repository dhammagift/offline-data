{
  "vv64:0.1": "",
  "vv64:0.2": "",
  "vv64:0.3": "",
  "vv64:0.4": "5. 14. cūḷarathavimānaṃ. ",
  "vv64:1.1": "sahassayuttaṃ hayavāhanaṃ subhaṃ ",
  "vv64:1.2": "āruyhi maṃ sandanaṃ nekacittaṃ ",
  "vv64:1.3": "uyyānabhūmiṃ abhito anukkamaṃ ",
  "vv64:1.4": "purindado bhūtapatīva vāsavo ",
  "vv64:2.1": "sovaṇṇamayā te rathakubbarā ubho ",
  "vv64:2.2": "thalehi aṃsehi atīva saṅgatā ",
  "vv64:2.3": "sujātagumbā naravīra niṭṭhitā ",
  "vv64:2.4": "virocati paṇṇaraseva cando. ",
  "vv64:3.1": "suvaṇṇajālāvatato ratho ayaṃ ",
  "vv64:3.2": "bahūhi nā nā ratanehi cittito ",
  "vv64:3.3": "sunandighoso ca subhassaro ca ",
  "vv64:3.4": "virocati cāmarahattha bāhuhi ",
  "vv64:4.1": "imā ca nābhyo manasābhinimmitā ",
  "vv64:4.2": "rathassa pādantara majjhabhūsitā ",
  "vv64:4.3": "imā ca nābhyo satarāji cittito ",
  "vv64:4.4": "sateratā vijjurivappabhāsare ",
  "vv64:5.1": "anekacittāvatato ratho ayaṃ ",
  "vv64:5.2": "puthū ca nemī ca sahassaraṃsiko ",
  "vv64:5.3": "tesaṃ saro sūyati vaggurūpo ",
  "vv64:5.4": "pañcaṅgikaṃ turiyamivappavāditaṃ ",
  "vv64:6.1": "sirasmiṃ cittaṃ maṇicandakappitaṃ ",
  "vv64:6.2": "sadā visuddhaṃ ruciraṃ pabhassaraṃ ",
  "vv64:6.3": "suvaṇṇarājīhi atīva saṅgataṃ ",
  "vv64:6.4": "veḷuriyarājīva atīva sobhati ",
  "vv64:7.1": "ime ca vāḷī maṇicandakappitā ",
  "vv64:7.2": "ārohakambū sujavā bahūpamā ",
  "vv64:7.3": "brahā mahantā balino mahājavā ",
  "vv64:7.4": "mano tavaññāya tatheva siṃsare ",
  "vv64:8.1": "ime ca sabbe sahitā catukkamā ",
  "vv64:8.2": "mano tavaññāya tatheva siṃsare ",
  "vv64:8.3": "samaṃ vahanti mudukā anuddhatā ",
  "vv64:8.4": "amodamānā turagānamuttamā ",
  "vv64:9.1": "dhunanti vagganti patanti cambare ",
  "vv64:9.2": "abbhuddhunantā sukate piḷandhane ",
  "vv64:9.3": "tesaṃ saro sūyati vaggurūpo ",
  "vv64:9.4": "pañcaṅgikaṃ turiyamivappavāditaṃ ",
  "vv64:10.1": "rathassa ghoso apiḷandhanāna ca ",
  "vv64:10.2": "khurassa nādo abhihiṃsanāya ca ",
  "vv64:10.3": "ghoso suvaggu samitassa sūyati ",
  "vv64:10.4": "gandhabbaturiyāni vicitrasaṃvane ",
  "vv64:11.1": "rathe ṭhitā tā migamandalocanā ",
  "vv64:11.2": "āḷārapamhā hasitā piyaṃvadā ",
  "vv64:11.3": "veḷuriyajālāvatatā tanucchavā ",
  "vv64:11.4": "sadeva gandhabba suraggapūjitā ",
  "vv64:12.1": "tā rattarattambara pītavāsasā ",
  "vv64:12.2": "visālanettā abhirattalocanā ",
  "vv64:12.3": "kule sujātā sutanu sucimhitā ",
  "vv64:12.4": "rathe ṭhitā pañjalikā upaṭṭhitā ",
  "vv64:13.1": "tā kambukeyūradharā suvāsasā ",
  "vv64:13.2": "sumajjhimā ūruthanūpapannā ",
  "vv64:13.3": "vaṭṭaṅguliyo sumukhā sudassanā ",
  "vv64:13.4": "rathe ṭhitā pañjalikā upaṭṭhitā ",
  "vv64:14.1": "aññā suveṇī susu missakesiyo ",
  "vv64:14.2": "samaṃ vibhattāhi pabhassarāhi ca ",
  "vv64:14.3": "anubbatā tā tava mānase ratā ",
  "vv64:14.4": "rathe ṭhitā pañjalikā upaṭṭhitā ",
  "vv64:15.1": "āveḷiniyo padumuppalacchadā ",
  "vv64:15.2": "alaṅkatā candanasāravāsitā ",
  "vv64:15.3": "anubbatā tā tava mānase ratā ",
  "vv64:15.4": "rathe ṭhitā pañjalikā upaṭṭhitā ",
  "vv64:16.1": "tā māliniyo padumuppalacchadā ",
  "vv64:16.2": "alaṅkatā candanasāravāsitā ",
  "vv64:16.3": "anubbatā tā tava mānase ratā ",
  "vv64:16.4": "rathe ṭhitā pañjalikā upaṭṭhitā ",
  "vv64:17.1": "kaṇṭhesu te yāni piḷandhanāni ",
  "vv64:17.2": "hatthesu pādesu tatheva sīse ",
  "vv64:17.3": "ohāsayantī dasa sabbaso disā ",
  "vv64:17.4": "abbhuddayaṃ sāradikova bhānumā ",
  "vv64:18.1": "vātassa vegena ca sampakampitā ",
  "vv64:18.2": "bhujesu mālā apiḷandhanāni ca ",
  "vv64:18.3": "muñcanti ghosaṃ ruciraṃ suciṃ subhaṃ ",
  "vv64:18.4": "sabbehi viññūhi sutabbarūpaṃ ",
  "vv64:19.1": "uyyānabhūmyā ca duvaddhato ṭhitā ",
  "vv64:19.2": "rathā ca nāgā turiyāni cassaro ",
  "vv64:19.3": "tameva devinda pamodayanti ",
  "vv64:19.4": "vīṇā yathā pokkharapattabāhuhi ",
  "vv64:20.1": "imāsu vīṇāsu bahūsu vaggusu ",
  "vv64:20.2": "manuññarūpāsu hadayeritaṃ pati ",
  "vv64:20.3": "pavajjamānāsu atīva accharā ",
  "vv64:20.4": "bhamanti kaññā padumesu sikkhitā ",
  "vv64:21.1": "yadā ca gītāni ca vāditāni ca ",
  "vv64:21.2": "naccāni cemāni samenti ekato ",
  "vv64:21.3": "athettha naccanti athettha accharā ",
  "vv64:21.4": "obhāsayantī ubhato varitthiyo ",
  "vv64:22.1": "so modasi turiyagaṇappabodhano ",
  "vv64:22.2": "mahīyamāno vajirāvudhoriva ",
  "vv64:22.3": "imāsu vīṇāsu bahusū vaggusu ",
  "vv64:22.4": "manuññarūpāsu hadayeritaṃ pati ",
  "vv64:23.1": "kiṃ tvaṃ pure kammamakāsi attanā ",
  "vv64:23.2": "manussabhūto purimāya jātiyā ",
  "vv64:23.3": "uposathaṃ kaṃvā tuvaṃ upāvasi ",
  "vv64:23.4": "kaṃ dhammacariyaṃ vatamābhirocayi ",
  "vv64:24.1": "nayidaṃ appassa katassa kammuno ",
  "vv64:24.2": "pubbe suciṇṇassa uposathassa vā ",
  "vv64:24.3": "iddhānubhāvo vipulo ayaṃ tava ",
  "vv64:24.4": "yaṃ devasaṅghaṃ abhirocase bhusaṃ ",
  "vv64:25.1": "dānassa te idaṃ phalaṃ ",
  "vv64:25.2": "atho sīlassa vā pana, ",
  "vv64:25.3": "atho añjalikammassa ",
  "vv64:25.4": "taṃ me akkhāhi pucchitoti ",
  "vv64:26.1": "so devaputto attamano ",
  "vv64:26.2": "moggallānena pucchito, ",
  "vv64:26.3": "pañhaṃ puṭṭho viyākāsi ",
  "vv64:26.4": "yassa kammassidaṃ phalaṃ ",
  "vv64:27.1": "jitindriyaṃ buddhamanomanikkamaṃ ",
  "vv64:27.2": "naruttamaṃ kassapamaggapuggalaṃ ",
  "vv64:27.3": "avāpuraṃ taṃ amatassa dvāraṃ ",
  "vv64:27.4": "devātidevaṃ satapuññalakkhaṇaṃ ",
  "vv64:28.1": "tamaddasaṃ kuñjaramoghatiṇṇaṃ ",
  "vv64:28.2": "suvaṇṇasiṅgīnadakhīmbasādisaṃ ",
  "vv64:28.3": "disvāna taṃ khippamahuṃ sucīmano ",
  "vv64:28.4": "tameva disvāna subhāsitaddhajaṃ ",
  "vv64:29.1": "tambhannapānaṃ athavāpi cīvaraṃ ",
  "vv64:29.2": "suciṃ paṇītaṃ rasasā upetaṃ ",
  "vv64:29.3": "pupphābhikiṇṇamhi sake nivesane ",
  "vv64:29.4": "patiṭṭhapesiṃ sa asaṅgamānaso ",
  "vv64:30.1": "tamannapānena ca cīvarena ca ",
  "vv64:30.2": "khajjena bhojjena ca sāyanena ca ",
  "vv64:30.3": "sattappayitvā dvipadānamuttamaṃ ",
  "vv64:30.4": "so saggaso devapure ramāmahaṃ ",
  "vv64:31.1": "etenupāyena imaṃ niraggaḷaṃ ",
  "vv64:31.2": "yaññaṃ yajitvā tividhaṃ visuddhaṃ ",
  "vv64:31.3": "pahāyahaṃ mānusakaṃ samussayaṃ ",
  "vv64:31.4": "indūpamo devapure ramāmahaṃ ",
  "vv64:32.1": "āyuñca vaṇṇañca sukhaṃ balañca ",
  "vv64:32.2": "paṇītarūpaṃ abhikaṅkhatā muni ",
  "vv64:32.3": "annañca pānañca bahuṃ susaṅkhataṃ ",
  "vv64:32.4": "patiṭṭhapetabbamasaṅgamānase ",
  "vv64:33.1": "nayimasmiṃ loke parasmiṃ vā pana ",
  "vv64:33.2": "buddhena seṭṭhova samova vijjati ",
  "vv64:33.3": "āhuneyyataṃ paramāhutiṃ gato ",
  "vv64:33.4": "puññatthikānaṃ vipulaphale ",
  "vv64:34.1": "ṭhitanti ",
  "vv64:34.2": "",
  "vv64:35.1": "mahārathavimānaṃ. mahārathavaggo pañcamo. tassuddānaṃ: ",
  "vv64:36.1": "maṇḍuko revatī chatto ",
  "vv64:36.2": "kakkaṭo dvārapālako ",
  "vv64:36.3": "dve karaṇīyā dve sūci ",
  "vv64:36.4": "tayo nāgā ca dve rathā ",
  "vv64:36.5": "purisānaṃ paṭhamo vaggo pavuccatī ti. ",
  "vv64:37.1": "bhāṇavāro tatiyo. "
}
