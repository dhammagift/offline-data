  "vv42:0.3": "",
  "vv42:0.4": "4. 4. nāga vimānaṃ. ",
  "vv42:1.1": "abhikkantena vaṇṇena ",
  "vv42:1.2": "yā tvaṃ tiṭṭhasi devate, ",
  "vv42:1.3": "obhāsentī disā sabbā ",
  "vv42:1.4": "osadhī viya tārakā ",
  "vv42:2.1": "kena te tādiso vaṇṇo ",
  "vv42:2.2": "kena te idhamijjhati, uppajjanti ca te bhogā ye keci manaso piyā pucchāmi taṃ devi mahānubhāve manussabhūtā kimakāsi puññaṃ kenāsi evaṃ jalitānubhāvā ",
  "vv42:2.3": "vaṇṇo ca te sabbadisā pabhāsatī’ti ",
  "vv42:3.1": "sā devatā attamanā ",
  "vv42:3.2": "moggallānena pucchitā, pañhaṃ puṭṭhā viyākāsi ",
  "vv42:3.3": "yassa kammassidaṃ phala’nti ahaṃ ",
  "vv42:4.1": "ca bārāṇasiyaṃ ",
  "vv42:4.2": "buddhassādiccabandhuno, ",
  "vv42:4.3": "adāsiṃ sukkhakummāsaṃ ",
  "vv42:4.4": "pasannā sehi pāṇihi ",
  "vv42:5.1": "sukkhāya aloṇikāya ca ",
  "vv42:5.2": "passa phalaṃ kumāmāsapiṇḍiyā, ",
  "vv42:5.3": "alomaṃ sukhitaṃ disvā ",
  "vv42:5.4": "ko puññaṃ na karissati ",
  "vv42:6.1": "tena me tādiso vaṇṇo ",
  "vv42:6.2": "tena me idhamijjhati, uppajjanti ca me bhogā ye keci manaso piyā. akkhāmi te bhikkhu mahānubhāve manussabhūtā yamahaṃ akāsiṃ tenamhi evaṃ jalitānubhāvā ",
  "vv42:6.3": "vaṇṇo ca me sabbadisā pabhāsatī’ti. ",
  "vv42:7.1": ""
}
