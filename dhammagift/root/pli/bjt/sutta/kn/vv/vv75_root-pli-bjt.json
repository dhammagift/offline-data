{
  "vv75:0.1": "",
  "vv75:0.2": "",
  "vv75:0.3": "7. sunikkhittavaggo ",
  "vv75:0.4": "7. 1. ",
  "vv75:1.1": "yathā vanaṃ cittalataṃ pabhāsati ",
  "vv75:1.2": "uyyānaseṭṭhaṃ tidasānamuttamaṃ ",
  "vv75:1.3": "tathūpamaṃ tuyhamidaṃ vimānaṃ ",
  "vv75:1.4": "obhāsayaṃ tiṭṭhati antaḷikkhe ",
  "vv75:2.1": "deviddhipattosi mahānubhāvo ",
  "vv75:2.2": "manussabhūto kimakāsi puññaṃ ",
  "vv75:2.3": "kenāsi evaṃ jalitānubhāvo ",
  "vv75:2.4": "vaṇṇo ca te sabbadisā pabhāsatīti ",
  "vv75:3.1": "so devaputto attamano ",
  "vv75:3.2": "moggallānena pucchito, pañhaṃ puṭṭho viyākāsi ",
  "vv75:3.3": "yassa kammassidaṃ phalanti ",
  "vv75:4.1": "ahaṃ manussesu manussabhūto ",
  "vv75:4.2": "daḷiddo atāṇo kapaṇo kammakaro ahosiṃ ",
  "vv75:4.3": "jiṇṇo ca mātāpitaro abhariṃ ",
  "vv75:4.4": "piyā ca me sīlavanto ahesuṃ ",
  "vv75:4.5": "annañca pānañca pasannacitto ",
  "vv75:4.6": "sakkacca dānaṃ vipulaṃ adāsiṃ ",
  "vv75:5.1": "tena me tādiso vaṇṇo ",
  "vv75:5.2": "tena me idhamijjhati, uppajjanti ca me bhogā ye keci manaso piyā. akkhāmi te bhikkhu mahānubhāva manussabhūto yamakāsi puññaṃ tenamhi evaṃ jalitānubhāvo ",
  "vv75:5.3": "vaṇṇo ca me sabbadisā pabhāsatīti. ",
  "vv75:6.1": "cittalatāvimānaṃ "
}
