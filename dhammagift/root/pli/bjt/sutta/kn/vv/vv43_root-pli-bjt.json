  "vv43:0.1": "",
  "vv43:0.2": "",
  "vv43:0.3": "",
  "vv43:0.4": "4. 5. alomā vimānaṃ. ",
  "vv43:1.1": "abhikkantena vaṇṇena ",
  "vv43:1.2": "yā tvaṃ tiṭṭhasi devate, obhāsenti disā sabbā ",
  "vv43:1.3": "osadhī viya tārakā ",
  "vv43:2.1": "kena te tādiso vaṇṇo ",
  "vv43:2.2": "kena te idhamijjhati, uppajjanti ca te bhogā ye keci manasopiyā pucchāmi taṃ devi mahānubhāve manussabhūtā kimakāsi puññaṃ kenāsi evaṃ jalitānubhāvā ",
  "vv43:2.3": "vaṇṇo ca te sabbadisā pabhāsatī’ti ",
  "vv43:3.1": "sā devatā attamanā ",
  "vv43:3.2": "moggallānena pucchitā, pañhaṃ puṭṭhā viyākāsi ",
  "vv43:3.3": "yassa kammassidaṃ phalaṃ ",
  "vv43:4.1": "ahaṃ andhakavindasmiṃ ",
  "vv43:4.2": "buddhassādiccabandhuno, ",
  "vv43:4.3": "adāsiṃ kolasampākaṃ ",
  "vv43:4.4": "kañjikaṃ teladhūpitaṃ ",
  "vv43:5.1": "pipphalyā lasunena ca ",
  "vv43:5.2": "missaṃ lāmañjakena ca, ",
  "vv43:5.3": "adāsiṃ ujubhūtasmiṃ ",
  "vv43:5.4": "vippasannena cetasā ",
  "vv43:6.1": "yā mahesittaṃ kāreyya ",
  "vv43:6.2": "cakkavattissa rājino ",
  "vv43:6.3": "nārī sabbaṅgakalyāṇī ",
  "vv43:6.4": "bhattucānomadassikā etassa ",
  "vv43:6.5": "kañjikadānassa ",
  "vv43:6.6": "kalaṃ nāgghati soḷasiṃ ",
  "vv43:7.1": "sataṃ nikkhā sataṃ assā ",
  "vv43:7.2": "sataṃ assatarī rathā ",
  "vv43:7.3": "sataṃ kaññāsahassāni ",
  "vv43:7.4": "āmuttamaṇikuṇḍalā ",
  "vv43:7.5": "etassa kañjikadānassa ",
  "vv43:7.6": "kalaṃ nāgghanti soḷasiṃ ",
  "vv43:8.1": "sataṃ hemavatā nāgā ",
  "vv43:8.2": "īsā dantā urūḷhavā ",
  "vv43:8.3": "suvaṇṇakacchā mātaṅgā ",
  "vv43:8.4": "hemakappana vāsasā ",
  "vv43:8.5": "etassa kañjikadānassa ",
  "vv43:8.6": "kalaṃ nāgghanti soḷasiṃ ",
  "vv43:9.1": "catunnampi dīpānaṃ ",
  "vv43:9.2": "issaraṃ yodha kāraye, ",
  "vv43:9.3": "etassa kañjikadānassa ",
  "vv43:9.4": "kalaṃ nāgghati soḷasi’nti. ",
  "vv43:10.1": ""
}
