  "vv10:0.1": "",
  "vv10:0.2": "",
  "vv10:0.3": "",
  "vv10:0.4": "1. 10. ",
  "vv10:1.1": "abhikkantena vaṇṇena ",
  "vv10:1.2": "yā tvaṃ tiṭṭhasi devate, ",
  "vv10:1.3": "obhāsentī disā sabbā ",
  "vv10:1.4": "osadhī viya tārakā. ",
  "vv10:2.1": "kena te tādiso vaṇṇo ",
  "vv10:2.2": "kena te idhamijjhati, ",
  "vv10:2.3": "uppajjanti ca te bhogā ",
  "vv10:2.4": "ye keci manaso piyā. ",
  "vv10:3.1": "pucchāmi taṃ devi mahānubhāve ",
  "vv10:3.2": "manussabhūtā kimakāsi puññaṃ, ",
  "vv10:3.3": "kenāsi evaṃ jalitānubhāvā ",
  "vv10:3.4": "vaṇṇo ca te sabbadisā pabhāsatīti. ",
  "vv10:4.1": "sā devatā attamanā ",
  "vv10:4.2": "moggallānena pucchitā. ",
  "vv10:4.3": "pañhaṃ puṭṭhā viyākāsi ",
  "vv10:4.4": "yassa kammassidaṃ phalaṃ. ",
  "vv10:5.1": "ahaṃ manussesu manussabhūtā ",
  "vv10:5.2": "purimāya jātiyā manussaloke. ",
  "vv10:6.1": "addasaṃ virajaṃ buddhaṃ ",
  "vv10:6.2": "vippasannamanāvilaṃ ",
  "vv10:6.3": "āsajja dānaṃ adāsiṃ ",
  "vv10:6.4": "akāmā tiladakkhiṇaṃ ",
  "vv10:6.5": "dakkhiṇeyyassa buddhassa ",
  "vv10:6.6": "pasannā sehi pāṇihi. ",
  "vv10:7.1": "tena me tādiso vaṇṇo ",
  "vv10:7.2": "tena me idhamijjhati, ",
  "vv10:7.3": "uppajjanti ca me bhogā ",
  "vv10:7.4": "ye keci manaso piyā. ",
  "vv10:8.1": "akkhāmi te bhikkhu mahānubhāva ",
  "vv10:8.2": "manussabhūtā yamakāsi puññaṃ, ",
  "vv10:8.3": "tenamhi evaṃ jalitānubhāvā ",
  "vv10:8.4": "vaṇṇo ca me sabbadisā pabhāsatīti. ",
  "vv10:9.1": "tiladakkhiṇāvimānaṃ. "
}
