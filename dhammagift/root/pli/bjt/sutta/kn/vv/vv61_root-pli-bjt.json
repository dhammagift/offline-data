{
  "vv61:0.1": "",
  "vv61:0.2": "",
  "vv61:0.3": "",
  "vv61:0.4": "5. 11. ",
  "vv61:1.1": "mahantaṃ nāgaṃ abhiruyha ",
  "vv61:1.2": "sabbasetaṃ gajuttamaṃ ",
  "vv61:1.3": "vanāvanaṃ anupariyāsi ",
  "vv61:1.4": "nārīgaṇapurakkhato ",
  "vv61:1.5": "obhāsento disā sabbā ",
  "vv61:1.6": "osadhī viya tārakā. ",
  "vv61:2.1": "kena te tādiso vaṇṇo ",
  "vv61:2.2": "kena te idhamijjhati, uppajjanti ca te bhogā ye keci manaso piyā. pucchāmi taṃ deva mahānubhāva manussabhūto kimakāsi puññaṃ kenāsi evaṃ jalitānubhāvo ",
  "vv61:2.3": "vaṇṇo ca te sabbadisā pabhāsatīti. ",
  "vv61:3.1": "so devaputto attamano ",
  "vv61:3.2": "vaṅgīseneva pucchito, ",
  "vv61:3.3": "pañhaṃ puṭṭho viyākāsi ",
  "vv61:3.4": "yassa kammassidaṃ phalaṃ. ",
  "vv61:4.1": "ahaṃ manussesu manussabhūto. ",
  "vv61:4.2": "upāsako cakkhumato ahosiṃ ",
  "vv61:4.3": "pāṇātipātā virato ahosiṃ ",
  "vv61:4.4": "loke adinnaṃ parivajjayissaṃ. ",
  "vv61:5.1": "amajjapo no ca musā abhāṇiṃ ",
  "vv61:5.2": "sakena dārena ca tuṭṭho ahosiṃ. ",
  "vv61:5.3": "annaṃ ca pānaṃ ca pasannacitto ",
  "vv61:5.4": "sakkacca dānaṃ vipulaṃ adāsiṃ. ",
  "vv61:6.1": "tena me tādiso vaṇṇo ",
  "vv61:6.2": "tena me idha mijjhati, uppajjanti ca me bhogā ye keci manaso piyā. akkhāmi te bhikkhu mahānubhāva manussabhūto yamakāsi puññaṃ tenamhi evaṃ jalitānubhāvo ",
  "vv61:6.3": "vaṇṇo ca me sabbadisā pabhāsatīti. ",
  "vv61:7.1": "dutiyanāgavimānaṃ. "
}
