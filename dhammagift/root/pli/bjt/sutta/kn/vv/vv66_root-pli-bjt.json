{
  "vv66:0.1": "",
  "vv66:0.2": "",
  "vv66:0.3": "",
  "vv66:0.4": "6. 2. ",
  "vv66:1.1": "yathā vanaṃ cittalataṃ pabhāsati ",
  "vv66:1.2": "uyyānaseṭṭhaṃ tidasānamuttamaṃ ",
  "vv66:1.3": "tathūpamaṃ tuyhamidaṃ vimānaṃ ",
  "vv66:1.4": "obhāsayaṃ tiṭṭhati antaḷikkhe ",
  "vv66:2.1": "deviddhipattosi mahānubhāvo ",
  "vv66:2.2": "manussabhūto kimakāsi puññaṃ ",
  "vv66:2.3": "kenāsi evaṃ jalitānubhāvo ",
  "vv66:2.4": "vaṇṇo ca te sabbadisā pabhāsati ",
  "vv66:3.1": "so devaputto attamano ",
  "vv66:3.2": "moggallānena pucchito, pañhaṃ puṭṭho viyākāsi ",
  "vv66:3.3": "yassa kammassidaṃ phalanti ",
  "vv66:4.1": "ahañca bhariyā ca manussaloke ",
  "vv66:4.2": "opānabhūtā gharamāvasimha ",
  "vv66:4.3": "annañca pānañca pasannacittā ",
  "vv66:4.4": "sakkacca dānaṃ vipulaṃ adamha ",
  "vv66:5.1": "tena me tādiso vaṇṇo ",
  "vv66:5.2": "tena me idhamijjhati, uppajjanti ca me bhogā ye keci manaso piyā akkhāmi te bhikkhu mahānubhāva manussabhūto yamakāsi puññaṃ tenamhi evaṃ jalitānubhāvo ",
  "vv66:5.3": "vaṇṇo ca me sabbadisā pabhāsatīti ",
  "vv66:6.1": "dutiyaagāriyavimānaṃ. "
}
