{
  "vv84:0.1": "",
  "vv84:0.2": "",
  "vv84:0.3": "",
  "vv84:0.4": "7. 10. ",
  "vv84:1.1": "suṇotha yakkhassa ca vāṇijāna ca ",
  "vv84:1.2": "samāgamo yattha tadā ahosi ",
  "vv84:1.3": "yathā kathaṃ itarītarena cāpi ",
  "vv84:1.4": "subhāsitaṃ tañca suṇātha sabbe. ",
  "vv84:2.1": "yo so ahū rājā pāyāsi nāmo ",
  "vv84:2.2": "bhummānaṃ sahavyagato yasassī ",
  "vv84:2.3": "so modamānova sake vimāne ",
  "vv84:2.4": "amānuso mānuse ajjhabhāsīti. ",
  "vv84:3.1": "vaṅke araññe amanussaṭṭhāne ",
  "vv84:3.2": "kantāre appodake appabhakkhe ",
  "vv84:3.3": "suduggame vaṇṇupathassa majjhe ",
  "vv84:3.4": "vaṅkaṃ bhayaṃ naṭṭhamanā manussā. ",
  "vv84:4.1": "nayidha phalā mūnamayā ca santi ",
  "vv84:4.2": "upādānaṃ natthi kuto idha bhakkho ",
  "vv84:4.3": "aññatra paṃsūhi ca vālukāhi ca ",
  "vv84:4.4": "tattāhi uṇhāhi ca dāruṇāhi ca. ",
  "vv84:5.1": "ujjaṅgalaṃ tattamivaṃ kapālaṃ ",
  "vv84:5.2": "anāyasaṃ paralokena tulyaṃ ",
  "vv84:5.3": "luddānamāvāsamidaṃ purāṇaṃ ",
  "vv84:5.4": "bhūmippadeso abhisattarūpo. ",
  "vv84:6.1": "atha tumhe kena vaṇṇena ",
  "vv84:6.2": "kimāsamānā imaṃ padesaṃ hi ",
  "vv84:6.3": "anuppaviṭṭhā sahasā samecca ",
  "vv84:6.4": "lobhā bhayā athavā sampamūḷhāti. ",
  "vv84:7.1": "magadhesu aṅgesu ca satthavāhā ",
  "vv84:7.2": "āropayitvā paṇiyaṃ puthuttaṃ ",
  "vv84:7.3": "te yāmase sindhusovīrabhūmiṃ ",
  "vv84:7.4": "dhanatthikā uddayaṃ patthayānā. ",
  "vv84:8.1": "divā pipāsaṃ nadhivāsayantā ",
  "vv84:8.2": "yoggānukampañca samekkhamānā ",
  "vv84:8.3": "etena vegena āyāma sabbe ",
  "vv84:8.4": "rattiṃ maggaṃ paṭipannā vikāle. ",
  "vv84:9.1": "te duppayātā aparaddhamaggā ",
  "vv84:9.2": "andhākulā vippanaṭṭhā araññe ",
  "vv84:9.3": "suduggame vaṇṇupathassa majjhe ",
  "vv84:9.4": "disaṃ na jānāma pamūḷahacittā. ",
  "vv84:10.1": "idañca disvāna adiṭṭhapubbaṃ ",
  "vv84:10.2": "vimānaseṭṭhañca tavañca yakkha ",
  "vv84:10.3": "tatuttariṃ jīvitamāsamānā ",
  "vv84:10.4": "disvā patītā sumanā udaggāti. ",
  "vv84:11.1": "pāraṃ samuddassa idañca vaṇṇuṃ ",
  "vv84:11.2": "vettācaraṃ saṅkupathañca maggaṃ ",
  "vv84:11.3": "nadiyo pana pabbatānañca duggā ",
  "vv84:11.4": "puthuddisā gacchatha bhogahetu. ",
  "vv84:12.1": "pakkhandiyāna vijitaṃ paresaṃ ",
  "vv84:12.2": "verajjake mānuse pekkhamānā ",
  "vv84:12.3": "yaṃ vo sutaṃ vā athavāpi diṭṭhaṃ ",
  "vv84:12.4": "accherakaṃ taṃ vo suṇoma tātāti. ",
  "vv84:13.1": "itopi accherataraṃ kumāra ",
  "vv84:13.2": "na no sutaṃ vā athavāpi diṭṭhaṃ ",
  "vv84:13.3": "atītamānussakameva sabbaṃ ",
  "vv84:13.4": "disvā na tappāma anomavaṇṇaṃ ",
  "vv84:14.1": "vehāsayaṃ pokkharañño bhavanti ",
  "vv84:14.2": "pahūtamālyā bahu puṇḍarīkā ",
  "vv84:14.3": "dumā cime niccaphalūpapannā ",
  "vv84:14.4": "atīva gandhā surabhiṃ pavāyanti. ",
  "vv84:15.1": "veḷuriyatthambhā satamussitāse ",
  "vv84:15.2": "silāpavāḷassa ca āyataṃsā ",
  "vv84:15.3": "masāragallā sahalohitaṅkā ",
  "vv84:15.4": "thamhā cime jotirasāmayāse. ",
  "vv84:16.1": "sahassatthambhaṃ atulānubhāvaṃ ",
  "vv84:16.2": "tesūpari sādhumidaṃ vimānaṃ ",
  "vv84:16.3": "ratanantaraṃ kañcanavedimissaṃ ",
  "vv84:16.4": "tapanīyapaṭṭehi ca sādhu channaṃ. ",
  "vv84:17.1": "jambonaduttattamidaṃ sumaṭṭho ",
  "vv84:17.2": "pāsādasopāna phalūpapanno ",
  "vv84:17.3": "daḷho ca vaggu sumukho susaṃgato ",
  "vv84:17.4": "atīva nijjhānakhamo manuñño. ",
  "vv84:18.1": "ratanantarasmiṃ bahu annapānaṃ ",
  "vv84:18.2": "parivārito accharāsaṃgaṇena murajja ",
  "vv84:18.3": "āḷambara turiyaghuṭṭho ",
  "vv84:18.4": "abhivanditosi thutivandanāya. ",
  "vv84:19.1": "so modasi nārigaṇappabodhato ",
  "vv84:19.2": "vimānapāsādavare manorame ",
  "vv84:19.3": "acintiyo sabbaguṇūpapanno ",
  "vv84:19.4": "rājā yathā vessavaṇo nalinyā ",
  "vv84:20.1": "devo nu āsi udavāsi yakkho ",
  "vv84:20.2": "udāhu devindo manussabhūto ",
  "vv84:20.3": "pucchanti taṃ vāṇijā satthavāhā ",
  "vv84:20.4": "ācikkha ko nāma tuvaṃsi yakkhāti. ",
  "vv84:21.1": "serissako nāma ahampi yakkho ",
  "vv84:21.2": "kantāriyo vaṇṇupathamhi gutto ",
  "vv84:21.3": "imaṃ padesaṃ abhipālayāmi ",
  "vv84:21.4": "vācaṅkaro vessavaṇassa raññoti. ",
  "vv84:22.1": "adhicca laddhaṃ pariṇāmajaṃ te ",
  "vv84:22.2": "sayaṃ kataṃ udāhu devehi dinnaṃ ",
  "vv84:22.3": "pucchanti taṃ vāṇijā satthavāhā ",
  "vv84:22.4": "kathaṃ tayā laddhamidaṃ manuññanti, ",
  "vv84:23.1": "nādhiccaladdhaṃ na pariṇāmajaṃ me ",
  "vv84:23.2": "na sayaṃ kataṃ na hi devehi dinnaṃ ",
  "vv84:23.3": "sakehi kammehi apāpakehi ",
  "vv84:23.4": "puññehi me laddhamidaṃ manuññanti. ",
  "vv84:24.1": "kiṃ te vataṃ kiṃ pana brahmacariyaṃ ",
  "vv84:24.2": "kissa suciṇṇassa ayaṃ vipāko ",
  "vv84:24.3": "pucchanti taṃ vāṇijā satthavāhā ",
  "vv84:24.4": "kathaṃ tayā laddhamidaṃ vimānanti. ",
  "vv84:25.1": "mama pāyāsīti ahū samaññā ",
  "vv84:25.2": "rajjaṃ yadā kārayiṃ kosalānaṃ ",
  "vv84:25.3": "natthikadiṭṭhi kadariyo pāpadhammo ",
  "vv84:25.4": "ucchedavādī ca tadā ahosiṃ. ",
  "vv84:26.1": "samaṇo ca kho āsi kumārakassapo ",
  "vv84:26.2": "bahussuto cittakathī uḷāro ",
  "vv84:26.3": "so me tadā dhammakathaṃ akāsi ",
  "vv84:26.4": "diṭṭhīvisūkāni vinodayī me. ",
  "vv84:27.1": "tāhaṃ tassa dhammakathaṃ suṇitvā ",
  "vv84:27.2": "upāsakattaṃ paṭivedayissaṃ ",
  "vv84:27.3": "pāṇātipātā virato ahosiṃ ",
  "vv84:27.4": "loke adinnaṃ parivajjayissuṃ. ",
  "vv84:27.5": "amajjapo no ca musā abhāṇiṃ ",
  "vv84:27.6": "sakena dārena ca ahosiṃ tuṭṭho. ",
  "vv84:28.1": "taṃ me vataṃ taṃ pana brahmacariyaṃ ",
  "vv84:28.2": "tassa suciṇṇassa ayaṃ vipāko ",
  "vv84:28.3": "teheva kammehi apāpakehi ",
  "vv84:28.4": "puññehi me laddhamidaṃ vimānanti. ",
  "vv84:29.1": "saccaṃ kirāhaṃsu narā sapaññā ",
  "vv84:29.2": "anaññathā vacanaṃ paṇḍitānaṃ ",
  "vv84:29.3": "yahiṃ yahiṃ gacchati puññakammo ",
  "vv84:29.4": "tahiṃ tahiṃ modati kāmakāmī. ",
  "vv84:30.1": "yahiṃ yahiṃ sokapariddavo ca ",
  "vv84:30.2": "vadho ca bandho ca parikkileso ",
  "vv84:30.3": "tahiṃ tahiṃ gacchati pāpakammo ",
  "vv84:30.4": "na muccati duggatiyā kadācīti. ",
  "vv84:31.1": "sammūḷharūpova jano ahosi ",
  "vv84:31.2": "asmiṃ muhutte kalalīkatova ",
  "vv84:31.3": "janassimassa tuyhañca kumāra ",
  "vv84:31.4": "appaccayo kena nu kho ahosīti. ",
  "vv84:32.1": "ime sirīsūpavanā ca tātā ",
  "vv84:32.2": "dibbā gandhā surabhiṃ sampavanti ",
  "vv84:32.3": "te sampavāyanti imaṃ vimānaṃ ",
  "vv84:32.4": "divā ca ratto ca tamaṃ nihantvā. ",
  "vv84:33.1": "imesaṃ ca kho vassasataccayena ",
  "vv84:33.2": "sipāṭikā phalati ekamekā ",
  "vv84:33.3": "mānussakaṃ vassasatā atītaṃ ",
  "vv84:33.4": "yadagge kāyamhi idhūpapanno. ",
  "vv84:34.1": "disvānahaṃ vassasatāni pañca ",
  "vv84:34.2": "asmiṃ vimāne ṭhatvāna tātā ",
  "vv84:34.3": "āyukkhayā puññakhayā cavissaṃ ",
  "vv84:34.4": "teneva sokena pamucchitosmīti. ",
  "vv84:35.1": "kathaṃ nu soceyya tathāvidho so ",
  "vv84:35.2": "laddhā vimānaṃ atulaṃ cirāya ",
  "vv84:35.3": "ye cāpi kho ittaramupapannā ",
  "vv84:35.4": "te nūna soveyyuṃ parittapuññāti. ",
  "vv84:36.1": "anucchaviṃ ovadiyañca metaṃ ",
  "vv84:36.2": "yaṃ maṃ tumhe peyyavācaṃ vadetha ",
  "vv84:36.3": "tumhe ca kho tātā mayānuguttā ",
  "vv84:36.4": "yenicchakaṃ tena paletha sotthinti. ",
  "vv84:37.1": "gantvā mayaṃ sindhu sovīrabhūmiṃ ",
  "vv84:37.2": "dhanatthikā uddayaṃ patthayānā ",
  "vv84:37.3": "yathā payogā paripuṇṇacāgā ",
  "vv84:37.4": "kāhāma serissamahaṃ uḷāranti. ",
  "vv84:38.1": "mā ceva serissamahaṃ akattha ",
  "vv84:38.2": "sabbañca vo bhavissati yaṃ vadetha ",
  "vv84:38.3": "pāpāni kammāni vivajjayātha ",
  "vv84:38.4": "dhammānuyogañca adhiṭṭhāhāthāti. ",
  "vv84:39.1": "upāsako atthi imamhi saṅghe ",
  "vv84:39.2": "bahussuto sīlavatūpapanno ",
  "vv84:39.3": "saddho ca cāgī ca supesalo ca ",
  "vv84:39.4": "vicakkhaṇo santusito mutīmā. ",
  "vv84:40.1": "sañjānamāno na musā bhaṇeyya ",
  "vv84:40.2": "parūpaghātāya na cetayeyya ",
  "vv84:40.3": "vebhūtikaṃ pesunaṃ no kareyya ",
  "vv84:40.4": "saṇhañca vācaṃ sakhilaṃ bhaṇeyya. ",
  "vv84:41.1": "sagāravo sappatisso vinīto ",
  "vv84:41.2": "apāpako adhisīle visuddho ",
  "vv84:41.3": "so mātaraṃ pitaraṃ cāpi jantu ",
  "vv84:41.4": "dhammena poseti ariyavutti. ",
  "vv84:42.1": "maññe so mātāpitunnaṃ kāraṇā ",
  "vv84:42.2": "bhogāni pariyesati na attahetu ",
  "vv84:42.3": "mātāpitunnañca yo accayena ",
  "vv84:42.4": "nekkhammapoṇo carissati brahmacariyaṃ. ",
  "vv84:43.1": "uju avaṅko asaṭho amāyo ",
  "vv84:43.2": "na lesakappena ca vohareyya ",
  "vv84:43.3": "so tādiso sukkatakammakārī ",
  "vv84:43.4": "dhamme ṭhito kinti labhetha dukkhaṃ. ",
  "vv84:44.1": "taṃ kāraṇā pātukatomhi attanā ",
  "vv84:44.2": "tasmā dhammaṃ passatha vāṇijāse ",
  "vv84:44.3": "aññatra tenīha bhasmi bhavetha ",
  "vv84:44.4": "andhākulā vippanaṭṭhā araññe ",
  "vv84:44.5": "taṃ khippamānena lahuṃ parena ",
  "vv84:44.6": "sukho bhave sappurisena saṅgamoti. ",
  "vv84:45.1": "kiṃ nāma so kiñci karoti kammaṃ ",
  "vv84:45.2": "kiṃ nāmadheyyaṃ kiṃ pana tassa gottaṃ ",
  "vv84:45.3": "mayampi naṃ daṭṭhukāmamha yakkha ",
  "vv84:45.4": "yassānukampāya idhāgatosi ",
  "vv84:45.5": "lābhā hi tassa yassa tuvaṃ pihesīti. ",
  "vv84:46.1": "yo kappako sambhava nāmadheyyo ",
  "vv84:46.2": "upāsako kocchaphalūpajīvī ",
  "vv84:46.3": "jānātha naṃ tumhākaṃ pesiyo so ",
  "vv84:46.4": "mā kho naṃ hīḷittha supesalo soti. ",
  "vv84:47.1": "jānamase yaṃ tvaṃ vadesi yakkha ",
  "vv84:47.2": "na kho naṃ jānāma sa īdisoti ",
  "vv84:47.3": "mayampi taṃ pūjayissāma yakkha ",
  "vv84:47.4": "sutvā tuyhaṃ vacanaṃ uḷāranti. ",
  "vv84:48.1": "ye kecimasmiṃ satthe manussā ",
  "vv84:48.2": "daharā mahantā athavāpi majjhimā ",
  "vv84:48.3": "sabbeva te ālambantu vimānaṃ ",
  "vv84:48.4": "passantu puññāna phalaṃ kadarīyāti. ",
  "vv84:49.1": "te tattha sabbeva ahaṃ pureti ",
  "vv84:49.2": "taṃ kappakaṃ tattha purakkhipitvā ",
  "vv84:49.3": "sabbeva te ālambiṃsu vimānaṃ ",
  "vv84:49.4": "masakkasāraṃ viya vāsavassa. ",
  "vv84:50.1": "te tattha sabbeva ahaṃ pureti ",
  "vv84:50.2": "upāsakattaṃ paṭivedayiṃsu ",
  "vv84:50.3": "pāṇātipātā viratā ahesuṃ ",
  "vv84:50.4": "loke adinnaṃ parivajjayiṃsu. ",
  "vv84:50.5": "amajjā no ca musā bhaṇiṃsu ",
  "vv84:50.6": "sakena dārena ca ahesuṃ tuṭṭhā ",
  "vv84:51.1": "te tattha sabbeva ahaṃ pureti ",
  "vv84:51.2": "upāsakattaṃ paṭivedayitvā ",
  "vv84:51.3": "pakkāmi sattho anumodamāno ",
  "vv84:51.4": "yakkhiddhiyā anumato punappunaṃ. ",
  "vv84:52.1": "gantvāna te sindhusovīrabhūmiṃ ",
  "vv84:52.2": "dhanatthikā uddayaṃ patthayānā ",
  "vv84:52.3": "yathā payogā paripuṇṇalābhā ",
  "vv84:52.4": "paccāgamuṃ pāṭaliputtamakkhataṃ. ",
  "vv84:53.1": "gantvāna te saṅgharaṃ sotthivanto ",
  "vv84:53.2": "puttehi dārehi samaṅgibhūtā ",
  "vv84:53.3": "ānandi cittā sumanā patītā ",
  "vv84:53.4": "akaṃsu serissamahaṃ uḷāraṃ. ",
  "vv84:53.5": "serīssakā te pariveṇaṃ māpayiṃsu ",
  "vv84:54.1": "etādisā sappurisāna sevanā ",
  "vv84:54.2": "mahatthikā dhammaguṇāna sevanā ",
  "vv84:54.3": "ekassa atthāya upāsakassa ",
  "vv84:54.4": "sabbeva sattā sukhitā ahesunti. ",
  "vv84:55.1": "serissakavimānaṃ. "
}
