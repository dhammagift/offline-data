  "vv68:0.3": "",
  "vv68:0.4": "6. 4. phaladāyakavimānaṃ ",
  "vv68:1.1": "cando yathā vigatavalāhake nabhe ",
  "vv68:1.2": "obhāsayaṃ gacchati antaḷikkhe ",
  "vv68:1.3": "tathūpamaṃ tuyhamidaṃ vimānaṃ ",
  "vv68:1.4": "obhāsayaṃ tiṭṭhati antaḷikkhe ",
  "vv68:2.1": "deviddhipattosi mahānubhāvo ",
  "vv68:2.2": "manussabhūto kimakāsi puññaṃ ",
  "vv68:2.3": "kenāsi evaṃ jalitānubhāvo ",
  "vv68:2.4": "vaṇṇo ca te sabbadisā pabhāsatīti ",
  "vv68:3.1": "so devaputto attamano ",
  "vv68:3.2": "moggallānena pucchito, pañhaṃ puṭṭho viyākāsi ",
  "vv68:3.3": "yassa kammassidaṃ phalanti ",
  "vv68:4.1": "ahañca bhariyā ca manussaloke ",
  "vv68:4.2": "upassayaṃ arahato adamha ",
  "vv68:4.3": "annañca pānañca pasannacittā ",
  "vv68:4.4": "sakkacca dānaṃ vipulaṃ adamha ",
  "vv68:5.1": "tena me tādiso vaṇṇo ",
  "vv68:5.2": "tena me idhamijjhati uppajjanti ca me bhogā ye keci manaso piyā akkhāmi te bhikkhu mahānubhāva manussabhūto yamakāsi puññaṃ tenamhi evaṃ jalitānubhāvo ",
  "vv68:5.3": "vaṇṇo ca me sabbadisā pabhāsatīti ",
  "vv68:6.1": ""
}
