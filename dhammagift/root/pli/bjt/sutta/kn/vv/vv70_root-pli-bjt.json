  "vv70:0.3": "",
  "vv70:0.4": "6. 6. dutiya upassayadāyakavimānaṃ. ",
  "vv70:1.1": "uccamidaṃ maṇithūṇaṃ vimānaṃ ",
  "vv70:1.2": "samantato dvādasa yojanāni ",
  "vv70:1.3": "kūṭāgārā sattasatā subhā ",
  "vv70:1.4": "veḷuriyatthambhā rucakatthatā subhā ",
  "vv70:2.1": "deviddhipattosi mahānubhāvo ",
  "vv70:2.2": "manussabhūto kimakāsi puññaṃ ",
  "vv70:2.3": "kenāsi evaṃ jalitānubhāvo ",
  "vv70:2.4": "vaṇṇo ca te sabbadisā pabhāsatīti ",
  "vv70:3.1": "so devaputto attamano ",
  "vv70:3.2": "moggallānena pucchito, pañhaṃ puṭṭho viyākāsi ",
  "vv70:3.3": "yassa kammassidaṃ phalanti ",
  "vv70:4.1": "ahaṃ manussesu manussabhūto ",
  "vv70:4.2": "disvāna bhikkhuṃ tasitaṃ kilantaṃ ",
  "vv70:4.3": "ekāhaṃ bhikkhuṃ paṭipādayissaṃ ",
  "vv70:4.4": "samaṅgibhattena tadā akāsiṃ ",
  "vv70:5.1": "tena me tādiso vaṇṇo ",
  "vv70:5.2": "tena me idhamijjhati uppajjanti ca me bhogā ye keci manaso piyā akkhāmi te bhikkhu mahānubhāva manussabhūto yamakāsi puññaṃ tenamhi evaṃ jalitānubhāvo ",
  "vv70:5.3": "vaṇṇo ca me sabbadisā pabhāsatīti ",
  "vv70:6.1": ""
}
