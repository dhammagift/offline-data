  "vv59:0.1": "",
  "vv59:0.2": "",
  "vv59:0.3": "",
  "vv59:0.4": "5. 9. ",
  "vv59:1.1": "uccamidaṃ maṇithūṇaṃ vimānaṃ ",
  "vv59:1.2": "samantato dvādasa yojanāni ",
  "vv59:1.3": "kūṭāgārā sattasatā uḷārā ",
  "vv59:1.4": "veḷuriyatthambhā rucakatthatā subhā. ",
  "vv59:2.1": "tatthacchasi pivasi khādasi ca ",
  "vv59:2.2": "dibbā ca vīṇā pavadanti vagguṃ ",
  "vv59:2.3": "dibbā rasā kāmaguṇettha pañca ",
  "vv59:2.4": "nāriyo ca naccanti suvaṇṇa channā. ",
  "vv59:3.1": "kena te tādiso vaṇṇo ",
  "vv59:3.2": "kena te idhamijjhati, uppajjanti ca te bhogā ye keci manaso piyā. pucchāmi taṃ deva mahānubhāva manussabhūto kimakāsi puññaṃ kenāsi evaṃ jalitānubhāvo ",
  "vv59:3.3": "vaṇṇo ca te sabbadisā pabhāsatīti. ",
  "vv59:4.1": "so devaputto attamano ",
  "vv59:4.2": "moggallānena pucchito, pañhaṃ puṭṭho viyākāsi ",
  "vv59:4.3": "yassa kammassidaṃ phalanti. ",
  "vv59:5.1": "ahaṃ manussesu manussabhūto. ",
  "vv59:5.2": "purimāya jātiyā manussaloke. ",
  "vv59:6.1": "addasaṃ virajaṃ bhikkhuṃ ",
  "vv59:6.2": "vippasannamanāvilaṃ, ",
  "vv59:6.3": "tassa adāsahaṃ sūciṃ ",
  "vv59:6.4": "pasanno sehi pāṇihi. ",
  "vv59:7.1": "tena me tādiso vaṇṇo ",
  "vv59:7.2": "tena me idhamijjhati, uppajjanti ca me bhogā ye keci manaso piyā. akkhāmi te bhikkhu mahānubhāva manussabhūto yamakāsi puññaṃ tenamhi evaṃ jalitānubhāvo ",
  "vv59:7.3": "vaṇṇo ca me sabbadisā pabhāsatīti. ",
  "vv59:8.1": "dutiyasūcivimānaṃ. "
}
