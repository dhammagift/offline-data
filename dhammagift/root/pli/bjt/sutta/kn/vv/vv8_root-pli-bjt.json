  "vv8:0.1": "",
  "vv8:0.2": "",
  "vv8:0.3": "",
  "vv8:0.4": "1. 8. dutiyanāvāvimānaṃ. ",
  "vv8:1.1": "suvaṇṇacchadanaṃ nāvaṃ ",
  "vv8:1.2": "nārī āruyha tiṭṭhasi, ",
  "vv8:1.3": "ogāhasi pokkharaṇiṃ ",
  "vv8:1.4": "padumaṃ chindasi pāṇinā. ",
  "vv8:2.1": "kūṭāgārā nivesā te ",
  "vv8:2.2": "vibhattā bhāgaso mitā, ",
  "vv8:2.3": "daddallamānā ābhanti ",
  "vv8:2.4": "samantā caturo disā. ",
  "vv8:3.1": "kena te tādiso vaṇṇo ",
  "vv8:3.2": "kena te idhamijjhati, ",
  "vv8:3.3": "uppajjanti ca te bhogā ",
  "vv8:3.4": "ye keci manaso piyā. ",
  "vv8:4.1": "pucchāmi taṃ devi mahānubhāve ",
  "vv8:4.2": "manussabhūtā kimakāsi puññaṃ, ",
  "vv8:4.3": "kenāsi evaṃ jalitānubhāvā ",
  "vv8:4.4": "vaṇṇo ca te sabbadisā pabhāsatīti. ",
  "vv8:5.1": "sā devatā attamanā ",
  "vv8:5.2": "sambuddheneva pucchitā ",
  "vv8:5.3": "pañhaṃ puṭṭhā viyākāsi ",
  "vv8:5.4": "yassa kammassidaṃ phalanti. ",
  "vv8:6.1": "ahaṃ manussesu manussabhūtā ",
  "vv8:6.2": "purimāya jātiyā manussaloke, ",
  "vv8:6.3": "disvāna bhikkhū tasite kilante ",
  "vv8:6.4": "uṭṭhāya pātuṃ udakaṃ adāsiṃ. ",
  "vv8:7.1": "yo ve kilantāna pipāsitānaṃ ",
  "vv8:7.2": "uṭṭhāya pātuṃ udakaṃ dadāti, ",
  "vv8:7.3": "sītodakā tassa bhavanti najjo ",
  "vv8:7.4": "pahūtamālyā bahu ",
  "vv8:8.1": "puṇḍarīkā. tamāpagā anupariyanti sabbadā ",
  "vv8:8.2": "sītodakā vālukasanthatā nadī, ",
  "vv8:8.3": "ambā ca sālā tilakā ca jambuyo ",
  "vv8:8.4": "uddālakā pāṭaliyo ca phullā. ",
  "vv8:9.1": "taṃ bhūmibhāgehi upetarūpaṃ ",
  "vv8:9.2": "vimānaseṭṭhaṃ bhusasobhamānaṃ, ",
  "vv8:9.3": "tassīdha kammassa ayaṃ vipāko ",
  "vv8:9.4": "etādisaṃ katapuññā labhanti. ",
  "vv8:10.1": "kūṭāgārā nivesā me ",
  "vv8:10.2": "vibhattā bhāgaso mitā, ",
  "vv8:10.3": "daddallamānā ābhanti ",
  "vv8:10.4": "samantā caturo disā. ",
  "vv8:11.1": "tena me tādiso vaṇṇo ",
  "vv8:11.2": "tena me idhamijjhati, ",
  "vv8:11.3": "uppajjanti ca me bhogā ",
  "vv8:11.4": "ye keci manaso piyā. ",
  "vv8:12.1": "",
  "vv8:12.2": "",
  "vv8:12.3": "tenamhi evaṃ jalitānubhāvā ",
  "vv8:12.4": "vaṇṇo ca me sabbadisā pabhāsati, ",
  "vv8:12.5": "etassa kammassa phalaṃ mamedaṃ ",
  "vv8:12.6": "atthāya buddho udakaṃ apāyīti. ",
  "vv8:13.1": ""
}
