  "ne26:0.4": "3. 2. 7. āvaṭṭo hārasampāto ",
  "ne26:1.1": "tattha katamo āvaṭṭo hārasampāto: ",
  "ne26:2.1": "“tasmā rakkhitacitta’ssa sammāsaṅkappagocaro”ti gāthā. ",
  "ne26:2.2": "“tasmā rakkhitacitta’ssa sammā saṅkappagocaro”ti ayaṃ samatho; ",
  "ne26:2.3": "sammādiṭṭhipurekkhāro”ti vipassanā; ",
  "ne26:2.4": "“ñatvāna udayabbaya”nti dukkhapariññā; ",
  "ne26:2.5": "thīnamuddhābhibhū bhikkhū”tī samudayapahānaṃ; ",
  "ne26:2.6": "“sabbāduggatiyo jahe”ti ayaṃ nirodho; ",
  "ne26:2.7": "imāni cattāri saccāni. ",
  "ne26:2.8": "niyutto āvaṭṭo hārasampāto. "
}
