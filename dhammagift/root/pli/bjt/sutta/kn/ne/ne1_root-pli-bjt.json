{
  "ne1:0.1": "nettippakaraṇaṃ namo tassa bhagavato arahato sammā sambuddhassa ",
  "ne1:0.2": "",
  "ne1:0.3": "saṃgahavāro ",
  "ne1:1.1": "yaṃ loko pūjayate - ",
  "ne1:1.2": "salokapālo sadā namassati ca, ",
  "ne1:1.3": "tassetaṃ sāsanavaraṃ - ",
  "ne1:1.4": "vidūhi ñeyyaṃ naracarassa. ",
  "ne1:2.1": "dvādasa padāni suttaṃ - ",
  "ne1:2.2": "taṃ sabbaṃ byañjanañca attho ca, ",
  "ne1:2.3": "taṃ viññeyyaṃ ubhayaṃ - ",
  "ne1:2.4": "ko attho byañjanaṃ katamaṃ. ",
  "ne1:3.1": "soḷasa hārā netti - ",
  "ne1:3.2": "pañca nayā sāsanassa pariyeṭṭhi, ",
  "ne1:3.3": "aṭṭhārasa mūlapadā - ",
  "ne1:3.4": "mahākaccānena niddiṭṭhā. ",
  "ne1:4.1": "hārā byañjanavicayo - ",
  "ne1:4.2": "suttassa nayā tayo ca suttattho, ",
  "ne1:4.3": "ubhayaṃ pariggahītaṃ - ",
  "ne1:4.4": "vuccati suttaṃ yathāsuttaṃ. ",
  "ne1:5.1": "yā ceva desanā yaṃ ca - ",
  "ne1:5.2": "desitaṃ ubhayameva viññeyyaṃ, ",
  "ne1:5.3": "tatrāyamānupubbī - ",
  "ne1:5.4": "navavīdha ",
  "ne1:5.5": "suttantapariyeṭṭhi’ti. "
}
