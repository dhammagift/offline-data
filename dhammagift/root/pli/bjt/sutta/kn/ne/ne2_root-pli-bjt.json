{
  "ne2:0.1": "vibhāgavāro ",
  "ne2:0.2": "1. uddesavāro ",
  "ne2:1.1": "tattha katame soḷasa hārā: ",
  "ne2:1.2": "desanā vicayo yutti padaṭṭhāno lakkhaṇo catubyūho āvatto vibhatti parivattano vevacano paññatti otaraṇo sodhano adhiṭṭhāno parikkhāro samāropano iti. ",
  "ne2:2.1": "tassānugīti: ",
  "ne2:3.1": "desanā vicayo yutti - ",
  "ne2:3.2": "padaṭṭhāno ca lakkhaṇo, ",
  "ne2:3.3": "catubyūho ca āvaṭṭo - ",
  "ne2:3.4": "vibhatti parivattano. ",
  "ne2:4.1": "vevacano ca paññatti - ",
  "ne2:4.2": "otaraṇo ca sodhano, ",
  "ne2:4.3": "adhiṭṭhāno parikkhāro - ",
  "ne2:4.4": "samāropano soḷasa. ",
  "ne2:5.1": "ete soḷasa hārā - ",
  "ne2:5.2": "pakittitā atthato asaṃkiṇṇā, etesaṃ ",
  "ne2:5.3": "ceva bhavati - ",
  "ne2:5.4": "vitthāratayā nayavibhatti’ti. ",
  "ne2:6.1": "tattha katame pañca nayā: ",
  "ne2:6.2": "nandiyāvaṭṭo tipukkhalo sīha vikkīḷito disālocano aṅkuso iti. ",
  "ne2:7.1": "tassānugīti: ",
  "ne2:8.1": "paṭhamo nandiyāvaṭṭo - ",
  "ne2:8.2": "dutiyo ca tipukkhalo, ",
  "ne2:8.3": "sīhavikkīḷito nāma - ",
  "ne2:8.4": "tatiyo nayalañchako ",
  "ne2:9.1": "disālocanamāhaṃsu - ",
  "ne2:9.2": "catutthaṃ nayamuttamaṃ, ",
  "ne2:9.3": "pañcamo aṅkuso nāma - ",
  "ne2:9.4": "sabbe pañca nayā gatā’ti ",
  "ne2:10.1": "tattha katamāni aṭṭhārasa mūlapadāni: ",
  "ne2:10.2": "nava padāni kusalāni, nava padāni akusalāni. ",
  "ne2:10.3": "tattha katamāni nava padāni akusalāni: taṇhā avijjā lobho doso moho subhasaññā sukhasaññā niccasaññā attasaññā’tī imāni nava padāni akusalāni, yattha sabbo akusalapakkho saṅgahaṃ samosaraṇaṃ gacchati. ",
  "ne2:11.1": "tattha katamāni nava padāni kusalāni: ",
  "ne2:11.2": "samatho vipassanā alobho adoso amoho asubhasaññā dukkhasaññā aniccasaññā anattasaññā’ti. imāni nava padāni kusalāni, yattha sabbo kusalapakkho saṅgahaṃ samosaraṇaṃ gacchati. ",
  "ne2:11.3": "tatridaṃ uddānaṃ: ",
  "ne2:12.1": "taṇhā ca avijjāpi ca - ",
  "ne2:12.2": "lobho doso tatheva moho ca, ",
  "ne2:12.3": "caturo ca vipallāsā - ",
  "ne2:12.4": "kilesabhumī nava padānī ",
  "ne2:13.1": "samatho ca vipassanā ca - ",
  "ne2:13.2": "kusalāni ca yāni tīṇi mūlāni, ",
  "ne2:13.3": "caturo satipaṭṭhānā - ",
  "ne2:13.4": "indriyabhūmi nava padāni. ",
  "ne2:14.1": "navahi ca padehi kusalā - ",
  "ne2:14.2": "navahi ca yujjanti akusalā pakkhā, ",
  "ne2:14.3": "ete kho mūlapadā - ",
  "ne2:14.4": "bhavanti aṭṭhārasa padānī’ti ",
  "ne2:14.5": ""
}
