{
  "cp27:0.1": "",
  "cp27:0.2": "",
  "cp27:0.3": "5. sacca pāramitā ",
  "cp27:0.4": "7. kapirāja cariyaṃ ",
  "cp27:1.1": "yadā ahaṃ kapi āsiṃ ",
  "cp27:1.2": "nadī kūle darīsaye ",
  "cp27:1.3": "pīḷito suṃsumārena ",
  "cp27:1.4": "gamanaṃ nalabhāmihaṃ ",
  "cp27:2.1": "yamhokāse ahaṃ ṭhatvā ",
  "cp27:2.2": "ora pāraṃ patāmahaṃ ",
  "cp27:2.3": "tatthacchi sattu vadhako ",
  "cp27:2.4": "kumhīlo ludda dassano. ",
  "cp27:3.1": "somaṃ asaṃsi ehīti ",
  "cp27:3.2": "ahamemīti taṃ vadiṃ ",
  "cp27:3.3": "tassa matthakamakkamma ",
  "cp27:3.4": "parakule patiṭṭhahiṃ. ",
  "cp27:4.1": "na tassa alikaṃ bhaṇitaṃ ",
  "cp27:4.2": "yathā vācaṃ akāsahaṃ ",
  "cp27:4.3": "saccena me samo natthi ",
  "cp27:4.4": "esā me sacca pāramīti. ",
  "cp27:4.5": "kapirāja cariyaṃ sattamaṃ. "
}
