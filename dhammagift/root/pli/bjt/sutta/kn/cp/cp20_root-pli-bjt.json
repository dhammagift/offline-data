  "cp20:0.4": "10. saṅkhapāla cariyaṃ ",
  "cp20:1.1": "punāparaṃ yadā homi ",
  "cp20:1.2": "saṅkhapālo mahiddhiko ",
  "cp20:1.3": "dāṭhāvudho ghoraviso ",
  "cp20:1.4": "dvijivho uragādhibhū. ",
  "cp20:2.1": "catuppathe mahāmagge ",
  "cp20:2.2": "nānā janasamākule ",
  "cp20:2.3": "caturo aṅge adhiṭṭhāya ",
  "cp20:2.4": "tattha vāsamakappayiṃ. ",
  "cp20:3.1": "chaviyā cammena maṃsena ",
  "cp20:3.2": "nahāru aṭṭhikehi vā ",
  "cp20:3.3": "yassa etena karaṇīyaṃ ",
  "cp20:3.4": "dinnaṃ yeva harātu so. ",
  "cp20:4.1": "addasaṃsu bhojaputtā ",
  "cp20:4.2": "kharā luddā akāruṇā ",
  "cp20:4.3": "upagañchuṃ mamaṃ tattha ",
  "cp20:4.4": "daṇḍamuggarapāṇino. ",
  "cp20:5.1": "nāsāya vinivijjhitvā ",
  "cp20:5.2": "naṅguṭṭhe piṭṭhikaṇṭake ",
  "cp20:5.3": "kāje āropayitvāna ",
  "cp20:5.4": "bhojaputtā hariṃsu maṃ. ",
  "cp20:6.1": "sapāgarantaṃ paṭhaviṃ ",
  "cp20:6.2": "sakānanaṃ sapabbataṃ ",
  "cp20:6.3": "icchamāno cahaṃ tattha ",
  "cp20:6.4": "nāsāvātena jhāpaye. ",
  "cp20:7.1": "sūlehi vijjhiyantepi ",
  "cp20:7.2": "koṭṭayantepi sattihi ",
  "cp20:7.3": "bhojapūtte na kuppāmi ",
  "cp20:7.4": "esā me sīlapāramīti. ",
  "cp20:8.1": "saṅkhapāla cariyaṃ dasamaṃ. ",
  "cp20:9.1": "hatthi ",
  "cp20:10.1": "nāgo ",
  "cp20:11.1": "bhūridatto ",
  "cp20:11.2": "campeyyo bodhi māhiso ",
  "cp20:11.3": "rurāmātaṅgo dhammo ca ",
  "cp20:11.4": "atrajo ca jayaddiso. ",
  "cp20:12.1": "ete sabbe sīlabalā ",
  "cp20:12.2": "parikkhārā padesikā ",
  "cp20:12.3": "jīvitaṃ parirakkhītvā ",
  "cp20:12.4": "sīlāni anurakkhissaṃ. ",
  "cp20:13.1": "saṅkhapālassa me sato ",
  "cp20:13.2": "sabbakālampi jīvitaṃ ",
  "cp20:13.3": "yassa kassaci nīyantaṃ ",
  "cp20:13.4": "tasmā sā sīlapāramīti. ",
  "cp20:14.1": "sīla pāramīniddeso niṭṭhito. "
}
