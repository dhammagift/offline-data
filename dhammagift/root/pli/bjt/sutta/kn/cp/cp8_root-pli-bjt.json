  "cp8:0.1": "",
  "cp8:0.2": "",
  "cp8:0.3": "",
  "cp8:0.4": "8. sivirāja cariyaṃ ",
  "cp8:1.1": "ariṭṭhasavhaye nagare ",
  "cp8:1.2": "sivi nāmāsiṃ khattiyo ",
  "cp8:1.3": "nisajja pāsādavare ",
  "cp8:1.4": "evaṃ cintesahaṃ tadā. ",
  "cp8:2.1": "yaṃ kiñci mānusaṃ dānaṃ ",
  "cp8:2.2": "adinnaṃ me na vijjati ",
  "cp8:2.3": "yopi vāceyya maṃ cakkhuṃ ",
  "cp8:2.4": "dadeyyaṃ avikampito. ",
  "cp8:3.1": "mama saṅkappamaññāya ",
  "cp8:3.2": "sakko devānamissaro ",
  "cp8:3.3": "nisinno devaparisāya ",
  "cp8:3.4": "idaṃ vacanamabruvi. ",
  "cp8:4.1": "nisajjapāsādavare ",
  "cp8:4.2": "sivirājā mahiddhiko ",
  "cp8:4.3": "cintento vividhaṃ dānaṃ ",
  "cp8:4.4": "adeyyaṃ so na passati, ",
  "cp8:5.1": "tathannu vitathantetaṃ ",
  "cp8:5.2": "handa vīmaṃsayāmi taṃ ",
  "cp8:5.3": "muhuttaṃ āgameyyātha ",
  "cp8:5.4": "yāva jānāmi taṃ manaṃ. ",
  "cp8:6.1": "pavedhamāno palitasiro ",
  "cp8:6.2": "valitagatto jarāturo ",
  "cp8:6.3": "andhavaṇṇova hutvāna ",
  "cp8:6.4": "rājānaṃ upasaṅkami. ",
  "cp8:7.1": "so tadā paggahetvāna ",
  "cp8:7.2": "vāmaṃ dakkhiṇabāhu ca ",
  "cp8:7.3": "sirasmiṃ añjaliṃ katvā ",
  "cp8:7.4": "idaṃ vacanamabruvi. ",
  "cp8:8.1": "yācāmi taṃ mahārāja ",
  "cp8:8.2": "dhammikaraṭṭhavaḍḍhana ",
  "cp8:8.3": "tava dānaratā kitti ",
  "cp8:8.4": "uggatā devamānuse. ",
  "cp8:9.1": "ubhopi nettā nayanā ",
  "cp8:9.2": "andhā upahatā mama ",
  "cp8:9.3": "ekaṃ me nayanaṃ dehi ",
  "cp8:9.4": "tvampi ekena yāpaya. ",
  "cp8:10.1": "tassāhaṃ vacanaṃ sutvā ",
  "cp8:10.2": "haṭṭho saṃviggamānaso ",
  "cp8:10.3": "katañjalī vedajāto ",
  "cp8:10.4": "idaṃ vacanamabrūviṃ. ",
  "cp8:11.1": "idānāhaṃ cintayitvā ",
  "cp8:11.2": "pāsādato idhāgato ",
  "cp8:11.3": "tvaṃ mama cittamaññāya ",
  "cp8:11.4": "nettaṃ yācitumāgato. ",
  "cp8:12.1": "aho me mānasaṃ siddhaṃ ",
  "cp8:12.2": "saṅkappo paripūrito ",
  "cp8:12.3": "adinnapubbaṃ dānavaraṃ ",
  "cp8:12.4": "ajja dassāmi yācake. ",
  "cp8:13.1": "ehi sīvaka uṭṭhehi ",
  "cp8:13.2": "mā dandhayi mā pavedhayi ",
  "cp8:13.3": "ubhopi nayane dehi ",
  "cp8:13.4": "uppāṭetvā vaṇibbake. ",
  "cp8:14.1": "tato so codito mayhaṃ ",
  "cp8:14.2": "sīvako vacanaṅkaro ",
  "cp8:14.3": "uddharitvāna pādāsi ",
  "cp8:14.4": "tālamiñjaṃva yācake. ",
  "cp8:15.1": "dadamānassa dentassa ",
  "cp8:15.2": "dinnadānassa me sato ",
  "cp8:15.3": "cittassa aññathā natthi ",
  "cp8:15.4": "bodhiyā yeva kāraṇā. ",
  "cp8:16.1": "na me dessā ubho cakkhu ",
  "cp8:16.2": "attā na me na dessiyo ",
  "cp8:16.3": "sabbaññutaṃ piyaṃ mayhaṃ ",
  "cp8:16.4": "tasmā cakkhuṃ adāsahanti. ",
  "cp8:17.1": "sivirājacariyaṃ aṭṭhamaṃ. "
}
