{
  "cp21:0.1": "",
  "cp21:0.2": "",
  "cp21:0.3": "3. nekkhamma pāramitā ",
  "cp21:0.4": "1. yudhañjaya cariyaṃ ",
  "cp21:1.1": "yadā ahaṃ amitayaso ",
  "cp21:1.2": "rājaputto yudhañjayo ",
  "cp21:1.3": "ussāvabinduṃ suriyātape ",
  "cp21:1.4": "patitaṃ disvāna saṃvijiṃ. ",
  "cp21:2.1": "taññevādhipatiṃ katvā ",
  "cp21:2.2": "saṃvegamanubrūhayiṃ ",
  "cp21:2.3": "mātāpitu ca vanditvā ",
  "cp21:2.4": "pabbajjamanuyācahaṃ. ",
  "cp21:3.1": "yācantimaṃ pañjalikā ",
  "cp21:3.2": "sanegamā saraṭṭhakā ",
  "cp21:3.3": "ajjeva putta paṭipajja ",
  "cp21:3.4": "iddhaṃ phītaṃ mahāmahiṃ. ",
  "cp21:4.1": "sarājake sahorodhe ",
  "cp21:4.2": "sanegame saraṭṭhake ",
  "cp21:4.3": "karuṇaṃ paridevante ",
  "cp21:4.4": "anepekkho hi pabbajiṃ. ",
  "cp21:5.1": "kevalaṃ paṭhaviṃ rajjaṃ ",
  "cp21:5.2": "ñāti parijana yasaṃ ",
  "cp21:5.3": "cajamāno na cintesiṃ ",
  "cp21:5.4": "bodhiyāyeva kāraṇā. ",
  "cp21:6.1": "mātā pitā na me dessā ",
  "cp21:6.2": "napi dessaṃ mahāyasaṃ ",
  "cp21:6.3": "sabbaññutaṃ piyaṃ mayhaṃ ",
  "cp21:6.4": "tasmā rajjaṃ pariccajinti. ",
  "cp21:7.1": "yudhañjaya cariyaṃ paṭhamaṃ. "
}
