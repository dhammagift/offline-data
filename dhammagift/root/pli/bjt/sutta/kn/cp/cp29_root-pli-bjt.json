  "cp29:0.3": "",
  "cp29:0.4": "9. vaṭṭapotaka cariyaṃ. ",
  "cp29:1.1": "punāparaṃ yadā homi ",
  "cp29:1.2": "magadhe vaṭṭa potako ",
  "cp29:1.3": "ajātapakkho taruṇo ",
  "cp29:1.4": "maṃsapesī kulāvake. ",
  "cp29:2.1": "mukhatuṇḍake nāharitvā ",
  "cp29:2.2": "mātā posayatī mamaṃ ",
  "cp29:2.3": "tassā phassena jīvāmi ",
  "cp29:2.4": "natthi me kāyikaṃ balaṃ. ",
  "cp29:3.1": "saṃvacchare gimhasamaye ",
  "cp29:3.2": "davaḍāho padippati ",
  "cp29:3.3": "upagacchati amhākaṃ ",
  "cp29:3.4": "pāvako kaṇhavattanī. ",
  "cp29:4.1": "dhūmaṃ dhūmaṃ janitvevaṃ ",
  "cp29:4.2": "saddāyanto mahāsikhī ",
  "cp29:4.3": "anupubbena jhāpento ",
  "cp29:4.4": "aggī mama mupāgami. ",
  "cp29:5.1": "aggivegabhayā bhītā ",
  "cp29:5.2": "tasitā mātā pitā mama ",
  "cp29:5.3": "kulāvake maṃ chaḍḍetvā ",
  "cp29:5.4": "attānaṃ parimocayuṃ. ",
  "cp29:6.1": "pāde pakkhe pajahāmi ",
  "cp29:6.2": "natthi me kāyikaṃ balaṃ ",
  "cp29:6.3": "so, haṃ agatiko tattha ",
  "cp29:6.4": "evaṃ cintesahaṃ tadā. ",
  "cp29:7.1": "yesāhaṃ upadhāveyyaṃ ",
  "cp29:7.2": "bhīto tasitavedhito ",
  "cp29:7.3": "temaṃ ohāya pakkhantā ",
  "cp29:7.4": "kathaṃ me ajja kātave. ",
  "cp29:8.1": "atthi loke sīlaguṇo ",
  "cp29:8.2": "saccaṃ soceyya nuddayā ",
  "cp29:8.3": "tena saccena kāhāmi ",
  "cp29:8.4": "saccakiriyamuttamaṃ. ",
  "cp29:9.1": "āvajjetvā dhamma balaṃ ",
  "cp29:9.2": "saritvā pubbako jine ",
  "cp29:9.3": "saccabalamavassāya ",
  "cp29:9.4": "sacca kiriyamakāsahaṃ. ",
  "cp29:10.1": "santi pakkhā apatanā ",
  "cp29:10.2": "santi pādā avañcanā ",
  "cp29:10.3": "mātā pitā ca nikkhantā ",
  "cp29:10.4": "jātaveda paṭikkama. ",
  "cp29:11.1": "saha sacce kataṃ mayhaṃ ",
  "cp29:11.2": "mahā pajjalito sikhī ",
  "cp29:11.3": "vajjesi soḷasa ",
  "cp29:11.4": "karīsāni udakampatvā yathā sikhī ",
  "cp29:11.5": "saccena me samo natthi ",
  "cp29:11.6": "esā me saccapāramīti. ",
  "cp29:12.1": "vaṭṭapotaka cariyaṃ navamaṃ. "
}
