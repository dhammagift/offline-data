{
  "cp33:0.1": "",
  "cp33:0.2": "",
  "cp33:0.3": "6. mettā pāramitā ",
  "cp33:0.4": "13. suvaṇṇasāma cariyaṃ ",
  "cp33:1.1": "sāmo yadā vane āsiṃ ",
  "cp33:1.2": "sakkena abhinimmito ",
  "cp33:1.3": "pavane sīhabyagghehica ",
  "cp33:1.4": "mettāya mupanāmayiṃ. ",
  "cp33:2.1": "sīhabyagghehi dīpīhi ",
  "cp33:2.2": "acchehi mahisehi ca ",
  "cp33:2.3": "pasadamigavarāhehi ",
  "cp33:2.4": "parivāretvā vane vasiṃ. ",
  "cp33:3.1": "na maṃ koci uttasati, ",
  "cp33:3.2": "napihaṃ bhāyāmi kassaci, ",
  "cp33:3.3": "mettābalenupatattha’ddho ",
  "cp33:3.4": "ramāmi pavane tadāti. ",
  "cp33:4.1": "suvaṇṇa sāma cariyaṃ terasamaṃ. "
}
