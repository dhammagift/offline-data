{
  "thig1.18:0.1": "",
  "thig1.18:0.2": "",
  "thig1.18:0.3": "1. 18. ",
  "thig1.18:1.1": "hitvā ghare pabbajitā ",
  "thig1.18:1.2": "hitvā puttaṃ pasuṃ piyaṃ, ",
  "thig1.18:1.3": "hitvā rāgañca dosañca ",
  "thig1.18:1.4": "avijjañca virājiya, ",
  "thig1.18:1.5": "samūlaṃ taṇhaṃ abbuyha ",
  "thig1.18:1.6": "upasantamhi nibbutāti. ",
  "thig1.18:2.1": "itthaṃ sudaṃ saṅghātherī gāthaṃ abhāsitthā’ti. saṅghātherīgāthā. ",
  "thig1.18:3.1": "ekakanipāto niṭṭhito. "
}
