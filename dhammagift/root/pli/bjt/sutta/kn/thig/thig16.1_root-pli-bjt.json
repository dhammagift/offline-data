{
  "thig16.1:0.1": "",
  "thig16.1:0.2": "mahānipāto. ",
  "thig16.1:0.3": "1. ",
  "thig16.1:1.1": "mantāvatiyā nagare ",
  "thig16.1:1.2": "rañño koñcassa aggamahesiyā, ",
  "thig16.1:1.3": "dhītā āsi sumedhā ",
  "thig16.1:1.4": "pasāditā sāsanakarehi. ",
  "thig16.1:2.1": "sīlavatī cittakathā ",
  "thig16.1:2.2": "bahussutā buddhasāsane vinītā, ",
  "thig16.1:2.3": "mātāpitaro upagamma ",
  "thig16.1:2.4": "bhaṇati ubhayo nisāmetha. ",
  "thig16.1:3.1": "nibbānābhiratāhaṃ ",
  "thig16.1:3.2": "asassataṃ bhavagataṃ yadipi dibbaṃ, ",
  "thig16.1:3.3": "kimaṅga pana tucchā kāmā ",
  "thig16.1:3.4": "appassādā bahuvighātā. ",
  "thig16.1:4.1": "kāmā kaṭukā āsī- ",
  "thig16.1:4.2": "visūpamā yesu mucchitā bālā, ",
  "thig16.1:4.3": "te dīgharattaṃ niraye ",
  "thig16.1:4.4": "samappitā haññante dukkhitā. ",
  "thig16.1:5.1": "socanti pāpakammā ",
  "thig16.1:5.2": "vinipāte pāpabuddhito, sadā ",
  "thig16.1:5.3": "kāyena vācāya ",
  "thig16.1:5.4": "manasā ca asaṃvutā. bālā ",
  "thig16.1:6.1": "te duppaññā ",
  "thig16.1:6.2": "acetanā dukkhasamudayo ruddhā ",
  "thig16.1:6.3": "desente ajānantā ",
  "thig16.1:6.4": "na bujjhate ariyasaccāni. ",
  "thig16.1:7.1": "saccāni amma buddhavara- desitāni ",
  "thig16.1:7.2": "te bahutarā ajānantā, ye ",
  "thig16.1:7.3": "abhinandanti bhavagataṃ ",
  "thig16.1:7.4": "pihenti devesu upapattiṃ. ",
  "thig16.1:8.1": "devesupi upapatti ",
  "thig16.1:8.2": "asassatā bhavagate aniccamhi, ",
  "thig16.1:8.3": "na ca santasanti bālā ",
  "thig16.1:8.4": "punappunaṃ jāyitabbassa. ",
  "thig16.1:9.1": "cattāro vinipātā ",
  "thig16.1:9.2": "dve ca gatiyo kathañci labbhanti ",
  "thig16.1:9.3": "na ca vinipātagatānaṃ ",
  "thig16.1:9.4": "pabbajjā atthi nirayesu. ",
  "thig16.1:10.1": "anujānātha maṃ ubhayo ",
  "thig16.1:10.2": "pabbajituṃ dasabalassa pāvacane ",
  "thig16.1:10.3": "appossukkā ghaṭissaṃ ",
  "thig16.1:10.4": "jātimaraṇappahānāya. ",
  "thig16.1:11.1": "kiṃ bhavagatena abhinanditena ",
  "thig16.1:11.2": "kāyakalinā asārena, ",
  "thig16.1:11.3": "bhavataṇhāya nirodhā ",
  "thig16.1:11.4": "anujānātha pabbajissāmi. ",
  "thig16.1:12.1": "buddhānaṃ uppādo vivajjito ",
  "thig16.1:12.2": "akkhaṇo khaṇo laddho, ",
  "thig16.1:12.3": "sīlāni brahmacariyaṃ ",
  "thig16.1:12.4": "yāvajīvaṃ na dūseyyaṃ. ",
  "thig16.1:13.1": "evaṃ bhaṇati sumedhā ",
  "thig16.1:13.2": "mātāpitaro na tāva āhāraṃ, ",
  "thig16.1:13.3": "āhariyāmi gahaṭṭhā ",
  "thig16.1:13.4": "maraṇavasaṃ gatāva hessāmi. ",
  "thig16.1:14.1": "mātā dukkhitā rodati pitā ca ",
  "thig16.1:14.2": "assā sabbaso samabhihato, ",
  "thig16.1:14.3": "ghaṭenti saññāpetuṃ ",
  "thig16.1:14.4": "pāsādatale chamāpatitaṃ. ",
  "thig16.1:15.1": "uṭṭhehi puttaka kiṃ socitena ",
  "thig16.1:15.2": "dinnāsi vāraṇavatimhi ",
  "thig16.1:15.3": "rājā aṇīkadatto ",
  "thig16.1:15.4": "abhirūpo tassa tvaṃ dinnā. ",
  "thig16.1:16.1": "aggamahesī bhavissasi ",
  "thig16.1:16.2": "aṇīkadattassa rājino bhariyā, ",
  "thig16.1:16.3": "sīlāni brahmacariyaṃ ",
  "thig16.1:16.4": "pabbajjā dukkarā puttaka. ",
  "thig16.1:17.1": "rajje āṇā dhanamissariyaṃ ",
  "thig16.1:17.2": "bhogā sukhā daharikāsi, ",
  "thig16.1:17.3": "bhuñjāhi kāmabhoge ",
  "thig16.1:17.4": "vāreyyaṃ hotu te putta. ",
  "thig16.1:18.1": "atha ne bhaṇati sumedhā ",
  "thig16.1:18.2": "mā īdisikānaṃ bhavagataṃ asāraṃ, ",
  "thig16.1:18.3": "pabbajjā vā hehiti, ",
  "thig16.1:18.4": "maraṇaṃ vā me naceva vāreyyaṃ. ",
  "thig16.1:19.1": "kimiva pūtikāyamasuciṃ ",
  "thig16.1:19.2": "savanagandhaṃ bhayānakaṃ kuṇapaṃ ",
  "thig16.1:19.3": "abhisaṃviseyyaṃ bhastaṃ ",
  "thig16.1:19.4": "asakiṃ paggharaṇaṃ asucipuṇṇaṃ. ",
  "thig16.1:20.1": "kimiva tāhaṃ jānantī ",
  "thig16.1:20.2": "vikūlakaṃ maṃsasoṇitupalittaṃ, ",
  "thig16.1:20.3": "kimikulālayaṃ sakuṇabhattaṃ ",
  "thig16.1:20.4": "kalebaraṃ kissa dīyatīti. ",
  "thig16.1:21.1": "nibbuyhati susānaṃ ",
  "thig16.1:21.2": "aciraṃ kāyo apetaviññāṇo ",
  "thig16.1:21.3": "chuddho kaliṅgaraṃ viya ",
  "thig16.1:21.4": "jigucchamānehi ñātīhi. ",
  "thig16.1:22.1": "chuddhuna taṃ susāne ",
  "thig16.1:22.2": "parabhattaṃ nahāyanti jigucchantā, ",
  "thig16.1:22.3": "niyakā mātāpitaro ",
  "thig16.1:22.4": "kiṃ pana sādhāraṇā janatā. ",
  "thig16.1:23.1": "ajjhositā asāre ",
  "thig16.1:23.2": "kalebare aṭṭhinahārusaṅghāte, ",
  "thig16.1:23.3": "khelassuccārapassava ",
  "thig16.1:23.4": "paripuṇṇe pūtikāyamhi. ",
  "thig16.1:24.1": "yo na vinibbhujitvā ",
  "thig16.1:24.2": "abbhantaramassa bāhiraṃ kayirā, ",
  "thig16.1:24.3": "gandhassa asahamānā ",
  "thig16.1:24.4": "sakāpi mātā jiguccheyya. ",
  "thig16.1:25.1": "khandhadātuāyatanaṃ ",
  "thig16.1:25.2": "saṅkhataṃ jātimūlakaṃ dukkhaṃ, ",
  "thig16.1:25.3": "yoniso anuvicinantī ",
  "thig16.1:25.4": "vāreyyaṃ kissa iccheyyaṃ. ",
  "thig16.1:26.1": "divase divase tisatti ",
  "thig16.1:26.2": "satāni nava navā pateyyuṃ kāyamhi, ",
  "thig16.1:26.3": "vassasatampi ca ghāto ",
  "thig16.1:26.4": "seyyo dukkhassa cevaṃ khayo. ",
  "thig16.1:27.1": "ajjhapagacche ghātaṃ ",
  "thig16.1:27.2": "yo viññāyevaṃ satthuno vacanaṃ, ",
  "thig16.1:27.3": "dīgho tesaṃ saṃsāro ",
  "thig16.1:27.4": "punappunaṃ haññamānānaṃ. ",
  "thig16.1:28.1": "devesu manussesu ca ",
  "thig16.1:28.2": "tiracchānayoniyā asurakāye, ",
  "thig16.1:28.3": "petesu ca nirayesu ca ",
  "thig16.1:28.4": "aparimitā dissare ghātā. ",
  "thig16.1:29.1": "ghātā nirayesu bahū ",
  "thig16.1:29.2": "vinipātagatassa pīḷiyamānassa ",
  "thig16.1:29.3": "devesupi attāṇaṃ ",
  "thig16.1:29.4": "nibbānasukhā paraṃ natthi. ",
  "thig16.1:30.1": "pattā te nibbānaṃ ",
  "thig16.1:30.2": "ye yuttā dasabalassa pāvacane, ",
  "thig16.1:30.3": "appossukkā ghaṭenti ",
  "thig16.1:30.4": "jātimaraṇappahānāya. ",
  "thig16.1:31.1": "ajjeva tātabhinikkhamissaṃ ",
  "thig16.1:31.2": "bhogehi kiṃ asārehi, ",
  "thig16.1:31.3": "nibbinnā me kāmā ",
  "thig16.1:31.4": "vantasamā tālāvatthukatā. ",
  "thig16.1:32.1": "sācevaṃ bhaṇati pitaraṃ ",
  "thig16.1:32.2": "aṇīkadatto ca yassa sā dinnā ",
  "thig16.1:32.3": "upayāsa vāraṇavate ",
  "thig16.1:32.4": "vāreyyaṃ upaṭṭhite kāle. ",
  "thig16.1:33.1": "atha asita nicitamuduke ",
  "thig16.1:33.2": "kese khaggena chindiya sumedhā, ",
  "thig16.1:33.3": "pāsādaṃ ca pidhetvā ",
  "thig16.1:33.4": "paṭhamajjhānaṃ samāpajji. ",
  "thig16.1:34.1": "sā ca tahiṃ samāpannā ",
  "thig16.1:34.2": "aṇīkadatto ca āgato nagaraṃ, ",
  "thig16.1:34.3": "pāsādeva sumedhā ",
  "thig16.1:34.4": "aniccasaññā subhāveti. ",
  "thig16.1:35.1": "sā ca manasikaroti ",
  "thig16.1:35.2": "aṇīkadatto ca āruhi turitaṃ ",
  "thig16.1:35.3": "maṇikanakabhūsitaṅgo ",
  "thig16.1:35.4": "katañjalī yācati sumedhaṃ. ",
  "thig16.1:36.1": "ajje āṇādhanamissariyaṃ ",
  "thig16.1:36.2": "bhogā sukhā daharikāsi, ",
  "thig16.1:36.3": "bhuñjāhi kāmabhoge ",
  "thig16.1:36.4": "kāmasukhā sudullabhā loke. ",
  "thig16.1:37.1": "nissaṭṭhaṃ te rajjaṃ ",
  "thig16.1:37.2": "bhoge bhuñjassu dehi dānāni, ",
  "thig16.1:37.3": "mā dummanā ahosi ",
  "thig16.1:37.4": "mātāpitaro te dukkhitā. ",
  "thig16.1:38.1": "taṃ taṃ bhaṇati sumedhā ",
  "thig16.1:38.2": "kāmehi anatthikā vigatamohā, ",
  "thig16.1:38.3": "mā kāme abhinandi ",
  "thig16.1:38.4": "kāmesvādīnavaṃ passa. ",
  "thig16.1:39.1": "cātuddīpo rājā ",
  "thig16.1:39.2": "mandhātā āsi kāmabhogīnamaggo ",
  "thig16.1:39.3": "atitto kālaṃ kato ",
  "thig16.1:39.4": "na cassa paripūritā icchā. ",
  "thig16.1:40.1": "sattaratanāni vasseyya ",
  "thig16.1:40.2": "vuṭṭhimā dasadisā samantena ",
  "thig16.1:40.3": "na catthi titti kāmānaṃ ",
  "thig16.1:40.4": "atittāva maranti narā. ",
  "thig16.1:41.1": "asisūnūpamā kāmā ",
  "thig16.1:41.2": "kāmā sappasirūpamā, ",
  "thig16.1:41.3": "ukkūpamā anudahanti ",
  "thig16.1:41.4": "aṭṭhikaṅkala sannibhā. ",
  "thig16.1:42.1": "aniccā addhuvā kāmā ",
  "thig16.1:42.2": "bahudukkhā mahāvisā, ",
  "thig16.1:42.3": "ayogulova santatto ",
  "thig16.1:42.4": "aghamūlā dumapphalā. ",
  "thig16.1:43.1": "rukkhaphalūpamā kāmā ",
  "thig16.1:43.2": "maṃsapesūpamā dukhā, ",
  "thig16.1:43.3": "supinopamā vañcaniyā ",
  "thig16.1:43.4": "kāmā yācitakūpamā. ",
  "thig16.1:44.1": "sattisūlūpamā kāmā ",
  "thig16.1:44.2": "rogo gaṇḍo aghaṃ nighaṃ, ",
  "thig16.1:44.3": "aṅgārakāsusadisā ",
  "thig16.1:44.4": "aghamūlaṃ bhayaṃ vadho. ",
  "thig16.1:45.1": "evaṃ bahudukhā kāmā ",
  "thig16.1:45.2": "akkhātā antarāyikā, ",
  "thig16.1:45.3": "gacchatha na me bhavagate ",
  "thig16.1:45.4": "vissāso atthi attano. ",
  "thig16.1:46.1": "kiṃ mama paro karissati ",
  "thig16.1:46.2": "attano sīsamhi ḍayhamānamhi, ",
  "thig16.1:46.3": "anubandhe jarāmaraṇe ",
  "thig16.1:46.4": "tassa ghātāya ghaṭitabbaṃ. ",
  "thig16.1:47.1": "dvāraṃ avāpuritvāhaṃ ",
  "thig16.1:47.2": "mātāpitaro anīkadattañca ",
  "thig16.1:47.3": "disvāna chamaṃ nisinne ",
  "thig16.1:47.4": "rodante idamavocaṃ. ",
  "thig16.1:48.1": "dīgho bālānaṃ saṃsāro ",
  "thig16.1:48.2": "punappunañca rodataṃ, ",
  "thig16.1:48.3": "anamatagge pitu maraṇe ",
  "thig16.1:48.4": "bhātu vadhe attano ca vadhe. ",
  "thig16.1:49.1": "assu thaññaṃ rudhiraṃ ",
  "thig16.1:49.2": "saṃsāraṃ anamataggato sarataṃ, ",
  "thig16.1:49.3": "sattānaṃ saṃsarataṃ ",
  "thig16.1:49.4": "sarāhi aṭṭhīnañca sannicayaṃ. ",
  "thig16.1:50.1": "sara caturodadhi ",
  "thig16.1:50.2": "upanīte assu thañña rudhiramhi ",
  "thig16.1:50.3": "sara ekakappamaṭṭhīnaṃ ",
  "thig16.1:50.4": "sañcayaṃ vipulena samaṃ. ",
  "thig16.1:51.1": "anamatagge saṃsarato ",
  "thig16.1:51.2": "mahiṃ jambudīpamupanītaṃ, ",
  "thig16.1:51.3": "ke ḷaṭṭhimattagulikā ",
  "thig16.1:51.4": "mātāmātusveva nappahonti. sara ",
  "thig16.1:52.1": "tiṇakaṭṭhasākhāpalāsaṃ ",
  "thig16.1:52.2": "upanītaṃ anamataggato, ",
  "thig16.1:52.3": "caturaṅgulikā ghaṭikā ",
  "thig16.1:52.4": "pitupitusveva nappahonti. ",
  "thig16.1:53.1": "sara kāṇakacchapaṃ pubbasamudde ",
  "thig16.1:53.2": "aparato ca yugacchiddaṃ ",
  "thig16.1:53.3": "sara tassa ca paṭimukkaṃ ",
  "thig16.1:53.4": "manussalābhamhi opammaṃ. ",
  "thig16.1:54.1": "sara rūpaṃ pheṇapiṇḍopamassa ",
  "thig16.1:54.2": "kāyakaliko asārassa ",
  "thig16.1:54.3": "khandhe passa anicce ",
  "thig16.1:54.4": "sarāhi niraye bahuvighāte. ",
  "thig16.1:55.1": "sara kaṭasīvaḍḍhante ",
  "thig16.1:55.2": "punappunaṃ tāsu tāsu jātisu, ",
  "thig16.1:55.3": "sara kumbhīgabhayāni ca ",
  "thig16.1:55.4": "sarāhi cattāri saccāni. ",
  "thig16.1:56.1": "amatamhi vijjamāne ",
  "thig16.1:56.2": "kiṃ tava pañcakaṭukena pītena, ",
  "thig16.1:56.3": "sabbā hi kāmaratiyo ",
  "thig16.1:56.4": "kaṭukatarā pañcakaṭukena. ",
  "thig16.1:57.1": "amatamhi vijjamāne ",
  "thig16.1:57.2": "kiṃ tava kāmehi ye sapariḷāhā ",
  "thig16.1:57.3": "sabbā hi kāmaratiyo ",
  "thig16.1:57.4": "jalitā kuthitā kampitā santapitā. ",
  "thig16.1:58.1": "asapattamhi samāne ",
  "thig16.1:58.2": "kiṃ tava kāmehi ye bahusapattā, ",
  "thig16.1:58.3": "rājaggicoraudakappiyehi ",
  "thig16.1:58.4": "sādhāraṇā kāmā bahūsapattā. ",
  "thig16.1:59.1": "mokkhamhi vijjamāne ",
  "thig16.1:59.2": "kiṃ tava kāmehi yesu vadhabandho, ",
  "thig16.1:59.3": "kāmesu hi asatā kāmā ",
  "thig16.1:59.4": "vadhabandhanadukkhāni anubhonti. ",
  "thig16.1:60.1": "ādīpitā tiṇukkā ",
  "thig16.1:60.2": "gaṇhantaṃ dahanti neva muñcantaṃ, ",
  "thig16.1:60.3": "ukkopamā hi kāmā ",
  "thig16.1:60.4": "dahanti ye te na muñcanti. ",
  "thig16.1:61.1": "mā appakassa hetu ",
  "thig16.1:61.2": "kāmasukhassa vipulaṃ jahī sukhaṃ, ",
  "thig16.1:61.3": "mā puthulomova balisaṃ ",
  "thig16.1:61.4": "gilitvā pacchā vihaññasi. ",
  "thig16.1:62.1": "kāmaṃ kāmesu damassu ",
  "thig16.1:62.2": "tāva sunakhova saṅkhalābaddho ",
  "thig16.1:62.3": "kāhinti khu taṃ kāmā ",
  "thig16.1:62.4": "chātā sunakhaṃ va caṇḍālā. ",
  "thig16.1:63.1": "aparimitaṃ ca dukkha ",
  "thig16.1:63.2": "bahūni ca cittadomanassāni, ",
  "thig16.1:63.3": "anubhohisi kāmesu yutto ",
  "thig16.1:63.4": "paṭinissaja addhuve kāme. ",
  "thig16.1:64.1": "ajaramhi vijjamāne ",
  "thig16.1:64.2": "kiṃ tava kāmehi yesu jarāmaraṇavyādhigahitā ",
  "thig16.1:64.3": "",
  "thig16.1:64.4": "sabbā sabbattha jātiyo. ",
  "thig16.1:65.1": "idamajaramidamamaraṃ ",
  "thig16.1:65.2": "idamajarāmarapadamasokaṃ, ",
  "thig16.1:65.3": "asapattamasambādhaṃ ",
  "thig16.1:65.4": "akhalitamabhayaṃ nirupatāpaṃ. ",
  "thig16.1:66.1": "adhigatamidaṃ bahūhi ",
  "thig16.1:66.2": "amatamajjāpi ca labhanīyamidaṃ, ",
  "thig16.1:66.3": "yo yoniso payuñjati ",
  "thig16.1:66.4": "na ca sakkā aghaṭamānena. ",
  "thig16.1:67.1": "evaṃ bhaṇati sumedhā ",
  "thig16.1:67.2": "saṅkharagate ratimalabhamānā, ",
  "thig16.1:67.3": "anunentyaṇīkadattaṃ ",
  "thig16.1:67.4": "kese ca chamaṃ khipi sumedhā. ",
  "thig16.1:68.1": "uṭṭhāya aṇīkadatto ",
  "thig16.1:68.2": "pañjaliko yāci tassā pitaraṃ so, ",
  "thig16.1:68.3": "vissajjetha sumedhaṃ ",
  "thig16.1:68.4": "pabbajituṃ vimokkhasaccadassā. ",
  "thig16.1:69.1": "vissajjitā mātāpitūhi ",
  "thig16.1:69.2": "pabbaji sokabhayabhītā, ",
  "thig16.1:69.3": "cha abhiññā sacchikatā ",
  "thig16.1:69.4": "aggaphalaṃ sikkhamānāya. ",
  "thig16.1:70.1": "acchariyaṃ abbhutaṃ taṃ ",
  "thig16.1:70.2": "nibbānaṃ āsi rājataññāya, ",
  "thig16.1:70.3": "pubbenivāsacaritaṃ ",
  "thig16.1:70.4": "yathā byākari pacchime kāle. ",
  "thig16.1:71.1": "bhagavati koṇāgamane ",
  "thig16.1:71.2": "saṅghārāmamhi navanivesamhi ",
  "thig16.1:71.3": "sakhiyo tisso janiyo ",
  "thig16.1:71.4": "vihāradānaṃ adāsimhāse. ",
  "thig16.1:72.1": "dasakkhattuṃ satakkhattuṃ ",
  "thig16.1:72.2": "dasasatakkhattuṃ satāni ca satakkhattuṃ, ",
  "thig16.1:72.3": "devesu upapajjimha ",
  "thig16.1:72.4": "ko pana vādo manussesu. ",
  "thig16.1:73.1": "devesu mahiddhikā ahumha ",
  "thig16.1:73.2": "mānusakamhi ko pana vādo, ",
  "thig16.1:73.3": "sattaratanassa mahesī ",
  "thig16.1:73.4": "itthiratanaṃ ahaṃ āsiṃ. ",
  "thig16.1:74.1": "so hetu so pabhavo ",
  "thig16.1:74.2": "taṃ mūlaṃ sāva sāsane khanti, ",
  "thig16.1:74.3": "taṃ paṭhamaṃ samodhānaṃ ",
  "thig16.1:74.4": "taṃ dhammaratāya nibbānaṃ. ",
  "thig16.1:75.1": "evaṃ karonti ye saddahanti ",
  "thig16.1:75.2": "vacanaṃ anomapaññassa ",
  "thig16.1:75.3": "nibbindanti bhavagate ",
  "thig16.1:75.4": "nibbinditvā virajjantīti. ",
  "thig16.1:76.1": "itthaṃ sudaṃ sumedhā therī gāthāyo abhāsitthāti. ",
  "thig16.1:76.2": "sumedhātherīgāthā. mahānipāto niṭṭhito. ",
  "thig16.1:77.0": "",
  "thig16.1:77.1": "gāthāsatāni cattāri ",
  "thig16.1:77.2": "asīti puna cuddasa ",
  "thig16.1:77.3": "theriyekuttarasatā ",
  "thig16.1:77.4": "sabbā tā āsavakkhayāti. ",
  "thig16.1:77.5": "therīgāthā samattā. "
}
