  "thig1.15:0.3": "1. 15. ",
  "thig1.15:1.1": "kāyena saṃvutā āsiṃ ",
  "thig1.15:1.2": "vācāya uda cetasā, ",
  "thig1.15:1.3": "samūlaṃ taṇhaṃ abbuyha ",
  "thig1.15:1.4": "sītibhūtamhi nibbutāti. ",
  "thig1.15:2.1": "itthaṃ sudaṃ uttarātherī gāthaṃ abhāsitthā’ti. uttarātherīgāthā. "
}
