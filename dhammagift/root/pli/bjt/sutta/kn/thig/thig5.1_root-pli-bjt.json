{
  "thig5.1:0.1": "",
  "thig5.1:0.2": "5. pañcakanipāto. ",
  "thig5.1:0.3": "5. 1. ",
  "thig5.1:1.1": "paṇṇavīsativassāni ",
  "thig5.1:1.2": "yato pabbajitā ahaṃ ",
  "thig5.1:1.3": "naccharāsaṅghatamattampi ",
  "thig5.1:1.4": "cittassūpasamajjhagaṃ. ",
  "thig5.1:2.1": "aladdhā cetaso santiṃ ",
  "thig5.1:2.2": "kāmarāgenavassutā, ",
  "thig5.1:2.3": "bāhāpaggayha kandantī ",
  "thig5.1:2.4": "vihāraṃ pāvisiṃ ahaṃ. ",
  "thig5.1:3.1": "taṃ bhikkhunīmupāgañjiṃ ",
  "thig5.1:3.2": "yā me saddhāyikā ahu, ",
  "thig5.1:3.3": "sā me dhammamadesesi ",
  "thig5.1:3.4": "khandhāyatanadhātuyo. ",
  "thig5.1:4.1": "tassā dhammaṃ suṇitvāna ",
  "thig5.1:4.2": "ekamante upāvisiṃ, ",
  "thig5.1:4.3": "pubbenivāsaṃ jānāmi ",
  "thig5.1:4.4": "dibbacakkhuṃ visodhitaṃ. ",
  "thig5.1:5.1": "cetopariyañāṇañca ",
  "thig5.1:5.2": "sotadhātu visodhitā, ",
  "thig5.1:5.3": "ididhipi me sacchikatā ",
  "thig5.1:5.4": "patto me āvakkhayo, ",
  "thig5.1:5.5": "chaḷabhiññā sacchikatā ",
  "thig5.1:5.6": "kataṃ buddhassa sāsananti. itthaṃ sudaṃ ",
  "thig5.1:6.1": "aññatarā therī gāthāyo abhāsitthā’ti. aññatarātherīgāthā. "
}
