  "thig1.13:0.3": "1. 13. ",
  "thig1.13:1.1": "karotha buddhasāsanaṃ ",
  "thig1.13:1.2": "yaṃ katvā nānutappati, ",
  "thig1.13:1.3": "khippaṃ pādāni dhovitvā ",
  "thig1.13:1.4": "ekamante nisīdathāti. ",
  "thig1.13:2.1": "itthaṃ sudaṃ visākhātherī gāthaṃ abhāsitthā’ti. visākhātherīgāthā. "
}
