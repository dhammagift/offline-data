{
  "thig2.7:0.1": "",
  "thig2.7:0.2": "",
  "thig2.7:0.3": "2. 7. ",
  "thig2.7:1.1": "cātuddasiṃ pañcadasiṃ ",
  "thig2.7:1.2": "yā ca pakkhassa aṭṭhamī ",
  "thig2.7:1.3": "pāṭihāriyapakkhañca ",
  "thig2.7:1.4": "aṭṭhaṅgasusamāgataṃ, ",
  "thig2.7:2.1": "uposathaṃ upāgañchiṃ ",
  "thig2.7:2.2": "devakāyābhinandinī. ",
  "thig2.7:2.3": "sājja ekena bhattena ",
  "thig2.7:2.4": "muṇḍā saṅghāṭipārutā ",
  "thig2.7:2.5": "devakāyaṃ na patthehaṃ ",
  "thig2.7:2.6": "vineyya hadaye daranti. ",
  "thig2.7:3.1": "itthaṃ sudaṃ mettā therī gāthāyo abhāsitthā’ti. mettātherīgāthā. "
}
