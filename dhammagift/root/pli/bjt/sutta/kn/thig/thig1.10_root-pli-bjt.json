  "thig1.10:0.2": "",
  "thig1.10:0.3": "1. 10. bhadrātherīgāthā. ",
  "thig1.10:1.1": "upasame tare oghaṃ ",
  "thig1.10:1.2": "maccudheyyaṃ suduttaraṃ, ",
  "thig1.10:1.3": "dhārehi antimaṃ dehaṃ ",
  "thig1.10:1.4": "jetvā māraṃ savāhininti. itthaṃ sudaṃ ",
  "thig1.10:2.1": "upasamā therī gāthaṃ abhāsitthā’ti. "
}
