  "thig1.4:0.1": "",
  "thig1.4:0.2": "",
  "thig1.4:0.3": "1. 4. puṇṇātherīgāthā. ",
  "thig1.4:1.1": "tisse sikkhassu sikkhāya ",
  "thig1.4:1.2": "mā taṃ yogā upaccaguṃ, ",
  "thig1.4:1.3": "sabbayogavisaṃyuttā ",
  "thig1.4:1.4": "cara loke anāsavā’ti. itthaṃ sudaṃ ",
  "thig1.4:2.1": "tissā therī gāthaṃ abhāsitthā’ti. "
}
