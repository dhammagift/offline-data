  "thig1.12:0.3": "1. 12. muttātherīgāthā. ",
  "thig1.12:1.1": "chandajātā avasāyī ",
  "thig1.12:1.2": "manasā ca phuṭhā siyā, ",
  "thig1.12:1.3": "kāmesu appaṭibaddhacittā ",
  "thig1.12:1.4": "uddhaṃsotāti vuccatīti. itthaṃ sudaṃ ",
  "thig1.12:2.1": "dhammadinnā therī gāthaṃ abhāsitthā’ti. "
}
