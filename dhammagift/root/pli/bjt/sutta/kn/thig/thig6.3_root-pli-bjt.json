{
  "thig6.3:0.1": "",
  "thig6.3:0.2": "",
  "thig6.3:0.3": "6. 3. ",
  "thig6.3:1.1": "daharā tvaṃ rūpavatī ",
  "thig6.3:1.2": "ahampi daharo yuvā, ",
  "thig6.3:1.3": "pañcaṅgikena turuyena ",
  "thig6.3:1.4": "ehi kheme ramāmase. ",
  "thig6.3:2.1": "iminā pūtikāyena ",
  "thig6.3:2.2": "āturena pabhaṅgunā ",
  "thig6.3:2.3": "aṭṭiyāmi harāyāmi ",
  "thig6.3:2.4": "kāmataṇhā samūhatā. ",
  "thig6.3:3.1": "sattisūlūpamākāmā ",
  "thig6.3:3.2": "khandhāsaṃ adhikuṭṭanā ",
  "thig6.3:3.3": "yaṃ tvaṃ kāmaratiṃ brūsi ",
  "thig6.3:3.4": "arati dāni sā mama. ",
  "thig6.3:4.1": "sabbattha vihatā nandi ",
  "thig6.3:4.2": "tamokkhandho padālito ",
  "thig6.3:4.3": "evaṃ jānāhi pāpima ",
  "thig6.3:4.4": "nihato tvamasi antaka. ",
  "thig6.3:5.1": "nakkhattāni namassantā ",
  "thig6.3:5.2": "aggiṃ paricaraṃ vane ",
  "thig6.3:5.3": "yathābhuccaṃ ajānantā ",
  "thig6.3:5.4": "bālā suddhiṃ amaññatha. ",
  "thig6.3:6.1": "ahañca kho namassantī ",
  "thig6.3:6.2": "sambuddhaṃ purisuttamaṃ ",
  "thig6.3:6.3": "parimuttā sabbadukkhehi ",
  "thig6.3:6.4": "satthusāsanakārikāti. itthaṃ sudaṃ ",
  "thig6.3:7.1": "khemā therī gāthāyo abhāsīti. khemātherīgāthā. "
}
