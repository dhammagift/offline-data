{
  "thig2.9:0.1": "",
  "thig2.9:0.2": "",
  "thig2.9:0.3": "2. 9. abhayamātātherīgāthā. ",
  "thig2.9:1.1": "abhaye bhiduro kāyo ",
  "thig2.9:1.2": "yattha sattā puthujjanā, ",
  "thig2.9:1.3": "nikkhipippāmimaṃ dehaṃ ",
  "thig2.9:1.4": "sampajānā satīmatī. ",
  "thig2.9:2.1": "bahūhi dikkhadhammehi ",
  "thig2.9:2.2": "appamādaratāya me, ",
  "thig2.9:2.3": "taṇhakkhayo anuppatto ",
  "thig2.9:2.4": "kataṃ buddhassa sāsananti. ",
  "thig2.9:3.1": "itthaṃ sudaṃ abhayātherī gāthāyo abhāsitthā’ti. "
}
