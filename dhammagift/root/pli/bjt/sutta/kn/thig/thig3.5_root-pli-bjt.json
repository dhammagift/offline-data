{
  "thig3.5:0.1": "",
  "thig3.5:0.2": "",
  "thig3.5:0.3": "3. 5. dantikātherīgāthā. ",
  "thig3.5:1.1": "amma jīvatīti vanamhi kandasi ",
  "thig3.5:1.2": "attānaṃ adhigaccha ubbirī ",
  "thig3.5:1.3": "cūḷāsīti sahassāni ",
  "thig3.5:1.4": "sabbā jīva sanāmikā ",
  "thig3.5:1.5": "etamhāḷāne daḍḍhā ",
  "thig3.5:1.6": "tāsaṃ kamanusocasi. ",
  "thig3.5:2.1": "abbahī vata me sallaṃ ",
  "thig3.5:2.2": "duddasaṃ hadayanissitaṃ ",
  "thig3.5:2.3": "yaṃ me sokaparetāya ",
  "thig3.5:2.4": "dhītusokaṃ vyapānudī. ",
  "thig3.5:3.1": "sājja abbūḷhasallāhaṃ ",
  "thig3.5:3.2": "nicchātā parinibbutā ",
  "thig3.5:3.3": "buddhaṃ dhammañca saṅghañca ",
  "thig3.5:3.4": "upemi saraṇaṃ muninti. ",
  "thig3.5:4.1": "itthaṃ sudaṃ ubbarī therī gāthāyo abhāsitthā’ti. "
}
