{
  "thig5.9:0.1": "",
  "thig5.9:0.2": "",
  "thig5.9:0.3": "5. 9. soṇatherīgāthā. ",
  "thig5.9:1.1": "lunakesi paṅkadharī ",
  "thig5.9:1.2": "vakasāṭī pure cariṃ, ",
  "thig5.9:1.3": "avajje vajjamatinī ",
  "thig5.9:1.4": "vajje cāvajjadassinī. ",
  "thig5.9:2.1": "divāvihārā nikkhamma ",
  "thig5.9:2.2": "gijjhakūṭamhi pabbate ",
  "thig5.9:2.3": "addasaṃ virajaṃ buddhaṃ ",
  "thig5.9:2.4": "bhikkhusaṅghapurakkhataṃ. ",
  "thig5.9:3.1": "nihacca jāṇuṃ vanditvā ",
  "thig5.9:3.2": "sammukhā pañjaliṃ akaṃ, ",
  "thig5.9:3.3": "ehi bhaddeti maṃ avaca ",
  "thig5.9:3.4": "sā me āsūpasampadā. ",
  "thig5.9:4.1": "ciṇṇā aṅgā ca magadhā ",
  "thig5.9:4.2": "vajjī kāsī ca kosalā, ",
  "thig5.9:4.3": "anaṇā paṇṇāsavassāni ",
  "thig5.9:4.4": "raṭṭhapiṇḍamabhuñjihaṃ. ",
  "thig5.9:5.1": "puññaṃ vata pasavī bahuṃ ",
  "thig5.9:5.2": "sappañño vatāyaṃ upāsako, ",
  "thig5.9:5.3": "yo bhaddāya cīvaraṃ adāsi ",
  "thig5.9:5.4": "vippamuttāya sabbaganthehīti. itthaṃ sudaṃ ",
  "thig5.9:6.1": "bhaddā kuṇḍalakesā therī gāthāyo abhāsitthāti. "
}
