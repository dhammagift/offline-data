{
  "thig6.1:0.1": "6. chakkanipāto. ",
  "thig6.1:0.2": "",
  "thig6.1:0.3": "6. 1. ",
  "thig6.1:1.1": "yassa maggaṃ na jānāti ",
  "thig6.1:1.2": "āgatassa gatassa vā ",
  "thig6.1:1.3": "taṃ kuto āgataṃ sattaṃ ",
  "thig6.1:1.4": "mama puttoti rodasi. ",
  "thig6.1:2.1": "maggañca khossa jānāsi ",
  "thig6.1:2.2": "āgatassa gatassa vā ",
  "thig6.1:2.3": "na naṃ samanusocesi ",
  "thig6.1:2.4": "evaṃ dhammā hi pāṇino. ",
  "thig6.1:3.1": "ayācito tatāgacchi ",
  "thig6.1:3.2": "ananuññāto ito gato ",
  "thig6.1:3.3": "kutoci nūna āgantvā ",
  "thig6.1:3.4": "vasitvā katipāhakaṃ ",
  "thig6.1:3.5": "ito’pi aññena gato ",
  "thig6.1:3.6": "tato aññena gacchati. ",
  "thig6.1:4.1": "peto manussarūpena ",
  "thig6.1:4.2": "sa saranto gamissati, ",
  "thig6.1:4.3": "yathāgato tathā gato ",
  "thig6.1:4.4": "kā tattha paridevanā. ",
  "thig6.1:5.1": "abbahī vata me sallaṃ ",
  "thig6.1:5.2": "duddasaṃ hadayanissitaṃ ",
  "thig6.1:5.3": "yā me sokaparetāya ",
  "thig6.1:5.4": "puttasokaṃ vyapānudi. ",
  "thig6.1:6.1": "sājja abbūḷhasallāhaṃ ",
  "thig6.1:6.2": "nicchātā parinibbutā ",
  "thig6.1:6.3": "buddhaṃ dhammañca saṅghañca ",
  "thig6.1:6.4": "upemi saraṇaṃ muniṃ. ",
  "thig6.1:7.1": "itthaṃ sudaṃ pañcasatamattā therī bhikkhuniyo gāthāyo abhāsitthāti. pañcasatamattānaṃ therīnaṃ gāthā. "
}
