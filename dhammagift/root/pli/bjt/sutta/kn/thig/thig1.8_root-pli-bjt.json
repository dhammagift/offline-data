  "thig1.8:0.3": "1. 8. vīrātherīgāthā. ",
  "thig1.8:1.1": "saddhāya pabbajitvāna ",
  "thig1.8:1.2": "mitte mittaratā bhava, ",
  "thig1.8:1.3": "bhāvehi kusale dhamme ",
  "thig1.8:1.4": "yogakkhemassa pattiyāti. ",
  "thig1.8:2.1": "itthaṃ sudaṃ mittātherī gāthaṃ abhāsitthā’ti. "
}
