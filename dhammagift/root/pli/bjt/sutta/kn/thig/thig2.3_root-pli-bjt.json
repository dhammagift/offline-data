{
  "thig2.3:0.1": "",
  "thig2.3:0.2": "",
  "thig2.3:0.3": "2. 3. jentātherīgāthā. ",
  "thig2.3:1.1": "sumuttike sumuttike sādhu ",
  "thig2.3:1.2": "muttikāmhi musalassa, ",
  "thig2.3:1.3": "ahiriko me chattakaṃ vāpi ",
  "thig2.3:1.4": "ukkhalikā me deḍḍhubhaṃ vāti. ",
  "thig2.3:2.1": "rāgañca ahaṃ dosañca ",
  "thig2.3:2.2": "cicciṭi cicciṭīti vihanāmi, ",
  "thig2.3:2.3": "sā rukkhamūlamupagamma ",
  "thig2.3:2.4": "ahosukhanti sukhato jhāyāmīti. ",
  "thig2.3:3.1": "itthaṃ sudaṃ sumaṅgalamātātherī gāthāyo abhāsitthā’ti. "
}
