  "thig1.5:0.3": "1. 5. tissātherīgāthā. ",
  "thig1.5:1.1": "tisse yuñjassu dhammehi ",
  "thig1.5:1.2": "khaṇo taṃ mā upaccagā, ",
  "thig1.5:1.3": "khaṇātītā hi socanti ",
  "thig1.5:1.4": "nirayamhi samappitā’ti. ",
  "thig1.5:2.1": "itthaṃ sudaṃ tissā therī gāthaṃ abhāsitthā’ti. "
}
