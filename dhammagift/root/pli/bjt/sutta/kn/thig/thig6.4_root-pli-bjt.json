{
  "thig6.4:0.1": "",
  "thig6.4:0.2": "",
  "thig6.4:0.3": "6. 4. ",
  "thig6.4:1.1": "alaṅkatā suvasanā ",
  "thig6.4:1.2": "mālinī candanukkhitā ",
  "thig6.4:1.3": "sabbābharaṇasañchannā ",
  "thig6.4:1.4": "dāsīgaṇapurakkhatā. ",
  "thig6.4:2.1": "annaṃ pānañca ādāya ",
  "thig6.4:2.2": "khajjabhojjamanappakaṃ ",
  "thig6.4:2.3": "gehato nikkhamitvāna ",
  "thig6.4:2.4": "uyyānamabhihārayiṃ. ",
  "thig6.4:3.1": "tattha ramitvā kīḷitvā ",
  "thig6.4:3.2": "āgacchanti sakaṃ gharaṃ ",
  "thig6.4:3.3": "vihāraṃ daṭṭhuṃ pavisiṃ ",
  "thig6.4:3.4": "sākete añjanaṃ vanaṃ. ",
  "thig6.4:4.1": "disvāna lokapajjotaṃ ",
  "thig6.4:4.2": "vanditvāna upāvisiṃ. ",
  "thig6.4:4.3": "se me dhammamadesesi ",
  "thig6.4:4.4": "anukampāya cakkhumā. ",
  "thig6.4:5.1": "sutvā ca kho mahesissa ",
  "thig6.4:5.2": "saccaṃ appaṭivijjhahaṃ ",
  "thig6.4:5.3": "tattheva virajaṃ dhammaṃ ",
  "thig6.4:5.4": "phussayiṃ amataṃ padaṃ. ",
  "thig6.4:6.1": "tato viññāta saddhammā ",
  "thig6.4:6.2": "pabbajiṃ anagāriyaṃ ",
  "thig6.4:6.3": "tisso vijjā anuppattā ",
  "thig6.4:6.4": "amoghaṃ buddhasāsanaṃ. itthaṃ sudaṃ ",
  "thig6.4:7.1": "sujātā therī gāthāyo abhāsīti. sujātātherīgāthā. "
}
