{
  "thig2.4:0.1": "",
  "thig2.4:0.2": "",
  "thig2.4:0.3": "2. 4. ",
  "thig2.4:1.1": "yāva kāsijanapado ",
  "thig2.4:1.2": "suṅko me tattako ahu, ",
  "thig2.4:1.3": "taṃ katvā negamo agghaṃ ",
  "thig2.4:1.4": "aḍḍhenagghaṃ ṭhapesi maṃ. ",
  "thig2.4:2.1": "atha nibbindahaṃ rūpe ",
  "thig2.4:2.2": "nibbindaṃ ca virajjahaṃ, ",
  "thig2.4:2.3": "mā puna jātisaṃsāraṃ ",
  "thig2.4:2.4": "sandhāveyyaṃ punappunaṃ, ",
  "thig2.4:2.5": "tisso vijjā acchikatā ",
  "thig2.4:2.6": "kataṃ buddhassa sāsananti. ",
  "thig2.4:3.1": "itthaṃ sudaṃ aḍḍhakāsītherī gāthāyo abhāsitthā’ti. aḍḍhakāsītherīgāthā. "
}
