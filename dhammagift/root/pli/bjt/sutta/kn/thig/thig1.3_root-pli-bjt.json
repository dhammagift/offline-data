  "thig1.3:0.3": "1. 3. ",
  "thig1.3:1.1": "puṇṇo pūrassu dhammehi ",
  "thig1.3:1.2": "cando paṇṇarasoriva, ",
  "thig1.3:1.3": "paripuṇṇāya paññāya ",
  "thig1.3:1.4": "tamokkhandhaṃ padālayāti. ",
  "thig1.3:2.1": "itthaṃ sudaṃ puṇṇā therī gāthaṃ abhāsitthā’ti. puṇṇātherīgāthā. "
}
