  "thig1.6:0.3": "1. 6. tissātherīgāthā. ",
  "thig1.6:1.1": "dhīre nirodhaṃ phussehi saññā ",
  "thig1.6:1.2": "vūpasamaṃ sukhaṃ, ",
  "thig1.6:1.3": "ārādhayāhi nibbānaṃ ",
  "thig1.6:1.4": "yogakkhemaṃ anuttaraṃ. itthaṃ sudaṃ ",
  "thig1.6:2.1": "dhīrā therī gāthaṃ abhāsitthā’ti. "
}
