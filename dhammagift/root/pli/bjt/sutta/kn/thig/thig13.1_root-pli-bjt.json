{
  "thig13.1:0.1": "",
  "thig13.1:0.2": "20. vīsatinipāto. ",
  "thig13.1:0.3": "20. 1. ",
  "thig13.1:1.1": "kāḷakā bhamaravaṇṇasādisā ",
  "thig13.1:1.2": "vellitaggā mama muddhajā ahu, ",
  "thig13.1:1.3": "te jarāya sāṇavākasādisā ",
  "thig13.1:1.4": "saccavādivacanaṃ anaññathā. ",
  "thig13.1:2.1": "vāsitova surabhīkaraṇḍako ",
  "thig13.1:2.2": "pupphapūra mama uttamaṅgajo, ",
  "thig13.1:2.3": "taṃ jarāya sasalomagandhikaṃ ",
  "thig13.1:2.4": "saccavādivacanaṃ anaññathā. ",
  "thig13.1:3.1": "kānanaṃ’va sahitaṃ suropitaṃ ",
  "thig13.1:3.2": "kocchasūcivicitaggasobhitaṃ, ",
  "thig13.1:3.3": "taṃ jarāya viralaṃ tahiṃ tahiṃ ",
  "thig13.1:3.4": "saccavādivacanaṃ anaññathā. ",
  "thig13.1:4.1": "kaṇhakhandhanasuvaṇṇamaṇḍitaṃ ",
  "thig13.1:4.2": "sobhate suveṇīhi laṅkataṃ, ",
  "thig13.1:4.3": "taṃ jarāya khajitaṃ siraṃ kataṃ ",
  "thig13.1:4.4": "saccavādivacanaṃ anaññathā. ",
  "thig13.1:5.1": "cittakārasukatāva lekhikā ",
  "thig13.1:5.2": "sobhare subhamukā pure mama, ",
  "thig13.1:5.3": "tā jarāya valīhi palambitā ",
  "thig13.1:5.4": "saccavādivacanaṃ anaññathā. ",
  "thig13.1:6.1": "bhassarā surucirā yathā maṇi ",
  "thig13.1:6.2": "nettā’hesuṃ abhinīlamayatā, ",
  "thig13.1:6.3": "te jarāya’bhihatā na sobhare ",
  "thig13.1:6.4": "saccavādivacanaṃ anaññathā. ",
  "thig13.1:7.1": "saṇhatuṅgasadisī ca nāsikā ",
  "thig13.1:7.2": "sobhate su abhiyobbanaṃ pati ",
  "thig13.1:7.3": "sā jarāya uppakūlitā viya ",
  "thig13.1:7.4": "saccavādivacanaṃ anaññathā. ",
  "thig13.1:8.1": "kaṅkaṇaṃ’va sukataṃ suniṭṭhitaṃ ",
  "thig13.1:8.2": "sobhare su mama kaṇṇapāliyo ",
  "thig13.1:8.3": "tā jarāya valīhi palambitā ",
  "thig13.1:8.4": "saccavādivacanaṃ anaññathā. ",
  "thig13.1:9.1": "pattalīmakulavaṇṇasādisā ",
  "thig13.1:9.2": "sobhare sudantā pure mama ",
  "thig13.1:9.3": "te jarāya khaṇḍitā ca pītakā ",
  "thig13.1:9.4": "saccavādivacanaṃ anaññathā. ",
  "thig13.1:10.1": "kānanamhi vanasaṇḍacārinī ",
  "thig13.1:10.2": "kokilāva madhuraṃ nikūjihaṃ ",
  "thig13.1:10.3": "taṃ jarāya khalitaṃ tahiṃ tahiṃ ",
  "thig13.1:10.4": "saccavādivacanaṃ anaññathā. ",
  "thig13.1:11.1": "saṇhakamburiva suppamajjitā ",
  "thig13.1:11.2": "sobhateva sugīvā pure mama ",
  "thig13.1:11.3": "sā jarāya bhaggā vināmitā ",
  "thig13.1:11.4": "saccavādivacanaṃ anaññathā. ",
  "thig13.1:12.1": "vaṭṭapalighasadisopamā ubho ",
  "thig13.1:12.2": "susobhare subāhā pure mama ",
  "thig13.1:12.3": "tā jarāya yathā pāṭalippalitā ",
  "thig13.1:12.4": "saccavādivacanaṃ anaññathā. ",
  "thig13.1:13.1": "saṇhamuddikasuvaṇṇamaṇḍitā ",
  "thig13.1:13.2": "sobhare suhatthā pure mama ",
  "thig13.1:13.3": "te jarāya yatha mūlamūlikā ",
  "thig13.1:13.4": "saccavādivacanaṃ anaññathā. ",
  "thig13.1:14.1": "pīnavaṭṭa sahituggatā ubho ",
  "thig13.1:14.2": "sobhare suthanakā pure mama ",
  "thig13.1:14.3": "thevikīva lambanti nodakā ",
  "thig13.1:14.4": "saccavādivacanaṃ anaññathā. ",
  "thig13.1:15.1": "kañcanassa phalanaṃva sumaṭṭaṃ ",
  "thig13.1:15.2": "sobhate sukāyo pure mama ",
  "thig13.1:15.3": "so valīhi sukhumāhi otato ",
  "thig13.1:15.4": "saccavādivacanaṃ anaññathā. ",
  "thig13.1:16.1": "nāgabhogasadisopamā ubho ",
  "thig13.1:16.2": "sobhare suūru pure mama ",
  "thig13.1:16.3": "te jarāya yatha veḷunāḷiyo ",
  "thig13.1:16.4": "saccavādīvacanaṃ anaññathā. ",
  "thig13.1:17.1": "saṇhanūpurasuvaṇṇamaṇḍitā ",
  "thig13.1:17.2": "sobhare sujaṅghā pure mama ",
  "thig13.1:17.3": "tā jarāya tiladaṇḍakāriva ",
  "thig13.1:17.4": "saccavādivacanaṃ anaññathā. ",
  "thig13.1:18.1": "tūlapuṇṇasadisopamā ubho ",
  "thig13.1:18.2": "sobhare supādā pure mama ",
  "thig13.1:18.3": "te jarāya phuṭitā valīmatā ",
  "thig13.1:18.4": "saccavādivacanaṃ anaññathā. ",
  "thig13.1:19.1": "ediso ahu ayaṃ samussayo ",
  "thig13.1:19.2": "jajjaro bahu dukhānamālayo ",
  "thig13.1:19.3": "sopalepapatito jarāghāro ",
  "thig13.1:19.4": "saccavādivacanaṃ anaññathā. itthaṃ sudaṃ ",
  "thig13.1:20.1": "ambapālī therī gāthāyo abhāsīti. ambapālitherīgāthā. "
}
