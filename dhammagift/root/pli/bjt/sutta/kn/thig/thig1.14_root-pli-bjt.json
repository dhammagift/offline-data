  "thig1.14:0.1": "",
  "thig1.14:0.2": "",
  "thig1.14:0.3": "1. 14. visākhātherīgāthā. ",
  "thig1.14:1.1": "dhātuyo dukkhato disvā ",
  "thig1.14:1.2": "mā jātiṃ punarāgami, ",
  "thig1.14:1.3": "bhave chandaṃ virājetvā ",
  "thig1.14:1.4": "upasantā carissasīti. ",
  "thig1.14:2.1": "itthaṃ sudaṃ sumanātherī gāthaṃ abhāsitthā’ti. "
}
