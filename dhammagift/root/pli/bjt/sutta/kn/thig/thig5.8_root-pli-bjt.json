{
  "thig5.8:0.1": "",
  "thig5.8:0.2": "",
  "thig5.8:0.3": "5. 8. sakulātherīgāthā. ",
  "thig5.8:1.1": "dasa putte vijāyitvā ",
  "thig5.8:1.2": "asmiṃ rūpasamussaye ",
  "thig5.8:1.3": "tatohaṃ dubbalā jiṇṇā ",
  "thig5.8:1.4": "bhikkhuniṃ upasaṅkamiṃ. ",
  "thig5.8:2.1": "sā me dhammamadesesi ",
  "thig5.8:2.2": "khandhāyatanadhātuyo ",
  "thig5.8:2.3": "tassā dhammaṃ suṇitvāna ",
  "thig5.8:2.4": "kese chetvāna pabbajiṃ. ",
  "thig5.8:3.1": "tassā me sikkhamānāya ",
  "thig5.8:3.2": "dibbacakkhu visodhitaṃ, ",
  "thig5.8:3.3": "pubbenivāsaṃ jānāmi ",
  "thig5.8:3.4": "yattha me vusitaṃ pure. ",
  "thig5.8:4.1": "animittañca bhāvemi ",
  "thig5.8:4.2": "ekaggā susamāhitā, ",
  "thig5.8:4.3": "anantarā vimokkhāsiṃ ",
  "thig5.8:4.4": "anupādāya nibbutā. ",
  "thig5.8:5.1": "pañcakkhandhā pariññātā ",
  "thig5.8:5.2": "tiṭṭhanti chinnamūlakā, ",
  "thig5.8:5.3": "dhī tavatthu jare chamme ",
  "thig5.8:5.4": "natthi dāni punabbhavoti. itthaṃ sudaṃ ",
  "thig5.8:6.1": "soṇā therī gāthāyo abhāsitthāti. "
}
