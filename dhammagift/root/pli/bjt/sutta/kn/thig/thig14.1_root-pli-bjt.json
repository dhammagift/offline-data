{
  "thig14.1:0.1": "30. tiṃsatinipāto. ",
  "thig14.1:0.2": "",
  "thig14.1:0.3": "30. 1. ",
  "thig14.1:1.1": "jīvakambavanaṃ rammaṃ ",
  "thig14.1:1.2": "gacchantiṃ bhikkhuniṃ subhaṃ, ",
  "thig14.1:1.3": "dhuttako sannivāresi ",
  "thig14.1:1.4": "tamenaṃ abravī subhā. ",
  "thig14.1:2.1": "kiṃ te aparādhitaṃ mayā ",
  "thig14.1:2.2": "yaṃ maṃ ovariyāna tiṭṭhasi, ",
  "thig14.1:2.3": "na hi pabbajitāya āvuso ",
  "thig14.1:2.4": "puriso samphusanāya kappati. ",
  "thig14.1:3.1": "garuke mama satthusāsane ",
  "thig14.1:3.2": "yā sikkhā sugatena desitā, ",
  "thig14.1:3.3": "parisuddhapadaṃ anaṅgaṇaṃ ",
  "thig14.1:3.4": "kiṃ maṃ ovariyāna tiṭṭhasi. ",
  "thig14.1:4.1": "āvilacitto anāvilaṃ ",
  "thig14.1:4.2": "sarajo vītarajaṃ anaṅgaṇaṃ, ",
  "thig14.1:4.3": "sabbattha vimuttamānasaṃ ",
  "thig14.1:4.4": "kiṃ maṃ ovariyāna tiṭṭhasi. ",
  "thig14.1:5.1": "daharā ca apāpikā casi ",
  "thig14.1:5.2": "kiṃ te pabbajjā karissati, ",
  "thig14.1:5.3": "nikkhipa kāsāya cīvaraṃ ",
  "thig14.1:5.4": "ehi ramāmase pupphite vane. ",
  "thig14.1:6.1": "madhurañca pavanti sabbaso ",
  "thig14.1:6.2": "kusumarajena samuṭṭhitā dumā, ",
  "thig14.1:6.3": "paṭhamavasanto sukho utu ",
  "thig14.1:6.4": "ehi ramāmase pupphite vane. ",
  "thig14.1:7.1": "kusumitasikharāva pādapā ",
  "thig14.1:7.2": "abhigacchantiva māluteritā, ",
  "thig14.1:7.3": "kā tuyhaṃ rati bhavissati ",
  "thig14.1:7.4": "yadi ekā vanamotarissasi. ",
  "thig14.1:8.1": "vāḷamigasaṅghasevitaṃ ",
  "thig14.1:8.2": "kuñjaramattakareṇulolitaṃ, ",
  "thig14.1:8.3": "asahāyikā gantumicchasi ",
  "thig14.1:8.4": "rahitaṃ bhiṃsanakaṃ mahāvanaṃ. ",
  "thig14.1:9.1": "tapanīyakatāva dhītikā ",
  "thig14.1:9.2": "vicarasi cittaratheva accharā, ",
  "thig14.1:9.3": "kāsikasukhumehi vagguhi ",
  "thig14.1:9.4": "sobhasi vasanehi nūpame. ",
  "thig14.1:10.1": "ahaṃ tava vasānugo siyaṃ ",
  "thig14.1:10.2": "yadi viharemase kānanantare, ",
  "thig14.1:10.3": "na hi catthi tayā piyataro ",
  "thig14.1:10.4": "pāṇo kinnarimandalocane. ",
  "thig14.1:11.1": "yadi me vacanaṃ karissasi ",
  "thig14.1:11.2": "sukhitā ehi agāramāvasa, ",
  "thig14.1:11.3": "pāsādanivātavāsinī ",
  "thig14.1:11.4": "parikammaṃ te karonti nāriyo, ",
  "thig14.1:12.1": "kāsikasukhumāsi dhāraya ",
  "thig14.1:12.2": "abhirohehi ca mālavaṇṇakaṃ, ",
  "thig14.1:12.3": "kañcanamaṇimuttakaṃ bahuṃ ",
  "thig14.1:12.4": "vividhaṃ ābharaṇaṃ karomi te. ",
  "thig14.1:13.1": "sudhotarajapacchadaṃ subhaṃ ",
  "thig14.1:13.2": "goṇakatūlita santhataṃ navaṃ, ",
  "thig14.1:13.3": "abhiruha sayanaṃ mahārahaṃ ",
  "thig14.1:13.4": "candanamaṇḍita sāragandhikaṃ. ",
  "thig14.1:14.1": "uppalañca udakato uggataṃ ",
  "thig14.1:14.2": "yathā taṃ amanussa sevitaṃ, ",
  "thig14.1:14.3": "evaṃ tuvaṃ brahmacārinī ",
  "thig14.1:14.4": "sakesu aṅgesu jaraṃ gamissasi. ",
  "thig14.1:15.1": "kiṃ te idha sārasammataṃ ",
  "thig14.1:15.2": "kuṇapapūramhi susānavaḍḍhane ",
  "thig14.1:15.3": "bhedanadhamme kalebare ",
  "thig14.1:15.4": "yaṃ disvā vimano udikkhasi. ",
  "thig14.1:16.1": "akkhīni ca turiyāriva ",
  "thig14.1:16.2": "kinnariyāriva pabbatantare ",
  "thig14.1:16.3": "tava me nayanānudikkhiya ",
  "thig14.1:16.4": "bhiyyo kāmaratī pavaḍḍhati. ",
  "thig14.1:17.1": "uppalasikharoparāni te ",
  "thig14.1:17.2": "vimale hāṭakasannibhe mukhe ",
  "thig14.1:17.3": "tava me nayanānudikkhiya ",
  "thig14.1:17.4": "bhiyyo kāmaguṇo pavaḍḍhati. ",
  "thig14.1:18.1": "api dūragatā saramhase ",
  "thig14.1:18.2": "āyatapamhe visuddhadassane ",
  "thig14.1:18.3": "na hi catthi tayā piyataro ",
  "thig14.1:18.4": "nayanā kinnarimandalocane. ",
  "thig14.1:19.1": "apathena payātumicchasi ",
  "thig14.1:19.2": "candaṃ kīḷanakaṃ gavessasi ",
  "thig14.1:19.3": "meruṃ laṅghetumicchasi ",
  "thig14.1:19.4": "yo tvaṃ buddhasutaṃ maggayase. ",
  "thig14.1:20.1": "natthi loke sadevake ",
  "thig14.1:20.2": "rāgo yattha’pi’dāni me siyā ",
  "thig14.1:20.3": "napi naṃ jānāmi kīriso ",
  "thig14.1:20.4": "atha maggena hato samūlako. ",
  "thig14.1:21.1": "iṅgālakuyāva ujjhito ",
  "thig14.1:21.2": "visapattoriva aggato kato ",
  "thig14.1:21.3": "napi naṃ passāmi kīriso ",
  "thig14.1:21.4": "atha maggena hato samūlako, ",
  "thig14.1:22.1": "yassā siyā apaccavekkhitaṃ ",
  "thig14.1:22.2": "satthā vā anupāsito siyā, ",
  "thig14.1:22.3": "tvaṃ tādisikaṃ palohaya ",
  "thig14.1:22.4": "jānantiṃ so imaṃ vihaññasi. ",
  "thig14.1:23.1": "mayhaṃ hi akkuṭṭhavandite ",
  "thig14.1:23.2": "sukhadukkhe ca sati upaṭṭhitā, ",
  "thig14.1:23.3": "saṅkhatamasubhanti jāniya ",
  "thig14.1:23.4": "sabbattheva mano na lippati. ",
  "thig14.1:24.1": "sāhaṃ sugatassa sāvikā ",
  "thig14.1:24.2": "maggaṭṭhaṅgikayānayāyinī, ",
  "thig14.1:24.3": "uddhaṭasallā anāsavā ",
  "thig14.1:24.4": "suññāgāragatā ramāmahaṃ. ",
  "thig14.1:25.1": "diṭṭhā hi mayā sucittitā ",
  "thig14.1:25.2": "sombhā dārukapillakāni vā ",
  "thig14.1:25.3": "tantīhi ca khīlakehi ca ",
  "thig14.1:25.4": "vinibaddhā vividhaṃ panaccakā. ",
  "thig14.1:26.1": "tamhuddhaṭe tantikhīlake ",
  "thig14.1:26.2": "vissaṭṭhe vikale paripakkhite ",
  "thig14.1:26.3": "avinde khaṇḍaso kate ",
  "thig14.1:26.4": "kimhi tattha manaṃ nivesaye. ",
  "thig14.1:27.1": "tathūpamā dehakāni maṃ ",
  "thig14.1:27.2": "tehi dhammehi vinā na vattanti, ",
  "thig14.1:27.3": "dhammehi vinā na vattati ",
  "thig14.1:27.4": "kimhi tattha manaṃ nivesaye. ",
  "thig14.1:28.1": "yathā haritālena makkhitaṃ ",
  "thig14.1:28.2": "addasa cittikaṃ bhittiyā kataṃ, ",
  "thig14.1:28.3": "tamhi te viparīta dassanaṃ ",
  "thig14.1:28.4": "saññā mānusikā niratthikā. ",
  "thig14.1:29.1": "māyaṃ viya aggato kataṃ ",
  "thig14.1:29.2": "supinanteva suvaṇṇapādapaṃ, ",
  "thig14.1:29.3": "upagacchasi andharittakaṃ ",
  "thig14.1:29.4": "janamajjheriva rupparūpakaṃ, ",
  "thig14.1:30.1": "vaṭṭaniriva koṭarohitā ",
  "thig14.1:30.2": "majjhe bubbulakā saassukā ",
  "thig14.1:30.3": "piḷakoḷikā ettha jāyati ",
  "thig14.1:30.4": "vividhā cakkhuvidhā ca piṇḍitā. ",
  "thig14.1:31.1": "uppāṭiya cārudassanā ",
  "thig14.1:31.2": "na ca pajjittha asaṅgamānasā, ",
  "thig14.1:31.3": "handa te cakkhuṃ harassu taṃ ",
  "thig14.1:31.4": "tassa narassa adāsi tāvade. ",
  "thig14.1:32.1": "tassa ca viramāsi tāvade ",
  "thig14.1:32.2": "rāgo tattha khamāpayī ca naṃ, ",
  "thig14.1:32.3": "sotthi siyā brahmacārinī ",
  "thig14.1:32.4": "na puno edisakaṃ bhavissasi, ",
  "thig14.1:33.1": "āsādiya edisaṃ janaṃ ",
  "thig14.1:33.2": "aggiṃ pajjalitaṃ va liṅgiya, ",
  "thig14.1:33.3": "gaṇhiya āsivisaṃ viya ",
  "thig14.1:33.4": "api nu sotthi siyā khamehi no. ",
  "thig14.1:34.1": "muttā ca tato sā bhikkhuṇī ",
  "thig14.1:34.2": "agamī buddhavarassa santikaṃ, ",
  "thig14.1:34.3": "passiya varapuññalakkhaṇaṃ ",
  "thig14.1:34.4": "cakkhu āsi yathā purāṇakanti. itthaṃ sudaṃ ",
  "thig14.1:35.1": "subhā jīvakambavanikā therī ",
  "thig14.1:36.1": "gāthāyo abhāsīti. jīvakambavanikasubhātherīgāthā. tiṃsati nipāto niṭṭhito. "
}
