{
  "thig5.7:0.1": "",
  "thig5.7:0.2": "",
  "thig5.7:0.3": "5. 7. mittākāḷitherīgāthā. ",
  "thig5.7:1.1": "agārasmiṃ vasantīhaṃ ",
  "thig5.7:1.2": "dhammaṃ sutvāna bhikkhuno, ",
  "thig5.7:1.3": "addasaṃ virajaṃ dhammaṃ ",
  "thig5.7:1.4": "nibbānaṃ padamaccutaṃ. ",
  "thig5.7:2.1": "sāhaṃ puttaṃ dhītarañca ",
  "thig5.7:2.2": "dhanadhaññañca chaḍḍiya ",
  "thig5.7:2.3": "kese chedāpayitvāna ",
  "thig5.7:2.4": "pabbajiṃ anagāriyaṃ. ",
  "thig5.7:3.1": "sikkhamānā ahaṃ santī ",
  "thig5.7:3.2": "bhāventī maggamañjasaṃ, ",
  "thig5.7:3.3": "pahāsiṃ rāgadosañca ",
  "thig5.7:3.4": "tadekaṭṭhe ca āsave. ",
  "thig5.7:4.1": "bhikkhunī upasampajja ",
  "thig5.7:4.2": "pubbe ",
  "thig5.7:4.3": "jātimanussariṃ visodhitaṃ dibbacakkhuṃ ",
  "thig5.7:4.4": "vimalaṃ sādhubhāvitaṃ. ",
  "thig5.7:5.1": "saṅkhāre parato disvā ",
  "thig5.7:5.2": "hetujāte palokite ",
  "thig5.7:5.3": "pahāsiṃ āsave sabbe ",
  "thig5.7:5.4": "sītibhūtāmhi nibbutāti. itthaṃ sudaṃ ",
  "thig5.7:6.1": "sakulā therī gāthāyo abhāsitthāti. "
}
