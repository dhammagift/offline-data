{
  "thig2.1:0.1": "2. dukanipāto. ",
  "thig2.1:0.2": "",
  "thig2.1:0.3": "2. 1. ",
  "thig2.1:1.1": "āturaṃ asuciṃ pūtiṃ ",
  "thig2.1:1.2": "passa nande samussayaṃ, ",
  "thig2.1:1.3": "asubhāya cittaṃ bhāvehi ",
  "thig2.1:1.4": "ekaggaṃ susamāhitaṃ. ",
  "thig2.1:2.1": "animittañca bhāvehi ",
  "thig2.1:2.2": "mānānusayamujjaha, ",
  "thig2.1:2.3": "tato mānābhisamayā ",
  "thig2.1:2.4": "upasantā carissasīti. ",
  "thig2.1:3.1": "itthaṃ sudaṃ bhagavā abharūpanandaṃ sikkhamānaṃ imāhi gāthāhi abhiṇhaṃ ovadatīti. abhirūpanandātherīgāthā. "
}
