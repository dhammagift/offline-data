{
  "thig2.8:0.1": "",
  "thig2.8:0.2": "",
  "thig2.8:0.3": "2. 8. ",
  "thig2.8:1.1": "uddhaṃ pādatalā amma ",
  "thig2.8:1.2": "adho ve kesamatthakā, ",
  "thig2.8:1.3": "paccavekkhassu’maṃ kāyaṃ ",
  "thig2.8:1.4": "asuci pūtigandhikaṃ. ",
  "thig2.8:2.1": "evaṃ viharamānāya ",
  "thig2.8:2.2": "sabbo rāgo samūhato, ",
  "thig2.8:2.3": "pariḷāho samucchinno ",
  "thig2.8:2.4": "sītibhūtāmhi nibbutāti. itthaṃ sudaṃ ",
  "thig2.8:3.1": "abhayamātā therī gāthāyo abhāsitthā’ti. abhayamātātherīgāthā. "
}
