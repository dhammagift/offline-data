  "thig1.11:0.1": "",
  "thig1.11:0.2": "",
  "thig1.11:0.3": "1. 11. ",
  "thig1.11:1.1": "sumuttā sādhu muttāmhi ",
  "thig1.11:1.2": "tīhi khujjehi muttiyā, ",
  "thig1.11:1.3": "udukkhalena musalena ",
  "thig1.11:1.4": "patinā khujjakena ca, ",
  "thig1.11:1.5": "muttāmhi jātimaraṇā ",
  "thig1.11:1.6": "bhavanetti samūhatāti. ",
  "thig1.11:2.1": "itthaṃ sudaṃ muttātherī gāthaṃ abhāsitthā’ti. muttātherīgāthā. "
}
