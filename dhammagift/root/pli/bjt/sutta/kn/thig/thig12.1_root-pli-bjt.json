{
  "thig12.1:0.1": "16. soḷasanipāto. ",
  "thig12.1:0.2": "",
  "thig12.1:0.3": "16. 1. ",
  "thig12.1:1.1": "udakamāhariṃ sīte ",
  "thig12.1:1.2": "sadā udakamotariṃ, ",
  "thig12.1:1.3": "ayyānaṃ daṇḍabhayabhītā ",
  "thig12.1:1.4": "vācādosabhayaṭṭitā. ",
  "thig12.1:2.1": "kassa brāhmaṇa tvaṃ bhīto ",
  "thig12.1:2.2": "sadā udakamotari, ",
  "thig12.1:2.3": "vedhamānehi gattehi ",
  "thig12.1:2.4": "sītaṃ vedayase bhusaṃ. ",
  "thig12.1:3.1": "jānantī vata maṃ hoti ",
  "thig12.1:3.2": "puṇṇike paripucchasi, ",
  "thig12.1:3.3": "karontaṃ kusalaṃ kammaṃ ",
  "thig12.1:3.4": "rundhantaṃ kata pāpakaṃ. ",
  "thig12.1:4.1": "yo ca vuddho daharo vā ",
  "thig12.1:4.2": "pāpakammaṃ pakubbatī, ",
  "thig12.1:4.3": "dakābhisecanā sopi ",
  "thig12.1:4.4": "pāpakammā pamuccati. ",
  "thig12.1:5.1": "konu te idamakkhāsi ",
  "thig12.1:5.2": "ajānantassa ajānako, ",
  "thig12.1:5.3": "dakābhisecanā nāma ",
  "thig12.1:5.4": "pāpakammā pamuccati. ",
  "thig12.1:6.1": "saggaṃ nūna gamissanti ",
  "thig12.1:6.2": "sabbe maṇḍukakacchapā, ",
  "thig12.1:6.3": "nakkā ca suṃsumārā ca ",
  "thig12.1:6.4": "ye caññe udake carā. ",
  "thig12.1:7.1": "orabbhikā sūkarikā ",
  "thig12.1:7.2": "macchakā migabandhakā, ",
  "thig12.1:7.3": "corā ca vajjhaghātā ca ",
  "thig12.1:7.4": "yecaññepāpakammino, ",
  "thig12.1:7.5": "dakābhisecanā tepi ",
  "thig12.1:7.6": "pāpakammā pamuccare. ",
  "thig12.1:8.1": "sace imā nadiyo te ",
  "thig12.1:8.2": "pāpaṃ pubbe kataṃ vahuṃ, ",
  "thig12.1:8.3": "puññānimāni vaheyyuṃ ",
  "thig12.1:8.4": "tena tvaṃ paribāhiro. ",
  "thig12.1:9.1": "yassa brāhmaṇa tvaṃ bhīto ",
  "thig12.1:9.2": "sadā udakamotari, ",
  "thig12.1:9.3": "tameva brahme mākāsi ",
  "thig12.1:9.4": "mā te sītaṃ chaviṃ hanī. kummaggaṃ ",
  "thig12.1:10.1": "paṭipannaṃ maṃ ",
  "thig12.1:10.2": "ariyamaggaṃ samānayi, ",
  "thig12.1:10.3": "udakābhisecanā bhoti ",
  "thig12.1:10.4": "imaṃ sāṭaṃ dadāmi te. ",
  "thig12.1:11.1": "tuyheva sāṭako hotu ",
  "thig12.1:11.2": "nāhaṃ icchāmi sāṭakaṃ, ",
  "thig12.1:11.3": "sace bhāyasi dukkhassa ",
  "thig12.1:11.4": "sace te dukkhamappiyaṃ. ",
  "thig12.1:12.1": "mākāsi pāpakaṃ kammaṃ ",
  "thig12.1:12.2": "āvī vā yadi vā raho, ",
  "thig12.1:12.3": "sace ca pāpakaṃ kammaṃ ",
  "thig12.1:12.4": "karissasi karosi vā. ",
  "thig12.1:13.1": "na te dukkhā pamuttyatthi ",
  "thig12.1:13.2": "upeccāpi palāyato, ",
  "thig12.1:13.3": "sace bhāsasi dukkhassa ",
  "thig12.1:13.4": "sace te dukkhamappiyaṃ. ",
  "thig12.1:14.1": "upehi saraṇaṃ buddhaṃ ",
  "thig12.1:14.2": "dhammaṃ saṅghañca tādinaṃ, ",
  "thig12.1:14.3": "samādiyāhi sīlāni ",
  "thig12.1:14.4": "taṃ te atthāya hehiti. ",
  "thig12.1:15.1": "upemi saraṇaṃ buddhaṃ ",
  "thig12.1:15.2": "dhammaṃ saṅghañca tādinaṃ, ",
  "thig12.1:15.3": "samādiyāmi sīlāni ",
  "thig12.1:15.4": "tamme atthāya hehiti. ",
  "thig12.1:16.1": "brahmabandhu pure āsiṃ ",
  "thig12.1:16.2": "ajjamhi sacca brāhmaṇo, ",
  "thig12.1:16.3": "tevijjo vedasampanno ",
  "thig12.1:16.4": "sotthiyo camhi nahātakoti. itthaṃ sudaṃ ",
  "thig12.1:17.1": "puṇṇā therī ",
  "thig12.1:18.1": "gāthāyo abhāsīti. puṇṇātherīgāthā. soḷasanipāto niṭṭhito. "
}
