  "thig1.7:0.3": "1. 7. ",
  "thig1.7:1.1": "vīrā vīrehi dhammehi ",
  "thig1.7:1.2": "bhikkhunī bhāvitindriyā, ",
  "thig1.7:1.3": "dhārehi antimaṃ dehaṃ ",
  "thig1.7:1.4": "chetvā māraṃ savāhininti. itthaṃ sudaṃ ",
  "thig1.7:2.1": "vīrā therī gāthaṃ abhāsitthā’ti. vīrātherīgāthā. "
}
