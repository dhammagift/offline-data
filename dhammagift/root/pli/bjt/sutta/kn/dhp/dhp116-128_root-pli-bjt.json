{
  "dhp116:0.1": "",
  "dhp116:0.2": "",
  "dhp116:0.3": "9. pāpavaggo ",
  "dhp116:0.4": "",
  "dhp116:1": "1.(116) abhittharetha kalyāṇe ",
  "dhp116:2": "pāpā cittaṃ nivāraye ",
  "dhp116:3": "dandhaṃ hi karoto puññaṃ ",
  "dhp116:4": "pāpasmiṃ ramatī mano. 2.(117) pāpaṃ ce ",
  "dhp117:0": "",
  "dhp117:1": "puriso kayirā ",
  "dhp117:2": "na taṃ kayirā punappunaṃ ",
  "dhp117:3": "na tamhi chandaṃ kayirātha ",
  "dhp117:4": "dukkho pāpassa uccayo. 3.(118) puññaṃ ce ",
  "dhp118:0": "",
  "dhp118:1": "puriso kayirā ",
  "dhp118:2": "kayirāthetaṃ punappunaṃ ",
  "dhp118:3": "tamhi chandaṃ kayirātha ",
  "dhp118:4": "sukho puññassa uccayo. 4.(119) ",
  "dhp119:0": "",
  "dhp119:1": "pāpo’pi passati bhadraṃ ",
  "dhp119:2": "yāva pāpaṃ na paccati ",
  "dhp119:3": "yadā ca paccati pāpaṃ ",
  "dhp119:4": "atha pāpo pāpāni passati. 5.(120) ",
  "dhp120:1": "bhadro’pi passati pāpaṃ ",
  "dhp120:2": "yāva bhadraṃ na paccati ",
  "dhp120:3": "yadā ca paccati bhadraṃ ",
  "dhp120:4": "atha bhadro bhadrāni passati. 6.(121) mā’pamaññetha ",
  "dhp121:0": "",
  "dhp121:1": "pāpassa ",
  "dhp121:2": "na mantaṃ āgamissati ",
  "dhp121:3": "udabindunipātena ",
  "dhp121:4": "udakumbho’pi pūrati pūrati ",
  "dhp121:5": "bālo pāpassa ",
  "dhp121:6": "thokathokampi ācinaṃ. 7.(122) mā’pamaññetha ",
  "dhp122:0": "",
  "dhp122:1": "puññassa ",
  "dhp122:2": "na maṃ taṃ āgamissati ",
  "dhp122:3": "udabindunipātena ",
  "dhp122:4": "udakumbho’pi pūrati. pūrati ",
  "dhp122:5": "dhīro puññassa ",
  "dhp122:6": "thokathokampi ācinaṃ. 8.(123) ",
  "dhp123:0": "",
  "dhp123:1": "vāṇijo’va bhayaṃ maggaṃ ",
  "dhp123:2": "appasattho mahaddhano ",
  "dhp123:3": "visaṃ jīvitukāmo’va ",
  "dhp123:4": "pāpāni parivajjaye. 9.(124) ",
  "dhp124:0": "",
  "dhp124:1": "pāṇimhi ce vaṇo nāssa ",
  "dhp124:2": "hareyya pāṇinā visaṃ ",
  "dhp124:3": "nābbaṇaṃ visamanveti ",
  "dhp124:4": "natthi pāpaṃ akubbato. 10.(125) ",
  "dhp125:0": "",
  "dhp125:1": "yo appaduṭṭhassa narassa dussati ",
  "dhp125:2": "suddhassa posassa anaṅgaṇassa ",
  "dhp125:3": "tameva bālaṃ pacceti pāpaṃ ",
  "dhp125:4": "sukhumo rajo paṭivātaṃ’va khitto. 11.(126) gabbhameke’papajjanti ",
  "dhp126:0": "",
  "dhp126:1": "",
  "dhp126:2": "nirayaṃ pāpakammino ",
  "dhp126:3": "saggaṃ sugatino yanti ",
  "dhp126:4": "parinibbanti anāsavā. 12.(127) ",
  "dhp127:0": "",
  "dhp127:1": "na antalikkhe na samuddamajjhe ",
  "dhp127:2": "na pabbatānaṃ vivaraṃ pavissa ",
  "dhp127:3": "na vijjatī so jagatippadeso ",
  "dhp127:4": "yatthaṭṭhito mucceyya pāpakammā. 13.(128) ",
  "dhp128:0": "",
  "dhp128:1": "na antalikkhe na samuddamajjhe ",
  "dhp128:2": "na pabbatānaṃ vivaraṃ pavissa ",
  "dhp128:3": "na vijjati so jagatippadeso ",
  "dhp128:4": "yatthaṭṭhitaṃ nappasahetha maccu. ",
  "dhp128:5": "pāpavaggo navamo. "
}
