{
  "dhp90:0.1": "",
  "dhp90:0.2": "",
  "dhp90:0.3": "",
  "dhp90:0.4": "",
  "dhp90:1": "gataddhino visokassa ",
  "dhp90:2": "vippamuttassa sabbadhi ",
  "dhp90:3": "sabbaganthappahīṇassa ",
  "dhp90:4": "pariḷāho na vijjati. 2.(91) ",
  "dhp91:0": "",
  "dhp91:1": "uyyuñjanti satimanto ",
  "dhp91:2": "na nikete ramanti te ",
  "dhp91:3": "haṃsā’va pallalaṃ hitvā ",
  "dhp91:4": "okamokaṃ jahanti te. 3.(92) ",
  "dhp92:0": "",
  "dhp92:1": "yesaṃ sannicayo natthi ",
  "dhp92:2": "ye pariññātabhojanā ",
  "dhp92:3": "suññato animitto ca ",
  "dhp92:4": "vimokkho yesa gocaro ",
  "dhp92:5": "ākāse’va sakuntānaṃ ",
  "dhp92:6": "gati tesaṃ durannayā. 4.(93) ",
  "dhp93:0": "",
  "dhp93:1": "yassāsavā parikkhīṇā ",
  "dhp93:2": "āhāre ca anissito ",
  "dhp93:3": "suññato animitto ca ",
  "dhp93:4": "vimokkho yassa gocaro ",
  "dhp93:5": "ākāse’va sakuntānaṃ ",
  "dhp93:6": "padaṃ tassa durannayaṃ. 5.(94) ",
  "dhp94:0": "",
  "dhp94:1": "yassindriyāni samathaṃ gatāni ",
  "dhp94:2": "assā yathā sārathinā sudantā ",
  "dhp94:3": "pahīṇamānassa anāsavassa ",
  "dhp94:4": "devā’pi tassa pihayanti tādino. 6.(95) ",
  "dhp95:0": "",
  "dhp95:1": "paṭhavisamo no virujjhati ",
  "dhp95:2": "indakhīlūpamo tādi subbato ",
  "dhp95:3": "rahado’va apetakaddamo ",
  "dhp95:4": "saṃsārā na bhavanti tādino. 7.(96) ",
  "dhp96:0": "",
  "dhp96:1": "santaṃ tassa manaṃ hoti ",
  "dhp96:2": "santā vācā ca kamma ca ",
  "dhp96:3": "sammadaññā vimuttassa ",
  "dhp96:4": "upasantassa tādino. 8.(97) ",
  "dhp97:0": "",
  "dhp97:1": "assaddho akataññū ca ",
  "dhp97:2": "sandhicchedo ca yo naro ",
  "dhp97:3": "hatāvakāso vantāso ",
  "dhp97:4": "sa ve uttamaporiso. 9.(98) ",
  "dhp98:0": "",
  "dhp98:1": "gāme vā yadi vā raññe ",
  "dhp98:2": "ninne vā yadi vā thale ",
  "dhp98:3": "yatthārahanto viharanti ",
  "dhp98:4": "taṃ bhūmiṃ rāmaṇeyyakaṃ. 10.(99) ",
  "dhp99:0": "",
  "dhp99:1": "ramaṇīyāni araññāni ",
  "dhp99:2": "yattha na ramatī jano ",
  "dhp99:3": "vītarāgā ramissanti ",
  "dhp99:4": "na te kāmagavesino. ",
  "dhp99:5": "arahantavaggo sattamo. 8. sahassavaggo 1.(100) sahassampi "
}
