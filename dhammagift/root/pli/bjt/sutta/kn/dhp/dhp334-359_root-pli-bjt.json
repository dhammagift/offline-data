{
  "dhp334:0.1": "",
  "dhp334:0.2": "",
  "dhp334:0.3": "",
  "dhp334:0.4": "",
  "dhp334:1": "manujassa pamattacārino ",
  "dhp334:2": "taṇhā vaḍḍhati māluvā viya ",
  "dhp334:3": "so plavati hurāhuraṃ phalamicchaṃ’ ",
  "dhp334:4": "va vanasmiṃ vānaro. 2.(335) ",
  "dhp335:1": "yaṃ esā sahatī jammī ",
  "dhp335:2": "taṇhā loke visattikā ",
  "dhp335:3": "sokā tassa pavaḍḍhanti ",
  "dhp335:4": "abhivaṭṭhaṃ’va bīraṇaṃ. 3.(336) ",
  "dhp336:1": "yo ce taṃ sahate jammiṃ ",
  "dhp336:2": "taṇhaṃ loke duraccayaṃ ",
  "dhp336:3": "sokā tamhā papatanti ",
  "dhp336:4": "udabindū’va pokkharā. 4.(337) ",
  "dhp337:1": "taṃ vo vadāmi bhaddaṃ vo ",
  "dhp337:2": "yāvantettha samāgatā ",
  "dhp337:3": "taṇhāya mūlaṃ khaṇatha ",
  "dhp337:4": "usīrattho’va bīraṇaṃ ",
  "dhp337:5": "mā vo nalaṃ’va soto’va ",
  "dhp337:6": "māro bhañji punappunaṃ. 5.(338) ",
  "dhp338:0": "",
  "dhp338:1": "yathāpi mūle anupaddave daḷhe ",
  "dhp338:2": "chinno’pi rukkho punareva rūhati ",
  "dhp338:3": "evampi taṇhānusaye anūhate ",
  "dhp338:4": "nibbattati dukkhamidaṃ punappunaṃ. 6.(339) ",
  "dhp339:1": "yassa chattiṃsati sotā ",
  "dhp339:2": "manāpassavanā bhusā ",
  "dhp339:3": "vāhā vahanti duddiṭṭhiṃ ",
  "dhp339:4": "saṅkappā rāganissitā. 7.(340) ",
  "dhp340:1": "savanti sabbadhi sotā ",
  "dhp340:2": "latā uppajja tiṭṭhati ",
  "dhp340:3": "tañca disvā lataṃ jātaṃ ",
  "dhp340:4": "mūlaṃ paññāya chindatha. 8.(341) ",
  "dhp341:1": "saritāni sinehitāni ca ",
  "dhp341:2": "somanassāni bhavanti jantuno ",
  "dhp341:3": "te sātasitā sukhesino ",
  "dhp341:4": "te ve jātijarūpagā narā. 9.(342) ",
  "dhp342:1": "tasiṇāya purakkhatā pajā ",
  "dhp342:2": "parisappanti saso’va bādhito ",
  "dhp342:3": "saṃyojanasaṅgasattā ",
  "dhp342:4": "dukkhamupenti punappunaṃ cirāya. 10.(343) ",
  "dhp343:1": "tasiṇāya purakkhatā pajā ",
  "dhp343:2": "parisappanti saso’va bādhito ",
  "dhp343:3": "tasmā tasiṇaṃ vinodaye ",
  "dhp343:4": "bhikkhu ākaṅkhī virāgamattano. 11.(344) ",
  "dhp344:0": "",
  "dhp344:1": "yo nibbanatho vanādhimutto ",
  "dhp344:2": "vanamutto vanameva dhāvati ",
  "dhp344:3": "taṃ puggalametha passatha ",
  "dhp344:4": "mutto bandhanameva dhāvati. 12.(345) ",
  "dhp345:0": "",
  "dhp345:1": "na taṃ daḷhaṃ bandhanamāhu dhīrā ",
  "dhp345:2": "yadāyasaṃ dārujaṃ babbajañca. ",
  "dhp345:3": "sārattarattā maṇikuṇḍalesu ",
  "dhp345:4": "puttesu dāresu ca yā apekhā. , 13.(346) ",
  "dhp346:1": "etaṃ daḷhaṃ bandhanamāhu dhīrā ",
  "dhp346:2": "ohārinaṃ sithilaṃ duppamuñcaṃ ",
  "dhp346:3": "etampi chetvāna paribbajanti ",
  "dhp346:4": "anapekkhino kāmasukhaṃ pahāya. , 14.(347) ",
  "dhp347:0": "",
  "dhp347:1": "ye rāgarattānupatanti sotaṃ ",
  "dhp347:2": "sayaṃ kataṃ makkaṭako’va jālaṃ ",
  "dhp347:3": "etampi chetvāna vajanti dhīrā ",
  "dhp347:4": "anapekkhino sabbadukkhaṃ pahāya. 15.(348) ",
  "dhp348:0": "",
  "dhp348:1": "muñca pure muñca pacchato ",
  "dhp348:2": "majjhe muñca bhavassa pāragū ",
  "dhp348:3": "sabbattha vimuttamānaso ",
  "dhp348:4": "na punaṃ jātijaraṃ upehisi. 16.(349) vitakkapamathitassa ",
  "dhp349:0": "",
  "dhp349:1": "jantuno ",
  "dhp349:2": "tibbarāgassa subhānupassino ",
  "dhp349:3": "bhiyyo taṇhā pavaḍḍhati ",
  "dhp349:4": "esa kho daḷhaṃ karoti bandhanaṃ. 17.(350) ",
  "dhp350:1": "vitakkūpasame ca yo rato ",
  "dhp350:2": "asubhaṃ bhāvayati sadā sato ",
  "dhp350:3": "esa kho vyantikāhiti ",
  "dhp350:4": "esa checchati mārabandhanaṃ. 18.(351) niṭṭhaṃ gato ",
  "dhp351:0": "",
  "dhp351:1": "asantāsī ",
  "dhp351:2": "vītataṇho anaṅgaṇo ",
  "dhp351:3": "acchindi bhavasallāni ",
  "dhp351:4": "antimo’yaṃ samussayo. 19.(352) ",
  "dhp352:1": "vītataṇho anādāno ",
  "dhp352:2": "niruttipadakovido ",
  "dhp352:3": "akkharānaṃ sannipātaṃ ",
  "dhp352:4": "jaññā pubbāparāni ca ",
  "dhp352:5": "sa ve antimasārīro ",
  "dhp352:6": "mahāpañño mahāpuriso’ti vuccati. 20.(353) ",
  "dhp353:0": "",
  "dhp353:1": "sabbābhibhū sabbavidū’hamasmi ",
  "dhp353:2": "sabbesu dhammesu anūpalitto ",
  "dhp353:3": "sabbañjaho taṇhakkhaye vimutto ",
  "dhp353:4": "sayaṃ abhiññāya kamuddiseyyaṃ. 21.(354) ",
  "dhp354:0": "",
  "dhp354:1": "sabbadānaṃ dhammadānaṃ jināti ",
  "dhp354:2": "sabbaṃ rasaṃ dhammaraso jināti ",
  "dhp354:3": "sabbaṃ ratiṃ dhammaratī jināti ",
  "dhp354:4": "taṇhakkhayo sabbadukkhaṃ jināti. 22.(355) ",
  "dhp355:0": "",
  "dhp355:1": "hananti bhogā dummedhaṃ ",
  "dhp355:2": "no ve pāragavesino ",
  "dhp355:3": "bhogataṇhāya dummedho ",
  "dhp355:4": "hanti aññe’va attanā. 23.(356) ",
  "dhp356:0": "",
  "dhp356:1": "tiṇadosāni khettāni ",
  "dhp356:2": "rāgadosā ayaṃ pajā ",
  "dhp356:3": "tasmā hi vītarāgesu ",
  "dhp356:4": "dinnaṃ hoti mahapphalaṃ. 24.(357) ",
  "dhp357:1": "tiṇadosāni khettāni ",
  "dhp357:2": "dosadosā ayaṃ pajā ",
  "dhp357:3": "tasmā hi vītadosesu ",
  "dhp357:4": "dinnaṃ hoti mahapphalaṃ. 25.(358) ",
  "dhp358:1": "tiṇadosāni khettāni ",
  "dhp358:2": "mohadosā ayaṃ pajā ",
  "dhp358:3": "tasmā hi vītamohesu ",
  "dhp358:4": "dinnaṃ hoti mahapphalaṃ. 26.(359) ",
  "dhp359:1": "tiṇadosāni khettāni ",
  "dhp359:2": "icchādosā ayaṃ pajā. ",
  "dhp359:3": "tasmā hi vigaticchesu ",
  "dhp359:4": "dinnaṃ hoti mahapphalaṃ. ",
  "dhp359:5": "taṇhāvaggo catuvīsatimo. 25. bhikkhuvaggo. 1.(360) "
}
