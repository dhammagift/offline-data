{
  "dhp129:0.1": "",
  "dhp129:0.2": "",
  "dhp129:0.3": "10. daṇḍavaggo ",
  "dhp129:0.4": "",
  "dhp129:1": "1.(129) sabbe tasanti daṇḍassa ",
  "dhp129:2": "sabbe bhāyanti maccuno ",
  "dhp129:3": "attānaṃ upamaṃ katvā ",
  "dhp129:4": "na haneyya na ghātaye. 2.(130) ",
  "dhp130:0": "",
  "dhp130:1": "sabbe tasanti daṇḍassa ",
  "dhp130:2": "sabbesaṃ jīvitaṃ piyaṃ. ",
  "dhp130:3": "attānaṃ upamaṃ katvā ",
  "dhp130:4": "na haneyya na ghātaye. 3.(131) ",
  "dhp131:0": "",
  "dhp131:1": "sukhakāmāni bhūtāni ",
  "dhp131:2": "yo daṇḍena vihiṃsati ",
  "dhp131:3": "attano sukhamesāno ",
  "dhp131:4": "pecca so na labhate sukhaṃ. 4.(132) ",
  "dhp132:1": "sukhakāmāni bhūtāni ",
  "dhp132:2": "yo daṇḍena na hiṃsati ",
  "dhp132:3": "attano sukhamesāno ",
  "dhp132:4": "pecca so labhate sukhaṃ. 5.(133) ",
  "dhp133:0": "",
  "dhp133:1": "mā’voca pharusaṃ kañci ",
  "dhp133:2": "vuttā paṭivadeyyu taṃ ",
  "dhp133:3": "dukkhā hi sārambhakathā ",
  "dhp133:4": "paṭidaṇḍā phuseyyu taṃ. 6.(134) sa ce ",
  "dhp134:1": "neresi attānaṃ ",
  "dhp134:2": "kaṃso upahato yathā ",
  "dhp134:3": "esa patto’si nibbānaṃ ",
  "dhp134:4": "sārambho te na vijjati. 7.(135) ",
  "dhp135:0": "",
  "dhp135:1": "yathā daṇḍena gopālo ",
  "dhp135:2": "gāvo pāceti gocaraṃ ",
  "dhp135:3": "evaṃ jarā ca maccu ca ",
  "dhp135:4": "āyuṃ pācenti pāṇinaṃ. 8.(136) ",
  "dhp136:0": "",
  "dhp136:1": "atha pāpāni kammāni ",
  "dhp136:2": "karaṃ bālo na bujjhati ",
  "dhp136:3": "sehi kammehi dummedho ",
  "dhp136:4": "aggidaḍḍho’va tappati. 9.(137) ",
  "dhp137:0": "",
  "dhp137:1": "yo daṇḍena adaṇḍesu ",
  "dhp137:2": "appaduṭṭhesu dussati ",
  "dhp137:3": "dasannamaññataraṃ ṭhānaṃ ",
  "dhp137:4": "khippameva nigacchati. 10.(138) ",
  "dhp138:1": "vedanaṃ pharusaṃ jāniṃ ",
  "dhp138:2": "sarīrassa ca bhedanaṃ ",
  "dhp138:3": "garukaṃ vāpi ābādhaṃ ",
  "dhp138:4": "cittakkhepaṃ va pāpuṇe. 11.(139) ",
  "dhp139:1": "rājato vā upassaggaṃ ",
  "dhp139:2": "abbhakkhānaṃ va dāruṇaṃ ",
  "dhp139:3": "parikkhayaṃ va ñātīnaṃ ",
  "dhp139:4": "bhogānaṃ va pabhaṅguraṃ. 12.(140) ",
  "dhp140:1": "atha vāssa agārāni ",
  "dhp140:2": "aggi ḍahati pāvako ",
  "dhp140:3": "kāyassa bhedā duppañño ",
  "dhp140:4": "nirayaṃ so upapajjati. 13.(141) ",
  "dhp141:0": "",
  "dhp141:1": "na naggacariyā na jaṭā na paṅkā ",
  "dhp141:2": "nānāsakā thaṇḍilasāyikā vā ",
  "dhp141:3": "rājo ca jallaṃ ukkuṭikappadhānaṃ ",
  "dhp141:4": "sodhenti maccaṃ avitiṇṇakaṅkhaṃ. 14.(142) ",
  "dhp142:0": "",
  "dhp142:1": "alaṅkato ce’pi samaṃ careyya ",
  "dhp142:2": "santo danto niyato brahmacārī ",
  "dhp142:3": "sabbesu bhūtesu nidhāya daṇḍaṃ ",
  "dhp142:4": "so brāhmaṇo so samaṇo sa bhikkhu. 15.(143) ",
  "dhp143:0": "",
  "dhp143:1": "hirīnisedho puriso ",
  "dhp143:2": "koci lokasmi vijjati ",
  "dhp143:3": "yo nindaṃ apabodhati ",
  "dhp143:4": "asso bhadro kasāmiva. 16.(144) ",
  "dhp144:1": "asso yathā bhadro kasāniviṭṭho ",
  "dhp144:2": "ātāpino saṃvegino bhavātha ",
  "dhp144:3": "saddhāya sīlena ca viriyena ca ",
  "dhp144:4": "samādhinā dhammavinicchayena ca ",
  "dhp144:5": "sampannavijjācaraṇā patissatā ",
  "dhp144:6": "pahassatha dukkhamidaṃ anappakaṃ. 17.(145) udakaṃ hi ",
  "dhp145:0": "",
  "dhp145:1": "nayanti nettikā ",
  "dhp145:2": "usukārā namayanti tejanaṃ ",
  "dhp145:3": "dāruṃ namayanti tacchakā ",
  "dhp145:4": "attānaṃ damayanti subbatā. ",
  "dhp145:5": "daṇḍavaggo dasamo. "
}
