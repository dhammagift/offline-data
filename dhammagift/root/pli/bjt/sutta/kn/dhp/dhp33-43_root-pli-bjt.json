{
  "dhp33:0.1": "",
  "dhp33:0.2": "",
  "dhp33:0.3": "",
  "dhp33:0.4": "",
  "dhp33:1": "phandanaṃ capalaṃ cittaṃ ",
  "dhp33:2": "durakkhaṃ dunnivārayaṃ ",
  "dhp33:3": "ujuṃ karoti medhāvī ",
  "dhp33:4": "usukāro’va tejanaṃ. 2.(34) ",
  "dhp34:1": "vārijo’va thale khitto ",
  "dhp34:2": "okamokata ubbhato ",
  "dhp34:3": "pariphandatidaṃ cittaṃ ",
  "dhp34:4": "māradheyyaṃ pahātave. 3.(35) ",
  "dhp35:0": "",
  "dhp35:1": "dunniggahassa lahuno ",
  "dhp35:2": "yatthakāmanipātino ",
  "dhp35:3": "cittassa damatho sādhu ",
  "dhp35:4": "cittaṃ dantaṃ sukhāvahaṃ. 4.(36) ",
  "dhp36:0": "",
  "dhp36:1": "sududdasaṃ sunipunaṃ ",
  "dhp36:2": "yatthakāmanipātinaṃ ",
  "dhp36:3": "cittaṃ rakkhetha medhāvī ",
  "dhp36:4": "cittaṃ guttaṃ sukhāvahaṃ. 5.(37) ",
  "dhp37:0": "",
  "dhp37:1": "dūraṅgamaṃ ekacaraṃ ",
  "dhp37:2": "asarīraṃ guhāsayaṃ ",
  "dhp37:3": "ye cittaṃ saññamessanti ",
  "dhp37:4": "mokkhanti mārabandhanā. 6.(38) ",
  "dhp38:0": "",
  "dhp38:1": "anavaṭṭhitacittassa ",
  "dhp38:2": "saddhammaṃ avijānato ",
  "dhp38:3": "pariplavapasādassa ",
  "dhp38:4": "paññā na paripūrati. 7.(39) ",
  "dhp39:1": "anavassutacittassa ",
  "dhp39:2": "ananvāhatacetaso ",
  "dhp39:3": "puññapāpapahīṇassa ",
  "dhp39:4": "natthi jāgarato bhayaṃ. 8.(40) ",
  "dhp40:0": "",
  "dhp40:1": "kumbhūpamaṃ kāyamimaṃ viditvā ",
  "dhp40:2": "nagarūpamaṃ cittamidaṃ ṭhapetvā. ",
  "dhp40:3": "yodhetha māraṃ paññāyudhena ",
  "dhp40:4": "jitañca rakkhe anivesano siyā. 9.(41) ",
  "dhp41:0": "",
  "dhp41:1": "aciraṃ vatayaṃ kāyo ",
  "dhp41:2": "paṭhaviṃ adhisessati ",
  "dhp41:3": "chuddho apetaviññāṇo ",
  "dhp41:4": "niratthaṃ’va kaliṅgaraṃ. 10.(42) ",
  "dhp42:0": "",
  "dhp42:1": "diso disaṃ yantaṃ kayirā ",
  "dhp42:2": "verī vā pana verinaṃ ",
  "dhp42:3": "micchāpaṇihitaṃ cittaṃ ",
  "dhp42:4": "pāpiyo na tato kare. 11.(43) ",
  "dhp43:0": "",
  "dhp43:1": "na taṃ mātā pitā kayirā ",
  "dhp43:2": "aññe vāpi ca ñātakā ",
  "dhp43:3": "sammāpaṇihitaṃ cittaṃ ",
  "dhp43:4": "seyyaso naṃ tato kare. ",
  "dhp43:5": "cittavaggo tatiyo. 4. pupphavaggo 1.(44) "
}
