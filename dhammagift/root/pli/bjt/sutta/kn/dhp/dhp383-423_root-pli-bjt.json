{
  "dhp383:0.1": "",
  "dhp383:0.2": "",
  "dhp383:0.3": "",
  "dhp383:0.4": "",
  "dhp383:1": "chinda sotaṃ parakkamma ",
  "dhp383:2": "kāme panuda brāhmaṇa ",
  "dhp383:3": "saṅkhārānaṃ khayaṃ ñatvā ",
  "dhp383:4": "akataññū’si brāhmaṇa. 2.(384) ",
  "dhp384:0": "",
  "dhp384:1": "yadā dvayesu dhammesu ",
  "dhp384:2": "pāragū hoti brāhmaṇo ",
  "dhp384:3": "athassa sabbe saṃyogā ",
  "dhp384:4": "atthaṃ gacchanti jānato. 3.(385) ",
  "dhp385:0": "",
  "dhp385:1": "yassa pāraṃ apāraṃ vā ",
  "dhp385:2": "pārāpāraṃ na vijjati ",
  "dhp385:3": "vītaddaraṃ visaṃyuttaṃ ",
  "dhp385:4": "tamahaṃ brūmi brāhmaṇaṃ. 4.(386) ",
  "dhp386:0": "",
  "dhp386:1": "jhāyiṃ virajamāsīnaṃ ",
  "dhp386:2": "katakiccaṃ anāsavaṃ ",
  "dhp386:3": "uttamatthaṃ anuppattaṃ ",
  "dhp386:4": "tamahaṃ brūmi brāhmaṇaṃ. 5.(387) ",
  "dhp387:0": "",
  "dhp387:1": "divā tapati ādicco ",
  "dhp387:2": "rattiṃ ābhāti candimā ",
  "dhp387:3": "sannaddho khattiyo tapati ",
  "dhp387:4": "jhāyī tapati brāhmaṇo ",
  "dhp387:5": "atha sabbamahorattiṃ ",
  "dhp387:6": "buddho tapati tejasā. 6.(388) ",
  "dhp388:0": "",
  "dhp388:1": "bāhitapāpo’ti brāhmaṇo ",
  "dhp388:2": "samacariyā samaṇo’ti vuccati. ",
  "dhp388:3": "pabbājayattano malaṃ ",
  "dhp388:4": "tasmā pabbajito’ti vuccati. 7.(389) ",
  "dhp389:0": "",
  "dhp389:1": "na brāhmaṇassa pahareyya ",
  "dhp389:2": "nāssa muñcetha brāhmaṇo ",
  "dhp389:3": "dhī brāhmaṇassa hantāraṃ ",
  "dhp389:4": "tato dhī yassa muñcati. 8.(390) ",
  "dhp390:1": "na brāhmaṇassetadakiñci seyyo ",
  "dhp390:2": "yadā nisedho manaso piyehi ",
  "dhp390:3": "yato yato hiṃsamano nivattati ",
  "dhp390:4": "tato tato sammati meva dukkhaṃ. 9.(391) ",
  "dhp391:0": "",
  "dhp391:1": "yassa kāyena vācāya ",
  "dhp391:2": "manasā natthi dukkataṃ ",
  "dhp391:3": "saṃvutaṃ tīhi ṭhānehi ",
  "dhp391:4": "tamahaṃ brūmi brāhmaṇaṃ. 10.(392) ",
  "dhp392:0": "",
  "dhp392:1": "yamhā dhammaṃ vijāneyya ",
  "dhp392:2": "sammāsambuddhadesitaṃ ",
  "dhp392:3": "sakkaccaṃ taṃ namasseyya ",
  "dhp392:4": "aggihuttaṃ’va brāhmaṇo. 11.(393) ",
  "dhp393:0": "",
  "dhp393:1": "na jaṭāhi na gottena ",
  "dhp393:2": "na jaccā hoti brāhmaṇo ",
  "dhp393:3": "yamhi saccañca dhammo ca ",
  "dhp393:4": "so sucī so’va brāhmaṇo. 12.(394) ",
  "dhp394:0": "",
  "dhp394:1": "kiṃ te jaṭāhi dummedha ",
  "dhp394:2": "kiṃ te ajinasāṭiyā ",
  "dhp394:3": "abbhantaraṃ te gahaṇaṃ ",
  "dhp394:4": "bāhiraṃ parimajjasi. 13.(395) ",
  "dhp395:0": "",
  "dhp395:1": "paṃsukūladharaṃ jantuṃ ",
  "dhp395:2": "kisaṃ dhamanisanthataṃ ",
  "dhp395:3": "ekaṃ vanasmiṃ jhāyantaṃ ",
  "dhp395:4": "tamahaṃ brūmi brāhmaṇaṃ. 14.(396) ",
  "dhp396:0": "",
  "dhp396:1": "na cāhaṃ brāhmaṇaṃ brūmi ",
  "dhp396:2": "yonijaṃ mattisambhavaṃ ",
  "dhp396:3": "bhovādī nāma so hoti ",
  "dhp396:4": "sace hoti sakiñcano ",
  "dhp396:5": "akiñcanaṃ anādānaṃ ",
  "dhp396:6": "tamahaṃ brūmi brāhmaṇaṃ. 15.(397) ",
  "dhp397:0": "",
  "dhp397:1": "sabbasaṃyojanaṃ chetvā ",
  "dhp397:2": "yo ve na paritassati ",
  "dhp397:3": "saṅgātigaṃ visaññuttaṃ ",
  "dhp397:4": "tamahaṃ brūmi brāhmaṇaṃ. 16.(398) ",
  "dhp398:0": "",
  "dhp398:1": "chetvā naddhiṃ varattañca ",
  "dhp398:2": "sandāmaṃ sahanukkamaṃ ",
  "dhp398:3": "ukkhittapalighaṃ buddhaṃ ",
  "dhp398:4": "tamahaṃ brūmi brāhmaṇaṃ. 17.(399) ",
  "dhp399:0": "",
  "dhp399:1": "akkosaṃ vadhabandhaṃ ca ",
  "dhp399:2": "aduṭṭho yo titikkhati ",
  "dhp399:3": "khantibalaṃ balānīkaṃ ",
  "dhp399:4": "tamahaṃ brūmi brāhmaṇaṃ. 18.(400) ",
  "dhp400:0": "",
  "dhp400:1": "akkodhanaṃ vatavantaṃ ",
  "dhp400:2": "sīlavantaṃ anussutaṃ ",
  "dhp400:3": "dantaṃ antimasārīraṃ ",
  "dhp400:4": "tamahaṃ brūmi brāhmaṇaṃ. 19.(401) ",
  "dhp401:0": "",
  "dhp401:1": "vāri pokkharapatte’va ",
  "dhp401:2": "āraggeriva sāsapo ",
  "dhp401:3": "yo na lippati kāmesu ",
  "dhp401:4": "tamahaṃ brūmi brāhmaṇaṃ. 20.(402) ",
  "dhp402:0": "",
  "dhp402:1": "yo dukkhassa pajānāti ",
  "dhp402:2": "idheva khayamattano ",
  "dhp402:3": "pannabhāraṃ visaṃyuttaṃ ",
  "dhp402:4": "tamahaṃ brūmi brāhmaṇaṃ. 21.(403) ",
  "dhp403:0": "",
  "dhp403:1": "gambhīrapaññaṃ medhāviṃ ",
  "dhp403:2": "maggāmaggassa kovidaṃ ",
  "dhp403:3": "uttamatthaṃ anuppattaṃ ",
  "dhp403:4": "tamahaṃ brūmi brāhmaṇaṃ. 22.(404) ",
  "dhp404:0": "",
  "dhp404:1": "asaṃsaṭṭhaṃ gahaṭṭhehi ",
  "dhp404:2": "anāgārehi cūbhayaṃ ",
  "dhp404:3": "anokasāriṃ appicchaṃ ",
  "dhp404:4": "tamahaṃ brūmi brāhmaṇaṃ. 23.(405) ",
  "dhp405:0": "",
  "dhp405:1": "nidhāya daṇḍaṃ bhūtesu ",
  "dhp405:2": "tasesu thāvaresu ca ",
  "dhp405:3": "yo na hanti na ghāteti ",
  "dhp405:4": "tamahaṃ brūmi brāhmaṇaṃ. 24.(406) ",
  "dhp406:0": "",
  "dhp406:1": "aviruddhaṃ viruddhesu ",
  "dhp406:2": "attadaṇḍesu nibbutaṃ ",
  "dhp406:3": "sādānesu anādānaṃ ",
  "dhp406:4": "tamahaṃ brūmi brāhmaṇaṃ. 25.(407) ",
  "dhp407:0": "",
  "dhp407:1": "yassa rāgo ca doso ca ",
  "dhp407:2": "māno makkho ca pātito ",
  "dhp407:3": "sāsapo riva āraggā ",
  "dhp407:4": "tamahaṃ brūmi brāhmaṇaṃ. 26.(408) ",
  "dhp408:0": "",
  "dhp408:1": "akakkasaṃ viññāpaniṃ ",
  "dhp408:2": "giraṃ saccaṃ udīraye ",
  "dhp408:3": "yāya nābhisaje kañci ",
  "dhp408:4": "tamahaṃ brūmi brāhmaṇaṃ. 27.(409) ",
  "dhp409:0": "",
  "dhp409:1": "yo’dha dīghaṃ va rassaṃ vā ",
  "dhp409:2": "aṇuṃ thūlaṃ subhāsubhaṃ ",
  "dhp409:3": "loke adinnaṃ nādiyati ",
  "dhp409:4": "tamahaṃ brūmi brāhmaṇaṃ. 28.(410) ",
  "dhp410:0": "",
  "dhp410:1": "āsā yassa na vijjanti ",
  "dhp410:2": "asmiṃ loke paramhi ca ",
  "dhp410:3": "nirāsayaṃ visaṃyuttaṃ ",
  "dhp410:4": "tamahaṃ brūmi brāhmaṇaṃ. 29.(411) ",
  "dhp411:0": "",
  "dhp411:1": "yassālayā na vijjanti ",
  "dhp411:2": "aññāya akathaṃkathī amatogadhaṃ ",
  "dhp411:3": "anuppattaṃ ",
  "dhp411:4": "tamahaṃ brūmi brāhmaṇaṃ. 30.(412) ",
  "dhp412:0": "",
  "dhp412:1": "yo’dha puññañca pāpañca ",
  "dhp412:2": "ubho saṅgaṃ upaccagā ",
  "dhp412:3": "asokaṃ virajaṃ suddhaṃ ",
  "dhp412:4": "tamahaṃ brūmi brāhmaṇaṃ. 31.(413) candaṃ’va ",
  "dhp413:0": "",
  "dhp413:1": "vimalaṃ suddhaṃ ",
  "dhp413:2": "vippasannamanāvilaṃ. ",
  "dhp413:3": "nandībhavaparikkhīṇaṃ ",
  "dhp413:4": "tamahaṃ brūmi brāhmaṇaṃ. 32.(414) yo imaṃ ",
  "dhp414:0": "",
  "dhp414:1": "paḷipathaṃ duggaṃ ",
  "dhp414:2": "saṃsāraṃ mohamaccagā ",
  "dhp414:3": "tiṇṇo pāragato jhāyī ",
  "dhp414:4": "anejo akathaṃkathī ",
  "dhp414:5": "anupādāya nibbuto ",
  "dhp414:6": "tamahaṃ brūmi brāhmaṇaṃ. 33.(415) ",
  "dhp415:0": "",
  "dhp415:1": "yodha kāme pahātvāna ",
  "dhp415:2": "anāgāro paribbaje ",
  "dhp415:3": "kāmabhavaparikkhīṇaṃ ",
  "dhp415:4": "tamahaṃ brūmi brāhmaṇaṃ. 34.(416) ",
  "dhp416:0": "",
  "dhp416:1": "yo’dha taṇhaṃ pahātvāna ",
  "dhp416:2": "anāgāro paribbaje ",
  "dhp416:3": "taṇhābhavaparikkhīṇaṃ ",
  "dhp416:4": "tamahaṃ brūmi brāhmaṇaṃ. 35.(417) ",
  "dhp416:5.0": "",
  "dhp416:5.1": "",
  "dhp416:6": "",
  "dhp416:7": "",
  "dhp416:8": "",
  "dhp417:0": "",
  "dhp417:1": "hitvā mānusakaṃ yogaṃ ",
  "dhp417:2": "dibbaṃ yogaṃ upaccagā ",
  "dhp417:3": "sabbayogavisaṃyuttaṃ ",
  "dhp417:4": "tamahaṃ brūmi brāhmaṇaṃ. 36.(418) ",
  "dhp418:0": "",
  "dhp418:1": "hitvā ratiṃ ca aratiṃ ca ",
  "dhp418:2": "sītibhūtaṃ nirūpadhiṃ ",
  "dhp418:3": "sabbalokābhibhuṃ vīraṃ ",
  "dhp418:4": "tamahaṃ brūmi brāhmaṇaṃ. 37.(419) ",
  "dhp419:0": "",
  "dhp419:1": "cutiṃ yo’vedi sattānaṃ ",
  "dhp419:2": "upapattiṃ ca sabbaso ",
  "dhp419:3": "asattaṃ sugataṃ buddhaṃ ",
  "dhp419:4": "tamahaṃ brūmi brāhmaṇaṃ. 38.(420) ",
  "dhp420:1": "yassa gatiṃ na jānanti ",
  "dhp420:2": "devā gandhabbamānusā ",
  "dhp420:3": "khīṇāsavaṃ arahantaṃ ",
  "dhp420:4": "tamahaṃ brūmi brāhmaṇaṃ. 39.(421) ",
  "dhp421:0": "",
  "dhp421:1": "yassa pure ca pacchā ca ",
  "dhp421:2": "majjhe ca natthi kiñcanaṃ ",
  "dhp421:3": "akiñcanaṃ anādānaṃ ",
  "dhp421:4": "tamahaṃ brūmi brāhmaṇaṃ. 40.(422) ",
  "dhp422:0": "",
  "dhp422:1": "usabhaṃ pavaraṃ vīraṃ ",
  "dhp422:2": "mahesiṃ vijitāvinaṃ ",
  "dhp422:3": "anejaṃ nhātakaṃ buddhaṃ ",
  "dhp422:4": "tamahaṃ brūmi brāhmaṇaṃ. 41.(423) ",
  "dhp423:0": "",
  "dhp423:1": "pubbenivāsaṃ yo’vedi saggāpāyaṃ ",
  "dhp423:2": "ca passati ",
  "dhp423:3": "atho jātikkhayaṃ patto ",
  "dhp423:4": "abhiññāvosito muni ",
  "dhp423:5": "sabbavositavosānaṃ ",
  "dhp423:6": "tamahaṃ brūmi brāhmaṇaṃ. ",
  "dhp423:7": "brāhmaṇavaggo chabbīsatimo. ",
  "dhp423:8": "vagguddānaṃ ",
  "dhp423:9": "",
  "dhp423:10": "",
  "dhp423:11": "",
  "dhp423:12": "",
  "dhp423:13": "",
  "dhp423:14": "yamakappamādo cittaṃ ",
  "dhp423:15": "pupphaṃ bālena paṇḍito ",
  "dhp423:16": "arahanto sahassena ",
  "dhp423:17": "pāpadaṇḍena te dasa. ",
  "dhp423:18": "jarā attā ca loko ca ",
  "dhp423:19": "buddho sukhapiyena ca ",
  "dhp423:20": "kodho malaṃ ca dhammaṭṭho ",
  "dhp423:21": "maggavaggena vīsati. ",
  "dhp423:22": "pakiṇṇaṃ nirayo nāgo ",
  "dhp423:23": "taṇhā bhikkhu ca brāhmaṇo ",
  "dhp423:24": "ete chabbīsati vaggā ",
  "dhp423:25": "desitādiccabandhunā. ",
  "dhp423:26": "",
  "dhp423:27": "gāthuddānaṃ yamake vīsati gāthā ",
  "dhp423:28": "appamādamhi dvādasa ",
  "dhp423:29": "ekādasa cittavagge ",
  "dhp423:30": "pupphavaggamhi soḷasa ",
  "dhp423:31": "bāle ca soḷasa gāthā ",
  "dhp423:32": "paṇḍitamhi catuddasa ",
  "dhp423:33": "arahante dasa gāthā ",
  "dhp423:34": "sahasse honti soḷasa. ",
  "dhp423:35": "terasa pāpavaggamhi ",
  "dhp423:36": "daṇḍamhi dasa satta ca ",
  "dhp423:37": "ekādasa jarāvagge attavagge ",
  "dhp423:38": "bhave dasa. ",
  "dhp423:39": "dvādasa lokavaggamhi ",
  "dhp423:40": "buddhe caṭṭhārasa bhave ",
  "dhp423:41": "sukhe ca piyavagge ca ",
  "dhp423:42": "gāthāyo honti dvādasa. ",
  "dhp423:43": "cuddasa kodhavaggamhi ",
  "dhp423:44": "malavaggekavīsati ",
  "dhp423:45": "sattarasa ca dhammaṭṭhe ",
  "dhp423:46": "maggavagge tatheva ca. ",
  "dhp423:47": "pakiṇṇe soḷasa gāthā ",
  "dhp423:48": "niraye nāge catuddasa chabbīsati ",
  "dhp423:49": "taṇhāvaggamhi ",
  "dhp423:50": "tevīsa bhikkhuvaggikā. ",
  "dhp423:51": "cattāḷīsekagāthāyo ",
  "dhp423:52": "brāhmaṇe vaggamuttame ",
  "dhp423:53": "gāthā satāni cattāri ",
  "dhp423:54": "tevīsa ca punāpare ",
  "dhp423:55": "dhammapade nipātamhi ",
  "dhp423:56": "desitādiccabandhunā’ti. ",
  "dhp423:57": "dhammapadapāḷi niṭṭhitā. "
}
