{
  "dhp157:0.1": "",
  "dhp157:0.2": "",
  "dhp157:0.3": "12. attavaggo ",
  "dhp157:0.4": "",
  "dhp157:1": "1.(157) attānaṃ ce piyaṃ jaññā ",
  "dhp157:2": "rakkheyya naṃ surakkhitaṃ ",
  "dhp157:3": "tiṇṇamaññataraṃ yāmaṃ ",
  "dhp157:4": "paṭijaggeyya paṇḍito. 2.(158) ",
  "dhp158:0": "",
  "dhp158:1": "attānameva paṭhamaṃ ",
  "dhp158:2": "patirūpe nivesaye ",
  "dhp158:3": "athaññamanusāseyya ",
  "dhp158:4": "na kilisseyya paṇḍito. 3.(159) ",
  "dhp159:0": "",
  "dhp159:1": "attānañce tathā kayirā ",
  "dhp159:2": "yathaññamanusāsati ",
  "dhp159:3": "sudanto vata dammetha ",
  "dhp159:4": "attā hi kira duddamo. 4.(160) ",
  "dhp160:0": "",
  "dhp160:1": "attā hi attano nātho ",
  "dhp160:2": "ko hi nātho paro siyā ",
  "dhp160:3": "attanā’va sudantena ",
  "dhp160:4": "nāthaṃ labhati dullabhaṃ. 5.(161) attanā’va ",
  "dhp161:0": "",
  "dhp161:1": "kataṃ pāpaṃ ",
  "dhp161:2": "attajaṃ attasambhavaṃ ",
  "dhp161:3": "abhimanthati dummedhaṃ ",
  "dhp161:4": "vajiraṃ’vasmamayaṃ maṇiṃ. 6.(162) ",
  "dhp162:0": "",
  "dhp162:1": "yassa accantadussīlyaṃ ",
  "dhp162:2": "māluvā sālamivotataṃ ",
  "dhp162:3": "karoti so tathattānaṃ ",
  "dhp162:4": "yathā naṃ icchatī diso. 7.(163) ",
  "dhp163:0": "",
  "dhp163:1": "sukarāni asādhūni ",
  "dhp163:2": "attano ahitāni ca ",
  "dhp163:3": "yaṃ ve hitañca sādhuṃ ca ",
  "dhp163:4": "taṃ ve paramadukkaraṃ. 8.(164) ",
  "dhp164:0": "",
  "dhp164:1": "yo sāsanaṃ arahataṃ ",
  "dhp164:2": "ariyānaṃ dhammajīvinaṃ ",
  "dhp164:3": "paṭikkosati dummedho ",
  "dhp164:4": "diṭṭhiṃ nissāya pāpikaṃ ",
  "dhp164:5": "phalāni kaṭṭhakasseva ",
  "dhp164:6": "attaghaññāya phallati. 9.(165) attanā’va ",
  "dhp165:0": "",
  "dhp165:1": "kataṃ pāpaṃ ",
  "dhp165:2": "attanā saṃkilissati ",
  "dhp165:3": "attanā akataṃ pāpaṃ ",
  "dhp165:4": "attanāva visujjhati ",
  "dhp165:5": "suddhi asuddhi paccattaṃ ",
  "dhp165:6": "nāññamañño visodhaye. 10.(166) ",
  "dhp166:0": "",
  "dhp166:1": "attadatthaṃ paratthena ",
  "dhp166:2": "bahunāpi na hāpaye ",
  "dhp166:3": "attadatthamabhiññāya ",
  "dhp166:4": "sadatthapasuto siyā. ",
  "dhp166:5": "attavaggo dvādasamo. "
}
