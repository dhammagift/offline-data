{
  "dhp306:0.1": "ekavīsatimo pakiṇṇakavaggo. ",
  "dhp306:0.2": "",
  "dhp306:0.3": "22. nirayavaggo. ",
  "dhp306:0.4": "",
  "dhp306:1": "1.(306) abhūtavādī nirayaṃ upeti ",
  "dhp306:2": "yo vāpi katvā na karomīti cāha ",
  "dhp306:3": "ubho’pi te pecca samā bhavanti ",
  "dhp306:4": "nihīnakammā manujā parattha. 2.(307) ",
  "dhp307:0": "",
  "dhp307:1": "kāsāvakaṇṭhā bahavo ",
  "dhp307:2": "pāpadhammā asaññatā ",
  "dhp307:3": "pāpā pāpehi kammehi ",
  "dhp307:4": "nirayaṃ te upapajjare. 3.(308) ",
  "dhp308:0": "",
  "dhp308:1": "seyyo ayoguḷo bhutto ",
  "dhp308:2": "tatto aggisikhūpamo ",
  "dhp308:3": "yañce bhuñjeyya dussīlo ",
  "dhp308:4": "raṭṭhapiṇḍaṃ asaññato. 4.(309) ",
  "dhp309:0": "",
  "dhp309:1": "cattāri ṭhānāni naro pamatto ",
  "dhp309:2": "āpajjati paradārūpasevī. ",
  "dhp309:3": "apuññalābhaṃ na nikāmaseyyaṃ ",
  "dhp309:4": "nindaṃ tatiyaṃ nirayaṃ catutthaṃ. 5.(310) ",
  "dhp310:1": "apuññalābho ca gatī ca pāpikā ",
  "dhp310:2": "bhītassa bhītāya ratī ca thokikā ",
  "dhp310:3": "rājā ca daṇḍaṃ garukaṃ paṇeti ",
  "dhp310:4": "tasmā naro paradāraṃ na seve. 6.(311) ",
  "dhp311:0": "",
  "dhp311:1": "kuso yathā duggahito ",
  "dhp311:2": "hatthamevānukantati ",
  "dhp311:3": "sāmaññaṃ dupparāmaṭṭhaṃ ",
  "dhp311:4": "nirayāyupakaḍḍhati. 7.(312) ",
  "dhp312:1": "yaṃ kiñci sithilaṃ kammaṃ ",
  "dhp312:2": "saṃkiliṭṭhaṃ ca yaṃ vataṃ ",
  "dhp312:3": "saṅkassaraṃ brahmacariyaṃ ",
  "dhp312:4": "na taṃ hoti mahapphalaṃ. 8.(313) ",
  "dhp313:1": "kayirā ce kayirāthenaṃ ",
  "dhp313:2": "daḷhamenaṃ parakkame ",
  "dhp313:3": "saṭhilo hi paribbājo ",
  "dhp313:4": "bhiyyo ākirate rajaṃ. 9.(314) ",
  "dhp314:0": "",
  "dhp314:1": "akataṃ dukkataṃ seyyo ",
  "dhp314:2": "pacchā tapati dukkataṃ ",
  "dhp314:3": "kataṃ ca sukataṃ seyyo ",
  "dhp314:4": "yaṃ katvā nānutappati. 10.(315) ",
  "dhp315:0": "",
  "dhp315:1": "nagaraṃ yathā paccattaṃ ",
  "dhp315:2": "guttaṃ santarabāhiraṃ ",
  "dhp315:3": "evaṃ gopetha attānaṃ ",
  "dhp315:4": "khaṇo vo mā upaccagā ",
  "dhp315:5": "khaṇātītā hi socanti ",
  "dhp315:6": "nirayamhi samappitā. 11.(316) ",
  "dhp316:0": "",
  "dhp316:1": "alajjitāye lajjanti ",
  "dhp316:2": "lajjitāye na lajjare ",
  "dhp316:3": "micchādiṭṭhisamādānā ",
  "dhp316:4": "sattā gacchanti duggatiṃ. 12.(317) ",
  "dhp317:1": "abhaye bhayadassino ",
  "dhp317:2": "bhaye cābhayadassino ",
  "dhp317:3": "micchādiṭṭhisamādānā ",
  "dhp317:4": "sattā gacchanti duggatiṃ. 13.(318) ",
  "dhp318:0": "",
  "dhp318:1": "avajje vajjamatino ",
  "dhp318:2": "vajje cāvajjadassino ",
  "dhp318:3": "micchādiṭṭhisamādānā ",
  "dhp318:4": "sattā gacchanti duggatiṃ. 14.(319) vajjaṃ ca ",
  "dhp319:1": "vajjato ñatvā ",
  "dhp319:2": "avajjaṃ ca avajjato ",
  "dhp319:3": "sammādiṭṭhisamādānā ",
  "dhp319:4": "sattā gacchanti suggatiṃ. ",
  "dhp319:5": ""
}
