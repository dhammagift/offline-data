  "dhp197:0.3": "",
  "dhp197:0.4": "",
  "dhp197:1": "susukhaṃ vata jīvāma ",
  "dhp197:2": "verinesu averino ",
  "dhp197:3": "verinesu manussesu ",
  "dhp197:4": "viharāma averino. 2.(198) ",
  "dhp198:1": "susukhaṃ vata jīvāma ",
  "dhp198:2": "āturesu anāturā ",
  "dhp198:3": "āturesu manussesu, ",
  "dhp198:4": "viharāma anāturā. 3.(199) ",
  "dhp199:1": "susukhaṃ vata jīvāma ",
  "dhp199:2": "ussukesu anussukā ",
  "dhp199:3": "ussukesu manussesu ",
  "dhp199:4": "viharāma anussukā. 4.(200) ",
  "dhp200:0": "",
  "dhp200:1": "susukhaṃ vata jīvāma ",
  "dhp200:2": "yesaṃ no natthi kiñcanaṃ ",
  "dhp200:3": "pītibhakkhā bhavissāma ",
  "dhp200:4": "devā ābhassarā yathā. 5.(201) ",
  "dhp201:0": "",
  "dhp201:1": "jayaṃ veraṃ pasavati ",
  "dhp201:2": "dukkhaṃ seti parājito ",
  "dhp201:3": "upasanto sukhaṃ seti ",
  "dhp201:4": "hitvā jayaparājayaṃ. 6.(202) ",
  "dhp202:0": "",
  "dhp202:1": "natthi rāgasamo aggi ",
  "dhp202:2": "natthi dosasamo kali ",
  "dhp202:3": "natthi khandhasamā dukkhā ",
  "dhp202:4": "natthi santiparaṃ sukhaṃ. 7.(203) ",
  "dhp203:0": "",
  "dhp203:1": "jighacchāparamā rogā ",
  "dhp203:2": "saṅkhāraparamā dukhā ",
  "dhp203:3": "etaṃ ñatvā yathābhūtaṃ ",
  "dhp203:4": "nibbāṇaparamaṃ sukhaṃ. 8.(204) ",
  "dhp204:0": "",
  "dhp204:1": "ārogyaparamā lābhā ",
  "dhp204:2": "santuṭṭhiparamaṃ dhanaṃ ",
  "dhp204:3": "vissāsaparamā ñātī ",
  "dhp204:4": "nibbāṇaparamaṃ sukhaṃ. 9.(205) ",
  "dhp205:0": "",
  "dhp205:1": "pavivekarasaṃ pītvā ",
  "dhp205:2": "rasaṃ upasamassa ca ",
  "dhp205:3": "niddaro hoti nippāpo ",
  "dhp205:4": "dhammapītirasaṃ pibaṃ. 10.(206) ",
  "dhp206:0": "",
  "dhp206:1": "sāhu dassanamariyānaṃ ",
  "dhp206:2": "sannivāso sadā sukho ",
  "dhp206:3": "adassanena bālānaṃ ",
  "dhp206:4": "niccameva sukhī siyā. 11.(207) bālasaṅgatacārīhi ",
  "dhp207:1": "",
  "dhp207:2": "dīghamaddhāna socati ",
  "dhp207:3": "dukkho bālehi saṃvāso ",
  "dhp207:4": "amitteneva sabbadā ",
  "dhp207:5": "dhīro ca sukhasaṃvāso ",
  "dhp207:6": "ñātīnaṃ’va samāgamo. 12.(208) tasmāhi, ",
  "dhp208:1": "",
  "dhp208:2": "dhīrañca paññañca bahussutañca ",
  "dhp208:3": "dhorayhasīlaṃ vatavantamariyaṃ ",
  "dhp208:4": "taṃ tādisaṃ sappurisaṃ sumedhaṃ ",
  "dhp208:5": "bhajetha nakkhattapathaṃ’va candimā. paṇṇarasamo ",
  "dhp208:6": "sukhavaggo. 16. piyavaggo. 1.(209) "
}
