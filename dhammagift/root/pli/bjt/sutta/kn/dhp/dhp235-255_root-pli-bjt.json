{
  "dhp235:0.1": "",
  "dhp235:0.2": "",
  "dhp235:0.3": "",
  "dhp235:0.4": "",
  "dhp235:1": "paṇḍupalāso’va dāni’si ",
  "dhp235:2": "yamapurisā’pi ca taṃ upaṭṭhitā. ",
  "dhp235:3": "uyyogamukhe ca tiṭṭhasi ",
  "dhp235:4": "pātheyyampi ca te na vijjati. 2.(236) ",
  "dhp236:1": "so karohi dīpamattano ",
  "dhp236:2": "khippaṃ vāyama paṇḍito bhava ",
  "dhp236:3": "niddhantamalo anaṅgaṇo ",
  "dhp236:4": "dibbaṃ ariyabhūmimehisi. 3.(237) ",
  "dhp237:1": "upanītavayo ca dāni’si ",
  "dhp237:2": "sampayāto’si yamassa santike vāso’pi ",
  "dhp237:3": "ca te natthi antarā ",
  "dhp237:4": "pātheyyampi ca te na vijjati. 4.(238) ",
  "dhp238:1": "so karohi dīpamattano ",
  "dhp238:2": "khippaṃ vāyama paṇḍito bhava ",
  "dhp238:3": "niddhantamalo anaṅgaṇo ",
  "dhp238:4": "na punaṃ jātijaraṃ upehisi. 5.(239) ",
  "dhp239:0": "",
  "dhp239:1": "anupubbena medhāvī ",
  "dhp239:2": "thokathokaṃ khaṇe khaṇe ",
  "dhp239:3": "kammāro rajatasseva ",
  "dhp239:4": "niddhame malamattano. 6.(240) ",
  "dhp240:0": "",
  "dhp240:1": "ayasā’va malaṃ samuṭṭhitaṃ ",
  "dhp240:2": "taduṭṭhāya tameva khādati ",
  "dhp240:3": "evaṃ atidhonacārinaṃ ",
  "dhp240:4": "sakakammāni nayanti duggatiṃ. 7.(241) ",
  "dhp241:0": "",
  "dhp241:1": "asajjhāyamalā mantā ",
  "dhp241:2": "anuṭṭhānamalā gharā ",
  "dhp241:3": "malaṃ vaṇṇassa kosajjaṃ ",
  "dhp241:4": "pamādo rakkhato malaṃ. 8.(242) ",
  "dhp242:0": "",
  "dhp242:1": "malitthiyā duccaritaṃ ",
  "dhp242:2": "maccheraṃ dadato malaṃ ",
  "dhp242:3": "malā ve pāpakā dhammā ",
  "dhp242:4": "asmiṃ loke paramhi ca. 9.(243) ",
  "dhp243:1": "tato malā malataraṃ ",
  "dhp243:2": "avijjā paramaṃ malaṃ ",
  "dhp243:3": "etaṃ malaṃ pahatvāna ",
  "dhp243:4": "nimmalā hotha bhikkhavo. 10.(244) ",
  "dhp244:0": "",
  "dhp244:1": "sujīvaṃ ahirikena ",
  "dhp244:2": "kākasūrena dhaṃsinā ",
  "dhp244:3": "pakkhandinā pagabbhena ",
  "dhp244:4": "saṃkiliṭṭhena jīvitaṃ. 11.(245) ",
  "dhp245:1": "hirīmatā ca dujjīvaṃ ",
  "dhp245:2": "niccaṃ sucigavesinā ",
  "dhp245:3": "alīnenāpagabbhena ",
  "dhp245:4": "suddhājīvena passatā. 12.(246) ",
  "dhp246:0": "",
  "dhp246:1": "yo pāṇamatipāteti ",
  "dhp246:2": "musāvādaṃ ca bhāsati ",
  "dhp246:3": "loke adinnaṃ ādiyati paradāraṃ ",
  "dhp246:4": "ca gacchati. 13.(247) surāmerayapānaṃ ca ",
  "dhp247:1": "",
  "dhp247:2": "yo naro anuyuñjati ",
  "dhp247:3": "idheva poso lokasmiṃ ",
  "dhp247:4": "mūlaṃ khaṇati attano. 14.(248) ",
  "dhp248:1": "evaṃ bho purisa jānāhi ",
  "dhp248:2": "pāpadhammā asaññatā ",
  "dhp248:3": "mā taṃ lobho adhammo ca ",
  "dhp248:4": "ciraṃ dukkhāya randhayuṃ. 15.(249) ",
  "dhp249:0": "",
  "dhp249:1": "dadāti ve yathā saddhaṃ ",
  "dhp249:2": "yathā pasādanaṃ jano ",
  "dhp249:3": "tattha ve maṅku yo hoti ",
  "dhp249:4": "paresaṃ pānabhojane ",
  "dhp249:5": "na so divā vā rattiṃ vā ",
  "dhp249:6": "samādhiṃ adhigacchati. 16.(250) ",
  "dhp250:1": "yassa cetaṃ samucchinnaṃ ",
  "dhp250:2": "mūlaghaccaṃ samūhataṃ. ",
  "dhp250:3": "sa ve divā vā rattiṃ vā ",
  "dhp250:4": "samādhiṃ adhigacchati. 17.(251) ",
  "dhp251:0": "",
  "dhp251:1": "natthi rāgasamo aggi ",
  "dhp251:2": "natthi dosasamo gaho ",
  "dhp251:3": "natthi mohasamaṃ jālaṃ ",
  "dhp251:4": "natthi taṇhāsamā nadī. 18.(252) ",
  "dhp252:0": "",
  "dhp252:1": "sudassaṃ vajjamaññesaṃ ",
  "dhp252:2": "attano pana duddasaṃ ",
  "dhp252:3": "paresaṃ hi so vajjāni ",
  "dhp252:4": "opuṇāti yathā bhusaṃ ",
  "dhp252:5": "attano pana chādeti ",
  "dhp252:6": "kaliṃ’va kitavā saṭho. 19.(253) ",
  "dhp253:0": "",
  "dhp253:1": "paravajjānupassissa ",
  "dhp253:2": "niccaṃ ujjhānasaññino ",
  "dhp253:3": "āsavā tassa vaḍḍhanti ",
  "dhp253:4": "ārā so āsavakkhayā. 20.(254) ākāse ",
  "dhp254:0": "",
  "dhp254:1": "padaṃ natthi ",
  "dhp254:2": "samaṇo natthi bāhire ",
  "dhp254:3": "papañcābhiratā pajā ",
  "dhp254:4": "nippapañcā tathāgatā. 21.(255) ākāse ",
  "dhp255:1": "padaṃ natthi ",
  "dhp255:2": "samaṇo natthi bāhire ",
  "dhp255:3": "saṅkhārā sassatā natthi ",
  "dhp255:4": "natthi buddhāna iñjitaṃ. ",
  "dhp255:5": "malavaggo aṭṭhārasamo. 19. dhammaṭṭhavaggo 1.(256) "
}
