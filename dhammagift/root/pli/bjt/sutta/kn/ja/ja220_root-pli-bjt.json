  "ja220:0.3": "",
  "ja220:0.4": "9. garahitajātakaṃ. ",
  "ja220:1.1": "sukhaṃ jīvitarūposi ",
  "ja220:1.2": "raṭṭhā vivanamāgato, ",
  "ja220:1.3": "so ekako araññasmiṃ rukkhamūle ",
  "ja220:1.4": "kapaṇo viya jhāyasi ",
  "ja220:2.1": "sukhaṃ jivitarūposmi ",
  "ja220:2.2": "raṭṭhā vivanamāgato, ",
  "ja220:2.3": "so ekako araññasmiṃ rukkhamūle ",
  "ja220:2.4": "kapaṇo viya jhāyāmi ",
  "ja220:2.5": "sataṃ dhammaṃ anussaranti ",
  "ja220:3.1": "",
  "ja220:3.2": "10. dhammaddhajajātakaṃ. bīraṇatthambhakavaggo sattamo. ",
  "ja220:4.1": "tassuddānaṃ: ",
  "ja220:5.1": "atha bīraṇatthambhavaro ca naṭo ",
  "ja220:5.2": "bharurājavaruttamapuṇṇanadī, ",
  "ja220:5.3": "bahubhāṇī aggi pavane mūsikā ",
  "ja220:5.4": "sahalambatthano kapaṇena dasa. "
}
