  "ja216:0.4": "5. kacchapajātakaṃ ",
  "ja216:1.1": "na cāyamaggi tapati ",
  "ja216:1.2": "na sūlo sādu tacchito, ",
  "ja216:1.3": "yañca maṃ maññati macchi ",
  "ja216:1.4": "aññaṃ so ratiyā gato. ",
  "ja216:2.1": "so maṃ dahati rāgaggi ",
  "ja216:2.2": "cittaṃ cupatapeti maṃ, ",
  "ja216:2.3": "jālino muñcathayirā maṃ ",
  "ja216:2.4": "na kāme haññate kaccīti. ",
  "ja216:3.1": ""
}
