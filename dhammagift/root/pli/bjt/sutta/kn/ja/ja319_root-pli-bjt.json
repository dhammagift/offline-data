  "ja319:0.3": "",
  "ja319:0.4": "",
  "ja319:1.1": "susukhaṃ vata jīvāmi ",
  "ja319:1.2": "labhāmi ceva bhuñjituṃ ",
  "ja319:1.3": "paripanthe ca tiṭṭhāmi ",
  "ja319:1.4": "kānu bhante gatī mama. ",
  "ja319:2.1": "mano ce te na panamati ",
  "ja319:2.2": "pakkhī pāpassa kammuno, ",
  "ja319:2.3": "avyāvaṭassa bhadrassa ",
  "ja319:2.4": "na pāpamupalippati. ",
  "ja319:3.1": "ñātako no nisinnoti ",
  "ja319:3.2": "bahu āgacchate jano, ",
  "ja319:3.3": "paṭicca kammaṃ phusati ",
  "ja319:3.4": "tasmiṃ me saṅkate mano. ",
  "ja319:4.1": "paṭicca kammaṃ na phusati ",
  "ja319:4.2": "mano ce nappadussati, ",
  "ja319:4.3": "appossukkassa bhadrassa ",
  "ja319:4.4": "na pāpamupalippatī’ti. ",
  "ja319:5.1": "tittirajātakaṃ. "
}
