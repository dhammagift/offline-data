  "ja440:0.4": "",
  "ja440:1.1": "kaṇhovatāyaṃ puriso ",
  "ja440:1.2": "kaṇhaṃ bhuñjati bhojanaṃ, ",
  "ja440:1.3": "kaṇhe bhūmippadesasmiṃ ",
  "ja440:1.4": "na mayhaṃ manaso piyo. ",
  "ja440:2.1": "na kaṇho tacasā hoti ",
  "ja440:2.2": "antosāro brāhmaṇo ",
  "ja440:2.3": "yasmiṃ pāpāni kammāni ",
  "ja440:2.4": "sace kaṇho sujampati. ",
  "ja440:3.1": "etasmiṃ te sulapite ",
  "ja440:3.2": "patirūpe subhāsite, ",
  "ja440:3.3": "varaṃ brāhmaṇa te dammī ",
  "ja440:3.4": "yaṃ kiñci manasicchasi. ",
  "ja440:4.1": "varaṃ ce me ado sakka ",
  "ja440:4.2": "sabbabhūtānamissara, ",
  "ja440:4.3": "sunikkodhaṃ suniddosaṃ ",
  "ja440:4.4": "nillobhaṃ vuttimattano. ",
  "ja440:4.5": "nisnehamabhikaṅkhāmi ",
  "ja440:4.6": "ete me caturo vare. ",
  "ja440:5.1": "kinnu kodhe ca dose vā ",
  "ja440:5.2": "lobhe sneheva brāhmaṇa, ",
  "ja440:5.3": "ādīnavaṃ sampassasi ",
  "ja440:5.4": "taṃ me akkhāhi pucchito. ",
  "ja440:6.1": "appo hutvā bahu hoti ",
  "ja440:6.2": "vaḍḍhate so akhantijo, ",
  "ja440:6.3": "āsaṅgi bahupāyāso ",
  "ja440:6.4": "tasmā kodhaṃ na rocaye. ",
  "ja440:7.1": "duṭṭhassa pharusā vācā ",
  "ja440:7.2": "parāmāso anantarā, ",
  "ja440:7.3": "tato pāṇi tato daṇḍo ",
  "ja440:7.4": "satthassa paramā gati ",
  "ja440:7.5": "doso kodhasamuṭṭhāno ",
  "ja440:7.6": "tasmā dosaṃ na rocaye. ",
  "ja440:8.1": "alopasahasākārā ",
  "ja440:8.2": "nikatī vañcanāni ca, ",
  "ja440:8.3": "dissanti lobhadhammesu ",
  "ja440:8.4": "tasmā lobhaṃ na rocaye. ",
  "ja440:9.1": "sneha saṅgathītā ganthā ",
  "ja440:9.2": "senti manomayā puthu, ",
  "ja440:9.3": "te bhusaṃ upatāpenti ",
  "ja440:9.4": "tasmā snehaṃ na rocaye. ",
  "ja440:10.1": "etasmiṃ te sulapite ",
  "ja440:10.2": "patirūpe subhāsite, ",
  "ja440:10.3": "varaṃ brāhmaṇa te dammi ",
  "ja440:10.4": "yaṃ kiñci manasicchasi. ",
  "ja440:11.1": "varaṃ ce me ado sakka ",
  "ja440:11.2": "sabbabhūtānamissara, ",
  "ja440:11.3": "araññe me viharato ",
  "ja440:11.4": "niccaṃ ekavihārino. ",
  "ja440:11.5": "ābādhā mā uppajjeyyuṃ ",
  "ja440:11.6": "antarāyakarā bhusā. ",
  "ja440:12.1": "etasmiṃ te sulapite ",
  "ja440:12.2": "patirūpe subhāsite, ",
  "ja440:12.3": "varaṃ brāhmaṇa te dammi ",
  "ja440:12.4": "yaṃ kiñci manasicchasi. ",
  "ja440:13.1": "varaṃ ce me ado sakka ",
  "ja440:13.2": "sabbabhūtānamissara ",
  "ja440:13.3": "na mano vā sarīraṃ vā ",
  "ja440:13.4": "maṅkate sakka kassaci ",
  "ja440:13.5": "kadāci upahaññetha ",
  "ja440:13.6": "etaṃ sakka varaṃ vareti. ",
  "ja440:14.1": "kaṇhajātakaṃ. "
}
