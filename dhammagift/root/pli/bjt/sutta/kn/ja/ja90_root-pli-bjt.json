  "ja90:1.1": "yo pubbe katakalyāṇo ",
  "ja90:1.2": "katattho nāvabujjhati, ",
  "ja90:1.3": "pacchā kicce samuppanne ",
  "ja90:1.4": "kattāraṃ nādhigacchati. ",
  "ja90:2.1": "akataññujātakaṃ. ",
  "ja90:2.2": "apāyimhavaggo navamo. ",
  "ja90:3.1": "tassuddānaṃ: ",
  "ja90:4.1": "apāyimha ca dūbhakasattapadaṃ ",
  "ja90:4.2": "chaḷadvāra ca āyatinā ca puna, ",
  "ja90:4.3": "ahisīlavamaṅgalipāpikassā satanikkhakatatthavarena ",
  "ja90:4.4": "dasa. "
}
