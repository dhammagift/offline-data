  "ja443:0.1": "",
  "ja443:0.2": "",
  "ja443:0.3": "",
  "ja443:0.4": "",
  "ja443:1.1": "yo te imaṃ visālakkhiṃ ",
  "ja443:1.2": "piyaṃ sammillabhāsiniṃ, ",
  "ja443:1.3": "ādāya balā gaccheyya ",
  "ja443:1.4": "kinnu kayirāsi brāhmaṇa. ",
  "ja443:2.1": "uppajja me na mucceyya ",
  "ja443:2.2": "na me mucceyya jīvato ",
  "ja443:2.3": "rajaṃva vipulā vuṭṭhi ",
  "ja443:2.4": "khippameva nivāraye. ",
  "ja443:3.1": "yannu pubbe vikatthittho ",
  "ja443:3.2": "balamhi ca apassito, ",
  "ja443:3.3": "svājja tuṇhīkakodāni ",
  "ja443:3.4": "saṅghāṭiṃ sibbamacchasi. ",
  "ja443:4.1": "uppajja me na muccittha ",
  "ja443:4.2": "name muccittha jīvato ",
  "ja443:4.3": "rajaṃva vipulā vuṭṭhi ",
  "ja443:4.4": "khippameva nivārayiṃ. ",
  "ja443:5.1": "kinte uppajji no mucci ",
  "ja443:5.2": "kinte no mucci jīvato, ",
  "ja443:5.3": "rajaṃva vipulā vuṭṭhi ",
  "ja443:5.4": "katamaṃ tvaṃ nivārayī. ",
  "ja443:6.1": "yamhi jāte na passati ",
  "ja443:6.2": "ajāte sādhu passati, ",
  "ja443:6.3": "so me uppajji no mucci ",
  "ja443:6.4": "kodho dummedhagocaro. ",
  "ja443:7.1": "yena jātena nandanti ",
  "ja443:7.2": "amittā dukkhamesino, ",
  "ja443:7.3": "so me uppajji no mucci ",
  "ja443:7.4": "kodho dummedhagocaro. ",
  "ja443:8.1": "yasmiñca jayamānasmiṃ ",
  "ja443:8.2": "sadatthaṃ nāvabujjhati. ",
  "ja443:8.3": "so me uppajji no mucci ",
  "ja443:8.4": "kodho dummedhagocaro. ",
  "ja443:9.1": "yenābhibhūto kusalaṃ jahāti ",
  "ja443:9.2": "parakkare vipulañcāpi atthaṃ, ",
  "ja443:9.3": "sa bhīmaseno balavā pamaddī ",
  "ja443:9.4": "kodho mahārāja na me amuccatha. ",
  "ja443:10.1": "kaṭṭhasmiṃ manthamānasmiṃ ",
  "ja443:10.2": "pāvako nāma jāyati, ",
  "ja443:10.3": "tameva kaṭṭhaṃ ḍahati ",
  "ja443:10.4": "yasmā so jāyate gini. ",
  "ja443:11.1": "evaṃ mandassa posassa ",
  "ja443:11.2": "bālassa avijānato ",
  "ja443:11.3": "sārambhā jāyate kodho ",
  "ja443:11.4": "sopi teneva ḍayhati. ",
  "ja443:12.1": "aggīva tiṇakaṭṭhasmiṃ ",
  "ja443:12.2": "kodho yassa pavaḍḍhati, ",
  "ja443:12.3": "nihīyati tassa yaso ",
  "ja443:12.4": "kāḷapakkheva candimā. ",
  "ja443:13.1": "anindho dhūmaketuva ",
  "ja443:13.2": "kodho yassūpasammati, ",
  "ja443:13.3": "āpūrati tassa yaso ",
  "ja443:13.4": "sukkapakkheva candimāti. ",
  "ja443:14.1": ""
}
