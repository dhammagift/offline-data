  "ja160:0.4": "",
  "ja160:1.1": "evameva nūna rājānaṃ ",
  "ja160:1.2": "vedehaṃ mithilaggahaṃ, ",
  "ja160:1.3": "assā vahanti ājaññā ",
  "ja160:1.4": "yathā haṃsā vinīlakaṃ. ",
  "ja160:2.1": "vinīla duggaṃ bhajasi ",
  "ja160:2.2": "abhūmiṃ tāta sevasi, ",
  "ja160:2.3": "gāmantikāni sevassu ",
  "ja160:2.4": "etaṃ mātālayaṃ tavā’ti. ",
  "ja160:3.1": "vinīlakajātakaṃ. ",
  "ja160:3.2": "daḷhavaggo paṭhamo. ",
  "ja160:4.1": "tassuddānaṃ: ",
  "ja160:5.1": "varamallikadaddarasukarako ",
  "ja160:5.2": "uraguttama pañcama gaggavaro, ",
  "ja160:5.3": "mahatī camū yā ",
  "ja160:5.4": "ca sigālavaro suhanuttamamoravinīla dasa. "
}
