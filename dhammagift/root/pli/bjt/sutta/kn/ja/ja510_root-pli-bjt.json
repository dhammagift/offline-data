  "ja510:0.3": "",
  "ja510:0.4": "14. ayogharajātakaṃ. ",
  "ja510:1.1": "yamekarattiṃ paṭhamaṃ ",
  "ja510:1.2": "gabbhe vasati māṇavo, ",
  "ja510:1.3": "abbhuṭṭhitova sayati ",
  "ja510:1.4": "sagacchaṃ na nivattati. ",
  "ja510:2.1": "na yujjhamānā na balena vassitā ",
  "ja510:2.2": "narā na jīranti navāpi mīyare, ",
  "ja510:2.3": "sabbaṃ hi taṃ jātijarāyupaddutaṃ ",
  "ja510:2.4": "tamme matī hoti carāmi dhammaṃ. ",
  "ja510:3.1": "caturaṅginiṃ senaṃ subhiṃsarūpaṃ ",
  "ja510:3.2": "jayanti raṭṭhādhipatī pasayha, ",
  "ja510:3.3": "na maccuno jayituṃ ",
  "ja510:3.4": "ussahanti tamme matī hoti carāmi dhammaṃ. ",
  "ja510:4.1": "hatthīhi assehi rathehi pattihi ",
  "ja510:4.2": "parivāritā muccare ekaveyyā, ",
  "ja510:4.3": "na maccuno muccituṃ ",
  "ja510:4.4": "ussahanti tamme matī hoti carāmi dhammaṃ. ",
  "ja510:5.1": "hatthīhi assehi rathehi pattihi ",
  "ja510:5.2": "sūrā pahañjanti padhaṃsayanti, ",
  "ja510:5.3": "na maccuno bhañjituṃ ",
  "ja510:5.4": "ussahanti tamme matī hoti carāmi dhammaṃ. ",
  "ja510:6.1": "mattā gajā bhinnagaḷā pabhinnā ",
  "ja510:6.2": "nagarāni maddanti janaṃ hananti, ",
  "ja510:6.3": "na maccuno maddituṃ ",
  "ja510:6.4": "ussahanti tamme matī hoti carāmi dhammaṃ. ",
  "ja510:7.1": "issāsino katahatthāpi dhīrā ",
  "ja510:7.2": "dūrepātī akkhaṇavedhinopi, ",
  "ja510:7.3": "na maccuno vijjhituṃ ",
  "ja510:7.4": "ussahanti tamme matī hoti carāmi dhammaṃ. ",
  "ja510:8.1": "sarāni khīyanti saselakānanā ",
  "ja510:8.2": "sabbaṃ hi taṃ khīyati dīghamantaraṃ, ",
  "ja510:8.3": "sabbaṃ hi taṃ bhañjare kālapariyaṃ ",
  "ja510:8.4": "tamme matī hoti carāmi dhammaṃ. ",
  "ja510:9.1": "sabbesamevaṃ hi narānanārinaṃ calāvalaṃ ",
  "ja510:9.2": "pāṇabhunodha jīvitaṃ, ",
  "ja510:9.3": "paṭova dhuttassa dumova kūlajo ",
  "ja510:9.4": "tamme matī hoti carāmi dhammaṃ. ",
  "ja510:10.1": "dumapphalāneva patanti māṇavā ",
  "ja510:10.2": "daharā ca vuddhā ca sarīrabhedā, ",
  "ja510:10.3": "nāriyo narā majjhimaporisā ca ",
  "ja510:10.4": "tamme matī hoti carāmi dhammaṃ. ",
  "ja510:11.1": "nāyaṃ vayo tārakarājasannibho ",
  "ja510:11.2": "yādabbhatītaṃ gatamevadāni taṃ, ",
  "ja510:11.3": "jiṇṇassa hi natthi ratī kuto sukhaṃ ",
  "ja510:11.4": "tamme matī hoti carāmi dhammaṃ. ",
  "ja510:12.1": "yakkhā pisācā athavāpi petā ",
  "ja510:12.2": "kupitāpi te assasantī manusse, ",
  "ja510:12.3": "na maccuno assasitussahanti ",
  "ja510:12.4": "tamme matī hoti carāmi dhammaṃ. ",
  "ja510:13.1": "yakkhe pisāce athavāpi pete ",
  "ja510:13.2": "kupitepi te nijjhapanaṃ karonti, ",
  "ja510:13.3": "na maccuno nijjhapanaṃ karonti ",
  "ja510:13.4": "tamme matī hoti carāmi dhammaṃ. ",
  "ja510:14.1": "aparādhake heṭhake dūsake ca ",
  "ja510:14.2": "rājāno daṇḍenti viditvā dosaṃ, ",
  "ja510:14.3": "na maccuno daṇḍayitussahanti ",
  "ja510:14.4": "tamme matī hoti carāmi dhammaṃ. ",
  "ja510:15.1": "aparādhakā dūsakā heṭhakā ca ",
  "ja510:15.2": "labhanti te rājino nijjhapetuṃ, ",
  "ja510:15.3": "na maccuno nijjhapanaṃ karonti ",
  "ja510:15.4": "tamme matī hoti carāmi dhammaṃ. ",
  "ja510:16.1": "na khattiyoti na pi brāhmaṇoti ",
  "ja510:16.2": "na aḍḍhakā balavā tejavāpi, ",
  "ja510:16.3": "na maccurājassa apekhamatthi ",
  "ja510:16.4": "tamme matī hoti carāmi dhammaṃ. ",
  "ja510:17.1": "sīhāca vyagghāva athopi dīpiyo ",
  "ja510:17.2": "pasayha khādanti vipphandamānaṃ, ",
  "ja510:17.3": "na maccuno khādituṃ ",
  "ja510:17.4": "ussahanti tamme matī hoti carāmi dhammaṃ. ",
  "ja510:18.1": "māyakārā raṅgamajjhe karontā ",
  "ja510:18.2": "mohenti cakkhūni janassa tāvade, ",
  "ja510:18.3": "na maccuno mohayitussahanti ",
  "ja510:18.4": "tamme matī hoti carāmi dhammaṃ. ",
  "ja510:19.1": "āsīvisā kupitā uggatejā ",
  "ja510:19.2": "ḍasanti mārentipi te manusse, ",
  "ja510:19.3": "na maccuno ḍasituṃ ",
  "ja510:19.4": "ussahanti tamme matī hoti carāmi dhammaṃ. ",
  "ja510:20.1": "āsīvisā kupitā yaṃ ḍasanti ",
  "ja510:20.2": "tikicchakā tesaṃ visaṃ hananti, ",
  "ja510:20.3": "na maccuno daṭṭhavisaṃ hananti ",
  "ja510:20.4": "tamme matī hoti carāmi dhammaṃ. ",
  "ja510:21.1": "dhammanāri vetaraṇi ca bhojo ",
  "ja510:21.2": "visāni hantvāna bhujaṅgamānaṃ, ",
  "ja510:21.3": "sūyanti te kālakatā tatheva ",
  "ja510:21.4": "tamme matī hoti carāmi dhammaṃ. ",
  "ja510:22.1": "vijjādharā ghoramadhīyamānā ",
  "ja510:22.2": "adassanaṃ osadhehi vajanti, ",
  "ja510:22.3": "na maccurājassa vajantadassanaṃ ",
  "ja510:22.4": "tamme matī hoti carāmi dhammaṃ. ",
  "ja510:23.1": "dhammo have rakkhati dhammacāriṃ ",
  "ja510:23.2": "dhammo suciṇṇo sukhamāvahāti, ",
  "ja510:23.3": "esānisaṃso dhamme suciṇṇe ",
  "ja510:23.4": "na duggatiṃ gacchati dhammacārī. ",
  "ja510:24.1": "na hi dhammo adhammo ca ",
  "ja510:24.2": "ubho samavipākino, ",
  "ja510:24.3": "adhammo nirayaṃ neti ",
  "ja510:24.4": "dhammo pāpeti suggatinti. ",
  "ja510:25.1": "ayogharajātakaṃ. vīsatinipāto ",
  "ja510:26.1": "niṭṭhito. ",
  "ja510:27.1": "tassuddānaṃ: ",
  "ja510:28.1": "mātaṅga sambhūta sivi sirimanto ",
  "ja510:28.2": "rohaṇa haṃsa santigubbo bhallāṭiya, ",
  "ja510:28.3": "somanassa campeyya brahma pañca ",
  "ja510:28.4": "paṇḍita cirassaṃ vata ayogharāni. "
}
