  "ja241:0.3": "10. sigālavaggo ",
  "ja241:0.4": "",
  "ja241:1.1": "sigālo mānatthaddhova ",
  "ja241:1.2": "parivārena atthiko ",
  "ja241:1.3": "pāpuṇī mahatiṃ bhūmiṃ ",
  "ja241:1.4": "rājāsi sabbadāṭhinaṃ ",
  "ja241:2.1": "evamevaṃ manussesu ",
  "ja241:2.2": "yo hoti parivāravā, ",
  "ja241:2.3": "so hi tattha mahā hoti ",
  "ja241:2.4": "sigālo viya dāṭhina’nti ",
  "ja241:3.1": ""
}
