  "ja295:0.3": "",
  "ja295:0.4": "4. jambukhādakajātakaṃ. ",
  "ja295:1.1": "usabhasseva te khandho ",
  "ja295:1.2": "sīhasseva vijamhitaṃ, ",
  "ja295:1.3": "migarāja namotyutthu ",
  "ja295:1.4": "api kiñci labhāmase. ",
  "ja295:2.1": "kulaputtova jānāti ",
  "ja295:2.2": "kulaputte pasaṃsituṃ, ",
  "ja295:2.3": "mayūragīvasaṅkāsa ",
  "ja295:2.4": "ito pariyāhi vāyasa. ",
  "ja295:3.1": "migānaṃ kotthuko anto ",
  "ja295:3.2": "pakkhīnaṃ pana vāyaso, ",
  "ja295:3.3": "eraṇḍo anto rukkhānaṃ ",
  "ja295:3.4": "tayo antā samāgatā’ti. ",
  "ja295:4.1": ""
}
