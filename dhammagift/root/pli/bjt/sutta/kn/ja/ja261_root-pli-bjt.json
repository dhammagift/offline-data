{
  "ja261:0.1": "",
  "ja261:0.2": "",
  "ja261:0.3": "2. padumavaggo ",
  "ja261:0.4": "",
  "ja261:1.1": "yathā kesā ca massu ca ",
  "ja261:1.2": "chinnaṃ chinnaṃ virūhati. ",
  "ja261:1.3": "evaṃ ruhatu te nāsā ",
  "ja261:1.4": "padumaṃ dehi yācito. ",
  "ja261:2.1": "yathā sāradikaṃ bījaṃ ",
  "ja261:2.2": "khette vuttaṃ virūhati, ",
  "ja261:2.3": "evaṃ ruhatu te nāsā ",
  "ja261:2.4": "padumaṃ dehi yācito. ",
  "ja261:3.1": "ubhopi palapantete ",
  "ja261:3.2": "api padumāni dassati, ",
  "ja261:3.3": "vajjraṃ vā te na vā vajjuṃ ",
  "ja261:3.4": "natthi nāsāya rūhanā, ",
  "ja261:3.5": "dehi samma padumāni ",
  "ja261:3.6": "ahaṃ yācāmi yācito. ",
  "ja261:4.1": ""
}
