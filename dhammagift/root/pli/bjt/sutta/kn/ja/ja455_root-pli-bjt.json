{
  "ja455:0.1": "11. ekādasakanipāto ",
  "ja455:0.2": "",
  "ja455:0.3": "",
  "ja455:0.4": "",
  "ja455:1.1": "tassa nāgassa vippavāsena ",
  "ja455:1.2": "virūḷhā sallakī ca kuṭajā ca, ",
  "ja455:1.3": "kuruvindakaravarā bhisasāmā ",
  "ja455:1.4": "nivāte pupphitā ca kaṇikārā. ",
  "ja455:2.1": "kocideva suvaṇṇakāyūrā, ",
  "ja455:2.2": "nāgarājaṃ bharanti piṇḍena, ",
  "ja455:2.3": "yattha rājā rājakumāro vā ",
  "ja455:2.4": "kavacambhihessati asambhīto. ",
  "ja455:3.1": "gaṇhāhi nāga kabaḷaṃ ",
  "ja455:3.2": "mā nāga kisako bhava, ",
  "ja455:3.3": "bahūni rājakiccāni ",
  "ja455:3.4": "yāni nāga karissasi. ",
  "ja455:4.1": "sā nūna sā kapaṇikā ",
  "ja455:4.2": "andhā aparināyikā, ",
  "ja455:4.3": "khāṇuṃ pādena ghaṭṭeti ",
  "ja455:4.4": "giriṃ caṇḍoraṇaṃpati. ",
  "ja455:5.1": "kā nu te sā mahānāga ",
  "ja455:5.2": "andhā aparināyikā, ",
  "ja455:5.3": "khāṇuṃ pādena ghaṭṭeti ",
  "ja455:5.4": "giriṃ caṇḍoraṇaṃpati. ",
  "ja455:6.1": "mātā me sā mahārāja ",
  "ja455:6.2": "andhā aparināyikā, ",
  "ja455:6.3": "khāṇuṃ pādena ghaṭṭeti ",
  "ja455:6.4": "giriṃ caṇḍoraṇaṃpati. ",
  "ja455:7.1": "muñcathetaṃ mahānāgaṃ ",
  "ja455:7.2": "yo yaṃ bharati mātaraṃ, ",
  "ja455:7.3": "sametu mātarā nāgo ",
  "ja455:7.4": "saha sabbehi ñātihi. ",
  "ja455:8.1": "muttoca bandhanā nāgo ",
  "ja455:8.2": "kāsirājena pesito, ",
  "ja455:8.3": "muhuttaṃ vissamitvāna ",
  "ja455:8.4": "agamā yena pabbato. ",
  "ja455:9.1": "tato so naliniṃ gantvā ",
  "ja455:9.2": "sītaṃ tuñjarasevitaṃ, soṇḍāya ",
  "ja455:9.3": "udakamāhatvā ",
  "ja455:9.4": "mātaraṃ abhisiñcatha. ",
  "ja455:10.1": "koyaṃ anariyo devo ",
  "ja455:10.2": "akālena pi vassati, ",
  "ja455:10.3": "gato me atrajo putto ",
  "ja455:10.4": "yo mayhaṃ paricārako. ",
  "ja455:11.1": "uṭṭhehi amma kiṃ sesi ",
  "ja455:11.2": "āgato tyābhamatrajo, ",
  "ja455:11.3": "muttomhi kāsirājena ",
  "ja455:11.4": "vedehena yasassinā. ",
  "ja455:12.1": "ciraṃ jīvatu so rājā ",
  "ja455:12.2": "kāsīnaṃ raṭṭhavaddhano, ",
  "ja455:12.3": "yo me puttaṃ amocesi ",
  "ja455:12.4": "sadā vuddhāpacāyikanti. ",
  "ja455:13.1": "mātuposakajātakaṃ. "
}
