  "ja190:0.4": "9. sīhacammajātakaṃ. ",
  "ja190:1.1": "passa saddhāya sīlassa cāgassa ca ayaṃ phalaṃ, nāgo nāvāya vaṇṇena saddhaṃ vahati upāsakaṃ. sabbhireva samāsetha sabbhi kubbetha santhavaṃ, sataṃ hi sannivāsena sotthiṃ gacchati nahāpito’ti. ",
  "ja190:1.2": "",
  "ja190:1.3": "",
  "ja190:1.4": "",
  "ja190:2.1": "",
  "ja190:2.2": "",
  "ja190:2.3": "",
  "ja190:2.4": "",
  "ja190:3.1": "",
  "ja190:3.2": "10. sīlānisaṃsajātakaṃ. asadisavaggo catuttho. ",
  "ja190:4.1": "tassuddānaṃ: ",
  "ja190:5.1": "dhanuggahakuñjaraapparaso ",
  "ja190:5.2": "giridattamanāvilacittavaraṃ, ",
  "ja190:5.3": "dadhivāhanajambukasīhanakho haritayavanāgavarena ",
  "ja190:5.4": "dasa. "
}
