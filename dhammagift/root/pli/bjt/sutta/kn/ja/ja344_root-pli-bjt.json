  "ja344:0.3": "",
  "ja344:0.4": "3. kuntinījātakaṃ. ",
  "ja344:1.1": "yo nīliyaṃ maṇḍayati ",
  "ja344:1.2": "saṇḍāsena vihaññati, ",
  "ja344:1.3": "tassa sā vasamanvetu ",
  "ja344:1.4": "yā te ambe avāhari. ",
  "ja344:2.1": "vīsaṃ vā pañcavīsaṃ vā ",
  "ja344:2.2": "ūnatiṃsaṃva jātiyā, ",
  "ja344:2.3": "tādisā patimāladdhā ",
  "ja344:2.4": "yā te ambe avāhari. ",
  "ja344:3.1": "dīghaṃ gacchatu addhānaṃ ",
  "ja344:3.2": "ekikā abhisāriyā, ",
  "ja344:3.3": "saṅkete pati māddasa ",
  "ja344:3.4": "yā te ambe avāhari. ",
  "ja344:4.1": "alaṅkatā suvasanā ",
  "ja344:4.2": "mālinī candanussadā, ",
  "ja344:4.3": "ekikā sayane setu ",
  "ja344:4.4": "yā te ambe avāharīti. ",
  "ja344:5.1": ""
}
