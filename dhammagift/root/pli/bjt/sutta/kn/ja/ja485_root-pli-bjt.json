  "ja485:0.4": "1. sālikedārajātakaṃ. ",
  "ja485:1.1": "upanīyatidaṃ maññe ",
  "ja485:1.2": "cande lohitamadena ",
  "ja485:1.3": "majjāmi, vijahāmi jivataṃ ",
  "ja485:1.4": "pāṇā me cande nirujjhanti. ",
  "ja485:2.1": "osadhi me dukkhaṃ me hadayaṃ ",
  "ja485:2.2": "me dayhate nitammāmi, ",
  "ja485:2.3": "tava candiyā socantiyā ",
  "ja485:2.4": "na naṃ aññehi sokehi. ",
  "ja485:3.1": "tiṇamiva vanamiva miyyāmi ",
  "ja485:3.2": "nadī aparipuṇaṇiyāva sussāmi, ",
  "ja485:3.3": "tava candiyā socantiyā ",
  "ja485:3.4": "na naṃ aññehi sokehi. ",
  "ja485:4.1": "vassaṃva sare pāde ",
  "ja485:4.2": "imāni massūni vattare mayhaṃ, ",
  "ja485:4.3": "tava candiyā socantiyā ",
  "ja485:4.4": "na naṃ aññehi sokehi. ",
  "ja485:5.1": "pāposi kho rājaputta ",
  "ja485:5.2": "yo me icchitapatiṃ varākiyā, ",
  "ja485:5.3": "vijjhi vanamūlasmiṃ ",
  "ja485:5.4": "so yaṃ viddho chamā seti. ",
  "ja485:6.1": "imaṃ mayhaṃ hadayasokaṃ ",
  "ja485:6.2": "paṭimuñcatu rājaputta tava mātā, ",
  "ja485:6.3": "yo mayhaṃ hadayasoko ",
  "ja485:6.4": "kimpurisaṃ avekkhamānāya. ",
  "ja485:7.1": "imaṃ mayhaṃ hadayasokaṃ ",
  "ja485:7.2": "paṭimuñcatu rājaputta tava jātā, ",
  "ja485:7.3": "yo mayhaṃ hadayasoko ",
  "ja485:7.4": "kimpurisaṃ avekkhamānāya. ",
  "ja485:8.1": "mā ca putte mā ca patiṃ ",
  "ja485:8.2": "addakkhi rājaputta tava mātā, ",
  "ja485:8.3": "yo kimpurisaṃ avadhi ",
  "ja485:8.4": "adūsakaṃ mayhakāmāhi. ",
  "ja485:9.1": "mā ca putte mā ca patiṃ5 ",
  "ja485:9.2": "addakkhi rājaputta tava jāyā, ",
  "ja485:9.3": "yo kimpurisaṃ avadhi ",
  "ja485:9.4": "adūsakaṃ mayhakāmāhi. ",
  "ja485:10.1": "mā tuvaṃ cande rujji ",
  "ja485:10.2": "mā soci manatimiramattikkhi, ",
  "ja485:10.3": "mama tvaṃ hohisi bhariyā ",
  "ja485:10.4": "rājakule pūjitā nārī. ",
  "ja485:11.1": "apinūnahaṃ marissaṃ ",
  "ja485:11.2": "nacapanāhaṃ rājaputta tava hessaṃ ",
  "ja485:11.3": "yo kimpurisaṃ avadhi ",
  "ja485:11.4": "adūsakaṃ mayhakāmāhi. ",
  "ja485:12.1": "api bhīruke apijīvitukāmike ",
  "ja485:12.2": "kimpurisi gaccha himavantaṃ, ",
  "ja485:12.3": "tālissatagarabhojane ",
  "ja485:12.4": "araññe taṃ migā ramissanti. ",
  "ja485:13.1": "te pabbatā tāca kandarā ",
  "ja485:13.2": "tā ca giriguhāyo, tattha ",
  "ja485:13.3": "taṃ apassantī ",
  "ja485:13.4": "kiṃpurisa kathaṃ ahaṃ kāsaṃ ",
  "ja485:14.1": "te paṇṇasatthatā ramaṇīyā ",
  "ja485:14.2": "vāḷamigehi anuciṇṇā, ",
  "ja485:14.3": "tattha taṃ apassantī ",
  "ja485:14.4": "kiṃpurisa kathaṃ ahaṃ kāsaṃ ",
  "ja485:15.1": "te pupphasanthāramaṇiyā ",
  "ja485:15.2": "vāḷamigehi anuciṇṇā, ",
  "ja485:15.3": "tattha taṃ apassantī ",
  "ja485:15.4": "kiṃpurisa kathaṃ ahaṃ kāsaṃ ",
  "ja485:16.1": "acchā savanti girivaranadiyo ",
  "ja485:16.2": "kusumābhikiṇṇasotāyo, ",
  "ja485:16.3": "tattha taṃ apassantī ",
  "ja485:16.4": "kiṃpurisa kathaṃ ahaṃ kāsaṃ ",
  "ja485:17.1": "nīlāni himavato pabbatassa ",
  "ja485:17.2": "kūṭāni dassaneyyāni, ",
  "ja485:17.3": "tattha taṃ apassantī ",
  "ja485:17.4": "kimpurisa kathaṃ ahaṃ kāsaṃ ",
  "ja485:18.1": "pītāni himavato pabbatassa ",
  "ja485:18.2": "kūṭāni dassaneyyāni, ",
  "ja485:18.3": "tattha taṃ apassantī ",
  "ja485:18.4": "kimpurisa kathaṃ ahaṃ kāsaṃ ",
  "ja485:19.1": "tambāni himavato pabbatassa ",
  "ja485:19.2": "kūṭāni dassaneyyāni, ",
  "ja485:19.3": "tattha taṃ apassantī ",
  "ja485:19.4": "kimpurisa kathaṃ ahaṃ kāsaṃ ",
  "ja485:20.1": "tuṅgāni himavato pabbatassa ",
  "ja485:20.2": "kūṭāni dassaneyyāni, ",
  "ja485:20.3": "tattha taṃ apassantī ",
  "ja485:20.4": "kimpurisa kathaṃ ahaṃ kāsaṃ ",
  "ja485:21.1": "setāni himavato pabbatassa ",
  "ja485:21.2": "kūṭāni dassaneyyāni, ",
  "ja485:21.3": "tattha taṃ apassantī ",
  "ja485:21.4": "kimpurisa kathaṃ ahaṃ kāsaṃ. ",
  "ja485:22.1": "citrāni himavato pabbatassa ",
  "ja485:22.2": "kūṭāni dassaneyyāni, ",
  "ja485:22.3": "tattha taṃ apassantī ",
  "ja485:22.4": "kimpurisa kathaṃ ahaṃ kāsaṃ. ",
  "ja485:23.1": "yakkhagaṇasevite gandhamādane ",
  "ja485:23.2": "osadhehi sañachanne, ",
  "ja485:23.3": "tattha taṃ apassantī ",
  "ja485:23.4": "kimpurisa kathaṃ ahaṃ kāsaṃ ",
  "ja485:24.1": "kimpurisasevite gandhamādane ",
  "ja485:24.2": "osadhehi sañachanne, ",
  "ja485:24.3": "tattha taṃ apassantī ",
  "ja485:24.4": "kimpurisa kathaṃ ahaṃ kāsaṃ ",
  "ja485:25.1": "vande te pāde ayira brahme ",
  "ja485:25.2": "yo me icchitapatiṃ varākiyā, ",
  "ja485:25.3": "amatena abhisiñci ",
  "ja485:25.4": "samāgatasmiṃ piyatamena ",
  "ja485:26.1": "vicarāma dāni girivaranadiyo ",
  "ja485:26.2": "kusumābhikiṇṇasotāyo, ",
  "ja485:26.3": "nānādumavasanāyo ",
  "ja485:26.4": "piyaṃvadā aññamaññassāti. ",
  "ja485:27.1": ""
}
