  "ja360:0.4": "",
  "ja360:1.1": "vāti gandho timirānaṃ ",
  "ja360:1.2": "kusamuddo ca ghosavā, ",
  "ja360:1.3": "dūre ito hi susandhi ",
  "ja360:1.4": "tambakāmā tudanti maṃ ",
  "ja360:2.1": "kathaṃ samuddamatari ",
  "ja360:2.2": "kathaṃ addakkhi serumaṃ, ",
  "ja360:2.3": "kathaṃ tassā ca tuyhañca ",
  "ja360:2.4": "ahu saggasamāgamo. ",
  "ja360:3.1": "bharukacchā payātānaṃ ",
  "ja360:3.2": "vāṇijāna dhanesinaṃ, ",
  "ja360:3.3": "makarehambhidā nāvā ",
  "ja360:3.4": "phalakenāhamaplaviṃ. ",
  "ja360:4.1": "sā maṃ saṇhena mudunā ",
  "ja360:4.2": "niccaṃ candanagandhinī, ",
  "ja360:4.3": "aṅkena uddharī bhaddā ",
  "ja360:4.4": "mātā puttaṃva orasaṃ. ",
  "ja360:5.1": "sāmaṃ annena pāṇena ",
  "ja360:5.2": "vatthena sayanena ca, ",
  "ja360:5.3": "attanāpi ca maddakkhi ",
  "ja360:5.4": "evaṃ tambi vijānahīti. ",
  "ja360:6.1": "susandhijātakaṃ. ",
  "ja360:6.2": "maṇikuṇḍalavaggo paṭhamo. ",
  "ja360:7.1": "tassuddānaṃ: ",
  "ja360:8.1": "athajinavaroharitaṃ tiṇako ",
  "ja360:8.2": "athabhinnapalavo uragovaghato, ",
  "ja360:8.3": "dariyā puna kuñjara bhūnahatā ",
  "ja360:8.4": "migaputtamasaggavarena dasa. "
}
