  "ja50:1.1": "dummedhānaṃ sahassena ",
  "ja50:1.2": "yañño me upayācito, ",
  "ja50:1.3": "idāni khohaṃ yajissāmi ",
  "ja50:1.4": "bahū adhammiko jano’ti. ",
  "ja50:2.1": "10. dummedhajātakaṃ. ",
  "ja50:2.2": "atthakāmavaggo pañcamo. ",
  "ja50:3.1": "paṭhamo paṇṇāsako. tassuddānaṃ: ",
  "ja50:4.1": "athamittakamātukapotavaro tathāveḷukaeḷamūgorohiṇī, ",
  "ja50:4.2": "kapivāruṇicetacarā ",
  "ja50:4.3": "ca puna ",
  "ja50:4.4": "tathā tārakayaññacarena dasa ",
  "ja50:5.1": ""
}
