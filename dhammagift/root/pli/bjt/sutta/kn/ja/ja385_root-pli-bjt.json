  "ja385:0.4": "",
  "ja385:1.1": "sace brāhmaṇa gacchasi ",
  "ja385:1.2": "sāketaṃ añjanāvanaṃ, ",
  "ja385:1.3": "vajjāsi nandiyaṃ nāma ",
  "ja385:1.4": "puttaṃ asmākaorasaṃ. ",
  "ja385:1.5": "mātā pitā ca te vuddhā ",
  "ja385:1.6": "te taṃ icchanti passituṃ. ",
  "ja385:2.1": "bhuttā mayā nivāpāni ",
  "ja385:2.2": "rājino pānabhojanaṃ, ",
  "ja385:2.3": "taṃ rājapiṇḍaṃ avabhottuṃ ",
  "ja385:2.4": "nāhaṃ brāhmaṇamussahe. ",
  "ja385:3.1": "odahissāmahaṃ passaṃ ",
  "ja385:3.2": "khurappāṇissa rājino, ",
  "ja385:3.3": "tadāhaṃ sukhito mutto ",
  "ja385:3.4": "api passeyya mātaraṃ. ",
  "ja385:4.1": "migarājā pure āsiṃ ",
  "ja385:4.2": "kosalassa niketave, ",
  "ja385:4.3": "nandiyo nāma nāmena ",
  "ja385:4.4": "abhirūpo catuppado. ",
  "ja385:5.1": "taṃ maṃ vadhitumāgañji ",
  "ja385:5.2": "dāyasmiṃ añjanāvane, ",
  "ja385:5.3": "dhanuṃ adejjhaṃ katvāna ",
  "ja385:5.4": "usuṃ sandhāya kosalo. ",
  "ja385:6.1": "tassāhaṃ odahiṃ passaṃ ",
  "ja385:6.2": "khurappāṇissa rājino, ",
  "ja385:6.3": "tadāhaṃ sukhito mutto ",
  "ja385:6.4": "mātaraṃ daṭṭhumāgato’ti. ",
  "ja385:7.1": "nandiyamigajātakaṃ. ",
  "ja385:7.2": "avāriyavaggo paṭhamo. ",
  "ja385:8.1": "tassuddānaṃ: ",
  "ja385:9.1": "atha kujjharathesabhaketuvaro ",
  "ja385:9.2": "darīmukha sanerutā ca puna, ",
  "ja385:9.3": "āsānandasirī ca sucittavaro ",
  "ja385:9.4": "athadhammikanandi migena dasa. "
}
