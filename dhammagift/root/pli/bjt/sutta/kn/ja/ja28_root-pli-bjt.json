  "ja28:1.1": "manuññameva bhāseyya ",
  "ja28:1.2": "nāmanuññaṃ kudācanaṃ ",
  "ja28:1.3": "manuññaṃ bhāsamānassa ",
  "ja28:1.4": "garubhāraṃ uddadhari, ",
  "ja28:1.5": "dhanañca naṃ alabbhesi ",
  "ja28:1.6": "tenacattamano ahū’ti. ",
  "ja28:2.1": "nandivisālajātakaṃ. "
}
