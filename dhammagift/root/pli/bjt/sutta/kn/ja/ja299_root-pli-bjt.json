  "ja299:1.1": "pure tuvaṃ sīlavataṃ sakāse ",
  "ja299:1.2": "okkandikaṃ kīḷasi assamamhi, ",
  "ja299:1.3": "karohare makkaṭiyāni makkaṭa ",
  "ja299:1.4": "na taṃ mayaṃ sīlavataṃ ramāma. ",
  "ja299:2.1": "sutā hi mayhaṃ paramā visuddhi ",
  "ja299:2.2": "komāyaputtassa bahussutassa, ",
  "ja299:2.3": "mādāni maṃ maññi tuvaṃ yathā pure ",
  "ja299:2.4": "jhānānuyuttā viharāma āvuso. ",
  "ja299:3.1": "sacepi selasmiṃ vapeyya bījaṃ ",
  "ja299:3.2": "devo ca vasse neva hi taṃ ruheyya, ",
  "ja299:3.3": "sutā hi te sā paramā visuddhi ",
  "ja299:3.4": "ārā tuvaṃ makkaṭa jhānabhūmiyāti. ",
  "ja299:4.1": ""
}
