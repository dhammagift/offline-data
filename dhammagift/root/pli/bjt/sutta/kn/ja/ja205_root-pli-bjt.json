  "ja205:0.4": "4. vīrakajātakaṃ. ",
  "ja205:1.1": "sobhati maccho gaṅgeyyo ",
  "ja205:1.2": "atho sobhatī yāmuno, ",
  "ja205:1.3": "catuppadāyaṃ puriso ",
  "ja205:1.4": "nigrodhaparimaṇḍalo, ",
  "ja205:1.5": "īsakāyanagīvo ca ",
  "ja205:1.6": "sabbeva atirocati. ",
  "ja205:2.1": "yaṃ pucchito naṃ taṃ akkhā ",
  "ja205:2.2": "aññaṃ akkhāti pucchito, ",
  "ja205:2.3": "attappasaṃsako poso ",
  "ja205:2.4": "nāyaṃ asmāka ruccatī’ti. ",
  "ja205:3.1": ""
}
