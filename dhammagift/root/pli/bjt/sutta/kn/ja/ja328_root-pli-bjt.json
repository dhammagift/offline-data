  "ja328:0.4": "",
  "ja328:1.1": "kākātījātakaṃ. bahunnaṃ vijjati hoti ",
  "ja328:1.2": "tehi kimme bhavissati, ",
  "ja328:1.3": "tasmā etaṃ na socāmi ",
  "ja328:1.4": "piyaṃ sammillabhāsiniṃ. ",
  "ja328:2.1": "taṃ tañce anusoceyya ",
  "ja328:2.2": "yaṃ yaṃ tassa na vijjati, ",
  "ja328:2.3": "antānamanusoceyya ",
  "ja328:2.4": "sadā maccuvasaṃ gataṃ. ",
  "ja328:3.1": "naheva ṭhitaṃ nāsīnaṃ ",
  "ja328:3.2": "na sayānaṃ na paddhaguṃ, ",
  "ja328:3.3": "yāva pāti nimmisati ",
  "ja328:3.4": "tatrāpi saratī vayo. ",
  "ja328:4.1": "tatthattani vatappaddhe ",
  "ja328:4.2": "vinābhāve asaṃsaye, ",
  "ja328:4.3": "bhūtaṃ sesaṃ dayitabbaṃ ",
  "ja328:4.4": "vītaṃ ananusociyanti. ",
  "ja328:5.1": "ananusociyajātakaṃ. "
}
