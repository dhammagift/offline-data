  "ja162:0.4": "1. indasamānagottajātakaṃ. ",
  "ja162:1.1": "na satthavasmā paramatthi pāpiyo ",
  "ja162:1.2": "yo santhavo kāpurisena hoti, ",
  "ja162:1.3": "santappito sappinā pāyasena ",
  "ja162:1.4": "kicchā kataṃ paṇṇakuṭiṃ adaḍḍhahi. ",
  "ja162:2.1": "na santhavasmā paramatthi seyyo ",
  "ja162:2.2": "yo santhavo sappurisena hoti, ",
  "ja162:2.3": "sīhassa vyagghassa ca dīpino ca ",
  "ja162:2.4": "sāmā mukhaṃ lehati santhavenā’ti. ",
  "ja162:3.1": ""
}
