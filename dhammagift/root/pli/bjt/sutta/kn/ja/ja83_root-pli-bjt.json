  "ja83:1.1": "mittavindajātakaṃ. mitto have sattapadena hoti ",
  "ja83:1.2": "sahāyo pana dvādasakena hoti, ",
  "ja83:1.3": "māsaddhamāsena ca ñāti hoti ",
  "ja83:1.4": "tatuttariṃ antasamopi hoti. ",
  "ja83:1.5": "sohaṃ kathaṃ antasukhassa hetu ",
  "ja83:1.6": "cirasanthutaṃ kālakaṇṇiṃ jaheyyanti. ",
  "ja83:2.1": "kālakaṇṇijātakaṃ. "
}
