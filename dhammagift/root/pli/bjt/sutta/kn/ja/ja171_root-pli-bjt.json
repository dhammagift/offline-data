  "ja171:0.1": "",
  "ja171:0.2": "",
  "ja171:0.3": "3. kalyāṇadhammavaggo ",
  "ja171:0.4": "",
  "ja171:1.1": "kalyāṇadhammoti yadā janinda ",
  "ja171:1.2": "loke samaññā anupāpuṇāti, ",
  "ja171:1.3": "tasmā na hīyetha naro sapañño ",
  "ja171:1.4": "hiriyāpi santo dhuramādiyanti. ",
  "ja171:2.1": "sāyaṃ samaññā idha ma’jjapattā ",
  "ja171:2.2": "kalyāṇadhammoti janinda loke, ",
  "ja171:2.3": "tā’haṃ samekkhaṃ idha pabbajissaṃ. ",
  "ja171:2.4": "na hi ma’tthi chando idha kāmabhoge’ti. ",
  "ja171:3.1": "kalyāṇadhammajātakaṃ. "
}
