  "ja112:0.4": "1. gadrabhapañho. ",
  "ja112:1.1": "yena sattukhilaṅgā ca ",
  "ja112:1.2": "diguṇa palāso ca pupphito, ",
  "ja112:1.3": "yenādāmi tena vadāmi ",
  "ja112:1.4": "yena nādāmi na tena vadāmi ",
  "ja112:1.5": "esa maggo yava majjhakasasa ",
  "ja112:1.6": "etaṃ channapathaṃ vijānāhiti. ",
  "ja112:2.1": ""
}
