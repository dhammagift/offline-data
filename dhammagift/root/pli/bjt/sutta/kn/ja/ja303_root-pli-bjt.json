  "ja303:0.4": "",
  "ja303:1.1": "anuttare kāmaguṇe samiddhe ",
  "ja303:1.2": "bhutvāna pubbe vasi ekarājā, ",
  "ja303:1.3": "sodāni dugge narakambhi khitto ",
  "ja303:1.4": "nappajahe vaṇṇabalaṃ purāṇaṃ. ",
  "ja303:2.1": "pubbeva khanti ca tapo ca mayhaṃ ",
  "ja303:2.2": "sampatthitā dababasenā ahosi, ",
  "ja303:2.3": "taṃdāni laddhāna kathannu rāja ",
  "ja303:2.4": "jahe ahaṃ vaṇṇabalaṃ purāṇaṃ. ",
  "ja303:3.1": "sabbaṃ kireva pariniṭṭhitāni ",
  "ja303:3.2": "yasassinaṃ paññavantaṃ visayha, ",
  "ja303:3.3": "yaso ca laddhā purimaṃ uḷāraṃ ",
  "ja303:3.4": "nappajahe vaṇṇabalaṃ purāṇaṃ. ",
  "ja303:4.1": "panujja dukkhena sukhaṃ janinda ",
  "ja303:4.2": "sukhena cā dukkhamasayhasāhi, ",
  "ja303:4.3": "ubhayattha santo abhinibbutattā ",
  "ja303:4.4": "sukhe ca dukkhe ca bhavanti tulyā’ti ",
  "ja303:5.1": "ekarājajātakaṃ. "
}
