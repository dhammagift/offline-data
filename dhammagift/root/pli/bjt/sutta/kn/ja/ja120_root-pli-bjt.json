  "ja120:0.3": "",
  "ja120:0.4": "9. akālarāvījātakaṃ. ",
  "ja120:1.1": "abaddhā tattha bajjhanti ",
  "ja120:1.2": "yattha bālā pabhāsare, ",
  "ja120:1.3": "baddhāpi tattha muccanti ",
  "ja120:1.4": "yattha dhīrā pahāsare’ti. ",
  "ja120:2.1": "",
  "ja120:2.2": "10. bandhanamokkhajātakaṃ. bhaṃsavaggo dvādasamo. ",
  "ja120:3.1": "tassuddānaṃ: ",
  "ja120:4.1": "athagadrabhasattu cakaṃsasataṃ bahucintisāsikāyātikara, ",
  "ja120:4.2": "ativelavisesamanācariyo ",
  "ja120:4.3": "ca ",
  "ja120:4.4": "dhīrāpabhāsaratena dasa. "
}
