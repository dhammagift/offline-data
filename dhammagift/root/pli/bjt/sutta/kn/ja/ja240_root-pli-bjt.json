  "ja240:0.3": "",
  "ja240:0.4": "9. haritamātujātakaṃ. ",
  "ja240:1.1": "sabbo jano hiṃsito piṅgalena ",
  "ja240:1.2": "tasmiṃ mate paccayaṃ vedayanti, ",
  "ja240:1.3": "piyo nu te āsi akaṇhanetto ",
  "ja240:1.4": "kasmā nu tvaṃ rodasi dvārapāla. ",
  "ja240:2.1": "na me piyo āsi akaṇhanetto ",
  "ja240:2.2": "bhāyāmi paccāgamanāya tassa ",
  "ja240:2.3": "ito gato hiṃseyya maccurājaṃ ",
  "ja240:2.4": "so hiṃsito āneyya puna idha. ",
  "ja240:3.1": "daḍḍho vāhasahassehi ",
  "ja240:3.2": "sitto ghaṭasatehi so, ",
  "ja240:3.3": "parikkhatā ca sā bhūmi ",
  "ja240:3.4": "mā bhāyi nāgamissatī’ti. ",
  "ja240:4.1": "",
  "ja240:4.2": "10. mahāpiṅgalajātakaṃ. upāhanavaggo navamo. ",
  "ja240:5.1": "tassuddānaṃ: ",
  "ja240:6.1": "varupāhanakhujjavikaṇṇakako ",
  "ja240:6.2": "asitābhūyā pañcama ",
  "ja240:6.3": "vacchanakho, dippemavaruttama ",
  "ja240:6.4": "ekapadaṃ. kumināmukhapiṅgalakena dasāti. "
}
