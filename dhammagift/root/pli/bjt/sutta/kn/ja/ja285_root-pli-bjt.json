  "ja285:0.4": "",
  "ja285:1.1": "dariyā sattavassāni ",
  "ja285:1.2": "tiṃsamattā vasāmase, ",
  "ja285:1.3": "hañjema maṇino ābhaṃ ",
  "ja285:1.4": "iti no mantitaṃ ahū. ",
  "ja285:2.1": "yāva yāva nighaṃsāma ",
  "ja285:2.2": "bhiyyo vodāyate maṇi, ",
  "ja285:2.3": "idañcadāni pucchāma ",
  "ja285:2.4": "kiṃ kiccaṃ idha maññasi. ",
  "ja285:3.1": "ayaṃ maṇi veḷuriyo ",
  "ja285:3.2": "akāco vimalo subho, ",
  "ja285:3.3": "nāssa sakkā siriṃ gantuṃ ",
  "ja285:3.4": "apakkamatha sūkarā’ti. ",
  "ja285:4.1": "5. maṇisūkarajātakaṃ. "
}
