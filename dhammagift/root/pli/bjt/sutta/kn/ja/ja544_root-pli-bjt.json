  "ja544:156.4": "yācāmahaṃ patimāhaṃ ajīyyaṃ. ",
  "ja544:157.1": "taṃ sutvā amanusesā ",
  "ja544:157.2": "ayokūṭaṃ paribbhametvāna, ",
  "ja544:157.3": "bhayamassa janayanto ",
  "ja544:157.4": "rājānaṃ idamavoca. ",
  "ja544:158.1": "khujjhassa kho rājakali ",
  "ja544:158.2": "mātāhaṃ matthakaṃ nitāḷemi, ",
  "ja544:158.3": "mā jeṭṭhaputtamavadhī ",
  "ja544:158.4": "adūsakaṃ sīhasaṅkāsaṃ. ",
  "ja544:159.1": "ko te diṭṭhā rājakalī ",
  "ja544:159.2": "puttabhariyāyo haññamānā, ",
  "ja544:159.3": "soṭṭhi va gahapatayo ",
  "ja544:159.4": "adūsakā saggakāmā hi. ",
  "ja544:160.1": "taṃ sutvā khaṇḍahālo ",
  "ja544:160.2": "rājā va abbhutamidaṃ disvāna, ",
  "ja544:160.3": "sabbesaṃ bandhanāni mocesuṃ ",
  "ja544:160.4": "yathā taṃ apāpānaṃ. ",
  "ja544:161.1": "sabbesu vippamuttesu ",
  "ja544:161.2": "ye ca tattha samāgatā tadā āsuṃ, ",
  "ja544:161.3": "sabbe ekekaleḍḍukamadaṃsu ",
  "ja544:161.4": "esa vadho khaṇḍahālassa. ",
  "ja544:162.1": "sabbe patiṃsu nirayaṃ ",
  "ja544:162.2": "yathā taṃ pāpakaṃ karitvāna, ",
  "ja544:162.3": "nahi pāpakammaṃ katvā ",
  "ja544:162.4": "labbhā sugatiṃ ito gantuṃ. ",
  "ja544:163.1": "sabbesu vippamuttesu ",
  "ja544:163.2": "ye ca tattha samāgatā tadā āsuṃ, ",
  "ja544:163.3": "candaṃ abhisiñciṃsu ",
  "ja544:163.4": "samāgatā rājaparisā ca. ",
  "ja544:164.1": "sabbesu vippamuttesu ",
  "ja544:164.2": "ye ca tattha samāgatā tadā āsuṃ, ",
  "ja544:164.3": "candaṃ abhisiñciṃsu ",
  "ja544:164.4": "samāgatā rājakaññāyo. ",
  "ja544:165.1": "sabbesu vippamuttesu ",
  "ja544:165.2": "ye ca tattha samāgatā tadā āsuṃ, ",
  "ja544:165.3": "candaṃ abhisiñciṃsu ",
  "ja544:165.4": "samāgatā devaparisā ca. ",
  "ja544:166.1": "sabbesu vippamuttesu ",
  "ja544:166.2": "ye ca tattha samāgatā tadā āsuṃ, ",
  "ja544:166.3": "candaṃ abhisiñciṃsu ",
  "ja544:166.4": "samāgatā devakaññāyo. ",
  "ja544:167.1": "sabbesu vippamuttesu ",
  "ja544:167.2": "ye ca tattha samāgatā tadā āsuṃ, ",
  "ja544:167.3": "celukkhepamakāruṃ ",
  "ja544:167.4": "samāgatā rājaparisā ca. ",
  "ja544:168.1": "sabbesu vippamuttesu ",
  "ja544:168.2": "ye ca tattha samāgatā tadā āsuṃ, ",
  "ja544:168.3": "celukkhepamakāruṃ ",
  "ja544:168.4": "samāgatā rājakaññāyo. ",
  "ja544:169.1": "sabbesu vippamuttesu ",
  "ja544:169.2": "ye ca tattha samāgatā tadā āsuṃ, ",
  "ja544:169.3": "celukkhepamakāruṃ ",
  "ja544:169.4": "samāgatā devaparisā ca. ",
  "ja544:170.1": "sabbesu vippamuttesu ",
  "ja544:170.2": "ye ca tattha samāgatā tadā āsuṃ, ",
  "ja544:170.3": "celukkhepamakāruṃ ",
  "ja544:170.4": "samāgatā devakaññāyo. ",
  "ja544:171.1": "sabbesu vippamuttesu ",
  "ja544:171.2": "bahu ānandano ahu ",
  "ja544:171.3": "vaṃso, nandippavesi nagaraṃ ",
  "ja544:171.4": "bandhanā mokkho aghositthāti. ",
  "ja544:172.1": "khaṇḍahālajātakaṃ pañcamaṃ. "
}
