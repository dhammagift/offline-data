  "ja544:0.4": "5. khaṇḍahālajātakaṃ. ",
  "ja544:1.1": "rājāsi luddakammo ",
  "ja544:1.2": "ekarājāti pupphavatiyā, ",
  "ja544:1.3": "so pucchi brahmabandhuṃ ",
  "ja544:1.4": "khaṇḍahālaṃ purohitaṃ mūḷhaṃ. ",
  "ja544:2.1": "saggānamaggamācikkha ",
  "ja544:2.2": "tvaṃsi brāhmaṇa dhammavinayakusalo, ",
  "ja544:2.3": "yathā ito vajanti sugatiṃ ",
  "ja544:2.4": "narā puññāni katvāna. ",
  "ja544:3.1": "atidānaṃ daditvāna ",
  "ja544:3.2": "avajjhe deva ghātetvā, ",
  "ja544:3.3": "evaṃ vajanti sugatiṃ ",
  "ja544:3.4": "narā puññāni katvāna. ",
  "ja544:4.1": "kiṃ pana taṃ atidānaṃ ",
  "ja544:4.2": "ke ca avajjhā imasmiṃ lokasmiṃ, ",
  "ja544:4.3": "etañca kho no akkhāhi ",
  "ja544:4.4": "yajissāma dadāma dānāni. ",
  "ja544:5.1": "puttehi deva yajitabbaṃ ",
  "ja544:5.2": "mahesīhi negamehi ca ",
  "ja544:5.3": "usabhehi, ājānīyehi catūhi ",
  "ja544:5.4": "sabbacatukkena deva yajitabbaṃ. ",
  "ja544:6.1": "taṃ sutvā antepure ",
  "ja544:6.2": "kumārā ca mahesiyo ca haññantu, ",
  "ja544:6.3": "eko ahosi nigghoso ",
  "ja544:6.4": "bhesmā accuggato saddo. ",
  "ja544:7.1": "gacchatha vadetha kumāre ",
  "ja544:7.2": "candaṃ suriyaṃ ca bhaddasenañca, ",
  "ja544:7.3": "sūrañca vāmagottaṃ ",
  "ja544:7.4": "pasurā kira hotha yaññatthāya. ",
  "ja544:8.1": "kumāriyopi vadetha ",
  "ja544:8.2": "upaseniṃ kokilañca muditañca, ",
  "ja544:8.3": "nandañcāpi kumāriṃ ",
  "ja544:8.4": "pasurā kira bhotha yaññatthāya. ",
  "ja544:9.1": "vijayampi mayhaṃ mahesiṃ ",
  "ja544:9.2": "erāvatiṃ kesinaṃ sunandañca, ",
  "ja544:9.3": "lakkhaṇavarūpapannā ",
  "ja544:9.4": "pasurā kira hotha yaññatthāya. ",
