{
  "ja161:0.1": "",
  "ja161:0.2": "",
  "ja161:0.3": "2. santhavavaggo ",
  "ja161:0.4": "",
  "ja161:1.1": "na santhavaṃ kāpurisena kayirā ",
  "ja161:1.2": "ariyo hi ariyena pajānamatthaṃ ",
  "ja161:1.3": "virānuvutthopi karoti pāpaṃ ",
  "ja161:1.4": "gajo yathā indasamānagottaṃ. ",
  "ja161:2.1": "yaṃtveva jaññā sadiso mamanti ",
  "ja161:2.2": "sīlena paññāya sutena cāpi. ",
  "ja161:2.3": "teneva mettiṃ kayirātha saddhiṃ, ",
  "ja161:2.4": "sukhāvaho sappurisena saṅgamoti. ",
  "ja161:3.1": "1. indasamānagottajātakaṃ. "
}
