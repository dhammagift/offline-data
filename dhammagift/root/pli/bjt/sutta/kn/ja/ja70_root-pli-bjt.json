  "ja70:0.3": "",
  "ja70:0.4": "9. visavantajātakaṃ. ",
  "ja70:1.1": "na taṃ jitaṃ sādhu jitaṃ ",
  "ja70:1.2": "yaṃ jitaṃ avajīyati, ",
  "ja70:1.3": "taṃ kho jitaṃ sādhu jitaṃ ",
  "ja70:1.4": "yaṃ jitaṃ nāvajīyatīti. ",
  "ja70:2.1": "",
  "ja70:2.2": "10. kuddālajātakaṃ. itthivaggo sattamo. ",
  "ja70:3.1": "tassuddānaṃ: ",
  "ja70:4.1": "sikhī sabbaghasopi ca vīṇavaro ",
  "ja70:4.2": "pisunamittabhedikānandinadī, mudulakkhaṇasodariyācamano ",
  "ja70:4.3": "visasādhujitena ",
  "ja70:4.4": "bhavanti dasa. "
}
