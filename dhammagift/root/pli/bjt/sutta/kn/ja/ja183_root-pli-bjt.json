  "ja183:0.4": "",
  "ja183:1.1": "vāḷodakaṃ apparasaṃ nihīnaṃ ",
  "ja183:1.2": "pītvā mado jāyati gadrabhānaṃ, ",
  "ja183:1.3": "imañca pītvāna rasaṃ paṇītaṃ ",
  "ja183:1.4": "mado na sañjāyati sindhavānaṃ. ",
  "ja183:2.1": "appaṃ pivitvāna nibhinajacco ",
  "ja183:2.2": "so majjati tena janinda phuṭṭho, ",
  "ja183:2.3": "dhorayhasīlo ca kulambhi jāto ",
  "ja183:2.4": "na majjati aggarasaṃ pivitvā’ti. ",
  "ja183:3.1": "3. vāḷodakajātakaṃ. "
}
