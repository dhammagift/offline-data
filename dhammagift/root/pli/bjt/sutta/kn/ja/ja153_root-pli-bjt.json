  "ja153:0.4": "2. sigālajātakaṃ. ",
  "ja153:1.1": "catuppado ahaṃ samma ",
  "ja153:1.2": "tvampi samma catuppado, ",
  "ja153:1.3": "ehi sīha nivattassu ",
  "ja153:1.4": "kinnu bhīto palāyasī. ",
  "ja153:2.1": "asuci pūtilomosi ",
  "ja153:2.2": "duggandho vāsi sūkara, ",
  "ja153:2.3": "sace yujjhitukāmosi ",
  "ja153:2.4": "jayaṃ samma dadāmi teti. ",
  "ja153:3.1": ""
}
