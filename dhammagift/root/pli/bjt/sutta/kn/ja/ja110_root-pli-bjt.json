  "ja110:0.4": "",
  "ja110:1.1": "sabbasaṃhārako natthi ",
  "ja110:1.2": "suddhaṃ kaṅgu pavāyati. ",
  "ja110:1.3": "alikaṃ bhāsati yaṃ dhuttī ",
  "ja110:1.4": "saccamāha mahallikāti. ",
  "ja110:2.1": "sabbasaṃhārakapañho. ",
  "ja110:2.2": "parosatavaggo ekādasamo. ",
  "ja110:3.1": "tassuddānaṃ: ",
  "ja110:4.1": "saparosatatāyitaverī puna ",
  "ja110:4.2": "bhamacakkatha ",
  "ja110:4.3": "nāgasirivhayavano, sukhakañcavatasippakabāhiyā ",
  "ja110:4.4": "kuṇḍapūvamahallikakā ca dasa. "
}
