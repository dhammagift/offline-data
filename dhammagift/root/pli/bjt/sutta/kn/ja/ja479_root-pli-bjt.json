  "ja479:0.1": "",
  "ja479:0.2": "",
  "ja479:0.3": "",
  "ja479:0.4": "",
  "ja479:1.1": "rājā kāliṅgo cakkavattī ",
  "ja479:1.2": "dhammena paṭhavimanusāsaṃ, ",
  "ja479:1.3": "agamā bodhisamīpaṃ ",
  "ja479:1.4": "nāgena mahānubhāvena. ",
  "ja479:2.1": "kāliṅgo bhāradvājo ",
  "ja479:2.2": "rājānaṃ kāliṅgaṃ samaṇakolaññaṃ, ",
  "ja479:2.3": "cakkaṃ vattayato pariggahetvā ",
  "ja479:2.4": "pañjalī idamavoca. ",
  "ja479:3.1": "paccoroha mahārāja ",
  "ja479:3.2": "bhūmibhāgo yathā samanugīto, ",
  "ja479:3.3": "idha anadhivarā buddhā ",
  "ja479:3.4": "abhisambuddhā virocanti. ",
  "ja479:4.1": "padakkhiṇato āvaṭṭā ",
  "ja479:4.2": "tiṇalatā asmiṃ bhūmibhāgasmiṃ, ",
  "ja479:4.3": "puthuviyā ayaṃ maṇḍo ",
  "ja479:4.4": "iti no sutaṃ mahārāja. ",
  "ja479:5.1": "sāgarapariyantāya ",
  "ja479:5.2": "mediniyā sabbabhūtadharaṇiyā, ",
  "ja479:5.3": "puthuviyā ayaṃ maṇḍo ",
  "ja479:5.4": "orohitvā namo karohi. ",
  "ja479:6.1": "ye te bhavanti nāgā ",
  "ja479:6.2": "abhijātā mātito ca pitito ca, ",
  "ja479:6.3": "ettāvatā padesaṃ te ",
  "ja479:6.4": "nāgā nevamupayanti ",
  "ja479:7.1": "abhijāto te nāgo kāmaṃ ",
  "ja479:7.2": "pesehi kuñjaraṃ dantiṃ, ",
  "ja479:7.3": "ettāvatā padeso ",
  "ja479:7.4": "sakkā nāgena mupagantuṃ. ",
  "ja479:8.1": "taṃ sutvā rājā kāliṅgo ",
  "ja479:8.2": "veyyañjanikavaco nisāmetvā ",
  "ja479:8.3": "saṃpesesi nāgaṃ ñassāmamayaṃ yathā ",
  "ja479:8.4": "idaṃ vacanaṃ. ",
  "ja479:9.1": "saṃpesito ca raññā ",
  "ja479:9.2": "nāgo koñco ca abhinaditvāna, ",
  "ja479:9.3": "paṭisakkitvā nisīdi ",
  "ja479:9.4": "garubhāraṃ asahamāno. ",
  "ja479:10.1": "kāliṅgohāradvājo ",
  "ja479:10.2": "nāgaṃ khīṇāyukaṃ viditvāna, ",
  "ja479:10.3": "rājānaṃ kāliṅgaṃ ",
  "ja479:10.4": "taramāno ajjhabhāsittha. ",
  "ja479:10.5": "aññaṃ saṅkama nāgaṃ ",
  "ja479:10.6": "nāgo khīṇāyuko mahārāja. ",
  "ja479:11.1": "taṃ sutvā kāliṅgo ",
  "ja479:11.2": "taramāno saṅkami nāgaṃ ",
  "ja479:11.3": "saṅkante ca rañño, ",
  "ja479:11.4": "nāgo tattheva pati bhūmyā ",
  "ja479:11.5": "veyyañajanikavaco ",
  "ja479:11.6": "yathā tathā ahu nāgo. kāliṅgabhāradvājaṃ ",
  "ja479:12.1": "kāliṅgo ",
  "ja479:12.2": "brāhmaṇaṃ idamamoca ",
  "ja479:12.3": "tvamevāsi sambuddho ",
  "ja479:12.4": "sabbaññū sabbadassāvī. ",
  "ja479:13.1": "taṃ vacanaṃ anadhivāsento kāliṅgo ",
  "ja479:13.2": "brāhmaṇo idamavoca, ",
  "ja479:13.3": "veyyañjanikā hi mayaṃ ",
  "ja479:13.4": "buddhā sabbaññunova mahārāja ",
  "ja479:14.1": "sabbaññū sabbavidū ca ",
  "ja479:14.2": "buddhā na lakkhaṇena jānanti, ",
  "ja479:14.3": "āgamabalasāhi mayaṃ ",
  "ja479:14.4": "buddhā sabbaṃ pajānanti. ",
  "ja479:15.1": "mahāyitvāna sambodhiṃ ",
  "ja479:15.2": "nānā turiyehi vajjamānehi, ",
  "ja479:15.3": "mālāgandhavilepanaṃ āharitvā ",
  "ja479:15.4": "pākāraparikkhepaṃ kāresi. ",
  "ja479:16.1": "saṭṭhavāhasahassānaṃ ",
  "ja479:16.2": "pupphānaṃ sannipātayi, ",
  "ja479:16.3": "pūjesi rājā kāliṅgo ",
  "ja479:16.4": "bodhimaṇḍavaruttame’ti. ",
  "ja479:17.1": "kāliṅgabodhijātakaṃ. "
}
