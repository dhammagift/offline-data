{
  "ja301:0.1": "",
  "ja301:0.2": "4. catukkanipāto ",
  "ja301:0.3": "1. vivaravaggo ",
  "ja301:0.4": "",
  "ja301:1.1": "vivaratha imāsaṃ dvāraṃ ",
  "ja301:1.2": "nagaraṃ pavisituṃ mayā, aruṇarājassa ",
  "ja301:1.3": "sīhena susiṭṭhena ",
  "ja301:1.4": "surakkhitaṃ nandisenena. ",
  "ja301:2.1": "jayo kaliṅgānaṃ asayhasāhinaṃ ",
  "ja301:2.2": "parājayo anayo assakānaṃ, ",
  "ja301:2.3": "icceva te bhāsitaṃ brahmacārī ",
  "ja301:2.4": "na ujajubhūtā vitathaṃ bhaṇanti ",
  "ja301:3.1": "devā musāvādamupātivattā ",
  "ja301:3.2": "saccaṃ dhanaṃ paramaṃ tesu sakka, ",
  "ja301:3.3": "taṃ te musābhāsitaṃ devarāja ",
  "ja301:3.4": "kiṃ vā paṭicca maghavā mahinda. ",
  "ja301:4.1": "nanu te sutaṃ brāhmaṇa bhaññamāne ",
  "ja301:4.2": "dvo na issanti purisaparakkamassa, ",
  "ja301:4.3": "damo samādhi manaso adejjho ",
  "ja301:4.4": "avyaggatā nikkhamanañca kāle, ",
  "ja301:4.5": "daḷhañca viriyaṃ purisaparakkamo ca ",
  "ja301:4.6": "teneva āsi vijayo assakānanti. ",
  "ja301:5.1": ""
}
