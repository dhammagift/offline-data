  "ja489:0.3": "",
  "ja489:0.4": "5. bhisajātakaṃ. ",
  "ja489:1.1": "mahesi rucino bhariyā ",
  "ja489:1.2": "ānītā paṭhamaṃ ahaṃ. ",
  "ja489:1.3": "dasavasassahasasāni ",
  "ja489:1.4": "yaṃ maṃ surucimānayi. ",
  "ja489:2.1": "sāhaṃ brāhmaṇa rājānaṃ ",
  "ja489:2.2": "vedehaṃ mithilaggahaṃ ",
  "ja489:2.3": "nābhijānāmi kāyena ",
  "ja489:2.4": "vācāya udacetasā ",
  "ja489:2.5": "suruciṃ atimaññittho ",
  "ja489:2.6": "āvivā yadivā raho. ",
  "ja489:3.1": "etena saccavajjena ",
  "ja489:3.2": "putto uppajjataṃ ise, ",
  "ja489:3.3": "musā me bhaṇamānāya ",
  "ja489:3.4": "muddhā phalatu sattadhā. ",
  "ja489:4.1": "bhattumanāpassa pitā mātā ",
  "ja489:4.2": "cāpi suvāmino, ",
  "ja489:4.3": "te maṃ brahme vinetāro ",
  "ja489:4.4": "yāva aṭṭhaṃsu jīvite. ",
  "ja489:5.1": "sāhaṃ abhiṃsāratinī ",
  "ja489:5.2": "kāmaso dhammacāriṇi, ",
  "ja489:5.3": "sakkaccaṃ te upaṭṭhāsiṃ ",
  "ja489:5.4": "rattindivamatanditā. ",
  "ja489:6.1": "etena saccavajjena ",
  "ja489:6.2": "putto uppajjataṃ ise, ",
  "ja489:6.3": "musā me bhaṇamānāya ",
  "ja489:6.4": "muddhā phalatu sattadhā. ",
  "ja489:7.1": "soḷasitthisahassāni ",
  "ja489:7.2": "sahabhariyāni brāhmaṇa, ",
  "ja489:7.3": "tāsu issā vā kodho vā ",
  "ja489:7.4": "nāhu mayhaṃ kudācanaṃ. ",
  "ja489:8.1": "hitena tāsaṃ nandāmi ",
  "ja489:8.2": "naca me kāci appiyā ",
  "ja489:8.3": "attānaṃ vānukampāmi ",
  "ja489:8.4": "sadā sabbā sapattiyo. ",
  "ja489:9.1": "etena saccavajjena ",
  "ja489:9.2": "putto uppajjataṃ ise, ",
  "ja489:9.3": "musā me bhaṇamānāya ",
  "ja489:9.4": "muddhā phalatu sattadhā. ",
  "ja489:10.1": "dāse kammakare pesse ",
  "ja489:10.2": "ye caññe anujīvino, ",
  "ja489:10.3": "posemi sahadhammena ",
  "ja489:10.4": "sadā pamuditindriyā ",
  "ja489:11.1": "etena saccavajjena ",
  "ja489:11.2": "putto uppajjataṃ ise, ",
  "ja489:11.3": "musā me bhaṇamānāya ",
  "ja489:11.4": "muddhā phalatu sattadhā. ",
  "ja489:12.1": "samaṇe brāhmaṇe cāpi ",
  "ja489:12.2": "aññe vāpi vaṇibbake, ",
  "ja489:12.3": "tappemi annapānena ",
  "ja489:12.4": "sadā payatapāṇinī. ",
  "ja489:13.1": "etena saccavajjena ",
  "ja489:13.2": "putto uppajjataṃ ise, ",
  "ja489:13.3": "musā me bhaṇamānāya ",
  "ja489:13.4": "muddhā phalatu sattadhā. ",
  "ja489:14.1": "cātuddasī paṇṇarasi ",
  "ja489:14.2": "yāva pakkhassa aṭṭhamī, ",
  "ja489:14.3": "pāṭihāriyapakkhañca ",
  "ja489:14.4": "aṭṭhaṅgasusamāhitaṃ. ",
  "ja489:14.5": "uposathaṃ upavasāmi ",
  "ja489:14.6": "sadā sīlesu saṃvutā. ",
  "ja489:15.1": "etena saccavajjena ",
  "ja489:15.2": "putto uppajjataṃ ise, ",
  "ja489:15.3": "musā me bhaṇamānāya ",
  "ja489:15.4": "muddhā phalatu sattadhā. ",
  "ja489:16.1": "sabbeva te dhammaguṇā ",
  "ja489:16.2": "rājaputti yasassini, ",
  "ja489:16.3": "saṃvijjanti tayi bhadde ",
  "ja489:16.4": "ye tvaṃ kittesi attani. ",
  "ja489:17.1": "khattiyo jātisampanno ",
  "ja489:17.2": "abhijāto sasassimā, ",
  "ja489:17.3": "dhammarājā videhānaṃ ",
  "ja489:17.4": "putto uppajjate tavaṃ, ",
  "ja489:18.1": "rummi rajojalladharo ",
  "ja489:18.2": "aghe vehāsayaṃ ṭhito, ",
  "ja489:18.3": "manuññaṃ bhāsasi vācaṃ ",
  "ja489:18.4": "yaṃ mayhaṃ hadayaṅgamaṃ. ",
  "ja489:19.1": "devatānusi saggamhā ",
  "ja489:19.2": "isivāsi mahiddhiko, ",
  "ja489:19.3": "kovāsi tvaṃ anuppatto ",
  "ja489:19.4": "attānaṃ me pavedaya. ",
  "ja489:20.1": "yaṃ devasaṅghā vandanti ",
  "ja489:20.2": "sudhammāyaṃ samāgatā, ",
  "ja489:20.3": "sohaṃ sakko sahassakkho ",
  "ja489:20.4": "āgatosmi tavantike. ",
  "ja489:21.1": "itthiyo jīvalokasmiṃ ",
  "ja489:21.2": "yā honti samacārinī, ",
  "ja489:21.3": "medhāvinī sīlavatī ",
  "ja489:21.4": "sassudevā patibbatā. ",
  "ja489:22.1": "tādisāya sumedhāya ",
  "ja489:22.2": "suvikammāya nāriyā, ",
  "ja489:22.3": "devā dassanamāyanti ",
  "ja489:22.4": "mānusiyā amānusā. ",
  "ja489:23.1": "tvañca bhadde suciṇṇena ",
  "ja489:23.2": "pubbe sucaritena ca, ",
  "ja489:23.3": "idha rājakule jātā ",
  "ja489:23.4": "sabbakāmasamiddhinī. ",
  "ja489:24.1": "ayañca te rājaputti ",
  "ja489:24.2": "ubhayattha kaṭaggaho, ",
  "ja489:24.3": "devalokūpapattī ca ",
  "ja489:24.4": "kitti ca idha jīvite. ",
  "ja489:25.1": "ciraṃ sumedhe sukhinī ",
  "ja489:25.2": "dhammaṃ pālayamattani, ",
  "ja489:25.3": "esāhaṃ tidivaṃ yāmi ",
  "ja489:25.4": "piyamme ta va dassananti. ",
  "ja489:26.1": ""
}
