  "ja212:0.3": "",
  "ja212:0.4": "1. somadatta jātakaṃ. ",
  "ja212:1.1": "añño uparimo vaṇṇo ",
  "ja212:1.2": "añño vaṇṇova heṭṭhimo ",
  "ja212:1.3": "brāhmaṇiṃ tveva pucchāmi ",
  "ja212:1.4": "kiṃ heṭṭhā kicca uppari. ",
  "ja212:2.1": "ahaṃ naṭosmi bhaddante ",
  "ja212:2.2": "bhikkhakosmi idhāgato, ",
  "ja212:2.3": "ayaṃ hi koṭṭhamotiṇṇo ",
  "ja212:2.4": "ayaṃ so yaṃ gavesasīti. ",
  "ja212:3.1": "2. ucchiṭṭhabhattajātakaṃ. "
}
