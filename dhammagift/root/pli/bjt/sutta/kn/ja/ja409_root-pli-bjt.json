  "ja409:0.4": "",
  "ja409:1.1": "ahañce daḷhadhammāya ",
  "ja409:1.2": "vahanti nābhirādhayiṃ, ",
  "ja409:1.3": "nudanti urasi sallaṃ ",
  "ja409:1.4": "yuddhe vikkantacārinī. naha ",
  "ja409:2.1": "nūna rājā jānāti ",
  "ja409:2.2": "mama vikkamaporisaṃ, ",
  "ja409:2.3": "saṅgāme sukataṃ tāni ",
  "ja409:2.4": "dūtavippahitāni ca. ",
  "ja409:3.1": "sānūnāhaṃ marissāmi ",
  "ja409:3.2": "abandhū aparāyinī, ",
  "ja409:3.3": "tadāhi kumbhakārassa ",
  "ja409:3.4": "dinnā chakaṇahārikā. ",
  "ja409:4.1": "yāvatāsiṃsati poso ",
  "ja409:4.2": "tāvadeva pavīṇati, ",
  "ja409:4.3": "atthāpāye jahanti naṃ ",
  "ja409:4.4": "oṭṭhivyādhiṃva khattiyo. ",
  "ja409:5.1": "yo pubbe katakalyāṇo ",
  "ja409:5.2": "katattho nāvabujjhati, ",
  "ja409:5.3": "atthā tassa palujjanti ",
  "ja409:5.4": "ye honti abhipatthitā. ",
  "ja409:6.1": "yo pubbe katakalyāṇo ",
  "ja409:6.2": "katattho manubujjhati, ",
  "ja409:6.3": "atthā tassa paluvaḍḍhanti ",
  "ja409:6.4": "ye honti abhipatthitā. ",
  "ja409:7.1": "taṃ vo vadāmi bhaddaṃ vo ",
  "ja409:7.2": "yāvanetattha samāgatā, ",
  "ja409:7.3": "sabbe kataññuno hotha ",
  "ja409:7.4": "ciraṃ saggamhi ṭhassathāti. ",
  "ja409:8.1": "4. daḷhadhammajātakaṃ "
}
