  "ja200:0.4": "",
  "ja200:1.1": "sarīradavyaṃ vaddhavyaṃ ",
  "ja200:1.2": "sojaccaṃ sādhusīliyaṃ, ",
  "ja200:1.3": "brāhmaṇantveva pucchāma ",
  "ja200:1.4": "kaṃ nu tesaṃ vaṇimbhase. ",
  "ja200:2.1": "attho atthi sarīrasmiṃ ",
  "ja200:2.2": "vaddhavyassa namo kare, ",
  "ja200:2.3": "attho atthi sujātasmiṃ ",
  "ja200:2.4": "sīlaṃ asmāka ruccatīti. ",
  "ja200:3.1": "sādhusīlajātakaṃ. ",
  "ja200:3.2": "ruhakavaggo pañcamo. ",
  "ja200:4.1": "tassuddānaṃ: ",
  "ja200:5.1": "ambhoruhakarūpavatīmusalo ",
  "ja200:5.2": "pavasanti sapañcamapokkharaṇi, ",
  "ja200:5.3": "atha muttimavāṇija umbhayate ",
  "ja200:5.4": "ciraāgata koṭṭha sarīra dasa. "
}
