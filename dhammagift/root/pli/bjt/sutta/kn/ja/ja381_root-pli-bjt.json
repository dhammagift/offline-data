  "ja381:0.3": "",
  "ja381:0.4": "",
  "ja381:1.1": "na me rucci migālopa ",
  "ja381:1.2": "yassa te tādisā gati, ",
  "ja381:1.3": "atuccaṃ tāta patasi ",
  "ja381:1.4": "abhūmiṃ tāta sevasi. ",
  "ja381:2.1": "catukkaṇṇaṃva kedāraṃ ",
  "ja381:2.2": "yadā te paṭhavī siyā, ",
  "ja381:2.3": "tāto tāta nivattassu ",
  "ja381:2.4": "māssu etto paraṃ gami. ",
  "ja381:3.1": "santi aññepi sakuṇā ",
  "ja381:3.2": "pattayānā vihaṅgamā, ",
  "ja381:3.3": "akkhittā vātavegena ",
  "ja381:3.4": "naṭṭhā te sassatīsamā. ",
  "ja381:4.1": "akatvā aparaṇṇassa ",
  "ja381:4.2": "pitu vuddhassa sāsanaṃ, ",
  "ja381:4.3": "kāḷe vāte atikkamma ",
  "ja381:4.4": "verambānaṃ vasaṃ gato. ",
  "ja381:5.1": "tassa puttā ca dārā ca ",
  "ja381:5.2": "ye caññe anujīvino, ",
  "ja381:5.3": "sabbe vyasanamāpāduṃ ",
  "ja381:5.4": "anovādakare dije. ",
  "ja381:6.1": "evampi idha vuddhānaṃ ",
  "ja381:6.2": "yo vākyaṃ nāvabujjhati, ",
  "ja381:6.3": "atisīmaṃ caro ditto ",
  "ja381:6.4": "gijjhovātītasāsano. ",
  "ja381:6.5": "sabbe saṃkhya napapponti ",
  "ja381:6.6": "akatvā buddhasāsananti. ",
  "ja381:7.1": "migālopajātakaṃ. "
}
