  "ja30:0.4": "",
  "ja30:1.1": "mā munikassa pihayi ",
  "ja30:1.2": "āturantāni bhuñjati, ",
  "ja30:1.3": "appossukko bhusaṃ khāda ",
  "ja30:1.4": "etaṃ dīghāyulakkhaṇanti. ",
  "ja30:2.1": "munikajātakaṃ. kuraṅgavaggo ",
  "ja30:2.2": "tatiyo. ",
  "ja30:3.1": "tassuddānaṃ: ",
  "ja30:4.1": "kuruṅgassakukkurabhojavaro ",
  "ja30:4.2": "puna vāḷavassasirivayato, ",
  "ja30:4.3": "mahiḷāmukhanāmanuññavaro ",
  "ja30:4.4": "vahatedhuramunikena dasa. "
}
