  "ja274:1.1": "kāyaṃ balākā sikhinī ",
  "ja274:1.2": "corī laṅghipitāmhā, ",
  "ja274:1.3": "oraṃ balāke āgaccha ",
  "ja274:1.4": "caṇḍo me vāyaso sakhā, ",
  "ja274:2.1": "nāhaṃ balākā sikhinī ",
  "ja274:2.2": "ahaṃ lolosmi vāyaso, ",
  "ja274:2.3": "akatvā vacanaṃ tuyhaṃ ",
  "ja274:2.4": "passa lūnosmi āgato. ",
  "ja274:3.1": "puna pāpajjasi samma ",
  "ja274:3.2": "sīlaṃ hi tava tādisaṃ, ",
  "ja274:3.3": "na hi mānusakā bhogā ",
  "ja274:3.4": "subhuñjā honti pakkhinā’ti. ",
  "ja274:4.1": "lolajātakaṃ "
}
