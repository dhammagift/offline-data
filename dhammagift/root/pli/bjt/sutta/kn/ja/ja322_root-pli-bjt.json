  "ja322:1.1": "daddabhāyati bhaddante ",
  "ja322:1.2": "yasmiṃ dese vasāmahaṃ, ",
  "ja322:1.3": "ahampetaṃ na jānāmi ",
  "ja322:1.4": "kimetaṃ daddabhāyati. ",
  "ja322:2.1": "beluvaṃ patitaṃ sutvā ",
  "ja322:2.2": "daddabhanti saso javi, ",
  "ja322:2.3": "sasassa vacanaṃ sutvā ",
  "ja322:2.4": "santattā migavāhinī. ",
  "ja322:3.1": "appatvā padaviññāṇaṃ ",
  "ja322:3.2": "paraghosānusārino, ",
  "ja322:3.3": "pamādaparamā bālā ",
  "ja322:3.4": "te honti parapattiyā. ",
  "ja322:4.1": "ye ca sīlena sampannā ",
  "ja322:4.2": "paññāyupasame ratā, ",
  "ja322:4.3": "‘ārakā viratā dhīrā ",
  "ja322:4.4": "na honti parapattiyāti. ",
  "ja322:5.1": ""
}
