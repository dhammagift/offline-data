  "ja250:1.1": "ayaṃ isī upasamasaṃyame rato ",
  "ja250:1.2": "santiṭṭhati sisirabhayena aṭṭito, ",
  "ja250:1.3": "handa ayaṃ pavisatumaṃ agārakaṃ ",
  "ja250:1.4": "vinetu sītaṃ darathañca kevalaṃ. ",
  "ja250:2.1": "nāyaṃ isī upasamasaṃyame rato, ",
  "ja250:2.2": "kapī ayaṃ dumavarasākhagocaro, ",
  "ja250:2.3": "so dūsako rosako cāpi jammo ",
  "ja250:2.4": "sace vaje imampi dūsaye gharanti. ",
  "ja250:3.1": "kapijātakaṃ sigālavaggo ",
  "ja250:3.2": "dasamo. ",
  "ja250:4.1": "tassuddānaṃ: ",
  "ja250:5.1": "atha rājāsigālavaro sunakho ",
  "ja250:5.2": "tathā kosiya icchati kālaghaso, ",
  "ja250:5.3": "atha dānavaroṭṭhapi sārathinā ",
  "ja250:5.4": "punappavanañca sisirakapi dasa. dukanipāto ",
  "ja250:6.1": "niṭṭhito. vagguddānaṃ: ",
  "ja250:7.1": "daḷhañca vaggaṃ aparena santhavaṃ ",
  "ja250:7.2": "kalyāṇavaggaṃ sadiso ca ruhakaṃ, ",
  "ja250:7.3": "nataṃdaḷhaṃ bīranatthambhakaṃ puna ",
  "ja250:7.4": "kāsāvupāhanasigālakena dasā’ti. ",
  "ja250:8.1": ""
}
