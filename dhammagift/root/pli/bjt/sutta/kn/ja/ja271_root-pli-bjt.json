{
  "ja271:0.1": "",
  "ja271:0.2": "",
  "ja271:0.3": "3. araññavaggo ",
  "ja271:0.4": "",
  "ja271:1.1": "āraññakassa isino ",
  "ja271:1.2": "cirarattatapassino, ",
  "ja271:1.3": "kicchā kataṃ udapānaṃ ",
  "ja271:1.4": "kathaṃ samma avāhasi. ",
  "ja271:2.1": "esadhammo sigālānaṃ ",
  "ja271:2.2": "yampītvā obhadāmase, ",
  "ja271:2.3": "pitupitāmahaṃ dhammo ",
  "ja271:2.4": "na naṃ ujjhātumarahasi. ",
  "ja271:3.1": "yesaṃ vo ediso dhammo ",
  "ja271:3.2": "adhammo pana kīdiso, ",
  "ja271:3.3": "mā vo dhammaṃ adhammaṃ vā ",
  "ja271:3.4": "addasāma kudācananti. ",
  "ja271:4.1": "1. udapānadūsakajātakaṃ. "
}
