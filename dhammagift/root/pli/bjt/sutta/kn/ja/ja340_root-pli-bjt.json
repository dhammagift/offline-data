  "ja340:0.4": "",
  "ja340:1.1": "adāsi dānāni pure visayha ",
  "ja340:1.2": "dadato ca te khayadhammo ahosi, ",
  "ja340:1.3": "ito parañce na dadeyya dānaṃ ",
  "ja340:1.4": "tiṭṭheyyuṃ te saññamantassa bhogo. ",
  "ja340:2.1": "anariyamariyena sahassanetta ",
  "ja340:2.2": "suduggatenāpi akiccamāhu, ",
  "ja340:2.3": "mā vo dhanaṃ taṃ janinda ahuvā ",
  "ja340:2.4": "yambhogahetu vijahema saddhaṃ. ",
  "ja340:3.1": "yena eko ratho yāti ",
  "ja340:3.2": "yāti tena paro ratho, ",
  "ja340:3.3": "porāṇaṃ nihitaṃ vattaṃ ",
  "ja340:3.4": "vattataññeva vāsava. ",
  "ja340:4.1": "yadi hessati dassāma ",
  "ja340:4.2": "asante kiṃ dadāmase, ",
  "ja340:4.3": "evaṃ bhūtāpi dassāma ",
  "ja340:4.4": "mā dānaṃ pamadāmhase’ti. ",
  "ja340:5.1": "visayhajātakaṃ. kokālivaggo ",
  "ja340:5.2": "catuttho. ",
  "ja340:6.1": "tassuddānaṃ: ",
  "ja340:7.1": "ativelaṃ pabhāsati ",
  "ja340:7.2": "jinavaro vanamajjherathesabhajimbhagamo, ",
  "ja340:7.3": "atha jambutiṇāsanapīṭhavaraṃ ",
  "ja340:7.4": "atha taṇḍula mora visayha dasa. "
}
