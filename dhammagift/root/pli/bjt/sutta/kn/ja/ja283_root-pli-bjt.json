  "ja283:0.1": "",
  "ja283:0.2": "",
  "ja283:0.3": "",
  "ja283:0.4": "2. seyyaṃsajātakaṃ. ",
  "ja283:1.1": "varaṃ varaṃ tvaṃ nihanaṃ pure cari ",
  "ja283:1.2": "asmiṃ padese abhibhuyya sūkare, ",
  "ja283:1.3": "sodāni eko vyapagamma jhāyasi ",
  "ja283:1.4": "balannu te vyaggha na cajja vijjati. ",
  "ja283:2.1": "ime sudaṃ yanti disodisaṃ pure ",
  "ja283:2.2": "bhayaṭṭitā leṇagavesino puthu, ",
  "ja283:2.3": "te dāni saṃgamma rasanti ekato ",
  "ja283:2.4": "yattha ṭhitā duppasabhajja, me mayā. ",
  "ja283:3.1": "namatthu saṅghānaṃ samāgatānaṃ ",
  "ja283:3.2": "disvā sayaṃ sabyaṃ vadāmi abbhutaṃ, ",
  "ja283:3.3": "vyagghaṃ migā yattha jiniṃsu dāṭhino ",
  "ja283:3.4": "sāmaggiyā dāṭhabalesu muccareti. ",
  "ja283:4.1": "3. vaḍḍhakīsūkarajātakaṃ. "
}
