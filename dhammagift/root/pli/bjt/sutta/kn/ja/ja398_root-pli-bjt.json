  "ja398:0.3": "",
  "ja398:0.4": "",
  "ja398:1.1": "rājā te bhattaṃ pāhesi ",
  "ja398:1.2": "sucimaṃsūpasecanaṃ, makhādevasmiṃ ",
  "ja398:1.3": "adhivatthe ",
  "ja398:1.4": "ehi nikkhama bhuñjassu. ",
  "ja398:2.1": "ehi māṇava orena ",
  "ja398:2.2": "bhikkhamādāya supitaṃ, ",
  "ja398:2.3": "tvañca māṇava bhikkhā ca ",
  "ja398:2.4": "ubho bhakkhā bhavissatha. ",
  "ja398:3.1": "appakena tuvaṃ yakkha ",
  "ja398:3.2": "thullamatthaṃ jahissasi, ",
  "ja398:3.3": "bhikkhaṃ te nāharissanti ",
  "ja398:3.4": "janā maraṇasaññino. ",
  "ja398:4.1": "laddhāya yakkha tava niccabhikkhaṃ ",
  "ja398:4.2": "suciṃ paṇītaṃ rasasā upetaṃ, ",
  "ja398:4.3": "bhikkhañca te āhariyo naro idha ",
  "ja398:4.4": "sudullabho hohiti khādite mayi. ",
  "ja398:5.1": "mamesaṃ sutano attho ",
  "ja398:5.2": "yathā bhāsasi māṇava, ",
  "ja398:5.3": "mayā tvaṃ samanuññāto ",
  "ja398:5.4": "sotthiṃ passasi mātaraṃ. ",
  "ja398:6.1": "khaggaṃ chattañca pātiñca ",
  "ja398:6.2": "gacchevādāya māṇava, ",
  "ja398:6.3": "sotthiṃ passatu te mātā ",
  "ja398:6.4": "tvañca passāhi mātaraṃ. ",
  "ja398:7.1": "evaṃ yakkha sukhī hohi ",
  "ja398:7.2": "saha sabbehi ñātibhi, ",
  "ja398:7.3": "dhanañca me adhigataṃ ",
  "ja398:7.4": "rañño ca vacanaṃ katanti. ",
  "ja398:8.1": "3. sutanujātakaṃ. "
}
