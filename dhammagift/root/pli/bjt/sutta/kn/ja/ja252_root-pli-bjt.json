{
  "ja252:0.1": "",
  "ja252:0.2": "",
  "ja252:0.3": "",
  "ja252:0.4": "1. saṅkappajātakaṃ. ",
  "ja252:1.1": "ajjāpi me taṃ manasi ",
  "ja252:1.2": "yaṃ maṃ tvaṃ tilamuṭṭhiyā, ",
  "ja252:1.3": "bāhāya maṃ gahetvāna ",
  "ja252:1.4": "laṭṭhiyā anutāḷayi. ",
  "ja252:2.1": "nanu jīvite na ramasi ",
  "ja252:2.2": "yenāsi brāhmaṇāgato. ",
  "ja252:2.3": "yaṃ maṃ bāhaṃ gahetvāna ",
  "ja252:2.4": "tikkhattuṃ anutāḷayī. ",
  "ja252:3.1": "ariyo anariyaṃ kubbānaṃ ",
  "ja252:3.2": "yo daṇḍena nisedhati, ",
  "ja252:3.3": "sāsanatthaṃ na taṃ veraṃ ",
  "ja252:3.4": "iti naṃ paṇḍitā vidūti. ",
  "ja252:4.1": "2. tilamuṭṭhijātakaṃ. "
}
