  "ja278:1.1": "kamatthamabhisandhāya ",
  "ja278:1.2": "lahucittassa dūbhino, ",
  "ja278:1.3": "sabbakāmadubhasseva ",
  "ja278:1.4": "idaṃ dukkhaṃ titikkhasi. ",
  "ja278:2.1": "siṅgena nihanāhetaṃ ",
  "ja278:2.2": "padasā ca adhiṭṭhaha, ",
  "ja278:2.3": "bhīyo bālā pakujjheyyuṃ ",
  "ja278:2.4": "no cassa paṭisedhako. ",
  "ja278:3.1": "mamevāyaṃ maññamāno ",
  "ja278:3.2": "aññampevaṃ karissati, ",
  "ja278:3.3": "te taṃ tattha vadhissanti ",
  "ja278:3.4": "sā me mutti bhavissatī’ti. ",
  "ja278:4.1": ""
}
