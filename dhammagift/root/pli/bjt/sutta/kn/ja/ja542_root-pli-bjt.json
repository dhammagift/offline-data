  "ja542:104.2": "mukhaṃ sodhetha sandhino, ",
  "ja542:104.3": "vedeho sahamaccehi ",
  "ja542:104.4": "ummaggena gamissati. ",
  "ja542:105.1": "tassa taṃ vacanaṃ sutvā ",
  "ja542:105.2": "paṇḍitassānusārino, ",
  "ja542:105.3": "ummaggadvāraṃ vivariṃsu ",
  "ja542:105.4": "yantayutte ca aggaḷe. ",
  "ja542:106.1": "purato senako yāti ",
  "ja542:106.2": "pacchato ca mahosadho, ",
  "ja542:106.3": "majjhe ca rājā vedeho ",
  "ja542:106.4": "amaccaparivārito. ",
  "ja542:107.1": "ummaggā nikkhamitvāna ",
  "ja542:107.2": "vedeho nāvamāruhi, ",
  "ja542:107.3": "abhirūḷhañca taṃ ñatvā ",
  "ja542:107.4": "anusāsi mahosadho. ",
  "ja542:108.1": "ahaṃ te sāsuro deva ",
  "ja542:108.2": "ayaṃ sassu janādhipa, ",
  "ja542:108.3": "yathā mātu paṭipatti ",
  "ja542:108.4": "evaṃ te hotu sassuyā. ",
  "ja542:109.1": "yathāpi niyako bhātā ",
  "ja542:109.2": "saudariyo ekamātuko, ",
  "ja542:109.3": "evaṃ pañcālacaṇḍo te ",
  "ja542:109.4": "dayitabbo rathesabha. ",
  "ja542:110.1": "ayaṃ pañcālacaṇḍi te ",
  "ja542:110.2": "rājaputti abhijjhitā, ",
  "ja542:110.3": "kāmaṃ karohi te tāya ",
  "ja542:110.4": "bhariyā te rathesabha. ",
  "ja542:111.1": "āruyha nāvaṃ taramāno ",
  "ja542:111.2": "kinnu tīrambhi tiṭṭhasi, ",
  "ja542:111.3": "kicchā muttamha dukkhāto ",
  "ja542:111.4": "yāmadāni mahosadha. ",
  "ja542:112.1": "nesa dhammo mahārāja ",
  "ja542:112.2": "yohaṃ senāya nāyako, ",
  "ja542:112.3": "senaṅgaṃ parihāpetvā ",
  "ja542:112.4": "attānaṃ parimocaye. ",
  "ja542:113.1": "nivesanamhi te deva ",
  "ja542:113.2": "senaṅgaṃ parihāpitaṃ, ",
  "ja542:113.3": "taṃ dinnaṃ brahmadattena ",
  "ja542:113.4": "anāyissaṃ rathesabha. ",
  "ja542:114.1": "appaseno mahāsenaṃ ",
  "ja542:114.2": "kathaṃ viggayha ṭhassasi, ",
  "ja542:114.3": "dubbalo balavantena ",
  "ja542:114.4": "vihaññissasi paṇḍita. ",
  "ja542:115.1": "appasenopi ce mantī ",
  "ja542:115.2": "mahāsenaṃ amantinaṃ, ",
  "ja542:115.3": "jināti rājā rājāno ",
  "ja542:115.4": "ādiccovudayaṃ tamaṃ. ",
  "ja542:116.1": "susukhaṃ vata saṃvāso ",
  "ja542:116.2": "paṇḍitehīti senaka, ",
  "ja542:116.3": "pakkhīva pañjare baddhe ",
  "ja542:116.4": "macche jālagateriva ",
  "ja542:116.5": "amittahatthatthagate ",
  "ja542:116.6": "mocayī no mahosadho. ",
  "ja542:117.1": "evametaṃ mahārāja ",
  "ja542:117.2": "paṇḍitā hi sukhāvahā. ",
  "ja542:117.3": "pakkhīva pañjare baddhe ",
  "ja542:117.4": "macche jālagateriva; ",
  "ja542:117.5": "amittahatthatthagate ",
  "ja542:117.6": "mocayī no mahosadho. ",
  "ja542:118.1": "rakkhitvā kasiṇaṃ rattiṃ ",
  "ja542:118.2": "cūḷanīyo mahabbalo, ",
  "ja542:118.3": "udentaṃ aruṇuggamahi ",
  "ja542:118.4": "upakāriṃ upāgami. ",
  "ja542:119.1": "āruyha pavaraṃ nāgaṃ ",
  "ja542:119.2": "balavantaṃ saṭṭhihāyanaṃ, ",
  "ja542:119.3": "rājā avoca pañcālo ",
  "ja542:119.4": "cūḷanīyo mahabbalo. ",
  "ja542:120.1": "sannaddho maṇivammena ",
  "ja542:120.2": "saramādāya pāṇinā, ",
  "ja542:120.3": "pessiye ajjhabhāsittha ",
  "ja542:120.4": "puthugumbe samāgate. ",
  "ja542:121.1": "hatthārūhe anīkaṭṭhe ",
  "ja542:121.2": "rathike pattikārake, ",
  "ja542:121.3": "upāsanamhi katahatthe ",
  "ja542:121.4": "vāḷavedhe samāgate. ",
  "ja542:122.1": "pesetha kuñjare dantī ",
  "ja542:122.2": "balavante saṭṭhihāyane, ",
  "ja542:122.3": "maddantu kuñjarā nagaraṃ ",
  "ja542:122.4": "vedehena sumāpitaṃ. ",
  "ja542:123.1": "vacchadantamukhā setā ",
  "ja542:123.2": "tikhiṇaggā aṭṭhīvedhino, ",
  "ja542:123.3": "panunnā dhanuvegena ",
  "ja542:123.4": "sampatantu tarītaraṃ. ",
  "ja542:124.1": "māṇavā vammino sūrā ",
  "ja542:124.2": "citradaṇḍayutāvudhā, ",
  "ja542:124.3": "pakkhandino mahānāgā ",
  "ja542:124.4": "hatthīnaṃ hontu sammukhā. ",
  "ja542:125.1": "sattiyo teladhotāyo ",
  "ja542:125.2": "accimantī pabhassarā, ",
  "ja542:125.3": "vijjotamānā tiṭṭhantu ",
  "ja542:125.4": "sataraṃsā viya tārakā. ",
  "ja542:126.1": "āvudhabalavantānaṃ ",
  "ja542:126.2": "guṇikāyūradhārinaṃ, ",
  "ja542:126.3": "etādisānaṃ yodhānaṃ ",
  "ja542:126.4": "saṅgāme apalāyinaṃ. ",
  "ja542:126.5": "vedeho kuto muccissati ",
  "ja542:126.6": "sace pakkhīva kāhati. ",
  "ja542:127.1": "tiṃsa me purisanāvutyo ",
  "ja542:127.2": "sabbe vekekanicchitā, ",
  "ja542:127.3": "yesaṃ samaṃ na passāmi ",
  "ja542:127.4": "kevalaṃ mahimaṃ caraṃ. ",
  "ja542:128.1": "nāgā ca kappitā danti ",
  "ja542:128.2": "balavanto saṭṭhihāyanā, ",
  "ja542:128.3": "yesaṃ khandhesu sobhanti ",
  "ja542:128.4": "kumārā cārudassanā. ",
  "ja542:129.1": "pītālaṅkārā pītavasanā ",
  "ja542:129.2": "pītuttaranivāsanā, ",
  "ja542:129.3": "nāgakkhandhesu sobhanti ",
  "ja542:129.4": "devaputtāva nandane. ",
  "ja542:130.1": "pāṭhinavaṇṇā nettiṃsā ",
  "ja542:130.2": "teladhotā pabhassarā, ",
  "ja542:130.3": "niṭṭhitā naravīrehi ",
  "ja542:130.4": "samadhārā sunissitā. ",
  "ja542:131.1": "vellālino vītamalā ",
  "ja542:131.2": "sikkāyasmayā daḷhā, ",
  "ja542:131.3": "gahitā balavantehi ",
  "ja542:131.4": "suppahārappahārihi. ",
  "ja542:132.1": "suvaṇṇatharusampannā ",
  "ja542:132.2": "lohitakacchupadhāritā, ",
  "ja542:132.3": "vivattamānā sobhanti ",
  "ja542:132.4": "vijjuvabbhaghanantare. ",
  "ja542:133.1": "patākā vammino sūrā ",
  "ja542:133.2": "asicammassa kovidā, ",
  "ja542:133.3": "tharuggahā sikkhitāro ",
  "ja542:133.4": "nāgakkhandhātipātino. edisehi ",
  "ja542:134.1": "parikkhitto ",
  "ja542:134.2": "natthi mokkho ito tava, ",
  "ja542:134.3": "pabhāvaṃ te na passāmi ",
  "ja542:134.4": "yena tvaṃ mithilaṃ vaje. ",
  "ja542:135.1": "kinnu santaramānova ",
  "ja542:135.2": "nāgaṃ pesesi kuñjaraṃ, ",
  "ja542:135.3": "pahaṭṭharūpo āpatasi ",
  "ja542:135.4": "laddhatthosmīti maññasi, ",
  "ja542:136.1": "oharetaṃ dhanu cāpaṃ ",
  "ja542:136.2": "khurappaṃ paṭisaṃhara, ",
  "ja542:136.3": "oharetaṃ subhaṃ cammaṃ ",
  "ja542:136.4": "veḷuriyamaṇiyanthataṃ. ",
  "ja542:137.1": "pasannamukhavaṇṇosi ",
  "ja542:137.2": "mihitapubbañca bhāsasi, ",
  "ja542:137.3": "hoti kho maraṇakāle ",
  "ja542:137.4": "tādisī vaṇṇasampadā. ",
  "ja542:138.1": "moghaṃ te gajjitaṃ bhintamantosi ",
  "ja542:138.2": "khattiya, ",
  "ja542:138.3": "duggaṇho hi tayā rājā ",
  "ja542:138.4": "khaḷuṅkeneva sindhavo. ",
  "ja542:139.1": "tiṇṇe hiyyo rājā gaṅgaṃ ",
  "ja542:139.2": "sāmacco saparijjano, ",
  "ja542:139.3": "haṃsarājaṃ yathā dhaṅko ",
  "ja542:139.4": "anujjavaṃ papatissasi. ",
  "ja542:140.1": "sigālā rattibhāgena ",
  "ja542:140.2": "phullaṃ disvāna kiṃsukaṃ, ",
  "ja542:140.3": "maṃsapesīti maññantā ",
  "ja542:140.4": "parabbūḷhā migādhamā. ",
  "ja542:141.1": "vītivattāsu rattīsu ",
  "ja542:141.2": "uggatasmiṃ divākare, ",
  "ja542:141.3": "kiṃsukaṃ phullitaṃ disvā ",
  "ja542:141.4": "āsacchintā migādhamā. ",
  "ja542:142.1": "evameva tuvaṃ rāja ",
  "ja542:142.2": "vedehaṃ parivāriya, ",
  "ja542:142.3": "āsacchinno gamissasi ",
  "ja542:142.4": "sigālā kiṃsukaṃ yathā. ",
  "ja542:143.1": "imassa hatthapāde ca ",
  "ja542:143.2": "kaṇṇanāsañca chindatha, ",
  "ja542:143.3": "yo me amittaṃ hatthagataṃ ",
  "ja542:143.4": "vedehaṃ parimocayi. ",
  "ja542:144.1": "ima maṃsaṃva pātabbaṃ ",
  "ja542:144.2": "sūle katvā pacantu taṃ, ",
  "ja542:144.3": "yo me amittaṃ hatthagataṃ ",
  "ja542:144.4": "vedehaṃ parimocayi. ",
  "ja542:145.1": "yathāpi āsabhaṃ cammaṃ ",
  "ja542:145.2": "pathavyā vitaniyyati, ",
  "ja542:145.3": "sīhassa atho vyagghassa ",
  "ja542:145.4": "hoti saṅkusamāhataṃ. ",
  "ja542:146.1": "evaṃ taṃ vitanitvāna ",
  "ja542:146.2": "vedhayissāmi sattiyā, ",
  "ja542:146.3": "yo me amittaṃ hatthagataṃ ",
  "ja542:146.4": "vedehaṃ parimocayi. ",
  "ja542:147.1": "sace me hatthe ca pāde ca ",
  "ja542:147.2": "kaṇṇanāsañca checchasi, ",
  "ja542:147.3": "evaṃ pañcālacaṇḍassa ",
  "ja542:147.4": "vedeho chedayissati. ",
  "ja542:148.1": "sace me hatthe ca pāde ca ",
  "ja542:148.2": "kaṇṇanāsañca checchasi, ",
  "ja542:148.3": "evaṃ pañcālacaṇḍiyā ",
  "ja542:148.4": "vedeho chedayissati. ",
  "ja542:149.1": "sace me hatthe ca pāde ca ",
  "ja542:149.2": "kaṇṇanāsañca checchasi, ",
  "ja542:149.3": "evaṃ nandāya deviyā ",
  "ja542:149.4": "vedeho chedayissati. ",
  "ja542:150.1": "sace me hatthe ca pāde ca ",
  "ja542:150.2": "kaṇṇanāsañca checchasi, ",
  "ja542:150.3": "evaṃ te puttadārassa ",
  "ja542:150.4": "vedeho chedayissati. ",
  "ja542:151.1": "sace maṃsaṃva pātabbaṃ ",
  "ja542:151.2": "sūle katvā pavissasi, ",
  "ja542:151.3": "evaṃ pañcālacaṇḍassa ",
  "ja542:151.4": "vedeho pācayissati. ",
