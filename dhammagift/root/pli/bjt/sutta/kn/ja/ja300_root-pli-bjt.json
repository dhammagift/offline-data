  "ja300:0.3": "",
  "ja300:0.4": "9. komāyaputtajātakaṃ. ",
  "ja300:1.1": "parapāṇarodhā jīvanto ",
  "ja300:1.2": "maṃsa lohitabhojano, ",
  "ja300:1.3": "vako vataṃ samādāya ",
  "ja300:1.4": "upapajji uposathaṃ. ",
  "ja300:2.1": "tassa sakko vataññāya ",
  "ja300:2.2": "ajarūpenupāgami, ",
  "ja300:2.3": "vītatapo ajjhappatto ",
  "ja300:2.4": "bhañji lohitapo tapaṃ. ",
  "ja300:3.1": "evamevaṃ idhekacce ",
  "ja300:3.2": "samādānasmiṃ dubbalā, ",
  "ja300:3.3": "lahuṃ karonti attānaṃ ",
  "ja300:3.4": "vakova ajakāraṇā’ti. ",
  "ja300:4.1": "10. vakajātakaṃ. ",
  "ja300:4.2": "kumbhavaggo pañcamo. ",
  "ja300:5.1": "tassuddānaṃ: ",
  "ja300:6.1": "varakumbhasupattasirivhayano ",
  "ja300:6.2": "sucisammatabinduvaro cūsabho, ",
  "ja300:6.3": "saritaṃpaticaṇḍijarākapinā ",
  "ja300:6.4": "atha makkaṭiyā vakakena dasāti. ",
  "ja300:7.1": "tikanipāto niṭṭhito. vagguddānaṃ: ",
  "ja300:8.1": "saṅkappo padumo ceva ",
  "ja300:8.2": "udapānena tatiyaṃ, ",
  "ja300:8.3": "abbhantaraṃ ghaṭabhedaṃ ",
  "ja300:8.4": "tikanipātambi ",
  "ja300:9.1": "laṅkatanti. "
}
