  "ja174:0.4": "3. makkaṭajātakaṃ. ",
  "ja174:1.1": "adamha te vāri pahūtarūpaṃ ",
  "ja174:1.2": "ghammābhitattassa pipāsitassa, ",
  "ja174:1.3": "sodāni pītvāna kikiṃ kirosi ",
  "ja174:1.4": "asaṃgamo pāpajanena seyyo. ",
  "ja174:2.1": "ko te suto vā diṭṭho vā ",
  "ja174:2.2": "sīlavā nāma makkaṭo, ",
  "ja174:2.3": "idāni ko taṃ ūhacca ",
  "ja174:2.4": "phasā asmāka dhammatā’ti. ",
  "ja174:3.1": ""
}
