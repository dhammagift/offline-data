{
  "ja351:0.1": "5. pañcakanipāto ",
  "ja351:0.2": "",
  "ja351:0.3": "1. maṇikuṇḍalavaggo ",
  "ja351:0.4": "",
  "ja351:1.1": "jino rathassamaṇikuṇḍale ca ",
  "ja351:1.2": "putte ca dāre ca tatheva jīno, ",
  "ja351:1.3": "sabbesu bhogesu asesitesu ",
  "ja351:1.4": "kasmā na santappasi sokakāle. ",
  "ja351:2.1": "pubbe va maccaṃ vijahanti bhogā ",
  "ja351:2.2": "macco vā te pubbataraṃ jahāti, ",
  "ja351:2.3": "asassatā bhogino kāmakāmī ",
  "ja351:2.4": "tasmā na socāmahaṃ sokakāle. ",
  "ja351:3.1": "udeti āpūrati veti cando ",
  "ja351:3.2": "atthaṃ tapetvāna paleti sūriyo, ",
  "ja351:3.3": "viditā mayā sattuka lokadhammā ",
  "ja351:3.4": "tasmā na socāmahaṃ sokakāle. ",
  "ja351:4.1": "alaso gihī kāmabhogī na sādhu ",
  "ja351:4.2": "asaññato pabbajito na sādhu, ",
  "ja351:4.3": "rājā na sādhu anisammakāri ",
  "ja351:4.4": "yo paṇḍito kodhano taṃ na sādhu. ",
  "ja351:5.1": "nisamma khattiyo kayirā ",
  "ja351:5.2": "nānisamma disampati, ",
  "ja351:5.3": "nisamma kārino rañño ",
  "ja351:5.4": "yaso kinti ca vaḍḍhatīti. ",
  "ja351:6.1": "1. maṇikuṇḍalajātakaṃ. "
}
