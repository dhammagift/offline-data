  "ja60:1.1": "bherivādajātakaṃ. dhame dhame nātidhame ",
  "ja60:1.2": "atidhantaṃ pāpakaṃ, ",
  "ja60:1.3": "dhantenādhigatā bhogā ",
  "ja60:1.4": "te tāto vidhamī dhamanti. ",
  "ja60:2.1": "saṅkhadhamanajātakaṃ. āsiṃsavaggo ",
  "ja60:2.2": "chaṭṭho. ",
  "ja60:3.1": "tassuddānaṃ: ",
  "ja60:4.1": "yathāicchiṃ tathāhudakāthalā ",
  "ja60:4.2": "surasāduphalovaalīnamano, ",
  "ja60:4.3": "sampahaṭṭhamano caturo ca tayo ",
  "ja60:4.4": "sataladdhakabhogadhanenadasa. "
}
