  "ja490:1.1": "appossukkodāni tuvaṃ kapota ",
  "ja490:1.2": "vihaṅgama na tava bhojanattho, ",
  "ja490:1.3": "khudaṃ pipāsaṃ adhivāsayanto ",
  "ja490:1.4": "kasmā bhavaṃ posathiko kapoto. ",
  "ja490:2.1": "ahaṃ pure giddhigato kapotiyā ",
  "ja490:2.2": "asmiṃ padesasmiṃ ubho ramāma, ",
  "ja490:2.3": "athaggahī sākuṇiko kapotiṃ ",
  "ja490:2.4": "akāmako tāya vinā ahosiṃ. ",
  "ja490:3.1": "nānābhavā vippayogena tassā ",
  "ja490:3.2": "manomayaṃ vedanaṃ vediyāmi, ",
  "ja490:3.3": "tasmā ahaṃ posathaṃ pālayāmi ",
  "ja490:3.4": "rāgo mamaṃ mā punarāgamāsi. ",
  "ja490:4.1": "anujjugāmi uraga dvijivha ",
  "ja490:4.2": "dāṭhāvudho ghoravisosi passa, ",
  "ja490:4.3": "khudaṃ pipāsaṃ adhivāsayanto ",
  "ja490:4.4": "kasmā bhavaṃ posathiko nu dīgho ",
  "ja490:5.1": "usabho ahū balavā gāmikassa ",
  "ja490:5.2": "calakkakū vaṇṇabalūpapanno ",
  "ja490:5.3": "maṃ akkami taṃ kupito aḍaṃsiṃ ",
  "ja490:5.4": "dukkhābhituṇṇo maraṇaṃ upāgami. ",
  "ja490:6.1": "tato janā nikkhamitvāna gāmā ",
  "ja490:6.2": "kanditvā roditva apakkamiṃsu, ",
  "ja490:6.3": "tasmā ahaṃ posathaṃ pālayāmi ",
  "ja490:6.4": "kodho mamaṃ mā punarāgamāsi. ",
  "ja490:7.1": "matāna maṃsāni bahū susāne ",
  "ja490:7.2": "manuññarūpaṃ tava bhojanetaṃ, ",
  "ja490:7.3": "khudaṃ pipāsaṃ adhivāsayanto ",
  "ja490:7.4": "kasmā bhavaṃ posathiko sigālo. ",
  "ja490:8.1": "pavissa kucchiṃ mahato gajassa ",
  "ja490:8.2": "kuṇape rato hatthamaṃse pagiddho, ",
  "ja490:8.3": "uṇho ca vāto tikhiṇā ca rasmiyo ",
  "ja490:8.4": "te sosayuṃ tassa karīsamaggaṃ. ",
  "ja490:9.1": "kiso ca paṇḍū ca ahaṃ bhadante ",
  "ja490:9.2": "na me ahū nikkhamanāya maggo, ",
  "ja490:9.3": "mahā ca megho sahasā pavassi ",
  "ja490:9.4": "so temayī tassa karīsamaggaṃ. ",
  "ja490:10.1": "tato ahaṃ nikakhamissaṃ bhadante ",
  "ja490:10.2": "cando yathā rāhumukhā pamutto, ",
  "ja490:10.3": "tasmā ahaṃ posathaṃ pālayāmi ",
  "ja490:10.4": "lobho mamaṃ mā punarāgamāsi. ",
  "ja490:11.1": "vammikathūpasmiṃ kipillikāni ",
  "ja490:11.2": "nippothayanto tuvaṃ pure carāsi, ",
  "ja490:11.3": "khudaṃ pipāsaṃ adhivāsayanto ",
  "ja490:11.4": "kasmā bhavaṃ posathiko nu accho. ",
  "ja490:12.1": "sakaṃ niketaṃ atihīlayāno ",
  "ja490:12.2": "atricchatāya malataṃ agañchiṃ, ",
  "ja490:12.3": "tato janā nikkhamitvāna gāmā ",
  "ja490:12.4": "kodaṇḍakena paripothayiṃsu maṃ ",
  "ja490:13.1": "so bhinnasīso ruhiramakkhitaṅgo ",
  "ja490:13.2": "paccāgamāsiṃ sakaṃ niketaṃ, ",
  "ja490:13.3": "tasmā ahaṃ posathaṃ pālayāmi ",
  "ja490:13.4": "atricchatā mā punarāgamāsi. ",
  "ja490:14.1": "yaṃ no apucchittha tuvaṃ bhadante ",
  "ja490:14.2": "sabbeva vyākarimha yathāpajānaṃ, ",
  "ja490:14.3": "mayampi pucchāma tavaṃ bhadante ",
  "ja490:14.4": "kasmā bhavaṃ posathikonu brahme. ",
  "ja490:15.1": "anūpalitto mama assamamhi ",
  "ja490:15.2": "paccekabuddho muhuttaṃ nisīdi, ",
  "ja490:15.3": "so maṃ avedi gatimāgatiñca ",
  "ja490:15.4": "nāmañca gottaṃ caraṇañca sabbaṃ. ",
  "ja490:16.1": "evampahaṃ naggahe tassa pāde ",
  "ja490:16.2": "na cāpi naṃ mānagatena pucchiṃ, ",
  "ja490:16.3": "tasmā ahaṃ posathaṃ pālayāmi ",
  "ja490:16.4": "mano mamaṃ mā punarāgamāsīti. ",
  "ja490:17.1": ""
}
