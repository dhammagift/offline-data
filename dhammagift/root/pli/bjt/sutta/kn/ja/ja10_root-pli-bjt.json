  "ja10:0.3": "",
  "ja10:0.4": "9. makhādevajātakaṃ. ",
  "ja10:1.1": "yañca aññenurakkhanti yo ca aññe na rakkhati, sa ce rāja sukhaṃ seti kāmesu anapekhavāti. ",
  "ja10:1.2": "",
  "ja10:1.3": "",
  "ja10:1.4": "",
  "ja10:2.1": "",
  "ja10:2.2": "10. sukhavihārijātakaṃ. apaṇṇakavaggo paṭhamo. ",
  "ja10:3.1": "tassuddānaṃ: ",
  "ja10:4.1": "varāpaṇṇakavaṇṇupathaserivaro sucicakkhaṇataṇḍulanāḷikassaṃ, ",
  "ja10:4.2": "hirīputtavaruttagāmaṇinā ",
  "ja10:4.3": "",
  "ja10:4.4": "yo ca na rakkhati tena dasa. "
}
