  "ja10:0.3": "",
  "ja10:0.4": "",
  "ja10:1.1": "makhādevajātakaṃ. yañca aññenurakkhanti ",
  "ja10:1.2": "yo ca aññe na rakkhati, ",
  "ja10:1.3": "sa ce rāja sukhaṃ seti ",
  "ja10:1.4": "kāmesu anapekhavāti. ",
  "ja10:2.1": "sukhavihārijātakaṃ. ",
  "ja10:2.2": "apaṇṇakavaggo paṭhamo. ",
  "ja10:3.1": "tassuddānaṃ: ",
  "ja10:4.1": "varāpaṇṇakavaṇṇupathaserivaro ",
  "ja10:4.2": "sucicakkhaṇataṇḍulanāḷikassaṃ, ",
  "ja10:4.3": "hirīputtavaruttagāmaṇinā ",
  "ja10:4.4": "yo ca na rakkhati tena dasa. "
}
