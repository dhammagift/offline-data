  "ja434:0.1": "",
  "ja434:0.2": "",
  "ja434:0.3": "",
  "ja434:0.4": "",
  "ja434:1.1": "kāsāyavatthe sakuṇe vadāmi ",
  "ja434:1.2": "duve duve nandimane carante, ",
  "ja434:1.3": "kaṃ aṇḍajaṃ aṇḍajā mānusesu ",
  "ja434:1.4": "jātiṃ pasajasanti tadiṅgha brūtha. ",
  "ja434:2.1": "amhe manussesu manussahiṃsa ",
  "ja434:2.2": "anubbake cakkavāke vadanti, ",
  "ja434:2.3": "kalyāṇabhāvambha dijesu sammatā ",
  "ja434:2.4": "abhītarūpā vicarāma aṇṇave. ",
  "ja434:2.5": "",
  "ja434:3.1": "kiṃ aṇṇave kāni phalāni bhuñje ",
  "ja434:3.2": "maṃsaṃ kuto khādatha cakkavākā, ",
  "ja434:3.3": "kiṃ bhojanaṃ bhuñjatha vo anomā ",
  "ja434:3.4": "balañca vaṇṇo ca anapparūpo. ",
  "ja434:4.1": "na aṇṇave santi phalāni dhaṅka ",
  "ja434:4.2": "maṃsaṃ kuto khādituṃ cakkavāke, ",
  "ja434:4.3": "sevālabhakkhambha avāka bhojanā ",
  "ja434:4.4": "na ghāsahetu pakaroma pāpaṃ. ",
  "ja434:5.1": "na me idaṃ ruccati cakkavāke ",
  "ja434:5.2": "asmiṃ bhave bhojanasantikāso, ",
  "ja434:5.3": "ahosi me pubbe tato me aññathā ",
  "ja434:5.4": "icceva me vimatī ettha jātā. ",
  "ja434:6.1": "ahampi maṃsāni phalāni bhuñje ",
  "ja434:6.2": "annāni ca loṇiyateliyāni, ",
  "ja434:6.3": "rasaṃ manussesu labhāmi hottuṃ ",
  "ja434:6.4": "sūrova saṅgāma mukhambhi jetvā. ",
  "ja434:6.5": "na ca me tādiso vaṇṇo ",
  "ja434:6.6": "cakkavāka yathā tava. ",
  "ja434:7.1": "asuddhabhakkhosi khaṇānupātī ",
  "ja434:7.2": "kicchena te labbhati annapānaṃ, ",
  "ja434:7.3": "na tussasi rukkhaphalehi dhaṅka ",
  "ja434:7.4": "maṃsāni vā yāni susānamajjhe. ",
  "ja434:8.1": "yo sāhasena adhigamma bhoge ",
  "ja434:8.2": "paribhuñjati dhaṅka khaṇānupātī, ",
  "ja434:8.3": "tato upakkosati naṃ sabhāvo ",
  "ja434:8.4": "upakkuṭṭho vaṇṇabalaṃ jahāti. ",
  "ja434:9.1": "appampi ce nibbutiṃ bhuñjati yadi ",
  "ja434:9.2": "asāhasena aparūpaghātī ",
  "ja434:9.3": "balañca vaṇṇo ca tadassa hoti ",
  "ja434:9.4": "na hi sabbo āhāramayena vaṇṇoti. ",
  "ja434:10.1": "8. cakkavākajātakaṃ. "
}
