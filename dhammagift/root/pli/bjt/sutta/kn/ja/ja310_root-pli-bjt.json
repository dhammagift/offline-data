  "ja310:0.4": "",
  "ja310:1.1": "sasamuddapariyāyaṃ ",
  "ja310:1.2": "mahiṃ sāgarakuṇḍalaṃ ",
  "ja310:1.3": "na icche sahanindāya ",
  "ja310:1.4": "evaṃ sayha vijānahi. ",
  "ja310:2.1": "dhiratthu taṃ yasalābhaṃ ",
  "ja310:2.2": "dhanalābhañca brāhmaṇa, ",
  "ja310:2.3": "yā vutti vinipātena ",
  "ja310:2.4": "adhammacaraṇena vā. ",
  "ja310:3.1": "api ce pattamādāya ",
  "ja310:3.2": "anāgāro paribbaje, ",
  "ja310:3.3": "sāyeva jivikā seyyo ",
  "ja310:3.4": "yā cādhammena esanā. ",
  "ja310:4.1": "api ce pattamādāya ",
  "ja310:4.2": "anāgāro paribbaje, ",
  "ja310:4.3": "aññaṃ ahiṃsayaṃ loke ",
  "ja310:4.4": "api rajjena taṃ varanti. ",
  "ja310:5.1": "",
  "ja310:5.2": "10. sayhajātakaṃ. vivaravaggo paṭhamo. ",
  "ja310:6.1": "tassuddānaṃ: ",
  "ja310:7.1": "vivarañca adeyyasamiddhavaraṃ ",
  "ja310:7.2": "atha daddarapāpamahātiraho, ",
  "ja310:7.3": "atha kolipalāsamarañca kara ",
  "ja310:7.4": "carimaṃ sasamuddavarena dasa. "
}
