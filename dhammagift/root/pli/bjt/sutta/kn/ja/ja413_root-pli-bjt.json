  "ja413:0.3": "",
  "ja413:0.4": "7. koṭisimbalijātakaṃ. ",
  "ja413:1.1": "rājā apucchi vidhuraṃ ",
  "ja413:1.2": "dhammakāmo yudhiṭṭhilo, ",
  "ja413:1.3": "api brāhmaṇa jānāsi ",
  "ja413:1.4": "ko eko bahu socati. ",
  "ja413:2.1": "brāhmaṇo ajayūthena ",
  "ja413:2.2": "bahūtedho vane vasaṃ, ",
  "ja413:2.3": "dhūmaṃ akāsi vāseṭṭho ",
  "ja413:2.4": "rattindivamatandito. ",
  "ja413:3.1": "tassa taṃ dhūmagandhena ",
  "ja413:3.2": "sarabhā makasadditā, ",
  "ja413:3.3": "vassāvāsaṃ upagañchuṃ ",
  "ja413:3.4": "dhūmakārissa santike. ",
  "ja413:4.1": "sarabhesu manaṃ katvā ",
  "ja413:4.2": "ajāyo nāvabujjhatha, ",
  "ja413:4.3": "āgacchantī vajantī vā ",
  "ja413:4.4": "tassa tā vinassuṃ ajā. ",
  "ja413:5.1": "sarabhā ca sarade kāle ",
  "ja413:5.2": "pahīnamakase vane, ",
  "ja413:5.3": "pāvisuṃ giriduggāni ",
  "ja413:5.4": "nadīnaṃ pabhavāni ca. ",
  "ja413:6.1": "sarabhe ca gate disvā ",
  "ja413:6.2": "ajā ca vibhavaṃ gatā, ",
  "ja413:6.3": "kiso ca vivaṇṇo āsi ",
  "ja413:6.4": "paṇḍurogī ca brāhmaṇo. ",
  "ja413:7.1": "evaṃ yo saṃniraṃkatvā ",
  "ja413:7.2": "āgantuṃ kurute piyaṃ, ",
  "ja413:7.3": "so eko bahu socati ",
  "ja413:7.4": "dhūmakārīva brāhmaṇoti. ",
  "ja413:8.1": ""
}
