  "ja350:1.1": "hanti hatthehi pādehi ",
  "ja350:1.2": "mukhañca parisumbhati, ",
  "ja350:1.3": "sa ve rāja piyo hoti ",
  "ja350:1.4": "kaṃ tenamabhipassasi. ",
  "ja350:2.1": "akkosati yathākāmaṃ ",
  "ja350:2.2": "āgamañcassa na icchati, ",
  "ja350:2.3": "sa ce rāja piyo hoti ",
  "ja350:2.4": "kaṃ tenambhipassasi. ",
  "ja350:3.1": "abbhakkhāti abhūtena ",
  "ja350:3.2": "alikenamabhisāraye, ",
  "ja350:3.3": "sa ve rāja piyo hoti ",
  "ja350:3.4": "kaṃ tenamabhipassasi. ",
  "ja350:4.1": "haraṃ annañca pānañca ",
  "ja350:4.2": "vatthasenāsanāni ca, ",
  "ja350:4.3": "aññadatthu harā santā ",
  "ja350:4.4": "te ve rāja piyā honti, ",
  "ja350:4.5": "kaṃ tena mabhipassasīti. ",
  "ja350:5.1": "devatāpañho ",
  "ja350:5.2": "cūḷakuṇālavaggo pañcamo. ",
  "ja350:6.1": "tassuddānaṃ: ",
  "ja350:7.1": "narānaṃ asakkhivasimbhavaro ",
  "ja350:7.2": "nīliyamaggivarañca puna, ",
  "ja350:7.3": "puna rasāyasakūṭavaro ",
  "ja350:7.4": "tathāraññasārathi hanti dasa. catukkanipāto ",
  "ja350:8.1": "niṭṭhito. tatra vagguddānaṃ: ",
  "ja350:9.1": "vivaraṃ pucimandañca ",
  "ja350:9.2": "kuṭidūsaṃ bahuhāṇakaṃ, ",
  "ja350:9.3": "cūḷakuṇālavaggo so ",
  "ja350:9.4": "pañcamo suppakāsitoti. ",
  "ja350:10.1": ""
}
