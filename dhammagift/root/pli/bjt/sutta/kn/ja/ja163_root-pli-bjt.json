  "ja163:1.1": "kāḷā migā setadantā tava ime ",
  "ja163:1.2": "parosataṃ hemajālāhisañchannā, ",
  "ja163:1.3": "te te dadāmīti susīma brūsi ",
  "ja163:1.4": "anussaraṃ pettipitāmahānaṃ. ",
  "ja163:2.1": "kāḷā migā setadantā mama ime ",
  "ja163:2.2": "parosataṃ hemajālābhisañjannā, ",
  "ja163:2.3": "te te dadāmīti vadāmi māṇava ",
  "ja163:2.4": "anussaraṃ pettipitāmahānatti. ",
  "ja163:3.1": "3. susīmajātakaṃ. "
}
