  "ja377:0.1": "",
  "ja377:0.2": "",
  "ja377:0.3": "",
  "ja377:0.4": "",
  "ja377:1.1": "mā tāta kujjhi na hi sādhu kodho ",
  "ja377:1.2": "bahumpi te adiṭṭhaṃ assutañca, ",
  "ja377:1.3": "mātā pitā disatā setaketu ",
  "ja377:1.4": "ācariyamāhu disataṃ pasatthā. ",
  "ja377:2.1": "agārino annadapāṇavatthadā ",
  "ja377:2.2": "avhāyikā tampi disaṃ vadanti ",
  "ja377:2.3": "esā disā paramā setaketu ",
  "ja377:2.4": "yaṃ patvā dukkhī sukhino bhavanti. ",
  "ja377:3.1": "kharājinā jaṭilā paṅkadantā ",
  "ja377:3.2": "dumukkharūpā ye me japanti mante, ",
  "ja377:3.3": "kacci nu te mānusike payoge ",
  "ja377:3.4": "idaṃ vidū parimuttā apāyā. ",
  "ja377:4.1": "pāpāni kammāni karitva rāja ",
  "ja377:4.2": "bahussuto neva careyya dhammaṃ, ",
  "ja377:4.3": "sabhassavedāpi na taṃ paṭicca ",
  "ja377:4.4": "dukkhā pamuñce caraṇaṃ apatvā ",
  "ja377:5.1": "sahassavedopi na taṃ paṭicca ",
  "ja377:5.2": "dukkhā pamuñce caraṇaṃ apatvā, ",
  "ja377:5.3": "maññāmi vedā aphalā bhavanti ",
  "ja377:5.4": "sasaññamaṃ caraṇaññeva saccaṃ. ",
  "ja377:6.1": "naheva vedā aphalā bhavanti ",
  "ja377:6.2": "sasaṃyamaṃ caraṇañceva saccaṃ, ",
  "ja377:6.3": "kittiṃ hi pappoti adhicca vede ",
  "ja377:6.4": "santaṃ putoti caraṇena dantoti. ",
  "ja377:7.1": "2. setaketujātakaṃ. "
}
