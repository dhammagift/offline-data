  "ja224:1.1": "yassete caturo dhammā ",
  "ja224:1.2": "vānarinda yathā tava, ",
  "ja224:1.3": "saccaṃ dhammo dhitī cāgo ",
  "ja224:1.4": "diṭṭhaṃ so ativattati. ",
  "ja224:2.1": "yassa cete na vijjanti ",
  "ja224:2.2": "guṇā paramabhaddakā, ",
  "ja224:2.3": "saccaṃ dhammo dhitī cāgo ",
  "ja224:2.4": "diṭṭhiṃ so nātivattatī’ti. ",
  "ja224:3.1": "4. kumbhīlajātakaṃ. "
}
