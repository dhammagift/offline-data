  "ja545:0.4": "7. mahānāradakassapajātakaṃ ",
  "ja545:1.1": "ahu rājā videhānaṃ ",
  "ja545:1.2": "aṅgāti nāma khattiyo, ",
  "ja545:1.3": "pahūtayoggo dhanimā ",
  "ja545:1.4": "anantabalaporiso. ",
  "ja545:2.1": "so ca paṇṇarasiṃ rattiṃ ",
  "ja545:2.2": "purime yāme anāgate, ",
  "ja545:2.3": "cātumassa komudiyā ",
  "ja545:2.4": "amacce sannipātayi. ",
  "ja545:3.1": "paṇḍite sutasampanne ",
  "ja545:3.2": "mihitapubbe vivakkhaṇe, ",
  "ja545:3.3": "vijayañca sunāmañca ",
  "ja545:3.4": "senāpatimalātakaṃ. ",
  "ja545:4.1": "tamanupucchi vedeho ",
  "ja545:4.2": "paccekaṃ brūtha saṃruciṃ, cātumassa ",
  "ja545:4.3": "komudajja ",
  "ja545:4.4": "juṇhaṃ vyapagataṃ tamaṃ ",
  "ja545:4.5": "kāyajja ratiyā rattiṃ ",
  "ja545:4.6": "viharemu imaṃ utuṃ. ",
  "ja545:5.1": "tato senāpatī rañño ",
  "ja545:5.2": "alāto etadabravi, ",
  "ja545:5.3": "haṭṭhaṃ yoggaṃ balaṃ sabbaṃ ",
  "ja545:5.4": "senaṃ santāhayāmase. ",
  "ja545:6.1": "niyyāma deva yuddhāya ",
  "ja545:6.2": "anantabalaporisā, ",
  "ja545:6.3": "ye te vasaṃ na āyanti ",
  "ja545:6.4": "vasaṃ upanayāmase, ",
  "ja545:6.5": "esā mayhaṃ sakādiṭṭhi ",
  "ja545:6.6": "ajitaṃ ojināmase. ",
  "ja545:7.1": "alātassa vaco sutvā ",
  "ja545:7.2": "sunāmo etadabravi, ",
  "ja545:7.3": "sabbe tuyhaṃ mahārāja ",
  "ja545:7.4": "amittā vasamāgatā. ",
  "ja545:8.1": "nikkhittasatthā paccatthā ",
  "ja545:8.2": "nivātamanuvatatare, ",
  "ja545:8.3": "uttamo ussavo ajja ",
  "ja545:8.4": "na yuddhaṃ mama ruccati. ",
  "ja545:9.1": "annaṃ pānañca khajjañca ",
  "ja545:9.2": "khippaṃ abhiharantu te, ",
  "ja545:9.3": "ramassu deva kāmehi ",
  "ja545:9.4": "naccagīte suvādite. ",
  "ja545:10.1": "sunāmassa vaco sutvā ",
  "ja545:10.2": "vijayo etadabravi, ",
  "ja545:10.3": "sabbe kāmā mahārāja ",
  "ja545:10.4": "niccaṃ tava apaṭṭhitā. ",
  "ja545:11.1": "na hete dullabhā deva ",
  "ja545:11.2": "tava kāmehi modituṃ, ",
  "ja545:11.3": "sadāpi kāmā labbhanti ",
  "ja545:11.4": "netaṃ cittamataṃ mama, ",
  "ja545:12.1": "samaṇaṃ brāhmaṇaṃ vāpi ",
  "ja545:12.2": "upāsemu bahussutaṃ, ",
  "ja545:12.3": "yo najja vinaye kaṅkhaṃ ",
  "ja545:12.4": "atthadhammavidū ise. ",
  "ja545:13.1": "vijayassa vaco sutvā ",
  "ja545:13.2": "rājā aṅgātimabravi, ",
  "ja545:13.3": "yathā vijayo bhaṇati ",
  "ja545:13.4": "mayhampeteva ruccati. ",
  "ja545:14.1": "samaṇaṃ brāhmaṇaṃ vāpi ",
  "ja545:14.2": "upāsemu bahussutaṃ, ",
  "ja545:14.3": "yo najja vinaye kaṅkhaṃ ",
  "ja545:14.4": "atthadhammavidū ise. ",
  "ja545:15.1": "sabbeva santā karotha matiṃ ",
  "ja545:15.2": "kaṃ upāsemu paṇḍitaṃ, ",
  "ja545:15.3": "ko najja vinaye kaṅkhaṃ ",
  "ja545:15.4": "atthadhammavidū ise. ",
  "ja545:16.1": "vedehassa vaco sutvā ",
  "ja545:16.2": "alāto etadabravi, ",
  "ja545:16.3": "atthāya migadāyasmiṃ ",
  "ja545:16.4": "acelo dhīrasammato. ",
  "ja545:17.1": "guṇo kassapagottāyaṃ ",
  "ja545:17.2": "suto citrakathi gaṇī, ",
  "ja545:17.3": "taṃ deva payirupāsaya ",
  "ja545:17.4": "so no kaṅkhaṃ vinessati. ",
  "ja545:18.1": "alātassa vaco sutvā ",
  "ja545:18.2": "rājā codesi sārathiṃ, ",
  "ja545:18.3": "migadāyaṃ gamissāma ",
  "ja545:18.4": "yuttaṃ yānaṃ idhānaya. ",
  "ja545:19.1": "tassa yānaṃ ayojesuṃ ",
  "ja545:19.2": "dantaṃ rūpiyapakkharaṃ, ",
  "ja545:19.3": "sukkamaṭṭhaparivāraṃ ",
  "ja545:19.4": "paṇḍaraṃ dosināmukhaṃ. ",
  "ja545:20.1": "tatrāsuṃ kumudā yuttā ",
  "ja545:20.2": "cattāro sindhavā hayā, ",
  "ja545:20.3": "anilūpamasamuppātā ",
  "ja545:20.4": "sudantā soṇṇamālino. ",
  "ja545:21.1": "setaṃ chattaṃ setaratho ",
  "ja545:21.2": "setassā setavījanī, ",
  "ja545:21.3": "vedeho sahamaccehi ",
  "ja545:21.4": "nīyyaṃ candova sobhatha. ",
  "ja545:22.1": "tamannuyāyuṃ bahāvo ",
  "ja545:22.2": "indakhaggadharā khalī, ",
  "ja545:22.3": "assapiṭṭhigatā dhīrā ",
  "ja545:22.4": "narā naravarādhipaṃ. ",
  "ja545:23.1": "so muhuttaṃ va yāyitvā ",
  "ja545:23.2": "yānā oruyha khattiyo, ",
  "ja545:23.3": "vedeho sahamaccehi ",
  "ja545:23.4": "patti guṇamupāgami. ",
  "ja545:24.1": "yopi tattha tadā āsuṃ ",
  "ja545:24.2": "brāhmaṇibbhā samāgatā, ",
  "ja545:24.3": "na te apanayī rājā ",
  "ja545:24.4": "akaṭaṃ bhūmimāgate. ",
  "ja545:25.1": "tato so mudukābhisiyā muducittakalandake, ",
  "ja545:25.2": "",
  "ja545:25.3": "mudupaccatthate rājā ",
  "ja545:25.4": "ekamantaṃ upāvisi. ",
  "ja545:26.1": "nisajja rājā sammodī ",
  "ja545:26.2": "kathaṃ sārāṇīyaṃ tato, ",
  "ja545:26.3": "kacci yāpanīyaṃ bhante ",
  "ja545:26.4": "vātānamavisaggatā. ",
  "ja545:27.1": "kacci akasirā vutti ",
  "ja545:27.2": "labbhati piṇḍayāpanaṃ, ",
  "ja545:27.3": "appābādhovasī kacci ",
  "ja545:27.4": "cakkhuṃ naṃ parihāyati. ",
  "ja545:28.1": "taṃ guṇopaṭisammodi ",
  "ja545:28.2": "vedehaṃ vinaye rataṃ, ",
  "ja545:28.3": "yāpanīyaṃ mahārāja ",
  "ja545:28.4": "sabbametaṃ tadūbhayaṃ. ",
  "ja545:29.1": "kacci tuyhampi vedeha ",
  "ja545:29.2": "paccantā na balīyare, ",
  "ja545:29.3": "kacci arogaṃ yoggante ",
  "ja545:29.4": "kacci vahati vāhanaṃ ",
  "ja545:29.5": "kacci te vyādhayo natthi ",
  "ja545:29.6": "sarīrassupatāpikā. ",
  "ja545:30.1": "paṭisammodito rājā ",
  "ja545:30.2": "tato pucchi anantarā, ",
  "ja545:30.3": "atthaṃ dhammañca ñāyañca ",
  "ja545:30.4": "dhammakāmo rathesabho. ",
  "ja545:31.1": "kathaṃ dhammaṃ care macco ",
  "ja545:31.2": "mātāpitusu kassapa, ",
  "ja545:31.3": "kathaṃ care ācariye ",
  "ja545:31.4": "puttadāre kathaṃ care. ",
  "ja545:32.1": "kathaṃ careyya vuddhesu ",
  "ja545:32.2": "kathaṃ samaṇabrāhmaṇe, ",
  "ja545:32.3": "kathañca balakāyasmiṃ ",
  "ja545:32.4": "kathaṃ jānapade care. ",
  "ja545:33.1": "kathaṃ dhammaṃ caritvāna ",
  "ja545:33.2": "pecca gacchati suggatiṃ, ",
  "ja545:33.3": "kathañceke adhammaṭṭhā ",
  "ja545:33.4": "patanti nirayaṃ adho. ",
  "ja545:34.1": "vedehassa vaco sutvā ",
  "ja545:34.2": "kassapo ekadabravi, ",
  "ja545:34.3": "suṇohi me mahārāja ",
  "ja545:34.4": "saccaṃ avitathaṃ padaṃ. ",
  "ja545:35.1": "natthi dhammassa ciṇṇassa ",
  "ja545:35.2": "phalaṃ kalyāṇapāpakaṃ, ",
  "ja545:35.3": "natthi deva paro loko ",
  "ja545:35.4": "ko tato hi idhāgato. ",
  "ja545:36.1": "natthi deva pitaro vā ",
  "ja545:36.2": "kuto mātā kuto pitā, ",
  "ja545:36.3": "natthi ācariyo nāma ",
  "ja545:36.4": "adantaṃ ko damessati. ",
  "ja545:37.1": "samatulyāni bhūtāni ",
  "ja545:37.2": "natthi jeṭṭhāpacāyino, ",
  "ja545:37.3": "natthi balaṃ vā viriyaṃ vā ",
  "ja545:37.4": "kuto uṭṭhānaporisaṃ, ",
  "ja545:37.5": "niyatāni hi bhūtāni ",
  "ja545:37.6": "yathā goṭaviso tathā. ",
  "ja545:38.1": "laddheyyaṃ labhate macco ",
  "ja545:38.2": "tattha dānaphalaṃ kuto, ",
  "ja545:38.3": "natthi dānaphalaṃ deva ",
  "ja545:38.4": "avaso deva vīriyo. ",
  "ja545:39.1": "bālehi dānaṃ paññattaṃ ",
  "ja545:39.2": "paṇḍitehi paṭicchitaṃ, ",
  "ja545:39.3": "avāsā denti dhīrānaṃ ",
  "ja545:39.4": "bālā paṇḍitamānino. ",
  "ja545:40.1": "sattime sassatā kāyā ",
  "ja545:40.2": "acchejjā avikopino, ",
  "ja545:40.3": "tejo paṭhavirāpo ca ",
  "ja545:40.4": "vāyo sukhadukhañcime ",
  "ja545:40.5": "jīve ca sattime kāyā ",
  "ja545:40.6": "yesaṃ chettā na vijjati. ",
  "ja545:41.1": "natthi hantā vā chettā vā ",
  "ja545:41.2": "haññare vāpi koci naṃ; ",
  "ja545:41.3": "antareneva kāyānaṃ ",
  "ja545:41.4": "satthāni vītivattare. ",
  "ja545:42.1": "yopāyaṃ siramādāya ",
  "ja545:42.2": "paresaṃ nisitāsinā, ",
  "ja545:42.3": "na so chindati te kāye ",
  "ja545:42.4": "tattha pāpaphalaṃ kuto. ",
  "ja545:43.1": "cullāsīti mahākappe ",
  "ja545:43.2": "sabbe sujjhanti saṃsaraṃ, ",
  "ja545:43.3": "anāgate tamhi kāle ",
  "ja545:43.4": "saññatopi na sujjhati. ",
  "ja545:44.1": "caritvāpi bahuṃ bhadraṃ ",
  "ja545:44.2": "neva sujjhanti nāgate, ",
  "ja545:44.3": "pāpaṃ cepi bahuṃ katvā ",
  "ja545:44.4": "taṃ khaṇaṃ nātivattare. ",
  "ja545:45.1": "anupubbena no suddhi ",
  "ja545:45.2": "kappānaṃ cullasītiyā, ",
  "ja545:45.3": "niyatiṃ nātivattāma ",
  "ja545:45.4": "velantamiva sāgaro. ",
  "ja545:46.1": "kassapassa vaco sutvā ",
  "ja545:46.2": "alāto etadabravi, ",
  "ja545:46.3": "yathā bhadanto bhaṇati ",
  "ja545:46.4": "mayhaṃpeteva ruccati. ",
  "ja545:47.1": "ahaṃpi purimaṃ jātiṃ ",
  "ja545:47.2": "sare saṃsaritattano, ",
  "ja545:47.3": "piṅgalo nāmahaṃ āsiṃ ",
  "ja545:47.4": "luddo goghātako pure. ",
  "ja545:48.1": "bārāṇasiyaṃ phitāya ",
  "ja545:48.2": "bahuṃ pāpaṃ kataṃ mayā, ",
  "ja545:48.3": "bahū mayhaṃ hatā pāṇā ",
  "ja545:48.4": "mahisā sūkarā ajā. ",
  "ja545:49.1": "tato cuto idha jāto ",
  "ja545:49.2": "iddhe senāpatīkule, ",
  "ja545:49.3": "natthi nūna phalaṃ pāpe ",
  "ja545:49.4": "sohaṃ na nirayaṃ gato. ",
  "ja545:50.1": "athettha bījako nāma ",
  "ja545:50.2": "dāso āsi paḷaccarī, ",
  "ja545:50.3": "uposathaṃ upavasanto ",
  "ja545:50.4": "gaṇasantikupāgami. ",
  "ja545:51.1": "kassapassa vaco sutvā ",
  "ja545:51.2": "alātassa ca bhāsitaṃ, ",
  "ja545:51.3": "passasanto muhuṃ uṇhaṃ ",
  "ja545:51.4": "rudaṃ assūni vattayi. ",
  "ja545:52.1": "tamanupucchi vedeho ",
  "ja545:52.2": "kimatthaṃ samma rodasi, ",
  "ja545:52.3": "kinte sutaṃ vā diṭṭhaṃ vā ",
  "ja545:52.4": "kiṃ maṃ vedesi vedanaṃ. ",
  "ja545:53.1": "vedehassa vaco sutvā ",
  "ja545:53.2": "bījako etadabravi, ",
  "ja545:53.3": "natthi me vedanā dukkhā ",
  "ja545:53.4": "mahārāja suṇohi me. ",
  "ja545:54.1": "ahampi purimaṃ jātiṃ ",
  "ja545:54.2": "sarāmi sukhamattano, ",
  "ja545:54.3": "sāketāhaṃ pure āsiṃ ",
  "ja545:54.4": "bhāvaseṭṭhi guṇe rato. ",
  "ja545:55.1": "sammato brāhmaṇibbhānaṃ ",
  "ja545:55.2": "saṃvihāgarato suci, ",
  "ja545:55.3": "na cāpi pāpakaṃ kammaṃ ",
  "ja545:55.4": "sarāmi katamattano. ",
  "ja545:56.1": "tato cutāhaṃ vedeha ",
  "ja545:56.2": "idha jāto duritthiyā, ",
  "ja545:56.3": "gabbhambhi kumbhadāsiyā ",
  "ja545:56.4": "yato jāto suduggato. ",
  "ja545:57.1": "evampi duggato santo ",
  "ja545:57.2": "samacariyaṃ adhiṭṭhito, ",
  "ja545:57.3": "upaḍḍhahāgaṃ bhattassa ",
  "ja545:57.4": "dadāmi yo me icchati. ",
  "ja545:58.1": "cātuddasiṃ pañcadasiṃ ",
  "ja545:58.2": "sadā upavasāmahaṃ, ",
  "ja545:58.3": "na cāpi bhūte hiṃsāmi ",
  "ja545:58.4": "theyyañcāpi vivajjayiṃ. ",
  "ja545:59.1": "sabbameva hi nūnetaṃ ",
  "ja545:59.2": "suciṇṇaṃ bhavati nipphalaṃ, ",
  "ja545:59.3": "niratthaṃ maññidaṃ sīlaṃ ",
  "ja545:59.4": "alāto yatha bhāsati. ",
  "ja545:60.1": "kalimeva nūna gaṇhāmi ",
  "ja545:60.2": "asippo dhuttako yathā, ",
  "ja545:60.3": "kaṭaṃ alāto gaṇhāti ",
  "ja545:60.4": "kitavo sikkhito yathā. ",
  "ja545:61.1": "dvāraṃ nappatipassāmi ",
  "ja545:61.2": "yena gacchāmi suggatiṃ, ",
  "ja545:61.3": "tasmā rāja parodāmi ",
  "ja545:61.4": "sutvā kassapabhāsitaṃ. ",
  "ja545:62.1": "bījakassa vaco sutvā ",
  "ja545:62.2": "rājā aṅgātimabravi, ",
  "ja545:62.3": "natthi dvāraṃ sugatiyā ",
  "ja545:62.4": "niyatiṃ kaṅkha bījaka. ",
  "ja545:63.1": "sukhaṃ vā yadivā dukkhaṃ ",
  "ja545:63.2": "niyatiyā kira labbhati, ",
  "ja545:63.3": "saṃsārasuddhi sabbesaṃ ",
  "ja545:63.4": "mā turittho anāgate. ",
  "ja545:64.1": "ahampi pubbe kalyāṇe ",
  "ja545:64.2": "brāhmaṇibbhesu vyāvaṭo, ",
  "ja545:64.3": "vohāramanusāsanto ",
  "ja545:64.4": "ratihino tadantarā. ",
  "ja545:65.1": "punapi bhante dakkhemu ",
  "ja545:65.2": "saṅgati ce bhavissati, ",
  "ja545:65.3": "idaṃ vatvāna vedeho ",
  "ja545:65.4": "paccagā sanivesanaṃ. ",
  "ja545:66.1": "tato ratyā vivasane ",
  "ja545:66.2": "upaṭṭhānambhi aṅgati, ",
  "ja545:66.3": "amacce sannipātetvā ",
  "ja545:66.4": "idaṃ vacanamabravi: ",
  "ja545:67.1": "candake me vimānasmiṃ ",
  "ja545:67.2": "sadā kāme vidhentu me, ",
  "ja545:67.3": "māmūpagacchuṃ atthesu ",
  "ja545:67.4": "guyhappākāsiyesu ca. ",
  "ja545:68.1": "vijayo ca sunāmo ca ",
  "ja545:68.2": "senāpati alātako, ",
  "ja545:68.3": "ete atthe nisīdantu ",
  "ja545:68.4": "cohārakusalā tayo. ",
  "ja545:69.1": "idaṃ vatvāna vedeho ",
  "ja545:69.2": "kāme ca bahumaññatha, ",
  "ja545:69.3": "nacāpi brāhmaṇibbhesu ",
  "ja545:69.4": "atthe kismiñci vyāvaṭo. ",
  "ja545:70.1": "tato dve sattarattassa ",
  "ja545:70.2": "vedehassatrajā piyā, ",
  "ja545:70.3": "rājakaññā rujā nāma ",
  "ja545:70.4": "dhātimātaramabravi: ",
  "ja545:71.1": "alaṅkarotha maṃ khippaṃ ",
  "ja545:71.2": "sakhiyo ca karontu me, ",
  "ja545:71.3": "suve paṇṇaraso dibbo ",
  "ja545:71.4": "gacchaṃ issarasantike. ",
  "ja545:72.1": "tassā mālyaṃ abhihariṃsu ",
  "ja545:72.2": "candanañca mahārahaṃ, ",
  "ja545:72.3": "maṇisaṅkhamuttaratanaṃ ",
  "ja545:72.4": "nānāratte ca ambare. ",
  "ja545:73.1": "tañca sovaṇṇaye pīṭhe ",
  "ja545:73.2": "nisinnaṃ bahukitthiyo, ",
  "ja545:73.3": "parikiriya asobhiṃsu ",
  "ja545:73.4": "rujaṃ ruciravaṇṇiniṃ. ",
  "ja545:74.1": "sā ca sakhīmajjhagatā ",
  "ja545:74.2": "sabbābharaṇabhūsitā, ",
  "ja545:74.3": "sateratā abbhamiva ",
  "ja545:74.4": "candakaṃ pāvisī rujā. ",
  "ja545:75.1": "upasaṅkamitvā vedehaṃ ",
  "ja545:75.2": "vanditvā vinaye ratā, ",
  "ja545:75.3": "suvaṇṇavikate pīṭhe ",
  "ja545:75.4": "ekamantaṃ upāvisi. ",
  "ja545:76.1": "tañca disvāna vedeho ",
  "ja545:76.2": "accharānaṃva saṅgamaṃ, ",
  "ja545:76.3": "rujaṃ sakhimajjhagataṃ ",
  "ja545:76.4": "idaṃ vacanamabravi: ",
  "ja545:77.1": "kacci ramasi pāsāde ",
  "ja545:77.2": "anto pokkharaṇiṃ pati, ",
  "ja545:77.3": "kacci bahuvidhaṃ khajjaṃ ",
  "ja545:77.4": "sadā abhiharanti te. ",
  "ja545:78.1": "kacci bahuvidhaṃ mālyaṃ ",
  "ja545:78.2": "ocinitvā kumāriyo, ",
  "ja545:78.3": "gharake karotha paccekaṃ ",
  "ja545:78.4": "khiḍḍhāratiratā muhuṃ. ",
  "ja545:79.1": "kena vā vikalaṃ tuyhaṃ ",
  "ja545:79.2": "khippaṃ abhiharantu te, ",
  "ja545:79.3": "māno karassu kuḍḍamukhī ",
  "ja545:79.4": "api candasamambhipi. ",
  "ja545:80.1": "vedehassa vaco sutvā ",
  "ja545:80.2": "rujā pitaramabravi: ",
  "ja545:80.3": "sabbametaṃ mahārāja ",
  "ja545:80.4": "labbhatissarasantike. ",
  "ja545:81.1": "suve paṇṇaraso dibbo ",
  "ja545:81.2": "sahassaṃ āharantu me, ",
  "ja545:81.3": "yathādinnañca dassāmi ",
  "ja545:81.4": "dānaṃ sabbavaṇīsu’haṃ. ",
  "ja545:82.1": "rujāya vacanaṃ sutvā ",
  "ja545:82.2": "rājā aṅgātimabravi: ",
  "ja545:82.3": "bahuṃ vināsitaṃ vittaṃ ",
  "ja545:82.4": "niratthaṃ aphalaṃ tayā. ",
  "ja545:83.1": "uposathaṃ vasaṃ niccaṃ ",
  "ja545:83.2": "annapānaṃ na bhuñjasi, ",
  "ja545:83.3": "niyatetaṃ abhuttabbaṃ ",
  "ja545:83.4": "natthi puññaṃ abhuñjato. ",
  "ja545:84.1": "bījakopi hi sutvāna ",
  "ja545:84.2": "tadā kassapabhāsitaṃ, ",
  "ja545:84.3": "passasanto muhuṃ uṇhaṃ ",
  "ja545:84.4": "rudaṃ assūni vattayi. ",
  "ja545:85.1": "yāva ruje jīvasi no ",
  "ja545:85.2": "mā bhattamapanāmayi, ",
  "ja545:85.3": "natthi bhadde paro loko ",
  "ja545:85.4": "kiṃ niratthaṃ vihaññasi. ",
  "ja545:86.1": "vedehassa vaco sutvā ",
  "ja545:86.2": "rujā ruciravaṇṇini, ",
  "ja545:86.3": "jānaṃ pubbāparaṃ dhammaṃ ",
  "ja545:86.4": "pitaraṃ etadabravi: ",
  "ja545:87.1": "sutameva me pure āsi ",
  "ja545:87.2": "sakkhī diṭṭhamidaṃ mayā, ",
  "ja545:87.3": "khālūpasevī yo hoti ",
  "ja545:87.4": "bālova samapajjatha. ",
  "ja545:88.1": "mūḷho hi mūḷhamāgamma ",
  "ja545:88.2": "bhiyyo mohaṃ nigacchati, ",
  "ja545:88.3": "pakirūpaṃ alātena ",
  "ja545:88.4": "bījakena ca muyhituṃ. ",
  "ja545:89.1": "tvañca dve sappañño ",
  "ja545:89.2": "dhīro atthassa kovido, ",
  "ja545:89.3": "kathaṃ bālehi sadisaṃ ",
  "ja545:89.4": "hīnaṃ diṭṭhiṃ upāgami. ",
  "ja545:90.1": "sace hi saṃsārapathena sujjhati ",
  "ja545:90.2": "niratthiyā pabbajjā guṇassa, ",
  "ja545:90.3": "kīṭova aggiṃ jalitaṃ apāpataṃ ",
  "ja545:90.4": "uppajjati momūho naggabhāvaṃ. ",
  "ja545:91.1": "saṃsārasuddhīti pure niviṭṭhā ",
  "ja545:91.2": "kammaṃ vidūsenti bahū ajānaṃ, ",
  "ja545:91.3": "pubbe kalī duggahitova ",
  "ja545:91.4": "atthā dummocayā balisā ambujova. ",
  "ja545:92.1": "upamaṃ te karissāmi ",
  "ja545:92.2": "mahārāja navatthiyā, ",
  "ja545:92.3": "upamāyapidhekacce ",
  "ja545:92.4": "atthaṃ jānanti paṇḍitā. ",
  "ja545:93.1": "vāṇijānaṃ yathā nāvā ",
  "ja545:93.2": "appamāṇabharā garu, ",
  "ja545:93.3": "atibhāraṃ samādāya ",
  "ja545:93.4": "aṇṇave avasīdati. ",
  "ja545:94.1": "evameva naro pāpaṃ ",
  "ja545:94.2": "thoka thokampi ācinaṃ, ",
  "ja545:94.3": "atibhāraṃ samādāya ",
  "ja545:94.4": "niraye avasīdati. ",
  "ja545:95.1": "na tāva bhāro paripūro ",
  "ja545:95.2": "alātassa mahīpati. ",
  "ja545:95.3": "ācināti ca taṃ pāpaṃ ",
  "ja545:95.4": "yena gacchati duggatiṃ. ",
  "ja545:96.1": "pubbevassa kataṃ puññaṃ ",
  "ja545:96.2": "alātassa mahīpati, ",
  "ja545:96.3": "tassesa dve nissando ",
  "ja545:96.4": "yañceso labhate sukhaṃ. ",
  "ja545:97.1": "khīyatevassa taṃ puññaṃ ",
  "ja545:97.2": "tathāhi aguṇe rato, ",
  "ja545:97.3": "ujumaggaṃ avāhāya ",
  "ja545:97.4": "kummaggamanudhāvati. ",
  "ja545:98.1": "tulā yathā paggahitā ",
  "ja545:98.2": "ohite tulamaṇḍale, ",
  "ja545:98.3": "unnameti tulāsīsaṃ ",
  "ja545:98.4": "bhāre oropite sati. ",
  "ja545:99.1": "evameva naro puññaṃ ",
  "ja545:99.2": "thokathokampi ācinaṃ, ",
  "ja545:99.3": "saggātimāno dāsova ",
  "ja545:99.4": "bījako sātave rato. ",
  "ja545:100.1": "yañcajja bījako dāso ",
  "ja545:100.2": "dukkhaṃ passati attani, ",
  "ja545:100.3": "pubbe tassa kataṃ pāpaṃ ",
  "ja545:100.4": "tameso paṭisevati. ",
  "ja545:101.1": "khīyatecassa taṃ pāpaṃ ",
  "ja545:101.2": "tathāhi vinaye rato, ",
  "ja545:101.3": "kassapañca samāpajja ",
  "ja545:101.4": "māhevuppatha māgamā. ",
  "ja545:102.1": "yaṃ yaṃ hi rāja bhajati ",
  "ja545:102.2": "sataṃ vā yadi vā asaṃ, ",
  "ja545:102.3": "sīlavantaṃ visīlaṃ vā ",
  "ja545:102.4": "vasaṃ tasseva gacchati. ",
  "ja545:103.1": "yādisaṃ kurute mittaṃ ",
  "ja545:103.2": "yādisañcupasevati, ",
  "ja545:103.3": "sopi tādisako hoti ",
  "ja545:103.4": "sahavāso hi tādiso. ",
  "ja545:104.1": "sevamāno sevamānaṃ ",
  "ja545:104.2": "samphuṭṭho samphusaṃ paraṃ, ",
  "ja545:104.3": "saro diddho kalāpaṃva ",
  "ja545:104.4": "alittamupalimpati ",
  "ja545:104.5": "upalepabhayā dhīro ",
  "ja545:104.6": "neva pāpasakhā siyā. ",
  "ja545:105.1": "pūtimacchaṃ kusaggena ",
  "ja545:105.2": "yo naro upanayhati, ",
  "ja545:105.3": "kusāpi pūti vāyanti ",
  "ja545:105.4": "evaṃ bālūpasevanā. ",
  "ja545:106.1": "tagarañca palāsena ",
  "ja545:106.2": "yo naro upanayhati, ",
  "ja545:106.3": "pattāpi surabhi vāyanti ",
  "ja545:106.4": "evaṃ dhīrūpasevanā. ",
  "ja545:107.1": "tasmā palapuṭasseva ",
  "ja545:107.2": "ñatvā sampāka mattano, ",
  "ja545:107.3": "asante nopaseveyya ",
  "ja545:107.4": "sante seveyya paṇḍito ",
  "ja545:107.5": "asanto nirayaṃ nenti ",
  "ja545:107.6": "santo pāpenti suggatiṃ. ",
  "ja545:108.1": "ahampi jātiyo satta ",
  "ja545:108.2": "sare saṃsaritattano, ",
  "ja545:108.3": "anāgatāpi satteva ",
  "ja545:108.4": "yā gamissaṃ ito cutā. ",
  "ja545:109.1": "yā me sā sattamī jāti ",
  "ja545:109.2": "ahu pubbe janādhipa, ",
  "ja545:109.3": "kammāraputto magadhesu ",
  "ja545:109.4": "ahuṃ rājagahe pure. ",
  "ja545:110.1": "pāpaṃ sabhāyaṃ āgamma ",
  "ja545:110.2": "bahuṃ pāpaṃ kataṃ mayā, ",
  "ja545:110.3": "paradārassa heṭhento ",
  "ja545:110.4": "carimbha amarā viya. ",
  "ja545:111.1": "taṃ kammaṃ nihitaṃ aṭṭhā ",
  "ja545:111.2": "bhasmacchattova pāvako, ",
  "ja545:111.3": "atha aññehi kammehi ",
  "ja545:111.4": "ajāyiṃ vaṃsabhūmiyaṃ. ",
  "ja545:112.1": "kosambiyaṃ seṭṭhikule ",
  "ja545:112.2": "iddhe phīte mahaddhane, ",
  "ja545:112.3": "ekaputto mahārāja ",
  "ja545:112.4": "niccaṃ sakkatapūjito. ",
  "ja545:113.1": "tattha mittaṃ asevissaṃ ",
  "ja545:113.2": "sahāyaṃ sātave rataṃ, ",
  "ja545:113.3": "paṇḍitaṃ sutasampannaṃ ",
  "ja545:113.4": "so maṃ atthe nivesayi. ",
  "ja545:114.1": "cātuddasiṃ pañcadasiṃ ",
  "ja545:114.2": "bahuṃ rattimupāvasiṃ, ",
  "ja545:114.3": "taṃ kammaṃ nihitaṃ aṭṭhā ",
  "ja545:114.4": "nidhīva udakantike. ",
  "ja545:115.1": "atha pāpānaṃ kammānaṃ ",
  "ja545:115.2": "yametaṃ magadhe kataṃ ",
  "ja545:115.3": "phalaṃ pariyāga taṃ pacchā ",
  "ja545:115.4": "bhutvā duṭṭhavisaṃ yathā. ",
  "ja545:116.1": "tato cutāhaṃ vedeha ",
  "ja545:116.2": "roruve niraye ciraṃ, ",
  "ja545:116.3": "sakammanā apaccissaṃ ",
  "ja545:116.4": "taṃ saraṃ na sukhaṃ labhe, ",
  "ja545:117.1": "bahuvassagaṇe tattha ",
  "ja545:117.2": "khepayitvā bahuṃ dukhaṃ, ",
  "ja545:117.3": "bheṇṇakaṭe ahuṃ rāja ",
  "ja545:117.4": "chakalo uddhitapphalo. ",
  "ja545:118.1": "sātaputtā mayā vūḷhā ",
  "ja545:118.2": "piṭṭhiyā ca rathena ca, ",
  "ja545:118.3": "tassa kammassa nissando ",
  "ja545:118.4": "paradāragamanassa me. ",
  "ja545:119.1": "tato cutāhaṃ vedeha ",
  "ja545:119.2": "kapi āsiṃ brahāvane, ",
  "ja545:119.3": "nilicchita phaloyeva ",
  "ja545:119.4": "yūthapena pagabbhinā. ",
  "ja545:119.5": "tassa kammassa nissando ",
  "ja545:119.6": "paradāragamanassa me. ",
  "ja545:120.1": "tato cutāhaṃ vedeha ",
  "ja545:120.2": "dasaṇṇesu, pasū ahuṃ, ",
  "ja545:120.3": "nillacchito jave bhadro ",
  "ja545:120.4": "yoggahaṃ vūḷhaṃ ciraṃ mayā; ",
  "ja545:120.5": "tassa kammassa nissando ",
  "ja545:120.6": "paradāragamanassa me. ",
  "ja545:121.1": "tato cutāhaṃ vedeha ",
  "ja545:121.2": "vajjīsu kulamāgamā, ",
  "ja545:121.3": "nevitthi na pumā āsiṃ ",
  "ja545:121.4": "manussatte sudullabhe, ",
  "ja545:121.5": "tassa kammassa nissando ",
  "ja545:121.6": "paradāragamanassa me. ",
  "ja545:122.1": "tato cutāhaṃ vedeha ",
  "ja545:122.2": "ajāyiṃ nandane vane, ",
  "ja545:122.3": "bhavane tāvatiṃsāhaṃ ",
  "ja545:122.4": "accharā kāmavaṇṇinī. ",
  "ja545:123.1": "vicittavatthābharaṇā ",
  "ja545:123.2": "āvuttamaṇikuṇḍalā, ",
  "ja545:123.3": "kusalā naccagītassa ",
  "ja545:123.4": "sakkassa paricārikā. ",
  "ja545:124.1": "tattha ṭhitāhaṃ vedeha ",
  "ja545:124.2": "sarāmi jātiyo imā, ",
  "ja545:124.3": "anāgatepi satteva ",
  "ja545:124.4": "yā gamissaṃ ito cutā. ",
  "ja545:125.1": "pariyāgatantaṃ kusalaṃ ",
  "ja545:125.2": "yaṃ me kosambiyaṃ kataṃ, ",
  "ja545:125.3": "deve ceva manusse ca ",
  "ja545:125.4": "sandhāvissaṃ ito cutā. ",
  "ja545:126.1": "satta jacco mahārāja ",
  "ja545:126.2": "niccaṃ sakkatapūjitā, ",
  "ja545:126.3": "thibhāvāpi na muccissaṃ ",
  "ja545:126.4": "chaṭṭhāni gatiyo imā. ",
  "ja545:127.1": "sattamī ca gatī deva ",
  "ja545:127.2": "devaputto mahiddhiko, ",
  "ja545:127.3": "pumā devo bhavissāmi ",
  "ja545:127.4": "devakāyasamimuttamo. ",
  "ja545:128.1": "ajjāpi santānamayaṃ ",
  "ja545:128.2": "mālaṃ ganthenti nandane, ",
  "ja545:128.3": "devaputto javo nāma ",
  "ja545:128.4": "yo me mālaṃ paṭicchati. ",
  "ja545:129.1": "muhutto viya so dibbo ",
  "ja545:129.2": "imāni vassāni soḷasa, ",
  "ja545:129.3": "rattindivo ca so dibbo ",
  "ja545:129.4": "mānusiṃ saradosataṃ. ",
  "ja545:130.1": "iti kammāni anventi ",
  "ja545:130.2": "asaṅkheyyāpi jātiyo, ",
  "ja545:130.3": "kalyāṇaṃ yadi vā pāpaṃ ",
  "ja545:130.4": "nahi kammaṃ panassati. ",
  "ja545:131.1": "yo icche puriso hotuṃ ",
  "ja545:131.2": "jātijātiṃ punappunaṃ, ",
  "ja545:131.3": "paradāraṃ vivajjayye ",
  "ja545:131.4": "dhotapādova kaddamaṃ. ",
  "ja545:132.1": "yā icche puriso hotuṃ ",
  "ja545:132.2": "jātijātiṃ punappunaṃ, ",
  "ja545:132.3": "sāmikaṃ apacāyeyya ",
  "ja545:132.4": "indaṃva paricārikā. ",
  "ja545:133.1": "yo icche dibbabhogañca dibbaṃ ",
  "ja545:133.2": "āyuṃ yasaṃ sukhaṃ, ",
  "ja545:133.3": "pāpāni parivajjetvā ",
  "ja545:133.4": "tividhaṃ dhammamācare. ",
  "ja545:134.1": "kāyena vācā manasā ",
  "ja545:134.2": "appamatto vicakkhaṇo, ",
  "ja545:134.3": "attano hoti atthāya ",
  "ja545:134.4": "itthi vā yadi vā pumā. ",
  "ja545:135.1": "ye kecime manujā jīvaloke ",
  "ja545:135.2": "yasassino sabbasamantabhogā, ",
  "ja545:135.3": "asaṃsayaṃ tehi pure suciṇṇaṃ, ",
  "ja545:135.4": "kammassakāse puthu pabbasattā. ",
  "ja545:136.1": "iṅghānucintesi sayampi deva ",
  "ja545:136.2": "kuto nidānā te imā janinda, ",
  "ja545:136.3": "yā te imā accharāsannikāsā ",
  "ja545:136.4": "alaṅkatā kañcanajālachannā. ",
  "ja545:137.1": "iccevaṃ pitaraṃ kaññā ",
  "ja545:137.2": "rujā tosesi aṅgatiṃ, ",
  "ja545:137.3": "mūḷhassa maggamācikkhi ",
  "ja545:137.4": "dhammamakkhāsi subbatā. ",
  "ja545:138.1": "athāgamā brahmalokā ",
  "ja545:138.2": "nārado mānusiṃ pajaṃ, ",
  "ja545:138.3": "jambudīpaṃ avekkhanto ",
  "ja545:138.4": "addā rājānamaṅgatiṃ. ",
  "ja545:139.1": "tato patiṭṭhā pāsāde ",
  "ja545:139.2": "vedehassa puratthato, ",
  "ja545:139.3": "tañca disvā anuppattaṃ ",
  "ja545:139.4": "rujā isimavandatha. ",
  "ja545:140.1": "athāsanambhā oruyha ",
  "ja545:140.2": "rājā vyambhitamānaso, ",
  "ja545:140.3": "nāradaṃ paripucchanto ",
  "ja545:140.4": "idaṃ vacanamabravi. ",
  "ja545:141.1": "kuto nu āgacchasi devavaṇṇi ",
  "ja545:141.2": "obhāsayaṃ saṃvaraṃ candimāva, ",
  "ja545:141.3": "akkhāhi me pucchito nāmagottaṃ. ",
  "ja545:141.4": "kathaṃ taṃ jānanti manussaloke. ",
  "ja545:142.1": "ahaṃ hi devato idāni emi ",
  "ja545:142.2": "obhāsayaṃ saṃvaraṃ candimāva, ",
  "ja545:142.3": "akkhāmi te pucchito nāmagottaṃ ",
  "ja545:142.4": "jānanti maṃ nārado kassapo ca. ",
  "ja545:143.1": "acchariyarūpaṃ vata yādisañca ",
  "ja545:143.2": "vehāsayaṃ gacchasi tiṭṭhasī ca, ",
  "ja545:143.3": "pucchāmi taṃ nārada etamatthaṃ ",
  "ja545:143.4": "atha kena vaṇṇena tavāyamiddhi. ",
  "ja545:144.1": "saccañca dhammo ca damo ca cāgo ",
  "ja545:144.2": "guṇā mamete pakatā purāṇā, ",
  "ja545:144.3": "teheva dhammehi susevitehi ",
  "ja545:144.4": "manojavo yenakāmaṃ gamosmi. acachariya ",
  "ja545:145.1": "mācikkhasi puññasiddhiṃ ",
  "ja545:145.2": "sace hi ete tvaṃ yathā vadesi, ",
  "ja545:145.3": "pucchāmi taṃ nārada etamatthaṃ ",
  "ja545:145.4": "puṭṭho ca me sādhu viyākarohi. ",
  "ja545:146.1": "pucchassu maṃ rāja tavesa attho ",
  "ja545:146.2": "yaṃ saṃsayaṃ kuruse bhūmipāla, ",
  "ja545:146.3": "ahaṃ taṃ nissaṃsayataṃ gamemi. ",
  "ja545:146.4": "nayehi ñāyehi ca hetubhī ca. ",
  "ja545:147.1": "pucchāmi taṃ nārada etamatthaṃ ",
  "ja545:147.2": "puṭṭho ca me nārada mā musā bhaṇa, ",
  "ja545:147.3": "atthi nu devā pitaro nu atthi ",
  "ja545:147.4": "loko paro atthi jano yamāhu. ",
  "ja545:148.1": "attheva devā pitaro ca atthi ",
  "ja545:148.2": "loko paro atthi jano yamāhu, ",
  "ja545:148.3": "kāmesu giddhā ca narā pamūḷhā ",
  "ja545:148.4": "lokaṃ paraṃ na vidū mohayuttā. ",
  "ja545:149.1": "atthiti ce nārada saddahāsi ",
  "ja545:149.2": "nivesanaṃ paraloke matānaṃ, ",
  "ja545:149.3": "idheva me pañcasatāni dehi ",
  "ja545:149.4": "dassāmi te paraloke sahassaṃ. ",
  "ja545:150.1": "dajjemu kho pañcasatāni bhoto ",
  "ja545:150.2": "jaññāmu ce sīlavantaṃ vadaññuṃ, ",
  "ja545:150.3": "luddaṃ taṃ bhontaṃ niraye vasantaṃ ",
  "ja545:150.4": "ko codaye paraloke sahassaṃ. ",
  "ja545:151.1": "idheva yo hoti adhammasīlo ",
  "ja545:151.2": "pāpācāro alaso luddakammo, ",
  "ja545:151.3": "na paṇḍitā tasmiṃ iṇaṃ dadanti ",
  "ja545:151.4": "nahi āgamo hoti tathāvidhambhā. ",
  "ja545:152.1": "dakkhañca posaṃ manujā viditvā ",
  "ja545:152.2": "uṭṭhāhakaṃ sīlavantaṃ vadaññuṃ, ",
  "ja545:152.3": "sayameva bhogehi nimantayanti ",
  "ja545:152.4": "kammaṃ karitvā punamāharesi. ",
  "ja545:153.1": "ito gato dakkhasi tattha rāja ",
  "ja545:153.2": "kākolasaṅghehipi kaḍḍhamānaṃ, ",
  "ja545:153.3": "taṃ khajjamānaṃ niraye vasantaṃ ",
  "ja545:153.4": "kākehi gijjhehi ca seṇakehi ",
  "ja545:153.5": "sañchinnagattaṃ ruhiraṃ savantaṃ ",
  "ja545:153.6": "ko codaye paraloke sahassaṃ. ",
  "ja545:154.1": "andhaṃtamaṃ tattha na candasuriyā ",
  "ja545:154.2": "nirayo sadā tumulo ghorarūpo. ",
  "ja545:154.3": "sā neva ratti na divā paññāyati ",
  "ja545:154.4": "tathāvidhe ko vicare dhanatthiko. ",
  "ja545:155.1": "sabalo ca sāmo ca duve supāṇā ",
  "ja545:155.2": "pavaddhakāyā balino mahantā, ",
  "ja545:155.3": "khādanti dantehi ayomayehi ",
  "ja545:155.4": "ito panuṇṇaṃ paralokapattaṃ. ",
  "ja545:156.1": "taṃ khajjamānaṃ niraye vasantaṃ ",
  "ja545:156.2": "luddehi vāḷehi aghammigehi ca, ",
  "ja545:156.3": "saṃchinnagattaṃ ruhiraṃ savantaṃ ",
  "ja545:156.4": "ko codaye paraloke sahassaṃ. ",
  "ja545:157.1": "usūhi sattīhi sunissitāhi ",
  "ja545:157.2": "hananti vijjhanti ca paccamittā ",
  "ja545:157.3": "kāḷupakāḷā nirayamhi ghore ",
  "ja545:157.4": "pubbe naraṃ dukkatakammakāriṃ. ",
  "ja545:158.1": "taṃ haññamānaṃ niraye vajantaṃ ",
  "ja545:158.2": "kucchismiṃ passasmiṃ viphālitūdaraṃ, ",
  "ja545:158.3": "saṃchinnagattaṃ ruhiraṃ savantaṃ ",
  "ja545:158.4": "ko codeye paraloke sahassaṃ. ",
  "ja545:159.1": "sattī usū tomarabheṇḍivālā ",
  "ja545:159.2": "vividhāvudhaṃ vassati tattha devo, ",
  "ja545:159.3": "patanti aṅgāramivacavimanto ",
  "ja545:159.4": "silāsanī vassati luddakamme. ",
  "ja545:160.1": "uṇho ca vāto nirayamhi dussaho ",
  "ja545:160.2": "na tahiṃ sukhaṃ labbhati ittarampi, ",
  "ja545:160.3": "taṃ taṃ vidhāvantamalenamāturaṃ ",
  "ja545:160.4": "ko codaye paraloke sahassaṃ. ",
  "ja545:161.1": "sandhāvamānaṃ taṃ rathesu yuttaṃ ",
  "ja545:161.2": "sajotibhūtaṃ paṭhaviṃ kamantaṃ, ",
  "ja545:161.3": "patodalaṭṭhihi sucodiyantaṃ ",
  "ja545:161.4": "ko codaye paraloke sahassaṃ. ",
  "ja545:162.1": "tamāruhantaṃ khurasañcitaṃ giriṃ ",
  "ja545:162.2": "vibhiṃsanaṃ pajjalitaṃ bhayānakaṃ, ",
  "ja545:162.3": "sañachinnagattaṃ ruhiraṃ savantaṃ ",
  "ja545:162.4": "ko codaye paraloke sahassaṃ. ",
  "ja545:163.1": "tamāruhantaṃ pabbatasantikāsaṃ ",
  "ja545:163.2": "aṅgārarāsiṃ jalitaṃ bhayānakaṃ, ",
  "ja545:163.3": "saṃdaḍḍhagattaṃ kapaṇaṃ rudantaṃ ",
  "ja545:163.4": "ko codaye paraloke sahassaṃ. ",
  "ja545:164.1": "abbhakūṭasamā uccā ",
  "ja545:164.2": "kaṇṭakāpacitā dumā, ",
  "ja545:164.3": "ayomayehi tikkhehi ",
  "ja545:164.4": "naralohitapāyihi. ",
  "ja545:165.1": "tamāruhanti nāriyo ",
  "ja545:165.2": "narā ca paradāragu, ",
  "ja545:165.3": "coditāsanti hatthehi ",
  "ja545:165.4": "yamaniddesakārihi. ",
  "ja545:166.1": "tamāruhantaṃ nirayaṃ ",
  "ja545:166.2": "simbaliṃ ruhiramakkhitaṃ, ",
  "ja545:166.3": "vidaḍḍhakāyaṃ vitavaṃ ",
  "ja545:166.4": "āturaṃ gāḷhavedanaṃ. ",
  "ja545:167.1": "passasantaṃ muhuṃ uṇhaṃ ",
  "ja545:167.2": "pubbakammāparādhikaṃ, ",
  "ja545:167.3": "dumaggaviṭapaggahataṃ ",
  "ja545:167.4": "ko taṃ yāceyya taṃ dhanaṃ. ",
  "ja545:168.1": "abbhakūṭasamā uccā ",
  "ja545:168.2": "asipattācitā dumā, ",
  "ja545:168.3": "ayomayehi tikkhehi ",
  "ja545:168.4": "naralohitapāyihi. ",
  "ja545:169.1": "tamānupattaṃ asipattapādapaṃ ",
  "ja545:169.2": "asīhi tikkhehi ca chijjamānaṃ, ",
  "ja545:169.3": "saṃchinnagattaṃ ruhiraṃ savantaṃ ",
  "ja545:169.4": "ko codaye paraloke sahassaṃ. ",
  "ja545:170.1": "tato nikkhantamattaṃ taṃ ",
  "ja545:170.2": "asipattanirayā dukhā, ",
  "ja545:170.3": "sampatitaṃ vetaraṇiṃ ",
  "ja545:170.4": "ko taṃ yāceyya taṃ dhanaṃ. ",
  "ja545:171.1": "kharā khārodikā nattā ",
  "ja545:171.2": "duggā vetaraṇī nadī, ",
  "ja545:171.3": "ayopokkharasañachannā ",
  "ja545:171.4": "tikkhapattetahi sandati. ",
  "ja545:172.1": "tattha sañachinnagattaṃ taṃ ",
  "ja545:172.2": "vuyhantaṃ ruhiramakkhitaṃ, ",
  "ja545:172.3": "vetaraññe anālambe ",
  "ja545:172.4": "ko taṃ yāceyya taṃ dhanaṃ. ",
  "ja545:173.1": "vedhāmi rukkho viya chijjamāno ",
  "ja545:173.2": "disaṃ na jānāmi pamūḷhasaññi, ",
  "ja545:173.3": "bhayasānutappāmi mahā ca me bhayaṃ ",
  "ja545:173.4": "sutthāna gāthā tava bhāsitā ise. ",
  "ja545:174.1": "āditte vārimajjhaṃva ",
  "ja545:174.2": "dīpaṃvogherivaṇṇave, ",
  "ja545:174.3": "andhakāreva pajjoto ",
  "ja545:174.4": "tvaṃ nosi saraṇaṃ ise. ",
  "ja545:175.1": "atthañca dhammañcanusāsa maṃ ise ",
  "ja545:175.2": "atītamaddhā aparādhitaṃ mayā, ",
  "ja545:175.3": "ācikkha me nārada suddhimaggaṃ ",
  "ja545:175.4": "yathā ahaṃ no niraye pateyyaṃ. ",
  "ja545:176.1": "yathā ahū dhataraṭṭho ",
  "ja545:176.2": "vessāmitto aṭṭhako yāmataggi ",
  "ja545:176.3": "usinnaro cāpi sivī ca rājā ",
  "ja545:176.4": "paricārakā samaṇabrāhmaṇānaṃ. ",
  "ja545:177.1": "ete caññe ca rājāno ",
  "ja545:177.2": "ye sakkavisayaṃ gatā, ",
  "ja545:177.3": "adhammaṃ parivajjetvā ",
  "ja545:177.4": "dhammaṃ cara mahīpati. ",
  "ja545:178.1": "annahatthā ca te vyamhe ",
  "ja545:178.2": "ghosayantu pure tava, ",
  "ja545:178.3": "ko chāto ko ca tasito ",
  "ja545:178.4": "ko mālaṃ ko vilepanaṃ, ",
  "ja545:178.5": "nānārattānaṃ vatthānaṃ ",
  "ja545:178.6": "ko naggo paridahessati. ",
  "ja545:179.1": "ko panthe chattamādeti ",
  "ja545:179.2": "pādukā ca mudu subhā, ",
  "ja545:179.3": "iti sāyañca pāto ca ",
  "ja545:179.4": "ghosayantu pure tava. ",
  "ja545:180.1": "jiṇṇaṃ posaṃ gavāssañca ",
  "ja545:180.2": "māssu yuñji yathā pure, ",
  "ja545:180.3": "parihārañca dajjāsi ",
  "ja545:180.4": "adhikārakato khali. ",
  "ja545:181.1": "kāyo te rathasaññāto ",
  "ja545:181.2": "manosārathiko lahu, ",
  "ja545:181.3": "avihiṃsāsāritakkho ",
  "ja545:181.4": "saṃvibhāgapaṭicchado. ",
  "ja545:182.1": "pādasaññamanemiyo ",
  "ja545:182.2": "hatthasaññamapakkharo, ",
  "ja545:182.3": "kucchisaññamanabbhanto ",
  "ja545:182.4": "vācāsaññamakūjano. ",
  "ja545:183.1": "saccavākyasamattaṅgo ",
  "ja545:183.2": "apesuññasusaññato, ",
  "ja545:183.3": "girāsakhilanelaṅgo ",
  "ja545:183.4": "mitabhāṇisilesito. ",
  "ja545:184.1": "saddhālohasusaṅkhāro ",
  "ja545:184.2": "nivātañjalikubbaro, ",
  "ja545:184.3": "atthaddhatānatīsākho ",
  "ja545:184.4": "sīlasaṃvaranandhano. ",
  "ja545:185.1": "akkodhanamanugghātī ",
  "ja545:185.2": "dhammapaṇḍarachattako, ",
  "ja545:185.3": "bāhusaccamapālambo ",
  "ja545:185.4": "ṭhitacittamupādhiyo. ",
  "ja545:186.1": "kālaññutāvittasāro ",
  "ja545:186.2": "vesārajjatidaṇḍako, ",
  "ja545:186.3": "nivātavutti yottako ",
  "ja545:186.4": "anatimānayugo lahu. ",
  "ja545:187.1": "alīnacittasanthāro ",
  "ja545:187.2": "vaddhasevirajohato, ",
  "ja545:187.3": "satipatodo dhīrassa ",
  "ja545:187.4": "dhiti yogo ca rasmiyo. ",
  "ja545:188.1": "mano dantapathatveti ",
  "ja545:188.2": "samadantehi vāhibhī, ",
  "ja545:188.3": "icchā lobho ca kummaggo ",
  "ja545:188.4": "ujumaggo ca saññamo. ",
  "ja545:189.1": "rūpe sadde rase gandhe ",
  "ja545:189.2": "vāhanassa padhāvato, ",
  "ja545:189.3": "paññā ākoṭanī rāja ",
  "ja545:189.4": "tathe attāva sārathi. ",
  "ja545:190.1": "sace etena yānena ",
  "ja545:190.2": "samacariyā daḷhā dhitī, ",
  "ja545:190.3": "sabbakāmaduho rāja ",
  "ja545:190.4": "na jātu nirayaṃ vaje. ",
  "ja545:191.1": "alāto devadattosi ",
  "ja545:191.2": "sunāmo āsi bhaddajī, ",
  "ja545:191.3": "vijayo sāriputtosi ",
  "ja545:191.4": "moggallānosi bījako. ",
  "ja545:192.1": "sunakakhanto licchavīputto ",
  "ja545:192.2": "guṇo āsi acelako, ",
  "ja545:192.3": "ānando ca rujā āsi ",
  "ja545:192.4": "yā rājānaṃ pasādayi. ",
  "ja545:193.1": "uruvelakassapo rājā ",
  "ja545:193.2": "pāpadiṭṭhi tadā ahu, ",
  "ja545:193.3": "mahābrahmā bodhisatto ",
  "ja545:193.4": "evaṃ dhāretha jātakanti. ",
  "ja545:194.1": "mahānāradakassapajātakaṃ sattamaṃ. "
}
