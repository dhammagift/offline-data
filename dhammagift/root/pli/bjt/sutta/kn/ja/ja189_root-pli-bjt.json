  "ja189:0.4": "8. sīhakotthukajātakaṃ. ",
  "ja189:1.1": "netaṃ sīhassa naditaṃ ",
  "ja189:1.2": "na vyagghassa na dīpino, ",
  "ja189:1.3": "pāruto sīhacammena ",
  "ja189:1.4": "jammo nadati gadrabho. ",
  "ja189:2.1": "cirampi kho taṃ khādeyya ",
  "ja189:2.2": "gadrabho haritaṃ yavaṃ, ",
  "ja189:2.3": "pāruto sīhacammena ",
  "ja189:2.4": "ravamānova dūsayī’ti. ",
  "ja189:3.1": ""
}
