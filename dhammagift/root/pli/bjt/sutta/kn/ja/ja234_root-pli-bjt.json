  "ja234:0.4": "3. vikaṇṇakajātakaṃ ",
  "ja234:1.1": "tvameva dāni makara ",
  "ja234:1.2": "yaṃ kāmo vyagamā tayi, ",
  "ja234:1.3": "soyaṃ appaṭisandhiko ",
  "ja234:1.4": "kharāchinnaṃva rerukaṃ. ",
  "ja234:2.1": "atricchā atilobhena ",
  "ja234:2.2": "atilohamadena ca, ",
  "ja234:2.3": "evaṃ hāyati atthamhā ",
  "ja234:2.4": "ahaṃva asitābhūyā’ti. ",
  "ja234:3.1": ""
}
