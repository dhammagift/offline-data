  "ja298:0.4": "",
  "ja298:1.1": "udumbarā cime pakkā ",
  "ja298:1.2": "nigrodhā ca kapitthanā, ",
  "ja298:1.3": "ehi nikkhama bhuñjassu ",
  "ja298:1.4": "kiṃ jighacchāya mīyasi. ",
  "ja298:2.1": "evaṃ so suhito hoti ",
  "ja298:2.2": "yo vaddamapacāyati, ",
  "ja298:2.3": "yathāhamajja suhito ",
  "ja298:2.4": "dūmapakkānimāsito. ",
  "ja298:3.1": "yaṃ vanejo vanejassa ",
  "ja298:3.2": "vañceyya kapino kapi, ",
  "ja298:3.3": "daharopi taṃ na saddheyya ",
  "ja298:3.4": "na hi jiṇṇo jarākapi’ti. ",
  "ja298:4.1": "8. udumbarajātakaṃ. "
}
