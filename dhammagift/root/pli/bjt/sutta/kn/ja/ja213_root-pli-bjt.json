  "ja213:1.1": "isīnamantaraṃ katvā ",
  "ja213:1.2": "bharurājāti me sutaṃ, ",
  "ja213:1.3": "ucchinno saha raṭṭhena sa ",
  "ja213:1.4": "rājā vibhavaṃ gato ",
  "ja213:2.1": "tasmā hi chandā gamanaṃ ",
  "ja213:2.2": "nappasaṃsanti paṇḍitā, ",
  "ja213:2.3": "aduṭṭhacitto bhāseyya ",
  "ja213:2.4": "giraṃ saccūpasaṃhitanti. ",
  "ja213:3.1": "3. bharujātakaṃ. "
}
