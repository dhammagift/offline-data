  "ja182:0.4": "",
  "ja182:1.1": "saṅgāmāvacaro sūro ",
  "ja182:1.2": "balavā iti vissuto, ",
  "ja182:1.3": "kinnu toraṇamāsajja ",
  "ja182:1.4": "paṭikkamasi tuñjara. ",
  "ja182:2.1": "omadda khippaṃ paḷighaṃ ",
  "ja182:2.2": "phasikāni ca abba, ",
  "ja182:2.3": "toraṇāni pamadditvā ",
  "ja182:2.4": "khippaṃ pavisa kuñjarāti. ",
  "ja182:3.1": "saṅgāmāvacarajātakaṃ. "
}
