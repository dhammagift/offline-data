  "ja471:0.3": "",
  "ja471:0.4": "7. kosiyajātakaṃ. ",
  "ja471:1.1": "yesaṃ na kadāci bhūtapubbaṃ ",
  "ja471:1.2": "sakkhiṃ sattapadampi imasmiṃ loke, ",
  "ja471:1.3": "jātā amittā duve sahāyā ",
  "ja471:1.4": "paṭisandhāya caranti kissa hetu. ",
  "ja471:2.1": "yadi me ajja pātarāsakāle ",
  "ja471:2.2": "paṇhaṃ na sakkuṇeyyātha vattumetaṃ, ",
  "ja471:2.3": "raṭṭhā pabbājayissāmi vo sabbe ",
  "ja471:2.4": "nahi mattho duppaññajātikehi. ",
  "ja471:3.1": "mahājanasamāgamambhi ghore ",
  "ja471:3.2": "janakolāhalasaṅgamamhi jāte ",
  "ja471:3.3": "vikkhittamanā anekavacittā ",
  "ja471:3.4": "pañhaṃ na sakkuṇoma vattumetaṃ. ",
  "ja471:4.1": "ekaggacittā ca ekamekā ",
  "ja471:4.2": "rahasigatā atthaṃ nicintayitvā, ",
  "ja471:4.3": "paviveke sammasitvāna dhīrā ",
  "ja471:4.4": "atha vakkhanti janinda atthametaṃ. ",
  "ja471:5.1": "uggaputtarājaputtiyānaṃ ",
  "ja471:5.2": "urabbhamaṃsaṃ piyaṃ manāpaṃ, ",
  "ja471:5.3": "na te sunakhassa adenti maṃsaṃ ",
  "ja471:5.4": "atha meṇḍassa suṇena sakhyamassa. ",
  "ja471:6.1": "cammaṃ vihananti eḷakassa ",
  "ja471:6.2": "assapiṭṭhattharaṇasukhassa hetu, ",
  "ja471:6.3": "naca te sunakhassa attharanti ",
  "ja471:6.4": "atha meṇḍassa suṇena sakhyamassa. ",
  "ja471:7.1": "āvellitasiṅgiko hi meṇḍo ",
  "ja471:7.2": "na ca sunakhassa visāṇāni atthi, ",
  "ja471:7.3": "tiṇabhakkho maṃsabhojano ca ",
  "ja471:7.4": "atha meṇḍassa suṇena sakhyamassa. ",
  "ja471:8.1": "tiṇamāsī palāsamāsī meṇḍo ",
  "ja471:8.2": "na ca sunakho tiṇamāsī no palāsaṃ, ",
  "ja471:8.3": "gaṇheyya suṇo sasaṃ biḷāraṃ ",
  "ja471:8.4": "atha meṇḍassa suṇena sakhyamassa. ",
  "ja471:9.1": "aḍḍhaṭṭhapādo catuppadassa ",
  "ja471:9.2": "meṇḍo aṭṭhanakho adissamāno, ",
  "ja471:9.3": "chādiyamāharati ayaṃ imassa ",
  "ja471:9.4": "maṃsaṃ āharati ayaṃ amussa. ",
  "ja471:10.1": "pāsādagato videhaseṭṭho ",
  "ja471:10.2": "vītihāraṃ aññamaññabhojanānaṃ, ",
  "ja471:10.3": "addakkhi kira sakkhi taṃ janindo ",
  "ja471:10.4": "khobhukkhassa ca puṇṇamukhassa cetaṃ. ",
  "ja471:11.1": "lābhā vata me anapparūpā ",
  "ja471:11.2": "yassa medisā paṇḍitā kulambhi, ",
  "ja471:11.3": "pañcassa gambhīragataṃ nipuṇamatthaṃ ",
  "ja471:11.4": "paṭivijjhanti subhāsitena dhīrā. ",
  "ja471:12.1": "assatarīrathañca ekamekaṃ ",
  "ja471:12.2": "phītaṃ gāmavarañca ekamekaṃ, ",
  "ja471:12.3": "sabbesaṃ vo dammi paṇḍitānaṃ. ",
  "ja471:12.4": "paramapatītamano subhāsitenā’ti. ",
  "ja471:13.1": ""
}
