  "ja14:1.1": "kaṇḍinajātakaṃ. na kiratthi rasehi pāpiyo ",
  "ja14:1.2": "āvasehi vā santhavehi vā, ",
  "ja14:1.3": "vātamigaṃ gehanissitaṃ ",
  "ja14:1.4": "vasamānesi rasehi sañjayoti. ",
  "ja14:2.1": "vātamigajātakaṃ. "
}
