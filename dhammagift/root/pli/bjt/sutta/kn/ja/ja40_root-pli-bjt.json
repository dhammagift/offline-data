  "ja40:0.4": "",
  "ja40:1.1": "kāmaṃ patāmi nirayaṃ ",
  "ja40:1.2": "uddhapādo avaṃsiro, ",
  "ja40:1.3": "nānariyaṃ karissāmi ",
  "ja40:1.4": "handa piṇḍaṃ paṭiggahā’ti. ",
  "ja40:2.1": "khadiraṅgārajātakaṃ. ",
  "ja40:2.2": "kulāvakavaggo catuttho. ",
  "ja40:3.1": "tassuddānaṃ: ",
  "ja40:4.1": "sirimātalidhītarapakkhivaro ",
  "ja40:4.2": "ratirāgatomātāpitā ca puna, ",
  "ja40:4.3": "jagatīruhavuddhasukakkaṭako ",
  "ja40:4.4": "tathā nandakapiṇḍavarena dasa. "
}
