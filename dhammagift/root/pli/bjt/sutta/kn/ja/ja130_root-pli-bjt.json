  "ja130:0.1": "",
  "ja130:0.2": "",
  "ja130:0.3": "",
  "ja130:0.4": "9. aggikajātakaṃ. ",
  "ja130:1.1": "yathā vācā ca bhuñjassu ",
  "ja130:1.2": "yathābhuttañca vyāhara, ",
  "ja130:1.3": "ubhayaṃ te na sameti ",
  "ja130:1.4": "vācābhuttañca kosiyeti. ",
  "ja130:2.1": "",
  "ja130:2.2": "10. kosiyajātakaṃ. kusanāḷivaggo terasamo. ",
  "ja130:3.1": "tassuddānaṃ: ",
  "ja130:4.1": "kusanāḷisirivahayano ca yasaṃ ",
  "ja130:4.2": "dadhimambakaṭāhakapañcamako, ",
  "ja130:4.3": "atha pāpaka khīrabiḷāravataṃ sikhikosiyasavbhayanena ",
  "ja130:4.4": "dasa. "
}
