  "ja185:1.1": "yathodake āvile appasanne ",
  "ja185:1.2": "na pasasti ",
  "ja185:1.3": "sippisambukaṃ macchagumbaṃ ",
  "ja185:1.4": "evaṃ āvile hi citte ",
  "ja185:1.5": "na passati attadatthaṃ paratthaṃ. ",
  "ja185:2.1": "yathodake acche vippasanne ",
  "ja185:2.2": "so passati sippisambukaṃ ",
  "ja185:2.3": "macchagumbaṃ ",
  "ja185:2.4": "evaṃ anāvile hi citte ",
  "ja185:2.5": "so passati attadatthaṃ paratthanti. ",
  "ja185:3.1": "anabhiratijātakaṃ. "
}
