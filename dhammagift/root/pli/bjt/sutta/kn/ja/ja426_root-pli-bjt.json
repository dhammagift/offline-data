  "ja426:0.3": "",
  "ja426:0.4": "",
  "ja426:1.1": "khamanīyaṃ yāpanīyaṃ ",
  "ja426:1.2": "kacci mātula te sukhaṃ, ",
  "ja426:1.3": "sukhaṃ te ammā avaca ",
  "ja426:1.4": "sukhakāmā hi te mayaṃ. ",
  "ja426:2.1": "naṅguṭṭhaṃ me avakkamma ",
  "ja426:2.2": "heṭhayitvāna eḷike, ",
  "ja426:2.3": "sājja mātulavādena ",
  "ja426:2.4": "muñcitabbā nu maññasi. ",
  "ja426:3.1": "puratthāmukho nisinnosi ",
  "ja426:3.2": "ahaṃ taṃ mukhamāgatā, ",
  "ja426:3.3": "pacchito tuyha naṅguṭṭhaṃ ",
  "ja426:3.4": "kathaṃ khohaṃ avakkamiṃ. ",
  "ja426:4.1": "yāvatā caturo dīpā ",
  "ja426:4.2": "sasamuddā sapabbatā, ",
  "ja426:4.3": "tāvatā mayha naṅguṭṭhaṃ ",
  "ja426:4.4": "kathaṃ kho tvaṃ vivajjayi. ",
  "ja426:5.1": "pubbevametaṃ akkhaṃsu ",
  "ja426:5.2": "mātāpitā ca bhātaro, ",
  "ja426:5.3": "dīghaṃ duṭṭhassa naṅguṭṭhaṃ ",
  "ja426:5.4": "samhi vehāsayāgatā. ",
  "ja426:6.1": "tañca disvāna āyantiṃ ",
  "ja426:6.2": "antalikkhasmiṃ phaḷike, ",
  "ja426:6.3": "migasaṅgho palāyittha ",
  "ja426:6.4": "bhakkho me nāsito tayā. ",
  "ja426:7.1": "icceva vilapantiyā ",
  "ja426:7.2": "eḷikiyā ruhaṃghaso, ",
  "ja426:7.3": "galakaṃ anvāvamaddi ",
  "ja426:7.4": "natthi duṭṭhe subhāsitaṃ. ",
  "ja426:8.1": "neva duṭṭhe nayo atthi ",
  "ja426:8.2": "na dhammo na subhāsitaṃ, ",
  "ja426:8.3": "nikkamaṃ duṭṭhe yujjetha ",
  "ja426:8.4": "so ca sabbhi na rajjatīti. ",
  "ja426:9.1": "dīpijātakaṃ. kaccānivaggo ",
  "ja426:10.1": "paṭhamo. ",
  "ja426:11.1": "tassuddānaṃ: ",
  "ja426:12.1": "parisuddhāmanāvilāvatthadharā ",
  "ja426:12.2": "bakarājassa kāyuraṃ daṇṭhāvaro, athaaṅgāracetiyadevilina ",
  "ja426:12.3": "atha ādittagaṅkādaseḷakināti. aṭṭhakanipātaṃ ",
  "ja426:12.4": "niṭṭhitaṃ. "
}
