  "ja191:0.1": "",
  "ja191:0.2": "",
  "ja191:0.3": "5. ruhakavaggo ",
  "ja191:0.4": "",
  "ja191:1.1": "ambho ruhaka chinnāpi ",
  "ja191:1.2": "jiyā sandhīyate puna, ",
  "ja191:1.3": "sandhīyassu purāṇiyā ",
  "ja191:1.4": "mā kodhassa vasaṃ gami. vijjamānāsu maruvāsu ",
  "ja191:2.1": "vijjamānesu kārusu, ",
  "ja191:2.2": "",
  "ja191:2.3": "aññaṃ jiyaṃ karissāma ",
  "ja191:2.4": "alaññeva purāṇiyā’ti. ",
  "ja191:3.1": "ruhakajātakaṃ. "
}
