  "ja324:0.3": "",
  "ja324:0.4": "3. brahmadattajātakaṃ. ",
  "ja324:1.1": "kalyāṇarūpo vatayaṃ catuppado ",
  "ja324:1.2": "subhaddako ceva supesalo ca, ",
  "ja324:1.3": "yo brāhmaṇaṃ jātimantūpapannaṃ ",
  "ja324:1.4": "apacāyati meṇḍavaro yasassi. 601 ",
  "ja324:2.1": "mā brāhmaṇa ittaradassanena ",
  "ja324:2.2": "vissāsamāpajji catuppadassa, ",
  "ja324:2.3": "daḷhappahāraṃ abhikaṅkhamāno ",
  "ja324:2.4": "apasakkati dassati suppahāraṃ. ",
  "ja324:3.1": "ūraṭṭhi bhaggaṃ patito khāribhāro ",
  "ja324:3.2": "sabbaṃ bhaṇḍaṃ brāhmaṇassīdhabhinnaṃ, ",
  "ja324:3.3": "bāhāpaggayha kandati. ",
  "ja324:3.4": "abhidhāvathā haññate brahmacārī ",
  "ja324:4.1": "evaṃ so nihato seti ",
  "ja324:4.2": "yo apūjaṃ namassati, ",
  "ja324:4.3": "yathāhamajja pahaṭo ",
  "ja324:4.4": "hato meṇḍena dummatī’ti. ",
  "ja324:5.1": ""
}
