  "ja228:0.4": "7. gūthapāṇakajātakaṃ. ",
  "ja228:1.1": "tayo giriṃ antaraṃ kāmayāmi ",
  "ja228:1.2": "pañcālā kuruyo kekake ca, ",
  "ja228:1.3": "tatuttariṃ brāhmaṇa kāmayāmi ",
  "ja228:1.4": "tikiccha maṃ brāhmaṇa kāmanītaṃ. ",
  "ja228:2.1": "kaṇhāhi daṭṭhassa karonti heke ",
  "ja228:2.2": "amanussavaddhassa karonti paṇḍitā, ",
  "ja228:2.3": "na kāmanītassa kāroti koci ",
  "ja228:2.4": "okkantasukkassa hi kā tikicchā’ti. ",
  "ja228:3.1": ""
}
