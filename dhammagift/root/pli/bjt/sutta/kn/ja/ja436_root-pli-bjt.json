  "ja436:0.4": "",
  "ja436:1.1": "kuto nu āgacchatha bho tayo janā ",
  "ja436:1.2": "svāgataṃ ettha nisīdathāsane, ",
  "ja436:1.3": "kaccittha bhonto kusalaṃ anāmayaṃ ",
  "ja436:1.4": "cirassamabbhāgamanaṃ hi vo idha ",
  "ja436:2.1": "ahameva eko idha majjhapatto ",
  "ja436:2.2": "na cāpi me dutiyo koci vijjati, ",
  "ja436:2.3": "kimeva sandhāya te bhāsitaṃ ise ",
  "ja436:2.4": "kuto nu āgacchatha bho tayo janā. ",
  "ja436:3.1": "tuvañca eko bhariyā ca te piyā ",
  "ja436:3.2": "samuggapakkhittanikiṇṇamantare, ",
  "ja436:3.3": "sā rakkhitā kucchigatāva te sadā ",
  "ja436:3.4": "vāyussa puttena sabhā tahiṃ ratā. ",
  "ja436:4.1": "saṃviggarūpo isinā viyākato ",
  "ja436:4.2": "so dānavo tattha samuggamuggili. ",
  "ja436:4.3": "addakkhi bhariyaṃ suci māladhāriniṃ ",
  "ja436:4.4": "vāyussa puttena sabhā tahiṃ rataṃ. ",
  "ja436:5.1": "sudiṭṭharūpuggatapānuvattinā. ",
  "ja436:5.2": "hīnā narā ye pamadāvasaṃgatā ",
  "ja436:5.3": "yathā have pāṇarivettha rakkhitā ",
  "ja436:5.4": "duṭṭhā mayi aññamabhippamodati. ",
  "ja436:6.1": "divā ca ratto ca mayā upaṭṭhitā ",
  "ja436:6.2": "tapassinā jotirivā vane vasaṃ, ",
  "ja436:6.3": "sā dhammamokkamma adhammamācari ",
  "ja436:6.4": "akiriyarūpo pamadāhi santhavo. ",
  "ja436:7.1": "sarīramajjhambhi ṭhitāni maññihaṃ ",
  "ja436:7.2": "mayhaṃ ayanti asatiṃ asaññataṃ, ",
  "ja436:7.3": "sā dhammamokkamma adhammamācari ",
  "ja436:7.4": "akiriyarūpo pamadāhi santhavo. ",
  "ja436:8.1": "surakkhitaṃ meti kathannu vissase ",
  "ja436:8.2": "anekacittāsu nahettha rakkhaṇā, ",
  "ja436:8.3": "etā hi pātālapapātasantibhā ",
  "ja436:8.4": "etthappamatto vyasanaṃ nigacchati. ",
  "ja436:9.1": "tasmā hi te sukhino vītasokā ",
  "ja436:9.2": "ye mātugāmehi caranti nissaṭā, ",
  "ja436:9.3": "etaṃ sivaṃ uttama mābhipatthayaṃ ",
  "ja436:9.4": "na mātugāmehi kareyya santhavanti. ",
  "ja436:10.1": "samuggajātakaṃ. "
}
