  "ja272:1.1": "yena mittena saṃsaggā ",
  "ja272:1.2": "yoyagakkhemo vihiṃsati, ",
  "ja272:1.3": "pubbevajjhāhavantassa rakkhe ",
  "ja272:1.4": "akkhīva paṇḍito, ",
  "ja272:2.1": "yena mittena saṃsaggā ",
  "ja272:2.2": "yogakkhemo pavaḍḍhati, ",
  "ja272:2.3": "kareyyattasamaṃ vuttiṃ ",
  "ja272:2.4": "sabbakiccesu paṇḍito. ",
  "ja272:3.1": "etha vyagghā nivattavho ",
  "ja272:3.2": "paccametha mahāvanaṃ, ",
  "ja272:3.3": "mā vanaṃ chindi nivyagghaṃ ",
  "ja272:3.4": "vyagghā māhesu nibbanā’ti. ",
  "ja272:4.1": ""
}
