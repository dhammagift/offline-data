  "ja158:0.4": "7. guṇajātakaṃ. ",
  "ja158:1.1": "na idaṃ visamasīlena ",
  "ja158:1.2": "soṇena suhanussaha, ",
  "ja158:1.3": "suhanūpi tādisoyeva ",
  "ja158:1.4": "yo soṇassa sa gocaro. ",
  "ja158:2.1": "pakkhandinā pagabbhena ",
  "ja158:2.2": "niccaṃ sandanakhādinā ",
  "ja158:2.3": "sameti pāpaṃ pāpena ",
  "ja158:2.4": "sameti asatā asanti. ",
  "ja158:3.1": ""
}
