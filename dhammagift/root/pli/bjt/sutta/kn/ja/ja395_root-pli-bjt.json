  "ja395:0.4": "",
  "ja395:1.1": "cirassaṃ vata passāma ",
  "ja395:1.2": "sahāyaṃ maṇidhārinaṃ, ",
  "ja395:1.3": "sukatāya massukuttiyā ",
  "ja395:1.4": "sobhate vata me sakhā. ",
  "ja395:2.1": "parūḷhakacchanakhalomo ",
  "ja395:2.2": "ahaṃ kammesu vyāvaṭo, ",
  "ja395:2.3": "cirassaṃ nahāpitaṃ laddhā ",
  "ja395:2.4": "lomantaṃ apahārayiṃ. yaṃ nu ",
  "ja395:3.1": "lomaṃ ahāresi ",
  "ja395:3.2": "dullabhaṃ laddhakappakaṃ, ",
  "ja395:3.3": "atha kiñcarahi te samma ",
  "ja395:3.4": "kaṇṭhe kiṇakiṇāyati. ",
  "ja395:4.1": "manussasukhumālānaṃ ",
  "ja395:4.2": "maṇi kaṇṭhesu lambati, ",
  "ja395:4.3": "tesāhamanusikkhāmi ",
  "ja395:4.4": "mā tvaṃ maññi davā kataṃ. ",
  "ja395:5.1": "sacepi maṃ pihayasi ",
  "ja395:5.2": "massukuttiṃ sukāritaṃ, ",
  "ja395:5.3": "kārayismāmi te samma ",
  "ja395:5.4": "maṇiñcāpi dadāmi te. ",
  "ja395:6.1": "tvaññeva maṇinā channo ",
  "ja395:6.2": "sukatāya ca massuyā, ",
  "ja395:6.3": "āmanta kho taṃ gacchāmi ",
  "ja395:6.4": "piyaṃ me tava dasasnanti. ",
  "ja395:7.1": "",
  "ja395:7.2": "10. kākajātakaṃ senakavaggo dutiyo ",
  "ja395:8.1": "tassuddānaṃ: ",
  "ja395:9.1": "atha passa sasūvi ca tuṇḍilako ",
  "ja395:9.2": "migamayhaka pañcama sakkavaro, ",
  "ja395:9.3": "atha pañjalivārija mejjha puna ",
  "ja395:9.4": "atha vaṭṭaka kapotavarena dasa. chakkanipātaṃ ",
  "ja395:10.1": "niṭṭhitaṃ. tatra vagguddānaṃ bhavati: ",
  "ja395:11.1": "atha vaggaṃ pakittissaṃ ",
  "ja395:11.2": "chanipātavaruttame, ",
  "ja395:11.3": "avāriyo senako ",
  "ja395:11.4": "dveva vuttā subyañjanāti. ",
  "ja395:12.1": ""
}
