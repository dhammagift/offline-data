  "ja541:131.3": "vipākaṃ puññakammānaṃ ",
  "ja541:131.4": "jānaṃ akkhāsajānato ",
  "ja541:132.1": "bārāṇasiyaṃ gahapati ",
  "ja541:132.2": "esa dānapatī ahū, ",
  "ja541:132.3": "ārāme udapāne ca ",
  "ja541:132.4": "papā saṅkamanāni ca. ",
  "ja541:132.5": "arahante sītibhūte ",
  "ja541:132.6": "sakkaccaṃ paṭipādayi, ",
  "ja541:133.1": "cīvaraṃ piṇḍapātañca ",
  "ja541:133.2": "paccayaṃ sayanāsanaṃ, ",
  "ja541:133.3": "adāsi ujubhūtesu ",
  "ja541:133.4": "vippasannena cetasā. ",
  "ja541:134.1": "cātuddasiṃ pañcadasiṃ ",
  "ja541:134.2": "yāva pakkhassa aṭṭhamiṃ, ",
  "ja541:134.3": "pāṭihāriyapakkhañca ",
  "ja541:134.4": "aṭṭhaṅgasusamāgataṃ, ",
  "ja541:135.1": "uposathaṃ upavasi ",
  "ja541:135.2": "sadā sīlesu saṃvuto, ",
  "ja541:135.3": "saññamo saṃvibhāgo ca ",
  "ja541:135.4": "so vimānasmiṃ modati. ",
  "ja541:136.1": "yathā udayamādicco ",
  "ja541:136.2": "hoti lohitako mahā, ",
  "ja541:136.3": "tathūpamaṃ idaṃ vyambhaṃ ",
  "ja541:136.4": "jātarūpassa nimmitaṃ. ",
  "ja541:137.1": "vittī hi maṃ vindati sūta disvā ",
  "ja541:137.2": "pucchāmi taṃ mātali devasārathi, ",
  "ja541:137.3": "ayaṃ nu macco kimakāsi sādhuṃ ",
  "ja541:137.4": "yo modati saggapatto vimāne. ",
  "ja541:138.1": "tassa puṭṭho viyākāsi ",
  "ja541:138.2": "mātalī devasārathi, ",
  "ja541:138.3": "vipākaṃ puññakammānaṃ ",
  "ja541:138.4": "jānaṃ akkhāsajānato. ",
  "ja541:139.1": "sāvatthiyaṃ gahapati ",
  "ja541:139.2": "esa dānapatī ahu, ",
  "ja541:139.3": "ārāme udapāne ca ",
  "ja541:139.4": "papā saṅkamanāni ca. ",
  "ja541:139.5": "arahante sītibhūte ",
  "ja541:139.6": "sakkaccaṃ paṭipādayi, ",
  "ja541:140.1": "cīvaraṃ piṇḍapātañca ",
  "ja541:140.2": "paccayaṃ sayanāsanaṃ, ",
  "ja541:140.3": "adāsi ujubhūtesu ",
  "ja541:140.4": "vippasannena cetasā. ",
  "ja541:141.1": "cātuddasiṃ pañcadasiṃ ",
  "ja541:141.2": "yāva pakkhassa aṭṭhamiṃ, ",
  "ja541:141.3": "pāṭihāriya pakkhañca ",
  "ja541:141.4": "aṭṭhaṅgasusamāgataṃ, ",
  "ja541:142.1": "uposathaṃ upavasi ",
  "ja541:142.2": "sadā sīlesu saṃvuto, ",
  "ja541:142.3": "saṃyamo saṃvibhāgo ca ",
  "ja541:142.4": "so vimānasmiṃ modati. ",
  "ja541:143.1": "vehāsayāme bahukā ",
  "ja541:143.2": "jātarūpassa nimmitā, ",
  "ja541:143.3": "daddallamānā ābhenti ",
  "ja541:143.4": "vijjuvabbhaghanantare. ",
  "ja541:144.1": "",
  "ja541:145.1": "vittī hi maṃ vindati sūta disvā ",
  "ja541:145.2": "pucchāmi taṃ mātali devasārathi, ",
  "ja541:145.3": "ime nu macco kimakaṃsu sādhuṃ ",
  "ja541:145.4": "yo modare saggapattā vimāne. ",
  "ja541:146.1": "tassa puṭṭho viyākāsi ",
  "ja541:146.2": "mātalī devasārathi, ",
  "ja541:146.3": "vipākaṃ puññakammānaṃ ",
  "ja541:146.4": "jānaṃ akkhāsajānato. ",
  "ja541:147.1": "saddhāya suniviṭṭhāya ",
  "ja541:147.2": "saddhamme suppavedite, ",
  "ja541:147.3": "akaṃsu satthuvacanaṃ ",
  "ja541:147.4": "sammāsambuddhasāsanaṃ, ",
  "ja541:147.5": "tesaṃ etāni ṭhānāni ",
  "ja541:147.6": "yāni tvaṃ rāja passasi. ",
  "ja541:148.1": "viditāni te mahārāja ",
  "ja541:148.2": "āvāsaṃ pāpakamminaṃ, ",
  "ja541:148.3": "atho kalyāṇakammānaṃ ",
  "ja541:148.4": "ṭhānāni viditāni te; ",
  "ja541:148.5": "uyyāhidāni rājisi ",
  "ja541:148.6": "devarājassa santike. ",
  "ja541:149.1": "vimānakaṇḍaṃ niṭṭhitaṃ. sahassayuttaṃ hayavāhiṃ ",
  "ja541:149.2": "dibbaṃ yānaṃ adhiṭṭhito, ",
  "ja541:149.3": "yāyamāno mahārājā ",
  "ja541:149.4": "addā sīdantare nage; ",
  "ja541:149.5": "disvānāmantayī sūtaṃ ",
  "ja541:149.6": "ime ke nāma pabbatā. ",
  "ja541:150.1": "",
  "ja541:150.2": "",
  "ja541:150.3": "",
  "ja541:150.4": "",
  "ja541:151.1": "sudassano karavīko ",
  "ja541:151.2": "īsadharo yugandharo, ",
  "ja541:151.3": "nemindharo vinatako ",
  "ja541:151.4": "assakaṇṇo giribrahā. ",
  "ja541:152.1": "ete sīdantare nagā ",
  "ja541:152.2": "anupubbasamuggatā, ",
  "ja541:152.3": "mahārājānamāvāsā ",
  "ja541:152.4": "yāni tvaṃ rāja passasi. ",
  "ja541:153.1": "anekarūpaṃ ruciraṃ ",
  "ja541:153.2": "nānācitraṃ pakāsati, ",
  "ja541:153.3": "ākiṇṇaṃ indasadisehi ",
  "ja541:153.4": "vyaggheheva surakkhitaṃ. ",
  "ja541:154.1": "vittī hi maṃ vindati sūta disvā ",
  "ja541:154.2": "pucchāmi taṃ mātali devasārathi, ",
  "ja541:154.3": "imaṃ nu dvāraṃ kimbhiññamāhu ",
  "ja541:154.4": "(manoramaṃ dissati dūratova.) ",
  "ja541:155.1": "tassa puṭṭho viyākāsī ",
  "ja541:155.2": "mātalī devasārathi, ",
  "ja541:155.3": "vipākaṃ puññakammānaṃ ",
  "ja541:155.4": "jānaṃ akkhāsajānato. ",
  "ja541:156.1": "cittakūṭoti yaṃ āhu ",
  "ja541:156.2": "devarājapavesanaṃ, ",
  "ja541:156.3": "sudassanassa girino ",
  "ja541:156.4": "dvāraṃ hetaṃ pakāsati. ",
  "ja541:157.1": "anekarūpaṃ ruciraṃ ",
  "ja541:157.2": "nānācitraṃ pakāsati, ",
  "ja541:157.3": "ākiṇṇaṃ indasadisehi ",
  "ja541:157.4": "vyaggheheve surakkhitaṃ. ",
  "ja541:157.5": "pavisetena rājisi ",
  "ja541:157.6": "arajaṃ bhūmimakkama. ",
  "ja541:158.1": "sahassayuttaṃ hayavāhiṃ ",
  "ja541:158.2": "dibbaṃ yānaṃ adhiṭṭhito, ",
  "ja541:158.3": "yāyamāno mahārājā ",
  "ja541:158.4": "addā devasabhaṃ idaṃ. ",
  "ja541:159.1": "yathā sarade ākāso ",
  "ja541:159.2": "nīlova patidissati, ",
  "ja541:159.3": "tathūpamaṃ idaṃ vyambhaṃ ",
  "ja541:159.4": "veḷuriyāsu nimmitaṃ. ",
  "ja541:160.1": "vittī hi maṃ vindati sūta disvā ",
  "ja541:160.2": "pucchāmi taṃ mātali devasārathi, ",
  "ja541:160.3": "imaṃ nu vyambhaṃ ",
  "ja541:160.4": "kimabhiññamāhu. ",
  "ja541:161.1": "tassa puṭṭho viyākāsi ",
  "ja541:161.2": "mātalī devasārathi, ",
  "ja541:161.3": "vipākaṃ puññakammānaṃ ",
  "ja541:161.4": "jānaṃ akkhāsajānato. ",
  "ja541:162.1": "sudhammaṃ iti yamāhu ",
  "ja541:162.2": "passesā dissate sabhā, ",
  "ja541:162.3": "veḷuriyā rucirā citrā ",
  "ja541:162.4": "dhārayanti sunimmitā. ",
  "ja541:163.1": "aṭṭhaṃsā sukatā thambhā ",
  "ja541:163.2": "sabbe veḷuriyāmayā, ",
  "ja541:163.3": "yattha devā tāvatiṃsā ",
  "ja541:163.4": "sabbe indapurohitā. ",
  "ja541:164.1": "atthaṃ devamanussānaṃ ",
  "ja541:164.2": "cintayantā samacchare, ",
  "ja541:164.3": "pavisetena rājisi ",
  "ja541:164.4": "devānaṃ anumodanaṃ. ",
  "ja541:165.1": "taṃ devā paṭinandiṃsu ",
  "ja541:165.2": "disvā rājānamāgataṃ, ",
  "ja541:165.3": "svāgataṃ te mahārāja ",
  "ja541:165.4": "atho te adurāgataṃ. ",
  "ja541:165.5": "nisīdadāni rājisi ",
  "ja541:165.6": "devarājassa santike, ",
  "ja541:166.1": "sakkopi paṭinandittha ",
  "ja541:166.2": "vedehaṃ mithilaggahaṃ. ",
  "ja541:166.3": "nimantayi ca kāmehi ",
  "ja541:166.4": "āsanena ca vāsavo, ",
  "ja541:167.1": "sādhu khosi anuppatto ",
  "ja541:167.2": "āvāsaṃ vasavattinaṃ. ",
  "ja541:167.3": "vasa devesu rājisi ",
  "ja541:167.4": "sabbakāmasamiddhisu, ",
  "ja541:167.5": "tāvatiṃsesu devesu ",
  "ja541:167.6": "bhuñja kāme amānuse. ",
  "ja541:168.1": "yathā yācitakaṃ yānaṃ ",
  "ja541:168.2": "yathā yācitakaṃ dhanaṃ, ",
  "ja541:168.3": "evaṃ sampadamevetaṃ ",
  "ja541:168.4": "yaṃ parato dānapaccayā. ",
  "ja541:169.1": "nacāhametaṃ icchāmi ",
  "ja541:169.2": "yaṃ parato dānapaccayā, ",
  "ja541:169.3": "sayaṃ katāni puññāni ",
  "ja541:169.4": "taṃ me āveṇiyaṃ dhanaṃ. ",
  "ja541:170.1": "sohaṃ gantvā samussesu ",
  "ja541:170.2": "kāhāmi kusalaṃ bahuṃ, ",
  "ja541:170.3": "dānena samacariyāya ",
  "ja541:170.4": "saṃyamena damena ca; ",
  "ja541:170.5": "yaṃ katvā sukhito hoti ",
  "ja541:170.6": "na ca pacchānutappati. ",
  "ja541:171.1": "bahūpakāro no bhavaṃ ",
  "ja541:171.2": "mātalī devasārathi, ",
  "ja541:171.3": "yo me kalyāṇakammānaṃ ",
  "ja541:171.4": "pāpāni paṭidassayi. ",
  "ja541:172.1": "idaṃ vatvā nimirājā ",
  "ja541:172.2": "vedeho mithilaggabho, ",
  "ja541:172.3": "puthuyaññaṃ yajitvāna ",
  "ja541:172.4": "saññamaṃ ajjhupāgamīti. ",
  "ja541:173.1": "nimijātakaṃ catutthaṃ. "
}
