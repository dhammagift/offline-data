  "ja541:0.3": "",
  "ja541:0.4": "4. nimijātakaṃ ",
  "ja541:1.1": "accheraṃ vata lokasmiṃ ",
  "ja541:1.2": "uppajjanti vicakkhaṇā, ",
  "ja541:1.3": "yadā ahū nimirājā ",
  "ja541:1.4": "paṇḍito kusalatthiko. ",
  "ja541:2.1": "rājā sabbavidehānaṃ ",
  "ja541:2.2": "adā dānaṃ arindamo, ",
  "ja541:2.3": "tassa taṃ dadato dānaṃ ",
  "ja541:2.4": "saṅkeppā udapajjatha. ",
  "ja541:2.5": "dānaṃ vā brahmacariyaṃ vā ",
  "ja541:2.6": "katamaṃsu mahapphalaṃ. ",
  "ja541:3.1": "tassa saṅkappamaññāya ",
  "ja541:3.2": "maghavā devakuñjaro, ",
  "ja541:3.3": "sahassanetto pāturahū ",
  "ja541:3.4": "vaṇṇena nihataṃ tamaṃ. ",
  "ja541:4.1": "sa lomahaṭṭho manujindo ",
  "ja541:4.2": "vāsavaṃ avacā nimi, ",
  "ja541:4.3": "devatānusi gandhabbo ",
  "ja541:4.4": "ādu sakko purindado. ",
  "ja541:5.1": "na ca me tādiso vaṇṇo ",
  "ja541:5.2": "diṭṭho vā yadi vā suto, ",
  "ja541:5.3": "ācikkha me tvaṃ bhaddante ",
  "ja541:5.4": "kathaṃ jānemu taṃ mayaṃ. ",
  "ja541:6.1": "sa lomahaṭṭhaṃ ñatvāna ",
  "ja541:6.2": "vāsavo avacā nimiṃ, ",
  "ja541:6.3": "sakkohamasmi devindo ",
  "ja541:6.4": "āgatosmi tavantiko. ",
  "ja541:6.5": "alomahaṭṭho manujinda ",
  "ja541:6.6": "puccha pañhaṃ yadicchasi. ",
  "ja541:7.1": "so ca tena katokāso ",
  "ja541:7.2": "vāsavaṃ avacā nimi. ",
  "ja541:7.3": "pucchāmi taṃ mahābāhu ",
  "ja541:7.4": "sabbabhūtānamissara, ",
  "ja541:7.5": "dānaṃ vā brahmacariyaṃ vā ",
  "ja541:7.6": "katamaṃsu mahapphalaṃ. ",
  "ja541:8.1": "so puṭṭho naradevena ",
  "ja541:8.2": "vāsavo avacā nimiṃ, ",
  "ja541:8.3": "vipākaṃ brahmacariyassa ",
  "ja541:8.4": "jānaṃ akkhāsajānato. ",
  "ja541:9.1": "hīnena brahmacariyena ",
  "ja541:9.2": "khattiye upapajjati, ",
  "ja541:9.3": "majjhimena ca devattaṃ ",
  "ja541:9.4": "uttamena visujjhati. ",
  "ja541:10.1": "nahete sulabhā kāyā ",
  "ja541:10.2": "yāvayogena kenaci, ",
  "ja541:10.3": "yo kāye upapajjanti ",
  "ja541:10.4": "anāgārā tapassino. ",
  "ja541:11.1": "dudīpo sāgaro selo ",
  "ja541:11.2": "mucalindo bhagīraso, ",
  "ja541:11.3": "usīnaro aṭṭhako ca ",
  "ja541:11.4": "assako ca puthujjano, ",
  "ja541:12.1": "ete caññe ca rājāno ",
  "ja541:12.2": "khattiyā brāhmaṇā bahu, ",
  "ja541:12.3": "puthu yaññaṃ yajitvāna ",
  "ja541:12.4": "petaṃ te nātivattisuṃ. ",
  "ja541:13.1": "",
  "ja541:14.1": "ye ve adutiyā na ramanti ekikā vivekajaṃ ye na labhanti pītiṃ, kiñcāpi te indasamānabhogā te ve parādhīnasukhā varākā. addhā ime avattiṃsu ",
  "ja541:14.2": "anāgārā tapassino, ",
  "ja541:14.3": "sattisayo yāmahanu ",
  "ja541:14.4": "somayāgo manojavo, ",
  "ja541:15.1": "samuddo māgho bharato ca ",
  "ja541:15.2": "isikālikarakkhiyo, aṃgīraso ",
  "ja541:15.3": "kassapo ca ",
  "ja541:15.4": "kisavaccho akitti ca. ",
  "ja541:16.1": "uttarena nadī sīdā ",
  "ja541:16.2": "gambhīrā duratikkamā, ",
  "ja541:16.3": "naḷaggivaṇṇā jotanti ",
  "ja541:16.4": "sadā kañcanapabbatā. ",
  "ja541:17.1": "parūḷhakacchā tagarā ",
  "ja541:17.2": "rūḷhakacchā vanā nagā, ",
  "ja541:17.3": "tatrāsuṃ dasasabhassāni ",
  "ja541:17.4": "porāṇā isayo pure. ",
  "ja541:18.1": "ahaṃ seṭṭhosmi dānena ",
  "ja541:18.2": "saṃyamena damena ca, ",
  "ja541:18.3": "anuttaraṃ vataṃ katvā ",
  "ja541:18.4": "pakiracārī samāhite. ",
  "ja541:19.1": "jātimantaṃ ajaccaṃ ",
  "ja541:19.2": "ca ahamujjugataṃ naraṃ, ",
  "ja541:19.3": "ativelaṃ namassissaṃ ",
  "ja541:19.4": "kammabandhu hi mātiyā. ",
  "ja541:20.1": "sabbe vaṇṇā adhammaṭṭhā ",
  "ja541:20.2": "patanti nirayaṃ adho, ",
  "ja541:20.3": "sabbe vaṇṇā nirujjhanti ",
  "ja541:20.4": "caritvā dhammamuttamaṃ. ",
  "ja541:21.1": "idaṃ vatvāna maghavā ",
  "ja541:21.2": "devarājā sujampati, ",
  "ja541:21.3": "vedehaṃ anusāsitvā ",
  "ja541:21.4": "saggakāyaṃ apakkami. ",
  "ja541:22.1": "imaṃ bhonto nisāmetha ",
  "ja541:22.2": "yāvantettha samāgatā, ",
  "ja541:22.3": "dhammikānaṃ manussānaṃ ",
  "ja541:22.4": "vaṇṇaṃ uccāvacaṃ bahuṃ. ",
  "ja541:23.1": "yathā ayaṃ nimirājā ",
  "ja541:23.2": "paṇḍito kusalatthiko, ",
  "ja541:23.3": "rājā sabbavidehānaṃ ",
  "ja541:23.4": "adā dānaṃ arindamo. ",
  "ja541:24.1": "tassa taṃ dadato dānaṃ ",
  "ja541:24.2": "saṅkappo udapajjatha, ",
  "ja541:24.3": "dānaṃ vā brahmacariyaṃ vā ",
  "ja541:24.4": "katamaṃsu mahapphalaṃ. ",
  "ja541:25.1": "abbhuto vata lokasmiṃ ",
  "ja541:25.2": "uppajji lomahaṃsano, ",
  "ja541:25.3": "dibbo ratho pāturahū ",
  "ja541:25.4": "vedehassa yasassino. ",
  "ja541:26.1": "devaputto mahiddhiko ",
  "ja541:26.2": "mātalī devasārathi, ",
  "ja541:26.3": "nimantayittha rājānaṃ ",
  "ja541:26.4": "vedehaṃ mithilaggahaṃ. ",
  "ja541:27.1": "ehimaṃ rathamāruyha ",
  "ja541:27.2": "rājaseṭṭha disampati, ",
  "ja541:27.3": "devā dassanakāmā te ",
  "ja541:27.4": "tāvatiṃsā saindakā ",
  "ja541:27.5": "saramānā hi te devā ",
  "ja541:27.6": "sudhammāyaṃ samacchare. ",
  "ja541:28.1": "tato ca rājā taramāno ",
  "ja541:28.2": "vedeho mithilaggaho, ",
  "ja541:28.3": "āsanā vuṭṭhahitvāna ",
  "ja541:28.4": "pamukho rathamāruhi. ",
  "ja541:29.1": "abhirūḷhaṃ ethaṃ dibbaṃ ",
  "ja541:29.2": "mātalī etadabravi, ",
  "ja541:29.3": "kena taṃ nemi maggena ",
  "ja541:29.4": "rājaseṭṭha disampati. ",
  "ja541:29.5": "yena vā pāpakammantā ",
  "ja541:29.6": "puññakammā ca ye narā. ",
  "ja541:30.1": "ubhayeneva maṃ nehi ",
  "ja541:30.2": "mātalī devasārathi, ",
  "ja541:30.3": "yena vā pāpakammantā ",
  "ja541:30.4": "puññakammā ca ye narā. ",
  "ja541:31.1": "kena taṃ paṭhamaṃ nemi ",
  "ja541:31.2": "rājaseṭṭha disampati, ",
  "ja541:31.3": "yena vā pāpakammantā ",
  "ja541:31.4": "puññakammā ca ye narā. ",
  "ja541:32.1": "niraye tāva passāmi ",
  "ja541:32.2": "āvāse pāpakamminaṃ, ",
  "ja541:32.3": "ṭhānāni luddakammānaṃ ",
  "ja541:32.4": "dussilānaṃ ca yā gati. ",
  "ja541:33.1": "dassesi mātalī rañño ",
  "ja541:33.2": "duggaṃ vetaraṇiṃ nadiṃ, ",
  "ja541:33.3": "kuthantiṃ khārasaṃyuttaṃ ",
  "ja541:33.4": "tattaṃ aggisikhūpamaṃ. ",
  "ja541:34.1": "nimi have mātaliṃ ajjhabhāsatha ",
  "ja541:34.2": "disvā janaṃ patamānaṃ vidugge, ",
  "ja541:34.3": "bhayaṃ hi maṃ vindati sūta disvā ",
  "ja541:34.4": "pucchāmi taṃ mātalī devasārathi ",
  "ja541:34.5": "ime nu maccā kimakaṃsu pāpaṃ ",
  "ja541:34.6": "yeme janā vetaraṇi patanti. ",
  "ja541:35.1": "tassa puṭṭho viyākāsi ",
  "ja541:35.2": "mātalī devasārathi, ",
  "ja541:35.3": "vipākaṃ pāpa kammānaṃ ",
  "ja541:35.4": "jānaṃ akkhāsajānato. ",
  "ja541:36.1": "ye dubbale balavanto jivaloke ",
  "ja541:36.2": "hiṃsenti rosenti supāpadhammā, ",
  "ja541:36.3": "te luddakammā pasavetvā pāpaṃ ",
  "ja541:36.4": "te ve janā vetaraṇiṃ patanti. ",
  "ja541:37.1": "sāmā ca soṇā sabalā ca gijjhā ",
  "ja541:37.2": "kākoḷasaṅghā ca adenti bheravā; ",
  "ja541:37.3": "bhayaṃ hi maṃ vindati sūta disvā ",
  "ja541:37.4": "pucchāmi taṃ mātali devasārathi ",
  "ja541:37.5": "ime nu maccā kimakaṃsu pāpaṃ ",
  "ja541:37.6": "yayimaṃ janaṃ kākoḷā adenti. ",
  "ja541:38.1": "tassa puṭṭho viyākāsi ",
  "ja541:38.2": "mātalī devasārathi, ",
  "ja541:38.3": "vipākaṃ pāpakammānaṃ ",
  "ja541:38.4": "jānaṃ akkhāsajānato. ",
  "ja541:39.1": "ye keci me maccharino kadariyā ",
  "ja541:39.2": "paribhāsakā samaṇabrāhmaṇānaṃ ",
  "ja541:39.3": "hisenti rosenti supāpadhammo, ",
  "ja541:39.4": "te luddakammā pasavetvā pāpaṃ ",
  "ja541:39.5": "tayimaṃ janaṃ kākoḷā adenti. ",
  "ja541:40.1": "sajotibhūtā paṭhaviṃ kamanti ",
  "ja541:40.2": "tattehi khandhehi ca pothayanti ",
  "ja541:40.3": "bhayaṃ hi maṃ vindati sūta disvā, ",
  "ja541:40.4": "pucchāmi taṃ mātalī devasārathī ",
  "ja541:40.5": "ime nu maccā kimakaṃsu pāpaṃ ",
  "ja541:40.6": "yeme janā khandhahatā sayanti. ",
  "ja541:41.1": "tassa puṭṭho viyākāsi ",
  "ja541:41.2": "mātalī devasārathi, ",
  "ja541:41.3": "vipākaṃ pāpakammānaṃ ",
  "ja541:41.4": "jānaṃ akkhāsajānato. ",
  "ja541:42.1": "ye jīvalokasmiṃ supāpadhammino ",
  "ja541:42.2": "narañca nāriñca apāpadhammaṃ; ",
  "ja541:42.3": "hiṃsenti rosenti supāpadhammā ",
  "ja541:42.4": "te luddakammā pasavetthā pāpaṃ ",
  "ja541:42.5": "teme janā khandhahatā sayanti. ",
  "ja541:43.1": "aṅgakāsuṃ apare thunanti ",
  "ja541:43.2": "narā rudantā paridaḍḍhagattā; ",
  "ja541:43.3": "bhayaṃ hi maṃ vindati sūta disvā ",
  "ja541:43.4": "pucchāmi taṃ mātali devasārathi, ",
  "ja541:43.5": "ime nu maccā kimakaṃsu pāpaṃ ",
  "ja541:43.6": "yeme janā aṅgārakāsuṃ thunanti. ",
  "ja541:44.1": "tassa puṭṭho viyākāsi ",
  "ja541:44.2": "mātalī devasārathi, ",
  "ja541:44.3": "vipākaṃ pāpakammānaṃ ",
  "ja541:44.4": "jānaṃ akkhāsajānato. ",
  "ja541:45.1": "ye keci pūgāyatanassa hetu ",
  "ja541:45.2": "sakkhiṃ karitvā iṇaṃ jāpayantī; ",
  "ja541:45.3": "te jāpayitvā janataṃ janinda ",
  "ja541:45.4": "te luddakammā pasavetvā pāpaṃ ",
  "ja541:45.5": "teme janā aṅgārakāsuṃ thunanti ",
  "ja541:46.1": "sajotibhūtā jalitā padittā ",
  "ja541:46.2": "padissati mahatī lohakumbhī; ",
  "ja541:46.3": "bhayaṃ hi maṃ vindati sūta disvā ",
  "ja541:46.4": "",
  "ja541:46.5": "ime nu maccā kimakaṃsu pāpaṃ pucchāmi taṃ mātali devasārathi ",
  "ja541:46.6": "yeme janā avaṃsirā lohakumbhiṃ patanti. ",
  "ja541:47.1": "tassa puṭṭho viyākāsi ",
  "ja541:47.2": "mātalī devasārathi, ",
  "ja541:47.3": "vipākaṃ pāpakammānaṃ ",
  "ja541:47.4": "jānaṃ akkhāsajānato. ",
  "ja541:48.1": "ye sīlavaṃ samaṇaṃ brāhmaṇaṃ vā ",
  "ja541:48.2": "hiṃsenti rosenti supāpadhammino; ",
  "ja541:48.3": "te luddakammā pasavetvā pāpaṃ ",
  "ja541:48.4": "teme janā (avaṃsirā) lohakumbhiṃ patanti. ",
  "ja541:49.1": "luñcenti gīvaṃ atha veṭhayitvā ",
  "ja541:49.2": "uṇhodakasmiṃ pakiledayitvā; ",
  "ja541:49.3": "bhayaṃ hi maṃ vindati suta disvā ",
  "ja541:49.4": "pucchāmi taṃ mātali devasārathi ",
  "ja541:49.5": "ime nu maccā kimakaṃsu pāpaṃ ",
  "ja541:49.6": "yeme janā luttasirā sayanti. ",
  "ja541:50.1": "tassa puṭṭho viyākāsi ",
  "ja541:50.2": "mātali devasārathi, ",
  "ja541:50.3": "vipākaṃ pāpakammānaṃ ",
  "ja541:50.4": "jānaṃ akkhāsajānato. ",
  "ja541:51.1": "ye jīvalokasmiṃ supāpadhammino ",
  "ja541:51.2": "pakkhi gahetvāna viheṭhayanti te ",
  "ja541:51.3": "heṭhayitvā sakuṇaṃ janinda ",
  "ja541:51.4": "te luddakammā pasavetvā pāpaṃ ",
  "ja541:51.5": "teme janā luttasirā sayanti. ",
  "ja541:52.1": "pahuta toyā anikhātakūlā ",
  "ja541:52.2": "nadī ayaṃ sandati sūpatitthā; ",
  "ja541:52.3": "ghammābhitattā manujā pivanti ",
  "ja541:52.4": "pivatañca tesaṃ bhusaṃ hoti pāni. ",
  "ja541:53.1": "bhayaṃ hi maṃ vindati sūta disvā ",
  "ja541:53.2": "pucchāmi taṃ mātali devasārathi, ",
  "ja541:53.3": "ime nu maccā kimakaṃsu pāpaṃ ",
  "ja541:53.4": "pivatañca tesaṃ bhusaṃ hoti pāni. ",
  "ja541:54.1": "tassa puṭṭho viyākāsi ",
  "ja541:54.2": "mātali devasārathi, ",
  "ja541:54.3": "vipākaṃ pāpakammānaṃ ",
  "ja541:54.4": "jānaṃ akkhāsajānato. ",
  "ja541:55.1": "ye suddhadhaññaṃ palāpena missaṃ ",
  "ja541:55.2": "asuddhakammā kayino dadanti, ",
  "ja541:55.3": "ghammābhitattānaṃ pipāsitānaṃ ",
  "ja541:55.4": "pivatañca tesaṃ bhusaṃ hoti pāni. ",
  "ja541:56.1": "usūhi sattīhi ca tomarehi ",
  "ja541:56.2": "dubhayāni passāni tudanti kandataṃ, ",
  "ja541:56.3": "bhayaṃ hi maṃ vindati sūta disvā ",
  "ja541:56.4": "pucchāmi taṃ mātali devasārathi ",
  "ja541:56.5": "ime nu maccā kimakaṃsu pāpaṃ ",
  "ja541:56.6": "yeme janā sattihatā sayanti. ",
  "ja541:57.1": "tassa puṭṭho viyākāsi ",
  "ja541:57.2": "mātali devasārathi, ",
  "ja541:57.3": "vipākaṃ pāpa kammānaṃ ",
  "ja541:57.4": "jānaṃ akkhāsajānato. ",
  "ja541:58.1": "ye jīvalokasmiṃ asādhukammino, ",
  "ja541:58.2": "adinnamādāya karonti jīvikaṃ, ",
  "ja541:58.3": "dhaññaṃ dhanaṃ rajataṃ jātarūpaṃ ",
  "ja541:58.4": "ajeḷakaṃ cāpi pasuṃ mahīsaṃ ",
  "ja541:58.5": "te luddakammā pasavetvā pāpaṃ ",
  "ja541:58.6": "teme janā sattihatā sayanti. ",
  "ja541:59.1": "gīvāya baddhā kissa ime puneke ",
  "ja541:59.2": "aññe vikattā bilakatā puneke bhayaṃ ",
  "ja541:59.3": "hi maṃ vindati sūta disvā ",
  "ja541:59.4": "pucchāmi taṃ mātali devasārathi, ",
  "ja541:59.5": "ime nu maccā kimakaṃsu pāpaṃ ",
  "ja541:59.6": "yeme janā bilakatā sayanti. ",
  "ja541:60.1": "tassa puṭṭho viyākāsi ",
  "ja541:60.2": "mātalī deva sārathi, ",
  "ja541:60.3": "vipākaṃ pāpakammānaṃ ",
  "ja541:60.4": "jānaṃ akkhāsajānato. ",
  "ja541:61.1": "orabbhikā sūkarikā ca macchikā ",
  "ja541:61.2": "pasuṃ mahisañca ajeḷakañca ",
  "ja541:61.3": "hantvāna sunesu pasārayiṃsu ",
  "ja541:61.4": "te luddakammā pasavetvā pāpaṃ ",
  "ja541:61.5": "teme janā bilakatā sayanti. ",
  "ja541:62.1": "rahado ayaṃ muttakarīsapūro ",
  "ja541:62.2": "duggandharūpo asuci pūti vāyati ",
  "ja541:62.3": "khudā paretā manujā adenti bhayaṃ ",
  "ja541:62.4": "hi maṃ vindati sūta disvā ",
  "ja541:62.5": "pucchāmi taṃ mātali devasārathi, ",
  "ja541:62.6": "ime nu maccā kimakaṃsu pāpaṃ ",
  "ja541:62.7": "yeme janā muttakarīsabhakkhā. ",
  "ja541:63.1": "tassa puṭṭho viyākāsi ",
  "ja541:63.2": "mātalī devasārathi, ",
  "ja541:63.3": "vipākaṃ pāpakammānaṃ ",
  "ja541:63.4": "jānaṃ akkhāsajānato. ",
  "ja541:64.1": "ye keci me kāraṇikā virosakā ",
  "ja541:64.2": "paresaṃ bhiṃsāya sadā niviṭṭhā ",
  "ja541:64.3": "te luddakammā pasavetvā pāpaṃ ",
  "ja541:64.4": "mittadduno mīḷhamadenti bālā ",
  "ja541:65.1": "rahado ayaṃ lohitapubbapūro ",
  "ja541:65.2": "duggandharūpo asuci pūti vāyati. ",
  "ja541:65.3": "ghammābhitattā manujā pivanti ",
  "ja541:65.4": "bhayaṃ hi maṃ vindati sūta disvā, ",
  "ja541:65.5": "pucchāmi taṃ mātali devasārathi, ",
  "ja541:65.6": "ime nu maccā kimakaṃsu pāpaṃ ",
  "ja541:65.7": "yeme janā lohitapubbabhakkhā. ",
  "ja541:66.1": "tassa puṭṭho viyākāsi ",
  "ja541:66.2": "mātali devasārathi, ",
  "ja541:66.3": "vipākaṃ pāpakammānaṃ ",
  "ja541:66.4": "jānaṃ akkhāsajānato. ",
  "ja541:67.1": "ye mātaraṃ vā pitaraṃ vā jivaloke ",
  "ja541:67.2": "pārājikā arahante hananti. ",
  "ja541:67.3": "te luddakammā pasavetvā pāpaṃ ",
  "ja541:67.4": "teme janā lohitapubbabhakkhā. ",
  "ja541:68.1": "jivhañca passa khalisena viddhaṃ ",
  "ja541:68.2": "vihataṃ yathā saṅkusatena cammaṃ; ",
  "ja541:68.3": "phandanti macchāva thalamhi khittā ",
  "ja541:68.4": "muñcanti kheḷaṃ rudamānā kimete. ",
  "ja541:69.1": "bhayaṃ hi maṃ vindati sūta disvā, ",
  "ja541:69.2": "pucchāmi taṃ mātali devasārathi, ",
  "ja541:69.3": "ime nu maccā kimakaṃsu pāpaṃ ",
  "ja541:69.4": "yeme janā vaṅkaghastā sayanti. ",
  "ja541:70.1": "tassa puṭṭho viyākāsi ",
  "ja541:70.2": "mātalī devasārathi, ",
  "ja541:70.3": "vipākaṃ pāpakammānaṃ ",
  "ja541:70.4": "jānaṃ akkhāsajānato. ",
  "ja541:71.1": "ye keci santhānagatā manussā ",
  "ja541:71.2": "agghena agghaṃ kayaṃ hāpayanti ",
  "ja541:71.3": "kūṭena kūṭaṃ dhanalobhahetu, ",
  "ja541:71.4": "channaṃ yathā vāricaraṃ vadhāya. ",
  "ja541:72.1": "na hi kūṭakārissa bhavanti tāṇā ",
  "ja541:72.2": "sakehi kammehi purakkhatassa, ",
  "ja541:72.3": "te luddakammā pasavetvā pāpaṃ ",
  "ja541:72.4": "te me janā vaṅkaghastā sayanti. ",
  "ja541:73.1": "nariyo imā samparibhintagattā ",
  "ja541:73.2": "paggayha kandanti bhuje dujaccā, ",
  "ja541:73.3": "sammakkhitā lohitapubbalittā ",
  "ja541:73.4": "gāvo yathā āghātane vikattā ",
  "ja541:73.5": "tā bhūmibhāgasmiṃ sadā nikhātā ",
  "ja541:73.6": "khandhātivattanti sajotibhūtā, ",
  "ja541:74.1": "bhayaṃ hi maṃ vindati sūta disvā, ",
  "ja541:74.2": "pucchāmi taṃ mātali devasārathi, ",
  "ja541:74.3": "imā nu nariyo kimakaṃsu pāpaṃ ",
  "ja541:74.4": "yā bhūmibhāgasmiṃ sadā nikhātā ",
  "ja541:74.5": "khandhātivattanti sajotibhūtā. ",
  "ja541:75.1": "tassa puṭṭho viyākāsi ",
  "ja541:75.2": "mātalī devasārathi, ",
  "ja541:75.3": "vipākaṃ pāpa kammānaṃ ",
  "ja541:75.4": "jānaṃ akkhāsajānato. ",
  "ja541:76.1": "koliniyāyo idha jivaloke ",
  "ja541:76.2": "asuddhakammā asataṃ acāruṃ ",
  "ja541:76.3": "tā dittarūpā pativippahāya, ",
  "ja541:76.4": "aññaṃ acāruṃ ratikhiḍḍahetu ",
  "ja541:76.5": "tā jīvalokasmiṃ ramāpayitvā ",
  "ja541:76.6": "khandhātivattanti sajotibhūtā. ",
  "ja541:77.1": "pāde gahetvā kissa ime puneke ",
  "ja541:77.2": "avaṃsirā narake pātayanti. ",
  "ja541:77.3": "bhayaṃ hi maṃ vindati sūta disvā, ",
  "ja541:77.4": "pucchāmi taṃ mātali devasārathi, ",
  "ja541:77.5": "ime nu maccā kimakaṃsu pāpaṃ ",
  "ja541:77.6": "ye me janā avaṃsirā narake pātayanti. ",
  "ja541:78.1": "tassa puṭṭho viyākāsi ",
  "ja541:78.2": "mātali devasārathi, ",
  "ja541:78.3": "vipākaṃ pāpakammānaṃ ",
  "ja541:78.4": "jānaṃ akkhāsajānato. ",
  "ja541:79.1": "ye jīvalokasmiṃ asādhukammino ",
  "ja541:79.2": "parassa dārāni atikkamanti, ",
  "ja541:79.3": "te tādisā uttamabhaṇḍathenā ",
  "ja541:79.4": "te me janā avaṃsirā narake pātayanti. ",
  "ja541:80.1": "te vassapūgāni bahūni tattha ",
  "ja541:80.2": "niraye dukkhaṃ vedanaṃ vedayanti, ",
  "ja541:80.3": "nahi pāpakārissa bhavanti tāṇā ",
  "ja541:80.4": "sakehi kammehi purakkhatassa ",
  "ja541:80.5": "te luddakammā pasavetvā pāpaṃ. ",
  "ja541:80.6": "te me janā avaṃsirā narake pātayanti. ",
  "ja541:81.1": "uccāvacāme vividhā upakkamā ",
  "ja541:81.2": "nirayesu dissanti sughorarūpā ",
  "ja541:81.3": "bhayaṃ hi maṃ vindati sūta disvā, ",
  "ja541:81.4": "pucchāmi taṃ mātalī devasārathi, ",
  "ja541:81.5": "ime nu maccā kimakaṃsu pāpaṃ ",
  "ja541:81.6": "ye me janā adhimattā dukkhā tibbā ",
  "ja541:81.7": "khārā kaṭukā vedanā vedayanti. ",
  "ja541:82.1": "tassa puṭṭho viyākāsi ",
  "ja541:82.2": "mātalī devasārathi, ",
  "ja541:82.3": "vipākaṃ pāpakammānaṃ ",
  "ja541:82.4": "jānaṃ akkhāsajānato ",
  "ja541:83.1": "ye jīvalokasmiṃ supāpadiṭṭhino ",
  "ja541:83.2": "vissāsakammāni karonti mohā; ",
  "ja541:83.3": "parañca diṭṭhīsu samādapenti ",
  "ja541:83.4": "te pāpādiṭṭhi pasavetvā pāpaṃ ",
  "ja541:83.5": "te me janā adhimattā dukkhā tibbā ",
  "ja541:83.6": "kharā kaṭukā vedanā vedayanti. ",
  "ja541:84.1": "viditāni te mahārāja ",
  "ja541:84.2": "āvāsaṃ pāpakamminaṃ, ",
  "ja541:84.3": "ṭhānāni luddakammānaṃ ",
  "ja541:84.4": "dussīlānañca yā gati; ",
  "ja541:84.5": "uyyāhidāni rājisi ",
  "ja541:84.6": "devarājassa santike. ",
  "ja541:85.1": "",
  "ja541:86.1": "nirayakaṇḍaṃ niṭṭhitaṃ. pañcathūpaṃ dissatidaṃ vimānaṃ ",
  "ja541:86.2": "mālā piḷandhā sayanassa majjhe, ",
  "ja541:86.3": "tatthacchati nārī mahānubhāvā ",
  "ja541:86.4": "uccāvacaṃ iddhiṃ vikubbamānā. ",
  "ja541:87.1": "vittī hi maṃ vindati sūta disvā ",
  "ja541:87.2": "pucchāmi taṃ mātali devasārathi, ",
  "ja541:87.3": "ayaṃ nu nārī kimakāsi sādhuṃ ",
  "ja541:87.4": "yā modati saggapattā vimāne. ",
  "ja541:88.1": "tassa puṭṭho viyākāsi ",
  "ja541:88.2": "mātalī devasārathi, ",
  "ja541:88.3": "vipākaṃ puññakammānaṃ ",
  "ja541:88.4": "jānaṃ akkhāsajānato. ",
  "ja541:89.1": "yadi te sutā khīraṇī jivaloke ",
  "ja541:89.2": "āmāya dāsī ahu brāhmaṇassa, ",
  "ja541:89.3": "sā pattakālaṃ atithiṃ viditvā ",
  "ja541:89.4": "mātāva puttaṃ sakimābhinandi. ",
  "ja541:89.5": "saññamā saṃvibhāgā ca ",
  "ja541:89.6": "sā vimānasmiṃ modati. ",
  "ja541:90.1": "daddallamānā ābhenti ",
  "ja541:90.2": "vimānā satta nimmitā, ",
  "ja541:90.3": "tattha yakkho mahiddhiko ",
  "ja541:90.4": "sabbābharaṇabhūsito ",
  "ja541:90.5": "samantā anupariyāti ",
  "ja541:90.6": "nārīgaṇapurakkhato. ",
  "ja541:91.1": "vitti hi maṃ vindati sūta disvā ",
  "ja541:91.2": "pucchāmi taṃ mātali devasārathi, ",
  "ja541:91.3": "ayaṃ nu macco kimakāsi sādhuṃ ",
  "ja541:91.4": "yo modati saggapatto vimāne. ",
  "ja541:92.1": "tassa puṭṭho viyākāsi ",
  "ja541:92.2": "mātalī devasārathi, ",
  "ja541:92.3": "vipākaṃ puññakammānaṃ ",
  "ja541:92.4": "jānaṃ akkhāsajānato. ",
  "ja541:93.1": "soṇadinno gahapati ",
  "ja541:93.2": "esa dānapatī ahū, ",
  "ja541:93.3": "esa pabbajituddissa ",
  "ja541:93.4": "vihāre satta kārayi. ",
  "ja541:94.1": "sakkaccaṃ te upaṭṭhāsi ",
  "ja541:94.2": "bhikkhavo tattha vāsike, ",
  "ja541:94.3": "acchādanañca bhattañca ",
  "ja541:94.4": "senāsanapadipiyaṃ; ",
  "ja541:94.5": "adāsi ujubhūtesu ",
  "ja541:94.6": "vippasannena cetasā. ",
  "ja541:95.1": "cātuddasiṃ pañcadasiṃ ",
  "ja541:95.2": "yāva pakkhassa aṭṭhamiṃ, ",
  "ja541:95.3": "pāṭihāriyapakkhañca ",
  "ja541:95.4": "aṭṭhaṅgasusamāgataṃ ",
  "ja541:96.1": "uposathaṃ ca upavasi ",
  "ja541:96.2": "sadā sīlesu saṃvuto, ",
  "ja541:96.3": "saṃyamo saṃvibhāgo ca ",
  "ja541:96.4": "so vimānasmiṃ modati. ",
  "ja541:97.1": "pabhāsati idaṃ vyambhaṃ ",
  "ja541:97.2": "eḷikāsu sunimmitaṃ. ",
  "ja541:97.3": "nārīvaragaṇākiṇṇaṃ ",
  "ja541:97.4": "kuṭāgāravarocitaṃ ",
  "ja541:97.5": "upetaṃ annapānehi ",
  "ja541:97.6": "naccagītehi cūbhayaṃ. ",
  "ja541:98.1": "vittī hi maṃ vindati sūta disvā ",
  "ja541:98.2": "pucchāmi taṃ mātali devasārathi, ",
  "ja541:98.3": "imā nu nāriyo kimakaṃsu sādhuṃ. ",
  "ja541:98.4": "yā modare saggapattā vimāne. ",
  "ja541:99.1": "tassa puṭṭho viyākāsi ",
  "ja541:99.2": "mātalī devasārathi, ",
  "ja541:99.3": "vipākaṃ puññakammānaṃ ",
  "ja541:99.4": "jānaṃ akkhāsajānato. ",
  "ja541:100.1": "yā kāci nāriyo idha jivaloke ",
  "ja541:100.2": "sīlavatiyo upāsikā, ",
  "ja541:100.3": "dāne ratā niccapasannacittā ",
  "ja541:100.4": "sacce ṭhitā uposathe appamattā. ",
  "ja541:100.5": "saṃyamā saṃvibhāgā ca ",
  "ja541:100.6": "tā vimānasmiṃ modare. ",
  "ja541:101.1": "pabhāsati idaṃ vyambhaṃ ",
  "ja541:101.2": "veḷuriyāsu nimmitaṃ, ",
  "ja541:101.3": "upetaṃ bhūmibhāgehi ",
  "ja541:101.4": "vibhattaṃ bhāgaso mitaṃ. ",
  "ja541:102.1": "āḷambarā mutiṅgā ca ",
  "ja541:102.2": "naccagītā suvāditā, ",
  "ja541:102.3": "dibbā saddā niccharanti ",
  "ja541:102.4": "savaṇeyyā manoramā. ",
  "ja541:103.1": "nāhaṃ evaṃ gataṃ jātu ",
  "ja541:103.2": "evaṃ suruciraṃ pure, ",
  "ja541:103.3": "saddaṃ samabhijānāmi ",
  "ja541:103.4": "diṭṭhaṃ vā yadi vā sutaṃ. ",
  "ja541:104.1": "vittī hi maṃ vindati sūta disvā ",
