  "ja170:0.4": "9. arakajātakaṃ. ",
  "ja170:1.1": "nāyaṃ pure unnamati toraṇagge kakaṇṭako, mahosadha vijānāhi kena thaddho kakaṇṭako. aladdhapubbaṃ laddhānaṃ addhamāsaṃ kakaṇṭako, atimaññati rājānaṃ vedehaṃ mithilaggahanti. ",
  "ja170:1.2": "",
  "ja170:1.3": "",
  "ja170:1.4": "",
  "ja170:2.1": "",
  "ja170:2.2": "",
  "ja170:2.3": "",
  "ja170:2.4": "",
  "ja170:3.1": "",
  "ja170:3.2": "10. kakaṇṭaka jātakaṃ. santhavavaggo dutiyo ",
  "ja170:4.1": "tassuddānaṃ: ",
  "ja170:5.1": "atha indasamānasapaṇṇakuṭi ",
  "ja170:5.2": "susimuttamagijjhajalābujakā, upasāḷhakabhikkhu ",
  "ja170:5.3": "salāpavaro ",
  "ja170:5.4": "atha mentavaro dasa unnamatīti. "
}
