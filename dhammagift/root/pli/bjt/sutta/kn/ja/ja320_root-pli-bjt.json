  "ja320:0.1": "",
  "ja320:0.2": "",
  "ja320:0.3": "",
  "ja320:0.4": "9. tittirajātakaṃ. ",
  "ja320:1.1": "succajaṃ vata naccaji ",
  "ja320:1.2": "vācāya adadaṃ giriṃ, ",
  "ja320:1.3": "kimhi tassaṃ cajantassa ",
  "ja320:1.4": "vācā adada pabbataṃ. ",
  "ja320:2.1": "yaṃ hi kayirā taṃ hi vade ",
  "ja320:2.2": "yaṃ na kayirā na taṃ vade, ",
  "ja320:2.3": "akarontaṃ bhāsamānaṃ ",
  "ja320:2.4": "parijānanti paṇḍitā. ",
  "ja320:3.1": "rājaputta namo tyutthu ",
  "ja320:3.2": "sacce dhamme ṭhitovasi, ",
  "ja320:3.3": "yassa te vyasanaṃ patto ",
  "ja320:3.4": "saccasmiṃ ramate mano. ",
  "ja320:4.1": "yā daḷidadī daḷiddassa ",
  "ja320:4.2": "aḍḍhā aḍḍhassa kittimā, ",
  "ja320:4.3": "sa hissa paramā bhariyā ",
  "ja320:4.4": "sahiraññassa itthiyoti. ",
  "ja320:5.1": "",
  "ja320:5.2": "10. succajajātakaṃ. pucimandavaggo dutiyo ",
  "ja320:6.1": "tassuddānaṃ: ",
  "ja320:7.1": "atha corasakassapakhantivaro ",
  "ja320:7.2": "dujjivitatā ca varāpharusā, ",
  "ja320:7.3": "atha sasamatañca vasantasukhaṃ succajaṃ vata ",
  "ja320:7.4": "naccajitā ca dasa. "
}
