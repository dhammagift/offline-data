{
  "ja361:0.1": "",
  "ja361:0.2": "",
  "ja361:0.3": "2. vaṇṇārohavaggo ",
  "ja361:0.4": "",
  "ja361:1.1": "vaṇṇarohena jātiyā ",
  "ja361:1.2": "balanikkamaṇena ca, ",
  "ja361:1.3": "subāhu na mayā seyyo ",
  "ja361:1.4": "sudāṭha iti bhāsasi. ",
  "ja361:2.1": "vaṇṇarohena jātiyā ",
  "ja361:2.2": "balanikkamaṇena ca, ",
  "ja361:2.3": "sudāṭho na mayā seyyo ",
  "ja361:2.4": "subāhu iti bhāsati. ",
  "ja361:3.1": "evañce maṃ viharantaṃ ",
  "ja361:3.2": "subāhu samma dubbhasi, ",
  "ja361:3.3": "nadānāhaṃ tayā saddhiṃ ",
  "ja361:3.4": "saṃvāsamabhirocaye. ",
  "ja361:4.1": "yo paresaṃ vacanāni ",
  "ja361:4.2": "saddahetha yathātathaṃ, ",
  "ja361:4.3": "khippaṃ bhijjetha mittasmiṃ ",
  "ja361:4.4": "verañca pasave bahuṃ. ",
  "ja361:5.1": "na so mitto yo sadā appamatto ",
  "ja361:5.2": "bhedāsaṅki randhamevānupassī, ",
  "ja361:5.3": "yasmiñca seti urasīva putto ",
  "ja361:5.4": "sa ce mitto yo abhejjo parehīti. ",
  "ja361:6.1": "1. vaṇṇārohajātakaṃ. "
}
