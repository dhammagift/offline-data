  "ja20:1.1": "disvā padamanuttiṇṇaṃ ",
  "ja20:1.2": "disvā notaritaṃ padaṃ, ",
  "ja20:1.3": "naḷena vāriṃ pivissāma ",
  "ja20:1.4": "neva maṃ tvaṃ vadhissasī’ti. ",
  "ja20:2.1": "naḷapānajātakaṃ. ",
  "ja20:2.2": "sīlavaggo dutiyo. ",
  "ja20:3.1": "tassuddānaṃ: ",
  "ja20:4.1": "athalakkhaṇasākhadhiratthupuna nakiratthirasehikharādiyā, ",
  "ja20:4.2": "atibhotirasamālutapāṇa ",
  "ja20:4.3": "muccenanaḷaavhayante ",
  "ja20:4.4": "bhavanti dasa. "
}
