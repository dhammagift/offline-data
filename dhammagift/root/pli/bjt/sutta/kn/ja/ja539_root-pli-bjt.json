  "ja539:127.1": "hitvā sataphalaṃ kaṃsaṃ ",
  "ja539:127.2": "sovaṇṇaṃ satarājikaṃ, ",
  "ja539:127.3": "aggahi mattikāpattaṃ ",
  "ja539:127.4": "taṃ dutiyābhisecanaṃ. ",
  "ja539:128.1": "vesmā aggismā jālā ",
  "ja539:128.2": "kosā ḍayhanti bhāgaso, ",
  "ja539:128.3": "rajataṃ jātarūpañca ",
  "ja539:128.4": "muttā veḷuriyā bahuṃ. ",
  "ja539:129.1": "maraṇayo saṅkhamuttā ca ",
  "ja539:129.2": "vatthikaṃ haricandanaṃ, ",
  "ja539:129.3": "ajinaṃ dantabhaṇḍañca ",
  "ja539:129.4": "lohaṃ kāḷāyasaṃ bahū; ",
  "ja539:129.5": "ehi rāja nivattassu ",
  "ja539:129.6": "mā te taṃ vinasā dhanaṃ. ",
  "ja539:130.1": "susukhaṃ vata jivāma ",
  "ja539:130.2": "yesaṃ no natthi kiñcanaṃ, ",
  "ja539:130.3": "mithilāya ḍayhamānāya ",
  "ja539:130.4": "na me kiñci aḍayhatha. ",
  "ja539:131.1": "aṭaviyo samuppannā ",
  "ja539:131.2": "raṭṭhaṃ viddhaṃsayanti taṃ, ",
  "ja539:131.3": "ehi rāja nivattassu ",
  "ja539:131.4": "mā raṭṭhaṃ vinasā idaṃ. ",
  "ja539:132.1": "susukhaṃ vata jivāma ",
  "ja539:132.2": "yesaṃ no natthi kiñcanaṃ, ",
  "ja539:132.3": "raṭṭhe vilumpamānamhi ",
  "ja539:132.4": "na me kiñci ajīratha. ",
  "ja539:133.1": "susukhaṃ vata jivāma ",
  "ja539:133.2": "yesaṃ no natthi kiñcanaṃ, ",
  "ja539:133.3": "pītibhakkhā bhavissāma ",
  "ja539:133.4": "deva ābhassarā yathā. ",
  "ja539:134.1": "kimbheso mahato ghoso ",
  "ja539:134.2": "kā nu gāme kilīliyā, ",
  "ja539:134.3": "samaṇaññeva pucchāma ",
  "ja539:134.4": "kattheso abhisaṭo jano. ",
  "ja539:135.1": "mamaṃ ohāya gacchantaṃ ",
  "ja539:135.2": "ettheso abhisaṭo jano, ",
  "ja539:135.3": "sīmātikkamanaṃ yantaṃ ",
  "ja539:135.4": "munīmonassa pattiyā; ",
  "ja539:135.5": "missaṃ nandīhi gacchantaṃ ",
  "ja539:135.6": "kiṃ jānamanupucchasi. ",
  "ja539:136.1": "māssu tiṇṇo amaññittho ",
  "ja539:136.2": "sarīraṃ dhārayaṃ imaṃ, ",
  "ja539:136.3": "atīraṇeyyamidaṃ kammaṃ ",
  "ja539:136.4": "bahū hi paripanthayo. ",
  "ja539:137.1": "ko nu me paripanthassa ",
  "ja539:137.2": "mama evaṃ vihārino, ",
  "ja539:137.3": "yo nevadiṭṭhe nādiṭṭhe ",
  "ja539:137.4": "kāmānamabhipatthaye. ",
  "ja539:138.1": "niddā tandī vijambhikā ",
  "ja539:138.2": "aratī bhattasammado, ",
  "ja539:138.3": "āvasanti sarīraṭṭhā ",
  "ja539:138.4": "bahūhi paripanthayo. ",
  "ja539:139.1": "kalyāṇaṃ vata maṃ bhavaṃ ",
  "ja539:139.2": "brāhmaṇamanusāsasi, brāhmaṇaṃ ",
  "ja539:139.3": "yeva pucchāmi ",
  "ja539:139.4": "konu tvamasi mārisa. ",
  "ja539:140.1": "nārado iti me nāmaṃ ",
  "ja539:140.2": "kassapo iti maṃ vidū, ",
  "ja539:140.3": "bhoto sakāse āgañchiṃ ",
  "ja539:140.4": "sādhu sabbhi samāgamo. ",
  "ja539:141.1": "tassa te sabbo ānando ",
  "ja539:141.2": "vihāro upavattatu, ",
  "ja539:141.3": "yadūnaṃ taṃ paripūrehi ",
  "ja539:141.4": "khantiyā upasamena ca. ",
  "ja539:142.1": "pasāraya sannattañca ",
  "ja539:142.2": "unnattañca pasāraya, ",
  "ja539:142.3": "kammaṃ vijjañca dhammañca ",
  "ja539:142.4": "sakkatvāna paribbaja. ",
  "ja539:143.1": "bahūhatthi ca asse ca ",
  "ja539:143.2": "nagare janapadāni ca, ",
  "ja539:143.3": "hitvā janaka pabbajito ",
  "ja539:143.4": "kapalle ratimajjhagā. ",
  "ja539:144.1": "kaccinnu te jānapadā ",
  "ja539:144.2": "mittā maccā ca ñātakamā, dubhiṃ ",
  "ja539:144.3": "akaṃsu janaka ",
  "ja539:144.4": "kasmā cetaṃ aruccatha. ",
  "ja539:145.1": "na migājina jātucca ",
  "ja539:145.2": "ahaṃ kañci kudācanaṃ, ",
  "ja539:145.3": "adhammena jine ñātiṃ ",
  "ja539:145.4": "na cāpi ñātayo mamaṃ. ",
  "ja539:146.1": "disvāna lokavattantaṃ ",
  "ja539:146.2": "khajjantaṃ kaddamikataṃ, ",
  "ja539:146.3": "haññare bajjhare cettha ",
  "ja539:146.4": "yattha satto puthujjano; ",
  "ja539:146.5": "etāhaṃ upamaṃ katvā ",
  "ja539:146.6": "bhikkhakosmi migājina. ",
  "ja539:147.1": "konu te bhagavā satthā ",
  "ja539:147.2": "kassetaṃ vacanaṃ suci ",
  "ja539:147.3": "nahi kappaṃ vā vijjaṃ vā ",
  "ja539:147.4": "paccakkhāya rathesabha: ",
  "ja539:147.5": "samaṇaṃ āhu vattantaṃ ",
  "ja539:147.6": "yathā dukkhassatikkamo. ",
  "ja539:148.1": "na migājina jātucca ",
  "ja539:148.2": "ahaṃ kañci kudācanaṃ, ",
  "ja539:148.3": "samaṇaṃ brāhmaṇaṃ vāpi ",
  "ja539:148.4": "sakkatvā anupāvisiṃ. ",
  "ja539:149.1": "mahatā cānubhāvena ",
  "ja539:149.2": "gacchanto siriyājalaṃ, ",
  "ja539:149.3": "gīyamānesu gītesu ",
  "ja539:149.4": "vajjamānesu vaggusu; ",
  "ja539:150.1": "turiyatāḷitasaṃghuṭṭhe ",
  "ja539:150.2": "sammatālasamāhite. ",
  "ja539:150.3": "samigājina maddakkhiṃ ",
  "ja539:150.4": "phalaṃ ambaṃ tirocchadaṃ, ",
  "ja539:150.5": "tujjamānaṃ manussehi ",
  "ja539:150.6": "phalakāmehi jantuhi. ",
  "ja539:151.1": "so kho hantaṃ siriṃ hitvā ",
  "ja539:151.2": "orohitvā migājina, ",
  "ja539:151.3": "mūlaṃ ambassupāgañchiṃ ",
  "ja539:151.4": "phalino nipphalitassa ca. ",
  "ja539:152.1": "phalaṃ ambaṃ hataṃ disvā ",
  "ja539:152.2": "viddhasataṃ vinalīkataṃ, ",
  "ja539:152.3": "athetaṃ itaraṃ ambaṃ ",
  "ja539:152.4": "nīlobhāsaṃ manoramaṃ. ",
  "ja539:153.1": "evameva nūnamhepi ",
  "ja539:153.2": "issare bahukaṇṭake, ",
  "ja539:153.3": "amittā no vadhissanti ",
  "ja539:153.4": "yathā ambo phalī hato. ",
  "ja539:154.1": "ajinamhi haññate dīpi ",
  "ja539:154.2": "nāgo dantehi haññate, ",
  "ja539:154.3": "dhanamhi dhanino hanti ",
  "ja539:154.4": "aniketamasanthavaṃ; ",
  "ja539:154.5": "phalī ambo aphalo ca ",
  "ja539:154.6": "te satthāro ubho mama. ",
  "ja539:155.1": "sabbo jano pavyadhito ",
  "ja539:155.2": "rājā pabbajito iti, ",
  "ja539:155.3": "hatthārohā anīkaṭṭhā ",
  "ja539:155.4": "rathikā pattikārikā. ",
  "ja539:156.1": "assāsayitvā janataṃ ",
  "ja539:156.2": "ṭhapayitvā paṭicchadaṃ, ",
  "ja539:156.3": "puttaṃ rajje ṭhapetvā ",
  "ja539:156.4": "atha pacchā pabbajissasi. ",
  "ja539:157.1": "vattā mayā jānapadā ",
  "ja539:157.2": "mittāmaccā ca ñātakā, ",
  "ja539:157.3": "santi puttā videhānaṃ ",
  "ja539:157.4": "dīghāvu raṭṭhavaḍḍhano; ",
  "ja539:157.5": "te rajjaṃ kārayissanti ",
  "ja539:157.6": "mithilāyaṃ pajāpati. ",
  "ja539:158.1": "ehi taṃ anusikkhāmi ",
  "ja539:158.2": "yaṃ vākyaṃ mama ruccati, ",
  "ja539:158.3": "rajjaṃ tuvaṃ kārayanti ",
  "ja539:158.4": "pāpaṃ duccaritaṃ bahuṃ: ",
  "ja539:158.5": "kāyena vācā manasā ",
  "ja539:158.6": "yena gañchisi duggatiṃ. ",
  "ja539:159.1": "paradinnakena paraniṭṭhitena, ",
  "ja539:159.2": "piṇḍena yāpehi sadhīradhammo. ",
  "ja539:160.1": "yopi catutthe bhattakāle na bhuñje ",
  "ja539:160.2": "ajaddhumāriva khudāya mīye, ",
  "ja539:160.3": "na tveva piṇḍaṃ lulitaṃ anariyaṃ ",
  "ja539:160.4": "kulaputtarūpo sappuriso na seve ",
  "ja539:160.5": "tayidaṃ na sādhu tayidaṃ na suṭṭhu ",
  "ja539:160.6": "sunakhucchiṭṭhakaṃ bhuñjase tvaṃ. ",
  "ja539:161.1": "na cā pi me sīvali so abhakkho ",
  "ja539:161.2": "yaṃ hoti cattaṃ gihino sunakhassa vā, ",
  "ja539:161.3": "ye keci bhogā idha dhammaladdhā ",
  "ja539:161.4": "sabbo so bhakkho anavajjāti vutto. ",
  "ja539:162.1": "kumārike upaseniye ",
  "ja539:162.2": "niccaṃ nigaḷa maṇḍite, ",
  "ja539:162.3": "kasmā te eko bhujo janati ",
  "ja539:162.4": "eko te na janati bhujo, ",
  "ja539:163.1": "imasmiṃ me samaṇa hatthe ",
  "ja539:163.2": "paṭimukkā dunīdhurā, ",
  "ja539:163.3": "saṅghātā jāyate saddo ",
  "ja539:163.4": "dutiyasseva sā gati. ",
  "ja539:164.1": "imasmiṃ me samaṇā hatthe ",
  "ja539:164.2": "paṭimukko ekanīdhuro, ",
  "ja539:164.3": "so adutiyo na janati ",
  "ja539:164.4": "munibhūtova tiṭṭhati. ",
  "ja539:165.1": "vivādappatto dutiyo ",
  "ja539:165.2": "keneko vivadissati, ",
  "ja539:165.3": "tassa te saggakāmassa ",
  "ja539:165.4": "ekattamuparocataṃ. ",
  "ja539:166.1": "suṇasi sīvalī gāthā ",
  "ja539:166.2": "kumāriyā paveditā, ",
  "ja539:166.3": "pessiyā maṃ garahittho ",
  "ja539:166.4": "dutiyasseva sā gati. ",
  "ja539:167.1": "ayaṃ dvedhā patho bhadde ",
  "ja539:167.2": "anuciṇṇo pathāvihi, ",
  "ja539:167.3": "tesaṃ tvaṃ ekaṃ gaṇhāhi ",
  "ja539:167.4": "ahamekaṃ punāparaṃ. ",
  "ja539:168.1": "neva maṃ tvaṃ “patī me”ti ",
  "ja539:168.2": "māhaṃ “bhariyā” ti vā puna, ",
  "ja539:168.3": "imameva kathaṃ kathayantā ",
  "ja539:168.4": "thūṇaṃ nagarupāgamuṃ. ",
  "ja539:169.1": "koṭṭhake usukārassa ",
  "ja539:169.2": "bhattakāle upaṭṭhite, ",
  "ja539:169.3": "tatra ca so usukāro ",
  "ja539:169.4": "(ekaṃ daṇḍaṃ ujuṃ kataṃ;) ",
  "ja539:169.5": "ekañca cakkhuṃ niggayha ",
  "ja539:169.6": "jimhamekena pekkhati. ",
  "ja539:170.1": "evaṃ no sādhu passasi ",
  "ja539:170.2": "usukāra suṇohi me, ",
  "ja539:170.3": "yadekaṃ cakkhuṃ niggayha ",
  "ja539:170.4": "jibhammekena pekkhasi. ",
  "ja539:171.1": "dvīhi samaṇa cakkhūhi ",
  "ja539:171.2": "visālaṃ viya khāyati, ",
  "ja539:171.3": "asampatvā paraṃ liṅgaṃ ",
  "ja539:171.4": "nujajubhāvāya kappati. ",
  "ja539:172.1": "ekañca cakkhuṃ niggayha ",
  "ja539:172.2": "jimbhamekena pekkhato, ",
  "ja539:172.3": "sampatvā paramaṃ liṅgaṃ ",
  "ja539:172.4": "ujubhāvāya kappati. ",
  "ja539:173.1": "vivādappatto dutiyo ",
  "ja539:173.2": "keneko vivadissati, ",
  "ja539:173.3": "tassa te saggakāmassa ",
  "ja539:173.4": "ekattamuparovataṃ. ",
  "ja539:174.1": "suṇasi sīvali gāthā ",
  "ja539:174.2": "usukāreṇa paveditā, ",
  "ja539:174.3": "pessiyā maṃ garahittho ",
  "ja539:174.4": "dutiyasseva sā gati. ",
  "ja539:175.1": "ayaṃ dvedhā patho bhadde ",
  "ja539:175.2": "anuciṇṇā pathāvihi, ",
  "ja539:175.3": "tesaṃ tvaṃ ekaṃ gaṇhāhi ",
  "ja539:175.4": "ahametaṃ punāparaṃ. ",
  "ja539:176.1": "neva maṃ tvaṃ “pati me”ti ",
  "ja539:176.2": "māhaṃ “bhariyā” ti vā puna, ",
  "ja539:176.3": "muñjāvisikā pavāḷhā ",
  "ja539:176.4": "ekā vihara sīvalī ti. ",
  "ja539:177.1": "mahājanakajātakaṃ dutiyaṃ. "
}
