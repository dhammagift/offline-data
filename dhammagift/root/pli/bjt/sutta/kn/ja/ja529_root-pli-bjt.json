{
  "ja529:0.1": "19. saṭṭhinipāto ",
  "ja529:0.2": "",
  "ja529:0.3": "",
  "ja529:0.4": "1. soṇakajātakaṃ ",
  "ja529:1.1": "kassa sutvā sataṃ dammi ",
  "ja529:1.2": "sahassaṃ daṭṭhu soṇakaṃ, ",
  "ja529:1.3": "ko me soṇaka makkhāti ",
  "ja529:1.4": "sahāyaṃ paṃsukīḷitaṃ. ",
  "ja529:2.1": "atha bravi māṇavako ",
  "ja529:2.2": "daharo pañcacūḷako, ",
  "ja529:2.3": "mayhaṃ sutvā sataṃ dehi ",
  "ja529:2.4": "sahassaṃ daṭṭhu soṇakaṃ ",
  "ja529:2.5": "ahaṃ soṇakamakkhissaṃ ",
  "ja529:2.6": "sahāyaṃ paṃsukīḷitaṃ ",
  "ja529:3.1": "katarasmiṃ so janapade ",
  "ja529:3.2": "raṭṭhesu nigamesu ca, ",
  "ja529:3.3": "kattha te soṇako diṭṭho ",
  "ja529:3.4": "taṃ me akkhāhi pucchito. ",
  "ja529:4.1": "taveva deva vijite ",
  "ja529:4.2": "tavecuyyānabhūmiyā, ",
  "ja529:4.3": "ujuvaṃsā mahāsālā ",
  "ja529:4.4": "nīlobhāsā manoramā ",
  "ja529:5.1": "tiṭṭhanti meghasamānā ",
  "ja529:5.2": "rammā aññoññanissitā. ",
  "ja529:5.3": "tesaṃ mūlasmiṃ soṇako ",
  "ja529:5.4": "jhāyati anupādano, ",
  "ja529:5.5": "upādānesu lokesu ",
  "ja529:5.6": "dayhamānesu nibbuto. ",
  "ja529:6.1": "tato ca rājā pāyāsi ",
  "ja529:6.2": "senāya caturaṅgiyā, ",
  "ja529:6.3": "kārāpetvā samaṃ maggaṃ ",
  "ja529:6.4": "agamā yena soṇako. ",
  "ja529:7.1": "uyyānabhūmiṃ gantvāna ",
  "ja529:7.2": "vicaranto brahāvane, ",
  "ja529:7.3": "āsīnaṃ soṇakaṃ dakkhi ",
  "ja529:7.4": "dayhamānesu nibbutaṃ ",
  "ja529:8.1": "kapaṇovatāyaṃ bhikkhu ",
  "ja529:8.2": "muṇḍo saṅghāṭipāruto, ",
  "ja529:8.3": "amātiko apitiko ",
  "ja529:8.4": "rukkhamūlasmiṃ jhāyati. ",
  "ja529:9.1": "imaṃ vākyaṃ nisāmetvā ",
  "ja529:9.2": "soṇako etadabravi, ",
  "ja529:9.3": "na rājā kapaṇo hoti ",
  "ja529:9.4": "dhammaṃ kāyena phassayaṃ. ",
  "ja529:10.1": "yodha dhammaṃ niraṃkatvā ",
  "ja529:10.2": "adhammamanuvattati, ",
  "ja529:10.3": "sa rāja kapaṇo hoti ",
  "ja529:10.4": "pāpo pāpaparāyano. ",
  "ja529:11.1": "arindamoti me nāmaṃ ",
  "ja529:11.2": "kāsirājāti maṃ vidū, ",
  "ja529:11.3": "kacci bhoto sukhaseyyā ",
  "ja529:11.4": "idha pattassa soṇaka. ",
  "ja529:12.1": "sadāpi bhadramadhanassa ",
  "ja529:12.2": "anāgārassa bhikkhuno, ",
  "ja529:12.3": "na tesaṃ koṭṭhe openti ",
  "ja529:12.4": "na kumbhiṃ na kaḷopiyaṃ ",
  "ja529:12.5": "paraniṭṭhitamesānā ",
  "ja529:12.6": "tena yāpenti subbatā. ",
  "ja529:13.1": "dutiyampi bhadramadhanassa ",
  "ja529:13.2": "anāgārassa bhikkhuno, ",
  "ja529:13.3": "anavajjapiṇḍo bhottabbo ",
  "ja529:13.4": "na ca kocūparodhati. ",
  "ja529:14.1": "tatiyampi bhadramadhanassa ",
  "ja529:14.2": "anāgārassa bhikkhuno, ",
  "ja529:14.3": "nibbutapiṇḍo bhottabbo ",
  "ja529:14.4": "na ca kocūparodhati. ",
  "ja529:15.1": "catutthampi bhadramadhanassa ",
  "ja529:15.2": "anāgārassa bhikkhuno, ",
  "ja529:15.3": "muttassa raṭṭhe carato ",
  "ja529:15.4": "saṅgho yassa na vijjati. ",
  "ja529:16.1": "pañcamampi bhadramadhanassa ",
  "ja529:16.2": "anāgārassa bhikkhuno, ",
  "ja529:16.3": "nagaramhi dayhamānamhi ",
  "ja529:16.4": "nāssa kiñci adayhatha. ",
  "ja529:17.1": "chaṭṭhampi bhadramadhanassa ",
  "ja529:17.2": "anāgārassa bhikkhuno, ",
  "ja529:17.3": "raṭṭhe vilumpamānamhi ",
  "ja529:17.4": "nāssa kiñci ahāratha. ",
  "ja529:18.1": "sattamampi bhadramadhanassa ",
  "ja529:18.2": "anāgārassa bhikkhuno, ",
  "ja529:18.3": "corehi rakkhitaṃ maggaṃ ",
  "ja529:18.4": "ye caññe paripanthikā ",
  "ja529:18.5": "pattacīvaramādāya ",
  "ja529:18.6": "sotthiṃ gacchati subbato. ",
  "ja529:19.1": "aṭṭhamampi bhadramadhanassa ",
  "ja529:19.2": "anāgārassa bhikkhuno, ",
  "ja529:19.3": "yaṃ yaṃ disaṃ pakkamati ",
  "ja529:19.4": "anapekkhova gacchati. ",
  "ja529:20.1": "bahūni samaṇabhadrāni ",
  "ja529:20.2": "ye tvaṃ bhikkhu pasaṃsasi, ",
  "ja529:20.3": "ahañca giddho kāmesu ",
  "ja529:20.4": "kathaṃ kāhāmi soṇaka ",
  "ja529:21.1": "piyā me mānusā kāmā ",
  "ja529:21.2": "atho dibyāpi me piyā, ",
  "ja529:21.3": "atha kena nu vaṇṇena ",
  "ja529:21.4": "abho loke labhambhase. ",
  "ja529:22.1": "kāmesu giddhā kāmaratā ",
  "ja529:22.2": "kāmesu adhimucchitā, ",
  "ja529:22.3": "narā pāpāni katvāna ",
  "ja529:22.4": "upapajjanti duggatiṃ. ",
  "ja529:23.1": "ye ca kāme pahatvāna ",
  "ja529:23.2": "nikkhantā akutobhayā, ",
  "ja529:23.3": "ekodibhāvādhigatā ",
  "ja529:23.4": "na te gacchanti duggatiṃ. ",
  "ja529:24.1": "upamante karissāmi ",
  "ja529:24.2": "taṃ suṇohi arindama, ",
  "ja529:24.3": "upamāyapidhekacce ",
  "ja529:24.4": "atthaṃ jānanti paṇḍitā. ",
  "ja529:25.1": "gaṅgāya kuṇapaṃ disvā ",
  "ja529:25.2": "vuyhamānaṃ mahaṇṇave, ",
  "ja529:25.3": "vāyaso samacintesi ",
  "ja529:25.4": "appapañño acetaso. ",
  "ja529:26.1": "yānañca vatidaṃ laddhaṃ ",
  "ja529:26.2": "bhakkhovāyaṃ anappako, ",
  "ja529:26.3": "tattha rattiṃ tattha divā ",
  "ja529:26.4": "tattheva nirato mano. ",
  "ja529:27.1": "khādaṃ nāgassa maṃsāni ",
  "ja529:27.2": "pivaṃ bhāgīrathodakaṃ, ",
  "ja529:27.3": "sampassaṃ vanacetyāni ",
  "ja529:27.4": "na palettha vihaṅgamo. ",
  "ja529:28.1": "tañca otaraṇī gaṅgā ",
  "ja529:28.2": "pamattaṃ kuṇape rataṃ, ",
  "ja529:28.3": "samuddaṃ ajjhagāhāsi ",
  "ja529:28.4": "agatī yattha pakkhinaṃ. ",
  "ja529:29.1": "so ca bhakkhaparikkhīṇo ",
  "ja529:29.2": "uppatitvā vihaṅgamo, ",
  "ja529:29.3": "na pacchato na purato ",
  "ja529:29.4": "nuttaraṃ nopi dakkhiṇaṃ. ",
  "ja529:30.1": "dīpaṃ so na ajjhagañchi ",
  "ja529:30.2": "agatī yattha pakkhinaṃ, ",
  "ja529:30.3": "so ca tattheva pāpattha ",
  "ja529:30.4": "yathā dubbalako tathā. ",
  "ja529:31.1": "tañca sāmuddikā macchā ",
  "ja529:31.2": "kumbhīlā makarā susu, ",
  "ja529:31.3": "pasayhakārā khādiṃsu ",
  "ja529:31.4": "phandamānaṃ vipakkhinaṃ. ",
  "ja529:32.1": "evameva tuvaṃ rāja ",
  "ja529:32.2": "ye caññe kāmabhogino, ",
  "ja529:32.3": "giddhā ce na vamissanti ",
  "ja529:32.4": "kākapaññāya te vidū. ",
  "ja529:33.1": "esā te upamā rāja ",
  "ja529:33.2": "atthasandassanī katā, ",
  "ja529:33.3": "tvaṃ ca paññāyase tena ",
  "ja529:33.4": "yadi kāhasi vā na vā. ",
  "ja529:34.1": "ekavācampi dve vācaṃ ",
  "ja529:34.2": "bhaṇeyya anukampako, ",
  "ja529:34.3": "tatuttariṃ na bhāseyya ",
  "ja529:34.4": "dāso vayyassa santike. ",
  "ja529:35.1": "idaṃ vatvāna pakkāmi ",
  "ja529:35.2": "soṇako amitabuddhimā, ",
  "ja529:35.3": "vehāse antalikkhasmiṃ ",
  "ja529:35.4": "anusāsitvāna khattiyaṃ. ",
  "ja529:36.1": "ko nu me rājakattāro ",
  "ja529:36.2": "sutā ceyyattimāgatā, ",
  "ja529:36.3": "rajjaṃ niyyādayissāmi ",
  "ja529:36.4": "nāhaṃ rajjenamatthiko. ",
  "ja529:37.1": "ajjeva pabbajissāmi ",
  "ja529:37.2": "ko jaññā maraṇaṃ suve, ",
  "ja529:37.3": "māhaṃ kākova dummedho ",
  "ja529:37.4": "kāmānaṃ vasamanvagaṃ. ",
  "ja529:38.1": "atthi te daharo putto ",
  "ja529:38.2": "dīghāvu raṭṭhavaḍḍhano, ",
  "ja529:38.3": "taṃ rajje abhisiñcassu ",
  "ja529:38.4": "so no rājā bhavissati. ",
  "ja529:39.1": "khippaṃ kumāraṃ ānetha ",
  "ja529:39.2": "dīghāvuṃ raṭṭhavaḍḍhanaṃ, ",
  "ja529:39.3": "taṃ rājje abhisiñcissaṃ ",
  "ja529:39.4": "so vo rājā bhavissati. ",
  "ja529:40.1": "tato kumāraṃ ānesuṃ ",
  "ja529:40.2": "dīghāvuṃ raṭṭhavaḍḍhanaṃ, ",
  "ja529:40.3": "taṃ disvā ālapi rājā ",
  "ja529:40.4": "ekaputtaṃ manoramaṃ. ",
  "ja529:41.1": "saṭṭhi gāmasahassāni ",
  "ja529:41.2": "paripuṇṇāni sabbaso, ",
  "ja529:41.3": "te putta paṭipajjassu ",
  "ja529:41.4": "rajjaṃ niyyādayāmi te. ",
  "ja529:42.1": "ajjeva pabbajissāmi ",
  "ja529:42.2": "ko jaññā maraṇaṃ suve, ",
  "ja529:42.3": "māhaṃ kākova dummedho ",
  "ja529:42.4": "kāmānaṃ vasamanvagaṃ. ",
  "ja529:43.1": "saṭṭhināgasahassāni ",
  "ja529:43.2": "sabbālaṅkārabhūsitā, ",
  "ja529:43.3": "suvaṇṇakacchā mātaṅgā ",
  "ja529:43.4": "hemakappanavāsasā. ",
  "ja529:44.1": "ārūḷhā gāmaṇīyehi ",
  "ja529:44.2": "tomaraṅkusapāṇihi, ",
  "ja529:44.3": "te putta paṭipajjassu ",
  "ja529:44.4": "rajjaṃ niyyādayāmi te. ",
  "ja529:45.1": "ajjeva pabbajissāmi ",
  "ja529:45.2": "ko jaññā maraṇaṃ suve, ",
  "ja529:45.3": "māhaṃ kākova dummedho ",
  "ja529:45.4": "kāmānaṃ vasamanvagaṃ. ",
  "ja529:46.1": "saṭṭhiassasahassāni ",
  "ja529:46.2": "sabbālaṅkārabhūsitā, ",
  "ja529:46.3": "ājānīyā ca jātiyā ",
  "ja529:46.4": "sindhavā sīghavāhanā. ",
  "ja529:47.1": "ārūḷhā gāmaṇīyehi ",
  "ja529:47.2": "illiyācāpadhārihi, ",
  "ja529:47.3": "te putta paṭipajjassu ",
  "ja529:47.4": "rajjaṃ niyyādayāmi te. ",
  "ja529:48.1": "ajjeva pabbajissāmi ",
  "ja529:48.2": "ko jaññā maraṇaṃ suve, ",
  "ja529:48.3": "māhaṃ kākova dummedho ",
  "ja529:48.4": "kāmānaṃ vasamanvagaṃ. ",
  "ja529:49.1": "saṭṭhirathasahassāni ",
  "ja529:49.2": "sannaddhā ussitaddhajā, ",
  "ja529:49.3": "dīpā athopi veyyagghā ",
  "ja529:49.4": "sabbālaṅkārabhūsitā. ",
  "ja529:50.1": "ārūḷhā gāmaṇīyehi ",
  "ja529:50.2": "cāpahatthehi vammihi, ",
  "ja529:50.3": "te putta paṭipajjassu ",
  "ja529:50.4": "rajjaṃ niyyādayāmi te. ",
  "ja529:51.1": "ajjeva pabbajissāmi ",
  "ja529:51.2": "ko jaññā maraṇaṃ suve, ",
  "ja529:51.3": "māhaṃ kākova dummedho ",
  "ja529:51.4": "kāmānaṃ vasamanvagaṃ. ",
  "ja529:52.1": "saṭṭhidhenusahassāni ",
  "ja529:52.2": "rohaññā puṅgavūsabhā, ",
  "ja529:52.3": "tā putta paṭipajjassu ",
  "ja529:52.4": "rajjaṃ niyyādayāmi te. ",
  "ja529:53.1": "ajjeva pabbajissāmi ",
  "ja529:53.2": "ko jaññā maraṇaṃ suve, ",
  "ja529:53.3": "māhaṃ kākova dummedho ",
  "ja529:53.4": "kāmānaṃ vasamanvagaṃ. ",
  "ja529:54.1": "soḷasitthisahassāni ",
  "ja529:54.2": "sabbālaṅkārabhūsitā, ",
  "ja529:54.3": "vicitravatthābharaṇā ",
  "ja529:54.4": "āmuttamaṇikuṇḍalā ",
  "ja529:54.5": "tā putta paṭipajjassu ",
  "ja529:54.6": "rajjaṃ niyyādayāmi te. ",
  "ja529:55.1": "ajjeva pabbajissāmi ",
  "ja529:55.2": "ko jaññā maraṇaṃ suve, ",
  "ja529:55.3": "māhaṃ kākova dummedho ",
  "ja529:55.4": "kāmānaṃ vasamanvagaṃ. ",
  "ja529:56.1": "daharasseva me tāta ",
  "ja529:56.2": "mātā matāti me sutaṃ, ",
  "ja529:56.3": "tayā vinā ahaṃ tāta ",
  "ja529:56.4": "jīvitumpi na ussahe. ",
  "ja529:57.1": "yathā āraññakaṃ nāgaṃ ",
  "ja529:57.2": "poto anveti pacchato, ",
  "ja529:57.3": "jessantaṃ giriduggesu ",
  "ja529:57.4": "samesu visamesu ca. ",
  "ja529:58.1": "evaṃ taṃ anugacchāmi ",
  "ja529:58.2": "puttamādāya gacchato, ",
  "ja529:58.3": "subharo te bhavissāmi ",
  "ja529:58.4": "na te hessāmi dubbharo. ",
  "ja529:59.1": "yathā sāmuddikaṃ nāvaṃ ",
  "ja529:59.2": "vāṇijānaṃ dhanesinaṃ, ",
  "ja529:59.3": "vohāro tattha gaṇheyya ",
  "ja529:59.4": "vāṇijā byasanī siyā ",
  "ja529:60.1": "evameva puttakali ",
  "ja529:60.2": "antarāyakaro mama. ",
  "ja529:60.3": "imaṃ kumāraṃ pāpetha ",
  "ja529:60.4": "pāsādaṃ rativaḍḍhanaṃ, ",
  "ja529:61.1": "tattha kambusahatthāyo ",
  "ja529:61.2": "yathā sakkaṃva accharā ",
  "ja529:61.3": "tā naṃ tattha ramessanti ",
  "ja529:61.4": "tāhi ceso ramissati. ",
  "ja529:62.1": "tato kumāraṃ pāpesuṃ ",
  "ja529:62.2": "pāsādaṃ rativaḍḍhanaṃ, ",
  "ja529:62.3": "taṃ disvā avacuṃ kaññā ",
  "ja529:62.4": "dīghāvuṃ raṭṭhavaḍḍhanaṃ. ",
  "ja529:63.1": "devatānusi gandhabbo ",
  "ja529:63.2": "ādu sakko purindado, ",
  "ja529:63.3": "ko vā tvaṃ kassa vā putto ",
  "ja529:63.4": "kathaṃ jānemu taṃ mayaṃ. ",
  "ja529:64.1": "namhi devo na gandhabbo ",
  "ja529:64.2": "napi sakko purindado, ",
  "ja529:64.3": "kāsi rañño ahaṃ putto ",
  "ja529:64.4": "dīghāvu raṭṭhavaḍḍhano ",
  "ja529:64.5": "mamaṃ bharatha bhaddaṃ vo ",
  "ja529:64.6": "ahaṃ bhattā bhavāmi vo. ",
  "ja529:65.1": "taṃ tattha avacuṃ kaññā ",
  "ja529:65.2": "dīghāvuṃ raṭṭhavaḍḍhanaṃ, ",
  "ja529:65.3": "kuhiṃ rājā anuppatto ",
  "ja529:65.4": "ito rājā kuhiṃ gato. ",
  "ja529:66.1": "paṅkaṃ rājā atikkanto ",
  "ja529:66.2": "thale rājā patiṭṭhito, ",
  "ja529:66.3": "akaṇṭakaṃ agahanaṃ ",
  "ja529:66.4": "paṭipanno mahāpathaṃ. ",
  "ja529:67.1": "ahañca paṭipannosmi ",
  "ja529:67.2": "maggaṃ duggatigāminaṃ, ",
  "ja529:67.3": "sakaṇṭakaṃ sagahanaṃ ",
  "ja529:67.4": "yena gacchanti duggatiṃ. ",
  "ja529:68.1": "tassa te svāgataṃ rājā ",
  "ja529:68.2": "sīhassova giribbajaṃ, ",
  "ja529:68.3": "anusāsa mahārāja ",
  "ja529:68.4": "tvaṃ no sabbāsamissaroti. ",
  "ja529:69.1": "soṇakajātakaṃ. "
}
