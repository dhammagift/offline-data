  "ja524:0.1": "",
  "ja524:0.2": "",
  "ja524:0.3": "",
  "ja524:0.4": "4. saṅkhapālajātakaṃ. ",
  "ja524:1.1": "ariyāvakāsopi pasannanetto ",
  "ja524:1.2": "maññe bhavaṃ pabbajito kulambhā, ",
  "ja524:1.3": "kathannu cittāni pahāya bhoge ",
  "ja524:1.4": "pabbaji nikkhamma gharā sapañña. ",
  "ja524:2.1": "sayaṃ vimānaṃ naradeva disvā ",
  "ja524:2.2": "mahānubhāvassa mahoragassa, ",
  "ja524:2.3": "disvāna puññāna mahāvipākaṃ ",
  "ja524:2.4": "saddhāyahaṃ pabbajitomhi rāja. ",
  "ja524:3.1": "na kāmakāmā na bhayā na dosā ",
  "ja524:3.2": "vācaṃ musā pabbajitā bhaṇanti, ",
  "ja524:3.3": "akkhāhi me pucchito etamatthaṃ ",
  "ja524:3.4": "sutvāna me jāyihitippasādo. ",
  "ja524:4.1": "vāṇijja raṭṭhādhipa gacchamāno ",
  "ja524:4.2": "pathe addasāsimhi milācaputte, ",
  "ja524:4.3": "pavaḍḍhakāyaṃ uragaṃ mahantaṃ ",
  "ja524:4.4": "ādāya gacchante pamodamāne. ",
  "ja524:5.1": "sohaṃ samāgamma janinda tehi ",
  "ja524:5.2": "saṃhaṭṭhalomo avacasmiṃ bhīto, ",
  "ja524:5.3": "kuhiṃ ayaṃ nīyati bhīmakāyo ",
  "ja524:5.4": "nāgena kiṃ kāhatha bhojaputtā. ",
  "ja524:6.1": "nāgo ayaṃ nīyati bhojanatthaṃ ",
  "ja524:6.2": "pavaḍḍhakāyo urago mahanto, ",
  "ja524:6.3": "sāduñca thūlañca muduñca maṃsaṃ ",
  "ja524:6.4": "na tvaṃ rasaññāsi videhaputta. ",
  "ja524:7.1": "ito mayaṃ gantvā sakaṃ niketaṃ ",
  "ja524:7.2": "ādāya satthāni vikopayitvā, ",
  "ja524:7.3": "maṃsāni bhokkhāma pamodamānā ",
  "ja524:7.4": "mayaṃ hi ve sattavo pannagānaṃ. ",
  "ja524:8.1": "sace ayaṃ nīyati bhojanatthaṃ ",
  "ja524:8.2": "pavaḍḍhakāyo urago mahanto, ",
  "ja524:8.3": "dadāmi vo balivaddāni soḷasa ",
  "ja524:8.4": "nāgaṃ imaṃ muñcatha bandhanasmā. ",
  "ja524:9.1": "addhā hi no bhakkho ayaṃ manāpo ",
  "ja524:9.2": "bahū ca no uragā bhuttapubbā, ",
  "ja524:9.3": "karoma te taṃ vacanaṃ aḷāra ",
  "ja524:9.4": "mittañca no hohi videhaputta. ",
  "ja524:10.1": "tadassu te bandhanā mocayiṃsu ",
  "ja524:10.2": "yaṃ natthuto paṭimokkhassa pāse, ",
  "ja524:10.3": "mutto ca so bandhanā nāgarājā ",
  "ja524:10.4": "pakkāmi pācīnamukho muhuttaṃ ",
  "ja524:11.1": "gantvāna pācīnamukho muhuttaṃ ",
  "ja524:11.2": "puṇṇehi nettehi palokayī maṃ, ",
  "ja524:11.3": "tadassahaṃ piṭṭhito anvagacchiṃ ",
  "ja524:11.4": "dasaṅguliṃ añjaliṃ paggahetvā. ",
  "ja524:12.1": "gaccheva kho tvaṃ taramānarūpo ",
  "ja524:12.2": "mā taṃ amittā punaraggahesuṃ, ",
  "ja524:12.3": "dukkho hi luddehi punā samāgamo ",
  "ja524:12.4": "adassanaṃ bhojaputtāna gaccha. ",
  "ja524:13.1": "agamāsi so rahadaṃ vippasannaṃ ",
  "ja524:13.2": "nīlobhāsaṃ ramaṇīyaṃ sutitthaṃ, ",
  "ja524:13.3": "samotataṃ jambūhi cetasāhi ",
  "ja524:13.4": "pāvekkhi nittiṇṇabhayo patīto ",
  "ja524:14.1": "so taṃ pavissa na cirassa nāgo ",
  "ja524:14.2": "dibbena me pāturahū janinda, ",
  "ja524:14.3": "upaṭṭhahi maṃ pitaraṃ va putto ",
  "ja524:14.4": "hadayaṅgamaṃ kaṇṇasukhaṃ bhaṇanto ",
  "ja524:15.1": "tvaṃmesi mātā ca pitā aḷāra ",
  "ja524:15.2": "abbhantaro pāṇadado sahāyo, ",
  "ja524:15.3": "sakañca iddhiṃ paṭilābhitosmi ",
  "ja524:15.4": "aḷāra passa me nivesanāni ",
  "ja524:15.5": "pahūtabhakkhaṃ bahu annapānaṃ ",
  "ja524:15.6": "masakkasāraṃ viya vāsavassa. ",
  "ja524:16.1": "taṃ bhūmibhāgehi upetarūpaṃ ",
  "ja524:16.2": "asakkharā ceva mudū subhā ca, ",
  "ja524:16.3": "nīcatiṇā apparajā ca bhūmi ",
  "ja524:16.4": "pāsādikā yattha jahanti sokaṃ. ",
  "ja524:17.1": "anāvakūlā veḷuriyūpanīlā ",
  "ja524:17.2": "cātuddisaṃ ambavanaṃ surammaṃ, ",
  "ja524:17.3": "pakkā ca pesī ca phalā suphullā ",
  "ja524:17.4": "niccotukā dhārayantī phalāni ",
  "ja524:18.1": "tesaṃ vanānaṃ naradeva majjhe ",
  "ja524:18.2": "nivesanaṃ bhassarasannikāsaṃ, ",
  "ja524:18.3": "rajataggaḷaṃ soṇṇamayaṃ uḷāraṃ ",
  "ja524:18.4": "pabhāsati vijjurivantalikkhe. ",
  "ja524:19.1": "maṇimayā sovaṇṇamayā uḷārā ",
  "ja524:19.2": "anekacittā satataṃ sunimmitā, ",
  "ja524:19.3": "paripūrā kaññāhi alaṅkatāhi ",
  "ja524:19.4": "sovaṇṇakāyūradharāhi rāja. ",
  "ja524:20.1": "so saṅkhapālo taramānarūpo ",
  "ja524:20.2": "pāsādamāruyha anomavaṇṇo, ",
  "ja524:20.3": "sahassathambhaṃ atulānubhāvaṃ ",
  "ja524:20.4": "yatthassa bhariyā mahesī ahosi. ",
  "ja524:21.1": "ekā ca nārī taramānarūpā ",
  "ja524:21.2": "ādāya veḷuriyamayaṃ mahagghaṃ, ",
  "ja524:21.3": "subhaṃ maṇiṃ jātimantūpapannaṃ ",
  "ja524:21.4": "acoditā āsanamabbhibhāsi. ",
  "ja524:22.1": "tato maṃ urago hatthe gahetvā ",
  "ja524:22.2": "nisīdayī pamukhamāsanasmiṃ, ",
  "ja524:22.3": "idamāsanaṃ atra bhavaṃ nisīdatu ",
  "ja524:22.4": "bhavañhi me aññataro garūnaṃ. ",
  "ja524:23.1": "aññā ca nārī taramānarūpā ",
  "ja524:23.2": "ādāya vāriṃ upasaṅkamitvā, ",
  "ja524:23.3": "pādāni pakkhālayi me janinda ",
  "ja524:23.4": "bhariyāva bhattu patino piyassa. ",
  "ja524:24.1": "aparā ca nārī taramānarūpā ",
  "ja524:24.2": "paggayha sovaṇṇamayāya pātiyā, ",
  "ja524:24.3": "anekasūpaṃ vividhaṃ viyañjanaṃ ",
  "ja524:24.4": "upanāmayi bhatta manuññarūpaṃ. ",
  "ja524:25.1": "turiyehi maṃ bhārata bhuttabhattaṃ ",
  "ja524:25.2": "upaṭṭhahuṃ bhattu mano viditvā, ",
  "ja524:25.3": "tatuttariṃ maṃ nipatī mahantaṃ ",
  "ja524:25.4": "dibbehi kāmehi anappakehi. ",
  "ja524:26.1": "bhariyā mametā tisatā aḷāra ",
  "ja524:26.2": "sabbattamajjhā padumuttarābhā, ",
  "ja524:26.3": "āḷāra etāsu te kāmakāro ",
  "ja524:26.4": "dadāmi te tā paricārayassu ",
  "ja524:27.1": "saṃvaccharaṃ dibbarasānubhutvā ",
  "ja524:27.2": "tadassahaṃ uttariṃ paccabhāsiṃ, ",
  "ja524:27.3": "nāgassidaṃ kinti kathañca laddhaṃ ",
  "ja524:27.4": "kathajjhagamāsi vimānaseṭṭhaṃ. ",
  "ja524:28.1": "adhiccaladdhaṃ pariṇāmajante sayaṃ ",
  "ja524:28.2": "kataṃ udāhu devehi dinnaṃ, ",
  "ja524:28.3": "pucchāmi taṃ nāgarāje tamatthaṃ ",
  "ja524:28.4": "kathajjhagamāsi vimānaseṭṭhaṃ. ",
  "ja524:29.1": "nādhiccaladdhaṃ na pariṇāmajaṃ me ",
  "ja524:29.2": "na sayaṃ kataṃ napi devehi dinnaṃ, ",
  "ja524:29.3": "sakehi kammehi apāpakehi ",
  "ja524:29.4": "puññehi me laddhamidaṃ vimānaṃ. ",
  "ja524:30.1": "kinte vataṃ kiṃ pana brahmacariyaṃ ",
  "ja524:30.2": "kissa suciṇṇassa ayaṃ vipāko, ",
  "ja524:30.3": "akkhāhi me nāgarājetamatthaṃ ",
  "ja524:30.4": "kathannu te laddhamidaṃ vimānaṃ. ",
  "ja524:31.1": "rājā ahosiṃ magadhānamissaro ",
  "ja524:31.2": "duyyodhano nāma mahānubhāvo, ",
  "ja524:31.3": "so ittaraṃ jīvitaṃ saṃviditvā ",
  "ja524:31.4": "asassataṃ vipariṇāmadhammaṃ. ",
  "ja524:32.1": "annañca pānañca pasannacitto ",
  "ja524:32.2": "sakkacca dānaṃ vipulaṃ adāsiṃ ",
  "ja524:32.3": "opānabhūtaṃ me gharaṃ tadāsi ",
  "ja524:32.4": "santappitā samaṇabrāhmaṇā ca. ",
  "ja524:33.1": "mālañca gandhañca vilepanañca ",
  "ja524:33.2": "padīpiyaṃ yānamupassayañca, ",
  "ja524:33.3": "acchādanaṃ sayanamathannapānaṃ ",
  "ja524:33.4": "sakkacca dānāni adamha tattha. ",
  "ja524:34.1": "taṃ me vataṃ taṃ pana brahmacariyaṃ ",
  "ja524:34.2": "tassa suciṇṇassa ayaṃ vipāko, ",
  "ja524:34.3": "teneva me laddhamidaṃ vimānaṃ ",
  "ja524:34.4": "pahūtabhakkhaṃ bahuannapānaṃ ",
  "ja524:34.5": "naccehi gītehi cupetarūpaṃ ",
  "ja524:34.6": "ciraṭṭhitikaṃ na ca sassatāyaṃ. ",
  "ja524:35.1": "appānubhāvā taṃ mahānubhāvaṃ ",
  "ja524:35.2": "tejassinaṃ hanti atejavanto, ",
  "ja524:35.3": "kimeva dāṭhāvudha kiṃ paṭicca ",
  "ja524:35.4": "hatthattha māgañchi vaṇibbakānaṃ. ",
  "ja524:36.1": "bhayannu te anvagataṃ mahantaṃ ",
  "ja524:36.2": "tejonu te nānvagaṃ dantamūlaṃ, ",
  "ja524:36.3": "kimeva dāṭhāvudha kiṃ paṭicca ",
  "ja524:36.4": "kilesamāpajji vaṇibbakānaṃ. ",
  "ja524:37.1": "na me bhayaṃ anvagataṃ mahantaṃ ",
  "ja524:37.2": "tejo na sakkā mama tehi hantuṃ, ",
  "ja524:37.3": "satañca dhammāni sukittitāni ",
  "ja524:37.4": "samuddavelāva duraccayāni. ",
  "ja524:38.1": "cātuddasiṃ pañcadasiṃ ca’ḷāra ",
  "ja524:38.2": "uposathaṃ niccamupāvasāmi, ",
  "ja524:38.3": "athāgamuṃ soḷasa bhojaputtā ",
  "ja524:38.4": "rajjuṃ gahetvāna daḷhañca pāsaṃ. ",
  "ja524:39.1": "bhetvāna tāsaṃ atikassa rajjuṃ ",
  "ja524:39.2": "nayiṃsu maṃ samparigayha luddā, ",
  "ja524:39.3": "etādisaṃ dukkhamahaṃ titikkhaṃ ",
  "ja524:39.4": "uposathaṃ appaṭikopayanto. ",
  "ja524:40.1": "ekāyane taṃ pathe addasaṃsu ",
  "ja524:40.2": "balena vaṇṇena cu’petarūpaṃ, ",
  "ja524:40.3": "siriyā ca paññāya ca bhāvitosi ",
  "ja524:40.4": "kimatthiyaṃ nāga tapo karosi. ",
  "ja524:41.1": "na putatahetu na dhanassa hetu ",
  "ja524:41.2": "na āyuno cāpi aḷāra hetu, ",
  "ja524:41.3": "manussayoniṃ abhipatthayāno ",
  "ja524:41.4": "tasmā parakkamma tapo karomi. ",
  "ja524:42.1": "tvaṃ lohitakkho vihatantaraṃso ",
  "ja524:42.2": "alaṅkato kappitakesamassu, ",
  "ja524:42.3": "surosito lohitacandanena ",
  "ja524:42.4": "gandhabbarājāva disā pabhāssi. ",
  "ja524:43.1": "deviddhipattosi mahānubhāvo ",
  "ja524:43.2": "sabbehi kāmehi samaṅgibhūto, ",
  "ja524:43.3": "pucchāmi taṃ nāgarājetamatthaṃ ",
  "ja524:43.4": "seyyo ito kena manussaloko. ",
  "ja524:44.1": "āḷāra nāññatra manussalokā ",
  "ja524:44.2": "suddhi vi saṃvijjati saññamo vā, ",
  "ja524:44.3": "ahañca laddhāna manussayoniṃ ",
  "ja524:44.4": "kāhāmi jātimaraṇassa antaṃ. ",
  "ja524:45.1": "saṃvaccharo me usito tavantike ",
  "ja524:45.2": "annena pānena upaṭṭhitosmi, ",
  "ja524:45.3": "āmantayitvāna paḷemi nāga ",
  "ja524:45.4": "cirappavutthosmi ahaṃ janinda. ",
  "ja524:46.1": "puttā ca dārā ca‘nujivino ca ",
  "ja524:46.2": "niccānusiṭṭhā upatiṭṭhate taṃ, ",
  "ja524:46.3": "kaccinnu te nābhisaṃsittha koci ",
  "ja524:46.4": "piyañhi me dassanaṃ tuyhaḷāra. ",
  "ja524:47.1": "yathāpi mātu ca pitu agāre ",
  "ja524:47.2": "putto piyo paṭivihito vaseyya, ",
  "ja524:47.3": "tatopi mayhaṃ idha meva seyyo ",
  "ja524:47.4": "cittaṃ hi te nāga mayi pasannaṃ. ",
  "ja524:48.1": "maṇī mamaṃ vijjati lohitaṅko ",
  "ja524:48.2": "dhanāharo maṇiratanaṃ uḷāraṃ, ",
  "ja524:48.3": "ādāya taṃ gaccha sakaṃ niketaṃ ",
  "ja524:48.4": "laddhā dhanaṃ taṃ maṇimossajassu. ",
  "ja524:49.1": "diṭṭhā mayā mānusikāpi kāmā ",
  "ja524:49.2": "asassatā vipariṇāmadhammā, ",
  "ja524:49.3": "ādīnavaṃ kāmaguṇesu disvā ",
  "ja524:49.4": "saddhāyahaṃ pabbajitomhi rāja. ",
  "ja524:50.1": "dumapphalāneva patanti māṇavā ",
  "ja524:50.2": "daharā ca vuddhā ca sarīrabhedā, ",
  "ja524:50.3": "etampi disvā pabbajitomhi rāja. ",
  "ja524:50.4": "apaṇṇakaṃ sāmaññameva seyyo. ",
  "ja524:51.1": "addhā have sevitabbā sapaññā ",
  "ja524:51.2": "bahussutā ye bahuṭhānacintino, ",
  "ja524:51.3": "nāgañca sutvā na tavañcaḷāra ",
  "ja524:51.4": "kāhāmi puññāni anappakāni. ",
  "ja524:52.1": "addhā have sevitabbā sapaññā ",
  "ja524:52.2": "bahussutā ye bahuṭhānacintino, ",
  "ja524:52.3": "nāgañca sutvā mamañca rāja ",
  "ja524:52.4": "karohi puññāni anappakānīti. ",
  "ja524:53.1": "saṅkhapāla jātakaṃ. "
}
