  "ja329:0.4": "",
  "ja329:1.1": "yaṃ annapānassa pure labhāma ",
  "ja329:1.2": "taṃdāni sākhāmigameva gacchati, ",
  "ja329:1.3": "gacchāmadāni vanameva rādha ",
  "ja329:1.4": "asakkatā vasma dhanañjayāya. ",
  "ja329:2.1": "lābho alābho ayaso yaso ca ",
  "ja329:2.2": "nindā pasaṃsā ca sukhañca dukkhaṃ, ",
  "ja329:2.3": "ete aniccā manujesu dhammā ",
  "ja329:2.4": "mā socī kiṃ socasi poṭṭhapāda. ",
  "ja329:3.1": "addhā tuvaṃ paṇḍitakosi rādha ",
  "ja329:3.2": "jānāsi atthāni anāgatāni, ",
  "ja329:3.3": "kathannu sākhāmigaṃ dakkhisāma ",
  "ja329:3.4": "niddhāpitaṃ rājakulatova jammaṃ. ",
  "ja329:4.1": "cāleti kaṇṇaṃ bhaṭikuṃ karoti ",
  "ja329:4.2": "muhuja muhuṃ bhāyayate kumāre, ",
  "ja329:4.3": "sayameva taṃ kāhati kāḷabāhu ",
  "ja329:4.4": "yenārakā ṭhassati annapānāti. ",
  "ja329:5.1": "9. kāḷabāhujātakaṃ. "
}
