  "ja184:1.1": "dūsito girittena ",
  "ja184:1.2": "hayo sāmassa paṇḍavo, ",
  "ja184:1.3": "porāṇaṃ va pakatiṃ hitvā ",
  "ja184:1.4": "tasseva anuviṭhiyati. ",
  "ja184:2.1": "sace va tanujo poso ",
  "ja184:2.2": "sikharākārakappito, ",
  "ja184:2.3": "ānane taṃ gahetvāna ",
  "ja184:2.4": "maṇḍale parivattaye ",
  "ja184:2.5": "khippameva pahatvāna ",
  "ja184:2.6": "tasseva ",
  "ja184:3.1": "anuvidhīyatīti. "
}
