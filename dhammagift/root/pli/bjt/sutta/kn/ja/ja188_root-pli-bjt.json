  "ja188:1.1": "sīhaṅguli sīhanakho ",
  "ja188:1.2": "sīhapādapatiṭṭhito, ",
  "ja188:1.3": "so sīho sīhasaṅghambhi ",
  "ja188:1.4": "eko nadati aññathā. ",
  "ja188:2.1": "mā tvaṃ nadī rājaputta ",
  "ja188:2.2": "appasaddo vane vasa, ",
  "ja188:2.3": "sarena kho taṃ jāneyyuṃ ",
  "ja188:2.4": "na hi te pettiko saro’ti ",
  "ja188:3.1": ""
}
