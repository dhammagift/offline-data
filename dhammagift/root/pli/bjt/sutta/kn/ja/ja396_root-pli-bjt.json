{
  "ja396:0.1": "7. sattakanipātaṃ ",
  "ja396:0.2": "",
  "ja396:0.3": "1. kukkuvaggo ",
  "ja396:0.4": "",
  "ja396:1.1": "diyaḍḍhakukku udayena kaṇṇikā ",
  "ja396:1.2": "vidatthiyo aṭṭha parikkhipanti naṃ, ",
  "ja396:1.3": "sasiṃsapā sāramaya apheggukā ",
  "ja396:1.4": "kuhiṃ ṭhitā uparito na dhaṃsati. ",
  "ja396:2.1": "yā tiṃsati sāramayā anujjukā ",
  "ja396:2.2": "parikiriya gopāṇasiyo samaṭṭhitā, tā ",
  "ja396:2.3": "saṅgahitā balasā ca pīḷitā ",
  "ja396:2.4": "samaṭṭhitā uparito na dhaṃsati. ",
  "ja396:3.1": "evaṃ mittehi daḷhehi paṇḍito ",
  "ja396:3.2": "abhejjarūpehi sucīhi mantihi, ",
  "ja396:3.3": "susaṅgahīto siriyā na dhaṃsati ",
  "ja396:3.4": "gopāṇasī bhāravahāva kaṇṇikā. ",
  "ja396:4.1": "kharattavaṃ mellaṃ yathāpi satthavā ",
  "ja396:4.2": "anāmasantopi karoti tittakaṃ, ",
  "ja396:4.3": "samāharaṃ sāduṃ kāroti patthivā ",
  "ja396:4.4": "asādu kayirā tanuvaṭṭa muddharaṃ. ",
  "ja396:5.1": "evampi gāmanigamesu paṇḍito ",
  "ja396:5.2": "asāhasaṃ rājadhanāni saṃharaṃ, ",
  "ja396:5.3": "dhammānuvatti paṭipajjamāno ",
  "ja396:5.4": "saphāni kayirā aviheṭhayaṃ paraṃ. ",
  "ja396:6.1": "odātamūlaṃ sucivārisambhavaṃ ",
  "ja396:6.2": "jātaṃ yathā pokkharaṇīsu ambujaṃ, ",
  "ja396:6.3": "padumaṃ yathā agginikāsaphālimaṃ ",
  "ja396:6.4": "na kaddamo na rajo na vāri limpati. ",
  "ja396:7.1": "evampi vohārasuciṃ asāhasaṃ ",
  "ja396:7.2": "visuddhakammantamapetapāpakaṃ, ",
  "ja396:7.3": "na limpati kammakilesatādiso ",
  "ja396:7.4": "jātaṃ yathā pokkharaṇīsu ambuja’nti ",
  "ja396:8.1": ""
}
