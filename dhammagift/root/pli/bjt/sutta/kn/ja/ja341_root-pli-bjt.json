{
  "ja341:0.1": "",
  "ja341:0.2": "",
  "ja341:0.3": "5. cūḷakuṇālavaggo ",
  "ja341:0.4": "",
  "ja341:1.1": "narānamārāmakarāsu nārisu ",
  "ja341:1.2": "anekacittāsu aniggahāsu ca, ",
  "ja341:1.3": "sabbantanāpītikarāpi ce siyā ",
  "ja341:1.4": "na vissase titthasamā hi nāriyo. ",
  "ja341:2.1": "yaṃ ce disvā kaṇḍari kinnarānaṃ ",
  "ja341:2.2": "sabbitthiyo na ramanti agāre, ",
  "ja341:2.3": "taṃ tādisaṃ maccaṃ cajitvā bhariyā ",
  "ja341:2.4": "aññaṃ disvā purisaṃ pīṭhasappiṃ ",
  "ja341:3.1": "bakassa ca pāvārikassa rañño ",
  "ja341:3.2": "accantakāmānugatassa bhariyā, ",
  "ja341:3.3": "avācarī baddhavasānugassa ",
  "ja341:3.4": "kaṃ vā itthi nāticare tadaññaṃ. ",
  "ja341:4.1": "piṅgiyānī sabbalokissarassa ",
  "ja341:4.2": "rañño piyā brahmadattassa bhariyā ",
  "ja341:4.3": "avācarī baddhavasānugassa ",
  "ja341:4.4": "taṃ vāpi sā nājjhagā kāmakāminī’ti. ",
  "ja341:5.1": ""
}
