  "ja275:0.4": "",
  "ja275:1.1": "kāyaṃ balākā rucirā ",
  "ja275:1.2": "kākanīḷasmiṃ acchati, ",
  "ja275:1.3": "caṇḍo kāko sakhā mayhaṃ ",
  "ja275:1.4": "tassa cetaṃ kulāvakaṃ. ",
  "ja275:2.1": "nanu maṃ samma jānāsi ",
  "ja275:2.2": "dija sāmākabhojana, ",
  "ja275:2.3": "akatvā vacanaṃ tuyhaṃ ",
  "ja275:2.4": "passa lūnosmi āgato. ",
  "ja275:3.1": "punapāpajjasi samma ",
  "ja275:3.2": "sīlaṃ hi tava tādisaṃ, ",
  "ja275:3.3": "na hi mānusakā bhogā ",
  "ja275:3.4": "subhuñjā honti pakkhinā’ti. ",
  "ja275:4.1": "rucirajātakaṃ. "
}
