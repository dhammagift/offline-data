  "ja77:0.4": "",
  "ja77:1.1": "usabhā rukkhā gāmiyo gāvā ca, ",
  "ja77:1.2": "asso kaṃso sigālī ca tumbho, ",
  "ja77:1.3": "pokkharaṇī ca apākacandanaṃ ",
  "ja77:1.4": "lāpūni sīdanti silā plavanti. ",
  "ja77:2.1": "maṇḍukiyo kaṇhasappe gilanti. ",
  "ja77:2.2": "kākaṃ suvaṇṇā parivārayanti. ",
  "ja77:2.3": "tasāvakā phaḷakānaṃ bhayā hi ",
  "ja77:2.4": "vipariyāso vattati na ",
  "ja77:3.1": "idhamatthīti. "
}
