  "ja150:1.1": "asantaṃ yo pagaṇhāti ",
  "ja150:1.2": "asantañcupasevati, ",
  "ja150:1.3": "tameva ghāsaṃ kurute ",
  "ja150:1.4": "vyaggho sañjīvako yathāti. ",
  "ja150:2.1": "10. sañjivajātakaṃ. ",
  "ja150:2.2": "kakaṇṭakavaggo paṇṇarasamo. ",
  "ja150:3.1": "tassuddānaṃ: ",
  "ja150:4.1": "sukhamedhatidaṇḍavaro ca puna ",
  "ja150:4.2": "lasivāladhīpañcamarādhavaro, ",
  "ja150:4.3": "samabhodadhikattikakhondi puna ",
  "ja150:4.4": "caturaṅgulabyagghavarena dasa. ",
  "ja150:5.1": "uparimapaṇṇāsako. ",
  "ja150:6.1": "ekakanipāto niṭṭhito. tatra vagguddānaṃ: ",
  "ja150:7.1": "apaṇṇakaṃ sīlavaggakuruṅga ",
  "ja150:7.2": "kulāvakaṃ atthakāmenapañcamaṃ, ",
  "ja150:7.3": "āsiṃsoitthivaruṇaṃ apāyi. ",
  "ja150:7.4": "littavaggena terasa, ",
  "ja150:7.5": "parosataṃ haṃsisarikkhaṃ ",
  "ja150:7.6": "asampadaṃkakaṇṭavaggo. ",
  "ja150:8.1": "",
  "ja150:9.1": ""
}
