  "ja270:0.4": "",
  "ja270:1.1": "sabbehi kira ñātīhi ",
  "ja270:1.2": "kosiyo issaro kato, ",
  "ja270:1.3": "sace ñātīhanuññāto ",
  "ja270:1.4": "bhaṇeyyāhaṃ ekavāciyaṃ. ",
  "ja270:2.1": "bhaṇa samma anuññāto ",
  "ja270:2.2": "atthaṃ dhammañca kevalaṃ, ",
  "ja270:2.3": "santi hi daharā pakkhī ",
  "ja270:2.4": "paññāvanto jutindharā. ",
  "ja270:3.1": "na me ruccati bhaddaṃ vo ",
  "ja270:3.2": "ulūkassābhisecanaṃ, ",
  "ja270:3.3": "akuddhassa mukhaṃ passa ",
  "ja270:3.4": "kathaṃ kuddho karissatīti. ",
  "ja270:4.1": "ulūkajātakaṃ. ",
  "ja270:4.2": "padumavaggo dutiyo ",
  "ja270:5.1": "tassuddānaṃ: ",
  "ja270:6.1": "padumuttamanāgasirivhayano ",
  "ja270:6.2": "samahaṇṇavayūpakhurappavaro, ",
  "ja270:6.3": "atha kundalikuñjararukkha puna ",
  "ja270:6.4": "kharavācaulūkavarena dasā’ti. "
}
