  "ja199:0.4": "8. rādhajātakaṃ. ",
  "ja199:1.1": "ubhayaṃ me na khamati ",
  "ja199:1.2": "ubhayaṃ me na ruccati, ",
  "ja199:1.3": "yā cāyaṃ koṭṭhamotiṇṇā ",
  "ja199:1.4": "na dassaṃ iti bhāsati, ",
  "ja199:2.1": "taṃ taṃ gāmapati brūmi ",
  "ja199:2.2": "kadare appasmiṃ jīvite, ",
  "ja199:2.3": "dve māse kāraṃ katvāna ",
  "ja199:2.4": "maṃsaṃ jaraggagavaṃ kisaṃ, ",
  "ja199:2.5": "appattakāle codesi ",
  "ja199:2.6": "tampi mayhaṃ na ruccati. ",
  "ja199:3.1": ""
}
