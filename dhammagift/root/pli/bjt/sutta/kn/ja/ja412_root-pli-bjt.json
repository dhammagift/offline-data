  "ja412:0.4": "",
  "ja412:1.1": "ahaṃ dasasataṃ vyāmaṃ ",
  "ja412:1.2": "uragamādāya māgato, ",
  "ja412:1.3": "tañca mañca mahākāyaṃ ",
  "ja412:1.4": "dhārayaṃ nappavedhasi. ",
  "ja412:2.1": "atha imaṃ khuddakaṃ pakkhiṃ ",
  "ja412:2.2": "appamaṃsataraṃ mayā, ",
  "ja412:2.3": "dhārayaṃ vyādhase bhīto ",
  "ja412:2.4": "kamatthaṃ koṭisimbali. ",
  "ja412:3.1": "maṃsabhakkho tuvaṃ rāja ",
  "ja412:3.2": "balabhakkho ayaṃ dijo, ",
  "ja412:3.3": "ayaṃ nigrodha bījāni ",
  "ja412:3.4": "pilakkhadumbarāni ca ",
  "ja412:3.5": "assatthāni ca bhakkhetvā ",
  "ja412:3.6": "khandhe me odahissati. ",
  "ja412:4.1": "te rukkhā saṃvirūhanti ",
  "ja412:4.2": "mama passe nivātajā, ",
  "ja412:4.3": "te pariyonandhissanti ",
  "ja412:4.4": "arukkhaṃ maṃ karissare. ",
  "ja412:5.1": "santi aññepi rukkhāse ",
  "ja412:5.2": "mūlino khandhino dumā, ",
  "ja412:5.3": "iminā sakuṇajātena ",
  "ja412:5.4": "bījamāharitvā hatā. ",
  "ja412:6.1": "ajjhārūḷhābhivaḍḍhanti ",
  "ja412:6.2": "brahantampi vanaspatiṃ, ",
  "ja412:6.3": "tasmā rāja pavedhāmi ",
  "ja412:6.4": "sampassaṃ nāgataṃ bhayaṃ. ",
  "ja412:7.1": "saṅkeyya saṅkitabbāni ",
  "ja412:7.2": "rakkheyyānāgataṃ bhayaṃ. ",
  "ja412:7.3": "anāgatabhayā dhīro ",
  "ja412:7.4": "ubho loke avekkhatīti. ",
  "ja412:8.1": ""
}
