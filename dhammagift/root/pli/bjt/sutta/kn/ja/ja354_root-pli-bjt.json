  "ja354:0.3": "",
  "ja354:0.4": "3. dhonasākha jātakaṃ. ",
  "ja354:1.1": "uragova tavaṃ jiṇṇaṃ ",
  "ja354:1.2": "hitvā gacchati saṃ tanuṃ, ",
  "ja354:1.3": "evaṃ sarīre nibbhoge ",
  "ja354:1.4": "pete kālakate sati, ",
  "ja354:2.1": "ḍayhamāno na jānāti ",
  "ja354:2.2": "ñātinaṃ paridevitaṃ, ",
  "ja354:2.3": "tasmā etaṃ na socāmi ",
  "ja354:2.4": "gato so tassa yā gati. ",
  "ja354:3.1": "anabbhito tato āga ",
  "ja354:3.2": "ananuññāto ito gato, ",
  "ja354:3.3": "yathā gato tathā gato ",
  "ja354:3.4": "tattha kā paridevanā. ",
  "ja354:4.1": "ḍayhamāno na jānāti ",
  "ja354:4.2": "ñātinaṃ paridevitaṃ, ",
  "ja354:4.3": "tasmā etaṃ na socāmi ",
  "ja354:4.4": "gato so tassa yā gati. ",
  "ja354:5.1": "sace rode kisā assaṃ ",
  "ja354:5.2": "tassā me kiṃ phalaṃ siyā, ",
  "ja354:5.3": "ñātimittasuhajjānaṃ ",
  "ja354:5.4": "bhiyyo no aratī siyā. ",
  "ja354:6.1": "ḍayhamāno na jānāti ",
  "ja354:6.2": "ñātinaṃ paridevitaṃ, ",
  "ja354:6.3": "tasmā etaṃ na socāmi ",
  "ja354:6.4": "gato so tassa yā gati. ",
  "ja354:7.1": "yathāpi dārako candaṃ ",
  "ja354:7.2": "gacchantamanurodati, ",
  "ja354:7.3": "evaṃ sampadamevetaṃ ",
  "ja354:7.4": "yo petamanusocati. ",
  "ja354:8.1": "ḍayhamāno na jānāti ",
  "ja354:8.2": "ñātinaṃ paridevitaṃ, ",
  "ja354:8.3": "tasmā etaṃ na socāmi ",
  "ja354:8.4": "gato so tassa yā gati. ",
  "ja354:9.1": "yathāpi udakakumbho ",
  "ja354:9.2": "bhinno appaṭisandhiyo, ",
  "ja354:9.3": "evaṃ sampadamevetaṃ ",
  "ja354:9.4": "yo petamanusocati. ",
  "ja354:10.1": "ḍayhamāno na jānāti ",
  "ja354:10.2": "ñātinaṃ paridevitaṃ, ",
  "ja354:10.3": "tasmā etaṃ na socāmi ",
  "ja354:10.4": "gato so tassa yā gatīti. ",
  "ja354:11.1": "4. uragajātakaṃ. "
}
