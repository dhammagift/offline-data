  "ja453:0.3": "",
  "ja453:0.4": "",
  "ja453:1.1": "kiṃ su naro jappamadhiccakāle ",
  "ja453:1.2": "kaṃ vā vijjaṃ katamaṃ vā sutānaṃ, ",
  "ja453:1.3": "so macco asmiñca paramhi loke ",
  "ja453:1.4": "kathaṃ karo sotthānena gutto. ",
  "ja453:2.1": "yassa devā pitaro ca sabba ",
  "ja453:2.2": "siriṃsapā sabbabhūtāni cāpi, ",
  "ja453:2.3": "mettāya niccaṃ apacitāni honti ",
  "ja453:2.4": "bhūtesu ce sotthānaṃ tadāhu. ",
  "ja453:3.1": "yo pabbalokassa nivātavutti ",
  "ja453:3.2": "itthi pumānaṃ saha dārakānaṃ, ",
  "ja453:3.3": "khantā duruttānaṃ apaṭikkūlavādī ",
  "ja453:3.4": "adhivāsanaṃ sotthānaṃ tadāhu. ",
  "ja453:4.1": "yo nāvajānāti sahāyamatte ",
  "ja453:4.2": "sippena kulyāhi dhanena jaccā, ",
  "ja453:4.3": "rucipañño atthakāle mutīmā ",
  "ja453:4.4": "sahāyesu ve sotthānaṃ tadāhu. ",
  "ja453:5.1": "mittāni ve yassa bhavanti santo ",
  "ja453:5.2": "saṃvissatthā avisaṃvādakassa, ",
  "ja453:5.3": "na mittadūbhi saṃvihāgi dhanena ",
  "ja453:5.4": "mittesu ve sotthānaṃ tadāhu ",
  "ja453:6.1": "yassa bhariyā tulyavayā samaggā ",
  "ja453:6.2": "anubbatā dhammakāmā pajātā, ",
  "ja453:6.3": "kolīniyā sīlavatī patibbatā ",
  "ja453:6.4": "dāresu ve sotthānaṃ tadāhu. ",
  "ja453:7.1": "yassa rājā bhūtapatī yasassi ",
  "ja453:7.2": "jānāti soceyyaṃ parakkamañca, ",
  "ja453:7.3": "advejjhatāsu hadayaṃ mamanti ",
  "ja453:7.4": "rājusu ve sotthānaṃ tadāhu. ",
  "ja453:8.1": "annañca pānañca dadāti saddho ",
  "ja453:8.2": "mālañca gandhañca vilepanañca, ",
  "ja453:8.3": "pasannacitto anumodamāno ",
  "ja453:8.4": "saggesu ve sotthānaṃ tadāhu. ",
  "ja453:9.1": "yamariyadhammena punanti vaddhā ",
  "ja453:9.2": "ārādhitā samacariyāya santo, ",
  "ja453:9.3": "bahussutā isayo sīlavantaṃ ",
  "ja453:9.4": "arahantamajjhe sotthānaṃ tadāhu. ",
  "ja453:10.1": "etāni kho sotthānāti loke ",
  "ja453:10.2": "viññuppasatthāni sukhudrayāni, ",
  "ja453:10.3": "tānīdha sevetha nāro sapañño ",
  "ja453:10.4": "na hi maṅgale kiñcanamatthi saccanti. ",
  "ja453:11.1": "15. mahāmaṅgalajātakaṃ. "
}
