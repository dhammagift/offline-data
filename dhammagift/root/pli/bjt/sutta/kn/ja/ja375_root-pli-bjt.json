  "ja375:0.3": "",
  "ja375:0.4": "4. culladhanuggahajātakaṃ. ",
  "ja375:1.1": "idāni khomhi sukhito arogo. ",
  "ja375:1.2": "nikkaṇṭako nippatito kapoto, ",
  "ja375:1.3": "kāhāmidāni hadayassa tuṭṭhiṃ ",
  "ja375:1.4": "tathāhi maṃ maṃsasākaṃ baleti. ",
  "ja375:2.1": "kāyaṃ balākā sikhinī ",
  "ja375:2.2": "corī laṅghipitāmahā, ",
  "ja375:2.3": "oraṃ balāke āgaccha ",
  "ja375:2.4": "caṇḍo me vāyaso sakhā. ",
  "ja375:3.1": "alaṃ hi te jagghitāye ",
  "ja375:3.2": "mamaṃ disvāna edisaṃ, ",
  "ja375:3.3": "vilūnaṃ sūdaputtena ",
  "ja375:3.4": "piṭṭhimaddena makkhitaṃ. ",
  "ja375:4.1": "sunahāto sucilittosi ",
  "ja375:4.2": "annapānena tappito, ",
  "ja375:4.3": "kaṇṭho ca te veḷuriyo ",
  "ja375:4.4": "agamā nu kajaṅgalaṃ. ",
  "ja375:5.1": "mā te mitto amitto vā ",
  "ja375:5.2": "agamāsi kajaṅgalaṃ. ",
  "ja375:5.3": "piñchāni tattha lāyitvā ",
  "ja375:5.4": "kaṇṭhe bandhanti vaṭṭanaṃ. ",
  "ja375:6.1": "punapāpajjasi samma ",
  "ja375:6.2": "sīlaṃ hi tava tādisaṃ ",
  "ja375:6.3": "na hi mānusakā bhogā ",
  "ja375:6.4": "subhuñjā honti pakkhinā’ti. ",
  "ja375:7.1": "",
  "ja375:7.2": "5. kapotajātakaṃ. aḍḍhavaggo tatiyo. ",
  "ja375:8.1": "tassuddānaṃ: ",
  "ja375:9.1": "atha vaṇṇā sasīla hiri labhate ",
  "ja375:9.2": "sumukhāmisasāliya mittavaro, ",
  "ja375:9.3": "atha cakka palāsa sarāja sato ",
  "ja375:9.4": "yavabālakapokataṃ paṇṇa rasāti. pañcakanipāto niṭṭhito. ",
  "ja375:10.1": "tatra vagguddānaṃ: ",
  "ja375:11.1": "jinañca vaṇṇaṃ asamaṃ vaggupari ",
  "ja375:11.2": "sudesitā jātakanti pañca vīsati, ",
  "ja375:11.3": "mahesino brahmacarittamuttama ",
  "ja375:11.4": "mavoca gāthā atthavatī subyañjanā’ti. ",
  "ja375:12.1": ""
}
