  "ja215:1.1": "avadhi vata attānaṃ ",
  "ja215:1.2": "kacchapo vyāharaṃ giraṃ, ",
  "ja215:1.3": "suggahitasmiṃ kaṭṭhasmiṃ ",
  "ja215:1.4": "vācāya sakiyāvadhi. ",
  "ja215:2.1": "etampi disvā naraviriyaseṭṭha ",
  "ja215:2.2": "vācaṃ pamuñce kusalaṃ nātivelaṃ ",
  "ja215:2.3": "passasi bahubhāṇena ",
  "ja215:2.4": "kacchapaṃ vyasanaṃ gatanti. ",
  "ja215:3.1": "kacchapajātakaṃ "
}
