  "ja140:1.1": "niccaṃ ubbiggahadayā ",
  "ja140:1.2": "sabbalokavihesakā, ",
  "ja140:1.3": "tasmā tesaṃ vasā natthi ",
  "ja140:1.4": "kākānasmāka ñātīna’nti. ",
  "ja140:2.1": "kākajātakaṃ. ",
  "ja140:2.2": "asampadānavaggo cuddasamo. ",
  "ja140:3.1": "tassuddānaṃ: ",
  "ja140:4.1": "itarītararakkhasikhemiyo ca ",
  "ja140:4.2": "parosatapañhena āhassaro puna, ",
  "ja140:4.3": "atha haṃsavaruttamababbujaṭaṃ ",
  "ja140:4.4": "paṭanaṭṭhakakākavarena dasa. "
}
