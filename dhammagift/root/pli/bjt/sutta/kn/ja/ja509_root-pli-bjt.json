  "ja509:0.3": "",
  "ja509:0.4": "13. hatthipālajātakaṃ. ",
  "ja509:1.1": "cirassaṃ vata passāma ",
  "ja509:1.2": "brāhmaṇaṃ devavaṇṇinaṃ, ",
  "ja509:1.3": "mahājaṭaṃ khāridharaṃ ",
  "ja509:1.4": "paṅkadantaṃ rajassiraṃ. ",
  "ja509:2.1": "cirassaṃ vata passāma ",
  "ja509:2.2": "isiṃ dhammaguṇe rataṃ, ",
  "ja509:2.3": "kāsāyavattavasanaṃ ",
  "ja509:2.4": "vākacīraṃ paṭicchadaṃ. ",
  "ja509:3.1": "āsanaṃ udakaṃ pajjaṃ ",
  "ja509:3.2": "patigaṇhātu no bhavaṃ, ",
  "ja509:3.3": "agghe bhavantaṃ pucchāma ",
  "ja509:3.4": "agghaṃ kurutu no bhavaṃ. ",
  "ja509:4.1": "adhicca vede pariyesa cittaṃ ",
  "ja509:4.2": "putte gehe tāta patiṭṭhapetvā, ",
  "ja509:4.3": "gandhe rase paccanubhuyya sabbaṃ ",
  "ja509:4.4": "araññaṃ sādhu muni so pasattho. ",
  "ja509:5.1": "vedā na saccā na ca cittalābho ",
  "ja509:5.2": "na puttalābhena jaraṃ vihanti, ",
  "ja509:5.3": "gandhe rase muñcanamāhu sante ",
  "ja509:5.4": "sakammanā heti phalūpapatti. ",
  "ja509:6.1": "addhā hi saccaṃ vacanaṃ tavetaṃ ",
  "ja509:6.2": "sakammanā hoti phalūpapatti ",
  "ja509:6.3": "jiṇṇā ca mātāpitaro tavayime ",
  "ja509:6.4": "passeyyu taṃ vassasataṃ arogaṃ. ",
  "ja509:7.1": "yassassa sakkhi maraṇena rāja ",
  "ja509:7.2": "jarāya metti naraviriyaseṭṭha, ",
  "ja509:7.3": "yocāpi jaññā na marissaṃ kadāci ",
  "ja509:7.4": "passeyyu taṃ vassasataṃ ārogaṃ. ",
  "ja509:8.1": "yathāpi nāvaṃ puriso dakamhi ",
  "ja509:8.2": "ereti cenaṃ upaneti tīraṃ, ",
  "ja509:8.3": "evampi vyādhi satataṃ jarā ca ",
  "ja509:8.4": "upanenti maccaṃ vasamantakassa. ",
  "ja509:9.1": "paṅko va kāmā palipo ca kāmā ",
  "ja509:9.2": "manoharāduttarā maccudheyyā, ",
  "ja509:9.3": "etasmiṃ paṅke palipe vyasannā ",
  "ja509:9.4": "hīnattarūpā na taranti pāraṃ. ",
  "ja509:10.1": "ayaṃ pure luddamakāsi kammaṃ ",
  "ja509:10.2": "svāyaṃ gahīto na hi mokkhito me, ",
  "ja509:10.3": "orundhiyānaṃ parirakkhissāmi ",
  "ja509:10.4": "māyaṃ punaluddamakāsi kammaṃ. ",
  "ja509:11.1": "gāvaṃva naṭṭhaṃ puriso yathā vane ",
  "ja509:11.2": "pariyesati rāja apassamāno, ",
  "ja509:11.3": "evaṃ naṭṭho esukārī mamattho ",
  "ja509:11.4": "sohaṃ kathaṃ na gaveseyya rāja. ",
  "ja509:12.1": "hiyyoti hīyati poso ",
  "ja509:12.2": "paretha parihāyati, ",
  "ja509:12.3": "anāgataṃ netamatthiti ñatvā, ",
  "ja509:12.4": "uppannaṃ chandaṃ kopanudeyya dhīro. ",
  "ja509:13.1": "passāmi vohaṃ dahariṃ kumāriṃ ",
  "ja509:13.2": "mattūpamaṃ ketaka pupphanettaṃ, ",
  "ja509:13.3": "abhuttabhoge paṭhame vayasmiṃ ",
  "ja509:13.4": "ādāya maccu vajate kumāriṃ. ",
  "ja509:14.1": "yuvā sujāto sumukho sudassano ",
  "ja509:14.2": "sāmo kusumbhaparikiṇṇamassu, ",
  "ja509:14.3": "hitvāna kāme paṭigacca gehaṃ ",
  "ja509:14.4": "anujāna maṃ pabbajissāmi deva. ",
  "ja509:15.1": "sākhāhi rukkho labhate samaññaṃ ",
  "ja509:15.2": "pahinasākhaṃ pana khāṇumāhu, ",
  "ja509:15.3": "pahīnaputtassa mamajja hoti ",
  "ja509:15.4": "vāseṭṭhi bhikkhācariyāya kālo. ",
  "ja509:16.1": "aghasmiṃ koñcāva yathā himaccaye ",
  "ja509:16.2": "tantāni jālāni padāḷeyya haṃsā, ",
  "ja509:16.3": "gacchanti puttā ca patī ca mayhaṃ ",
  "ja509:16.4": "sāhaṃ kathaṃ nānuvaje pajānaṃ. ",
  "ja509:17.1": "ete bhutvā vamitvā ca ",
  "ja509:17.2": "pakkamanti vihaṅgamā, ",
  "ja509:17.3": "ye ca bhutvā na vamiṃsu ",
  "ja509:17.4": "te me hatthatthamāgatā. ",
  "ja509:18.1": "avamī brāhmaṇo kāme ",
  "ja509:18.2": "te tvaṃ paccāvamissasi, ",
  "ja509:18.3": "vantādo puriso rāja ",
  "ja509:18.4": "na so hoti pasaṃsiyo. ",
  "ja509:19.1": "paṅkeva posaṃ palipe vyasannaṃ ",
  "ja509:19.2": "khalī yathā dubbalaṃ uddhareyya, ",
  "ja509:19.3": "evampi maṃ tvaṃ udatāri hoti ",
  "ja509:19.4": "pañcāli gāthāhi subhāsitāhi. ",
  "ja509:20.1": "idaṃ vatvā mahārājā ",
  "ja509:20.2": "esukārī disampati, ",
  "ja509:20.3": "raṭṭhaṃ hitvāna pabbaji ",
  "ja509:20.4": "nāgo chetvā va bandhanaṃ. ",
  "ja509:21.1": "rājā ca pabbajjamarocayittha ",
  "ja509:21.2": "raṭṭhaṃ pahāya naraviriyaseṭṭhā, ",
  "ja509:21.3": "tuvampi no hohi yatheva rājā ",
  "ja509:21.4": "amhehi guttaṃ anusāsa rajjaṃ. ",
  "ja509:22.1": "rājā ca pabbajjamarocayittha ",
  "ja509:22.2": "raṭṭhaṃ pahāya naraviriyaseṭṭho, ",
  "ja509:22.3": "ahampi ekāva ",
  "ja509:22.4": "",
  "ja509:23.1": "",
  "ja509:23.2": "",
  "ja509:23.3": "carissāmi loke ",
  "ja509:23.4": "hitvāna kāmāni yathodhikāni. ",
  "ja509:24.1": "accenti kālā tarayanti rattiyo ",
  "ja509:24.2": "vayoguṇā anupubbaṃ jahanti, ",
  "ja509:24.3": "ahampi ekāva carissāmi leke ",
  "ja509:24.4": "hitvāna kāmāni manoramāni. ",
  "ja509:25.1": "accenti kālā tarayanti rattiyo ",
  "ja509:25.2": "vayo guṇā anupubbaṃ jahanti, ",
  "ja509:25.3": "ahampi ekāva carissāmi loke ",
  "ja509:25.4": "hitvāna kāmāni yathodhikāni. ",
  "ja509:26.1": "accenti kālā tarayanti rattiyo ",
  "ja509:26.2": "vayo guṇā anupubbaṃ jahanti, ",
  "ja509:26.3": "ahampi ekāva carissāmi loke ",
  "ja509:26.4": "sītībhūtā sabbamatīcca saṅganti. ",
  "ja509:27.1": "hatthipāla jātakaṃ. "
}
