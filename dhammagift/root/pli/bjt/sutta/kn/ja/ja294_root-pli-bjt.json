  "ja294:0.3": "",
  "ja294:0.4": "3. kāyavicchandajātakaṃ. ",
  "ja294:1.1": "koyaṃ bindussaro vaggu ",
  "ja294:1.2": "pavadantānamuttamo, ",
  "ja294:1.3": "accuto jambusākhāya ",
  "ja294:1.4": "mojacchāpova kūjati. ",
  "ja294:2.1": "kulaputtova jānāti ",
  "ja294:2.2": "kulaputte pasaṃsituṃ, ",
  "ja294:2.3": "vyagghacchāpasarīvaṇṇo ",
  "ja294:2.4": "bhuñja samma dadāmi te. ",
  "ja294:3.1": "cirassaṃ vata passāmi ",
  "ja294:3.2": "musāvādī samāgate, ",
  "ja294:3.3": "vantādaṃ kuṇapādañca ",
  "ja294:3.4": "aññamaññaṃ pasaṃsake’ti. ",
  "ja294:4.1": "4. jambukhādakajātakaṃ. "
}
