  "ja349:0.4": "",
  "ja349:1.1": "neva itthisu sāmaññaṃ ",
  "ja349:1.2": "napi bhakkhesu sārathi, ",
  "ja349:1.3": "athassa sandhibhedassa ",
  "ja349:1.4": "passa yāva sucintitaṃ. ",
  "ja349:2.1": "asi tikkhova maṃsamhi ",
  "ja349:2.2": "pesuññaṃ parivattati, ",
  "ja349:2.3": "yatthusabhañca sīhañca ",
  "ja349:2.4": "bhakkhayanti migādhamā. ",
  "ja349:3.1": "imaṃ so sayanaṃ seti ",
  "ja349:3.2": "yayimaṃ passasi sārathi, ",
  "ja349:3.3": "yo vācaṃ sandhibhedassa ",
  "ja349:3.4": "pisunassa nibodhati. ",
  "ja349:4.1": "te janā sukhamedhanti ",
  "ja349:4.2": "narā saggagatāriva, ",
  "ja349:4.3": "yo vācaṃ sandhibhedassa ",
  "ja349:4.4": "nāvabodhenti sārathi’ti. ",
  "ja349:5.1": "sandhibhedajātakaṃ. "
}
