  "ja267:0.4": "",
  "ja267:1.1": "vātaggajātakaṃ. siṅgī migo āyatacakkhunetto ",
  "ja267:1.2": "aṭṭhittaco vārisayo alomo, ",
  "ja267:1.3": "tenābhibhūto kapaṇaṃ rudāmi ",
  "ja267:1.4": "māheva maṃ pāṇasamaṃ jaheyya. ",
  "ja267:2.1": "ayya taṃ na jahissāmi ",
  "ja267:2.2": "kuñjara saṭṭhihāyana, ",
  "ja267:2.3": "pathavyā cāturannāya ",
  "ja267:2.4": "suppiyo hosi me tuvaṃ, ",
  "ja267:3.1": "ye kuḷirā samuddasmiṃ ",
  "ja267:3.2": "gaṅgāya nammadāya ca, ",
  "ja267:3.3": "tesaṃ tvaṃ vārijo seṭṭho ",
  "ja267:3.4": "muñca rodantiyā patinti. ",
  "ja267:4.1": "kakkaṭakajātakaṃ. "
}
