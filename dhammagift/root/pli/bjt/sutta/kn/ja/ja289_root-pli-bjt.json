  "ja289:0.3": "",
  "ja289:0.4": "8. macchuddānajātakaṃ. ",
  "ja289:1.1": "nānācchandā mahārāja ",
  "ja289:1.2": "ekāgāre vasāmase, ",
  "ja289:1.3": "ahaṃ gāmavaraṃ icche ",
  "ja289:1.4": "brāhmaṇī ca gavaṃ sataṃ. ",
  "ja289:2.1": "chatto ca ājaññarathaṃ ",
  "ja289:2.2": "kaññā ca maṇikuṇḍalaṃ ",
  "ja289:2.3": "yā cesā puṇṇikā jammī ",
  "ja289:2.4": "udukkhalaṃ abhikaṅkhati. ",
  "ja289:3.1": "brāhmaṇassa gāmavaraṃ detha ",
  "ja289:3.2": "brāhmaṇiyā gavaṃ sataṃ, ",
  "ja289:3.3": "puttassa ājaññarathaṃ ",
  "ja289:3.4": "kaññāya maṇikuṇḍalaṃ ",
  "ja289:3.5": "yañcetaṃ puṇṇikaṃ jammiṃ ",
  "ja289:3.6": "paṭiyādetha ",
  "ja289:4.1": "udukkhala’nti. "
}
