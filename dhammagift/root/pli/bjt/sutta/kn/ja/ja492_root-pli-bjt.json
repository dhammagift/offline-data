  "ja492:0.4": "",
  "ja492:1.1": "yadesamānā vicarimha ",
  "ja492:1.2": "pabbatāni vanāni ca, ",
  "ja492:1.3": "anvesaṃ vicariṃ ñātī ",
  "ja492:1.4": "teme adhigatā mayā ",
  "ja492:2.1": "bahuṃ idaṃ mūlaphalaṃ ",
  "ja492:2.2": "bhakkho cāyaṃ anappako, ",
  "ja492:2.3": "rammā cimā giri nadiyo ",
  "ja492:2.4": "phāsu vāso bhavissati. ",
  "ja492:3.1": "idhevāhaṃ vasissāmi ",
  "ja492:3.2": "saha sabbehi ñātibhi, ",
  "ja492:3.3": "appossukko nirāsaṅki ",
  "ja492:3.4": "asoko akutobhayo. ",
  "ja492:4.1": "aññaṃ hi lenaṃ pariyesa ",
  "ja492:4.2": "sattu no idha vijjati, ",
  "ja492:4.3": "so taccha sūkare hanti ",
  "ja492:4.4": "idhāgantvā varaṃ varaṃ ",
  "ja492:5.1": "konamhākaṃ idha sattu ",
  "ja492:5.2": "ko ñātī susamāgate, ",
  "ja492:5.3": "appadhaṃse padhaṃseti ",
  "ja492:5.4": "tamme akkhātha pucchitā. ",
  "ja492:6.1": "uddhaggarājī migarājā ",
  "ja492:6.2": "balī dāṭhāvudho migo, ",
  "ja492:6.3": "so taccha sūkare hanti ",
  "ja492:6.4": "idhāgantvā varaṃ varaṃ. ",
  "ja492:7.1": "na no dāṭhā na vijjanti ",
  "ja492:7.2": "balaṃ kāye samūhataṃ, ",
  "ja492:7.3": "sabbe samaggā hutvāna ",
  "ja492:7.4": "vasaṃ kāhāma ekakaṃ. ",
  "ja492:8.1": "hadayaṅgamaṃ kaṇṇasukhaṃ ",
  "ja492:8.2": "vācaṃ bhāsasi tacchaka, ",
  "ja492:8.3": "yopi yuddhe palāyetha ",
  "ja492:8.4": "tampi pacchā hanāmase. ",
  "ja492:9.1": "pāṇātipātā virato nu ajja ",
  "ja492:9.2": "abhayaṃ nu te sabbabhūtesu dinnaṃ, ",
  "ja492:9.3": "dāṭhā nu te miga viriyaṃ na santi ",
  "ja492:9.4": "yo saṅghapatto kapaṇova jhāyasi. ",
  "ja492:10.1": "na me dāṭhā na vijjanti ",
  "ja492:10.2": "balaṃ kāye samūhataṃ, ",
  "ja492:10.3": "ñātī ca disvāna samaṅgiekato ",
  "ja492:10.4": "tasmā jhāyāmi vanamhi ekato ",
  "ja492:11.1": "imassudaṃ yanti disodisaṃ pure ",
  "ja492:11.2": "bhayadditā lenagavesino puthu, ",
  "ja492:11.3": "tedāni saṅgamma vasanti ekako ",
  "ja492:11.4": "yatthaṭṭhitā duppasahajja te mayā. ",
  "ja492:12.1": "pariṇāyakasampannā ",
  "ja492:12.2": "sahitā ekavādino ",
  "ja492:12.3": "te maṃ samaggā hiṃseyyuṃ ",
  "ja492:12.4": "tasmā tesaṃ na patthaye. ",
  "ja492:13.1": "ekova indo asure jināti ",
  "ja492:13.2": "ekova seno hanti dije pasayha, ",
  "ja492:13.3": "ekova vyaggho migasaṅghapatto ",
  "ja492:13.4": "varaṃ varaṃ hanti balaṃ hi tādisaṃ. ",
  "ja492:14.1": "naheva indo na seno ",
  "ja492:14.2": "napi vyaggho migādhipo, ",
  "ja492:14.3": "samagge sahite ñātī ",
  "ja492:14.4": "vyagegha ca kurute vase. ",
  "ja492:15.1": "kumbhīlakā sakuṇikā ",
  "ja492:15.2": "saṅghino gaṇacārino, ",
  "ja492:15.3": "sammodamānā ekajjhaṃ ",
  "ja492:15.4": "uppatanni ḍayanti ca ",
  "ja492:16.1": "tesaña ḍayamanānaṃ ",
  "ja492:16.2": "ekettha apavattati, ",
  "ja492:16.3": "tañca seno nitāḷeti ",
  "ja492:16.4": "veyyagghiyeva sā gati. ",
  "ja492:17.1": "ussāhito jaṭilena ",
  "ja492:17.2": "luddenāmisacakkhunā, ",
  "ja492:17.3": "dāṭhi dāṭhisu pakkhandi ",
  "ja492:17.4": "maññamāno yathāpure. ",
  "ja492:18.1": "sādhu sambahulā ñāti ",
  "ja492:18.2": "api rukkhā araññajā, ",
  "ja492:18.3": "sūkarehi samaggehi ",
  "ja492:18.4": "vyaggho ekāyane hato. ",
  "ja492:19.1": "brāhmaṇañceva vyagghañca ",
  "ja492:19.2": "ubho hantvāna sūkarā, ",
  "ja492:19.3": "ānandino pamuditā ",
  "ja492:19.4": "mahānādañca nādisuṃ. ",
  "ja492:20.1": "tesu udumbaramūlasmiṃ ",
  "ja492:20.2": "sūkarā susamāgatā, ",
  "ja492:20.3": "tacchakaṃ abhisiñciṃsu ",
  "ja492:20.4": "tvaṃ no rājāsi issaroti. ",
  "ja492:21.1": "9. tacchasūkarajātakaṃ. "
}
