  "ja231:0.1": "",
  "ja231:0.2": "",
  "ja231:0.3": "9. upāhanavaggo ",
  "ja231:0.4": "",
  "ja231:1.1": "yathāpi kītā purisassupāhanā ",
  "ja231:1.2": "sukhassa atthāya dukhaṃ udabbahe, ",
  "ja231:1.3": "ghammābhitattā talasā papīḷitā ",
  "ja231:1.4": "tasseva pāde purisassa khādare. ",
  "ja231:2.1": "evameva dukkulīno anariyo ",
  "ja231:2.2": "tamhākavijjañca sutañcamādiya, ",
  "ja231:2.3": "tameva so tattha sutena khādati ",
  "ja231:2.4": "anariyo vuccati pānadupamoti. ",
  "ja231:3.1": "1. upāhanajātakaṃ. "
}
