  "ja306:0.3": "",
  "ja306:0.4": "5. sīlavīmaṃsajātakaṃ. ",
  "ja306:1.1": "tiṃ aṇḍakā ime deva ",
  "ja306:1.2": "nikkhittā kaṃsamallake, ",
  "ja306:1.3": "upalohitakā vaggu ",
  "ja306:1.4": "taṃ me akkhāhi pucchito. ",
  "ja306:2.1": "yāni pure tvaṃ devi ",
  "ja306:2.2": "bhaṇḍu nantakavāsinī, ",
  "ja306:2.3": "ucchaṅgahatthā pacināsi ",
  "ja306:2.4": "tassā te koliyaṃ phalaṃ. ",
  "ja306:3.1": "uḍḍayhate na ramati ",
  "ja306:3.2": "bhogā vippajahanti taṃ, ",
  "ja306:3.3": "tatthevimaṃ paṭinetha ",
  "ja306:3.4": "yattha kolaṃ pacissati. ",
  "ja306:4.1": "honti hete mahārāja ",
  "ja306:4.2": "iddhippattāya nāriyā, ",
  "ja306:4.3": "khama deva sujātāya ",
  "ja306:4.4": "māssā kujjhi rathesabhāti. ",
  "ja306:5.1": ""
}
