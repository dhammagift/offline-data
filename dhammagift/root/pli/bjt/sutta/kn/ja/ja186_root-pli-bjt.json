  "ja186:1.1": "vaṇṇagandharasūpeto ",
  "ja186:1.2": "ambāyaṃ ahuvā pure, ",
  "ja186:1.3": "tameva pūjaṃ labhamāno ",
  "ja186:1.4": "kenambo kaṭukapphalo. ",
  "ja186:2.1": "pucimandaparivāro ",
  "ja186:2.2": "ambo te dadhivāhana, ",
  "ja186:2.3": "mūlaṃ mūlena saṃsaṭṭhaṃ ",
  "ja186:2.4": "sākhā sākhā nisevare ",
  "ja186:2.5": "asataṃ sannivāsena ",
  "ja186:2.6": "tenambo kaṭukapphalo’ti. ",
  "ja186:3.1": "dadhivāhanajātakaṃ. "
}
