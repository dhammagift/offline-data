  "ja269:0.3": "",
  "ja269:0.4": "",
  "ja269:1.1": "na hi vaṇṇena sampannā ",
  "ja269:1.2": "mañjukā piyadasasnā ",
  "ja269:1.3": "kharavācā piyā honti ",
  "ja269:1.4": "asmiṃ loke paramhi ca. ",
  "ja269:2.1": "nanu passasimaṃ kāḷiṃ ",
  "ja269:2.2": "dubbaṇṇaṃ tilakāhataṃ, ",
  "ja269:2.3": "kokilaṃ saṇhabhāṇena ",
  "ja269:2.4": "bahunnaṃ pāṇinaṃ piyaṃ. ",
  "ja269:3.1": "tasmā sakhilavācassa ",
  "ja269:3.2": "mattabhāṇi anuddhato, ",
  "ja269:3.3": "atthaṃ dhammañca dīpeti ",
  "ja269:3.4": "madhuraṃ tassa bhāsitanti. ",
  "ja269:4.1": "9. sujātajātakaṃ. "
}
