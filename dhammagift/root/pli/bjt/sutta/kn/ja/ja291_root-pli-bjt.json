{
  "ja291:0.1": "",
  "ja291:0.2": "",
  "ja291:0.3": "5. kumbhavaggo ",
  "ja291:0.4": "",
  "ja291:1.1": "sabbakāmaddaṃ kumbhaṃ ",
  "ja291:1.2": "kuṭaṃ laddhāna dhuttako, ",
  "ja291:1.3": "yāva so anupāleti ",
  "ja291:1.4": "tāva so sukhamedhati. ",
  "ja291:2.1": "yadā matto ca ditto ca ",
  "ja291:2.2": "pamādā kumbhamabbhidā, ",
  "ja291:2.3": "tato naggo ca pottho ca ",
  "ja291:2.4": "pacchā bālo vihaññati ",
  "ja291:3.1": "evameva yo dhanaṃ laddhā ",
  "ja291:3.2": "amattā paribhuñjati, ",
  "ja291:3.3": "pacchā tapati dummedho ",
  "ja291:3.4": "kūṭaṃ bhinnova dhuttako’ti. ",
  "ja291:4.1": ""
}
