  "ja313:1.1": "yo te hatthe ca pāde ca ",
  "ja313:1.2": "kaṇṇanāsañca chedayi, ",
  "ja313:1.3": "tassa kujjha mahāvīra ",
  "ja313:1.4": "mā raṭṭhaṃ vinassā idaṃ. ",
  "ja313:2.1": "yo me hatthe ca pāde ca ",
  "ja313:2.2": "kaṇṇanāsañca chedayi, ",
  "ja313:2.3": "ciraṃ jīvatu so rājā ",
  "ja313:2.4": "na hi kujjhanti mādisā. ",
  "ja313:3.1": "ahū atītamaddhānaṃ ",
  "ja313:3.2": "samaṇo khattidīpano, ",
  "ja313:3.3": "taṃ khantiyāyeva ṭhitaṃ ",
  "ja313:3.4": "kāsirājā achedayi. ",
  "ja313:4.1": "tassa kammassa pharusassa ",
  "ja313:4.2": "vipāko kaṭuko ahu, ",
  "ja313:4.3": "yaṃ kāsirājā vedesi ",
  "ja313:4.4": "nirayamhi samappito’ti. ",
  "ja313:5.1": "khantivādijātakaṃ. "
}
