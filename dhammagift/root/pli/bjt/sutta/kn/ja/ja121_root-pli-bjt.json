  "ja121:0.3": "13. kusanāḷivaggo ",
  "ja121:0.4": "",
  "ja121:1.1": "kare sarikkho athavāpi seṭṭho ",
  "ja121:1.2": "nihīnako cā’pi kareyya eko, ",
  "ja121:1.3": "kareyyuṃ te vyasane uttamatthaṃ ",
  "ja121:1.4": "yathā ahaṃ kusanāḷī rucāya’nti. ",
  "ja121:2.1": "1. kusanāḷijātakaṃ. "
}
