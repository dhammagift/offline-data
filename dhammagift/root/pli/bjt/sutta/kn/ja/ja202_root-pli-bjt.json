  "ja202:0.4": "1. bandhanāgārajātakaṃ. ",
  "ja202:1.1": "haṃsā koñcā mayūrā ca ",
  "ja202:1.2": "hatthiyo pasadā migā, ",
  "ja202:1.3": "sabbe sīhassa bhāyanti ",
  "ja202:1.4": "natthi kāyasmiṃ tulyatā. ",
  "ja202:2.1": "evameva manussesu ",
  "ja202:2.2": "daharo cepi paññavā ",
  "ja202:2.3": "so hi tattha mahā bhoti ",
  "ja202:2.4": "neva bālo sarīravā’ti. ",
  "ja202:3.1": ""
}
