{
  "ja427:0.1": "9. navakanipāto ",
  "ja427:0.2": "",
  "ja427:0.3": "",
  "ja427:0.4": "",
  "ja427:1.1": "parisaṅkupatho nāma ",
  "ja427:1.2": "gijjhapantho sanantano, ",
  "ja427:1.3": "tatrāsi mātāpitaro ",
  "ja427:1.4": "gijjho posesi jiṇṇake. ",
  "ja427:1.5": "tesaṃ ajagaraṃ medaṃ ",
  "ja427:1.6": "accahāsi pahūtaso, ",
  "ja427:2.1": "pitā ca puttaṃ avaca ",
  "ja427:2.2": "jānaṃ uccaṃpapātinaṃ ",
  "ja427:2.3": "supattaṃ pakkhasampannaṃ ",
  "ja427:2.4": "tejassiṃ dūragāminaṃ. ",
  "ja427:3.1": "pariplavantaṃ paṭhaviṃ ",
  "ja427:3.2": "yadā tāta vijānahi, ",
  "ja427:3.3": "sāgarena parikkhittaṃ ",
  "ja427:3.4": "cakkaṃva parimaṇḍalaṃ. ",
  "ja427:3.5": "tato tāta nivattassu ",
  "ja427:3.6": "māssu etto paraṃ gamī. ",
  "ja427:4.1": "uddhaṃ pattosa vegena ",
  "ja427:4.2": "balī pakkhī dijuttamo, ",
  "ja427:4.3": "olokayanto vakkaṅgo ",
  "ja427:4.4": "pabbatāni vanāni ca. ",
  "ja427:5.1": "addasā paṭhaviṃ gijjho ",
  "ja427:5.2": "yathā sāsi pitussutaṃ, ",
  "ja427:5.3": "sāgarena parikkhittaṃ ",
  "ja427:5.4": "cakkaṃva parimaṇḍalaṃ. ",
  "ja427:6.1": "tañca so samatikkamma ",
  "ja427:6.2": "parameva pavattatha, ",
  "ja427:6.3": "tañca vātasikhā tikkhā ",
  "ja427:6.4": "accahāsi baliṃ dijaṃ. ",
  "ja427:7.1": "nāsakkhātigato poso ",
  "ja427:7.2": "punareva nivattituṃ, ",
  "ja427:7.3": "dijo vyasanamāpādi ",
  "ja427:7.4": "verambānaṃ vasaṃ gato. ",
  "ja427:8.1": "tassa puttā ca dārā ca ",
  "ja427:8.2": "ye caññe anujīvino, ",
  "ja427:8.3": "sabbe vyasanamāpāduṃ ",
  "ja427:8.4": "anovādakare dije. ",
  "ja427:9.1": "evampi idha vaddhānaṃ ",
  "ja427:9.2": "yo vākyaṃ nāvabujjhati, ",
  "ja427:9.3": "atīsīmacaro ditto ",
  "ja427:9.4": "gijjhovātītasāsano ",
  "ja427:9.5": "sa ce vyasanaṃ pappoti ",
  "ja427:9.6": "akatvā vuddhasāsananti. ",
  "ja427:10.1": "1. gijjhajātakaṃ. "
}
