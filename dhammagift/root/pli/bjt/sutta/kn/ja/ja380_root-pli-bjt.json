  "ja380:0.4": "",
  "ja380:1.1": "āsāvatī nāma latā ",
  "ja380:1.2": "jātā cittalatāvane, ",
  "ja380:1.3": "tassā vassasahassena ",
  "ja380:1.4": "ekaṃ nibbattate phalaṃ. ",
  "ja380:2.1": "taṃ devā paṭirupāsanti ",
  "ja380:2.2": "tāva duraphalaṃ satiṃ. ",
  "ja380:2.3": "āsiṃseva tuvaṃ rāja ",
  "ja380:2.4": "āsaphalavatī sukhā, ",
  "ja380:3.1": "āsiṃsetheva so pakkhī ",
  "ja380:3.2": "āsiṃsetheva so dijo. ",
  "ja380:3.3": "tassa cāsā samijjhittha ",
  "ja380:3.4": "tāva duragatā satī ",
  "ja380:3.5": "āsiṃseva tuvaṃ rāja ",
  "ja380:3.6": "āsā phalavatī sukhā. ",
  "ja380:4.1": "sampesi kho maṃ vācāya ",
  "ja380:4.2": "na ca sampesi kammunā, ",
  "ja380:4.3": "mālā sereyyakasseva ",
  "ja380:4.4": "vaṇṇavannā agandhikā. ",
  "ja380:5.1": "aphalaṃ madhuraṃ vācaṃ ",
  "ja380:5.2": "yo mittesu pakubbati, ",
  "ja380:5.3": "addaṃ avissajaṃ bhogaṃ ",
  "ja380:5.4": "sandhi tenassa jīrati. ",
  "ja380:6.1": "yaṃ hi kayirā taṃ hi vade ",
  "ja380:6.2": "yaṃ na kayirā na taṃ vade, ",
  "ja380:6.3": "akarontaṃ bhāsamānaṃ ",
  "ja380:6.4": "parijānanti paṇḍitā. ",
  "ja380:7.1": "balañca vata me khīṇaṃ ",
  "ja380:7.2": "patheyyañca na vijjati, ",
  "ja380:7.3": "saṅke pāṇūparodhāya ",
  "ja380:7.4": "handandāni vajāmahaṃ. ",
  "ja380:8.1": "etadeva hi me nāma ",
  "ja380:8.2": "yaṃ nāmasmiṃ rathesabha, ",
  "ja380:8.3": "āgamehi mahārāja ",
  "ja380:8.4": "pitaraṃ āmantayāmaha’nti. ",
  "ja380:9.1": "5. āsaṅkajātakaṃ. "
}
