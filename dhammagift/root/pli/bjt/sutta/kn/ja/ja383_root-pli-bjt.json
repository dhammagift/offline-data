  "ja383:0.4": "",
  "ja383:1.1": "sucittapattacchadana ",
  "ja383:1.2": "tambacūḷa vihaṅgama, ",
  "ja383:1.3": "oroha dumasākhāya ",
  "ja383:1.4": "mudhā bhariyā bhavāmi te. ",
  "ja383:2.1": "catuppadī tvaṃ kalyāṇi ",
  "ja383:2.2": "dvipadāhaṃ manorame, ",
  "ja383:2.3": "migī pakkhī asaṃyuttā ",
  "ja383:2.4": "aññaṃ pariyesa sāmikaṃ. ",
  "ja383:3.1": "komārikā te hessāmi ",
  "ja383:3.2": "mañjukā piyabhāṇini, ",
  "ja383:3.3": "vinda maṃ ariyena vedena ",
  "ja383:3.4": "sāvayā maṃ yadicchasi. ",
  "ja383:4.1": "sakuṇādini lohitape ",
  "ja383:4.2": "corī kukkuṭapothini, ",
  "ja383:4.3": "na tvaṃ ariyena vedena ",
  "ja383:4.4": "mamaṃ bhattāra micchasi. ",
  "ja383:5.1": "evampi caturā nārī ",
  "ja383:5.2": "disvāna pavaraṃ naraṃ, ",
  "ja383:5.3": "nenti saṇhāhi vācāhi ",
  "ja383:5.4": "biḷārī viya kukkuṭaṃ. ",
  "ja383:6.1": "yo ve uppatitaṃ atthaṃ ",
  "ja383:6.2": "nakhippamanubujjhati, ",
  "ja383:6.3": "amittavasamanveti ",
  "ja383:6.4": "pacchā ca manutappati. ",
  "ja383:7.1": "yo ca uppatitaṃ atthaṃ ",
  "ja383:7.2": "khippameva nibodhati, ",
  "ja383:7.3": "muccate sattusambādhā ",
  "ja383:7.4": "kukkuṭova biḷāriyā’ti. ",
  "ja383:8.1": "kukkuṭajātakaṃ. "
}
