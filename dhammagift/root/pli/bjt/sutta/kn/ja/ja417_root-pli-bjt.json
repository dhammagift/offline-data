{
  "ja417:0.1": "8. aṭṭhakanipāto ",
  "ja417:0.2": "",
  "ja417:0.3": "",
  "ja417:0.4": "",
  "ja417:1.1": "odātavatthā suci allakesā ",
  "ja417:1.2": "kaccāni kiṃ kumbhimadhissayitvā, ",
  "ja417:1.3": "piṭṭhā tilā dhovasi taṇḍulāni ",
  "ja417:1.4": "tilodano hohiti kissa hetu. ",
  "ja417:2.1": "na kho ayaṃ brāhmaṇa bhojanatthā ",
  "ja417:2.2": "tilodano hohiti sādhupaññā, ",
  "ja417:2.3": "dhammo mato tassa bahūtamajja ",
  "ja417:2.4": "ahaṃ karissāmi susānamajjhe. ",
  "ja417:3.1": "anuvicca kaccāni karohi kiccaṃ ",
  "ja417:3.2": "dhammo mato konu tavetasaṃsī, ",
  "ja417:3.3": "sahassanetto atulānubhāvo ",
  "ja417:3.4": "na mīyati dhammavaro kadāci. ",
  "ja417:4.1": "daḷhappamāṇaṃ mama ettha brahme ",
  "ja417:4.2": "dhammo mato natthi mamettha kaṅkhā, ",
  "ja417:4.3": "ye yevadāni pāpā bhavanti ",
  "ja417:4.4": "te tevadāni sukhitā bhavanti. ",
  "ja417:5.1": "suṇisā hi mayhaṃ vañjhā ahosi ",
  "ja417:5.2": "sā maṃ vadhitvāna vijāyi puttaṃ, ",
  "ja417:5.3": "sādāni sabbassa kulassa issarā ",
  "ja417:5.4": "ahaṃ panambhī apaviddhā ekikā. ",
  "ja417:6.1": "jīvāmi vohaṃ nāhaṃ matosmi ",
  "ja417:6.2": "taveva atthāya idhāgatosmi, ",
  "ja417:6.3": "yā taṃ vadhitvāna vijāyi puttaṃ ",
  "ja417:6.4": "sahāva puttena karomi bhasmaṃ. ",
  "ja417:7.1": "etañca te ruccati devarāja ",
  "ja417:7.2": "mameva atthāya idhāgatosi, ",
  "ja417:7.3": "ahañca putto suṇisā ca nattā ",
  "ja417:7.4": "sammodamānā gharamāvasema. ",
  "ja417:8.1": "etañca te ruccati kātiyāni ",
  "ja417:8.2": "hatāpi santā na jahāsi dhammaṃ, ",
  "ja417:8.3": "tuvañca putto suṇisā ca nattā ",
  "ja417:8.4": "sammodamānā gharamāvasetha. ",
  "ja417:9.1": "sā kātiyānī suṇisāya saddhiṃ ",
  "ja417:9.2": "sammodamānā gharamāvasitvā, ",
  "ja417:9.3": "sutto ca nattā ca upaṭṭhahiṃsu ",
  "ja417:9.4": "devānamindena adhiggahītā’ti. ",
  "ja417:10.1": "kaccānijātakaṃ. "
}
