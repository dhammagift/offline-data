  "ja210:0.1": "",
  "ja210:0.2": "",
  "ja210:0.3": "",
  "ja210:0.4": "9. kakkarajātakaṃ. ",
  "ja210:1.1": "ambho ko nāmayaṃ rukkho ",
  "ja210:1.2": "sīnapatto sakaṇṭako, ",
  "ja210:1.3": "yattha ekappahārena ",
  "ja210:1.4": "uttamaṅgaṃ vighāṭitaṃ. ",
  "ja210:2.1": "ācaritāyaṃ vitudaṃ vanāni ",
  "ja210:2.2": "kaṭṭhaṅgarukkhesu asārakesu, ",
  "ja210:2.3": "athāsadā khadiraṃ jātasāraṃ ",
  "ja210:2.4": "yatthabhidā garuḷo uttamaṅganti. ",
  "ja210:3.1": "",
  "ja210:3.2": "10 kandagaḷakajātakaṃ. nataṃdaḷhavaggo chaṭṭho ",
  "ja210:4.1": "tassuddānaṃ: ",
  "ja210:5.1": "daḷhabandhanahaṃsavaro ca puna ",
  "ja210:5.2": "virūpakkha saviṭṭhakamacchavaro ",
  "ja210:5.3": "sakuruṅgasaassakaambavaro ",
  "ja210:5.4": "puna kakkarako garuḷena dasa. "
}
