{
  "ja331:0.1": "",
  "ja331:0.2": "",
  "ja331:0.3": "4. kokālika vaggo ",
  "ja331:0.4": "",
  "ja331:1.1": "yo ve kāle asampatte ",
  "ja331:1.2": "ativelaṃ pabhāsati, ",
  "ja331:1.3": "evaṃ so nihato seti ",
  "ja331:1.4": "kokilāyiva atrajo. ",
  "ja331:2.1": "na hi satthaṃ sunisitaṃ ",
  "ja331:2.2": "visaṃ halāhalaṃ iva, ",
  "ja331:2.3": "evaṃ nikaṭṭhe pāteti ",
  "ja331:2.4": "vācā dubbhāsitā yathā. ",
  "ja331:3.1": "tasmā kāle akāle ca ",
  "ja331:3.2": "vācaṃ rakkheyya paṇḍito, ",
  "ja331:3.3": "nātivelaṃ pabhāseyya ",
  "ja331:3.4": "api attasamamhi vā ",
  "ja331:4.1": "yo ca kāle mitaṃ bhāse ",
  "ja331:4.2": "matipubbo vicakkhaṇo. ",
  "ja331:4.3": "sabbe amitte ādeti ",
  "ja331:4.4": "supaṇṇo uragaṃ ",
  "ja331:5.1": "ivā’ti. "
}
