  "ja355:0.3": "",
  "ja355:0.4": "4. uragajātakaṃ. ",
  "ja355:1.1": "aññe socanti rodanti ",
  "ja355:1.2": "aññe assumukhā janā, ",
  "ja355:1.3": "pasannamukhavaṇṇosi ",
  "ja355:1.4": "kasmā ghata na socasi. ",
  "ja355:2.1": "nābhatītaharo soko ",
  "ja355:2.2": "nānāgatasukhāvabho, ",
  "ja355:2.3": "tasmā dhaṃka na socāmi ",
  "ja355:2.4": "natthi soko dutīyatā. ",
  "ja355:3.1": "socaṃ paṇḍu kiso hoti ",
  "ja355:3.2": "bhattañcassa na ruccati, ",
  "ja355:3.3": "amittā sumanā honti ",
  "ja355:3.4": "sallaviddhassa na ruppato. ",
  "ja355:4.1": "gāme vā yadi vā raññe ",
  "ja355:4.2": "ninne vā yadi vā thale, ",
  "ja355:4.3": "ṭhitaṃ maṃ nāgamissati ",
  "ja355:4.4": "evaṃ diṭṭhapado ahaṃ ",
  "ja355:5.1": "yassattā nālamekova ",
  "ja355:5.2": "sabbakāmarasāraho, ",
  "ja355:5.3": "sabbāpi yaṭhavī tassa ",
  "ja355:5.4": "na sukhaṃ āvahissatīti. ",
  "ja355:6.1": ""
}
