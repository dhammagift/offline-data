  "ja447:0.3": "",
  "ja447:0.4": "8. takkalajātakaṃ. ",
  "ja447:1.1": "kinte vataṃ kimpana brahmacariyaṃ ",
  "ja447:1.2": "kissa suciṇṇassa ayaṃ vipāko, ",
  "ja447:1.3": "akkhāhi me brāhmaṇa etamatthaṃ ",
  "ja447:1.4": "kasmā hi tumhaṃ daharā na mīyare. ",
  "ja447:2.1": "dhammaṃ carāma na musā bhaṇāma ",
  "ja447:2.2": "pāpāni kammāni vivajjayāma, ",
  "ja447:2.3": "anariyaṃ parivajjemu sabbaṃ ",
  "ja447:2.4": "tasmā hi amhaṃ daharā na mīyare. ",
  "ja447:3.1": "suṇoma dhammaṃ asataṃ sataṃ ca ",
  "ja447:3.2": "na cāpi dhammaṃ asataṃ rocayāma ",
  "ja447:3.3": "hitvā asante na jahāma sante ",
  "ja447:3.4": "tasmā hi amhaṃ daharā na mīyare. ",
  "ja447:4.1": "pubbeva dānā sumanā bhavāma ",
  "ja447:4.2": "dadampi ce attamanā bhavāma, ",
  "ja447:4.3": "datvāpi ce nānutappāma pacchā ",
  "ja447:4.4": "tasmā hi amhaṃ daharā na mīyare. ",
  "ja447:5.1": "samaṇe mayaṃ brāhmaṇe addhike ca ",
  "ja447:5.2": "vaṇibbake yācanake daḷidde, ",
  "ja447:5.3": "annena pānena abhitappayāma ",
  "ja447:5.4": "tasmā hi amhaṃ daharā na mīyare. ",
  "ja447:6.1": "mayañca bhariyā nātikkamāma ",
  "ja447:6.2": "amhe ca bhariyā nātikkamanti, ",
  "ja447:6.3": "aññatra tāhi brahmacariyaṃ carāma ",
  "ja447:6.4": "tasmā hi amhaṃ daharā na mīyare. ",
  "ja447:7.1": "pāṇātipātā viramāma sabbe ",
  "ja447:7.2": "loke adidannaṃ parivajjayāma, ",
  "ja447:7.3": "amajjapā no ca musā bhaṇāma ",
  "ja447:7.4": "tasmā hi amhaṃ daharā na mīyare. ",
  "ja447:8.1": "etāsu ce jāyare suttamāsu ",
  "ja447:8.2": "medhāvino honti pahūtapaññā ",
  "ja447:8.3": "bahussutā vedaguno ca honti ",
  "ja447:8.4": "tasmā hi amhaṃ daharā na mīyare. ",
  "ja447:9.1": "mātāpitā ca bhaginī bhātaro ca ",
  "ja447:9.2": "puttā ca dārā ca mayañca sabbe, ",
  "ja447:9.3": "dhammaṃ carāma paralokahetu. ",
  "ja447:9.4": "tasmā hi amhaṃ daharā na mīyare. ",
  "ja447:10.1": "dāsā ca dasso anujīvino ca ",
  "ja447:10.2": "paricārakā kammakarā ca sabbe, ",
  "ja447:10.3": "dhammaṃ caranti paralokahetu ",
  "ja447:10.4": "tasmā hi amhaṃ daharā na mīyare. ",
  "ja447:11.1": "dhammo have rakkhati dhammacāriṃ ",
  "ja447:11.2": "dhammo suciṇṇo sukhamāvahāti ",
  "ja447:11.3": "esānisaṃso dhammo suciṇṇe ",
  "ja447:11.4": "na duggatiṃ gacchati dhammacārī. ",
  "ja447:12.1": "dhammo have rakkhati dhammacāriṃ ",
  "ja447:12.2": "chattaṃ mahantaṃ viya vassakāle, ",
  "ja447:12.3": "dhammena gutto mama dhammapālo ",
  "ja447:12.4": "aññassa aṭṭhīni sukhī kumāroti. ",
  "ja447:13.1": ""
}
