  "ja293:1.1": "phuṭṭhassa me aññatarena vyādhinā ",
  "ja293:1.2": "rogena bāḷhaṃ dukhitassa ruppato, ",
  "ja293:1.3": "parisussati khippamidaṃ kaḷebaraṃ ",
  "ja293:1.4": "pupphaṃ yathā saṃsuni ātape kataṃ. ",
  "ja293:2.1": "ajaññaṃ jaññasaṅkhātaṃ ",
  "ja293:2.2": "asuciṃ sucisammataṃ, ",
  "ja293:2.3": "nānākuṇapaparipūraṃ ",
  "ja293:2.4": "jaññarūpaṃ apassato ",
  "ja293:3.1": "dhiratthu taṃ āturaṃ pūtikāyaṃ ",
  "ja293:3.2": "jegucchiyaṃ asuciṃ byādhidhammaṃ, ",
  "ja293:3.3": "yatthappamantā adhimucchitā pajā ",
  "ja293:3.4": "hāpenti maggaṃ sugatūpapattiyā’ti ",
  "ja293:4.1": ""
}
