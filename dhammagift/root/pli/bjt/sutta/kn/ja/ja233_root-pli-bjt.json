  "ja233:1.1": "vīṇāthūṇajātakaṃ kāmaṃ yahiṃ icchasi tena gaccha ",
  "ja233:1.2": "viddhosi mammamhi vikaṇṇakena, ",
  "ja233:1.3": "hatosi bhattena savāditena ",
  "ja233:1.4": "lolo ca macche anubandhamāno ",
  "ja233:2.1": "evampi lokāmisaṃ opatanto, ",
  "ja233:2.2": "vihaññati cittavasānuvattī, ",
  "ja233:2.3": "so haññati ñātisakhānamajjhe ",
  "ja233:2.4": "macchānugo soriva suṃsumāroti. ",
  "ja233:3.1": ""
}
