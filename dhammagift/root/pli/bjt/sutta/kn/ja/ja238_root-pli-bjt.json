  "ja238:0.4": "7. sāketajātakaṃ. ",
  "ja238:1.1": "iṅgha ekapadaṃ tāta ",
  "ja238:1.2": "anekatthapadanissitaṃ, ",
  "ja238:1.3": "kiñci saṅgāhikaṃ brūhi ",
  "ja238:1.4": "yenatthe sāvayāmase. ",
  "ja238:2.1": "dakkheyyekapadaṃ tāta ",
  "ja238:2.2": "anekattha padassitaṃ, ",
  "ja238:2.3": "tañca sīlena saṃyuttaṃ ",
  "ja238:2.4": "khantiyā upapāditaṃ. ",
  "ja238:2.5": "alaṃ mitte sukhāpetuṃ ",
  "ja238:2.6": "amittānaṃ dukhāya cāti. ",
  "ja238:3.1": ""
}
