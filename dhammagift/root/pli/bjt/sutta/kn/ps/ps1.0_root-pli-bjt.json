{
  "ps1.0:0.1": "suttantapiṭake khuddakanikāyo paṭisambhidāmaggo 1. paṭhamo paṇṇāsako namo tassa bhagavato arahato sammāsambuddhassa. ",
  "ps1.0:0.2": "1. mahāvaggo ",
  "ps1.0:0.3": "1. ñāṇakathā. mātikā ",
  "ps1.0:0.4": "",
  "ps1.0:1.1": "sotāvadhāne paññā sutamaye ñāṇaṃ. ",
  "ps1.0:2.1": "sutvāna saṃvare paññā sīlamaye ñāṇaṃ. ",
  "ps1.0:3.1": "saṃvaritvā samādahane paññā samādhibhāvanāmaye ñāṇaṃ. ",
  "ps1.0:4.1": "paccayapariggahe paññā dhammaṭṭhiti ñāṇaṃ. ",
  "ps1.0:5.1": "atītānāgatapaccuppannānaṃ dhammānaṃ saṅkhipitvā vavatthāne paññā sammasane ñāṇaṃ. ",
  "ps1.0:6.1": "paccuppannānaṃ dhammānaṃ viparināmānupassane paññā udayabbayānupassane ñāṇaṃ. ",
  "ps1.0:7.1": "ārammaṇaṃ paṭisaṅkhā bhaṅgānupassane paññā vipassane ñāṇaṃ. ",
  "ps1.0:8.1": "bhayatupaṭṭhāne paññā ādīnave ñāṇaṃ. ",
  "ps1.0:9.1": "muñcitukamyatāpaṭisaṅkhāsantiṭṭhanā paññā saṅkhārupekkhāsu ñāṇaṃ. ",
  "ps1.0:10.1": "bahiddhā vuṭṭhānavivaṭṭane paññā gotrabhū ñāṇaṃ. ",
  "ps1.0:11.1": "dubhato vuṭṭhānavivaṭṭane paññā magge ñāṇaṃ. ",
  "ps1.0:12.1": "payogapaṭippassaddhi paññā phale ñāṇaṃ. ",
  "ps1.0:13.1": "chinnavaṭṭamanupassane paññā vimutti ñāṇaṃ. ",
  "ps1.0:14.1": "tadā samudāgate dhamme passane paññā paccavekkhane ñāṇaṃ. ",
  "ps1.0:15.1": "ajjhattavavatthāne paññā vatthunānatte ñāṇaṃ. ",
  "ps1.0:16.1": "bahiddhāvavatthāne paññā gocaranānatte ñāṇaṃ. ",
  "ps1.0:17.1": "cariyāvavatthāne paññā cariyānānatte ñāṇaṃ. ",
  "ps1.0:18.1": "catudhammavavatthāne paññā bhūminānatte ñāṇaṃ. ",
  "ps1.0:19.1": "navadhammavavatthāne paññā dhammanānatte ñāṇaṃ. ",
  "ps1.0:20.1": "abhiññāpaññā ñātaṭṭhe ñāṇaṃ. ",
  "ps1.0:21.1": "pariññāpaññā tīraṇaṭṭhe ñāṇaṃ. ",
  "ps1.0:22.1": "pahāne paññā pariccāgaṭṭhe ñāṇaṃ. ",
  "ps1.0:23.1": "bhāvanāpaññā ekarasaṭṭhe ñāṇaṃ. ",
  "ps1.0:24.1": "sacchikiriyāpaññā phusanaṭṭhe ñāṇaṃ. ",
  "ps1.0:25.1": "atthanānatte paññā atthapaṭisambhide ñāṇaṃ. ",
  "ps1.0:26.1": "dhammanānatte paññā dhammapaṭisambhide ñāṇaṃ. ",
  "ps1.0:27.1": "niruttinānatte paññā niruttipaṭisambhide ñāṇaṃ. ",
  "ps1.0:28.1": "paṭibhāna nānatte paññā paṭibhānapaṭisambhide ñāṇaṃ. ",
  "ps1.0:29.1": "vihāranānatte paññā vihāraṭṭhe ñāṇaṃ. ",
  "ps1.0:30.1": "samāpattinānatte paññā samāpattaṭṭhe ñāṇaṃ. ",
  "ps1.0:31.1": "vihārasamāttinānatte paññā vihārasamāpattaṭṭhe ñāṇaṃ. ",
  "ps1.0:32.1": "avikkhepaparisuddhattā āsavasamucchede paññā ānantarikasamādhismiṃ ñāṇaṃ. ",
  "ps1.0:33.1": "dassanādhipateyyaṃ santo ca vihārādhigamo paṇītādhimuttatā paññā araṇavihāre ñāṇaṃ. ",
  "ps1.0:34.1": "dvīhi balehi samannāgatattā tayo ca saṅkhārānaṃ paṭippassaddhiyā soḷasahi ñāṇacariyāhi navahi samādhicariyāhi vasibhāvatā paññā nirodhasamāpattiyā ñāṇaṃ. ",
  "ps1.0:35.1": "sampajānassa pavattapariyādāne paññā parinibbāne ñāṇaṃ. ",
  "ps1.0:36.1": "sabbadhammānaṃ sammā samucchede nirodhe ca anupaṭṭhānatā paññā samasīsaṭṭhe ñāṇaṃ. ",
  "ps1.0:37.1": "puthunānattatejapariyodāne paññā sallekhaṭṭhe ñāṇaṃ. ",
  "ps1.0:38.1": "asallīnatta pahitatta-paggahaṭṭhe paññā viriyārambhe ñāṇaṃ. ",
  "ps1.0:39.1": "nānādhammapakāsantā paññā atthasandassane ñāṇaṃ. ",
  "ps1.0:40.1": "sabbadhammānaṃ ekasaṅgahatānānattekattapaṭivedhe paññā dassanavisuddhiñāṇaṃ. ",
  "ps1.0:41.1": "viditattā paññā khanti ñāṇaṃ. ",
  "ps1.0:42.1": "phuṭṭhattā paññā pariyogāhane ñāṇaṃ. ",
  "ps1.0:43.1": "samodahane paññā padesavihāre ñāṇaṃ. ",
  "ps1.0:44.1": "adhipatattā paññā saññāvivaṭṭe ñāṇaṃ. ",
  "ps1.0:45.1": "nānatte paññā cetovivaṭṭe ñāṇaṃ. ",
  "ps1.0:46.1": "adhiṭṭhāne paññā cittavivaṭṭe ñāṇaṃ. ",
  "ps1.0:47.1": "suññate paññā ñāṇavivaṭṭe ñāṇaṃ. ",
  "ps1.0:48.1": "vossagge paññā vimokkhavivaṭṭe ñāṇaṃ. ",
  "ps1.0:49.1": "tathaṭṭhe paññā saccavivaṭṭe ñāṇaṃ. ",
  "ps1.0:50.1": "kāyampi cittampi ekavavatthānatā sukhasaññañca lahusaññañca adhiṭṭhānavasena ijjhanaṭṭhe paññā iddhividhe ñāṇaṃ. ",
  "ps1.0:51.1": "vitakkavipphāravasena nānattekatta saddanimittānaṃ pariyogāhane paññā sotadhātuvisuddhiñāṇaṃ. ",
  "ps1.0:52.1": "tiṇṇaṃ cittānaṃ vipphārattā indriyānaṃ pasādavasena nānattekattaviññāṇacariyāpariyogāhane paññā cetopariyañāṇaṃ. ",
  "ps1.0:53.1": "paccayappavattānaṃ dhammānaṃ nānattekattakammavipphāravasena pariyogāhane paññā pubbenivāsānussati ñāṇaṃ. ",
  "ps1.0:54.1": "obhāsavasena nānattekattarūpanimittānaṃ dassanaṭṭhe paññā dibbacakkhuñāṇaṃ. ",
  "ps1.0:55.1": "catusaṭṭhiyā ākārehi tiṇṇaṃ indriyānaṃ vasibhāvatā paññā āsavānaṃ khaye ñāṇaṃ. ",
  "ps1.0:56.1": "pariññaṭṭhe paññā dukkhe ñāṇaṃ. ",
  "ps1.0:57.1": "pahānaṭṭhe paññā samudaye ñāṇaṃ. ",
  "ps1.0:58.1": "sacchikiriyaṭṭhe paññā nirodhe ñāṇaṃ. ",
  "ps1.0:59.1": "bhāvanaṭṭhe paññā magge ñāṇaṃ. ",
  "ps1.0:60.1": "dukkhe ñāṇaṃ. ",
  "ps1.0:61.1": "dukkhasamudaye ñāṇaṃ. ",
  "ps1.0:62.1": "dukkhanirodhe ñāṇaṃ. ",
  "ps1.0:63.1": "dukkhanirodhagāminiyā paṭipadāya ñāṇaṃ. ",
  "ps1.0:64.1": "atthapaṭisambhide ñāṇaṃ. ",
  "ps1.0:65.1": "dhammapaṭisambhide ñāṇaṃ. ",
  "ps1.0:66.1": "niruttipaṭisambhide ñāṇaṃ, ",
  "ps1.0:67.1": "paṭibhānapaṭisambhide ñāṇaṃ. ",
  "ps1.0:68.1": "indriyaparopariyattañāṇaṃ. ",
  "ps1.0:69.1": "sattānaṃ āsayānusaye ñāṇaṃ. ",
  "ps1.0:70.1": "yamakapāṭihīre ñāṇaṃ. ",
  "ps1.0:71.1": "mahākaruṇāsamāpattiyā ñāṇaṃ. ",
  "ps1.0:72.1": "sabbaññutañāṇaṃ. ",
  "ps1.0:73.1": "anāvaraṇañāṇaṃ. ",
  "ps1.0:74.1": "imāni tesattati ñāṇāni. ",
  "ps1.0:74.2": "imesaṃ tesattatiyā ñāṇānaṃ sattasaṭṭhi ñāṇāni sāvakasādhāraṇāni. ",
  "ps1.0:74.3": "cha ñāṇāni asādhāraṇāni sāvekehi. ",
  "ps1.0:74.4": "mātikā niṭṭhitā. "
}
