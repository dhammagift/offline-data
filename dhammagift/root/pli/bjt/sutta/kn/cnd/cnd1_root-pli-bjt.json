{
  "cnd1:0.1": "suttantapiṭake khuddakanikāye cullaniddesapāḷi namo tassa bhagavato arahato sammāsambuddhassa pārāyana vaggo ",
  "cnd1:0.2": "",
  "cnd1:0.3": "",
  "cnd1:0.4": "vatthugāthā ",
  "cnd1:1.1": "kosalānaṃ purā rammā- ",
  "cnd1:1.2": "agamā dakkhiṇāpathaṃ ",
  "cnd1:1.3": "ākiñcaññaṃ patthayāno- ",
  "cnd1:1.4": "brāhmaṇo mantapāragū. ",
  "cnd1:2.1": "so assakassa visaye- ",
  "cnd1:2.2": "mūlakassa samāsane ",
  "cnd1:2.3": "vasī godāvarī kūle- ",
  "cnd1:2.4": "uñchena ca phalena ca. ",
  "cnd1:3.1": "tasse va upanissāya- ",
  "cnd1:3.2": "gāmo ca vipulo ahu ",
  "cnd1:3.3": "tato jātena āyena- ",
  "cnd1:3.4": "mahāyaññamakappayī. ",
  "cnd1:4.1": "mahāyaññaṃ yajitvāna- ",
  "cnd1:4.2": "puna pāvisi assamaṃ ",
  "cnd1:4.3": "tasmiṃ patipaviṭṭhamhi- ",
  "cnd1:4.4": "añño āgañchi brāhmaṇo. ",
  "cnd1:5.1": "ugghaṭṭapādo tasito- ",
  "cnd1:5.2": "paṅkadanto rajassiro ",
  "cnd1:5.3": "so ca naṃ upasaṃkamma- ",
  "cnd1:5.4": "satāni pañca yācati. ",
  "cnd1:6.1": "tamenaṃ bāvarī disvā- ",
  "cnd1:6.2": "āsanena nimantayī ",
  "cnd1:6.3": "sukhaṃ ca kusalaṃ pucchi- ",
  "cnd1:6.4": "idaṃ vacanamabravī. ",
  "cnd1:7.1": "yaṃ kho mamaṃ deyyadhammaṃ- ",
  "cnd1:7.2": "sabbaṃ vissajjitaṃ mayā ",
  "cnd1:7.3": "anujānāhi me brahme- ",
  "cnd1:7.4": "natthi pañca satāni me. ",
  "cnd1:8.1": "sace me yācamānassa- ",
  "cnd1:8.2": "bhavaṃ nānupadassati ",
  "cnd1:8.3": "sattame divase tuyhaṃ- ",
  "cnd1:8.4": "muddhā phalatu sattadhā. ",
  "cnd1:9.1": "abhisaṅkharitvā kuhako- ",
  "cnd1:9.2": "bheravaṃ so akittayī ",
  "cnd1:9.3": "tassa taṃ vacanaṃ sutvā- ",
  "cnd1:9.4": "bāvarī dukkhito ahu. ",
  "cnd1:10.1": "ussussati anāhāro- ",
  "cnd1:10.2": "sokasallasamappito ",
  "cnd1:10.3": "atho’pi evaṃcittassa- ",
  "cnd1:10.4": "jhāne na ramatī mano. ",
  "cnd1:11.1": "utrastaṃ dukkhitaṃ disvā- ",
  "cnd1:11.2": "devatā atthakāminī ",
  "cnd1:11.3": "bāvariṃ upasaṅkamma- ",
  "cnd1:11.4": "idaṃ vacanamabravī. ",
  "cnd1:12.1": "na so muddhaṃ pajānāti- ",
  "cnd1:12.2": "kuhako so dhanatthiko ",
  "cnd1:12.3": "muddhani muddhapāte vā- ",
  "cnd1:12.4": "ñāṇaṃ tassa na vijjati. ",
  "cnd1:13.1": "bhotī carahi jānāti- ",
  "cnd1:13.2": "taṃ me akkhāhi pucchitā ",
  "cnd1:13.3": "muddhaṃ muddhādhipātaṃ ca- ",
  "cnd1:13.4": "taṃ suṇoma vaco tava. ",
  "cnd1:14.1": "ahampetaṃ na jānāmi- ",
  "cnd1:14.2": "ñāṇaṃ mettha na vijjati ",
  "cnd1:14.3": "muddhaṃ muddhādhipāto ca- ",
  "cnd1:14.4": "jinānaṃ hetadassanaṃ. ",
  "cnd1:15.1": "atha ko carahi jānāti- ",
  "cnd1:15.2": "asmiṃ puthavi maṇḍale ",
  "cnd1:15.3": "muddhaṃ muddhādhipātaṃ ca- ",
  "cnd1:15.4": "taṃ me akkhāhi devate, ",
  "cnd1:16.1": "purā kapilavatthumhā- ",
  "cnd1:16.2": "nikkhanto lokanāyako ",
  "cnd1:16.3": "apacco okkākarājassa- ",
  "cnd1:16.4": "sakyaputto pabhaṅkaro. ",
  "cnd1:17.1": "so hi brāhmaṇa, sambuddho- ",
  "cnd1:17.2": "sabbadhammāna pāragu ",
  "cnd1:17.3": "sabbābhiññābalappatto- ",
  "cnd1:17.4": "sabbadhammesu cakkhumā ",
  "cnd1:17.5": "sabbakammakkhayaṃ patto- ",
  "cnd1:17.6": "vimutto upadhisaṅkhaye. ",
  "cnd1:18.1": "buddho so bhagavā loke- ",
  "cnd1:18.2": "dhammaṃ deseti cakkhumā ",
  "cnd1:18.3": "taṃ tvaṃ gantvāna pucchassu- ",
  "cnd1:18.4": "so te taṃ vyākarissati. ",
  "cnd1:19.1": "sambuddhoti vaco sutvā- ",
  "cnd1:19.2": "udaggo bāvarī ahu ",
  "cnd1:19.3": "sokassa tanuko āsi- ",
  "cnd1:19.4": "pītiñca vipulaṃ labhi. ",
  "cnd1:20.1": "so bāvarī attamano udaggo ",
  "cnd1:20.2": "taṃ devataṃ pucchati vedajāto ",
  "cnd1:20.3": "katamamhi gāme nigamamhi vā puna ",
  "cnd1:20.4": "katamamhi vā janapade lokanātho ",
  "cnd1:20.5": "yattha gantvā namassemu- ",
  "cnd1:20.6": "sambuddhaṃ dipaduttamaṃ. ",
  "cnd1:21.1": "sāvatthiyaṃ kosalamandire jino ",
  "cnd1:21.2": "pahūtapañño varabhūrimedhaso ",
  "cnd1:21.3": "so sakyaputto vidhuro anāsavo ",
  "cnd1:21.4": "muddhādhipātassa vidū narāsabho. ",
  "cnd1:22.1": "tato āmantayī sisse- ",
  "cnd1:22.2": "brāhmaṇo mantapārage ",
  "cnd1:22.3": "etha māṇavā akkhissaṃ- ",
  "cnd1:22.4": "suṇotha vacanaṃ mama. ",
  "cnd1:23.1": "yasseso dullabho loke- ",
  "cnd1:23.2": "pātubhāvo abhiṇhaso ",
  "cnd1:23.3": "svajja lokamhi uppanno- ",
  "cnd1:23.4": "sambuddho iti vissuto ",
  "cnd1:23.5": "khippaṃ gantvāna sāvatthiṃ- ",
  "cnd1:23.6": "passavho dipaduttamaṃ. ",
  "cnd1:24.1": "kathaṃ carahi jānemu- ",
  "cnd1:24.2": "disvā buddhoti brāhmaṇa ",
  "cnd1:24.3": "ajānataṃ no pabrūhi- ",
  "cnd1:24.4": "yathā jānemu taṃ mayaṃ. ",
  "cnd1:25.1": "āgatāni hi mantesu- ",
  "cnd1:25.2": "mahāpurisalakkhaṇā ",
  "cnd1:25.3": "dvattiṃsa ca vyākhyātā- ",
  "cnd1:25.4": "samattā anupubbaso. ",
  "cnd1:26.1": "yassete honti gattesu- ",
  "cnd1:26.2": "mahāpurisalakkhaṇā ",
  "cnd1:26.3": "dveyeva tassa gatiyo- ",
  "cnd1:26.4": "tatiyā hi na vijjati. ",
  "cnd1:27.1": "sace agāraṃ āvasati- ",
  "cnd1:27.2": "vijeyya paṭhaviṃ imaṃ ",
  "cnd1:27.3": "adaṇḍena asatthena- ",
  "cnd1:27.4": "dhammenamanusāsati. ",
  "cnd1:28.1": "sace ca so pabbajati- ",
  "cnd1:28.2": "agārā anagāriyaṃ ",
  "cnd1:28.3": "vivaṭṭacchaddo sambuddho- ",
  "cnd1:28.4": "arahā bhavati anuttaro. ",
  "cnd1:29.1": "jātiṃ gottaṃ ca lakkhaṇaṃ- ",
  "cnd1:29.2": "mante sisse punāparaṃ ",
  "cnd1:29.3": "muddhaṃ muddhādhipātaṃ ca- ",
  "cnd1:29.4": "manasāyeva pucchatha. ",
  "cnd1:30.1": "anāvaraṇadassāvī- ",
  "cnd1:30.2": "yadi buddho bhavissati ",
  "cnd1:30.3": "manasā pucchite pañhe- ",
  "cnd1:30.4": "vācāya vissajessati. ",
  "cnd1:31.1": "bāvarissa vaco sutvā- ",
  "cnd1:31.2": "sissā soḷasa brāhmaṇā ",
  "cnd1:31.3": "ajito tissametteyyo- ",
  "cnd1:31.4": "puṇṇako atha mettagu. ",
  "cnd1:32.1": "dhotako upasīvo ca- ",
  "cnd1:32.2": "nando ca atha hemako ",
  "cnd1:32.3": "todeyyakappā dubhayo- ",
  "cnd1:32.4": "jatukaṇṇī ca paṇḍito. ",
  "cnd1:33.1": "bhadrāvudho udayo ca- ",
  "cnd1:33.2": "posālo cāpi brāhmaṇo ",
  "cnd1:33.3": "mogharājā ca medhāvī- ",
  "cnd1:33.4": "piṃgiyo ca mahāisi. ",
  "cnd1:34.1": "paccekagaṇino sabbe- ",
  "cnd1:34.2": "sabbalokassa vissutā ",
  "cnd1:34.3": "jhāyī jhānaratā dhīrā- ",
  "cnd1:34.4": "pubbavāsanavāsitā. ",
  "cnd1:35.1": "bāvariṃ abhivanditvā- ",
  "cnd1:35.2": "katvā ca naṃ padakkhiṇaṃ ",
  "cnd1:35.3": "jaṭājinadhārā sabbe- ",
  "cnd1:35.4": "pakkāmuṃ uttarāmukhā. ",
  "cnd1:36.1": "mūlakassa patiṭṭhānaṃ- ",
  "cnd1:36.2": "purimaṃ māhissatiṃ tathā ujjeniṃ ",
  "cnd1:36.3": "cāpi gonaddhaṃ- ",
  "cnd1:36.4": "vedisaṃ vanasavhayaṃ. ",
  "cnd1:37.1": "kosambiṃ cāpi sāketaṃ- ",
  "cnd1:37.2": "sāvatthiṃ ca puruttamaṃ ",
  "cnd1:37.3": "setavyaṃ kapilavatthuṃ- ",
  "cnd1:37.4": "kusināraṃ ca mandiraṃ. ",
  "cnd1:38.1": "pāvaṃ ca bhoganagaraṃ- ",
  "cnd1:38.2": "vesāliṃ māgadhaṃ puraṃ ",
  "cnd1:38.3": "pāsāṇakaṃ cetiyaṃ ca- ",
  "cnd1:38.4": "ramaṇīyaṃ manoramaṃ. ",
  "cnd1:39.1": "tasitovudakaṃ sītaṃ- ",
  "cnd1:39.2": "mahālābhaṃ va vāṇijo ",
  "cnd1:39.3": "chāyaṃ ghammābhitattova- ",
  "cnd1:39.4": "tusitā pabbatamārahuṃ. ",
  "cnd1:40.1": "bhagavā ca tasmiṃ samaye- ",
  "cnd1:40.2": "bhikkhusaṅghapurakkhato ",
  "cnd1:40.3": "bhikkhūnaṃ dhammaṃ deseti- ",
  "cnd1:40.4": "sīhova nadatī vane. ",
  "cnd1:41.1": "ajito addasa sambuddhaṃ-sataraṃsiṃ’ ",
  "cnd1:41.2": "va bhānumaṃ ",
  "cnd1:41.3": "candaṃ yathā paṇṇarase- ",
  "cnd1:41.4": "paripūrimupāgataṃ ",
  "cnd1:42.1": "athassa gatte disvāna- ",
  "cnd1:42.2": "paripūraṃ va byañjanaṃ ",
  "cnd1:42.3": "ekamantaṃ ṭhito haṭṭho- ",
  "cnd1:42.4": "manopañhe apucchatha. ",
  "cnd1:43.1": "ādissa jammanaṃ brūhi- ",
  "cnd1:43.2": "gottaṃ brūhi salakkhaṇaṃ ",
  "cnd1:43.3": "mantesu pāramiṃ brūhi- ",
  "cnd1:43.4": "kati vāceti brāhmaṇo. ",
  "cnd1:44.1": "vīsaṃ vassasataṃ āyu- ",
  "cnd1:44.2": "so ca gottena bāvarī ",
  "cnd1:44.3": "tīṇassa lakkhaṇā gatte- ",
  "cnd1:44.4": "tiṇṇaṃ vedāna pāragū. ",
  "cnd1:45.1": "lakkhaṇe itihāse ca- ",
  "cnd1:45.2": "sanighaṇḍu sakeṭuhe ",
  "cnd1:45.3": "pañca satāni vāceti- ",
  "cnd1:45.4": "sadhamme pāramiṃ gato. ",
  "cnd1:46.1": "lakkhaṇānaṃ pavicayaṃ- ",
  "cnd1:46.2": "bāvarissa naruttama ",
  "cnd1:46.3": "taṇhacchida pakāsehi- ",
  "cnd1:46.4": "mā no kaṅkhāyitaṃ ahu. ",
  "cnd1:47.1": "mukhaṃ jivhāya chādeti- ",
  "cnd1:47.2": "uṇṇassa bhamukantare ",
  "cnd1:47.3": "kosohitaṃ vatthaguyhaṃ- ",
  "cnd1:47.4": "evaṃ jānāhi māṇava. ",
  "cnd1:48.1": "pucchamhi kañci asuṇanto- ",
  "cnd1:48.2": "sutvā pañhe vyākate ",
  "cnd1:48.3": "vicinteti jano sabbo- ",
  "cnd1:48.4": "vedajāto katañjalī. ",
  "cnd1:49.1": "ko nu devo vā brahmā vā- ",
  "cnd1:49.2": "indo vāpi sujampati ",
  "cnd1:49.3": "manasā pucchite pañhe- ",
  "cnd1:49.4": "kametaṃ paṭibhāsati. ",
  "cnd1:50.1": "muddhaṃ muddhādhipātaṃ ca- ",
  "cnd1:50.2": "bāvarī paripucchati ",
  "cnd1:50.3": "taṃ vyākarohi bhagavā- ",
  "cnd1:50.4": "kaṅkhaṃ vinaya no ise, ",
  "cnd1:51.1": "avijjā muddhāti jānāhi- ",
  "cnd1:51.2": "vijjā muddhādhipātinī ",
  "cnd1:51.3": "saddhā sati samādhīhi- ",
  "cnd1:51.4": "chandaviriyena saṃyutā, ",
  "cnd1:52.1": "tato vedena mahatā- ",
  "cnd1:52.2": "santhambhitvāna māṇavo ",
  "cnd1:52.3": "ekaṃsaṃ ajinaṃ katvā- ",
  "cnd1:52.4": "pādesu sirasā patī. ",
  "cnd1:53.1": "bāvarī brāhmaṇo bhoto- ",
  "cnd1:53.2": "saha sissehi mārisa ",
  "cnd1:53.3": "udaggacitto sumano- ",
  "cnd1:53.4": "pāde vandati cakkhuma, ",
  "cnd1:54.1": "sukhito bāvarī hotu- ",
  "cnd1:54.2": "saha sissehi brāhmaṇo ",
  "cnd1:54.3": "tvaṃ cāpi sukhito hohi- ",
  "cnd1:54.4": "ciraṃ jīvāhi māṇava, ",
  "cnd1:55.1": "bāvarissa va tumhaṃ vā- ",
  "cnd1:55.2": "sabbesaṃ sabbasaṃsayaṃ ",
  "cnd1:55.3": "katāvakāsā pucchavho- ",
  "cnd1:55.4": "yaṃ kiñci manasicchatha. ",
  "cnd1:56.1": "sambuddhena katokāso- ",
  "cnd1:56.2": "nisīditvāna pañjalī ",
  "cnd1:56.3": "ajito paṭhamaṃ pañhaṃ- ",
  "cnd1:56.4": "tattha pucchi tathāgataṃ. ",
  "cnd1:56.5": "vatthugāthā niṭṭhitā "
}
