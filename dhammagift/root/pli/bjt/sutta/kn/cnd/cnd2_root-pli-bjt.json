  "cnd2:18.0": "",
  "cnd2:18.1": "pucchāmi taṃ bhagavā brūhi metaṃ ",
  "cnd2:18.2": "(iccāyasmā mettagū) ",
  "cnd2:18.3": "maññāmi taṃ vedaguṃ bhāvitattaṃ ",
  "cnd2:18.4": "kutonu dukkhā samudāgatā ime ",
  "cnd2:18.5": "ye keci lokasmiṃ anekarūpā. 4-2 ",
  "cnd2:19.1": "dukkhassa ve maṃ pabhavaṃ apucchasi ",
  "cnd2:19.2": "(mettagū’ti bhagavā) ",
  "cnd2:19.3": "taṃ te pavakkhāmi yathā pajānaṃ ",
  "cnd2:19.4": "upadhinidānā pabhavanti dukkhā ",
  "cnd2:19.5": "ye keci lokasmiṃ anekarūpā. 4-3 ",
  "cnd2:20.1": "yo ve avidvā upadhiṃ karoti ",
  "cnd2:20.2": "punappunaṃ dukkhamupeti mando ",
  "cnd2:20.3": "tasmā pajānaṃ upadhiṃ na kayirā ",
  "cnd2:20.4": "dukkhassa jātippabhavānupassī. 4-4 ",
  "cnd2:21.1": "yantaṃ apucchimha akittayī no (iccāyasmā mettagū) ",
  "cnd2:21.2": "aññaṃ taṃ pucchāma tadiṅgha brūhi ",
  "cnd2:21.3": "kathannu dhīrā vitaranti oghaṃ ",
  "cnd2:21.4": "jāti jaraṃ sokapariddavaṃ ca ",
  "cnd2:21.5": "taṃ me munī sādhu viyākarohi ",
  "cnd2:21.6": "tathā hi te vidito esa dhammo. 4-5 ",
  "cnd2:22.1": "kittayissāmi te dhammaṃ ",
  "cnd2:22.2": "(mettagūti bhagavā) ",
  "cnd2:22.3": "diṭṭhe dhamme anītihaṃ ",
  "cnd2:22.4": "yaṃ viditvā sato caraṃ ",
  "cnd2:22.5": "tare loke visattikaṃ. 4-6 ",
  "cnd2:23.1": "taṃ cāhaṃ abhinandāmi ",
  "cnd2:23.2": "mahesī dhammamuttamaṃ ",
  "cnd2:23.3": "yaṃ viditvā sato caraṃ ",
  "cnd2:23.4": "tare loke visattikaṃ. 4-7 ",
  "cnd2:24.1": "yaṃ kiñci sampajānāsi ",
  "cnd2:24.2": "(mettagū’ti bhagavā) ",
  "cnd2:24.3": "uddhaṃ adho tiriyaṃ cāpi majjhe ",
  "cnd2:24.4": "etesu nandiṃ ca nivesanaṃ ca ",
  "cnd2:24.5": "panujja viññāṇaṃ bhave na tiṭṭhe. 4-8 ",
  "cnd2:25.1": "evaṃvihārī sato appamatto ",
  "cnd2:25.2": "bhikkhu caraṃ hitvā mamāyitāni ",
  "cnd2:25.3": "jātiṃ jaraṃ sokapariddavañca ",
  "cnd2:25.4": "idheva vidvā pajaheyya dukkhaṃ. 4-9 ",
  "cnd2:26.1": "etābhinandāmi vaco mahesino (iccāyasmā mettagū) ",
  "cnd2:26.2": "sukittitaṃ gotama nūpadhīkaṃ ",
  "cnd2:26.3": "addhā hi bhagavā pahāsi dukkhaṃ ",
  "cnd2:26.4": "tathā hi te vidito esa dhammo. 4-10 ",
  "cnd2:27.1": "te cāpi nūna pajaheyyu dukkhaṃ ",
  "cnd2:27.2": "ye tvaṃ munī aṭṭhitaṃ ovadeyya ",
  "cnd2:27.3": "taṃ taṃ namassāmi samecca nāga ",
  "cnd2:27.4": "appeva maṃ (bhagavā) aṭṭhitaṃ ovadeyya. 4-11 ",
  "cnd2:28.1": "yaṃ brāhmaṇaṃ vedaguṃ ābhijaññā (mettagū’ti bhagavā) ",
  "cnd2:28.2": "akiñcanaṃ kāmabhave asattaṃ ",
  "cnd2:28.3": "addhā hi so oghamimaṃ atārī ",
  "cnd2:28.4": "tiṇṇo ca pāraṃ akhilo akaṅkho. 4-12 ",
  "cnd2:29.1": "vidvā ca yo vedagū naro idha ",
  "cnd2:29.2": "bhavābhave saṅgamimaṃ visajja ",
  "cnd2:29.3": "so vītataṇho anīgho nirāso ",
  "cnd2:29.4": "atāri so jātijaranti brūmī ti. ",
  "cnd2:29.5": "mettagūmāṇava pucchā-niṭṭhitā 5. dhotakamāṇava pucchā 5-1 ",
  "cnd2:30.0": "",
  "cnd2:30.1": "pucchāmi taṃ bhagavā brūhi metaṃ ",
  "cnd2:30.2": "(iccāyasmā dhotako) ",
  "cnd2:30.3": "vācā’bhikaṅkhāmi mahesi tuyhaṃ ",
  "cnd2:30.4": "tava sutvāna nigghosaṃ ",
  "cnd2:30.5": "sikkhe nibbānamattano. 5-2 ",
  "cnd2:31.1": "tena hātappaṃ karohi ",
  "cnd2:31.2": "(dhotakā’ti bhagavā) ",
  "cnd2:31.3": "idheva nipako sato ",
  "cnd2:31.4": "ito sutvāna nigghosaṃ ",
  "cnd2:31.5": "sikkhe nibbānamattano. 5-3 ",
  "cnd2:32.1": "passāmahaṃ deva manussa loke (iccāyasmā dhotako) ",
  "cnd2:32.2": "akiñcanaṃ brāhmaṇamiriyamānaṃ ",
  "cnd2:32.3": "taṃ taṃ namassāmi samantacakkhu ",
  "cnd2:32.4": "pamuñca maṃ sakka kathaṃkathāhi. 5-4 ",
