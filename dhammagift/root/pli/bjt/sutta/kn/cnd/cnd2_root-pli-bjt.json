  "cnd2:52.3": "ye sūdha diṭṭhaṃ va sutaṃ mutaṃ vā ",
  "cnd2:52.4": "sīlabbataṃ vāpi pahāya sabbaṃ ",
  "cnd2:52.5": "anekarūpampi pahāya sabbaṃ ",
  "cnd2:52.6": "taṇhaṃ pariññāya anāsavā se ",
  "cnd2:52.7": "ahampi te oghatiṇṇā’ti brūmīti. ",
  "cnd2:52.8": "nandamāṇava pucchā-niṭṭhitā. 8. hemakamāṇava pucchā 8-1 ",
  "cnd2:53.0": "",
  "cnd2:53.1": "ye me pubbe vyākaṃsu ",
  "cnd2:53.2": "(iccāyasmā hemako) ",
  "cnd2:53.3": "huraṃ gotamasāsanā ",
  "cnd2:53.4": "iccāsi iti bhavissati ",
  "cnd2:53.5": "sabbaṃ taṃ itihītihaṃ ",
  "cnd2:53.6": "sabbaṃ taṃ takkavaḍḍhanaṃ ",
  "cnd2:53.7": "nāhaṃ tattha abhiramiṃ. 8-2 ",
  "cnd2:54.1": "tvaṃ ca me dhammamakkhāhi ",
  "cnd2:54.2": "taṇhā nigghātanaṃ muni ",
  "cnd2:54.3": "yaṃ viditvā sato caraṃ ",
  "cnd2:54.4": "tare loke visattikaṃ. 8-3 ",
  "cnd2:55.1": "idha diṭṭha-suta-muta- viññātesu ",
  "cnd2:55.2": "piyarūpesu hemaka ",
  "cnd2:55.3": "chandarāgavinodanaṃ ",
  "cnd2:55.4": "nibbānapadamaccutaṃ. 8-4 ",
  "cnd2:56.1": "etadaññāya ye satā ",
  "cnd2:56.2": "diṭṭhadhammābhinibbutā ",
  "cnd2:56.3": "upasantā ca te sadā ",
  "cnd2:56.4": "tiṇṇā loke visattikanti. ",
  "cnd2:56.5": "hemakamāṇava pucchā-niṭṭhitā. 9. todeyyamāṇava pucchā 9-1 ",
  "cnd2:57.0": "",
  "cnd2:57.1": "yasmiṃ kāmā na vasanti ",
  "cnd2:57.2": "(iccāyasmā todeyyo) ",
  "cnd2:57.3": "taṇhā yassa na vijjati ",
  "cnd2:57.4": "kathaṃkathā ca yo tiṇṇo ",
  "cnd2:57.5": "vimokkho tassa kīdiso. 9-2 ",
  "cnd2:58.1": "yasmiṃ kāmā na vasanti ",
  "cnd2:58.2": "(todeyyāti bhagavā) ",
  "cnd2:58.3": "taṇhā yassa na vijjati ",
  "cnd2:58.4": "kathaṃkathā ca yo tiṇṇo ",
  "cnd2:58.5": "vimokkho tassa nāparo. 9-3 ",
  "cnd2:59.1": "nirāsaso so uda āsasāno ",
  "cnd2:59.2": "(iccāyasmā todeyyo) paññāṇa vā so uda paññakappī ",
  "cnd2:59.3": "muniṃ ahaṃ sakka yathā vijaññaṃ ",
  "cnd2:59.4": "taṃ me viyācikkha samantacakkhu. 9-4 ",
  "cnd2:60.1": "nirāsāso so na so āsasāno ",
  "cnd2:60.2": "paññāṇavā so na ca paññakappī ",
  "cnd2:60.3": "evampi todeyya muniṃ vijāna ",
  "cnd2:60.4": "akiñcanaṃ kāmabhave asattanti. ",
  "cnd2:60.5": "todeyyamāṇava pucchā-niṭṭhitā. 10. kappamāṇava pucchā 10-1 ",
  "cnd2:61.0": "",
  "cnd2:61.1": "majjhe sarasmiṃ tiṭṭhataṃ ",
  "cnd2:61.2": "(iccāyasmā kappo) ",
  "cnd2:61.3": "oghe jāte mahabbhaye ",
  "cnd2:61.4": "jarāmaccuparetānaṃ ",
  "cnd2:61.5": "dīpaṃ pabrūhi mārisa ",
  "cnd2:61.6": "tvaṃ ca me dīpamakkhāhi ",
  "cnd2:61.7": "yathayidaṃ nāparaṃ siyā. 10-2 ",
  "cnd2:62.1": "majjhe sarasmiṃ tiṭṭhitaṃ ",
  "cnd2:62.2": "(kappāti bhagavā) ",
  "cnd2:62.3": "oghe jāte mahabbhaye ",
  "cnd2:62.4": "jarāmaccuparetānaṃ ",
  "cnd2:62.5": "dīpaṃ pabrūmi kappa te. 10-3 ",
  "cnd2:63.1": "akiñcanaṃ anādānaṃ ",
  "cnd2:63.2": "etaṃ dīpaṃ anāparaṃ ",
  "cnd2:63.3": "nibbānaṃ iti naṃ brūmi ",
  "cnd2:63.4": "jarāmaccuparikkhayaṃ. 10-4 ",
  "cnd2:64.1": "eta daññāya ye satā ",
  "cnd2:64.2": "diṭṭhadhammābhinibbutā ",
  "cnd2:64.3": "na te māravasānugā ",
  "cnd2:64.4": "na te mārassa paddhagūti. ",
  "cnd2:64.5": "kappamāṇava pucchā-niṭṭhitā 11. jatukaṇṇīmāṇava pucchā 11-1 ",
  "cnd2:65.0": "",
  "cnd2:65.1": "sutvāna’haṃ vīramakāmakāmiṃ ",
  "cnd2:65.2": "(iccāyasmā jatukaṇṇī) ",
  "cnd2:65.3": "oghātigaṃ puṭṭhumakāmamāgamaṃ ",
  "cnd2:65.4": "santipadaṃ brūhi sahajanetta ",
  "cnd2:65.5": "yathātacchaṃ bhagavā brūhi metaṃ, 11-2 ",
  "cnd2:66.1": "bhagavā hi kāme abhibhuyya irīyati ",
  "cnd2:66.2": "ādiccova paṭhaviṃ tejī tejasā ",
  "cnd2:66.3": "parittapaññassa me bhūripañña ",
  "cnd2:66.4": "ācikkha dhammaṃ yamahaṃ vijaññaṃ ",
  "cnd2:66.5": "jātijarāya idha vippahānaṃ. 11-3 ",
  "cnd2:67.1": "kāmesu vinaya gedhaṃ ",
  "cnd2:67.2": "(jatukaṇṇīti bhagavā) ",
  "cnd2:67.3": "nekkhammaṃ daṭṭhu khemato ",
  "cnd2:67.4": "uggahitaṃ niratthaṃ vā ",
  "cnd2:67.5": "mā te vijjittha kiñcanaṃ. 11-4 ",
  "cnd2:68.1": "yaṃ pubbe taṃ visosehi ",
  "cnd2:68.2": "pacchā te māhu kiñcanaṃ ",
  "cnd2:68.3": "majjhe ce no gahessasi ",
  "cnd2:68.4": "upasanto carissasi. 11-5 ",
  "cnd2:69.1": "sabbaso nāma rūpasmiṃ ",
  "cnd2:69.2": "vītagedhassa brāhmaṇa ",
  "cnd2:69.3": "āsavā’ssa na vijjanti ",
  "cnd2:69.4": "yehi maccuvasaṃ vajeti. ",
  "cnd2:69.5": "jatukaṇṇīmāṇava pucchā-niṭṭhitā. 12. bhadrāvudhamāṇava pucchā 12-1 okaṃ ",
  "cnd2:70.0": "",
  "cnd2:70.1": "jahaṃ taṇhacchidaṃ anejaṃ ",
  "cnd2:70.2": "(iccāyasmā bhadrāvudho) ",
  "cnd2:70.3": "nandiṃ jahaṃ oghatiṇṇaṃ vimuttaṃ ",
  "cnd2:70.4": "kappaṃ jahaṃ abhiyāce sumedhaṃ ",
  "cnd2:70.5": "sutvāna nāgassa apanamissanti ito. 12-2 ",
  "cnd2:71.1": "nānā janā janapadehi saṅgatā ",
  "cnd2:71.2": "tava vīra vākyaṃ abhikaṅkhamānā ",
  "cnd2:71.3": "tesaṃ tuvaṃ sādhu viyākarohi ",
  "cnd2:71.4": "tathā hi te vidito esa dhammo. 12-3 ",
  "cnd2:72.1": "ādānataṇhaṃ vinayetha sabbaṃ ",
  "cnd2:72.2": "(bhadrāvudhāti bhagavā) ",
  "cnd2:72.3": "uddhaṃ adho tiriyaṃ cāpi majjhe ",
  "cnd2:72.4": "yaṃ yaṃ hi lokasmiṃ upādiyanti ",
  "cnd2:72.5": "teneva māro anveti jantuṃ. 12-4 ",
  "cnd2:73.1": "tasmā pajānaṃ na upādiyetha ",
  "cnd2:73.2": "bhikkhu sato kiñcanaṃ sabbaloke ",
  "cnd2:73.3": "ādānasatte iti pekkhamāno ",
  "cnd2:73.4": "pajaṃ imaṃ maccudheyye visattanti. ",
  "cnd2:73.5": "bhadrāvudhamāṇava pucchā-niṭṭhitā. 13. udayamāṇava pucchā 13-1 ",
  "cnd2:74.0": "",
  "cnd2:74.1": "jhāyiṃ virajamāsīnaṃ ",
  "cnd2:74.2": "(iccāyasmā udayo) ",
  "cnd2:74.3": "katakiccaṃ anāsavaṃ ",
  "cnd2:74.4": "pāraguṃ sabbadhammānaṃ ",
  "cnd2:74.5": "atthi pañhena āgamaṃ ",
  "cnd2:74.6": "aññāvimokkhaṃ pabrūhi ",
  "cnd2:74.7": "avijjāya pabhedanaṃ. 13-2 ",
  "cnd2:75.1": "pahānaṃ kāma cchandānaṃ ",
  "cnd2:75.2": "(udayāti bhagavā) ",
  "cnd2:75.3": "domanassāna cūbhayaṃ ",
  "cnd2:75.4": "thīnassa ca panūdanaṃ ",
  "cnd2:75.5": "kukkuccānaṃ nivāraṇaṃ 13-3 ",
  "cnd2:76.1": "upekkhā sati saṃsuddhaṃ ",
  "cnd2:76.2": "dhammatakkapurejavaṃ ",
  "cnd2:76.3": "aññāvimokkhaṃ pabrūmi ",
  "cnd2:76.4": "avijjāya pabhedanaṃ. 13-4 ",
  "cnd2:77.1": "kiṃ su saṃyojano loko ",
  "cnd2:77.2": "(iccāyasmā udayo) kiṃ su tassa vicāraṇaṃ ",
  "cnd2:77.3": "kissassa vippahānena ",
  "cnd2:77.4": "nibbānamiti vuccati. 13-5 ",
  "cnd2:78.1": "nandisaṃyojano loko (udayāti bhagavā) ",
  "cnd2:78.2": "vitakkassa vicāraṇā ",
  "cnd2:78.3": "taṇhāya vippahānena ",
  "cnd2:78.4": "nibbānaṃ iti vuccati. 13-6 ",
  "cnd2:79.1": "kathaṃ satassa carato (iccāyasmā udayo) ",
  "cnd2:79.2": "viññāṇaṃ uparujjhati ",
  "cnd2:79.3": "bhagavantaṃ puṭṭhumāgamma ",
  "cnd2:79.4": "taṃ suṇoma vaco tava. 13-7 ",
  "cnd2:80.1": "ajjhattaṃ ca bahiddhā ca ",
  "cnd2:80.2": "vedanaṃ nābhinandato ",
  "cnd2:80.3": "evaṃ satassa carato ",
  "cnd2:80.4": "viññāṇaṃ uparujjhatīti. ",
  "cnd2:80.5": "udayamāṇavapucchā-niṭṭhitā 14. posālamāṇava pucchā 14-1 ",
  "cnd2:81.0": "",
  "cnd2:81.1": "yo atītaṃ ādisati ",
  "cnd2:81.2": "(iccāyasmā posālo) ",
  "cnd2:81.3": "anejo chinnasaṃsayo ",
  "cnd2:81.4": "pāraguṃ sabbadhammānaṃ ",
  "cnd2:81.5": "atthi pañhena āgamaṃ. 14-2 ",
  "cnd2:82.1": "vibhūtarūpasaññissa ",
  "cnd2:82.2": "sabbakāyappahāyino ",
  "cnd2:82.3": "ajjhattaṃ ca bahiddhā ca ",
  "cnd2:82.4": "natthi kiñcīti passato ",
  "cnd2:82.5": "ñāṇaṃ sakkānu pucchāmi ",
  "cnd2:82.6": "kathaṃ neyyo tathāvidho. 14-3 ",
  "cnd2:83.1": "viññāṇaṭṭhitiyo sabbā ",
  "cnd2:83.2": "(posālāti bhagavā) ",
  "cnd2:83.3": "abhijānaṃ tathāgato ",
  "cnd2:83.4": "tiṭṭhantamenaṃ jānāti ",
  "cnd2:83.5": "dhimuttaṃ tapparāyaṇaṃ. 14-4 ",
  "cnd2:84.1": "ākiñcaññā sambhavaṃ ñatvā ",
  "cnd2:84.2": "nandi saṃyojanaṃ iti ",
  "cnd2:84.3": "evametaṃ abhiññāya ",
  "cnd2:84.4": "tato tattha vipassati ",
  "cnd2:84.5": "etaṃ ñāṇaṃ tathā tassa ",
  "cnd2:84.6": "brāhmaṇassa vusīmato’ti. ",
  "cnd2:84.7": "posālamāṇava pucchā-niṭṭhitā. 15. mogharājamāṇava pucchā 15-1 ",
  "cnd2:85.0": "",
  "cnd2:85.1": "dvāhaṃ sakkaṃ apucchissaṃ ",
  "cnd2:85.2": "(iccāyasmā mogharājā) ",
  "cnd2:85.3": "na me vyākāsi cakkhumā ",
  "cnd2:85.4": "yāva tatiyaṃ ca devīsi ",
  "cnd2:85.5": "vyākarotīti me sutaṃ. 15-2 ",
  "cnd2:86.1": "ayaṃ loko paro loko ",
  "cnd2:86.2": "brahmaloko sadevako ",
  "cnd2:86.3": "diṭṭhinte nābhijānāti ",
  "cnd2:86.4": "gotamassa yasassino. 15-3 ",
  "cnd2:87.1": "evaṃ abhikkantadassāviṃ ",
  "cnd2:87.2": "atthi pañhena āgamaṃ ",
  "cnd2:87.3": "kathaṃ lokaṃ avekkhantaṃ ",
  "cnd2:87.4": "maccurājā na passati. 15-4 ",
  "cnd2:88.1": "suññato lokaṃ avekkhassu ",
  "cnd2:88.2": "mogharāja sadā sato ",
  "cnd2:88.3": "attānudiṭṭhiṃ ūhacca ",
  "cnd2:88.4": "evaṃ maccutaro siyā ",
  "cnd2:88.5": "evaṃ lokaṃ avekkhantaṃ ",
  "cnd2:88.6": "maccurājā na passatīti. ",
  "cnd2:88.7": "mogharājamāṇava pucchā-niṭṭhitā 16. piṅgiyamāṇava pucchā 16-1 ",
  "cnd2:89.0": "",
  "cnd2:89.1": "jiṇṇo’hamasmi abalo vītavaṇṇo ",
  "cnd2:89.2": "(iccāyasmā piṅgiyo) ",
  "cnd2:89.3": "nettā na suddhā savaṇaṃ na phāsu ",
  "cnd2:89.4": "māhaṃ nassaṃ momuho antarā’va ",
  "cnd2:89.5": "ācikkha dhammaṃ yamahaṃ vijaññaṃ ",
  "cnd2:89.6": "jātijarāya idha vippahānaṃ. 16-2 ",
  "cnd2:90.1": "disvāna rūpesu vihaññamāne ",
  "cnd2:90.2": "(piṅgiyāti bhagavā) ",
  "cnd2:90.3": "ruppanti rūpesu janā pamattā ",
  "cnd2:90.4": "tasmā tuvaṃ piṅgiya appamatto ",
  "cnd2:90.5": "jahassu rūpaṃ apunabbhavāya. 16-3 ",
  "cnd2:91.1": "disā catasso vidisā catasso (iccāyasmā piṅgiyo) ",
  "cnd2:91.2": "uddhaṃ adho dasadisā imāyo ",
  "cnd2:91.3": "na tuyhaṃ adiṭṭhaṃ asutaṃ amutaṃ ",
  "cnd2:91.4": "atho aviññātaṃ kiñci natthi loke ",
  "cnd2:91.5": "ācikkha dhammaṃ yamahaṃ vijaññaṃ ",
  "cnd2:91.6": "jātijarāya idha vippahānaṃ. 16-4 ",
  "cnd2:92.1": "taṇhādhipanne manuje pekkhamāno ",
  "cnd2:92.2": "(piṅgiyāti bhagavā) ",
  "cnd2:92.3": "santāpajāte jarasā parete ",
  "cnd2:92.4": "tasmā tuvaṃ piṅgiya appamatto ",
  "cnd2:92.5": "jahassu taṇhaṃ apunabbhavāyāti. ",
  "cnd2:92.6": "piṅgiyamāṇava pucchā-niṭṭhitā "
}
