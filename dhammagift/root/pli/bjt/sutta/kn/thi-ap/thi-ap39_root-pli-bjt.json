{
  "thi-ap39:0.1": "",
  "thi-ap39:0.2": "",
  "thi-ap39:0.3": "4. 9 ambapālī apadānaṃ ",
  "thi-ap39:1.1": "yo raṃsiphusitāvelo ",
  "thi-ap39:1.2": "phusso nāma mahāmuni ",
  "thi-ap39:1.3": "tassā’haṃ bhaginī āsiṃ ",
  "thi-ap39:1.4": "ajāyiṃ khattiye kule ",
  "thi-ap39:2.1": "tassa dhammaṃ suṇitvā’haṃ ",
  "thi-ap39:2.2": "vippasannena cetasā ",
  "thi-ap39:2.3": "mahādānaṃ daditvāna ",
  "thi-ap39:2.4": "patthayiṃ rūpasampadaṃ. ",
  "thi-ap39:3.1": "ekatiṃse ito kappe ",
  "thi-ap39:3.2": "sikhī lokagganāyako ",
  "thi-ap39:3.3": "uppajji lokapajjoto ",
  "thi-ap39:3.4": "tilokasaraṇo jino. ",
  "thi-ap39:4.1": "tadā’ruṇapure ramme ",
  "thi-ap39:4.2": "brahmaññakulasambhavā ",
  "thi-ap39:4.3": "vimuttacittaṃ kupitā ",
  "thi-ap39:4.4": "bhikkhuniṃ abhisāpayiṃ. ",
  "thi-ap39:5.1": "“vesikāva anācārā ",
  "thi-ap39:5.2": "jinasāsanadūsikā” ",
  "thi-ap39:5.3": "evaṃ akkosayitvāna ",
  "thi-ap39:5.4": "tena pāpena kammunā. ",
  "thi-ap39:6.1": "dāruṇaṃ nirayaṃ gantvā ",
  "thi-ap39:6.2": "mahādukkhasamappitā ",
  "thi-ap39:6.3": "tato cutā manussesu ",
  "thi-ap39:6.4": "upapannā tapassinī. ",
  "thi-ap39:7.1": "dasajātisahassāni ",
  "thi-ap39:7.2": "gaṇikattamakārayiṃ ",
  "thi-ap39:7.3": "tamhā pāpā na muccissaṃ ",
  "thi-ap39:7.4": "bhutvā duṭṭhavisaṃ yathā. ",
  "thi-ap39:8.1": "brahmacariyamasevissaṃ ",
  "thi-ap39:8.2": "kassape jina sāsane ",
  "thi-ap39:8.3": "tena kammavipākena ",
  "thi-ap39:8.4": "ajāyiṃ tidase pure. ",
  "thi-ap39:9.1": "pacchimabhave sampatte ",
  "thi-ap39:9.2": "ahosiṃ opapātikā ",
  "thi-ap39:9.3": "ambasākhantare jātā ",
  "thi-ap39:9.4": "ambapālīti tena haṃ. ",
  "thi-ap39:10.1": "parivutā pāṇakoṭīhi ",
  "thi-ap39:10.2": "pabbajiṃ jinasāsane ",
  "thi-ap39:10.3": "pattāhaṃ acalaṃ ṭhānaṃ ",
  "thi-ap39:10.4": "ṭhitā buddhassa orasā. ",
  "thi-ap39:11.1": "iddhīsu ca vasī homi ",
  "thi-ap39:11.2": "sotadhātuvisuddhiyā ",
  "thi-ap39:11.3": "ceto pariyañāṇassa ",
  "thi-ap39:11.4": "vasī homi mahāmune. ",
  "thi-ap39:12.1": "pubbe nivāsaṃ jānāmi ",
  "thi-ap39:12.2": "dibbacakkhu visodhitaṃ ",
  "thi-ap39:12.3": "sabbāsavā parikkhīṇā ",
  "thi-ap39:12.4": "natthi’dāni punabbhavo. ",
  "thi-ap39:13.1": "atthadhammaniruttīsu ",
  "thi-ap39:13.2": "paṭibhāne tatheva ca ",
  "thi-ap39:13.3": "ñāṇaṃ me vimalaṃ suddhaṃ ",
  "thi-ap39:13.4": "buddhaseṭṭhassa vāhasā. ",
  "thi-ap39:14.1": "kilesā jhāpitā ",
  "thi-ap39:14.2": "",
  "thi-ap39:14.3": "",
  "thi-ap39:15.1": "",
  "thi-ap39:15.2": "",
  "thi-ap39:15.3": "",
  "thi-ap39:16.1": "",
  "thi-ap39:16.2": "…pe… ",
  "thi-ap39:16.3": "kataṃ buddhassa sāsanaṃ. ",
  "thi-ap39:17.1": "itthaṃ sudaṃ ambapālī bhikkhunī imā gāthāyo abhāsitthāti. ",
  "thi-ap39:18.1": "ambapālītheriyāpadānaṃ navamaṃ. "
}
