{
  "thi-ap13:0.1": "",
  "thi-ap13:0.2": "",
  "thi-ap13:0.3": "2. 3 modakadāyikāpadānaṃ. ",
  "thi-ap13:1.1": "nagare bandhumatiyā ",
  "thi-ap13:1.2": "kumhadāsi ahosa’haṃ, ",
  "thi-ap13:1.3": "mama bhāgaṃ gahetvāna ",
  "thi-ap13:1.4": "gacchiṃ udakahārikā. ",
  "thi-ap13:2.1": "panthamhi samaṇaṃ disvā ",
  "thi-ap13:2.2": "santacittaṃ samāhitaṃ, ",
  "thi-ap13:2.3": "pasannacittā sumanā ",
  "thi-ap13:2.4": "modake tīṇi’dāsa’haṃ. ",
  "thi-ap13:3.1": "tena kammena sukatena ",
  "thi-ap13:3.2": "cetanāpaṇidhīhi ca, ",
  "thi-ap13:3.3": "ekanavuti kappāni ",
  "thi-ap13:3.4": "vinipātaṃ na gaccha’haṃ. ",
  "thi-ap13:4.1": "sampattiṃ taṃ karitvāna ",
  "thi-ap13:4.2": "sabbaṃ anubhavāmahaṃ, ",
  "thi-ap13:4.3": "modake tīṇi datvāna ",
  "thi-ap13:4.4": "pattā’haṃ acalaṃ padaṃ. ",
  "thi-ap13:5.1": "kilesā jhāpitā mayhaṃ ",
  "thi-ap13:5.2": "…pe… ",
  "thi-ap13:5.3": "",
  "thi-ap13:6.1": "",
  "thi-ap13:6.2": "",
  "thi-ap13:6.3": "",
  "thi-ap13:7.1": "",
  "thi-ap13:7.2": "",
  "thi-ap13:7.3": "kataṃ buddhassa sāsanaṃ. ",
  "thi-ap13:8.1": "itthaṃ sudaṃ modakadāyikā bhikkhunī imā gāthāyo abhāsitthāti. ",
  "thi-ap13:9.1": "modakadāyikā theriyāpadānaṃ tatiyaṃ. "
}
