{
  "thi-ap35:0.1": "",
  "thi-ap35:0.2": "",
  "thi-ap35:0.3": "4. 5 sukkāpadānaṃ ",
  "thi-ap35:1.1": "ekanavute ito kappe ",
  "thi-ap35:1.2": "vipassī nāma nāyako ",
  "thi-ap35:1.3": "uppajji cārunayano ",
  "thi-ap35:1.4": "sabbadhammavipassako. ",
  "thi-ap35:2.1": "tadā’haṃ bandhumatiyaṃ ",
  "thi-ap35:2.2": "jātā aññatare kule ",
  "thi-ap35:2.3": "dhammaṃ sutvāna munino ",
  "thi-ap35:2.4": "pabbajiṃ anagāriyaṃ. ",
  "thi-ap35:3.1": "bahussutā dhammadharā ",
  "thi-ap35:3.2": "paṭibhānavatī tathā ",
  "thi-ap35:3.3": "vicittakathikā cāpi ",
  "thi-ap35:3.4": "jinasāsanakārikā. ",
  "thi-ap35:4.1": "tadā dhammakathaṃ katvā ",
  "thi-ap35:4.2": "janatāya hitaṃ bahuṃ ",
  "thi-ap35:4.3": "tato cutā’haṃ tusitaṃ ",
  "thi-ap35:4.4": "upapannā yasassinī. ",
  "thi-ap35:5.1": "ekatiṃse ito kappe ",
  "thi-ap35:5.2": "sikhī viya sikhī jino ",
  "thi-ap35:5.3": "tapanto yasasā loke ",
  "thi-ap35:5.4": "uppajji vadataṃ varo. ",
  "thi-ap35:6.1": "tadāpi pabbajitvāna ",
  "thi-ap35:6.2": "buddhasāsanakovidā ",
  "thi-ap35:6.3": "jotetvā jinavākyāni ",
  "thi-ap35:6.4": "tatopi tidivaṃ gatā. ",
  "thi-ap35:7.1": "ekatiṃse ito kappe ",
  "thi-ap35:7.2": "vessabhū nāma nāyako ",
  "thi-ap35:7.3": "uppajjittha mahāñāṇī ",
  "thi-ap35:7.4": "tadāpi ca tathevahaṃ. ",
  "thi-ap35:8.1": "pabbajitvā dhammadharā ",
  "thi-ap35:8.2": "jotayiṃ jinasāsanaṃ ",
  "thi-ap35:8.3": "gantvā marupuraṃ rammaṃ ",
  "thi-ap35:8.4": "anubhosiṃ mahāsukhaṃ. ",
  "thi-ap35:9.1": "imamhi bhaddake kappe ",
  "thi-ap35:9.2": "kakusandho jinuttamo ",
  "thi-ap35:9.3": "uppajji narasaddūlo ",
  "thi-ap35:9.4": "tadāpi ca tathevahaṃ. ",
  "thi-ap35:10.1": "pabbajitvā munimataṃ ",
  "thi-ap35:10.2": "jotayitvā yathāyukaṃ ",
  "thi-ap35:10.3": "tato cutā’haṃ tidivaṃ ",
  "thi-ap35:10.4": "agaṃ sabhavanaṃ yathā. ",
  "thi-ap35:11.1": "imasmiṃ yeva kappamhi ",
  "thi-ap35:11.2": "koṇāgamana nāyako. ",
  "thi-ap35:11.3": "uppajji lokasaraṇo ",
  "thi-ap35:11.4": "sabbasattānamuttamo. ",
  "thi-ap35:12.1": "tadāpi pabbajitvāna ",
  "thi-ap35:12.2": "sāsane tassa tādino ",
  "thi-ap35:12.3": "bahussutā dhammadharā ",
  "thi-ap35:12.4": "jotayiṃ jinasāsanaṃ. ",
  "thi-ap35:13.1": "imasmiṃyeva kappamhi ",
  "thi-ap35:13.2": "kassapo purisuttamo ",
  "thi-ap35:13.3": "uppajji lokanayano ",
  "thi-ap35:13.4": "araṇo maraṇantagū. ",
  "thi-ap35:14.1": "tassāpi naravīrassa ",
  "thi-ap35:14.2": "pabbajitvāna sāsane ",
  "thi-ap35:14.3": "pariyāputasaddhammā ",
  "thi-ap35:14.4": "paripucchāvisāradā. ",
  "thi-ap35:15.1": "susīlā lajjinī ceva ",
  "thi-ap35:15.2": "tīsu sikkhāsu kovidā ",
  "thi-ap35:15.3": "bahuṃ dhammakathaṃ katvā ",
  "thi-ap35:15.4": "yāvajīvaṃ hitāvahaṃ. ",
  "thi-ap35:16.1": "tena kammena sukatena ",
  "thi-ap35:16.2": "cetanāpaṇidhīhi ca ",
  "thi-ap35:16.3": "jahitvā mānusaṃ dehaṃ ",
  "thi-ap35:16.4": "tāvatiṃsaṃ agacchahaṃ. ",
  "thi-ap35:17.1": "pacchime ca bhave’dāni ",
  "thi-ap35:17.2": "giribbajapuruttame ",
  "thi-ap35:17.3": "jātā seṭṭhikule phīte ",
  "thi-ap35:17.4": "mahāratanasañcaye. ",
  "thi-ap35:18.1": "yadā bhikkhusahassena ",
  "thi-ap35:18.2": "parito lokanāyako ",
  "thi-ap35:18.3": "upāgami rājagahaṃ ",
  "thi-ap35:18.4": "sahassakkhena vaṇṇito. ",
  "thi-ap35:19.1": "“danto dantehi saha purāṇajaṭilehi ",
  "thi-ap35:19.2": "vippamutto vippamuttehi ",
  "thi-ap35:19.3": "siṅgīnikkhasavaṇṇo ",
  "thi-ap35:19.4": "rajāgahaṃ pāvisi bhagavā.” ",
  "thi-ap35:20.1": "disvā buddhānubhāvaṃ taṃ ",
  "thi-ap35:20.2": "sutvā ca guṇasañcayaṃ ",
  "thi-ap35:20.3": "buddhe cittaṃ pasādetvā ",
  "thi-ap35:20.4": "pūjayiṃ taṃ yathābalaṃ. ",
  "thi-ap35:21.1": "aparena ca kālena ",
  "thi-ap35:21.2": "dhammadinnāya santike ",
  "thi-ap35:21.3": "agārā nikkhamitvāna ",
  "thi-ap35:21.4": "pabbajiṃ anagāriyaṃ. ",
  "thi-ap35:22.1": "kesesu chijjamānesu ",
  "thi-ap35:22.2": "kilese jhāpayiṃ ahaṃ ",
  "thi-ap35:22.3": "uggahiṃ sāsanaṃ sabbaṃ ",
  "thi-ap35:22.4": "pabbajitvā ‘cirenahaṃ. ",
  "thi-ap35:23.1": "tato dhammamadesesiṃ ",
  "thi-ap35:23.2": "mahājanasamāgame ",
  "thi-ap35:23.3": "dhamme desiyamānamhi ",
  "thi-ap35:23.4": "dhammābhisamayo ahu. ",
  "thi-ap35:24.1": "nekapāṇasahassānaṃ ",
  "thi-ap35:24.2": "taṃ viditvā’tivimhito ",
  "thi-ap35:24.3": "abhippasanno me yakkho ",
  "thi-ap35:24.4": "bhamitvāna giribbajaṃ. ",
  "thi-ap35:25.1": "“kiṃ me katā rājagahe manussā ",
  "thi-ap35:25.2": "madhu pītāva acchare ",
  "thi-ap35:25.3": "ye sukkaṃ na upāsanti ",
  "thi-ap35:25.4": "desentiṃ amataṃ padaṃ. ",
  "thi-ap35:26.1": "tañca appaṭivānīyaṃ ",
  "thi-ap35:26.2": "asecanakamojavaṃ ",
  "thi-ap35:26.3": "pivanti maññe sappaññā ",
  "thi-ap35:26.4": "valāhakamivaddhagū” ",
  "thi-ap35:27.1": "iddhiyā ca vasī homi ",
  "thi-ap35:27.2": "dibbāya sotadhātuyā ",
  "thi-ap35:27.3": "cetopariyañāṇassa ",
  "thi-ap35:27.4": "vasī homi mahāmuni. pubbe ",
  "thi-ap35:28.1": "nivāsaṃ jānāmi ",
  "thi-ap35:28.2": "dibbacakkhu visodhitaṃ ",
  "thi-ap35:28.3": "sabbāsavā parikkhīṇā ",
  "thi-ap35:28.4": "natthi’dāni punabbhavo. ",
  "thi-ap35:29.1": "atthadhammaniruttīsu ",
  "thi-ap35:29.2": "paṭibhāne tatheva ca ",
  "thi-ap35:29.3": "ñāṇaṃ mama mahāvīra ",
  "thi-ap35:29.4": "uppannaṃ tava santike. ",
  "thi-ap35:30.1": "kilesā jhāpitā mayhaṃ ",
  "thi-ap35:30.2": "…pe… ",
  "thi-ap35:30.3": "",
  "thi-ap35:31.1": "",
  "thi-ap35:31.2": "",
  "thi-ap35:31.3": "",
  "thi-ap35:32.1": "",
  "thi-ap35:32.2": "",
  "thi-ap35:32.3": "kataṃ buddhassa sāsanaṃ. ",
  "thi-ap35:33.1": "itthaṃ sudaṃ sukkā bhikkhunī bhagavato santike imā gāthāyo abhāsitthāti. ",
  "thi-ap35:34.1": "sukkātheriyāpadānaṃ pañcamaṃ. ",
  "thi-ap35:34.2": ""
}
