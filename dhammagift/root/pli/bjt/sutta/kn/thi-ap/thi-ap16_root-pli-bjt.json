{
  "thi-ap16:0.1": "",
  "thi-ap16:0.2": "",
  "thi-ap16:0.3": "2. 6 sālamālikāpadānaṃ ",
  "thi-ap16:1.1": "candabhāgānadītīre ",
  "thi-ap16:1.2": "ahosiṃ kinnarī tadā, ",
  "thi-ap16:1.3": "addasaṃ virajaṃ buddhaṃ ",
  "thi-ap16:1.4": "sayambhuṃ aparājitaṃ. ",
  "thi-ap16:2.1": "pasannacittā sumanā ",
  "thi-ap16:2.2": "vedajātā katañjalī, ",
  "thi-ap16:2.3": "sālamālaṃ gahetvāna ",
  "thi-ap16:2.4": "sayambhuṃ abhipūjayiṃ. ",
  "thi-ap16:3.1": "tena kammena sukatena ",
  "thi-ap16:3.2": "cetanāpaṇidhīhi ca, ",
  "thi-ap16:3.3": "jahitvā kinnarīdehaṃ ",
  "thi-ap16:3.4": "tāvatiṃsamagacchahaṃ. ",
  "thi-ap16:4.1": "chattiṃsa devarājūnaṃ ",
  "thi-ap16:4.2": "mahesittamakārayiṃ, ",
  "thi-ap16:4.3": "manasā patthitaṃ mayhaṃ ",
  "thi-ap16:4.4": "nibbattati yathicchitaṃ. ",
  "thi-ap16:5.1": "dasannaṃ cakkavattīnaṃ ",
  "thi-ap16:5.2": "mahesittamakārayiṃ, ",
  "thi-ap16:5.3": "ocitattāva hutvāna ",
  "thi-ap16:5.4": "saṃsarāmi bhavesvahaṃ. ",
  "thi-ap16:6.1": "kusalaṃ vijjate mayhaṃ ",
  "thi-ap16:6.2": "pabbajiṃ anagāriyaṃ, ",
  "thi-ap16:6.3": "pūjārahā ahaṃ ajja ",
  "thi-ap16:6.4": "sakyaputtassa sāsane. ",
  "thi-ap16:7.1": "visuddhamanasā ajja ",
  "thi-ap16:7.2": "apetamanapāpikā, ",
  "thi-ap16:7.3": "sabbāsavāparikkhīṇā ",
  "thi-ap16:7.4": "natthidāni punabbhavo. ",
  "thi-ap16:8.1": "catunavute ito kappe ",
  "thi-ap16:8.2": "yaṃ buddhamabhipūjayiṃ, ",
  "thi-ap16:8.3": "duggatiṃ nābhijānāmi ",
  "thi-ap16:8.4": "sālamālāyidaṃ phalaṃ. ",
  "thi-ap16:9.1": "kilesā jhāpitā mayhaṃ ",
  "thi-ap16:9.2": "…pe… ",
  "thi-ap16:9.3": "",
  "thi-ap16:10.1": "",
  "thi-ap16:10.2": "",
  "thi-ap16:10.3": "",
  "thi-ap16:11.1": "",
  "thi-ap16:11.2": "",
  "thi-ap16:11.3": "kataṃ buddhassa sāsanaṃ. ",
  "thi-ap16:12.1": "itthaṃ sudaṃ sālamālikā bhikkhunī imā gāthāyo abhāsitthāti. ",
  "thi-ap16:13.1": "sālamālikā theriyāpadānaṃ chaṭṭhaṃ. "
}
