{
  "thi-ap2:0.1": "",
  "thi-ap2:0.2": "",
  "thi-ap2:0.3": "1. 2 mekhalādāyikāpadānaṃ ",
  "thi-ap2:1.1": "siddhatthassa bhagavato ",
  "thi-ap2:1.2": "thūpaṃ kārāpikā ahuṃ, ",
  "thi-ap2:1.3": "mekhalikā mayā dinnā ",
  "thi-ap2:1.4": "navakammāya satthuno. ",
  "thi-ap2:2.1": "niṭṭhite ca mahāthūpe ",
  "thi-ap2:2.2": "mekhalaṃ puna’dāsahaṃ, ",
  "thi-ap2:2.3": "lokanāthassa munino ",
  "thi-ap2:2.4": "pasannā sehi pāṇihi. catunavute ",
  "thi-ap2:3.1": "ito kappe ",
  "thi-ap2:3.2": "yaṃ mekhalamadaṃ tadā, ",
  "thi-ap2:3.3": "duggatiṃ nābhājānāmi ",
  "thi-ap2:3.4": "thūpakārassidaṃ phalaṃ. ",
  "thi-ap2:4.1": "kilesā jhāpitā mayhaṃ ",
  "thi-ap2:4.2": "…pe… ",
  "thi-ap2:4.3": "viharāmi anāsavā. ",
  "thi-ap2:5.1": "svāgataṃ vata me āsi ",
  "thi-ap2:5.2": "…pe… ",
  "thi-ap2:5.3": "kataṃ buddhassa sāsanaṃ. ",
  "thi-ap2:6.1": "paṭisambhidā catasso ca ",
  "thi-ap2:6.2": "…pe… ",
  "thi-ap2:6.3": "kataṃ buddhassa sāsanaṃ. ",
  "thi-ap2:7.1": "itthaṃ sudaṃ mekhalādāyikā bhikkhunī imā gāthāyo abhāsitthāti. ",
  "thi-ap2:8.1": "mekhalādāyikātherīapadānaṃ dutiyaṃ. "
}
