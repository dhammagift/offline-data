{
  "thi-ap30:0.1": "",
  "thi-ap30:0.2": "",
  "thi-ap30:0.3": "3. 10 aṭṭhārasabhikkhunīsahassāpadānaṃ. ",
  "thi-ap30:1.1": "aṭṭhārasasahassāni ",
  "thi-ap30:1.2": "bhikkhunī sakyasamhavā ",
  "thi-ap30:1.3": "yasodharāpamukhāni ",
  "thi-ap30:1.4": "sambuddhaṃ upasaṅkamuṃ. ",
  "thi-ap30:2.1": "aṭṭhārasasahassāni ",
  "thi-ap30:2.2": "sabbā honti mahiddhikā ",
  "thi-ap30:2.3": "vandantī munino pāde ",
  "thi-ap30:2.4": "ārocenti yathābalaṃ. ",
  "thi-ap30:3.1": "jāti khīṇā jarā vyādhi maraṇaṃ ",
  "thi-ap30:3.2": "ca mahāmuni ",
  "thi-ap30:3.3": "anāsavaṃ padaṃ santaṃ ",
  "thi-ap30:3.4": "amataṃ yāma nāyaka. ",
  "thi-ap30:4.1": "khalitaṃ ce pure atthi ",
  "thi-ap30:4.2": "sabbāsampi mahāmuni ",
  "thi-ap30:4.3": "aparādhamajānantī ",
  "thi-ap30:4.4": "khama amhaṃ vināyaka. ",
  "thi-ap30:5.1": "“iddhiṃ cāpi nidassetha ",
  "thi-ap30:5.2": "mama sāsanakārikā ",
  "thi-ap30:5.3": "parisānaṃ ca sabbāsaṃ ",
  "thi-ap30:5.4": "kaṅkhaṃ chindatha yāvatā.” ",
  "thi-ap30:6.1": "yasodharī mahāvīra ",
  "thi-ap30:6.2": "manāpā piyadassanā ",
  "thi-ap30:6.3": "sabbā tuyhaṃ mahāvīra ",
  "thi-ap30:6.4": "agārasmiṃ pajāpatī. ",
  "thi-ap30:7.1": "thinaṃ satasahassānaṃ ",
  "thi-ap30:7.2": "navutīnaṃ chaḷuttari ",
  "thi-ap30:7.3": "agāre te mayaṃ vīra ",
  "thi-ap30:7.4": "pāmokkhā sabbaissarā. ",
  "thi-ap30:8.1": "rūpācāraguṇūpetā ",
  "thi-ap30:8.2": "yobbanaṭṭhā piyaṃvadā ",
  "thi-ap30:8.3": "sabbāyo apacāyanti ",
  "thi-ap30:8.4": "devatā viya mānusā. ",
  "thi-ap30:9.1": "aṭṭhārasasahassāni ",
  "thi-ap30:9.2": "sabbā sākiyasamhavā ",
  "thi-ap30:9.3": "yasodharā sahassāni ",
  "thi-ap30:9.4": "pāmokkhā issarā tadā. ",
  "thi-ap30:10.1": "kāmadhātumatikkantā ",
  "thi-ap30:10.2": "saṇṭhitā rūpadhātuyā ",
  "thi-ap30:10.3": "rūpena sadisā natthi ",
  "thi-ap30:10.4": "sahassānaṃ mahāmuni. ",
  "thi-ap30:11.1": "sambuddhaṃ abhivādetvā ",
  "thi-ap30:11.2": "iddhiṃ dassesu satthuno ",
  "thi-ap30:11.3": "nekā nānāvidhākārā ",
  "thi-ap30:11.4": "mahāiddhipi dassayuṃ. ",
  "thi-ap30:12.1": "cakkavāḷasamaṃ kāyaṃ ",
  "thi-ap30:12.2": "sīsaṃ uttarato kuru ",
  "thi-ap30:12.3": "ubho pakkhā duve dīpā ",
  "thi-ap30:12.4": "jambudīpaṃ sarīrato. ",
  "thi-ap30:13.1": "dakkhiṇaṃ ca saraṃ piñjaṃ ",
  "thi-ap30:13.2": "nānāsākhā tu pattakā ",
  "thi-ap30:13.3": "candasūravisālakkhā ",
  "thi-ap30:13.4": "merupabbatato sikhā. ",
  "thi-ap30:14.1": "cakkavāḷagirituṇḍā ",
  "thi-ap30:14.2": "jamburukkhaṃ samūlakaṃ ",
  "thi-ap30:14.3": "vījamānā upagantvā ",
  "thi-ap30:14.4": "vandanti lokanāyakaṃ. ",
  "thi-ap30:15.1": "hatthivaṇṇaṃ tathevassaṃ ",
  "thi-ap30:15.2": "pabbataṃ jaladhiṃ tathā ",
  "thi-ap30:15.3": "canda ca suriyaṃ meruṃ ",
  "thi-ap30:15.4": "sakkavaṇṇaṃ ca dassayuṃ. ",
  "thi-ap30:16.1": "yasodharā mayaṃ vīra ",
  "thi-ap30:16.2": "pāde vandāma cakkhuma ",
  "thi-ap30:16.3": "tava vīra pabhāvane ",
  "thi-ap30:16.4": "nipphantā naranāyaka. ",
  "thi-ap30:17.1": "buddhīsu ca vasī homa ",
  "thi-ap30:17.2": "dibbāya sotadhātuyā ",
  "thi-ap30:17.3": "cetopariyañāṇassa ",
  "thi-ap30:17.4": "vasī homa mahāmune. ",
  "thi-ap30:18.1": "pubbe nivāsaṃ jānāma ",
  "thi-ap30:18.2": "dibbacakkhu visodhitaṃ ",
  "thi-ap30:18.3": "sabbāsavā parikkhīṇā ",
  "thi-ap30:18.4": "natthi’dāni punabbhavo. ",
  "thi-ap30:19.1": "atthadhammaniruttīsu ",
  "thi-ap30:19.2": "paṭibhāne tatheva ca ",
  "thi-ap30:19.3": "ñāṇaṃ amhaṃ mahāvīra ",
  "thi-ap30:19.4": "uppannaṃ tava santike. ",
  "thi-ap30:20.1": "pubbānaṃ lokanāthānaṃ ",
  "thi-ap30:20.2": "saṅgamaṃ no nidassitaṃ ",
  "thi-ap30:20.3": "adhikārā bahū amhaṃ ",
  "thi-ap30:20.4": "tumhatthāya mahāmune. ",
  "thi-ap30:21.1": "yaṃ amhaṃ purimaṃ kammaṃ ",
  "thi-ap30:21.2": "kusalaṃ sarase mune ",
  "thi-ap30:21.3": "tumhatthāya mahāvīra ",
  "thi-ap30:21.4": "puññānupacitāni no. ",
  "thi-ap30:22.1": "abhabbaṭṭhāne vajjetvā ",
  "thi-ap30:22.2": "vārayimaha anācaraṃ ",
  "thi-ap30:22.3": "tuyhatthāya mahāvīra ",
  "thi-ap30:22.4": "cattāni jīvitāni no. ",
  "thi-ap30:23.1": "nekakoṭisahassānaṃ ",
  "thi-ap30:23.2": "bhariyatthāya’dāsi no ",
  "thi-ap30:23.3": "na tattha vimanā homa ",
  "thi-ap30:23.4": "tuyhatthāya mahāmune. ",
  "thi-ap30:24.1": "nekakoṭisahassānaṃ ",
  "thi-ap30:24.2": "upakārāya’dāsi no ",
  "thi-ap30:24.3": "na tattha vimanā homa ",
  "thi-ap30:24.4": "tuyhatthāya mahāmune. ",
  "thi-ap30:25.1": "nekakoṭisahassānaṃ ",
  "thi-ap30:25.2": "bhojanatthāya’dāsi no ",
  "thi-ap30:25.3": "na tattha vimanā homa ",
  "thi-ap30:25.4": "tuyhatthāya mahāmune. ",
  "thi-ap30:26.1": "nekakoṭisahassāni ",
  "thi-ap30:26.2": "jīvitāni cajimha no ",
  "thi-ap30:26.3": "‘bhayamokkhaṃ karissāma’ ",
  "thi-ap30:26.4": "jīvitāni cajimha se. ",
  "thi-ap30:27.1": "aṅgagate alaṅkāre ",
  "thi-ap30:27.2": "vatthe nānāvidhe bahū ",
  "thi-ap30:27.3": "itthibhaṇḍe na gūhāma ",
  "thi-ap30:27.4": "tuyhatthāya mahāmune. ",
  "thi-ap30:28.1": "dhanadhaññapariccāgaṃ ",
  "thi-ap30:28.2": "gāmāni nigamāni ca ",
  "thi-ap30:28.3": "khettā puttā ca dhītā ca ",
  "thi-ap30:28.4": "pariccattā mahāmune. ",
  "thi-ap30:29.1": "hatthi assā gavā cāpi ",
  "thi-ap30:29.2": "dāsiyo paricārikā ",
  "thi-ap30:29.3": "tuyhatthāya mahāvīra ",
  "thi-ap30:29.4": "pariccattā asaṅkhiyā. ",
  "thi-ap30:30.1": "yaṃ amhe paṭimantesi ",
  "thi-ap30:30.2": "dānaṃ dassāma yācake ",
  "thi-ap30:30.3": "vimanaṃ no na passāma ",
  "thi-ap30:30.4": "dadato dānamuttamaṃ. ",
  "thi-ap30:31.1": "nānāvidhaṃ bahuṃ dukkhaṃ ",
  "thi-ap30:31.2": "saṃsāre ca bahubbidhe ",
  "thi-ap30:31.3": "tuyhatthāya mahāvīra ",
  "thi-ap30:31.4": "anubhuttaṃ asaṅkhiyaṃ. ",
  "thi-ap30:32.1": "sukhappattā na modāma ",
  "thi-ap30:32.2": "na ca dukkhesu dummanā ",
  "thi-ap30:32.3": "sabbattha tulitā homa ",
  "thi-ap30:32.4": "tuyhatthāya mahāmune. ",
  "thi-ap30:33.1": "anumaggena sambuddho ",
  "thi-ap30:33.2": "yaṃ dhammaṃ abhinīhari ",
  "thi-ap30:33.3": "anubhutvā sukhaṃ dukkhaṃ ",
  "thi-ap30:33.4": "patto bodhiṃ mahāmuni. brahmadevaṃ ",
  "thi-ap30:34.1": "ca sambuddhaṃ ",
  "thi-ap30:34.2": "gotamaṃ lokanāyakaṃ ",
  "thi-ap30:34.3": "aññesaṃ lokanāthānaṃ ",
  "thi-ap30:34.4": "saṅgamā tehi no bahū. ",
  "thi-ap30:35.1": "adhikārā bahū amhaṃ ",
  "thi-ap30:35.2": "tuyhatthā mahāmune ",
  "thi-ap30:35.3": "gavesato buddhadhamme ",
  "thi-ap30:35.4": "mayaṃ te paricārikā. ",
  "thi-ap30:36.1": "kappe ca sahatahasse ",
  "thi-ap30:36.2": "caturo ca asaṅkhiye ",
  "thi-ap30:36.3": "dīpaṅkaro mahāvīro ",
  "thi-ap30:36.4": "uppajji lokanāyako. ",
  "thi-ap30:37.1": "paccantadesavisaye ",
  "thi-ap30:37.2": "nimantetvā tathāgataṃ ",
  "thi-ap30:37.3": "tassa āgamanaṃ maggaṃ ",
  "thi-ap30:37.4": "sodhenti tuṭṭhamānasā. ",
  "thi-ap30:38.1": "tena kālena so āsi ",
  "thi-ap30:38.2": "sumedho nāma brāhmaṇo ",
  "thi-ap30:38.3": "maggaṃ ca paṭiyādesi ",
  "thi-ap30:38.4": "āyataṃ sabbadassino. ",
  "thi-ap30:39.1": "tena kālena āsimha ",
  "thi-ap30:39.2": "sabbā brāhmaṇasamhavā ",
  "thi-ap30:39.3": "thalūdajāni pupphāni ",
  "thi-ap30:39.4": "āharimha samāgamaṃ. ",
  "thi-ap30:40.1": "tasmiṃ so samaye buddho ",
  "thi-ap30:40.2": "dīpaṅkaro mahāyaso ",
  "thi-ap30:40.3": "viyākāsi mahāvīro ",
  "thi-ap30:40.4": "isīmuggatamānasaṃ. ",
  "thi-ap30:41.1": "calatī ravati paṭhavī ",
  "thi-ap30:41.2": "saṅkampati sadevakaṃ ",
  "thi-ap30:41.3": "tassa kammaṃ pakittente ",
  "thi-ap30:41.4": "isinuggatamānaso. ",
  "thi-ap30:42.1": "devakaññā manussā ca ",
  "thi-ap30:42.2": "mayaṃ cā’pi sadevakā ",
  "thi-ap30:42.3": "nānāpūjaniyaṃ bhaṇḍaṃ ",
  "thi-ap30:42.4": "pūjayitvāna patthayuṃ. ",
  "thi-ap30:43.1": "tesaṃ buddho viyākāsi ",
  "thi-ap30:43.2": "jotidīpasanāmako ",
  "thi-ap30:43.3": "“ajja ye patthitā atthi ",
  "thi-ap30:43.4": "te bhavissanti sammukhā.” ",
  "thi-ap30:44.1": "aparimeyye ito kappe ",
  "thi-ap30:44.2": "yaṃ no buddho viyākari ",
  "thi-ap30:44.3": "taṃ vācamanumodantī ",
  "thi-ap30:44.4": "evaṅkārī ahumha no. ",
  "thi-ap30:45.1": "tassa kammassa sukatassa ",
  "thi-ap30:45.2": "tattha cittaṃ pasādiya ",
  "thi-ap30:45.3": "devamānusakaṃ yoni ",
  "thi-ap30:45.4": "anubhotvā asaṅkhiyaṃ. ",
  "thi-ap30:46.1": "sukhadukkhe’nubhotvāna ",
  "thi-ap30:46.2": "devesu mānusesu ca ",
  "thi-ap30:46.3": "pacchimabhave sampatte ",
  "thi-ap30:46.4": "jātā’mha sākiye kule. ",
  "thi-ap30:47.1": "rūpavatī bhogavatī ",
  "thi-ap30:47.2": "yasasīlavatī tato ",
  "thi-ap30:47.3": "sabbaṅgasampadā homa ",
  "thi-ap30:47.4": "kulesu atisakkatā. ",
  "thi-ap30:48.1": "lābhaṃ silokaṃ sakkāraṃ ",
  "thi-ap30:48.2": "lokadhammasamāgamaṃ ",
  "thi-ap30:48.3": "cittaṃ ca dukkhitaṃ natthi ",
  "thi-ap30:48.4": "vasāma akutobhayā. ",
  "thi-ap30:49.1": "vuttaṃ hetaṃ bhagavatā ",
  "thi-ap30:49.2": "rañño antepure tadā ",
  "thi-ap30:49.3": "khattiyānaṃ pure vīro upakāraṃ ",
  "thi-ap30:49.4": "ca niddisi. ",
  "thi-ap30:50.1": "upakārā ca yā nārī ",
  "thi-ap30:50.2": "yā ca nārī sukhe dukhe ",
  "thi-ap30:50.3": "atthakkhāyī ca yā nārī ",
  "thi-ap30:50.4": "yā ca nārī’nukampikā. ",
  "thi-ap30:51.1": "dhammaṃ care sucaritaṃ ",
  "thi-ap30:51.2": "na naṃ duccaritaṃ care ",
  "thi-ap30:51.3": "dhammacārī sukhaṃ seti ",
  "thi-ap30:51.4": "asmiṃ loke paramhi ca. ",
  "thi-ap30:52.1": "agāraṃ vijahitvāna ",
  "thi-ap30:52.2": "pabbajimha’nagāriyaṃ ",
  "thi-ap30:52.3": "aḍḍhamāse asampatte ",
  "thi-ap30:52.4": "catusaccaṃ phusimha no. ",
  "thi-ap30:53.1": "cīvaraṃ piṇḍapātaṃ ca ",
  "thi-ap30:53.2": "paccayaṃ sayanāsanaṃ ",
  "thi-ap30:53.3": "upanenti bahuṃ amhe ",
  "thi-ap30:53.4": "sāgarasseva ūmiyo. ",
  "thi-ap30:54.1": "kilesā jhāpitā amhaṃ ",
  "thi-ap30:54.2": "bhavā sabbe samūhatā, ",
  "thi-ap30:54.3": "nāgīva bandhanaṃ chetvā ",
  "thi-ap30:54.4": "viharāma anāsavā. ",
  "thi-ap30:55.1": "svāgataṃ vata me āsi ",
  "thi-ap30:55.2": "buddhaseṭṭhassa santike, ",
  "thi-ap30:55.3": "tisso vijjā anuppattā ",
  "thi-ap30:55.4": "kataṃ buddhassa sāsanaṃ. ",
  "thi-ap30:56.1": "paṭisambhidā catasso ",
  "thi-ap30:56.2": "ca …pe… ",
  "thi-ap30:56.3": "",
  "thi-ap30:56.4": "kataṃ buddhassa sāsanaṃ. ",
  "thi-ap30:57.1": "evaṃ bahuvidhaṃ dukkhaṃ ",
  "thi-ap30:57.2": "sampattī ca bahubbidhā ",
  "thi-ap30:57.3": "visuddhabhāvaṃ sampannā ",
  "thi-ap30:57.4": "labhāma sabbasampadā. ",
  "thi-ap30:58.1": "yā dadanti sakattānaṃ ",
  "thi-ap30:58.2": "puññatthāya mahesino ",
  "thi-ap30:58.3": "sahāyasampadā honti ",
  "thi-ap30:58.4": "nibbānapadamasaṅkhataṃ. ",
  "thi-ap30:59.1": "parikkhīṇaṃ atītaṃ ca ",
  "thi-ap30:59.2": "paccuppannaṃ anāgataṃ ",
  "thi-ap30:59.3": "sabbaṃ kammampi no khīṇaṃ ",
  "thi-ap30:59.4": "pāde vandāma cakkhuma. ",
  "thi-ap30:60.1": "nibbānāya vajantīnaṃ ",
  "thi-ap30:60.2": "kiṃ vo vakkhāma uttariṃ santasaṅkhatadosaṃ ",
  "thi-ap30:60.3": "hi ",
  "thi-ap30:60.4": "pappotha amataṃ padaṃ. ",
  "thi-ap30:61.1": "itthaṃ sudaṃ yasodharāpamukhāni aṭṭhārasabhikkhunīsahassāni bhagavato sammukhā imā gāthāyo abhāsitthāti. ",
  "thi-ap30:62.1": "yasodharāpamukhaaṭṭhārasabhikkhunisahassāpadānaṃ dasamaṃ. ",
  "thi-ap30:63.1": "kūṇḍalakesīvaggo tatiyo. ",
  "thi-ap30:64.1": "tatthuddānaṃ: ",
  "thi-ap30:65.1": "kuṇḍalā gotamī ceva ",
  "thi-ap30:65.2": "dhammadinnā ca sakulā ",
  "thi-ap30:65.3": "caranandā ca soṇā ca ",
  "thi-ap30:65.4": "kāpilānī yasodharā, ",
  "thi-ap30:66.1": "dasasahassabhikkhunī ",
  "thi-ap30:66.2": "aṭṭhārasasahassakā ",
  "thi-ap30:66.3": "gāthāsatāni cattāri ",
  "thi-ap30:66.4": "cha ca sattati meva ca. "
}
