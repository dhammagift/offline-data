  "thi-ap28:89.4": "",
  "thi-ap28:90.1": "nibbinditvāna saṃsāre ",
  "thi-ap28:90.2": "pabbajiṃ anagāriyaṃ ",
  "thi-ap28:90.3": "sahassaparivārena ",
  "thi-ap28:90.4": "pabbajitvā akiñcanā. ",
  "thi-ap28:91.1": "agāraṃ vijahitvāna ",
  "thi-ap28:91.2": "pabbajiṃ anagāriyaṃ ",
  "thi-ap28:91.3": "addhamāse asampatte ",
  "thi-ap28:91.4": "catusaccaṃ apāpuṇiṃ. ",
  "thi-ap28:92.1": "cīvaraṃ piṇḍapātaṃ ca ",
  "thi-ap28:92.2": "paccayaṃ sayanāsanaṃ ",
  "thi-ap28:92.3": "upanenti bahū neke ",
  "thi-ap28:92.4": "sāgarasseva ūmiyo. ",
  "thi-ap28:93.1": "kilesā jhāpitā mayhaṃ ",
  "thi-ap28:93.2": "bhavā sabbe samūhatā, nāgīva bandhanaṃ chetvā ",
  "thi-ap28:93.3": "viharāmi anāsavā. ",
  "thi-ap28:94.1": "svāgataṃ vata me āsi ",
  "thi-ap28:94.2": "buddhaseṭṭhassa santike, tisso vijjā anuppattā ",
  "thi-ap28:94.3": "kataṃ buddhassa sāsanaṃ. ",
  "thi-ap28:95.1": "paṭisambhidā catasso ",
  "thi-ap28:95.2": "ca vimokkhāpi ca aṭṭhime, chaḷabhiññā sacchikatā ",
  "thi-ap28:95.3": "kataṃ buddhassa sāsanaṃ. ",
  "thi-ap28:96.1": "evaṃ bahuvidhaṃ dukkhaṃ ",
  "thi-ap28:96.2": "sampatti ca bahubbidhā ",
  "thi-ap28:96.3": "visuddhabhāvaṃ sampattā ",
  "thi-ap28:96.4": "labhāmi sabbasampadā. ",
  "thi-ap28:97.1": "sā dadāti sakattānaṃ ",
  "thi-ap28:97.2": "puññatthāya mahesino ",
  "thi-ap28:97.3": "sahāyasampadā honti ",
  "thi-ap28:97.4": "nibbānapadamasaṅkhataṃ. ",
  "thi-ap28:98.1": "parikkhīṇaṃ atītaṃ ca ",
  "thi-ap28:98.2": "paccuppannaṃ anāgataṃ ",
  "thi-ap28:98.3": "sabbaṃ kammaṃ mamaṃ khīṇaṃ ",
  "thi-ap28:98.4": "pāde vandāmi cakkhuma. ",
  "thi-ap28:99.1": "itthaṃ sudaṃ yasodharā bhikkhunī imā gāthāyo abhāsitthāti. ",
  "thi-ap28:100.1": "yasodharātheriyāpadānaṃ aṭṭhamaṃ. "
}
