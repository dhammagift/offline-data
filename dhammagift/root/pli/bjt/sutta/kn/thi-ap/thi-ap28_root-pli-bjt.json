{
  "thi-ap28:0.1": "",
  "thi-ap28:0.2": "",
  "thi-ap28:0.3": "3. 8 yasodharāpadānaṃ ",
  "thi-ap28:1.1": "ekasmiṃ samaye ramme ",
  "thi-ap28:1.2": "iddhe rājagahe pure ",
  "thi-ap28:1.3": "pabbhāramhi varekasmiṃ ",
  "thi-ap28:1.4": "vasante naranāyake. ",
  "thi-ap28:2.1": "vasantiyā tamhi nagare ",
  "thi-ap28:2.2": "ramme bhikkhunupassaye ",
  "thi-ap28:2.3": "yasodharā bhikkhuniyā ",
  "thi-ap28:2.4": "evaṃ āsi vitakkitaṃ; “nando rāhulabhaddo ca sāvakaggā tatheva ca ",
  "thi-ap28:3.1": "suddhodano mahārājā ",
  "thi-ap28:3.2": "gotamī ca pajāpatī. ",
  "thi-ap28:3.3": "abhiññātā ca mahātherā ",
  "thi-ap28:3.4": "theriyo ca mahiddhikā ",
  "thi-ap28:4.1": "santiṃ gatāva āsuṃ te ",
  "thi-ap28:4.2": "dīpacvīva nirāsavā. ",
  "thi-ap28:4.3": "lokanāthe dharanteva ",
  "thi-ap28:4.4": "ahampi ca sivaṃ padaṃ ",
  "thi-ap28:5.1": "gamissāmī”ti cintetvā ",
  "thi-ap28:5.2": "passantī āyumattano. ",
  "thi-ap28:5.3": "passitvā āyusaṅkhāraṃ ",
  "thi-ap28:5.4": "tadaheva khayaṃ gataṃ ",
  "thi-ap28:6.1": "pattacīvaramādāya ",
  "thi-ap28:6.2": "nikkhamitvā sakassamā. ",
  "thi-ap28:6.3": "purakkhatā bhikkhunīhi ",
  "thi-ap28:6.4": "satehi sahassehi sā ",
  "thi-ap28:7.1": "mahiddhikā mahāpaññā ",
  "thi-ap28:7.2": "sambuddhaṃ upasaṅkami. ",
  "thi-ap28:7.3": "sambuddhaṃ abhivādetvā ",
  "thi-ap28:7.4": "satthuno cakkalakkhino ",
  "thi-ap28:7.5": "nisinnā ekamantamhi ",
  "thi-ap28:7.6": "idaṃ vacanamabravī: ",
  "thi-ap28:8.1": "“aṭṭhasattativassā’haṃ ",
  "thi-ap28:8.2": "pacchimo vattate vayo ",
  "thi-ap28:8.3": "pabbhāraṃ hi anuppattā ",
  "thi-ap28:8.4": "ārocemi mahāmune. ",
  "thi-ap28:9.1": "paripakko vayo mayhaṃ ",
  "thi-ap28:9.2": "parittaṃ mama jīvitaṃ ",
  "thi-ap28:9.3": "pahāya vo gamissāmi ",
  "thi-ap28:9.4": "kataṃ me saraṇamattano. ",
  "thi-ap28:10.1": "vayaṃ hi pacchime kāle ",
  "thi-ap28:10.2": "maraṇaṃ uparundhati ajja ",
  "thi-ap28:10.3": "rattiṃ mahāvīra ",
  "thi-ap28:10.4": "pāpuṇissāmi nibbutiṃ. ",
  "thi-ap28:11.1": "natthi jāti jarā vyādhi ",
  "thi-ap28:11.2": "maraṇañca yahiṃ mune ",
  "thi-ap28:11.3": "tattha gacchāma’haṃ vīra gato ",
  "thi-ap28:11.4": "yattha na dissati. ",
  "thi-ap28:12.1": "yāvatā parisā ettha ",
  "thi-ap28:12.2": "samupāsanti satthuno ",
  "thi-ap28:12.3": "aparādhaṃ pajānanti ",
  "thi-ap28:12.4": "khamantaṃ sammukhā mune. ",
  "thi-ap28:13.1": "saṃsaritvā ca saṃsāre ",
  "thi-ap28:13.2": "khalitaṃ ce mamaṃ tayi ",
  "thi-ap28:13.3": "ārocemi mahāvīra ",
  "thi-ap28:13.4": "aparādhaṃ khamassu me. ",
  "thi-ap28:14.1": "sutvāna tassā vacanaṃ ",
  "thi-ap28:14.2": "munindo idamabravi ",
  "thi-ap28:14.3": "kimuttaraṃ te vakkhāmi ",
  "thi-ap28:14.4": "nibbānāya vajantiyā. ",
  "thi-ap28:15.1": "iddhiṃ cāpi nidassehi ",
  "thi-ap28:15.2": "mama sāsanakārike ",
  "thi-ap28:15.3": "parisānañca sabbāsaṃ ",
  "thi-ap28:15.4": "kaṅkhaṃ chindassu sāsane. ",
  "thi-ap28:16.1": "sutvā taṃ munino vācaṃ ",
  "thi-ap28:16.2": "bhikkhunī sā yasodharā ",
  "thi-ap28:16.3": "vanditvā munirājaṃ taṃ ",
  "thi-ap28:16.4": "idaṃ vacanamabravi: ",
  "thi-ap28:17.1": "“yasodharā ahaṃ vīra ",
  "thi-ap28:17.2": "agāre te pajāpati ",
  "thi-ap28:17.3": "sākiyamhi kule jātā ",
  "thi-ap28:17.4": "itthiyaṅge patiṭṭhitā. ",
  "thi-ap28:18.1": "thinaṃ satahasassānaṃ ",
  "thi-ap28:18.2": "navutīnaṃ chaḷuttari ",
  "thi-ap28:18.3": "agāre te ahaṃ vīra ",
  "thi-ap28:18.4": "pāmokkhā sabbaissarā. ",
  "thi-ap28:19.1": "rūpācāraguṇūpetā ",
  "thi-ap28:19.2": "yobbanaṭṭhā piyaṃvadā ",
  "thi-ap28:19.3": "sabbā maṃ apacāyanti ",
  "thi-ap28:19.4": "devatā viya mānusā. ",
  "thi-ap28:20.1": "kaññāsahassappamukhā ",
  "thi-ap28:20.2": "sakyaputtanivesane ",
  "thi-ap28:20.3": "samānasukhadukkhā tā ",
  "thi-ap28:20.4": "devatā viya nandane. ",
  "thi-ap28:21.1": "kāmadhātumatikkantā ",
  "thi-ap28:21.2": "saṇṭhitā rūpadhātuyā ",
  "thi-ap28:21.3": "rūpena sadisā natthi ",
  "thi-ap28:21.4": "ṭhapetvā lokanāyakaṃ.” ",
  "thi-ap28:22.1": "evamādīni vatvāna uppatitvāna ambaraṃ ",
  "thi-ap28:22.2": "iddhi anekā dassesi buddhānuññā ",
  "thi-ap28:22.3": "yasodharā. ",
  "thi-ap28:22.4": "",
  "thi-ap28:23.1": "cakkavāḷasamaṃ kāyaṃ ",
  "thi-ap28:23.2": "sīsaṃ uttarato kuru ",
  "thi-ap28:23.3": "ubho pakkhā duve dīpā ",
  "thi-ap28:23.4": "jambudīpo sarīrato. ",
  "thi-ap28:24.1": "dakkhiṇañca saraṃ piñjaṃ ",
  "thi-ap28:24.2": "nānāsākhā tu pattakā ",
  "thi-ap28:24.3": "cando ca suriyo akkhi ",
  "thi-ap28:24.4": "merupabbatato sikhā. ",
  "thi-ap28:25.1": "cakkavāḷagiri tuṇḍaṃ ",
  "thi-ap28:25.2": "jamburukkhaṃ samūlakaṃ ",
  "thi-ap28:25.3": "vījamānā upāgantvā ",
  "thi-ap28:25.4": "vandate lokanāyakaṃ. ",
  "thi-ap28:26.1": "hatthivaṇṇaṃ tatheva’ssaṃ ",
  "thi-ap28:26.2": "pabbataṃ jaladhiṃ tathā ",
  "thi-ap28:26.3": "vandimaṃ suriyaṃ meruṃ ",
  "thi-ap28:26.4": "sakkavaṇṇañca dassayi. ",
  "thi-ap28:27.1": "“yasodharā ahaṃ vīra ",
  "thi-ap28:27.2": "pāde vandāmi cakkhuma” ",
  "thi-ap28:27.3": "sahassaṃ lokadhātūnaṃ ",
  "thi-ap28:27.4": "phullapadmena chādayi. ",
  "thi-ap28:28.1": "brahmavaṇṇañca māpetvā ",
  "thi-ap28:28.2": "dhammaṃ desesi suññataṃ ",
  "thi-ap28:28.3": "“yasodharā ahaṃ vīra ",
  "thi-ap28:28.4": "pāde vandāmi cakkhuma. ",
  "thi-ap28:29.1": "iddhisu ca vasī homi ",
  "thi-ap28:29.2": "dibbāya sotadhātuyā ",
  "thi-ap28:29.3": "cetopariyañāṇassa ",
  "thi-ap28:29.4": "vasī homi mahāmuni. ",
  "thi-ap28:30.1": "pubbenivāsaṃ jānāmi ",
  "thi-ap28:30.2": "dibbacakkhu visodhitaṃ. ",
  "thi-ap28:30.3": "sabbāsavā parikkhīṇā ",
  "thi-ap28:30.4": "natthidāni punabbhavo. ",
  "thi-ap28:31.1": "atthadhammaniruttīsu ",
  "thi-ap28:31.2": "paṭibhāne tatheva ca ",
  "thi-ap28:31.3": "ñāṇaṃ mayhaṃ mahāvīra ",
  "thi-ap28:31.4": "uppannaṃ tava santike. ",
  "thi-ap28:32.1": "buddhānaṃ lokanāthānaṃ ",
  "thi-ap28:32.2": "saṅgamaṃ te sudassitaṃ ",
  "thi-ap28:32.3": "adhikāraṃ bahuṃ mayhaṃ ",
  "thi-ap28:32.4": "tuyhatthāya mahāmune. ",
  "thi-ap28:33.1": "yaṃ mayhaṃ purimaṃ kammaṃ ",
  "thi-ap28:33.2": "kusalaṃ sarase mune ",
  "thi-ap28:33.3": "tuyhatthāya mahāvīra ",
  "thi-ap28:33.4": "puññaṃ upacitaṃ mayā. ",
  "thi-ap28:34.1": "abhabbaṭṭhāne vajjetvā ",
  "thi-ap28:34.2": "vārayitvā anācaraṃ ",
  "thi-ap28:34.3": "tuyhatthāya mahāvīra ",
  "thi-ap28:34.4": "sañcattaṃ jīvitaṃ mayā. ",
  "thi-ap28:35.1": "nekakoṭisahassānaṃ ",
  "thi-ap28:35.2": "bhariyatthāya’dāsi maṃ ",
  "thi-ap28:35.3": "na tattha vimanā homi ",
  "thi-ap28:35.4": "tuyhatthāya mahāmuni ",
  "thi-ap28:36.1": "nekakoṭisahassānaṃ ",
  "thi-ap28:36.2": "upakārāya’dāsi maṃ ",
  "thi-ap28:36.3": "na tattha vimanā homi ",
  "thi-ap28:36.4": "tuyhatthāya mahāmuni. ",
  "thi-ap28:37.1": "nekakoṭisahassānaṃ ",
  "thi-ap28:37.2": "bhojanatthāya’dāsi maṃ ",
  "thi-ap28:37.3": "na tattha vimanā homi ",
  "thi-ap28:37.4": "tuyhatthāya mahāmuni. ",
  "thi-ap28:38.1": "nekakoṭisahassāni ",
  "thi-ap28:38.2": "jīvitāni pariccajiṃ ",
  "thi-ap28:38.3": "bhayamokkhaṃ karissaṃ ti ",
  "thi-ap28:38.4": "cajāmi mama jīvitaṃ. ",
  "thi-ap28:39.1": "aṅgagate alaṅkāre ",
  "thi-ap28:39.2": "vatthe nānāvidhe bahū ",
  "thi-ap28:39.3": "itthimaṇḍe na gūhāmi ",
  "thi-ap28:39.4": "tuyhatthāya mahāmuni. ",
  "thi-ap28:40.1": "dhanadhaññapariccāgaṃ ",
  "thi-ap28:40.2": "gāmāni nigamāni ca ",
  "thi-ap28:40.3": "khettā puttā ca dhītā ca ",
  "thi-ap28:40.4": "pariccattā mahāmune. ",
  "thi-ap28:41.1": "hatthi assā gavā cāpi ",
  "thi-ap28:41.2": "dāsiyo paricārikā ",
  "thi-ap28:41.3": "tuyhatthāya mahāvīra ",
  "thi-ap28:41.4": "pariccattā asaṅkhiyā. ",
  "thi-ap28:42.1": "yaṃ mayhaṃ paṭimantesi ",
  "thi-ap28:42.2": "dānaṃ dassāmi yācake ",
  "thi-ap28:42.3": "vimanaṃ me na passāmi ",
  "thi-ap28:42.4": "dadato dānamuttamaṃ. ",
  "thi-ap28:43.1": "nānāvidhaṃ bahuṃ dukkhaṃ ",
  "thi-ap28:43.2": "saṃsāre ca bahubbidhe ",
  "thi-ap28:43.3": "tuyhatthāya mahāvīra ",
  "thi-ap28:43.4": "anubhuttaṃ asaṅkhiyaṃ. ",
  "thi-ap28:44.1": "sukhappattā na modāmi ",
  "thi-ap28:44.2": "na ca dukkhesu dummanā ",
  "thi-ap28:44.3": "sabbattha tulitā homi ",
  "thi-ap28:44.4": "tuyhatthāya mahāmune. ",
  "thi-ap28:45.1": "anumaggena sambuddho ",
  "thi-ap28:45.2": "yaṃ dhammaṃ abhinīhari ",
  "thi-ap28:45.3": "anubhutvā sukhaṃ dukkhaṃ ",
  "thi-ap28:45.4": "patto bodhiṃ mahāmuni. ",
  "thi-ap28:46.1": "brahmadevañca sambuddhaṃ ",
  "thi-ap28:46.2": "gotamaṃ lokanāyakaṃ. ",
  "thi-ap28:46.3": "aññesaṃ lokanāthānaṃ ",
  "thi-ap28:46.4": "saṅgamā te bahū mayā. ",
  "thi-ap28:47.1": "adhikāraṃ bahuṃ mayhaṃ ",
  "thi-ap28:47.2": "tuyhatthāya mahāmune ",
  "thi-ap28:47.3": "gavesato buddhadhamme ",
  "thi-ap28:47.4": "ahaṃ te paricārikā. ",
  "thi-ap28:48.1": "kappe satasahasse ca ",
  "thi-ap28:48.2": "caturo ca asaṅkhiye ",
  "thi-ap28:48.3": "dīpaṅkaro mahāvīro ",
  "thi-ap28:48.4": "uppajji lokanāyako. ",
  "thi-ap28:49.1": "paccantadesavisaye ",
  "thi-ap28:49.2": "nimantetvā tathāgataṃ ",
  "thi-ap28:49.3": "tassa āgamanaṃ maggaṃ ",
  "thi-ap28:49.4": "sodhenti tuṭṭhamānasā. ",
  "thi-ap28:50.1": "tena kālena so āsi ",
  "thi-ap28:50.2": "sumedho nāma brāhmaṇo. ",
  "thi-ap28:50.3": "maggañca paṭiyādesi ",
  "thi-ap28:50.4": "āyato sabbadassino. ",
  "thi-ap28:51.1": "tena kālena’haṃ āsiṃ ",
  "thi-ap28:51.2": "kaññā brāhmaṇasamhavā ",
  "thi-ap28:51.3": "sumittā nāma nāmena ",
  "thi-ap28:51.4": "upagañchiṃ samāgamaṃ. ",
  "thi-ap28:52.1": "aṭṭha uppalahatthāni ",
  "thi-ap28:52.2": "pūjanatthāya satthuno ",
  "thi-ap28:52.3": "ādāya janasammejjha ",
  "thi-ap28:52.4": "addasaṃ isimuggataṃ. ",
  "thi-ap28:53.1": "cīrānupari āsīnaṃ ",
  "thi-ap28:53.2": "atikantaṃ manoharaṃ ",
  "thi-ap28:53.3": "disvā tadā amaññissaṃ ",
  "thi-ap28:53.4": "“saphalaṃ jīvitaṃ mama.” ",
  "thi-ap28:54.1": "parakkamaṃ taṃ saphalaṃ ",
  "thi-ap28:54.2": "addasaṃ isino tadā ",
  "thi-ap28:54.3": "pubbakammena sambuddhe ",
  "thi-ap28:54.4": "cittañcāpi pasīdi me. ",
  "thi-ap28:55.1": "bhiyyo cittaṃ pasādesiṃ ",
  "thi-ap28:55.2": "ise uggatamānase ",
  "thi-ap28:55.3": "deyyaṃ aññaṃ na passāmi ",
  "thi-ap28:55.4": "demi pupphāni te ise. ",
  "thi-ap28:56.1": "pañca hatthā tava hontu ",
  "thi-ap28:56.2": "tayo hontu mamaṃ ise ",
  "thi-ap28:56.3": "tena siddhi samā hotu ",
  "thi-ap28:56.4": "bodhatthāya tavaṃ ise. bhāṇavāraṃ ",
  "thi-ap28:57.1": "catutthaṃ. ",
  "thi-ap28:58.1": "isi gahetvā pupphāni ",
  "thi-ap28:58.2": "āgacchantaṃ mahāyasaṃ ",
  "thi-ap28:58.3": "pūjesi janasammajjhe ",
  "thi-ap28:58.4": "bodhatthāya mahāisiṃ. ",
  "thi-ap28:59.1": "passitvā janasammajjhe ",
  "thi-ap28:59.2": "dīpaṅkaro mahāmuni ",
  "thi-ap28:59.3": "viyākāsi mahāvīro ",
  "thi-ap28:59.4": "isiṃ ",
  "thi-ap28:60.1": "",
  "thi-ap28:60.2": "uggatamānasaṃ. ",
  "thi-ap28:60.3": "",
  "thi-ap28:60.4": "",
  "thi-ap28:61.1": "samacittā samakammā ",
  "thi-ap28:61.2": "samakārī bhavissati ",
  "thi-ap28:61.3": "piyā hessati kammena ",
  "thi-ap28:61.4": "tuyhatthāya mahāise. ",
  "thi-ap28:62.1": "sudassanā suppiyā ca ",
  "thi-ap28:62.2": "manāpā piyavādinī ",
  "thi-ap28:62.3": "tassa dhammesu dāyādā ",
  "thi-ap28:62.4": "piyā hessati itthikā, ",
  "thi-ap28:63.1": "yathāpi bhaṇḍasāmuggaṃ ",
  "thi-ap28:63.2": "anurakkhanti sāmino ",
  "thi-ap28:63.3": "evaṃ kusaladhammānaṃ ",
  "thi-ap28:63.4": "anurakkhissate ayaṃ. ",
  "thi-ap28:64.1": "tassa te anukampantī ",
  "thi-ap28:64.2": "pūrayissati pāramī ",
  "thi-ap28:64.3": "sīhova pañjaraṃ bhetvā ",
  "thi-ap28:64.4": "pāpuṇissati bodhiyaṃ. ",
  "thi-ap28:65.1": "aparimeyye ito kappe ",
  "thi-ap28:65.2": "yaṃ maṃ buddho viyākari ",
  "thi-ap28:65.3": "taṃ vācaṃ anumodantī ",
  "thi-ap28:65.4": "evaṃkārī bhaviṃ ahaṃ. ",
  "thi-ap28:66.1": "tassa kammassa sukatassa ",
  "thi-ap28:66.2": "tattha cittaṃ pasādayiṃ ",
  "thi-ap28:66.3": "devamānusakaṃ yoniṃ upapajja asaṅkhiyaṃ. ",
  "thi-ap28:66.4": "anubhotvā sukhaṃ ",
  "thi-ap28:67.1": "dukkhaṃ ",
  "thi-ap28:67.2": "devesu mānusesu ca ",
  "thi-ap28:67.3": "pacchime bhave sampatte ",
  "thi-ap28:67.4": "ajāyiṃ sākiye kule. ",
  "thi-ap28:68.1": "rūpavatī bhogavatī ",
  "thi-ap28:68.2": "yasasīlavatī tathā ",
  "thi-ap28:68.3": "sabbaṅgasampadā homi ",
  "thi-ap28:68.4": "kusalesu atisakkatā. ",
  "thi-ap28:69.1": "lābhaṃ silokaṃ sakkāraṃ ",
  "thi-ap28:69.2": "lokadhammasamāgamaṃ ",
  "thi-ap28:69.3": "cittañca dukkhitaṃ natthi ",
  "thi-ap28:69.4": "vasāmi akutobhayā. ",
