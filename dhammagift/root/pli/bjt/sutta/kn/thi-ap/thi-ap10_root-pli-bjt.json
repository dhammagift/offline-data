{
  "thi-ap10:0.1": "",
  "thi-ap10:0.2": "",
  "thi-ap10:0.3": "1. 10 udakadāyikāpadānaṃ. ",
  "thi-ap10:1.1": "nagare bandhumatiyā ",
  "thi-ap10:1.2": "ahosiṃ udahārikā, ",
  "thi-ap10:1.3": "udahārena jīvāmi ",
  "thi-ap10:1.4": "tena posemi dārake. ",
  "thi-ap10:2.1": "deyyadhammo ca me natthi ",
  "thi-ap10:2.2": "puññakkhette anuttare, ",
  "thi-ap10:2.3": "koṭṭhakaṃ upasaṅkamma ",
  "thi-ap10:2.4": "udakaṃ paṭṭhapesa’haṃ. ",
  "thi-ap10:3.1": "tena kammena sukatena ",
  "thi-ap10:3.2": "tāvatiṃsamagaccha’haṃ, ",
  "thi-ap10:3.3": "tattha me sukataṃ vyamhaṃ ",
  "thi-ap10:3.4": "udahārena nimmitaṃ. ",
  "thi-ap10:4.1": "accharānaṃ sahassassa ",
  "thi-ap10:4.2": "ahaṃ hi pavarā tadā, ",
  "thi-ap10:4.3": "dasaṭṭhānehi tā sabbā ",
  "thi-ap10:4.4": "abhibhomi sadā ahaṃ. ",
  "thi-ap10:5.1": "paññāsaṃ devarājūnaṃ ",
  "thi-ap10:5.2": "mahesittamakārayiṃ, ",
  "thi-ap10:5.3": "vīsaticakkavattīnaṃ ",
  "thi-ap10:5.4": "mahesittamakārayiṃ. ",
  "thi-ap10:6.1": "duve bhave saṃsarāmi ",
  "thi-ap10:6.2": "devatte atha mānuse, ",
  "thi-ap10:6.3": "duggatiṃ nābhijānāmi ",
  "thi-ap10:6.4": "dakadānassidaṃ phalaṃ. ",
  "thi-ap10:7.1": "pabbatagge dumagge vā ",
  "thi-ap10:7.2": "antalikkhe ca bhūmiyaṃ, ",
  "thi-ap10:7.3": "yadā udakamicchāmi ",
  "thi-ap10:7.4": "khippaṃ paṭilabhāmahaṃ. ",
  "thi-ap10:8.1": "avuṭṭhikā disā natthi ",
  "thi-ap10:8.2": "santattakuthītā na ca, ",
  "thi-ap10:8.3": "mama saṅkappamaññāya ",
  "thi-ap10:8.4": "mahāmegho pavassati. ",
  "thi-ap10:9.1": "kadāci nīyamānāya ",
  "thi-ap10:9.2": "ñātisaṅghena me tadā ",
  "thi-ap10:9.3": "yadā icchāmahaṃ vassaṃ ",
  "thi-ap10:9.4": "mahāmegho pavassati ",
  "thi-ap10:10.1": "uṇhaṃ vā pariḷāho vā ",
  "thi-ap10:10.2": "sarīre me na vijjati, ",
  "thi-ap10:10.3": "kāye ca me rajo natthi ",
  "thi-ap10:10.4": "dakadānassidaṃ phalaṃ. ",
  "thi-ap10:11.1": "visuddhamanasā ajja ",
  "thi-ap10:11.2": "apetamalapāpikā, ",
  "thi-ap10:11.3": "sabbāsavā parikkhīṇā ",
  "thi-ap10:11.4": "natthidāni punabbhavo. ",
  "thi-ap10:12.1": "ekanavute ito kappe ",
  "thi-ap10:12.2": "yaṃ kammamakariṃ tadā, ",
  "thi-ap10:12.3": "duggatiṃ nābhijānāmi ",
  "thi-ap10:12.4": "dākadānassidaṃ phalaṃ. ",
  "thi-ap10:13.1": "kilesā jhāpitā mayhaṃ ",
  "thi-ap10:13.2": "",
  "thi-ap10:13.3": "",
  "thi-ap10:14.1": "",
  "thi-ap10:14.2": "",
  "thi-ap10:14.3": "",
  "thi-ap10:15.1": "",
  "thi-ap10:15.2": "…pe… ",
  "thi-ap10:15.3": "kataṃ buddhassa sāsanaṃ. ",
  "thi-ap10:16.1": "itthaṃ sudaṃ udakadāyikā bhikkhunī imā gāthāyo abhāsitthāti. ",
  "thi-ap10:17.1": "udakadāyikātheriyāpadānaṃ dasamaṃ. ",
  "thi-ap10:18.1": "",
  "thi-ap10:19.1": "tassuddānaṃ: ",
  "thi-ap10:20.1": "sumedhā mekhalādāyi ",
  "thi-ap10:20.2": "maṇḍapasaṅkamaṃ dadā, ",
  "thi-ap10:20.3": "naḷamālī piṇḍadadā ",
  "thi-ap10:20.4": "kaṭacchu uppalappadā. ",
  "thi-ap10:21.1": "dīpadā dakadā ceva ",
  "thi-ap10:21.2": "gāthāyo gaṇitā iha, ",
  "thi-ap10:21.3": "ekaṃ gāthāsataṃ ceva ",
  "thi-ap10:21.4": "tiṃsatī ca taduttariṃ. sumedhāvaggo paṭhamo. "
}
