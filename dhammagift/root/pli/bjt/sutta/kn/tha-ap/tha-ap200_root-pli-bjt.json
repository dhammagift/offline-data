{
  "tha-ap200:0.1": "",
  "tha-ap200:0.2": "",
  "tha-ap200:0.3": "198. muṭṭhipūjakattherāpadānaṃ. ",
  "tha-ap200:1.1": "sumedho nāma bhagavā ",
  "tha-ap200:1.2": "lokajeṭṭho narāsabho, ",
  "tha-ap200:1.3": "pacchime anukampāya ",
  "tha-ap200:1.4": "padhānaṃ padahī jino. ",
  "tha-ap200:2.1": "tassa caṅkamamānassa ",
  "tha-ap200:2.2": "dipadindassa tādino, ",
  "tha-ap200:2.3": "girinelassa pupphānaṃ ",
  "tha-ap200:2.4": "muṭṭhiṃ buddhassa ropayiṃ. ",
  "tha-ap200:3.1": "tena cittappasādena ",
  "tha-ap200:3.2": "sukkamūlena codito, ",
  "tha-ap200:3.3": "tiṃsakappasahassāni ",
  "tha-ap200:3.4": "duggatiṃ nūpapajjahaṃ. ",
  "tha-ap200:4.1": "tevīsatikappasate ",
  "tha-ap200:4.2": "sunelo nāma khattiyo, ",
  "tha-ap200:4.3": "sattaratanasampanno ",
  "tha-ap200:4.4": "eko āsiṃ mahabbalo. ",
  "tha-ap200:5.1": "paṭisambhidā catasso ",
  "tha-ap200:5.2": "vimokkhāpi ca aṭṭhime, chaḷabhiññā sacchikatā ",
  "tha-ap200:5.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap200:6.1": "itthaṃ sudaṃ āyasmā muṭṭhipūjako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap200:7.1": "muṭṭhipūjakattherassa apadānaṃ aṭṭhamaṃ. "
}
