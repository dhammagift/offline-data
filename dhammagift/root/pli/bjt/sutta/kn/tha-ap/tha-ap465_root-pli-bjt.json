{
  "tha-ap465:0.1": "",
  "tha-ap465:0.2": "",
  "tha-ap465:0.3": "463. citakanibbāpakattherāpadānaṃ ",
  "tha-ap465:1.1": "dayhamāne sarīramhi ",
  "tha-ap465:1.2": "vessabhussa mahesino, ",
  "tha-ap465:1.3": "gandhodakaṃ gahetvāna ",
  "tha-ap465:1.4": "citaṃ nibbāpayiṃ ahaṃ. ",
  "tha-ap465:2.1": "ekatiṃse ito kappe ",
  "tha-ap465:2.2": "citaṃ nibbāpayiṃ ahaṃ, ",
  "tha-ap465:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap465:2.4": "gandhodakassidaṃ phalaṃ. ",
  "tha-ap465:3.1": "kilesā jhāpitā mayhaṃ ",
  "tha-ap465:3.2": "bhavā sabbe samūhatā, nāgo’va bandhanaṃ chetvā ",
  "tha-ap465:3.3": "viharāmi anāsavo. ",
  "tha-ap465:4.1": "svāgataṃ vata me āsi ",
  "tha-ap465:4.2": "buddhaseṭṭhassa santike, tisso vijjā anuppattā ",
  "tha-ap465:4.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap465:5.1": "paṭisambhidā catasso ",
  "tha-ap465:5.2": "ca vimokkhāpi ca aṭṭhime, chaḷabhiññā sacchikatā ",
  "tha-ap465:5.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap465:6.1": "itthaṃ sudaṃ āyasmā citakanibbāpako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap465:7.1": "citakanibbāpakattherassa apadānaṃ tatiyaṃ. "
}
