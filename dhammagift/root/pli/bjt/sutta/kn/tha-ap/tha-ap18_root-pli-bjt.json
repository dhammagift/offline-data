{
  "tha-ap18:0.1": "",
  "tha-ap18:0.2": "",
  "tha-ap18:0.3": "16. rāhulattherāpadānaṃ ",
  "tha-ap18:1.1": "padumuttarassa bhagavato ",
  "tha-ap18:1.2": "lokajeṭṭhassa tādino, ",
  "tha-ap18:1.3": "sattabhūmmahi pāsāde ",
  "tha-ap18:1.4": "ādāsaṃ santhariṃ ahaṃ. ",
  "tha-ap18:2.1": "khīṇāsavasahassehi ",
  "tha-ap18:2.2": "parikiṇṇo mahāmuni, ",
  "tha-ap18:2.3": "upāgamī gandhakuṭiṃ ",
  "tha-ap18:2.4": "dipadindo narāsabho. ",
  "tha-ap18:3.1": "virocento gandhakuṭiṃ ",
  "tha-ap18:3.2": "devadevo narāsabho, ",
  "tha-ap18:3.3": "bhikkhusaṃghe ṭhito satthā ",
  "tha-ap18:3.4": "imā gāthā abhāsatha. ",
  "tha-ap18:4.1": "yenā’yaṃ jotitā seyyā ",
  "tha-ap18:4.2": "ādāso ca susanthato, ",
  "tha-ap18:4.3": "tama’haṃ kittayissāmi ",
  "tha-ap18:4.4": "suṇotha mama bhāsato. ",
  "tha-ap18:5.1": "soṇṇamayā rūpimayā ",
  "tha-ap18:5.2": "atho veḷuriyāmayā, ",
  "tha-ap18:5.3": "nibbattissanti ādāsā ",
  "tha-ap18:5.4": "ye keci manaso piyā. ",
  "tha-ap18:6.1": "catusaṭṭhikkhattuṃ devindo ",
  "tha-ap18:6.2": "devarajjaṃ karissati, ",
  "tha-ap18:6.3": "sahassakkhattuṃ cakkavattī ",
  "tha-ap18:6.4": "bhavissati anantarā. ",
  "tha-ap18:7.1": "ekavīsatikappamhi ",
  "tha-ap18:7.2": "vimalo nāma khattiyo, ",
  "tha-ap18:7.3": "cāturanto vijitāvī ",
  "tha-ap18:7.4": "cakkavattī bhavissati. ",
  "tha-ap18:8.1": "nagaraṃ reṇuvatī nāma ",
  "tha-ap18:8.2": "iṭṭhakāhi sumāpitaṃ, ",
  "tha-ap18:8.3": "āyāmato tīṇi sataṃ ",
  "tha-ap18:8.4": "caturassasamāyutaṃ. ",
  "tha-ap18:9.1": "sudassano nāma pāsādo ",
  "tha-ap18:9.2": "vissakammena nimmito, ",
  "tha-ap18:9.3": "kuṭāgāravarūpeto ",
  "tha-ap18:9.4": "sattaratanabhūsito. ",
  "tha-ap18:10.1": "dasa saddā acivittaṃ ",
  "tha-ap18:10.2": "vijjādharasamākulaṃ, ",
  "tha-ap18:10.3": "sudassanaṃva nagaraṃ ",
  "tha-ap18:10.4": "devatānaṃ bhavissati. ",
  "tha-ap18:11.1": "pabhā niggacchate tassa ",
  "tha-ap18:11.2": "uggacchanteva sūriye, ",
  "tha-ap18:11.3": "virocessati taṃ niccaṃ ",
  "tha-ap18:11.4": "samantā aṭṭhayojanaṃ. ",
  "tha-ap18:12.1": "kappasatasahassamhi ",
  "tha-ap18:12.2": "okkākakulasambhavo, ",
  "tha-ap18:12.3": "gotamo nāma nāmena ",
  "tha-ap18:12.4": "satthā loke bhavissati. ",
  "tha-ap18:13.1": "tusitā so cavitvāna ",
  "tha-ap18:13.2": "sukkamūlena codito, ",
  "tha-ap18:13.3": "gotamassa bhagavato ",
  "tha-ap18:13.4": "atrajo so bhavissati. ",
  "tha-ap18:14.1": "sace vaseyyā’gāraṃ ",
  "tha-ap18:14.2": "cakkavattī bhaveyya so, ",
  "tha-ap18:14.3": "aṭṭhānametaṃ yaṃ tādī ",
  "tha-ap18:14.4": "agāre ratimajjhagā. ",
  "tha-ap18:15.1": "nikkhamitvā agāramhā ",
  "tha-ap18:15.2": "pabbajissati subbato, ",
  "tha-ap18:15.3": "rāhulo nāma nāmena ",
  "tha-ap18:15.4": "arahā so bhavissati. ",
  "tha-ap18:16.1": "kikīva aṇḍaṃ rakkheyya, ",
  "tha-ap18:16.2": "camarī viya vāladhiṃ, ",
  "tha-ap18:16.3": "nipako sīlasampanno ",
  "tha-ap18:16.4": "evaṃ rakkhiṃ mahāmune. ",
  "tha-ap18:17.1": "tassā’haṃ dhammamaññāya ",
  "tha-ap18:17.2": "vihāsiṃ sāsane rato, ",
  "tha-ap18:17.3": "sabbāsave pariññāya ",
  "tha-ap18:17.4": "viharāmi anāsavo. ",
  "tha-ap18:18.1": "paṭisambhidā …pe… ",
  "tha-ap18:18.2": "",
  "tha-ap18:18.3": "",
  "tha-ap18:18.4": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap18:19.1": "itthaṃ sudaṃ āyasmā rāhulo thero imā gāthāyo abhāsitthāti. ",
  "tha-ap18:20.1": "rāhulattherassāpadānaṃ chaṭṭhaṃ. "
}
