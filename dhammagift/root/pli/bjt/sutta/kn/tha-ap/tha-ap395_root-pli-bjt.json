{
  "tha-ap395:0.1": "",
  "tha-ap395:0.2": "",
  "tha-ap395:0.3": "393. sabbakittikattherāpadānaṃ ",
  "tha-ap395:1.1": "kaṇikāraṃva jotantaṃ ",
  "tha-ap395:1.2": "dīparukkhaṃva ujjalaṃ, ",
  "tha-ap395:1.3": "osadhiṃva virocantaṃ ",
  "tha-ap395:1.4": "vijjutaṃ gagane yathā. ",
  "tha-ap395:2.1": "asambhītaṃ anutrāsiṃ ",
  "tha-ap395:2.2": "migarājaṃva kesariṃ, ",
  "tha-ap395:2.3": "ñāṇālokaṃ pakāsentaṃ ",
  "tha-ap395:2.4": "maddantaṃ titthiye gaṇo. ",
  "tha-ap395:3.1": "uddharantaṃ imaṃ lokaṃ ",
  "tha-ap395:3.2": "chindantaṃ sabbasaṃsayaṃ, ",
  "tha-ap395:3.3": "gajjantaṃ migarājaṃva ",
  "tha-ap395:3.4": "addasaṃ lokanāyakaṃ. ",
  "tha-ap395:4.1": "jaṭājinadharo āsiṃ ",
  "tha-ap395:4.2": "rahā uju patāpavā, ",
  "tha-ap395:4.3": "vākacīraṃ gahetvāna ",
  "tha-ap395:4.4": "pādamūle avatthariṃ. ",
  "tha-ap395:5.1": "kāḷānusāriyaṃ gayha ",
  "tha-ap395:5.2": "anulimpiṃ tathāgataṃ, ",
  "tha-ap395:5.3": "sambuddhamanulimpetvā ",
  "tha-ap395:5.4": "santhaviṃ lokanāyakaṃ. ",
  "tha-ap395:6.1": "samuddharasi’maṃ lokaṃ ",
  "tha-ap395:6.2": "oghatiṇṇa, mahāmuni, ",
  "tha-ap395:6.3": "ñāṇālokena jotesi ",
  "tha-ap395:6.4": "nāvaṭaṃ ñāṇamuttamaṃ. ",
  "tha-ap395:7.1": "dhammacakkaṃ pavattesi ",
  "tha-ap395:7.2": "maddase paratitthīye, ",
  "tha-ap395:7.3": "usabho jitasaṅgāmo ",
  "tha-ap395:7.4": "sampakampesi mediniṃ. ",
  "tha-ap395:8.1": "mahāsamuddo ūmiyo ",
  "tha-ap395:8.2": "velantambhi pabhijjare, ",
  "tha-ap395:8.3": "tatheva tava ñāṇamhi ",
  "tha-ap395:8.4": "sabbadiṭṭhi pabhijjare. ",
  "tha-ap395:9.1": "sukhumacchikajālena ",
  "tha-ap395:9.2": "sarambhi sampatānite, ",
  "tha-ap395:9.3": "antojālagatā pāṇā ",
  "tha-ap395:9.4": "pīḷitā honti tāvade. ",
  "tha-ap395:10.1": "tatheva titthiyā loke ",
  "tha-ap395:10.2": "puthupāsaṇḍanissitā, ",
  "tha-ap395:10.3": "antoñāṇavare tuyhaṃ ",
  "tha-ap395:10.4": "parivattanti mārisa. ",
  "tha-ap395:11.1": "patiṭṭhā vuyhataṃ oghe ",
  "tha-ap395:11.2": "tvaṃ hi nātho abandhunaṃ, ",
  "tha-ap395:11.3": "bhayaṭṭitānaṃ saraṇaṃ ",
  "tha-ap395:11.4": "muttatthinaṃ parāyaṇaṃ. ",
  "tha-ap395:12.1": "ekavīro asadiso ",
  "tha-ap395:12.2": "karuṇāmettasañcayo, susīlo ",
  "tha-ap395:12.3": "asamo santo ",
  "tha-ap395:12.4": "vasī tādi jitañjaso. ",
  "tha-ap395:13.1": "dhīro vigatasammoho ",
  "tha-ap395:13.2": "anejo akathaṅkathī, ",
  "tha-ap395:13.3": "vusito vantadoso’si ",
  "tha-ap395:13.4": "nimmalo payato sucī. ",
  "tha-ap395:14.1": "saṅgātigo hatamādo ",
  "tha-ap395:14.2": "tevijjo tibhavantago, ",
  "tha-ap395:14.3": "sīmātigo dhammagaru ",
  "tha-ap395:14.4": "katattho hitavappatho. ",
  "tha-ap395:15.1": "tārako tvaṃ yathā nāvā ",
  "tha-ap395:15.2": "nidhīvassāsakārako, ",
  "tha-ap395:15.3": "asambhīto yathā sīho ",
  "tha-ap395:15.4": "gajarājāva dappito. ",
  "tha-ap395:16.1": "thometvā dasagāthāhi ",
  "tha-ap395:16.2": "padumuttaraṃ mihāyasaṃ, ",
  "tha-ap395:16.3": "vanditvā satthuno pāde ",
  "tha-ap395:16.4": "tuṇhī aṭṭhāsahaṃ tadā. ",
  "tha-ap395:17.1": "padumuttaro lokavidū ",
  "tha-ap395:17.2": "āhutīnaṃ paṭiggaho, ",
  "tha-ap395:17.3": "bhikkhusaṅghe ṭhito satthā ",
  "tha-ap395:17.4": "imā gāthā abhāsatha. ",
  "tha-ap395:18.1": "“yo me sīlañca ñāṇañca ",
  "tha-ap395:18.2": "dhammañcāpi pakittayi, ",
  "tha-ap395:18.3": "tamahaṃ kittayissāmi ",
  "tha-ap395:18.4": "suṇātha mama bhāsato. ",
  "tha-ap395:19.1": "saṭṭhikappasahassāni ",
  "tha-ap395:19.2": "devaloke ramissati, ",
  "tha-ap395:19.3": "aññe deve abhihotvā ",
  "tha-ap395:19.4": "issaraṃ kārayissati. ",
  "tha-ap395:20.1": "so pacchā pabbajitvāna ",
  "tha-ap395:20.2": "sukkamūlena codito, ",
  "tha-ap395:20.3": "gotamassa bhagavato ",
  "tha-ap395:20.4": "sāsane pabbajissati. ",
  "tha-ap395:21.1": "pabbajitvāna kāyena ",
  "tha-ap395:21.2": "pāpakammaṃ vivajjiya, ",
  "tha-ap395:21.3": "sabbāsave pariññāya ",
  "tha-ap395:21.4": "nibbāyissatanāsavo. ",
  "tha-ap395:22.1": "yathāpi megho thanayaṃ ",
  "tha-ap395:22.2": "tappeti mediniṃ imaṃ, ",
  "tha-ap395:22.3": "tatheva tvaṃ mahāvīra ",
  "tha-ap395:22.4": "dhammena tappayī mamaṃ. ",
  "tha-ap395:23.1": "sīlaṃ paññaca dhammañca ",
  "tha-ap395:23.2": "thavitthā lokanāyakaṃ, ",
  "tha-ap395:23.3": "patombhi paramaṃ santiṃ ",
  "tha-ap395:23.4": "nibbānaṃ padamaccutaṃ. ",
  "tha-ap395:24.1": "aho nūna sa bhagavā ",
  "tha-ap395:24.2": "ciraṃ tiṭṭheyya cakkhumā, ",
  "tha-ap395:24.3": "aññātañca vijāneyyuṃ ",
  "tha-ap395:24.4": "phuseyyuṃ amataṃ padaṃ. ",
  "tha-ap395:25.1": "ayaṃ me pacchimā jāti ",
  "tha-ap395:25.2": "bhavā sabbe samūhatā, ",
  "tha-ap395:25.3": "sabbāsave pariññāya ",
  "tha-ap395:25.4": "viharāmi anāsavo. ",
  "tha-ap395:26.1": "satasahasse ito kappe ",
  "tha-ap395:26.2": "yaṃ buddhamabhithomayiṃ, ",
  "tha-ap395:26.3": "duggatiṃ nābhijānāmi ",
  "tha-ap395:26.4": "kittanāya idaṃ phalaṃ. ",
  "tha-ap395:27.1": "kilesā jhāpitā mayhaṃ ",
  "tha-ap395:27.2": "bhavā sabbe samūhatā, ",
  "tha-ap395:27.3": "sabbāsavā parikkhīṇā ",
  "tha-ap395:27.4": "natthidāni punabbhavo. ",
  "tha-ap395:28.1": "svāgataṃ vata me āsi ",
  "tha-ap395:28.2": "mama buddhassa santike, tisso vijjā anuppattā ",
  "tha-ap395:28.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap395:29.1": "paṭisambhidā catasso ",
  "tha-ap395:29.2": "vimokkhāpi ca aṭṭhime, chaḷabhiññā sacchikatā ",
  "tha-ap395:29.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap395:30.1": "itthaṃ sudaṃ āyasmā sabbakittiko thero imā gāthāyo abhāsitthāti. ",
  "tha-ap395:31.1": "sabbakittikattherassa apadānaṃ tatiyaṃ. "
}
