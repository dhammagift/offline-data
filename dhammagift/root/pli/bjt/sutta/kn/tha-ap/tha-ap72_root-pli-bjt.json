{
  "tha-ap72:0.1": "",
  "tha-ap72:0.2": "",
  "tha-ap72:0.3": "70. pupphacaṅgoṭiyattherāpadānaṃ ",
  "tha-ap72:1.1": "abhītarūpaṃ sīhaṃva abhijātaṃva kesariṃ, vyagghūsabhaṃva pavaraṃ ",
  "tha-ap72:1.2": "garuḷaggaṃva pakkhinaṃ. ",
  "tha-ap72:1.3": "",
  "tha-ap72:1.4": "",
  "tha-ap72:2.1": "sikhiṃ tilokasaraṇaṃ ",
  "tha-ap72:2.2": "anejaṃ aparājitaṃ, ",
  "tha-ap72:2.3": "nisinnaṃ samaṇānaggaṃ ",
  "tha-ap72:2.4": "bhikkhusaṃghapurakkhataṃ. ",
  "tha-ap72:3.1": "vaṅgoṭake ṭhapetvāna ",
  "tha-ap72:3.2": "anojaṃ pupphamuttamaṃ, ",
  "tha-ap72:3.3": "saha caṅgoṭakoneva ",
  "tha-ap72:3.4": "buddhaseṭṭhaṃ samokiriṃ. ",
  "tha-ap72:4.1": "tena cittappasādena ",
  "tha-ap72:4.2": "dipadinde narāsabhe ",
  "tha-ap72:4.3": "patto’mbhi acalaṃ ṭhānaṃ ",
  "tha-ap72:4.4": "hitvā jayaparājayaṃ. ",
  "tha-ap72:5.1": "ekatiṃse ito kappe ",
  "tha-ap72:5.2": "yaṃ kammamakariṃ tadā, ",
  "tha-ap72:5.3": "duggatiṃ nābhijānāmi ",
  "tha-ap72:5.4": "buddhapūjāyidaṃ phalaṃ. ",
  "tha-ap72:6.1": "sampuṇṇe tiṃsakappambhi ",
  "tha-ap72:6.2": "devabhūtisanāmakā, ",
  "tha-ap72:6.3": "sattaratanasampanno ",
  "tha-ap72:6.4": "pañcāsuṃ cakkavattino. ",
  "tha-ap72:7.1": "paṭisambhidā ",
  "tha-ap72:7.2": "…pe… ",
  "tha-ap72:7.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap72:8.1": "itthaṃ sudaṃ āyasmā pupphacaṅgoṭiyo thero imā gāthāyo abhāsitthāti. ",
  "tha-ap72:9.1": "pupphacaṅgoṭiyattherassa apadānaṃ dasamaṃ. ",
  "tha-ap72:10.1": "uddānaṃ: ",
  "tha-ap72:11.1": "sakavintī ",
  "tha-ap72:12.1": "avopupphi ",
  "tha-ap72:12.2": "paccābhigamanena ca ",
  "tha-ap72:12.3": "parappasādī bhisado ",
  "tha-ap72:12.4": "sucintī vatthadāyako ",
  "tha-ap72:13.1": "ambadāyī ca sumano ",
  "tha-ap72:13.2": "pupphacaṅgoṭiyo’pi ca ",
  "tha-ap72:13.3": "gāthekasattatī vuttā ",
  "tha-ap72:13.4": "gaṇitā atthadassihi. sakavittaniyavaggo sattamo. "
}
