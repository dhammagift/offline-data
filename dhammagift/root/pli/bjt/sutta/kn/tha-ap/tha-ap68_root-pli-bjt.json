{
  "tha-ap68:0.1": "",
  "tha-ap68:0.2": "",
  "tha-ap68:0.3": "66. sucintitattherāpadānaṃ ",
  "tha-ap68:1.1": "giriduggacaro āsiṃ ",
  "tha-ap68:1.2": "abhijātova kesarī, ",
  "tha-ap68:1.3": "migasaṃghaṃ vadhitvāna ",
  "tha-ap68:1.4": "jīvāmi pabbatantare. ",
  "tha-ap68:2.1": "atthadassī tu bhagavā ",
  "tha-ap68:2.2": "sabbaññū vadataṃ varo, ",
  "tha-ap68:2.3": "mamuddharitukāmo so ",
  "tha-ap68:2.4": "āgacchi pabbatuttamaṃ. ",
  "tha-ap68:3.1": "pasadañca migaṃ hantvā ",
  "tha-ap68:3.2": "bhakkhituṃ samupāgamiṃ, ",
  "tha-ap68:3.3": "bhagavā tamhi samaye ",
  "tha-ap68:3.4": "bhikkhamāno upāgami. ",
  "tha-ap68:4.1": "varamaṃsāni paggayha ",
  "tha-ap68:4.2": "adāsiṃ tassa satthuno, ",
  "tha-ap68:4.3": "anumodi mahāvīro ",
  "tha-ap68:4.4": "nibbāpento mamaṃ tadā. ",
  "tha-ap68:5.1": "tena cittappasādena ",
  "tha-ap68:5.2": "giriduggaṃ pavīsahaṃ, ",
  "tha-ap68:5.3": "pītiṃ uppādayitvāna ",
  "tha-ap68:5.4": "tattha kālakato ahaṃ. ",
  "tha-ap68:6.1": "etena maṃsadānena ",
  "tha-ap68:6.2": "cittassa paṇidhīhi ca, ",
  "tha-ap68:6.3": "paṇṇarase kappasate ",
  "tha-ap68:6.4": "devaloke ramiṃ ahaṃ. ",
  "tha-ap68:7.1": "avasesesu kappesu ",
  "tha-ap68:7.2": "kusalaṃ nicitaṃ mayā, ",
  "tha-ap68:7.3": "teneva maṃsadānena ",
  "tha-ap68:7.4": "buddhānussaraṇena ca. ",
  "tha-ap68:8.1": "aṭṭhatiṃsamhi kappamhi ",
  "tha-ap68:8.2": "aṭṭha dīghāyunāmakā, ",
  "tha-ap68:8.3": "saṭṭhimhi’to kappasate ",
  "tha-ap68:8.4": "duve varuṇanāmakā. 1392 ",
  "tha-ap68:9.1": "paṭisambhidā ",
  "tha-ap68:9.2": "…pe… ",
  "tha-ap68:9.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap68:10.1": "itthaṃ sudaṃ āyasmā sucintito thero imā gāthāyo abhāsitthāti. ",
  "tha-ap68:11.1": "sucintitattherassa apadānaṃ chaṭṭhaṃ. "
}
