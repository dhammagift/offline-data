{
  "tha-ap409:0.1": "",
  "tha-ap409:0.2": "",
  "tha-ap409:0.3": "407. hemakattherāpadānaṃ ",
  "tha-ap409:1.1": "pabbhārakūṭaṃ nissāya ",
  "tha-ap409:1.2": "anomo nāma tāpaso, ",
  "tha-ap409:1.3": "assamaṃ sukataṃ katvā ",
  "tha-ap409:1.4": "paṇṇasāle vasī tadā. ",
  "tha-ap409:2.1": "siddhaṃ tassa tapokammaṃ ",
  "tha-ap409:2.2": "siddhipatto sake bale, ",
  "tha-ap409:2.3": "sakasāmaññavikkanto ",
  "tha-ap409:2.4": "ātāpī nipako muni. ",
  "tha-ap409:3.1": "visārado sasamaye ",
  "tha-ap409:3.2": "paravāde ca kovido, ",
  "tha-ap409:3.3": "paṭṭho bhūmantalikkhamhi ",
  "tha-ap409:3.4": "uppātamhi ca kovido. ",
  "tha-ap409:4.1": "vītasoko nirārambho ",
  "tha-ap409:4.2": "appāhāro alolupo, ",
  "tha-ap409:4.3": "lābhālābhena santuṭṭho ",
  "tha-ap409:4.4": "jhāyī jhānarato muni. ",
  "tha-ap409:5.1": "piyadassī nāma sambuddho ",
  "tha-ap409:5.2": "aggo kāruṇiko muni, ",
  "tha-ap409:5.3": "satte tāretukāmo so ",
  "tha-ap409:5.4": "karuṇāya pharī tadā. ",
  "tha-ap409:6.1": "bodhaneyyaṃ janaṃ disvā ",
  "tha-ap409:6.2": "piyadassī mahāmuni, ",
  "tha-ap409:6.3": "cakkavāḷasahassampi ",
  "tha-ap409:6.4": "gantvā ovadate muni. ",
  "tha-ap409:7.1": "mamuddharitukāmo so ",
  "tha-ap409:7.2": "mamassamamupāgami, ",
  "tha-ap409:7.3": "na diṭṭho me jino pubbe ",
  "tha-ap409:7.4": "na suto pi ca kassa ci. ",
  "tha-ap409:8.1": "uppātā supinā mayhaṃ ",
  "tha-ap409:8.2": "lakkhaṇā suppakāsitā, ",
  "tha-ap409:8.3": "paṭṭho bhūmantalikkhamhi ",
  "tha-ap409:8.4": "nakkhattapadakovido. ",
  "tha-ap409:9.1": "so’haṃ buddhassa sutvāna ",
  "tha-ap409:9.2": "tattha cittaṃ pasādayiṃ, ",
  "tha-ap409:9.3": "bhuñjanto vā nisinno vā ",
  "tha-ap409:9.4": "sarāmi niccakālikaṃ. ",
  "tha-ap409:10.1": "mayi evaṃ sarantamhi ",
  "tha-ap409:10.2": "bhagavāpi anussari, ",
  "tha-ap409:10.3": "buddhaṃ anussarantassa ",
  "tha-ap409:10.4": "pīti me hoti tāvade. ",
  "tha-ap409:11.1": "kālañca punarāgamma ",
  "tha-ap409:11.2": "upesi maṃ mahāmuni, ",
  "tha-ap409:11.3": "sampattepi na jānāmi ",
  "tha-ap409:11.4": "ayaṃ buddho mahāmuni. ",
  "tha-ap409:12.1": "anukampako kāruṇiko ",
  "tha-ap409:12.2": "piyadassī mahāmuni, ",
  "tha-ap409:12.3": "sañjānāpesi attānaṃ ",
  "tha-ap409:12.4": "ahaṃ buddho sadevake. ",
  "tha-ap409:13.1": "sañjānitvāna sambuddhaṃ ",
  "tha-ap409:13.2": "piyadassiṃ mahāmuniṃ ",
  "tha-ap409:13.3": "sakaṃ cittaṃ pasādetvaṃ ",
  "tha-ap409:13.4": "idaṃ vacanamabraviṃ: ",
  "tha-ap409:14.1": "“aññe pīṭhe ca pallaṅke ",
  "tha-ap409:14.2": "āsandīsu nisīdare, ",
  "tha-ap409:14.3": "tuvampi sabbadassāvī ",
  "tha-ap409:14.4": "nisīdi ratanāsane” ",
  "tha-ap409:15.1": "sabbaratanamayaṃ pīṭhaṃ ",
  "tha-ap409:15.2": "nimminitvāna tāvade, ",
  "tha-ap409:15.3": "piyadassissa munino ",
  "tha-ap409:15.4": "adāsiṃ iddhinimmitaṃ. ",
  "tha-ap409:16.1": "ratane ca nisinnassa ",
  "tha-ap409:16.2": "pīṭhake iddhinimmite, ",
  "tha-ap409:16.3": "kumbhamattaṃ jambuphalaṃ ",
  "tha-ap409:16.4": "adāsiṃ tāvade ahaṃ. ",
  "tha-ap409:17.1": "mama hāsaṃ janetvāna ",
  "tha-ap409:17.2": "paribhuñji mahāmuni, ",
  "tha-ap409:17.3": "tadā cittaṃ pasādetvā ",
  "tha-ap409:17.4": "satthāramhivādayiṃ. ",
  "tha-ap409:18.1": "piyadassī tu bhagavā ",
  "tha-ap409:18.2": "lokajeṭṭho narāsabho, ",
  "tha-ap409:18.3": "ratanāsanamāsīno ",
  "tha-ap409:18.4": "imā gāthā abhāsatha: ",
  "tha-ap409:19.1": "“yo me ratanamayaṃ pīṭhaṃ ",
  "tha-ap409:19.2": "amataṃ ca phalaṃ adā, ",
  "tha-ap409:19.3": "tamahaṃ kittayissāmi ",
  "tha-ap409:19.4": "suṇātha mama bhāsato. ",
  "tha-ap409:20.1": "sattasattati kappāni ",
  "tha-ap409:20.2": "devaloke ramissati, ",
  "tha-ap409:20.3": "pañcasattatikkhattuñca ",
  "tha-ap409:20.4": "cakkavattī bhavissati. ",
  "tha-ap409:21.1": "dvattiṃsakkhattuṃ devindo ",
  "tha-ap409:21.2": "devarajjaṃ karissati, ",
  "tha-ap409:21.3": "padesarajjaṃ vipulaṃ ",
  "tha-ap409:21.4": "gaṇanāto asaṃkhiyaṃ. ",
  "tha-ap409:22.1": "soṇṇamayaṃ rūpimayaṃ ",
  "tha-ap409:22.2": "pallaṅkaṃ sukataṃ bahuṃ, ",
  "tha-ap409:22.3": "lohitaṅkamayaṃ ceva ",
  "tha-ap409:22.4": "lacchati ratanāmayaṃ. ",
  "tha-ap409:23.1": "caṅkamantampi manujaṃ ",
  "tha-ap409:23.2": "puññakammasamaṅginaṃ, ",
  "tha-ap409:23.3": "pallaṅkāni anekāni ",
  "tha-ap409:23.4": "parivārissare tadā. ",
  "tha-ap409:24.1": "kūṭāgārā ca pāsādā ",
  "tha-ap409:24.2": "sayanañca mahārahaṃ, ",
  "tha-ap409:24.3": "imassa cittamaññāya ",
  "tha-ap409:24.4": "nibbattissanti tāvade. ",
  "tha-ap409:25.1": "saṭṭhināgasahassāni ",
  "tha-ap409:25.2": "sabbālaṅkārabhūsitā, ",
  "tha-ap409:25.3": "suvaṇṇakacchā mātaṅgā ",
  "tha-ap409:25.4": "hemakappanavāsasā. ",
  "tha-ap409:26.1": "ārūḷhā gāmaṇīyehi ",
  "tha-ap409:26.2": "tomaraṅkusapāṇihi, ",
  "tha-ap409:26.3": "imaṃ paricarissanti ",
  "tha-ap409:26.4": "ratanapīṭhassi’daṃ phalaṃ. ",
  "tha-ap409:27.1": "saṭṭhiassasahassāni ",
  "tha-ap409:27.2": "sabbālaṅkārabhūsitā, ",
  "tha-ap409:27.3": "ājānīyāva jātiyā ",
  "tha-ap409:27.4": "sindhavā sīghavāhino. ",
  "tha-ap409:28.1": "ārūḷhā gāmaṇīyehi ",
  "tha-ap409:28.2": "illiyācāpadhārihi, ",
  "tha-ap409:28.3": "tepi’maṃ paricarissanti ",
  "tha-ap409:28.4": "ratanapīṭhassi’daṃ phalaṃ. ",
  "tha-ap409:29.1": "saṭṭhirathasahassāni ",
  "tha-ap409:29.2": "sabbālaṅkārabhūsitā, ",
  "tha-ap409:29.3": "dīpā athopi veyyagghā ",
  "tha-ap409:29.4": "sannaddhā ussitaddhajā. ",
  "tha-ap409:30.1": "ārūḷhā gāmaṇīyehi ",
  "tha-ap409:30.2": "cāpahatthehi vammihi, ",
  "tha-ap409:30.3": "parivāressanti’maṃ niccaṃ ",
  "tha-ap409:30.4": "ratanapīṭhassidaṃ phalaṃ. ",
  "tha-ap409:31.1": "saṭṭhidhenusahassāni ",
  "tha-ap409:31.2": "dohaññā puṅgavūsabhe, ",
  "tha-ap409:31.3": "vacchake janayissanti ",
  "tha-ap409:31.4": "ratanapīṭhassi’daṃ phalaṃ. ",
  "tha-ap409:32.1": "soḷasitthisahassāni ",
  "tha-ap409:32.2": "sabbālaṅkārabhūsitā, ",
  "tha-ap409:32.3": "vicittavatthābharaṇā ",
  "tha-ap409:32.4": "āmuttamaṇikuṇḍalā. ",
  "tha-ap409:33.1": "aḷārapamhā hasulā ",
  "tha-ap409:33.2": "susaññā tanumajjhimā, ",
  "tha-ap409:33.3": "parivāressanti maṃ niccaṃ ",
  "tha-ap409:33.4": "ratanapīṭhassidaṃ phalaṃ. ",
  "tha-ap409:34.1": "aṭṭhārase kappasate ",
  "tha-ap409:34.2": "gotamo nāma cakkhumā, ",
  "tha-ap409:34.3": "tamandhakāraṃ vidhametvā ",
  "tha-ap409:34.4": "buddho loke bhavissati. ",
  "tha-ap409:35.1": "tassa dassanamāgamma ",
  "tha-ap409:35.2": "pabbajissatakiñcano, ",
  "tha-ap409:35.3": "tosayitvāna satthāraṃ ",
  "tha-ap409:35.4": "sāsane’bhiramissati. ",
  "tha-ap409:36.1": "tassa dhammaṃ suṇitvāna ",
  "tha-ap409:36.2": "kilese ghātayissati, ",
  "tha-ap409:36.3": "sabbāsave pariññāya ",
  "tha-ap409:36.4": "nibbāyissatanāsavo. ",
  "tha-ap409:37.1": "viriyaṃ me dhuradhorayhaṃ ",
  "tha-ap409:37.2": "yogakkhemādhivāhanaṃ, ",
  "tha-ap409:37.3": "uttamatthaṃ patthayanto ",
  "tha-ap409:37.4": "sāsane viharāmahaṃ. ",
  "tha-ap409:38.1": "idaṃ pacchimakaṃ mayhaṃ ",
  "tha-ap409:38.2": "carimo vattate bhavo, ",
  "tha-ap409:38.3": "sabbāsavaparikkhīṇo ",
  "tha-ap409:38.4": "natthi dāni punabbhavo. ",
  "tha-ap409:39.1": "kilesā jhāpitā mayhaṃ ",
  "tha-ap409:39.2": "bhavā sabbe samūhatā, nāgo’ca bandhanaṃ chetvā ",
  "tha-ap409:39.3": "viharāmi anāsavo. ",
  "tha-ap409:40.1": "svāgataṃ vata me āsi ",
  "tha-ap409:40.2": "buddhaseṭṭhassa santike, tisso vijjā anuppattā ",
  "tha-ap409:40.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap409:41.1": "paṭisambhidā catasso ",
  "tha-ap409:41.2": "vimokkhāpi ca aṭṭhime, chaḷabhiññā sacchikatā ",
  "tha-ap409:41.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap409:42.1": "itthaṃ sudaṃ āyasmā hemako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap409:43.1": "hemakattherassa apadānaṃ sattamaṃ. ",
  "tha-ap409:43.2": "sattarasamaṃ bhāṇavāraṃ. "
}
