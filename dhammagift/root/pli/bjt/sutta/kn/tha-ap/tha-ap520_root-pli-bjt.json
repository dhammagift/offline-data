{
  "tha-ap520:0.1": "",
  "tha-ap520:0.2": "",
  "tha-ap520:0.3": "518. ghosasaññakattherāpadānaṃ ",
  "tha-ap520:1.1": "migaluddo pure āsiṃ ",
  "tha-ap520:1.2": "araññe kānane ahaṃ, ",
  "tha-ap520:1.3": "addasaṃ virajaṃ buddhaṃ ",
  "tha-ap520:1.4": "devasaṃghapurakkhataṃ. ",
  "tha-ap520:2.1": "catusaccaṃ pakāsentaṃ ",
  "tha-ap520:2.2": "desentaṃ amataṃ padaṃ, ",
  "tha-ap520:2.3": "assosiṃ madhuraṃ dhammaṃ ",
  "tha-ap520:2.4": "sikhino lokabandhuno. ",
  "tha-ap520:3.1": "ghose cittaṃ pasādesiṃ ",
  "tha-ap520:3.2": "asamappaṭipuggale, ",
  "tha-ap520:3.3": "tattha cittaṃ pasādetvā ",
  "tha-ap520:3.4": "atariṃ duttaraṃ bhavaṃ. ",
  "tha-ap520:4.1": "ekatiṃse ito kappe ",
  "tha-ap520:4.2": "yaṃ saññamalabhiṃ tadā, ",
  "tha-ap520:4.3": "duggatiṃ nābhijānāmi ",
  "tha-ap520:4.4": "ghosaññāyidaṃ phalaṃ. ",
  "tha-ap520:5.1": "kilesā jhāpitā mayhaṃ ",
  "tha-ap520:5.2": "bhavā sabbe samūhatā, nāgo va bandhanaṃ chetvā ",
  "tha-ap520:5.3": "viharāmi anāsavo. ",
  "tha-ap520:6.1": "svāgataṃ vata me āsi ",
  "tha-ap520:6.2": "buddhaseṭṭhassa santike, tisso vijjā anuppattā ",
  "tha-ap520:6.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap520:7.1": "paṭisambhidā catasso ",
  "tha-ap520:7.2": "ca vimokkhāpi ca aṭṭhime, chaḷabhiññā sacchikatā ",
  "tha-ap520:7.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap520:8.1": "itthaṃ sudaṃ āyasmā ghosasaññako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap520:9.1": "ghosasaññakattherassa apadānaṃ aṭṭhamaṃ. "
}
