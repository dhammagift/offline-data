{
  "tha-ap213:0.1": "",
  "tha-ap213:0.2": "22. hatthivaggo ",
  "tha-ap213:0.3": "211. hatthidāyakattherāpadānaṃ. ",
  "tha-ap213:1.1": "siddhatthassa bhagavato ",
  "tha-ap213:1.2": "dipadindassa tādino, ",
  "tha-ap213:1.3": "nāgaseṭṭho mayā dinno ",
  "tha-ap213:1.4": "īsādanto urūḷhavā. ",
  "tha-ap213:2.1": "uttamatthaṃ anubhomi ",
  "tha-ap213:2.2": "santipadamanuttaraṃ, ",
  "tha-ap213:2.3": "aggadānaṃ mayā dinnaṃ ",
  "tha-ap213:2.4": "sabbalokahitesino. ",
  "tha-ap213:3.1": "catunavute ito kappe ",
  "tha-ap213:3.2": "yaṃ nāgamadadiṃ tadā, ",
  "tha-ap213:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap213:3.4": "nāgadānassidaṃ phalaṃ. ",
  "tha-ap213:4.1": "aṭṭhasattatikappambhi ",
  "tha-ap213:4.2": "soḷasā’siṃsu khattiyā, ",
  "tha-ap213:4.3": "samantapāsādikā nāma ",
  "tha-ap213:4.4": "cakkavattī mahabbalā. ",
  "tha-ap213:5.1": "paṭisambhidā catasso ",
  "tha-ap213:5.2": "vimokkhāpi ca aṭṭhime, ",
  "tha-ap213:5.3": "chaḷabhiññā sacchikatā ",
  "tha-ap213:5.4": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap213:6.1": "itthaṃ sudaṃ āyasmā hatthidāyako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap213:7.1": "hatthidāyakattherassa apadānaṃ paṭhamaṃ. "
}
