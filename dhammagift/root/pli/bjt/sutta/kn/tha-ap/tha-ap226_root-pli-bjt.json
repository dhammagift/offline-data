{
  "tha-ap226:0.1": "",
  "tha-ap226:0.2": "",
  "tha-ap226:0.3": "224. ārakkhadāyakattherāpadānaṃ ",
  "tha-ap226:1.1": "siddhatthassa bhagavato ",
  "tha-ap226:1.2": "vedi kārāpitā mayā, ",
  "tha-ap226:1.3": "ārakkho ca mayā dinno ",
  "tha-ap226:1.4": "sugatassa mahesino. ",
  "tha-ap226:2.1": "tena kammavisesena ",
  "tha-ap226:2.2": "na passe bhayabheravaṃ, ",
  "tha-ap226:2.3": "kuhiñci uppannassa ",
  "tha-ap226:2.4": "tāso mayhaṃ na vijjati. ",
  "tha-ap226:3.1": "catunavute ito kappe ",
  "tha-ap226:3.2": "yaṃ vediṃ kārayiṃ ahaṃ, ",
  "tha-ap226:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap226:3.4": "vedikāya idaṃ phalaṃ. ",
  "tha-ap226:4.1": "ito chaṭṭambhi kappamhi ",
  "tha-ap226:4.2": "apassena sanāmako, ",
  "tha-ap226:4.3": "sattaratanasampanno ",
  "tha-ap226:4.4": "cakkavattī mahabbalo. ",
  "tha-ap226:5.1": "paṭisambhidā catasso ",
  "tha-ap226:5.2": "vimokkhāpi ca aṭṭhime, chaḷabhiññā sacchikatā ",
  "tha-ap226:5.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap226:6.1": "itthaṃ sudaṃ āyasmā ārakkhadāyako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap226:7.1": "ārakkhadāyakattherassa apadānaṃ catutthaṃ. "
}
