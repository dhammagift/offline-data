{
  "tha-ap144:0.1": "",
  "tha-ap144:0.2": "",
  "tha-ap144:0.3": "142. thambhāropakattherāpadānaṃ. ",
  "tha-ap144:1.1": "nibbute lokanāthamhi ",
  "tha-ap144:1.2": "dhammadassinarāsabhe, ",
  "tha-ap144:1.3": "āropesiṃ dhajatthamhaṃ ",
  "tha-ap144:1.4": "buddhaseṭṭhassa cetiye. ",
  "tha-ap144:2.1": "nisseṇiṃ māpayitvāna ",
  "tha-ap144:2.2": "thūpaseṭṭhaṃ samāruhiṃ, ",
  "tha-ap144:2.3": "jātipupphaṃ gahetvāna ",
  "tha-ap144:2.4": "thūpamahi abhiropayiṃ. ",
  "tha-ap144:3.1": "aho buddho dhammo ",
  "tha-ap144:3.2": "aho no satthūsampadā, ",
  "tha-ap144:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap144:3.4": "thūpapūjāyi daṃ phalaṃ. ",
  "tha-ap144:4.1": "catunavute ito kappe ",
  "tha-ap144:4.2": "thūpasikharanāmakā, ",
  "tha-ap144:4.3": "soḷasāsiṃsu rājāno ",
  "tha-ap144:4.4": "cakkavattī mahabbalo. ",
  "tha-ap144:5.1": "paṭisambhidā ",
  "tha-ap144:5.2": "…pe… ",
  "tha-ap144:5.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap144:6.1": "itthaṃ sudaṃ āyasmā thambhāropako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap144:7.1": "thambhāropakattherassa apadānaṃ dutiyaṃ. "
}
