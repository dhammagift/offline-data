{
  "tha-ap250:0.1": "",
  "tha-ap250:0.2": "",
  "tha-ap250:0.3": "248. sattalipupphapūjakattherāpadānaṃ ",
  "tha-ap250:1.1": "satta sattalipupphāni ",
  "tha-ap250:1.2": "sīse katvānahaṃ tadā, ",
  "tha-ap250:1.3": "buddhassa abhiropesiṃ ",
  "tha-ap250:1.4": "vessabhūmbhi naruttame. ",
  "tha-ap250:2.1": "ekatiṃse ito kappe ",
  "tha-ap250:2.2": "yaṃ pupphamabhiropayiṃ, ",
  "tha-ap250:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap250:2.4": "pupphapūjāyidaṃ phalaṃ. ",
  "tha-ap250:3.1": "paṭisambhidā catasso ",
  "tha-ap250:3.2": "vimokkhāpi ca aṭṭhime, chaḷabhiññā sacchikatā ",
  "tha-ap250:3.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap250:4.1": "itthaṃ sudaṃ āyasmā sattalipupphapūjako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap250:5.1": "sattalipupphapūjakattherassa apadānaṃ aṭṭhamaṃ. "
}
