  "tha-ap39:0.1": "",
  "tha-ap39:0.2": "",
  "tha-ap39:0.3": "37. lasuṇadāyakattherāpadānaṃ. ",
  "tha-ap39:1.1": "himavantassa avidūre ",
  "tha-ap39:1.2": "tāpaso āsa’haṃ tadā, ",
  "tha-ap39:1.3": "lasuṇaṃ upajīvāmi ",
  "tha-ap39:1.4": "lasuṇaṃ mayha bhojanaṃ. ",
  "tha-ap39:2.1": "khāriyo pūrayitvāna ",
  "tha-ap39:2.2": "saṃghārāmamagaccha’haṃ, ",
  "tha-ap39:2.3": "haṭṭho haṭṭhena cittena ",
  "tha-ap39:2.4": "saṃghassa lasuṇaṃ adaṃ. ",
  "tha-ap39:3.1": "vipassissa naraggassa ",
  "tha-ap39:3.2": "sāsane niratassa’haṃ, ",
  "tha-ap39:3.3": "saṃghassa lasuṇaṃ datvā ",
  "tha-ap39:3.4": "kappaṃ saggamhi moda’haṃ ",
  "tha-ap39:4.1": "ekanavute ito kappe ",
  "tha-ap39:4.2": "lasuṇaṃ yama’daṃ tadā, ",
  "tha-ap39:4.3": "duggatiṃ nābhijānāmi ",
  "tha-ap39:4.4": "lasuṇānaṃ idaṃ phalaṃ. ",
  "tha-ap39:5.1": "paṭisambhidā ",
  "tha-ap39:5.2": "…pe… ",
  "tha-ap39:5.3": "buddhassa sāsanaṃ. ",
  "tha-ap39:6.1": "itthaṃ sudaṃ āyasmā lasuṇadāyako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap39:7.1": "lasuṇadāyakattherassāpadānaṃ sattamaṃ. "
}
