{
  "tha-ap439:0.1": "",
  "tha-ap439:0.2": "",
  "tha-ap439:0.3": "437. ambāṭakadāyakattherāpadānaṃ ",
  "tha-ap439:1.1": "vipine buddhaṃ disvāna ",
  "tha-ap439:1.2": "sayambhuṃ aparājitaṃ, ",
  "tha-ap439:1.3": "ambāṭakaṃ gahetvāna ",
  "tha-ap439:1.4": "sayambhussa adāsahaṃ. ",
  "tha-ap439:2.1": "ekatiṃse ito kappe ",
  "tha-ap439:2.2": "yaṃ phalaṃ adadiṃ tadā, ",
  "tha-ap439:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap439:2.4": "phaladānassidaṃ phalaṃ. ",
  "tha-ap439:3.1": "kilesā jhāpitā mayhaṃ ",
  "tha-ap439:3.2": "bhavā sabbe samūhatā, nāgo’va bandhanaṃ chetvā ",
  "tha-ap439:3.3": "viharāmi anāsavo. ",
  "tha-ap439:4.1": "svāgataṃ vata me āsi ",
  "tha-ap439:4.2": "buddhaseṭṭhassa santike, tisso vijjā anuppattā ",
  "tha-ap439:4.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap439:5.1": "paṭisambhidā catasso ",
  "tha-ap439:5.2": "ca vimokkhāpi ca aṭṭhime, chaḷabhiññā sacchikatā ",
  "tha-ap439:5.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap439:6.1": "itthaṃ sudaṃ āyasmā ambāṭakadāyako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap439:7.1": "ambāṭakadāyakattherassa apadānaṃ sattamaṃ. "
}
