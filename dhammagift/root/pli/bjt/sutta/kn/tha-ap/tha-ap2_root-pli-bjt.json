{
  "tha-ap2:0.1": "",
  "tha-ap2:0.2": "",
  "tha-ap2:0.3": "2. pacceka buddhāpadānaṃ ",
  "tha-ap2:1.1": "atha paccekabuddhāpadānaṃ suṇātha. ",
  "tha-ap2:2.1": "tathāgataṃ jetavane vasantaṃ ",
  "tha-ap2:2.2": "apucchi vedehamunī nataṅgo, ",
  "tha-ap2:2.3": "“paccekabuddhā kira nāma honti, ",
  "tha-ap2:2.4": "bhavanti te hetūhi kehi vīra.” ",
  "tha-ap2:3.1": "tadā’ha sabbaññuvaro mahesī ",
  "tha-ap2:3.2": "ānandabhaddaṃ madhurassarena, ",
  "tha-ap2:3.3": "ye pubbabuddhesu katādhikārā ",
  "tha-ap2:3.4": "aladdhamokkhā jinasāsanesu. ",
  "tha-ap2:4.1": "teneva saṃvegamukhena dhīrā ",
  "tha-ap2:4.2": "vināpi buddhehi sutikkhapaññā, ",
  "tha-ap2:4.3": "ārammaṇenāpi parittakena ",
  "tha-ap2:4.4": "paccekabodhiṃ anupāpuṇanti. ",
  "tha-ap2:5.1": "sabbamhi lokamhi mamaṃ ṭhapetvā ",
  "tha-ap2:5.2": "paccekabuddhehi samo’va natthi, ",
  "tha-ap2:5.3": "tesaṃ imaṃ vaṇṇapadesamattaṃ ",
  "tha-ap2:5.4": "vakkhāmahaṃ sādhu mahāmunīnaṃ. ",
  "tha-ap2:6.1": "sayameva buddhānaṃ mahāisīnaṃ ",
  "tha-ap2:6.2": "sādhūni vākyāni madhuṃva khuddaṃ, ",
  "tha-ap2:6.3": "anuttaraṃ bhesajaṃ patthayantā ",
  "tha-ap2:6.4": "suṇātha sabbesu pasannacittā. ",
  "tha-ap2:7.1": "paccekabuddhānaṃ samāgatānaṃ ",
  "tha-ap2:7.2": "paramparavyākaraṇāni yāni, ",
  "tha-ap2:7.3": "ādīnavo yañca virāgavatthu ",
  "tha-ap2:7.4": "yathā ca bodhiṃ anupāpuṇiṃsu. ",
  "tha-ap2:8.1": "saṃrāgavatthūsu virāgasaññī ",
  "tha-ap2:8.2": "rattamhi lokamhi virattacittā, ",
  "tha-ap2:8.3": "hitvā papañce vijiya phanditāni ",
  "tha-ap2:8.4": "tatheva bodhiṃ anupāpuṇiṃsu. ",
  "tha-ap2:9.1": "sabbesu bhūtesu nidhāya daṇḍaṃ ",
  "tha-ap2:9.2": "aviheṭhayaṃ aññatarampi tesaṃ, ",
  "tha-ap2:9.3": "mettena cittena hitānukampī ",
  "tha-ap2:9.4": "eko care khaggavisāṇakappo. ",
  "tha-ap2:10.1": "sabbesu bhūtesu nidhāya daṇḍaṃ ",
  "tha-ap2:10.2": "aviheṭhayaṃ aññatarampi tesaṃ, ",
  "tha-ap2:10.3": "na puttamiccheyya kuto sahāyaṃ ",
  "tha-ap2:10.4": "eko care khaggavisāṇakappo. ",
  "tha-ap2:11.1": "saṃsaggajātassa bhavanti snehā ",
  "tha-ap2:11.2": "snehanvayaṃ dukkhamidaṃ pahoti, ",
  "tha-ap2:11.3": "ādīnavaṃ snehajaṃ pekkhamāno ",
  "tha-ap2:11.4": "eko care khaggavisāṇakappo. ",
  "tha-ap2:12.1": "mitte suhajje anukampamāno ",
  "tha-ap2:12.2": "hāpeti atthaṃ paṭibaddhacitto, ",
  "tha-ap2:12.3": "etaṃ bhayaṃ santhave pekkhamāno ",
  "tha-ap2:12.4": "eko care khaggavisāṇakappo. ",
  "tha-ap2:13.1": "vaṃso visālova yathā visatto ",
  "tha-ap2:13.2": "puttesu dāresu ca yā apekkhā, ",
  "tha-ap2:13.3": "vaṃsakaḷīrova asajjamāno ",
  "tha-ap2:13.4": "eko care khaggavisāṇakappo. ",
  "tha-ap2:14.1": "migo araññamhi yathā abaddho. ",
  "tha-ap2:14.2": "ye nicchakaṃ gacchati gocarāya, ",
  "tha-ap2:14.3": "viññū naro seritaṃ pekkhamāno ",
  "tha-ap2:14.4": "eko vare khaggavisāṇakappo. ",
  "tha-ap2:15.1": "āmantanā hoti sahāyamajjhe ",
  "tha-ap2:15.2": "vāse ca ṭhāne gamane cārikāya, ",
  "tha-ap2:15.3": "anabhijjhitaṃ seritaṃ pekkhamāno ",
  "tha-ap2:15.4": "eko care khaggavisāṇakappo. ",
  "tha-ap2:16.1": "khiḍḍā ratī hoti sahāyamajjhe ",
  "tha-ap2:16.2": "puttesu pemaṃ vipulañca hoti, ",
  "tha-ap2:16.3": "piyavippayogaṃ vijigucchamāno ",
  "tha-ap2:16.4": "eko care khaggavisāṇakappo. ",
  "tha-ap2:17.1": "cātuddiso appaṭigho ca hoti ",
  "tha-ap2:17.2": "santussamāno itarītarena, ",
  "tha-ap2:17.3": "parissayānaṃ sahitā achambhī ",
  "tha-ap2:17.4": "eko care khaggavisāṇakappo. ",
  "tha-ap2:18.1": "dussaṅgahā pabbajitāpi eke ",
  "tha-ap2:18.2": "atho gahaṭṭhā gharamāvasantā, ",
  "tha-ap2:18.3": "apposukko paraputtesu hutvā ",
  "tha-ap2:18.4": "eko care khaggavisāṇakappo. ",
  "tha-ap2:19.1": "oropayitvā gihibyañjanāni ",
  "tha-ap2:19.2": "saṃsīnapatto yatā koviḷāro, ",
  "tha-ap2:19.3": "chetvāna vīro gigibandhanāni ",
  "tha-ap2:19.4": "eko care khaggavisāṇakappo. ",
  "tha-ap2:20.1": "sace labhetha nipakaṃ sahāyaṃ ",
  "tha-ap2:20.2": "saddhiṃcaraṃ sādhuvihāri dhīraṃ, ",
  "tha-ap2:20.3": "abhibhuyya sabbāni parissayāni ",
  "tha-ap2:20.4": "careyya tenattamano satīmā. ",
  "tha-ap2:21.1": "no ce labhetha nipakaṃ sahāyaṃ ",
  "tha-ap2:21.2": "saddhiṃcaraṃ sādhuvihāri dhīraṃ, ",
  "tha-ap2:21.3": "rājāva raṭṭhaṃ vijitaṃ pahāya ",
  "tha-ap2:21.4": "eko care mātaṅga’raññeva’ nāgo. ",
  "tha-ap2:22.1": "addhā pasaṃsāma sahāyasampadaṃ ",
  "tha-ap2:22.2": "seṭṭhā samā sevitabbā sahāyā, ",
  "tha-ap2:22.3": "ete aladdhā anavajjabhojī ",
  "tha-ap2:22.4": "eko care khaggavisāṇakappo. ",
  "tha-ap2:23.1": "disvā suvaṇṇassa pabhassarāni ",
  "tha-ap2:23.2": "kammāraputtena suniṭṭhitāni, ",
  "tha-ap2:23.3": "saṃghaṭṭamānāni duve bhujasmiṃ ",
  "tha-ap2:23.4": "eko care khaggavisāṇakappo. ",
  "tha-ap2:24.1": "evaṃ dutiyena sabhā mama’ssa ",
  "tha-ap2:24.2": "vācābhilāpo abhisajjanā ca, ",
  "tha-ap2:24.3": "etaṃ bhayaṃ āyatiṃ pekkhamāno ",
  "tha-ap2:24.4": "eko care khaggavisāṇakappo. ",
  "tha-ap2:25.1": "kāmā hi citrā madhurā manoramā ",
  "tha-ap2:25.2": "virūparūpena mathenti cittaṃ, ",
  "tha-ap2:25.3": "ādīnavaṃ kāmaguṇesu disvā ",
  "tha-ap2:25.4": "eko care khaggavisāṇakappo. ",
  "tha-ap2:26.1": "ītī ca gaṇḍo ca upaddavo ca ",
  "tha-ap2:26.2": "rogo ca sallañca bhayañcametaṃ, ",
  "tha-ap2:26.3": "etaṃ bhayaṃ kāmaguṇesu disvā ",
  "tha-ap2:26.4": "eko care khaggavisāṇakappo. ",
  "tha-ap2:27.1": "sītañca uṇhañca khudaṃ pipāsaṃ ",
  "tha-ap2:27.2": "vātātape ḍaṃsasiriṃsape ca, ",
  "tha-ap2:27.3": "sabbāni pe’tāni abhibbhavitvā ",
  "tha-ap2:27.4": "eko care khaggavisāṇakappo. ",
  "tha-ap2:28.1": "nāgova yūthāni vivajjayitvā ",
  "tha-ap2:28.2": "saṃjātakhandho padumī uḷāro, ",
  "tha-ap2:28.3": "yathābhirantaṃ viharaṃ araññe ",
  "tha-ap2:28.4": "eko care khaggavisāṇakappo. ",
  "tha-ap2:29.1": "aṭṭhāna taṃ saṅgaṇikāratassa ",
  "tha-ap2:29.2": "yaṃ phassaye sāmayikaṃ vimuttiṃ, ",
  "tha-ap2:29.3": "ādiccabandhussa vaco nisamma ",
  "tha-ap2:29.4": "eko care khaggavisāṇakappo. ",
  "tha-ap2:30.1": "diṭṭhivisūkāni upātivatto ",
  "tha-ap2:30.2": "patto niyāmaṃ paṭiladdhamaggo, ",
  "tha-ap2:30.3": "uppannañāṇo’mhi anaññaneyyo ",
  "tha-ap2:30.4": "eko care khaggavisāṇakappo. ",
  "tha-ap2:31.1": "nillolupo nikkuho nippipāso ",
  "tha-ap2:31.2": "nimmakkha niddhantakasāvamoho, ",
  "tha-ap2:31.3": "nirāsayo sabbaloke bhavitvā ",
  "tha-ap2:31.4": "eko care khaggavisāṇakappo. ",
  "tha-ap2:32.1": "pāpaṃ sahāyaṃ parivajjayetha ",
  "tha-ap2:32.2": "anatthadassiṃ visame niviṭṭhaṃ, ",
  "tha-ap2:32.3": "sayaṃ na seve pasutaṃ pamattaṃ ",
  "tha-ap2:32.4": "eko care khaggavisāṇakappo. ",
  "tha-ap2:33.1": "bahussutaṃ dhammadharaṃ bhajetha ",
  "tha-ap2:33.2": "mittaṃ uḷāraṃ paṭibhānavantaṃ, ",
  "tha-ap2:33.3": "aññāya atthāni vineyya kaṅkhaṃ ",
  "tha-ap2:33.4": "eko care khaggavisāṇakappo. ",
  "tha-ap2:34.1": "khiḍḍaṃ ratiṃ kāmasukhañca loke ",
  "tha-ap2:34.2": "analaṅkaritvā anapekkhamāno, ",
  "tha-ap2:34.3": "vibhūsanaṭṭhānā virato saccavādī ",
  "tha-ap2:34.4": "eko care khaggavisāṇakappo. ",
  "tha-ap2:35.1": "puttañca dāraṃ pitarañca mātaraṃ ",
  "tha-ap2:35.2": "dhanāni dhaññāni ca bandhavāni, ",
  "tha-ap2:35.3": "hitvāna kāmāni yathodhikāni ",
  "tha-ap2:35.4": "eko care khaggavisāṇakappo. ",
  "tha-ap2:36.1": "saṅgo eso parittaṃ ettha sobyaṃ ",
  "tha-ap2:36.2": "appassādo dukkhamevettha bhiyyo, ",
  "tha-ap2:36.3": "gāho eso iti ñatvā matīmā ",
  "tha-ap2:36.4": "eko care khaggavisāṇakappo. ",
  "tha-ap2:37.1": "sandālayitvāna saṃyojanāni ",
  "tha-ap2:37.2": "jālaṃ va’ bhetvāsalilambhucārī, ",
  "tha-ap2:37.3": "aggīva daḍḍhaṃ anivattamāno ",
  "tha-ap2:37.4": "eko care khaggavisāṇakappo. ",
  "tha-ap2:38.1": "okkhittacakkhu na ca pādalolo ",
  "tha-ap2:38.2": "guttindriyo rakkhitamānasāno, ",
  "tha-ap2:38.3": "anavassuto apariḍayhamāno ",
  "tha-ap2:38.4": "eko care khaggavisāṇakappo. ",
  "tha-ap2:39.1": "ohārayitvā gihibyañjanāni ",
  "tha-ap2:39.2": "saṃchinnapatto yathā pārichatto, ",
  "tha-ap2:39.3": "kāsāyavattho abhinikkhamitvā ",
  "tha-ap2:39.4": "eko care khaggavisāṇakappo. ",
  "tha-ap2:40.1": "rasesu gedhaṃ akaraṃ alolo ",
  "tha-ap2:40.2": "anaññaposī sapadānacārī, ",
  "tha-ap2:40.3": "kule kule appaṭibaddhacitto ",
  "tha-ap2:40.4": "eko care khaggavisāṇakappo. ",
  "tha-ap2:41.1": "pahāya pañcāvaraṇāni cetaso ",
  "tha-ap2:41.2": "upakkilese byapanujja sabbe, ",
  "tha-ap2:41.3": "anissito chejja sinehadosaṃ ",
  "tha-ap2:41.4": "eko care khaggavisāṇakappo. ",
  "tha-ap2:42.1": "vipiṭṭhi katvāna sukhaṃ ca dukkhaṃ ",
  "tha-ap2:42.2": "pubbeva ca somana-domanassaṃ, ",
  "tha-ap2:42.3": "laddhānupekkhaṃ samathaṃ visuddhaṃ ",
  "tha-ap2:42.4": "eko care khaggavisāṇakappo. ",
  "tha-ap2:43.1": "āraddhaviriyo paramatthapattiyā ",
  "tha-ap2:43.2": "alīnacitto akusītavuttī, ",
  "tha-ap2:43.3": "daḷhanikkamo thāmabalūpapanno ",
  "tha-ap2:43.4": "eko care khaggavisāṇakappo. ",
  "tha-ap2:44.1": "paṭisallānaṃ jhānamariñcamāno ",
  "tha-ap2:44.2": "dhammesu niccaṃ anudhammacārī, ",
  "tha-ap2:44.3": "ādīnavaṃ sammasitā bhavesu ",
  "tha-ap2:44.4": "eko care khaggavisāṇakappo. ",
  "tha-ap2:45.1": "taṇhakkhayaṃ patthayaṃ appamatto ",
  "tha-ap2:45.2": "aneḷamūgo sutavā satīmā, ",
  "tha-ap2:45.3": "saṅkhātadhammo niyato padhānavā ",
  "tha-ap2:45.4": "eko care khaggavisāṇakappo. ",
  "tha-ap2:46.1": "sīhova saddesu asantasanto ",
  "tha-ap2:46.2": "vātova jālamhi asajjamāno, ",
  "tha-ap2:46.3": "padumaṃva toyena alippamāno ",
  "tha-ap2:46.4": "eko care khaggavisāṇakappo. ",
  "tha-ap2:47.1": "sīho yathā dāṭhabalī pasayha ",
  "tha-ap2:47.2": "rājā migānaṃ abhibhuyyacārī, ",
  "tha-ap2:47.3": "sevetha pantāni senāsanāni ",
  "tha-ap2:47.4": "eko care khaggavisāṇakappo. ",
  "tha-ap2:48.1": "mettaṃ upekkhaṃ karuṇaṃ vimuttiṃ ",
  "tha-ap2:48.2": "āsevamāno muditañca kāle, ",
  "tha-ap2:48.3": "sabbena lokena ‘virujjhamāno ",
  "tha-ap2:48.4": "eko care khaggavisāṇakappo ",
  "tha-ap2:49.1": "rāgañca dosañca pahāya mohaṃ ",
  "tha-ap2:49.2": "sandālayitvāna saṃyojanāni, ",
  "tha-ap2:49.3": "asantasaṃ jīvitasaṅkhayamhi ",
  "tha-ap2:49.4": "eko care khaggavisāṇakappo. ",
  "tha-ap2:50.1": "bhajanti sevanti ca kāraṇatthā ",
  "tha-ap2:50.2": "nikkāraṇā dullabhā ajja mittā, ",
  "tha-ap2:50.3": "attatthapaññā asucī manussā ",
  "tha-ap2:50.4": "eko care khaggavisāṇakappo. ",
  "tha-ap2:51.1": "visuddhasīlā suvisuddhapaññā ",
  "tha-ap2:51.2": "samāhitā jāgariyānuyuttā, ",
  "tha-ap2:51.3": "vipassakā dhammavisesadassi ",
  "tha-ap2:51.4": "maggaṅgabojjhaṅgagate vijaññā. ",
  "tha-ap2:52.1": "suññatappaṇihitañcānimittaṃ ",
  "tha-ap2:52.2": "āsevayitvā jinasāsanamhi, ",
  "tha-ap2:52.3": "ye sāvakattaṃ na vajanti dhīrā ",
  "tha-ap2:52.4": "bhavanti paccekajinā sayambhū. ",
  "tha-ap2:53.1": "mahantadhammā bahudhammakāyā ",
  "tha-ap2:53.2": "cittissarā sabbadukkhoghatiṇṇā, ",
  "tha-ap2:53.3": "udaggacittā paramatthadassī ",
  "tha-ap2:53.4": "sīhopamā khaggavisāṇakappā. ",
  "tha-ap2:54.1": "santindriyā santamanā samādhi ",
  "tha-ap2:54.2": "paccattagambhīramatappacārā ",
  "tha-ap2:54.3": "dīpā paratthaṃ idha vijjalantā ",
  "tha-ap2:54.4": "paccekabuddhā sattaccitā’me. ",
  "tha-ap2:55.1": "pahīṇasabbāvaraṇā janindā ",
  "tha-ap2:55.2": "lokappadīpā ghanakañcanābhā, ",
  "tha-ap2:55.3": "nissaṃsayaṃ lokasudakkhiṇeyyā ",
  "tha-ap2:55.4": "paccekabuddhā sattaccitā’me. ",
  "tha-ap2:56.1": "paccekabuddhānaṃ subhāsitāni ",
  "tha-ap2:56.2": "caranti lokamhi sadevakambhi, ",
  "tha-ap2:56.3": "sutvā tathā ye na karonti bālā ",
  "tha-ap2:56.4": "caranti dukkhesu punappunaṃ te. ",
  "tha-ap2:57.1": "paccekabuddhānaṃ subhāsitāni ",
  "tha-ap2:57.2": "madhuṃ yathā buddamavassavanataṃ ",
  "tha-ap2:57.3": "sutvā tathā ye paṭipattiyuttā ",
  "tha-ap2:57.4": "bhavanti te saccadasā sapaññā. ",
  "tha-ap2:58.1": "paccekabuddhehi jinehi vuttā ",
  "tha-ap2:58.2": "gāthā uḷārā abhinikkhamitvā, ",
  "tha-ap2:58.3": "tā sakyasīhena naruttamena ",
  "tha-ap2:58.4": "pakāsitā dhammavijānanatthaṃ. ",
  "tha-ap2:59.1": "lokānukampāya imāni tesaṃ ",
  "tha-ap2:59.2": "paccekabuddhāna vikubbitāni, ",
  "tha-ap2:59.3": "saṃvegā‘saṅgamati mativaḍḍhanatthaṃ ",
  "tha-ap2:59.4": "sayambhūsīhena pakāsitāni. pacecaka ",
  "tha-ap2:60.1": "buddhāpadānaṃ samattaṃ. "
}
