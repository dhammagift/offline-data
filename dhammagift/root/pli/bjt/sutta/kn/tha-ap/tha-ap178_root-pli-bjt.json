{
  "tha-ap178:0.1": "",
  "tha-ap178:0.2": "",
  "tha-ap178:0.3": "176. maggadattikattherāpadānaṃ ",
  "tha-ap178:1.1": "anomadassī bhagavā ",
  "tha-ap178:1.2": "dipadindo narāsabho, ",
  "tha-ap178:1.3": "diṭṭhadhammasukhatthāya ",
  "tha-ap178:1.4": "abbhokāsamhi caṅkami. pasannacitto sumano vanditvā pupphamokiriṃ, ",
  "tha-ap178:2.1": "uddhate pāde pupphāni ",
  "tha-ap178:2.2": "sīsamuddhani tiṭṭhare. ",
  "tha-ap178:2.3": "",
  "tha-ap178:2.4": "",
  "tha-ap178:3.1": "vīsakappasahassamhi ",
  "tha-ap178:3.2": "ito pañca janā ahū, ",
  "tha-ap178:3.3": "pupphacchadaniyā nāma ",
  "tha-ap178:3.4": "cakkavattī mahabbalā. ",
  "tha-ap178:4.1": "paṭisambhidā catasso ",
  "tha-ap178:4.2": "vimokkhāpi ca aṭṭhime, chaḷabhiññā sacchikatā ",
  "tha-ap178:4.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap178:5.1": "itthaṃ sudaṃ āyasmā maggadattiko thero imā gāthāyo abhāsitthāti. ",
  "tha-ap178:6.1": "maggadattikattherassa apadānaṃ chaṭṭhaṃ. "
}
