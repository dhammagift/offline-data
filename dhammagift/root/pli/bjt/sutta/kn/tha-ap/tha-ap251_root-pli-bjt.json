{
  "tha-ap251:0.1": "",
  "tha-ap251:0.2": "",
  "tha-ap251:0.3": "249. bimbijāliyattherāpadānaṃ. ",
  "tha-ap251:1.1": "padumuttaro nāma jino ",
  "tha-ap251:1.2": "sayambhū aggapuggalo, ",
  "tha-ap251:1.3": "catusaccaṃ pakāseti ",
  "tha-ap251:1.4": "dīpeti amataṃ padaṃ. ",
  "tha-ap251:2.1": "bimbijālikapupphāni ",
  "tha-ap251:2.2": "puphu katvānahaṃ tadā, ",
  "tha-ap251:2.3": "buddhassa abhiropesiṃ ",
  "tha-ap251:2.4": "dipadindassa tādino. ",
  "tha-ap251:3.1": "aṭṭhasaṭṭhimhito kappe ",
  "tha-ap251:3.2": "caturo kiñjakesarā, ",
  "tha-ap251:3.3": "sattaratanasampannā ",
  "tha-ap251:3.4": "cakkavattī mahabbalā. ",
  "tha-ap251:4.1": "paṭisambhidā catasso ",
  "tha-ap251:4.2": "vimokkhāpi ca aṭṭhime, chaḷabhiññā sacchikatā ",
  "tha-ap251:4.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap251:5.1": "itthaṃ sudaṃ āyasmā bimbijāliyo thero imā gāthāyo abhāsitthāti. ",
  "tha-ap251:6.1": "bimbijāliyattherassa apadānaṃ navamaṃ. "
}
