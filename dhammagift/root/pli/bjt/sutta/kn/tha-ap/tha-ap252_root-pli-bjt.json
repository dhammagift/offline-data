{
  "tha-ap252:0.1": "",
  "tha-ap252:0.2": "",
  "tha-ap252:0.3": "250. uddāladāyakattherāpadānaṃ ",
  "tha-ap252:1.1": "kakusandho nāma nāmena ",
  "tha-ap252:1.2": "sayambhū aparājito, ",
  "tha-ap252:1.3": "pavanā nikkhamitvāna ",
  "tha-ap252:1.4": "anuppatto mahānadiṃ. ",
  "tha-ap252:2.1": "uddālakaṃ gahetvāna ",
  "tha-ap252:2.2": "sayambhūssa adāsahaṃ, ",
  "tha-ap252:2.3": "saṃyatassujubhūtassa ",
  "tha-ap252:2.4": "pasannamānaso tadā. ",
  "tha-ap252:3.1": "ekatiṃse ito kappe ",
  "tha-ap252:3.2": "yaṃ pupphamabhipūjayiṃ, ",
  "tha-ap252:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap252:3.4": "pupphadānassidaṃ phalaṃ. ",
  "tha-ap252:4.1": "paṭisambhidā catasso ",
  "tha-ap252:4.2": "vimokkhāpi ca aṭṭhime, chaḷabhiññā sacchikatā ",
  "tha-ap252:4.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap252:5.1": "itthaṃ sudaṃ āyasmā uddāladāyako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap252:6.1": "uddāladāyakattherassa apadānaṃ dasamaṃ. ",
  "tha-ap252:7.1": "uddānaṃ: tuvara ",
  "tha-ap252:8.1": "nāga ",
  "tha-ap252:9.1": "naḷinā ",
  "tha-ap252:9.2": "viravī kuṭidhūpako ",
  "tha-ap252:9.3": "patto dhātu sattaliyo ",
  "tha-ap252:9.4": "bimbī uddālakena ca ",
  "tha-ap252:9.5": "sattatiṃsati gāthāyo ",
  "tha-ap252:9.6": "gaṇitāyo vibhāvihi. "
}
