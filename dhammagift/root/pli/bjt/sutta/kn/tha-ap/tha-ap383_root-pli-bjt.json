{
  "tha-ap383:0.1": "bodhivandakavaggo aṭṭhatiṃsatimo. ",
  "tha-ap383:0.2": "39. avaṇṭaphalavaggo ",
  "tha-ap383:0.3": "381. avaṇṭaphaladāyakattherāpadānaṃ. ",
  "tha-ap383:1.1": "sataraṃsī nāma bhagavā ",
  "tha-ap383:1.2": "sayambhu aparājito, ",
  "tha-ap383:1.3": "vivekakāmo sambuddho ",
  "tha-ap383:1.4": "gocarāyā’bhinikkhami. ",
  "tha-ap383:2.1": "phalahattho ahaṃ disvā ",
  "tha-ap383:2.2": "upagacchiṃ narāsabhaṃ, ",
  "tha-ap383:2.3": "pasannacitto sumano ",
  "tha-ap383:2.4": "avaṇṭaṃ adadiṃ phalaṃ. ",
  "tha-ap383:3.1": "catunavute ito kappe ",
  "tha-ap383:3.2": "yaṃ phalamadadiṃ ahaṃ, ",
  "tha-ap383:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap383:3.4": "phaladānassidaṃ phalaṃ. ",
  "tha-ap383:4.1": "svāgataṃ vata me āsi buddhaseṭṭhassa santike, tisso vijjā anuppattā kataṃ buddhassa sāsanaṃ. kilesā jhāpitā mayhaṃ ",
  "tha-ap383:4.2": "bhavā sabbe samūhatā, ",
  "tha-ap383:4.3": "nāgova bandhanaṃ chetvā ",
  "tha-ap383:4.4": "viharāmi anāsavo. ",
  "tha-ap383:5.1": "",
  "tha-ap383:5.2": "",
  "tha-ap383:5.3": "",
  "tha-ap383:5.4": "",
  "tha-ap383:6.1": "paṭisambhidā catasso ",
  "tha-ap383:6.2": "vimokkhāpi ca aṭṭhime, ",
  "tha-ap383:6.3": "chaḷabhiññā sacchikatā ",
  "tha-ap383:6.4": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap383:7.1": "itthaṃ sudaṃ āyasmā avaṇṭaphaladāyako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap383:8.1": "avaṇṭaphaladāyakattherassa apadānaṃ paṭhamaṃ. "
}
