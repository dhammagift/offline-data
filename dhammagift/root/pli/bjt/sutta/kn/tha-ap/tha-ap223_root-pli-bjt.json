{
  "tha-ap223:0.1": "",
  "tha-ap223:0.2": "23. ālambanadāyakavaggo ",
  "tha-ap223:0.3": "221. ālambanadāyakattherāpadānaṃ. ",
  "tha-ap223:1.1": "atthadassissa bhagavato ",
  "tha-ap223:1.2": "lokajeṭṭhassa tādino, ",
  "tha-ap223:1.3": "ālambanaṃ mayā dinnaṃ ",
  "tha-ap223:1.4": "dipadindassa tādino. ",
  "tha-ap223:2.1": "dharaṇiṃ paṭipajjāmi ",
  "tha-ap223:2.2": "vipulaṃ sāgarapparaṃ, ",
  "tha-ap223:2.3": "pāṇesu ca issariyaṃ ",
  "tha-ap223:2.4": "vattemi vasudhāya ca. ",
  "tha-ap223:3.1": "kilesā jhāpitā mayhaṃ ",
  "tha-ap223:3.2": "bhavā sabbe samūhatā, ",
  "tha-ap223:3.3": "tisso vijjā anuppattā ",
  "tha-ap223:3.4": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap223:4.1": "ito dvesaṭṭhikappambhi ",
  "tha-ap223:4.2": "tayo āsiṃsu khattiyā, ",
  "tha-ap223:4.3": "ekāpassita nāmā te ",
  "tha-ap223:4.4": "cakkavattī mahabbalā. ",
  "tha-ap223:5.1": "paṭisambhidā catasso ",
  "tha-ap223:5.2": "vimokkhāpi ca aṭṭhime, ",
  "tha-ap223:5.3": "chaḷabhiññā sacchikatā ",
  "tha-ap223:5.4": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap223:6.1": "itthaṃ sudaṃ āyasmā ālambanadāyako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap223:7.1": "ālambanadāyakattherassa apadānaṃ paṭhamaṃ. "
}
