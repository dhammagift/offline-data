{
  "tha-ap270:0.1": "",
  "tha-ap270:0.2": "",
  "tha-ap270:0.3": "268. salalapupphiyattherāpadānaṃ. ",
  "tha-ap270:1.1": "candabhāgānadītīre ",
  "tha-ap270:1.2": "ahosiṃ kinnaro tadā, ",
  "tha-ap270:1.3": "vipassimaddasaṃ buddhaṃ ",
  "tha-ap270:1.4": "raṃsijālasamākulaṃ. ",
  "tha-ap270:2.1": "pasannacitto sumano ",
  "tha-ap270:2.2": "paramāya ca pitāyā, ",
  "tha-ap270:2.3": "paggayha salalaṃ pupphaṃ ",
  "tha-ap270:2.4": "vipassiṃ okiriṃ ahaṃ. ",
  "tha-ap270:3.1": "catunavute ito kappe ",
  "tha-ap270:3.2": "yaṃ pupphamabhipūjayiṃ, ",
  "tha-ap270:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap270:3.4": "buddhapūjāyidaṃ phalaṃ. ",
  "tha-ap270:4.1": "paṭisambhidā catasso ",
  "tha-ap270:4.2": "vimokkhāpi ca aṭṭhime, chaḷabhiññā sacchikatā ",
  "tha-ap270:4.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap270:5.1": "itthaṃ sudaṃ āyasmā salalapupphiyo thero imā gāthāyo abhāsitthāti. ",
  "tha-ap270:6.1": "salalapupphiyattherassa apadānaṃ aṭṭhamaṃ. "
}
