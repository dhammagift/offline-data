{
  "tha-ap422:0.1": "",
  "tha-ap422:0.2": "",
  "tha-ap422:0.3": "420. mañcadāyakattherāpadānaṃ ",
  "tha-ap422:1.1": "parinibbute kāruṇike ",
  "tha-ap422:1.2": "siddhatthe lokanāyake, ",
  "tha-ap422:1.3": "vitthārite pāvacane ",
  "tha-ap422:1.4": "devamānusasakkate. ",
  "tha-ap422:2.1": "caṇḍālo āsahaṃ tattha ",
  "tha-ap422:2.2": "āsandipīṭhakārako, ",
  "tha-ap422:2.3": "tena kammena jīvāmi ",
  "tha-ap422:2.4": "tena posemi dārake. ",
  "tha-ap422:3.1": "āsandiṃ sukataṃ katvā ",
  "tha-ap422:3.2": "pasanno sehi pāṇihi, ",
  "tha-ap422:3.3": "sayamevupagantvāna ",
  "tha-ap422:3.4": "bhikkhusaṅghassa’dāsahaṃ. ",
  "tha-ap422:4.1": "tena kammena sukatena ",
  "tha-ap422:4.2": "cetanāpaṇidhīhi ca, ",
  "tha-ap422:4.3": "jahitvā mānusaṃ dehaṃ ",
  "tha-ap422:4.4": "tāvatiṃsamagacchahaṃ. ",
  "tha-ap422:5.1": "devalokagato santo ",
  "tha-ap422:5.2": "modāmi tidasaṅgaṇe, ",
  "tha-ap422:5.3": "sayanāni mahagghāni ",
  "tha-ap422:5.4": "nibbattanti yadicchakaṃ. ",
  "tha-ap422:6.1": "paññāsakkhattuṃ devindo ",
  "tha-ap422:6.2": "devarajjamakārayiṃ, ",
  "tha-ap422:6.3": "asītikkhattuṃ rājā ca ",
  "tha-ap422:6.4": "cakkavattī ahosahaṃ. ",
  "tha-ap422:7.1": "padesarajjaṃ vipulaṃ ",
  "tha-ap422:7.2": "gaṇanāto asaṅkhiyaṃ, ",
  "tha-ap422:7.3": "sukhito yasavā homi ",
  "tha-ap422:7.4": "mañcadānissidaṃ phalaṃ. ",
  "tha-ap422:8.1": "devalokā cavitvāna ",
  "tha-ap422:8.2": "emi ce mānusaṃ bhavaṃ, ",
  "tha-ap422:8.3": "mahārahā susayanā ",
  "tha-ap422:8.4": "sayameva bhavanti me. ",
  "tha-ap422:9.1": "ayaṃ pacchimako mayhaṃ ",
  "tha-ap422:9.2": "carimo vattate bhavo, ",
  "tha-ap422:9.3": "ajjāpi sayane kāle ",
  "tha-ap422:9.4": "sayanaṃ upatiṭṭhati. ",
  "tha-ap422:10.1": "catunavute ito kappe ",
  "tha-ap422:10.2": "yaṃ dānamadadiṃ tadā, ",
  "tha-ap422:10.3": "duggatiṃ nābhijānāmi ",
  "tha-ap422:10.4": "mañcadānassidaṃ phalaṃ. ",
  "tha-ap422:11.1": "kilesā jhāpitā mayhaṃ ",
  "tha-ap422:11.2": "bhavā sabbe samūhatā, nāgo’va bandhanaṃ chetvā ",
  "tha-ap422:11.3": "viharāmi anāsavo. ",
  "tha-ap422:12.1": "svāgataṃ vata me āsi ",
  "tha-ap422:12.2": "buddhaseṭṭhassa santike, tisso vijjā anuppattā ",
  "tha-ap422:12.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap422:13.1": "paṭisambhidā catasso ",
  "tha-ap422:13.2": "vimokkhāpi ca aṭṭhime, chaḷabhiññā sacchikatā ",
  "tha-ap422:13.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap422:14.1": "itthaṃ sudaṃ āyasmā mañcadāyako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap422:15.1": "mañcadāyakattherassa apadānaṃ dasamaṃ. ",
  "tha-ap422:16.1": "uddānaṃ: ",
  "tha-ap422:17.1": "",
  "tha-ap422:18.1": "bhaddālī ekachatto ca ",
  "tha-ap422:18.2": "tiṇasūlo ca maṃsado, ",
  "tha-ap422:18.3": "nāgapallaviko dīpī ",
  "tha-ap422:18.4": "ucchaṅgī yāgudāyako. ",
  "tha-ap422:19.1": "patthodanī mañcadado ",
  "tha-ap422:19.2": "gāthāyo gaṇitā ciha, ",
  "tha-ap422:19.3": "dvesatāni ca gāthānaṃ ",
  "tha-ap422:19.4": "gāthā cekā taduttariṃ. bhaddālivaggo dvācattāḷisatimo. "
}
