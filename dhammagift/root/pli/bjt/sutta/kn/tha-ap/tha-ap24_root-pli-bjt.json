{
  "tha-ap24:0.1": "",
  "tha-ap24:0.2": "",
  "tha-ap24:0.3": "22. upavānattherāpadānaṃ. ",
  "tha-ap24:1.1": "padumuttaro nāma jino ",
  "tha-ap24:1.2": "sabbadhammāna pāragū, ",
  "tha-ap24:1.3": "jalitvā aggikkhandho va ",
  "tha-ap24:1.4": "sambuddho parinibbuto. ",
  "tha-ap24:2.1": "mahājanā samāgamma ",
  "tha-ap24:2.2": "pūjayitvā tathāgataṃ, ",
  "tha-ap24:2.3": "citaṃ katvāna sukataṃ ",
  "tha-ap24:2.4": "sarīraṃ abhiropayuṃ. ",
  "tha-ap24:3.1": "sarīrakiccaṃ katvāna ",
  "tha-ap24:3.2": "dhātuṃ tattha samānayuṃ, ",
  "tha-ap24:3.3": "sadevamānusā sabbe ",
  "tha-ap24:3.4": "buddhathūpaṃ akaṃsu te. ",
  "tha-ap24:4.1": "paṭhamā kañcanamayā ",
  "tha-ap24:4.2": "dutiyā’si maṇimayā, ",
  "tha-ap24:4.3": "tatiyā rūpiyamayā ",
  "tha-ap24:4.4": "catutthā phaḷikāmayā. ",
  "tha-ap24:5.1": "tathā pañcamiyā nemī ",
  "tha-ap24:5.2": "lohitaṅkamayā ahu, ",
  "tha-ap24:5.3": "chaṭṭhā masāragallassa ",
  "tha-ap24:5.4": "sabbaratanamayūpari. ",
  "tha-ap24:6.1": "jaṅghā maṇimayā āsi ",
  "tha-ap24:6.2": "vedikā ratanāmayā, ",
  "tha-ap24:6.3": "sabbasovaṇṇayo thūpo ",
  "tha-ap24:6.4": "uddhaṃ yojanamuggato. ",
  "tha-ap24:7.1": "devā tattha samāgantvā ",
  "tha-ap24:7.2": "ekato mantayuṃ tadā, ",
  "tha-ap24:7.3": "“mayampi thūpaṃ kassāma ",
  "tha-ap24:7.4": "lokanāthassa tādino. ",
  "tha-ap24:8.1": "dhātu āveṇikā natthi ",
  "tha-ap24:8.2": "sarīraṃ ekapiṇḍitaṃ, ",
  "tha-ap24:8.3": "imamhi buddhathūpamhi ",
  "tha-ap24:8.4": "kassāma kañcukaṃ mayaṃ.” ",
  "tha-ap24:9.1": "devā sattaratanehi ",
  "tha-ap24:9.2": "aññaṃ vaḍḍhesu yojanaṃ, ",
  "tha-ap24:9.3": "thūpo dviyojanubbedho ",
  "tha-ap24:9.4": "timiraṃ vyapahanti so. ",
  "tha-ap24:10.1": "nāgā tattha samāgantvā ",
  "tha-ap24:10.2": "ekato mantayuṃ tadā, ",
  "tha-ap24:10.3": "“manussā ceva devā ca ",
  "tha-ap24:10.4": "buddhathūpaṃ akaṃsu te. ",
  "tha-ap24:11.1": "mā no pamattā assumhā ",
  "tha-ap24:11.2": "appamattā sadevakā, ",
  "tha-ap24:11.3": "mayampi thūpaṃ kassāma ",
  "tha-ap24:11.4": "lokanāthassa tādino.” ",
  "tha-ap24:12.1": "indanīlaṃ mahānīlaṃ ",
  "tha-ap24:12.2": "atho jotirasaṃ maṇiṃ, ",
  "tha-ap24:12.3": "ekato sannipātetvā ",
  "tha-ap24:12.4": "buddhathūpaṃ achādayuṃ. ",
  "tha-ap24:13.1": "sabbaṃ maṇimayaṃ āsi ",
  "tha-ap24:13.2": "tāvatā buddhacetiyaṃ, ",
  "tha-ap24:13.3": "tiṃsayojanamubbedhaṃ ",
  "tha-ap24:13.4": "ālokakaraṇaṃ tadā. ",
  "tha-ap24:14.1": "garuḷā ca samāgantvā ",
  "tha-ap24:14.2": "ekato mantayuṃ tadā, ",
  "tha-ap24:14.3": "“mānusā devā nāgā ca ",
  "tha-ap24:14.4": "buddhathūpaṃ akaṃsu te. ",
  "tha-ap24:15.1": "mā no pamattā assumhā ",
  "tha-ap24:15.2": "appamattā sadevakā, ",
  "tha-ap24:15.3": "mayampi thūpaṃ kassāma ",
  "tha-ap24:15.4": "lokanāthassa tādino. ",
  "tha-ap24:16.1": "sabbamaṇimayaṃ thūpe ",
  "tha-ap24:16.2": "akaru’ttarakañcukaṃ, ",
  "tha-ap24:16.3": "yojanaṃ tepi vaḍḍhesuṃ ",
  "tha-ap24:16.4": "āyataṃ buddhacetiyaṃ. ",
  "tha-ap24:17.1": "catuyojanamubbiddho ",
  "tha-ap24:17.2": "buddhathūpo virocatī, ",
  "tha-ap24:17.3": "obhāseti disā sabbā ",
  "tha-ap24:17.4": "sataraṃsīva uggato. ",
  "tha-ap24:18.1": "kumbhaṇḍā ca samāgantvā ",
  "tha-ap24:18.2": "ekato mantayuṃ tadā, ",
  "tha-ap24:18.3": "“manussā ceva devā ca ",
  "tha-ap24:18.4": "nāgā ca garuḷā tathā. ",
  "tha-ap24:18.5": "paccekaṃ buddhaseṭṭhassa ",
  "tha-ap24:18.6": "akaṃsu thūpamuttamaṃ, ",
  "tha-ap24:19.1": "mā no pamattā assumhā ",
  "tha-ap24:19.2": "appamattā sadevakā. ",
  "tha-ap24:19.3": "mayampi thūpaṃ kassāma ",
  "tha-ap24:19.4": "lokanāthassa tādino, ",
  "tha-ap24:19.5": "ratanehi chādayissāma ",
  "tha-ap24:19.6": "āyataṃ buddhacetiyaṃ. ",
  "tha-ap24:20.1": "yojanaṃ tepi vaḍḍhesuṃ ",
  "tha-ap24:20.2": "āyataṃ buddhacetiyaṃ, ",
  "tha-ap24:20.3": "pañcayojanamubbiddho ",
  "tha-ap24:20.4": "thūpo obhāsate tadā. ",
  "tha-ap24:21.1": "yakkhā tattha samāgantvā ",
  "tha-ap24:21.2": "ekato mantayuṃ tadā, ",
  "tha-ap24:21.3": "“manussā devanāgā ca ",
  "tha-ap24:21.4": "garuḷā kumbhaaṇḍakā. ",
  "tha-ap24:22.1": "paccekaṃ buddhaseṭṭhassa ",
  "tha-ap24:22.2": "akaṃsu thūpamuttamaṃ, ",
  "tha-ap24:22.3": "mā no pamattā assumhā ",
  "tha-ap24:22.4": "appamattā sadevakā. ",
  "tha-ap24:23.1": "mayampi thūpaṃ kassāma ",
  "tha-ap24:23.2": "lokanāthassa tādino, ",
  "tha-ap24:23.3": "eḷikāhi chādayissāma ",
  "tha-ap24:23.4": "āyataṃ buddhacetiyaṃ. ",
  "tha-ap24:24.1": "yojanaṃ tepi vaḍḍhesuṃ ",
  "tha-ap24:24.2": "āyataṃ buddhacetiyaṃ, ",
  "tha-ap24:24.3": "cha yojanāni ubbīddho ",
  "tha-ap24:24.4": "thūpo obhāsate tadā. ",
  "tha-ap24:25.1": "gandhabbā ca samāgantvā ",
  "tha-ap24:25.2": "ekato mantayuṃ tadā, ",
  "tha-ap24:25.3": "“manujā devatā nāgā ",
  "tha-ap24:25.4": "kumbhaṇḍā guruḷā tathā. ",
  "tha-ap24:26.1": "sabbe’kaṃsuṃ buddhathūpaṃ ",
  "tha-ap24:26.2": "mayamettha akārakā, ",
  "tha-ap24:26.3": "mayampi thūpaṃ kassāma ",
  "tha-ap24:26.4": "lokanāthassa tādino. ",
  "tha-ap24:27.1": "vediyo satta katvāna ",
  "tha-ap24:27.2": "chattamāropayiṃsu te, ",
  "tha-ap24:27.3": "sabbasoṇṇamayaṃ thūpaṃ ",
  "tha-ap24:27.4": "gandhabbā kārayuṃ tadā. ",
  "tha-ap24:28.1": "sattayojanamubbiddho ",
  "tha-ap24:28.2": "thūpo obhāsate tadā, ",
  "tha-ap24:28.3": "rattindivā na ñāyanti ",
  "tha-ap24:28.4": "āloko hoti sabbadā. ",
  "tha-ap24:29.1": "abhibhonti na tassā’bhā ",
  "tha-ap24:29.2": "candasūrā satārakā, ",
  "tha-ap24:29.3": "samantā yojanasate ",
  "tha-ap24:29.4": "padīpopi na pajjali. ",
  "tha-ap24:30.1": "tena kālena ye keci ",
  "tha-ap24:30.2": "thūpaṃ pūjenti mānusā, ",
  "tha-ap24:30.3": "na te thūpamāruhanti ",
  "tha-ap24:30.4": "ambare ukkhipanti te. ",
  "tha-ap24:31.1": "devehi ṭhapito yakkho ",
  "tha-ap24:31.2": "abhisammatanāmako, ",
  "tha-ap24:31.3": "dhajaṃ vā pupphadāmaṃ vā ",
  "tha-ap24:31.4": "abhiropeti uttari. ",
  "tha-ap24:32.1": "na te passanti taṃ yakkhaṃ ",
  "tha-ap24:32.2": "dāmaṃ passanti gacchato, ",
  "tha-ap24:32.3": "evaṃ passitvā gacchantā ",
  "tha-ap24:32.4": "sabbe gacchanti suggatiṃ. ",
  "tha-ap24:33.1": "visaddhā ye pāvacane ",
  "tha-ap24:33.2": "pasannā ye ca sāsane, ",
  "tha-ap24:33.3": "pāṭihīraṃ daṭṭhaṭukāmā ",
  "tha-ap24:33.4": "thūpaṃ pūjenti mānusā. ",
  "tha-ap24:34.1": "nagare haṃsavatiyā ",
  "tha-ap24:34.2": "ahosiṃ bhatako tadā, ",
  "tha-ap24:34.3": "āmoditaṃ janaṃ disvā ",
  "tha-ap24:34.4": "evaṃ cintesa’haṃ tadā. ",
  "tha-ap24:35.1": "“uḷāro bhagavā he’so ",
  "tha-ap24:35.2": "yassa dhātughare’disaṃ, ",
  "tha-ap24:35.3": "imā ca janatā tuṭṭhākāraṃ ",
  "tha-ap24:35.4": "kubbantanappakaṃ. ",
  "tha-ap24:36.1": "ahampi kāraṃ kassāmi ",
  "tha-ap24:36.2": "lokanāthassa tādino, ",
  "tha-ap24:36.3": "tassa dhammesu dāyādo ",
  "tha-ap24:36.4": "bhavissāmi anāgate. ",
  "tha-ap24:37.1": "sudhotaṃ rajakenā’haṃ ",
  "tha-ap24:37.2": "uttareyyapaṭaṃ mama, ",
  "tha-ap24:37.3": "veḷagge ālagetvāna ",
  "tha-ap24:37.4": "dhajaṃ ukkhipimambare. ",
  "tha-ap24:38.1": "abhisammatako gayha ",
  "tha-ap24:38.2": "ambare’hāsi me dhajaṃ, ",
  "tha-ap24:38.3": "vāteritaṃ dhajaṃ disvā ",
  "tha-ap24:38.4": "bhīyo hāsaṃ janesa’haṃ. ",
  "tha-ap24:39.1": "tattha cittaṃ pasādetvā ",
  "tha-ap24:39.2": "samaṇaṃ upasaṅkamiṃ, ",
  "tha-ap24:39.3": "taṃ bhikkhuṃ abhivādetvā ",
  "tha-ap24:39.4": "vipākaṃ puccha’haṃ dhaje. ",
  "tha-ap24:40.1": "so me kathesi ānandapītisañjananaṃ ",
  "tha-ap24:40.2": "mama, ",
  "tha-ap24:40.3": "“tassa dhajassa vipākaṃ ",
  "tha-ap24:40.4": "anubhossasi sabbadā. ",
  "tha-ap24:41.1": "hatthi assā rathā pattī ",
  "tha-ap24:41.2": "senā ca caturaṅginī, ",
  "tha-ap24:41.3": "parivāressanti taṃ niccaṃ ",
  "tha-ap24:41.4": "dhajadānassi’daṃ phalaṃ. ",
  "tha-ap24:42.1": "saṭṭhi turiyasahassāni ",
  "tha-ap24:42.2": "bheriyo samalaṅkatā, ",
  "tha-ap24:42.3": "parivāressanti taṃ niccaṃ ",
  "tha-ap24:42.4": "dhajadānassi’daṃ phalaṃ ",
  "tha-ap24:43.1": "chaḷāsītisahassāni ",
  "tha-ap24:43.2": "nāriyo samalaṅkatā, ",
  "tha-ap24:43.3": "vicittavatthābharaṇā ",
  "tha-ap24:43.4": "āmuttamaṇikuṇḍalā. ",
  "tha-ap24:44.1": "aḷārapamhā hasulā ",
  "tha-ap24:44.2": "susaṇhā tanumajjhimā, ",
  "tha-ap24:44.3": "parivāressanti taṃ niccaṃ ",
  "tha-ap24:44.4": "dhajadānassi’daṃ phalaṃ. ",
  "tha-ap24:45.1": "tiṃsa kappasahassāni ",
  "tha-ap24:45.2": "devaloke ramissasi, ",
  "tha-ap24:45.3": "asītikkhattuṃ devindo ",
  "tha-ap24:45.4": "devarajjaṃ karissasi. ",
  "tha-ap24:46.1": "sahassakkhattuṃ rājā ca ",
  "tha-ap24:46.2": "cakkavattī bhavissasi, ",
  "tha-ap24:46.3": "padesarajjaṃ vipulaṃ ",
  "tha-ap24:46.4": "gaṇanāto asaṅkhiyaṃ. ",
  "tha-ap24:47.1": "kappasatasahassamhi ",
  "tha-ap24:47.2": "okkāka kulasambhavo, ",
  "tha-ap24:47.3": "gotamo nāma gottena ",
  "tha-ap24:47.4": "satthā loke bhavissati. ",
  "tha-ap24:48.1": "devalokā cavitvāna ",
  "tha-ap24:48.2": "sukkamūlena codito, ",
  "tha-ap24:48.3": "puññakammena saṃyutto ",
  "tha-ap24:48.4": "brahmabandhu bhavissasi. ",
  "tha-ap24:49.1": "asītikoṭiṃ chaḍḍetvā ",
  "tha-ap24:49.2": "dāse kammakare bahū, ",
  "tha-ap24:49.3": "gotamassa bhagavato ",
  "tha-ap24:49.4": "sāsane pabbajissasi. ",
  "tha-ap24:50.1": "ārādhayitvā sambuddhaṃ ",
  "tha-ap24:50.2": "gotamaṃ sakyapuṅgavaṃ, ",
  "tha-ap24:50.3": "upavānoti nāmena ",
  "tha-ap24:50.4": "hessasi satthu sāvako”ti. ",
  "tha-ap24:51.1": "satasahasse kataṃ kammaṃ ",
  "tha-ap24:51.2": "phalaṃ dassesi me idha, ",
  "tha-ap24:51.3": "sumutta saravegova ",
  "tha-ap24:51.4": "kilese jhāpayī mama. ",
  "tha-ap24:52.1": "cakkavattissa santassa ",
  "tha-ap24:52.2": "catudīpissarassa me, ",
  "tha-ap24:52.3": "tiyojanāni sāmantā ",
  "tha-ap24:52.4": "ussīyanti dhajā sadā. ",
  "tha-ap24:53.1": "satasahasse ito kappe ",
  "tha-ap24:53.2": "yaṃ kammamakariṃ tadā, ",
  "tha-ap24:53.3": "duggatiṃ nābhijānāmi ",
  "tha-ap24:53.4": "dhajadānassi’daṃ phalaṃ. ",
  "tha-ap24:54.1": "paṭisambhidā …pe… ",
  "tha-ap24:54.2": "",
  "tha-ap24:54.3": "",
  "tha-ap24:54.4": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap24:55.1": "itthaṃ sudaṃ āyasmā upavāno thero imā gāthāyo abhāsitthāti. ",
  "tha-ap24:56.1": "upavānattherassāpadānaṃ dutiyaṃ. "
}
