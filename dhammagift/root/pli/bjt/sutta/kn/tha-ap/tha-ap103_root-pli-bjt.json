{
  "tha-ap103:0.1": "",
  "tha-ap103:0.2": "11. bhikkhādāyīvaggo ",
  "tha-ap103:0.3": "101. bhikkhādāyakattherāpadānaṃ. ",
  "tha-ap103:1.1": "suvaṇṇavaṇṇaṃ sambuddhaṃ ",
  "tha-ap103:1.2": "āhutīnaṃ paṭiggahaṃ, ",
  "tha-ap103:1.3": "pavanā abhinikkhantaṃ ",
  "tha-ap103:1.4": "vanā nibbanamāgataṃ. ",
  "tha-ap103:2.1": "kaṭacchubhikkhaṃ pādāsiṃ ",
  "tha-ap103:2.2": "siddhatthassa mahesino, ",
  "tha-ap103:2.3": "paññassa upasantassa ",
  "tha-ap103:2.4": "maha vīrassa tādino. ",
  "tha-ap103:3.1": "padenānupadaṃ yantaṃ ",
  "tha-ap103:3.2": "nibbāpente mahājanaṃ, ",
  "tha-ap103:3.3": "uḷārā vitti me jātā ",
  "tha-ap103:3.4": "buddhe ādiccabandhuni. catunavute ",
  "tha-ap103:4.1": "ito kappe ",
  "tha-ap103:4.2": "yaṃ dānamadadiṃ tadā, ",
  "tha-ap103:4.3": "duggatiṃ nābhijānāmi ",
  "tha-ap103:4.4": "bhikkhādānassidaṃ phalaṃ. ",
  "tha-ap103:5.1": "sattāsītimhi’to kappe ",
  "tha-ap103:5.2": "mahāreṇusanāmakā, ",
  "tha-ap103:5.3": "sattaratanasampannā ",
  "tha-ap103:5.4": "satte’va cakkavattino. ",
  "tha-ap103:6.1": "paṭisambhidā …pe… ",
  "tha-ap103:6.2": "",
  "tha-ap103:6.3": "",
  "tha-ap103:6.4": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap103:7.1": "itthaṃ sudaṃ āyasmā bhikkhādāyako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap103:8.1": "bhikkhādāyakattherassa apadānaṃ paṭhamaṃ. "
}
