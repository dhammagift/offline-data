{
  "tha-ap257:0.1": "",
  "tha-ap257:0.2": "",
  "tha-ap257:0.3": "255. sattapāṭaliyattherāpadānaṃ. ",
  "tha-ap257:1.1": "kaṇikāraṃva jotantaṃ ",
  "tha-ap257:1.2": "nisinnaṃ pabbatantare, ",
  "tha-ap257:1.3": "sattapāṭalipupphāni ",
  "tha-ap257:1.4": "buddhassa abhiropayiṃ. ",
  "tha-ap257:2.1": "catunavute ito kappe ",
  "tha-ap257:2.2": "yaṃ pupphamabhipūjayiṃ, ",
  "tha-ap257:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap257:2.4": "buddhapūjāyidaṃ phalaṃ. ",
  "tha-ap257:3.1": "paṭisambhidā catasso ",
  "tha-ap257:3.2": "vimokkhāpi ca aṭṭhime, chaḷabhiññā sacchikatā ",
  "tha-ap257:3.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap257:4.1": "itthaṃ sudaṃ āyasmā sattapāṭaliyo thero imā gāthāyo abhāsitthāti. ",
  "tha-ap257:5.1": "sattapāṭaliyattherassa apadānaṃ pañcamaṃ. "
}
