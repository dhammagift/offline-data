{
  "tha-ap23:0.1": "",
  "tha-ap23:0.2": "3. subhūtivaggo ",
  "tha-ap23:0.3": "21. subhūtittherāpadānaṃ. ",
  "tha-ap23:1.1": "himavantassa avidūre ",
  "tha-ap23:1.2": "nisabho nāma pabbato, ",
  "tha-ap23:1.3": "assamo sukato mayhaṃ ",
  "tha-ap23:1.4": "paṇṇasālā sumāpitā. ",
  "tha-ap23:2.1": "kosiyo nāma nāmena ",
  "tha-ap23:2.2": "jaṭilo uggatāpano, ",
  "tha-ap23:2.3": "ekākiyo adutiyo ",
  "tha-ap23:2.4": "vasāmi nisabhe tadā. ",
  "tha-ap23:3.1": "phalaṃ mūlañca paṇṇañca ",
  "tha-ap23:3.2": "na bhuñjāmi ahaṃ tadā, ",
  "tha-ap23:3.3": "pavattapaṇḍupattāni ",
  "tha-ap23:3.4": "upajīvāmi tāvade. ",
  "tha-ap23:4.1": "nā’haṃ kopemi ājīvaṃ ",
  "tha-ap23:4.2": "cajamānopi jīvitaṃ, ",
  "tha-ap23:4.3": "ārādhemi sakaṃ cittaṃ ",
  "tha-ap23:4.4": "vivajjemi anesanaṃ. ",
  "tha-ap23:5.1": "rāgūpasaṃhitaṃ cittaṃ ",
  "tha-ap23:5.2": "yadā uppajjate mama, ",
  "tha-ap23:5.3": "sayaṃva paccavekkhāmi ",
  "tha-ap23:5.4": "ekaggo taṃ damme’haṃ. ",
  "tha-ap23:6.1": "“rajjasi rajanīye ca ",
  "tha-ap23:6.2": "dosanīye ca dussasi, ",
  "tha-ap23:6.3": "muyhase mohanīye ca ",
  "tha-ap23:6.4": "nikkhamassu vanā tuvaṃ. ",
  "tha-ap23:7.1": "visuddhānaṃ ayaṃ vāso ",
  "tha-ap23:7.2": "nimmalānaṃ tapassinaṃ, ",
  "tha-ap23:7.3": "mā kho visuddhaṃ dūsesi ",
  "tha-ap23:7.4": "nikkhamassu vanā tuvaṃ. ",
  "tha-ap23:8.1": "agāriko bhavitvāna ",
  "tha-ap23:8.2": "sadā yuttaṃ labhissasi, ",
  "tha-ap23:8.3": "ubhopi mā virādhesi ",
  "tha-ap23:8.4": "nikkhamassu vanā tuvaṃ. ",
  "tha-ap23:9.1": "chavālātaṃ yathā kaṭṭhaṃ ",
  "tha-ap23:9.2": "na kvaci kiccakārakaṃ, ",
  "tha-ap23:9.3": "neva gāme araññe vā ",
  "tha-ap23:9.4": "na hi taṃ kaṭṭhasammataṃ. ",
  "tha-ap23:10.1": "chavālātūpamo tvaṃsi ",
  "tha-ap23:10.2": "na gihī nāpi saññato, ",
  "tha-ap23:10.3": "ubhato muttako ajja ",
  "tha-ap23:10.4": "nikkhamassu vanā tuvaṃ. ",
  "tha-ap23:11.1": "siyā nu kho tava etaṃ ",
  "tha-ap23:11.2": "ko pajānāti te idaṃ, ",
  "tha-ap23:11.3": "saddhādhuraṃ jahasi te ",
  "tha-ap23:11.4": "kosajjabahulāya ca. ",
  "tha-ap23:12.1": "jigucchissanti taṃ viññū ",
  "tha-ap23:12.2": "asuciṃ nāgariko yathā, ",
  "tha-ap23:12.3": "ākaḍḍhitvāna isayo ",
  "tha-ap23:12.4": "codayissanti taṃ sadā. ",
  "tha-ap23:13.1": "taṃ viññū pavadissanti ",
  "tha-ap23:13.2": "samatikkantasāsanaṃ, ",
  "tha-ap23:13.3": "saṃvāsaṃ alabhanto hi ",
  "tha-ap23:13.4": "kathaṃ jīvissasī tuvaṃ. ",
  "tha-ap23:14.1": "tidhā pabhinnamātaṅgaṃ ",
  "tha-ap23:14.2": "kuñjaraṃ saṭṭhihāyanaṃ, ",
  "tha-ap23:14.3": "balī nāgo upagantvā ",
  "tha-ap23:14.4": "yūthā nīharate gajaṃ. ",
  "tha-ap23:15.1": "yūthā vinissaṭo santo ",
  "tha-ap23:15.2": "sukhaṃ sātaṃ na vindati, ",
  "tha-ap23:15.3": "dukkhito vimano hoti ",
  "tha-ap23:15.4": "pajjhāyanto pavadheti. ",
  "tha-ap23:16.1": "tatheva jaṭilā tampi ",
  "tha-ap23:16.2": "nīharissanti dummatiṃ, ",
  "tha-ap23:16.3": "tehi tvaṃ nissaṭo santo ",
  "tha-ap23:16.4": "sukhaṃ sātaṃ na lacchasi. ",
  "tha-ap23:17.1": "divā yā yadi vā rattiṃ ",
  "tha-ap23:17.2": "sokasallasamappito, ",
  "tha-ap23:17.3": "ḍayhasi pariḷāhena ",
  "tha-ap23:17.4": "gajo yuthā’va nissaṭo. ",
  "tha-ap23:18.1": "jātarūpaṃ yathā kūṭaṃ ",
  "tha-ap23:18.2": "neva jhāpeti katthaci, ",
  "tha-ap23:18.3": "tathā sīlavihīno tvaṃ ",
  "tha-ap23:18.4": "na jhāpessasi katthaci. ",
  "tha-ap23:19.1": "agāraṃ vasamānopi ",
  "tha-ap23:19.2": "kathaṃ jīvihisī tuvaṃ, ",
  "tha-ap23:19.3": "mattikaṃ pettikaṃ cāpi ",
  "tha-ap23:19.4": "natthi te nihitaṃ dhanaṃ. ",
  "tha-ap23:20.1": "sayaṃ kammaṃ karitvāna ",
  "tha-ap23:20.2": "gatte sedaṃ pamocayaṃ, ",
  "tha-ap23:20.3": "evaṃ jīvihisi gehe ",
  "tha-ap23:20.4": "sādhu te taṃ na ruccatī.” ",
  "tha-ap23:21.1": "evāhaṃ tattha vāremi ",
  "tha-ap23:21.2": "saṅkilesagataṃ manaṃ, ",
  "tha-ap23:21.3": "nānādhammakathaṃ katvā ",
  "tha-ap23:21.4": "pāpā cittā nivārayiṃ. ",
  "tha-ap23:22.1": "evaṃ me viharantassa ",
  "tha-ap23:22.2": "appamādavihārino, ",
  "tha-ap23:22.3": "tiṃsa vassasahassāni ",
  "tha-ap23:22.4": "vipine me atikkamuṃ. ",
  "tha-ap23:23.1": "appamādarataṃ disvā ",
  "tha-ap23:23.2": "uttamatthagavesakaṃ, ",
  "tha-ap23:23.3": "padumuttarasambuddho ",
  "tha-ap23:23.4": "āgacchi mama santikaṃ. ",
  "tha-ap23:24.1": "timbarūsakavaṇṇābho ",
  "tha-ap23:24.2": "appameyyo anūpamo, ",
  "tha-ap23:24.3": "rūpena’sadiso buddho ",
  "tha-ap23:24.4": "ākāse caṅkamī tadā. ",
  "tha-ap23:25.1": "suphullo sālarājā’va ",
  "tha-ap23:25.2": "vijjū’va’bbhaghanantare, ",
  "tha-ap23:25.3": "ñāṇenā’sadiso buddho ",
  "tha-ap23:25.4": "ākāse caṅkamī tadā. ",
  "tha-ap23:26.1": "sīharājāva’sambhīto ",
  "tha-ap23:26.2": "gajarājāva dappito, ",
  "tha-ap23:26.3": "lasito vyaggharājāva ",
  "tha-ap23:26.4": "ākāse caṅkamī tadā. ",
  "tha-ap23:27.1": "siṃgīnikkhasuvaṇṇābho ",
  "tha-ap23:27.2": "khadiraṅgārasannibho, ",
  "tha-ap23:27.3": "maṇi yathā jotiraso ",
  "tha-ap23:27.4": "ākāse caṅkamī tadā. ",
  "tha-ap23:28.1": "visuddhakelāsanibho ",
  "tha-ap23:28.2": "puṇṇamāyeva candimā, ",
  "tha-ap23:28.3": "majjhantikeva suriyo ",
  "tha-ap23:28.4": "ākāse caṅkamī tadā. ",
  "tha-ap23:29.1": "disvā nabhe caṅkamantaṃ ",
  "tha-ap23:29.2": "evaṃ cintesa’haṃ tadā, ",
  "tha-ap23:29.3": "“devo nu kho ayaṃ satto, ",
  "tha-ap23:29.4": "udāhu manujo ayaṃ? ",
  "tha-ap23:30.1": "na me suto vā diṭṭho vā ",
  "tha-ap23:30.2": "mahiyā ediso naro, ",
  "tha-ap23:30.3": "api mantapadaṃ atthi, ",
  "tha-ap23:30.4": "ayaṃ satthā bhavissati.” ",
  "tha-ap23:31.1": "evāhaṃ cintayitvāna ",
  "tha-ap23:31.2": "sakaṃ cittaṃ pasādayiṃ, ",
  "tha-ap23:31.3": "nānāpuppañca gandhañca ",
  "tha-ap23:31.4": "santipātetva’haṃ tadā. ",
  "tha-ap23:32.1": "pupphāsanaṃ paññapetvā ",
  "tha-ap23:32.2": "sādhucittaṃ manoramaṃ, ",
  "tha-ap23:32.3": "narasārathinaṃ aggaṃ ",
  "tha-ap23:32.4": "idaṃ vacanamabraviṃ. ",
  "tha-ap23:33.1": "“idaṃ me āsanaṃ vīra ",
  "tha-ap23:33.2": "paññattaṃ tava’nucchaviṃ, ",
  "tha-ap23:33.3": "hāsayanto mamaṃ cittaṃ ",
  "tha-ap23:33.4": "nisīda kusumāsane.” ",
  "tha-ap23:34.1": "nisīdi tattha bhagavā ",
  "tha-ap23:34.2": "asambhītova kesarī, ",
  "tha-ap23:34.3": "sattarattindivaṃ buddho ",
  "tha-ap23:34.4": "pavare kusumāsane. ",
  "tha-ap23:35.1": "namassamāno aṭṭhāsiṃ ",
  "tha-ap23:35.2": "sattarattindivaṃ ahaṃ, ",
  "tha-ap23:35.3": "vuṭṭhahitvā samādhimhā ",
  "tha-ap23:35.4": "satthā loke anuttaro. ",
  "tha-ap23:35.5": "mama kammaṃ pakittento ",
  "tha-ap23:35.6": "idaṃ vacanamabraviṃ, ",
  "tha-ap23:36.1": "“bhāvehi buddhānussatiṃ ",
  "tha-ap23:36.2": "bhāvanānamanuttaraṃ. ",
  "tha-ap23:36.3": "imaṃ satiṃ bhāvayitvā ",
  "tha-ap23:36.4": "pūrayissasi mānasaṃ, ",
  "tha-ap23:37.1": "tiṃsa kappasahassāni ",
  "tha-ap23:37.2": "devaloke ramissasi. ",
  "tha-ap23:37.3": "asītikkhattuṃ devindo ",
  "tha-ap23:37.4": "devarajjaṃ karissasi, ",
  "tha-ap23:37.5": "sahassakkhattuṃ cakkavattī ",
  "tha-ap23:37.6": "rājā raṭṭhe bhavissasi. ",
  "tha-ap23:38.1": "padesarajjaṃ vipulaṃ ",
  "tha-ap23:38.2": "gaṇanāto asaṅkhiyaṃ, ",
  "tha-ap23:38.3": "anubhossasi taṃ sabbaṃ ",
  "tha-ap23:38.4": "buddhānussatiyā phalaṃ. ",
  "tha-ap23:39.1": "bhavābhave saṃsaranto ",
  "tha-ap23:39.2": "mahābhogaṃ labhissasi, ",
  "tha-ap23:39.3": "bhoge te ūnatā natthi ",
  "tha-ap23:39.4": "buddhānussatiyā phalaṃ. ",
  "tha-ap23:40.1": "kappasatasahassamhi ",
  "tha-ap23:40.2": "okkākakulasambhavo, ",
  "tha-ap23:40.3": "gotamo nāma gottena ",
  "tha-ap23:40.4": "satthā loke bhavissati. ",
  "tha-ap23:41.1": "asītikoṭiṃ chaḍḍetvā ",
  "tha-ap23:41.2": "dāse kammakare bahū, ",
  "tha-ap23:41.3": "gotamassa bhagavato ",
  "tha-ap23:41.4": "sāsane pabbajissasi. ",
  "tha-ap23:42.1": "ārādhayitvā sambuddhaṃ ",
  "tha-ap23:42.2": "gotamaṃ sakyapuṅgavaṃ, ",
  "tha-ap23:42.3": "subhūti nāma nāmena ",
  "tha-ap23:42.4": "hessati satthu sāvako. ",
  "tha-ap23:43.1": "bhikkhusaṅghe nisīditvā ",
  "tha-ap23:43.2": "dakkhiṇeyyaguṇambhi taṃ, ",
  "tha-ap23:43.3": "tathā’raṇavihāre ca ",
  "tha-ap23:43.4": "dvīsu agge ṭhapessati. ",
  "tha-ap23:44.1": "idaṃ vatvāna sambuddho ",
  "tha-ap23:44.2": "jalajuttaranāmako, ",
  "tha-ap23:44.3": "nabhaṃ abbhuggamī dhīro ",
  "tha-ap23:44.4": "haṃsarājāva ambare. ",
  "tha-ap23:45.1": "sāsito lokanāthena ",
  "tha-ap23:45.2": "namassitvā tathāgataṃ, ",
  "tha-ap23:45.3": "sadā bhāvemi mudito ",
  "tha-ap23:45.4": "buddhānussatimuttamaṃ. ",
  "tha-ap23:46.1": "tena kammena sukatena ",
  "tha-ap23:46.2": "cetanā paṇidhīhi ca, ",
  "tha-ap23:46.3": "jahitvā mānusaṃ dehaṃ ",
  "tha-ap23:46.4": "tāvatiṃsamagaccha’haṃ. ",
  "tha-ap23:47.1": "asītikkhattuṃ devindo ",
  "tha-ap23:47.2": "devarajjamakārayiṃ, ",
  "tha-ap23:47.3": "sahassakkhattuṃ rājā ca ",
  "tha-ap23:47.4": "cakkavattī ahosa’haṃ. ",
  "tha-ap23:48.1": "padesarajjaṃ vipulaṃ ",
  "tha-ap23:48.2": "gaṇanāto asaṅkhiyaṃ, ",
  "tha-ap23:48.3": "anubhomi susampattiṃ ",
  "tha-ap23:48.4": "buddhānussatiyā phalaṃ. ",
  "tha-ap23:49.1": "bhāvābhave saṃsaranto ",
  "tha-ap23:49.2": "mahābhogaṃ labhāma’haṃ, ",
  "tha-ap23:49.3": "bhoge me ūnatā natthi ",
  "tha-ap23:49.4": "buddhānussatiyā phalaṃ. ",
  "tha-ap23:50.1": "satasahasse ito kappe ",
  "tha-ap23:50.2": "yaṃ kammamakariṃ tadā, ",
  "tha-ap23:50.3": "duggatiṃ nābhijānāmi ",
  "tha-ap23:50.4": "buddhānussatiyā phalaṃ. ",
  "tha-ap23:51.1": "paṭisambhidā …pe… ",
  "tha-ap23:51.2": "",
  "tha-ap23:51.3": "",
  "tha-ap23:51.4": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap23:52.1": "itthaṃ sudaṃ āyasmā subhūtithero imā gāthāyo abhāsitthāti. ",
  "tha-ap23:53.1": "subhūtittherassāpadānaṃ paṭhamaṃ. "
}
