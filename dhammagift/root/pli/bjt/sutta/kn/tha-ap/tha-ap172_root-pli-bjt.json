{
  "tha-ap172:0.1": "",
  "tha-ap172:0.2": "",
  "tha-ap172:0.3": "170. pañcaṅguliyattherāpadānaṃ. ",
  "tha-ap172:1.1": "tisso nāmāsi bhagavā ",
  "tha-ap172:1.2": "lokajeṭṭho narāsabho, ",
  "tha-ap172:1.3": "pavisantaṃ gandhakuṭiṃ ",
  "tha-ap172:1.4": "vihārakusalaṃ muniṃ. ",
  "tha-ap172:2.1": "sugandhamālamādāya ",
  "tha-ap172:2.2": "agamāsiṃ jinantikaṃ, ",
  "tha-ap172:2.3": "appasaddo’va sambuddhe ",
  "tha-ap172:2.4": "pañcaṅgulimadāsahaṃ. ",
  "tha-ap172:3.1": "dve navute ito kappe ",
  "tha-ap172:3.2": "yaṃ gandhamabhiropayiṃ, ",
  "tha-ap172:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap172:3.4": "pañcaṅgulissidaṃ phalaṃ. ",
  "tha-ap172:4.1": "dve sattatimhi’to kappe ",
  "tha-ap172:4.2": "rājā āsi sayampabho, ",
  "tha-ap172:4.3": "sattaratanasampanno ",
  "tha-ap172:4.4": "cakkavattī mahabbalo. ",
  "tha-ap172:5.1": "paṭisambhidā catasso ",
  "tha-ap172:5.2": "vimokkhāpi ca aṭṭhime, chaḷabhiññā sacchikatā ",
  "tha-ap172:5.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap172:6.1": "itthaṃ sudaṃ āyasmā pañcaṅguliyo thero imā gāthāyo abhāsitthāti. ",
  "tha-ap172:7.1": "pañcaṅguliyattherassa apadānaṃ dasamaṃ. ",
  "tha-ap172:8.1": "uddānaṃ: ",
  "tha-ap172:9.1": "",
  "tha-ap172:10.1": "supāricārī kaṇaverī ",
  "tha-ap172:10.2": "khajjako desapūjako, ",
  "tha-ap172:10.3": "kaṇikāro sappidado ",
  "tha-ap172:10.4": "yūthiko dussadāyako ",
  "tha-ap172:10.5": "mālo ca pañcaṅguliko ",
  "tha-ap172:10.6": "catupaññāsa gāthakāti. supāricariyavaggo sattarasamo. "
}
