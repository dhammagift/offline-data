{
  "tha-ap1:0.1": "suttapiṭake khuddakanikāye apadānapāḷi. paṭhamo bhāgo namo tassa bhagavato arahato sammāsambuddhassa. ",
  "tha-ap1:0.2": "1. buddhavaggo ",
  "tha-ap1:0.3": "1. theraapadāna pāḷi buddhāpadānaṃ. ",
  "tha-ap1:1.1": "",
  "tha-ap1:2.1": "tathāgataṃ jetavane vasantaṃ ",
  "tha-ap1:2.2": "apucchi vedehamunī nataṅgo, ",
  "tha-ap1:2.3": "“sabbaññubuddhā kira nāma honti ",
  "tha-ap1:2.4": "bhavanti te hetūhi kehi vīra?” ",
  "tha-ap1:3.1": "tadā’ha sabbaññuvaro mahesī ",
  "tha-ap1:3.2": "ānandabhaddaṃ madhurassarena, ",
  "tha-ap1:3.3": "ye pubbabuddhesu katādhikārā ",
  "tha-ap1:3.4": "aladdhamokkhā jinasāsanesu. ",
  "tha-ap1:4.1": "teneva sambodhimukhena dhīrā ",
  "tha-ap1:4.2": "ajjhāsayenāpi mahābalena, ",
  "tha-ap1:4.3": "paññāya tejena sutikkhapaññā ",
  "tha-ap1:4.4": "sabbaññubhāvaṃ anupāpuṇanti. ",
  "tha-ap1:5.1": "ahampi pubbabuddhesu ",
  "tha-ap1:5.2": "buddhattamabhipatthayiṃ, ",
  "tha-ap1:5.3": "manasāyeva hutvāna ",
  "tha-ap1:5.4": "dhammarājā asaṅkhiyā. ",
  "tha-ap1:6.1": "atha buddhāpadānāni ",
  "tha-ap1:6.2": "suṇātha suddhamānasā; ",
  "tha-ap1:6.3": "tiṃsapāramisampuṇṇā ",
  "tha-ap1:6.4": "dhammarājā asaṅkhiyā. ",
  "tha-ap1:7.1": "sambodhiṃ buddhaseṭṭhānaṃ ",
  "tha-ap1:7.2": "sasaṅghe lokanāyake, ",
  "tha-ap1:7.3": "dasaṅgulī namassitvā ",
  "tha-ap1:7.4": "sirasā abhivādayiṃ. ",
  "tha-ap1:8.1": "yāvatā buddhakhettesu ",
  "tha-ap1:8.2": "ratanā vijjanta’saṅkhiyā, ",
  "tha-ap1:8.3": "ākāsaṭṭhā ca bhummaṭṭhā ",
  "tha-ap1:8.4": "manasā sabbamāhariṃ. ",
  "tha-ap1:9.1": "tattha rūpiyabhumiyaṃ ",
  "tha-ap1:9.2": "pāsādaṃ māpayiṃ ahaṃ, ",
  "tha-ap1:9.3": "nekabhummaṃ ratanamayaṃ ",
  "tha-ap1:9.4": "ubbiddhaṃ nabhamuggataṃ. ",
  "tha-ap1:10.1": "vicittathambhaṃ sukataṃ ",
  "tha-ap1:10.2": "suvibhattaṃ mahārahaṃ, ",
  "tha-ap1:10.3": "kanakāmayasaṅghāṭaṃ ",
  "tha-ap1:10.4": "toraṇacchattamaṇḍitaṃ. ",
  "tha-ap1:11.1": "paṭhamā veḷuriyā bhūmi ",
  "tha-ap1:11.2": "vimalābbhasamā subhā, ",
  "tha-ap1:11.3": "naḷitī ",
  "tha-ap1:11.4": "jalajākiṇṇavarakañcanabhūmiyā. ",
  "tha-ap1:12.1": "pavāḷaṃsā pavāḷavaṇaṇā ",
  "tha-ap1:12.2": "kāci lohitakā subhā, ",
  "tha-ap1:12.3": "indagopakavaṇṇābhā ",
  "tha-ap1:12.4": "bhūmi obhāsatī disā. ",
  "tha-ap1:13.1": "suvibhattā gharamukhā ",
  "tha-ap1:13.2": "niyyuhā sīhapañjarā, ",
  "tha-ap1:13.3": "caturo vedikā jālagandhāvela ",
  "tha-ap1:13.4": "manoramā. ",
  "tha-ap1:14.1": "nīlā pītā lohitā ",
  "tha-ap1:14.2": "odātā suddhakāḷakā, ",
  "tha-ap1:14.3": "kūṭāgāravarūpetā ",
  "tha-ap1:14.4": "sattaratanabhūsitā. ",
  "tha-ap1:15.1": "olokamayā padumā ",
  "tha-ap1:15.2": "vāḷa-vihagasobhitā, ",
  "tha-ap1:15.3": "nakkhattatārakākiṇṇā ",
  "tha-ap1:15.4": "candasuriyehi maṇḍitā. ",
  "tha-ap1:16.1": "hemajālena sañchannā ",
  "tha-ap1:16.2": "soṇṇa-kiṅkiṇikāyutā, ",
  "tha-ap1:16.3": "vātavegena kūjanti ",
  "tha-ap1:16.4": "soṇṇamālā manoramā. ",
  "tha-ap1:17.1": "mañjeṭṭhakaṃ lohitakaṃ ",
  "tha-ap1:17.2": "pītakaṃ haripiñjaraṃ, ",
  "tha-ap1:17.3": "nānāraṅgehi ",
  "tha-ap1:17.4": "suppītaṃ ",
  "tha-ap1:18.1": "ussitaddhajamāliniṃ. nānā bahū nekasatā ",
  "tha-ap1:18.2": "phaḷikā rajatāmayā, ",
  "tha-ap1:18.3": "maṇimayā lohitaṅkā ",
  "tha-ap1:18.4": "masāragallamayā tathā, ",
  "tha-ap1:18.5": "nānāsayanavicittā ",
  "tha-ap1:18.6": "saṇhakāsikasanthatā. ",
  "tha-ap1:19.1": "kambalā dukūlā cīnā ",
  "tha-ap1:19.2": "pattuṇṇā paṇḍupāvurā, ",
  "tha-ap1:19.3": "vividhattharaṇaṃ sabbaṃ ",
  "tha-ap1:19.4": "manasā paññapesa’haṃ. ",
  "tha-ap1:20.1": "tāsu tāsveva bhūmīsu ",
  "tha-ap1:20.2": "ratanakūṭalaṅkatā, ",
  "tha-ap1:20.3": "maṇiverocanā ukkā ",
  "tha-ap1:20.4": "dhārayantā sutiṭṭhare. ",
  "tha-ap1:21.1": "sobhanti esikāthambhā ",
  "tha-ap1:21.2": "subhā kañcanatoraṇā, ",
  "tha-ap1:21.3": "jamebānadā sāramayā ",
  "tha-ap1:21.4": "atho rajatamayāpi ca. ",
  "tha-ap1:22.1": "nekā sandhi suvibhattā ",
  "tha-ap1:22.2": "kavāṭaggaḷacittitā, ",
  "tha-ap1:22.3": "ubhato puṇṇaghaṭā’nekā ",
  "tha-ap1:22.4": "padumuppalasaṃyutā. ",
  "tha-ap1:23.1": "atīte sabbabuddhe ca ",
  "tha-ap1:23.2": "sasaṃghe lokanāyake, ",
  "tha-ap1:23.3": "pakativaṇṇarūpena ",
  "tha-ap1:23.4": "nimminitvā sasāvake. ",
  "tha-ap1:24.1": "tena dvārena pavisitvā ",
  "tha-ap1:24.2": "sabbe buddhā sasāvakā, ",
  "tha-ap1:24.3": "sabbasovaṇṇaye pīṭhe ",
  "tha-ap1:24.4": "nisinnā ariyamaṇḍalā. ",
  "tha-ap1:25.1": "ye ca etarahi atthi ",
  "tha-ap1:25.2": "buddhā loke anuttarā, ",
  "tha-ap1:25.3": "atītā vattamānā ca ",
  "tha-ap1:25.4": "bhavanaṃ sabbe samāruhuṃ. ",
  "tha-ap1:26.1": "paccekabuddhe nekasate ",
  "tha-ap1:26.2": "sayambhū aparājite, ",
  "tha-ap1:26.3": "atīte vattamāne ca ",
  "tha-ap1:26.4": "bhavanaṃ sabbe samāruhuṃ. ",
  "tha-ap1:27.1": "kapparukkhā bahū atthi ",
  "tha-ap1:27.2": "ye dibbā ye ca mānusā, ",
  "tha-ap1:27.3": "sabbaṃ dussaṃ samāhatvā ",
  "tha-ap1:27.4": "acchādemi ticīvarā. ",
  "tha-ap1:28.1": "khajjaṃ bhojjaṃ sāyanīyaṃ ",
  "tha-ap1:28.2": "sampannaṃ pānabhojanaṃ, ",
  "tha-ap1:28.3": "maṇimaye subhe patte ",
  "tha-ap1:28.4": "sampūretvā adāsahaṃ. ",
  "tha-ap1:29.1": "dibbacakkhusamā hutvā ",
  "tha-ap1:29.2": "maṭṭhacīvarasaṃyutā, ",
  "tha-ap1:29.3": "madhunā sakkharā ceva ",
  "tha-ap1:29.4": "telena madhuphāṇitā. ",
  "tha-ap1:30.1": "tappitā paramannena ",
  "tha-ap1:30.2": "sabbe te ariyamaṇḍalā, ",
  "tha-ap1:30.3": "ratanagabbhaṃ pavisitvā ",
  "tha-ap1:30.4": "kesarīva guhāsayā. ",
  "tha-ap1:31.1": "mahārahamhi sayane ",
  "tha-ap1:31.2": "sīhaseyyamakappayuṃ, ",
  "tha-ap1:31.3": "sampajānā samuddhāya ",
  "tha-ap1:31.4": "sayane pallaṅkamābhujuṃ, ",
  "tha-ap1:32.1": "gocaraṃ sabbabuddhānaṃ ",
  "tha-ap1:32.2": "jhānaratisamappitā. ",
  "tha-ap1:32.3": "aññe dhammāni desenti ",
  "tha-ap1:32.4": "aññe kīḷanti iddhiyā, ",
  "tha-ap1:33.1": "aññe abhiññā appenti ",
  "tha-ap1:33.2": "abhiññāvasibhāvitā, ",
  "tha-ap1:33.3": "vikubbanā vikubbanti ",
  "tha-ap1:33.4": "aññe nekasahassiyo. ",
  "tha-ap1:34.1": "buddhāpi buddhe pucchanti ",
  "tha-ap1:34.2": "visayaṃ sabbaññumālayaṃ, ",
  "tha-ap1:34.3": "gambhīraṃ nipuṇaṃ ṭhānaṃ ",
  "tha-ap1:34.4": "paññāya vinibujjhare. ",
  "tha-ap1:35.1": "sāvakā buddhe pucchanti ",
  "tha-ap1:35.2": "buddhā pucchanti sāvake, ",
  "tha-ap1:35.3": "aññamaññaṃ ca pucchanti ",
  "tha-ap1:35.4": "aññoññaṃ byākaronti te. ",
  "tha-ap1:36.1": "buddhā paccekabuddhā ca ",
  "tha-ap1:36.2": "sāvakā paricārakā, ",
  "tha-ap1:36.3": "evaṃ sakāya ratiyā ",
  "tha-ap1:36.4": "pāsāde’ bhiramanti te. ",
  "tha-ap1:37.1": "chattā tiṭṭhantu ratanā ",
  "tha-ap1:37.2": "kañcanāvelapantikā, ",
  "tha-ap1:37.3": "muttājālaparikkhittā ",
  "tha-ap1:37.4": "sabbe dhārentu matthake. ",
  "tha-ap1:38.1": "bhavantu ceḷavitānā ",
  "tha-ap1:38.2": "soṇṇatārakacittitā, ",
  "tha-ap1:38.3": "vicittamālyavitānā ",
  "tha-ap1:38.4": "sabbe dhārentu matthake. ",
  "tha-ap1:39.1": "vitatā mālyadāmehi ",
  "tha-ap1:39.2": "gandhadāmehi sobhitā, ",
  "tha-ap1:39.3": "dussadāmehi parikiṇṇā ",
  "tha-ap1:39.4": "ratanadāmavibhūsitā. ",
  "tha-ap1:40.1": "pupphābhikiṇṇā sucittā ",
  "tha-ap1:40.2": "surabhigandhadhūpitā, ",
  "tha-ap1:40.3": "gandhapañcaṅgulikatā ",
  "tha-ap1:40.4": "hemacchadanachāditā. ",
  "tha-ap1:41.1": "catuddisā pokkharañño ",
  "tha-ap1:41.2": "padumuppalasanthatā, ",
  "tha-ap1:41.3": "sovaṇṇarūpā khāyantu ",
  "tha-ap1:41.4": "padumareṇurajuggatā. ",
  "tha-ap1:42.1": "pupphantu pādapā sabbe ",
  "tha-ap1:42.2": "pāsādassa samantato, ",
  "tha-ap1:42.3": "sayaṃ ca pupphā muñcitvā ",
  "tha-ap1:42.4": "gantvā bhavanamokiruṃ ",
  "tha-ap1:43.1": "sikhino tattha naccantu ",
  "tha-ap1:43.2": "dibbahaṃsā pakūjare, ",
  "tha-ap1:43.3": "karavīkā ca gāyantu ",
  "tha-ap1:43.4": "dijasaṃghā samantato. ",
  "tha-ap1:44.1": "bheriyo sabbā vajjantu ",
  "tha-ap1:44.2": "vīṇā sabbā ravantu tā, ",
  "tha-ap1:44.3": "sabbā saṃgītī vattantu ",
  "tha-ap1:44.4": "pāsādassa samantato. ",
  "tha-ap1:45.1": "yāvatā buddhakhettamhi ",
  "tha-ap1:45.2": "cakkavāḷe tato pare, ",
  "tha-ap1:45.3": "mahantā jotisampannā ",
  "tha-ap1:45.4": "acchiddā ratanāmayā. ",
  "tha-ap1:46.1": "tiṭṭhantu soṇṇapallaṅkā ",
  "tha-ap1:46.2": "dīparukkhā jalantu te, ",
  "tha-ap1:46.3": "bhavantu ekapajjotā ",
  "tha-ap1:46.4": "dasasahassīparamparā. ",
  "tha-ap1:47.1": "gaṇikā lāsikā ceva ",
  "tha-ap1:47.2": "naccantu accharāgaṇā, ",
  "tha-ap1:47.3": "nānāraṅgā padissantu ",
  "tha-ap1:47.4": "pāsādassa samantato. ",
  "tha-ap1:48.1": "dumagge pabbatagge vā ",
  "tha-ap1:48.2": "sinerugirimuddhani, ",
  "tha-ap1:48.3": "ussāpemi dhajaṃ sabbaṃ ",
  "tha-ap1:48.4": "vicittaṃ pañcavaṇṇikaṃ. ",
  "tha-ap1:49.1": "narā nāgā ca gandhabbā ",
  "tha-ap1:49.2": "sabbe devā upentu te, ",
  "tha-ap1:49.3": "namassantā pañjalikā ",
  "tha-ap1:49.4": "pāsādaṃ parivārayuṃ. ",
  "tha-ap1:50.1": "yaṃ kiñci kusalaṃ kammaṃ ",
  "tha-ap1:50.2": "kattabbaṃ kiriyaṃ mama, ",
  "tha-ap1:50.3": "kāyena vācā manasā ",
  "tha-ap1:50.4": "tidase sukataṃ kataṃ. ",
  "tha-ap1:51.1": "ye sattā saññino atthi ",
  "tha-ap1:51.2": "ye ca sattā asaññino, ",
  "tha-ap1:51.3": "kataṃ puññaphalaṃ mayhaṃ ",
  "tha-ap1:51.4": "sabbe bhāgī bhavantu te. ",
  "tha-ap1:52.1": "yesaṃ kataṃ suviditaṃ ",
  "tha-ap1:52.2": "dinnaṃ puññaphalaṃ mayā, ",
  "tha-ap1:52.3": "ye ca tasmiṃ na jānanti ",
  "tha-ap1:52.4": "devā gantvā nivedayuṃ. ",
  "tha-ap1:53.1": "sabbalokambhi ye sattā ",
  "tha-ap1:53.2": "jīvantā’hārahetukā, ",
  "tha-ap1:53.3": "manuññaṃ bhojanaṃ sabbaṃ ",
  "tha-ap1:53.4": "labhantu mama tejasā. ",
  "tha-ap1:54.1": "manasā dānaṃ mayā dinnaṃ ",
  "tha-ap1:54.2": "manasā pāsādamāvahiṃ, ",
  "tha-ap1:54.3": "pūjitā sabbasambuddhā ",
  "tha-ap1:54.4": "paccekā jinasāvakā. ",
  "tha-ap1:55.1": "tena kammena sukatena ",
  "tha-ap1:55.2": "cetanāpaṇidhīhi ca, ",
  "tha-ap1:55.3": "jahitvā mānusaṃ dehaṃ ",
  "tha-ap1:55.4": "tāvatiṃsamagañchahaṃ. ",
  "tha-ap1:56.1": "duve bhave pajānāmi ",
  "tha-ap1:56.2": "devatte atha mānuse, ",
  "tha-ap1:56.3": "aññaṃ gatiṃ na jānāmi ",
  "tha-ap1:56.4": "manasā patthanāphalaṃ. ",
  "tha-ap1:57.1": "devānaṃ adhiko homi ",
  "tha-ap1:57.2": "bhavāmi manujādhipo, ",
  "tha-ap1:57.3": "rūpalakkhaṇasampanno ",
  "tha-ap1:57.4": "paññāya asamo bhave. ",
  "tha-ap1:58.1": "bhojanaṃ vividhaṃ seṭṭhaṃ ",
  "tha-ap1:58.2": "ratanañca anappakaṃ, ",
  "tha-ap1:58.3": "nānāvidhāni vatthāni ",
  "tha-ap1:58.4": "nabhā khippaṃ upenti maṃ. ",
  "tha-ap1:59.1": "pathavyā pabbate ceva ",
  "tha-ap1:59.2": "ākāse udake vane, ",
  "tha-ap1:59.3": "yaṃ yaṃ hatthaṃ pasāremi ",
  "tha-ap1:59.4": "dibbā bhakkhā upenti maṃ. ",
  "tha-ap1:60.1": "pathavyā pabbate ceva ",
  "tha-ap1:60.2": "ākāse udake vane, ",
  "tha-ap1:60.3": "yaṃ yaṃ hatthaṃ pasāremi ",
  "tha-ap1:60.4": "ratanā sabbe upenti maṃ ",
  "tha-ap1:61.1": "pathavyā ",
  "tha-ap1:61.2": "…pe… ",
  "tha-ap1:61.3": "pasāremi ",
  "tha-ap1:61.4": "sabbe gandhā upenti maṃ. ",
  "tha-ap1:62.1": "pathavyā ",
  "tha-ap1:62.2": "…pe… ",
  "tha-ap1:62.3": "pasāremi ",
  "tha-ap1:62.4": "sabbe yānā upenti maṃ. ",
  "tha-ap1:63.1": "pathavyā ",
  "tha-ap1:63.2": "…pe… ",
  "tha-ap1:63.3": "pasāremi ",
  "tha-ap1:63.4": "sabbā mālā upenti maṃ. ",
  "tha-ap1:64.1": "pathavyā ",
  "tha-ap1:64.2": "…pe… ",
  "tha-ap1:64.3": "pasāremi ",
  "tha-ap1:64.4": "alaṅkārā upenti maṃ. ",
  "tha-ap1:65.1": "pathavyā ",
  "tha-ap1:65.2": "…pe… ",
  "tha-ap1:65.3": "pasāremi ",
  "tha-ap1:65.4": "sabbā kaññā upenti maṃ. ",
  "tha-ap1:66.1": "pathavyā ",
  "tha-ap1:66.2": "…pe… ",
  "tha-ap1:66.3": "pasāremi upenti ",
  "tha-ap1:66.4": "madhusakkharā. pathavyā ",
  "tha-ap1:67.1": "",
  "tha-ap1:67.2": "…pe… ",
  "tha-ap1:67.3": "pasāremi ",
  "tha-ap1:67.4": "sabba khajjā upenti maṃ. ",
  "tha-ap1:68.1": "adhane addhikajane ",
  "tha-ap1:68.2": "yācake ca pathāvino, ",
  "tha-ap1:68.3": "dadāma’haṃ dānavaraṃ ",
  "tha-ap1:68.4": "sambodhivarapattiyā ",
  "tha-ap1:69.1": "nādento pabbataṃ selaṃ ",
  "tha-ap1:69.2": "gajjento bahalaṃ giriṃ, ",
  "tha-ap1:69.3": "sadevalokaṃ hāsento ",
  "tha-ap1:69.4": "buddho loke bhavāma’haṃ. ",
  "tha-ap1:70.1": "disā dasavidhā loke ",
  "tha-ap1:70.2": "yāyato natthi antakaṃ, ",
  "tha-ap1:70.3": "tasmiñca disābhāgambhi ",
  "tha-ap1:70.4": "buddhakkhettā asaṅkhiyā. ",
  "tha-ap1:71.1": "pabhā pakittitā mayhaṃ ",
  "tha-ap1:71.2": "yamakā raṃsivāhanā, ",
  "tha-ap1:71.3": "etthantare raṃsijālaṃ ",
  "tha-ap1:71.4": "āloko vipulo bhave. ",
  "tha-ap1:72.1": "ettake lokadhātumhi ",
  "tha-ap1:72.2": "sabbe passantu maṃ janā, ",
  "tha-ap1:72.3": "sabbe ca sumanā hontu sabbe maṃ anuvattare, (sabbe maṃ anuvattantu ",
  "tha-ap1:72.4": "yāva brahmanivesanaṃ). ",
  "tha-ap1:73.1": "vissaṭṭha madhunādena ",
  "tha-ap1:73.2": "amataṃ bherimāhaniṃ, ",
  "tha-ap1:73.3": "etthantare janā sabbe ",
  "tha-ap1:73.4": "suṇantu madhuraṃ giraṃ. ",
  "tha-ap1:74.1": "dhammameghe pavassante ",
  "tha-ap1:74.2": "sabbe hontu anāsavā, ",
  "tha-ap1:74.3": "ye’ttha pacchimakā sattā ",
  "tha-ap1:74.4": "sotāpannā bhavantu te. ",
  "tha-ap1:75.1": "datvā dātabbakaṃ dānaṃ ",
  "tha-ap1:75.2": "sīlaṃ pūretva’sesato, nekkhamme ",
  "tha-ap1:75.3": "pāramiṃ gantvā ",
  "tha-ap1:75.4": "patto sambodhimuttamaṃ. ",
  "tha-ap1:76.1": "paṇḍite paripucchitvā ",
  "tha-ap1:76.2": "katvā viriyamuttamaṃ, ",
  "tha-ap1:76.3": "khantiyā pāramiṃ gantvā ",
  "tha-ap1:76.4": "patto sambodhimuttamaṃ, ",
  "tha-ap1:77.1": "katvā daḷhamadhiṭṭhānaṃ ",
  "tha-ap1:77.2": "pūretvā saccapāramiṃ, ",
  "tha-ap1:77.3": "mettāya pāramiṃ gantvā ",
  "tha-ap1:77.4": "patto sambodhimuttamaṃ. ",
  "tha-ap1:78.1": "lābhālābhe sukhe dukkhe ",
  "tha-ap1:78.2": "sammāne cāvamānane, ",
  "tha-ap1:78.3": "sabbattha samako hutvā ",
  "tha-ap1:78.4": "patto sambodhimuttamaṃ. ",
  "tha-ap1:79.1": "kosajjaṃ bhayato disvā ",
  "tha-ap1:79.2": "viriyañcāpi khemato, ",
  "tha-ap1:79.3": "āraddhaviriyā hotha ",
  "tha-ap1:79.4": "esā buddhānusāsanī. ",
  "tha-ap1:80.1": "vivādaṃ bhayato disvā ",
  "tha-ap1:80.2": "avivādañca khemato, ",
  "tha-ap1:80.3": "samaggā sakhilā hotha ",
  "tha-ap1:80.4": "esā buddhānusāsanī. ",
  "tha-ap1:81.1": "pamādaṃ bhayato disvā ",
  "tha-ap1:81.2": "appamādaṃ ca khemato, ",
  "tha-ap1:81.3": "bhāvetha’ṭṭhaṅgikaṃ maggaṃ ",
  "tha-ap1:81.4": "esā buddhānusāsanī. ",
  "tha-ap1:82.1": "samāgatā bahū buddhā ",
  "tha-ap1:82.2": "arahantā ca sabbaso, ",
  "tha-ap1:82.3": "sambuddhe arahante ca ",
  "tha-ap1:82.4": "vandamānā namassatha, ",
  "tha-ap1:83.1": "evaṃ acintiyā buddhā ",
  "tha-ap1:83.2": "buddhadhammā acintiyā, ",
  "tha-ap1:83.3": "acintiyesu pasannānaṃ ",
  "tha-ap1:83.4": "vipāko hoti acintiyo. ",
  "tha-ap1:84.1": "itthaṃ sudaṃ bhagavā attano buddacariyaṃ sambhāvayamāno buddhāpadāniyaṃ nāma dhammapariyāyaṃ abhāsitthāti. ",
  "tha-ap1:85.1": "buddhāpadānaṃ samattaṃ. "
}
