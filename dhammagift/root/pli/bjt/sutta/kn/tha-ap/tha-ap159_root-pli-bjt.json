  "tha-ap159:0.1": "",
  "tha-ap159:0.2": "",
  "tha-ap159:0.3": "157. tiṇasūlakattherāpadānaṃ. ",
  "tha-ap159:1.1": "himavantassa avidūre ",
  "tha-ap159:1.2": "bhutagaṇo nāma pabbato, ",
  "tha-ap159:1.3": "vasate’ko jino tattha ",
  "tha-ap159:1.4": "sayambhū lokanissaṭo. ",
  "tha-ap159:2.1": "tiṇasūle gahetvāna ",
  "tha-ap159:2.2": "buddhassa abhiropayiṃ, ",
  "tha-ap159:2.3": "ekūnasatasahassaṃ ",
  "tha-ap159:2.4": "kappaṃ na vinipātiko. ",
  "tha-ap159:3.1": "ito ekādase kappe ",
  "tha-ap159:3.2": "eko’siṃ dharaṇīruho ",
  "tha-ap159:3.3": "sattaratanasampanno ",
  "tha-ap159:3.4": "cakkavattī mahabbalo. ",
  "tha-ap159:4.1": "paṭisambhidā catasso ",
  "tha-ap159:4.2": "vimokkhāpi ca aṭṭhime, chaḷabhiññā sacchikatā ",
  "tha-ap159:4.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap159:5.1": "itthaṃ sudaṃ āyasmā tiṇasūlako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap159:6.1": "tiṇasūlakattherassa apadānaṃ sattamaṃ. "
}
