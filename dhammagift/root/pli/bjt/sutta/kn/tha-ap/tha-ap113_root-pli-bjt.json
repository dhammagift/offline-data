{
  "tha-ap113:0.1": "",
  "tha-ap113:0.2": "12. mahāparivāravaggo ",
  "tha-ap113:0.3": "111. mahāparivārattherāpadānaṃ. ",
  "tha-ap113:1.1": "vipassī nāma bhagavā ",
  "tha-ap113:1.2": "lokajeṭṭho narāsabho, ",
  "tha-ap113:1.3": "aṭṭhasaṭṭhisahassehi ",
  "tha-ap113:1.4": "pāvisī bandhumaṃ tadā. ",
  "tha-ap113:2.1": "nagarā abhinikkhamma ",
  "tha-ap113:2.2": "agamaṃ dīpacetiyaṃ, ",
  "tha-ap113:2.3": "addasaṃ virajaṃ buddhaṃ ",
  "tha-ap113:2.4": "āhutīnaṃ paṭiggahaṃ. ",
  "tha-ap113:3.1": "cullāsītisahassāni ",
  "tha-ap113:3.2": "yakkhā mayhaṃ upantike, ",
  "tha-ap113:3.3": "upaṭṭhahanti sakkaccaṃ ",
  "tha-ap113:3.4": "indaṃ’va tidasā gaṇā. ",
  "tha-ap113:4.1": "bhavanā abhinikkhamma ",
  "tha-ap113:4.2": "dussaṃ paggayha’haṃ tadā, ",
  "tha-ap113:4.3": "sirasā abhivādesiṃ ",
  "tha-ap113:4.4": "taṃ vādāsiṃ mahesino. ",
  "tha-ap113:5.1": "“aho buddho aho dhammo ",
  "tha-ap113:5.2": "aho no satthusampadā ",
  "tha-ap113:5.3": "buddhassa ānubhāvena ",
  "tha-ap113:5.4": "vasudhā’yaṃ pakampatha. ",
  "tha-ap113:6.1": "taṃ ca acchariyaṃ disvā ",
  "tha-ap113:6.2": "abbhutaṃ lomahaṃsanaṃ, ",
  "tha-ap113:6.3": "buddhe cittaṃ pasādesiṃ ",
  "tha-ap113:6.4": "dipadindamhi tādine. ",
  "tha-ap113:7.1": "sohaṃ cittaṃ pasādetvā ",
  "tha-ap113:7.2": "dussaṃ datvāna satthuno, ",
  "tha-ap113:7.3": "saraṇañca upāgañchiṃ ",
  "tha-ap113:7.4": "sāmacco saparijjano. ",
  "tha-ap113:8.1": "ekanavute ito kappe ",
  "tha-ap113:8.2": "yaṃ kammamakariṃ tadā, ",
  "tha-ap113:8.3": "duggatiṃ nābhijānāmi ",
  "tha-ap113:8.4": "buddhapūjāyidaṃ phalaṃ. ",
  "tha-ap113:9.1": "ito paṇṇarase kappe ",
  "tha-ap113:9.2": "soḷasā’suṃ suvāhanā, ",
  "tha-ap113:9.3": "sattaratanasampannā ",
  "tha-ap113:9.4": "cakkavattī mahabbalā. ",
  "tha-ap113:10.1": "paṭisambhidā …pe… ",
  "tha-ap113:10.2": "",
  "tha-ap113:10.3": "",
  "tha-ap113:10.4": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap113:11.1": "itthaṃ sudaṃ āyasmā mahāparivāro thero imā gāthāyo abhāsitthāti. ",
  "tha-ap113:12.1": "mahāparivārattherassa apadānaṃ paṭhamaṃ. "
}
