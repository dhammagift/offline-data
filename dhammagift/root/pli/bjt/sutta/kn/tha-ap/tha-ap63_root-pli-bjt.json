{
  "tha-ap63:0.1": "",
  "tha-ap63:0.2": "7. sakavittaniyavaggo ",
  "tha-ap63:0.3": "61. sakacintaniyattherāpadānaṃ ",
  "tha-ap63:1.1": "pavanaṃ kānanaṃ disvā ",
  "tha-ap63:1.2": "appasadadamanāvilaṃ, ",
  "tha-ap63:1.3": "isīnaṃ anuciṇṇaṃva ",
  "tha-ap63:1.4": "āhutīnaṃ paṭiggahaṃ. ",
  "tha-ap63:2.1": "thūpaṃ katvāna pulinaṃ ",
  "tha-ap63:2.2": "nānāpupphaṃ samokiriṃ. ",
  "tha-ap63:2.3": "sammukhā viya sambuddhaṃ ",
  "tha-ap63:2.4": "nimmitaṃ abhivandahaṃ. ",
  "tha-ap63:3.1": "sattaratanasampanno ",
  "tha-ap63:3.2": "rājā raṭṭhamhi issaro, ",
  "tha-ap63:3.3": "sakakammābhiraddho’haṃ ",
  "tha-ap63:3.4": "thūpapūjāyidaṃ phalaṃ. ",
  "tha-ap63:4.1": "ekanavute ito kappe ",
  "tha-ap63:4.2": "yaṃ pupphambhiropayiṃ, ",
  "tha-ap63:4.3": "duggatiṃ nābhijānāmi ",
  "tha-ap63:4.4": "thūpapūjāyidaṃ phalaṃ. ",
  "tha-ap63:5.1": "asītikappe’nantayaso ",
  "tha-ap63:5.2": "cakkavattī ahosahaṃ, ",
  "tha-ap63:5.3": "sattaratanasampanno ",
  "tha-ap63:5.4": "catudīpamhi issaro. 1354 ",
  "tha-ap63:6.1": "paṭisambhidā …pe… ",
  "tha-ap63:6.2": "",
  "tha-ap63:6.3": "",
  "tha-ap63:6.4": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap63:7.1": "itthaṃ sudaṃ āyasmā sakavittaniyo thero imā gāthāyo abhāsitthāti. ",
  "tha-ap63:8.1": "sakavittaniyattherassa apadānaṃ paṭhamaṃ. "
}
