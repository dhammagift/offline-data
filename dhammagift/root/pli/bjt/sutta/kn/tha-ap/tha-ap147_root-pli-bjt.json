{
  "tha-ap147:0.1": "",
  "tha-ap147:0.2": "",
  "tha-ap147:0.3": "145. ummāpupphiyatherāpadānaṃ. ",
  "tha-ap147:1.1": "nibbute lokanāthambhi ",
  "tha-ap147:1.2": "ahutīnaṃ paṭiggahe, ",
  "tha-ap147:1.3": "siddhatthamhi bhagavati ",
  "tha-ap147:1.4": "mahāthūpamaho ahu. ",
  "tha-ap147:2.1": "mahe pavattamānambhi ",
  "tha-ap147:2.2": "siddhatthassa mahesino, ",
  "tha-ap147:2.3": "ummāpupphaṃ gahetvāna ",
  "tha-ap147:2.4": "thūpamhi abhiropayiṃ. ",
  "tha-ap147:3.1": "catunavute ito kappe ",
  "tha-ap147:3.2": "yaṃ pupphamabhiropayiṃ, ",
  "tha-ap147:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap147:3.4": "thūpapūjāyidaṃ phalaṃ. ",
  "tha-ap147:4.1": "ito ca navame kappe ",
  "tha-ap147:4.2": "somadevasanāmakā, ",
  "tha-ap147:4.3": "pañcāsīti ‘su rājāno ",
  "tha-ap147:4.4": "cakkavattī mahabbalā. ",
  "tha-ap147:5.1": "paṭisambhidā ",
  "tha-ap147:5.2": "…pe… ",
  "tha-ap147:5.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap147:6.1": "itthaṃ sudaṃ āyasmā ummāpupphiyo thero imā gāthāyo abhāsitthāti. ",
  "tha-ap147:7.1": "ummāpupphiyattherassa apadānaṃ pañcamaṃ. "
}
