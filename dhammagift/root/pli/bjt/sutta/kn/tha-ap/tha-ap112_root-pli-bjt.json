{
  "tha-ap112:0.1": "",
  "tha-ap112:0.2": "",
  "tha-ap112:0.3": "110. reṇupūjakattherāpadānaṃ. ",
  "tha-ap112:1.1": "suvaṇṇavaṇṇaṃ sambuddhaṃ ",
  "tha-ap112:1.2": "sataraṃsiṃ’va bhānumaṃ, ",
  "tha-ap112:1.3": "obhāsentaṃ disā sabbā ",
  "tha-ap112:1.4": "uḷurājaṃ’va pūritaṃ. ",
  "tha-ap112:2.1": "purakkhataṃ sāvakehi ",
  "tha-ap112:2.2": "sāgarehe’va mediniṃ, ",
  "tha-ap112:2.3": "nāgaṃ paggayha reṇūhi ",
  "tha-ap112:2.4": "vipassissābhiropayiṃ. ",
  "tha-ap112:3.1": "ekanavute ito kappe ",
  "tha-ap112:3.2": "yaṃ reṇumabhiropayiṃ, ",
  "tha-ap112:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap112:3.4": "buddhapūjāyidaṃ phalaṃ. ",
  "tha-ap112:4.1": "paṇṇatāḷīsito kappe ",
  "tha-ap112:4.2": "reṇu nāmāsi khattiyo, ",
  "tha-ap112:4.3": "sattaratanasampanno ",
  "tha-ap112:4.4": "cakkavattī mahabbalo. ",
  "tha-ap112:5.1": "paṭisambhidā catasso ",
  "tha-ap112:5.2": "vimokkhāpi ca aṭṭhime, chaḷabhiññā sacchikatā ",
  "tha-ap112:5.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap112:6.1": "itthaṃ sudaṃ āyasmā reṇupūjako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap112:7.1": "reṇupūjakattherassa apadānaṃ dasamaṃ. ",
  "tha-ap112:8.1": "uddānaṃ: ",
  "tha-ap112:9.1": "",
  "tha-ap112:10.1": "bhikkhādāyī ñāṇasaññī ",
  "tha-ap112:10.2": "hatthiyo padapūjako, ",
  "tha-ap112:10.3": "muṭṭhipupphi udakado ",
  "tha-ap112:10.4": "naḷamālī upaṭṭhako ",
  "tha-ap112:10.5": "biḷālidāyī reṇu ca ",
  "tha-ap112:10.6": "gāthāyo cha ca saṭṭhi ca. bhikkhādāyīvaggo ekādasamo. "
}
