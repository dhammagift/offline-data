{
  "tha-ap553:0.1": "",
  "tha-ap553:0.2": "56. yasavaggo ",
  "tha-ap553:0.3": "551. yasattherāpadānaṃ ",
  "tha-ap553:1.1": "mahāsamuddaṃ ogayha ",
  "tha-ap553:1.2": "bhavanaṃ me sunimmitaṃ, ",
  "tha-ap553:1.3": "sunimmitā pokkharaṇī ",
  "tha-ap553:1.4": "cakkavākūpakūjitā. ",
  "tha-ap553:2.1": "mandālakehi sañchannā ",
  "tha-ap553:2.2": "padumuppalakehi ca, ",
  "tha-ap553:2.3": "nadī ca sandate tattha ",
  "tha-ap553:2.4": "supatitthā manoramā. ",
  "tha-ap553:3.1": "macchakacchapasañchannā ",
  "tha-ap553:3.2": "nānādijasamākulā, ",
  "tha-ap553:3.3": "mayūrakoñcābhirudā ",
  "tha-ap553:3.4": "kokilādibhi vagguhi. ",
  "tha-ap553:4.1": "pārevatā ravihaṃsā ",
  "tha-ap553:4.2": "cakkavākā nadīcarā, ",
  "tha-ap553:4.3": "dindibhā sāḷikā cettha ",
  "tha-ap553:4.4": "pampakā jīvaṃjīvakā. ",
  "tha-ap553:5.1": "haṃsā koñcābhinaditā ",
  "tha-ap553:5.2": "kosiyā piṅgalā bahū, ",
  "tha-ap553:5.3": "sattaratanasampannā ",
  "tha-ap553:5.4": "maṇimuttikavālikā. ",
  "tha-ap553:6.1": "sabbe soṇṇamayā rukkhā ",
  "tha-ap553:6.2": "nānāgandhasameritā, ",
  "tha-ap553:6.3": "ujjotenti divārattiṃ ",
  "tha-ap553:6.4": "bhavanaṃ sabbakālikaṃ. ",
  "tha-ap553:7.1": "saṭṭhituriyasahassāni ",
  "tha-ap553:7.2": "sāyaṃ pāto pavajjare, ",
  "tha-ap553:7.3": "soḷasitthisahassāni ",
  "tha-ap553:7.4": "parivārenti maṃ sadā. ",
  "tha-ap553:8.1": "abhinikkhamma bhavanā ",
  "tha-ap553:8.2": "sumedhaṃ lokanāyakaṃ, ",
  "tha-ap553:8.3": "pasannacitto sumano ",
  "tha-ap553:8.4": "vandayiṃ taṃ mahāyasaṃ. ",
  "tha-ap553:9.1": "sambuddhaṃ abhivādetvā ",
  "tha-ap553:9.2": "sasaṅghaṃ taṃ nimantayiṃ, ",
  "tha-ap553:9.3": "adhivāsesi so dhīro ",
  "tha-ap553:9.4": "sumedho lokanāyako. ",
  "tha-ap553:10.1": "mama dhammakathaṃ katvā ",
  "tha-ap553:10.2": "uyyojesi mahāmuni, ",
  "tha-ap553:10.3": "sambuddhaṃ abhivādetvā ",
  "tha-ap553:10.4": "bhavanaṃ me upāgamiṃ. ",
  "tha-ap553:11.1": "āmantayiṃ parijanaṃ ",
  "tha-ap553:11.2": "sabbe sannipatuṃ tadā, ",
  "tha-ap553:11.3": "pubbanhasamayaṃ buddho ",
  "tha-ap553:11.4": "bhavanaṃ āgamissati. ",
  "tha-ap553:12.1": "lābhā amhaṃ suladdhā no ",
  "tha-ap553:12.2": "ye vasāma tavantike, ",
  "tha-ap553:12.3": "mayampi buddhaseṭṭhassa ",
  "tha-ap553:12.4": "pūjayissāma satthuno. ",
  "tha-ap553:13.1": "annaṃ pānaṃ paṭṭhapetvā ",
  "tha-ap553:13.2": "kālaṃ ārocayiṃ ahaṃ, ",
  "tha-ap553:13.3": "vasīsatasahassehi ",
  "tha-ap553:13.4": "upesi lokanāyako. ",
  "tha-ap553:14.1": "pañcaṅgikehi turiyehi ",
  "tha-ap553:14.2": "paccuggamamakāsahaṃ, ",
  "tha-ap553:14.3": "sabbasoṇṇamaye pīṭhe ",
  "tha-ap553:14.4": "nisīdi purisuttamo. ",
  "tha-ap553:15.1": "uparicchadanaṃ āsi ",
  "tha-ap553:15.2": "sabbasoṇṇamayaṃ tadā, ",
  "tha-ap553:15.3": "vījaniyo pavāyanti ",
  "tha-ap553:15.4": "bhikkhusaṅghaṃ anuttaraṃ. ",
  "tha-ap553:16.1": "pahūtenannapānena ",
  "tha-ap553:16.2": "bhikkhusaṅghaṃ atappayiṃ, ",
  "tha-ap553:16.3": "paccekadussayugale ",
  "tha-ap553:16.4": "bhikkhusaṅghassadāhaṃ. ",
  "tha-ap553:17.1": "yaṃ vadanti sumedhoti ",
  "tha-ap553:17.2": "āhutīnaṃ paṭiggaho, ",
  "tha-ap553:17.3": "bhikkhu saṅghe nisīditvā ",
  "tha-ap553:17.4": "imā gāthā abhāsatha: ",
  "tha-ap553:18.1": "“yo me annena pānena ",
  "tha-ap553:18.2": "sabbe ime ca tappayi, ",
  "tha-ap553:18.3": "tamahaṃ kittayissāmi ",
  "tha-ap553:18.4": "suṇātha mama bhāsato: ",
  "tha-ap553:19.1": "aṭṭhārase kappasate ",
  "tha-ap553:19.2": "devaloke ramissati, ",
  "tha-ap553:19.3": "sahassakkhattuṃ rājāyaṃ ",
  "tha-ap553:19.4": "cakkavattī bhavissati. ",
  "tha-ap553:20.1": "upagacchati yaṃ yoniṃ ",
  "tha-ap553:20.2": "devattaṃ athamānusaṃ, ",
  "tha-ap553:20.3": "sabbasoṇṇamayaṃ tassa ",
  "tha-ap553:20.4": "chadanaṃ dhārayissati. ",
  "tha-ap553:21.1": "tiṃsakappasahassamhi ",
  "tha-ap553:21.2": "okkākakulasambhavo, ",
  "tha-ap553:21.3": "gotamo nāma nāmena ",
  "tha-ap553:21.4": "satthā loke bhavissati. ",
  "tha-ap553:22.1": "tassa dhammesu dāyādo ",
  "tha-ap553:22.2": "oraso dhammanimmito, ",
  "tha-ap553:22.3": "sabbāsave pariññāya ",
  "tha-ap553:22.4": "nibbāyissatanāsavo. bhikkhu ",
  "tha-ap553:23.1": "saṅghe nisīditvā ",
  "tha-ap553:23.2": "sīhanādaṃ nadissati, ",
  "tha-ap553:23.3": "citake chattaṃ dhārenti ",
  "tha-ap553:23.4": "heṭṭhā chattamhi ḍayhatha.” ",
  "tha-ap553:24.1": "sāmaññaṃ me anuppattaṃ ",
  "tha-ap553:24.2": "kilesā jhāpitā mayā, ",
  "tha-ap553:24.3": "maṇḍape rukkhamūle vā ",
  "tha-ap553:24.4": "santāso me na vijjati. ",
  "tha-ap553:25.1": "tiṃsa kappasahassamhi ",
  "tha-ap553:25.2": "yaṃ dānamadadiṃ tadā, ",
  "tha-ap553:25.3": "duggatiṃ nābhājānāmi ",
  "tha-ap553:25.4": "sabbadānassidaṃ phalaṃ. ",
  "tha-ap553:26.1": "kilesā jhāpitā mayhaṃ ",
  "tha-ap553:26.2": "bhavā sabbe samūhatā, ",
  "tha-ap553:26.3": "nāgo’va bandhanaṃ chetvā ",
  "tha-ap553:26.4": "viharāmi anāsavo. ",
  "tha-ap553:27.1": "svāgataṃ vata me āsi ",
  "tha-ap553:27.2": "buddhaseṭṭhassa santike, ",
  "tha-ap553:27.3": "tisso vijjā anuppattā ",
  "tha-ap553:27.4": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap553:28.1": "paṭisambhidā catasso ",
  "tha-ap553:28.2": "ca vimokkhā pi ca aṭṭhime, ",
  "tha-ap553:28.3": "chaḷabhiññā sacchikatā ",
  "tha-ap553:28.4": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap553:29.1": "itthaṃ sudaṃ āyasmā yaso thero imā gāthāyo abhāsitthāti. ",
  "tha-ap553:30.1": "yasattherassāpadānaṃ paṭhamaṃ. "
}
