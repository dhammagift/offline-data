{
  "tha-ap137:0.1": "",
  "tha-ap137:0.2": "",
  "tha-ap137:0.3": "135. rahosaññakattherāpadānaṃ ",
  "tha-ap137:1.1": "himavantassāvidūre ",
  "tha-ap137:1.2": "vasabho nāma pabbato, ",
  "tha-ap137:1.3": "tasmiṃ pabbatapādamhi ",
  "tha-ap137:1.4": "assamo āsi māpito. ",
  "tha-ap137:2.1": "tīṇi sissasahassāni ",
  "tha-ap137:2.2": "vācesiṃ brāhmaṇo tadā, ",
  "tha-ap137:2.3": "saṃharitvāna te sisse ",
  "tha-ap137:2.4": "ekamantaṃ upāvisiṃ. ",
  "tha-ap137:3.1": "ekamantaṃ nisīditvā ",
  "tha-ap137:3.2": "brāhmaṇo mantapāragū, ",
  "tha-ap137:3.3": "buddhavedaṃ gavesanto ",
  "tha-ap137:3.4": "ñāṇe cittaṃ pasādayiṃ. ",
  "tha-ap137:4.1": "tattha cittaṃ pasādetvā ",
  "tha-ap137:4.2": "nisīdiṃ paṇṇasanthare, ",
  "tha-ap137:4.3": "pallaṅkamābhujitvāna ",
  "tha-ap137:4.4": "tattha kālakato ahaṃ. ",
  "tha-ap137:5.1": "ekatiṃse ito kappe ",
  "tha-ap137:5.2": "yaṃ saññamalabhiṃ tadā, ",
  "tha-ap137:5.3": "duggatiṃ nābhijānāmi ",
  "tha-ap137:5.4": "ñāṇasaññāyidaṃ phalaṃ. ",
  "tha-ap137:6.1": "sattavīsatikappamhi ",
  "tha-ap137:6.2": "rājā siridharo ahuṃ, ",
  "tha-ap137:6.3": "sattaratanasampanno ",
  "tha-ap137:6.4": "cakkavattī mahabbalo. ",
  "tha-ap137:7.1": "paṭisambhidā ",
  "tha-ap137:7.2": "…pe… ",
  "tha-ap137:7.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap137:8.1": "itthaṃ sudaṃ āyasmā rahosaññako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap137:9.1": "rahosaññakattherassa apadānaṃ pañcamaṃ. "
}
