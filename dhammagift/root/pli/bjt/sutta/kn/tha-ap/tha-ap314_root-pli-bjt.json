{
  "tha-ap314:0.1": "",
  "tha-ap314:0.2": "",
  "tha-ap314:0.3": "312. bhojanadāyakattherāpadānaṃ. ",
  "tha-ap314:1.1": "sujāto sālalaṭṭhīva ",
  "tha-ap314:1.2": "sobhañjanamivuggato, ",
  "tha-ap314:1.3": "indalaṭṭhirivākāse ",
  "tha-ap314:1.4": "virocati sadā jino. ",
  "tha-ap314:2.1": "tassa devātidevassa ",
  "tha-ap314:2.2": "vessabhussa mahesino, ",
  "tha-ap314:2.3": "adāsiṃ bhojanamahaṃ ",
  "tha-ap314:2.4": "vippasannena cetasā. ",
  "tha-ap314:3.1": "taṃ me buddho anumodi ",
  "tha-ap314:3.2": "sayambhū aparājito, ",
  "tha-ap314:3.3": "‘bhave nibbattamānamhi ",
  "tha-ap314:3.4": "phalaṃ nibbattatū tava.’ ",
  "tha-ap314:4.1": "ekatiṃse ito kappe ",
  "tha-ap314:4.2": "yaṃ dānamadadiṃ tadā, ",
  "tha-ap314:4.3": "duggatiṃ nābhijānāmi ",
  "tha-ap314:4.4": "bhojanassa idaṃ phalaṃ. ",
  "tha-ap314:5.1": "pañcavīse ito kappe ",
  "tha-ap314:5.2": "eko āsiṃ amittabho, ",
  "tha-ap314:5.3": "sattaratanasampanno ",
  "tha-ap314:5.4": "cakkavattī mahabbalo. ",
  "tha-ap314:6.1": "paṭisambhidā catasso ",
  "tha-ap314:6.2": "vimokkhāpi ca aṭṭhime, chaḷabhiññā sacchikatā ",
  "tha-ap314:6.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap314:7.1": "itthaṃ sudaṃ āyasmā bhojanadāyako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap314:8.1": "bhojanadāyakattherassa apadānaṃ dutiyaṃ. "
}
