{
  "tha-ap387:0.1": "",
  "tha-ap387:0.2": "",
  "tha-ap387:0.3": "385. phārusaphaladāyakattherāpadānaṃ ",
  "tha-ap387:1.1": "suvaṇṇavaṇṇaṃ sambuddhaṃ ",
  "tha-ap387:1.2": "āhutīnaṃ paṭiggahaṃ, ",
  "tha-ap387:1.3": "rathiyaṃ paṭipajjantaṃ ",
  "tha-ap387:1.4": "phārusaphalamadāsahaṃ. ",
  "tha-ap387:2.1": "ekanavute ito kappe ",
  "tha-ap387:2.2": "yaṃ phalamadadiṃ ahaṃ, ",
  "tha-ap387:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap387:2.4": "phaladānassidaṃ phalaṃ. ",
  "tha-ap387:3.1": "",
  "tha-ap387:3.2": "",
  "tha-ap387:3.3": "",
  "tha-ap387:4.1": "svāgataṃ vata me āsi ",
  "tha-ap387:4.2": "buddhaseṭṭhassa santike, tisso vijjā anuppattā ",
  "tha-ap387:4.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap387:5.1": "kilesā jhāpitā mayhaṃ bhavā sabbe samūhatā, nāgova bandhanaṃ chetvā viharāmi anāsavo. paṭisambhidā catasso ",
  "tha-ap387:5.2": "vimokkhāpi ca aṭṭhime, chaḷabhiññā sacchikatā ",
  "tha-ap387:5.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap387:6.1": "itthaṃ sudaṃ āyasmā phārusaphaladāyako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap387:7.1": "phārusaphaladāyakattherassa apadānaṃ pañcamaṃ. "
}
