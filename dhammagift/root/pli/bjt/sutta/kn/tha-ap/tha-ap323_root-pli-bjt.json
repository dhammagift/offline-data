{
  "tha-ap323:0.1": "ārakkhadāyakavaggo battiṃsatimo. ",
  "tha-ap323:0.2": "33. ummāpupphiyavaggo ",
  "tha-ap323:0.3": "321. ummāpupphiyattherāpadānaṃ ",
  "tha-ap323:1.1": "samāhitaṃ samāpannaṃ ",
  "tha-ap323:1.2": "siddhatthamaparājitaṃ, ",
  "tha-ap323:1.3": "samādhinā upaviṭṭhaṃ ",
  "tha-ap323:1.4": "addasāhaṃ naruttamaṃ. ",
  "tha-ap323:2.1": "ummāpupphaṃ gahetvāna ",
  "tha-ap323:2.2": "buddhassa abhiropayiṃ, ",
  "tha-ap323:2.3": "sabbe pupphā ekasīsā ",
  "tha-ap323:2.4": "uddhavaṇṭā adhomukhā. ",
  "tha-ap323:3.1": "sucittā viya tiṭṭhante ",
  "tha-ap323:3.2": "ākāse pupphasanthare, ",
  "tha-ap323:3.3": "tena cittappasādena ",
  "tha-ap323:3.4": "tusitaṃ upapajjahaṃ. ",
  "tha-ap323:4.1": "catunavute ito kappe ",
  "tha-ap323:4.2": "yaṃ pupphamabhipūjayiṃ, ",
  "tha-ap323:4.3": "duggatiṃ nābhijānāmi ",
  "tha-ap323:4.4": "buddhapūjāyidaṃ phalaṃ. ",
  "tha-ap323:5.1": "pañcapaññāsito kappe ",
  "tha-ap323:5.2": "eko āsiṃ mahīpati, ",
  "tha-ap323:5.3": "samantacchadano nāma ",
  "tha-ap323:5.4": "cakkavattī mahabbalo. ",
  "tha-ap323:6.1": "paṭisambhidā catasso ",
  "tha-ap323:6.2": "vimokkhāpi ca aṭṭhime, ",
  "tha-ap323:6.3": "chaḷabhiññā sacchikatā ",
  "tha-ap323:6.4": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap323:7.1": "itthaṃ sudaṃ āyasmā ummāpupphiyo thero imā gāthāyo abhāsitthāti. ",
  "tha-ap323:8.1": "ummāpupphiyattherassa apadānaṃ paṭhamaṃ. "
}
