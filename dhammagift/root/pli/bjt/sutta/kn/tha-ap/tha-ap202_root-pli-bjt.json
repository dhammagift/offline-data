{
  "tha-ap202:0.1": "",
  "tha-ap202:0.2": "",
  "tha-ap202:0.3": "200. yūthikāpupphiyattherāpadānaṃ ",
  "tha-ap202:1.1": "padumuttaro nāma jino ",
  "tha-ap202:1.2": "āhutīnaṃ paṭiggaho, ",
  "tha-ap202:1.3": "pavanā kikkhamitvāna ",
  "tha-ap202:1.4": "vihāraṃ yāti cakkhumā. ",
  "tha-ap202:2.1": "ubho hatthehi paggayha ",
  "tha-ap202:2.2": "yūthikaṃ pupphamuttamaṃ, ",
  "tha-ap202:2.3": "buddhassa abhiropesiṃ ",
  "tha-ap202:2.4": "mettacittassa tādino. ",
  "tha-ap202:3.1": "tena cittappasādena ",
  "tha-ap202:3.2": "abhibhotvāna sampadā, ",
  "tha-ap202:3.3": "kappānaṃ satasahassaṃ ",
  "tha-ap202:3.4": "duggatiṃ nūpapajjahaṃ. ",
  "tha-ap202:4.1": "ito paññāsakappesu ",
  "tha-ap202:4.2": "eko āsiṃ janādhipo, ",
  "tha-ap202:4.3": "samittanandano nāma ",
  "tha-ap202:4.4": "cakkavattī mahabbalo. ",
  "tha-ap202:5.1": "paṭisambhidā catasso ",
  "tha-ap202:5.2": "vimokkhāpi ca aṭṭhime, chaḷabhiññā sacchikatā ",
  "tha-ap202:5.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap202:6.1": "itthaṃ sudaṃ āyasmā yūthikāpupphiyo thero imā gāthāyo abhāsitthāti. ",
  "tha-ap202:7.1": "yūthikāpupphiyattherassa apadānaṃ dasamaṃ. ",
  "tha-ap202:7.2": "uddānaṃ: tamālī ",
  "tha-ap202:8.1": "tiṇasanthāro ",
  "tha-ap202:9.1": "",
  "tha-ap202:9.2": "khaṇḍaphullī asokiyo ",
  "tha-ap202:9.3": "aṅkolakī kisalayo ",
  "tha-ap202:9.4": "tinduko nelapupphiyo ",
  "tha-ap202:9.5": "kiṅkaṇiko yūthiko ca ",
  "tha-ap202:9.6": "gāthā paññāsa aṭṭha ca. tamālapupphiyavaggo vīsatimo. ",
  "tha-ap202:10.1": "atha vagguddānaṃ: ",
  "tha-ap202:11.1": "bhikkhādāyī parivāro ",
  "tha-ap202:11.2": "sereyyo sobhito tathā ",
  "tha-ap202:11.3": "chatto ca bandhujīvo ca ",
  "tha-ap202:11.4": "supāricariyopi ca ",
  "tha-ap202:12.1": "kumudo kuṭajo ceva ",
  "tha-ap202:12.2": "tamālī dasamo kato. ",
  "tha-ap202:12.3": "chasatāni ca gāthānaṃ ",
  "tha-ap202:12.4": "chasaṭṭhi ca tatuttariṃ. ",
  "tha-ap202:13.1": "bhikkhāvaggadasakaṃ. ",
  "tha-ap202:14.1": "dutiyaṃ satakaṃ samattaṃ. "
}
