{
  "tha-ap433:0.1": "",
  "tha-ap433:0.2": "44. ekavihārivaggo ",
  "tha-ap433:0.3": "431. ekavihāriyattherāpadānaṃ ",
  "tha-ap433:1.1": "imamhi bhaddake kappe ",
  "tha-ap433:1.2": "brahmabandhu mahāyaso, ",
  "tha-ap433:1.3": "kassapo nāma gottena ",
  "tha-ap433:1.4": "uppajji vadataṃ varo. ",
  "tha-ap433:2.1": "nippapañco nirālambo ",
  "tha-ap433:2.2": "ākāsasamamānaso, ",
  "tha-ap433:2.3": "suññatābahulo tādī ",
  "tha-ap433:2.4": "animittarato vasī. ",
  "tha-ap433:3.1": "asaṅgacitto nikleso ",
  "tha-ap433:3.2": "asaṃsaṭṭho kule gaṇe, ",
  "tha-ap433:3.3": "mahākāruṇiko vīro ",
  "tha-ap433:3.4": "vinayopāyakovido. ",
  "tha-ap433:4.1": "uyyutto parakiccesu ",
  "tha-ap433:4.2": "vinayanto sadevake, ",
  "tha-ap433:4.3": "nibbānagamanaṃ maggaṃ ",
  "tha-ap433:4.4": "gatipaṅkavisosanaṃ. ",
  "tha-ap433:5.1": "amataṃ paramassādaṃ ",
  "tha-ap433:5.2": "jarāmaccunivāraṇaṃ, ",
  "tha-ap433:5.3": "mahāparisamajjhe so ",
  "tha-ap433:5.4": "nisinno lokatāraṇo. ",
  "tha-ap433:6.1": "karavīkaruto nātho ",
  "tha-ap433:6.2": "brahmaghoso tathāgato, ",
  "tha-ap433:6.3": "uddharanto mahāduggā ",
  "tha-ap433:6.4": "vipannaddhe anāyake, ",
  "tha-ap433:7.1": "desento virajaṃ dhammaṃ ",
  "tha-ap433:7.2": "diṭṭho me lokanāyako, ",
  "tha-ap433:7.3": "tassa dhammaṃ suṇitvāna ",
  "tha-ap433:7.4": "pabbajiṃ anagāriyaṃ. ",
  "tha-ap433:8.1": "pabbajitvā tadā cāhaṃ ",
  "tha-ap433:8.2": "cintento jinasāsanaṃ, ",
  "tha-ap433:8.3": "ekakova vane ramme ",
  "tha-ap433:8.4": "vasiṃ saṃsaggapīḷito. ",
  "tha-ap433:9.1": "sakāyavupakasso me ",
  "tha-ap433:9.2": "hetubhuto mahābhavi, ",
  "tha-ap433:9.3": "manaso vūpakassassa ",
  "tha-ap433:9.4": "saṃsaggabhayadassino. ",
  "tha-ap433:10.1": "kilesā jhāpitā mayhaṃ ",
  "tha-ap433:10.2": "bhavā sabbe samūhatā, ",
  "tha-ap433:10.3": "nāgova bandhanaṃ chetvā ",
  "tha-ap433:10.4": "viharāmi anāsavo. ",
  "tha-ap433:11.1": "svāgataṃ vata me āsi ",
  "tha-ap433:11.2": "buddhaseṭṭhassa santike, ",
  "tha-ap433:11.3": "tisso vijjā anuppattā ",
  "tha-ap433:11.4": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap433:12.1": "paṭisambhidā catasso ca ",
  "tha-ap433:12.2": "vimokkhāpi ca aṭṭhime, ",
  "tha-ap433:12.3": "chaḷabhiññā sacchikatā ",
  "tha-ap433:12.4": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap433:13.1": "itthaṃ sudaṃ āyasmā ekavihāriyo thero imā gāthāyo abhāsitthāti. ",
  "tha-ap433:14.1": "ekavihāriyattherassa apadānaṃ paṭhamaṃ. "
}
