{
  "tha-ap379:0.1": "",
  "tha-ap379:0.2": "",
  "tha-ap379:0.3": "377. citakapūjakattherāpadānaṃ. ",
  "tha-ap379:1.1": "parinibbute bhagavati ",
  "tha-ap379:1.2": "jalajuttama nāmake, ",
  "tha-ap379:1.3": "āropitambhi citake ",
  "tha-ap379:1.4": "sālapupphamapūjayiṃ. ",
  "tha-ap379:2.1": "satasahasse ito kappe ",
  "tha-ap379:2.2": "yaṃ pupphamabhipūjayiṃ, ",
  "tha-ap379:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap379:2.4": "citapūjāyidaṃ phalaṃ. ",
  "tha-ap379:3.1": "",
  "tha-ap379:3.2": "",
  "tha-ap379:3.3": "",
  "tha-ap379:4.1": "svāgataṃ vata me āsi ",
  "tha-ap379:4.2": "buddhaseṭṭhassa santike, tisso vijjā anuppattā ",
  "tha-ap379:4.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap379:5.1": "kilesā jhāpitā mayhaṃ bhavā sabbe samūhatā, nāgova bandhanaṃ chetvā viharāmi anāsavo. paṭisambhidā catasso ",
  "tha-ap379:5.2": "vimokkhāpi ca aṭṭhime, chaḷabhiññā sacchikatā ",
  "tha-ap379:5.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap379:6.1": "itthaṃ sudaṃ āyasmā citakapūjako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap379:7.1": "citakapūjakattherassa apadānaṃ sattamaṃ. "
}
