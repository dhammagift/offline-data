{
  "tha-ap9:0.1": "",
  "tha-ap9:0.2": "",
  "tha-ap9:0.3": "7. aññākoṇḍaññattherāpadānaṃ ",
  "tha-ap9:1.1": "padumuttarasambuddhaṃ ",
  "tha-ap9:1.2": "lokajeṭṭhaṃ vināyakaṃ, ",
  "tha-ap9:1.3": "buddhabhūmimanuppattaṃ ",
  "tha-ap9:1.4": "paṭhamaṃ addasaṃ ahaṃ. ",
  "tha-ap9:2.1": "yāvatā bodhiyā mūle ",
  "tha-ap9:2.2": "yakkhā sabbe samāgatā, ",
  "tha-ap9:2.3": "sambuddhaṃ parivāretvā ",
  "tha-ap9:2.4": "vandanti pañjalīkatā. ",
  "tha-ap9:3.1": "sabbe devā tuṭṭhamanā ",
  "tha-ap9:3.2": "ākāse sañcaranti te, ",
  "tha-ap9:3.3": "“buddho ayaṃ anuppatto ",
  "tha-ap9:3.4": "andhakāratamonudo.” ",
  "tha-ap9:4.1": "tesaṃ hāsaparetānaṃ ",
  "tha-ap9:4.2": "mahānādo pavattatha: ",
  "tha-ap9:4.3": "“kilese jhāpayissāmi ",
  "tha-ap9:4.4": "sammāsambuddhasāsane.” ",
  "tha-ap9:5.1": "devānaṃ giramaññāya ",
  "tha-ap9:5.2": "vācāsabhimudīritaṃ, ",
  "tha-ap9:5.3": "haṭṭho haṭṭhena cittena ",
  "tha-ap9:5.4": "ādibhikkhamadāsa’haṃ. ",
  "tha-ap9:6.1": "mama saṅkappamaññāya ",
  "tha-ap9:6.2": "satthā loke anuttaro, ",
  "tha-ap9:6.3": "devasaṅghe nisīditvā ",
  "tha-ap9:6.4": "imā gāthā abhāsatha: ",
  "tha-ap9:7.1": "“sattāhaṃ abhinikkhamma ",
  "tha-ap9:7.2": "bodhiṃ ajjhagamaṃ ahaṃ, ",
  "tha-ap9:7.3": "idaṃ me paṭhamaṃ bhattaṃ ",
  "tha-ap9:7.4": "brahmacariyassa yāpanaṃ. ",
  "tha-ap9:8.1": "tusitā hi idhā’gantvā ",
  "tha-ap9:8.2": "yo me bhikkhaṃ upānayī, ",
  "tha-ap9:8.3": "tama’haṃ kittayissāmi ",
  "tha-ap9:8.4": "suṇātha mama bhāsato. ",
  "tha-ap9:9.1": "tiṃsakappasahassāni ",
  "tha-ap9:9.2": "devarajjaṃ karissati, ",
  "tha-ap9:9.3": "sabbe deve abhibhotvā ",
  "tha-ap9:9.4": "tidivaṃ āvasissati. ",
  "tha-ap9:10.1": "devalokā cavitvāna ",
  "tha-ap9:10.2": "manussattaṃ gamissati, ",
  "tha-ap9:10.3": "sahassadhā cakkavattī ",
  "tha-ap9:10.4": "tattha rajjaṃ karissati. ",
  "tha-ap9:11.1": "kappasatasahassamhi ",
  "tha-ap9:11.2": "okkākakulasambhavo, ",
  "tha-ap9:11.3": "gotamo nāma gottena ",
  "tha-ap9:11.4": "satthā loke bhavissati. ",
  "tha-ap9:12.1": "tidasā so cavitvāna ",
  "tha-ap9:12.2": "manussattaṃ gamissati, ",
  "tha-ap9:12.3": "agārā pabbajitvāna ",
  "tha-ap9:12.4": "chabbassāni vasisasti. ",
  "tha-ap9:13.1": "tato sattamake vasse ",
  "tha-ap9:13.2": "buddho saccaṃ kathessati, ",
  "tha-ap9:13.3": "koṇḍañño nāma nāmena ",
  "tha-ap9:13.4": "paṭhamaṃ sacchikābhiti.” ",
  "tha-ap9:14.1": "nikkhantenā’nupabbajiṃ ",
  "tha-ap9:14.2": "padhānaṃ sukataṃ mayā, ",
  "tha-ap9:14.3": "kilese jhāpanatthāya ",
  "tha-ap9:14.4": "pabbajiṃ anagāriyaṃ. ",
  "tha-ap9:15.1": "abhigantvāna sabbaññū ",
  "tha-ap9:15.2": "buddho loke sadevake, ",
  "tha-ap9:15.3": "isināme migāraññe ",
  "tha-ap9:15.4": "amataṃ bherimāhani. ",
  "tha-ap9:16.1": "so’dāni patto amataṃ ",
  "tha-ap9:16.2": "santaṃ padamanuttaraṃ, ",
  "tha-ap9:16.3": "sabbāsave pariññāya ",
  "tha-ap9:16.4": "viharāmi anāsavo. ",
  "tha-ap9:17.1": "kilesā ",
  "tha-ap9:17.2": "jhāpitā …pe… ",
  "tha-ap9:17.3": "",
  "tha-ap9:17.4": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap9:18.1": "itthaṃ sudaṃ āyasmā aññākoṇḍañño thero imā gāthāyo abhāsitthāti. ",
  "tha-ap9:19.1": "aññākoṇḍaññattherassa apadānaṃ sattamaṃ. "
}
