{
  "tha-ap232:0.1": "",
  "tha-ap232:0.2": "",
  "tha-ap232:0.3": "230. ekavandiyattherāpadānaṃ. ",
  "tha-ap232:1.1": "usabhaṃ pavaraṃ vīraṃ ",
  "tha-ap232:1.2": "vessabhuṃ vijitāvinaṃ, ",
  "tha-ap232:1.3": "pasannacitto sumano ",
  "tha-ap232:1.4": "buddhaseṭṭhaṃ avandihaṃ. ",
  "tha-ap232:2.1": "ekatiṃse ito kappe ",
  "tha-ap232:2.2": "yaṃ kammamakariṃ tadā, ",
  "tha-ap232:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap232:2.4": "vandanāya idaṃ phalaṃ. ",
  "tha-ap232:3.1": "catuvīsatikappamhi ",
  "tha-ap232:3.2": "vigatānandanāmako, ",
  "tha-ap232:3.3": "sattaratanasampanno ",
  "tha-ap232:3.4": "cakkavattī mahabbalo. ",
  "tha-ap232:4.1": "paṭisambhidā catasso ",
  "tha-ap232:4.2": "vimokkhāpi ca aṭṭhime, chaḷabhiññā sacchikatā ",
  "tha-ap232:4.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap232:5.1": "itthaṃ sudaṃ āyasmā ekavandiyo thero imā gāthāyo abhāsitthāti. ",
  "tha-ap232:6.1": "ekavandiyattherassa apadānaṃ dasamaṃ. ",
  "tha-ap232:7.1": "uddānaṃ: ",
  "tha-ap232:8.1": "",
  "tha-ap232:9.1": "ālambanañca ajinaṃ ",
  "tha-ap232:9.2": "maṃsadā rakkhadāyako ",
  "tha-ap232:9.3": "avyādhi aṅkolaṃ soṇṇaṃ ",
  "tha-ap232:9.4": "miñjaṃ āvela vandanaṃ ",
  "tha-ap232:9.5": "pañcapaññāsa gāthāyo ",
  "tha-ap232:9.6": "gaṇitā atthadassihi. "
}
