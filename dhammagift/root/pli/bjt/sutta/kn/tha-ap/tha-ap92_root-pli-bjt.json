{
  "tha-ap92:0.1": "",
  "tha-ap92:0.2": "",
  "tha-ap92:0.3": "90. padumapupphiyattherāpadānaṃ ",
  "tha-ap92:1.1": "pokkharavanaṃ paviṭṭho ",
  "tha-ap92:1.2": "bhañjanto padumānahaṃ, ",
  "tha-ap92:1.3": "addasaṃ phussasambuddhaṃ ",
  "tha-ap92:1.4": "battiṃsavaralakkhaṇaṃ. ",
  "tha-ap92:2.1": "padumapupphaṃ gahetvāna ",
  "tha-ap92:2.2": "ākāse ukkhipiṃ ahaṃ, ",
  "tha-ap92:2.3": "pasannakammaṃ katvāna ",
  "tha-ap92:2.4": "pabbajiṃ anagāriyaṃ. ",
  "tha-ap92:3.1": "pabbajitvāna kāyena ",
  "tha-ap92:3.2": "manasā saṃvutena ca, ",
  "tha-ap92:3.3": "vacīduccaritaṃ hitvā ",
  "tha-ap92:3.4": "ājīvaṃ parisodhayiṃ. ",
  "tha-ap92:4.1": "dvenavute ito kappe ",
  "tha-ap92:4.2": "yaṃ pupphamabhiropayiṃ, ",
  "tha-ap92:4.3": "duggatiṃ nābhijānāmi ",
  "tha-ap92:4.4": "buddhapūjāyidaṃ phalaṃ. ",
  "tha-ap92:5.1": "padumābhāsanāmā ",
  "tha-ap92:5.2": "aṭṭhārasa mahīpatī, ",
  "tha-ap92:5.3": "aṭṭhārassu kappesu ",
  "tha-ap92:5.4": "aṭṭhatāḷīsamāsisuṃ. ",
  "tha-ap92:6.1": "paṭisambhidā ",
  "tha-ap92:6.2": "…pe… ",
  "tha-ap92:6.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap92:7.1": "itthaṃ sudaṃ āyasmā padumapupphiyo thero imā gāthāyo abhāsitthāti. ",
  "tha-ap92:8.1": "padumapupphiyattherassa apadānaṃ dasamaṃ. ",
  "tha-ap92:9.1": "uddānaṃ: timira ",
  "tha-ap92:10.1": "naṅgalīpupphi ",
  "tha-ap92:11.1": "nipannañjaliko ",
  "tha-ap92:11.2": "adho ",
  "tha-ap92:11.3": "dve raṃsisaññī phalado ",
  "tha-ap92:11.4": "saddasaññī ca secako ",
  "tha-ap92:11.5": "padumapupphi ca gāthāyo ",
  "tha-ap92:11.6": "chappaññāsa pakittitā. timirapupphiyavaggo navamo. "
}
