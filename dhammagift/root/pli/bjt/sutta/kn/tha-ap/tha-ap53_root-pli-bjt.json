{
  "tha-ap53:0.1": "",
  "tha-ap53:0.2": "6. vījanīvaggo ",
  "tha-ap53:0.3": "51. vidhūpanadāyakattherāpadānaṃ ",
  "tha-ap53:1.1": "padumuttarabuddhassa ",
  "tha-ap53:1.2": "lokajeṭṭhassa tādino, ",
  "tha-ap53:1.3": "vījanikā mayā dinnā ",
  "tha-ap53:1.4": "dipadindassa tādino. ",
  "tha-ap53:2.1": "sakaṃ cittaṃ pasādetvā ",
  "tha-ap53:2.2": "paggahetvāna añjaliṃ, ",
  "tha-ap53:2.3": "sambuddhaṃ abhivādetvā ",
  "tha-ap53:2.4": "pakkāmiṃ uttarāmukho. ",
  "tha-ap53:3.1": "vījaniṃ paggahetvāna ",
  "tha-ap53:3.2": "satthā loke anuttaro, ",
  "tha-ap53:3.3": "bhikkhusaṃghe ṭhito santo ",
  "tha-ap53:3.4": "imaṃ gāthaṃ abhāsatha: ",
  "tha-ap53:4.1": "“iminā vījanidānena ",
  "tha-ap53:4.2": "cittassa paṇidhīhi ca, ",
  "tha-ap53:4.3": "kappānaṃ satasahassaṃ ",
  "tha-ap53:4.4": "vinipātaṃ na gacchati”. ",
  "tha-ap53:5.1": "āraddhaviriyo pahitatto ",
  "tha-ap53:5.2": "cetoguṇasamāhito, ",
  "tha-ap53:5.3": "jātiyā sattavasso’haṃ ",
  "tha-ap53:5.4": "arahattamapāpuṇiṃ. ",
  "tha-ap53:6.1": "saṭṭhikappasahassamhi ",
  "tha-ap53:6.2": "vījamānasanāmakā, ",
  "tha-ap53:6.3": "soḷasā’siṃsu rājāno ",
  "tha-ap53:6.4": "cakkavattī mahabbalā. ",
  "tha-ap53:7.1": "paṭisambhidā …pe… ",
  "tha-ap53:7.2": "",
  "tha-ap53:7.3": "",
  "tha-ap53:7.4": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap53:8.1": "itthaṃ sudaṃ āyasmā vidhūpanadāyako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap53:9.1": "vidhupanadāyakattherassa apadānaṃ paṭhamaṃ. "
}
