{
  "tha-ap277:0.1": "",
  "tha-ap277:0.2": "",
  "tha-ap277:0.3": "275. ekañjaliyattherāpadānaṃ. ",
  "tha-ap277:1.1": "udumbare vasantassa ",
  "tha-ap277:1.2": "niyate paṇṇasanthare, ",
  "tha-ap277:1.3": "vutthekāso mayā dinno ",
  "tha-ap277:1.4": "samaṇassa mahesino. ",
  "tha-ap277:2.1": "tissassa dipadindassa ",
  "tha-ap277:2.2": "lokanāthassa tādino, ",
  "tha-ap277:2.3": "añjaliṃ paggahetvāna ",
  "tha-ap277:2.4": "santhariṃ pupphasanthariṃ. ",
  "tha-ap277:3.1": "dvenavute ito kappe ",
  "tha-ap277:3.2": "yaṃ kariṃ pupphasantharaṃ, ",
  "tha-ap277:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap277:3.4": "santharissa idaṃ phalaṃ. ",
  "tha-ap277:4.1": "ito cuddasakappamhi ",
  "tha-ap277:4.2": "ahosiṃ manujādhipo, ",
  "tha-ap277:4.3": "ekañjaliko nāma ",
  "tha-ap277:4.4": "cakkavattī mahabbalo. ",
  "tha-ap277:5.1": "paṭisambhidā catasso ",
  "tha-ap277:5.2": "vimokkhāpi ca aṭṭhime, chaḷabhiññā sacchikatā ",
  "tha-ap277:5.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap277:6.1": "itthaṃ sudaṃ āyasmā ekañjaliyo thero imā gāthāyo abhāsitthāti. ",
  "tha-ap277:7.1": "ekañjaliyattherassa apadānaṃ pañcamaṃ. "
}
