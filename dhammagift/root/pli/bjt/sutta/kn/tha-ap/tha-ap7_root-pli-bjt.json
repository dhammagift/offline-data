{
  "tha-ap7:0.1": "",
  "tha-ap7:0.2": "",
  "tha-ap7:0.3": "5. puṇṇattherāpadānaṃ ",
  "tha-ap7:1.1": "ajjhāyako mantadharo ",
  "tha-ap7:1.2": "tiṇṇaṃ vedāna pāragū, ",
  "tha-ap7:1.3": "purakkhato’mhi sissehi ",
  "tha-ap7:1.4": "upagacchiṃ naruttamaṃ. ",
  "tha-ap7:2.1": "padumuttaro lokavidū ",
  "tha-ap7:2.2": "āhutīnaṃ paṭiggaho, ",
  "tha-ap7:2.3": "mama kammaṃ pakittesi ",
  "tha-ap7:2.4": "saṅkhittena mahāmuni. ",
  "tha-ap7:3.1": "tā’haṃ dhammaṃ suṇitvāna ",
  "tha-ap7:3.2": "abhivādetvāna satthuno, ",
  "tha-ap7:3.3": "añjalimpaggahetvāna ",
  "tha-ap7:3.4": "pakkāmiṃ dakkhiṇāmukho. ",
  "tha-ap7:4.1": "saṅkhittena suṇitvāna ",
  "tha-ap7:4.2": "vitthārena adesayiṃ, ",
  "tha-ap7:4.3": "sabbe sissā attamanā ",
  "tha-ap7:4.4": "sutvāna mama bhāsato. ",
  "tha-ap7:4.5": "sakadiṭṭhiṃ vinodetvā ",
  "tha-ap7:4.6": "buddhe cittaṃ pasādayuṃ, ",
  "tha-ap7:5.1": "saṅkhittenapi desemi ",
  "tha-ap7:5.2": "vitthārena tatheva ‘haṃ. ",
  "tha-ap7:5.3": "abhidhammanayaññu’haṃ ",
  "tha-ap7:5.4": "kathāvatthuvisuddhiyo, ",
  "tha-ap7:5.5": "sabbesaṃ viññapetvāna ",
  "tha-ap7:5.6": "viharāmi anāsavo. ",
  "tha-ap7:6.1": "ito pañcasate kappe ",
  "tha-ap7:6.2": "caturo suppakāsakā, ",
  "tha-ap7:6.3": "sattaratanasampannā ",
  "tha-ap7:6.4": "catudīpamhi issarā. ",
  "tha-ap7:7.1": "paṭisambhidā catasso ca ",
  "tha-ap7:7.2": "vimokkhā’pi ca aṭṭhime, ",
  "tha-ap7:7.3": "chaḷabhiññā sacchikatā ",
  "tha-ap7:7.4": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap7:8.1": "itthaṃ sudaṃ āyasmā puṇṇo mantāniputto thero imā gāthāyo abhāsitthāti. ",
  "tha-ap7:9.1": "puṇṇamantāniputtattherassa apadānaṃ pañcamaṃ. "
}
