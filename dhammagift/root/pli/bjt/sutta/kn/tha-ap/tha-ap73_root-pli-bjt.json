{
  "tha-ap73:0.1": "",
  "tha-ap73:0.2": "8. nāgasamālavaggo ",
  "tha-ap73:0.3": "71. nāgasamālagattherāpadānaṃ ",
  "tha-ap73:1.1": "āpāṭaliṃ ahaṃ pupphaṃ ",
  "tha-ap73:1.2": "uccitasmiṃ mahāpathe, ",
  "tha-ap73:1.3": "phūpambhi abhiropesiṃ ",
  "tha-ap73:1.4": "sikhino lokabandhuno. ",
  "tha-ap73:2.1": "ekatiṃse ito kappe ",
  "tha-ap73:2.2": "yaṃ kammamakariṃ tadā, ",
  "tha-ap73:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap73:2.4": "thūpapūjāyidaṃ phalaṃ. ",
  "tha-ap73:3.1": "ito paṇṇarase kappe ",
  "tha-ap73:3.2": "bhūmiyo nāma khattiyo, ",
  "tha-ap73:3.3": "sattaratanasampanno ",
  "tha-ap73:3.4": "cakkavattī mahabbalo. 1426 ",
  "tha-ap73:4.1": "paṭisambhidā …pe… ",
  "tha-ap73:4.2": "",
  "tha-ap73:4.3": "",
  "tha-ap73:4.4": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap73:5.1": "itthaṃ sudaṃ āyasmā nāgasamālo thero imā gāthāyo abhāsitthāti. ",
  "tha-ap73:6.1": "nāgasamālattherassa apadānaṃ paṭhamaṃ. "
}
