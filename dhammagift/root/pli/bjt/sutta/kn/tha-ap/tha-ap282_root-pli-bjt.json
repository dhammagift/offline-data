{
  "tha-ap282:0.1": "",
  "tha-ap282:0.2": "",
  "tha-ap282:0.3": "280. taraṇiyattherāpadānaṃ ",
  "tha-ap282:1.1": "mahāpathambhi visame ",
  "tha-ap282:1.2": "setu kārāpito mayā, ",
  "tha-ap282:1.3": "taraṇatthāya lokassa ",
  "tha-ap282:1.4": "pasanno sehi pāṇihi. ekanavute ",
  "tha-ap282:2.1": "ito kappe ",
  "tha-ap282:2.2": "setu kārāpito mayā, ",
  "tha-ap282:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap282:2.4": "setudānassidaṃ phalaṃ. ",
  "tha-ap282:3.1": "pañcapaññāsito kappe ",
  "tha-ap282:3.2": "eko āsiṃ samogadho, ",
  "tha-ap282:3.3": "sattaratanasampanno ",
  "tha-ap282:3.4": "cakkavattī mahabbalo. ",
  "tha-ap282:4.1": "paṭisambhidā catasso ",
  "tha-ap282:4.2": "vimokkhāpi ca aṭṭhime, chaḷabhiññā sacchikatā ",
  "tha-ap282:4.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap282:5.1": "itthaṃ sudaṃ āyasmā taraṇiyo thero imā gāthāyo abhāsitthāti. ",
  "tha-ap282:6.1": "taraṇiyattherassa apadānaṃ dasamaṃ. ",
  "tha-ap282:6.2": "uddānaṃ: ",
  "tha-ap282:7.1": "",
  "tha-ap282:8.1": "suvaṇṇaṃ tilamuṭṭhī ca ",
  "tha-ap282:8.2": "caṅgoṭabbhañja añjali ",
  "tha-ap282:8.3": "potthako cita māluvo ",
  "tha-ap282:8.4": "ekapuṇḍari setunā ",
  "tha-ap282:8.5": "dvecattāḷīsagāthāyo ",
  "tha-ap282:8.6": "gaṇitāyo vibhāvihi. ",
  "tha-ap282:9.1": ""
}
