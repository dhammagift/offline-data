{
  "tha-ap123:0.1": "",
  "tha-ap123:0.2": "13. sereyyakavaggo ",
  "tha-ap123:0.3": "121. sereyyakattherāpadānaṃ. ",
  "tha-ap123:1.1": "ajjhāyako mantadharo ",
  "tha-ap123:1.2": "tiṇṇaṃ vedāna pāragū, ",
  "tha-ap123:1.3": "abbhokāse ṭhito santo ",
  "tha-ap123:1.4": "addasaṃ lokanāyakaṃ. ",
  "tha-ap123:2.1": "sīhaṃ yathā vanacaraṃ ",
  "tha-ap123:2.2": "vyaggharājaṃva nittasaṃ, ",
  "tha-ap123:2.3": "tidhā pabhinnamātaṅgaṃ ",
  "tha-ap123:2.4": "kuñjaraṃva mahesinaṃ. ",
  "tha-ap123:3.1": "sereyyakaṃ gahetvāna ",
  "tha-ap123:3.2": "ākāse ukkhipiṃ ahaṃ, ",
  "tha-ap123:3.3": "buddhassa ānubhāvena ",
  "tha-ap123:3.4": "parivārenti sabbato. ",
  "tha-ap123:4.1": "adhiṭṭhāsi mahāvīro ",
  "tha-ap123:4.2": "sabbaññū lokanāyako, ",
  "tha-ap123:4.3": "samantā pupphacchadanā ",
  "tha-ap123:4.4": "okiriṃsu narāsabhaṃ. ",
  "tha-ap123:5.1": "tato sā pupphakañcukā ",
  "tha-ap123:5.2": "antovaṇṭā bahīmukhā, ",
  "tha-ap123:5.3": "sattāhaṃ chadanaṃ hutvā ",
  "tha-ap123:5.4": "tato antaradhāyatha. ",
  "tha-ap123:6.1": "taṃ ca acchariyaṃ disvā ",
  "tha-ap123:6.2": "abbhutaṃ lomahaṃsanaṃ, ",
  "tha-ap123:6.3": "buddhe cittaṃ pasādesiṃ ",
  "tha-ap123:6.4": "sugate lokanāyake. ",
  "tha-ap123:7.1": "tena cittappasādena ",
  "tha-ap123:7.2": "sukkamūlena codito, ",
  "tha-ap123:7.3": "kappānaṃ satasahassaṃ ",
  "tha-ap123:7.4": "duggatiṃ nupapajjahaṃ. ",
  "tha-ap123:8.1": "paṇṇarasasahassambhi ",
  "tha-ap123:8.2": "kappānaṃ pañcavīsa ",
  "tha-ap123:8.3": "te, cittamālāsanāmā ca ",
  "tha-ap123:8.4": "cakkavattī mahabbalā. ",
  "tha-ap123:9.1": "paṭisambhidā catasso ",
  "tha-ap123:9.2": "vimokkhā’pi ca aṭṭhime, ",
  "tha-ap123:9.3": "chaḷabhiññā sacchikatā ",
  "tha-ap123:9.4": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap123:10.1": "itthaṃ sudaṃ āyasmā sereyyako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap123:11.1": "serayyekattherassa apadānaṃ paṭhamaṃ. "
}
