{
  "tha-ap400:0.1": "",
  "tha-ap400:0.2": "",
  "tha-ap400:0.3": "398. salalamaṇḍapiyattherāpadānaṃ. ",
  "tha-ap400:1.1": "nibbute kakusandhamhi ",
  "tha-ap400:1.2": "brāhmaṇamhi vusīmati, ",
  "tha-ap400:1.3": "gahetvā salalaṃ mālaṃ ",
  "tha-ap400:1.4": "maṇḍapaṃ kārayiṃ ahaṃ. ",
  "tha-ap400:2.1": "tāvatiṃsagato santo ",
  "tha-ap400:2.2": "labhāmi vyamhamuttamaṃ, ",
  "tha-ap400:2.3": "aññe deve’tirocāmi ",
  "tha-ap400:2.4": "puññakammassidaṃ phalaṃ. ",
  "tha-ap400:3.1": "divā vā yadi vā rattiṃ ",
  "tha-ap400:3.2": "caṅkamanto ṭhito ca’haṃ, ",
  "tha-ap400:3.3": "channo salalapupphehi ",
  "tha-ap400:3.4": "puññakammassidaṃ phalaṃ. ",
  "tha-ap400:4.1": "imasmiṃ yeva kappamhi ",
  "tha-ap400:4.2": "yaṃ buddhamabhipūjayiṃ, ",
  "tha-ap400:4.3": "duggatiṃ nābhijānāmi ",
  "tha-ap400:4.4": "buddhapūjāyidaṃ phalaṃ. ",
  "tha-ap400:5.1": "kilesā jhāpitā mayhaṃ ",
  "tha-ap400:5.2": "bhavā sabbe samūhatā, sabbesavā parikkhīṇā ",
  "tha-ap400:5.3": "viharāmi anāsavo. ",
  "tha-ap400:6.1": "svāgataṃ vata me āsi ",
  "tha-ap400:6.2": "buddhaseṭṭhassa santike, tisso vijjā anuppattā ",
  "tha-ap400:6.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap400:7.1": "paṭisambhidā catasso ",
  "tha-ap400:7.2": "vimokkhāpi ca aṭṭhime, chaḷabhiññā sacchikatā ",
  "tha-ap400:7.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap400:8.1": "itthaṃ sudaṃ āyasmā salalamaṇḍapiyo thero imā gāthāyo abhāsitthāti. ",
  "tha-ap400:9.1": "salalamaṇḍapiyattherassa apadānaṃ aṭṭhamaṃ. "
}
