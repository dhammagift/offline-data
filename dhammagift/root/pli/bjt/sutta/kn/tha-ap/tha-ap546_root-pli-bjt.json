{
  "tha-ap546:0.1": "",
  "tha-ap546:0.2": "",
  "tha-ap546:0.3": "544. vaṅgīsattherāpadānaṃ ",
  "tha-ap546:1.1": "padumuttaro nāma jino ",
  "tha-ap546:1.2": "sabbadhammesu cakkhumā, ",
  "tha-ap546:1.3": "ito satasahassamhi ",
  "tha-ap546:1.4": "kappe uppajji nāyako. ",
  "tha-ap546:2.1": "yathāpi sāgare ūmi ",
  "tha-ap546:2.2": "gagane viya tārakā, ",
  "tha-ap546:2.3": "evaṃ pāvacanaṃ tassa ",
  "tha-ap546:2.4": "arahantehi cittitaṃ. ",
  "tha-ap546:3.1": "sa devāsuranāgehi ",
  "tha-ap546:3.2": "manujehi purakkhato, ",
  "tha-ap546:3.3": "samaṇabrāhmaṇākiṇṇe ",
  "tha-ap546:3.4": "janamajjhe januttamo. ",
  "tha-ap546:4.1": "pabhābhi anurañjento ",
  "tha-ap546:4.2": "lokaṃ lokantagū jino, ",
  "tha-ap546:4.3": "vacanena vibodhento ",
  "tha-ap546:4.4": "veneyyapadumāni so. ",
  "tha-ap546:5.1": "vesārajjehi sampanno ",
  "tha-ap546:5.2": "catūhi purisuttamo, ",
  "tha-ap546:5.3": "pahīnabhayasārajjo ",
  "tha-ap546:5.4": "khemappatto visārado. ",
  "tha-ap546:6.1": "āsabhaṃ pavaraṃ ṭhānaṃ ",
  "tha-ap546:6.2": "buddhabhumiṃ ca kevalaṃ, ",
  "tha-ap546:6.3": "paṭijānāti lokaggo ",
  "tha-ap546:6.4": "natthi sañcodako kvaci. ",
  "tha-ap546:7.1": "sīhanādamasambhītaṃ ",
  "tha-ap546:7.2": "nadato tassa tādino, ",
  "tha-ap546:7.3": "devo naro vā brahmā vā ",
  "tha-ap546:7.4": "paṭivattā na vijjati. ",
  "tha-ap546:8.1": "desento pavaraṃ dhammaṃ ",
  "tha-ap546:8.2": "santārento sadevakaṃ, ",
  "tha-ap546:8.3": "dhammacakkaṃ pavatteti ",
  "tha-ap546:8.4": "parisāsu visārado. ",
  "tha-ap546:9.1": "paṭibhānavataṃ aggaṃ ",
  "tha-ap546:9.2": "sāvakaṃ sādhusammataṃ, ",
  "tha-ap546:9.3": "guṇaṃ bahuṃ pakittetvā ",
  "tha-ap546:9.4": "etadagge ṭhapesi taṃ. ",
  "tha-ap546:10.1": "tadāhaṃ haṃsavatiyaṃ ",
  "tha-ap546:10.2": "brāhmaṇo sādhusammato, ",
  "tha-ap546:10.3": "sabbavedavidū jāto ",
  "tha-ap546:10.4": "vaṅgīso vādisūdano. ",
  "tha-ap546:11.1": "upecca taṃ mahāvīraṃ ",
  "tha-ap546:11.2": "sutvā taṃ dhammadesanaṃ, ",
  "tha-ap546:11.3": "pītivaraṃ paṭilabhiṃ ",
  "tha-ap546:11.4": "sāvakassa guṇe rato. ",
  "tha-ap546:12.1": "nimantayitvā sugataṃ ",
  "tha-ap546:12.2": "sasaṅghaṃ lokanandanaṃ, ",
  "tha-ap546:12.3": "sattāhaṃ bhojayitvāhaṃ ",
  "tha-ap546:12.4": "dussehacchādayiṃ tadā. ",
  "tha-ap546:13.1": "nipacca sirasā pāde ",
  "tha-ap546:13.2": "katokāso katañjalī, ",
  "tha-ap546:13.3": "ekamantaṃ ṭhito haṭṭho ",
  "tha-ap546:13.4": "santhaviṃ jinamuttamaṃ: ",
  "tha-ap546:14.1": "“namo te vādisaddūla ",
  "tha-ap546:14.2": "namo te purisuttama, ",
  "tha-ap546:14.3": "namo te sabbalokagga ",
  "tha-ap546:14.4": "namo te abhayaṅkara. ",
  "tha-ap546:15.1": "namo te māramathana ",
  "tha-ap546:15.2": "namo te diṭṭhisūdana, ",
  "tha-ap546:15.3": "namo te santisukhada ",
  "tha-ap546:15.4": "namo te saraṇaṅkara. ",
  "tha-ap546:16.1": "anāthānaṃ bhavaṃ nātho ",
  "tha-ap546:16.2": "bhītānaṃ abhayappado, ",
  "tha-ap546:16.3": "vissāmabhūmi sattānaṃ ",
  "tha-ap546:16.4": "saraṇaṃ saraṇesinaṃ. ",
  "tha-ap546:17.1": "evamādīhi sambuddhaṃ ",
  "tha-ap546:17.2": "santhavitvā mahāguṇaṃ, ",
  "tha-ap546:17.3": "avocaṃ vādisūrassa ",
  "tha-ap546:17.4": "gatiṃ pappomi bhikkhuno. ",
  "tha-ap546:18.1": "tadā avoca bhagavā ",
  "tha-ap546:18.2": "anantapaṭibhānavā, ",
  "tha-ap546:18.3": "yo so buddhaṃ abhojesi ",
  "tha-ap546:18.4": "sattāhaṃ saha sāvakaṃ. ",
  "tha-ap546:19.1": "guṇaṃ ca me pakittesi ",
  "tha-ap546:19.2": "pasanno sehi pāṇihi, ",
  "tha-ap546:19.3": "eso patthayate ṭhānaṃ ",
  "tha-ap546:19.4": "vādisūrassa bhikkhuno. ",
  "tha-ap546:20.1": "anāgatamhi addhāne ",
  "tha-ap546:20.2": "lacchate taṃ manorathaṃ, ",
  "tha-ap546:20.3": "devamānusasampattiṃ ",
  "tha-ap546:20.4": "anubhotvā anappakaṃ. ",
  "tha-ap546:21.1": "satasahasse ito kappe ",
  "tha-ap546:21.2": "okkākakulasambhavo, ",
  "tha-ap546:21.3": "gotamo nāma nāmena ",
  "tha-ap546:21.4": "satthā loke bhavissati. ",
  "tha-ap546:22.1": "tassa dhammesu dāyādo ",
  "tha-ap546:22.2": "oraso dhammanimmito, ",
  "tha-ap546:22.3": "vaṅgīso nāma nāmena ",
  "tha-ap546:22.4": "hessati satthusāvako. ",
  "tha-ap546:23.1": "taṃ sutvā mudito hutvā ",
  "tha-ap546:23.2": "yāvajīvaṃ tadā jinaṃ, ",
  "tha-ap546:23.3": "paccayehi upaṭṭhāsi ",
  "tha-ap546:23.4": "mettacitto tathāgataṃ. ",
  "tha-ap546:24.1": "tena kammena sukatena ",
  "tha-ap546:24.2": "cetanāpaṇidhīhi ca, ",
  "tha-ap546:24.3": "jahitvā mānusaṃ dehaṃ ",
  "tha-ap546:24.4": "tusitaṃ agamāsahaṃ. ",
  "tha-ap546:25.1": "pacchime ca bhavedāni ",
  "tha-ap546:25.2": "paribbājakule ahaṃ, ",
  "tha-ap546:25.3": "paccājāto yadā āsiṃ ",
  "tha-ap546:25.4": "jātiyā sattavassiko. ",
  "tha-ap546:26.1": "sabbavedavidū jāto ",
  "tha-ap546:26.2": "vādasatthavisārado, ",
  "tha-ap546:26.3": "vādissaro cittakathī ",
  "tha-ap546:26.4": "paravādappamaddano. ",
  "tha-ap546:27.1": "vaṅge jāto’ti vaṅgīso ",
  "tha-ap546:27.2": "vacane issaroti vā, ",
  "tha-ap546:27.3": "vaṅgīso iti me nāmaṃ ",
  "tha-ap546:27.4": "abhavī lokasammataṃ. ",
  "tha-ap546:28.1": "yadāhaṃ viññutaṃ patto ",
  "tha-ap546:28.2": "ṭhito paṭhamayobbane, ",
  "tha-ap546:28.3": "tadā rājagahe ramme ",
  "tha-ap546:28.4": "sāriputtamathaddasaṃ. ",
  "tha-ap546:29.1": "pañcavisatimaṃ bhāṇavāraṃ. ",
  "tha-ap546:30.1": "piṇḍāya vicarantaṃ taṃ ",
  "tha-ap546:30.2": "pattapāṇiṃ susaṃvutaṃ, ",
  "tha-ap546:30.3": "alolakkhiṃ mitabhāṇiṃ ",
  "tha-ap546:30.4": "yugamattanirikkhakaṃ. ",
  "tha-ap546:31.1": "taṃ disvā vimhito hutvā ",
  "tha-ap546:31.2": "avocaṃ mananucchavaṃ. ",
  "tha-ap546:31.3": "khaṇikaṃ ṭhānaracitaṃ ",
  "tha-ap546:31.4": "cittaṃ gāthāpadaṃ ahaṃ. ",
  "tha-ap546:32.1": "ācikkhi so me satthāraṃ ",
  "tha-ap546:32.2": "sambuddhaṃ lokanāyakaṃ, ",
  "tha-ap546:32.3": "tadā so paṇḍito vīro ",
  "tha-ap546:32.4": "uttaraṃ samavoca me. ",
  "tha-ap546:33.1": "virāgasaṃhitaṃ vākyaṃ ",
  "tha-ap546:33.2": "katvā duddasamuttamaṃ, ",
  "tha-ap546:33.3": "vicittapaṭibhānehi ",
  "tha-ap546:33.4": "tosito tena tādinā, ",
  "tha-ap546:34.1": "nipacca sirasā pāde ",
  "tha-ap546:34.2": "pabbājehīti maṃ braviṃ. ",
  "tha-ap546:34.3": "tato maṃ sa mahāpañño ",
  "tha-ap546:34.4": "buddhaseṭṭhamupānayi, ",
  "tha-ap546:35.1": "nipacca sirasā pāde ",
  "tha-ap546:35.2": "nisīdiṃ satthu santike. ",
  "tha-ap546:35.3": "mamāha vadataṃ seṭṭho ",
  "tha-ap546:35.4": "kacci vaṅgīsa jānasi, ",
  "tha-ap546:36.1": "kiñci sippanti tassāhaṃ ",
  "tha-ap546:36.2": "jānāmi ti ca abraviṃ. ",
  "tha-ap546:36.3": "matasīsaṃ vanacchuddhaṃ ",
  "tha-ap546:36.4": "api bārasavassikaṃ, ",
  "tha-ap546:36.5": "tava vijjāvisesena ",
  "tha-ap546:36.6": "sace sakkosi bhāsaya. ",
  "tha-ap546:37.1": "āmāti me paṭiññāte ",
  "tha-ap546:37.2": "tīṇi sīsāni dassayī. ",
  "tha-ap546:37.3": "niraya nara devesu ",
  "tha-ap546:37.4": "upapanne avācayiṃ. ",
  "tha-ap546:38.1": "tadā paccekabuddhassa ",
  "tha-ap546:38.2": "siraṃ dassesi nāyako, ",
  "tha-ap546:38.3": "tatohaṃ vihatārambho ",
  "tha-ap546:38.4": "pabbajjaṃ samayācisaṃ. ",
  "tha-ap546:39.1": "pabbajitvāna sugataṃ ",
  "tha-ap546:39.2": "santhavāmi tahiṃ tahiṃ, ",
  "tha-ap546:39.3": "tato maṃ kabbavīttoti ",
  "tha-ap546:39.4": "ujjhāyantiha bhikkhavo. ",
  "tha-ap546:40.1": "tato vimaṃsanatthaṃ me ",
  "tha-ap546:40.2": "āha buddho vināyako, ",
  "tha-ap546:40.3": "takkitā panimā gāthā ",
  "tha-ap546:40.4": "ṭhānaso paṭibhanti vā ",
  "tha-ap546:41.1": "na kabbavittohaṃ vīra ",
  "tha-ap546:41.2": "ṭhānaso paṭibhanti maṃ, ",
  "tha-ap546:41.3": "tena hi dāni vaṅgīsa ",
  "tha-ap546:41.4": "ṭhānaso santhavāhi maṃ. ",
  "tha-ap546:42.1": "tadāhaṃ santhaviṃ vīraṃ ",
  "tha-ap546:42.2": "gāthāhi isisattamaṃ, ",
  "tha-ap546:42.3": "ṭhānāso me tadā tuṭṭho ",
  "tha-ap546:42.4": "jino agge ṭhapesi maṃ. ",
  "tha-ap546:43.1": "paṭibhānena cittena ",
  "tha-ap546:43.2": "aññe samatimaññahaṃ, ",
  "tha-ap546:43.3": "pesale tena saṃviggo ",
  "tha-ap546:43.4": "arahattamapāpuṇiṃ. ",
  "tha-ap546:44.1": "paṭihānavataṃ aggo ",
  "tha-ap546:44.2": "añño koci na vijjati, ",
  "tha-ap546:44.3": "yathāyaṃ bhikkhu vaṅgīso ",
  "tha-ap546:44.4": "evaṃ dhāretha bhikkhavo. ",
  "tha-ap546:45.1": "satasahasse kataṃ kammaṃ ",
  "tha-ap546:45.2": "phalaṃ dassesi me idha, ",
  "tha-ap546:45.3": "sumutto saravegova ",
  "tha-ap546:45.4": "kilese jhāpayiṃ ahaṃ. ",
  "tha-ap546:46.1": "kilesā jhāpitā mayhaṃ ",
  "tha-ap546:46.2": "bhavā sabbe samūhatā, nāgo’va bandhanaṃ chetvā ",
  "tha-ap546:46.3": "viharāmi anāsavo. ",
  "tha-ap546:47.1": "svāgataṃ vata me āsi ",
  "tha-ap546:47.2": "buddhaseṭṭhassa santike, tisso vijjā anuppattā ",
  "tha-ap546:47.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap546:48.1": "paṭisambhidā catasso ",
  "tha-ap546:48.2": "ca vimokkhā pi ca aṭṭhime, chaḷabhiññā sacchikatā ",
  "tha-ap546:48.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap546:49.1": "itthaṃ sudaṃ āyasmā vaṅgīso thero imā gāthāyo abhāsitthāti. ",
  "tha-ap546:50.1": "vaṅgīsattherassa apadānaṃ catutthaṃ. "
}
