{
  "tha-ap456:0.1": "",
  "tha-ap456:0.2": "",
  "tha-ap456:0.3": "454. tiukkādhārakattherāpadānaṃ ",
  "tha-ap456:1.1": "padumuttarabuddhassa ",
  "tha-ap456:1.2": "bodhiyā pādaputtame, ",
  "tha-ap456:1.3": "pasannacitto sumano ",
  "tha-ap456:1.4": "tayo ukkā adhārayiṃ. ",
  "tha-ap456:2.1": "satasahasse ito kappe ",
  "tha-ap456:2.2": "sohaṃ ukkamadhārayiṃ, ",
  "tha-ap456:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap456:2.4": "ukkādānassidaṃ phalaṃ. ",
  "tha-ap456:3.1": "kilesā jhāpitā mayhaṃ ",
  "tha-ap456:3.2": "bhavā sabbe samūhatā, nāgova bandhanaṃ chetvā ",
  "tha-ap456:3.3": "viharāmi anāsavo. ",
  "tha-ap456:4.1": "svāgataṃ vata me āsi ",
  "tha-ap456:4.2": "buddhaseṭṭhassa santike, tisso vijjā anuppattā ",
  "tha-ap456:4.3": "kataṃ buddhassa sāsanaṃ ",
  "tha-ap456:5.1": "paṭisambhidā catasso ",
  "tha-ap456:5.2": "ca vimokkhāpi ca aṭṭhime, chaḷabhiññā sacchikatā ",
  "tha-ap456:5.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap456:6.1": "itthaṃ sudaṃ āyasmā tiukkādhārako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap456:7.1": "tiukkādhārakattherassa apadānaṃ catutthaṃ. "
}
