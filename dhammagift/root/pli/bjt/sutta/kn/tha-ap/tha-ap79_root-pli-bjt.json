{
  "tha-ap79:0.1": "",
  "tha-ap79:0.2": "",
  "tha-ap79:0.3": "77. sūcidāyakattherāpadānaṃ ",
  "tha-ap79:1.1": "tiṃsakappasahassamhi ",
  "tha-ap79:1.2": "sambuddho lokanāyako, ",
  "tha-ap79:1.3": "sumedho nāma nāmena ",
  "tha-ap79:1.4": "battiṃsavaralakkhaṇo. ",
  "tha-ap79:2.1": "tassa kañcanavaṇṇassa ",
  "tha-ap79:2.2": "dipadindassa tādino, ",
  "tha-ap79:2.3": "pañca sūcī mayā dinnā ",
  "tha-ap79:2.4": "sibbanatthāya cīvaraṃ. ",
  "tha-ap79:3.1": "tene’va sūcidānena ",
  "tha-ap79:3.2": "nipuṇatthavipassakaṃ, ",
  "tha-ap79:3.3": "tikkhaṃ lahuñca phāsuñca ",
  "tha-ap79:3.4": "ñāṇaṃ me udapajjatha. ",
  "tha-ap79:4.1": "dipadādhipatī nāma rājāno caturo ahuṃ, sattaratanasampannā cakkavattī mahabbalā. kilesā jhāpitā mayhaṃ ",
  "tha-ap79:4.2": "bhavā sabbe samūhatā, ",
  "tha-ap79:4.3": "dhāremi antimaṃ dehaṃ ",
  "tha-ap79:4.4": "sammāsambuddhasāsane. ",
  "tha-ap79:5.1": "",
  "tha-ap79:5.2": "",
  "tha-ap79:5.3": "",
  "tha-ap79:5.4": "",
  "tha-ap79:6.1": "paṭisambhidā ",
  "tha-ap79:6.2": "…pe… ",
  "tha-ap79:6.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap79:7.1": "itthaṃ sudaṃ āyasmā sūcidāyako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap79:8.1": "sūcidāyakattherassa apadānaṃ sattamaṃ. "
}
