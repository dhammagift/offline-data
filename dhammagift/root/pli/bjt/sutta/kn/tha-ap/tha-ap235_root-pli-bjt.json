{
  "tha-ap235:0.1": "",
  "tha-ap235:0.2": "",
  "tha-ap235:0.3": "233. sālapūpiyattherāpadānaṃ ",
  "tha-ap235:1.1": "aruṇavatiyā nagare ",
  "tha-ap235:1.2": "ahosiṃ pūpiko ahaṃ, ",
  "tha-ap235:1.3": "mama dvārena gacchantaṃ ",
  "tha-ap235:1.4": "sikhinaṃ addasaṃ jinaṃ. ",
  "tha-ap235:2.1": "buddhassa pattaṃ paggayha ",
  "tha-ap235:2.2": "sālapūpaṃ adāsahaṃ, ",
  "tha-ap235:2.3": "sammaggatassa buddhassa ",
  "tha-ap235:2.4": "vippasannena cetasā. ",
  "tha-ap235:3.1": "ekatiṃse ito kappe ",
  "tha-ap235:3.2": "yaṃ khajjakamadāsahaṃ. ",
  "tha-ap235:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap235:3.4": "sālapūpassidaṃ phalaṃ. ",
  "tha-ap235:4.1": "ito cuddasakappamhi ",
  "tha-ap235:4.2": "asosiṃ amitañjalo, ",
  "tha-ap235:4.3": "sattaratanasampanno ",
  "tha-ap235:4.4": "cakkavattī mahabbalo. ",
  "tha-ap235:5.1": "paṭisambhidā catasso ",
  "tha-ap235:5.2": "vimokkhāpi ca aṭṭhime, chaḷabhiññā sacchikatā ",
  "tha-ap235:5.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap235:6.1": "itthaṃ sudaṃ āyasmā sālapūpiyo thero imā gāthāyo abhāsitthāti. ",
  "tha-ap235:7.1": "sālapūpiyattherassa apadānaṃ tatiyaṃ. "
}
