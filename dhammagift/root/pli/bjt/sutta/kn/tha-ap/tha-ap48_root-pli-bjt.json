{
  "tha-ap48:0.1": "",
  "tha-ap48:0.2": "",
  "tha-ap48:0.3": "46. padumacchadaniyattherāpadānaṃ ",
  "tha-ap48:1.1": "nibbute lokanāthambhi vipassimhaggapuggalo, ",
  "tha-ap48:1.2": "suphullaṃ ",
  "tha-ap48:1.3": "padumaṃ gayha ",
  "tha-ap48:1.4": "citakamāropayiṃ ahaṃ. ",
  "tha-ap48:2.1": "āropite ca citake ",
  "tha-ap48:2.2": "vehāsaṃ nabhamuggamī, ",
  "tha-ap48:2.3": "ākāsacchadanaṃ katvā ",
  "tha-ap48:2.4": "citakambhi adhārayiṃ. ekanavute ",
  "tha-ap48:3.1": "ito kappe ",
  "tha-ap48:3.2": "yaṃ pupphamabhiropayiṃ, ",
  "tha-ap48:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap48:3.4": "buddhapūjāyidaṃ phalaṃ. ",
  "tha-ap48:4.1": "sattatāḷīsito kappe ",
  "tha-ap48:4.2": "padumissaranāmako, ",
  "tha-ap48:4.3": "cāturanto vijitāvī ",
  "tha-ap48:4.4": "cakkavattī mahabbalo. ",
  "tha-ap48:5.1": "paṭisambhidā ",
  "tha-ap48:5.2": "…pe… ",
  "tha-ap48:5.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap48:6.1": "itthaṃ sudaṃ āyasmā padumacchadaniyo thero imā gāthāyo abhāsitthāti. ",
  "tha-ap48:7.1": "padumacchadaniyattherassa apadānaṃ chaṭṭhaṃ. "
}
