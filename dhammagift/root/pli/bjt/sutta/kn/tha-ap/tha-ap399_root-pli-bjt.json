{
  "tha-ap399:0.1": "",
  "tha-ap399:0.2": "",
  "tha-ap399:0.3": "397. girimānandattherāpadānaṃ. ",
  "tha-ap399:1.1": "bhariyā me kālakatā ",
  "tha-ap399:1.2": "putto sīvathikaṃ gato, ",
  "tha-ap399:1.3": "mātā pitā ca bhātā ",
  "tha-ap399:1.4": "ca ekacitakamhi ḍayhare. ",
  "tha-ap399:2.1": "tena sokena santatto ",
  "tha-ap399:2.2": "kiso paṇḍu ahosahaṃ, ",
  "tha-ap399:2.3": "cittakkhepo ca me āsi ",
  "tha-ap399:2.4": "tena sokena aṭṭito. ",
  "tha-ap399:3.1": "sokasallapareto’haṃ ",
  "tha-ap399:3.2": "vanantamupasaṅkamiṃ, ",
  "tha-ap399:3.3": "pavattaphalaṃ bhuñjitvā ",
  "tha-ap399:3.4": "rukkhamūle vasāmahaṃ. ",
  "tha-ap399:4.1": "sumedho nāma sambuddho ",
  "tha-ap399:4.2": "dukkhassa’ntakāro jino, ",
  "tha-ap399:4.3": "mamuddharitukāmo so ",
  "tha-ap399:4.4": "āgacchi mama santike. ",
  "tha-ap399:5.1": "padasaddaṃ suṇitvāna ",
  "tha-ap399:5.2": "sumedhassa mahesino, ",
  "tha-ap399:5.3": "paggahetvāna’haṃ sīsaṃ ",
  "tha-ap399:5.4": "ullokesiṃ mahāmuniṃ. ",
  "tha-ap399:6.1": "upagacchi mahāvīro ",
  "tha-ap399:6.2": "pīti me upapajjatha, tadā’si ",
  "tha-ap399:6.3": "mekaggamano ",
  "tha-ap399:6.4": "disvā taṃ lokanāyakaṃ. ",
  "tha-ap399:7.1": "satiṃ paṭilabhitvāna ",
  "tha-ap399:7.2": "paṇṇamuṭṭhimadāsahaṃ, ",
  "tha-ap399:7.3": "nisīdi bhagavā tattha ",
  "tha-ap399:7.4": "anukampāya cakkhumaṃ. ",
  "tha-ap399:8.1": "nisajja tattha bhagavā ",
  "tha-ap399:8.2": "sumedho lokanāyako, ",
  "tha-ap399:8.3": "dhammaṃ me kathayī buddho ",
  "tha-ap399:8.4": "sokasallavinodanaṃ. ",
  "tha-ap399:9.1": "“anavahitā tato āguṃ ",
  "tha-ap399:9.2": "ananuññātā ito gatā, ",
  "tha-ap399:9.3": "yathā’gatā tathā gatā ",
  "tha-ap399:9.4": "tattha kā paridevanā. ",
  "tha-ap399:10.1": "yathāpi pathikā sattā ",
  "tha-ap399:10.2": "vassamānāya vuṭṭhiyā, ",
  "tha-ap399:10.3": "sabhaṇḍā upagacchanti ",
  "tha-ap399:10.4": "vassassāpatanāya te. ",
  "tha-ap399:11.1": "vasse ca te oramite ",
  "tha-ap399:11.2": "sampayanti yadicchakaṃ, ",
  "tha-ap399:11.3": "evaṃ mātā pitā tuyhaṃ ",
  "tha-ap399:11.4": "kattha kā paridevanā. ",
  "tha-ap399:12.1": "āgantukā pāhuṇakā ",
  "tha-ap399:12.2": "caliteritakampitā, ",
  "tha-ap399:12.3": "evaṃ mātā pitā tuyhaṃ ",
  "tha-ap399:12.4": "tattha kā paridevanā. ",
  "tha-ap399:13.1": "yathāpi urago jiṇṇaṃ ",
  "tha-ap399:13.2": "hitvā gacchati santacaṃ, ",
  "tha-ap399:13.3": "evaṃ mātā pitā tuyhaṃ ",
  "tha-ap399:13.4": "santanuṃ idha hīyare.” ",
  "tha-ap399:14.1": "buddhassa giramaññāya ",
  "tha-ap399:14.2": "sokalassaṃ vivajjayiṃ, ",
  "tha-ap399:14.3": "pāmojjaṃ janayitvāna ",
  "tha-ap399:14.4": "buddhaseṭṭhamavandihaṃ. ",
  "tha-ap399:15.1": "vanditvāna mahānāgaṃ ",
  "tha-ap399:15.2": "girimañjarimapūjayiṃ, dibbagandhena ",
  "tha-ap399:15.3": "sampannaṃ ",
  "tha-ap399:15.4": "sumedhaṃ lokanāyakaṃ. ",
  "tha-ap399:16.1": "pūjayitvāna sambuddhaṃ ",
  "tha-ap399:16.2": "sire katvāna añjaliṃ, ",
  "tha-ap399:16.3": "anussaraṃ guṇaggāni ",
  "tha-ap399:16.4": "santhaviṃ lokanāyakaṃ. ",
  "tha-ap399:17.1": "nittiṇṇosi mahāvīra ",
  "tha-ap399:17.2": "sabbaññū lokanāyaka, ",
  "tha-ap399:17.3": "sabbe satte uddharasi ",
  "tha-ap399:17.4": "ñāṇena tvaṃ mahāmune. ",
  "tha-ap399:18.1": "vimatiṃ dveḷhakaṃ cāpi ",
  "tha-ap399:18.2": "sañchindasi mahāmuni, ",
  "tha-ap399:18.3": "paṭipādesi me maggaṃ ",
  "tha-ap399:18.4": "tava ñāṇena cakkhuma. ",
  "tha-ap399:19.1": "arahā siddhipattā ca ",
  "tha-ap399:19.2": "chaḷabhiññā mahiddhikā, ",
  "tha-ap399:19.3": "antalikkhacarā dhīrā ",
  "tha-ap399:19.4": "parivārenti tāvade. ",
  "tha-ap399:20.1": "paṭipannā ca sekhā ca ",
  "tha-ap399:20.2": "phalaṭṭhā santi sāvakā, ",
  "tha-ap399:20.3": "sūrodayeva padumā ",
  "tha-ap399:20.4": "pupphanti tava sāvakā. ",
  "tha-ap399:21.1": "yathā samuddo akkhobho ",
  "tha-ap399:21.2": "atulo ca duruttaro, ",
  "tha-ap399:21.3": "evaṃ ñāṇena sampanno ",
  "tha-ap399:21.4": "appameyyosi cakkhuma. ",
  "tha-ap399:22.1": "vanditvāhaṃ lokajinaṃ ",
  "tha-ap399:22.2": "cakkhumantaṃ mahāyasaṃ, ",
  "tha-ap399:22.3": "puthu disā namassanto ",
  "tha-ap399:22.4": "paṭikuṭiko agañchahaṃ. ",
  "tha-ap399:23.1": "devalokā cavitvāna ",
  "tha-ap399:23.2": "sampajāno patissato, ",
  "tha-ap399:23.3": "okkamiṃ mātuyā kucchiṃ ",
  "tha-ap399:23.4": "sandhāvanto bhavābhave. ",
  "tha-ap399:24.1": "agārā abhinikkhamma ",
  "tha-ap399:24.2": "pabbajiṃ anagāriyaṃ, ",
  "tha-ap399:24.3": "ātāpī nipako jhāyī ",
  "tha-ap399:24.4": "paṭisallānagocaro. ",
  "tha-ap399:25.1": "padhānaṃ padahitvāna ",
  "tha-ap399:25.2": "tosayitvā mahāmuniṃ, ",
  "tha-ap399:25.3": "candova’bbhaghanā mutto ",
  "tha-ap399:25.4": "vicarāmi ahaṃ tadā. ",
  "tha-ap399:26.1": "vivekamanuyuttombhi ",
  "tha-ap399:26.2": "upasanto nirūpadhi, ",
  "tha-ap399:26.3": "sabbāsave pariññāya ",
  "tha-ap399:26.4": "viharāmi anāsavo. ",
  "tha-ap399:27.1": "tiṃsakappasahassambhi ",
  "tha-ap399:27.2": "yaṃ buddhamabhipūjayiṃ, ",
  "tha-ap399:27.3": "duggatiṃ nābhijānāmi ",
  "tha-ap399:27.4": "buddhapūjāyidaṃ phalaṃ. ",
  "tha-ap399:28.1": "kilesā jhāpitā mayhaṃ ",
  "tha-ap399:28.2": "bhavā sabbe samūhatā, ",
  "tha-ap399:28.3": "sabbāsavā parikkhīṇā ",
  "tha-ap399:28.4": "natthidāni punabbhavo. ",
  "tha-ap399:29.1": "svāgataṃ vata me āsi ",
  "tha-ap399:29.2": "mama buddhaseṭṭhassa santike, tisso vijjā anuppattā ",
  "tha-ap399:29.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap399:30.1": "paṭisambhidā catasso ",
  "tha-ap399:30.2": "vimokkhāpi ca aṭṭhime, chaḷabhiññā sacchikatā ",
  "tha-ap399:30.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap399:31.1": "itthaṃ sudaṃ āyasmā girimānando thero imā gāthāyo abhāsitthāti. ",
  "tha-ap399:32.1": "girimānandattherassa apadānaṃ sattamaṃ. "
}
