{
  "tha-ap273:0.1": "",
  "tha-ap273:0.2": "28. suvaṇṇabimbohanavaggo ",
  "tha-ap273:0.3": "271. suvaṇṇabimbohaniyattherāpadānaṃ ",
  "tha-ap273:1.1": "ekāsanaṃ ahamadaṃ ",
  "tha-ap273:1.2": "pasanno sehi pāṇihi, ",
  "tha-ap273:1.3": "bimbohanañca pādāsiṃ ",
  "tha-ap273:1.4": "uttamatthassa pattiyā. ",
  "tha-ap273:2.1": "ekanavute ito kappe ",
  "tha-ap273:2.2": "bimbohanamadāsahaṃ, ",
  "tha-ap273:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap273:2.4": "bimbohanassidaṃ phalaṃ. ",
  "tha-ap273:3.1": "ito tesaṭṭhime kappe ",
  "tha-ap273:3.2": "asamo nāma khattiyo, ",
  "tha-ap273:3.3": "sattaratanasampanno ",
  "tha-ap273:3.4": "cakkavattī mahabbalo. ",
  "tha-ap273:4.1": "paṭisambhidā catasso ",
  "tha-ap273:4.2": "vimokkhāpi ca aṭṭhime, ",
  "tha-ap273:4.3": "chaḷabhiññā sacchikatā ",
  "tha-ap273:4.4": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap273:5.1": "itthaṃ sudaṃ āyasmā suvaṇṇabimbohaniyo thero imā gāthāyo abhāsitthāti. ",
  "tha-ap273:6.1": "suvaṇṇabimbohaniyattherassa apadānaṃ paṭhamaṃ. "
}
