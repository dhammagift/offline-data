{
  "tha-ap169:0.1": "",
  "tha-ap169:0.2": "",
  "tha-ap169:0.3": "167. yūthikāpupphiyattherāpadānaṃ. ",
  "tha-ap169:1.1": "candabhāgānadītīre ",
  "tha-ap169:1.2": "anusotaṃ vajāmahaṃ, ",
  "tha-ap169:1.3": "sayambhuṃ addasaṃ tattha ",
  "tha-ap169:1.4": "sālarājaṃ’va phullitaṃ. ",
  "tha-ap169:2.1": "pupphaṃ yūthikamādāya ",
  "tha-ap169:2.2": "upagacchiṃ mahāmuniṃ, ",
  "tha-ap169:2.3": "pasannacitto sumano ",
  "tha-ap169:2.4": "buddhassa abhiropayiṃ. ",
  "tha-ap169:3.1": "catunavute ito kappe ",
  "tha-ap169:3.2": "yaṃ pupphamabhipūjayiṃ, ",
  "tha-ap169:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap169:3.4": "buddhapūjāyidaṃ phalaṃ. ",
  "tha-ap169:4.1": "sattasaṭṭhimhi‘to kappe ",
  "tha-ap169:4.2": "eko samuddharo ahuṃ, ",
  "tha-ap169:4.3": "sattaratanasampanno ",
  "tha-ap169:4.4": "cakkavattī mahabbalo. ",
  "tha-ap169:5.1": "paṭisambhidā ",
  "tha-ap169:5.2": "…pe… ",
  "tha-ap169:5.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap169:6.1": "itthaṃ sudaṃ āyasmā yūthikāpupphiyo thero imā gāthāyo abhāsitthāti. ",
  "tha-ap169:7.1": "yūthikāpupphiyattherassa apadānaṃ sattamaṃ. "
}
