{
  "tha-ap500:0.1": "",
  "tha-ap500:0.2": "",
  "tha-ap500:0.3": "498. pulinathūpiyattherāpadānaṃ ",
  "tha-ap500:1.1": "himavantassa avidūre ",
  "tha-ap500:1.2": "yamako nāma pabbato, ",
  "tha-ap500:1.3": "assamo sukato mayhaṃ ",
  "tha-ap500:1.4": "paṇṇasālā sumāpitā. ",
  "tha-ap500:2.1": "nārado nāma nāmena ",
  "tha-ap500:2.2": "jaṭilo uggatāpano, ",
  "tha-ap500:2.3": "catuddasasahassāni ",
  "tha-ap500:2.4": "sissā paricaranti maṃ. ",
  "tha-ap500:3.1": "paṭisallīnako santo ",
  "tha-ap500:3.2": "evaṃ cintesahaṃ tadā: ",
  "tha-ap500:3.3": "sabbo jano maṃ pūjeti ",
  "tha-ap500:3.4": "nāhaṃ pūjemi kiñcanaṃ. ",
  "tha-ap500:4.1": "na me ovādako atthi ",
  "tha-ap500:4.2": "vattā koci na vijjati, ",
  "tha-ap500:4.3": "anācariyupajjhāyo ",
  "tha-ap500:4.4": "vane vāsaṃ upemahaṃ. ",
  "tha-ap500:5.1": "upāsamāno yamahaṃ ",
  "tha-ap500:5.2": "garucittaṃ upaṭṭhahe, ",
  "tha-ap500:5.3": "so me ācariyo natthi ",
  "tha-ap500:5.4": "vanavāso niratthako. ",
  "tha-ap500:6.1": "āyāgamme gavesissaṃ ",
  "tha-ap500:6.2": "garuṃ bhāvaniyaṃ tathā, ",
  "tha-ap500:6.3": "sāvassayo vasissāmi ",
  "tha-ap500:6.4": "na koci garahissati. ",
  "tha-ap500:7.1": "uttānakūlā nadikā ",
  "tha-ap500:7.2": "supatitthā manoramā, ",
  "tha-ap500:7.3": "susuddhapulinākiṇṇā ",
  "tha-ap500:7.4": "avidūre mamassamaṃ. ",
  "tha-ap500:8.1": "nadiṃ amarikaṃ nāma ",
  "tha-ap500:8.2": "upagantvānahaṃ tadā, ",
  "tha-ap500:8.3": "saṃvaḍḍhayitvā pulinaṃ ",
  "tha-ap500:8.4": "akaṃ pulinacetiyaṃ. ",
  "tha-ap500:9.1": "ye te ahesuṃ sambuddhā ",
  "tha-ap500:9.2": "bhavantakaraṇā munī, ",
  "tha-ap500:9.3": "tesaṃ etādiso thūpo ",
  "tha-ap500:9.4": "tantimittaṃ karomahaṃ. ",
  "tha-ap500:10.1": "karitvā pulinaṃ thūpaṃ ",
  "tha-ap500:10.2": "sovaṇṇaṃ māpayiṃ ahaṃ, ",
  "tha-ap500:10.3": "soṇṇakiṅkaṇipupphānaṃ ",
  "tha-ap500:10.4": "sahasse tīṇi pūjayiṃ. ",
  "tha-ap500:11.1": "sāyaṃ pātaṃ namassāmi ",
  "tha-ap500:11.2": "vedajāto katañjalī, ",
  "tha-ap500:11.3": "sammukhā viya sambuddhā ",
  "tha-ap500:11.4": "vandiṃ pulinacetiyaṃ. ",
  "tha-ap500:12.1": "yadā kilesā jāyanti ",
  "tha-ap500:12.2": "vitakkā gehanissitā, ",
  "tha-ap500:12.3": "sarāmi sugataṃ thūpaṃ ",
  "tha-ap500:12.4": "paccavekkhāmi tāvade. ",
  "tha-ap500:13.1": "upanissāya viharaṃ ",
  "tha-ap500:13.2": "satthavāhaṃ vināyakaṃ, ",
  "tha-ap500:13.3": "kilese saṃvaseyyāsi ",
  "tha-ap500:13.4": "na yuttaṃ tava mārisa. ",
  "tha-ap500:14.1": "saha āvajjite thūpe ",
  "tha-ap500:14.2": "gāravaṃ hoti me tadā, ",
  "tha-ap500:14.3": "kuvitakke vinodemi ",
  "tha-ap500:14.4": "nāgo tuttaṭṭito yathā. ",
  "tha-ap500:15.1": "evaṃ viharamānaṃ maṃ ",
  "tha-ap500:15.2": "maccurājābhimaddatha, ",
  "tha-ap500:15.3": "tattha kālakato santo ",
  "tha-ap500:15.4": "brahmalokaṃ agacchahaṃ. ",
  "tha-ap500:16.1": "yāvatāyuṃ vasitvāna ",
  "tha-ap500:16.2": "tidase upapajjahaṃ, ",
  "tha-ap500:16.3": "asītikkhattuṃ devindo ",
  "tha-ap500:16.4": "devarajjamakārayiṃ. ",
  "tha-ap500:17.1": "satānaṃ tīṇikkhattuñca ",
  "tha-ap500:17.2": "cakkavattī ahosahaṃ, ",
  "tha-ap500:17.3": "padesarajjaṃ vipulaṃ ",
  "tha-ap500:17.4": "gaṇanāto asaṃkhiyaṃ. tesaṃ ",
  "tha-ap500:18.1": "kiṅkaṇipupphānaṃ ",
  "tha-ap500:18.2": "vipākaṃ anubhomahaṃ, ",
  "tha-ap500:18.3": "dhātīsatasahassāni ",
  "tha-ap500:18.4": "parivārenti maṃ bhave. ",
  "tha-ap500:19.1": "thūpassa pariciṇṇattā ",
  "tha-ap500:19.2": "rajojallaṃ na limpati, ",
  "tha-ap500:19.3": "gatte sedā na muccanti ",
  "tha-ap500:19.4": "sappabhāso bhavāmahaṃ. ",
  "tha-ap500:20.1": "aho me sukato thūpo ",
  "tha-ap500:20.2": "sudiṭṭhāmarikā nadī, ",
  "tha-ap500:20.3": "thūpaṃ katvāna pulinaṃ ",
  "tha-ap500:20.4": "pattomhi acalaṃ padaṃ. ",
  "tha-ap500:21.1": "kusalaṃ kattukāmena ",
  "tha-ap500:21.2": "jantunā saragāhinā, ",
  "tha-ap500:21.3": "natthi khettaṃ akhettaṃ vā ",
  "tha-ap500:21.4": "paṭipattīva sādhakā. ",
  "tha-ap500:22.1": "yathāpi balavā poso ",
  "tha-ap500:22.2": "aṇṇavaṃ taritussahe, ",
  "tha-ap500:22.3": "parittaṃ kaṭṭhamādāya ",
  "tha-ap500:22.4": "pakkakhandeyya mahāsaraṃ: ",
  "tha-ap500:23.1": "imāhaṃ kaṭṭhaṃ nissāya ",
  "tha-ap500:23.2": "tarissāmi mahodadhiṃ, ",
  "tha-ap500:23.3": "ussāhena ca viriyena ",
  "tha-ap500:23.4": "tareyya udadhiṃ naro. ",
  "tha-ap500:24.1": "tatheva me kataṃ kammaṃ ",
  "tha-ap500:24.2": "parittaṃ thokakañca yaṃ, ",
  "tha-ap500:24.3": "taṃ kammaṃ upanissāya ",
  "tha-ap500:24.4": "saṃsāraṃ samatikkamiṃ. ",
  "tha-ap500:25.1": "pacchime bhave sampatte ",
  "tha-ap500:25.2": "sukkamūlena codito, ",
  "tha-ap500:25.3": "sāvatthiyaṃ pure jāto ",
  "tha-ap500:25.4": "mahāsāle suaḍḍhake. ",
  "tha-ap500:26.1": "saddhā mātāpitā mayhaṃ ",
  "tha-ap500:26.2": "buddhassa saraṇaṃ gatā, ",
  "tha-ap500:26.3": "ubho diṭṭhapadā ete ",
  "tha-ap500:26.4": "anuvattanti sāsanaṃ. ",
  "tha-ap500:27.1": "bodhipapaṭikaṃ gayha ",
  "tha-ap500:27.2": "soṇṇathūpaṃ akārayuṃ, ",
  "tha-ap500:27.3": "sāyaṃpātaṃ namassanti ",
  "tha-ap500:27.4": "sakyaputtassa sambukhā. ",
  "tha-ap500:28.1": "uposathamhi divase ",
  "tha-ap500:28.2": "soṇṇathūpaṃ vinīharuṃ, ",
  "tha-ap500:28.3": "buddhassa vaṇṇaṃ kittentā ",
  "tha-ap500:28.4": "tiyāmaṃ vītināmayuṃ. ",
  "tha-ap500:29.1": "saha disvānahaṃ thūpaṃ ",
  "tha-ap500:29.2": "sariṃ pulinacetiyaṃ, ",
  "tha-ap500:29.3": "ekāsane nisīditvā ",
  "tha-ap500:29.4": "arahattamapāpuṇiṃ. ",
  "tha-ap500:30.1": "(dvāvīsatimaṃ bhāṇavāraṃ.) ",
  "tha-ap500:31.1": "gavesamāno taṃ vīraṃ ",
  "tha-ap500:31.2": "dhammasenāpatiddasaṃ, ",
  "tha-ap500:31.3": "agārā nikkhamitvāna ",
  "tha-ap500:31.4": "pabbajiṃ tassa santike. ",
  "tha-ap500:32.1": "jātiyā sattavassena ",
  "tha-ap500:32.2": "arahattamapāpuṇiṃ, ",
  "tha-ap500:32.3": "upasampādayī buddho ",
  "tha-ap500:32.4": "guṇamaññāya cakkhumā ",
  "tha-ap500:33.1": "dārakeneva santena ",
  "tha-ap500:33.2": "kiriyaṃ niṭṭhitaṃ mayā, ",
  "tha-ap500:33.3": "kataṃ me karaṇīyajja ",
  "tha-ap500:33.4": "sakyaputtassa sāsane. ",
  "tha-ap500:34.1": "sabbaverabhayātīto ",
  "tha-ap500:34.2": "sabbasaṅgātigo isi, ",
  "tha-ap500:34.3": "sāvako te mahāvīra ",
  "tha-ap500:34.4": "soṇṇapupphassasidaṃ phalaṃ. ",
  "tha-ap500:35.1": "kilesā jhāpitā mayhaṃ ",
  "tha-ap500:35.2": "bhavā sabbe samūhatā, nāgo’va bandhanaṃ chetvā ",
  "tha-ap500:35.3": "viharāmi anāsavo. ",
  "tha-ap500:36.1": "svāgataṃ vata me āsi ",
  "tha-ap500:36.2": "buddhaseṭṭhassa santike, tisso vijjā anuppattā ",
  "tha-ap500:36.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap500:37.1": "paṭisambhidā catasso ",
  "tha-ap500:37.2": "ca vimokkhāpi ca aṭṭhime, chaḷabhiññā sacchikatā ",
  "tha-ap500:37.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap500:38.1": "itthaṃ sudaṃ āyasmā pilinathūpiyo thero imā gāthāyo abhāsitthāti. ",
  "tha-ap500:39.1": "pulinathūpiyattherassa apadānaṃ aṭṭhamaṃ. "
}
