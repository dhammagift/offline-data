{
  "tha-ap423:0.1": "bhaddālivaggo dvācattāḷisatimo. ",
  "tha-ap423:0.2": "43. sakiṃsammajjakavaggo ",
  "tha-ap423:0.3": "421. sakiṃsammajjakattherāpadānaṃ. ",
  "tha-ap423:1.1": "vipassino bhagavato ",
  "tha-ap423:1.2": "pāṭaliṃ bodhimuttamaṃ, ",
  "tha-ap423:1.3": "disvāva taṃ pādapaggaṃ ",
  "tha-ap423:1.4": "tattha cittaṃ pasādayiṃ. ",
  "tha-ap423:2.1": "sammajjaniṃ gahetvāna ",
  "tha-ap423:2.2": "bodhiṃ sammajji tāvade, ",
  "tha-ap423:2.3": "sammajjitvāna taṃ bodhiṃ ",
  "tha-ap423:2.4": "avandiṃ pāṭaliṃ ahaṃ. ",
  "tha-ap423:3.1": "tattha cittaṃ pasādetvā ",
  "tha-ap423:3.2": "sire katvāna añjaliṃ, ",
  "tha-ap423:3.3": "namassamāno taṃ bodhiṃ ",
  "tha-ap423:3.4": "gacchiṃ paṭikūṭī ahaṃ. ",
  "tha-ap423:4.1": "cārimaggena gacchāmi ",
  "tha-ap423:4.2": "saranto bodhimuttamaṃ, ",
  "tha-ap423:4.3": "ajagaro maṃ pīḷesi ",
  "tha-ap423:4.4": "ghorarūpo mahābalo. ",
  "tha-ap423:5.1": "āsanne me kataṃ kammaṃ ",
  "tha-ap423:5.2": "phalena tosayī mamaṃ, ",
  "tha-ap423:5.3": "kaḷebaraṃ me gilati ",
  "tha-ap423:5.4": "devaloke ramāmahaṃ ",
  "tha-ap423:6.1": "anāvilaṃ mama cittaṃ ",
  "tha-ap423:6.2": "visuddhaṃ paṇḍaraṃ sadā, ",
  "tha-ap423:6.3": "sokasallaṃ na jānāmi ",
  "tha-ap423:6.4": "cittasantāpanaṃ mama. ",
  "tha-ap423:7.1": "kuṭṭhaṃ gaṇḍo kilāso ca ",
  "tha-ap423:7.2": "apamāro vitacchikā, ",
  "tha-ap423:7.3": "daddu kaṇḍu ca me natthi ",
  "tha-ap423:7.4": "phalaṃ sammajjane idaṃ. ",
  "tha-ap423:8.1": "soko ca paridevo ca ",
  "tha-ap423:8.2": "hadaye me na vijjati, ",
  "tha-ap423:8.3": "abhantaṃ ujukaṃ cittaṃ ",
  "tha-ap423:8.4": "phalaṃ sammajjane idaṃ. ",
  "tha-ap423:9.1": "samādhīsu na sajjāmi ",
  "tha-ap423:9.2": "visadaṃ hoti mānasaṃ, ",
  "tha-ap423:9.3": "yaṃ yaṃ samādhimicchāmi ",
  "tha-ap423:9.4": "so so sampajjate mama. ",
  "tha-ap423:10.1": "rajanīye na rajjāmi ",
  "tha-ap423:10.2": "atho dosaniyesu ca, ",
  "tha-ap423:10.3": "mohanīye na muyhāmi ",
  "tha-ap423:10.4": "phalaṃ sammajjane idaṃ. ",
  "tha-ap423:11.1": "ekanavute ito kappe ",
  "tha-ap423:11.2": "yaṃ kammamakariṃ tadā, ",
  "tha-ap423:11.3": "duggatiṃ nābhijānāmi ",
  "tha-ap423:11.4": "phalaṃ sammajjane idaṃ. ",
  "tha-ap423:12.1": "kilesā jhāpitā mayhaṃ ",
  "tha-ap423:12.2": "bhavā sabbe samūhatā, ",
  "tha-ap423:12.3": "nāgo’ca bandhanaṃ chetvā ",
  "tha-ap423:12.4": "viharāmi anāsavo. ",
  "tha-ap423:13.1": "svāgataṃ vata me āsi ",
  "tha-ap423:13.2": "buddhaseṭṭhassa santike, ",
  "tha-ap423:13.3": "tisso vijjā anuppattā ",
  "tha-ap423:13.4": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap423:14.1": "paṭisambhidā catasso ",
  "tha-ap423:14.2": "vimokkhā pi ca aṭṭhime, ",
  "tha-ap423:14.3": "chaḷabhiññā sacchikatā ",
  "tha-ap423:14.4": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap423:15.1": "itthaṃ sudaṃ āyasmā sakiṃsammajjako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap423:16.1": "sakiṃsammajjakattherassa apadānaṃ paṭhamaṃ. "
}
