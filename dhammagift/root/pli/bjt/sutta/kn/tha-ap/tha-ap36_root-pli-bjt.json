{
  "tha-ap36:0.1": "",
  "tha-ap36:0.2": "",
  "tha-ap36:0.3": "34. kāḷudāyittherāpadānaṃ. ",
  "tha-ap36:1.1": "padumuttarabuddhassa ",
  "tha-ap36:1.2": "lokajeṭṭhassa tādino, ",
  "tha-ap36:1.3": "addhānaṃ paṭipannassa ",
  "tha-ap36:1.4": "carato cārikaṃ tadā. ",
  "tha-ap36:2.1": "suphullaṃ padumaṃ gayha ",
  "tha-ap36:2.2": "uppalaṃ mallikañcahaṃ, ",
  "tha-ap36:2.3": "paramannaṃ gahetvāna ",
  "tha-ap36:2.4": "adāsiṃ satthuno ahaṃ. ",
  "tha-ap36:3.1": "paribhuñji mahāvīro ",
  "tha-ap36:3.2": "paramannaṃ subhojanaṃ, ",
  "tha-ap36:3.3": "tañca pupphaṃ gahetvāna ",
  "tha-ap36:3.4": "janassa sampadassayī. ",
  "tha-ap36:4.1": "“iṭṭhaṃ kantaṃ piyaṃ loke ",
  "tha-ap36:4.2": "jalajaṃ pupphamuttamaṃ, ",
  "tha-ap36:4.3": "sudukkaraṃ tena kataṃ ",
  "tha-ap36:4.4": "yo me pupphaṃ adāsi’daṃ. ",
  "tha-ap36:5.1": "yo pupphamabhiropesi ",
  "tha-ap36:5.2": "paramannañca’dāsi me, ",
  "tha-ap36:5.3": "tamahaṃ kittayissāmi ",
  "tha-ap36:5.4": "suṇātha mama bhāsato. ",
  "tha-ap36:6.1": "dasa caṭṭhakkhattuṃ so ",
  "tha-ap36:6.2": "devarajjaṃ karissati, ",
  "tha-ap36:6.3": "uppalaṃ padumañcāpi ",
  "tha-ap36:6.4": "mallikañca taduttari. ",
  "tha-ap36:7.1": "assa puññavipākena ",
  "tha-ap36:7.2": "dibbagandhasamāyutaṃ, ",
  "tha-ap36:7.3": "ākāse chadanaṃ katvā ",
  "tha-ap36:7.4": "dhārayissati tāvade. ",
  "tha-ap36:8.1": "pañcavīsatikkhattuñca ",
  "tha-ap36:8.2": "cakkavattī bhavissati, ",
  "tha-ap36:8.3": "pathavyā rajjaṃ pañcasataṃ ",
  "tha-ap36:8.4": "vasudhaṃ āvasissatī. ",
  "tha-ap36:9.1": "kappasatasahassamhi ",
  "tha-ap36:9.2": "okkākakulasambhavo, ",
  "tha-ap36:9.3": "gotamo nāma gottena ",
  "tha-ap36:9.4": "satthā loke bhavissati. ",
  "tha-ap36:10.1": "sakakammābhiraddho so ",
  "tha-ap36:10.2": "sukkamūlena codito, ",
  "tha-ap36:10.3": "sakyānaṃ nandijanano ",
  "tha-ap36:10.4": "ñātibandhu bhavissati. ",
  "tha-ap36:11.1": "so pacchā pabbajitvāna ",
  "tha-ap36:11.2": "sukkamūlena codito, ",
  "tha-ap36:11.3": "sabbāsave pariññāya ",
  "tha-ap36:11.4": "nibbāyissata’nāsavo. paṭisambhidā ",
  "tha-ap36:12.1": "ca’nuppattaṃ ",
  "tha-ap36:12.2": "katakiccamanāsavaṃ, ",
  "tha-ap36:12.3": "gotamo lokabandhu so ",
  "tha-ap36:12.4": "etadagge ṭhapessati. ",
  "tha-ap36:13.1": "padhānapahitatto so ",
  "tha-ap36:13.2": "upasanto nirūpadhi, ",
  "tha-ap36:13.3": "udāyi nāma nāmena ",
  "tha-ap36:13.4": "hessati satthu sāvako.” ",
  "tha-ap36:14.1": "rāgo doso ca moho ca ",
  "tha-ap36:14.2": "māno makkho ca dhaṃsito, ",
  "tha-ap36:14.3": "sabbāsave pariññāya ",
  "tha-ap36:14.4": "viharāmi anāsavo. ",
  "tha-ap36:15.1": "tosayiñcāpi sambuddhaṃ ",
  "tha-ap36:15.2": "ātāpī nipako ahaṃ, ",
  "tha-ap36:15.3": "pamodito ca sambuddho ",
  "tha-ap36:15.4": "etadagge ṭhapesi maṃ. ",
  "tha-ap36:16.1": "paṭisambhidā ",
  "tha-ap36:16.2": "…pe… ",
  "tha-ap36:16.3": "buddhassa sāsanaṃ. ",
  "tha-ap36:17.1": "itthaṃ sudaṃ āyasmā kāḷudāyī thero imā gāthāyo abhāsitthāti. ",
  "tha-ap36:18.1": "kāḷudāyittherassāpadānaṃ catutthaṃ. "
}
