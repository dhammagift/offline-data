{
  "tha-ap246:0.1": "",
  "tha-ap246:0.2": "",
  "tha-ap246:0.3": "244. viravipupphiyattherāpadānaṃ ",
  "tha-ap246:1.1": "khīṇāsavasahassehi ",
  "tha-ap246:1.2": "niyyāti lokanāyako, ",
  "tha-ap246:1.3": "viravipupphaṃ paggayha ",
  "tha-ap246:1.4": "buddhassa abhiropayiṃ. ",
  "tha-ap246:2.1": "ekanavute ito kappe ",
  "tha-ap246:2.2": "yaṃ pupphamabhipūjayiṃ, ",
  "tha-ap246:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap246:2.4": "buddhapūjāyidaṃ phalaṃ. ",
  "tha-ap246:3.1": "paṭisambhidā catasso ",
  "tha-ap246:3.2": "vimokkhāpi ca aṭṭhime, chaḷabhiññā sacchikatā ",
  "tha-ap246:3.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap246:4.1": "itthaṃ sudaṃ āyasmā viravipupphiyo thero imā gāthāyo abhāsitthāti. ",
  "tha-ap246:5.1": "viravipupphiyattherassa apadānaṃ catutthaṃ. "
}
