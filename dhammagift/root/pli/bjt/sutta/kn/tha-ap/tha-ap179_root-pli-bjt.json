{
  "tha-ap179:0.1": "",
  "tha-ap179:0.2": "",
  "tha-ap179:0.3": "177. ekadīpiyattherāpadānaṃ ",
  "tha-ap179:1.1": "padumuttarassa munino ",
  "tha-ap179:1.2": "salale bodhimuttame, ",
  "tha-ap179:1.3": "pasannacitto sumano ",
  "tha-ap179:1.4": "ekadīpaṃ adāsahaṃ. ",
  "tha-ap179:2.1": "bhave nibbattamānamhi ",
  "tha-ap179:2.2": "nibbatte puññasañcaye, ",
  "tha-ap179:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap179:2.4": "dīpadānassidaṃ phalaṃ. ",
  "tha-ap179:3.1": "soḷasakappasahasse ",
  "tha-ap179:3.2": "ito te caturo janā, ",
  "tha-ap179:3.3": "candābhā nāma nāmena ",
  "tha-ap179:3.4": "cakkavattī mahabbalā. ",
  "tha-ap179:4.1": "paṭisambhidā catasso ",
  "tha-ap179:4.2": "vimokkhāpi ca aṭṭhime, chaḷabhiññā sacchikatā ",
  "tha-ap179:4.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap179:5.1": "itthaṃ sudaṃ āyasmā ekadīpiyo thero imā gāthāyo abhāsitthāti. ",
  "tha-ap179:6.1": "ekadīpiyattherassa apadānaṃ sattamaṃ. ",
  "tha-ap179:6.2": "navamaṃ bhāṇavāraṃ. "
}
