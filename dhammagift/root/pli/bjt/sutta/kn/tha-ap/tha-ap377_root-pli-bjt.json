{
  "tha-ap377:0.1": "",
  "tha-ap377:0.2": "",
  "tha-ap377:0.3": "375. sattapaṇṇiyattherāpadānaṃ. ",
  "tha-ap377:1.1": "sumano nāma sambuddho ",
  "tha-ap377:1.2": "uppajji lokanāyako, ",
  "tha-ap377:1.3": "pasannacitto sumano ",
  "tha-ap377:1.4": "sattapaṇṇimapūjayiṃ. ",
  "tha-ap377:2.1": "satasahasse ito kappe ",
  "tha-ap377:2.2": "sattapaṇṇimapūjayiṃ, ",
  "tha-ap377:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap377:2.4": "sattapaṇṇissidaṃ phalaṃ. ",
  "tha-ap377:3.1": "",
  "tha-ap377:3.2": "",
  "tha-ap377:3.3": "",
  "tha-ap377:4.1": "svāgataṃ vata me āsi ",
  "tha-ap377:4.2": "buddhaseṭṭhassa santike, tisso vijjā anuppattā ",
  "tha-ap377:4.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap377:5.1": "kilesā jhāpitā mayhaṃ bhavā sabbe samūhatā, nāgova bandhanaṃ chetvā viharāmi anāsavo. paṭisambhidā catasso ",
  "tha-ap377:5.2": "vimokkhāpi ca aṭṭhime, chaḷabhiññā sacchikatā ",
  "tha-ap377:5.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap377:6.1": "itthaṃ sudaṃ āyasmā sattapaṇṇiyo thero imā gāthāyo abhāsitthāti. ",
  "tha-ap377:7.1": "sattapaṇṇiyattherassa apadānaṃ pañcamaṃ. "
}
