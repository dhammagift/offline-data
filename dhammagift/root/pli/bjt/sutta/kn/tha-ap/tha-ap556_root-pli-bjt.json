  "tha-ap556:0.1": "",
  "tha-ap556:0.2": "",
  "tha-ap556:0.3": "554. kimbilattherāpadānaṃ ",
  "tha-ap556:1.1": "nibbute kakusandhasmiṃ ",
  "tha-ap556:1.2": "brāhmaṇasmiṃ vusīmati, ",
  "tha-ap556:1.3": "gahetvā salalaṃ mālaṃ ",
  "tha-ap556:1.4": "maṇḍapaṃ kārayiṃ ahaṃ. ",
  "tha-ap556:2.1": "tāvatiṃsaṃ gato santo ",
  "tha-ap556:2.2": "labhimha vyamhamuttamaṃ, ",
  "tha-ap556:2.3": "aññe deve’tirocāmi ",
  "tha-ap556:2.4": "puññakammassidaṃ phalaṃ. ",
  "tha-ap556:3.1": "divā vā yadi vā rattiṃ ",
  "tha-ap556:3.2": "caṅkamanto ṭhito cahaṃ, ",
  "tha-ap556:3.3": "channo salalapupphehi ",
  "tha-ap556:3.4": "puññakammassidaṃ phalaṃ. ",
  "tha-ap556:4.1": "imasmiṃ yeva kappamhi ",
  "tha-ap556:4.2": "yaṃ buddhamhipūjayiṃ, ",
  "tha-ap556:4.3": "duggatiṃ nābhijānāmi ",
  "tha-ap556:4.4": "buddhapūjāyidaṃ phalaṃ. ",
  "tha-ap556:5.1": "kilesā jhāpitā mayhaṃ ",
  "tha-ap556:5.2": "bhavā sabbe samūhatā, nāgo’va bandhanaṃ chetvā ",
  "tha-ap556:5.3": "viharāmi anāsavo. ",
  "tha-ap556:6.1": "svāgataṃ vata me āsi ",
  "tha-ap556:6.2": "buddhaseṭṭhassa santike, tisso vijjā anuppattā ",
  "tha-ap556:6.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap556:7.1": "paṭisambhidā catasso ",
  "tha-ap556:7.2": "ca vimokkhā pi ca aṭṭhi’me, chaḷabhiññā sacchikatā ",
  "tha-ap556:7.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap556:8.1": "itthaṃ sudaṃ āyasmā kimbilo thero imā gāthāyo abhāsitthāti. ",
  "tha-ap556:9.1": "kimbilattherāpadānaṃ catutthaṃ. "
}
