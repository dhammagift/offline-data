{
  "tha-ap51:0.1": "",
  "tha-ap51:0.2": "",
  "tha-ap51:0.3": "49. subhaddattherāpadānaṃ ",
  "tha-ap51:1.1": "padumuttaro lokavidū ",
  "tha-ap51:1.2": "āhutīnaṃ paṭiggaho, ",
  "tha-ap51:1.3": "janataṃ uddharitvāna ",
  "tha-ap51:1.4": "nibbāyati mahāyaso. ",
  "tha-ap51:2.1": "nibbāyante ca sambuddhe ",
  "tha-ap51:2.2": "dasasahassī pakampatha, ",
  "tha-ap51:2.3": "janakāyo mahā āsi ",
  "tha-ap51:2.4": "devā sannipatuṃ tadā. ",
  "tha-ap51:3.1": "vandanaṃ pūjayitvāna ",
  "tha-ap51:3.2": "tagaramallikāhi ca, ",
  "tha-ap51:3.3": "haṭṭho haṭṭhena cittena ",
  "tha-ap51:3.4": "ālepesiṃ naruttamaṃ. ",
  "tha-ap51:4.1": "mama saṅkappamaññāya ",
  "tha-ap51:4.2": "satthā loke anuttaro, ",
  "tha-ap51:4.3": "nipannakova sambuddho ",
  "tha-ap51:4.4": "imā gāthā abhāsatha: ",
  "tha-ap51:5.1": "“yo me pacchimake kāle ",
  "tha-ap51:5.2": "gandhamālyena chādayī, ",
  "tha-ap51:5.3": "tamahaṃ kittayissāmi ",
  "tha-ap51:5.4": "suṇātha mama bhāsato. ",
  "tha-ap51:6.1": "ito cuto ayaṃ poso ",
  "tha-ap51:6.2": "tusitakāyaṃ gamissati, ",
  "tha-ap51:6.3": "tattha rajjaṃ karitvāna ",
  "tha-ap51:6.4": "nimmānaṃ so gamissati. ",
  "tha-ap51:7.1": "eteneva upāyena ",
  "tha-ap51:7.2": "datvā malyaṃ varuttamaṃ, ",
  "tha-ap51:7.3": "sakakammābhiraddho so ",
  "tha-ap51:7.4": "sampattiṃ anubhossati. ",
  "tha-ap51:8.1": "punāpi tusite kāye ",
  "tha-ap51:8.2": "nibbattissatayaṃ naro, ",
  "tha-ap51:8.3": "tamhā kāyā cavitvāna ",
  "tha-ap51:8.4": "manussattaṃ gamissati. ",
  "tha-ap51:9.1": "sakyaputto mahānāgo ",
  "tha-ap51:9.2": "aggo loke sadevake, ",
  "tha-ap51:9.3": "bodhayitvā bahū satte ",
  "tha-ap51:9.4": "nibbāyissati cakkhumā. ",
  "tha-ap51:10.1": "pabbajjūpagato santo ",
  "tha-ap51:10.2": "sukkamūlena codito, ",
  "tha-ap51:10.3": "upasaṅkamma sambuddhaṃ ",
  "tha-ap51:10.4": "pañhaṃ pucchissatī tadā. ",
  "tha-ap51:11.1": "hāsayitvāna sambuddho ",
  "tha-ap51:11.2": "sabbaññū lokanāyako, ",
  "tha-ap51:11.3": "puññakammaṃ pariññāya ",
  "tha-ap51:11.4": "saccāni vivarissati. ",
  "tha-ap51:12.1": "āraddho ca ayaṃ pañhe ",
  "tha-ap51:12.2": "tuṭṭho ekaggamānaso, ",
  "tha-ap51:12.3": "satthāraṃ abhivādetvā ",
  "tha-ap51:12.4": "pabbajjaṃ yācayissati. ",
  "tha-ap51:13.1": "pasannamānasaṃ disvā ",
  "tha-ap51:13.2": "sakkammena tositaṃ, ",
  "tha-ap51:13.3": "pabbājessati so buddho ",
  "tha-ap51:13.4": "aggadhammassa kovido. ",
  "tha-ap51:14.1": "vāyamitvāna’yaṃ poso ",
  "tha-ap51:14.2": "sammāsambuddhasāsane, ",
  "tha-ap51:14.3": "sabbāsave pariññāya ",
  "tha-ap51:14.4": "nibbāyissatanāsavo”. ",
  "tha-ap51:15.1": "(pañcamahāṇavāraṃ.) ",
  "tha-ap51:16.1": "pubbakammena saṃyutto ",
  "tha-ap51:16.2": "ekaggo susamāhito, ",
  "tha-ap51:16.3": "buddhassa oraso putto ",
  "tha-ap51:16.4": "dhammajo’mhi sunimmito. ",
  "tha-ap51:17.1": "dhammarājaṃ upāgamma ",
  "tha-ap51:17.2": "āpucchiṃ pañhamuttamaṃ, ",
  "tha-ap51:17.3": "kathayanto ca me pañhaṃ ",
  "tha-ap51:17.4": "dhammasotaṃ upānayī. ",
  "tha-ap51:18.1": "tassāhaṃ dhammamaññāya ",
  "tha-ap51:18.2": "vihāsiṃ sāsane rato, ",
  "tha-ap51:18.3": "sabbāsave pariññāya ",
  "tha-ap51:18.4": "viharāmi anāsavo. ",
  "tha-ap51:19.1": "satasahasse ito kappe ",
  "tha-ap51:19.2": "jalajuttaranāyako, ",
  "tha-ap51:19.3": "nibbāyi anupādāno ",
  "tha-ap51:19.4": "dīpo’va telasaṅkhayā. ",
  "tha-ap51:20.1": "sattayojanikaṃ āsi ",
  "tha-ap51:20.2": "thūpañca ratanāmayaṃ, ",
  "tha-ap51:20.3": "dhajaṃ tattha apūjesiṃ ",
  "tha-ap51:20.4": "sabbabhaddaṃ manoramaṃ. ",
  "tha-ap51:21.1": "kassapassa ca buddhassa ",
  "tha-ap51:21.2": "tisso nāmaggasāvako, ",
  "tha-ap51:21.3": "putto me oraso āsi ",
  "tha-ap51:21.4": "dāyādo jinasāsane. ",
  "tha-ap51:22.1": "tassa hīnena manasā ",
  "tha-ap51:22.2": "vācaṃ bhāsiṃ abhaddakaṃ, ",
  "tha-ap51:22.3": "tena kammavipākena ",
  "tha-ap51:22.4": "pacchime addasaṃ jinaṃ. ",
  "tha-ap51:23.1": "upavattane sālavane ",
  "tha-ap51:23.2": "pacchime sayane muni, ",
  "tha-ap51:23.3": "pabbājesi mahāvīro ",
  "tha-ap51:23.4": "hito kāruṇiko jino. ",
  "tha-ap51:24.1": "ajjeva’dāni pabbajā ",
  "tha-ap51:24.2": "ajjeva upasampadā, ",
  "tha-ap51:24.3": "ajjeva parinibbāṇaṃ ",
  "tha-ap51:24.4": "sammukhā dipaduttame. ",
  "tha-ap51:25.1": "paṭisambhidā ",
  "tha-ap51:25.2": "…pe… ",
  "tha-ap51:25.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap51:26.1": "itthaṃ sudaṃ āyasmā subhaddo thero imā gāthāyo abhāsitthāti. ",
  "tha-ap51:27.1": "subhaddattherassa apadānaṃ navamaṃ. "
}
