{
  "tha-ap241:0.1": "",
  "tha-ap241:0.2": "",
  "tha-ap241:0.3": "239. jagatikārakattherāpadānaṃ. ",
  "tha-ap241:1.1": "nibbute lokanāthambhi ",
  "tha-ap241:1.2": "atthadassi naruttame, ",
  "tha-ap241:1.3": "jagatī kāritā mayhaṃ ",
  "tha-ap241:1.4": "buddhassa thūpamuttame. ",
  "tha-ap241:2.1": "aṭṭhārase kappasate ",
  "tha-ap241:2.2": "yaṃ kammamakariṃ tadā, ",
  "tha-ap241:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap241:2.4": "jagatiyā idaṃ phalaṃ. ",
  "tha-ap241:3.1": "paṭisambhidā catasso ",
  "tha-ap241:3.2": "vimokkhāpi ca aṭṭhime, chaḷabhiññā sacchikatā ",
  "tha-ap241:3.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap241:4.1": "itthaṃ sudaṃ āyasmā jagatikārako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap241:5.1": "jagatikārakattherassa apadānaṃ navamaṃ. "
}
