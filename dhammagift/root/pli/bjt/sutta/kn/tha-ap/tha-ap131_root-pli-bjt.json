{
  "tha-ap131:0.1": "",
  "tha-ap131:0.2": "",
  "tha-ap131:0.3": "129. gandhapupphiyattherāpadānaṃ. ",
  "tha-ap131:1.1": "suvaṇṇavaṇṇo sambuddho ",
  "tha-ap131:1.2": "vipassī dakkhiṇāraho, ",
  "tha-ap131:1.3": "purakkhato sāvakehi ",
  "tha-ap131:1.4": "ārāmā abhinikkhami. ",
  "tha-ap131:2.1": "disvāna’haṃ buddhaseṭṭhaṃ ",
  "tha-ap131:2.2": "sabbaññuṃ tamanāsakaṃ, ",
  "tha-ap131:2.3": "pasannacitto sumano ",
  "tha-ap131:2.4": "gandhapupphaṃ apūjayiṃ. ",
  "tha-ap131:3.1": "tena cittappasādena ",
  "tha-ap131:3.2": "dipadindassa tādino, ",
  "tha-ap131:3.3": "haṭṭho haṭṭhena cittena ",
  "tha-ap131:3.4": "puna vandiṃ tathāgataṃ. ",
  "tha-ap131:4.1": "ekanavute ito kappe ",
  "tha-ap131:4.2": "yaṃ pupphamabhiropayiṃ, ",
  "tha-ap131:4.3": "duggatiṃ nābhijānāmi ",
  "tha-ap131:4.4": "buddhapūjāyidaṃ phalaṃ. ",
  "tha-ap131:5.1": "ekatāḷīsi’to kappe ",
  "tha-ap131:5.2": "caraṇo nāma khattiyo, ",
  "tha-ap131:5.3": "sattaratanasampanno ",
  "tha-ap131:5.4": "cakkavattī mahabbalo. ",
  "tha-ap131:6.1": "paṭisambhidā ",
  "tha-ap131:6.2": "…pe… ",
  "tha-ap131:6.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap131:7.1": "itthaṃ sudaṃ āyasmā gandhapupphiyo thero imā gāthāyo abhāsitthāti. ",
  "tha-ap131:8.1": "gandhapupphiyattherassa apadānaṃ navamaṃ. "
}
