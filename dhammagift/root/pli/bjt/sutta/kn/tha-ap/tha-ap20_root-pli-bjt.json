{
  "tha-ap20:0.1": "",
  "tha-ap20:0.2": "",
  "tha-ap20:0.3": "18. raṭṭhapālattherāpadānaṃ ",
  "tha-ap20:1.1": "padumuttarassa bhagavato ",
  "tha-ap20:1.2": "lokajeṭṭhassa tādino, ",
  "tha-ap20:1.3": "varanāgo mayā dinno ",
  "tha-ap20:1.4": "īsādanto urūḷhavā. ",
  "tha-ap20:2.1": "setacchattopasobhito ",
  "tha-ap20:2.2": "sakappano sahatthipo, ",
  "tha-ap20:2.3": "agghāpetvāna taṃ sabbaṃ ",
  "tha-ap20:2.4": "saṃghārāmaṃ akārayiṃ. ",
  "tha-ap20:3.1": "catupaññāsa sahassāni ",
  "tha-ap20:3.2": "pāsāde kārayiṃ ahaṃ, ",
  "tha-ap20:3.3": "mahābhattaṃ karitvāna ",
  "tha-ap20:3.4": "niyyādesiṃ mahesino. ",
  "tha-ap20:4.1": "anumodi mahāvīro ",
  "tha-ap20:4.2": "sayambhū aggapuggalo, ",
  "tha-ap20:4.3": "sabbe jane hāsayanto ",
  "tha-ap20:4.4": "desesi amataṃ padaṃ. ",
  "tha-ap20:5.1": "taṃ me buddho viyākāsi ",
  "tha-ap20:5.2": "jalajuttaranāmako, ",
  "tha-ap20:5.3": "bhikkhusaṃghe nisīditvā ",
  "tha-ap20:5.4": "imā gāthā abhāsatha. ",
  "tha-ap20:6.1": "catupaññāsa sahassāni ",
  "tha-ap20:6.2": "pāsāde kārayī ayaṃ, ",
  "tha-ap20:6.3": "kathayissāmi vipākaṃ ",
  "tha-ap20:6.4": "suṇotha mama bhāsato. ",
  "tha-ap20:7.1": "aṭṭhārasa sahassāni ",
  "tha-ap20:7.2": "kūṭāgārā bhavissare, ",
  "tha-ap20:7.3": "vyamahuttamamhi nibbattā ",
  "tha-ap20:7.4": "sabbasoṇṇamayā ca te. ",
  "tha-ap20:8.1": "paññāsakkhattuṃ devindo ",
  "tha-ap20:8.2": "devarajjaṃ karissati. ",
  "tha-ap20:8.3": "aṭṭhapaññāsakkhattuñca ",
  "tha-ap20:8.4": "cakkavattī bhavissati. ",
  "tha-ap20:9.1": "kappasatasahassamhi ",
  "tha-ap20:9.2": "okkākakulasambhavo, ",
  "tha-ap20:9.3": "gotamo nāma nāmena ",
  "tha-ap20:9.4": "satthā loke bhavissati. ",
  "tha-ap20:10.1": "devalokā cavitvāna ",
  "tha-ap20:10.2": "sukkamūlena codito, ",
  "tha-ap20:10.3": "aḍḍhe kule mahābhoge ",
  "tha-ap20:10.4": "nibbattissati tāvade. ",
  "tha-ap20:11.1": "so pacchā pabbajitvāna ",
  "tha-ap20:11.2": "sukkamūlena codito, ",
  "tha-ap20:11.3": "raṭṭhapālo’ti nāmena ",
  "tha-ap20:11.4": "hessati satthusāvako. ",
  "tha-ap20:12.1": "padhānapahitatto so ",
  "tha-ap20:12.2": "upasanto nirūpadhi, ",
  "tha-ap20:12.3": "sabbāsave pariññāya ",
  "tha-ap20:12.4": "nibbāyissata’nāsavo. ",
  "tha-ap20:13.1": "uṭṭhāya abhinikkhamma ",
  "tha-ap20:13.2": "jahitā bhogasampadā, ",
  "tha-ap20:13.3": "kheḷapiṇḍeva bhogambhi ",
  "tha-ap20:13.4": "pemaṃ mayhaṃ na vijjati. ",
  "tha-ap20:14.1": "viriyaṃ me dhuradhorayhaṃ ",
  "tha-ap20:14.2": "yogakkhemādhivāhanaṃ, ",
  "tha-ap20:14.3": "dhāremi antimaṃ dehaṃ ",
  "tha-ap20:14.4": "sammāsambuddhasāsane. ",
  "tha-ap20:15.1": "paṭisambhidā …pe… ",
  "tha-ap20:15.2": "",
  "tha-ap20:15.3": "",
  "tha-ap20:15.4": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap20:16.1": "itthaṃ sudaṃ āyasmā raṭṭhapālo thero imā gāthāyo abhāsitthāti. ",
  "tha-ap20:17.1": "raṭṭhapālattherassa apadānaṃ aṭṭhamaṃ. "
}
