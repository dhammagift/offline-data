{
  "tha-ap49:0.1": "",
  "tha-ap49:0.2": "",
  "tha-ap49:0.3": "47. sayanadāyakattherāpadānaṃ ",
  "tha-ap49:1.1": "siddhatthassa bhagavato ",
  "tha-ap49:1.2": "mettacittassa tādino, ",
  "tha-ap49:1.3": "sayanaggaṃ mayā dinnaṃ ",
  "tha-ap49:1.4": "dussabhaṇḍehi atthataṃ. ",
  "tha-ap49:2.1": "paṭiggahesi bhagavā ",
  "tha-ap49:2.2": "kappiyaṃ sayanāsanaṃ, ",
  "tha-ap49:2.3": "uṭṭhāya āsanā tamhā ",
  "tha-ap49:2.4": "vehāsaṃ uggamī jino. ",
  "tha-ap49:3.1": "catunavute ito kappe ",
  "tha-ap49:3.2": "yaṃ sayanamadāsahaṃ, ",
  "tha-ap49:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap49:3.4": "sayanadānassidaṃ phalaṃ. ",
  "tha-ap49:4.1": "ekapaññāsito kappe ",
  "tha-ap49:4.2": "varuṇo devasavhayo, ",
  "tha-ap49:4.3": "sattaratanasampanno ",
  "tha-ap49:4.4": "cakkavattī mahabbalo. ",
  "tha-ap49:5.1": "paṭisambhidā ",
  "tha-ap49:5.2": "…pe… ",
  "tha-ap49:5.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap49:6.1": "itthaṃ sudaṃ āyasmā sayanadāyako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap49:7.1": "sayanadāyakattherassa apadānaṃ sattamaṃ. "
}
