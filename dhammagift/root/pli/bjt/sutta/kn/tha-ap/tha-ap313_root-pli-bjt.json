{
  "tha-ap313:0.1": "padumakesariyavaggo ekatiṃsatimo. ",
  "tha-ap313:0.2": "32. ārakkhadāyakavaggo ",
  "tha-ap313:0.3": "311. ārakkhadāyakattherāpadānaṃ. ",
  "tha-ap313:1.1": "dhammadassissa munino ",
  "tha-ap313:1.2": "vati kārāpitā mayā, ",
  "tha-ap313:1.3": "ārakkho ca mayā dinno ",
  "tha-ap313:1.4": "dipadindassa tādino. ",
  "tha-ap313:2.1": "aṭṭhārase kappasate ",
  "tha-ap313:2.2": "yaṃ kammamakariṃ tadā, ",
  "tha-ap313:2.3": "tena kammavisesena ",
  "tha-ap313:2.4": "patto me āsavakkhayo. ",
  "tha-ap313:3.1": "paṭisambhidā catasso ",
  "tha-ap313:3.2": "vimokkhāpi ca aṭṭhime, ",
  "tha-ap313:3.3": "chaḷabhiññā sacchikatā ",
  "tha-ap313:3.4": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap313:4.1": "itthaṃ sudaṃ āyasmā ārakkhadāyako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap313:5.1": "ārakkhadāyakattherassa apadānaṃ paṭhamaṃ. "
}
