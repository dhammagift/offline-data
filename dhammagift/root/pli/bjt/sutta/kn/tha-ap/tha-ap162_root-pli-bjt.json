{
  "tha-ap162:0.1": "",
  "tha-ap162:0.2": "",
  "tha-ap162:0.3": "160. kumudadāyakattherāpadānaṃ ",
  "tha-ap162:1.1": "himavantassa avidūre ",
  "tha-ap162:1.2": "mahājātassaro ahu, ",
  "tha-ap162:1.3": "padumuppalasañchanno ",
  "tha-ap162:1.4": "puṇḍarīkasamotthaṭo. ",
  "tha-ap162:2.1": "kukuttho nāma nāmena ",
  "tha-ap162:2.2": "tatthāsiṃ sakuṇo tadā, ",
  "tha-ap162:2.3": "sīlavā buddhisampanno ",
  "tha-ap162:2.4": "puññāpuññesu kovido. ",
  "tha-ap162:3.1": "padumuttaro lokavidū ",
  "tha-ap162:3.2": "āhutīnaṃ paṭiggaho, ",
  "tha-ap162:3.3": "jātassarassāvidūre ",
  "tha-ap162:3.4": "sañcarittha mahāmuni. ",
  "tha-ap162:4.1": "jalajaṃ kumudaṃ chetvā ",
  "tha-ap162:4.2": "upanesiṃ mahesino, ",
  "tha-ap162:4.3": "mama saṅkappamaññāya ",
  "tha-ap162:4.4": "paṭiggahi mahāmuni. ",
  "tha-ap162:5.1": "tañca dānaṃ daditvāhaṃ ",
  "tha-ap162:5.2": "sukkamūlena codito, ",
  "tha-ap162:5.3": "kappānaṃ satasahassaṃ ",
  "tha-ap162:5.4": "duggatiṃ nūpapajjahaṃ. ",
  "tha-ap162:6.1": "soḷaseto kappasate ",
  "tha-ap162:6.2": "āsuṃ varuṇanāmakā, ",
  "tha-ap162:6.3": "aṭṭha ete janādhipā ",
  "tha-ap162:6.4": "cakkavattī mahabbalā. ",
  "tha-ap162:7.1": "paṭisambhidā catasso ",
  "tha-ap162:7.2": "vimokkhāpi ca aṭṭhime, chaḷabhiññā sacchikatā ",
  "tha-ap162:7.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap162:8.1": "itthaṃ sudaṃ āyasmā kumudadāyako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap162:9.1": "kumudadāyakattherassa apadānaṃ dasamaṃ. ",
  "tha-ap162:10.1": "uddānaṃ: ",
  "tha-ap162:11.1": "",
  "tha-ap162:12.1": "bandhujīvo tambapupphi ",
  "tha-ap162:12.2": "vīthi kakkārupupphiyo ",
  "tha-ap162:12.3": "mandāravo kadambī ca ",
  "tha-ap162:12.4": "sūlako nāgapupphiyo ",
  "tha-ap162:12.5": "punnāgo komudī gāthā ",
  "tha-ap162:12.6": "chappaññāsa pakittitāti. bandhujīvakavaggo soḷasamo. "
}
