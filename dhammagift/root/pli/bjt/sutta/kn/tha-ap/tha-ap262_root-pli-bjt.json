{
  "tha-ap262:0.1": "",
  "tha-ap262:0.2": "",
  "tha-ap262:0.3": "260. aggajapupphiyattherāpadānaṃ. ",
  "tha-ap262:1.1": "suvaṇṇavaṇṇaṃ sambuddhaṃ ",
  "tha-ap262:1.2": "nisinnaṃ pabbatantare, ",
  "tha-ap262:1.3": "obhāsayantaṃ raṃsiyā ",
  "tha-ap262:1.4": "sikhitaṃ sikhinaṃ yathā. ",
  "tha-ap262:2.1": "aggajaṃ pupphamādāya ",
  "tha-ap262:2.2": "upagacchiṃ naruttamaṃ, ",
  "tha-ap262:2.3": "pasannacitto sumano ",
  "tha-ap262:2.4": "buddhassa abhiropayiṃ. ",
  "tha-ap262:3.1": "ekatiṃse ito kappe ",
  "tha-ap262:3.2": "yaṃ pupphamabhipūjayiṃ, ",
  "tha-ap262:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap262:3.4": "buddhapūjāyidaṃ phalaṃ. ",
  "tha-ap262:4.1": "pañcavīsatikappambhi ",
  "tha-ap262:4.2": "ahosiṃ amitavhayo, ",
  "tha-ap262:4.3": "sattaratanasampanno ",
  "tha-ap262:4.4": "cakkavattī mahabbalo. ",
  "tha-ap262:5.1": "paṭisambhidā catasso ",
  "tha-ap262:5.2": "vimokkhāpi ca aṭṭhime, chaḷabhiññā sacchikatā ",
  "tha-ap262:5.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap262:6.1": "itthaṃ sudaṃ āyasmā aggajapupphiyo thero imā gāthāyo abhāsitthāti. ",
  "tha-ap262:7.1": "aggajapupphiyattherassa apadānaṃ dasamaṃ. ",
  "tha-ap262:8.1": "uddānaṃ: thomakekāsana ",
  "tha-ap262:9.1": "citakaṃ ",
  "tha-ap262:10.1": "campato ",
  "tha-ap262:10.2": "sattapāṭapi pāhano ",
  "tha-ap262:10.3": "mañjarī paṇṇaṃ ",
  "tha-ap262:10.4": "kuṭido aggapupphiyo ",
  "tha-ap262:10.5": "gāthāyo gaṇitā cettha ",
  "tha-ap262:10.6": "ekatāḷīsameva ca. "
}
