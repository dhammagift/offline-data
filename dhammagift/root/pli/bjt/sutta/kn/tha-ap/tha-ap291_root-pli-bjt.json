{
  "tha-ap291:0.1": "",
  "tha-ap291:0.2": "",
  "tha-ap291:0.3": "289. buddhupaṭṭhākattherāpadānaṃ ",
  "tha-ap291:1.1": "veṭambarīti me nāmaṃ ",
  "tha-ap291:1.2": "pitusantaṃ mamaṃ tadā, ",
  "tha-ap291:1.3": "mama hatthaṃ gahetvāna ",
  "tha-ap291:1.4": "upānayi mahāmuniṃ. ",
  "tha-ap291:2.1": "ime maṃ uddisissanti ",
  "tha-ap291:2.2": "buddhā lokagganāyakā, ",
  "tha-ap291:2.3": "te’haṃ upaṭṭhiṃ sakkaccaṃ ",
  "tha-ap291:2.4": "pasanno sehi pāṇihi. ",
  "tha-ap291:3.1": "ekatiṃse ito kappe ",
  "tha-ap291:3.2": "buddhe paricariṃ tadā, ",
  "tha-ap291:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap291:3.4": "upaṭṭhānassidaṃ phalaṃ. ",
  "tha-ap291:4.1": "tevīsamhi ito kappe ",
  "tha-ap291:4.2": "caturo āsu khattiyā, ",
  "tha-ap291:4.3": "samaṇupaṭṭhākā nāma ",
  "tha-ap291:4.4": "cakkavattī mahabbalā. ",
  "tha-ap291:5.1": "paṭisambhidā catasso ",
  "tha-ap291:5.2": "vimokkhāpi ca aṭṭhime, chaḷabhiññā sacchikatā ",
  "tha-ap291:5.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap291:6.1": "itthaṃ sudaṃ āyasmā buddhupaṭṭhāko thero imā gāthāyo abhāsitthāti. ",
  "tha-ap291:7.1": "buddhupaṭṭhākattherassa apadānaṃ navamaṃ. "
}
