{
  "tha-ap300:0.1": "",
  "tha-ap300:0.2": "",
  "tha-ap300:0.3": "298. saraṇagamaniyatherāpadānaṃ. ",
  "tha-ap300:1.1": "pabbate himavantambhi ",
  "tha-ap300:1.2": "ahosiṃ luddako ahaṃ, ",
  "tha-ap300:1.3": "vipassiṃ addasaṃ buddhaṃ ",
  "tha-ap300:1.4": "lokajeṭṭhaṃ narāsabhaṃ. ",
  "tha-ap300:2.1": "upāsitvāna sambuddhaṃ ",
  "tha-ap300:2.2": "veyyāvaccamakāsahaṃ, ",
  "tha-ap300:2.3": "saraṇañca upāgacchiṃ ",
  "tha-ap300:2.4": "dipadindassa tādino. ",
  "tha-ap300:3.1": "ekanavute ito kappe ",
  "tha-ap300:3.2": "saraṇaṃ yamagacchahaṃ, ",
  "tha-ap300:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap300:3.4": "saraṇagamanapphalaṃ. ",
  "tha-ap300:4.1": "paṭisambhidā catasso ",
  "tha-ap300:4.2": "vimokkhāpi ca aṭṭhime, chaḷabhiññā sacchikatā ",
  "tha-ap300:4.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap300:5.1": "itthaṃ sudaṃ āyasmā saraṇagamaniyo thero imā gāthāyo abhāsitthāti. ",
  "tha-ap300:6.1": "saraṇagamaniyattherassa apadānaṃ aṭṭhamaṃ. "
}
