{
  "tha-ap479:0.1": "",
  "tha-ap479:0.2": "",
  "tha-ap479:0.3": "477. giripunnāgiyattherāpadānaṃ ",
  "tha-ap479:1.1": "sobhito nāma sambuddho ",
  "tha-ap479:1.2": "cittakūṭe vasī tadā, ",
  "tha-ap479:1.3": "gahetvā giripunnāgaṃ ",
  "tha-ap479:1.4": "sayambhumhipūjayiṃ. catunavute ",
  "tha-ap479:2.1": "ito kappe ",
  "tha-ap479:2.2": "yaṃ buddhamhipūjayiṃ, ",
  "tha-ap479:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap479:2.4": "buddhapūjāyidaṃ phalaṃ. ",
  "tha-ap479:3.1": "kilesā jhāpitā mayhaṃ ",
  "tha-ap479:3.2": "bhavā sabbe samūhatā, nāgo’va bandhanaṃ chetvā ",
  "tha-ap479:3.3": "viharāmi anāsavo. ",
  "tha-ap479:4.1": "svāgataṃ vata me āsi ",
  "tha-ap479:4.2": "buddhaseṭṭhassa santike, tisso vijjā anuppattā ",
  "tha-ap479:4.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap479:5.1": "paṭisambhidā catasso ",
  "tha-ap479:5.2": "ca vimokkhāpi ca aṭṭhime, chaḷabhiññā sacchikatā ",
  "tha-ap479:5.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap479:6.1": "itthaṃ sudaṃ āyasmā giripunnāgiyo thero imā gāthāyo abhāsitthāti. ",
  "tha-ap479:7.1": "giripunnāgiyattherassa apadānaṃ sattamaṃ. "
}
