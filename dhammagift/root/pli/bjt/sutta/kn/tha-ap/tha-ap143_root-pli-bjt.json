{
  "tha-ap143:0.1": "",
  "tha-ap143:0.2": "15. chattavaggo ",
  "tha-ap143:0.3": "141. atichattiyattherāpadānaṃ ",
  "tha-ap143:1.1": "parinibbute bhagavati ",
  "tha-ap143:1.2": "atthadassinaruttame, ",
  "tha-ap143:1.3": "chattātichattaṃ kāretvā ",
  "tha-ap143:1.4": "thūpambhi abhiropayiṃ. ",
  "tha-ap143:2.1": "kālena kālaṃ āgantvā ",
  "tha-ap143:2.2": "namassiṃ satthu cetiyaṃ, ",
  "tha-ap143:2.3": "pupphacchadanaṃ katvāna ",
  "tha-ap143:2.4": "chattamhi abhiropayiṃ. ",
  "tha-ap143:3.1": "sattarase kappasate ",
  "tha-ap143:3.2": "devarajjaṃ akārayiṃ, ",
  "tha-ap143:3.3": "manussattaṃ na gacchāmi ",
  "tha-ap143:3.4": "thūpapūjāyi daṃ phalaṃ. ",
  "tha-ap143:4.1": "paṭisambhidā …pe… ",
  "tha-ap143:4.2": "",
  "tha-ap143:4.3": "",
  "tha-ap143:4.4": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap143:5.1": "itthaṃ sudaṃ āyasmā atichattiyo thero imā gāthāyo abhāsitthāti. ",
  "tha-ap143:6.1": "atichattiyattherassa apadānaṃ paṭhamaṃ. "
}
