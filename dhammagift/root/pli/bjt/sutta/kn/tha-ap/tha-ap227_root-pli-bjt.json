{
  "tha-ap227:0.1": "",
  "tha-ap227:0.2": "",
  "tha-ap227:0.3": "225. avyādhikattherāpadānaṃ ",
  "tha-ap227:1.1": "vipassissa bhagavato ",
  "tha-ap227:1.2": "aggisālamadāsahaṃ, ",
  "tha-ap227:1.3": "vyādhitānañca āvāsaṃ ",
  "tha-ap227:1.4": "uṇhodakapaṭiggahaṃ. ",
  "tha-ap227:2.1": "tena kammenayaṃ mayhaṃ ",
  "tha-ap227:2.2": "attabhāvo sunimmito, ",
  "tha-ap227:2.3": "vyādhāhaṃ nābhijānāmi ",
  "tha-ap227:2.4": "puññakammassidaṃ phalaṃ. ",
  "tha-ap227:3.1": "ekanavute ito kappe ",
  "tha-ap227:3.2": "yaṃ sālamadadiṃ tadā, ",
  "tha-ap227:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap227:3.4": "aggisālāyidaṃ phalaṃ. ",
  "tha-ap227:4.1": "ito sattamake kappe ",
  "tha-ap227:4.2": "eko’siṃ aparājito, ",
  "tha-ap227:4.3": "sattaratanasampanno ",
  "tha-ap227:4.4": "cakkavattī mahabbalo. ",
  "tha-ap227:5.1": "paṭisambhidā catasso ",
  "tha-ap227:5.2": "vimokkhāpi ca aṭṭhime, chaḷabhiññā sacchikatā ",
  "tha-ap227:5.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap227:6.1": "itthaṃ sudaṃ āyasmā avyādhiko thero imā gāthāyo abhāsitthāti. ",
  "tha-ap227:7.1": "avyādhikattherassa apadānaṃ pañcamaṃ. "
}
