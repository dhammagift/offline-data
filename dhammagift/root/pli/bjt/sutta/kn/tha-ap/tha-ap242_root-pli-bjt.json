{
  "tha-ap242:0.1": "",
  "tha-ap242:0.2": "",
  "tha-ap242:0.3": "240. vāsidāyakattherāpadānaṃ. ",
  "tha-ap242:1.1": "kammārohaṃ pure āsiṃ ",
  "tha-ap242:1.2": "tīvarāyaṃ puruttame, ",
  "tha-ap242:1.3": "ekā vāsi mayā dinnā ",
  "tha-ap242:1.4": "sayambhūṃ aparājitaṃ. ",
  "tha-ap242:2.1": "catunavute ito kappe ",
  "tha-ap242:2.2": "yaṃ vāsimadadiṃ tadā, ",
  "tha-ap242:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap242:2.4": "vāsidānassidaṃ phalaṃ. ",
  "tha-ap242:3.1": "paṭisambhidā catasso ",
  "tha-ap242:3.2": "vimokkhāpi ca aṭṭhime, chaḷabhiññā sacchikatā ",
  "tha-ap242:3.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap242:4.1": "itthaṃ sudaṃ āyasmā vāsidāyako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap242:5.1": "vāsidāyakattherassa apadānaṃ dasamaṃ. ",
  "tha-ap242:6.1": "uddānaṃ: udakāsana bhājanaṃ sālapūpī kilañjako vedikā vaṇṇakāro ca piyāla ambayāgado jagatī vāsidātā ca gāthā tiṃsa ca aṭṭha ca. udakāsanavaggo catuvīsatimo. ",
  "tha-ap242:7.1": "",
  "tha-ap242:8.1": "",
  "tha-ap242:8.2": "",
  "tha-ap242:8.3": "",
  "tha-ap242:8.4": "",
  "tha-ap242:8.5": "",
