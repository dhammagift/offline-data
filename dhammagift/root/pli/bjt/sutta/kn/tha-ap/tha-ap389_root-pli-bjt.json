{
  "tha-ap389:0.1": "",
  "tha-ap389:0.2": "",
  "tha-ap389:0.3": "387. kadaliphaladāyakattherāpadānaṃ ",
  "tha-ap389:1.1": "kaṇikāraṃva jalitaṃ ",
  "tha-ap389:1.2": "puṇṇamāseva candimaṃ, ",
  "tha-ap389:1.3": "jalantaṃ dīparukkhaṃva ",
  "tha-ap389:1.4": "addasaṃ lokanāyakaṃ. ",
  "tha-ap389:2.1": "kadaliphalaṃ paggayha ",
  "tha-ap389:2.2": "adāsiṃ satthuno ahaṃ, ",
  "tha-ap389:2.3": "pasannacitto sumano ",
  "tha-ap389:2.4": "vandivatvāna apakkamiṃ. ",
  "tha-ap389:3.1": "ekatiṃse ito kappe ",
  "tha-ap389:3.2": "yaṃ phalaṃ adadiṃ tadā, ",
  "tha-ap389:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap389:3.4": "phaladānassidaṃ phalaṃ. ",
  "tha-ap389:4.1": "",
  "tha-ap389:4.2": "",
  "tha-ap389:4.3": "",
  "tha-ap389:5.1": "svāgataṃ vata me āsi ",
  "tha-ap389:5.2": "buddhaseṭṭhassa santike, tisso vijjā anuppattā ",
  "tha-ap389:5.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap389:6.1": "kilesā jhāpitā mayhaṃ bhavā sabbe samūhatā, nāgova bandhanaṃ chetvā viharāmi anāsavo. paṭisambhidā catasso ",
  "tha-ap389:6.2": "vimokkhāpi ca aṭṭhime, chaḷabhiññā sacchikatā ",
  "tha-ap389:6.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap389:7.1": "itthaṃ sudaṃ āyasmā kadaliphaladāyako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap389:8.1": "kadaliphaladāyakattherassa apadānaṃ sattamaṃ. "
}
