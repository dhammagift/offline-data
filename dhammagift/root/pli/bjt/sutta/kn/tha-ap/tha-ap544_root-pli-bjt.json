{
  "tha-ap544:0.1": "",
  "tha-ap544:0.2": "",
  "tha-ap544:0.3": "542. kaṅkhārevatattherāpadānaṃ ",
  "tha-ap544:1.1": "padumuttaro nāma jino ",
  "tha-ap544:1.2": "sabbadhammesu cakkhumā, ",
  "tha-ap544:1.3": "ito satasahassamhi ",
  "tha-ap544:1.4": "kappe uppajji nāyako. ",
  "tha-ap544:2.1": "sīhahanu brahmagiro ",
  "tha-ap544:2.2": "haṃsadundūbhinissaro, ",
  "tha-ap544:2.3": "nāgavikkantagamano ",
  "tha-ap544:2.4": "candasūrādhikappabho. ",
  "tha-ap544:3.1": "mahāmatī mahāvīro ",
  "tha-ap544:3.2": "mahājhāyī bahābalo, ",
  "tha-ap544:3.3": "mahākāruṇiko nātho ",
  "tha-ap544:3.4": "mahātamapanūdano. ",
  "tha-ap544:4.1": "sakadāci tilokaggo ",
  "tha-ap544:4.2": "veneyye vinayaṃ bahu, ",
  "tha-ap544:4.3": "dhamma desesi sambuddho ",
  "tha-ap544:4.4": "sattāsayavidū muni. ",
  "tha-ap544:5.1": "jhāyiṃ jhānarataṃ vīraṃ ",
  "tha-ap544:5.2": "upasantaṃ anāvilaṃ, ",
  "tha-ap544:5.3": "vaṇṇayanto parisatiṃ ",
  "tha-ap544:5.4": "tosesi janatā jino. ",
  "tha-ap544:6.1": "tadāhaṃ haṃsavatiyaṃ ",
  "tha-ap544:6.2": "brāhmaṇo vedapāragū, ",
  "tha-ap544:6.3": "dhammaṃ sutvāna mudito ",
  "tha-ap544:6.4": "taṃ ṭhānamabhipatthayiṃ. ",
  "tha-ap544:7.1": "tadā jino viyākāsi ",
  "tha-ap544:7.2": "saṅghamajjhe vināyako, ",
  "tha-ap544:7.3": "mudito hohi tvaṃ brahme ",
  "tha-ap544:7.4": "lacchase taṃ manorathaṃ. ",
  "tha-ap544:8.1": "satasahasse ito kappe ",
  "tha-ap544:8.2": "okkākakulasambhavo, ",
  "tha-ap544:8.3": "gotamo nāma nāmena ",
  "tha-ap544:8.4": "satthā loke bhavissati. ",
  "tha-ap544:9.1": "tassa dhammesu dāyādo ",
  "tha-ap544:9.2": "oraso dhammanimmito, ",
  "tha-ap544:9.3": "revato nāma nāmena ",
  "tha-ap544:9.4": "hessasi satthusāvako. ",
  "tha-ap544:10.1": "tena kammena sukatena ",
  "tha-ap544:10.2": "cetanāpaṇidhīhi ca, ",
  "tha-ap544:10.3": "jahitvā mānusaṃ dehi ",
  "tha-ap544:10.4": "tāvatisamagacchahaṃ. ",
  "tha-ap544:11.1": "pacchime ca bhave dāni ",
  "tha-ap544:11.2": "jātohaṃ koliye pure, ",
  "tha-ap544:11.3": "khattiye kulasampanne ",
  "tha-ap544:11.4": "iddhe phīte mahaddhane. ",
  "tha-ap544:12.1": "yadā kapilavatthusmiṃ ",
  "tha-ap544:12.2": "buddho dhammamadesayi, ",
  "tha-ap544:12.3": "tadā pasanno sugate ",
  "tha-ap544:12.4": "pabbajiṃ anagāriyaṃ. ",
  "tha-ap544:13.1": "kaṅkhā me bahulā āsi ",
  "tha-ap544:13.2": "kappākappe tahiṃ tahiṃ, ",
  "tha-ap544:13.3": "sabbaṃ taṃ vinayī buddho ",
  "tha-ap544:13.4": "desetvā dhammamuttamaṃ. ",
  "tha-ap544:14.1": "tatohaṃ tiṇṇasaṃsāro ",
  "tha-ap544:14.2": "sadā jhānasukhe rato, ",
  "tha-ap544:14.3": "viharāmi tadā buddho ",
  "tha-ap544:14.4": "maṃ disvā etadabravi: ",
  "tha-ap544:15.1": "yaṃ kāci kaṅkhā idha vā huraṃ vā, ",
  "tha-ap544:15.2": "sakavediyā vā paravediyā vā: ",
  "tha-ap544:15.3": "ye jhāyino tā pajahanti sabbā ",
  "tha-ap544:15.4": "ātāpino brahmacariyaṃ carantā. ",
  "tha-ap544:16.1": "satasahasse kataṃ kammaṃ ",
  "tha-ap544:16.2": "phalaṃ dassesi me idha, ",
  "tha-ap544:16.3": "sumutto saravegova ",
  "tha-ap544:16.4": "kilese jhāpayī mama. ",
  "tha-ap544:17.1": "tato jhānarataṃ disvā ",
  "tha-ap544:17.2": "buddho lokantagū muni, ",
  "tha-ap544:17.3": "jhāyīnaṃ bhikkhūnaṃ aggo ",
  "tha-ap544:17.4": "paññāpesi mahāmati. ",
  "tha-ap544:18.1": "kilesā jhāpitā mayhaṃ ",
  "tha-ap544:18.2": "bhavā sabbe samūhatā, nāgo’va bandhanaṃ chetvā ",
  "tha-ap544:18.3": "viharāmi anāsavo. ",
  "tha-ap544:19.1": "svāgataṃ vata me āsi ",
  "tha-ap544:19.2": "buddhaseṭṭhassa santike, tisso vijjā anuppattā ",
  "tha-ap544:19.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap544:20.1": "paṭisambhidā catasso ",
  "tha-ap544:20.2": "ca vimokkhāpi ca aṭṭhime, chaḷabhiññā sacchikatā ",
  "tha-ap544:20.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap544:21.1": "itthaṃ sudaṃ āyasmā kaṅkhārevato thero imā gāthāyo abhāsitthāti. ",
  "tha-ap544:22.1": "kaṅkhārevatattherassa apadānaṃ dutiyaṃ. "
}
