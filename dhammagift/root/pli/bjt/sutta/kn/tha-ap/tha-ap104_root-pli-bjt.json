{
  "tha-ap104:0.1": "",
  "tha-ap104:0.2": "",
  "tha-ap104:0.3": "102. ñāṇasaññakattherāpadānaṃ. ",
  "tha-ap104:1.1": "suvaṇṇavaṇṇaṃ sambuddhaṃ ",
  "tha-ap104:1.2": "nisabhājāniyaṃ yathā, ",
  "tha-ap104:1.3": "tidhā pabhinnamātaṅgaṃ ",
  "tha-ap104:1.4": "kuñjaraṃ’va mahesinaṃ. ",
  "tha-ap104:2.1": "obhāsantaṃ disā sabbā ",
  "tha-ap104:2.2": "uḷurājaṃ’va pūritaṃ, ",
  "tha-ap104:2.3": "rathiyaṃ paṭipajjantaṃ ",
  "tha-ap104:2.4": "lokajeṭṭhaṃ apassisaṃ. ",
  "tha-ap104:3.1": "ñāṇe cittaṃ pasādetvā ",
  "tha-ap104:3.2": "paggahetvāna añjaliṃ, ",
  "tha-ap104:3.3": "pasannacitto sumano ",
  "tha-ap104:3.4": "siddhatthaṃ abhivādayiṃ. catunavute ",
  "tha-ap104:4.1": "ito kappe ",
  "tha-ap104:4.2": "yaṃ kammamakariṃ tadā, ",
  "tha-ap104:4.3": "duggatiṃ nābhijānāmi ",
  "tha-ap104:4.4": "ñāṇasaññāyidaṃ phalaṃ. ",
  "tha-ap104:5.1": "tesattatimhi’to kappe ",
  "tha-ap104:5.2": "soḷasā’suṃ naruttamā, ",
  "tha-ap104:5.3": "sattaratanasampannā ",
  "tha-ap104:5.4": "cakkavattī mahabbalā. ",
  "tha-ap104:6.1": "paṭisambhidā ",
  "tha-ap104:6.2": "…pe… ",
  "tha-ap104:6.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap104:7.1": "itthaṃ sudaṃ āyasmā ñāṇasaññako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap104:8.1": "ñāṇasaññakattherassa apadānaṃ dutiyaṃ. "
}
