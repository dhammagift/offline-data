{
  "tha-ap166:0.1": "",
  "tha-ap166:0.2": "",
  "tha-ap166:0.3": "164. desapūjakattherāpadānaṃ. ",
  "tha-ap166:1.1": "atthadassī tu bhagavā ",
  "tha-ap166:1.2": "lokajeṭṭho narāsabho, ",
  "tha-ap166:1.3": "abbhuggantvāna vehāsaṃ ",
  "tha-ap166:1.4": "gacchate anilañjase. ",
  "tha-ap166:2.1": "yamhi dese ṭhito satthā ",
  "tha-ap166:2.2": "abbhuggañchi mahāmuni, ",
  "tha-ap166:2.3": "tāhaṃ desaṃ apūjesiṃ ",
  "tha-ap166:2.4": "pasanno sehi pāṇihi. ",
  "tha-ap166:3.1": "aṭṭhārase kappasate ",
  "tha-ap166:3.2": "addasaṃ yaṃ mahāmuniṃ, ",
  "tha-ap166:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap166:3.4": "desapūjāyidaṃ phalaṃ. ",
  "tha-ap166:4.1": "ekādase kappasate ",
  "tha-ap166:4.2": "gosujāta sanāmako, ",
  "tha-ap166:4.3": "sattaratanasampanno ",
  "tha-ap166:4.4": "cakkavattī mahabbalo. ",
  "tha-ap166:5.1": "paṭisambhidā catasso ",
  "tha-ap166:5.2": "vimokkhāpi ca aṭṭhime, chaḷabhiññā sacchikatā ",
  "tha-ap166:5.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap166:6.1": "itthaṃ sudaṃ āyasmā desapūjako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap166:7.1": "desapūjakattherassa apadānaṃ catutthaṃ. "
}
