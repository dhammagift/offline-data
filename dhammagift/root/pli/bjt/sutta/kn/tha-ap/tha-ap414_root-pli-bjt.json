{
  "tha-ap414:0.1": "",
  "tha-ap414:0.2": "",
  "tha-ap414:0.3": "412. ekachattiyattherāpadānaṃ ",
  "tha-ap414:1.1": "candabhāgānadītīre ",
  "tha-ap414:1.2": "assamo sukato mama, ",
  "tha-ap414:1.3": "susuddhapulinākiṇṇā ",
  "tha-ap414:1.4": "paṇṇasālā sumāpitā. ",
  "tha-ap414:2.1": "uttānakūlā nadikā ",
  "tha-ap414:2.2": "supatitthā manoramā, ",
  "tha-ap414:2.3": "macchakacchapasampannā ",
  "tha-ap414:2.4": "susumāranisevitā. ",
  "tha-ap414:3.1": "acchā mayūrā dīpī ca ",
  "tha-ap414:3.2": "karavīkā ca sālikā, ",
  "tha-ap414:3.3": "kūjanti sabbadā ete ",
  "tha-ap414:3.4": "sobhayantā mama’ssamaṃ. ",
  "tha-ap414:4.1": "kokilā mañjubhāṇī ca ",
  "tha-ap414:4.2": "haṃsā ca madhurassarā, ",
  "tha-ap414:4.3": "abhikūjanti te tattha ",
  "tha-ap414:4.4": "sobhayantā mamassamaṃ. ",
  "tha-ap414:5.1": "sīhā vyagghā varāhā ca ",
  "tha-ap414:5.2": "cakā kokataracchakā, ",
  "tha-ap414:5.3": "giriduggamhi nādenti ",
  "tha-ap414:5.4": "sobhayantā mamassamaṃ. ",
  "tha-ap414:6.1": "eṇīmigā ca sarabhā ",
  "tha-ap414:6.2": "bheraṇḍā sūkarā bahū, ",
  "tha-ap414:6.3": "giriduggamhi nādenti ",
  "tha-ap414:6.4": "sobhayantā mamassamaṃ. ",
  "tha-ap414:7.1": "uddālakā campakā ca ",
  "tha-ap414:7.2": "pāṭalī sinduvārakā, ",
  "tha-ap414:7.3": "atimuttā asokā ca ",
  "tha-ap414:7.4": "pupphanti mama assame. ",
  "tha-ap414:8.1": "aṅkolā yūthikā ceva ",
  "tha-ap414:8.2": "sattalī bimbijālikā, kaṇṇikā ",
  "tha-ap414:8.3": "kaṇikārā ca pupphanti ",
  "tha-ap414:8.4": "mama assame. ",
  "tha-ap414:9.1": "nāgā sālā ca saḷalā ",
  "tha-ap414:9.2": "puṇḍarīkettha pupphitā, ",
  "tha-ap414:9.3": "dibbagandhaṃ sampavantā ",
  "tha-ap414:9.4": "sobhayanti mamassamaṃ. ",
  "tha-ap414:10.1": "ajjunā asanā cettha ",
  "tha-ap414:10.2": "mahānāmā ca pupphitā, ",
  "tha-ap414:10.3": "sālā ca kaṅgupupphā ca ",
  "tha-ap414:10.4": "sobhanti mamassamaṃ. ",
  "tha-ap414:11.1": "ambā jambū ca tilakā ",
  "tha-ap414:11.2": "nimbā ca sālakalyāṇī, ",
  "tha-ap414:11.3": "dibbagandhaṃ sampavantā ",
  "tha-ap414:11.4": "sobhayanti mamassamaṃ. ",
  "tha-ap414:12.1": "asokā ca kapitthā ca ",
  "tha-ap414:12.2": "bhaginimālettha pupphitā, ",
  "tha-ap414:12.3": "dibbagandhaṃ sampavantā ",
  "tha-ap414:12.4": "sobhayanti mamassamaṃ. ",
  "tha-ap414:13.1": "kadambā kadalī ceva ",
  "tha-ap414:13.2": "isimuggā ca ropitā, ",
  "tha-ap414:13.3": "dhuvaṃ phalāni dhārenti ",
  "tha-ap414:13.4": "sobhayantā mamassamaṃ. ",
  "tha-ap414:14.1": "harītakā āmalakā ",
  "tha-ap414:14.2": "ambā jambū vibhītakā, ",
  "tha-ap414:14.3": "kolā bhallātakā billā ",
  "tha-ap414:14.4": "phalino mama assame, ",
  "tha-ap414:15.1": "avidūre pokkharaṇī ",
  "tha-ap414:15.2": "supatitthā manoramā, ",
  "tha-ap414:15.3": "mandālakehi sañchannā ",
  "tha-ap414:15.4": "padumuppalakehi ca. ",
  "tha-ap414:16.1": "gabbhaṃ gaṇhanti padumā ",
  "tha-ap414:16.2": "aññe pupphanti kesarī, ",
  "tha-ap414:16.3": "opattakaṇṇikā ceva ",
  "tha-ap414:16.4": "pupphanti mama assame. ",
  "tha-ap414:17.1": "pāṭhīnā pāvusā macchā ",
  "tha-ap414:17.2": "valajā muñjarohitā, ",
  "tha-ap414:17.3": "acchodakamhi vicaraṃ ",
  "tha-ap414:17.4": "sobhayanti mamassamaṃ. ",
  "tha-ap414:18.1": "nayitā ambagandhī ca ",
  "tha-ap414:18.2": "anukūle ca ketakā, ",
  "tha-ap414:18.3": "dibbagandhaṃ sampavantā ",
  "tha-ap414:18.4": "sobhayanti mamassamaṃ. ",
  "tha-ap414:19.1": "madhū bhisamhā savati ",
  "tha-ap414:19.2": "khīrasappi mulāḷihi, ",
  "tha-ap414:19.3": "dibbagandhaṃ sampavantā ",
  "tha-ap414:19.4": "sobhayanti mamassamaṃ. ",
  "tha-ap414:20.1": "pulinā sobhanā tattha ",
  "tha-ap414:20.2": "ākiṇṇā jalasevitā, ",
  "tha-ap414:20.3": "opupphā pupphitā senti ",
  "tha-ap414:20.4": "sobhayantā mamassamaṃ. ",
  "tha-ap414:21.1": "jaṭābhārena bharitā ",
  "tha-ap414:21.2": "ajinuttaravāsanā, ",
  "tha-ap414:21.3": "vākacīradharā sabbe ",
  "tha-ap414:21.4": "sobhayanti mamassamaṃ. ",
  "tha-ap414:22.1": "yugamattamapekkhantā ",
  "tha-ap414:22.2": "nipakā santavuttino, ",
  "tha-ap414:22.3": "kāmabhoge anapekkhā ",
  "tha-ap414:22.4": "vasanti mama assame. ",
  "tha-ap414:23.1": "parūḷhakacchanakhalomā ",
  "tha-ap414:23.2": "paṅkadantā rajassirā, ",
  "tha-ap414:23.3": "rajojalladharā sabbe ",
  "tha-ap414:23.4": "vasanti mama assame. ",
  "tha-ap414:24.1": "abhiññāpāramippattā ",
  "tha-ap414:24.2": "antalikkhacarā ca te, ",
  "tha-ap414:24.3": "uggacchantā nabhaṃ ete ",
  "tha-ap414:24.4": "sobhayanti mamassamaṃ. ",
  "tha-ap414:25.1": "tehi sissehi parivuto ",
  "tha-ap414:25.2": "vasāmi vipine tadā, ",
  "tha-ap414:25.3": "rattindivaṃ na jānāmi ",
  "tha-ap414:25.4": "sadā jhānasamappito. ",
  "tha-ap414:26.1": "bhagavā tamhi samaye ",
  "tha-ap414:26.2": "atthadassī mahāmuni, ",
  "tha-ap414:26.3": "tamandhakāraṃ nāsento ",
  "tha-ap414:26.4": "uppajji lokanāyako. ",
  "tha-ap414:27.1": "atha aññataro sisso ",
  "tha-ap414:27.2": "āgacchi mama santikaṃ, ",
  "tha-ap414:27.3": "mante ajjhetukāmo so ",
  "tha-ap414:27.4": "chaḷaṅgaṃ nāmalakkhaṇaṃ. ",
  "tha-ap414:28.1": "buddho loke samuppanno ",
  "tha-ap414:28.2": "atthadassī mahāmuni, ",
  "tha-ap414:28.3": "catusaccaṃ pakāsento ",
  "tha-ap414:28.4": "deseti amataṃ padaṃ. ",
  "tha-ap414:29.1": "tuṭṭhahaṭṭho pamudito ",
  "tha-ap414:29.2": "dhammantaragatāsayo, ",
  "tha-ap414:29.3": "assamā abhinikkhamma ",
  "tha-ap414:29.4": "imaṃ vacanamabraviṃ: ",
  "tha-ap414:30.1": "“buddho loke samuppanno ",
  "tha-ap414:30.2": "battiṃsavaralakkhaṇo, ",
  "tha-ap414:30.3": "hatha sabbe gamissāma ",
  "tha-ap414:30.4": "sammāsambuddhasantikaṃ.” ",
  "tha-ap414:31.1": "ovādapaṭikarā te ",
  "tha-ap414:31.2": "saddhamme pāramiṅgatā, ",
  "tha-ap414:31.3": "sādhū’ti sampaṭicchiṃsu ",
  "tha-ap414:31.4": "uttamatthaṃ gavesakā. ",
  "tha-ap414:32.1": "jaṭābhārabharitā te ",
  "tha-ap414:32.2": "ajinuttaravāsino, ",
  "tha-ap414:32.3": "uttamatthaṃ gavesanto ",
  "tha-ap414:32.4": "nikkhamiṃsu vanā tadā. ",
  "tha-ap414:33.1": "bhagavā tamhi samaye ",
  "tha-ap414:33.2": "atthadassī mahāyaso, ",
  "tha-ap414:33.3": "catusaccaṃ pakāsento ",
  "tha-ap414:33.4": "deseti amataṃ padaṃ. ",
  "tha-ap414:34.1": "setacchattaṃ gahetvāna ",
  "tha-ap414:34.2": "buddhaseṭṭhassa dhārayiṃ, ",
  "tha-ap414:34.3": "ekāhaṃ dhārayitvāna ",
  "tha-ap414:34.4": "buddhaseṭṭhamavandahaṃ. ",
  "tha-ap414:35.1": "atthadassī tu bhagavā ",
  "tha-ap414:35.2": "lokajeṭṭho narāsabho, ",
  "tha-ap414:35.3": "bhikkhusaṅghe nisīditvā ",
  "tha-ap414:35.4": "imā gāthā abhāsatha: ",
  "tha-ap414:36.1": "“yo me chattamadhāresi ",
  "tha-ap414:36.2": "pasanno sehi pāṇihi, ",
  "tha-ap414:36.3": "tamahaṃ kittayissāmi ",
  "tha-ap414:36.4": "suṇātha mama bhāsato. ",
  "tha-ap414:37.1": "imassa jāyamānassa ",
  "tha-ap414:37.2": "devatte atha mānuse, ",
  "tha-ap414:37.3": "dhāressati sadā chattaṃ ",
  "tha-ap414:37.4": "chattadānassidaṃ phalaṃ. ",
  "tha-ap414:38.1": "sattasattatikappāni ",
  "tha-ap414:38.2": "devaloke ramissati, ",
  "tha-ap414:38.3": "sahassakkhattuṃ rājā ca ",
  "tha-ap414:38.4": "vakkavattī bhavissati. ",
  "tha-ap414:39.1": "sattasattatikkhattuñca ",
  "tha-ap414:39.2": "devarajjaṃ karissati, ",
  "tha-ap414:39.3": "padesarajjaṃ vipulaṃ ",
  "tha-ap414:39.4": "gaṇanāto asaṅkhiyaṃ. ",
  "tha-ap414:40.1": "aṭṭhārase kappasate ",
  "tha-ap414:40.2": "gotamo sakyapuṅgavo, ",
  "tha-ap414:40.3": "tamandhakāraṃ nāsento ",
  "tha-ap414:40.4": "uppajjissati cakkhumā. ",
  "tha-ap414:41.1": "tassa dhammesu dāyādo ",
  "tha-ap414:41.2": "oraso dhammanimmito, ",
  "tha-ap414:41.3": "sabbāsave pariññāya ",
  "tha-ap414:41.4": "viharissatanāsavo.” ",
  "tha-ap414:42.1": "yato ahaṃ kammamakaṃ ",
  "tha-ap414:42.2": "chattaṃ buddhassa dhārayaṃ, ",
  "tha-ap414:42.3": "etthantare na jānāmi ",
  "tha-ap414:42.4": "setacchattaṃ adhāritaṃ. ",
  "tha-ap414:43.1": "idaṃ pacchimakaṃ mayhaṃ ",
  "tha-ap414:43.2": "carimo vattate bhavo, ",
  "tha-ap414:43.3": "chattadhāraṇamajjāpi ",
  "tha-ap414:43.4": "vattate niccakālikaṃ. ",
  "tha-ap414:44.1": "aho me sukataṃ kammaṃ ",
  "tha-ap414:44.2": "atthadassissa tādino, ",
  "tha-ap414:44.3": "sabbāsavaparikkhīṇo ",
  "tha-ap414:44.4": "natthi’dāni punabbhavo. ",
  "tha-ap414:45.1": "kilesā jhāpitā mayhaṃ ",
  "tha-ap414:45.2": "bhavā sabbe samūhatā, nāgova bandhanaṃ chetvā ",
  "tha-ap414:45.3": "viharāmi anāsavo. ",
  "tha-ap414:46.1": "svāgataṃ vata me āsi ",
  "tha-ap414:46.2": "buddhaseṭṭhassa santike, tisso vijjā anuppattā ",
  "tha-ap414:46.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap414:47.1": "paṭisambhidā catasso ",
  "tha-ap414:47.2": "vimokkhāpi ca aṭṭhime, chaḷabhiññā sacchikatā ",
  "tha-ap414:47.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap414:48.1": "itthaṃ sudaṃ āyasmā ekachattiyo thero imā gāthāyo abhāsitthāti. ",
  "tha-ap414:49.1": "ekachattiyattherassa apadānaṃ dutiyaṃ. "
}
