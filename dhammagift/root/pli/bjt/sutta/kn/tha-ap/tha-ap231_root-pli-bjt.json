{
  "tha-ap231:0.1": "",
  "tha-ap231:0.2": "",
  "tha-ap231:0.3": "229. sukatāveliyattherāpadānaṃ. ",
  "tha-ap231:1.1": "asito nāma nāmena ",
  "tha-ap231:1.2": "mālākāro ahuṃ tadā, ",
  "tha-ap231:1.3": "āvelaṃ paggahevona ",
  "tha-ap231:1.4": "rañño dātuṃ vajāmahaṃ. ",
  "tha-ap231:2.1": "asampattamhi rājānaṃ ",
  "tha-ap231:2.2": "addasaṃ sikhināyakaṃ. ",
  "tha-ap231:2.3": "haṭṭho haṭṭhena cittena ",
  "tha-ap231:2.4": "buddhassa abhiropayiṃ. ",
  "tha-ap231:3.1": "ekatiṃse ito kappe ",
  "tha-ap231:3.2": "yaṃ pupphamabhipūjayiṃ, ",
  "tha-ap231:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap231:3.4": "buddhapūjāyidaṃ phalaṃ. ",
  "tha-ap231:4.1": "pañcavīse ito kappe ",
  "tha-ap231:4.2": "rājāhosiṃ mahabbalo, ",
  "tha-ap231:4.3": "vebhāro nāma nāmena ",
  "tha-ap231:4.4": "cakkavattī mahabbalo. ",
  "tha-ap231:5.1": "paṭisambhidā catasso ",
  "tha-ap231:5.2": "vimokkhāpi ca aṭṭhime, chaḷabhiññā sacchikatā ",
  "tha-ap231:5.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap231:6.1": "itthaṃ sudaṃ āyasmā sukatāveliyo thero imā gāthāyo abhāsitthāti. ",
  "tha-ap231:7.1": "sukatāveliyattherassa apadānaṃ navamaṃ. "
}
