{
  "tha-ap315:0.1": "",
  "tha-ap315:0.2": "",
  "tha-ap315:0.3": "313. gatasaññakattherāpadānaṃ. ",
  "tha-ap315:1.1": "ākāse ca padaṃ natthi ",
  "tha-ap315:1.2": "ambare anilañjase, ",
  "tha-ap315:1.3": "siddhatthaṃ jinamadadakkhiṃ ",
  "tha-ap315:1.4": "gacchantaṃ tidivaṅgaṇe. ",
  "tha-ap315:2.1": "anileneritaṃ disvā ",
  "tha-ap315:2.2": "sammāsambuddhacīvaraṃ, ",
  "tha-ap315:2.3": "vitti me tāvade jātā ",
  "tha-ap315:2.4": "disvāna gamanaṃ mune. catunavute ",
  "tha-ap315:3.1": "ito kappe ",
  "tha-ap315:3.2": "yaṃ saññamalabhiṃ tadā, ",
  "tha-ap315:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap315:3.4": "buddhasaññāyidaṃ phalaṃ. ",
  "tha-ap315:4.1": "paṭisambhidā catasso ",
  "tha-ap315:4.2": "vimokkhāpi ca aṭṭhime, chaḷabhiññā sacchikatā ",
  "tha-ap315:4.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap315:5.1": "itthaṃ sudaṃ āyasmā gatasaññaka thero imā gāthāyo abhāsitthāti. ",
  "tha-ap315:6.1": "gatasaññakattherassa apadānaṃ tatiyaṃ. "
}
