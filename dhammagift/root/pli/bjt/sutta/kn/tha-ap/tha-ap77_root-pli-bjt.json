{
  "tha-ap77:0.1": "",
  "tha-ap77:0.2": "",
  "tha-ap77:0.3": "75. ekasaññakattherāpadānaṃ ",
  "tha-ap77:1.1": "khaṇḍo nāmāsi nāmena ",
  "tha-ap77:1.2": "vipassissa’ggasāvako, ",
  "tha-ap77:1.3": "ekā bhikkhā mayā dinnā ",
  "tha-ap77:1.4": "lokāhutipaṭiggahe. ",
  "tha-ap77:2.1": "tena cittappasādena ",
  "tha-ap77:2.2": "dipadinde narāsabhe, ",
  "tha-ap77:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap77:2.4": "ekabhikkhāyidaṃ phalaṃ. ",
  "tha-ap77:3.1": "cattāḷīse ito kappe ",
  "tha-ap77:3.2": "varuṇo nāma khattiyo, ",
  "tha-ap77:3.3": "sattaratanasampanno ",
  "tha-ap77:3.4": "cakkavattī mahabbalo. ",
  "tha-ap77:4.1": "paṭisambhidā ",
  "tha-ap77:4.2": "…pe… ",
  "tha-ap77:4.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap77:5.1": "itthaṃ sudaṃ āyasmā ekasaññako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap77:6.1": "ekasaññakattherassa apadānaṃ pañcamaṃ. "
}
