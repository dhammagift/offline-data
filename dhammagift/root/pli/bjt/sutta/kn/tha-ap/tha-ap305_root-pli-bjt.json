{
  "tha-ap305:0.1": "",
  "tha-ap305:0.2": "",
  "tha-ap305:0.3": "303. paramannadāyakattherāpadānaṃ. ",
  "tha-ap305:1.1": "ṇikāraṃ’va jotantaṃ ",
  "tha-ap305:1.2": "udayantaṃ’va bhānumaṃ, ",
  "tha-ap305:1.3": "vipassimaddasaṃ buddhaṃ ",
  "tha-ap305:1.4": "lokejeṭṭhaṃ narāsabhaṃ. ",
  "tha-ap305:2.1": "añjalimpaggahetvāna ",
  "tha-ap305:2.2": "abhinesiṃ sakaṃ gharaṃ, ",
  "tha-ap305:2.3": "abhinetvāna sambuddhaṃ ",
  "tha-ap305:2.4": "paramannaṃ adāsahaṃ. ekanavute ",
  "tha-ap305:3.1": "ito kappe ",
  "tha-ap305:3.2": "paramannaṃ dadiṃ tadā, ",
  "tha-ap305:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap305:3.4": "paramannassidaṃ phalaṃ. ",
  "tha-ap305:4.1": "paṭisambhidā catasso ",
  "tha-ap305:4.2": "vimokkhāpi ca aṭṭhime, chaḷabhiññā sacchikatā ",
  "tha-ap305:4.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap305:5.1": "itthaṃ sudaṃ āyasmā paramannadāyako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap305:6.1": "paramannadāyakattherassa apadānaṃ tatiyaṃ. "
}
