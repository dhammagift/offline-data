{
  "tha-ap442:0.1": "",
  "tha-ap442:0.2": "",
  "tha-ap442:0.3": "440. jambuphaliyattherāpadānaṃ ",
  "tha-ap442:1.1": "padumuttarabuddhassa ",
  "tha-ap442:1.2": "lokajeṭṭhassa tādino, ",
  "tha-ap442:1.3": "piṇḍāya vicarantassa ",
  "tha-ap442:1.4": "dhāreto uttamaṃ yasaṃ. ",
  "tha-ap442:2.1": "aggaphalaṃ gahetvāna ",
  "tha-ap442:2.2": "vippasannena cetasā, ",
  "tha-ap442:2.3": "dakkhiṇeyyassa vīrassa ",
  "tha-ap442:2.4": "adāsiṃ satthuno ahaṃ. ",
  "tha-ap442:3.1": "tena kammena dipadinda ",
  "tha-ap442:3.2": "lokajeṭṭha narāsabha, ",
  "tha-ap442:3.3": "pattomhi acalaṃ ṭhānaṃ ",
  "tha-ap442:3.4": "hitvā jayaparājayaṃ. ",
  "tha-ap442:4.1": "satasahasse ito kappe ",
  "tha-ap442:4.2": "yaṃ dānamadadiṃ tadā, ",
  "tha-ap442:4.3": "duggatiṃ nābhijānāmi ",
  "tha-ap442:4.4": "aggadādanassīdaṃ phalaṃ. ",
  "tha-ap442:5.1": "kilesā jhāpitā mayhaṃ ",
  "tha-ap442:5.2": "bhavā sabbe samūhatā, nāgo ca bandhanaṃ chetvā ",
  "tha-ap442:5.3": "viharāmi anāsavo. ",
  "tha-ap442:6.1": "svāgataṃ vata me āsi ",
  "tha-ap442:6.2": "buddhaseṭṭhassa santike, tisso vijjā anuppattā ",
  "tha-ap442:6.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap442:7.1": "paṭisambhidā catasso ",
  "tha-ap442:7.2": "ca vimokkhāpi ca aṭṭhime, chaḷabhiññā sacchikatā ",
  "tha-ap442:7.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap442:8.1": "itthaṃ sudaṃ āyasmā jambuphaliyo thero imā gāthāyo abhāsitthāti. ",
  "tha-ap442:9.1": "jambuphaliyattherassa apadānaṃ dasamaṃ. ",
  "tha-ap442:10.1": "uddānaṃ: ",
  "tha-ap442:11.1": "",
  "tha-ap442:12.1": "thero ekavihārī ca ",
  "tha-ap442:12.2": "saṅkhiko pāṭihīrako, ",
  "tha-ap442:12.3": "thaviko ucchukhaṇḍi ca ",
  "tha-ap442:12.4": "kalambambāṭakappadā, ",
  "tha-ap442:13.1": "harītakambapiṇḍī ca ",
  "tha-ap442:13.2": "jambudo dasamo sati. ",
  "tha-ap442:13.3": "chaḷāsīti ca gāthāyo ",
  "tha-ap442:13.4": "gaṇitāyo vibhāvīhi. ekavihārivaggo catuttāḷisamo. "
}
