{
  "tha-ap212:0.1": "",
  "tha-ap212:0.2": "",
  "tha-ap212:0.3": "210. vātātapanivāriyattherāpadānaṃ ",
  "tha-ap212:1.1": "tissassa tu bhagavato ",
  "tha-ap212:1.2": "devadevassa tādino, ",
  "tha-ap212:1.3": "ekacchattaṃ mayā dinnaṃ ",
  "tha-ap212:1.4": "vippasannena cetasā. ",
  "tha-ap212:2.1": "nivutaṃ hotī me pāpaṃ ",
  "tha-ap212:2.2": "kusalassu’pasampadā, ",
  "tha-ap212:2.3": "ākāse chattaṃ dhārenti ",
  "tha-ap212:2.4": "pubbakammassidaṃ phalaṃ. ",
  "tha-ap212:3.1": "carimaṃ vattate mayhaṃ ",
  "tha-ap212:3.2": "bhavā sabbe samūhatā, ",
  "tha-ap212:3.3": "dhāremi antimaṃ dehaṃ ",
  "tha-ap212:3.4": "sammāsambuddhasāsane. ",
  "tha-ap212:4.1": "dvenavute ito kappe ",
  "tha-ap212:4.2": "yaṃ chattamadadiṃ tadā, ",
  "tha-ap212:4.3": "duggatiṃ nābhijānāmi ",
  "tha-ap212:4.4": "chattadānassidaṃ phalaṃ. ",
  "tha-ap212:5.1": "dvesattatimhito kappe ",
  "tha-ap212:5.2": "aṭṭhāsiṃsu janādhipā, ",
  "tha-ap212:5.3": "mahānidānanāmena ",
  "tha-ap212:5.4": "rājāno cakkavattino. ",
  "tha-ap212:6.1": "paṭisambhidā catasso ",
  "tha-ap212:6.2": "vimokkhāpi ca aṭṭhime, chaḷabhiññā sacchikatā ",
  "tha-ap212:6.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap212:7.1": "itthaṃ sudaṃ āyasmā vātātapanivāriyo thero imā gāthāyo abhāsitthāti. ",
  "tha-ap212:8.1": "vātāpanivāriyattherassa apadānaṃ dasamaṃ. ",
  "tha-ap212:9.1": "uddānaṃ: ",
  "tha-ap212:10.1": "",
  "tha-ap212:11.1": "kaṇikāro minelañca ",
  "tha-ap212:11.2": "kiṅkiṇī taraṇena ca ",
  "tha-ap212:11.3": "nigguṇḍipupphi dakado ",
  "tha-ap212:11.4": "salalo ca kuraṇḍako ",
  "tha-ap212:11.5": "ādhārakotapavārī ",
  "tha-ap212:11.6": "aṭṭhatāḷīsa gāthakā. "
}
