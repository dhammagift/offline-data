{
  "tha-ap396:0.1": "",
  "tha-ap396:0.2": "",
  "tha-ap396:0.3": "394. madhudāyakattherāpadānaṃ. ",
  "tha-ap396:1.1": "sindhuyā nadiyā tīre ",
  "tha-ap396:1.2": "sukato assamo mama, ",
  "tha-ap396:1.3": "tattha vācemahaṃ sisse ",
  "tha-ap396:1.4": "itihāsaṃ salakkhaṇaṃ. ",
  "tha-ap396:2.1": "dhammakāmā vinītā te ",
  "tha-ap396:2.2": "sotukāmā susāsanaṃ, ",
  "tha-ap396:2.3": "chaḷaṅge pāramippattā ",
  "tha-ap396:2.4": "sindhukūle vasanti te. ",
  "tha-ap396:3.1": "uppātagamane ceva ",
  "tha-ap396:3.2": "lakkhaṇesu ca kovidā, ",
  "tha-ap396:3.3": "uttamatthaṃ gavesantā ",
  "tha-ap396:3.4": "vasanti pavane tadā. ",
  "tha-ap396:4.1": "sumedho nāma sambuddho ",
  "tha-ap396:4.2": "loke uppajji tāvado, ",
  "tha-ap396:4.3": "amhākaṃ anukampanto ",
  "tha-ap396:4.4": "upagacchi vināyako. ",
  "tha-ap396:5.1": "upāgataṃ mahāvīraṃ ",
  "tha-ap396:5.2": "sumedhaṃ lokanāyakaṃ, ",
  "tha-ap396:5.3": "tiṇasanthārakaṃ katvā ",
  "tha-ap396:5.4": "lokajeṭṭhassa’dāsahaṃ. ",
  "tha-ap396:6.1": "pavanāto madhuṃ gayha ",
  "tha-ap396:6.2": "buddhaseṭṭhassa’dāsahaṃ, ",
  "tha-ap396:6.3": "sambuddho paribhuñjitvā ",
  "tha-ap396:6.4": "idaṃ vacanamabravi: ",
  "tha-ap396:7.1": "“yo taṃ adāsi madhuṃ me ",
  "tha-ap396:7.2": "pasanno sehi pāṇihi, ",
  "tha-ap396:7.3": "tamahaṃ kittasissāmi ",
  "tha-ap396:7.4": "suṇātha mama bhāsato. ",
  "tha-ap396:8.1": "iminā madhudānena ",
  "tha-ap396:8.2": "tiṇasanthārakena ca, ",
  "tha-ap396:8.3": "tiṃsakappasahassāni ",
  "tha-ap396:8.4": "devaloke ramissati. ",
  "tha-ap396:9.1": "tiṃsakappasahassamhi ",
  "tha-ap396:9.2": "okkākakulasambhavo, ",
  "tha-ap396:9.3": "gotamo nāma nāmena ",
  "tha-ap396:9.4": "satthā loke bhavissati. ",
  "tha-ap396:10.1": "tassa dhammesu dāyādo ",
  "tha-ap396:10.2": "oraso dhammanimmito, ",
  "tha-ap396:10.3": "sabbāsave pariññāya ",
  "tha-ap396:10.4": "nibbāyissata’nāsavo. ",
  "tha-ap396:11.1": "devalokā idhāgantvā ",
  "tha-ap396:11.2": "mātukucchiṃ upāgate, ",
  "tha-ap396:11.3": "madhuvassaṃ pavassittha ",
  "tha-ap396:11.4": "chādayaṃ madhunā mahiṃ. ",
  "tha-ap396:12.1": "mayi nikkhantamattamhi ",
  "tha-ap396:12.2": "kucchiyā ca suduttaraṃ, ",
  "tha-ap396:12.3": "tatrāpi madhuvassaṃ me ",
  "tha-ap396:12.4": "vassate niccakālikaṃ. ",
  "tha-ap396:13.1": "agārā abhinikkhamma ",
  "tha-ap396:13.2": "pabbajiṃ anagāriyaṃ, ",
  "tha-ap396:13.3": "lābhī annassa pānassa ",
  "tha-ap396:13.4": "madhudānassi’daṃ phalaṃ. ",
  "tha-ap396:14.1": "sabbakāmasamiddho’haṃ ",
  "tha-ap396:14.2": "bhavitvā devamānuse, ",
  "tha-ap396:14.3": "teneva madhudānena ",
  "tha-ap396:14.4": "pattomhi āsavakkhayaṃ. ",
  "tha-ap396:15.1": "vuṭṭhamhi deve caturaṅgule tiṇe ",
  "tha-ap396:15.2": "sampupphite dharaṇiruhe sañchanne, ",
  "tha-ap396:15.3": "suññe ghare maṇḍaparukkhamūle, ",
  "tha-ap396:15.4": "vasāmi niccaṃ sukhito anāsavo. ",
  "tha-ap396:16.1": "majjhe mahante hīne ca ",
  "tha-ap396:16.2": "bhave sabbe atikkamiṃ, ",
  "tha-ap396:16.3": "ajja me āsavā khīṇā ",
  "tha-ap396:16.4": "natthidāni punabbhavo. ",
  "tha-ap396:17.1": "tiṃsakappasahassamhi ",
  "tha-ap396:17.2": "yaṃ dānamadadiṃ tadā, ",
  "tha-ap396:17.3": "duggatiṃ nābhijānāmi ",
  "tha-ap396:17.4": "madhudāna’ssidaṃ phalaṃ. ",
  "tha-ap396:18.1": "kilesā jhāpitā mayhaṃ ",
  "tha-ap396:18.2": "bhavā sabbe samūhatā, ",
  "tha-ap396:18.3": "sabbāsavā parikkhīṇā ",
  "tha-ap396:18.4": "natthidāni punabbhavo. ",
  "tha-ap396:19.1": "svāgataṃ vata me āsi ",
  "tha-ap396:19.2": "mama buddhassa santike, tisso vijjā anuppattā ",
  "tha-ap396:19.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap396:20.1": "paṭisambhidā catasso ",
  "tha-ap396:20.2": "vimokkhāpi ca aṭṭhime, chaḷabhiññā sacchikatā ",
  "tha-ap396:20.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap396:21.1": "itthaṃ sudaṃ āyasmā madhudāyako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap396:22.1": "madhudāyakattherassa apadānaṃ catutthaṃ. "
}
