{
  "tha-ap532:0.1": "",
  "tha-ap532:0.2": "",
  "tha-ap532:0.3": "530. sugandhattherāpadānaṃ ",
  "tha-ap532:1.1": "imamhi bhaddake kappe ",
  "tha-ap532:1.2": "brahmabandhu mahāyaso, ",
  "tha-ap532:1.3": "kassapo nāma gottena ",
  "tha-ap532:1.4": "uppajji vadataṃvaro. ",
  "tha-ap532:2.1": "anuvyañjanasampanno ",
  "tha-ap532:2.2": "battiṃsavaralakkhaṇo, ",
  "tha-ap532:2.3": "byāmappabhāparivuto ",
  "tha-ap532:2.4": "raṃsujālasamosaṭo. ",
  "tha-ap532:3.1": "assāsetā yathā cando ",
  "tha-ap532:3.2": "suriyova pabhaṅkaro, ",
  "tha-ap532:3.3": "nibbāpetā yathā megho ",
  "tha-ap532:3.4": "sāgaro’va guṇākaro. ",
  "tha-ap532:4.1": "dharaṇīriva sīlena ",
  "tha-ap532:4.2": "himavā’va samādhinā, ",
  "tha-ap532:4.3": "ākāso viya paññāya ",
  "tha-ap532:4.4": "asaṅgo anilo yathā. ",
  "tha-ap532:5.1": "sa kadāci mahāvīro ",
  "tha-ap532:5.2": "parisāsu visārado, ",
  "tha-ap532:5.3": "saccāni sampakāsesi ",
  "tha-ap532:5.4": "uddharanto mahājanaṃ. ",
  "tha-ap532:6.1": "tadāhi bārāṇasiyaṃ ",
  "tha-ap532:6.2": "seṭṭhiputto mahāyaso, ",
  "tha-ap532:6.3": "āsahaṃ dhanadhaññassa ",
  "tha-ap532:6.4": "pahutassa pabhū tadā. ",
  "tha-ap532:7.1": "jaṅghāvihāraṃ vicaraṃ ",
  "tha-ap532:7.2": "migadāyamupeccahaṃ, ",
  "tha-ap532:7.3": "addasaṃ virajaṃ buddhaṃ ",
  "tha-ap532:7.4": "desentaṃ amataṃ padaṃ. ",
  "tha-ap532:8.1": "vissaṭṭhakantavacanaṃ ",
  "tha-ap532:8.2": "karavīkasamassaraṃ, ",
  "tha-ap532:8.3": "haṃsarudābhinigghosaṃ ",
  "tha-ap532:8.4": "viññāpentaṃ mahājanaṃ. ",
  "tha-ap532:9.1": "disvā devātidevaṃ taṃ ",
  "tha-ap532:9.2": "sutvā ca madhuraṃ giraṃ, ",
  "tha-ap532:9.3": "pahāyānappake bhoge ",
  "tha-ap532:9.4": "pabbajiṃ anagāriyaṃ. ",
  "tha-ap532:10.1": "evaṃ pabbajito cāhaṃ ",
  "tha-ap532:10.2": "na cirena bahussuto, ",
  "tha-ap532:10.3": "ahosiṃ dhammakathiko ",
  "tha-ap532:10.4": "vicittapaṭibhāṇavā. ",
  "tha-ap532:11.1": "mahāparisamajjhehaṃ ",
  "tha-ap532:11.2": "haṭṭhacitto punappunaṃ, ",
  "tha-ap532:11.3": "vaṇṇayiṃ hemavaṇṇassa ",
  "tha-ap532:11.4": "vaṇṇaṃ vaṇṇavisārado. ",
  "tha-ap532:12.1": "esa khīṇāsavo buddho ",
  "tha-ap532:12.2": "anīgho chinnasaṃsayo, ",
  "tha-ap532:12.3": "sabbakammakkhayaṃ patto ",
  "tha-ap532:12.4": "vimuttopadhisaṃkhaye. ",
  "tha-ap532:13.1": "esa so bhagavā buddho ",
  "tha-ap532:13.2": "esa sīho anuttare, ",
  "tha-ap532:13.3": "sadevakassa lokassa ",
  "tha-ap532:13.4": "brahmacakkappavattako. ",
  "tha-ap532:14.1": "danto dametā santo ca ",
  "tha-ap532:14.2": "sametā nibbuto isi, ",
  "tha-ap532:14.3": "nibbāpetā ca assattho ",
  "tha-ap532:14.4": "assāsetā mahājanaṃ. ",
  "tha-ap532:15.1": "vīro sūro ca dhīro ca ",
  "tha-ap532:15.2": "pañño kāruṇiko vasī, ",
  "tha-ap532:15.3": "vijitāvī ca sa jino ",
  "tha-ap532:15.4": "appagabbho anālayo. ",
  "tha-ap532:16.1": "anejo acalo dhīmā ",
  "tha-ap532:16.2": "amoho asamo muni, ",
  "tha-ap532:16.3": "dhorayho usabho nāgo ",
  "tha-ap532:16.4": "sīho sakko garūsupi. ",
  "tha-ap532:17.1": "virāgo vimalo brahmā ",
  "tha-ap532:17.2": "vādasūro raṇañjaho, ",
  "tha-ap532:17.3": "akhilo ca visallo ca ",
  "tha-ap532:17.4": "asamo saṃyuto suci. ",
  "tha-ap532:18.1": "brāhmaṇo samaṇo nātho ",
  "tha-ap532:18.2": "bhisakko sallakattako, ",
  "tha-ap532:18.3": "yodho buddho suto suto ",
  "tha-ap532:18.4": "acalo muditodito. ",
  "tha-ap532:19.1": "dhātā dhatā ca hantā ca ",
  "tha-ap532:19.2": "kattā netā pakāsitā, ",
  "tha-ap532:19.3": "sampahaṃsitā bhettā ca ",
  "tha-ap532:19.4": "chettā sotā pasaṃsitā. ",
  "tha-ap532:20.1": "akhilo ca visallo ca ",
  "tha-ap532:20.2": "anīgho akathaṅkathī, ",
  "tha-ap532:20.3": "anejo virajo khantā ",
  "tha-ap532:20.4": "gantā vattā pakāsitā ",
  "tha-ap532:21.1": "tāretā atthakāretā ",
  "tha-ap532:21.2": "kāretā sampadālitā, ",
  "tha-ap532:21.3": "pāpetā sahitā kantā ",
  "tha-ap532:21.4": "hantā ātā pī tāpaso. ",
  "tha-ap532:22.1": "samacitto samasamo ",
  "tha-ap532:22.2": "asahāyo dayāsayo, ",
  "tha-ap532:22.3": "accherasatto akuho ",
  "tha-ap532:22.4": "katāvī isisattamo. ",
  "tha-ap532:23.1": "nittiṇṇakaṅkho nimmāno ",
  "tha-ap532:23.2": "appameyyo anūpamo, ",
  "tha-ap532:23.3": "sabbavākyapathātīto ",
  "tha-ap532:23.4": "saccañeyyantagū jino. ",
  "tha-ap532:24.1": "sattasāravare tasmiṃ ",
  "tha-ap532:24.2": "pasādo amatāvaho, ",
  "tha-ap532:24.3": "tasmā buddhe ca dhamme ca ",
  "tha-ap532:24.4": "saṃghe saddhā mahiddhikā. ",
  "tha-ap532:25.1": "guṇehi evamādīhi ",
  "tha-ap532:25.2": "tilokasaraṇuttamaṃ, ",
  "tha-ap532:25.3": "vaṇṇento parisāmajjhe ",
  "tha-ap532:25.4": "akaṃ dhammakathaṃ ahaṃ. ",
  "tha-ap532:26.1": "tato cutohaṃ tusite ",
  "tha-ap532:26.2": "anubhotvā mahāsukhaṃ, ",
  "tha-ap532:26.3": "tato cuto manussesu ",
  "tha-ap532:26.4": "jāto homi sugandhiko. ",
  "tha-ap532:27.1": "nissāso mukhagandho ca ",
  "tha-ap532:27.2": "dehagandho tatheva me, ",
  "tha-ap532:27.3": "sedagandho ca satataṃ ",
  "tha-ap532:27.4": "sabbagandhe’tiseti’me. ",
  "tha-ap532:28.1": "mukhagandho sadā mayhaṃ ",
  "tha-ap532:28.2": "padumuppalacampake, ",
  "tha-ap532:28.3": "ādisanto sadā vāti ",
  "tha-ap532:28.4": "sarīro ca tatheva me, ",
  "tha-ap532:29.1": "guṇatthavassa sabbaṃ taṃ ",
  "tha-ap532:29.2": "phalaṃ tu paramambhūtaṃ, ",
  "tha-ap532:29.3": "ekaggamanasā sabbe ",
  "tha-ap532:29.4": "vaṇṇayissaṃ suṇātha me. ",
  "tha-ap532:30.1": "guṇaṃ buddhassa vatvāna ",
  "tha-ap532:30.2": "hitāya janasandhisu, ",
  "tha-ap532:30.3": "sukhito homi sabbattha ",
  "tha-ap532:30.4": "saradvadhanisamāyuto ",
  "tha-ap532:31.1": "yasassī sukhito kanto ",
  "tha-ap532:31.2": "jutimā piyadassano, ",
  "tha-ap532:31.3": "vattā aparibhūto ca ",
  "tha-ap532:31.4": "niddoso paññavā tathā. ",
  "tha-ap532:32.1": "khīṇe āyusi nibbānaṃ ",
  "tha-ap532:32.2": "sulabhaṃ buddhabhattino, ",
  "tha-ap532:32.3": "tesaṃ hetuṃ pavakkhāmi ",
  "tha-ap532:32.4": "taṃ suṇātha yathātathaṃ. ",
  "tha-ap532:33.1": "santaṃ yasaṃ bhagavato ",
  "tha-ap532:33.2": "vidhinā abhivādayaṃ, ",
  "tha-ap532:33.3": "yattha tatthupapannopi ",
  "tha-ap532:33.4": "yasassī tena homahaṃ. ",
  "tha-ap532:34.1": "dukkhassantakaraṃ buddhaṃ ",
  "tha-ap532:34.2": "dhammaṃ santamasaṅkhataṃ, ",
  "tha-ap532:34.3": "vaṇṇayaṃ sukhado āsiṃ ",
  "tha-ap532:34.4": "sattānaṃ sukhito tato. ",
  "tha-ap532:35.1": "guṇaṃ vadanto buddhassa ",
  "tha-ap532:35.2": "buddhapītisamāyuto, ",
  "tha-ap532:35.3": "sakantiṃ parakantiñca ",
  "tha-ap532:35.4": "janayiṃ tena kantimā. ",
  "tha-ap532:36.1": "janoghe titthakākiṇṇe ",
  "tha-ap532:36.2": "abhibhuyya kutitthiye, ",
  "tha-ap532:36.3": "guṇaṃ vadanto jotesiṃ ",
  "tha-ap532:36.4": "nāyakaṃ jutimā tato. ",
  "tha-ap532:37.1": "piyakārī janassāpi ",
  "tha-ap532:37.2": "sambuddhassa guṇaṃ vadaṃ, ",
  "tha-ap532:37.3": "saradova sasaṅkohaṃ ",
  "tha-ap532:37.4": "tenāsiṃ piyadassano. ",
  "tha-ap532:38.1": "yathāsattivasenāhaṃ ",
  "tha-ap532:38.2": "sabbavācāhi santhaviṃ, ",
  "tha-ap532:38.3": "sugataṃ tena vāgīso ",
  "tha-ap532:38.4": "vicittapaṭibhāṇavā. ",
  "tha-ap532:39.1": "ye bālā vimatippattā ",
  "tha-ap532:39.2": "paribhonti mahāmuni, ",
  "tha-ap532:39.3": "niggahiṃ te sadhammena ",
  "tha-ap532:39.4": "paribhūto na tenahaṃ. ",
  "tha-ap532:40.1": "buddhavaṇṇena sattānaṃ ",
  "tha-ap532:40.2": "kilese apanesahaṃ, ",
  "tha-ap532:40.3": "nikkilesamano homi ",
  "tha-ap532:40.4": "tassa kammassa vāhasā. ",
  "tha-ap532:41.1": "sotūnaṃ buddhimajaniṃ ",
  "tha-ap532:41.2": "buddhānussatidesako, ",
  "tha-ap532:41.3": "tenāhamāsiṃ sappañño ",
  "tha-ap532:41.4": "nipuṇatthavipassako. ",
  "tha-ap532:42.1": "sabbāsavaparikkhīṇo ",
  "tha-ap532:42.2": "tiṇṇasaṃsārasāgaro, ",
  "tha-ap532:42.3": "sikhīva anupādāno ",
  "tha-ap532:42.4": "pāpuṇissāmi nibbutiṃ. ",
  "tha-ap532:43.1": "imasmiṃ yeva kappasmiṃ ",
  "tha-ap532:43.2": "yamahaṃ santhaviṃ jinaṃ, ",
  "tha-ap532:43.3": "duggatiṃ nābhijānāmi ",
  "tha-ap532:43.4": "buddhavaṇṇassidaṃ phalaṃ. ",
  "tha-ap532:44.1": "kilesā jhāpitā mayhaṃ ",
  "tha-ap532:44.2": "bhavā sabbe samūhatā, nāgova bandhanaṃ chetvā ",
  "tha-ap532:44.3": "viharāmi anāsavo. ",
  "tha-ap532:45.1": "svāgataṃ vata me āsi ",
  "tha-ap532:45.2": "buddhaseṭṭhassa santike, tisso vijjā anuppattā ",
  "tha-ap532:45.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap532:46.1": "paṭisambhidā catasso ",
  "tha-ap532:46.2": "ca vimokkhāpi ca aṭṭhime, chaḷabhiññā sacchikatā ",
  "tha-ap532:46.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap532:47.1": "itthaṃ sudaṃ āyasmā sugandho thero imā gāthāyo abhāsitthāti. ",
  "tha-ap532:48.1": "sugandhattherassa apadānaṃ dasamaṃ. ",
  "tha-ap532:49.1": "uddānaṃ: ",
  "tha-ap532:50.1": "",
  "tha-ap532:51.1": "tiṇado mañcado ceva ",
  "tha-ap532:51.2": "saraṇabbhañjanappado, ",
  "tha-ap532:51.3": "supaṭo daṇḍadāyī ca ",
  "tha-ap532:51.4": "nelapūji tatheva ca, ",
  "tha-ap532:52.1": "bodhisammajjakāmeṇḍo ",
  "tha-ap532:52.2": "sugandho dasamo dijo. ",
  "tha-ap532:52.3": "gāthāsataṃ satevīsaṃ ",
  "tha-ap532:52.4": "gaṇitaṃ cettha sabbaso. tiṇadāyakavaggo tepaññāsamo. "
}
