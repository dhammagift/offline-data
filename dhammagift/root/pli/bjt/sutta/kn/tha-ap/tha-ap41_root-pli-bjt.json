  "tha-ap41:0.2": "",
  "tha-ap41:0.3": "39. dhammacakkikattherāpadānaṃ. ",
  "tha-ap41:1.1": "siddhatthassa bhagavato ",
  "tha-ap41:1.2": "sīhāsanassa sammukhā, ",
  "tha-ap41:1.3": "dhammacakkaṃ mayā ṭhapitaṃ ",
  "tha-ap41:1.4": "sukataṃ viññuvaṇṇitaṃ. ",
  "tha-ap41:2.1": "cāruvaṇṇova sobhāmi ",
  "tha-ap41:2.2": "sayoggabalavāhano, ",
  "tha-ap41:2.3": "parivārenti maṃ niccaṃ ",
  "tha-ap41:2.4": "anuyuttā bahujjanā. ",
  "tha-ap41:3.1": "saṭṭhituriyasahassehi ",
  "tha-ap41:3.2": "paricārema’haṃ sadā, ",
  "tha-ap41:3.3": "parivārena sobhāmi ",
  "tha-ap41:3.4": "puññakammassi’daṃ phalaṃ. ",
  "tha-ap41:4.1": "catunavute ito kappe ",
  "tha-ap41:4.2": "yaṃ cakkaṃ ṭhapayiṃ ahaṃ, ",
  "tha-ap41:4.3": "duggatiṃ nābhijānāmi ",
  "tha-ap41:4.4": "dhammacakkassi’daṃ phalaṃ. ",
  "tha-ap41:5.1": "ito ekādase kappe ",
  "tha-ap41:5.2": "aṭṭhā’siṃsu janādhipā, ",
  "tha-ap41:5.3": "sahassarājanāmena ",
  "tha-ap41:5.4": "cakkavattī mahabbalā. ",
  "tha-ap41:6.1": "paṭisambhidā ",
  "tha-ap41:6.2": "…pe… ",
  "tha-ap41:6.3": "buddhassa sāsanaṃ. ",
  "tha-ap41:7.1": "itthaṃ sudaṃ āyasmā dhammacakkiko thero imā gāthāyo abhāsitthāti. ",
  "tha-ap41:8.1": "dhammacakkikattherassāpadānaṃ navamaṃ. "
}
