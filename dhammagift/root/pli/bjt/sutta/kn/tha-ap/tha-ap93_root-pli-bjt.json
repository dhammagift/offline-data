{
  "tha-ap93:0.1": "",
  "tha-ap93:0.2": "10. sudhāpiṇḍiyavaggo ",
  "tha-ap93:0.3": "91. sudhāpiṇḍiyattherāpadānaṃ. ",
  "tha-ap93:1.1": "pūjārahe pūjayato ",
  "tha-ap93:1.2": "buddhe yadi va sāvake ",
  "tha-ap93:1.3": "papañcasamatikkante ",
  "tha-ap93:1.4": "tiṇṇasokapariddave. ",
  "tha-ap93:2.1": "te tādise pūjayato ",
  "tha-ap93:2.2": "nibbute akutobhaye, ",
  "tha-ap93:2.3": "na sakkā puññaṃ saṅkhātuṃ ",
  "tha-ap93:2.4": "idamettamapi keneci. ",
  "tha-ap93:3.1": "catunnamapi dīpānaṃ ",
  "tha-ap93:3.2": "issaraṃ yo’dha kāraye, ",
  "tha-ap93:3.3": "ekissā pūjanāyetaṃ ",
  "tha-ap93:3.4": "kalaṃ nāgghati soḷasiṃ. ",
  "tha-ap93:4.1": "siddhatthassa naraggassa ",
  "tha-ap93:4.2": "cetiye eḷitantare, ",
  "tha-ap93:4.3": "sudhāpiṇḍo mayā dinno ",
  "tha-ap93:4.4": "vippasannena cetasā. ",
  "tha-ap93:5.1": "catunavute ito kappe ",
  "tha-ap93:5.2": "yaṃ kammamakariṃ tadā, ",
  "tha-ap93:5.3": "duggatiṃ nābhijānāmi ",
  "tha-ap93:5.4": "paṭisaṅkhārassidaṃ phalaṃ. ",
  "tha-ap93:6.1": "ito tiṃsatikappamhi ",
  "tha-ap93:6.2": "paṭisaṅkhārasavhayā ",
  "tha-ap93:6.3": "sattaratanasampannā ",
  "tha-ap93:6.4": "terasa cakkavattino. ",
  "tha-ap93:7.1": "paṭisambhidā …pe… ",
  "tha-ap93:7.2": "",
  "tha-ap93:7.3": "",
  "tha-ap93:7.4": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap93:8.1": "itthaṃ sudaṃ āyasmā sudhāpiṇḍiyo thero imā gāthāyo abhāsitthāti. ",
  "tha-ap93:9.1": "sudhāpiṇḍiyattherassa apadānaṃ paṭhamaṃ. "
}
