{
  "tha-ap209:0.1": "",
  "tha-ap209:0.2": "",
  "tha-ap209:0.3": "207. salalamāliyattherāpadānaṃ ",
  "tha-ap209:1.1": "kaṇikāraṃva jotantaṃ ",
  "tha-ap209:1.2": "nisinnaṃ pabbatantare, ",
  "tha-ap209:1.3": "obhāsentaṃ disā sabbā ",
  "tha-ap209:1.4": "siddhatthaṃ narasārathiṃ. ",
  "tha-ap209:2.1": "dhanumadvejjhaṃ katvāna ",
  "tha-ap209:2.2": "usuṃ sannayha’haṃ tadā, ",
  "tha-ap209:2.3": "pupphaṃ savaṇaṭaṃ chetvāna ",
  "tha-ap209:2.4": "buddhassa abhiropayiṃ. ",
  "tha-ap209:3.1": "catunavute ito kappe ",
  "tha-ap209:3.2": "yaṃ pupphamabhipūjayiṃ, ",
  "tha-ap209:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap209:3.4": "buddhapūjāyidaṃ phalaṃ. ",
  "tha-ap209:4.1": "ekapaññāsi’to kappe ",
  "tha-ap209:4.2": "eko āsiṃ jutindharo, ",
  "tha-ap209:4.3": "sattaratanasampanno ",
  "tha-ap209:4.4": "cakkavattī mahabbalo. ",
  "tha-ap209:5.1": "paṭisambhidā catasso ",
  "tha-ap209:5.2": "vimokkhāpi ca aṭṭhime, chaḷabhiññā sacchikatā ",
  "tha-ap209:5.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap209:6.1": "itthaṃ sudaṃ āyasmā sallamāliyo thero imā gāthāyo abhāsitthāti. ",
  "tha-ap209:7.1": "salalamāliyattherassa apadānaṃ sattamaṃ. "
}
