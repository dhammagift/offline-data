{
  "tha-ap101:0.1": "",
  "tha-ap101:0.2": "",
  "tha-ap101:0.3": "99. veyyāvaccakattherāpadānaṃ. ",
  "tha-ap101:1.1": "vipassissa bhagavato ",
  "tha-ap101:1.2": "mahābhūrigaṇo ahu, ",
  "tha-ap101:1.3": "veyyāvaccakaro āsiṃ ",
  "tha-ap101:1.4": "sabbakiccesu vyāvaṭo. ",
  "tha-ap101:2.1": "deyyadhammo ca me natthi ",
  "tha-ap101:2.2": "sugatassa mahesino, ",
  "tha-ap101:2.3": "avandiṃ satthuno pāde ",
  "tha-ap101:2.4": "vippasannena cetasā. ",
  "tha-ap101:3.1": "ekanavute ito kappe ",
  "tha-ap101:3.2": "veyyāvaccaṃ akāsahaṃ, ",
  "tha-ap101:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap101:3.4": "veyyāvaccassidaṃ phalaṃ. ",
  "tha-ap101:4.1": "ito ca aṭṭhame kappe ",
  "tha-ap101:4.2": "rājā āsiṃ sucintito, ",
  "tha-ap101:4.3": "sattaratanasampanno ",
  "tha-ap101:4.4": "cakkavattī mahabbalo. ",
  "tha-ap101:5.1": "paṭisambhidā ",
  "tha-ap101:5.2": "…pe… ",
  "tha-ap101:5.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap101:6.1": "itthaṃ sudaṃ āyasmā veyyāvaccako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap101:7.1": "veyyāvaccakattherassa apadānaṃ navamaṃ. "
}
