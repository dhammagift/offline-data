{
  "tha-ap61:0.1": "",
  "tha-ap61:0.2": "",
  "tha-ap61:0.3": "59. padumattherāpadānaṃ ",
  "tha-ap61:1.1": "catusaccaṃ pakāsento ",
  "tha-ap61:1.2": "varadhammappavattako, ",
  "tha-ap61:1.3": "vassate amataṃ vuṭṭhiṃ ",
  "tha-ap61:1.4": "nibbāpento mahājanaṃ. ",
  "tha-ap61:2.1": "sadaṇḍaṃ padumaṃ gayha ",
  "tha-ap61:2.2": "aḍḍhakose ṭhito ahaṃ, ",
  "tha-ap61:2.3": "padumuttaramunissa ",
  "tha-ap61:2.4": "haṭṭho ukkhipimambare. ",
  "tha-ap61:3.1": "āgacchante ca padume ",
  "tha-ap61:3.2": "abbhuto āsi tāvado, ",
  "tha-ap61:3.3": "mama saṅkappamaññāya ",
  "tha-ap61:3.4": "paggaṇhi vadataṃ varo. ",
  "tha-ap61:4.1": "karaseṭṭhena paggayha ",
  "tha-ap61:4.2": "jalajaṃ pupphamuttamaṃ, ",
  "tha-ap61:4.3": "bhikkhusaṃghe ṭhito satthā ",
  "tha-ap61:4.4": "imā gāthā abhāsatha: ",
  "tha-ap61:5.1": "“yenidaṃ padumaṃ khittaṃ ",
  "tha-ap61:5.2": "sabbaññūmhi vināyake, ",
  "tha-ap61:5.3": "tamahaṃ kittayissāmi ",
  "tha-ap61:5.4": "suṇātha mama bhāsato. ",
  "tha-ap61:6.1": "tiṃsa kappāni devindo ",
  "tha-ap61:6.2": "devarajjaṃ karissati, ",
  "tha-ap61:6.3": "pathavyā rajjaṃ sattasataṃ ",
  "tha-ap61:6.4": "vasudhaṃ āvasissati. ",
  "tha-ap61:7.1": "tattha pattaṃ gaṇetvāna ",
  "tha-ap61:7.2": "cakkavattī bhavissati, ",
  "tha-ap61:7.3": "ākāsato pupphavuṭṭhi ",
  "tha-ap61:7.4": "abhivassissati tadā. ",
  "tha-ap61:8.1": "kappasatasahassamhi ",
  "tha-ap61:8.2": "okkākakulasambhavo, ",
  "tha-ap61:8.3": "gotamo nāma nāmena ",
  "tha-ap61:8.4": "satthā loke bhavissati. ",
  "tha-ap61:9.1": "tassa dhammesu dāyādo ",
  "tha-ap61:9.2": "oraso dhammanimmito, ",
  "tha-ap61:9.3": "sabbāsave pariññāya ",
  "tha-ap61:9.4": "nibbāyissatanāsavo.” ",
  "tha-ap61:10.1": "nikkhamitvāna kucchimhā ",
  "tha-ap61:10.2": "sampajāno patissato, ",
  "tha-ap61:10.3": "jātiyā pañcavasso’haṃ ",
  "tha-ap61:10.4": "arahattamapāpuṇiṃ. 1333 ",
  "tha-ap61:11.1": "paṭisambhidā ",
  "tha-ap61:11.2": "…pe… ",
  "tha-ap61:11.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap61:12.1": "itthaṃ sudaṃ āyasmā padumo thero imā gāthāyo abhāsitthāti. ",
  "tha-ap61:13.1": "padumattherassa apadānaṃ navamaṃ. "
}
