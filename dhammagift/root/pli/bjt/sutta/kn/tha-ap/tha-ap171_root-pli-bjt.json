{
  "tha-ap171:0.1": "",
  "tha-ap171:0.2": "",
  "tha-ap171:0.3": "169. samādapakattherāpadānaṃ. ",
  "tha-ap171:1.1": "nagare bandhumatiyā ",
  "tha-ap171:1.2": "mahāpūgagaṇo ahu, ",
  "tha-ap171:1.3": "tesāhaṃ pavaro āsiṃ ",
  "tha-ap171:1.4": "mama baddhavarā ca te. te ",
  "tha-ap171:2.1": "sabbe sannipātetvā ",
  "tha-ap171:2.2": "puññakamme samādayiṃ, ",
  "tha-ap171:2.3": "mālaṃ kassāma saṅghassa ",
  "tha-ap171:2.4": "puññakkhettamanuttaraṃ. ",
  "tha-ap171:3.1": "sādhū’ti te paṭissutvā ",
  "tha-ap171:3.2": "mama chandavasānugā, ",
  "tha-ap171:3.3": "niṭṭhāpesuṃ ca taṃ mālaṃ ",
  "tha-ap171:3.4": "vipassissa adamhase. ",
  "tha-ap171:4.1": "ekanavute ito kappe ",
  "tha-ap171:4.2": "yaṃ mālamadadiṃ tadā, ",
  "tha-ap171:4.3": "duggatiṃ nābhijānāmi ",
  "tha-ap171:4.4": "māladānassidaṃ phalaṃ. ",
  "tha-ap171:5.1": "ekūnasaṭṭhikappamhi ",
  "tha-ap171:5.2": "eko āsi janādhipo, ",
  "tha-ap171:5.3": "ādeyyo nāma nāmena ",
  "tha-ap171:5.4": "cakkavattī mahabbalo. ",
  "tha-ap171:6.1": "paṭisambhidā catasso ",
  "tha-ap171:6.2": "vimokkhāpi ca aṭṭhime, chaḷabhiññā sacchikatā ",
  "tha-ap171:6.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap171:7.1": "itthaṃ sudaṃ āyasmā samādapako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap171:8.1": "samādapakattherassa apadānaṃ navamaṃ. "
}
