{
  "tha-ap539:0.1": "",
  "tha-ap539:0.2": "",
  "tha-ap539:0.3": "537. koṭṭhitattherāpadānaṃ ",
  "tha-ap539:1.1": "padumuttaro nāma jino ",
  "tha-ap539:1.2": "sabbalokavidū muni, ",
  "tha-ap539:1.3": "ito satasahassamhi ",
  "tha-ap539:1.4": "kappe uppajji cakkhumā. ",
  "tha-ap539:2.1": "ovādako viññāpako ",
  "tha-ap539:2.2": "tārako sabbapāṇinaṃ, ",
  "tha-ap539:2.3": "desanākusalo buddho ",
  "tha-ap539:2.4": "tāresi janataṃ bahuṃ. ",
  "tha-ap539:3.1": "anukampako kāruṇiko ",
  "tha-ap539:3.2": "hitesī sabbapāṇinaṃ, ",
  "tha-ap539:3.3": "sampatte titthiye sabbe ",
  "tha-ap539:3.4": "pañcasīle patiṭṭhapi. ",
  "tha-ap539:4.1": "evaṃ nirākulaṃ āsi ",
  "tha-ap539:4.2": "suññakaṃ titthiyehi ca, ",
  "tha-ap539:4.3": "vicittaṃ arahantehi ",
  "tha-ap539:4.4": "vasībhūtehi tādihi. ",
  "tha-ap539:5.1": "ratanānaṭṭhapaññāsaṃ ",
  "tha-ap539:5.2": "uggato so mahāmuni, ",
  "tha-ap539:5.3": "kañcanagghiyasaṅkāso ",
  "tha-ap539:5.4": "battiṃsavaralakkhaṇo. ",
  "tha-ap539:6.1": "vassasatasahassāni ",
  "tha-ap539:6.2": "āyu vijjati tāvade, ",
  "tha-ap539:6.3": "tāvatā tiṭṭhamāno so ",
  "tha-ap539:6.4": "tāresi janataṃ bahuṃ. ",
  "tha-ap539:7.1": "tadāhaṃ haṃsavatiyaṃ ",
  "tha-ap539:7.2": "brāhmaṇo vedapāragu, ",
  "tha-ap539:7.3": "upetvā sattasāraggaṃ ",
  "tha-ap539:7.4": "assosiṃ dhammadesanaṃ. ",
  "tha-ap539:8.1": "tadā so sāvakaṃ vīro ",
  "tha-ap539:8.2": "pabhinnamatigocaraṃ, ",
  "tha-ap539:8.3": "atthe dhamme ca nerutte ",
  "tha-ap539:8.4": "paṭibhāne ca kovidaṃ. ",
  "tha-ap539:9.1": "ṭhapesi etadaggamhi ",
  "tha-ap539:9.2": "taṃ sutvā mudito ahaṃ, ",
  "tha-ap539:9.3": "sasāvakaṃ jinavaraṃ ",
  "tha-ap539:9.4": "sattāhaṃ bhojayiṃ tadā. ",
  "tha-ap539:10.1": "dussehakacchādayitvāna ",
  "tha-ap539:10.2": "sasissaṃ buddhisāgaraṃ, ",
  "tha-ap539:10.3": "nipacca pādamūlamhi ",
  "tha-ap539:10.4": "taṃ ṭhānaṃ patthayiṃ ahaṃ. ",
  "tha-ap539:11.1": "tato avoca lokaggo ",
  "tha-ap539:11.2": "passathetaṃ dijuttamaṃ, ",
  "tha-ap539:11.3": "vinataṃ pādamūle me ",
  "tha-ap539:11.4": "kamalodarasappabhaṃ. ",
  "tha-ap539:12.1": "buddhaseṭṭhassa bhikkhussa ",
  "tha-ap539:12.2": "ṭhānaṃ patthayate ayaṃ, ",
  "tha-ap539:12.3": "tāya saddhāya cāgena ",
  "tha-ap539:12.4": "dhammassa savaṇena ca. ",
  "tha-ap539:13.1": "sabbattha sukhito hutvā ",
  "tha-ap539:13.2": "saṃsaritvā bhavābhave, ",
  "tha-ap539:13.3": "anāgatamhi addhāne ",
  "tha-ap539:13.4": "lacchate taṃ manorathaṃ. ",
  "tha-ap539:14.1": "satasahasse ito kappe ",
  "tha-ap539:14.2": "okkākakulasambhavo, ",
  "tha-ap539:14.3": "gotamo nāma nāmena ",
  "tha-ap539:14.4": "satthā loke bhavissati. ",
  "tha-ap539:15.1": "tassa dhammesu dāyādo ",
  "tha-ap539:15.2": "oraso dhammanimmito ",
  "tha-ap539:15.3": "koṭṭhito nāma nāmena ",
  "tha-ap539:15.4": "hessati satthu sāvake. ",
  "tha-ap539:16.1": "taṃ sutvā mudito hutvā ",
  "tha-ap539:16.2": "yāvajīvaṃ tadā jinaṃ, ",
  "tha-ap539:16.3": "mettacitto paricariṃ ",
  "tha-ap539:16.4": "sato paññāsamāhito. ",
  "tha-ap539:17.1": "tena kammavipākena ",
  "tha-ap539:17.2": "cetanāpaṇidhīhi ca, ",
  "tha-ap539:17.3": "jahitvā mānusaṃ dehaṃ ",
  "tha-ap539:17.4": "tāvatiṃsamagacchahaṃ. ",
  "tha-ap539:18.1": "satānaṃ tīṇikkhattuñca ",
  "tha-ap539:18.2": "devarajjamakārayiṃ, ",
  "tha-ap539:18.3": "satānaṃ pañcakkhattuñca ",
  "tha-ap539:18.4": "cakkavattī ahosahaṃ. ",
  "tha-ap539:19.1": "padesarajjaṃ vipulaṃ ",
  "tha-ap539:19.2": "gaṇanāto asaṃkhiyaṃ, ",
  "tha-ap539:19.3": "sabbattha sukhito āsiṃ ",
  "tha-ap539:19.4": "tassa kammassa vāhasā. ",
  "tha-ap539:20.1": "duve bhave saṃsarāmi ",
  "tha-ap539:20.2": "devatte atha mānuse, ",
  "tha-ap539:20.3": "aññaṃ gatiṃ na gacchāmi ",
  "tha-ap539:20.4": "suciṇṇassa idaṃ phalaṃ. ",
  "tha-ap539:21.1": "duve kule pajāyāmi ",
  "tha-ap539:21.2": "khattiye atha brāhmaṇe, ",
  "tha-ap539:21.3": "nīce kule na jāyāmi ",
  "tha-ap539:21.4": "suciṇṇassa idaṃ phalaṃ. ",
  "tha-ap539:22.1": "pacchimbhavesampatte ",
  "tha-ap539:22.2": "brahmabandhu ahosahaṃ, ",
  "tha-ap539:22.3": "sāvatthiyaṃ vippakule ",
  "tha-ap539:22.4": "paccājāto mahaddhane. ",
  "tha-ap539:23.1": "mātā candavatī nāma ",
  "tha-ap539:23.2": "pitā me assalāyano, ",
  "tha-ap539:23.3": "yadā me pitaraṃ buddho ",
  "tha-ap539:23.4": "vinayī sabbasuddhiyā. ",
  "tha-ap539:24.1": "tadā pasanno sugate ",
  "tha-ap539:24.2": "pabbajiṃ anagāriyaṃ, ",
  "tha-ap539:24.3": "moggallāno ācariyo ",
  "tha-ap539:24.4": "upajjho sārisambhavo. ",
  "tha-ap539:25.1": "kesesu chijjamānesu ",
  "tha-ap539:25.2": "diṭṭhi chinnā samūlikā, ",
  "tha-ap539:25.3": "nivāsento ca kāsāvaṃ ",
  "tha-ap539:25.4": "arahattamapāpuṇiṃ. ",
  "tha-ap539:26.1": "atthadhammaniruttīsu ",
  "tha-ap539:26.2": "paṭibhāne ca me mati, ",
  "tha-ap539:26.3": "pabhinnā tena lokaggo ",
  "tha-ap539:26.4": "etadagge ṭhapesi maṃ. ",
  "tha-ap539:27.1": "asandiddhaṃ vīyākāsiṃ ",
  "tha-ap539:27.2": "upatissena pucchito, ",
  "tha-ap539:27.3": "paṭisambhidāsu tenāhaṃ ",
  "tha-ap539:27.4": "aggo sambuddhasāsane. ",
  "tha-ap539:28.1": "kilesā jhāpitā mayhaṃ ",
  "tha-ap539:28.2": "bhavā sabbe samūhatā, nāgo’va bandhanaṃ chetvā ",
  "tha-ap539:28.3": "viharāmi anāsavo. ",
  "tha-ap539:29.1": "svāgataṃ vata me āsi ",
  "tha-ap539:29.2": "buddhaseṭṭhassa santike, tisso vijjā anuppattā ",
  "tha-ap539:29.3": "kataṃ buddhassaṃ sāsanaṃ. ",
  "tha-ap539:30.1": "paṭisambhidā catasso ",
  "tha-ap539:30.2": "ca vimokkhāpi ca aṭṭhime, chaḷabhiññā sacchikatā ",
  "tha-ap539:30.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap539:31.1": "itthaṃ sudaṃ āyasmā mahākoṭṭhito thero imaṃ gāthāyo abhāsitthāti ",
  "tha-ap539:32.1": "mahākoṭṭhitattherassa apadānaṃ sattamaṃ. "
}
