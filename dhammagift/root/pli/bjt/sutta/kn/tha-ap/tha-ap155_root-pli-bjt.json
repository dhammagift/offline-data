{
  "tha-ap155:0.1": "",
  "tha-ap155:0.2": "",
  "tha-ap155:0.3": "153. vithisammajjakattherāpādanaṃ. ",
  "tha-ap155:1.1": "udentaṃ sataraṃsiṃva ",
  "tha-ap155:1.2": "pītaraṃsiṃva bhānumaṃ, ",
  "tha-ap155:1.3": "paṇṇarase yathā candaṃ ",
  "tha-ap155:1.4": "niyyantaṃ lokanāyakaṃ. ",
  "tha-ap155:2.1": "aṭṭhasaṭṭhisahassāni ",
  "tha-ap155:2.2": "sabbe khīṇāsavā ahū, ",
  "tha-ap155:2.3": "parivāriṃsu sambuddhaṃ ",
  "tha-ap155:2.4": "dipadindaṃ narāsabhaṃ. ",
  "tha-ap155:3.1": "sammajjitvāna taṃ vīthiṃ ",
  "tha-ap155:3.2": "nīyante lokanāyake, ",
  "tha-ap155:3.3": "ussāpesiṃ dhajaṃ tathe ",
  "tha-ap155:3.4": "vippasannena cetasā. ",
  "tha-ap155:4.1": "ekanavute ito kappe ",
  "tha-ap155:4.2": "yaṃ dhajaṃ abhiropayiṃ, ",
  "tha-ap155:4.3": "duggatiṃ nābhijānāmi ",
  "tha-ap155:4.4": "dhajadānassidaṃ phalaṃ. ",
  "tha-ap155:5.1": "ito catutthake kappe ",
  "tha-ap155:5.2": "rājā’hosiṃ mahabbalo, ",
  "tha-ap155:5.3": "sabbākārena sampanno ",
  "tha-ap155:5.4": "sudhajo iti vissuto. ",
  "tha-ap155:6.1": "paṭisambhidā catasso ",
  "tha-ap155:6.2": "vimokkhāpi ca aṭṭhime, chaḷabhiññā sacchikatā ",
  "tha-ap155:6.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap155:7.1": "itthaṃ sudaṃ āyasmā vithisammajjako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap155:8.1": "vīthisammajjakattherassa apadānaṃ tatiyaṃ. "
}
