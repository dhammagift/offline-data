  "tha-ap275:0.2": "",
  "tha-ap275:0.3": "273. caṅgoṭakiyattherāpadānaṃ ",
  "tha-ap275:1.1": "mahāsamuddaṃ nissāya ",
  "tha-ap275:1.2": "vasate pabbatantare, ",
  "tha-ap275:1.3": "paccuggantvāna katvāna ",
  "tha-ap275:1.4": "caṅgoṭakamadāsahaṃ. ",
  "tha-ap275:2.1": "siddhatthassa mahesino ",
  "tha-ap275:2.2": "sabbasattānukampino, ",
  "tha-ap275:2.3": "pupphacaṅgoṭakaṃ datvā ",
  "tha-ap275:2.4": "kappaṃ saggamhi modahaṃ. ",
  "tha-ap275:3.1": "catunavute ito kappe ",
  "tha-ap275:3.2": "caṅgoṭakamadaṃ tadā, ",
  "tha-ap275:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap275:3.4": "caṅgoṭakassidaṃ phalaṃ. ",
  "tha-ap275:4.1": "paṭisambhidā catasso ",
  "tha-ap275:4.2": "vimokkhāpi ca aṭṭhime, chaḷabhiññā sacchikatā ",
  "tha-ap275:4.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap275:5.1": "itthaṃ sudaṃ āyasmā caṅgoṭakiyo thero imā gāthāyo abhāsitthāti. ",
  "tha-ap275:6.1": "caṅgoṭakiyattherassa apadānaṃ tatiyaṃ. "
}
