{
  "tha-ap352:0.1": "",
  "tha-ap352:0.2": "",
  "tha-ap352:0.3": "350. ekañjaliyattherāpadānaṃ ",
  "tha-ap352:1.1": "revato nāma sambuddho ",
  "tha-ap352:1.2": "nadīkūle vasī tadā, ",
  "tha-ap352:1.3": "addasaṃ virajaṃ buddhaṃ ",
  "tha-ap352:1.4": "pītaraṃsiṃva bhānumaṃ. ",
  "tha-ap352:2.1": "ukkāmukhapahaṭṭhaṃva ",
  "tha-ap352:2.2": "khadiraṅgārasannibhaṃ, ",
  "tha-ap352:2.3": "osadhiṃva virocantaṃ ",
  "tha-ap352:2.4": "ekañjalimakāsabhaṃ. catunavute ",
  "tha-ap352:3.1": "ito kappe ",
  "tha-ap352:3.2": "yamañjalimakāsahaṃ, ",
  "tha-ap352:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap352:3.4": "añjaliyā idaṃ phalaṃ. ",
  "tha-ap352:4.1": "paṭisambhidā catasso ",
  "tha-ap352:4.2": "vimokkhāpi ca aṭṭhime, chaḷabhiññā sacchikatā ",
  "tha-ap352:4.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap352:5.1": "itthaṃ sudaṃ āyasmā ekañjaliyo thero imā gāthāyo abhāsitthāti. ",
  "tha-ap352:6.1": "ekañjaliyattherassa apadānaṃ dasamaṃ. ",
  "tha-ap352:7.1": "uddānaṃ: ",
  "tha-ap352:8.1": "",
  "tha-ap352:9.1": "padumī uppalamālī ",
  "tha-ap352:9.2": "dhajo kiṅkiṇiko naḷo ",
  "tha-ap352:9.3": "campako padumo muṭṭhi ",
  "tha-ap352:9.4": "tindukekañjalī tathā ",
  "tha-ap352:9.5": "cha ca saṭṭhi ca gāthāyo ",
  "tha-ap352:9.6": "gaṇitāyo vibhāvihi. ekapadumiyavaggo pañcatiṃsatimo. "
}
