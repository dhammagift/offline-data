{
  "tha-ap34:0.1": "",
  "tha-ap34:0.2": "",
  "tha-ap34:0.3": "32. sāgatattherāpadānaṃ. ",
  "tha-ap34:1.1": "sobhito nāma nāmena ",
  "tha-ap34:1.2": "ahosiṃ brāhmaṇo tadā, ",
  "tha-ap34:1.3": "purakkhato sasissehi ",
  "tha-ap34:1.4": "ārāmaṃ agamāsa’haṃ ",
  "tha-ap34:2.1": "bhagavā tamhi samaye ",
  "tha-ap34:2.2": "bhikkhusaṅghapurakkhato, ",
  "tha-ap34:2.3": "ārāmadvārā nikkhamma ",
  "tha-ap34:2.4": "aṭṭhāsi purisuttamo. ",
  "tha-ap34:3.1": "tamaddasāsiṃ sambuddhaṃ ",
  "tha-ap34:3.2": "dantaṃ dantapurakkhataṃ, ",
  "tha-ap34:3.3": "sakaṃ cittaṃ pasādetvā ",
  "tha-ap34:3.4": "santhaviṃ lokanāyakaṃ. ",
  "tha-ap34:4.1": "“ye keci pādapā sabbe ",
  "tha-ap34:4.2": "mahiyā te virūhare, ",
  "tha-ap34:4.3": "buddhimanto tathā sattā ",
  "tha-ap34:4.4": "rūhanti jinasāsane. ",
  "tha-ap34:5.1": "satthavāho’si sappañño ",
  "tha-ap34:5.2": "mahesī bahuke jane, ",
  "tha-ap34:5.3": "vipathā uddharitvāna ",
  "tha-ap34:5.4": "pathaṃ ācikkhase tuvaṃ. ",
  "tha-ap34:6.1": "danto antaparikiṇṇo ",
  "tha-ap34:6.2": "jhāyī jhānaratehi ca, ",
  "tha-ap34:6.3": "ātāpī pahitattehi ",
  "tha-ap34:6.4": "upasantehi tādihi. ",
  "tha-ap34:7.1": "alaṅkato parisāhi ",
  "tha-ap34:7.2": "puññāṇehi sobhasi, ",
  "tha-ap34:7.3": "pabhā niddhāvate tuyhaṃ ",
  "tha-ap34:7.4": "suriyodayane yathā. ",
  "tha-ap34:8.1": "pasannacittaṃ disvāna ",
  "tha-ap34:8.2": "mahesī padumuttaro, ",
  "tha-ap34:8.3": "bhikkhusaṃghe ṭhito satthā ",
  "tha-ap34:8.4": "imā gāthā abhāsatha. ",
  "tha-ap34:9.1": "yo so hāsaṃ janetvāna ",
  "tha-ap34:9.2": "mamaṃ kittesi brāhmaṇo, ",
  "tha-ap34:9.3": "kappānaṃ satasahassaṃ ",
  "tha-ap34:9.4": "devaloke ramissati. ",
  "tha-ap34:10.1": "tusitā hi cavitvāna ",
  "tha-ap34:10.2": "sukkamūlena codito, ",
  "tha-ap34:10.3": "gotamassa bhagavato ",
  "tha-ap34:10.4": "sāsane pabbajissati. ",
  "tha-ap34:11.1": "tena kammena sukatena ",
  "tha-ap34:11.2": "arahattaṃ labhissati, ",
  "tha-ap34:11.3": "sāgato nāma nāmena ",
  "tha-ap34:11.4": "hessati satthu sāvako. ",
  "tha-ap34:12.1": "pabbajitvāna kāyena ",
  "tha-ap34:12.2": "pāpakammaṃ vivajjayiṃ, ",
  "tha-ap34:12.3": "vacīduccaritaṃ hitvā ",
  "tha-ap34:12.4": "ājīvaṃ parisodhayiṃ. ",
  "tha-ap34:13.1": "evaṃ viharamāno’haṃ ",
  "tha-ap34:13.2": "tejodhātusu kovido, ",
  "tha-ap34:13.3": "sabbāsave pariññāya ",
  "tha-ap34:13.4": "viharāmi anāsavo. ",
  "tha-ap34:14.1": "paṭisambhidā ",
  "tha-ap34:14.2": "…pe… ",
  "tha-ap34:14.3": "buddhassa sāsanaṃ. ",
  "tha-ap34:15.1": "itthaṃ sudaṃ āyasmā sāgato thero imā gāthāyo abhāsitthāti. ",
  "tha-ap34:16.1": "sāgatattherassāpadānaṃ dutiyaṃ. "
}
