  "tha-ap29:0.1": "",
  "tha-ap29:0.2": "",
  "tha-ap29:0.3": "27. pulinapūjakattherāpadānaṃ ",
  "tha-ap29:1.1": "vipassissa bhagavato ",
  "tha-ap29:1.2": "bodhiyā pādaputtame, ",
  "tha-ap29:1.3": "purāṇapulinaṃ chaḍḍetvā suddhaṃ ",
  "tha-ap29:1.4": "pulinamākiriṃ. ekanavute ",
  "tha-ap29:2.1": "ito kappe ",
  "tha-ap29:2.2": "yaṃ pulinamadāsa’haṃ, ",
  "tha-ap29:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap29:2.4": "pulinadānassi’daṃ phalaṃ. ",
  "tha-ap29:3.1": "tipaññāse ito kappe ",
  "tha-ap29:3.2": "rājā āsiṃ janādhibhū, ",
  "tha-ap29:3.3": "mahāpulinanāmena ",
  "tha-ap29:3.4": "cakkavattī mahabbalo. ",
  "tha-ap29:4.1": "paṭisambhidā …pe… ",
  "tha-ap29:4.2": "",
  "tha-ap29:4.3": "",
  "tha-ap29:4.4": "buddhassa sāsanaṃ. ",
  "tha-ap29:5.1": "itthaṃ sudaṃ āyasmā pulinapūjako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap29:6.1": "pulinapūjakattherassāpadānaṃ sattamaṃ. "
}
