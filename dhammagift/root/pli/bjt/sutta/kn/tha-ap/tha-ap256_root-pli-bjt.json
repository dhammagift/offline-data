{
  "tha-ap256:0.1": "",
  "tha-ap256:0.2": "",
  "tha-ap256:0.3": "254. ticampakapupphiyattherāpadānaṃ. ",
  "tha-ap256:1.1": "himavantassa avidūre ",
  "tha-ap256:1.2": "vikato nāma pabbato, ",
  "tha-ap256:1.3": "tassa vemajjhe vasati ",
  "tha-ap256:1.4": "samaṇo bhāvitindriyo. ",
  "tha-ap256:2.1": "disvāna tassopasamaṃ ",
  "tha-ap256:2.2": "vippasannena cetasā, ",
  "tha-ap256:2.3": "tīṇi campakapupphāni ",
  "tha-ap256:2.4": "gahetvāna samokiriṃ. ",
  "tha-ap256:3.1": "ekanavute ito kappe ",
  "tha-ap256:3.2": "yaṃ pupphamabhipūjayiṃ, ",
  "tha-ap256:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap256:3.4": "buddhapūjāyidaṃ phalaṃ. ",
  "tha-ap256:4.1": "paṭisambhidā catasso ",
  "tha-ap256:4.2": "vimokkhāpi ca aṭṭhime, chaḷabhiññā sacchikatā ",
  "tha-ap256:4.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap256:5.1": "itthaṃ sudaṃ āyasmā ticampakapupphiyo thero imā gāthāyo abhāsitthāti. ",
  "tha-ap256:6.1": "ticampakapupphiyattherassa apadānaṃ catutthaṃ. "
}
