{
  "tha-ap192:0.1": "",
  "tha-ap192:0.2": "",
  "tha-ap192:0.3": "190. tivaṇṭipupphiyattherāpadānaṃ. ",
  "tha-ap192:1.1": "abhibhūto panijjhanti ",
  "tha-ap192:1.2": "sabbe saṅgamma te mamaṃ, ",
  "tha-ap192:1.3": "tesaṃ nijjhāyamānānaṃ ",
  "tha-ap192:1.4": "pariḷāho ajāyatha. ",
  "tha-ap192:2.1": "sunando nāma nāmena ",
  "tha-ap192:2.2": "buddhassa sāvako tadā, ",
  "tha-ap192:2.3": "dhammadassissa munino ",
  "tha-ap192:2.4": "āgacchi mama santike. ",
  "tha-ap192:3.1": "ye me baddhacarā āsuṃ ",
  "tha-ap192:3.2": "te me pupphaṃ aduṃ tadā, ",
  "tha-ap192:3.3": "tāhaṃ pupphaṃ gahetvāna ",
  "tha-ap192:3.4": "sāvake abhiropayiṃ. ",
  "tha-ap192:4.1": "sohaṃ kālakato tattha ",
  "tha-ap192:4.2": "punāpi upapajjahaṃ, ",
  "tha-ap192:4.3": "aṭṭhārase kappasate ",
  "tha-ap192:4.4": "vinipātaṃ na gacchahaṃ. ",
  "tha-ap192:5.1": "teraseto kappasate ",
  "tha-ap192:5.2": "aṭṭhāsuṃ dhūmaketuno, ",
  "tha-ap192:5.3": "sattaratanasampannā ",
  "tha-ap192:5.4": "cakkavattī mahabbalā. ",
  "tha-ap192:6.1": "paṭisambhidā catasso ",
  "tha-ap192:6.2": "vimokkhāpi ca aṭṭhime, chaḷabhiññā sacchikatā ",
  "tha-ap192:6.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap192:7.1": "itthaṃ sudaṃ āyasmā tivaṇṭipupphiyo thero imā gāthāyo abhāsitthāti. ",
  "tha-ap192:8.1": "tivaṇṭipupphiyattherassa apadānaṃ dasamaṃ. ",
  "tha-ap192:9.1": "uddānaṃ: ",
  "tha-ap192:10.1": "",
  "tha-ap192:11.1": "kuṭajo bandhujīvī ca ",
  "tha-ap192:11.2": "koṭumbarikahatthiyo ",
  "tha-ap192:11.3": "isimuggo ca bodhī ca ",
  "tha-ap192:11.4": "ekacintī tikaṇṇiko ",
  "tha-ap192:11.5": "ekacārī tivaṇṭī ca ",
  "tha-ap192:11.6": "gāthā dvāsaṭṭhi kittitā. "
}
