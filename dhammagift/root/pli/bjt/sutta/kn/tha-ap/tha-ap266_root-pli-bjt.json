{
  "tha-ap266:0.1": "",
  "tha-ap266:0.2": "",
  "tha-ap266:0.3": "264. padīpiyattherāpadānaṃ ",
  "tha-ap266:1.1": "devabhūto ahaṃ santo ",
  "tha-ap266:1.2": "oruyha paṭhaviṃ tadā, ",
  "tha-ap266:1.3": "padīpe pañca pādāsiṃ ",
  "tha-ap266:1.4": "pasanno sehi pāṇihi. catunavute ",
  "tha-ap266:2.1": "ito kappe ",
  "tha-ap266:2.2": "yaṃ padīpamadaṃ tadā, ",
  "tha-ap266:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap266:2.4": "dīpadānassidaṃ phalaṃ. ",
  "tha-ap266:3.1": "pañcapaññāsake kappe ",
  "tha-ap266:3.2": "eko āsiṃ mahīpati, ",
  "tha-ap266:3.3": "samantacakkhu nāmena ",
  "tha-ap266:3.4": "cakkavattī mahabbalo. ",
  "tha-ap266:4.1": "paṭisambhidā catasso ",
  "tha-ap266:4.2": "vimokkhāpi ca aṭṭhime, chaḷabhiññā sacchikatā ",
  "tha-ap266:4.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap266:5.1": "itthaṃ sudaṃ āyasmā padīpiyo thero imā gāthāyo abhāsitthāti. ",
  "tha-ap266:6.1": "padīpiyattherassa apadānaṃ catutthaṃ. "
}
