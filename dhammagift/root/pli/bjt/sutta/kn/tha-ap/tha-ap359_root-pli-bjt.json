{
  "tha-ap359:0.1": "",
  "tha-ap359:0.2": "",
  "tha-ap359:0.3": "357. supuṭakapūjakattherāpadānaṃ ",
  "tha-ap359:1.1": "divāvihārā nikkhanto ",
  "tha-ap359:1.2": "vipassī lokanāyako, ",
  "tha-ap359:1.3": "bhikkhāya vicaranto so ",
  "tha-ap359:1.4": "mama santikamupāgami. ",
  "tha-ap359:2.1": "kato patīto sumano ",
  "tha-ap359:2.2": "buddhaseṭṭhassa tādino, ",
  "tha-ap359:2.3": "loṇasupuṭakaṃ datvā ",
  "tha-ap359:2.4": "kappaṃ saggamhi modahaṃ. ",
  "tha-ap359:3.1": "ekanavute ito kappe ",
  "tha-ap359:3.2": "yaṃ supuṭakamadāsahaṃ, ",
  "tha-ap359:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap359:3.4": "puṭakassa idaṃ phalaṃ. ",
  "tha-ap359:4.1": "paṭisambhidā catasso ",
  "tha-ap359:4.2": "vimokkhāpi ca aṭṭhime, chaḷabhiññā sacchikatā ",
  "tha-ap359:4.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap359:5.1": "itthaṃ sudaṃ āyasmā supuṭakapūjako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap359:6.1": "supuṭakapūjakattherassa apadānaṃ sattamaṃ. "
}
