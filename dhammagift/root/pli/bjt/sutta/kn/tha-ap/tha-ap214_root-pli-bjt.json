{
  "tha-ap214:0.1": "",
  "tha-ap214:0.2": "",
  "tha-ap214:0.3": "212. pānadhidāyakattherāpadānaṃ ",
  "tha-ap214:1.1": "āraññakassa isino ",
  "tha-ap214:1.2": "cirarattatapassino, ",
  "tha-ap214:1.3": "vuddhassa bhāvitattassa ",
  "tha-ap214:1.4": "adāsiṃ pānadhiṃ ahaṃ. ",
  "tha-ap214:2.1": "tena kammena dipadinda ",
  "tha-ap214:2.2": "lokajeṭṭha narāsabha, ",
  "tha-ap214:2.3": "sabbaṃ yānaṃ anubhomi ",
  "tha-ap214:2.4": "pubbakammassidaṃ phalaṃ. ",
  "tha-ap214:3.1": "catunavute ito kappe ",
  "tha-ap214:3.2": "yaṃ kammamakariṃ tadā, ",
  "tha-ap214:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap214:3.4": "pānadhissa idaṃ phalaṃ. ",
  "tha-ap214:4.1": "sattasattati’to kappe ",
  "tha-ap214:4.2": "aṭṭha āsiṃsu khattiyā, ",
  "tha-ap214:4.3": "suyānā nāma nāmena ",
  "tha-ap214:4.4": "cakkavattī mahabbalā. ",
  "tha-ap214:5.1": "paṭisambhidā catasso ",
  "tha-ap214:5.2": "vimokkhāpi ca aṭṭhime, chaḷabhiññā sacchikatā ",
  "tha-ap214:5.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap214:6.1": "itthaṃ sudaṃ āyasmā pānadhidāyako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap214:7.1": "pānadhidāyakattherassa apadānaṃ dutiyaṃ. "
}
