{
  "tha-ap326:0.1": "",
  "tha-ap326:0.2": "",
  "tha-ap326:0.3": "324. yaññasāmikattherāpadānaṃ. ",
  "tha-ap326:1.1": "jātiyā sattavassohaṃ ",
  "tha-ap326:1.2": "ahosiṃ mantapāragū, ",
  "tha-ap326:1.3": "kulavaṃsaṃ adhāresiṃ ",
  "tha-ap326:1.4": "yañño ussāhito mayā. ",
  "tha-ap326:2.1": "cullāsītisahassāni ",
  "tha-ap326:2.2": "pasū haññanti me tadā, ",
  "tha-ap326:2.3": "sārathambhupanītāni ",
  "tha-ap326:2.4": "yaññatthāya upaṭṭhitā. ",
  "tha-ap326:3.1": "ukkāmukhapahaṭṭhova ",
  "tha-ap326:3.2": "khadiraṅgārasannibho, ",
  "tha-ap326:3.3": "udayantova suriyo ",
  "tha-ap326:3.4": "puṇṇamāseva candimā. ",
  "tha-ap326:4.1": "siddhattho sabbasiddhattho ",
  "tha-ap326:4.2": "tilokamabhito hito, ",
  "tha-ap326:4.3": "upagantvāna sambuddho ",
  "tha-ap326:4.4": "idaṃ vacanamabravi- ",
  "tha-ap326:5.1": "“ahiṃsā sabbapāṇānaṃ ",
  "tha-ap326:5.2": "kumāra mama ruccati, ",
  "tha-ap326:5.3": "theyyā ca aticārā ca ",
  "tha-ap326:5.4": "majjapānā ca ārati. ",
  "tha-ap326:6.1": "rati ca samacariyāya ",
  "tha-ap326:6.2": "bāhusaccaṃ kataññutā, ",
  "tha-ap326:6.3": "diṭṭhe dhamme parattha ca ete ",
  "tha-ap326:6.4": "dhammā pasaṃsiyā. ",
  "tha-ap326:7.1": "ete dhamme bhāvayitvā ",
  "tha-ap326:7.2": "sabbasattahite rato, ",
  "tha-ap326:7.3": "buddhe cittaṃ pasādetvā ",
  "tha-ap326:7.4": "bhāvehi maggamuttamaṃ”. ",
  "tha-ap326:8.1": "idaṃ vatvāna sabbaññū ",
  "tha-ap326:8.2": "lokajeṭṭho narāsabho, ",
  "tha-ap326:8.3": "mamevamanusāsitvā ",
  "tha-ap326:8.4": "vehāsamuggato gato. ",
  "tha-ap326:9.1": "pubbe cittaṃ visodhetvā ",
  "tha-ap326:9.2": "pacchā cittaṃ pasādayiṃ, ",
  "tha-ap326:9.3": "tena cittappasādena ",
  "tha-ap326:9.4": "tusitaṃ upapajjahaṃ. ",
  "tha-ap326:10.1": "catunavute ito kappe ",
  "tha-ap326:10.2": "yadā cittaṃ pasādayiṃ, ",
  "tha-ap326:10.3": "duggatiṃ nābhijānāmi ",
  "tha-ap326:10.4": "buddhasaññāyidaṃ phalaṃ. ",
  "tha-ap326:11.1": "paṭisambhidā catasso ",
  "tha-ap326:11.2": "vimokkhāpi ca aṭṭhime, chaḷabhiññā sacchikatā ",
  "tha-ap326:11.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap326:12.1": "itthaṃ sudaṃ āyasmā yaññasāmiko thero imā gāthāyo abhāsitthāti. ",
  "tha-ap326:13.1": "yaññasāmikattherassa apadānaṃ catutthaṃ. "
}
