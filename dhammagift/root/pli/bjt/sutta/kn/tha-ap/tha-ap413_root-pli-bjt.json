{
  "tha-ap413:0.1": "",
  "tha-ap413:0.2": "42. bhaddālivaggo ",
  "tha-ap413:0.3": "411. bhaddālittherāpadānaṃ ",
  "tha-ap413:1.1": "sumedho nāma sambuddho ",
  "tha-ap413:1.2": "aggo kāruṇiko muni, ",
  "tha-ap413:1.3": "vivekakāmo lokaggo ",
  "tha-ap413:1.4": "himavantamupāgami. ",
  "tha-ap413:2.1": "ajjhogahetvā himavaṃ ",
  "tha-ap413:2.2": "sumedho lokanāyako, ",
  "tha-ap413:2.3": "pallaṅkamābhūjitvāna ",
  "tha-ap413:2.4": "nisīdi purisuttamo. ",
  "tha-ap413:3.1": "samādhiṃ so samāpanno ",
  "tha-ap413:3.2": "sumedho lokanāyako, ",
  "tha-ap413:3.3": "sattarattindivaṃ buddho ",
  "tha-ap413:3.4": "nisīdi purisuttamo. ",
  "tha-ap413:4.1": "khārikājaṃ gahetvāna ",
  "tha-ap413:4.2": "vanamajjhogahiṃ ahaṃ, ",
  "tha-ap413:4.3": "tatthaddasāsiṃ sambuddhaṃ ",
  "tha-ap413:4.4": "oghatiṇṇamanāsavaṃ. ",
  "tha-ap413:5.1": "sammajjaniṃ gahetvāna ",
  "tha-ap413:5.2": "sammajjitvāna assamaṃ, ",
  "tha-ap413:5.3": "catudaṇḍe thambhitvāna ",
  "tha-ap413:5.4": "akāsiṃ maṇḍapaṃ tadā. ",
  "tha-ap413:6.1": "sālapupphaṃ āharitvā ",
  "tha-ap413:6.2": "maṇḍapaṃ chādayiṃ ahaṃ, ",
  "tha-ap413:6.3": "pasannacitto sumano ",
  "tha-ap413:6.4": "abhivandiṃ tathāgataṃ. ",
  "tha-ap413:7.1": "yaṃ vadanti sumedhoti ",
  "tha-ap413:7.2": "bhūripaññaṃ sumedhasaṃ, ",
  "tha-ap413:7.3": "bhikkhusaṅghe nisīditvā ",
  "tha-ap413:7.4": "imā gāthā abhāsatha. ",
  "tha-ap413:8.1": "buddhassa giramaññāya ",
  "tha-ap413:8.2": "sabbe devā samāgamuṃ, ",
  "tha-ap413:8.3": "asaṃsayaṃ buddhaseṭṭho ",
  "tha-ap413:8.4": "dhammaṃ deseti cakkhumā. ",
  "tha-ap413:9.1": "sumedho nāma sambuddho ",
  "tha-ap413:9.2": "āhutīnaṃ paṭiggaho, ",
  "tha-ap413:9.3": "devasaṅghe nisīditvā ",
  "tha-ap413:9.4": "imā gāthā abhāsatha. ",
  "tha-ap413:10.1": "“yo me sattāhaṃ maṇḍapaṃ ",
  "tha-ap413:10.2": "dhārayī sālachāditaṃ, ",
  "tha-ap413:10.3": "tamahaṃ kittayissāmi ",
  "tha-ap413:10.4": "suṇātha mama bhāsato. ",
  "tha-ap413:11.1": "devabhūto manusso vā ",
  "tha-ap413:11.2": "hemavaṇṇo bhavissati, ",
  "tha-ap413:11.3": "pahūtabhogo hutvāna ",
  "tha-ap413:11.4": "kāmabhogī bhavissati. ",
  "tha-ap413:12.1": "saṭṭhināgasahassāni sabbālaṅkāra ",
  "tha-ap413:12.2": "bhūsitā, ",
  "tha-ap413:12.3": "suvaṇṇakacchā mātaṅgā ",
  "tha-ap413:12.4": "hemakappanavāsasā. ",
  "tha-ap413:13.1": "ārūḷhā gāmaṇīyehi ",
  "tha-ap413:13.2": "tomaraṅkusapāṇibhi, ",
  "tha-ap413:13.3": "sāyaṃpāto upaṭṭhānaṃ ",
  "tha-ap413:13.4": "āgamissanti’maṃ naraṃ, ",
  "tha-ap413:13.5": "tehi nāgehi parivuto ",
  "tha-ap413:13.6": "ramissati ayaṃ naro. ",
  "tha-ap413:14.1": "saṭṭhiassasahassāni ",
  "tha-ap413:14.2": "sabbālaṅkārabhūsitā, ",
  "tha-ap413:14.3": "ājānīyā va jāniyā ",
  "tha-ap413:14.4": "sindhavā sīghavāhino. ",
  "tha-ap413:15.1": "ārūḷhā gāmaṇīyehi ",
  "tha-ap413:15.2": "illiyācāpadhārihi, ",
  "tha-ap413:15.3": "parivāressantimaṃ niccaṃ ",
  "tha-ap413:15.4": "buddhapūjāyidaṃ phalaṃ. ",
  "tha-ap413:16.1": "saṭṭhirathasahassāni ",
  "tha-ap413:16.2": "sabbālaṅkārabhūsitā, ",
  "tha-ap413:16.3": "dīpā athopi veyyagghā ",
  "tha-ap413:16.4": "sannaddhā ussitaddhajā. ",
  "tha-ap413:17.1": "ārūḷhā gāmaṇīyehi ",
  "tha-ap413:17.2": "cāpahatthehi vammihi, ",
  "tha-ap413:17.3": "parivāressantimaṃ niccaṃ ",
  "tha-ap413:17.4": "buddhapūjāyidaṃ phalaṃ. ",
  "tha-ap413:18.1": "saṭṭhigāmasahassāni ",
  "tha-ap413:18.2": "paripuṇṇāni sabbaso, ",
  "tha-ap413:18.3": "pahūtadhanadhaññāni ",
  "tha-ap413:18.4": "susamiddhāni sabbaso, ",
  "tha-ap413:18.5": "sadā pātubhavissanti ",
  "tha-ap413:18.6": "buddhapūjāyidaṃ phalaṃ. ",
  "tha-ap413:19.1": "hatthi assā rathā pattī ",
  "tha-ap413:19.2": "senā ca caturaṅginī, ",
  "tha-ap413:19.3": "parivāressantimaṃ niccaṃ ",
  "tha-ap413:19.4": "buddhapūjāyidaṃ phalaṃ. ",
  "tha-ap413:20.1": "aṭṭhārase kappasate ",
  "tha-ap413:20.2": "devaloke ramissati, ",
  "tha-ap413:20.3": "sahassakkhattuṃ rājā ca ",
  "tha-ap413:20.4": "cakkavattī bhavissati. ",
  "tha-ap413:21.1": "satānaṃ tīṇikkhattuñca ",
  "tha-ap413:21.2": "devarajjaṃ karissati, ",
  "tha-ap413:21.3": "padesarajjaṃ vipulaṃ ",
  "tha-ap413:21.4": "gaṇanāto asaṅkhiyaṃ. ",
  "tha-ap413:22.1": "tiṃsakappasahassamhi ",
  "tha-ap413:22.2": "okkākakulasambhavo, ",
  "tha-ap413:22.3": "gotamo nāma nāmena ",
  "tha-ap413:22.4": "satthā loke bhavissati. ",
  "tha-ap413:23.1": "tassa dhammesu dāyādo ",
  "tha-ap413:23.2": "oraso dhammanimmito, ",
  "tha-ap413:23.3": "sabbāsave pariññāya ",
  "tha-ap413:23.4": "viharissatanāsavo” ",
  "tha-ap413:24.1": "tiṃsakappasahassamhi ",
  "tha-ap413:24.2": "addasaṃ lokanāyakaṃ, ",
  "tha-ap413:24.3": "etthantaramupādāya ",
  "tha-ap413:24.4": "gavesiṃ amataṃ padaṃ. ",
  "tha-ap413:25.1": "lābhā mayhaṃ suladdhaṃ me ",
  "tha-ap413:25.2": "yamahaññāsi sāsanaṃ, ",
  "tha-ap413:25.3": "tisso vijjā anuppattā ",
  "tha-ap413:25.4": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap413:26.1": "namo te purisājañña ",
  "tha-ap413:26.2": "namo te purisuttama, ",
  "tha-ap413:26.3": "tava ñāṇaṃ pakittetvā ",
  "tha-ap413:26.4": "pattomhi acalaṃ padaṃ. ",
  "tha-ap413:27.1": "yaṃ yaṃ yonupapajjāmi ",
  "tha-ap413:27.2": "devattaṃ atha mānusaṃ, ",
  "tha-ap413:27.3": "sabbattha sukhito homi ",
  "tha-ap413:27.4": "phalaṃ me ñāṇakittane, ",
  "tha-ap413:28.1": "idaṃ pacchimakaṃ mayhaṃ ",
  "tha-ap413:28.2": "carimo vattate bhavo, ",
  "tha-ap413:28.3": "nāgova bandhanaṃ chetvā ",
  "tha-ap413:28.4": "viharāmi anāsavo. ",
  "tha-ap413:29.1": "kilesā jhāpitā mayhaṃ ",
  "tha-ap413:29.2": "bhavā sabbe samūhatā, ",
  "tha-ap413:29.3": "nāgova bandhanaṃ chetvā ",
  "tha-ap413:29.4": "viharāmi anāsavo. ",
  "tha-ap413:30.1": "svāgataṃ vana me āsi ",
  "tha-ap413:30.2": "buddhaseṭṭhassa santike, ",
  "tha-ap413:30.3": "tisso vijjā anuppattā ",
  "tha-ap413:30.4": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap413:31.1": "paṭisambhidā catasso ",
  "tha-ap413:31.2": "vimokkhāpi ca aṭṭhime, ",
  "tha-ap413:31.3": "chaḷabhiññā sacchikatā ",
  "tha-ap413:31.4": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap413:32.1": "itthaṃ sudaṃ āyasmā bhaddāli thero imā gāthāyo abhāsitthāti. ",
  "tha-ap413:33.1": "bhaddālittherassa apadānaṃ paṭhamaṃ. "
}
