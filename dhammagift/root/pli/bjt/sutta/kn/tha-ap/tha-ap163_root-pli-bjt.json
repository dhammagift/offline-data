{
  "tha-ap163:0.1": "",
  "tha-ap163:0.2": "17. supāricariyavaggo ",
  "tha-ap163:0.3": "161. supāricariyattherāpadānaṃ. ",
  "tha-ap163:1.1": "padumo nāma nāmena ",
  "tha-ap163:1.2": "dipadindo narāsabho, ",
  "tha-ap163:1.3": "pavanā abhinikkhamma ",
  "tha-ap163:1.4": "dhammaṃ desesi cakkhumā. ",
  "tha-ap163:2.1": "yakkhānaṃ samayo āsi ",
  "tha-ap163:2.2": "avidūre mahesino, ",
  "tha-ap163:2.3": "yena kiccena sampattā ",
  "tha-ap163:2.4": "ajjhāpekkhiṃsu tāvade. ",
  "tha-ap163:3.1": "buddhassa giramaññāya ",
  "tha-ap163:3.2": "amatassa ca desanaṃ, ",
  "tha-ap163:3.3": "pasannacitto sumano ",
  "tha-ap163:3.4": "apphoṭhetvā upaṭṭhahiṃ. ",
  "tha-ap163:4.1": "suciṇṇassa phalaṃ passa ",
  "tha-ap163:4.2": "upaṭṭhānassa satthuno, ",
  "tha-ap163:4.3": "tiṃsakappasahassesu ",
  "tha-ap163:4.4": "duggatiṃ nupapajjahaṃ. ",
  "tha-ap163:5.1": "ūnatiṃse kappasate ",
  "tha-ap163:5.2": "samalaṅkatanāmako, ",
  "tha-ap163:5.3": "sattaratanasampanno ",
  "tha-ap163:5.4": "cakkavattī mahabbalo. ",
  "tha-ap163:6.1": "paṭisambhidā catasso ",
  "tha-ap163:6.2": "vimokkhāpi ca aṭṭhime, ",
  "tha-ap163:6.3": "chaḷabhiññā sacchikatā ",
  "tha-ap163:6.4": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap163:7.1": "itthaṃ sudaṃ āyasmā supāricariyo thero imā gāthāyo abhāsitthāti. ",
  "tha-ap163:8.1": "supāricariyattherassa apadānaṃ paṭhamaṃ. "
}
