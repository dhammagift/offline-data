{
  "tha-ap438:0.1": "",
  "tha-ap438:0.2": "",
  "tha-ap438:0.3": "436 kalambadāyakattherāpadānaṃ ",
  "tha-ap438:1.1": "romaso nāma sambuddho ",
  "tha-ap438:1.2": "vasatī pabbatantare, ",
  "tha-ap438:1.3": "kalambaṃ tassa pādāsiṃ ",
  "tha-ap438:1.4": "pasanno sehi pāṇihi catunavute ",
  "tha-ap438:2.1": "ito kappe ",
  "tha-ap438:2.2": "yaṃ dānamadadiṃ tadā, ",
  "tha-ap438:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap438:2.4": "kalambassa idaṃ phalaṃ. ",
  "tha-ap438:3.1": "kilesā jhāpitā mayhaṃ ",
  "tha-ap438:3.2": "bhavā sabbe samūhatā, nāgo’va bandhanaṃ chetvā ",
  "tha-ap438:3.3": "viharāmi anāsavo. ",
  "tha-ap438:4.1": "svāgataṃ vata me āsi ",
  "tha-ap438:4.2": "buddhaseṭṭhassa santike, tisso vijjā anuppattā ",
  "tha-ap438:4.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap438:5.1": "paṭisambhidā catasso ",
  "tha-ap438:5.2": "ca vimokkhāpi ca aṭṭhime, chaḷabhiññā sacchikatā ",
  "tha-ap438:5.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap438:6.1": "itthaṃ sudaṃ āyasmā kalambadāyako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap438:7.1": "kalambakattherassa apadānaṃ chaṭṭhaṃ. "
}
