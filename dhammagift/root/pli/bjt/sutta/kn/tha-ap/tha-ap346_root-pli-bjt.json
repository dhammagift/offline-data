  "tha-ap346:0.1": "",
  "tha-ap346:0.2": "",
  "tha-ap346:0.3": "344. tikiṅkiṇipūjakattherāpadānaṃ. ",
  "tha-ap346:1.1": "himavantassāvidūre ",
  "tha-ap346:1.2": "bhūtagaṇo nāma pabbato, ",
  "tha-ap346:1.3": "tatthaddasaṃ paṃsukūlaṃ ",
  "tha-ap346:1.4": "dumaggamhi vilaggitaṃ. ",
  "tha-ap346:2.1": "tīṇi kiṅkiṇipupphāni ocinitvā ",
  "tha-ap346:2.2": "ahaṃ tadā, ",
  "tha-ap346:2.3": "haṭṭho haṭṭhena cittena ",
  "tha-ap346:2.4": "paṃsukūlamapūjayiṃ. ekatiṃse ",
  "tha-ap346:3.1": "ito kappe ",
  "tha-ap346:3.2": "yaṃ kammamakariṃ tadā, ",
  "tha-ap346:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap346:3.4": "tiṇṇaṃ pupphānidaṃ phalaṃ. ",
  "tha-ap346:4.1": "paṭisambhidā catasso ",
  "tha-ap346:4.2": "vimokkhāpi ca aṭṭhime, chaḷabhiññā sacchikatā ",
  "tha-ap346:4.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap346:5.1": "itthaṃ sudaṃ āyasmā tikiṅkiṇipūjako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap346:6.1": "tikiṅkiṇipūjakattherassa apadānaṃ catutthaṃ. "
}
