{
  "tha-ap380:0.1": "",
  "tha-ap380:0.2": "",
  "tha-ap380:0.3": "378. sumanatālavaṇṭiyattherāpadānaṃ. ",
  "tha-ap380:1.1": "siddhatthassa bhagavato ",
  "tha-ap380:1.2": "tālavaṇṭamadāsahaṃ, ",
  "tha-ap380:1.3": "sumanehi paṭicchannaṃ ",
  "tha-ap380:1.4": "dhārayāmi mahārahaṃ. ",
  "tha-ap380:2.1": "catunavute ito kappe ",
  "tha-ap380:2.2": "tālavaṇṭamadāsahaṃ, ",
  "tha-ap380:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap380:2.4": "tālavaṇṭassidaṃ phalaṃ. ",
  "tha-ap380:3.1": "",
  "tha-ap380:3.2": "",
  "tha-ap380:3.3": "",
  "tha-ap380:4.1": "svāgataṃ vata me āsi ",
  "tha-ap380:4.2": "buddhaseṭṭhassa santike, tisso vijjā anuppattā ",
  "tha-ap380:4.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap380:5.1": "kilesā jhāpitā mayhaṃ bhavā sabbe samūhatā, nāgova bandhanaṃ chetvā viharāmi anāsavo. paṭisambhidā catasso ",
  "tha-ap380:5.2": "vimokkhāpi ca aṭṭhime, chaḷabhiññā sacchikatā ",
  "tha-ap380:5.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap380:6.1": "itthaṃ sudaṃ āyasmā sumanatālavaṇṭiyo thero imā gāthāyo abhāsitthāti. ",
  "tha-ap380:7.1": "sumanatālavaṇṭiyattherassa apadānaṃ aṭṭhamaṃ. "
}
