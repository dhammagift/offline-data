{
  "tha-ap447:0.1": "",
  "tha-ap447:0.2": "",
  "tha-ap447:0.3": "445. uttalipupphiyattherāpadānaṃ ",
  "tha-ap447:1.1": "nigrodhe haritohāse ",
  "tha-ap447:1.2": "saṃvirūḷhamhi pādape, ",
  "tha-ap447:1.3": "uttalimālaṃ paggayha ",
  "tha-ap447:1.4": "bodhiyā abhiropayiṃ. ",
  "tha-ap447:2.1": "imasmiṃ yeva kappamhi ",
  "tha-ap447:2.2": "yaṃ pupphamabhiropayiṃ, ",
  "tha-ap447:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap447:2.4": "bodhipūjāyidaṃ phalaṃ. ",
  "tha-ap447:3.1": "kilesā jhāpitā mayhaṃ ",
  "tha-ap447:3.2": "bhavā sabbe samūhatā, nāgova bandhanaṃ chetvā ",
  "tha-ap447:3.3": "viharāmi anāsavo. ",
  "tha-ap447:4.1": "svāgataṃ vata me āsi ",
  "tha-ap447:4.2": "buddhaseṭṭhassa santike, tisso vijjā anuppattā ",
  "tha-ap447:4.3": "kataṃ buddhassa sāsanaṃ ",
  "tha-ap447:5.1": "paṭisambhidā catasso ",
  "tha-ap447:5.2": "ca vimokkhāpi ca aṭṭhime, chaḷabhiññā sacchikatā ",
  "tha-ap447:5.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap447:6.1": "itthaṃ sudaṃ āyasmā uttalipupphiyo thero imā gāthāyo abhāsitthāti. ",
  "tha-ap447:7.1": "uttalipupphiyattherassa apadānaṃ pañcamaṃ. "
}
