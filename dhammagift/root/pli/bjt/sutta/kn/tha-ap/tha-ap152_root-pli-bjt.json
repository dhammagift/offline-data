{
  "tha-ap152:0.1": "",
  "tha-ap152:0.2": "",
  "tha-ap152:0.3": "150. pallaṅkadāyakattherāpadānaṃ ",
  "tha-ap152:1.1": "sumedhassa bhagavato ",
  "tha-ap152:1.2": "lokajeṭṭhassa tādino, ",
  "tha-ap152:1.3": "pallaṅko hi mayā dinno ",
  "tha-ap152:1.4": "sauttara sapacchado. ",
  "tha-ap152:2.1": "sattaratanasampanno ",
  "tha-ap152:2.2": "pallaṅko āsi so tadā, ",
  "tha-ap152:2.3": "mama saṅkappamaññāya ",
  "tha-ap152:2.4": "nibbattati sadā mama. ",
  "tha-ap152:3.1": "tiṃsakappasahassamhi ",
  "tha-ap152:3.2": "pallaṅkamadadiṃ tadā, ",
  "tha-ap152:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap152:3.4": "pallaṅkassa idaṃ phalaṃ. ",
  "tha-ap152:4.1": "vīsakappasahassamhi ",
  "tha-ap152:4.2": "suvaṇṇābhā tayo janā, ",
  "tha-ap152:4.3": "sattaratanasampannā ",
  "tha-ap152:4.4": "cakkavattī mahabbalā. ",
  "tha-ap152:5.1": "paṭisambhidā ",
  "tha-ap152:5.2": "…pe… ",
  "tha-ap152:5.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap152:6.1": "itthaṃ sudaṃ āyasmā pallaṅkadāyako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap152:7.1": "pallaṅkadāyakattherassa apadānaṃ dasamaṃ. ",
  "tha-ap152:8.1": "uddānaṃ: ",
  "tha-ap152:9.1": "",
  "tha-ap152:10.1": "chattaṃ thambho ca vedi ca ",
  "tha-ap152:10.2": "parivārummapupphiyo ",
  "tha-ap152:10.3": "anulepo maggadāyī phalakadāyī ",
  "tha-ap152:10.4": "vaṭaṃsako ",
  "tha-ap152:10.5": "pallaṅkadāyī gāthāyo ",
  "tha-ap152:10.6": "chapaññāsa pakittitā. chattavaggo paṇṇarasamo. "
}
