{
  "tha-ap385:0.1": "",
  "tha-ap385:0.2": "",
  "tha-ap385:0.3": "383. udumbaraphaladāyakattherāpadānaṃ ",
  "tha-ap385:1.1": "vintānadiyā tīre ",
  "tha-ap385:1.2": "vihāsi purisuttamo, ",
  "tha-ap385:1.3": "addasaṃ virajaṃ buddhaṃ ",
  "tha-ap385:1.4": "ekaggaṃ susamāhitaṃ. ",
  "tha-ap385:2.1": "tasmiṃ pasannamanaso ",
  "tha-ap385:2.2": "kilesamaladhovane, ",
  "tha-ap385:2.3": "udumbaraphalaṃ gayha ",
  "tha-ap385:2.4": "buddhaseṭṭhassadāsahaṃ. ",
  "tha-ap385:3.1": "ekanavute ito kappe ",
  "tha-ap385:3.2": "yaṃ phalamadadiṃ tadā, ",
  "tha-ap385:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap385:3.4": "phaladānassidaṃ phalaṃ. ",
  "tha-ap385:4.1": "",
  "tha-ap385:4.2": "",
  "tha-ap385:4.3": "",
  "tha-ap385:5.1": "svāgataṃ vata me āsi ",
  "tha-ap385:5.2": "buddhaseṭṭhassa santike, tisso vijjā anuppattā ",
  "tha-ap385:5.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap385:6.1": "kilesā jhāpitā mayhaṃ bhavā sabbe samūhatā, nāgova bandhanaṃ chetvā viharāmi anāsavo. paṭisambhidā catasso ",
  "tha-ap385:6.2": "vimokkhāpi ca aṭṭhime, chaḷabhiññā sacchikatā ",
  "tha-ap385:6.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap385:7.1": "itthaṃ sudaṃ āyasmā udumbaraphaladāyako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap385:8.1": "udumbaraphaladāyakattherassa apadānaṃ tatiyaṃ. "
}
