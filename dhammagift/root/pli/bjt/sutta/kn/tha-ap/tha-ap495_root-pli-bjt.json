{
  "tha-ap495:0.1": "",
  "tha-ap495:0.2": "",
  "tha-ap495:0.3": "493. koraṇḍapupphiyattherāpadānaṃ ",
  "tha-ap495:1.1": "vanakammiko pure āsiṃ ",
  "tha-ap495:1.2": "pitupitāmahenahaṃ, ",
  "tha-ap495:1.3": "pasumārena jīvāmi ",
  "tha-ap495:1.4": "kusalaṃ me na vijjati. ",
  "tha-ap495:2.1": "mama āsayasāmantā ",
  "tha-ap495:2.2": "tisso lokagganāyako, tīṇi ",
  "tha-ap495:2.3": "padāni dassesi ",
  "tha-ap495:2.4": "anukampāya cakkhumā. ",
  "tha-ap495:3.1": "akkante ca pade disvā ",
  "tha-ap495:3.2": "tissanāmassa satthuno, ",
  "tha-ap495:3.3": "haṭṭho haṭṭhena cittena ",
  "tha-ap495:3.4": "pāde cittaṃ pasādayiṃ. ",
  "tha-ap495:4.1": "koraṇḍaṃ pupphitaṃ disvā ",
  "tha-ap495:4.2": "pādapaṃ dharaṇīruhaṃ, ",
  "tha-ap495:4.3": "sakosakaṃ gahetvāna ",
  "tha-ap495:4.4": "padaseṭṭhamapūjayiṃ. ",
  "tha-ap495:5.1": "tena kammena sukatena ",
  "tha-ap495:5.2": "cetanāpaṇidhīhi ca, ",
  "tha-ap495:5.3": "jahitvā mānusaṃ dehaṃ ",
  "tha-ap495:5.4": "tāvatiṃsamagacchahaṃ. ",
  "tha-ap495:6.1": "yaṃ yaṃ yonupapajjāmi ",
  "tha-ap495:6.2": "devattaṃ atha mānusaṃ, ",
  "tha-ap495:6.3": "koraṇḍakacchavī homi ",
  "tha-ap495:6.4": "passabhāso bhavāmahaṃ. ",
  "tha-ap495:7.1": "dvenavute ito kappe ",
  "tha-ap495:7.2": "yaṃ kammamakariṃ tadā, ",
  "tha-ap495:7.3": "duggatiṃ nābhijānāmi ",
  "tha-ap495:7.4": "padapūjāyidaṃ phalaṃ. ",
  "tha-ap495:8.1": "kilesā jhāpitā mayhaṃ ",
  "tha-ap495:8.2": "bhavā sabbe samūhatā, nāgo’va bandhanaṃ chetvā ",
  "tha-ap495:8.3": "viharāmi anāsavo. ",
  "tha-ap495:9.1": "svāgataṃ vata me āsi ",
  "tha-ap495:9.2": "buddhaseṭṭhassa santike, tisso vijjā anuppattā ",
  "tha-ap495:9.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap495:10.1": "paṭisambhidā catasso ",
  "tha-ap495:10.2": "ca vimokkhāpi ca aṭṭhime, chaḷabhiññā sacchikatā ",
  "tha-ap495:10.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap495:11.1": "itthaṃ sudaṃ āyasmā koraṇḍapupphiyo thero imā gāthāyo abhāsitthāti. ",
  "tha-ap495:12.1": "koraṇḍapupphiyattherassa apadānaṃ tatiyaṃ. "
}
