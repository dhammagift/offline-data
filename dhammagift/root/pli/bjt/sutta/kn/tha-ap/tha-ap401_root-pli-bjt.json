{
  "tha-ap401:0.1": "",
  "tha-ap401:0.2": "",
  "tha-ap401:0.3": "399. sabbadāyakattherāpadānaṃ. ",
  "tha-ap401:1.1": "mahāsamuddaṃ ogayha ",
  "tha-ap401:1.2": "bhavanaṃ me sunimmitaṃ, ",
  "tha-ap401:1.3": "sunimmitā pokkharaṇī ",
  "tha-ap401:1.4": "cakkavākūpakūjitā. ",
  "tha-ap401:2.1": "mandālakehi sañchannā ",
  "tha-ap401:2.2": "padumuppalakehi ca, ",
  "tha-ap401:2.3": "nadī ca sandate tattha ",
  "tha-ap401:2.4": "supatitthā manoramā. ",
  "tha-ap401:3.1": "macchakacchapasañchannā ",
  "tha-ap401:3.2": "nānādijasamotthatā, ",
  "tha-ap401:3.3": "mayūrakoñcābhirudā ",
  "tha-ap401:3.4": "kokilādīhi vagguhi. ",
  "tha-ap401:4.1": "pārevatā ravihaṃsā ",
  "tha-ap401:4.2": "cakkavākā nadīcarā, ",
  "tha-ap401:4.3": "dindibhā sāḷikā cettha ",
  "tha-ap401:4.4": "pampakā jīvajīvakā. ",
  "tha-ap401:5.1": "haṃsā koñcābhinaditā ",
  "tha-ap401:5.2": "kosiyā piṅgalā bahū, ",
  "tha-ap401:5.3": "sattaratanasampanno ",
  "tha-ap401:5.4": "maṇimuttikavālukā. ",
  "tha-ap401:6.1": "sabbasoṇṇamayā rukkhā ",
  "tha-ap401:6.2": "nānāgandhasameritā, ",
  "tha-ap401:6.3": "ujjotenti divārattiṃ ",
  "tha-ap401:6.4": "bhavanaṃ sabbakālikaṃ. ",
  "tha-ap401:7.1": "saṭṭhituriyasahassāni ",
  "tha-ap401:7.2": "sāyaṃ pāto pavajjare, ",
  "tha-ap401:7.3": "soḷasitthisahassāni ",
  "tha-ap401:7.4": "parivārenti maṃ sadā. ",
  "tha-ap401:8.1": "abhinikkhamma bhavanā ",
  "tha-ap401:8.2": "sumedhaṃ lokanāyakaṃ, ",
  "tha-ap401:8.3": "pasannacitto sumano ",
  "tha-ap401:8.4": "vandayiṃ taṃ mahāyasaṃ. ",
  "tha-ap401:9.1": "sambuddhaṃ abhivādetvā ",
  "tha-ap401:9.2": "sasaṅghaṃ taṃ nimantayiṃ, ",
  "tha-ap401:9.3": "adhivāsesi so dhīro ",
  "tha-ap401:9.4": "sumedho lokanāyako. ",
  "tha-ap401:10.1": "mama dhammakathaṃ katvā ",
  "tha-ap401:10.2": "uyyojesi mahāmuni, ",
  "tha-ap401:10.3": "sambuddhaṃ abhivādetvā ",
  "tha-ap401:10.4": "bhavanaṃ me upāgamiṃ. ",
  "tha-ap401:11.1": "āmantayiṃ parijanaṃ ",
  "tha-ap401:11.2": "sabbe sannipatātha vo, ",
  "tha-ap401:11.3": "pubbanhasamayaṃ buddho ",
  "tha-ap401:11.4": "bhavanaṃ āgamissati. ",
  "tha-ap401:12.1": "lābhā amhaṃ suladdhaṃ no ",
  "tha-ap401:12.2": "ye vasāma tavantike, ",
  "tha-ap401:12.3": "mayampi buddhaseṭṭhassa ",
  "tha-ap401:12.4": "pūjaṃ kassāma satthuno. ",
  "tha-ap401:13.1": "annaṃ pānaṃ paṭṭhapetvā ",
  "tha-ap401:13.2": "kālamārocayiṃ ahaṃ, ",
  "tha-ap401:13.3": "vasīsatasahassehi ",
  "tha-ap401:13.4": "upesi lokanāyako. ",
  "tha-ap401:14.1": "pañcaṅgikehi turiyehi ",
  "tha-ap401:14.2": "paccuggamanamakāsahaṃ, ",
  "tha-ap401:14.3": "sabbasovaṇṇamaye pīṭhe ",
  "tha-ap401:14.4": "nisīdi purisuttamo. ",
  "tha-ap401:15.1": "uparicchadanaṃ āsi ",
  "tha-ap401:15.2": "sabbasoṇṇamayaṃ tadā, ",
  "tha-ap401:15.3": "vījaniyo pavāyanti ",
  "tha-ap401:15.4": "bhikkhusaṅghassa antare. ",
  "tha-ap401:16.1": "pahūtena’nnapānena ",
  "tha-ap401:16.2": "bhikkhusaṃghamatappayiṃ, ",
  "tha-ap401:16.3": "paccekadussayugale ",
  "tha-ap401:16.4": "bhikkhusaṅghassa’dāsahaṃ. ",
  "tha-ap401:17.1": "yaṃ vadanti sumedhoti ",
  "tha-ap401:17.2": "lokāhutipaṭiggahaṃ, ",
  "tha-ap401:17.3": "bhikkhusaṅghe nisīditvā ",
  "tha-ap401:17.4": "imā gāthā abhāsatha. ",
  "tha-ap401:18.1": "“yo maṃ annena pānena ",
  "tha-ap401:18.2": "sabbe ime ca tappayi, ",
  "tha-ap401:18.3": "tamahaṃ kittayissāmi ",
  "tha-ap401:18.4": "suṇātha mama bhāsato. ",
  "tha-ap401:19.1": "aṭṭhārase kappasate ",
  "tha-ap401:19.2": "devaloke ramissati, ",
  "tha-ap401:19.3": "sahassakkhattuṃ rājā ca ",
  "tha-ap401:19.4": "cakkavattī bhavissati. ",
  "tha-ap401:20.1": "upagacchati yaṃ yoniṃ ",
  "tha-ap401:20.2": "devattaṃ atha mānusaṃ, ",
  "tha-ap401:20.3": "sabbadā sabbasovaṇṇaṃ ",
  "tha-ap401:20.4": "chadanaṃ dhārayissati. ",
  "tha-ap401:21.1": "tiṃsakappasahassamhi ",
  "tha-ap401:21.2": "okkākakulasambhavo, ",
  "tha-ap401:21.3": "gotamo nāma nāmena ",
  "tha-ap401:21.4": "satthā loke bhavissati. ",
  "tha-ap401:22.1": "tassa dhammesu dāyādo ",
  "tha-ap401:22.2": "oraso dhammanimmito, ",
  "tha-ap401:22.3": "sabbāsave pariññāya ",
  "tha-ap401:22.4": "nibbāyissatanāsavo. ",
  "tha-ap401:23.1": "bhikkhusaṅghe nisīditvā ",
  "tha-ap401:23.2": "sīhanādaṃ nadissati ",
  "tha-ap401:23.3": "citake chattaṃ dhārenti ",
  "tha-ap401:23.4": "heṭṭhāchattambhi ḍayhatha. ",
  "tha-ap401:24.1": "sāmaññaṃ me anuppattaṃ ",
  "tha-ap401:24.2": "kilesā jhāpitā mayā, ",
  "tha-ap401:24.3": "maṇḍape rukkhamūle vā ",
  "tha-ap401:24.4": "santāpo me na vijjati. ",
  "tha-ap401:25.1": "tiṃsakappasahassamhi ",
  "tha-ap401:25.2": "yaṃ dānamadadiṃ tadā, ",
  "tha-ap401:25.3": "duggatiṃ nābhijānāmi ",
  "tha-ap401:25.4": "sabbadānassidaṃ phalaṃ. ",
  "tha-ap401:26.1": "kilesā jhāpitā mayhaṃ ",
  "tha-ap401:26.2": "bhavā sabbe samūhatā, sabbāsavā parikkhīṇā ",
  "tha-ap401:26.3": "viharāmi anāsavo. ",
  "tha-ap401:27.1": "svāgataṃ vata me āsi ",
  "tha-ap401:27.2": "buddhaseṭṭhassa santike, tisso vijjā anuppattā ",
  "tha-ap401:27.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap401:28.1": "paṭisambhidā catasso ",
  "tha-ap401:28.2": "vimokkhāpi ca aṭṭhime, chaḷabhiññā sacchikatā ",
  "tha-ap401:28.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap401:29.1": "itthaṃ sudaṃ āyasmā sabbadāyako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap401:30.1": "sabbadāyakattherassa apadānaṃ navamaṃ. "
}
