{
  "tha-ap372:0.1": "",
  "tha-ap372:0.2": "",
  "tha-ap372:0.3": "370. salalapupphiyattherāpadānaṃ. ",
  "tha-ap372:1.1": "candabhāgānadītīre ",
  "tha-ap372:1.2": "ahosiṃ kinnaro tadā, ",
  "tha-ap372:1.3": "tatthaddasaṃ devadevaṃ ",
  "tha-ap372:1.4": "caṅkamantaṃ narāsabhaṃ. ",
  "tha-ap372:2.1": "ocinitvāna salalaṃ ",
  "tha-ap372:2.2": "pupphaṃ buddhassa’dāsahaṃ, ",
  "tha-ap372:2.3": "upasiṅghi mahāvīro ",
  "tha-ap372:2.4": "salalaṃ devagandhikaṃ. ",
  "tha-ap372:3.1": "paṭiggahetvā sambuddho ",
  "tha-ap372:3.2": "vipassī lokanāyako, ",
  "tha-ap372:3.3": "upasiṅghi mahāvīro ",
  "tha-ap372:3.4": "pekkhamānassa me sato. ",
  "tha-ap372:4.1": "pasannacitto sumano ",
  "tha-ap372:4.2": "vanditvā dipaduttamaṃ, ",
  "tha-ap372:4.3": "añjalimpaggahetvāna ",
  "tha-ap372:4.4": "puna pabbatamāruhiṃ. ",
  "tha-ap372:5.1": "ekanavute ito kappe ",
  "tha-ap372:5.2": "yaṃ pupphamabhipūjayiṃ, ",
  "tha-ap372:5.3": "duggatiṃ nābhijānāmi ",
  "tha-ap372:5.4": "buddhapūjāyidaṃ phalaṃ. ",
  "tha-ap372:6.1": "paṭisambhidā catasso ",
  "tha-ap372:6.2": "vimokkhāpi ca aṭṭhime, chaḷabhiññā sacchikatā ",
  "tha-ap372:6.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap372:7.1": "itthaṃ sudaṃ āyasmā salalapupphiyo thero imā gāthāyo abhāsitthāti. ",
  "tha-ap372:8.1": "salalapupphiyattherassa apadānaṃ dasamaṃ. ",
  "tha-ap372:9.1": "uddānaṃ: ",
  "tha-ap372:10.1": "",
  "tha-ap372:11.1": "mandāravañca kakkāru ",
  "tha-ap372:11.2": "bhisa kesarapupphiyo ",
  "tha-ap372:11.3": "aṅkolako kadamabī ca ",
  "tha-ap372:11.4": "uddāla ekacampako ",
  "tha-ap372:11.5": "timiraṃ salalañceva ",
  "tha-ap372:11.6": "gāthā tāḷīsa eva ca. "
}
