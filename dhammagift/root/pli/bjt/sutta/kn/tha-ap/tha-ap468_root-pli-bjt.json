{
  "tha-ap468:0.1": "",
  "tha-ap468:0.2": "",
  "tha-ap468:0.3": "466. avaṇṭaphaliyattherāpadānaṃ ",
  "tha-ap468:1.1": "sataraṃsi nāma bhagavā ",
  "tha-ap468:1.2": "sayambhū aparājito, ",
  "tha-ap468:1.3": "vivekakāmo sambuddho ",
  "tha-ap468:1.4": "gocarāyābhinikkhami. ",
  "tha-ap468:2.1": "phalahattho ahaṃ disvā ",
  "tha-ap468:2.2": "upagacchiṃ narāsabhaṃ, ",
  "tha-ap468:2.3": "pasannacitto sumano ",
  "tha-ap468:2.4": "avaṇṭaṃ ",
  "tha-ap468:3.1": "",
  "tha-ap468:3.2": "adadiṃ phalaṃ. catunavute ito kappe yaṃ phalamadadiṃ tadā, ",
  "tha-ap468:3.3": "duggatiṃ nābhijānāmi ",
  "tha-ap468:3.4": "phaladānassidaṃ phalaṃ. ",
  "tha-ap468:4.1": "kilesā jhāpitā mayhaṃ ",
  "tha-ap468:4.2": "bhavā sabbe samūhatā, nāgo’va bandhanaṃ chetvā ",
  "tha-ap468:4.3": "viharāmi anāsavo. ",
  "tha-ap468:5.1": "svāgataṃ vata me āsi ",
  "tha-ap468:5.2": "buddhaseṭṭhassa santike, tisso vijjā anuppattā ",
  "tha-ap468:5.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap468:6.1": "paṭisambhidā catasso ",
  "tha-ap468:6.2": "ca vimokkhāpi ca aṭṭhime, chaḷabhiññā sacchikatā ",
  "tha-ap468:6.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap468:7.1": "itthaṃ sudaṃ āyasmā avaṇṭaphaliyo thero imā gāthāyo abhāsitthāti. ",
  "tha-ap468:8.1": "avaṇṭaphaliyattherāpadānaṃ chaṭṭhaṃ. "
}
