{
  "tha-ap378:0.1": "",
  "tha-ap378:0.2": "",
  "tha-ap378:0.3": "376. gandhamuṭṭhiyattherāpadānaṃ. ",
  "tha-ap378:1.1": "citake karīyamāne ",
  "tha-ap378:1.2": "nānāgandhe samāhaṭe, ",
  "tha-ap378:1.3": "pasannacitto sumano ",
  "tha-ap378:1.4": "gandhamuṭṭhimapūjayiṃ. ",
  "tha-ap378:2.1": "satasahasse ito kappe ",
  "tha-ap378:2.2": "citakaṃ yaṃ apūjayiṃ, ",
  "tha-ap378:2.3": "duggatiṃ nābhijānāmi ",
  "tha-ap378:2.4": "citapūjāyidaṃ phalaṃ. ",
  "tha-ap378:3.1": "",
  "tha-ap378:3.2": "",
  "tha-ap378:3.3": "",
  "tha-ap378:4.1": "svāgataṃ vata me āsi ",
  "tha-ap378:4.2": "buddhaseṭṭhassa santike, tisso vijjā anuppattā ",
  "tha-ap378:4.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap378:5.1": "kilesā jhāpitā mayhaṃ bhavā sabbe samūhatā, nāgova bandhanaṃ chetvā viharāmi anāsavo. paṭisambhidā catasso ",
  "tha-ap378:5.2": "vimokkhāpi ca aṭṭhime, chaḷabhiññā sacchikatā ",
  "tha-ap378:5.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap378:6.1": "itthaṃ sudaṃ āyasmā gandhamuṭṭhiyo thero imā gāthāyo abhāsitthāti. ",
  "tha-ap378:7.1": "gandhamuṭṭhiyattherassa apadānaṃ chaṭṭhaṃ. "
}
