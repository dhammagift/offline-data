{
  "tha-ap177:0.1": "",
  "tha-ap177:0.2": "",
  "tha-ap177:0.3": "175. sīhāsanadāyakattherāpadānaṃ. ",
  "tha-ap177:1.1": "nibbute lokanāthambhi ",
  "tha-ap177:1.2": "padumuttaranāyake, ",
  "tha-ap177:1.3": "pasannacitto sumano ",
  "tha-ap177:1.4": "sīhāsanamadāsahaṃ. ",
  "tha-ap177:2.1": "pahutagandhamālehi diṭṭhadhamme ",
  "tha-ap177:2.2": "sukhāvahe, ",
  "tha-ap177:2.3": "tattha pūjaṃ karitvāna ",
  "tha-ap177:2.4": "nibbāyati bahujjano. ",
  "tha-ap177:3.1": "pasannacitto sumano ",
  "tha-ap177:3.2": "vanditvā bodhimuttamaṃ, ",
  "tha-ap177:3.3": "kappānaṃ satasahassaṃ ",
  "tha-ap177:3.4": "duggatiṃ nūpapajjahaṃ. ",
  "tha-ap177:4.1": "paṇṇarasasahassamhi ",
  "tha-ap177:4.2": "kappānaṃ aṭṭha āsu te, ",
  "tha-ap177:4.3": "siluccaya sanāmā ca ",
  "tha-ap177:4.4": "rājāno cakkavattino. ",
  "tha-ap177:5.1": "paṭisambhidā catasso ",
  "tha-ap177:5.2": "vimokkhāpi ca aṭṭhime, chaḷabhiññā sacchikatā ",
  "tha-ap177:5.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap177:6.1": "itthaṃ sudaṃ āyasmā sīhāsanadāyako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap177:7.1": "sīhāsanadāyakattherassa apadānaṃ pañcamaṃ. "
}
