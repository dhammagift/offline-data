{
  "tha-ap17:0.1": "",
  "tha-ap17:0.2": "",
  "tha-ap17:0.3": "15. piḷindivacchattherāpadānaṃ ",
  "tha-ap17:1.1": "nibbute lokanāthamhi ",
  "tha-ap17:1.2": "sumedhe aggapuggale, ",
  "tha-ap17:1.3": "pasannacitto sumano ",
  "tha-ap17:1.4": "thūpapūjamakāsa’haṃ ",
  "tha-ap17:2.1": "ye ca khīṇāsavā tattha ",
  "tha-ap17:2.2": "chaḷabhiññā mahiddhikā, ",
  "tha-ap17:2.3": "te’haṃ tattha samānetvā ",
  "tha-ap17:2.4": "saṃghabhattaṃ akāsa’haṃ ",
  "tha-ap17:3.1": "sumedhassa bhagavato ",
  "tha-ap17:3.2": "upaṭṭhāko tadā ahu, ",
  "tha-ap17:3.3": "sumedho nāma nāmena ",
  "tha-ap17:3.4": "anumodittha so tadā. ",
  "tha-ap17:4.1": "tena cittappasādena ",
  "tha-ap17:4.2": "vimānaṃ upapajjahaṃ, ",
  "tha-ap17:4.3": "chāḷāsītisahassāni ",
  "tha-ap17:4.4": "accharāyo ramiṃsu me. ",
  "tha-ap17:5.1": "mameva anuvattanti ",
  "tha-ap17:5.2": "sabbakāmehi tā sadā, ",
  "tha-ap17:5.3": "aññe deve atibhomi ",
  "tha-ap17:5.4": "puññakammassi’daṃ phalaṃ. ",
  "tha-ap17:6.1": "pañcavīsatikappamhi ",
  "tha-ap17:6.2": "varuṇo nāma khattiyo, ",
  "tha-ap17:6.3": "susuddhabhojano āsiṃ ",
  "tha-ap17:6.4": "cakkavattī ahaṃ tadā. ",
  "tha-ap17:7.1": "na te bījaṃ pavapanti ",
  "tha-ap17:7.2": "na pi nīyanti naṅgalā, ",
  "tha-ap17:7.3": "akaṭṭhapākimaṃ sāliṃ ",
  "tha-ap17:7.4": "paribhuñjanti mānusā. ",
  "tha-ap17:8.1": "tattha rajjaṃ karitvāna ",
  "tha-ap17:8.2": "devattaṃ puna gaccha’haṃ, ",
  "tha-ap17:8.3": "tadāpi edisā mayhaṃ ",
  "tha-ap17:8.4": "nibbattā bhogasampadā. ",
  "tha-ap17:9.1": "na maṃ mittā amittā vā ",
  "tha-ap17:9.2": "hiṃsanti sabbapāṇino, ",
  "tha-ap17:9.3": "sabbesampi piyo homi ",
  "tha-ap17:9.4": "puññakammassi’daṃ phalaṃ. ",
  "tha-ap17:10.1": "tiṃsakappasahassambhi ",
  "tha-ap17:10.2": "yaṃ dānamadadiṃ tadā, ",
  "tha-ap17:10.3": "duggatiṃ nābhijānāmi ",
  "tha-ap17:10.4": "gandhālepassi’daṃ phalaṃ. ",
  "tha-ap17:11.1": "imasmiṃ bhaddake kappe ",
  "tha-ap17:11.2": "eko āsiṃ janādhipo, ",
  "tha-ap17:11.3": "mahānubhāvo rājā’haṃ ",
  "tha-ap17:11.4": "cakkavattī mahabbalo. ",
  "tha-ap17:12.1": "so’haṃ pañcasu sīlesu ",
  "tha-ap17:12.2": "ṭhapetvā janataṃ bahuṃ, ",
  "tha-ap17:12.3": "pāpetvā sugatiṃyeva ",
  "tha-ap17:12.4": "devatānaṃ piyo ahuṃ. ",
  "tha-ap17:13.1": "paṭisambhidā …pe… ",
  "tha-ap17:13.2": "",
  "tha-ap17:13.3": "",
  "tha-ap17:13.4": "kataṃ buddhassa sāsanaṃ, ",
  "tha-ap17:14.1": "itthaṃ sudaṃ āyasmā piḷindivaccho thero imā gāthāyo abhāsitthāti. ",
  "tha-ap17:15.1": "piḷindivacchattherassāpadānaṃ pañcamaṃ. "
}
