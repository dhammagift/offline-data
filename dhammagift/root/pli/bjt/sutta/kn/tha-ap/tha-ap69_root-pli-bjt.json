{
  "tha-ap69:0.1": "",
  "tha-ap69:0.2": "",
  "tha-ap69:0.3": "67. vatthadāyakattherāpadānaṃ ",
  "tha-ap69:1.1": "pakkhijāto tadā āsiṃ ",
  "tha-ap69:1.2": "suvaṇṇo garuḷādhipo, ",
  "tha-ap69:1.3": "addasaṃ virajaṃ buddhaṃ ",
  "tha-ap69:1.4": "gacchantaṃ gandhamādanaṃ. ",
  "tha-ap69:2.1": "jahitvā garuḷaṃ vaṇṇaṃ ",
  "tha-ap69:2.2": "māṇavakaṃ adhārayiṃ, ",
  "tha-ap69:2.3": "ekaṃ vatthaṃ mayā dinnaṃ ",
  "tha-ap69:2.4": "dipadindassa tādino. ",
  "tha-ap69:3.1": "tañca dussaṃ paṭiggayha ",
  "tha-ap69:3.2": "buddho lokagganāyako, ",
  "tha-ap69:3.3": "antaḷikkhe ṭhito satthā ",
  "tha-ap69:3.4": "imaṃ gāthaṃ abhāsatha: ",
  "tha-ap69:4.1": "“iminā vatthadānena ",
  "tha-ap69:4.2": "cittassa paṇidhīhi ca, ",
  "tha-ap69:4.3": "pahāya garuḷaṃ yoniṃ ",
  "tha-ap69:4.4": "devaloke ramissati.” ",
  "tha-ap69:5.1": "atthadassī tu bhagavā ",
  "tha-ap69:5.2": "lokajeṭṭho narāsabho, ",
  "tha-ap69:5.3": "vatthadānaṃ pasaṃsitvā ",
  "tha-ap69:5.4": "pakkāmi uttarāmukho. ",
  "tha-ap69:6.1": "bhave tibbattamānamhi ",
  "tha-ap69:6.2": "honti me vatthasampadā, ",
  "tha-ap69:6.3": "ākāse chadanaṃ hoti ",
  "tha-ap69:6.4": "vatthadānassidaṃ phalaṃ. ",
  "tha-ap69:7.1": "aruṇakā satta janā ",
  "tha-ap69:7.2": "cakkavattī mahabbalā, ",
  "tha-ap69:7.3": "chattiṃsatimhi kappamhi āsiṃsu ",
  "tha-ap69:7.4": "manujādhipā. 1400 ",
  "tha-ap69:8.1": "paṭisambhidā ",
  "tha-ap69:8.2": "…pe… ",
  "tha-ap69:8.3": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap69:9.1": "itthaṃ sudaṃ āyasmā vatthadāyako thero imā gāthāyo abhāsitthāti. ",
  "tha-ap69:10.1": "vatthadāyakattherassa apadānaṃ sattamaṃ. "
}
