{
  "tha-ap26:0.1": "",
  "tha-ap26:0.2": "",
  "tha-ap26:0.3": "24. pañcasīlasamādāniyattherāpadānaṃ ",
  "tha-ap26:1.1": "nagare candavatiyā ",
  "tha-ap26:1.2": "bhatako āsa’haṃ tadā, ",
  "tha-ap26:1.3": "parakammāyane yutte ",
  "tha-ap26:1.4": "pabbajjaṃ na labhāma’haṃ. ",
  "tha-ap26:2.1": "tamandhakārapihitā ",
  "tha-ap26:2.2": "tividhaggīhi ḍayhare, ",
  "tha-ap26:2.3": "kena nu kho upāyena ",
  "tha-ap26:2.4": "visaṃyutto bhave ahaṃ. ",
  "tha-ap26:3.1": "deyyadhammo ca me natthi ",
  "tha-ap26:3.2": "varāko bhatako ahaṃ, ",
  "tha-ap26:3.3": "yannūnā’haṃ pañcasīlaṃ ",
  "tha-ap26:3.4": "rakkheyyaṃ paripūrayaṃ. ",
  "tha-ap26:4.1": "anomadassī munino ",
  "tha-ap26:4.2": "nisabho nāma sāvako, ",
  "tha-ap26:4.3": "tama’haṃ upasaṅkamma ",
  "tha-ap26:4.4": "pañcasikkhāpada’ggahiṃ. ",
  "tha-ap26:5.1": "vassasatasahassāni ",
  "tha-ap26:5.2": "āyu vijjati tāvade, ",
  "tha-ap26:5.3": "tāvatā pañca sīlāni ",
  "tha-ap26:5.4": "paripuṇṇāni gopayiṃ. ",
  "tha-ap26:6.1": "maccukālambhi sampatte ",
  "tha-ap26:6.2": "devā assāsayanti maṃ, ",
  "tha-ap26:6.3": "ratho sahassassayutto ",
  "tha-ap26:6.4": "mārisā’yaṃ upaṭṭhito. ",
  "tha-ap26:7.1": "vattante carime citte ",
  "tha-ap26:7.2": "mama sīlaṃ anussariṃ, ",
  "tha-ap26:7.3": "tena kammena sukatena ",
  "tha-ap26:7.4": "tāvatiṃsaṃ agaccha’haṃ. ",
  "tha-ap26:8.1": "tiṃsakkhattuñca devindo ",
  "tha-ap26:8.2": "devarajjaṃ akārayiṃ, dibbaṃ ",
  "tha-ap26:8.3": "sukhaṃ anubhaviṃ ",
  "tha-ap26:8.4": "accharāhi purakkhato. ",
  "tha-ap26:9.1": "pañcasattatikkhattuñca ",
  "tha-ap26:9.2": "cakkavattī ahosa’haṃ, ",
  "tha-ap26:9.3": "padesarajjaṃ vipulaṃ ",
  "tha-ap26:9.4": "gaṇanāto asaṃkhiyaṃ. ",
  "tha-ap26:10.1": "devalokā cavitvāna ",
  "tha-ap26:10.2": "sukkamūlena codito, ",
  "tha-ap26:10.3": "pure vesāliyaṃ jāto ",
  "tha-ap26:10.4": "mahāsāle suaḍḍhake. ",
  "tha-ap26:11.1": "vassūpanāyike kāle ",
  "tha-ap26:11.2": "dippante jinasāsane, ",
  "tha-ap26:11.3": "mātā ca me pitā ceva ",
  "tha-ap26:11.4": "pañcasikkhāpada’ggahuṃ. ",
  "tha-ap26:12.1": "saha sutena’haṃ sīghaṃ ",
  "tha-ap26:12.2": "mama sīlaṃ anussariṃ, ",
  "tha-ap26:12.3": "ekāsane nisīditvā ",
  "tha-ap26:12.4": "arahattamapāpuṇiṃ. ",
  "tha-ap26:13.1": "jātiyā pañcavasso’haṃ ",
  "tha-ap26:13.2": "arahattamapāpuṇiṃ, ",
  "tha-ap26:13.3": "upasampādayī buddho ",
  "tha-ap26:13.4": "guṇamaññāya cakkhumā. ",
  "tha-ap26:14.1": "paripuṇṇāni gopetvā ",
  "tha-ap26:14.2": "pañca sikkhāpadāna’haṃ, ",
  "tha-ap26:14.3": "aparimeyye ito kappe ",
  "tha-ap26:14.4": "vinipātaṃ na gaccha’haṃ. ",
  "tha-ap26:15.1": "svāhaṃ yasamanubhaviṃ ",
  "tha-ap26:15.2": "tesaṃ sīlānavāhasā, ",
  "tha-ap26:15.3": "kappakoṭimpi kittento ",
  "tha-ap26:15.4": "kitteyya ekadesakaṃ. ",
  "tha-ap26:16.1": "pañca sīlāni gopetvā ",
  "tha-ap26:16.2": "tayo hetu labhāmahaṃ, ",
  "tha-ap26:16.3": "dīghāyuko mahābhogo ",
  "tha-ap26:16.4": "tikkhapañño bhavāma’haṃ. ",
  "tha-ap26:17.1": "pakittento va sabbesaṃ ",
  "tha-ap26:17.2": "adhimattañca porisaṃ, ",
  "tha-ap26:17.3": "bhavābhave saṃsaritvā ",
  "tha-ap26:17.4": "ete ṭhāne labhāmahaṃ. ",
  "tha-ap26:18.1": "aparimeyyasīlesu ",
  "tha-ap26:18.2": "vattanto jinasāvako, ",
  "tha-ap26:18.3": "bhavesu yadi rajjeyya ",
  "tha-ap26:18.4": "vipāko kīdiso bhave. ",
  "tha-ap26:19.1": "suciṇṇaṃ me pañcasīlaṃ ",
  "tha-ap26:19.2": "bhatakena vipassinā, ",
  "tha-ap26:19.3": "tena sīlena’haṃ ajja ",
  "tha-ap26:19.4": "mocayiṃ sabbabandhanaṃ. ",
  "tha-ap26:20.1": "aparimeyye ito kappe ",
  "tha-ap26:20.2": "pañca sīlāni gopayiṃ, ",
  "tha-ap26:20.3": "duggatiṃ nābhijānāmi ",
  "tha-ap26:20.4": "pañcasīlāni’daṃ phalaṃ. ",
  "tha-ap26:21.1": "paṭisambhidā …pe… ",
  "tha-ap26:21.2": "",
  "tha-ap26:21.3": "",
  "tha-ap26:21.4": "kataṃ buddhassa sāsanaṃ. ",
  "tha-ap26:22.1": "itthaṃ sudaṃ āyasmā pañcasīlasamādāniyo thero. imā gāthāyo abhāsitthāti. ",
  "tha-ap26:23.1": "pañcasīlasamādāniyattherassāpadānaṃ catutthaṃ. "
}
