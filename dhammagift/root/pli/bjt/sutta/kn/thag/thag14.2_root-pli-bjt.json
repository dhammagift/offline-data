  "thag14.2:0.1": "",
  "thag14.2:0.2": "",
  "thag14.2:0.3": "",
  "thag14.2:0.4": "14. 1. 2. khadiravaniyarevatattheragāthā. ",
  "thag14.2:1.1": "yathā’pi bhaddo ājañño ",
  "thag14.2:1.2": "dhure yutto dhurāsaho, ",
  "thag14.2:1.3": "mathito atibhārena ",
  "thag14.2:1.4": "saṃyugaṃ nātivattati. ",
  "thag14.2:2.1": "evaṃ paññāya ye tittā ",
  "thag14.2:2.2": "samuddo vārinā yathā, ",
  "thag14.2:2.3": "na pare atimaññanti ",
  "thag14.2:2.4": "ariyadhammo’va pāṇinaṃ. ",
  "thag14.2:3.1": "kāle kālavasaṃ pattā ",
  "thag14.2:3.2": "bhavābhavavasaṃ gatā, ",
  "thag14.2:3.3": "narā dukkhaṃ nigacchanti ",
  "thag14.2:3.4": "tedha socanti mānavā. ",
  "thag14.2:4.1": "unnatā sukhadhammena ",
  "thag14.2:4.2": "dukkhadhammena conatā, ",
  "thag14.2:4.3": "dvayena bālā haññanti ",
  "thag14.2:4.4": "yathābhūtaṃ adassino. ",
  "thag14.2:5.1": "ye ca dukkhe sukhasmiṃ ",
  "thag14.2:5.2": "ca majjhasibbanimaccagū ",
  "thag14.2:5.3": "ṭhitā te indakhīlo’va ",
  "thag14.2:5.4": "na te unnataonatā. ",
  "thag14.2:6.1": "naheva lābhe nālābhe ",
  "thag14.2:6.2": "ayase na ca kittiyā, ",
  "thag14.2:6.3": "na nindāyaṃ pasaṃsāya ",
  "thag14.2:6.4": "na te dukkhe sukhamhi ca. ",
  "thag14.2:7.1": "sabbattha te na lippanti ",
  "thag14.2:7.2": "udabindūva pokkhare, ",
  "thag14.2:7.3": "sabbattha sukhitā dhīrā ",
  "thag14.2:7.4": "sabbattha aparājitā. ",
  "thag14.2:8.1": "dhammena ca alābho yo ",
  "thag14.2:8.2": "yo ca lābho adhammiko, ",
  "thag14.2:8.3": "alābho dhammiko seyyo ",
  "thag14.2:8.4": "yaṃ ve lābho adhammiko. ",
  "thag14.2:9.1": "yaso ca appabuddhīnaṃ ",
  "thag14.2:9.2": "viññūnaṃ ayaso ca yo, ",
  "thag14.2:9.3": "ayaso’va seyyo viññūnaṃ ",
  "thag14.2:9.4": "na yaso appabuddhinaṃ. ",
  "thag14.2:10.1": "dummedhehi pasaṃsā ca ",
  "thag14.2:10.2": "viññūhi garahā ca yā, ",
  "thag14.2:10.3": "garahā’va seyyo viññūhi ",
  "thag14.2:10.4": "yaṃ ce bālapasaṃsanā. sukhaṃ ",
  "thag14.2:11.1": "ca kāmamayikaṃ ",
  "thag14.2:11.2": "dukkhaṃ ca pavivekiyaṃ, ",
  "thag14.2:11.3": "pavivekadukkhaṃ seyyo ",
  "thag14.2:11.4": "yaṃ ce kāmamayaṃ sukhaṃ. ",
  "thag14.2:12.1": "jīvitaṃ ca adhammena ",
  "thag14.2:12.2": "dhammena maraṇaṃ ca yaṃ, ",
  "thag14.2:12.3": "maraṇaṃ dhammikaṃ seyyo ",
  "thag14.2:12.4": "yaṃ ce jīve adhammikaṃ. ",
  "thag14.2:13.1": "kāmakopappahīnā ye ",
  "thag14.2:13.2": "santacittā bhavābhave, ",
  "thag14.2:13.3": "caranti loke asitā ",
  "thag14.2:13.4": "natthi tesaṃ piyāppiyaṃ. ",
  "thag14.2:14.1": "bhāvayitvāna bojjhaṅge ",
  "thag14.2:14.2": "indriyāni balāni ca, ",
  "thag14.2:14.3": "pappuyya paramaṃ santiṃ ",
  "thag14.2:14.4": "parinibbantyanāsavā’ti. itthaṃ sudaṃ āyasmā ",
  "thag14.2:14.5": "godatto thero ",
  "thag14.2:14.6": "gāthāyo abhāsitthā’ti. ",
  "thag14.2:15.0": "godattattheragāthā. tassuddānaṃ: ",
  "thag14.2:15.1": "revato ceva godatto ",
  "thag14.2:15.2": "therā dve te mahiddhikā, ",
  "thag14.2:15.3": "cuddasamhi nipātamhi ",
  "thag14.2:15.4": "gāthāyo aṭṭhavīsatī’ti. cuddasanipāto niṭṭhito. "
}
