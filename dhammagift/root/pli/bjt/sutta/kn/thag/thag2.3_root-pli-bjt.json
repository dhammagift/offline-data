{
  "thag2.3:0.1": "",
  "thag2.3:0.2": "",
  "thag2.3:0.3": "",
  "thag2.3:0.4": "2. 1. 3. ",
  "thag2.3:1.1": "makkaṭo pañcadvārāyaṃ ",
  "thag2.3:1.2": "kuṭikāyaṃ pasakkiya, ",
  "thag2.3:1.3": "dvārena anupariyeti ",
  "thag2.3:1.4": "ghaṭṭayento muhuṃ muhuṃ. ",
  "thag2.3:2.1": "tiṭṭha makkaṭa mā dhāvi ",
  "thag2.3:2.2": "nahi te taṃ yathā pure, ",
  "thag2.3:2.3": "niggahītosi paññāya ",
  "thag2.3:2.4": "neva dūraṃ gamissasī’ti. itthaṃ sudaṃ āyasmā ",
  "thag2.3:2.5": "valliyo thero gāthāyo abhāsitthā’ti. valliyattheragāthā. "
}
