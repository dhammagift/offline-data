  "thag1.104:0.3": "",
  "thag1.104:0.4": "1. 11. 4. bandhurattheragāthā. ",
  "thag1.104:1.1": "lahuko vata me kāyo ",
  "thag1.104:1.2": "phuṭṭho ca pītisukhena vipulena ",
  "thag1.104:1.3": "tūlamiva eritaṃ mālutena ",
  "thag1.104:1.4": "pilavatīva me kāyo’ti. itthaṃ sudaṃ āyasmā ",
  "thag1.104:1.5": "khitako thero gāthaṃ abhāsitthā’ti. "
}
