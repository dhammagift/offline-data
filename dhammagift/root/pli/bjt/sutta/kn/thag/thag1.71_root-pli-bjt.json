  "thag1.71:0.4": "1. 8. 1. ",
  "thag1.71:1.1": "susukhumanipuṇatthadassinā ",
  "thag1.71:1.2": "matikusalena nivātavuttinā ",
  "thag1.71:1.3": "saṃsevita vuddhasīlinā ",
  "thag1.71:1.4": "nibbānaṃ na hi tena dullabha’nti. itthaṃ sudaṃ āyasmā ",
  "thag1.71:1.5": "vacchapālo thero gāthaṃ abhāsitthā’ti. vacchapālattheragāthā. "
}
