  "thag1.80:0.3": "",
  "thag1.80:0.4": "1. 8. 10. rakkhitattheragāthā. ",
  "thag1.80:1.1": "yaṃ mayā pakataṃ kammaṃ ",
  "thag1.80:1.2": "appaṃ vā yadi vā bahuṃ ",
  "thag1.80:1.3": "sabbametaṃ parikkhīṇaṃ ",
  "thag1.80:1.4": "natthi dāni punabbhavo’ti. itthaṃ sudaṃ āyasmā ",
  "thag1.80:1.5": "uggo thero gāthaṃ abhāsitthā’ti. ",
  "thag1.80:1.6": "uggattheragāthā. aṭṭhamo vaggo. ",
  "thag1.80:2.0": "tassuddānaṃ: ",
  "thag1.80:2.1": "vacchapālo ca yo thero ",
  "thag1.80:2.2": "ātumo māṇavo isi ",
  "thag1.80:2.3": "suyāmo ca susārado ",
  "thag1.80:2.4": "thero yo ca piyañjaho ",
  "thag1.80:2.5": "ārohaputto meṇḍasiro ",
  "thag1.80:2.6": "rakkhito uggasavhayo’ti. navamo vaggo. "
}
