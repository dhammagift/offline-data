  "thag2.38:0.3": "",
  "thag2.38:0.4": "2. 4. 8. selissariyattheragāthā. ",
  "thag2.38:1.1": "pañcakāmaguṇe hitvā ",
  "thag2.38:1.2": "piyarūpe manorame, ",
  "thag2.38:1.3": "saddhāya abhinikkhamma ",
  "thag2.38:1.4": "dukkhassantakaro bhave. ",
  "thag2.38:2.1": "nābhinandāmi maraṇaṃ ",
  "thag2.38:2.2": "nābhinandāmi jīvitaṃ, ",
  "thag2.38:2.3": "kālaṃ ca paṭikaṅkhāmi ",
  "thag2.38:2.4": "sampajāno patissato’ti. itthaṃ sudaṃ āyasmā ",
  "thag2.38:2.5": "nisabho thero gāthāyo abhāsitthā’ti. "
}
