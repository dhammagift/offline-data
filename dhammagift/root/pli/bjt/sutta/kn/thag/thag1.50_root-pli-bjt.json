  "thag1.50:0.3": "",
  "thag1.50:0.4": "1. 5. 10. ",
  "thag1.50:1.1": "dharaṇī ca siñcati vāti ",
  "thag1.50:1.2": "māluto vijjutā carati nabhe ",
  "thag1.50:1.3": "upasamanti vitakkā ",
  "thag1.50:1.4": "cittaṃ susamāhitaṃ mamā’ti. itthaṃ sudaṃ ",
  "thag1.50:1.5": "vimalo thero gāthaṃ abhāsitthā’ti. vimalattheragāthā. pañcamo ",
  "thag1.50:1.6": "vaggo. ",
  "thag1.50:2.0": "tassuddānaṃ: ",
  "thag1.50:2.1": "sirivaḍḍho revato thero ",
  "thag1.50:2.2": "sumaṅgalo sānusavhayo ",
  "thag1.50:2.3": "ramaṇīyavihārī ca ",
  "thag1.50:2.4": "samiddhiujjayasañjayā ",
  "thag1.50:2.5": "rāmaṇeyyo ca so thero ",
  "thag1.50:2.6": "vimalo ca raṇañjaho’ti. chaṭṭho vaggo. "
}
