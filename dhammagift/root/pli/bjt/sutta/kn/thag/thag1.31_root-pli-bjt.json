{
  "thag1.31:0.1": "catuttho vaggo ",
  "thag1.31:0.2": "",
  "thag1.31:0.3": "",
  "thag1.31:0.4": "1. 4. 1. ",
  "thag1.31:1.1": "phuṭṭho ḍaṃsehi makasehi ",
  "thag1.31:1.2": "araññasmiṃ brahāvane ",
  "thag1.31:1.3": "nāgo saṅgāmasīseva ",
  "thag1.31:1.4": "sato tatrādhivāsaye’ti. ",
  "thag1.31:1.5": "itthaṃ sudaṃ āyasmā gabbharatīriyo thero gāthaṃ abhāsitthā’ti. "
}
