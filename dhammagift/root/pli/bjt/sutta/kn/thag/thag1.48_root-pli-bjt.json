  "thag1.48:0.4": "1. 5. 8. ",
  "thag1.48:1.1": "yato ahaṃ pabbajito ",
  "thag1.48:1.2": "agārasmānagāriyaṃ ",
  "thag1.48:1.3": "nābhijānāmi saṅkappaṃ ",
  "thag1.48:1.4": "anariyaṃ dosasaṃhita’nti. itthaṃ sudaṃ āyasmā ",
  "thag1.48:1.5": "sañjayo thero gāthaṃ abhāsitthā’ti. sañjayattheragāthā. "
}
