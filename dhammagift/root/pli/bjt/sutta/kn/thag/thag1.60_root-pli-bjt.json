  "thag1.60:0.3": "",
  "thag1.60:0.4": "1. 6. 10. kosalavihārittheragāthā. ",
  "thag1.60:1.1": "te me ijjhiṃsu saṅkappā ",
  "thag1.60:1.2": "yadattho pavisiṃ kuṭiṃ ",
  "thag1.60:1.3": "vijjāvimuttiṃ paccessaṃ mānānusayamujjahi’nti. itthaṃ ",
  "thag1.60:1.4": "sudaṃ āyasmā ",
  "thag1.60:1.5": "sīvalitthero gāthaṃ abhāsitthā’ti. ",
  "thag1.60:1.6": "sīvalittheragāthā. chaṭṭho vaggo. ",
  "thag1.60:2.0": "tassuddānaṃ: ",
  "thag1.60:2.1": "godhiko ca subāhu ca ",
  "thag1.60:2.2": "valliyo uttiyo isi ",
  "thag1.60:2.3": "añjanavaniyo thero ",
  "thag1.60:2.4": "duve kuṭivihārino ",
  "thag1.60:2.5": "ramaṇīyakuṭiko ca ",
  "thag1.60:2.6": "kosalavhayasīvalī’ti. sattamo vaggo "
}
