  "thag1.45:0.4": "1. 5. 5. ",
  "thag1.45:1.1": "yathāpi bhaddo ājañño ",
  "thag1.45:1.2": "khalitvā patitiṭṭhati ",
  "thag1.45:1.3": "evaṃ dassanasampannaṃ ",
  "thag1.45:1.4": "sammāsambuddhasāvakanti. itthaṃ sudaṃ āyasmā ",
  "thag1.45:1.5": "ramaṇīyavihāritthero gāthaṃ abhāsitthā’ti. ramaṇīyavihārittheragāthā. "
}
