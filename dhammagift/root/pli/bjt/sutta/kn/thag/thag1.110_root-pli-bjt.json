  "thag1.110:0.3": "",
  "thag1.110:0.4": "1. 11. 10. saṅgharakkhitattheragāthā. ",
  "thag1.110:1.1": "nagā nagaggesu susaṃvirūḷhā ",
  "thag1.110:1.2": "udaggameghena navena sittā ",
  "thag1.110:1.3": "vivekakāmassa araññasaññino ",
  "thag1.110:1.4": "janeti bhiyyo usabhassa kalyata’nti. itthaṃ sudaṃ āyasmā ",
  "thag1.110:1.5": "usabho thero ",
  "thag1.110:1.6": "gāthaṃ abhāsitthā’ti. ",
  "thag1.110:2.0": "usabhattheragāthā. ekādasamo vaggo. tassuddānaṃ: ",
  "thag1.110:2.1": "belaṭṭhānikasetucchā ",
  "thag1.110:2.2": "bandhuro khitako isī, ",
  "thag1.110:2.3": "malitavambho suhemanto ",
  "thag1.110:2.4": "dhammasavo dhammasavapitā, ",
  "thag1.110:2.5": "saṅgharakkhitatthero ca ",
  "thag1.110:2.6": "usabho ca mahāmunī’ti. "
}
