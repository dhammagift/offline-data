  "thag1.29:0.4": "1. 3. 9. jambugāmikattheragāthā. ",
  "thag1.29:1.1": "samunnamayamattānaṃ ",
  "thag1.29:1.2": "usukāro’va tejanaṃ ",
  "thag1.29:1.3": "cittaṃ ujuṃ karitvāna ",
  "thag1.29:1.4": "avijjaṃ bhinda hāritā’ti. itthaṃ sudaṃ āyasmā ",
  "thag1.29:1.5": "hārito thero gāthaṃ abhāsitthā’ti. "
}
