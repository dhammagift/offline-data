  "thag1.41:0.4": "1. 5. 1. ",
  "thag1.41:1.1": "vivaramanupatanti vijjutā ",
  "thag1.41:1.2": "vebhārassa ca paṇḍavassa ca ",
  "thag1.41:1.3": "nagavivaragato ca jhāyati ",
  "thag1.41:1.4": "putto appaṭimassa tādino’ti. itthaṃ sudaṃ āyasmā ",
  "thag1.41:1.5": "sirivaḍḍho thero gāthaṃ abhāsitthā’ti. sirivaḍḍhattheragāthā. "
}
