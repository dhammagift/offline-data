  "thag1.79:0.4": "1. 8. 9. ",
  "thag1.79:1.1": "sabbo rāgo pahīno me ",
  "thag1.79:1.2": "sabbo doso samūhato ",
  "thag1.79:1.3": "sabbo me vigato moho ",
  "thag1.79:1.4": "sītibhūtosmi nibbuto’ti. itthaṃ sudaṃ āyasmā ",
  "thag1.79:1.5": "rakkhito thero gāthaṃ abhāsitthā’ti. rakkhitattheragāthā. "
}
