  "thag1.117:0.4": "1. 12. 7. ",
  "thag1.117:1.1": "suvilitto suvasano ",
  "thag1.117:1.2": "sabbābharaṇabhūsito, ",
  "thag1.117:1.3": "tisso vijjā ajjhagamiṃ ",
  "thag1.117:1.4": "kataṃ buddhassa sāsana’nti. itthaṃ sudaṃ āyasmā ",
  "thag1.117:1.5": "yaso thero gāthaṃ abhāsitthā’ti. yasattheragāthā. "
}
