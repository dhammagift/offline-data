  "thag1.75:0.3": "",
  "thag1.75:0.4": "1. 8. 5. suyāmattheragāthā. ",
  "thag1.75:1.1": "sādhu suvihitāna dassanaṃ ",
  "thag1.75:1.2": "kaṅkhā chijjati buddhi vaḍḍhati ",
  "thag1.75:1.3": "bālampi karonti paṇḍitaṃ ",
  "thag1.75:1.4": "tasmā sādhu sataṃ samāgamo’ti. itthaṃ sudaṃ āyasmā ",
  "thag1.75:1.5": "susārado thero gāthaṃ abhāsitthā’ti. "
}
