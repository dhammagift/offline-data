  "thag1.69:0.3": "",
  "thag1.69:0.4": "1. 7. 9. ",
  "thag1.69:1.1": "sutvāna dhammaṃ mahato mahārasaṃ ",
  "thag1.69:1.2": "sabbaññutaññaṇavarena desitaṃ ",
  "thag1.69:1.3": "maggaṃ papajjiṃ amatassa pattiyā ",
  "thag1.69:1.4": "so yogakkhemassa pathassa kovido’ti. itthaṃ sudaṃ āyasmā ",
  "thag1.69:1.5": "channo thero gāthaṃ abhāsitthā’ti. channattheragāthā. "
}
