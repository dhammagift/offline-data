  "thag1.112:0.4": "1. 12. 2. jentattheragāthā. ",
  "thag1.112:1.1": "tevijjohaṃ mahājhāyī ",
  "thag1.112:1.2": "cetosamathakovido ",
  "thag1.112:1.3": "sadattho me anuppatto ",
  "thag1.112:1.4": "kataṃ buddhassa sāsana’nti. ",
  "thag1.112:1.5": "itthaṃ sudaṃ āyasmā jento thero gāthaṃ abhāsitthā’ti. "
}
