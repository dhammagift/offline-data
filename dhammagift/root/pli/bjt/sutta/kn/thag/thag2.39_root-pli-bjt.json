  "thag2.39:0.3": "",
  "thag2.39:0.4": "2. 4. 9. nisabhattheragāthā. ",
  "thag2.39:1.1": "ambapallava saṅkāsaṃ ",
  "thag2.39:1.2": "aṃse katvāna cīvaraṃ, ",
  "thag2.39:1.3": "nisinno hatthi gīvāya ",
  "thag2.39:1.4": "gāmaṃ piṇḍāya pāvisiṃ. ",
  "thag2.39:2.1": "hatthikkhandhato oruyha ",
  "thag2.39:2.2": "saṃvegaṃ alabhiṃ tadā, ",
  "thag2.39:2.3": "sohaṃ ditto tadā santo ",
  "thag2.39:2.4": "patto me āsavakkhayo’ti. itthaṃ sudaṃ āyasmā ",
  "thag2.39:2.5": "usabho thero gāthāyo abhāsitthā’ti. "
}
