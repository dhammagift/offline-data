  "thag2.13:0.3": "",
  "thag2.13:0.4": "2. 2. 3. jotidāsattheragāthā. ",
  "thag2.13:1.1": "accayanti ahorattā ",
  "thag2.13:1.2": "jīvitaṃ uparujjhati, ",
  "thag2.13:1.3": "ayu khīyati maccānaṃ ",
  "thag2.13:1.4": "kunnadīnaṃ va odakaṃ. ",
  "thag2.13:2.1": "atha pāpāni kammāni ",
  "thag2.13:2.2": "karaṃ bālo na bujjhati, ",
  "thag2.13:2.3": "pacchāssa kaṭukaṃ hoti ",
  "thag2.13:2.4": "vipāko hissa pāpako’ti. itthaṃ sudaṃ āyasmā ",
  "thag2.13:2.5": "heraññakānitthero gāthāyo abhāsitthā’ti. "
}
