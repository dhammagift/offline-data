  "thag1.58:0.4": "1. 6. 8. dutiyakuṭivihārittheragāthā. ",
  "thag1.58:1.1": "ramaṇīyo me kuṭikā ",
  "thag1.58:1.2": "saddhādeyyā manoramā ",
  "thag1.58:1.3": "na me attho kumārīhi ",
  "thag1.58:1.4": "yesaṃ attho tahiṃ gacchatha nāriyo’ti. itthaṃ sudaṃ āyasmā ",
  "thag1.58:1.5": "ramaṇīyakuṭiko thero gāthaṃ abhāsitthā’ti. "
}
