  "thag3.7:0.3": "",
  "thag3.7:0.4": "3. 1. 7. khujjasobhitattheragāthā. ",
  "thag3.7:1.1": "yodha koci manussesu ",
  "thag3.7:1.2": "parapāṇāni hiṃsati, ",
  "thag3.7:1.3": "asmā lokā paramhā ca ",
  "thag3.7:1.4": "ubhayā dhaṃsate naro. ",
  "thag3.7:2.1": "yo ca mettena cittena ",
  "thag3.7:2.2": "sabbapāṇānukampati, ",
  "thag3.7:2.3": "bahuṃ so pasavati ",
  "thag3.7:2.4": "puññaṃ tena tādisako naro. ",
  "thag3.7:3.1": "subhāsitassa sikkhetha ",
  "thag3.7:3.2": "samaṇūpāsanassa ca, ",
  "thag3.7:3.3": "ekāsanassa raho ",
  "thag3.7:3.4": "cittavūpasamassa cāti. itthaṃ sudaṃ āyasmā ",
  "thag3.7:3.5": "vāraṇo thero gāthāyo abhāsitthā’ti. "
}
