  "thag1.85:0.4": "1. 9. 5. nītattheragāthā. ",
  "thag1.85:1.1": "cittanimittassa kovido ",
  "thag1.85:1.2": "pavivekarasaṃ vijāniya, ",
  "thag1.85:1.3": "jhāyaṃ nipako patissato ",
  "thag1.85:1.4": "adhigaccheyya sukhaṃ nirāmisanti. itthaṃ sudaṃ āyasmā ",
  "thag1.85:1.5": "sunāgo thero gāthaṃ abhāsitthā’ti. "
}
