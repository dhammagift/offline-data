  "thag1.115:0.4": "1. 12. 5. adhimuttattheragāthā. ",
  "thag1.115:1.1": "esāvahiyyase pabbatena ",
  "thag1.115:1.2": "bahukuṭajasallakikena, ",
  "thag1.115:1.3": "nesādakena girinā ",
  "thag1.115:1.4": "yasassinā paricchadenā’ti. itthaṃ sudaṃ āyasmā ",
  "thag1.115:1.5": "mahānāmo thero gāthaṃ abhāsitthā’ti. "
}
