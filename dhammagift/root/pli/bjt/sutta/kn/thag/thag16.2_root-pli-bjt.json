{
  "thag16.2:0.1": "",
  "thag16.2:0.2": "",
  "thag16.2:0.3": "",
  "thag16.2:0.4": "20. 1. 2. adhimuttattheragāthā. ",
  "thag16.2:1.1": "samaṇassa ahu cintā ",
  "thag16.2:1.2": "pārāsariyassa bhikkhuno, ",
  "thag16.2:1.3": "ekakassa nisinnassa ",
  "thag16.2:1.4": "pavivittassa jhāyino. ",
  "thag16.2:2.1": "kimānupubbaṃ puriso ",
  "thag16.2:2.2": "kiṃ vataṃ kiṃ samācaraṃ, ",
  "thag16.2:2.3": "attano kiccakirissa ",
  "thag16.2:2.4": "na ca kiñci viheṭhaye. ",
  "thag16.2:3.1": "indriyāni manussānaṃ ",
  "thag16.2:3.2": "hitāya ahitāya ca, ",
  "thag16.2:3.3": "arakkhitāni ahitāya ",
  "thag16.2:3.4": "rakkhitāni hitāya ca. ",
  "thag16.2:4.1": "indriyānevaṃ sārakkhaṃ ",
  "thag16.2:4.2": "indriyāni ca gopayaṃ, ",
  "thag16.2:4.3": "attano kiccakārissa ",
  "thag16.2:4.4": "na ca kiñci viheṭhaye. ",
  "thag16.2:5.1": "cakkhundriyaṃ ce rūpesu ",
  "thag16.2:5.2": "gacchantaṃ anivārayaṃ, ",
  "thag16.2:5.3": "anādīnavadassāvī ",
  "thag16.2:5.4": "so dukkhā na hi muccati. ",
  "thag16.2:6.1": "sotindriyaṃ ce saddesu ",
  "thag16.2:6.2": "gacchantaṃ anivārayaṃ, ",
  "thag16.2:6.3": "anādīnavadassāvī ",
  "thag16.2:6.4": "so mukkhā na hi muccati. ",
  "thag16.2:7.1": "anissaraṇadassāvī ",
  "thag16.2:7.2": "gandhe ce paṭisevati, ",
  "thag16.2:7.3": "na so muccati dukkhamhā ",
  "thag16.2:7.4": "gandhesu adhimucchito. ",
  "thag16.2:8.1": "ambilaṃ madhuraggaṃ ca ",
  "thag16.2:8.2": "tittakaggamanussaraṃ, ",
  "thag16.2:8.3": "rasataṇhāya gadhito ",
  "thag16.2:8.4": "hadayaṃ nāvabujjhati. ",
  "thag16.2:9.1": "subhānyappaṭikūlāni ",
  "thag16.2:9.2": "phoṭṭhabbāni anussaraṃ, ",
  "thag16.2:9.3": "ratto ragādhikaraṇaṃ ",
  "thag16.2:9.4": "vividhaṃ vindate dukhaṃ. ",
  "thag16.2:10.1": "manaṃ cetehi dhammehi ",
  "thag16.2:10.2": "yo na sakkoti rakkhituṃ, ",
  "thag16.2:10.3": "tato naṃ dukkhamanveti ",
  "thag16.2:10.4": "sabbahetehi pañcahi. ",
  "thag16.2:11.1": "pubbalohitasampuṇṇaṃ ",
  "thag16.2:11.2": "bahussa kuṇapassa ca, ",
  "thag16.2:11.3": "naravīrakataṃ vagguṃ ",
  "thag16.2:11.4": "samuggamiva cittitaṃ. ",
  "thag16.2:12.1": "kaṭukaṃ madhurassādaṃ ",
  "thag16.2:12.2": "piyanibandhanaṃ dukhaṃ, ",
  "thag16.2:12.3": "khuraṃva madhunā littaṃ ",
  "thag16.2:12.4": "ullihaṃ nāvabujjhati. ",
  "thag16.2:13.1": "itthirūpe itthisare ",
  "thag16.2:13.2": "phoṭṭhabbe’pi itthiyā, ",
  "thag16.2:13.3": "itthigandhesu sāratto ",
  "thag16.2:13.4": "vividhaṃ vindate dukhaṃ. ",
  "thag16.2:14.1": "itthisotāni sabbāni ",
  "thag16.2:14.2": "sandanti pañca pañcasu, ",
  "thag16.2:14.3": "tesamāvaraṇaṃ kātuṃ ",
  "thag16.2:14.4": "so sakkoti viriyavā. ",
  "thag16.2:15.1": "so atthavā so dhammaṭṭho ",
  "thag16.2:15.2": "so dukkho so vicakkhaṇo, ",
  "thag16.2:15.3": "kareyya ramamāno pi ",
  "thag16.2:15.4": "kiccaṃ dhammatthasaṃhitaṃ. ",
  "thag16.2:16.1": "atho sīdati saññuttaṃ ",
  "thag16.2:16.2": "vajje kiccaṃ niratthakaṃ, ",
  "thag16.2:16.3": "na taṃ kiccanti maññitvā ",
  "thag16.2:16.4": "appamatto vicakkhaṇo. ",
  "thag16.2:17.1": "yaṃ ca atthena saññuntaṃ ",
  "thag16.2:17.2": "yā ca dhammagatā rati, ",
  "thag16.2:17.3": "taṃ samādāya vattetha ",
  "thag16.2:17.4": "sā hi uttamā rati. ",
  "thag16.2:18.1": "uccāvacehupāyehi ",
  "thag16.2:18.2": "paresamabhijigīsati, ",
  "thag16.2:18.3": "hantvā vadhitvā atha socayitvā, ",
  "thag16.2:18.4": "ālopati sāhasā yo paresaṃ. ",
  "thag16.2:19.1": "tacchanto āṇiyā āṇiṃ ",
  "thag16.2:19.2": "nihanti balavā yathā, ",
  "thag16.2:19.3": "indriyānindreyeheva ",
  "thag16.2:19.4": "nihanti kusalo tathā. ",
  "thag16.2:20.1": "saddhaṃ viriyaṃ samādhiṃ ca ",
  "thag16.2:20.2": "satiṃ paññañca bhāvayaṃ, ",
  "thag16.2:20.3": "pañca pañcahi hantvāna ",
  "thag16.2:20.4": "anīgho yāti brāhmaṇo. ",
  "thag16.2:21.1": "so atthavā so dhammaṭṭho ",
  "thag16.2:21.2": "katvā vākyānusāsaniṃ, ",
  "thag16.2:21.3": "sabbena sabbaṃ buddhassa ",
  "thag16.2:21.4": "so naro sukhamedhatī’ti. ",
  "thag16.2:21.5": "itthaṃ sudaṃ āyasmā pārāsariyo thero gāthāyo abhāsitthā’ti. "
}
