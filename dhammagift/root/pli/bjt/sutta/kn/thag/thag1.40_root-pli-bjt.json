  "thag1.40:0.3": "",
  "thag1.40:0.4": "1. 4. 10. ",
  "thag1.40:1.1": "sattiyā viya omaṭṭho ",
  "thag1.40:1.2": "ḍayhamāno’va matthake ",
  "thag1.40:1.3": "bhavarāgappahānāya ",
  "thag1.40:1.4": "sato bhikkhu paribbaje’ti. itthaṃ sudaṃ āyasmā ",
  "thag1.40:1.5": "vaḍḍhamāno thero gāthaṃ abhāsitthā’ti. vaḍḍhamānattheragāthā. catuttho ",
  "thag1.40:1.6": "vaggo. ",
  "thag1.40:2.0": "tassuddānaṃ: ",
  "thag1.40:2.1": "gabbharatīriyo suppiyo ",
  "thag1.40:2.2": "sopāko ceva posiyo ",
  "thag1.40:2.3": "sāmaññakāni kumāputto ",
  "thag1.40:2.4": "kumāputtasahāyako ",
  "thag1.40:2.5": "gavampati tissatthero ",
  "thag1.40:2.6": "vaḍḍhamāno mahāyaso’ti. pañcamo vaggo "
}
