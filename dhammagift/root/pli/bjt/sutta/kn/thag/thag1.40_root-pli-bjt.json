  "thag1.40:0.4": "1. 4. 10. tissattheragāthā. ",
  "thag1.40:1.1": "sattiyā viya omaṭṭho ḍayhamāno’va matthake bhavarāgappahānāya sato bhikkhu paribbaje’ti. itthaṃ sudaṃ āyasmā vaḍḍhamāno thero gāthaṃ abhāsitthā’ti. ",
  "thag1.40:1.2": "",
  "thag1.40:1.3": "",
  "thag1.40:1.4": "",
  "thag1.40:1.5": "",
  "thag1.40:1.6": "",
  "thag1.40:2.0": "vaḍḍhamānattheragāthā. catuttho vaggo. tassuddānaṃ: ",
  "thag1.40:2.1": "gabbharatīriyo suppiyo ",
  "thag1.40:2.2": "sopāko ceva posiyo ",
  "thag1.40:2.3": "sāmaññakāni kumāputto ",
  "thag1.40:2.4": "kumāputtasahāyako ",
  "thag1.40:2.5": "gavampati tissatthero ",
  "thag1.40:2.6": "vaḍḍhamāno mahāyaso’ti. "
}
