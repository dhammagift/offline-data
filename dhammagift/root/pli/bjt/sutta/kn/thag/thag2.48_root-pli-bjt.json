  "thag2.48:0.3": "",
  "thag2.48:0.4": "2. 5. 8. ",
  "thag2.48:1.1": "saṃsaraṃ dīghamaddhānaṃ ",
  "thag2.48:1.2": "gatīsu parivattisaṃ, ",
  "thag2.48:1.3": "apassaṃ ariyasaccāni ",
  "thag2.48:1.4": "andhabhūto puthujjano. ",
  "thag2.48:2.1": "tassa me appamattassa ",
  "thag2.48:2.2": "saṃsārā vinalīkatā, gati ",
  "thag2.48:2.3": "sabbā samucchinnā ",
  "thag2.48:2.4": "natthi dāni punabbhavo’ti. itthaṃ sudaṃ āyasmā ",
  "thag2.48:2.5": "vajjito thero gāthāyo abhāsitthā’ti. vajjitattheragāthā. "
}
