  "thag2.32:0.1": "",
  "thag2.32:0.2": "",
  "thag2.32:0.3": "",
  "thag2.32:0.4": "2. 4. 2. migasirattheragāthā. ",
  "thag2.32:1.1": "aniccāni gahakāni ",
  "thag2.32:1.2": "tattha tattha punappunaṃ, ",
  "thag2.32:1.3": "gahakāraṃ gavesanto ",
  "thag2.32:1.4": "dukkhā jāti punappunaṃ. ",
  "thag2.32:2.1": "gahakāraka diṭṭhosi ",
  "thag2.32:2.2": "puna gehaṃ na kāhasi, ",
  "thag2.32:2.3": "sabbā te phāsukā bhaggā ",
  "thag2.32:2.4": "thūṇikā ca vidāḷitā, ",
  "thag2.32:2.5": "vimariyādīkataṃ cittaṃ ",
  "thag2.32:2.6": "idheva vidhamissatī’ti. itthaṃ sudaṃ āyasmā ",
  "thag2.32:2.7": "sīvako thero gāthāyo abhāsitthā’ti. "
}
