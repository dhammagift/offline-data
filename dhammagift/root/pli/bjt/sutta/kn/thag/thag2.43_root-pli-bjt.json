  "thag2.43:0.1": "",
  "thag2.43:0.2": "",
  "thag2.43:0.3": "",
  "thag2.43:0.4": "2. 5. 3. ",
  "thag2.43:1.1": "kassindriyāni samathaṅgatāni ",
  "thag2.43:1.2": "assā yathā sārathinā sudantā ",
  "thag2.43:1.3": "pahīnamānassa anāsavassa ",
  "thag2.43:1.4": "devāpi tassa pihayanti tādino’ti. ",
  "thag2.43:2.1": "mahindriyāni samathaṅgatāni ",
  "thag2.43:2.2": "assā yathā sārathinā sudantā ",
  "thag2.43:2.3": "pahīnamānassa anāsavassa ",
  "thag2.43:2.4": "devāpi mayhaṃ pihayanti tādino’ti. itthaṃ sudaṃ āyasmā ",
  "thag2.43:2.5": "brahmāli thero gāthāyo abhāsitthā’ti. brahmālittheragāthā. "
}
