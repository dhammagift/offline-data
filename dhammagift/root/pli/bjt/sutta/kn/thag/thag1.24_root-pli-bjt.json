  "thag1.24:0.4": "1. 3. 4. ",
  "thag1.24:1.1": "anuvassiko pabbajito ",
  "thag1.24:1.2": "passa dhammasudhammataṃ ",
  "thag1.24:1.3": "tisso vijjā anuppattā ",
  "thag1.24:1.4": "kataṃ buddhassa sāsana’nti. itthaṃ sudaṃ āyasmā ",
  "thag1.24:1.5": "sugandho thero gāthaṃ abhāsitthā’ti. sugandhattheragāthā. "
}
