{
  "thag4.8:0.1": "",
  "thag4.8:0.2": "",
  "thag4.8:0.3": "",
  "thag4.8:0.4": "4. 1. 8. ",
  "thag4.8:1.1": "ubhayeneva sampanno ",
  "thag4.8:1.2": "rāhulabhaddo’ti maṃ vidū ",
  "thag4.8:1.3": "yañcamhi putto buddhassa ",
  "thag4.8:1.4": "yaṃ ca dhammesu cakkhumā. ",
  "thag4.8:2.1": "yaṃ ca āsavā khīṇā ",
  "thag4.8:2.2": "yaṃ ca natthi punabbhavo ",
  "thag4.8:2.3": "arahā dakkhiṇeyyomhi ",
  "thag4.8:2.4": "tevijjo amataddaso. ",
  "thag4.8:3.1": "kāmandhā jālapacchannā ",
  "thag4.8:3.2": "taṇhāchadanachāditā ",
  "thag4.8:3.3": "pamattabandhunā baddhā ",
  "thag4.8:3.4": "macchāva kumināmukhe. ",
  "thag4.8:4.1": "taṃ kāmaṃ ahamujjhitvā ",
  "thag4.8:4.2": "chetvā mārassa bandhanaṃ ",
  "thag4.8:4.3": "samūlaṃ taṇhamabbuyha ",
  "thag4.8:4.4": "sītibhūtosmi nibbuto’ti. itthaṃ sudaṃ āyasmā ",
  "thag4.8:4.5": "rāhulo thero gāthāyo abhāsitthā’ti. rāhulattheragāthā. "
}
