{
  "thag2.1:0.1": "2. dukanipāto ",
  "thag2.1:0.2": "",
  "thag2.1:0.3": "vaggo paṭhamo. ",
  "thag2.1:0.4": "2. 1. 1. ",
  "thag2.1:1.1": "natthi koci bhavo nicco ",
  "thag2.1:1.2": "saṅkhārā vā pi sassatā, ",
  "thag2.1:1.3": "uppajjanti ca te khandhā ",
  "thag2.1:1.4": "vacanti aparāparaṃ. ",
  "thag2.1:2.1": "etamādīnavaṃ ñatvā ",
  "thag2.1:2.2": "bhavenamhi anatthiko, ",
  "thag2.1:2.3": "nissaṭo sabbakāmehi ",
  "thag2.1:2.4": "patto me āsavakkhayo’ti. ",
  "thag2.1:2.5": "itthaṃ sudaṃ āyasmā attaro thero gāthāyo abhāsitthā’ti. "
}
