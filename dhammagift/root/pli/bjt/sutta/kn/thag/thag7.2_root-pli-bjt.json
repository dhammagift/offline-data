{
  "thag7.2:0.1": "",
  "thag7.2:0.2": "",
  "thag7.2:0.3": "",
  "thag7.2:0.4": "7. 1. 2. ",
  "thag7.2:1.1": "pare ambāṭakārāme ",
  "thag7.2:1.2": "vanasaṇḍamhi bhaddiyo, ",
  "thag7.2:1.3": "samūlaṃ taṇhamabbuyha ",
  "thag7.2:1.4": "tattha bhaddo jhiyāyati. ",
  "thag7.2:2.1": "ramanteke mutiṅgehi ",
  "thag7.2:2.2": "vīṇāhi paṇavehi ca, ",
  "thag7.2:2.3": "ahaṃ ca rukkhamūlasmiṃ ",
  "thag7.2:2.4": "rato buddhassa sāsane. ",
  "thag7.2:3.1": "buddho ce me varaṃ dajjā ",
  "thag7.2:3.2": "so ca labbhetha me varo, ",
  "thag7.2:3.3": "gaṇhehaṃ sabbalokassa ",
  "thag7.2:3.4": "niccaṃ kāyagataṃ satiṃ. ",
  "thag7.2:4.1": "ye maṃ rūpena pāmiṃsu ",
  "thag7.2:4.2": "ye ca ghosena anvagū, ",
  "thag7.2:4.3": "chandarāgavasūpetā ",
  "thag7.2:4.4": "na maṃ jānanti te janā. ",
  "thag7.2:5.1": "ajjhattaṃ ca na jānāti ",
  "thag7.2:5.2": "bahiddhā ca na passati, ",
  "thag7.2:5.3": "samantāvaraṇo bālo ",
  "thag7.2:5.4": "sa ve ghosena vuyhati. ",
  "thag7.2:6.1": "ajjhattaṃ ca na jānāti ",
  "thag7.2:6.2": "bahiddhā ca vipassati, ",
  "thag7.2:6.3": "bahiddhā phaladassāvī ",
  "thag7.2:6.4": "so’pi ghosena vuyhati. ",
  "thag7.2:7.1": "ajjhattaṃ ca pajānāti ",
  "thag7.2:7.2": "bahiddhā ca vipassati, ",
  "thag7.2:7.3": "anāvaraṇadassāvī ",
  "thag7.2:7.4": "na so ghosena vuyhatī’ti. ",
  "thag7.2:7.5": "itthaṃ sudaṃ āyasmā lakuṇṭakabhaddiyo thero gāthāyo abhāsitthā’ti. lakuṇṭakabhaddiyattheragāthā. "
}
