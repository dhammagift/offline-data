  "thag1.30:0.3": "",
  "thag1.30:0.4": "1. 3. 10. ",
  "thag1.30:1.1": "ābādhe me samuppanne ",
  "thag1.30:1.2": "sati me upapajjatha ",
  "thag1.30:1.3": "ābādho me samuppanno ",
  "thag1.30:1.4": "kālo me nappamajjitunti. itthaṃ sudaṃ āyasmā ",
  "thag1.30:1.5": "uttiyo thero gāthaṃ abhāsitthā’ti. uttiyattheragāthā. tatiyo ",
  "thag1.30:1.6": "vaggo. ",
  "thag1.30:2.0": "tassuddānaṃ: ",
  "thag1.30:2.1": "nigrodho cittako thero ",
  "thag1.30:2.2": "gosālathero sugandho ",
  "thag1.30:2.3": "nandiyo ubhayo thero ",
  "thag1.30:2.4": "thero lomasakaṅgiyo ",
  "thag1.30:2.5": "jambugāmikaputto ca ",
  "thag1.30:2.6": "hārito uttiyo isīti. catuttho vaggo "
}
