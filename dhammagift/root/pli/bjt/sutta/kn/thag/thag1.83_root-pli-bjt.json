  "thag1.83:0.4": "1. 9. 3. ",
  "thag1.83:1.1": "sīhappamattā vihara ",
  "thag1.83:1.2": "rattindivamatandito ",
  "thag1.83:1.3": "bhāvehi kusalaṃ dhammaṃ ",
  "thag1.83:1.4": "jaha sīghaṃ samussayanti. itthaṃ sudaṃ āyasmā ",
  "thag1.83:1.5": "sīho thero gāthaṃ abhāsitthā’ti. sīhattheragāthā. "
}
