{
  "thag1.11:0.1": "dutiyo vaggo ",
  "thag1.11:0.2": "",
  "thag1.11:0.3": "",
  "thag1.11:0.4": "1. 2. 1. ",
  "thag1.11:1.1": "pāmojjabahulo bhikkhu ",
  "thag1.11:1.2": "dhamme buddhappavedite ",
  "thag1.11:1.3": "adhigacche padaṃ santaṃ ",
  "thag1.11:1.4": "saṅkhārūpasamaṃ sukhanti. itthaṃ sudaṃ āyasmā ",
  "thag1.11:1.5": "cūḷavaccho thero gāthaṃ abhāsitthā’ti. "
}
