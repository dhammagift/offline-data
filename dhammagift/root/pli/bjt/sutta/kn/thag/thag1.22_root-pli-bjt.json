  "thag1.22:0.3": "",
  "thag1.22:0.4": "1. 3. 2. nigrodhattheragāthā. ",
  "thag1.22:1.1": "nīlā sugīvā sikhino ",
  "thag1.22:1.2": "morā kāraṃviyaṃ abhinadanti. ",
  "thag1.22:1.3": "te sītavātakadditakalitā ",
  "thag1.22:1.4": "suttaṃ jhāyaṃ nibodhentī’ti. itthaṃ sudaṃ āyasmā ",
  "thag1.22:1.5": "cittako thero gāthaṃ abhāsitthā’ti. "
}
