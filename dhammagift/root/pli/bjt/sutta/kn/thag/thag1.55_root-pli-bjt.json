  "thag1.55:0.3": "",
  "thag1.55:0.4": "1. 6. 5. uttiyattheragāthā. ",
  "thag1.55:1.1": "āsandi kuṭikaṃ katvā ",
  "thag1.55:1.2": "ogayha añjanaṃ vanaṃ ",
  "thag1.55:1.3": "tisso vijjā anuppattā ",
  "thag1.55:1.4": "kataṃ buddhassa sāsana’nti. itthaṃ sudaṃ ",
  "thag1.55:1.5": "añjanavaniyo thero gāthaṃ abhāsitthā’ti. "
}
