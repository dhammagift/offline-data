  "thag2.46:0.3": "",
  "thag2.46:0.4": "2. 5. 6. visākhapañcālaputtattheragāthā. ",
  "thag2.46:1.1": "nadanti morā susikhā supekhuṇā ",
  "thag2.46:1.2": "sunīlagīvā sumukhā sugajjino, ",
  "thag2.46:1.3": "susaddalā cāpi mahāmahī ayaṃ ",
  "thag2.46:1.4": "subyāpitambu suvalāhakaṃ nabhaṃ. ",
  "thag2.46:2.1": "sukallarūpo sumanassa jhāya taṃ ",
  "thag2.46:2.2": "sutikkhamo sādhu subuddhasāsane, ",
  "thag2.46:2.3": "susukkasukkaṃ nipuṇaṃ sududdasaṃ ",
  "thag2.46:2.4": "phusāmi taṃ uttamamaccutaṃ padanti. itthaṃ sudaṃ āyasmā ",
  "thag2.46:2.5": "cūḷako thero gāthāyo abhāsitthā’ti. "
}
