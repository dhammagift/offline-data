  "thag2.34:0.3": "",
  "thag2.34:0.4": "2. 4. 4. upavānattheragāthā. ",
  "thag2.34:1.1": "diṭṭhā mayā dhammadharā upāsakā ",
  "thag2.34:1.2": "kāmā aniccā iti bhāsamānā, ",
  "thag2.34:1.3": "sārattarattā maṇikuṇḍalesu ",
  "thag2.34:1.4": "puttesu dāresu ca te apekkhā. ",
  "thag2.34:2.1": "addhā na jānanti yathāva dhammaṃ ",
  "thag2.34:2.2": "kāmā aniccā iti cāpi āhu, ",
  "thag2.34:2.3": "rāgaṃ ca tesaṃ na balatthi chettuṃ ",
  "thag2.34:2.4": "tasmā sitā puttadāraṃ dhanañcā’ti. itthaṃ sudaṃ āyasmā ",
  "thag2.34:2.5": "isidinno thero gāthāyo abhāsitthā’ti. "
}
