{
  "thag16.4:0.1": "",
  "thag16.4:0.2": "",
  "thag16.4:0.3": "",
  "thag16.4:0.4": "20. 1. 4. ",
  "thag16.4:1.1": "passa cittakataṃ bimbaṃ ",
  "thag16.4:1.2": "arukāyaṃ samussitaṃ, ",
  "thag16.4:1.3": "āturaṃ bahusaṅkappaṃ ",
  "thag16.4:1.4": "yassa natthi dhuvaṃ ṭhiti. ",
  "thag16.4:2.1": "passa cittakataṃ rūpaṃ ",
  "thag16.4:2.2": "maṇinā kuṇḍalena ca, ",
  "thag16.4:2.3": "aṭṭhiṃ tacena onaddhaṃ ",
  "thag16.4:2.4": "saha vatthehi sobhati. ",
  "thag16.4:3.1": "alattakakatā pādā ",
  "thag16.4:3.2": "mukhaṃ cuṇṇakamakkhitaṃ, ",
  "thag16.4:3.3": "alaṃ bālassa mohāya ",
  "thag16.4:3.4": "no ca pāragavesino. ",
  "thag16.4:4.1": "aṭṭhapādakatā kesā ",
  "thag16.4:4.2": "nettā añjanamakkhitā, ",
  "thag16.4:4.3": "alaṃ bālassa mohāya ",
  "thag16.4:4.4": "no ca pāragavesino. ",
  "thag16.4:5.1": "añjanīva navā cittā ",
  "thag16.4:5.2": "pūtikāyo alaṅkato, ",
  "thag16.4:5.3": "alaṃ bālassa mohāya ",
  "thag16.4:5.4": "no ca pāragavesino. ",
  "thag16.4:6.1": "odahi migavo pāsaṃ ",
  "thag16.4:6.2": "nāsadā vāguraṃ migo, ",
  "thag16.4:6.3": "bhutvā nivāpaṃ gacchāma ",
  "thag16.4:6.4": "kandante migabandhake. ",
  "thag16.4:7.1": "chinno pāso migavassa ",
  "thag16.4:7.2": "nāsadā vāguraṃ migo, ",
  "thag16.4:7.3": "bhutvā nivāpaṃ gacchāma ",
  "thag16.4:7.4": "socante migaluddake. ",
  "thag16.4:8.1": "passāmi loke sadhane manusse ",
  "thag16.4:8.2": "laddhāna vittaṃ na dadanti mohā, ",
  "thag16.4:8.3": "luddhā dhanaṃ sannicayaṃ karonti ",
  "thag16.4:8.4": "bhiyyo va kāme abhipatthayanti. ",
  "thag16.4:9.1": "rājā pasayha paṭhaviṃ vijetvā ",
  "thag16.4:9.2": "sasāgarantaṃ mahimāvasanto, ",
  "thag16.4:9.3": "oraṃ samuddassa atittarūpo ",
  "thag16.4:9.4": "pāraṃ samuddassa’pi patthayetha. ",
  "thag16.4:10.1": "rājā ca aññe ca bahū manussā ",
  "thag16.4:10.2": "avītataṇhā maraṇaṃ upenti, ",
  "thag16.4:10.3": "ūnāva hutvāna jahanti dehaṃ ",
  "thag16.4:10.4": "kāmehi lokamhi na hatthi titti. ",
  "thag16.4:11.1": "kandanti naṃ ñāti pakiriya kese ",
  "thag16.4:11.2": "aho vatā no amarāti cāhu, ",
  "thag16.4:11.3": "vatthena naṃ pārutaṃ nīharitvā ",
  "thag16.4:11.4": "citaṃ samodhāya tato ḍahanti. ",
  "thag16.4:12.1": "so ḍayhati sūlehi tujjamāno ",
  "thag16.4:12.2": "ekena vatthena pahāya bhoge, ",
  "thag16.4:12.3": "na mīyamānassa bhavanti tāṇā ",
  "thag16.4:12.4": "ñātī ca mittā athavā sahāyā. ",
  "thag16.4:13.1": "dāyādakā tassa dhanaṃ haranti ",
  "thag16.4:13.2": "satto pana gacchati yena kammaṃ, ",
  "thag16.4:13.3": "na mīyamānaṃ dhanamanveti kiñci ",
  "thag16.4:13.4": "puttā ca dārā ca dhanaṃ ca raṭṭhaṃ. ",
  "thag16.4:14.1": "na dīghamāyuṃ labhate dhanena ",
  "thag16.4:14.2": "na cā’pi vittena jaraṃ vihanti, ",
  "thag16.4:14.3": "appaṃ hi taṃ jīvitamāhu dhīrā ",
  "thag16.4:14.4": "asassataṃ vippariṇāmadhammaṃ. ",
  "thag16.4:15.1": "aḍḍhā daḷiddā ca phusanti phassaṃ ",
  "thag16.4:15.2": "bālo ca dhīro ca tatheva phuṭṭho, ",
  "thag16.4:15.3": "bālo hi bālyā vadhito’va seti ",
  "thag16.4:15.4": "dhīro ca no vedhati phassaphuṭṭho. ",
  "thag16.4:16.1": "tasmā hi paññā’va dhanena seyyā ",
  "thag16.4:16.2": "yāya vosānamidhādhigacchati, ",
  "thag16.4:16.3": "abyositattā hi bhavābhavesu, ",
  "thag16.4:16.4": "pāpāni kammāni karoti mohā. ",
  "thag16.4:17.1": "upeti gabbhañca parañca lokaṃ ",
  "thag16.4:17.2": "saṃsāramāpajja paramparāya, ",
  "thag16.4:17.3": "tassappañco abhisaddahanto ",
  "thag16.4:17.4": "upeti gabbhañca parañca lokaṃ. ",
  "thag16.4:18.1": "coro yathā sandhimukhe gahīto ",
  "thag16.4:18.2": "sakammunā haññati pāpadhammo, ",
  "thag16.4:18.3": "evaṃ pajā pacca paramhi loke ",
  "thag16.4:18.4": "sakammunā haññati pāpadhammā. ",
  "thag16.4:19.1": "kāmā hi citrā madhurā manoramā ",
  "thag16.4:19.2": "virūparūpena mathenti cittaṃ, ",
  "thag16.4:19.3": "ādīnavaṃ kāmaguṇesu disvā ",
  "thag16.4:19.4": "tasmā ahaṃ pabbajitomhi rāja. ",
  "thag16.4:20.1": "dumapphalānīva patanti mānavā ",
  "thag16.4:20.2": "daharā ca vuddhā ca sarīrabhedā, ",
  "thag16.4:20.3": "etampi disvā pabbajitomhi rāja ",
  "thag16.4:20.4": "apaṇṇakaṃ sāmaññameva seyyo, ",
  "thag16.4:21.1": "saddhāyāhaṃ pabbajito ",
  "thag16.4:21.2": "upeto jinasāsane, ",
  "thag16.4:21.3": "avañjhā mayhaṃ pabbajjā ",
  "thag16.4:21.4": "anaṇo bhuñjāmi bhojanaṃ. ",
  "thag16.4:22.1": "kāme ādittato disvā ",
  "thag16.4:22.2": "jātarūpāni satthato, ",
  "thag16.4:22.3": "gabbhavokkantito dukkhaṃ ",
  "thag16.4:22.4": "nirayesu mahabbhayaṃ. ",
  "thag16.4:23.1": "etamādīnavaṃ ñatvā ",
  "thag16.4:23.2": "saṃvegaṃ alabhiṃ tadā, ",
  "thag16.4:23.3": "so’haṃ viddho tadā santo ",
  "thag16.4:23.4": "sampatto āsavakkhayaṃ. ",
  "thag16.4:24.1": "pariciṇṇo mayā satthā ",
  "thag16.4:24.2": "kataṃ buddhassa sāsanaṃ, ",
  "thag16.4:24.3": "ohito garuko bhāro ",
  "thag16.4:24.4": "bhavanetti samūhatā. ",
  "thag16.4:25.1": "yassatthāya pabbajito ",
  "thag16.4:25.2": "agārasmānagāriyaṃ, ",
  "thag16.4:25.3": "so me attho anuppatto ",
  "thag16.4:25.4": "sabbasaṃyojanakkhayo’ti. itthaṃ sudaṃ āyasmā ",
  "thag16.4:25.5": "raṭṭhapālo thero gāthāyo abhāsitthā’ti. raṭṭhapālattheragāthā. "
}
