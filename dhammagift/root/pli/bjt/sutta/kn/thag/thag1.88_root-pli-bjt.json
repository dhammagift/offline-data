  "thag1.88:0.4": "1. 9. 8. paviṭṭhattheragāthā. ",
  "thag1.88:1.1": "asakkhiṃ vata attānaṃ ",
  "thag1.88:1.2": "uddhātuṃ udakā jalaṃ ",
  "thag1.88:1.3": "vuyhamāno mahogheva ",
  "thag1.88:1.4": "saccāni paṭivijjhaha’nti. itthaṃ sudaṃ āyasmā ",
  "thag1.88:1.5": "ajjuno thero gāthaṃ abhāsitthā’ti. "
}
