  "thag2.22:0.1": "",
  "thag2.22:0.2": "",
  "thag2.22:0.3": "",
  "thag2.22:0.4": "2. 3. 2. ",
  "thag2.22:1.1": "panādo nāma so rājā ",
  "thag2.22:1.2": "yassa yūpo suvaṇṇayo, ",
  "thag2.22:1.3": "tiriyaṃ soḷasapabbedho ",
  "thag2.22:1.4": "uddhamāhu sahassadhā. ",
  "thag2.22:2.1": "sahassakaṇḍo satabheṇḍu ",
  "thag2.22:2.2": "dhajālū haritāmayo, ",
  "thag2.22:2.3": "anaccuṃ tattha gandhabbā ",
  "thag2.22:2.4": "chasabhassāni sattadhā’ti. ",
  "thag2.22:2.5": "itthaṃ sudaṃ āyasmā bhaddaji thero gāthāyo abhāsitthā’ti. bhaddajittheragāthā. "
}
