  "thag1.13:0.4": "1. 2. 3. ",
  "thag1.13:1.1": "nīlabbhavaṇṇā rucirā ",
  "thag1.13:1.2": "sītavārī sucindharā ",
  "thag1.13:1.3": "indagopakasañchannā ",
  "thag1.13:1.4": "te selā ramayanti ma’nti. itthaṃ sudaṃ āyasmā ",
  "thag1.13:1.5": "vanavaccho thero gāthaṃ abhāsitthā’ti. vanavacchattheragāthā. "
}
