  "thag1.87:0.3": "",
  "thag1.87:0.4": "1. 9. 7. ",
  "thag1.87:1.1": "khandhā diṭṭhā yathābhūtaṃ ",
  "thag1.87:1.2": "bhavā sabbe padālitā ",
  "thag1.87:1.3": "vikkhīṇo jātisaṃsāro ",
  "thag1.87:1.4": "natthi dāni punabbhavo’ti. itthaṃ sudaṃ āyasmā ",
  "thag1.87:1.5": "paviṭṭho thero gāthaṃ abhāsitthā’ti. paviṭṭhattheragāthā. "
}
