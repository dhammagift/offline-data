  "thag1.8:0.4": "1. 1. 8. ",
  "thag1.8:1.1": "yo duddamiyo damena danto ",
  "thag1.8:1.2": "vīro santusito vitiṇṇakaṃkho ",
  "thag1.8:1.3": "vijitāvī apetalomahaṃso ",
  "thag1.8:1.4": "vīro so parinibbuto ṭhitatto’ti. ",
  "thag1.8:1.5": "itthaṃ sudaṃ āyasmā vīro thero gāthaṃ abhāsitthā’ti. vīrattheragāthā. "
}
