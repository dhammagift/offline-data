  "thag1.103:0.4": "1. 11. 3. ",
  "thag1.103:1.1": "nāhaṃ etena atthiko ",
  "thag1.103:1.2": "sukhito dhammarasena tappito, ",
  "thag1.103:1.3": "pītvāna rasaggamuttamaṃ ",
  "thag1.103:1.4": "na ca kāhāmi visena santhava’nti. itthaṃ sudaṃ āyasmā ",
  "thag1.103:1.5": "bandhuro thero gāthaṃ abhāsitthā’ti. bandhurattheragāthā. "
}
