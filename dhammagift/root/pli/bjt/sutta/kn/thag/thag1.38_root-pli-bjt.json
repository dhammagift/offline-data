  "thag1.38:0.4": "1. 4. 8. kumāputtasahāyakattheragāthā. ",
  "thag1.38:1.1": "yo iddhiyā sarabhuṃ aṭṭhapesi ",
  "thag1.38:1.2": "so gavampati asito anejo ",
  "thag1.38:1.3": "taṃ sabbasaṅgātigataṃ mahāmuniṃ ",
  "thag1.38:1.4": "devā namassanti bhavassa pāragu’nti. itthaṃ sudaṃ āyasmā ",
  "thag1.38:1.5": "gavampatitthero gāthaṃ abhāsitthā’ti. "
}
