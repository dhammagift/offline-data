  "thag2.17:0.3": "",
  "thag2.17:0.4": "2. 2. 7. mahākāḷattheragāthā. ",
  "thag2.17:1.1": "bahū sapatte labhati ",
  "thag2.17:1.2": "muṇḍo saṅghāṭipāruto, ",
  "thag2.17:1.3": "lābhī annassa pānassa ",
  "thag2.17:1.4": "vatthassa sayanassa ca. ",
  "thag2.17:2.1": "etamādīnavaṃ ñatvā ",
  "thag2.17:2.2": "sakkāresu mahabbhayaṃ, ",
  "thag2.17:2.3": "appalābho ‘navassuto ",
  "thag2.17:2.4": "sato bhikkhu paribbaje’ti. itthaṃ sudaṃ āyasmā ",
  "thag2.17:2.5": "tisso thero gāthāyo abhāsitthā’ti. "
}
