  "thag1.16:0.4": "1. 2. 6. kuṇḍadhānattheragāthā. ",
  "thag1.16:1.1": "yathā pi bhaddo ājañño ",
  "thag1.16:1.2": "naṅgalāvattanī sikhī ",
  "thag1.16:1.3": "gacchati appakasirena ",
  "thag1.16:1.4": "evaṃ rattindivā mama ",
  "thag1.16:1.5": "gacchati appakasirena ",
  "thag1.16:1.6": "sukhe laddhe nirāmise’ti. ",
  "thag1.16:1.7": "itthaṃ sudaṃ āyasmā bellaṭṭhisīso thero gāthaṃ abhāsitthā’ti. "
}
