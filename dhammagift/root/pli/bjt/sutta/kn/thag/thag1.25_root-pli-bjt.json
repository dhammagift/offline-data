  "thag1.25:0.4": "1. 3. 5. sugandhattheragāthā. ",
  "thag1.25:1.1": "obhāsajātaṃ phalagaṃ ",
  "thag1.25:1.2": "cittaṃ yassa abhiṇhaso ",
  "thag1.25:1.3": "tādisaṃ bhikkhumāsajja ",
  "thag1.25:1.4": "kaṇha dukkhaṃ nigacchasī’ti. itthaṃ sudaṃ āyasmā ",
  "thag1.25:1.5": "nandiyo thero gāthaṃ abhāsitthā’ti. "
}
