{
  "thag15.2:0.1": "",
  "thag15.2:0.2": "",
  "thag15.2:0.3": "",
  "thag15.2:0.4": "16. 1. 2. ",
  "thag15.2:1.1": "manussabhūtaṃ sambuddhaṃ ",
  "thag15.2:1.2": "attadantaṃ samāhitaṃ, ",
  "thag15.2:1.3": "iriyamānaṃ brahmapathe ",
  "thag15.2:1.4": "cittassūpasame rataṃ. ",
  "thag15.2:2.1": "yaṃ manussā namassanti ",
  "thag15.2:2.2": "sabbadhammāna pāraguṃ, ",
  "thag15.2:2.3": "devā’pi taṃ namassanti ",
  "thag15.2:2.4": "iti me arahato sutaṃ. ",
  "thag15.2:3.1": "sabbasaṃyojanātītaṃ ",
  "thag15.2:3.2": "vanā nibbanamāgataṃ, ",
  "thag15.2:3.3": "kāmehi nekkhammarataṃ ",
  "thag15.2:3.4": "muttaṃ selā’va kañcanaṃ. ",
  "thag15.2:4.1": "sa ve accantaruci nāgo ",
  "thag15.2:4.2": "himavā caññe siluccaye, ",
  "thag15.2:4.3": "sabbesaṃ nāganāmānaṃ ",
  "thag15.2:4.4": "saccanāmo anuttaro. ",
  "thag15.2:5.1": "nāgaṃ vo kittayissāmi ",
  "thag15.2:5.2": "na hi āguṃ karoti so, ",
  "thag15.2:5.3": "soraccaṃ avihiṃsā ca ",
  "thag15.2:5.4": "pādā nāgassa te duve. ",
  "thag15.2:6.1": "sati ca sampajaññaṃ ca ",
  "thag15.2:6.2": "caraṇā nāgassa te pare, ",
  "thag15.2:6.3": "saddhāhattho mahānāgo ",
  "thag15.2:6.4": "upekkhāsetadantavā. ",
  "thag15.2:7.1": "sati gīvā siro paññā ",
  "thag15.2:7.2": "vīmaṃsā dhammacintanā, ",
  "thag15.2:7.3": "dhammakucchisamāvāso ",
  "thag15.2:7.4": "viveko tassa vāladhi. ",
  "thag15.2:8.1": "so jhāyī assāsarato ",
  "thag15.2:8.2": "ajjhattaṃ susamāhito, ",
  "thag15.2:8.3": "gacchaṃ samāhito nāgo ",
  "thag15.2:8.4": "ṭhito nāgo samāhito. ",
  "thag15.2:9.1": "sayaṃ samāhito nāgo ",
  "thag15.2:9.2": "nisinno’pi samāhito, ",
  "thag15.2:9.3": "sabbattha saṃvuto nāgo ",
  "thag15.2:9.4": "esā nāgassa sampadā. ",
  "thag15.2:10.1": "bhuñjati anavajjāni ",
  "thag15.2:10.2": "sāvajjāni na bhuñjati, ",
  "thag15.2:10.3": "ghāsamacchādanaṃ laddhā ",
  "thag15.2:10.4": "sanni’dhiṃ parivajjayaṃ. ",
  "thag15.2:11.1": "saṃyojanaṃ aṇuṃ thūlaṃ ",
  "thag15.2:11.2": "sabbaṃ chetvāna bandhanaṃ, ",
  "thag15.2:11.3": "yena yeneva gacchati ",
  "thag15.2:11.4": "anapekkhova gacchati. ",
  "thag15.2:12.1": "yathāpi udake jātaṃ ",
  "thag15.2:12.2": "puṇḍarīkaṃ pavaḍḍhati, ",
  "thag15.2:12.3": "nopalippati toyena ",
  "thag15.2:12.4": "sucigandhaṃ manoramaṃ. ",
  "thag15.2:13.1": "tatheva ca loke jāto ",
  "thag15.2:13.2": "buddho loke viharati, ",
  "thag15.2:13.3": "nopalippati lokena ",
  "thag15.2:13.4": "toyena padumaṃ yathā. ",
  "thag15.2:14.1": "mahāgini pajjalito ",
  "thag15.2:14.2": "anāhāropasammati, ",
  "thag15.2:14.3": "aṅgāresu ca santesu ",
  "thag15.2:14.4": "nibbuto’ti pavuccati. ",
  "thag15.2:15.1": "atthassāyaṃ viññāpanī ",
  "thag15.2:15.2": "upamā viññūhi desitā, ",
  "thag15.2:15.3": "viññissanti mahānāgā ",
  "thag15.2:15.4": "nāgaṃ nāgena desitaṃ. ",
  "thag15.2:16.1": "vītarāgo vītadoso ",
  "thag15.2:16.2": "vītamoho anāsavo, ",
  "thag15.2:16.3": "sarīraṃ vijahaṃ nāgo ",
  "thag15.2:16.4": "parinibbissantyanāsavo’ti. itthaṃ sudaṃ āyasmā ",
  "thag15.2:16.5": "udāyī thero ",
  "thag15.2:16.6": "gāthāyo abhāsitthā’ti. udāyittheragāthā. tassuddānaṃ: ",
  "thag15.2:17.0": "",
  "thag15.2:17.1": "koṇḍañño ca udāyī ca ",
  "thag15.2:17.2": "therā dve te mahiddhikā, ",
  "thag15.2:17.3": "soḷasamhi nipātamhi ",
  "thag15.2:17.4": "gāthāyo dve ca tiṃsa cā’ti. soḷasanipāto niṭṭhito. "
}
