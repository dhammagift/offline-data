  "thag1.51:0.3": "",
  "thag1.51:0.4": "1. 6. 1. ",
  "thag1.51:1.1": "vassati devo yathā sugītaṃ ",
  "thag1.51:1.2": "channā me kuṭikā sukhā nivātā ",
  "thag1.51:1.3": "cittaṃ susamāhitaṃ ca mayhaṃ ",
  "thag1.51:1.4": "atha ce patthayasi pavassa devā’ti. itthaṃ sudaṃ āyasmā ",
  "thag1.51:1.5": "godhiko thero gāthaṃ abhāsitthā’ti. godhikattheragāthā. "
}
