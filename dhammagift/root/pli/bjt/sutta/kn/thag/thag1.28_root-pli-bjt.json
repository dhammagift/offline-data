  "thag1.28:0.4": "1. 3. 8. ",
  "thag1.28:1.1": "kacci no vatthapasuto ",
  "thag1.28:1.2": "kacci no bhūsanārato ",
  "thag1.28:1.3": "kacci sīlamayaṃ gandhaṃ ",
  "thag1.28:1.4": "kiṃ tvaṃ vāyasi netarā pajā’ti. itthaṃ sudaṃ āyasmā ",
  "thag1.28:1.5": "jambugāmikaputto thero gāthaṃ abhāsitthā’ti. jambugāmikattheragāthā. "
}
