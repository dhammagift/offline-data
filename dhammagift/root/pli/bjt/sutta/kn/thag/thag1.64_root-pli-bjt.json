  "thag1.64:0.4": "1. 7. 4. pakkhattheragāthā. ",
  "thag1.64:1.1": "dumavhayāya uppanno ",
  "thag1.64:1.2": "jāto paṇḍaraketunā ",
  "thag1.64:1.3": "ketuhā ketunāyeva ",
  "thag1.64:1.4": "mahāketuṃ padhaṃsayīti. ",
  "thag1.64:1.5": "itthaṃ sudaṃ āyasmā vimalo koṇḍañño thero gāthaṃ abhāsitthā’ti. "
}
