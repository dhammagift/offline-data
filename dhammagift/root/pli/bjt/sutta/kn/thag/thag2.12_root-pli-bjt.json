  "thag2.12:0.1": "",
  "thag2.12:0.2": "",
  "thag2.12:0.3": "",
  "thag2.12:0.4": "2. 2. 2. ",
  "thag2.12:1.1": "ye kho te veghamissena ",
  "thag2.12:1.2": "nānatthena ca kammunā ",
  "thag2.12:1.3": "manusse uparundhanti ",
  "thag2.12:1.4": "pharusūpakkamā janā, ",
  "thag2.12:1.5": "tepi tattheva kīranti ",
  "thag2.12:1.6": "nahi kammaṃ panassati. ",
  "thag2.12:2.1": "yaṃ karoti naro kammaṃ ",
  "thag2.12:2.2": "kalyāṇaṃ yadi pāpakaṃ, ",
  "thag2.12:2.3": "tassa tasseva dāyādo ",
  "thag2.12:2.4": "yaṃ yaṃ kammaṃ pakubbatī’ti. itthaṃ sudaṃ āyasmā ",
  "thag2.12:2.5": "jotidāso thero gāthāyo abhāsitthā’ti. jotidāsattheragāthā. "
}
