  "thag1.26:0.4": "1. 3. 6. ",
  "thag1.26:1.1": "sutvā subhāsitaṃ vācaṃ ",
  "thag1.26:1.2": "buddhassādiccabandhuno ",
  "thag1.26:1.3": "paccavyadhiṃ hi nipuṇaṃ ",
  "thag1.26:1.4": "vālaggaṃ usunā yathā’ti. ",
  "thag1.26:1.5": "itthaṃ sudaṃ āyasmā ubhayo thero gāthaṃ abhāsitthā’ti. ubhayattheragāthā. "
}
