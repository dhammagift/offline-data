{
  "thag16.9:0.1": "",
  "thag16.9:0.2": "",
  "thag16.9:0.3": "",
  "thag16.9:0.4": "20. 1. 9. ",
  "thag16.9:1.1": "pahāya mātāpitaro ",
  "thag16.9:1.2": "bhaginī ñātibhātaro, ",
  "thag16.9:1.3": "pañcakāmaguṇe hitvā ",
  "thag16.9:1.4": "anuruddho’va jhāyatu. ",
  "thag16.9:2.1": "sameto naccagītehi ",
  "thag16.9:2.2": "sammatāḷappabodhano, ",
  "thag16.9:2.3": "na tena suddhimajjhagaṃ ",
  "thag16.9:2.4": "mārassa visaye rato. ",
  "thag16.9:3.1": "etaṃ ca samatikkamma ",
  "thag16.9:3.2": "rato buddhassa sāsane, ",
  "thag16.9:3.3": "sabboghaṃ samatikkamma ",
  "thag16.9:3.4": "anuruddho’va jhāyati. ",
  "thag16.9:4.1": "rūpā saddā rasā gandhā ",
  "thag16.9:4.2": "phoṭṭhabbā ca manoramā’ ",
  "thag16.9:4.3": "ete ca samatikkamma ",
  "thag16.9:4.4": "anuruddho’va jhāyati. ",
  "thag16.9:5.1": "piṇḍapātā paṭikkanto ",
  "thag16.9:5.2": "eko adutiyo muni, ",
  "thag16.9:5.3": "esati paṃsukūlāni ",
  "thag16.9:5.4": "anuruddho anāsavo. ",
  "thag16.9:6.1": "vicinī aggahī dhovī ",
  "thag16.9:6.2": "rajayī dhārayī muni, ",
  "thag16.9:6.3": "paṃsukūlāni matimā ",
  "thag16.9:6.4": "anuruddho anāsavo. ",
  "thag16.9:7.1": "mahiccho ca asantuṭṭho ",
  "thag16.9:7.2": "saṃsaṭṭho yo ca uddhato, ",
  "thag16.9:7.3": "tassa dhammā ime honti ",
  "thag16.9:7.4": "pāpakā saṅkilesikā. ",
  "thag16.9:8.1": "sato ca hoti appiccho ",
  "thag16.9:8.2": "santuṭṭho avighātavā, ",
  "thag16.9:8.3": "pavivekarato vitto ",
  "thag16.9:8.4": "niccamāraddhavīriyo. ",
  "thag16.9:9.1": "tassa dhamma ime honti ",
  "thag16.9:9.2": "kusalā bodhipakkhikā, ",
  "thag16.9:9.3": "anāsavo ca so hoti ",
  "thag16.9:9.4": "iti vuttaṃ mahesinā. ",
  "thag16.9:10.1": "mama saṅkappamaññāya ",
  "thag16.9:10.2": "satthā loke anuttaro, ",
  "thag16.9:10.3": "manomayena kāyena ",
  "thag16.9:10.4": "iddhiyā upasaṅkami. ",
  "thag16.9:11.1": "yadā me ahu saṅkappo ",
  "thag16.9:11.2": "tato uttari desayi, ",
  "thag16.9:11.3": "nippapañcarato buddho ",
  "thag16.9:11.4": "nippapañcamadesayi. ",
  "thag16.9:12.1": "tasmāhaṃ dhammamaññāya ",
  "thag16.9:12.2": "vihāsiṃ sāsane rato, ",
  "thag16.9:12.3": "tisso vijjā anuppattā ",
  "thag16.9:12.4": "kataṃ buddhassa sāsanaṃ. ",
  "thag16.9:13.1": "pañcapaññāsavassāni ",
  "thag16.9:13.2": "yato nesajjiko ahaṃ, ",
  "thag16.9:13.3": "pañcavīsativassāni ",
  "thag16.9:13.4": "yato middhaṃ samūhataṃ. ",
  "thag16.9:14.1": "nāhu assāsapassāsā ",
  "thag16.9:14.2": "ṭhitacittassa tādino, ",
  "thag16.9:14.3": "anejo santimārabbha ",
  "thag16.9:14.4": "cakkhumā parinibbuto. ",
  "thag16.9:15.1": "asallīnena cittena ",
  "thag16.9:15.2": "vedanaṃ ajjhavāsayī, ",
  "thag16.9:15.3": "pajjotasseva nibbānaṃ ",
  "thag16.9:15.4": "vimokkho cetaso ahu. ",
  "thag16.9:16.1": "ete pacchimikā dāni ",
  "thag16.9:16.2": "munino phassapañcamā, ",
  "thag16.9:16.3": "nāññe dhammā bhavissanti ",
  "thag16.9:16.4": "samubaddhe parinibbute. ",
  "thag16.9:17.1": "natthi dāni punāvāso ",
  "thag16.9:17.2": "devakāyamhi jālini, ",
  "thag16.9:17.3": "vikkhīṇo jātisaṃsāro ",
  "thag16.9:17.4": "natthi dāni punabbhavo. ",
  "thag16.9:18.1": "yassa muhuttena sahassadhā ",
  "thag16.9:18.2": "loko saṃvidito sabrahmakappo, ",
  "thag16.9:18.3": "vasī iddhiguṇe cutūpapāte ",
  "thag16.9:18.4": "kāle passati devatā sa bhikkhu. ",
  "thag16.9:19.1": "annabhāro pure āsiṃ ",
  "thag16.9:19.2": "daḷiddo ghāsahārako, ",
  "thag16.9:19.3": "samaṇaṃ paṭipādesiṃ ",
  "thag16.9:19.4": "upariṭṭhaṃ yasassinaṃ. ",
  "thag16.9:20.1": "somhi sakyakule jāto ",
  "thag16.9:20.2": "anuruddho’ti maṃ vidū, ",
  "thag16.9:20.3": "upeto naccagītehi ",
  "thag16.9:20.4": "sammatāḷappabodhano. ",
  "thag16.9:21.1": "athaddasāsiṃ sambuddhaṃ ",
  "thag16.9:21.2": "satthāraṃ akutobhayaṃ, ",
  "thag16.9:21.3": "tasmiṃ cittaṃ pasādetvā ",
  "thag16.9:21.4": "pabbajiṃ anagāriyaṃ. ",
  "thag16.9:22.1": "pubbenivāsaṃ jānāmi ",
  "thag16.9:22.2": "yattha me vusitaṃ pure, ",
  "thag16.9:22.3": "tāvatiṃsesu devesu ",
  "thag16.9:22.4": "aṭṭhāsiṃ satajātiyā. ",
  "thag16.9:23.1": "sattakkhattuṃ manussindo ",
  "thag16.9:23.2": "ahaṃ rajjamakārayiṃ, ",
  "thag16.9:23.3": "cāturanto vijitāvī ",
  "thag16.9:23.4": "jambusaṇḍassa issaro, ",
  "thag16.9:23.5": "adaṇḍena asatthena ",
  "thag16.9:23.6": "dhammena anusāsayiṃ. ",
  "thag16.9:24.1": "ito satta tato satta ",
  "thag16.9:24.2": "saṃsārāni catuddasa, ",
  "thag16.9:24.3": "nivāsamabhijānissaṃ ",
  "thag16.9:24.4": "devaloke ṭhito tadā. ",
  "thag16.9:25.1": "pañcaṅgike samādhimhi ",
  "thag16.9:25.2": "sante ekodibhāvite, ",
  "thag16.9:25.3": "paṭippassaddhiladdhamhi ",
  "thag16.9:25.4": "dibbacakkhu visujjhi me. ",
  "thag16.9:26.1": "cutūpapātaṃ jānāmi ",
  "thag16.9:26.2": "sattānaṃ āgatiṃ gatiṃ, ",
  "thag16.9:26.3": "itthabhāvaññathābhāvaṃ ",
  "thag16.9:26.4": "jhāne pañcaṅgike ṭhito. ",
  "thag16.9:27.1": "pariciṇṇo mayā satthā ",
  "thag16.9:27.2": "kataṃ buddhassa sāsanaṃ, ohito garuko bhāro ",
  "thag16.9:27.3": "",
  "thag16.9:27.4": "bhavanetti samūhatā. ",
  "thag16.9:28.1": "vajjīnaṃ veḷuvagāme ",
  "thag16.9:28.2": "ahaṃ jīvitasaṅkhayā, ",
  "thag16.9:28.3": "heṭṭhato veḷugumbasmiṃ ",
  "thag16.9:28.4": "nibbāyissaṃ anāsavo’ti. itthaṃ sudaṃ āyasmā ",
  "thag16.9:28.5": "anuruddho thero gāthāyo abhāsitthā’ti. anuruddhattheragāthā. "
}
