  "thag1.27:0.4": "1. 3. 7. ",
  "thag1.27:1.1": "dabbaṃ kusaṃ poṭakilaṃ ",
  "thag1.27:1.2": "usīraṃ muñjababbajaṃ ",
  "thag1.27:1.3": "urasā panudissāmi ",
  "thag1.27:1.4": "vivekamanubrūhaya’nti. itthaṃ sudaṃ āyasmā ",
  "thag1.27:1.5": "lomasakaṅgiyo thero gāthaṃ abhāsitthā’ti. lomasakaṅgiyattheragāthā. "
}
