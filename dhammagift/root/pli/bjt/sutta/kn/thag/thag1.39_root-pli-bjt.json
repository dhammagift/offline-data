  "thag1.39:0.4": "1. 4. 9. ",
  "thag1.39:1.1": "sattiyā viya omaṭṭho ",
  "thag1.39:1.2": "ḍayhamāno’va matthake ",
  "thag1.39:1.3": "kāmarāgappahānāya ",
  "thag1.39:1.4": "sato bhikkhu paribbaje’ti. itthaṃ sudaṃ āyasmā ",
  "thag1.39:1.5": "tisso thero gāthaṃ abhāsitthā’ti. tissattheragāthā. "
}
