  "thag1.17:0.4": "1. 2. 7. ",
  "thag1.17:1.1": "middhi yadā hoti mahagghaso ca ",
  "thag1.17:1.2": "niddāyitā samparivattasāyī ",
  "thag1.17:1.3": "mahāvarāho’va nivāpapuṭṭho ",
  "thag1.17:1.4": "punappunaṃ gabbhamupeti mando’ti. itthaṃ sudaṃ āyasmā ",
  "thag1.17:1.5": "dāsako thero gāthaṃ abhāsitthā’ti. dāsakattheragāthā. "
}
