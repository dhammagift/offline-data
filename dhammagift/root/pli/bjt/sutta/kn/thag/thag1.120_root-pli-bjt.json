  "thag1.120:0.2": "",
  "thag1.120:0.3": "",
  "thag1.120:0.4": "1. 12. 10. vajjiputtattheragāthā. ",
  "thag1.120:1.1": "pañcakkhandhā pariññātā tiṭṭhanti chinnamūlakā, dukkhakkhayo anuppatto patto me āsavakkhayo’ti. itthaṃ sudaṃ āyasmā isidatto thero gāthaṃ abhāsitthā’ti. ",
  "thag1.120:1.2": "",
  "thag1.120:1.3": "",
  "thag1.120:1.4": "",
  "thag1.120:1.5": "",
  "thag1.120:1.6": "isidattattheragāthā. vaggo dvādasamo. ",
  "thag1.120:2.0": "tassuddānaṃ: ",
  "thag1.120:2.1": "jento ca vacchagotto ca ",
  "thag1.120:2.2": "vaccho ca vanasavhayo, ",
  "thag1.120:2.3": "adhimutto mahānāmo ",
  "thag1.120:2.4": "pārāsariyo yaso pi ca, ",
  "thag1.120:2.5": "kimbilo vajjiputto ca ",
  "thag1.120:2.6": "isidatto mahāyaso’ti. ",
  "thag1.120:2.7": "",
  "thag1.120:3.0": "tatruddānaṃ: ",
  "thag1.120:3.1": "vīsuttarasataṃ therā ",
  "thag1.120:3.2": "katakiccā anāsavā, ",
  "thag1.120:3.3": "ekakeva nipātamhi ",
  "thag1.120:3.4": "susaṅgītā mahesibhī’ti. ekakanipāto niṭṭhito. "
}
