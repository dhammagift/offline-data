  "thag2.26:0.3": "",
  "thag2.26:0.4": "2. 3. 6. vītasokattheragāthā. ",
  "thag2.26:1.1": "pañcanīvaraṇe hitvā ",
  "thag2.26:1.2": "yogakkhemassa pattiyā, ",
  "thag2.26:1.3": "dhammādāsaṃ gahetvāna ",
  "thag2.26:1.4": "ñāṇadassanamattano. ",
  "thag2.26:2.1": "paccavekkhiṃ imaṃ kāyaṃ ",
  "thag2.26:2.2": "sabbaṃ santarabāhiraṃ, ",
  "thag2.26:2.3": "ajjhattañca bahiddhā ca ",
  "thag2.26:2.4": "tuccho kāyo adissathā’ti. itthaṃ sudaṃ āyasmā ",
  "thag2.26:2.5": "puṇṇamāso thero gāthāyo abhāsitthā’ti. "
}
