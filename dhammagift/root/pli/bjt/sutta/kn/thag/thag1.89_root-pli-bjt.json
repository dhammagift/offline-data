  "thag1.89:0.3": "",
  "thag1.89:0.4": "1. 9. 9. ajjunattheragāthā. ",
  "thag1.89:1.1": "uttiṇṇā paṅkapalipā ",
  "thag1.89:1.2": "pātālā parivajjitā, ",
  "thag1.89:1.3": "muttā oghā ca ganthā ca ",
  "thag1.89:1.4": "sabbe mānā visaṃhatā’ti. itthaṃ sudaṃ āyasmā ",
  "thag1.89:1.5": "devasabho thero gāthaṃ abhāsitthā’ti. "
}
