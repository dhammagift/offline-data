  "thag1.9:0.3": "",
  "thag1.9:0.4": "1. 1. 9. vīrattheragāthā. ",
  "thag1.9:1.1": "svāgataṃ na durāgataṃ ",
  "thag1.9:1.2": "nayidaṃ dumantitaṃ mama ",
  "thag1.9:1.3": "saṃvibhattesu dhammesu ",
  "thag1.9:1.4": "yaṃ seṭṭhaṃ tadupāgaminti. ",
  "thag1.9:1.5": "itthaṃ sudaṃ āyasmā piḷindavaccho thero gāthaṃ abhāsitthā’ti. "
}
