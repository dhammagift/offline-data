  "thag4.11:0.3": "",
  "thag4.11:0.4": "4. 1. 11. dhammikattheragāthā. ",
  "thag4.11:1.1": "yadā balākā sucipaṇḍaracchadā ",
  "thag4.11:1.2": "kāḷassa meghassa bhayena tajjitā, ",
  "thag4.11:1.3": "palehiti ālayamālayesinī ",
  "thag4.11:1.4": "tadā nadī ajakaraṇī rameti maṃ. ",
  "thag4.11:2.1": "yadā balākā suvisuddhapaṇḍarā ",
  "thag4.11:2.2": "kāḷassa meghassa bhayena tajjitā, ",
  "thag4.11:2.3": "pariyesati leṇamaleṇadassinī ",
  "thag4.11:2.4": "tadā nadī ajakaraṇī rameti maṃ. ",
  "thag4.11:3.1": "kaṃ nu tattha na ramenti ",
  "thag4.11:3.2": "jambuyo ubhato tahiṃ, ",
  "thag4.11:3.3": "sobhenti āpagākūlaṃ ",
  "thag4.11:3.4": "mama leṇassa pacchato. ",
  "thag4.11:4.1": "tā matamadasaṅghasuppahīnā ",
  "thag4.11:4.2": "bhekā mandavatī panādayanti, ",
  "thag4.11:4.3": "nājja girinadīhi vippavāsasamayo ",
  "thag4.11:4.4": "khemā ajakaraṇī sivā surammā’ti. itthaṃ sudaṃ āyasmā ",
  "thag4.11:4.5": "sappako thero gāthāyo abhāsitthā’ti. "
}
