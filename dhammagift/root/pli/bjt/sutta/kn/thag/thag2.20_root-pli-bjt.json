  "thag2.20:0.3": "",
  "thag2.20:0.4": "2. 2. 10. ",
  "thag2.20:1.1": "pare ca naṃ pasaṃsanti ",
  "thag2.20:1.2": "attā ce asamāhito, ",
  "thag2.20:1.3": "moghaṃ pare pasaṃsanti ",
  "thag2.20:1.4": "attā hi asamāhito. ",
  "thag2.20:2.1": "pare ca naṃ garahanti ",
  "thag2.20:2.2": "attā ce susamāhi, ",
  "thag2.20:2.3": "moghaṃ pare garahanti ",
  "thag2.20:2.4": "attā hi susamāhito’ti. itthaṃ sudaṃ āyasmā ",
  "thag2.20:2.5": "sirimā thero gāthāyo abhāsitthā’ti. sirimāttheragāthā. ",
  "thag2.20:2.6": "vaggo dutiyo. ",
  "thag2.20:3.0": "tassuddānaṃ: ",
  "thag2.20:3.1": "cundo ca jotidāso ca ",
  "thag2.20:3.2": "thero heraññakāni ca, ",
  "thag2.20:3.3": "somamitto sabbamitto ",
  "thag2.20:3.4": "kālo tisso ca kimbilo ",
  "thag2.20:3.5": "nando ca sirimā ceva ",
  "thag2.20:3.6": "dasa therā mahiddhikā’ti. vaggo tatiyo. "
}
