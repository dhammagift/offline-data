  "thag2.20:0.4": "2. 2. 10. nandattheragāthā. ",
  "thag2.20:1.1": "pare ca naṃ pasaṃsanti attā ce asamāhito, moghaṃ pare pasaṃsanti attā hi asamāhito. pare ca naṃ garahanti attā ce susamāhi, moghaṃ pare garahanti attā hi susamāhito’ti. itthaṃ sudaṃ āyasmā sirimā thero gāthāyo abhāsitthā’ti. ",
  "thag2.20:1.2": "",
  "thag2.20:1.3": "",
  "thag2.20:1.4": "",
  "thag2.20:2.1": "",
  "thag2.20:2.2": "",
  "thag2.20:2.3": "",
  "thag2.20:2.4": "",
  "thag2.20:2.5": "",
  "thag2.20:2.6": "sirimāttheragāthā. vaggo dutiyo. ",
  "thag2.20:3.0": "tassuddānaṃ: ",
  "thag2.20:3.1": "cundo ca jotidāso ca ",
  "thag2.20:3.2": "thero heraññakāni ca, ",
  "thag2.20:3.3": "somamitto sabbamitto ",
  "thag2.20:3.4": "kālo tisso ca kimbilo ",
  "thag2.20:3.5": "nando ca sirimā ceva ",
  "thag2.20:3.6": "dasa therā mahiddhikā’ti. "
}
