  "thag5.3:0.1": "",
  "thag5.3:0.2": "",
  "thag5.3:0.3": "",
  "thag5.3:0.4": "5. 1. 3. subhūtattheragāthā. ",
  "thag5.3:1.1": "vassati devo yathā sugītaṃ ",
  "thag5.3:1.2": "channā me kuṭikā sukhā nivātā, ",
  "thag5.3:1.3": "tassaṃ viharāmi vūpasanto ",
  "thag5.3:1.4": "atha ve patthayasī pavassa deva. ",
  "thag5.3:2.1": "vassati devo yathā sugītaṃ ",
  "thag5.3:2.2": "channā me kuṭikā sukhā nivātā, ",
  "thag5.3:2.3": "tassaṃ viharāmi santacitto ",
  "thag5.3:2.4": "atha ve patthayasī pavassa deva. ",
  "thag5.3:3.1": "vassati devo ",
  "thag5.3:3.2": "yathā sugītaṃ channā me kuṭikā sukhā nivātā, ",
  "thag5.3:3.3": "tassaṃ viharāmi vītarāgo ",
  "thag5.3:3.4": "atha ve patthayasī pavassa deva. ",
  "thag5.3:4.1": "vassati devo ",
  "thag5.3:4.2": "yathā sugītaṃ channā me kuṭikā sukhā nivātā, ",
  "thag5.3:4.3": "tassaṃ viharāmi vītadoso ",
  "thag5.3:4.4": "atha ve patthayasī pavassa deva. ",
  "thag5.3:5.1": "vassati devo ",
  "thag5.3:5.2": "yathā sugītaṃ channā me kuṭikā sukhā nivātā, ",
  "thag5.3:5.3": "tassaṃ viharāmi vītamoho ",
  "thag5.3:5.4": "atha ve patthayasī pavassa deva. itthaṃ sudaṃ āyasmā ",
  "thag5.3:5.5": "girimānando thero gāthāyo abhāsitthā’ti. "
}
