  "thag3.14:0.3": "",
  "thag3.14:0.4": "3. 1. 14. abhibhūtattheragāthā. ",
  "thag3.14:1.1": "saṃsaraṃ hi nirayaṃ agacchisaṃ ",
  "thag3.14:1.2": "petalokamagamaṃ punappunaṃ, ",
  "thag3.14:1.3": "dukkhamamhi pi tiracchānayoniyaṃ ",
  "thag3.14:1.4": "nekadhā hi vusitaṃ ciraṃ mayā. ",
  "thag3.14:2.1": "mānuso pi ca bhavobhirādhito ",
  "thag3.14:2.2": "saggakāyamagamaṃ sakiṃ sakiṃ, ",
  "thag3.14:2.3": "rūpadhātusu arūpadhātusu ",
  "thag3.14:2.4": "nevasaññisu asaññīsuṭṭhitaṃ. ",
  "thag3.14:3.1": "sambhavā suviditā asārakā ",
  "thag3.14:3.2": "saṅkhatā pacalitā saderitā, ",
  "thag3.14:3.3": "taṃ viditvā mahamattasambhavaṃ, ",
  "thag3.14:3.4": "santimeva satimā samajjhaga’nti. itthaṃ sudaṃ āyasmā ",
  "thag3.14:3.5": "gotamo thero gāthāyo abhāsitthā’ti. "
}
