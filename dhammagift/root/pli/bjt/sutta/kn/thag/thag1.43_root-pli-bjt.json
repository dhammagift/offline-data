  "thag1.43:0.3": "",
  "thag1.43:0.4": "1. 5. 3. khadiravaniyarevatattheragāthā. ",
  "thag1.43:1.1": "sumuttiko sumuttiko ",
  "thag1.43:1.2": "sāhu sumuttikomhi tīhi khujjakehi ",
  "thag1.43:1.3": "asitāsu mayā naṅgalāsu mayā ",
  "thag1.43:1.4": "kuddālāsu mayā ",
  "thag1.43:1.5": "yadipi idhameva idhameva ",
  "thag1.43:1.6": "athavā pi alameva alameva ",
  "thag1.43:1.7": "jhāya sumaṅgala jhāya sumaṅgala ",
  "thag1.43:1.8": "appamatto vihara sumaṅgalā’ti. itthaṃ sudaṃ āyasmā ",
  "thag1.43:1.9": "sumaṅgalo thero gāthaṃ abhāsitthā’ti. "
}
