  "thag1.81:0.3": "",
  "thag1.81:0.4": "1. 9. 1. ",
  "thag1.81:1.1": "yaṃ mayā pakataṃ pāpaṃ ",
  "thag1.81:1.2": "pubbe aññāsu jātisu ",
  "thag1.81:1.3": "idheva taṃ vedanīyaṃ ",
  "thag1.81:1.4": "vatthu aññaṃ na vijjatī’ti. itthaṃ sudaṃ āyasmā ",
  "thag1.81:1.5": "samitigutto thero gāthaṃ abhāsitthā’ti. "
}
