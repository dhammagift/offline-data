  "thag1.91:0.3": "",
  "thag1.91:0.4": "1. 10. 1. ",
  "thag1.91:1.1": "na tathā’ mataṃ satarasaṃ ",
  "thag1.91:1.2": "sudhannaṃ yaṃ mayajja paribhuttaṃ, ",
  "thag1.91:1.3": "aparimita dassinā gotamena ",
  "thag1.91:1.4": "buddhena desito dhammo’ti. itthaṃ sudaṃ āyasmā ",
  "thag1.91:1.5": "paripuṇṇako thero gāthaṃ abhāsitthā’ti. paripuṇṇakattheragāthā. "
}
