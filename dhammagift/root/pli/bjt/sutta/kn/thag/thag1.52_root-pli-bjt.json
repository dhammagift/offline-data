  "thag1.52:0.4": "1. 6. 2. ",
  "thag1.52:1.1": "vassati devo yathā sugītaṃ ",
  "thag1.52:1.2": "channā me kuṭikā sukhā nivātā ",
  "thag1.52:1.3": "cittaṃ susamāhitaṃ ca kāye ",
  "thag1.52:1.4": "atha ce patthayasi pavassa devā’ti. itthaṃ sudaṃ āyasmā ",
  "thag1.52:1.5": "subāhutthero gāthaṃ abhāsitthā’ti. subāhuttheragāthā. "
}
