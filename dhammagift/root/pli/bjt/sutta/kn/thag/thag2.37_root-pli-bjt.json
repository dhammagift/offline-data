  "thag2.37:0.3": "",
  "thag2.37:0.4": "2. 4. 7. ",
  "thag2.37:1.1": "na tāva supituṃ hoti ",
  "thag2.37:1.2": "ratti nakkhattamālinī, ",
  "thag2.37:1.3": "paṭijaggitumevesā ",
  "thag2.37:1.4": "ratti hoti vijānatā. ",
  "thag2.37:2.1": "hatthikkhandhāvapatitaṃ ",
  "thag2.37:2.2": "kuñjaro ce anukkame, ",
  "thag2.37:2.3": "saṅgāme me mataṃ seyyo ",
  "thag2.37:2.4": "yaṃ ce jīve parājito’ti. itthaṃ sudaṃ āyasmā ",
  "thag2.37:2.5": "soṇo selissariya puttatthero gāthāyo abhāsitthā’ti. selissariyattheragāthā. "
}
