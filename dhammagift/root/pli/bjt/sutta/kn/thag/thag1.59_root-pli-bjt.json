  "thag1.59:0.4": "1. 6. 9. ",
  "thag1.59:1.1": "saddhāyāhaṃ pabbajito ",
  "thag1.59:1.2": "araññe me kuṭikā katā ",
  "thag1.59:1.3": "appamatto ca ātāpī ",
  "thag1.59:1.4": "sampajāno patissato’ti. itthaṃ sudaṃ āyasmā ",
  "thag1.59:1.5": "kosalavihāritthero gāthaṃ abhāsitthā’ti. kosalavihārittheragāthā. "
}
