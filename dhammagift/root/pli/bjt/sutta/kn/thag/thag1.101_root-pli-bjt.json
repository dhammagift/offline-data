{
  "thag1.101:0.1": "ekādasamo vaggo. ",
  "thag1.101:0.2": "",
  "thag1.101:0.3": "",
  "thag1.101:0.4": "1. 11. 1. ",
  "thag1.101:1.1": "hitvā gihittaṃ anavositatto ",
  "thag1.101:1.2": "mukhanaṅgalī odariko kusīto, ",
  "thag1.101:1.3": "mahāvarāho’va nivāpapuṭṭho ",
  "thag1.101:1.4": "punappunaṃ gabbhamupeti mando. itthaṃ sudaṃ āyasmā ",
  "thag1.101:1.5": "belaṭṭhāniko thero gāthaṃ abhāsitthā’ti. "
}
