  "thag2.40:0.3": "",
  "thag2.40:0.4": "2. 4. 10. usabhattheragāthā. ",
  "thag2.40:1.1": "ayamiti kappaṭo kappaṭakuro ",
  "thag2.40:1.2": "acchāya atibharitāya ",
  "thag2.40:1.3": "amataghaṭikāyaṃ dhammakatamatto ",
  "thag2.40:1.4": "katapadaṃ jhānāni ocetuṃ. ",
  "thag2.40:2.1": "mā kho tvaṃ kappaṭa pacālesi ",
  "thag2.40:2.2": "mā taṃ upakaṇṇakamhi tāḷessaṃ, ",
  "thag2.40:2.3": "naha tvaṃ kappaṭa mattamaññāsi ",
  "thag2.40:2.4": "saṅghamajjhamhi pacalāyamāno’ti. itthaṃ sudaṃ āyasmā ",
  "thag2.40:2.5": "kappaṭakuro thero gāthāyo abhāsitthā’ti. ",
  "thag2.40:2.6": "kappaṭakurattheragāthā. vaggo catuttho. ",
  "thag2.40:3.0": "tassuddānaṃ: ",
  "thag2.40:3.1": "migasiro sīvako ca ",
  "thag2.40:3.2": "upavāno ca paṇḍito ",
  "thag2.40:3.3": "isidanno ca kaccāno ",
  "thag2.40:3.4": "khitako ca mahāvasi ",
  "thag2.40:3.5": "selissariyo nisabho ca ",
  "thag2.40:3.6": "usabho kappaṭakuro’ti. vaggo pañcamo. "
}
