  "thag1.82:0.4": "1. 9. 2. ",
  "thag1.82:1.1": "yena yena subhikkhāni ",
  "thag1.82:1.2": "sivāni abhayāni ca ",
  "thag1.82:1.3": "tena puttaka gacchassu ",
  "thag1.82:1.4": "mā sokāpahato bhavā’ti. itthaṃ sudaṃ āyasmā ",
  "thag1.82:1.5": "kassapo thero gāthaṃ abhāsitthā’ti. kassapattheragāthā. "
}
