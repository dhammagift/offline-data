  "thag1.61:0.4": "1. 7. 1. ",
  "thag1.61:1.1": "passati passo passantaṃ ",
  "thag1.61:1.2": "apassantaṃ ca passati ",
  "thag1.61:1.3": "apassanto apassantaṃ ",
  "thag1.61:1.4": "passantaṃ ca na passatī’ti. itthaṃ sudaṃ āyasmā ",
  "thag1.61:1.5": "vappo thero gāthaṃ abhāsitthā’ti. vappattheragāthā. "
}
