  "thag1.97:0.3": "",
  "thag1.97:0.4": "1. 10. 7. khaṇḍasumaṇattheragāthā. ",
  "thag1.97:1.1": "hitvā sataphalaṃ kaṃsaṃ ",
  "thag1.97:1.2": "sovaṇṇaṃ satarājikaṃ, ",
  "thag1.97:1.3": "aggahiṃ mattikāpattaṃ ",
  "thag1.97:1.4": "idaṃ dutiyābhasevana’nti. itthaṃ sudaṃ āyasmā ",
  "thag1.97:1.5": "tisso thero gāthaṃ abhāsitthā’ti. "
}
