  "thag2.7:0.3": "",
  "thag2.7:0.4": "2. 1. 7. ",
  "thag2.7:1.1": "yathā agāraṃ ducchannaṃ ",
  "thag2.7:1.2": "vuṭṭhi samativijjhati, ",
  "thag2.7:1.3": "evaṃ abhāvitaṃ cittaṃ ",
  "thag2.7:1.4": "rāgo samativijjhati. ",
  "thag2.7:2.1": "yathā agāraṃ succhannaṃ ",
  "thag2.7:2.2": "vuṭṭhi na samativijjhati, ",
  "thag2.7:2.3": "evaṃ subhāvitaṃ cittaṃ ",
  "thag2.7:2.4": "rāgo na samativijjhati. itthaṃ sudaṃ āyasmā ",
  "thag2.7:2.5": "rādho thero gāthāyo abhāsitthā’ti. rādhattheragāthā. "
}
