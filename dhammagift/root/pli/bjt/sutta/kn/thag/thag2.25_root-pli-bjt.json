  "thag2.25:0.3": "",
  "thag2.25:0.4": "2. 3. 5. ",
  "thag2.25:1.1": "kese me olikhissa’nti ",
  "thag2.25:1.2": "kappako upasaṅkami, ",
  "thag2.25:1.3": "tato adāsamādāya ",
  "thag2.25:1.4": "sarīraṃ paccavekkhisaṃ. ",
  "thag2.25:2.1": "tuccho kāyo adissittha ",
  "thag2.25:2.2": "andhakāro tamo vyagā, ",
  "thag2.25:2.3": "sabbe coḷā samucchinnā ",
  "thag2.25:2.4": "natthi dāni punabbhavo’ti. itthaṃ sudaṃ āyasmā ",
  "thag2.25:2.5": "vītasoko thero gāthāyo abhāsitthā’ti. vītasokattheragāthā. "
}
