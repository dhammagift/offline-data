  "thag1.20:0.3": "",
  "thag1.20:0.4": "1. 2. 10. ",
  "thag1.20:1.1": "maraṇe me bhayaṃ natthi ",
  "thag1.20:1.2": "nikanti natthi jīvite ",
  "thag1.20:1.3": "sandehaṃ nikkhipissāmi ",
  "thag1.20:1.4": "sampajāno patissato’ti. itthaṃ sudaṃ āyasmā ",
  "thag1.20:1.5": "ajito thero gāthaṃ abhāsitthā’ti. ajitattheragāthā. dutiyo ",
  "thag1.20:1.6": "vaggo. ",
  "thag1.20:2.0": "tassuddānaṃ: ",
  "thag1.20:2.1": "cūḷavaccho mahāvaccho ",
  "thag1.20:2.2": "vanavaccho ca sīvako ",
  "thag1.20:2.3": "kuṇḍadhāno ca belaṭṭhi ",
  "thag1.20:2.4": "dāsako ca tatopari ",
  "thag1.20:2.5": "sigālapitiko thero ",
  "thag1.20:2.6": "kuṇḍalo ca ajito dasā’ti. tatiyo vaggo "
}
