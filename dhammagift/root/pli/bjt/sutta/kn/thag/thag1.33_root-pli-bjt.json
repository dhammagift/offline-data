  "thag1.33:0.4": "1. 4. 3. ",
  "thag1.33:1.1": "yathāpi ekaputtasmiṃ ",
  "thag1.33:1.2": "piyasmiṃ kusalī siyā ",
  "thag1.33:1.3": "evaṃ sabbesu pāṇesu ",
  "thag1.33:1.4": "sabbattha kusalo siyā’ti. itthaṃ sudaṃ āyasmā ",
  "thag1.33:1.5": "sopāko thero gāthaṃ abhāsitthā’ti. sopākattheragāthā. "
}
