  "thag1.34:0.3": "",
  "thag1.34:0.4": "1. 4. 4. ",
  "thag1.34:1.1": "anāsannavarā etā ",
  "thag1.34:1.2": "niccameva vijānatā ",
  "thag1.34:1.3": "gāmā araññamāgamma ",
  "thag1.34:1.4": "tato gehaṃ upāvisiṃ ",
  "thag1.34:1.5": "tato uṭṭhāya pakkamiṃ ",
  "thag1.34:1.6": "anāmantiya posiyo’ti. itthaṃ sudaṃ āyasmā ",
  "thag1.34:1.7": "posiyo thero gāthaṃ abhāsitthā’ti. posiyattheragāthā. "
}
