  "thag1.74:0.4": "1. 8. 4. ",
  "thag1.74:1.1": "kāmacchando ca byāpādo ",
  "thag1.74:1.2": "thīnamiddhaṃ ca bhikkhuno ",
  "thag1.74:1.3": "uddhaccaṃ vicikicchā ca ",
  "thag1.74:1.4": "sabbaso’va na vijjatī’ti. ",
  "thag1.74:1.5": "itthaṃ sudaṃ āyasmā suyāmo thero gāthaṃ abhāsitthā’ti. suyāmattheragāthā. "
}
