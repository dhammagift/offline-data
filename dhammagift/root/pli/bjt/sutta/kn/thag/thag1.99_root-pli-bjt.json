  "thag1.99:0.3": "",
  "thag1.99:0.4": "1. 10. 9. ",
  "thag1.99:1.1": "saddaṃ sutvā sati muṭṭhā ",
  "thag1.99:1.2": "piyanimittaṃ manasikaroto, ",
  "thag1.99:1.3": "sārattacitto vedeti ",
  "thag1.99:1.4": "taṃ ca ajjhosa tiṭṭhati, ",
  "thag1.99:1.5": "tassa vaḍḍhanti āsavā ",
  "thag1.99:1.6": "saṃsāramupagāmino’ti. itthaṃ sudaṃ āyasmā ",
  "thag1.99:1.7": "uttiyo thero gāthaṃ abhāsitthā’ti. uttiyattheragāthā. "
}
