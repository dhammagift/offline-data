{
  "thag2.49:0.1": "",
  "thag2.49:0.2": "",
  "thag2.49:0.3": "",
  "thag2.49:0.4": "2. 5. 9. vajjitattheragāthā. ",
  "thag2.49:1.1": "assatthe haritokāse ",
  "thag2.49:1.2": "saṃvirūḷhampi pādape, ",
  "thag2.49:1.3": "ekaṃ buddhagataṃ saññaṃ ",
  "thag2.49:1.4": "alabhitthaṃ patissato. ",
  "thag2.49:2.1": "ekatiṃse ito kappe ",
  "thag2.49:2.2": "yaṃ saññamalabhiṃ tadā, ",
  "thag2.49:2.3": "tassā saññāya vāhasā ",
  "thag2.49:2.4": "patto me āsavakkhayo’ti. itthaṃ sudaṃ āyasmā ",
  "thag2.49:2.5": "sandhito thero gāthāyo abhāsitthā’ti. ",
  "thag2.49:2.6": "sandhitattheragāthā. vaggo pañcamo. ",
  "thag2.49:3.0": "tassuddānaṃ: ",
  "thag2.49:3.1": "kumārakassapo thero ",
  "thag2.49:3.2": "dhammapālo ca brahmāli, ",
  "thag2.49:3.3": "mogharājā visākho ca ",
  "thag2.49:3.4": "cūḷako ca anūpamo, ",
  "thag2.49:3.5": "vajjito sandhito thero ",
  "thag2.49:3.6": "kilesarajavāhano’ti. ",
  "thag2.49:3.7": "gāthā dukanipātamhi ",
  "thag2.49:4.0": "",
  "thag2.49:4.1": "",
  "thag2.49:4.2": "navuti ceva aṭṭha ca ",
  "thag2.49:4.3": "therā ekūnapaññāsaṃ ",
  "thag2.49:4.4": "bhāsitā nayakovidā’ti. dukanipāto niṭṭhito. "
}
