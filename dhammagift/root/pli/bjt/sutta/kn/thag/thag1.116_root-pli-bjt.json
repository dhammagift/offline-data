  "thag1.116:0.4": "1. 12. 6. ",
  "thag1.116:1.1": "cha phassāyatane hitvā ",
  "thag1.116:1.2": "guttadvāro susaṃvuto, ",
  "thag1.116:1.3": "aghamūlaṃ vamitvāna ",
  "thag1.116:1.4": "patto me āsavakkhayo’ti. ",
  "thag1.116:1.5": "itthaṃ sudaṃ āyasmā pārāsariyatthero gāthaṃ abhāsitthā’ti. pārāsariyattheragāthā. "
}
