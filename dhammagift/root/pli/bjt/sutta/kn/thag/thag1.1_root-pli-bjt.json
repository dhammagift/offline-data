{
  "thag1.1:0.1": "suttantapiṭake theragāthāpāḷi nidānagāthā ",
  "thag1.1:0.2": "",
  "thag1.1:0.3": "",
  "thag1.1:0.4": "",
  "thag1.1:1.0.1": "",
  "thag1.1:1.0.2": "namo tassa bhagavato arahato sammāsambuddhassa ",
  "thag1.1:1.1": "sīhānaṃ’va nadantānaṃ ",
  "thag1.1:1.2": "dāṭhīnaṃ girigabbhare ",
  "thag1.1:1.3": "suṇātha bhāvitattānaṃ ",
  "thag1.1:1.4": "gāthā attūpanāyikā. ",
  "thag1.1:2.1": "yathānāmā yathāgottā ",
  "thag1.1:2.2": "yathādhammavihārino ",
  "thag1.1:2.3": "yathādhimuttā sappaññā ",
  "thag1.1:2.4": "vihariṃsu atanditā. ",
  "thag1.1:3.1": "tattha tattha vipassitvā ",
  "thag1.1:3.2": "phusitvā accutaṃ padaṃ ",
  "thag1.1:3.3": "katantaṃ paccavekkhantā ",
  "thag1.1:3.4": "imamatthamabhāsisuṃ. 1. ekakanipāto paṭhamo vaggo 1. 1. 1. channā me kuṭikā sukhā nivātā vassa deva yathāsukhaṃ cittaṃ me susamāhitaṃ vimuttaṃ ātāpī viharāmi vassa devā’ti. itthaṃ sudaṃ āyasmā subhūtitthero gāthaṃ abhāsitthā’ti. ",
  "thag1.1:4.0": "subhūtittheragāthā. ",
  "thag1.1:4.1": "",
  "thag1.1:4.2": "",
  "thag1.1:4.3": "",
  "thag1.1:4.4": "",
  "thag1.1:4.5": ""
}
