  "thag1.105:0.4": "1. 11. 5. ",
  "thag1.105:1.1": "ukkaṇaṭhitopi na vase ",
  "thag1.105:1.2": "ramamānopi pakkame, ",
  "thag1.105:1.3": "natvevānatthasaṃhitaṃ ",
  "thag1.105:1.4": "vase vāsaṃ vicakkhaṇo’ti. itthaṃ sudaṃ āyasmā ",
  "thag1.105:1.5": "malitavambho thero gāthaṃ abhāsitthā’ti. malitavambhattheragāthā. "
}
