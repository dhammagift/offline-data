  "thag1.106:0.4": "1. 11. 6. ",
  "thag1.106:1.1": "sataliṅgassa atthassa ",
  "thag1.106:1.2": "satalakkhaṇadhārino, ",
  "thag1.106:1.3": "ekaṅgadassī dummedho ",
  "thag1.106:1.4": "satadassī ca paṇḍito’ti. itthaṃ sudaṃ āyasmā ",
  "thag1.106:1.5": "suhemanto thero gāthaṃ abhāsitthā’ti. suhemantattheragāthā. "
}
