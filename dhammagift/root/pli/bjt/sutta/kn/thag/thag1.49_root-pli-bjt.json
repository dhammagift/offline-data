  "thag1.49:0.4": "1. 5. 9. ",
  "thag1.49:1.1": "vihavihābhinadite ",
  "thag1.49:1.2": "sippikābhirutehi ca ",
  "thag1.49:1.3": "na me taṃ phandati cittaṃ ",
  "thag1.49:1.4": "ekattanirataṃ hi me’ti. itthaṃ sudaṃ āyasmā ",
  "thag1.49:1.5": "rāmaṇeyyako thero gāthaṃ abhāsitthā’ti. rāmaṇeyyakattheragāthā. "
}
