  "thag2.16:0.3": "",
  "thag2.16:0.4": "2. 2. 6. ",
  "thag2.16:1.1": "kāḷī itthi brahatī dhaṅkarūpā ",
  "thag2.16:1.2": "satthiṃ ",
  "thag2.16:1.3": "ca bhetvā aparaṃ ca satthiṃ, bāhaṃ ",
  "thag2.16:1.4": "ca bhetvā aparaṃ ca bāhuṃ sīsaṃ ca bhetvā dadhithālakaṃ’ va ",
  "thag2.16:1.5": "esā nisinnā abhisaddahitvā. ",
  "thag2.16:2.1": "yo ve avidvā upadhiṃ karoti ",
  "thag2.16:2.2": "punappunaṃ dukkhamupeti mando, ",
  "thag2.16:2.3": "tasmā pajānaṃ upadhiṃ na kayirā ",
  "thag2.16:2.4": "māhuṃ puna bhinnasiro sayissanti. itthaṃ sudaṃ āyasmā ",
  "thag2.16:2.5": "mahākāḷo thero gāthāyo abhāsitthā’ti. mahākāḷattheragāthā. "
}
