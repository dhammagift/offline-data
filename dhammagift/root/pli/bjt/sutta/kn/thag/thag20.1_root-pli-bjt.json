{
  "thag20.1:0.1": "60. saṭṭhinipāto. ",
  "thag20.1:0.2": "",
  "thag20.1:0.3": "",
  "thag20.1:0.4": "60. 1. 1. ",
  "thag20.1:1.1": "āraññakā piṇḍapātikā ",
  "thag20.1:1.2": "uñchāpattāgate ratā, ",
  "thag20.1:1.3": "dāḷemu maccuno senaṃ ",
  "thag20.1:1.4": "ajjhattaṃ susamāhitā. ",
  "thag20.1:2.1": "āraññakā piṇḍapātikā ",
  "thag20.1:2.2": "uñchāpattāgate ratā, ",
  "thag20.1:2.3": "dhunāma maccuno senaṃ ",
  "thag20.1:2.4": "naḷāgāraṃ’va kuñjaro. ",
  "thag20.1:3.1": "rukkhamūlikā sātatikā ",
  "thag20.1:3.2": "uñchāpattāgate ratā, ",
  "thag20.1:3.3": "dāḷemu maccuno senaṃ ",
  "thag20.1:3.4": "ajjhattaṃ susamāhitā. ",
  "thag20.1:4.1": "rukkhamūlikā sātatikā ",
  "thag20.1:4.2": "uñchāpattāgate ratā, ",
  "thag20.1:4.3": "dhunāma maccuno senaṃ ",
  "thag20.1:4.4": "naḷāgāraṃ’va kuñjaro. ",
  "thag20.1:5.1": "aṭṭhikaṅkālakuṭike ",
  "thag20.1:5.2": "maṃsananahārusibbite, ",
  "thag20.1:5.3": "dhiratthu pūre duggandhe ",
  "thag20.1:5.4": "paragatte mamāyase, ",
  "thag20.1:6.1": "gūthabhaste taconaddhe ",
  "thag20.1:6.2": "uragaṇḍa pisācinī, ",
  "thag20.1:6.3": "nava sotāni te kāye ",
  "thag20.1:6.4": "yāni sandanti sabbadā. ",
  "thag20.1:7.1": "tava sarīraṃ navasotaṃ ",
  "thag20.1:7.2": "duggandhakaraṃ paribandhaṃ, ",
  "thag20.1:7.3": "bhikkhu parivajjayate taṃ ",
  "thag20.1:7.4": "mīḷhañca yathā sucikāmo. ",
  "thag20.1:8.1": "evaṃ ce taṃ jano jaññā ",
  "thag20.1:8.2": "yathā jānāmi taṃ ahaṃ, ",
  "thag20.1:8.3": "ārakā parivajjeyya ",
  "thag20.1:8.4": "gūthaṭṭhānaṃ’va pāvuse. ",
  "thag20.1:9.1": "evametaṃ mahāvīra ",
  "thag20.1:9.2": "yathā samaṇa bhāsasi, ",
  "thag20.1:9.3": "ettha ceke visīdanti ",
  "thag20.1:9.4": "paṅkamhi’va jaraggavo. ",
  "thag20.1:10.1": "ākāsamhi haliddiyā ",
  "thag20.1:10.2": "yo maññetha, rajetave, ",
  "thag20.1:10.3": "aññena vā’pi raṅgena ",
  "thag20.1:10.4": "vighātudayameva taṃ. ",
  "thag20.1:11.1": "tadākāsasamaṃ cittaṃ ",
  "thag20.1:11.2": "ajjhattaṃ susamāhitaṃ, ",
  "thag20.1:11.3": "mā pāpacitte ahani aggikhandhaṃ’ ",
  "thag20.1:11.4": "va pakkhimā. ",
  "thag20.1:12.1": "passa cittakataṃ bimbaṃ ",
  "thag20.1:12.2": "arukāyaṃ samussitaṃ, ",
  "thag20.1:12.3": "āturaṃ bahusaṅkappaṃ ",
  "thag20.1:12.4": "yassa natthi dhuvaṃ ṭhiti. ",
  "thag20.1:13.1": "passa cittakataṃ rūpaṃ ",
  "thag20.1:13.2": "maṇinā kuṇḍalena ca, ",
  "thag20.1:13.3": "aṭṭhiṃ tacena onaddhaṃ ",
  "thag20.1:13.4": "saha vatthehi sobhati. ",
  "thag20.1:14.1": "alattakakatā pādā ",
  "thag20.1:14.2": "mukhaṃ cuṇṇakamakkhitaṃ, ",
  "thag20.1:14.3": "alaṃ bālassa mohāya ",
  "thag20.1:14.4": "no ca pāragavesino. ",
  "thag20.1:15.1": "aṭṭhapādakatā kesā ",
  "thag20.1:15.2": "nettā añjanamakkhitā, ",
  "thag20.1:15.3": "alaṃ bālassa mohāya ",
  "thag20.1:15.4": "no ca pāragavesino. ",
  "thag20.1:16.1": "añjanīva navā cittā ",
  "thag20.1:16.2": "pūtikāyo alaṅkato, ",
  "thag20.1:16.3": "alaṃ bālassa mohāya ",
  "thag20.1:16.4": "no ca pāragavesino. ",
  "thag20.1:17.1": "odahi migavo pāsaṃ ",
  "thag20.1:17.2": "nāsadā vāguraṃ migo, ",
  "thag20.1:17.3": "bhutvā nivāpaṃ gacchāma ",
  "thag20.1:17.4": "kandakante migabandhake. ",
  "thag20.1:18.1": "chinno pāso migavassa ",
  "thag20.1:18.2": "nāsadā vāguraṃ migo, ",
  "thag20.1:18.3": "bhutvā nivāpaṃ gacchāma ",
  "thag20.1:18.4": "socante migaluddake. ",
  "thag20.1:19.1": "tadāsi yaṃ bhiṃsanakaṃ ",
  "thag20.1:19.2": "tadāsi lomahaṃsanaṃ, ",
  "thag20.1:19.3": "anekākārasampanne ",
  "thag20.1:19.4": "sāriputtamhi nibbute. ",
  "thag20.1:20.1": "aniccā vata saṅkhārā ",
  "thag20.1:20.2": "uppādavayadhammino, ",
  "thag20.1:20.3": "uppajjitvā nirujjhanti ",
  "thag20.1:20.4": "tesaṃ vūpasamo sukho. ",
  "thag20.1:21.1": "sukhumaṃ te paṭivijjhanti ",
  "thag20.1:21.2": "vālaggaṃ usunā yathā, ",
  "thag20.1:21.3": "ye pañcakkhandhe passanti ",
  "thag20.1:21.4": "parato no ca attato. ",
  "thag20.1:22.1": "ye ca passanti saṅkhāre ",
  "thag20.1:22.2": "parato no ca attato, ",
  "thag20.1:22.3": "paccabyādhiṃsu nipuṇaṃ ",
  "thag20.1:22.4": "vālaggaṃ usunā yathā. ",
  "thag20.1:23.1": "sattiyā viya omaṭṭho ",
  "thag20.1:23.2": "ḍayhamāno’va matthake, ",
  "thag20.1:23.3": "kāmarāgappahānāya ",
  "thag20.1:23.4": "sato bhikkhu paribbaje. ",
  "thag20.1:24.1": "sattiyā viya omaṭṭho ",
  "thag20.1:24.2": "ḍayhamāno’va matthake, ",
  "thag20.1:24.3": "bhavarāgappahānāya ",
  "thag20.1:24.4": "sato bhikkhu paribbaje. ",
  "thag20.1:25.1": "codito bhāvitattena ",
  "thag20.1:25.2": "sarīrantimadhārinā, ",
  "thag20.1:25.3": "migāramātupāsādaṃ ",
  "thag20.1:25.4": "pādaṅguṭṭhena kampayiṃ. ",
  "thag20.1:26.1": "nayidaṃ sithilamārabbha ",
  "thag20.1:26.2": "nayidaṃ appena thāmasā, ",
  "thag20.1:26.3": "nibbānamadhigantabbaṃ ",
  "thag20.1:26.4": "sabbaganthapamocanaṃ. ",
  "thag20.1:27.1": "ayaṃ ca daharo bhikkhu ",
  "thag20.1:27.2": "ayamuttamaporiso, ",
  "thag20.1:27.3": "dhāreti antimaṃ dehaṃ ",
  "thag20.1:27.4": "chetvā māraṃ savāhiniṃ. ",
  "thag20.1:28.1": "vivaramanupatanti vijjutā ",
  "thag20.1:28.2": "vebhārassa ca paṇḍavassa ca, ",
  "thag20.1:28.3": "nagavivaragato’va jhāyati ",
  "thag20.1:28.4": "putto appaṭimassa tādino. ",
  "thag20.1:29.1": "upasanto uparato ",
  "thag20.1:29.2": "pantasenāsano muni, ",
  "thag20.1:29.3": "dāyādo buddhaseṭṭhassa ",
  "thag20.1:29.4": "brahmunā abhivandito. ",
  "thag20.1:30.1": "upasantaṃ uparataṃ ",
  "thag20.1:30.2": "pantasenāsanaṃ muniṃ, ",
  "thag20.1:30.3": "dāyādaṃ buddhaseṭṭhassa ",
  "thag20.1:30.4": "vanda brāhmaṇa kassapaṃ. ",
  "thag20.1:31.1": "yo ca jātisataṃ gacche ",
  "thag20.1:31.2": "sabbā brāhmaṇajātiyo, ",
  "thag20.1:31.3": "sotthiyo vedasampanno ",
  "thag20.1:31.4": "manussesu punappunaṃ. ",
  "thag20.1:32.1": "ajjhāyako’pi ce assa ",
  "thag20.1:32.2": "tiṇṇaṃ vedāna pāragū, ",
  "thag20.1:32.3": "etassa vandanāyetaṃ ",
  "thag20.1:32.4": "kalaṃ nāgghati soḷasiṃ. ",
  "thag20.1:33.1": "yo so aṭṭhavimokkhāni ",
  "thag20.1:33.2": "purebhattaṃ aphassayi, ",
  "thag20.1:33.3": "anulomaṃ paṭilomaṃ ",
  "thag20.1:33.4": "tato piṇḍāya gacchati. ",
  "thag20.1:34.1": "tādisaṃ bhikkhuṃ mā hani ",
  "thag20.1:34.2": "māttānaṃ khaṇi brāhmaṇa, ",
  "thag20.1:34.3": "abhippasādehi manaṃ ",
  "thag20.1:34.4": "arahantamhi tādino ",
  "thag20.1:34.5": "khippaṃ pañjaliko vanda ",
  "thag20.1:34.6": "mā te vijaṭi matthakaṃ. ",
  "thag20.1:35.1": "neso passati saddhammaṃ ",
  "thag20.1:35.2": "saṃsārena purakkhato, ",
  "thag20.1:35.3": "adhogamaṃ jimhapathaṃ ",
  "thag20.1:35.4": "kummaggamanudhāvati. ",
  "thag20.1:36.1": "kimī’va mīḷhasallitto ",
  "thag20.1:36.2": "saṅkhāre adhimucchito, ",
  "thag20.1:36.3": "pagāḷho lābhasakkāre ",
  "thag20.1:36.4": "tuccho gacchati poṭhilo. imaṃ ",
  "thag20.1:37.1": "ca passa āyantaṃ ",
  "thag20.1:37.2": "sāriputtaṃ sudassanaṃ, ",
  "thag20.1:37.3": "vimuttaṃ ubhatobhāge ",
  "thag20.1:37.4": "ajjhattaṃ susamāhitaṃ. ",
  "thag20.1:38.1": "visallaṃ khīṇasaṃyogaṃ ",
  "thag20.1:38.2": "tevijjaṃ maccuhāyinaṃ, ",
  "thag20.1:38.3": "dakkhiṇeyyaṃ manussānaṃ ",
  "thag20.1:38.4": "puññakkhettaṃ anuttaraṃ, ",
  "thag20.1:39.1": "ete sambahulā devā ",
  "thag20.1:39.2": "iddhimanto yasassino ",
  "thag20.1:39.3": "dasadevasahassāni ",
  "thag20.1:39.4": "sabbe brahmapurohitā ",
  "thag20.1:39.5": "moggallānaṃ namassantā ",
  "thag20.1:39.6": "tiṭṭhanti pañjalīkatā. ",
  "thag20.1:40.1": "namo te purisājañña ",
  "thag20.1:40.2": "namo te purisuttama ",
  "thag20.1:40.3": "yassa te āsavā khīṇā ",
  "thag20.1:40.4": "dakkhiṇeyyo’si mārisa. ",
  "thag20.1:41.1": "pūjito naradevena ",
  "thag20.1:41.2": "uppanno maraṇābhibhū ",
  "thag20.1:41.3": "puṇḍarīkaṃ’va toyena ",
  "thag20.1:41.4": "saṅkhārenopalippati, ",
  "thag20.1:42.1": "yassa muhuttena sahassadhā loko ",
  "thag20.1:42.2": "saṃvidito sabrahmakappo vasi ",
  "thag20.1:42.3": "iddhiguṇe cutūpapāte kāle ",
  "thag20.1:42.4": "passati devatā sa bhikkhu. ",
  "thag20.1:43.1": "sāriputto’va paññāya ",
  "thag20.1:43.2": "sīlena upasamena ca ",
  "thag20.1:43.3": "yo’pi pāraṅgato bhikkhu ",
  "thag20.1:43.4": "etā’vaparamo siyā. ",
  "thag20.1:44.1": "koṭisatasahassassa ",
  "thag20.1:44.2": "attabhāvaṃ khaṇena nimmine ",
  "thag20.1:44.3": "ahaṃ vikubbanāsu kusalo ",
  "thag20.1:44.4": "vasībhūtomhi iddhiyā. ",
  "thag20.1:45.1": "samādhivijjāvasipāramiṃ gato. ",
  "thag20.1:45.2": "moggallānagotto asitassa sāsane ",
  "thag20.1:45.3": "dhīro samucchindi samāhitindriyo ",
  "thag20.1:45.4": "nāgo yathā pūtilataṃ’va bandhanaṃ. ",
  "thag20.1:46.1": "pariciṇṇo mayā satthā ",
  "thag20.1:46.2": "kataṃ buddhassa sāsanaṃ ",
  "thag20.1:46.3": "ohito garuko bhāro ",
  "thag20.1:46.4": "bhavanetti samūhatā. ",
  "thag20.1:47.1": "yassatthāya pabbajito ",
  "thag20.1:47.2": "agārasmānagāriyaṃ ",
  "thag20.1:47.3": "so me attho anuppatto ",
  "thag20.1:47.4": "sabbasaṃyojanakkhayo. ",
  "thag20.1:48.1": "kīdiso nirayo āsi ",
  "thag20.1:48.2": "yattha dussī apaccatha ",
  "thag20.1:48.3": "vidhuraṃ sāvakamāsajja ",
  "thag20.1:48.4": "kakusandhaṃ ca brāhmaṇaṃ. ",
  "thag20.1:49.1": "sataṃ āsi ayosaṅkū ",
  "thag20.1:49.2": "sabbe paccattavedanā ",
  "thag20.1:49.3": "īdiso nirayo āsi ",
  "thag20.1:49.4": "yattha dussī apaccatha ",
  "thag20.1:49.5": "vidhuraṃ sāvakamāsajja ",
  "thag20.1:49.6": "kakusandhaṃ ca brāhmaṇaṃ. ",
  "thag20.1:50.1": "yo etamabhijānāti ",
  "thag20.1:50.2": "bhikkhu buddhassa sāvako ",
  "thag20.1:50.3": "tādisaṃ bhikkhumāsajja ",
  "thag20.1:50.4": "kaṇha dukkhaṃ nigacchasi. ",
  "thag20.1:51.1": "majjhesarassa tiṭṭhanti ",
  "thag20.1:51.2": "vimānā kappaṭṭhāyino ",
  "thag20.1:51.3": "veḷuriyavaṇṇā rucirā ",
  "thag20.1:51.4": "accimanto pabhassarā ",
  "thag20.1:51.5": "accharā tattha naccanti ",
  "thag20.1:51.6": "puthu nānattavaṇṇiyo. ",
  "thag20.1:52.1": "yo etamabhijānāti ",
  "thag20.1:52.2": "bhikkhu buddhassa sāvako tādisaṃ bhikkhumāsajja ",
  "thag20.1:52.3": "",
  "thag20.1:52.4": "kaṇha dukkhaṃ nigacchasi. ",
  "thag20.1:53.1": "yo ve buddhena codito ",
  "thag20.1:53.2": "bhikkhusaṅghassa pekkhato ",
  "thag20.1:53.3": "migāramātupāsādaṃ ",
  "thag20.1:53.4": "pādaṅguṭṭhena kampisaṃ. ",
  "thag20.1:54.1": "yo etamabhijānāti ",
  "thag20.1:54.2": "bhikkhu buddhassa sāvako tādisaṃ bhikkhumāsajja ",
  "thag20.1:54.3": "",
  "thag20.1:54.4": "kaṇha dukkhaṃ nigacchasi. ",
  "thag20.1:55.1": "yo vejayantapāsādaṃ ",
  "thag20.1:55.2": "pādaṅguṭṭhena kampayi ",
  "thag20.1:55.3": "iddhi balenupatthaddho ",
  "thag20.1:55.4": "saṃvejesi ca devatā. ",
  "thag20.1:56.1": "yo etamabhijānāti ",
  "thag20.1:56.2": "bhikkhu buddhassa sāvako tādisaṃ bhikkhumāsajja ",
  "thag20.1:56.3": "",
  "thag20.1:56.4": "kaṇha dukkhaṃ nigacchasi. ",
  "thag20.1:57.1": "yo vejayantapāsāde ",
  "thag20.1:57.2": "sakkaṃ so paripucchati ",
  "thag20.1:57.3": "api āvuso jānāsi ",
  "thag20.1:57.4": "taṇhakkhayavimuttiyo ",
  "thag20.1:57.5": "tassa sakko viyākāsi ",
  "thag20.1:57.6": "pañhaṃ puṭṭho yathātathaṃ. ",
  "thag20.1:58.1": "yo etamabhijānāti ",
  "thag20.1:58.2": "bhikkhu buddhassa sāvako tādisaṃ bhikkhumāsajja ",
  "thag20.1:58.3": "",
  "thag20.1:58.4": "kaṇha dukkhaṃ nigacchasi. ",
  "thag20.1:59.1": "yo brahmānaṃ paripucchati ",
  "thag20.1:59.2": "sudhammāyaṃ ṭhito sabhaṃ ",
  "thag20.1:59.3": "ajjā’pi tyāvuso sā diṭṭhi ",
  "thag20.1:59.4": "yā te diṭṭhi pure ahu ",
  "thag20.1:59.5": "passasi vītivattantaṃ ",
  "thag20.1:59.6": "brahmaloke pabhassaraṃ. ",
  "thag20.1:60.1": "tassa brahmā viyākāsi ",
  "thag20.1:60.2": "pañhaṃ puṭṭho yathātathaṃ ",
  "thag20.1:60.3": "na me mārisa sā diṭṭhi ",
  "thag20.1:60.4": "yā me diṭṭhi pure ahu. ",
  "thag20.1:61.1": "passāmi vītivattantaṃ ",
  "thag20.1:61.2": "brahmaloke pabhassaraṃ ",
  "thag20.1:61.3": "so’haṃ ajja kataṃ vajjaṃ ",
  "thag20.1:61.4": "ahaṃ niccomhi sassato. ",
  "thag20.1:62.1": "yo etamabhijānāti ",
  "thag20.1:62.2": "bhikkhu buddhassa sāvako tādisaṃ bhikkhumāsajja ",
  "thag20.1:62.3": "",
  "thag20.1:62.4": "kaṇha dukkhaṃ nigacchasi. ",
  "thag20.1:63.1": "yo mahāneruno kūṭaṃ ",
  "thag20.1:63.2": "vimokkhena aphassasi ",
  "thag20.1:63.3": "vanaṃ pubbavidehānaṃ ",
  "thag20.1:63.4": "ye ca bhūmisayā narā. ",
  "thag20.1:64.1": "yo etamabhijānāti ",
  "thag20.1:64.2": "bhikkhu buddhassa sāvako ",
  "thag20.1:64.3": "tādisaṃ bhikkhumāsajja ",
  "thag20.1:64.4": "kaṇha dukkhaṃ nigacchasi. ",
  "thag20.1:65.1": "na ve aggi cetayati ",
  "thag20.1:65.2": "ahaṃ bālaṃ ḍahāmīti, ",
  "thag20.1:65.3": "bālo’va jalitaṃ aggiṃ ",
  "thag20.1:65.4": "āsajjana padayhati. ",
  "thag20.1:66.1": "evameva tuvaṃ māra ",
  "thag20.1:66.2": "āsajjana tathāgataṃ ",
  "thag20.1:66.3": "sayaṃ dahissasi attānaṃ ",
  "thag20.1:66.4": "bālo aggiṃ’va samphusaṃ. ",
  "thag20.1:67.1": "apuññaṃ pasavī māpo ",
  "thag20.1:67.2": "āsajjana tathāgataṃ ",
  "thag20.1:67.3": "kinnu maññasi pāpima ",
  "thag20.1:67.4": "na me pāpaṃ vipaccati. ",
  "thag20.1:68.1": "karato te cīyate pāpaṃ ",
  "thag20.1:68.2": "cirarattāya antaka ",
  "thag20.1:68.3": "māra nibbinda buddhamhā ",
  "thag20.1:68.4": "āsaṃ mākāsi bhikkhusu. ",
  "thag20.1:69.1": "iti māraṃ atajjesi ",
  "thag20.1:69.2": "bhikkhu bhesakalāvane ",
  "thag20.1:69.3": "tato so dummano yakkho ",
  "thag20.1:69.4": "tatthevantaradhāyathā’ti. ",
  "thag20.1:69.5": "itthaṃ sudaṃ āyasmā mahāmoggallāno thero gāthāyo abhāsitthā’ti. ",
  "thag20.1:69.6": "",
  "thag20.1:70.0": "mahāmoggallānattheragāthā. tassuddānaṃ: ",
  "thag20.1:70.1": "saṭṭhikamhi nipātamhi ",
  "thag20.1:70.2": "moggallāno mahiddhiko ",
  "thag20.1:70.3": "eko’va thero gāthāyo ",
  "thag20.1:70.4": "aṭṭhasaṭṭhi bhavanti tā’ti. saṭṭhinipāto niṭṭhito. "
}
