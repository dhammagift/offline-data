  "thag1.47:0.4": "1. 5. 7. ",
  "thag1.47:1.1": "namo te buddhavīratthu ",
  "thag1.47:1.2": "vippamuttosi sabbadhi ",
  "thag1.47:1.3": "tuyhāpadāne viharaṃ ",
  "thag1.47:1.4": "viharāmi anāsavo’ti. itthaṃ sudaṃ āyasmā ",
  "thag1.47:1.5": "ujjayo thero gāthaṃ abhāsitthā’ti. ujjayattheragāthā. "
}
