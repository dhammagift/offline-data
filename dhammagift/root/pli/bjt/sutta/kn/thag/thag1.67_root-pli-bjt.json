  "thag1.67:0.4": "1. 7. 7. ",
  "thag1.67:1.1": "kilesā jhāpitā mayhaṃ ",
  "thag1.67:1.2": "bhavā sabbe samūhatā ",
  "thag1.67:1.3": "vikkhīṇo jātisaṃsāro ",
  "thag1.67:1.4": "natthi dāni punabbhavo’ti. itthaṃ sudaṃ āyasmā ",
  "thag1.67:1.5": "ekadhammasavanīyo thero gāthaṃ abhāsitthā’ti. ekadhammasavanīyattheragāthā. "
}
