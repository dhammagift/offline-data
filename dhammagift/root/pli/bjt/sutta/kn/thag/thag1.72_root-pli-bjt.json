  "thag1.72:0.3": "",
  "thag1.72:0.4": "1. 8. 2. ",
  "thag1.72:1.1": "yathā kaḷīro susu vaḍḍhitaggo ",
  "thag1.72:1.2": "dunnikkhamo hoti pasākhajāto ",
  "thag1.72:1.3": "evaṃ ahaṃ bhariyāyānītāya ",
  "thag1.72:1.4": "anumañña maṃ pabbajitomhi dānī’ti. itthaṃ sudaṃ āyasmā ",
  "thag1.72:1.5": "ātumo thero gāthaṃ abhāsitthā’ti. ātumattheragāthā. "
}
