{
  "thag6.12:0.1": "",
  "thag6.12:0.2": "",
  "thag6.12:0.3": "",
  "thag6.12:0.4": "6. 1. 12. ",
  "thag6.12:1.1": "akkodhassa kuto kodho ",
  "thag6.12:1.2": "dantassa samajīvino, ",
  "thag6.12:1.3": "sammadaññā vimuttassa ",
  "thag6.12:1.4": "upasantassa tādino, ",
  "thag6.12:2.1": "tasseva tena pāpiyo ",
  "thag6.12:2.2": "yo kuddhaṃ paṭikujjhati, ",
  "thag6.12:2.3": "kuddhaṃ appaṭikujjhanto ",
  "thag6.12:2.4": "saṅgāmaṃ jeti dujjayaṃ. ",
  "thag6.12:3.1": "ubhinnamatthaṃ carati ",
  "thag6.12:3.2": "attano ca parassa ca, ",
  "thag6.12:3.3": "paraṃ saṅkupitaṃ ñatvā ",
  "thag6.12:3.4": "yo sato upasammati. ",
  "thag6.12:4.1": "ubhikkaṃ tikicchantaṃ taṃ ",
  "thag6.12:4.2": "attano ca parassa ca, ",
  "thag6.12:4.3": "janā maññanti bāloti ",
  "thag6.12:4.4": "ye dhammassa akovidā. ",
  "thag6.12:5.1": "uppajje te sace kodho ",
  "thag6.12:5.2": "āvajja kakacūpamaṃ, ",
  "thag6.12:5.3": "uppajjaje ce rase taṇhā ",
  "thag6.12:5.4": "puttamaṃsūpamaṃ sara. ",
  "thag6.12:6.1": "sace dhāvati cittaṃ te ",
  "thag6.12:6.2": "kāmesu ca bhavesu ca, ",
  "thag6.12:6.3": "khippaṃ niggaṇha satiyā ",
  "thag6.12:6.4": "kiṭṭhādaṃ viya duppasu’nti. itthaṃ sudaṃ āyasmā ",
  "thag6.12:6.5": "brahmadatto thero gāthāyo abhāsitthā’ti. brahmadattattheragāthā. "
}
