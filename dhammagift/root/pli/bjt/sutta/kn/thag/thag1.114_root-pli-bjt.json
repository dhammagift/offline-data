  "thag1.114:0.4": "1. 12. 4. vanavacchattheragāthā. ",
  "thag1.114:1.1": "kāyaduṭṭhullagaruno ",
  "thag1.114:1.2": "hīyamānamhi jīvite, ",
  "thag1.114:1.3": "sarīrasukhagiddhassa ",
  "thag1.114:1.4": "kuto samaṇa sādhutā’ti. itthaṃ sudaṃ āyasmā ",
  "thag1.114:1.5": "adhimutto thero gāthaṃ abhāsitthā’ti. "
}
