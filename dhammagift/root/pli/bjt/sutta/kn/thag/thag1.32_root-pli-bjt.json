  "thag1.32:0.4": "1. 4. 2. ",
  "thag1.32:1.1": "ajaraṃ jiramānena ",
  "thag1.32:1.2": "tappamānena nibbutiṃ ",
  "thag1.32:1.3": "nimmissaṃ paramaṃ santiṃ ",
  "thag1.32:1.4": "yogakkhemaṃ anuttara’nti. itthaṃ sudaṃ āyasmā ",
  "thag1.32:1.5": "suppiyo thero gāthaṃ abhāsitthā’ti. suppiyattheragāthā. "
}
