  "thag1.70:0.3": "",
  "thag1.70:0.4": "1. 7. 10. channattheragāthā. ",
  "thag1.70:1.1": "sīlameva idha aggaṃ ",
  "thag1.70:1.2": "paññavā pana uttamo ",
  "thag1.70:1.3": "manussesu ca deve su ",
  "thag1.70:1.4": "sīlapaññāṇato jaya’nti. itthaṃ sudaṃ āyasmā ",
  "thag1.70:1.5": "puṇṇo thero ",
  "thag1.70:1.6": "gāthaṃ abhāsitthā’ti. ",
  "thag1.70:2.0": "puṇṇattheragāthā. sattamo vaggo. tassuddānaṃ: ",
  "thag1.70:2.1": "vappo ca vajjiputto ca ",
  "thag1.70:2.2": "pakkho vimalakoṇḍañño ",
  "thag1.70:2.3": "ukkhepakaṭavaccho ca ",
  "thag1.70:2.4": "meghiyo ekadhammiko ",
  "thag1.70:2.5": "ekudāniyacchannā ca ",
  "thag1.70:2.6": "puṇṇatthero mahabbalo’ti. "
}
