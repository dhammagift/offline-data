  "thag6.2:0.1": "",
  "thag6.2:0.2": "",
  "thag6.2:0.3": "",
  "thag6.2:0.4": "6. 1. 2. uruvelakassapattheragāthā. ",
  "thag6.2:1.1": "atihitā vīhi ",
  "thag6.2:1.2": "khalagatā sālī, ",
  "thag6.2:1.3": "na ca labhe piṇḍaṃ ",
  "thag6.2:1.4": "kathamahaṃ kassaṃ. ",
  "thag6.2:2.1": "buddhamappameyyaṃ anussara pasanno, ",
  "thag6.2:2.2": "pītiyā phuṭasarīro hohisi satatamudaggo. ",
  "thag6.2:3.1": "dhammamappameyyaṃ anussara pasanno, ",
  "thag6.2:3.2": "pītiyā phuṭasarīro hohisi satatamudaggo. ",
  "thag6.2:4.1": "saṅghamappameyyaṃ anussara pasanno, ",
  "thag6.2:4.2": "pītiyā phuṭasarīro hohisi satatamudaggo. ",
  "thag6.2:5.1": "abbhokāse viharasi ",
  "thag6.2:5.2": "sītā hemantikā imā rattiyo, ",
  "thag6.2:5.3": "mā sītena pareto vihaññittho ",
  "thag6.2:5.4": "pavisa tvaṃ vihāraṃ phusitaggaḷaṃ. ",
  "thag6.2:6.1": "phusissaṃ catasso appamaññāyo ",
  "thag6.2:6.2": "tāhi ca sukhito viharissaṃ, ",
  "thag6.2:6.3": "nāhaṃ sītena vihaññissaṃ ",
  "thag6.2:6.4": "aniñjito viharanto’ti. ",
  "thag6.2:6.5": "itthaṃ sudaṃ āyasmā tekicchakāni thero gāthāyo abhāsitthā’ti. "
}
