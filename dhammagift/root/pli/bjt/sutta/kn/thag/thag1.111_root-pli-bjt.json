  "thag1.111:0.3": "",
  "thag1.111:0.4": "1. 12. 1. ",
  "thag1.111:1.1": "duppabbajjaṃ ve duradhivāsā gehā ",
  "thag1.111:1.2": "dhammo gambhīro duradhigamā bhogā, ",
  "thag1.111:1.3": "kicchā vutti no itarītareneva ",
  "thag1.111:1.4": "yuttaṃ cintetuṃ satatamaniccata’nti. itthaṃ sudaṃ āyasmā ",
  "thag1.111:1.5": "jento thero gāthaṃ abhāsitthā’ti. jentattheragāthā. "
}
