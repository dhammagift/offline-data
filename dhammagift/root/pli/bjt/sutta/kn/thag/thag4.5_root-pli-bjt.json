  "thag4.5:0.3": "",
  "thag4.5:0.4": "4. 1. 5. ",
  "thag4.5:1.1": "pañcapaññāsavassāni ",
  "thag4.5:1.2": "rajojallamadhārayiṃ, ",
  "thag4.5:1.3": "bhuñjanto māsikaṃ bhattaṃ ",
  "thag4.5:1.4": "kesamassuṃ alocayiṃ. ",
  "thag4.5:2.1": "ekapādena aṭṭhāsiṃ ",
  "thag4.5:2.2": "āsanaṃ parivajjayiṃ, ",
  "thag4.5:2.3": "sukkhagūthāni ca khādiṃ ",
  "thag4.5:2.4": "uddesaṃ ca na sādiyiṃ. ",
  "thag4.5:3.1": "etādisaṃ karitvāna ",
  "thag4.5:3.2": "bahuṃ duggatigāminaṃ, ",
  "thag4.5:3.3": "vuyhamāno mahoghena ",
  "thag4.5:3.4": "buddhaṃ saraṇamāgamaṃ. ",
  "thag4.5:4.1": "saraṇāgamanaṃ passa ",
  "thag4.5:4.2": "passa dhammasudhammataṃ, ",
  "thag4.5:4.3": "tisso vijjā anuppattā ",
  "thag4.5:4.4": "kataṃ buddhassa sāsana’nti. itthaṃ sudaṃ āyasmā ",
  "thag4.5:4.5": "jambuko thero gāthāyo abhāsitthā’ti. jambukattheragāthā. "
}
