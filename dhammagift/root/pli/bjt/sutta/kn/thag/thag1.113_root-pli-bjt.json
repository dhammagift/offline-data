  "thag1.113:0.4": "1. 12. 3. ",
  "thag1.113:1.1": "acchodikā puthusilā ",
  "thag1.113:1.2": "gonaṅgulamigāyutā, ",
  "thag1.113:1.3": "ambusevālasañchannā ",
  "thag1.113:1.4": "te selā ramayanti ma’nti. itthaṃ sudaṃ āyasmā ",
  "thag1.113:1.5": "vanavaccho thero gāthaṃ abhāsitthā’ti. vanavacchattheragāthā. "
}
