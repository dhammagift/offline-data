{
  "thag10.7:0.1": "",
  "thag10.7:0.2": "",
  "thag10.7:0.3": "",
  "thag10.7:0.4": "10. 1. 7. upasenattheragāthā. ",
  "thag10.7:1.1": "vijāneyya sakaṃ atthaṃ ",
  "thag10.7:1.2": "avalokeyyātha pāvacanaṃ, ",
  "thag10.7:1.3": "yañcettha assa patirūpaṃ ",
  "thag10.7:1.4": "sāmaññaṃ ajjhupagatassa. ",
  "thag10.7:2.1": "mittaṃ idha ca kalyāṇaṃ ",
  "thag10.7:2.2": "sikkhā vipulaṃ samādānaṃ, ",
  "thag10.7:2.3": "sussūsā ca garūnaṃ ",
  "thag10.7:2.4": "etaṃ samaṇassa patirūpaṃ, ",
  "thag10.7:3.1": "buddhesu ca sagāravatā ",
  "thag10.7:3.2": "dhamme apaciti yathābhūtaṃ, ",
  "thag10.7:3.3": "saṅghe ca cittikāro ",
  "thag10.7:3.4": "etaṃ samaṇassa patirūpaṃ. ",
  "thag10.7:4.1": "ācāragocare yutto ",
  "thag10.7:4.2": "ājīvo sodhito agārayho, ",
  "thag10.7:4.3": "cittassa ca saṇṭhapanaṃ ",
  "thag10.7:4.4": "etaṃ samaṇassa patirūpaṃ. ",
  "thag10.7:5.1": "cārittaṃ atha vārittaṃ ",
  "thag10.7:5.2": "iriyāpathiyaṃ pasādanīyaṃ, ",
  "thag10.7:5.3": "adhicitte ca āyogo ",
  "thag10.7:5.4": "etaṃ samaṇassa patirūpaṃ. ",
  "thag10.7:6.1": "āraññakāni senāsanāni ",
  "thag10.7:6.2": "pantāni appasaddāni, ",
  "thag10.7:6.3": "bhajitabbāni muninā ",
  "thag10.7:6.4": "etaṃ samaṇassa patirūpaṃ. ",
  "thag10.7:7.1": "sīlaṃ ca bāhusaccañca ",
  "thag10.7:7.2": "dhammānaṃ pavicayo yathābhūtaṃ, ",
  "thag10.7:7.3": "saccānaṃ abhisamayo ",
  "thag10.7:7.4": "etaṃ samaṇassa patirūpaṃ. ",
  "thag10.7:8.1": "bhāvaye ca aniccanti ",
  "thag10.7:8.2": "anattasaññaṃ asubhasaññaṃ ca, ",
  "thag10.7:8.3": "lokamhi ca anabhiratiṃ ",
  "thag10.7:8.4": "etaṃ samaṇassa patirūpaṃ. ",
  "thag10.7:9.1": "bhaveyya ca bojjhaṅge ",
  "thag10.7:9.2": "iddhipādāni indriyāni balāni, ",
  "thag10.7:9.3": "aṭṭhaṅgamaggamariyaṃ ",
  "thag10.7:9.4": "etaṃ samaṇassa patirūpaṃ. ",
  "thag10.7:10.1": "taṇhaṃ pajaheyya muni ",
  "thag10.7:10.2": "samūlake āsave padāleyya, ",
  "thag10.7:10.3": "vihareyya vippamutto ",
  "thag10.7:10.4": "etaṃ samaṇassa patirūpa’nti. itthaṃ sudaṃ āyasmā ",
  "thag10.7:10.5": "gotamo thero ",
  "thag10.7:10.6": "gāthāyo abhāsitthā’ti. ",
  "thag10.7:11.0": "aparagotamattheragāthā. tassuddānaṃ: ",
  "thag10.7:11.1": "kāḷudāyī ca so thero ",
  "thag10.7:11.2": "ekavihārī ca kappino ",
  "thag10.7:11.3": "cūḷapanthako kappo ca ",
  "thag10.7:11.4": "upaseno ca gotamo, ",
  "thag10.7:11.5": "sattime dasake therā ",
  "thag10.7:11.6": "gāthāyo cettha sattatī’ti. dasakanipāto niṭṭhito. "
}
