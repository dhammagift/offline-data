  "thag2.10:0.3": "",
  "thag2.10:0.4": "2. 1. 10. ",
  "thag2.10:1.1": "pubbe hanti attānaṃ ",
  "thag2.10:1.2": "pacchā hanti so pare, ",
  "thag2.10:1.3": "suhataṃ hanti attānaṃ ",
  "thag2.10:1.4": "vītaseneva pakkhimā. ",
  "thag2.10:2.1": "na brāhmaṇo bahivaṇṇo ",
  "thag2.10:2.2": "anto vaṇṇo hi brāhmaṇo, ",
  "thag2.10:2.3": "yasumiṃ pāpāni kammāni ",
  "thag2.10:2.4": "sa ve kaṇho sujampatī’ti. itthaṃ sudaṃ āyasmā ",
  "thag2.10:2.5": "vasabho thero gāthāyo abhāsitthā’ti. vasabhattheragāthā. ",
  "thag2.10:2.6": "vaggo paṭhamo. ",
  "thag2.10:3.0": "tassuddānaṃ: ",
  "thag2.10:3.1": "uttaro ceva piṇḍolo ",
  "thag2.10:3.2": "vallito tīriyo isi, ",
  "thag2.10:3.3": "ajino ca melajino ",
  "thag2.10:3.4": "rādho surādho gotamo, ",
  "thag2.10:3.5": "vasabhena ime honti ",
  "thag2.10:3.6": "dasa therā mahiddhikā’ti. vaggo dutiyo. "
}
