  "thag6.13:0.3": "",
  "thag6.13:0.4": "6. 1. 13. brahmadattattheragāthā. ",
  "thag6.13:1.1": "channamativassati ",
  "thag6.13:1.2": "vivaṭaṃ nātivassati, ",
  "thag6.13:1.3": "tasmā channaṃ vivaretha ",
  "thag6.13:1.4": "evaṃ taṃ nātivassati. ",
  "thag6.13:2.1": "maccunābbhāhato loko ",
  "thag6.13:2.2": "jarāya parivārito, ",
  "thag6.13:2.3": "taṇhāsallena otiṇṇo ",
  "thag6.13:2.4": "icchādhūpāyito sadā. ",
  "thag6.13:3.1": "maccunābbhāhato loko ",
  "thag6.13:3.2": "parikkhitto jarāya ca, ",
  "thag6.13:3.3": "haññati niccamattāṇo ",
  "thag6.13:3.4": "pattadaṇḍo’va takkaro. ",
  "thag6.13:4.1": "āgacchantaggikhandhā’va ",
  "thag6.13:4.2": "maccu vyādhi jarā tayo, ",
  "thag6.13:4.3": "paccuggantuṃ balaṃ natthi ",
  "thag6.13:4.4": "javo natthi palāyituṃ. ",
  "thag6.13:5.1": "amoghaṃ divasaṃ kayirā ",
  "thag6.13:5.2": "appena bahukena vā, ",
  "thag6.13:5.3": "yaṃ ya vijahate rattiṃ ",
  "thag6.13:5.4": "tadūnaṃ tassa jīvitaṃ. ",
  "thag6.13:6.1": "carato tiṭṭhato vā pi ",
  "thag6.13:6.2": "āsīnasayanassa vā, ",
  "thag6.13:6.3": "upeti carimā ratti ",
  "thag6.13:6.4": "na te kālo pamajjitu’nti. itthaṃ sudaṃ āyasmā ",
  "thag6.13:6.5": "sirimando thero gāthāyo abhāsitthā’ti. "
}
