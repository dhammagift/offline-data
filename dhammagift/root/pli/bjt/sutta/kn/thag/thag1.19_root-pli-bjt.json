  "thag1.19:0.4": "1. 2. 9. sigālapituttheragāthā. ",
  "thag1.19:1.1": "udakaṃ hi nayanti nettikā ",
  "thag1.19:1.2": "usukāro namayanti tejanaṃ ",
  "thag1.19:1.3": "dāruṃ namayanti tacchakā ",
  "thag1.19:1.4": "attānaṃ damayanti subbatā’ti. ",
  "thag1.19:1.5": "itthaṃ sudaṃ āyasmā kuṇḍalo thero gāthaṃ abhāsitthā’ti. "
}
