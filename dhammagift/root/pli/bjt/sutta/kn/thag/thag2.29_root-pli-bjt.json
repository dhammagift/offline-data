  "thag2.29:0.3": "",
  "thag2.29:0.4": "2. 3. 9. bharatattheragāthā. ",
  "thag2.29:1.1": "nadanti evaṃ sappaññā ",
  "thag2.29:1.2": "sīhāva girigabbhare, ",
  "thag2.29:1.3": "vīrā vijitasaṅgāmā ",
  "thag2.29:1.4": "chetvā māraṃ savāhiniṃ. ",
  "thag2.29:2.1": "satthā ca pariciṇṇo me ",
  "thag2.29:2.2": "dhammo saṅgho ca pūjito, ",
  "thag2.29:2.3": "ahaṃ ca vitto sumano ",
  "thag2.29:2.4": "puttaṃ disvā anāsavanti. itthaṃ sudaṃ āyasmā ",
  "thag2.29:2.5": "bhāradvājo thero gāthāyo abhāsitthā’ti. "
}
