  "thag1.63:0.3": "",
  "thag1.63:0.4": "1. 7. 3. vajjiputtattheragāthā. ",
  "thag1.63:1.1": "cutā patanti patitā ",
  "thag1.63:1.2": "giddhā ca punarāgatā ",
  "thag1.63:1.3": "kataṃ kiccaṃ rataṃ rammaṃ ",
  "thag1.63:1.4": "sukhenanvāgataṃ sukhanti. itthaṃ sudaṃ āyasmā ",
  "thag1.63:1.5": "pakkho thero gāthaṃ abhāsitthā’ti. "
}
