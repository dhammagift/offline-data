  "thag1.84:0.3": "",
  "thag1.84:0.4": "1. 9. 4. ",
  "thag1.84:1.1": "sabbarattiṃ supitvāna ",
  "thag1.84:1.2": "divā saṅgaṇike rato, ",
  "thag1.84:1.3": "kudassu nāma dummedho ",
  "thag1.84:1.4": "dukkhassantaṃ karissatī’ti. itthaṃ sudaṃ āyasmā ",
  "thag1.84:1.5": "nīto thero gāthaṃ abhāsitthā’ti. nītattheragāthā. "
}
