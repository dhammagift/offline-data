  "thag1.14:0.3": "",
  "thag1.14:0.4": "1. 2. 4. vanavacchattheragāthā. ",
  "thag1.14:1.1": "upajjhāyo maṃ avaca ",
  "thag1.14:1.2": "ito gacchāma sīvaka ",
  "thag1.14:1.3": "gāme me vasati kāyo ",
  "thag1.14:1.4": "araññaṃ me gato mano ",
  "thag1.14:1.5": "semānako pi gacchāmi ",
  "thag1.14:1.6": "natthi saṅgo vijānata’nti. itthaṃ sudaṃ āyasmato ",
  "thag1.14:1.7": "vanavacchassa therassa sāmaṇero gāthaṃ abhāsitthā’ti. "
}
