{
  "thag16.8:0.1": "",
  "thag16.8:0.2": "",
  "thag16.8:0.3": "",
  "thag16.8:0.4": "20. 1. 8. bhaddiyattheragāthā. ",
  "thag16.8:1.1": "gacchaṃ vadesi samaṇaṭṭhitomhi ",
  "thag16.8:1.2": "mamaṃ ca brūsi ṭhitamaṭṭhito’ti, ",
  "thag16.8:1.3": "pucchāmi taṃ samaṇa etamatthaṃ ",
  "thag16.8:1.4": "kathaṃ ṭhito tvaṃ ahamaṭṭhitomhi. ",
  "thag16.8:2.1": "ṭhito ahaṃ aṅgulimāla sabbadā ",
  "thag16.8:2.2": "sabbesu bhūtesu nidhāya daṇḍaṃ, ",
  "thag16.8:2.3": "tuvañca pāṇesu asaññatosi ",
  "thag16.8:2.4": "tasmā ṭhitohaṃ tuvamaṭṭhitosi. ",
  "thag16.8:3.1": "cirassaṃ vata me mahito mahesi ",
  "thag16.8:3.2": "mahāvanaṃ samaṇo paccupādi, ",
  "thag16.8:3.3": "so’haṃ cajissāmi sahassapāpaṃ ",
  "thag16.8:3.4": "sutvāna gāthaṃ tava dhammayuttaṃ. ",
  "thag16.8:4.1": "icceva coro asimāvudhaṃ ca ",
  "thag16.8:4.2": "sobbhe papāte narake anvakāsi, ",
  "thag16.8:4.3": "avandi coro sugatassa pāde ",
  "thag16.8:4.4": "tattheva pabbajjamayāci buddhaṃ. ",
  "thag16.8:5.1": "buddho ca kho kāruṇiko mahesi ",
  "thag16.8:5.2": "yo satthā lokassa sadevakassa, ",
  "thag16.8:5.3": "tamehi bhikkhū’ti tadā avoca ",
  "thag16.8:5.4": "eso’va tassa ahu bhikkhubhāvo. ",
  "thag16.8:6.1": "yo ca pubbe pamajjitvā ",
  "thag16.8:6.2": "pacchā so nappamajjati, ",
  "thag16.8:6.3": "so’maṃ lokaṃ pabhāseti ",
  "thag16.8:6.4": "abbhā mutto’va candimā. ",
  "thag16.8:7.1": "yassa pāpaṃ kataṃ kammaṃ ",
  "thag16.8:7.2": "kusalena pithīyati, ",
  "thag16.8:7.3": "so’maṃ lokaṃ pabhāseti ",
  "thag16.8:7.4": "abbhā mutto’va candimā. ",
  "thag16.8:8.1": "yo have daharo bhikkhu ",
  "thag16.8:8.2": "yuñjati buddhasāsane, ",
  "thag16.8:8.3": "so’maṃ lokaṃ pabhāseti ",
  "thag16.8:8.4": "abbhā mutto’va candimā. ",
  "thag16.8:9.1": "disā’pi me dhammakathaṃ suṇantu ",
  "thag16.8:9.2": "disā’pi me yuñjantu buddhasāsane, ",
  "thag16.8:9.3": "disā’pi me te manuje bhajantu ",
  "thag16.8:9.4": "ye dhammamevādāpenti santo. ",
  "thag16.8:10.1": "disā hi me khantivādānaṃ ",
  "thag16.8:10.2": "avirodhappasaṃsinaṃ, ",
  "thag16.8:10.3": "suṇantu dhammaṃ kālena ",
  "thag16.8:10.4": "tañca anuvidhīyantu. ",
  "thag16.8:11.1": "nahi jātu so mamaṃ hiṃse ",
  "thag16.8:11.2": "aññaṃ vā pana kiñcanaṃ, ",
  "thag16.8:11.3": "pappuyya paramaṃ santiṃ ",
  "thag16.8:11.4": "rakkheyya tasathāvare. ",
  "thag16.8:12.1": "udakaṃ hi nayanti nettikā ",
  "thag16.8:12.2": "usukārā namayanti tejanaṃ, ",
  "thag16.8:12.3": "dāruṃ namayanti tacchakā ",
  "thag16.8:12.4": "attānaṃ damayanti paṇḍitā. ",
  "thag16.8:13.1": "daṇḍeneke damayanti ",
  "thag16.8:13.2": "aṅkusehi kasāhi ca, ",
  "thag16.8:13.3": "adaṇḍena asatthena ",
  "thag16.8:13.4": "ahaṃ antomhi tādinā. ",
  "thag16.8:14.1": "abhiṃsako’ti me nāmaṃ ",
  "thag16.8:14.2": "hiṃsakassa pure sato, ",
  "thag16.8:14.3": "ajjāhaṃ saccanāmomhi ",
  "thag16.8:14.4": "na naṃ hiṃsāmi kiñcanaṃ. ",
  "thag16.8:15.1": "coro ahaṃ pure āsiṃ ",
  "thag16.8:15.2": "aṅgulimālo’ti vissuto, ",
  "thag16.8:15.3": "vuyhamāno mahoghena ",
  "thag16.8:15.4": "buddhaṃ saraṇamāgamaṃ. ",
  "thag16.8:16.1": "lohitapāṇī pure āsiṃ ",
  "thag16.8:16.2": "aṅgulimālo’ti vissuto, ",
  "thag16.8:16.3": "saraṇāgamanaṃ passa ",
  "thag16.8:16.4": "bhavanetti samūhatā. ",
  "thag16.8:17.1": "tādisaṃ kammaṃ katvāna ",
  "thag16.8:17.2": "bahuṃ duggatigāminaṃ ",
  "thag16.8:17.3": "phuṭṭho kammavipākena ",
  "thag16.8:17.4": "anaṇo bhuñjāmi bhojanaṃ. ",
  "thag16.8:18.1": "pamādamanuyuñjanti ",
  "thag16.8:18.2": "bālā dummedhino janā. ",
  "thag16.8:18.3": "appamādaṃ ca medhāvī ",
  "thag16.8:18.4": "dhanaṃ seṭṭhaṃ’va rakkhati. ",
  "thag16.8:19.1": "mā pamādamanuyuñjetha ",
  "thag16.8:19.2": "mā kāmaratisanthavaṃ, ",
  "thag16.8:19.3": "appamatto hi jhāyanto ",
  "thag16.8:19.4": "pappoti paramaṃ sukhaṃ. ",
  "thag16.8:20.1": "svāgataṃ nāpagataṃ ",
  "thag16.8:20.2": "netaṃ dummantitaṃ mama, ",
  "thag16.8:20.3": "saṃvibhattesu dhammesu ",
  "thag16.8:20.4": "yaṃ seṭṭhaṃ tadupāgamaṃ. ",
  "thag16.8:21.1": "svāgataṃ nāpagataṃ ",
  "thag16.8:21.2": "netaṃ dummantitaṃ mama, ",
  "thag16.8:21.3": "tisso vijjā anuppattā ",
  "thag16.8:21.4": "kataṃ buddhassa sāsanaṃ. ",
  "thag16.8:22.1": "araññe rukkhamūle vā ",
  "thag16.8:22.2": "pabbatesu guhāsu vā, ",
  "thag16.8:22.3": "tattha tattheva aṭṭhāsiṃ ",
  "thag16.8:22.4": "ubbiggamanaso tadā. ",
  "thag16.8:23.1": "sukhaṃ sayāmi ṭhāyāmi ",
  "thag16.8:23.2": "sukhaṃ kappemi jīvitaṃ, ",
  "thag16.8:23.3": "ahatthapāso mārassa ",
  "thag16.8:23.4": "aho satthānukampito. ",
  "thag16.8:24.1": "brahmajacco pure āsiṃ ",
  "thag16.8:24.2": "udicco ubhato ahu, ",
  "thag16.8:24.3": "sojja putto sugatassa ",
  "thag16.8:24.4": "dhammarājassa satthuno. ",
  "thag16.8:25.1": "vītataṇho anādāno ",
  "thag16.8:25.2": "guttadvāro susaṃvuto, ",
  "thag16.8:25.3": "aghamūlaṃ vadhitvāna ",
  "thag16.8:25.4": "patto me āsavakkhayo. ",
  "thag16.8:26.1": "pariciṇṇo mayā satthā ",
  "thag16.8:26.2": "kataṃ buddhassa sāsanaṃ, ",
  "thag16.8:26.3": "ohito garuko bhāro ",
  "thag16.8:26.4": "bhavanetti samūhatā’ti. itthaṃ sudaṃ āyasmā ",
  "thag16.8:26.5": "aṅgulimālo thero gāthāyo abhāsitthā’ti. "
}
