  "thag1.35:0.3": "",
  "thag1.35:0.4": "1. 4. 5. ",
  "thag1.35:1.1": "sukhaṃ sukhattho labhate tadācaraṃ ",
  "thag1.35:1.2": "kittiṃ ca pappoti yasassa vaḍḍhati ",
  "thag1.35:1.3": "yo ariyamaṭṭhaṅgikamañjasaṃ ujuṃ ",
  "thag1.35:1.4": "bhāveti maggaṃ amatassa pattiyā’ti. itthaṃ sudaṃ āyasmā ",
  "thag1.35:1.5": "sāmaññakānitthero gāthaṃ abhāsitthā’ti. sāmaññakānittheragāthā. "
}
