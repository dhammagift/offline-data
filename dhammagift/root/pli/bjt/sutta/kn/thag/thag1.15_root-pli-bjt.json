  "thag1.15:0.4": "1. 2. 5. ",
  "thag1.15:1.1": "pañca chinde pañca jahe ",
  "thag1.15:1.2": "pañca cuttari bhāvaye ",
  "thag1.15:1.3": "pañcasaṅgātigo bhikkhu ",
  "thag1.15:1.4": "oghatiṇṇo’ti vuccatī’ti. itthaṃ sudaṃ āyasmā ",
  "thag1.15:1.5": "kuṇḍadhāno thero gāthaṃ abhāsitthā’ti. kuṇḍadhānattheragāthā. "
}
