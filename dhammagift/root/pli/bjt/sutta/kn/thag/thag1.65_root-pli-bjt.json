  "thag1.65:0.4": "1. 7. 5. vimalakoṇḍaññattheragāthā. ",
  "thag1.65:1.1": "ukkhepakaṭavacchassa ",
  "thag1.65:1.2": "saṅkalitaṃ bahūhi vassehi ",
  "thag1.65:1.3": "taṃ bhāsati gahaṭṭhānaṃ ",
  "thag1.65:1.4": "sunisinno uḷārapāmojjo’ti. itthaṃ sudaṃ āyasmā ",
  "thag1.65:1.5": "ukkhepakaṭavaccho thero gāthaṃ abhāsitthā’ti. "
}
