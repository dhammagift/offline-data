  "thag1.12:0.3": "",
  "thag1.12:0.4": "1. 2. 2. ",
  "thag1.12:1.1": "paññābalī sīlavatūpapanno ",
  "thag1.12:1.2": "samāhito jhānarato satīmā ",
  "thag1.12:1.3": "yadatthiyaṃ bhojanaṃ bhuñjamāno ",
  "thag1.12:1.4": "kaṅkhetha kālaṃ idha vītarāgo’ti. itthaṃ sudaṃ āyasmā ",
  "thag1.12:1.5": "mahāvaccho thero gāthaṃ abhāsitthā’ti. mahāvacchattheragāthā. "
}
