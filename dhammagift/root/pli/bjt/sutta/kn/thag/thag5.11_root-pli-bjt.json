{
  "thag5.11:0.1": "",
  "thag5.11:0.2": "",
  "thag5.11:0.3": "",
  "thag5.11:0.4": "5. 1. 11. ",
  "thag5.11:1.1": "upasampadā ca me laddhā ",
  "thag5.11:1.2": "vimutto camhi anāsavo, ",
  "thag5.11:1.3": "so ca me bhagavā diṭṭho ",
  "thag5.11:1.4": "vihāre ca sahāvasiṃ. ",
  "thag5.11:2.1": "bahudeva rattiṃ bhagavā ",
  "thag5.11:2.2": "abbhokāsetināmayi, ",
  "thag5.11:2.3": "vihārakusalo satthā ",
  "thag5.11:2.4": "vihāraṃ pāvisī tadā. ",
  "thag5.11:3.1": "santharitvāna saṅghāṭiṃ ",
  "thag5.11:3.2": "seyyaṃ kappesi gotamo, ",
  "thag5.11:3.3": "sīho selaguhāyaṃ’va ",
  "thag5.11:3.4": "pahīnabhayabheravo. ",
  "thag5.11:4.1": "tato kalyāṇavākkaraṇo ",
  "thag5.11:4.2": "sammāsambuddhasāvako, ",
  "thag5.11:4.3": "soṇo abhāsi saddhammaṃ ",
  "thag5.11:4.4": "buddhaseṭṭhassa sammukhā. ",
  "thag5.11:5.1": "pañcakkhandhe pariññāya ",
  "thag5.11:5.2": "bhāvayitvāna añjasaṃ, ",
  "thag5.11:5.3": "pappuyya paramaṃ santiṃ ",
  "thag5.11:5.4": "parinibbissatyanāsavo’ti. itthaṃ sudaṃ āyasmā ",
  "thag5.11:5.5": "soṇo thero gāthāyo abhāsitthā’ti. soṇakuṭikaṇṇattheragāthā. "
}
