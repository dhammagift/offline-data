  "thag1.54:0.4": "1. 6. 4. ",
  "thag1.54:1.1": "vassati devo yathā sugītaṃ ",
  "thag1.54:1.2": "channā me kuṭikā sukhā nivātā ",
  "thag1.54:1.3": "tassaṃ viharāmi adutiyo ",
  "thag1.54:1.4": "atha ce patthayasi pavassa devā’ti. itthaṃ sudaṃ āyasmā ",
  "thag1.54:1.5": "uttiyo thero gāthaṃ abhāsitthā’ti. uttiyattheragāthā. "
}
