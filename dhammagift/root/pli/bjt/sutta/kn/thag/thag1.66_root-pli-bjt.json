  "thag1.66:0.3": "",
  "thag1.66:0.4": "1. 7. 6. ",
  "thag1.66:1.1": "anusāsi mahāvīro ",
  "thag1.66:1.2": "sabbadhammānapāragū ",
  "thag1.66:1.3": "tassāhaṃ dhammaṃ sutvāna ",
  "thag1.66:1.4": "vihāsiṃ santike sato ",
  "thag1.66:1.5": "tisso vijjā anuppattā ",
  "thag1.66:1.6": "kataṃ buddhassa sāsana’nti. itthaṃ sudaṃ āyasmā ",
  "thag1.66:1.7": "meghiyo thero gāthaṃ abhāsitthā’ti. meghiyattheragāthā. "
}
