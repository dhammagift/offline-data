  "thag1.68:0.3": "",
  "thag1.68:0.4": "1. 7. 8. ekadhammasavanīyattheragāthā. ",
  "thag1.68:1.1": "adhicetaso appamajjato ",
  "thag1.68:1.2": "munino monapathesu sikkhato ",
  "thag1.68:1.3": "sokā na bhavanti tādino ",
  "thag1.68:1.4": "upasantassa sadā satīmato’ti. itthaṃ sudaṃ āyasmā ",
  "thag1.68:1.5": "ekudāniyo thero gāthaṃ abhāsitthā’ti. "
}
