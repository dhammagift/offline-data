  "thag2.24:0.3": "",
  "thag2.24:0.4": "2. 3. 4. sobhitattheragāthā. ",
  "thag2.24:1.1": "yaṃ kiccaṃ daḷhaviriyena ",
  "thag2.24:1.2": "yaṃ kiccaṃ boddhumicchatā, ",
  "thag2.24:1.3": "karissaṃ nāvarujjhissaṃ ",
  "thag2.24:1.4": "passa viriyaṃ parakkamaṃ. ",
  "thag2.24:2.1": "tvaṃ ca me maggamakkhāhi ",
  "thag2.24:2.2": "añjasaṃ amatogadhaṃ, ",
  "thag2.24:2.3": "ahaṃ monena monissaṃ ",
  "thag2.24:2.4": "gaṅgāsoto’va sāgaranti. itthaṃ sudaṃ āyasmā ",
  "thag2.24:2.5": "valliyo thero gāthāyo abhāsitthā’ti. "
}
