  "thag3.2:0.1": "",
  "thag3.2:0.2": "",
  "thag3.2:0.3": "",
  "thag3.2:0.4": "3. 1. 2. ",
  "thag3.2:1.1": "pañcāhāhaṃ pabbajito ",
  "thag3.2:1.2": "sekho appattamānaso, ",
  "thag3.2:1.3": "vihāraṃ me paviṭṭhassa ",
  "thag3.2:1.4": "cetaso paṇidhī ahu. ",
  "thag3.2:2.1": "nāsissaṃ na pivissāmi ",
  "thag3.2:2.2": "vihārato na nikkhame, ",
  "thag3.2:2.3": "napi passaṃ nipātessaṃ ",
  "thag3.2:2.4": "taṇhāsalle anūhate. ",
  "thag3.2:3.1": "tassa cevaṃ viharato ",
  "thag3.2:3.2": "passa viriyaparakkamaṃ, ",
  "thag3.2:3.3": "tisso vijjā anupupattā ",
  "thag3.2:3.4": "kataṃ buddhassa sāsana’nti. itthaṃ sudaṃ āyasmā ",
  "thag3.2:3.5": "paccayo thero gāthāyo abhāsitthā’ti. paccayattheragāthā. "
}
