  "thag1.44:0.4": "1. 5. 4. ",
  "thag1.44:1.1": "mataṃ vā amma rodanti ",
  "thag1.44:1.2": "yo vā jīvaṃ na dissati ",
  "thag1.44:1.3": "jīvantaṃ maṃ amma passantī ",
  "thag1.44:1.4": "kasmā maṃ amma rodasī’ti. itthaṃ sudaṃ āyasmā ",
  "thag1.44:1.5": "sānutthero gāthaṃ abhāsitthā’ti. sānuttheragāthā. "
}
