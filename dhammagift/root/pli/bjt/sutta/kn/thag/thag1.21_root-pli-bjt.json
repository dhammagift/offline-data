  "thag1.21:0.3": "",
  "thag1.21:0.4": "1. 3. 1. ",
  "thag1.21:1.1": "nāhaṃ bhayassa bhāyāmi ",
  "thag1.21:1.2": "satthā no amatassa kovido ",
  "thag1.21:1.3": "yattha bhayaṃ nāvatiṭṭhati ",
  "thag1.21:1.4": "tena maggena vajanti bhikkhavo’ti. itthaṃ sudaṃ āyasmā ",
  "thag1.21:1.5": "nigrodho thero gāthaṃ abhāsitthā’ti. nigrodhattheragāthā. "
}
