  "thag1.107:0.4": "1. 11. 7. ",
  "thag1.107:1.1": "pabbajiṃ tulayitvāna ",
  "thag1.107:1.2": "agārasmānagāriyaṃ, ",
  "thag1.107:1.3": "tisso vijjā anuppattā ",
  "thag1.107:1.4": "kataṃ buddhassa sāsana’nti. itthaṃ sudaṃ āyasmā ",
  "thag1.107:1.5": "dhammasavo thero gāthaṃ abhāsitthā’ti. dhammasavattheragāthā. "
}
