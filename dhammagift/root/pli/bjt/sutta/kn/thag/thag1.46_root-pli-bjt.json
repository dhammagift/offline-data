  "thag1.46:0.3": "",
  "thag1.46:0.4": "1. 5. 6. ",
  "thag1.46:1.1": "saddhāyāhaṃ pabbajito ",
  "thag1.46:1.2": "agārasmānagāriyaṃ ",
  "thag1.46:1.3": "sati paññā ca me vuddhā ",
  "thag1.46:1.4": "cittaṃ ca susamāhitaṃ ",
  "thag1.46:1.5": "kāmaṃ karassu rūpāni ",
  "thag1.46:1.6": "neva maṃ bādhayissasī’ti. itthaṃ sudaṃ āyasmā ",
  "thag1.46:1.7": "samiddhitthero gāthaṃ abhāsitthā’ti. samiddhittheragāthā. "
}
