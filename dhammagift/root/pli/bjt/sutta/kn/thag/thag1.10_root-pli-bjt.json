  "thag1.10:0.3": "",
  "thag1.10:0.4": "1. 1. 10. piḷindavacchattheragāthā. ",
  "thag1.10:1.1": "vihari apekkhaṃ idha vā huraṃ vā ",
  "thag1.10:1.2": "yo vedagū samito yatatto ",
  "thag1.10:1.3": "sabbesu dhammesu anūpalitto ",
  "thag1.10:1.4": "lokassa dhaññā udayabbayaññā’ti. ",
  "thag1.10:1.5": "itthaṃ sudaṃ āyasmā puṇṇamāso thero gāthaṃ abhāsitthā’ti. ",
  "thag1.10:1.6": "puṇṇamāsattheragāthā. paṭhamo vaggo. ",
  "thag1.10:2.0": "tassuddānaṃ: ",
  "thag1.10:2.1": "subhūti koṭṭhito thero ",
  "thag1.10:2.2": "kaṅkhārevatasammato ",
  "thag1.10:2.3": "mantāṇiputto dabbo ca ",
  "thag1.10:2.4": "sītavaniyo ca bhalliyo ",
  "thag1.10:2.5": "vīro piḷindavaccho ca ",
  "thag1.10:2.6": "puṇṇamāso tamonudo’ti. dutiyo vaggo "
}
