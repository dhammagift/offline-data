  "thag1.18:0.3": "",
  "thag1.18:0.4": "1. 2. 8. dāsakattheragāthā. ",
  "thag1.18:1.1": "ahu buddhassa dāyādo ",
  "thag1.18:1.2": "bhikkhu bhesakalāvane ",
  "thag1.18:1.3": "kevalaṃ aṭṭhikasaññāya ",
  "thag1.18:1.4": "apharī paṭhaviṃ imaṃ ",
  "thag1.18:1.5": "maññe’haṃ kāmarāgaṃ so ",
  "thag1.18:1.6": "khippameva pahissatīti. ",
  "thag1.18:1.7": "itthaṃ sudaṃ āyasmā sigālapitā thero gāthaṃ abhāsitthā’ti. "
}
