  "thag1.96:0.4": "1. 10. 6. cakkhupālattheragāthā. ",
  "thag1.96:1.1": "ekapupphaṃ cajitvāna ",
  "thag1.96:1.2": "asītiṃ vassakoṭiyo, ",
  "thag1.96:1.3": "saggesu paracāretvā ",
  "thag1.96:1.4": "sesakenamhi nibbuto’ti. itthaṃ sudaṃ āyasmā ",
  "thag1.96:1.5": "khaṇḍasumano thero gāthaṃ abhāsitthā’ti. "
}
