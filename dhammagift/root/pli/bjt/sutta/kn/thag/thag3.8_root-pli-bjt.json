  "thag3.8:0.3": "",
  "thag3.8:0.4": "3. 1. 8. ",
  "thag3.8:1.1": "ekopi saddho medhāvī ",
  "thag3.8:1.2": "assaddhānīdha ñātinaṃ, ",
  "thag3.8:1.3": "dhammaṭṭho sīlasampanno ",
  "thag3.8:1.4": "hoti atthāya bandhunaṃ, ",
  "thag3.8:2.1": "niggayha anukampāya ",
  "thag3.8:2.2": "codito ñātayo mayā, ",
  "thag3.8:2.3": "ñātibandhavapemena ",
  "thag3.8:2.4": "kāraṃ katvāna bhikkhūsu. ",
  "thag3.8:3.1": "te abbhatītā kālaṃkatā ",
  "thag3.8:3.2": "pattā te tividhaṃ sukhaṃ, ",
  "thag3.8:3.3": "bhātaro mayuhaṃ mātā ca ",
  "thag3.8:3.4": "modanti kāmakāmino’ti. ",
  "thag3.8:3.5": "itthaṃ sudaṃ āyasmā passiko thero gāthāyo abhāsitthā’ti. passikattheragāthā. "
}
