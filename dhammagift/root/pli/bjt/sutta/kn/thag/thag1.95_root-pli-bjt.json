  "thag1.95:0.3": "",
  "thag1.95:0.4": "1. 10. 5. mettajittheragāthā. ",
  "thag1.95:1.1": "andhohaṃ hatanettosmi ",
  "thag1.95:1.2": "kantāraddhānapakkanto, ",
  "thag1.95:1.3": "sayamāno’pi gacchissaṃ ",
  "thag1.95:1.4": "na sahāyena pāpenā’ti. itthaṃ sudaṃ āyasmā ",
  "thag1.95:1.5": "cakkhupālo thero gāthaṃ abhāsitthā’ti. "
}
