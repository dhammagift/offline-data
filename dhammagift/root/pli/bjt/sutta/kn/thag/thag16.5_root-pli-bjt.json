{
  "thag16.5:0.1": "",
  "thag16.5:0.2": "",
  "thag16.5:0.3": "",
  "thag16.5:0.4": "20. 1. 5. ",
  "thag16.5:1.1": "rūpaṃ disvā sati muṭṭhā ",
  "thag16.5:1.2": "piyaṃ nimittaṃ manasikaroto, ",
  "thag16.5:1.3": "sārattacitto vedeti ",
  "thag16.5:1.4": "taṃ ca ajjhossa tiṭṭhati. ",
  "thag16.5:2.1": "tassa vaḍḍhanti vedanā ",
  "thag16.5:2.2": "anekā rūpasambhavā, ",
  "thag16.5:2.3": "abhijjhā ca vihesā ca ",
  "thag16.5:2.4": "cittamassūpahaññati, ",
  "thag16.5:2.5": "evamācinato dukkhaṃ ",
  "thag16.5:2.6": "ārā nibbānaṃ vuccati. ",
  "thag16.5:3.1": "saddaṃ sutvā sati muṭṭhā ",
  "thag16.5:3.2": "piyaṃ nimittaṃ manasikaroto, ",
  "thag16.5:3.3": "sārattacitto vedeti ",
  "thag16.5:3.4": "taṃ ca ajjhossa tiṭṭhati. ",
  "thag16.5:4.1": "tassa vaḍḍhanti vedanā ",
  "thag16.5:4.2": "anekā saddasambhavā, ",
  "thag16.5:4.3": "abhijjhā ca vihesā ca ",
  "thag16.5:4.4": "cittamassūpahaññati, ",
  "thag16.5:4.5": "evamācinato dukkhaṃ ",
  "thag16.5:4.6": "ārā nibbānaṃ vuccati. ",
  "thag16.5:5.1": "gandhaṃ ghatvā sati muṭṭhā ",
  "thag16.5:5.2": "piyaṃ nimittaṃ manasikaroto, ",
  "thag16.5:5.3": "sārattacitto vedeti ",
  "thag16.5:5.4": "taṃ ca ajjhossa tiṭṭhati. ",
  "thag16.5:6.1": "tassa vaḍḍhanti vedanā ",
  "thag16.5:6.2": "anekā gandhasambhavā, ",
  "thag16.5:6.3": "abhijjhā ca vihesā ca ",
  "thag16.5:6.4": "cittamassūpahaññati, ",
  "thag16.5:6.5": "evamācinato dukkhaṃ ",
  "thag16.5:6.6": "ārā nibbānaṃ vuccati. ",
  "thag16.5:7.1": "rasaṃ bhotvā sati muṭṭhā ",
  "thag16.5:7.2": "piyaṃ nimittaṃ manasikaroto, ",
  "thag16.5:7.3": "sārattacitto vedeti ",
  "thag16.5:7.4": "taṃ ca ajjhossa tiṭṭhati. ",
  "thag16.5:8.1": "tassa vaḍḍhanti vedanā ",
  "thag16.5:8.2": "anekā rasasambhavā, ",
  "thag16.5:8.3": "abhijjhā ca vihesā ca ",
  "thag16.5:8.4": "cittamassūpahaññati, ",
  "thag16.5:8.5": "evamācinato dukkhaṃ ",
  "thag16.5:8.6": "ārā nibbānaṃ vuccati. ",
  "thag16.5:9.1": "phassaṃ phussa sati muṭṭhā ",
  "thag16.5:9.2": "piyaṃ nimittaṃ manasi karoto, ",
  "thag16.5:9.3": "sārattacitto vedeti ",
  "thag16.5:9.4": "taṃ ca ajjhossa tiṭṭhati. ",
  "thag16.5:10.1": "tassa vaḍḍhanti vedanā ",
  "thag16.5:10.2": "anekā phassasambhavā, ",
  "thag16.5:10.3": "abhijjhā ca vihesā ca ",
  "thag16.5:10.4": "cittamassūpahaññati, ",
  "thag16.5:10.5": "evamācinato dukkhaṃ ",
  "thag16.5:10.6": "ārā nibbānaṃ vuccati. ",
  "thag16.5:11.1": "dhammaṃ ñatvā sati muṭṭhā ",
  "thag16.5:11.2": "piyaṃ nimittaṃ manasikaroto, ",
  "thag16.5:11.3": "sārattacitto vedeti ",
  "thag16.5:11.4": "taṃ ca ajjhossa tiṭṭhati. ",
  "thag16.5:12.1": "tassa vaḍḍhanti vedanā ",
  "thag16.5:12.2": "anekā dhammasambhavā, ",
  "thag16.5:12.3": "abhijjhā ca vihesā ca ",
  "thag16.5:12.4": "cittamassūpahaññati, ",
  "thag16.5:12.5": "evamācinato dukkhaṃ ",
  "thag16.5:12.6": "ārā nibbānaṃ vuccati. ",
  "thag16.5:13.1": "na so rajjati rūpesu ",
  "thag16.5:13.2": "rūpaṃ disvā patissato, ",
  "thag16.5:13.3": "virattacitto vedeti ",
  "thag16.5:13.4": "taṃ ca nājjhossa tiṭṭhati. ",
  "thag16.5:14.1": "yathāssa passato rūpaṃ ",
  "thag16.5:14.2": "sevato cā’pi vedanaṃ, ",
  "thag16.5:14.3": "khīyati nopacīyati ",
  "thag16.5:14.4": "evaṃ so caratī sato, ",
  "thag16.5:14.5": "evaṃ apacinato dukkhaṃ ",
  "thag16.5:14.6": "santike nibbānaṃ vuccati. ",
  "thag16.5:15.1": "na so rajjati saddesu ",
  "thag16.5:15.2": "saddaṃ sutvā patissato, ",
  "thag16.5:15.3": "virattacitto vedeti ",
  "thag16.5:15.4": "taṃ ca nājjhossa tiṭṭhati. ",
  "thag16.5:16.1": "yathāssa suṇato saddaṃ ",
  "thag16.5:16.2": "sevato cā’pi vedanaṃ, ",
  "thag16.5:16.3": "khīyati nopacīyati ",
  "thag16.5:16.4": "evaṃ so caratī sato, ",
  "thag16.5:16.5": "evaṃ apacinato dukkhaṃ ",
  "thag16.5:16.6": "santike nibbānaṃ vuccati. ",
  "thag16.5:17.1": "na so rajjati gandhesu ",
  "thag16.5:17.2": "gandhaṃ ghatvā patissato, ",
  "thag16.5:17.3": "virattacitto vedeti ",
  "thag16.5:17.4": "taṃ ca nājjhossa tiṭṭhatī’ti. ",
  "thag16.5:18.1": "yathāssa ghāyato gandhaṃ ",
  "thag16.5:18.2": "sevato cā’pi vedanaṃ, ",
  "thag16.5:18.3": "khīyati nopacīyati ",
  "thag16.5:18.4": "evaṃ so caratī sato, ",
  "thag16.5:18.5": "evaṃ apacinato dukkhaṃ ",
  "thag16.5:18.6": "santike nibbānaṃ vuccati. ",
  "thag16.5:19.1": "na so rajjati rasesu ",
  "thag16.5:19.2": "rasaṃ bhotvā patissato, ",
  "thag16.5:19.3": "virattacitto vedeti ",
  "thag16.5:19.4": "taṃ ca nājjhossa tiṭṭhati. ",
  "thag16.5:20.1": "yathāssa sāyato rasaṃ ",
  "thag16.5:20.2": "sevato cā’pi vedanaṃ, ",
  "thag16.5:20.3": "khīyati nopacīyati ",
  "thag16.5:20.4": "evaṃ so caratī sato, ",
  "thag16.5:20.5": "evaṃ apacinato dukkhaṃ ",
  "thag16.5:20.6": "santike nibbānaṃ vuccati. ",
  "thag16.5:21.1": "na so rajjati phassesu ",
  "thag16.5:21.2": "phassaṃ phussa patissato, ",
  "thag16.5:21.3": "virattacitto vedeti ",
  "thag16.5:21.4": "taṃ ca nājjhossa tiṭṭhati. ",
  "thag16.5:22.1": "yathāssa phusato phassaṃ ",
  "thag16.5:22.2": "sevato cā’pi vedanaṃ, ",
  "thag16.5:22.3": "khīyati nopacīyati ",
  "thag16.5:22.4": "evaṃ so caratī sati, ",
  "thag16.5:22.5": "evaṃ apacinato dukkhaṃ ",
  "thag16.5:22.6": "santike nibbānaṃ vuccati. ",
  "thag16.5:23.1": "na so rajjati dhammesu ",
  "thag16.5:23.2": "dhammaṃ ñatvā patissato, ",
  "thag16.5:23.3": "virattacitto vedeti ",
  "thag16.5:23.4": "taṃ ca nājjhossa tiṭṭhati. ",
  "thag16.5:24.1": "yathāssa vijānato dhammaṃ ",
  "thag16.5:24.2": "sevato cā’pi vedanaṃ, ",
  "thag16.5:24.3": "khīyati nopacīyati ",
  "thag16.5:24.4": "evaṃ so caratī sato, ",
  "thag16.5:24.5": "evaṃ apacinato dukkhaṃ ",
  "thag16.5:24.6": "santike nibbānaṃ vuccatī’ti. itthaṃ sudaṃ ",
  "thag16.5:24.7": "āyasmā māluṅkyaputto thero gāthāyo abhāsitthā’ti. māluṅkyaputtattheragāthā. "
}
