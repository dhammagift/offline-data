  "thag1.90:0.3": "",
  "thag1.90:0.4": "1. 9. 10. ",
  "thag1.90:1.1": "pañcakkhandhā pariññātā ",
  "thag1.90:1.2": "tiṭṭhanti chinnamūlakā, ",
  "thag1.90:1.3": "vikkhīṇo jātisaṃsāro ",
  "thag1.90:1.4": "natthi dāni punabbhavo’ti. itthaṃ sudaṃ āyasmā ",
  "thag1.90:1.5": "sāmidatto thero gāthaṃ abhāsitthā’ti. sāmidattattheragāthā. navamo ",
  "thag1.90:1.6": "vaggo. ",
  "thag1.90:2.0": "tassuddānaṃ: ",
  "thag1.90:2.1": "thero samitigutto ca ",
  "thag1.90:2.2": "kassapo sīhasavhayo ",
  "thag1.90:2.3": "nīto sunāgo nāgito ",
  "thag1.90:2.4": "paviṭṭho ajjuno isi, ",
  "thag1.90:2.5": "devasabho ca yo thero ",
  "thag1.90:2.6": "sāmidatto mahabbalo’ti. dasamo vaggo. "
}
