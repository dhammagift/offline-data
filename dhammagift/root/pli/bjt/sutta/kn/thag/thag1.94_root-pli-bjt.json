  "thag1.94:0.3": "",
  "thag1.94:0.4": "1. 10. 4. ",
  "thag1.94:1.1": "namo hi tassa bhagavato ",
  "thag1.94:1.2": "sakyaputtassa sirīmato, ",
  "thag1.94:1.3": "tenāyaṃ aggappattena ",
  "thag1.94:1.4": "aggo dhammo sudesito’ti. itthaṃ sudaṃ āyasmā ",
  "thag1.94:1.5": "mettaji thero gāthaṃ abhāsitthā’ti. mettajittheragāthā. "
}
