{
  "thag2.41:0.1": "",
  "thag2.41:0.2": "",
  "thag2.41:0.3": "vaggo pañcamo. ",
  "thag2.41:0.4": "2. 5. 1. ",
  "thag2.41:1.1": "aho buddhā aho dhammā ",
  "thag2.41:1.2": "aho no satthu sampadā, ",
  "thag2.41:1.3": "yattha etādisaṃ dhammaṃ ",
  "thag2.41:1.4": "sāvako sacchikāhisi. ",
  "thag2.41:2.1": "asaṅkheyyesu kappesu ",
  "thag2.41:2.2": "sakkāyādhigatā ahū ",
  "thag2.41:2.3": "tesamayaṃ pacchiko carimo’ ",
  "thag2.41:2.4": "yaṃ samussayo, ",
  "thag2.41:2.5": "jātimaraṇasaṃsāro ",
  "thag2.41:2.6": "natthi dāni punabbhavo’ti. itthaṃ sudaṃ āyasmā ",
  "thag2.41:2.7": "kumārakassapo thero gāthāyo abhāsitthā’ti. "
}
