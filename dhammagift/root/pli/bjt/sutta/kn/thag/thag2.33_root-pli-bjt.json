  "thag2.33:0.1": "",
  "thag2.33:0.2": "",
  "thag2.33:0.3": "",
  "thag2.33:0.4": "2. 4. 3. ",
  "thag2.33:1.1": "arahaṃ sugato loke ",
  "thag2.33:1.2": "vātehābādhito muni, ",
  "thag2.33:1.3": "sace uṇhodakaṃ atthi ",
  "thag2.33:1.4": "munino dehi brāhmaṇa. ",
  "thag2.33:2.1": "pūjito pūjanīyānaṃ ",
  "thag2.33:2.2": "sakkareyyāna sakkato, ",
  "thag2.33:2.3": "apacitopacanīyānaṃ ",
  "thag2.33:2.4": "tassa icchāmi hātave’ti. itthaṃ sudaṃ āyasmā ",
  "thag2.33:2.5": "upavāno thero gāthāyo abhāsitthā’ti. upavānattheragāthā. "
}
