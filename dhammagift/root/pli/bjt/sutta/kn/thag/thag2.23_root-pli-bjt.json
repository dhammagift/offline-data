  "thag2.23:0.1": "",
  "thag2.23:0.2": "",
  "thag2.23:0.3": "",
  "thag2.23:0.4": "2. 3. 3. ",
  "thag2.23:1.1": "satimā paññavā bhikkhu ",
  "thag2.23:1.2": "āraddhabalavīriyo, ",
  "thag2.23:1.3": "pañcakappasatānāhaṃ ",
  "thag2.23:1.4": "ekarattiṃ anussariṃ. ",
  "thag2.23:2.1": "cattāro satipaṭṭhāne ",
  "thag2.23:2.2": "satta aṭṭha ca bhāvayaṃ, ",
  "thag2.23:2.3": "pañcakappasatānāhaṃ ",
  "thag2.23:2.4": "ekarattiṃ anussarinti. itthaṃ sudaṃ āyasmā ",
  "thag2.23:2.5": "sobhito thero gāthāyo abhāsitthā’ti. sobhitattheragāthā. "
}
