  "thag1.37:0.3": "",
  "thag1.37:0.4": "1. 4. 7. ",
  "thag1.37:1.1": "nānājanapadaṃ yanti ",
  "thag1.37:1.2": "vicaranto asaññatā ",
  "thag1.37:1.3": "samādhiṃ ca virodhenti ",
  "thag1.37:1.4": "kiṃsu raṭṭhacariyā karissati ",
  "thag1.37:1.5": "tasmā vineyya sārambhaṃ ",
  "thag1.37:1.6": "jhāyeyya apurakkhato’ti. itthaṃ sudaṃ āyasmā ",
  "thag1.37:1.7": "kumāputtattherassa sahāyakā thero gāthaṃ abhāsitthā’ti. kumāputtasahāyakattheragāthā. "
}
