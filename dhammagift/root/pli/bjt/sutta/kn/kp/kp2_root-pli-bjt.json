{
  "kp2:0.1": "",
  "kp2:0.2": "2. dasasikkhāpadaṃ ",
  "kp2:1.1": "pāṇātipātā veramaṇīsikkhāpadaṃ samādiyāmi. ",
  "kp2:2.1": "adinnādānā veramaṇīsikkhāpadaṃ samādiyāmi. ",
  "kp2:3.1": "abrahmacariyā veramaṇīsikkhāpadaṃ samādiyāmi. ",
  "kp2:4.1": "musāvādā veramaṇīsikkhāpadaṃ samādiyāmi. ",
  "kp2:5.1": "surāmerayamajjapamādaṭṭhānā veramaṇīsikkhāpadaṃ samādiyāmi . ",
  "kp2:6.1": "vikālabhojanā veramaṇīsikkhāpadaṃ samādiyāmi. ",
  "kp2:7.1": "naccagītavāditavisūkadassanā veramaṇīsikkhāpadaṃ samādiyāmi. ",
  "kp2:8.1": "mālāgandhavilepanadhāraṇamaṇḍanavibhūsanaṭṭhānā veramaṇīsikkhāpadaṃ samādiyāmi. ",
  "kp2:9.1": "uccāsayanamahāsayanā veramaṇīsikkhāpadaṃ samādiyāmi. ",
  "kp2:10.1": "jātarūparajatapaṭiggahaṇā veramaṇīsikkhāpadaṃ samādiyāmi. ",
  "kp2:11.1": "dasasikkhāpadaṃ. "
}
