{
  "kp1:0.1": "suttantapiṭake khuddakanikāyo (paṭhamo gantho) khuddakapāṭhapāḷi namo tassa bhagavato arahato sammāsambuddhassa. ",
  "kp1:0.2": "1. saraṇagamanaṃ ",
  "kp1:1.1": "",
  "kp1:2.1": "buddhaṃ saraṇaṃ gacchāmi. ",
  "kp1:2.2": "dhammaṃ saraṇaṃ gacchāmi. ",
  "kp1:2.3": "saṅghaṃ saraṇaṃ gacchāmi. ",
  "kp1:3.1": "dutiyampi buddhaṃ saraṇaṃ gacchāmi. ",
  "kp1:3.2": "dutiyampi dhammaṃ saraṇaṃ gacchāmi. ",
  "kp1:3.3": "dutiyampi saṅghaṃ saraṇaṃ gacchāmi. ",
  "kp1:4.1": "tatiyampi buddhaṃ saraṇaṃ gacchāmi. ",
  "kp1:4.2": "tatiyampi dhammaṃ saraṇaṃ gacchāmi. ",
  "kp1:4.3": "tatiyampi saṅghaṃ saraṇaṃ gacchāmi. ",
  "kp1:5.1": "saraṇagamanaṃ. "
}
