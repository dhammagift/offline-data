{
  "snp1.7:0.1": "",
  "snp1.7:0.2": "1. 7. vasala suttaṃ ",
  "snp1.7:1.1": "evaṃ me sutaṃ: ",
  "snp1.7:1.2": "ekaṃ samayaṃ bhagavā sāvatthiyaṃ viharati jetavane anāthapiṇḍikassa ārāme, ",
  "snp1.7:1.3": "atha kho bhagavā pubbanha samayaṃ nivāsetvā pattacīvaraṃ ādāya sāvatthiyaṃ piṇḍāya pāvisi. ",
  "snp1.7:1.4": "tena kho pana samayena aggika bhāradvājassa brāhmaṇassa nivesane aggi pajjalito bhoti āhuti paggahitā. ",
  "snp1.7:1.5": "atha kho bhagavā sāvatthiyaṃ sapadānaṃ piṇḍāyacaramāno yena aggikabhāradvājassa brāhmaṇassa nivesanaṃ tenupasaṅkami. ",
  "snp1.7:2.1": "addasā kho aggikabhāradvājo brāhmaṇo bhagavantaṃ dūrato’va āgacchantaṃ. ",
  "snp1.7:2.2": "disvāna bhagavantaṃ etadavoca: ",
  "snp1.7:2.3": "tatreva muṇḍaka ",
  "snp1.7:2.4": "tatreva samaṇaka ",
  "snp1.7:2.5": "tatreva vasalaka: tiṭṭhāhīti. ",
  "snp1.7:3.1": "evaṃ vutte bhagavā aggikabhāradvājaṃ brāhmaṇaṃ etadavoca: ",
  "snp1.7:3.2": "jānāsi panātvaṃ brāhmaṇa vasalaṃ vā vasalakaraṇe vā dhammeti, ",
  "snp1.7:3.3": "nakhvāhaṃ bho gotama jānāmi vasalaṃ vā vasalakaraṇe vā dhamme. ",
  "snp1.7:3.4": "sādhu me bhavaṃ gotamo tathā dhammaṃ desetu yathāhaṃ jāneyyaṃ vasalaṃ vā vasalakaraṇe vā dhammeti. ",
  "snp1.7:3.5": "tena hi brāhmaṇa suṇāhi sādhukaṃ manasi karohi bhāsissāmīti. ",
  "snp1.7:3.6": "evaṃ hoti kho aggikabhāradvājo brāhmaṇo bhagavato paccassosī, ",
  "snp1.7:3.7": "bhagavā etadavoca: ",
  "snp1.7:4.1": "kodhano upanāhī ca ",
  "snp1.7:4.2": "pāpamakkhī ca yo naro, ",
  "snp1.7:4.3": "vipannadiṭṭhi māyāvī ",
  "snp1.7:4.4": "taṃ jaññā vasalo iti. ",
  "snp1.7:5.1": "ekajaṃ va dvījaṃ vāpi ",
  "snp1.7:5.2": "yodha pāṇāni hiṃsati, ",
  "snp1.7:5.3": "yassa pāṇe dayā natthi ",
  "snp1.7:5.4": "taṃ jaññā vasalo iti. ",
  "snp1.7:6.1": "yo hanti parirundhati ",
  "snp1.7:6.2": "gāmāni nigamāni ca, ",
  "snp1.7:6.3": "niggāhako samaññāto ",
  "snp1.7:6.4": "taṃ jaññā vasalo iti. ",
  "snp1.7:7.1": "gāme vā yadi vā raññe ",
  "snp1.7:7.2": "yaṃ paresaṃ mamāyitaṃ, ",
  "snp1.7:7.3": "theyyā ādinnaṃ ādiyati ",
  "snp1.7:7.4": "taṃ jaññā vasalo iti. ",
  "snp1.7:8.1": "yo have iṇamādāya ",
  "snp1.7:8.2": "cujjamāno palāyati, ",
  "snp1.7:8.3": "na hi te iṇamatthiti ",
  "snp1.7:8.4": "taṃ jaññā vasalo iti. ",
  "snp1.7:9.1": "yo ce kiñcikkhakamyatā ",
  "snp1.7:9.2": "panthasmiṃ vajataṃ janaṃ, ",
  "snp1.7:9.3": "hantvā kiñcīkkhamādeti ",
  "snp1.7:9.4": "taṃ jaññā vasalo iti. yo ",
  "snp1.7:10.1": "attahetu parahetu ",
  "snp1.7:10.2": "dhanabhetū ca yo naro, ",
  "snp1.7:10.3": "sakkhipuṭṭho musā brūti ",
  "snp1.7:10.4": "taṃ jaññā vasalo iti. ",
  "snp1.7:11.1": "yo ñātinaṃ sakhānaṃ vā ",
  "snp1.7:11.2": "dāresu patidissati, ",
  "snp1.7:11.3": "sahasā sampiyena vā ",
  "snp1.7:11.4": "taṃ jaññā vasalo iti. ",
  "snp1.7:12.1": "yo mātaraṃ vā pitaraṃ vā ",
  "snp1.7:12.2": "jiṇṇakaṃ gatayobbanaṃ, ",
  "snp1.7:12.3": "pahū santo na bharati ",
  "snp1.7:12.4": "taṃ jaññā vasalo iti. ",
  "snp1.7:13.1": "yo mātaraṃ vā pitaraṃ vā ",
  "snp1.7:13.2": "bhātaraṃ bhaginiṃ sasuṃ, ",
  "snp1.7:13.3": "hanti roseti vācāya ",
  "snp1.7:13.4": "taṃ jaññā vasalo iti. ",
  "snp1.7:14.1": "yo atthaṃ pucchito santo ",
  "snp1.7:14.2": "anatthamanusāsati, ",
  "snp1.7:14.3": "paṭicchannena manteti ",
  "snp1.7:14.4": "taṃ jaññā vasalo iti. ",
  "snp1.7:15.1": "yo katvā pāpakaṃ kammaṃ ",
  "snp1.7:15.2": "mā maṃ jaññāti icchati, ",
  "snp1.7:15.3": "yo paṭicchannakammanto ",
  "snp1.7:15.4": "taṃ jaññā vasalo iti. ",
  "snp1.7:16.1": "yo ve parakulaṃ gantvā ",
  "snp1.7:16.2": "bhutvāna sucibhojanaṃ, ",
  "snp1.7:16.3": "āgataṃ na paṭipūjeti ",
  "snp1.7:16.4": "taṃ jaññā vasalo iti. ",
  "snp1.7:17.1": "yo brāhmaṇaṃ vā samaṇaṃ vā ",
  "snp1.7:17.2": "aññaṃ vāpi vaṇibbakaṃ, ",
  "snp1.7:17.3": "musāvādena vañceti ",
  "snp1.7:17.4": "taṃ jaññā vasalo iti. ",
  "snp1.7:18.1": "yo brāhmaṇaṃ vā samaṇaṃ vā ",
  "snp1.7:18.2": "bhattakāle upaṭṭhite, ",
  "snp1.7:18.3": "roseti vācā na ca deti ",
  "snp1.7:18.4": "taṃ jaññā vasalo iti. ",
  "snp1.7:19.1": "asataṃ yodha pabrūti ",
  "snp1.7:19.2": "mohena paḷiguṇṭhito, ",
  "snp1.7:19.3": "kiñcikkhaṃ nijigiṃsāno ",
  "snp1.7:19.4": "taṃ jaññā vasalo iti. ",
  "snp1.7:20.1": "yo cattānaṃ samukkaṃse ",
  "snp1.7:20.2": "parañca mavajānati, ",
  "snp1.7:20.3": "nihīno sena mānena ",
  "snp1.7:20.4": "taṃ jaññā vasalo iti. ",
  "snp1.7:21.1": "rosako kadariyo ca ",
  "snp1.7:21.2": "pāpiccho maccharī saṭho, ",
  "snp1.7:21.3": "ahiriko anottāpī ",
  "snp1.7:21.4": "taṃ jaññā vasalo iti. ",
  "snp1.7:22.1": "yo buddhaṃ paribhāsati ",
  "snp1.7:22.2": "atha vā tassa sāvakaṃ, ",
  "snp1.7:22.3": "paribbājaṃ gahaṭṭhaṃ vā ",
  "snp1.7:22.4": "taṃ jaññā vasalo iti. ",
  "snp1.7:23.1": "yo ce anarahā santo ",
  "snp1.7:23.2": "arahaṃ paṭijānāti, ",
  "snp1.7:23.3": "coro sabrahmake loke ",
  "snp1.7:23.4": "esa kho vasalādhamo, ",
  "snp1.7:23.5": "ete kho vasalā vutthā ",
  "snp1.7:23.6": "mayā co ye pakāsitā. ",
  "snp1.7:24.1": "na jaccā vasalo hoti ",
  "snp1.7:24.2": "na jaccā hoti brāhmaṇo, ",
  "snp1.7:24.3": "kammanā vasalo hoti ",
  "snp1.7:24.4": "kammanā hoti brāhmaṇo. ",
  "snp1.7:25.1": "tadamināpi jānātha ",
  "snp1.7:25.2": "yathā medaṃ nidassanaṃ, ",
  "snp1.7:25.3": "caṇḍālaputto sopāko ",
  "snp1.7:25.4": "mātaṅgo iti vissuto. ",
  "snp1.7:26.1": "so yasaṃ paramaṃ patto ",
  "snp1.7:26.2": "mātaṅgo yaṃ sudullabhaṃ, ",
  "snp1.7:26.3": "āgañchuṃ tassupaṭṭhānaṃ ",
  "snp1.7:26.4": "khattiyā brāhmaṇā bahū. ",
  "snp1.7:27.1": "so devayānamāruyha ",
  "snp1.7:27.2": "virajaṃ so mahāpathaṃ, ",
  "snp1.7:27.3": "kāmarāgaṃ virājetvā ",
  "snp1.7:27.4": "brahmalokūpago ahū. ",
  "snp1.7:27.5": "na naṃ jāti nivāresi ",
  "snp1.7:27.6": "brahmalokūpapattiyā, ",
  "snp1.7:28.1": "ajjhāyakakule jātā ",
  "snp1.7:28.2": "brāhmaṇā mattabandhūno. ",
  "snp1.7:28.3": "te va pāpesu kammesu ",
  "snp1.7:28.4": "abhiṇhamupadissare, ",
  "snp1.7:29.1": "aṭṭheva dhamme gārayhā ",
  "snp1.7:29.2": "samparāye ca duggatiṃ, ",
  "snp1.7:29.3": "na te jāti nivāreti ",
  "snp1.7:29.4": "duggaccā garahāya vā. ",
  "snp1.7:30.1": "na jaccā vasalo hoti ",
  "snp1.7:30.2": "na jaccā hoti brāhmaṇo, ",
  "snp1.7:30.3": "kammanā vasalo hoti ",
  "snp1.7:30.4": "kammanā hoti brāhmaṇo. ",
  "snp1.7:31.1": "evaṃ vutte aggikabhāradvājo brāhmaṇo bhagavantaṃ etadavoca: ",
  "snp1.7:31.2": "abhikkantaṃ bho gotama, abhikkantaṃ bho gotama, seyyathāpi bho gotama nikkujjitaṃ vā ukkujjeyya paṭicchannaṃ vā vivareyya mūḷhassa vā maggaṃ ācikkheyya andhakāre vā telapajjotaṃ dhāreyya cakkhumanto rūpāni dakkhintīti, evameva bhotā gotamena anekapariyāyena dhammo pakāsito. esāhaṃ bhavantaṃ gotamaṃ saraṇaṃ gacchāmi, dhammañca bhikkhusaṅghañca. ",
  "snp1.7:31.3": "upāsakaṃ maṃ bhavaṃ gotamo dhāretu ajjatagge pāṇupetaṃ saraṇaṃ gatanti. ",
  "snp1.7:31.4": "vasalasuttaṃ niṭṭhitaṃ. "
}
