{
  "snp5.8:0.1": "",
  "snp5.8:0.2": "5. 7. nandasuttaṃ ",
  "snp5.8:1.1": "santi loke munayo ",
  "snp5.8:1.2": "(iccāyasmā nando) ",
  "snp5.8:1.3": "janā vadanti tayidaṃ kathaṃsu’ ",
  "snp5.8:1.4": "ñāṇūpapannaṃ no muniṃ vadanti ",
  "snp5.8:1.5": "udāhu ce jīvitenūpapannaṃ. ",
  "snp5.8:2.1": "na diṭṭhiyā na sutiyā na ñāṇena (nandāti bhagavā) ",
  "snp5.8:2.2": "munīdha nanda kusalā vadantī, ",
  "snp5.8:2.3": "visenikatvā anīghā nirāsā ",
  "snp5.8:2.4": "caranti ye te munayoti brūmi. ",
  "snp5.8:3.1": "ye kecime samaṇabrāhmaṇā se ",
  "snp5.8:3.2": "(iccāyasmā nando) ",
  "snp5.8:3.3": "diṭṭhena sutenāpi vadanti suddhiṃ, ",
  "snp5.8:3.4": "sīlabbatenāpi vadanti suddhiṃ ",
  "snp5.8:3.5": "anekarūpena vadanti suddhiṃ ",
  "snp5.8:3.6": "kaccissu te bhagavā tattha yathā carantā ",
  "snp5.8:3.7": "atāru jātiñca jarañca mārisa ",
  "snp5.8:3.8": "pucchāmi taṃ bhagavā brūhi metaṃ. ",
  "snp5.8:4.1": "ye kecime samaṇabrāhmaṇā se ",
  "snp5.8:4.2": "(nandāti bhagavā) ",
  "snp5.8:4.3": "diṭṭhena sutenāpi vadanti suddhiṃ, ",
  "snp5.8:4.4": "sīlabbatenāpi vadanti suddhiṃ ",
  "snp5.8:4.5": "anekarūpena vadanti suddhiṃ, ",
  "snp5.8:4.6": "kiñcāpi te tattha yathā vadantī ",
  "snp5.8:4.7": "nātariṃsu jātijaranti brūmi. ",
  "snp5.8:5.1": "ye kecime samaṇabrāhmaṇā se ",
  "snp5.8:5.2": "(iccāyasmā nando) ",
  "snp5.8:5.3": "diṭṭhena sutenāpi vadanti suddhiṃ ",
  "snp5.8:5.4": "sīlabbatenāpi vadanti suddhiṃ ",
  "snp5.8:5.5": "anekarūpena vadanti suddhiṃ. ",
  "snp5.8:5.6": "tece muni brūsi anoghatiṇṇo ",
  "snp5.8:5.7": "atha ko carahi devamanussaloke, ",
  "snp5.8:5.8": "atāri jātiñca jarañca mārisa ",
  "snp5.8:5.9": "pucchāmi taṃ bhagavā brūhi metaṃ. ",
  "snp5.8:6.1": "nāhaṃ sabbe samaṇabrāhmaṇā se ",
  "snp5.8:6.2": "(nandāti bhagavā) ",
  "snp5.8:6.3": "jātijarāya nivutāti brūmi ",
  "snp5.8:6.4": "ye sūdha diṭṭhaṃ va sutaṃ mutaṃ vā ",
  "snp5.8:6.5": "sīlabbataṃ vāpi pahāya sabbaṃ ",
  "snp5.8:6.6": "anekarūpampi pahāya sabbaṃ, ",
  "snp5.8:6.7": "taṇhaṃ pariññāya anāsavā se ",
  "snp5.8:6.8": "te ve narā oghatiṇṇāti brūmi. ",
  "snp5.8:7.1": "etāhi nandāmi vaco mahesino (iccāyasmā nando) ",
  "snp5.8:7.2": "sukittitaṃ gotamaṃ nūpadhīkaṃ ",
  "snp5.8:7.3": "ye sūdha diṭṭhaṃ va sutaṃ mutaṃ vā ",
  "snp5.8:7.4": "sīlabbataṃ vāpi pahāya sabbaṃ ",
  "snp5.8:7.5": "aneka rūpampi pahāya sabbaṃ ",
  "snp5.8:7.6": "taṇhaṃ pariññāya anāsavā se ",
  "snp5.8:7.7": "ahampi te ve oghatiṇṇāti brūmīti. ",
  "snp5.8:7.8": "nandasuttaṃ sattamaṃ. "
}
