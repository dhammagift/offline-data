{
  "snp5.6:0.1": "",
  "snp5.6:0.2": "5. 5. dhotakasuttaṃ ",
  "snp5.6:1.1": "pucchāmi taṃ bhagavā brūhi metaṃ ",
  "snp5.6:1.2": "(iccāyasmā dhotako) ",
  "snp5.6:1.3": "vācābhikaṅkhāmi mahesi tuyhaṃ, ",
  "snp5.6:1.4": "tava sutvāna nigghosaṃ ",
  "snp5.6:1.5": "sikekha nibbāna mattano tena ",
  "snp5.6:2.1": "hātappaṃ karohi ",
  "snp5.6:2.2": "(dhotakāti bhagavā) ",
  "snp5.6:2.3": "idheva nipako sato, ",
  "snp5.6:2.4": "ito sutvāna nigghosaṃ ",
  "snp5.6:2.5": "sikkhe nibbānamattano ",
  "snp5.6:3.1": "passāmahaṃ devamanussa loke (iccāyasmādhotako) ",
  "snp5.6:3.2": "akiñcanaṃ brāhmaṇaṃ iriyamānaṃ, ",
  "snp5.6:3.3": "taṃ taṃ namassāmi samantacakkhu ",
  "snp5.6:3.4": "pamuñca maṃ sakka kathaṃkathāhi ",
  "snp5.6:4.1": "nāhaṃ gamissāmi pamocanāya ",
  "snp5.6:4.2": "(dhotakāti bhagavā) kathaṃkathiṃ dhotaka kañci loke, ",
  "snp5.6:4.3": "dhammañca seṭṭhaṃ ājānamāno ",
  "snp5.6:4.4": "evaṃ tuvaṃ oghamimaṃ taresi. ",
  "snp5.6:5.1": "anusāsa brahme karuṇāyamāno (iccāyasmā dhotakā) ",
  "snp5.6:5.2": "vivekadhammaṃ yamahaṃ vijaññaṃ, ",
  "snp5.6:5.3": "yathāhaṃ ākāsova avyāpajjamāno ",
  "snp5.6:5.4": "idheva santo asito careyyaṃ. ",
  "snp5.6:6.1": "kittayissāmi te sattiṃ ",
  "snp5.6:6.2": "(dhotakāti bhagavā) ",
  "snp5.6:6.3": "diṭṭhe dhamema anītihaṃ, ",
  "snp5.6:6.4": "yaṃ viditvā sato caraṃ ",
  "snp5.6:6.5": "tare loke visattikaṃ. ",
  "snp5.6:7.1": "taṃ vāhaṃ abhinandāmi (iccāyasmā dhotako) ",
  "snp5.6:7.2": "mahesi santimuttamaṃ, ",
  "snp5.6:7.3": "yaṃ viditvā sato caraṃ ",
  "snp5.6:7.4": "tare loke visattikaṃ. ",
  "snp5.6:8.1": "yaṃ kiñci sampajānāsi ",
  "snp5.6:8.2": "(dhotakāti bhagavā) ",
  "snp5.6:8.3": "uddhaṃ adho tiriyañcāpi majjhe: ",
  "snp5.6:8.4": "etaṃ viditvā saṅgoti loke ",
  "snp5.6:8.5": "bhavābhavāya mākāsi taṇhanti. ",
  "snp5.6:8.6": "dhotakasuttaṃ pañcamaṃ "
}
