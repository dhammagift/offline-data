{
  "snp5.13:0.1": "",
  "snp5.13:0.2": "5. 12. bhadrāvudhasuttaṃ ",
  "snp5.13:1.1": "okaṃ jahaṃ taṇhacchidaṃ anejaṃ ",
  "snp5.13:1.2": "(iccāyasmā bhadrāvudho) ",
  "snp5.13:1.3": "nandiṃ jahaṃ oghatiṇṇaṃ vimuttaṃ, ",
  "snp5.13:1.4": "kappaṃ jahaṃ abhiyāce sumedhaṃ ",
  "snp5.13:1.5": "sutvāna nāgassa apanamissanti ito. ",
  "snp5.13:2.1": "nānā janā janapadehi saṅgatā ",
  "snp5.13:2.2": "tava vīra vākyaṃ abhikaṅkha mānā, ",
  "snp5.13:2.3": "tesaṃ tuvaṃ sādhu viyākarohi ",
  "snp5.13:2.4": "tathā hi te vidito esa dhammo. ",
  "snp5.13:3.1": "ādānataṇhaṃ vinayetha sabbaṃ ",
  "snp5.13:3.2": "(bhadrāvudhāti bhagavā) ",
  "snp5.13:3.3": "uddhaṃ adho tiriyañcāpi majjhe, ",
  "snp5.13:3.4": "yaṃ yaṃ hi lokasmiṃ upādiyanti ",
  "snp5.13:3.5": "teneva māro anveti jantuṃ. ",
  "snp5.13:4.1": "tasmā pajānaṃ na upādiyetha ",
  "snp5.13:4.2": "bhikkhu sato kiñcanaṃ sabbaloke, ",
  "snp5.13:4.3": "ādānasatte iti pekkhamāno ",
  "snp5.13:4.4": "pajaṃ imaṃ maccudheyye visattaṃnti. ",
  "snp5.13:4.5": "bhadrāvudhasuttaṃ dvādasamaṃ. "
}
