{
  "snp5.14:0.1": "",
  "snp5.14:0.2": "5. 13. udayasuttaṃ ",
  "snp5.14:1.1": "jhāyiṃ virajamāsīnaṃ ",
  "snp5.14:1.2": "(iccā yasmā udayo) ",
  "snp5.14:1.3": "katakiccaṃ anāsavaṃ ",
  "snp5.14:1.4": "pāraguṃ sabbadhammānaṃ ",
  "snp5.14:1.5": "atthi pañhena āgamaṃ, ",
  "snp5.14:1.6": "aññā vimokkhaṃ pabrūhi ",
  "snp5.14:1.7": "avijjāya pabhedanaṃ. ",
  "snp5.14:2.1": "pahānaṃ kāmacchandānaṃ ",
  "snp5.14:2.2": "(udayāti bhagavā) ",
  "snp5.14:2.3": "domanassānaṃ cūbhayaṃ, ",
  "snp5.14:2.4": "thinassa ca panūdanaṃ ",
  "snp5.14:2.5": "kukkuccānaṃ nivāraṇaṃ. ",
  "snp5.14:3.1": "upekhā sati saṃsuddhaṃ ",
  "snp5.14:3.2": "dhammatakkapurejavaṃ, ",
  "snp5.14:3.3": "aññā vimokkhaṃ pabrūmi ",
  "snp5.14:3.4": "avijjāya pabhedanaṃ. ",
  "snp5.14:4.1": "kiṃsu saṃyojano loko (iccāyasmā udayo) ",
  "snp5.14:4.2": "kiṃsu tassa vicāraṇā, ",
  "snp5.14:4.3": "kissassa vippahānena ",
  "snp5.14:4.4": "nibbānamiti vuccati. ",
  "snp5.14:5.1": "nandi saṃyojano loko (udayāti bhagavā) ",
  "snp5.14:5.2": "vitakkassa vicāraṇā, ",
  "snp5.14:5.3": "taṇhāya vippahānena ",
  "snp5.14:5.4": "nibbānamiti vuccati. ",
  "snp5.14:6.1": "kathaṃ satassa carato (iccāyasmā udayaṃ) ",
  "snp5.14:6.2": "viññāṇaṃ uparujjhati, ",
  "snp5.14:6.3": "bhagavantaṃ puṭṭhumāgamma ",
  "snp5.14:6.4": "taṃ suṇoma vaco tava: ",
  "snp5.14:7.1": "ajjhattañca bahiddhā ca ",
  "snp5.14:7.2": "vedanaṃ nābhinandito, ",
  "snp5.14:7.3": "evaṃ satassa carato ",
  "snp5.14:7.4": "viññāṇaṃ uparujjhatīti. ",
  "snp5.14:7.5": "udayasuttaṃ terasamaṃ. "
}
