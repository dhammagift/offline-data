{
  "snp5.4:0.1": "",
  "snp5.4:0.2": "5. 3. puṇṇakasuttaṃ ",
  "snp5.4:1.1": "anejaṃ mūla dassāviṃ ",
  "snp5.4:1.2": "(iccāyasmā puṇṇako) ",
  "snp5.4:1.3": "atthi pañhena āgamaṃ ",
  "snp5.4:1.4": "kiṃ nissitā isayo manujā ",
  "snp5.4:1.5": "khattiyā brāhmaṇā devatānaṃ ",
  "snp5.4:1.6": "yaññamakappayiṃsu puthu idha loke ",
  "snp5.4:1.7": "pucchāmi taṃ bhagavā brūhimetaṃ. ",
  "snp5.4:2.1": "ye kecime isayo manujā ",
  "snp5.4:2.2": "(puṇṇakāti bhagavā) ",
  "snp5.4:2.3": "khattiyā brāhmaṇā devatānaṃ ",
  "snp5.4:2.4": "yaññamakappayiṃsu puthu idha loke, ",
  "snp5.4:2.5": "āsiṃmānā puṇṇaka itthabhāvaṃ ",
  "snp5.4:2.6": "jaraṃ sitā yaññamakappayi su. ",
  "snp5.4:3.1": "ye keci me isayo manujā ",
  "snp5.4:3.2": "(iccāyasmā puṇṇako) ",
  "snp5.4:3.3": "khattiyā brāhmaṇā devatānaṃ ",
  "snp5.4:3.4": "yaññamakappayiṃsu puthū idha loke ",
  "snp5.4:3.5": "kaccissu te bhagavā yaññapathe appamattā ",
  "snp5.4:3.6": "ātāru jātiñca jaraṃ ca mārisa ",
  "snp5.4:3.7": "pucchāmi taṃ bhagavā brūhi metaṃ. ",
  "snp5.4:4.1": "āsiṃsanti thomayanti abhijappanti juhanti ",
  "snp5.4:4.2": "(puṇṇakāti bhagavā) ",
  "snp5.4:4.3": "kāmābhijappanti paṭicca lābhaṃ, ",
  "snp5.4:4.4": "te yājayogā bhavarāgarattā ",
  "snp5.4:4.5": "nātariṃsu jātijaranti brūmi. ",
  "snp5.4:5.1": "te ve nātariṃsu yājayogā ",
  "snp5.4:5.2": "(iccāyasmā puṇṇako) ",
  "snp5.4:5.3": "yaññehi jātiñca jarañca mārisa, ",
  "snp5.4:5.4": "atha ko carahi deva manussaloke ",
  "snp5.4:5.5": "atāri jātiñña jarañca mārisa ",
  "snp5.4:5.6": "pucchāmi taṃ bhagavā brūhi metaṃ. ",
  "snp5.4:6.1": "saṅkhāya lokasmiṃ parovarāni ",
  "snp5.4:6.2": "(puṇṇakāti bhagavā) ",
  "snp5.4:6.3": "yassiñjitaṃ natthi kuhiñci loke, ",
  "snp5.4:6.4": "santo vidhūmo anīgho nirāso ",
  "snp5.4:6.5": "atāri so jātijaranti brūmīti. ",
  "snp5.4:6.6": "puṇṇakasuttaṃ tatiyaṃ. "
}
