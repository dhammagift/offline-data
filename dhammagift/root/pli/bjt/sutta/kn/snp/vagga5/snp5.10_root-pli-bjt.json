{
  "snp5.10:0.1": "",
  "snp5.10:0.2": "5. 9. todeyyasuttaṃ ",
  "snp5.10:1.1": "yasmiṃ kāmā na vasanti ",
  "snp5.10:1.2": "(iccāyasmā todeyyā) ",
  "snp5.10:1.3": "taṇhā yassa na vijjati, ",
  "snp5.10:1.4": "kathaṃkathā ca yo tiṇṇo ",
  "snp5.10:1.5": "vimokho tassa kīdiso. ",
  "snp5.10:2.1": "yasmiṃ kāmā na vasanti ",
  "snp5.10:2.2": "(todeyyāti bhagavā) ",
  "snp5.10:2.3": "taṇhā yassa na vijjati, ",
  "snp5.10:2.4": "kathaṃkathā ca yo tiṇṇo ",
  "snp5.10:2.5": "vimokho tassa nāparo. ",
  "snp5.10:3.1": "nirāsaso so udi āsasāno ",
  "snp5.10:3.2": "paññāṇavā so udapaññakapapī, ",
  "snp5.10:3.3": "muniṃ ahaṃ sakka yathā vijaññaṃ ",
  "snp5.10:3.4": "taṃ me viyācikkha samantacakkhu. ",
  "snp5.10:4.1": "nirāsaso so na so āsasāno ",
  "snp5.10:4.2": "paññāṇavā so na ca paññakappī, ",
  "snp5.10:4.3": "evampi todeyya muniṃ vijāna ",
  "snp5.10:4.4": "akiñcanaṃ kāmabhave asattanti. ",
  "snp5.10:4.5": "todeyyasuttaṃ navamaṃ "
}
