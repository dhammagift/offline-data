{
  "snp5.15:0.1": "",
  "snp5.15:0.2": "5. 14. posālasuttaṃ ",
  "snp5.15:1.1": "yo atītaṃ ādiyati ",
  "snp5.15:1.2": "(iccāyasmā posālo) ",
  "snp5.15:1.3": "anejo chinnasaṃsayo, ",
  "snp5.15:1.4": "pāraguṃ sabbadhammānaṃ ",
  "snp5.15:1.5": "atthipañhena āgamaṃ. ",
  "snp5.15:2.1": "vibhūtarūpasaññissa ",
  "snp5.15:2.2": "sabbakāyappahāyino ",
  "snp5.15:2.3": "ajjhattañca bahiddhā ca ",
  "snp5.15:2.4": "natthi kiñcīti passato, ",
  "snp5.15:2.5": "ñāṇaṃ sakkānu pucchāmi ",
  "snp5.15:2.6": "kathaṃ neyyo tathā vidho. ",
  "snp5.15:3.1": "viññāṇaṭṭhitiyo sabbā ",
  "snp5.15:3.2": "(poso lāti bhagavā) ",
  "snp5.15:3.3": "abhijānaṃ tathāgato ",
  "snp5.15:3.4": "tiṭṭhantamenaṃ jānāti ",
  "snp5.15:3.5": "vimuttaṃ tapparāyaṇaṃ. ",
  "snp5.15:4.1": "ākiñcaññā sambhavaṃ ñatvā ",
  "snp5.15:4.2": "nandi saṃyojanaṃ iti, ",
  "snp5.15:4.3": "evametaṃ abhiññāya ",
  "snp5.15:4.4": "tato tattha vipassati: ",
  "snp5.15:4.5": "etaṃ ñāṇaṃ tathaṃ tassa ",
  "snp5.15:4.6": "brāhmaṇassa vusīmatoti. ",
  "snp5.15:4.7": "posālasuttaṃ cuddasamaṃ. "
}
