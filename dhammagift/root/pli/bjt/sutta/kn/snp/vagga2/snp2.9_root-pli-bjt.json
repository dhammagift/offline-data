{
  "snp2.9:0.1": "",
  "snp2.9:0.2": "2. 9. kiṃsīlasuttaṃ ",
  "snp2.9:1.1": "kiṃsīlo kiṃsamācāro ",
  "snp2.9:1.2": "kāni kammāni brūbhayaṃ ",
  "snp2.9:1.3": "naro sammā niviṭṭhassa ",
  "snp2.9:1.4": "uttamatthañca pāpuṇe. ",
  "snp2.9:2.1": "vuddhāpacāyī anusuyyako siyā ",
  "snp2.9:2.2": "kālaññū cassa garūnaṃ dassanāya ",
  "snp2.9:2.3": "dhammiṃ kathaṃ erayitaṃ khaṇaññū ",
  "snp2.9:2.4": "suṇeyya sakkacca subhāsitāni. ",
  "snp2.9:3.1": "kālena gacche garūnaṃ sakāsaṃ ",
  "snp2.9:3.2": "thambhaṃ niraṃkatvā nivātavutti ",
  "snp2.9:3.3": "atthaṃ dhammaṃ saṃyamaṃ brahmacariyaṃ ",
  "snp2.9:3.4": "anussare ceva samācare va. ",
  "snp2.9:4.1": "dhammārāmo dhammarato ",
  "snp2.9:4.2": "dhamme ṭhito dhammavinicchayaññū, ",
  "snp2.9:4.3": "no vācare dhammasandosavādaṃ niyetha ",
  "snp2.9:4.4": "tacchehi subhāsitehī. ",
  "snp2.9:5.1": "hassaṃ jappaṃ paridevaṃ padosaṃ ",
  "snp2.9:5.2": "māyākataṃ kuhakaṃ giddhimānaṃ, ",
  "snp2.9:5.3": "sārambhakakkasakasāva mucchaṃ ",
  "snp2.9:5.4": "hitvā care vītamado ṭhitatto. ",
  "snp2.9:6.1": "viññātasārāni subhāsitāni ",
  "snp2.9:6.2": "sutañca vaññātasamādhisāraṃ, ",
  "snp2.9:6.3": "na tassa paññā ca sutañca vaḍḍhati ",
  "snp2.9:6.4": "yo sāhaso hoti naro pamatto. ",
  "snp2.9:7.1": "dhamme ca ye ariyapavedite ratā ",
  "snp2.9:7.2": "anuttarā te vacasā manasā kammanā ca ",
  "snp2.9:7.3": "te sannisoraccasādhisaṇṭhitā ",
  "snp2.9:7.4": "sutassa paññāya ca sāramajjhagūti. ",
  "snp2.9:7.5": "kiṃsīlasuttaṃ niṭṭhitaṃ. "
}
