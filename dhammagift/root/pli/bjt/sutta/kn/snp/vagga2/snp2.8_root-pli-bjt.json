{
  "snp2.8:0.1": "",
  "snp2.8:0.2": "2. 8. dhamma (nāvā) suttaṃ ",
  "snp2.8:1.1": "yasmā bhi dhammaṃ puriso vijaññā ",
  "snp2.8:1.2": "indaṃ’ca naṃ devatā pūjayeyya, ",
  "snp2.8:1.3": "so pūjito tasmiṃ pasannacitto ",
  "snp2.8:1.4": "bahussuto pātukaroti dhammaṃ. ",
  "snp2.8:2.1": "tadaṭṭhikatvāna nisamma dhīro ",
  "snp2.8:2.2": "dhammānudhammaṃ paṭipajjamāno, ",
  "snp2.8:2.3": "viññū vibhāvī nipuṇo ca hoti ",
  "snp2.8:2.4": "yo tādisaṃ bhajate appamatto. ",
  "snp2.8:3.1": "khuddañca bālaṃ upasevamāno ",
  "snp2.8:3.2": "anāgatatthañca usūyakañca, ",
  "snp2.8:3.3": "idheva dhammaṃ acibhāvayitvā ",
  "snp2.8:3.4": "avitiṇṇakaṅkho maraṇaṃ upeti. ",
  "snp2.8:4.1": "yathā naro āpagaṃ otaritvā ",
  "snp2.8:4.2": "mahodakaṃ salilaṃ sīghasotaṃ, ",
  "snp2.8:4.3": "so vuyhamāno anusotagāmī ",
  "snp2.8:4.4": "kiṃ so pare sakkati tārayetaṃ. ",
  "snp2.8:5.1": "tatheva dhammaṃ avibhāvayitvā ",
  "snp2.8:5.2": "bahussutānaṃ anisāmayattha, ",
  "snp2.8:5.3": "sayaṃ ajānaṃ avītiṇṇakaṅkho ",
  "snp2.8:5.4": "kiṃ so pare sakkati nijjhāpetuṃ. ",
  "snp2.8:6.1": "yathāpi nāvaṃ daḷhamāruhitvā ",
  "snp2.8:6.2": "piyena’rittena samaṅgibhūto, ",
  "snp2.8:6.3": "so tāraye tattha bahūpi aññe ",
  "snp2.8:6.4": "tatrūpāyaññū kusalo mutīmā. ",
  "snp2.8:7.1": "evampi yo vedagū bhāvitatto ",
  "snp2.8:7.2": "bahussuto hoti avedhadhammo, ",
  "snp2.8:7.3": "so kho pare nijjhapaye pajānaṃ ",
  "snp2.8:7.4": "sotāvadhānūpanīsūpapanne. ",
  "snp2.8:8.1": "tasmā bhave sappurisaṃ bhajetha ",
  "snp2.8:8.2": "medhāvinañceva bahussutañca, ",
  "snp2.8:8.3": "aññāya atthaṃ paṭipajjamāno ",
  "snp2.8:8.4": "viññātadhammo so sukhaṃ labhethāti. ",
  "snp2.8:8.5": "dhammasuttaṃ niṭṭhitaṃ. "
}
