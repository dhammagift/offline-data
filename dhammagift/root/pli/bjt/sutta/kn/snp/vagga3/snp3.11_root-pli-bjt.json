{
  "snp3.11:0.1": "",
  "snp3.11:0.2": "3. 11. nālaka suttaṃ ",
  "snp3.11:1.1": "ānandajāte tidasagaṇe patīte ",
  "snp3.11:1.2": "sakkacca indaṃ sucivasane ca deve, ",
  "snp3.11:1.3": "dussaṃ gahetvā atiriva thomayante ",
  "snp3.11:1.4": "asito isi addasa divāvihāre. ",
  "snp3.11:2.1": "disvāna deve muditamane udagge ",
  "snp3.11:2.2": "cittiṃ karitvā idamavocāsi tattha, ",
  "snp3.11:2.3": "kiṃ devasaṅgho atiriva kalyarūpo ",
  "snp3.11:2.4": "dussaṃ gahetvā bhamayatha kiṃ paṭicca. ",
  "snp3.11:3.1": "yadāpi āsi asurehi saṅgamo ",
  "snp3.11:3.2": "jayo surānaṃ asurā parājitā, ",
  "snp3.11:3.3": "tadāpi netādiso lomahaṃsano ",
  "snp3.11:3.4": "kiṃ abbhutaṃ daṭṭhu marū pamoditā. ",
  "snp3.11:4.1": "selenti gāyanti ca vādayanti ca ",
  "snp3.11:4.2": "bhujāni poṭhenti ca naccayanti ca, ",
  "snp3.11:4.3": "pucchāmi vohaṃ merumuddhavāsine ",
  "snp3.11:4.4": "dhunātha me saṃsayaṃ khippamārisā. ",
  "snp3.11:5.1": "so bodhisatto ratanavaro atulyo ",
  "snp3.11:5.2": "manusseloke hitasukhatāya jāto, ",
  "snp3.11:5.3": "sakyāna gāme janapade lumbineyye ",
  "snp3.11:5.4": "tenamha tuṭṭhā atiriva kalyarūpā. ",
  "snp3.11:6.1": "so sabbasattuttamo aggapuggalo ",
  "snp3.11:6.2": "narāsabho sabbapajānamuttamo, ",
  "snp3.11:6.3": "vattessati cakkaṃ isivahaye vane ",
  "snp3.11:6.4": "nadaṃ va sīho balavā migābhibhū. ",
  "snp3.11:7.1": "taṃ saddaṃ sutvā turitamavaṃsarī so ",
  "snp3.11:7.2": "suddhodanassa tadā bhavanaṃ upāgami, ",
  "snp3.11:7.3": "nisajja tattha idamavocāsi sakye ",
  "snp3.11:7.4": "kuhiṃ kumāro ahampi daṭṭhukāmo. ",
  "snp3.11:8.1": "tato kumāraṃ jalitamiva suvaṇṇaṃ ",
  "snp3.11:8.2": "ukkāmukhe’va sukusalasampahaṭṭhaṃ, ",
  "snp3.11:8.3": "daddallamānaṃ siriyā anomavaṇṇaṃ ",
  "snp3.11:8.4": "dassesu puttaṃ asitavahayassa sakyā. ",
  "snp3.11:9.1": "disvā kumāraṃ sikhimiva pajjalantaṃ ",
  "snp3.11:9.2": "tārāsabhaṃ va nabhasigamaṃ visuddhaṃ, ",
  "snp3.11:9.3": "suriyaṃ tapantaṃ saradarivabbhamuttaṃ ",
  "snp3.11:9.4": "ānandajāto vipulamalattha pītiṃ. ",
  "snp3.11:10.1": "anekasākhañca sahassamaṇḍalaṃ ",
  "snp3.11:10.2": "chattaṃ marū dhārayumantalikkhe, ",
  "snp3.11:10.3": "suvaṇṇadaṇḍā vitipatanti cāmarā ",
  "snp3.11:10.4": "na dissare cāmarachatatagāhakā. ",
  "snp3.11:11.1": "disvā jaṭī kaṇhasirivhayo isi ",
  "snp3.11:11.2": "suvaṇṇanekkhaṃ viya paṇḍukambale, ",
  "snp3.11:11.3": "setañca chattaṃ dhariyantamuddhani ",
  "snp3.11:11.4": "udaggacitto sumano paṭiggahe. ",
  "snp3.11:12.1": "paṭiggahetvā pana sakyapuṅgavaṃ ",
  "snp3.11:12.2": "jigiṃsako lakkhaṇamattapāragu, ",
  "snp3.11:12.3": "pasannacitto giramabbhudīrayi ",
  "snp3.11:12.4": "anuttarāyaṃ dipadānamuttamo. ",
  "snp3.11:13.1": "athattano gamanamanussaranto ",
  "snp3.11:13.2": "akalyarūpo galayati assūkāni, ",
  "snp3.11:13.3": "disvāna sakyā isimavocuṃ rudantaṃ ",
  "snp3.11:13.4": "no ce kumāre bhavissati antarāyo. ",
  "snp3.11:14.1": "disvāna sakye isimavoca akallye ",
  "snp3.11:14.2": "nāhaṃ kumāre ahitamanussarāmi, ",
  "snp3.11:14.3": "na cāpi massa bhavissati antarāyo ",
  "snp3.11:14.4": "na orakoyaṃ adhimānasā bhavātha. ",
  "snp3.11:15.1": "sambodhiyaggaṃ phusissatāyaṃ kumāro ",
  "snp3.11:15.2": "so dhammacakkaṃ paramavisuddhadassī, ",
  "snp3.11:15.3": "vattessatāyaṃ bahujanahitānukampī ",
  "snp3.11:15.4": "vitthārikassa bhavissati brahmacariyaṃ. ",
  "snp3.11:16.1": "mamañca āyu na ciramidhāvaseso ",
  "snp3.11:16.2": "athantarā me bhavissati kālakiriyā, ",
  "snp3.11:16.3": "sohaṃ na sossaṃ asamadhurassa dhammaṃ ",
  "snp3.11:16.4": "tenamhi aṭṭo vyasanagato aghāvī. ",
  "snp3.11:17.1": "so sākiyānaṃ vipulaṃ janetvā pītiṃ ",
  "snp3.11:17.2": "antepurambhā niragamā brahmacārī, ",
  "snp3.11:17.3": "so bhāgineyyaṃ sayamanukampamāno ",
  "snp3.11:17.4": "samādapesi asamadhurassadhamme. ",
  "snp3.11:18.1": "buddhoti ghosaṃ yadaparato suṇāsi ",
  "snp3.11:18.2": "sambodhipatto vivarati dhammamaggaṃ, ",
  "snp3.11:18.3": "gantvāna tattha samayaṃ paripucchiyāno ",
  "snp3.11:18.4": "carassu tasmiṃ bhagavati brahmacariyaṃ. ",
  "snp3.11:19.1": "tenānusiṭṭho hitamanasena tādinā ",
  "snp3.11:19.2": "anāgate paramavisuddhadassinā, ",
  "snp3.11:19.3": "so nāḷako upacitapuññasañcayo ",
  "snp3.11:19.4": "jinaṃ patikkhaṃ parivasi rakkhitindriyo. ",
  "snp3.11:20.1": "sutvāna ghosaṃ jinavaracakkavattane ",
  "snp3.11:20.2": "gantvāna disvā isinisabhaṃ pasanno, ",
  "snp3.11:20.3": "moneyyaseṭṭhaṃ munipavaraṃ apucchi ",
  "snp3.11:20.4": "samāgate asitavhayassa sāsaneti. ",
  "snp3.11:20.5": "vatthugāthā. ",
  "snp3.11:21.1": "aññātametaṃ vacanaṃ ",
  "snp3.11:21.2": "asitassa yathātathaṃ ",
  "snp3.11:21.3": "taṃ taṃ gotama pucchāma ",
  "snp3.11:21.4": "sabbadhammānapāraguṃ. ",
  "snp3.11:22.1": "anagāriyupetassa ",
  "snp3.11:22.2": "bhikkhācariyaṃ jigiṃsato, ",
  "snp3.11:22.3": "muni pabrūhi me puṭṭho ",
  "snp3.11:22.4": "moneyyaṃ uttamaṃ padaṃ. ",
  "snp3.11:23.1": "moneyyaṃ te upaññissaṃ ",
  "snp3.11:23.2": "(iti bhagavā) ",
  "snp3.11:23.3": "dukkaraṃ durabhisambhavaṃ, ",
  "snp3.11:23.4": "handa te naṃ pavakkhāmi ",
  "snp3.11:23.5": "santhambhassu daḷho bhava. ",
  "snp3.11:24.1": "samānabhāgaṃ kubbetha ",
  "snp3.11:24.2": "gāme akkuṭṭhavanditaṃ, ",
  "snp3.11:24.3": "manopadosaṃ rakkheyya ",
  "snp3.11:24.4": "santo anunnato care. ",
  "snp3.11:25.1": "uccāvacā niccharanti ",
  "snp3.11:25.2": "dāye aggisikhūpamā, ",
  "snp3.11:25.3": "nāriyo muniṃ palobhenti ",
  "snp3.11:25.4": "tā su taṃ mā palobhayuṃ. ",
  "snp3.11:26.1": "virato methunā dhammā ",
  "snp3.11:26.2": "hitvā kāme parovare. ",
  "snp3.11:26.3": "aviruddho asāratto ",
  "snp3.11:26.4": "pāṇesu tasathāvare. ",
  "snp3.11:27.1": "yathā ahaṃ tathā ete ",
  "snp3.11:27.2": "yathā ete tathā ahaṃ, ",
  "snp3.11:27.3": "attānaṃ upamaṃ katvā ",
  "snp3.11:27.4": "na haneyya na ghātaye. ",
  "snp3.11:28.1": "hitvā icchañca lobhañca ",
  "snp3.11:28.2": "yattha satto puthujjano, ",
  "snp3.11:28.3": "cakkhumā paṭipajjeyya ",
  "snp3.11:28.4": "tareyya narakaṃ imaṃ. ",
  "snp3.11:29.1": "ūnūdaro mitāhāro ",
  "snp3.11:29.2": "apapiccassa alolupo, ",
  "snp3.11:29.3": "sace icchāya nicchāto ",
  "snp3.11:29.4": "aniccho hoti nibbuto. ",
  "snp3.11:30.1": "sapiṇḍacāraṃ caritvā ",
  "snp3.11:30.2": "vanantambhihāraye, ",
  "snp3.11:30.3": "upaṭṭhito rukkhamūlasmiṃ ",
  "snp3.11:30.4": "āsanūpagato muni. ",
  "snp3.11:31.1": "sa jhānapasuto dhīro ",
  "snp3.11:31.2": "vanante ramito siyā, ",
  "snp3.11:31.3": "jhāyetha rukkhamūlasmiṃ ",
  "snp3.11:31.4": "attānamabhitosayaṃ. ",
  "snp3.11:32.1": "tato ratyā vivasane ",
  "snp3.11:32.2": "gāmantamabhihāraye, ",
  "snp3.11:32.3": "avhānaṃ nābhinandeyya ",
  "snp3.11:32.4": "abhihārañca gāmato. ",
  "snp3.11:33.1": "na muni gāmamāgamma ",
  "snp3.11:33.2": "kulesu sahasā care, ",
  "snp3.11:33.3": "ghāsesanaṃ chinnakatho ",
  "snp3.11:33.4": "na vācaṃ payutaṃ bhaṇe. ",
  "snp3.11:34.1": "alatthaṃ yadidaṃ sādhu ",
  "snp3.11:34.2": "nālatthaṃ kusalaṃ iti, ",
  "snp3.11:34.3": "ubhayeneva so tādi ",
  "snp3.11:34.4": "rukkhaṃ va upanivattati. ",
  "snp3.11:35.1": "sa pattapāṇi vicaranto ",
  "snp3.11:35.2": "amūgo mugasammato, ",
  "snp3.11:35.3": "appaṃ dānaṃ na hīḷeyya ",
  "snp3.11:35.4": "dātāraṃ nāvajāniya. ",
  "snp3.11:36.1": "uccāvacā hi paṭipadā ",
  "snp3.11:36.2": "samaṇena pakāsitā, ",
  "snp3.11:36.3": "na pāraṃ diguṇaṃ yanti ",
  "snp3.11:36.4": "na idaṃ ekaguṇaṃ mutaṃ. ",
  "snp3.11:37.1": "yassa ca visatā natthi ",
  "snp3.11:37.2": "chinnasotassa bhikkhuno, ",
  "snp3.11:37.3": "kiccākiccappahīnassa ",
  "snp3.11:37.4": "parilāho na vijjati. ",
  "snp3.11:38.1": "moneyyaṃ te upaññissaṃ (iti bhagavā) ",
  "snp3.11:38.2": "khūradhārūpamo bhave, ",
  "snp3.11:38.3": "jivhāya tāluṃ āhacca ",
  "snp3.11:38.4": "udare saññato siyā. ",
  "snp3.11:39.1": "alīnacitto ca siyā ",
  "snp3.11:39.2": "na cāpi bahu cintaye, ",
  "snp3.11:39.3": "nirāmagandho asito ",
  "snp3.11:39.4": "brahmacariyaparāyano. ",
  "snp3.11:40.1": "ekāsanassa sikkhetha ",
  "snp3.11:40.2": "samaṇūpāsanassa ca, ",
  "snp3.11:40.3": "ekantaṃ monamakkhātaṃ ",
  "snp3.11:40.4": "eko ve abhiramissati. ",
  "snp3.11:40.5": "atha bhāsihi dasadisā ",
  "snp3.11:41.1": "sutvā dhīrānaṃ nigghosaṃ ",
  "snp3.11:41.2": "jhāyīnaṃ kāmavāgīnaṃ, ",
  "snp3.11:41.3": "tato hiriñca saddhañña ",
  "snp3.11:41.4": "bhiyyo kubbetha māmako. ",
  "snp3.11:42.1": "taṃ nadīhi vijānātha ",
  "snp3.11:42.2": "sobbhesu padaresu ca, ",
  "snp3.11:42.3": "saṇantā yanti kussobbhā ",
  "snp3.11:42.4": "tuṇhī yāti mahodayi. ",
  "snp3.11:43.1": "yadūnakaṃ taṃ saṇati ",
  "snp3.11:43.2": "yaṃ puraṃ sattameva taṃ, ",
  "snp3.11:43.3": "aḍḍhakumbhūpamo bālo ",
  "snp3.11:43.4": "rahado pūrova paṇḍito. ",
  "snp3.11:44.1": "yaṃ samaṇo bahu bhāsati ",
  "snp3.11:44.2": "upetaṃ atthasaṃhitaṃ, ",
  "snp3.11:44.3": "jānaṃ so dhammaṃ deseti ",
  "snp3.11:44.4": "jānaṃ so bahu bhāsati. ",
  "snp3.11:45.1": "yo ca jānaṃ samaṃ yutto ",
  "snp3.11:45.2": "jānaṃ na bahu bhāsati, ",
  "snp3.11:45.3": "sa muni monamarahati ",
  "snp3.11:45.4": "sa muni monamajjhagāti. ",
  "snp3.11:45.5": "nālakasuttaṃ niṭṭhitaṃ. "
}
