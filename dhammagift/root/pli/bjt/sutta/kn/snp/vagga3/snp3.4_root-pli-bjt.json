{
  "snp3.4:0.1": "",
  "snp3.4:0.2": "3. 4. sundarikabhāradvāja suttaṃ ",
  "snp3.4:1.1": "evaṃ me sutaṃ: ",
  "snp3.4:1.2": "ekaṃ bhagavā kosalesu viharati sundarikāya nadiyā tīre. ",
  "snp3.4:1.3": "tena kho pana samayena sundarikabhāradvājo brāhmaṇo sundarikāya nadiyā tīre aggiṃ juhati, aggihuttaṃ paricarati, ",
  "snp3.4:1.4": "atha kho sundarikabhāradvājo brāhmaṇo aggiṃ juhitvā aggihuttaṃ paricaritvā uṭṭhāyāsanā samantā catuddisā anuvilokesi ",
  "snp3.4:1.5": "ko nu kho imaṃ havyasesaṃ bhuñjeyyāti. ",
  "snp3.4:1.6": "addasā kho sundarikabhāradvājo brāhmaṇo bhagavantaṃ avidūre aññatarasmiṃ rukkhamūle sasīsaṃ pārutaṃ nisinnaṃ ",
  "snp3.4:1.7": "disvāna vāmena hatthena havyasesaṃ gahetvā dakkhiṇena hatthena kamaṇḍaluṃ gahetvā yena bhagavā tenupasaṅkami. ",
  "snp3.4:2.1": "atha kho bhagavā sundarika bhāradvājassa brāhmaṇassa padasaddena sīsaṃ vivari, ",
  "snp3.4:2.2": "atha kho sundarikabhāradvājo brāhmaṇo “muṇḍo ayaṃ bhavaṃ muṇḍako ayaṃ bhavanti” tato va puna nivattitukāmo ahosi, ",
  "snp3.4:2.3": "atha kho sundarikabhāradvājassa brāhmaṇassa etadahosi. ",
  "snp3.4:2.4": "muṇḍāpi bhi idhekacce brāhmaṇā bhavanti yannūnāhaṃ upasaṅkamitvā jātiṃ puccheyyanti, ",
  "snp3.4:2.5": "atha kho sundarikabhāradvājo brāhmaṇo yena bhagavā tenupasaṅkami, upasaṅkamitvā bhagavantaṃ etadavoca ",
  "snp3.4:2.6": "kiṃjacco bhavanti, ",
  "snp3.4:3.1": "atha kho bhagavā sundarikabhāradvājaṃ brāhmaṇaṃ gāthāhi ajjhabhāsi. ",
  "snp3.4:4.1": "na brāhmaṇo no’mhi na rājaputto ",
  "snp3.4:4.2": "na vessāyano uda koci no’mhi, ",
  "snp3.4:4.3": "gottaṃ pariññāya puthujjanānaṃ ",
  "snp3.4:4.4": "akiñcano manta carāmi loke. ",
  "snp3.4:5.1": "saṅghāṭivāsī agaho carāmi ",
  "snp3.4:5.2": "nivuttakeso abhinibbutatto, ",
  "snp3.4:5.3": "alippamāno idha mānavehi ",
  "snp3.4:5.4": "akallaṃ maṃ brāhmaṇa pucchasi gottapañhaṃ. ",
  "snp3.4:6.1": "pucchanti ve bho brāhmaṇā brāhmaṇehi ",
  "snp3.4:6.2": "saha brāhmaṇo no bhavanti ",
  "snp3.4:7.1": "brāhmaṇo, ve tvaṃ brūsi ",
  "snp3.4:7.2": "mañca brūsi abrāhmaṇantaṃ ",
  "snp3.4:7.3": "sācittiṃ pucchāmi ",
  "snp3.4:7.4": "tipadaṃ catuvīsatakkharaṃ. ",
  "snp3.4:8.1": "kiṃ nissitā isayo manujā ",
  "snp3.4:8.2": "khattiyā brāhmaṇā devatānaṃ ",
  "snp3.4:8.3": "yaññamakappayiṃsu puthu idha loke, ",
  "snp3.4:9.1": "yadantagu vedagū yañña kāle, ",
  "snp3.4:9.2": "yassāhutiṃ tassijjheti brūmi. ",
  "snp3.4:10.1": "addhā hi tassa hutamijjhe ",
  "snp3.4:10.2": "(iti brāhmaṇo) ",
  "snp3.4:10.3": "yaṃ tādisaṃ vedaguṃ addasāmi, ",
  "snp3.4:10.4": "tumhādisānaṃ hi adassanena ",
  "snp3.4:10.5": "añño jano bhuñjati pūraḷāsaṃ. ",
  "snp3.4:11.1": "tasmātiha tvaṃ brāhmaṇa atthena ",
  "snp3.4:11.2": "atthiko upasaṅkamma puccha, ",
  "snp3.4:11.3": "santaṃ vidhūmaṃ anighaṃ nirāsaṃ ",
  "snp3.4:11.4": "appevidha abhivinde sumedhaṃ. ",
  "snp3.4:12.1": "yaññe ratāhaṃ bho gotama ",
  "snp3.4:12.2": "yaññaṃ yaṭṭhu kāmo nāhaṃ pajānāmi ",
  "snp3.4:12.3": "anusāsatu maṃ bhavaṃ ",
  "snp3.4:12.4": "yattha hutaṃ ijjhe brūhi metaṃ. ",
  "snp3.4:13.1": "tena hi tvaṃ brāhmaṇa odahassu sotaṃ dhammaṃ te desissāmi, ",
  "snp3.4:14.1": "mā jātiṃ pucchi caraṇañca puccha ",
  "snp3.4:14.2": "kaṭṭhā have jāyati jātavedo, ",
  "snp3.4:14.3": "nīcā kulīnopi munī dhitimā ",
  "snp3.4:14.4": "ājāniyo hoti hirīnisedho. ",
  "snp3.4:15.1": "saccena danto damasā upeto ",
  "snp3.4:15.2": "vedantagū vusitabrahmacariyo, ",
  "snp3.4:15.3": "kālena tamhi havyaṃ pavecche ",
  "snp3.4:15.4": "yo brāhmaṇo puññapekho yajetha. ",
  "snp3.4:16.1": "ye kāme hitvā agahā carantī ",
  "snp3.4:16.2": "susaññatattā tasaraṃ va ujjuṃ, ",
  "snp3.4:16.3": "kālena tesu havyaṃ pavecche ",
  "snp3.4:16.4": "yo brāhmaṇo puññapekho yajetha. ",
  "snp3.4:17.1": "ye vītarāgā susamāhitindriyā ",
  "snp3.4:17.2": "cando’va rāhuggahaṇā pamuttā, ",
  "snp3.4:17.3": "kālena tesu havyaṃ pavecche ",
  "snp3.4:17.4": "yo brāhmaṇo puññapekho yajetha. ",
  "snp3.4:18.1": "asajjamānā vicaranti loke ",
  "snp3.4:18.2": "sadā satā hitvā mamāyitāni, ",
  "snp3.4:18.3": "kālena tesu havyaṃ pavecche ",
  "snp3.4:18.4": "yo brāhmaṇo puññapekho yajetha. ",
  "snp3.4:19.1": "ye kāme hitvā abhibhuyyacāri ",
  "snp3.4:19.2": "yo vedi jātimaraṇassa antaṃ, ",
  "snp3.4:19.3": "parinibbuto udakarahadova sīto ",
  "snp3.4:19.4": "tathāgato arahati pūraḷāsaṃ. ",
  "snp3.4:20.1": "samo samehi visamehi dūre ",
  "snp3.4:20.2": "tathāgato hoti anantapañño, ",
  "snp3.4:20.3": "anūpalitto idha vā huraṃ vā ",
  "snp3.4:20.4": "tathāgato arahati pūraḷāsaṃ. ",
  "snp3.4:21.1": "yamhi na māhā vasatī na māno ",
  "snp3.4:21.2": "yo vītalobho amamo nirāso, ",
  "snp3.4:21.3": "panuṇṇa kodho abhinibbutatto ",
  "snp3.4:21.4": "yo brāhmaṇo sokamalaṃ abhāsi ",
  "snp3.4:21.5": "tathāgato arahati pūraḷāsaṃ. ",
  "snp3.4:22.1": "nivesanaṃ yo manaso ahāsi ",
  "snp3.4:22.2": "pariggahā yassa na santi keci, ",
  "snp3.4:22.3": "anupādiyāno idha vā huraṃ vā ",
  "snp3.4:22.4": "tathāgato arahati pūraḷāsaṃ. ",
  "snp3.4:23.1": "samāhito yo udatāri oghaṃ ",
  "snp3.4:23.2": "dhammaṃ caññāsi paramāya diṭṭhiyā, ",
  "snp3.4:23.3": "khīṇāsavo antimadehadhārī ",
  "snp3.4:23.4": "tathāgato arahati pūraḷāsaṃ. ",
  "snp3.4:24.1": "bhavāsavā yassa vacīkharā ca ",
  "snp3.4:24.2": "vidhūpitā atthagatā na santi, ",
  "snp3.4:24.3": "sa vedagū sabbadhi vippamutto ",
  "snp3.4:24.4": "tathāgato arahati pūraḷāsaṃ. ",
  "snp3.4:25.1": "saṅgātigo yassa na santi saṅgā ",
  "snp3.4:25.2": "so mānasattesu amānasatto ",
  "snp3.4:25.3": "dukkhaṃ pariññāya sakhettavatthuṃ ",
  "snp3.4:25.4": "tathāgato arahati pūraḷāsaṃ. ",
  "snp3.4:26.1": "āsaṃ anissāya vivekadassī ",
  "snp3.4:26.2": "paravediyaṃ diṭṭhimupātivatto, ",
  "snp3.4:26.3": "ārammaṇā yassa na santi keci ",
  "snp3.4:26.4": "tathāgato arahati pūraḷāsaṃ. ",
  "snp3.4:27.1": "parovarā yassa samecca dhammā ",
  "snp3.4:27.2": "vidhūpitā atthagatā na santi, ",
  "snp3.4:27.3": "santo upādānakhaye vimutto ",
  "snp3.4:27.4": "tathāgato arahati pūraḷāsaṃ. ",
  "snp3.4:28.1": "saṃyojanaṃ jātikhayantadassī ",
  "snp3.4:28.2": "yopānudi rāgapathaṃ asesaṃ, ",
  "snp3.4:28.3": "suddho niddoso vimalo akāco ",
  "snp3.4:28.4": "tathāgato arahati pūraḷāsaṃ. ",
  "snp3.4:29.1": "yo attanāttānaṃ nānupassati ",
  "snp3.4:29.2": "samāhito ujajugato ṭhitatto, ",
  "snp3.4:29.3": "sa ve anejo akhilo akaṅkho ",
  "snp3.4:29.4": "tathāgato arahati pūraḷāsaṃ. ",
  "snp3.4:30.1": "mohantarā yassa na santi keci ",
  "snp3.4:30.2": "sabbesu dhammesu ca ñāṇadassī, ",
  "snp3.4:30.3": "sarīrañca antimaṃ dhāreti ",
  "snp3.4:30.4": "patto ca sambodhimanuttaraṃ sivaṃ ",
  "snp3.4:30.5": "ettāvatā yakkhassa suddhī ",
  "snp3.4:30.6": "tathāgato arahati pūraḷāsaṃ. ",
  "snp3.4:31.1": "hutaṃ ca mayhaṃ hutamatthu saccaṃ ",
  "snp3.4:31.2": "yaṃ tādisaṃ vedagunaṃ alatthaṃ, ",
  "snp3.4:31.3": "brahmā hi sakkhi patigaṇhātu me bhagavā ",
  "snp3.4:31.4": "bhuñjatu me bhagavā pūraḷāsaṃ. ",
  "snp3.4:32.1": "gāthābhigītaṃ me abhojaneyyaṃ ",
  "snp3.4:32.2": "sampassataṃ brāhmaṇa nesa dhammo, ",
  "snp3.4:32.3": "gāthābhigītaṃ panudanti buddhā ",
  "snp3.4:32.4": "dhamme satī brāhmaṇa vuttiresā. ",
  "snp3.4:33.1": "aññena ca kevalinaṃ mahesiṃ ",
  "snp3.4:33.2": "khīṇāsavaṃ kukkuccavūpasantaṃ, ",
  "snp3.4:33.3": "annena pānena upaṭṭhahassu ",
  "snp3.4:33.4": "khettaṃ hi taṃ puññapekhassa hoti. ",
  "snp3.4:34.1": "sādhāhaṃ bhagavā tathā vijaññaṃ ",
  "snp3.4:34.2": "yo dakkhiṇaṃ bhuñjeyya mādisassa, ",
  "snp3.4:34.3": "yaṃ yaññakāle pariyesamāno ",
  "snp3.4:34.4": "pappuyya tava sāsanaṃ. ",
  "snp3.4:35.1": "sārambhā yassa vigatā ",
  "snp3.4:35.2": "cittaṃ yassa anāvilaṃ, ",
  "snp3.4:35.3": "vippamutto ca kāmehi ",
  "snp3.4:35.4": "thinaṃ yassa panūditaṃ. ",
  "snp3.4:36.1": "sīmantānaṃ vinetāraṃ ",
  "snp3.4:36.2": "jātimaraṇakovidaṃ, ",
  "snp3.4:36.3": "muniṃ moneyyasampannaṃ ",
  "snp3.4:36.4": "tādisaṃ yaññamāgataṃ ",
  "snp3.4:37.1": "bhukuṭiṃ vinayitvāna ",
  "snp3.4:37.2": "pañjalikā namassatha, ",
  "snp3.4:37.3": "pūjetha annapānena ",
  "snp3.4:37.4": "evaṃ ijjhanti dakkhiṇā. ",
  "snp3.4:38.1": "buddho bhavaṃ arahati pūraḷāsaṃ ",
  "snp3.4:38.2": "puññakkhettamanuttaraṃ, ",
  "snp3.4:38.3": "āyāgo sabbalokassa ",
  "snp3.4:38.4": "bhoto dinnaṃ mahapphalanti. ",
  "snp3.4:39.1": "atha kho sundarikabhāradvājo brāhmaṇo bhagavantaṃ etadavoca: ",
  "snp3.4:39.2": "abhikkantaṃ bho gotama, abhikkantaṃ bho gotama, ",
  "snp3.4:39.3": "seyyathāpi bho gotama nikkujjitaṃ vā ukkujjeyya, paṭicchannaṃ vā vivareyya, mūḷhassa vā maggaṃ ācikkheyya, andhakāre vā tela pajjotaṃ dhāreyya cakkhumanto rūpāni dakkhinanti, evamevaṃ bhotā gotamena anekapariyāyena dhammo pakāsito. ",
  "snp3.4:39.4": "esāhaṃ bhavantaṃ gotamaṃ saraṇaṃ gacchāmidhammañca bhikkhusaṅghañca. ",
  "snp3.4:39.5": "labheyyāhaṃbhoto gotamassa santike pabbajjaṃ labheyyaṃ upasampadanti, ",
  "snp3.4:39.6": "alattha kho sundarikabhāradvājo brāhmaṇo …pe… ",
  "snp3.4:39.7": "arahataṃ ahosīti. ",
  "snp3.4:39.8": "sundarikabhāradvājasuttaṃ niṭṭhitaṃ "
}
