{
  "snp3.5:0.1": "",
  "snp3.5:0.2": "3. 5. māghasuttaṃ ",
  "snp3.5:1.1": "evaṃ me sutaṃ ",
  "snp3.5:1.2": "ekaṃ samayaṃ bhagavā rājagahe viharati gijjhakūṭe pabbate. ",
  "snp3.5:1.3": "atha kho māgho māṇavo yena bhagavā tenupasaṅkami upasaṅkamitvā bhagavatā saddhiṃ sammodi, ",
  "snp3.5:1.4": "sammodanīyaṃ kathaṃ sārāṇīyaṃ vītisāretvā ekamantaṃ nisīdi, ",
  "snp3.5:1.5": "ekamantaṃ nisinno kho māgho māṇavo bhagavantaṃ etadavoca: ",
  "snp3.5:2.1": "ahaṃ hi bho gotama, dāyako dānapati vadaññū yācayogo ",
  "snp3.5:2.2": "dhammena bhoge pariyesāmi, ",
  "snp3.5:2.3": "dhammena bhoge pariyesitvā dhammaladdhehi bhogehi dhammādhigatehi ekassāpi dadāmi davinnampi dadāmi tiṇṇampi dadāmi catunnampi dadāmi pañcannampi dadāmi channampi dadāmi sattannampi dadāmi aṭṭhannampi dadāmi navannampi dadāmi dasannampi dadāmi vīsāyapi dadāmi tiṃsāyapi dadāmi cattārīsāyapi dadāmi paññāsāyapi dadāmi satassapi dadāmi bhiyyopi dadāmi. ",
  "snp3.5:2.4": "kaccāhaṃ gotama ekaṃ dadanto evaṃ yajanto bahuṃ puññaṃ pasavāmiti, ",
  "snp3.5:3.1": "taggha tvaṃ māṇava, evaṃ dadanto evaṃ yajanto ",
  "snp3.5:3.2": "",
  "snp3.5:3.3": "",
  "snp3.5:3.4": "pariyesitvā dhammaladdhehi bhogehi dhammādhigatehi ekassapi dadāti …pe… satassapi dadāti bhiyyo pi dadāmi bahuṃ puññaṃ pasavatīti, ",
  "snp3.5:3.5": "atha kho māgho māṇavo bhagavantaṃ gāthāya ajjhabhāsi. ",
  "snp3.5:4.1": "pucchāmahaṃ gotamaṃ vadaññuṃ ",
  "snp3.5:4.2": "(iti māgho māṇavo) ",
  "snp3.5:4.3": "kāsāyavāsiṃ agihaṃ carantaṃ ",
  "snp3.5:4.4": "yo yācayogo dānapatī gahaṭṭho, ",
  "snp3.5:4.5": "",
  "snp3.5:4.6": "dadaṃ paresaṃ idha annapānaṃ ",
  "snp3.5:4.7": "kattha hutaṃ yajamānassa sujjhe. ",
  "snp3.5:5.1": "yo yācayogo dānapatī gahaṭṭho ",
  "snp3.5:5.2": "(māghāti bhagavā) ",
  "snp3.5:5.3": "puññatthiko yajati puññapekho ",
  "snp3.5:5.4": "dadaṃ paresaṃ idha annapānaṃ ",
  "snp3.5:5.5": "ārādhaye dakkhiṇeyye hi tādi. ",
  "snp3.5:6.1": "yo yācayogo dānapatī gahaṭṭho ",
  "snp3.5:6.2": "(iti māgho māṇavo) ",
  "snp3.5:6.3": "puññatthiko yajati puññapekho, ",
  "snp3.5:6.4": "dadaṃ paresaṃ idha annapānaṃ ",
  "snp3.5:6.5": "akkhāhi me bhagavā dakkhiṇeyye. ",
  "snp3.5:7.1": "ye ce asattā vicaranti loke ",
  "snp3.5:7.2": "akiñcanā kevalino yatattā, ",
  "snp3.5:7.3": "kālena tesu havyaṃ pavecche ",
  "snp3.5:7.4": "yo brāhmaṇo puññapekho yajetha. ",
  "snp3.5:8.1": "ye sabbaṃsayojanabandhanacchidā ",
  "snp3.5:8.2": "dantā vimuttā anīghā nirāsā, ",
  "snp3.5:8.3": "kālena tesu havyaṃ pavecche ",
  "snp3.5:8.4": "yo brāhmaṇo puññapekho yajetha. ",
  "snp3.5:9.1": "ye sabbasaṃyojanavippamuttā ",
  "snp3.5:9.2": "dantā vimuttā anīghā nirāsā ",
  "snp3.5:9.3": "kālena tesu havyaṃ pavecche ",
  "snp3.5:9.4": "yo brāhmaṇo puññapekho yajetha. ",
  "snp3.5:10.1": "rāgañca dosañca pahāya mohaṃ ",
  "snp3.5:10.2": "khīṇāsavā vusitabrahmacariyā, ",
  "snp3.5:10.3": "kālena tesu havyaṃ pavecche ",
  "snp3.5:10.4": "yo brāhmaṇo puññapekho yajetha. ",
  "snp3.5:11.1": "yesu na māyā vasati na māno ",
  "snp3.5:11.2": "",
  "snp3.5:11.3": "",
  "snp3.5:11.4": "",
  "snp3.5:12.1": "ye vītalobhā amamā nirāsā, ",
  "snp3.5:12.2": "",
  "snp3.5:12.3": "kālena tesu havyaṃ pavecche ",
  "snp3.5:12.4": "yo brāhmaṇo puññapekho yajetha. ",
  "snp3.5:13.1": "ye ve na taṇhāsu upātipannā ",
  "snp3.5:13.2": "vitareyya oghaṃ amamā caranti. ",
  "snp3.5:13.3": "kālena tesu havyaṃ pavecche ",
  "snp3.5:13.4": "yo brāhmaṇo puññapekho yajetha. ",
  "snp3.5:14.1": "yesaṃ taṇhā natthi kuhiñci loke ",
  "snp3.5:14.2": "bhavābhavāya idha vā huraṃ vā, ",
  "snp3.5:14.3": "kālena tesu havyaṃ pavecche ",
  "snp3.5:14.4": "yo brāhmaṇo puññapekho yajetha. ",
  "snp3.5:15.1": "ye kāme hitvā agihā caranti ",
  "snp3.5:15.2": "susaññatattā tasaraṃva ujjuṃ ",
  "snp3.5:15.3": "kālena tesu havyaṃ pavecche ",
  "snp3.5:15.4": "yo brāhmaṇo puññapekho yajetha. ",
  "snp3.5:16.1": "ye vītarāgā susamāhitindriyā ",
  "snp3.5:16.2": "candova rāhuggahaṇā pamuttā, ",
  "snp3.5:16.3": "kālena tesu havyaṃ pavecche ",
  "snp3.5:16.4": "yo brāhmaṇo puññapekho yajetha. ",
  "snp3.5:17.1": "samitāvino vītarāgā akopā ",
  "snp3.5:17.2": "yesaṃ gatī natthi idha vippahāya, ",
  "snp3.5:17.3": "kālena tesu havyaṃ pavecche ",
  "snp3.5:17.4": "yo brāhmaṇo puññapekho yajetha. ",
  "snp3.5:18.1": "jahitvā jātimaraṇaṃ asesaṃ ",
  "snp3.5:18.2": "kathaṃkathiṃ sabbamupātivattā, ",
  "snp3.5:18.3": "kālena tesu havyaṃ pavecche ",
  "snp3.5:18.4": "yo brāhmaṇo puññapekho yajetha. ",
  "snp3.5:19.1": "ye attadīpā vivaranti loke ",
  "snp3.5:19.2": "akiñcanā sabbadhi vippamuttā, ",
  "snp3.5:19.3": "kālena tesu havyaṃ pavecche ",
  "snp3.5:19.4": "yo brāhmaṇo puññapekho yajetha. ",
  "snp3.5:20.1": "ye hettha jānanti yathā yathā idaṃ ",
  "snp3.5:20.2": "ayamantimā natthi punabbhavoti, ",
  "snp3.5:20.3": "kālena tesu havyaṃ pavecche ",
  "snp3.5:20.4": "yo brāhmaṇo puññapekho yajetha. ",
  "snp3.5:21.1": "yo vedagū jhānarato satīmā ",
  "snp3.5:21.2": "sambodhipatto saraṇaṃ bahunnaṃ, ",
  "snp3.5:21.3": "kālena tamhi havyaṃ pavecche ",
  "snp3.5:21.4": "yo brāhmaṇo puññapekho yajetha. ",
  "snp3.5:22.1": "addhā amoghā mama pucchānā ahu ",
  "snp3.5:22.2": "(iti māghomāṇavo) ",
  "snp3.5:22.3": "akkhāsi me bhagavā dakkhiṇeyyo, tvaṃ ",
  "snp3.5:22.4": "hettha jānāsi yathā tathā idaṃ ",
  "snp3.5:22.5": "tathā hi te vidito esa dhammo. ",
  "snp3.5:23.1": "yo yācayogo dānapatī gahaṭṭho ",
  "snp3.5:23.2": "puññatthiko yajati puññapekho, ",
  "snp3.5:23.3": "dadaṃ paresaṃ idha annapānaṃ ",
  "snp3.5:23.4": "akkhāhi me bhagavā yaññasampadaṃ. ",
  "snp3.5:24.1": "yajassu yajamāno ",
  "snp3.5:24.2": "māghāti (bhagavā) ",
  "snp3.5:24.3": "sabbattha ca vippasādehi cittaṃ, ",
  "snp3.5:24.4": "ārammaṇaṃ yajamānassa yaññaṃ ",
  "snp3.5:24.5": "ettha patiṭṭhāya jahāti dosaṃ. ",
  "snp3.5:25.1": "so vītarāgo pavineyya dosaṃ ",
  "snp3.5:25.2": "mettaṃ cittaṃ bhāvayaṃ appamāṇaṃ, ",
  "snp3.5:25.3": "rattindivaṃ satataṃ appamatto ",
  "snp3.5:25.4": "sabbādisā pharate appamaññaṃ. ",
  "snp3.5:26.1": "ko sujjhati muccati bajjhatī ca ",
  "snp3.5:26.2": "kenattanā gacchati brahmalokaṃ, ",
  "snp3.5:26.3": "ajānato me muni brūhi puṭṭho ",
  "snp3.5:26.4": "bhagavā hi me sakkhi brahmajja diṭṭho tuvaṃ ",
  "snp3.5:26.5": "hi no brahmasamoti saccaṃ ",
  "snp3.5:26.6": "kathaṃ upapajjati brahmalokaṃ jutīmā. ",
  "snp3.5:27.1": "yo yajati tividhaṃ puññasampadaṃ ",
  "snp3.5:27.2": "(māghāti bhagavā) ",
  "snp3.5:27.3": "ārādhaye dakkhiṇeyyeti tādī, ",
  "snp3.5:27.4": "evaṃ yajitvā sammā yācayogo ",
  "snp3.5:27.5": "upapajjati brahmalokanti brūmi. ",
  "snp3.5:28.1": "evaṃ vutte māgho māṇavo bhagavantaṃ etadavoca: ",
  "snp3.5:28.2": "abhikkantaṃ bho gotama …pe… ",
  "snp3.5:28.3": "ajjatagge pāṇupetaṃ saraṇaṃ gatanti. ",
  "snp3.5:28.4": "māghasuttaṃ niṭṭhitaṃ. "
}
