{
  "snp3.9:0.1": "",
  "snp3.9:0.2": "3. 9. vāseṭṭhasuttaṃ ",
  "snp3.9:1.1": "evaṃ me sutaṃ ",
  "snp3.9:1.2": "ekaṃ samayaṃ bhagavā icchānaṅgale viharati icchānaṅgalavanasaṇḍe, ",
  "snp3.9:1.3": "tena kho pana samayena sambahulā abhiññātā brāhmaṇamahāsālā icchānaṅgale paṭivasanti, seyyathīdaṃ ",
  "snp3.9:1.4": "caṅki brāhmaṇo tārukkho brāhmaṇo, pokkharasāti brāhmaṇo jāṇussoṇī brāhmaṇo todeyya brāhmaṇo aññe ca abhiññātā abhiññātā brāhmaṇamahāsāḷā. ",
  "snp3.9:1.5": "atha kho vāseṭṭhabhāradvājānaṃ māṇavānaṃ jaṅghāvihāraṃ anuvaṅkamamānānaṃ anuvivaramānānaṃ ayamantarā kathā udapādi, ",
  "snp3.9:1.6": "kathaṃ bho brāhmaṇo hotīti. ",
  "snp3.9:2.1": "bhāradvājo māṇavo eva māha: ",
  "snp3.9:2.2": "yato kho bho ubhato sujāto hoti mātito ca pitito ca saṃsuddhagahaṇiko yāva sattamā pitāmahayugā akkhitto anupakkuṭṭho jātivādena ",
  "snp3.9:2.3": "ettāvatā kho brāhmaṇo hotīti. ",
  "snp3.9:3.1": "vāseṭṭho māṇavo eva māha: ",
  "snp3.9:3.2": "yato kho bho sīlavā ca hoti vattasampanno ca ",
  "snp3.9:3.3": "ettāvatā kho brāhmaṇo hotīti. ",
  "snp3.9:3.4": "neva kho asakkhi bhāradvājo māṇavo vāseṭṭhaṃ māṇavaṃ saññāpetuṃ, na pana asakkhi vāseṭṭho māṇavo bhāradvājaṃ māṇavañca saññāpetuṃ. ",
  "snp3.9:4.1": "atha kho vāseṭṭho māṇavo bhāradvājaṃ māṇavaṃ āmantesi: ",
  "snp3.9:4.2": "ayaṃ kho bhāradvāja samaṇo gotamo sakyaputto sakyakulā pabbajito icchānaṅgale viharati icchānaṅgalavanasaṇḍe, ",
  "snp3.9:4.3": "taṃ kho pana bhavantaṃ gotamaṃ evaṃ kalyāṇo kittisaddo abbhuggato: ",
  "snp3.9:4.4": "itipi …pe… buddho bhagavāti. ",
  "snp3.9:4.5": "āyāma bho bhāradvāja, yena samaṇo gotamo tenupasaṅkamissāma, upasaṅkamitvā samaṇaṃ gotamaṃ etamatthaṃ pucchissāma, ",
  "snp3.9:4.6": "yathā no samaṇo gotamo vyākarissati tathā naṃ dhāressāmāti. ",
  "snp3.9:4.7": "evaṃ hoti kho bhāradvājo māṇavo vāseṭṭhassa māṇavassa paccassosi. ",
  "snp3.9:5.1": "atha kho vāseṭṭhabhāradvājā māṇavā yena bhagavā tenupasaṅkamiṃsu. upasaṅkamitvā bhagavatā saddhiṃ sammodiṃsu. ",
  "snp3.9:5.2": "sammodanīyaṃ kathaṃ sārāṇīyaṃ vītisāretvā ekamantaṃ nisīdiṃsu, ",
  "snp3.9:5.3": "ekamantaṃ nisinno kho vāseṭṭho māṇavo bhagavantaṃ gāthāya ajjhābhāsi. ",
  "snp3.9:6.1": "anuññātapaṭiññātā ",
  "snp3.9:6.2": "tevijjā mayamasma bho, ",
  "snp3.9:6.3": "ahaṃ pokkharasātissa ",
  "snp3.9:6.4": "tārukkhassā’yaṃ māṇavo. ",
  "snp3.9:7.1": "tevijjānaṃ yadakkhātaṃ ",
  "snp3.9:7.2": "nanu kevalino’sma se, ",
  "snp3.9:7.3": "padakā’sma veyyākaraṇā ",
  "snp3.9:7.4": "jappe ācariyasādisā. ",
  "snp3.9:8.1": "tesaṃ no jātivādasmiṃ ",
  "snp3.9:8.2": "vivādo atthi gotama, ",
  "snp3.9:8.3": "jātiyā brāhmaṇo hoti ",
  "snp3.9:8.4": "bhāradvājo iti bhāsati. ",
  "snp3.9:8.5": "ahañca kammanā brūmi ",
  "snp3.9:8.6": "evaṃ jānāhi cakkhuma. ",
  "snp3.9:9.1": "te na sakkoma saññāpetuṃ ",
  "snp3.9:9.2": "aññamaññaṃ mayaṃ ubho, ",
  "snp3.9:9.3": "bhagavantaṃ puṭṭhumāgamma ",
  "snp3.9:9.4": "sambuddhaṃ iti vissutaṃ. ",
  "snp3.9:10.1": "candaṃ yathā khayātītaṃ ",
  "snp3.9:10.2": "pecca pañjalikā janā, ",
  "snp3.9:10.3": "vandamānā namassanti ",
  "snp3.9:10.4": "evaṃ lokasmi gotamaṃ. ",
  "snp3.9:11.1": "cakkhuṃ loke samuppannaṃ ",
  "snp3.9:11.2": "mayaṃ pucchāma gotamaṃ, ",
  "snp3.9:11.3": "jātiyā brāhmaṇo hoti ",
  "snp3.9:11.4": "udāhu bhavati kammanā; ",
  "snp3.9:11.5": "ajānataṃ no pabrūhi ",
  "snp3.9:11.6": "yathā jānemu brāhmaṇaṃ. ",
  "snp3.9:12.1": "tesaṃ vohaṃ vyakkhissaṃ ",
  "snp3.9:12.2": "(vāseṭṭhāti bhagavā) ",
  "snp3.9:12.3": "anupubbaṃ yathātathaṃ ",
  "snp3.9:12.4": "jātivibhāgaṃ pāṇānaṃ ",
  "snp3.9:12.5": "aññamaññā hi jātiyo. ",
  "snp3.9:13.1": "tiṇarukkhepi jānātha ",
  "snp3.9:13.2": "na cāpi paṭijānare, ",
  "snp3.9:13.3": "liṅgaṃ jātimayaṃ tesaṃ ",
  "snp3.9:13.4": "aññamaññā hi jātiyo. ",
  "snp3.9:14.1": "tato kīṭe paṭaṅge ca ",
  "snp3.9:14.2": "yāca kuntakipillike, ",
  "snp3.9:14.3": "liṅgaṃ jātimayaṃ tesaṃ ",
  "snp3.9:14.4": "aññamaññā hi jātiyo. ",
  "snp3.9:15.1": "catuppade pi jānātha ",
  "snp3.9:15.2": "khuddake ca mahallake, ",
  "snp3.9:15.3": "liṅgaṃ jātimayaṃ tesaṃ ",
  "snp3.9:15.4": "aññamaññā hi jātiyo. ",
  "snp3.9:16.1": "pādūdare’pi jānātha ",
  "snp3.9:16.2": "urage dīghapiṭṭhike, ",
  "snp3.9:16.3": "liṅgaṃ jātimayaṃ tesaṃ ",
  "snp3.9:16.4": "aññamaññā hi jātiyo. ",
  "snp3.9:17.1": "tato macche’pi jānātha ",
  "snp3.9:17.2": "odake vārigocare, ",
  "snp3.9:17.3": "liṅgaṃ jātimayaṃ tesaṃ ",
  "snp3.9:17.4": "aññamaññā hi jātiyo. ",
  "snp3.9:18.1": "tato pakkhīpi jānātha ",
  "snp3.9:18.2": "pattayāne vibhaṅgame, ",
  "snp3.9:18.3": "liṅgaṃ jātimayaṃ tesaṃ ",
  "snp3.9:18.4": "aññamaññā hi jātiyo. ",
  "snp3.9:19.1": "yathā etāsu jātīsu ",
  "snp3.9:19.2": "liṅgaṃ jātimayaṃ puthu, ",
  "snp3.9:19.3": "evaṃ natthi manussesu ",
  "snp3.9:19.4": "liṅgaṃ jātimayaṃ puthu. ",
  "snp3.9:20.1": "na kesehi na sīsena ",
  "snp3.9:20.2": "na kaṇṇehi na akkhīhi ",
  "snp3.9:20.3": "na mukhena na nāsāya ",
  "snp3.9:20.4": "na oṭṭhehi bhamūhi vā. ",
  "snp3.9:21.1": "na gīvāya na aṃsehi ",
  "snp3.9:21.2": "na udarena na piṭṭhiyā, ",
  "snp3.9:21.3": "na yoniyā na urasā ",
  "snp3.9:21.4": "na sambādhe na methune. ",
  "snp3.9:22.1": "na hatthehi na pādehi ",
  "snp3.9:22.2": "nāṅgulīhi nakhehi vā, ",
  "snp3.9:22.3": "na jaṅghāhi na ūrūhi ",
  "snp3.9:22.4": "na vaṇṇena sarena vā. ",
  "snp3.9:22.5": "liṅgaṃ jātimayaṃ neva ",
  "snp3.9:22.6": "yathā aññāsu jātīsu. ",
  "snp3.9:23.1": "paccattaṃ ca sarīresu ",
  "snp3.9:23.2": "manussesvetaṃ na vijjati, ",
  "snp3.9:23.3": "vohārañca manussesu ",
  "snp3.9:23.4": "samaññāya pavuccati. ",
  "snp3.9:24.1": "yo hi koci manussesu ",
  "snp3.9:24.2": "gorakkhaṃ upajīvati, ",
  "snp3.9:24.3": "evaṃ vāseṭṭha jānāhi ",
  "snp3.9:24.4": "kassapo so na brāhmaṇo. ",
  "snp3.9:25.1": "yo hi koci manussesu ",
  "snp3.9:25.2": "puthu sippena jīvati, ",
  "snp3.9:25.3": "evaṃ vāseṭṭha jānāhi ",
  "snp3.9:25.4": "sippiko so na brāhmaṇo. ",
  "snp3.9:26.1": "yo hi koci manussesu ",
  "snp3.9:26.2": "vohāraṃ upajīvati, ",
  "snp3.9:26.3": "evaṃ vāseṭṭha jānāhi ",
  "snp3.9:26.4": "vāṇijo so na brāhmaṇo. ",
  "snp3.9:27.1": "yo hi koci manussesu ",
  "snp3.9:27.2": "parapessena jīvati, ",
  "snp3.9:27.3": "evaṃ vāseṭṭha jānāhi ",
  "snp3.9:27.4": "pessiko so na brāhmaṇo. ",
  "snp3.9:28.1": "yo hi koci manussesu ",
  "snp3.9:28.2": "adinnaṃ upajīvati, ",
  "snp3.9:28.3": "evaṃ vāseṭṭha jānāhi ",
  "snp3.9:28.4": "coro eso na brāhmaṇo. ",
  "snp3.9:29.1": "yo hi koci manussesu ",
  "snp3.9:29.2": "issatthaṃ upajīvati, ",
  "snp3.9:29.3": "evaṃ vāseṭṭha jānāhi ",
  "snp3.9:29.4": "yodhājīvo na brāhmaṇo. ",
  "snp3.9:30.1": "yo hi koci manussesu ",
  "snp3.9:30.2": "porohiccena jīvati, ",
  "snp3.9:30.3": "evaṃ vāseṭṭha jānāhi ",
  "snp3.9:30.4": "yājako so na brāhmaṇo. ",
  "snp3.9:31.1": "yo hi koci manussesu ",
  "snp3.9:31.2": "gāmaṃ raṭṭhañca bhuñjati, ",
  "snp3.9:31.3": "evaṃ vāseṭṭha jānāhi ",
  "snp3.9:31.4": "rājā eso na brāhmaṇo. ",
  "snp3.9:32.1": "navā’ haṃ brāhmaṇaṃ brūmi ",
  "snp3.9:32.2": "yonijaṃ mattisambhavaṃ, ",
  "snp3.9:32.3": "bhovādi nāma so hoti ",
  "snp3.9:32.4": "sace hoti sakiñcano. ",
  "snp3.9:32.5": "",
  "snp3.9:32.6": "",
  "snp3.9:33.1": "sabbasaṃyojanaṃ jetvā ",
  "snp3.9:33.2": "yo ve na paritassati, ",
  "snp3.9:33.3": "saṅgātigaṃ visaṃyuttaṃ ",
  "snp3.9:33.4": "tamahaṃ brūmi brāhmaṇaṃ. ",
  "snp3.9:34.1": "chetvā naddhiṃ varattañca ",
  "snp3.9:34.2": "sandānaṃ sahanukkamaṃ, ",
  "snp3.9:34.3": "ukkhīttapalighaṃ buddhaṃ ",
  "snp3.9:34.4": "tamahaṃ brūmi brāhmaṇaṃ ",
  "snp3.9:35.1": "akkosaṃ vadhabandhañca ",
  "snp3.9:35.2": "aduṭṭho yo titikkhati, ",
  "snp3.9:35.3": "khantībalaṃ balānīkaṃ ",
  "snp3.9:35.4": "tamahaṃ brūmi brāhmaṇaṃ ",
  "snp3.9:36.1": "akkodhanaṃ vatavantaṃ ",
  "snp3.9:36.2": "sīlavantaṃ anussadaṃ, ",
  "snp3.9:36.3": "dantaṃ antimasārīraṃ ",
  "snp3.9:36.4": "tamahaṃ brūmi brāhmaṇaṃ. ",
  "snp3.9:37.1": "vāri pokkharapatteva ",
  "snp3.9:37.2": "āraggeriva sāsapo, ",
  "snp3.9:37.3": "yo na lippati kāmesu ",
  "snp3.9:37.4": "tamahaṃ brūmi brāhmaṇaṃ. ",
  "snp3.9:38.1": "yo dukkhassa pajānāti ",
  "snp3.9:38.2": "idhe’va khayamattano, ",
  "snp3.9:38.3": "pannabhāraṃ visaṃyuttaṃ ",
  "snp3.9:38.4": "tamahaṃ brūmi brāhmaṇaṃ. ",
  "snp3.9:39.1": "gambhīrapaññaṃ medhāviṃ ",
  "snp3.9:39.2": "maggāmaggassa kovidaṃ, ",
  "snp3.9:39.3": "uttamatthaṃ anuppattaṃ ",
  "snp3.9:39.4": "tamahaṃ brūmi brāhmaṇaṃ. ",
  "snp3.9:40.1": "asaṃsaṭṭhaṃ gahaṭṭhehi ",
  "snp3.9:40.2": "anāgārehi cūbhayaṃ, ",
  "snp3.9:40.3": "anokasāriṃ appicchaṃ ",
  "snp3.9:40.4": "tamahaṃ brūmi brāhmaṇaṃ. ",
  "snp3.9:41.1": "nidhāya daṇḍaṃ bhūtesu ",
  "snp3.9:41.2": "tasesu thāvaresu ca, ",
  "snp3.9:41.3": "yo na hanti na ghāteti ",
  "snp3.9:41.4": "tamahaṃ brūmi brāhmaṇaṃ. ",
  "snp3.9:42.1": "aviruddhaṃ viruddhesu ",
  "snp3.9:42.2": "attadaṇḍesu nibbutaṃ, ",
  "snp3.9:42.3": "ādānesu anādānaṃ ",
  "snp3.9:42.4": "tamahaṃ brūmi brāhmaṇaṃ. ",
  "snp3.9:43.1": "yassa rāgo ca doso ca ",
  "snp3.9:43.2": "māno makkho ca pātito, ",
  "snp3.9:43.3": "sāsaporiva āraggā ",
  "snp3.9:43.4": "tamahaṃ brūmi brāhmaṇaṃ. ",
  "snp3.9:44.1": "akakkasaṃ viññapaniṃ ",
  "snp3.9:44.2": "giraṃ saccaṃ udīraye, ",
  "snp3.9:44.3": "yāya nābhisaje kañci ",
  "snp3.9:44.4": "tamahaṃ brūmi brāhmaṇaṃ. ",
  "snp3.9:45.1": "yo’dha dīghaṃ va rassaṃ vā ",
  "snp3.9:45.2": "aṇuṃ thūlaṃ subhāsubhaṃ, ",
  "snp3.9:45.3": "loke adinnaṃ nādiyati ",
  "snp3.9:45.4": "brūmi brāhmaṇaṃ. ",
  "snp3.9:46.1": "āsā yassa na vijjanti ",
  "snp3.9:46.2": "asmiṃ loke paramhi ca, ",
  "snp3.9:46.3": "nirāsasaṃ visaṃyuttaṃ ",
  "snp3.9:46.4": "tamahaṃ brūmi brāhmaṇaṃ. ",
  "snp3.9:47.1": "yassālayā na vijjanti ",
  "snp3.9:47.2": "aññāya akathaṃkathī, amatogadhaṃ ",
  "snp3.9:47.3": "anuppattaṃ ",
  "snp3.9:47.4": "tamahaṃ brūmi brāhmaṇaṃ. ",
  "snp3.9:48.1": "yodha puññaṃ ca pāpañca ",
  "snp3.9:48.2": "ubhosaṅgaṃ upaccagā, ",
  "snp3.9:48.3": "asokaṃ virajaṃ suddhaṃ ",
  "snp3.9:48.4": "tamahaṃ brūmi brāhmaṇaṃ. ",
  "snp3.9:49.1": "candaṃ ca vimalaṃ suddhaṃ ",
  "snp3.9:49.2": "vippasannamanāvilaṃ, ",
  "snp3.9:49.3": "nandibhavaparikkhiṇaṃ ",
  "snp3.9:49.4": "tamahaṃ brūmi brāhmaṇaṃ. ",
  "snp3.9:50.1": "yo imaṃ palipathaṃ duggaṃ ",
  "snp3.9:50.2": "saṃsāraṃ mohamaccagā, ",
  "snp3.9:50.3": "tiṇṇo pāragato jhāyī ",
  "snp3.9:50.4": "anejo akathaṃkathī, ",
  "snp3.9:50.5": "anupādāya nibbuto ",
  "snp3.9:50.6": "tamahaṃ brūmi brāhmaṇaṃ. ",
  "snp3.9:51.1": "yodhaṃ kāme pahatvāna ",
  "snp3.9:51.2": "anāgāro paribbaje, ",
  "snp3.9:51.3": "kāmabhavaparikkhīṇaṃ ",
  "snp3.9:51.4": "tamahaṃ brūmi brāhmaṇaṃ. ",
  "snp3.9:52.1": "yodha taṇhaṃ pahatvāna ",
  "snp3.9:52.2": "anāgāro paribbaje, ",
  "snp3.9:52.3": "taṇhābhavaparikkhīṇaṃ ",
  "snp3.9:52.4": "tamahaṃ brūmi brāhmaṇaṃ. ",
  "snp3.9:53.1": "hitvā mānusakaṃ yogaṃ ",
  "snp3.9:53.2": "dibbaṃ yogaṃ upaccagā, ",
  "snp3.9:53.3": "sabbayogavisaṃyuttaṃ ",
  "snp3.9:53.4": "tamahaṃ brūmi brāhmaṇaṃ. ",
  "snp3.9:54.1": "hitvā ratiñca aratiñca ",
  "snp3.9:54.2": "sītibhūtaṃ nirūpadhiṃ, ",
  "snp3.9:54.3": "sabbalokābhibhuṃ vīraṃ ",
  "snp3.9:54.4": "tamahaṃ brūmi brāhmaṇaṃ. ",
  "snp3.9:55.1": "cutiṃ yo vedi sattānaṃ ",
  "snp3.9:55.2": "upapattiñca sabbaso, ",
  "snp3.9:55.3": "asattaṃ sugataṃ buddhaṃ ",
  "snp3.9:55.4": "tamahaṃ brūmi brāhmaṇaṃ. ",
  "snp3.9:56.1": "yassa gatiṃ na jānanti ",
  "snp3.9:56.2": "devā gandhabbamānusā, ",
  "snp3.9:56.3": "khīṇāsavaṃ arahantaṃ ",
  "snp3.9:56.4": "tamahaṃ brūmi brāhmaṇaṃ. ",
  "snp3.9:57.1": "yassa pure ca pacchā ca ",
  "snp3.9:57.2": "majjhe ca natthi kiñcanaṃ, ",
  "snp3.9:57.3": "akiñcanaṃ anādānaṃ ",
  "snp3.9:57.4": "tamahaṃ brūmi brāhmaṇaṃ. ",
  "snp3.9:58.1": "usabhaṃ pavaraṃ vīraṃ ",
  "snp3.9:58.2": "mahesiṃ vijitāvīnaṃ, ",
  "snp3.9:58.3": "anejaṃ nahātakaṃ buddhaṃ ",
  "snp3.9:58.4": "tamahaṃ brūmi brāhmaṇaṃ. ",
  "snp3.9:59.1": "pubbe nivāsaṃ yo vedi ",
  "snp3.9:59.2": "saggāpāyañca passati, ",
  "snp3.9:59.3": "atho jātikkhayaṃ patto ",
  "snp3.9:59.4": "tamahaṃ brūmi brāhmaṇaṃ. ",
  "snp3.9:60.1": "samaññā hesā lokasmiṃ ",
  "snp3.9:60.2": "nāmagottaṃ pakappitaṃ ",
  "snp3.9:60.3": "sammuccā samudāgataṃ ",
  "snp3.9:60.4": "tattha tattha pakappitaṃ ",
  "snp3.9:61.1": "digharattamanusayitaṃ ",
  "snp3.9:61.2": "diṭṭhigatamajānataṃ, ",
  "snp3.9:61.3": "ajānantā te pabruvanti ",
  "snp3.9:61.4": "jātiyā hoti brāhmaṇo. ",
  "snp3.9:62.1": "na jaccā brāhmaṇo hoti ",
  "snp3.9:62.2": "na jaccā hoti abrāhmaṇo ",
  "snp3.9:62.3": "kammanā brāhmaṇo hoti ",
  "snp3.9:62.4": "kammanā hoti abrāhmaṇo. ",
  "snp3.9:63.1": "kassako kammanā hoti ",
  "snp3.9:63.2": "sippiko hoti kammanā, ",
  "snp3.9:63.3": "vāṇijo kammanā hoti ",
  "snp3.9:63.4": "pessiko hoti kammanā. ",
  "snp3.9:64.1": "coropi kammanā hoti ",
  "snp3.9:64.2": "yodhājīvopi kammanā, ",
  "snp3.9:64.3": "yājako kammanā hoti ",
  "snp3.9:64.4": "rājāpi hoti kammanā. ",
  "snp3.9:65.1": "evametaṃ yathābhūtaṃ ",
  "snp3.9:65.2": "kammaṃ passanti paṇḍitā, ",
  "snp3.9:65.3": "paṭicca samuppādadasā ",
  "snp3.9:65.4": "kammavipākakovidā. ",
  "snp3.9:66.1": "kammanā vattati loko ",
  "snp3.9:66.2": "kammanā vattati pajā, ",
  "snp3.9:66.3": "kammanibandhanā sattā ",
  "snp3.9:66.4": "rathassāṇīva yāyato. ",
  "snp3.9:67.1": "tapena brahmacariyena ",
  "snp3.9:67.2": "saṃyamena damena ca, ",
  "snp3.9:67.3": "etena brāhmaṇo hoti ",
  "snp3.9:67.4": "etaṃ brāhmaṇamuttamaṃ. ",
  "snp3.9:68.1": "tīhi vijjāhi sampanno ",
  "snp3.9:68.2": "santo khīṇapunabbhavo, ",
  "snp3.9:68.3": "evaṃ vāseṭṭha jānāhi ",
  "snp3.9:68.4": "brahmā sakko vijānatanti. ",
  "snp3.9:69.1": "evaṃ vutte vāseṭṭhabhāradvājā māṇavā bhagavantaṃ etadavocuṃ: ",
  "snp3.9:69.2": "abhikkantaṃ bho gotama …pe… ete mayaṃ bhavantaṃ gotamaṃ saraṇaṃ gacchāma dhammañca bhikkhusaṅghañca, ",
  "snp3.9:69.3": "upāsake no bhavaṃ gotamo dhāretu ajjatagge pāṇupetaṃ saraṇaṃ gatanti. ",
  "snp3.9:69.4": "vāseṭṭhasuttaṃ niṭṭhitaṃ. "
}
