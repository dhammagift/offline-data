{
  "dn20:0.1": "",
  "dn20:0.2": "7. mahāsamayasuttaṃ ",
  "dn20:1.1": "evaṃ me sutaṃ: ",
  "dn20:1.2": "ekaṃ samayaṃ bhagavā sakkesu viharati kapilavatthusmiṃ mahāvane mahatā bhikkhusaṅghena saddhiṃ pañcamattehi bhikkhusatehi sabbeheva arahantehi. ",
  "dn20:1.3": "dasahi ca lokadhātūhi devatā yebhuyyena sannipatitā honti bhagavantaṃ dassanāya bhikkhusaṅghañca. ",
  "dn20:2.1": "atha kho catunnaṃ suddhāvāsakāyikānaṃ devatānaṃ etadahosi: ",
  "dn20:2.2": "“ayaṃ kho bhagavā sakkesu viharati kapilavatthusmiṃ mahāvane mahatā bhikkhusaṅghena saddhiṃ pañcamattehi bhikkhusatehi sabbeheva arahantehi. ",
  "dn20:2.3": "dasahi ca lokadhātūhi devatā yebhuyyena sannipatitā honti bhagavantaṃ dassanāya bhikkhusaṅghañca, ",
  "dn20:2.4": "yannūna mayampi yena bhagavā tenupasaṅkameyyāma. upasaṅkamitvā bhagavato santike paccekaṃ gāthaṃ bhāseyyāmā”ti. ",
  "dn20:3.1": "atha kho tā devatā seyyathāpi nāma balavā puriso samiñjitaṃ vā bāhaṃ pasāreyya, pasāritaṃ vā bāhaṃ samiñjeyya, evameva suddhāvāsesu devesu antarahitā bhagavato purato pāturahesuṃ. ",
  "dn20:3.2": "atha kho tā devatā bhagavantaṃ abhivādetvā ekamantaṃ aṭṭhaṃsu. ",
  "dn20:3.3": "ekamantaṃ ṭhitā kho ekā devatā bhagavato santike imaṃ gāthaṃ abhāsi: ",
  "dn20:3.4": "“mahāsamayo pavanasmiṃ ",
  "dn20:3.5": "devakāyā samāgatā, ",
  "dn20:3.6": "āgatamha imaṃ dhammasamayaṃ ",
  "dn20:3.7": "dakkhitāye aparājitasaṅghanti.” ",
  "dn20:3.8": "atha kho aparā devatā bhagavato santike imaṃ gāthaṃ abhāsi: ",
  "dn20:3.9": "“tatra bhikkhavo samādahaṃsu ",
  "dn20:3.10": "cittamattano ujukamakaṃsu, ",
  "dn20:3.11": "sārathīva nettāni gahetvā ",
  "dn20:3.12": "indriyāni rakkhanti paṇḍitā”ti. ",
  "dn20:3.13": "atha kho aparā devatā bhagavato santike imaṃ gāthaṃ abhāsi: ",
  "dn20:3.14": "“chetvā khīlaṃ chetvā palighaṃ ",
  "dn20:3.15": "indakhīlaṃ ūhacca manejā, ",
  "dn20:3.16": "te caranti suddhā vimalā ",
  "dn20:3.17": "cakkhumatā sudantā susu nāgā’ti. ",
  "dn20:3.18": "atha kho aparā devatā bhagavato santike imaṃ gāthaṃ abhāsi: ",
  "dn20:3.19": "“ye keci buddhaṃ saraṇaṃ gatāse ",
  "dn20:3.20": "na te gamissanti apāyabhūmiṃ ",
  "dn20:3.21": "pahāya mānusaṃ dehaṃ ",
  "dn20:3.22": "devakāyaṃ paripūressantī’ti. ",
  "dn20:4.0": "",
  "dn20:4.1": "atha kho bhagavā bhikkhū āmantesi, ",
  "dn20:4.2": "“yebhuyyena bhikkhave, dasasu lokadhātūsu devatā sannipatitā honti, tathāgataṃ dassanāya bhikkhusaṅghañca, ",
  "dn20:4.3": "ye pi te bhikkhave ahesuṃ, atītamaddhānaṃ arahanto sammāsambuddhā, tesampi bhagavantānaṃ etaṃparamā yeva devatā sannipatitā ahesuṃ seyyathāpi mayhaṃ etarahi. ",
  "dn20:4.4": "ye pi te bhikkhave, bhavissantianāgatamaddhānaṃarahantosammāsambuddhā, tesampi bhagavantānaṃ etaṃparamā yeva devatā sannipatitā bhavissanti seyyathāpi mayhaṃ etarahi. ",
  "dn20:4.5": "ācikkhissāmi bhikkhave devakāyānaṃ nāmāni, ",
  "dn20:4.6": "kittayissāmi bhikkhave devakāyānaṃ nāmāni, ",
  "dn20:4.7": "desissāmi bhikkhave devakāyānaṃ nāmāni. ",
  "dn20:4.8": "taṃ suṇātha sādhukaṃ manasi karotha bhāsissāmī”ti. ",
  "dn20:4.9": "“evambhante”ti kho te bhikkhū bhagavato paccassosuṃ. ",
  "dn20:4.10": "bhagavā etadavoca: ",
  "dn20:5.1": "silokamanukassāmi ",
  "dn20:5.2": "yattha bhummā tadassitā, ",
  "dn20:5.3": "ye sītā girigabbharaṃ ",
  "dn20:5.4": "pahitattā samāhitā. ",
  "dn20:5.5": "puthū sīhā’va sallīnā ",
  "dn20:5.6": "lomahaṃsābhisambhuno, ",
  "dn20:5.7": "odātamanasā suddhā ",
  "dn20:5.8": "vippasannā manāvilā. ",
  "dn20:5.9": "bhiyyo pañcasate ñatvā ",
  "dn20:5.10": "vane kāpilavatthave, ",
  "dn20:5.11": "tato āmantayī satthā ",
  "dn20:5.12": "sāvake sāsane rate. ",
  "dn20:5.13": "devakāyā abhikkantā ",
  "dn20:5.14": "te vijānātha bhikkhavo. ",
  "dn20:5.15": "te ca ātappamakaruṃ ",
  "dn20:5.16": "sutvā buddhassa sāsanaṃ. ",
  "dn20:6.1": "tesaṃ pāturahu ñāṇaṃ ",
  "dn20:6.2": "amanussānadassanaṃ, ",
  "dn20:6.3": "appeke satamaddakkhuṃ ",
  "dn20:6.4": "sahassaṃ atha sattariṃ. ",
  "dn20:6.5": "sataṃ eke sahassānaṃ ",
  "dn20:6.6": "amanussānamaddasuṃ, ",
  "dn20:6.7": "appeke’nantamaddakkhuṃ ",
  "dn20:6.8": "disā sabbā phuṭā ahu. ",
  "dn20:6.9": "tañca sabbaṃ abhiññāya ",
  "dn20:6.10": "vavatthitvāna cakkhumā, ",
  "dn20:6.11": "tato āmantayī satthā ",
  "dn20:6.12": "sāvake sāsane rate. ",
  "dn20:6.13": "“devakāyā abhikkantā ",
  "dn20:6.14": "te vijānātha bhikkhavo, ",
  "dn20:6.15": "ye vo’haṃ kittayissāmi ",
  "dn20:6.16": "girāhi anupubbaso. ",
  "dn20:7.1": "sattasahassā te yakkhā ",
  "dn20:7.2": "bhummā kāpilavatthavā, ",
  "dn20:7.3": "iddhimanto jutimanto ",
  "dn20:7.4": "vaṇṇavanto yasassino. ",
  "dn20:7.5": "modamānā abhikkāmuṃ ",
  "dn20:7.6": "bhikkhūnaṃ samitiṃ vanaṃ, ",
  "dn20:7.7": "cha sahassā hemavatā ",
  "dn20:7.8": "yakkhā nānattavaṇṇino. ",
  "dn20:7.9": "iddhimanto jutimanto ",
  "dn20:7.10": "vaṇṇavanto yasassino, ",
  "dn20:7.11": "modamānā abhikkāmuṃ ",
  "dn20:7.12": "bhikkhūnaṃ samitiṃ vanaṃ. ",
  "dn20:7.13": "sātāgirā tisahassā ",
  "dn20:7.14": "yakkhā nānattavaṇṇino ",
  "dn20:7.15": "iddhimanto jutimanto ",
  "dn20:7.16": "vaṇṇavanto yasassino, ",
  "dn20:7.17": "modamānā abhikkāmuṃ ",
  "dn20:7.18": "bhikkhūnaṃ samitiṃ vanaṃ ",
  "dn20:7.19": "iccete soḷasasahassā ",
  "dn20:7.20": "yakkhā nānattavaṇṇino ",
  "dn20:7.21": "iddhimanto jutimanto ",
  "dn20:7.22": "vaṇṇavanto yasassino, ",
  "dn20:7.23": "modamānā abhikkāmuṃ ",
  "dn20:7.24": "bhikkhūnaṃ samitiṃ vanaṃ. ",
  "dn20:8.1": "vessāmittā pañcasatā ",
  "dn20:8.2": "yakkhā nānattavaṇṇino, ",
  "dn20:8.3": "iddhimanto jutimanto ",
  "dn20:8.4": "vaṇṇavanto yasassino, ",
  "dn20:8.5": "modamānā abhikkāmuṃ ",
  "dn20:8.6": "bhikkhūnaṃ samitiṃ vanaṃ ",
  "dn20:8.7": "kumbhīro rājagahiko ",
  "dn20:8.8": "vepullassa nivesanaṃ ",
  "dn20:8.9": "bhiyyo naṃ satasahassaṃ ",
  "dn20:8.10": "yakkhānaṃ payirupāsati ",
  "dn20:8.11": "kumbhīro rājagahiko ",
  "dn20:8.12": "sopāga samitiṃ vanaṃ. ",
  "dn20:9.1": "purimañca disaṃ rājā ",
  "dn20:9.2": "dhataraṭṭho pasāsati. ",
  "dn20:9.3": "gandhabbānaṃ ādhipati ",
  "dn20:9.4": "mahārājā yasassi so. ",
  "dn20:9.5": "puttāpi tassa bahavo ",
  "dn20:9.6": "indanāmā mahabbalā ",
  "dn20:9.7": "iddhimanto jutimanto ",
  "dn20:9.8": "vaṇṇavanto yasassino, ",
  "dn20:9.9": "modamānā abhikkāmuṃ ",
  "dn20:9.10": "bhikkhūnaṃ samitiṃ vanaṃ. ",
  "dn20:9.11": "dakkhiṇañca disaṃ rājā ",
  "dn20:9.12": "virūḷho taṃ pasāsati ",
  "dn20:9.13": "kumbhaṇḍānaṃ adhipati ",
  "dn20:9.14": "mahārājā yasassi so. ",
  "dn20:9.15": "puttāpi tassa bahavo ",
  "dn20:9.16": "indanāmā mahabbalā ",
  "dn20:9.17": "iddhimanto jutimanto ",
  "dn20:9.18": "vaṇṇavanto yasassino, ",
  "dn20:9.19": "modamānā abhikkāmuṃ ",
  "dn20:9.20": "bhikkhūnaṃ samitiṃ vanaṃ. ",
  "dn20:9.21": "pacchimañca disaṃ rājā ",
  "dn20:9.22": "virūpakkho pasāsati ",
  "dn20:9.23": "nāgāṇañca adhipati ",
  "dn20:9.24": "mahārājā yasassi so. ",
  "dn20:9.25": "puttāpi tassa bahavo ",
  "dn20:9.26": "indanāmā mahabbalā ",
  "dn20:9.27": "iddhimanto jutimanto ",
  "dn20:9.28": "vaṇṇavanto yasassino, ",
  "dn20:9.29": "modamānā abhikkāmuṃ ",
  "dn20:9.30": "bhikkhūnaṃ samitiṃ vanaṃ. ",
  "dn20:9.31": "uttarañca disaṃ rājā ",
  "dn20:9.32": "kuvero taṃ pasāsati ",
  "dn20:9.33": "yakkhānañca adhipati ",
  "dn20:9.34": "mahārājā yasassiso. ",
  "dn20:9.35": "puttāpi tassa bahavo ",
  "dn20:9.36": "indanāmā mahabbalā ",
  "dn20:9.37": "iddhimanto jutimanto ",
  "dn20:9.38": "vaṇṇavanto yasassino, ",
  "dn20:9.39": "modamānā abhikkāmuṃ ",
  "dn20:9.40": "bhikkhūnaṃ samitiṃ vanaṃ. ",
  "dn20:9.41": "purimaṃ disaṃ dhataraṭṭho ",
  "dn20:9.42": "dakkhiṇena virūḷhako ",
  "dn20:9.43": "pacchimena virūpakkho ",
  "dn20:9.44": "kuvero uttaraṃ disaṃ. ",
  "dn20:9.45": "cattāro te mahārājā ",
  "dn20:9.46": "samantā caturo disā ",
  "dn20:9.47": "dadallamānā aṭṭhaṃsu ",
  "dn20:9.48": "vane kāpilavatthave. ",
  "dn20:10.1": "tesaṃ māyāvino dāsā ",
  "dn20:10.2": "āguṃ vañcanikā saṭhā ",
  "dn20:10.3": "māyā kuṭeṇḍu veṭeṇḍu ",
  "dn20:10.4": "viṭucca viṭuḍo saha ",
  "dn20:10.5": "candano kāmaseṭṭhā ca ",
  "dn20:10.6": "kinnighaṇḍu nighaṇḍu ca, ",
  "dn20:10.7": "panādo opamañño ca ",
  "dn20:10.8": "devasūto ca mātali. ",
  "dn20:10.9": "cittaseno ca gandhabbo ",
  "dn20:10.10": "naḷo rājā janesabho ",
  "dn20:10.11": "āguṃ pañcasikho ceva ",
  "dn20:10.12": "timbaru suriyavaccasā ",
  "dn20:10.13": "ete caññe ca rājāno ",
  "dn20:10.14": "gandhabbā saha rājūhi, ",
  "dn20:10.15": "modamānā abhikkāmuṃ ",
  "dn20:10.16": "bhikkhūnaṃ samitiṃ vanaṃ. ",
  "dn20:11.1": "athāguṃ nābhasā nāgā ",
  "dn20:11.2": "vesālā saha tacchakā ",
  "dn20:11.3": "kambalassatarā āguṃ ",
  "dn20:11.4": "pāyāgā saha ñātihi. ",
  "dn20:11.5": "yāmunā dhataraṭṭho ca ",
  "dn20:11.6": "āguṃ nāgā yasassino ",
  "dn20:11.7": "erāvaṇo mahānāgo ",
  "dn20:11.8": "sopāga samitiṃ vanaṃ ",
  "dn20:11.9": "ye nāgarāje sahasā haranti ",
  "dn20:11.10": "dibbā dijā pakkhi visuddhacakkhū, ",
  "dn20:11.11": "vehāsayā te vanamajjhapattā ",
  "dn20:11.12": "citrā supaṇṇā iti tesaṃ nāmāni. ",
  "dn20:11.13": "abhayaṃ tadā nāgarājānamāsi ",
  "dn20:11.14": "supaṇṇato khemamakāsi buddho, ",
  "dn20:11.15": "saṇhāhi vācāhi upavhayantā ",
  "dn20:11.16": "nāgā supaṇṇā saraṇamagaṃsu buddhaṃ. ",
  "dn20:12.1": "jitā vajirahatthena ",
  "dn20:12.2": "samuddaṃ asurā sitā ",
  "dn20:12.3": "bhātaro vāsavassete ",
  "dn20:12.4": "iddhimanto yasassino. ",
  "dn20:12.5": "kālakañchā mahābhismā ",
  "dn20:12.6": "asurā dānaveghasā ",
  "dn20:12.7": "vepacitti sucittī ca ",
  "dn20:12.8": "pahārādo namuci saha. ",
  "dn20:12.9": "satañca baliputtānaṃ ",
  "dn20:12.10": "sabbe verocanāmakā ",
  "dn20:12.11": "sannayhitvā baliṃ senaṃ ",
  "dn20:12.12": "rāhubhaddamupāgamuṃ, ",
  "dn20:12.13": "‘samayo’ dāni bhaddante ",
  "dn20:12.14": "bhikkhūnaṃ samitiṃ vanaṃ’. ",
  "dn20:13.1": "āpo ca devā paṭhavī ca ",
  "dn20:13.2": "tejo vāyo tadāgamuṃ ",
  "dn20:13.3": "varuṇā vāruṇā devā ",
  "dn20:13.4": "somo ca yasasā saha. ",
  "dn20:13.5": "mettākaruṇākāyikā ",
  "dn20:13.6": "āguṃ devā yasassino ",
  "dn20:13.7": "dasete dasadhā kāyā ",
  "dn20:13.8": "sabbe nānattavaṇṇino. ",
  "dn20:13.9": "iddhimanto jutimanto ",
  "dn20:13.10": "vaṇṇavanto yasassino ",
  "dn20:13.11": "modamānā abhikkāmuṃ ",
  "dn20:13.12": "bhikkhūnaṃ samitiṃ vanaṃ. ",
  "dn20:14.1": "veṇhū va devā sahalī ca ",
  "dn20:14.2": "asmā ca duve yamā ",
  "dn20:14.3": "candassūpanisā devā ",
  "dn20:14.4": "candamāguṃ purakkhatvā. ",
  "dn20:14.5": "suriyassūpanisā devā ",
  "dn20:14.6": "suriyamāguṃ purakkhitvā ",
  "dn20:14.7": "nakkhattāni purakkhatvā ",
  "dn20:14.8": "āguṃ mandavalāhakā ",
  "dn20:14.9": "vasūnaṃ vāsavo seṭṭho ",
  "dn20:14.10": "sakkopāga purindado ",
  "dn20:14.11": "dasete dasadhā kāyā ",
  "dn20:14.12": "sabbe nānattavaṇṇino ",
  "dn20:14.13": "iddhimanto jutimanto ",
  "dn20:14.14": "vaṇṇavanto yasassino ",
  "dn20:14.15": "modamānā abhikkāmuṃ ",
  "dn20:14.16": "bhikkhūnaṃ samitiṃ vanaṃ. ",
  "dn20:15.1": "athāguṃ sahabhū devā ",
  "dn20:15.2": "jalamaggi sikhāriva ",
  "dn20:15.3": "ariṭṭhakā ca rojo ca ",
  "dn20:15.4": "ummāpupphanibhāsino. ",
  "dn20:15.5": "varuṇā saha dhammā ca ",
  "dn20:15.6": "accutā ca anejakā ",
  "dn20:15.7": "sūleyya rucirā āguṃ ",
  "dn20:15.8": "āguṃ vāsavanesino, ",
  "dn20:15.9": "dasete dasadhā kāyā ",
  "dn20:15.10": "sabbe nānattavaṇṇino ",
  "dn20:15.11": "iddhimanto jutimanto ",
  "dn20:15.12": "vaṇṇavanto yasassino, ",
  "dn20:15.13": "modamānā abhikkāmuṃ ",
  "dn20:15.14": "bhikkhūnaṃ samitiṃ vanaṃ. ",
  "dn20:16.1": "samānā mahāsamānā ",
  "dn20:16.2": "mānusā mānusuttamā ",
  "dn20:16.3": "khiḍḍāpadūsikā āguṃ ",
  "dn20:16.4": "āguṃ manopadūsikā. ",
  "dn20:16.5": "athāguṃ harayo devā ",
  "dn20:16.6": "ye ca lohitavāsino ",
  "dn20:16.7": "pāragā mahāpāragā ",
  "dn20:16.8": "āguṃ devā yasassino. ",
  "dn20:16.9": "dasete dasadhā kāyā ",
  "dn20:16.10": "sabbe nānattavaṇṇino. ",
  "dn20:16.11": "iddhimanto jutimanto ",
  "dn20:16.12": "vaṇṇavanto yasassino ",
  "dn20:16.13": "modamānā abhikkāmuṃ ",
  "dn20:16.14": "bhikkhūnaṃ samitiṃ vanaṃ. ",
  "dn20:17.1": "sukkā karamhā aruṇā ",
  "dn20:17.2": "āguṃ vekhanasā saha ",
  "dn20:17.3": "odātagayhā pāmokkhā ",
  "dn20:17.4": "āguṃ devā vicakkhaṇā. ",
  "dn20:17.5": "sadāmattā hāragajā ",
  "dn20:17.6": "missakā ca yasassino ",
  "dn20:17.7": "thanayaṃ āga pajjanno ",
  "dn20:17.8": "yo disā abhivassati. ",
  "dn20:17.9": "dasete dasadhā kāyā ",
  "dn20:17.10": "sabbe nānattavaṇṇino ",
  "dn20:17.11": "iddhimanto jutimanto ",
  "dn20:17.12": "vaṇṇavanto yasassino ",
  "dn20:17.13": "modamānā abhikkāmuṃ ",
  "dn20:17.14": "bhikkhūnaṃ samitiṃ vanaṃ. ",
  "dn20:18.1": "khemiyā tusitā yāmā ",
  "dn20:18.2": "kaṭṭhakā ca yasassino ",
  "dn20:18.3": "lambītakā lāmaseṭṭhā ",
  "dn20:18.4": "jotināmā ca āsavā, ",
  "dn20:18.5": "nimmāṇaratino āguṃ ",
  "dn20:18.6": "athāguṃ paranimmitā. ",
  "dn20:18.7": "dasete dasadhā kāyā ",
  "dn20:18.8": "sabbe nānattavaṇṇino ",
  "dn20:18.9": "iddhimanto jutimanto ",
  "dn20:18.10": "vaṇṇavanto yasassino ",
  "dn20:18.11": "modamānā abhikkāmuṃ ",
  "dn20:18.12": "bhikkhūnaṃ samitiṃ vanaṃ. ",
  "dn20:19.1": "saṭṭhete devanikāyā ",
  "dn20:19.2": "sabbe nānattavaṇṇino, ",
  "dn20:19.3": "nāmanvayena āgañchuṃ ",
  "dn20:19.4": "ye caññe sadisā saha. ",
  "dn20:19.5": "pavutthajātimakhilaṃ ",
  "dn20:19.6": "oghatiṇṇamanāsavaṃ, ",
  "dn20:19.7": "dakkhemoghataraṃ nāgaṃ ",
  "dn20:19.8": "candaṃva asitātigaṃ ",
  "dn20:20.1": "subrahmā paramatto ca ",
  "dn20:20.2": "puttā iddhimato saha, ",
  "dn20:20.3": "sanaṅkumāro tisso ca ",
  "dn20:20.4": "sopāga samitiṃ vanaṃ. ",
  "dn20:20.5": "sahassaṃ brahmalokānaṃ ",
  "dn20:20.6": "mahābrahmābhitiṭṭhati, ",
  "dn20:20.7": "upapanno jutimanto ",
  "dn20:20.8": "bhismākāyo yasassi so. ",
  "dn20:20.9": "dasettha issarā āguṃ ",
  "dn20:20.10": "paccekavasavattino, ",
  "dn20:20.11": "tesañca majjhato āga ",
  "dn20:20.12": "hārito parivārito. ",
  "dn20:21.1": "te ca sabbe abhikkante ",
  "dn20:21.2": "sainde deve sabrahmake, ",
  "dn20:21.3": "mārasenā abhikkāmuṃ ",
  "dn20:21.4": "passa kaṇhassa mandiyaṃ ",
  "dn20:21.5": "‘etha gaṇhatha bandhatha ",
  "dn20:21.6": "rāgena bandhamatthu vo, ",
  "dn20:21.7": "samantā parivāretha ",
  "dn20:21.8": "mā vo muñcittha koci naṃ’. ",
  "dn20:21.9": "iti tattha mahāseno ",
  "dn20:21.10": "kaṇhasenaṃ apesayi, ",
  "dn20:21.11": "pāṇinā thalamāhacca ",
  "dn20:21.12": "saraṃ katvāna bheravaṃ. ",
  "dn20:21.13": "yathā pāvussako megho ",
  "dn20:21.14": "thanayanto savijjuko. ",
  "dn20:21.15": "tadā so paccudāvatti ",
  "dn20:21.16": "saṅkuddho asayaṃvasī. ",
  "dn20:22.1": "tañca sabbaṃ abhiññāya ",
  "dn20:22.2": "vavatthitvāna cakkhumā ",
  "dn20:22.3": "tato āmantayī satthā ",
  "dn20:22.4": "sāvake sāsane rate ",
  "dn20:22.5": "mārasenā abhikkantā ",
  "dn20:22.6": "te vijānātha bhikkhavo. ",
  "dn20:22.7": "teca ātappamakaruṃ ",
  "dn20:22.8": "sutvā buddhassa sāsanaṃ ",
  "dn20:22.9": "vītarāgehapakkāmuṃ ",
  "dn20:22.10": "nesaṃ lomampi iñjayuṃ ",
  "dn20:22.11": "sabbe vijitasaṅgāmā ",
  "dn20:22.12": "bhayātītā yasassino ",
  "dn20:22.13": "modanti saha bhūtehi ",
  "dn20:22.14": "sāvakā te janesutā”ti. ",
  "dn20:22.15": "mahāsamayasuttaṃ samattaṃ. "
}
