{
  "sn1.70:0.1": "",
  "sn1.70:0.2": "",
  "sn1.70:0.3": "1. 7. 10. lokasuttaṃ ",
  "sn1.70:1.1": "[devatā:] kismiṃ loko samuppanno ",
  "sn1.70:1.2": "kismiṃ kubbati santhavaṃ, ",
  "sn1.70:1.3": "kissa loko upādāya ",
  "sn1.70:1.4": "kismiṃ loko vihaññatīti. ",
  "sn1.70:2.1": "[bhagavā:] chassu loko samuppanno ",
  "sn1.70:2.2": "chassu kubbati santhavaṃ, ",
  "sn1.70:2.3": "channameva upādāya ",
  "sn1.70:2.4": "chassu loko vihaññatīti. ",
  "sn1.70:2.5": "anvavaggo sattamo. tatruddānaṃ: ",
  "sn1.70:3.0": "",
  "sn1.70:3.1": "nāmaṃ cittañca taṇhā ca ",
  "sn1.70:3.2": "saṃyojanañca bandhanā, ",
  "sn1.70:3.3": "abbhāhatuḍḍito pihito ",
  "sn1.70:3.4": "icchā lokena te dasāti. "
}
