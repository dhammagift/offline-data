{
  "sn1.41:0.1": "",
  "sn1.41:0.2": "5. ādittavaggo ",
  "sn1.41:0.3": "1. 5. 1. ādittasuttaṃ. ",
  "sn1.41:1.1": "evaṃ me sutaṃ: ",
  "sn1.41:1.2": "ekaṃ samayaṃ bhagavā sāvatthiyaṃ viharati jetavane anāthapiṇḍikassa ārāme. ",
  "sn1.41:1.3": "atha kho aññatarā devatā abhikkantāya rattiyā abhikkantavaṇṇā kevalakappaṃ jetavanaṃ obhāsetvā yena bhagavā tenupasaṅkami. upasaṅkamitvā bhagavantaṃ abhivādetvā ekamantaṃ aṭṭhāsi. ",
  "sn1.41:1.4": "ekamantaṃ ṭhitā kho sā devatā bhagavato santike imā gāthāyo abhāsi: ",
  "sn1.41:2.1": "ādittasmiṃ agārasmiṃ ",
  "sn1.41:2.2": "yaṃ nīharati bhājanaṃ, ",
  "sn1.41:2.3": "taṃ tassa hoti atthāya ",
  "sn1.41:2.4": "no ca yaṃ tattha ḍayhati. ",
  "sn1.41:3.1": "evamādipito loko ",
  "sn1.41:3.2": "jarāya maraṇena ca, ",
  "sn1.41:3.3": "nīharetheva dānena ",
  "sn1.41:3.4": "dinnaṃ hoti sunīhataṃ. ",
  "sn1.41:4.1": "dinnaṃ sukhaphalaṃ hoti ",
  "sn1.41:4.2": "nādinnaṃ hoti taṃ tathā, ",
  "sn1.41:4.3": "corā haranti rājāno ",
  "sn1.41:4.4": "aggi ḍahati nassati. ",
  "sn1.41:5.1": "atha antena jahati ",
  "sn1.41:5.2": "sarīraṃ sapariggahaṃ, ",
  "sn1.41:5.3": "etadaññāya medhāvī ",
  "sn1.41:5.4": "bhuñjetha ca dadetha ca. ",
  "sn1.41:5.5": "datvā ca bhutvā ca yathānubhāvaṃ ",
  "sn1.41:5.6": "anindito saggamupeti ṭhānanti. "
}
