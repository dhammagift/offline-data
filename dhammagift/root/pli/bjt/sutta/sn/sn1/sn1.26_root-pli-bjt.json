  "sn1.26:0.1": "",
  "sn1.26:0.2": "",
  "sn1.26:0.3": "1. 3. 6. pajjotasuttaṃ ",
  "sn1.26:1.1": "sāvatthiyaṃ– ekamantaṃ ṭhitā kho sā devatā bhagavato santike imaṃ gāthaṃ abhāsi: kati lokasmiṃ pajjotā ",
  "sn1.26:1.2": "yehi loko pakāsati, ",
  "sn1.26:1.3": "bhagavantaṃ puṭṭhumāgamma ",
  "sn1.26:1.4": "kathaṃ jānemu taṃ mayaṃ. [bhagavā:] ",
  "sn1.26:2.1": "cattāro loke pajjotā ",
  "sn1.26:2.2": "pañcamettha na vijjati, ",
  "sn1.26:2.3": "divā tapati ādicco ",
  "sn1.26:2.4": "rattiṃ ābhāti candimā, ",
  "sn1.26:3.1": "atha aggi divārattiṃ ",
  "sn1.26:3.2": "tattha tattha pakāsati, ",
  "sn1.26:3.3": "sambuddho tapataṃ seṭṭho ",
  "sn1.26:3.4": "esā ābhā anuttarā’ti. "
}
