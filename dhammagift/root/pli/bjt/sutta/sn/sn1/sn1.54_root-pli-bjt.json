{
  "sn1.54:0.1": "",
  "sn1.54:0.2": "",
  "sn1.54:0.3": "1. 6. 4. vatthusuttaṃ. ",
  "sn1.54:1.1": "[devatā:] kiṃsu vatthu manussānaṃ ",
  "sn1.54:1.2": "kiṃ sūdha paramo sakhā, ",
  "sn1.54:1.3": "kiṃsu bhūtūpajīvanti ",
  "sn1.54:1.4": "ye pāṇā paṭhaviṃsitāti. [bhagavā:] ",
  "sn1.54:2.1": "puttā vatthu manussānaṃ ",
  "sn1.54:2.2": "bhariyāva paramo sakhā, ",
  "sn1.54:2.3": "vuṭṭhiṃ bhūtūpajīvanti ",
  "sn1.54:2.4": "ye pāṇā paṭhaviṃsitāti. "
}
