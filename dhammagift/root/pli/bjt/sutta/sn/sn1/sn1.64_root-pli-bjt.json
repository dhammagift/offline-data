{
  "sn1.64:0.1": "",
  "sn1.64:0.2": "",
  "sn1.64:0.3": "1. 7. 4. saṃyojanasuttaṃ ",
  "sn1.64:1.1": "[devatā:] kiṃsu saṃyojano loko ",
  "sn1.64:1.2": "kiṃsu tassa vicāraṇaṃ, ",
  "sn1.64:1.3": "kissassa vippahāṇena ",
  "sn1.64:1.4": "nibbaṇemiti vuccatīti. ",
  "sn1.64:2.1": "[bhagavā:] nandi saṃyojano loko ",
  "sn1.64:2.2": "vitakkassa vicāraṇaṃ, ",
  "sn1.64:2.3": "taṇhāya vippahāṇena ",
  "sn1.64:2.4": "nibbāṇamiti vuccatīti. "
}
