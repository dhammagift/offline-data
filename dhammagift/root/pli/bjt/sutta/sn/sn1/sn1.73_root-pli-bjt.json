{
  "sn1.73:0.1": "",
  "sn1.73:0.2": "",
  "sn1.73:0.3": "1. 8. 3. vittasuttaṃ. ",
  "sn1.73:1.1": "[devatā:] kiṃ sūdha vittaṃ purisassa seṭṭhaṃ ",
  "sn1.73:1.2": "kiṃ su suciṇṇo sukhamāvahāti, ",
  "sn1.73:1.3": "kiṃ su have sādutaraṃ rasānaṃ ",
  "sn1.73:1.4": "kathaṃjīviṃ jīvitamāhu seṭṭhanti. ",
  "sn1.73:2.1": "[bhagavā:] saddhīdha vittaṃ purisassa seṭṭhaṃ ",
  "sn1.73:2.2": "dhammo suciṇṇo sukhamāvahāti, ",
  "sn1.73:2.3": "saccaṃ have sādutaraṃ rasānaṃ ",
  "sn1.73:2.4": "paññājīviṃ jīvitamāhu seṭṭhanti. "
}
