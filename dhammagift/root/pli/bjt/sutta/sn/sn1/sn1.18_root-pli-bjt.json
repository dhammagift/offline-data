  "sn1.18:0.1": "",
  "sn1.18:0.2": "",
  "sn1.18:0.3": "1. 2. 8. hirisuttaṃ ",
  "sn1.18:1.1": "sāvatthiyaṃ– [devatā:] hirīnisedho puriso ",
  "sn1.18:1.2": "ko ci lokasmiṃ vijjati, ",
  "sn1.18:1.3": "yo nindaṃ appabodhati ",
  "sn1.18:1.4": "asso bhadro kasāmivāti. ",
  "sn1.18:2.1": "[bhagavā:] hirīnisedhā tanuyā ",
  "sn1.18:2.2": "ye caranti sadā satā, ",
  "sn1.18:2.3": "antaṃ dukkhassa pappuyya ",
  "sn1.18:2.4": "caranti visame samanti. "
}
