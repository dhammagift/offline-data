{
  "sn1.71:0.1": "",
  "sn1.71:0.2": "8. jhatvāvaggo ",
  "sn1.71:0.3": "1. 8. 1. jhatvāsuttaṃ ",
  "sn1.71:1.1": "sāvatthiyaṃ– ",
  "sn1.71:1.2": "ekamantaṃ ṭhitā kho sā devatā bhagavantaṃ gāthāya ajjhabhāsi. ",
  "sn1.71:2.1": "kiṃ su jhatvā sukhaṃ seti ",
  "sn1.71:2.2": "kiṃsu jhatvā na socati, ",
  "sn1.71:2.3": "kissassa ekadhammassa ",
  "sn1.71:2.4": "vadhaṃ rocesi gotamāti. ",
  "sn1.71:3.1": "[bhagavā:] kodhaṃ jhatvā sukhaṃ seti ",
  "sn1.71:3.2": "kodhaṃ jhatvā na socati, ",
  "sn1.71:3.3": "kodhassa visamūlassa ",
  "sn1.71:3.4": "madhuraggassa devate, ",
  "sn1.71:3.5": "vadhaṃ ariyā pasaṃsanti ",
  "sn1.71:3.6": "taṃ hi jhatvā na socatīti. "
}
