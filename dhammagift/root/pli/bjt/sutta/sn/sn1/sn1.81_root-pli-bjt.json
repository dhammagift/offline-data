{
  "sn1.81:0.1": "",
  "sn1.81:0.2": "",
  "sn1.81:0.3": "1. 8. 11. araṇasuttaṃ ",
  "sn1.81:1.1": "[devatā:] ke sūdha araṇā loke ",
  "sn1.81:1.2": "kesaṃ vusitaṃ na nassati, ",
  "sn1.81:1.3": "kedha icchaṃ parijānanti ",
  "sn1.81:1.4": "kesaṃ bhojissiyaṃ sadā. ",
  "sn1.81:2.1": "kiṃ su mātā pitā bhātā ",
  "sn1.81:2.2": "vandantī naṃ patiṭṭhitaṃ, ",
  "sn1.81:2.3": "kiṃ su idha jātihīnaṃ ",
  "sn1.81:2.4": "abhivādenti khattiyāti. ",
  "sn1.81:3.1": "[bhagavā:] samaṇīdha araṇā loke ",
  "sn1.81:3.2": "samaṇānaṃ vusitaṃ na nassati, ",
  "sn1.81:3.3": "samaṇā icchaṃ parijānanti ",
  "sn1.81:3.4": "samaṇānaṃ bhojissiyaṃ sadā. ",
  "sn1.81:4.1": "samaṇaṃ mātā pitā bhātā ",
  "sn1.81:4.2": "vandanti naṃ patiṭṭhitaṃ, ",
  "sn1.81:4.3": "samaṇīdha jātihīnaṃ ",
  "sn1.81:4.4": "abhivādenti khattiyāti. ",
  "sn1.81:4.5": "jhatvāvaggo aṭṭhamo. ",
  "sn1.81:5.0": "tatruddānaṃ: ",
  "sn1.81:5.1": "jhatvā rathañca cittañca ",
  "sn1.81:5.2": "vuṭṭhi bhītā na jīrati, ",
  "sn1.81:5.3": "issaraṃ kāmaṃ pātheyyaṃ ",
  "sn1.81:5.4": "pajjoto araṇenacāti. ",
  "sn1.81:5.5": ""
}
