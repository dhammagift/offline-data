  "sn1.62:0.3": "1. 7. 2. cittasuttaṃ ",
  "sn1.62:1.1": "[devatā:] kenassu nīyati loko ",
  "sn1.62:1.2": "kenassu parikassati, ",
  "sn1.62:1.3": "kissassa ekadhammassa ",
  "sn1.62:1.4": "sabbeva vasamanvagūti. ",
  "sn1.62:2.1": "[bhagavā:] cittena nīyati loko ",
  "sn1.62:2.2": "cittena parikassati, ",
  "sn1.62:2.3": "cittassa ekadhammassa ",
  "sn1.62:2.4": "sabbeva vasamanvagūti. "
