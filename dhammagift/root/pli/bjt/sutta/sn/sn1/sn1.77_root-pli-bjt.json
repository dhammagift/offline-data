  "sn1.77:0.1": "",
  "sn1.77:0.2": "",
  "sn1.77:0.3": "1. 8. 7. issarasuttaṃ. ",
  "sn1.77:1.1": "[devatā:] kiṃ su issariyaṃ loke ",
  "sn1.77:1.2": "kiṃ su bhaṇḍānamuttamaṃ, ",
  "sn1.77:1.3": "kiṃ su satthamalaṃ loke ",
  "sn1.77:1.4": "kiṃ su lokasmiṃ abbudaṃ. ",
  "sn1.77:2.1": "kiṃ su harantaṃ vārenti ",
  "sn1.77:2.2": "haranto pana ko piyo, ",
  "sn1.77:2.3": "kiṃ su punappunāyantaṃ ",
  "sn1.77:2.4": "abhinandanti paṇḍitāti. ",
  "sn1.77:3.1": "[bhagavā:] vaso issariyaṃ loke ",
  "sn1.77:3.2": "itthi bhaṇḍānamuttamaṃ, ",
  "sn1.77:3.3": "kodho satthamalaṃ loke ",
  "sn1.77:3.4": "corā lokasmiṃ abbudaṃ ",
  "sn1.77:4.1": "coraṃ harantaṃ vārenti ",
  "sn1.77:4.2": "haranto samaṇo piyo, ",
  "sn1.77:4.3": "samaṇaṃ punappunāyantaṃ ",
  "sn1.77:4.4": "abhinandanti paṇḍitāti. "
}
