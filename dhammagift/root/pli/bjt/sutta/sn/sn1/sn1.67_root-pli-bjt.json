{
  "sn1.67:0.1": "",
  "sn1.67:0.2": "",
  "sn1.67:0.3": "1. 7. 7. uḍḍitasuttaṃ ",
  "sn1.67:1.1": "[devatā:] kenassu uḍḍito loko ",
  "sn1.67:1.2": "kenassu parivārito, ",
  "sn1.67:1.3": "kenassu pihito loko ",
  "sn1.67:1.4": "kismiṃ loko patiṭṭhitoti. ",
  "sn1.67:2.1": "[bhagavā:] taṇhāya uḍḍito loko ",
  "sn1.67:2.2": "jarāya parivārito, ",
  "sn1.67:2.3": "maccunā pihito loko ",
  "sn1.67:2.4": "dukkhe loko patiṭṭhitoti. "
}
