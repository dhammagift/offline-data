{
  "sn1.55:0.1": "",
  "sn1.55:0.2": "",
  "sn1.55:0.3": "1. 6. 5. paṭhamajanetisuttaṃ ",
  "sn1.55:1.1": "[devatā:] kiṃsu janeti purisaṃ ",
  "sn1.55:1.2": "kiṃsu tassa vidhāvati, ",
  "sn1.55:1.3": "kiṃsu saṃsāramāpādi ",
  "sn1.55:1.4": "kiṃsu tassa mahabbhayanti. ",
  "sn1.55:2.1": "[bhagavā:] taṇhā janeti purisaṃ ",
  "sn1.55:2.2": "cittamassa vidhāvati, ",
  "sn1.55:2.3": "satto saṃsāramāpādi ",
  "sn1.55:2.4": "dukkhamassa mahabbhayanti. "
}
