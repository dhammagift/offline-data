{
  "sn1.74:0.1": "",
  "sn1.74:0.2": "",
  "sn1.74:0.3": "1. 8. 4. vuṭṭhisuttaṃ. ",
  "sn1.74:1.1": "[devatā:] kiṃ su uppatataṃ seṭṭhaṃ ",
  "sn1.74:1.2": "kiṃ su nipatataṃ varaṃ, ",
  "sn1.74:1.3": "kiṃ su pavajamānānaṃ ",
  "sn1.74:1.4": "kiṃ su pavadataṃ varanti. ",
  "sn1.74:2.1": "[aparā devatā:] bījaṃ uppatataṃ seṭṭhaṃ ",
  "sn1.74:2.2": "vuṭṭhi nipatataṃ varā, ",
  "sn1.74:2.3": "gāvo pavajamānānaṃ ",
  "sn1.74:2.4": "putto pavadataṃ varoti. ",
  "sn1.74:3.1": "[bhagavā:] vijjā uppatataṃ seṭṭhā ",
  "sn1.74:3.2": "avijjā nipatataṃ varā, ",
  "sn1.74:3.3": "saṅgho pavajamānānaṃ ",
  "sn1.74:3.4": "buddho pavadataṃ varoti. "
}
