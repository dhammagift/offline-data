  "sn1.40:0.1": "",
  "sn1.40:0.2": "",
  "sn1.40:0.3": "1. 4. 10. cullapajjunnadhītusuttaṃ ",
  "sn1.40:1.1": "evaṃ me sutaṃ: ",
  "sn1.40:1.2": "ekaṃ samayaṃ bhagavā vesāliyaṃ viharati mahāvane kūṭāgārasālāyaṃ. ",
  "sn1.40:1.3": "atha kho cullakokanadā pajjunnassa dhītā abhikkantāya rattiyā abhikkantavaṇṇā kevalakappaṃ mahāvanaṃ obhāsetvā yena bhagavā tenupasaṅkami. upasaṅkamitvā bhagavantaṃ abhivādetvā ekamantaṃ aṭṭhāsi. ",
  "sn1.40:1.4": "ekamantaṃ ṭhitā kho cullakokanadā pajjunnassa dhītā bhagavato santike imā gāthāyo abhāsi: ",
  "sn1.40:2.1": "idhāgamā vijjupabhāsavaṇṇā ",
  "sn1.40:2.2": "kokanadā pajjunnassa dhītā, ",
  "sn1.40:2.3": "buddhañca dhammañca namassamānā ",
  "sn1.40:2.4": "gāthā cimā atthavatī abhāsi. ",
  "sn1.40:3.1": "bahunāpi kho taṃ vibhajeyyaṃ ",
  "sn1.40:3.2": "pariyāyena tādiso dhammo, ",
  "sn1.40:3.3": "saṃkhittamattaṃ lapayissāmi ",
  "sn1.40:3.4": "yāvatā me manasā pariyattaṃ. ",
  "sn1.40:4.1": "pāpaṃ na kayirā vacasā manasā ",
  "sn1.40:4.2": "kāyena vā kiñcana sabbaloke, ",
  "sn1.40:4.3": "kāme pahāya satimā sampajāno ",
  "sn1.40:4.4": "dukkhaṃ na sevetha anatthasaṃhitanti. ",
  "sn1.40:4.5": "satullapakāyikavaggo catuttho. tatruddānaṃ: sabbhi ",
  "sn1.40:5.0": "",
  "sn1.40:5.1": "maccharinā sādhu ",
  "sn1.40:5.2": "nasantujjhānasaññino, ",
  "sn1.40:5.3": "saddhā samayo sakalikaṃ ",
  "sn1.40:5.4": "ubho pajjunnadhītaro’ti. "
}
