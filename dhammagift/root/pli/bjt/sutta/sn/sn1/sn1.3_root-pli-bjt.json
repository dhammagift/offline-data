  "sn1.3:0.1": "",
  "sn1.3:0.2": "",
  "sn1.3:0.3": "1. 1. 3. upanīyatisuttaṃ. ",
  "sn1.3:1.1": "sāvatthiyaṃ– ",
  "sn1.3:1.2": "atha kho sā devatā bhagavato santike imaṃ gāthaṃ abhāsi: ",
  "sn1.3:2.1": "upanīyati jīvitamappamāyu ",
  "sn1.3:2.2": "jarūpanītassa na santi tāṇā ",
  "sn1.3:2.3": "etaṃ bhayaṃ maraṇe pekkhamāno ",
  "sn1.3:2.4": "puññāni kayirātha sukhāvahānīti. ",
  "sn1.3:3.1": "[bhagavā:] upanīyati jīvitamappamāyu ",
  "sn1.3:3.2": "jarūpanītassa na santi tāṇā ",
  "sn1.3:3.3": "etaṃ bhayaṃ maraṇe pekkhamāno ",
  "sn1.3:3.4": "lokāmisaṃ pajahe santipekkhoti. "
}
