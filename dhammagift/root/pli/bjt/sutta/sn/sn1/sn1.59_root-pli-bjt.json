{
  "sn1.59:0.1": "",
  "sn1.59:0.2": "",
  "sn1.59:0.3": "1. 6. 9. dutiyāsuttaṃ ",
  "sn1.59:1.1": "[devatā:] kiṃsu dutiyā purisassa hoti ",
  "sn1.59:1.2": "kiṃsu cenaṃ pasaṃsati, ",
  "sn1.59:1.3": "kissa cābhirato macco ",
  "sn1.59:1.4": "sabbadukkhā pamuccatīti. ",
  "sn1.59:2.1": "[bhagavā:] saddhā dutiyā purisassa hoti ",
  "sn1.59:2.2": "paññā cenaṃ pasaṃsati, ",
  "sn1.59:2.3": "nibbāṇābhirato macco ",
  "sn1.59:2.4": "sabbadukkhā pamuccatīti. "
}
