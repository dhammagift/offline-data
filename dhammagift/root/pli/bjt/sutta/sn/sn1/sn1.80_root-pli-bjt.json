{
  "sn1.80:0.1": "",
  "sn1.80:0.2": "",
  "sn1.80:0.3": "1. 8. 10. pajjotasuttaṃ ",
  "sn1.80:1.1": "[devatā:] kiṃ su lokasmiṃ pajjoto ",
  "sn1.80:1.2": "kiṃ su lokasmiṃ jāgaro, ",
  "sn1.80:1.3": "kiṃ su kamme sajīvānaṃ ",
  "sn1.80:1.4": "kimassa iriyāpatho. ",
  "sn1.80:2.1": "kiṃ su alasaṃ analasañca ",
  "sn1.80:2.2": "mātā puttaṃva posati, ",
  "sn1.80:2.3": "kiṃ su bhūtūpajīvanti ",
  "sn1.80:2.4": "ye pāṇā paṭhaviṃsitāti. [bhagavā:] ",
  "sn1.80:3.1": "paññā lokasmiṃ pajjoto ",
  "sn1.80:3.2": "sati lokasmiṃ jāgaro, ",
  "sn1.80:3.3": "gāvo kamme sajīvānaṃ ",
  "sn1.80:3.4": "sītassa iriyāpatho. ",
  "sn1.80:4.1": "vuṭṭhi alasaṃ analasañca ",
  "sn1.80:4.2": "mātā puttaṃva posati, ",
  "sn1.80:4.3": "vuṭṭhiṃ bhūtūpajīvanti ",
  "sn1.80:4.4": "ye pāṇā paṭhaviṃsitāti. "
}
