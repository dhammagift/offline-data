{
  "sn1.29:0.1": "",
  "sn1.29:0.2": "",
  "sn1.29:0.3": "1. 3. 9. catucakkasuttaṃ ",
  "sn1.29:1.1": "sāvatthiyaṃ– [devatā:] catucakkaṃ navadvāraṃ ",
  "sn1.29:1.2": "puṇṇaṃ lobhena saṃyutaṃ, ",
  "sn1.29:1.3": "paṅkajātaṃ mahāvīra ",
  "sn1.29:1.4": "kathaṃ yātrā bhavissati. [bhagavā:] ",
  "sn1.29:2.1": "chetvā naddhiṃ varattañca ",
  "sn1.29:2.2": "icchālobhañca pāpakaṃ, ",
  "sn1.29:2.3": "samūlaṃ taṇhaṃ abbuyha ",
  "sn1.29:2.4": "evaṃ yātrā bhavissatī’ti. "
}
