{
  "sn1.12:0.1": "",
  "sn1.12:0.2": "",
  "sn1.12:0.3": "1. 2. 2. nandatisuttaṃ ",
  "sn1.12:1.1": "sāvatthiyaṃ– ",
  "sn1.12:1.2": "ekamantaṃ ṭhitā kho sā devatā bhagavato santike imaṃ gāthaṃ abhāsi: ",
  "sn1.12:2.1": "nandati puttehi puttimā ",
  "sn1.12:2.2": "gomiko gohi tatheva nandati, ",
  "sn1.12:2.3": "upadhī hi narassa nandanā ",
  "sn1.12:2.4": "na hi so nandati yo nirūpadhīti ",
  "sn1.12:3.1": "[bhagavā:] socati puttehi puttimā ",
  "sn1.12:3.2": "gomiko gohi tatheva socati, ",
  "sn1.12:3.3": "upadhī hi narassa socanā ",
  "sn1.12:3.4": "na hi so socati yo nirūpadhīti. "
}
