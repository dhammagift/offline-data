{
  "sn1.7:0.1": "",
  "sn1.7:0.2": "",
  "sn1.7:0.3": "1. 1. 7. appaṭividitasuttaṃ ",
  "sn1.7:1.1": "sāvatthiyaṃ– ",
  "sn1.7:1.2": "ekamantaṃ ṭhitā kho sā devatā bhagavato santike imaṃ gāthaṃ abhāsi: ",
  "sn1.7:2.1": "yesaṃ dhammā appaṭividitā ",
  "sn1.7:2.2": "paravādesu nīyare, ",
  "sn1.7:2.3": "suttā te nappabujjhanti ",
  "sn1.7:2.4": "kālo tesaṃ pabujjhitunti. ",
  "sn1.7:3.1": "[bhagavā:] yesaṃ dhammā suppaṭividitā ",
  "sn1.7:3.2": "paravādesu na nīyare, ",
  "sn1.7:3.3": "sambuddhā sammadaññāya ",
  "sn1.7:3.4": "caranti visame samanti. "
}
