{
  "sn1.8:0.1": "",
  "sn1.8:0.2": "",
  "sn1.8:0.3": "1. 1. 8. susammuṭṭhasuttaṃ ",
  "sn1.8:1.1": "sāvatthiyaṃ– ",
  "sn1.8:1.2": "ekamantaṃ ṭhitā kho sā devatā bhagavato santike imaṃ gāthaṃ abhāsi: ",
  "sn1.8:2.1": "yesaṃ dhammā susammuṭṭhā ",
  "sn1.8:2.2": "paravādesu nīyare, ",
  "sn1.8:2.3": "suttā te nappabujjhanti ",
  "sn1.8:2.4": "kālo tesaṃ pabujjhitunti. ",
  "sn1.8:3.1": "[bhagavā:] yesaṃ dhammā asammuṭṭhā ",
  "sn1.8:3.2": "paravādesu na nīyare, ",
  "sn1.8:3.3": "sambuddhā sammadaññāya ",
  "sn1.8:3.4": "caranti visame samaṃ. "
}
