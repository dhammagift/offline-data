  "sn1.79:0.1": "",
  "sn1.79:0.2": "",
  "sn1.79:0.3": "1. 8. 9. pātheyyasuttaṃ ",
  "sn1.79:1.1": "[devatā:] kiṃ su bandhati pātheyyaṃ ",
  "sn1.79:1.2": "kiṃ su bhogānamāsayo, ",
  "sn1.79:1.3": "kiṃ su naraṃ parikassati ",
  "sn1.79:1.4": "kiṃ su lokasmiṃ dujjahaṃ, ",
  "sn1.79:1.5": "kismiṃ baddhā puthu sattā ",
  "sn1.79:1.6": "pāsena sakuṇī yathāti. ",
  "sn1.79:2.1": "[bhagavā:] saddhā bandhati pātheyyaṃ ",
  "sn1.79:2.2": "sirī bhogānamāsayo, ",
  "sn1.79:2.3": "icchā naraṃ parikassati ",
  "sn1.79:2.4": "icchā lokasmiṃ dujjahā, ",
  "sn1.79:2.5": "icchābaddhā puthusattā ",
  "sn1.79:2.6": "pāsena sakuṇī yathāti. "
}
