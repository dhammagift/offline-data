{
  "sn1.6:0.1": "",
  "sn1.6:0.2": "",
  "sn1.6:0.3": "1. 1. 6. jāgarasuttaṃ ",
  "sn1.6:1.1": "sāvatthiyaṃ– ",
  "sn1.6:1.2": "ekamantaṃ ṭhitā kho sā devatā bhagavato santike imaṃ gāthaṃ abhāsi: ",
  "sn1.6:2.1": "kati jāgarataṃ suttā ",
  "sn1.6:2.2": "kati suttesu jāgarā, ",
  "sn1.6:2.3": "katīhi rajamādeti ",
  "sn1.6:2.4": "katīhi parisujjhatīti. ",
  "sn1.6:3.1": "[bhagavā:] pañca jāgarataṃ suttā ",
  "sn1.6:3.2": "pañca suttesu jāgarā, ",
  "sn1.6:3.3": "pañcahi rajamādeti ",
  "sn1.6:3.4": "pañcahi parisujjhatīti. "
}
