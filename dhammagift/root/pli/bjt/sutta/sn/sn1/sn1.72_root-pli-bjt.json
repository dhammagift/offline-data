{
  "sn1.72:0.1": "",
  "sn1.72:0.2": "",
  "sn1.72:0.3": "1. 8. 2. rathasuttaṃ ",
  "sn1.72:1.1": "[devatā:] kiṃ su rathassa paññāṇaṃ ",
  "sn1.72:1.2": "kiṃ su paññāṇamaggino, ",
  "sn1.72:1.3": "kiṃ su raṭṭhassa paññāṇaṃ ",
  "sn1.72:1.4": "kiṃ su paññāṇamitthiyāti. ",
  "sn1.72:2.1": "[bhagavā:] dhajo rathassa paññāṇaṃ ",
  "sn1.72:2.2": "dhūmo paññāṇamaggino, ",
  "sn1.72:2.3": "rājā raṭṭhassa paññāṇaṃ ",
  "sn1.72:2.4": "bhattā paññāṇamitthiyāti. "
}
