{
  "sn1.17:0.1": "",
  "sn1.17:0.2": "",
  "sn1.17:0.3": "1. 2. 7. dukkarasuttaṃ ",
  "sn1.17:1.1": "sāvatthiyaṃ– [devatā:] dukkaraṃ duttitikkhañca ",
  "sn1.17:1.2": "abyattena hi sāmaññaṃ, ",
  "sn1.17:1.3": "bahū hi tattha sambādhā ",
  "sn1.17:1.4": "yattha bālo visīdatīti. ",
  "sn1.17:2.1": "[bhagavā:] katihaṃ careyya sāmaññaṃ ",
  "sn1.17:2.2": "cittaṃ ce na nivāraye, ",
  "sn1.17:2.3": "pade pade visīdeyya ",
  "sn1.17:2.4": "saṅkappānaṃ vasānugo. ",
  "sn1.17:3.1": "kummova aṅgāni sake kapāle ",
  "sn1.17:3.2": "samodahaṃ bhikkhu manovitakke, ",
  "sn1.17:3.3": "anissito aññamaheṭhayāno ",
  "sn1.17:3.4": "parinibbuto na upavadeyya kañcīti. "
}
