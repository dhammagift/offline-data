{
  "sn1.78:0.1": "",
  "sn1.78:0.2": "",
  "sn1.78:0.3": "1. 8. 8. kāmasuttaṃ ",
  "sn1.78:1.1": "[devatā] kimatthakāmo na dade ",
  "sn1.78:1.2": "kiṃ macco na pariccaje, ",
  "sn1.78:1.3": "kiṃ su muñceyya kalyāṇaṃ ",
  "sn1.78:1.4": "pāpikañca na mocayeti. ",
  "sn1.78:2.1": "[bhagavā:] attānaṃ na dade poso ",
  "sn1.78:2.2": "attānaṃ na pariccaje, ",
  "sn1.78:2.3": "vācaṃ muñceyya kalyāṇaṃ ",
  "sn1.78:2.4": "pāpikañca na mocayeti. "
}
