{
  "sn1.58:0.1": "",
  "sn1.58:0.2": "",
  "sn1.58:0.3": "1. 6. 8. uppathasuttaṃ ",
  "sn1.58:1.1": "[devatā:] kiṃsu uppatho akkhāto ",
  "sn1.58:1.2": "kiṃsu rattindivakkhayo, ",
  "sn1.58:1.3": "kiṃ malaṃ brahmacariyassa ",
  "sn1.58:1.4": "kiṃ sinānamanodakanti. ",
  "sn1.58:2.1": "[bhagavā:] rāgo uppatho akkhāto ",
  "sn1.58:2.2": "vayo rattindivakkhayo, ",
  "sn1.58:2.3": "itthi malaṃ brahmacariyassa ",
  "sn1.58:2.4": "etthāyaṃ sajjate pajā, ",
  "sn1.58:2.5": "tapo ca brahmacariyañca ",
  "sn1.58:2.6": "taṃ sinānamanodakanti. "
}
