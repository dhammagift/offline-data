{
  "sn1.51:0.1": "",
  "sn1.51:0.2": "6. jarāvaggo ",
  "sn1.51:0.3": "1. 6. 1. jarāsuttaṃ. ",
  "sn1.51:1.1": "sāvatthiyaṃ– [devatā:] kiṃsu yāva jarā sādhu ",
  "sn1.51:1.2": "kiṃsu sādhu patiṭṭhitaṃ, ",
  "sn1.51:1.3": "kiṃsu narānaṃ ratanaṃ ",
  "sn1.51:1.4": "kiṃsu corehi dūharanti. ",
  "sn1.51:2.1": "[bhagavā:] sīlaṃ yāva jarā sādhu ",
  "sn1.51:2.2": "saddhā sādhu patiṭṭhitā, ",
  "sn1.51:2.3": "paññā narānaṃ ratanaṃ ",
  "sn1.51:2.4": "puññaṃ corehi dūharanti. "
}
