  "sn1.15:0.3": "1. 2. 5. sanamānasuttaṃ ",
  "sn1.15:1.1": "sāvatthiyaṃ– [devatā:] ṭhite majjhantike kāle ",
  "sn1.15:1.2": "sannisīvesu pakkhisu, ",
  "sn1.15:1.3": "sanateva brahāraññaṃ ",
  "sn1.15:1.4": "taṃ bhayaṃ paṭibhāti manti. ",
  "sn1.15:2.1": "[bhagavā:] ṭhite majjhantike kāle ",
  "sn1.15:2.2": "sannisīvesu pakkhisu, ",
  "sn1.15:2.3": "sanateva brahāraññaṃ ",
  "sn1.15:2.4": "sā ratī paṭibhāti manti. "
}
