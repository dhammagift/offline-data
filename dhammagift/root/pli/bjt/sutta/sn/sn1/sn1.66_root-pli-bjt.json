{
  "sn1.66:0.1": "",
  "sn1.66:0.2": "",
  "sn1.66:0.3": "1. 7. 6. abbhāhatasuttaṃ ",
  "sn1.66:1.1": "[devatā:] kenassubbhāhato loko ",
  "sn1.66:1.2": "kenassu parivārito, ",
  "sn1.66:1.3": "kena sallena otiṇṇo ",
  "sn1.66:1.4": "kissa dhūmāyito sadāti. ",
  "sn1.66:2.1": "[bhagavā:] maccunā’bbhāhato loko ",
  "sn1.66:2.2": "jarāya parivārito, ",
  "sn1.66:2.3": "taṇhāsallena otiṇṇo ",
  "sn1.66:2.4": "icchādhūmāyito sadāti. "
}
