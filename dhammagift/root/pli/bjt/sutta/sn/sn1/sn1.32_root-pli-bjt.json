{
  "sn1.32:0.1": "",
  "sn1.32:0.2": "",
  "sn1.32:0.3": "1. 4. 2. maccharisuttaṃ ",
  "sn1.32:1.1": "ekaṃ samayaṃ bhagavā sāvatthiyaṃ viharati jetavane anāthapiṇḍikassa ārāme. ",
  "sn1.32:1.2": "atha kho sambahulā satullapakāyikā devatāyo abhikkantāya rattiyā abhikkantavaṇṇā kevalakappaṃ jetavanaṃ obhāsetvā yena bhagavā tenupasaṅkamiṃsu. upasaṅkamitvā bhagavantaṃ abhivādetvā ekamantaṃ aṭṭhaṃsu. ",
  "sn1.32:1.3": "ekamantaṃ ṭhitā kho ekā devatā bhagavato santike imaṃ gāthaṃ abhāsi: ",
  "sn1.32:2.1": "maccherā ca pamādā ca ",
  "sn1.32:2.2": "evaṃ dānaṃ na dīyati, ",
  "sn1.32:2.3": "puññamākaṅkhamānena ",
  "sn1.32:2.4": "deyyaṃ hoti vijānatāti. ",
  "sn1.32:3.1": "atha kho aparā devatā bhagavato santike imā gāthāyo abhāsi: ",
  "sn1.32:4.1": "yasseva bhīto na dadāti maccharī ",
  "sn1.32:4.2": "tadevādadato bhayaṃ, ",
  "sn1.32:4.3": "jighacchā ca pipāsā ca ",
  "sn1.32:4.4": "yassa bhāyati maccharī, ",
  "sn1.32:4.5": "tameva bālaṃ phusati ",
  "sn1.32:4.6": "asmiṃ loke paramhi ca. ",
  "sn1.32:5.1": "tasmā vineyya maccheraṃ ",
  "sn1.32:5.2": "dajjā dānaṃ malābhibhū, ",
  "sn1.32:5.3": "puññāni paralokasmiṃ ",
  "sn1.32:5.4": "patiṭṭhā honti pāṇinanti. ",
  "sn1.32:6.1": "atha kho aparā devatā bhagavato santike imā gāthāyo abhāsi: ",
  "sn1.32:7.1": "te matesu na mīyanti ",
  "sn1.32:7.2": "addhānaṃ va sahabbajaṃ, ",
  "sn1.32:7.3": "appasmiṃ ye pavecchanti ",
  "sn1.32:7.4": "esa dhammo sanantano. ",
  "sn1.32:8.1": "appasmeke pavecchanti ",
  "sn1.32:8.2": "bahuneke nadicchare, ",
  "sn1.32:8.3": "appasmā dakkhiṇā dinnā ",
  "sn1.32:8.4": "sahassena samaṃ mitā. ",
  "sn1.32:9.1": "atha kho aparā devatā bhagavato santike imā gāthāyo abhāsi: ",
  "sn1.32:10.1": "duddadaṃ dadamānānaṃ ",
  "sn1.32:10.2": "dukkaraṃ kamma kubbataṃ, ",
  "sn1.32:10.3": "asanto nānukubbanti ",
  "sn1.32:10.4": "sataṃ dhammo durannayo. ",
  "sn1.32:11.1": "tasmā satañca asatañca ",
  "sn1.32:11.2": "nānā hoti ito gati, ",
  "sn1.32:11.3": "asanto nirayaṃ yanti ",
  "sn1.32:11.4": "santo saggaparāyaṇāti. ",
  "sn1.32:12.1": "atha kho aparā devatā bhagavantaṃ etadavoca: ",
  "sn1.32:12.2": "kassa nu kho bhagavā subhāsitanti? ",
  "sn1.32:13.1": "[bhagavā:] sabbāsaṃ vo subhāsitaṃ pariyāyena. api ca mamāpi suṇātha: ",
  "sn1.32:14.1": "dhammaṃ care yopi samuñchakaṃ caraṃ ",
  "sn1.32:14.2": "dārañca posaṃ dadamappakasmiṃ, ",
  "sn1.32:14.3": "sataṃ sahassānaṃ sahassayāginaṃ ",
  "sn1.32:14.4": "kalampi nāgghanti tathāvidhassa teti ",
  "sn1.32:15.1": "atha kho aparā devatā bhagavantaṃ gāthāya ajjhabhāsi: ",
  "sn1.32:16.1": "kenesa yañño vipulo mahaggato ",
  "sn1.32:16.2": "samena dinnassa na agghameti, ",
  "sn1.32:16.3": "kathaṃ sataṃ sahassānaṃ sahassayāginaṃ, ",
  "sn1.32:16.4": "kalampi nāgghanti tathāvidhassa teti. ",
  "sn1.32:17.1": "atha kho bhagavā taṃ devataṃ gāthāya ajjhabhāsi: dadanti heke visame niviṭṭhā ",
  "sn1.32:17.2": "chetvā vadhitvā atha socayitvā, ",
  "sn1.32:17.3": "sā dakkhiṇā assumukhā sadaṇḍā ",
  "sn1.32:17.4": "samena dinnassa na agghameti. ",
  "sn1.32:18.1": "evaṃ sataṃ sahassānaṃ sahassayāginaṃ ",
  "sn1.32:18.2": "kalampi nāgghanti tathāvidhassa teti. "
}
