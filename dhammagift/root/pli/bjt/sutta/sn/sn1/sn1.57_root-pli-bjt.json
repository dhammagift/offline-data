{
  "sn1.57:0.1": "",
  "sn1.57:0.2": "",
  "sn1.57:0.3": "1. 6. 7. tatiyajanetisuttaṃ ",
  "sn1.57:1.1": "[devatā:] kiṃsu janeti purisaṃ ",
  "sn1.57:1.2": "kiṃsu tassa vidhāvati, ",
  "sn1.57:1.3": "kiṃsu saṃsāramāpādi ",
  "sn1.57:1.4": "kiṃsu tassa parāyaṇanti. ",
  "sn1.57:2.1": "[bhagavā:] taṇhā janeti purisaṃ ",
  "sn1.57:2.2": "cittamassa vidhāvati, ",
  "sn1.57:2.3": "satto saṃsāramāpādi ",
  "sn1.57:2.4": "kammaṃ tassa parāyaṇanti. "
}
