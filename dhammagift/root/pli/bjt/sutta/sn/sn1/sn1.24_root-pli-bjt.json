{
  "sn1.24:0.1": "",
  "sn1.24:0.2": "",
  "sn1.24:0.3": "1. 3. 4. manonivāraṇasuttaṃ ",
  "sn1.24:1.1": "sāvatthiyaṃ– ekamantaṃ ṭhitā kho sā devatā bhagavato santike imaṃ gāthaṃ abhāsi: yato yato mano nivāraye ",
  "sn1.24:1.2": "na dukkhameti naṃ tato tato, ",
  "sn1.24:1.3": "sa sabbato mano nivāraye ",
  "sn1.24:1.4": "sa sabbato dukkhā pamuccatīti. ",
  "sn1.24:2.1": "[bhagavā:] na sabbato mano nivāraye ",
  "sn1.24:2.2": "mano yatattamāgataṃ, ",
  "sn1.24:2.3": "yato yato ca pāpakaṃ ",
  "sn1.24:2.4": "tato tato mano nivāraye’ti. "
}
