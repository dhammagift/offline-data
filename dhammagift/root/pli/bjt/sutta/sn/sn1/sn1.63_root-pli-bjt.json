  "sn1.63:0.3": "1. 7. 3. taṇhāsuttaṃ ",
  "sn1.63:1.1": "[devatā:] kenassu nīyati loko ",
  "sn1.63:1.2": "kenassu parikassati, ",
  "sn1.63:1.3": "kissassa ekadhammassa ",
  "sn1.63:1.4": "sabbeva vasamanvagūti. ",
  "sn1.63:2.1": "[bhagavā:] taṇhāya nīyati loko ",
  "sn1.63:2.2": "taṇhāya parikassati, ",
  "sn1.63:2.3": "taṇhāya ekadhammassa ",
  "sn1.63:2.4": "sabbeva vasamanvagūti. "
}
