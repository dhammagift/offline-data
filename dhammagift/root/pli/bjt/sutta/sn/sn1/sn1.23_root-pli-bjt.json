{
  "sn1.23:0.1": "",
  "sn1.23:0.2": "",
  "sn1.23:0.3": "1. 3. 3. jaṭāsuttaṃ ",
  "sn1.23:1.1": "sāvatthiyaṃ– ekamantaṃ ṭhitā kho sā devatā bhagavantaṃ gāthāya ajjhabhāsi: anto jaṭā bahi jaṭā ",
  "sn1.23:1.2": "jaṭāya jaṭitā pajā, ",
  "sn1.23:1.3": "taṃ taṃ gotama pucchāmi ",
  "sn1.23:1.4": "ko imaṃ vijaṭaye jaṭanti. ",
  "sn1.23:2.1": "[bhagavā:] sīle patiṭṭhāya naro sapañño ",
  "sn1.23:2.2": "cittaṃ paññañca bhāvayaṃ, ",
  "sn1.23:2.3": "ātāpi nipako bhikkhu ",
  "sn1.23:2.4": "so imaṃ vijaṭaye jaṭanti. ",
  "sn1.23:3.1": "yesaṃ rāgo ca doso ca ",
  "sn1.23:3.2": "avijjā ca virājitā, ",
  "sn1.23:3.3": "khīṇāsavā arahanto ",
  "sn1.23:3.4": "tesaṃ vijaṭitā jaṭā. ",
  "sn1.23:4.1": "yattha nāmañca rūpañca ",
  "sn1.23:4.2": "asesaṃ uparujjhati, ",
  "sn1.23:4.3": "paṭighaṃ rūpasaññā ca ",
  "sn1.23:4.4": "etthesā chijjate jaṭāti. "
}
