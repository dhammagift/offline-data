{
  "sn1.5:0.1": "",
  "sn1.5:0.2": "",
  "sn1.5:0.3": "1. 1. 5. katichindasuttaṃ ",
  "sn1.5:1.1": "sāvatthiyaṃ– ",
  "sn1.5:1.2": "ekamantaṃ ṭhitā kho sā devatā bhagavato bhagavantaṃ gāthāya ajjhabhāsi: ",
  "sn1.5:2.1": "kati chinde kati jahe ",
  "sn1.5:2.2": "kati cuttari bhāvaye, ",
  "sn1.5:2.3": "kati saṅgātigo ‘bhikkhu ",
  "sn1.5:2.4": "oghatiṇṇo’ti vuccatīti. ",
  "sn1.5:3.1": "[bhagavā:] pañca chinde pañca jahe ",
  "sn1.5:3.2": "pañca cuttari bhāvaye, ",
  "sn1.5:3.3": "pañca saṅgātigo ‘bhikkhu ",
  "sn1.5:3.4": "oghatiṇṇo’ti vuccatīti. "
}
