  "sn35.97:0.1": "",
  "sn35.97:0.2": "",
  "sn35.97:0.3": "1. 10. 4. pamādavihārīsuttaṃ ",
  "sn35.97:1.1": "pamādavihāriñca vo bhikkhave, desissāmi appamādavihāriñca. ",
  "sn35.97:1.2": "taṃ suṇātha. ",
  "sn35.97:1.3": "kathañca bhikkhave, pamādavihārī hoti? ",
  "sn35.97:1.4": "cakkhundriyā saṃvutassa bhikkhave, viharato cittaṃ byāsiccati cakkhuviññeyyesu rūpesu, ",
  "sn35.97:1.5": "tassa vyāsittacittassa pāmojjaṃ na hoti. ",
  "sn35.97:1.6": "pāmujje asati pīti na hoti. ",
  "sn35.97:1.7": "pītiyā asati passaddhi na hoti. ",
  "sn35.97:1.8": "passaddhiyā asati dukkhaṃ viharati. ",
  "sn35.97:1.9": "dukkhino cittaṃ na samādhiyati. ",
  "sn35.97:1.10": "asamāhite citte dhammā na pātubhavanti. ",
  "sn35.97:1.11": "dhammānaṃ apātubhāvā pamādavihārītveva saṅkhaṃ gacchati. sotindriyā asaṃvutassa bhikkhave viharato …pe… ",
  "sn35.97:1.12": "ghānindriyā saṃvutassa bhikkhave viharato …pe… jivhindriyā asaṃvutassa bhikkhave viharato cittaṃ vyāsiccati jivhāviññeyyesu rasesu, ",
  "sn35.97:1.13": "tassa vyāsittacittassa pāmujjaṃ na hoti …pe… ",
  "sn35.97:1.14": "kāyindriyā saṃvutassa bhikkhave viharato …pe… ",
  "sn35.97:1.15": "manindriyā saṃvutassa bhikkhave viharato cittaṃ vyāsiccati manoviññeyyesu dhammesu, ",
  "sn35.97:1.16": "tassa vyāsittacittassa pāmujjaṃ na hoti. ",
  "sn35.97:1.17": "pāmujje asati pīti na hoti. ",
  "sn35.97:1.18": "pītiyā asati passaddhi na hoti. ",
  "sn35.97:1.19": "passaddhiyā asati dukkhaṃ viharati. ",
  "sn35.97:1.20": "dukkhino cittaṃ na samādhiyati. ",
  "sn35.97:1.21": "asamāhite citte dhammā na pātubhavanti. ",
  "sn35.97:1.22": "dhammānaṃ apātubhāvā pamādavihārītveva saṅkhaṃ gacchati. ",
  "sn35.97:1.23": "evaṃ kho bhikkhave, pamādavihārī hoti. ",
  "sn35.97:2.1": "kathañca bhikkhave appamādavihārī hoti? ",
  "sn35.97:2.2": "cakkhundriyasaṃvutassa bhikkhave viharato cittaṃ na vyāsiñcati cakkhuviññeyyesu rūpesu, ",
  "sn35.97:2.3": "tassa abyāsittacittassa pāmujjaṃ jāyati. ",
  "sn35.97:2.4": "pamuditassa pīti jāyati. ",
  "sn35.97:2.5": "pītimanassa kāyo passambhati. ",
  "sn35.97:2.6": "passaddhakāyo sukhaṃ vediyati. ",
  "sn35.97:2.7": "sukhino cittaṃ samādhiyati. ",
  "sn35.97:2.8": "samāhite citte dhammā pātubhavanti. ",
  "sn35.97:2.9": "dhammānaṃ pātubhāvā appamādavihārītveva saṅkhaṃ gacchati. sotindriyasaṃvutassa bhikkhave viharato …pe… ",
  "sn35.97:2.10": "ghānindriya saṃvutassa bhikkhave viharato …pe… ",
  "sn35.97:2.11": "jivhindriyasaṃvutassa bhikkhave viharato …pe… kāyindriyasaṃvutassa bhikkhave ",
  "sn35.97:2.12": "viharato …pe… manindriyasaṃvutassa bhikkhave viharato cittaṃ nabyāsiccati manoviññeyyesu dhammesu, ",
  "sn35.97:2.13": "tassa abyāsittacittassa pāmujjaṃ jāyati. ",
  "sn35.97:2.14": "pamuditassa pīti jāyati. ",
  "sn35.97:2.15": "pītimanassa kāyo passambhati. ",
  "sn35.97:2.16": "passaddhakāyo sukhaṃ vediyati. ",
  "sn35.97:2.17": "sukhino cittaṃ samādhiyati. ",
  "sn35.97:2.18": "samāhite citte dhammā pātubhavanti. ",
  "sn35.97:2.19": "dhammānaṃ pātubhāvā appamādavihārītveva saṅkhaṃ gacchati. ",
  "sn35.97:2.20": "evaṃ kho bhikkhave appamādavihārī hotīti. ",
  "sn35.97:2.21": ""
}
