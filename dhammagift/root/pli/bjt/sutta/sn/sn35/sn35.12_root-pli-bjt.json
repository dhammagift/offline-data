{
  "sn35.12:0.1": "",
  "sn35.12:0.2": "",
  "sn35.12:0.3": "1. 1. 12. dutiya bāhirānattasuttaṃ ",
  "sn35.12:1.1": "sāvatthiyaṃ– rūpā bhikkhave, anattā atītānāgatā, ",
  "sn35.12:1.2": "ko pana vādo paccuppannānaṃ, ",
  "sn35.12:1.3": "evaṃ passaṃ bhikkhave, sutavā ariyasāvako atītesu rūpesu anapekho hoti, ",
  "sn35.12:1.4": "anāgate rūpe nābhinandati, ",
  "sn35.12:1.5": "paccuppannānaṃ rūpānaṃ nibbidāya virāgāya nirodhāya paṭipanno hoti. ",
  "sn35.12:1.6": "saddā …pe… ",
  "sn35.12:1.7": "gandhā …pe… ",
  "sn35.12:1.8": "rasā …pe… ",
  "sn35.12:1.9": "phoṭṭhabbā …pe… ",
  "sn35.12:1.10": "dhammā anattā atītānāgatā, ",
  "sn35.12:1.11": "ko pana vādo paccuppannānaṃ, ",
  "sn35.12:1.12": "evaṃ passaṃ bhikkhave, sutavā ariyasāvako atītesu dhammesu anapekho hoti, ",
  "sn35.12:1.13": "anāgate dhamme nābhinandati, ",
  "sn35.12:1.14": "paccuppannānaṃ dhammānaṃ nibbidāya virāgāya nirodhāya paṭipanno hotīti. ",
  "sn35.12:1.15": "",
  "sn35.12:1.16": "aniccavaggo paṭhamo. ",
  "sn35.12:2.0": "tassuddānaṃ: ",
  "sn35.12:2.1": "aniccaṃ dukkhaṃ anattā ca ",
  "sn35.12:2.2": "tayo ajjhattabāhirā ",
  "sn35.12:2.3": "yadaniccena tayo vuttā ",
  "sn35.12:2.4": "te te ajjhattabāhirā. "
}
