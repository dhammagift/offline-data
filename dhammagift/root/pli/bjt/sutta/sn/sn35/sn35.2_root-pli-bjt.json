  "sn35.2:0.1": "",
  "sn35.2:0.2": "",
  "sn35.2:0.3": "1. 1. 2. ajjhattadukkhasuttaṃ ",
  "sn35.2:1.1": "sāvatthiyaṃ– cakkhuṃ bhikkhave dukkhaṃ. ",
  "sn35.2:1.2": "yaṃ dukkhaṃ tadanattā, ",
  "sn35.2:1.3": "yadanattā taṃ “netaṃ mama, neso’hamasmi, na meso attā”ti evametaṃ yathābhūtaṃ sammappaññāya daṭṭhabbaṃ. ",
  "sn35.2:1.4": "sotaṃ dukkhaṃ …pe… ",
  "sn35.2:1.5": "ghānaṃ dukkhaṃ …pe… ",
  "sn35.2:1.6": "jivhā dukkhā …pe… ",
  "sn35.2:1.7": "kāyo dukkho …pe… ",
  "sn35.2:1.8": "mano dukkho. ",
  "sn35.2:1.9": "yaṃ dukkhaṃ tadanattā, ",
  "sn35.2:1.10": "yadanattā taṃ “netaṃ mama, neso’hamasmi, na meso attā”ti evametaṃ yathābhūtaṃ sammappaññāya daṭṭhabbaṃ. ",
  "sn35.2:1.11": "evaṃ passaṃ …pe… ",
  "sn35.2:1.12": "nāparaṃ itthattāyāti pajānātīti. ",
  "sn35.2:1.13": ""
}
