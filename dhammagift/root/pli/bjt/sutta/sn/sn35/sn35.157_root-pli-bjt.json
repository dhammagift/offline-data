  "sn35.157:0.1": "",
  "sn35.157:0.2": "",
  "sn35.157:0.3": "1. 16. 2. bahiddhānandikkhayaaniccasuttaṃ ",
  "sn35.157:1.1": "anicceyeva bhikkhave bhikkhu rūpe aniccāti passati, sāssa hoti sammādiṭṭhi. ",
  "sn35.157:1.2": "sammā passaṃ nibbindati. ",
  "sn35.157:1.3": "nandikkhayā rāgakkhayo ",
  "sn35.157:1.4": "rāgakkhayā nandikkhayo ",
  "sn35.157:1.5": "nandirāgakkhayā cittaṃ suvimuttanti vuccati. ",
  "sn35.157:1.6": "anicceyeva bhikkhave bhikkhu sadde …pe… ",
  "sn35.157:1.7": "gandhe …pe… ",
  "sn35.157:1.8": "rase …pe… ",
  "sn35.157:1.9": "phoṭṭhabbe …pe… ",
  "sn35.157:1.10": "dhamme aniccāti passati, sāssa hoti sammādiṭṭhi. ",
  "sn35.157:1.11": "sammā passaṃ nibbindati. ",
  "sn35.157:1.12": "nandikkhayā rāgakkhayo, ",
  "sn35.157:1.13": "rāgakkhayā nandikkhayo, ",
  "sn35.157:1.14": "nandirāgakkhayā cittaṃ suvimuttanti vuccatīti. ",
  "sn35.157:1.15": ""
}
