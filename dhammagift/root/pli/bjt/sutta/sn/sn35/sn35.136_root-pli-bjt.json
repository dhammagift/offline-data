{
  "sn35.136:0.1": "",
  "sn35.136:0.2": "",
  "sn35.136:0.3": "1. 14. 3. sagayhasuttaṃ ",
  "sn35.136:1.1": "rūpārāmā bhikkhave devamanussā rūparatā rūpasammuditā. ",
  "sn35.136:1.2": "rūpavipariṇāmavirāganirodhā dukkhā bhikkhave devamanussā viharanti. ",
  "sn35.136:1.3": "saddārāmā …pe… ",
  "sn35.136:1.4": "",
  "sn35.136:1.5": "gandhārāmā …pe… ",
  "sn35.136:1.6": "rasārāmā …pe… ",
  "sn35.136:1.7": "phoṭṭhabbārāmā …pe… ",
  "sn35.136:1.8": "dhammārāmā bhikkhave, devamanussā dhammaratā dhammasammuditā. ",
  "sn35.136:1.9": "dhammavipariṇāmavirāganirodhā dukkhā bhikkhave devamanussā viharanti. ",
  "sn35.136:1.10": "tathāgato ca kho bhikkhave arahaṃ sammāsambuddho rūpānaṃ samudayañca atthagamañca assādañca ādīnavañca nissaraṇañca yathābhūtaṃ viditvā na rūpārāmo na rūparato na rūpasammudito. ",
  "sn35.136:1.11": "rūpavipariṇāmavirāganirodhā sukho bhikkhave tathāgato viharati. ",
  "sn35.136:1.12": "saddānaṃ …pe… ",
  "sn35.136:1.13": "gandhānaṃ …pe… ",
  "sn35.136:1.14": "rasānaṃ …pe… ",
  "sn35.136:1.15": "phoṭṭhabbānaṃ …pe… ",
  "sn35.136:1.16": "dhammānaṃ samudayañca atthagamañca assādañca ādīnavañca nissaraṇañca yathābhūtaṃ viditvā na dhammārāmo na dhammarato na dhammasammudito. ",
  "sn35.136:1.17": "dhammavipariṇāmavirāganirodhā sukho bhikkhave tathāgato viharatīti. ",
  "sn35.136:1.18": "idamavoca bhagavā. ",
  "sn35.136:1.19": "idaṃ vatvā sugato athāparaṃ etadavoca satthā: ",
  "sn35.136:2.1": "rūpā saddā rasā gandhā ",
  "sn35.136:2.2": "phassā dhammā ca kevalā ",
  "sn35.136:2.3": "iṭṭhā kantā manāpā ca ",
  "sn35.136:2.4": "yāvatatthiti vuccati. ",
  "sn35.136:3.1": "sadevakassa lokassa ",
  "sn35.136:3.2": "ete vo sukhasammatā ",
  "sn35.136:3.3": "yattha ceto nirujjhanti ",
  "sn35.136:3.4": "taṃ tesaṃ dukkhasammataṃ. ",
  "sn35.136:4.1": "sukhanti diṭṭhamariyebhi ",
  "sn35.136:4.2": "sakkāyassuparodhanaṃ ",
  "sn35.136:4.3": "paccanīkamidaṃ hoti ",
  "sn35.136:4.4": "sabbalokena passataṃ ",
  "sn35.136:5.1": "yaṃ pare sukhato āhu ",
  "sn35.136:5.2": "tadariyā āhu dukkhato ",
  "sn35.136:5.3": "yaṃ pare dukkhato āhu ",
  "sn35.136:5.4": "tadariyā sukhato vidū. ",
  "sn35.136:6.1": "passa dhammaṃ durājānaṃ ",
  "sn35.136:6.2": "sammūḷhettha aviddasu ",
  "sn35.136:6.3": "nivutānaṃ tamo hoti ",
  "sn35.136:6.4": "andhakāro apassataṃ. ",
  "sn35.136:7.1": "satañca vivaṭaṃ hoti ",
  "sn35.136:7.2": "āloko passatāmica ",
  "sn35.136:7.3": "santike na vijānanti ",
  "sn35.136:7.4": "magā dhammassa akovidā. ",
  "sn35.136:8.1": "bhavarāgaparetehi ",
  "sn35.136:8.2": "bhavasotānusārihi ",
  "sn35.136:8.3": "māradheyyānupannehi ",
  "sn35.136:8.4": "nāyaṃ dhammo susambudho. ",
  "sn35.136:9.1": "ko nu aññatra mariyebhi ",
  "sn35.136:9.2": "padaṃ sambuddhamarahati. ",
  "sn35.136:9.3": "yampadaṃ sammadaññāya ",
  "sn35.136:9.4": "parinibbanti anāsavāti. ",
  "sn35.136:9.5": ""
}
