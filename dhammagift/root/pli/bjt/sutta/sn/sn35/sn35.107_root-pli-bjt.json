  "sn35.107:0.1": "",
  "sn35.107:0.2": "",
  "sn35.107:0.3": "1. 11. 4. lokasamudayasuttaṃ ",
  "sn35.107:1.1": "lokassa bhikkhave, samudayañca atthagamañca desissāmi. ",
  "sn35.107:1.2": "taṃ suṇātha. ",
  "sn35.107:1.3": "katamo ca bhikkhave lokassa samudayo? ",
  "sn35.107:1.4": "cakkhuñca paṭicca rūpe cuppajjati cakkhuviññāṇaṃ. tiṇṇaṃ saṅgati phasso. ",
  "sn35.107:1.5": "phassapaccayā vedanā. ",
  "sn35.107:1.6": "vedanāpaccayā taṇhā, ",
  "sn35.107:1.7": "taṇhāpaccayā upādānaṃ, ",
  "sn35.107:1.8": "upādānapaccayā bhavo, ",
  "sn35.107:1.9": "bhavapaccayā jāti, ",
  "sn35.107:1.10": "jātipaccayā jarāmaraṇaṃ sokaparidevadukkhadomanassupāyāsā sambhavanti. ",
  "sn35.107:1.11": "ayaṃ kho bhikkhave lokassa samudayo. sotañca paṭicca …pe… ghānañca paṭicca …pe… ",
  "sn35.107:1.12": "jivhañca paṭicca …pe… kāyañca paṭicca …pe… ",
  "sn35.107:1.13": "manañca paṭicca dhamme cuppajjati manoviññāṇaṃ. tiṇṇaṃ saṅgati phasso. ",
  "sn35.107:1.14": "phassapaccayā vedanā, ",
  "sn35.107:1.15": "vedanāpaccayā taṇhā, ",
  "sn35.107:1.16": "taṇhāpaccayā upādānaṃ, ",
  "sn35.107:1.17": "upādānapaccayā bhavo, ",
  "sn35.107:1.18": "bhavapaccayā jāti, ",
  "sn35.107:1.19": "jātipaccayā jarāmaraṇaṃ sokaparidevadukkhadomanassupāyāsā sambhavanti. ",
  "sn35.107:1.20": "ayaṃ kho bhikkhave lokassa samudayo. ",
  "sn35.107:2.1": "katamo ca bhikkhave, lokassa atthagamo? ",
  "sn35.107:2.2": "cakkhuñca paṭicca rūpe cuppajjati cakkhuviññāṇaṃ. tiṇṇaṃ saṅgati phasso. ",
  "sn35.107:2.3": "phassapaccayā vedanā, ",
  "sn35.107:2.4": "vedanāpaccayā taṇhā. ",
  "sn35.107:2.5": "tassāyeva taṇhāya asesavirāga nirodhā upādānanirodho ",
  "sn35.107:2.6": "…pe… ",
  "sn35.107:2.7": "",
  "sn35.107:2.8": "",
  "sn35.107:2.9": "evametassa kevalassa dukkhakkhandhassa nirodho hoti. ",
  "sn35.107:2.10": "ayaṃ kho bhikkhave lokassa atthagamo. sotañca …pe… ghānañca …pe… ",
  "sn35.107:2.11": "jivhañca …pe… kāyañca …pe… ",
  "sn35.107:2.12": "manañca paṭicca dhamme cuppajjati manoviññāṇaṃ. tiṇṇaṃ saṅgati phasso. ",
  "sn35.107:2.13": "phassapaccayā vedanā, ",
  "sn35.107:2.14": "vedanāpaccayā taṇhā. ",
  "sn35.107:2.15": "tassāyeva taṇhāya asesavirāganirodhā upādānanirodho ",
  "sn35.107:2.16": "…pe… ",
  "sn35.107:2.17": "evametassa kevalassa dukkhakkhandhassa nirodho hoti. ",
  "sn35.107:2.18": "ayaṃ kho bhikkhave lokassa atthagamoti. ",
  "sn35.107:2.19": ""
}
