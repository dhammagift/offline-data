{
  "sn35.227:0.1": "",
  "sn35.227:0.2": "",
  "sn35.227:0.3": "1. 17. 60. bāhirāyatana anattasuttaṃ ",
  "sn35.227:1.1": "rūpā bhikkhave anattā. saddā …pe… gandhā …pe… rasā …pe… phoṭṭhabbā …pe… dhammā anattā. ",
  "sn35.227:1.2": "evaṃ passaṃ bhikkhave sutavā ariyasāvako rūpesupi nibbindati …pe… ",
  "sn35.227:1.3": "nāparaṃ itthattāyāti pajānātīti. ",
  "sn35.227:1.4": "saṭṭhipeyyālo samatto. tatruddānaṃ: ",
  "sn35.227:2.0": "",
  "sn35.227:2.1": "chandenaṭṭhārasa honti ",
  "sn35.227:2.2": "atītena ca dve nava ",
  "sn35.227:2.3": "yadaniccāṭṭhārasa vuttā ",
  "sn35.227:2.4": "tayo ajjhattabāhirā ",
  "sn35.227:2.5": "peyyālo saṭṭhiko vutto ",
  "sn35.227:2.6": "buddhenādiccabandhunāti. ",
  "sn35.227:2.7": ""
}
