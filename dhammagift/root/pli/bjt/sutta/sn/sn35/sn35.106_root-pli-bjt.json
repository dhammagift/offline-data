{
  "sn35.106:0.1": "",
  "sn35.106:0.2": "",
  "sn35.106:0.3": "1. 11. 3. dukkhasamudayasuttaṃ ",
  "sn35.106:1.1": "dukkhassa bhikkhave, samudayañca atthagamañca desissāmi. ",
  "sn35.106:1.2": "taṃ suṇātha. ",
  "sn35.106:1.3": "katamo ca bhikkhave, dukkhassa samudayo: ",
  "sn35.106:1.4": "cakkhuñca paṭicca rūpe cuppajjati cakkhuviññāṇaṃ. tiṇṇaṃ saṅgati phasso. ",
  "sn35.106:1.5": "phassapaccayā vedanā, ",
  "sn35.106:1.6": "vedanā paccayā taṇhā. ",
  "sn35.106:1.7": "ayaṃ dukkhassa samudayo. sotañca paṭicca …pe… ghānañca paṭicca …pe… ",
  "sn35.106:1.8": "jivhañca paṭicca …pe… kāyañca ",
  "sn35.106:1.9": "",
  "sn35.106:1.10": "paṭicca ",
  "sn35.106:1.11": "…pe… manañca paṭicca dhamme cuppajjati manoviññāṇaṃ. ",
  "sn35.106:1.12": "tiṇṇaṃ saṅgati phasso. ",
  "sn35.106:1.13": "phassapaccayā vedanā. ",
  "sn35.106:1.14": "vedanā paccayā taṇhā. ",
  "sn35.106:1.15": "ayaṃ kho bhikkhave dukkhassa samudayo. ",
  "sn35.106:2.1": "katamo ca bhikkhave, dukkhassa atthagamo? ",
  "sn35.106:2.2": "cakkhuñca paṭicca rūpe cuppajjati cakkhuviññāṇaṃ. tiṇṇaṃ saṅgati phasso. ",
  "sn35.106:2.3": "phassapaccayā vedanā, ",
  "sn35.106:2.4": "vedanāpaccayā taṇhā. ",
  "sn35.106:2.5": "tassā yeva taṇhāya asesavirāganirodhā upādānanirodho, ",
  "sn35.106:2.6": "upādānanirodhā bhavanirodho, ",
  "sn35.106:2.7": "bhavanirodhā jātinirodho, ",
  "sn35.106:2.8": "jātinirodhā jarāmaraṇaṃ sokaparidevadukkhadomanassupāyāsā nirujjhanti. ",
  "sn35.106:2.9": "evametassa kevalassa dukkhakkhandhassa nirodho hoti. ",
  "sn35.106:2.10": "ayaṃ dukkhassa atthagamo. sotañca paṭicca …pe… ghānañca paṭicca …pe… ",
  "sn35.106:2.11": "jivhañca paṭicca rase cuppajjati jivhāviññāṇaṃ …pe… kāyañca paṭicca …pe… ",
  "sn35.106:2.12": "manañca paṭicca dhamme cuppajjati manoviññāṇaṃ. tiṇṇaṃ saṅgati phasso. ",
  "sn35.106:2.13": "phassapaccayā vedanā, ",
  "sn35.106:2.14": "vedanā paccayā taṇhā. ",
  "sn35.106:2.15": "tassā yeva taṇhāya asesavirāganirodhā upādānanirodho, ",
  "sn35.106:2.16": "upādānanirodhā bhavanirodho, ",
  "sn35.106:2.17": "bhavanirodhā jātinirodho, ",
  "sn35.106:2.18": "jātinirodhā jarāmaraṇaṃ sokaparidevadukkhadomanassupāyāsā nirujjhanti. ",
  "sn35.106:2.19": "evametassa kevalassa dukkhakkhandhassa nirodho hoti. ",
  "sn35.106:2.20": "ayaṃ kho bhikkhave, dukkhassa atthagamoti. ",
  "sn35.106:2.21": ""
}
