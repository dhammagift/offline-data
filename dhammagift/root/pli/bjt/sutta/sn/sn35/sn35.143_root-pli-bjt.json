  "sn35.143:0.3": "1. 14. 10. bāhiraaniccasuttaṃ ",
  "sn35.143:1.1": "rūpā bhikkhave aniccā. ",
  "sn35.143:1.2": "yopi hetu yopi paccayo rūpānaṃ uppādāya sopi anicco. ",
  "sn35.143:1.3": "aniccasambhūtā bhikkhave rūpā kuto niccā bhavissanti ",
  "sn35.143:1.4": "saddā …pe… ",
  "sn35.143:1.5": "gandhā …pe… ",
  "sn35.143:1.6": "rasā …pe… ",
  "sn35.143:1.7": "phoṭṭhabbā …pe… ",
  "sn35.143:1.8": "dhammā aniccā. ",
  "sn35.143:1.9": "yopi hetu yopi paccayo dhammānaṃ uppādāya sopi anicco. ",
  "sn35.143:1.10": "aniccasambhūtā bhikkhave dhammā kuto niccā ",
  "sn35.143:1.11": "",
  "sn35.143:1.12": "",
  "sn35.143:1.13": ""
}
