{
  "sn38.16:0.1": "",
  "sn38.16:0.2": "",
  "sn38.16:0.3": "4. 1. 16. dukkarasuttaṃ ",
  "sn38.16:1.1": "kinnu kho āvuso sāriputta imasmiṃ dhammavinaye dukkaranti. ",
  "sn38.16:1.2": "pabbajjā kho āvuso imasmiṃ dhammavinaye dukkarāti. ",
  "sn38.16:1.3": "pabbajitena panāvuso kiṃ dukkaranti. ",
  "sn38.16:1.4": "pabbajitena kho āvuso abhirati dukkarāti. ",
  "sn38.16:1.5": "abhiratena pana āvuso kiṃ dukkaranti. ",
  "sn38.16:1.6": "abhiratena kho āvuso dhammānudhammapaṭipatti dukkarāti. ",
  "sn38.16:1.7": "kīva ciraṃ panāvuso dhammānudhammapaṭipanno bhikkhu arahaṃ assāti. ",
  "sn38.16:1.8": "na ciraṃ āvusoti. ",
  "sn38.16:1.9": "jambukhādakasaṃyuttaṃ samattaṃ. tatruddānaṃ: ",
  "sn38.16:1.10": "",
  "sn38.16:2.0": "",
  "sn38.16:2.1": "nibbānaṃ arahattañca ",
  "sn38.16:2.2": "dhammavādī kimatthiyaṃ ",
  "sn38.16:2.3": "assāso paramassāso ",
  "sn38.16:2.4": "vedanā āsavo tathā, avijjā ",
  "sn38.16:2.5": "taṇhā oghoca upādānaṃ ",
  "sn38.16:2.6": "bhavopica dukkhañceva sakkāyo ",
  "sn38.16:2.7": "dukkarañceti soḷasa. "
}
