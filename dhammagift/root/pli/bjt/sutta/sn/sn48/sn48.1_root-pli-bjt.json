{
  "sn48.1:0.1": "4. indriyasaṃyuttaṃ ",
  "sn48.1:0.2": "1. suddhakavaggo ",
  "sn48.1:0.3": "4. 1. 1. suddhakasuttaṃ ",
  "sn48.1:1.1": "",
  "sn48.1:1.2": "sāvatthiyaṃ: ",
  "sn48.1:1.3": "pañcimāni bhikkhave, indriyāni. ",
  "sn48.1:1.4": "katamāni pañca: ",
  "sn48.1:1.5": "saddhindriyaṃ, viriyindriyaṃ, satindriyaṃ, samādhindriyaṃ, paññindriyaṃ, ",
  "sn48.1:1.6": "imāni kho bhikkhave, pañca ",
  "sn48.1:1.7": "indriyānīti. "
}
