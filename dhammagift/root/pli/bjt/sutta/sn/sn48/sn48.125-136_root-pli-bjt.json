  "sn48.125-136:0.1": "",
  "sn48.125-136:0.2": "13. punagaṅgāpeyyālo ",
  "sn48.125-136:0.3": "4. 13. 1-36. pācīnaninnādi suttāni ",
  "sn48.125-136:1.1": "seyyathāpi bhikkhave, gaṅgānadī ",
  "sn48.125-136:1.2": "",
  "sn48.125-136:1.3": "",
  "sn48.125-136:1.4": "…pe… ",
  "sn48.125-136:1.5": "nibbānapabbhāroti. ",
  "sn48.125-136:1.6": "(indriyasaṃyuttassa punagaṅgāpeyyālavaggo rāgavinayādivasena amatogadhādivasena ",
  "sn48.125-136:1.7": "nibbānaninnādivasena ca vitthāretabbo. ekekasmiṃ tayo tayo katvā chattiṃsati suttantā veditabbā.) ",
  "sn48.125-136:2.0": "punagaṅgāpeyyāli. tatruddānaṃ: ",
  "sn48.125-136:2.1": "cha pācīnato ninnā ",
  "sn48.125-136:2.2": "cha ca ninnā samuddato, ",
  "sn48.125-136:2.3": "ete dve dvādasa honti ",
  "sn48.125-136:2.4": "vaggo tena pavuccatīti. "
}
