{
  "sn48.125-136:0.1": "",
  "sn48.125-136:0.2": "15. punabalakaraṇīyavaggo ",
  "sn48.125-136:0.3": "4. 15. 1-36. balādi suttāni ",
  "sn48.125-136:1.1": "seyyathāpi bhikkhave, ye ",
  "sn48.125-136:1.2": "keci ",
  "sn48.125-136:1.3": "balakaraṇīyā kammantā ",
  "sn48.125-136:1.4": "…pe… bahulīkarotīti. (vuttanayeneva vitthārentena ",
  "sn48.125-136:1.5": "chattiṃsati suttantā veditabbā.) punabalakaraṇīyavaggo paṇṇarasamo. ",
  "sn48.125-136:1.6": "tatruddānaṃ: ",
  "sn48.125-136:1.7": "balaṃ ",
  "sn48.125-136:2.0": "",
  "sn48.125-136:2.1": "bījañca nāgo ",
  "sn48.125-136:2.2": "ca rukkhaṃ kumbhena ",
  "sn48.125-136:2.3": "sūkinaṃ, ākāsena ca dve meghā ",
  "sn48.125-136:2.4": "nāvā āgantukā nadīti. "
}
