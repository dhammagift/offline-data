  "sn48.23:0.1": "",
  "sn48.23:0.2": "",
  "sn48.23:0.3": "4. 3. 3. aññindriyasuttaṃ ",
  "sn48.23:1.1": "tīṇimāni bhikkhave, indriyāni. ",
  "sn48.23:1.2": "katamāni tīṇi: ",
  "sn48.23:1.3": "anaññātaññassāmītindriyaṃ, aññindriyaṃ, aññātāvindriyaṃ. ",
  "sn48.23:1.4": "imāni kho bhikkhave, tīṇi indriyānīti. ",
  "sn48.23:1.5": ""
}
