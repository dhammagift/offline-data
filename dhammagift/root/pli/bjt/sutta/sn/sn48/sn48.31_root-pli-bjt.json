{
  "sn48.31:0.1": "",
  "sn48.31:0.2": "4. sukhindriyavaggo ",
  "sn48.31:0.3": "4. 4. 1. suddhakasuttaṃ ",
  "sn48.31:1.1": "pañcimāni bhikkhave, indriyāni. ",
  "sn48.31:1.2": "katamāni pañca: ",
  "sn48.31:1.3": "sukhindriyaṃ, dukkhindriyaṃ, somanassindriyaṃ, domanassindriyaṃ, upekkhindriyaṃ, ",
  "sn48.31:1.4": "imāni kho bhikkhave, pañcindriyānīti. ",
  "sn48.31:1.5": ""
}
