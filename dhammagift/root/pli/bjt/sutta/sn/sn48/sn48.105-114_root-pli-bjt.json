{
  "sn48.105-114:0.1": "",
  "sn48.105-114:0.2": "11. esanāvaggo ",
  "sn48.105-114:0.3": "4. 11. 1-40. esanādi suttāni ",
  "sn48.105-114:1.1": "tisso imā bhikkhave, esanā. katamā tisso: …pe… bhāvetabbāti. (esanāvaggo ca vivekanissitādivasena vitthāretabbo) ",
  "sn48.105-114:2.0": "esanāvaggo ekādasamo tatruddānaṃ: ",
  "sn48.105-114:2.1": "esanā vidhā āsavo ",
  "sn48.105-114:2.2": "bhavo dukkhatā ca tisso, ",
  "sn48.105-114:2.3": "khilaṃ malañca nīgho ca ",
  "sn48.105-114:2.4": "vedanā taṇhāhi cāti. "
}
