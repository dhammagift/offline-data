  "sn48.71-82:0.1": "",
  "sn48.71-82:0.2": "8. gaṅgāpeyyālo ",
  "sn48.71-82:0.3": "4. 8. 1-12. pācīnaninnādisuttāni ",
  "sn48.71-82:1.1": "seyyathāpi bhikkhave, gaṅgānadī pācīnaninnā pācīnapoṇā pācīnapabbhārā ",
  "sn48.71-82:1.2": "",
  "sn48.71-82:1.3": "",
  "sn48.71-82:1.4": "",
  "sn48.71-82:1.5": "-pe- ",
  "sn48.71-82:1.6": "",
  "sn48.71-82:1.7": "",
  "sn48.71-82:1.8": "",
  "sn48.71-82:1.9": "nibbānapabbhāroti. ",
  "sn48.71-82:1.10": "(indriyasaṃyuttassa gaṅgāpeyyālo ",
  "sn48.71-82:1.11": "vivekanissitādivasena vitthāretabbo) gaṅgāpeyyāli yi. ",
  "sn48.71-82:2.0": "tatruddānaṃ: ",
  "sn48.71-82:2.1": "cha pācīnato ninnā ",
  "sn48.71-82:2.2": "cha ca ninnā samuddato, ",
  "sn48.71-82:2.3": "ete dve dvādasa honti ",
  "sn48.71-82:2.4": "vaggo tena pavuccatīti. "
}
