  "sn48.25:0.3": "4. 3. 5. suddhakasuttaṃ ",
  "sn48.25:1.1": "chayimāni bhikkhave, indriyāni. ",
  "sn48.25:1.2": "katamāni cha: ",
  "sn48.25:1.3": "cakkhundriyaṃ, sotindriyaṃ, ghānindriyaṃ, jivhindriyaṃ, kāyindriyaṃ, manindriyaṃ. ",
  "sn48.25:1.4": "imāni kho bhikkhave, cha indriyānīti. ",
  "sn48.25:1.5": ""
}
