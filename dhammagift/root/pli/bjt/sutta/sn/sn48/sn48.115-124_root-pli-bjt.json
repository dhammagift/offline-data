{
  "sn48.115-124:0.1": "",
  "sn48.115-124:0.2": "12. oghavaggo ",
  "sn48.115-124:0.3": "4. 12. 1-40. oghādi suttāni ",
  "sn48.115-124:1.1": "cattāro me bhikkhave, oghā. ",
  "sn48.115-124:1.2": "",
  "sn48.115-124:1.3": "",
  "sn48.115-124:1.4": "katame ",
  "sn48.115-124:1.5": "cattāro: ",
  "sn48.115-124:1.6": "",
  "sn48.115-124:1.7": "-pe- bhāvetabbāti. ",
  "sn48.115-124:1.8": "(oghavaggopi vivekanissitādivasena vitthāretabbo.) ",
  "sn48.115-124:1.9": "",
  "sn48.115-124:1.10": "",
  "sn48.115-124:1.11": "oghavaggo dvādasamo. ",
  "sn48.115-124:2.0": "tatruddānaṃ: ",
  "sn48.115-124:2.1": "ogho yogo upādānaṃ ",
  "sn48.115-124:2.2": "gantho anusayena ca, ",
  "sn48.115-124:2.3": "kāmaguṇā nīvaraṇā ",
  "sn48.115-124:2.4": "khandhā oruddhambhāgiyāti. "
}
