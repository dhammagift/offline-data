  "sn48.29:0.1": "",
  "sn48.29:0.2": "",
  "sn48.29:0.3": "4. 3. 9. samaṇabrāhmaṇasuttaṃ ",
  "sn48.29:1.1": "chayimāni bhikkhave, indriyāni. ",
  "sn48.29:1.2": "katamāni cha: ",
  "sn48.29:1.3": "cakkhundriyaṃ -pe- manindriyaṃ. ",
  "sn48.29:1.4": "ye hi keci bhikkhave, samaṇā vā brāhmaṇā vā imesaṃ channaṃ indriyānaṃ samudayañca atthagamañca assādañca ādīnavañca nissaraṇañca yathābhūtaṃ nappajānanti ",
  "sn48.29:1.5": "-pe- ",
  "sn48.29:1.6": "pajānanti ",
  "sn48.29:1.7": "-pe- sayaṃ abhiññā sacchikatvā upasampajja viharantīti. ",
  "sn48.29:1.8": ""
}
