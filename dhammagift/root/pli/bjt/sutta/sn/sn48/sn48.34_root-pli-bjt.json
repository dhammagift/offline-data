  "sn48.34:0.1": "",
  "sn48.34:0.2": "",
  "sn48.34:0.3": "4. 4. 4. samaṇabrāhmaṇasuttaṃ ",
  "sn48.34:1.1": "pañcimāni bhikkhave, indriyāni. ",
  "sn48.34:1.2": "katamāni pañca: ",
  "sn48.34:1.3": "sukhindriyaṃ …pe… upekkhindriyaṃ. ",
  "sn48.34:1.4": "ye hi keci bhikkhave, samaṇā vā brāhmaṇā vā imesaṃ pañcannaṃ indriyānaṃ samudayañca atthagamañca assādañca ādīnavañca nissaraṇañca yathābhūtaṃ nappajānanti ",
  "sn48.34:1.5": "…pe… ",
  "sn48.34:2.1": "pajānanti ",
  "sn48.34:2.2": "…pe… sayaṃ abhiññāsacchikatvā upasampajja viharantīti. ",
  "sn48.34:2.3": ""
}
