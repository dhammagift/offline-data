  "sn24.38:0.1": "",
  "sn24.38:0.2": "",
  "sn24.38:0.3": "3. 2. 20. arūpī attā suttaṃ ",
  "sn24.38:1.1": "sāvatthiyaṃ: ",
  "sn24.38:1.2": "kismiṃ nu kho bhikkhave, sati kiṃ upādāya kiṃ abhinivissa evaṃ diṭṭhi uppajjati ; ",
  "sn24.38:1.3": "“arūpī attā hoti arogo parammaraṇā”ti. (so yeva ",
  "sn24.38:1.4": "peyyālo ",
  "sn24.38:1.5": "vitthāretabbo.) "
}
