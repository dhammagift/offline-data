  "sn24.71:2.12": "",
  "sn24.71:2.13": "viparināmadhammaṃ, kallaṃ nu taṃ samanupassituṃ ",
  "sn24.71:2.14": "“etaṃ mama esohamasmi eso me attā”ti. ",
  "sn24.71:2.15": "no hetaṃ bhante. ",
  "sn24.71:2.16": "vedanā …pe… ",
  "sn24.71:2.17": "saññā …pe… ",
  "sn24.71:2.18": "saṅkhārā …pe… ",
  "sn24.71:2.19": "“viññāṇaṃ niccaṃ vā aniccaṃ vāti. ",
  "sn24.71:2.20": "…pe… ",
  "sn24.71:2.21": "",
  "sn24.71:2.22": "",
  "sn24.71:2.23": "viparināmadhammaṃ, kallaṃ nu taṃ samanupassituṃ : ",
  "sn24.71:2.24": "“etaṃ mama eso’hamasmi eso me attā”ti. ",
  "sn24.71:2.25": "no hetaṃ bhante. ",
  "sn24.71:3.1": "tasmātiha bhikkhave, yaṃ kiñci rūpaṃ atītānāgatapaccuppannaṃ …pe… sammappaññāya daṭṭhabbaṃ. ",
  "sn24.71:3.2": "yā kāci vedanā …pe… ",
  "sn24.71:3.3": "yā kāci saññā …pe… ",
  "sn24.71:3.4": "ye keci saṅkhārā …pe… ",
  "sn24.71:3.5": "yaṃ kiñci viññāṇaṃ atītānāgatapaccuppannaṃ …pe… sammappaññāya daṭṭhabbaṃ. ",
  "sn24.71:4.1": "evaṃ passaṃ bhikkhave …pe… ",
  "sn24.71:4.2": "nāparaṃ itthattāyāti pajānātīti. ",
  "sn24.71:4.3": "(pañcavīsatisuttantā vitthāretabbā) "
}
