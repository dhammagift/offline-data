{
  "sn56.70:0.1": "",
  "sn56.70:0.2": "",
  "sn56.70:0.3": "12. 7. 10. apacāyīsuttaṃ ",
  "sn56.70:1.1": "evameva kho bhikkhave, appakā te sattā ye kulejeṭṭhāpacāyino. atha kho eteva bahutarā sattā ye akulejeṭṭhāpacāyino …pe… ",
  "sn56.70:1.2": "yogo karaṇīyoti. ",
  "sn56.70:1.3": "āmakadhaññapeyyālavaggo sattamo. ",
  "sn56.70:2.0": "tatruddānaṃ: ",
  "sn56.70:2.1": "aññatra paccantaṃ paññā ",
  "sn56.70:2.2": "ca surāmerayodakajā. ",
  "sn56.70:2.3": "matteyya petteyyā ",
  "sn56.70:2.4": "sāmaññaṃ brahmaññapacāyīti. "
}
