  "sn47.85-94:0.3": "",
  "sn47.85-94:1.1": "(atra ca ekasmiṃ cattāro cattāro katvā aṭṭhacattālīsasuttantā vitthāretabbā.) 9. esanāvaggo 3. 9. 1-160. esanādisuttāni tisso imā bhikkhave, esanā. ",
  "sn47.85-94:1.2": "katamā tisso: ",
  "sn47.85-94:1.3": "kāmesanā, bhavesanā, brahmacariyesanā. -pe- bhāvetabboti. ",
  "sn47.85-94:1.4": "(esanāvaggo satipaṭṭhānavasena vitthāretabbo.) ",
  "sn47.85-94:1.5": "esanāvaggo navamo. ",
  "sn47.85-94:2.0": "tatruddānaṃ: ",
  "sn47.85-94:2.1": "esanā vidhā āsavo ",
  "sn47.85-94:2.2": "bhavo dukkhatā ca tisso, ",
  "sn47.85-94:2.3": "khilaṃ malañca nīgho ca ",
  "sn47.85-94:2.4": "vedanātaṇhāhi cāti. "
}
