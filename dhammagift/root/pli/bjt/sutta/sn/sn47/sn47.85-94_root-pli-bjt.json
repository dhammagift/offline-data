{
  "sn47.85-94:0.1": "",
  "sn47.85-94:0.2": "9. esanāvaggo ",
  "sn47.85-94:0.3": "3. 9. 1-160. esanādisuttāni ",
  "sn47.85-94:1.1": "tisso imā bhikkhave, esanā. ",
  "sn47.85-94:1.2": "katamā tisso: ",
  "sn47.85-94:1.3": "kāmesanā, bhavesanā, brahmacariyesanā. …pe… bhāvetabboti. ",
  "sn47.85-94:1.4": "(esanāvaggo satipaṭṭhānavasena vitthāretabbo.) ",
  "sn47.85-94:1.5": "esanāvaggo navamo. tatruddānaṃ: ",
  "sn47.85-94:2.0": "",
  "sn47.85-94:2.1": "esanā vidhā āsavo ",
  "sn47.85-94:2.2": "bhavo dukkhatā ca tisso, ",
  "sn47.85-94:2.3": "khilaṃ malañca nīgho ca ",
  "sn47.85-94:2.4": "vedanātaṇhāhi cāti. (vuttanayena ca tāni abhiññāya pariññāya parikkhayāya pahānāyāti catudhā vibhajantena ca ekekasmiṃ soḷasa soḷasa katvā ekasatasaṭṭhi suttantā vitthāretabbā.) "
}
