{
  "sn47.42:0.1": "",
  "sn47.42:0.2": "",
  "sn47.42:0.3": "3. 5. 2. samudayasuttaṃ ",
  "sn47.42:1.1": "sāvatthiyaṃ: catunnaṃ bhikkhave, satipaṭṭhānānaṃ samudayañca atthagamañca desissāmi. ",
  "sn47.42:1.2": "taṃ suṇātha. ",
  "sn47.42:1.3": "ko ca bhikkhave, kāyassa samudayo. ",
  "sn47.42:1.4": "āhārasamudayā kāyassa samudayo, ",
  "sn47.42:1.5": "āhāranirodhā kāyassa atthagamo. ",
  "sn47.42:1.6": "phassasamudayā vedanānaṃ samudayo. ",
  "sn47.42:1.7": "phassanirodhā vedanānaṃ atthagamo. ",
  "sn47.42:1.8": "nāmarūpasamudayā cittassa samudayo. ",
  "sn47.42:1.9": "nāmarūpanirodhā cittassa atthagamo. ",
  "sn47.42:1.10": "manasikārasamudayā dhammānaṃ samudayo. ",
  "sn47.42:1.11": "manasikāranirodhā dhammānaṃ atthagamoti. ",
  "sn47.42:1.12": ""
}
