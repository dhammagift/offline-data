{
  "sn11.8:0.1": "",
  "sn11.8:0.2": "",
  "sn11.8:0.3": "11. 1. 8. verocanaasurindasuttaṃ ",
  "sn11.8:1.1": "sāvatthiyaṃ– ",
  "sn11.8:1.2": "tena kho pana samayena bhagavā divāvihāragato hoti paṭisallīno. ",
  "sn11.8:1.3": "atha kho sakko ca devānamindo verocano ca asurindo yena bhagavā tenupasaṅkamiṃsu. upasaṅkamitvā paccekaṃ dvārabāhaṃ aṭṭhaṃsu. ",
  "sn11.8:1.4": "atha kho verocano asurindo bhagavato santike imaṃ gāthaṃ abhāsi: ",
  "sn11.8:2.1": "vāyametheva puriso ",
  "sn11.8:2.2": "yāva atthassa nipphadā, ",
  "sn11.8:2.3": "nipphannasobhino atthā ",
  "sn11.8:2.4": "verocanavaco idanti. ",
  "sn11.8:3.1": "[sakko:] vāyametheva puriso ",
  "sn11.8:3.2": "yāva atthassa nipphadā, ",
  "sn11.8:3.3": "nipphannasobhino atthā ",
  "sn11.8:3.4": "khantyā bhiyyo na vijjatīti. ",
  "sn11.8:4.1": "[verācano:] sabbe sattā atthajātā ",
  "sn11.8:4.2": "tattha tattha yathārahaṃ, ",
  "sn11.8:4.3": "saṃyogaparamātveva ",
  "sn11.8:4.4": "sambhogā sabbapāṇinaṃ, ",
  "sn11.8:4.5": "nipphannasobhino atthā ",
  "sn11.8:4.6": "verocanavaco idanti. ",
  "sn11.8:5.1": "[sakko:] sabbe sattā atthajātā ",
  "sn11.8:5.2": "tattha tattha yathārahaṃ, ",
  "sn11.8:5.3": "saṃyogaparamātveva ",
  "sn11.8:5.4": "sambhogā sabbapāṇinaṃ, ",
  "sn11.8:5.5": "nipphannasobhino atthā ",
  "sn11.8:5.6": "khantyā bhiyyo na vijjatīti. "
}
