{
  "sn45.34:0.1": "",
  "sn45.34:0.2": "",
  "sn45.34:0.3": "1. 4. 4. pāraṅgamasuttaṃ ",
  "sn45.34:1.1": "sāvatthiyaṃ: ",
  "sn45.34:1.2": "aṭṭhime bhikkhave, dhammā bhāvitā bahulīkatā apārā pāraṅgamanāya saṃvattanti. ",
  "sn45.34:1.3": "katame aṭṭha: ",
  "sn45.34:1.4": "seyyathidaṃ: sammādiṭṭhi -pe- sammāsamādhi. ",
  "sn45.34:1.5": "ime kho bhikkhave, aṭṭha dhammā bhāvitā bahulīkatā apārā pāraṅgamanāya saṃvattantīti. ",
  "sn45.34:2.1": "idamavoca bhagavā. ",
  "sn45.34:2.2": "idaṃ vatvā sugato athāparaṃ etadavoca satthā: ",
  "sn45.34:3.1": "appakā te manussesu ",
  "sn45.34:3.2": "ye janā pāragāmino, ",
  "sn45.34:3.3": "athāyaṃ itarā pajā ",
  "sn45.34:3.4": "tīramevānudhāvati. ",
  "sn45.34:4.1": "ye ca kho sammadakkhāte ",
  "sn45.34:4.2": "dhamme dhammānuvattino, ",
  "sn45.34:4.3": "te janā pāramessanti ",
  "sn45.34:4.4": "maccudheyyaṃ suduttaraṃ. ",
  "sn45.34:5.1": "kaṇhaṃ dhammaṃ vippahāya ",
  "sn45.34:5.2": "sukkaṃ bhāvetha paṇḍito, ",
  "sn45.34:5.3": "okā anokaṃ āgamma ",
  "sn45.34:5.4": "viveke yattha dūramaṃ. 4. ",
  "sn45.34:6.1": "tatrābhiratimiccheyya ",
  "sn45.34:6.2": "hitvā kāme akiñcano, ",
  "sn45.34:6.3": "pariyodapeyya attānaṃ ",
  "sn45.34:6.4": "cittaklesehi paṇḍito. ",
  "sn45.34:7.1": "yesaṃ sambodhiaṅgesu ",
  "sn45.34:7.2": "sammā cittaṃ subhāvitaṃ, ",
  "sn45.34:7.3": "ādānapaṭinissagge ",
  "sn45.34:7.4": "anupādāya ye ratā ",
  "sn45.34:7.5": "khīṇāsavā jutimanto ",
  "sn45.34:7.6": "te loke parinibbutāti. ",
  "sn45.34:7.7": ""
}
