{
  "sn45.37:0.1": "",
  "sn45.37:0.2": "",
  "sn45.37:0.3": "1. 4. 7. brahmaññasuttaṃ ",
  "sn45.37:1.1": "",
  "sn45.37:1.2": "brahmaññañca vo bhikkhave, desissāmi, brahmaññaphalāni ca. ",
  "sn45.37:1.3": "taṃ suṇātha. ",
  "sn45.37:1.4": "katamañca bhikkhave, brahmaññaṃ: ",
  "sn45.37:1.5": "ayameva ariyo aṭṭhaṅgiko maggo. seyyathidaṃ: ",
  "sn45.37:1.6": "sammādiṭṭhi -pe- sammāsamādhi. ",
  "sn45.37:1.7": "idaṃ vuccati bhikkhave, brahmaññaṃ. ",
  "sn45.37:1.8": "katamāni ca bhikkhave, brahmaññaphalāni: ",
  "sn45.37:1.9": "sotāpattiphalaṃ sakadāgāmiphalaṃ anāgāmiphalaṃ arahattaphalaṃ. ",
  "sn45.37:1.10": "imāni vuccanti bhikkhave, brahmaññaphalānīti. ",
  "sn45.37:1.11": ""
}
