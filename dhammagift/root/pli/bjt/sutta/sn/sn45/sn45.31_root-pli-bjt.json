{
  "sn45.31:0.1": "",
  "sn45.31:0.2": "4. paṭipattivaggo ",
  "sn45.31:0.3": "1. 4. 1. paṭipattisuttaṃ ",
  "sn45.31:1.1": "sāvatthiyaṃ: ",
  "sn45.31:1.2": "micchāpaṭipattiñca vo bhikkhave, desissāmi sammāpaṭipattiñca. ",
  "sn45.31:1.3": "taṃ suṇātha. ",
  "sn45.31:1.4": "katamā ca bhikkhave, micchāpaṭipatti, ",
  "sn45.31:1.5": "seyyathidaṃ: micchādiṭṭhi -pe- micchāsamādhi. ",
  "sn45.31:1.6": "ayaṃ vuccati bhikkhave, micchāpaṭipatti. ",
  "sn45.31:1.7": "katamā ca, bhikkhave sammāpaṭipatti, ",
  "sn45.31:1.8": "seyyathidaṃ: sammādiṭṭhi -pe- sammāsamādhi. ",
  "sn45.31:1.9": "ayaṃ vuccati bhikkhave, sammāpaṭipattīti. ",
  "sn45.31:1.10": ""
}
