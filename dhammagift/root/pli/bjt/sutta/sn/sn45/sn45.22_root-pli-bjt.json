{
  "sn45.22:0.1": "",
  "sn45.22:0.2": "",
  "sn45.22:0.3": "1. 3. 2. akusaladhammasuttaṃ ",
  "sn45.22:1.1": "sāvatthiyaṃ: ",
  "sn45.22:1.2": "akusale ca vo bhikkhave, dhamme desissāmi, kusale ca dhamme. ",
  "sn45.22:1.3": "taṃ suṇātha. ",
  "sn45.22:1.4": "katame ca bhikkhave, akusalā dhammā, ",
  "sn45.22:1.5": "seyyathidaṃ: micchādiṭṭhi -pe- micchāsamādhi. ",
  "sn45.22:1.6": "ime vuccanti bhikkhave, akusalā dhammā. ",
  "sn45.22:1.7": "katame ca bhikkhave, kusalā dhammā, ",
  "sn45.22:1.8": "seyyathidaṃ: sammādiṭṭhi -pe- sammāsamādhi. ",
  "sn45.22:1.9": "idaṃ vuccanti bhikkhave, kusalā dhammāti. ",
  "sn45.22:1.10": ""
}
