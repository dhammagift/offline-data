{
  "sn45.32:0.1": "",
  "sn45.32:0.2": "",
  "sn45.32:0.3": "1. 4. 2. paṭipannasuttaṃ ",
  "sn45.32:1.1": "sāvatthiyaṃ: ",
  "sn45.32:1.2": "micchāpaṭipannañca vo bhikkhave, desissāmi sammāpaṭipannañca. ",
  "sn45.32:1.3": "taṃ suṇātha. ",
  "sn45.32:1.4": "katamo ca bhikkhave, micchāpaṭipanno: ",
  "sn45.32:1.5": "idha bhikkhave, ekacco micchādiṭṭhiko hoti …pe… micchāsamādhi. ",
  "sn45.32:1.6": "ayaṃ vuccati bhikkhave, micchāpaṭipanno. ",
  "sn45.32:1.7": "katamo ca bhikkhave, sammāpaṭipanno: ",
  "sn45.32:1.8": "idha bhikkhave, ekacco sammādiṭṭhiko hoti …pe… sammāsamādhi. ",
  "sn45.32:1.9": "ayaṃ vuccati bhikkhave, sammāpaṭipannoti. ",
  "sn45.32:1.10": ""
}
