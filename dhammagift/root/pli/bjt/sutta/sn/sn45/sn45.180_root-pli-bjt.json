{
  "sn45.180:0.1": "",
  "sn45.180:0.2": "",
  "sn45.180:0.3": "1. 16. 145-160. uddhambhāgiyasaṃyojanasuttāni ",
  "sn45.180:1.1": "pañcimāni bhikkhave, uddhambhāgiyāni saṃyojanāni. ",
  "sn45.180:1.2": "katamāni pañca: ",
  "sn45.180:1.3": "rūparāgo arūparāgo māno uddhaccaṃ avijjā. ",
  "sn45.180:1.4": "imāni kho bhikkhave, pañcuddhambhāgiyāni saṃyojanāni. ",
  "sn45.180:1.5": "imesaṃ kho bhikkhave, pañcannaṃ uddhambhāgiyānaṃ saṃyojanānaṃ abhiññāya ",
  "sn45.180:1.6": "",
  "sn45.180:1.7": "-pe- ",
  "sn45.180:1.8": "pariññāya -pe- parikkhayāya -pe- ",
  "sn45.180:2.1": "",
  "sn45.180:2.2": "",
  "sn45.180:2.3": "",
  "sn45.180:2.4": "",
  "sn45.180:2.5": "pahānāya ariyo aṭṭhaṅgiko maggo bhāvetabbo. ",
  "sn45.180:2.6": "katamo ariyo aṭṭhaṅgiko maggo: ",
  "sn45.180:2.7": "idha bhikkhave, bhikkhu sammādiṭṭhiṃ bhāveti -pe- sammāsamādhiṃ bhāveti. vivekanissitaṃ virāganissitaṃ ",
  "sn45.180:2.8": "nirodhanissitaṃ ",
  "sn45.180:2.9": "vossaggapariṇāmiṃ. ",
  "sn45.180:2.10": "imesaṃ kho bhikkhave, pañcannaṃ uddhambhāgiyānaṃ saṃyojanānaṃ abhiññāya -pe- pariññāya -pe- parikkhayāya -pe- pahānāya ayaṃ ariyo aṭṭhaṅgiko maggo bhāvetabboti. ",
  "sn45.180:2.11": "(yathā esanā suttantā tathā sabbesu peyyālesu soḷasa soḷasa suttantā vitthāretabbā.) ",
  "sn45.180:2.12": "oghavaggo soḷasamo. ",
  "sn45.180:3.0": "tatruddānaṃ: ",
  "sn45.180:3.1": "oghā yogo upādānā ",
  "sn45.180:3.2": "ganthā anusayāpi ca ",
  "sn45.180:3.3": "kāmaguṇa nīvaraṇā ",
  "sn45.180:3.4": "khandhā oruddhambhāgiyāti. ",
  "sn45.180:4.0": "maggasaṃyuttaṃ samattaṃ. tatra vagguddānaṃ: ",
  "sn45.180:4.1": "avijjāvaggo paṭhamo ",
  "sn45.180:4.2": "dutiyo vihāro vuccati. ",
  "sn45.180:4.3": "micchattavaggo tatiyo catuttho ",
  "sn45.180:4.4": "paṭipapatti ca. ",
  "sn45.180:5.1": "aññatitthiyo pañcamo ",
  "sn45.180:5.2": "chaṭṭho suriyapeyyālo, ekadhammā duve gaṅgā peyyālāpi cattāro. appamādo teḷasamo balavaggo ca ",
  "sn45.180:5.3": "cuddaso, ",
  "sn45.180:5.4": "",
  "sn45.180:6.1": "",
  "sn45.180:6.2": "",
  "sn45.180:6.3": "",
  "sn45.180:6.4": "esanā paṇṇarasamo ",
  "sn45.180:6.5": "oghavaggo soḷasamoti. ",
  "sn45.180:6.6": ""
}
