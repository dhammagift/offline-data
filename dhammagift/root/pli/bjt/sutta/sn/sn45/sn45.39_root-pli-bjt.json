{
  "sn45.39:0.1": "",
  "sn45.39:0.2": "",
  "sn45.39:0.3": "1. 4. 9. brahmacariyasuttaṃ ",
  "sn45.39:1.1": "",
  "sn45.39:1.2": "brahmacariyañca vo bhikkhave, desissāmi brahmacariyaphalāni ca. ",
  "sn45.39:1.3": "taṃ suṇātha. ",
  "sn45.39:1.4": "katamañca bhikkhave, brahmacariyaṃ: ",
  "sn45.39:1.5": "ayameva ariyo aṭṭhaṅgiko maggo. seyyathidaṃ: ",
  "sn45.39:1.6": "sammādiṭṭhi -pe- sammāsamādhi. ",
  "sn45.39:1.7": "idaṃ vuccati bhikkhave, brahmacariyaṃ. ",
  "sn45.39:1.8": "katamāni ca bhikkhave, brahmacariyaphalāni: ",
  "sn45.39:1.9": "sotāpattiphalaṃ sakadāgāmiphalaṃ anāgāmiphalaṃ arahattaphalaṃ. ",
  "sn45.39:1.10": "imāni vuccanti bhikkhave, brahmacariyaphalānīti. ",
  "sn45.39:1.11": ""
}
