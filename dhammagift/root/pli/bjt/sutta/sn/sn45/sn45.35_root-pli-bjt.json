{
  "sn45.35:0.1": "",
  "sn45.35:0.2": "",
  "sn45.35:0.3": "1. 4. 5. sāmaññasuttaṃ ",
  "sn45.35:1.1": "",
  "sn45.35:1.2": "sāmaññañca vo bhikkhave, desissāmi sāmaññaphalāni ca. ",
  "sn45.35:1.3": "taṃ suṇātha. ",
  "sn45.35:1.4": "katamañca bhikkhave, sāmaññaṃ: ",
  "sn45.35:1.5": "ayameva ariyo aṭṭhaṅgiko maggo. seyyathidaṃ: ",
  "sn45.35:1.6": "sammādiṭṭhi -pe- sammāsamādhi. ",
  "sn45.35:1.7": "idaṃ vuccati bhikkhave, sāmaññaṃ. ",
  "sn45.35:1.8": "katamāni ca bhikkhave, sāmaññaphalāni: ",
  "sn45.35:1.9": "sotāpattiphalaṃ sakadāgāmiphalaṃ anāgāmiphalaṃ arahattaphalaṃ ",
  "sn45.35:1.10": "imāni vuccanti bhikkhave, sāmaññaphalānīti. ",
  "sn45.35:1.11": ""
}
