{
  "sn45.36:0.1": "",
  "sn45.36:0.2": "",
  "sn45.36:0.3": "1. 4. 6. dutiya sāmaññasuttaṃ ",
  "sn45.36:1.1": "",
  "sn45.36:1.2": "sāmaññañca vo bhikkhave, desissāmi sāmaññatthañca. ",
  "sn45.36:1.3": "taṃ suṇātha. ",
  "sn45.36:1.4": "katamañca bhikkhave, sāmaññaṃ: ",
  "sn45.36:1.5": "ayameva ariyo aṭṭhaṅgiko maggo. seyyathidaṃ: ",
  "sn45.36:1.6": "sammādiṭṭhi -pe- sammāsamādhi. ",
  "sn45.36:1.7": "idaṃ vuccati bhikkhave, sāmaññaṃ. ",
  "sn45.36:1.8": "katamo ca bhikkhave, sāmaññattho: ",
  "sn45.36:1.9": "yo kho bhikkhave, rāgakkhayo dosakkhayo mohakkhayo. ",
  "sn45.36:1.10": "ayaṃ vuccati bhikkhave, sāmaññatthoti. ",
  "sn45.36:1.11": ""
}
