{
  "sn45.23:0.1": "",
  "sn45.23:0.2": "",
  "sn45.23:0.3": "1. 3. 3. paṭipadāsuttaṃ ",
  "sn45.23:1.1": "sāvatthiyaṃ: ",
  "sn45.23:1.2": "micchāpaṭipadañca vo bhikkhave, desissāmi sammāpaṭipadañca. ",
  "sn45.23:1.3": "taṃ suṇātha. ",
  "sn45.23:1.4": "katamā ca bhikkhave, micchāpaṭipadā, ",
  "sn45.23:1.5": "seyyathidaṃ: micchādiṭṭhi -pe- micchāsamādhi. ",
  "sn45.23:1.6": "ayaṃ vuccati bhikkhave, micchāpaṭipadā. ",
  "sn45.23:1.7": "katamā ca bhikkhave, sammāpaṭipadā, ",
  "sn45.23:1.8": "seyyathidaṃ: sammādiṭṭhi -pe- sammāsamādhi. ",
  "sn45.23:1.9": "ayaṃ vuccati bhikkhave, sammāpaṭipadāti. ",
  "sn45.23:1.10": ""
}
