  "sn46.66:0.3": "2. 7. 55-60. ānāpānasatisuttāni ",
  "sn46.66:1.1": "ānāpānasati bhikkhave -pe- ",
  "sn46.66:1.2": "saṃvattatīti. ",
  "sn46.66:1.3": "ānāpānavaggo sattamo. ",
  "sn46.66:2.0": "tassuddānaṃ: ",
  "sn46.66:2.1": "aṭṭhi puḷava ",
  "sn46.66:2.2": "vinīla vicchiddakoddhumātakā ",
  "sn46.66:2.3": "mettā karuṇā muditopekhānāpānena ",
  "sn46.66:2.4": "cāti. "
}
