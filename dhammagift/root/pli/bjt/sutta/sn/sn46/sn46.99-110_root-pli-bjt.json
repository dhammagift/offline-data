{
  "sn46.99-110:0.1": "",
  "sn46.99-110:0.2": "11. balakaraṇīyavaggo ",
  "sn46.99-110:0.3": "2. 11. 1-12. balādisuttāni ",
  "sn46.99-110:1.1": "seyyathāpi bhikkhave, ye keci balakaraṇīyā kammantā kārīyanti …pe… bahulīkarotīti. (bojjhaṅgavasena dvādasasuttā vitthāretabbā). ",
  "sn46.99-110:1.2": "balakaraṇīyavaggo ekādasamo. tatruddānaṃ: ",
  "sn46.99-110:2.0": "",
  "sn46.99-110:2.1": "balaṃ bījañca nāgo ca ",
  "sn46.99-110:2.2": "rukkhaṃ kumbhena sūkena ",
  "sn46.99-110:2.3": "ākāsena ca dve meghā ",
  "sn46.99-110:2.4": "nāvā āgantukā nadīti. ",
  "sn46.99-110:3.1": ""
}
