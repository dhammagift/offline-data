  "sn46.143-152:0.1": "",
  "sn46.143-152:0.2": "15. puna appamādavaggo ",
  "sn46.143-152:0.3": "2. 15. 1-30. tathāgatādisuttāni ",
  "sn46.143-152:1.1": "(rāgavinayādivasena vitthāretabbāni) puna appamādavaggo ",
  "sn46.143-152:1.2": "paṇṇarasamo. ",
  "sn46.143-152:2.0": "tatruddānaṃ: ",
  "sn46.143-152:2.1": "tathāgataṃ padaṃ kūṭaṃ ",
  "sn46.143-152:2.2": "mūlaṃ sārena vassitaṃ ",
  "sn46.143-152:2.3": "rājā candimasūriyā ca ",
  "sn46.143-152:2.4": "vatthena dasamaṃ padanti. ",
  "sn46.143-152:3.1": ""
}
