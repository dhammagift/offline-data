  "sn46.153-164:0.2": "16. punabalakaraṇīyavaggo ",
  "sn46.153-164:0.3": "2. 16. 1-36. balādisuttāni ",
  "sn46.153-164:1.1": "(rāgavinayādivasena vitthāretabbāni) punabalakaraṇīyavaggo ",
  "sn46.153-164:1.2": "soḷasamo. ",
  "sn46.153-164:2.0": "tatruddānaṃ: ",
  "sn46.153-164:2.1": "balaṃ bījañca nāgo ca ",
  "sn46.153-164:2.2": "rukkhaṃ kumbhena sūkena ",
  "sn46.153-164:2.3": "ākāsena dve meghā ",
  "sn46.153-164:2.4": "nāvā āgantukā nadīti. ",
  "sn46.153-164:3.1": ""
}
