  "sn46.89-98:0.1": "",
  "sn46.89-98:0.2": "10. appamādavaggo ",
  "sn46.89-98:0.3": "2. 10. 1-10. tathāgatādi suttāni ",
  "sn46.89-98:1.1": "yāvatā bhikkhave, sattā apadā vā dvipadā vā catuppadā vā bahuppadā vā …pe… bahulīkarotīti. (bojjhaṅgavasena dasa suttantāni vitthāretabbāni) ",
  "sn46.89-98:1.2": "appamādavaggo dasamo. tatruddānaṃ: ",
  "sn46.89-98:2.0": "",
  "sn46.89-98:2.1": "tathāgataṃ padaṃ kūṭaṃ ",
  "sn46.89-98:2.2": "mūlaṃ sārena vassitaṃ ",
  "sn46.89-98:2.3": "rājā candimasūriyā ca ",
  "sn46.89-98:2.4": "vatthena dasamaṃ padanti. ",
  "sn46.89-98:3.1": ""
}
