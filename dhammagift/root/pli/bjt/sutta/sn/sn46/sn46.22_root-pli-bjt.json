  "sn46.22:0.1": "",
  "sn46.22:0.2": "",
  "sn46.22:0.3": "2. 3. 2. desanāsuttaṃ ",
  "sn46.22:1.1": "sattime bhikkhave, bojjhaṅge desissāmi, ",
  "sn46.22:1.2": "taṃ suṇātha. ",
  "sn46.22:1.3": "katame ca bhikkhave, sattabojjhaṅgā: ",
  "sn46.22:1.4": "satisambojjhaṅgo …pe… upekhāsambojjhaṅgo. ",
  "sn46.22:1.5": "ime kho bhikkhave, satta bojjhaṅgāti. ",
  "sn46.22:1.6": ""
}
