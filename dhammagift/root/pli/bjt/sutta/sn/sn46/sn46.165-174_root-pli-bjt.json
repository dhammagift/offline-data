{
  "sn46.165-174:0.1": "",
  "sn46.165-174:0.2": "17. puna esanā vaggo ",
  "sn46.165-174:0.3": "2. 17. 1-120. esanādisuttāni ",
  "sn46.165-174:1.1": "(rāgavinayādivasena vitthāretabbāni) ",
  "sn46.165-174:1.2": "punaesanāvaggo sattarasamo. ",
  "sn46.165-174:2.0": "tatruddānaṃ: ",
  "sn46.165-174:2.1": "esanā vidhā āsavo ",
  "sn46.165-174:2.2": "bhavo ca dukkhatā tisso, ",
  "sn46.165-174:2.3": "khilaṃ malañca nīgho ca ",
  "sn46.165-174:2.4": "vedanā taṇhāti te dasāti. "
}
