{
  "sn46.111-120:0.1": "",
  "sn46.111-120:0.2": "12. esanāvaggo ",
  "sn46.111-120:0.3": "2. 12. 1-40. esanādisuttāni ",
  "sn46.111-120:1.1": "tisso imā bhikkhave, esanā. ",
  "sn46.111-120:1.2": "katamā tisso: ",
  "sn46.111-120:1.3": "kāmesanā, bhavesanā, brahmacariyesanā -pe- bhāvetabboti. (maggasaṃyuttassa esanāvaggo viya vitthāretabbo) ",
  "sn46.111-120:1.4": "esanāvaggo dvādasamo. ",
  "sn46.111-120:2.0": "tatruddānaṃ: ",
  "sn46.111-120:2.1": "esanā vidhā āsavo ",
  "sn46.111-120:2.2": "bhavo ca dukkhatā tisso ",
  "sn46.111-120:2.3": "khilaṃ malañca nīgho ca ",
  "sn46.111-120:2.4": "vedanā taṇhāti ",
  "sn46.111-120:3.1": "tedasāti. "
}
