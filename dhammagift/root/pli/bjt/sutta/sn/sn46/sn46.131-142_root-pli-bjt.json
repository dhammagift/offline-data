  "sn46.131-142:0.2": "14. puna gaṅgāpeyyālo ",
  "sn46.131-142:0.3": "2. 14. 1-36. gaṅgādisuttāni ",
  "sn46.131-142:1.1": "837-872 (rāgavinaya amatogadha nibbānaninnādivasena vitthāretabbāni) ",
  "sn46.131-142:1.2": "punagaṅgāpeyyālo cuddasamo. ",
  "sn46.131-142:2.0": "tatruddānaṃ: ",
  "sn46.131-142:2.1": "cha pācīnato ninnā ",
  "sn46.131-142:2.2": "cha ca ninnā samuddato ",
  "sn46.131-142:2.3": "ete dve dvādasa honti ",
  "sn46.131-142:2.4": "vaggo tena pavuccatīti. ",
  "sn46.131-142:3.1": "15. puna appamādavaggo 2. 15. 1-30. tathāgatādisuttāni (rāgavinayādivasena vitthāretabbāni) "
}
