{
  "sn9.2:0.1": "",
  "sn9.2:0.2": "",
  "sn9.2:0.3": "9. 1. 2. upaṭṭhānasuttaṃ ",
  "sn9.2:1.1": "ekaṃ samayaṃ aññataro bhikkhu kosalesu viharati aññatarasmiṃ vanasaṇḍe. ",
  "sn9.2:1.2": "tena kho pana samayena so bhikkhu divāvihāragato supati. ",
  "sn9.2:1.3": "atha kho yā tasmiṃ vanasaṇḍe adhivatthā devatā tassa bhikkhuno anukampikā atthakāmā taṃ bhikkhuṃ saṃvejetukāmā yena so bhikkhu tenupasaṅkami. upasaṅkamitvā taṃ bhikkhuṃ gāthāhi ajjhabhāsi: ",
  "sn9.2:2.1": "uṭṭhehi bhikkhu kiṃ sesi ",
  "sn9.2:2.2": "ko attho supinena te, ",
  "sn9.2:2.3": "āturassa hi kā niddā ",
  "sn9.2:2.4": "sallaviddhassa ruppato. ",
  "sn9.2:3.1": "yāya saddhā pabbajito ",
  "sn9.2:3.2": "agārasmānagāriyaṃ, ",
  "sn9.2:3.3": "tameva saddhaṃ brūhehi ",
  "sn9.2:3.4": "mā niddāya vasaṅgamīti. ",
  "sn9.2:4.1": "aniccā addhuvā kāmā ",
  "sn9.2:4.2": "yesu mando’va mucchito, ",
  "sn9.2:4.3": "khandhesu muttaṃ asitaṃ ",
  "sn9.2:4.4": "kasmā pabbajitaṃ tape. ",
  "sn9.2:5.1": "chandarāgassa vinayā ",
  "sn9.2:5.2": "avijjāsamatikkamā, ",
  "sn9.2:5.3": "taññāṇaṃ paramavodānaṃ ",
  "sn9.2:5.4": "kasmā pabbajitaṃ tape. ",
  "sn9.2:6.1": "bhetvā avijjaṃ vijjāya ",
  "sn9.2:6.2": "āsavānaṃ parikkhayā, ",
  "sn9.2:6.3": "asokaṃ anupāyāsaṃ ",
  "sn9.2:6.4": "kasmā pabbajitaṃ tape. ",
  "sn9.2:7.1": "āraddhaviriyaṃ pahitattaṃ ",
  "sn9.2:7.2": "niccaṃ daḷhaparakkamaṃ, ",
  "sn9.2:7.3": "nibbānaṃ abhikaṅkhantaṃ ",
  "sn9.2:7.4": "kasmā pabbajitaṃ tapeti. "
}
