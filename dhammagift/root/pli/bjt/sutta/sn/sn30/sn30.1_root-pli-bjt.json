{
  "sn30.1:0.1": "9. supaṇṇa saṃyuttaṃ ",
  "sn30.1:0.2": "1. supaṇṇa vaggo ",
  "sn30.1:0.3": "9. 1. 1. suddhika suttaṃ ",
  "sn30.1:1.1": "sāvatthiyaṃ: ",
  "sn30.1:1.2": "catasso imā bhikkhave, supaṇṇayoniyo, ",
  "sn30.1:1.3": "katamā catasso: ",
  "sn30.1:1.4": "aṇḍajā supaṇṇā jalābujā supaṇṇā saṃsedajā supaṇṇā opapātikā supaṇṇā. ",
  "sn30.1:1.5": "imā kho bhikkhave, catasso supaṇṇayoniyoti. ",
  "sn30.1:1.6": ""
}
