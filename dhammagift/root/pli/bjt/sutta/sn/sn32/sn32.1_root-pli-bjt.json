{
  "sn32.1:0.1": "11. valāhakasaṃyuttaṃ ",
  "sn32.1:0.2": "1. valāhakavaggo ",
  "sn32.1:0.3": "11. 1. 1. suddhika suttaṃ ",
  "sn32.1:1.1": "sāvatthiyaṃ: ",
  "sn32.1:1.2": "valāhakakāyike vo bhikkhave, deve desissāmi. ",
  "sn32.1:1.3": "taṃ suṇātha. ",
  "sn32.1:1.4": "katame ca bhikkhave, valāhakakāyikā devā: ",
  "sn32.1:1.5": "santi bhikkhave, sītavalāhakā devā. ",
  "sn32.1:1.6": "santi bhikkhave, uṇhavalāhakā devā. ",
  "sn32.1:1.7": "santi bhikkhave, abbhavalāhakā devā. ",
  "sn32.1:1.8": "santi bhikkhave, vātavalāhakā devā. ",
  "sn32.1:1.9": "santi bhikkhave, vassavalāhakā devā. ",
  "sn32.1:1.10": "ime vuccanti bhikkhave, valāhakakāyikā devā. ",
  "sn32.1:1.11": ""
}
