{
  "sn12.43:0.1": "",
  "sn12.43:0.2": "",
  "sn12.43:0.3": "1. 5. 3. dukkhasuttaṃ ",
  "sn12.43:1.1": "sāvatthiyaṃ– ",
  "sn12.43:1.2": "dukkhassa bhikkhave, samudayañca atthaṅgamañca desissāmi. ",
  "sn12.43:1.3": "taṃ suṇātha …pe… ",
  "sn12.43:1.4": "",
  "sn12.43:1.5": "",
  "sn12.43:2.1": "katamo ca bhikkhave dukkhassa samudayo? ",
  "sn12.43:2.2": "cakkhuñca paṭicca rūpe ca uppajjati cakkhuviññāṇaṃ. tiṇṇaṃ saṅgati phasso. ",
  "sn12.43:2.3": "phassapaccayā vedanā. ",
  "sn12.43:2.4": "vedanāpaccayā taṇhā. ",
  "sn12.43:2.5": "ayaṃ kho bhikkhave dukkhassa samudayo. ",
  "sn12.43:3.1": "sotañca paṭicca sadde ca …pe… ",
  "sn12.43:3.2": "ghānañca paṭicca gandhe ca …pe… ",
  "sn12.43:3.3": "jivhañca paṭicca rase ca …pe… ",
  "sn12.43:3.4": "kāyañca paṭicca phoṭṭhabbe ca …pe… ",
  "sn12.43:3.5": "manañca paṭicca dhamme ca uppajjati manoviññāṇaṃ. tiṇṇaṃ saṅgati phasso. ",
  "sn12.43:3.6": "phassapaccayā vedanā. ",
  "sn12.43:3.7": "vedanāpaccayā taṇhā. ",
  "sn12.43:3.8": "ayaṃ kho bhikkhave dukkhassa samudayo. ",
  "sn12.43:4.1": "katamo ca bhikkhave, dukkhassa atthaṅgamo? ",
  "sn12.43:4.2": "cakkhuñca paṭicca rūpe ca uppajjati cakkhuviññāṇaṃ. tiṇṇaṃ saṅgati phasso. ",
  "sn12.43:4.3": "phassapaccayā vedanā. ",
  "sn12.43:4.4": "vedanāpaccayā taṇhā. ",
  "sn12.43:4.5": "tassāyeva taṇhāya asesavirāganirodhā upādānanirodho. ",
  "sn12.43:4.6": "upādānanirodhā bhavanirodho. ",
  "sn12.43:4.7": "bhavanirodhā jātinirodho. ",
  "sn12.43:4.8": "jātinirodhā jarāmaraṇaṃ sokaparidevadukkhadomanassupāyāsā nirujjhanti. ",
  "sn12.43:4.9": "evametassa kevalassa dukkhakkhandhassa nirodho hoti. ",
  "sn12.43:4.10": "ayaṃ kho bhikkhave dukkhassa atthaṅgamo. ",
  "sn12.43:5.1": "sotañca paṭicca sadde ca uppajjati sotaviññāṇaṃ …pe… ",
  "sn12.43:5.2": "ghānañca paṭicca gandhe ca uppajjati ghānaviññāṇaṃ …pe… ",
  "sn12.43:5.3": "jivhañca paṭicca rase ca …pe… ",
  "sn12.43:5.4": "kāyañca paṭicca phoṭṭhabbe ca …pe… ",
  "sn12.43:5.5": "manañca paṭicca dhamme ca uppajjati mano viññāṇaṃ. tiṇṇaṃ saṅgati phasso. ",
  "sn12.43:5.6": "phassapaccayā vedanā ",
  "sn12.43:5.7": "vedanāpaccayā taṇhā. ",
  "sn12.43:5.8": "tassāyeva taṇhāya asesavirāganirodhā upādānanirodho. ",
  "sn12.43:5.9": "upādānanirodhā bhavanirodho. ",
  "sn12.43:5.10": "bhavanirodhā jātinirodho. ",
  "sn12.43:5.11": "jātinirodhā jarāmaraṇaṃ sokaparidevadukkhadomanassupāyāsā nirujjhanti. ",
  "sn12.43:5.12": "evametassa kevalassa dukkhakkhandhassa nirodho hoti. ",
  "sn12.43:5.13": "ayaṃ kho bhikkhave, dukkhassa atthaṅgamoti. ",
  "sn12.43:5.14": ""
}
