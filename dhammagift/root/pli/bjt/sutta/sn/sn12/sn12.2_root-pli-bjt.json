{
  "sn12.2:0.1": "",
  "sn12.2:0.2": "",
  "sn12.2:0.3": "1. 1. 2. vibhaṅgasuttaṃ ",
  "sn12.2:1.1": "sāvatthiyaṃ– ",
  "sn12.2:1.2": "paṭiccasamuppādaṃ vo bhikkhave, desissāmi. vibhajissāmi. ",
  "sn12.2:1.3": "taṃ suṇātha. sādhukaṃ manasi karotha. bhāsissāmīti. ",
  "sn12.2:1.4": "evaṃ bhanteti kho te bhikkhū bhagavato paccassosuṃ. ",
  "sn12.2:1.5": "bhagavā etadavoca: ",
  "sn12.2:2.1": "katamo ca bhikkhave, paṭiccasamuppādo? ",
  "sn12.2:2.2": "avijjāpaccayā bhikkhave, saṅkhārā. ",
  "sn12.2:2.3": "saṅkhārapaccayā viññāṇaṃ. ",
  "sn12.2:2.4": "viññāṇapaccayā nāmarūpaṃ. ",
  "sn12.2:2.5": "nāmarūpapaccayā saḷāyatanaṃ. ",
  "sn12.2:2.6": "saḷāyatanapaccayā phasso. ",
  "sn12.2:2.7": "phassapaccayā vedanā. ",
  "sn12.2:2.8": "vedanāpaccayā taṇhā. ",
  "sn12.2:2.9": "taṇhāpaccayā upādānaṃ. ",
  "sn12.2:2.10": "upādānapaccayā bhavo. ",
  "sn12.2:2.11": "bhavapaccayā jāti. ",
  "sn12.2:2.12": "jātipaccayā jarāmaraṇaṃ, sokaparidevadukkhadomanassupāyāsā sambhavanti. ",
  "sn12.2:2.13": "evametassa kevalassa dukkhakkhandhassa samudayo hoti. ",
  "sn12.2:3.1": "katamañca bhikkhave, jarāmaraṇaṃ? ",
  "sn12.2:3.2": "yā tesaṃ tesaṃ sattānaṃ tamhi tamhi sattanikāye jarā jīraṇatā khaṇḍiccaṃ pāliccaṃ valittacatā āyuno saṃhāni indriyānaṃ paripāko, ",
  "sn12.2:3.3": "ayaṃ vuccati jarā. katamañca bhikkhave, maraṇaṃ? ",
  "sn12.2:3.4": "yā tesaṃ tesaṃ sattānaṃ tamhā tamhā sattanikāyā cuti cavanatā bhedo antaradhānaṃ maccumaraṇaṃ kālakiriyā khandhānaṃ bhedo kalebarassa nikkhepo jīvitindriyassa upacchedo. ",
  "sn12.2:3.5": "idaṃ vuccati maraṇaṃ. ",
  "sn12.2:3.6": "iti ayañca jarā idañca maraṇaṃ, ",
  "sn12.2:3.7": "idaṃ vuccati bhikkhave, jarāmaraṇaṃ. ",
  "sn12.2:4.1": "katamā ca bhikkhave, jāti? ",
  "sn12.2:4.2": "yā tesaṃ tesaṃ sattānaṃ tamhi tamhi sattanikāye jāti sañjāti okkanti nibbatti abhinibbatti khandhānaṃ pātubhāvo āyatanānaṃ paṭilābho. ",
  "sn12.2:4.3": "ayaṃ vuccati bhikkhave, jāti. ",
  "sn12.2:5.1": "katamo ca bhikkhave, bhavo? ",
  "sn12.2:5.2": "tayome bhikkhave, bhavā: ",
  "sn12.2:5.3": "kāmabhavo rūpabhavo arūpabhavo. ",
  "sn12.2:5.4": "ayaṃ vuccati bhikkhave, bhavo. ",
  "sn12.2:6.1": "katamañca bhikkhave upādānaṃ? ",
  "sn12.2:6.2": "cattārimāni bhikkhave, upādānāni: ",
  "sn12.2:6.3": "kāmupādānaṃ diṭṭhupādānaṃ sīlabbatūpādānaṃ attavādūpādānaṃ. ",
  "sn12.2:6.4": "idaṃ vuccati bhikkhave, upādānaṃ. ",
  "sn12.2:7.1": "katamā ca bhikkhave taṇhā? ",
  "sn12.2:7.2": "chayime bhikkhave, taṇhākāyā: ",
  "sn12.2:7.3": "rūpataṇhā saddataṇhā gandhataṇhā rasataṇhā phoṭṭhabbataṇhā dhammataṇhā. ",
  "sn12.2:7.4": "ayaṃ vuccati bhikkhave taṇhā. ",
  "sn12.2:8.1": "katamā ca bhikkhave vedanā? ",
  "sn12.2:8.2": "chayime bhikkhave, vedanākāyā: ",
  "sn12.2:8.3": "cakkhusamphassajā vedanā, sotasamphassajā vedanā, ghānasamphassajā vedanā, jivhāsamphassajā vedanā, kāyasamphassajā vedanā, manosamphassajā vedanā. ",
  "sn12.2:8.4": "ayaṃ vuccati bhikkhave vedanā. ",
  "sn12.2:9.1": "katamo ca bhikkhave phasso? ",
  "sn12.2:9.2": "chayime bhikkhave, phassakāyā: ",
  "sn12.2:9.3": "cakkhusamphasso, sotasamphasso, ghānasamphasso, jivhāsamphasso, kāyasamphasso, manosamphasso. ",
  "sn12.2:9.4": "ayaṃ vuccati bhikkhave, phasso. ",
  "sn12.2:10.1": "katamañca bhikkhave saḷāyatanaṃ? ",
  "sn12.2:10.2": "cakkhāyatanaṃ sotāyatanaṃ ghānāyatanaṃ jivhāyatanaṃ kāyāyatanaṃ manāyatanaṃ. ",
  "sn12.2:10.3": "idaṃ vuccati bhikkhave, saḷāyatanaṃ. ",
  "sn12.2:11.1": "katamañca bhikkhave nāmarūpaṃ? ",
  "sn12.2:11.2": "vedanā saññā cetanā phasso manasikāro, ",
  "sn12.2:11.3": "idaṃ vuccati nāmaṃ. ",
  "sn12.2:11.4": "cattāro ca mahābhūtā, catunnaṃ ca mahābhūtānaṃ upādāyarūpaṃ. ",
  "sn12.2:11.5": "idaṃ vuccati rūpaṃ. ",
  "sn12.2:11.6": "iti idañca nāmaṃ, idañca rūpaṃ. ",
  "sn12.2:11.7": "idaṃ vuccati bhikkhave, nāmarūpaṃ. ",
  "sn12.2:12.1": "katamañca bhikkhave viññāṇaṃ? ",
  "sn12.2:12.2": "chayime bhikkhave, viññāṇakāyā: ",
  "sn12.2:12.3": "cakkhuviññāṇaṃ sotaviññāṇaṃ ghānaviññāṇaṃ jivhāviññāṇaṃ kāyaviññāṇaṃ manoviññāṇaṃ. ",
  "sn12.2:12.4": "idaṃ vuccati bhikkhave, viññāṇaṃ. ",
  "sn12.2:13.1": "katame ca bhikkhave saṅkhārā? ",
  "sn12.2:13.2": "tayome bhikkhave, saṅkhārā: ",
  "sn12.2:13.3": "kāyasaṅkhāro vacīsaṅkhāro cittasaṅkhāro. ",
  "sn12.2:13.4": "ime vuccanti bhikkhave, saṅkhārā. ",
  "sn12.2:14.1": "katamā ca bhikkhave avijjā? ",
  "sn12.2:14.2": "yaṃ kho bhikkhave dukkhe aññāṇaṃ, dukkhasamudaye aññāṇaṃ, dukkhanirodhe aññāṇaṃ, dukkhanirodhagāminiyā paṭipadāya aññāṇaṃ. ",
  "sn12.2:14.3": "ayaṃ vuccati bhikkhave, avijjā. ",
  "sn12.2:15.1": "iti kho bhikkhave avijjāpaccayā saṅkhārā, ",
  "sn12.2:15.2": "saṅkhārapaccayā viññāṇaṃ …pe… ",
  "sn12.2:15.3": "evametassa kevalassa dukkhakkhandhassa samudayo hoti. ",
  "sn12.2:15.4": "avijjāya tveva asesavirāganirodhā saṅkhāranirodho. ",
  "sn12.2:15.5": "saṅkhāranirodhā viññāṇanirodho …pe… ",
  "sn12.2:15.6": "evametassa kevalassa dukkhakkhandhassa nirodho hotīti. ",
  "sn12.2:15.7": ""
}
