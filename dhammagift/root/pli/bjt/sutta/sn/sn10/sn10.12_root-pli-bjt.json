{
  "sn10.12:0.1": "",
  "sn10.12:0.2": "",
  "sn10.12:0.3": "10. 1. 12. āḷavakasuttaṃ. ",
  "sn10.12:1.1": "evaṃ me sutaṃ: ",
  "sn10.12:1.2": "ekaṃ samayaṃ bhagavā āḷaviyaṃ viharati āḷavakassa yakkhassa bhavane. ",
  "sn10.12:1.3": "atha kho āḷavako yakkho yena bhagavā tenupasaṅkami. upasaṅkamitvā bhagavantaṃ etadavoca: ",
  "sn10.12:1.4": "nikkhama samaṇāti, ",
  "sn10.12:1.5": "sādhāvusoti bhagavā nikkhami. ",
  "sn10.12:1.6": "pavisa samaṇāti, ",
  "sn10.12:1.7": "sādhāvusoti bhagavā pāvisi. ",
  "sn10.12:1.8": "dutiyampi kho āḷavako yakkho bhagavantaṃ etadavoca: ",
  "sn10.12:1.9": "nikkhama samaṇāti. ",
  "sn10.12:1.10": "sādhāvusoti bhagavā nikkhami. ",
  "sn10.12:1.11": "pavisa samaṇāti. ",
  "sn10.12:1.12": "sādhāvusoti bhagavā pāvisi. ",
  "sn10.12:1.13": "tatiyampi kho āḷavako yakkho bhagavantaṃ etadavoca: ",
  "sn10.12:1.14": "nikkhama samaṇāti. ",
  "sn10.12:1.15": "sādhāvusoti bhagavā nikkhami. ",
  "sn10.12:1.16": "pavisa samaṇāti. ",
  "sn10.12:1.17": "sādhāvusoti bhagavā pāvisi. ",
  "sn10.12:1.18": "catutthampi kho āḷavako yakkho bhagavantaṃ etadavoca: ",
  "sn10.12:1.19": "nikkhama samaṇāti. ",
  "sn10.12:1.20": "na khvāhaṃ āvuso nikkhamissāmi. ",
  "sn10.12:1.21": "yaṃ te karaṇīyaṃ taṃ karohīti. ",
  "sn10.12:1.22": "[āḷavako:] pañhaṃ taṃ samaṇa pucchissāmi. ",
  "sn10.12:1.23": "sace me na byākarissasi, cittaṃ vā te khipissāmi, hadayaṃ vā te phālessāmi, pādesu vā gahetvā pāragaṅgāya khipissāmīti. ",
  "sn10.12:1.24": "[bhagavā:] na khvāhaṃ taṃ āvuso passāmi sadevake loke samārake sabrahmake sassamaṇabrāhmaṇiyā pajāya sadevamanussāya, ye me cittaṃ vā khipeyya hadayaṃ vā phāleyya pādesu vā gahetvā pāragaṅgāya khipeyya. ",
  "sn10.12:1.25": "api ca tvaṃ āvuso puccha yadākaṅkhasīti. atha kho āḷavako yakkho bhagavantaṃ gāthāya ",
  "sn10.12:2.1": "ajjhabhāsi: kiṃ sūdha vittaṃ purisassa seṭṭhaṃ ",
  "sn10.12:2.2": "kiṃ su suciṇṇaṃ sukhamāvahāti, ",
  "sn10.12:2.3": "kiṃ su have sādutaraṃ rasānaṃ ",
  "sn10.12:2.4": "kathaṃ jīvī jīvitamāhu seṭṭhanti? ",
  "sn10.12:3.1": "[bhagavā:] saddhīdha vittaṃ purisassa seṭṭhaṃ ",
  "sn10.12:3.2": "dhammo suciṇṇo sukhamāvahāti, ",
  "sn10.12:3.3": "saccaṃ have sādutaraṃ rasānaṃ ",
  "sn10.12:3.4": "paññājīviṃ jīvitamāhu seṭṭhanti. ",
  "sn10.12:4.1": "[āḷavako:] kathaṃ su tarati oghaṃ ",
  "sn10.12:4.2": "kathaṃsu tarati aṇṇavaṃ, ",
  "sn10.12:4.3": "kathaṃ su dukkhaṃ acceti ",
  "sn10.12:4.4": "kathaṃ su parisujjhatīti. ",
  "sn10.12:5.1": "[bhagavā:] saddhāya tarati oghaṃ ",
  "sn10.12:5.2": "appamādena aṇṇavaṃ, ",
  "sn10.12:5.3": "viriyena dukkhaṃ acceti ",
  "sn10.12:5.4": "paññāya parisujjhatīti. ",
  "sn10.12:6.1": "[āḷavako:] kathaṃ su labhate paññaṃ ",
  "sn10.12:6.2": "kathaṃsu vindate dhanaṃ, ",
  "sn10.12:6.3": "kathaṃ su kittiṃ pappoti ",
  "sn10.12:6.4": "kathaṃ mittāni ganthati, ",
  "sn10.12:6.5": "asmā lokā paraṃ lokaṃ ",
  "sn10.12:6.6": "kathaṃ pecca na socatīti? ",
  "sn10.12:7.1": "[bhagavā:] saddahāno arahataṃ ",
  "sn10.12:7.2": "dhammaṃ nibbāṇapattiyā, ",
  "sn10.12:7.3": "sussūsā labhate paññaṃ ",
  "sn10.12:7.4": "appamatto vicakkhaṇo. ",
  "sn10.12:8.1": "patirūpakārī dhuravā ",
  "sn10.12:8.2": "uṭṭhātā vindate dhanaṃ, ",
  "sn10.12:8.3": "saccena kittiṃ pappoti ",
  "sn10.12:8.4": "dadaṃ mittāni ganthati. ",
  "sn10.12:8.5": "",
  "sn10.12:8.6": "",
  "sn10.12:9.1": "yassete caturo dhammā ",
  "sn10.12:9.2": "saddhassa gharamesino, ",
  "sn10.12:9.3": "saccaṃ dhammo dhiti cāgo ",
  "sn10.12:9.4": "sa ce pecca na socati, asmā lokā paraṃ lokaṃ evaṃ pecca na socatīti. ",
  "sn10.12:10.1": "iṅgha aññepi pucchassu ",
  "sn10.12:10.2": "puthū samaṇabrāhmaṇe, ",
  "sn10.12:10.3": "yadi saccā damā cāgā ",
  "sn10.12:10.4": "khantyā bhiyyodha vijjatīti. ",
  "sn10.12:11.1": "[āḷavako:] kathaṃ nu dāni puccheyyaṃ ",
  "sn10.12:11.2": "puthū samaṇabrāhmaṇe, ",
  "sn10.12:11.3": "so’haṃ ajja pajānāmi ",
  "sn10.12:11.4": "yo attho samparāyiko. ",
  "sn10.12:12.1": "atthāya vata me buddho ",
  "sn10.12:12.2": "vāsāyāḷavimāgamā, ",
  "sn10.12:12.3": "so’haṃ ajja pajānāmi ",
  "sn10.12:12.4": "yattha dinnaṃ mahapphalaṃ. ",
  "sn10.12:13.1": "so ahaṃ vicarissāmi ",
  "sn10.12:13.2": "gāmā gāmaṃ purā puraṃ, ",
  "sn10.12:13.3": "namassamāno sambuddhaṃ ",
  "sn10.12:13.4": "dhammassa ca sudhammatanti. ",
  "sn10.12:13.5": "indakavaggo paṭhamo. ",
  "sn10.12:14.0": "tatruddānaṃ: ",
  "sn10.12:14.1": "indako sakka sūci ca ",
  "sn10.12:14.2": "maṇibhaddo ca sānu ca, ",
  "sn10.12:14.3": "piyaṅkara punabbasu sudatto ca ",
  "sn10.12:14.4": "dve sukkā cīrā āḷavakena ",
  "sn10.12:14.5": "dvādasāti. yakkhasaṃyuttaṃ samattaṃ. "
}
