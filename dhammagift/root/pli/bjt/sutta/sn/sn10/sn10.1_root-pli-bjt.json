{
  "sn10.1:0.1": "vanasaṃyuttaṃ samattaṃ. 10. yakkhasaṃyuttaṃ ",
  "sn10.1:0.2": "1. indakavaggo ",
  "sn10.1:0.3": "10. 1. 1. indakasuttaṃ. ",
  "sn10.1:1.1": "evaṃ me sutaṃ: ",
  "sn10.1:1.2": "ekaṃ samayaṃ bhagavā rājagahe viharati indakūṭe pabbate indakassa yakkhassa bhavane. ",
  "sn10.1:1.3": "atha kho indako yakkho yena bhagavā tenupasaṅkami. upasaṅkamitvā bhagavantaṃ gāthāya ajjhabhāsi: ",
  "sn10.1:2.1": "rūpaṃ na jīvanti vadanti buddhā ",
  "sn10.1:2.2": "kathaṃ nvayaṃ vindati’maṃ sarīraṃ, ",
  "sn10.1:2.3": "kutassa aṭṭhīyakapiṇḍameti ",
  "sn10.1:2.4": "kathaṃ nvayaṃ sajjati gabbharasminti. ",
  "sn10.1:3.1": "[bhagavā:] paṭhamaṃ kalalaṃ hoti ",
  "sn10.1:3.2": "kalalā hoti abbudaṃ, ",
  "sn10.1:3.3": "abbudā jāyate pesī ",
  "sn10.1:3.4": "pesī nibbattati ghano, ",
  "sn10.1:3.5": "ghanā pasākhā jāyanti ",
  "sn10.1:3.6": "kesā lomā nakhā’pi ca. ",
  "sn10.1:4.1": "yañcassa bhuñjate mātā ",
  "sn10.1:4.2": "annaṃ pānañca bhojanaṃ, ",
  "sn10.1:4.3": "tena so tattha yāpeti ",
  "sn10.1:4.4": "mātukucchigato naroti. "
}
