  "sn10.4:0.1": "",
  "sn10.4:0.2": "",
  "sn10.4:0.3": "10. 1. 4. maṇibhaddasuttaṃ. ",
  "sn10.4:1.1": "ekaṃ samayaṃ bhagavā magadhesu viharati maṇimāḷake cetiye maṇibhaddassa yakkhassa bhavane. ",
  "sn10.4:1.2": "atha kho maṇibhaddo yakkho yena bhagavā tenupasaṅkami. upasaṅkamitvā bhagavato santike imaṃ gāthaṃ abhāsi: ",
  "sn10.4:2.1": "satīmato sadā bhaddaṃ ",
  "sn10.4:2.2": "satimā sukhamedhati, ",
  "sn10.4:2.3": "satīmato su ve seyyo ",
  "sn10.4:2.4": "verā ca parimuccatīti. ",
  "sn10.4:3.1": "[bhagavā:] satīmato sadā bhaddaṃ ",
  "sn10.4:3.2": "satimā sukhamedhati, ",
  "sn10.4:3.3": "satīmato suve seyyo ",
  "sn10.4:3.4": "verā na parimuccati. ",
  "sn10.4:4.1": "yassa sabbamahorattaṃ ",
  "sn10.4:4.2": "ahiṃsāya rato mano, ",
  "sn10.4:4.3": "mettaṃ so sabbabhūtesu ",
  "sn10.4:4.4": "veraṃ tassa na kenacīti. "
}
