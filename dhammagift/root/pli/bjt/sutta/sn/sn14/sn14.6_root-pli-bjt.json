{
  "sn14.6:0.1": "",
  "sn14.6:0.2": "",
  "sn14.6:0.3": "2. 1. 6. bāhiradhātunānattasuttaṃ ",
  "sn14.6:1.1": "sāvatthiyaṃ– ",
  "sn14.6:1.2": "dhātunānattaṃ kho bhikkhave, desessāmi. ",
  "sn14.6:1.3": "taṃ suṇātha …pe… bhāsissāmi. ",
  "sn14.6:1.4": "katamañca bhikkhave, dhātunānattaṃ? ",
  "sn14.6:1.5": "rūpadhātu saddadhātu gandhadhātu rasadhātu phoṭṭhabbadhātu dhammadhātu. ",
  "sn14.6:1.6": "idaṃ vuccati bhikkhave, dhātunānattanti. ",
  "sn14.6:1.7": ""
}
