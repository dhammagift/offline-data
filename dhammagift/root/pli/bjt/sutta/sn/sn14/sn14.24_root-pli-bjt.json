{
  "sn14.24:0.1": "",
  "sn14.24:0.2": "",
  "sn14.24:0.3": "2. 3. 2. dussīlasuttaṃ ",
  "sn14.24:1.1": "sāvatthiyaṃ– ",
  "sn14.24:1.2": "dhātusova bhikkhave, sattā saṃsandanti samenti: ",
  "sn14.24:1.3": "assaddhā assaddhehi saddhiṃ saṃsandanti samenti. ",
  "sn14.24:1.4": "ahirikā ahirikehi saddhiṃ …pe… anottāpino ",
  "sn14.24:1.5": "anottāpīhi saddhiṃ …pe… ",
  "sn14.24:1.6": "dussīlā dussīlehi saddhiṃ …pe… ",
  "sn14.24:1.7": "duppaññā duppaññehi saddhiṃ saṃsandanti samenti. ",
  "sn14.24:2.1": "saddhā saddhehi saddhiṃ saṃsandanti samenti. ",
  "sn14.24:2.2": "hirimanā hirimanehi saddhiṃ …pe… ottāpino ",
  "sn14.24:2.3": "ottāpīhi saddhiṃ …pe… ",
  "sn14.24:2.4": "sīlavanto sīlavantehi saddhiṃ …pe… ",
  "sn14.24:2.5": "paññavanto paññavantehi saddhiṃ saṃsandanti samentīti. ",
  "sn14.24:2.6": ""
}
