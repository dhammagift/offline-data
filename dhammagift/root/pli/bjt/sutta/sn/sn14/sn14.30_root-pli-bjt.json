{
  "sn14.30:0.1": "",
  "sn14.30:0.2": "4. catudhātuvaggo ",
  "sn14.30:0.3": "2. 4. 1. catudhātusuttaṃ ",
  "sn14.30:1.1": "evaṃ me sutaṃ: ekaṃ samayaṃ bhagavā sāvatthiyaṃ viharati jetavane anāthapiṇḍikassa ārāme …pe… ",
  "sn14.30:1.2": "catasso imā bhikkhave, dhātuyo. ",
  "sn14.30:1.3": "katamā catasso? ",
  "sn14.30:1.4": "paṭhavīdhātu āpodhātu tejodhātu vāyodhātu. ",
  "sn14.30:1.5": "imā kho bhikkhave, catasso dhātuyoti. ",
  "sn14.30:1.6": ""
}
