{
  "sn14.29:0.1": "",
  "sn14.29:0.2": "",
  "sn14.29:0.3": "2. 3. 7. dasaṅgikasuttaṃ ",
  "sn14.29:1.1": "sāvatthiyaṃ– ",
  "sn14.29:1.2": "dhātusova bhikkhave, sattā saṃsandanti samenti: ",
  "sn14.29:1.3": "micchādiṭṭhikā micchādiṭṭhikehi saddhiṃ saṃsandanti samenti. ",
  "sn14.29:1.4": "micchāsaṃkappā …pe… ",
  "sn14.29:1.5": "micchāvācā …pe… ",
  "sn14.29:1.6": "micchākammantā …pe… ",
  "sn14.29:1.7": "micchāājīvā …pe… ",
  "sn14.29:1.8": "micchāvāyāmā …pe… ",
  "sn14.29:1.9": "micchāsatino …pe… ",
  "sn14.29:1.10": "micchāsamādhino …pe… ",
  "sn14.29:1.11": "micchāñāṇino micchāñāṇīhi saddhiṃ saṃsandanti samenti. ",
  "sn14.29:1.12": "micchāvimuttino micchāvimuttīhi saddhiṃ saṃsandanti samenti. ",
  "sn14.29:2.1": "sammādiṭṭhikā sammādiṭṭhikehi saddhiṃ saṃsandanti samenti. ",
  "sn14.29:2.2": "sammāsaṃkappā …pe… ",
  "sn14.29:2.3": "sammāvācā …pe… ",
  "sn14.29:2.4": "sammākammantā …pe… ",
  "sn14.29:2.5": "sammāājīvā …pe… ",
  "sn14.29:2.6": "sammāvāyāmā …pe… ",
  "sn14.29:2.7": "sammāsatino …pe… ",
  "sn14.29:2.8": "sammāsamādhino …pe… ",
  "sn14.29:2.9": "sammāñāṇino sammāñāṇīhi saddhiṃ saṃsandanti samenti. ",
  "sn14.29:2.10": "sammāvimuttino sammāvimuttīhi saddhiṃ saṃsandanti samentīti. ",
  "sn14.29:2.11": "",
  "sn14.29:2.12": "(sabbattha atītānāgata paccuppannaṃ kātabbaṃ.) ",
  "sn14.29:3.0": "sattannaṃ suttantānaṃ uddānaṃ: ",
  "sn14.29:3.1": "asamāhitaṃ dussīlaṃ ",
  "sn14.29:3.2": "pañcasikkhāpadāni ca, ",
  "sn14.29:3.3": "sattakammapathaṃ vuttā ",
  "sn14.29:3.4": "dasakammapathena ca, ",
  "sn14.29:3.5": "chaṭṭhaṃ aṭṭhaṅgikaṃ vuttaṃ ",
  "sn14.29:3.6": "dasaṅgikena sattamanti. ",
  "sn14.29:3.7": "kammapathavaggo tatiyo. "
}
