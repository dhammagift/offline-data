{
  "sn14.26:0.1": "",
  "sn14.26:0.2": "",
  "sn14.26:0.3": "2. 3. 4. sattakammapathasuttaṃ ",
  "sn14.26:1.1": "sāvatthiyaṃ– ",
  "sn14.26:1.2": "dhātusova bhikkhave, sattā saṃsandanti samenti: ",
  "sn14.26:1.3": "pāṇātipātino pāṇātipātīhi saddhiṃ saṃsandanti samenti. ",
  "sn14.26:1.4": "adinnādāyino adinnādāyīhi saddhiṃ …pe… ",
  "sn14.26:1.5": "kāmesu micchācārino kāmesu micchācārīhi saddhiṃ …pe… ",
  "sn14.26:1.6": "musāvādino musāvādīhi saddhiṃ …pe… ",
  "sn14.26:1.7": "pisuṇavācā pisuṇavācehi saddhiṃ …pe… ",
  "sn14.26:1.8": "pharusavācā pharusavācehi saddhiṃ …pe… ",
  "sn14.26:1.9": "samphappalāpino samphappalāpīhi saddhiṃ saṃsandanti samenti. ",
  "sn14.26:2.1": "pāṇātipātā paṭiviratā …pe… ",
  "sn14.26:2.2": "adinnādānā paṭiviratā ",
  "sn14.26:2.3": "…pe… kāmesu micchācārā paṭiviratā …pe… ",
  "sn14.26:2.4": "musāvādā paṭiviratā …pe… ",
  "sn14.26:2.5": "pisuṇāya vācāya paṭiviratā …pe… ",
  "sn14.26:2.6": "pharusāya vācāya paṭiviratā …pe… ",
  "sn14.26:2.7": "samphappalāpā paṭiviratā samphappalāpā paṭiviratehi saddhiṃ saṃsandanti samentīti. ",
  "sn14.26:2.8": ""
}
