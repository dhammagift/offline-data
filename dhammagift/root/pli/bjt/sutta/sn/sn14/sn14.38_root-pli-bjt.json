  "sn14.38:0.1": "",
  "sn14.38:0.2": "",
  "sn14.38:0.3": "2. 4. 9. dutiyasamaṇabrāhmaṇasuttaṃ ",
  "sn14.38:1.1": "sāvatthiyaṃ– ",
  "sn14.38:1.2": "catasso imā bhikkhave, dhātuyo. ",
  "sn14.38:1.3": "katamā catasso? ",
  "sn14.38:1.4": "paṭhavīdhātu āpodhātu tejodhātu vāyodhātu. ",
  "sn14.38:1.5": "ye hi keci bhikkhave, samaṇā vā brāhmaṇā vā imāsaṃ catunnaṃ dhātūnaṃ samudayañca atthaṅgamañca assādañca ādīnavañca nissaraṇañca yathābhūtaṃ nappajānanti …pe… ",
  "sn14.38:1.6": "yathābhūtaṃ ",
  "sn14.38:1.7": "pajānanti, te …pe… ",
  "sn14.38:1.8": "sayaṃ abhiññā sacchikatvā upasampajja viharantīti. ",
  "sn14.38:1.9": ""
}
