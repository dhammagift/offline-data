{
  "sn14.23:0.1": "",
  "sn14.23:0.2": "3. kammapathavaggo ",
  "sn14.23:0.3": "2. 3. 1. asamāhitasuttaṃ ",
  "sn14.23:1.1": "sāvatthiyaṃ– ",
  "sn14.23:1.2": "dhātusova bhikkhave, sattā saṃsandanti samenti: ",
  "sn14.23:1.3": "assaddhā assaddhehi saddhiṃ saṃsandanti samenti: ",
  "sn14.23:1.4": "ahirikā ahirikehi saddhiṃ saṃsandanti samenti. ",
  "sn14.23:1.5": "anottāpino anottāpīhi saddhiṃ …pe… ",
  "sn14.23:1.6": "asamāhitā asamāhitehi saddhiṃ …pe… ",
  "sn14.23:1.7": "duppaññā duppaññehi saddhiṃ saṃsandanti samenti. ",
  "sn14.23:2.1": "saddhā saddhehi saddhiṃ saṃsandanti samenti. ",
  "sn14.23:2.2": "hirimanā hirimanehi saddhiṃ …pe… ottāpino ",
  "sn14.23:2.3": "ottāpīhi saddhiṃ …pe… ",
  "sn14.23:2.4": "samāhitā samāhitehi saddhiṃ …pe… ",
  "sn14.23:2.5": "paññavanto paññavantehi saddhiṃ saṃsandanti samentīti. ",
  "sn14.23:2.6": ""
}
