  "sn14.28:0.1": "",
  "sn14.28:0.2": "",
  "sn14.28:0.3": "2. 3. 6. aṭṭhaṅgikasuttaṃ ",
  "sn14.28:1.1": "sāvatthiyaṃ– ",
  "sn14.28:1.2": "dhātusova bhikkhave, sattā saṃsandanti samenti: ",
  "sn14.28:1.3": "micchādiṭṭhikā micchādiṭṭhikehi saddhiṃ saṃsandanti samenti. ",
  "sn14.28:1.4": "micchāsaṃkappā …pe… ",
  "sn14.28:1.5": "micchāvācā …pe… ",
  "sn14.28:1.6": "micchākammantā …pe… ",
  "sn14.28:1.7": "micchāājīvā …pe… ",
  "sn14.28:1.8": "micchāvāyāmā …pe… ",
  "sn14.28:1.9": "micchāsatino …pe… ",
  "sn14.28:1.10": "micchāsamādhino micchāsamādhīhi saddhiṃ saṃsandanti samenti. ",
  "sn14.28:2.1": "sammādiṭṭhikā sammādiṭṭhikehi saddhiṃ saṃsandanti samenti. ",
  "sn14.28:2.2": "sammāsaṃkappā …pe… ",
  "sn14.28:2.3": "sammāvācā …pe… ",
  "sn14.28:2.4": "sammākammantā …pe… ",
  "sn14.28:2.5": "sammāājīvā …pe… ",
  "sn14.28:2.6": "sammāvāyāmā …pe… ",
  "sn14.28:2.7": "sammāsatino …pe… ",
  "sn14.28:2.8": "sammāsamādhino sammāsamādhīhi saddhiṃ saṃsandanti samentīti. ",
  "sn14.28:2.9": ""
}
