{
  "sn39.16:0.1": "(jambukhādakavagge viya vitthāretabbaṃ.) ",
  "sn39.16:0.2": "",
  "sn39.16:0.3": "5. 1. 16. dukkarasuttaṃ ",
  "sn39.16:1.1": "kinnu kho āvuso sāriputta imasmiṃ dhammavinaye dukkaranti? ",
  "sn39.16:1.2": "pabbajjā kho āvuso imasmiṃ dhammavinaye dukkarāti. ",
  "sn39.16:1.3": "pabbajitena panāvuso kiṃ dukkaranti? ",
  "sn39.16:1.4": "pabbajitena kho āvuso abhirati dukkarāti. ",
  "sn39.16:1.5": "abhiratena pana āvuso kiṃ dukkaranti? ",
  "sn39.16:1.6": "abhiratena kho āvuso dhammānudhammapaṭipatti dukkarāti. ",
  "sn39.16:1.7": "kīvaciraṃ panāvuso dhammānudhammapaṭipanno bhikkhu arahaṃ assāti? ",
  "sn39.16:1.8": "na ciraṃ āvusoti. ",
  "sn39.16:1.9": "sāmaṇḍakāni saṃyuttaṃ samattaṃ. purimakasadisameva ",
  "sn39.16:1.10": "uddānaṃ ",
  "sn39.16:1.11": ""
}
