{
  "sn15.10:0.1": "",
  "sn15.10:0.2": "",
  "sn15.10:0.3": "3. 1. 10. ekapuggalasuttaṃ ",
  "sn15.10:1.1": "ekaṃ samayaṃ bhagavā rājagahe viharati gijjhakūṭe pabbate. ",
  "sn15.10:1.2": "tatra kho …pe… ",
  "sn15.10:1.3": "",
  "sn15.10:1.4": "",
  "sn15.10:1.5": "etadavoca: ",
  "sn15.10:2.1": "anamataggoyaṃ bhikkhave, saṃsāro …pe… ",
  "sn15.10:2.2": "ekapuggalassa bhikkhave, kappaṃ sandhāvato saṃsarato siyā evaṃ mahā aṭṭhikaṅkalo aṭṭhipuñjo aṭṭhirāsi yathāyaṃ vepullo pabbato, sace saṃhārako assa, sambhatañca na vinasseyya. ",
  "sn15.10:2.3": "taṃ kissa hetu? ",
  "sn15.10:2.4": "anamataggoyaṃ bhikkhave, saṃsāro. …pe… ",
  "sn15.10:2.5": "alaṃ vimuccitunti. ",
  "sn15.10:3.1": "idamavoca bhagavā. ",
  "sn15.10:3.2": "idaṃ vatvā sugato athāparaṃ etadavoca satthā: ",
  "sn15.10:4.1": "ekassekena kappena ",
  "sn15.10:4.2": "puggalassaṭṭhisañcayo,siyā ",
  "sn15.10:4.3": "pabbatasamo rāsi ",
  "sn15.10:4.4": "iti vuttaṃ mahesinā. ",
  "sn15.10:5.1": "so kho panāyaṃ akkhāto ",
  "sn15.10:5.2": "vepullo pabbato mahā,uttaro ",
  "sn15.10:5.3": "gijjhakūṭassa ",
  "sn15.10:5.4": "magadhānaṃ giribbaje. ",
  "sn15.10:6.1": "yato ca ariyasaccāni ",
  "sn15.10:6.2": "sammappaññāya passati:dukkhaṃ ",
  "sn15.10:6.3": "dukkhasamuppādaṃ ",
  "sn15.10:6.4": "dukkhassa ca atikkamaṃ,ariyañcaṭṭhaṅgikaṃ ",
  "sn15.10:6.5": "maggaṃ ",
  "sn15.10:6.6": "dukkhūpasamagāminaṃ. ",
  "sn15.10:7.1": "sa sattakkhattuṃ paramaṃ ",
  "sn15.10:7.2": "sandhāvitvāna puggalo,dukkhassantakaro ",
  "sn15.10:7.3": "hoti ",
  "sn15.10:7.4": "sabbasaññojanakkhayāti. ",
  "sn15.10:7.5": "tiṇakaṭṭhavaggo ",
  "sn15.10:7.6": "paṭhamo ",
  "sn15.10:8.0": "tassuddānaṃ: ",
  "sn15.10:8.1": "tiṇakaṭṭhañca paṭhavī ",
  "sn15.10:8.2": "assu khīrañca pabbataṃ, ",
  "sn15.10:8.3": "sāsapā sāvako gaṅgā ",
  "sn15.10:8.4": "daṇḍo ca puggalena cāti. "
}
