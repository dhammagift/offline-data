  "sn15.12:0.3": "3. 2. 2. sukhitasuttaṃ ",
  "sn15.12:1.1": "sāvatthiyaṃ– ",
  "sn15.12:1.2": "anamataggoyaṃ bhikkhave, saṃsāro …pe… ",
  "sn15.12:1.3": "yaṃ bhikkhave, passeyyātha sukhitaṃ sajjitaṃ, niṭṭhamettha gantabbaṃ ",
  "sn15.12:1.4": "“amhehipi evarūpaṃ paccanubhūtaṃ iminā dīghena addhunā”ti. ",
  "sn15.12:1.5": "taṃ kissa hetu? ",
  "sn15.12:1.6": "anamataggoyaṃ bhikkhave, saṃsāro. ",
  "sn15.12:1.7": "…pe… ",
  "sn15.12:1.8": "alaṃ vimuccitunti. ",
  "sn15.12:1.9": ""
}
