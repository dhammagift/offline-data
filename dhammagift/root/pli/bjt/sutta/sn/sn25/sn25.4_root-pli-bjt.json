  "sn25.4:0.3": "4. 1. 4. phassa suttaṃ ",
  "sn25.4:1.1": "sāvatthiyaṃ: ",
  "sn25.4:1.2": "cakkhusamphasso bhikkhave, anicco vipariṇāmī aññathābhāvī. ",
  "sn25.4:1.3": "sotasamphasso …pe… ",
  "sn25.4:1.4": "ghānasamphasso …pe… ",
  "sn25.4:1.5": "jivhāsamphasso …pe… ",
  "sn25.4:1.6": "kāyasamphasso …pe… ",
  "sn25.4:1.7": "manosamphasso anicco vipariṇāmī aññathābhāvī. ",
  "sn25.4:1.8": "yo bhikkhave, ime dhamme evaṃ saddahati …pe… ",
  "sn25.4:1.9": "sambodhiparāyanoti. ",
  "sn25.4:1.10": ""
}
