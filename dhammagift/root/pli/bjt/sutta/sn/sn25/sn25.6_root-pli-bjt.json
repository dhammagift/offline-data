  "sn25.6:0.3": "4. 1. 6. saññā suttaṃ ",
  "sn25.6:1.1": "sāvatthiyaṃ: ",
  "sn25.6:1.2": "rūpasaññā bhikkhave, aniccā vipariṇāmī aññathābhāvī. ",
  "sn25.6:1.3": "saddasaññā …pe… ",
  "sn25.6:1.4": "gandhasaññā …pe… ",
  "sn25.6:1.5": "rasasaññā …pe… ",
  "sn25.6:1.6": "phoṭṭhabbasaññā …pe… ",
  "sn25.6:1.7": "dhammasaññā aniccā vipariṇāmī aññathābhāvī. ",
  "sn25.6:1.8": "yo bhikkhave, ime dhamme …pe… ",
  "sn25.6:1.9": "sambodhiparāyanoti. ",
  "sn25.6:1.10": ""
}
