  "sn25.5:0.1": "",
  "sn25.5:0.2": "",
  "sn25.5:0.3": "4. 1. 5. vedanā suttaṃ ",
  "sn25.5:1.1": "sāvatthiyaṃ: ",
  "sn25.5:1.2": "cakkhusamphassajā vedanā bhikkhave, aniccā vipariṇāmī aññathābhāvī. ",
  "sn25.5:1.3": "sotasamphassajā vedanā …pe… ",
  "sn25.5:1.4": "ghānasamphassajā vedanā …pe… ",
  "sn25.5:1.5": "jivhāsamphassajā vedanā …pe… ",
  "sn25.5:1.6": "kāyasamphassajā vedanā …pe… ",
  "sn25.5:1.7": "manosamphassajā vedanā aniccā vipariṇāmī aññathābhāvī. ",
  "sn25.5:1.8": "yo bhikkhave, ime dhamme …pe… ",
  "sn25.5:1.9": "sambodhiparāyanoti. ",
  "sn25.5:1.10": ""
}
