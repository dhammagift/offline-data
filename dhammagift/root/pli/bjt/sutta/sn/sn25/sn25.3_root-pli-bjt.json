{
  "sn25.3:0.1": "",
  "sn25.3:0.2": "",
  "sn25.3:0.3": "4. 1. 3. viññāṇa suttaṃ ",
  "sn25.3:1.1": "sāvatthiyaṃ: ",
  "sn25.3:1.2": "cakkhuviññāṇaṃ bhikkhave, aniccaṃ vipariṇāmī aññathābhāvi. ",
  "sn25.3:1.3": "sotaviññāṇaṃ aniccaṃ vipariṇāmī aññathābhāvi. ",
  "sn25.3:1.4": "ghānaviññāṇaṃ aniccaṃ vipariṇāmī aññathābhāvi. ",
  "sn25.3:1.5": "jivhāviññāṇaṃ aniccaṃ vipariṇāmī aññathābhāvi. ",
  "sn25.3:1.6": "kāyaviññāṇaṃ aniccaṃ vipariṇāmī aññathābhāvi. ",
  "sn25.3:1.7": "manoviññāṇaṃ aniccaṃ vipariṇāmī aññathābhāvi. ",
  "sn25.3:1.8": "yo bhikkhave, ime dhamme evaṃ saddahati adhimuccati ayaṃ vuccati saddhānusārī …pe… ",
  "sn25.3:1.9": "sambodhiparāyanoti. ",
  "sn25.3:1.10": ""
}
