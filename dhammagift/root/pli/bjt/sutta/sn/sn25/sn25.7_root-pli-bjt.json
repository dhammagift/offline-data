  "sn25.7:0.3": "4. 1. 7. cetanā suttaṃ ",
  "sn25.7:1.1": "sāvatthiyaṃ: ",
  "sn25.7:1.2": "rūpasañcetanā bhikkhave, aniccā vipariṇāmī aññathābhāvī. ",
  "sn25.7:1.3": "saddasañcetanā …pe… ",
  "sn25.7:1.4": "gandhasañcetanā …pe… ",
  "sn25.7:1.5": "rasasañcetanā …pe… ",
  "sn25.7:1.6": "phoṭṭhabbasañcetanā …pe… ",
  "sn25.7:1.7": "dhammasañcetanā aniccā vipariṇāmī aññathābhāvī. ",
  "sn25.7:1.8": "yo bhikkhave, ime dhamme …pe… ",
  "sn25.7:1.9": "sambodhiparāyanoti. ",
  "sn25.7:1.10": ""
}
