  "sn25.9:0.3": "4. 1. 9. dhātu suttaṃ ",
  "sn25.9:1.1": "sāvatthiyaṃ: ",
  "sn25.9:1.2": "paṭhavīdhātu bhikkhave, aniccā vipariṇāmī aññathābhāvī. ",
  "sn25.9:1.3": "āpodhātu …pe… ",
  "sn25.9:1.4": "tejodhātu …pe… ",
  "sn25.9:1.5": "vāyodhātu …pe… ",
  "sn25.9:1.6": "ākāsadhātu …pe… ",
  "sn25.9:1.7": "viññāṇadhātu aniccā vipariṇāmī aññathābhāvī. ",
  "sn25.9:1.8": "yo bhikkhave, ime dhamme …pe… ",
  "sn25.9:1.9": "sambodhiparāyanoti. ",
  "sn25.9:1.10": ""
}
