  "sn25.8:0.3": "4. 1. 8. taṇhā suttaṃ ",
  "sn25.8:1.1": "sāvatthiyaṃ: ",
  "sn25.8:1.2": "rūpataṇhā bhikkhave, aniccā vipariṇāmī aññathābhāvī. ",
  "sn25.8:1.3": "saddataṇhā …pe… ",
  "sn25.8:1.4": "gandhataṇhā …pe… ",
  "sn25.8:1.5": "rasataṇhā …pe… ",
  "sn25.8:1.6": "phoṭṭhabbataṇhā …pe… ",
  "sn25.8:1.7": "dhammataṇhā aniccā vipariṇāmī aññathābhāvī. ",
  "sn25.8:1.8": "yo bhikkhave, ime dhamme …pe… ",
  "sn25.8:1.9": "sambodhiparāyaṇoti. ",
  "sn25.8:1.10": ""
}
