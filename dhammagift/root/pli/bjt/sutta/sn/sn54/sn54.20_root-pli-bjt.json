  "sn54.20:0.3": "10. 2. 10. āsavakkhayasuttaṃ ",
  "sn54.20:1.1": "ānāpānasatisamādhi ",
  "sn54.20:1.2": "bhikkhave ",
  "sn54.20:1.3": "",
  "sn54.20:1.4": "",
  "sn54.20:1.5": "",
  "sn54.20:1.6": "",
  "sn54.20:1.7": "",
  "sn54.20:1.8": "",
  "sn54.20:1.9": "",
  "sn54.20:1.10": "…pe… ",
  "sn54.20:1.11": "āsavānaṃ khayāya saṃvattatīti. ",
  "sn54.20:1.12": "(imāni tīṇi suttānipi yathā saṃyojanasuttaṃ vitthāretabbāni.) ānandavaggo ",
  "sn54.20:1.13": "dutiyo. tatruddānaṃ: ",
  "sn54.20:2.0": "",
  "sn54.20:2.1": "icchānaṅgalaṃ kaṅkheyyaṃ ",
  "sn54.20:2.2": "ānandena pare duve dve ",
  "sn54.20:2.3": "bhikkhū saṃyojanānusayā ",
  "sn54.20:2.4": "addhānamāsavakkhayoti. ",
  "sn54.20:2.5": ""
}
