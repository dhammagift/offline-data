  "sn34.15:0.3": "13. 1. 15. samāpatti gocara kusala suttaṃ ",
  "sn34.15:1.1": "sāvatthiyaṃ: ",
  "sn34.15:1.2": "cattārome bhikkhave, jhāyī. ",
  "sn34.15:1.3": "katame cattāro: ",
  "sn34.15:1.4": "idha bhikkhave, ekacco jhāyī samādhismiṃ samāpattikusalo hoti, na samādhismiṃ gocarakusalo. ",
  "sn34.15:1.5": "",
  "sn34.15:1.6": "",
  "sn34.15:1.7": "",
  "sn34.15:1.8": "…pe… ",
  "sn34.15:1.9": "pavaro cāti. ",
  "sn34.15:1.10": "(catukoṭikaṃ "
}
