{
  "sn2.14:0.1": "",
  "sn2.14:0.2": "",
  "sn2.14:0.3": "2. 2. 4. nandanasuttaṃ. ",
  "sn2.14:1.1": "sāvatthiyaṃ– ekamantaṃ ṭhito kho nandano devaputto bhagavantaṃ gāthāya ajjhabhāsi: ",
  "sn2.14:2.1": "pucchāmi taṃ gotama bhūripañña ",
  "sn2.14:2.2": "anāvaṭaṃ bhagavato ñāṇadassanaṃ ",
  "sn2.14:2.3": "kathaṃvidhaṃ sīlavantaṃ vadanti, ",
  "sn2.14:2.4": "kathaṃvidhaṃ paññavantaṃ vadanti ",
  "sn2.14:2.5": "kathaṃvidho dukkhamaticca irīyati. ",
  "sn2.14:2.6": "kathaṃvidhaṃ devatā pūjayantīti. ",
  "sn2.14:3.1": "[bhagavā:] yo sīlavā paññavā bhāvitatto ",
  "sn2.14:3.2": "samāhito jhānarato satīmā, ",
  "sn2.14:3.3": "sabbassa sokā vigatā pahīṇā ",
  "sn2.14:3.4": "khīṇāsavo antimadehadhārī. ",
  "sn2.14:4.1": "tathāvidhaṃ sīlavantaṃ vadanti ",
  "sn2.14:4.2": "tathāvidhaṃ paññavantaṃ vadanti, ",
  "sn2.14:4.3": "tathāvidho dukkhamaticca irīyati ",
  "sn2.14:4.4": "tathāvidhaṃ devatā pūjayantīti. "
}
