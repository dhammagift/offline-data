  "sn2.17:0.3": "2. 2. 7. subrahmasuttaṃ. ",
  "sn2.17:1.1": "sāvatthiyaṃ– ekamantaṃ ṭhito kho subrahmā devaputto bhagavantaṃ gāthāya ajjhabhāsi:– ",
  "sn2.17:2.1": "niccaṃ utrastamidaṃ cittaṃ ",
  "sn2.17:2.2": "niccaṃ ubbiggamidaṃ mano ",
  "sn2.17:2.3": "anuppannesu kicchesu ",
  "sn2.17:2.4": "atho uppatitesu ca ",
  "sn2.17:2.5": "sace atthi anutrastaṃ ",
  "sn2.17:2.6": "taṃme akkhāhi pucchito ti. [bhagavā:] ",
  "sn2.17:3.1": "nāññatra bojjhaṅgā tapasā ",
  "sn2.17:3.2": "nāññatra indriyasaṃvarā, ",
  "sn2.17:3.3": "nāññatra sabbanissaggā ",
  "sn2.17:3.4": "sotthiṃ passāmi pāṇinanti. ",
  "sn2.17:4.1": "",
  "sn2.17:4.2": ""
}
