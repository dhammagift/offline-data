{
  "sn2.12:0.1": "",
  "sn2.12:0.2": "",
  "sn2.12:0.3": "2. 2. 2. veṇhusuttaṃ ",
  "sn2.12:1.1": "sāvatthiyaṃ– ekamantaṃ ṭhito kho veṇhu devaputto bhagavato santike imaṃ gāthaṃ abhāsi: ",
  "sn2.12:2.1": "sukhitā vata te manujā ",
  "sn2.12:2.2": "sugataṃ payirupāsiya, ",
  "sn2.12:2.3": "yuñjaṃ gotama ",
  "sn2.12:2.4": "sāsane appamattānusikkhareti. ",
  "sn2.12:3.1": "ye me pavutte satthipade ",
  "sn2.12:3.2": "(veṇhoti bhagavā) ",
  "sn2.12:3.3": "anusikkhanti jhāyino, ",
  "sn2.12:3.4": "kāle te appamajjantā ",
  "sn2.12:3.5": "na maccuvasagā siyunti. "
}
