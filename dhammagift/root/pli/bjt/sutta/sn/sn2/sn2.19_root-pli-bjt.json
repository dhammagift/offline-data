  "sn2.19:0.1": "",
  "sn2.19:0.2": "",
  "sn2.19:0.3": "2. 2. 9. uttarasuttaṃ. ",
  "sn2.19:1.1": "rājageha – ",
  "sn2.19:1.2": "ekamantaṃ ṭhito kho uttaro devaputto bhagavato santike imaṃ gāthaṃ abhāsi: ",
  "sn2.19:2.1": "upanīyati jīvitamappamāyu ",
  "sn2.19:2.2": "jarūpanītassa na santi tāṇā, ",
  "sn2.19:2.3": "etaṃ bhayaṃ maraṇe pekkhamāno ",
  "sn2.19:2.4": "puññāni kayirātha sukhāvahāni. [bhagavā:] ",
  "sn2.19:3.1": "upanīyati jīvitamappamāyu ",
  "sn2.19:3.2": "jarūpanītassa na santi tāṇā, ",
  "sn2.19:3.3": "etaṃ bhayaṃ maraṇe pekkhamāno ",
  "sn2.19:3.4": "lokāmisaṃ pajahe santipekkhoti. "
}
