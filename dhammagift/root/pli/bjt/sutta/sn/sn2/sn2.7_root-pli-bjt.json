{
  "sn2.7:0.1": "",
  "sn2.7:0.2": "",
  "sn2.7:0.3": "2. 1. 7. pañcālacaṇḍasuttaṃ ",
  "sn2.7:1.1": "sāvatthiyaṃ– ",
  "sn2.7:1.2": "ekamantaṃ ṭhito kho pañcālacaṇḍo devaputto bhagavato santike imaṃ gāthaṃ abhāsi: ",
  "sn2.7:2.1": "sambādhe vata okāsaṃ ",
  "sn2.7:2.2": "avindi bhūrimedhaso, ",
  "sn2.7:2.3": "yo jhānamabudhā buddho ",
  "sn2.7:2.4": "patilīnanisabho munīti. ",
  "sn2.7:3.1": "sambādhe vāpi vindanti ",
  "sn2.7:3.2": "(pañcālacaṇḍāti bhagavā) ",
  "sn2.7:3.3": "dhammaṃ nibbāṇapattiyā, ",
  "sn2.7:3.4": "ye satiṃ paccalatthuṃ su ",
  "sn2.7:3.5": "sammā te susamāhitāti. "
}
