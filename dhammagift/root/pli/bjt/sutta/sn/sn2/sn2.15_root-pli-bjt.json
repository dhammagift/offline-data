  "sn2.15:0.1": "",
  "sn2.15:0.2": "",
  "sn2.15:0.3": "2. 2. 5. candanasuttaṃ. ",
  "sn2.15:1.1": "sāvatthiyaṃ– ekamantaṃ ṭhito kho candano devaputto bhagavantaṃ gāthāya ajjhabhāsi:– ",
  "sn2.15:2.1": "ko sū dha tarati oghaṃ ",
  "sn2.15:2.2": "rattindivamatandito, ",
  "sn2.15:2.3": "appatiṭṭhe anālambe ",
  "sn2.15:2.4": "ko gambhīre na sīdatīti. ",
  "sn2.15:3.1": "[bhagavā:] sabbadā sīlasampanno ",
  "sn2.15:3.2": "paññavā susamāhito, ",
  "sn2.15:3.3": "āraddhaviriyo pahitatto ",
  "sn2.15:3.4": "oghaṃ tarati duttaraṃ. ",
  "sn2.15:4.1": "virato kāmasaññāya ",
  "sn2.15:4.2": "rūpasaññojanātigo, ",
  "sn2.15:4.3": "nandirāgaparikkhīṇo ",
  "sn2.15:4.4": "so gambhīre na sīdatīti. "
}
