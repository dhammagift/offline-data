  "sn2.10:0.1": "",
  "sn2.10:0.2": "",
  "sn2.10:0.3": "2. 1. 10. sūriyasuttaṃ ",
  "sn2.10:1.1": "sāvatthiyaṃ– ",
  "sn2.10:1.2": "tena kho pana samayena suriyo devaputto rāhunā asurindena gahito hoti. ",
  "sn2.10:1.3": "atha kho suriyo devaputto bhagavantaṃ anussaramāno tāyaṃ velāyaṃ imaṃ gāthaṃ abhāsi: ",
  "sn2.10:2.1": "“namo te buddhavīratthu ",
  "sn2.10:2.2": "vippamuttosi sabbadhi, ",
  "sn2.10:2.3": "sambādhapaṭipannosmi ",
  "sn2.10:2.4": "tassa me saraṇaṃ bhavāti.” ",
  "sn2.10:3.1": "atha kho bhagavā suriyaṃ devaputtaṃ ārabbha rāhuṃ asurindaṃ gāthāhi ajjhabhāsi: ",
  "sn2.10:4.1": "“tathāgataṃ arahantaṃ ",
  "sn2.10:4.2": "suriyo saraṇaṃ gato, ",
  "sn2.10:4.3": "rāhu suriyaṃ pamuñcassu ",
  "sn2.10:4.4": "buddhā lokānukampakāti. ",
  "sn2.10:5.1": "yo andhakāre tamasī pabhaṅkaro ",
  "sn2.10:5.2": "verocano maṇḍalī uggatejo, ",
  "sn2.10:5.3": "mā rāhu gilī caraṃ antalikkhe ",
  "sn2.10:5.4": "pajaṃ mama rāhu pamuñca sūriyanti.” ",
  "sn2.10:6.1": "atha kho rāhu asurindo suriyaṃ devaputtaṃ muñcitvā taramānarūpo yena vepacitti asurindo tenupasaṅkami. upasaṅkamitvā saṃviggo lomahaṭṭhajāto ekamantaṃ aṭṭhāsi. ",
  "sn2.10:6.2": "ekamantaṃ ṭhitaṃ kho rāhuṃ asurindaṃ vepacitti asurindo gāthāya ajjhabhāsi: ",
  "sn2.10:7.1": "“kinnu santaramānova ",
  "sn2.10:7.2": "rāhu suriyaṃ pamuñcasi, ",
  "sn2.10:7.3": "saṃviggarūpo āgamma ",
  "sn2.10:7.4": "kinnu bhītova tiṭṭhasīti.” ",
  "sn2.10:8.1": "“sattadhā me phale muddhā ",
  "sn2.10:8.2": "jīvanto na sukhaṃ labhe, ",
  "sn2.10:8.3": "buddhagāthābhigītomhi ",
  "sn2.10:8.4": "no ce muñceyya sūriyanti.” suriyavaggo ",
  "sn2.10:8.5": "paṭhamo tatruddānaṃ: ",
  "sn2.10:9.0": "",
  "sn2.10:9.1": "dve kassapā ca māgho ca ",
  "sn2.10:9.2": "māgadho dāmali kāmado, ",
  "sn2.10:9.3": "pañcālacaṇḍo tāyano ",
  "sn2.10:9.4": "candimasuriyena te dasāti. "
}
