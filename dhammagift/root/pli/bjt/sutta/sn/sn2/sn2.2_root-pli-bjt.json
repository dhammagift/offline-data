{
  "sn2.2:0.1": "",
  "sn2.2:0.2": "",
  "sn2.2:0.3": "2. 1. 2. dutiyakassapasuttaṃ ",
  "sn2.2:1.1": "sāvatthiyaṃ– ",
  "sn2.2:1.2": "ekamantaṃ ṭhito kho kassapo devaputto bhagavato santike imaṃ gāthaṃ abhāsi: ",
  "sn2.2:2.1": "bhikkhu siyā jhāyī vimuttacitto ",
  "sn2.2:2.2": "ākaṅkhe ce hadayassānupattiṃ,lokassa ",
  "sn2.2:2.3": "ñatvā udayabbayañca ",
  "sn2.2:2.4": "sucetaso anissito tadānisaṃsoti. "
}
