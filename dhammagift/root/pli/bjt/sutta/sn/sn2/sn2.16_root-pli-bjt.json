  "sn2.16:0.1": "",
  "sn2.16:0.2": "",
  "sn2.16:0.3": "2. 2. 6. vasudattasuttaṃ. ",
  "sn2.16:1.1": "sāvatthiyaṃ– ekamantaṃ ṭhito kho vasudatto devaputto bhagavato santike imaṃ gāthaṃ abhāsi:– ",
  "sn2.16:2.1": "sattiyā viya omaṭṭho ",
  "sn2.16:2.2": "ḍayhamānova matthake, ",
  "sn2.16:2.3": "kāmarāgappahāṇāya ",
  "sn2.16:2.4": "sato bhikkhu paribbajeti. ",
  "sn2.16:3.1": "[bhagavā:] sattiyā viya omaṭṭho ",
  "sn2.16:3.2": "ḍayhamānova matthake, ",
  "sn2.16:3.3": "sakkāyadiṭṭhippahāṇāya ",
  "sn2.16:3.4": "sato bhikkhu paribbajeti. "
}
