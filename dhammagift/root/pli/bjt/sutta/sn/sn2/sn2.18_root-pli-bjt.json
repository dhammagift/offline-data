{
  "sn2.18:0.1": "",
  "sn2.18:0.2": "",
  "sn2.18:0.3": "2. 2. 8. kakudhasuttaṃ. ",
  "sn2.18:1.1": "sāvatthiyaṃ– evaṃ me sutaṃ ",
  "sn2.18:1.2": "ekaṃ samayaṃ bhagavā sākete viharati añjanavane migadāye. ",
  "sn2.18:1.3": "atha kho kakudho devaputto abhikkantāya rattiyā abhikkantavaṇṇo kevalakappaṃ añjanavanaṃ obhāsetvā yena bhagavā tenupasaṅkami. upasaṅkamitvā bhagavantaṃ abhivādetvā ekamantaṃ aṭṭhāsi. ekamantaṃ ṭhito kho kakudho devaputto bhagavantaṃ etadavoca: ",
  "sn2.18:1.4": "nandasi samaṇāti? ",
  "sn2.18:1.5": "kiṃ laddhā āvusoti? ",
  "sn2.18:1.6": "tena hi samaṇa socasīti? ",
  "sn2.18:1.7": "kiṃ jīyittha āvusoti? ",
  "sn2.18:1.8": "tena hi samaṇa neva nandasi neva socasīti? ",
  "sn2.18:1.9": "evamāvusoti. ",
  "sn2.18:2.1": "kacci tvaṃ anagho bhikkhu ",
  "sn2.18:2.2": "kacci nandi na vijjati, ",
  "sn2.18:2.3": "kacci taṃ ekamāsīnaṃ ",
  "sn2.18:2.4": "aratī nābhikīratīti. ",
  "sn2.18:3.1": "[bhagavā:] anīgho ve ahaṃ yakkha ",
  "sn2.18:3.2": "atho nandi na vijjati, ",
  "sn2.18:3.3": "atho maṃ ekamāsīnaṃ ",
  "sn2.18:3.4": "aratī nābhikīratīti. ",
  "sn2.18:4.1": "[devaputto:] kathaṃ tvaṃ anagho bhikkhu ",
  "sn2.18:4.2": "kathaṃ nandi na vijjati, ",
  "sn2.18:4.3": "kathaṃ taṃ ekamāsīnaṃ ",
  "sn2.18:4.4": "aratī nābhikīratīti. ",
  "sn2.18:5.1": "[bhagavā:] aghajātassa ve nandi ",
  "sn2.18:5.2": "nandijātassa ve aghaṃ, ",
  "sn2.18:5.3": "anandi anagho bhikkhu ",
  "sn2.18:5.4": "evaṃ jānāhi āvusoti. ",
  "sn2.18:6.1": "[devaputto:] cirassaṃ vata passāmi ",
  "sn2.18:6.2": "brāhmaṇaṃ parinibbutaṃ, ",
  "sn2.18:6.3": "anandiṃ anaghaṃ bhikkhuṃ ",
  "sn2.18:6.4": "tiṇṇaṃ loke visattikanti. "
}
