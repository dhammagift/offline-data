{
  "sn2.28:0.1": "",
  "sn2.28:0.2": "",
  "sn2.28:0.3": "2. 3. 8. nandivisālasuttaṃ. ",
  "sn2.28:1.1": "sāvatthiyaṃ– ekamantaṃ ṭhito kho nandivisālo devaputto bhagavantaṃ gāthāya ajjhabhāsi:- ",
  "sn2.28:2.1": "catucakkaṃ navadvāraṃ ",
  "sn2.28:2.2": "puṇṇaṃ lobhena saṃyutaṃ, ",
  "sn2.28:2.3": "paṅkajātaṃ mahāvīra ",
  "sn2.28:2.4": "kathaṃ yātrā bhavissatīti. ",
  "sn2.28:3.1": "[bhagavā:] chetvā naddhiṃ varattañca ",
  "sn2.28:3.2": "icchā lobhañca pāpakaṃ, ",
  "sn2.28:3.3": "samūlaṃ taṇhaṃ abbuyha ",
  "sn2.28:3.4": "evaṃ yātrā bhavissatīti. "
}
