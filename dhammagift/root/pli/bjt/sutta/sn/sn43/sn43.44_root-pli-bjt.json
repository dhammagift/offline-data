{
  "sn43.44:0.1": "",
  "sn43.44:0.2": "",
  "sn43.44:0.3": "9. 2. 1782-1837. parāyaṇasuttāni ",
  "sn43.44:1.1": "parāyaṇañca vo bhikkhave desissāmi parāyaṇagāmiñca maggaṃ. ",
  "sn43.44:1.2": "taṃ suṇātha. ",
  "sn43.44:1.3": "katamañca bhikkhave parāyaṇaṃ: ",
  "sn43.44:1.4": "yo bhikkhave rāgakkhayo dosakkhayo mohakkhayo, ",
  "sn43.44:1.5": "idaṃ vuccati bhikkhave parāyaṇaṃ. ",
  "sn43.44:1.6": "katamo ca bhikkhave parāyaṇagāmī maggo: ",
  "sn43.44:1.7": "kāyagatāsati. ",
  "sn43.44:1.8": "ayaṃ vuccati bhikkhave parāyaṇagāmi maggo. ",
  "sn43.44:1.9": "iti kho bhikkhave desitaṃ vo mayā parāyaṇaṃ, desito parāyaṇagāmīmaggo. ",
  "sn43.44:1.10": "yaṃ bhikkhave satthārā karaṇīyaṃ sāvakānaṃ hitesinā anukampakena, anukampaṃ upādāya. kataṃ vo taṃ mayā. ",
  "sn43.44:1.11": "etāni bhikkhave rukkhamūlāni, etāni suññāgārāni. jhāyatha bhikkhave, mā pamādattha, mā pacchā vippaṭisārino ahuvattha. ayaṃ vo amhākaṃ anusāsanīti. ",
  "sn43.44:1.12": "(yathā asaṅkhataṃ tathā vitthāretabbaṃ). ",
  "sn43.44:1.13": "dutiyaasaṅkhatavaggo. tatruddānaṃ: ",
  "sn43.44:1.14": "",
  "sn43.44:2.0": "",
  "sn43.44:2.1": "asaṅkhataṃ antaṃ anāsavaṃ ",
  "sn43.44:2.2": "saccañca pāraṃ nipuṇaṃ sududdasaṃ ",
  "sn43.44:2.3": "ajarattaṃ dhuvaṃ apalokitaṃ ",
  "sn43.44:2.4": "anidassanaṃ nippapañca santaṃ ",
  "sn43.44:3.1": "amataṃ paṇītañca sivañca khemaṃ ",
  "sn43.44:3.2": "taṇhakkhayo acchariyañca abbhutaṃ ",
  "sn43.44:3.3": "anītikaṃ anītikadhammaṃ ",
  "sn43.44:3.4": "nibbānametaṃ sugatena desitaṃ ",
  "sn43.44:4.1": "abyāpajjho virāgo ca ",
  "sn43.44:4.2": "suddhi mutti anālayo ",
  "sn43.44:4.3": "dīpo leṇañca tāṇañca ",
  "sn43.44:4.4": "saraṇañca parāyaṇañcāti. ",
  "sn43.44:4.5": ""
}
