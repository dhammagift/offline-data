{
  "sn17.13-20:0.1": "",
  "sn17.13-20:0.2": "",
  "sn17.13-20:0.3": "5. 2. 3-10. suvaṇṇanikkhasuttādiaṭṭhakaṃ. ",
  "sn17.13-20:1.1": "sāvatthiyaṃ– [dāruṇo bhikkhave, lābhasakkārasiloko …pe…] ",
  "sn17.13-20:1.2": "idhāhaṃ bhikkhave, ekaccaṃ puggalaṃ evaṃ cetasā ceto paricca pajānāmi: ",
  "sn17.13-20:1.3": "na cāyamāyasmā - suvaṇṇanikkhassāpi hetu …pe… (tatiyaṃ) ",
  "sn17.13-20:1.4": "suvaṇṇanikkhasatassāpi hetu …pe… (catutthaṃ) ",
  "sn17.13-20:1.5": "siṅgīnikkhassapi hetu …pe… (pañcamaṃ) ",
  "sn17.13-20:1.6": "siṅgīnikkhasatassāpi hetu …pe… (chaṭṭhaṃ) ",
  "sn17.13-20:1.7": "paṭhaviyāpi jātarūpaparipūrāya hetu …pe… (sattamaṃ) ",
  "sn17.13-20:1.8": "āmisakiñcikkhahetupi …pe… (aṭṭhamaṃ) ",
  "sn17.13-20:1.9": "jīvitahetupi …pe… (navamaṃ) ",
  "sn17.13-20:1.10": "janapadakalyāṇiyāpi hetu sampajānamusā bhāseyyāti. ",
  "sn17.13-20:1.11": "tamenaṃ passāmi aparena samayena lābhasakkārasilokena abhibhūtaṃ pariyādinnacittaṃ sampajānamusā bhāsantaṃ. ",
  "sn17.13-20:1.12": "evaṃ dāruṇo kho bhikkhave, lābhasakkārasiloko …pe… ",
  "sn17.13-20:1.13": "[uppannaṃ lābhasakkārasilokaṃ pajahissāma …pe…] evaṃ hi vo bhikkhave, sikkhitabbanti. ",
  "sn17.13-20:1.14": "(dasamaṃ) pātivaggo ",
  "sn17.13-20:1.15": "dutiyo. ",
  "sn17.13-20:2.0": "tassuddānaṃ: ",
  "sn17.13-20:2.1": "dve pāti dve suvaṇṇā ",
  "sn17.13-20:2.2": "siṅgīhi apare duve, ",
  "sn17.13-20:2.3": "paṭhavī kiñcikkha jīvitaṃ ",
  "sn17.13-20:2.4": "janapadakalyāṇiyā dasāti. "
}
