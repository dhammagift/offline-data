{
  "sn4.15:0.1": "",
  "sn4.15:0.2": "",
  "sn4.15:0.3": "4. 2. 5. mānasasuttaṃ. ",
  "sn4.15:1.1": "evaṃ me sutaṃ: ",
  "sn4.15:1.2": "ekaṃ samayaṃ bhagavā sāvatthiyaṃ viharati jetavane anāthapiṇḍikassa ārāme. ",
  "sn4.15:1.3": "atha kho māro pāpimā yena bhagavā tenupasaṅkami. upasaṅkamitvā bhagavantaṃ gāthāya ajjhabhāsi: ",
  "sn4.15:2.1": "antalikkhacaro pāso ",
  "sn4.15:2.2": "yoyaṃ carati mānaso, ",
  "sn4.15:2.3": "tena taṃ bādhayissāmi ",
  "sn4.15:2.4": "na me samaṇa mokkhasīti. ",
  "sn4.15:3.1": "[bhagavā:] rūpā saddā rasā gandhā ",
  "sn4.15:3.2": "phoṭṭhabbā ca manoramā, ",
  "sn4.15:3.3": "ettha me vigato chando ",
  "sn4.15:3.4": "nihato tvamasi antakāti. ",
  "sn4.15:4.1": "atha kho māro pāpimā …pe… tatthevantaradhāyīti. "
}
