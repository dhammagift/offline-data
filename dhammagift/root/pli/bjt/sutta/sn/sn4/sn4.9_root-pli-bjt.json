{
  "sn4.9:0.1": "",
  "sn4.9:0.2": "",
  "sn4.9:0.3": "4. 1. 9. paṭhamaāyusuttaṃ. ",
  "sn4.9:1.1": "evaṃ me sutaṃ: ",
  "sn4.9:1.2": "ekaṃ samayaṃ bhagavā rājagahe viharati veḷuvane kalandakanivāpe. ",
  "sn4.9:1.3": "tatra kho bhagavā bhikkhū āmantesi, ",
  "sn4.9:1.4": "bhikkhavoti. ",
  "sn4.9:1.5": "bhadanteti te bhikkhū bhagavato paccassosuṃ. ",
  "sn4.9:1.6": "bhagavā etadavoca: ",
  "sn4.9:2.1": "appamidaṃ bhikkhave manussānaṃ āyu, ",
  "sn4.9:2.2": "gamanīyo samparāyo, kattabbaṃ kusalaṃ, caritabbaṃ brahmacariyaṃ, ",
  "sn4.9:2.3": "natthi jātassa amaraṇaṃ. ",
  "sn4.9:2.4": "yo bhikkhave ciraṃ jīvati, so vassasataṃ appaṃ vā bhiyyoti. ",
  "sn4.9:3.1": "atha kho māro pāpimā yena bhagavā tenupasaṅkami. upasaṅkamitvā bhagavantaṃ gāthāya ajjhabhāsi: ",
  "sn4.9:4.1": "dīghamāyu manussānaṃ ",
  "sn4.9:4.2": "na naṃ hīḷe suporiso, ",
  "sn4.9:4.3": "careyya khīramattova ",
  "sn4.9:4.4": "natthi maccussa āgamoti. ",
  "sn4.9:5.1": "[bhagavā:] appamāyu manussānaṃ ",
  "sn4.9:5.2": "hīḷeyya naṃ suporiso, ",
  "sn4.9:5.3": "careyyādittasīsova ",
  "sn4.9:5.4": "natthi maccussa nāgamoti. ",
  "sn4.9:6.1": "atha kho māro pāpimā -pe- tatthevantaradhāyīti. "
}
