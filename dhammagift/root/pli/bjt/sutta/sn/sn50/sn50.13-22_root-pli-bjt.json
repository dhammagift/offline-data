{
  "sn50.13-22:0.1": "",
  "sn50.13-22:0.2": "2. appamādavaggo ",
  "sn50.13-22:0.3": "6. 2. 1-10. tathāgatādi suttāni ",
  "sn50.13-22:1.1": "yāvatā bhikkhave sattā apadā vā dipadā vā …pe… bahulīkarotīti. (vivekanissitādivasena vitthāretabbāni.) appamādavaggo dutiyo. ",
  "sn50.13-22:2.0": "tatruddānaṃ: ",
  "sn50.13-22:2.1": "tathāgataṃ padaṃ kūṭaṃ ",
  "sn50.13-22:2.2": "mūlaṃ sārena vassikaṃ, ",
  "sn50.13-22:2.3": "rājā candima sūriyā ca ",
  "sn50.13-22:2.4": "vatthena dasamaṃ padanti. "
}
