{
  "sn50.35-44:0.1": "",
  "sn50.35-44:0.2": "4. esanāvaggo ",
  "sn50.35-44:0.3": "6. 4. 1-40. esanādi suttāni ",
  "sn50.35-44:1.1": "tisso imā bhikkhave, esanā. katamā tisso: …pe… bhāvetabbānīti. (vitthāretabbāni.) esanāvaggo catuttho. ",
  "sn50.35-44:2.0": "tatruddānaṃ: ",
  "sn50.35-44:2.1": "esanā vidhā āsavo ",
  "sn50.35-44:2.2": "bhavo ca dukkhatā ca tisso ",
  "sn50.35-44:2.3": "khilaṃ malañca nīgho ca ",
  "sn50.35-44:2.4": "vedanā taṇhāhi cāti. "
}
