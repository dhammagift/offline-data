  "sn50.55-66:0.1": "",
  "sn50.55-66:0.2": "6. punagaṅgāpeyyālo ",
  "sn50.55-66:0.3": "6. 6. 1-36. pācīnaninnādi suttāni ",
  "sn50.55-66:1.1": "seyyathāpi bhikkhave, gaṅgā nadī pācīnaninnā …pe… ",
  "sn50.55-66:1.2": "",
  "sn50.55-66:1.3": "",
  "sn50.55-66:1.4": "",
  "sn50.55-66:1.5": "nibbānapabbhāroti. (rāgavinayapariyosānādivasena amatogadhādivasena nibbānaninnādivasena cāti ekekasmiṃ tayo tayo katvā chattiṃsa suttantā ",
  "sn50.55-66:1.6": "vitthāretabbā.) ",
  "sn50.55-66:1.7": "punagaṅgāpeyyāli. ",
  "sn50.55-66:1.8": "tatruddānaṃ: ",
  "sn50.55-66:2.0": "",
  "sn50.55-66:2.1": "cha pācīnato ninnā ",
  "sn50.55-66:2.2": "cha ca ninnā samuddato, ",
  "sn50.55-66:2.3": "ete dve dvādasa honti ",
  "sn50.55-66:2.4": "vaggo tena pavuccatīti. "
}
