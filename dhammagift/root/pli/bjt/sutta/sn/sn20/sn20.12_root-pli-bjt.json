{
  "sn20.12:0.1": "",
  "sn20.12:0.2": "",
  "sn20.12:0.3": "8. 1. 12. dutiyasigālasuttaṃ. ",
  "sn20.12:1.1": "sāvatthiyaṃ– ",
  "sn20.12:1.2": "assuttha no tumhe bhikkhave, rattiyā paccūsasamayaṃ sigālassa vassamānassāti? ",
  "sn20.12:1.3": "evaṃ bhante. ",
  "sn20.12:1.4": "siyā kho bhikkhave, tasmiṃ jarasigāle yā kāci kataññutā kataveditā. na tveva idhekacce sakyaputtiyapaṭiññe siyā kāci kataññutā kataveditā. ",
  "sn20.12:1.5": "tasmātiha bhikkhave, evaṃ sikkhitabbaṃ: ",
  "sn20.12:1.6": "“kataññuno bhavissāma katavedino. ",
  "sn20.12:1.7": "amhesu appakampi kataṃ mā nassissatī”ti. ",
  "sn20.12:1.8": "evaṃ hi vo bhikkhave, sikkhitabbanti. ",
  "sn20.12:1.9": "vaggo ",
  "sn20.12:1.10": "paṭhamo ",
  "sn20.12:2.0": "tassuddānaṃ : ",
  "sn20.12:2.1": "kūṭaṃ nakhasikhaṃ kulaṃ ",
  "sn20.12:2.2": "okkhā satti dhanuggaho, ",
  "sn20.12:2.3": "āṇi kaliṅgaro nāgo ",
  "sn20.12:2.4": "biḷālo dve sigālakāti. ",
  "sn20.12:2.5": ""
}
