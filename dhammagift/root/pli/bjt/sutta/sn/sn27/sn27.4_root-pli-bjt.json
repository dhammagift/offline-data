{
  "sn27.4:0.1": "",
  "sn27.4:0.2": "",
  "sn27.4:0.3": "6. 1. 4. phassa suttaṃ ",
  "sn27.4:1.1": "sāvatthiyaṃ: ",
  "sn27.4:1.2": "yo bhikkhave, cakkhusamphassasmiṃ chandarāgo, cittasse’so upakkileso. ",
  "sn27.4:1.3": "yo sotasamphassasmiṃ chandarāgo …pe… ",
  "sn27.4:1.4": "yo ghānasamphassasmiṃ chandarāgo …pe… ",
  "sn27.4:1.5": "yo jivhāsamphassasmiṃ chandarāgo …pe… ",
  "sn27.4:1.6": "yo kāyasamphassasmiṃ chandarāgo …pe… ",
  "sn27.4:1.7": "yo manosamphassasmiṃ chandarāgo, cittasse’so upakkileso. ",
  "sn27.4:1.8": "yato kho bhikkhave, bhikkhuno …pe… kammaniyaṃ khāyati ",
  "sn27.4:1.9": "abhiññā sacchikaraṇīyesu dhammesūti. ",
  "sn27.4:1.10": ""
}
