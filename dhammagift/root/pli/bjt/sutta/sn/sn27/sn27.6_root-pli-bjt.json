{
  "sn27.6:0.1": "",
  "sn27.6:0.2": "",
  "sn27.6:0.3": "6. 1. 6. saññā suttaṃ ",
  "sn27.6:1.1": "sāvatthiyaṃ: ",
  "sn27.6:1.2": "yo bhikkhave, rūpasaññāya chandarāgo, cittasse’so upakkileso. ",
  "sn27.6:1.3": "yo saddasaññāya chandarāgo …pe… ",
  "sn27.6:1.4": "yo gandhasaññāya chandarāgo …pe… ",
  "sn27.6:1.5": "yo rasasaññāya chandarāgo …pe… ",
  "sn27.6:1.6": "yo phoṭṭhabbasaññāya chandarāgo …pe… ",
  "sn27.6:1.7": "yo dhammasaññāya chandarāgo, cittasse’so upakkileso. ",
  "sn27.6:1.8": "yato kho bhikkhave, bhikkhuno …pe… kammaniyaṃ khāyati ",
  "sn27.6:1.9": "abhiññā sacchikaraṇīyesu dhammesūti. ",
  "sn27.6:1.10": ""
}
