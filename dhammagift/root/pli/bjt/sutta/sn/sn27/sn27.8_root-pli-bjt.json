  "sn27.8:0.1": "",
  "sn27.8:0.2": "",
  "sn27.8:0.3": "6. 1. 8. taṇhā suttaṃ ",
  "sn27.8:1.1": "sāvatthiyaṃ: ",
  "sn27.8:1.2": "yo bhikkhave, rūpataṇhāya chandarāgo, cittasse’so upakkileso. ",
  "sn27.8:1.3": "yo saddataṇhāya chandarāgo …pe… ",
  "sn27.8:1.4": "yo gandhataṇhāya chandarāgo …pe… ",
  "sn27.8:1.5": "yo rasataṇhāya chandarāgo …pe… ",
  "sn27.8:1.6": "yo phoṭṭhabbataṇhāya chandarāgo …pe… ",
  "sn27.8:1.7": "yo dhammataṇhāya chandarāgo, cittasse’so upakkileso. ",
  "sn27.8:1.8": "yato kho bhikkhave, bhikkhuno …pe… ",
  "sn27.8:1.9": "abhiññā sacchikaraṇīyesu dhammesūti. ",
  "sn27.8:1.10": ""
}
