{
  "sn27.7:0.1": "",
  "sn27.7:0.2": "",
  "sn27.7:0.3": "6. 1. 7. cetanā suttaṃ ",
  "sn27.7:1.1": "sāvatthiyaṃ: ",
  "sn27.7:1.2": "yo bhikkhave, rūpasañcetanāya chandarāgo, cittasse’so upakkileso. ",
  "sn27.7:1.3": "yo saddasañcetanāya chandarāgo …pe… ",
  "sn27.7:1.4": "yo gandhasañcetanāya chandarāgo …pe… ",
  "sn27.7:1.5": "yo rasasañcetanāya chandarāgo …pe… ",
  "sn27.7:1.6": "yo phoṭṭhabbasañcetanāya chandarāgo …pe… ",
  "sn27.7:1.7": "yo dhammasañcetanāya chandarāgo, cittasse’so upakkileso. ",
  "sn27.7:1.8": "yato kho bhikkhave, bhikkhuno …pe… kammaniyaṃ khāyati ",
  "sn27.7:1.9": "abhiññā sacchikaraṇīyesu dhammesūti. ",
  "sn27.7:1.10": ""
}
