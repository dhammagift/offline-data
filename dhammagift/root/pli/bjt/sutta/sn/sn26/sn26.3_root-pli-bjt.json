{
  "sn26.3:0.1": "",
  "sn26.3:0.2": "",
  "sn26.3:0.3": "5. 1. 3. viññāṇa suttaṃ ",
  "sn26.3:1.1": "sāvatthiyaṃ: ",
  "sn26.3:1.2": "yo bhikkhave, cakkhuviññāṇassa uppādo ṭhiti …pe… ",
  "sn26.3:1.3": "",
  "sn26.3:1.4": "manoviññāṇassa uppādo ṭhiti …pe… ",
  "sn26.3:1.5": "jarāmaraṇassa pātubhāvo. ",
  "sn26.3:1.6": "yo ca kho bhikkhave, cakkhuviññāṇassa nirodho …pe… ",
  "sn26.3:1.7": "",
  "sn26.3:1.8": "yo manoviññāṇassa nirodho …pe… ",
  "sn26.3:1.9": "jarāmaraṇassa atthagamoti. ",
  "sn26.3:1.10": ""
}
