{
  "sn26.4:0.1": "",
  "sn26.4:0.2": "",
  "sn26.4:0.3": "5. 1. 4. phassa suttaṃ ",
  "sn26.4:1.1": "sāvatthiyaṃ: ",
  "sn26.4:1.2": "yo bhikkhave, cakkhusamphassassa uppādo ṭhiti ",
  "sn26.4:1.3": "…pe… ",
  "sn26.4:1.4": "yo manosamphassassa uppādo ṭhiti …pe… ",
  "sn26.4:1.5": "jarāmaraṇassa pātubhāvo. ",
  "sn26.4:1.6": "yo ca kho bhikkhave, cakkhusamphassassa nirodho vūpasamo …pe… ",
  "sn26.4:1.7": "",
  "sn26.4:1.8": "manosamphassassa nirodho vūpasamo ",
  "sn26.4:1.9": "jarāmaraṇassa atthagamoti. ",
  "sn26.4:1.10": ""
}
