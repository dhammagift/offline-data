{
  "sn23.22:0.1": "",
  "sn23.22:0.2": "",
  "sn23.22:0.3": "2. 2. 12. nirodhadhamma suttaṃ ",
  "sn23.22:1.1": "sāvatthiyaṃ: ",
  "sn23.22:1.2": "ekamantaṃ nisinno kho āyasmā rādho bhagavantaṃ etadavoca : ",
  "sn23.22:1.3": "“nirodhadhammo, nirodhadhammo”ti bhante vuccati. ",
  "sn23.22:1.4": "katamo nu kho bhante, nirodhadhammoti. ",
  "sn23.22:1.5": "rūpaṃ kho rādha, nirodhadhammo vedanā nirodhadhammo saññā nirodhadhammo, saṅkhārā nirodhadhammo viññāṇaṃ nirodhadhammo. ",
  "sn23.22:1.6": "evaṃ passaṃ rādha sutavā ariyasāvako …pe… ",
  "sn23.22:1.7": "nāparaṃ itthattāyāti pajānātīti. ",
  "sn23.22:1.8": "",
  "sn23.22:1.9": "dutiya māravaggo tatruddānaṃ: ",
  "sn23.22:2.0": "",
  "sn23.22:2.1": "māro ca māradhammo ca ",
  "sn23.22:2.2": "aniccena’pare duve ",
  "sn23.22:2.3": "dukkhena ca duve vuttā ",
  "sn23.22:2.4": "anattena tatheva ca ",
  "sn23.22:2.5": "khayavayasamudayadhammā ",
  "sn23.22:2.6": "nirodhadhammena dvādasāti. "
}
