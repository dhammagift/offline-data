{
  "sn36.3:0.1": "",
  "sn36.3:0.2": "",
  "sn36.3:0.3": "1. 20. 3. pahānasuttaṃ ",
  "sn36.3:1.1": "tisso imā bhikkhave vedanā. ",
  "sn36.3:1.2": "katamā tisso: ",
  "sn36.3:1.3": "sukhā vedanā dukkhā vedanā adukkhamasukhāvedanā. ",
  "sn36.3:1.4": "sukhāya bhikkhave vedanāya rāgānusayo pahātabbo, dukkhāya vedanāya paṭighānusayo pahātabbo, adukkhamasukhāya vedanāya avijjānusayo pahātabbo. ",
  "sn36.3:1.5": "yato kho bhikkhave, bhikkhuno sukhāya vedanāya rāgānusayo pahīno hoti, dukkhāya vedanāya paṭighānusayo pahīno hoti, adukkhamasukhāya vedanāya avijjānusayo pahīno hoti, ayaṃ vuccati bhikkhave bhikkhu pahīnarāgānusayo acchecchi taṇhaṃ, vāvattayī saññojanaṃ sammāmānābhisamayā antamakāsi dukkhassāti. ",
  "sn36.3:2.1": "sukhaṃ vediyamānassa ",
  "sn36.3:2.2": "vedanaṃ appajānato ",
  "sn36.3:2.3": "so rāgānusayo hoti ",
  "sn36.3:2.4": "anissaraṇadassino. ",
  "sn36.3:3.1": "dukkhaṃ vediyamānassa ",
  "sn36.3:3.2": "vedanaṃ appajānato ",
  "sn36.3:3.3": "paṭighānusayo hoti ",
  "sn36.3:3.4": "anissaraṇadassino. ",
  "sn36.3:4.1": "adukkhamasukhaṃ santaṃ ",
  "sn36.3:4.2": "bhūripaññena desitaṃ ",
  "sn36.3:4.3": "taṃ cāpi abhinandanto ",
  "sn36.3:4.4": "neva dukkhā pamuccati. ",
  "sn36.3:5.1": "yato vā bhikkhu ātāpī ",
  "sn36.3:5.2": "sampajaññaṃ na riñcati ",
  "sn36.3:5.3": "tato so vedanā sabbā ",
  "sn36.3:5.4": "parijānāti paṇḍito. ",
  "sn36.3:6.1": "so vedanā pariññāya ",
  "sn36.3:6.2": "diṭṭhe dhamme anāsavo ",
  "sn36.3:6.3": "kāyassa bhedā dhammaṭṭho ",
  "sn36.3:6.4": "saṅkhaṃ nopeti vedagūti. ",
  "sn36.3:6.5": ""
}
