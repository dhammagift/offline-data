  "sn36.22:0.1": "",
  "sn36.22:0.2": "",
  "sn36.22:0.3": "2. 3. 2. aṭṭhasatapariyāyasuttaṃ ",
  "sn36.22:1.1": "aṭṭhasatapariyāyaṃ vo bhikkhave dhammapariyāyaṃ desissāmi. ",
  "sn36.22:1.2": "taṃ suṇātha. ",
  "sn36.22:1.3": "katamo ca bhikkhave aṭṭhasatapariyāyo dhammapariyāyo: ",
  "sn36.22:1.4": "dvepi mayā bhikkhave vedanā vuttā pariyāyena, ",
  "sn36.22:1.5": "tissopi mayā vedanā vuttā pariyāyena, ",
  "sn36.22:1.6": "pañcapi mayā vedanā vuttā pariyāyena, ",
  "sn36.22:1.7": "chapi mayā vedanā vuttā pariyāyena, ",
  "sn36.22:1.8": "aṭṭhārasāpi mayā vedanā vuttā pariyāyena, ",
  "sn36.22:1.9": "chattiṃsāpi mayā vedanā vuttā pariyāyena, ",
  "sn36.22:1.10": "aṭṭhasatampi mayā vedanā vuttā pariyāyena. ",
  "sn36.22:2.1": "katamā ca bhikkhave dve vedanā: ",
  "sn36.22:2.2": "kāyikā ca cetasikā ca, ",
  "sn36.22:2.3": "imā vuccanti bhikkhave dve vedanā. ",
  "sn36.22:2.4": "katamā ca bhikkhave tisso vedanā: ",
  "sn36.22:2.5": "sukhā vedanā dukkhā vedanā adukkhamasukhā vedanā, ",
  "sn36.22:2.6": "imā vuccanti bhikkhave tisso vedanā. ",
  "sn36.22:2.7": "katamā ca bhikkhave pañca vedanā: ",
  "sn36.22:2.8": "sukhindriyaṃ dukkhindriyaṃ somanassindriyaṃ domanassindriyaṃ upekkhindriyaṃ, ",
  "sn36.22:2.9": "imā vuccanti bhikkhave pañca vedanā. ",
  "sn36.22:2.10": "katamā ca bhikkhave cha vedanā: ",
  "sn36.22:2.11": "cakkhusamphassajā vedanā sota …pe… ghāna …pe… jivhā …pe… kāya …pe… ",
  "sn36.22:2.12": "manosamphassajā vedanā, ",
  "sn36.22:2.13": "imā vuccanti bhikkhave cha vedanā. ",
  "sn36.22:2.14": "katamā ca bhikkhave aṭṭhārasa vedanā: ",
  "sn36.22:2.15": "cha somanassūpavicārā cha domanassūpavicārā cha upekkhūpavicārā, ",
  "sn36.22:2.16": "imā vuccanti bhikkhave aṭṭhārasa vedanā. ",
  "sn36.22:2.17": "katamā ca bhikkhave chattiṃsa vedanā: ",
  "sn36.22:2.18": "cha gehasitāni somanassāni cha nekkhammasitāni somanassāni cha gehasitāni domanassāni cha nekkhammasitāni domanassāni cha gehasitā upekkhā cha nekkhammasitā upekkhā, ",
  "sn36.22:2.19": "imā vuccanti bhikkhave chattiṃsa vedanā. ",
  "sn36.22:2.20": "katamā ca bhikkhave aṭṭhasata vedanā: ",
  "sn36.22:2.21": "atītā chattiṃsa vedanā, anāgatā chattiṃsa vedanā, paccuppannā chattiṃsa vedanā, ",
  "sn36.22:2.22": "imā vuccanti bhikkhave aṭṭhasatavedanā. ",
  "sn36.22:2.23": "ayaṃ bhikkhave aṭṭhasatapariyāyo dhammapariyāyoti. ",
  "sn36.22:2.24": ""
}
