{
  "sn53.35-44:0.1": "",
  "sn53.35-44:0.2": "4. esanāvaggo ",
  "sn53.35-44:0.3": "9. 4. 1-40. esanādisuttāni ",
  "sn53.35-44:1.1": "tisso imā bhikkhave, esanā. katamā tisso? kāmesanā bhavesanā brahmacariyesanā …pe… bhāvetabbāti. esanāvaggo catuttho. ",
  "sn53.35-44:2.0": "tatruddānaṃ: ",
  "sn53.35-44:2.1": "esanā vidhā āsavo ",
  "sn53.35-44:2.2": "bhavo dukkhatā ca tisso ",
  "sn53.35-44:2.3": "khilaṃ malañca nīgho ca ",
  "sn53.35-44:2.4": "vedanā taṇhāhi cāti. "
}
