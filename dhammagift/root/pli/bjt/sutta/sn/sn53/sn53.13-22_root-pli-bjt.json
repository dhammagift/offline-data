{
  "sn53.13-22:0.1": "",
  "sn53.13-22:0.2": "2. appamādavaggo ",
  "sn53.13-22:0.3": "9. 2. 1-10. tathāgatādisuttāni ",
  "sn53.13-22:1.1": "yāvatā bhikkhave, sattā apadā vā dipadā vā catuppadā vā bahuppadā vā …pe… bahulīkarotīti. appamādavaggo dutiyo. ",
  "sn53.13-22:2.0": "tatruddānaṃ: ",
  "sn53.13-22:2.1": "tathāgataṃ padaṃ kūṭaṃ ",
  "sn53.13-22:2.2": "mūlaṃ sārena vassikaṃ, ",
  "sn53.13-22:2.3": "rājā candimasūriyā ca ",
  "sn53.13-22:2.4": "vatthena dasamaṃ padanti. "
}
