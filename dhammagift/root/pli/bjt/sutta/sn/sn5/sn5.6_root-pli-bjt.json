{
  "sn5.6:0.1": "",
  "sn5.6:0.2": "",
  "sn5.6:0.3": "5. 1. 6. cālāsuttaṃ. ",
  "sn5.6:1.1": "sāvatthiyaṃ– ",
  "sn5.6:1.2": "atha kho cālā bhikkhunī pubbaṇhasamayaṃ nivāsetvā pattacīvaramādāya sāvatthiṃ piṇḍāya pāvisi. sāvatthiyaṃ piṇḍāya caritvā pacchābhattaṃ piṇḍapātapaṭikkantā yena andhavanaṃ tenupasaṅkami divāvihārāya. andhavanaṃ ajjhogahetvā ",
  "sn5.6:1.3": "aññatarasmiṃ rukkhamūle divāvihāraṃ nisīdi. ",
  "sn5.6:1.4": "atha kho māro pāpimā yena cālā bhikkhunī tenupasaṅkami. upasaṅkamitvā cālaṃ bhikkhuniṃ etadavoca: ",
  "sn5.6:1.5": "kinnu tvaṃ bhikkhunī na rocesīti. ",
  "sn5.6:1.6": "[cālābhikkhunī:] jātiṃ khvāhaṃ āvuso na rocemīti. ",
  "sn5.6:2.1": "[māro:] kinnu jātiṃ na rocesi ",
  "sn5.6:2.2": "jāto kāmāni bhuñjati, ",
  "sn5.6:2.3": "ko nu taṃ idamādapayi ",
  "sn5.6:2.4": "jātiṃ māroca bhikkhunīti. ",
  "sn5.6:3.1": "[cālābhikkhunī:] jātassa maraṇaṃ hoti ",
  "sn5.6:3.2": "jāto dukkhāni phussati, ",
  "sn5.6:3.3": "bandhaṃ vadhaṃ pariklesaṃ ",
  "sn5.6:3.4": "tasmā jātiṃ na rocaye. ",
  "sn5.6:4.1": "buddho dhammamadesesi ",
  "sn5.6:4.2": "jātiyā samatikkamaṃ, ",
  "sn5.6:4.3": "sabbadukkhappahāṇāya ",
  "sn5.6:4.4": "yo maṃ sacce nivesayi. ",
  "sn5.6:5.1": "ye ca rūpūpagā sattā ",
  "sn5.6:5.2": "ye ca āruppaṭhāyino, ",
  "sn5.6:5.3": "nirodhaṃ appajānantā ",
  "sn5.6:5.4": "āgantāro punabbhavanti. ",
  "sn5.6:6.1": "atha kho māro pāpimā …pe… tatthevantaradhāyīti. "
}
