  "sn51.28:0.3": "7. 3. 8. dutiyaānandasuttaṃ ",
  "sn51.28:1.1": "ekamantaṃ nisinnaṃ kho āyasmantaṃ ānandaṃ bhagavā etadavoca: ",
  "sn51.28:1.2": "“katamā nu kho ānanda, iddhi, katamo iddhipādo, katamā iddhipādabhāvanā, katamā iddhipādabhāvanāgāminī paṭipadā”ti. ",
  "sn51.28:1.3": "bhagavammūlakā no bhante dhammā …pe… ",
  "sn51.28:2.1": "idhānanda, bhikkhu anekavihitaṃ iddhividhaṃ paccanubhoti …pe… ",
  "sn51.28:2.2": "",
  "sn51.28:3.1": "",
  "sn51.28:3.2": "",
  "sn51.28:3.3": "",
  "sn51.28:4.1": "",
  "sn51.28:4.2": "",
  "sn51.28:4.3": "",
  "sn51.28:4.4": "",
  "sn51.28:4.5": "",
  "sn51.28:4.6": "",
  "sn51.28:5.1": "",
  "sn51.28:5.2": "",
  "sn51.28:5.3": "",
  "sn51.28:5.4": "ayaṃ vuccatānanda, iddhipādabhāvanāgāminī paṭipadāti. ",
  "sn51.28:5.5": ""
}
