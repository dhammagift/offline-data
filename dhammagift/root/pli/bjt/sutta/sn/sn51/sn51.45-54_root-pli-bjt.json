{
  "sn51.45-54:0.1": "",
  "sn51.45-54:0.2": "5. appamādavaggo ",
  "sn51.45-54:0.3": "7. 5. 1-40. tathāgatādisuttāni ",
  "sn51.45-54:1.1": "yāvatā bhikkhave sattā apadā vā, dipadā vā catuppadā vā bahuppadā vā …pe… bahulīkarotīti. appamādavaggo pañcamo. tatruddānaṃ: ",
  "sn51.45-54:2.0": "",
  "sn51.45-54:2.1": "tathāgataṃ padaṃ kūṭaṃ ",
  "sn51.45-54:2.2": "mūlaṃ sārena vassikaṃ, ",
  "sn51.45-54:2.3": "rājā candimasūriyā ca ",
  "sn51.45-54:2.4": "vatthena dasamaṃ padanti. "
}
