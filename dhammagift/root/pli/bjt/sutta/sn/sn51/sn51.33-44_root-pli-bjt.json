{
  "sn51.33-44:0.1": "",
  "sn51.33-44:0.2": "4. gaṅgāpeyyālavaggo ",
  "sn51.33-44:0.3": "7. 4. 1-48. pācīnaninnādisuttāni ",
  "sn51.33-44:1.1": "seyyathāpi bhikkhave, gaṅgā nadī pācīnaninnā pācīnapoṇā pācīnapabbhārā. ",
  "sn51.33-44:1.2": "",
  "sn51.33-44:1.3": "",
  "sn51.33-44:1.4": "",
  "sn51.33-44:1.5": "…pe… ",
  "sn51.33-44:1.6": "",
  "sn51.33-44:1.7": "",
  "sn51.33-44:2.1": "nibbānapabbhāroti. ",
  "sn51.33-44:2.2": "(iddhipādavasena vitthāretabbāni) ",
  "sn51.33-44:2.3": "gaṅgāpeyyālavaggo catuttho. tatruddānaṃ: ",
  "sn51.33-44:3.0": "",
  "sn51.33-44:3.1": "cha pācīnato ninnā ",
  "sn51.33-44:3.2": "cha ca ninnā samuddato, ",
  "sn51.33-44:3.3": "ete dve dvādasa honti ",
  "sn51.33-44:3.4": "vaggo tena pavuccatīti. "
}
