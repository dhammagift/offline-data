{
  "sn51.55-66:0.1": "",
  "sn51.55-66:0.2": "6. balakaraṇīyavaggo ",
  "sn51.55-66:0.3": "7. 6. 1-48. balādi suttāni ",
  "sn51.55-66:1.1": "seyyathāpi bhikkhave, ye keci balakaraṇīyā kammantā kayiranti …pe… bahulīkarotīti: balakaraṇīyavaggo chaṭṭho. tatruddānaṃ: ",
  "sn51.55-66:2.0": "",
  "sn51.55-66:2.1": "balaṃ bījaṃ ca nāgo ca ",
  "sn51.55-66:2.2": "rukkhaṃ kumbhena sūkinā ",
  "sn51.55-66:2.3": "ākāsena dve meghā ",
  "sn51.55-66:2.4": "nāvā āgantukā nadī ti. "
}
