{
  "sn29.1:0.1": "8. nāgasaṃyuttaṃ ",
  "sn29.1:0.2": "1. nāgavaggo ",
  "sn29.1:0.3": "8. 1. 1. suddhika suttaṃ ",
  "sn29.1:1.1": "sāvatthiyaṃ: ",
  "sn29.1:1.2": "catasso imā bhikkhave, nāgayoniyo. ",
  "sn29.1:1.3": "katamā catasso? ",
  "sn29.1:1.4": "aṇḍajā nāgā, jalābujā nāgā, saṃsedajā nāgā, opapātikā nāgā, ",
  "sn29.1:1.5": "imā kho bhikkhave, catasso nāgayoniyoti. ",
  "sn29.1:1.6": ""
}
