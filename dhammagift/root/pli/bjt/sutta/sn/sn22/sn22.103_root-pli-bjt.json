{
  "sn22.103:0.1": "3. uparipaṇṇāsako ",
  "sn22.103:0.2": "1. antavaggo ",
  "sn22.103:0.3": "1. 3. 1. 1. anta suttaṃ ",
  "sn22.103:1.1": "sāvatthiyaṃ: cattāro ",
  "sn22.103:1.2": "me bhikkhave, antā. ",
  "sn22.103:1.3": "katame cattāro: ",
  "sn22.103:1.4": "sakkāyanto, sakkāyasamudayanto, sakkāyanirodhanto, sakkāyanirodhagāminīpaṭipadanto. ",
  "sn22.103:1.5": "katamo ca bhikkhave, sakkāyanto: ",
  "sn22.103:1.6": "pañcupādānakkhandhātissa vacanīyaṃ, ",
  "sn22.103:1.7": "katame pañca, ",
  "sn22.103:1.8": "seyyathidaṃ: rūpupādānakkhandho, vedanupādānakkhandho, saññupādānakkhandho, saṅkhārūpādānakkhandho, viññāṇupādānakkhandho. ",
  "sn22.103:1.9": "ayaṃ vuccati bhikkhave, sakkāyanto. ",
  "sn22.103:2.1": "katamo ca bhikkhave, sakkāyasamudayanto, ",
  "sn22.103:2.2": "yāyaṃ taṇhā ponobhavikā nandirāgasahagatā tatratatrābhinandinī, seyyathidaṃ: ",
  "sn22.103:2.3": "kāmataṇhā, bhavataṇhā, vibhavataṇhā. ",
  "sn22.103:2.4": "ayaṃ vuccati bhikkhave, sakkāyasamudayanto. ",
  "sn22.103:3.1": "katamo ca bhikkhave, sakkāyanirodhanto, ",
  "sn22.103:3.2": "yo tassā yeva taṇhāya asesavirāganirodho cāgo paṭinissaggo mutti anālayo. ",
  "sn22.103:3.3": "ayaṃ vuccati bhikkhave, sakkāyanirodhanto. ",
  "sn22.103:4.1": "katamo ca bhikkhave, sakkāyanirodhagāminīpaṭipadanto, ayame ",
  "sn22.103:4.2": "va ariyo aṭṭhaṅgiko maggo. ",
  "sn22.103:4.3": "seyyathidaṃ: sammādiṭṭhi, sammāsaṅkappo, sammāvācā, sammākammanto, sammāājīvo, sammāvāyāmo, sammāsati, sammāsamādhi. ",
  "sn22.103:4.4": "ayaṃ vuccati bhikkhave, sakkāyanirodhagāminīpaṭipadanto. ",
  "sn22.103:4.5": "ime kho bhikkhave, cattāro antāti. ",
  "sn22.103:4.6": ""
}
