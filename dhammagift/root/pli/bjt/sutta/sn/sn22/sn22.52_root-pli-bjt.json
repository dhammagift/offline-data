{
  "sn22.52:0.1": "",
  "sn22.52:0.2": "",
  "sn22.52:0.3": "1. 1. 5. 10. dutiya nandikkhaya suttaṃ ",
  "sn22.52:1.1": "sāvatthiyaṃ– ",
  "sn22.52:1.2": "rūpaṃ bhikkhave, yoniso manasi karotha, rūpāniccatañca yathābhūtaṃ samanupassatha. ",
  "sn22.52:1.3": "rūpaṃ bhikkhave, bhikkhu yoniso manasikaronto rūpāniccatañca yathābhūtaṃ samanupassanto rūpasmiṃ nibbindati. ",
  "sn22.52:1.4": "nandikkhayā rāgakkhayo, rāgakkhayā nandikkhayo. ",
  "sn22.52:1.5": "nandirāgakkhayā cittaṃ vimuttaṃ suvimuttanti vuccati. ",
  "sn22.52:1.6": "vedanaṃ bhikkhave, …pe… ",
  "sn22.52:1.7": "",
  "sn22.52:1.8": "",
  "sn22.52:1.9": "",
  "sn22.52:1.10": "saññaṃ bhikkhave, …pe… ",
  "sn22.52:1.11": "saṅkhāre bhikkhave, …pe… ",
  "sn22.52:1.12": "",
  "sn22.52:1.13": "",
  "sn22.52:1.14": "",
  "sn22.52:1.15": "viññāṇaṃ bhikkhave, yoniso manasikarotha, viññāṇāniccatañca yathābhūtaṃ samanupassatha. ",
  "sn22.52:1.16": "viññāṇaṃ bhikkhave bhikkhu, yoniso manasikaronto viññāṇāniccatañca yathābhūtaṃ samanupassanto viññāṇasmiṃ nibbindati. ",
  "sn22.52:1.17": "nandikkhayā rāgakkhayo, rāgakkhayā nandikkhayo. ",
  "sn22.52:1.18": "nandirāgakkhayā cittaṃ vimuttaṃ suvimuttanti vuccatīti. ",
  "sn22.52:1.19": "",
  "sn22.52:1.20": "attadīpavaggo pañcamo. ",
  "sn22.52:2.0": "tassuddānaṃ: ",
  "sn22.52:2.1": "attadīpā paṭipadā - ",
  "sn22.52:2.2": "dve ca honti aniccatā ",
  "sn22.52:2.3": "samanupassanā khandhā ",
  "sn22.52:2.4": "dve - soṇā dve nandikkhayena cāti. ",
  "sn22.52:2.5": "mūlapaṇṇāsakaṃ samattaṃ ",
  "sn22.52:3.0": "tassa mūlapaṇṇāsakassa vagguddānaṃ: ",
  "sn22.52:3.1": "nakulapitā anicco ca - ",
  "sn22.52:3.2": "bhāro na tumhākena ca ",
  "sn22.52:3.3": "attadīpena paññāsaṃ - ",
  "sn22.52:3.4": "paṭhamaṃ tena vuccatīti. "
}
