  "sn22.13:0.3": "1. 1. 2. 2. dukkha suttaṃ ",
  "sn22.13:1.1": "sāvatthiyaṃ– ",
  "sn22.13:1.2": "rūpaṃ bhikkhave dukkhaṃ, vedanā dukkhā, saññā dukkhā, saṅkhārā dukkhā, viññāṇaṃ dukkhaṃ. ",
  "sn22.13:1.3": "evaṃ passaṃ bhikkhave, …pe… ",
  "sn22.13:1.4": "nāparaṃ itthattāyāti pajānātīti. ",
  "sn22.13:1.5": ""
}
