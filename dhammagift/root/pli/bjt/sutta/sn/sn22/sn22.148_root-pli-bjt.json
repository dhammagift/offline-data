  "sn22.148:0.3": "1. 3. 4. 13. dukkhānupassī suttaṃ ",
  "sn22.148:1.1": "sāvatthiyaṃ: ",
  "sn22.148:1.2": "saddhāpabbajitassa bhikkhave, kulaputtassa ayamanudhammo hoti: ",
  "sn22.148:1.3": "yaṃ rūpe dukkhānupassī vihareyya. ",
  "sn22.148:1.4": "vedanāya …pe… ",
  "sn22.148:1.5": "saññāya …pe… ",
  "sn22.148:1.6": "saṅkhāresu …pe… ",
  "sn22.148:1.7": "viññāṇe dukkhānupassī vihareyya. so ",
  "sn22.148:1.8": "",
  "sn22.148:1.9": ""
}
