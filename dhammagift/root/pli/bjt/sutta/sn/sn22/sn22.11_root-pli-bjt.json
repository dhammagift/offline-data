{
  "sn22.11:0.1": "",
  "sn22.11:0.2": "",
  "sn22.11:0.3": "1. 1. 1. 11. tatiya atītānāgata suttaṃ ",
  "sn22.11:1.1": "sāvatthiyaṃ– ",
  "sn22.11:1.2": "rūpaṃ bhikkhave, anattā atītānāgataṃ, ",
  "sn22.11:1.3": "ko pana vādo paccuppannassa, ",
  "sn22.11:1.4": "evaṃ passaṃ bhikkhave, sutavā ariyasāvako atītasmiṃ rūpasmiṃ anapekho hoti, ",
  "sn22.11:1.5": "anāgataṃ rūpaṃ nābhinandati, ",
  "sn22.11:1.6": "paccuppannassa rūpassa nibbidāya virāgāya nirodhāya paṭipanno hoti. ",
  "sn22.11:1.7": "vedanā anattā …pe… ",
  "sn22.11:1.8": "saññā anattā …pe… ",
  "sn22.11:1.9": "saṅkhārā anattā …pe… ",
  "sn22.11:1.10": "viññāṇaṃ anattaṃ atītānāgataṃ, ",
  "sn22.11:1.11": "ko pana vādo paccuppannassa. ",
  "sn22.11:1.12": "evaṃ passaṃ bhikkhave, sutavā ariyasāvako atītasmiṃ viññāṇasmiṃ anapekho hoti, ",
  "sn22.11:1.13": "anāgataṃ viññāṇaṃ nābhinandati, ",
  "sn22.11:1.14": "paccuppannassa viññāṇassa nibbidāya virāgāya nirodhāya paṭipanno hotīti. ",
  "sn22.11:1.15": "",
  "sn22.11:1.16": "nakulapituvaggo paṭhamo. ",
  "sn22.11:2.0": "tassuddānaṃ: ",
  "sn22.11:2.1": "nakulapitā devadahā ",
  "sn22.11:2.2": "dvepi hāliddikāni ca ",
  "sn22.11:2.3": "samādhi paṭisallānaṃ ",
  "sn22.11:2.4": "upādāparitassanā duve ",
  "sn22.11:2.5": "atītānāgatā tīṇi ",
  "sn22.11:2.6": "vaggo tena pavuccati. "
}
