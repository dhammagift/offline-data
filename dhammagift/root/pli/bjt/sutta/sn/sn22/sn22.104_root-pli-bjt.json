  "sn22.104:0.1": "",
  "sn22.104:0.2": "",
  "sn22.104:0.3": "1. 3. 1. 2. dukkha suttaṃ ",
  "sn22.104:1.1": "sāvatthiyaṃ: ",
  "sn22.104:1.2": "dukkhañca vo bhikkhave, desissāmi dukkhasamudayañca dukkhanirodhañca dukkhanirodhagāminiñca paṭipadaṃ. ",
  "sn22.104:1.3": "taṃ suṇātha. ",
  "sn22.104:1.4": "katamañca bhikkhave, dukkhaṃ: ",
  "sn22.104:1.5": "pañcupādānakkhandhātissa vacanīyaṃ. ",
  "sn22.104:1.6": "katame pañca, ",
  "sn22.104:1.7": "seyyathidaṃ: rūpupādānakkhandho …pe… viññāṇupādānakkhandho. ",
  "sn22.104:1.8": "idaṃ vuccati bhikkhave, dukkhaṃ. ",
  "sn22.104:1.9": "katamo ca bhikkhave, dukkhasamudayo: ",
  "sn22.104:1.10": "yāyaṃ taṇhā ponobhavikā nandirāgasahagatā tatratatrābhinandinī, seyyathidaṃ: kāmataṇhā, bhavataṇhā, vibhavataṇhā. ",
  "sn22.104:1.11": "ayaṃ vuccati bhikkhave, dukkhasamudayo. ",
  "sn22.104:1.12": "katamo ca bhikkhave, dukkhanirodho: ",
  "sn22.104:1.13": "yo tassāyeva taṇhāya asesavirāganirodho cāgo paṭinissaggo mutti anālayo, ",
  "sn22.104:1.14": "ayaṃ vuccati bhikkhave, dukkhanirodho. ",
  "sn22.104:1.15": "katamo ca bhikkhave, dukkhanirodhagāminīpaṭipadā: ",
  "sn22.104:1.16": "ayameva ariyo aṭṭhaṅgiko maggo. ",
  "sn22.104:1.17": "seyyathidaṃ: sammādiṭṭhi …pe… sammāsamādhi. ",
  "sn22.104:1.18": "ayaṃ vuccati bhikkhave, dukkhanirodhagāminī paṭipadāti. ",
  "sn22.104:1.19": ""
}
