{
  "sn22.106:0.1": "",
  "sn22.106:0.2": "",
  "sn22.106:0.3": "1. 3. 1. 4. pariññeyya suttaṃ ",
  "sn22.106:1.1": "sāvatthiyaṃ: ",
  "sn22.106:1.2": "pariññeyye ca bhikkhave, dhamme desissāmi pariññañca pariññātāviñca puggalaṃ. ",
  "sn22.106:1.3": "taṃ suṇātha. ",
  "sn22.106:1.4": "katame ca bhikkhave, pariññeyyā dhammā: ",
  "sn22.106:1.5": "rūpaṃ bhikkhave, pariññeyyo dhammo. ",
  "sn22.106:1.6": "vedanā pariññeyyo dhammo, ",
  "sn22.106:1.7": "saññā …pe… ",
  "sn22.106:1.8": "saṅkhārā …pe… ",
  "sn22.106:1.9": "viññāṇaṃ pariññeyyo dhammo. ",
  "sn22.106:1.10": "ime vuccanti bhikkhave, pariññeyyā dhammā. ",
  "sn22.106:1.11": "katamā ca bhikkhave, pariññā: yo bhikkhave, ",
  "sn22.106:1.12": "rāgakkhayo dosakkhayo mohakkhayo, ",
  "sn22.106:1.13": "ayaṃ vuccati bhikkhave, pariññā. ",
  "sn22.106:1.14": "katamo ca bhikkhave, pariññātāvī puggalo: ",
  "sn22.106:1.15": "arahā’tissa vacanīyaṃ. ",
  "sn22.106:1.16": "yo’yaṃ āyasmā evaṃnāmo evaṃgotto. ",
  "sn22.106:1.17": "ayaṃ vuccati bhikkhave, pariññātāvī puggaloti. ",
  "sn22.106:1.18": ""
}
