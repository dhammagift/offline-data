{
  "sn22.105:0.1": "",
  "sn22.105:0.2": "",
  "sn22.105:0.3": "1. 3. 1. 3. sakkāya suttaṃ ",
  "sn22.105:1.1": "sāvatthiyaṃ: ",
  "sn22.105:1.2": "sakkāyañca vo bhikkhave, desissāmi sakkāyasamudayañca sakkāyanirodhañca sakkāyanirodhagāminiñca paṭipadaṃ. ",
  "sn22.105:1.3": "taṃ suṇātha. ",
  "sn22.105:1.4": "katamo ca bhikkhave, sakkāyo: ",
  "sn22.105:1.5": "pañcupādānakkhandhātissa vacanīyaṃ. ",
  "sn22.105:1.6": "katame pañca, ",
  "sn22.105:1.7": "seyyathidaṃ: rūpupādānakkhandho, …pe… viññāṇupādānakkhandho. ",
  "sn22.105:1.8": "ayaṃ vuccati, bhikkhave, sakkāyo. ",
  "sn22.105:1.9": "katamo ca bhikkhave, sakkāyasamudayo: ",
  "sn22.105:1.10": "yāyaṃ taṇhā ponobhavikā nandirāgasahagatā tatratatrābhinandinī, seyyathidaṃ: kāmataṇhā, bhavataṇhā, vibhavataṇhā. ",
  "sn22.105:1.11": "ayaṃ vuccati bhikkhave, sakkāyasamudayo. ",
  "sn22.105:1.12": "katamo ca bhikkhave, sakkāyanirodho: ",
  "sn22.105:1.13": "yo tassāyeva taṇhāya asesavirāganirodho cāgo paṭinissaggo mutti anālayo, ",
  "sn22.105:1.14": "ayaṃ vuccati bhikkhave, sakkāyanirodho. ",
  "sn22.105:1.15": "katamo ca bhikkhave, sakkāyanirodhagāminī paṭipadā: ",
  "sn22.105:1.16": "ayameva ariyo aṭṭhaṅgiko maggo. ",
  "sn22.105:1.17": "seyyathidaṃ: sammādiṭṭhi …pe… sammāsamādhi. ",
  "sn22.105:1.18": "ayaṃ vuccati bhikkhave, sakkāyanirodhagāminī paṭipadāti. ",
  "sn22.105:1.19": ""
}
