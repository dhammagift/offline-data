{
  "sn22.31:0.1": "",
  "sn22.31:0.2": "",
  "sn22.31:0.3": "1. 1. 3. 10. aghamūla suttaṃ ",
  "sn22.31:1.1": "sāvatthiyaṃ– ",
  "sn22.31:1.2": "aghañca kho bhikkhave, desissāmi, aghamūlañca. ",
  "sn22.31:1.3": "taṃ suṇātha …pe… ",
  "sn22.31:1.4": "katamañca bhikkhave aghaṃ: ",
  "sn22.31:1.5": "rūpaṃ bhikkhave, aghaṃ, vedanā aghaṃ, saññā aghaṃ, saṅkhārā aghaṃ, viññāṇaṃ aghaṃ. ",
  "sn22.31:1.6": "idaṃ vuccati bhikkhave, aghaṃ. ",
  "sn22.31:1.7": "katamañca bhikkhave, aghamūlaṃ: ",
  "sn22.31:1.8": "yāyaṃ taṇhā ponobhavikā nandirāgasahagatā tatratatrābhinandinī, ",
  "sn22.31:1.9": "seyyathidaṃ: kāmataṇhā, bhavataṇhā, vibhavataṇhā. ",
  "sn22.31:1.10": "idaṃ vuccati bhikkhave, aghamūlanti. ",
  "sn22.31:1.11": ""
}
