  "sn22.14:0.3": "1. 1. 2. 3. anatta suttaṃ ",
  "sn22.14:1.1": "sāvatthiyaṃ– ",
  "sn22.14:1.2": "rūpaṃ bhikkhave anattā, vedanā anattā, saññā anattā, saṅkhārā anattā, viññāṇaṃ anattā. ",
  "sn22.14:1.3": "evaṃ passaṃ bhikkhave, …pe… ",
  "sn22.14:1.4": "",
  "sn22.14:1.5": "nāparaṃ itthattāyāti pajānātīti. ",
  "sn22.14:1.6": ""
}
