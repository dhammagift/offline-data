{
  "sn22.16:0.1": "",
  "sn22.16:0.2": "",
  "sn22.16:0.3": "1. 1. 2. 5. yaṃdukkha suttaṃ ",
  "sn22.16:1.1": "sāvatthiyaṃ– ",
  "sn22.16:1.2": "rūpaṃ bhikkhave dukkhaṃ. ",
  "sn22.16:1.3": "yaṃ dukkhaṃ tadanattā, ",
  "sn22.16:1.4": "yadanattā taṃ ‘netaṃ mama, neso’hamasmi, na meso attā”ti evametaṃ yathābhūtaṃ sammappaññāya daṭṭhabbaṃ. ",
  "sn22.16:1.5": "vedanā dukkhā …pe… ",
  "sn22.16:1.6": "saññā dukkhā …pe… ",
  "sn22.16:1.7": "saṅkhārā dukkhā …pe… ",
  "sn22.16:1.8": "viññāṇaṃ dukkhaṃ. ",
  "sn22.16:1.9": "yaṃ dukkhaṃ tadanattā, ",
  "sn22.16:1.10": "yadanattā taṃ “netaṃ mama, neso’hamasmi, na meso attā”ti evametaṃ yathābhūtaṃ sammappaññāya daṭṭhabbaṃ. ",
  "sn22.16:1.11": "evaṃ passaṃ bhikkhave …pe… ",
  "sn22.16:1.12": "nāparaṃ itthattāyāti pajānātīti. ",
  "sn22.16:1.13": ""
}
