{
  "sn21.12:0.1": "",
  "sn21.12:0.2": "",
  "sn21.12:0.3": "9. 1. 12. sahāyakasuttaṃ ",
  "sn21.12:1.1": "sāvatthiyaṃ– ",
  "sn21.12:1.2": "atha kho dve bhikkhū sahāyakā āyasmato mahākappinassa saddhivihārino yena bhagavā tenupasaṅkamiṃsu. ",
  "sn21.12:1.3": "addasā kho bhagavā te bhikkhū dūratova āgacchante. ",
  "sn21.12:1.4": "disvāna bhikkhū āmantesi ",
  "sn21.12:1.5": "“passatha no tumhe, bhikkhave, ete bhikkhū sahāyake āgacchante kappinassa saddhivihārino”ti? ",
  "sn21.12:1.6": "“evaṃ, bhante”. ",
  "sn21.12:1.7": "“ete kho te bhikkhū mahiddhikā mahānubhāvā. ",
  "sn21.12:1.8": "na ca sā samāpatti sulabharūpā, yā tehi bhikkhūhi asamāpannapubbā. ",
  "sn21.12:1.9": "yassa catthāya kulaputtā sammadeva agārasmā anagāriyaṃ pabbajanti tadanuttaraṃ brahmacariyapariyosānaṃ diṭṭheva dhamme sayaṃ abhiññā sacchikatvā upasampajja viharantī”ti. ",
  "sn21.12:2.1": "idamavoca bhagavā. ",
  "sn21.12:2.2": "idaṃ vatvāna sugato athāparaṃ etadavoca satthā: ",
  "sn21.12:3.1": "sahāyā vatime bhikkhū ",
  "sn21.12:3.2": "cirarattaṃ sametikā, ",
  "sn21.12:3.3": "sameti nesaṃ saddhammo, ",
  "sn21.12:3.4": "dhamme buddhappavedite. ",
  "sn21.12:4.1": "suvinītā kappinena ",
  "sn21.12:4.2": "dhamme ariyappavedite, ",
  "sn21.12:4.3": "dhārenti antimaṃ dehaṃ, ",
  "sn21.12:4.4": "jetvā māraṃ savāhininti. ",
  "sn21.12:4.5": "vaggo ",
  "sn21.12:4.6": "paṭhamo ",
  "sn21.12:5.0": "tassuddānaṃ: ",
  "sn21.12:5.1": "kolito sāriputto ",
  "sn21.12:5.2": "ghaṭo cāpi pavuccati, ",
  "sn21.12:5.3": "navo sujāto bhaddi ca, ",
  "sn21.12:5.4": "visākho nando tisso ca, ",
  "sn21.12:5.5": "theranāmo ca kappino, ",
  "sn21.12:5.6": "sahāyena ca dvādasāti. ",
  "sn21.12:5.7": "bhikkhusaṃyuttaṃ samattaṃ. ",
  "sn21.12:5.8": "nidānavaggassa saṃyuttuddānaṃ: abhisamayo dhātu ",
  "sn21.12:6.0": "",
  "sn21.12:6.1": "ca ",
  "sn21.12:6.2": "anamataggena kassapo, ",
  "sn21.12:6.3": "lābhasakkārarāhula ",
  "sn21.12:6.4": "lakkhaṇopammabhikkhuhi, nidānavaggo ",
  "sn21.12:6.5": "dutiyo pūritoti pavuccatīti. ",
  "sn21.12:6.6": "nidānavaggo niṭṭhito. "
}
