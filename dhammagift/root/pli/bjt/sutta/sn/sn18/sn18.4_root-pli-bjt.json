  "sn18.4:0.1": "",
  "sn18.4:0.2": "",
  "sn18.4:0.3": "6. 1. 4. samphassasuttaṃ ",
  "sn18.4:1.1": "sāvatthiyaṃ– ",
  "sn18.4:1.2": "taṃ kimmaññasi rāhula, ",
  "sn18.4:1.3": "cakkhusamphasso nicco vā anicco vāti? ",
  "sn18.4:1.4": "anicco bhante …pe… ",
  "sn18.4:1.5": "sotasamphasso …pe… ",
  "sn18.4:1.6": "ghānasamphasso …pe… ",
  "sn18.4:1.7": "jivhāsamphasso …pe… ",
  "sn18.4:1.8": "kāyasamphasso …pe… ",
  "sn18.4:1.9": "manosamphasso nicco vā anicco vāti? ",
  "sn18.4:1.10": "anicco bhante …pe… ",
  "sn18.4:1.11": "evaṃ passaṃ rāhula, sutavā ariyasāvako cakkhusamphassasmimpi nibbindati, sotasamphassasmimpi nibbindati, ghānasamphassasmimpi nibbindati, jivhāsamphassasmimpi nibbindati, kāyasamphassasmimpi nibbindati, manosamphassasmimpi nibbindati. ",
  "sn18.4:1.12": "nibbindaṃ virajjati …pe… nāparaṃ itthattāyāti ",
  "sn18.4:1.13": "pajānātīti. ",
  "sn18.4:1.14": ""
}
