{
  "sn18.2:0.1": "",
  "sn18.2:0.2": "",
  "sn18.2:0.3": "6. 1. 2. rūpādi suttaṃ ",
  "sn18.2:1.1": "sāvatthiyaṃ– ",
  "sn18.2:1.2": "taṃ kimmaññasi rāhula, ",
  "sn18.2:1.3": "rūpā niccā vā aniccā vāti? ",
  "sn18.2:1.4": "aniccā bhante ",
  "sn18.2:1.5": "saddā …pe… ",
  "sn18.2:1.6": "gandhā …pe… ",
  "sn18.2:1.7": "rasā …pe… ",
  "sn18.2:1.8": "phoṭṭhabbā …pe… ",
  "sn18.2:1.9": "dhammā niccā vā aniccā vāti? ",
  "sn18.2:1.10": "aniccā bhante …pe… ",
  "sn18.2:1.11": "evaṃ passaṃ rāhula, sutavā ariyasāvako rūpesupi nibbindati, saddesupi nibbindati, gandhesupi nibbindati, rasesupi nibbindati, phoṭṭhabbesupi nibbindati, dhammesupi nibbindati. ",
  "sn18.2:1.12": "nibbindaṃ virajjati …pe… nāparaṃ itthattāyāti ",
  "sn18.2:1.13": "pajānātīti. ",
  "sn18.2:1.14": ""
}
