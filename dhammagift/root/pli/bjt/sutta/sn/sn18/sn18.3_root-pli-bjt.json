  "sn18.3:0.1": "",
  "sn18.3:0.2": "",
  "sn18.3:0.3": "6. 1. 3. viññāṇasuttaṃ ",
  "sn18.3:1.1": "sāvatthiyaṃ– ",
  "sn18.3:1.2": "taṃ kimmaññasi rāhula, ",
  "sn18.3:1.3": "cakkhuviññāṇaṃ niccaṃ vā aniccaṃ vāti? ",
  "sn18.3:1.4": "aniccaṃ bhante, …pe… ",
  "sn18.3:1.5": "sotaviññāṇaṃ …pe… ",
  "sn18.3:1.6": "ghānaviññāṇaṃ …pe… ",
  "sn18.3:1.7": "jivhāviññāṇaṃ …pe… ",
  "sn18.3:1.8": "kāyaviññāṇaṃ …pe… ",
  "sn18.3:1.9": "manoviññāṇaṃ niccaṃ vā aniccaṃ vāti? ",
  "sn18.3:1.10": "aniccaṃ bhante …pe… ",
  "sn18.3:1.11": "evaṃ passaṃ rāhula, sutavā ariyasāvako cakkhuviññāṇasmimpi nibbindati …pe… sotaviññāṇasmimpi …pe… ghānaviññāṇasmimpi …pe… jivhāviññāṇasmimpi …pe… kāyaviññāṇasmimpi …pe… manoviññāṇasmimpi nibbindati. ",
  "sn18.3:1.12": "nibbindaṃ virajjati …pe… nāparaṃ itthattāyāti ",
  "sn18.3:1.13": "pajānātīti. ",
  "sn18.3:1.14": ""
}
