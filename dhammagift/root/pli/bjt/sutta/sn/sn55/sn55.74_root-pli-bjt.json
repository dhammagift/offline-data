{
  "sn55.74:0.1": "",
  "sn55.74:0.2": "",
  "sn55.74:0.3": "11. 7. 13. nibbedhikapaññasuttaṃ ",
  "sn55.74:1.1": "cattāro’me bhikkhave, dhammā bhāvitā bahulīkatā nibbedhikapaññatāya saṃvattanti. ",
  "sn55.74:1.2": "katame cattāro: ",
  "sn55.74:1.3": "sappurisasaṃsevo, saddhammasavanaṃ, yonisomanasikāro, dhammānudhammapaṭipatti. ",
  "sn55.74:1.4": "ime kho bhikkhave, cattāro dhammā bhāvitā bahulīkatā nibbedhikapaññatāya saṃvattantīti. ",
  "sn55.74:1.5": "",
  "sn55.74:1.6": "mahāpaññavaggo sattamo. tatruddānaṃ: mahāputhuvipulagambhīraṃ ",
  "sn55.74:2.0": "",
  "sn55.74:2.1": "appamattabhūribāhulaṃ, sīghalahuhāsujavana tikkhanibbedhikāyacāti. sotāpattisaṃyuttaṃ ",
  "sn55.74:2.2": "samattaṃ. tatra vagguddānaṃ: veḷudvāra ",
  "sn55.74:2.3": "rājakārāmā sarakāni puññābhisandā sagāthapuññābhisando ",
  "sn55.74:2.4": "sapañña mahāpaññā cāti. ",
  "sn55.74:2.5": ""
}
