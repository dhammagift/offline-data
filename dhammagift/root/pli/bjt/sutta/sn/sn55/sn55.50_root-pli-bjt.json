{
  "sn55.50:0.1": "",
  "sn55.50:0.2": "",
  "sn55.50:0.3": "11. 5. 10. aṅgasuttaṃ ",
  "sn55.50:1.1": "cattārimāni bhikkhave, sotāpattiyaṅgāni. ",
  "sn55.50:1.2": "katamāni cattāri: ",
  "sn55.50:1.3": "sappurisasaṃsevo, saddhammasavanaṃ, yonisomanasikāro, dhammānudhammapaṭipatti. ",
  "sn55.50:1.4": "imāni kho bhikkhave, cattāri sotāpattiyaṅgānīti. ",
  "sn55.50:1.5": "",
  "sn55.50:1.6": "sagāthakapuññābhisandavaggo pañcamo. tatruddānaṃ: ",
  "sn55.50:2.0": "",
  "sn55.50:2.1": "asaṅkheyyo tayo vuttā aḍḍhena apare ",
  "sn55.50:2.2": "duve, suddhakaṃ ",
  "sn55.50:2.3": "nandiyaṃ bhaddiyaṃ ",
  "sn55.50:2.4": "mahānāmaṅgehi te dasāti. "
}
