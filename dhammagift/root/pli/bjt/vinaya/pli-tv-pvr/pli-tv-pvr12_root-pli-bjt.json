{
  "pli-tv-pvr12:0.1": "",
  "pli-tv-pvr12:0.2": "aparagāthāsaṅgaṇikaṃ ",
  "pli-tv-pvr12:0.3": "",
  "pli-tv-pvr12:1.1": "codanā kimatthāya, ",
  "pli-tv-pvr12:1.2": "sāraṇā kissa kāraṇā. ",
  "pli-tv-pvr12:1.3": "saṅgho kimatthāya ",
  "pli-tv-pvr12:1.4": "matikammaṃ pana kissa kāraṇā : ",
  "pli-tv-pvr12:2.1": "codanā sāraṇatthāya ",
  "pli-tv-pvr12:2.2": "niggahatthāya sāraṇā, ",
  "pli-tv-pvr12:2.3": "saṅgho pariggahatthāya ",
  "pli-tv-pvr12:2.4": "matikammaṃ pana pāṭiyekkaṃ. ",
  "pli-tv-pvr12:3.1": "mā kho turito abhaṇi ",
  "pli-tv-pvr12:3.2": "mā kho caṇḍikkato bhaṇī, ",
  "pli-tv-pvr12:3.3": "mā kho paṭighaṃ janayi ",
  "pli-tv-pvr12:3.4": "sace anuvijjako tuvaṃ. ",
  "pli-tv-pvr12:4.1": "mā kho sahasā abhaṇi ",
  "pli-tv-pvr12:4.2": "kathaṃ viggāhikaṃ anatthasaṃhitaṃ, ",
  "pli-tv-pvr12:4.3": "sutte vinaye anulome ",
  "pli-tv-pvr12:4.4": "paññatte anulomike. ",
  "pli-tv-pvr12:5.1": "anuyogavattaṃ nisāmaya ",
  "pli-tv-pvr12:5.2": "kusalena buddhimatā kataṃ, ",
  "pli-tv-pvr12:5.3": "suvuttaṃ sikkhāpadānulomikaṃ ",
  "pli-tv-pvr12:5.4": "gatiṃ na nāsento samparāyikaṃ, ",
  "pli-tv-pvr12:5.5": "hitesī anuyuñjassu ",
  "pli-tv-pvr12:5.6": "kālenatthūpasaṃhitaṃ, ",
  "pli-tv-pvr12:6.1": "cuditassa ca codakassa ca ",
  "pli-tv-pvr12:6.2": "sahasā vohāraṃ mā padhārehi ",
  "pli-tv-pvr12:6.3": "codako āha āpannoti ",
  "pli-tv-pvr12:6.4": "cuditako āha anāpannoti. ",
  "pli-tv-pvr12:7.1": "ubho anukkhipanto ",
  "pli-tv-pvr12:7.2": "paṭiññānusandhitena kāraye. ",
  "pli-tv-pvr12:7.3": "paṭiññā lajjīsu katā ",
  "pli-tv-pvr12:7.4": "alajjīsu evaṃ na vijjati, ",
  "pli-tv-pvr12:7.5": "bahumpi alajjī bhāseyya ",
  "pli-tv-pvr12:7.6": "vattānusandhitena kāraye. ",
  "pli-tv-pvr12:8.1": "alajjī kīdiso hoti ",
  "pli-tv-pvr12:8.2": "paṭiññā yassa na rūhati, ",
  "pli-tv-pvr12:8.3": "evañca tāhaṃ pucchāmi, ",
  "pli-tv-pvr12:8.4": "kīdiso vuccati alajjī puggalo : ",
  "pli-tv-pvr12:9.1": "saṃcicca āpattiṃ āpajjati ",
  "pli-tv-pvr12:9.2": "āpattiṃ parigūhati, ",
  "pli-tv-pvr12:9.3": "agatigamanañca gacchati ",
  "pli-tv-pvr12:9.4": "ediso vuccati alajjīpuggalo. ",
  "pli-tv-pvr12:10.1": "saccaṃ ahampi jānāmi ",
  "pli-tv-pvr12:10.2": "ediso vuccati alajjīpuggalo, ",
  "pli-tv-pvr12:10.3": "aññañca tāhaṃ pucchāmi ",
  "pli-tv-pvr12:10.4": "kīdiso vuccati lajjīpuggalo : ",
  "pli-tv-pvr12:11.1": "saṃcicca āpattiṃ nāpajjati ",
  "pli-tv-pvr12:11.2": "āpattiṃ na parigūhati, ",
  "pli-tv-pvr12:11.3": "agatigamanaṃ na gacchati ",
  "pli-tv-pvr12:11.4": "ediso vuccati lajjīpuggalo. ",
  "pli-tv-pvr12:12.1": "saccaṃ ahampi jānāmi, ",
  "pli-tv-pvr12:12.2": "ediso vuccati lajjīpuggalo, ",
  "pli-tv-pvr12:12.3": "aññañca tāhaṃ pucchāmi ",
  "pli-tv-pvr12:12.4": "kīdiso vuccati adhammacodako : ",
  "pli-tv-pvr12:13.1": "akāle codeti abhūtena ",
  "pli-tv-pvr12:13.2": "pharusena anatthasaṃhitena, ",
  "pli-tv-pvr12:13.3": "dosantaro codeti no mettacitto ",
  "pli-tv-pvr12:13.4": "ediso vuccati adhammacodako. ",
  "pli-tv-pvr12:14.1": "saccaṃ ahampi jānāmi ",
  "pli-tv-pvr12:14.2": "ediso vuccati adhammacodako, ",
  "pli-tv-pvr12:14.3": "aññañca tāhaṃ pucchāmi ",
  "pli-tv-pvr12:14.4": "kīdiso vuccati dhammacodako : ",
  "pli-tv-pvr12:15.1": "kālena codeti bhūtena, ",
  "pli-tv-pvr12:15.2": "saṇhena atthasaṃhitena, ",
  "pli-tv-pvr12:15.3": "mettācitto codeti no dosantaro ",
  "pli-tv-pvr12:15.4": "ediso vuccati dhammacodako. ",
  "pli-tv-pvr12:16.1": "saccaṃ ahampi jānāmi ",
  "pli-tv-pvr12:16.2": "ediso vuccati dhammacodako, ",
  "pli-tv-pvr12:16.3": "aññañca tāhaṃ pucchāmi ",
  "pli-tv-pvr12:16.4": "kīdiso vuccati bālacodako : ",
  "pli-tv-pvr12:17.1": "pubbāparaṃ na jānāti ",
  "pli-tv-pvr12:17.2": "pubbāparassa akovido, ",
  "pli-tv-pvr12:17.3": "anusandhivacanapathaṃ na jānāti ",
  "pli-tv-pvr12:17.4": "anusandhivacanapathassa akovido ",
  "pli-tv-pvr12:17.5": "ediso vuccati bālacodako. ",
  "pli-tv-pvr12:18.1": "saccaṃ ahampi jānāmi ",
  "pli-tv-pvr12:18.2": "ediso vuccati bālacodako, ",
  "pli-tv-pvr12:18.3": "aññañca tāhaṃ pucchāmi ",
  "pli-tv-pvr12:18.4": "kīdiso vuccati paṇḍitacodako : ",
  "pli-tv-pvr12:19.1": "pubbāparaṃ vijānāti ",
  "pli-tv-pvr12:19.2": "pubbāparassa kovido, ",
  "pli-tv-pvr12:19.3": "anusandhivacanapathaṃ jānāti ",
  "pli-tv-pvr12:19.4": "anusandhivacanapathassa kovido ; ",
  "pli-tv-pvr12:19.5": "ediso vuccati paṇḍitacodako. ",
  "pli-tv-pvr12:20.1": "saccaṃ ahampi jānāmi ",
  "pli-tv-pvr12:20.2": "ediso vuccati paṇḍitacodako, ",
  "pli-tv-pvr12:20.3": "aññañca tāhaṃ pucchāmi ",
  "pli-tv-pvr12:20.4": "codanā kinti vuccati : ",
  "pli-tv-pvr12:21.1": "sīlavipattiyā codeti ",
  "pli-tv-pvr12:21.2": "atho ācāradiṭṭhiyā, ",
  "pli-tv-pvr12:21.3": "ājīvenapi codeti ",
  "pli-tv-pvr12:21.4": "codanā tena vuccati. ",
  "pli-tv-pvr12:22.1": "aparagāthāsaṅgaṇikaṃ niṭṭhitaṃ. "
}
