{
  "pli-tv-pvr3:0.1": "niṭṭhito ca bhikkhunī vibhaṅgo. ",
  "pli-tv-pvr3:0.2": "samuṭṭhānasīsasaṅkhepo ",
  "pli-tv-pvr3:0.3": "samuṭṭhānassuddānaṃ: ",
  "pli-tv-pvr3:1.1": "aniccā sabbe saṅkhārā ",
  "pli-tv-pvr3:1.2": "dukkhā‘nattā ca saṅkhatā, ",
  "pli-tv-pvr3:1.3": "nibbānañceva paññatti ",
  "pli-tv-pvr3:1.4": "anattā iti nicchayā. ",
  "pli-tv-pvr3:2.1": "buddhacande anuppanne ",
  "pli-tv-pvr3:2.2": "buddhādicce anuggate, ",
  "pli-tv-pvr3:2.3": "tesaṃ sabhāgadhammānaṃ ",
  "pli-tv-pvr3:2.4": "nāmamattaṃ na ñāyati. ",
  "pli-tv-pvr3:3.1": "dukkaraṃ vividhaṃ katvā ",
  "pli-tv-pvr3:3.2": "pūrayitvāna pāramī, ",
  "pli-tv-pvr3:3.3": "uppajjanti mahāvīrā ",
  "pli-tv-pvr3:3.4": "cakkhubhūtā sabrahmake. ",
  "pli-tv-pvr3:4.1": "te desayanti saddhammaṃ ",
  "pli-tv-pvr3:4.2": "dukkhahāniṃ sukhāvahaṃ, ",
  "pli-tv-pvr3:4.3": "aṅgiraso sakyamuni ",
  "pli-tv-pvr3:4.4": "sabbabhūtānukampako. ",
  "pli-tv-pvr3:5.1": "sabbasattūttamo sīho ",
  "pli-tv-pvr3:5.2": "piṭake tīṇi desayī, ",
  "pli-tv-pvr3:5.3": "suttantaṃ abhidhammañca ",
  "pli-tv-pvr3:5.4": "vinayañca mahāguṇaṃ ",
  "pli-tv-pvr3:6.1": "evaṃ nīyati saddhammo, ",
  "pli-tv-pvr3:6.2": "vinayo yadi tiṭṭhati, ",
  "pli-tv-pvr3:6.3": "ubhato ca vibhaṅgāni ",
  "pli-tv-pvr3:6.4": "khandhakā yā ca mātikā. ",
  "pli-tv-pvr3:7.1": "mālā suttaguṇeneva ",
  "pli-tv-pvr3:7.2": "parivārena ganthitā, ",
  "pli-tv-pvr3:7.3": "tasseva parivārassa ",
  "pli-tv-pvr3:7.4": "samuṭṭhānaṃ nayato kataṃ. ",
  "pli-tv-pvr3:8.1": "sambhedaṃ nidānañcaññaṃ ",
  "pli-tv-pvr3:8.2": "sutte dissanti upari, ",
  "pli-tv-pvr3:8.3": "tasmā sikkhe parivāraṃ, ",
  "pli-tv-pvr3:8.4": "dhammakāmo supesaloti. ",
  "pli-tv-pvr3:9.0": "terasasamuṭṭhānāni ",
  "pli-tv-pvr3:9.1": "vibhaṅge dvīsu paññattaṃ ",
  "pli-tv-pvr3:9.2": "uddisanti uposathe, ",
  "pli-tv-pvr3:9.3": "pavakkhāmi samuṭṭhānaṃ ",
  "pli-tv-pvr3:9.4": "yathāñāyaṃ suṇātha me. ",
  "pli-tv-pvr3:10.1": "pārājikaṃ yaṃ paṭhamaṃ ",
  "pli-tv-pvr3:10.2": "dutiyañca tato paraṃ, ",
  "pli-tv-pvr3:10.3": "sañcarittānubhāsañca ",
  "pli-tv-pvr3:10.4": "atirekañca cīvaraṃ. ",
  "pli-tv-pvr3:11.1": "lomāni padaso dhammo ",
  "pli-tv-pvr3:11.2": "bhūtaṃ saṃvidhānena ca, ",
  "pli-tv-pvr3:11.3": "theyyadesanacoriṃ ca ",
  "pli-tv-pvr3:11.4": "ananuññātāya terasa ",
  "pli-tv-pvr3:12.1": "terasete samuṭṭhānanayā ",
  "pli-tv-pvr3:12.2": "viññūhi cintitā, ",
  "pli-tv-pvr3:12.3": "ekekasmiṃ samuṭṭhāne ",
  "pli-tv-pvr3:12.4": "sadisā idha dissare. ",
  "pli-tv-pvr3:13.0": "paṭhamapārājika samuṭṭhānaṃ ",
  "pli-tv-pvr3:13.1": "methunaṃ sukkasaṃsaggo ",
  "pli-tv-pvr3:13.2": "aniyatā paṭhamikā, ",
  "pli-tv-pvr3:13.3": "pubbūpaparipācitā ",
  "pli-tv-pvr3:13.4": "raho bhikkhuniyā saha. ",
  "pli-tv-pvr3:14.1": "sabhojane raho dve ca ",
  "pli-tv-pvr3:14.2": "aṅguli udake hasaṃ, ",
  "pli-tv-pvr3:14.3": "pahāre uggire dve va ",
  "pli-tv-pvr3:14.4": "tepaññāsā ca sekhiyā. ",
  "pli-tv-pvr3:15.1": "adhakkhakagāmāvassutā ",
  "pli-tv-pvr3:15.2": "talamaṭṭhañca suddhikā, ",
  "pli-tv-pvr3:15.3": "vassaṃ vutthā ca ovādaṃ ",
  "pli-tv-pvr3:15.4": "nānubandhe pavattiniṃ. ",
  "pli-tv-pvr3:16.1": "chasattati ime sikkhā ",
  "pli-tv-pvr3:16.2": "kāyamānasikā katā, ",
  "pli-tv-pvr3:16.3": "sabbe ekasamuṭṭhānā ",
  "pli-tv-pvr3:16.4": "paṭhamaṃ pārājikaṃ yathā. ",
  "pli-tv-pvr3:17.1": "paṭhamapārājikasamuṭṭhānaṃ niṭṭhitaṃ. ",
  "pli-tv-pvr3:18.0": "dutiyapārājika samuṭṭhānaṃ ",
  "pli-tv-pvr3:18.1": "adinnaṃ viggahuttariṃ ",
  "pli-tv-pvr3:18.2": "duṭṭhullaṃ attakāminaṃ, ",
  "pli-tv-pvr3:18.3": "amūlā aññabhāgiyā ",
  "pli-tv-pvr3:18.4": "aniyatā dutiyikā. ",
  "pli-tv-pvr3:19.1": "acchinde pariṇāmane ",
  "pli-tv-pvr3:19.2": "musā omasa pesuṇā, ",
  "pli-tv-pvr3:19.3": "duṭṭhullā paṭhaviṃ khaṇe ",
  "pli-tv-pvr3:19.4": "bhūtaṃ aññāya ujjhāpe. ",
  "pli-tv-pvr3:20.1": "nikkaḍḍhanaṃ siñcanañca ",
  "pli-tv-pvr3:20.2": "āmisahetu bhuttāvī, ",
  "pli-tv-pvr3:20.3": "ehi anādari bhiṃsā ",
  "pli-tv-pvr3:20.4": "apanidhe ca jīvitaṃ. ",
  "pli-tv-pvr3:21.1": "jānaṃ sappāṇakaṃ kammaṃ ",
  "pli-tv-pvr3:21.2": "ūnena saṃvāsanāsanā, sahadhammikaṃ ",
  "pli-tv-pvr3:21.3": "vilekhā va ",
  "pli-tv-pvr3:21.4": "moho amūlakena ca. ",
  "pli-tv-pvr3:22.1": "kukkuccaṃ dhammikaṃ cīvaraṃ datvā ",
  "pli-tv-pvr3:22.2": "pariṇāmeyya puggale, ",
  "pli-tv-pvr3:22.3": "kiṃ te akālaṃ acchinde ",
  "pli-tv-pvr3:22.4": "duggahīta nirayena ca. ",
  "pli-tv-pvr3:23.1": "gaṇaṃ vibhaṅgaṃ dubbalaṃ ",
  "pli-tv-pvr3:23.2": "kaṭhināphāsu passayaṃ, ",
  "pli-tv-pvr3:23.3": "akkosacaṇḍī maccharī ",
  "pli-tv-pvr3:23.4": "gabbhinī ca pāyantiyā. ",
  "pli-tv-pvr3:24.1": "dve vassaṃ sikkhā saṅghena ",
  "pli-tv-pvr3:24.2": "tayo ceva gihīgatā, ",
  "pli-tv-pvr3:24.3": "kumārībhūtā tisso ca ",
  "pli-tv-pvr3:24.4": "ūnadvādasa sammatā. ",
  "pli-tv-pvr3:25.1": "alaṃ tāva sokāvāsaṃ ",
  "pli-tv-pvr3:25.2": "chandā anuvassā ca dve, ",
  "pli-tv-pvr3:25.3": "sikkhāpadā sattatime ",
  "pli-tv-pvr3:25.4": "samuṭṭhānā tikā katā. ",
  "pli-tv-pvr3:26.1": "kāyacittena na vācā ",
  "pli-tv-pvr3:26.2": "vācā cittaṃ na kāyikaṃ, ",
  "pli-tv-pvr3:26.3": "tīhi dvārehi jāyanti ",
  "pli-tv-pvr3:26.4": "pārājikaṃ dutiyaṃ yathā. ",
  "pli-tv-pvr3:27.1": "dutiya pārājikasamuṭṭhānaṃ niṭṭhitaṃ. ",
  "pli-tv-pvr3:28.0": "sañcaritta samuṭṭhānaṃ ",
  "pli-tv-pvr3:28.1": "sañcarī kuṭi vihāro ",
  "pli-tv-pvr3:28.2": "dhovanañca paṭiggaho, ",
  "pli-tv-pvr3:28.3": "viññattuttari abhihaṭṭhuṃ ",
  "pli-tv-pvr3:28.4": "ubhinnaṃ dūtakena ca. ",
  "pli-tv-pvr3:29.1": "kosiya suddha dvebhāgā ",
  "pli-tv-pvr3:29.2": "chabbassāni nisīdanaṃ, ",
  "pli-tv-pvr3:29.3": "riñcanti rūpikā ceva ",
  "pli-tv-pvr3:29.4": "ubho nānappakārakā. ",
  "pli-tv-pvr3:30.1": "ūna bandhana vassikā ",
  "pli-tv-pvr3:30.2": "suttaṃ vikappanena ca, ",
  "pli-tv-pvr3:30.3": "dvāra dāna sibbanī ca ",
  "pli-tv-pvr3:30.4": "pūvapaccaya joti ca. ",
  "pli-tv-pvr3:31.1": "ratanaṃ sūci mañco ca ",
  "pli-tv-pvr3:31.2": "tūlaṃ nisīdanaṃ kaṇḍu ca, ",
  "pli-tv-pvr3:31.3": "vassikā ca sugatena ",
  "pli-tv-pvr3:31.4": "viññatti aññaṃ cetāpanā. ",
  "pli-tv-pvr3:32.1": "dve saṅghikā mahājanī dve ",
  "pli-tv-pvr3:32.2": "puggalā lahukā garu, ",
  "pli-tv-pvr3:32.3": "dve vighāsā sāṭikā ca ",
  "pli-tv-pvr3:32.4": "samaṇacīvarena ca. ",
  "pli-tv-pvr3:33.1": "samapaññāsime dhammā ",
  "pli-tv-pvr3:33.2": "chahi ṭhānehi jāyare, ",
  "pli-tv-pvr3:33.3": "kāyato na cittā ",
  "pli-tv-pvr3:33.4": "vācato na kāyamanā. ",
  "pli-tv-pvr3:34.1": "kāyavācā na cittato ",
  "pli-tv-pvr3:34.2": "kāyacittā na vācato, ",
  "pli-tv-pvr3:34.3": "vācā cittā na kāyena ",
  "pli-tv-pvr3:34.4": "tīhi dvārehi jāyare, ",
  "pli-tv-pvr3:34.5": "cha samuṭṭhānikā cete, ",
  "pli-tv-pvr3:34.6": "sañcarittena sādisā. ",
  "pli-tv-pvr3:35.1": "sañcarittasamuṭṭhānaṃ niṭṭhitaṃ. ",
  "pli-tv-pvr3:36.0": "samanubhāsana samuṭṭhānaṃ ",
  "pli-tv-pvr3:36.1": "bhedānuvattadubbaca ",
  "pli-tv-pvr3:36.2": "dūsa duṭṭhulla diṭṭhi ca, ",
  "pli-tv-pvr3:36.3": "chandaṃ ujjagghikā dve ca ",
  "pli-tv-pvr3:36.4": "dve ca saddā na byāhare. ",
  "pli-tv-pvr3:37.1": "chamā nīcāsane ṭhānaṃ ",
  "pli-tv-pvr3:37.2": "pacchato uppathena ca, ",
  "pli-tv-pvr3:37.3": "vajjānuvattigahaṇā ",
  "pli-tv-pvr3:37.4": "osāre paccācikkhanā. ",
  "pli-tv-pvr3:38.1": "kismiṃ saṃsaṭṭhā dve vadhi ",
  "pli-tv-pvr3:38.2": "visibbe dukkhitāya ca, ",
  "pli-tv-pvr3:38.3": "puna saṃsaṭṭhā na vūpasame ",
  "pli-tv-pvr3:38.4": "ārāmañca pavāraṇā. ",
  "pli-tv-pvr3:39.1": "anvaddhamāsaṃ sahajīvi dve ",
  "pli-tv-pvr3:39.2": "cīvaraṃ anubandhanā; ",
  "pli-tv-pvr3:39.3": "sattatiṃsa ime dhammā ",
  "pli-tv-pvr3:39.4": "kāyavācāya cittato ",
  "pli-tv-pvr3:39.5": "sabbe ekasamuṭṭhānā ",
  "pli-tv-pvr3:39.6": "samanubhāsanā yathā. ",
  "pli-tv-pvr3:40.1": "samanubhāsanāsamuṭṭhānaṃ niṭṭhitaṃ. ",
  "pli-tv-pvr3:41.0": "kaṭhina samuṭṭhānaṃ ",
  "pli-tv-pvr3:41.1": "ubbhataṃ kaṭhinaṃ tīṇi ",
  "pli-tv-pvr3:41.2": "paṭhamaṃ pattabhesajjaṃ, ",
  "pli-tv-pvr3:41.3": "accekaṃ cāpi sāsaṅkaṃ ",
  "pli-tv-pvr3:41.4": "pakkamantena vā duve. ",
  "pli-tv-pvr3:42.1": "upassayaṃ paramparaṃ ",
  "pli-tv-pvr3:42.2": "anatirittaṃ nimantanā, ",
  "pli-tv-pvr3:42.3": "vikappaṃ rañño vikāle ",
  "pli-tv-pvr3:42.4": "vosāsāraññakena ca. ",
  "pli-tv-pvr3:43.1": "ussayā sannicayañca, ",
  "pli-tv-pvr3:43.2": "pure pacchā vikāle ca, ",
  "pli-tv-pvr3:43.3": "pañcāhikā saṅkamanī ",
  "pli-tv-pvr3:43.4": "duve āvasathena ca. ",
  "pli-tv-pvr3:44.1": "pasākhe āsane ceva ",
  "pli-tv-pvr3:44.2": "tiṃsa ekūnakā ime, ",
  "pli-tv-pvr3:44.3": "kāyavācā na cittā ",
  "pli-tv-pvr3:44.4": "tīhi dvārehi jāyare, ",
  "pli-tv-pvr3:44.5": "dve samuṭṭhānikā sabbe ",
  "pli-tv-pvr3:44.6": "kaṭhinena sahā samā. ",
  "pli-tv-pvr3:45.1": "kaṭhinasamuṭṭhānaṃ niṭṭhitaṃ. ",
  "pli-tv-pvr3:46.0": "eḷakaloma samuṭṭhānaṃ ",
  "pli-tv-pvr3:46.1": "eḷakalomā dve seyyaṃ ",
  "pli-tv-pvr3:46.2": "āhacca piṇḍabhojanaṃ, ",
  "pli-tv-pvr3:46.3": "gaṇa vikāla sannidhi ",
  "pli-tv-pvr3:46.4": "dantapoṇena celakā. ",
  "pli-tv-pvr3:47.1": "uyyuttaṃ senaṃ uyyodhī ",
  "pli-tv-pvr3:47.2": "surā orena nahāyanā, ",
  "pli-tv-pvr3:47.3": "dubbaṇṇe dve desanīyā ",
  "pli-tv-pvr3:47.4": "lasuṇupatiṭṭhe naccanā. ",
  "pli-tv-pvr3:48.1": "nahānaṃ attharaṇaṃ seyyā ",
  "pli-tv-pvr3:48.2": "anto raṭṭhe tathā bahī, ",
  "pli-tv-pvr3:48.3": "antovassaṃ cittāgāraṃ ",
  "pli-tv-pvr3:48.4": "āsandiṃ suttakantanā. ",
  "pli-tv-pvr3:49.1": "veyyāvaccaṃ sahatthā ca ",
  "pli-tv-pvr3:49.2": "abhikkhukāvāsena ca, ",
  "pli-tv-pvr3:49.3": "chattaṃ yānañca saṅghāṇiṃ ",
  "pli-tv-pvr3:49.4": "alaṅkāraṃ gandhavāsitaṃ. ",
  "pli-tv-pvr3:50.1": "bhikkhunī sikkhamānā ca ",
  "pli-tv-pvr3:50.2": "sāmaṇerī gihīniyā, ",
  "pli-tv-pvr3:50.3": "asaṃkaccikā āpatti ",
  "pli-tv-pvr3:50.4": "cattārīsā catuttarī. ",
  "pli-tv-pvr3:51.1": "kāyena na vācā cittena ",
  "pli-tv-pvr3:51.2": "kāyacittena na vācato, ",
  "pli-tv-pvr3:51.3": "dve samuṭṭhānikā sabbe ",
  "pli-tv-pvr3:51.4": "samā eḷakalomikāti. ",
  "pli-tv-pvr3:52.1": "eḷakalomasamuṭṭhānaṃ niṭṭhitaṃ. ",
  "pli-tv-pvr3:53.0": "padasodhamma samuṭṭhānaṃ ",
  "pli-tv-pvr3:53.1": "padaññatra asammatā ",
  "pli-tv-pvr3:53.2": "tathā atthaṅgatena ca, ",
  "pli-tv-pvr3:53.3": "tiracchānavijjā dve vuttā ",
  "pli-tv-pvr3:53.4": "anokāso ca pucchanā. ",
  "pli-tv-pvr3:54.1": "satta sikkhāpadā ete ",
  "pli-tv-pvr3:54.2": "vācā na kāyacittato, ",
  "pli-tv-pvr3:54.3": "vācā cittena jāyanti ",
  "pli-tv-pvr3:54.4": "na tu kāyena jāyare, ",
  "pli-tv-pvr3:54.5": "dve samuṭṭhānikā sabbe ",
  "pli-tv-pvr3:54.6": "padasodhammasadisā. ",
  "pli-tv-pvr3:55.1": "padasodhammasamuṭṭhānaṃ niṭṭhitaṃ. ",
  "pli-tv-pvr3:56.0": "addhāna samuṭṭhānaṃ addhānaṃ ",
  "pli-tv-pvr3:56.1": "nāvaṃ paṇītaṃ, ",
  "pli-tv-pvr3:56.2": "mātugāmena saṃhare, ",
  "pli-tv-pvr3:56.3": "dhaññaṃ nimantitā ceva ",
  "pli-tv-pvr3:56.4": "aṭṭha ca pāṭidesanī. ",
  "pli-tv-pvr3:57.1": "sikkhā paṇṇarasā ete ",
  "pli-tv-pvr3:57.2": "kāyā na vācā na manā, ",
  "pli-tv-pvr3:57.3": "kāyavācāhi jāyanti ",
  "pli-tv-pvr3:57.4": "na te cittena jāyare ",
  "pli-tv-pvr3:58.1": "kāyacittena jāyanti ",
  "pli-tv-pvr3:58.2": "na te jāyanti vācato, ",
  "pli-tv-pvr3:58.3": "kāyavācāhi cittena ",
  "pli-tv-pvr3:58.4": "samuṭṭhānā catubbidhā. ",
  "pli-tv-pvr3:58.5": "paññattā buddhañāṇena ",
  "pli-tv-pvr3:58.6": "addhānena sahā samā. ",
  "pli-tv-pvr3:59.1": "addhānasamuṭṭhānaṃ niṭṭhitaṃ. ",
  "pli-tv-pvr3:60.0": "theyyasattha samuṭṭhānaṃ ",
  "pli-tv-pvr3:60.1": "theyyasatthaṃ upassuti ",
  "pli-tv-pvr3:60.2": "sūpaṃ viññāpanena ca, ",
  "pli-tv-pvr3:60.3": "ratti channañca okāsaṃ ",
  "pli-tv-pvr3:60.4": "ete byūhena sattamā. ",
  "pli-tv-pvr3:61.1": "kāya cittena jāyanti ",
  "pli-tv-pvr3:61.2": "na te jāyanti vācato, ",
  "pli-tv-pvr3:61.3": "tīhi dvārehi jāyanti ",
  "pli-tv-pvr3:61.4": "dve samuṭṭhānikā ime, ",
  "pli-tv-pvr3:61.5": "theyyasatthasamuṭṭhānā ",
  "pli-tv-pvr3:61.6": "desitādiccabandhunā. ",
  "pli-tv-pvr3:62.1": "theyyasatthasamuṭṭhānaṃ niṭṭhitaṃ. ",
  "pli-tv-pvr3:63.0": "dhammadesana samuṭṭhānaṃ ",
  "pli-tv-pvr3:63.1": "chattapāṇissa saddhammaṃ ",
  "pli-tv-pvr3:63.2": "na desenti tathāgatā, ",
  "pli-tv-pvr3:63.3": "tatheva daṇḍapāṇissa, ",
  "pli-tv-pvr3:63.4": "satthaāyudhapāṇinaṃ. ",
  "pli-tv-pvr3:64.1": "pādukūpāhanā yānaṃ ",
  "pli-tv-pvr3:64.2": "seyyapallatthikāya ca, ",
  "pli-tv-pvr3:64.3": "veṭhito guṇṭhito ceva ",
  "pli-tv-pvr3:64.4": "ekādasa manūnakā. ",
  "pli-tv-pvr3:65.1": "vācā cittena jāyanti ",
  "pli-tv-pvr3:65.2": "na te jāyanti kāyato, ",
  "pli-tv-pvr3:65.3": "sabbe ekasamuṭṭhānā ",
  "pli-tv-pvr3:65.4": "samakā dhammadesane. ",
  "pli-tv-pvr3:66.1": "dhammadesanāsamuṭṭhānaṃ niṭṭhitaṃ. ",
  "pli-tv-pvr3:67.0": "bhūtārocana samuṭṭhānaṃ ",
  "pli-tv-pvr3:67.1": "bhūtaṃ kāyena jāyati ",
  "pli-tv-pvr3:67.2": "na vācāya na cittato, ",
  "pli-tv-pvr3:67.3": "vācato ca samuṭṭhāti ",
  "pli-tv-pvr3:67.4": "na kāyā na ca cittato ",
  "pli-tv-pvr3:68.1": "kāyavācāya jāyati ",
  "pli-tv-pvr3:68.2": "na ca jāyati cittato, ",
  "pli-tv-pvr3:68.3": "bhūtārocanakā nāma ",
  "pli-tv-pvr3:68.4": "tīhi ṭhānehi jāyati. ",
  "pli-tv-pvr3:69.1": "bhūtārocanasamuṭṭhānaṃ niṭṭhitaṃ. ",
  "pli-tv-pvr3:70.0": "corivuṭṭhāpana samuṭṭhānaṃ ",
  "pli-tv-pvr3:70.1": "coriṃ vācāya cittena, ",
  "pli-tv-pvr3:70.2": "na taṃ jāyati kāyato; ",
  "pli-tv-pvr3:70.3": "jāyati tīhi dvārehi ",
  "pli-tv-pvr3:70.4": "corivuṭṭhāpanaṃ idaṃ, ",
  "pli-tv-pvr3:70.5": "akataṃ dvisamuṭṭhānaṃ ",
  "pli-tv-pvr3:70.6": "dhammarājena bhāsitaṃ. ",
  "pli-tv-pvr3:71.1": "corivuṭṭhāpanasamuṭṭhānaṃ niṭṭhitaṃ. ",
  "pli-tv-pvr3:72.0": "ananuññāta samuṭṭhānaṃ ",
  "pli-tv-pvr3:72.1": "ananuññātaṃ vācāya ",
  "pli-tv-pvr3:72.2": "na kāyā na ca cittato, ",
  "pli-tv-pvr3:72.3": "jāyati kāyavācāya ",
  "pli-tv-pvr3:72.4": "na taṃ jāyati cittato. ",
  "pli-tv-pvr3:73.1": "jāyati vācā cittena ",
  "pli-tv-pvr3:73.2": "na taṃ jāyati kāyato, ",
  "pli-tv-pvr3:73.3": "jāyati tīhi dvārehi ",
  "pli-tv-pvr3:73.4": "akataṃ catuṭhānikaṃ. ",
  "pli-tv-pvr3:74.1": "ananuññātasamuṭṭhānaṃ niṭṭhitaṃ. ",
  "pli-tv-pvr3:75.1": "samuṭṭhānaṃ hi saṅkhepaṃ ",
  "pli-tv-pvr3:75.2": "dasa tīṇi sudesitaṃ, ",
  "pli-tv-pvr3:75.3": "asammohakaraṃ ṭhānaṃ ",
  "pli-tv-pvr3:75.4": "nettidhammānulomikaṃ, ",
  "pli-tv-pvr3:75.5": "dhārayanto imaṃ viññū ",
  "pli-tv-pvr3:75.6": "samuṭṭhāne na muyhatīti. ",
  "pli-tv-pvr3:76.1": "samuṭṭhānasīsasaṅkhepo niṭṭhito. "
}
