  "pli-tv-bi-vb-pc61:0.2": "",
  "pli-tv-bi-vb-pc61:0.3": "",
  "pli-tv-bi-vb-pc61:0.4": "7. gabbhinivaggo ",
  "pli-tv-bi-vb-pc61:0.5": "paṭhamasikkhāpadaṃ ",
  "pli-tv-bi-vb-pc61:1.0": "4. 7. 1. ",
  "pli-tv-bi-vb-pc61:1.1": "tena samayena buddho bhagavā sāvatthiyaṃ viharati jetavane anāthapiṇḍikassa ārāme. ",
  "pli-tv-bi-vb-pc61:1.2": "tena kho pana samayena bhikkhuniyo gabbhiniṃ vuṭṭhāpenti. ",
  "pli-tv-bi-vb-pc61:1.3": "sā piṇḍāya carati. ",
  "pli-tv-bi-vb-pc61:1.4": "manussā evamāhaṃsu: ",
  "pli-tv-bi-vb-pc61:1.5": "detha ayyāya bhikkhaṃ garubhārā ayyāti. ",
  "pli-tv-bi-vb-pc61:1.6": "manussā ujjhāyanti khīyanti vipācenti: ",
  "pli-tv-bi-vb-pc61:1.7": "“kathaṃ hi nāma bhikkhuniyo gabbhiniṃ vuṭṭhāpessantī”ti. ",
  "pli-tv-bi-vb-pc61:1.8": "assosuṃ kho bhikkhuniyo tesaṃ manussānaṃ ujjhāyantānaṃ khīyantānaṃ vipācentānaṃ. ",
  "pli-tv-bi-vb-pc61:1.9": "yā tā bhikkhuniyo appicchā …pe… tā ujjhāyanti khīyanti vipācenti: ",
  "pli-tv-bi-vb-pc61:1.10": "“kathaṃ hi nāma bhikkhuniyo gabbhiniṃ vuṭṭhāpessantī”ti …pe… ",
  "pli-tv-bi-vb-pc61:1.11": "saccaṃ kira bhikkhave bhikkhuniyo gabbhiniṃ vuṭṭhāpentīti. ",
  "pli-tv-bi-vb-pc61:1.12": "saccaṃ bhagavā. ",
  "pli-tv-bi-vb-pc61:1.13": "vigarahi buddho bhagavā …pe… ",
  "pli-tv-bi-vb-pc61:1.14": "kathaṃ hi nāma bhikkhave bhikkhuniyo gabbhiniṃ vuṭṭhāpessanti. ",
  "pli-tv-bi-vb-pc61:1.15": "netaṃ bhikkhave appasannānaṃ vā pasādāya …pe… ",
  "pli-tv-bi-vb-pc61:1.16": "evañca pana bhikkhave bhikkhuniyo imaṃ sikkhāpadaṃ uddisantu: ",
  "pli-tv-bi-vb-pc61:1.17.0": "",
  "pli-tv-bi-vb-pc61:1.17.1": "“yā pana bhikkhunī gabbhiniṃ vuṭṭhāpeyya, pācittiya”nti. ",
  "pli-tv-bi-vb-pc61:2.1.0": "",
  "pli-tv-bi-vb-pc61:2.1.1": "yā panāti: ",
  "pli-tv-bi-vb-pc61:2.1.2": "yā yādisā …pe… ",
  "pli-tv-bi-vb-pc61:2.1.3": "bhikkhunīti ",
  "pli-tv-bi-vb-pc61:2.1.4": "…pe… ayaṃ imasmiṃ atthe adhippetā bhikkhunīti. ",
  "pli-tv-bi-vb-pc61:2.1.5": "gabbhinī nāma: ",
  "pli-tv-bi-vb-pc61:2.1.6": "āpannasattā vuccati. ",
  "pli-tv-bi-vb-pc61:2.1.7": "vuṭṭhāpeyyāti: ",
  "pli-tv-bi-vb-pc61:2.1.8": "upasampādeyya. ",
  "pli-tv-bi-vb-pc61:2.1.9": "vuṭṭhāpessāmīti gaṇaṃ vā ācariniṃ vā pattaṃ vā cīvaraṃ vā pariyesati sīmaṃ vā sammannati āpatti dukkaṭassa. ",
  "pli-tv-bi-vb-pc61:2.1.10": "ñattiyā dukkaṭaṃ ",
  "pli-tv-bi-vb-pc61:2.1.11": "dvīhi kammavācāhi dukkaṭā, ",
  "pli-tv-bi-vb-pc61:2.1.12": "kammavācā pariyosāne upajjhāyāya āpatti pācittiyassa. ",
  "pli-tv-bi-vb-pc61:2.1.13": "gaṇassa ca ācariniyā ca āpatti dukkaṭassa. ",
  "pli-tv-bi-vb-pc61:2.2.0": "",
  "pli-tv-bi-vb-pc61:2.2.1": "gabbhiniyā gabbhinisaññā vuṭṭhāpeti, āpatti pācittiyassa. ",
  "pli-tv-bi-vb-pc61:2.2.2": "gabbhiniyā vematikā vuṭṭhāpeti āpatti dukkaṭassa. ",
  "pli-tv-bi-vb-pc61:2.2.3": "gabbhiniyā agabbhinisaññā vuṭṭhāpeti anāpatti. ",
  "pli-tv-bi-vb-pc61:2.2.4": "agabbhiniyā gabbhinisaññā āpatti dukkaṭassa. ",
  "pli-tv-bi-vb-pc61:2.2.5": "agabbhiniyā vematikā āpatti dukkaṭassa. ",
  "pli-tv-bi-vb-pc61:2.2.6": "agabbhiniyā agabbhini saññā anāpatti:. ",
  "pli-tv-bi-vb-pc61:2.3.0": "",
  "pli-tv-bi-vb-pc61:2.3.1": "anāpatti: ",
  "pli-tv-bi-vb-pc61:2.3.2": "gabbhiniṃ agabbhinisaññā vuṭṭhāpeti ",
  "pli-tv-bi-vb-pc61:2.3.3": "agabbhiniṃ agabbhinisaññā vuṭṭhāpeti ",
  "pli-tv-bi-vb-pc61:2.3.4": "ummattikāya …pe… ",
  "pli-tv-bi-vb-pc61:2.3.5": "ādikammikāyāti. ",
  "pli-tv-bi-vb-pc61:2.3.6": "paṭhamasikkhāpadaṃ. "
}
