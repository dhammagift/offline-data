  "pli-tv-bi-vb-pc62:0.3": "",
  "pli-tv-bi-vb-pc62:0.4": "",
  "pli-tv-bi-vb-pc62:0.5": "dutiyasikkhāpadaṃ ",
  "pli-tv-bi-vb-pc62:1.0": "4. 7. 2. ",
  "pli-tv-bi-vb-pc62:1.1": "sāvatthinidānaṃ – ",
  "pli-tv-bi-vb-pc62:1.2": "tena kho pana samayena bhikkhuniyo pāyantiṃ vuṭṭhāpenti. ",
  "pli-tv-bi-vb-pc62:1.3": "sā piṇḍāya carati. ",
  "pli-tv-bi-vb-pc62:1.4": "manussā evamāhaṃsu ",
  "pli-tv-bi-vb-pc62:1.5": "detha ayyāya bhikkhaṃ sadutiyikā ayyāti. ",
  "pli-tv-bi-vb-pc62:1.6": "manussā ujjhāyanti khīyanti vipācenti: ",
  "pli-tv-bi-vb-pc62:1.7": "“kathaṃ hi nāma bhikkhuniyo pāyantiṃ vuṭṭhāpessantī”ti. ",
  "pli-tv-bi-vb-pc62:1.8": "assosuṃ kho bhikkhuniyo tesaṃ manussānaṃ ujjhāyantānaṃ khīyantānaṃ vipācentānaṃ. ",
  "pli-tv-bi-vb-pc62:1.9": "yā tā bhikkhuniyo appicchā …pe… tā ujjhāyanti khīyanti vipācenti, ",
  "pli-tv-bi-vb-pc62:1.10": "“kathaṃ hi nāma bhikkhuniyo pāyantiṃ vuṭṭhāpessantī”ti …pe… ",
  "pli-tv-bi-vb-pc62:1.11": "saccaṃ kira bhikkhave bhikkhuniyo pāyantiṃ vuṭṭhāpentīti. ",
  "pli-tv-bi-vb-pc62:1.12": "saccaṃ bhagavā. ",
  "pli-tv-bi-vb-pc62:1.13": "vigarahi buddho bhagavā …pe… ",
  "pli-tv-bi-vb-pc62:1.14": "kathaṃ hi nāma bhikkhave bhikkhuniyo pāyantiṃ vuṭṭhāpessanti. ",
  "pli-tv-bi-vb-pc62:1.15": "netaṃ bhikkhave appasannānaṃ vā pasādāya …pe… ",
  "pli-tv-bi-vb-pc62:1.16": "evañca pana bhikkhave bhikkhuniyo imaṃ sikkhāpadaṃ uddisantu: ",
  "pli-tv-bi-vb-pc62:1.17.0": "",
  "pli-tv-bi-vb-pc62:1.17.1": "“yā pana bhikkhunī pāyantiṃ vuṭṭhāpeyya pācittiya”nti. ",
  "pli-tv-bi-vb-pc62:2.0": "",
  "pli-tv-bi-vb-pc62:2.1": "yā panāti: ",
  "pli-tv-bi-vb-pc62:2.2": "yā yādisā …pe… ",
  "pli-tv-bi-vb-pc62:2.3": "bhikkhunīti ",
  "pli-tv-bi-vb-pc62:2.4": "…pe… ayaṃ imasmiṃ atthe adhippetā bhikkhunīti. ",
  "pli-tv-bi-vb-pc62:2.5": "pāyantī nāma: ",
  "pli-tv-bi-vb-pc62:2.6": "mātā vā hoti dhāti vā. ",
  "pli-tv-bi-vb-pc62:2.7": "vuṭṭhāpeyyāti: ",
  "pli-tv-bi-vb-pc62:2.8": "upasampādeyya. ",
  "pli-tv-bi-vb-pc62:2.9": "vuṭṭhāpessāmīti gaṇaṃ vā ācariniṃ vā pattaṃ vā cīvaraṃ vā pariyesati sīmaṃ vā sammannati āpatti dukkaṭassa. ",
  "pli-tv-bi-vb-pc62:2.10": "ñattiyā dukkaṭaṃ ",
  "pli-tv-bi-vb-pc62:2.11": "dvīhi kammavācāhi dukkaṭā, ",
  "pli-tv-bi-vb-pc62:2.12": "kammavācā pariyosāne upajjhāyāya āpatti pācittiyassa, ",
  "pli-tv-bi-vb-pc62:2.13": "gaṇassa ca ācariniyā ca āpatti dukkaṭassa. ",
  "pli-tv-bi-vb-pc62:2.14.0": "",
  "pli-tv-bi-vb-pc62:2.14.1": "pāyantiyā pāyantisaññā vuṭṭhāpeti āpatti pācittiyassa. ",
  "pli-tv-bi-vb-pc62:2.15": "pāyantiyā vematikā vuṭṭhāpeti āpatti dukkaṭassa. ",
  "pli-tv-bi-vb-pc62:2.16": "pāyantiyā apāyantisaññā vuṭṭhāpeti anāpatti:. ",
  "pli-tv-bi-vb-pc62:2.17": "apāyantiyā pāyantisaññā āpatti dukkaṭassa. ",
  "pli-tv-bi-vb-pc62:2.18": "apāyantiyā vematikā āpatti dukkaṭassa. ",
  "pli-tv-bi-vb-pc62:2.19": "apāyantiyā apāyantisaññā anāpatti:. ",
  "pli-tv-bi-vb-pc62:2.20.0": "",
  "pli-tv-bi-vb-pc62:2.20.1": "anāpatti: ",
  "pli-tv-bi-vb-pc62:2.21": "pāyantiṃ apāyantisaññā vuṭṭhāpeti, ",
  "pli-tv-bi-vb-pc62:2.22": "apāyantiṃ apāyantisaññā vuṭṭhāpeti, ",
  "pli-tv-bi-vb-pc62:2.23": "ummattikāya …pe… ",
  "pli-tv-bi-vb-pc62:2.24": "ādikammikāyāti. ",
  "pli-tv-bi-vb-pc62:2.25": "dutiyasikkhāpadaṃ. "
}
