  "pli-tv-bi-vb-pc47:0.3": "",
  "pli-tv-bi-vb-pc47:0.4": "",
  "pli-tv-bi-vb-pc47:0.5": "sattamasikkhāpadaṃ ",
  "pli-tv-bi-vb-pc47:1.0": "4. 5. 7. ",
  "pli-tv-bi-vb-pc47:1.1": "sāvatthinidānaṃ – ",
  "pli-tv-bi-vb-pc47:1.2": "tena kho pana samayena thullanandā bhikkhunī āvasathacīvaraṃ anissajitvā paribhuñjati. ",
  "pli-tv-bi-vb-pc47:1.3": "aññā utuniyo bhikkhuniyo na labhanti. ",
  "pli-tv-bi-vb-pc47:1.4": "yā tā bhikkhuniyo appicchā …pe… tā ujjhāyanti khīyanti vipācenti:: ",
  "pli-tv-bi-vb-pc47:1.5": "“kathaṃ hi nāma: ayyā thullanandā āvasathacīvaraṃ anissajitvā paribhuñjissatī”ti …pe… ",
  "pli-tv-bi-vb-pc47:1.6": "saccaṃ kira bhikkhave thullanandā bhikkhunī āvasathacīvaraṃ anissajitvā paribhuñjatīti. ",
  "pli-tv-bi-vb-pc47:1.7": "saccaṃ bhagavā. ",
  "pli-tv-bi-vb-pc47:1.8": "vigarahi buddho bhagavā …pe… ",
  "pli-tv-bi-vb-pc47:1.9": "kathaṃ hi nāma: bhikkhave thullanandā bhikkhunī āvasathacīvaraṃ anissajitvā paribhuñjissati. ",
  "pli-tv-bi-vb-pc47:1.10": "netaṃ bhikkhave appasannānaṃ vā pasādāya …pe… ",
  "pli-tv-bi-vb-pc47:1.11": "evañca pana bhikkhave bhikkhuniyo imaṃ sikkhāpadaṃ uddisantu:: ",
  "pli-tv-bi-vb-pc47:1.12.0": "",
  "pli-tv-bi-vb-pc47:1.12.1": "”yā pana bhikkhunī āvasathacīvaraṃ anissajitvā paribhuñjeyya pācittiya”nti. ",
  "pli-tv-bi-vb-pc47:2.1.0": "",
  "pli-tv-bi-vb-pc47:2.1.1": "yā panāti: ",
  "pli-tv-bi-vb-pc47:2.1.2": "yā yādisā …pe… ",
  "pli-tv-bi-vb-pc47:2.1.3": "bhikkhunīti ",
  "pli-tv-bi-vb-pc47:2.1.4": "…pe… ayaṃ imasmiṃ atthe adhippetā bhikkhunīti. ",
  "pli-tv-bi-vb-pc47:2.1.5": "āvasathacīvaraṃ nāma: ",
  "pli-tv-bi-vb-pc47:2.1.6": "utuniyo bhikkhuniyo paribhuñjantūti dinnaṃ hoti. ",
  "pli-tv-bi-vb-pc47:2.1.7": "anissajitvā paribhuñjeyyāti: ",
  "pli-tv-bi-vb-pc47:2.1.8": "dve tisso rattiyo paribhuñjitvā catutthadivase dhovitvā bhikkhuniyā vā sikkhamānāya vā sāmaṇerāya vā anissajitvā paribhuñjati āpatti pācittiyassa. ",
  "pli-tv-bi-vb-pc47:2.2.0": "",
  "pli-tv-bi-vb-pc47:2.2.1": "anissajjite anissajjitasaññā paribhuñjati āpatti pācittiyassa. ",
  "pli-tv-bi-vb-pc47:2.2.2": "anissajjite vematikā paribhuñjati āpatti pācittiyassa. ",
  "pli-tv-bi-vb-pc47:2.2.3": "anissajjite nissajjitasaññā paribhuñjati āpatti pācittiyassa. ",
  "pli-tv-bi-vb-pc47:2.2.4": "nissajjite anissajjitasaññā āpatti dukkaṭassa. ",
  "pli-tv-bi-vb-pc47:2.2.5": "nissajjite vematikā āpatti dukkaṭassa. ",
  "pli-tv-bi-vb-pc47:2.2.6": "nissajjite nissajjitasaññā anāpatti:. ",
  "pli-tv-bi-vb-pc47:2.3.0": "",
  "pli-tv-bi-vb-pc47:2.3.1": "anāpatti: ",
  "pli-tv-bi-vb-pc47:2.3.2": "nissajjitvā paribhuñjati, ",
  "pli-tv-bi-vb-pc47:2.3.3": "punapariyāyena paribhuñjati. ",
  "pli-tv-bi-vb-pc47:2.3.4": "aññā utuniyo bhikkhuniyo na honti, ",
  "pli-tv-bi-vb-pc47:2.3.5": "acchinnacīvarikāya, ",
  "pli-tv-bi-vb-pc47:2.3.6": "naṭṭhacīvarikāya, ",
  "pli-tv-bi-vb-pc47:2.3.7": "āpadāsu ",
  "pli-tv-bi-vb-pc47:2.3.8": "ummattikāya …pe… ",
  "pli-tv-bi-vb-pc47:2.3.9": "ādikammikāyāti. ",
  "pli-tv-bi-vb-pc47:2.3.10": "sattamasikkhāpadaṃ. "
}
