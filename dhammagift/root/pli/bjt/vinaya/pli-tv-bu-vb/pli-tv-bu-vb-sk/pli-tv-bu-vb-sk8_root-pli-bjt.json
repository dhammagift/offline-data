  "pli-tv-bu-vb-sk8:0.4": "",
  "pli-tv-bu-vb-sk8:0.5": "sattama sikkhāpadaṃ. ",
  "pli-tv-bu-vb-sk8:1.0": "8. 1. 8. ",
  "pli-tv-bu-vb-sk8:1.1": "tena samayena buddho bhagavā sāvatthiyaṃ viharati jetavane anāthapiṇḍikassa ārāme. ",
  "pli-tv-bu-vb-sk8:1.2": "tena kho pana samayena chabbaggiyā bhikkhū tahaṃ tahaṃ olokentā antaraghare nisīdanti …pe… ",
  "pli-tv-bu-vb-sk8:1.3.0": "",
  "pli-tv-bu-vb-sk8:1.3.1": "“okkhittacakkhū antaraghare nisīdissāmīti sikkhā karaṇīyā”ti. ",
  "pli-tv-bu-vb-sk8:1.4": "okkhittacakkhunā antaraghare nisīditabbaṃ yugamattaṃ pekkhantena, ",
  "pli-tv-bu-vb-sk8:1.5": "yo anādariyaṃ paṭicca tahaṃ tahaṃ olokento antaraghare nisīdati āpatti dukkaṭassa. ",
  "pli-tv-bu-vb-sk8:1.6.0": "",
  "pli-tv-bu-vb-sk8:1.6.1": "anāpatti: ",
  "pli-tv-bu-vb-sk8:1.7": "asañcicca, ",
  "pli-tv-bu-vb-sk8:1.8": "asatiyā, ",
  "pli-tv-bu-vb-sk8:1.9": "ajānantassa, ",
  "pli-tv-bu-vb-sk8:1.10": "gilānassa, ",
  "pli-tv-bu-vb-sk8:1.11": "āpadāsu, ",
  "pli-tv-bu-vb-sk8:1.12": "ummattakassa, ",
  "pli-tv-bu-vb-sk8:1.13": "ādikammikassāti. ",
  "pli-tv-bu-vb-sk8:1.14": "aṭṭhamasikkhāpadaṃ. "
}
