  "pli-tv-bu-vb-sk66:1.0": "8. 7. 6. ",
  "pli-tv-bu-vb-sk66:1.1": "sāvatthinidānaṃ – ",
  "pli-tv-bu-vb-sk66:1.2": "tena kho pana samayena chabbaggiyā bhikkhū veṭhitasīsassa dhammaṃ desenti …pe… ",
  "pli-tv-bu-vb-sk66:1.3.0": "",
  "pli-tv-bu-vb-sk66:1.3.1": "na veṭhitasīsassa agilānassa dhammaṃ desissāmīti sikkhā karaṇīyā’ti. ",
  "pli-tv-bu-vb-sk66:1.4.0": "",
  "pli-tv-bu-vb-sk66:1.4.1": "veṭhitasīso nāma: ",
  "pli-tv-bu-vb-sk66:1.5": "kesantaṃ na dassāpetvā veṭhito hoti. ",
  "pli-tv-bu-vb-sk66:1.6": "na veṭhitasīsassa agilānassa dhammo desetabbo. ",
  "pli-tv-bu-vb-sk66:1.7": "yo anādariyaṃ paṭicca veṭhitasīsassa agilānassa dhammaṃ deseti, āpatti dukkaṭassa. ",
  "pli-tv-bu-vb-sk66:1.8.0": "",
  "pli-tv-bu-vb-sk66:1.8.1": "anāpatti: ",
  "pli-tv-bu-vb-sk66:1.9": "asañcicca, ",
  "pli-tv-bu-vb-sk66:1.10": "asatiyā, ",
  "pli-tv-bu-vb-sk66:1.11": "ajānantassa, ",
  "pli-tv-bu-vb-sk66:1.12": "gilānassa, ",
  "pli-tv-bu-vb-sk66:1.13": "kesantaṃ vivarāpetvā deseti, ",
  "pli-tv-bu-vb-sk66:1.14": "āpadāsu, ",
  "pli-tv-bu-vb-sk66:1.15": "ummattakassa, ",
  "pli-tv-bu-vb-sk66:1.16": "ādikammikassāti. ",
  "pli-tv-bu-vb-sk66:1.17": "chaṭṭhasikkhāpadaṃ. "
}
