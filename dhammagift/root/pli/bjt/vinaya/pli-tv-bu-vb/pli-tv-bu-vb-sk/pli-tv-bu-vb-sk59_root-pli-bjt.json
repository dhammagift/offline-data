  "pli-tv-bu-vb-sk59:1.0": "8. 6. 9. ",
  "pli-tv-bu-vb-sk59:1.1": "sāvatthinidānaṃ – ",
  "pli-tv-bu-vb-sk59:1.2": "tena kho pana samayena chabbaggiyā bhikkhū satthapāṇissa dhammaṃ desenti …pe… ",
  "pli-tv-bu-vb-sk59:1.3.0": "",
  "pli-tv-bu-vb-sk59:1.3.1": "na satthapāṇissa agilānassa dhammaṃ desissāmīti sikkhā karaṇīyā’ti. ",
  "pli-tv-bu-vb-sk59:1.4.0": "",
  "pli-tv-bu-vb-sk59:1.4.1": "satthaṃ nāma: ",
  "pli-tv-bu-vb-sk59:1.5": "ekatodhāraṃ ubhatodhāraṃ paharaṇaṃ. ",
  "pli-tv-bu-vb-sk59:1.6": "na satthapāṇissa agilānassa dhammo desetabbo. ",
  "pli-tv-bu-vb-sk59:1.7": "yo anādariyaṃ paṭicca satthapāṇissa agilānassa dhammaṃ deseti āpatti dukkaṭassa. ",
  "pli-tv-bu-vb-sk59:1.8.0": "",
  "pli-tv-bu-vb-sk59:1.8.1": "anāpatti: ",
  "pli-tv-bu-vb-sk59:1.9.1": "asañcicca …pe… ",
  "pli-tv-bu-vb-sk59:1.9.2": "",
  "pli-tv-bu-vb-sk59:1.9.3": "",
  "pli-tv-bu-vb-sk59:1.9.4": "",
  "pli-tv-bu-vb-sk59:1.9.5": "",
  "pli-tv-bu-vb-sk59:1.9.6": "",
  "pli-tv-bu-vb-sk59:1.10": "ādikammikassāti. ",
  "pli-tv-bu-vb-sk59:1.11": "navamasikkhāpadaṃ. "
}
