  "pli-tv-bu-vb-sk54:1.0": "8. 6. 4. ",
  "pli-tv-bu-vb-sk54:1.1": "sāvatthinidānaṃ – ",
  "pli-tv-bu-vb-sk54:1.2": "tena kho pana samayena chabbaggiyā bhikkhū oṭṭhanillehakaṃ bhuñjanti …pe… ",
  "pli-tv-bu-vb-sk54:1.3.0": "",
  "pli-tv-bu-vb-sk54:1.3.1": "na oṭṭhanillehakaṃ bhuñjissāmīti sikkhā karaṇīyā’ti. ",
  "pli-tv-bu-vb-sk54:1.4": "na oṭṭhanillehakaṃ bhuñjitabbaṃ. ",
  "pli-tv-bu-vb-sk54:1.5": "yo anādariyaṃ paṭicca oṭṭhanillehakaṃ bhuñjati āpatti dukkaṭassa. ",
  "pli-tv-bu-vb-sk54:1.6.0": "",
  "pli-tv-bu-vb-sk54:1.6.1": "anāpatti: ",
  "pli-tv-bu-vb-sk54:1.7.1": "asañcicca …pe… ",
  "pli-tv-bu-vb-sk54:1.7.2": "",
  "pli-tv-bu-vb-sk54:1.7.3": "",
  "pli-tv-bu-vb-sk54:1.7.4": "",
  "pli-tv-bu-vb-sk54:1.7.5": "",
  "pli-tv-bu-vb-sk54:1.7.6": "",
  "pli-tv-bu-vb-sk54:1.8": "ādikammikassāti. ",
  "pli-tv-bu-vb-sk54:1.9": "catutthasikkhāpadaṃ. "
}
