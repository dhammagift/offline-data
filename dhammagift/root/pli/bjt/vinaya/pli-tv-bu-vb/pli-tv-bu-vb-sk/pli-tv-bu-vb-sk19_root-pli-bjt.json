  "pli-tv-bu-vb-sk19:1.0": "8. 2. 9. ",
  "pli-tv-bu-vb-sk19:1.1": "sāvatthinidānaṃ – ",
  "pli-tv-bu-vb-sk19:1.2": "tena kho pana samayena chabbaggiyā bhikkhū sīsappacālakaṃ antaraghare gacchanti sīsaṃ olambentā …pe… ",
  "pli-tv-bu-vb-sk19:1.3.0": "",
  "pli-tv-bu-vb-sk19:1.3.1": "na sīsappacālakaṃ antaraghare gamissāmīti sikkhā karaṇīyā’ti. ",
  "pli-tv-bu-vb-sk19:1.4": "na sīsappacālakaṃ antaraghare gantabbaṃ. ",
  "pli-tv-bu-vb-sk19:1.5": "sīsaṃ paggahetvā gantabbaṃ. ",
  "pli-tv-bu-vb-sk19:1.6": "yo anādariyaṃ paṭicca sīsappacālakaṃ antaraghare gacchati sīsaṃ olambento āpatti dukkaṭassa. ",
  "pli-tv-bu-vb-sk19:1.7.0": "",
  "pli-tv-bu-vb-sk19:1.7.1": "anāpatti: ",
  "pli-tv-bu-vb-sk19:1.8.1": "asañcicca …pe… ",
  "pli-tv-bu-vb-sk19:1.8.2": "",
  "pli-tv-bu-vb-sk19:1.8.3": "",
  "pli-tv-bu-vb-sk19:1.8.4": "",
  "pli-tv-bu-vb-sk19:1.8.5": "",
  "pli-tv-bu-vb-sk19:1.8.6": "",
  "pli-tv-bu-vb-sk19:1.9": "ādikammikassāti. ",
  "pli-tv-bu-vb-sk19:1.10": "navamasikkhāpadaṃ. "
}
