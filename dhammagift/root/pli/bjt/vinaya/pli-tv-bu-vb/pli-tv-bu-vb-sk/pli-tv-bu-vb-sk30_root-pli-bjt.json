  "pli-tv-bu-vb-sk30:1.0": "8. 3. 10. ",
  "pli-tv-bu-vb-sk30:1.1": "sāvatthinidānaṃ – ",
  "pli-tv-bu-vb-sk30:1.2": "tena kho pana samayena chabbaggiyā bhikkhū thūpīkataṃ piṇḍapātaṃ paṭigaṇhanti …pe… ",
  "pli-tv-bu-vb-sk30:1.3.0": "",
  "pli-tv-bu-vb-sk30:1.3.1": "“samatittikaṃ piṇḍapātaṃ paṭiggahessāmīti sikkhā karaṇīyā”ti. ",
  "pli-tv-bu-vb-sk30:1.4": "samatittiko piṇḍapāto paṭiggahetabbo. ",
  "pli-tv-bu-vb-sk30:1.5": "yo anādariyaṃ paṭicca thūpīkataṃ piṇḍapātaṃ paṭigaṇhāti āpatti dukkaṭassa. ",
  "pli-tv-bu-vb-sk30:1.6.0": "",
  "pli-tv-bu-vb-sk30:1.6.1": "anāpatti: ",
  "pli-tv-bu-vb-sk30:1.7.1": "asañcicca ",
  "pli-tv-bu-vb-sk30:1.7.2": "asatiyā ",
  "pli-tv-bu-vb-sk30:1.7.3": "ajānantassa ",
  "pli-tv-bu-vb-sk30:1.7.4": "āpadāsu ",
  "pli-tv-bu-vb-sk30:1.8": "ummattakassa ",
  "pli-tv-bu-vb-sk30:1.9": "ādikammikassāti. ",
  "pli-tv-bu-vb-sk30:1.10": "",
  "pli-tv-bu-vb-sk30:1.11": "dasama sikkhāpadaṃ. khambhakatavaggo tatiyo. sakkaccavaggo "
}
