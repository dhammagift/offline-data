  "pli-tv-bu-vb-sk60:1.0": "8. 6. 10. ",
  "pli-tv-bu-vb-sk60:1.1": "sāvatthinidānaṃ – ",
  "pli-tv-bu-vb-sk60:1.2": "tena kho pana samayena chabbaggiyā bhikkhū āyudhapāṇissa dhammaṃ desenti …pe… ",
  "pli-tv-bu-vb-sk60:1.3.0": "",
  "pli-tv-bu-vb-sk60:1.3.1": "na āyudhapāṇissa agilānassa dhammaṃ desissāmīti sikkhā karaṇīyā’ti. ",
  "pli-tv-bu-vb-sk60:1.4.0": "",
  "pli-tv-bu-vb-sk60:1.4.1": "āyudhaṃ nāma: ",
  "pli-tv-bu-vb-sk60:1.5": "cāpo kodaṇḍo. ",
  "pli-tv-bu-vb-sk60:1.6": "na āyudhapāṇissa agilānassa dhammo desetabbo. ",
  "pli-tv-bu-vb-sk60:1.7": "yo anādariyaṃ paṭicca āyudhapāṇissa agilānassa dhammaṃ deseti āpatti dukkaṭassa. ",
  "pli-tv-bu-vb-sk60:1.8.0": "",
  "pli-tv-bu-vb-sk60:1.8.1": "anāpatti: ",
  "pli-tv-bu-vb-sk60:1.9.1": "asañcicca, asatiyā, ajānantassa, gilānassa, āpadāsu, ummattakassa, ",
  "pli-tv-bu-vb-sk60:1.9.2": "",
  "pli-tv-bu-vb-sk60:1.9.3": "",
  "pli-tv-bu-vb-sk60:1.9.4": "",
  "pli-tv-bu-vb-sk60:1.9.5": "",
  "pli-tv-bu-vb-sk60:1.9.6": "",
  "pli-tv-bu-vb-sk60:1.10": "ādikammikassāti. ",
  "pli-tv-bu-vb-sk60:1.11": "dasamasikkhāpadaṃ. ",
  "pli-tv-bu-vb-sk60:1.12": "surusuruvaggo chaṭṭho. pādukavaggo "
}
