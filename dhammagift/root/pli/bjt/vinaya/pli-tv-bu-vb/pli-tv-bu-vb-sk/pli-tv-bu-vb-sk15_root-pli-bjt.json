  "pli-tv-bu-vb-sk15:0.5": "catuttha sikkhāpadaṃ. ",
  "pli-tv-bu-vb-sk15:1.0": "8. 2. 5. ",
  "pli-tv-bu-vb-sk15:1.1": "sāvatthinidānaṃ – ",
  "pli-tv-bu-vb-sk15:1.2": "tena kho pana samayena chabbaggiyā bhikkhū kāyappacālakaṃ antaraghare gacchanti kāyaṃ olambentā …pe… ",
  "pli-tv-bu-vb-sk15:1.3.0": "",
  "pli-tv-bu-vb-sk15:1.3.1": "na kāyappacālakaṃ antaraghare gamissāmīti sikkhā karaṇīyā’ti. ",
  "pli-tv-bu-vb-sk15:1.4": "na kāyappacālakaṃ antaraghare gantabbaṃ. ",
  "pli-tv-bu-vb-sk15:1.5": "kāyaṃ paggahetvā gantabbaṃ. ",
  "pli-tv-bu-vb-sk15:1.6": "yo anādariyaṃ paṭicca kāyappacālakaṃ antaraghare gacchati kāyaṃ olambento, āpatti dukkaṭassa. ",
  "pli-tv-bu-vb-sk15:1.7.0": "",
  "pli-tv-bu-vb-sk15:1.7.1": "anāpatti: ",
  "pli-tv-bu-vb-sk15:1.8.1": "asañcicca …pe… ",
  "pli-tv-bu-vb-sk15:1.8.2": "",
  "pli-tv-bu-vb-sk15:1.8.3": "",
  "pli-tv-bu-vb-sk15:1.8.4": "",
