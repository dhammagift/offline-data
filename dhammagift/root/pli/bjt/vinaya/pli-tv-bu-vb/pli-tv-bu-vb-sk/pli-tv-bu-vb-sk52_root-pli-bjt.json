  "pli-tv-bu-vb-sk52:1.0": "8. 6. 2. ",
  "pli-tv-bu-vb-sk52:1.1": "sāvatthinidānaṃ – ",
  "pli-tv-bu-vb-sk52:1.2": "tena kho pana samayena chabbaggiyā bhikkhū hatthanillehakaṃ bhuñjanti. …pe… ",
  "pli-tv-bu-vb-sk52:1.3.0": "",
  "pli-tv-bu-vb-sk52:1.3.1": "na hatthanillehakaṃ bhuñjissāmīti sikkhā karaṇīyā’ti. ",
  "pli-tv-bu-vb-sk52:1.4": "na hatthanillehakaṃ bhuñjitabbaṃ. ",
  "pli-tv-bu-vb-sk52:1.5": "yo anādariyaṃ paṭicca hatthanillehakaṃ bhuñjati āpatti dukkaṭassa. ",
  "pli-tv-bu-vb-sk52:1.6.0": "",
  "pli-tv-bu-vb-sk52:1.6.1": "anāpatti: ",
  "pli-tv-bu-vb-sk52:1.7.1": "asañcicca, asatiyā, ajānantassa, gilānassa, āpadāsu, ummattakassa. ",
  "pli-tv-bu-vb-sk52:1.7.2": "",
  "pli-tv-bu-vb-sk52:1.7.3": "",
  "pli-tv-bu-vb-sk52:1.7.4": "",
  "pli-tv-bu-vb-sk52:1.7.5": "",
  "pli-tv-bu-vb-sk52:1.7.6": "",
  "pli-tv-bu-vb-sk52:1.8": "ādikammikassāti. ",
  "pli-tv-bu-vb-sk52:1.9": "dutiyasikkhāpadaṃ. "
}
