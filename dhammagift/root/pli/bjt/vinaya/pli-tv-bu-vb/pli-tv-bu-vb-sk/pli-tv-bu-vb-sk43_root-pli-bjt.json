  "pli-tv-bu-vb-sk43:1.0": "8. 5. 3. ",
  "pli-tv-bu-vb-sk43:1.1": "sāvatthinidānaṃ – ",
  "pli-tv-bu-vb-sk43:1.2": "tena kho pana samayena chabbaggiyā bhikkhū sakabaḷena mukhena byāharanti …pe… ",
  "pli-tv-bu-vb-sk43:1.3.0": "",
  "pli-tv-bu-vb-sk43:1.3.1": "na sakabaḷena mukhena byāharissāmīti sikkhā karaṇīyā’ti. ",
  "pli-tv-bu-vb-sk43:1.4": "na sakabaḷena mukhena byāharitabbaṃ. ",
  "pli-tv-bu-vb-sk43:1.5": "yo anādariyaṃ paṭicca sakabaḷena mukhena byāharati āpatti dukkaṭassa. ",
  "pli-tv-bu-vb-sk43:1.6.0": "",
  "pli-tv-bu-vb-sk43:1.6.1": "anāpatti: ",
  "pli-tv-bu-vb-sk43:1.7.1": "asañcicca …pe… ",
  "pli-tv-bu-vb-sk43:1.7.2": "",
  "pli-tv-bu-vb-sk43:1.7.3": "",
  "pli-tv-bu-vb-sk43:1.7.4": "",
  "pli-tv-bu-vb-sk43:1.7.5": "",
  "pli-tv-bu-vb-sk43:1.7.6": "",
  "pli-tv-bu-vb-sk43:1.8": "ādikammikassāti. ",
  "pli-tv-bu-vb-sk43:1.9": "tatiyasikkhāpadaṃ. "
}
