  "pli-tv-bu-vb-sk40:1.0": "8. 4. 10. ",
  "pli-tv-bu-vb-sk40:1.1": "sāvatthinidānaṃ – ",
  "pli-tv-bu-vb-sk40:1.2": "tena kho pana samayena chabbaggiyā bhikkhū dīghaṃ ālopaṃ karonti …pe… ",
  "pli-tv-bu-vb-sk40:1.3.0": "",
  "pli-tv-bu-vb-sk40:1.3.1": "parimaṇḍalaṃ ālopaṃ karissāmīti sikkhā karaṇīyā’ti. ",
  "pli-tv-bu-vb-sk40:1.4": "parimaṇḍalo ālopo kātabbo. ",
  "pli-tv-bu-vb-sk40:1.5": "yo anādariyaṃ paṭicca dīghaṃ ālopaṃ karoti āpatti dukkaṭassa. ",
  "pli-tv-bu-vb-sk40:1.6.0": "",
  "pli-tv-bu-vb-sk40:1.6.1": "anāpatti: ",
  "pli-tv-bu-vb-sk40:1.7": "asañcicca ",
  "pli-tv-bu-vb-sk40:1.8": "asatiyā ",
  "pli-tv-bu-vb-sk40:1.9": "ajānantassa ",
  "pli-tv-bu-vb-sk40:1.10": "gilānassa ",
  "pli-tv-bu-vb-sk40:1.11": "khajjake ",
  "pli-tv-bu-vb-sk40:1.12": "phalāphale ",
  "pli-tv-bu-vb-sk40:1.13": "uttaribhaṅge ",
  "pli-tv-bu-vb-sk40:1.14": "āpadāsu ",
  "pli-tv-bu-vb-sk40:1.15": "ummattakassa ",
  "pli-tv-bu-vb-sk40:1.16": "ādikammikassāti. ",
  "pli-tv-bu-vb-sk40:1.17": "dasamasikkhāpadaṃ. ",
  "pli-tv-bu-vb-sk40:1.18": "sakkaccavaggo catuttho. kabaḷavaggo "
