  "pli-tv-bu-vb-sk23:1.0": "8. 3. 3. ",
  "pli-tv-bu-vb-sk23:1.1": "sāvatthinidānaṃ – ",
  "pli-tv-bu-vb-sk23:1.2": "tena kho pana samayena chabbaggiyā bhikkhū sasīsaṃ pārupitvā antaraghare gacchanti …pe… ",
  "pli-tv-bu-vb-sk23:1.3.0": "",
  "pli-tv-bu-vb-sk23:1.3.1": "na oguṇṭhito antaraghare gamissāmīti sikkhā karaṇīyā’ti. ",
  "pli-tv-bu-vb-sk23:1.4": "na oguṇṭhitena antaraghare gantabbaṃ. ",
  "pli-tv-bu-vb-sk23:1.5": "yo anādariyaṃ paṭicca sasīsaṃ pārupitvā antaraghare gacchati āpatti dukkaṭassa. ",
  "pli-tv-bu-vb-sk23:1.6.0": "",
  "pli-tv-bu-vb-sk23:1.6.1": "anāpatti: ",
  "pli-tv-bu-vb-sk23:1.7.1": "asañcicca …pe… ",
  "pli-tv-bu-vb-sk23:1.7.2": "",
  "pli-tv-bu-vb-sk23:1.7.3": "",
  "pli-tv-bu-vb-sk23:1.7.4": "",
  "pli-tv-bu-vb-sk23:1.7.5": "",
  "pli-tv-bu-vb-sk23:1.7.6": "",
  "pli-tv-bu-vb-sk23:1.8": "ādikammikassāti. ",
  "pli-tv-bu-vb-sk23:1.9": "tatiyasikkhāpadaṃ. "
}
