  "pli-tv-bu-vb-sk13:0.5": "dutiya sikkhāpadaṃ. ",
  "pli-tv-bu-vb-sk13:1.0": "8. 2. 3. ",
  "pli-tv-bu-vb-sk13:1.1": "sāvatthinidānaṃ – ",
  "pli-tv-bu-vb-sk13:1.2": "tena kho pana samayena chabbaggiyā bhikkhū uccāsaddaṃ mahāsaddaṃ karontā antaraghare gacchanti …pe… ",
  "pli-tv-bu-vb-sk13:1.3.0": "",
  "pli-tv-bu-vb-sk13:1.3.1": "“appasaddo antaraghare gamissāmīti sikkhā karaṇīyā”ti. ",
  "pli-tv-bu-vb-sk13:1.4": "appasaddena antaraghare gantabbaṃ. ",
  "pli-tv-bu-vb-sk13:1.5": "yo anādariyaṃ paṭicca uccāsaddaṃ mahāsaddaṃ karonto antaraghare gacchati āpatti dukkaṭassa. ",
  "pli-tv-bu-vb-sk13:1.6.0": "",
  "pli-tv-bu-vb-sk13:1.6.1": "anāpatti: ",
  "pli-tv-bu-vb-sk13:1.7": "asañcicca, ",
  "pli-tv-bu-vb-sk13:1.8": "asatiyā, ",
  "pli-tv-bu-vb-sk13:1.9": "ajānantassa, ",
  "pli-tv-bu-vb-sk13:1.10": "gilānassa, ",
  "pli-tv-bu-vb-sk13:1.11": "āpadāsu, ",
  "pli-tv-bu-vb-sk13:1.12": "ummattakassa ",
  "pli-tv-bu-vb-sk13:1.13": "ādikammikassāti. ",
  "pli-tv-bu-vb-sk13:1.14": ""
}
