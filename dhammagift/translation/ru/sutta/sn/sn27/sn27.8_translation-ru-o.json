{
  "sn27.8:0.1": "Связанные Наставления 27.8 ",
  "sn27.8:0.2": "Раздел Загрязнение ",
  "sn27.8:0.3": "Сутта Цепляний ",
  "sn27.8:1.1": "В условиях Саваттхи. ",
  "sn27.8:1.2": "“Которая, монахи, к образо-цеплянию импульс-очарованность-страсть, ума-состояния это загрязнение. ",
  "sn27.8:1.3": "Которая к звуко-цеплянию … ",
  "sn27.8:1.4": "которая к запахо-цеплянию … ",
  "sn27.8:1.5": "которая ко вкусо-цеплянию … ",
  "sn27.8:1.6": "которая к касание-цеплянию … ",
  "sn27.8:1.7": "которая к явление-цеплянию импульс-очарованность, то это ума-состояния загрязнение. ",
  "sn27.8:1.8": "Когда же, монахи, у монаха … ",
  "sn27.8:1.9": "для прямого-знания явлений-Учений, которые могут-быть-засвидетельствованны”. ",
  "sn27.8:1.10": "Восьмая."
}