{
  "sn25.8:0.1": "Связанные Наставления 25.8 ",
  "sn25.8:0.2": "Раздел Глаз ",
  "sn25.8:0.3": "Сутта Объекто-цепляние ",
  "sn25.8:1.1": "В условиях Саваттхи. ",
  "sn25.8:1.2": "“Объекто-цепляние, монахи, ненадёжно, изменчиво, иным-становится; ",
  "sn25.8:1.3": "звуко-цепляние … ",
  "sn25.8:1.4": "запахо-цепляние … ",
  "sn25.8:1.5": "вкусо-цепляние … ",
  "sn25.8:1.6": "касания-цепляние … ",
  "sn25.8:1.7": "явления-цепляние ненадёжно, изменчиво, иным-становится. ",
  "sn25.8:1.8": "Который, монахи, в эти учения-явления верит, настраивается — тот зовётся 'веро-следующий… ",
  "sn25.8:1.9": "к-пробуждению-переправляющийся”. ",
  "sn25.8:1.10": "Восьмая."
}