{
  "sn25.7:0.1": "Связанные Наставления 25.7 ",
  "sn25.7:0.2": "Раздел Глаз ",
  "sn25.7:0.3": "Сутта Объекто-осмысливание ",
  "sn25.7:1.1": "В условиях Саваттхи. ",
  "sn25.7:1.2": "“Объекто-осмысливание, монахи, ненадёжно, изменчиво, иным-становится;",
  "sn25.7:1.3": "звуко-осмысливание … ",
  "sn25.7:1.4": "запахо-осмысливание … ",
  "sn25.7:1.5": "вкусо-осмысливание … ",
  "sn25.7:1.6": "касание-осмысливание … ",
  "sn25.7:1.7": "явления-осмысливание ненадёжно, изменчиво, иным-становится. ",
  "sn25.7:1.8": "Который, монахи, в эти учения-явления верит, настраивается — тот зовётся 'веро-следующий… ",
  "sn25.7:1.9": "к-пробуждению-переправляющийся”. ",
  "sn25.7:1.10": "Седьмая."
}