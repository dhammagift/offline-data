{
  "ja153:1.1": "“I am four-footed, friend, ",
  "ja153:1.2": "you are four-footed, friend, ",
  "ja153:1.3": "Come, friend, turn back, ",
  "ja153:1.4": "why do you run away in fear?” ",
  "ja153:2.1": "“Your coat is foul, unclean, ",
  "ja153:2.2": "you truly smell bad, boar, ",
  "ja153:2.3": "If you desire to fight, ",
  "ja153:2.4": "I give you victory, friend.” "
}
