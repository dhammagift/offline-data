{
  "ja184:1.1": "Corrupted by Giridatta, ",
  "ja184:1.2": "(king) Sāma’s horse (called) Paṇḍava, ",
  "ja184:1.3": "Abandoning his previous nature, ",
  "ja184:1.4": "he follows (his trainer). ",
  "ja184:2.1": "If a man, a kinsman, ",
  "ja184:2.2": "provided with a good disposition, ",
  "ja184:2.3": "Having taken him by the bit, ",
  "ja184:2.4": "guides him around the enclosure, ",
  "ja184:2.5": "Quickly abandoning (his limping), ",
  "ja184:2.6": "he follows (the trainer). "
}
