{
  "ja262:1.1": "If his hand is soft, ",
  "ja262:1.2": "and his elephant well-trained, ",
  "ja262:1.3": "Should it rain in darkness, ",
  "ja262:1.4": "then surely it will be. ",
  "ja262:2.1": "Soft talk is not enough, ",
  "ja262:2.2": "like rivers hard to fill, ",
  "ja262:2.3": "Knowing this they sink, ",
  "ja262:2.4": "he should avoid from afar. ",
  "ja262:3.1": "Those who keep company, ",
  "ja262:3.2": "through desire or through wealth, ",
  "ja262:3.3": "Like a fire in that place, ",
  "ja262:3.4": "they quickly burn him up. "
}
