{
  "ja246:1.1": "Having hit, cut, slaughtered, ",
  "ja246:1.2": "the unrestrained gives a gift, ",
  "ja246:1.3": "Eating such food ",
  "ja246:1.4": "he is defiled with wickedness. ",
  "ja246:2.1": "Having slaughtered wife and son ",
  "ja246:2.2": "the unrestrained gives a gift, ",
  "ja246:2.3": "Though the wise one is eating ",
  "ja246:2.4": "he is not defiled with wickedness. "
}
