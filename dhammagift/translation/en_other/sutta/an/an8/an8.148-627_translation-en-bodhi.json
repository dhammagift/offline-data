{
  "an8.148-627:1.1": "“Bhikkhus, for direct knowledge … ",
  "an8.148-627:1.2": "for full understanding … ",
  "an8.148-627:1.3": "for the utter destruction … ",
  "an8.148-627:1.4": "for the abandoning … ",
  "an8.148-627:1.5": "for the destruction … ",
  "an8.148-627:1.6": "for the vanishing … ",
  "an8.148-627:1.7": "for the fading away … ",
  "an8.148-627:1.8": "for the cessation … ",
  "an8.148-627:1.9": "for the giving up … ",
  "an8.148-627:1.10": "for the relinquishment of hatred … ",
  "an8.148-627:1.11": "of delusion … ",
  "an8.148-627:1.12": "of anger … ",
  "an8.148-627:1.13": "of hostility … ",
  "an8.148-627:1.14": "of denigration … ",
  "an8.148-627:1.15": "of insolence … ",
  "an8.148-627:1.16": "of envy … ",
  "an8.148-627:1.17": "of miserliness … ",
  "an8.148-627:1.18": "of deceitfulness … ",
  "an8.148-627:1.19": "of craftiness … ",
  "an8.148-627:1.20": "of obstinacy … ",
  "an8.148-627:1.21": "of vehemence … ",
  "an8.148-627:1.22": "of conceit … ",
  "an8.148-627:1.23": "of arrogance … ",
  "an8.148-627:1.24": "of intoxication … ",
  "an8.148-627:1.25": "of heedlessness … ",
  "an8.148-627:1.26": "these eight things are to be developed.” This is what the Blessed One said. Elated, those bhikkhus delighted in the Blessed One’s statement. ",
  "an8.148-627:1.28": "The Book of the Eights is finished. "
}
