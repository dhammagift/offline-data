{
  "dn3:1.1.2": "icchānaṅgalannāma → sī. icchānaṅkalaṃ nāma.",
  "dn3:1.12.8": "channaṃ → sī. na ca channaṃ.",
  "dn3:1.13.4": "aṅgulipatodakehi → aṅgulipatodakenātipi pāṭho.",
  "dn3:1.15.7": "ukkākaṃ → sī. okkākaṃ. | dahanti → sī. dissanti.",
  "dn3:1.16.4": "te → votipi pāṭho.",
  "dn3:1.22.3": "dhammavādīyeva → sī. dhammavādiññeva.",
  "dn3:1.23.6": "upasaṅkamitvāmaddarūpiṃ → sī. khuddarūpiṃ.",
  "dn3:2.2.8": "sāmaññaphale → sī. sāmaññaphalaṃ."
}
