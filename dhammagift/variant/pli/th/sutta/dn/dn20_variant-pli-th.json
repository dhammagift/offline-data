{
  "dn20:2.4": "paccekagāthaṃ → pāyato evaṃ. paccekagāthātipi pāṭhena pana bhavitabbaṃ.",
  "dn20:3.20": "apāyabhūmiṃ → sabbapotthakesu pāyato apāyanti pāṭho dissati.",
  "dn20:6.10": "vavakkhitvāna → vavatthitvānāti vā pāṭho.",
  "dn20:8.9": "bhiyyo → bhīyotipi pāṭho.",
  "dn20:9.6": "mahabbalā → aṭṭhakathāyaṃ sabbavāresu mahābalāti pāṭho.",
  "dn20:9.47": "daddallamānā → dadaḷhamānātipi pāṭho.",
  "dn20:10.12": "suriyavacchasā → sī. suriyavaccasā.",
  "dn20:17.7": "āgā → yebhuyyena āgūti pāṭho dissati.",
  "dn20:18.2": "kaṭṭhakā → a. kathakā.",
  "dn20:19.8": "asitātitaṃ → asitātiganti vā pāṭho.",
  "dn20:20.11": "āgā → pāyato āgūti pāco dissati."
}
