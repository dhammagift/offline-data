{
  "thig13.5:2.4": "nekkhammasseva → yu. nekkhammaṃ yeva.",
  "thig13.5:6.2": "natthetassapi → na bodhāya na santaye.",
  "thig13.5:7.2": "samohanaṃ → mohanaṃ. | rajabandhanaṃ → rajavaḍḍhanaṃ.",
  "thig13.5:8.1": "ettāvatā → ettha rattā.",
  "thig13.5:14.1": "mahesīhi → mahesinā.",
  "thig13.5:16.1": "aparisuddho → paripantho.",
  "thig13.5:18.1": "kāmasaṃsaggasattā → kāmapaṅkasattā.",
  "thig13.5:18.2": "avindiṃsu → aviddasū.",
  "thig13.5:24.3": "viharissāmi → vihissāmi. | ratā → tesaṃ."
}
