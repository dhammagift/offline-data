{
  "thig13.1:4.1": "saṇhagandhakasuvaṇṇamaṇḍitaṃ → kaṇha……..",
  "thig13.1:4.3": "khalitaṃ → yu. khalati.",
  "thig13.1:7.2": "pati → paṭi.",
  "thig13.1:8.2": "pure → ma. ayaṃ pāṭho natthi.",
  "thig13.1:11.1": "saṇṭhakammudīva → yu. saṇhakampurīva. ma. saṇhakamburiva. yu.",
  "thig13.1:11.3": "vināmitā → vināsitā.",
  "thig13.1:12.3": "pāṭalippalitā → pāṭalī dubbalikā.",
  "thig13.1:14.3": "va → rindī va."
}
