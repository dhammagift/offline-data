{
  "an7.53:2.1": "disāya → uttaradisāya (sīmu)",
  "an7.53:6.10": "taṃ → puññaṃ puññamabhīti (machasaṃ); puññamahaṃ (PTS); puññamahitaṃ (syā)",
  "an7.53:8.3": "nāma → nandekā nāma (sīmu)",
  "an7.53:9.3": "upapanno → yakkhayoniyaṃ uppanno (sīmu)",
  "an7.53:12.3": "yāvadeva → yāvade (machasaṃ)",
  "an7.53:12.4": "samādhijaṃ → vivekajaṃ (machasaṃ)",
  "an7.53:13.1": "esova → eseva (machasaṃ)",
  "an7.53:14.3": "mahāyaññavaggo → mahāpuññavaggo (PTS)",
  "an7.53:15.1": "parikkhāramaggi → cittaparikkhāraṃ dve aggī (sīmu)",
  "an7.53:15.2": "duve → aggisaññā va dve parā (machasaṃ); aggisaññā aparā duve (sīmu)",
  "an7.53:15.3": "dānaṃ → methunā ca saṃyogo antaṃ (sīmu)",
  "an7.53:15.5": "niṭṭhito → paṇṇasako samatto (machasaṃ)"
