{
  "an9.33:1.1": "desessāmi → desissāmi (sīmu)",
  "an9.33:1.3": "nittaṇhā → tiṇṇa (sīmu, machasaṃ)",
  "an9.33:4.1": "upekhāsukhaṃ → upekkhāsukhaṃ (machasaṃ)",
  "an9.33:5.1": "rūpasaññā → rūpasaññaṃ (machasaṃ) | nirujjhanti → nirujjhati (machasaṃ) | rūpasaññā → rūpasaññaṃ (machasaṃ)",
  "an9.33:6.1": "te → te ca (machasaṃ) | nittaṇhā → tiṇṇā (machasaṃ)",
  "an9.33:7.1": "nittaṇhā → tiṇṇā (machasaṃ)"
}
