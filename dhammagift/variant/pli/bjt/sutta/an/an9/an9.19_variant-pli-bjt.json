{
  "an9.19:1.1": "imaṃ → imañca (machasaṃ)",
  "an9.19:1.3": "mayaṃ → te mayaṃ (machasaṃ)",
  "an9.19:1.4": "pacchānutāpiniyo → paccānutāpiniyo (machasaṃ)",
  "an9.19:2.3": "tā → te mayaṃ (machasaṃ) | abhivādimha → pavuṭṭhimha ca abhivādimha ca (syā) | kho → no ca tesaṃ (machasaṃ)",
  "an9.19:3.3": "adamha → āsanaṃ adamha (machasaṃ)",
  "an9.19:3.5": "upanisīdimha → upanisidimha ca (syā)",
  "an9.19:3.6": "ohitasoto → ohitasotā ca (machasaṃ)",
  "an9.19:3.7": "sutvā → sutvā ca (machasaṃ) | dhatānaṃ → dhātānaṃ (machasaṃ)",
  "an9.19:3.8": "dhatānaṃ → dhātānañca (machasaṃ)"
}
