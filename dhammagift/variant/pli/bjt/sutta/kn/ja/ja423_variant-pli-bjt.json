{
  "ja423:2.3": "sosi → sopi patto sukha dukkhaṃ (syā); sopi panto sukhaṃ dukkhaṃ, sopi patto sukhā dukkha (machasaṃ)",
  "ja423:4.3": "na → na kañca niraṅkatvā (nārada)",
  "ja423:5.1": "sādhu → dakkhaṃ gahapati sādhu (machasaṃ)",
  "ja423:5.2": "saṃvibhajjañca → saṃvibhajañca (machasaṃ)",
  "ja423:5.4": "abyatho → avyatho (machasaṃ)",
  "ja423:6.1": "tesaṃ → chattāva tetaṃ (machasaṃ)",
  "ja423:6.3": "nayito → natthi tā-nassito (machasaṃ)",
  "ja423:7.6": "nibbatto → nippatto (machasaṃ)",
  "ja423:8.3": "atikkanto → apakkanto (machasaṃ)",
  "ja423:9.4": "bhānumatāmivāti → ṭhīto bhānumatā miva (machasaṃ)"
}
