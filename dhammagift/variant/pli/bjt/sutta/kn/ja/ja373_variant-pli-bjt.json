{
  "ja373:2.1": "yathetaṃ → yañcetaṃ (sīmu, machasaṃ)",
  "ja373:3.2": "paṭhamuppattiko → paṭhamuppattito (syā, machasaṃ, sīmu)",
  "ja373:3.3": "samāsajja → dīghaṃ cetaṃ samāpajja (machasaṃ)",
  "ja373:4.1": "nāntalikkhahavanenāhaṃ → nattalikkhabhavanena (machasaṃ)",
  "ja373:4.2": "vā → nāṅgaputtasitena vā (machasaṃ)"
}
