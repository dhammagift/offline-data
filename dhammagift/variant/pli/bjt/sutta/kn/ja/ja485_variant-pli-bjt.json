{
  "ja485:1.4": "nirujjhanti → upaniyyatidaṃ maññe (cande lohita maddane ajja jahāmi jīvita - pāṇā me vande nirāpajhanti – machasaṃ); ajjāsi vijahāmi jīvitaṃ (syā)",
  "ja485:3.1": "miyyāmi → milāyāmi (machasaṃ)",
  "ja485:8.1": "putte → māva puttaṃ (machasaṃ, syā)",
  "ja485:8.4": "adūsakaṃ → avidūsakaṃ (sī.vivi)",
  "ja485:9.4": "mayhakāmāhi → mayhaṃ kāmā (sī.vivi); mayhaṃkāmāhi (machasaṃ)",
  "ja485:10.1": "rujji → rodi (machasaṃ)",
  "ja485:10.4": "nārī → nārihi (machasaṃ)",
  "ja485:11.1": "apinūnahaṃ → syā, vi nūnāhaṃ (machasaṃ)",
  "ja485:11.2": "nacapanāhaṃ → kāhaṃ (machasaṃ)",
  "ja485:12.3": "tālissatagarabhojane → tālīsa taggharabhojanā (machasaṃ, syā)",
  "ja485:13.2": "tattha → tattheva (sī.vivi, machasaṃ)",
  "ja485:13.4": "kāsaṃ → kassaṃ (sī.vivi, machasaṃ)",
  "ja485:16.1": "girivaranadiyo → girivana nadiyo (machasaṃ, sī.vivi)",
  "ja485:25.1": "brahme → cande te ayire brahme (machasaṃ)"
