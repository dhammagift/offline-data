{
  "tha-ap189:2.4": "saddhamanuttaraṃ → labha saddhaṃ anuttaraṃ (machasaṃ)",
  "tha-ap189:3.1": "saddhāniviṭṭhāssa → niviṭṭhassaṃ (sīmu)",
  "tha-ap189:4.4": "avyāpajjhaṃ → abyāpajjaṃ (machasaṃ); avyāpajjaṃ",
  "tha-ap189:6.4": "puna → deva punappunaṃ (machasaṃ)",
  "tha-ap189:7.1": "me → saṃciggohaṃ (syā)"
}
