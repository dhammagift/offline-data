{
  "sn22.104:1.1": "sāvatthinidānaṁ → sāvatthiyaṁ (bj); sāvatthī (sya-all)",
  "sn22.104:1.2": "desessāmi → desissāmi (bj, sya-all) | dukkhanirodhagāminiñca paṭipadaṁ → dukkhanirodhagāminīpaṭipadañca (sya-all)",
  "sn22.104:1.7": "seyyathidaṁrūpupādānakkhandho → seyyathīdaṁ rūpūpādānakkhandho (sya-all) | viññāṇupādānakkhandho → viññāṇūpādānakkhandho (sya-all)",
  "sn22.104:1.15": "katamā → katamo (bj)",
  "sn22.104:1.17": "seyyathidaṁsammādiṭṭhi → seyyathīdaṁ sammādiṭṭhi (sya-all)",
  "sn22.104:1.18": "dukkhanirodhagāminī paṭipadāti dutiyaṁ → dukkhanirodhagāminīpaṭipadāti (sya-all)"
}
