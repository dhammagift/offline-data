{
  "vv41:1.1": "maṇikañcanācitaṁ sovaṇṇajālacitaṁ → kanakakañcanācitaṁ suvaṇṇajālacittaṁ (sya-all)",
  "vv41:1.2": "sovaṇṇajālacitaṁ → suvaṇṇajāla cittaṁ (bj)",
  "vv41:1.4": "vehāyasaṁ antalikkhe → vehāsayaṁ antaḷikkhe (bj) | vehāyasaṁ → vehāsayaṁ (sya-all)",
  "vv41:2.2": "acchodakā → acchodikā (bj)",
  "vv41:2.3": "tūriyagaṇā → turiyagaṇā (bj, cck) | ca tūriyagaṇā pabhijjare → turiyagaṇā pavajjare (sya-all)",
  "vv41:3.3": "evaṁ jalitānubhāvā → evañjalitānubhāvā (sya-all)",
  "vv41:4.2": "buddhassahaṁ → buddhassāhaṁ (sya-all)",
  "vv41:4.4": "vittā → cittā (bj) | vittā cahaṁ → cittāva taṁ (sya-all)",
  "vv41:5.1": "kañcanasannibhattaco adesayi → kañcanasannibhattavo adesayī (bj)",
  "vv41:5.3": "dukkhanirodhasassataṁ → dukkhanirodhasaccaṁ (sya-all)",
  "vv41:5.4": "vijānisaṁ → vijāniyaṁ (bj); vijānissaṁ (sya-all)",
  "vv41:6.2": "tidasagaṇaṁ → tidasānaṁ (sya-all)",
  "vv41:6.3": "sakkassahaṁ → sakkassāhaṁ (bj, sya-all) | pajāpati → pajāpatī (bj)"
}
