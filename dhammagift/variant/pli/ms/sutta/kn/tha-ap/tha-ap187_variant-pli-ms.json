{
  "tha-ap187:1.1": "sataraṁsiṁva pītaraṁsiṁva → sataraṁsīva pītaraṁsīva (sya-all)",
  "tha-ap187:1.2": "pītaraṁsiṁva bhāṇumaṁ → sitaraṁsiṁ va bhānumaṁ (bj)",
  "tha-ap187:2.1": "isimuggāni pisitvā → isimuggaṁ nimantetvā (sya-all)",
  "tha-ap187:2.2": "anīḷake pāsādeva → anīlake pāsādepi (sya-all)",
  "tha-ap187:3.4": "cāpi bahuttaraṁ → vāpi bahūtaraṁ (sya-all)",
  "tha-ap187:4.4": "nupapajjahaṁ cattālīsamhi sahasse → nūpapajjahaṁ cattārīsamhi sahasesa (bj) | nupapajjahaṁ cattālīsamhi → nūpapajjahaṁ cattāḷīsamhi (sya-all)",
  "tha-ap187:5.2": "aṭṭhatiṁsa te isimuggasanāmā → aṭṭhatiṁsate mahisamantanāmā (sya-all)",
  "tha-ap187:5.4": "mahabbalā → mahabbalo (bj)",
  "tha-ap187:6.3": "sāsanaṁ → sāsananti (sya-all)",
  "tha-ap187:8.1": "isimuggadāyakattherassāpadānaṁ → isimuggadāyakattherassa apadānaṁ (bj)"
}
