  "tha-ap183:3.2": "pupphamabhiropayiṁ → pupphaṁ abhiropayiṁ (sya-all)",
  "tha-ap183:4.2": "āsuṁ supupphitā → āsiṁsu pupphitā (bj, sya-all) | pupphitā → āsuṁ supupphitā (bj: machasaṁ)",
  "tha-ap183:5.4": "sāsanaṁ → sāsananti (sya-all)",
  "tha-ap183:7.1": "kuṭajapupphiyattherassāpadānaṁ → kuṭajapupphiyattherassa apadānaṁ (bj)"
}
