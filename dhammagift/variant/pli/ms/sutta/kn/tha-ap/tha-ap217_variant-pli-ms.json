{
  "tha-ap217:1.1": "sataraṁsiṁva pītaraṁsiṁva → sataraṁsīva pītaraṁsīva (sya-all)",
  "tha-ap217:1.2": "pītaraṁsiṁva bhāṇumaṁ byagghūsabhaṁva → sitaraṁsiṁva bhānumaṁ vyagghūsabhaṁva (bj)",
  "tha-ap217:1.3": "byagghūsabhaṁva → byagghusabhaṁva (sya-all)",
  "tha-ap217:3.2": "caritaṁ → sukataṁ (bj); karitaṁ (sya-all)",
  "tha-ap217:5.4": "cakkavattī → cakkavatti (bj, sya-all)",
  "tha-ap217:6.3": "sāsanaṁ → sāsananti (sya-all)",
  "tha-ap217:8.1": "raṁsisaññakattherassāpadānaṁ → raṁsisaññakattherassa apadānaṁ (bj)"
}
